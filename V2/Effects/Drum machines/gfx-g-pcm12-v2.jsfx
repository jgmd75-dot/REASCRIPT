  ui_col(cur_step == gs && cur_pat == slider26 && playing ? 0x6CFF6C : 0x2A3A2A); gfx_rect((gx + 4) * sc, 556 * sc, 27 * sc, 3 * sc);
  gfx_setfont(11); sprintf(#sn, "%d", gs + 1); pc_ctxt(gx + 17, 560, #sn, gs % 4 == 0 ? PINK : PDIM);
  gs += 1;
);

