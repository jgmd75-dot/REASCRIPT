  ui_col(0xE8EAEC); gfx_triangle((gx + 70) * sc, (gy + 10) * sc, (gx + 78) * sc, (gy + 10) * sc, (gx + 74) * sc, (gy + 15) * sc);
  pc_led(gx + 76, gy + 38, 3, sel == gr || lt[gr] > 0.3);
  pressed && drag_id == 0 && garr ? (
    drag_id = -1; #sm = ""; gi = 0; loop(NSND, gb[0] == gi ? strcat(#sm, "!"); strcat(#sm, snd_name(gi)); gi < NSND - 1 ? strcat(#sm, "|"); gi += 1; );
    gfx_x = (gx + 66) * sc; gfx_y = (gy + 18) * sc; gsel = gfx_showmenu(#sm);
    gsel > 0 ? ( gb[0] = gsel - 1; gr == sel ? ed_load = 1; aud = gr + 1; aud_vel = 0.9; );
  ) : pressed && drag_id == 0 && ghv ? (
    drag_id = -1; aud = gr + 1; aud_vel = 0.9; sel != gr ? ( sel = gr; ed_load = 1; );
  );
  lt[gr] *= 0.85;
  gr += 1;
);
