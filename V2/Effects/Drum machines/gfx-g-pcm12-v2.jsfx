    gv = PAT[gpp + gr * 16 + gs]; gx = pc_sx(gs);
    ui_col(gv == 2 ? 0xFFD0C0 : gv == 1 ? LEDR : (cur_step == gs && playing ? 0x3A3C40 : 0x242528)); gfx_rect((gx + 2) * sc, gy * sc, 32 * sc, 3.6 * sc);
    pressed && drag_id == 0 && mouse_x >= gx * sc && mouse_x < (gx + 36) * sc && mouse_y >= (gy - 0.5) * sc && mouse_y < (gy + 4.4) * sc ? (
