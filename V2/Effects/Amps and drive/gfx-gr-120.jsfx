function g1u_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function g1u_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function g1u_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function g1u_hash(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453; v - floor(v); );
function g1u_title(x, y, s) (
  ui_col(G1_HAZ); g1u_r(x, y - 6, 4, 12);
  gfx_setfont(12); ui_col(G1_INK); g1u_tl(x + 11, y, s);
);
function g1u_vrule(x, y1, y2) ( ui_cola(G1_HAZ, 0.85); g1u_r(x, y1, 1.2, y2 - y1); );

function g1u_static() local(i, n, px, py, k) (
  gfx_setimgdim(121, gfx_w, gfx_h); gfx_dest = 121;
  ui_col(G1_OLV); gfx_rect(0, 0, gfx_w, gfx_h);
  n = floor(gfx_w * gfx_h / (14 * sc * sc)); i = 0; g1u_spl = ui_mix(G1_OLV, 0xFFFFFF, 0.04); g1u_spd = ui_mix(G1_OLV, 0x000000, 0.08);
  loop(n,
    px = floor(g1u_hash(i * 3.17 + 0.1) * gfx_w); py = floor(g1u_hash(i * 7.91 + 1.3) * gfx_h); k = g1u_hash(i * 1.61 + 4.2);
    ui_col(k > 0.5 ? g1u_spl : g1u_spd);
    gfx_rect(px, py, max(1, floor(sc)), max(1, floor(sc)));
    i += 1;
  );
  ui_col(G1_CHR); g1u_r(0, 0, 1060, 58);
  ui_cola(0x000000, 0.45); g1u_r(0, 58, 1060, 2);
  ui_col(G1_HAZ); g1u_r(0, 56, 1060, 2);
  g1u_vrule(326, 74, 398); g1u_vrule(632, 74, 398); g1u_vrule(850, 74, 398);
  ui_cola(G1_HAZ, 0.85); g1u_r(16, 312, 296, 1.2); g1u_r(646, 296, 190, 1.2); g1u_r(864, 270, 182, 1.2);
  s74_hex(10, 70, 4.2); s74_hex(1050, 70, 4.2); s74_hex(10, 400, 4.2); s74_hex(1050, 400, 4.2);
  g1u_title(24, 80, "PREAMP"); g1u_title(340, 80, "GRAPHIC"); g1u_title(646, 80, "POWER"); g1u_title(864, 80, "CABINET");
  g1u_title(646, 312, "SUPPLY"); g1u_title(864, 286, "OUTPUT");
  gfx_setfont(13); ui_col(G1_DIM); g1u_tc(166, 238, "FREQ CONTOUR");
  g1u_tl(28, 298, "FULL"); gfx_measurestr("TIGHT", k, n); gfx_x = floor(304 * sc - k); gfx_y = floor(298 * sc - n * 0.55); gfx_drawstr("TIGHT");
  ui_col(G1_DIM); g1u_tc(352, 104, "+12"); g1u_tc(352, 190, "0"); g1u_tc(352, 276, "-12");
  i = 0; loop(6,
    ui_cola(0x000000, 0.22); g1u_r(386 + i * 41 - 15, 90, 30, 200);
    i += 1;
  );
  gfx_setfont(13); ui_col(G1_DIM); g1u_tc(1000, 236, "ON  ·  OFF AXIS");
  ui_col(G1_HAZ); g1u_r(16, 13, 32, 32);
  gfx_setfont(13); ui_col(G1_CHR); g1u_tc(32, 29.5, "GFX");
  gfx_setfont(14); ui_col(G1_INK); gfx_measurestr("GR-120", k, n); gfx_x = 58 * sc; gfx_y = floor(29 * sc - n * 0.55); gfx_drawstr("GR-120"); ver_tag("v2", 9, 3.05, 0);
  g1u_sx = 58 + k / sc + 14;
  gfx_setfont(15); ui_col(G1_DIM); g1u_tl(g1u_sx, 21, "VALVE HEAD"); g1u_tl(g1u_sx, 38, "120 W  ·  4x12");
  gfx_dest = -1;
);
(gfx_w != g1u_bw || gfx_h != g1u_bh || sc != g1u_bsc) ? ( g1u_bw = gfx_w; g1u_bh = gfx_h; g1u_bsc = sc; g1u_static(); );
gfx_x = 0; gfx_y = 0; gfx_a = 1; gfx_mode = 0; gfx_blit(121, 1, 0);

function g1u_knob(cx, cy, r, idx, lo, hi, def, label, fmt, stp) local(v, n, dx, dy, hov, did, a, ca, sa, i, t, l) (
  did = 4100 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - g1u_lt < 0.35 && g1u_lid == idx && !g1u_mv) || (mouse_cap & 4) ? ( s74_set(idx, def); drag_id = -1; g1u_lt = 0; ) : (
      drag_id = did; g1u_ky = mouse_y; g1u_ky0 = mouse_y; g1u_mv = 0; g1u_lt = time_precise(); g1u_lid = idx;
      g1u_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !g1u_mv && abs(mouse_y - g1u_ky0) > 3 * sc ? ( g1u_mv = 1; g1u_ky = mouse_y; );
  drag_id == did && g1u_mv ? (
    g1u_kn = min(max(g1u_kn + (g1u_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); g1u_ky = mouse_y;
    v = lo + g1u_kn * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s74_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max((v - lo) / (hi - lo) + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lo + n * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    s74_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 9 : 6;
    ui_cola(G1_INK, 0.8); gfx_circle((cx + sin(t) * (r + 4 + r + l) * 0.5) * sc, (cy - cos(t) * (r + 4 + r + l) * 0.5) * sc, max((i == 0 || i == 5 || i == 10 ? 1.8 : 1.2) * 0.75, 0.9) * sc, 1, 1);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle((cx + 1.8) * sc, (cy + 3.2) * sc, r * sc, 1, 1);
  ui_col(0x16181A); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(0x30343A); gfx_circle(cx * sc, cy * sc, (r - 1.4) * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.22); gfx_arc(cx * sc, cy * sc, (r - 1) * sc, -0.62 * $pi, 0.02 * $pi, 1);
  ui_cola(0x000000, 0.45); s74_ln(cx + ca * r * 0.16 + 0.9, cy + sa * r * 0.16 + 1.1, cx + ca * (r - 1.5) + 0.9, cy + sa * (r - 1.5) + 1.1, max(3, r * 0.15));
  ui_col(0xF4F2E8); s74_ln(cx + ca * r * 0.16, cy + sa * r * 0.16, cx + ca * (r - 1.5), cy + sa * (r - 1.5), max(3, r * 0.15));
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.06); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
    sprintf(#g1u_v, fmt, v); s74_pill(cx, cy + r + 9, #g1u_v);
  ) : (
    strlen(label) ? ( gfx_setfont(11); ui_col(G1_INK); g1u_tc(cx, cy + r + 19, label); );
  );
);

function g1u_fader(x, y, h, idx, label) local(v, n, hov, did, cy, i, ty, lo, hi) (
  lo = -12; hi = 12;
  did = 4300 + idx; v = slider(idx);
  n = min(max((v - lo) / (hi - lo), 0), 1); cy = y + h * (1 - n);
  hov = s74_hov(x - 15, y - 10, 30, h + 20);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - g1u_lt < 0.35 && g1u_lid == idx && !g1u_mv) || (mouse_cap & 4) ? ( s74_set(idx, 0); drag_id = -1; g1u_lt = 0; ) : (
      drag_id = did; g1u_ky = mouse_y; g1u_ky0 = mouse_y; g1u_mv = 0; g1u_lt = time_precise(); g1u_lid = idx; g1u_kn = n;
      abs(mouse_y / sc - cy) > 9 ? ( g1u_kn = min(max(1 - (mouse_y / sc - y) / h, 0), 1); g1u_mv = 1;
        s74_set(idx, lo + floor(g1u_kn * (hi - lo) * 2 + 0.5) / 2); );
    );
  );
  drag_id == did && !g1u_mv && abs(mouse_y - g1u_ky0) > 3 * sc ? ( g1u_mv = 1; g1u_ky = mouse_y; );
  drag_id == did && g1u_mv ? (
    g1u_kn = min(max(g1u_kn + (g1u_ky - mouse_y) / ((mouse_cap & 8) ? h * 6 * sc : h * sc), 0), 1); g1u_ky = mouse_y;
    v = lo + floor(g1u_kn * (hi - lo) * 2 + 0.5) / 2;
    slider(idx) != v ? s74_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    s74_set(idx, min(max(v + (mouse_wheel > 0 ? 0.5 : -0.5), lo), hi)); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1); cy = y + h * (1 - n);
  i = 0; loop(5, ty = y + h * i / 4; ui_cola(G1_INK, i == 2 ? 0.9 : 0.6);
    g1u_r(x - 14, ty - 0.6, i == 2 ? 7 : 5, 1.2); g1u_r(x + 14 - (i == 2 ? 7 : 5), ty - 0.6, i == 2 ? 7 : 5, 1.2); i += 1; );
  ui_col(0x0C0D0B); g1u_r(x - 2.5, y - 4, 5, h + 8);
  ui_cola(0xFFFFFF, 0.10); g1u_r(x + 2.5, y - 4, 1, h + 8);
  ui_cola(0x000000, 0.5); g1u_r(x - 11 + 1.5, cy - 9 + 3, 22, 18);
  ui_col(0x16181A); g1u_r(x - 11, cy - 9, 22, 18);
  ui_col(0x30343A); g1u_r(x - 10, cy - 8, 20, 16);
  ui_cola(0xFFFFFF, 0.20); g1u_r(x - 10, cy - 8, 20, 1);
  ui_col(0xF4F2E8); g1u_r(x - 10, cy - 1.2, 20, 2.4);
  (hov || drag_id == did) ? ( sprintf(#g1u_pv, "%+.1f dB", v); g1u_pon = 1; g1u_px = x; g1u_py = y + h + 8; ) : (
    gfx_setfont(11); ui_col(G1_INK); g1u_tc(x, y + h + 18, label);
  );
);

