desc:GR-120 [valve amp head] (GFX)
//tags: amp amplifier guitar head valve tube cabinet 4x12 graphic doom stoner sludge rock lead
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-s74 and gfx-amp (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s74.jsfx-inc
import gfx-amp.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{Doom,Lead}>-Model
slider2:5<0,10,0.1>-Gain
slider3:5<0,10,0.1>-Bass
slider4:5<0,10,0.1>-Treble
slider5:2<0,5,1{1,2,3,4,5,6}>-Freq contour
slider6:1<0,1,1{Out,In}>-Graphic
slider7:0<-12,12,0.5>-Graphic 100 Hz (dB)
slider8:0<-12,12,0.5>-Graphic 200 Hz (dB)
slider9:0<-12,12,0.5>-Graphic 400 Hz (dB)
slider10:0<-12,12,0.5>-Graphic 800 Hz (dB)
slider11:0<-12,12,0.5>-Graphic 1.6 kHz (dB)
slider12:0<-12,12,0.5>-Graphic 3.2 kHz (dB)
slider13:5<0,10,0.1>-Presence
slider14:5<0,10,0.1>-Master
slider15:1<0,1,1{Off,4x12}>-Cabinet
slider16:3<0,10,0.1>-Mic position (on - off axis)
slider17:0<0,1,1{Off,On}>-Mono in
slider18:0<-24,12,0.1>-Input trim (dB)
slider19:0<0,1,1{Off,On}>-Input guard
slider20:50<0,100,1>-Drift (%)
slider21:0<-24,12,0.1>-Output (dB)
slider22:0<0,100,1>-Band sat (%)
slider23:30<0,100,1>-Bias (%)
slider24:120<40,400,1>-Sat low band (Hz)
slider25:6000<2000,16000,10>-Sat high band (Hz)
slider26:-0.3<-24,0,0.1>-Ceiling (dB)
slider27:prs_sel=0<0,12,1{No preset,Init,Doom Wall,Drone Bloom,Sludge Crawl,Desert Fuzz,Cathedral Low,Seventies Crunch,Riff Machine,Lead Sing,Graphic Scoop,Bright Rhythm,Clean Headroom}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=1048576

@init
#ui_man = "gfx-gr-120";
ext_noinit = 1;

function g1_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function g1_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function g1_tg(u) ( u >= 0 ? g1_th(u) : 1.8 * g1_th(u * 0.5555556) );
function g1_tgd(u) ( u >= 0 ? g1_thd(u) : g1_thd(u * 0.5555556) );
function g1_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function g1_tgF(u) ( u >= 0 ? g1_F(u) : 3.24 * g1_F(u * 0.5555556) );
function g1_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = g1_tgF(u1); b0 = b; g0 = g1_tg(b); n0 = 1 / max(g1_tgd(b), 0.05); );
function g1_strun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + g1_eb * (x - xp) + b0; xp = x; ga = g1_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : g1_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + g1_dn;
);
function g1_strp(x) instance(b0, g0, n0) ( (g1_tg(x + b0) - g0) * n0 + g1_dn );
function g1_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = g1_F(u1); b0 = b; g0 = g1_th(b); n0 = 1 / max(g1_thd(b), 0.05); );
function g1_syrun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + g1_eb * (x - xp) + b0; xp = x; ga = g1_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : g1_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + g1_dn;
);
g1_eb = 0.25;

function g1_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function g1_shset(fz, F, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * F;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function g1_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
function g1_lcset(f, a, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = (c + w * a) / (c + w); b1 = (w * a - c) / (c + w); a1 = (w - c) / (c + w);
);

function g1_tsset(t, m, l, fs) instance(b0, b1, b2, b3, a1, a2, a3)
  local(C1, C2, C3, R1, R2, R3, R4, nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  C1 = 0.00000000047; C2 = 0.000000022; C3 = 0.000000022;
  R1 = 220000; R2 = 1000000; R3 = 25000; R4 = 33000;
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  b0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  b1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  b2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  b3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  a1 = k1 * q; a2 = k2 * q; a3 = k3 * q;
);
function g1_tsrun(x) instance(b0, b1, b2, b3, a1, a2, a3, x1, x2, x3, y1, y2, y3) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 + b3 * x3 - a1 * y1 - a2 * y2 - a3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);
function g1_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

G1_QN = 4096; G1_QR = 4; G1_QS = (G1_QN - 1) / (2 * G1_QR);
function g1_ppc(v, b) local(p, n) (
  p = b + v; n = b - v;
  g1_th(((p > 0 ? p * sqrt(p) : 0) - (n > 0 ? n * sqrt(n) : 0)) / (3 * sqrt(b)));
);
function g1_qbuild(tab, ga, fb, bi) local(i, uu, lo, hi, m) (
  i = 0;
  loop(G1_QN,
    uu = -G1_QR + i / G1_QS; lo = -1; hi = 1;
    loop(40, m = 0.5 * (lo + hi); m - g1_ppc(ga * (uu - fb * m), bi) > 0 ? hi = m : lo = m; );
    tab[i] = 0.5 * (lo + hi);
    i += 1;
  );
  tab[G1_QN] = tab[G1_QN - 1];
);
function g1_qint(tab, c) local(i, h) (
  h = 1 / G1_QS; c[0] = 0; i = 0;
  loop(G1_QN - 1, c[i + 1] = c[i] + h * 0.5 * (tab[i] + tab[i + 1]); i += 1; );
);
function g1_qF(p) local(i, f, q) (
  p <= 0 ? g1_qt[0] * p / G1_QS : p >= G1_QN - 1 ? g1_qc[G1_QN - 1] + g1_qt[G1_QN - 1] * (p - G1_QN + 1) / G1_QS : (
    i = floor(p); f = p - i; q = g1_qt + i;
    g1_qc[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / G1_QS;
  );
);
function g1_q(u) local(p, i) (
  p = min(max((u + G1_QR) * G1_QS, 0), G1_QN - 1.001);
  i = floor(p); p -= i;
  g1_qt[i] + (g1_qt[i + 1] - g1_qt[i]) * p;
);
function g1_paset(d) instance(ofs, t0, p1, f1) local(o) ( o = d / g1_pgA; p1 += (o - ofs) * G1_QS; f1 = g1_qF(p1); ofs = o; t0 = g1_q(ofs); );
function g1_pare() instance(p1, f1) ( f1 = g1_qF(p1); );
function g1_pa(u) instance(y, sup, sbase, env, genv, ofs, t0, p1, f1, xp) local(a, d, p, f) (
  a = abs(u);
  genv += (a - genv) * (a > genv ? g1_gba : g1_gbr);
  d = g1_blk * max(genv - 0.5, 0);
  d > 0.00001 ? u -= d * g1_th(u / d);
  p = u + g1_eb * (u - xp); xp = u;
  p = (p * g1_pn / sup + ofs + G1_QR) * G1_QS; f = g1_qF(p); d = p - p1;
  y = sup * ((abs(d) > 0.00001 ? (f - f1) / d * G1_QS : g1_q((0.5 * (p + p1)) / G1_QS - G1_QR)) - t0);
  p1 = p; f1 = f;
  a = abs(y);
  env += (a - env) * (a > env ? g1_sga : g1_sgr);
  sup = sbase * (1 - g1_sgd * min(max(env - g1_sgk, 0) * 1.8, 1));
  y;
);
function g1_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * g1_xlk + x * g1_xc; s = g1_th(ph * g1_otk) / g1_otk; y = (s - sp * g1_xlk) / g1_xc; sp = s; y;
);
function g1_otre() instance(ph, sp) ( sp = g1_th(ph * g1_otk) / g1_otk; );

function g1_core(x) instance(cs1, v1a, cp1, cn, cs2, v1b, cp2, v2a, cf, ts, e1, e2, e3, e4, e5, e6, pin, pa, ot) local(u) (
  u = cs1.g1_1run(x * g1_kin + g1_dn);
  u = -60 * v1a.g1_strp(u);
  u = cp1.g1_1run(u * g1_gk);
  u = cn.g1_1run(u);
  u = cs2.g1_1run(u);
  u = -45 * v1b.g1_strun(u);
  u = cp2.g1_1run(u) * g1_k3;
  u = -35 * v2a.g1_strun(u);
  u = cf.g1_strp(u * 0.022);
  u = ts.g1_tsrun(u);
  g1_geq ? (
    u = e1.am_run(u); u = e2.am_run(u); u = e3.am_run(u); u = e4.am_run(u); u = e5.am_run(u); u = e6.am_run(u);
  );
  u = pin.g1_syrun(u * g1_mv);
  u = pa.g1_pa(u * g1_kpa);
  ot.g1_ot(u);
);

function g1_spkset(m) instance(p1, p2, p3, c1, c2, c3, c4, c5, c6, c7, c8) local(lp) (
  p1.am_bq(3, 3400, 0.7, (g1_pres - 5) * 1.3, srate);
  p2.am_bq(2, 105, 1.1, g1_emfl, srate);
  p3.am_bq(3, 2600, 0.6, g1_emfh, srate);
  m = min(max(m, 0), 10) / 10;
  c1.am_bq(1, 72, 1.15, 0, srate);
  c2.am_bq(2, 108, 1.4, 3.5, srate);
  c3.am_bq(2, 420, 1.0, -3, srate);
  c4.am_bq(2, 1750, 1.2, 2, srate);
  c5.am_bq(2, 3100 - 500 * m, 1.7, 5.5 * (1 - 0.75 * m), srate);
  lp = 5900 - 2300 * m;
  c6.am_bq(0, lp, 0.5412, 0, srate); c7.am_bq(0, lp, 1.3066, 0, srate);
  c8.am_bq(2, 7400, 3, -10 * m, srate);
);
function g1_spkrun(x) instance(p1, p2, p3, c1, c2, c3, c4, c5, c6, c7, c8, lo) local(y) (
  x = p3.am_run(p2.am_run(p1.am_run(x)));
  y = g1_cw > 0.00001 ? c8.am_run(c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c2.am_run(c1.am_run(x)))))))) : 0;
  g1_cw < 0.99999 ? x = lo.am_run(x);
  x + (y * g1_kcab - x) * g1_cw;
);
function g1_lot(g) local(k) ( k = (g1_mod ? G1_LOL : G1_LOD) * (g / 10) ^ 1.5; g1sL.lo.am_bq(3, 9000, 0.7, k, srate); g1sR.lo.am_bq(3, 9000, 0.7, k, srate); );

s74_mem = 0;
g1_qd = s74_alloc(G1_QN + 1); g1_ql = s74_alloc(G1_QN + 1);
g1_qdc = s74_alloc(G1_QN + 1); g1_qlc = s74_alloc(G1_QN + 1);
g1_mkt = s74_alloc(32);
g1_ostm = s74_alloc(16);
g1_hb = s74_alloc(64);
s74_hbdesign(g1_hb, 63, 8);
g1_hu0 = 2 * g1_hb[0]; g1_hu1 = 2 * g1_hb[2]; g1_hu2 = 2 * g1_hb[4]; g1_hu3 = 2 * g1_hb[6];
g1_hu4 = 2 * g1_hb[8]; g1_hu5 = 2 * g1_hb[10]; g1_hu6 = 2 * g1_hb[12]; g1_hu7 = 2 * g1_hb[14];
g1_hu8 = 2 * g1_hb[16]; g1_hu9 = 2 * g1_hb[18]; g1_hu10 = 2 * g1_hb[20]; g1_hu11 = 2 * g1_hb[22];
g1_hu12 = 2 * g1_hb[24]; g1_hu13 = 2 * g1_hb[26]; g1_hu14 = 2 * g1_hb[28]; g1_hu15 = 2 * g1_hb[30];
g1_hd0 = g1_hb[0]; g1_hd1 = g1_hb[2]; g1_hd2 = g1_hb[4]; g1_hd3 = g1_hb[6];
g1_hd4 = g1_hb[8]; g1_hd5 = g1_hb[10]; g1_hd6 = g1_hb[12]; g1_hd7 = g1_hb[14];
g1_hd8 = g1_hb[16]; g1_hd9 = g1_hb[18]; g1_hd10 = g1_hb[20]; g1_hd11 = g1_hb[22];
g1_hd12 = g1_hb[24]; g1_hd13 = g1_hb[26]; g1_hd14 = g1_hb[28]; g1_hd15 = g1_hb[30];
function g1_up(x) instance(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15,
                           a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, o0, o1) (
  a31 = a30; a30 = a29; a29 = a28; a28 = a27; a27 = a26; a26 = a25; a25 = a24; a24 = a23; a23 = a22; a22 = a21;
  a21 = a20; a20 = a19; a19 = a18; a18 = a17; a17 = a16; a16 = a15; a15 = a14; a14 = a13; a13 = a12; a12 = a11;
  a11 = a10; a10 = a9; a9 = a8; a8 = a7; a7 = a6; a6 = a5; a5 = a4; a4 = a3; a3 = a2; a2 = a1;
  a1 = a0; a0 = x;
  o0 = g1_hu0 * (a0 + a31) + g1_hu1 * (a1 + a30) + g1_hu2 * (a2 + a29) + g1_hu3 * (a3 + a28)
    + g1_hu4 * (a4 + a27) + g1_hu5 * (a5 + a26) + g1_hu6 * (a6 + a25) + g1_hu7 * (a7 + a24)
    + g1_hu8 * (a8 + a23) + g1_hu9 * (a9 + a22) + g1_hu10 * (a10 + a21) + g1_hu11 * (a11 + a20)
    + g1_hu12 * (a12 + a19) + g1_hu13 * (a13 + a18) + g1_hu14 * (a14 + a17) + g1_hu15 * (a15 + a16);
  o1 = a15;
);
function g1_dn2(x0, x1) instance(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15,
                                 b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31,
                                 c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16) local(y) (
  b31 = b30; b30 = b29; b29 = b28; b28 = b27; b27 = b26; b26 = b25; b25 = b24; b24 = b23; b23 = b22; b22 = b21;
  b21 = b20; b20 = b19; b19 = b18; b18 = b17; b17 = b16; b16 = b15; b15 = b14; b14 = b13; b13 = b12; b12 = b11;
  b11 = b10; b10 = b9; b9 = b8; b8 = b7; b7 = b6; b6 = b5; b5 = b4; b4 = b3; b3 = b2; b2 = b1;
  b1 = b0; b0 = x0;
  y = g1_hd0 * (b0 + b31) + g1_hd1 * (b1 + b30) + g1_hd2 * (b2 + b29) + g1_hd3 * (b3 + b28)
    + g1_hd4 * (b4 + b27) + g1_hd5 * (b5 + b26) + g1_hd6 * (b6 + b25) + g1_hd7 * (b7 + b24)
    + g1_hd8 * (b8 + b23) + g1_hd9 * (b9 + b22) + g1_hd10 * (b10 + b21) + g1_hd11 * (b11 + b20)
    + g1_hd12 * (b12 + b19) + g1_hd13 * (b13 + b18) + g1_hd14 * (b14 + b17) + g1_hd15 * (b15 + b16)
    + 0.5 * c16;
  c16 = c15; c15 = c14; c14 = c13; c13 = c12; c12 = c11; c11 = c10; c10 = c9; c9 = c8; c8 = c7; c7 = c6;
  c6 = c5; c5 = c4; c4 = c3; c3 = c2; c2 = c1; c1 = x1;
  y;
);
G1_LAT = 31;

g1_pgA = 4.5; g1_qbuild(g1_qd, 4.5, 0.03, 0.10);
g1_pgA = 9;   g1_qbuild(g1_ql, 9, 0.30, 0.28);
g1_qint(g1_qd, g1_qdc); g1_qint(g1_ql, g1_qlc);

function g1_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = g1_mkt + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
g1_row(0, -2.60, -5.05, -7.37, -9.78, -11.49, -12.41, -13.53, -13.83, -14.16, -14.29, -14.24);
g1_row(1, 2.66, -0.29, -2.97, -5.70, -7.82, -9.51, -10.80, -11.75, -12.25, -13.14, -13.04);
function g1_mkup(m, g) local(p, i, f, q) (
  p = min(max(g, 0), 10); i = min(floor(p), 9); f = p - i; q = g1_mkt + m * 11;
  10 ^ ((q[i] * (1 - f) + q[i + 1] * f) / 20);
);
function g1_mtrim(v, g) local(t) (
  t = min(max(v - 5, 0), 5);
  t = t < 1 ? 0.07 * t : t < 2 ? 0.07 + 0.08 * (t - 1) : t < 3 ? 0.15 + 0.1 * (t - 2) : t < 4 ? 0.25 + 0.15 * (t - 3) : 0.4 + 0.13 * (t - 4);
  t * (g < 5 ? 0.1 + 0.18 * g : 1 - 0.14 * (g - 5));
);
function g1_mkall(m, g) ( g1_mkup(m, g) * 10 ^ (-g1_mtrim(slider14, g) / 20); );

function g1_mset(m) (
  g1_mod = m;
  m ? (
    g1_qt = g1_ql; g1_qc = g1_qlc; g1_pgA = 9; g1_pn = (1 + 9 * 0.30) / 9;
    g1_c1f = 70; g1_c2f = 90;
    g1_k2z = 150; g1_k2F = 2.6;
    g1_k3 = 0.05;
    g1_mid = 0.78;
    g1_vb1 = -0.30; g1_vb2 = -0.22; g1_vb3 = -0.20; g1_vb4 = -0.10;
    g1_blk = 0.06; g1_sgd = 0.10; g1_sgk = 0.45;
    g1_sga = 1 - exp(-1 / (0.008 * 2 * srate)); g1_sgr = 1 - exp(-1 / (0.12 * 2 * srate));
    g1_otk = 0.45;
    g1_emfl = 1; g1_emfh = 1;
  ) : (
    g1_qt = g1_qd; g1_qc = g1_qdc; g1_pgA = 4.5; g1_pn = (1 + 4.5 * 0.03) / 4.5;
    g1_c1f = 22; g1_c2f = 30;
    g1_k2z = 30; g1_k2F = 1.6;
    g1_k3 = 0.07;
    g1_mid = 0.52;
    g1_vb1 = -0.30; g1_vb2 = -0.18; g1_vb3 = -0.48; g1_vb4 = -0.06;
    g1_blk = 0.20; g1_sgd = 0.30; g1_sgk = 0.22;
    g1_sga = 1 - exp(-1 / (0.025 * 2 * srate)); g1_sgr = 1 - exp(-1 / (0.38 * 2 * srate));
    g1_otk = 1.05;
    g1_emfl = 3.5; g1_emfh = 2.5;
  );
  g1L.cp1.g1_hpset(g1_c1f, 2 * srate); g1R.cp1.g1_hpset(g1_c1f, 2 * srate);
  g1L.cp2.g1_hpset(g1_c2f, 2 * srate); g1R.cp2.g1_hpset(g1_c2f, 2 * srate);
  g1L.cs2.g1_shset(g1_k2z, g1_k2F, 2 * srate); g1R.cs2.g1_shset(g1_k2z, g1_k2F, 2 * srate);
  g1L.ot.g1_otre(); g1R.ot.g1_otre(); g1L.pa.g1_pare(); g1R.pa.g1_pare();
  g1_lts = -1; g1_lsp = -1;
);

g1_kin = 1 / 1.3;
G1_PF1 = 14000; G1_LOD = 2; G1_LOL = 3;
G1_KF = 0.2586; G1_KQ = 0.797; G1_KG = 1.475;
g1_kpa = 1.0;
function g1_update() (
  g1_tmo = slider1 >= 0.5;
  g1_tmv = 6 * 10 ^ (1.6 * (slider14 / 10 - 1));
  slider14 < 0.05 ? g1_tmv *= slider14 / 0.05;
  g1_tcw = slider15 >= 0.5;
  g1_tmn = slider17 >= 0.5;
  in_setup(slider18, slider19 >= 0.5);
  drift_macro(slider20);
  g1_tog = 10 ^ (slider21 / 20) * g1_kout;
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, slider26, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = G1_LAT;
);
g1_kout = 1; g1_kcab = 1;

function g1_cnf(p) ( p < 1 ? 18 + 22 * p : p < 2 ? 40 + 40 * (p - 1) : p < 3 ? 80 + 70 * (p - 2) : p < 4 ? 150 + 110 * (p - 3) : 260 + 190 * (p - 4); );
function g1_cna(p) ( p < 1 ? 1 - 0.4 * p : p < 2 ? 0.6 - 0.15 * (p - 1) : p < 3 ? 0.45 - 0.13 * (p - 2) : p < 4 ? 0.32 - 0.1 * (p - 3) : 0.22 - 0.07 * (p - 4); );

function g1_tone(force) local(k, ch, i, f, gd) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  g1_s3 += (slider3 - g1_s3) * k; g1_s4 += (slider4 - g1_s4) * k; g1_s5 += (slider5 - g1_s5) * k;
  g1_sm += (g1_mid - g1_sm) * k;
  ch = g1_s3 + 3 * g1_s4 + 7 * g1_s5 + 11 * g1_sm;
  force || abs(ch - g1_lts) > 0.00001 ? (
    g1_lts = ch;
    g1L.ts.g1_tsset(g1_s4 / 10, g1_sm, g1_s3 / 10, 2 * srate); g1R.ts.g1_tsset(g1_s4 / 10, g1_sm, g1_s3 / 10, 2 * srate);
    f = g1_cnf(g1_s5); gd = g1_cna(g1_s5);
    g1L.cn.g1_lcset(f, gd, 2 * srate); g1R.cn.g1_lcset(f, gd, 2 * srate);
  );
  ch = 0; i = 0;
  loop(6,
    f = slider6 >= 0.5 ? slider(7 + i) : 0;
    g1_gb[i] += (f - g1_gb[i]) * k;
    abs(g1_gb[i] - f) < 0.005 ? g1_gb[i] = f;
    ch += abs(g1_gb[i]) * (i + 1) + g1_gb[i] * 0.37;
    i += 1;
  );
  force || abs(ch - g1_lgs) > 0.00001 ? (
    g1_lgs = ch;
    gd = abs(g1_gb[0]) + abs(g1_gb[1]) + abs(g1_gb[2]) + abs(g1_gb[3]) + abs(g1_gb[4]) + abs(g1_gb[5]);
    gd > 0 && !g1_geq ? (
      g1L.e1.g1_bqclr(); g1L.e2.g1_bqclr(); g1L.e3.g1_bqclr(); g1L.e4.g1_bqclr(); g1L.e5.g1_bqclr(); g1L.e6.g1_bqclr();
      g1R.e1.g1_bqclr(); g1R.e2.g1_bqclr(); g1R.e3.g1_bqclr(); g1R.e4.g1_bqclr(); g1R.e5.g1_bqclr(); g1R.e6.g1_bqclr();
    );
    g1_geq = gd > 0;
    g1L.e1.am_bq(2, 100, 1.1, g1_gb[0], 2 * srate); g1R.e1.am_bq(2, 100, 1.1, g1_gb[0], 2 * srate);
    g1L.e2.am_bq(2, 200, 1.1, g1_gb[1], 2 * srate); g1R.e2.am_bq(2, 200, 1.1, g1_gb[1], 2 * srate);
    g1L.e3.am_bq(2, 400, 1.1, g1_gb[2], 2 * srate); g1R.e3.am_bq(2, 400, 1.1, g1_gb[2], 2 * srate);
    g1L.e4.am_bq(2, 800, 1.1, g1_gb[3], 2 * srate); g1R.e4.am_bq(2, 800, 1.1, g1_gb[3], 2 * srate);
    g1L.e5.am_bq(2, 1600, 1.1, g1_gb[4], 2 * srate); g1R.e5.am_bq(2, 1600, 1.1, g1_gb[4], 2 * srate);
    g1L.e6.am_bq(2, 3200, 1.1, g1_gb[5], 2 * srate); g1R.e6.am_bq(2, 3200, 1.1, g1_gb[5], 2 * srate);
  );
  g1_pres += (slider13 - g1_pres) * k; g1_s16 += (slider16 - g1_s16) * k;
  g1_e1 += (g1_emfl - g1_e1) * k; g1_e2 += (g1_emfh - g1_e2) * k;
  ch = g1_pres + 3 * g1_s16 + 7 * g1_e1 + 11 * g1_e2;
  force || abs(ch - g1_lsp) > 0.00001 ? (
    g1_lsp = ch;
    f = g1_emfl; gd = g1_emfh; g1_emfl = g1_e1; g1_emfh = g1_e2;
    g1sL.g1_spkset(g1_s16 - 0.3); g1sR.g1_spkset(g1_s16 + 0.3);
    g1_emfl = f; g1_emfh = gd;
  );
);

function g1_bias(w1, w2, w3, w4) instance(v1a, v1b, v2a, cf, pin, pa) local(a) (
  a = dm_a;
  v1a.g1_stset(g1_vb1 + 0.05 * a * w1); v1b.g1_stset(g1_vb2 + 0.05 * a * w2);
  v2a.g1_stset(g1_vb3 + 0.06 * a * w3); cf.g1_stset(g1_vb4 + 0.03 * a * w1);
  pin.g1_syset(0.04 + 0.03 * a * w4);
  pa.g1_paset(0.03 * a * w4);
  pa.sbase = 1 + 0.015 * a * w3;
);

function g1_fix() instance(cs1, cf, pa) (
  cs1.g1_shset(4.2, 1.9, 2 * srate);
  pa.sup = 1; pa.sbase = 1; pa.env = 0; pa.genv = 0;

);
function g1_srinit() (
  g1_sr = srate;
  g1L.g1_fix(); g1R.g1_fix();
  g1pL.clp_pf_cfg(40000, G1_PF1, -1.5, 150); g1pL.clp_pf_reset(); g1pR.clp_pf_cfg(40000, G1_PF1, -1.5, 150); g1pR.clp_pf_reset();
  g1_xc = 2 * $pi * 40 / (2 * srate); g1_xlk = 1 - 2 * $pi * 4 / (2 * srate);
  g1_gba = 1 - exp(-1 / (0.003 * 2 * srate)); g1_gbr = 1 - exp(-1 / (0.15 * 2 * srate));
  g1kL1.am_bq(3, G1_KF * srate, G1_KQ, G1_KG, srate); g1kR1.am_bq(3, G1_KF * srate, G1_KQ, G1_KG, srate);
  g1_smk = 1 - exp(-1 / (0.02 * srate));
  g1_fd = 1 / (0.008 * srate);
  ost_init(g1_ostm); g1oL.ost_ch_init(); g1oR.ost_ch_init();
  in_init();
  g1_mset(slider1 >= 0.5);
  g1_update();
  g1_tone(1);
  g1_sg = slider2; g1_tgk = 10 ^ (1.6 * (g1_sg / 10 - 1)); g1_tmk = g1_mkall(g1_mod, g1_sg);
  g1L.g1_bias(0, 0, 0, 0); g1R.g1_bias(0, 0, 0, 0);
  g1_gk = g1_tgk; g1_mk = g1_tmk; g1_mv = g1_tmv; g1_cw = g1_tcw; g1_mn = g1_tmn; g1_og = g1_tog;
  g1_fade = 1; g1_fst = 0; g1_mon = g1_tmn;
);

function g1_set(md, ga, ba, tr, cn, gi, q1, q2, q3, q4, q5, q6, pr, ma, cb, mi, df, ou) (
  slider1 = md; slider2 = ga; slider3 = ba; slider4 = tr; slider5 = cn; slider6 = gi;
  slider7 = q1; slider8 = q2; slider9 = q3; slider10 = q4; slider11 = q5; slider12 = q6;
  slider13 = pr; slider14 = ma; slider15 = cb; slider16 = mi; slider20 = df; slider21 = ou;
  slider_automate(65535 + 524288 + 1048576);
);
#g1_pm = "Init|Doom Wall|Drone Bloom|Sludge Crawl|Desert Fuzz|Cathedral Low|Seventies Crunch|Riff Machine|Lead Sing|Graphic Scoop|Bright Rhythm|Clean Headroom";
function load_preset(p) (
  p == 1  ? g1_set(0,   5,   5,   5,   2, 1,   0,   0,   0,   0,   0,   0,   5,   5,  1,  3,  50,   0.0) :
  p == 2  ? g1_set(0, 7.5,   7,   5,   1, 1,   3,   2,   1,   0,  -1,  -2, 4.5,   7,  1,  4,  55,       -4.0) :
  p == 3  ? g1_set(0,   9,   6,   4,   0, 1,   4,   3,   2,  -1,  -3,  -4,   4,   8,  1,  5,  65,       -4.6) :
  p == 4  ? g1_set(0,   8, 7.5,   6,   1, 1,   2,   4,   3,   1,   0,  -2,   5,   6,  1,  3,  55,       -3.2) :
  p == 5  ? g1_set(0,   7,   6, 6.5,   2, 1,  -1,   2,   4,   3,   1,  -1,   6, 6.5,  1,  3,  50,       -3.3) :
  p == 6  ? g1_set(0,   6,   8,   4,   0, 1,   5,   3,   0,  -2,  -2,  -3,   4,   7,  1,  6,  50,       -4.7) :
  p == 7  ? g1_set(1, 4.5,   5,   6,   2, 1,   0,   0,   1,   2,   1,   0,   6,   6,  1,  3,  45,      -4.2) :
  p == 8  ? g1_set(1,   7,   5,   6,   3, 1,   1,  -1,  -2,   2,   3,   1,   6,   5,  1,  3,  45,      -2.6) :
  p == 9  ? g1_set(1, 8.5,   5, 5.5,   3, 1,   0,  -1,   2,   4,   3,   0, 5.5,   6,  1,  4,  50,      -3.9) :
  p == 10 ? g1_set(0,   7,   6,   6,   2, 1,   4,   2,  -4,  -6,  -2,   3,   6,   6,  1,  3,  50,       -3.5) :
  p == 11 ? g1_set(1,   5,   4,   7,   4, 1,  -2,  -1,   0,   1,   2,   3,   7,   5,  1,  2,  45,      -4.5) :
  p == 12 ? g1_set(1,   1,   5,   6,   2, 0,   0,   0,   0,   0,   0,   0,   5,   3,  1,  3,  40,         6.1) :
  p == 13 ? (
    g1_set(0, 5, 5, 5, 2, 1, 0, 0, 0, 0, 0, 0, 5, 5, 1, 3, 50, 0);
    slider17 = 0; slider18 = 0; slider19 = 0; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000; slider26 = -0.3;
    slider_automate(67108863);
  );
);

g1_dn = 0.000000000000000001;
G1GB = s74_alloc(8); g1_gb = G1GB;
g1_lgs = -1; g1_geq = 0;
g1_srinit();
g1dw1.drift_init(0.8 + rand(1) * 0.5); g1dw2.drift_init(0.8 + rand(1) * 0.5); g1dw3.drift_init(0.8 + rand(1) * 0.5); g1dw4.drift_init(0.8 + rand(1) * 0.5);
g1dw5.drift_init(0.8 + rand(1) * 0.5); g1dw6.drift_init(0.8 + rand(1) * 0.5); g1dw7.drift_init(0.8 + rand(1) * 0.5); g1dw8.drift_init(0.8 + rand(1) * 0.5);
g1_pkL = g1_pkR = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(27, i != 27 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
g1_update();

@block
prs_chk();
srate != g1_sr ? g1_srinit();
g1_update();
g1_tone(0);
g1_sg += (slider2 - g1_sg) * (1 - exp(-samplesblock / (0.025 * srate)));
abs(g1_sg - slider2) < 0.001 ? g1_sg = slider2;
g1_tgk = 10 ^ (1.6 * (g1_sg / 10 - 1));
g1_tmk = g1_mkall(g1_mod, g1_sg);
g1_sg !== g1_lsg ? ( g1_lsg = g1_sg; g1_lot(g1_sg); );
g1pL.clp_pf_block(g1_sg / 10, srate, samplesblock); g1pR.clp_pf_block(g1_sg / 10, srate, samplesblock);
g1_di = 0.2 * dm_s * samplesblock / srate;
g1L.g1_bias(g1dw1.drift_tick(g1_di), g1dw2.drift_tick(g1_di), g1dw3.drift_tick(g1_di), g1dw4.drift_tick(g1_di));
g1R.g1_bias(g1dw5.drift_tick(g1_di), g1dw6.drift_tick(g1_di), g1dw7.drift_tick(g1_di), g1dw8.drift_tick(g1_di));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
(g1_tmo != g1_mod || g1_tmn != g1_mon) && g1_fst == 0 ? g1_fst = 1;
g1_fst == 1 ? ( g1_fade -= g1_fd; g1_fade <= 0 ? (
  g1_fade = 0;
  g1_tmo != g1_mod ? ( g1_mset(g1_tmo); g1_mk = g1_tmk = g1_mkall(g1_mod, g1_sg); g1_tone(0); g1_lot(g1_sg); );
  g1_mon = g1_tmn;
  g1_hold = floor(0.012 * srate) + G1_LAT; g1_fst = 2; ); ) :
g1_fst == 2 ? ( g1_hold -= 1; g1_hold <= 0 ? g1_fst = 3; ) :
g1_fst == 3 ? ( g1_fade += g1_fd; g1_fade >= 1 ? ( g1_fade = 1; g1_fst = 0; ); );

in_process(spl0, spl1);
g1_xl = in_l; g1_xr = in_r;
g1_mon ? ( g1_xl = 0.5 * (g1_xl + g1_xr); );
g1_gk += (g1_tgk - g1_gk) * g1_smk; g1_mk += (g1_tmk - g1_mk) * g1_smk; g1_mv += (g1_tmv - g1_mv) * g1_smk;
g1_cw += (g1_tcw - g1_cw) * g1_smk; g1_og += (g1_tog - g1_og) * g1_smk;
g1_dn = -g1_dn;

g1_upL.g1_up(g1pL.clp_pf_run(g1_xl));
g1_a0 = g1L.g1_core(g1_upL.o0); g1_a1 = g1L.g1_core(g1_upL.o1);
g1_yl = g1kL1.am_run(g1_dnL.g1_dn2(g1_a0, g1_a1));
g1_mon ? g1_yr = g1_yl : (
  g1_upR.g1_up(g1pR.clp_pf_run(g1_xr));
  g1_a0 = g1R.g1_core(g1_upR.o0); g1_a1 = g1R.g1_core(g1_upR.o1);
  g1_yr = g1kR1.am_run(g1_dnR.g1_dn2(g1_a0, g1_a1));
);

g1_yl = g1sL.g1_spkrun(g1_yl); g1_yr = g1sR.g1_spkrun(g1_yr);
g1_k = g1_mk * g1_fade;
g1_yl = g1oL.ost_band(g1_yl * g1_k) * g1_og; g1_yr = g1oR.ost_band(g1_yr * g1_k) * g1_og;
ost_out(g1_yl, g1_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
g1_pkL = max(g1_pkL, abs(spl0)); g1_pkR = max(g1_pkR, abs(spl1));
g1_sgm = max(g1_sgm, 1 - g1L.pa.sup);

@gfx 1060 410
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1060, 410);
s74_pal(0); S74_LAMP = 0xFFA51F; S74_CHAR = 0x1D161B;

G1_OLV = 0x4A3242;
G1_OLD = 0x3B2835;
