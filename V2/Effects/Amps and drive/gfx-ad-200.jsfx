  a2cAR.f5.b0 = a2cA.f5.b0; a2cAR.f5.b1 = a2cA.f5.b1; a2cAR.f5.b2 = a2cA.f5.b2; a2cAR.f5.z1 = a2cA.f5.z1; a2cAR.f5.z2 = a2cA.f5.z2;
  a2cAR.f6.a1 = a2cA.f6.a1; a2cAR.f6.a2 = a2cA.f6.a2; a2cAR.f6.b0 = a2cA.f6.b0; a2cAR.f6.b1 = a2cA.f6.b1; a2cAR.f6.b2 = a2cA.f6.b2;
