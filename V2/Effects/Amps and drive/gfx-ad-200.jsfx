  a2cAR.f7.b1 = a2cA.f7.b1; a2cAR.f7.b2 = a2cA.f7.b2; a2cAR.f7.z1 = a2cA.f7.z1; a2cAR.f7.z2 = a2cA.f7.z2; a2cAR.f8.a1 = a2cA.f8.a1;
  a2cAR.f8.a2 = a2cA.f8.a2; a2cAR.f8.b0 = a2cA.f8.b0; a2cAR.f8.b1 = a2cA.f8.b1; a2cAR.f8.b2 = a2cA.f8.b2; a2cAR.f8.z1 = a2cA.f8.z1;
  a2cAR.f8.z2 = a2cA.f8.z2; a2cAR.lo.a1 = a2cA.lo.a1; a2cAR.lo.a2 = a2cA.lo.a2; a2cAR.lo.b0 = a2cA.lo.b0; a2cAR.lo.b1 = a2cA.lo.b1;
  a2cAR.lo.b2 = a2cA.lo.b2; a2cAR.lo.z1 = a2cA.lo.z1; a2cAR.lo.z2 = a2cA.lo.z2; a2cAR.on = a2cA.on; a2cAR.tr = a2cA.tr; a2cBR.f1.a1 = a2cB.f1.a1;
  a2cBR.f1.a2 = a2cB.f1.a2; a2cBR.f1.b0 = a2cB.f1.b0; a2cBR.f1.b1 = a2cB.f1.b1; a2cBR.f1.b2 = a2cB.f1.b2; a2cBR.f1.z1 = a2cB.f1.z1;
