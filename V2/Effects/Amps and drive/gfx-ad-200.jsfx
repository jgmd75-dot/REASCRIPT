desc:AD-200 [valve bass head] (GFX)
//tags: amp amplifier bass valve tube head cabinet di sub
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel and gfx-s74 (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s74.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{Crush,Deep}>-Model
slider2:4<0,10,0.1>-Gain
slider3:5<0,10,0.1>-Bass
slider4:5<0,10,0.1>-Middle
slider5:1<0,3,1{250 Hz,500 Hz,800 Hz,1.5 kHz}>-Middle frequency
slider6:5<0,10,0.1>-Treble
slider7:4<0,10,0.1>-Master
slider8:1<0,3,1{Off,8x10,4x10,1x15}>-Cabinet
slider9:3<0,10,0.1>-Mic position (on - off axis)
slider10:50<0,100,1>-Sub (%)
slider11:0<0,100,1>-DI blend (%)
slider12:50<0,100,1>-Drift (%)
slider13:0<-24,12,0.1>-Input trim (dB)
slider14:0<0,1,1{Off,On}>-Input guard
slider15:0<-24,12,0.1>-Output (dB)
slider16:0<0,100,1>-Band sat (%)
slider17:30<0,100,1>-Bias (%)
slider18:120<40,400,1>-Sat low band (Hz)
slider19:6000<2000,16000,10>-Sat high band (Hz)
slider20:-0.3<-24,0,0.1>-Ceiling (dB)
slider21:prs_sel=0<0,12,1{No preset,Init,Soul Fingerstyle,Jazz Warm,Deep Dub,Funk Slap,Studio DI Blend,Classic Rock,Pick Rock Drive,Punk Clank,Grunge Growl,Stoner Grind,Doom Crush}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=1048576

@init
#ui_man = "gfx-ad-200";
ext_noinit = 1;

function a2_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function a2_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function a2_tg(u) ( u >= 0 ? a2_th(u) : 1.8 * a2_th(u * 0.5555556) );
function a2_tgd(u) ( u >= 0 ? a2_thd(u) : a2_thd(u * 0.5555556) );
function a2_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function a2_tgF(u) ( u >= 0 ? a2_F(u) : 3.24 * a2_F(u * 0.5555556) );
function a2_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = a2_tgF(u1); b0 = b; g0 = a2_tg(b); n0 = 1 / max(a2_tgd(b), 0.05); );
function a2_strun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + a2_eb * (x - xp) + b0; xp = x; ga = a2_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : a2_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + a2_dn;
);
function a2_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = a2_F(u1); b0 = b; g0 = a2_th(b); n0 = 1 / max(a2_thd(b), 0.05); );
function a2_syrun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + a2_eb * (x - xp) + b0; xp = x; ga = a2_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : a2_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + a2_dn;
);
a2_eb = 0.25;

function a2_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function a2_shset(fz, F, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * F;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function a2_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);

function a2_tsset(t, m, l, C3, R3, fs) instance(b0, b1, b2, b3, a1, a2, a3)
  local(C1, C2, R1, R2, R4, nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  C1 = 0.00000000047; C2 = 0.000000047;
  R1 = 250000; R2 = 1000000; R4 = 47000;
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  b0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  b1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  b2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  b3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  a1 = k1 * q; a2 = k2 * q; a3 = k3 * q;
);
function a2_tsrun(x) instance(b0, b1, b2, b3, a1, a2, a3, x1, x2, x3, y1, y2, y3) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 + b3 * x3 - a1 * y1 - a2 * y2 - a3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);

a2_qn = 4096; a2_qr = 4; a2_qs = (a2_qn - 1) / (2 * a2_qr);
function a2_qbuild(tab, A, B) local(i, U, lo, hi, m) (
  i = 0;
  loop(a2_qn,
    U = -a2_qr + i / a2_qs; lo = -1; hi = 1;
    loop(44, m = 0.5 * (lo + hi); m - a2_th(A * (U - B * m)) > 0 ? hi = m : lo = m; );
    tab[i] = 0.5 * (lo + hi);
    i += 1;
  );
  tab[a2_qn] = tab[a2_qn - 1];
);
function a2_qint(t, c) local(i, h) (
  h = 1 / a2_qs; c[0] = 0; i = 0;
  loop(a2_qn - 1, c[i + 1] = c[i] + h * 0.5 * (t[i] + t[i + 1]); i += 1; );
);
function a2_qF(t, c, p) local(i, f, q) (
  p <= 0 ? t[0] * p / a2_qs : p >= a2_qn - 1 ? c[a2_qn - 1] + t[a2_qn - 1] * (p - a2_qn + 1) / a2_qs : (
    i = floor(p); f = p - i; q = t + i;
    c[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / a2_qs;
  );
);
function a2_qQ(t, p) local(i) ( p = min(max(p, 0), a2_qn - 1.001); i = floor(p); p -= i; t[i] + (t[i + 1] - t[i]) * p; );
function a2_paset(d) instance(t00, of0, t01, of1, va, vb) (
  t00 = a2_th(d); of0 = d / a2_A0 + a2_B0 * t00;
  t01 = t00; of1 = d / a2_A1 + a2_B1 * t01;
  va = vb = 0;
);
function a2_pa(u) instance(sup, sbase, e1, e2, t00, of0, t01, of1, dr, u1, fa1, fb1, va, vb, xp) local(p, y, y1, a, d, f) (
  p = u + a2_eb * (u - xp); xp = u;
  u = p / sup; d = (u - u1) * a2_qs;
  a2_w < 0.9999 ? (
    !va ? ( fa1 = a2_qF(a2_QA, a2_QAC, (u1 + of0 + a2_qr) * a2_qs); va = 1; );
    p = (u + of0 + a2_qr) * a2_qs; f = a2_qF(a2_QA, a2_QAC, p);
    y = (abs(d) > 0.00001 ? (f - fa1) / d * a2_qs : a2_qQ(a2_QA, p - 0.5 * d)) - t00; fa1 = f;
  ) : ( va = 0; );
  a2_w > 0.0001 ? (
    !vb ? ( fb1 = a2_qF(a2_QB, a2_QBC, (u1 + of1 + a2_qr) * a2_qs); vb = 1; );
    p = (u + of1 + a2_qr) * a2_qs; f = a2_qF(a2_QB, a2_QBC, p);
    y1 = (abs(d) > 0.00001 ? (f - fb1) / d * a2_qs : a2_qQ(a2_QB, p - 0.5 * d)) - t01; fb1 = f;
    y = a2_w < 0.9999 ? y + (y1 - y) * a2_w : y1;
  ) : ( vb = 0; );
  u1 = u;
  y *= sup;
  a = abs(y);
  e1 += (a - e1) * (a > e1 ? a2_sa1 : a2_sr1);
  e2 += (a - e2) * (a > e2 ? a2_sa2 : a2_sr2);
  dr = a2_sgd * min(max(0.65 * e1 + 0.35 * e2 - a2_sgt, 0) * a2_sgs, 1);
  sup = sbase * (1 - dr);
  y;
);
function a2_ot(x) instance(ph, php) local(y) (
  php = ph; ph = ph * a2_xlk + x * a2_xc;
  y = (a2_th(ph * a2_otk) - a2_xlk * a2_th(php * a2_otk)) / (a2_otk * a2_xc);
  y;
);

function a2_core(x) instance(cs1, v1a, hp1, v1b, hp2, ts, v2a, hp3, pin, ot) local(u) (
  u = cs1.a2_1run(x * a2_kin);
  u = -a2_G1 * v1a.a2_strun(u);
  u = hp1.a2_1run(u) * a2_gp;
  u = -a2_G2 * v1b.a2_strun(u);
  u = hp2.a2_1run(u);
  u = ts.a2_tsrun(u) * a2_kts;
  u = -a2_G3 * v2a.a2_strun(u);
  u = hp3.a2_1run(u * a2_mp);
  u = pin.a2_syrun(u * a2_kpi);
  u = pa.a2_pa(u);
  -ot.a2_ot(u);
);
function a2_coreR(x) instance(cs1, v1a, hp1, v1b, hp2, ts, v2a, hp3, pin, ot) local(u) (
  u = cs1.a2_1run(x * a2_kin);
  u = -a2_G1 * v1a.a2_strun(u);
  u = hp1.a2_1run(u) * a2_gp;
  u = -a2_G2 * v1b.a2_strun(u);
  u = hp2.a2_1run(u);
  u = ts.a2_tsrun(u) * a2_kts;
  u = -a2_G3 * v2a.a2_strun(u);
  u = hp3.a2_1run(u * a2_mp);
  u = pin.a2_syrun(u * a2_kpi);
  u = paR.a2_pa(u);
  -ot.a2_ot(u);
);
function a2_lin(x) instance(cs1, hp1, hp2, ts, hp3) (
  hp3.a2_1run(ts.a2_tsrun(hp2.a2_1run(hp1.a2_1run(cs1.a2_1run(x)))));
);

function a2_cabset(type, mic) instance(f1, f2, f3, f4, f5, f6, f7, f8, on, tr) local(m, lp) (
  m = mic / 10; on = type > 0;
  tr = type == 0 ? 0.84 : type == 2 ? 0.98 : 1;
  type == 1 ? (
    f1.s74_bqset(1, 45, 0, 0.85, srate);
    f2.s74_bqset(3, 95, 2.5, 1.1, srate);
    f3.s74_bqset(3, 420, -3, 1.1, srate);
    f4.s74_bqset(3, 1300, 1.5, 1.4, srate);
    f5.s74_bqset(3, 2600, 3.5 * (1 - m) - 1.5 * m, 1.8, srate);
    lp = 5000 - 1900 * m; f8.s74_bqset(3, 6200, -9 * m, 3, srate);
  ) : type == 2 ? (
    f1.s74_bqset(1, 55, 0, 0.95, srate);
    f2.s74_bqset(3, 115, 2, 1.2, srate);
    f3.s74_bqset(3, 520, -2.5, 1.2, srate);
    f4.s74_bqset(3, 1600, 2, 1.3, srate);
    f5.s74_bqset(3, 3100, 4 * (1 - m) - 1.5 * m, 1.8, srate);
    lp = 5800 - 2100 * m; f8.s74_bqset(3, 7200, -9 * m, 3, srate);
  ) : (
    f1.s74_bqset(1, 36, 0, 1.15, srate);
    f2.s74_bqset(3, 62, 3, 1.4, srate);
    f3.s74_bqset(3, 330, -3, 1.0, srate);
    f4.s74_bqset(3, 850, 2.5, 1.2, srate);
    f5.s74_bqset(3, 1900, 2 * (1 - m) - 1 * m, 2, srate);
    lp = 3400 - 1100 * m; f8.s74_bqset(3, 4600, -10 * m, 3, srate);
  );
  f6.s74_bqset(0, lp, 0, 0.5412, srate); f7.s74_bqset(0, lp, 0, 1.3066, srate);
);
function a2_cabclr() instance(f1, f2, f3, f4, f5, f6, f7, f8) (
  f1.s74_bqclr(); f2.s74_bqclr(); f3.s74_bqclr(); f4.s74_bqclr(); f5.s74_bqclr(); f6.s74_bqclr(); f7.s74_bqclr(); f8.s74_bqclr();
);
function a2_cabrun(x) instance(f1, f2, f3, f4, f5, f6, f7, f8, on, tr, lo) (
  (on ? f8.s74_bq(f7.s74_bq(f6.s74_bq(f5.s74_bq(f4.s74_bq(f3.s74_bq(f2.s74_bq(f1.s74_bq(x)))))))) : lo.s74_bq(x)) * tr;
);

function a2_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = a2_MK + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function a2_mk(k, g) local(p, i, f, q) (
  p = min(max(g, 0), 10); i = min(floor(p), 9); f = p - i; q = a2_MK + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
function a2_mcrow(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = a2_MK + 22 + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function a2_mcd(k, m) local(p, i, f, q) (
  p = min(max(m, 2), 10); i = min(floor(p), 9); f = p - i; q = a2_MK + 22 + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
function a2_mx(m, g) local(t) (
  t = min(max(m - 4, 0), 6);
  t = t < 2 ? 0.095 * t : t < 4 ? 0.19 + 0.12 * (t - 2) : t < 5 ? 0.43 + 0.05 * (t - 4) : 0.48 + 0.05 * (t - 5);
  t * ((g < 4 ? 0.66 + 0.085 * g : 1 - 0.133 * (g - 4)) * (1 - a2_w) + 0.53 * max(g - 4, 0) / 6 * a2_w);
);
function a2_pot(p) ( 0.002 + 0.998 * (10 ^ (2 * p) - 1) / 99; );

function a2_mem() (
  s74_mem = 0;
  a2_H = s74_alloc(64);
  s74_hbdesign(a2_H, 63, 8);
  a2_hu0 = 2 * a2_H[0]; a2_hu1 = 2 * a2_H[2]; a2_hu2 = 2 * a2_H[4]; a2_hu3 = 2 * a2_H[6];
  a2_hu4 = 2 * a2_H[8]; a2_hu5 = 2 * a2_H[10]; a2_hu6 = 2 * a2_H[12]; a2_hu7 = 2 * a2_H[14];
  a2_hu8 = 2 * a2_H[16]; a2_hu9 = 2 * a2_H[18]; a2_hu10 = 2 * a2_H[20]; a2_hu11 = 2 * a2_H[22];
  a2_hu12 = 2 * a2_H[24]; a2_hu13 = 2 * a2_H[26]; a2_hu14 = 2 * a2_H[28]; a2_hu15 = 2 * a2_H[30];
  a2_hd0 = a2_H[0]; a2_hd1 = a2_H[2]; a2_hd2 = a2_H[4]; a2_hd3 = a2_H[6];
  a2_hd4 = a2_H[8]; a2_hd5 = a2_H[10]; a2_hd6 = a2_H[12]; a2_hd7 = a2_H[14];
  a2_hd8 = a2_H[16]; a2_hd9 = a2_H[18]; a2_hd10 = a2_H[20]; a2_hd11 = a2_H[22];
  a2_hd12 = a2_H[24]; a2_hd13 = a2_H[26]; a2_hd14 = a2_H[28]; a2_hd15 = a2_H[30];

  a2_QA = s74_alloc(a2_qn + 1); a2_QB = s74_alloc(a2_qn + 1); a2_QAC = s74_alloc(a2_qn + 1); a2_QBC = s74_alloc(a2_qn + 1);
  a2_DL = s74_alloc(128); a2_DLR = s74_alloc(128);
  a2_MK = s74_alloc(48);
  ost_init(0);
);
function a2_up(x) instance(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15,
                           a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, o0, o1) (
  a31 = a30; a30 = a29; a29 = a28; a28 = a27; a27 = a26; a26 = a25; a25 = a24; a24 = a23; a23 = a22; a22 = a21;
  a21 = a20; a20 = a19; a19 = a18; a18 = a17; a17 = a16; a16 = a15; a15 = a14; a14 = a13; a13 = a12; a12 = a11;
  a11 = a10; a10 = a9; a9 = a8; a8 = a7; a7 = a6; a6 = a5; a5 = a4; a4 = a3; a3 = a2; a2 = a1;
  a1 = a0; a0 = x;
  o0 = a2_hu0 * (a0 + a31) + a2_hu1 * (a1 + a30) + a2_hu2 * (a2 + a29) + a2_hu3 * (a3 + a28)
    + a2_hu4 * (a4 + a27) + a2_hu5 * (a5 + a26) + a2_hu6 * (a6 + a25) + a2_hu7 * (a7 + a24)
    + a2_hu8 * (a8 + a23) + a2_hu9 * (a9 + a22) + a2_hu10 * (a10 + a21) + a2_hu11 * (a11 + a20)
    + a2_hu12 * (a12 + a19) + a2_hu13 * (a13 + a18) + a2_hu14 * (a14 + a17) + a2_hu15 * (a15 + a16);
  o1 = a15;
);
function a2_dn2(x0, x1) instance(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15,
                                 b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31,
                                 c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16) local(y) (
  b31 = b30; b30 = b29; b29 = b28; b28 = b27; b27 = b26; b26 = b25; b25 = b24; b24 = b23; b23 = b22; b22 = b21;
  b21 = b20; b20 = b19; b19 = b18; b18 = b17; b17 = b16; b16 = b15; b15 = b14; b14 = b13; b13 = b12; b12 = b11;
  b11 = b10; b10 = b9; b9 = b8; b8 = b7; b7 = b6; b6 = b5; b5 = b4; b4 = b3; b3 = b2; b2 = b1;
  b1 = b0; b0 = x0;
  y = a2_hd0 * (b0 + b31) + a2_hd1 * (b1 + b30) + a2_hd2 * (b2 + b29) + a2_hd3 * (b3 + b28)
    + a2_hd4 * (b4 + b27) + a2_hd5 * (b5 + b26) + a2_hd6 * (b6 + b25) + a2_hd7 * (b7 + b24)
    + a2_hd8 * (b8 + b23) + a2_hd9 * (b9 + b22) + a2_hd10 * (b10 + b21) + a2_hd11 * (b11 + b20)
    + a2_hd12 * (b12 + b19) + a2_hd13 * (b13 + b18) + a2_hd14 * (b14 + b17) + a2_hd15 * (b15 + b16)
    + 0.5 * c16;
  c16 = c15; c15 = c14; c14 = c13; c13 = c12; c12 = c11; c11 = c10; c10 = c9; c9 = c8; c8 = c7; c7 = c6;
  c6 = c5; c5 = c4; c4 = c3; c3 = c2; c2 = c1; c1 = x1;
  y;
);
function a2_lerp(a, b) ( a + (b - a) * a2_w; );
function a2_glerp(a, b) ( a * (b / a) ^ a2_w; );
function a2_model(force) local(fs2, f1, f2, f3, fz) (
  fs2 = 2 * srate;
  a2_G1 = a2_glerp(50, 40); a2_G2 = a2_glerp(34, 12); a2_G3 = a2_glerp(24, 10);
  a2_kts = a2_glerp(0.1, 0.14);
  a2_kpi = a2_glerp(1.8, 1.4);
  a2_sgd = a2_lerp(0.32, 0.07); a2_sgt = a2_lerp(0.25, 0.6); a2_sgs = a2_lerp(1.6, 1.2);
  a2_sa1 = 1 - exp(-1 / (a2_lerp(0.003, 0.001) * fs2)); a2_sr1 = 1 - exp(-1 / (a2_lerp(0.18, 0.06) * fs2));
  a2_sa2 = 1 - exp(-1 / (a2_lerp(0.04, 0.02) * fs2)); a2_sr2 = 1 - exp(-1 / (a2_lerp(0.4, 0.15) * fs2));
  a2_otk = a2_lerp(1.3, 0.4);
  a2_xlk = 1 - 2 * $pi * a2_lerp(9, 3) / fs2; a2_xc = 2 * $pi * 40 / fs2;
  a2_db = a2_lerp(1.3, 0.7);
  force || abs(a2_w - a2_wl) > 0.00001 ? (
    a2_wl = a2_w;
    fz = a2_lerp(30, 4); f1 = a2_lerp(30, 7); f2 = a2_lerp(20, 6); f3 = a2_lerp(18, 5);
    a2c.cs1.a2_shset(fz, 1.9, fs2); a2c.hp1.a2_hpset(f1, fs2); a2c.hp2.a2_hpset(f2, fs2); a2c.hp3.a2_hpset(f3, fs2);
    a2cR.cs1.a2_shset(fz, 1.9, fs2); a2cR.hp1.a2_hpset(f1, fs2); a2cR.hp2.a2_hpset(f2, fs2); a2cR.hp3.a2_hpset(f3, fs2);
    a2l.cs1.a2_shset(fz, 1.9, srate); a2l.hp1.a2_hpset(f1, srate); a2l.hp2.a2_hpset(f2, srate); a2l.hp3.a2_hpset(f3, srate);
    a2lR.cs1.a2_shset(fz, 1.9, srate); a2lR.hp1.a2_hpset(f1, srate); a2lR.hp2.a2_hpset(f2, srate); a2lR.hp3.a2_hpset(f3, srate);
  );
);
function a2_srinit() (
  a2_sr = srate;
  a2_mem();
  a2_A0 = 10; a2_B0 = 0.14; a2_A1 = 10; a2_B1 = 0.6;
  a2_qbuild(a2_QA, a2_A0, a2_B0); a2_qbuild(a2_QB, a2_A1, a2_B1); a2_qint(a2_QA, a2_QAC); a2_qint(a2_QB, a2_QBC);
  a2_LAT = 31;
  in_init();
  a2_sk = 1 - exp(-1 / (0.02 * srate));
  a2_msk = 1 - exp(-1 / (0.06 * srate));
  a2_cfi = 1 / (0.04 * srate);
  a2_pkd = exp(-1 / (0.3 * srate));
  a2_dkr = 1 / (0.012 * srate); a2_dk = 1; a2_dst = 0; a2_snap = 0;
  a2s1.s74_bqset(0, 90, 0, 0.7071, srate); a2s2.s74_bqset(0, 90, 0, 0.7071, srate);
  a2s1R.s74_bqset(0, 90, 0, 0.7071, srate); a2s2R.s74_bqset(0, 90, 0, 0.7071, srate);
  a2s3.s74_bqset(0, 90, 0, 0.7071, srate); a2s4.s74_bqset(0, 90, 0, 0.7071, srate);
  a2s3R.s74_bqset(0, 90, 0, 0.7071, srate); a2s4R.s74_bqset(0, 90, 0, 0.7071, srate);
  a2dh.a2_hpset(25, srate);
  a2dhR.a2_hpset(25, srate);
  a2pf.clp_pf_cfg(40000, A2_PF1, -1.5, 100); a2pf.clp_pf_reset();
  a2pfR.clp_pf_cfg(40000, A2_PF1, -1.5, 100); a2pfR.clp_pf_reset();
  a2k1.s74_bqset(5, A2_KF * srate, A2_KG, A2_KQ, srate);
  a2k1R.s74_bqset(5, A2_KF * srate, A2_KG, A2_KQ, srate);
  a2_wl = -1;
);

a2_kin = 1 / 1.3;
A2_PF1 = 14000;
A2_KF = 0.23875; A2_KG = 0.608; A2_KQ = 1.071;
a2_kout = 1;
function update() local(m, k) (
  a2_wt = slider1 >= 0.5;
  a2_mpt = a2_pot(slider7 / 10) * 0.08;
  a2_sbt = slider10 / 100;
  a2_dit = slider11 / 100;
  in_setup(slider13, slider14 >= 0.5);
  drift_macro(slider12);
  ost_setup(slider16 / 100, slider17 / 100, slider18, slider19, slider20, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = a2_LAT;
);

function a2_tone(force) local(k, ch, c3, r3, mf) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  mf = slider5 | 0;
  c3 = mf == 0 ? 5.6 : mf == 1 ? 1.65 : mf == 2 ? 0.578 : 0.203;
  r3 = mf == 1 ? 100000 : 250000;
  a2_s3 += (slider3 - a2_s3) * k; a2_s4 += (slider4 - a2_s4) * k; a2_s6 += (slider6 - a2_s6) * k;
  a2_lc3 += (log(c3 * 0.000000022) - a2_lc3) * k; a2_r3 += (r3 - a2_r3) * k;
  ch = a2_s3 + 2 * a2_s4 + 3 * a2_s6 + 5 * a2_lc3 + 7 * a2_r3 / 100000;
  force || abs(ch - a2_lts) > 0.00001 ? (
    a2_lts = ch;
    a2c.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, 2 * srate);
    a2cR.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, 2 * srate);
    a2l.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, srate);
    a2lR.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, srate);
  );
);

function a2_bias(w1, w2, w3, w4, w5) local(a) (
  a = dm_a * a2_db;
  a2c.v1a.a2_stset(a2_lerp(-0.36, -0.28) + 0.05 * a * w1);
  a2cR.v1a.a2_stset(a2_lerp(-0.36, -0.28) + 0.05 * a * w1);
  a2c.v1b.a2_stset(a2_lerp(-0.30, -0.22) + 0.05 * a * w2);
  a2cR.v1b.a2_stset(a2_lerp(-0.30, -0.22) + 0.05 * a * w2);
  a2c.v2a.a2_stset(a2_lerp(-0.26, -0.20) + 0.05 * a * w3);
  a2cR.v2a.a2_stset(a2_lerp(-0.26, -0.20) + 0.05 * a * w3);
  a2c.pin.a2_syset(0.04 + 0.03 * a * w4);
  a2cR.pin.a2_syset(0.04 + 0.03 * a * w4);
  pa.a2_paset(0.03 * a * w5);
  paR.a2_paset(0.03 * a * w5);
  pa.sbase = 1 + 0.015 * a * w2 * a2_lerp(1, 0.4);
  paR.sbase = 1 + 0.015 * a * w2 * a2_lerp(1, 0.4);
);

function a2_cab(force) local(t, k) (
  t = slider8 | 0;
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  a2_mic += (slider9 - a2_mic) * k;
  force ? (
    a2_ca = 0; a2_cx = 0; a2_tA = t; a2_tB = t;
    a2cA.a2_cabset(t, a2_mic); a2cB.a2_cabset(t, a2_mic); a2cA.a2_cabclr(); a2cB.a2_cabclr();
    a2cAR.a2_cabset(t, a2_mic); a2cBR.a2_cabset(t, a2_mic); a2cAR.a2_cabclr(); a2cBR.a2_cabclr();
  ) : (
    a2_cx == a2_ca && t != (a2_ca ? a2_tB : a2_tA) ? (
      a2_ca ? ( a2_tA = t; a2cA.a2_cabset(t, a2_mic); a2cA.a2_cabclr(); a2cAR.a2_cabset(t, a2_mic); a2cAR.a2_cabclr(); a2_ca = 0; )
            : ( a2_tB = t; a2cB.a2_cabset(t, a2_mic); a2cB.a2_cabclr(); a2cBR.a2_cabset(t, a2_mic); a2cBR.a2_cabclr(); a2_ca = 1; );
    );
    abs(a2_mic - a2_micl) > 0.0001 ? ( a2cA.a2_cabset(a2_tA, a2_mic); a2cB.a2_cabset(a2_tB, a2_mic); );
    abs(a2_mic - a2_micl) > 0.0001 ? ( a2cAR.a2_cabset(a2_tA, a2_mic); a2cBR.a2_cabset(a2_tB, a2_mic); );
  );
  a2_micl = a2_mic;
);

function a2_set(md, g, b, m, mf, t, ms, cb, mc, sb, di, df, ou) (
  slider1 = md; slider2 = g; slider3 = b; slider4 = m; slider5 = mf; slider6 = t; slider7 = ms;
  slider8 = cb; slider9 = mc; slider10 = sb; slider11 = di; slider12 = df; slider15 = ou;
  slider_automate(4095 + 16384);
);
function load_preset(p) (
  p == 1  ? a2_set(0,    4,   5,   5,   1,   5,   4,  1,  3,   50,  0,  50,   0.0) :
  p == 2  ? a2_set(1,    3,   6,   6,   1, 4.5,   4,  1,  4,   60,  0,  40,   0.0) :
  p == 3  ? a2_set(1,  2.5,   6,   5,   0,   3, 3.5,  3,  6,   60,  0,  40,   0.0) :
  p == 4  ? a2_set(1,  3.5, 8.5,   4,   1,   2,   4,  3,  7,   90,  0,  40,  -0.3) :
  p == 5  ? a2_set(1,    3,   7,   2,   1,   8, 4.5,  2,  1,   70, 20,  40,  -0.1) :
  p == 6  ? a2_set(1,    4,   6,   5,   2,   6,   4,  1,  3,   60, 50,  40,   0.2) :
  p == 7  ? a2_set(0,    5,   6,   6,   2,   5,   5,  1,  3,   50,  0,  50,  -1.5) :
  p == 8  ? a2_set(0,  6.5, 5.5,   7,   2,   6,   5,  2,  2,   60,  0,  50,   0.0) :
  p == 9  ? a2_set(0,    6,   5,   8,   3,   8,   6,  2,  1,   50, 15,  50,   1.3) :
  p == 10 ? a2_set(0,  7.5,   6,   7,   2,   5,   6,  1,  4,   60,  0,  55,   3.0) :
  p == 11 ? a2_set(0,  8.5,   7,   6,   1,   4,   7,  1,  4,   70,  0,  60,   3.9) :
  p == 12 ? a2_set(0,   10,   8,   5,   0,   4,   8,  1,  5,   80,  0,  65,   4.1) :
  p == 13 ? (
    a2_set(0, 4, 5, 5, 1, 5, 4, 1, 3, 50, 0, 50, 0);
    slider13 = 0; slider14 = 0; slider16 = 0; slider17 = 30; slider18 = 120; slider19 = 6000; slider20 = -0.3;
    slider_automate(1048575);
  );
);

function a2_start() (
  a2_srinit();
  a2_w = slider1 >= 0.5; a2_model(1); a2_gs = slider2; a2_gpt = a2_pot(a2_gs / 10);
  update(); a2_tone(1); a2_cab(1);
  a2_bias(0, 0, 0, 0, 0);
  pa.sup = 1; pa.sbase = 1;
  paR.sup = 1; paR.sbase = 1;
  a2_gp = a2_gpt; a2_mp = a2_mpt; a2_sb = a2_sbt; a2_di = a2_dit;
  a2_gpf = a2_gp; a2_mpf = a2_mp;
  a2_got = 1; a2_go = 1; a2_g = 1; a2_msy = a2_msl = 0; a2_gR = 1; a2_msyR = a2_mslR = 0;
  a2_dw = 0;
);
a2_dn = 0.000000000000000001;
function a2_tables() (
  a2_row(0, -21.71, -10.22, -3.27, 1.67, 6.13, 10.09, 12.86, 14.14, 14.92, 15.48, 15.84);
  a2_row(1, -48.05, -36.14, -29.48, -23.96, -19.41, -14.87, -11.49, -7.91, -5.24, -3.92, -3.11);
  a2_mcrow(0, -8.03, -8.03, -8.03, -3.71, 0, 2.98, 4.38, 4.79, 4.14, 3.65, 2.67);
  a2_mcrow(1, -8.04, -8.04, -8.04, -3.43, 0, 3.73, 7.08, 9.77, 13.17, 16.42, 19.13);
);
a2_start(); a2_tables();
a2ost.ost_ch_init(); a2ostR.ost_ch_init();
dw1.drift_init(0.8 + rand(1) * 0.5); dw2.drift_init(0.8 + rand(1) * 0.5); dw3.drift_init(0.8 + rand(1) * 0.5);
dw4.drift_init(0.8 + rand(1) * 0.5); dw5.drift_init(0.8 + rand(1) * 0.5);
a2_pk = 0; a2_sagm = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );
ui_dflt = 1;

