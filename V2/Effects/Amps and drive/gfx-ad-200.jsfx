spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
a2_pk = max(a2_pk * a2_pkd, max(abs(spl0), abs(spl1)));
a2_sagm = max(a2_sagm * a2_pkd, a2_m1 ? pa.dr : max(pa.dr, paR.dr));

@gfx 1040 400
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1040, 400);
s74_pal(0);

A2G_OD = 0x16263F; A2G_ODL = 0x1C2F4C; A2G_CH = 0x16181C; A2G_HAZ = 0xC9A24A;
A2G_INK = 0xDDBC66; A2G_DIM = 0xBFA066;
S74_IDX = 0xEFE6CF; S74_LAMP = 0xF2C55C;
gfx_setfont(11, "Arial", 14 * sc, 'b');
gfx_setfont(12, "Arial", 13 * sc, 'b');
gfx_setfont(13, "Arial", 12 * sc, 'b');
gfx_setfont(14, "Arial", 30 * sc, 'b');
gfx_setfont(15, "Arial", 14 * sc, 'b');
s74_lamp = 1;
sc != a2g_lsc ? ( a2g_lsc = sc; gfx_setfont(16, "Arial", 12 * sc, 'b'); gfx_setfont(10, "Arial", 11 * sc, 'b'); );
lk_font = 16; lk_font2 = 10;

function a2g_hash(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453; v - floor(v); );
function a2g_plate(x, y, w, h, col, seed) local(i, px, py, k) (
  ui_cola(0x000000, 0.55); s74_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(col); s74_r(x, y, w, h);
  i = 0;
  loop(floor(w * h / 60),
    px = x + 1 + a2g_hash(i * 3.17 + seed) * (w - 3); py = y + 1 + a2g_hash(i * 7.91 + seed + 1.3) * (h - 3); k = a2g_hash(i * 1.61 + seed + 4.2);
    ui_cola(k > 0.5 ? 0xFFFFFF : 0x000000, k > 0.5 ? 0.035 : 0.10); s74_r(px, py, 1, 1);
    i += 1;
  );
  ui_cola(0xFFFFFF, 0.10); s74_r(x, y, w, 1); s74_r(x, y, 1, h);
  ui_cola(0x000000, 0.35); s74_r(x, y + h - 1, w, 1); s74_r(x + w - 1, y, 1, h);
  s74_hex(x + 11, y + 11, 4.4); s74_hex(x + w - 11, y + 11, 4.4);
  s74_hex(x + 11, y + h - 11, 4.4); s74_hex(x + w - 11, y + h - 11, 4.4);
);
function a2g_sect(x1, x2, y, s) local(tw, th) (
  gfx_setfont(12); gfx_measurestr(s, tw, th);
  ui_col(A2G_INK); gfx_x = x1 * sc; gfx_y = y * sc - th * 0.5; gfx_drawstr(s);
  ui_col(A2G_HAZ); s74_r(x1 + tw / sc + 8, y - 0.5, x2 - x1 - tw / sc - 8, 1.2);
);
function a2g_cast(cx, cy, r, n, hov) local(a, ca, sa, i, t, l, bx, by, px, py, tx, ty, w) (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 11 : 8;
    ui_cola(A2G_INK, 0.8); gfx_circle((cx + sin(t) * (r + 9 + r + l + 4) * 0.5) * sc, (cy - cos(t) * (r + 9 + r + l + 4) * 0.5) * sc, max((i == 0 || i == 5 || i == 10 ? 1.8 : 1.2) * 0.75, 0.9) * sc, 1, 1);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  w = 0.30;
  bx = cx + sin(a - w) * r * 0.78; by = cy - cos(a - w) * r * 0.78;
  px = cx + sin(a + w) * r * 0.78; py = cy - cos(a + w) * r * 0.78;
  tx = cx + ca * (r + 7); ty = cy + sa * (r + 7);
  ui_cola(0x000000, 0.45); gfx_circle((cx + 1.6) * sc, (cy + 3) * sc, r * sc, 1, 1);
  ui_sstri((bx + 1.6) * sc, (by + 3) * sc, (tx + 1.6) * sc, (ty + 3) * sc, (px + 1.6) * sc, (py + 3) * sc);
  ui_col(0x151719); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_sstri(bx * sc, by * sc, tx * sc, ty * sc, px * sc, py * sc);
  ui_col(hov ? 0x3A3E41 : 0x303336); gfx_circle(cx * sc, cy * sc, (r - 1.4) * sc, 1, 1);
  ui_sstri((cx + sin(a - w) * (r - 1.4) * 0.78) * sc, (cy - cos(a - w) * (r - 1.4) * 0.78) * sc,
               (cx + ca * (r + 5.5)) * sc, (cy + sa * (r + 5.5)) * sc,
               (cx + sin(a + w) * (r - 1.4) * 0.78) * sc, (cy - cos(a + w) * (r - 1.4) * 0.78) * sc);
  ui_cola(0xFFFFFF, 0.13); gfx_arc(cx * sc, cy * sc, (r - 2) * sc, -0.72 * $pi, -0.12 * $pi, 1);
  ui_col(S74_IDX); gfx_circle((cx + ca * r * 0.82) * sc, (cy + sa * r * 0.82) * sc, max(2.2, r * 0.11) * sc, 1, 1);
);
function a2g_knob(cx, cy, r, idx, lo, hi, def, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 4000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 7) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - a2g_lt < 0.35 && a2g_lid == idx && !a2g_mv) || (mouse_cap & 4) ? ( s74_set(idx, def); drag_id = -1; a2g_lt = 0; ) : (
      drag_id = did; a2g_ky = mouse_y; a2g_ky0 = mouse_y; a2g_mv = 0; a2g_lt = time_precise(); a2g_lid = idx;
      a2g_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !a2g_mv && abs(mouse_y - a2g_ky0) > 3 * sc ? ( a2g_mv = 1; a2g_ky = mouse_y; );
  drag_id == did && a2g_mv ? (
    a2g_kn = min(max(a2g_kn + (a2g_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); a2g_ky = mouse_y;
    v = lo + a2g_kn * (hi - lo); v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s74_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    v = min(max(v + mouse_wheel / 120 * ((mouse_cap & 8) ? stp : 5 * stp), lo), hi); v = lo + floor((v - lo) / stp + 0.5) * stp;
    s74_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  a2g_cast(cx, cy, r, n, hov || drag_id == did);
  (hov || drag_id == did) ? (
    sprintf(#a2g_v, fmt, v); gfx_setfont(15); gfx_measurestr(#a2g_v, a2g_tw, a2g_th);
    ui_col(A2G_CH); gfx_rect(cx * sc - a2g_tw * 0.5 - 7 * sc, (cy + r + 13) * sc, a2g_tw + 14 * sc, a2g_th + 4 * sc);
    ui_col(S74_LAMP); gfx_x = floor(cx * sc - a2g_tw * 0.5 + 0.5); gfx_y = (cy + r + 15) * sc; gfx_drawstr(#a2g_v);
  ) : (
    gfx_setfont(11); ui_col(A2G_INK); s74_tc(cx, cy + r + 21, label);
  );
);
function a2g_sag(x, y, w, h, sg) instance(pos, vel, lt) local(dt, tgt, i, d, px, wx, ww) (
  dt = min(max(time_precise() - lt, 0.001), 0.05); lt = time_precise();
  tgt = min(max(sg / 0.3, -0.04), 1.04);
  vel += (150 * (tgt - pos) - 17 * vel) * dt; pos += vel * dt; pos = min(max(pos, -0.05), 1.05);
  ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
  ui_col(0x101112); s74_r(x, y, w, h);
  wx = x + 5; ww = w - 10;
  ui_col(S74_LAMPD); s74_r(wx, y + 5, ww, h - 10);
  i = 0; loop(10, ui_cola(S74_LAMPW, 0.12); s74_r(wx + ww * 0.03 * i, y + 5 + i * 0.5, ww * (1 - 0.06 * i), h - 10 - i); i += 1; );
  i = 0;
  loop(7,
    d = i * 5; px = wx + 22 + (ww - 44) * d / 30;
    ui_col(d >= 20 ? S74_RED : S74_CHAR); s74_r(px, y + 8, 1.2, i % 2 ? 4 : 7);
    gfx_setfont(13); i % 2 == 0 ? ( sprintf(#a2g_e, "%d", d); s74_tc(px, y + 24, #a2g_e); );
    i += 1;
  );
  ui_cola(S74_CHAR, 0.8); s74_r(wx + 22, y + 8, (ww - 44) * 20 / 30, 1); ui_col(S74_RED); s74_r(wx + 22 + (ww - 44) * 20 / 30, y + 8, (ww - 44) * 10 / 30, 1);
  px = wx + 22 + (ww - 44) * pos;
  ui_col(S74_NDL); s74_r(px - 0.8, y + 6, 1.8, h - 12);
  gfx_setfont(13); ui_col(S74_CHAR); s74_tc(wx + ww * 0.5, y + h - 13, "SUPPLY SAG %");
  ui_cola(0xFFFFFF, 0.08); s74_r(wx, y + 5, ww, (h - 10) * 0.4);
);

