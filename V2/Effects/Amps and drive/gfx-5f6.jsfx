desc:5F6 [tweed bass amp] (GFX)
//tags: amp amplifier guitar bass valve tube tweed combo cabinet 4x10 crunch blues
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel and gfx-s74 (.jsfx-inc) in the same folder.
//
// 5F6. A four-input valve bass amp with four 10" speakers in an open-back cabinet, after the 1950s tweed bass-amp
// circuit (5F6-A) that became the template for the rock amp: a cathode-follower-driven tone stack, presence in the
// negative feedback loop, two channels you can jumper together (personal use; the sound is designed from scratch).
//
// MODEL (the two lenses in the header)
//   TWEED      the 5F6-A circuit: a low-gain first valve, the cathode follower clipping into the tone stack, little
//              feedback, a valve rectifier that sags, a small output transformer. Dynamic and touch-sensitive; cranked
//              it blooms and the low end swells and sputters a little after each hard note.
//   GREYBEARD  the same amp re-voiced the way the mid-60s amps were: a higher-gain first valve set for headroom, the
//              scooped tone stack (100 k slope, 10 k middle, 100 nF / 47 nF), more feedback, a stiffer supply and a
//              bigger transformer: glassy, tight, clean far up the dial. The panel turns dark charcoal grey with it.
//   A change glides (40 ms): every part of the circuit moves to its new value, so nothing clicks.
//
// SIGNAL FLOW (each side, L and R, runs its own complete, identical amp; MONO IN feeds both with L + R)
//   input -> first valve (both channels share it: two identical halves of one bottle) -> coupling cap ->
//   the two channel VOLUME pots: BRIGHT (a small cap across the pot, strongest at low volume) and NORMAL ->
//   mixing resistors -> second 12AX7 stage -> the cathode follower (direct-coupled: its grid draws current on the
//   positive swing, so it compresses one side - the tweed's asymmetric grind) -> the tone stack, driven from the low
//   impedance of the follower (the passive TREBLE / BASS / MIDDLE network worked out as its exact third-order
//   transfer function from the part values; the three pots interact as on the real amp) -> the long-tailed-pair
//   phase inverter -> coupling caps into the two power valves (hit hard, the grids draw current and charge the caps:
//   the bias shifts colder for a moment - crossover hash and the 'bloom' after a big note) -> push-pull, class AB,
//   with the negative feedback loop solved exactly every sample (Newton); PRESENCE shunts the feedback's highs to
//   ground (less feedback up top, a brighter, more open top end) -> supply sag (the rectifier and reservoir: the
//   rails drop under load and recover slowly) -> output transformer (the core saturates on low-frequency flux) ->
//   the speaker load (low feedback lets the speaker's resonance and rising impedance colour the output).
//   ANTI-ALIASING (the house drive standard): the amp runs at the host rate (no latency) with first-order ADAA on every
//   valve stage, the follower and the power stage (its closed feedback loop has an exact antiderivative), a
//   drive-tracking pre-filter into the first valve (a low-pass sliding from 40 kHz, capped near the Nyquist, down to
//   9 kHz, and a low shelf easing the lows below 150 Hz down by up to 1.5 dB as VOLUME rises), a drive-tracking knee
//   on the follower's grid-current clip (it softens as VOLUME rises) and a fixed post-shelf that makes up the
//   stages' top-end droop.
// CHANNELS: BLEND is the old jumper trick as one knob. Left = NORMAL only, right = BRIGHT only, the middle = both
//   channels jumpered at the same VOLUME (the fat bottom of one and the top of the other, and up to 6 dB more drive).
// VOLUME: the preamp drive. Every VOLUME setting is level-matched (measured on pink noise), so it changes the colour,
//   not the loudness; the two models are matched to each other the same way.
// CAB (the lens): a procedural 4x10 open-back cabinet (no impulse responses). Off = the line out, for your own IRs.
//   MIC: from on-axis (bright, cone breakup) to off-axis (darker). The two sides' mics sit a hair apart.
// DRIFT (0 - 100 %, 50 % = standard): the valves' bias wanders (each side on its own), the supply breathes, the power
//   valves drift out of balance; TWEED (the valve rectifier) wanders more than GREYBEARD. 0 % = perfectly steady.
// IN / OUT: TRIM (click the knob for the house GUARD), OUTPUT, band SAT (the output soft clip is always on).
//
// GUI: drag a knob (SHIFT = fine, double-click or Ctrl-click = default, wheel); values show while a knob is touched.
//   Click the LCD (or PRESETS) for the preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s74.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{Tweed,Greybeard}>-Model
slider2:5<0,10,0.1>-Volume
slider3:50<0,100,1>-Blend (normal - jumpered - bright, %)
slider4:6<0,10,0.1>-Treble
slider5:5<0,10,0.1>-Middle
slider6:5<0,10,0.1>-Bass
slider7:4<0,10,0.1>-Presence
slider8:1<0,1,1{Off,On}>-Cabinet
slider9:3<0,10,0.1>-Mic position (on - off axis)
slider10:0<0,1,1{Off,On}>-Mono in
slider11:0<-24,12,0.1>-Input trim (dB)
slider12:0<0,1,1{Off,On}>-Input guard
slider13:50<0,100,1>-Drift (%)
slider14:0<-24,12,0.1>-Output (dB)
slider15:0<0,100,1>-Band sat (%)
slider16:30<0,100,1>-Bias (%)
slider17:120<40,400,1>-Sat low band (Hz)
slider18:6000<2000,16000,10>-Sat high band (Hz)
slider19:-0.3<-24,0,0.1>-Ceiling (dB)
slider20:prs_sel=0<0,12,1{No preset,Init,Chicago Shuffle,Rockabilly Snap,Harp Howl,Roots Rock Crunch,Desert Bloom,Upright Thump,Surf Glass,Country Chicken Pick,Soul Clean,Sixties Session Bass,Garage Stomp}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=1048576

@init
#ui_man = "gfx-5f6";                                    // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
s74_mem = 0;
F6_MKTAB = s74_alloc(32);                                   // the makeup tables: TWEED, GREYBEARD (11 points each, dB)
F6_BTAB = s74_alloc(32);                                    // BLEND towards NORMAL / BRIGHT: the level lost (6 points each, dB)
F6_LAT = 0;                                              // no oversampling: no latency

// ---------- valve curves ----------
// a smooth saturator (rational, exactly 1 from |x| = 3) and its slope
function f6_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function f6_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
// triode: the grid-conduction side (positive) clips firmly at 1, the cutoff side runs softer and further (1.8)
function f6_tg(u) ( u >= 0 ? f6_th(u) : 1.8 * f6_th(u * 0.5555556) );
function f6_tgd(u) ( u >= 0 ? f6_thd(u) : f6_thd(u * 0.5555556) );
// antiderivatives (for the anti-aliasing): th = x / 9 + (8 / 3) x / (x^2 + 3), so its integral is x^2 / 18 +
// (4 / 3) ln(1 + x^2 / 3) up to |x| = 3, then 2.3483924 + (|x| - 3) (F(0) = 0); the triode's two sides scale it
function f6_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function f6_tgF(u) ( u >= 0 ? f6_F(u) : 3.24 * f6_F(u * 0.5555556) );
// a stage at operating point b: unity small-signal gain, nothing out at rest (the caller inverts). First-order ADAA:
// y = (G(u) - G(u1)) / (u - u1) on u = x + b (the curve read at the midpoint when the two are within 1e-5)
// (a new bias re-reads the last point on the shifted curve, so a DRIFT change never steps)
function f6_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = f6_tgF(u1); b0 = b; g0 = f6_tg(b); n0 = 1 / max(f6_tgd(b), 0.05); );
function f6_strun(x) instance(b0, g0, n0, u1, ga1) local(u, ga, d, y) (
  u = x + b0; ga = f6_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : f6_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + f6_dn;
);
// the long-tailed pair: nearly symmetric (ADAA the same way)
function f6_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = f6_F(u1); b0 = b; g0 = f6_th(b); n0 = 1 / max(f6_thd(b), 0.05); );
function f6_syrun(x) instance(b0, g0, n0, u1, ga1) local(u, ga, d, y) (
  u = x + b0; ga = f6_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : f6_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + f6_dn;
);

// ---------- first-order sections (bilinear, c = 2 fs) ----------
function f6_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
// cathode bypass: the gain falls by F below fz (Rk Ck), a shelf between fz and F * fz
function f6_shset(fz, F, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * F;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function f6_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);

// ---------- the channel VOLUME pots (1 M, audio taper) ----------
// BRIGHT: a cap from the top of the pot to the wiper - the pot's gain k plus (1 - k) of a high-pass at
// 1 / (2 pi tp), tp = Ra Rb C / (Ra + Rb): strongest at low volume. The pot never quite closes (1 % at 0).
// Coefficients are shared by both sides (globals); each side keeps its own state.
function f6_volset(p, cap, fs) local(fr, Ra, Rb, tp, c, w) (
  fr = 0.01 + 0.99 * (10 ^ (2 * p) - 1) / 99;
  Rb = fr * 1000000; Ra = (1 - fr) * 1000000;
  f6_vk = fr; f6_vkb = 1 - fr;
  tp = max(Ra * Rb / (Ra + Rb + 1) * cap, 0.0000000001);
  c = 2 * fs; w = 1 / tp;
  f6_vhb0 = c / (c + w); f6_vha1 = (w - c) / (c + w);
);
function f6_volrun(x) instance(x1, y1) local(h) (
  h = f6_vhb0 * (x - x1) - f6_vha1 * y1; x1 = x; y1 = h;
  f6_vk * x + f6_vkb * h;
);

// ---------- the passive tone stack (third order, from the part values) ----------
// t, m, l = treble, middle, bass pot positions 0..1 (middle and bass audio taper); C1 treble cap, C2 bass cap,
// C3 middle cap, R1 treble pot, R2 bass pot, R3 middle pot, R4 slope resistor. Driven from a low impedance (the
// cathode follower) into a high one, as the transfer function assumes. Coefficients shared (globals).
function f6_tsset(t, m, l, C1, C2, C3, R1, R2, R3, R4, fs)
  local(nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  f6_tb0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  f6_tb1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  f6_tb2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  f6_tb3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  f6_ta1 = k1 * q; f6_ta2 = k2 * q; f6_ta3 = k3 * q;
);
function f6_tsrun(x) instance(x1, x2, x3, y1, y2, y3) local(y) (
  y = f6_tb0 * x + f6_tb1 * x1 + f6_tb2 * x2 + f6_tb3 * x3 - f6_ta1 * y1 - f6_ta2 * y2 - f6_ta3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);

// ---------- the power stage: two valves in push-pull (class AB) inside the feedback loop ----------
// Each valve conducts as 0.5 (1 + th(v -/+ c)): c = how cold the bias sits (crossover), d = the pair's imbalance.
// The pair: Y = PP(v) = 0.5 (th(v - c + d) + th(v + c + d)) - PP0. The loop: v = A (U - B Y) where the feedback B Y
// passes the PRESENCE network (a first-order high-pass shunt): fb = B (Y - p h(Y)), h(Y) = hb0 Y + s (s from the
// filter's state), so per sample the loop is Y = PP(A (U - Be Y) + A B p s), Be = B (1 - p hb0) - solved exactly by
// Newton from the last sample's answer (g' >= 1: it always converges). Y, U are relative to the supply (sup), so the
// clip level falls with the rails while the small-signal gain stays.
// Anti-aliased (first-order ADAA on the closed loop): with z = A U + A B p s the loop is Y = Q(z), z = v + k PP(v),
// so its antiderivative has a closed form, Int Q dz = Int PP dv + k Y^2 / 2 = (F(v - c + d) + F(v + c + d)) / 2 - PP0 v
// + k Y^2 / 2; the output is (A(z) - A(z1)) / (z - z1). The loop itself (the presence filter) runs on the exact Y.
function f6_pa(u) instance(yn, yp, h1, env, sh, sup, sbase, pd, pp0, v1) local(un, o, c, v, ta, tb, g, k, y, a, z, aa, d, z1, az1, y1) (
  un = u / sup;
  o = f6_pga * f6_pB * f6_pp * (-f6_phb0 * yp - f6_pha1 * h1);
  c = f6_pc0 + sh;
  k = f6_pga * f6_pBe;
  loop(3,
    v = f6_pga * un - k * yn + o; ta = v - c + pd; tb = v + c + pd;
    g = yn - 0.5 * (f6_th(ta) + f6_th(tb)) + pp0;
    yn -= g / (1 + k * 0.5 * (f6_thd(ta) + f6_thd(tb)));
  );
  z = f6_pga * un + o; v = z - k * yn;
  aa = 0.5 * (f6_F(v - c + pd) + f6_F(v + c + pd)) - pp0 * v + 0.5 * k * yn * yn;
  // the last point re-read on today's curve (the bias, the balance and the loop gain move): no step when they change
  y1 = 0.5 * (f6_th(v1 - c + pd) + f6_th(v1 + c + pd)) - pp0; z1 = v1 + k * y1;
  az1 = 0.5 * (f6_F(v1 - c + pd) + f6_F(v1 + c + pd)) - pp0 * v1 + 0.5 * k * y1 * y1;
  d = z - z1; y = abs(d) > 0.00001 ? (aa - az1) / d : 0.5 * (yn + y1);
  v1 = v;
  h1 = f6_phb0 * (yn - yp) - f6_pha1 * h1; yp = yn;
  // grid current charges the coupling caps: the bias runs colder for a moment, then recovers
  a = max(abs(v) - 2.5, 0) * f6_bsk;
  sh += (min(a, 0.45) - sh) * (a > sh ? f6_bsa : f6_bsr);
  y *= sup;
  // the supply: the rectifier and reservoir sag under load and recover slowly
  a = abs(y);
  env += (a - env) * (a > env ? f6_sga : f6_sgr);
  sup = sbase * (1 - f6_sgk * min(max(env - f6_sge, 0) / (1 - f6_sge), 1));
  y;
);
// the output transformer: the core saturates on flux (integrate, saturate, differentiate)
function f6_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * f6_xlk + x * f6_xc; s = f6_th(ph * f6_xk) / f6_xk; y = (s - sp * f6_xlk) / f6_xc; sp = s; y;
);

// ---------- one side of the amp ----------
function f6_core(x) instance(pf, cs1, v1, hc1, vb, cs2, v2, cf, ts, pin, hpp, pw, hdc, ot) local(u, n, m, w) (
  u = cs1.f6_1run(pf.clp_pf_run(x) * f6_kin + f6_dn);   // the drive-tracking pre-filter, the first valve's cathode bypass                   // the first valve's cathode bypass
  u = -f6_g1 * v1.f6_strun(u);
  u = hc1.f6_1run(u);                                    // coupling cap into the volume pots
  n = vb.f6_volrun(u);                                   // BRIGHT channel (the cap across its pot)
  m = (n * f6_gb + u * f6_vk * f6_gn) * f6_pad;          // + NORMAL, through the mixing resistors
  w = -f6_g2 * v2.f6_strun(cs2.f6_1run(m));              // the second stage
  w = cf.clp_run(w);                                     // the cathode follower: grid current on the positive swing (a knee)
  w = ts.f6_tsrun(w);                                    // the tone stack
  w = pin.f6_syrun(w * f6_kpi);                          // the phase inverter
  w = hpp.f6_1run(w);                                    // coupling caps into the power valves
  w = pw.f6_pa(w);
  w = hdc.f6_1run(w);                                    // (the push-pull primary carries no DC)
  ot.f6_ot(w);
);
// per block: the follower's knee (it widens as VOLUME rises: the drive-tracking knee) and the pre-filter
function f6_cblk(n) instance(pf, cf) local(k) (
  k = cf.clp_kt_block(f6_s2 / 10, srate, n);
  cf.clp_set(2, f6_kc, 100000, 0); cf.clp_knee(k * f6_kc);
  pf.clp_pf_block(f6_s2 / 10, srate, n);
  cf.clp_tidy();
);

// ---------- the speaker load (low feedback lets the speaker's impedance through) ----------
function f6_ldset(fs) instance(r1, r2) (
  r1.s74_bqset(3, 95, f6_lr, 1.3, fs);                   // the cone's resonance
  r2.s74_bqset(5, 2600, f6_lh, 0.6, fs);                 // the voice coil's rising impedance
);
function f6_ldrun(x) instance(r1, r2) ( r2.s74_bq(r1.s74_bq(x)); );

// ---------- the cabinet: four 10" in an open back, one mic ----------
function f6_cabset(m, k, fs) instance(c1, c2, c3, c4, c5, c6, c7, c8) local(lp) (
  m = min(max(m, 0), 1);
  c1.s74_bqset(1, 72 * k, 0, 0.75, fs);                  // open back: the low end rolls off under the resonance
  c2.s74_bqset(3, 108 * k, 2.5, 1.3, fs);                // the cones' resonance in the box
  c3.s74_bqset(3, 430 * k, -2.5, 1.0, fs);
  c4.s74_bqset(3, 1650 * k, 2.5, 1.1, fs);               // the 10" bark
  c5.s74_bqset(3, 3300 * k, 4.5 * (1 - m), 2.0, fs);     // cone breakup, on axis
  lp = (5800 - 2100 * m) * k;
  c6.s74_bqset(0, lp, 0, 0.5412, fs); c7.s74_bqset(0, lp, 0, 1.3066, fs);
  c8.s74_bqset(3, 7200 * k, -9 * m, 3, fs);              // off axis: a deeper notch above the roll-off
);
function f6_cabrun(x) instance(c1, c2, c3, c4, c5, c6, c7, c8) (
  c8.s74_bq(c7.s74_bq(c6.s74_bq(c5.s74_bq(c4.s74_bq(c3.s74_bq(c2.s74_bq(c1.s74_bq(x))))))));
);

// ---------- the makeup: every VOLUME level-matched, per model (dB at VOLUME 0, 1, .. 10; pink noise, -21 dBFS) ----------
function f6_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = F6_MKTAB + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
f6_row(0, 13.48, 9.60, 6.29, 3.17, 1.11, 0.13, -0.68, -0.95, -0.88, -0.89, -0.65);
f6_row(1, 19.30, 15.30, 11.69, 7.93, 4.73, 2.39, 0.49, -0.65, -1.28, -1.59, -1.60);
// one channel alone drives the mixer with half the signal (and NORMAL has no bright cap): BLEND towards NORMAL is
// made up as measured (dB at VOLUME 0, 2, .. 10, BLEND = NORMAL; between there and the middle it eases out)
F6_BTAB[0] = 13.21; F6_BTAB[1] = 12.49; F6_BTAB[2] = 10.06; F6_BTAB[3] = 5.03; F6_BTAB[4] = 2.10; F6_BTAB[5] = 0.75;
F6_BTAB[6] = 15.20; F6_BTAB[7] = 14.86; F6_BTAB[8] = 13.86; F6_BTAB[9] = 10.17; F6_BTAB[10] = 5.04; F6_BTAB[11] = 1.39;
// ... and towards BRIGHT (a smaller trim; from the middle it eases in the same way)
F6_BTAB[12] = 0.72; F6_BTAB[13] = 0.63; F6_BTAB[14] = 0.36; F6_BTAB[15] = -0.37; F6_BTAB[16] = 0.03; F6_BTAB[17] = 0.75;
F6_BTAB[18] = 0.49; F6_BTAB[19] = 0.54; F6_BTAB[20] = 0.80; F6_BTAB[21] = 0.71; F6_BTAB[22] = 1.07; F6_BTAB[23] = 1.39;
function f6_bmk(mm, v, b) local(p, i, f, x, y, u, w) (
  p = min(max(v, 0), 10) / 2; i = min(floor(p), 4); f = p - i;
  x = F6_BTAB[i] * (1 - f) + F6_BTAB[i + 1] * f;
  y = F6_BTAB[6 + i] * (1 - f) + F6_BTAB[7 + i] * f;
  u = F6_BTAB[12 + i] * (1 - f) + F6_BTAB[13 + i] * f;
  w = F6_BTAB[18 + i] * (1 - f) + F6_BTAB[19 + i] * f;
  (x + (y - x) * mm) * max(1 - 2 * b, 0) ^ 1.75 + (u + (w - u) * mm) * max(2 * b - 1, 0) ^ 1.75;
);
function f6_mk(mm, v) local(p, i, f, a, b) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i;
  a = F6_MKTAB[i] * (1 - f) + F6_MKTAB[i + 1] * f;
  b = F6_MKTAB[11 + i] * (1 - f) + F6_MKTAB[12 + i] * f;
  a + (b - a) * mm;
);

// ---------- everything that depends on the sample rate ----------
// the fixed filters of one side
function f6_fix(fs2) instance(hc1, hpp, hdc, pw, pf, cf) (
  hc1.f6_hpset(8, fs2);                                  // 20 nF into 1 M
  hpp.f6_hpset(7, fs2);                                  // 100 nF into 220 k
  hdc.f6_hpset(4, fs2);
  pw.sup = 1; pw.sbase = 1; pw.yn = 0;
  pf.clp_pf_cfg(40000, 9000, -1.5, 150); pf.clp_pf_reset();   // the house pre-filter: 40 kHz (capped) to 9 kHz, -1.5 dB lows
  cf.clp_kt_cfg(0.5, 1); cf.clp_reset();                      // the follower's knee: half-width 0.5 to 1 x its limit
);
function f6_srinit() local(fs2) (
  f6_sr = srate; fs2 = srate;                            // the amp runs at the host rate (anti-aliased stages)
  cL.f6_fix(fs2); cR.f6_fix(fs2);
  // the fixed post-shelf: makes up the top-end droop of the anti-aliased stages and the pre-filter (fitted so the
  // small-signal response at VOLUME 5 matches the old 2x amp within 0.1 dB to 10 kHz; it eases off above 12 kHz)
  k1L.s74_bqset(3, 0.2470 * srate, 11.58, 1.13, srate); k1R.s74_bqset(3, 0.2470 * srate, 11.58, 1.13, srate);
  k2L.s74_bqset(5, 0.1506 * srate, 3.98, 0.57, srate); k2R.s74_bqset(5, 0.1506 * srate, 3.98, 0.57, srate);
  f6_phb0 = 2 * fs2 / (2 * fs2 + 2 * $pi * 2000); f6_pha1 = (2 * $pi * 2000 - 2 * fs2) / (2 * fs2 + 2 * $pi * 2000);
  f6_bsa = 1 - exp(-1 / (0.002 * fs2));
  f6_smk = 1 - exp(-1 / (0.02 * srate));
  f6_tk = 1 - exp(-64 / (0.03 * srate));                 // the per-block glide (30 ms)
  f6_mk_ = 1 - exp(-64 / (0.02 * srate));                // the MODEL glide (2 x 20 ms)
  in_init(); in_setup(0, 0);
  ost_init(0);
  f6_lts = -1;
);

// ---------- settings ----------
f6_kin = 1 / 1.3;                                        // input (0 dBFS = about 1 V at the jack) to the first grid
function update() (
  f6_mt = slider1 >= 0.5;
  f6_mot = slider10 >= 0.5;
  f6_cbt = slider8 >= 0.5;
  in_setup(slider11, slider12);
  drift_macro(slider13);
  f6_outt = 10 ^ (slider14 / 20);
  ost_setup(slider15 / 100, slider16 / 100, slider17, slider18, slider19, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = F6_LAT;
);

// the model and the knobs glide (per block); everything they move is recomputed from the glided values
function f6_lerp(a, b) ( a + (b - a) * f6_mm; );
function f6_glerp(a, b) ( a * (b / a) ^ f6_mm; );
function f6_tone(force) local(k, ch, fs2, t, b) (
  fs2 = srate;
  k = force ? 1 : f6_tk;
  f6_mm1 += (f6_mt - f6_mm1) * (force ? 1 : f6_mk_);   // two glides in series: the change eases in and out
  f6_mm += (f6_mm1 - f6_mm) * (force ? 1 : f6_mk_);
  abs(f6_mt - f6_mm) < 0.0005 && abs(f6_mt - f6_mm1) < 0.0005 ? f6_mm = f6_mm1 = f6_mt;
  f6_s2 += (slider2 - f6_s2) * k; f6_s3 += (slider3 - f6_s3) * k; f6_s4 += (slider4 - f6_s4) * k;
  f6_s5 += (slider5 - f6_s5) * k; f6_s6 += (slider6 - f6_s6) * k; f6_s7 += (slider7 - f6_s7) * k;
  f6_s9 += (slider9 - f6_s9) * k;
  ch = f6_mm + 2 * f6_s2 + 3 * f6_s3 + 5 * f6_s4 + 7 * f6_s5 + 11 * f6_s6 + 13 * f6_s7 + 17 * f6_s9;
  force || abs(ch - f6_lts) > 0.00001 ? (
    f6_lts = ch;
    // the valves and the circuit around them
    f6_g1 = f6_lerp(30, 52);                             // first valve: a low-mu bottle / a 12AX7
    f6_pad = f6_lerp(0.5, 0.25);                          // the mixing network (GREYBEARD set for headroom)
    f6_g2 = 45;
    f6_kc = f6_lerp(22, 60);                             // the follower's grid-current knee
    f6_kpi = f6_lerp(0.06, 0.06);
    f6_pga = f6_lerp(6, 8); f6_pB = f6_lerp(0.22, 0.42);  // the power valves' gain and the feedback
    f6_pp = 0.9 * (f6_s7 / 10) ^ 1.2 * f6_lerp(1, 0.85); // PRESENCE: how much of the feedback's top is shunted
    f6_pBe = f6_pB * (1 - f6_pp * f6_phb0);
    f6_pc0 = f6_lerp(0.28, 0.2);                         // the power valves' bias (cold)
    f6_bsk = f6_lerp(0.25, 0.1); f6_bsr = 1 - exp(-1 / (f6_lerp(0.09, 0.04) * fs2));
    f6_sgk = f6_lerp(0.28, 0.08); f6_sge = f6_lerp(0.3, 0.55);
    f6_sga = 1 - exp(-1 / (f6_lerp(0.012, 0.006) * fs2)); f6_sgr = 1 - exp(-1 / (f6_lerp(0.22, 0.12) * fs2));
    f6_xc = 2 * $pi * f6_lerp(55, 32) / fs2; f6_xlk = 1 - 2 * $pi * 5 / fs2; f6_xk = f6_lerp(0.95, 0.5);
    f6_lr = f6_lerp(3.5, 1.2); f6_lh = f6_lerp(3, 1);    // the speaker load shows through less with more feedback
    cL.cs1.f6_shset(f6_lerp(0.8, 4.2), 1.9, fs2); cR.cs1.f6_shset(f6_lerp(0.8, 4.2), 1.9, fs2);
    cL.cs2.f6_shset(7.8, 1.9, fs2); cR.cs2.f6_shset(7.8, 1.9, fs2);
    // the BRIGHT channel's pot (and its cap), the tone stack: the part values glide between the two circuits
    f6_volset(f6_s2 / 10, 0.00000000025, fs2);
    f6_tsset(f6_s4 / 10, f6_s5 / 10, f6_s6 / 10, 0.00000000025, f6_glerp(0.00000002, 0.0000001), f6_glerp(0.00000002, 0.000000047),
             250000, f6_glerp(1000000, 250000), f6_glerp(25000, 10000), f6_glerp(56000, 100000), fs2);
    // BLEND: NORMAL (0) - both jumpered (0.5) - BRIGHT (1)
    b = f6_s3 / 100; f6_gb = min(2 * b, 1); f6_gn = min(2 * (1 - b), 1);
    // the speaker load and the cabinet
    ldL.f6_ldset(srate); ldR.f6_ldset(srate);
    t = f6_s9 / 10; cabL.f6_cabset(t - 0.015, 1, srate); cabR.f6_cabset(t + 0.015, 1.03, srate);
    f6_mkt = 10 ^ ((f6_mk(f6_mm, f6_s2) + f6_bmk(f6_mm, f6_s2, b)) / 20) * f6_kout;
  );
);
f6_kout = 0.125;

// the valves' operating points (DRIFT moves them); each side has its own wander
function f6_bias(w1, w2, w3, w4) instance(v1, v2, pin, pw) local(a) (
  a = dm_a * f6_lerp(1, 0.75);
  v1.f6_stset(-0.30 + 0.05 * a * w1); v2.f6_stset(-0.25 + 0.05 * a * w2);
  pin.f6_syset(0.04 + 0.03 * a * w3);
  pw.pd = 0.03 * a * w4;                                 // the power valves drift out of balance
  pw.pp0 = 0.5 * (f6_th(pw.pd - f6_pc0) + f6_th(pw.pd + f6_pc0));
  pw.sbase = 1 + f6_lerp(0.016, 0.008) * a * w3;          // the supply breathes
);

// ---------- presets (the input trim / guard and the output stage are left alone; OUTPUT evens out the loudness) ----------
function f6_set(md, vo, bl, tr, mi, ba, pr, cb, mc, df, ou) (
  slider1 = md; slider2 = vo; slider3 = bl; slider4 = tr; slider5 = mi; slider6 = ba; slider7 = pr;
  slider8 = cb; slider9 = mc; slider13 = df; slider14 = ou;
  slider_automate(511 + 4096 + 8192);                    // sliders 1-9, 13 and 14
);
function load_preset(p) (
  //               MODEL VOL  BLEND TRE MID  BAS  PRES CAB MIC DRIFT OUTPUT
  p == 1  ? f6_set(0,    5,   50,   6,  5,   5,   4,   1,  3,  50,   0.0) :  // Init
  p == 2  ? f6_set(0,    8,   50,   6,  7,   4.5, 5,   1,  3,  55,   -0.3) :  // Chicago Shuffle
  p == 3  ? f6_set(0,    6,   80,   7,  5,   4,   6,   1,  2,  50,   -0.9) :  // Rockabilly Snap
  p == 4  ? f6_set(0,    10,  20,   4,  8,   5,   3,   1,  5,  60,   0.3) :  // Harp Howl
  p == 5  ? f6_set(0,    7,   55,   6,  6,   5,   5,   1,  3,  50,    0.1) :  // Roots Rock Crunch
  p == 6  ? f6_set(0,    10,  50,   5,  6,   7,   4,   1,  4,  65,   1.5) :  // Desert Bloom
  p == 7  ? f6_set(0,    3.5, 30,   5,  5,   6,   3,   1,  6,  45,   3.5) :  // Upright Thump
  p == 8  ? f6_set(1,    4,   70,   7.5,3,   5,   5,   1,  2,  45,   -1.8) :  // Surf Glass
  p == 9  ? f6_set(1,    5,   80,   8,  3.5, 4,   6,   1,  2,  45,   -2.4) :  // Country Chicken Pick
  p == 10 ? f6_set(1,    4.5, 40,   5,  4,   6,   3,   1,  4,  45,   2.8) :  // Soul Clean
  p == 11 ? f6_set(1,    5,   20,   4,  5,   6.5, 2,   1,  7,  45,   5.8) :  // Sixties Session Bass
  p == 12 ? f6_set(1,    9,   50,   6,  5,   5,   6,   1,  3,  55,   0.1) :  // Garage Stomp
  p == 13 ? (                                            // Reset all to defaults
    f6_set(0, 5, 50, 6, 5, 5, 4, 1, 3, 50, 0); slider10 = 0;
    slider11 = 0; slider12 = 0; slider15 = 0; slider16 = 30; slider17 = 120; slider18 = 6000; slider19 = -0.3;
    slider_automate(524287);                             // sliders 1-19
  );
  pr_cur = p > 12 ? 1 : p;
);

// ---------- state ----------
function f6_start() (
  f6_srinit(); update(); f6_tone(1);
  cL.f6_bias(0, 0, 0, 0); cR.f6_bias(0, 0, 0, 0);
  f6_mn = f6_mot; f6_cb = f6_cbt; f6_o = f6_outt * f6_mkt;
);
f6_dn = 0.000000000000000001;
f6_start();
ostL.ost_ch_init(); ostR.ost_ch_init();
dw1.drift_init(0.8 + rand(0.5)); dw2.drift_init(0.8 + rand(0.5)); dw3.drift_init(0.8 + rand(0.5)); dw4.drift_init(0.8 + rand(0.5));
dw5.drift_init(0.8 + rand(0.5)); dw6.drift_init(0.8 + rand(0.5)); dw7.drift_init(0.8 + rand(0.5)); dw8.drift_init(0.8 + rand(0.5));
f6_pkL = f6_pkR = 0;

ui_thm = 5; ui_hw = 1;                                   // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                   // new instances open in Large, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
srate != f6_sr ? f6_start();
update();
f6_tone(0);
clp_kt_on = 1;                                           // the follower's knee tracks VOLUME (a valve stage: character)
cL.f6_cblk(samplesblock); cR.f6_cblk(samplesblock);
// DRIFT: valve bias, supply and power-valve balance per side
f6_di = 0.2 * dm_s * samplesblock / srate;
cL.f6_bias(dw1.drift_tick(f6_di), dw2.drift_tick(f6_di), dw3.drift_tick(f6_di), dw4.drift_tick(f6_di));
cR.f6_bias(dw5.drift_tick(f6_di), dw6.drift_tick(f6_di), dw7.drift_tick(f6_di), dw8.drift_tick(f6_di));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
f6_xl = in_l; f6_xr = in_r;
// MONO IN (glides, no clicks)
f6_mn += (f6_mot - f6_mn) * f6_smk;
f6_xm = 0.5 * (f6_xl + f6_xr); f6_xl += (f6_xm - f6_xl) * f6_mn; f6_xr += (f6_xm - f6_xr) * f6_mn;
f6_dn = -f6_dn;

// the amps (anti-aliased stages, the fixed shelf that makes up their top-end droop)
f6_yl = k2L.s74_bq(k1L.s74_bq(cL.f6_core(f6_xl))); f6_yr = k2R.s74_bq(k1R.s74_bq(cR.f6_core(f6_xr)));

// the speaker load, the cabinet (CAB glides in and out), the output section
f6_yl = ldL.f6_ldrun(f6_yl); f6_yr = ldR.f6_ldrun(f6_yr);
f6_cb += (f6_cbt - f6_cb) * f6_smk;
f6_cl = cabL.f6_cabrun(f6_yl); f6_cr = cabR.f6_cabrun(f6_yr);
f6_yl += (f6_cl - f6_yl) * f6_cb; f6_yr += (f6_cr - f6_yr) * f6_cb;
f6_o += (f6_outt * f6_mkt - f6_o) * f6_smk;
f6_yl = ostL.ost_band(f6_yl * f6_o); f6_yr = ostR.ost_band(f6_yr * f6_o);
ost_out(f6_yl, f6_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
f6_pkL = max(f6_pkL, abs(spl0)); f6_pkR = max(f6_pkR, abs(spl1));

@gfx 1040 392
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1040, 392);
s74_pal(0);

// =====================================================================
// A matte olive-drab chassis in a dark-steel case: field telemetry. Hazard-orange rules group the sections; heavy
// cast-metal pointer knobs; every switch a backlit square lens.
// =====================================================================
F6_INK = 0x2A2C2E; F6_DIM = 0x55585C; F6_HAZ = 0x3FA7A0; F6_CHAR = 0x1E201C;
F6_EN = 0xEDE4CC; F6_CHR = 0xB9C0C5; F6_BADGE = 0x3FA7A0; F6_HINK = 0xEDE4CC; F6_HDIM = 0xA9C9C5;
S74_LAMP = 0x52C8BF; S74_LTXT = 0x0E2A28; F6_KB = 0x2E3133; F6_KE = 0x141516;
// GREYBEARD: the whole panel turns dark charcoal grey (not black), light print, the turquoise kept; TWEED as above
slider1 >= 0.5 ? (
  F6_EN = 0x3D4044; F6_INK = 0xE8E4D8; F6_DIM = 0xA6AAAE; F6_HAZ = 0x52C2BA; F6_CHR = 0x8C9398;
  F6_KB = 0x1D1F21; F6_KE = 0x0B0C0D;
);
sc != gx_fsc ? (
  gx_fsc = sc;
  gx_f1 = ui_fitfont(11, 15 * sc);                       // knob captions
  gx_f2 = ui_fitfont(12, 14 * sc);                       // section titles
  gx_f3 = ui_fitfont(13, 12 * sc);                       // small print, lens captions, values
);
gfx_setfont(11, "Arial", gx_f1, 'b'); gfx_setfont(12, "Arial", gx_f2, 'b'); gfx_setfont(13, "Arial", gx_f3, 'b');
gfx_setfont(14, "Arial", 30 * sc, 'b'); gfx_setfont(15, "Arial", 15 * sc, 'b');
s74_lamp = 1;                                           // the house lamp keys on the panel (gfx-s74 / gfx-ui)
sc != gx_lsc ? ( gx_lsc = sc; gfx_setfont(16, "Arial", 12 * sc, 'b'); gfx_setfont(10, "Arial", 11 * sc, 'b'); );
lk_font = 16; lk_font2 = 10;                            // lamp-key legends: caps 26 px tall or more / smaller caps

function gx_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function gx_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function gx_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );

// a section: its title in cream capitals over a thin hazard-orange rule
function gx_sect(x1, x2, y, s) (
  gfx_setfont(12); ui_col(F6_INK); gx_tl(x1, y, s);
  ui_col(F6_HAZ); gx_r(x1, y + 12, x2 - x1, 1.3);
);

// the monolithic cast-metal pointer knob: one solid gunmetal casting, a pointer nose cast into its rim, a bold
// cream index along the pointer; printed ticks round it. Drag, SHIFT fine, double-click / Ctrl-click = default,
// wheel. The value shows (in place of the caption) only while touched.
function gx_knob(cx, cy, r, idx, lo, hi, def, label, fmt) local(v, n, dx, dy, hov, did, i, t, l, a, ca, sa, px, py, qx, qy, KX, KY, KR) (
  did = 5000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - gx_lt < 0.35 && gx_lid == idx && !gx_mv) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; gx_lt = 0; ) : (
      drag_id = did; gx_ky = mouse_y; gx_ky0 = mouse_y; gx_mv = 0; gx_lt = time_precise(); gx_lid = idx; gx_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !gx_mv && abs(mouse_y - gx_ky0) > 3 * sc ? ( gx_mv = 1; gx_ky = mouse_y; );
  drag_id == did && gx_mv ? (
    gx_kn = min(max(gx_kn + (gx_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); gx_ky = mouse_y;
    v = floor((lo + gx_kn * (hi - lo)) * 10 + 0.5) / 10;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max((v - lo) / (hi - lo) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    slider(idx) = floor((lo + n * (hi - lo)) * 10 + 0.5) / 10; ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  // the printed scale
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 8 : 5;
    ui_cola(F6_INK, 0.85); s74_ln(cx + sin(t) * (r + 7), cy - cos(t) * (r + 7), cx + sin(t) * (r + 7 + l), cy - cos(t) * (r + 7 + l), i == 0 || i == 5 || i == 10 ? 1.8 : 1.2);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  KX = cx * sc; KY = cy * sc; KR = r * sc;
  // the casting: shadow, body, the pointer nose (one piece), a thin dark parting line round the rim
  // the nose: a blunt trapezoid cast into the rim (tip half-width t, root half-width l)
  px = KX + ca * KR * 1.22; py = KY + sa * KR * 1.22; qx = KX + ca * KR * 0.5; qy = KY + sa * KR * 0.5;
  t = 0.13 * KR; l = 0.55 * KR;
  ui_cola(0x000000, 0.5); gfx_circle(KX + 1.6 * sc, KY + 3 * sc, KR, 1, 1);
  ui_ssquad(px - sa * t + 1.6 * sc, py + ca * t + 3 * sc, px + sa * t + 1.6 * sc, py - ca * t + 3 * sc, qx + sa * l + 1.6 * sc, qy - ca * l + 3 * sc, qx - sa * l + 1.6 * sc, qy + ca * l + 3 * sc);
  ui_col(F6_KE); gfx_circle(KX, KY, KR + 0.8 * sc, 1, 1);
  ui_ssquad(px - sa * (t + 0.8 * sc) + ca * 0.8 * sc, py + ca * (t + 0.8 * sc) + sa * 0.8 * sc, px + sa * (t + 0.8 * sc) + ca * 0.8 * sc, py - ca * (t + 0.8 * sc) + sa * 0.8 * sc, qx + sa * l, qy - ca * l, qx - sa * l, qy + ca * l);
  ui_col(F6_KB); gfx_circle(KX, KY, KR, 1, 1);
  ui_ssquad(px - sa * t, py + ca * t, px + sa * t, py - ca * t, qx + sa * l, qy - ca * l, qx - sa * l, qy + ca * l);
  ui_cola(0xFFFFFF, 0.13); gfx_arc(KX, KY, KR - 1 * sc, -0.62 * $pi, 0.02 * $pi, 1);
  // the index: a bold cream bar from near the centre out along the pointer
  ui_col(S74_IDX); s74_ln(cx + ca * r * 0.2, cy + sa * r * 0.2, cx + ca * r * 1.12, cy + sa * r * 1.12, max(2.6, r * 0.12));
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.06); gfx_circle(KX, KY, KR, 1, 1); );
  (hov || drag_id == did) ? (
    strlen(fmt) ? sprintf(#gx_vv, fmt, v) : strcpy(#gx_vv, #gx_vs);
    gfx_setfont(13); gfx_measurestr(#gx_vv, t, l);
    ui_col(F6_CHAR); gfx_rect(cx * sc - t * 0.5 - 6 * sc, (cy + r + 10) * sc, t + 12 * sc, l + 4 * sc);
    ui_col(S74_LAMP); gfx_x = floor(cx * sc - t * 0.5 + 0.5); gfx_y = (cy + r + 12) * sc; gfx_drawstr(#gx_vv);
  ) : (
    gfx_setfont(11); ui_col(gx_off ? F6_DIM : F6_INK); gx_tc(cx, cy + r + 22, label);
  );
);
// a backlit square lens (the house switch); returns 1 on a click
function gx_lens(x, y, w, h, on, s) ( s74_lens(x, y, w, h, on, s); );

// ---------- the case and the chassis ----------
s74_face(1040, 392);
ui_cola(0x000000, 0.5); gx_r(11, 57, 1020, 326);
ui_col(F6_EN); gx_r(12, 58, 1016, 322);
ui_cola(0xFFFFFF, 0.35); gx_r(12, 58, 1016, 1); gx_r(12, 58, 1, 322);
ui_cola(0x000000, 0.30); gx_r(12, 379, 1016, 1); gx_r(1027, 58, 1, 322);
// the chrome-silver trim: an inset frame and the rule between the rows
ui_col(F6_CHR); gx_r(17, 63, 1006, 2); gx_r(17, 373, 1006, 2); gx_r(17, 63, 2, 312); gx_r(1021, 63, 2, 312);
ui_cola(0xFFFFFF, 0.8); gx_r(17, 63, 1006, 0.7); gx_r(17, 373, 1006, 0.7);
s74_hex(24, 70, 4.6); s74_hex(1016, 70, 4.6); s74_hex(24, 368, 4.6); s74_hex(1016, 368, 4.6);
ui_col(F6_CHR); gx_r(30, 221, 980, 2.2); ui_cola(0xFFFFFF, 0.8); gx_r(30, 221, 980, 0.8);

// ---------- the header: the plate, the name, the type lines, the presets, the model lenses, the size ----------
ui_col(F6_BADGE); gx_r(16, 12, 34, 32);
gfx_setfont(15); ui_col(0x16181A); gx_tc(33, 28, "GFX");
gfx_setfont(14); ui_col(F6_HINK); gfx_x = 60 * sc; gfx_y = 9 * sc; gfx_drawstr("5F6");
// the type lines sit after the name and the preset bar after the longer of them (measured: nothing overlaps)
gfx_measurestr("5F6", f6g_w, f6g_h); f6g_x = 60 + f6g_w / sc + 14;
gfx_setfont(13); ui_col(F6_HDIM); gx_tl(f6g_x, 20, "TWEED BASS AMP"); ver_tag_at("v2", 9, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1); gx_tl(f6g_x, 36, "4 x 10  ·  ALL VALVE");
gfx_measurestr("TWEED BASS AMP", f6g_w, f6g_h); f6g_e = f6g_w; gfx_measurestr("4 x 10  ·  ALL VALVE", f6g_w, f6g_h);
f6g_x += max(f6g_e, f6g_w) / sc + 18; f6g_x = max(f6g_x, 262);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(f6g_x * sc, 10 * sc, (690 - f6g_x) * sc, 34 * sc, pr_cur,
  "Init|Chicago Shuffle|Rockabilly Snap|Harp Howl|Roots Rock Crunch|Desert Bloom|Upright Thump|Surf Glass|Country Chicken Pick|Soul Clean|Sixties Session Bass|Garage Stomp");
k_ > 0 ? prs_dirty = k_;
lk_well = 0x141518;                                     // the header keys sit on the dark steel
s74_lk = LK_YEL; gx_lens(708, 13, 74, 28, slider1 < 0.5, "TWEED") ? s74_set(1, 0);
s74_lk = LK_YEL; gx_lens(788, 13, 112, 28, slider1 >= 0.5, "GREYBEARD") ? s74_set(1, 1);
lk_well = slider1 >= 0.5 ? 0x141518 : 0x2A2722;         // the panel keys: TWEED's cream chassis is a light face
ui_size_picker(962 * sc, 18 * sc);

// ---------- PREAMP: VOLUME, BLEND ----------
gx_sect(36, 404, 74, "PREAMP");
gx_knob(120, 146, 34, 2, 0, 10, 5, "VOLUME", "%.1f");
sprintf(#gx_vs, slider3 < 49.5 ? "NORMAL %.0f%%" : slider3 > 50.5 ? "BRIGHT %.0f%%" : "JUMPERED", slider3 < 50 ? 100 - 2 * slider3 : 2 * slider3 - 100);
gx_knob(306, 146, 30, 3, 0, 100, 50, "BLEND", "");
gfx_setfont(13); ui_col(F6_DIM); gx_tc(230, 192, "NORMAL"); gx_tc(382, 192, "BRIGHT"); gx_tc(306, 96, "JUMPERED");

// ---------- TONE: TREBLE, MIDDLE, BASS, PRESENCE ----------
gx_sect(436, 1004, 74, "TONE");
gx_knob(500, 146, 30, 4, 0, 10, 6, "TREBLE", "%.1f");
gx_knob(652, 146, 30, 5, 0, 10, 5, "MIDDLE", "%.1f");
gx_knob(804, 146, 30, 6, 0, 10, 5, "BASS", "%.1f");
gx_knob(946, 146, 30, 7, 0, 10, 4, "PRESENCE", "%.1f");
ui_cola(F6_HAZ, 0.6); gx_r(886, 92, 1, 104);

// ---------- INPUT: TRIM (click = GUARD), MONO IN ----------
gx_sect(36, 290, 236, "INPUT");
gx_knob(96, 306, 24, 11, -24, 12, 0, "TRIM", "%+.1f dB");
ui_guardclick(5000 + 11, 12, 96, 306, 39);
gfx_setfont(13); ui_col(F6_DIM); gx_tc(214, 276, "SOURCE");
s74_lk = LK_RED; gx_lens(168, 290, 92, 30, slider10 >= 0.5, "MONO IN") ? s74_set(10, slider10 >= 0.5 ? 0 : 1);

// ---------- CABINET: CAB, MIC ----------
gx_sect(320, 640, 236, "CABINET  ·  4 x 10 OPEN");
gfx_setfont(13); ui_col(F6_DIM); gx_tc(398, 276, slider8 >= 0.5 ? "SPEAKERS" : "LINE OUT");
s74_lk = LK_AMB; gx_lens(352, 290, 92, 30, slider8 >= 0.5, "CAB") ? s74_set(8, slider8 >= 0.5 ? 0 : 1);
gx_off = slider8 < 0.5;
gx_knob(552, 306, 24, 9, 0, 10, 3, "MIC", "%.1f");
gx_off = 0;
gfx_setfont(13); ui_col(F6_DIM); gx_tc(482, 344, "ON AXIS"); gx_tc(620, 344, "OFF AXIS");
// the cabinet switched off (line out): greyed a little, its CAB key redrawn clear on top
slider8 < 0.5 ? (
  ui_cola(F6_EN, 0.5); gx_r(314, 252, 332, 118);
  s74_lk = LK_AMB; gx_lens(352, 290, 92, 30, slider8 >= 0.5, "CAB") ? s74_set(8, slider8 >= 0.5 ? 0 : 1);
);

// ---------- OUTPUT: DRIFT, SAT, OUTPUT, the meters ----------
gx_sect(670, 1004, 236, "OUTPUT");
gx_knob(712, 306, 20, 13, 0, 100, 50, "DRIFT", "%.0f%%");
gx_knob(792, 306, 20, 15, 0, 100, 0, "SAT", "%.0f%%");
gx_knob(872, 306, 24, 14, -24, 12, 0, "OUTPUT", "%+.1f dB");
ui_hw = 1;
!f6_mi ? ( mtL.hold = mtR.hold = -100; f6_mi = 1; );   // seed the ledm peak-hold below the scale (an instance var starts at 0 dB = the red LED)
mtL.ui_ledm(926 * sc, 286 * sc, 76 * sc, 8 * sc, f6_pkL); mtR.ui_ledm(926 * sc, 300 * sc, 76 * sc, 8 * sc, f6_pkR);
f6_pkL = 0; f6_pkR = 0;
gfx_setfont(13); ui_col(F6_DIM); gx_tc(964, 328, "L / R");

pk_end();
ui_end();
