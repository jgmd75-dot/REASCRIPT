desc:Cherwell Lift (v2) [loudness] (GFX)
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Cherwell series — clinical mid-90s digital console processing.
// Lift: loudness / density enhancer in the spirit of the classic
// "inflate" processor. Raises low and mid-level detail (apparent loudness)
// while 0 dBFS peaks map back to 0 dBFS, so it adds weight without
// squashing transients. Brand / product names live in comments only.
//
// Shaper: odd-symmetric polynomial on |x| <= 1, f(1) = 1, small-signal
// gain from 1.0x (CURVE -50) to 2.0x (CURVE +50). EFFECT blends dry/shaped.
// CLIP 0 dB holds the shaper at 1 above full scale; with CLIP off, signal
// above 0 dBFS folds back (as on the original).
// BAND SPLIT: three Linkwitz-Riley bands (240 Hz / 2.4 kHz), each shaped
// on its own, so loud lows don't modulate the highs.
// OS (1x / 2x / 4x): the shaper (and the EFFECT blend, so dry and shaped
// stay in time) runs oversampled; 1x is the plain curve at the base rate,
// as on the original. Full bandwidth at every setting (v0.1's ADAA averaged
// neighbouring samples and rolled the top off: -2 dB at 10 kHz, -12 dB at
// 20 kHz, even with EFFECT at 0).
// Latency: 0 samples at 1x, 31 at 2x, 37 at 4x (reported). No DRIFT
// (clinical digital unit).
//
// Requires gfx-os (.jsfx-inc) in the same folder.
//
// STATUS: Stable (graduated from the Lab on 24 Oct 2026 as Lab v0.2).

import gfx-os.jsfx-inc

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:in_db=0<-6,12,0.1>-Input (dB)
slider2:effect=0<0,100,0.1>-Effect (%)
slider3:curve=0<-50,50,0.1>-Curve
slider4:clip=1<0,1,1{Off,On}>-Clip 0 dB
slider5:split=0<0,1,1{Off,On}>-Band Split
slider6:out_db=0<-12,3,0.1>-Output (dB)
slider7:lift_on=1<0,1,1{Off,On}>-In
slider8:0<0,2,1{1x,2x,4x}>-Oversampling
slider9:prs_sel=0<0,11,1{No preset,Init,Gentle Lift,Transparent Polish,Mix Bus Sheen,Vocal Forward,Drum Density,Bass Thickener,Soft Warmth,Edge and Bite,Master: Loud,Master: Hot Clip}>-Preset

@init
ext_noinit = 1;
pr_cur = 1;              // preset shown on the LCD (saved with the project)
gfx_ext_retina = 1;
BQ = 0.7071067811865476;   // Butterworth Q (two in series = Linkwitz-Riley 4th order)
first_run = 1;
os_design();
os_base = 0;  os_tf = os_f = os_f2n(slider8);  os_gsetup();
DRY = 1000;  dl_n = 0;     // 64-frame ring: the dry signal for the IN fade, delayed by the OS latency

// =====================================================================
// DSP building blocks
// =====================================================================
function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );

// Simper/Cytomic TPT state-variable filter
function svf_set(fc, q) instance(g, k, a1, a2, a3) (
  g  = tan($pi * min(fc, srate * 0.45) / srate);
  k  = 1 / q;
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf_tick(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3  = x - ic2;
  v1  = a1 * ic1 + a2 * v3;
  v2  = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;
  ic2 = 2 * v2 - ic2;
  lp = v2;  bp = v1;  hp = x - k * v1 - v2;
);

// ---------- the Lift shaper ----------
// On s = |x| <= 1:  p(s) = A s + B s^2 + C s^3 - D (s^2 - 2 s^3 + s^4)
// with A..D from CURVE so that p(0) = 0 and p(1) = 1.
function lift_poly(s) ( s * (iA + s * (iB + s * iC)) - iD * s * s * (1 - 2 * s + s * s); );
function lift_f(x) local(s, y) (
  s = abs(x);
  s <= 1 ? ( y = lift_poly(s); ) :
  clip   ? ( y = 1; ) :
  s < 2  ? ( y = 2 * s - s * s; ) :
           ( y = 0; );
  x < 0 ? -y : y;
);
// One sample through the curve, blended with the dry by EFFECT (at the OS rate)
function lift_b(x) ( x + eff_s * (lift_f(x) - x); );

// ---------- one channel ----------
function xo_set() instance(l1, l2, h1, h2, m1, m2, n1, n2, a1, a2, a3, a4) (
  l1.svf_set(240, BQ);   l2.svf_set(240, BQ);
  h1.svf_set(240, BQ);   h2.svf_set(240, BQ);
  m1.svf_set(2400, BQ);  m2.svf_set(2400, BQ);
  n1.svf_set(2400, BQ);  n2.svf_set(2400, BQ);
  a1.svf_set(2400, BQ);  a2.svf_set(2400, BQ);
  a3.svf_set(2400, BQ);  a4.svf_set(2400, BQ);
);
// The bands are split at the base rate, raised to the OS rate one by one, shaped, summed and brought
// back down once (the down filter is linear, so one does for the sum). BAND SPLIT crossfades (sp_s, 15 ms)
// between the full-band and the split paths; only the path(s) in use run, and a path is cleared as its fade
// starts (it comes in from silence, never from stale state).
function chan(x) instance(uf, ul, um, uh, dn, l1, l2, h1, h2, m1, m2, n1, n2, a1, a2, a3, a4, o0, o1, o2, o3)
  local(lo, hi, mid, top, loap, i, y)
(
  sp_s > 0 || split ? (
    // LR4 split at 240 Hz, then the upper part again at 2.4 kHz
    l1.svf_tick(x);   l2.svf_tick(l1.lp);  lo  = l2.lp;
    h1.svf_tick(x);   h2.svf_tick(h1.hp);  hi  = h2.hp;
    m1.svf_tick(hi);  m2.svf_tick(m1.lp);  mid = m2.lp;
    n1.svf_tick(hi);  n2.svf_tick(n1.hp);  top = n2.hp;
    // matching 2.4 kHz allpass on the low band keeps the bands in phase
    a1.svf_tick(lo);  a2.svf_tick(a1.lp);
    a3.svf_tick(lo);  a4.svf_tick(a3.hp);  loap = a2.lp + a4.hp;
    ul.os_up(loap);  um.os_up(mid);  uh.os_up(top);
  );
  sp_s < 1 || !split ? uf.os_up(x);
  i = 0;
  loop(os_f,
    y = sp_s < 1 ? (1 - sp_s) * lift_b(uf.os_s(i)) : 0;
    sp_s > 0 ? y += sp_s * (lift_b(ul.os_s(i)) + lift_b(um.os_s(i)) + lift_b(uh.os_s(i)));
    i == 0 ? o0 = y : i == 1 ? o1 = y : i == 2 ? o2 = y : o3 = y;
    i += 1;
  );
  dn.os_dn(o0, o1, o2, o3);
);
function svf_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function band_clr() instance(ul, um, uh, l1, l2, h1, h2, m1, m2, n1, n2, a1, a2, a3, a4) (
  ul.os_clr();  um.os_clr();  uh.os_clr();
  l1.svf_clr();  l2.svf_clr();  h1.svf_clr();  h2.svf_clr();  m1.svf_clr();  m2.svf_clr();
  n1.svf_clr();  n2.svf_clr();  a1.svf_clr();  a2.svf_clr();  a3.svf_clr();  a4.svf_clr();
);
function full_clr() instance(uf) ( uf.os_clr(); );
function ch_clr() instance(uf, ul, um, uh, dn) ( uf.os_clr();  ul.os_clr();  um.os_clr();  uh.os_clr();  dn.os_clr(); );

// shaper coefficients from a (smoothed) curve value -0.5 .. +0.5
function set_curve(cp) (
  iA = 1.5 + cp;
  iB = -2 * cp;
  iC = cp - 0.5;
  iD = 0.0625 - 0.25 * cp + 0.25 * cp * cp;
);

function update_params() (
  cp_t = curve / 100;

  in_t  = db2g(in_db);
  out_t = db2g(out_db);
  eff_t = effect / 100;
  sm    = 1 - exp(-1 / (0.02 * srate));        // 20 ms parameter smoothing
  ramp_step = 1 / (0.010 * srate);
  sp_step = 1 / (0.015 * srate);

  chL.xo_set();  chR.xo_set();
  os_tf = os_f2n(slider8);

  first_run ? (
    in_s = in_t;  out_s = out_t;  eff_s = eff_t;  on_s = lift_on;  sp_s = split;  cp_s = cp_t;  set_curve(cp_s);
    first_run = 0;
  );
);

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function load_preset(p) (
  p == 1 ? ( slider(1) = 0;  slider(2) = 0;  slider(3) = 0;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Init
  p == 2 ? ( slider(1) = 0;  slider(2) = 30;  slider(3) = 0;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Gentle Lift
  p == 3 ? ( slider(1) = 0;  slider(2) = 15;  slider(3) = -20;  slider(4) = 1;  slider(5) = 1;  slider(6) = 0;  slider(7) = 1; ) :   // Transparent Polish
  p == 4 ? ( slider(1) = 0;  slider(2) = 25;  slider(3) = -10;  slider(4) = 1;  slider(5) = 1;  slider(6) = 0;  slider(7) = 1; ) :   // Mix Bus Sheen
  p == 5 ? ( slider(1) = 0;  slider(2) = 45;  slider(3) = 10;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Vocal Forward
  p == 6 ? ( slider(1) = 3;  slider(2) = 80;  slider(3) = 20;  slider(4) = 1;  slider(5) = 1;  slider(6) = 0;  slider(7) = 1; ) :   // Drum Density
  p == 7 ? ( slider(1) = 0;  slider(2) = 60;  slider(3) = -30;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Bass Thickener
  p == 8 ? ( slider(1) = 0;  slider(2) = 50;  slider(3) = -50;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Soft Warmth
  p == 9 ? ( slider(1) = 0;  slider(2) = 55;  slider(3) = 50;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Edge and Bite
  p == 10 ? ( slider(1) = 3;  slider(2) = 70;  slider(3) = 0;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Master: Loud
  p == 11 ? ( slider(1) = 6;  slider(2) = 100;  slider(3) = 0;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) :   // Master: Hot Clip
  p == 12 ? ( slider(1) = 0;  slider(2) = 0;  slider(3) = 0;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 1; ) : 0;   // Reset all to defaults
  slider_automate(p == 12 ? 127 : 127);
  gui_dirty = 1;
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
// GUI edits arrive as a flag; parameters are only ever rebuilt on the audio thread
prm_dirty ? ( prm_dirty = 0;  update_params(); );
inpk_disp  = max(inpk_disp, inpk);    inpk = 0;
outpk_disp = max(outpk_disp, outpk);  outpk = 0;

@sample
in_s  += (in_t  - in_s)  * sm;
out_s += (out_t - out_s) * sm;
eff_s += (eff_t - eff_s) * sm;
cp_s != cp_t ? ( cp_s += (cp_t - cp_s) * sm;  abs(cp_t - cp_s) < 0.00001 ? cp_s = cp_t;  set_curve(cp_s); );   // CURVE glides
os_gate();
split  && sp_s == 0 ? ( chL.band_clr();  chR.band_clr(); );
!split && sp_s == 1 ? ( chL.full_clr();  chR.full_clr(); );
sp_s != split ? ( sp_s = split > sp_s ? min(1, sp_s + sp_step) : max(0, sp_s - sp_step); );   // BAND SPLIT crossfade
os_chg ? ( chL.ch_clr();  chR.ch_clr();  memset(DRY, 0, 128); );
on_s != lift_on ? ( on_s = lift_on > on_s ? min(1, on_s + ramp_step) : max(0, on_s - ramp_step); );

xL = spl0 * in_s;  xR = spl1 * in_s;
inpk = max(inpk, max(abs(xL), abs(xR)));

// the dry, delayed by the OS latency, for the IN fade (the shaped path always runs, so IN never waits for a refill)
DRY[dl_n * 2] = spl0;  DRY[dl_n * 2 + 1] = spl1;
dl_r = (dl_n - os_lat(os_f) + 64) % 64;  dryL = DRY[dl_r * 2];  dryR = DRY[dl_r * 2 + 1];  dl_n = (dl_n + 1) % 64;
yL = chL.chan(xL) * out_s;
yR = chR.chan(xR) * out_s;
on_s < 1 ? ( yL = dryL + (yL - dryL) * on_s;  yR = dryR + (yR - dryR) * on_s; );
yL *= os_g;  yR *= os_g;

outpk = max(outpk, max(abs(yL), abs(yR)));
spl0 = yL;  spl1 = yR;

@serialize
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@gfx 1000 320
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
// GUI copy of lift_f (the threads must not share a function: its locals are shared storage)
function g_lift(x) local(s, y) (
  s = abs(x);
  s <= 1 ? ( y = s * (gA + s * (gB + s * gC)) - gD * s * s * (1 - 2 * s + s * s); ) :
  clip   ? ( y = 1; ) :
  s < 2  ? ( y = 2 * s - s * s; ) :
           ( y = 0; );
  x < 0 ? -y : y;
);
function gdb(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );   // GUI copy of g2db (audio and GUI threads must not share functions)
// =====================================================================
// GUI — Cherwell series, "Quad" scheme: viridian faceplate, sage-green accents,
// knurled knobs with lime caps, dark transfer-curve display, lamp keys.
// =====================================================================
function col(h, a) (
  gfx_r = floor(h / 65536) / 255;
  gfx_g = (floor(h / 256) % 256) / 255;
  gfx_b = (h % 256) / 255;
  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));
  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));
  r * 65536 + g * 256 + b;
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);
  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;
  gfx_drawstr(str);
);
function param_touched(idx) ( slider_automate(2 ^ (idx - 1)); gui_dirty = 1; );

function rivet(x, y) (
  col(0x8A9098, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xF2F4F6, 0.6); gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);

// Knob pointer as one filled bar (constant width at any angle)
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;
  bx = x + sa * r1;  by = y - ca * r1;
  dx = ca * hw;      dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);
  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);

// House white knob: flat satin cap, one soft edge highlight, dark pointer,
// thin smooth track and smooth value arc (bipolar ranges arc from zero).
// fmt: 0 dB, 1 %, 2 plain number. nl = numeric scale labels.
function knob(cx, cy, r, idx, vmin, vmax, def, lbl, fmt, nl)
  local(x, y, rr, v, t, hov, dx, dy, now, a0, a1, ta, tv, b, j, w, h, ty, lr, fr)
(
  x = px(cx);  y = py(cy);  rr = ps(r);
  dx = mouse_x - x;  dy = mouse_y - y;
  hov = dx * dx + dy * dy <= sqr(rr * 1.2);
  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : (
      drag_idx = idx;  drag_y = mouse_y;  drag_v = slider(idx);
    );
    last_click_idx = idx;  last_click_t = now;
  );
  drag_idx == idx ? (
    v = drag_v + (drag_y - mouse_y) * (vmax - vmin) / ps(240);
    v = floor(max(vmin, min(vmax, v)) * 10 + 0.5) / 10;
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );

  v = slider(idx);
  t = (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;
  b  = (vmin < 0 && vmax > 0) ? -vmin / (vmax - vmin) : 0;
  ta = a0 + b * (a1 - a0);
  tv = a0 + t * (a1 - a0);

  // scale labels
  gfx_setfont(5);  col(0xE4F0EF, 1);
  lr = rr + ps(22);  j = 0;
  loop(nl,
    fr = nl > 1 ? j / (nl - 1) : 0.5;
    b = a0 + fr * (a1 - a0);
    sprintf(#sl, "%d", floor(vmin + fr * (vmax - vmin) + 0.5));
    text_c(x + sin(b) * lr, y - cos(b) * lr, #sl);
    j += 1;
  );
  // scale ticks
  col(0xE4F0EF, 0.75);  j = 0;
  loop(11,
    b = a0 + j / 10 * (a1 - a0);
    gfx_circle((x + sin(b) * (rr + ps(4) + rr + ps(9)) * 0.5), (y - cos(b) * (rr + ps(4) + rr + ps(9)) * 0.5), max(((rr + ps(9)) - (rr + ps(4))) * 0.25, 1), 1, 1);
    j += 1;
  );
  // knob: dark knurled skirt with grey ribs, yellow centre cap, yellow pointer across the skirt
  col(0x000000, 0.3);   gfx_circle(x + ps(2), y + ps(3), rr, 1, 1);
  col(0x24272C, 1);     gfx_circle(x, y, rr, 1, 1);
  j = 0;
  loop(48,
    b = tv + j * $pi / 24;
    col(j % 2 ? 0x34383E : 0x4C5158, 1);
    gfx_line(x + sin(b) * rr * 0.62, y - cos(b) * rr * 0.62,
             x + sin(b) * rr * 0.95, y - cos(b) * rr * 0.95, 1);
    j += 1;
  );
  col(0x1A1C20, 1);     gfx_circle(x, y, rr, 0, 1);
  col(0x1A1C20, 1);     gfx_circle(x, y, rr * 0.6, 1, 1);
  col(0xA8B98A, 0.82);  gfx_circle(x, y, rr * 0.54, 1, 1);   // translucent: the dark skirt shows through
  col(0xEAF6C2, 0.55);  gfx_arc(x, y, rr * 0.46, -1.9, -0.3, 1);
  col(0x6E8A30, 0.8);   gfx_circle(x, y, rr * 0.54, 0, 1);
  // lime indicator with a soft glow
  b = ps(r > 34 ? 1.7 : 1.3);
  // the lit indicator: a glowing dot on the knurl (JG, 31 Oct 2026: dots, not lines)
  col(0xCDEB7A, 0.12);  gfx_circle(x + sin(tv) * rr * 0.78, y - cos(tv) * rr * 0.78, max(rr * 0.2, b * 2.6), 1, 1);
  col(0xCDEB7A, 0.25);  gfx_circle(x + sin(tv) * rr * 0.78, y - cos(tv) * rr * 0.78, max(rr * 0.15, b * 2), 1, 1);
  col(0xDDF59A, 1);     gfx_circle(x + sin(tv) * rr * 0.78, y - cos(tv) * rr * 0.78, max(rr * 0.1, b * 1.4), 1, 1);
  // label
  gfx_setfont(6);  col(0xE4F0EF, 1);
  text_c(x, y + rr + ps(30), lbl);
  // value on hover only (house rule)
  hov || drag_idx == idx ? (
    fmt == 0 ? sprintf(#kv, "%+.1f dB", v) :
    fmt == 1 ? sprintf(#kv, "%.1f%%", v) :
               sprintf(#kv, "%+.1f", v);
    gfx_setfont(3);  gfx_measurestr(#kv, w, h);
    ty = y - lr - ps(12) - h;
    col(0x0E3A40, 0.95);  gfx_rect(x - w * 0.5 - ps(6), ty - ps(3), w + ps(12), h + ps(6), 1);
    col(0xE4F0EF, 1);     text_c(x, ty + h * 0.5, #kv);
  );
);

// ---------- house lamp keys (34-series), ported from gfx-ui lk_key / lk_fit ----------
// Coloured lens in a dark well; off = darker milky lens with vignette and dark legend,
// lit = feathered glow and spill onto the panel. Adapted to this panel's px/py/ps layout.
LK_AMB = 0xF2A41E;  LK_SAGE = 0xA0AF84;  LK_RED = 0xD8332E;  lk_well = 0x141518;
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov;
  dn = hov && lmb ? 1 : 0;                                  // the cap sinks a pixel while held
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lk_fit(x, y, w, h, on, c, str) local(k) (
  k = min(w / 62, h / 48);
  lk_key(x + 4 * k, y + 4 * k, w - 8 * k, h - 8 * k, on, c, str);
);

// Vertical slider (output): dark knurled cap with the knobs' glowing lime line.
// Drag up/down; Ctrl-click or double-click = default; value tag on hover only.
function vslider(x, y0, h, idx, vmin, vmax, def, lbl) local(X, Y0, H, v, t, cy, hov, now, j, d, yy, w, th) (
  X = px(x);  Y0 = py(y0);  H = ps(h);
  v = slider(idx);  t = (v - vmin) / (vmax - vmin);  cy = Y0 + H * (1 - t);
  hov = abs(mouse_x - X) < ps(16) && abs(mouse_y - cy) < ps(15);
  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : (
      drag_idx = idx;  drag_y = mouse_y;  drag_v = v;
    );
    last_click_idx = idx;  last_click_t = now;
  );
  drag_idx == idx ? (
    v = drag_v + (drag_y - mouse_y) * (vmax - vmin) / H;
    v = floor(max(vmin, min(vmax, v)) * 10 + 0.5) / 10;
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = slider(idx);  t = (v - vmin) / (vmax - vmin);  cy = Y0 + H * (1 - t);

  // scale: a tick and number every 3 dB
  gfx_setfont(5);  j = 0;
  loop(floor((vmax - vmin) / 3 + 0.5) + 1,
    d = vmax - j * 3;
    yy = Y0 + H * (1 - (d - vmin) / (vmax - vmin));
    col(0xE4F0EF, 0.75);  gfx_line(X - ps(14), yy, X - ps(9), yy, 1);  gfx_line(X + ps(9), yy, X + ps(14), yy, 1);
    d > 0 ? sprintf(#sl, "+%d", d) : sprintf(#sl, "%d", d);  col(0xE4F0EF, 1);  text_c(X - ps(26), yy, #sl);
    j += 1;
  );
  // sunken slot
  col(0x08363C, 1);  gfx_rect(X - ps(4), Y0 - ps(4), ps(8), H + ps(8), 1);
  col(0x061E22, 1);  gfx_rect(X - ps(2), Y0 - ps(2), ps(4), H + ps(4), 1);
  col(0x4E959E, 1);  gfx_rect(X - ps(4), Y0 + H + ps(3), ps(8), ps(1), 1);
  // cap
  col(0x000000, 0.35);  gfx_rect(X - ps(13), cy - ps(12), ps(28), ps(27), 1);
  col(0x24272C, 1);     gfx_rect(X - ps(15), cy - ps(14), ps(30), ps(28), 1);
  col(0x4C5158, 1);     j = 0;
  loop(6, gfx_line(X - ps(12), cy - ps(11) + j * ps(4.4), X + ps(12), cy - ps(11) + j * ps(4.4), 1); j += 1; );
  col(0x5A5F67, 1);     gfx_rect(X - ps(15), cy - ps(14), ps(30), ps(1), 1);
  col(0xCDEB7A, 0.12);  gfx_rect(X - ps(15), cy - ps(3.5), ps(30), ps(7), 1);
  col(0xCDEB7A, 0.25);  gfx_rect(X - ps(15), cy - ps(2), ps(30), ps(4), 1);
  col(0xDDF59A, 1);     gfx_rect(X - ps(15), cy - ps(1), ps(30), ps(2), 1);
  // label
  gfx_setfont(6);  col(0xE4F0EF, 1);  text_c(X - ps(6), Y0 + H + ps(22), lbl);   // (y0 / h were overwritten: JSFX names ignore case)
  // value on hover only (house rule)
  hov || drag_idx == idx ? (
    sprintf(#kv, "%+.1f dB", v);
    gfx_setfont(3);  gfx_measurestr(#kv, w, th);
    col(0x0E3A40, 0.95);  gfx_rect(X - ps(22) - w - ps(12), cy - th * 0.5 - ps(3), w + ps(12), th + ps(6), 1);
    col(0xE4F0EF, 1);     text_c(X - ps(22) - w * 0.5 - ps(6), cy, #kv);
  );
);

// Vertical LED meter, -48..+3 dB in 1.5 dB segments
function vmeter(x, y0, h, db, lbl) local(n, sh, j, d, yy) (
  n = 34;  sh = h / n;
  col(0x11151B, 1);  gfx_rect(px(x - 3), py(y0 - 3), ps(22), ps(h + 6), 1);
  j = 0;
  loop(n,
    d = -48 + (j + 1) * 1.5;
    yy = y0 + h - (j + 1) * sh;
    d > 0 ? col(0xE0503A, db >= d - 1.5 ? 1 : 0.15) :
    d > -6 ? col(0xE8C060, db >= d - 1.5 ? 1 : 0.15) :
             col(0xA0AF84, db >= d - 1.5 ? 1 : 0.15);
    gfx_rect(px(x), py(yy) + 1, ps(16), ps(sh) - 1, 1);
    j += 1;
  );
  gfx_setfont(5);  col(0xE4F0EF, 1);  text_c(px(x + 8), py(y0 + h + 14), lbl);
);

// ---------- house preset bar (ported from gfx-panel pk_preset): [PRESETS][<][>][LCD] ----------
// PRESETS, or a click on the LCD, opens the list; the arrows step through it. menu = "Name 1|...|Name n".
// The list ends with "Reset all to defaults" (returns n + 1). Returns the preset to load, 0 for none.
// Keys are this unit's lamp keys (PB_KEY lens, PB_INK arrows); the LCD is the house amber one.
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, tw, th, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_fit(x, y, 100, h, 0, PB_KEY, "PRESETS") ? open = 1;
  lk_fit(x + 102, y, 46, h, 0, PB_KEY, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_fit(x + 150, y, 46, h, 0, PB_KEY, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(PB_INK, 1);  pb_tri(x + 125, y + h * 0.5 - 0.5, 5, -1);  pb_tri(x + 173, y + h * 0.5 - 0.5, 5, 1);
  // the LCD: black bezel, dark amber glass, the patch name only
  lx = x + 206;
  col(0x000000, 0.3);  gfx_rect(px(lx + 2), py(y + 5), ps(lw), ps(h - 6), 1);
  col(0x050505, 1);    gfx_rect(px(lx), py(y + 3), ps(lw), ps(h - 6), 1);
  gfx_gradrect(px(lx + 3), py(y + 6), ps(lw - 6), ps(h - 12), 0.17, 0.10, 0.02, 1, 0, 0, 0, 0, -0.06 / ps(h), -0.04 / ps(h), -0.01 / ps(h), 0);
  col(0xFFFFFF, 0.06); gfx_line(px(lx + 4), py(y + 7), px(lx + lw - 5), py(y + 7), 1);
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  gfx_setfont(8);  col(0xE8A33A, 1);  gfx_measurestr(#pb_nm, tw, th);
  gfx_x = px(lx + 10);  gfx_y = py(y + h * 0.5) - th * 0.5;  gfx_drawstr(#pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- presets (OUTPUT evens the loudness; GUI thread only) ----------
PRESET_MENU = "Init|Gentle Lift|Transparent Polish|Mix Bus Sheen|Vocal Forward|Drum Density|Bass Thickener|Soft Warmth|Edge and Bite|Master: Loud|Master: Hot Clip";
PB_KEY = 0xA0AF84;  PB_INK = 0x0E3A40;

// ---------- frame setup ----------
sc = min(gfx_w / 1000, gfx_h / 320);
ox = (gfx_w - 1000 * sc) * 0.5;
oy = (gfx_h - 320 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;

gfx_setfont(1, "Verdana", ps(26), 'b');
gfx_setfont(2, "Century Gothic", ps(13), 'b');
gfx_setfont(3, "Verdana", ps(12), 'b');
gfx_setfont(4, "Verdana", ps(15), 'b');
gfx_setfont(5, "Verdana", ps(11), 'b');
gfx_setfont(6, "Century Gothic", ps(15), 'b');
gfx_setfont(8, "Courier New", ps(16), 'b');

in_m  = max(inpk_disp,  in_m * 0.85);   inpk_disp = 0;
out_m = max(outpk_disp, out_m * 0.85);  outpk_disp = 0;

// ---------- faceplate (fills the window) ----------
col(0x15616D, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
j = 0;   // pinstripe, top bar only (from the top edge down to the green line)
loop(12,
  col(j % 3 == 0 ? 0xFFFFFF : 0x0E4A53, 0.10);
  gy = py(1 + j * 4);
  gfx_line(px(0), gy, px(1000), gy, 1);
  j += 1;
);
col(0x3F8590, 1);  gfx_rect(px(0), py(0), ps(1000), ps(1.5), 1);
col(0x426A5A, 1);  gfx_rect(px(0), py(46), ps(1000), ps(5), 1);          // Oxford-green line under the title
col(0x000000, 0.18); gfx_rect(px(0), py(314), ps(1000), ps(6), 1);       // darker bottom edge
rivet(12, 18);  rivet(988, 18);  rivet(12, 302);  rivet(988, 302);

gfx_setfont(1);  col(0xA0AF84, 1);  gfx_x = px(40);  gfx_y = py(9);   gfx_drawstr("CHERWELL");
gfx_setfont(4);  col(0xE4F0EF, 1);  gfx_x += ps(14);  gfx_y = py(16);  gfx_drawstr("LIFT");
gfx_setfont(4);  col(0xA0AF84, 1);  gfx_x = px(930); gfx_y = py(16);  gfx_drawstr("GFX"); ver_tag_at("v2", 16, px(930) - 1.4 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1);
os_key(ox / sc + 872, oy / sc + 12, 8, 0xE4F0EF, 7) ? gui_dirty = 1;   // OS 1x / 2x / 4x (font slot 7 is free)

// ---------- preset bar, in the title bar ----------
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(257, 8, 30, 280, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > 11 ? 1 : pb_k; );

// ---------- transfer-curve display ----------
dx0 = 40;  dy0 = 66;  dw = 230;  dh = 200;
// outer 90s sunken bevel: dark top + left, light bottom + right
col(0x0F525C, 1);  gfx_rect(px(dx0 - 10), py(dy0 - 10), ps(dw + 20), ps(dh + 20), 1);
col(0x08363C, 1);  gfx_rect(px(dx0 - 10), py(dy0 - 10), ps(dw + 20), ps(2), 1);
                   gfx_rect(px(dx0 - 10), py(dy0 - 8),  ps(2), ps(dh + 18), 1);
col(0x4E959E, 1);  gfx_rect(px(dx0 - 8),  py(dy0 + dh + 8), ps(dw + 18), ps(2), 1);
                   gfx_rect(px(dx0 + dw + 8), py(dy0 - 8), ps(2), ps(dh + 16), 1);
col(0xA0AF84, 1);  gfx_rect(px(dx0 - 4), py(dy0 - 4), ps(dw + 8), ps(dh + 8), 1);
col(0x0B2F35, 1);  gfx_rect(px(dx0), py(dy0), ps(dw), ps(dh), 1);
col(0x1F4C52, 1);  j = 1;
loop(4,
  gfx_line(px(dx0 + dw * j / 5), py(dy0), px(dx0 + dw * j / 5), py(dy0 + dh), 1);
  gfx_line(px(dx0), py(dy0 + dh - dh * j / 5), px(dx0 + dw), py(dy0 + dh - dh * j / 5), 1);
  j += 1;
);
// 0 dBFS marks (x = 1.0 of a 1.25 span)
col(0x3E6E72, 1);
gfx_line(px(dx0 + dw * 0.8), py(dy0), px(dx0 + dw * 0.8), py(dy0 + dh), 1);
gfx_line(px(dx0), py(dy0 + dh * 0.2), px(dx0 + dw), py(dy0 + dh * 0.2), 1);
// unity reference
col(0x5C8A8C, 1);
gfx_line(px(dx0), py(dy0 + dh), px(dx0 + dw), py(dy0), 1);
// current transfer: dry + EFFECT * (shaper - dry)
col(0xE4F0EF, 1);
e = lift_on ? effect / 100 : 0;
gcp = curve / 100;  gA = 1.5 + gcp;  gB = -2 * gcp;  gC = gcp - 0.5;  gD = 0.0625 - 0.25 * gcp + 0.25 * gcp * gcp;   // set_curve's sums, GUI side
j = 0;
loop(101,
  s = 1.25 * j / 100;
  yv = s + e * (g_lift(s) - s);
  gx = px(dx0 + dw * j / 100);
  gy = py(dy0 + dh - dh * min(1.25, max(0, yv)) / 1.25);
  j == 0 ? ( gfx_x = gx;  gfx_y = gy; ) : gfx_lineto(gx, gy, 1);
  j += 1;
);
gfx_setfont(5);  col(0x8FB0A8, 1);
gfx_x = px(dx0 + 6);  gfx_y = py(dy0 + 4);  gfx_drawstr("OUT");
gfx_x = px(dx0 + dw - 24);  gfx_y = py(dy0 + dh - 16);  gfx_drawstr("IN");
gfx_setfont(5);  col(0xE4F0EF, 1);  text_c(px(dx0 + dw * 0.5), py(dy0 + dh + 18), "TRANSFER");

// ---------- knobs ----------
knob(360, 140, 30,  1,  -6,  12, 0, "INPUT",  0, 4);
knob(520, 140, 42,  2,   0, 100, 0, "EFFECT", 1, 5);
knob(680, 140, 30,  3, -50,  50, 0, "CURVE",  2, 3);

// ---------- keys ----------
lk_fit(326, 254, 112, 40, clip,  LK_RED, "CLIP 0 dB") ? ( slider(4) = clip ? 0 : 1;  param_touched(4); );
lk_fit(450, 254, 132, 40, split, LK_SAGE, "BAND SPLIT") ? ( slider(5) = split ? 0 : 1; param_touched(5); );
lk_fit(594, 254, 72,  40, lift_on, LK_AMB,  "IN") ? ( slider(7) = lift_on ? 0 : 1; param_touched(7); );

// ---------- meters ----------
vslider(862, 70, 190, 6, -12, 3, 0, "OUTPUT");
vmeter(906, 70, 190, gdb(in_m),  "IN");
vmeter(940, 70, 190, gdb(out_m), "OUT");

// ---------- end of frame ----------
!lmb ? drag_idx = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // rebuilt in @block, never on the GUI thread
