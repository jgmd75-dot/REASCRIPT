desc:SUM DR2 (v2) [summing] (GFX)
//tags: summing mixer active analogue bus stems harmonics parallel limiter fet transformer iron colour mix buss
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-clip, gfx-ui, gfx-panel and gfx-dyn (.jsfx-inc) in the same folder.
//
// SUM DR2: a 16-channel ACTIVE summing mixer - eight stereo pairs summed by a clean, discrete active bus (no passive
// network, no make-up gain, no make-up noise) - with three analogue colour circuits that can be routed to the whole mix
// or to one of the last two stems.
//
// SET-UP (REAPER): put SUM DR2 on a bus track set to 16 channels (ROUTE > Track channels). Send each stem to its own
// pair (1/2, 3/4 ... 15/16) and turn off the stem tracks' master / parent send. The mix always leaves on 1/2; outputs
// 3 - 16 are silenced.
//   PAIRS 1-2 .. 15-16   SIGNAL PRESENT: one green LED per channel (lit above about -50 dBFS).
//                        MONO (per pair): the pair is summed to mono ((L + R) / 2 on both sides); glided, no click.
// THE BUS: unity gain. At its own small-signal level it is a wire; the character is subtle and level dependent: very
//   low THD (about 0.001 % at -18 dBFS, rising gently to about 0.07 % at 0 dBFS and more above), a 5 Hz low end and a
//   100 kHz top (about -0.17 dB at 20 kHz). There is no clip anywhere: the bus has the headroom of the float path.
// THE COLOUR CIRCUITS (each one is a single circuit, as in the hardware: it is in ONE place at a time)
//   HARMONICS        a parallel odd + even harmonic generator on the edge of distortion: the top end simmers, the bass
//                    growls, the image warms. BLEND = how much of it runs beside the clean signal.
//   PARALLEL LIMIT   an infinite-ratio FET limiter in the "every ratio key in" style - fast, aggressive, a little
//                    over-compressing, with a bright, gritty top - in parallel with the clean signal. BLEND = how much.
//                    The red LED beside its MIX BUSS key glows with its gain reduction.
//   FLIP             swaps the order of HARMONICS and PARALLEL LIMIT (it matters when both sit in the same place).
//   IRON             the output transformers, last in line (on the mix only). IN = solid, punchy console iron (a low
//                    bump, a gentle top); CORE drives the core: the lows saturate, the distortion lags the signal
//                    like hysteresis, and the top rounds off a little more.
//   ASSIGNMENT       MIX BUSS keys put HARMONICS / PARALLEL LIMIT on the whole mix (after the bus amplifier); the
//                    EFFECTS keys under 13-14 and 15-16 put them on that stem instead (before it joins the bus). A
//                    circuit moves (it fades out where it was and back in where it goes); press its lit key to take it
//                    out. The hardware's external stereo insert has no place in a plug-in, so it is left out.
//   Every key glides (20 ms): IN / OUT, FLIP and a move fade the circuit's blend down and back up, so nothing clicks.
// OUTPUT LEVEL TRIM  -3 .. +3 dB in 0.5 dB steps (stepped, for exact recalls).
// OUTPUT             straight through: SUM DR2 is a mix tool, so there is no output clip (the bus never clips; keep
//                    an eye on the master).
// DRIFT (0 - 100 %, 50 % = standard, 0 = none): the supply and the iron. The rails wander slowly and sag under a loud,
//   sustained mix, so the bus amplifier's tiny distortion, the HARMONICS headroom and the limiter's threshold breathe;
//   the transformer core's temperature drifts (its saturation and its low corner move a little).
// The clean path (every colour circuit out, DRIFT 0, TRIM 0) is the straight sum through the bus amplifier: the
//   only difference from a digital sum is the intended 5 Hz / 100 kHz bandwidth and the bus's tiny level-dependent THD.
// No latency (the colour circuits use first-order anti-aliased curves - the house clip kit - at the running rate).
// PRESETS: the house preset bar. Presets set the colour section, TRIM and DRIFT, and leave the MONO keys alone;
//   "Reset all to defaults" (in the list) resets everything.
// GUI: drag a knob (SHIFT = fine, double-click or CTRL-click = default, wheel); click a key; click the LCD (or PRESETS)
//   for the preset list. Values show on hover. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-clip.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc

slider1:0<0,3,1{Out,Mix buss,Stem 13-14,Stem 15-16}>-Harmonics assign
slider2:50<0,100,1>-Harmonics blend (%)
slider3:0<0,3,1{Out,Mix buss,Stem 13-14,Stem 15-16}>-Parallel limit assign
slider4:50<0,100,1>-Parallel limit blend (%)
slider5:0<0,1,1{Harmonics first,Limit first}>-Flip
slider6:0<0,1,1{Out,In}>-Iron
slider7:30<0,100,1>-Iron core (%)
slider8:0<-3,3,0.5>-Output level trim (dB)
slider9:50<0,100,1>-Drift (%)
slider10:0<0,1,1{Off,On}>-Mono 1-2
slider11:0<0,1,1{Off,On}>-Mono 3-4
slider12:0<0,1,1{Off,On}>-Mono 5-6
slider13:0<0,1,1{Off,On}>-Mono 7-8
slider14:0<0,1,1{Off,On}>-Mono 9-10
slider15:0<0,1,1{Off,On}>-Mono 11-12
slider16:0<0,1,1{Off,On}>-Mono 13-14
slider17:0<0,1,1{Off,On}>-Mono 15-16
slider18:prs_sel=0<0,12,1{No preset,Init,Clean Sum,Harmonics Glow,Harmonics Edge,Parallel Glue,Parallel Smash,Iron Punch,Iron Drive,Full Colour,Full Colour - Flipped,Stem Colour 13-14 / 15-16,Drum Stem Smash}>-Preset

in_pin:1 (pair 1-2 L)
in_pin:2 (pair 1-2 R)
in_pin:3 (pair 3-4 L)
in_pin:4 (pair 3-4 R)
in_pin:5 (pair 5-6 L)
in_pin:6 (pair 5-6 R)
in_pin:7 (pair 7-8 L)
in_pin:8 (pair 7-8 R)
in_pin:9 (pair 9-10 L)
in_pin:10 (pair 9-10 R)
in_pin:11 (pair 11-12 L)
in_pin:12 (pair 11-12 R)
in_pin:13 (pair 13-14 L)
in_pin:14 (pair 13-14 R)
in_pin:15 (pair 15-16 L)
in_pin:16 (pair 15-16 R)
out_pin:mix L
out_pin:mix R

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0; gdc_x12 = gdc_y12 = 0; gdc_x13 = gdc_y13 = 0; gdc_x14 = gdc_y14 = 0; gdc_x15 = gdc_y15 = 0;
#ui_man = "gfx-sum-dr2-v2";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;                  // the house drive standard; knee tracking ON (character)

// ---------- small building blocks ----------
// first-order section (transposed direct form II): y = (b0 + b1 z^-1) / (1 + a1 z^-1)
function f1(x, b0, b1, a1) instance(s) local(y) ( y = b0 * x + s; s = b1 * x - a1 * y; y; );
// the inverse of that section (exact: the shelves are minimum phase)
function f1i(x, b0, b1, a1) instance(s) local(y) ( y = (x + s) / b0; s = a1 * x - b1 * y; y; );
// first-order shelves (bilinear, prewarped): low shelf with DC gain g, high shelf with HF gain g; results in d2_q0..2
function d2_ls(fc, g) local(w) ( w = tan($pi * min(fc, 0.45 * srate) / srate);
  d2_q0 = (1 + g * w) / (1 + w); d2_q1 = (g * w - 1) / (1 + w); d2_q2 = (w - 1) / (1 + w); );
function d2_hs(fc, g) local(w) ( w = tan($pi * min(fc, 0.45 * srate) / srate);
  d2_q0 = (g + w) / (1 + w); d2_q1 = (w - g) / (1 + w); d2_q2 = (w - 1) / (1 + w); );
// matched one-pole low-pass (pole at exp(-wc), zero set so DC and Nyquist match the analogue response): any fc, any rate
function d2_mlp(fc) local(p, hn) (
  p = exp(-2 * $pi * fc / srate); hn = 1 / sqrt(1 + sqr(srate * 0.5 / fc));
  d2_q0 = ((1 - p) + hn * (1 + p)) * 0.5; d2_q1 = ((1 - p) - hn * (1 + p)) * 0.5; d2_q2 = -p;
);

// ---------- the pair inputs: MONO (glided) and the signal-present peaks ----------
function d2_pair(a, b) instance(m, tm, pl, pr) local(c) (
  pl = max(pl, abs(a)); pr = max(pr, abs(b));
  m != tm ? ( m += (tm - m) * d2_sm; abs(m - tm) < 0.00001 ? m = tm; );
  m > 0 ? ( c = (a + b) * 0.5; a += (c - a) * m; b += (c - b) * m; );
  d2_l = a; d2_r = b;
);

// ---------- HARMONICS: emphasis, drive, the biased knee curve (ADAA); only what the curve adds is kept ----------
// The linear part of the path cancels exactly, so the circuit adds harmonics (and its own gentle compression) beside
// the untouched signal. The lows and highs are emphasised into the curve and taken back out after it.
function d2_harm(x) instance(u1) local(u, v, r) (
  u = this.e1.f1(x, d2_el0, d2_el1, d2_el2); u = this.e2.f1(u, d2_eh0, d2_eh1, d2_eh2);
  v = this.cp.clp_pf_run(u * d2_hd);
  r = this.cp.clp_run(v + d2_hb) - d2_hcb - 0.5 * (v + u1); u1 = v;   // the curve minus the clean midpoint (ADAA lag)
  r = this.dc.f1(r, d2_dc0, -d2_dc0, d2_dc2);                         // DC blocker (the even harmonics' offset)
  r = this.d2.f1i(r, d2_eh0, d2_eh1, d2_eh2); r = this.d1.f1i(r, d2_el0, d2_el1, d2_el2);
  r * d2_hg;
);
function d2_hreset() instance(u1) ( u1 = 0; this.e1.s = this.e2.s = this.d1.s = this.d2.s = this.dc.s = 0;
  this.cp.clp_reset(); this.cp.clp_pf_reset(); );

// ---------- PARALLEL LIMIT: a linked peak detector, infinite (a little over) ratio, FET grit, a bright top ----------
// returns through d2_wl / d2_wr: the limited (wet) signal of the stereo pair
function d2_lim(l, r) local(k, g, a, b) (
  k = max(abs(l), abs(r));
  k > d2_pe ? d2_pe += (k - d2_pe) * d2_la : d2_pe += (k - d2_pe) * (d2_lrf + (d2_lrs - d2_lrf) * d2_ph);
  g = d2_pe > d2_lt ? max(exp(d2_lx * log(d2_lt / d2_pe)), 0.02) : 1;
  d2_ph = g < 0.6 ? min(d2_ph + d2_phu, 1) : max(d2_ph - d2_phd, 0);  // release slows the longer it works
  d2_lgm = min(d2_lgm, g);
  a = l * g * d2_lmk; b = r * g * d2_lmk;
  a += d2_lfe * (1 - g) * a * abs(a); b += d2_lfe * (1 - g) * b * abs(b); // the FET's grit grows with the reduction
  a = lbL.f1(a, d2_lb0, d2_lb1, d2_lb2); b = lbR.f1(b, d2_lb0, d2_lb1, d2_lb2);
  a = lcL.clp_pf_run(a); b = lcR.clp_pf_run(b);
  d2_wl = a + lcL.clp_run(a) - 0.5 * (a + d2_la1); d2_la1 = a;          // the output amp's rails (ADAA, no lag)
  d2_wr = b + lcR.clp_run(b) - 0.5 * (b + d2_lb1x); d2_lb1x = b;
);
function d2_lreset() ( d2_pe = 0; d2_ph = 0; d2_la1 = d2_lb1x = 0; lbL.s = lbR.s = 0;
  lcL.clp_reset(); lcR.clp_reset(); lcL.clp_pf_reset(); lcR.clp_pf_reset(); );

// ---------- the colour chain at one place (1 mix, 2 stem 13-14, 3 stem 15-16), in the FLIP order ----------
function d2_hrun(l, r) local(g) ( d2_hbe > 0 ? ( g = 1 + 0.05 * d2_hbe;               // (its gentle compression made up)
  d2_l = (l + d2_hbe * hL.d2_harm(l)) * g; d2_r = (r + d2_hbe * hR.d2_harm(r)) * g; ) : ( d2_l = l; d2_r = r; ); );
function d2_prun(l, r) ( d2_pbe > 0 ? ( d2_lim(l, r); d2_l = l + d2_pbe * (d2_wl - l); d2_r = r + d2_pbe * (d2_wr - r); ) : ( d2_l = l; d2_r = r; ); );
function d2_chain(loc, l, r) (
  d2_l = l; d2_r = r;
  d2_fl ? (
    d2_pl == loc ? d2_prun(d2_l, d2_r);
    d2_hl == loc ? d2_hrun(d2_l, d2_r);
  ) : (
    d2_hl == loc ? d2_hrun(d2_l, d2_r);
    d2_pl == loc ? d2_prun(d2_l, d2_r);
  );
);

// ---------- IRON: coupling and a low bump, the core (lows into a biased knee, ADAA), its lagging residue, the top ----------
function d2_iron(x) instance(lo, lo1, rl) local(u, y) (
  x = this.bp.bq_run(x); x = this.hp.bq_run(x);
  lo += (x - lo) * d2_ilc;
  u = lo * d2_id;
  y = (this.cp.clp_run(u + d2_ib) - d2_icb) / d2_id - 0.5 * (lo + lo1); lo1 = lo;   // what the core adds
  rl += (y - rl) * d2_ihy;                                                         // ... lagging the signal
  this.hf.f1(x + rl, d2_ih0, d2_ih1, d2_ih2) * d2_img;                                 // (level matched)
);
function d2_ireset() instance(lo, lo1, rl) ( lo = lo1 = rl = 0; this.hf.s = 0;
  this.bp.x1 = this.bp.x2 = this.bp.y1 = this.bp.y2 = 0; this.hp.x1 = this.hp.x2 = this.hp.y1 = this.hp.y2 = 0;
  this.cp.clp_reset(); );

// ---------- the coefficients (per block: REAPER calls @init with samplesblock 0) ----------
function d2_coef() local(t) (
  d2_sr = srate;
  d2_sm = 1 - exp(-1 / (0.02 * srate));                    // 20 ms glides
  d2_fd = 1 / (0.02 * srate);                              // 20 ms fades (moves, IN / OUT, FLIP)
  d2_rmk = 1 - exp(-1 / (1.04 * srate));                   // the supply's load meter (~1 s at any rate)
  // the bus: 5 Hz high-pass, 100 kHz matched low-pass
  t = tan($pi * 5 / srate); d2_bh0 = 1 / (1 + t); d2_bh2 = (t - 1) / (1 + t);
  d2_mlp(100000); d2_bl0 = d2_q0; d2_bl1 = d2_q1; d2_bl2 = d2_q2;
  // HARMONICS emphasis (+6 dB lows at 150 Hz, +6 dB highs at 4 kHz) and the DC blocker
  d2_ls(150, 1.68); d2_el0 = d2_q0; d2_el1 = d2_q1; d2_el2 = d2_q2;
  d2_hs(4000, 2); d2_eh0 = d2_q0; d2_eh1 = d2_q1; d2_eh2 = d2_q2;
  t = tan($pi * 4 / srate); d2_dc0 = 1 / (1 + t); d2_dc2 = (t - 1) / (1 + t);
  // PARALLEL LIMIT: 0.2 ms attack, 60 / 380 ms release, the bright top (+3.5 dB from 4.5 kHz)
  d2_la = 1 - exp(-1 / (0.0002 * srate));
  d2_lrf = 1 - exp(-1 / (0.06 * srate)); d2_lrs = 1 - exp(-1 / (0.38 * srate));
  d2_phu = 1 / (0.6 * srate); d2_phd = 1 / (1.2 * srate);
  d2_hs(4500, 1.5); d2_lb0 = d2_q0; d2_lb1 = d2_q1; d2_lb2 = d2_q2;
  // IRON: the low bump (+0.7 dB at 50 Hz), the coupling (7 Hz), the residue's lag (300 Hz)
  ibL.bq_set(2, 50, 0.8, 0.7); ibR.bq_set(2, 50, 0.8, 0.7);
  ihL.bq_set(1, 7, 0.55, 0); ihR.bq_set(1, 7, 0.55, 0);
  iL.bp.b0 = ibL.b0; iL.bp.b1 = ibL.b1; iL.bp.b2 = ibL.b2; iL.bp.a1 = ibL.a1; iL.bp.a2 = ibL.a2;
  iR.bp.b0 = ibL.b0; iR.bp.b1 = ibL.b1; iR.bp.b2 = ibL.b2; iR.bp.a1 = ibL.a1; iR.bp.a2 = ibL.a2;
  iL.hp.b0 = ihL.b0; iL.hp.b1 = ihL.b1; iL.hp.b2 = ihL.b2; iL.hp.a1 = ihL.a1; iL.hp.a2 = ihL.a2;
  iR.hp.b0 = ihL.b0; iR.hp.b1 = ihL.b1; iR.hp.b2 = ihL.b2; iR.hp.a1 = ihL.a1; iR.hp.a2 = ihL.a2;
  d2_ihy = 1 - exp(-2 * $pi * 300 / srate);
);

// ---------- the controls (read every block) ----------
function d2_update() local(i) (
  d2_th = min(max(slider1 | 0, 0), 3); d2_tp = min(max(slider3 | 0, 0), 3);
  d2_tbh = min(max(slider2, 0), 100) / 100; d2_tbp = min(max(slider4, 0), 100) / 100;
  d2_tfl = slider5 >= 0.5; d2_tio = slider6 >= 0.5; d2_tco = min(max(slider7, 0), 100) / 100;
  d2_ttr = 10 ^ (min(max(slider8, -3), 3) / 20);
  drift_macro(slider9);
  p0.tm = slider10 >= 0.5; p1.tm = slider11 >= 0.5; p2.tm = slider12 >= 0.5; p3.tm = slider13 >= 0.5;
  p4.tm = slider14 >= 0.5; p5.tm = slider15 >= 0.5; p6.tm = slider16 >= 0.5; p7.tm = slider17 >= 0.5;
);

// the curves (set once; the knees track per block)
hL.cp.clp_set(2, 1, 1, 0); hR.cp.clp_set(2, 1, 1, 0);
hL.cp.clp_pf_cfg(22000, 14000, -1, 150); hR.cp.clp_pf_cfg(22000, 14000, -1, 150);
hL.cp.clp_kt_cfg(0.4, 0.8); hR.cp.clp_kt_cfg(0.4, 0.8);
lcL.clp_set(1, 1, 1, 0); lcR.clp_set(1, 1, 1, 0);
lcL.clp_pf_cfg(24000, 12000, -1, 120); lcR.clp_pf_cfg(24000, 12000, -1, 120);
iL.cp.clp_set(2, 1, 1, 0); iR.cp.clp_set(2, 1, 1, 0);
iL.cp.clp_kt_cfg(0.3, 0.9); iR.cp.clp_kt_cfg(0.3, 0.9);
d2_hb = 0.2; d2_hd0 = 1.5; d2_hg = 1.2;                    // HARMONICS: bias (even), drive, what is added
d2_lt0 = 10 ^ (-24 / 20); d2_lx = 1.12; d2_lmk = 10 ^ (15.5 / 20); d2_lfe = 0.3;   // PARALLEL LIMIT
d2_c2 = 0.001; d2_c3 = 0.0018;                             // the bus amplifier's tiny 2nd / 3rd

d2_coef(); d2_update();
d2_hl = d2_th; d2_pl = d2_tp; d2_fl = d2_tfl;              // start where the controls are (no fade at load)
d2_hf = d2_hl ? 1 : 0; d2_pf = d2_pl ? 1 : 0; d2_ff = 1;
d2_bh = d2_tbh; d2_bp = d2_tbp; d2_io = d2_tio; d2_co = d2_tco; d2_tr = d2_ttr;
p0.m = p0.tm; p1.m = p1.tm; p2.m = p2.tm; p3.m = p3.tm; p4.m = p4.tm; p5.m = p5.tm; p6.m = p6.tm; p7.m = p7.tm;
dA.drift_init(0.8 + rand(1) * 0.4); dB.drift_init(0.8 + rand(1) * 0.4); dC.drift_init(0.8 + rand(1) * 0.4); dD.drift_init(0.8 + rand(1) * 0.4);
d2_w1 = d2_w2 = d2_w3 = d2_w4 = 0; d2_rms = 0; d2_lgm = 1; d2_gra = 1; dv_gr = 1;   // (the GR LED starts dark)

// ---------- presets: the colour section, TRIM and DRIFT (the MONO keys are left alone, except Reset) ----------
function d2_set(h, hb, p, pb, fl, io, co, tr, dr) (
  slider1 = h; slider2 = hb; slider3 = p; slider4 = pb; slider5 = fl; slider6 = io; slider7 = co; slider8 = tr; slider9 = dr;
  slider_automate(511);                                     // sliders 1-9
);
#d2_pm = "Init|Clean Sum|Harmonics Glow|Harmonics Edge|Parallel Glue|Parallel Smash|Iron Punch|Iron Drive|Full Colour|Full Colour, Flipped|Stem Colour 13-14 / 15-16|Drum Stem Smash";
function load_preset(p) local(i) (
  //                 H  blend  P  blend flip iron core trim drift
  p == 1  ? d2_set(0,  50,   0,  50,   0,   0,  30,   0,   50) :   // Init
  p == 2  ? d2_set(0,  50,   0,  50,   0,   0,  30,   0,    0) :   // Clean Sum
  p == 3  ? d2_set(1,  40,   0,  50,   0,   0,  30,   0,   50) :   // Harmonics Glow
  p == 4  ? d2_set(1,  85,   0,  50,   0,   0,  30,   0,   60) :   // Harmonics Edge
  p == 5  ? d2_set(0,  50,   1,  25,   0,   0,  30,   0,   50) :   // Parallel Glue
  p == 6  ? d2_set(0,  50,   1,  55,   0,   0,  30,   0,   50) :   // Parallel Smash
  p == 7  ? d2_set(0,  50,   0,  50,   0,   1,  20,   0,   50) :   // Iron Punch
  p == 8  ? d2_set(0,  50,   0,  50,   0,   1,  75,   0,   60) :   // Iron Drive
  p == 9  ? d2_set(1,  45,   1,  35,   0,   1,  40,   0,   50) :   // Full Colour
  p == 10 ? d2_set(1,  45,   1,  35,   1,   1,  40,   0,   50) :   // Full Colour, Flipped
  p == 11 ? d2_set(2,  60,   3,  45,   0,   1,  25,   0,   50) :   // Stem Colour 13-14 / 15-16
  p == 12 ? d2_set(0,  50,   2,  70,   0,   1,  35,   0,   50) :   // Drum Stem Smash
  p == 13 ? (                                                       // Reset all to defaults
    d2_set(0, 50, 0, 50, 0, 0, 30, 0, 50);
    i = 10; loop(8, slider(i) = 0; ui_auto(i); i += 1; );
  );
  pr_cur = p > 12 ? 1 : p;
);

ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
d2_update();

@block
prs_chk();
srate != d2_sr ? d2_coef();
d2_update();
// drift: the supply wanders (and sags under a loud mix), the iron's temperature drifts
d2_di = 0.12 * dm_s * samplesblock / srate;
d2_w1 = dA.drift_tick(d2_di); d2_w2 = dB.drift_tick(d2_di); d2_w3 = dC.drift_tick(d2_di * 0.5); d2_w4 = dD.drift_tick(d2_di);
d2_rmsb = sqrt(max(d2_rms, 0));
d2_sag = dm_a * 0.1 * min(d2_rmsb / 0.25, 1);
d2_c3e = d2_c3 * (1 + dm_a * (0.3 * d2_w1 + 2 * min(d2_rmsb, 0.5)));
d2_c2e = d2_c2 * (1 + dm_a * 0.5 * d2_w4);
d2_hd = d2_hd0 * (1 + dm_a * 0.05 * d2_w1 + d2_sag);
d2_hcb = hL.cp.clp_crv(d2_hb);
d2_lt = d2_lt0 * (1 + dm_a * 0.04 * d2_w2) * (1 - 0.5 * d2_sag);
// the knees (tracking) and the pre-filters, per block
d2_k = hL.cp.clp_kt_block(0.6, srate, samplesblock); hL.cp.clp_knee(d2_k); hR.cp.clp_knee(d2_k);
hL.cp.clp_pf_block(0.6, srate, samplesblock); hR.cp.clp_pf_block(0.6, srate, samplesblock);
lcL.clp_pf_block(0.3, srate, samplesblock); lcR.clp_pf_block(0.3, srate, samplesblock);
// IRON: CORE (glided in @sample) sets the core drive, its bias, the knee and the top
d2_cb = d2_co;
d2_id = (1.4 + 5.6 * d2_cb * sqrt(d2_cb)) * (1 + dm_a * 0.08 * d2_w3);
d2_ib = 0.03 + 0.06 * d2_cb;
d2_ilc = 1 - exp(-2 * $pi * 180 * (1 + dm_a * 0.05 * d2_w3) / srate);
d2_k = iL.cp.clp_kt_block(d2_cb, srate, samplesblock); iL.cp.clp_knee(d2_k); iR.cp.clp_knee(d2_k);
d2_icb = iL.cp.clp_crv(d2_ib); d2_img = 10 ^ ((-0.3 + 1.0 * d2_cb) / 20);
d2_mlp(60000 * (18000 / 60000) ^ d2_cb); d2_ih0 = d2_q0; d2_ih1 = d2_q1; d2_ih2 = d2_q2;
hL.cp.clp_tidy(); hR.cp.clp_tidy(); lcL.clp_tidy(); lcR.clp_tidy(); iL.cp.clp_tidy(); iR.cp.clp_tidy();
// the meters, handed to the panel
p0.al = max(p0.al, p0.pl); p0.ar = max(p0.ar, p0.pr); p0.pl = p0.pr = 0;
p1.al = max(p1.al, p1.pl); p1.ar = max(p1.ar, p1.pr); p1.pl = p1.pr = 0;
p2.al = max(p2.al, p2.pl); p2.ar = max(p2.ar, p2.pr); p2.pl = p2.pr = 0;
p3.al = max(p3.al, p3.pl); p3.ar = max(p3.ar, p3.pr); p3.pl = p3.pr = 0;
p4.al = max(p4.al, p4.pl); p4.ar = max(p4.ar, p4.pr); p4.pl = p4.pr = 0;
p5.al = max(p5.al, p5.pl); p5.ar = max(p5.ar, p5.pr); p5.pl = p5.pr = 0;
p6.al = max(p6.al, p6.pl); p6.ar = max(p6.ar, p6.pr); p6.pl = p6.pr = 0;
p7.al = max(p7.al, p7.pl); p7.ar = max(p7.ar, p7.pr); p7.pl = p7.pr = 0;
d2_gra = min(d2_gra, d2_pl > 0 && d2_pbe > 0 ? d2_lgm : 1); d2_lgm = 1;
// denormal housekeeping
abs(d2_hpx) < 0.000000000001 ? d2_hpx = 0; abs(d2_hpy) < 0.000000000001 ? d2_hpy = 0;
abs(d2_hqx) < 0.000000000001 ? d2_hqx = 0; abs(d2_hqy) < 0.000000000001 ? d2_hqy = 0;
abs(d2_pe) < 0.000000000001 ? d2_pe = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
gdc_y12 = spl12 - gdc_x12 + gdc_r * gdc_y12; gdc_x12 = spl12; spl12 = gdc_y12;
gdc_y13 = spl13 - gdc_x13 + gdc_r * gdc_y13; gdc_x13 = spl13; spl13 = gdc_y13;
gdc_y14 = spl14 - gdc_x14 + gdc_r * gdc_y14; gdc_x14 = spl14; spl14 = gdc_y14;
gdc_y15 = spl15 - gdc_x15 + gdc_r * gdc_y15; gdc_x15 = spl15; spl15 = gdc_y15;
// ---------- glides and fades ----------
d2_bh += (d2_tbh - d2_bh) * d2_sm; d2_bp += (d2_tbp - d2_bp) * d2_sm;
d2_co += (d2_tco - d2_co) * d2_sm; d2_tr += (d2_ttr - d2_tr) * d2_sm;
// a circuit that moves fades out where it is, jumps (fresh), and fades in where it goes
d2_th != d2_hl ? ( d2_hf -= d2_fd; d2_hf <= 0 ? ( d2_hf = 0; d2_hl = d2_th; hL.d2_hreset(); hR.d2_hreset(); ); ) :
  d2_hl && d2_hf < 1 ? d2_hf = min(d2_hf + d2_fd, 1);
d2_tp != d2_pl ? ( d2_pf -= d2_fd; d2_pf <= 0 ? ( d2_pf = 0; d2_pl = d2_tp; d2_lreset(); ); ) :
  d2_pl && d2_pf < 1 ? d2_pf = min(d2_pf + d2_fd, 1);
// FLIP: when both circuits sit in the same place, both dip, swap at the bottom and come back
d2_tfl != d2_fl ? (
  d2_hl && d2_hl == d2_pl ? ( d2_ff -= d2_fd; d2_ff <= 0 ? ( d2_ff = 0; d2_fl = d2_tfl; ); ) : d2_fl = d2_tfl;
) : d2_ff < 1 ? d2_ff = min(d2_ff + d2_fd, 1);
d2_hbe = d2_hl ? d2_bh * d2_hf * d2_ff : 0; d2_hbe < 0.000001 ? d2_hbe = 0;
d2_pbe = d2_pl ? d2_bp * d2_pf * d2_ff : 0; d2_pbe < 0.000001 ? d2_pbe = 0;
d2_tio != d2_io ? ( d2_io += d2_tio ? d2_fd : -d2_fd; d2_io = min(max(d2_io, 0), 1);
  d2_tio && d2_io <= d2_fd ? ( iL.d2_ireset(); iR.d2_ireset(); ); );

// ---------- the pairs ----------
p0.d2_pair(spl0, spl1); d2_ml = d2_l; d2_mr = d2_r;
p1.d2_pair(spl2, spl3); d2_ml += d2_l; d2_mr += d2_r;
p2.d2_pair(spl4, spl5); d2_ml += d2_l; d2_mr += d2_r;
p3.d2_pair(spl6, spl7); d2_ml += d2_l; d2_mr += d2_r;
p4.d2_pair(spl8, spl9); d2_ml += d2_l; d2_mr += d2_r;
p5.d2_pair(spl10, spl11); d2_ml += d2_l; d2_mr += d2_r;
p6.d2_pair(spl12, spl13);
d2_hl == 2 || d2_pl == 2 ? d2_chain(2, d2_l, d2_r);          // a stem's colour, before it joins the bus
d2_ml += d2_l; d2_mr += d2_r;
p7.d2_pair(spl14, spl15);
d2_hl == 3 || d2_pl == 3 ? d2_chain(3, d2_l, d2_r);
d2_ml += d2_l; d2_mr += d2_r;

// ---------- the bus amplifier: unity, its tiny level-dependent 2nd / 3rd (bounded: endless headroom) ----------
d2_u = min(max(d2_ml, -4), 4); d2_ml += d2_u * d2_u * (d2_c2e - d2_c3e * d2_u);
d2_u = min(max(d2_mr, -4), 4); d2_mr += d2_u * d2_u * (d2_c2e - d2_c3e * d2_u);
d2_rms += (0.5 * (d2_ml * d2_ml + d2_mr * d2_mr) - d2_rms) * d2_rmk;    // the supply's load (slow: ~1 s)

// ---------- the mix-buss colour, then the iron ----------
d2_hl == 1 || d2_pl == 1 ? ( d2_chain(1, d2_ml, d2_mr); d2_ml = d2_l; d2_mr = d2_r; );
d2_io > 0 ? (
  d2_ml += d2_io * (iL.d2_iron(d2_ml) - d2_ml);
  d2_mr += d2_io * (iR.d2_iron(d2_mr) - d2_mr);
);

// ---------- the bus bandwidth (5 Hz - 100 kHz), the output trim; straight through (no clip) ----------
d2_y = d2_bh0 * (d2_ml - d2_hpx) - d2_bh2 * d2_hpy; d2_hpx = d2_ml; d2_hpy = d2_y;
d2_ml = d2_bl0 * d2_y + d2_blx; d2_blx = d2_bl1 * d2_y - d2_bl2 * d2_ml;
d2_y = d2_bh0 * (d2_mr - d2_hqx) - d2_bh2 * d2_hqy; d2_hqx = d2_mr; d2_hqy = d2_y;
d2_mr = d2_bl0 * d2_y + d2_bly; d2_bly = d2_bl1 * d2_y - d2_bl2 * d2_mr;
spl0 = d2_ml * d2_tr; spl1 = d2_mr * d2_tr;
spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = spl8 = spl9 = spl10 = spl11 = spl12 = spl13 = spl14 = spl15 = 0;

@gfx 1220 360
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1220, 360);

// ---------- palette and fonts ----------
DV_H = 200000;
DV_FACE = 0x141517; DV_EAR = 0x1B1C1F; DV_INK = 0xD4D6DA; DV_DIM = 0x8C9096; DV_OR = 0xFF7A1A;
DV_RED = 0xFF3B2F; DV_BLU = 0x3C8DFF; DV_GRN = 0x34DC5A; DV_AMB = 0xFFB020; DV_CRM = 0xF4E3B2; DV_LED = 0x3DFF62;
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');            // labels, engraved print
gfx_setfont(12, "Trebuchet MS", 12.5 * sc, 'b');          // key captions
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');            // scale numbers, small print
gfx_setfont(14, "Trebuchet MS", 27 * sc, 'b');            // the title
gfx_setfont(15, "Trebuchet MS", 21 * sc, 'b');            // the badge

function dg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function dg_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function dg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
// an engraved caption with a bracket line (the hardware's section print)
function dg_brk(x1, x2, y, s) local(tw, th, cx) (
  gfx_setfont(11); gfx_measurestr(s, tw, th); cx = (x1 + x2) * 0.5 * sc;
  ui_cola(DV_DIM, 0.8);
  gfx_line(x1 * sc, y * sc, cx - tw * 0.5 - 8 * sc, y * sc); gfx_line(cx + tw * 0.5 + 8 * sc, y * sc, x2 * sc, y * sc);
  gfx_line(x1 * sc, y * sc, x1 * sc, (y - 6) * sc); gfx_line(x2 * sc, y * sc, x2 * sc, (y - 6) * sc);
  ui_col(DV_INK); gfx_x = cx - tw * 0.5; gfx_y = y * sc - th * 0.5; gfx_drawstr(s);
);
// a value pill (the house hover value)
function dg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(11); gfx_measurestr(s, tw, th);
  ui_col(0x050506); gfx_rect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 4 * sc);
  ui_col(DV_OR); gfx_rect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, 1 * sc);
  ui_col(0xFFFFFF); gfx_x = cx * sc - tw * 0.5; gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);
function dg_set(idx, v) ( slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); ); );
// the lit SQUARE key: a black bezel, a frosted cap that glows in its colour when lit; s = the caption on the cap
function dg_key(x, y, w, h, on, col, s) local(hov, hit) (
  hov = dg_in(x - 3, y - 3, w + 6, h + 6); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(0x050506); dg_r(x - 3, y - 3, w + 6, h + 6);
  ui_col(0x2E3034); dg_r(x - 3, y - 3, w + 6, 1);
  on ? (
    ui_cola(col, 0.10); dg_r(x - 9, y - 9, w + 18, h + 18);
    ui_cola(col, 0.16); dg_r(x - 6, y - 6, w + 12, h + 12);
    ui_col(ui_mix(col, 0x000000, 0.25)); dg_r(x, y, w, h);
    ui_col(col); dg_r(x + 2, y + 2, w - 4, h - 4);
    ui_cola(0xFFFFFF, 0.28); dg_r(x + 5, y + 5, w - 10, h - 10);
  ) : (
    ui_col(ui_mix(col, 0x0B0B0C, 0.82)); dg_r(x, y, w, h);
    ui_col(ui_mix(col, 0x0B0B0C, 0.74)); dg_r(x + 2, y + 2, w - 4, h - 4);
  );
  hov ? ( ui_cola(0xFFFFFF, 0.08); dg_r(x, y, w, h); );
  strlen(s) ? ( gfx_setfont(12); ui_col(on ? 0x141414 : ui_mix(col, 0xC8C8C8, 0.45)); dg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
// a key with its caption underneath (one or two lines)
function dg_keyc(cx, y, on, col, s1, s2) local(hit) (
  hit = dg_key(cx - 17, y, 34, 34, on, col, "");
  gfx_setfont(11); ui_col(on ? DV_INK : DV_DIM); dg_tc(cx, y + 48, s1); strlen(s2) ? dg_tc(cx, y + 62, s2);
  hit;
);
// the LED (round, green, as on the hardware's SIGNAL PRESENT row)
function dg_led(cx, cy, r, lv, col) (
  ui_col(0x050506); gfx_circle(cx * sc, cy * sc, (r + 1.5) * sc, 1, 1);
  lv > 0 ? (
    ui_cola(col, 0.22 * lv); gfx_circle(cx * sc, cy * sc, (r + 4.5) * sc, 1, 1);
    ui_col(ui_mix(ui_mix(col, 0x000000, 0.75), col, lv)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
    ui_cola(0xFFFFFF, 0.55 * lv); gfx_circle((cx - r * 0.3) * sc, (cy - r * 0.3) * sc, r * 0.32 * sc, 1, 1);
  ) : ( ui_col(ui_mix(col, 0x000000, 0.8)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
);
// the knob: a flat black cap, an orange pointer, an engraved scale (n ticks; numbers from #dg_n0 .. #dg_n1)
// stp > 0: the value moves in steps of stp. Values show on hover / drag.
function dg_knob(cx, cy, r, idx, lo, hi, def, lg, label, stp) local(v, n, dx, dy, hov, did, i, a, ca, sa, k) (
  did = 5000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - dg_lt < 0.35 && dg_lid == idx && !dg_mv) || (mouse_cap & 4) ? ( dg_set(idx, def); drag_id = -1; dg_lt = 0; ) : (
      drag_id = did; dg_ky = mouse_y; dg_ky0 = mouse_y; dg_mv = 0; dg_lt = time_precise(); dg_lid = idx;
      dg_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !dg_mv && abs(mouse_y - dg_ky0) > 3 * sc ? ( dg_mv = 1; dg_ky = mouse_y; );
  drag_id == did && dg_mv ? (
    dg_kn = min(max(dg_kn + (dg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); dg_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ dg_kn : lo + dg_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    dg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 && stp / (hi - lo) > 0.02 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    dg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo), 0), 1);
  // the engraved scale
  i = 0; loop(dg_nt,
    a = -0.75 * $pi + i / (dg_nt - 1) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
    k = i == 0 || i == dg_nt - 1 || i == (dg_nt - 1) * 0.5;
    ui_cola(DV_INK, k ? 0.85 : 0.5);
    gfx_line((cx + ca * (r + 5)) * sc, (cy + sa * (r + 5)) * sc, (cx + ca * (r + (k ? 11 : 8))) * sc, (cy + sa * (r + (k ? 11 : 8))) * sc, 1);
    i += 1; );
  gfx_setfont(13); ui_cola(DV_INK, 0.85);
  a = -0.75 * $pi; dg_tc(cx + sin(a) * (r + 19), cy - cos(a) * (r + 19) + 3, #dg_n0);
  a = 0.75 * $pi;  dg_tc(cx + sin(a) * (r + 19), cy - cos(a) * (r + 19) + 3, #dg_n1);
  strlen(#dg_nm) ? dg_tc(cx, cy - r - 17, #dg_nm);
  // the cap: flat black, a thin rim, the orange pointer
  ui_cola(0x000000, 0.5); gfx_circle((cx + 1) * sc, (cy + 2) * sc, r * sc, 1, 1);
  ui_col(0x2A2C30); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(0x101113); gfx_circle(cx * sc, cy * sc, (r - 1.5) * sc, 1, 1);
  ui_col(0x1A1B1E); gfx_circle(cx * sc, cy * sc, r * 0.62 * sc, 1, 1);
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(DV_OR); i = -1.5;
  ui_ssline((cx + ca * r * 0.3) * sc, (cy + sa * r * 0.3) * sc, (cx + ca * (r - 2)) * sc, (cy + sa * (r - 2)) * sc, 2.8 * sc, 1);
  (hov || drag_id == did) ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1); );
  dg_act = hov || drag_id == did;
  gfx_setfont(11); ui_col(DV_INK); strlen(label) && !dg_act ? dg_tc(cx, cy + r + 26, label);
  strcpy(#dg_n0, ""); strcpy(#dg_n1, ""); strcpy(#dg_nm, ""); dg_nt = 11;
);
dg_nt = 11;

// ---------- the rack face ----------
ui_col(0x0A0A0B); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(DV_FACE); dg_r(0, 0, 1220, 360);
// the ears (with their slots) and the vents beside them
ui_col(DV_EAR); dg_r(0, 0, 28, 360); dg_r(1192, 0, 28, 360);
ui_cola(0x000000, 0.55); dg_r(28, 0, 2, 360); dg_r(1190, 0, 2, 360);
ui_col(0x050506);
ui_rrect(8 * sc, 30 * sc, 12 * sc, 26 * sc, 6 * sc); ui_rrect(8 * sc, 304 * sc, 12 * sc, 26 * sc, 6 * sc);
ui_rrect(1200 * sc, 30 * sc, 12 * sc, 26 * sc, 6 * sc); ui_rrect(1200 * sc, 304 * sc, 12 * sc, 26 * sc, 6 * sc);
dv_i = 0; loop(9, ui_col(0x08080A); dg_r(38, 74 + dv_i * 24, 6, 14); dg_r(1176, 74 + dv_i * 24, 6, 14); dv_i += 1; );
ui_cola(0xFFFFFF, 0.05); dg_r(30, 0, 1160, 1);

// ---------- the badge and the title ----------
ui_col(DV_OR); gfx_circle(120 * sc, 116 * sc, 46 * sc, 1, 1);
ui_col(DV_FACE); gfx_circle(120 * sc, 116 * sc, 41 * sc, 1, 1);
ui_col(DV_OR); gfx_circle(120 * sc, 116 * sc, 37 * sc, 1, 1);
gfx_setfont(15); ui_col(0x111111); dg_tc(120, 117, "DR2");
gfx_setfont(14); ui_col(DV_OR); dg_tc(120, 192, "SUM DR2"); ver_tag("v2", 16, 0, 0);
gfx_setfont(13); ui_col(DV_DIM); dg_tc(120, 216, "16-CHANNEL ACTIVE"); dg_tc(120, 230, "SUMMING MIXER");
gfx_setfont(13); ui_col(DV_OR); dg_tc(120, 30, "GFX");

// ---------- the preset bar and the size keys ----------
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
dv_k = pk_preset(226 * sc, 14 * sc, 360 * sc, 30 * sc, pr_cur, #d2_pm);
dv_k > 0 ? prs_dirty = dv_k;
ui_size_picker(1122 * sc, 20 * sc);

// ---------- the channels: SIGNAL PRESENT, MONO ----------
dg_brk(212, 712, 66, "SIGNAL PRESENT");
dv_c = 0;
loop(8,
  dv_cx = 244 + dv_c * 64;
  dv_c == 0 ? ( dv_al = p0.al; dv_ar = p0.ar; p0.al = p0.ar = 0; ) : dv_c == 1 ? ( dv_al = p1.al; dv_ar = p1.ar; p1.al = p1.ar = 0; ) :
  dv_c == 2 ? ( dv_al = p2.al; dv_ar = p2.ar; p2.al = p2.ar = 0; ) : dv_c == 3 ? ( dv_al = p3.al; dv_ar = p3.ar; p3.al = p3.ar = 0; ) :
  dv_c == 4 ? ( dv_al = p4.al; dv_ar = p4.ar; p4.al = p4.ar = 0; ) : dv_c == 5 ? ( dv_al = p5.al; dv_ar = p5.ar; p5.al = p5.ar = 0; ) :
  dv_c == 6 ? ( dv_al = p6.al; dv_ar = p6.ar; p6.al = p6.ar = 0; ) : ( dv_al = p7.al; dv_ar = p7.ar; p7.al = p7.ar = 0; );
  // held a moment, so the LEDs do not flicker between audio blocks
  DV_H[2 * dv_c] = max(dv_al, DV_H[2 * dv_c] * 0.86); DV_H[2 * dv_c + 1] = max(dv_ar, DV_H[2 * dv_c + 1] * 0.86);
  dg_led(dv_cx - 13, 92, 4.5, DV_H[2 * dv_c] > 0.00316 ? min(1, 0.55 + 0.45 * min(DV_H[2 * dv_c] / 0.1, 1)) : 0, DV_LED);
  dg_led(dv_cx + 13, 92, 4.5, DV_H[2 * dv_c + 1] > 0.00316 ? min(1, 0.55 + 0.45 * min(DV_H[2 * dv_c + 1] / 0.1, 1)) : 0, DV_LED);
  gfx_setfont(13); ui_col(DV_INK);
  sprintf(#dv_s, "%d", 2 * dv_c + 1); dg_tc(dv_cx - 13, 111, #dv_s);
  sprintf(#dv_s, "%d", 2 * dv_c + 2); dg_tc(dv_cx + 13, 111, #dv_s);
  dg_key(dv_cx - 20, 134, 40, 40, slider(10 + dv_c) >= 0.5, DV_CRM, "MONO") ? dg_set(10 + dv_c, slider(10 + dv_c) >= 0.5 ? 0 : 1);
  dv_c += 1;
);
// MONO print under the keys
gfx_setfont(13); ui_col(DV_DIM);
dv_c = 0; loop(8, sprintf(#dv_s, "%d-%d", 2 * dv_c + 1, 2 * dv_c + 2); dg_tc(244 + dv_c * 64, 189, #dv_s); dv_c += 1; );

// ---------- EFFECTS: HARMONICS / PARALLEL LIMIT on stem 13-14 or 15-16 ----------
dg_brk(384, 541, 216, "13-14");
dg_brk(562, 716, 216, "15-16");
dg_keyc(420, 228, slider1 == 2, DV_RED, "HARMONICS", "") ? dg_set(1, slider1 == 2 ? 0 : 2);
dg_keyc(505, 228, slider3 == 2, DV_BLU, "PARALLEL", "LIMIT") ? dg_set(3, slider3 == 2 ? 0 : 2);
dg_keyc(600, 228, slider1 == 3, DV_RED, "HARMONICS", "") ? dg_set(1, slider1 == 3 ? 0 : 3);
dg_keyc(685, 228, slider3 == 3, DV_BLU, "PARALLEL", "LIMIT") ? dg_set(3, slider3 == 3 ? 0 : 3);
dg_brk(384, 716, 318, "EFFECTS");

// ---------- DRIFT ----------
strcpy(#dg_n0, "0"); strcpy(#dg_n1, "100");
dg_knob(276, 262, 17, 9, 0, 100, 50, 0, "DRIFT", 1);
dg_act ? ( sprintf(#dv_s, "%.0f%%", slider9); dg_pill(276, 297, #dv_s); );

// ---------- the colour section ----------
ui_cola(DV_DIM, 0.35); dg_r(728, 64, 1, 262); dg_r(1048, 64, 1, 262);
strcpy(#dg_nm, "BLEND"); strcpy(#dg_n0, "0"); strcpy(#dg_n1, "10");
dg_knob(782, 120, 25, 2, 0, 100, 50, 0, "HARMONICS", 1);
dg_act ? ( sprintf(#dv_s, "%.0f%%", slider2); dg_pill(782, 163, #dv_s); );
strcpy(#dg_nm, "BLEND"); strcpy(#dg_n0, "0"); strcpy(#dg_n1, "10");
dg_knob(892, 120, 25, 4, 0, 100, 50, 0, "PARALLEL LIMIT", 1);
dg_act ? ( sprintf(#dv_s, "%.0f%%", slider4); dg_pill(892, 163, #dv_s); );
strcpy(#dg_nm, "CORE"); strcpy(#dg_n0, "0"); strcpy(#dg_n1, "10");
dg_knob(990, 120, 25, 7, 0, 100, 30, 0, "IRON", 1);
dg_act ? ( sprintf(#dv_s, "%.0f%%", slider7); dg_pill(990, 163, #dv_s); );
// MIX BUSS
dg_keyc(776, 228, slider1 == 1, DV_RED, "HARMONICS", "") ? dg_set(1, slider1 == 1 ? 0 : 1);
dg_keyc(848, 228, slider5 >= 0.5, DV_GRN, "FLIP", "") ? dg_set(5, slider5 >= 0.5 ? 0 : 1);
dg_keyc(920, 228, slider3 == 1, DV_BLU, "PARALLEL", "LIMIT") ? dg_set(3, slider3 == 1 ? 0 : 1);
dg_keyc(1004, 228, slider6 >= 0.5, DV_AMB, "IRON", "") ? dg_set(6, slider6 >= 0.5 ? 0 : 1);
// the limiter's gain-reduction LED (glows with the reduction, wherever the limiter is)
dv_g = d2_gra; d2_gra = 1;
dv_gr = dv_g < dv_gr ? dv_g : dv_gr + (dv_g - dv_gr) * 0.12;
dg_led(962, 245, 3.5, dv_gr < 0.97 ? min(1, (1 - dv_gr) * 2.5 + 0.2) : 0, DV_RED);
dg_brk(744, 1032, 318, "MIX BUSS");

// ---------- OUTPUT LEVEL TRIM ----------
gfx_setfont(11); ui_col(DV_INK); dg_tc(1118, 66, "OUTPUT LEVEL"); dg_tc(1118, 81, "TRIM");
strcpy(#dg_n0, "-3"); strcpy(#dg_n1, "+3"); dg_nt = 13;
dg_knob(1118, 170, 36, 8, -3, 3, 0, 0, "", 0.5);
gfx_setfont(13); ui_cola(DV_INK, 0.85); dg_tc(1118, 118, "0");
dg_act ? ( sprintf(#dv_s, "%+.1f dB", slider8); dg_pill(1118, 232, #dv_s); );

pk_end();
ui_end();
