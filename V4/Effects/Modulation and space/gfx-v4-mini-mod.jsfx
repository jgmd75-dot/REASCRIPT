mm_cfk < 0.0001 && !mm_cfkt ? ( cfL.mm_svz(); cfR.mm_svz(); );
mm_pfk < 0.0001 && !mm_pfkt ? ( pfL.mm_svz(); pfR.mm_svz(); );
mm_ffk < 0.0001 && !mm_ffkt ? ( ffL.mm_svz(); ffR.mm_svz(); );
