desc:Mini Mod [modulation] (GFX V4)
//tags: modulation chorus phaser flanger envelope filter auto-wah v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-output, gfx-v4-drift, gfx-v4-ui, gfx-v4-panel, gfx-v4-os, gfx-v4-bypass, gfx-v4-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,1,1{Off,On}>-Chorus in
slider3:0.513<0.01,10,0.001>-Chorus rate (Hz)
slider4:50<0,100,1>-Chorus depth (%)
slider5:0<0,2,1{I,II,I+II}>-Chorus mode
slider6:0<0,1,1{Off,On}>-Chorus sat
slider7:0<0,1,1{Off,On}>-Chorus filter
slider8:50<0,100,1>-Chorus mix (%)
slider9:0<0,1,1{Off,On}>-Phaser in
slider10:0.3<0.01,10,0.01>-Phaser rate (Hz)
slider11:70<0,100,1>-Phaser depth (%)
slider12:0<0,2,1{4,8,12}>-Phaser stages
slider13:0<0,1,1{Off,On}>-Phaser feedback
slider14:0<0,1,1{Off,On}>-Phaser filter
slider15:50<0,100,1>-Phaser mix (%)
slider16:0<0,1,1{Off,On}>-Flanger in
slider17:0.15<0.01,10,0.01>-Flanger rate (Hz)
slider18:60<0,100,1>-Flanger depth (%)
slider19:1<0,2,1{Sine,Triangle,Envelope}>-Flanger sweep
slider20:0<0,1,1{Off,On}>-Flanger jet
slider21:0<0,1,1{Off,On}>-Flanger filter
slider22:50<0,100,1>-Flanger mix (%)
slider23:0<0,1,1{Chorus first,Flanger first}>-Order
slider24:0<0,1,1{LP,BP}>-Filter type
slider25:50<0,100,1>-Filter sens (%)
slider26:30<0,100,1>-Filter attack (%)
slider27:40<0,100,1>-Filter resonance (%)
slider28:50<0,100,1>-Drift (%)
slider29:0<0,2,1{1x,2x,4x}>-Oversampling
slider30:40<0,95,1>-Flanger feedback (%)
slider31:0<-100,100,1>-Phaser pan / trem (%)
slider32:100<0,200,1>-Chorus width (%)
slider33:prs_sel=0<0,9,1{No preset,Init,Silk Ensemble,Dark Bucket,Slow Phase,Resonant Phase,Jet Flange,Envelope Flange,Funk Chorus,Through the Filter}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-output.jsfx-inc
import gfx-v4-drift.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-power.jsfx-inc

@init
#ui_man = "gfx-v4-mini-mod";
ext_noinit = 1;

function mm_tcf(ms, fs) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * fs)); );
function mm_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );
function mm_th(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function mm_sat(x) local(a) ( a = abs(x); a < 0.7 ? x : sign(x) * (0.7 + 0.3 * mm_th((a - 0.7) / 0.3)); );

DLN = 65536; DLM = 65535;
B_CHL = 1048576; B_CHR = B_CHL + DLN; B_FLL = B_CHR + DLN; B_FLR = B_FLL + DLN;
APS = 1400000;
function mm_rd(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = mm_wp - d; rp < 0 ? rp += DLN;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i - 1) & DLM]; x0 = buf[i & DLM]; x1 = buf[(i + 1) & DLM]; x2 = buf[(i + 2) & DLM];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f + 0.5 * (x1 - xm1)) * f + x0);
);

function mm_svf(x) instance(s1, s2) local(v1, v2, v3) (
  v3 = x - s2;
  v1 = mm_a1 * s1 + mm_a2 * v3;
  v2 = s2 + mm_a2 * s1 + mm_a3 * v3;
  s1 = 2 * v1 - s1; s2 = 2 * v2 - s2;
  mm_sat(v2 * mm_lpg * (1 - mm_ft) + v1 * mm_bpg * mm_ft);
);
function mm_svz() instance(s1, s2) ( s1 = s2 = 0; );

function mm_bbd(x) instance(dx, dy) local(u, e) (
  u = (mm_th(2.5 * x + 0.12) - mm_t12) * mm_bbn;
  e = u - dx + mm_dc5 * dy; dx = u; dy = e; e;
);
function mm_bbz() instance(dx, dy) ( dx = dy = 0; );
function mm_cho(l, r) local(wl, wr, a, b) (
  wl = l; wr = r;
  mm_csa > 0.0001 ? ( wl += mm_csa * (sbL.mm_bbd(l) - l); wr += mm_csa * (sbR.mm_bbd(r) - r); );
  B_CHL[mm_wp] = wl; B_CHR[mm_wp] = wr;
  mm_cin > 0.0001 || mm_cint ? (
    a = mm_cga * mm_rd(B_CHL, mm_dAL) + mm_cgb * mm_rd(B_CHL, mm_dBL);
    b = mm_cga * mm_rd(B_CHR, mm_dAR) + mm_cgb * mm_rd(B_CHR, mm_dBR);
    a = mm_th(a * 1.15) / 1.15; b = mm_th(b * 1.15) / 1.15;
    wl = (mm_cga + mm_cgb) * 0.5 * (mm_rd(B_CHL, (3.5 + mm_wob) * mm_spm) - mm_rd(B_CHR, (3.5 + mm_wob) * mm_spm));
    wr = (a - b) * 0.5; wr = wl + (wr - wl) * mm_cw; wl = (a + b) * 0.5; a = wl + wr; b = wl - wr;
    mm_c1l += (a - mm_c1l) * mm_clk; mm_c2l += (mm_c1l - mm_c2l) * mm_clk; a = mm_c2l;
    mm_c1r += (b - mm_c1r) * mm_clk; mm_c2r += (mm_c1r - mm_c2r) * mm_clk; b = mm_c2r;
    mm_cfk > 0.0001 ? ( a += mm_cfk * (cfL.mm_svf(a) - a); b += mm_cfk * (cfR.mm_svf(b) - b); );
    a = (l + mm_cmx * (a - l)) * mm_cmg; b = (r + mm_cmx * (b - r)) * mm_cmg;
    mm_ol = l + mm_cin * (a - l); mm_or = r + mm_cin * (b - r);
  ) : ( mm_ol = l; mm_or = r; );
);

function mm_apc(x, base, a) local(i, y) (
  i = 0;
  loop(12,
    y = a * x + base[i]; base[i] = x - a * y; x = y;
    i == 3 ? mm_t4 = x : i == 7 ? mm_t8 = x;
    i += 1;
  );
  mm_w4 * mm_t4 + mm_w8 * mm_t8 + mm_w12 * x;
);
function mm_pha(l, r) local(a, b) (
  mm_pin > 0.0001 || mm_pint ? (
    a = mm_apc(l + mm_pfb * mm_pzl, APS, mm_pal); mm_pzl = mm_sat(a);
    b = mm_apc(r + mm_pfb * mm_pzr, APS + 12, mm_par); mm_pzr = mm_sat(b);
    a *= mm_pfc; b *= mm_pfc;
    mm_pfk > 0.0001 ? ( a += mm_pfk * (pfL.mm_svf(a) - a); b += mm_pfk * (pfR.mm_svf(b) - b); );
    a *= mm_ptl; b *= mm_ptr;
    a = (l + mm_pmx * (a - l)) * mm_pmg; b = (r + mm_pmx * (b - r)) * mm_pmg;
    mm_ol = l + mm_pin * (a - l); mm_or = r + mm_pin * (b - r);
  ) : ( mm_ol = l; mm_or = r; );
);

function mm_flg(l, r) local(a, b) (
  mm_fin > 0.0001 || mm_fint ? (
    B_FLL[mm_wp] = l + mm_ffb * mm_fzl; B_FLR[mm_wp] = r + mm_ffb * mm_fzr;
    a = mm_rd(B_FLL, mm_fdl); b = mm_rd(B_FLR, mm_fdr);
    mm_f1l += (a - mm_f1l) * mm_flk; mm_f1r += (b - mm_f1r) * mm_flk;
    mm_fzl = mm_sat(mm_f1l); mm_fzr = mm_sat(mm_f1r);
    a = mm_f1l * mm_ffc; b = mm_f1r * mm_ffc;
    mm_ffk > 0.0001 ? ( a += mm_ffk * (ffL.mm_svf(a) - a); b += mm_ffk * (ffR.mm_svf(b) - b); );
    a = (l + mm_fmx * (a - l)) * mm_fmg; b = (r + mm_fmx * (b - r)) * mm_fmg;
    mm_ol = l + mm_fin * (a - l); mm_or = r + mm_fin * (b - r);
  ) : ( B_FLL[mm_wp] = l; B_FLR[mm_wp] = r; mm_fzl = mm_fzr = 0; mm_ol = l; mm_or = r; );
);

function mm_chain(l, r) local(xl, xr) (
  xl = l; xr = r;
  mm_ord ? (
    mm_flg(l, r); mm_pha(mm_ol, mm_or); mm_cho(mm_ol, mm_or);
  ) : (
    mm_cho(l, r); mm_pha(mm_ol, mm_or); mm_flg(mm_ol, mm_or);
  );
  mm_pl = xl + mm_dk * (mm_ol - xl); mm_pr = xr + mm_dk * (mm_or - xr);
  mm_wp = (mm_wp + 1) & DLM;
);
function mm_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  memset(B_CHL, 0, 4 * DLN); memset(APS, 0, 24);
  sbL.mm_bbz(); sbR.mm_bbz();
  cfL.mm_svz(); cfR.mm_svz(); pfL.mm_svz(); pfR.mm_svz(); ffL.mm_svz(); ffR.mm_svz();
  mm_c1l = mm_c2l = mm_c1r = mm_c2r = 0; mm_pzl = mm_pzr = 0; mm_fzl = mm_fzr = mm_f1l = mm_f1r = 0;
);
function mm_reset() ( mm_clear(); memset(BY_BUF, 0, 2 * BY_N); mm_fi = -2; );

PT = 6000000;
#mm_pm = "Init|Silk Ensemble|Dark Bucket|Slow Phase|Resonant Phase|Jet Flange|Envelope Flange|Funk Chorus|Through the Filter";
function mm_w13(a, b, c, d, e, f, g, h, i, j, k, m, n) (
  mm_wq[0] = a; mm_wq[1] = b; mm_wq[2] = c; mm_wq[3] = d; mm_wq[4] = e; mm_wq[5] = f; mm_wq[6] = g;
  mm_wq[7] = h; mm_wq[8] = i; mm_wq[9] = j; mm_wq[10] = k; mm_wq[11] = m; mm_wq[12] = n; mm_wq += 13;
);
mm_wq = PT;
mm_w13(1, 0.513, 50, 0, 0, 0, 50,  0, 0.3,  70, 0, 0, 0);  mm_w13(50,   0, 0.15, 60, 1, 0, 0, 50,   0,   0, 50, 30, 40);
mm_w13(1, 0.62, 55, 2, 0, 0, 55,   0, 0.3,  70, 0, 0, 0);  mm_w13(50,   0, 0.15, 60, 1, 0, 0, 50,   0,   0, 50, 30, 40);
mm_w13(1, 0.9,  65, 1, 1, 0, 50,   0, 0.3,  70, 0, 0, 0);  mm_w13(50,   0, 0.15, 60, 1, 0, 0, 50,   0,   0, 50, 30, 40);
mm_w13(0, 0.5,  50, 0, 0, 0, 50,   1, 0.12, 80, 0, 0, 0);  mm_w13(50,   0, 0.15, 60, 1, 0, 0, 50,   0,   0, 50, 30, 40);
mm_w13(0, 0.5,  50, 0, 0, 0, 50,   1, 0.45, 75, 1, 1, 0);  mm_w13(50,   0, 0.15, 60, 1, 0, 0, 50,   0,   0, 50, 30, 40);
mm_w13(0, 0.5,  50, 0, 0, 0, 50,   0, 0.3,  70, 0, 0, 0);  mm_w13(50,   1, 0.08, 80, 1, 1, 0, 50,   0,   0, 50, 30, 40);
mm_w13(0, 0.5,  50, 0, 0, 0, 50,   0, 0.3,  70, 0, 0, 0);  mm_w13(50,   1, 0.2,  70, 2, 1, 0, 50,   0,   0, 60, 15, 40);
mm_w13(1, 0.7,  60, 0, 0, 1, 70,   0, 0.3,  70, 0, 0, 0);  mm_w13(50,   0, 0.15, 60, 1, 0, 0, 50,   0,   1, 65, 10, 55);
mm_w13(0, 0.5,  50, 0, 0, 0, 50,   1, 0.25, 70, 2, 1, 1);  mm_w13(60,   1, 0.1,  50, 1, 0, 0, 40,   0,   0, 55, 30, 45);
function load_preset(p) local(i, q) (
  q = PT + (p >= 10 ? 0 : p - 1) * 26;
  i = 0; loop(26, slider(2 + i) = q[i]; i += 1; );
  p >= 10 ? slider28 = 50;
  slider30 = p == 6 ? 45 : p == 9 ? 30 : 40;
  slider31 = p == 4 ? -40 : 0;
  slider32 = p == 2 ? 150 : 100;
  i = 2; loop(27, ui_auto(i); i += 1; ); ui_auto(30); ui_auto(31); ui_auto(32);
  pr_cur = p >= 10 ? 1 : p;
);

function mm_coef() (
  mm_fs = srate * os_f;
  mm_dc5 = 1 - 2 * $pi * 5 / mm_fs;
  mm_flk = mm_opk(12000, mm_fs);
  mm_spm = mm_fs / 1000;
);
function mm_srinit() (
  mm_sr = srate;
  c_kn = mm_tcf(30, srate);
  c_sw = mm_tcf(15, srate);
  c_dl = mm_tcf(60, srate);
  mm_fis = 1 / (0.01 * srate);
  mm_dks = 1 / (0.006 * srate);
  ost_init(0);
  mm_coef(); mm_clear();
  mm_snap = 1;
);
os_design();
os_f = os_tf = os_f2n(slider29); os_base = 0;
mm_srinit();
os_gsetup();
pwr_init(); pwr_wu_loss = 0.3; pwr_wu_drv = 0.5; pwr_wu_lp = 12000; pwr_bloom = 0;
dRt.drift_init(0.8 + rand(1) * 0.4); dClk.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
mm_t12 = mm_th(0.12); mm_bbn = 1 / (2.5 * (1 - mm_t12 * mm_t12));
mm_dk = 1; mm_fi = 1;
mm_cp1 = 0; mm_pp = 0; mm_fp = 0;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(32, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(29));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != mm_sr ? mm_srinit();
mm_now = time_precise();
mm_tp > 0 && mm_now - mm_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > mm_gpp && play_position - mm_gpp < 4 * mm_gpd + 0.05) ? mm_reset();
mm_tp = mm_now; mm_gpp = play_position; mm_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
mm_bst += (0.3 * mm_pdpt * mm_pint - mm_bst) * min(1, 3 * samplesblock / srate / 0.03);
ost_setup(mm_bst, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider29); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider28);
mm_n = samplesblock / srate;
mm_vr = dRt.drift_tick(0.05 * dm_s * mm_n); mm_vc = dClk.drift_tick(0.07 * dm_s * mm_n);
mm_rdf = 1 + 0.04 * dm_a * mm_vr; mm_wobt = 0.12 * dm_a * mm_vc;
mm_cint = slider2 >= 0.5;
mm_crt = log(min(max(slider3, 0.01), 10));
mm_cdpt = 3.7 * min(max(slider4, 0), 100) / 100;
mm_cmd = slider5 >= 1.5 ? 2 : slider5 >= 0.5 ? 1 : 0;
mm_cgat = mm_cmd == 2 ? 0.6 : 1; mm_cgbt = mm_cmd == 2 ? 0.6 : 0;
mm_cmrt = mm_cmd == 1 ? 1.682 : 1;
mm_csat = slider6 >= 0.5;
mm_cfkt = slider7 >= 0.5;
mm_cmxt = min(max(slider8, 0), 100) / 100;
mm_cwt = min(max(slider32, 0), 200) / 100;
mm_clkt = log(mm_csat ? 6600 : 8700);
mm_pint = slider9 >= 0.5;
mm_prt = log(min(max(slider10, 0.01), 10));
mm_pdpt = min(max(slider11, 0), 100) / 100;
mm_ptt = min(max(slider31, -100), 100) / 100;
mm_pst = slider12 >= 1.5 ? 2 : slider12 >= 0.5 ? 1 : 0;
mm_w4t = mm_pst == 0; mm_w8t = mm_pst == 1; mm_w12t = mm_pst == 2;
mm_pfbt = slider13 >= 0.5 ? 0.62 : 0;
mm_pfkt = slider14 >= 0.5;
mm_pmxt = min(max(slider15, 0), 100) / 100;
mm_fint = slider16 >= 0.5;
mm_frt = log(min(max(slider17, 0.01), 10));
mm_fdpt = min(max(slider18, 0), 100) / 100;
mm_fsw = slider19 >= 1.5 ? 2 : slider19 >= 0.5 ? 1 : 0;
mm_wst = mm_fsw == 0; mm_wtt = mm_fsw == 1; mm_wet = mm_fsw == 2;
mm_ffbt = min(min(max(slider30, 0), 95) / 100 * (slider20 >= 0.5 ? 2 : 1), 0.95);
mm_ffkt = slider21 >= 0.5;
mm_fmxt = min(max(slider22, 0), 100) / 100;
mm_ordt = slider23 >= 0.5;
mm_ftt = slider24 >= 0.5;
mm_eth = -6 - 44 * min(max(slider25, 0), 100) / 100;
mm_eat = 1 + 119 * (min(max(slider26, 0), 100) / 100) ^ 2;
mm_ea = mm_tcf(mm_eat, srate); mm_er = mm_tcf(60 + 3 * mm_eat, srate);
mm_qt = 0.6 * 20 ^ (min(max(slider27, 0), 100) / 100);
mm_snap ? (
  mm_cin = mm_cint; mm_cr = mm_crt; mm_cdp = mm_cdpt; mm_cga = mm_cgat; mm_cmr = mm_cmrt; mm_cgb = mm_cgbt; mm_csa = mm_csat; mm_cfk = mm_cfkt; mm_cmx = mm_cmxt; mm_cw = mm_cwt; mm_clf = mm_clkt;
  mm_pin = mm_pint; mm_pt = mm_ptt; mm_ptl = mm_ptr = 1; mm_pr = mm_prt; mm_pdp = mm_pdpt; mm_w4 = mm_w4t; mm_w8 = mm_w8t; mm_w12 = mm_w12t; mm_pfb = mm_pfbt; mm_pfk = mm_pfkt; mm_pmx = mm_pmxt;
  mm_fin = mm_fint; mm_fr = mm_frt; mm_fdp = mm_fdpt; mm_ws = mm_wst; mm_wt = mm_wtt; mm_we = mm_wet; mm_ffb = mm_ffbt; mm_ffk = mm_ffkt; mm_fmx = mm_fmxt;
  mm_ord = mm_ordt; mm_ft = mm_ftt; mm_q = mm_qt; mm_wob = mm_wobt;
);
mm_snap = 0;
mm_anyf = mm_cfkt || mm_pfkt || mm_ffkt || mm_cfk > 0.0001 || mm_pfk > 0.0001 || mm_ffk > 0.0001;

mm_vu_d = max(mm_vu_d, sqrt(mm_ms / max(samplesblock, 1))); mm_ms = 0;
mm_eu_d = max(mm_eu_d, mm_eum); mm_eum = 0;
os_snapb(slider(29));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
mm_xl = spl0; mm_xr = spl1;
mm_cin += (mm_cint - mm_cin) * c_sw; mm_pin += (mm_pint - mm_pin) * c_sw; mm_fin += (mm_fint - mm_fin) * c_sw;
mm_cr += (mm_crt - mm_cr) * c_kn; mm_pr += (mm_prt - mm_pr) * c_kn; mm_fr += (mm_frt - mm_fr) * c_kn;
mm_cdp += (mm_cdpt - mm_cdp) * c_dl; mm_pdp += (mm_pdpt - mm_pdp) * c_kn; mm_fdp += (mm_fdpt - mm_fdp) * c_dl;
mm_cga += (mm_cgat - mm_cga) * c_kn; mm_cmr += (mm_cmrt - mm_cmr) * c_kn; mm_cgb += (mm_cgbt - mm_cgb) * c_kn;
mm_csa += (mm_csat - mm_csa) * c_sw; mm_clf += (mm_clkt - mm_clf) * c_kn;
mm_cfk += (mm_cfkt - mm_cfk) * c_sw; mm_pfk += (mm_pfkt - mm_pfk) * c_sw; mm_ffk += (mm_ffkt - mm_ffk) * c_sw;
mm_cmx += (mm_cmxt - mm_cmx) * c_kn; mm_cw += (mm_cwt - mm_cw) * c_kn; mm_pmx += (mm_pmxt - mm_pmx) * c_kn; mm_fmx += (mm_fmxt - mm_fmx) * c_kn;
mm_w4 += (mm_w4t - mm_w4) * c_kn; mm_w8 += (mm_w8t - mm_w8) * c_kn; mm_w12 += (mm_w12t - mm_w12) * c_kn;
mm_pfb += (mm_pfbt - mm_pfb) * c_kn; mm_ffb += (mm_ffbt - mm_ffb) * c_kn;
mm_ws += (mm_wst - mm_ws) * c_dl; mm_wt += (mm_wtt - mm_wt) * c_dl; mm_we += (mm_wet - mm_we) * c_dl;
mm_ft += (mm_ftt - mm_ft) * c_sw; mm_q += (mm_qt - mm_q) * c_kn; mm_wob += (mm_wobt - mm_wob) * c_dl;
mm_cmg = (1 - 2 * mm_cmx + 2 * mm_cmx * mm_cmx) ^ -0.35; mm_fmg = (1 - 2 * mm_fmx + 2 * mm_fmx * mm_fmx) ^ -0.35;
mm_pmg = (1 - 2 * mm_pmx + 2 * mm_pmx * mm_pmx) ^ -0.35;
mm_ordt != mm_ord ? ( mm_dk = max(mm_dk - mm_dks, 0); mm_dk == 0 ? mm_ord = mm_ordt; ) : mm_dk = min(mm_dk + mm_dks, 1);
mm_lv = max(abs(mm_xl), abs(mm_xr));
mm_env += (mm_lv - mm_env) * (mm_lv > mm_env ? mm_ea : mm_er);
mm_env < 0.0000001 ? mm_env = 0;
mm_eu = min(max((20 * log10(mm_env + 0.0000001) - mm_eth) / 30, 0), 1);
mm_eum = max(mm_eum, mm_eu);
