  mm_dBL = max(4.3 - mm_wob + mm_cdp * mm_tB, 0.3) * mm_spm; mm_dBR = max(4.3 - mm_wob - mm_cdp * mm_tB, 0.3) * mm_spm;
  mm_clk = mm_opk(exp(mm_clf), mm_fs);
);
mm_pp += exp(mm_pr) * mm_rdf / srate; mm_pp >= 1 ? mm_pp -= 1;
mm_pin > 0.0001 || mm_pint ? (
  mm_fc = min(550 * 2 ^ (2.5 * mm_pdp * sin(2 * $pi * mm_pp)), 0.45 * mm_fs); mm_t = tan($pi * mm_fc / mm_fs); mm_pal = (mm_t - 1) / (mm_t + 1);
  mm_fc = min(550 * 2 ^ (2.5 * mm_pdp * cos(2 * $pi * mm_pp)), 0.45 * mm_fs); mm_t = tan($pi * mm_fc / mm_fs); mm_par = (mm_t - 1) / (mm_t + 1);
  mm_pfc = 1 - 0.15 * mm_pfb;
  mm_pt += (mm_ptt - mm_pt) * c_kn; mm_s = sin(2 * $pi * mm_pp);
