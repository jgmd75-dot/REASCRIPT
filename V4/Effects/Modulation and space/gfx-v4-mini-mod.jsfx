mm_cp1 += mm_ci; mm_cp1 >= 1 ? mm_cp1 -= 1;
mm_cin > 0.0001 || mm_cint ? (
  mm_tA = 4 * abs(mm_cp1 - 0.5) - 1; mm_tB = -mm_tA;
