desc:Filtron [multi filter] (GFX V4)
//tags: filter multi-filter lfo envelope motion drive v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-power, gfx-v4-output, gfx-v4-clip, gfx-v4-lfo, gfx-v4-os, gfx-v4-bypass, gfx-v4-thick, gfx-v4-ui, gfx-v4-panel, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider35:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:trim_db=0<-24,12,0.1>-Trim (dB)
slider2:hot=1<0,1,1{Off,On}>-Hot
slider3:thick=1<0,1,1{Off,On}>-Thick
slider4:f1_on=1<0,1,1{Off,On}>-Filter 1 in
slider5:f1_typ=0<0,5,1{LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 1 type
slider6:f1_cut=2200<20,20000,1:log>-Filter 1 cutoff (Hz)
slider7:f1_res=30<0,100,0.1>-Filter 1 resonance (%)
slider8:f1_env=0<-4,4,0.01>-Filter 1 envelope (oct)
slider9:f1_lfo=0<-4,4,0.01>-Filter 1 LFO (oct)
slider10:lf_shp=0<0,3,1{Sine,Triangle,Square,Random}>-LFO shape
slider11:lf_hz=1<0.01,20,0.01:log>-LFO rate (Hz)
slider12:lf_div=8<0,17,1{16 Bars,8 Bars,4 Bars,2 Bars,1 Bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-LFO rate (sync)
slider13:lf_syn=1<0,1,1{Off,On}>-LFO sync
slider14:f2_on=1<0,1,1{Off,On}>-Filter 2 in
slider15:f2_typ=3<0,5,1{LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 2 type
slider16:f2_cut=110<20,20000,1:log>-Filter 2 cutoff (Hz)
slider17:f2_res=20<0,100,0.1>-Filter 2 resonance (%)
slider18:f2_env=0<-4,4,0.01>-Filter 2 envelope (oct)
slider19:mo_hz=0.33<0.01,20,0.01:log>-Motion rate (Hz)
slider20:mo_div=4<0,17,1{16 Bars,8 Bars,4 Bars,2 Bars,1 Bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Motion rate (sync)
slider21:mo_dep=0<0,4,0.01>-Motion depth (oct)
slider22:mo_syn=1<0,1,1{Off,On}>-Motion sync
slider23:blend=0<0,100,0.1>-Blend (series to parallel, %)
slider24:ph_amt=0<0,100,0.1>-Phase (%)
slider25:mix_pc=100<0,100,0.1>-Mix (%)
slider26:out_db=0<-12,12,0.1>-Output (dB)
slider27:byp=0<0,1,1{Off,On}>-Bypass
slider28:os_sel=1<0,2,1{1x,2x,4x}>-Oversampling
slider29:f1_chr=4<0,4,1{Clean,Squish,Ladder,Butterworth,Chebyshev}>-Filter 1 character
slider30:f2_chr=3<0,4,1{Clean,Squish,Ladder,Butterworth,Chebyshev}>-Filter 2 character
slider31:fl_drv=0<0,24,0.1>-Drive (dB)
slider32:mod_dep=100<0,100,0.1>-Modulation amount (%)
slider33:st_off=0<0,50,0.1>-Stereo offset (%)
slider34:prs_sel=0<0,11,1{No preset,Init,Quarter Pump,Slow Bloom,Band Pluck,Random Steps,Twin Peaks,Lo-Fi Radio,Eighth Chop,Deep Drift,Jet Sweep,Cheby Glide}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-power.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-clip.jsfx-inc
import gfx-v4-lfo.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-thick.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(1125899906842623, v); );
function psw_allg(v) ( slider_show(1125899906842623, v); );
#ui_man = "gfx-v4-filtron";
#fl_pm = "Init|Quarter Pump|Slow Bloom|Band Pluck|Random Steps|Twin Peaks|Lo-Fi Radio|Eighth Chop|Deep Drift|Jet Sweep|Cheby Glide";
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
rs_f = 1;
ext_noinit = 1;
ost_init(0);
pwr_init();
thk_init(); thk_lift = 3; thk_drv = 1.5; thk_asym = 0.12; thk_tr = 1.2; thk_trim = 0;

CF = 0;
SB = 100;
DLB = 512;
memset(CF, 0, 32);  memset(SB, 0, 16);  memset(DLB, 0, 128);
CRV = 1000; CSZ = 64; NMAX = 16; CLP = 1100; LUT = 2000; LN = 1024;
PHS = 160; ST = 200; CQ = 300; PRT = 400; PRG = 420; PRN = 424;
memset(PHS, 0, 40); memset(ST, 0, 32); memset(CQ, 0, 64); memset(PRT, 0, 32);
PRN[0] = PRN[1] = 2; PRG[0] = PRG[1] = 1;

function shape_au(u, t) ( t >= 0 ? u ^ (1 + 4 * t) : 1 - (1 - u) ^ (1 - 4 * t); );
function cv_eval_au(p) local(b, n, i, x0, x1, u) (
  b = CRV; n = b[0]; i = 0;
  while (i < n - 2 && p > b[1 + (i + 1) * 3]) ( i += 1; );
  x0 = b[1 + i * 3]; x1 = b[1 + (i + 1) * 3];
  u = x1 > x0 ? min(max((p - x0) / (x1 - x0), 0), 1) : 0;
  b[2 + i * 3] + (b[2 + (i + 1) * 3] - b[2 + i * 3]) * shape_au(u, b[3 + i * 3]);
);
function build_lut_au() local(i) ( i = 0; loop(LN + 1, LUT[i] = cv_eval_au(i / LN); i += 1; ); );
function cv_read(p) local(x, i) ( x = p * LN; i = floor(x); LUT[i] + (LUT[i + 1] - LUT[i]) * (x - i); );
function cv_set_au(n, x0, y0, t0, x1, y1, t1, x2, y2, t2, x3, y3, t3, x4, y4, t4) (
  CRV[0] = n;
  CRV[1] = x0; CRV[2] = y0; CRV[3] = t0; CRV[4] = x1; CRV[5] = y1; CRV[6] = t1; CRV[7] = x2; CRV[8] = y2; CRV[9] = t2;
  CRV[10] = x3; CRV[11] = y3; CRV[12] = t3; CRV[13] = x4; CRV[14] = y4; CRV[15] = t4;
  build_lut_au();
);
function cv_dflt_au() ( cv_set_au(3, 0, 0, -0.5, 0.5, 1, 0.5, 1, 0, 0, 0, 0, 0, 0, 0, 0); );
!crv_init ? ( crv_init = 1; cv_dflt_au(); );

function db2g(d) ( exp(d * 0.11512925464970228); );

function sv_coef(i, fc, r, km) local(c, g, k) (
  c = CF + i * 8;
  g = tan($pi * min(max(fc, 20), srate * 0.45) / srate);
  k = 2 - km * r;
  c[0] = 1 / (1 + g * (g + k));  c[1] = g * c[0];  c[2] = g * c[1];  c[3] = k;
  c[4] = 1 / (1 + g * (g + 1.41421356));  c[5] = g * c[4];  c[6] = g * c[5];
);
function sv_run(x, t, i, s) local(c, y, v1, v2, v3) (
  c = CF + i * 8;  y = x;
  (t == 2 || t == 4) ? (
    v3 = y - s[3];  v1 = c[4] * s[2] + c[5] * v3;  v2 = s[3] + c[5] * s[2] + c[6] * v3;
    s[2] = 2 * v1 - s[2];  s[3] = 2 * v2 - s[3];
    y = t == 2 ? v2 : y - 1.41421356 * v1 - v2;
  );
  v3 = y - s[1];  v1 = c[0] * s[0] + c[1] * v3;  v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
  t <= 2 ? v2 : t <= 4 ? y - c[3] * v1 - v2 : t == 5 ? c[3] * v1 : y - c[3] * v1;
);

function fl_th(x) ( x > 3 ? 1 : x < -3 ? -1 : x * (27 + x * x) / (27 + 9 * x * x); );

function sq_run(x, t, i, s) local(c, q, y, v1, v2, v3, g) (
  c = CF + i * 8;  q = CQ + i * 16;  y = x;  g = q[0];
  v3 = y - s[1];  v1 = c[0] * s[0] + c[1] * v3;
  v1 = fl_th(v1 * 1.4) * 0.7142857;
  v2 = s[1] + g * v1;
  s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
  y = t <= 2 ? v2 * q[1] : t <= 4 ? y - c[3] * v1 - v2 : t == 5 ? q[2] * v1 : y - c[3] * v1;
  (t == 2 || t == 4) ? (
    v3 = y - s[3];  v1 = c[4] * s[2] + c[5] * v3;  v2 = s[3] + c[5] * s[2] + c[6] * v3;
    s[2] = 2 * v1 - s[2];  s[3] = 2 * v2 - s[3];
    y = t == 2 ? v2 : y - 1.41421356 * v1 - v2;
  );
  y;
);

function ld_run(x, t, i, s) local(c, gg, k, a, b0, b1, b2, b3, u, v, y1, y2, y3, y4) (
  c = CF + i * 8;  gg = c[7];  k = c[3];  a = 1 - gg;
  b0 = a * s[0];  b1 = a * s[1];  b2 = a * s[2];  b3 = a * s[3];
  u = (x - k * (gg * gg * gg * b0 + gg * gg * b1 + gg * b2 + b3)) / (1 + k * gg * gg * gg * gg);
  u = fl_th(u * 1.5) * 0.6666667;
  v = (u - s[0]) * gg;  y1 = v + s[0];  s[0] = y1 + v;
  v = (y1 - s[1]) * gg; y2 = v + s[1];  s[1] = y2 + v;
  v = (y2 - s[2]) * gg; y3 = v + s[2];  s[2] = y3 + v;
  v = (y3 - s[3]) * gg; y4 = v + s[3];  s[3] = y4 + v;
  t == 1 ? y2 * (1 + 0.6 * k) : t == 2 ? y4 * (1 + 0.6 * k) : t == 3 ? u - 2 * y1 + y2 :
  t == 4 ? u - 4 * y1 + 6 * y2 - 4 * y3 + y4 : t == 5 ? 2 * (y1 - y2) : u - 2 * y1 + 2 * y2;
);

function pr_make(f, t, ch, r) local(p, n, j, ph, e, v, sh, chh, sg, om, w, q) (
  p = PRT + f * 8;
  n = (t == 2 || t == 4) ? 4 : 2;
  t >= 5 ? (
    j = 0; loop(2, p[j * 2] = ch == 4 ? (j ? 1.07 : 0.935) : 1; p[j * 2 + 1] = 2 - 1.85 * r; j += 1; );
    n = 2;  PRG[f] = 1;
  ) : ch == 3 ? (
    j = 0; loop(n, ph = (2 * j + 1) * $pi / (4 * n); p[j * 2] = 1; q = 1 / (2 * sin(ph)); j == 0 ? q *= 1 + 12 * r * r; p[j * 2 + 1] = 1 / q; j += 1; );
    PRG[f] = 1;
  ) : (
    e = sqrt(10 ^ ((0.2 + 5.8 * r) / 10) - 1);
    v = log(1 / e + sqrt(1 / (e * e) + 1)) / (2 * n);
    sh = 0.5 * (exp(v) - exp(-v));  chh = 0.5 * (exp(v) + exp(-v));
    j = 0; loop(n, ph = (2 * j + 1) * $pi / (4 * n);
      sg = sh * sin(ph); om = chh * cos(ph); w = sqrt(sg * sg + om * om);
      p[j * 2] = w; p[j * 2 + 1] = 2 * sg / w; j += 1; );
    PRG[f] = (1 + e * e) ^ -0.25;
  );
  PRN[f] = n;
);

function bc_coef(i, f, fc, t) local(p, q, j, ff, g, k, a1) (
  p = PRT + f * 8;  q = CQ + i * 16;  j = 0;
  loop(PRN[f],
    ff = (t == 3 || t == 4) ? fc / p[j * 2] : fc * p[j * 2];
    g = tan($pi * min(max(ff, 20), srate * 0.45) / srate);  k = p[j * 2 + 1];
    a1 = 1 / (1 + g * (g + k));
    q[j * 4] = a1;  q[j * 4 + 1] = g * a1;  q[j * 4 + 2] = g * g * a1;  q[j * 4 + 3] = k;
    j += 1;
  );
);

function bc_run(x, t, i, f) local(q, s, j, y, v1, v2, v3, k) (
  q = CQ + i * 16;  s = ST + i * 8;  y = x;  j = 0;
  loop(PRN[f],
    k = q[j * 4 + 3];
    v3 = y - s[j * 2 + 1];  v1 = q[j * 4] * s[j * 2] + q[j * 4 + 1] * v3;  v2 = s[j * 2 + 1] + q[j * 4 + 1] * s[j * 2] + q[j * 4 + 2] * v3;
    fd_on ? ( v1 += (fl_th(v1 * k) / k - v1) * fdm_s;  v2 = s[j * 2 + 1] + (q[j * 4 + 1] / q[j * 4]) * v1; );
    s[j * 2] = 2 * v1 - s[j * 2];  s[j * 2 + 1] = 2 * v2 - s[j * 2 + 1];
    y = t <= 2 ? v2 : t <= 4 ? y - k * v1 - v2 : t == 5 ? k * v1 : y - k * v1;
    j += 1;
  );
  (t <= 4 ? y * PRG[f] : y);
);

function fl_coef(i, f, fc, r, t, ch) local(c, q, g) (
  ch == 0 ? sv_coef(i, fc, r, 1.85) :
  ch == 1 ? ( sv_coef(i, fc, r, 1.98); c = CF + i * 8; q = CQ + i * 16; q[0] = c[1] / c[0]; q[1] = 1 - 0.3 * r; q[2] = 2 - 1.85 * r; ) :
  ch == 2 ? ( c = CF + i * 8; g = tan($pi * min(max(fc, 20), srate * 0.45) / srate); c[7] = g / (1 + g); c[3] = 3.98 * r; ) :
  bc_coef(i, f, fc, t);
);

function fl_run(x, t, ch, i, f, s) local(y, c, v1, v2, v3) (
  ch == 0 ? (
    fd_on ? (
      c = CF + i * 8;  y = x;
      v3 = y - s[1];  v1 = c[0] * s[0] + c[1] * v3;  v1 += (fl_th(v1 * c[3]) / c[3] - v1) * fdm_s;  v2 = s[1] + (c[1] / c[0]) * v1;
      s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
      y = t <= 2 ? v2 : t <= 4 ? y - c[3] * v1 - v2 : t == 5 ? c[3] * v1 : y - c[3] * v1;
      (t == 2 || t == 4) ? (
        v3 = y - s[3];  v1 = c[4] * s[2] + c[5] * v3;  v2 = s[3] + c[5] * s[2] + c[6] * v3;
        s[2] = 2 * v1 - s[2];  s[3] = 2 * v2 - s[3];
        y = t == 2 ? v2 : y - 1.41421356 * v1 - v2;
      );
      y;
    ) : sv_run(x, t, i, s);
  ) : ch == 1 ? sq_run(x, t, i, s) : ch == 2 ? ld_run(x, t, i, s) : bc_run(x, t, i, f);
);

function ph_coef(fp) local(g) ( g = tan($pi * min(max(fp, 20), srate * 0.45) / srate); (g - 1) / (g + 1); );
function ph_run(x, a, b, n) local(j, y, z) (
  j = 0;  y = x;
  loop(n, z = PHS[b + j]; x = y; y = a * x + z; PHS[b + j] = x - a * y; j += 1; );
  y;
);

function ds_tick(x) instance(a, pf, xp, dcx, dcy) local(u, y) (
  xp = x;
  u = pf.clp_pf_run(x) * ds_g;
  y = (a.clp_run(u + ds_b) - ds_rest) * ds_c;
  dcy = y - dcx + ds_dcc * dcy;  dcx = y;
  dcy;
);
function ds_reset() instance(a, xp, dcx, dcy) ( a.clp_reset();  xp = 0;  dcx = 0;  dcy = 0; );
function drive_os(l, r) (
  os_f == 1 ? ( drv_l = chL.ds.ds_tick(l);  drv_r = chR.ds.ds_tick(r); ) : (
    osuL.os_up(l);  osuR.os_up(r);
    oa0 = chL.ds.ds_tick(osuL.s0);  ob0 = chR.ds.ds_tick(osuR.s0);
    oa1 = chL.ds.ds_tick(osuL.s1);  ob1 = chR.ds.ds_tick(osuR.s1);
    os_f > 2 ? (
      oa2 = chL.ds.ds_tick(osuL.s2);  ob2 = chR.ds.ds_tick(osuR.s2);
      oa3 = chL.ds.ds_tick(osuL.s3);  ob3 = chR.ds.ds_tick(osuR.s3);
    );
    drv_l = osdL.os_dn(oa0, oa1, oa2, oa3);  drv_r = osdR.os_dn(ob0, ob1, ob2, ob3);
  );
);

function fl_divq(i) local(barq) (
  barq = ts_denom > 0 ? ts_num * 4 / ts_denom : 4;
  i == 0 ? 16 * barq : i == 1 ? 8 * barq : lfo_div_q(i - 2);
);
function fl_lfoblk(sync, div, frate) instance(syncm, rate, inc, ph) local(lenq) (
  syncm = sync; rate = frate;
  sync ? (
    lenq = fl_divq(div);
    play_state & 1 ? ( ph = beat_position / lenq; ph -= floor(ph); );
    inc = tempo / 60 / lenq / srate;
  );
);

function update_targets() local(dp, pa) (
  t1_t = (f1_typ | 0) + 1;  t2_t = (f2_typ | 0) + 1;
  c1_t = f1_chr | 0;  c2_t = f2_chr | 0;
  on1_t = f1_on >= 0.5;  on2_t = f2_on >= 0.5;
  lt1 = log(f1_cut) / log(2);  lt2 = log(f2_cut) / log(2);
  r1_t = f1_res * 0.01;  r2_t = f2_res * 0.01;
  dp = mod_dep * 0.01;
  a1l = f1_lfo * dp;  a1e = f1_env * dp;  a2m = mo_dep * dp;  a2e = f2_env * dp;  apm = 3 * dp;
  pa = ph_amt * 0.01;  pon_t = pa > 0.0005;
  pmx_t = 0.5 * min(pa * 2, 1);  pfb_t = 0.7125 * max(pa * 2 - 1, 0);
  pkp_t = 0.1 * pa;  psa_t = max(pa * 2 - 1, 0);  pmk_t = db2g(3.5 * (1 - (1 - pa) ^ 3.5));
  lfoL.lfo_setup(lf_shp, lf_shp == 3 ? 0.15 : 0.3);  lfoR.lfo_setup(lf_shp, lf_shp == 3 ? 0.15 : 0.3);
  drive_t = hot >= 0.5 ? 5 : 2.5;
  trim_t = db2g(trim_db);  out_t = db2g(out_db);  wet_t = mix_pc * 0.01;  bl_t = blend * 0.01;
  thk_t = thick >= 0.5;
  fdg_t = db2g(fl_drv);  fdm_t = min(fl_drv / 1.5, 1);  st_t = st_off * 0.01;
);

chL.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);  chR.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);
chL.ds.pf.clp_pf_reset();  chR.ds.pf.clp_pf_reset();
chL.ds.a.clp_set(1, 1, 0.72, 0);  chR.ds.a.clp_set(1, 1, 0.72, 0);
lfoL.lfo_init();  lfoR.lfo_init();  mo_ph = 0;

os_design();  os_base = 0;
os_f = os_tf = os_f2n(os_sel);  os_gsetup();

first_run = 1;
gl_sm = 1 - exp(-1 / (0.02 * srate));
c_sw  = 1 - exp(-1 / (0.012 * srate));
msm   = 1 - exp(-1 / (0.002 * srate));
sw_step = 1 / (0.004 * srate);
pfL = pfR = 0;  mpl = mpr = 0;  fd_on = 0;  paL = paR = 0;  ltp = log(330) / log(2);  cc = 0;  mg_hl = mg_hr = -90;  sw_f = 1;  sw_hold = 0;  dw = 0;
m1l = m1r = m2l = m2r = 0;

function pv(i, v) ( slider(i) = v; );
function pdef() (
  pv(1, 0); pv(2, 1); pv(3, 1); pv(4, 1); pv(5, 0); pv(6, 2200); pv(7, 30); pv(8, 0); pv(9, 0);
  pv(10, 0); pv(11, 1); pv(12, 8); pv(13, 1);
  pv(14, 1); pv(15, 3); pv(16, 110); pv(17, 20); pv(18, 0); pv(19, 0.33); pv(20, 4); pv(21, 0); pv(22, 1);
  pv(23, 0); pv(24, 0); pv(25, 100); pv(26, 0);
  pv(29, 4); pv(30, 3); pv(31, 0); pv(32, 100); pv(33, 0);
);
function load_preset(p) (
  pdef();
  p == 3 ? cv_set_au(3, 0, 0, -0.6, 0.5, 1, 0.6, 1, 0, 0, 0, 0, 0, 0, 0, 0) :
  p == 6 ? cv_set_au(5, 0, 0, 0, 0.25, 1, 0, 0.5, 0.3, 0, 0.75, 0.8, 0, 1, 0, 0) :
  p == 9 ? cv_set_au(4, 0, 0.2, 0.4, 0.4, 1, -0.4, 0.7, 0.1, 0.3, 1, 0.2, 0, 0, 0, 0) :
  cv_dflt_au();
  p == 2 ? ( pv(5, 1); pv(6, 660); pv(7, 45); pv(9, 2.5); pv(10, 0); pv(12, 8); pv(14, 0); ) :
  p == 3 ? ( pv(5, 0); pv(6, 550); pv(7, 25); pv(9, 1.5); pv(10, 1); pv(13, 0); pv(11, 0.05); pv(15, 0); pv(16, 1100); pv(17, 30); pv(21, 2); pv(20, 2); pv(23, 100); ) :
  p == 4 ? ( pv(5, 4); pv(6, 440); pv(7, 60); pv(8, 3); pv(14, 0); pv(2, 0); ) :
  p == 5 ? ( pv(5, 1); pv(6, 990); pv(7, 50); pv(9, 2); pv(10, 3); pv(12, 11); pv(16, 55); ) :
  p == 6 ? ( pv(5, 4); pv(6, 660); pv(7, 70); pv(9, 1); pv(10, 1); pv(12, 5); pv(15, 4); pv(16, 550); pv(17, 70); pv(21, 2); pv(20, 8); pv(23, 100); ) :
  p == 7 ? ( pv(5, 1); pv(6, 3300); pv(7, 35); pv(15, 3); pv(16, 330); pv(17, 30); pv(1, 3); ) :
  p == 8 ? ( pv(5, 1); pv(6, 880); pv(7, 40); pv(9, 3); pv(10, 2); pv(12, 11); pv(14, 0); ) :
  p == 9 ? ( pv(5, 1); pv(6, 330); pv(7, 55); pv(8, 2); pv(15, 0); pv(16, 330); pv(17, 35); pv(21, 3); pv(20, 3); pv(23, 40); pv(3, 1); ) :
  p == 10 ? ( pv(4, 0); pv(14, 0); pv(24, 100); pv(20, 2); pv(33, 25); pv(2, 0); ) :
  p == 11 ? ( pv(5, 1); pv(6, 660); pv(7, 60); pv(9, 2.5); pv(13, 1); pv(12, 3); pv(14, 0); pv(33, 20); ) : 0;
  slider_automate(8388607999);
  gui_dirty = 1;
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(33, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);
first_run ? (
  t1_a = t1_t;  t2_a = t2_t;  c1_a = c1_t;  c2_a = c2_t;  on1_s = on1_t;  on2_s = on2_t;  pon_s = pon_t;
  fdg_s = fdg_t;  fdm_s = fdm_t;  fd_on = fdm_s > 0.00001;  st_s = st_t;  pfb_s = pfb_t;  pmx_s = pmx_t;  pkp_s = pkp_t;  psa_s = psa_t;  pmk_s = pmk_t;
  drive_s = drive_t;  r1_s = r1_t;  r2_s = r2_t;  lc1 = lt1;  lc2 = lt2;
  trim_s = trim_t;  out_s = out_t;  wet_s = wet_t;  bl_s = bl_t;  by_s = byp;
  first_run = 0;
);
os_snap(slider(28));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? (
  rs_f = 0;  rs_c = 1 / (0.015 * srate);
  memset(SB, 0, 16);  memset(DLB, 0, 128);  memset(ST, 0, 32);  memset(PHS, 0, 40);  pfL = pfR = 0;
  chL.ds.ds_reset();  chR.ds.ds_reset();
);
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pwr_block(!byp);
update_targets();
os_tf = os_f2n(os_sel);
pdc_delay = os_lat(os_f);
kb = 1 - exp(-samplesblock / (0.03 * srate));
drive_s += (drive_t - drive_s) * kb;
dn = drive_s / 10;
ds_st = min(1, drive_s / 3);
ds_g = db2g(drive_s * 2.4);  ds_b = 0.08 + 0.12 * dn;
ds_rest = chL.ds.a.clp_crv(ds_b);
ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(chL.ds.a.clp_crv(0.25 * ds_g + ds_b) - ds_rest, 0.0001);
ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
chL.ds.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);  chR.ds.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);
chL.ds.a.clp_tidy();  chR.ds.a.clp_tidy();
sw_hold = 0;

lfoL.fl_lfoblk(lf_syn >= 0.5, lf_div, lf_hz);  lfoR.fl_lfoblk(lf_syn >= 0.5, lf_div, lf_hz);
pr_make(0, t1_a, c1_a, r1_s);  pr_make(1, t2_a, c2_a, r2_s);
lut_req ? ( lut_req = 0; build_lut_au(); );
mo_syn >= 0.5 ? (
  mo_lq = fl_divq(mo_div);
  play_state & 1 ? ( mo_ph = beat_position / mo_lq; mo_ph -= floor(mo_ph); );
  mo_inc = tempo / 60 / mo_lq / srate;
) : mo_inc = mo_hz / srate;

pkL_d = max(pkL_d, pkL);  pkL = 0;  pkR_d = max(pkR_d, pkR);  pkR = 0;
m1_d = m1l;  m2_d = m2l;  mo_ph_d = mo_ph;  st_d = st_s;
os_snapb(slider(28));

@sample
rw_l = spl0;  rw_r = spl1;
DLB[dw] = spl0;  DLB[64 + dw] = spl1;
dry_l = DLB[(dw - pdc_delay) & 63];  dry_r = DLB[64 + ((dw - pdc_delay) & 63)];
dw = (dw + 1) & 63;

(t1_t != t1_a || t2_t != t2_a || c1_t != c1_a || c2_t != c2_a) ? (
  sw_f = max(0, sw_f - sw_step);
  sw_f == 0 ? (
    (t1_t != t1_a || c1_t != c1_a) ? ( memset(SB, 0, 4);  memset(SB + 8, 0, 4);  memset(ST, 0, 16);  t1_a = t1_t;  c1_a = c1_t;  pr_make(0, t1_a, c1_a, r1_s); );
    (t2_t != t2_a || c2_t != c2_a) ? ( memset(SB + 4, 0, 4);  memset(SB + 12, 0, 4);  memset(ST + 16, 0, 16);  t2_a = t2_t;  c2_a = c2_t;  pr_make(1, t2_a, c2_a, r2_s); );
    cc = 0;  sw_hold = 1;
  );
) : ( !sw_hold && sw_f < 1 ? sw_f = min(1, sw_f + sw_step); );
os_gate();
os_chg ? (
  osuL.os_clr();  osuR.os_clr();  osdL.os_clr();  osdR.os_clr();
  chL.ds.ds_reset();  chR.ds.ds_reset();  chL.ds.pf.clp_pf_reset();  chR.ds.pf.clp_pf_reset();
  chL.ds.pf.clp_pf_block(dn, srate * os_f, 1);  chR.ds.pf.clp_pf_block(dn, srate * os_f, 1);
  ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
  dry_l = DLB[(dw - 1 - pdc_delay) & 63];  dry_r = DLB[64 + ((dw - 1 - pdc_delay) & 63)];
);

trim_s += (trim_t - trim_s) * gl_sm;  out_s += (out_t - out_s) * gl_sm;  wet_s += (wet_t - wet_s) * gl_sm;
bl_s += (bl_t - bl_s) * gl_sm;
on1_s += (on1_t - on1_s) * c_sw;  on2_s += (on2_t - on2_s) * c_sw;
inL = spl0 * trim_s;  inR = spl1 * trim_s;

fdg_s += (fdg_t - fdg_s) * gl_sm;  fdm_s += (fdm_t - fdm_s) * gl_sm;  fd_on = fdm_s > 0.00001 || fdm_t > 0;  st_s += (st_t - st_s) * gl_sm;  pon_s += (pon_t - pon_s) * c_sw;
pfb_s += (pfb_t - pfb_s) * gl_sm;  pmx_s += (pmx_t - pmx_s) * gl_sm;
pkp_s += (pkp_t - pkp_s) * gl_sm;  psa_s += (psa_t - psa_s) * gl_sm;  pmk_s += (pmk_t - pmk_s) * gl_sm;

wl = lfoL.lfo_tick(0, 0, 0);  wr = lfoR.lfo_tick(st_s, 0, 0);
e1L = exp(-5 * lfoL.p);  e1R = exp(-5 * lfoR.p);
mo_ph += mo_inc;  mo_ph -= floor(mo_ph);  ml = cv_read(mo_ph);
mo_pr = mo_ph + st_s;  mo_pr -= floor(mo_pr);  mr = st_s > 0.0001 ? cv_read(mo_pr) : ml;
e2L = exp(-5 * mo_ph);  e2R = exp(-5 * mo_pr);

lc1 += (lt1 - lc1) * gl_sm;  lc2 += (lt2 - lc2) * gl_sm;
r1_s += (r1_t - r1_s) * gl_sm;  r2_s += (r2_t - r2_s) * gl_sm;
m1l += (wl * a1l + e1L * a1e - m1l) * msm;  m1r += (wr * a1l + e1R * a1e - m1r) * msm;
m2l += (ml * a2m + e2L * a2e - m2l) * msm;  m2r += (mr * a2m + e2R * a2e - m2r) * msm;
mpl += (ml * apm - mpl) * msm;  mpr += (mr * apm - mpr) * msm;
cc -= 1;
cc <= 0 ? (
  cc = 8;
  fl_coef(0, 0, 2 ^ (lc1 + m1l), r1_s, t1_a, c1_a);  fl_coef(1, 0, 2 ^ (lc1 + m1r), r1_s, t1_a, c1_a);
  fl_coef(2, 1, 2 ^ (lc2 + m2l), r2_s, t2_a, c2_a);  fl_coef(3, 1, 2 ^ (lc2 + m2r), r2_s, t2_a, c2_a);
  pon_s > 0.0001 ? ( paL = ph_coef(2 ^ (ltp + mpl));  paR = ph_coef(2 ^ (ltp + mpr)); );
);

xl = inL;  xr = inR;
pwr_in(xl, xr);  xl = pwr_l;  xr = pwr_r;
thk_proc(xl, xr, thk_t);  xl = thk_l;  xr = thk_r;
drive_os(xl, xr);  xl = drv_l;  xr = drv_r;

fd_on ? ( xl *= fdg_s;  xr *= fdg_s; );
y1l = fl_run(xl, t1_a, c1_a, 0, 0, SB);  y1r = fl_run(xr, t1_a, c1_a, 1, 0, SB + 8);
y1l = xl + (y1l - xl) * on1_s;  y1r = xr + (y1r - xr) * on1_s;
u2l = y1l + (xl - y1l) * bl_s;  u2r = y1r + (xr - y1r) * bl_s;
y2l = fl_run(u2l, t2_a, c2_a, 2, 1, SB + 4);  y2r = fl_run(u2r, t2_a, c2_a, 3, 1, SB + 12);
o2l = y2l + (0.5 * (y1l + y2l) - y2l) * bl_s;  o2r = y2r + (0.5 * (y1r + y2r) - y2r) * bl_s;
xl = y1l + (o2l - y1l) * on2_s;  xr = y1r + (o2r - y1r) * on2_s;
fd_on ? ( fd_c = fdg_s ^ -0.95;  xl *= fd_c;  xr *= fd_c; );

pon_s > 0.0001 ? (
  pwl = ph_run(xl + fl_th(pfL) * pfb_s, paL, 0, 12);  pwr = ph_run(xr + fl_th(pfR) * pfb_s, paR, 20, 12);
  pfL = pwl;  pfR = pwr;
  pwl = xl + (pwl - xl) * pmx_s;  pwr = xr + (pwr - xr) * pmx_s;
  psa_s > 0.0001 ? (
    psg = 1 + 3 * psa_s;
    pwl += (fl_th(pwl * psg) / psg - pwl) * psa_s;  pwr += (fl_th(pwr * psg) / psg - pwr) * psa_s;
  );
  pwl = (pwl + (xl - pwl) * pkp_s) * pmk_s;  pwr = (pwr + (xr - pwr) * pkp_s) * pmk_s;
  xl += (pwl - xl) * pon_s;  xr += (pwr - xr) * pon_s;
);

pwr_out(xl, xr);  xl = pwr_l;  xr = pwr_r;
xl *= out_s * sw_f * os_g;  xr *= out_s * sw_f * os_g;
xl = dry_l + (xl - dry_l) * wet_s;  xr = dry_r + (xr - dry_r) * wet_s;
ost_out(xl, xr);  xl = ost_l;  xr = ost_r;

by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( xl += (dry_l - xl) * by_s;  xr += (dry_r - xr) * by_s; );

pkL = max(pkL, abs(xl));  pkR = max(pkR, abs(xr));
spl0 = xl;  spl1 = xr;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1);  rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  spl0 = rw_l + (spl0 - rw_l) * rs_s;  spl1 = rw_r + (spl1 - rw_r) * rs_s;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, crv_init);
file_mem(0, CRV, CSZ);
file_avail(0) >= 0 ? lut_req = 1;
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@gfx 900 355
ui_begin(900, 355);
mk_face = 0xC7BEB3; mk_band = 0x4A3328; mk_acc = 0xE0A060; mk_ink = 0xE8E6E0; mk_ink2 = 0xB8B6B0; mk_hov = 0xFFC860;
mk_sub = ui_mix(mk_face, 0x000000, 0.62); mk_sub2 = ui_mix(mk_face, 0x000000, 0.72);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 24 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
  mg_f7 = ui_fitarial(7, 10 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(7, "Arial", mg_f7, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_sub(x, y, w, h, num, title, tab) local(b, c, j) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  j = 0; loop(16, ui_col(ui_mix(mk_sub, mk_sub2, j / 15)); mg_r(x + b, y + b + j * (h - 2 * b) / 16, w - 2 * b, (h - 2 * b) / 16 + 1); j += 1; );
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0xF4F6F8); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0x1A1A1C); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(13); ui_col(mg_lum(tab) > 0.5 ? 0x1A1A1C : 0xE8E6E0); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(ui_mix(mk_sub, 0x000000, 0.4)); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(ui_mix(mk_sub, 0xFFFFFF, 0.25)); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_dwell(x, y, w, h) (
  ui_col(ui_mix(mk_face, 0x000000, 0.55)); mg_r(x, y, w, h);
  ui_col(mk_sub2); mg_r(x + 2, y + 2, w - 3, h - 3);
  ui_cola(0x000000, 0.35); mg_r(x + 2, y + 2, w - 3, 2); mg_r(x + 2, y + 4, 2, h - 5);
  ui_cola(0xFFFFFF, 0.22); mg_r(x, y + h, w + 1, 1); mg_r(x + w, y, 1, h);
);
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, i, t, dr) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
