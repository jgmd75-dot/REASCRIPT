desc:WS9 [channel strip] (GFX V4)
//tags: processing channel strip location mixer transformer iron saturation sidebar peak harmonics multiband drive compressor equaliser tape clipper v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-input, gfx-v4-output, gfx-v4-drift, gfx-v4-ui, gfx-v4-panel, gfx-v4-os, gfx-v4-bypass, gfx-v4-sidebar, gfx-v4-power, gfx-v4-sliders

slider27:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-24,12,0.1>-Trim (dB)
slider3:0<0,1,1{Off,On}>-Guard
slider4:20<20,800,1>-HPF (Hz)
slider5:22000<2000,22000,1>-LPF (Hz)
slider6:0<0,10,0.01>-Drive
slider7:0<0,1,1{Full,Split}>-Sidebar
slider8:0<-40,0,0.1>-Comp threshold (dB)
slider9:0<0,1,1{Fast,Slow}>-Comp attack
slider10:0<0,2,1{2 to 1,4 to 1,8 to 1}>-Comp ratio
slider11:0<0,1,1{Auto,Fast}>-Comp release
slider12:0<-15,15,0.1>-HF (dB)
slider13:0<-15,15,0.1>-LF (dB)
slider14:1100<40,16000,1>-Mid frequency (Hz)
slider15:0<-15,15,0.1>-Mid gain (dB)
slider16:1<0.4,10,0.01>-Mid Q
slider17:0<0,1,1{Comp first,EQ first}>-Order
slider18:15<12,15,0.01>-Battery (V)
slider19:0<0,1,1{Off,On}>-Listen
slider20:0<-12,12,0.1>-Output (dB)
slider21:100<0,200,1>-Width (%)
slider22:50<0,100,1>-Drift (%)
slider23:1<0,2,1{1x,2x,4x}>-Oversampling
slider24:100<0,100,1>-Comp mix (%)
slider25:0<0,1,1{Off,On}>-Mid dynamic
slider26:prs_sel=0<0,8,1{No preset,Init,Vocal Polish,Drum Smash,Bass Weight,Acoustic Guitar,Bus Glue,Seek and Destroy,Crunch Snare}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-input.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-drift.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sidebar.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(134217727, v); );
function psw_allg(v) ( slider_show(134217727, v); );
#ui_man = "gfx-v4-ws9";
ext_noinit = 1;

function mc_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function mc_db(d) ( exp(d * 0.11512925464970228); );
function mc_tcf(ms, fs) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * fs)); );
function mc_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );
function mc_th(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

COEF = 7000000;
function mc_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 1 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) + (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) - (Ag - 1) * cw + sa) / a0; c[1] = 2 * Ag * ((Ag - 1) - (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
    c[3] = -2 * ((Ag - 1) + (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : t == 3 ? (
    a0 = 1 + al; c[0] = (1 - cw) * 0.5 / a0; c[1] = (1 - cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  ) : t == 5 ? (
    a0 = 1 + al; c[0] = al / a0; c[1] = 0; c[2] = -al / a0; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function mc_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function mc_bqz() instance(z1, z2) ( z1 = z2 = 0; );
C_PE = COEF;      C_DE = COEF + 5;  C_HB = COEF + 10; C_GL = COEF + 15;
C_LF = COEF + 20; C_LD = COEF + 25; C_HF = COEF + 30; C_HD = COEF + 35;
C_MD = COEF + 40; C_DB = COEF + 110;
C_F1 = COEF + 85; C_F2 = COEF + 90; C_F3 = COEF + 95; C_F4 = COEF + 100;

function mc_grd(l, r) local(pk, ov, gr, g) (
  mc_gon += ((slider3 >= 0.5) - mc_gon) * c_sw;
  mc_gon > 0.0001 ? (
    pk = max(abs(l), abs(r));
    mc_gen += (pk - mc_gen) * (pk > mc_gen ? mc_gca : mc_gcr);
    ov = 20 * log10(max(mc_gen, 0.000001)) + 12;
    gr = ov <= -3 ? 0 : ov >= 3 ? ov * 5 / 6 : (5 / 6) * sqr(ov + 3) / 12;
    g = 1 + mc_gon * (mc_db(-gr) - 1); l *= g; r *= g;
  );
  mc_xl = l; mc_xr = r;
);
function mc_flt(x) instance(h1, h2, h3, l1, l2, l3, p1, p2, p3, q1, q2, q3) local(a, b, c, y) (
  p1 += (x - p1) * mc_hk; a = x - p1;
  p2 += (a - p2) * mc_hk; b = a - p2;
  p3 += (b - p3) * mc_hk; c = b - p3;
  y = a + mc_hw2 * (b - a) + mc_hw3 * (c - b);
  y = x + mc_hon * (y - x);
  q1 += (y - q1) * mc_lk; q2 += (q1 - q2) * mc_lk; q3 += (q2 - q3) * mc_lk;
  a = q1 + mc_lw2 * (q2 - q1) + mc_lw3 * (q3 - q2);
  y + mc_lon * (a - y);
);
function mc_fclr() instance(p1, p2, p3, q1, q2, q3) ( p1 = p2 = p3 = q1 = q2 = q3 = 0; );

function mc_hc(u) ( mc_th(mc_g * 0.5 * u * mc_pd + mc_b) - mc_tb; );
function mc_drv(x) instance(l1, l2, hp, dx, dy) local(lo, y, hf, e, k) (
  l1 += (x - l1) * mc_lsk; l2 += (l1 - l2) * mc_lsk; lo = l2 * mc_ls;
  hp += (x - hp) * mc_hfk; hf = x - hp;
  y = this.pe.mc_bq(x - lo, C_PE);
  y = mc_hc(y) * mc_lm;
  y = this.de.mc_bq(y, C_DE);
  y += lo * mc_lsg;
  k = mc_hfg; e = mc_th(k * hf + 0.35) - mc_t35 - k * hf * mc_t35d;
  y += e / k * mc_hfa;
  y = this.hb.mc_bq(y, C_HB); y = this.gl.mc_bq(y, C_GL);
  e = y - dx + mc_dc10 * dy; dx = y; dy = e;
  e;
);
function mc_dclr() instance(l1, l2, hp, dx, dy) ( l1 = l2 = hp = dx = dy = 0; this.pe.mc_bqz(); this.de.mc_bqz(); this.hb.mc_bqz(); this.gl.mc_bqz(); );
function mc_lmc(g, pd, b) local(i, x, y, si, so, tb) (
  si = so = 0; i = 0; tb = mc_th(b);
  loop(64, x = (i < 32 ? 0.125 : 0.25) * sin((i + 0.5) * 0.19634954084936207);
    y = mc_th(g * 0.5 * x * pd + b) - tb; si += x * x; so += y * y; i += 1; );
  sqrt(si / max(so, 0.000000000001));
);

function mc_comp(l, r) local(e, o, z, s, gr) (
  e = 20 * log10(max(max(abs(l), abs(r)), 0.00001));
  o = e - mc_thr; s = mc_slp;
  z = o <= -3 ? 0 : o >= 3 ? o * s : s * sqr(o + 3) / 12;
  mc_g1 += (z - mc_g1) * (z > mc_g1 ? mc_ca : mc_cr1);
  mc_g2 += (z - mc_g2) * (z > mc_g2 ? mc_ca2 : mc_cr2);
  gr = mc_rf ? mc_g1 : max(mc_g1, mc_g2);
  mc_gro = max(mc_gro, gr);
  z = mc_db(mc_mku - gr);
  z = 1 + mc_mx * (z - 1);
  mc_cl = l * z; mc_cr = r * z;
);
function mc_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function mc_fizz() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.mc_bq(mc_el, C_F1); h1 = zA2.mc_bq(mc_er, C_F1);
  ha = max(abs(h0), abs(h1)); mc_fzh += (ha - mc_fzh) * (ha > mc_fzh ? mc_fza : mc_fzr);
  pa = max(abs(mc_el), abs(mc_er)); mc_fzp += (pa - mc_fzp) * mc_fzw;
  nn = 1 / (max(mc_fzh, 0.25 * mc_fzp) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (mc_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * mc_fzh;
  e1 = (mc_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * mc_fzh;
  e0 = zD1.mc_bq(zC1.mc_bq(zB1.mc_bq(e0, C_F2), C_F3), C_F4);
  e1 = zD2.mc_bq(zC2.mc_bq(zB2.mc_bq(e1, C_F2), C_F3), C_F4);
  ea = max(abs(e0), abs(e1)); mc_fze += (ea - mc_fze) * (ea > mc_fze ? mc_fza : mc_fzr);
  g = mc_fzo * max(0.25, min(1, 0.05 * mc_fzp / (mc_fze + 0.000001)));
  mc_el += g * e0; mc_er += g * e1;
);
function mc_fzclr() (
  zA1.mc_bqz(); zA2.mc_bqz(); zB1.mc_bqz(); zB2.mc_bqz(); zC1.mc_bqz(); zC2.mc_bqz(); zD1.mc_bqz(); zD2.mc_bqz();
  mc_fzh = mc_fzp = mc_fze = 0;
);
function mc_eq(l, r) (
  l = eLD.mc_bq(eLF.mc_bq(l, C_LF), C_LD); r = fLD.mc_bq(fLF.mc_bq(r, C_LF), C_LD);
  l = eHD.mc_bq(eHF.mc_bq(l, C_HF), C_HD); r = fHD.mc_bq(fHF.mc_bq(r, C_HF), C_HD);
  mc_dyo > 0.0001 ? (
    mc_dbx = abs(dDB.mc_bq((l + r) * 0.5, C_DB)); mc_dfx = max(abs(l), abs(r));
    mc_dbe += (mc_dbx - mc_dbe) * (mc_dbx > mc_dbe ? mc_dka : mc_dkr);
    mc_dfe += (mc_dfx - mc_dfe) * (mc_dfx > mc_dfe ? mc_dka : mc_dkr);
  );
  mc_el = eMD.mc_bq(l, C_MD); mc_er = fMD.mc_bq(r, C_MD);
  mc_fzo > 0.0001 ? mc_fizz();
);

function ir_sat(x) ( x / sqrt(1 + x * x); );
function ir_run(u, g, gl, b, rb, kb, kc) instance(lp) local(lo) (
  lp += (u - lp) * kc;
  lo = (ir_sat(lp * gl + b) - rb) * kb / gl;
  ir_sat((u - lp + lo) * g) / g;
);
function ir_tgt(d, kg, kl, kbias, hb) instance(tg, tgl, tb, trb, tkb) (
  tg = mc_db(kg * d - 9) * hb; tgl = tg * (1 + kl * d); tb = kbias * d;
  trb = ir_sat(tb); tkb = (1 + tb * tb) ^ 1.5;
);
function ir_glide(k) instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) (
  g += (tg - g) * k; gl += (tgl - gl) * k; b += (tb - b) * k; rb += (trb - rb) * k; kb += (tkb - kb) * k;
);
function ir_snap() instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) ( g = tg; gl = tgl; b = tb; rb = trb; kb = tkb; );

function xo_coef(f, fs) instance(c1, c2, c3) local(g) (
  g = tan($pi * min(f, 0.45 * fs) / fs); c1 = 1 / (1 + g * (g + 1.4142135623730951)); c2 = g * c1; c3 = g * c2;
);
function xo_run(x, c1, c2, c3) instance(a1, a2, b1, b2, d1, d2, lo, hi) local(v1, v2, v3, l, h) (
  v3 = x - a2; v1 = c1 * a1 + c2 * v3; v2 = a2 + c2 * a1 + c3 * v3; a1 = 2 * v1 - a1; a2 = 2 * v2 - a2;
  l = v2; h = x - 1.4142135623730951 * v1 - v2;
  v3 = l - b2; v1 = c1 * b1 + c2 * v3; v2 = b2 + c2 * b1 + c3 * v3; b1 = 2 * v1 - b1; b2 = 2 * v2 - b2;
  lo = v2;
  v3 = h - d2; v1 = c1 * d1 + c2 * v3; v2 = d2 + c2 * d1 + c3 * v3; d1 = 2 * v1 - d1; d2 = 2 * v2 - d2;
  hi = h - 1.4142135623730951 * v1 - v2;
);
function xo_clr() instance(a1, a2, b1, b2, d1, d2, lo, hi) ( a1 = a2 = b1 = b2 = d1 = d2 = lo = hi = 0; );
function bd_run(x) (
  this.m.xo_run(x, xoM.c1, xoM.c2, xoM.c3);
  this.l.xo_run(this.m.lo, xoL.c1, xoL.c2, xoL.c3);
  this.h.xo_run(this.m.hi, xoH.c1, xoH.c2, xoH.c3);
  this.s0.sb_run(this.l.lo) + this.s1.sb_run(this.l.hi) + this.s2.sb_run(this.h.lo) + this.s3.sb_run(this.h.hi);
);
function bd_clr() ( this.m.xo_clr(); this.l.xo_clr(); this.h.xo_clr(); this.s0.sb_clr(); this.s1.sb_clr(); this.s2.sb_clr(); this.s3.sb_clr(); );
function sd_run(x) (
  sb_mode == 0 ? x + this.s0.sb_run(x) : x + this.bd_run(x);
);

function mc_chain(l, r) local(xl, xr, a, b, pl, pr) (
  l = iaL.ir_run(l, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  r = iaR.ir_run(r, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  l = mDL.mc_drv(l); r = mDR.mc_drv(r);
  xl = l; xr = r;
  l = bL.sd_run(l); r = bR.sd_run(r);
  mc_sl = l - xl; mc_sr2 = r - xr;
  xl = l; xr = r;
  mc_ord ? (
    mc_eq(l, r); mc_comp(mc_el, mc_er); pl = mc_cl; pr = mc_cr;
  ) : (
    mc_comp(l, r); mc_eq(mc_cl, mc_cr); pl = mc_el; pr = mc_er;
  );
  l = xl + mc_dk * (pl - xl); r = xr + mc_dk * (pr - xr);
  mc_pl = obL.ir_run(l * mc_cg, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);
  mc_pr = obR.ir_run(r * mc_cg, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);
  mc_lsn > 0.0001 ? ( mc_pl += mc_lsn * (4 * mc_sl - mc_pl); mc_pr += mc_lsn * (4 * mc_sr2 - mc_pr); );
);
function mc_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  mDL.mc_dclr(); mDR.mc_dclr(); bL.bd_clr(); bR.bd_clr();
  iaL.lp = iaR.lp = obL.lp = obR.lp = 0;
  eLF.mc_bqz(); eLD.mc_bqz(); eHF.mc_bqz(); eHD.mc_bqz(); eMD.mc_bqz();
  fLF.mc_bqz(); fLD.mc_bqz(); fHF.mc_bqz(); fHD.mc_bqz(); fMD.mc_bqz();
  mc_g1 = mc_g2 = 0; mc_fzclr(); dDB.mc_bqz(); mc_dbe = mc_dfe = 0;
);
function mc_reset() (
  mc_clear(); fL.mc_fclr(); fR.mc_fclr(); memset(BY_BUF, 0, 2 * BY_N);
  in_dxL = in_dyL = in_dxR = in_dyR = 0; mc_dxl = mc_dyl = mc_dxr = mc_dyr = 0; sg_e = 0;
  mc_fi = 0;
);

PT = 6000000;
#mc_pm = "Init|Vocal Polish|Drum Smash|Bass Weight|Acoustic Guitar|Bus Glue|Seek and Destroy|Crunch Snare";
function mc_w7(a, b, c, d, e, f, g) ( mc_wp[0] = a; mc_wp[1] = b; mc_wp[2] = c; mc_wp[3] = d; mc_wp[4] = e; mc_wp[5] = f; mc_wp[6] = g; mc_wp += 7; );
mc_wp = PT;
mc_w7(0,   0,    20,  22000, 0,    1,  0);  mc_w7(0,   1,  0,    0,      0,   0,  1100); mc_w7(0, 1, 0, 0, 0, 0, 100);
mc_w7(0,   1,    88,  22000, 3,    1,  0);  mc_w7(-24, 1,  1,    0,      3,   0,  330);  mc_w7(-2, 1.4, 0, 2, 1, 1.5, 100);
mc_w7(0,   0,    33,  22000, 6,    0,  1);  mc_w7(-28, 0,  2,    1,      2,   3,  440);  mc_w7(-3, 2, 0, 4, 0, 4, 110);
mc_w7(0,   0,    33,  8800,  4,    1,  1);  mc_w7(-20, 1,  1,    0,      -1,  3,  660);  mc_w7(-2, 1.2, 1, 3, 1, 4.5, 40);
mc_w7(0,   0,    110, 22000, 2,    1,  0);  mc_w7(-18, 1,  0,    0,      2.5, -1.5, 220); mc_w7(-2.5, 1.5, 0, 1.5, 1, 2, 110);
mc_w7(0,   0,    20,  22000, 2,    1,  0);  mc_w7(-16, 1,  0,    0,      1,   1,  1100); mc_w7(0, 1, 1, 2, 1, 2.5, 100);
mc_w7(0,   0,    20,  22000, 0,    1,  0);  mc_w7(0,   1,  0,    0,      0,   0,  2200); mc_w7(-12, 8, 0, 0, 0, 0, 100);
mc_w7(0,   0,    110, 16500, 8,    0,  1);  mc_w7(-26, 0,  2,    1,      3,   1,  880);  mc_w7(3, 1.5, 0, 5, 0, 5, 100);
function load_preset(p) local(i, q) (
  q = PT + (min(p, 9) == 9 ? 0 : p - 1) * 21;
  i = 0; loop(5, slider(2 + i) = q[i]; i += 1; );
  i = 7; loop(10, slider(1 + i) = q[i]; i += 1; );
  slider20 = q[19]; slider21 = q[20];
  slider18 = p == 3 ? 14 : p == 8 ? 13.5 : 15;
  slider19 = 0;
  p == 9 ? slider22 = 50;
  slider24 = p == 3 ? 60 : p == 8 ? 70 : 100;
  slider25 = p == 7;
  i = 2; loop(5, ui_auto(i); i += 1; ); i = 8; loop(15, ui_auto(i); i += 1; ); ui_auto(24); ui_auto(25);
  pr_cur = p == 9 ? 1 : p;
);

function mc_srinit() (
  mc_sr = srate;
  c_kn = mc_tcf(30, srate);
  c_sw = mc_tcf(15, srate);
  c_tk = 1 - exp(-32 / (0.03 * srate));
  c_dy = 1 - exp(-32 / (0.01 * srate));
  mc_fis = 1 / (0.01 * srate);
  mc_dks = 1 / (0.006 * srate);
  mc_mbk = mc_opk(78, srate); mc_ms1 = mc_ms2 = 0;
  ost_init(0);
  sg_k = mc_tcf(60, srate);
  mc_dcc = 1 - 2 * $pi * 1.5 / srate;
  os_base = 0;
  mc_clear(); fL.mc_fclr(); fR.mc_fclr();
  mc_snap = 1;
);
function mc_coef() local(fs, d) (
  fs = mc_fs = srate * os_f;
  mc_lsk = mc_opk(300, fs); mc_hfk = mc_opk(2200, fs);
  mc_dc10 = 1 - 2 * $pi * 10 / fs; mc_dc5 = 1 - 2 * $pi * 5 / fs;
  mc_bqc(C_PE, 2, 3000, 4, 0.7, fs); mc_bqc(C_DE, 2, 3000, -4, 0.7, fs);
  mc_bqc(C_HB, 0, 70, 1.5 * min(mc_dv / 3, 1) * (1 - 0.05 * mc_dv), 0.9, fs); mc_bqc(C_GL, 2, 12000, -0.25 * mc_dv, 0.7071, fs);
  mc_bqc(C_LF, 1, 110, mc_lfg, 0.7071, fs); mc_bqc(C_LD, 0, 330, -0.15 * max(mc_lfg - 4, 0), 0.9, fs);
  mc_bqc(C_F1, 4, 3500, 0, 0.7071, fs); mc_bqc(C_F2, 4, 5500, 0, 0.7071, fs); mc_bqc(C_F3, 0, 8000, 4, 0.7, fs); mc_bqc(C_F4, 2, 12000, -6, 0.7, fs);
  ir_kci = mc_opk(150, fs); ir_kco = mc_opk(120, fs);
  xoL.xo_coef(220, fs); xoM.xo_coef(1100, fs); xoH.xo_coef(5500, fs);
  mc_fza = mc_tcf(3, fs); mc_fzr = mc_tcf(120, fs); mc_fzw = mc_tcf(60, fs);
  mc_bqc(C_HF, 2, 8800, mc_hfgn, 0.7071, fs); mc_bqc(C_HD, 0, 3300, -0.15 * max(mc_hfgn - 4, 0), 0.9, fs);
  mc_bqc(C_MD, 0, mc_mf, mc_mg * (1 - mc_dyo + mc_dyo * mc_dya), mc_mq, fs);
  mc_bqc(C_DB, 5, mc_mf, 0, mc_mq, fs); mc_dka = mc_tcf(3, fs); mc_dkr = mc_tcf(100, fs);
  mc_ca = mc_tcf(mc_slow ? 30 : 1, fs); mc_ca2 = mc_tcf(250, fs);
  mc_cr1 = mc_tcf((mc_rf ? 60 : 80) * mc_rlz, fs); mc_cr2 = mc_tcf(1200 * mc_rlz, fs);
  mc_hk = mc_opk(mc_fh / (1 + 0.554 * mc_hw2 + 0.407 * mc_hw3), srate); mc_lk = mc_opk(mc_fl * (1 + 0.554 * mc_lw2 + 0.407 * mc_lw3), srate);
);
os_design();
os_f = os_tf = os_f2n(slider23);
sb_mode = sb_mt = slider7 >= 0.5; st_g = 1; st_hold = 0;
mc_srinit();
os_gsetup();
in_init();
in_msc = 1 - exp(-1 / (0.15 * srate)); in_agc = 1 - exp(-1 / (0.4 * srate));
mc_gca = 1 - exp(-1 / (0.001 * srate)); mc_gcr = 1 - exp(-1 / (0.08 * srate)); mc_gen = 0; mc_gon = 0;
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_bloom = 0.1;
dSup.drift_init(0.8 + rand(1) * 0.4); dBias.drift_init(0.8 + rand(1) * 0.4); dRail.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
mc_t35 = mc_th(0.35); mc_t35d = 1 - mc_t35 * mc_t35;
mc_rlz = 1;
mc_g = 1; mc_pd = 1; mc_b = 0.03; mc_tb = mc_th(mc_b); mc_lm = 1; mc_dk = 1; mc_cg = 1;

mc_fi = 1;
pdc_delay = os_base + os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(25, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(23));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != mc_sr ? mc_srinit();
mc_now = time_precise();
mc_tp > 0 && mc_now - mc_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > mc_gpp && play_position - mc_gpp < 4 * mc_gpd + 0.05) ? mc_reset();
mc_tp = mc_now; mc_gpp = play_position; mc_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
in_setup(min(max(slider2, -24), 12), slider3 >= 0.5);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider23); pdc_delay = os_base + os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
mc_vs0 = min(max(slider18, 12), 15);
drift_macro(min(max(slider22, 0), 100) * (0.5 + 0.5 * (15 - mc_vs0)));
mc_n = samplesblock / srate;
mc_vs = dSup.drift_tick(0.05 * dm_s * mc_n); mc_vb = dBias.drift_tick(0.04 * dm_s * mc_n); mc_vv = dRail.drift_tick(0.03 * dm_s * mc_n);
mc_fht = min(max(slider4, 20), 800); mc_flt = min(max(slider5, 2000), 22000);
mc_hn = log(mc_fht / 20) / log(40); mc_ln = log(22000 / mc_flt) / log(11);
mc_hont = min(mc_hn * 25, 1); mc_lont = min(mc_ln * 25, 1);
mc_hw2t = mc_hn; mc_hw3t = 0;
mc_lw2t = mc_ln; mc_lw3t = 0;
mc_dvt = min(max(slider6, 0), 10);
mc_padt = 1;
sb_mt = slider7 >= 0.5;
mc_sag = 0.4 * min(sqrt(sg_e) / 0.5, 1) * (1 + 0.6 * (15 - mc_vs0) / 3);
mc_v = max(mc_vs0 - 0.25 * dm_a * (0.5 + 0.5 * mc_vv) - mc_sag, 11);
mc_hb = (15 / mc_v) ^ 1.5; mc_rlz = (15 / mc_v) ^ 2;
mc_lsnt = slider19 >= 0.5;
iIn.ir_tgt(min(max(0.3 + 0.618 * min(max(slider2, -24), 12) / 20, 0), 1), 21, 0.8, 0.1, mc_hb);
iOut.ir_tgt(min(max(0.3 + 0.618 * min(max(slider20, -12), 12) / 20, 0), 1), 19, 2, 0.25, mc_hb);
mc_thrt = min(max(slider8, -40), 0);
mc_slow = slider9 >= 0.5;
mc_rat = slider10 >= 1.5 ? 8 : slider10 >= 0.5 ? 4 : 2;
mc_slpt = 1 - 1 / mc_rat;
mc_rf = slider11 >= 0.5;
mc_hft = min(max(slider12, -15), 15); mc_lft = min(max(slider13, -15), 15);
mc_fzot = 0.33 * min(max((mc_hft - 6) / 9, 0), 1);
mc_mft = min(max(slider14, 40), 16000); mc_mgt = min(max(slider15, -15), 15); mc_mqt = min(max(slider16, 0.4), 10);
mc_ordt = slider17 >= 0.5;
mc_cgt = mc_db(min(max(slider20, -12), 12));
mc_mxt = min(max(slider24, 0), 100) / 100;
mc_dyot = slider25 >= 0.5;
mc_wdt = min(max(slider21, 0), 200) / 100;
mc_mbt = min(max(mc_wdt - 1, 0), 1);
mc_gt = mc_db(mc_dvt * 2.6 + 0.3 * dm_a * mc_vs);
mc_pdt = mc_padt ? SB_PAD * mc_db(1.6 * mc_dvt) : 1;
mc_b = 0.03 + 0.02 * dm_a * mc_vb; mc_tb = mc_th(mc_b);
mc_lmt = mc_lmc(mc_gt, mc_pdt, mc_b);
mc_gtL = log(mc_gt); mc_pdtL = log(mc_pdt); mc_lmtL = log(mc_lmt);
mc_lst = (mc_dvt / 10) ^ 1.2;
mc_lsgt = mc_gt * 0.5 * mc_pdt * (1 - mc_tb * mc_tb) * mc_lmt * mc_db(-1.5 * mc_dvt / 10);
mc_hfat = 0.5 * (max(mc_dvt - 3, 0) / 7) ^ 1.5;
sb_target(14 - 0.6 * mc_dvt - (sb_mode == 1 ? 3 : 0), 0.5 + 0.1 * mc_dvt, mc_padt, 220, mc_hb);
mc_mkt = 0.5 * mc_slpt * max(-18 - mc_thrt, 0);
mc_snap ? (
  mc_fh = mc_fht; mc_fl = mc_flt; mc_hon = mc_hont; mc_lon = mc_lont; mc_hw2 = mc_hw2t; mc_hw3 = mc_hw3t; mc_lw2 = mc_lw2t; mc_lw3 = mc_lw3t;
  mc_g = mc_gt; mc_pd = mc_pdt; mc_lm = mc_lmt; mc_gL = log(mc_gt); mc_pdL = log(mc_pdt); mc_lmL = log(mc_lmt); mc_ls = mc_lst; mc_lsg = mc_lsgt; mc_hfa = mc_hfat; mc_dv = mc_dvt;
  mc_thr = mc_thrt; mc_slp = mc_slpt; mc_mku = mc_mkt;
  mc_hfgn = mc_hft; mc_lfg = mc_lft; mc_mf = mc_mft; mc_mg = mc_mgt; mc_mq = mc_mqt; mc_dyo = mc_dyot; mc_dya = 0; mc_ord = mc_ordt;
  mc_lsn = mc_lsnt; mc_cg = mc_cgt; mc_fzo = mc_fzot; mc_mx = mc_mxt; mc_wd = mc_wdt; mc_mb = mc_mbt;
  iIn.ir_snap(); iOut.ir_snap();
  mc_coef(); sb_rate(mc_fs); sb_snap();
);
mc_snap = 0;
mc_hfg = 2 * mc_g * mc_pd + 1;

mc_v_d = mc_v;
mc_dy_d = mc_dyo * mc_dya;
mc_vu_d = max(mc_vu_d, sqrt(mc_ms / max(samplesblock, 1))); mc_ms = 0;
ost_clipped ? mc_cl_d = 1; ost_clipped = 0;
mc_gr_d = max(mc_gr_d, mc_gro); mc_gro = 0;
os_snapb(slider(23));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
mc_grd(in_l, in_r);
mc_hon += (mc_hont - mc_hon) * c_kn; mc_lon += (mc_lont - mc_lon) * c_kn;
mc_hw2 += (mc_hw2t - mc_hw2) * c_kn; mc_hw3 += (mc_hw3t - mc_hw3) * c_kn; mc_lw2 += (mc_lw2t - mc_lw2) * c_kn; mc_lw3 += (mc_lw3t - mc_lw3) * c_kn;
mc_gL += (mc_gtL - mc_gL) * c_kn; mc_pdL += (mc_pdtL - mc_pdL) * c_kn; mc_lmL += (mc_lmtL - mc_lmL) * c_kn;
mc_g = exp(mc_gL); mc_pd = exp(mc_pdL); mc_lm = exp(mc_lmL);
mc_ls += (mc_lst - mc_ls) * c_kn; mc_lsg += (mc_lsgt - mc_lsg) * c_kn; mc_hfa += (mc_hfat - mc_hfa) * c_kn;
mc_thr += (mc_thrt - mc_thr) * c_kn; mc_slp += (mc_slpt - mc_slp) * c_sw; mc_mku += (mc_mkt - mc_mku) * c_kn;
mc_lsn += (mc_lsnt - mc_lsn) * c_sw;
mc_cg += (mc_cgt - mc_cg) * c_kn; mc_mx += (mc_mxt - mc_mx) * c_kn; mc_fzo += (mc_fzot - mc_fzo) * c_kn; mc_wd += (mc_wdt - mc_wd) * c_kn; mc_mb += (mc_mbt - mc_mb) * c_kn;
sb_glide(c_kn, c_sw);
mc_ordt != mc_ord ? ( mc_dk = max(mc_dk - mc_dks, 0); mc_dk == 0 ? mc_ord = mc_ordt; ) : mc_dk = min(mc_dk + mc_dks, 1);
(mc_tick += 1) >= 32 ? (
  mc_tick = 0;
  mc_fh += (mc_fht - mc_fh) * c_tk; mc_fl += (mc_flt - mc_fl) * c_tk;
  mc_hfgn += (mc_hft - mc_hfgn) * c_tk; mc_lfg += (mc_lft - mc_lfg) * c_tk;
  mc_dyo += (mc_dyot - mc_dyo) * c_tk;
  mc_dyo > 0.0001 ? ( mc_z = 20 * log10(max(mc_dbe, 0.0000001) / max(mc_dfe, 0.0000001)); mc_z = min(max((mc_z + 10) / 8, 0), 1);
    mc_dya += (mc_z * mc_z * (3 - 2 * mc_z) - mc_dya) * c_dy; ) : mc_dya = 0;
  mc_mf *= exp((log(mc_mft) - log(mc_mf)) * c_tk); mc_mg += (mc_mgt - mc_mg) * c_tk; mc_mq *= exp((log(mc_mqt) - log(mc_mq)) * c_tk);
  mc_dv += (mc_dvt - mc_dv) * c_tk;
  mc_coef(); sb_ctl(c_tk);
);
mc_xl = fL.mc_flt(mc_xl); mc_xr = fR.mc_flt(mc_xr);
pwr_in(mc_xl, mc_xr); mc_xl = pwr_l; mc_xr = pwr_r;
abs(mc_xl) < 0.000000000000001 ? mc_xl = 0; abs(mc_xr) < 0.000000000000001 ? mc_xr = 0;
sg_e += (max(mc_xl * mc_xl, mc_xr * mc_xr) - sg_e) * sg_k;
iIn.ir_glide(c_kn); iOut.ir_glide(c_kn);
os_gate();
os_chg ? ( mc_clear(); mc_coef(); sb_rate(mc_fs); os_hold += 2 * samplesblock; );
sb_mt != sb_mode ? (
  st_g = max(st_g - os_gc, 0);
  st_g == 0 ? (
    sb_mode = sb_mt; pdc_delay = os_base + os_lat(os_f);
    mc_clear(); mc_coef(); st_hold = os_base + os_lat(os_f) + 8 + 2 * samplesblock;
  );
) : st_hold > 0 ? st_hold -= 1 : st_g < 1 ? st_g = min(st_g + os_gc, 1);
uxL.os_up(mc_xl); uxR.os_up(mc_xr);
os_f == 1 ? (
  mc_chain(uxL.s0, uxR.s0); mc_yl = mc_pl; mc_yr = mc_pr;
) : (
  mc_chain(uxL.s0, uxR.s0); mc_a0 = mc_pl; mc_r0 = mc_pr;
  mc_chain(uxL.s1, uxR.s1); mc_a1 = mc_pl; mc_r1 = mc_pr;
  os_f == 2 ? ( mc_yl = dnL.os_dn(mc_a0, mc_a1, 0, 0); mc_yr = dnR.os_dn(mc_r0, mc_r1, 0, 0); ) : (
    mc_chain(uxL.s2, uxR.s2); mc_a2 = mc_pl; mc_r2 = mc_pr;
    mc_chain(uxL.s3, uxR.s3); mc_a3 = mc_pl; mc_r3 = mc_pr;
    mc_yl = dnL.os_dn(mc_a0, mc_a1, mc_a2, mc_a3); mc_yr = dnR.os_dn(mc_r0, mc_r1, mc_r2, mc_r3);
  );
);
mc_z = mc_yl - mc_dxl + mc_dcc * mc_dyl; mc_dxl = mc_yl; mc_dyl = mc_z; mc_yl = mc_z;
mc_z = mc_yr - mc_dxr + mc_dcc * mc_dyr; mc_dxr = mc_yr; mc_dyr = mc_z; mc_yr = mc_z;
pwr_out(mc_yl, mc_yr); mc_yl = pwr_l; mc_yr = pwr_r;
mc_z = (mc_yl + mc_yr) * 0.5; mc_a = (mc_yl - mc_yr) * 0.5;
mc_ms1 += (mc_a - mc_ms1) * mc_mbk; mc_ms2 += (mc_ms1 - mc_ms2) * mc_mbk;
mc_a = (mc_a - mc_mb * mc_ms2) * mc_wd; mc_yl = mc_z + mc_a; mc_yr = mc_z - mc_a;
mc_osg = os_g * os_g * (3 - 2 * os_g) * st_g * st_g * (3 - 2 * st_g);
mc_yl *= mc_osg; mc_yr *= mc_osg;
mc_yl != mc_yl ? mc_yl = 0; mc_yr != mc_yr ? mc_yr = 0;
mc_fi < 1 ? (
  mc_fi = min(mc_fi + mc_fis, 1); mc_z = mc_fi * mc_fi * (3 - 2 * mc_fi);
  mc_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; mc_b2 = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  mc_yl = mc_a + (mc_yl - mc_a) * mc_z; mc_yr = mc_b2 + (mc_yr - mc_b2) * mc_z;
);
ost_out(mc_yl, mc_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
mc_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);

@gfx 900 355
ui_begin(900, 355);
mk_face = 0xC69C35; mk_band = 0x1F2B45; mk_ink = 0xF1E6CC; mk_acc = 0xF0A63A; mk_tab = 0xA8321F; mk_tabi = 0xF1E6CC;
mk_sub = 0x1C2538; mk_scale = 0xD8C9A4; mk_fig = 0xB4BCCC;
mk_ink2 = ui_mix(mk_ink, mk_face, 0.4);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 6; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c, i) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
