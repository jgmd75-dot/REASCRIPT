desc:SUM DR2 [summing] (GFX V4)
//tags: summing mixer active analogue bus stems harmonics parallel limiter fet transformer iron colour send mix buss v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-clip, gfx-v4-ui, gfx-v4-panel, gfx-v4-dyn, gfx-v4-os, gfx-v4-bypass, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider25:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,100,1>-Harmonics blend (%)
slider2:0<0,100,1>-Parallel limit blend (%)
slider3:0<0,1,1{Harmonics first,Limit first}>-Order
slider4:0<0,100,1>-Iron (%)
slider5:0<-3,3,0.5>-Output level trim (dB)
slider6:0<0,1,1{Off,On}>-Mono 1-2
slider7:0<0,1,1{Off,On}>-Mono 3-4
slider8:0<0,1,1{Off,On}>-Mono 5-6
slider9:0<0,1,1{Off,On}>-Mono 7-8
slider10:0<0,1,1{Off,On}>-Mono 9-10
slider11:0<0,1,1{Off,On}>-Mono 11-12
slider12:0<0,1,1{Off,On}>-Mono 13-14
slider13:0<0,1,1{Off,On}>-Mono 15-16
slider14:100<0,100,1>-Colour send 1-2 (%)
slider15:100<0,100,1>-Colour send 3-4 (%)
slider16:100<0,100,1>-Colour send 5-6 (%)
slider17:100<0,100,1>-Colour send 7-8 (%)
slider18:100<0,100,1>-Colour send 9-10 (%)
slider19:100<0,100,1>-Colour send 11-12 (%)
slider20:100<0,100,1>-Colour send 13-14 (%)
slider21:100<0,100,1>-Colour send 15-16 (%)
slider22:0<0,1,1{Off,On}>-Bypass
slider23:0<0,2,1{1x,2x,4x}>-Oversampling
slider24:prs_sel=0<0,11,1{No preset,Init,Clean Sum,Harmonics Glow,Harmonics Edge,Parallel Glue,Parallel Smash,Iron Punch,Iron Drive,Full Colour,Full Colour - Limit First,Harmonics and Glue}>-Preset

in_pin:1 (pair 1-2 L)
in_pin:2 (pair 1-2 R)
in_pin:3 (pair 3-4 L)
in_pin:4 (pair 3-4 R)
in_pin:5 (pair 5-6 L)
in_pin:6 (pair 5-6 R)
in_pin:7 (pair 7-8 L)
in_pin:8 (pair 7-8 R)
in_pin:9 (pair 9-10 L)
in_pin:10 (pair 9-10 R)
in_pin:11 (pair 11-12 L)
in_pin:12 (pair 11-12 R)
in_pin:13 (pair 13-14 L)
in_pin:14 (pair 13-14 R)
in_pin:15 (pair 15-16 L)
in_pin:16 (pair 15-16 R)
out_pin:mix L
out_pin:mix R

import gfx-v4-clip.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-dyn.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(33554431, v); );
function psw_allg(v) ( slider_show(33554431, v); );
#ui_man = "gfx-v4-sum-dr2";
ext_noinit = 1;
GDC = 4000; PKM = 4100;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;

function f1(x, b0, b1, a1) instance(s) local(y) ( y = b0 * x + s; s = b1 * x - a1 * y; y; );
function f1i(x, b0, b1, a1) instance(s) local(y) ( y = (x + s) / b0; s = a1 * x - b1 * y; y; );
function d2_ls(fc, g, fs) local(w) ( w = tan($pi * min(fc, 0.45 * fs) / fs);
  d2_q0 = (1 + g * w) / (1 + w); d2_q1 = (g * w - 1) / (1 + w); d2_q2 = (w - 1) / (1 + w); );
function d2_hs(fc, g, fs) local(w) ( w = tan($pi * min(fc, 0.45 * fs) / fs);
  d2_q0 = (g + w) / (1 + w); d2_q1 = (w - g) / (1 + w); d2_q2 = (w - 1) / (1 + w); );
function d2_mlp(fc, fs) local(p, hn) (
  p = exp(-2 * $pi * fc / fs); hn = 1 / sqrt(1 + sqr(fs * 0.5 / fc));
  d2_q0 = ((1 - p) + hn * (1 + p)) * 0.5; d2_q1 = ((1 - p) - hn * (1 + p)) * 0.5; d2_q2 = -p;
);

function d2_pair(a, b) instance(m, tm, s, ts) local(c) (
  m != tm ? ( m += (tm - m) * d2_sm; abs(m - tm) < 0.00001 ? m = tm; );
  m > 0 ? ( c = (a + b) * 0.5; a += (c - a) * m; b += (c - b) * m; );
  s != ts ? ( s += (ts - s) * d2_sm; abs(s - ts) < 0.00001 ? s = ts; );
  s > 0 ? ( d2_xl += a * s; d2_xr += b * s; );
  d2_l = a; d2_r = b;
);

function d2_harm(x) instance(u1) local(u, v, r) (
  u = this.e1.f1(x, d2_el0, d2_el1, d2_el2); u = this.e2.f1(u, d2_eh0, d2_eh1, d2_eh2);
  v = this.cp.clp_pf_run(u * d2_hd);
  r = this.cp.clp_run(v + d2_hb) - d2_hcb - 0.5 * (v + u1); u1 = v;
  r = this.dc.f1(r, d2_dc0, -d2_dc0, d2_dc2);
  r = this.d2.f1i(r, d2_eh0, d2_eh1, d2_eh2); r = this.d1.f1i(r, d2_el0, d2_el1, d2_el2);
  r * d2_hg;
);
function d2_hreset() instance(u1) ( u1 = 0; this.e1.s = this.e2.s = this.d1.s = this.d2.s = this.dc.s = 0;
  this.cp.clp_reset(); this.cp.clp_pf_reset(); );

function d2_lim(l, r) local(k, g, a, b) (
  k = max(abs(l), abs(r));
  k > d2_pe ? d2_pe += (k - d2_pe) * d2_la : d2_pe += (k - d2_pe) * (d2_lrf + (d2_lrs - d2_lrf) * d2_ph);
  g = d2_pe > d2_lt ? max(exp(d2_lx * log(d2_lt / d2_pe)), 0.02) : 1;
  d2_ph = g < 0.6 ? min(d2_ph + d2_phu, 1) : max(d2_ph - d2_phd, 0);
  d2_lgm = min(d2_lgm, g);
  a = l * g * d2_lmk; b = r * g * d2_lmk;
  a += d2_lfe * (1 - g) * a * abs(a); b += d2_lfe * (1 - g) * b * abs(b);
  a = lbL.f1(a, d2_lb0, d2_lb1, d2_lb2); b = lbR.f1(b, d2_lb0, d2_lb1, d2_lb2);
  a = lcL.clp_pf_run(a); b = lcR.clp_pf_run(b);
  d2_wl = a + lcL.clp_run(a) - 0.5 * (a + d2_la1); d2_la1 = a;
  d2_wr = b + lcR.clp_run(b) - 0.5 * (b + d2_lb1x); d2_lb1x = b;
);
function d2_lreset() ( d2_pe = 0; d2_ph = 0; d2_la1 = d2_lb1x = 0; lbL.s = lbR.s = 0;
  lcL.clp_reset(); lcR.clp_reset(); lcL.clp_pf_reset(); lcR.clp_pf_reset(); );

function d2_hrun(l, r) local(g) ( d2_hbe > 0 ? ( g = 1 + 0.05 * d2_hbe;
  d2_l = (l + d2_hbe * hL.d2_harm(l)) * g; d2_r = (r + d2_hbe * hR.d2_harm(r)) * g; ) : ( d2_l = l; d2_r = r; ); );
function d2_prun(l, r) ( d2_pbe > 0 ? ( d2_lim(l, r); d2_l = l + d2_pbe * (d2_wl - l); d2_r = r + d2_pbe * (d2_wr - r); ) : ( d2_l = l; d2_r = r; ); );
function d2_chain(l, r) (
  d2_l = l; d2_r = r;
  d2_fl ? ( d2_prun(d2_l, d2_r); d2_hrun(d2_l, d2_r); ) : ( d2_hrun(d2_l, d2_r); d2_prun(d2_l, d2_r); );
);

function d2_iron(x) instance(lo, lo1, rl) local(u, y) (
  x = this.bp.bq_run(x); x = this.hp.bq_run(x);
  lo += (x - lo) * d2_ilc;
  u = lo * d2_id;
  y = (this.cp.clp_run(u + d2_ib) - d2_icb) / d2_id - 0.5 * (lo + lo1); lo1 = lo;
  rl += (y - rl) * d2_ihy;
  this.hf.f1(x + rl, d2_ih0, d2_ih1, d2_ih2) * d2_img;
);
function d2_ireset() instance(lo, lo1, rl) ( lo = lo1 = rl = 0; this.hf.s = 0;
  this.bp.x1 = this.bp.x2 = this.bp.y1 = this.bp.y2 = 0; this.hp.x1 = this.hp.x2 = this.hp.y1 = this.hp.y2 = 0;
  this.cp.clp_reset(); );

function d2_phase(ml, mr, xl, xr) local(u) (
  d2_chain(xl, xr); ml += d2_l - xl; mr += d2_r - xr;
  u = min(max(ml, -4), 4); ml += u * u * (d2_c2 - d2_c3 * u);
  u = min(max(mr, -4), 4); mr += u * u * (d2_c2 - d2_c3 * u);
  d2_io > 0 ? (
    ml += d2_io * (iL.d2_iron(ml) - ml);
    mr += d2_io * (iR.d2_iron(mr) - mr);
  );
  d2_ol = ml; d2_or = mr;
);

function d2_coef() local(t, fs) (
  d2_sr = srate; d2_of = os_f; fs = srate * os_f; d2_fs = fs;
  d2_sm = 1 - exp(-1 / (0.02 * srate));
  d2_fd = 1 / (0.02 * srate);
  t = tan($pi * 5 / srate); d2_bh0 = 1 / (1 + t); d2_bh2 = (t - 1) / (1 + t);
  d2_mlp(100000, srate); d2_bl0 = d2_q0; d2_bl1 = d2_q1; d2_bl2 = d2_q2;
  d2_ls(150, 1.68, fs); d2_el0 = d2_q0; d2_el1 = d2_q1; d2_el2 = d2_q2;
  d2_hs(4000, 2, fs); d2_eh0 = d2_q0; d2_eh1 = d2_q1; d2_eh2 = d2_q2;
  t = tan($pi * 4 / fs); d2_dc0 = 1 / (1 + t); d2_dc2 = (t - 1) / (1 + t);
  d2_la = 1 - exp(-1 / (0.0002 * fs));
  d2_lrf = 1 - exp(-1 / (0.06 * fs)); d2_lrs = 1 - exp(-1 / (0.38 * fs));
  d2_phu = 1 / (0.6 * fs); d2_phd = 1 / (1.2 * fs);
  d2_hs(4500, 1.5, fs); d2_lb0 = d2_q0; d2_lb1 = d2_q1; d2_lb2 = d2_q2;
  ibL.bq_set(2, 50 / os_f, 0.8, 0.7);
  ihL.bq_set(1, 7 / os_f, 0.55, 0);
  iL.bp.b0 = ibL.b0; iL.bp.b1 = ibL.b1; iL.bp.b2 = ibL.b2; iL.bp.a1 = ibL.a1; iL.bp.a2 = ibL.a2;
  iR.bp.b0 = ibL.b0; iR.bp.b1 = ibL.b1; iR.bp.b2 = ibL.b2; iR.bp.a1 = ibL.a1; iR.bp.a2 = ibL.a2;
  iL.hp.b0 = ihL.b0; iL.hp.b1 = ihL.b1; iL.hp.b2 = ihL.b2; iL.hp.a1 = ihL.a1; iL.hp.a2 = ihL.a2;
  iR.hp.b0 = ihL.b0; iR.hp.b1 = ihL.b1; iR.hp.b2 = ihL.b2; iR.hp.a1 = ihL.a1; iR.hp.a2 = ihL.a2;
  d2_ihy = 1 - exp(-2 * $pi * 300 / fs);
  d2_ilc = 1 - exp(-2 * $pi * 180 / fs);
  d2_fis = 1 / (0.01 * srate);
);

function d2_blk(n) local(k) (
  d2_hcb = hL.cp.clp_crv(d2_hb);
  k = hL.cp.clp_kt_block(0.6, d2_fs, n); hL.cp.clp_knee(k); hR.cp.clp_knee(k);
  hL.cp.clp_pf_block(0.6, d2_fs, n); hR.cp.clp_pf_block(0.6, d2_fs, n);
  lcL.clp_pf_block(0.3, d2_fs, n); lcR.clp_pf_block(0.3, d2_fs, n);
  d2_cb = d2_co;
  d2_id = 1.4 + 5.6 * d2_cb * sqrt(d2_cb);
  d2_ib = 0.03 + 0.06 * d2_cb;
  k = iL.cp.clp_kt_block(d2_cb, d2_fs, n); iL.cp.clp_knee(k); iR.cp.clp_knee(k);
  d2_icb = iL.cp.clp_crv(d2_ib); d2_img = 10 ^ ((-0.3 + 1.0 * d2_cb) / 20);
  d2_mlp(60000 * (18000 / 60000) ^ d2_cb, d2_fs); d2_ih0 = d2_q0; d2_ih1 = d2_q1; d2_ih2 = d2_q2;
);

function d2_update() (
  d2_tbh = min(max(slider1, 0), 100) / 100; d2_tbp = min(max(slider2, 0), 100) / 100;
  d2_tfl = slider3 >= 0.5; d2_tco = min(max(slider4, 0), 100) / 100;
  d2_tio = min(d2_tco * 10, 1);
  d2_ttr = 10 ^ (min(max(slider5, -3), 3) / 20);
  p0.tm = slider6 >= 0.5; p1.tm = slider7 >= 0.5; p2.tm = slider8 >= 0.5; p3.tm = slider9 >= 0.5;
  p4.tm = slider10 >= 0.5; p5.tm = slider11 >= 0.5; p6.tm = slider12 >= 0.5; p7.tm = slider13 >= 0.5;
  p0.ts = min(max(slider14, 0), 100) / 100; p1.ts = min(max(slider15, 0), 100) / 100;
  p2.ts = min(max(slider16, 0), 100) / 100; p3.ts = min(max(slider17, 0), 100) / 100;
  p4.ts = min(max(slider18, 0), 100) / 100; p5.ts = min(max(slider19, 0), 100) / 100;
  p6.ts = min(max(slider20, 0), 100) / 100; p7.ts = min(max(slider21, 0), 100) / 100;
);

function d2_clear() (
  uML.os_clr(); uMR.os_clr(); uXL.os_clr(); uXR.os_clr(); dnL.os_clr(); dnR.os_clr();
  hL.d2_hreset(); hR.d2_hreset(); d2_lreset(); iL.d2_ireset(); iR.d2_ireset();
);
function d2_reset() (
  d2_clear(); memset(BY_BUF, 0, 2 * BY_N); memset(GDC, 0, 32);
  d2_hpx = d2_hpy = d2_hqx = d2_hqy = d2_blx = d2_bly = 0;
  d2_fi = 0;
);

hL.cp.clp_set(2, 1, 1, 0); hR.cp.clp_set(2, 1, 1, 0);
hL.cp.clp_pf_cfg(22000, 14000, -1, 150); hR.cp.clp_pf_cfg(22000, 14000, -1, 150);
hL.cp.clp_kt_cfg(0.4, 0.8); hR.cp.clp_kt_cfg(0.4, 0.8);
lcL.clp_set(1, 1, 1, 0); lcR.clp_set(1, 1, 1, 0);
lcL.clp_pf_cfg(24000, 12000, -1, 120); lcR.clp_pf_cfg(24000, 12000, -1, 120);
iL.cp.clp_set(2, 1, 1, 0); iR.cp.clp_set(2, 1, 1, 0);
iL.cp.clp_kt_cfg(0.3, 0.9); iR.cp.clp_kt_cfg(0.3, 0.9);
d2_hb = 0.2; d2_hd = 1.5; d2_hg = 1.2;
d2_lt = 10 ^ (-24 / 20); d2_lx = 1.12; d2_lmk = 10 ^ (15.5 / 20); d2_lfe = 0.3;
d2_c2 = 0.001; d2_c3 = 0.0018;
gdc_r = 1 - 2 * $pi / srate;

os_design();
os_f = os_tf = os_f2n(slider23); os_base = 0;
d2_coef(); d2_update();
os_gsetup();
d2_fl = d2_tfl; d2_ff = 1;
d2_bh = d2_tbh; d2_bp = d2_tbp; d2_io = d2_tio; d2_co = d2_tco; d2_tr = d2_ttr;
p0.m = p0.tm; p1.m = p1.tm; p2.m = p2.tm; p3.m = p3.tm; p4.m = p4.tm; p5.m = p5.tm; p6.m = p6.tm; p7.m = p7.tm;
p0.s = p0.ts; p1.s = p1.ts; p2.s = p2.ts; p3.s = p3.ts; p4.s = p4.ts; p5.s = p5.ts; p6.s = p6.ts; p7.s = p7.ts;
d2_lgm = 1; d2_gra_d = 1; d2_fi = 1; dv_gr = 1;
d2_clear(); d2_blk(0);
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(22);

function d2_set(hb, pb, fl, co, tr) (
  slider1 = hb; slider2 = pb; slider3 = fl; slider4 = co; slider5 = tr;
  slider_automate(31);
);
#d2_pm = "Init|Clean Sum|Harmonics Glow|Harmonics Edge|Parallel Glue|Parallel Smash|Iron Punch|Iron Drive|Full Colour|Full Colour, Limit First|Harmonics and Glue";
function load_preset(p) local(i) (
  p == 1  ? d2_set( 0,  0, 0,  0, 0) :
  p == 2  ? d2_set( 0,  0, 0,  0, 0) :
  p == 3  ? d2_set(40,  0, 0,  0, 0) :
  p == 4  ? d2_set(85,  0, 0,  0, 0) :
  p == 5  ? d2_set( 0, 25, 0,  0, 0) :
  p == 6  ? d2_set( 0, 55, 0,  0, 0) :
  p == 7  ? d2_set( 0,  0, 0, 20, 0) :
  p == 8  ? d2_set( 0,  0, 0, 75, 0) :
  p == 9  ? d2_set(45, 35, 0, 40, 0) :
  p == 10 ? d2_set(45, 35, 1, 40, 0) :
  p == 11 ? d2_set(60, 25, 0, 30, 0) :
  p == 12 ? (
    d2_set(0, 0, 0, 0, 0);
    i = 6; loop(8, slider(i) = 0; i += 1; );
    i = 14; loop(8, slider(i) = 100; i += 1; );
    slider_automate(2097120);
  );
  pr_cur = p > 11 ? 1 : p;
);

ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(23, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
d2_update();
os_snap(slider(23));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
d2_now = time_precise();
d2_tp > 0 && d2_now - d2_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > d2_gpp && play_position - d2_gpp < 4 * d2_gpd + 0.05) ? d2_reset();
d2_tp = d2_now; d2_gpp = play_position; d2_gpd = samplesblock / srate;
os_tf = os_f2n(slider23);
srate != d2_sr || os_f != d2_of ? ( d2_coef(); d2_clear(); );
dv_ack_d != d2_seen ? ( d2_okl = d2_okr = 0; d2_vs = d2_vn = 0; memset(PKM, 0, 16); d2_seen = dv_ack_d; );
d2_update();
d2_blk(samplesblock * os_f);
hL.cp.clp_tidy(); hR.cp.clp_tidy(); lcL.clp_tidy(); lcR.clp_tidy(); iL.cp.clp_tidy(); iR.cp.clp_tidy();
d2_gb = d2_pbe > 0 ? d2_lgm : 1; d2_lgm = 1;
d2_gra_d = d2_gb < d2_gra_d ? d2_gb : d2_gra_d + (d2_gb - d2_gra_d) * min(samplesblock / (0.05 * srate), 1);
abs(d2_hpx) < 0.000000000001 ? d2_hpx = 0; abs(d2_hpy) < 0.000000000001 ? d2_hpy = 0;
abs(d2_hqx) < 0.000000000001 ? d2_hqx = 0; abs(d2_hqy) < 0.000000000001 ? d2_hqy = 0;
abs(d2_pe) < 0.000000000001 ? d2_pe = 0;
os_snapb(slider(23));

@sample
by_il = spl0 + spl2 + spl4 + spl6 + spl8 + spl10 + spl12 + spl14;
by_ir = spl1 + spl3 + spl5 + spl7 + spl9 + spl11 + spl13 + spl15;
d2_i = 0;
loop(16,
  d2_x = spl(d2_i); d2_x != d2_x ? d2_x = 0;
  PKM[d2_i] = max(PKM[d2_i], abs(d2_x));
  d2_y = d2_x - GDC[d2_i] + gdc_r * GDC[16 + d2_i]; GDC[d2_i] = d2_x; GDC[16 + d2_i] = d2_y; spl(d2_i) = d2_y;
  d2_i += 1;
);
d2_bh += (d2_tbh - d2_bh) * d2_sm; d2_bp += (d2_tbp - d2_bp) * d2_sm;
