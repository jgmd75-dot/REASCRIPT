    ga_cabL.am_cab_set(rp_c == 1 ? 2 : 3, max(rp_mic - 0.15, 0)); ga_cabR.am_cab_set(rp_c == 1 ? 2 : 3, min(rp_mic + 0.15, 10));
  ) : rp_c == 3 ? (
