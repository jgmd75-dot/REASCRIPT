    g1_qt = g1_qd; g1_qc = g1_qdc; g1_pgA = 4.5; g1_pn = (1 + 4.5 * 0.03) / 4.5;
    g1_blk = 0.20; g1_sgd = 0.30; g1_sgk = 0.22;
    g1_sga = 1 - exp(-1 / (0.025 * rp_fs)); g1_sgr = 1 - exp(-1 / (0.38 * rp_fs));
    g1_otk = 1.05; g1_emfl = 3.5; g1_emfh = 2.5;
