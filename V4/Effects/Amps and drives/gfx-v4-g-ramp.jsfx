function g1_bias1(w1, w2, w3) instance(v1a, v1b, v2a, cf) local(a) (
  a = dm_a;
  v1a.g1_stset(g1_vb1 + 0.05 * a * w1); v1b.g1_stset(g1_vb2 + 0.05 * a * w2);
  v2a.g1_stset(g1_vb3 + 0.06 * a * w3); cf.g1_stset(g1_vb4 + 0.03 * a * w1);
