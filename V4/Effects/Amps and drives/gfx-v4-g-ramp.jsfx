    lp_cact = 1;
  ) : lp_cact ? ( lp_cm = lp_m = 0; lp_wcL = lp_wcR = 0; lpBL.lp_bclr(); lpBR.lp_bclr(); lp_cact = 0; );
  lp_rm += ((lp_ron && lp_tyt == lp_ty ? lp_rwt : 0) - lp_rm) * lp_sm;
  lp_rm > 0.00001 || lp_ron ? (
    lp_ty != lp_tyt && lp_rm < 0.0001 ? ( lp_ty = lp_tyt; lp_tset(); );
    w = lrL.rp_spring_run(xl, lp_dw, lp_sa, lp_se); t = lrR.rp_spring_run(xr, lp_dw, lp_sa, lp_se);
    lp_rL = (w + 0.3 * t) * lp_rm; lp_rR = (t + 0.3 * w) * lp_rm;
