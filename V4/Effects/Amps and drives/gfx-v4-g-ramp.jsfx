function mg_mbox(x, y, w, lbl, idx, n, s, t) local(v, i, k, a) (
  v = floor(slider(idx) + 0.5);
  strcpy(#mgb, ""); i = 0; k = 0; a = 0;
  loop(strlen(t), str_getchar(t, i) == 124 ? ( k == v ? strcpy_substr(#mgb, t, a, i - a); k += 1; a = i + 1; ); i += 1; );
  k == v ? strcpy_substr(#mgb, t, a, strlen(t) - a);
