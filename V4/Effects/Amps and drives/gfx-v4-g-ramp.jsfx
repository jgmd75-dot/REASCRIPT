function g1_lot(g) local(k) ( k = (g1_pmod ? G1_LOLEAD : G1_LODOOM) * (g / 10) ^ 1.5; g1_loL.am_bq(3, 9000, 0.7, k, srate); g1_loR.am_bq(3, 9000, 0.7, k, srate); );

function lp_bbd(x, d) instance(buf, wp, p1, p2, q) local(rp, i, f, xm1, x0, x1, x2, y) (
  p1 += (x - p1) * lp_bc; p2 += (p1 - p2) * lp_bc;
  buf[wp] = p2;
