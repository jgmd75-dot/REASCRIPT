    u = cs3.fl_1run(x * fl_kV);
    u = -70 * v2a.fl_strun(u);
    u = ts2.rp_tsrun(u);
    u = vo2.fl_volrun(u);
    u = -45 * v2b.fl_strun(u);
    u = hp2.fl_1run(u);
