  lp_ty = lp_tyt; lp_tset();
  lp_cph = 0; lp_cs = lp_cent; lp_ds = lp_dept; lp_vm = lp_vib;
  lp_cm = lp_con; lp_rm = lp_ron * lp_rwt; lp_cact = lp_ract = 0;
  lp_wcL = lp_wcR = lp_rL = lp_rR = lp_pcL = lp_pcR = lp_prL = lp_prR = lp_aL = lp_aR = 0; lp_m = 0;
);
lp_smk = 0; lp_ldra = lp_ldrr = 0;
function lp_trem() local(s, v) (
  lp_D += (lp_Dt - lp_D) * lp_smk; lp_D < 0.00001 && lp_Dt == 0 ? lp_D = 0;
  lp_st += (lp_stt - lp_st) * lp_smk;
  lp_tph += lp_tinc; lp_tph >= 1 ? lp_tph -= 1;
  s = sin(2 * $pi * lp_tph);
  v = max((s - 0.15) * 1.1764706, 0); v *= sqrt(v);
  lp_g1 += (v - lp_g1) * (v > lp_g1 ? lp_ldra : lp_ldrr);
  v = max((-s - 0.15) * 1.1764706, 0); v *= sqrt(v);
