function lp_host(xl, xr) local(lv, t, w) (
  lp_pcL = lp_wcL; lp_pcR = lp_wcR; lp_prL = lp_rL; lp_prR = lp_rR;
  lp_cm += ((lp_con ? 1 : 0) - lp_cm) * lp_sm;
  lp_cm > 0.00001 ? (
    lp_vm += ((lp_vib ? 1 : 0) - lp_vm) * lp_sm;
    lp_cs += (lp_cent * lp_clk - lp_cs) * lp_sm2; lp_ds += (lp_dept * lp_clk - lp_ds) * lp_sm2;
    lp_cph += lp_cinc; lp_cph >= 1 ? lp_cph -= 1;
    t = 4 * abs(lp_cph - 0.5) - 1; t *= 1.5 - 0.5 * t * t;
    lv = t + (sin(2 * $pi * lp_cph) - t) * lp_vm;
    lp_wcL = lpBL.lp_bbd(xl, (lp_cs + lp_ds * lv) * lp_msr);
    t = lp_cph + 0.25; t -= floor(t); t = 4 * abs(t - 0.5) - 1; t *= 1.5 - 0.5 * t * t;
    lv += (t - lv) * (1 - lp_vm);
    lp_wcR = lpBR.lp_bbd(xr, (lp_cs + lp_ds * lv) * lp_msr);
    lp_m = lp_cm * (0.5 + 0.5 * lp_vm);
