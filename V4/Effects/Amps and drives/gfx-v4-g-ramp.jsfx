function lp_bclr() instance(buf, wp, p1, p2) ( memset(buf, 0, ML_BB); wp = p1 = p2 = 0; this.q.rp_bqclr(); );
function lp_tank(mem, t, k) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc) (
  b1 = mem; n1 = floor((t ? 0.0291 : 0.0371) * k * srate); b2 = mem + n1 + 8; n2 = floor((t ? 0.0337 : 0.0433) * k * srate);
  hp.am_bq(1, t ? 300 : 250, 0.7, 0, srate); lc = 1 - exp(-2 * $pi * (t ? 6200 : 3800) / srate);
  this.rp_spring_clr();
);
function lp_tset() (
  lrL.lp_tank(lp_mL, lp_ty, 1.0); lrR.lp_tank(lp_mR, lp_ty, lp_ty ? 1.0515 : 1.04);
  lp_sa = rp_apa(lp_ty ? 4.263158 : 2.131360); lp_se = rp_apa(lp_ty ? 3 : 1.5);
);
function lp_mem() (
  lpBL.buf = rp_alloc(ML_BB); lpBR.buf = rp_alloc(ML_BB);
  lp_mL = rp_alloc(ceil(0.0836 * 1.06 * srate) + 64); lp_mR = rp_alloc(ceil(0.0836 * 1.06 * srate) + 64);
);
function lp_update() local(c) (
  lp_con = slider38 >= 0.5; lp_vib = slider39 >= 0.5;
  lp_vib ? (
    lp_crate = 0.5 * 20 ^ (slider40 / 10);
    c = 50 * (slider41 / 10) ^ 1.3;
    lp_dept = min((2 ^ (c / 1200) - 1) / (2 * $pi * lp_crate) * 1000, 6);
    lp_cent = lp_dept + 1.3;
  ) : (
    lp_crate = 0.15 * 20 ^ (slider40 / 10);
    lp_dept = 0.4 + 0.3 * slider41;
    lp_cent = 4.6;
  );
  lp_ron = 0; lp_tyt = 0;
  lp_rwt = (3 / 10) ^ 1.5 * (lp_ty ? 1.5 : 0.9); lp_dw = 0.5;
  lp_ton = slider46 >= 0.5;
