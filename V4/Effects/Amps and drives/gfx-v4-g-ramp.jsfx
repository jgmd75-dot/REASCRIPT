    lp_rm = 0; lp_rL = lp_rR = 0; lrL.rp_spring_clr(); lrR.rp_spring_clr();
    lp_ty != lp_tyt ? ( lp_ty = lp_tyt; lp_tset(); ); lp_ract = 0;
  );
);
function lp_mix(k) local(w) (
  w = lp_pcL + (lp_wcL - lp_pcL) * k; lp_l += (w - lp_l) * lp_m;
  w = lp_pcR + (lp_wcR - lp_pcR) * k; lp_r += (w - lp_r) * lp_m;
  lp_l += lp_prL + (lp_rL - lp_prL) * k; lp_r += lp_prR + (lp_rR - lp_prR) * k;
  lp_D > 0 ? ( lp_l *= lp_tgL; lp_r *= lp_tgR; );
);

function rp_tables() (
  rp_nk = rp_alloc(4); rp_nk[0] = 10 ^ (-22.86 / 20); rp_nk[1] = 10 ^ (-29.38 / 20); rp_nk[2] = 10 ^ (-26.27 / 20); rp_nk[3] = 10 ^ (-13.89 / 20);
  rp_zt = rp_alloc(16);
  rp_zt[0] = 0.0; rp_zt[1] = -6.66; rp_zt[2] = 3.66; rp_zt[3] = -9.93;
  rp_zt[4] = 6.73; rp_zt[5] = 0.0; rp_zt[6] = 10.18; rp_zt[7] = -3.26;
  rp_zt[8] = -3.39; rp_zt[9] = -10.09; rp_zt[10] = 0.0; rp_zt[11] = -13.01;
  rp_zt[12] = 10.12; rp_zt[13] = 3.55; rp_zt[14] = 13.96; rp_zt[15] = 0.0;
