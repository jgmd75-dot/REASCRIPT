);
function fl_trow(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = fl_trt + k; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function fl_trim(v, bri) local(i, f, a, b) (
  v = min(max(v, 0), 10); i = min(floor(v), 9); f = v - i;
  a = fl_trt[i] * (1 - f) + fl_trt[i + 1] * f; b = fl_trt[11 + i] * (1 - f) + fl_trt[12 + i] * f;
  a + (b - a) * bri;
);
function fl_tables() (
  fl_qt = rp_alloc(fl_qn + 1); fl_qc = rp_alloc(fl_qn + 1); fl_qbuild();
  fl_trt = rp_alloc(22);
  fl_trow(0, 0, 0, 0, 0, 0, 0, 0, 0.2, 0.33, 0.4, 0.46);
  fl_trow(11, 0, 0, 0.21, 0.48, 1.14, 1.5, 1.32, 1.03, 0.75, 0.6, 0.47);
  fl_tb = rp_alloc(6); fl_tn = rp_alloc(6); fl_tgk = rp_alloc(6); fl_tab = rp_alloc(6); fl_tst = rp_alloc(6);
);
function fl_mem() local(i) (
  fl_tsz = rp_p2(0.08 * 0.5 * 4 * srate); fl_tm = fl_tsz - 1;
  i = 0; loop(6, fl_tb[i] = rp_alloc(fl_tsz); fl_tab[i] = rp_alloc(6 * 32); i += 1; );
);
function fl_fixpre(fs2, fsh) instance(cs1, hp1, cs3, hp2, sh1, sl0, sl1, sh2, hp3) (
  cs1.fl_shset(4.2, 1.9, fs2); hp1.fl_hpset(16, fs2);
  cs3.fl_shset(4.2, 1.9, fs2); hp2.fl_hpset(16, fs2);
  sh1.fl_hpset(260, fsh); sl0.fl_lpset(7000, fsh); sl1.am_bq(0, 4800, 0.7, 0, fsh); sh2.am_bq(1, 380, 0.7, 0, fsh);
  hp3.fl_hpset(14, fs2);
);
function fl_clrpre() instance(v1a, v1b, v2a, v2b, v4b, drv, cs1, hp1, cs3, hp2, sh1, sl0, sl1, sh2, hp3, vo1, vo2, ts1, ts2, sacc, nz, ne, non, von) (
  v1a.fl_stzero(); v1b.fl_stzero(); v2a.fl_stzero(); v2b.fl_stzero(); v4b.fl_stzero(); drv.fl_stzero();
  cs1.fl_1clr(); hp1.fl_1clr(); cs3.fl_1clr(); hp2.fl_1clr(); sh1.fl_1clr(); sl0.fl_1clr(); hp3.fl_1clr();
  sl1.rp_bqclr(); sh2.rp_bqclr(); vo1.x1 = vo1.y1 = vo2.x1 = vo2.y1 = 0; ts1.rp_tsclr(); ts2.rp_tsclr();
  sacc = nz = ne = non = von = 0;
);
fl_kin = 1 / 1.3; fl_eb = 0.25; fl_ksend = 0.05;
function fl_preupd() (
  fl_gNt = RP_ST[28] >= 0.5 || RP_ST[27] < 0.5 ? 1 : 0;
  fl_gVt = RP_ST[28] >= 0.5 || RP_ST[27] >= 0.5 ? 1 : 0;
  fl_stt = RP_ST[42] >= 0.5;
  fl_rate = 1.5 * 6 ^ ((RP_ST[40] - 1) / 9);
  fl_Dt = 10 * sqr((RP_ST[41] - 1) / 9);
  fl_rvt = 1.5 * ((RP_ST[39] - 1) / 9) ^ 1.6;
);
function fl_powupd() (
  fl_pm = 10 ^ ((RP_ST[43] - 5) * 3 / 20); fl_pmk = fl_pm ^ -0.55;
);
function fl_tone(force) local(k, ch) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  fl_s3 += (RP_ST[29] - fl_s3) * k; fl_s4 += (RP_ST[30] - fl_s4) * k; fl_s5 += (RP_ST[31] - fl_s5) * k; fl_s6 += (RP_ST[32] - fl_s6) * k;
  fl_s7 += ((RP_ST[33] >= 0.5) - fl_s7) * k;
  fl_s8 += (RP_ST[34] - fl_s8) * k; fl_s9 += (RP_ST[35] - fl_s9) * k; fl_s10 += (RP_ST[36] - fl_s10) * k; fl_s11 += (RP_ST[37] - fl_s11) * k;
  fl_s12 += ((RP_ST[38] >= 0.5) - fl_s12) * k;
  fl_rvg += (fl_rvt - fl_rvg) * k;
  ch = fl_s3 + 2 * fl_s4 + 3 * fl_s5 + 5 * fl_s6 + 7 * fl_s7 + 11 * fl_s8 + 13 * fl_s9 + 17 * fl_s10 + 19 * fl_s11 + 23 * fl_s12;
  force || abs(ch - fl_lts) > 0.00001 ? (
    fl_lts = ch;
    cL.ts1.fl_tsset((fl_s4 - 1) / 9, (fl_s5 - 1) / 9, (fl_s6 - 1) / 9, rp_fs);
    cL.ts2.fl_tsset((fl_s9 - 1) / 9, (fl_s10 - 1) / 9, (fl_s11 - 1) / 9, rp_fs);
    cL.vo1.fl_volset((fl_s3 - 1) / 9, fl_s7, rp_fs);
    cL.vo2.fl_volset((fl_s8 - 1) / 9, fl_s12, rp_fs);
    cR.ts1.b0 = cL.ts1.b0; cR.ts1.b1 = cL.ts1.b1; cR.ts1.b2 = cL.ts1.b2; cR.ts1.b3 = cL.ts1.b3;
    cR.ts1.a1 = cL.ts1.a1; cR.ts1.a2 = cL.ts1.a2; cR.ts1.a3 = cL.ts1.a3;
    cR.ts2.b0 = cL.ts2.b0; cR.ts2.b1 = cL.ts2.b1; cR.ts2.b2 = cL.ts2.b2; cR.ts2.b3 = cL.ts2.b3;
    cR.ts2.a1 = cL.ts2.a1; cR.ts2.a2 = cL.ts2.a2; cR.ts2.a3 = cL.ts2.a3;
    cR.vo1.k = cL.vo1.k; cR.vo1.kb = cL.vo1.kb; cR.vo1.hb0 = cL.vo1.hb0; cR.vo1.ha1 = cL.vo1.ha1;
    cR.vo2.k = cL.vo2.k; cR.vo2.kb = cL.vo2.kb; cR.vo2.hb0 = cL.vo2.hb0; cR.vo2.ha1 = cL.vo2.ha1;
  );
);
function fl_bias1(w1, w2, w3) instance(v1a, v1b, v2a, v2b, v4b, drv) local(a) (
  a = dm_a;
  v1a.fl_stset(-0.30 + 0.05 * a * w1); v1b.fl_stset(-0.25 + 0.05 * a * w2);
  v2a.fl_stset(-0.30 + 0.05 * a * w2); v2b.fl_stset(-0.25 + 0.05 * a * w1);
  v4b.fl_stset(-0.20 + 0.05 * a * w3); drv.fl_stset(-0.10 + 0.04 * a * w3);
);
function fl_bias2(w3, w4) instance(pin, pa) local(a) (
  a = dm_a;
  pin.fl_syset(0.04 + 0.03 * a * w4);
  pa.fl_paset(0.025 * a * w4);
  pa.sbase = 1 + 0.012 * a * w3;
);
function fl_bias(w) (
  w & 1 ? ( cL.fl_bias1(fl_w1, fl_w2, fl_w3); cR.fl_bias1(fl_w5, fl_w6, fl_w7); );
  w & 2 ? ( fpL.fl_bias2(fl_w3, fl_w4); fpR.fl_bias2(fl_w7, fl_w8); );
);
function fl_drift() local(di) (
  di = 0.2 * dm_s * samplesblock / srate;
  fl_w1 = dw1.drift_tick(di); fl_w2 = dw2.drift_tick(di); fl_w3 = dw3.drift_tick(di); fl_w4 = dw4.drift_tick(di);
  fl_w5 = dw5.drift_tick(di); fl_w6 = dw6.drift_tick(di); fl_w7 = dw7.drift_tick(di); fl_w8 = dw8.drift_tick(di);
  fl_rw = 1 + 0.025 * dm_a * dwr.drift_tick(di * 1.5);
);

function fl_prerate() local(i, ms, fsh) (
  fsh = 0.5 * rp_fs;
  fl_tK = max(1, floor(fsh / 8600 + 0.5));
  i = 0;
  loop(6,
    ms = i == 0 ? 33.1 : i == 1 ? 38.9 : i == 2 ? 45.7 : i == 3 ? 35.3 : i == 4 ? 41.3 : 47.9;
    fl_tn[i] = floor(ms * 0.001 * fsh);
    fl_tgk[i] = 10 ^ (-3 * (ms + 3) * 0.001 / 3.5);
    memset(fl_tb[i], 0, fl_tsz); memset(fl_tab[i], 0, 6 * 32);
    i += 1;
  );
  fl_ta = 0.75;
  fl_tlc = 1 - exp(-2 * $pi * 4200 / fsh);
  fl_tol = 1 - exp(-2 * $pi * 3000 / fsh); fl_toh = 1 - exp(-2 * $pi * 180 / fsh);
  fl_trg = 1.0;
  fl_tw = 0; fl_tp = 0; fl_tph = 0;
  memset(fl_tst, 0, 6);
  tkL.lo = tkL.hi = tkR.lo = tkR.hi = 0;
  cL.fl_clrpre(); cR.fl_clrpre();
  cL.fl_fixpre(rp_fs, fsh); cR.fl_fixpre(rp_fs, fsh);
  fl_rL = fl_rR = fl_rL1 = fl_rR1 = 0;
  fl_k1L.am_bq(2, 0.1875 * srate, 0.336, -0.436, srate); fl_k1R.am_bq(2, 0.1875 * srate, 0.336, -0.436, srate);
  fl_k2L.am_bq(2, 0.2674 * srate, 2.097, 3.834, srate); fl_k2R.am_bq(2, 0.2674 * srate, 2.097, 3.834, srate);
  fl_k3L.am_bq(3, 0.20319 * srate, 0.882, 2.015, srate); fl_k3R.am_bq(3, 0.20319 * srate, 0.882, 2.015, srate);
  fl_k1L.rp_bqclr(); fl_k1R.rp_bqclr(); fl_k2L.rp_bqclr(); fl_k2R.rp_bqclr(); fl_k3L.rp_bqclr(); fl_k3R.rp_bqclr();
  fl_lts = -1; fl_tone(1);
  fl_bias(1);
);
function fl_powrate() (
  fl_xc = 2 * $pi * 40 / rp_fs; fl_xlk = 1 - 2 * $pi * 5 / rp_fs;
  fl_sga = 1 - exp(-1 / (0.012 * rp_fs)); fl_sgr = 1 - exp(-1 / (0.16 * rp_fs));
  fpL.pin.fl_stzero(); fpR.pin.fl_stzero(); fpL.pa.fl_pazero(); fpR.pa.fl_pazero();
  fpL.ot.ph = fpL.ot.sp = fpR.ot.ph = fpR.ot.sp = 0;
  fl_bias(2);
);
ML_BB = 16384; ML_BM = ML_BB - 1;
function ml_hcF(u) ( abs(u) <= 1 ? 1.5 * (0.5 * u * u - u * u * u * u / 12) : abs(u) - 0.375; );
function ml_sc(u) ( u = min(max(u, -1), 1); 1.5 * (u - u * u * u / 3); );
function ml_clip(u) instance(x1, Fa, b1) local(Fv, y, d) (
