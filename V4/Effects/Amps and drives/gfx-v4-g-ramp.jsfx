function ml_pre(x) instance(on, oe, gn, ge, db, rw, nbr, nb, nm, nt, nv1, nv2, ebr, eb, em, et, ev1, ev2, ehp, dpe, dlp, dlp2, dhp, up, dn, ad, rv)
