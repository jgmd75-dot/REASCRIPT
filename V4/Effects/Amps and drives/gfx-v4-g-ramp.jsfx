function rp_block() local(g) (
  rp_p == 0 ? (
    ga_drift(); ga_s_gain = RP_ST[18];
    ga_preupd();
    ga_ghL.ga_v1.ah_tset(ga_b1); ga_ghL.ga_v2.ah_tset(ga_b2); ga_ghR.ga_v1.ah_tset(ga_b1); ga_ghR.ga_v2.ah_tset(ga_b2);
    rpfL.clp_pf_block(ga_gs / 10, srate, samplesblock); rpfR.clp_pf_block(ga_gs / 10, srate, samplesblock);
    ga_s_brt && ga_gs !== ga_lbg ? ( ga_ghL.ga_brt.am_bq(3, 2500, 0.6, 9 * (1 - ga_gs / 13), rp_fs); ga_ghR.ga_brt.am_bq(3, 2500, 0.6, 9 * (1 - ga_gs / 13), rp_fs); );
    ga_lbg = ga_gs;
    rp_ptrim = -ah_trim(ga_s_drive ? 1 : 0, ga_gs);
    g = ga_s_drive ? 3 : 0;
    rp_c == 0 ? (
      rp_ptrim += ah_lo(g + 2, ga_gs);
      ga_gs !== ga_lgs || g !== ga_lk ? ( ga_lgs = ga_gs; ga_lk = g; ga_loL.ah_loset(g, ga_gs); ga_loR.ah_loset(g, ga_gs); );
    );
    rp_pk = 1;
  ) : rp_p == 1 ? (
    fl_drift(); fl_preupd(); fl_tone(0); fl_bias(1);
    fl_tq = fl_trim(fl_s3, fl_s7); fl_tv = fl_trim(fl_s8, fl_s12);
    fl_tq = fl_gNt && fl_gVt ? max(fl_tq, fl_tv) + 0.5 * min(fl_tq, fl_tv) : fl_gNt ? fl_tq : fl_tv;
    rp_ptrim = -fl_tq;
    g = max(fl_gNt ? fl_s3 : 1, fl_gVt ? fl_s8 : 1);
    rpfL.clp_pf_block((g - 1) / 9, srate, samplesblock); rpfR.clp_pf_block((g - 1) / 9, srate, samplesblock);
    fl_isr = fl_rate * fl_rw / srate;
    rp_pk = 0.75;
  ) : rp_p == 2 ? (
    ml_drift(); ml_preupd();
    rp_ptrim = 0; rp_pk = 1;
  ) : (
    g1_drift(); g1_pretone(0); g1_bias(1);
    g1_sg += (RP_ST[62] - g1_sg) * (1 - exp(-samplesblock / (0.025 * srate)));
    abs(g1_sg - RP_ST[62]) < 0.001 ? g1_sg = RP_ST[62];
    g1_tgk = 10 ^ (1.6 * (g1_sg / 10 - 1));
