  ) : (
    g1_c1f = 22; g1_c2f = 30; g1_k2z = 30; g1_k2F = 1.6; g1_k3 = 0.07; g1_mid = 0.52;
    g1_vb1 = -0.30; g1_vb2 = -0.18; g1_vb3 = -0.48; g1_vb4 = -0.06;
  );
  g1L.cp1.fl_hpset(g1_c1f, rp_fs); g1R.cp1.fl_hpset(g1_c1f, rp_fs);
