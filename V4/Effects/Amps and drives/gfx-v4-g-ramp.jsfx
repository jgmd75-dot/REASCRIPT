  wp = (wp + 1) & ML_BM;
  y = (((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f + 0.5 * (x1 - xm1)) * f + x0;
  y = min(max(y, -3), 3); y = y * (27 + y * y) / (27 + 9 * y * y);
  this.q.am_run(y);
