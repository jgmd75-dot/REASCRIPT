function g1_pretone(force) local(k, ch, i, f, gd) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  g1_s3 += (RP_ST[63] - g1_s3) * k; g1_s4 += (RP_ST[64] - g1_s4) * k; g1_s5 += (RP_ST[65] - g1_s5) * k;
  g1_sm += (g1_mid - g1_sm) * k;
