desc:G Ramp [guitar amp] (GFX V4)
//tags: amp amplifier guitar valve solid state head combo cabinet chorus spring reverb tremolo modular v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)

// Requires gfx-v4-drift, gfx-v4-input, gfx-v4-output, gfx-v4-ui, gfx-v4-panel, gfx-v4-amp, gfx-v4-clip, gfx-v4-os, gfx-v4-power, gfx-v4-bypass, gfx-v4-sliders (.jsfx-inc) in the same folder.

import gfx-v4-drift.jsfx-inc
import gfx-v4-input.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-amp.jsfx-inc
import gfx-v4-clip.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sliders.jsfx-inc

slider51:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,3,1{Amp Head,Fullerton 65,Mali 120,GR-120}>-Preamp
slider2:0<0,3,1{Amp Head,Fullerton 65,Mali 120,GR-120}>-Power amp
slider3:1<0,6,1{Off (line out),2x12 open (Amp Head),4x12 closed (Amp Head),2x12 open (Fullerton 65),2x12 (Mali 120),2x8 (Mali 55),4x12 closed (GR-120)}>-Cabinet
slider4:3<0,10,0.1>-Mic position (on - off axis)
slider5:100<0,100,1>-Width (%)
slider6:0<0,1,1{Off,On}>-Mono in
slider7:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider8:0<0,2,1{1x,2x,4x}>-Oversampling
slider9:0<-24,12,0.1>-Input trim (dB)
slider10:0<0,1,1{Off,On}>-Input guard
slider11:50<0,100,1>-Drift (%)
slider12:0<-24,12,0.1>-Output (dB)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-Ceiling (dB)
slider18:5<-12,12,0.1>-Preamp control 1
slider19:0<-12,12,0.1>-Preamp control 2
slider20:0<-12,12,0.1>-Preamp control 3
slider21:5<-12,12,0.1>-Preamp control 4
slider22:5<-12,12,0.1>-Preamp control 5
slider23:5<-12,12,0.1>-Preamp control 6
slider24:2<-12,12,0.1>-Preamp control 7
slider25:0<-12,12,0.1>-Preamp control 8
slider26:0<-12,12,0.1>-Preamp control 9
slider27:0<-12,12,0.1>-Preamp control 10
slider28:0<-12,12,0.1>-Preamp control 11
slider29:0<-12,12,0.1>-Preamp control 12
slider30:0<-12,12,0.1>-Preamp control 13
slider31:0<-12,12,0.1>-Preamp control 14
slider32:0<-12,12,0.1>-Preamp control 15
slider33:0<-12,12,0.1>-Preamp control 16
slider34:5<-12,12,0.1>-Power amp control 1
slider35:4<-12,12,0.1>-Power amp control 2
slider36:0<-12,12,0.1>-Power amp control 3
slider38:0<0,1,1{Off,On}>-Loop chorus
slider39:0<0,1,1{Chorus,Vibrato}>-Loop chorus mode
slider40:5<0,10,0.1>-Loop chorus speed
slider41:5<0,10,0.1>-Loop chorus depth
slider46:0<0,1,1{Off,On}>-Loop tremolo
slider47:5<1,10,0.1>-Loop tremolo speed
slider48:5<1,10,0.1>-Loop tremolo intensity
slider49:0<0,1,1{Off,On}>-Loop tremolo stereo
slider50:prs_sel=0<0,13,1{No preset,Init,Fullerton Clean,Mali Chorus,Head Crunch,GR Doom,GR Lead,Black Panel Crunch,Chorus Stack,Fizz Wall,Surf Trem,Vibrato Drive,Small Box Lead,Ambient Clean}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(2251731094208511, v); );
function psw_allg(v) ( slider_show(2251731094208511, v); );
#ui_man = "gfx-v4-g-ramp";
ext_noinit = 1;

rp_dn = 0.000000000000000001;
function rp_alloc(n) local(p) ( p = rp_nm; rp_nm += n; memset(p, 0, n); p; );
function rp_p2(n) local(p) ( p = 1; while (p < n) ( p *= 2; ); p; );
function rp_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function rp_apa(d) ( (d - 1) / (d + 1); );
function rp_spring_run(x, dwell, sa, se) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) local(y, s1, s2, fb) (
  y = hp.am_run(x);
  y = d6.am_ap1(d5.am_ap1(d4.am_ap1(d3.am_ap1(d2.am_ap1(d1.am_ap1(y, sa), sa), sa), sa), sa), sa);
  fb = 0.55 + 0.35 * dwell;
  s1 = b1[w1]; s2 = b2[w2];
  lp1 += (s1 - lp1) * lc; lp2 += (s2 - lp2) * lc;
  b1[w1] = y + e1.am_ap1(e2.am_ap1(lp2 * fb, se), se);
  b2[w2] = y + e3.am_ap1(e4.am_ap1(lp1 * fb, se), se);
  w1 += 1; w1 >= n1 ? w1 = 0; w2 += 1; w2 >= n2 ? w2 = 0;
  (s1 + s2) * 0.5;
);
function rp_spring_clr() instance(b1, b2, n1, n2, w1, w2, lp1, lp2, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) (
  memset(b1, 0, n1 + 8); memset(b2, 0, n2 + 8); w1 = w2 = 0; lp1 = lp2 = 0;
  d1.z = d2.z = d3.z = d4.z = d5.z = d6.z = e1.z = e2.z = e3.z = e4.z = 0;
  this.hp.rp_bqclr();
);

function ah_tset(b) instance(tb, tt, tn, u1, f1) local(a) (
  b !== tb ? (
    u1 += b - tb; tb = b; tt = am_tanh(b); tn = 1 / (1 - tt * tt);
    a = abs(u1); f1 = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  );
);
function ah_tube(x) instance(tb, tt, tn, u1, f1) local(u, a, f, d, y) (
  u = x + tb; a = abs(u);
  f = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : am_tanh(0.5 * (u + u1));
  u1 = u; f1 = f;
  (y - tt) * tn;
);
function ah_tzero() instance(tb, tt, tn, u1, f1) ( tb = tt = u1 = f1 = 0; tn = 1; );
function ah_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = ah_trt + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function ah_trim(k, v) local(p, i, f, q) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i; q = ah_trt + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
function ah_lo(k, v) ( ah_trim(k + 3, v); );
function ah_loset(k, g) instance(s1, s2) (
  s1.am_bq(3, 0.25 * srate, 0.8, ah_lo(k, g), srate); s2.am_bq(2, 0.1666667 * srate, 0.7, ah_lo(k + 1, g), srate);
);
function ah_tables() (
  ah_trt = rp_alloc(15 * 11);
  ah_row(0, 0, 0, 0, 0, 0, 0, 0.05, 0.17, 0.34, 0.58, 0.82);
  ah_row(1, 0, 0, 0, 0, 0.02, 0.09, 0.17, 0.23, 0.29, 0.33, 0.36);
  ah_row(2, 0, 0, 0, 0, 0, 0, 0.05, 0.14, 0.24, 0.43, 0.65);
  ah_row(3, -2.66, -2.48, -1.93, -1.12, -0.05, 1.26, 2.74, 4.23, 5.45, 6.09, 6.06);
  ah_row(4, -0.73, -0.68, -0.62, -0.52, -0.38, -0.18, 0.09, 0.43, 0.84, 1.28, 1.70);
  ah_row(5, 0.12, 0.14, 0.16, 0.17, 0.16, 0.12, 0.08, 0.04, -0.04, -0.10, -0.18);
  ah_row(6, 6.97, 7.33, 6.92, 5.12, 1.67, -1.83, -3.85, -4.97, -5.64, -6.01, -6.23);
  ah_row(7, 0.58, 0.56, 0.66, 0.87, 1.06, 0.98, 0.75, 0.54, 0.45, 0.51, 0.70);
  ah_row(8, -0.02, -0.01, -0.02, -0.07, -0.13, -0.14, -0.10, -0.07, -0.02, 0.01, 0.01);
);
function ga_xf_run(ga_x, ga_k) instance(ga_ph, ga_sp) local(ga_s, ga_y) (
  ga_ph = ga_ph * ga_xf_lk + ga_x * ga_xf_c; ga_s = am_tanh(ga_ph * ga_k) / ga_k; ga_y = (ga_s - ga_sp * ga_xf_lk) / ga_xf_c; ga_sp = ga_s; ga_y;
);
function ga_pre(ga_x) instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt, ga_rv, ga_py, ga_ry, ga_v1, ga_v2) local(ga_y) (
  ga_y = ga_ihp.am_run(ga_x);
  ga_y = ga_brt.am_run(ga_y);
  ga_y = ga_v1.ah_tube(ga_y * ga_g1);
  ga_y = ga_mil.am_run(ga_y);
  ga_s_drive ? (
    ga_y = ga_d2hp.am_run(ga_y); ga_y = ga_d2lp.am_run(ga_y);
    ga_y = ga_v2.ah_tube(ga_y * ga_g2) * ga_c2;
  ) : (
    ga_y *= ga_c1;
  );
  ga_y = ga_tb.am_run(ga_y); ga_y = ga_tm.am_run(ga_y); ga_y = ga_tt.am_run(ga_y);
  ga_py = ga_y; ga_ry = ga_rv.rp_spring_run(ga_y, 0.5, ah_sa, ah_se);
);
function ga_preset() instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt) (
  ga_ihp.am_bq(1, 70, 0.7, 0, rp_fs);
  ga_brt.am_bq(3, 2500, 0.6, ga_s_brt ? 9 * (1 - ga_gs / 13) : 0, rp_fs);
  ga_mil.am_bq(0, ga_s_drive ? 9000 : 12000, 0.7, 0, rp_fs);
  ga_d2hp.am_bq(1, 160, 0.7, 0, rp_fs);
  ga_d2lp.am_bq(0, 6500, 0.7, 0, rp_fs);
  ga_tb.am_bq(4, 110, 0.7, (RP_ST[21] - 5) * 2.4, rp_fs);
  ga_tm.am_bq(2, 700, 0.8, (RP_ST[22] - 5) * 2.4 - 2, rp_fs);
  ga_tt.am_bq(3, 3200, 0.7, (RP_ST[23] - 5) * 2.4, rp_fs);
);
function ga_gset() (
  ga_g1 = exp(0.1151292546 * (ga_gs * 3.4 - 4)); ga_c1 = 1 / sqrt(ga_g1);
  ga_g2 = exp(0.1151292546 * (ga_gs * 1.4 + 6)); ga_c2 = 0.32 * max(1, 2.2 - ga_gs * 0.3);
);
function ga_pow(ga_y) instance(ga_phc, ga_pres, ga_xfo, ga_pa, ga_vpi, ga_vpw) (
  ga_y = ga_vpi.ah_tube(ga_y * 0.9);
  ga_y = ga_phc.am_run(ga_y) * ga_pm;
  ga_y = ga_sup * ga_vpw.ah_tube(ga_y / ga_sup);
  ga_pa = abs(ga_y);
  ga_y = ga_pres.am_run(ga_y);
  ga_y = ga_xfo.ga_xf_run(ga_y + ga_pbias * ga_y * ga_y, 0.6);
  ga_y * ga_mk;
);
function ga_powset() instance(ga_phc, ga_pres) (
  ga_pres.am_bq(3, 4500, 0.7, RP_ST[25] * 1.1 - 3, rp_fs);
  ga_phc.am_bq(1, 40, 0.7, 0, rp_fs);
);
function ga_sag() local(ga_a) (
  ga_a = max(ga_pwL.ga_pa, ga_pwR.ga_pa);
  ga_sgenv += (ga_a - ga_sgenv) * (ga_a > ga_sgenv ? ga_sg_att : ga_sg_rel);
  ga_sup = 1 - 0.35 * min(ga_sgenv, 1);
);
function ga_tank(ga_mem, ga_k) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc) (
  b1 = ga_mem; n1 = floor(0.0371 * ga_k * rp_fs); b2 = ga_mem + n1 + 8; n2 = floor(0.0433 * ga_k * rp_fs);
  memset(ga_mem, 0, n1 + n2 + 16); w1 = 0; w2 = 0; lp1 = 0; lp2 = 0;
  hp.am_bq(1, 250, 0.7, 0, rp_fs); lc = 1 - exp(-2 * $pi * 3800 / rp_fs);
);
function ga_mem() ( ga_mL = rp_alloc(ceil(0.0836 * 1.05 * 4 * srate) + 64); ga_mR = rp_alloc(ceil(0.0836 * 1.05 * 4 * srate) + 64); );
function ga_prerate() (
  ah_sa = rp_apa(2.131360 * os_f); ah_se = rp_apa(1.5 * os_f);
  ga_ghL.ga_v1.ah_tzero(); ga_ghL.ga_v2.ah_tzero(); ga_ghR.ga_v1.ah_tzero(); ga_ghR.ga_v2.ah_tzero();
  ga_ghL.ga_v1.ah_tset(ga_b1); ga_ghL.ga_v2.ah_tset(ga_b2); ga_ghR.ga_v1.ah_tset(ga_b1); ga_ghR.ga_v2.ah_tset(ga_b2);
  ga_ghL.ga_rv.ga_tank(ga_mL, 1.0); ga_ghR.ga_rv.ga_tank(ga_mR, 1.04);
  ga_ghL.ga_ihp.rp_bqclr(); ga_ghL.ga_brt.rp_bqclr(); ga_ghL.ga_mil.rp_bqclr(); ga_ghL.ga_d2hp.rp_bqclr(); ga_ghL.ga_d2lp.rp_bqclr();
  ga_ghL.ga_tb.rp_bqclr(); ga_ghL.ga_tm.rp_bqclr(); ga_ghL.ga_tt.rp_bqclr();
  ga_ghR.ga_ihp.rp_bqclr(); ga_ghR.ga_brt.rp_bqclr(); ga_ghR.ga_mil.rp_bqclr(); ga_ghR.ga_d2hp.rp_bqclr(); ga_ghR.ga_d2lp.rp_bqclr();
  ga_ghR.ga_tb.rp_bqclr(); ga_ghR.ga_tm.rp_bqclr(); ga_ghR.ga_tt.rp_bqclr();
  ga_ghL.ga_rv.d1.z = ga_ghL.ga_rv.d2.z = ga_ghL.ga_rv.d3.z = ga_ghL.ga_rv.d4.z = ga_ghL.ga_rv.d5.z = ga_ghL.ga_rv.d6.z = 0;
  ga_ghL.ga_rv.e1.z = ga_ghL.ga_rv.e2.z = ga_ghL.ga_rv.e3.z = ga_ghL.ga_rv.e4.z = 0; ga_ghL.ga_rv.hp.rp_bqclr();
  ga_ghR.ga_rv.d1.z = ga_ghR.ga_rv.d2.z = ga_ghR.ga_rv.d3.z = ga_ghR.ga_rv.d4.z = ga_ghR.ga_rv.d5.z = ga_ghR.ga_rv.d6.z = 0;
  ga_ghR.ga_rv.e1.z = ga_ghR.ga_rv.e2.z = ga_ghR.ga_rv.e3.z = ga_ghR.ga_rv.e4.z = 0; ga_ghR.ga_rv.hp.rp_bqclr();
  ga_ghL.ga_py = ga_ghL.ga_ry = ga_ghR.ga_py = ga_ghR.ga_ry = 0;
  ga_ghL.ga_preset(); ga_ghR.ga_preset();
  ga_k1L.am_bq(2, 0.28304 * srate, 1.05, 13.43, srate); ga_k1R.am_bq(2, 0.28304 * srate, 1.05, 13.43, srate);
  ga_k2L.am_bq(3, 0.19492 * srate, 0.44, 1.05, srate); ga_k2R.am_bq(3, 0.19492 * srate, 0.44, 1.05, srate);
  ga_k1L.rp_bqclr(); ga_k1R.rp_bqclr(); ga_k2L.rp_bqclr(); ga_k2R.rp_bqclr();
  ga_loL.s1.rp_bqclr(); ga_loL.s2.rp_bqclr(); ga_loR.s1.rp_bqclr(); ga_loR.s2.rp_bqclr(); ga_lgs = -1;
);
function ga_powrate() (
  ga_xf_c = 2 * $pi * 40 / rp_fs; ga_xf_lk = 1 - 2 * $pi * 5 / rp_fs;
  ga_sg_att = 1 - exp(-1 / (0.004 * rp_fs)); ga_sg_rel = 1 - exp(-1 / (0.09 * rp_fs));
  ga_sup = 1; ga_sgenv = 0;
  ga_pwL.ga_vpi.ah_tzero(); ga_pwL.ga_vpw.ah_tzero(); ga_pwR.ga_vpi.ah_tzero(); ga_pwR.ga_vpw.ah_tzero();
  ga_pwL.ga_vpi.ah_tset(-0.04); ga_pwL.ga_vpw.ah_tset(0.22); ga_pwR.ga_vpi.ah_tset(-0.04); ga_pwR.ga_vpw.ah_tset(0.22);
  ga_pwL.ga_phc.rp_bqclr(); ga_pwL.ga_pres.rp_bqclr(); ga_pwR.ga_phc.rp_bqclr(); ga_pwR.ga_pres.rp_bqclr();
  ga_pwL.ga_xfo.ga_ph = ga_pwL.ga_xfo.ga_sp = ga_pwR.ga_xfo.ga_ph = ga_pwR.ga_xfo.ga_sp = 0; ga_pwL.ga_pa = ga_pwR.ga_pa = 0;
  ga_pwL.ga_powset(); ga_pwR.ga_powset();
);
function ga_preupd() (
  ga_s_gain = RP_ST[18]; ga_s_brt = RP_ST[19] >= 0.5; ga_s_drive = RP_ST[20] >= 0.5;
  ga_rvw = (RP_ST[24] / 10) ^ 1.5 * 0.9;
  ga_ghL.ga_preset(); ga_ghR.ga_preset();
);
function ga_powupd() (
  ga_pm = 10 ^ ((RP_ST[26] * 3.2 - 14) / 20); ga_mk = 0.5 / (ga_pm ^ 0.55);
  ga_pwL.ga_powset(); ga_pwR.ga_powset();
);
function ga_drift() (
  ga_dinc = 0.25 * dm_s * samplesblock / srate;
  ga_dv1 = ga_dB1.drift_tick(ga_dinc); ga_dv2 = ga_dB2.drift_tick(ga_dinc);
  ga_b1 = 0.15 + 0.06 * 0.25 * dm_a * ga_dv1;
  ga_b2 = 0.20 + 0.05 * 0.25 * dm_a * ga_dv2;
  ga_pbias = 0.02 * 0.25 * dm_a * ga_dv2;
);
function ga_glide() (
  ga_gs !== ga_s_gain ? ( ga_gs += (ga_s_gain - ga_gs) * rp_gk; abs(ga_gs - ga_s_gain) < 0.00001 ? ga_gs = ga_s_gain; ga_gset(); );
);

function fl_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function fl_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function fl_tg(u) ( u >= 0 ? fl_th(u) : 1.8 * fl_th(u * 0.5555556) );
function fl_tgd(u) ( u >= 0 ? fl_thd(u) : fl_thd(u * 0.5555556) );
function fl_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function fl_tgF(u) ( u >= 0 ? fl_F(u) : 3.24 * fl_F(u * 0.5555556) );
function fl_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = fl_tgF(u1); b0 = b; g0 = fl_tg(b); n0 = 1 / max(fl_tgd(b), 0.05); );
function fl_strun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + fl_eb * (x - xp) + b0; xp = x; ga = fl_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : fl_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
function fl_strest() instance(b0, u1, ga1, xp) ( u1 = b0; ga1 = fl_tgF(b0); xp = 0; );
function fl_stzero() instance(b0, g0, n0, u1, ga1, xp) ( b0 = u1 = ga1 = xp = g0 = 0; n0 = 1; );
function fl_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = fl_F(u1); b0 = b; g0 = fl_th(b); n0 = 1 / max(fl_thd(b), 0.05); );
function fl_syrun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + fl_eb * (x - xp) + b0; xp = x; ga = fl_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : fl_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
function fl_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function fl_1clr() instance(x1, y1) ( x1 = y1 = 0; );
function fl_shset(fz, Fk, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * Fk;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function fl_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
function fl_lpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * min(f, 0.45 * fs);
  b0 = w / (c + w); b1 = b0; a1 = (w - c) / (c + w);
);
function fl_volset(p, bri, fs) instance(k, hb0, ha1, kb) local(fr, Ra, Rb, tp, c, w) (
  fr = p <= 0 ? 0 : (10 ^ (2 * p) - 1) / 99;
  Rb = fr * 1000000; Ra = (1 - fr) * 1000000;
  k = fr; kb = bri * (1 - fr);
  tp = max(Ra * Rb / (Ra + Rb + 1) * 0.00000000012, 0.0000000001);
  c = 2 * fs; w = 1 / tp;
  hb0 = c / (c + w); ha1 = (w - c) / (c + w);
);
function fl_volrun(x) instance(k, hb0, ha1, kb, x1, y1) local(h) (
  h = hb0 * (x - x1) - ha1 * y1; x1 = x; y1 = h;
  k * x + kb * h;
);
function rp_tsset(t, m, l, fs, Ca, Cb, Cc, R1, R2, R3, R4) instance(b0, b1, b2, b3, a1, a2, a3)
  local(nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*Ca*R1 + m*Cc*R3 + l*(Ca*R2 + Cb*R2) + (Ca*R3 + Cb*R3);
  nb2 = t*(Ca*Cb*R1*R4 + Ca*Cc*R1*R4) - m*m*(Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + m*(Ca*Cc*R1*R3 + Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + l*(Ca*Cb*R1*R2 + Ca*Cb*R2*R4 + Ca*Cc*R2*R4)
     + l*m*(Ca*Cc*R2*R3 + Cb*Cc*R2*R3)
     + (Ca*Cb*R1*R3 + Ca*Cb*R3*R4 + Ca*Cc*R3*R4);
  nb3 = l*m*(Ca*Cb*Cc*R1*R2*R3 + Ca*Cb*Cc*R2*R3*R4)
     - m*m*(Ca*Cb*Cc*R1*R3*R3 + Ca*Cb*Cc*R3*R3*R4)
     + m*(Ca*Cb*Cc*R1*R3*R3 + Ca*Cb*Cc*R3*R3*R4)
     + t*Ca*Cb*Cc*R1*R3*R4 - t*m*Ca*Cb*Cc*R1*R3*R4
     + t*l*Ca*Cb*Cc*R1*R2*R4;
  da0 = 1;
  da1 = (Ca*R1 + Ca*R3 + Cb*R3 + Cb*R4 + Cc*R4) + m*Cc*R3 + l*(Ca*R2 + Cb*R2);
  da2 = m*(Ca*Cc*R1*R3 - Cb*Cc*R3*R4 + Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + l*m*(Ca*Cc*R2*R3 + Cb*Cc*R2*R3)
     - m*m*(Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + l*(Ca*Cb*R2*R4 + Ca*Cb*R1*R2 + Ca*Cc*R2*R4 + Cb*Cc*R2*R4)
     + (Ca*Cb*R1*R4 + Ca*Cc*R1*R4 + Ca*Cb*R3*R4 + Ca*Cb*R1*R3 + Ca*Cc*R3*R4 + Cb*Cc*R3*R4);
  da3 = l*m*(Ca*Cb*Cc*R1*R2*R3 + Ca*Cb*Cc*R2*R3*R4)
     - m*m*(Ca*Cb*Cc*R1*R3*R3 + Ca*Cb*Cc*R3*R3*R4)
     + m*(Ca*Cb*Cc*R3*R3*R4 + Ca*Cb*Cc*R1*R3*R3 - Ca*Cb*Cc*R1*R3*R4)
     + l*Ca*Cb*Cc*R1*R2*R4
