    rpfL.clp_pf_block(g1_sg / 10, srate, samplesblock); rpfR.clp_pf_block(g1_sg / 10, srate, samplesblock);
    rp_ptrim = 20 * log10(g1_mkup(g1_pmod, g1_sg)); rp_pk = 1;
  );
  rp_w == 0 ? (
