function g1_stzero() instance(b0, g0, n0, u1, ga1, xp) ( b0 = u1 = ga1 = xp = g0 = 0; n0 = 1; );
function g1_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = g1_F(u1); b0 = b; g0 = g1_th(b); n0 = 1 / max(g1_thd(b), 0.05); );
