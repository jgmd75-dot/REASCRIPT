    rp_wtrim = 0; rp_wk = 1;
  ) : (
    rp_p != 3 ? g1_drift();
    g1_powupd(); g1_powtone(0); g1_bias(2);
    rp_wtrim = -g1_mtrim(RP_ST[75], rp_p == 3 ? g1_sg : 5); rp_wk = 1;
  );
  rp_kin = rp_nk[rp_w] / rp_nk[rp_p];
  rp_tg = rp_out * rp_pk * rp_wk * 10 ^ ((rp_ptrim + rp_wtrim + rp_zt[rp_p * 4 + rp_w]) / 20);
