  p == 3  ? ( dq_setA(1, 1, 14, 100,  0.4, 1.0, -1.0,  320,    0); dq_setB(0, 0,  8, 100,  0,    0,    0, 1000,    0); dq_setG(1, 0, 0, 40); ) :
