desc:Drive81 [studio drive] (GFX V4)
//tags: drive saturation distortion overdrive clipper console transformer studio parallel eq v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-drift, gfx-v4-output, gfx-v4-ui, gfx-v4-panel, gfx-v4-dyn, gfx-v4-os, gfx-v4-power, gfx-v4-bypass, gfx-v4-sliders (.jsfx-inc) in the same folder.
slider34:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:1<0,1,1{Off,On}>-Drive81 on
slider2:1<0,1,1{VFD,Matrix}>-Mode
slider3:0<0,3,1{Studio Clean Boost,Germanium Console,Op-Amp Line Driver,Transistor Matrix}>-Drive81 circuit
slider4:8<0,30,0.1>-Drive81 drive (dB)
slider5:100<0,100,1>-Drive81 blend (%)
slider6:0<-24,12,0.1>-Drive81 output (dB)
slider7:0<-15,15,0.1>-Drive81 low (dB)
slider8:0<-15,15,0.1>-Drive81 mid (dB)
slider9:1000<200,8000,1>-Drive81 mid freq (Hz)
slider10:0<-15,15,0.1>-Drive81 high (dB)
slider11:1<0,1,1{Off,On}>-JDM-81 on
slider12:0<0,1,1>-(unused, was JDM-81 style)
slider13:0<0,3,1{Console Overdrive,Broadcast Limiter Drive,Harmonic Dissonance,Starved Rail}>-JDM-81 circuit
slider14:8<0,30,0.1>-JDM-81 drive (dB)
slider15:100<0,100,1>-JDM-81 blend (%)
slider16:0<-24,12,0.1>-JDM-81 output (dB)
slider17:0<-15,15,0.1>-JDM-81 low (dB)
slider18:0<-15,15,0.1>-JDM-81 mid (dB)
slider19:1000<200,8000,1>-JDM-81 mid freq (Hz)
slider20:0<-15,15,0.1>-JDM-81 high (dB)
slider21:0<0,1,1{Drive81 first,JDM-81 first}>-Order
slider22:0<-24,12,0.1>-Input trim (dB)
slider23:50<0,100,1>-Drift (%)
slider24:0<-24,12,0.1>-Output (dB)
slider25:0<0,100,1>-Band sat (%)
slider26:30<0,100,1>-Bias (%)
slider27:120<40,400,1>-Sat low band (Hz)
slider28:6000<2000,16000,10>-Sat high band (Hz)
slider29:-0.3<-24,0,0.1>-Ceiling (dB)
slider30:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider31:1<0,2,1{1x,2x,4x}>-Oversampling
slider32:prs_sel=0<0,12,1{No preset,Init,Bus Warmth,Germanium Glue,Line Driver Snare,Matrix Bass,Console Vocal,Broadcast Slam Drums,Dissonant Synth,Starved Kick,Parallel Crunch,TKY-Berlin Chain,Full Melt}>-Preset
slider33:0<0,1,1{Off,On}>-Bypass

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-drift.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-dyn.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(17179869183, v); );
function psw_allg(v) ( slider_show(17179869183, v); );
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
#ui_man = "gfx-v4-drive81";
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
dq_EQ = alloc(32);
dq_MKT = alloc(192);
dq_VPA = alloc(8); dq_VPB = alloc(8);
dq_VC = alloc(40);
dq_eg = alloc(8);
dq_ostm = alloc(4096);

os_design(); os_base = 0; os_f = os_tf = os_f2n(slider31);

function dq_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function dq_cv(x, d, b) local(z0) (
  z0 = min(max(d * b, -2.9), 2.9);
  (dq_th(d * (x + b)) - dq_th(z0)) * 9 * sqr(3 + z0 * z0) / (d * sqr(9 - z0 * z0));
);
function dq_cvr(d, b) local(z0) (
  z0 = min(max(d * b, -2.9), 2.9); dq_cvs = 9 * sqr(3 + z0 * z0) / (d * sqr(9 - z0 * z0)); dq_th(z0);
);
function dq_hcF(u) ( abs(u) <= 1 ? 0.5 * u * u : abs(u) - 0.5; );
function dq_sz() instance(s0, s1) ( s0 = s1 = 0; );
function dq_Fth(z) local(a) ( a = abs(z); a < 3 ? z * z * 0.05555555555555556 + 1.3333333 * log(1 + z * z * 0.3333333333333333) : a - 0.6516075; );
function dq_acv(x, d, b) instance(s0, s1) local(z, F, dz, y, z0) (
  z = d * (x + b); F = dq_Fth(z); dz = z - s0;
  y = abs(dz) > 0.00001 ? (F - s1) / dz : dq_th(0.5 * (z + s0));
  s0 = z; s1 = F;
  z0 = min(max(d * b, -2.9), 2.9);
  (y - dq_th(z0)) * 9 * sqr(3 + z0 * z0) / (d * sqr(9 - z0 * z0));
);
function dq_hth(z, zo) instance(z1, ad1, cv1, zk) local(ad, cv, w, q) (
  zo !== zk ? (
    zk !== 1000000 ? z1 += zo - zk; zk = zo; q = z1 * z1;
    q < 9 ? ( ad1 = q * 0.05555555555555556 + 1.3333333 * log(1 + q * 0.3333333333333333); cv1 = z1 * (27 + q) / (27 + 9 * q); )
          : ( ad1 = abs(z1) - 0.6516075; cv1 = sign(z1); );
  );
  q = z * z;
  q < 9 ? ( ad = q * 0.05555555555555556 + 1.3333333 * log(1 + q * 0.3333333333333333); cv = z * (27 + q) / (27 + 9 * q); )
        : ( ad = abs(z) - 0.6516075; cv = sign(z); );
  w = z - z1;
  w = abs(w) > 0.00001 ? (ad - ad1) / w : dq_th(0.5 * (z + z1));
  z1 = z; ad1 = ad; w += 0.5 * (cv - cv1); cv1 = cv;
  w;
);
function dq_hz() instance(z1, ad1, cv1, zk) ( z1 = ad1 = cv1 = zk = 0; );
function dq_hpl(z) instance(z1, zk) ( z1 = z; zk = 1000000; dq_th(z); );
function dq_rres(y) local(u) (
  u = abs(y) - 1.2;
  u > 0 ? ( dq_rq = sign(y) * (0.25 * dq_th(u * 4) - u); 0.0625 * dq_Fth(u * 4) - 0.5 * u * u; ) : ( dq_rq = 0; 0; );
);
function dq_hrl(y) instance(y1, ad1, rq1) local(ad, rq, r) (
  abs(y) <= 1.2 && abs(y1) <= 1.2 ? ( r = y; ad = rq = 0; ) : (
    ad = dq_rres(y); rq = dq_rq;
    r = abs(y - y1) > 0.00001 ? (ad - ad1) / (y - y1) : ( dq_rres(0.5 * (y + y1)); dq_rq; );
    r = y + r + 0.5 * (rq - rq1);
  );
  y1 = y; ad1 = ad; rq1 = rq;
  r;
);
function dq_hrz() instance(y1, ad1, rq1) ( y1 = ad1 = rq1 = 0; );
function dq_Fge(v) ( v >= 0 ? dq_Fth(v) : dq_Fth(0.55 * v) / 0.3025; );
function dq_age(v) instance(s0, s1) local(F, dv, y) (
  F = dq_Fge(v); dv = v - s0;
  y = abs(dv) > 0.00001 ? (F - s1) / dv : ( v = 0.5 * (v + s0); v >= 0 ? dq_th(v) : dq_th(0.55 * v) / 0.55; );
  s0 = v + (abs(dv) > 0.00001 ? 0 : 0.5 * dv); s1 = F;
  y;
);
function dq_Fkn(u, kp, kn) local(a, k) (
  k = u > 0 ? kp : kn; a = abs(u);
  a < k ? 0.5 * u * u : k * a - 0.5 * k * k + sqr(1 - k) * dq_Fth((a - k) / (1 - k));
);
function dq_akn(u, kp, kn) instance(s0, s1) local(F, du, y, a, k, m) (
  F = dq_Fkn(u, kp, kn); du = u - s0;
  abs(du) > 0.00001 ? y = (F - s1) / du : (
    m = 0.5 * (u + s0); k = m > 0 ? kp : kn; a = abs(m);
    y = a < k ? m : sign(m) * (k + (1 - k) * dq_th((a - k) / (1 - k)));
  );
  s0 = u; s1 = F;
  y;
);
function dq_slx(o, y0, y1, S) local(m, e0, sg, den, tc, oc) (
  m = y1 - y0; e0 = y0 - o;
  abs(e0) < 0.000000001 ? (
    abs(m) <= S ? y1 : o + sign(m) * S;
  ) : (
    sg = e0 > 0 ? 1 : -1; den = S * sg - m;
    tc = den * sg > 0 ? e0 / den : 2;
    tc >= 1 ? o + sg * S : (
      oc = o + sg * S * tc;
      abs(m) <= S ? y1 : oc + sign(m) * S * (1 - tc);
    );
  );
);
function dq_adz(y, d) instance(s0, s1) local(F, dy, r, di) (
  di = 1 / d; F = 0.5 * y * y - d * d * dq_Fth(y * di); dy = y - s0;
  r = abs(dy) > 0.00001 ? (F - s1) / dy : ( y = 0.5 * (y + s0); y - d * dq_th(y * di); );
  s0 = y + (abs(dy) > 0.00001 ? 0 : 0.5 * dy); s1 = F;
  r;
);

function dq_cir(c, x) instance(t1lo, t1lp, g2lp, g2env, g2lp2, o3e, o3x, o3F, o3sl, o3yp, o3p, o3lp,
                               m4h1, m4l1, m4h2, m4l2, m4l3, c5lp, b6ex, b6ey, b6x, b6F, b6dx, b6dy, b6lp,
                               h7a, h7x, h7F, h7b, h7lp, s8env, s8lp, cvb, cr1, cs1, cr2, cs2, cr3, cs3, cr4, cs4, cr5, cs5,
                               gG, gC, g3, rgi, rgi3)
                     local(u, y, v, a, k, b, T, F, d, g) (
  dq_cb !== cvb ? (
    cvb = dq_cb;
    cr1 = dq_cvr(1.4, 0.06 + dq_cb); cs1 = dq_cvs; cr2 = dq_cvr(0.35, 0.12 + dq_cb); cs2 = dq_cvs;
    cr3 = dq_cvr(1.3, 0.12 + dq_cb); cs3 = dq_cvs; cr4 = dq_cvr(1.3, -0.08 - 0.5 * dq_cb); cs4 = dq_cvs;
    cr5 = dq_cvr(1.3, 0.1 + dq_cb); cs5 = dq_cvs;
  );
  dq_G !== gG || dq_cg !== gC || dq_G3 !== g3 ? (
    gG = dq_G; gC = dq_cg; g3 = dq_G3; rgi = 1 / (dq_G * dq_cg); rgi3 = 1 / (dq_G3 * dq_cg); rgi3 *= rgi3 * rgi3;
  );
  c < 4 ? (
    c == 0 ? (
      g = dq_G * dq_cg * 0.6; u = x * g;
      t1lo += (u - t1lo) * dq_k120;
      y = u - t1lo + (dq_th(1.4 * (t1lo + 0.06 + dq_cb)) - cr1) * cs1;
      y = (dq_th(0.35 * (y + 0.12 + dq_cb)) - cr2) * cs2;
      dq_vaa && dq_md ? y = this.q6.dq_hrl(y) : ( a = abs(y); a > 1.2 ? y = sign(y) * (1.2 + 0.25 * dq_th((a - 1.2) / 0.25)); );
      t1lp += (y - t1lp) * dq_k40k;
      t1lp * rgi * 1.6666666666666667;
    ) : c == 1 ? (
      g = dq_G * dq_cg; u = x * g;
      g2lp += (u - g2lp) * dq_k14k; u = g2lp;
      a = abs(u); g2env += (a - g2env) * (a > g2env ? dq_ka5 : dq_kr120);
      T = 1 / (1 + 0.25 * g2env);
      b = 0.18 + dq_cb + 0.05 * min(g2env, 2);
      y = this.e1.dq_age(u / T + b);
      y = (y - dq_th(b)) * T * 9 * sqr(3 + b * b) / sqr(9 - b * b);
      g2lp2 += (y - g2lp2) * dq_k11k;
      g2lp2 * rgi;
    ) : c == 2 ? (
      g = dq_G * dq_cg * 1.2; u = x * g;
      o3e += (u - o3e) * dq_k2500; u += 0.9 * (u - o3e);
      o3sl = dq_slx(o3sl, o3yp, u, dq_slew); o3yp = u;
      u = o3sl + 0.04 + dq_cb;
      F = dq_hcF(u); d = u - o3x;
      y = abs(d) > 0.00001 ? (F - o3F) / d : min(max(0.5 * (u + o3x), -1), 1);
      o3x = u; o3F = F;
      y -= 0.04 + dq_cb;
      o3p += (y - o3p) * dq_k2500; y -= 0.35 * (y - o3p);
      o3lp += (y - o3lp) * dq_k18k;
      o3lp * rgi * 0.8333333333333334;
    ) : (
      g = dq_G3 * dq_cg;
      v = x * g;
      m4h1 += (v - m4h1) * dq_k10; v -= m4h1;
      v = (dq_th(1.3 * (v + 0.12 + dq_cb)) - cr3) * cs3;
      v *= g; m4l1 += (v - m4l1) * dq_k18k; v = (dq_th(1.3 * (m4l1 - 0.08 - 0.5 * dq_cb)) - cr4) * cs4;
      v *= g; m4h2 += (v - m4h2) * dq_k15; v -= m4h2;
      m4l2 += (v - m4l2) * dq_k14k;
      v = ((dq_vaa && !dq_md ? this.q5.dq_hth(1.3 * (m4l2 + 0.1 + dq_cb), 1.3 * (0.1 + dq_cb)) : dq_th(1.3 * (m4l2 + 0.1 + dq_cb))) - cr5) * cs5;
      m4l3 += (v - m4l3) * dq_k11k;
      m4l3 * rgi3;
    );
  ) : (
    c == 4 ? (
      g = dq_G * dq_cg * 0.9; u = x * g;
      y = this.e4.dq_akn(u, 0.55 - dq_cb, 0.6 + dq_cb);
      y += 0.05 * y * y;
      c5lp += (y - c5lp) * dq_k20k;
      c5lp * rgi * 1.1111111111111112;
    ) : c == 5 ? (
      g = dq_G * dq_cg * 1.4; u = x * g;
      y = dq_e0 * u + dq_e1 * b6ex - dq_ea * b6ey; b6ex = u; b6ey = y;
      u = y + 0.3 * dq_cb;
      F = dq_hcF(u); d = u - b6x;
      y = abs(d) > 0.00001 ? (F - b6F) / d : min(max(0.5 * (u + b6x), -1), 1);
      b6x = u; b6F = F;
      y -= 0.3 * dq_cb;
      v = dq_de0 * y + dq_de1 * b6dx - dq_dea * b6dy; b6dx = y; b6dy = v;
      b6lp += (v - b6lp) * dq_k20k;
      b6lp * rgi * 0.7142857142857143;
    ) : c == 6 ? (
      g = dq_G * dq_cg * 0.8; u = x * g;
      h7a += (u - h7a) * dq_k700; v = u - h7a;
      F = 0.5 * v * abs(v); d = v - h7x;
      y = abs(d) > 0.00001 ? (F - h7F) / d : abs(0.5 * (v + h7x));
      h7x = v; h7F = F;
      h7b += (y - h7b) * dq_k150; y -= h7b;
      v = u + dq_rx * y;
      y = this.e6.dq_acv(v, 0.9, 0.05 + dq_cb);
      h7lp += (y - h7lp) * dq_k17k;
      h7lp * rgi * 1.25;
    ) : (
      g = dq_G * dq_cg * 1.1; u = x * g;
      a = 1 + 1.5 * s8env; T = 1 / a;
      b = 0.3 * (1 - T) + dq_cb;
      y = T * this.e7.dq_acv(u * a, 1, b);
      a = abs(y); s8env += (a - s8env) * (a > s8env ? dq_ka1 : dq_kr90);
      d = 0.012 + 0.04 * (1 - T);
      y = this.e8.dq_adz(y, d);
      s8lp += (y - s8lp) * dq_k13k;
      s8lp * rgi * 0.9090909090909091;
    );
  );
);
function dq_flush(c) instance(t1lo, t1lp, g2lp, g2env, g2lp2, o3e, o3x, o3F, o3sl, o3yp, o3p, o3lp,
                               m4h1, m4l1, m4h2, m4l2, m4l3, c5lp, b6ex, b6ey, b6x, b6F, b6dx, b6dy, b6lp,
                               h7a, h7x, h7F, h7b, h7lp, s8env, s8lp) (
  c == 0 ? ( t1lo = t1lp = 0; this.q6.dq_hrz(); ) : c == 1 ? ( g2lp = g2env = g2lp2 = 0; this.e1.dq_sz(); ) :
  c == 2 ? ( o3e = o3x = o3F = o3sl = o3yp = o3p = o3lp = 0; ) : c == 3 ? ( m4h1 = m4l1 = m4h2 = m4l2 = m4l3 = 0; this.q5.dq_hz(); ) :
  c == 4 ? ( c5lp = 0; this.e4.dq_sz(); ) : c == 5 ? ( b6ex = b6ey = b6x = b6F = b6dx = b6dy = b6lp = 0; ) :
  c == 6 ? ( h7a = h7x = h7F = h7b = h7lp = 0; this.e6.dq_sz(); ) : ( s8env = s8lp = 0; this.e7.dq_sz(); this.e8.dq_sz(); );
);
function dq_tiny(v) ( abs(v) < 0.000000000001 ? 0 : v; );
function dq_dnorm() instance(t1lo, t1lp, g2lp, g2env, g2lp2, o3e, o3x, o3F, o3sl, o3yp, o3p, o3lp,
                               m4h1, m4l1, m4h2, m4l2, m4l3, c5lp, b6ex, b6ey, b6x, b6F, b6dx, b6dy, b6lp,
                               h7a, h7x, h7F, h7b, h7lp, s8env, s8lp, dcx, dcy) (
  t1lo = dq_tiny(t1lo); t1lp = dq_tiny(t1lp); g2lp = dq_tiny(g2lp); g2env = dq_tiny(g2env); g2lp2 = dq_tiny(g2lp2);
  o3e = dq_tiny(o3e); o3sl = dq_tiny(o3sl); o3yp = dq_tiny(o3yp); o3p = dq_tiny(o3p); o3lp = dq_tiny(o3lp);
  m4h1 = dq_tiny(m4h1); m4l1 = dq_tiny(m4l1); m4h2 = dq_tiny(m4h2); m4l2 = dq_tiny(m4l2); m4l3 = dq_tiny(m4l3);
  c5lp = dq_tiny(c5lp); b6ey = dq_tiny(b6ey); b6dy = dq_tiny(b6dy); b6lp = dq_tiny(b6lp);
  h7a = dq_tiny(h7a); h7b = dq_tiny(h7b); h7lp = dq_tiny(h7lp); s8env = dq_tiny(s8env); s8lp = dq_tiny(s8lp);
  dcx = dq_tiny(dcx); dcy = dq_tiny(dcy);
);

function dq_vf(x) local(a, d) (
  a = abs(x); d = a - 1.25 + dq_kw;
  d <= 0 ? x : a >= 1.25 + dq_kw ? sign(x) * 1.25 : sign(x) * (a - d * d * 0.25 / dq_kw);
);
function dq_vfi(x) local(a, d) (
  a = abs(x); d = a - 1.25 + dq_kw;
  d <= 0 ? 0.5 * a * a : a >= 1.25 + dq_kw ? 0.5 * sqr(1.25 + dq_kw) - 0.6666667 * dq_kw * dq_kw + 1.25 * (a - 1.25 - dq_kw)
                       : 0.5 * a * a - d * d * d / (12 * dq_kw);
);
function dq_ch(x) instance(dcx, dcy, venv, z01, z02, z21, z22, z41, z42, z51, z52, lc1, lc2, vxp, vFp, z61, z62) local(u, w, y, s, a, t) (
  y = dq_v00 * x + z01; z01 = dq_v01 * x - dq_v03 * y + z02; z02 = dq_v02 * x - dq_v04 * y; u = y;
  dq_lpon ? ( t = u - lc2; a = dq_la1 * lc1 + dq_la2 * t; y = lc2 + dq_la2 * lc1 + dq_la3 * t; lc1 = 2 * a - lc1; lc2 = 2 * y - lc2; u = y; );
  w = this.dq_cir(dq_uc, u);
  dq_uk < 1 ? w = w * dq_uk + this.dq_cir(dq_up, u) * (1 - dq_uk);
  s = w * dq_G; a = abs(s);
  dq_md ? (
    venv += (a - venv) * (a > venv ? dq_vka : dq_vkr);
    s = ((dq_vaa && dq_ul ? this.qo.dq_hth(0.62 * s + dq_vb, dq_vb) : this.qo.dq_hpl(0.62 * s + dq_vb)) - dq_vbc) * dq_mcn;
    venv > 0.6 ? s /= 1 + 0.1 * (venv - 0.6);
  ) : (
    dq_vaa ? (
      dq_kwc ? vFp = dq_vfi(vxp);
      t = dq_vfi(s); y = s - vxp;
      a = abs(y) > 0.000001 ? (t - vFp) / y : dq_vf(0.5 * (s + vxp));
      vxp = s; vFp = t; s = a;
    ) : s = dq_vf(s);
  );
  y = dq_v60 * s + z61; z61 = dq_v61 * s - dq_v63 * y + z62; z62 = dq_v62 * s - dq_v64 * y; s = y;
  w = s * dq_Gi;
  y = dq_v20 * w + z21; z21 = dq_v21 * w - dq_v23 * y + z22; z22 = dq_v22 * w - dq_v24 * y; w = y;
  y = dq_v40 * w + z41; z41 = dq_v41 * w - dq_v43 * y + z42; z42 = dq_v42 * w - dq_v44 * y; w = y;
  y = dq_v50 * w + z51; z51 = dq_v51 * w - dq_v53 * y + z52; z52 = dq_v52 * w - dq_v54 * y; w = y;
  w *= dq_uk < 1 ? dq_um * dq_uk + dq_upm * (1 - dq_uk) : dq_um;
  y = w - dcx + dq_dcr * dcy; dcx = w; dcy = y;
  x + (y - x) * dq_ubl;
);
function dq_vclr() instance(venv, z01, z02, z21, z22, z41, z42, z51, z52, lc1, lc2, vxp, vFp, z61, z62) ( venv = z01 = z02 = z21 = z22 = z41 = z42 = z51 = z52 = lc1 = lc2 = vxp = vFp = z61 = z62 = 0; this.qo.dq_hz(); );
function dq_vtiny() instance(venv, z01, z02, z21, z22, z41, z42, z51, z52, lc1, lc2, vxp, vFp, z61, z62) (
  z61 = dq_tiny(z61); z62 = dq_tiny(z62); vxp = dq_tiny(vxp); vFp = dq_tiny(vFp); lc1 = dq_tiny(lc1); lc2 = dq_tiny(lc2); venv = dq_tiny(venv); z01 = dq_tiny(z01); z02 = dq_tiny(z02); z21 = dq_tiny(z21); z22 = dq_tiny(z22);
  z41 = dq_tiny(z41); z42 = dq_tiny(z42); z51 = dq_tiny(z51); z52 = dq_tiny(z52);
);
function dq_vbqset(k, t, f, gdb, q) local(w0, cw, sw, al, A, sa, n, c) (
  w0 = 2 * $pi * min(f, 0.45 * dq_fso) / dq_fso; cw = cos(w0); sw = sin(w0); A = 10 ^ (gdb / 40); al = sw / (2 * q);
  c = dq_VC + k * 5; sa = 2 * sqrt(A) * al;
  t == 0 ? (
    n = (A + 1) + (A - 1) * cw + sa;
    c[0] = A * ((A + 1) - (A - 1) * cw + sa) / n; c[1] = 2 * A * ((A - 1) - (A + 1) * cw) / n;
    c[2] = A * ((A + 1) - (A - 1) * cw - sa) / n; c[3] = -2 * ((A - 1) + (A + 1) * cw) / n; c[4] = ((A + 1) + (A - 1) * cw - sa) / n;
  ) : t == 2 ? (
    n = (A + 1) - (A - 1) * cw + sa;
    c[0] = A * ((A + 1) + (A - 1) * cw + sa) / n; c[1] = -2 * A * ((A - 1) + (A + 1) * cw) / n;
    c[2] = A * ((A + 1) + (A - 1) * cw - sa) / n; c[3] = 2 * ((A - 1) - (A + 1) * cw) / n; c[4] = ((A + 1) - (A - 1) * cw - sa) / n;
  ) : t == 3 ? (
    n = 1 + al; c[0] = (1 - cw) * 0.5 / n; c[1] = (1 - cw) / n; c[2] = c[0]; c[3] = -2 * cw / n; c[4] = (1 - al) / n;
  ) : (
    n = 1 + al; c[0] = (1 + cw) * 0.5 / n; c[1] = -(1 + cw) / n; c[2] = c[0]; c[3] = -2 * cw / n; c[4] = (1 - al) / n;
  );
);
function dq_emph(c, ci, gL, fL, gH, fH) local(K, a, b, l, h, n0, n1, n2, d0, d1, d2) (
  K = 2 * dq_fso; l = 10 ^ (gL / 20); h = 10 ^ (gH / 20);
  a = K * tan($pi * fL / sqrt(l) / dq_fso);
  b = K * tan($pi * fH * sqrt(h) / dq_fso);
  n0 = (K + l * a) * (h * K + b); n1 = (K + l * a) * (b - h * K) + (l * a - K) * (h * K + b); n2 = (l * a - K) * (b - h * K);
  d0 = (K + a) * (K + b); d1 = (K + a) * (b - K) + (a - K) * (K + b); d2 = (a - K) * (b - K);
  c[0] = n0 / d0; c[1] = n1 / d0; c[2] = n2 / d0; c[3] = d1 / d0; c[4] = d2 / d0;
  ci >= 0 ? ( ci[0] = d0 / n0; ci[1] = d1 / n0; ci[2] = d2 / n0; ci[3] = n1 / n0; ci[4] = n2 / n0; );
);
function dq_emphu(c, gd) ( dq_emph(c, -1, dq_eL + gd, dq_eFL, dq_eH, dq_eFH); );
function dq_dcset(i, fn, g, q) local(c, cw, sw, A, al, sa, n) (
  c = dq_DC + i * 5; cw = cos(2 * $pi * fn); sw = sin(2 * $pi * fn); A = 10 ^ (g / 40); al = sw / (2 * q); sa = 2 * sqrt(A) * al;
  n = (A + 1) - (A - 1) * cw + sa;
  c[0] = A * ((A + 1) + (A - 1) * cw + sa) / n; c[1] = -2 * A * ((A - 1) + (A + 1) * cw) / n;
  c[2] = A * ((A + 1) + (A - 1) * cw - sa) / n; c[3] = 2 * ((A - 1) - (A + 1) * cw) / n; c[4] = ((A + 1) - (A - 1) * cw - sa) / n;
);
