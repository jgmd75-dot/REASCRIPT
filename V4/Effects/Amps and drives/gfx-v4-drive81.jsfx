mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1))); mn_pl = max(mn_pl, abs(spl0)); mn_pr = max(mn_pr, abs(spl1));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x181A1C; mk_band = 0x0E0F10; mk_ink = 0xF6ECE4; mk_tab = 0xD3A272; mk_acc = 0xE8C080;
mk_sub = 0x222427; mk_ink2 = 0xC8B4A6;
sc != mg_fsc ? (
