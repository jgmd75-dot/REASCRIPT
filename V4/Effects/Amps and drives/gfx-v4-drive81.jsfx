dq_od < 1 ? ( dq_yl *= dq_od; dq_yr *= dq_od; );
os_g < 1 ? ( dq_yl *= os_g; dq_yr *= os_g; );

pwr_out(dq_yl, dq_yr); dq_yl = pwr_l; dq_yr = pwr_r;
dq_yl = dqoL.ost_band(dq_yl) * dq_og;
