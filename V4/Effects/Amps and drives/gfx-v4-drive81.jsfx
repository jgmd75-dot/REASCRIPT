fz_C = alloc(20);
function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_run(x) instance(zA, zB, zC, zD, fhi, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = zA.fz_bm(x, fz_C);
  ha = abs(h); fhi += (ha - fhi) * (ha > fhi ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fhi, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fhi;
  e = zD.fz_bm(zC.fz_bm(zB.fz_bm(e, fz_C + 5), fz_C + 10), fz_C + 15);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_dn() instance(fhi, fp, fe) ( fhi = dq_tiny(fhi); fp = dq_tiny(fp); fe = dq_tiny(fe); );
function fz_clr() instance(zA, zB, zC, zD, fhi, fp, fe) ( zA.fz_bmz(); zB.fz_bmz(); zC.fz_bmz(); zD.fz_bmz(); fhi = fp = fe = 0; );
function fz_coef() (
  fz_bqc(fz_C, 4, 3500, 0, 0.7071, dq_fso); fz_bqc(fz_C + 5, 4, 5500, 0, 0.7071, dq_fso);
  fz_bqc(fz_C + 10, 0, 8000, 4, 0.7, dq_fso); fz_bqc(fz_C + 15, 2, 12000, -6, 0.7, dq_fso);
  fz_a = 1 - exp(-1 / (0.003 * dq_fso)); fz_r = 1 - exp(-1 / (0.12 * dq_fso)); fz_w = 1 - exp(-1 / (0.06 * dq_fso));
);
fz_o = fz_t = 0;

function dq_k(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * dq_fso) / dq_fso); );
function dq_srinit() local(K, w1, w2) (
  dq_sr = srate; dq_fso = os_f * srate;
  dq_k10 = dq_k(10); dq_k15 = dq_k(15); dq_k120 = dq_k(120); dq_k150 = dq_k(150); dq_k700 = dq_k(700);
  dq_k2500 = dq_k(2500);  dq_k11k = dq_k(11000); dq_k13k = dq_k(13000);
  dq_k14k = dq_k(14000); dq_k17k = dq_k(17000); dq_k18k = dq_k(18000); dq_k20k = dq_k(20000);
  dq_k40k = dq_k(40000);
  dq_ka1 = 1 - exp(-1 / (0.001 * dq_fso)); dq_ka5 = 1 - exp(-1 / (0.005 * dq_fso));
  dq_kr90 = 1 - exp(-1 / (0.09 * dq_fso)); dq_kr120 = 1 - exp(-1 / (0.12 * dq_fso));
  dq_slew = 80000 / dq_fso;
  dq_dcr = 1 - 2 * $pi * 5 / dq_fso;
  K = 2 * dq_fso; w1 = K * tan($pi * 3183 / dq_fso); w2 = K * tan($pi * 15915 / dq_fso);
  dq_e0 = (K + w1) * (w2 / w1) / (K + w2); dq_e1 = (w1 - K) * (w2 / w1) / (K + w2); dq_ea = (w2 - K) / (K + w2);
  dq_de0 = (K + w2) * (w1 / w2) / (K + w1); dq_de1 = (w2 - K) * (w1 / w2) / (K + w1); dq_dea = (w1 - K) / (K + w1);
  dq_sm  = 1 - exp(-1 / (0.02 * srate));
  dq_swc = 1 - exp(-1 / (0.01 * srate));
  dq_xfc = 1 / (0.015 * srate);
  dq_odc = 1 / (0.005 * srate);
  dq_vw = 13.6; dq_vz = 0.81; dq_vdt = 1 / srate;
  dq_eql = -1;
  dq_vka = 1 - exp(-1 / (0.005 * dq_fso)); dq_vkr = 1 - exp(-1 / (0.15 * dq_fso));
  dq_mc0 = dq_th(0.0868); dq_mcn = 9 * sqr(3 + 0.0868 * 0.0868) / (0.62 * sqr(9 - 0.0868 * 0.0868));
  dq_bsB = -1;
  dq_vset(dq_md); dqAL.dq_vclr(); dqAR.dq_vclr(); dqBL.dq_vclr(); dqBR.dq_vclr();
  ost_init(dq_ostm);
  fz_coef();
);
dq_srinit(); os_gsetup();
pwr_init();  pwr_wu_loss = 1;  pwr_wu_drv = 2;  pwr_wu_lp = 7000;  pwr_bloom = 0.2;
dq_sbAL = rand(2) - 1; dq_sbAR = rand(2) - 1; dq_sgAL = rand(2) - 1; dq_sgAR = rand(2) - 1;
dq_sbBL = rand(2) - 1; dq_sbBR = rand(2) - 1; dq_sgBL = rand(2) - 1; dq_sgBR = rand(2) - 1;
dfbAL.drift_init(0.8 + rand(1) * 0.4); dfbAR.drift_init(0.8 + rand(1) * 0.4); dfgAL.drift_init(0.8 + rand(1) * 0.4); dfgAR.drift_init(0.8 + rand(1) * 0.4);
dfbBL.drift_init(0.8 + rand(1) * 0.4); dfbBR.drift_init(0.8 + rand(1) * 0.4); dfgBL.drift_init(0.8 + rand(1) * 0.4); dfgBR.drift_init(0.8 + rand(1) * 0.4);
dfeA.drift_init(0.7 + rand(1) * 0.4); dfeB.drift_init(0.7 + rand(1) * 0.4);
dqoL.ost_ch_init(); dqoR.ost_ch_init();
dq_update();
by_setup(33);
dq_md = dq_tmd; dq_vset(dq_md);
dq_lpon = 1; dq_lfA = dq_lfB = 0.45 * dq_fso * ((dq_md ? 9000 : 10000) / (0.45 * dq_fso)) ^ (8 / 30);
dq_gdA = -0.05 * dq_tdA; dq_gdB = -0.05 * dq_tdB; dq_preu();
dq_kwA = dq_kwB = 0.54; dq_vaa = 1;
dq_ciA = dq_prA = dq_tcA; dq_ciB = dq_prB = dq_tcB; dq_kA = dq_kB = 1;
dq_dA = dq_tdA; dq_dB = dq_tdB; dq_blA = dq_tblA; dq_blB = dq_tblB; dq_oA = dq_toA; dq_oB = dq_toB;
dq_onA = dq_tonA; dq_onB = dq_tonB; dq_in = dq_tin; dq_og = dq_tog; dq_ord = dq_tord; dq_od = 1; dq_oh = 0;
dq_bAL = dq_bAR = dq_bBL = dq_bBR = 0; dq_gAL = dq_gAR = dq_gBL = dq_gBR = 1;
dq_vy0 = dq_vy1 = dq_vy2 = dq_vy3 = 0; dq_vv0 = dq_vv1 = dq_vv2 = dq_vv3 = 0;
dq_iA = dq_xA = dq_iB = dq_xB = 0; dq_pkA = dq_pkB = 0;
dq_zdA = dq_zdB = dq_zkA = dq_zkB = -1;
dqAL.cvb = dqAR.cvb = dqBL.cvb = dqBR.cvb = 1000000;
mn_pk_d = mn_pl_d = mn_pr_d = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
rs_f = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(32, i != 32 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function dq_clrall() (
  dqAL.dq_flush(dq_ciA); dqAR.dq_flush(dq_ciA); dqBL.dq_flush(dq_ciB); dqBR.dq_flush(dq_ciB);
  dqAL.dq_flush(dq_prA); dqAR.dq_flush(dq_prA); dqBL.dq_flush(dq_prB); dqBR.dq_flush(dq_prB);
  dqAL.dq_vclr(); dqAR.dq_vclr(); dqBL.dq_vclr(); dqBR.dq_vclr();
  dqAL.dcx = dqAL.dcy = dqAR.dcx = dqAR.dcy = dqBL.dcx = dqBL.dcy = dqBR.dcx = dqBR.dcy = 0;
  eAL0.dq_bqz(); eAR0.dq_bqz(); eAL1.dq_bqz(); eAR1.dq_bqz(); eAL2.dq_bqz(); eAR2.dq_bqz();
  eBL0.dq_bqz(); eBR0.dq_bqz(); eBL1.dq_bqz(); eBR1.dq_bqz(); eBL2.dq_bqz(); eBR2.dq_bqz();
  dqu1L.os_clr(); dqu1R.os_clr(); dqd1L.os_clr(); dqd1R.os_clr();
  fzL.fz_clr(); fzR.fz_clr();
  gdc_x0 = gdc_y0 = gdc_x1 = gdc_y1 = 0;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
dq_update();
os_snap(slider(31));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; rs_c = 1 / (0.015 * srate); dq_clrall(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
srate != dq_sr ? ( dq_srinit(); os_gsetup(); );
dq_update();
pwr_block(slider33 < 0.5);
dq_tcA != dq_ciA && dq_kA >= 1 ? ( dq_prA = dq_ciA; dq_ciA = dq_tcA; dq_kA = 0; dqAL.dq_flush(dq_ciA); dqAR.dq_flush(dq_ciA); );
dq_tcB != dq_ciB && dq_kB >= 1 ? ( dq_prB = dq_ciB; dq_ciB = dq_tcB; dq_kB = 0; dqBL.dq_flush(dq_ciB); dqBR.dq_flush(dq_ciB); );
dq_di = 0.12 * dm_s * samplesblock / srate;
dq_bAL = dm_a * (0.03 * dfbAL.drift_tick(dq_di) + 0.012 * dq_sbAL); dq_bAR = dm_a * (0.03 * dfbAR.drift_tick(dq_di) + 0.012 * dq_sbAR);
dq_bBL = dm_a * (0.03 * dfbBL.drift_tick(dq_di) + 0.012 * dq_sbBL); dq_bBR = dm_a * (0.03 * dfbBR.drift_tick(dq_di) + 0.012 * dq_sbBR);
dq_gAL = 1 + dm_a * (0.03 * dfgAL.drift_tick(dq_di) + 0.01 * dq_sgAL); dq_gAR = 1 + dm_a * (0.03 * dfgAR.drift_tick(dq_di) + 0.01 * dq_sgAR);
dq_gBL = 1 + dm_a * (0.03 * dfgBL.drift_tick(dq_di) + 0.01 * dq_sgBL); dq_gBR = 1 + dm_a * (0.03 * dfgBR.drift_tick(dq_di) + 0.01 * dq_sgBR);
dq_feA = 1 + 0.02 * dm_a * dfeA.drift_tick(dq_di * 0.8); dq_feB = 1 + 0.02 * dm_a * dfeB.drift_tick(dq_di * 0.8);
dq_t = 0.45 * dq_fso; dq_flA = dq_t * ((dq_md ? 9000 : 10000) / dq_t) ^ (dq_tdA / 30); dq_flB = dq_t * ((dq_md ? 9000 : 10000) / dq_t) ^ (dq_tdB / 30);
dq_lgl = 1 - exp(-samplesblock / (0.03 * srate));
dq_lfA += (dq_flA - dq_lfA) * dq_lgl; dq_lfB += (dq_flB - dq_lfB) * dq_lgl;
dq_t = min(max(dq_tdA - 15, 0), 15) / 15; dq_t = 0.54 + 0.46 * dq_t * dq_t * (3 - 2 * dq_t) - dq_kwA;
dq_kwcA = abs(dq_t) > 0.000001; dq_kwA = dq_kwcA ? dq_kwA + dq_t * dq_lgl : dq_kwA + dq_t;
dq_t = min(max(dq_tdB - 15, 0), 15) / 15; dq_t = 0.54 + 0.46 * dq_t * dq_t * (3 - 2 * dq_t) - dq_kwB;
dq_kwcB = abs(dq_t) > 0.000001; dq_kwB = dq_kwcB ? dq_kwB + dq_t * dq_lgl : dq_kwB + dq_t;
dq_gdA += (-0.05 * dq_tdA - dq_gdA) * dq_lgl; dq_gdB += (-0.05 * dq_tdB - dq_gdB) * dq_lgl;
dq_preu();
dq_t = tan($pi * min(dq_lfA, 0.45 * dq_fso) / dq_fso); dq_lpa1 = 1 / (1 + dq_t * (dq_t + 1.6666667)); dq_lpa2 = dq_t * dq_lpa1; dq_lpa3 = dq_t * dq_lpa2;
dq_t = tan($pi * min(dq_lfB, 0.45 * dq_fso) / dq_fso); dq_lpb1 = 1 / (1 + dq_t * (dq_t + 1.6666667)); dq_lpb2 = dq_t * dq_lpb1; dq_lpb3 = dq_t * dq_lpb2;
dq_gl = 1 - exp(-samplesblock / (0.03 * srate));
dq_i = 0;
loop(6,
  dq_t = slider((dq_i < 3 ? 7 : 14) + dq_i + ((dq_i % 3) == 2));
  dq_t = min(max(dq_t, -15), 15);
  dq_eg[dq_i] += (dq_t - dq_eg[dq_i]) * dq_gl;
  abs(dq_eg[dq_i] - dq_t) < 0.005 ? dq_eg[dq_i] = dq_t;
  dq_i += 1;
);
dq_fA = min(max(slider9, 200), 8000) * dq_feA; dq_fB = min(max(slider19, 200), 8000) * dq_feB;
dq_ek = dq_eg[0] + 3 * dq_eg[1] + 7 * dq_eg[2] + 13 * dq_eg[3] + 17 * dq_eg[4] + 19 * dq_eg[5] + dq_fA * 0.001 + dq_fB * 0.0013 + dq_feA + dq_feB;
dq_ek != dq_eql ? (
  dq_eql = dq_ek;
  dq_eqset(0, 0, 100 * dq_feA, dq_eg[0], 0.7071); dq_eqset(1, 1, dq_fA, dq_eg[1], 0.9); dq_eqset(2, 2, 10000 * dq_feA, dq_eg[2], 0.7071);
  dq_eqset(3, 0, 100 * dq_feB, dq_eg[3], 0.7071); dq_eqset(4, 1, dq_fB, dq_eg[4], 0.9); dq_eqset(5, 2, 10000 * dq_feB, dq_eg[5], 0.7071);
);
dq_eA0 = abs(dq_eg[0]) > 0.001; dq_eA1 = abs(dq_eg[1]) > 0.001; dq_eA2 = abs(dq_eg[2]) > 0.001;
dq_eB0 = abs(dq_eg[3]) > 0.001; dq_eB1 = abs(dq_eg[4]) > 0.001; dq_eB2 = abs(dq_eg[5]) > 0.001;
!dq_eA0 ? ( eAL0.dq_bqz(); eAR0.dq_bqz(); ); !dq_eA1 ? ( eAL1.dq_bqz(); eAR1.dq_bqz(); ); !dq_eA2 ? ( eAL2.dq_bqz(); eAR2.dq_bqz(); );
!dq_eB0 ? ( eBL0.dq_bqz(); eBR0.dq_bqz(); ); !dq_eB1 ? ( eBL1.dq_bqz(); eBR1.dq_bqz(); ); !dq_eB2 ? ( eBL2.dq_bqz(); eBR2.dq_bqz(); );
dqAL.dq_vtiny(); dqAR.dq_vtiny(); dqBL.dq_vtiny(); dqBR.dq_vtiny();
dqAL.dq_dnorm(); dqAR.dq_dnorm(); dqBL.dq_dnorm(); dqBR.dq_dnorm();
eAL0.dq_bqf(); eAR0.dq_bqf(); eAL1.dq_bqf(); eAR1.dq_bqf(); eAL2.dq_bqf(); eAR2.dq_bqf();
eBL0.dq_bqf(); eBR0.dq_bqf(); eBL1.dq_bqf(); eBR1.dq_bqf(); eBL2.dq_bqf(); eBR2.dq_bqf();
fzL.fz_dn(); fzR.fz_dn();
mn_ia_d = max(mn_ia_d, mn_ia); mn_xa_d = max(mn_xa_d, mn_xa); mn_ib_d = max(mn_ib_d, mn_ib); mn_xb_d = max(mn_xb_d, mn_xb); mn_ia = mn_xa = mn_ib = mn_xb = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0; mn_pl_d = max(mn_pl_d, mn_pl); mn_pr_d = max(mn_pr_d, mn_pr); mn_pl = mn_pr = 0;
os_snapb(slider(31));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
by_in();
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
pwr_in(spl0, spl1); spl0 = pwr_l; spl1 = pwr_r;
dq_in += (dq_tin - dq_in) * dq_sm;
dq_og += (dq_tog - dq_og) * dq_sm;
dq_dA += (dq_tdA - dq_dA) * dq_sm; dq_dB += (dq_tdB - dq_dB) * dq_sm;
dq_blA += (dq_tblA - dq_blA) * dq_sm; dq_blB += (dq_tblB - dq_blB) * dq_sm;
dq_oA += (dq_toA - dq_oA) * dq_sm; dq_oB += (dq_toB - dq_oB) * dq_sm;
dq_onA += (dq_tonA - dq_onA) * dq_swc; dq_onB += (dq_tonB - dq_onB) * dq_swc;
dq_onA < 0.000001 ? dq_onA = 0; dq_onB < 0.000001 ? dq_onB = 0;
dq_kA < 1 ? dq_kA = min(dq_kA + dq_xfc, 1); dq_kB < 1 ? dq_kB = min(dq_kB + dq_xfc, 1);
dq_dA !== dq_zdA || dq_ciA + 8 * dq_md !== dq_zkA ? (
  dq_zdA = dq_dA; dq_zkA = dq_ciA + 8 * dq_md;
  dq_GA = 10 ^ (dq_dA / 20); dq_GiA = 1 / dq_GA; dq_G3A = dq_GA ^ 0.3333333 * 0.9; dq_mA = dq_mk(dq_zkA, dq_dA);
);
dq_dB !== dq_zdB || dq_ciB + 8 * dq_md !== dq_zkB ? (
  dq_zdB = dq_dB; dq_zkB = dq_ciB + 8 * dq_md;
  dq_GB = 10 ^ (dq_dB / 20); dq_GiB = 1 / dq_GB; dq_mB = dq_mk(dq_zkB, dq_dB); dq_rxB = 0.2 + 0.035 * dq_dB;
);
dq_mpA = dq_kA < 1 ? dq_mk(dq_prA + 8 * dq_md, dq_dA) : 1;
dq_mpB = dq_kB < 1 ? dq_mk(dq_prB + 8 * dq_md, dq_dB) : 1;

function dq_loadA() (
  dq_ul = dq_ord || dq_onB <= 0;
  dq_uc = dq_ciA; dq_up = dq_prA; dq_uk = dq_kA; dq_um = dq_mA; dq_upm = dq_mpA; dq_ubl = dq_blA;
  dq_G = dq_GA; dq_Gi = dq_GiA; dq_G3 = dq_G3A; dq_vb = 0.0868; dq_vbc = dq_mc0; dq_la1 = dq_lpa1; dq_la2 = dq_lpa2; dq_la3 = dq_lpa3; dq_kw = dq_kwA; dq_kwc = dq_kwcA;
  dq_t = dq_DC + 5 * (8 * dq_md + dq_ciA); dq_v60 = dq_t[0]; dq_v61 = dq_t[1]; dq_v62 = dq_t[2]; dq_v63 = dq_t[3]; dq_v64 = dq_t[4];
  dq_v00 = dq_pa0; dq_v01 = dq_pa1; dq_v02 = dq_pa2; dq_v03 = dq_pa3; dq_v04 = dq_pa4;
);
function dq_loadB() (
  dq_ul = !dq_ord || dq_onA <= 0;
  dq_uc = dq_ciB; dq_up = dq_prB; dq_uk = dq_kB; dq_um = dq_mB; dq_upm = dq_mpB; dq_ubl = dq_blB;
  dq_G = dq_GB; dq_Gi = dq_GiB; dq_rx = dq_rxB; dq_vb = 0.0868 * dq_bsB; dq_vbc = dq_mc0 * dq_bsB; dq_la1 = dq_lpb1; dq_la2 = dq_lpb2; dq_la3 = dq_lpb3; dq_kw = dq_kwB; dq_kwc = dq_kwcB;
  dq_t = dq_DC + 5 * (8 * dq_md + dq_ciB); dq_v60 = dq_t[0]; dq_v61 = dq_t[1]; dq_v62 = dq_t[2]; dq_v63 = dq_t[3]; dq_v64 = dq_t[4];
  dq_v00 = dq_pb0; dq_v01 = dq_pb1; dq_v02 = dq_pb2; dq_v03 = dq_pb3; dq_v04 = dq_pb4;
);
function dq_unitA(l, r) local(yl, yr) (
  dq_onA > 0 ? (
    dq_cb = dq_bAL; dq_cg = dq_gAL; yl = dqAL.dq_ch(l);
    dq_cb = dq_bAR; dq_cg = dq_gAR; yr = dqAR.dq_ch(r);
    yl *= dq_oA; yr *= dq_oA;
    dq_eA0 ? ( yl = eAL0.dq_bq(yl, dq_EQ); yr = eAR0.dq_bq(yr, dq_EQ); );
    dq_eA1 ? ( yl = eAL1.dq_bq(yl, dq_EQ + 5); yr = eAR1.dq_bq(yr, dq_EQ + 5); );
    dq_eA2 ? ( yl = eAL2.dq_bq(yl, dq_EQ + 10); yr = eAR2.dq_bq(yr, dq_EQ + 10); );
    dq_onA < 1 ? ( yl = l + (yl - l) * dq_onA; yr = r + (yr - r) * dq_onA; );
  ) : ( yl = l; yr = r; );
  dq_ph0 ? ( dq_iA = max(abs(l), abs(r)); dq_xA = max(abs(yl), abs(yr)); );
  dq_ol = yl; dq_or = yr;
);
function dq_unitB(l, r) local(yl, yr) (
  dq_onB > 0 ? (
    dq_cb = dq_bBL; dq_cg = dq_gBL; yl = dqBL.dq_ch(l);
    dq_cb = dq_bBR; dq_cg = dq_gBR; yr = dqBR.dq_ch(r);
    yl *= dq_oB; yr *= dq_oB;
    dq_eB0 ? ( yl = eBL0.dq_bq(yl, dq_EQ + 15); yr = eBR0.dq_bq(yr, dq_EQ + 15); );
    dq_eB1 ? ( yl = eBL1.dq_bq(yl, dq_EQ + 20); yr = eBR1.dq_bq(yr, dq_EQ + 20); );
    dq_eB2 ? ( yl = eBL2.dq_bq(yl, dq_EQ + 25); yr = eBR2.dq_bq(yr, dq_EQ + 25); );
    dq_onB < 1 ? ( yl = l + (yl - l) * dq_onB; yr = r + (yr - r) * dq_onB; );
  ) : ( yl = l; yr = r; );
  dq_ph0 ? ( dq_iB = max(abs(l), abs(r)); dq_xB = max(abs(yl), abs(yr)); );
  dq_ol = yl; dq_or = yr;
);
function dq_bothA() (
  dq_loadA();
  dq_ph0 = 1; dq_unitA(dq_p0l, dq_p0r); dq_p0l = dq_ol; dq_p0r = dq_or;
  dq_ph0 = 0;
  os_f > 1 ? ( dq_unitA(dq_p1l, dq_p1r); dq_p1l = dq_ol; dq_p1r = dq_or;
