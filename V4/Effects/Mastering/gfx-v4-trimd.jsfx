tm_ol = tm_COL[tm_cp]; tm_or = tm_COR[tm_cp];
tm_CIL[tm_cp] = tm_wl; tm_CIR[tm_cp] = tm_wr;
tm_cp += 1; tm_cp >= tm_cn ? ( tm_cp = 0; tm_cblk(); );
tm_mix += (tm_tmix - tm_mix) * tm_sm; tm_out += (tm_tout - tm_out) * tm_sm;
tm_ol = (tm_yl + tm_mix * (tm_ol - tm_yl)) * tm_out; tm_or = (tm_yr + tm_mix * (tm_or - tm_yr)) * tm_out;
tm_ol != tm_ol ? tm_ol = 0; tm_or != tm_or ? tm_or = 0;
ost_out(tm_ol * os_g, tm_or * os_g);
spl0 = max(-4, min(4, ost_l)); spl1 = max(-4, min(4, ost_r));
by_out();
tm_pkm = max(tm_pkm, max(abs(spl0), abs(spl1))); tm_pol = max(tm_pol, abs(spl0)); tm_por = max(tm_por, abs(spl1));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0xC3CBD3; mk_band = 0x1A2028; mk_ink = 0xF2F5F8; mk_tab = 0x1F63E0; mk_acc = 0x7FD4FF;
mk_sub = 0x353C45; mk_ink2 = 0xC6D2DE; mk_rule = 0x3D8BFF;
sc != mg_fsc ? (
