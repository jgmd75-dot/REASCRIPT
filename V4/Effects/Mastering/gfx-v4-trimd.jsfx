function mg_menu(s, cur) local(m) ( gfx_x = mouse_x; gfx_y = mouse_y; m = gfx_showmenu(s); m > 0 ? m - 1 : -1; );
function mg_mbox(x, y, w, lbl, idx, n, s, t) local(v, i, k, a) (
