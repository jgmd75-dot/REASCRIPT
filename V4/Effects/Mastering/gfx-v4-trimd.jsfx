desc:TRIMD [disc limiter] (GFX V4)
//tags: disc recorder agc alc codec clipper broadcast dynamics limiter saturation lofi v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-input, gfx-v4-output, gfx-v4-ui, gfx-v4-panel, gfx-v4-clip, gfx-v4-os and gfx-v4-bypass, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider39:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-24,12,0.1>-Input (dB)
slider2:0<-24,12,0.1>-Output (dB)
slider3:100<0,100,1>-Mix (%)
slider4:1<0,1,1{Off,On}>-Link
slider5:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider6:0<0,5,1{A B C,A C B,B A C,B C A,C A B,C B A}>-Order (decks in stages I II III)

slider11:1<0,1,1{Off,On}>-Deck A on
slider12:1<0,5,1{Porta,Rack,Micro,Master,Air,ALC}>-Deck A model
slider13:6<0,24,0.1>-Deck A drive (dB)
slider14:5<0,10,0.1>-Deck A recovery
slider15:0<0,100,1>-Deck A codec (%)
slider16:0<-12,12,0.1>-Deck A out (dB)

slider21:1<0,1,1{Off,On}>-Deck B on
slider22:3<0,5,1{Porta,Rack,Micro,Master,Air,ALC}>-Deck B model
slider23:6<0,24,0.1>-Deck B drive (dB)
slider24:5<0,10,0.1>-Deck B recovery
slider25:0<0,100,1>-Deck B codec (%)
slider26:0<-12,12,0.1>-Deck B out (dB)

slider31:1<0,1,1{Off,On}>-Deck C on
slider32:4<0,5,1{Porta,Rack,Micro,Master,Air,ALC}>-Deck C model
slider33:0<0,24,0.1>-Deck C drive (dB)
slider34:5<0,10,0.1>-Deck C recovery
slider35:0<0,100,1>-Deck C codec (%)
slider36:0<-12,12,0.1>-Deck C out (dB)
slider37:0<0,1,1{Off,On}>-Bypass
slider38:prs_sel=0<0,12,1{No preset,Init,Pocket Dub Chain,Broadcast Wall,Hallway Interview,Boxed Drums,Glass Halo,Third Generation Dub,Long Play Smear,Field Pump,Clean Master Clamp,Crushed Portable,Night Radio}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-input.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-clip.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(548748196927, v); );
function psw_allg(v) ( slider_show(548748196927, v); );
mn_ha = mn_hb = mn_hc = mn_he = -120;
#ui_man = "gfx-v4-trimd";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 0;

tm_nm = 0;
function tm_alloc(n) local(p) ( p = tm_nm; tm_nm += n; memset(p, 0, n); p; );
tm_DLL = tm_alloc(1024); tm_DLR = tm_alloc(1024);
tm_BA = tm_alloc(256); tm_BB = tm_alloc(256); tm_BC = tm_alloc(256); tm_BD = tm_alloc(256);
tm_B0 = tm_alloc(256); tm_B1 = tm_alloc(256); tm_B2 = tm_alloc(256);
tm_PM = tm_alloc(18);
tm_TR = tm_alloc(8);
tm_GL = tm_alloc(128 * 7);
FZC = 180000;

function tm_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function tm_bqs(t, f, q, g, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, alp, Ag, sa, n) (
  w0 = 2 * $pi * min(f, 0.45 * fs) / fs; cw = cos(w0); sw = sin(w0); alp = sw / (2 * q); Ag = 10 ^ (g / 40); sa = 2 * sqrt(Ag) * alp;
  t == 0 ? ( n = 1 + alp; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - alp) / n; ) :
  t == 1 ? ( n = 1 + alp; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - alp) / n; ) :
  t == 2 ? ( n = 1 + alp / Ag; b0 = (1 + alp * Ag) / n; b1 = -2 * cw / n; b2 = (1 - alp * Ag) / n; a1 = b1; a2 = (1 - alp / Ag) / n; ) :
  t == 3 ? (
    n = (Ag + 1) - (Ag - 1) * cw + sa;
    b0 = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / n; b1 = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / n;
    b2 = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / n; a1 = 2 * ((Ag - 1) - (Ag + 1) * cw) / n; a2 = ((Ag + 1) - (Ag - 1) * cw - sa) / n;
  ) : (
    n = (Ag + 1) + (Ag - 1) * cw + sa;
    b0 = Ag * ((Ag + 1) - (Ag - 1) * cw + sa) / n; b1 = 2 * Ag * ((Ag - 1) - (Ag + 1) * cw) / n;
    b2 = Ag * ((Ag + 1) - (Ag - 1) * cw - sa) / n; a1 = -2 * ((Ag - 1) + (Ag + 1) * cw) / n; a2 = ((Ag + 1) + (Ag - 1) * cw - sa) / n;
  );
);
function tm_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function tm_bqc() instance(z1, z2) ( z1 = z2 = 0; );
function tm_bqt() instance(z1, z2) ( z1 = tm_tn(z1); z2 = tm_tn(z2); );
function tm_cmpset() local(w0, cw, sw, Ag, alp, sa, n) (
  w0 = 2 * $pi * 0.2322; cw = cos(w0); sw = sin(w0); Ag = 10 ^ (5 / 40); alp = sw / (2 * 0.5627); sa = 2 * sqrt(Ag) * alp;
  n = (Ag + 1) - (Ag - 1) * cw + sa;
  tm_c0 = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / n; tm_c1 = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / n;
  tm_c2 = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / n; tm_c3 = 2 * ((Ag - 1) - (Ag + 1) * cw) / n; tm_c4 = ((Ag + 1) - (Ag - 1) * cw - sa) / n;
);
tm_cmpset();
function tm_cmp(x) instance(z1, z2) local(y) ( y = tm_c0 * x + z1; z1 = tm_c1 * x - tm_c3 * y + z2; z2 = tm_c2 * x - tm_c4 * y; y; );

tm_TR[0] = -1.31; tm_TR[1] = -2.26; tm_TR[2] = -2.27; tm_TR[3] = -2.24; tm_TR[4] = -2.63; tm_TR[5] = 1.74;
tm_lvi = -0.33;

function cd_clr() instance(i1a, i2a, i1b, i2b, g0, g1, g2, hl) ( i1a = i2a = i1b = i2b = 0; g0 = g1 = g2 = 1; hl = 0; );
function cd_tidy() instance(i1a, i2a, i1b, i2b, hl) ( i1a = tm_tn(i1a); i2a = tm_tn(i2a); i1b = tm_tn(i1b); i2b = tm_tn(i2b); hl = tm_tn(hl); );
function cd_blk(b, a, w0, w1) instance(i1a, i2a, i1b, i2b, g0, g1, g2, hl)
  local(i, x, v1, v2, v3, lo, mi, hi, r, e0, e1, e2, p0, p1, p2, lb0, lb1, lb2, lbm, n0, n1, n2, h0, h1, h2, s0, s1, s2,
        k0, k1, k2, t, dt, y, hk, q0, q1, q2, w) (
  e0 = e1 = e2 = p0 = p1 = p2 = 0; i = 0;
  loop(tm_cn,
    x = b[i];
    v3 = x - i2a; v1 = tm_qa1 * i1a + tm_qa2 * v3; v2 = i2a + tm_qa2 * i1a + tm_qa3 * v3; i1a = 2 * v1 - i1a; i2a = 2 * v2 - i2a;
    lo = v2; r = x - lo;
    v3 = r - i2b; v1 = tm_qb1 * i1b + tm_qb2 * v3; v2 = i2b + tm_qb2 * i1b + tm_qb3 * v3; i1b = 2 * v1 - i1b; i2b = 2 * v2 - i2b;
    mi = v2; hi = r - mi;
    tm_B0[i] = lo; tm_B1[i] = mi; tm_B2[i] = hi;
    e0 += lo * lo; e1 += mi * mi; e2 += hi * hi;
    p0 = max(p0, abs(lo)); p1 = max(p1, abs(mi)); p2 = max(p2, abs(hi));
    i += 1;
  );
  lb0 = 10 * log10(e0 * tm_icn + 0.00000000000000000001); lb1 = 10 * log10(e1 * tm_icn + 0.00000000000000000001);
  lb2 = 10 * log10(e2 * tm_icn + 0.00000000000000000001); lbm = max(lb0, max(lb1, lb2));
  n0 = max(16 - 11 * a - a * min(max((lbm - lb0) / 6 - 1, 0), 4), 1.2);
  n1 = max(15 - 11 * a - a * min(max((lbm - lb1) / 6 - 1, 0), 4), 1.2);
  n2 = max(14 - 11 * a - a * min(max((lbm - lb2) / 6 - 1, 0), 4), 1.2);
  h0 = lb0 > -100;
  h1 = (lbm - lb1 < 50 - 35 * a) && lb1 > -90 + 40 * a;
  h2 = (lbm - lb2 < 40 - 30 * a) && lb2 > -90 + 40 * a;
  s0 = p0 > 0.000000001 ? p0 * 2 ^ (1 - n0) : 0; k0 = s0 > 0 ? 1 / s0 : 0;
  s1 = p1 > 0.000000001 ? p1 * 2 ^ (1 - n1) : 0; k1 = s1 > 0 ? 1 / s1 : 0;
  s2 = p2 > 0.000000001 ? p2 * 2 ^ (1 - n2) : 0; k2 = s2 > 0 ? 1 / s2 : 0;
  hk = a > 0.5 ? 1 - exp(-2 * $pi * (22000 - 20000 * (a - 0.5)) / srate) : 1;
  hk >= 1 ? hk = 1;
  i = 0; t = 0; dt = tm_icn;
  loop(tm_cn,
    q0 = s0 * floor(tm_B0[i] * k0 + rand(1));
    q1 = s1 * floor(tm_B1[i] * k1 + rand(1));
    q2 = s2 * floor(tm_B2[i] * k2 + rand(1));
    hl += hk * (q2 - hl);
    y = (g0 + (h0 - g0) * t) * q0 + (g1 + (h1 - g1) * t) * q1 + (g2 + (h2 - g2) * t) * hl;
    w = w0 + (w1 - w0) * t; x = b[i];
    b[i] = x + w * (y - x);
    t += dt; i += 1;
  );
  g0 = h0; g1 = h1; g2 = h2;
  h0 + 2 * h1 + 4 * h2;
);

function st_model(m) instance(md, atm, rlm, th0, rat, kh, ktk, kw0, trim, air, alc, mas)
  local(fso, kp, kn, w1, pf1, psf) (
  fso = os_f * srate; md = m; air = m == 4; alc = m == 5; mas = m == 3;
  m == 0 ? (
    atm = 0.25; rlm = 70; th0 = -9; rat = 0.95; kh = 1.5; ktk = 1; kp = 1; kn = 0.96; kw0 = 0.12; w1 = 0.19;
    pf1 = 12000; psf = 150;
    this.aL.tm_bqs(3, 5000, 0.707, 4, fso); this.bL.tm_bqs(3, 5000, 0.707, -3, fso);
  ) : m == 1 ? (
    atm = 3; rlm = 180; th0 = -5; rat = 0.75; kh = 3; ktk = 1; kp = 1; kn = 0.93; kw0 = 0.3; w1 = 0.6;
    pf1 = 10000; psf = 120;
    this.aL.tm_bqs(2, 700, 0.7, 2, fso); this.bL.tm_bqs(2, 700, 0.7, -2, fso);
  ) : m == 2 ? (
    atm = 6; rlm = 700; th0 = -3; rat = 0.875; kh = 0.5; ktk = 0; kp = 0.9; kn = 0.9; kw0 = 0.03; w1 = 0.03;
    pf1 = 7000; psf = 150;
    this.aL.tm_bqs(2, 1100, 1.2, 3.5, fso); this.bL.tm_bqs(0, 9000, 0.6, 0, fso);
  ) : m == 3 ? (
    atm = 0.05; rlm = 300; th0 = -2; rat = 0.95; kh = 6; ktk = 1; kp = 1; kn = 1; kw0 = 0.4; w1 = 0.8;
    pf1 = 14000; psf = 100;
    this.aL.tm_bqs(4, 60, 0.707, 0, fso); this.bL.tm_bqs(3, 12000, 0.707, -0.7, fso);
  ) : m == 4 ? (
    atm = 1.5; rlm = 150; th0 = -5; rat = 0.667; kh = 4; ktk = 1; kp = 1; kn = 1; kw0 = 0.3; w1 = 0.6;
    pf1 = 16000; psf = 120;
    this.aL.tm_bqs(3, 6000, 0.707, 3, fso); this.bL.tm_bqs(3, 6000, 0.707, -1.5, fso);
  ) : (
    atm = 1.5; rlm = 900; th0 = -14; rat = 1; kh = 1; ktk = 0; kp = 1; kn = 0.85; kw0 = 0.06; w1 = 0.06;
    pf1 = 8000; psf = 150;
    this.aL.tm_bqs(1, 110, 0.707, 0, fso); this.bL.tm_bqs(2, 2500, 0.9, 2.5, fso);
  );
  this.aR.b0 = this.aL.b0; this.aR.b1 = this.aL.b1; this.aR.b2 = this.aL.b2; this.aR.a1 = this.aL.a1; this.aR.a2 = this.aL.a2;
  this.bR.b0 = this.bL.b0; this.bR.b1 = this.bL.b1; this.bR.b2 = this.bL.b2; this.bR.a1 = this.bL.a1; this.bR.a2 = this.bL.a2;
  this.kL.clp_set(2, kp, kn, 0); this.kR.clp_set(2, kp, kn, 0);
  this.kt.clp_kt_cfg(kw0, w1); this.kt.kti = 0;
  this.kL.clp_knee(kw0); this.kR.clp_knee(kw0);
  this.fL.clp_pf_cfg(40000, pf1, -1.5, psf); this.fR.clp_pf_cfg(40000, pf1, -1.5, psf);
  trim = 10 ^ (tm_TR[m] / 20);
);
function st_clear() instance(envL, envR, gL, gR, hsL, hsR, msL, msR, cur, dxL, dyL, dxR, dyR, apL, apR, slp, gd, go, gdT, goT, f, wk) (
  this.kL.clp_reset(); this.kR.clp_reset(); this.fL.clp_pf_reset(); this.fR.clp_pf_reset();
  this.aL.tm_bqc(); this.aR.tm_bqc(); this.bL.tm_bqc(); this.bR.tm_bqc(); this.cL.tm_bqc(); this.cR.tm_bqc();
  envL = envR = 0; gL = gR = 1; hsL = hsR = 0; msL = msR = 0; cur = 0; wk = 0;
  dxL = dyL = dxR = dyR = 0; apL = apR = slp = 0;
  gd = gdT; go = goT;
);
function st_block(ddb, rec, odb) instance(atm, rlm, th0, ktk, kw0, trim, alc, thr, att, rel, gdT, goT, dv, kw, mas, hk, dr)
  local(tsc) (
  dv = min(max(ddb / 24, 0), 1); dr = dv;
  thr = th0;
  tsc = 4 ^ ((rec - 5) / 5);
  att = 1 - exp(-1 / (max(atm, 0.02) * 0.001 * srate));
  rel = 1 - exp(-1 / (rlm * tsc * 0.001 * srate));
  hk = 1 - exp(-2 * $pi * 90 / srate);
  gdT = 10 ^ (ddb / 20); goT = trim * 10 ^ ((odb - 0.5 * ddb) / 20);
  this.fL.clp_pf_block(dv, os_f * srate, os_f * samplesblock); this.fR.clp_pf_block(dv, os_f * srate, os_f * samplesblock);
  !alc ? (
    clp_kt_on = ktk; kw = this.kt.clp_kt_block(dv, os_f * srate, os_f * samplesblock); clp_kt_on = 0;
    this.kL.clp_knee(kw); this.kR.clp_knee(kw);
  );
);
function st_tidy() instance(envL, envR, hsL, hsR, msL, msR, cur, dxL, dyL, dxR, dyR, apL, apR, slp) (
  this.kL.clp_tidy(); this.kR.clp_tidy();
  this.aL.tm_bqt(); this.aR.tm_bqt(); this.bL.tm_bqt(); this.bR.tm_bqt(); this.cL.tm_bqt(); this.cR.tm_bqt();
  this.fL.ic1 = tm_tn(this.fL.ic1); this.fL.ic2 = tm_tn(this.fL.ic2); this.fR.ic1 = tm_tn(this.fR.ic1); this.fR.ic2 = tm_tn(this.fR.ic2);
  envL = tm_tn(envL); envR = tm_tn(envR); hsL = tm_tn(hsL); hsR = tm_tn(hsR); msL = tm_tn(msL); msR = tm_tn(msR);
  cur = tm_tn(cur); dxL = tm_tn(dxL); dyL = tm_tn(dyL); dxR = tm_tn(dxR); dyR = tm_tn(dyR);
  apL = tm_tn(apL); apR = tm_tn(apR); slp = tm_tn(slp);
);
function st_gr(e) instance(thr, rat, kh) local(o) (
  o = 20 * log10(max(e, 0.000000001)) - thr;
  o <= -kh ? 0 : o >= kh ? rat * o : rat * sqr(o + kh) / (4 * kh);
);
function st_det(vl, vr) instance(alc, mas, att, rel, envL, envR, gL, gR, hsL, hsR, hk, msL, msR, cur, grl, grr, wk, dr, air, md)
  local(aL, aR, g, des, lv, w) (
  alc ? (
    msL += tm_mk * (vl * vl - msL); msR += tm_mk * (vr * vr - msR);
    tm_link ? ( msL = msR = max(msL, msR); );
    lv = 10 * log10(max(msL, msR) + 0.000000000001);
    des = lv < -62 ? 0 : min(max(-17 - lv, -24), 10);
    cur += (des < cur ? att : rel) * (des - cur);
    gL = gR = 10 ^ (cur / 20);
    w = 0.06 + 0.5 * min(max(-cur / 18, 0), 1);
    this.kL.clp_knee(w); this.kR.clp_knee(w);
    grl = max(grl, -cur); grr = max(grr, -cur);
  ) : (
    mas ? ( hsL += hk * (vl - hsL); hsR += hk * (vr - hsR); aL = abs(vl - hsL); aR = abs(vr - hsR); )
        : ( aL = abs(vl); aR = abs(vr); );
    tm_link ? ( aL = aR = max(aL, aR); );
    envL += (aL > envL ? att : rel) * (aL - envL);
    tm_link ? ( g = this.st_gr(envL); envR = envL; gL = gR = 10 ^ (-g / 20); grl = max(grl, g); grr = max(grr, g); ) : (
      g = this.st_gr(envL); gL = 10 ^ (-g / 20); grl = max(grl, g);
      envR += (aR > envR ? att : rel) * (aR - envR);
      des = this.st_gr(envR); gR = 10 ^ (-des / 20); grr = max(grr, des);
    );
    air ? wk = 0.25 * dr + 0.6 * (1 - min(gL, gR));
  );
);
function st_preL(x) instance(gd) ( this.fL.clp_pf_run(this.aL.tm_bq(x * gd)); );
function st_preR(x) instance(gd) ( this.fR.clp_pf_run(this.aR.tm_bq(x * gd)); );
function st_postL(v) instance(gL, go, dxL, dyL) local(y) (
  y = this.bL.tm_bq(this.cL.tm_cmp(this.kL.clp_run(v * gL))) * go;
  dyL = y - dxL + tm_dcr * dyL; dxL = y; dyL;
);
function st_postR(v) instance(gR, go, dxR, dyR) local(y) (
  y = this.bR.tm_bq(this.cR.tm_cmp(this.kR.clp_run(v * gR))) * go;
  dyR = y - dxR + tm_dcr * dyR; dxR = y; dyR;
);
function st_air(l, r) instance(apL, apR, slp, wk, ol, orr) local(y, s, h) (
  y = tm_apl * l + apL; apL = l - tm_apl * y; l = y;
  y = tm_apr * r + apR; apR = r - tm_apr * y; r = y;
  s = 0.5 * (l - r); slp += tm_slk * (s - slp); h = (s - slp) * wk;
  ol = l + h; orr = r - h;
);
function st_smp(pl, pr) instance(air, ol, orr) local(a, b) (
  a = this.st_postL(pl); b = this.st_postR(pr);
  air ? this.st_air(a, b) : ( ol = a; orr = b; );
);
function st_go() instance(f, ft, act, gd, gdT, go, goT, ol, orr) local(p, q, s) (
  f = ft ? min(f + tm_fst, 1) : max(f - tm_fst, 0);
  gd += (gdT - gd) * tm_sm; go += (goT - go) * tm_sm;
  s = f * f * (3 - 2 * f);
  p = this.st_preL(tm_l0); q = this.st_preR(tm_r0);
  this.st_det(p, q);
  this.st_smp(p, q); tm_l0 += s * (ol - tm_l0); tm_r0 += s * (orr - tm_r0);
  os_f > 1 ? (
    p = this.st_preL(tm_l1); q = this.st_preR(tm_r1);
    this.st_smp(p, q); tm_l1 += s * (ol - tm_l1); tm_r1 += s * (orr - tm_r1);
    os_f > 2 ? (
      p = this.st_preL(tm_l2); q = this.st_preR(tm_r2);
      this.st_smp(p, q); tm_l2 += s * (ol - tm_l2); tm_r2 += s * (orr - tm_r2);
      p = this.st_preL(tm_l3); q = this.st_preR(tm_r3);
      this.st_smp(p, q); tm_l3 += s * (ol - tm_l3); tm_r3 += s * (orr - tm_r3);
    );
  );
  f <= 0 && !ft ? act = 0;
);
function st_cdc() instance(cw, cwt, ca, cact, cmask) local(w0) (
  w0 = cw; cw = cwt ? min(cw + tm_cst, 1) : max(cw - tm_cst, 0);
  w0 > 0 || cw > 0 ? (
    !cact ? ( this.qL.cd_clr(); this.qR.cd_clr(); cact = 1; );
