desc:Quad22 [multiband compander] (GFX V4)
//tags: dynamics multiband compander saturation eq mastering v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-ui, gfx-v4-panel, gfx-v4-os and gfx-v4-bypass, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider53:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider2:0<-24,24,0.1>-Trim (dB)
slider3:-0.3<-12,0,0.1>-Ceiling (dB)
slider5:100<0,100,1>-Mix (%)

slider10:2<0,3,1{Off,Iron,Tape,Transistor}>-B1 Sat type
slider11:0<0,100,1>-B1 Drive (%)
slider13:0<-12,12,0.1>-B1 Low shelf 50 Hz (dB)
slider14:0<-100,100,1>-B1 Compand (lift - / expand +)
slider17:0<-24,24,0.1>-B1 Gain (dB)
slider18:0<0,1,1{Off,On}>-B1 Solo
slider19:0<0,1,1{Off,On}>-B1 Bypass

slider20:1<0,3,1{Off,Iron,Tape,Transistor}>-B2 Sat type
slider21:0<0,100,1>-B2 Drive (%)
slider23:0<-12,12,0.1>-B2 Bell 800 Hz (dB)
slider24:0<-100,100,1>-B2 Compand (lift - / expand +)
slider27:0<-24,24,0.1>-B2 Gain (dB)
slider28:0<0,1,1{Off,On}>-B2 Solo
slider29:0<0,1,1{Off,On}>-B2 Bypass

slider30:2<0,3,1{Off,Iron,Tape,Transistor}>-B3 Sat type
slider31:0<0,100,1>-B3 Drive (%)
slider33:0<-12,12,0.1>-B3 Bell 5 kHz (dB)
slider34:0<-100,100,1>-B3 Compand (lift - / expand +)
slider37:0<-24,24,0.1>-B3 Gain (dB)
slider38:0<0,1,1{Off,On}>-B3 Solo
slider39:0<0,1,1{Off,On}>-B3 Bypass

slider40:0<0,3,1{Off,Iron,Tape,Transistor}>-B4 Sat type
slider41:0<0,100,1>-B4 Drive (%)
slider43:0<-12,12,0.1>-B4 High shelf 12 kHz (dB)
slider44:0<-100,100,1>-B4 Compand (lift - / expand +)
slider47:0<-24,24,0.1>-B4 Gain (dB)
slider48:0<0,1,1{Off,On}>-B4 Solo
slider49:0<0,1,1{Off,On}>-B4 Bypass
slider50:0<0,1,1{Off,On}>-Bypass
slider51:0<0,2,1{1x,2x,4x}>-Oversampling
slider52:prs_sel=0<0,8,1{No preset,Init,Air Lift,Gentle Glue,Tape Master,Vocal Presence,Low-End Control,Analogue Sheen,Loudness Push}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4448570306410006, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4448570306410006, v); slider_show(psw_view, v); );
#ui_man = "gfx-v4-quad22";
ext_noinit = 1;
os_design(); os_base = 0; os_f = os_tf = os_f2n(slider51); os_gsetup();
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
nextmem = 0;
function alloc(n) local(ptr) ( ptr = nextmem; nextmem += n; ptr; );

compass_q = 0.70710678;

function bq(x, p) local(y) (
  y = p[0]*x + p[1]*p[5] + p[2]*p[6] - p[3]*p[7] - p[4]*p[8];
  p[6] = p[5]; p[5] = x; p[8] = p[7]; p[7] = y;
  y;
);

function setLP(p, f) local(w,c,s,al,a0) (
  f = min(f, 0.45*srate); w = 2*$pi*f/srate; c = cos(w); s = sin(w); al = s/(2*compass_q); a0 = 1+al;
  p[0] = ((1-c)*0.5)/a0; p[1] = (1-c)/a0; p[2] = ((1-c)*0.5)/a0;
  p[3] = (-2*c)/a0; p[4] = (1-al)/a0;
  p[5]=0; p[6]=0; p[7]=0; p[8]=0;
);

function setHP(p, f) local(w,c,s,al,a0) (
  f = min(f, 0.45*srate); w = 2*$pi*f/srate; c = cos(w); s = sin(w); al = s/(2*compass_q); a0 = 1+al;
  p[0] = ((1+c)*0.5)/a0; p[1] = -(1+c)/a0; p[2] = ((1+c)*0.5)/a0;
  p[3] = (-2*c)/a0; p[4] = (1-al)/a0;
  p[5]=0; p[6]=0; p[7]=0; p[8]=0;
);

function setAP(p, f) local(w,c,s,al,a0) (
  f = min(f, 0.45*srate); w = 2*$pi*f/srate; c = cos(w); s = sin(w); al = s/(2*compass_q); a0 = 1+al;
  p[0] = (1 - al) / a0;
  p[1] = (-2 * c) / a0;
  p[2] = (1 + al) / a0;
  p[3] = (-2 * c) / a0;
  p[4] = (1 - al) / a0;
  p[5]=0; p[6]=0; p[7]=0; p[8]=0;
);

lp80a = alloc(18); lp80b = alloc(18); hp80a = alloc(18); hp80b = alloc(18);
lp3a  = alloc(18); lp3b  = alloc(18); hp3a  = alloc(18); hp3b  = alloc(18);
lp9a  = alloc(18); lp9b  = alloc(18); hp9a  = alloc(18); hp9b  = alloc(18);

a13a = alloc(18);
a19a = alloc(18);
a29a = alloc(18);

adir1a = alloc(18);
adir2a = alloc(18);
adir3a = alloc(18);

F1 = 80; F2 = 3000; F3 = 9000;
function setupCh(co) (
  setLP(lp80a+co, F1); setLP(lp80b+co, F1); setHP(hp80a+co, F1); setHP(hp80b+co, F1);
  setLP(lp3a+co,  F2); setLP(lp3b+co,  F2); setHP(hp3a+co,  F2); setHP(hp3b+co,  F2);
  setLP(lp9a+co,  F3); setLP(lp9b+co,  F3); setHP(hp9a+co,  F3); setHP(hp9b+co,  F3);

  setAP(a13a+co, F2);
  setAP(a19a+co, F3);
  setAP(a29a+co, F3);

  setAP(adir1a+co, F1);
  setAP(adir2a+co, F2);
  setAP(adir3a+co, F3);
);
setupCh(0); setupCh(9);

function setLowShelf(p, f, gdb) local(A,w,c,s,al,sa,a0) (
  A = 10^(gdb/40); f = min(f, 0.45*srate); w = 2*$pi*f/srate; c = cos(w); s = sin(w);
  al = s/2*sqrt(2); sa = 2*sqrt(A)*al;
  a0 = (A+1) + (A-1)*c + sa;
  p[0] = A*((A+1) - (A-1)*c + sa)/a0;
  p[1] = 2*A*((A-1) - (A+1)*c)/a0;
  p[2] = A*((A+1) - (A-1)*c - sa)/a0;
  p[3] = -2*((A-1) + (A+1)*c)/a0;
  p[4] = ((A+1) + (A-1)*c - sa)/a0;
);

function setHighShelf(p, f, gdb) local(A,w,c,s,al,sa,a0) (
  A = 10^(gdb/40); f = min(f, 0.45*srate); w = 2*$pi*f/srate; c = cos(w); s = sin(w);
  al = s/2*sqrt(2); sa = 2*sqrt(A)*al;
  a0 = (A+1) - (A-1)*c + sa;
  p[0] = A*((A+1) + (A-1)*c + sa)/a0;
  p[1] = -2*A*((A-1) + (A+1)*c)/a0;
  p[2] = A*((A+1) + (A-1)*c - sa)/a0;
  p[3] = 2*((A-1) - (A+1)*c)/a0;
  p[4] = ((A+1) - (A-1)*c - sa)/a0;
);

function setBell(p, f, gdb, q) local(A,w,c,s,al,a0) (
  A = 10^(gdb/40); f = min(f, 0.45*srate); w = 2*$pi*f/srate; c = cos(w); s = sin(w);
  al = s/(2*q);
  a0 = 1 + al/A;
  p[0] = (1 + al*A)/a0;
  p[1] = (-2*c)/a0;
  p[2] = (1 - al*A)/a0;
  p[3] = (-2*c)/a0;
  p[4] = (1 - al/A)/a0;
);

eq1 = alloc(18); eq2 = alloc(18); eq3 = alloc(18); eq4 = alloc(18);
memset(eq1, 0, 18); memset(eq2, 0, 18); memset(eq3, 0, 18); memset(eq4, 0, 18);

function updEQ() (
  setLowShelf(eq1, 50, q2_e1);      setLowShelf(eq1+9, 50, q2_e1);
  setBell(eq2, 800, q2_e2, 0.7);    setBell(eq2+9, 800, q2_e2, 0.7);
  setBell(eq3, 5000, q2_e3, 0.7);   setBell(eq3+9, 5000, q2_e3, 0.7);
  setHighShelf(eq4, 12000, q2_e4);  setHighShelf(eq4+9, 12000, q2_e4);
  lg1 = q2_e1; lg2 = q2_e2; lg3 = q2_e3; lg4 = q2_e4;
);
q2_e1 = slider13; q2_e2 = slider23; q2_e3 = slider33; q2_e4 = slider43;
updEQ();

atkC = 1 - exp(-1/(0.003 * srate));
relC = 1 - exp(-1/(0.075 * srate));
relLF = 1 - exp(-1/(0.200 * srate));

cmpS = alloc(8);

dcR = 1 - 2*$pi*5/srate;
q2_lg = 0;

mtr = alloc(5);
q2_old = alloc(64); q2_new = alloc(64);
q2_dkr = 1 / (0.012*srate); q2_dk = 1; q2_dst = 0;

LN10 = log(10);
function db2g(d) ( exp(d*LN10/20); );

function splitBands(x, co) local(low1, hi80, b2_raw, hi3k, a13) (
  low1   = bq(bq(x, lp80a+co), lp80b+co);
  hi80   = bq(bq(x, hp80a+co), hp80b+co);

  b2_raw = bq(bq(hi80, lp3a+co), lp3b+co);
  hi3k   = bq(bq(hi80, hp3a+co), hp3b+co);

  b3     = bq(bq(hi3k, lp9a+co), lp9b+co);
  b4     = bq(bq(hi3k, hp9a+co), hp9b+co);

  a13    = bq(low1, a13a+co);
  b1     = bq(a13,  a19a+co);

  b2     = bq(b2_raw, a29a+co);

  direct_aligned = bq(bq(bq(x, adir1a+co), adir2a+co), adir3a+co);
);

function tanh(v) ( v = max(-20, min(20, v)); 1 - 2/(exp(2*v) + 1); );

function q2_c(v, t) (
  t == 1 ? ( v = max(-1, min(1, v)); 1.5*v - 0.5*v*v*v; ) :
  t == 2 ? tanh(v) :
  v >= 0 ? 1 - exp(-v) : -0.7*(1 - exp(v/0.7));
);
function q2_lc(v) local(a, q) (
  a = abs(v);
  a < 0.5 ? ( q = v*v; q*(0.5 - q*(0.0833333333333 - q*(0.0222222222222 - q*(0.00674603174603 - q*(0.00218694885362 - q*0.00147717362455))))); )
          : a + log(1 + exp(-2*a)) - q2_lcc;
);
q2_lcc = 0.5 + log(1 + exp(-1)) - 0.25*(0.5 - 0.25*(0.0833333333333 - 0.25*(0.0222222222222 - 0.25*(0.00674603174603 - 0.25*(0.00218694885362 - 0.25*0.00147717362455)))));
function q2_F(v, t) local(a) (
  t == 1 ? ( a = abs(v); a <= 1 ? v*v*(0.75 - 0.125*v*v) : a - 0.375; ) :
  t == 2 ? q2_lc(v) :
  v >= 0 ? v + exp(-v) - 1 : 0.49*(exp(v/0.7) - 1) - 0.7*v;
);
function q2_eng(x, t, d, e) instance(x1, v1, a1, ty, dd, k, sc, dx, dy) local(v, f, dv, y) (
  t == 0 ? ( x1 = x; x ) :
  t == 4 ? ( x1 = x; y = x - dx + dcR*dy; dx = x; dy = y; y ) : (
    (t !== ty || d !== dd) ? (
      ty = t; dd = d; k = t == 1 ? d/1.5 : d; v1 = x1*k; a1 = q2_F(v1, t);
      sc = (t == 2 ? 1/tanh(d) : 1) / (0.6 + 0.4*d);
    );
    v = x*k; f = q2_F(v, t); dv = v - v1;
    y = abs(dv) > 0.00001 ? (f - a1)/dv : q2_c(0.5*(v + v1), t);
    x1 = x; v1 = v; a1 = f;
    e *= k*k;
    y += t == 1 ? 0.75*dv/sqrt(1 + 4.5*e) : t == 2 ? 0.5*dv/sqrt(1 + 2*e) : 0.5*dv/(1 + 1.2*sqrt(e));
    y *= sc;
    t == 3 ? ( v = y - dx + dcR*dy; dx = y; dy = v; y = v; );
    y;
  );
);
function q2_eng0(x) instance(x1, ty, dx, dy) ( x1 = x; ty = -1; dx = dy = 0; );
function sat(x, t, drv, dsc) instance(ea, eb, ec, ct, cd, nt, nxd, fw, xp, ms, es) local(tt, dt, y, z) (
  tt = drv <= 0 ? (t == 3 ? 4 : 0) : t;
  dt = 1 + drv*0.09*((t == 2) ? 1 : dsc);
  ms += (x*x - ms)*q2_ero; es += (ms - es)*q2_eso;
  fw > 0 ? (
    tt == nt && tt > 0 && tt < 4 && nxd !== dt ? ( nxd += (dt - nxd)*q2_gco; abs(dt - nxd) < 0.00001 ? nxd = dt; );
    y = ec ? eb.q2_eng(x, ct, cd, es) : ea.q2_eng(x, ct, cd, es);
    z = ec ? ea.q2_eng(x, nt, nxd, es) : eb.q2_eng(x, nt, nxd, es);
    fw += q2_fro; fw >= 1 ? ( fw = 0; ec = !ec; ct = nt; cd = nxd; y = z; ) : y += (z - y)*fw*fw*(3 - 2*fw);
  ) : tt !== ct ? (
    nt = tt; nxd = dt; ec ? ea.q2_eng0(xp) : eb.q2_eng0(xp);
    y = ec ? eb.q2_eng(x, ct, cd, es) : ea.q2_eng(x, ct, cd, es);
    z = ec ? ea.q2_eng(x, nt, nxd, es) : eb.q2_eng(x, nt, nxd, es);
    fw = q2_fro; y += (z - y)*fw*fw*(3 - 2*fw);
  ) : (
    tt > 0 && tt < 4 && cd !== dt ? ( cd += (dt - cd)*q2_gco; abs(dt - cd) < 0.00001 ? cd = dt; );
    y = ec ? eb.q2_eng(x, ct, cd, es) : ea.q2_eng(x, ct, cd, es);
  );
  xp = x;
  y;
);
q2_gc = 1 - exp(-1/(0.02*srate)); q2_fr = 1/(0.01*srate);
q2_er = 1 - exp(-1/(0.01*srate)); q2_es = 1 - exp(-1/(0.003*srate));
function q2_rates() local(fs) (
  fs = srate*os_f;
  q2_gco = 1 - exp(-1/(0.02*fs)); q2_fro = 1/(0.01*fs);
  q2_ero = 1 - exp(-1/(0.01*fs)); q2_eso = 1 - exp(-1/(0.003*fs));
  dcR = 1 - 2*$pi*5/fs;
);

function softk(o, w) (
  o <= -w*0.5 ? 0 : o >= w*0.5 ? o : (o + w*0.5)*(o + w*0.5)/(2*w);
);

function softknee(x, c, sp, rc) local(ax, co_c, env, envdb, a, s, T, g) (
  ax = abs(x);
  co_c = ax > sp[0] ? atkC : rc;
  sp[0] = sp[0] + co_c*(ax - sp[0]);
  env = sp[0];
  a = max(0, min(1, (abs(c) - 2)/98));
  q2_lg = 0;
  a <= 0 ? x : (
    envdb = env > 0.0000001 ? 20*log(env)/LN10 : -140;
    c < 0 ? (
      T = -20; s = 0.6*a;
      g = min(15*a, s*softk(T - envdb, 12));
    ) : (
      T = -50 + 24*a; s = a;
      g = max(-40, -s*softk(T - envdb, 12));
    );
    q2_lg = g;
    x * db2g(g);
  );
);

function limiter(x, ceil) instance(x1, v1, a1, cl, ms, es) local(v, f, dv, y) (
  ceil !== cl ? ( cl = ceil; v1 = x1 / ceil; a1 = q2_lc(v1); );
  v = x / ceil; f = q2_lc(v); dv = v - v1;
  y = abs(dv) > 0.00001 ? (f - a1)/dv : tanh(0.5*(v + v1));
  x1 = x; v1 = v; a1 = f;
  ms += (v*v - ms)*q2_er; es += (ms - es)*q2_es;
  ceil * (y + 0.5*dv/sqrt(1 + 2*es));
);

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);
function fz_one(l, r) ( fz_l = l; fz_r = r; fz_o > 0.0001 ? fz_run(); );

function q2_sb(xl, xr, t, d, dsc, fz) local(i, a, c, p0, p1, p2, p3, qq0, qq1, qq2, qq3) (
  os_f == 1 ? (
    a = this.sl.sat(xl, t, d, dsc); c = this.sr.sat(xr, t, d, dsc);
    fz ? ( fz_one(a, c); a = fz_l; c = fz_r; );
    q2_yl = a; q2_yr = c;
  ) : (
    this.ul.os_up(xl); this.ur.os_up(xr);
    i = 0;
    loop(os_f,
      a = this.sl.sat(this.ul.os_s(i), t, d, dsc); c = this.sr.sat(this.ur.os_s(i), t, d, dsc);
      fz ? ( fz_one(a, c); a = fz_l; c = fz_r; );
      i == 0 ? ( p0 = a; qq0 = c; ) : i == 1 ? ( p1 = a; qq1 = c; ) : i == 2 ? ( p2 = a; qq2 = c; ) : ( p3 = a; qq3 = c; );
      i += 1;
    );
    q2_yl = this.nl.os_dn(p0, p1, p2, p3); q2_yr = this.nr.os_dn(qq0, qq1, qq2, qq3);
  );
);
function q2_sclr() instance(ea, eb, ms, es, xp, fw, ec, ct, nt, cd, nxd) (
  ea.q2_eng0(0); eb.q2_eng0(0); ms = es = xp = 0;
  fw > 0 ? ( fw = 0; ec = !ec; ct = nt; cd = nxd; );
);
function q2_bclr() ( this.sl.q2_sclr(); this.sr.q2_sclr(); this.ul.os_clr(); this.ur.os_clr(); this.nl.os_clr(); this.nr.os_clr(); );
function q2_osclr() ( this.ul.os_clr(); this.ur.os_clr(); this.nl.os_clr(); this.nr.os_clr(); );
function bqclr(p, n) ( loop(n, p[5] = p[6] = p[7] = p[8] = 0; p += 9; ); );
function q2_clear() (
  bqclr(0, (eq4 + 18) / 9); memset(cmpS, 0, 8);
  bd1.q2_bclr(); bd2.q2_bclr(); bd3.q2_bclr(); bd4.q2_bclr(); fz_clr();
  lmL.x1 = lmR.x1 = 0; lmL.cl = lmR.cl = -1; lmL.ms = lmL.es = lmR.ms = lmR.es = 0;
  gdc_x0 = gdc_y0 = gdc_x1 = gdc_y1 = 0;
  memset(osd, 0, 128); memset(DRY, 0, 2048);
);

function pm(trim, ceil, mix) ( slider2 = trim; slider3 = ceil; slider5 = mix; );
function pb(base, sat, drv, eq, cpd, gn) (
  slider(base) = sat; slider(base+1) = drv; slider(base+3) = eq; slider(base+4) = cpd; slider(base+7) = gn;
);
function q2_apply_now(n) (
  n == 0 ? (
    pm(0, -0.3, 100); pb(10, 0, 0, 0, 0, 0); pb(20, 0, 0, 0, 0, 0); pb(30, 0, 0, 0, 0, 0); pb(40, 0, 0, 0, 0, 0);
  ) : n == 1 ? (
    pm(0, -0.3, 100); pb(10, 0, 0, 0, 0, 0); pb(20, 0, 0, 0, 0, 0); pb(30, 0, 0, 1.0, -35, 0); pb(40, 0, 0, 2.0, -50, 0);
  ) : n == 2 ? (
    pm(0, -0.3, 100); pb(10, 0, 0, 0, -15, 0); pb(20, 2, 15, 0, -20, 0); pb(30, 0, 0, 0, -20, 0); pb(40, 0, 0, 0, -20, 0);
  ) : n == 3 ? (
    pm(0, -0.3, 100); pb(10, 2, 20, 1.0, 0, 0); pb(20, 2, 20, 0, 0, 0); pb(30, 2, 15, 0, 0, 0); pb(40, 2, 10, -0.5, 0, 0);
  ) : n == 4 ? (
    pm(0, -0.3, 100); pb(10, 0, 0, 0, 0, 0); pb(20, 0, 0, -0.5, 0, 0); pb(30, 0, 0, 2.0, -30, 0); pb(40, 0, 0, 1.0, 0, 0);
  ) : n == 5 ? (
    pm(0, -0.3, 100); pb(10, 1, 15, 0, 25, 0); pb(20, 0, 0, -1.0, 0, 0); pb(30, 0, 0, 0, 0, 0); pb(40, 0, 0, 0, 0, 0);
  ) : n == 6 ? (
    pm(0, -0.3, 100); pb(10, 0, 0, 0, 0, 0); pb(20, 0, 0, 0, 0, 0); pb(30, 0, 0, 0.5, 0, 0); pb(40, 3, 25, 2.5, -30, 0);
  ) : (
    pm(2.0, -0.3, 100); pb(10, 1, 10, 0, -25, 0); pb(20, 2, 10, 0, -30, 0); pb(30, 0, 0, 0, -30, 0); pb(40, 0, 0, 0, -30, 0);
  );
);

function apply_preset(n) local(i) (
  i = 1; loop(49, q2_old[i] = slider(i); i += 1; );
  q2_apply_now(n);
  i = 1; loop(49, q2_new[i] = slider(i); slider(i) = q2_old[i]; i += 1; );
  q2_dst = 1;
);
function load_preset(p) ( apply_preset(max(0, min(7, p - 1))); );

osd = alloc(128); memset(osd, 0, 128); osd_w = 0;
DLB = alloc(512); memset(DLB, 0, 512); q2_bw = 0;
DRY = 7100000; memset(DRY, 0, 2048); dw = 0;
q2_rates();
fz_coefs(srate * os_f); fz_clr(); fz_o = fz_t = 0;
by_setup(50);
gk = 1 - exp(-1/(0.03*srate)); mk = 1 - exp(-1/(0.01*srate));
q2_snap = 1; rs_f = 1; rs_c = 1 / (0.015 * srate);

#q2_pmn = "Init|Air Lift|Gentle Glue|Tape Master|Vocal Presence|Low-End Control|Analogue Sheen|Loudness Push";
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(51, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(51));

@block
prs_chk();
q2_dst == 3 ? q2_dst = 2;
q2_kb = q2_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
q2_e1 += (slider13 - q2_e1) * q2_kb; abs(slider13 - q2_e1) < 0.001 ? q2_e1 = slider13;
q2_e2 += (slider23 - q2_e2) * q2_kb; abs(slider23 - q2_e2) < 0.001 ? q2_e2 = slider23;
q2_e3 += (slider33 - q2_e3) * q2_kb; abs(slider33 - q2_e3) < 0.001 ? q2_e3 = slider33;
q2_e4 += (slider43 - q2_e4) * q2_kb; abs(slider43 - q2_e4) < 0.001 ? q2_e4 = slider43;
(q2_e1 != lg1 || q2_e2 != lg2 || q2_e3 != lg3 || q2_e4 != lg4) ? updEQ();
gl1 = db2g(slider17); gl2 = db2g(slider27); gl3 = db2g(slider37); gl4 = db2g(slider47);
ceilL = db2g(slider3); trim = db2g(slider2); mixT = slider5 * 0.01;
anySolo = slider18 || slider28 || slider38 || slider48;
so1 = (anySolo && !slider18) ? 0 : 1; so2 = (anySolo && !slider28) ? 0 : 1;
so3 = (anySolo && !slider38) ? 0 : 1; so4 = (anySolo && !slider48) ? 0 : 1;
fz_t = slider40 >= 0.5 ? 0.33 * max(0, (slider41 - 50) / 50) : 0;
os_tf = os_f2n(slider51);
q2_snap ? (
  q2_snap = 0;
  ceilS = ceilL; trimS = trim; mixS = mixT; fz_o = fz_t;
  c1s = slider14; c2s = slider24; c3s = slider34; c4s = slider44;
  g1s = gl1; g2s = gl2; g3s = gl3; g4s = gl4;
  m1s = so1; m2s = so2; m3s = so3; m4s = so4;
  y1s = slider19 >= 0.5; y2s = slider29 >= 0.5; y3s = slider39 >= 0.5; y4s = slider49 >= 0.5;
);
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_bot_ch = 0; pdc_top_ch = 2;
vu_d = max(vu_d, sqrt(bm_ms / max(samplesblock, 1))); bm_ms = 0;
os_snapb(slider(51));

@sample
by_in();
rs_req ? ( rs_req = 0; q2_clear(); rs_f = 0; rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay; );
rw_l = spl0; rw_r = spl1;
os_gate();
os_chg ? ( q2_rates(); fz_coefs(srate * os_f); fz_clr(); bd1.q2_osclr(); bd2.q2_osclr(); bd3.q2_osclr(); bd4.q2_osclr(); memset(osd, 0, 128); memset(DLB, 0, 512); );
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
spl0 != spl0 ? spl0 = 0;
spl1 != spl1 ? spl1 = 0;
c1s != slider14 ? ( c1s += (slider14 - c1s) * gk; abs(slider14 - c1s) < 0.0001 ? c1s = slider14; );
c2s != slider24 ? ( c2s += (slider24 - c2s) * gk; abs(slider24 - c2s) < 0.0001 ? c2s = slider24; );
c3s != slider34 ? ( c3s += (slider34 - c3s) * gk; abs(slider34 - c3s) < 0.0001 ? c3s = slider34; );
c4s != slider44 ? ( c4s += (slider44 - c4s) * gk; abs(slider44 - c4s) < 0.0001 ? c4s = slider44; );
g1s != gl1 ? ( g1s += (gl1 - g1s) * gk; abs(gl1 - g1s) < 0.0000001 ? g1s = gl1; );
g2s != gl2 ? ( g2s += (gl2 - g2s) * gk; abs(gl2 - g2s) < 0.0000001 ? g2s = gl2; );
g3s != gl3 ? ( g3s += (gl3 - g3s) * gk; abs(gl3 - g3s) < 0.0000001 ? g3s = gl3; );
g4s != gl4 ? ( g4s += (gl4 - g4s) * gk; abs(gl4 - g4s) < 0.0000001 ? g4s = gl4; );
m1s != so1 ? ( m1s += (so1 - m1s) * mk; abs(so1 - m1s) < 0.0000001 ? m1s = so1; );
m2s != so2 ? ( m2s += (so2 - m2s) * mk; abs(so2 - m2s) < 0.0000001 ? m2s = so2; );
m3s != so3 ? ( m3s += (so3 - m3s) * mk; abs(so3 - m3s) < 0.0000001 ? m3s = so3; );
m4s != so4 ? ( m4s += (so4 - m4s) * mk; abs(so4 - m4s) < 0.0000001 ? m4s = so4; );
y1s += ((slider19 >= 0.5) - y1s) * mk; abs((slider19 >= 0.5) - y1s) < 0.0000001 ? y1s = slider19 >= 0.5;
y2s += ((slider29 >= 0.5) - y2s) * mk; abs((slider29 >= 0.5) - y2s) < 0.0000001 ? y2s = slider29 >= 0.5;
y3s += ((slider39 >= 0.5) - y3s) * mk; abs((slider39 >= 0.5) - y3s) < 0.0000001 ? y3s = slider39 >= 0.5;
y4s += ((slider49 >= 0.5) - y4s) * mk; abs((slider49 >= 0.5) - y4s) < 0.0000001 ? y4s = slider49 >= 0.5;
mixS != mixT ? ( mixS += (mixT - mixS) * gk; abs(mixT - mixS) < 0.0000001 ? mixS = mixT; );
fz_o != fz_t ? ( fz_o += (fz_t - fz_o) * gk; abs(fz_t - fz_o) < 0.000001 ? fz_o = fz_t; );

splitBands(spl0, 0); aL1 = b1; aL2 = b2; aL3 = b3; aL4 = b4; dryL = direct_aligned;
splitBands(spl1, 9); aR1 = b1; aR2 = b2; aR3 = b3; aR4 = b4; dryR = direct_aligned;
os_f > 1 ? (
  osd_w = (osd_w + 1) & 63; osd[osd_w] = dryL; osd[64 + osd_w] = dryR;
  osd_r = (osd_w - os_lat(os_f)) & 63; dryL = osd[osd_r]; dryR = osd[64 + osd_r];
);

bd1.q2_sb(aL1, aR1, slider10, slider11, 0.4, 0); sl1 = q2_yl; sr1 = q2_yr;
bd2.q2_sb(aL2, aR2, slider20, slider21, 0.75, 0); sl2 = q2_yl; sr2 = q2_yr;
bd3.q2_sb(aL3, aR3, slider30, slider31, 1, 0); sl3 = q2_yl; sr3 = q2_yr;
bd4.q2_sb(aL4, aR4, slider40, slider41, 1, fz_o > 0); sl4 = q2_yl; sr4 = q2_yr;
os_f > 1 ? (
  q2_bw = (q2_bw + 1) & 63; q2_br = (q2_bw - os_lat(os_f)) & 63;
  DLB[q2_bw] = aL1; DLB[64 + q2_bw] = aR1; DLB[128 + q2_bw] = aL2; DLB[192 + q2_bw] = aR2;
  DLB[256 + q2_bw] = aL3; DLB[320 + q2_bw] = aR3; DLB[384 + q2_bw] = aL4; DLB[448 + q2_bw] = aR4;
  aL1 = DLB[q2_br]; aR1 = DLB[64 + q2_br]; aL2 = DLB[128 + q2_br]; aR2 = DLB[192 + q2_br];
  aL3 = DLB[256 + q2_br]; aR3 = DLB[320 + q2_br]; aL4 = DLB[384 + q2_br]; aR4 = DLB[448 + q2_br];
);

q2_l = bq(sl1, eq1); q2_r = bq(sr1, eq1 + 9);
q2_l = softknee(q2_l, c1s, cmpS + 0, relLF); q2_g1 = q2_lg; q2_r = softknee(q2_r, c1s, cmpS + 4, relLF); q2_g1 = abs(q2_lg) > abs(q2_g1) ? q2_lg : q2_g1;
L1 = (q2_l * g1s + (aL1 - q2_l * g1s) * y1s) * m1s; R1 = (q2_r * g1s + (aR1 - q2_r * g1s) * y1s) * m1s;

q2_l = bq(sl2, eq2); q2_r = bq(sr2, eq2 + 9);
q2_l = softknee(q2_l, c2s, cmpS + 1, relC); q2_g2 = q2_lg; q2_r = softknee(q2_r, c2s, cmpS + 5, relC); q2_g2 = abs(q2_lg) > abs(q2_g2) ? q2_lg : q2_g2;
L2 = (q2_l * g2s + (aL2 - q2_l * g2s) * y2s) * m2s; R2 = (q2_r * g2s + (aR2 - q2_r * g2s) * y2s) * m2s;

q2_l = bq(sl3, eq3); q2_r = bq(sr3, eq3 + 9);
q2_l = softknee(q2_l, c3s, cmpS + 2, relC); q2_g3 = q2_lg; q2_r = softknee(q2_r, c3s, cmpS + 6, relC); q2_g3 = abs(q2_lg) > abs(q2_g3) ? q2_lg : q2_g3;
L3 = (q2_l * g3s + (aL3 - q2_l * g3s) * y3s) * m3s; R3 = (q2_r * g3s + (aR3 - q2_r * g3s) * y3s) * m3s;

q2_l = bq(sl4, eq4); q2_r = bq(sr4, eq4 + 9);
q2_l = softknee(q2_l, c4s, cmpS + 3, relC); q2_g4 = q2_lg; q2_r = softknee(q2_r, c4s, cmpS + 7, relC); q2_g4 = abs(q2_lg) > abs(q2_g4) ? q2_lg : q2_g4;
L4 = (q2_l * g4s + (aL4 - q2_l * g4s) * y4s) * m4s; R4 = (q2_r * g4s + (aR4 - q2_r * g4s) * y4s) * m4s;

lf1_d = max(lf1_d, q2_g1); ct1_d = max(ct1_d, -q2_g1);
lf2_d = max(lf2_d, q2_g2); ct2_d = max(ct2_d, -q2_g2);
lf3_d = max(lf3_d, q2_g3); ct3_d = max(ct3_d, -q2_g3);
lf4_d = max(lf4_d, q2_g4); ct4_d = max(ct4_d, -q2_g4);

procL = L1 + L2 + L3 + L4;
procR = R1 + R2 + R3 + R4;
trimS !== trim ? ( trimS += (trim - trimS)*q2_gc; abs(trim - trimS) < 0.000001 ? trimS = trim; );
outL = (dryL*(1 - mixS) + procL*mixS) * trimS;
outR = (dryR*(1 - mixS) + procR*mixS) * trimS;
q2_dst == 1 ? ( q2_dk -= q2_dkr; q2_dk <= 0 ? (
  q2_dk = 0; q2_i = 1; loop(49, slider(q2_i) = q2_new[q2_i]; q2_i += 1; ); q2_dst = 3; q2_note_dirty = 1; ); ) :
q2_dst == 2 ? ( q2_dk += q2_dkr; q2_dk >= 1 ? ( q2_dk = 1; q2_dst = 0; ); );
q2_dst ? ( q2_dkg = q2_dk*q2_dk*(3 - 2*q2_dk); outL *= q2_dkg; outR *= q2_dkg; );
ceilS !== ceilL ? ( ceilS += (ceilL - ceilS)*q2_gc; abs(ceilL - ceilS) < 0.000001 ? ceilS = ceilL; );
max(abs(outL), abs(outR)) > 0.891 * ceilS ? lim_d = 1;
spl0 = lmL.limiter(outL, ceilS) * os_g;
spl1 = lmR.limiter(outR, ceilS) * os_g;
DRY[dw] = rw_l; DRY[1024 + dw] = rw_r;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
  rs_s = rs_f * rs_f * (3 - 2 * rs_f); rs_xs = rs_x * rs_x * (3 - 2 * rs_x);
  rs_dl = rw_l + (DRY[(dw - pdc_delay) & 1023] - rw_l) * rs_xs;
  rs_dr = rw_r + (DRY[1024 + ((dw - pdc_delay) & 1023)] - rw_r) * rs_xs;
  spl0 = rs_dl + (spl0 - rs_dl) * rs_s; spl1 = rs_dr + (spl1 - rs_dr) * rs_s;
);
dw = (dw + 1) & 1023;
by_out();
bm_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x1C1D21; mk_band = 0x080A0B; mk_ink = 0xE2ECEE; mk_acc = 0x36CFE0; mk_tab = 0x36C4D6; mk_tink = 0x0A1A1E;
mk_sub = 0x16252A; mk_hot = 0x8FE6EE; mk_hov = 0x8FEFFA; mk_hink = 0xD8E8EC;
mk_drv = 0xC7BEB3; mk_cmp = 0x9FE6EE; mk_mix = 0xEFE6D2;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.35);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, ra, rb) local(rr) (
  rr = ra * sc + 0.75; while (rr <= rb * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
