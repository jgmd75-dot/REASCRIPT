function fm_ms(v) ( v < 10 ? sprintf(#fmm, "%.1f ms", v) : v < 1000 ? sprintf(#fmm, "%d ms", v + 0.5) : sprintf(#fmm, "%.2f s", v / 1000); #fmm; );
