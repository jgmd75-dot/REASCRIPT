    pv(21, 600); pv(22, 2500); pv(23, 50); pv(24, 2000); pv(25, 500); pv(26, 3000); pv(27, 85); pv(28, 2000);
    pv(54, 0.5); pv(55, 1); pv(56, 1); pv(57, 0); pv(58, 700); pv(59, 2000); pv(60, 0.4); pv(61, 0.7);
    pv(36, 0.2); pv(41, 0.1); pv(43, 0.85); pv(44, 5); pv(45, 0.5); pv(46, 0.35); pv(49, -3); ) :
  p == 15 ? (
    pv(1, 0); pv(2, 0); pv(3, 0.2); pv(6, 0); pv(7, 6); pv(8, 0.5); pv(9, 0); pv(12, 700); pv(13, 0.2);
    pv(15, 0.5); pv(21, 60); pv(22, 600); pv(23, 45); pv(24, 300); pv(25, 20); pv(26, 500); pv(27, 85); pv(28, 400);
    pv(30, 1); pv(31, 6); pv(33, 5); pv(35, 4); pv(36, 0.15); pv(41, 0);
    pv(54, 0.45); pv(56, 1); pv(57, 1); pv(58, 250); pv(59, 900); pv(60, 0.65); pv(61, 0.75);
    pv(43, 0.5); pv(44, 2.2); pv(45, 0.5); pv(46, 0.2); pv(49, -4); ) :
  p == 16 ? (
    pv(1, 0); pv(2, 0.3); pv(3, 0.25); pv(5, 1); pv(6, 12); pv(8, 0.25); pv(12, 400); pv(13, 0.75); pv(14, 6);
    pv(15, 0.7); pv(16, 0.7); pv(21, 0.5); pv(22, 180); pv(23, 0); pv(24, 180);
    pv(25, 0.5); pv(26, 450); pv(27, 0); pv(28, 350); pv(36, 0.2); pv(39, 8); pv(40, 0.45);
    pv(41, 0.2); pv(44, 2.8); pv(45, 0.45); pv(46, 0.25);
    pv(54, 0.3); pv(55, 0); pv(56, 1); pv(57, 1); pv(58, 20); pv(59, 3000); pv(60, 0.6); pv(61, 0.8); pv(62, 0.5); pv(63, 0); pv(49, -1); ) :
  p == 17 ? (
    pv(54, 1); pv(55, 1); pv(56, 1); pv(57, 0); pv(58, 600); pv(59, 2200); pv(60, 0.5); pv(61, 0.25); pv(62, 0.4); pv(63, 1);
    pv(36, 0); pv(41, 0); pv(43, 0.85); pv(44, 4); pv(45, 0.5); pv(46, 0.35); pv(49, -0.5); ) :
  p == 18 ? (
    pv(1, 0); pv(2, 0.3); pv(3, 0.25); pv(5, 1); pv(6, 12); pv(8, 0.25); pv(12, 400); pv(13, 0.75); pv(14, 6);
    pv(15, 0.7); pv(16, 0.7); pv(21, 0.5); pv(22, 180); pv(23, 0); pv(24, 180);
    pv(25, 0.5); pv(26, 450); pv(27, 0); pv(28, 350); pv(36, 0.2); pv(39, 8); pv(40, 0.45);
    pv(41, 0.15); pv(44, 3); pv(45, 0.5); pv(46, 0.3);
    pv(54, 0.3); pv(55, 0); pv(56, 1); pv(57, 1); pv(58, 120); pv(59, 2500); pv(60, 0.55); pv(61, 0.35); pv(62, 0.4); pv(63, 1); pv(49, -1); ) :
  p == 19 ? (
    pv(54, 1); pv(55, 0); pv(56, 1); pv(57, 1); pv(58, 300); pv(59, 1800); pv(60, 0.6); pv(61, 0.6); pv(62, 0.4); pv(63, 2);
    pv(36, 0); pv(41, 0); pv(43, 0.7); pv(44, 3); pv(45, 0.5); pv(46, 0.3); ) :
