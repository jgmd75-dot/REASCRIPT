desc:Flurry [synth] (GFX V4)
//tags: instrument synthesizer virtual analog hyper-saw strings v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-drift, gfx-v4-warmup, gfx-v4-output, gfx-v4-ui, gfx-v4-panel, gfx-v4-power, gfx-v4-bverb, gfx-v4-bdelay, gfx-v4-sliders (.jsfx-inc) in the same folder.

import gfx-v4-drift.jsfx-inc
import gfx-v4-warmup.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-bverb.jsfx-inc
import gfx-v4-bdelay.jsfx-inc
import gfx-v4-sliders.jsfx-inc

out_pin:left output
out_pin:right output

slider65:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:osc_mode=1<0,1,1{Classic,HyperSaw}>-Osc 1 mode
slider2:dens=0.6<0,1,0.001>-Density / Shape
slider3:spread=0.45<0,1,0.001>-Spread
slider4:pwm=0.2<0,1,0.001>-PWM depth (LFO)
slider5:o2wave=0<0,3,1{Saw,Pulse,Triangle,Sine}>-Osc 2 wave
slider6:o2semi=-12<-24,24,1>-Osc 2 semitones
slider7:o2fine=7<-50,50,0.1>-Osc 2 detune (cents)
slider8:obal=0.2<0,1,0.001>-Osc balance (1 > 2)
slider9:sublvl=0.2<0,1,0.001>-Sub level
slider10:noislvl=0<0,1,0.001>-Noise level
slider11:f1mode=0<0,3,1{LP 24,LP 12,BP,HP 24}>-Filter 1 mode
slider12:cutoff=1800<20,20000,1:log>-Cutoff (Hz)
slider13:fres=0.35<0,1,0.001>-Resonance
slider14:fdrive=0<0,24,0.1>-Filter drive (dB)
slider15:fenvamt=0.45<-1,1,0.001>-Filter env amount
slider16:fkey=0.5<0,1,0.01>-Key tracking
slider17:f2mode=0<0,4,1{Off,LP 12,HP 12,BP,Notch}>-Filter 2 mode
slider18:f2off=0<-4,4,0.01>-Filter 2 offset (oct)
slider19:f2res=0.2<0,1,0.001>-Filter 2 resonance
slider20:froute=0<0,1,1{Serial,Parallel}>-Filter routing
slider21:fe_a=2<0.5,5000,0.1:log>-Filter attack (ms)
slider22:fe_d=350<1,10000,1:log>-Filter decay (ms)
slider23:fe_s=20<0,100,0.1>-Filter sustain (%)
slider24:fe_r=400<1,10000,1:log>-Filter release (ms)
slider25:ae_a=2<0.5,5000,0.1:log>-Amp attack (ms)
slider26:ae_d=600<1,10000,1:log>-Amp decay (ms)
slider27:ae_s=85<0,100,0.1>-Amp sustain (%)
slider28:ae_r=350<1,10000,1:log>-Amp release (ms)
slider29:vsens=0.5<0,1,0.01>-Velocity
slider30:ds_type=0<0,5,1{Off,Soft,Tube,Diode,Rectify,Hard}>-Distortion type
slider31:ds_drv=12<0,36,0.1>-Distortion drive (dB)
slider32:ds_pos=1<0,1,1{Pre-filter,Post-filter}>-Distortion position
slider33:lfo_hz=0.8<0.01,20,0.01:log>-LFO rate (Hz)
slider34:lfo_cut=0<0,4,0.01>-LFO > cutoff (oct)
slider35:lfo_pit=0<0,100,0.1>-LFO > pitch (cents)
slider36:ch_mix=0.25<0,1,0.001>-Chorus mix
slider37:dl_sync=1<0,1,1{Free,Sync}>-Delay sync
slider38:dl_ms=350<10,2000,1:log>-Delay time (ms)
slider39:dl_div=4<0,13,1{1/1,1/2,1/2D,1/2T,1/4,1/4D,1/4T,1/8,1/8D,1/8T,1/16,1/16D,1/16T,1/32}>-Delay time (sync)
slider40:dl_fb=0.4<0,0.95,0.001>-Delay feedback
slider41:dl_mix=0.2<0,1,0.001>-Delay mix
slider42:dl_pp=1<0,1,1{Stereo,Ping-pong}>-Delay mode
slider43:sp_size=0.6<0,1,0.001>-Space size
slider44:sp_decay=2.8<0.2,12,0.01:log>-Space decay (s)
slider45:sp_damp=0.45<0,1,0.001>-Space damping
slider46:sp_mix=0.2<0,1,0.001>-Space mix
slider47:eq_lo=0<-12,12,0.1>-EQ low (dB)
slider48:0<0,100,1>-Saturation (%)
slider49:vol=0<-24,6,0.1>-Volume (dB)
slider50:npoly=8<1,8,1>-Voices
slider51:drift=50<0,100,1>-Drift (%)
slider52:lfo_sync=0<0,1,1{Free,Sync}>-LFO sync
slider53:lfo_div=5<0,13,1{4 bars,2 bars,1 bar,1/2,1/2 dotted,1/4,1/4 dotted,1/4 triplet,1/8,1/8 dotted,1/8 triplet,1/16,1/16 triplet,1/32}>-LFO note value
slider54:str_bal=0<0,1,0.001>-Strings blend (synth > strings)
slider55:str_16=0<0,1,1{Off,On}>-Strings 16'
slider56:str_8=1<0,1,1{Off,On}>-Strings 8'
slider57:str_4=1<0,1,1{Off,On}>-Strings 4'
slider58:str_att=450<1,5000,0.1:log>-Strings attack (ms)
slider59:str_rel=1200<1,10000,1:log>-Strings release (ms)
slider60:str_tone=0.5<0,1,0.001>-Strings tone
slider61:ens_amt=0.7<0,1,0.001>-Ensemble amount
slider62:ens_spd=0.5<0,1,0.001>-Ensemble speed
slider63:str_mdl=0<0,2,1{Machine,Chamber,Synth}>-Strings model
slider64:prs_sel=0<0,20,1{No preset,Init,Super Lead,Wide Pad,Juicy Bass,Reso Pluck,PWM Strings,Classic Brass,Rave Hoover,Tube Keys,Ice Drone,Acid Line,Digital Grit,String Machine,Hyper Strings,Brass and Strings,Pluck and Strings,Chamber Section,Pluck and Bows,Poly Strings,Sweep Pad}>-Preset

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(lfo_div, v); slider_show(str_bal, v); slider_show(str_16, v); slider_show(str_8, v); slider_show(str_4, v); slider_show(str_att, v); slider_show(str_rel, v); slider_show(str_tone, v); slider_show(ens_amt, v); slider_show(ens_spd, v); slider_show(str_mdl, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(lfo_div, v); slider_show(str_bal, v); slider_show(str_16, v); slider_show(str_8, v); slider_show(str_4, v); slider_show(str_att, v); slider_show(str_rel, v); slider_show(str_tone, v); slider_show(ens_amt, v); slider_show(ens_spd, v); slider_show(str_mdl, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-v4-g-flurry";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

NV = 8;  VS = 80;  VOX = 0;
U_MEM = 1024;
UT = 1900;
HOFF = 1940;
RVM = 1960;
BF_S = 1970;
M_G1 = 0.68;  M_G2 = 0.67;
MQ = 4096;
MQMAX = 1000;
FX_MEM = 1048576;

F_ON = 0;   F_NOTE = 1;  F_VEL = 2;   F_AGE = 3;   F_GATE = 4;  F_SUS = 5;
F_AEN = 6;  F_AST = 7;   F_FEN = 8;   F_FST = 9;
F_INC = 10; F_FADE = 11; F_PEND = 12; F_PVEL = 13; F_STEAL = 14;
F_AV = 15;  F_AS = 16;   F_GAIN = 17; F_FVEL = 18;
F_G = 19;   F_GS = 20;
F_A1 = 21;  F_A1S = 22;  F_A2 = 23;  F_A2S = 24;  F_A3 = 25;  F_A3S = 26;
F_LL = 27;  F_LR = 31;
F_SVL = 35;  F_SVR = 37;
F_P2 = 39;  F_I2 = 40;  F_PS = 41;  F_IS = 42;  F_PW = 43;
F_DL = 45;  F_DR = 49;
F_NEW = 53;
F_DV = 54;  F_DT = 55;  F_DTM = 56;  F_NDT = 57;
F_WV = 58;  F_WT = 59;  F_WTM = 60;
F_SEN = 61;  F_SST = 62;  F_SV = 63;  F_SS = 64;
F_SP = 65;  F_SI = 66;
F_SVT = 67;  F_SPW = 68;  F_FIN = 69;  F_NW = 70;

memset(VOX, 0, NV * VS);  memset(U_MEM, 0, NV * 20);
HOFF[0] = 0;  HOFF[1] = -0.18;  HOFF[2] = 0.18;  HOFF[3] = -0.40;  HOFF[4] = 0.40;
HOFF[5] = -0.66;  HOFF[6] = 0.66;  HOFF[7] = -1;  HOFF[8] = 1;

bv_alloc(FX_MEM);
bd_alloc(BV_END);
CH_N = ceil(0.03 * srate) + 4;  CH_L = BD_END;  CH_R = CH_L + CH_N;  memset(CH_L, 0, 2 * CH_N);
EN_N = ceil(0.03 * srate) + 4;  EN_B = CH_R + CH_N;  memset(EN_B, 0, EN_N);
en_w = 0;  ens_sc = 1;  ens_ss = 0;  ens_fc = 1;  ens_fs = 0;
str_rs = 90217;  str_pm = 1;  en_on = 0;  mdl_cur = str_mdl;  mdl_g = 1;  mdl_gs = 0;  spw_ph = 0;
sy_s = 1;  st_s = 0;  ea_s = ens_amt;  r16_s = 0;  r8_s = 0;  r4_s = 0;  tn_s = 0.5;  sv_v = 0;  sv_t = 0;  sv_tm = 0;
ch_w = 0;  ch_c = 1;  ch_s = 0;
fx_qt = 0.0000001;  sp_qn = ceil(1.5 * srate);  dl_qn = DL_N + 64;  ch_qn = CH_N + 64;  sp_q = sp_qn;  dl_q = dl_qn;  ch_q = ch_qn;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );
pwr_init();  pwr_hum_db = -83;  pwr_sag = 0.12;  pwr_wu_loss = 0.4;  pwr_wu_drv = 0.5;  pwr_wu_lp = 10000;  pwr_wu_wob = 0.1;  pwr_bloom = 0;
ui_thm = 5;  ui_hw = 1;

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);
function env_coef(ms) ( exp(-6.9 * CR / max(1, ms * 0.001 * srate)); );
function s_rnd() ( str_rs = (str_rs * 16807) % 2147483647;  str_rs / 2147483647; );

function ds_side(v) ( ds_hard ? min(v, 1) : ( v < 1.5 ? v - 0.148148148 * v * v * v : 1 ); );
function ds_side_int(v) ( ds_hard ? ( v <= 1 ? 0.5 * v * v : v - 0.5 ) : ( v < 1.5 ? 0.5 * v * v - v * v * v * v / 27 : v - 0.5625 ); );
function ds_crv(t) local(y) ( y = t >= 0 ? ds_lp * ds_side(t / ds_lp) : -ds_ln * ds_side(-t / ds_ln);  y + ds_rb * (abs(y) - y); );
function ds_int(t) local(f) (
  f = t >= 0 ? ds_lp * ds_lp * ds_side_int(t / ds_lp) : ds_ln * ds_ln * ds_side_int(-t / ds_ln);
  t >= 0 ? f : f * (1 - 2 * ds_rb);
);
function ds_run(s, x) local(u, d, fu, y) (
  u = x * ds_g + ds_bias;
  d = u - s[0];  fu = ds_int(u);
  y = abs(d) > 0.00001 ? (fu - s[1]) / d : ds_crv(0.5 * (u + s[0]));
  s[0] = u;  s[1] = fu;
  y -= ds_rest;
  ds_dc ? ( s[3] = y - s[2] + 0.995 * s[3];  s[2] = y;  y = s[3]; );
  y * ds_post;
);

function lad(s, x) local(u, v, y1, y2, y3, y4) (
  y4 = (lG4 * x + lB * (lG3 * s[0] + lG2 * s[1] + lG * s[2] + s[3])) * linv;
  u = ts(x - kres * y4);
  v = (u - s[0]) * lG;   y1 = v + s[0];  s[0] = y1 + v;
  v = (y1 - s[1]) * lG;  y2 = v + s[1];  s[1] = y2 + v;
  v = (y2 - s[2]) * lG;  y3 = v + s[2];  s[2] = y3 + v;
  v = (y3 - s[3]) * lG;  y4 = v + s[3];  s[3] = y4 + v;
  lc0 * u + lc1 * y1 + lc2 * y2 + lc3 * y3 + lc4 * y4;
);
function svf(s, v0) local(v1, v2, v3) (
  v3 = v0 - s[1];
  v1 = sA1 * s[0] + sA2 * v3;  v2 = s[1] + sA2 * s[0] + sA3 * v3;
  s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
  sm_l * v2 + sm_b * v1 + sm_h * (v0 - k2 * v1 - v2);
);

function v_freq(b) local(f, inc, p, u) (
  f = 440 * 2 ^ ((b[F_NOTE] - 69 + bend + lfo_v * vib_c * 0.01 + b[F_NDT] + b[F_DV] * 0.2 * dm_a) / 12);
  inc = f / srate;  b[F_INC] = inc;
  p = U_MEM + (b - VOX) / VS * 20;  u = 0;
  loop(nst, p[1] = min(inc * UT[u], 0.45);  p += 2;  u += 1; );
  b[F_I2] = min(inc * o2_rat, 0.45);  b[F_IS] = inc * 0.5;
  b[F_SI] = 440 * 2 ^ ((b[F_NOTE] - 69 + bend + lfo_v * vib_c * 0.01) / 12) * str_pm * 0.5 / srate;
  mdl_cur == 1 ? (
    u = b[F_SVT];  f = 14 * max(0, min(1, (u - 0.25) / 0.6)) * sin(2 * $pi * (5.2 * u + (b - VOX) / VS * 0.37));
    b[F_SI] *= 2 ^ (f / 1200);
  ) : mdl_cur == 2 ? b[F_SPW] = 0.5 + 0.36 * sin(2 * $pi * (spw_ph + (b - VOX) / VS * 0.27));
  b[F_PW] = max(0.03, min(0.97, pw_base + lfo_v * pwm * 0.45 + b[F_WV] * 0.08 * dm_a));
);
function v_start(b, note, vel) local(p, u) (
  b[F_ON] = 1;  b[F_NOTE] = note;  b[F_VEL] = vel;  b[F_GATE] = 1;  b[F_SUS] = 0;
  age_n += 1;  b[F_AGE] = age_n;
  b[F_AST] = 1;  b[F_FST] = 1;  b[F_SST] = 1;
  b[F_SVT] = 0;  b[F_SPW] = 0.5;
  b[F_GAIN] = 1 - vsens + vsens * vel / 127;
  b[F_FVEL] = 1 - 0.5 * vsens + 0.5 * vsens * vel / 127;
  b[F_AV] < 0.05 ? ( b[F_FIN] = 0;  nw_start(b + F_NW); );
  b[F_FADE] = 1;  b[F_STEAL] = 0;  b[F_AS] = 0;  b[F_GS] = 0;  b[F_A1S] = 0;  b[F_A2S] = 0;  b[F_A3S] = 0;
  !b[F_AV] ? (
    memset(b + F_LL, 0, 12);  memset(b + F_DL, 0, 8);
    b[F_AEN] = 0;  b[F_FEN] = 0;  b[F_P2] = 0;  b[F_PS] = 0;  b[F_NEW] = 1;
    b[F_DV] = rand(2) - 1;  b[F_DT] = rand(2) - 1;  b[F_DTM] = rand(2);
    b[F_WV] = rand(2) - 1;  b[F_WT] = rand(2) - 1;  b[F_WTM] = rand(2);
    p = U_MEM + (b - VOX) / VS * 20;  u = 0;
    loop(9, p[0] = (hyper && u > 0) ? rand(1) : 0;  p += 2;  u += 1; );
  );
  b[F_SV] < 0.00001 && b[F_SEN] < 0.00001 ? ( b[F_SEN] = 0;  b[F_SV] = 0;  b[F_SS] = 0;  b[F_SP] = s_rnd(); );
  b[F_NDT] = (rand(2) - 1) * 0.06 * dm_a;
  v_freq(b);
);
function v_alloc(note, vel) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(max(1, npoly),
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? ( str_on ? max(b[F_AEN], b[F_SEN]) : b[F_AEN] ) : 2 + b[F_AGE];
    b[F_ON] && b[F_NOTE] == note && !b[F_STEAL] ? q = -2;
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  b = VOX + best * VS;
  (b[F_ON] && (b[F_AV] > 0.0005 || (str_on && b[F_SV] > 0.0005)) && b[F_NOTE] != note) ? (
    b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel;
  ) : v_start(b, note, vel);
);
function v_release(note) local(v, b) (
  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_NOTE] == note ? (
      sustain ? b[F_SUS] = 1;
      b[F_GATE] = 0;  b[F_AST] = 4;  b[F_FST] = 4;  b[F_SST] = 4;
    );
    b[F_STEAL] && b[F_PEND] == note ? b[F_PEND] = -1;
    v += 1;
  );
);
function v_pedal_up() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_SUS] = 0;  v += 1; );
);
function v_all_off() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_ON] ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_AST] = 4;  b[F_FST] = 4;  b[F_SST] = 4; );  v += 1; );
);
function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? v_alloc(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? v_release(d1) :
  st == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 1 ? modw = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);

function env_tick(lv, stg, a_inc, d_c, s_lv, r_c) (
  stg == 1 ? ( lv += a_inc;  lv >= 1 ? ( lv = 1;  stg = 2; ); ) :
  stg == 2 ? ( lv = s_lv + (lv - s_lv) * d_c; ) :
  stg == 4 ? ( lv *= r_c; );
  env_out_stg = stg;
  lv;
);

function v_tick(b) local(fc, g, t, a) (
  b[F_SUS] && !b[F_GATE] && b[F_AST] == 4 ? ( b[F_AST] = 2;  b[F_FST] = 2;  b[F_SST] = 2; );
  !b[F_SUS] && !b[F_GATE] && b[F_AST] != 4 ? ( b[F_AST] = 4;  b[F_FST] = 4;  b[F_SST] = 4; );
  b[F_AEN] = env_tick(b[F_AEN], b[F_AST], a_ainc, a_dc, a_sl, a_rc);  b[F_AST] = env_out_stg;
  b[F_FEN] = env_tick(b[F_FEN], b[F_FST], f_ainc, f_dc, f_sl, f_rc);  b[F_FST] = env_out_stg;
  b[F_SEN] = env_tick(b[F_SEN], b[F_SST], s_ainc, 1, 1, s_rc);  b[F_SST] = env_out_stg;
  b[F_SS] = (b[F_SEN] - b[F_SV]) / CR;
  b[F_SVT] += CR / srate;
  b[F_DTM] -= CR / srate * dm_s;  b[F_DTM] <= 0 ? ( b[F_DT] = rand(2) - 1;  b[F_DTM] = 1.5 + rand(1) * 2.5; );
  b[F_DV] += (b[F_DT] - b[F_DV]) * dr_c;
  b[F_WTM] -= CR / srate * dm_s;  b[F_WTM] <= 0 ? ( b[F_WT] = rand(2) - 1;  b[F_WTM] = 1.5 + rand(1) * 2.5; );
  b[F_WV] += (b[F_WT] - b[F_WV]) * dr_c;
  v_freq(b);
  fc = 2 ^ (lcs + fkey * (b[F_NOTE] - 60) / 12 + b[F_FEN] * fl_ev * 6 * b[F_FVEL] + lfo_v * lfo_cut);
  fc_disp = fc;
  t = max(20, min(fc, 0.45 * srate));  g = tan($pi * t / srate);  t = g / (1 + g);
  b[F_NEW] ? ( b[F_G] = t;  b[F_GS] = 0; ) : b[F_GS] = (t - b[F_G]) / CR;
  f2_on ? (
    t = max(20, min(fc * f2_mul, 0.45 * srate));  g = tan($pi * t / srate);  t = 1 / (1 + g * (g + k2));
    b[F_NEW] ? ( b[F_A1] = t;  b[F_A2] = g * t;  b[F_A3] = g * g * t;  b[F_A1S] = b[F_A2S] = b[F_A3S] = 0; ) : (
      b[F_A1S] = (t - b[F_A1]) / CR;  b[F_A2S] = (g * t - b[F_A2]) / CR;  b[F_A3S] = (g * g * t - b[F_A3]) / CR; );
  );
  b[F_NEW] = 0;
  a = b[F_AEN] * b[F_GAIN];
  b[F_AS] = (a - b[F_AV]) / CR;
  b[F_AST] == 4 && b[F_AEN] < 0.0001 && b[F_AV] < 0.0001 && !b[F_STEAL] &&
  (!str_on || (b[F_SEN] < 0.0001 && b[F_SV] < 0.0001)) ? (
    b[F_ON] = 0;  b[F_AEN] = 0;  b[F_FEN] = 0;  b[F_AV] = 0;  b[F_AS] = 0;  b[F_SEN] = 0;  b[F_SV] = 0;  b[F_SS] = 0;
  );
);

function v_run(b) local(p, u, ph, d, s, q, ol, or_, mono, xl, xr, yl, yr, w) (
 syn_live ? (
  p = U_MEM + (b - VOX) / VS * 20;  ol = or_ = 0;  u = 0;
  hyper ? (
    loop(nst,
      d = p[1];  ph = p[0] + d;  ph >= 1 ? ph -= 1;  p[0] = ph;
      s = saw_bl(ph, d);
      ol += s * UT[10 + u];  or_ += s * UT[20 + u];
      p += 2;  u += 1;
    );
  ) : (
    loop(nst,
      d = p[1];  ph = p[0] + d;  ph >= 1 ? ph -= 1;  p[0] = ph;
      s = saw_bl(ph, d);
      pm > 0 ? ( q = ph + b[F_PW];  q >= 1 ? q -= 1;  s -= pm * saw_bl(q, d); );
      ol += s * UT[10 + u];  or_ += s * UT[20 + u];
      p += 2;  u += 1;
    );
  );
  mono = 0;
  o2_g > 0 ? (
    d = b[F_I2];  ph = b[F_P2] + d;  ph >= 1 ? ph -= 1;  b[F_P2] = ph;
    o2wave == 0 ? s = saw_bl(ph, d) :
    o2wave == 1 ? ( q = ph + b[F_PW];  q >= 1 ? q -= 1;  s = saw_bl(ph, d) - saw_bl(q, d); ) :
    o2wave == 2 ? s = 1 - 4 * abs(ph - 0.5) : s = sin(2 * $pi * ph);
    mono = s * o2_g;
  );
  sublvl > 0 ? (
    d = b[F_IS];  ph = b[F_PS] + d;  ph >= 1 ? ph -= 1;  b[F_PS] = ph;
    q = ph + 0.5;  q >= 1 ? q -= 1;
    mono += (saw_bl(ph, d) - saw_bl(q, d)) * 0.5 * sublvl;
  );
  noislvl > 0 ? mono += (rand(2) - 1) * noislvl;
  xl = ol * o1_g + mono;  xr = or_ * o1_g + mono;
  b[F_G] += b[F_GS];  lG = b[F_G];  lB = 1 - lG;  lG2 = lG * lG;  lG3 = lG2 * lG;  lG4 = lG2 * lG2;  linv = 1 / (1 + kres * lG4);
  f2_on ? (
    b[F_A1] += b[F_A1S];  b[F_A2] += b[F_A2S];  b[F_A3] += b[F_A3S];
    sA1 = b[F_A1];  sA2 = b[F_A2];  sA3 = b[F_A3];
  );
  ds_pre ? xl = ds_run(b + F_DL, xl);
  yl = lad(b + F_LL, xl * f_in) * f_out;
  f2_on ? ( yl = froute ? 0.5 * (yl + svf(b + F_SVL, xl)) : svf(b + F_SVL, yl); );
  ds_pst ? yl = ds_run(b + F_DL, yl);
  stereo ? (
    ds_pre ? xr = ds_run(b + F_DR, xr);
    yr = lad(b + F_LR, xr * f_in) * f_out;
    f2_on ? ( yr = froute ? 0.5 * (yr + svf(b + F_SVR, xr)) : svf(b + F_SVR, yr); );
    ds_pst ? yr = ds_run(b + F_DR, yr);
  ) : yr = yl;
  b[F_AV] += b[F_AS];
  w = b[F_AV] * b[F_FADE];
  b[F_FIN] < 1 ? ( w *= 0.5 - 0.5 * cos($pi * b[F_FIN]);  b[F_FIN] = min(b[F_FIN] + fin_step, 1); );
  nw_run2(b + F_NW, yl * w, yr * w);  mixL += nw_l;  mixR += nw_r;
 ) : b[F_AV] += b[F_AS];
  b[F_SV] += b[F_SS];
  str_live ? (
    d = b[F_SI];  ph = b[F_SP] + d;  ph >= 1 ? ph -= 1;  b[F_SP] = ph;
    s = 0;
    mdl_cur == 2 ? (
      w = b[F_SPW];
      r16_s > 0.00001 ? ( q = ph + w;  q -= floor(q);  s += r16_s * (saw_bl(ph, d) - saw_bl(q, d)); );
      r8_s > 0.00001 ? ( u = 2 * ph;  u -= floor(u);  q = u + w;  q -= floor(q);  xl = min(2 * d, 0.45);
                         s += r8_s * (saw_bl(u, xl) - saw_bl(q, xl)); );
      r4_s > 0.00001 ? ( u = 4 * ph;  u -= floor(u);  q = u + w;  q -= floor(q);  xl = min(4 * d, 0.45);
                         s += r4_s * (saw_bl(u, xl) - saw_bl(q, xl)); );
    ) : (
      r16_s > 0.00001 ? s += r16_s * saw_bl(ph, d);
      r8_s > 0.00001 ? ( q = 2 * ph;  q -= floor(q);  s += r8_s * saw_bl(q, min(2 * d, 0.45)); );
      r4_s > 0.00001 ? ( q = 4 * ph;  q -= floor(q);  s += r4_s * saw_bl(q, min(4 * d, 0.45)); );
    );
    strM += s * b[F_SV] * b[F_FADE];
  );
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? (
      b[F_FADE] = 0;  b[F_STEAL] = 0;
      b[F_PEND] >= 0 ? ( b[F_AV] = 0;  b[F_AEN] = 0;  b[F_FEN] = 0;  v_start(b, b[F_PEND], b[F_PVEL]); )
                     : ( b[F_ON] = 0;  b[F_AV] = 0;  b[F_AEN] = 0; );
    );
  );
);

bend = 0;  modw = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  lfo_ph = 0;  lfo_v = 0;  lfo_rate = lfo_hz;
lcs = fl_c1 = log(cutoff) / log(2);  kres = fres * 4.1;  fl_ev = fenvamt;  drv_s = 10 ^ (fdrive / 20);

function fx_block() local(k, sz, ms, t) (
  t = dl_sync >= 0.5 ? 60 / max(tempo, 20) * bd_beats(floor(dl_div + 0.5)) : dl_ms * 0.001;
  dl_t = min(t * srate, 3 * srate);
  dl_dc = 1 - exp(-2 * $pi * min(5000, 0.45 * srate) / srate);
  dl_hc = 1 - exp(-2 * $pi * 120 / srate);
  sl_c = 1 - exp(-1 / (0.15 * srate));
  sz = 0.3 + 0.7 * sp_size;
  k = 0;
  loop(8,
    ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
    ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
    k += 1;
  );
  bv_t60 = sp_decay;  bv_rtlo = 1.25;  bv_rthi = 1 - 0.82 * sp_damp;
  k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
  bv_xover();
  sp_pre = (0.008 + 0.03 * sp_size) * srate;
  k = 0;
  loop(8,
    RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
    ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
    k += 1;
  );
  dl_mix > 0.0005 && !dl_live ? ( memset(BD_L, 0, 2 * DL_N);  dlL.init = 0;  dlR.init = 0;  dl_fl = dl_fr = dl_hl = dl_hr = 0; );
  sp_mix > 0.0005 && !sp_live ? bv_alloc(FX_MEM);
  dl_live = dl_mix > 0.0005;  sp_live = sp_mix > 0.0005;
);

function update_params() local(j, d, n, f, ss, mc, wd, pn, nrm, w, t) (
  a_ainc = CR / max(1, ae_a * 0.001 * srate);  a_dc = env_coef(ae_d);  a_sl = ae_s / 100;  a_rc = env_coef(ae_r);
  f_ainc = CR / max(1, fe_a * 0.001 * srate);  f_dc = env_coef(fe_d);  f_sl = fe_s / 100;  f_rc = env_coef(fe_r);
  fade_step = 1 / (0.003 * srate);  fin_step = 1 / (0.002 * srate);
  s_ainc = CR / max(1, str_att * 0.001 * srate);  s_rc = env_coef(str_rel);
  str_on = str_bal > 0.0005;
  syn_gt = min(1, 2 * (1 - str_bal));  str_gt = min(1, 2 * str_bal);
  r16_t = str_16 >= 0.5 ? 0.8 : 0;  r8_t = str_8 >= 0.5 ? 1 : 0;  r4_t = str_4 >= 0.5 ? 0.7 : 0;
  t = 1 / max(1, sqrt(r16_t * r16_t + r8_t * r8_t + r4_t * r4_t));  r16_t *= t;  r8_t *= t;  r4_t *= t;
  ens_mul = 2 ^ ((ens_spd - 0.5) * 2);
  str_hc = 1 - exp(-2 * $pi * 110 / srate);
  t = tan($pi * 330 / srate);   bf_k1 = 1 / 1.4;  bf_a1 = 1 / (1 + t * (t + bf_k1));  bf_b1 = t * bf_a1;  bf_c1 = t * bf_b1;
  t = tan($pi * 1100 / srate);  bf_k2 = 1 / 2;    bf_a2 = 1 / (1 + t * (t + bf_k2));  bf_b2 = t * bf_a2;  bf_c2 = t * bf_b2;
  t = tan($pi * min(3300, 0.45 * srate) / srate);  bf_k3 = 1 / 2.5;  bf_a3 = 1 / (1 + t * (t + bf_k3));  bf_b3 = t * bf_a3;  bf_c3 = t * bf_b3;
  drift_macro(drift);
  dr_c = 1 - exp(-CR * dm_s / (1.2 * srate));
  dc_r = 1 - 2 * $pi * 5 / srate;
  out_gt = 10 ^ (vol / 20) * 0.16;
  !og_on ? ( out_g = out_gt; og_on = 1; );
  hyper = osc_mode >= 0.5;
  memset(UT, 0, 30);
  hyper ? (
    pm = 0;  pw_base = 0.5;
    d = 1 + 8 * dens;  n = floor(d);  f = d - n;  n >= 9 ? ( n = 9;  f = 0; );
    nst = n + (f > 0.001 ? 1 : 0);
    mc = 90 * spread ^ 1.5;
    wd = min(1, spread * 1.5);
    ss = 0;  j = 0;
    loop(9, w = j < n ? 1 : j == n ? f : 0;  ss += w * w;  j += 1; );
    nrm = 1 / sqrt(max(1, ss));
    j = 0;
    loop(9,
      w = j < n ? 1 : j == n ? f : 0;
      UT[j] = 2 ^ (HOFF[j] * mc / 1200);
      pn = max(-1, min(1, HOFF[j] * 1.2)) * wd;
      UT[10 + j] = w * nrm * min(1, 1 - pn);  UT[20 + j] = w * nrm * min(1, 1 + pn);
      j += 1;
    );
  ) : (
    pm = min(1, dens * 2);
    pw_base = dens < 0.5 ? 0.5 : 0.5 - (dens - 0.5) * 0.9;
    spread > 0.001 ? (
      nst = 2;  mc = 25 * spread * spread;
      UT[0] = 2 ^ (-mc / 1200);  UT[1] = 2 ^ (mc / 1200);
      UT[10] = 0.5;  UT[20] = 0.5 * (1 - spread);  UT[11] = 0.5 * (1 - spread);  UT[21] = 0.5;
    ) : ( nst = 1;  UT[0] = 1;  UT[10] = 1;  UT[20] = 1; );
  );
  stereo = nst > 1 && spread > 0.001;
  o2_rat = 2 ^ ((o2semi + o2fine * 0.01) / 12);
  o1_g = min(1, 2 * (1 - obal));  o2_g = min(1, 2 * obal);
  f1mode < 0.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 0;  lc3 = 0;  lc4 = 1; ) :
  f1mode < 1.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 1;  lc3 = 0;  lc4 = 0; ) :
  f1mode < 2.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 4;  lc3 = -8; lc4 = 4; ) :
                 ( lc0 = 1;  lc1 = -4; lc2 = 6;  lc3 = -4; lc4 = 1; );
  lcomp = 0.5;
  f2_on = f2mode >= 0.5;
  f2mode < 1.5 ? ( sm_l = 1;  sm_b = 0;  sm_h = 0; ) : f2mode < 2.5 ? ( sm_l = 0;  sm_b = 0;  sm_h = 1; ) :
  f2mode < 3.5 ? ( sm_l = 0;  sm_b = 1;  sm_h = 0; ) : ( sm_l = 1;  sm_b = 0;  sm_h = 1; );
  k2 = 2 - 1.85 * f2res;  f2_mul = 2 ^ f2off;
  ds_hard = 0;  ds_lp = 1;  ds_ln = 1;  ds_rb = 0;  ds_bias = 0;  ds_dc = 0;
  ds_type == 2 ? ( ds_ln = 0.72;  ds_bias = 0.25;  ds_dc = 1; ) :
  ds_type == 3 ? ( ds_ln = 0.4;  ds_dc = 1; ) :
  ds_type == 4 ? ( ds_rb = 0.6;  ds_dc = 1; ) :
  ds_type == 5 ? ds_hard = 1;
  ds_g = 10 ^ (ds_drv / 20);
  ds_rest = ds_crv(ds_bias);
  ds_post = 0.5 / max(0.05, abs(ds_crv(0.5 * ds_g + ds_bias) - ds_rest));
  ds_pre = ds_type >= 0.5 && ds_pos < 0.5;  ds_pst = ds_type >= 0.5 && ds_pos >= 0.5;
  t = 2 * $pi * 0.35 / srate;  ch_ca = cos(t);  ch_sa = sin(t);
  ch_base = 0.007 * srate;  ch_dep = 0.0025 * srate;
  eq_lc = 1 - exp(-2 * $pi * 200 / srate);  eq_hc = 1 - exp(-2 * $pi * 4500 / srate);
  eq_lg = 10 ^ (eq_lo / 20) - 1;  eq_hg = 0;
);

function sl_auto(idx) (
  idx == 33 ? slider_automate(lfo_hz) : idx == 34 ? slider_automate(lfo_cut) : idx == 35 ? slider_automate(lfo_pit) :
  idx == 36 ? slider_automate(ch_mix) : idx == 37 ? slider_automate(dl_sync) : idx == 38 ? slider_automate(dl_ms) :
  idx == 39 ? slider_automate(dl_div) : idx == 40 ? slider_automate(dl_fb) : idx == 41 ? slider_automate(dl_mix) :
  idx == 42 ? slider_automate(dl_pp) : idx == 43 ? slider_automate(sp_size) : idx == 44 ? slider_automate(sp_decay) :
  idx == 45 ? slider_automate(sp_damp) : idx == 46 ? slider_automate(sp_mix) : idx == 47 ? slider_automate(eq_lo) :
  idx == 48 ? slider_automate(slider48) : idx == 49 ? slider_automate(vol) : idx == 50 ? slider_automate(npoly) :
  idx == 51 ? slider_automate(drift) : idx == 52 ? slider_automate(lfo_sync) : idx == 53 ? slider_automate(lfo_div) :
  idx == 54 ? slider_automate(str_bal) : idx == 55 ? slider_automate(str_16) : idx == 56 ? slider_automate(str_8) :
  idx == 57 ? slider_automate(str_4) : idx == 58 ? slider_automate(str_att) : idx == 59 ? slider_automate(str_rel) :
  idx == 60 ? slider_automate(str_tone) : idx == 61 ? slider_automate(ens_amt) : idx == 62 ? slider_automate(ens_spd) :
  idx == 63 ? slider_automate(str_mdl);
);
function sl_auto_au(idx) (
  idx == 33 ? slider_automate(lfo_hz) : idx == 34 ? slider_automate(lfo_cut) : idx == 35 ? slider_automate(lfo_pit) :
  idx == 36 ? slider_automate(ch_mix) : idx == 37 ? slider_automate(dl_sync) : idx == 38 ? slider_automate(dl_ms) :
  idx == 39 ? slider_automate(dl_div) : idx == 40 ? slider_automate(dl_fb) : idx == 41 ? slider_automate(dl_mix) :
  idx == 42 ? slider_automate(dl_pp) : idx == 43 ? slider_automate(sp_size) : idx == 44 ? slider_automate(sp_decay) :
  idx == 45 ? slider_automate(sp_damp) : idx == 46 ? slider_automate(sp_mix) : idx == 47 ? slider_automate(eq_lo) :
  idx == 48 ? slider_automate(slider48) : idx == 49 ? slider_automate(vol) : idx == 50 ? slider_automate(npoly) :
  idx == 51 ? slider_automate(drift) : idx == 52 ? slider_automate(lfo_sync) : idx == 53 ? slider_automate(lfo_div) :
  idx == 54 ? slider_automate(str_bal) : idx == 55 ? slider_automate(str_16) : idx == 56 ? slider_automate(str_8) :
  idx == 57 ? slider_automate(str_4) : idx == 58 ? slider_automate(str_att) : idx == 59 ? slider_automate(str_rel) :
  idx == 60 ? slider_automate(str_tone) : idx == 61 ? slider_automate(ens_amt) : idx == 62 ? slider_automate(ens_spd) :
  idx == 63 ? slider_automate(str_mdl);
);
function param_touched(idx) (
  idx <= 32 ? slider_automate(2 ^ (idx - 1)) : sl_auto(idx);
  gui_dirty = 1;
);
function param_touched_au(idx) (
  idx <= 32 ? slider_automate(2 ^ (idx - 1)) : sl_auto_au(idx);
  gui_dirty = 1;
);
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 1); pv(2, 0.6); pv(3, 0.45); pv(4, 0.2); pv(5, 0); pv(6, -12); pv(7, 7); pv(8, 0.2); pv(9, 0.2); pv(10, 0);
  pv(11, 0); pv(12, 1800); pv(13, 0.35); pv(14, 0); pv(15, 0.45); pv(16, 0.5); pv(17, 0); pv(18, 0); pv(19, 0.2); pv(20, 0);
  pv(21, 2); pv(22, 350); pv(23, 20); pv(24, 400); pv(25, 2); pv(26, 600); pv(27, 85); pv(28, 350); pv(29, 0.5);
  pv(30, 0); pv(31, 12); pv(32, 1); pv(33, 0.8); pv(34, 0); pv(35, 0); pv(52, 0); pv(53, 5); pv(36, 0.25);
  pv(37, 1); pv(38, 350); pv(39, 4); pv(40, 0.4); pv(41, 0.2); pv(42, 1);
  pv(43, 0.6); pv(44, 2.8); pv(45, 0.45); pv(46, 0.2); pv(47, 0); pv(48, 0); pv(49, 0); pv(50, 8); pv(51, 50);
  pv(54, 0); pv(55, 0); pv(56, 1); pv(57, 1); pv(58, 450); pv(59, 1200); pv(60, 0.5); pv(61, 0.7); pv(62, 0.5); pv(63, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (
    pv(2, 0.75); pv(3, 0.55); pv(8, 0.1); pv(9, 0.15); pv(12, 3200); pv(13, 0.25); pv(15, 0.35);
    pv(21, 1); pv(22, 250); pv(23, 40); pv(24, 300); pv(25, 1); pv(26, 400); pv(27, 90); pv(28, 250);
    pv(30, 1); pv(31, 9); pv(33, 5.5); pv(35, 8); pv(36, 0.15); pv(39, 8); pv(40, 0.35); pv(41, 0.25);
    pv(44, 2.2); pv(45, 0.5); pv(46, 0.15); ) :
  p == 3 ? (
    pv(2, 1); pv(3, 0.7); pv(7, 12); pv(8, 0.3); pv(12, 1100); pv(13, 0.2); pv(15, 0.25); pv(16, 0.3);
    pv(21, 900); pv(22, 2500); pv(23, 40); pv(24, 2500); pv(25, 700); pv(26, 3000); pv(27, 80); pv(28, 2800);
    pv(33, 0.25); pv(34, 0.6); pv(36, 0.45); pv(40, 0.45); pv(41, 0.15); pv(43, 0.85); pv(44, 6.5); pv(45, 0.55); pv(46, 0.4); ) :
  p == 4 ? (
    pv(1, 0); pv(2, 0); pv(3, 0); pv(7, 0); pv(8, 0.35); pv(9, 0.5); pv(12, 220); pv(13, 0.55);
    pv(14, 12); pv(15, 0.55); pv(16, 0.6); pv(21, 1); pv(22, 220); pv(23, 10); pv(24, 120);
    pv(25, 1); pv(26, 500); pv(27, 85); pv(28, 80); pv(30, 2); pv(31, 6);
    pv(36, 0); pv(41, 0); pv(46, 0); pv(50, 1); ) :
  p == 5 ? (
    pv(1, 0); pv(2, 0.3); pv(3, 0.25); pv(5, 1); pv(6, 12); pv(8, 0.25); pv(12, 400); pv(13, 0.75); pv(14, 6);
    pv(15, 0.7); pv(16, 0.7); pv(21, 0.5); pv(22, 180); pv(23, 0); pv(24, 180);
    pv(25, 0.5); pv(26, 450); pv(27, 0); pv(28, 350); pv(36, 0.2); pv(39, 8); pv(40, 0.45); pv(41, 0.3);
    pv(44, 2); pv(45, 0.4); pv(46, 0.2); ) :
  p == 6 ? (
    pv(1, 0); pv(2, 0.75); pv(3, 0.4); pv(4, 0.6); pv(5, 1); pv(6, 0); pv(7, -9); pv(8, 0.3); pv(9, 0);
    pv(12, 2600); pv(13, 0.1); pv(15, 0.15); pv(21, 300); pv(22, 1500); pv(23, 60); pv(24, 900);
    pv(25, 250); pv(26, 1200); pv(27, 90); pv(28, 900); pv(33, 0.7); pv(36, 0.5); pv(41, 0.1);
    pv(44, 3.5); pv(45, 0.5); pv(46, 0.3); ) :
  p == 7 ? (
    pv(1, 0); pv(2, 0); pv(3, 0.2); pv(6, 0); pv(7, 6); pv(8, 0.5); pv(9, 0); pv(12, 700); pv(13, 0.2);
    pv(15, 0.5); pv(21, 60); pv(22, 600); pv(23, 45); pv(24, 300); pv(25, 20); pv(26, 500); pv(27, 85); pv(28, 250);
    pv(30, 1); pv(31, 6); pv(33, 5); pv(35, 4); pv(36, 0.2); pv(41, 0); pv(43, 0.4); pv(44, 1.8); pv(45, 0.5); pv(46, 0.15); ) :
  p == 8 ? (
    pv(2, 0.9); pv(3, 1); pv(5, 1); pv(6, -12); pv(8, 0.35); pv(9, 0.4); pv(11, 1); pv(12, 900); pv(13, 0.3);
    pv(15, 0.4); pv(21, 1); pv(22, 700); pv(23, 30); pv(24, 600); pv(25, 1); pv(26, 800); pv(27, 90); pv(28, 400);
    pv(30, 2); pv(31, 10); pv(33, 6); pv(35, 35); pv(36, 0.6); pv(46, 0.2); ) :
  p == 9 ? (
