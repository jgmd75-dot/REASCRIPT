    pv(54, 0.55); pv(55, 1); pv(56, 1); pv(57, 0); pv(58, 900); pv(59, 3000); pv(60, 0.5); pv(61, 0.6); pv(62, 0.3); pv(63, 2); pv(49, -2); ) : 0;
  i = 1;  loop(63, param_touched_au(i);  i += 1; );
);

function prs_sl() (
update_params();
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(64, i != 64 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(20, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 20 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;
function gap_clear() (
  memset(VOX, 0, NV * VS);  memset(U_MEM, 0, NV * 20);
  memset(CH_L, 0, 2 * CH_N);  memset(EN_B, 0, EN_N);  memset(BF_S, 0, 6);
  memset(BD_L, 0, 2 * DL_N);  dlL.init = 0;  dlR.init = 0;  dl_fl = dl_fr = dl_hl = dl_hr = 0;
  bv_alloc(FX_MEM);
  st_z1 = st_z2 = st_h = 0;  dc_xl = dc_xr = dc_pl = dc_pr = 0;  dc_ol = dc_or = dc_qol = dc_qor = 0;
  eq_l1 = eq_h1 = eq_r1 = eq_g1 = 0;  mq_n = 0;  mq_i = 0;  sustain = 0;
);
function panic_all() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_ON] ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_STEAL] = 1;  b[F_PEND] = -1; );  v += 1; );
  sustain = 0;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();

@block
prs_chk();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? gap_clear();
g_tp = g_now;  g_gpp = play_position;  g_gpd = samplesblock / srate;
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
  (m_st & 0xF0) == 0x90 && m_d2 > 0 ? mi_led_d = 1;
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? v_all_off();  tp_was = tp_now;
prm_dirty ? ( prm_dirty = 0;  update_params(); );
panic_d ? ( panic_d = 0;  panic_all(); );
fx_block();
kb = min(1, samplesblock / (0.015 * srate));
fl_k = 1 - exp(-CR / (0.015 * srate));
drv_s += (10 ^ (fdrive / 20) - drv_s) * kb;
f_in = 0.35 * drv_s * (1 + lcomp * kres);
f_out = 1 / (0.35 * sqrt(drv_s));
vib_c = lfo_pit + modw * 50;
sm_k = 1 - exp(-1 / (0.015 * srate));
syn_live = syn_gt > 0 || sy_s > 0.00001;
str_live = str_gt > 0 || st_s > 0.00001;
str_live ? (
  tn_s += (str_tone - tn_s) * min(1, samplesblock / (0.03 * srate));
  st_f = min(1100 * 10 ^ tn_s, 0.45 * srate);  st_g = tan($pi * st_f / srate);
  st_k = 1.3;  st_a1 = 1 / (1 + st_g * (st_g + st_k));  st_a2 = st_g * st_a1;  st_a3 = st_g * st_a2;
  sv_tm -= samplesblock / srate * dm_s;  sv_tm <= 0 ? ( sv_t = s_rnd() * 2 - 1;  sv_tm = 2 + s_rnd() * 3; );
  sv_v += (sv_t - sv_v) * (1 - exp(-samplesblock * dm_s / (1.5 * srate)));
  str_pm = 2 ^ (sv_v * 0.04 * dm_a / 12);
  en_clk = 1 + sv_v * 0.05 * dm_a;
  t = 2 * $pi * 0.6 * ens_mul / en_clk / srate;  ens_cs = cos(t);  ens_sn = sin(t);
  t = 2 * $pi * 6.1 * ens_mul / en_clk / srate;  ens_cf = cos(t);  ens_sf = sin(t);
  en_base = 0.0062 * srate * en_clk;  en_sd = 0.0021 * srate * en_clk;  en_fd = 0.00028 * srate * en_clk;
  !en_on ? ( memset(EN_B, 0, EN_N);  st_z1 = st_z2 = st_h = 0; );
  en_on = 1;
) : ( en_on = 0;  str_pm = 1; );
spw_ph += samplesblock / srate * 0.3 * ens_mul;  spw_ph -= floor(spw_ph);
ens_disp = atan2(ens_ss, ens_sc);
ost_setup(slider48 / 100, 0.3, 120, 6000, -0.3, 1);
pwr_block(1);
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );
n_on = 0;  vb = VOX;  loop(NV, n_on += vb[F_ON] > 0;  vb += VS; );
voices_disp = n_on;  n_on == 0 ? fc_disp = 0;
lfo_bpc = lfo_div < 0.5 ? 16 : lfo_div < 1.5 ? 8 : lfo_div < 2.5 ? 4 : lfo_div < 3.5 ? 2 : lfo_div < 4.5 ? 3 : lfo_div < 5.5 ? 1 :
          lfo_div < 6.5 ? 1.5 : lfo_div < 7.5 ? 2 / 3 : lfo_div < 8.5 ? 0.5 : lfo_div < 9.5 ? 0.75 : lfo_div < 10.5 ? 1 / 3 :
          lfo_div < 11.5 ? 0.25 : lfo_div < 12.5 ? 1 / 6 : 0.125;
lfo_rate = lfo_sync >= 0.5 ? max(tempo, 20) / 60 / lfo_bpc : lfo_hz;
lfo_sync >= 0.5 && (play_state & 1) ? (
  lfo_d = beat_position / lfo_bpc;  lfo_d -= floor(lfo_d);  lfo_d -= lfo_ph;  lfo_d -= floor(lfo_d + 0.5);
  lfo_ph += lfo_d * 0.25;  lfo_ph -= floor(lfo_ph);
);
lfo_disp = lfo_ph;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  lfo_ph += lfo_rate * CR / srate;  lfo_ph -= floor(lfo_ph);
  lfo_v = sin(2 * $pi * lfo_ph);
  fl_c1 += (log(cutoff) / log(2) - fl_c1) * fl_k;  lcs += (fl_c1 - lcs) * fl_k;
  kres += (fres * 4.1 - kres) * fl_k;
  fl_ev += (fenvamt - fl_ev) * fl_k;
  vb = VOX;  loop(NV, vb[F_ON] ? v_tick(vb);  vb += VS; );
);
cr_n -= 1;

sy_s += (syn_gt - sy_s) * sm_k;  st_s += (str_gt - st_s) * sm_k;
r16_s += (r16_t - r16_s) * sm_k;  r8_s += (r8_t - r8_s) * sm_k;  r4_s += (r4_t - r4_s) * sm_k;
out_g += (out_gt - out_g) * sm_k;

mixL = 0;  mixR = 0;  strM = 0;  vb = VOX;
loop(NV, vb[F_ON] ? v_run(vb);  vb += VS; );

yl = mixL * sy_s * out_g;  yr = mixR * sy_s * out_g;
str_mdl != mdl_cur && mdl_gs >= 0 ? mdl_gs = -1 / (0.006 * srate);
mdl_gs != 0 ? (
  mdl_g += mdl_gs;
  mdl_g <= 0 ? ( mdl_g = 0;  mdl_cur = str_mdl;  bf_z = 0;  memset(BF_S, 0, 6);  mdl_gs = 1 / (0.010 * srate); ) :
  mdl_g >= 1 ? ( mdl_g = 1;  mdl_gs = 0; );
);
en_on ? (
  st_h += (strM - st_h) * str_hc;  st_x = strM - st_h;
  mdl_cur == 1 ? (
    bf_v3 = st_x - BF_S[1];  bf_v1 = bf_a1 * BF_S[0] + bf_b1 * bf_v3;  bf_v2 = BF_S[1] + bf_b1 * BF_S[0] + bf_c1 * bf_v3;
    BF_S[0] = 2 * bf_v1 - BF_S[0];  BF_S[1] = 2 * bf_v2 - BF_S[1];  bf_y = bf_v1 * 1.1;
    bf_v3 = st_x - BF_S[3];  bf_v1 = bf_a2 * BF_S[2] + bf_b2 * bf_v3;  bf_v2 = BF_S[3] + bf_b2 * BF_S[2] + bf_c2 * bf_v3;
    BF_S[2] = 2 * bf_v1 - BF_S[2];  BF_S[3] = 2 * bf_v2 - BF_S[3];  bf_y += bf_v1 * 0.8;
    bf_v3 = st_x - BF_S[5];  bf_v1 = bf_a3 * BF_S[4] + bf_b3 * bf_v3;  bf_v2 = BF_S[5] + bf_b3 * BF_S[4] + bf_c3 * bf_v3;
    BF_S[4] = 2 * bf_v1 - BF_S[4];  BF_S[5] = 2 * bf_v2 - BF_S[5];  bf_y += bf_v1 * 0.9;
    st_x = 0.35 * st_x + bf_y;
  );
  st_v3 = st_x - st_z2;  st_v1 = st_a1 * st_z1 + st_a2 * st_v3;  st_v2 = st_z2 + st_a2 * st_z1 + st_a3 * st_v3;
  st_z1 = 2 * st_v1 - st_z1;  st_z2 = 2 * st_v2 - st_z2;  st_x = st_v2;
  EN_B[en_w] = st_x;
  e_t = ens_sc * ens_cs - ens_ss * ens_sn;  ens_ss = ens_ss * ens_cs + ens_sc * ens_sn;  ens_sc = e_t;
  e_t = ens_fc * ens_cf - ens_fs * ens_sf;  ens_fs = ens_fs * ens_cf + ens_fc * ens_sf;  ens_fc = e_t;
  e_k = 0;  e_l = 0;  e_r = 0;
  loop(3,
    e_a = e_k == 0 ? 1 : -0.5;  e_b = e_k == 0 ? 0 : e_k == 1 ? 0.8660254 : -0.8660254;
    e_p = en_w - (en_base + en_sd * (ens_ss * e_a + ens_sc * e_b) + en_fd * (ens_fs * e_a + ens_fc * e_b));
    e_p < 0 ? e_p += EN_N;
    e_i = floor(e_p);  e_f = e_p - e_i;  e_j = e_i + 1;  e_j >= EN_N ? e_j = 0;
    e_v = EN_B[e_i] + (EN_B[e_j] - EN_B[e_i]) * e_f;
    e_k == 0 ? e_l += e_v : e_k == 1 ? ( e_l += 0.5 * e_v;  e_r += 0.5 * e_v; ) : e_r += e_v;
    e_k += 1;
  );
  en_w += 1;  en_w >= EN_N ? (
    en_w = 0;
    e_t = 1 / sqrt(ens_sc * ens_sc + ens_ss * ens_ss);  ens_sc *= e_t;  ens_ss *= e_t;
    e_t = 1 / sqrt(ens_fc * ens_fc + ens_fs * ens_fs);  ens_fc *= e_t;  ens_fs *= e_t;
  );
  e_g = st_s * out_g * 0.65 * (mdl_cur == 1 ? M_G1 : mdl_cur == 2 ? M_G2 : 1) * mdl_g * mdl_g * (3 - 2 * mdl_g);
  ea_s += (ens_amt - ea_s) * sm_k;
  yl += (st_x * (1 - ea_s) + e_l * 0.85 * ea_s) * e_g;
  yr += (st_x * (1 - ea_s) + e_r * 0.85 * ea_s) * e_g;
);
pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;
dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;

ch_mix > 0.0005 ? (
  CH_L[ch_w] = yl;  CH_R[ch_w] = yr;
  c_t = ch_c * ch_ca - ch_s * ch_sa;  ch_s = ch_s * ch_ca + ch_c * ch_sa;  ch_c = c_t;
  abs(yl) + abs(yr) > fx_qt ? ch_q = 0 : ch_q < ch_qn ? ch_q += 1;
  ch_q < ch_qn ? (
    c_p = ch_w - (ch_base + ch_dep * ch_s);  c_p < 0 ? c_p += CH_N;
    c_i = floor(c_p);  c_f = c_p - c_i;  c_j = c_i + 1;  c_j >= CH_N ? c_j = 0;
    c_l = CH_L[c_i] + (CH_L[c_j] - CH_L[c_i]) * c_f;
    c_p = ch_w - (ch_base + ch_dep * ch_c);  c_p < 0 ? c_p += CH_N;
    c_i = floor(c_p);  c_f = c_p - c_i;  c_j = c_i + 1;  c_j >= CH_N ? c_j = 0;
    c_r = CH_R[c_i] + (CH_R[c_j] - CH_R[c_i]) * c_f;
  ) : ( c_l = c_r = 0; );
  yl = yl * (1 - 0.35 * ch_mix) + c_l * 0.7 * ch_mix;
  yr = yr * (1 - 0.35 * ch_mix) + c_r * 0.7 * ch_mix;
  ch_w += 1;  ch_w >= CH_N ? ( ch_w = 0;  c_t = 1 / sqrt(ch_c * ch_c + ch_s * ch_s);  ch_c *= c_t;  ch_s *= c_t; );
);

dl_live ? (
  abs(yl) + abs(yr) > fx_qt ? dl_q = 0;
) : dl_q = 0;
dl_live && dl_q < dl_qn ? (
  u_dl = dlL.sl_run(BD_L, dl_t);  u_dr = dlR.sl_run(BD_R, dl_t);
  dl_hl += (u_dl - dl_hl) * dl_hc;  dl_hr += (u_dr - dl_hr) * dl_hc;
  dl_fl += (u_dl - dl_hl - dl_fl) * dl_dc;  dl_fr += (u_dr - dl_hr - dl_fr) * dl_dc;
  u_fl = ts(dl_fl * dl_fb * 1.25) * 0.8;  u_fr = ts(dl_fr * dl_fb * 1.25) * 0.8;
  dl_pp >= 0.5 ? bd_put((yl + yr) * 0.5 + u_fr + bv_dn, u_fl + bv_dn)
               : bd_put(yl + u_fl + bv_dn, yr + u_fr + bv_dn);
  yl += u_dl * dl_mix;  yr += u_dr * dl_mix;
  abs(u_dl) + abs(u_dr) > fx_qt ? dl_q = 0 : dl_q += 1;
);

sp_live ? (
  abs(yl) + abs(yr) > fx_qt ? sp_q = 0;
) : sp_q = 0;
sp_live && sp_q < sp_qn ? (
  bv_pre(yl, yr);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, sp_size);
  fdn_run(dif_l, dif_r);
  yl += fdn_l * 0.55 * sp_mix;  yr += fdn_r * 0.55 * sp_mix;
  abs(fdn_l) + abs(fdn_r) > fx_qt ? sp_q = 0 : sp_q += 1;
);

eq_l1 += (yl - eq_l1) * eq_lc;  eq_h1 += (yl - eq_h1) * eq_hc;
eq_r1 += (yr - eq_r1) * eq_lc;  eq_g1 += (yr - eq_g1) * eq_hc;
yl += eq_l1 * eq_lg + (yl - eq_h1) * eq_hg;
yr += eq_r1 * eq_lg + (yr - eq_g1) * eq_hg;

dc_ol = yl - dc_qol + dc_r * dc_ol;  dc_qol = yl;  yl = dc_ol;
dc_or = yr - dc_qor + dc_r * dc_or;  dc_qor = yr;  yr = dc_or;
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );

