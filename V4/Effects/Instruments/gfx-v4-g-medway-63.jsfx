desc:Medway 63 [combo organ] (GFX V4)
//tags: instrument organ combo transistor divider 60s vibrato v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-drift, gfx-v4-power, gfx-v4-output, gfx-v4-os, gfx-v4-sliders (.jsfx-inc) in the same folder.

import gfx-v4-drift.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-sliders.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider21:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:db16=4<0,8,1>-16' bass (drawbar)
slider2:db8f=8<0,8,1>-8' flute (drawbar)
slider3:db8p=0<0,8,1>-8' principal (drawbar)
slider4:db4f=6<0,8,1>-4' flute (drawbar)
slider5:db4s=0<0,8,1>-4' string (drawbar)
slider6:db2=0<0,8,1>-2' (drawbar)
slider7:dbmx=0<0,8,1>-IV mixture (drawbar)
slider8:vib_on=1<0,1,1{Off,On}>-Vibrato
slider9:vib_spd=6.5<0.01,9,0.01>-Vibrato speed (Hz)
slider10:vib_dep=0.45<0,1,0.001>-Vibrato depth
slider11:voicing=1<0,2,1{Mellow,Normal,Brilliant}>-Voicing
slider12:kclick=0.35<0,1,0.001>-Key click
slider13:drive=2<0,10,0.01>-Preamp drive
slider14:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider15:tune=0<-50,50,0.1>-Fine tune (cents)
slider16:spread=0.5<0,1,0.001>-Stereo spread
slider17:drift=50<0,100,1>-Drift (%)
slider18:vol=0<-24,6,0.1>-Volume (dB)
slider19:sat=0<0,100,1>-Saturation (%)
slider20:prs_sel=0<0,14,1{No preset,Init,Beat Group,Garage Fuzz,Soft Flutes,Nasal Strings,Full Combo,Psych Swirl,Glass Top,Bass Pedal,Ballad,Surf Stab,Mixture Lead,Cathedral Club,Straight Eights}>-Preset

@init
function psw_all(v) ( slider_show(2097151, v); );
function psw_allg(v) ( slider_show(2097151, v); );
#ui_man = "gfx-v4-g-medway-63";
ext_noinit = 1;
gfx_ext_retina = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

NK = 24;  KS = 24;  M_KEY = 0;
M_PH = 600;  M_INC = 620;  M_PCM = 640;
M_DV = 660;  M_DT = 680;  M_DTM = 700;
M_PNL = 720;  M_PNR = 740;
NE = 168;
M_EPC = 800;  M_EM = 1000;  M_EF = 1200;
M_SQ = 1400;  M_SW = 1600;
M_LSQ = 1800;  M_LSW = 2000;  M_STP = 2200;
M_KBD = 2400;
MQ = 4096;  MQMAX = 1000;
ZE = NE;

K_ON = 0;  K_NOTE = 1;  K_GATE = 2;  K_SUS = 3;  K_ENV = 4;  K_TGT = 5;  K_AGE = 6;  K_BNC = 7;
K_E16 = 8;  K_E8 = 9;  K_E4 = 10;  K_E2 = 11;  K_M1 = 12;  K_M2 = 13;  K_M3 = 14;  K_M4 = 15;
K_GL = 16;  K_GR = 17;  K_STL = 18;  K_PEND = 19;  K_FAST = 20;

memset(M_KEY, 0, NK * KS);  memset(M_SQ, 0, 2 * 200);  memset(M_STP, 0, 200);  memset(M_KBD, 0, 128);

e_i = 0;
loop(NE + 1,
  e_pc = floor(e_i / 14);  e_o = e_i - e_pc * 14;
  M_EPC[e_i] = min(e_pc, 11);  M_EM[e_i] = 2 ^ min(e_o, 10);
  M_EF[e_i] = e_o > 10 || e_i >= NE ? 1000000 : 440 * 2 ^ ((e_pc - 69) / 12) * 2 ^ e_o;
  e_i += 1;
);

function n2e(n) local(pc, o, e) (
  n < 0 ? ZE : (
    pc = n % 12;  o = floor(n / 12);
    e = pc * 14 + o;
    o > 10 || M_EF[e] > 0.4 * srate ? ZE : e;
  );
);

function n2e_mx(n) local(e) (
  e = n2e(n);
  while (e != ZE && M_EF[e] > 5500) ( n -= 12;  e = n2e(n); );
  e;
);

k = 0;
loop(12,
  t = k == 0 ? -0.8 : k == 1 ? 0.6 : k == 2 ? -0.4 : k == 3 ? 0.9 : k == 4 ? -0.6 : k == 5 ? 0.3 :
      k == 6 ? -0.9 : k == 7 ? 0.5 : k == 8 ? -0.3 : k == 9 ? 0.8 : k == 10 ? -0.5 : 0.4;
  M_PNL[k + 12] = t;
  M_PH[k] = rand(1);  M_DV[k] = rand(2) - 1;  M_DT[k] = rand(2) - 1;  M_DTM[k] = rand(3);  M_PCM[k] = 1;
  k += 1;
);

drf_vib.drift_init(0.8);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
os_design();
os_f = os_tf = os_f2n(os_sel);  os_base = 0;  os_gsetup();

function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);

function sqr_bl(p, d) local(q) ( q = p + 0.5;  q >= 1 ? q -= 1;  saw_bl(q, d) - saw_bl(p, d); );

function bq_cf(tp, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w, cw, al, a, n0) (
  f = min(f, 0.45 * srate);  w = 2 * $pi * f / srate;  cw = cos(w);  al = sin(w) / (2 * q);  a = 10 ^ (gdb / 40);
  tp == 0 ? ( n0 = 1 + al;  b0 = (1 - cw) * 0.5 / n0;  b1 = (1 - cw) / n0;  b2 = b0;  a1 = -2 * cw / n0;  a2 = (1 - al) / n0; ) :
  tp == 1 ? ( n0 = 1 + al;  b0 = (1 + cw) * 0.5 / n0;  b1 = -(1 + cw) / n0;  b2 = b0;  a1 = -2 * cw / n0;  a2 = (1 - al) / n0; ) :
  tp == 2 ? ( n0 = 1 + al / a;  b0 = (1 + al * a) / n0;  b1 = -2 * cw / n0;  b2 = (1 - al * a) / n0;  a1 = b1;  a2 = (1 - al / a) / n0; ) :
  (
    al = sin(w) * 0.5 * sqrt(2);  n0 = (a + 1) - (a - 1) * cw + 2 * sqrt(a) * al;
    b0 = a * ((a + 1) + (a - 1) * cw + 2 * sqrt(a) * al) / n0;
    b1 = -2 * a * ((a - 1) + (a + 1) * cw) / n0;
    b2 = a * ((a + 1) + (a - 1) * cw - 2 * sqrt(a) * al) / n0;
    a1 = 2 * ((a - 1) - (a + 1) * cw) / n0;
    a2 = ((a + 1) - (a - 1) * cw - 2 * sqrt(a) * al) / n0;
  );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1;  z1 = b1 * x - a1 * y + z2;  z2 = b2 * x - a2 * y;  y;
);
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );

function bus_filters() (
  bsL1.bq_cf(0, 700, 0.6, 0);    bsR1.bq_cf(0, 700, 0.6, 0);
  flL1.bq_cf(0, 1300, 0.6, 0);   flR1.bq_cf(0, 1300, 0.6, 0);
  flL2.bq_cf(0, 3200, 0.7, 0);   flR2.bq_cf(0, 3200, 0.7, 0);
  prL1.bq_cf(2, 1200, 0.8, 3);   prR1.bq_cf(2, 1200, 0.8, 3);
  prL2.bq_cf(0, 5000, 0.7, 0);   prR2.bq_cf(0, 5000, 0.7, 0);
  stL1.bq_cf(1, 520, 0.6, 0);    stR1.bq_cf(1, 520, 0.6, 0);
  stL2.bq_cf(2, 2600, 1.4, 7);   stR2.bq_cf(2, 2600, 1.4, 7);
  stL3.bq_cf(0, 7500, 0.7, 0);   stR3.bq_cf(0, 7500, 0.7, 0);
  brL1.bq_cf(1, 260, 0.6, 0);    brR1.bq_cf(1, 260, 0.6, 0);
  brL2.bq_cf(0, 9500, 0.7, 0);   brR2.bq_cf(0, 9500, 0.7, 0);
);
function voicing_filters(g) (
  voL1.bq_cf(3, 2600, 0.7, g);  voR1.bq_cf(3, 2600, 0.7, g);
  voL2.bq_cf(2, 5000, 0.9, max(0, g) * 0.45);  voR2.bq_cf(2, 5000, 0.9, max(0, g) * 0.45);
);

function db_g(v) ( v < 0.5 ? 0 : 10 ^ ((v - 8) * 3 / 20); );

function ge_run(x) instance(u1) local(u, y) (
  u = x * ge_g + ge_b;
  y = (u + u1) / (sqrt(1 + u * u) + sqrt(1 + u1 * u1));
  u1 = u;
  ge_pk = max(ge_pk, abs(u));
  (y - ge_fb) * ge_mk;
);

function k_start(b, n) local(pc) (
  b[K_ON] = 1;  b[K_NOTE] = n;  b[K_GATE] = 1;  b[K_SUS] = 0;  b[K_TGT] = 1;
  age_n += 1;  b[K_AGE] = age_n;
  b[K_E16] = n2e(n - 12);  b[K_E8] = n2e(n);  b[K_E4] = n2e(n + 12);  b[K_E2] = n2e(n + 24);
  b[K_M1] = n2e_mx(n + 19);  b[K_M2] = n2e_mx(n + 24);  b[K_M3] = n2e_mx(n + 28);  b[K_M4] = n2e_mx(n + 36);
  pc = n % 12;  b[K_GL] = M_PNL[pc];  b[K_GR] = M_PNR[pc];
  b[K_BNC] = (0.002 + rand(1) * 0.004) * srate;
  b[K_FAST] = 0;  b[K_STL] = 0;
);
function key_on(n) local(k, b, best, bq, q) (
  best = -1;  bq = 1000000000;  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    q = !b[K_ON] ? -1 : (!b[K_GATE] && !b[K_SUS]) ? b[K_ENV] : 2 + b[K_AGE];
    b[K_ON] && b[K_NOTE] == n && !b[K_STL] ? q = -2;
    q < bq ? ( bq = q;  best = k; );
    k += 1;
  );
  b = M_KEY + best * KS;
  b[K_ON] && b[K_NOTE] != n && b[K_ENV] > 0.001 ? (
    b[K_STL] = 1;  b[K_PEND] = n;  b[K_TGT] = 0;  b[K_GATE] = 0;  b[K_SUS] = 0;
  ) : k_start(b, n);
  lst_dirty = 1;
);
function key_off(n) local(k, b) (
  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    b[K_ON] && b[K_GATE] && b[K_NOTE] == n && !b[K_STL] ? ( b[K_GATE] = 0;  sustain ? b[K_SUS] = 1 : b[K_TGT] = 0; );
    b[K_STL] && b[K_PEND] == n ? b[K_PEND] = -1;
    k += 1;
  );
);
function pedal_up() local(k, b) (
  k = 0;
  loop(NK, b = M_KEY + k * KS;  b[K_SUS] ? ( b[K_SUS] = 0;  !b[K_GATE] ? b[K_TGT] = 0; );  k += 1; );
);
function all_off() local(k, b) (
  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    b[K_ON] ? ( b[K_GATE] = 0;  b[K_SUS] = 0;  b[K_TGT] = 0; );
    b[K_STL] ? b[K_PEND] = -1;
    k += 1;
  );
);
function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? key_on(d1) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? key_off(d1) :
  st == 0xB0 ? (
    d1 == 1 ? mw = d2 / 127 :
    d1 == 11 ? ex_t = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? all_off();
  );
);

function mark_sq(e) ( e != ZE && M_STP[e] != stamp ? ( M_STP[e] = stamp;  M_LSQ[lsq_n] = e;  lsq_n += 1; ); );
function mark_sw(e) ( e != ZE ? ( M_LSW[lsw_n] = e;  lsw_n += 1;  mark_sq(e);  mark_sq(e + 1);  mark_sq(e + 2);  mark_sq(e + 3); ); );
function build_lists() local(k, b) (
  stamp += 1;  lsq_n = 0;  lsw_n = 0;
  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    b[K_ON] ? (
      mark_sq(b[K_E16]);  mark_sq(b[K_E8]);  mark_sq(b[K_E4]);  mark_sq(b[K_E2]);
      mark_sq(b[K_M1]);  mark_sq(b[K_M2]);  mark_sq(b[K_M3]);  mark_sq(b[K_M4]);
      mark_sw(b[K_E8]);  mark_sw(b[K_E4]);
    );
    k += 1;
  );

);

function update_params() local(t) (
  drift_macro(drift);
  dr_c = 1 - exp(-CR * dm_s / (1.5 * srate));
  g16_t = db_g(db16);  g8f_t = db_g(db8f);  g8p_t = db_g(db8p);  g4f_t = db_g(db4f);
  g4s_t = db_g(db4s);  g2_t = db_g(db2);  gmx_t = db_g(dbmx);
  vd_t = vib_on >= 0.5 ? vib_dep : 0;
  vo_t = voicing < 0.5 ? -10 : voicing < 1.5 ? 0 : 7;
  kc_t = kclick;
  t = drive / 10;  drv_t = t;
  sp_t = spread;
  outg_t = 10 ^ (vol / 20);
  tune_t = tune;
  os_tf = os_f2n(os_sel);
  sat_t = sat / 100;
);

function sl_auto_au(idx) ( slider_automate(2 ^ (idx - 1)); );
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 4); pv(2, 8); pv(3, 0); pv(4, 6); pv(5, 0); pv(6, 0); pv(7, 0);
  pv(8, 1); pv(9, 6.5); pv(10, 0.45); pv(11, 1); pv(12, 0.35); pv(13, 2);
  pv(15, 0); pv(16, 0.5); pv(17, 50); pv(18, 0); pv(19, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (
    pv(1, 0); pv(2, 8); pv(3, 6); pv(4, 0); pv(5, 7); pv(6, 4); pv(7, 0); pv(11, 2); pv(13, 3.5); pv(10, 0.4);
  ) :
  p == 3 ? (
    pv(1, 5); pv(2, 8); pv(3, 8); pv(4, 6); pv(5, 6); pv(6, 5); pv(7, 4); pv(11, 2); pv(13, 8.5); pv(10, 0.5); pv(12, 0.5); pv(18, -2);
  ) :
  p == 4 ? (
    pv(1, 3); pv(2, 8); pv(3, 0); pv(4, 5); pv(5, 0); pv(6, 0); pv(7, 0); pv(11, 0); pv(13, 0.5); pv(10, 0.3); pv(9, 5.8); pv(12, 0.15);
  ) :
  p == 5 ? (
    pv(1, 0); pv(2, 4); pv(3, 0); pv(4, 0); pv(5, 8); pv(6, 3); pv(7, 0); pv(11, 1); pv(13, 2.5); pv(10, 0.35); pv(18, 3.5);
  ) :
  p == 6 ? (
    pv(1, 6); pv(2, 8); pv(3, 7); pv(4, 7); pv(5, 6); pv(6, 6); pv(7, 6); pv(11, 1); pv(13, 4); pv(18, -2);
  ) :
  p == 7 ? (
    pv(1, 5); pv(2, 8); pv(3, 0); pv(4, 7); pv(5, 0); pv(6, 5); pv(7, 3); pv(9, 4.2); pv(10, 0.9); pv(13, 3); pv(16, 0.8);
  ) :
  p == 8 ? (
    pv(1, 0); pv(2, 0); pv(3, 0); pv(4, 6); pv(5, 0); pv(6, 8); pv(7, 6); pv(11, 2); pv(13, 1.5); pv(10, 0.3); pv(18, 1);
  ) :
  p == 9 ? (
    pv(1, 8); pv(2, 6); pv(3, 0); pv(4, 0); pv(5, 0); pv(6, 0); pv(7, 0); pv(8, 0); pv(11, 0); pv(13, 2); pv(12, 0.5); pv(16, 0);
  ) :
  p == 10 ? (
    pv(1, 4); pv(2, 8); pv(3, 3); pv(4, 4); pv(5, 0); pv(6, 0); pv(7, 0); pv(9, 5); pv(10, 0.3); pv(11, 0); pv(13, 1); pv(12, 0.1); pv(16, 0.7);
  ) :
  p == 11 ? (
    pv(1, 0); pv(2, 7); pv(3, 8); pv(4, 0); pv(5, 5); pv(6, 6); pv(7, 0); pv(8, 0); pv(11, 2); pv(13, 6); pv(12, 0.6);
  ) :
  p == 12 ? (
    pv(1, 0); pv(2, 8); pv(3, 0); pv(4, 0); pv(5, 0); pv(6, 0); pv(7, 8); pv(9, 7.5); pv(10, 0.5); pv(11, 1); pv(13, 4.5);
  ) :
  p == 13 ? (
    pv(1, 8); pv(2, 8); pv(3, 6); pv(4, 8); pv(5, 4); pv(6, 6); pv(7, 5); pv(8, 0); pv(11, 1); pv(13, 1); pv(16, 0.9); pv(18, -3);
  ) :
  p == 14 ? (
    pv(1, 3); pv(2, 0); pv(3, 8); pv(4, 0); pv(5, 6); pv(6, 0); pv(7, 0); pv(8, 0); pv(11, 1); pv(13, 4); pv(12, 0.45); pv(18, 3);
  ) : 0;
  i = 1;  loop(19, i != 14 ? sl_auto_au(i);  i += 1; );
  prm_dirty = 1;
);

PR_N = 14;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(20, i != 20 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  load_preset(k);
    k <= PR_N ? ( prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel;  prs_sel > 0 && prs_hs ? ( load_preset(prs_sel);  prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0;  prs_ok = 1; );
);
prs_ok = 0;  prs_dirty = 0;

function rate_setup() (
  bus_filters();
  smk = 1 - exp(-1 / (0.015 * srate));
  cf_att = 1 - exp(-1 / (0.003 * srate));  cf_rel = 1 - exp(-1 / (0.012 * srate));
  cf_bnc = 1 - exp(-1 / (0.0003 * srate));  cf_stl = 1 - exp(-1 / (0.001 * srate));
  dc_r = 1 - 2 * $pi * 5 / srate;
  ge_env_c = 1 - exp(-1 / (0.04 * srate));
  sag_c = 1 - exp(-CR / (0.08 * srate));
  drL.bq_cf(1, 55, 0.6, 0);  drR.bq_cf(1, 55, 0.6, 0);
);

function os_rcoefs(f) ( amL.bq_cf(0, 9000 / f, 0.6, 0);  amR.bq_cf(0, 9000 / f, 0.6, 0);  );

rate_setup();
update_params();
mw = 0;  ex_t = 1;  ex_s = 1;  sustain = 0;  age_n = 0;  cr_n = 0;  stamp = 0;  lsq_n = 0;  lsw_n = 0;
vph = 0;  vib_v = 0;  vm = 1;  vm_d = 0;  sag_s = 0;
g16 = g16_t;  g8f = g8f_t;  g8p = g8p_t;  g4f = g4f_t;  g4s = g4s_t;  g2 = g2_t;  gmx = gmx_t;
vd_s = vd_t;  vo_s = vo_t;  vo_l = 1000;  kc_s = kc_t;  drv_s = drv_t;  sp_s = sp_t;  out_g = outg_t;  tune_s = tune_t;
voicing_filters(vo_s);  vo_l = vo_s;

amp_f = os_f;  os_rcoefs(os_f);

function gap_clear() (
  memset(M_KEY, 0, NK * KS);  memset(M_SQ, 0, 2 * 200);  lsq_n = 0;  lsw_n = 0;  sustain = 0;
  bsL1.bq_clr(); bsR1.bq_clr(); flL1.bq_clr(); flR1.bq_clr(); flL2.bq_clr(); flR2.bq_clr();
  prL1.bq_clr(); prR1.bq_clr(); prL2.bq_clr(); prR2.bq_clr();
  stL1.bq_clr(); stR1.bq_clr(); stL2.bq_clr(); stR2.bq_clr(); stL3.bq_clr(); stR3.bq_clr();
  brL1.bq_clr(); brR1.bq_clr(); brL2.bq_clr(); brR2.bq_clr();
  voL1.bq_clr(); voR1.bq_clr(); voL2.bq_clr(); voR2.bq_clr();
  drL.bq_clr(); drR.bq_clr(); amL.bq_clr(); amR.bq_clr();
  gL.u1 = 0; gR.u1 = 0; ge_e = 0;
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  dc_xl = dc_pl = dc_xr = dc_pr = 0;
  ostL.ost_ch_init(); ostR.ost_ch_init();
  gp_g = 0;
);
gp_g = 1;  gp_c = 1 / (0.015 * srate);

pwr_init(); pwr_sag = 0.3;  pwr_wu_loss = 0.6;  pwr_wu_drv = 1.5;  pwr_wu_lp = 8000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update_params();
os_snap(slider(14));

@block
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? gap_clear();
g_tp = g_now;  g_gpp = play_position;  g_gpd = samplesblock / srate;
prs_chk();
pwr_block(1);
wu_c = (1 - pwr_gm) * (-8 + 3 * pwr_w1);
prm_dirty ? ( prm_dirty = 0;  update_params(); );

pn_dirty ? ( pn_dirty = 0;  sustain = 0;  all_off(); );

mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  (m_st & 0xF0) == 0x90 && m_d2 > 0 ? mi_led_d = 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? all_off();  tp_was = tp_now;

vib_dv = drf_vib.drift_tick(samplesblock / srate * 0.2 * dm_s);
vib_rate = vib_spd * (1 + 0.04 * dm_a * vib_dv);
ost_setup(sat_t, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
od_disp = max(od_disp, ge_pk);  ge_pk = 0;
lfo_disp = vib_v * (vd_s > 0.01);
memset(M_KBD, 0, 128);
k = 0;  n_on = 0;
loop(NK,
  kb = M_KEY + k * KS;
  kb[K_ON] ? ( n_on += 1;  kb[K_GATE] || kb[K_SUS] ? M_KBD[kb[K_NOTE]] = 1; );
  k += 1;
);
keys_disp = n_on;
os_snapb(slider(14));

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  build_lists();

  vph += vib_rate * CR / srate;  vph >= 1 ? vph -= 1;
  t = vph < 0.42 ? 0.5 * vph / 0.42 : 0.5 + 0.5 * (vph - 0.42) / 0.58;
  vib_v = sin(2 * $pi * t);
  vd_s += (vd_t - vd_s) * (1 - exp(-CR / (0.03 * srate)));

  ld = 0;  k = 0;
  loop(NK, kb = M_KEY + k * KS;  ld += kb[K_ENV];  k += 1; );
  ld *= (g16 + g8f + g8p + g4f + g4s + g2 + gmx * 2) / 9;
  sag_s += (min(1, ld / 10) - sag_s) * sag_c;
  tune_s += (tune_t - tune_s) * (1 - exp(-CR / (0.03 * srate)));

  k = 0;
  loop(12,
    M_DTM[k] -= CR / srate * dm_s;  M_DTM[k] <= 0 ? ( M_DT[k] = rand(2) - 1;  M_DTM[k] = 1.5 + rand(1) * 3; );
    M_DV[k] += (M_DT[k] - M_DV[k]) * dr_c;
    M_INC[k] = 440 * 2 ^ ((k - 69 + (tune_s + wu_c + (M_DV[k] * 2.5 - sag_s * 3) * dm_a) * 0.01) / 12) / srate;
    k += 1;
  );

  t = 2 ^ ((vib_v * (vd_s + mw * 0.5) * 60) / 1200);
  vm_d = (t - vm) / CR;

  sp_s += (sp_t - sp_s) * (1 - exp(-CR / (0.03 * srate)));
  k = 0;
  loop(12, t = M_PNL[k + 12] * sp_s;  M_PNL[k] = sqrt(0.5 * (1 - t));  M_PNR[k] = sqrt(0.5 * (1 + t));  k += 1; );
  k = 0;
  loop(NK, kb = M_KEY + k * KS;  kb[K_ON] ? ( t = kb[K_NOTE] % 12;  kb[K_GL] = M_PNL[t];  kb[K_GR] = M_PNR[t]; );  k += 1; );

  vo_s += (vo_t - vo_s) * (1 - exp(-CR / (0.03 * srate)));
  abs(vo_s - vo_l) > 0.02 ? ( voicing_filters(vo_s);  vo_l = vo_s; );

  drv_s += (drv_t - drv_s) * (1 - exp(-CR / (0.03 * srate)));
  ge_g = 1.2 * 10 ^ (drv_s * 30 / 20);
  ge_b = 0.16 + 0.22 * drv_s * min(1, ge_e * ge_g * 1.5);
  ge_fb = ge_b / sqrt(1 + ge_b * ge_b);
  !ge_i0 ? ( gL.u1 = gR.u1 = ge_b;  ge_i0 = 1; );
  t = 0.07 * ge_g + ge_b;  ge_mk = 0.07 / (t / sqrt(1 + t * t) - ge_fb);
  ge_mk *= 1 - 0.045 * sag_s * dm_a;
  kc_s = kc_t;
);
cr_n -= 1;

g16 += (g16_t - g16) * smk;  g8f += (g8f_t - g8f) * smk;  g8p += (g8p_t - g8p) * smk;  g4f += (g4f_t - g4f) * smk;
g4s += (g4s_t - g4s) * smk;  g2 += (g2_t - g2) * smk;  gmx += (gmx_t - gmx) * smk;
out_g += (outg_t - out_g) * smk;  ex_s += (ex_t - ex_s) * smk;
vm += vm_d;

k = 0;
loop(12, t = M_PH[k] + M_INC[k] * vm;  t >= 1 ? t -= 1;  M_PH[k] = t;  k += 1; );
i = 0;
loop(lsq_n,
  e = M_LSQ[i];  t = M_EPC[e];  em = M_EM[e];
  q = M_PH[t] * em;  q -= floor(q);
  M_SQ[e] = sqr_bl(q, M_INC[t] * vm * em);
  i += 1;
);
i = 0;
loop(lsw_n,
  e = M_LSW[i];
  M_SW[e] = (M_SQ[e] + 0.5 * M_SQ[e + 1] + 0.25 * M_SQ[e + 2] + 0.125 * M_SQ[e + 3]) * 0.6;
  i += 1;
);

bsl = bsr = fll = flr = prl = prr = stl = str = brl = brr = 0;
kb = M_KEY;  k = 0;
loop(NK,
  kb[K_ON] ? (

    kb[K_BNC] > 0 ? (
      kb[K_BNC] -= 1;
      (kb[K_BNC] & 63) == 0 ? kb[K_FAST] = rand(1) < 0.5 ? 1 - kc_s : 1;
      e_v = kb[K_FAST];
      kb[K_ENV] += (e_v - kb[K_ENV]) * cf_bnc;
    ) : kb[K_STL] ? (
      kb[K_ENV] -= kb[K_ENV] * cf_stl;
      kb[K_ENV] < 0.0005 ? ( kb[K_ENV] = 0;  kb[K_STL] = 0;  kb[K_PEND] >= 0 ? ( k_start(kb, kb[K_PEND]);  lst_dirty = 1; ) : kb[K_ON] = 0; );
    ) : (
      kb[K_ENV] += (kb[K_TGT] - kb[K_ENV]) * (kb[K_TGT] > kb[K_ENV] ? cf_att : cf_rel);
      !kb[K_TGT] && kb[K_ENV] < 0.00002 ? ( kb[K_ENV] = 0;  kb[K_ON] = 0; );
    );
    a = kb[K_ENV];
    x = M_SQ[kb[K_E16]] * g16 * a;  bsl += x * kb[K_GL];  bsr += x * kb[K_GR];
    x = (M_SQ[kb[K_E8]] * g8f + M_SQ[kb[K_E4]] * g4f) * a;  fll += x * kb[K_GL];  flr += x * kb[K_GR];
    x = M_SW[kb[K_E8]] * g8p * a;  prl += x * kb[K_GL];  prr += x * kb[K_GR];
    x = M_SW[kb[K_E4]] * g4s * a;  stl += x * kb[K_GL];  str += x * kb[K_GR];
    x = (M_SQ[kb[K_E2]] * g2 + (M_SQ[kb[K_M1]] * 0.8 + M_SQ[kb[K_M2]] + M_SQ[kb[K_M3]] * 0.6 + M_SQ[kb[K_M4]] * 0.7) * gmx * 0.55) * a;
    brl += x * kb[K_GL];  brr += x * kb[K_GR];
  );
  kb += KS;  k += 1;
);

yl = bsL1.bq_run(bsl) * 1.3 + flL2.bq_run(flL1.bq_run(fll)) * 1.1 + prL2.bq_run(prL1.bq_run(prl))
   + stL3.bq_run(stL2.bq_run(stL1.bq_run(stl))) * 1.3 + brL2.bq_run(brL1.bq_run(brl)) * 0.7;
yr = bsR1.bq_run(bsr) * 1.3 + flR2.bq_run(flR1.bq_run(flr)) * 1.1 + prR2.bq_run(prR1.bq_run(prr))
   + stR3.bq_run(stR2.bq_run(stR1.bq_run(str))) * 1.3 + brR2.bq_run(brR1.bq_run(brr)) * 0.7;
yl = voL2.bq_run(voL1.bq_run(yl)) * 0.04 * ex_s;
yr = voR2.bq_run(voR1.bq_run(yr)) * 0.04 * ex_s;

pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;

os_gate();
os_chg ? ( os_rcoefs(os_f);  amL.bq_clr();  amR.bq_clr();  uxL.os_clr();  uxR.os_clr();  dnL.os_clr();  dnR.os_clr(); );
ge_e += (max(abs(yl), abs(yr)) - ge_e) * ge_env_c;
yl = drL.bq_run(yl);  yr = drR.bq_run(yr);
uxL.os_up(yl);  uxR.os_up(yr);
os_f == 1 ? (
  yl = amL.bq_run(gL.ge_run(yl));  yr = amR.bq_run(gR.ge_run(yr));
) : os_f == 2 ? (
  a0 = amL.bq_run(gL.ge_run(uxL.s0));  a1 = amL.bq_run(gL.ge_run(uxL.s1));
  b0 = amR.bq_run(gR.ge_run(uxR.s0));  b1 = amR.bq_run(gR.ge_run(uxR.s1));
  yl = dnL.os_dn(a0, a1, 0, 0);  yr = dnR.os_dn(b0, b1, 0, 0);
) : (
  a0 = amL.bq_run(gL.ge_run(uxL.s0));  a1 = amL.bq_run(gL.ge_run(uxL.s1));
  a2 = amL.bq_run(gL.ge_run(uxL.s2));  a3 = amL.bq_run(gL.ge_run(uxL.s3));
  b0 = amR.bq_run(gR.ge_run(uxR.s0));  b1 = amR.bq_run(gR.ge_run(uxR.s1));
  b2 = amR.bq_run(gR.ge_run(uxR.s2));  b3 = amR.bq_run(gR.ge_run(uxR.s3));
  yl = dnL.os_dn(a0, a1, a2, a3);  yr = dnR.os_dn(b0, b1, b2, b3);
);
yl *= os_g;  yr *= os_g;

dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
ost_out(yl * out_g, yr * out_g);  yl = ost_l;  yr = ost_r;
gp_g < 1 ? ( gp_g = min(1, gp_g + gp_c);  t = gp_g * gp_g * (3 - 2 * gp_g);  yl *= t;  yr *= t; );
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;
pwr_ser();

@gfx 900 355
function v4rd_c(c) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = 1; );
function v4rd_mx(c, t, f) ( (floor(((c >> 16) & 255) * (1 - f) + ((t >> 16) & 255) * f) << 16) + (floor(((c >> 8) & 255) * (1 - f) + ((t >> 8) & 255) * f) << 8) + floor((c & 255) * (1 - f) + (t & 255) * f); );
function v4rd(gx0, gy0, k, rad, c1, c2, c3) local(q, i, yd, gx, hw, j, n, xl, xr, il, ir, rr) (
  q = k * rad / 17;
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 17 * q, 1, 1);
  v4rd_c(0xE8EBEE); gfx_circle(gx0, gy0, 15 * q, 1, 1);
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 13 * q, 1, 1);
  i = 0;
  loop(3,
    v4rd_c(i == 0 ? c1 : i == 1 ? c2 : c3);
    yd = -12.2 + i * 2.6;
    gx = gx0 + 0.5; hw = sqrt(max(sqr(13.6) - sqr(yd + 0.8), 0)) * q;
    j = floor(gy0 + yd * q + 1); n = max(1, floor(1.6 * q));
    xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
    hw > 0 ? loop(n,
      il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
        gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
        gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
        gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
      );
      j += 1;
    );
    i += 1;
  );
  v4rd_c(0xE8EBEE);
  rr = 13 * q + 0.75; while (rr <= 15 * q - 0.75) ( gfx_circle(gx0, gy0, rr, 0, 1); rr += 0.5; );
  gfx_a = 1;
);
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(ink, 1); gfx_measurestr("DRIFT", tw, th);
  gfx_x = dk_ox + cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr("DRIFT");
);
C_ORG = 0xC35826;  C_ORGD = 0x8E3E1A;  C_ORGL = 0xE07C46;  C_GREY = 0x9EA2A6;  C_GREYD = 0x6E7276;
C_SEC1 = 0x32373D;  C_SEC2 = 0x2D3237;  C_SEC3 = 0x363C42;
C_INK = 0xF6F6F2;  C_INK2 = 0xC9CDD2;  C_DIM = 0x737980;  C_RIV = 0x55595E;
C_LCDBG = 0x120A04;  C_LCDTX = 0xFFB040;  C_AMB = 0xFFB030;  C_RED = 0xFF4A30;  C_HDINK = 0x1C1C1E;
C_CREAM = 0xF1E9D2;  C_PBK = 0xF2A41E;  lk_well = 0x111214;
C_DBB = 0x7A4A26;  C_DBF = 0xF1E9D2;  C_DBP = 0xE8742E;  C_DBS = 0x1E1F21;  C_DBG = 0xB8BCC0;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, f) (
  floor(floor(c1 / 65536) * (1 - f) + floor(c2 / 65536) * f) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - f) + (floor(c2 / 256) % 256) * f) * 256 +
  floor((c1 % 256) * (1 - f) + (c2 % 256) * f);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_l(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_r(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function rivet(x, y) (
  col(C_RIV, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.45);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
function section(x, y, w, h, c, title, ctr) local(tw, th) (
  col(0x000000, 0.18);  u_rect(x + 2, y + 3, w, h);
  col(c, 1);  u_rect(x, y, w, h);
  col(shade(c, 0.72), 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h - 2);
  col(0xFFFFFF, 0.12);  u_rect(x, y, w - 2, 1);  u_rect(x, y, 1, h - 2);
  gfx_setfont(4);  gfx_measurestr(title, tw, th);  col(C_INK, 1);
  ctr ? (
    text_c(px(x + w * 0.5), py(y + 20), title);
    col(C_ORGL, 1);  gfx_rect(px(x + w * 0.5) - tw * 0.5, py(y + 30), tw, ps(3), 1);
  ) : (
    text_l(px(x + 16), py(y + 20), title);
    col(C_ORGL, 1);  gfx_rect(px(x + 16), py(y + 30), tw, ps(3), 1);
  );
);

function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v * 100 + 0.5) :
  fmt == 2 ? ( v < 1 ? sprintf(#kv, "%.2f Hz", v) : sprintf(#kv, "%.1f Hz", v); ) :
  fmt == 4 ? sprintf(#kv, "%d %%", v + 0.5) :
  fmt == 5 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 6 ? sprintf(#kv, "%.1f", v) :
             sprintf(#kv, "%.2f", v);
  #kv;
);
function val_plate(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(5), y - h * 0.5 - ps(2), w + ps(10), h + ps(4), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
function dshadow(x, y, r) local(i) (
  i = 0;
  loop(4, col(0x000000, 0.08);  gfx_circle(x + ps(1.5 + i * 0.9), y + ps(2 + i * 1.1), r + ps(i * 0.5), 1, 1);  i += 1; );
);
function rshadow(x, y, w, h) local(i) (
  i = 0;  loop(4, col(0x000000, 0.08);  u_rect(x + 1.5 + i * 0.9, y + 2 + i * 1.1, w + i * 0.5, h + i * 0.5);  i += 1; );
);

function knob_face(x, y, rr, tv, cap, dm) local(i, a, r1) (
  col(0x17191C, 1);  gfx_circle(x, y, rr, 1, 1);
  col(0x3A3E44, 1);  gfx_circle(x, y, rr * 0.97, 1, 1);
  col(0x24272B, 1);  i = 0;
  loop(24, a = 2 * $pi * i / 24;  gfx_circle(x + sin(a) * rr * 0.86, y - cos(a) * rr * 0.86, max(1, rr * 0.07), 1, 1);  i += 1; );
  r1 = rr * 0.72;
  col(dm ? shade(cap, 0.6) : cap, 1);  gfx_circle(x, y, r1, 1, 1);
  col(0xFFFFFF, 0.28);  gfx_arc(x, y, r1 - ps(0.5), -1.9, -0.2, 1);
  col(0x000000, 0.14);  gfx_arc(x, y, r1 - ps(0.5), 0.5, 2.7, 1);  gfx_arc(x, y, r1 - ps(1.5), 0.8, 2.4, 1);
  col(dm ? 0x55595E : 0x1E2023, 1);
  gfx_circle(x + sin(tv) * r1 * 0.62, y - cos(tv) * r1 * 0.62, max(ps(2), r1 * 0.19), 1, 1);
);
function kn(cx, cy, r, idx, vmin, vmax, def, cap, lbl, fmt)
  local(x, y, rr, v, f, hov, now, a0, a1, tv, b, j, lgt, dm, nd, ly)
(
  lgt = klog;  klog = 0;  dm = kdim;  kdim = 0;  nd = kn_ends;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  f = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  kd_my = mouse_y;  kd_n = f;  kd_dz = mouse_y; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    f = max(0, min(1, f + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
    v = lgt ? vmin * exp(f * log(vmax / vmin)) : vmin + f * (vmax - vmin);
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx && abs(mouse_y - kd_dz) >= 3 ? (
    f = max(0, min(1, kd_n + (kd_my - mouse_y) / ps((mouse_cap & 8) ? 1100 : 200)));
    v = lgt ? vmin * exp(f * log(vmax / vmin)) : vmin + f * (vmax - vmin);
    v = floor(v * 1000 + 0.5) / 1000;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    kd_dz = -100000;
  );
  v = max(vmin, min(vmax, slider(idx)));
  f = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + f * (a1 - a0);
  j = 0;
  loop(5,
    b = a0 + j / 4 * (a1 - a0);
    (j == 0 || j == 4) ? ( col(C_INK2, 0.85);  gfx_circle(x + sin(b) * (rr + ps(7)), y - cos(b) * (rr + ps(7)), ps(1.8), 1, 1); );
    j += 1;
  );
  dshadow(x, y, rr);
  knob_face(x, y, rr, tv, cap, dm);
  ly = y + rr + ps(kn_ly);
  hov || drag_idx == idx ? val_plate(x, ly, fmtv(v, fmt)) : ( gfx_setfont(6);  col(dm ? C_DIM : C_INK, 1);  text_c(x, ly, lbl); );
);

function drawbar(cx, idx, tip, ink, ftg, nm, def) local(v, hov, now, ty, i, sy, x0, f)
(
  x0 = cx - DB_TW * 0.5;
  v = slider(idx);
  hov = mouse_x >= px(x0 - 6) && mouse_x < px(x0 + DB_TW + 6) && mouse_y >= py(DB_Y - 16) && mouse_y < py(DB_Y + 8 * DB_STEP + DB_TH + 4);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  dbd_my = mouse_y;  dbd_n = v; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    f = max(0, min(8, v - sign(mouse_wheel)));
    f != v ? ( slider(idx) = f;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    f = max(0, min(8, floor(dbd_n + (mouse_y - dbd_my) / ps((mouse_cap & 8) ? DB_STEP * 3 : DB_STEP) + 0.5)));
    f != v ? ( slider(idx) = f;  param_touched(idx); );
  );
  v = slider(idx);  ty = DB_Y + v * DB_STEP;
  col(0x0B0C0D, 1);  u_rect(x0 - 4, DB_Y - 10, DB_TW + 8, 12);
  col(0xFFFFFF, 0.10);  u_rect(x0 - 4, DB_Y + 2, DB_TW + 8, 1);
  v > 0 ? (
    col(0x000000, 0.25);  u_rect(cx - 9 + 3, DB_Y + 2, 18, v * DB_STEP);
    col(shade(tip, tip == C_DBS ? 1.6 : 0.92), 1);  u_rect(cx - 9, DB_Y, 18, v * DB_STEP);
    col(0xFFFFFF, 0.18);  u_rect(cx - 9, DB_Y, 2, v * DB_STEP);
    col(0x000000, 0.2);  u_rect(cx + 7, DB_Y, 2, v * DB_STEP);
    gfx_setfont(7);  col(ink, 0.95);
    i = 1;
    loop(v,
      sy = DB_Y + (v - i) * DB_STEP + DB_STEP * 0.5;
      text_c(px(cx), py(sy), sprintf(#dbn, "%d", i));
      i += 1;
    );
  );
  rshadow(x0, ty, DB_TW, DB_TH);
  col(tip, 1);  u_rect(x0, ty, DB_TW, DB_TH);
  col(0xFFFFFF, tip == C_DBS ? 0.12 : 0.35);  u_rect(x0, ty, DB_TW, 2);
  col(0x000000, 0.22);  u_rect(x0, ty + DB_TH - 3, DB_TW, 3);  u_rect(x0 + DB_TW - 3, ty, 3, DB_TH - 3);
  col(0x000000, 0.08);  u_rect(x0, ty + DB_TH - 7, DB_TW, 4);
  hov ? ( col(0xFFFFFF, 0.07);  u_rect(x0, ty, DB_TW, DB_TH); );
  gfx_setfont(2);  col(ink, 1);  text_c(px(cx), py(ty + DB_TH * 0.5 - 1), ftg);
  hov || drag_idx == idx ? val_plate(px(cx), py(DB_NY), sprintf(#dbv, "%d", v))
    : ( gfx_setfont(6);  col(C_INK, 1);  text_c(px(cx), py(DB_NY), nm); );
);

function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, col(0x000000, 0.08);  lk_rr(x - 4 * k + 1.5 + i * 0.9, y - 4 * k + 2 + i * 1.1, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  on ? ( col(c, 0.22);  lk_rr(x - 8 * k, y - 8 * k, w + 16 * k, h + 16 * k, 8 * k); );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
  col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
  col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
  col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  on ? ( col(0xFFFFFF, 0.30);  lk_rr(x + 12 * k, y + 9 * k, w - 24 * k, h - 21 * k, 4 * k); );
  col(0xFFFFFF, 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(lk_fnt > 0 ? lk_fnt : 2);  lk_fnt = 0;  col(shade(c, 0.17), 1);  text_c(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lcd_box(x, y, w, h) (
  col(shade(C_ORG, 0.45), 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x020202, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  col(0xFFFFFF, 0.06);  u_rect(x + 4, y + 4, w - 8, 1);
);
function lcd_text(x, y, fnt, str) local(tw, th, gy) (
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y) - th * 0.5;
  col(C_LCDTX, 0.22);
  gfx_x = px(x) - 1;  gfx_y = gy;  gfx_drawstr(str);
  gfx_x = px(x) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x);  gfx_y = gy;  gfx_drawstr(str);
);
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, kw, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_fnt = 5;  lk_key(x, y + 3, kw, h - 6, 0, C_PBK, "PRESETS") ? open = 1;
  lk_key(x + kw + 4, y + 3, 24, h - 6, 0, C_PBK, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + kw + 30, y + 3, 24, h - 6, 0, C_PBK, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1A1A, 1);  pb_tri(x + kw + 16, y + h * 0.5, 4.5, -1);  pb_tri(x + kw + 42, y + h * 0.5, 4.5, 1);
  lx = x + kw + 60;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd_box(lx, y, lw, h);  lcd_text(lx + 10, y + h * 0.5, 9, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
PRESET_MENU = "Init|Beat Group|Garage Fuzz|Soft Flutes|Nasal Strings|Full Combo|Psych Swirl|Glass Top|Bass Pedal|Ballad|Surf Stab|Mixture Lead|Cathedral Club|Straight Eights";

function lamp(x, y, c, lv) (
  col(0x000000, 0.7);  gfx_circle(px(x), py(y), ps(6.5), 1, 1);
  lv > 0.02 ? ( col(c, 0.28 * lv);  gfx_circle(px(x), py(y), ps(11), 1, 1); );
  col(ui_mix(shade(c, 0.28), c, lv), 1);  gfx_circle(px(x), py(y), ps(5), 1, 1);
  lv > 0.3 ? ( col(0xFFFFFF, 0.5 * lv);  gfx_circle(px(x) - ps(1.4), py(y) - ps(1.4), ps(1.4), 1, 1); );
);
function panic_key(x, y, w, h, lit) local(hov, hit, dn) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  rshadow(x, y, w, h);
  col(0x0E0F10, 1);  lk_rr(x - 2, y - 2, w + 4, h + 4, 5);
  col(0x45484D, 1);  lk_rr(x, y + dn, w, h - dn, 4);
  col(0x2C2E32, 1);  lk_rr(x + 1, y + 1 + dn, w - 2, h - 2 - dn, 4);
  col(0x35373B, 1);  lk_rr(x + 1, y + 1 + dn, w - 2, h - 8, 4);
  hov ? ( col(0xFFFFFF, 0.06);  lk_rr(x + 1, y + 1, w - 2, h - 2, 4); );
  gfx_setfont(5);  col(lit ? 0xFF6A4A : 0xE8DCC0, 1);  text_c(px(x + w * 0.5), py(y + h * 0.5 + dn), "PANIC");
  hit;
);
function voicing_box(x, y, w, h) local(hov, v, i) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  v = floor(voicing + 0.5);
  col(0x000000, 0.35);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(C_LCDBG, 1);  u_rect(x, y, w, h);
  col(0xFFFFFF, hov ? 0.10 : 0.05);  u_rect(x + 2, y + 2, w - 4, 1);
  gfx_setfont(6);  col(C_LCDTX, 1);
  text_c(px(x + w * 0.5 - 8), py(y + h * 0.5), v == 0 ? "MELLOW" : v == 1 ? "NORMAL" : "BRILLIANT");
  gfx_triangle(px(x + w - 22), py(y + h * 0.5 - 3), px(x + w - 12), py(y + h * 0.5 - 3), px(x + w - 17), py(y + h * 0.5 + 3));
  click && hov && !drag_idx ? (
    gfx_x = px(x);  gfx_y = py(y + h);
    i = gfx_showmenu(v == 0 ? "!Mellow|Normal|Brilliant" : v == 1 ? "Mellow|!Normal|Brilliant" : "Mellow|Normal|!Brilliant");
    i > 0 ? ( slider(11) = i - 1;  param_touched(11); );
  );
);

g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (900 * g_ret), gfx_h / (355 * g_ret))), 0.5);
ox = 0;  oy = 0;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
h_click = sz_help ? click : 0;  h_wheel = sz_help ? mouse_wheel : 0;
sz_help ? ( click = 0;  mouse_wheel = 0; );
klog = 0;  kdim = 0;  kn_ends = 0;  kn_ly = 19;  lk_fnt = 0;

function fit_mono(idx, size) local(fs, w, h, target) (
  target = 5.4 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, "Courier New", fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);
sc != ff_sc ? (
  ff_sc = sc;
  fs1 = fit_mono(1, ps(25));
  fs10 = fit_mono(10, ps(12.5));
  fs2 = fit_mono(2, ps(15));
  fs3 = fit_mono(3, ps(14));
  fs4 = fit_mono(4, ps(17));
  fs5 = fit_mono(5, ps(13));
  fs6 = fit_mono(6, ps(14));
  fs7 = fit_mono(7, ps(11));
  fs8 = fit_mono(8, ps(12));
  fs9 = fit_mono(9, ps(18));
);
gfx_setfont(1, "Courier New", fs1, 'b');
gfx_setfont(10, "Courier New", fs10, 'b');
gfx_setfont(2, "Courier New", fs2, 'b');
gfx_setfont(3, "Courier New", fs3, 'b');
gfx_setfont(4, "Courier New", fs4, 'b');
gfx_setfont(5, "Courier New", fs5, 'b');
gfx_setfont(6, "Courier New", fs6, 'b');
gfx_setfont(7, "Courier New", fs7, 'b');
gfx_setfont(8, "Courier New", fs8, 'b');
gfx_setfont(9, "Courier New", fs9, 'b');

od_m = max(od_disp, od_m * 0.8);  od_disp = 0;
mi_led_d ? ( mi_led_d = 0;  ml_t = time_precise(); );
ml_v = max(0, 1 - (time_precise() - ml_t) / 0.15);

col(shade(C_ORG, 0.6), 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
g_gt = ui_mix(C_ORG, 0xFFFFFF, 0.22);  g_gb = ui_mix(C_ORG, 0x000000, 0.22);
gfx_gradrect(0, 0, 900 * sc, 355 * sc, floor(g_gt / 65536) / 255, (floor(g_gt / 256) % 256) / 255, (g_gt % 256) / 255, 1, 0, 0, 0, 0,
  ((floor(g_gb / 65536) - floor(g_gt / 65536)) / 255) / (355 * sc), (((floor(g_gb / 256) % 256) - (floor(g_gt / 256) % 256)) / 255) / (355 * sc),
  (((g_gb % 256) - (g_gt % 256)) / 255) / (355 * sc), 0);
col(0xFFFFFF, 0.12);  u_rect(0, 0, 900, 1.5);  u_rect(0, 0, 1.5, 355);
col(0x000000, 1);  u_rect(0, 52, 900, 3);  col(C_GREY, 1);  u_rect(0, 55, 900, 4);  col(C_GREYD, 1);  u_rect(0, 59, 900, 1);
col(0x000000, 0.30);  u_rect(0, 351, 900, 4);  u_rect(896, 60, 4, 291);
rivet(7, 7);  rivet(893, 7);  rivet(7, 348);  rivet(893, 348);

v4rd(px(34), py(27), ps(1), 16, C_ORGD, C_ORG, C_CREAM);
gfx_setfont(12, "Arial", ps(8), 'b');  col(0xF4F6F8, 1);  text_c(px(34), py(27), "GFX");
gfx_setfont(1);  col(0x000000, 0.30);  text_l(px(60), py(22), "MEDWAY 63");  col(C_HDINK, 1);  text_l(px(59), py(21), "MEDWAY 63");
gfx_setfont(10);  col(0x2A1408, 1);  text_l(px(60), py(41), "V4   TRANSISTOR COMBO ORGAN");

ml_v > 0.02 ? ( col(0x3CE05A, 0.25 * ml_v);  gfx_circle(px(300), py(21), ps(11), 1, 1); );
col(0x050506, 1);  gfx_circle(px(300), py(21), ps(7.5), 1, 1);
col(ui_mix(ui_mix(0x3CE05A, 0x101214, 0.78), 0x3CE05A, ml_v), 1);  gfx_circle(px(300), py(21), ps(5.5), 1, 1);
col(0xFFFFFF, 0.12 + 0.43 * ml_v);  gfx_circle(px(298.3), py(19.3), ps(1.7), 1, 1);
gfx_setfont(5);  col(C_HDINK, 1);  text_c(px(300), py(41), "MIDI");

prs_cur_d > 0 ? ( pr_cur = prs_cur_d;  prs_cur_d = 0; );
pb_k = preset_bar(322, 9, 34, 76, 193, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > PR_N ? 1 : pb_k; );

os_key(692, 15, 14, C_HDINK, 15);
pn_lit = time_precise() - pn_t < 0.3;
panic_key(728, 12, 76, 28, pn_lit) ? ( pn_dirty = 1;  pn_t = time_precise(); );

section(16, 70, 420, 270, C_SEC1, "DRAWBARS", 0);
gfx_setfont(5);  col(C_INK2, 1);  text_r(px(420), py(90), "PULL DOWN = LOUDER");
DB_Y = 122;  DB_STEP = 14;  DB_TW = 44;  DB_TH = 28;  DB_NY = 276;
drawbar(58, 1, C_DBB, C_INK, "16'", "BASS", 4);
