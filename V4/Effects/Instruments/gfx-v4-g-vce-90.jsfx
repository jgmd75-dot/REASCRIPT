  ui_col(lit ? 0xFFC860 : (hov ? 0x34363A : 0x2A2C30)); mg_rr(x + 3, y + 2, w - 6, h - 6, 3);
  ui_cola(0xFFFFFF, 0.12); mg_r(x + 5, y + 3, w - 10, 1);
