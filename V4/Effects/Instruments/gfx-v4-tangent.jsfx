desc:Tangent [electric keyboard] (GFX V4)
//tags: instrument keyboard funk physical model v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-drift, gfx-v4-output, gfx-v4-ui, gfx-v4-panel, gfx-v4-os, gfx-v4-power, gfx-v4-sliders (.jsfx-inc) in the same folder.

import gfx-v4-drift.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-sliders.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider51:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:pk_sel=2<0,3,1{Upper,Lower,Both,Both out of phase}>-Pickups
slider2:t_soft=0<0,1,1{Off,On}>-Soft
slider3:t_med=0<0,1,1{Off,On}>-Medium
slider4:t_treb=0<0,1,1{Off,On}>-Treble
slider5:t_bril=0<0,1,1{Off,On}>-Brilliant
slider6:mute=0<0,100,1>-Mute (%)
slider7:hard=55<0,100,1>-Attack (%)
slider8:damp=70<20,300,1:log>-Damper (ms)
slider9:knoise=30<0,100,1>-Key noise (%)
slider10:velsens=70<0,100,1>-Velocity (%)
slider11:drift=50<0,100,1>-Drift (%)
slider12:vol=0<-24,12,0.1>-Level (dB)
slider13:model=1<0,2,1{Burn,Juke,King}>-Model
slider14:cp_on=0<0,1,1{Out,In}>-Comp
slider15:cp_sq=40<0,100,1>-Comp squash (%)
slider16:cp_bl=100<0,100,1>-Comp blend (%)
slider17:fl_on=0<0,1,1{Out,In}>-Filter
slider18:fl_typ=0<0,2,1{Envelope up,Envelope down,Wah}>-Filter type
slider19:fl_sens=60<0,100,1>-Filter sens (%)
slider20:fl_peak=55<0,100,1>-Filter peak (%)
slider21:fl_rng=60<0,100,1>-Filter range (%)
slider22:fl_ped=30<0,100,1>-Wah pedal (%)
slider23:dr_on=0<0,1,1{Out,In}>-Drive
slider24:dr_typ=0<0,1,1{Grit,Fuzz}>-Drive type
slider25:dr_amt=40<0,100,1>-Drive (%)
slider26:dr_tone=60<0,100,1>-Drive tone (%)
slider27:os_sel=1<0,2,1{1x,2x,4x}>-Oversampling
slider28:ph_on=0<0,1,1{Out,In}>-Phaser
slider29:ph_rate=0.4<0.01,8,0.001:log>-Phaser rate (Hz)
slider30:ph_dep=60<0,100,1>-Phaser depth (%)
slider31:ph_fb=40<0,90,1>-Phaser feedback (%)
slider32:ch_on=0<0,1,1{Out,In}>-Chorus
slider33:ch_rate=0.6<0.01,5,0.001:log>-Chorus rate (Hz)
slider34:ch_dep=50<0,100,1>-Chorus depth (%)
slider35:ch_mix=50<0,100,1>-Chorus mix (%)
slider36:ph_bst=50<0,100,1>-Phaser boost (%)
slider37:pa_ms=400<50,2000,1:log>-Bloom (ms)
slider38:am_on=1<0,1,1{Out,In}>-Amp
slider39:am_bri=0<0,1,1{Off,On}>-Amp bright
slider40:am_vol=4<0,10,0.1>-Amp volume
slider41:am_tre=6<0,10,0.1>-Amp treble
slider42:am_mid=5<0,10,0.1>-Amp middle
slider43:am_bas=4<0,10,0.1>-Amp bass
slider44:am_rev=2<0,4,0.1>-Amp reverb
slider45:am_dwl=5<0,10,0.1>-Reverb dwell
slider46:am_rtn=6<0,10,0.1>-Reverb tone
slider47:am_mod=0<-100,100,1>-Modulation (pan - / trem +, %)
slider48:am_rate=4.5<0.01,12,0.01:log>-Modulation rate (Hz)
slider49:sat_amt=0<0,100,1>-Output sat (%)
slider50:prs_sel=0<0,10,1{No preset,Default,Burn - Dugout,Burn - Joyful,Burn - River,Juke - Echidna,Juke - Feel,Juke - Brazil,King - Dead Inside,King - Carpark,King - President}>-Preset

@init
function psw_all(v) ( slider_show(2251799813685247, v); );
function psw_allg(v) ( slider_show(2251799813685247, v); );
#ui_man = "gfx-v4-tangent";
ext_noinit = 1;
BST_K = 0.17;  PHO_K = 0.65;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

NV = 12;  VS = 112;  VOX = 0;
MQ = 4096;  MQMAX = 1000;
VD = 2000;
LN = 65536;  VSZ = 8192;  VMK = 8191;
MH = LN + NV * VSZ;
LL = LN + 2 * NV * VSZ;
F_ON = 0;  F_NOTE = 1;  F_VEL = 2;  F_AGE = 3;  F_GATE = 4;  F_SUS = 5;  F_STEAL = 6;  F_FADE = 7;  F_PEND = 8;
F_PVEL = 9;  F_W = 10;  F_DR = 11;  F_LX = 12;  F_AX = 13;  F_AY = 14;  F_G = 15;  F_GT = 16;  F_S = 17;  F_ST = 18;
F_EXN = 19;  F_EXW = 20;  F_EXA = 21;  F_BARK = 22;  F_LVL = 23;  F_DU = 24;  F_DL = 25;  F_NU = 26;  F_NL = 27;
F_DET = 28;  F_RLN = 29;  F_KN = 30;  F_KNA = 31;  F_KNF = 32;  F_KNZ = 33;  F_KNZ2 = 34;  F_PK = 35;  F_EXP = 36;  F_EXD = 37;
F_STF = 44;  F_RD = 45;  F_RLS = 46;  F_AT = 47;
F_ATS = 48;  F_RPR = 51;  F_RPA = 52;  F_T = 53;  F_F = 54;  F_FD = 55;  F_LSG = 56;
LYR = 64;  LST = 12;  L_DR = 0;  L_LX = 1;  L_AX = 2;  L_AY = 3;  L_E = 4;  L_EI = 5;  L_ON = 6;  L_DT = 7;  L_S = 8;  L_G = 9;  L_GT = 10;
CHB = 700000;  CHN = 4096;
RVB = 720000;  RVN = 16384;  RVM = 16383;
SAB = RVB + 2 * RVN;
HX = 690000;
memset(VOX, 0, NV * VS);  memset(LN, 0, 6 * NV * VSZ);  memset(CHB, 0, 2 * CHN);  memset(RVB, 0, 2 * RVN + 512);  memset(HX, 0, NV * 40);

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function phc(f0, oct, sw) local(t) ( t = tan($pi * min(f0 * 2 ^ (phd_s * oct * sw), 0.45 * srate) / srate);  (t - 1) / (t + 1); );
function apx(x, a) instance(xi, yo) ( yo = a * x + xi - a * yo;  xi = x;  yo; );
function hsh(k, salt) local(v) ( v = sin(k * 12.9898 + salt * 78.233) * 43758.5453;  v - floor(v); );
function pd_fir(s, w) ( atan2(s * sin(w), 1 - s + s * cos(w)) / w; );
function pd_ap(a, w) ( (atan2(sin(w), a + cos(w)) - atan2(a * sin(w), 1 + a * cos(w))) / w; );
function bq_set(t, f, q, db) instance(b0, b1, b2, a1, a2) local(w, cw, sw, al, A, n, sa) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate;  cw = cos(w);  sw = sin(w);  al = sw / (2 * q);  A = 10 ^ (db / 40);
  t == 0 ? ( n = 1 + al;  b0 = (1 - cw) * 0.5 / n;  b1 = (1 - cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  t == 1 ? ( n = 1 + al;  b0 = (1 + cw) * 0.5 / n;  b1 = -(1 + cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  t == 2 ? ( n = 1 + al / A;  b0 = (1 + al * A) / n;  b1 = -2 * cw / n;  b2 = (1 - al * A) / n;  a1 = b1;  a2 = (1 - al / A) / n; ) :
  ( sa = 2 * sqrt(A) * al;  n = (A + 1) + (A - 1) * cw + sa;
    b0 = A * ((A + 1) - (A - 1) * cw + sa) / n;  b1 = 2 * A * ((A - 1) - (A + 1) * cw) / n;  b2 = A * ((A + 1) - (A - 1) * cw - sa) / n;
    a1 = -2 * ((A - 1) + (A + 1) * cw) / n;  a2 = ((A + 1) + (A - 1) * cw - sa) / n; );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1;  x1 = x;  y2 = y1;  y1 = y;  y;
);

ST_S0 = 0.12;
HOLD_T = 20;
LA_A = 0.55;  LA_T = 0.018;
LB_A = 0.45;  LB_C = 6;
LP_A = 0.4;   LP_C = 5;
LL_A = 0.35;  LL_C = 3;  LL_IN = 0.7;  LL_SET = 1.2;  LL_T = 1.2;
REL_ST = 3;
AT_ST = 0.3;
KN_K = 0.03;
PKN_K = 0.8;
function v_tune(b) local(n, f, w, sx, d) (
  n = b[F_NOTE] + bend + b[F_DET] + dr_tune + b[F_BARK] + AT_ST * b[F_ATS] - REL_ST * b[F_RD];
  f = 440 * 2 ^ ((n - 69) / 12);
  w = 2 * $pi * f / srate;
  sx = b[F_S];
  d = srate / f - st_r * pd_fir(sx, w * st_r) - pd_ap(b[F_STF], w);
  b[F_DR] = max(3, min(VSZ - 8, d));
  b[F_F] = f;  b[F_FD] = srate / f - d;
  b[F_DU] = b[F_DR] * max(0.04, min(0.45, 0.22 * 2 ^ ((b[F_NOTE] - 60) / 36)));
  b[F_DL] = b[F_DR] * max(0.025, min(0.3, 0.075 * 2 ^ ((b[F_NOTE] - 60) / 36)));
);
function v_stiff(n) ( vc_stiff * (n <= 51 ? 1.3 - 0.35 * max(0, n - 29) / 22 : 0.75 * 2 ^ (-(n - 52) / 22)); );
function v_s0(b) ( max(0.015, min(0.4, ST_S0 * vc_sm * 2 ^ (-(b[F_NOTE] - 60) / 20))); );
function st_sr(s) local(p) ( st_k == 1 ? s : ( p = min(0.25, s * (1 - s) * st_k);  0.5 * (1 - sqrt(1 - 4 * p)); ); );
function v_gain(b, t) ( 10 ^ (-3 * b[F_DR] / (srate * max(0.005, t))); );
function v_held_t60(b) local(t) (
  t = min(HOLD_T, 0.8 * HOLD_T * 2 ^ (-(b[F_NOTE] - 52) / 30));
  t * vc_dec * exp(-4.9 * (mute_s ^ 0.8));
);
function v_strike(b, vel) local(v, ve, wp) (
  v = vel / 127;
  ve = 1 - vs_t + vs_t * v ^ 1.2;
  wp = (1.7 - 1.5 * hard_t) * (1.45 - 0.9 * v * vs_t + 0.45 * (1 - vs_t)) * vc_tip;
  b[F_EXW] = max(2, floor(min(wp * 0.001 * srate, 0.7 * srate / (440 * 2 ^ ((b[F_NOTE] - 69) / 12)))));
  b[F_EXN] = b[F_EXW];  b[F_EXP] = 0;
  b[F_EXD] = floor(rand(1) * 0.0018 * srate * dm_a);
  b[F_EXA] = ve * 0.9 / sqrt(wp / 0.4) * b[F_EXW] / (wp * 0.001 * srate) * ((1.7 - 1.5 * hard_t) * vc_tip / 0.875) ^ 0.775;
  b[F_BARK] = 0.025 * v * v * (0.4 + hard_t) * vs_t;
  b[F_KN] = floor(0.012 * srate);  b[F_KNA] = KN_K * ve * kn_t;  b[F_KNF] = 1 - exp(-2 * $pi * (500 + rand(1) * 700) / srate);
  b[F_RPR] = 1 / (2 + rand(1));  b[F_RPA] = -(0.001 + rand(1) * 0.005);
);
function ln_clr(base, w, m) ( m = min(VSZ, m);  w >= m ? memset(base + w - m, 0, m) : ( memset(base, 0, w);  memset(base + VSZ - (m - w), 0, m - w); ); );
function l_env(b, k, t) local(x) (
  x = t / pa_w;
  k == 0 ? LA_A * la_k * exp(-t / LA_T) :
  k == 1 ? ( x < 1 ? LB_A * sin(0.5 * $pi * min(1, x / 0.2)) ^ 2 * (1 - x) ^ 1.5 : 0 ) :
  x < 1 ? LP_A * (1 - x) * (1 - x) : 0;
);
function l_tune(b, lb, c) (
  lb[L_DR] = max(3, min(VSZ - 8, (c == 0 ? srate / b[F_F] : srate / (b[F_F] * 2 ^ (c / 1200))) - b[F_FD] + st_r * (b[F_S] - lb[L_S])));
);
function l_start(b) local(k, lb, vi) (
  vi = (b - VOX) / VS;  k = 0;
  loop(4, lb = b + LYR + k * LST;
    lb[L_S] = k == 0 ? b[F_S] * 0.3 : b[F_S];
    !lb[L_ON] ? (
      ln_clr(LL + (k * NV + vi) * VSZ, b[F_W], ln_m);  lb[L_LX] = 0;  memset(HX + vi * 40 + 8 * (k + 1), 0, 8);  lb[L_AX] = 0;  lb[L_AY] = 0;  lb[L_ON] = 1;
      lb[L_E] = k == 3 ? 0 : l_env(b, k, 0);
      lb[L_GT] = k == 0 ? v_gain(b, 0.3) : k == 3 ? v_gain(b, v_held_t60(b) * LL_T) : b[F_GT];  lb[L_G] = lb[L_GT];
    );
    k == 3 ? lb[L_DT] = -b[F_LSG] * LL_C * l_dm;
    l_tune(b, lb, k == 0 ? 0 : k == 1 ? 0 : k == 2 ? b[F_LSG] * LP_C : lb[L_DT]);
    lb[L_EI] = 0;
    k += 1; );
);
function l_ctl(b, t, held) local(k, lb, tg, c) (
  k = 0;
  loop(4, lb = b + LYR + k * LST;
    lb[L_ON] ? (
      k == 3 ? (
        tg = lb[L_E] + (LL_A - lb[L_E]) * lg_in;
        lb[L_DT] *= lg_set;  c = lb[L_DT];
        lb[L_GT] = v_gain(b, held ? t * LL_T : t);
      ) : (
        tg = lb[L_E] + (l_env(b, k, b[F_T]) - lb[L_E]) * l_sl;
        c = k == 0 ? 0 : k == 1 ? -b[F_LSG] * LB_C * l_dm * sin($pi * min(1, b[F_T] / pa_w)) : b[F_LSG] * LP_C;
        lb[L_GT] = k == 0 ? v_gain(b, min(t, 0.3)) : b[F_GT];
        b[F_T] > (k == 0 ? 0.25 : pa_w) && lb[L_E] < 0.0005 ? ( lb[L_ON] = 0;  tg = 0;  lb[L_E] = 0; );
      );
      lb[L_S] = k == 0 ? b[F_S] * 0.3 : b[F_S];
      l_tune(b, lb, c);
      lb[L_EI] = (tg - lb[L_E]) / CR;  lb[L_G] = lb[L_GT];
    );
    k += 1; );
);
function v_start(b, note, vel) local(k, base) (
  base = LN + ((b - VOX) / VS) * VSZ;
  ln_m = floor(1.6 * srate / (440 * 2 ^ ((note - 69) / 12))) + 16;
  b[F_ON] && b[F_NOTE] == note ? 0 : ( b[F_W] = 0;  ln_clr(base, 0, ln_m);  ln_clr(base + NV * VSZ, 0, ln_m);  b[F_LX] = 0;  memset(HX + vi * 40, 0, 40);  b[F_AX] = 0;  b[F_AY] = 0;
    b[F_LVL] = 0;  b[F_ATS] = 0;  k = 0;  loop(4, b[LYR + k * LST + L_ON] = 0;  k += 1; ); );
  b[F_RD] = 0;  b[F_RLS] = 0;  b[F_AT] = 0;
  b[F_ON] = 1;  b[F_NOTE] = note;  b[F_VEL] = vel;  b[F_GATE] = 1;  b[F_SUS] = 0;
  age_n += 1;  b[F_AGE] = age_n;  b[F_FADE] = 1;  b[F_STEAL] = 0;  b[F_RLN] = 0;
  b[F_DET] = (hsh(note, 7) * 2 - 1) * 0.04 * dm_a;
  b[F_LSG] = hsh(note, 5) < 0.5 ? -1 : 1;
  b[F_T] = 0;
  b[F_STF] = v_stiff(note);
  b[F_S] = st_sr(v_s0(b) + 0.25 * mute_s);  b[F_ST] = b[F_S];
  v_strike(b, vel);
  v_tune(b);
  b[F_GT] = v_gain(b, v_held_t60(b));  b[F_G] = b[F_GT];
  l_start(b);
  ln_d = 1;
);
function v_alloc(note, vel) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? b[F_LVL] : 2 + b[F_AGE];
    b[F_ON] && b[F_NOTE] == note && !b[F_STEAL] ? q = -2;
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  b = VOX + best * VS;
  b[F_ON] && b[F_NOTE] != note && b[F_LVL] > 0.00002 ? ( b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel; ) : v_start(b, note, vel);
);
function v_damp(b) (
  b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_RLS] = 1;
  b[F_RLN] = b[F_EXW];  b[F_EXP] = 0;
  b[F_KN] = floor(0.01 * srate);  b[F_KNA] = 0.012 * kn_t;  b[F_KNF] = 0.06;
);
function v_release(note) local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_NOTE] == note ? ( sustain ? ( b[F_SUS] = 1;  b[F_GATE] = 0; ) : v_damp(b); );
    b[F_STEAL] && b[F_PEND] == note ? b[F_PEND] = -1;
    v += 1; );
);
function v_all_off() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_ON] && (b[F_GATE] || b[F_SUS]) ? v_damp(b);  v += 1; ); );
function v_pedal_up() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_SUS] ? v_damp(b);  v += 1; ); );
function midi_event(i) local(mst, d1, d2, c) (
  mst = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  mst == 0x90 && d2 > 0 ? v_alloc(d1, d2) :
  (mst == 0x80 || (mst == 0x90 && d2 == 0)) ? v_release(d1) :
  mst == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  mst == 0xD0 ? chan_at = d1 / 127 :
  mst == 0xA0 ? ( c = 0;  loop(NV, VOX[c * VS + F_ON] && VOX[c * VS + F_NOTE] == d1 ? VOX[c * VS + F_AT] = d2 / 127;  c += 1; ); ) :
  mst == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);
function v_ctl(b) local(t) (
  b[F_BARK] *= bark_c;
  b[F_ATS] += (max(b[F_AT], chan_at) - b[F_ATS]) * at_c;
  b[F_RLS] ? b[F_RD] += (1 - b[F_RD]) * rd_c;
  b[F_STF] += (v_stiff(b[F_NOTE]) - b[F_STF]) * 0.25;
  b[F_GATE] || b[F_SUS] ? (
    b[F_ST] = st_sr(v_s0(b) + 0.25 * mute_s);  t = v_held_t60(b);
  ) : (
    b[F_ST] = st_sr(0.42);  t = damp_t * (1 + 0.6 * max(0, 52 - b[F_NOTE]) / 24);
  );
  b[F_S] += (b[F_ST] - b[F_S]) * 0.25;
  v_tune(b);
  b[F_GT] = v_gain(b, t);
  b[F_T] += CR / srate;  l_ctl(b, t, b[F_GATE] || b[F_SUS]);
  !b[F_GATE] && !b[F_SUS] && !b[F_STEAL] && b[F_LVL] < 0.000003 && b[F_RLN] <= 0 ? b[F_ON] = 0;
  b[F_LVL] *= 0.7;
);
function v_run(b) local(vi, base, hy, lbs, lb, w, p, i, f, im, i1, i2, y, z, mx, lf, ap, e, ph, pu, pl, q, dq, g, ex, rp, stf, qx, x) (
  vi = (b - VOX) / VS;  base = LN + vi * VSZ;  hy = MH + vi * VSZ;  w = b[F_W];
  p = w - b[F_DR];  p < 0 ? p += VSZ;  i = floor(p);  f = p - i;
  im = (i - 1) & VMK;  i1 = (i + 1) & VMK;  i2 = (i + 2) & VMK;
  y = -f * (f - 1) * (f - 2) / 6 * base[im] + (f + 1) * (f - 1) * (f - 2) * 0.5 * base[i] - (f + 1) * f * (f - 2) * 0.5 * base[i1] + (f + 1) * f * (f - 1) / 6 * base[i2];
  rp = base[(w - floor(b[F_DR] * (1 - b[F_RPR]))) & VMK];
  qx = HX + vi * 40;
  st_r == 1 ? (
    lf = (1 - b[F_S]) * (y + b[F_RPA] * rp) + b[F_S] * b[F_LX];  b[F_LX] = y + b[F_RPA] * rp;
  ) : (
    x = y + b[F_RPA] * rp;  lf = (1 - b[F_S]) * x + b[F_S] * qx[(w + 8 - st_r) & 7];  qx[w & 7] = x;
  );
  ap = b[F_STF] * lf + b[F_AX] - b[F_STF] * b[F_AY];  b[F_AX] = lf;  b[F_AY] = ap;
  b[F_G] += (b[F_GT] - b[F_G]) * g_c;
  y = ap * b[F_G];
  ex = 0;
  b[F_EXD] > 0 ? b[F_EXD] -= 1 : b[F_EXN] > 0 ? (
    ph = b[F_EXP] / b[F_EXW];  e = 0.5 - 0.5 * cos(2 * $pi * ph);
    ex = b[F_EXA] * e * (1 + (rand(2) - 1) * 0.12);
    b[F_EXP] += 1;  b[F_EXN] -= 1;
  );
  b[F_RLN] > 0 ? (
    ph = b[F_EXP] / b[F_EXW];  e = 0.5 - 0.5 * cos(2 * $pi * ph);
    ex -= b[F_EXA] * e * 0.22 * (0.3 + 0.7 * kn_t);
    b[F_EXP] += 1;  b[F_RLN] -= 1;
  );
  y += ex;  base[w] = y;  mx = y;
  stf = b[F_STF];  lb = b + LYR;  lbs = LL + vi * VSZ;
  loop(4,
    lb[L_ON] ? (
      p = w - lb[L_DR];  p < 0 ? p += VSZ;  i = floor(p);  f = p - i;
      z = lbs[i] + (lbs[(i + 1) & VMK] - lbs[i]) * f;
      st_r == 1 ? (
        lf = (1 - lb[L_S]) * z + lb[L_S] * lb[L_LX];  lb[L_LX] = z;
      ) : (
        lf = (1 - lb[L_S]) * z + lb[L_S] * qx[8 + ((w + 8 - st_r) & 7)];  qx[8 + (w & 7)] = z;
      );
      ap = stf * lf + lb[L_AX] - stf * lb[L_AY];  lb[L_AX] = lf;  lb[L_AY] = ap;
      z = ap * lb[L_G] + ex;  lbs[w] = z;
      lb[L_E] += lb[L_EI];  mx += z * lb[L_E];
    );
    lb += LST;  lbs += NV * VSZ;  qx += 8;
  );
  hy[w] = mx;  w += 1;  w >= VSZ ? w = 0;  b[F_W] = w;
  q = w - 1 - b[F_DU];  q < 0 ? q += VSZ;  i = floor(q);  dq = q - i;  i1 = (i + 1) & VMK;
  pu = mx - (hy[i] + (hy[i1] - hy[i]) * dq);
  q = w - 1 - b[F_DL];  q < 0 ? q += VSZ;  i = floor(q);  dq = q - i;  i1 = (i + 1) & VMK;
  pl = mx - (hy[i] + (hy[i1] - hy[i]) * dq);
  pu = ts(pu * pkn_i) * pkn_x;  pu += pu * pu * PKN_K * 0.5;
  pl = ts(pl * pkn_i * 1.4) * pkn_x / 1.4;  pl += pl * pl * PKN_K * 0.7;
  g = b[F_FADE];
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? ( b[F_FADE] = 0;  b[F_STEAL] = 0;
      b[F_PEND] >= 0 ? v_start(b, b[F_PEND], b[F_PVEL]) : ( b[F_ON] = 0;  b[F_GATE] = 0; ); );
  );
  sx += (pu * pk_wu + pl * pk_wl) * g;
  b[F_LVL] = max(b[F_LVL], abs(mx));
  b[F_KN] > 0 ? (
    b[F_KN] -= 1;  b[F_KNA] *= kn_dc;
    b[F_KNZ] += ((rand(2) - 1) - b[F_KNZ]) * b[F_KNF];  b[F_KNZ2] += (b[F_KNZ] - b[F_KNZ2]) * b[F_KNF];
    kx += b[F_KNZ2] * b[F_KNA] * g;
  );
);

bend = 0;  chan_at = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  dr_tune = 0;  mw = 0;  mw_s = 0;
dw.drift_init(0.6 + rand(1) * 0.3);  dh.drift_init(0.4 + rand(1) * 0.3);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
os_design();  os_base = 0;  os_f = os_tf = os_f2n(os_sel);  os_gsetup();

function md_set() (
  vb_stiff = -0.12;  vb_sm = 1.5;  vb_dec = 1.15;  vb_tip = 1.35;  vb_pf = 3300;  vb_pq = 1.7;
  vj_stiff = -0.18;  vj_sm = 1.0;  vj_dec = 1.0;   vj_tip = 1.0;   vj_pf = 4300;  vj_pq = 1.3;
  vk_stiff = -0.28;  vk_sm = 0.7;  vk_dec = 0.7;   vk_tip = 0.75;  vk_pf = 6000;  vk_pq = 1.0;
  pkB.bq_set(0, vb_pf, vb_pq, 0);  pkJ.bq_set(0, vj_pf, vj_pq, 0);  pkK.bq_set(0, vk_pf, vk_pq, 0);
  eB1.bq_set(2, 420, 0.8, 2.5);  eB2.bq_set(0, 6000, 0.6, 0);
  eJ1.bq_set(2, 250, 0.9, 2);    eJ2.bq_set(0, 7500, 0.7, 0);
  eK1.bq_set(2, 3200, 1.0, 2);   eK2.bq_set(1, 90, 0.7, 0);
);
function amp_b(x) ( (ts(x * 1.6 + 0.1) - ts(0.1)) / 1.6; );
function amp_j(x) ( (ts(x * 2.6 + 0.15) - ts(0.15)) / 2.6 * 1.15; );
function amp_k(x) ( ts(x * 0.8) / 0.8; );
function osp(x) local(z, g, f, h) (
  z = (amp_b(x * MDL_H) * md_b + amp_j(x * MDL_H) * md_j) / MDL_H + amp_k(x) * md_k;
  m_dr > 0.0001 ? (
    g = ts(z * dg_s + 0.2) - ts(0.2);
    fz_lp += (z - fz_lp) * fz_c;  h = z - fz_lp;
    f = ts(h * df_s + 0.25) - ts(0.25);
    z += m_dr * ((g * dgm_s) * (1 - m_dt) + (f * dfm_s) * m_dt - z);
  );
  z;
);

function vsat(x) instance(x1, f1) local(fx, d, y, m) (
  fx = sqrt(1 + x * x) - 1;  d = x - x1;
  abs(d) > 0.00001 ? y = (fx - f1) / d : ( m = 0.5 * (x + x1);  y = m / sqrt(1 + m * m); );
  x1 = x;  f1 = fx;  y;
);
TS_C1 = 0.00000000025;  TS_C2 = 0.0000001;  TS_C3 = 0.000000047;
TS_R1 = 250000;  TS_R2 = 250000;  TS_R3 = 10000;  TS_R4 = 100000;
function tsk_an(t, m, l) local(Ka, Kb, Kc, Ra, Rb, Rc, Rd) (
  Ka = TS_C1;  Kb = TS_C2;  Kc = TS_C3;  Ra = TS_R1;  Rb = TS_R2;  Rc = TS_R3;  Rd = TS_R4;
  ts_b1 = t*Ka*Ra + m*Kc*Rc + l*(Ka*Rb + Kb*Rb) + (Ka*Rc + Kb*Rc);
  ts_b2 = t*(Ka*Kb*Ra*Rd + Ka*Kc*Ra*Rd) - m*m*(Ka*Kc*Rc*Rc + Kb*Kc*Rc*Rc) + m*(Ka*Kc*Ra*Rc + Ka*Kc*Rc*Rc + Kb*Kc*Rc*Rc)
        + l*(Ka*Kb*Ra*Rb + Ka*Kb*Rb*Rd + Ka*Kc*Rb*Rd) + l*m*(Ka*Kc*Rb*Rc + Kb*Kc*Rb*Rc) + (Ka*Kb*Ra*Rc + Ka*Kb*Rc*Rd + Ka*Kc*Rc*Rd);
  ts_b3 = l*m*(Ka*Kb*Kc*Ra*Rb*Rc + Ka*Kb*Kc*Rb*Rc*Rd) - m*m*(Ka*Kb*Kc*Ra*Rc*Rc + Ka*Kb*Kc*Rc*Rc*Rd)
        + m*(Ka*Kb*Kc*Ra*Rc*Rc + Ka*Kb*Kc*Rc*Rc*Rd) + t*Ka*Kb*Kc*Ra*Rc*Rd - t*m*Ka*Kb*Kc*Ra*Rc*Rd + t*l*Ka*Kb*Kc*Ra*Rb*Rd;
  ts_a1 = (Ka*Ra + Ka*Rc + Kb*Rc + Kb*Rd + Kc*Rd) + m*Kc*Rc + l*(Ka*Rb + Kb*Rb);
  ts_a2 = m*(Ka*Kc*Ra*Rc - Kb*Kc*Rc*Rd + Ka*Kc*Rc*Rc + Kb*Kc*Rc*Rc) + l*m*(Ka*Kc*Rb*Rc + Kb*Kc*Rb*Rc) - m*m*(Ka*Kc*Rc*Rc + Kb*Kc*Rc*Rc)
        + l*(Ka*Kb*Rb*Rd + Ka*Kb*Ra*Rb + Ka*Kc*Rb*Rd + Kb*Kc*Rb*Rd) + (Ka*Kb*Ra*Rd + Ka*Kc*Ra*Rd + Ka*Kb*Rc*Rd + Ka*Kb*Ra*Rc + Ka*Kc*Rc*Rd + Kb*Kc*Rc*Rd);
  ts_a3 = l*m*(Ka*Kb*Kc*Ra*Rb*Rc + Ka*Kb*Kc*Rb*Rc*Rd) - m*m*(Ka*Kb*Kc*Ra*Rc*Rc + Ka*Kb*Kc*Rc*Rc*Rd)
        + m*(Ka*Kb*Kc*Rc*Rc*Rd + Ka*Kb*Kc*Ra*Rc*Rc - Ka*Kb*Kc*Ra*Rc*Rd) + l*Ka*Kb*Kc*Ra*Rb*Rd + Ka*Kb*Kc*Ra*Rc*Rd;
);
function tsk_set(t, m, l) local(c, c2, c3, P0, P1, P2, P3, Q0, Q1, Q2, Q3) (
  tsk_an(t, m, l);  c = 2 * srate;  c2 = c * c;  c3 = c2 * c;
  P0 = ts_b1*c + ts_b2*c2 + ts_b3*c3;  P1 = ts_b1*c - ts_b2*c2 - 3*ts_b3*c3;  P2 = -ts_b1*c - ts_b2*c2 + 3*ts_b3*c3;  P3 = -ts_b1*c + ts_b2*c2 - ts_b3*c3;
  Q0 = 1 + ts_a1*c + ts_a2*c2 + ts_a3*c3;  Q1 = 3 + ts_a1*c - ts_a2*c2 - 3*ts_a3*c3;  Q2 = 3 - ts_a1*c - ts_a2*c2 + 3*ts_a3*c3;  Q3 = 1 - ts_a1*c + ts_a2*c2 - ts_a3*c3;
  tk_b0 = P0 / Q0;  tk_b1 = P1 / Q0;  tk_b2 = P2 / Q0;  tk_b3 = P3 / Q0;  tk_a1 = Q1 / Q0;  tk_a2 = Q2 / Q0;  tk_a3 = Q3 / Q0;
);
function tsk_mag(f) local(w, nr, ni, dr, di) (
  w = 2 * $pi * f;  nr = -ts_b2 * w * w;  ni = ts_b1 * w - ts_b3 * w * w * w;  dr = 1 - ts_a2 * w * w;  di = ts_a1 * w - ts_a3 * w * w * w;
  sqrt((nr * nr + ni * ni) / (dr * dr + di * di));
);
function tsk(x) instance(z1, z2, z3) local(y) (
  y = tk_b0 * x + z1;  z1 = tk_b1 * x - tk_a1 * y + z2;  z2 = tk_b2 * x - tk_a2 * y + z3;  z3 = tk_b3 * x - tk_a3 * y;  y;
);
function tk_l(b) ( exp((b - 1) * 3.4); );
function am_pre(x) instance(v1, v2, st, bz) local(a) (
  a = v1.vsat(x * AM_IN + 0.2) - AM_B1;
  a = st.tsk(a) * tk_mk;
  bz += (a - bz) * abr_c;  a += (a - bz) * abr_s;
  v2.vsat(a * AM_V2 + 0.15) - AM_B2;
);
function am_post(x, g) instance(pw, sg, c1, c2, c3, c4, c5) local(a, h) (
  h = AM_PA / (1 + 0.35 * sg);
  a = pw.vsat(x * g * h) / h;
  sg += (abs(a) - sg) * (abs(a) > sg ? asg_a : asg_r);
  c5.bq_run(c4.bq_run(c3.bq_run(c2.bq_run(c1.bq_run(a)))));
);
function cab_set() instance(c1, c2, c3, c4, c5) (
  c1.bq_set(1, 75, 0.7, 0);  c2.bq_set(2, 110, 1.1, 3);  c3.bq_set(2, 2400, 1.3, 3.5);  c4.bq_set(0, 5200, 0.8, 0);  c5.bq_set(0, 7600, 0.6, 0);
);
function spring(x, k) instance(n, lp, hz, w) local(s, u, j, bb, q, v) (
  s = RVB[k * RVN + ((w - n) & RVM)];  u = s;  j = 0;
  loop(6, bb = SAB + (k * 6 + j) * 32;  q = bb[(sa_w - sa_k) & 31];
    v = u - SA_A * q;  u = SA_A * v + q;  bb[sa_w & 31] = v;  j += 1; );
  lp += (u - lp) * rv_lc;  hz += (lp - hz) * rv_hc;
  RVB[k * RVN + w] = x + (lp - hz) * (k ? rv_f2 : rv_f1);  w = (w + 1) & RVM;
  s;
);
SA_A = 0.62;
AM_IN = 1.2;  AM_V2 = 0.6;  AM_B1 = 0.2 / sqrt(1.04);  AM_B2 = 0.15 / sqrt(1.0225);  AM_PA = 0.5;
AM_OUT = 0.393;
MDL_H = 0.15;  AMP_H = 0.15;  LV_G = -5.6;

function update_params() local(ws) (
  drift_macro(drift);  l_dm = 0.5 + 0.5 * dm_a;
  st_r = max(1, floor(srate / 48000 + 0.5));  st_k = (srate / (48000 * st_r)) ^ 2;
  sm_c = 1 - exp(-1 / (0.03 * srate));  sw_c = 1 - exp(-1 / (0.015 * srate));
  cc_c = 1 - exp(-CR / (0.03 * srate));  fc_c = 1 - exp(-CR / (0.004 * srate));  md_c = 1 - exp(-CR / (0.08 * srate));
  g_c = 1 - exp(-1 / (0.002 * srate));
  fade_step = 1 / (0.003 * srate);
  pa_w = pa_ms / 1000;  l_sl = 1 - exp(-CR / (0.003 * srate));
  lg_in = 1 - exp(-CR / (LL_IN * srate));  lg_set = exp(-CR / (LL_SET * srate));
  bark_c = exp(-CR / (0.025 * srate));
  at_c = 1 - exp(-CR / (0.02 * srate));  pkn_x = 0.9 / PKN_K;  pkn_i = 1 / pkn_x;  sxd_c = 1 - exp(-2 * $pi * 15 / srate);  rd_c = 1 - exp(-CR / (0.02 * srate));
  kn_dc = exp(-1 / (0.0025 * srate));
  hard_t = hard / 100;  vs_t = velsens / 100;  kn_t = knoise / 100;  la_k = 0.5 + hard_t;
  mute_t = 0.2281 + 0.7719 * mute / 100;
  damp_t = damp / 1000;
  out_t = 10 ^ ((vol + LV_G) / 20);
  pk_tu = pk_sel == 1 ? 0 : pk_sel == 0 ? 1.38 : pk_sel == 2 ? 0.62 : 0.87;
  pk_tl = pk_sel == 0 ? 0 : pk_sel == 1 ? 1.39 : pk_sel == 2 ? 1.0 : -1.77;
  ws = 2 * sin($pi * 700 / srate);  tilt_k = 1 / ws;
  md_set();
  tsf.bq_set(0, 900, 0.7, 0);
  tm1.bq_set(1, 300, 0.6, 0);  tm2.bq_set(0, 3500, 0.6, 0);
  ttr.bq_set(1, 650, 0.6, 0);
  tbr.bq_set(1, 1400, 0.6, 0);
  dcb_c = 1 - exp(-2 * $pi * 20 / srate);
  cp_thr_t = -16 - 22 * cp_sq / 100;  cp_rat_t = 1.5 + 6.5 * cp_sq / 100;  cp_bl_t = cp_bl / 100;
  cp_at = 1 - exp(-1 / (0.003 * srate));  cp_rl = exp(-1 / (0.12 * srate));
  ef_a = 1 - exp(-1 / (0.002 * srate));  ef_r = 1 - exp(-1 / (0.07 * srate));  mw_c = 1 - exp(-1 / (0.01 * srate));
  fs_t = 0.3 * 10 ^ (fl_sens / 100 * 1.6);  fp_t = fl_peak / 100;  fr_t = fl_rng / 100;  fpd_t = fl_ped / 100;
  dg_t = 1 + 24 * (dr_amt / 100) ^ 2;  dgm_t = 0.99 / dg_t ^ 1.03 + 0.08;
  df_t = 6 + 120 * (dr_amt / 100) ^ 1.5;  dfm_t = 0.16 * (0.52 + 0.89 * exp(-6 * dr_amt / 100));
  dt_c = 1 - exp(-2 * $pi * 1500 * 2 ^ (dr_tone / 100 * 3) / srate);
  os_tf = os_f2n(os_sel);
  fz_c = 1 - exp(-2 * $pi * 180 / (srate * os_f));
  ph_inc = ph_rate / srate;  phd_t = ph_dep / 100;  phf_t = ph_fb / 100;  phb_t = ph_bst / 100;
  bhp_c = 1 - exp(-2 * $pi * 350 / srate);
  ch_inc = ch_rate / srate;  chd_t = ch_dep / 100;  chm_t = ch_mix / 100;
  chl_c = 1 - exp(-2 * $pi * 7000 / srate);
  am_v = am_vol / 10;  avg_t = am_vol / 4;
  abr_t = am_bri >= 0.5 ? 1.6 * (1 - am_v) ^ 1.5 : 0;  abr_c = 1 - exp(-2 * $pi * 1200 / srate);
  asg_a = 1 - exp(-1 / (0.01 * srate));  asg_r = 1 - exp(-1 / (0.12 * srate));
  arv_t = (am_rev / 10) ^ 2 * 1.4;  adw_t = 0.6 + 2.4 * am_dwl / 10;
  rv_t = am_rtn / 10;  rv_tc = 1 - exp(-2 * $pi * 900 * 2 ^ (rv_t * 3.3) / srate);
  rv_hpc = 1 - exp(-2 * $pi * (40 + 260 * rv_t * rv_t) / srate);  rv_lsk = 0.5 * rv_t;  rv_lsc = 1 - exp(-2 * $pi * 250 / srate);
  av_inc = am_rate / srate;  avi_t = am_mod / 100;
  ldr_a = 1 - exp(-1 / (0.014 * srate));  ldr_r = 1 - exp(-1 / (0.045 * srate));
  avm_c = 1 - exp(-1 / (0.02 * srate));
  amL.cab_set();  amR.cab_set();
  !am_x0 ? ( amL.v1.x1 = amR.v1.x1 = 0.2;  amL.v1.f1 = amR.v1.f1 = sqrt(1.04) - 1;  amL.v2.x1 = amR.v2.x1 = 0.15;  amL.v2.f1 = amR.v2.f1 = sqrt(1.0225) - 1;  am_x0 = 1; );
  sa_k = max(1, min(31, floor(srate / 8600 + 0.5)));
  rv_lc = 1 - exp(-2 * $pi * 4500 / srate);  rv_hc = 1 - exp(-2 * $pi * 120 / srate);
  sp1.n = floor(0.0371 * srate);  sp2.n = floor(0.0433 * srate);
  rv_f1 = 10 ^ (-3 * sp1.n / (srate * (2 + 1.6 * am_dwl / 10)));  rv_f2 = 10 ^ (-3 * sp2.n / (srate * (2 + 1.6 * am_dwl / 10)));
);
update_params();
pk_wu = pk_tu;  pk_wl = pk_tl;  out_g = out_t;  mute_s = mute_t;
m_sf = t_soft;  m_md = t_med;  m_tr = t_treb;  m_br = t_bril;
md_b = model == 0;  md_j = model == 1;  md_k = model == 2;
m_cp = cp_on;  m_fl = fl_on;  m_dr = dr_on;  m_dt = dr_typ;  m_ph = ph_on;  m_ch = ch_on;
cp_thr = cp_thr_t;  cp_rat = cp_rat_t;  cp_bls = cp_bl_t;  fs_s = fs_t;  fp_s = fp_t;  fr_s = fr_t;  fpd_s = fpd_t;
dg_s = dg_t;  dgm_s = dgm_t;  df_s = df_t;  dfm_s = dfm_t;  phd_s = phd_t;  phf_s = phf_t;  phb_s = phb_t;  chd_s = chd_t;  chm_s = chm_t;
fl_lf = 0;  fl_g = 0.05;  ch_w = 0;  fl_lc = log(400);  m_wt = fl_typ >= 1.5;
m_am = am_on >= 0.5;  avg_s = avg_t;  abr_s = abr_t;  arv_s = arv_t;  adw_s = adw_t;  avi_s = avi_t;
tk_t = am_tre / 10;  tk_m = am_mid / 10;  tk_lb = am_bas / 10;  tsk_set(tk_t, tk_m, tk_l(tk_lb));
tsk_an(0.6, 0.5, tk_l(0.4));  tk_mk = 1 / tsk_mag(500);  tsk_set(tk_t, tk_m, tk_l(tk_lb));
sa_w = 0;  av_p = 0;  av_b1 = 0;  av_b2 = 0;  av_c1 = 0;

PL2 = 7.5;  PL3 = -0.4;  PL4 = 6.1;  PL5 = 4.2;  PL6 = 3.2;  PL7 = 2.7;  PL8 = -8.3;  PL9 = -10.3;  PL10 = 2.9;
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 2); pv(2, 0); pv(3, 0); pv(4, 0); pv(5, 0); pv(6, 0); pv(7, 55); pv(8, 70); pv(9, 30); pv(10, 70); pv(11, 50); pv(12, 0);
  pv(13, 1); pv(14, 0); pv(15, 40); pv(16, 100); pv(17, 0); pv(18, 0); pv(19, 60); pv(20, 55); pv(21, 60); pv(22, 30);
  pv(23, 0); pv(24, 0); pv(25, 40); pv(26, 60); pv(28, 0); pv(29, 0.4); pv(30, 60); pv(31, 40); pv(36, 50); pv(37, 400);
  pv(38, 1); pv(39, 0); pv(40, 4); pv(41, 6); pv(42, 5); pv(43, 4); pv(44, 2); pv(45, 5); pv(46, 6); pv(47, 0); pv(48, 4.5);
  pv(32, 0); pv(33, 0.6); pv(34, 50); pv(35, 50); pv(49, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (
    pv(13, 0); pv(1, 0); pv(3, 1); pv(7, 35); pv(6, 0); pv(17, 1); pv(19, 65); pv(20, 70); pv(21, 55); pv(28, 1); pv(29, 0.25); pv(30, 55); pv(31, 30); pv(39, 0); pv(40, 4); pv(41, 4); pv(42, 6); pv(43, 6); pv(44, 1.5); pv(45, 5); pv(46, 5); pv(47, 0); pv(48, 4.5); pv(11, 60); pv(12, PL2);
  );
  p == 3 ? (
    pv(13, 0); pv(4, 1); pv(14, 1); pv(15, 40); pv(17, 1); pv(19, 75); pv(20, 85); pv(21, 70); pv(39, 1); pv(40, 4); pv(41, 6); pv(42, 5); pv(43, 5); pv(44, 2); pv(45, 5); pv(46, 6); pv(47, 0); pv(48, 4.5); pv(11, 60); pv(12, PL3);
  );
  p == 4 ? (
    pv(13, 0); pv(1, 0); pv(7, 45); pv(28, 1); pv(29, 0.12); pv(30, 80); pv(31, 55); pv(32, 1); pv(35, 25); pv(39, 0); pv(40, 4); pv(41, 5); pv(42, 5); pv(43, 5); pv(44, 3); pv(45, 6); pv(46, 6); pv(47, 30); pv(48, 2.1); pv(11, 60); pv(12, PL4);
  );
  p == 5 ? (
    pv(13, 1); pv(17, 1); pv(18, 2); pv(22, 30); pv(20, 60); pv(21, 55); pv(23, 1); pv(25, 25); pv(14, 1); pv(15, 30); pv(39, 0); pv(40, 4); pv(41, 6); pv(42, 6); pv(43, 4); pv(44, 1.5); pv(45, 5); pv(46, 6); pv(47, 0); pv(48, 4.5); pv(11, 50); pv(12, PL5);
  );
  p == 6 ? (
    pv(13, 1); pv(3, 1); pv(32, 1); pv(33, 0.5); pv(34, 55); pv(35, 50); pv(14, 1); pv(15, 35); pv(23, 1); pv(25, 15); pv(39, 0); pv(40, 4); pv(41, 6); pv(42, 4); pv(43, 5); pv(44, 2.5); pv(45, 5); pv(46, 6); pv(47, 20); pv(48, 2.5); pv(11, 50); pv(12, PL6);
  );
  p == 7 ? (
    pv(13, 1); pv(1, 1); pv(4, 1); pv(23, 1); pv(25, 55); pv(26, 55); pv(14, 1); pv(15, 60); pv(16, 80); pv(39, 1); pv(40, 4); pv(41, 7); pv(42, 5); pv(43, 4); pv(44, 2); pv(45, 5); pv(46, 6); pv(47, 0); pv(48, 4.5); pv(11, 50); pv(12, PL7);
  );
  p == 8 ? (
    pv(13, 2); pv(1, 1); pv(5, 1); pv(7, 80); pv(6, 0); pv(14, 1); pv(15, 45); pv(28, 1); pv(29, 0.15); pv(30, 35); pv(31, 20); pv(36, 0);
    pv(39, 0); pv(40, 4); pv(41, 6); pv(42, 4); pv(43, 2); pv(44, 0); pv(45, 4); pv(46, 5); pv(47, 0); pv(48, 4.5); pv(11, 0); pv(12, PL8);
  );
  p == 9 ? (
    pv(13, 2); pv(1, 3); pv(4, 1); pv(7, 90); pv(6, 0); pv(14, 1); pv(15, 60); pv(16, 60); pv(28, 1); pv(29, 0.25); pv(30, 30); pv(31, 15); pv(36, 0);
    pv(39, 1); pv(40, 4); pv(41, 7); pv(42, 5); pv(43, 2); pv(44, 0); pv(45, 4); pv(46, 6); pv(47, 0); pv(48, 4.5); pv(11, 0); pv(12, PL9);
  );
  p == 10 ? (
    pv(13, 2); pv(1, 1); pv(7, 75); pv(6, 42); pv(8, 40); pv(14, 1); pv(15, 40);
    pv(17, 1); pv(19, 50); pv(20, 40); pv(21, 80); pv(28, 1); pv(29, 0.2); pv(30, 30); pv(31, 20); pv(36, 0);
    pv(39, 0); pv(40, 10); pv(41, 6); pv(42, 5); pv(43, 3); pv(44, 0); pv(45, 4); pv(46, 6); pv(47, 0); pv(48, 4.5); pv(11, 0); pv(12, PL10);
  );
  slider_automate(2 ^ 26 - 1);
  slider_automate(2 ^ 48 - 2 ^ 27);
  slider_automate(sat_amt);
  gui_dirty = 1;
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(50, i != 50 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

pwr_init();  pwr_hum_db = -76.5;  pwr_buzz = 0.5;  pwr_sag = 0.2;  pwr_rip = 0.003;
pwr_wu_loss = 0.6;  pwr_wu_drv = 1;  pwr_wu_lp = 9000;  pwr_wu_wob = 0.2;  pwr_bloom = 0;
rs_g = 1;  rs_inc = 1 / (0.015 * srate);
function gap_clr() (
  memset(VOX, 0, NV * VS);  memset(LN, 0, 6 * NV * VSZ);  memset(CHB, 0, 2 * CHN);  memset(RVB, 0, 2 * RVN + 512);  memset(HX, 0, NV * 40);
  ou.os_clr();  od.os_clr();  fl_1 = fl_2 = 0;  ph_zl = ph_zr = 0;  sustain = 0;  rs_g = 0;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update_params();
os_snap(slider(27));

@block
prs_chk();
rs_now = time_precise();
rs_tp > 0 && rs_now - rs_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? gap_clr();
rs_tp = rs_now;  rs_gpp = play_position;  rs_gpd = samplesblock / srate;
pn_dirty ? ( pn_dirty = 0;  sustain = 0;  v_all_off(); );
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);  (m_st & 0xF0) == 0x90 && m_d2 > 0 ? mi_led_d = 1;
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? v_all_off();  tp_was = tp_now;
prm_dirty ? ( prm_dirty = 0;  update_params(); );
bt = samplesblock / srate;
dr_tune = dw.drift_tick(0.08 * bt * dm_s) * 0.03 * dm_a;
hum_t = max(0, dh.drift_tick(0.05 * bt * dm_s)) * 0.0006 * dm_a;
sat_g += (sat_amt - sat_g) * min(1, samplesblock / (0.03 * srate));
ost_setup(sat_g / 100, 0.3, 120, 6000, -0.3, 1);
pdc_delay = os_lat(os_f);  pdc_bot_ch = 0;  pdc_top_ch = 2;
pwr_block(1);
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1)));  mn_ms = 0;  mn_pk_d = max(mn_pk_d, mn_pkm);  mn_pkm = 0;
os_snapb(slider(27));

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) (
  midi_event(mq_i);
  m_st = MQ[mq_i * 4 + 1] & 0xF0;  m_d1 = MQ[mq_i * 4 + 2];
  m_st == 0xB0 && (m_d1 == 1 || m_d1 == 11 || m_d1 == 4) ? mw = MQ[mq_i * 4 + 3] / 127;
  mq_i += 1;
);
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  mute_s += (mute_t - mute_s) * 0.1;
  m_am > 0.0001 && (abs(am_tre / 10 - tk_t) + abs(am_mid / 10 - tk_m) + abs(am_bas / 10 - tk_lb) > 0.0002) ? (
    tk_t += (am_tre / 10 - tk_t) * cc_c;  tk_m += (am_mid / 10 - tk_m) * cc_c;  tk_lb += (am_bas / 10 - tk_lb) * cc_c;
    tsk_set(tk_t, tk_m, tk_l(tk_lb));
  );
  md_b += ((model < 0.5) - md_b) * md_c;  md_j += ((model >= 0.5 && model < 1.5) - md_j) * md_c;  md_k += ((model >= 1.5) - md_k) * md_c;
  vc_stiff = vb_stiff * md_b + vj_stiff * md_j + vk_stiff * md_k;  vc_sm = vb_sm * md_b + vj_sm * md_j + vk_sm * md_k;
  vc_dec = vb_dec * md_b + vj_dec * md_j + vk_dec * md_k;  vc_tip = vb_tip * md_b + vj_tip * md_j + vk_tip * md_k;
  vb = VOX;  loop(NV, vb[F_ON] ? v_ctl(vb);  vb += VS; );
  cp_thr += (cp_thr_t - cp_thr) * cc_c;  cp_rat += (cp_rat_t - cp_rat) * cc_c;  cp_bls += (cp_bl_t - cp_bls) * cc_c;
  fs_s += (fs_t - fs_s) * cc_c;  fp_s += (fp_t - fp_s) * cc_c;  fr_s += (fr_t - fr_s) * cc_c;  fpd_s += (fpd_t - fpd_s) * cc_c;
  dg_s += (dg_t - dg_s) * cc_c;  dgm_s += (dgm_t - dgm_s) * cc_c;  df_s += (df_t - df_s) * cc_c;  dfm_s += (dfm_t - dfm_s) * cc_c;
  phd_s += (phd_t - phd_s) * cc_c;  phf_s += (phf_t - phf_s) * cc_c;  phb_s += (phb_t - phb_s) * cc_c;  chd_s += (chd_t - chd_s) * cc_c;  chm_s += (chm_t - chm_s) * cc_c;
  cp_mk = max(0, -cp_thr - 16) * (1 - 1 / cp_rat) * (0.6 + 0.22 * (-cp_thr - 16) / 22);
  fl_typ < 1.5 ? (
    fl_e = 1 - exp(-2.2 * fl_lf);
    fl_lo = 180;  fl_hi = 700 * 2 ^ (fr_s * 2.8);
    fl_fc = fl_typ < 0.5 ? fl_lo * (fl_hi / fl_lo) ^ fl_e : fl_hi * (fl_lo / fl_hi) ^ fl_e;
    fl_q = 0.8 + fp_s ^ 1.6 * 9;
  ) : (
    fl_pos = max(0, min(1, fpd_s + mw_s));
    fl_fc = 380 * (1200 * 2 ^ (fr_s * 1.5) / 380) ^ fl_pos;
    fl_q = 2 + fp_s * 6;
  );
  fl_lc += (log(fl_fc) - fl_lc) * fc_c;
  fl_gt = tan($pi * min(exp(fl_lc), 0.45 * srate) / srate);  fl_gi = (fl_gt - fl_g) / CR;
  fl_k = 1 / fl_q;
  ph_p += ph_inc * 0.45 * CR;  ph_p -= floor(ph_p);  ph_q += ph_inc * 0.7 * CR;  ph_q -= floor(ph_q);
  ph_ta_d = 1 - abs(2 * ph_p - 1);  ph_sa_d = 0.5 + 0.5 * sin(2 * $pi * ph_q);
  ph_al = phc(160, 4.2, ph_ta_d);  ph_ar = phc(160, 4.2, 1 - abs(2 * (ph_p + 0.25 - floor(ph_p + 0.25)) - 1));
  ph_bl = phc(240, 3.8, ph_sa_d);  ph_br = phc(240, 3.8, 0.5 + 0.5 * cos(2 * $pi * ph_q));
);
cr_n -= 1;

pk_wu += (pk_tu - pk_wu) * sw_c;  pk_wl += (pk_tl - pk_wl) * sw_c;  out_g += (out_t - out_g) * sm_c;
m_cp += ((cp_on >= 0.5) - m_cp) * sw_c;  m_fl += ((fl_on >= 0.5) - m_fl) * sw_c;  m_dr += ((dr_on >= 0.5) - m_dr) * sw_c;
m_dt += ((dr_typ >= 0.5) - m_dt) * sw_c;  m_ph += ((ph_on >= 0.5) - m_ph) * sw_c;  m_ch += ((ch_on >= 0.5) - m_ch) * sw_c;
mw_s += (mw - mw_s) * mw_c;

sx = 0;  kx = 0;  vb = VOX;
loop(NV, vb[F_ON] ? v_run(vb);  vb += VS; );

hum_ph += 50 / srate;  hum_ph -= floor(hum_ph);
sx += hum_t * (sin(2 * $pi * hum_ph) + 0.35 * sin(6 * $pi * hum_ph));
sxd += (sx - sxd) * sxd_c;  sx -= sxd;
y = sx + (sx - sx1) * tilt_k;  sx1 = sx;
y = pkB.bq_run(y) * md_b + pkJ.bq_run(y) * md_j + pkK.bq_run(y) * md_k;

m_sf += (t_soft - m_sf) * sw_c;  m_md += (t_med - m_md) * sw_c;  m_tr += (t_treb - m_tr) * sw_c;  m_br += (t_bril - m_br) * sw_c;
z = tsf.bq_run(y) * 1.55;  y += (z - y) * m_sf;
z = tm2.bq_run(tm1.bq_run(y)) * 1.15;  y += (z - y) * m_md;
z = ttr.bq_run(y) * 1.28;  y += (z - y) * m_tr;
z = tbr.bq_run(y) * 2.0;  y += (z - y) * m_br;
y = (y + kx) * 0.13;

a = abs(y);  cp_e = a > cp_e ? cp_e + (a - cp_e) * cp_at : cp_e * cp_rl;
m_cp > 0.0001 ? (
  t = 8.685889638065035 * log(cp_e + 0.0000001) - cp_thr;
  t = t <= -3 ? 0 : t >= 3 ? t : (t + 3) * (t + 3) / 12;
  t *= 1 - 1 / cp_rat;
  cp_grm = max(cp_grm, t * m_cp);
  g = 10 ^ ((cp_mk - t) / 20);
  y += m_cp * (y * (cp_bls * g + 1 - cp_bls) - y);
);

a = abs(y) * fs_s;  fl_lf += (a - fl_lf) * (a > fl_lf ? ef_a : ef_r);
fl_g += fl_gi;  cr_n == CR - 1 ? fl_g = fl_gt;
m_fl > 0.0001 ? (
  t = 1 / (1 + fl_g * (fl_g + fl_k));  g = fl_g * t;  f = fl_g * g;
  v3 = y - fl_2;  v1 = t * fl_1 + g * v3;  v2 = fl_2 + g * fl_1 + f * v3;
  fl_1 = 2 * v1 - fl_1;  fl_2 = 2 * v2 - fl_2;
  m_wt += ((fl_typ >= 1.5) - m_wt) * sw_c;
  z = (0.55 * v2 + 0.9 * fl_k * v1 * (1 + 0.15 / fl_k)) * (1 - m_wt) + (1.55 * fl_k * v1 * (1 + 0.1 / fl_k) + 0.2 * v2) * m_wt;
  y += m_fl * (z - y);
) : ( fl_1 = fl_2 = 0; );

pwr_in(y, y);  y = pwr_l;
os_gate();
os_chg ? ( ou.os_clr();  od.os_clr();  fz_c = 1 - exp(-2 * $pi * 180 / (srate * os_f));  fz_lp = 0; );
ou.os_up(y);
r0 = osp(ou.s0);  os_f > 1 ? ( r1 = osp(ou.s1);  os_f > 2 ? ( r2 = osp(ou.s2);  r3 = osp(ou.s3); ); );
y = od.os_dn(r0, r1, r2, r3) * os_g;
dtz += (y - dtz) * dt_c;  y += m_dr * (dtz - y);
y = eB2.bq_run(eB1.bq_run(y)) * md_b * 1.0 + eJ2.bq_run(eJ1.bq_run(y)) * md_j * 1.0 + eK2.bq_run(eK1.bq_run(y)) * md_k * 1.0;
dcz += (y - dcz) * dcb_c;  y -= dcz;

m_ph > 0.0001 ? (
  bhz += (y - bhz) * bhp_c;  h = (y - bhz) * (1 + 7 * phb_s);
  t = abs(h) - log(1 + abs(h));
  u = abs(h - bh1) > 0.00001 ? (t - bhF) / (h - bh1) : 0.5 * (h + bh1) / (1 + abs(0.5 * (h + bh1)));
  bh1 = h;  bhF = t;
  yb = y + phb_s * BST_K * u;
  xl = yb + ph_zl * phf_s * 0.85;  xr = yb + ph_zr * phf_s * 0.85;
  u = lb4.apx(lb3.apx(lb2.apx(lb1.apx(la4.apx(la3.apx(la2.apx(la1.apx(xl, ph_al), ph_al), ph_al), ph_al), ph_bl), ph_bl), ph_bl), ph_bl);
  v = rb4.apx(rb3.apx(rb2.apx(rb1.apx(ra4.apx(ra3.apx(ra2.apx(ra1.apx(xr, ph_ar), ph_ar), ph_ar), ph_ar), ph_br), ph_br), ph_br), ph_br);
  ph_zl = u;  ph_zr = v;
  yl = y + m_ph * ((yb + u) * PHO_K - y);  yr = y + m_ph * ((yb + v) * PHO_K - y);
) : ( yl = yr = y;  ph_zl = ph_zr = 0; );

CHB[ch_w] = yl;  CHB[CHN + ch_w] = yr;
m_ch > 0.0001 ? (
  ch_p += ch_inc;  ch_p -= floor(ch_p);  t = sin(2 * $pi * ch_p);
  d = (0.007 + 0.005 * chd_s * (0.5 + 0.5 * t)) * srate;
  p = ch_w - d;  p < 0 ? p += CHN;  i = floor(p);  f = p - i;  j = i + 1;  j >= CHN ? j = 0;
  wl = CHB[i] + (CHB[j] - CHB[i]) * f;
  d = (0.007 + 0.005 * chd_s * (0.5 - 0.5 * t)) * srate;
  p = ch_w - d;  p < 0 ? p += CHN;  i = floor(p);  f = p - i;  j = i + 1;  j >= CHN ? j = 0;
  wr = CHB[CHN + i] + (CHB[CHN + j] - CHB[CHN + i]) * f;
  chl += (wl - chl) * chl_c;  chr += (wr - chr) * chl_c;
  t = chm_s * m_ch;
  yl = (yl + chl * t) / (1 + 0.35 * t);  yr = (yr + chr * t) / (1 + 0.35 * t);
);
ch_w += 1;  ch_w >= CHN ? ch_w = 0;

m_am += ((am_on >= 0.5) - m_am) * sw_c;
m_am > 0.0001 ? (
  avg_s += (avg_t - avg_s) * sm_c;  abr_s += (abr_t - abr_s) * sm_c;
  arv_s += (arv_t - arv_s) * sm_c;  adw_s += (adw_t - adw_s) * sm_c;  avi_s += (avi_t - avi_s) * avm_c;
  u = amL.am_pre(yl * AMP_H) / AM_V2;  v = amR.am_pre(yr * AMP_H) / AM_V2;
  t = ts((u + v) * 0.5 * adw_s);
  t = rp4.apx(rp3.apx(rp2.apx(rp1.apx(t, 0.55), 0.55), 0.55), 0.55);
  sa_w += 1;
  wl = sp1.spring(t, 0);  wr = sp2.spring(t, 1);
  rl1 += (wl + 0.35 * wr - rl1) * rv_tc;  rl2 += (rl1 - rl2) * rv_tc;  rlh += (rl2 - rlh) * rv_hpc;
  rtl = rl2 - rlh;  rls += (rtl - rls) * rv_lsc;  rtl -= rv_lsk * rls;
  rr1 += (wr + 0.35 * wl - rr1) * rv_tc;  rr2 += (rr1 - rr2) * rv_tc;  rrh += (rr2 - rrh) * rv_hpc;
  rtr = rr2 - rrh;  rrs += (rtr - rrs) * rv_lsc;  rtr -= rv_lsk * rrs;
  t = arv_s / sqrt(adw_s);
  u += rtl * t;  v += rtr * t;
  av_p += av_inc;  av_p -= floor(av_p);
  d = 0.5 + 0.5 * sin(2 * $pi * av_p);
  av_b1 += (d - av_b1) * (d > av_b1 ? ldr_a : ldr_r);  av_b2 += ((1 - d) - av_b2) * ((1 - d) > av_b2 ? ldr_a : ldr_r);
  g = 1;  f = 1;
  avi_s > 0.000001 ? ( av_c1 = (av_b1 * av_b1) ^ 0.7;  g = f = 1 - avi_s * av_c1; ) :
  avi_s < -0.000001 ? ( av_c1 = (av_b1 * av_b1) ^ 0.7;  t = -avi_s;
    g = (1 - t * av_c1) * (1 + 0.3 * t);  f = (1 - t * (av_b2 * av_b2) ^ 0.7) * (1 + 0.3 * t); );
  u = amL.am_post(u, g) * AM_OUT * avg_s / AMP_H;  v = amR.am_post(v, f) * AM_OUT * avg_s / AMP_H;
  yl += m_am * (u - yl);  yr += m_am * (v - yr);
) : ( m_am = 0;  am_clr ? ( memset(RVB, 0, 2 * RVN + 512);  am_clr = 0; ); );
m_am > 0.5 ? am_clr = 1;

pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
rs_g < 1 ? rs_g = min(1, rs_g + rs_inc);
yl *= out_g * rs_g;  yr *= out_g * rs_g;
yl = ostL.ost_band(yl);  yr = ostR.ost_band(yr);
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
mn_ms += 0.5 * (yl * yl + yr * yr);  mn_pkm = max(mn_pkm, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
