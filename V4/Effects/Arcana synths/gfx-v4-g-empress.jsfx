mm_box(656, 135, 70, 22, pk_pitem("SINE|TRI|RAMP UP|RAMP DN|SQUARE", mg_tw + 1, #mg_twk)) ? mm_menu(sn(164), "Sine|Triangle|Ramp up|Ramp down|Square", 656, 159);
