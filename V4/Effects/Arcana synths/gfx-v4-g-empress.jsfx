  mg_ov = floor(slider(sn(4 + mg_b)) + 2.5);
  mm_box(mg_x + 48, 100, 66, 22, pk_pitem("OCT -2|OCT -1|OCT 0|OCT +1|OCT +2", mg_ov + 1, #mg_ok)) ? (
    strcpy(#mg_om, ""); mg_k = 0;
    loop(5, mg_k == mg_ov ? strcat(#mg_om, "!"); strcat(#mg_om, pk_pitem("-2 octaves|-1 octave|0|+1 octave|+2 octaves", mg_k + 1, #mg_ok)); mg_k < 4 ? strcat(#mg_om, "|"); mg_k += 1; );
    gfx_x = (mg_x + 48) * sc; gfx_y = 124 * sc; mg_k = gfx_showmenu(#mg_om); mg_k > 0 ? mg_setv(sn(4 + mg_b), mg_k - 3);
  );
  mm_kz = 0.85;
  mm_k(mg_x + 26, 154, sn(2 + mg_b), 0, 100, mg_c == 0 ? 80 : mg_c == 1 ? 60 : 70, 0, "LEVEL", "%.0f%%", mg_pc, 0);
  mm_k(mg_x + 82, 154, sn(mg_c == 2 ? 62 : 19 + mg_b), 0, 10, mg_c == 2 ? 0 : 5, 0, "KEY", "%.1f", mg_pc, 0);
  mm_k(mg_x + 26, 224, sn(mg_c == 2 ? 51 : 12 + mg_b), 20, 18000, mg_c == 0 ? 1500 : mg_c == 1 ? 2600 : 2200, 1, "CUTOFF", "%.0f Hz", mg_pc, 0);
  mm_k(mg_x + 82, 224, sn(mg_c == 2 ? 52 : 13 + mg_b), 0, 100, mg_c == 0 ? 15 : mg_c == 1 ? 10 : 25, 0, "RESO", "%.0f%%", mg_pc, 0);
  mm_k(mg_x + 26, 294, sn(mg_c == 2 ? 55 : 15 + mg_b), 0.001, mg_c == 2 ? 5 : 10, mg_c == 0 ? 0.6 : mg_c == 1 ? 0.9 : 0.003, 1, "ATTACK", "%.3f s", mg_pc, 0);
  mm_k(mg_x + 82, 294, sn(mg_c == 2 ? 58 : 18 + mg_b), 0.01, 15, mg_c == 0 ? 2.5 : mg_c == 1 ? 3 : 0.4, 1, "RELEASE", "%.2f s", mg_pc, 0);
  mm_kz = 0;
  slider(sn(1 + mg_b)) < 0.5 ? ( ui_cola(mk_sub, 0.5); mg_r(mg_x - 4, 98, 120, 236); );
  mg_c < 2 ? ( ui_cola(0x000000, 0.18); mg_r(mg_x + 118, 98, 1, 236); );
  mg_c += 1;
);

mm_sec(600, 68, 188, 272, "THE GARDEN");
