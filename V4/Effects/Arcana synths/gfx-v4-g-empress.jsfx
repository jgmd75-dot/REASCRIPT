mm_k(104, 154, sn(66), 0, 100, 50, 0, "TONE", "%.0f%%", 0xC8B4E4, 0);
mm_k(158, 154, sn(67), 100, 1500, 420, 1, "DECAY", "%.0f ms", 0xC8B4E4, 0);
mm_k(77, 224, sn(68), 40, 1000, 300, 1, "RELEASE", "%.0f ms", 0xC8B4E4, 0);
mm_k(131, 224, sn(69), 0, 100, 60, 0, "SHAPE", "%.0f%%", 0xC8B4E4, 0);
mm_kz = 0;
mm_well(28, 268, 152, 60);
mg_vx = 32; mg_vw = 144; mg_vb = 323; mg_vh = 50; mg_vwin = 1500;
mg_vdec = slider(sn(67)); mg_vrel = max(slider(sn(68)), 1); mg_vsh = 4 ^ ((slider(sn(69)) - 50) / 50);
mg_vkl = 0.15 + 0.85 * slider(sn(65)) / 100;
ui_cola(0xF4E6CA, 0.10); mg_r(mg_vx, mg_vb - mg_vh * 0.5, mg_vw, 1);
mg_i = 0;
loop(mg_vw,
  mg_vt = (mg_i + 0.5) / mg_vw * mg_vwin;
  mg_vk = mg_vkl * exp(-4.6 * mg_vt / max(mg_vdec, 1));
  ui_cola(0xD86A55, 0.55); mg_r(mg_vx + mg_i, mg_vb - mg_vk * mg_vh, 1, mg_vk * mg_vh);
  mg_ve = mg_vt < 3 ? 0.5 - 0.5 * cos($pi * mg_vt / 3) : ( mg_vu = (mg_vt - 3) / mg_vrel; mg_vu < 1 ? 1 - mg_vu ^ mg_vsh : 0 );
  mg_vp = 1 - 0.85 * mg_ve;
  mg_i == 0 ? mg_vq = mg_vp;
  ui_col(0xD9B45E); mg_r(mg_vx + mg_i, mg_vb - max(mg_vp, mg_vq) * mg_vh - 0.8, 1, abs(mg_vp - mg_vq) * mg_vh + 1.6); mg_vq = mg_vp;
  mg_i += 1;
);
slider(sn(63)) >= 0.5 && em_dt / srate * 1000 < mg_vwin ? ( ui_cola(0xF4E6CA, 0.8); mg_r(mg_vx + em_dt / srate * 1000 / mg_vwin * mg_vw, mg_vb - mg_vh, 1, mg_vh); );

mm_sec(204, 68, 384, 272, "THE THREE");
mg_shk0 = mg_shk; mg_shk = 1; mg_nh = 1;
ui_col(0x1A0C07); mg_rr(388, 72, 192, 23, 4);
ui_cola(0x000000, 0.6); mg_r(390, 72, 188, 2); mg_r(388, 74, 2, 19);
ui_cola(0xFFFFFF, 0.12); mg_r(390, 94, 189, 1); mg_r(579, 74, 1, 20);
