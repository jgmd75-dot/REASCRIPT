mm_box(730, 135, 48, 22, pk_pitem("1/16|1/8T|1/8|1/8D|1/4|1/4D|1/2|1 BAR", mg_tr + 1, #mg_trk)) ? mm_menu(sn(163), "1/16|1/8 triplet|1/8|1/8 dotted|1/4|1/4 dotted|1/2|1 bar", 730, 159);
mm_kz = 0.8;
mm_k(640, 188, sn(162), 0, 100, 0, 0, "TREM", "%.0f%%", 0xF6C8A0, 0);
mm_k(694, 188, sn(160), 0, 100, 100, 0, "AUTOPAN", "%.0f%%", 0xF2E08A, 0);
