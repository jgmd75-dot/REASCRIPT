loop(3,
  mm_key(393 + mg_c * 62, 76, 58, 16, slider(sn(1 + mg_c * 20)) >= 0.5, mk_amb, mg_c == 0 ? "OSC 1" : mg_c == 1 ? "OSC 2" : "OSC 3") ? mg_setv(sn(1 + mg_c * 20), slider(sn(1 + mg_c * 20)) < 0.5);
  mg_c += 1;
);
mg_shk = mg_shk0; mg_nh = 0;
mg_c = 0;
loop(3,
  mg_x = 216 + mg_c * 126; mg_b = mg_c * 20; mg_pc = mg_c == 0 ? 0xF4BE96 : mg_c == 1 ? 0xA8DCC0 : 0xA8C8EC;
