desc:Empress [Arcana synth] (GFX V4)
//tags: instrument synth polyphonic pad lead deep house sidechain pump chorus phaser autopan delay reverb arcana v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-drift, gfx-v4-output, gfx-v4-ui, gfx-v4-panel, gfx-v4-instrument, gfx-v4-s57, gfx-v4-power, gfx-v4-sliders (.jsfx-inc) in the same folder.

import gfx-v4-drift.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-instrument.jsfx-inc
import gfx-v4-s57.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-sliders.jsfx-inc

slider54:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
