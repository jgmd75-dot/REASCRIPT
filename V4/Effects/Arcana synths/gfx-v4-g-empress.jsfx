  mg_gt = ui_mix(mk_face, 0xFFFFFF, 0.22); mg_gb = ui_mix(mk_face, 0x000000, mk_gdk > 0 ? mk_gdk : 0.22);
  gfx_gradrect(0, 0, 900 * sc, 355 * sc, ((mg_gt >> 16) & 255) / 255, ((mg_gt >> 8) & 255) / 255, (mg_gt & 255) / 255, 1, 0, 0, 0, 0,
    ((((mg_gb >> 16) & 255) - ((mg_gt >> 16) & 255)) / 255) / (355 * sc), ((((mg_gb >> 8) & 255) - ((mg_gt >> 8) & 255)) / 255) / (355 * sc),
    (((mg_gb & 255) - (mg_gt & 255)) / 255) / (355 * sc), 0);
  ui_cola(0xFFFFFF, 0.10); mg_r(0, 0, 900, 1.5); mg_r(0, 0, 1.5, 355);
  ui_cola(0x000000, 0.30); mg_r(0, 352, 900, 3); mg_r(897, 0, 3, 355);
  mg_rivet(7, 7); mg_rivet(893, 7); mg_rivet(7, 348); mg_rivet(893, 348);
  ui_col(mk_band); mg_r(16, 6, 868, 50);
  ui_col(mk_tab); mg_r(16, 56, 868, 3);
);
function mm_top(title, sub, menu) (
  ui_col(0x1A1A1C); mg_disc(43, 31, 17); ui_col(mk_rring); mg_disc(43, 31, 15); ui_col(mk_rin); mg_disc(43, 31, 13);
  mg_i = 0; loop(3, ui_col(mg_i == 0 ? mk_rs1 : mg_i == 1 ? mk_rs2 : mk_rs3);
    mg_stripe(43, 31, 13.6, 18.8 + mg_i * 2.6, 1.6); mg_i += 1; );
  ui_col(mk_rring); mg_ring(43, 31, 13, 15);
  gfx_setfont(4); ui_col(0xF4F6F8); ui_ctext(43 * sc, 31.5 * sc, "GFX");
  gfx_setfont(14); ui_col(mk_hi); mg_ltxt(68, 25, title);
  gfx_setfont(11); ui_col(mk_sub2); mg_ltxt(70, 46, sub);
  pk_lcdstrip = 0;
  prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );
  mg_pk = pk_preset(398 * sc, 14 * sc, 320 * sc, 34 * sc, pr_cur, menu);
  mg_pk > 0 ? ( prs_dirty = mg_pk; pr_cur = mg_pk; );
  ui_cola(0x000000, 0.35); mg_rr(318, 19, 66, 26, 4);
  ui_col(0x2E2F34); mg_rr(319, 20, 64, 24, 4);
  pk_led(334 * sc, 32 * sc, 4 * sc, ins_midi_lit(), 0x3ADF6A);
  gfx_setfont(11); ui_col(0xC8C4BC); mg_ltxt(344, 32.5, "MIDI");
  mm_panic(732, 17, 80, 28) ? panic_d = 1;
  ui_size_picker(826 * sc, 22 * sc);
);
function mm_out() (
  mm_well(800, 68, 84, 272);
  gfx_setfont(12); ui_col(mk_otx); mg_ltxt(820, 84, "OUT");
  mm_pk_d ? ( mm_pkt = time_precise(); mm_pk_d = 0; );
  mg_pl = time_precise() - mm_pkt < 1.2;
  mg_in(846, 74, 22, 20) && pressed && drag_id == 0 ? ( drag_id = -1; mm_pkt = 0; mg_pl = 0; );
  ui_col(0x050506); mg_disc(857, 84, 6.2);
  ui_col(mg_pl ? 0xFF3A2A : 0x5A1410); mg_disc(857, 84, 4.4);
  mg_pl ? ( ui_cola(0xFF3A2A, 0.25); mg_disc(857, 84, 9); ui_cola(0xFFFFFF, 0.55); mg_disc(855.6, 82.6, 1.4); );
);
function mm_end() (
  pk_end();
  ui_help_xh = 262;
  ui_name_keys(); ui_help();
  ui_help_open ? ( mouse_x = ui_mx; mouse_y = ui_my;  pwr_panel(ui_help_cx + 30 * ui_help_s, ui_help_cy + 118 * ui_help_s, ui_help_s, 15, ui_help_clk, ui_mw); );
ui_help_open ? ( psw_gt = psw_row(ui_help_cx + ui_help_cw * 0.5, ui_help_cy + 290 * ui_help_s, ui_help_s, 15, ui_help_clk, psw_view >= 0.5); psw_gt >= 0 ? ( psw_view = psw_gt; psw_allg(psw_gt); slider_automate(psw_view); ); );
  prev_down = mdown; mouse_wheel = 0;
);

function sn(o) ( PVN[o]; );

mk_face = 0xA8553A; mk_sub = 0xB3634A; mk_seam = 0x6E3020; mk_band = 0x4E2416; mk_tab = 0xD9B45E;
