        ui_cola(c, 0.22); mg_disc(cx, cy, 5.2); ui_col(c); mg_disc(cx, cy, 2.8); ui_cola(0xFFFFFF, 0.5); mg_disc(cx - 0.9, cy - 0.9, 0.9);
      ) : ( ui_col(ui_mix(c, 0x101214, 0.78)); mg_disc(cx, cy, 2.8); );
