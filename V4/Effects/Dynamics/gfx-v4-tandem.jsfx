    drag_id = -1; mg_hl = mg_hr = -60; mg_pkt = 0; mg_pon = 0; );
  p = (h - 40) / 15;
  col = 0; loop(2,
    lv = col ? mg_dr : mg_dl; hd = col ? mg_hr : mg_hl; cx = x + w * 0.5 + (col ? 10 : -10);
    gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(cx, y + 13, col ? "R" : "L");
