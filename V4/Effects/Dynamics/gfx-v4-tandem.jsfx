desc:Tandem [series comp + EQ] (GFX V4)
//tags: compressor rms soft-knee vca series program eq parallel stereo v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-drift, gfx-v4-ui, gfx-v4-panel, gfx-v4-os, gfx-v4-bypass, gfx-v4-power, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider26:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:thr1=-24<-60,0,0.1>-Stage 1 threshold (dB)
slider3:rat1=0.33<0,2,0.01>-Stage 1 compression (0 = 1:1, 1 = inf:1, 2 = -1:1)
slider4:hard1=0<0,1,1{Soft,Hard}>-Stage 1 knee
slider5:dec1=0<0,1,1{Linked,Decoupled}>-Stage 1 decouple
slider6:thr2=-12<-60,0,0.1>-Stage 2 threshold (dB)
slider7:rat2=0.75<0,2,0.01>-Stage 2 compression (0 = 1:1, 1 = inf:1, 2 = -1:1)
slider8:hard2=0<0,1,1{Soft,Hard}>-Stage 2 knee
slider9:grit=0<0,1,1{Off,On}>-Stage 2 grit
slider10:eq_lo=0<-10,10,0.1>-EQ low (boost / atten)
slider11:eq_mid=0<-12,12,0.1>-EQ mid (dB)
slider12:eq_hi=0<-10,10,0.1>-EQ high (boost / atten)
slider13:eq_in=1<0,1,1{Out,In}>-EQ
slider14:eq_first=0<0,1,1{Comp then EQ,EQ then Comp}>-Order
slider15:sc_hz=0<0,400,1>-Sidechain HPF (Hz, below 20 = off)
slider16:mix_pc=100<0,100,1>-Mix (%)
slider17:out_db=0<-20,20,0.1>-Output (dB)
slider18:drift_pc=50<0,100,1>-Drift (%)
slider19:os_sl=0<0,2,1{1x,2x,4x}>-Oversampling
slider20:out1=0<-20,20,0.1>-Stage 1 output (dB)
slider21:out2=0<-20,20,0.1>-Stage 2 output (dB)
slider22:mid_f=2200<220,9900,1>-EQ mid frequency (Hz)
slider23:in1=1<0,1,1{Out,In}>-Stage 1
slider24:in2=1<0,1,1{Out,In}>-Stage 2
slider25:prs_sel=0<0,11,1{No preset,Init,Gentle Glue,Vocal Leveller,Vocal Upfront,Drum Bus Stack,Parallel Crush,Bass Even,Acoustic Guitar,Peak Catcher,Negative Pump,Reverse Swell}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-drift.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(67108863, v); );
function psw_allg(v) ( slider_show(67108863, v); );
#ui_man = "gfx-v4-tandem";
ext_noinit = 1;

KNEE = 10;
CR = 32;

function tm_db(d) ( exp(d * 0.11512925464970228); );
function tm_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function tm_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );

function hp_set(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function hp_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  sc_on ? (
    y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
    x2 = x1; x1 = x; y2 = tm_tn(y1); y1 = y;
  ) : ( x1 = x2 = y1 = y2 = 0; y = x; );
  y;
);
function hp_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function st_set(t, c, h, d) instance(thr, cc, kn, dec) ( thr = t; cc = c; kn = h >= 0.5 ? 0 : KNEE; dec = d >= 0.5; );
function st_gain(lv) instance(thr, cc, kn) local(o, f) (
  o = lv - thr;
  f = kn > 0 ? ( o <= -kn * 0.5 ? 0 : o >= kn * 0.5 ? o : sqr(o + kn * 0.5) / (2 * kn) ) : max(o, 0);
  max(-cc * f, -60);
);
function st_smooth(t, e) local(d) (
  t < e ? ( d = e - t; e + (t - e) * min(1, max(d, 5) / (0.15 * srate)); ) : min(t, e + rel_step);
);
function st_det(kl, kr) instance(dec, msL, msR, eL, eR, gL, gR, grm, lvm) local(lvL, lvR, lvK, tK, tL, tR) (
  msL += (kl * kl - msL) * rms_c; msR += (kr * kr - msR) * rms_c;
  msL = tm_tn(msL); msR = tm_tn(msR);
  lvK = 10 * log10(0.5 * (msL + msR) + 0.0000000001);
  lvm = lvK;
  tK = this.st_gain(lvK);
  dec ? (
    lvL = 10 * log10(msL + 0.0000000001); lvR = 10 * log10(msR + 0.0000000001);
    tL = 0.8 * this.st_gain(lvL) + 0.2 * tK; tR = 0.8 * this.st_gain(lvR) + 0.2 * tK;
  ) : ( tL = tK; tR = tK; );
  eL = st_smooth(tL, eL); eR = st_smooth(tR, eR);
  grm = min(grm, min(eL, eR));
  gL = tm_db(eL); gR = tm_db(eR);
);
function st_clr() instance(msL, msR, eL, eR, gL, gR) ( msL = msR = eL = eR = 0; gL = gR = 1; );

function grit_run(x, gred) instance(dcx, dcy) local(u, k2, y) (
  k2 = 0.10 + 0.012 * min(-gred, 20);
  u = min(max(x * 1.6, -1.5), 1.5);
  y = (u + k2 * u * u - 0.06 * u * u * u) / 1.6;
  dcy = y - dcx + gdc_c * dcy; dcx = y;
  dcy = tm_tn(dcy);
  dcy;
);
function grit_clr() instance(dcx, dcy) ( dcx = dcy = 0; );

function bq_set(type, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, eq_fs * 0.45) / eq_fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * q);
  amp = 10 ^ (gdb / 40);
  type == 2 ? (
    n = 1 + al / amp; b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = b1; a2 = (1 - al / amp) / n;
  ) : type == 3 ? (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n; b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n; a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;
    a2 = ((amp + 1) - (amp - 1) * cw - sa) / n;
  ) : (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n; b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n; a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;
    a2 = ((amp + 1) + (amp - 1) * cw - sa) / n;
  );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = tm_tn(y1); y1 = y;
  y;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function xf_run(x, k) instance(ph, sp) local(s, y) (
  x = min(max(x, -1.2), 1.2);
  ph = ph * xf_lk + x * xf_c;
  ph = min(max(ph, -4), 4);
  s = tm_tanh(ph * k) / k;
  y = (s - sp * xf_lk) / xf_c;
  sp = s;
  y;
);
function xf_clr() instance(ph, sp) ( ph = sp = 0; );

LO_F = 60; LT_F = 150; HT_F = 4400; HB_F = 10000; HA_F = 10000; MID_Q = 0.5; HB_Q = 2.5 * 0.16 ^ 0.5;
K_IN = 0.25 * 10 ^ 0.3; K_OUT = 0.25 * 10 ^ 0.3;

function eq_set(fm, gm) instance(lb, la, lt, m2, hb, ha, ht) (
  lb.bq_set(4, LO_F * fm, 1.1, eq_s * lb_s * gm);
  la.bq_set(4, LO_F * fm, 0.3, -eq_s * la_s * gm);
  lt.bq_set(2, LT_F * fm, 1.0, eq_s * (0.4 * la_s - 0.18 * lb_s) * gm);
  m2.bq_set(2, exp(mf_s) * fm, MID_Q * (1 + abs(md_s) / 4), eq_s * md_s * gm);
  ht.bq_set(2, HT_F * fm, 1.0, eq_s * (0.2 * ha_s - 0.3 * hb_s) * gm);
  hb.bq_set(2, HB_F * fm, HB_Q, eq_s * hb_s * gm);
  ha.bq_set(3, HA_F * fm, 0.6, -eq_s * ha_s * gm);
);
function eq_run(x) instance(lb, la, lt, m2, hb, ha, ht) ( ht.bq_run(ha.bq_run(hb.bq_run(m2.bq_run(lt.bq_run(la.bq_run(lb.bq_run(x))))))); );
function eq_clr() instance(lb, la, lt, m2, hb, ha, ht) ( lb.bq_clr(); la.bq_clr(); lt.bq_clr(); m2.bq_clr(); hb.bq_clr(); ha.bq_clr(); ht.bq_clr(); );

function tm_eq(l, r) (
  l = min(max(l, -1), 1); r = min(max(r, -1), 1);
  l = XIL.xf_run(l, K_IN); r = XIR.xf_run(r, K_IN);
  l = EQL.eq_run(l); r = EQR.eq_run(r);
  l = XOL.xf_run(l, K_OUT); r = XOR.xf_run(r, K_OUT);
  eq_l = min(max(l, -2), 2); eq_r = min(max(r, -2), 2);
);

function tm_chain(l, r, det) local(dl, dr, a, b, ga, gb) (
  ord_c ? ( tm_eq(l, r); l = eq_l; r = eq_r; );
  dl = l; dr = r;
  det ? STA.st_det(H1L.hp_run(l), H1R.hp_run(r));
  a = l * (1 + (STA.gL * o1_s - 1) * i1_s); b = r * (1 + (STA.gR * o1_s - 1) * i1_s);
  det ? STB.st_det(H2L.hp_run(a), H2R.hp_run(b));
  a *= 1 + (STB.gL * o2_s - 1) * i2_s; b *= 1 + (STB.gR * o2_s - 1) * i2_s;
  grit_s * i2_s > 0.0001 ? (
    ga = GTL.grit_run(a, STB.eL); gb = GTR.grit_run(b, STB.eR);
    a += (ga - a) * grit_s * i2_s; b += (gb - b) * grit_s * i2_s;
  );
  a = dl + (a - dl) * mix_s; b = dr + (b - dr) * mix_s;
  !ord_c ? ( tm_eq(a, b); a = eq_l; b = eq_r; );
  ch_l = a; ch_r = b;
);

function tm_rate() (
  tm_sr = srate;
  rms_c = 1 - exp(-1 / (0.008 * srate));
  rel_step = 120 / srate;
  c_kn = 1 - exp(-1 / (0.03 * srate));
  c_sw = 1 - exp(-1 / (0.012 * srate));
  ord_gc = 1 / (0.005 * srate);
  rs_c = 1 / (0.015 * srate);
  idc_c = 1 - 2 * $pi / srate;
);
function tm_fsc() (
  eq_fs = srate * os_f;
  xf_c = 2 * $pi * 40 / eq_fs; xf_lk = 1 - 2 * $pi * 5 / eq_fs;
  gdc_c = 1 - 2 * $pi * 3.8 / eq_fs;
);
function tm_coefs() (
  tm_fsc();
  EQL.eq_set(1 + 0.015 * d_amt * d_fl, 1 + 0.03 * d_amt * d_gl);
  EQR.eq_set(1 + 0.015 * d_amt * d_fr, 1 + 0.03 * d_amt * d_gr);
);
function tm_osclr() (
  XIL.xf_clr(); XIR.xf_clr(); XOL.xf_clr(); XOR.xf_clr(); EQL.eq_clr(); EQR.eq_clr(); GTL.grit_clr(); GTR.grit_clr();
);
function tm_params() (
  STA.st_set(thr1, rat1, hard1, dec1); STB.st_set(thr2, rat2, hard2, 0);
  sc_on = sc_hz >= 20;
  sc_on ? ( H1L.hp_set(sc_hz); H1R.hp_set(sc_hz); H2L.hp_set(sc_hz); H2R.hp_set(sc_hz); );
  mix_t = mix_pc / 100; out_t = tm_db(out_db); o1_t = tm_db(out1); o2_t = tm_db(out2);
  lb_t = eq_lo > 0 ? eq_lo * 1.4 : 0; la_t = eq_lo < 0 ? -eq_lo * 1.3 : 0;
  hb_t = eq_hi > 0 ? eq_hi * 1.6 : 0; ha_t = eq_hi < 0 ? -eq_hi * 1.6 : 0;
  md_t = eq_mid; mf_t = log(min(max(mid_f, 220), 9900));
  os_tf = os_f2n(os_sl);
  drift_macro(drift_pc); d_amt = 0.25 * dm_a; d_spd = 0.25 * dm_s;
);
function tm_snapv() (
  mix_s = mix_t; out_s = out_t; o1_s = o1_t; o2_s = o2_t; grit_s = grit >= 0.5; i1_s = in1 >= 0.5; i2_s = in2 >= 0.5;
  lb_s = lb_t; la_s = la_t; hb_s = hb_t; ha_s = ha_t; md_s = md_t; mf_s = mf_t; eq_s = eq_in >= 0.5;
  ord_c = eq_first >= 0.5; ord_g = 1;
);
function tm_reset() (
  OSU.os_clr(); OSD.os_clr(); OSUB.os_clr(); OSDB.os_clr(); tm_osclr();
  STA.st_clr(); STB.st_clr(); H1L.hp_clr(); H1R.hp_clr(); H2L.hp_clr(); H2R.hp_clr();
  idx_l = idy_l = idx_r = idy_r = 0;
  memset(BY_BUF, 0, 2 * BY_N);
  rs_f = 0;
);

tm_params();
tm_rate();
os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
os_gsetup();
tm_snapv();
DFL.drift_init(0.8 + rand(1) * 0.5); DFR.drift_init(0.8 + rand(1) * 0.5);
DGL.drift_init(0.8 + rand(1) * 0.5); DGR.drift_init(0.8 + rand(1) * 0.5);
d_fl = d_fr = d_gl = d_gr = 0;
tm_coefs(); tm_osclr();
STA.st_clr(); STB.st_clr();
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.12; pwr_wu_loss = 0.4; pwr_wu_drv = 0.8; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;
rs_f = 1; tm_snap = 1; tm_blk = 0;
pdc_delay = os_lat(os_f);
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
tm_g1_d = tm_g2_d = 0;

function tm_set(t1, c1, o1, h1, d1, t2, c2, o2, h2, gt, hp, mx) (
  out1 = o1; out2 = o2; out_db = 0; in1 = in2 = 1; thr1 = t1; rat1 = c1; hard1 = h1; dec1 = d1; thr2 = t2; rat2 = c2; hard2 = h2; grit = gt; sc_hz = hp; mix_pc = mx;
);
function load_preset(p) local(i) (
  p == 2  ? tm_set(-24, 0.33, 1, 0, 0, -14, 0.5,  1, 0, 0, 0,   100) :
  p == 3  ? tm_set(-30, 0.5,  3, 0, 0, -16, 0.8,  2, 0, 0, 80,  100) :
  p == 4  ? tm_set(-32, 0.67, 3, 0, 0, -18, 0.9,  2, 1, 1, 100, 100) :
  p == 5  ? tm_set(-26, 0.67, 3, 0, 1, -16, 0.75, 2, 0, 1, 80,  70) :
  p == 6  ? tm_set(-40, 0.9,  8, 0, 0, -24, 1,    6, 1, 1, 60,  35) :
  p == 7  ? tm_set(-28, 0.6,  3, 0, 0, -18, 0.8,  2, 0, 1, 0,   100) :
  p == 8  ? tm_set(-26, 0.4,  2, 0, 1, -16, 0.6,  1, 0, 0, 90,  100) :
  p == 9  ? tm_set(-20, 0.5,  2, 0, 0, -6,  1,    0, 1, 0, 40,  100) :
  p == 10 ? tm_set(-30, 0.5,  3, 0, 0, -30, 1.6,  6, 0, 0, 120, 60) :
  p == 11 ? tm_set(-24, 0,    0, 0, 0, -36, 2,    9, 0, 0, 0,   50) :
  (
    tm_set(-24, 0.33, 0, 0, 0, -12, 0.75, 0, 0, 0, 0, 100);
    eq_lo = eq_mid = eq_hi = 0; mid_f = 2200; eq_in = 1; eq_first = 0; drift_pc = 50;
  );
  p == 12 ? os_sl = 0;
  i = 2; loop(23, i != 19 ? ui_auto(i); i += 1; ); p == 12 ? ui_auto(19);
  pr_cur = p == 12 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(24, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 11 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
tm_params();
os_snap(os_sl);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && tm_blk < 40 ? tm_snap = 1;
pwr_ser();

@block
prs_chk();
tm_blk < 40 ? tm_blk += 1;
srate != tm_sr ? ( tm_rate(); tm_reset(); );
tm_params();
pwr_block(byp < 0.5);
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? tm_reset();
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
tm_snap ? ( tm_snap = 0; tm_snapv(); );
bs = 1 - exp(-samplesblock / (0.03 * srate));
lb_s += (lb_t - lb_s) * bs; la_s += (la_t - la_s) * bs; hb_s += (hb_t - hb_s) * bs; ha_s += (ha_t - ha_s) * bs;
md_s += (md_t - md_s) * bs; mf_s += (mf_t - mf_s) * bs; eq_s += ((eq_in >= 0.5) - eq_s) * bs;
d_inc = d_spd * samplesblock / srate;
d_fl = DFL.drift_tick(d_inc); d_fr = DFR.drift_tick(d_inc);
d_gl = DGL.drift_tick(d_inc); d_gr = DGR.drift_tick(d_inc);
tm_coefs();
tm_g1_d = min(tm_g1_d, in1 >= 0.5 ? STA.grm : 0); STA.grm = 0;
tm_g2_d = min(tm_g2_d, in2 >= 0.5 ? STB.grm : 0); STB.grm = 0;
tm_lv1_d = STA.lvm;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
tm_ml_d = max(tm_ml_d, tm_pkl); tm_mr_d = max(tm_mr_d, tm_pkr); tm_pkl = tm_pkr = 0;
os_snapb(os_sl);

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
mix_s += (mix_t - mix_s) * c_kn; out_s += (out_t - out_s) * c_kn;
o1_s += (o1_t - o1_s) * c_kn; o2_s += (o2_t - o2_s) * c_kn;
grit_s += ((grit >= 0.5) - grit_s) * c_sw;
i1_s += ((in1 >= 0.5) - i1_s) * c_sw; i2_s += ((in2 >= 0.5) - i2_s) * c_sw;
(eq_first >= 0.5) != ord_c ? (
  ord_g = max(ord_g - ord_gc, 0);
  ord_g == 0 ? ( ord_c = eq_first >= 0.5; );
) : ord_g < 1 ? ord_g = min(ord_g + ord_gc, 1);

x = spl0 - idx_l + idc_c * idy_l; idx_l = spl0; idy_l = tm_tn(x);
xb = spl1 - idx_r + idc_c * idy_r; idx_r = spl1; idy_r = tm_tn(xb);
pwr_in(x, xb); x = pwr_l; xb = pwr_r;
os_gate();
os_chg ? ( tm_coefs(); tm_osclr(); );
OSU.os_up(x); OSUB.os_up(xb);
os_f == 1 ? ( tm_chain(OSU.s0, OSUB.s0, 1); y = ch_l; yb = ch_r; ) :
os_f == 2 ? (
  tm_chain(OSU.s0, OSUB.s0, 1); a0 = ch_l; b0 = ch_r;
  tm_chain(OSU.s1, OSUB.s1, 0); a1 = ch_l; b1 = ch_r;
  y = OSD.os_dn(a0, a1, 0, 0); yb = OSDB.os_dn(b0, b1, 0, 0);
) : (
  tm_chain(OSU.s0, OSUB.s0, 1); a0 = ch_l; b0 = ch_r;
  tm_chain(OSU.s1, OSUB.s1, 0); a1 = ch_l; b1 = ch_r;
  tm_chain(OSU.s2, OSUB.s2, 0); a2 = ch_l; b2 = ch_r;
  tm_chain(OSU.s3, OSUB.s3, 0); a3 = ch_l; b3 = ch_r;
  y = OSD.os_dn(a0, a1, a2, a3); yb = OSDB.os_dn(b0, b1, b2, b3);
);
pwr_out(y, yb);
oa = pwr_l * out_s; ob = pwr_r * out_s;
ord_g < 1 ? ( ord_w = ord_g * ord_g * (3 - 2 * ord_g); oa *= ord_w; ob *= ord_w; );
os_q = os_g * os_g * (3 - 2 * os_g); oa *= os_q; ob *= os_q;
oa != oa ? oa = 0; ob != ob ? ob = 0;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_q = rs_f * rs_f * (3 - 2 * rs_f);
  pdc_delay > 0 ? ( rs_dl = BY_BUF[(by_w - pdc_delay) & (BY_N - 1)]; rs_dr = BY_BUF[BY_N + ((by_w - pdc_delay) & (BY_N - 1))]; )
                : ( rs_dl = spl0; rs_dr = spl1; );
  oa = rs_dl + (oa - rs_dl) * rs_q; ob = rs_dr + (ob - rs_dr) * rs_q;
);
spl0 = max(-4, min(4, oa));
spl1 = max(-4, min(4, ob));
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));
tm_pkl = max(tm_pkl, abs(spl0)); tm_pkr = max(tm_pkr, abs(spl1));
@gfx 900 355
ui_begin(900, 355);
mk_face = 0x3A3C41; mk_band = 0x232529; mk_ink = 0xE8E6E0; mk_ink2 = 0xB8B6B0; mk_acc = 0xFFD84A; mk_tab = 0xE8C22E;
mk_sub = ui_mix(mk_face, 0x000000, 0.42); mk_sub2 = ui_mix(mk_face, 0x000000, 0.54);
mk_ft = ui_mix(mk_face, 0xFFFFFF, 0.22); mk_fb = ui_mix(mk_face, 0x000000, 0.22);
ui_vu_dim = byp >= 0.5;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_tri(x1, y1, x2, y2, x3, y3) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c, tw, th) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  gfx_gradrect((x + b) * sc, (y + b) * sc, (w - 2 * b) * sc, (h - 2 * b) * sc, ((mk_sub >> 16) & 255) / 255, ((mk_sub >> 8) & 255) / 255, (mk_sub & 255) / 255, 1,
    0, 0, 0, 0, (((mk_sub2 >> 16) & 255) - ((mk_sub >> 16) & 255)) / 255 / ((h - 2 * b) * sc), (((mk_sub2 >> 8) & 255) - ((mk_sub >> 8) & 255)) / 255 / ((h - 2 * b) * sc), ((mk_sub2 & 255) - (mk_sub & 255)) / 255 / ((h - 2 * b) * sc), 0);
  ui_col(ui_mix(mk_sub, 0xFFFFFF, 0.12)); mg_r(x + 9, y + b + 33, w - 18, 1);
  gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(mk_ink); mg_ltxt(x + b + 36, y + b + 14, title); gfx_measurestr(title, tw, th);
  ui_col(mk_tab); mg_r(x + b + 36, y + b + 25, tw / sc, 3);
  ui_col(ui_mix(mk_sub, 0x000000, 0.4)); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(ui_mix(mk_sub, 0xFFFFFF, 0.25)); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, i, t) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KRD * 0.76, 1, 1);
