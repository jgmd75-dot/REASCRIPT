  mg_zero = 0;
  act;
);
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, sty, col, kind, name) local(k, v) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) :
  kind == 5 ? sprintf(#mgv, "%+.1f dB", v) :
  kind == 8 ? ( v >= 0.995 && v <= 1.005 ? strcpy(#mgv, "INF:1") : sprintf(#mgv, "%.1f:1", 1 / (1 - v)); ) :
  kind == 11 ? ( v < 995 ? sprintf(#mgv, "%d Hz", floor(v + 0.5)) : sprintf(#mgv, "%.1f kHz", v / 1000)) :
  kind == 9 ? ( v < 20 ? strcpy(#mgv, "OFF") : sprintf(#mgv, "%d Hz", floor(v + 0.5)); ) :
  kind == 10 ? ( abs(v) < 0.05 ? strcpy(#mgv, "0") : sprintf(#mgv, "%s %.1f", v > 0 ? "BOOST" : "ATTEN", abs(v)); ) :
  sprintf(#mgv, "%.1f dB", v);
