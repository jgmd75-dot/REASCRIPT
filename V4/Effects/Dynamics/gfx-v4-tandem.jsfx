function mg_vdiv(x) (
  ui_col(ui_mix(mk_sub, 0x000000, 0.45)); mg_r(x - 1, 92, 1, 234);
  ui_col(ui_mix(mk_sub, 0xFFFFFF, 0.12)); mg_r(x, 92, 1, 234);
