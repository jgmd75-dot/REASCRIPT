  ui_cola(0xFFFFFF, 0.18); rg_r(x, y + h, w + 1, 1); rg_r(x + w, y, 1, h);
);
function rg_vu(x, y, w, h, vdb, pk) local(fx, fy, fw, fh, rad, px, py, i, t, a, s, ang0, ang1, c) (
  ui_spill((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 1);
  ui_cola(0x000000, 0.35); rg_r(x - 9, y - 9, w + 18, h + 18);
  ui_cola(0x000000, 0.35); rg_r(x - 9, y - 9, w + 18, 3); rg_r(x - 9, y - 6, 3, h + 15);
  ui_cola(0xFFFFFF, 0.14); rg_r(x - 9, y + h + 7, w + 18, 2); rg_r(x + w + 7, y - 9, 2, h + 16);
  ui_col(0x0C0C0C); rg_rr(x - 3, y - 3, w + 6, h + 6, 5);
