desc:RIDGE SUMMIT [dynamics] (GFX V4)
//tags: compressor limiter clipper fet mid side m/s dynamics stereo v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-input, gfx-v4-output, gfx-v4-drift, gfx-v4-power, gfx-v4-ui, gfx-v4-panel, gfx-v4-os, gfx-v4-bypass, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider26:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,1,1{Off,On}>-Compressor
slider3:-6<-30,20,0.1>-Compressor threshold (dB)
slider4:3<1,20,0.01>-Ratio
slider5:10<0.2,200,0.01>-Attack (ms)
slider6:0.4<0.05,5,0.001>-Release (s per 20 dB)
slider7:0<0,1,1{Off,On}>-Auto timing
slider8:1<0,1,1{Off,On}>-Auto make-up
slider9:0<0,2,1{Stereo,Mid,Side}>-Compressor works on
slider10:1<0,1,1{Off,On}>-Limiter
slider11:-3<-24,0,0.1>-Limiter threshold (dBFS)
slider12:50<0,100,1>-Function (%)
slider13:0.3<0.05,5,0.001>-Limiter release (s)
slider14:3<0,7,1{Off,110 Hz,220 Hz,330 Hz,550 Hz,880 Hz,1.1 kHz,2.2 kHz}>-Divide
slider15:0<0,1,1{Off,On}>-Clip
slider16:0<0,2,1{Stereo,Mid,Side}>-Limiter works on
slider17:30<0,100,1>-Colour (%)
slider18:0<-20,20,0.1>-Output (dB)
slider19:1<0,1,1{Off,On}>-Link
slider20:0<0,1,1>-(unused, was Drift)
slider21:0<0,2,1{1x,2x,4x}>-Oversampling
slider22:100<0,200,1>-Width (%)
slider23:0<0,6,1{Off,44 Hz,66 Hz,88 Hz,110 Hz,220 Hz,330 Hz}>-Mono below
slider24:100<0,100,1>-Compressor mix (%)
slider25:prs_sel=0<0,10,1{No preset,Init,Vocal Chain,Drum Bus,Bass Body,Bright Guitars,Mid Glue,Warm FET,Peak Catcher,Side Squeeze,Parallel Smash}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-input.jsfx-inc
import gfx-v4-output.jsfx-inc
import gfx-v4-drift.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(67108863, v); );
function psw_allg(v) ( slider_show(67108863, v); );
#ui_man = "gfx-v4-ridge-summit";
ext_noinit = 1;

function rs_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function rs_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function rs_db(d) ( exp(d * 0.11512925464970228); );
function rs_ldb(x) ( 20 * log10(max(x, 0.0000001)); );
function rs_div(i) ( i == 1 ? 110 : i == 2 ? 220 : i == 3 ? 330 : i == 4 ? 550 : i == 5 ? 880 : i == 6 ? 1100 : 2200; );
function rs_mbf(i) ( i == 1 ? 44 : i == 2 ? 66 : i == 3 ? 88 : i == 4 ? 110 : i == 5 ? 220 : 330; );

function tw_set(t) instance(at, mt, st) ( at = t < 0.5; mt = t >= 0.5 && t < 1.5; st = t >= 1.5; );
function tw_glide(k) instance(a, m, s, at, mt, st) ( a += k * (at - a); m += k * (mt - m); s += k * (st - s); );
function tw_snap() instance(a, m, s, at, mt, st) ( a = at; m = mt; s = st; );
function tw_det(l, r) instance(a, m, s) local(c) ( c = m * 0.5 * (l + r) + s * 0.5 * (l - r); rs_dl = a * l + c; rs_dr = a * r + c; );
function tw_app(l, r, gl, gr) instance(a, m, s) local(g, mm, ss) (
  g = 0.5 * (gl + gr); mm = 0.5 * (l + r); ss = 0.5 * (l - r);
  rs_yl = a * gl * l + m * (g * mm + ss) + s * (mm + g * ss);
  rs_yr = a * gr * r + m * (g * mm - ss) + s * (mm - g * ss);
);
function tw_eff(gl, gr) instance(a, m, s) local(g) ( g = 0.5 * (gl + gr); rs_el = a * gl + (m + s) * g; rs_er = a * gr + (m + s) * g; );

function mb_run(x) instance(s1, s2) local(hp, bp, v1, g) (
  g = rs_mbk; hp = (x - 1.4142 * s1 - g * s1 - s2) / (1 + 1.4142 * g + g * g);
  v1 = g * hp; bp = v1 + s1; s1 = bp + v1; s2 += 2 * g * bp;
  hp;
);

function cp_lev(x) instance(ms, pk) (
  ms += rs_kat * (x * x - ms);
  pk = max(abs(x), pk * rs_pkd);
  10 * log10(max(ms, 0.00000000001)) + 3.0103;
);
function cp_gain(lv) instance(gc, gf, gs) local(ov, t) (
  ov = lv - rs_cth;
  t = ov <= -3 ? 0 : ov >= 3 ? -ov * rs_csl : -rs_csl * sqr(ov + 3) / 12;
  rs_aut > 0.5 ? (
    gf = t < gf ? t : min(t, gf + 3 * rs_crel);
    gs = t < gs ? gs + rs_kas * (t - gs) : min(t, gs + rs_crel / 3);
    gc = min(gf, gs);
  ) : (
    gc = t < gc ? t : min(t, gc + rs_crel);
    gf = gs = gc;
  );
  gc;
);

function dv_run(x, k) instance(a, b) ( a += k * (x - a); b += k * (a - b); );
function rs_gc(lv, th, sl, kw) local(ov, k2) (
  ov = lv - th; k2 = kw * 0.5;
  -(ov <= -k2 ? 0 : ov >= k2 ? ov * sl : sl * sqr(ov + k2) / (2 * kw));
);
function lm_det(pk, ms) instance(pf, ps, rr) local(tp, tr, k) (
  tp = rs_gc(20 * log10(max(pk, 0.0000001)), rs_thp, 0.98, 2);
  pf += (tp < pf ? 1 : rs_kpf) * (tp - pf);
  ps += (tp < ps ? rs_kph : rs_kpr) * (tp - ps);
  tr = rs_gc(10 * log10(max(ms, 0.00000000001)) + 3.0103, rs_thr, 0.975, 3);
  k = tr < rr ? rs_kra * (1 + min((rr - tr) * 0.25, 4.7)) : rs_krr;
  rr += min(k, 1) * (tr - rr);
  rs_pkg = min(pf, ps);
  max(min(rs_pkg, rr), -30);
);

function rs_clip(x) local(u, a) (
  u = x * rs_cci; a = abs(u);
  a > 0.9 ? ( a = 0.9 + 0.1 * (a - 0.9) / (0.1 + (a - 0.9)); u = sign(u) * min(a, 1); );
  rs_cc * u;
);
function rs_os(xl, xr, gl, gr) local(yl, yr) (
  wLm.tw_app(xl, xr, gl, gr); yl = rs_yl; yr = rs_yr;
  wLm.tw_eff(gl, gr);
  yl += rs_fa * (1 - rs_el * rs_cel) * yl * yl / (1 + abs(yl));
  yr += rs_fa * (1 - rs_er * rs_cer) * yr * yr / (1 + abs(yr));
  rs_pkc = max(rs_pkc, max(abs(yl), abs(yr)) * rs_cci);
  rs_pl = yl + rs_clw * (rs_clip(yl) - yl); rs_pr = yr + rs_clw * (rs_clip(yr) - yr);
);

function rs_clear() ( uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); );
function rs_reset() (
  rs_clear(); memset(BY_BUF, 0, 2 * BY_N);
  cpL.ms = cpL.pk = cpL.gc = cpL.gf = cpL.gs = cpR.ms = cpR.pk = cpR.gc = cpR.gf = cpR.gs = 0;
  lmL.pf = lmL.ps = lmL.rr = lmR.pf = lmR.ps = lmR.rr = 0;
  spL.a = spL.b = spR.a = spR.b = 0; rs_msl = rs_msr = 0;
  rs_gpl = rs_gnl = rs_gpr = rs_gnr = 1;
  rs_dxl = rs_dyl = rs_dxr = rs_dyr = 0; mbS.s1 = mbS.s2 = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  rs_fi = 0;
);

#rs_pm = "Init|Vocal Chain|Drum Bus|Bass Body|Bright Guitars|Mid Glue|Warm FET|Peak Catcher|Side Squeeze|Parallel Smash";
function rs_cp(on, th, ra, at, re, au, mk, tg) ( slider2 = on; slider3 = th; slider4 = ra; slider5 = at; slider6 = re; slider7 = au; slider8 = mk; slider9 = tg; );
function rs_lm(on, th, fn, re, dv, cl, tg) ( slider10 = on; slider11 = th; slider12 = fn; slider13 = re; slider14 = dv; slider15 = cl; slider16 = tg; );
function rs_ou(co, ou, mx) ( slider17 = co; slider18 = ou; slider19 = 1; slider22 = 100; slider23 = 0; slider24 = mx; );
function load_preset(p) local(i) (
  p == 1 || p == 11 ? (
    rs_cp(1,  -6, 3,   10, 0.4,  0, 1, 0); rs_lm(1, -3, 50, 0.3,  3, 0, 0); rs_ou(30, 0, 100);
  ) : p == 2 ? (
    rs_cp(1, -12, 4,    8, 0.4,  1, 1, 0); rs_lm(1, -4, 60, 0.25, 4, 0, 0); rs_ou(25, 0, 100);
  ) : p == 3 ? (
    rs_cp(1, -16, 6,   15, 0.15, 0, 1, 0); rs_lm(1, -2, 40, 0.1,  2, 1, 0); rs_ou(50, 0, 60);
  ) : p == 4 ? (
    rs_cp(1,  -8, 4,   15, 0.5,  0, 1, 0); rs_lm(1, -4, 80, 0.6,  2, 0, 0); rs_ou(45, 0, 85);
  ) : p == 5 ? (
    rs_cp(1,  -8, 3,   12, 0.3,  1, 1, 0); rs_lm(1, -4, 70, 0.4,  6, 0, 0); rs_ou(30, 0, 100);
  ) : p == 6 ? (
    rs_cp(1,  -8, 2.5, 30, 0.6,  0, 1, 1); rs_lm(1, -2, 30, 0.3,  3, 0, 0); rs_ou(20, 0, 100);
  ) : p == 7 ? (
    rs_cp(1, -12, 4,   10, 0.5,  1, 1, 0); rs_lm(1, -6, 50, 0.5,  3, 0, 0); rs_ou(90, 0, 75);
  ) : p == 8 ? (
    rs_cp(0,  -6, 3,   10, 0.4,  0, 1, 0); rs_lm(1, -1,  0, 0.15, 0, 1, 0); rs_ou(10, 0, 100);
  ) : p == 9 ? (
    rs_cp(1, -12, 3,   15, 0.4,  0, 1, 2); rs_lm(1, -2, 40, 0.3,  3, 0, 0); rs_ou(20, 0, 100);
  ) : p == 10 ? (
    rs_cp(1, -24, 10,   2, 0.1,  0, 1, 0); rs_lm(1, -2, 30, 0.15, 3, 1, 0); rs_ou(40, 0, 40);
  );
  i = 2; loop(17, ui_auto(i); i += 1; );
  ui_auto(22); ui_auto(23); ui_auto(24);
  pr_cur = p == 11 ? 1 : p;
);

function rs_srinit() (
  rs_sr = srate;
  rs_pkd = exp(-1 / (0.05 * srate)); rs_kas = rs_tc(80);
  rs_kpf = rs_tc(30); rs_kph = rs_tc(12); rs_kms = rs_tc(8); rs_kra = rs_tc(40);
  c_kn = rs_tc(30); c_lk = rs_tc(10); c_sw = rs_tc(15);
  rs_dcc = 1 - 2 * $pi * 5 / srate;
  rs_dvi = -1; rs_fis = 1 / (0.01 * srate);
  ost_init(0);
  rs_clear();
);
os_design();
os_f = os_tf = os_f2n(slider21); os_base = 0;
rs_srinit();
os_gsetup();
in_init();
dSup.drift_init(0.8 + rand(1) * 0.4); dF.drift_init(0.8 + rand(1) * 0.4);
drift_macro(0);
rs_gpl = rs_gnl = rs_gpr = rs_gnr = 1; rs_cel = rs_cer = 1;
rs_mbkt = tan($pi * 110 / srate); rs_snap = 1; rs_fi = 1; rs_cmx = 1;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_sag = 0.3;  pwr_wu_loss = 0.3;  pwr_wu_drv = 0.5;  pwr_wu_lp = 12000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

ui_thm = 5; ui_hw = 1; rg_hl = rg_hr = -60;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(24, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(21));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != rs_sr ? rs_srinit();
rs_now = time_precise();
rs_tp > 0 && rs_now - rs_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_reset();
rs_tp = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider21); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(0);
rs_n = samplesblock / srate;
rs_vv = dSup.drift_tick(0.04 * dm_s * rs_n); rs_vf = dF.drift_tick(0.03 * dm_s * rs_n);
rs_dr = 0.35 * dm_a * rs_vv;
wCp.tw_set(slider9); wLm.tw_set(slider16);
rs_cont = slider2 >= 0.5;
rs_ctv = min(max(slider3, -30), 20);
rs_ctht = rs_ctv - 18 + rs_dr;
rs_cslt = 1 - 1 / min(max(slider4, 1), 20);
rs_att = min(max(slider5, 0.2), 200);
rs_crel = 20 / (min(max(slider6, 0.05), 5) * srate);
rs_aut = slider7 >= 0.5;
rs_mkt = slider8 >= 0.5 ? max(-rs_ctv, 0) * rs_cslt : 0;
rs_lont = slider10 >= 0.5;
rs_fn = min(max(slider12, 0), 100) / 100;
rs_ltht = min(max(slider11, -24), 0) + rs_dr;
rs_thpt = rs_ltht; rs_thrt = rs_ltht - 10 * rs_fn;
rs_lrel = min(max(slider13, 0.05), 5);
rs_kpr = rs_tc(1000 * rs_lrel);
rs_krr = rs_tc(1000 * rs_lrel * (1.5 + 2 * rs_fn));
rs_dvn = floor(min(max(slider14, 0), 7) + 0.5);
rs_dvn != rs_dvi ? ( rs_dvi = rs_dvn; rs_dvont = rs_dvi > 0; rs_dvk = rs_dvi > 0 ? 1 - exp(-2 * $pi * rs_div(rs_dvi) / srate) : rs_dvk; );
rs_clwt = slider15 >= 0.5;
rs_fat = min(max(slider17, 0), 100) / 100 * 0.55 * (1 + 0.08 * dm_a * rs_vf);
rs_mkst = rs_db(min(max(slider18, -20), 20));
rs_lkt = slider19 >= 0.5;
rs_cmxt = min(max(slider24, 0), 100) / 100;
rs_wdt = min(max(slider22, 0), 200) / 100;
rs_mbn = floor(min(max(slider23, 0), 6) + 0.5);
rs_mbont = rs_mbn > 0;
rs_mbn > 0 ? rs_mbkt = tan($pi * rs_mbf(rs_mbn) / srate);
rs_snap ? (
  wCp.tw_snap(); wLm.tw_snap();
  rs_con = rs_cont; rs_cth = rs_ctht; rs_csl = rs_cslt; rs_mkg = rs_mkt;
  rs_lon = rs_lont; rs_thp = rs_thpt; rs_thr = rs_thrt; rs_dvon = rs_dvont; rs_clw = rs_clwt; rs_lth = rs_ltht;
  rs_fa = rs_fat; rs_mks = rs_mkst; rs_cmx = rs_cmxt; rs_lk = rs_lkt; rs_wd = rs_wdt; rs_mbon = rs_mbont; rs_mbk = rs_mbkt;
  rs_snap = 0;
);
cpL.ms = rs_tn(cpL.ms); cpR.ms = rs_tn(cpR.ms);
spL.a = rs_tn(spL.a); spL.b = rs_tn(spL.b); spR.a = rs_tn(spR.a); spR.b = rs_tn(spR.b);
rs_msl = rs_tn(rs_msl); rs_msr = rs_tn(rs_msr); mbS.s1 = rs_tn(mbS.s1); mbS.s2 = rs_tn(mbS.s2);
rs_gc_d = min(rs_gc_d, rs_gcm); rs_gl_d = min(rs_gl_d, rs_glm); rs_gcm = rs_glm = 0;
rs_lp_d |= rs_lpm; rs_lpm = 0;
rs_ht_d = max(rs_ht_d, rs_htm); rs_htm = 0;
rs_ol_d = max(rs_ol_d, rs_ol); rs_or_d = max(rs_or_d, rs_or); rs_ol = rs_or = 0;
rs_vu_d = max(rs_vu_d, sqrt(rs_ms / max(samplesblock, 1))); rs_ms = 0;
os_snapb(slider(21));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
pwr_in(in_l, in_r); rs_xl = pwr_l; rs_xr = pwr_r;
abs(rs_xl) < 0.000000000000001 ? rs_xl = 0; abs(rs_xr) < 0.000000000000001 ? rs_xr = 0;
wCp.tw_glide(c_sw); wLm.tw_glide(c_sw);
rs_con += (rs_cont - rs_con) * c_sw; rs_lon += (rs_lont - rs_lon) * c_sw;
rs_dvon += (rs_dvont - rs_dvon) * c_lk; rs_clw += (rs_clwt - rs_clw) * c_sw; rs_lk += (rs_lkt - rs_lk) * c_lk;
rs_cth += (rs_ctht - rs_cth) * c_kn; rs_csl += (rs_cslt - rs_csl) * c_kn; rs_mkg += (rs_mkt - rs_mkg) * c_kn;
rs_thp += (rs_thpt - rs_thp) * c_kn; rs_thr += (rs_thrt - rs_thr) * c_kn; rs_lth += (rs_ltht - rs_lth) * c_kn;
rs_fa += (rs_fat - rs_fa) * c_kn; rs_mks += (rs_mkst - rs_mks) * c_kn; rs_cmx += (rs_cmxt - rs_cmx) * c_kn;
rs_wd += (rs_wdt - rs_wd) * c_kn; rs_mbon += (rs_mbont - rs_mbon) * c_sw; rs_mbk += (rs_mbkt - rs_mbk) * c_kn;

rs_aut > 0.5 ? (
  rs_cf = max(cpL.pk, cpR.pk) / max(sqrt(max(cpL.ms, cpR.ms)), 0.00001);
  rs_kat = rs_tc(5 + 25 * min(max((rs_cf - 1.5) / 4, 0), 1));
) : rs_kat = rs_tc(rs_att);
wCp.tw_det(rs_xl, rs_xr);
rs_g1 = cpL.cp_gain(cpL.cp_lev(rs_dl)) * rs_con; rs_g2 = cpR.cp_gain(cpR.cp_lev(rs_dr)) * rs_con;
rs_q = 0.5 * (rs_g1 + rs_g2); rs_g1 += rs_lk * (rs_q - rs_g1); rs_g2 += rs_lk * (rs_q - rs_g2);
rs_gcm = min(rs_gcm, min(rs_g1, rs_g2));
wCp.tw_eff(rs_db(rs_g1), rs_db(rs_g2)); rs_cel = rs_el; rs_cer = rs_er;
rs_q = rs_mkg * rs_con;
wCp.tw_app(rs_xl, rs_xr, rs_db(rs_g1 + rs_q), rs_db(rs_g2 + rs_q)); rs_xl += rs_cmx * (rs_yl - rs_xl); rs_xr += rs_cmx * (rs_yr - rs_xr);

wLm.tw_det(rs_xl, rs_xr); rs_al = rs_dl; rs_ar = rs_dr;
spL.dv_run(rs_al, rs_dvk); spR.dv_run(rs_ar, rs_dvk);
rs_pdl = abs(rs_al + rs_dvon * (rs_al - spL.a)); rs_pdr = abs(rs_ar + rs_dvon * (rs_ar - spR.a));
rs_q = rs_al + rs_dvon * (spL.b - rs_al); rs_msl += rs_kms * (rs_q * rs_q - rs_msl);
rs_q = rs_ar + rs_dvon * (spR.b - rs_ar); rs_msr += rs_kms * (rs_q * rs_q - rs_msr);
rs_q = max(rs_msl, rs_msr); rs_ml = rs_msl + rs_lk * (rs_q - rs_msl); rs_mr = rs_msr + rs_lk * (rs_q - rs_msr);
rs_q = max(rs_pdl, rs_pdr); rs_pdl += rs_lk * (rs_q - rs_pdl); rs_pdr += rs_lk * (rs_q - rs_pdr);
rs_g1 = lmL.lm_det(rs_pdl, rs_ml) * rs_lon; rs_pp1 = rs_pkg;
rs_g2 = lmR.lm_det(rs_pdr, rs_mr) * rs_lon; rs_pp2 = rs_pkg;
rs_q = min(rs_g1, rs_g2); rs_glm = min(rs_glm, rs_q);
rs_q < -0.5 ? ( min(rs_pp1, rs_pp2) * rs_lon <= rs_q + 0.01 ? rs_lpm |= 1 : rs_lpm |= 2; );

rs_cc = min(rs_db(rs_lth + 0.5), 0.966); rs_cci = 1 / rs_cc;
os_gate();
os_chg ? ( rs_clear(); os_hold += 2 * samplesblock; );
rs_gnl = rs_db(rs_g1); rs_gnr = rs_db(rs_g2);
rs_pkc = 0;
uxL.os_up(rs_xl); uxR.os_up(rs_xr);
os_f == 1 ? (
  rs_os(uxL.s0, uxR.s0, rs_gnl, rs_gnr); rs_yl = rs_pl; rs_yr = rs_pr;
) : (
  rs_d1 = (rs_gnl - rs_gpl) / os_f; rs_d2 = (rs_gnr - rs_gpr) / os_f;
  rs_os(uxL.s0, uxR.s0, rs_gpl + rs_d1, rs_gpr + rs_d2); rs_a0 = rs_pl; rs_b0 = rs_pr;
  rs_os(uxL.s1, uxR.s1, rs_gpl + 2 * rs_d1, rs_gpr + 2 * rs_d2); rs_a1 = rs_pl; rs_b1 = rs_pr;
  os_f == 2 ? ( rs_yl = dnL.os_dn(rs_a0, rs_a1, 0, 0); rs_yr = dnR.os_dn(rs_b0, rs_b1, 0, 0); ) : (
    rs_os(uxL.s2, uxR.s2, rs_gpl + 3 * rs_d1, rs_gpr + 3 * rs_d2); rs_a2 = rs_pl; rs_b2 = rs_pr;
    rs_os(uxL.s3, uxR.s3, rs_gnl, rs_gnr); rs_a3 = rs_pl; rs_b3 = rs_pr;
    rs_yl = dnL.os_dn(rs_a0, rs_a1, rs_a2, rs_a3); rs_yr = dnR.os_dn(rs_b0, rs_b1, rs_b2, rs_b3);
  );
);
rs_gpl = rs_gnl; rs_gpr = rs_gnr;
rs_clw > 0.5 && rs_pkc > 0.9 ? rs_lpm |= 4;
rs_htm = max(rs_htm, rs_fa * (1 - min(rs_el * rs_cel, rs_er * rs_cer)));
rs_z = rs_yl - rs_dxl + rs_dcc * rs_dyl; rs_dxl = rs_yl; rs_dyl = rs_z; rs_yl = rs_z;
rs_z = rs_yr - rs_dxr + rs_dcc * rs_dyr; rs_dxr = rs_yr; rs_dyr = rs_z; rs_yr = rs_z;
pwr_out(rs_yl, rs_yr); rs_yl = pwr_l * rs_mks; rs_yr = pwr_r * rs_mks;
rs_mm = 0.5 * (rs_yl + rs_yr); rs_ss = 0.5 * (rs_yl - rs_yr);
rs_q = mbS.mb_run(rs_ss); rs_ss = (rs_ss + rs_mbon * (rs_q - rs_ss)) * rs_wd;
rs_yl = rs_mm + rs_ss; rs_yr = rs_mm - rs_ss;
rs_osg = os_g * os_g * (3 - 2 * os_g);
rs_yl *= rs_osg; rs_yr *= rs_osg;
rs_yl != rs_yl ? rs_yl = 0; rs_yr != rs_yr ? rs_yr = 0;
rs_fi < 1 ? (
  rs_fi = min(rs_fi + rs_fis, 1); rs_z = rs_fi * rs_fi * (3 - 2 * rs_fi);
  rs_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; rs_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  rs_yl = rs_a + rs_z * (rs_yl - rs_a); rs_yr = rs_b + rs_z * (rs_yr - rs_b);
);
ost_out(rs_yl, rs_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
rs_ol = max(rs_ol, abs(spl0)); rs_or = max(rs_or, abs(spl1));
rs_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);
@gfx 900 355
function v4rd_c(c) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = 1; );
function v4rd_mx(c, t, f) ( (floor(((c >> 16) & 255) * (1 - f) + ((t >> 16) & 255) * f) << 16) + (floor(((c >> 8) & 255) * (1 - f) + ((t >> 8) & 255) * f) << 8) + floor((c & 255) * (1 - f) + (t & 255) * f); );
function v4rd(gx0, gy0, k, rad, c1, c2, c3) local(q, i, yd, gx, hw, j, n, xl, xr, il, ir, rr) (
  q = k * rad / 17;
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 17 * q, 1, 1);
  v4rd_c(0xE8EBEE); gfx_circle(gx0, gy0, 15 * q, 1, 1);
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 13 * q, 1, 1);
  i = 0;
  loop(3,
    v4rd_c(i == 0 ? c1 : i == 1 ? c2 : c3);
    yd = -12.2 + i * 2.6;
    gx = gx0 + 0.5; hw = sqrt(max(sqr(13.6) - sqr(yd + 0.8), 0)) * q;
    j = floor(gy0 + yd * q + 1); n = max(1, floor(1.6 * q));
    xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
    hw > 0 ? loop(n,
      il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
        gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
        gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
        gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
      );
      j += 1;
    );
    i += 1;
  );
  v4rd_c(0xE8EBEE);
  rr = 13 * q + 0.75; while (rr <= 15 * q - 0.75) ( gfx_circle(gx0, gy0, rr, 0, 1); rr += 0.5; );
  gfx_a = 1;
);
ui_begin(900, 355);
RGP = 0x1A2233; RGPS = 0x202A3F; RGPH = 0x0C111B; RGPW = 0x070A10; RGI = 0xEDE8DA; RGT = 0xF1E8D4; RGA = 0xF0A63A;
RGI2 = ui_mix(RGI, RGP, 0.36); RGT2 = ui_mix(RGT, RGPH, 0.40);
CGY = 0xC9CDD3; CLI = 0xC4B4E8; CMN = 0xA8DCC0; CBL = 0x9EC2E8; CCO = 0xF0A898; CCR = 0xEDE6CF; CPE = 0xF5C89A;
rm_ft = ui_mix(RGP, 0xFFFFFF, 0.22); rm_fb = ui_mix(RGP, 0x000000, 0.22);
ui_vu_dim = slider1 >= 0.5;

sc != rg_fsc ? (
  rg_fsc = sc;
  rg_f10 = ui_fitfont(10, 15 * sc);
  rg_f11 = ui_fitfont(11, 16 * sc);
  rg_f12 = ui_fitfont(12, 11.5 * sc);
  rg_f13 = ui_fitfont(13, 14 * sc);
  rg_f14 = ui_fitfont(14, 27 * sc);
  rg_f6 = ui_fitfont(6, 12 * sc);
);
gfx_setfont(10, "Trebuchet MS", rg_f10, 'b'); gfx_setfont(11, "Trebuchet MS", rg_f11, 'b');
gfx_setfont(12, "Trebuchet MS", rg_f12, 'b'); gfx_setfont(13, "Trebuchet MS", rg_f13, 'b');
gfx_setfont(14, "Trebuchet MS", rg_f14, 'b'); gfx_setfont(6, "Trebuchet MS", rg_f6, 'b');

function rg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function rg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function rg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function rg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function rg_plate(x, y, w, h) local(j, c, b) (
  b = 4; c = ui_mix(RGPS, 0xFFFFFF, 0.10);
  j = 0; loop(3, ui_cola(0x000000, 0.07); rg_r(x + 1 + j, y + 2 + j, w + j, h + j); j += 1; );
  ui_cola(0x000000, 0.30); rg_r(x + 1, y + h, w, 1); rg_r(x + w, y + 1, 1, h - 1);
  ui_cola(0x000000, 0.12); rg_r(x + 2, y + h + 1, w, 1); rg_r(x + w + 1, y + 2, 1, h - 1);
  ui_col(ui_mix(c, 0x000000, 0.55)); rg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.20)); rg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.10)); rg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); rg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
