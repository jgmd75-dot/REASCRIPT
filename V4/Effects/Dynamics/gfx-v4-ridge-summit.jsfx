    rg_dz > 3 * sc ? (
      rg_n = min(max(rg_n + (rg_my - mouse_y) / (((mouse_cap & 8) ? 1000 : (rg_step ? 160 : 200)) * sc), 0), 1);
      v = rg_kv(rg_n, lo, hi); rg_step ? v = floor(v + 0.5);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
