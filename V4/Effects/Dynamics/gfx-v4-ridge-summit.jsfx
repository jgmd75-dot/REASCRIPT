  lit ? ( ui_cola(col, 0.10); gfx_circle(x, y, rr * 2.3, 1, 1); ui_cola(col, 0.16); gfx_circle(x, y, rr * 1.8, 1, 1);
          ui_cola(col, 0.24); gfx_circle(x, y, rr * 1.5, 1, 1); );
