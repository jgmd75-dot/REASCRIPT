function rg_knob(cx, cy, r, idx, lo, hi, def, cap, zf) local(v, n, dx, dy, hov, did, act) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - rg_lt < 0.35 && rg_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; rg_lt = 0; ) : (
      drag_id = did; rg_my = mouse_y; rg_dz = 0; rg_lt = time_precise(); rg_lid = idx; rg_n = rg_kn(v, lo, hi);
    );
  );
