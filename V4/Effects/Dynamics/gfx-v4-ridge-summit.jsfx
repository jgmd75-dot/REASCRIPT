function rg_dvs(i) ( i == 0 ? "Off" : i == 1 ? "110 Hz" : i == 2 ? "220 Hz" : i == 3 ? "330 Hz" : i == 4 ? "550 Hz" : i == 5 ? "880 Hz" : i == 6 ? "1.1 kHz" : "2.2 kHz"; );
function rg_recess(x, y, w, h) (
  ui_cola(0x000000, 0.35); rg_rr(x - 2, y - 2, w + 4, h + 4, 4);
