function rg_name(cx, cy, r, act, name, val) ( gfx_setfont(10); ui_col(act ? RGA : RGI); rg_ctxt(cx, cy + r + 19, act ? val : name); );
function rg_rivet(x, y) ( ui_cola(0x000000, 0.35); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x8496A3); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xC9D4DC); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );
function rg_rbw(t) local(f) (
  t = min(max(t, 0), 1) * 5; f = t - floor(t);
  t < 1 ? ui_mix(0x3A86FF, 0x22D8E8, f) : t < 2 ? ui_mix(0x22D8E8, 0x3CE05A, f) : t < 3 ? ui_mix(0x3CE05A, 0xFFD21E, f) :
  t < 4 ? ui_mix(0xFFD21E, 0xFF8A1E, f) : ui_mix(0xFF8A1E, 0xFF3A2A, t >= 5 ? 1 : f);
);
function rg_stripe(x, y, w, h) local(i) ( i = 0; loop(48, ui_col(rg_rbw(i / 47)); rg_r(x + i * w / 48, y, w / 48 + 1.5, h); i += 1; ); );
function rg_hold(v) instance(h) ( h += (v < h ? 1 : 0.25) * (v - h); h; );
function rg_sec(v) ( v < 1 ? sprintf(#rgv, "%d ms", floor(v * 1000 + 0.5)) : sprintf(#rgv, "%.2f s", v); );
function rg_dwell(x, y, w, h) (
  ui_col(ui_mix(RGP, 0x000000, 0.55)); rg_r(x, y, w, h);
  ui_col(ui_mix(RGP, 0x000000, 0.40)); rg_r(x + 2, y + 2, w - 3, h - 3);
