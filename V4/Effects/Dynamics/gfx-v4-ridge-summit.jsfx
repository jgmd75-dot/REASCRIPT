function rg_grey(x, y, w, h) ( ui_cola(RGPS, 0.5); rg_r(x, y, w, h); );
rg_lg = 0; rg_step = 0;
function rg_kn(v, lo, hi) ( rg_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function rg_kv(n, lo, hi) ( rg_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function rg_cap(cx, cy, r, a, act, cap, zf) local(i, t, x, y, rr, rd) (
  x = cx * sc; y = cy * sc; rr = r * sc; rd = rr + 8 * sc;
  ui_col(RGI2); i = 0;
  loop(2, t = -0.75 * $pi + i * 1.5 * $pi;
    gfx_circle(x + sin(t) * rd, y - cos(t) * rd, 1.9 * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.08); gfx_circle(x + (1.5 + i * 0.9) * sc, y + (2 + i * 1.1) * sc, rr + i * 0.5 * sc, 1, 1); i += 1; );
  ui_col(0x15181B); gfx_circle(x, y, rr, 1, 1);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C);
    ui_ssline(x + sin(t) * rr * 0.80, y - cos(t) * rr * 0.80, x + sin(t) * rr * 0.95, y - cos(t) * rr * 0.95, 1.1 * sc, 0); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.28 : 0.16); ui_ssarc(x, y, rr - 0.6 * sc, -2.2, 0.6, 1 * sc);
  ui_col(ui_mix(cap, 0x000000, 0.5)); gfx_circle(x, y, rr * 0.76, 1, 1);
