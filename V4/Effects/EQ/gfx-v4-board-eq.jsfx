    mg_zero == 3 && i == 2 ? ( gfx_setfont(11); ui_col(0xFF8A6A); mg_ctxt(px, py - 3, "INF"); )
    : i == 0 || i == n ? ( ui_col(c); mg_disc(px, py, 1.8); );
