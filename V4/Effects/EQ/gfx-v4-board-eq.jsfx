function mg_fstr(v) ( v < 1000 ? sprintf(#mgv, "%d Hz", floor(v + 0.5)) : sprintf(#mgv, "%.2f kHz", v / 1000); );
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, sty, col, kind, name) local(k, v) (
