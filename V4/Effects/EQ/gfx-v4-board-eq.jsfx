desc:Board EQ [console EQ] (GFX V4)
//tags: equaliser eq console channel parametric filter line amp v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-input, gfx-v4-drift, gfx-v4-ui, gfx-v4-panel, gfx-v4-os, gfx-v4-bypass, gfx-v4-power, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider22:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:hpf=20<20,440,1>-HPF (Hz, 20 = off)
slider3:lpf=22000<3000,22000,10>-LPF (Hz, 22000 = off)
slider4:lf_g=0<-15,15,0.1>-LF gain (dB)
slider5:lf_f=99<30,450,1>-LF freq (Hz)
slider6:lf_b=0<0,1,1{Shelf,Bell}>-LF bell
slider7:lm_g=0<-15,15,0.1>-LMF gain (dB)
slider8:lm_f=550<200,2500,1>-LMF freq (Hz)
slider9:lm_q=1<0.4,3,0.01>-LMF Q
slider10:hm_g=0<-15,15,0.1>-HMF gain (dB)
slider11:hm_f=2200<600,7000,1>-HMF freq (Hz)
slider12:hm_q=1<0.4,3,0.01>-HMF Q
slider13:hf_g=0<-15,15,0.1>-HF gain (dB)
slider14:hf_f=7700<1500,16000,10>-HF freq (Hz)
slider15:hf_b=0<0,1,1{Shelf,Bell}>-HF bell
slider16:blk=1<0,1,1{Brown,Black}>-Voicing
slider17:drv=0<0,100,1>-Line amp drive (%)
slider18:out_db=0<-12,12,0.1>-Output (dB)
slider19:drift_pc=50<0,100,1>-Drift (%)
slider20:os_sl=0<0,2,1{1x,2x,4x}>-Oversampling
slider21:prs_sel=0<0,11,1{No preset,Init,Vocal Presence,Kick Punch,Snare Crack,Bass Weight,Acoustic Sparkle,Mix Bus Air,Telephone,De-mud,Brown Warmth,De-harsh}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-input.jsfx-inc
import gfx-v4-drift.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4194303, v); );
function psw_allg(v) ( slider_show(4194303, v); );
#ui_man = "gfx-v4-board-eq";
ext_noinit = 1;

function bd_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function bd_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

function bq_set(type, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, n, sa) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); amp = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / amp; b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = b1; a2 = (1 - al / amp) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(amp) * al; n = (amp + 1) - (amp - 1) * cw + sa;
                b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n; b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
                b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n; a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n; a2 = ((amp + 1) - (amp - 1) * cw - sa) / n; ) :
  ( sa = 2 * sqrt(amp) * al; n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n; b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n; a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n; a2 = ((amp + 1) + (amp - 1) * cw - sa) / n; );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = bd_tn(y1); y1 = y;
  y;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function hp1(x) instance(x1, y1) ( y1 = bd_tn(hp1_a * (x - x1) + hp1_b * y1); x1 = x; y1; );
function hp1_clr() instance(x1, y1) ( x1 = y1 = 0; );

function bd_chain(x) instance(h1, h2, lf, lx, lm, hm, hf, hx, lp) local(y) (
  hp_m > 0 ? ( y = this.h1.hp1(this.h2.bq_run(x)); x += (y - x) * hp_m; ) : ( this.h1.hp1_clr(); this.h2.bq_clr(); );
  x = this.lf.bq_run(x); lfx ? x = this.lx.bq_run(x) : this.lx.bq_clr();
  x = this.lm.bq_run(x); x = this.hm.bq_run(x);
  x = this.hf.bq_run(x); hfx ? x = this.hx.bq_run(x) : this.hx.bq_clr();
  lp_m > 0 ? ( y = this.lp.bq_run(x); x += (y - x) * lp_m; ) : this.lp.bq_clr();
  x;
);
function bd_clr() instance(h1, h2, lf, lx, lm, hm, hf, hx, lp) (
  this.h1.hp1_clr(); this.h2.bq_clr(); this.lf.bq_clr(); this.lx.bq_clr(); this.lm.bq_clr(); this.hm.bq_clr();
  this.hf.bq_clr(); this.hx.bq_clr(); this.lp.bq_clr();
);
function bd_set_ch(df) instance(h1, h2, lf, lx, lm, hm, hf, hx, lp) local(lg, mg, ng, fg, lf_, hf_) (
  lg = lfg_s * em; mg = lmg_s * em; ng = hmg_s * em; fg = hfg_s * em;
  lf_ = lff_s * df; hf_ = hff_s * df;
  this.h2.bq_set(1, hpz_s, 1, 0);
  this.lp.bq_set(0, lpz_s, 0.707, 0);
  this.lf.bq_set(lb_c ? 2 : 4, lf_, lb_c ? (blk_c ? 0.6 + abs(lg) / 15 * 0.9 : 0.55) : (blk_c ? 1.15 : 0.6), lg);
  this.lm.bq_set(2, lmf_s * df, lmq_s * (blk_c ? 0.6 + abs(mg) / 15 * 1.2 : 0.7), mg);
  this.hm.bq_set(2, hmf_s * df, hmq_s * (blk_c ? 0.6 + abs(ng) / 15 * 1.2 : 0.7), ng);
  this.hf.bq_set(hb_c ? 2 : 3, hf_, hb_c ? (blk_c ? 0.6 + abs(fg) / 15 * 0.9 : 0.55) : (blk_c ? 1.15 : 0.6), fg);
  lfx ? this.lx.bq_set(2, lf_ * 2.2, 1.2, -lg * 0.12);
  hfx ? this.hx.bq_set(2, hf_ * 0.45, 1.2, -fg * 0.12);
);
function hp1set(f) local(k) ( k = tan($pi * min(f, srate * 0.45) / srate); hp1_a = 1 / (1 + k); hp1_b = (1 - k) / (1 + k); );
function bd_coefs() (
  lfx = blk_c && !lb_c; hfx = blk_c && !hb_c;
  hp1set(hpz_s);
  CL.bd_set_ch(1 + 0.012 * d_amt * d_fl); CR.bd_set_ch(1 + 0.012 * d_amt * d_fr);
);

function bd_params() (
  hpz_t = max(hpf, 20); lpz_t = min(lpf, srate * 0.45);
  hp_t = hpf > 20.5; lp_t = lpf < 21990;
  dr_t = drv / 100;
  og_t = 10 ^ (out_db / 20);
  in_setup(0, 1);
  os_tf = os_f2n(os_sl);
  drift_macro(drift_pc); d_amt = 0.25 * dm_a; d_spd = 0.25 * dm_s;
);
function bd_rate() (
  bd_sr = srate;
  k16 = 1 - exp(-16 / (0.02 * srate));
  c_sw = 1 - exp(-1 / (0.012 * srate));
  c_em = 1 / (0.010 * srate);
  rs_c = 1 / (0.015 * srate);
);
function bd_snapv() (
  lfg_s = lf_g; lff_s = lf_f; lmg_s = lm_g; lmf_s = lm_f; lmq_s = lm_q; hmg_s = hm_g; hmf_s = hm_f; hmq_s = hm_q;
  hfg_s = hf_g; hff_s = hf_f; hpz_s = hpz_t; lpz_s = lpz_t; hp_m = hp_t; lp_m = lp_t; dr_s = dr_t; og_s = og_t;
  lb_c = lf_b >= 0.5; hb_c = hf_b >= 0.5; blk_c = blk >= 0.5; em = 1;
  bd_coefs();
);
function bd_osclr() ( OSU.os_clr(); OSD.os_clr(); OSUB.os_clr(); OSDB.os_clr(); );
function bd_reset() (
  bd_osclr(); CL.bd_clr(); CR.bd_clr();
  memset(BY_BUF, 0, 2 * BY_N);
  rs_f = 0;
);
function bd_glide() local(m) (
  m = 0;
  lfg_s += (lf_g - lfg_s) * k16; abs(lfg_s - lf_g) < 0.001 ? lfg_s = lf_g : m = 1;
  lmg_s += (lm_g - lmg_s) * k16; abs(lmg_s - lm_g) < 0.001 ? lmg_s = lm_g : m = 1;
  hmg_s += (hm_g - hmg_s) * k16; abs(hmg_s - hm_g) < 0.001 ? hmg_s = hm_g : m = 1;
  hfg_s += (hf_g - hfg_s) * k16; abs(hfg_s - hf_g) < 0.001 ? hfg_s = hf_g : m = 1;
  lff_s *= (lf_f / lff_s) ^ k16; abs(lff_s - lf_f) < 0.0005 * lf_f ? lff_s = lf_f : m = 1;
  lmf_s *= (lm_f / lmf_s) ^ k16; abs(lmf_s - lm_f) < 0.0005 * lm_f ? lmf_s = lm_f : m = 1;
  hmf_s *= (hm_f / hmf_s) ^ k16; abs(hmf_s - hm_f) < 0.0005 * hm_f ? hmf_s = hm_f : m = 1;
  hff_s *= (hf_f / hff_s) ^ k16; abs(hff_s - hf_f) < 0.0005 * hf_f ? hff_s = hf_f : m = 1;
  lmq_s += (lm_q - lmq_s) * k16; abs(lmq_s - lm_q) < 0.0005 ? lmq_s = lm_q : m = 1;
  hmq_s += (hm_q - hmq_s) * k16; abs(hmq_s - hm_q) < 0.0005 ? hmq_s = hm_q : m = 1;
  hpz_s *= (hpz_t / hpz_s) ^ k16; abs(hpz_s - hpz_t) < 0.0005 * hpz_t ? hpz_s = hpz_t : m = 1;
  lpz_s *= (lpz_t / lpz_s) ^ k16; abs(lpz_s - lpz_t) < 0.0005 * lpz_t ? lpz_s = lpz_t : m = 1;
  m;
);

bd_rate();
in_init();
bd_params();
os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
os_gsetup();
DFL.drift_init(0.8 + rand(1) * 0.5); DFR.drift_init(0.8 + rand(1) * 0.5);
DGBL.drift_init(0.8 + rand(1) * 0.5); DGBR.drift_init(0.8 + rand(1) * 0.5);
d_fl = d_fr = d_bl = d_br = 0;
bd_snapv();
bd_reset();
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.15; pwr_wu_loss = 0.4; pwr_wu_drv = 0.8; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;
rs_f = 1; bd_snap = 1; bd_blk = 0; bd_n = 0; bd_dirty = 0;
pdc_delay = os_lat(os_f);
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;

function bd_set(hp, lp, lg, lf, lb, mg, mf, mq, hg, hf_, hq, fg, ff, fb, vo, dr) (
  hpf = hp; lpf = lp; lf_g = lg; lf_f = lf; lf_b = lb; lm_g = mg; lm_f = mf; lm_q = mq;
  hm_g = hg; hm_f = hf_; hm_q = hq; hf_g = fg; hf_f = ff; hf_b = fb; blk = vo; drv = dr; out_db = 0;
);
function load_preset(p) local(i) (
  p == 2 ? bd_set(88, 22000, -2, 220, 1, -3, 330, 1.2, 4, 3300, 1.2, 3, 12000, 0, 1, 10) :
  p == 3 ? bd_set(33, 22000, 5, 55, 1, -5, 330, 1.5, 3, 3300, 1.5, 0, 7700, 0, 1, 15) :
  p == 4 ? bd_set(77, 22000, 2, 220, 1, -2, 550, 1.2, 4, 5500, 1.4, 3, 9900, 0, 1, 20) :
  p == 5 ? bd_set(33, 8800, 4, 77, 0, -3, 220, 1.2, 2, 1100, 1, 0, 7700, 0, 0, 25) :
  p == 6 ? bd_set(66, 22000, -2, 110, 0, -2, 330, 1, 2, 4400, 0.8, 4, 12000, 0, 0, 0) :
  p == 7 ? bd_set(22, 22000, 1.5, 55, 0, 0, 550, 1, -1, 3300, 0.8, 2, 14000, 0, 0, 10) :
  p == 8 ? bd_set(440, 3300, 0, 99, 0, 6, 1100, 1.5, 0, 2200, 1, 0, 7700, 0, 1, 60) :
  p == 9 ? bd_set(55, 22000, 0, 99, 0, -5, 330, 1, 0, 2200, 1, 1, 9900, 0, 1, 0) :
  p == 10 ? bd_set(44, 16000, 3, 110, 0, 1, 770, 0.7, 1, 3300, 0.7, 2, 8800, 0, 0, 40) :
  p == 11 ? bd_set(99, 22000, 0, 99, 0, 0, 550, 1, -4, 6600, 2.5, 2, 15000, 0, 1, 0) :
  ( bd_set(20, 22000, 0, 99, 0, 0, 550, 1, 0, 2200, 1, 0, 7700, 0, 1, 0); drift_pc = 50; );
  p == 12 ? os_sl = 0;
  i = 2; loop(19, i != 20 ? ui_auto(i); i += 1; ); p == 12 ? ui_auto(20);
  pr_cur = p == 12 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(20, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 11 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
bd_params();
os_snap(os_sl);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && bd_blk < 40 ? bd_snap = 1;
pwr_ser();

@block
prs_chk();
bd_blk < 40 ? bd_blk += 1;
srate != bd_sr ? ( bd_rate(); bd_params(); bd_snapv(); bd_reset(); );
bd_params();
pwr_block(byp < 0.5);
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? bd_reset();
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
bd_snap ? ( bd_snap = 0; bd_snapv(); );
d_inc = d_spd * samplesblock / srate;
d_amt > 0 ? (
  d_fl = DFL.drift_tick(d_inc); d_fr = DFR.drift_tick(d_inc);
  d_bl = DGBL.drift_tick(d_inc); d_br = DGBR.drift_tick(d_inc);
  bd_dirty = 1;
) : d_fl = d_fr = d_bl = d_br = 0;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(os_sl);

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
og_s += (og_t - og_s) * c_sw;
dr_s += (dr_t - dr_s) * c_sw; abs(dr_s - dr_t) < 0.00001 ? dr_s = dr_t;
hp_m += (hp_t - hp_m) * c_sw; abs(hp_m - hp_t) < 0.0001 ? hp_m = hp_t;
lp_m += (lp_t - lp_m) * c_sw; abs(lp_m - lp_t) < 0.0001 ? lp_m = lp_t;
((lf_b >= 0.5) != lb_c || (hf_b >= 0.5) != hb_c || (blk >= 0.5) != blk_c) ? (
  em = max(em - c_em, 0);
  em == 0 ? ( lb_c = lf_b >= 0.5; hb_c = hf_b >= 0.5; blk_c = blk >= 0.5; );
  bd_dirty = 1;
) : em < 1 ? ( em = min(em + c_em, 1); bd_dirty = 1; );
(bd_n += 1) >= 16 ? (
  bd_n = 0;
  bd_glide() ? bd_dirty = 1;
  bd_dirty ? ( bd_dirty = 0; bd_coefs(); );
  dk = 1 + dr_s * 3;
  dbl = dr_s * 0.15 * (1 + 0.8 * d_amt * d_bl); dbr = dr_s * 0.15 * (1 + 0.8 * d_amt * d_br);
  dtl = bd_th(dbl); dtr = bd_th(dbr);
  dnl = 1 / (dk * (1 - dtl * dtl)); dnr = 1 / (dk * (1 - dtr * dtr));
);

in_process(spl0, spl1);
x = CL.bd_chain(in_l); xb = CR.bd_chain(in_r);
pwr_in(x, xb); x = pwr_l; xb = pwr_r;
os_gate();
os_chg ? bd_osclr();
dr_s > 0.001 ? (
  OSU.os_up(x); OSUB.os_up(xb);
  os_f == 1 ? (
    y = (bd_th(dk * OSU.s0 + dbl) - dtl) * dnl; yb = (bd_th(dk * OSUB.s0 + dbr) - dtr) * dnr;
  ) : os_f == 2 ? (
    a0 = (bd_th(dk * OSU.s0 + dbl) - dtl) * dnl; b0 = (bd_th(dk * OSUB.s0 + dbr) - dtr) * dnr;
    a1 = (bd_th(dk * OSU.s1 + dbl) - dtl) * dnl; b1 = (bd_th(dk * OSUB.s1 + dbr) - dtr) * dnr;
    y = OSD.os_dn(a0, a1, 0, 0); yb = OSDB.os_dn(b0, b1, 0, 0);
  ) : (
    a0 = (bd_th(dk * OSU.s0 + dbl) - dtl) * dnl; b0 = (bd_th(dk * OSUB.s0 + dbr) - dtr) * dnr;
    a1 = (bd_th(dk * OSU.s1 + dbl) - dtl) * dnl; b1 = (bd_th(dk * OSUB.s1 + dbr) - dtr) * dnr;
    a2 = (bd_th(dk * OSU.s2 + dbl) - dtl) * dnl; b2 = (bd_th(dk * OSUB.s2 + dbr) - dtr) * dnr;
    a3 = (bd_th(dk * OSU.s3 + dbl) - dtl) * dnl; b3 = (bd_th(dk * OSUB.s3 + dbr) - dtr) * dnr;
    y = OSD.os_dn(a0, a1, a2, a3); yb = OSDB.os_dn(b0, b1, b2, b3);
  );
) : (
  OSU.os_up(x); OSUB.os_up(xb);
  y = os_f == 1 ? OSU.s0 : OSD.os_dn(OSU.s0, OSU.s1, OSU.s2, OSU.s3);
  yb = os_f == 1 ? OSUB.s0 : OSDB.os_dn(OSUB.s0, OSUB.s1, OSUB.s2, OSUB.s3);
);
pwr_out(y, yb);
oa = pwr_l * og_s; ob = pwr_r * og_s;
os_q = os_g * os_g * (3 - 2 * os_g); oa *= os_q; ob *= os_q;
oa != oa ? oa = 0; ob != ob ? ob = 0;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_q = rs_f * rs_f * (3 - 2 * rs_f);
  pdc_delay > 0 ? ( rs_dl = BY_BUF[(by_w - pdc_delay) & (BY_N - 1)]; rs_dr = BY_BUF[BY_N + ((by_w - pdc_delay) & (BY_N - 1))]; )
                : ( rs_dl = spl0; rs_dr = spl1; );
  oa = rs_dl + (oa - rs_dl) * rs_q; ob = rs_dr + (ob - rs_dr) * rs_q;
);
spl0 = max(-4, min(4, oa));
spl1 = max(-4, min(4, ob));
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));
