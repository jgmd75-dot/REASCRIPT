);
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, sty, col, kind, name) local(k, v) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, sty, col); v = slider(idx);
  kind == 1 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) : kind == 7 ? sprintf(#mgv, "%+d %%", floor(v + (v < 0 ? -0.5 : 0.5))) :
  kind == 8 ? (v <= 20.5 ? strcpy(#mgv, "OFF") : sprintf(#mgv, "%d Hz", floor(v + 0.5))) : kind == 2 ? sprintf(#mgv, "%+.1f dB", v) :
  kind == 3 ? sprintf(#mgv, v < 1 ? "%.2f ms" : "%.1f ms", v) :
  kind == 5 ? (v >= 1000 ? sprintf(#mgv, "%.2f kHz", v / 1000) : sprintf(#mgv, "%d Hz", floor(v + 0.5))) :
  kind == 6 ? sprintf(#mgv, "%.1f dB", v) : sprintf(#mgv, v >= 1000 ? "%.2f s" : "%.0f ms", v >= 1000 ? v / 1000 : v);
  gfx_setfont(10); ui_col(k ? 0x1E6A3A : mk_ink); mg_ctxt(cx, ly, k ? #mgv : name);
  k;
);
function mg_vu(x, y, w, h, vdb, pk, cap) local(fx, fy, fw, fh, rad, px, py, i, t, a, s, ang0, ang1, c) (
  ui_vu_dim = slider10 >= 0.5;
  ui_spill((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 1);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, h + 18);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, 3); mg_r(x - 9, y - 6, 3, h + 15);
