desc:Transient [transient shaper] (GFX V4)
//tags: dynamics transient shaper attack sustain envelope drums v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-output, gfx-v4-drift, gfx-v4-ui, gfx-v4-panel, gfx-v4-os, gfx-v4-bypass, gfx-v4-power, gfx-v4-bands, gfx-v4-clip, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider29:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-100,100,1>-Low attack (%)
slider2:0<-100,100,1>-Low sustain (%)
slider3:20<5,60,0.1>-Low speed (ms)
slider4:250<50,1000,1>-Length (ms)
slider5:20<20,500,1>-Focus (Hz, 20 = off)
slider6:0<-12,12,0.1>-Output (dB)
slider7:100<0,100,1>-Mix (%)
slider8:0<0,100,1>-Fizz (%)
slider9:50<0,100,1>-Drift (%)
slider10:0<0,1,1{Off,On}>-Bypass
slider11:0<0,2,1{1x,2x,4x}>-Oversampling
slider12:0<0,1,1{2 bands,3 bands}>-Bands
slider13:150<40,1000,1>-Split low / mid (Hz)
slider14:3000<800,12000,1>-Split mid / high (Hz)
slider15:0<0,1,1{Shared,Own band}>-Band key
slider16:0<0,1,1{Off,On}>-Delta
slider17:0<0,1,1{Off,On}>-Clip 0 dB
slider18:1<0,1,1{Off,On}>-Low band
slider19:1<0,1,1{Off,On}>-Mid band
slider20:1<0,1,1{Off,On}>-High band
slider21:0<0,3,1{Off,Low,Mid,High}>-Solo
slider22:0<-100,100,1>-Mid attack (%)
slider23:0<-100,100,1>-Mid sustain (%)
slider24:20<5,60,0.1>-Mid speed (ms)
slider25:0<-100,100,1>-High attack (%)
slider26:0<-100,100,1>-High sustain (%)
slider27:20<5,60,0.1>-High speed (ms)
slider28:prs_sel=0<0,10,1{No preset,Init,Snappy Snare,Punchy Kick,Room Killer,Big Room,Soft Pick,Tight Bass,Drum Bus Snap,Snap Top Only,Loop Own Bands}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-v4-output.jsfx-inc
import gfx-v4-drift.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-os.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-power.jsfx-inc
import gfx-v4-bands.jsfx-inc
import gfx-v4-clip.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(536870911, v); );
function psw_allg(v) ( slider_show(536870911, v); );
#ui_man = "gfx-v4-transient";
ext_noinit = 1;

function tr_db2g(d) ( exp(d * 0.11512925465); );
function tr_g2db(g) ( 8.68588963807 * log(max(g, 0.0000000001)); );
function tr_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * srate)); );

function hp_set(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.7071); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function hp_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
function hp_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function tr_fset() ( hL.hp_set(tr_fs); hR.hp_set(tr_fs); );
function tb_det(d, csa) instance(ef, es, eh) (
  ef += (d - ef) * (d > ef ? tr_cfa : tr_cfr);
  es += (d - es) * (d > es ? csa : tr_cfr);
  eh += (d - eh) * (d > eh ? tr_cfa : tr_chr);
);
function tb_shape(at, st) instance(ef, es, eh, gdb, ac, sc) local(fd, hd, w) (
  fd = tr_g2db(ef); hd = tr_g2db(eh);
  w = min(max((hd + 66) / 12, 0), 1);
  ac = at * min(max(0, fd - tr_g2db(es)), 24) * 0.5; sc = st * min(max(0, hd - fd), 24) * 0.6 * w;
  gdb += (min(max(ac + sc, -24), 15) - gdb) * 0.35;
  gdb;
);
function tb_clr() instance(ef, es, eh, gdb) ( ef = es = eh = gdb = 0; );
function tb_tidy() instance(ef, es, eh) ( abs(ef) < 0.0000000001 ? ef = 0; abs(es) < 0.0000000001 ? es = 0; abs(eh) < 0.0000000001 ? eh = 0; );
function tr_setup() (
  tr_at = slider1 / 100 * tr_adr; tr_st = slider2 / 100;
  tr_at1 = slider22 / 100 * tr_adr; tr_st1 = slider23 / 100;
  tr_at2 = slider25 / 100 * tr_adr; tr_st2 = slider26 / 100;
  tr_cfa = tr_tc(0.0003); tr_cfr = tr_tc(0.03);
  tr_csa = tr_tc(slider3 * 0.001 * tr_sdr);
  tr_csa1 = tr_tc(slider24 * 0.001 * tr_sdr);
  tr_csa2 = tr_tc(slider27 * 0.001 * tr_sdr);
  tr_three = slider12 >= 0.5; tr_own = slider15 >= 0.5;
  tr_x1t = log(min(max(slider13, 40), 1000)); tr_x2t = log(max(min(max(slider14, 800), 12000), exp(tr_x1t) * 2));
  tr_on0 = slider18 >= 0.5; tr_on1 = slider19 >= 0.5; tr_on2 = slider20 >= 0.5;
  tr_so = slider21 | 0;
  tr_w0 = tr_so == 0 || tr_so == 1;
  tr_w2 = tr_so == 0 || tr_so == 3 || (tr_so == 2 && !tr_three);
  tr_w1 = tr_so == 0 || tr_so == 2 || (tr_so == 3 && !tr_three);
  tr_sol = tr_so > 0;
  tr_dlt = slider16 >= 0.5; tr_clt = slider17 >= 0.5;
  tr_chr = tr_tc(slider4 * 0.001 * tr_ldr);
  tr_ft = min(max(slider5, 20), 500); tr_foc = slider5 > 20.5;
  tr_gout = tr_db2g(slider6); tr_mix = slider7 / 100;
  tr_fzt = 0.33 * slider8 / 100;
);
function tr_rates() ( fz_coefs(srate * os_f); );
function tr_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  hL.hp_clr(); hR.hp_clr(); fz_clr();
  b0.tb_clr(); b1.tb_clr(); b2.tb_clr();
  spL.bs_clear(); spR.bs_clear(); ccL.clp_reset(); ccR.clp_reset(); tr_pyL = tr_pyR = 0;
);

function tr_pb(b, a, u, sp) ( b == 0 ? ( slider1 = a; slider2 = u; slider3 = sp; ) : b == 1 ? ( slider22 = a; slider23 = u; slider24 = sp; ) : ( slider25 = a; slider26 = u; slider27 = sp; ); );
function tr_pm(nb, x1, x2, ln, fo, m, fz) (
  slider12 = nb; slider13 = x1; slider14 = x2; slider4 = ln; slider5 = fo; slider7 = m; slider8 = fz;
  slider15 = 0; slider16 = 0; slider17 = 0; slider18 = slider19 = slider20 = 1; slider21 = 0;
  tr_pb(0, 0, 0, 20); tr_pb(1, 0, 0, 20); tr_pb(2, 0, 0, 20);
);
function load_preset(p) (
  p == 1 ? ( tr_pm(0, 150, 3000, 250, 20, 100, 0); slider6 = 0; slider9 = 50; ) :
  p == 2 ? ( tr_pm(1, 220, 3300, 200, 120, 100, 20); tr_pb(0, 0, 20, 20); tr_pb(1, 50, -10, 12); tr_pb(2, 60, -15, 12); ) :
  p == 3 ? ( tr_pm(0, 220, 3000, 180, 20, 100, 0); tr_pb(0, 30, -30, 25); tr_pb(2, 60, -20, 20); ) :
  p == 4 ? ( tr_pm(1, 220, 4400, 300, 60, 100, 0); tr_pb(0, 10, -50, 20); tr_pb(1, 10, -70, 20); tr_pb(2, 10, -70, 20); ) :
  p == 5 ? ( tr_pm(1, 220, 3300, 600, 60, 100, 0); tr_pb(0, -10, 70, 20); tr_pb(1, -10, 60, 20); tr_pb(2, -10, 40, 20); ) :
  p == 6 ? ( tr_pm(0, 660, 3000, 250, 150, 100, 0); tr_pb(0, -20, 10, 10); tr_pb(2, -50, 10, 10); ) :
  p == 7 ? ( tr_pm(0, 220, 3000, 150, 20, 100, 0); tr_pb(0, 10, -40, 30); tr_pb(2, 40, -30, 30); ) :
  p == 8 ? ( tr_pm(1, 220, 4400, 250, 80, 60, 15); tr_pb(0, 35, -10, 18); tr_pb(1, 25, -15, 18); tr_pb(2, 40, -20, 18); ) :
  p == 9 ? ( tr_pm(1, 220, 3300, 200, 20, 100, 0); tr_pb(2, 50, -10, 15); ) :
  p == 10 ? ( tr_pm(1, 110, 3300, 150, 20, 100, 0); slider15 = 1; tr_pb(0, 40, -20, 20); tr_pb(1, 20, -10, 15); tr_pb(2, 40, -30, 12); );
  slider_automate(134217727);
);

function tr_srinit() (
  tr_sr = srate;
  tr_smc = 1 - exp(-1 / (0.03 * srate));
  tr_fk = exp(-16 / (0.03 * srate));
  tr_fis = 1 / (0.01 * srate);
  gdc_r = 1 - 2 * $pi / srate;
  tr_setup(); tr_fs = tr_ft; tr_fset(); tr_rates(); tr_clear();
  tr_sw = 1 - exp(-1 / (0.012 * srate)); tr_xoc = 1 - exp(-16 / (0.03 * srate)); tr_rst = 1 / (0.010 * srate);
  tr_x1s = tr_x1t; tr_x2s = tr_x2t; bs_coef(exp(tr_x1s), exp(tr_x2s));
);
os_design();
os_f = os_tf = os_f2n(slider11); os_base = 0;
ost_init(0);
ost_setup(0, 0, 120, 6000, -0.3, 0);
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
tr_sdr = 1; tr_ldr = 1; tr_adr = 1;
dS.drift_init(0.8 + rand(1) * 0.5); dL.drift_init(0.8 + rand(1) * 0.5); dA.drift_init(0.8 + rand(1) * 0.5);
tr_oS = rand(2) - 1; tr_oL = rand(2) - 1;
tr_srinit();
ccL.clp_set(2, 1, 1, 0); ccR.clp_set(2, 1, 1, 0); ccL.clp_knee(0.2); ccR.clp_knee(0.2);
tr_b3s = tr_three; tr_o0s = tr_on0; tr_o1s = tr_on1; tr_o2s = tr_on2; tr_w0s = tr_w0; tr_w1s = tr_w1; tr_w2s = tr_w2; tr_sls = tr_sol; tr_dls = tr_dlt; tr_cls = tr_clt;
tr_at1s = tr_at1; tr_st1s = tr_st1; tr_at2s = tr_at2; tr_st2s = tr_st2;
tr_ats = tr_at; tr_sts = tr_st; tr_gos = tr_gout; tr_mxs = tr_mix; fz_s = tr_fzt; fz_o = 0;
tr_fi = 1;
os_gsetup();
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 0.5; pwr_wu_lp = 9000; pwr_wu_wob = 0.15; pwr_bloom = 0;
by_setup(10);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_sl() ( tr_setup(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(27, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
tr_setup();
os_snap(slider(11));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != tr_sr ? tr_srinit();
tr_now = time_precise();
tr_tp > 0 && tr_now - tr_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > tr_gpp && play_position - tr_gpp < 4 * tr_gpd + 0.05) ? ( tr_clear(); tr_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
tr_tp = tr_now; tr_gpp = play_position; tr_gpd = samplesblock / srate;
pwr_block(slider10 < 0.5);
os_tf = os_f2n(slider11);
drift_macro(slider9);
tr_inc = 0.05 * dm_s * samplesblock / srate;
tr_w1 = dS.drift_tick(tr_inc); tr_w2 = dL.drift_tick(tr_inc * 0.7); tr_w3 = dA.drift_tick(tr_inc * 1.3);
tr_sdr = 1 + dm_a * (0.05 * tr_w1 + 0.02 * tr_oS);
tr_ldr = 1 + dm_a * (0.06 * tr_w2 + 0.03 * tr_oL);
tr_adr = 1 + 0.04 * dm_a * tr_w3;
tr_setup();
pdc_bot_ch = 0; pdc_top_ch = 2;
b0.tb_tidy(); b1.tb_tidy(); b2.tb_tidy(); ccL.clp_tidy(); ccR.clp_tidy();
abs(tr_m0) > abs(tr_m0_d) ? tr_m0_d = tr_m0; tr_m0 = 0;
abs(tr_m1) > abs(tr_m1_d) ? tr_m1_d = tr_m1; tr_m1 = 0;
abs(tr_m2) > abs(tr_m2_d) ? tr_m2_d = tr_m2; tr_m2 = 0;
tr_vu_d = max(tr_vu_d, sqrt(tr_msq / max(samplesblock, 1))); tr_msq = 0;
tr_pk_d = max(tr_pk_d, tr_pkm); tr_pkm = 0;
os_snapb(slider(11));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; tr_iL = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; tr_iR = gdc_y1;
tr_ats += (tr_at - tr_ats) * tr_smc; tr_sts += (tr_st - tr_sts) * tr_smc;
tr_at1s += (tr_at1 - tr_at1s) * tr_smc; tr_st1s += (tr_st1 - tr_st1s) * tr_smc;
tr_at2s += (tr_at2 - tr_at2s) * tr_smc; tr_st2s += (tr_st2 - tr_st2s) * tr_smc;
tr_gos += (tr_gout - tr_gos) * tr_smc; abs(tr_gos - tr_gout) < 0.0000001 ? tr_gos = tr_gout;
tr_mxs += (tr_mix - tr_mxs) * tr_smc; abs(tr_mxs - tr_mix) < 0.0000001 ? tr_mxs = tr_mix;
tr_b3s += (tr_three - tr_b3s) * tr_sw;
tr_o0s += (tr_on0 - tr_o0s) * tr_sw; tr_o1s += (tr_on1 - tr_o1s) * tr_sw; tr_o2s += (tr_on2 - tr_o2s) * tr_sw;
tr_w0s += (tr_w0 - tr_w0s) * tr_sw; tr_w1s += (tr_w1 - tr_w1s) * tr_sw; tr_w2s += (tr_w2 - tr_w2s) * tr_sw;
tr_sls += (tr_sol - tr_sls) * tr_sw;
tr_dls != tr_dlt ? ( tr_dls = tr_dlt > tr_dls ? min(1, tr_dls + tr_rst) : max(0, tr_dls - tr_rst); );
tr_cls != tr_clt ? ( tr_cls = tr_clt > tr_cls ? min(1, tr_cls + tr_rst) : max(0, tr_cls - tr_rst); );
fz_s += (tr_fzt - fz_s) * tr_smc; fz_s < 0.000001 && tr_fzt == 0 ? fz_s = 0;
pwr_in(tr_iL, tr_iR); tr_iL = pwr_l; tr_iR = pwr_r;
tr_cc = (tr_cc + 1) & 15;
tr_cc == 0 ? (
  tr_fs != tr_ft ? ( tr_fs = tr_ft + (tr_fs - tr_ft) * tr_fk; abs(tr_fs - tr_ft) < 0.05 ? tr_fs = tr_ft; tr_fset(); );
  abs(tr_x1t - tr_x1s) > 0.0001 || abs(tr_x2t - tr_x2s) > 0.0001 ? (
    tr_x1s += (tr_x1t - tr_x1s) * tr_xoc; tr_x2s += (tr_x2t - tr_x2s) * tr_xoc; bs_coef(exp(tr_x1s), exp(tr_x2s));
  );
);
os_gate();
os_chg ? ( tr_rates(); uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); fz_clr(); os_hold += 2 * samplesblock; );
tr_hl = hL.hp_run(tr_iL); tr_hr = hR.hp_run(tr_iR);
tr_foc ? ( tr_dl = tr_hl; tr_dr = tr_hr; ) : ( tr_dl = tr_iL; tr_dr = tr_iR; );
spL.bs_split(tr_iL); spR.bs_split(tr_iR);
tr_own ? (
  tr_v0 = max(abs(spL.lo), abs(spR.lo)); tr_v1 = max(abs(spL.mi), abs(spR.mi));
