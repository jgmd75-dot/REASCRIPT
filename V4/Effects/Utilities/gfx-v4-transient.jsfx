abs(tr_e0) > abs(tr_m0) ? tr_m0 = tr_e0; abs(tr_e1) > abs(tr_m1) ? tr_m1 = tr_e1; abs(tr_e2) > abs(tr_m2) ? tr_m2 = tr_e2;
