@gfx 900 355
ui_begin(900, 355);
mk_face = 0xB2A4A4; mk_band = 0x0B0C0D; mk_ink = 0x24201C; mk_tab = 0x30C060; mk_tink = 0x2A2030;
mk_sub = 0xC0B3B3; mk_hot = 0xCFE0EA; mk_red = 0xE8584A;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.3);
sc != mg_fsc ? (
