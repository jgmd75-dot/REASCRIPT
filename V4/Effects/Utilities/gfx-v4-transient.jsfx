) : ( tr_v0 = tr_v1 = tr_v2 = max(abs(tr_dl), abs(tr_dr)); );
b0.tb_det(tr_v0, tr_csa); b1.tb_det(tr_v1, tr_csa1); b2.tb_det(tr_v2, tr_csa2);
tr_d0 = b0.tb_shape(tr_ats, tr_sts); tr_d1 = b1.tb_shape(tr_at1s, tr_st1s); tr_d2 = b2.tb_shape(tr_at2s, tr_st2s);
tr_g0 = (tr_db2g(tr_d0) - 1) * tr_o0s * tr_mxs;
tr_g2 = (tr_db2g(tr_d2) - 1) * tr_o2s * tr_mxs;
tr_g1 = tr_g2 + ((tr_db2g(tr_d1) - 1) * tr_o1s * tr_mxs - tr_g2) * tr_b3s;
tr_q = 1 - tr_sls;
tr_yL = tr_q * tr_iL + spL.lo * (tr_w0s * (1 + tr_g0) - tr_q) + spL.mi * (tr_w1s * (1 + tr_g1) - tr_q) + spL.hi * (tr_w2s * (1 + tr_g2) - tr_q);
tr_yR = tr_q * tr_iR + spR.lo * (tr_w0s * (1 + tr_g0) - tr_q) + spR.mi * (tr_w1s * (1 + tr_g1) - tr_q) + spR.hi * (tr_w2s * (1 + tr_g2) - tr_q);
