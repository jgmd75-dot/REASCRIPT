desc:ALIGN [phase / time align] (GFX V4)
//tags: align alignment phase polarity time delay correlation multi-mic DI utility v4
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-v4-input, gfx-v4-ui, gfx-v4-panel, gfx-v4-bypass, gfx-v4-sliders (.jsfx-inc) in the same folder.

slider10:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:al_shift=0<-20,20,0.01>-Shift (ms)
slider2:al_pol=0<0,1,1{Normal,Inverted}>-Polarity
slider3:al_rot=0<0,170,1>-Rotate (degrees)
slider4:al_at=110<40,400,1>-Rotate at (Hz)
slider5:al_range=1<0,2,1{5 ms,10 ms,20 ms}>-Range
slider6:al_sum=0<0,1,1{Off,On}>-Sum check
slider7:al_out=0<-12,12,0.1>-Output (dB)
slider8:al_byp=0<0,1,1{Off,On}>-Bypass
slider9:prs_sel=0<0,8,1{No preset,Init,Close Mics (5 ms),Room / DI (10 ms),Far Mics (20 ms),Snare Top / Bottom,Kick In / Out,Bass DI / Amp,Low End Rotate}>-Preset

in_pin:left input
in_pin:right input
in_pin:reference left
in_pin:reference right
out_pin:left output
out_pin:right output

import gfx-v4-input.jsfx-inc
import gfx-v4-ui.jsfx-inc
import gfx-v4-panel.jsfx-inc
import gfx-v4-bypass.jsfx-inc
import gfx-v4-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(1023, v); );
function psw_allg(v) ( slider_show(1023, v); );
#ui_man = "gfx-v4-align";
ext_noinit = 1;

AL_FA = 65536;
AL_FB = 131072;
AL_N = 32768; AL_CAP = 16384;
AL_DLN = 8192;
AL_BDL = 196608; AL_BDR = AL_BDL + AL_DLN; AL_BRL = AL_BDR + AL_DLN; AL_BRR = AL_BRL + AL_DLN;
memset(AL_BDL, 0, 4 * AL_DLN);

function al_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function al_op(f) ( 1 - exp(-2 * $pi * f / srate); );
function ap_run(x) instance(x1, y1) local(y) ( y = al_apcs * x + x1 - al_apcs * y1; x1 = x; y1 = y; y; );
function ap_clr() instance(x1, y1) ( x1 = y1 = 0; );
function al_rd(base, d) ( base[(al_wp - d + AL_DLN) % AL_DLN]; );

function al_analyse() local(i, re1, im1, re2, im2, pk, pv, k, mx, ea, eb, a, b, c, off) (
  ea = eb = 0; i = 0; loop(AL_CAP, ea += sqr(AL_FA[2 * i]); eb += sqr(AL_FB[2 * i]); i += 1; );
  fft(AL_FA, AL_N); fft(AL_FB, AL_N);
  i = 0;
  loop(AL_N,
    re1 = AL_FA[2 * i]; im1 = AL_FA[2 * i + 1]; re2 = AL_FB[2 * i]; im2 = AL_FB[2 * i + 1];
    AL_FA[2 * i] = re1 * re2 + im1 * im2; AL_FA[2 * i + 1] = im1 * re2 - re1 * im2;
    i += 1;
  );
  ifft(AL_FA, AL_N);
  mx = floor(al_rng * 0.001 * srate);
  pk = 0; pv = 0; k = -mx;
  loop(2 * mx + 1,
    i = k >= 0 ? k : AL_N + k;
    abs(AL_FA[2 * i]) > abs(pv) ? ( pv = AL_FA[2 * i]; pk = k; );
    k += 1;
  );
  i = pk >= 0 ? pk : AL_N + pk;
  a = AL_FA[2 * ((i - 1 + AL_N) % AL_N)]; b = AL_FA[2 * i]; c = AL_FA[2 * ((i + 1) % AL_N)];
  off = (a - 2 * b + c) != 0 ? 0.5 * (a - c) / (a - 2 * b + c) : 0;
  al_res_f = pk + min(max(off, -0.5), 0.5);
  al_res_pol = pv < 0;
  al_res_m = abs(pv) / AL_N / sqrt(max(ea * eb, 0.0000000001));
  al_res_ok = al_res_m >= 0.3;
  al_res_ok ? (
    al_shift = floor(pk / srate * 100000 + 0.5) / 100; al_pol = al_res_pol;
    slider_automate(al_shift); slider_automate(al_pol);
  );
  al_state = 3;
);

function setp(rot, at, rng, sm) (
  al_rot = rot; al_at = at; al_range = rng; al_sum = sm;
);
function load_preset(p) (
  p == 1 ? ( al_shift = 0; al_pol = 0; setp(0, 110, 1, 0); al_out = 0; ) :
  p == 2 ? setp(0, 110, 0, 0) :
  p == 3 ? setp(0, 110, 1, 0) :
  p == 4 ? setp(0, 110, 2, 0) :
  p == 5 ? ( setp(0, 110, 0, 0); al_pol = 1; ) :
  p == 6 ? setp(0, 110, 1, 0) :
  p == 7 ? setp(0, 110, 1, 0) :
  p == 8 ? setp(90, 110, 1, 0);
  slider_automate(255);
);

function al_srinit() (
  al_sr = srate;
  al_csm = 1 - exp(-1 / (0.3 * srate));
  al_klo = al_op(200);
  al_gs = 1 - exp(-1 / (0.015 * srate));
  al_ags = 1 - exp(-1 / (0.03 * srate));
  al_xs = 1 / (0.02 * srate);
  al_fis = 1 / (0.01 * srate);
);
function al_clear() (
  memset(AL_BDL, 0, 4 * AL_DLN);
  apL.ap_clr(); apR.ap_clr();
  al_fla = al_flb = 0;
);
function al_lat() local(s) (
  s = min(max(al_shift, -20), 20) * 0.001 * srate; s = s >= 0 ? floor(s + 0.5) : -floor(-s + 0.5);
  al_sh = s; al_D = max(s, 0); al_L = max(-s, 0);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = al_L;
);
function update() local(t) (
  al_rng = al_range < 0.5 ? 5 : al_range < 1.5 ? 10 : 20;
  al_lat();
  al_ang = min(max(al_rot, 0), 170);
  al_ang > 0.5 ? (
    al_fc = min(max(al_at, 40), 400) / tan(al_ang * $pi / 360);
    t = tan($pi * min(al_fc, 0.45 * srate) / srate); al_apc = (t - 1) / (t + 1);
  );
  al_rot_t = al_ang > 0.5;
  al_polt = al_pol >= 0.5 ? -1 : 1;
  al_sum_t = al_sum >= 0.5;
  al_outt = 10 ^ (min(max(al_out, -12), 12) / 20);
);

al_srinit();
in_init();
al_wp = 0; al_dA = al_dB = 0; al_lA = al_lB = 0; al_xf = 0; al_first = 1;
al_state = 0; al_fi = 1;
update();
al_apcs = al_ang > 0.5 ? al_apc : 0;
al_pols = al_polt; al_outs = al_outt; al_sums = al_sum_t; al_rots = al_rot_t;
by_setup(8);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(8, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); update();
      prs_q ? ( k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != al_sr ? al_srinit();
al_now = time_precise();
al_tp > 0 && al_now - al_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > al_gpp && play_position - al_gpp < 4 * al_gpd + 0.05) ? ( al_clear(); al_fi = 0; );
al_tp = al_now; al_gpp = play_position; al_gpd = samplesblock / srate;
in_setup(0, 0);
al_req_dirty == 1 ? ( al_state = 1; al_ci = 0; ) : al_req_dirty == 2 ? al_state = 0;
al_req_dirty = 0;
update();
al_xf <= 0 && (al_D != al_dB || al_L != al_lB) ? ( al_dA = al_dB; al_lA = al_lB; al_dB = al_D; al_lB = al_L; al_xf = al_first ? 1 : 0.000001; );
al_first = 0;
al_state == 2 && al_ci >= AL_CAP ? ( al_analyse(); update(); );
apL.x1 = al_tn(apL.x1); apL.y1 = al_tn(apL.y1); apR.x1 = al_tn(apR.x1); apR.y1 = al_tn(apR.y1);
al_cab = al_tn(al_cab); al_caa = al_tn(al_caa); al_cbb = al_tn(al_cbb);
al_lab = al_tn(al_lab); al_laa = al_tn(al_laa); al_lbb = al_tn(al_lbb);
al_cf_d = al_caa > 0.0000000001 && al_cbb > 0.0000000001 ? al_cab / sqrt(al_caa * al_cbb) : 0;
al_cl_d = al_laa > 0.0000000001 && al_lbb > 0.0000000001 ? al_lab / sqrt(al_laa * al_lbb) : 0;
al_live_d = al_caa > 0.0000000001 && al_cbb > 0.0000000001;
al_st_d = al_state; al_rf_d = al_res_f; al_rp_d = al_res_pol; al_rm_d = al_res_m; al_rok_d = al_res_ok;
al_ref_d = max(al_ref_d, al_pr); al_pr = 0;
al_pk_d = max(al_pk_d, al_po); al_po = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0; spl2 != spl2 ? spl2 = 0; spl3 != spl3 ? spl3 = 0;
by_in();
in_process(spl0, spl1);
al_xl = in_l; al_xr = in_r; al_rl = spl2; al_rr = spl3;
al_pr = max(al_pr, max(abs(al_rl), abs(al_rr)));
al_state == 1 && max(abs(al_xl), abs(al_xr)) > 0.003 && max(abs(al_rl), abs(al_rr)) > 0.003 ? (
  al_state = 2; al_ci = 0; memset(AL_FA, 0, 2 * AL_N); memset(AL_FB, 0, 2 * AL_N);
);
al_state == 2 && al_ci < AL_CAP ? (
  AL_FA[2 * al_ci] = 0.5 * (al_rl + al_rr); AL_FB[2 * al_ci] = 0.5 * (al_xl + al_xr); al_ci += 1;
);
AL_BDL[al_wp] = al_xl; AL_BDR[al_wp] = al_xr; AL_BRL[al_wp] = al_rl; AL_BRR[al_wp] = al_rr;
al_xf > 0 ? (
  al_e = al_xf * al_xf * (3 - 2 * al_xf);
  al_yl = al_rd(AL_BDL, al_dA) + al_e * (al_rd(AL_BDL, al_dB) - al_rd(AL_BDL, al_dA));
  al_yr = al_rd(AL_BDR, al_dA) + al_e * (al_rd(AL_BDR, al_dB) - al_rd(AL_BDR, al_dA));
  al_ql = al_rd(AL_BRL, al_lA) + al_e * (al_rd(AL_BRL, al_lB) - al_rd(AL_BRL, al_lA));
  al_qr = al_rd(AL_BRR, al_lA) + al_e * (al_rd(AL_BRR, al_lB) - al_rd(AL_BRR, al_lA));
  al_xf += al_xs; al_xf >= 1 ? al_xf = 0;
) : (
  al_yl = al_rd(AL_BDL, al_dB); al_yr = al_rd(AL_BDR, al_dB); al_ql = al_rd(AL_BRL, al_lB); al_qr = al_rd(AL_BRR, al_lB);
);
al_wp = (al_wp + 1) % AL_DLN;
al_pols += (al_polt - al_pols) * al_gs;
al_yl *= al_pols; al_yr *= al_pols;
al_rots += (al_rot_t - al_rots) * al_gs;
al_rot_t ? al_apcs += (al_apc - al_apcs) * al_ags;
al_rots > 0.0005 ? ( al_yl += al_rots * (apL.ap_run(al_yl) - al_yl); al_yr += al_rots * (apR.ap_run(al_yr) - al_yr); );
al_a = 0.5 * (al_yl + al_yr); al_b = 0.5 * (al_ql + al_qr);
al_cab += (al_a * al_b - al_cab) * al_csm; al_caa += (al_a * al_a - al_caa) * al_csm; al_cbb += (al_b * al_b - al_cbb) * al_csm;
al_fla += al_klo * (al_a - al_fla); al_flb += al_klo * (al_b - al_flb);
al_lab += (al_fla * al_flb - al_lab) * al_csm; al_laa += (al_fla * al_fla - al_laa) * al_csm; al_lbb += (al_flb * al_flb - al_lbb) * al_csm;
al_sums += (al_sum_t - al_sums) * al_gs;
al_sums > 0.0005 ? ( al_yl += al_sums * al_ql; al_yr += al_sums * al_qr; );
al_outs += (al_outt - al_outs) * al_gs;
al_yl *= al_outs; al_yr *= al_outs;
al_fi < 1 ? (
  al_fi = min(al_fi + al_fis, 1); al_z = al_fi * al_fi * (3 - 2 * al_fi);
  al_yl = by_il + (al_yl - by_il) * al_z; al_yr = by_ir + (al_yr - by_ir) * al_z;
);
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); al_yl *= prs_w; al_yr *= prs_w; );
spl0 = max(-4, min(4, al_yl));
spl1 = max(-4, min(4, al_yr));
by_out();
spl2 = spl3 = 0;
al_po = max(al_po, max(abs(spl0), abs(spl1)));

@gfx 900 355
function v4rd_c(c) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = 1; );
function v4rd_mx(c, t, f) ( (floor(((c >> 16) & 255) * (1 - f) + ((t >> 16) & 255) * f) << 16) + (floor(((c >> 8) & 255) * (1 - f) + ((t >> 8) & 255) * f) << 8) + floor((c & 255) * (1 - f) + (t & 255) * f); );
function v4rd(gx0, gy0, k, rad, c1, c2, c3) local(q, i, yd, gx, hw, j, n, xl, xr, il, ir, rr) (
  q = k * rad / 17;
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 17 * q, 1, 1);
  v4rd_c(0xE8EBEE); gfx_circle(gx0, gy0, 15 * q, 1, 1);
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 13 * q, 1, 1);
  i = 0;
  loop(3,
    v4rd_c(i == 0 ? c1 : i == 1 ? c2 : c3);
    yd = -12.2 + i * 2.6;
    gx = gx0 + 0.5; hw = sqrt(max(sqr(13.6) - sqr(yd + 0.8), 0)) * q;
    j = floor(gy0 + yd * q + 1); n = max(1, floor(1.6 * q));
    xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
    hw > 0 ? loop(n,
      il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
        gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
        gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
        gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
      );
      j += 1;
    );
    i += 1;
  );
  v4rd_c(0xE8EBEE);
  rr = 13 * q + 0.75; while (rr <= 15 * q - 0.75) ( gfx_circle(gx0, gy0, rr, 0, 1); rr += 0.5; );
  gfx_a = 1;
);
ui_begin(900, 355);
mk_face = 0x242426; mk_band = 0x0A0A0B; mk_ink = 0xF2F0E8; mk_tab = 0xFFD21F; mk_tink = 0x141210;
mk_sub = 0x141415; mk_hot = 0xFFE680; mk_lime = 0xFFD21F;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.3);
mg_byp = 8;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(15, "Courier New", 24 * sc, 'b'); gfx_setfont(16, "Courier New", 16 * sc, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, p0, p1) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; p0 = floor(xl); p1 = floor(xr);
  hw > 0 ? loop(n,
    p0 == p1 ? ( gfx_a = xr - xl; gfx_rect(p0, j, 1, 1); ) : (
      gfx_a = p0 + 1 - xl; gfx_rect(p0, j, 1, 1);
      gfx_a = 1; p1 > p0 + 1 ? gfx_rect(p0 + 1, j, p1 - p0 - 1, 1);
      gfx_a = xr - p1; xr > p1 ? gfx_rect(p1, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(mk_sub, 0x000000, 0.3)); mg_r(x + 9, y + b + 33, w - 18, 1);
