hmg_cap(536, 563, "WHEEL");
hmg_dd(584, 556, 104, 28, 52, 0, 2, "Void width|Cloud density", slider52 >= 0.5 ? "DENSITY" : "WIDTH");
ui_col(INK); hmg_rr(698, 556, 82, 28, 3); ui_col(SCR); hmg_rr(699.5, 557.5, 79, 25, 2);
gfx_setfont(11); ui_col(PH); sprintf(#hmg_g, "%d HELD", 0); hmg_n = 0; hmg_j = 0; loop(NVD, hmg_q = VD + hmg_j * VDS; hmg_q[0] && (hmg_q[4] || hmg_q[5]) ? hmg_n += 1; hmg_j += 1; );
sprintf(#hmg_g, "%d HELD", hmg_n); hmg_tc(739, 570, #hmg_g);

// ======================== REVERB ========================
hmg_sect(802, 428, 376, 176, "REVERB  ·  THE DEEP");
hmg_toggle(1104, 430, 66, 20, 43, "IN");
hmg_knob(852, 500, 21, 44, 0, 100, 80, 0, "SIZE", "%.0f%%", 0, 0, -1, 0);
hmg_knob(940, 500, 21, 45, 1, 30, 9, 1, "DECAY", "%.1f s", 0, 0, -1, 0);
hmg_knob(1028, 500, 21, 46, 0, 100, 55, 0, "DAMP", "%.0f%%", 0, 0, -1, 1);
hmg_knob(1116, 500, 21, 47, 0, 100, 45, 0, "MIX", "%.0f%%", 0, 0, -1, 0);
// the decay, sketched (a minute across)
hmg_gx = 814; hmg_gy = 554; hmg_gw = 352; hmg_gh = 38;
ui_col(INK); hmg_rr(hmg_gx - 2, hmg_gy - 2, hmg_gw + 4, hmg_gh + 4, 3); ui_col(SCR); hmg_rr(hmg_gx, hmg_gy, hmg_gw, hmg_gh, 2);
hmg_i = 0;
loop(61, hmg_u = hmg_i / 60; hmg_v = 10 ^ (-3 * hmg_u * 30 / slider45);
  hmg_x = hmg_gx + 4 + hmg_u * (hmg_gw - 8); hmg_y = hmg_gy + hmg_gh - 5 - hmg_v * (hmg_gh - 10);
  hmg_i > 0 ? ( ui_col(slider43 >= 0.5 ? PH : PHD); hmg_l1(hmg_ox, hmg_oy, hmg_x, hmg_y); ); hmg_ox = hmg_x; hmg_oy = hmg_y; hmg_i += 1; );
gfx_setfont(11); ui_col(PHD); hmg_tr(hmg_gx + hmg_gw - 6, hmg_gy + 10, "30 s");

