  gfx_setfont(11); ui_col(LBL); hmg_tc(70, 724, "TIME");
) : hmg_knob(70, 704, 18, 36, 40, 2000, 640, 1, "TIME", "%.0f ms", 0, 0, -1, 0);
hmg_knob(160, 694, 21, 39, 0, 120, 45, 0, "FEEDBACK", "%.0f%%", 0, 0, -1, 0);
hmg_knob(236, 694, 21, 40, 0, 100, 45, 0, "TONE", "%.0f%%", 0, 0, -1, 1);
hmg_knob(312, 694, 21, 41, 0, 100, 30, 0, "SHIFT", "%.0f%%", 0, 0, -1, 0);
hmg_knob(388, 694, 21, 42, 0, 100, 30, 0, "MIX", "%.0f%%", 0, 0, -1, 0);
// the two reels: they turn with the tape's speed; past 100 % feedback the loop lamp lights (it sings by itself)
hmg_dt = time_precise() - hmg_tlast; hmg_tlast = time_precise(); hmg_dt = min(max(hmg_dt, 0), 0.2);
hmg_reel += hmg_dt * (slider35 >= 0.5 ? 1.2 * 640 / max(hm_dts / srate * 1000, 40) : 0) * (1 + 0.5 * hm_esh * hm_dew);
hmg_j = 0;
loop(2,
  hmg_cx = 470 + hmg_j * 76; hmg_cy = 690;
  ui_col(INK); hmg_disc(hmg_cx, hmg_cy, 29); ui_col(SKIRT); hmg_disc(hmg_cx, hmg_cy, 27.5);
  ui_col(TRAY); hmg_ring(hmg_cx, hmg_cy, 21); ui_col(INK); hmg_disc(hmg_cx, hmg_cy, 6); ui_col(KCAP); hmg_disc(hmg_cx, hmg_cy, 4.5);
  hmg_i = 0; loop(3, hmg_a = hmg_reel * (hmg_j ? 1.15 : 1) + hmg_i * 2 * $pi / 3;
    ui_col(KCAP); hmg_ln(hmg_cx + sin(hmg_a) * 8, hmg_cy - cos(hmg_a) * 8, hmg_cx + sin(hmg_a) * 20, hmg_cy - cos(hmg_a) * 20, 2.2); hmg_i += 1; );
  hmg_j += 1;
);
ui_col(INK); hmg_l1(470, 719, 546, 719); ui_col(AMBD); hmg_r(470, 718, 76, 1);
pk_led(508 * sc, 742 * sc, 4.5 * sc, slider39 > 100 && slider35 >= 0.5, AMB);
gfx_setfont(11); ui_col(LBL); hmg_t(518, 735, "SELF-OSC");

// ======================== FATE: WEATHER, SCAR TISSUE, PENDULUM ========================
hmg_sect(598, 612, 580, 150, "FATE  ·  WEATHER · SCAR TISSUE · PENDULUM");
hmg_knob(652, 694, 26, 48, 0, 100, 50, 0, "FATE", "%.0f%%", 0, 0, -1, 0);
// WEATHER: the three fronts now (density, brightness, register), each a bar either side of the middle
hmg_gx = 712; hmg_gy = 646; hmg_gw = 150; hmg_gh = 96;
ui_col(INK); hmg_rr(hmg_gx - 2, hmg_gy - 2, hmg_gw + 4, hmg_gh + 4, 3); ui_col(SCR); hmg_rr(hmg_gx, hmg_gy, hmg_gw, hmg_gh, 2);
gfx_setfont(11); ui_col(PH); hmg_t(hmg_gx + 8, hmg_gy + 4, "WEATHER");
hmg_i = 0;
loop(3,
  hmg_v = hmg_i == 0 ? hm_wden / 0.9 : hmg_i == 1 ? hm_wbri / 1.4 : hm_wreg / 8; hmg_v = min(max(hmg_v, -1), 1);
  hmg_y = hmg_gy + 32 + hmg_i * 22;
  ui_col(PHD); hmg_t(hmg_gx + 8, hmg_y - 7, pk_pitem("DENS|BRIG|REG", hmg_i + 1, #hmg_k));
  ui_col(GRID); hmg_r(hmg_gx + 54, hmg_y - 2, 88, 4); ui_col(PHD); hmg_r(hmg_gx + 97.5, hmg_y - 5, 1, 10);
  ui_col(PH); hmg_v >= 0 ? hmg_r(hmg_gx + 98, hmg_y - 2, 44 * hmg_v, 4) : hmg_r(hmg_gx + 98 + 44 * hmg_v, hmg_y - 2, -44 * hmg_v, 4);
  hmg_i += 1;
);
// SCAR TISSUE: each void's pace and its lingering trace
hmg_gx = 872; hmg_gy = 646; hmg_gw = 140;
ui_col(INK); hmg_rr(hmg_gx - 2, hmg_gy - 2, hmg_gw + 4, hmg_gh + 4, 3); ui_col(SCR); hmg_rr(hmg_gx, hmg_gy, hmg_gw, hmg_gh, 2);
gfx_setfont(11); ui_col(PH); hmg_t(hmg_gx + 8, hmg_gy + 4, "SCAR TISSUE");
hmg_j = 0; hmg_n = 0;
loop(NVD,
  hmg_q = VD + hmg_j * VDS;
  hmg_q[0] && hmg_n < 5 ? (
    hmg_y = hmg_gy + 30 + hmg_n * 13;
    ui_col(PHD); hmg_t(hmg_gx + 8, hmg_y - 6, hmg_nname(hmg_q[1]));
    ui_col(GRID); hmg_r(hmg_gx + 44, hmg_y - 1, 88, 3);
    ui_col(PH); hmg_r(hmg_gx + 44, hmg_y - 1, 88 * min(hmg_q[11] / max(hmg_q[2], 0.0001), 1), 3);
    ui_col(AMB); hmg_r(hmg_gx + 44 + 88 * min(hmg_q[9] * 2, 1), hmg_y - 3, 1.5, 7);
    hmg_n += 1;
  );
  hmg_j += 1;
);
hmg_n == 0 ? ( ui_col(PHD); hmg_tc(hmg_gx + hmg_gw * 0.5, hmg_gy + 56, "NO WOUNDS"); );
// PENDULUM: the body suspended, swaying
hmg_gx = 1022; hmg_gw = 146;
ui_col(INK); hmg_rr(hmg_gx - 2, hmg_gy - 2, hmg_gw + 4, hmg_gh + 4, 3); ui_col(SCR); hmg_rr(hmg_gx, hmg_gy, hmg_gw, hmg_gh, 2);
gfx_setfont(11); ui_col(PH); hmg_t(hmg_gx + 8, hmg_gy + 4, "PENDULUM");
hmg_a = hm_psw * 0.45 * min(hm_fa, 2) / 2;
hmg_cx = hmg_gx + hmg_gw * 0.5; hmg_cy = hmg_gy + 20;
ui_col(PHD); hmg_r(hmg_cx - 22, hmg_cy - 1, 44, 1.5);
hmg_x = hmg_cx + sin(hmg_a) * 52; hmg_y = hmg_cy + cos(hmg_a) * 52;
ui_cola(PH, 0.9); hmg_l1(hmg_cx, hmg_cy, hmg_x, hmg_y);
ui_cola(PH, 0.25); gfx_arc(hmg_cx * sc, hmg_cy * sc, 52 * sc, $pi - 0.5, $pi + 0.5, 1);
ui_col(AMB); hmg_itri(hmg_x, hmg_y + 2, 7, 1); ui_col(AMBL); hmg_disc(hmg_x, hmg_y + 13, 3);

// ======================== the foot of the card: VOLUME, LEVEL, the name plate, SAT, the level ========================
ui_col(INK); hmg_r(13, 768, 1174, 2);
ui_col(BAND); hmg_r(13, 770, 1174, 67);
ui_col(RULE); hmg_r(13, 770, 1174, 1);
hmg_knob(48, 803, 13, 49, -24, 6, -3, 0, "", "%+.1f dB", 0, 0, -1, 0);
drag_id != 2049 && !(sqr(mouse_x - 48 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(CHL); hmg_t(70, 794, "VOLUME"); );
hmg_knob(176, 803, 13, 50, 0, 100, 60, 0, "", "%.0f%%", 0, 0, -1, 0);
drag_id != 2050 && !(sqr(mouse_x - 176 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(CHL); hmg_t(198, 794, "LEVEL"); );
// the name plate, between two hanging figures
ui_col(INK); hmg_rr(430, 781, 340, 44, 5); ui_col(BANDL); hmg_rr(432, 783, 336, 40, 4);
ui_col(RULE); hmg_r(440, 818, 320, 1);
ui_col(AMB); hmg_itri(450, 800, 7, 0); hmg_itri(750, 800, 7, 0);
gfx_setfont(14); ui_col(CHL); hmg_tc(600, 802, "THE HANGED MAN");
hmg_figure(400, 800, 15, RULE, 0.6); hmg_figure(800, 800, 15, RULE, 0.6);
ins_io(960, 785, 53, CHL);
hmg_lv = min(max((20 * log10(max(hm_pk, 0.00001)) + 48) / 48, 0), 1);
ui_col(INK); hmg_r(1060, 802, 112, 14); ui_col(SCR); hmg_r(1061.5, 803.5, 109, 11);
hmg_i = 0; loop(18, hmg_on = hmg_i / 18 < hmg_lv; ui_col(hmg_on ? (hmg_i >= 16 ? 0xFF4A3A : hmg_i >= 13 ? AMB : PH) : 0x0F2228); hmg_r(1063 + hmg_i * 6, 805, 4.6, 8); hmg_i += 1; );
gfx_setfont(11); ui_col(CHL); hmg_t(1060, 786, "OUTPUT");
pk_end();
ui_end();
