desc:GFX G Hanged Man [Arcana synth]
//tags: instrument synth drone ambient generative cloud texture subtractive reverse reverb tape-echo arcana
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument, gfx-voice and gfx-clip (.jsfx-inc) in the same folder.
//
// THE HANGED MAN (card XII of the GFX Arcana series): suspension, surrender, the world seen upside down; nothing is
// done, and by not doing, everything changes.
// A generative ambient cloud that you play by SUBTRACTION. The cloud plays itself; MIDI notes do not add a voice: they
// CARVE a silence into the cloud at their pitch, each note sends a reverse plume swelling backwards out of the hole,
// and over the CYCLE the voids slowly heal and the cloud closes over them again.
//   THE CLOUD  48 quiet sustained partials (pure, band-limited sines, each with a soft octave overtone), every one
//              born on a note of the KEY (ROOT and SCALE: 17 modes, pentatonics and a few exotic scales) somewhere in
//              the REGISTER (LOW .. HIGH), swelling in, living a while, fading out and being born again elsewhere.
//              MICRO: each partial's own slow microtonal wander (0 - 50 cents). DENSITY: how many partials live at
//              once (4 .. 48; the level stays even - it is how thick, not how loud). INERTIA: how slowly everything
//              moves (swells of about 2 s .. 30 s, lives of 4 s .. 45 s, the wander from quick to glacial). DENSITY and
//              INERTIA are heavy oil-damped knobs: the knob follows the hand at once, but the cloud follows the knob
//              over about a second and a half (a small bead on the ring shows where the oil has let the sound go). BRIGHTNESS: the cloud's tilt, its
//              overtones and a gentle 12 dB low-pass (400 Hz .. 18 kHz). SPREAD: the partials across the stereo
//              field. LEVEL.
//              RUN (lit) wakes the cloud by hand: it swells in over about three seconds and fades away over about four
//              when let go; it loads off and presets never press it. TRANSPORT (lit by default): REAPER's play /
//              record presses RUN and its stop releases it; RUN still works by hand. Off, RUN ignores the transport.
//   LFO MATRIX four ultra-slow sine LFOs (periods of 2 s .. 5 min, set on RATE), each wired to one destination, with
//              a slow-glide DEPTH fader: TUNE (the whole cloud's tuning, +/- 25 cents), DRIFT (the partials pulled
//              apart and drawn together again, +/- 30 cents each, opposite ways), FILTER (the low-pass, +/- 2
//              octaves) and TIME (the partials' lives and wanders run faster / slower, up to 2.8x either way; the tape
//              echo's speed leans with it). The marker beside each fader shows where its LFO is now.
//   THE CLEARING  a note carves a void into the cloud at its pitch: the partials there fade out (the generator
//              stops giving birth there), leaving a clean hole. DEPTH (how silent the void is), WIDTH (its half-width,
//              0.1 - 3 semitones; full depth inside it, a soft shoulder out to twice that), SPEED (how fast it clears,
//              5 ms - 4 s), VELOCITY (how much a harder note carves deeper), RESONANCE (the partials just outside the
//              void ring louder and the cloud gathers new partials on the scale notes beside it: a resonant halo
//              round the hole), OCTAVES (lit: the void is carved in every octave of that pitch class). The mod wheel
//              widens the voids (up to +2.5 semitones) or thins the cloud (WHEEL: WIDTH / DENSITY).
//   REVERSE PLUME  every note also plays the cloud's (and the reverb's) last moments BACKWARDS, band-passed round its
//              pitch (folded into the register), swelling away from the note: a localised reverse reverb, with a
//              second backward head behind it (TAIL: a backward echo). Slow-glide faders: LENGTH (0.5 - 6 s, the
//              reverse decay), CURVE (how late the swell comes), TAIL, LEVEL; and TONE (narrow and ringing .. wide
//              and breathy). The plumes go heavily into the reverb.
//   REGENERATION  the voids heal over the CYCLE (a drop-down: 1 .. 32 bars at the project tempo, or 5 s .. 5 min):
//              HEAL is the curve of the return (FAST: most of it comes back early; SLOW: the hole stays open and closes
//              late; centre: even). HOLD (lit): a held key (or the sustain pedal) keeps its void open until it is let
//              go, then it heals; off, every void starts healing at once.
//   TAPE ECHO  an analogue-style tape echo: TIME (40 ms - 2 s) or SYNC (lit) to a division (1/16 .. 1 bar), FEEDBACK
//              (0 - 120 %: past 100 % it self-oscillates, held by a soft anti-aliased saturator in the loop - it can
//              never run away; while the cloud is stopped the feedback is held below 85 % so it dies away), TONE (the
//              loop's low-pass; a 60 Hz high-pass keeps it clean), SHIFT (the tape's speed wanders as the cloud
//              evolves - wow, a slow speed drift and the TIME LFO - bending the repeats' pitch), MIX. IN (lit).
//   REVERB     massive, dark and diffusing: eight long lines (Hadamard), four diffusers, a 25 ms pre-delay: SIZE,
//              DECAY (1 - 30 s), DAMP (the darkness), MIX. IN (lit). It catches the plumes and the echoes.
//   FATE       the series' drift (0 - 100 %, 50 % = the standard amount; 0 = none), all three of the Hanged Man's at once:
//              WEATHER (the cloud's density, brightness and register slowly shift like weather fronts, over
//              minutes), SCAR TISSUE (each void heals at its own pace and some leave a faint trace that lingers for
//              another half cycle or more), PENDULUM (the whole cloud sways - a few cents of pitch, the stereo field
//              and its depth in the reverb - like a body suspended).
//   VOLUME, LEVEL, SAT (the output soft clip is always on).
// The display: the cloud as a ghost-phosphor mass hanging from the beam (each partial a thread; its history sinking
// downwards), the voids as bright hollow tunnels through it that narrow and close as they heal, the plumes as amber
// light swelling backwards into the note. MIDI: notes, sustain (CC64: holds the voids), mod wheel, all notes off
// (CC120 / 123); channel select. Pitch bend is not used. MIDI passes through.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{Off,On}>-Run
slider2:1<0,1,1{Off,On}>-Transport (follows REAPER play state)
slider3:2<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Root
slider4:1<0,16,1{Major (Ionian),Dorian,Phrygian,Lydian,Mixolydian,Minor (Aeolian),Locrian,Major pentatonic,Minor pentatonic,Suspended pentatonic,Harmonic minor,Melodic minor,Whole tone,Hirajoshi,In Sen,Hungarian minor,Double harmonic}>-Scale
slider5:43<24,96,1>-Register low (MIDI note)
slider6:84<24,108,1>-Register high (MIDI note)
slider7:10<0,50,0.1>-Micro wander (cents)
slider8:55<0,100,0.1>-Density (%)
slider9:50<0,100,0.1>-Inertia (%)
slider10:45<0,100,0.1>-Brightness (%)
slider11:70<0,100,1>-Spread (%)
slider12:75<0,100,1>-Cloud level (%)
slider13:47<2,300,0.1>-LFO tune period (s)
slider14:25<0,100,0.1>-LFO tune depth (%)
slider15:31<2,300,0.1>-LFO drift period (s)
slider16:30<0,100,0.1>-LFO drift depth (%)
slider17:73<2,300,0.1>-LFO filter period (s)
slider18:30<0,100,0.1>-LFO filter depth (%)
slider19:113<2,300,0.1>-LFO time period (s)
slider20:30<0,100,0.1>-LFO time depth (%)
slider21:100<0,100,1>-Void depth (%)
slider22:0.6<0.1,3,0.01>-Void width (semitones)
slider23:300<5,4000,1>-Void speed (ms)
slider24:40<0,100,1>-Void velocity (%)
slider25:35<0,100,1>-Resonance (%)
slider26:1<0,1,1{Off,On}>-Octaves
slider27:1<0,1,1{Off,On}>-Hold
slider28:60<0,100,0.1>-Plume level (%)
slider29:2.5<0.5,6,0.01>-Plume length (s)
slider30:50<0,100,0.1>-Plume curve (%)
slider31:35<0,100,0.1>-Plume tail (%)
slider32:40<0,100,1>-Plume tone (%)
slider33:3<0,12,1{1 bar,2 bars,4 bars,8 bars,16 bars,32 bars,5 s,10 s,20 s,30 s,1 min,2 min,5 min}>-Cycle
slider34:0<-100,100,1>-Heal curve (fast - slow)
slider35:1<0,1,1{Out,In}>-Echo
slider36:640<40,2000,1>-Echo time (ms)
slider37:0<0,1,1{Off,On}>-Echo sync
slider38:6<0,9,1{1/16,1/8T,1/8,1/4T,1/8D,1/4,1/4D,1/2,1/2D,1 bar}>-Echo synced time
slider39:45<0,120,1>-Echo feedback (%)
slider40:45<0,100,1>-Echo tone (%)
slider41:30<0,100,1>-Echo shift (%)
slider42:30<0,100,1>-Echo mix (%)
slider43:1<0,1,1{Out,In}>-Reverb
slider44:80<0,100,1>-Reverb size (%)
slider45:9<1,30,0.1>-Reverb decay (s)
slider46:55<0,100,1>-Reverb damp (%)
slider47:45<0,100,1>-Reverb mix (%)
slider48:50<0,100,1>-Fate (%)
slider49:-3<-24,6,0.1>-Volume (dB)
slider50:60<0,100,0.1>-Level (%)
slider51:0<0,16,1>-MIDI channel (0 = omni)
slider52:0<0,1,1{Void width,Cloud density}>-Mod wheel
slider53:0<0,100,1>-Band sat (%)
slider54:30<0,100,1>-Bias (%)
slider55:120<40,400,1>-Sat low band (Hz)
slider56:6000<2000,16000,10>-Sat high band (Hz)
slider57:-0.3<-24,0,0.1>-Ceiling (dB)
slider58:1<0,1,1{Off,Clip}>-(unused, output stage)

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-hanged";                                  // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
HMDEF = 1000; HMTMP = 1200;                                // the Init values; the preset parser's scratch (panel only)
VC = 2000;                                                 // the partials, for the panel: pitch, amplitude, void gain, alive
VD = 3400; VDS = 16; NVD = 16;                             // the voids: 16 x 16 (see hm_carve)
VA = 3700;                                                 // the voids in force now: pitch, depth (packed)
PD = 3800;                                                 // the plumes, for the panel: note, progress, level, centre
SCL = 3900;                                                // the scales (bit masks from the root)
HIS = 5000; HVD = 9000; HNB = 72; HNR = 52;                // the panel's history: 52 rows x 72 bins (energy, void)
PB = 100000; PBN = 1048576; PBM = 1048575;                 // the plumes' memory: the cloud and its reverb (mono)
EL = 1150000; ER = 1412144; EN = 262144; EM = 262143;      // the tape echo's two heads
HPD = 1700000; HPDM = 16383;                               // the reverb's pre-delay
HAP = 1720000; HAPN = 4096; HAPM = 4095;                   // the reverb's four input all-passes
HRV = 1740000; HRN = 16384; HRM = 16383;                   // the reverb's eight lines
memset(VC, 0, 1200); memset(VD, 0, 300); memset(VA, 0, 100); memset(PD, 0, 100);
memset(HIS, 0, HNB * HNR); memset(HVD, 0, HNB * HNR);
memset(PB, 0, PBN); memset(EL, 0, 2 * EN); memset(HPD, 0, 16384); memset(HAP, 0, 4 * HAPN); memset(HRV, 0, 8 * HRN);
TWOPI = 2 * $pi; TK = 32; NV = 48; NPL = 8;      // the control tick: every 32 samples

// ---------- the scales: bit k = k semitones above the root ----------
SCL[0] = 2741; SCL[1] = 1709; SCL[2] = 1451; SCL[3] = 2773; SCL[4] = 1717; SCL[5] = 1453; SCL[6] = 1387;
SCL[7] = 661; SCL[8] = 1193; SCL[9] = 1189; SCL[10] = 2477; SCL[11] = 2733; SCL[12] = 1365; SCL[13] = 397;
SCL[14] = 1187; SCL[15] = 2509; SCL[16] = 2483;

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#hm_def = "0 1 2 1 43 84 10 55 50 45 70 75 47 25 31 30 73 30 113 30 100 0.6 300 40 35 1 1 60 2.5 50 35 40 3 0 1 640 0 6 45 45 30 30 1 80 9 55 45 50 -3 60 0 0 0 30 120 6000 -0.3 1";
function hm_nums(s, dst) local(i, n, c, len, acc, neg, fr, fsc, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; fsc = 1; neg = 0; );
      fr ? ( fsc *= 0.1; acc += (c - 48) * fsc; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; fsc = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; fsc = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
hm_nums(#hm_def, HMDEF);
#hm_pm = "Init|Held Breath|Surrender|Stillness|Inverted Sky|Dusk Vigil|Living Wood|Halo|Twelfth Hour|Quiet Offering|Long Suspension|Pendant Star";
hm_npre = 12;
function hm_pstr(p) (
  p == 2 ? "3:9 4:5 5:45 6:79 8:40 9:75 10:35 23:1200 29:4 30:65 33:4 34:40 42:25 45:14 47:55 50:57.7" :
  p == 3 ? "3:0 4:7 5:48 6:91 8:70 9:60 10:55 22:1 25:60 28:70 33:3 34:-40 39:60 41:45 42:35 44:90 45:18 47:60 50:53.8" :
  p == 4 ? "3:4 4:9 5:40 6:76 7:4 8:30 9:95 10:30 14:10 16:10 18:15 20:10 23:2500 33:10 34:60 35:0 45:20 47:50 50:64.9" :
  p == 5 ? "3:2 4:3 5:55 6:100 8:80 9:40 10:80 11:100 22:0.4 25:50 29:3 30:30 31:60 32:20 33:2 40:70 42:30 44:85 46:30 50:55.8" :
  p == 6 ? "3:7 4:2 5:36 6:72 8:60 9:65 10:25 22:0.8 28:65 32:55 33:4 36:900 39:70 40:30 41:50 42:35 45:16 46:80 50:58.5" :
  p == 7 ? "3:5 4:4 5:43 6:84 7:20 8:50 9:30 10:50 15:17 16:60 19:40 20:60 22:0.5 23:120 27:0 33:2 34:-60 36:420 39:50 42:30 50:57.4" :
  p == 8 ? "3:0 4:0 5:60 6:96 8:65 9:55 10:70 22:0.35 25:90 26:0 28:50 32:10 33:3 44:100 45:24 46:45 47:60 50:54.3" :
  p == 9 ? "3:11 4:15 5:38 6:80 8:55 9:50 10:40 22:1.2 24:70 28:75 29:5 30:70 31:50 33:9 37:1 38:5 39:92 41:60 42:40 50:66.0" :
  p == 10 ? "3:2 4:8 5:50 6:86 8:35 9:70 10:40 21:85 23:600 28:55 33:3 34:20 42:20 45:12 47:50 50:66.7" :
  p == 11 ? "3:9 4:1 5:33 6:88 8:90 9:90 13:180 14:50 15:120 16:50 17:240 18:50 19:300 20:50 33:12 34:70 44:100 45:28 47:65 50:59.7" :
  p == 12 ? "3:4 4:13 5:62 6:103 8:45 9:45 10:75 22:0.5 25:70 28:65 29:1.5 30:40 31:70 32:25 33:1 37:1 38:4 39:55 41:20 42:40 45:7 50:50.0" :
  "";
);
function load_preset(p) local(n, i) (
  // RUN, TRANSPORT, FATE, the MIDI channel, the wheel and the output stage stay as they are (a preset never
  // starts the cloud); everything else glides to the new settings (the partials re-form at their own pace)
  i = 2; loop(48, i != 47 ? slider(i + 1) = HMDEF[i]; i += 1; );
  n = hm_nums(hm_pstr(p), HMTMP);
  i = 0; loop(floor(n / 2), HMTMP[i * 2] >= 3 && HMTMP[i * 2] <= 50 && HMTMP[i * 2] != 48 ? slider(HMTMP[i * 2]) = HMTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(58, ui_auto(i); i += 1; );
  pr_cur = p;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(58, slider(i + 1) = HMDEF[i]; ui_auto(i + 1); i += 1; );
);

// ---------- small helpers ----------
function hm_ddiv(i) ( i == 0 ? 0.25 : i == 1 ? 1 / 3 : i == 2 ? 0.5 : i == 3 ? 2 / 3 : i == 4 ? 0.75 : i == 5 ? 1 : i == 6 ? 1.5 :
                      i == 7 ? 2 : i == 8 ? 3 : hm_bpb; );
function hm_cycs(i) ( i <= 5 ? 2 ^ i * hm_bpb * 60 / hm_tmp : i == 6 ? 5 : i == 7 ? 10 : i == 8 ? 20 : i == 9 ? 30 : i == 10 ? 60 : i == 11 ? 120 : 300; );
function hm_inscale(n) ( (hm_mask >> ((floor(n + 0.5) - hm_root + 120) % 12)) & 1; );
// the heal curve: h 0 .. 1 -> the part of the void still open (1 .. 0); FAST (c < 0) returns early, SLOW late
function hm_shape(h) ( hm_heal < 0 ? (1 - h) ^ (1 + 3 * -hm_heal) : 1 - h ^ (1 + 3 * hm_heal); );

// ---------- the voids' effect on a pitch p (semitones, fractional): the gain left there (0 .. 1), with the resonant
// halo just outside each void (RESONANCE) ----------
function hm_vg(p) local(j, d, x, t, g, bump) (
  g = 1; bump = 0; j = 0;
  loop(hm_nva,
    d = p - VA[j * 2]; hm_oct ? d -= 12 * floor(d / 12 + 0.5); d = abs(d);
    x = d * hm_iw;
    x < 2 ? (
      t = x <= 1 ? 1 : ( t = x - 1; 1 - t * t * (3 - 2 * t) );
      g *= 1 - VA[j * 2 + 1] * t;
    ) : (
      t = (d - 2 * hm_wnow) * 0.5;                          // the halo: from twice the width, two semitones wide
      t < 1 ? bump += VA[j * 2 + 1] * 4 * t * (1 - t);
    );
    j += 1;
  );
  g * (1 + 1.6 * hm_res * min(bump, 1));
);
// how deep the voids are at a pitch (for the panel: no halo)
function hm_vcut(p) local(j, d, x, t, g) (
  g = 1; j = 0;
  loop(hm_nva,
    d = p - VA[j * 2]; hm_oct ? d -= 12 * floor(d / 12 + 0.5); d = abs(d);
    x = d * hm_iw;
    x < 2 ? ( t = x <= 1 ? 1 : ( t = x - 1; 1 - t * t * (3 - 2 * t) ); g *= 1 - VA[j * 2 + 1] * t; );
    j += 1;
  );
  1 - g;
);

// ---------- where a new partial is born: a scale note in the register (WEATHER may shift it), not inside a void;
// with RESONANCE, often on a scale note just beside a void ----------
function hm_pick() local(lo, hi, n, i, ok, tries, dir, j) (
  lo = max(min(hm_lo, hm_hi) + hm_wreg, 12); hi = min(max(hm_lo, hm_hi) + hm_wreg, 120); hi < lo + 5 ? hi = lo + 5;
  tries = 0; ok = 0;
  while (!ok && tries < 6) (
    hm_nva > 0 && rand(1) < hm_res * 0.5 ? (
      j = floor(rand(hm_nva)); dir = rand(1) < 0.5 ? -1 : 1;
      n = floor(VA[j * 2] + 0.5) + dir * (1 + floor(hm_wnow));
      i = 0; while (!hm_inscale(n) && i < 12) ( n += dir; i += 1; );
      hm_oct ? ( n += 12 * floor((lo - n) / 12 + 0.999); n += 12 * floor(rand(max(floor((hi - n) / 12) + 1, 1))); );
    ) : (
      n = lo + floor(rand(hi - lo + 1));
      i = 0; while (!hm_inscale(n) && i < 12) ( n += 1; i += 1; );
      n > hi ? n -= 12;
    );
    ok = n >= lo && n <= hi && hm_vg(n) > 0.4;
    tries += 1;
  );
  n;
);

// ---------- the partials (each in its own namespace: hv0, hv1, ...): a sine and its octave (the magic-circle
// oscillator: two multiplies a sample, stable however its pitch moves) ----------
function hm_vinit(i) instance(ix, on, s, c, e, a, b, pl, pr, nt, fb, oc, e1, ev, tg, life, ws, wc, we, pan, dsg, wt, k, rt, cd, vam, vbm, pn)
  ( ix = i; on = 0; s = 0; c = 1; e = a = b = 0; pl = pr = 0.7; ev = e1 = 0; tg = 0; rt = 0; cd = rand(1) * 40; vam = vbm = 0; pn = 60; );
function hm_vspawn() instance(ix, on, s, c, e, a, b, pl, pr, nt, fb, oc, e1, ev, tg, life, ws, wc, we, pan, dsg, wt, k, rt, cd, vam, vbm, pn) (
  nt = hm_pick(); fb = 440 * 2 ^ ((nt - 69) / 12); oc = (nt - 69) / 12;
  s = 0; c = 1;                                            // (the oscillator restarts at silence)
  life = hm_lifeT * (0.4 + rand(1.2));
  k = 1 - exp(-TK / (hm_swT * (0.5 + rand(1)) * srate));
  tg = 1; on = 1; rt = 0;
  pan = rand(2) - 1; dsg = rand(2) - 1; wt = 0.55 + rand(0.45);
  ws = rand(2) - 1; wc = sqrt(1 - ws * ws) * (rand(1) < 0.5 ? -1 : 1);
  we = TWOPI * hm_wr * (0.6 + rand(0.8)) * TK / srate;
  // while the cloud sleeps, a new partial is already fully formed (RUN then swells the cloud in as a whole)
  hm_gate < 0.0001 ? ( rand(1) < 0.3 ? e1 = ev = rand(0.8) : ( e1 = ev = 1; life *= rand(1); ); ) : ( e1 = ev = 0; );
  a = b = 0;
);
// the control tick: life, swell, wander, pitch; every 4th tick (staggered) the voids, the tilt and the pan
function hm_vtk() instance(ix, on, s, c, e, a, b, pl, pr, nt, fb, oc, e1, ev, tg, life, ws, wc, we, pan, dsg, wt, k, rt, cd, vam, vbm, pn)
  local(alive, kk, ct, f, x, x2, vg, vo, tl, hb, pp, q) (
  alive = ix < hm_nact;
  on ? (
    // (the fade aims a little below zero, so it ends in a finite time with a gentle slope, never a step)
    tg > 0 ? ( life -= hm_tlfo; (life <= 0 || rt || !alive) ? tg = -0.06; );
    kk = rt ? max(k, hm_kfast) : k;
    e1 += (tg - e1) * kk; ev += (e1 - ev) * kk;
    tg < 0 && ev <= 0 ? ( ev = e1 = 0; alive ? this.hm_vspawn() : ( on = 0; a = b = 0; vam = vbm = 0; cd = rand(1) * 60; ); );
    // the wander (its own slow sine) and the DRIFT LFO (half the partials one way, half the other)
    ws += we * hm_tlfo * wc; wc -= we * hm_tlfo * ws;
    ct = hm_mic * ws + hm_dd * dsg;
    f = fb * hm_gm * (1 + 0.000578 * ct);
    x = $pi * min(f, 0.45 * srate) / srate; x2 = x * x;
    e = 2 * x * (1 - x2 * (1 / 6 - x2 / 120));              // 2 sin(pi f / rate)
    pn = nt + ct * 0.01;
    (hm_tc & 3) == (ix & 3) ? (
      vg = hm_nva ? hm_vg(pn) : 1; vo = hm_oct ? vg : ( hm_nva ? hm_vg(pn + 12) : 1 );
      tl = exp(-oc * hm_tilt);
      hb = f * 2 < 0.42 * srate ? hm_hb : 0;
      vam = wt * tl * vg * (1 - hb) * hm_norm; vbm = wt * tl * vo * hb * 2 * hm_norm;
      pp = pan * hm_spr; pl = sqrt(0.5 - 0.5 * pp); pr = sqrt(0.5 + 0.5 * pp);
      q = wt * tl * ev; hm_eacc += q * q;
      q = VC + ix * 4; q[0] = pn; q[1] = wt * tl * ev * vg; q[2] = vg; q[3] = 1;
    );
    a += (vam * ev - a) * hm_ks; b += (vbm * ev - b) * hm_ks;
  ) : (
    VC[ix * 4 + 1] = 0; VC[ix * 4 + 3] = 0;
    alive ? ( cd -= 1; cd <= 0 || hm_gate < 0.0001 ? this.hm_vspawn(); );
  );
);
// a sample
function hm_vosc() instance(on, s, c, e, a, b, pl, pr) local(y) (
  on ? ( s += e * c; c -= e * s; y = s * (a + b * c); hm_cl += y * pl; hm_cr += y * pr; );
);
// the key or the register changed: partials that no longer belong fade out (within about a second) and are reborn
function hm_vchk() instance(on, nt, rt) (
  on && (!hm_inscale(nt) || nt < min(hm_lo, hm_hi) - 6 || nt > max(hm_lo, hm_hi) + 6) ? rt = 1;
);

// ---------- the voids: 0 active, 1 note, 2 depth, 3 carved (0 .. 1), 4 key held, 5 pedal held, 6 phase (0 open, 1
// healing, 2 the scar fading), 7 heal progress, 8 its pace (SCAR TISSUE), 9 its scar, 10 the scar's progress,
// 11 how deep it is now, 12 velocity ----------
function hm_carve(n, v) local(j, q, bi, best, d, cur) (
  bi = -1; j = 0; q = VD;
  loop(NVD, q[0] && q[1] == n ? bi = j; j += 1; q += VDS; );
  bi < 0 ? ( j = 0; q = VD; loop(NVD, !q[0] && bi < 0 ? bi = j; j += 1; q += VDS; ); );
  bi < 0 ? ( best = 10; j = 0; q = VD; loop(NVD, q[11] < best ? ( best = q[11]; bi = j; ); j += 1; q += VDS; ); );
  q = VD + bi * VDS;
  d = hm_dep * (1 - hm_vsen + hm_vsen * v ^ 1.2);
  cur = q[0] && q[1] == n ? q[11] : 0;                     // (a void carved again goes on from where it is)
  q[0] = 1; q[1] = n; q[2] = max(d, 0.0001); q[3] = min(cur / q[2], 1); q[4] = 1; q[5] = 0; q[6] = 0; q[7] = 0; q[10] = 0;
  q[8] = 2 ^ ((rand(2) - 1) * 0.7 * min(hm_fa, 2));        // SCAR TISSUE: its own pace
  q[9] = min(sqr(rand(1)) * 0.32 * min(hm_fa, 2), 0.5);    // ... and a trace that lingers
  q[12] = v;
);
function hm_release(n) local(j, q) (
  j = 0; q = VD; loop(NVD, q[0] && q[1] == n && q[4] ? ( q[4] = 0; hm_ped ? q[5] = 1; ); j += 1; q += VDS; );
);
function hm_pedup() local(q) ( q = VD; loop(NVD, q[5] = 0; q += VDS; ); );
function hm_allup() local(q) ( q = VD; loop(NVD, q[4] = q[5] = 0; q += VDS; ); );
// at the tick: carve, hold, heal; the voids in force packed into VA for the partials
function hm_vdupd() local(j, q, n, sh) (
  n = 0; j = 0; q = VD;
  loop(NVD,
    q[0] ? (
      q[3] += (1 - q[3]) * hm_kcv;
      q[6] == 0 && (!hm_hold || (!q[4] && !q[5])) ? q[6] = 1;
      q[6] == 1 ? ( q[7] += hm_dh * q[8]; q[7] >= 1 ? ( q[7] = 1; q[6] = q[9] > 0.01 ? 2 : 3; ); ) :
      q[6] == 2 ? ( q[10] += hm_dh * 0.6 * q[8]; q[10] >= 1 ? ( q[10] = 1; q[6] = 3; ); );
      sh = q[6] == 0 ? 1 : hm_shape(q[7]);
      q[11] = q[2] * q[3] * ((1 - q[9]) * sh + q[9] * sqr(1 - q[10]));
      q[6] == 3 ? ( q[0] = 0; q[11] = 0; ) : (
        VA[n * 2] = q[1]; VA[n * 2 + 1] = q[11]; n += 1;
      );
    );
    j += 1; q += VDS;
  );
  hm_nva = n;
);

// ---------- the reverse plumes (hp0 .. hp7): the cloud's last moments read backwards, band-passed round the note ----------
function hm_pgo(n, v, i) instance(ix, on, t, ln, wn, t2, g1, g2, d1, d2, a1, a2, a3, b1, b2, b3, z1, z2, y1, y2, k1, k2, gl, gr, gn, nt, fc)
  local(m, n2, g, q, f2, pp) (
  ix = i; on = 1; t = 0; nt = n;
  ln = floor(min(hm_plen, PBN / (2.2 * srate)) * srate); t2 = floor(ln * 0.4);
  wn = hm_pw;
  g1 = g2 = d1 = d2 = 0; z1 = z2 = y1 = y2 = 0;
  m = (hm_lo + hm_hi) * 0.5; n2 = n + 12 * floor((m - n) / 12 + 0.5);
  fc = min(440 * 2 ^ ((n2 - 69) / 12), 0.4 * srate);
  q = 40 * (2.5 / 40) ^ hm_ptone;                          // TONE: Q 40 (narrow, ringing) .. 2.5 (wide)
  k1 = 1 / q; g = tan($pi * fc / srate); a1 = 1 / (1 + g * (g + k1)); a2 = g * a1; a3 = g * a2;
  f2 = min(fc * 2, 0.42 * srate);
  k2 = 1 / q; g = tan($pi * f2 / srate); b1 = 1 / (1 + g * (g + k2)); b2 = g * b1; b3 = g * b2;
  pp = min(max((n2 - min(hm_lo, hm_hi)) / max(abs(hm_hi - hm_lo), 1), 0), 1) * 2 - 1;
  pp *= 0.8 * hm_spr; gl = cos((pp + 1) * 0.25 * $pi); gr = sin((pp + 1) * 0.25 * $pi);
  gn = (0.35 + 0.65 * v) * (q / 2.5) ^ 0.4 * 1.1;
);
function hm_ptk() instance(ix, on, t, ln, wn, t2, g1, g2, d1, d2, gn, nt, fc) local(tn, u, fe, e1, e2, q) (
  on ? (
    tn = t + TK; u = min(tn / ln, 1); fe = max(min((ln - tn) / hm_pfade, 1), 0);
    e1 = u ^ hm_pcv * fe * gn * hm_plg;
    e2 = tn > t2 ? ((tn - t2) / (ln - t2)) ^ hm_pcv * fe * gn * hm_plg * hm_ptl : 0;
    d1 = (e1 - g1) / TK; d2 = (e2 - g2) / TK;
    q = PD + ix * 4; q[0] = nt; q[1] = u; q[2] = e1 / max(gn, 0.0001); q[3] = 1;
  ) : PD[ix * 4 + 3] = 0;
);
function hm_prun() instance(on, t, ln, wn, t2, g1, g2, d1, d2, a1, a2, a3, b1, b2, b3, z1, z2, y1, y2, k1, k2, gl, gr)
  local(x, v1, v2, v3, y) (
  on ? (
    t += 1;
    x = PB[(wn - t) & PBM] * g1;
    t > t2 ? x += PB[(wn - t + t2) & PBM] * g2;
    g1 += d1; g2 += d2;
    v3 = x - z2; v1 = a1 * z1 + a2 * v3; v2 = z2 + a2 * z1 + a3 * v3; z1 = 2 * v1 - z1; z2 = 2 * v2 - z2; y = v1 * k1;
    v3 = x - y2; v1 = b1 * y1 + b2 * v3; v2 = y2 + b2 * y1 + b3 * v3; y1 = 2 * v1 - y1; y2 = 2 * v2 - y2; y += v1 * k2 * 0.6;
    hm_pxl += y * gl; hm_pxr += y * gr;
    t >= ln ? ( on = 0; g1 = g2 = 0; );
  );
);
function hm_plume(n, v) (
  hp0.on == 0 ? hp0.hm_pgo(n, v, 0) : hp1.on == 0 ? hp1.hm_pgo(n, v, 1) : hp2.on == 0 ? hp2.hm_pgo(n, v, 2) :
  hp3.on == 0 ? hp3.hm_pgo(n, v, 3) : hp4.on == 0 ? hp4.hm_pgo(n, v, 4) : hp5.on == 0 ? hp5.hm_pgo(n, v, 5) :
  hp6.on == 0 ? hp6.hm_pgo(n, v, 6) : hp7.on == 0 ? hp7.hm_pgo(n, v, 7) : 0;
);

// ---------- the reverb's lines ----------
function hm_rl(base, n, gn, m) instance(z) local(rp, ri, f, d) (
  m != 0 ? ( rp = hm_rw - n - m; ri = floor(rp); f = rp - ri; d = base[ri & HRM]; d += (base[(ri + 1) & HRM] - d) * f; ) :
           d = base[(hm_rw - n) & HRM];
  z += (d - z) * hm_rdmp;
  z * gn;
);
function hm_ap(base, n, x, k) instance(wp) local(d, v) (
  d = base[(wp - n) & HAPM]; v = x + k * d; abs(v) < 0.000000000001 ? v = 0; base[wp] = v; wp = (wp + 1) & HAPM;
  d - k * v;
);

// ---------- parameters ----------
function hm_update() local(t, c) (
  hm_tmp = tempo > 0 ? tempo : 120;
  hm_bpb = (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  hm_run = slider1 >= 0.5;
  // THE CLOUD
  hm_root = floor(slider3 + 0.5); hm_scl = floor(slider4 + 0.5); hm_mask = SCL[min(max(hm_scl, 0), 16)];
  hm_lo = floor(slider5 + 0.5); hm_hi = floor(slider6 + 0.5);
  hm_mwt = slider7; hm_dent = slider8 / 100; hm_inrt = slider9 / 100;
  hm_bri = slider10 / 100; hm_spr = slider11 / 100; hm_clev = sqr(slider12 / 100);
  // the LFO MATRIX: periods and depths
  hm_lr1 = 1 / slider13; hm_ldt1 = slider14 / 100; hm_lr2 = 1 / slider15; hm_ldt2 = slider16 / 100;
  hm_lr3 = 1 / slider17; hm_ldt3 = slider18 / 100; hm_lr4 = 1 / slider19; hm_ldt4 = slider20 / 100;
  // THE CLEARING
  hm_dep = slider21 / 100; hm_wid = slider22;
  hm_kcv = 1 - exp(-TK * 4.6 / (slider23 * 0.001 * srate));
  hm_vsen = slider24 / 100; hm_res = slider25 / 100; hm_oct = slider26 >= 0.5; hm_hold = slider27 >= 0.5;
  // the PLUME
  hm_plev = slider28 / 100; hm_plen = slider29; hm_pcv = 1 + 5 * slider30 / 100; hm_ptail = slider31 / 100; hm_ptone = slider32 / 100;
  // REGENERATION
  hm_cyc = hm_cycs(floor(slider33 + 0.5)); hm_heal = slider34 / 100;
  // TAPE ECHO
  hm_ein = slider35 >= 0.5;
  t = slider37 >= 0.5 ? hm_ddiv(floor(slider38 + 0.5)) * 60 / hm_tmp : slider36 * 0.001;
  hm_dtt = min(max(t * srate, 32), EN * 0.8);
  hm_efb = slider39 / 100;
  hm_etc = 1 - exp(-TWOPI * min(700 * 2 ^ (slider40 / 100 * 4.3), srate * 0.45) / srate);
  hm_esh = slider41 / 100; hm_emix = slider42 / 100;
  // REVERB
  hm_rin = slider43 >= 0.5; hm_rsz = slider44 / 100; hm_rdec = slider45; hm_rmix = slider47 / 100;
  hm_rdmt = 1 - exp(-TWOPI * min(9000 * 2 ^ (-3.6 * slider46 / 100), srate * 0.45) / srate);
  t = srate / 1000 * (0.7 + 1.2 * hm_rsz);
  HMTMP[180] = min(37.1 * t, HRN - 40); HMTMP[181] = min(41.3 * t, HRN - 40); HMTMP[182] = min(47.9 * t, HRN - 40);
  HMTMP[183] = min(53.3 * t, HRN - 40); HMTMP[184] = min(59.7 * t, HRN - 40); HMTMP[185] = min(67.1 * t, HRN - 40);
  HMTMP[186] = min(73.9 * t, HRN - 40); HMTMP[187] = min(81.7 * t, HRN - 40);
  // MASTER
  hm_fa = slider48 / 50;                                   // FATE: 1 = the standard amount
  hm_volt = 10 ^ (slider49 / 20) * sqr(slider50 / 100) * 5;
  hm_chan = floor(slider51 + 0.5); hm_mwh = slider52 >= 0.5;
  ins_output_setup(53);   // output stage: CLIP, always on
);

function hm_srinit() (
  hm_sr = srate; ost_init(20000);
  hm_ks = 1 - exp(-TK / (0.006 * srate));                  // the partials' gains: 6 ms
  hm_sk = 1 - exp(-TK / (0.03 * srate));                   // the controls: 30 ms
  hm_koil = 1 - exp(-TK / (0.8 * srate));                  // DENSITY / INERTIA: oil-damped (two stages: ~1.6 s)
  hm_gfk = 1 - exp(-TK / (0.4 * srate));                   // the slow-glide faders: about a second
  hm_ek = 1 - exp(-TK / (0.12 * srate));                   // the effects in / out: 120 ms
  hm_kfast = 1 - exp(-TK / (0.3 * srate));                 // a retired partial fades within about a second
  hm_gk1 = 1 - exp(-TK / (0.75 * srate)); hm_gk0 = 1 - exp(-TK / (1.0 * srate));   // RUN: in ~3 s, out ~4 s
  hm_nk = 1 - exp(-TK / (1.5 * srate));                    // the level normaliser
  hm_dsk = 1 - exp(-1 / (0.4 * srate));                    // the echo's time glides like tape
  hm_ehk = 1 - exp(-TWOPI * 60 / srate);                   // the echo loop's high-pass
  hm_sm = 1 - exp(-1 / (0.03 * srate));
  hm_pfade = 0.05 * srate;                                 // a plume's last 50 ms fade to nothing
  HMTMP[190] = min(floor(4.77 * srate / 1000), HAPN - 2); HMTMP[191] = min(floor(3.59 * srate / 1000), HAPN - 2);
  HMTMP[192] = min(floor(12.73 * srate / 1000), HAPN - 2); HMTMP[193] = min(floor(9.31 * srate / 1000), HAPN - 2);
  hm_pdn = floor(0.025 * srate);
  hm_pkd = exp(-1 / (0.25 * srate));                       // (the output meter's fall)
  hm_update();
  hm_first = 1;
);

ins_drift_init();
hmW1.drift_init(0.8 + rand(0.5)); hmW2.drift_init(0.8 + rand(0.5)); hmW3.drift_init(0.8 + rand(0.5));
hmP1.drift_init(1); hmE1.drift_init(1);
hv0.hm_vinit(0); hv1.hm_vinit(1); hv2.hm_vinit(2); hv3.hm_vinit(3); hv4.hm_vinit(4); hv5.hm_vinit(5);
hv6.hm_vinit(6); hv7.hm_vinit(7); hv8.hm_vinit(8); hv9.hm_vinit(9); hv10.hm_vinit(10); hv11.hm_vinit(11);
hv12.hm_vinit(12); hv13.hm_vinit(13); hv14.hm_vinit(14); hv15.hm_vinit(15); hv16.hm_vinit(16); hv17.hm_vinit(17);
hv18.hm_vinit(18); hv19.hm_vinit(19); hv20.hm_vinit(20); hv21.hm_vinit(21); hv22.hm_vinit(22); hv23.hm_vinit(23);
hv24.hm_vinit(24); hv25.hm_vinit(25); hv26.hm_vinit(26); hv27.hm_vinit(27); hv28.hm_vinit(28); hv29.hm_vinit(29);
hv30.hm_vinit(30); hv31.hm_vinit(31); hv32.hm_vinit(32); hv33.hm_vinit(33); hv34.hm_vinit(34); hv35.hm_vinit(35);
hv36.hm_vinit(36); hv37.hm_vinit(37); hv38.hm_vinit(38); hv39.hm_vinit(39); hv40.hm_vinit(40); hv41.hm_vinit(41);
hv42.hm_vinit(42); hv43.hm_vinit(43); hv44.hm_vinit(44); hv45.hm_vinit(45); hv46.hm_vinit(46); hv47.hm_vinit(47);
hmkL.clp_set(1, 0.9, 0.9, 0); hmkR.clp_set(1, 0.9, 0.9, 0);   // the echo loop's saturator: SOFT, anti-aliased
hm_ct = TK - 1; hm_tc = 0; hm_gate = hm_g1 = 0; hm_den = hm_den2 = 0.55; hm_inr = hm_inr2 = 0.5; hm_norm = 0.1; hm_eacc = 0; hm_esum = 1;
hm_lp1 = rand(1); hm_lp2 = rand(1); hm_lp3 = rand(1); hm_lp4 = rand(1); hm_php = rand(1);
hm_pw = 0; hm_ew = 0; hm_rw = 0; hm_pdw = 0; hm_dts = -1; hm_nva = 0; hm_ped = 0; hm_whl = hm_whv = 0; hm_mic = 10; hm_wnow = 0.6; hm_iw = 1 / 0.6;
hm_hrow = 0; hm_ht = 0; hm_gm = 1; hm_tlfo = 1; hm_dd = 0; hm_wreg = 0;
hm_srinit();
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
hm_vol = hm_volt;
ui_dflt = 1;

@slider
hm_update();

@block
srate != hm_sr ? hm_srinit();
// TRANSPORT: while lit, REAPER's play (or record) presses RUN and its stop releases it (the cloud swells in and fades
// away as by hand); RUN still works by hand
hm_xp = play_state & 1;
slider2 >= 0.5 && hm_xp != hm_xpw ? ( slider1 = hm_xp; hm_run = hm_xp; ui_auto(1); );
hm_xpw = hm_xp;
hm_update();
// the key or the register changed: the partials that no longer belong are retired
(hm_root !== hm_root0 || hm_mask !== hm_mask0 || hm_lo !== hm_lo0 || hm_hi !== hm_hi0) ? (
  hv0.hm_vchk(); hv1.hm_vchk(); hv2.hm_vchk(); hv3.hm_vchk(); hv4.hm_vchk(); hv5.hm_vchk(); hv6.hm_vchk();
  hv7.hm_vchk(); hv8.hm_vchk(); hv9.hm_vchk(); hv10.hm_vchk(); hv11.hm_vchk(); hv12.hm_vchk(); hv13.hm_vchk();
  hv14.hm_vchk(); hv15.hm_vchk(); hv16.hm_vchk(); hv17.hm_vchk(); hv18.hm_vchk(); hv19.hm_vchk(); hv20.hm_vchk();
  hv21.hm_vchk(); hv22.hm_vchk(); hv23.hm_vchk(); hv24.hm_vchk(); hv25.hm_vchk(); hv26.hm_vchk(); hv27.hm_vchk();
  hv28.hm_vchk(); hv29.hm_vchk(); hv30.hm_vchk(); hv31.hm_vchk(); hv32.hm_vchk(); hv33.hm_vchk(); hv34.hm_vchk();
  hv35.hm_vchk(); hv36.hm_vchk(); hv37.hm_vchk(); hv38.hm_vchk(); hv39.hm_vchk(); hv40.hm_vchk(); hv41.hm_vchk();
  hv42.hm_vchk(); hv43.hm_vchk(); hv44.hm_vchk(); hv45.hm_vchk(); hv46.hm_vchk(); hv47.hm_vchk();
  hm_root0 = hm_root; hm_mask0 = hm_mask; hm_lo0 = hm_lo; hm_hi0 = hm_hi;
);

// ---------- MIDI: a key carves a void and sends a plume; its release lets the void heal (HOLD) ----------
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, hm_chan) ? (
    hm_st = m1 & 0xF0;
    hm_st == 0x90 && m3 > 0 ? ( ins_midi_hit(); hm_carve(m2, m3 / 127); hm_plume(m2, m3 / 127); ) :
    hm_st == 0x80 || (hm_st == 0x90 && m3 == 0) ? hm_release(m2) :
    hm_st == 0xB0 ? (
      m2 == 1 ? hm_whv = m3 / 127 :
      m2 == 64 ? ( hm_ped = m3 >= 64; !hm_ped ? hm_pedup(); ) :
      (m2 == 120 || m2 == 123) ? hm_allup();
    );
  );
  midisend(mofs, m1, m2, m3);
);

// ---------- FATE: WEATHER, PENDULUM (SCAR TISSUE is dealt to each void as it is carved) ----------
hm_bi = samplesblock / srate;
hm_wden = hmW1.drift_tick(0.004 * hm_bi) * 0.45 * hm_fa;            // the density front (octaves of partials)
hm_wbri = hmW2.drift_tick(0.0033 * hm_bi) * 0.7 * hm_fa;            // the brightness front (octaves)
hm_wreg = floor(hmW3.drift_tick(0.0027 * hm_bi) * 4 * hm_fa + 0.5); // the register front (semitones)
hm_php += hm_bi / (26 * (1 + 0.3 * hmP1.drift_tick(0.01 * hm_bi))); hm_php -= floor(hm_php);
hm_psw = sin(TWOPI * hm_php); hm_psd = cos(TWOPI * hm_php);         // the pendulum: its swing, and its depth (a quarter on)
hm_dew = hmE1.drift_tick(0.06 * hm_bi);                             // (the tape's slow speed drift)
// (for the panel: the history, every 150 ms: the display holds the last 8 s)
hm_ht += samplesblock;
hm_ht >= 0.15 * srate ? (
  hm_ht = 0;
  hm_hrow = (hm_hrow + 1) % HNR; hm_hq = HIS + hm_hrow * HNB; memset(hm_hq, 0, HNB);
  hm_hlo = min(hm_lo, hm_hi) - 4; hm_hhi = max(max(hm_lo, hm_hi), hm_hlo + 12) + 4;
  i_ = 0;
  loop(NV,
    VC[i_ * 4 + 3] ? (
      // (spread over a few bins: the display shows a mass, not lines)
      t_ = (VC[i_ * 4] - hm_hlo) / (hm_hhi - hm_hlo) * HNB - 0.5; j_ = floor(t_) - 2; f_ = t_ - floor(t_);
      loop(6, k_ = j_ - t_; k_ = exp(-k_ * k_ * 0.35); j_ >= 0 && j_ < HNB ? hm_hq[j_] += VC[i_ * 4 + 1] * k_ * 0.7 * hm_gate; j_ += 1; );
    );
    i_ += 1;
  );
  hm_hq = HVD + hm_hrow * HNB; i_ = 0;
  loop(HNB, hm_hq[i_] = hm_nva ? hm_vcut(hm_hlo + (i_ + 0.5) / HNB * (hm_hhi - hm_hlo)) : 0; i_ += 1; );
);
abs(hm_lpl) + abs(hm_lpr) + abs(hm_lbl) + abs(hm_lbr) < 0.000000000001 ? hm_lpl = hm_lpr = hm_lbl = hm_lbr = 0;
abs(hm_efl) + abs(hm_efr) + abs(hm_ehl) + abs(hm_ehr) < 0.000000000001 ? hm_efl = hm_efr = hm_ehl = hm_ehr = 0;
abs(hm_dcyl) + abs(hm_dcyr) < 0.000000000001 ? hm_dcyl = hm_dcyr = 0;
abs(ostL.lz1) + abs(ostL.lz2) + abs(ostL.hz1) + abs(ostL.hz2) + abs(ostL.dcy) < 0.000000000001 ? ostL.lz1 = ostL.lz2 = ostL.hz1 = ostL.hz2 = ostL.dcy = 0;
abs(ostR.lz1) + abs(ostR.lz2) + abs(ostR.hz1) + abs(ostR.hz2) + abs(ostR.dcy) < 0.000000000001 ? ostR.lz1 = ostR.lz2 = ostR.hz1 = ostR.hz2 = ostR.dcy = 0;
hmkL.clp_tidy(); hmkR.clp_tidy();
// the effects switched fully out: their lines are emptied, so switching back in starts clean
hm_rvg > 0.0001 ? hm_ract = 1 : hm_ract ? ( memset(HRV, 0, 8 * HRN); memset(HAP, 0, 4 * HAPN); hr0.z = hr1.z = hr2.z = hr3.z = hr4.z = hr5.z = hr6.z = hr7.z = 0; hm_ract = 0; );
hm_eg > 0.0001 ? hm_eact = 1 : hm_eact ? ( memset(EL, 0, 2 * EN); hm_efl = hm_efr = hm_ehl = hm_ehr = 0; hmkL.clp_reset(); hmkR.clp_reset(); hm_eact = 0; );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
// ---------- the control tick (every 32 samples) ----------
hm_ct += 1;
hm_ct >= TK ? (
  hm_ct = 0; hm_tc += 1;
  hm_first ? ( hm_vol = hm_volt; hm_dts = hm_dtt; hm_rdmp = hm_rdmt; hm_first = 0; );
  hm_whl += (hm_whv - hm_whl) * hm_sk;
  // RUN: the cloud swells in and fades away (two gentle stages each way)
  hm_g1 += (hm_run - hm_g1) * (hm_run ? hm_gk1 : hm_gk0); hm_gate += (hm_g1 - hm_gate) * (hm_run ? hm_gk1 : hm_gk0);
  !hm_run && hm_gate < 0.00001 ? hm_gate = hm_g1 = 0;
  // the oil-damped knobs
  hm_den2 += (hm_dent - hm_den2) * hm_koil; hm_den += (hm_den2 - hm_den) * hm_koil;
  hm_inr2 += (hm_inrt - hm_inr2) * hm_koil; hm_inr += (hm_inr2 - hm_inr) * hm_koil;
  hm_ld1 += (hm_ldt1 - hm_ld1) * hm_gfk; hm_ld2 += (hm_ldt2 - hm_ld2) * hm_gfk;
  hm_ld3 += (hm_ldt3 - hm_ld3) * hm_gfk; hm_ld4 += (hm_ldt4 - hm_ld4) * hm_gfk;
  hm_plg += (hm_plev - hm_plg) * hm_gfk; hm_ptl += (hm_ptail - hm_ptl) * hm_gfk;
  // the LFO MATRIX
  hm_lp1 += hm_lr1 * TK / srate; hm_lp1 -= floor(hm_lp1); hm_l1 = sin(TWOPI * hm_lp1);
  hm_lp2 += hm_lr2 * TK / srate; hm_lp2 -= floor(hm_lp2); hm_l2 = sin(TWOPI * hm_lp2);
  hm_lp3 += hm_lr3 * TK / srate; hm_lp3 -= floor(hm_lp3); hm_l3 = sin(TWOPI * hm_lp3);
  hm_lp4 += hm_lr4 * TK / srate; hm_lp4 -= floor(hm_lp4); hm_l4 = sin(TWOPI * hm_lp4);
  hm_gm = 2 ^ ((hm_l1 * hm_ld1 * 25 + hm_psw * 3 * hm_fa) / 1200);  // TUNE, and the PENDULUM's sway
  hm_dd = hm_l2 * hm_ld2 * 30;                                       // DRIFT (cents, each partial its own way)
  hm_tlfo = 2 ^ (hm_l4 * hm_ld4 * 1.5);                              // TIME
  // the cloud: how many partials, how fast, how bright
  hm_t = min(max(hm_den + (hm_mwh ? hm_whl * (1 - hm_den) : 0), 0), 1) * 2 ^ hm_wden;
  hm_nact = floor(4 + (NV - 4) * min(hm_t, 1) + 0.5);
  hm_swT = 0.6 * 2 ^ (hm_inr * 4); hm_lifeT = 4 * 2 ^ (hm_inr * 3.5) * srate / TK; hm_wr = 0.25 * 2 ^ (-hm_inr * 3);
  hm_mic += (hm_mwt - hm_mic) * hm_sk;
  hm_bn += (hm_bri - hm_bn) * hm_sk;
  hm_tilt = (0.55 - hm_bn) * 0.9 * 0.6931; hm_hb = 0.05 + 0.4 * hm_bn;
  hm_t = 400 * 2 ^ (hm_bn * 5.5 + hm_l3 * hm_ld3 * 2 + hm_wbri - 0.4 * hm_fa * max(hm_psd, 0));
  hm_t = min(max(hm_t, 60), 0.42 * srate); hm_t = tan($pi * hm_t / srate);
  hm_la1 = 1 / (1 + hm_t * (hm_t + 1.4)); hm_la2 = hm_t * hm_la1; hm_la3 = hm_t * hm_la2;
  hm_sp += (hm_clev - hm_sp) * hm_sk;
  // the voids: width (and the wheel), the carving and healing
  hm_wnow += (hm_wid + (hm_mwh ? 0 : hm_whl * 2.5) - hm_wnow) * hm_sk; hm_iw = 1 / hm_wnow;
  hm_dh = TK / (hm_cyc * srate);
  hm_vdupd();
  // the partials (the level normaliser keeps the cloud even, however thick)
  (hm_tc & 3) == 0 ? ( hm_esum = hm_eacc; hm_eacc = 0; );
  hm_norm += (0.3 / sqrt(max(hm_esum, 0.6)) - hm_norm) * hm_nk;
  hm_gate > 0 ? (
    hv0.hm_vtk(); hv1.hm_vtk(); hv2.hm_vtk(); hv3.hm_vtk(); hv4.hm_vtk(); hv5.hm_vtk(); hv6.hm_vtk(); hv7.hm_vtk();
    hv8.hm_vtk(); hv9.hm_vtk(); hv10.hm_vtk(); hv11.hm_vtk(); hv12.hm_vtk(); hv13.hm_vtk(); hv14.hm_vtk();
    hv15.hm_vtk(); hv16.hm_vtk(); hv17.hm_vtk(); hv18.hm_vtk(); hv19.hm_vtk(); hv20.hm_vtk(); hv21.hm_vtk();
    hv22.hm_vtk(); hv23.hm_vtk(); hv24.hm_vtk(); hv25.hm_vtk(); hv26.hm_vtk(); hv27.hm_vtk(); hv28.hm_vtk();
    hv29.hm_vtk(); hv30.hm_vtk(); hv31.hm_vtk(); hv32.hm_vtk(); hv33.hm_vtk(); hv34.hm_vtk(); hv35.hm_vtk();
    hv36.hm_vtk(); hv37.hm_vtk(); hv38.hm_vtk(); hv39.hm_vtk(); hv40.hm_vtk(); hv41.hm_vtk(); hv42.hm_vtk();
    hv43.hm_vtk(); hv44.hm_vtk(); hv45.hm_vtk(); hv46.hm_vtk(); hv47.hm_vtk();
  );
  hp0.hm_ptk(); hp1.hm_ptk(); hp2.hm_ptk(); hp3.hm_ptk(); hp4.hm_ptk(); hp5.hm_ptk(); hp6.hm_ptk(); hp7.hm_ptk();
  // the PENDULUM: the stereo field sways (a gentle balance); its depth leans into the reverb
  hm_t = hm_psw * 0.3 * min(hm_fa, 2);
  hm_bgl = cos((hm_t + 1) * 0.25 * $pi) * 1.41421356; hm_bgr = sin((hm_t + 1) * 0.25 * $pi) * 1.41421356;
  hm_rsd = 1 + 0.3 * min(hm_fa, 2) * hm_psd;
  // the effects' gains
  hm_eg += (hm_ein - hm_eg) * hm_ek; hm_eg < 0.00001 && !hm_ein ? hm_eg = 0;
  hm_rvg += (hm_rin - hm_rvg) * hm_ek; hm_rvg < 0.00001 && !hm_rin ? hm_rvg = 0;
  hm_emn += (hm_emix - hm_emn) * hm_sk; hm_rmn += (hm_rmix - hm_rmn) * hm_sk;
  hm_efn += ((hm_run ? hm_efb : min(hm_efb, 0.85)) - hm_efn) * hm_sk;
  hm_ecn += (hm_etc - hm_ecn) * hm_sk;
  // TAPE ECHO: SHIFT moves the tape's speed (wow, a slow drift, the TIME LFO) and so the repeats' pitch
  hm_ewp += 0.45 * TK / srate; hm_ewp -= floor(hm_ewp);
  hm_esn += (hm_esh - hm_esn) * hm_sk * 0.25;              // (SHIFT glides: its wow moves the heads)
  hm_tsm = 1 + hm_esn * (0.035 * hm_dew + 0.006 * sin(TWOPI * hm_ewp) + 0.02 * hm_l4 * hm_ld4);
  hm_wl = hm_esn * 0.0015 * srate * (1 + sin(TWOPI * hm_ewp)); hm_wr_ = hm_esn * 0.0015 * srate * (1 + cos(TWOPI * hm_ewp));
  // REVERB: the lines' lengths glide, their gains follow DECAY, two of them swim
  hm_n0 += (HMTMP[180] - hm_n0) * hm_sk * 0.1; hm_n1 += (HMTMP[181] - hm_n1) * hm_sk * 0.1; hm_n2 += (HMTMP[182] - hm_n2) * hm_sk * 0.1;
  hm_n3 += (HMTMP[183] - hm_n3) * hm_sk * 0.1; hm_n4 += (HMTMP[184] - hm_n4) * hm_sk * 0.1; hm_n5 += (HMTMP[185] - hm_n5) * hm_sk * 0.1;
  hm_n6 += (HMTMP[186] - hm_n6) * hm_sk * 0.1; hm_n7 += (HMTMP[187] - hm_n7) * hm_sk * 0.1;
  hm_rdn += (hm_rdec - hm_rdn) * hm_sk; hm_rdmp += (hm_rdmt - hm_rdmp) * hm_sk;
  hm_t = -3 / (hm_rdn * srate);
  hm_rg0 = 10 ^ (hm_t * hm_n0); hm_rg1 = 10 ^ (hm_t * hm_n1); hm_rg2 = 10 ^ (hm_t * hm_n2); hm_rg3 = 10 ^ (hm_t * hm_n3);
  hm_rg4 = 10 ^ (hm_t * hm_n4); hm_rg5 = 10 ^ (hm_t * hm_n5); hm_rg6 = 10 ^ (hm_t * hm_n6); hm_rg7 = 10 ^ (hm_t * hm_n7);
  hm_i1 = floor(hm_n1); hm_i3 = floor(hm_n3); hm_i5 = floor(hm_n5); hm_i7 = floor(hm_n7);
  hm_rp1 += 0.19 * TK / srate; hm_rp1 -= floor(hm_rp1);
  hm_rm0 = 1 + 0.0011 * srate * (1 + sin(TWOPI * hm_rp1)); hm_rm1 = 1 + 0.0011 * srate * (1 + cos(TWOPI * hm_rp1));
  hm_rwg = 0.6 * (6 / max(hm_rdn, 1)) ^ 0.2;                // (longer trails gather more: the wet level kept even)
);

// ---------- THE CLOUD ----------
hm_cl = hm_cr = 0;
hm_gate > 0 ? (
  hv0.hm_vosc(); hv1.hm_vosc(); hv2.hm_vosc(); hv3.hm_vosc(); hv4.hm_vosc(); hv5.hm_vosc(); hv6.hm_vosc();
  hv7.hm_vosc(); hv8.hm_vosc(); hv9.hm_vosc(); hv10.hm_vosc(); hv11.hm_vosc(); hv12.hm_vosc(); hv13.hm_vosc();
  hv14.hm_vosc(); hv15.hm_vosc(); hv16.hm_vosc(); hv17.hm_vosc(); hv18.hm_vosc(); hv19.hm_vosc(); hv20.hm_vosc();
  hv21.hm_vosc(); hv22.hm_vosc(); hv23.hm_vosc(); hv24.hm_vosc(); hv25.hm_vosc(); hv26.hm_vosc(); hv27.hm_vosc();
  hv28.hm_vosc(); hv29.hm_vosc(); hv30.hm_vosc(); hv31.hm_vosc(); hv32.hm_vosc(); hv33.hm_vosc(); hv34.hm_vosc();
  hv35.hm_vosc(); hv36.hm_vosc(); hv37.hm_vosc(); hv38.hm_vosc(); hv39.hm_vosc(); hv40.hm_vosc(); hv41.hm_vosc();
  hv42.hm_vosc(); hv43.hm_vosc(); hv44.hm_vosc(); hv45.hm_vosc(); hv46.hm_vosc(); hv47.hm_vosc();
  // BRIGHTNESS: a gentle 12 dB low-pass over the whole cloud
  hm_v3 = hm_cl - hm_lbl; hm_v1 = hm_la1 * hm_lpl + hm_la2 * hm_v3; hm_v2 = hm_lbl + hm_la2 * hm_lpl + hm_la3 * hm_v3;
  hm_lpl = 2 * hm_v1 - hm_lpl; hm_lbl = 2 * hm_v2 - hm_lbl; hm_cl = hm_v2;
  hm_v3 = hm_cr - hm_lbr; hm_v1 = hm_la1 * hm_lpr + hm_la2 * hm_v3; hm_v2 = hm_lbr + hm_la2 * hm_lpr + hm_la3 * hm_v3;
  hm_lpr = 2 * hm_v1 - hm_lpr; hm_lbr = 2 * hm_v2 - hm_lbr; hm_cr = hm_v2;
  hm_t = hm_gate * hm_sp; hm_cl *= hm_t; hm_cr *= hm_t;
);

// ---------- the REVERSE PLUMES (read from the cloud's past) ----------
hm_pxl = hm_pxr = 0;
hp0.hm_prun(); hp1.hm_prun(); hp2.hm_prun(); hp3.hm_prun(); hp4.hm_prun(); hp5.hm_prun(); hp6.hm_prun();
hp7.hm_prun();

// ---------- TAPE ECHO: the time glides like tape, SHIFT bends it; the feedback through TONE, a 60 Hz high-pass and
// a soft anti-aliased saturator (so it can self-oscillate but never run away) ----------
hm_eg > 0 ? (
  hm_dts += (hm_dtt * hm_tsm - hm_dts) * hm_dsk;
  hm_rp = hm_ew - hm_dts - hm_wl; hm_ri = floor(hm_rp); hm_rf = hm_rp - hm_ri;
  hm_a = EL[hm_ri & EM]; hm_el = hm_a + (EL[(hm_ri + 1) & EM] - hm_a) * hm_rf;
  hm_rp = hm_ew - hm_dts * 1.013 - hm_wr_; hm_ri = floor(hm_rp); hm_rf = hm_rp - hm_ri;
  hm_a = ER[hm_ri & EM]; hm_er = hm_a + (ER[(hm_ri + 1) & EM] - hm_a) * hm_rf;
  hm_efl += (hm_el - hm_efl) * hm_ecn; hm_efr += (hm_er - hm_efr) * hm_ecn;
  hm_ehl += (hm_efl - hm_ehl) * hm_ehk; hm_ehr += (hm_efr - hm_ehr) * hm_ehk;
  hm_x = (hm_cl + hm_pxl * 0.8) * hm_eg; hm_y = (hm_cr + hm_pxr * 0.8) * hm_eg;
  hm_a = hm_x + hmkL.clp_run((hm_efr - hm_ehr) * hm_efn); EL[hm_ew] = abs(hm_a) < 0.000000000001 ? 0 : hm_a;   // (the heads cross:
  hm_a = hm_y + hmkR.clp_run((hm_efl - hm_ehl) * hm_efn); ER[hm_ew] = abs(hm_a) < 0.000000000001 ? 0 : hm_a;   // a slow ping-pong)
  hm_ew = (hm_ew + 1) & EM;
  hm_eol = (hm_efl * 0.6 + hm_el * 0.4) * hm_emn * hm_eg; hm_eor = (hm_efr * 0.6 + hm_er * 0.4) * hm_emn * hm_eg;
) : hm_eol = hm_eor = 0;

// ---------- REVERB: pre-delay, four diffusers, eight long lines (Hadamard), dark; it catches the plumes and echoes ----------
hm_x = ((hm_cl + hm_cr) * 0.3 * hm_rsd + (hm_pxl + hm_pxr) * 0.75 + (hm_eol + hm_eor) * 0.25) * hm_rvg;
HPD[hm_pdw] = hm_x; hm_x = HPD[(hm_pdw - hm_pdn) & HPDM]; hm_pdw = (hm_pdw + 1) & HPDM;
hm_rvg > 0 && (hm_rsil < srate || abs(hm_x) > 0.000001) ? (
  hm_x = ha0.hm_ap(HAP, HMTMP[190], hm_x, 0.62); hm_x = ha1.hm_ap(HAP + HAPN, HMTMP[191], hm_x, 0.62);
  hm_x = ha2.hm_ap(HAP + 2 * HAPN, HMTMP[192], hm_x, 0.62); hm_x = ha3.hm_ap(HAP + 3 * HAPN, HMTMP[193], hm_x, 0.62);
  hm_y0 = hr0.hm_rl(HRV,            hm_n0, hm_rg0, hm_rm0);
  hm_y1 = hr1.hm_rl(HRV + HRN,      hm_i1, hm_rg1, 0);
  hm_y2 = hr2.hm_rl(HRV + 2 * HRN,  hm_n2, hm_rg2, hm_rm1);
  hm_y3 = hr3.hm_rl(HRV + 3 * HRN,  hm_i3, hm_rg3, 0);
  hm_y4 = hr4.hm_rl(HRV + 4 * HRN,  hm_n4, hm_rg4, 1);
  hm_y5 = hr5.hm_rl(HRV + 5 * HRN,  hm_i5, hm_rg5, 0);
  hm_y6 = hr6.hm_rl(HRV + 6 * HRN,  hm_n6, hm_rg6, 1);
  hm_y7 = hr7.hm_rl(HRV + 7 * HRN,  hm_i7, hm_rg7, 0);
  hm_a0 = hm_y0 + hm_y1; hm_a1 = hm_y0 - hm_y1; hm_a2 = hm_y2 + hm_y3; hm_a3 = hm_y2 - hm_y3;
  hm_a4 = hm_y4 + hm_y5; hm_a5 = hm_y4 - hm_y5; hm_a6 = hm_y6 + hm_y7; hm_a7 = hm_y6 - hm_y7;
  hm_b0 = hm_a0 + hm_a2; hm_b2 = hm_a0 - hm_a2; hm_b1 = hm_a1 + hm_a3; hm_b3 = hm_a1 - hm_a3;
  hm_b4 = hm_a4 + hm_a6; hm_b6 = hm_a4 - hm_a6; hm_b5 = hm_a5 + hm_a7; hm_b7 = hm_a5 - hm_a7;
  hm_ri = hm_rw & HRM; hm_x *= 0.6;
  HRV[hm_ri]           = (hm_b0 + hm_b4) * 0.35355339 + hm_x;
  HRV[HRN + hm_ri]     = (hm_b1 + hm_b5) * 0.35355339 - hm_x;
  HRV[2 * HRN + hm_ri] = (hm_b2 + hm_b6) * 0.35355339 + hm_x;
  HRV[3 * HRN + hm_ri] = (hm_b3 + hm_b7) * 0.35355339 - hm_x;
  HRV[4 * HRN + hm_ri] = (hm_b0 - hm_b4) * 0.35355339 + hm_x;
  HRV[5 * HRN + hm_ri] = (hm_b1 - hm_b5) * 0.35355339 - hm_x;
  HRV[6 * HRN + hm_ri] = (hm_b2 - hm_b6) * 0.35355339 + hm_x;
  HRV[7 * HRN + hm_ri] = (hm_b3 - hm_b7) * 0.35355339 - hm_x;
  hm_wl_ = (hm_y0 - hm_y2 + hm_y4 - hm_y6) * 0.5; hm_wr2 = (hm_y1 - hm_y3 + hm_y5 - hm_y7) * 0.5;
  abs(hm_x) + abs(hm_wl_) + abs(hm_wr2) < 0.000001 ? hm_rsil += 1 : hm_rsil = 0;
  hm_rol = hm_wl_ * hm_rwg * hm_rmn * hm_rvg; hm_ror = hm_wr2 * hm_rwg * hm_rmn * hm_rvg;
) : hm_rol = hm_ror = 0;
hm_rw = (hm_rw + 1) & HRM;

// the plumes' memory: the cloud and its reverb, mono (so a plume is a reversed slice of the cloud's own reverb)
hm_a = (hm_cl + hm_cr) * 0.5 + (hm_rol + hm_ror) * 0.35; PB[hm_pw] = abs(hm_a) < 0.000000000001 ? 0 : hm_a; hm_pw = (hm_pw + 1) & PBM;

hm_L = (hm_cl + hm_pxl * 0.5 + hm_eol + hm_rol) * hm_bgl; hm_R = (hm_cr + hm_pxr * 0.5 + hm_eor + hm_ror) * hm_bgr;

// DC block
hm_dcyl = hm_L - hm_dcxl + 0.9997 * hm_dcyl; hm_dcxl = hm_L; hm_L = hm_dcyl;
hm_dcyr = hm_R - hm_dcxr + 0.9997 * hm_dcyr; hm_dcxr = hm_R; hm_R = hm_dcyr;

// ---------- MASTER ----------
hm_vol += (hm_volt - hm_vol) * hm_sm;
hm_L *= hm_vol; hm_R *= hm_vol;
hm_L = ostL.ost_band(hm_L); hm_R = ostR.ost_band(hm_R);
ost_out(hm_L, hm_R);
spl0 = ost_l; spl1 = ost_r;
hm_pk = max(hm_pk * hm_pkd, max(abs(spl0), abs(spl1)));

@gfx 1200 850
ui_thm = 5; ui_hw = 1;
ui_begin(1200, 850);

// ---------- the card's colours: desaturated petrol-blue weathered aluminium (flat, sparse brushing), dark petrol
// title bands ruled in pale steel, sodium-amber lit keys and value arcs, the ghost-phosphor display ----------
FACE = 0x6C8891; FACEL = 0x9AB0B7; FACED = 0x4C656D; TRAY = 0x75939C; ETCH = 0x23393F; BRD = 0x1A2B30;
BAND = 0x1E3037; BANDL = 0x35505A; RULE = 0xC9D6D9; INK = 0x0A1114; LBL = 0x0B171B; CHL = 0xE5EDEF; DIM = 0x2E444B;
AMB = 0xF2B25A; AMBL = 0xFFDDA6; AMBD = 0x8C5B1F;
SCR = 0x050C0F; SCRH = 0x0F1F25; PH = 0x9FE2EE; PHL = 0xE9FDFF; PHD = 0x23454D; GRID = 0x16292F;
KEYOFF = 0x26363C; KEYHOV = 0x38505A; KEYT = 0xDCE6E9;
SKIRT = 0x24343A; SKIRTL = 0x4C656D; KCAP = 0xC6D1D4; KCAPB = 0x10181B;

// fonts, calibrated once per scale (a reference word fills the same width everywhere); large, for reading
sc != hmg_calsc ? (
  hmg_calsc = sc;
  hmg_f11 = ui_fitfont(11, 13 * sc);        // key captions, small print
  hmg_f12 = ui_fitfont(12, 15.5 * sc);      // section titles
  hmg_f13 = ui_fitfont(13, 14.5 * sc);      // knob labels, values, fields
);
gfx_setfont(11, "Trebuchet MS", hmg_f11, 'b'); gfx_setfont(12, "Trebuchet MS", hmg_f12, 'b');
gfx_setfont(13, "Trebuchet MS", hmg_f13, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');   // the card's name
gfx_setfont(15, "Georgia", 19 * sc, 'b');   // the numeral

// ---------- drawing helpers (base coordinates) ----------
function hmg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function hmg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function hmg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function hmg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function hmg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function hmg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function hmg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function hmg_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function hmg_ln(x1, y1, x2, y2, w) ( hmg_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function hmg_l1(x1, y1, x2, y2) ( gfx_line(x1 * sc, y1 * sc, x2 * sc, y2 * sc, 1); );
function hmg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function hmg_ring(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); );
function hmg_disc(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
// an inverted triangle (point down), outline or filled
function hmg_itri(cx, cy, r, fill) local(x1, y1, x2, y2, x3, y3) (
  x1 = cx - r * 0.866; y1 = cy - r * 0.5; x2 = cx + r * 0.866; y2 = y1; x3 = cx; y3 = cy + r;
  fill ? gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc) :
         ( hmg_l1(x1, y1, x2, y2); hmg_l1(x2, y2, x3, y3); hmg_l1(x3, y3, x1, y1); );
);
// sparse brushing lines over a box: flat means, no textures
function hmg_brush(x, y, w, h, n, seed) local(i, yy, x0, l) (
  i = 0;
  loop(n,
    yy = y + 1 + ui_hash(seed + i * 3.1) * (h - 2); x0 = x + ui_hash(seed + i * 7.7) * w * 0.7;
    l = min(w * (0.15 + 0.6 * ui_hash(seed + i * 1.3)), x + w - x0);
    ui_cola(i & 1 ? 0xFFFFFF : BRD, i & 1 ? 0.16 : 0.07); hmg_r(x0, yy, l, 1);
    i += 1;
  );
);
// an etched suspension crosshair
function hmg_cross(cx, cy, r) (
  ui_cola(ETCH, 0.7); hmg_r(cx - r, cy - 0.5, 2 * r, 1); hmg_r(cx - 0.5, cy - r, 1, 2 * r); hmg_ring(cx, cy, r * 0.55);
);
// the suspended figure, etched as abstract lines (upside down: the crossed leg above, the arms a triangle below)
function hmg_figure(cx, cy, s, col, al) (
  ui_cola(col, al);
  hmg_l1(cx - s * 0.5, cy - s * 1.6, cx + s * 0.5, cy - s * 1.6);          // the beam
  hmg_l1(cx, cy - s * 1.6, cx, cy - s * 0.6);                              // the rope and the straight leg
  hmg_l1(cx, cy - s * 0.95, cx + s * 0.45, cy - s * 1.15); hmg_l1(cx + s * 0.45, cy - s * 1.15, cx + s * 0.1, cy - s * 0.6);   // the crossed leg (a 4)
  hmg_l1(cx, cy - s * 0.6, cx, cy + s * 0.25);                              // the body
  hmg_itri(cx, cy + s * 0.35, s * 0.45, 0);                                 // the arms behind the back
  hmg_ring(cx, cy + s * 0.95, s * 0.22);                                    // the head, lowest
);
// a section: an ink frame, the brushed tray, a dark petrol title band ruled in pale steel, an amber inverted mark
function hmg_sect(x, y, w, h, title) (
  ui_col(INK); hmg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  ui_col(TRAY); hmg_r(x, y, w, h);
  hmg_brush(x, y + 25, w, h - 25, floor(w * h / 1900), x * 0.37 + y * 0.11);
  ui_cola(0xFFFFFF, 0.25); hmg_r(x, y + h - 1, w, 1); hmg_r(x + w - 1, y + 25, 1, h - 25);
  ui_col(BAND); hmg_r(x, y, w, 24);
  ui_cola(0xFFFFFF, 0.1); hmg_r(x, y, w, 1);
  ui_col(RULE); hmg_r(x, y + 24, w, 1.2);
  ui_col(AMB); hmg_itri(x + 12, y + 10.5, 5, 1);
  strlen(title) ? ( gfx_setfont(12); ui_col(CHL); hmg_t(x + 23, y + 3, title); );
);
function hmg_cap(x, y, s) ( gfx_setfont(11); ui_col(LBL); hmg_t(x, y, s); );
// the value pill (shown only while a control is touched)
function hmg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 4 * sc, 3 * sc);
  ui_col(AMB); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc + 1 * sc, tw + 12 * sc, th + 2 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);

// ---------- the knobs: flat machined caps (no gradients), the value arc in amber.
// big = the heavy oil-damped knob: a broad flat skirt with grip ribs, a flat cap; the pointer and the arc follow the
// hand at once, a small bead on the ring shows where the oil has let the sound go so far (an, 0 .. 1). cap: 1 = the black cap (a low-pass: the house colour code)
function hmg_kcap(cx, cy, r, n, an, bip, big, cap) local(rr, a, a0, ca, sa, w, i, b) (
  rr = r + (big ? 8 : 5) * sc; w = (big ? 3.4 : 2.6) * sc; a0 = -0.75 * $pi;
  ui_cola(INK, 0.5); hmg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.2 * sc);
  ui_col(AMB);
  bip ? ( abs(n - 0.5) > 0.004 ? hmg_arcw(cx, cy, rr, min(a0 + n * 1.5 * $pi, 0), max(a0 + n * 1.5 * $pi, 0), w); ) :
        ( n > 0.004 ? ( hmg_arcw(cx, cy, rr, a0, a0 + n * 1.5 * $pi, w); gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); ); );
  big && abs(an - n) > 0.01 ? ( ui_col(AMBL); gfx_circle(cx + sin(a0 + an * 1.5 * $pi) * rr, cy - cos(a0 + an * 1.5 * $pi) * rr, w * 0.75, 1, 1); );
  a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.3); gfx_circle(cx + 1.5 * sc, cy + 2.6 * sc, r, 1, 1);
  ui_col(INK); gfx_circle(cx, cy, r, 1, 1);
  ui_col(SKIRT); gfx_circle(cx, cy, r - 1.2 * sc, 1, 1);
  big ? (
    i = 0;
    loop(24, b = a + (i + 0.5) / 24 * 2 * $pi; ui_col(SKIRTL);
      hmg_lnp(cx + sin(b) * r * 0.8, cy - cos(b) * r * 0.8, cx + sin(b) * (r - 2.2 * sc), cy - cos(b) * (r - 2.2 * sc), 1.4 * sc); i += 1; );
    ui_col(INK); gfx_circle(cx, cy, r * 0.74, 1, 1);
    ui_col(cap == 1 ? KCAPB : KCAP); gfx_circle(cx, cy, r * 0.71, 1, 1);
    ui_col(cap == 1 ? KCAP : INK); hmg_lnp(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * r * 0.62, cy + sa * r * 0.62, max(2.6 * sc, r * 0.09));
    ui_col(AMB); gfx_circle(cx + ca * r * 0.88, cy + sa * r * 0.88, max(2.4 * sc, r * 0.07), 1, 1);
  ) : (
    ui_col(INK); gfx_circle(cx, cy, r * 0.76, 1, 1);
    ui_col(cap == 1 ? KCAPB : KCAP); gfx_circle(cx, cy, r * 0.73, 1, 1);
    ui_col(cap == 1 ? KCAP : INK); hmg_lnp(cx + ca * r * 0.1, cy + sa * r * 0.1, cx + ca * r * 0.92, cy + sa * r * 0.92, max(2.2 * sc, r * 0.12));
  );
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps. act >= 0: where
// the oil-damped value is now (in the slider's units)
function hmg_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp, big, act, cap) local(v, n, an, dx, dy, hov, did) (
  // (the drag state hmg_dk* belongs to the knobs alone: nothing else in the panel may use these names)
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - hmg_dklt < 0.35 && hmg_dklid == idx) || (mouse_cap & 4) ? ( hmg_set(idx, def); drag_id = -1; hmg_dklt = 0; ) : (
      drag_id = did; hmg_dky = mouse_y; hmg_dky0 = mouse_y; hmg_dkmv = 0; hmg_dklt = time_precise(); hmg_dklid = idx;
      hmg_dkn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  // a press only starts changing the value once the mouse has moved a few pixels (the house dead zone)
  drag_id == did && !hmg_dkmv && abs(mouse_y - hmg_dky0) > 3 * sc ? ( hmg_dkmv = 1; hmg_dky = mouse_y; );
  drag_id == did && hmg_dkmv ? (
    hmg_dkn = min(max(hmg_dkn + (hmg_dky - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1); hmg_dky = mouse_y;
    v = lg ? lo * (hi / lo) ^ hmg_dkn : lo + hmg_dkn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? hmg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    hmg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1);
  an = act >= 0 ? min(max(lg ? log(max(act, lo) / lo) / log(hi / lo) : (act - lo) / (hi - lo), 0), 1) : n;
  hmg_kcap(cx * sc, cy * sc, r * sc, n, an, lo < 0 && hi > 0, big, cap);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.13); gfx_circle(cx * sc, cy * sc, r * 0.7 * sc, 1, 1);
    sprintf(#hmg_vv, fmt, v);
    hmg_pill(cx, cy + r + (big ? 9 : 6), #hmg_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(strlen(label) > 7 ? 11 : 13); ui_col(LBL); hmg_tc(cx, cy + r + (big ? 21 : 14), label); );
  );
);
// ---------- lit keys (sodium amber = on); returns 1 when clicked ----------
function hmg_key(x, y, w, h, on, s) local(hov, hit) (
  hov = hmg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(AMBL, 0.35); hmg_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.3); hmg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); hmg_rr(x, y, w, h, 3);
  ui_col(on ? AMB : hov ? KEYHOV : KEYOFF); hmg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.45); hmg_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.1); hmg_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? INK : KEYT); hmg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function hmg_toggle(x, y, w, h, idx, s) ( hmg_key(x, y, w, h, slider(idx) >= 0.5, s) ? hmg_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// ---------- the drop-down box: the setting in phosphor; a click opens the list (the current one ticked), the wheel steps ----------
function hmg_dd(x, y, w, h, idx, lo, n, list, s) local(hov, i, k) (
  hov = hmg_hov(x, y, w, h);
  ui_cola(0x000000, 0.3); hmg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); hmg_rr(x, y, w, h, 3);
  ui_col(hov ? SCRH : SCR); hmg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(13); ui_col(PH); hmg_tc(x + (w - 12) * 0.5, y + h * 0.5, s);
  ui_col(AMB); gfx_triangle((x + w - 15) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 7) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 11) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1; strcpy(#hmg_m, ""); i = 0; k = floor(slider(idx) + 0.5) - lo;
    loop(n, i == k ? strcat(#hmg_m, "!"); strcat(#hmg_m, pk_pitem(list, i + 1, #hmg_k)); i < n - 1 ? strcat(#hmg_m, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#hmg_m); i > 0 ? hmg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    hmg_set(idx, min(max(floor(slider(idx) + 0.5) - sign(mouse_wheel), lo), lo + n - 1)); mouse_wheel = 0;
  );
);
// ---------- the slow-glide fader (upright): a black slot, a scale, a flat cap with an ink line and an amber notch;
// the amber marker beside the slot shows act (where the glide or the LFO is now) ----------
function hmg_fader(x, y, len, idx, lo, hi, def, fmt, act, label) local(v, n, hov, did, py, i, t, an) (
  did = 3000 + idx; v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  hov = hmg_hov(x - 16, y - 10, 32, len + 20);
  i = 0; loop(11, t = i / 10;
    ui_cola(INK, i == 0 || i == 10 || i == 5 ? 0.8 : 0.4);
    hmg_r(x - 14, y + len - t * len, i % 5 == 0 ? 7 : 4, 1); hmg_r(x + 14 - (i % 5 == 0 ? 7 : 4), y + len - t * len, i % 5 == 0 ? 7 : 4, 1);
    i += 1; );
  ui_col(INK); hmg_rr(x - 3, y - 2, 6, len + 4, 3);
  ui_col(AMBD); hmg_r(x - 1, y + len - n * len, 2, n * len);
  an = min(max((act - lo) / (hi - lo), 0), 1);
  ui_col(AMB); gfx_triangle((x + 5) * sc, (y + len - an * len) * sc, (x + 10) * sc, (y + len - an * len - 3.5) * sc, (x + 10) * sc, (y + len - an * len + 3.5) * sc);
  py = y + len - n * len;
  ui_cola(0x000000, 0.3); hmg_rr(x - 13 + 1, py - 8 + 2, 26, 16, 2);
  ui_col(INK); hmg_rr(x - 13, py - 8, 26, 16, 2);
  ui_col(hov || drag_id == did ? 0xEEF3F4 : KCAP); hmg_rr(x - 12, py - 7, 24, 14, 1.5);
  ui_col(INK); hmg_r(x - 10, py - 0.75, 20, 1.5);
  ui_col(AMBD); hmg_r(x - 12, py - 1.5, 3, 3);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - hmg_dflt < 0.35 && hmg_dflid == idx) || (mouse_cap & 4) ? ( hmg_set(idx, def); drag_id = -1; hmg_dflt = 0; ) :
    ( drag_id = did; hmg_dfy = mouse_y; hmg_dfn = n; hmg_dflt = time_precise(); hmg_dflid = idx; );
  );
  drag_id == did ? (
    t = hmg_dfy - mouse_y; hmg_dfy = mouse_y;
    hmg_dfn = min(max(hmg_dfn + t / (len * sc) * ((mouse_cap & 8) ? 0.15 : 1), 0), 1);
    v = lo + hmg_dfn * (hi - lo);
    slider(idx) != v ? hmg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    hmg_set(idx, min(max(v + mouse_wheel / 120 * (hi - lo) * ((mouse_cap & 8) ? 0.005 : 0.02), lo), hi)); mouse_wheel = 0;
  );
  (hov || drag_id == did) ? ( sprintf(#hmg_vv, fmt, slider(idx)); hmg_pill(x, y + len + 8, #hmg_vv); ) :
    ( gfx_setfont(11); ui_col(LBL); hmg_tc(x, y + len + 17, label); );
);
function hmg_nname(n) ( sprintf(#hmg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (floor(n + 0.5) % 12) + 1, #hmg_k), floor(floor(n + 0.5) / 12) - 1); #hmg_nn; );
function hmg_inscale(n) ( (SCL[floor(slider4 + 0.5)] >> ((floor(n + 0.5) - floor(slider3 + 0.5) + 120) % 12)) & 1; );
HMG_SCL = "Major (Ionian)|Dorian|Phrygian|Lydian|Mixolydian|Minor (Aeolian)|Locrian|Major pentatonic|Minor pentatonic|Suspended pentatonic|Harmonic minor|Melodic minor|Whole tone|Hirajoshi|In Sen|Hungarian minor|Double harmonic";
HMG_SCS = "MAJOR|DORIAN|PHRYGIAN|LYDIAN|MIXOLYDIAN|MINOR|LOCRIAN|MAJOR PENTA|MINOR PENTA|SUSPENDED|HARMONIC MIN|MELODIC MIN|WHOLE TONE|HIRAJOSHI|IN SEN|HUNGARIAN|DOUBLE HARM";
HMG_CYC = "1 bar|2 bars|4 bars|8 bars|16 bars|32 bars|5 s|10 s|20 s|30 s|1 min|2 min|5 min";

// ======================== the faceplate: petrol-blue weathered aluminium ========================
ui_col(FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); hmg_rr(4, 4, 1192, 842, 9);
ui_col(FACEL); hmg_rr(6.5, 6.5, 1187, 837, 7);
ui_col(INK); hmg_r(11, 11, 1178, 828);
ui_col(FACE); hmg_r(13, 13, 1174, 824);
hmg_brush(13, 59, 1174, 708, 220, 12.7);
// the etching (decoration only): inverted triangles and suspension crosshairs in the gutters
ui_cola(ETCH, 0.45);
hmg_i = 0; loop(14, hmg_itri(17.5, 90 + hmg_i * 48, 2.5, 0); hmg_itri(1182.5, 90 + hmg_i * 48, 2.5, 0); hmg_i += 1; );
hmg_cross(403, 424, 5); hmg_cross(797, 424, 5); hmg_cross(797, 240, 4); hmg_cross(403, 608, 4); hmg_cross(797, 608, 4); hmg_cross(594, 687, 4);
ui_cola(ETCH, 0.3); hmg_r(13, 424, 4, 1); hmg_r(1183, 424, 4, 1); hmg_r(13, 766, 1174, 1);
// the header: dark petrol, ruled in pale steel
ui_col(BAND); hmg_r(13, 13, 1174, 44);
ui_col(RULE); hmg_r(13, 57, 1174, 1.5);
ui_col(AMB); hmg_r(13, 58.5, 60, 2); hmg_r(1127, 58.5, 60, 2);
// the numeral, hanging on its rope from the top edge, inside an inverted triangle
ui_cola(RULE, 0.55); hmg_l1(600, 13, 600, 15); hmg_r(586, 13, 28, 1);
ui_cola(AMB, 0.55); hmg_itri(600, 30, 27, 0); hmg_itri(600, 30, 31, 0);
ui_cola(RULE, 0.35); hmg_i = 0; loop(3, gfx_arc(600 * sc, 35 * sc, (34 + hmg_i * 4) * sc, 0.6 * $pi, 0.9 * $pi, 1); gfx_arc(600 * sc, 35 * sc, (34 + hmg_i * 4) * sc, -0.9 * $pi, -0.6 * $pi, 1); hmg_i += 1; );
ui_col(INK); hmg_disc(600, 35, 19.5); ui_col(RULE); hmg_ring(600, 35, 18.5); ui_col(BANDL); hmg_disc(600, 35, 17);
ui_cola(AMB, 0.6); hmg_ring(600, 35, 14.5);
gfx_setfont(15); ui_col(AMBL); hmg_tc(600, 35.5, "XII");
// presets
pk_pextra = "Reset all to defaults";
hmg_k_ = pk_preset(22 * sc, 18 * sc, 330 * sc, 34 * sc, pr_cur, #hm_pm);
hmg_k_ > 0 ? ( hmg_k_ > hm_npre ? reset_all() : load_preset(hmg_k_); );
gfx_setfont(12); ui_col(AMB); hmg_t(366, 18, "GENERATIVE CLOUD"); ui_col(CHL); hmg_t(366, 35, "PLAYED BY SUBTRACTION");
// MIDI: activity and channel
pk_led(668 * sc, 35 * sc, 4.5 * sc, ins_midi_lit(), AMB);
gfx_setfont(11); ui_col(CHL); hmg_tc(668, 21, "MIDI");
sprintf(#hmg_g, slider51 < 0.5 ? "OMNI" : "CH %.0f", slider51);
hmg_dd(684, 22, 86, 26, 51, 0, 17, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", #hmg_g);
// the state of things
ui_col(INK); hmg_rr(782, 22, 324, 26, 3); ui_col(SCR); hmg_rr(783.5, 23.5, 321, 23, 2);
gfx_setfont(11); ui_col(PH);
sprintf(#hmg_g, "%s %s  ·  %s  ·  %d VOID%s", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", floor(slider3 + 0.5) + 1, #hmg_k), pk_pitem(HMG_SCS, floor(slider4 + 0.5) + 1, #hmg_k2),
        hm_gate > 0.02 ? (hm_run ? "THE CLOUD HANGS" : "THE CLOUD LIFTS") : "AT REST", hm_nva, hm_nva == 1 ? "" : "S");
hmg_tc(944, 35, #hmg_g);
ui_size_picker(1118 * sc, 26 * sc);

// ======================== THE CLOUD ========================
hmg_sect(22, 68, 376, 352, "THE CLOUD");
hmg_toggle(222, 70, 92, 20, 2, "TRANSPORT");
hmg_toggle(322, 70, 68, 20, 1, "RUN");
hmg_cap(34, 96, "ROOT"); hmg_cap(110, 96, "SCALE");
hmg_dd(34, 112, 68, 26, 3, 0, 12, "C|C#|D|D#|E|F|F#|G|G#|A|A#|B", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", floor(slider3 + 0.5) + 1, #hmg_k2));
hmg_dd(110, 112, 176, 26, 4, 0, 17, HMG_SCL, pk_pitem(HMG_SCS, floor(slider4 + 0.5) + 1, #hmg_k2));
ui_col(INK); hmg_rr(294, 112, 96, 26, 3); ui_col(SCR); hmg_rr(295.5, 113.5, 93, 23, 2);
hmg_n = 0; hmg_i = 0; loop(NV, VC[hmg_i * 4 + 3] && VC[hmg_i * 4 + 1] > 0.02 ? hmg_n += 1; hmg_i += 1; );
sprintf(#hmg_g, "%d PARTIALS", hm_gate > 0 ? hmg_n : hm_nact); gfx_setfont(11); ui_col(PH); hmg_tc(342, 125, #hmg_g);
hmg_cap(294, 96, "LIVING");
// the heavy oil-damped knobs
hmg_knob(104, 206, 38, 8, 0, 100, 55, 0, "DENSITY", "%.0f%%", 0, 1, hm_den * 100, 0);
hmg_knob(244, 206, 38, 9, 0, 100, 50, 0, "INERTIA", "%.0f%%", 0, 1, hm_inr * 100, 0);
gfx_setfont(11); ui_col(LBL);
sprintf(#hmg_g, "SWELL %.0f s", 0.6 * 2 ^ (hm_inr * 4) * 4); hmg_tc(350, 192, #hmg_g);
sprintf(#hmg_g, "LIFE %.0f s", 4 * 2 ^ (hm_inr * 3.5)); hmg_tc(350, 210, #hmg_g);
ui_cola(ETCH, 0.5); hmg_r(316, 178, 68, 1); hmg_r(316, 224, 68, 1);
// the register, the wander, the colour, the field, the level
hmg_knob(52, 300, 17, 5, 24, 96, 43, 0, "", hmg_nname(slider5), 1, 0, -1, 0);
hmg_knob(112, 300, 17, 6, 24, 108, 84, 0, "", hmg_nname(slider6), 1, 0, -1, 0);
gfx_setfont(13); ui_col(LBL);
!(drag_id == 2005 || (sqr(mouse_x - 52 * sc) + sqr(mouse_y - 300 * sc) <= sqr(23 * sc))) ? ( sprintf(#hmg_g, "LOW %s", hmg_nname(slider5)); gfx_setfont(11); hmg_tc(52, 331, #hmg_g); );
!(drag_id == 2006 || (sqr(mouse_x - 112 * sc) + sqr(mouse_y - 300 * sc) <= sqr(23 * sc))) ? ( sprintf(#hmg_g, "HIGH %s", hmg_nname(slider6)); gfx_setfont(11); hmg_tc(112, 331, #hmg_g); );
hmg_knob(178, 300, 17, 7, 0, 50, 10, 0, "MICRO", "%.1f cents", 0, 0, -1, 0);
hmg_knob(238, 300, 17, 10, 0, 100, 45, 0, "BRIGHT", "%.0f%%", 0, 0, -1, 1);
hmg_knob(298, 300, 17, 11, 0, 100, 70, 0, "SPREAD", "%.0f%%", 0, 0, -1, 0);
hmg_knob(358, 300, 17, 12, 0, 100, 75, 0, "LEVEL", "%.0f%%", 0, 0, -1, 0);
// the key over the register: the scale's notes raised, the root in amber, the voids as hollow lights
hmg_stx = 34; hmg_stw = 352; hmg_sty = 352; hmg_sth = 56;
ui_col(INK); hmg_rr(hmg_stx - 2, hmg_sty - 2, hmg_stw + 4, hmg_sth + 4, 3); ui_col(SCR); hmg_rr(hmg_stx, hmg_sty, hmg_stw, hmg_sth, 2);
hmg_lo = min(slider5, slider6); hmg_hi = max(slider5, slider6); hmg_nn_ = max(hmg_hi - hmg_lo + 1, 1); hmg_sw = (hmg_stw - 8) / hmg_nn_;
hmg_i = 0;
loop(hmg_nn_,
  hmg_n = hmg_lo + hmg_i; hmg_x = hmg_stx + 4 + hmg_i * hmg_sw;
  hmg_v = hm_nva ? hm_vcut(hmg_n) : 0;
  hmg_in = hmg_inscale(hmg_n); hmg_rt = ((hmg_n - floor(slider3 + 0.5) + 120) % 12) == 0;
  ui_col(hmg_in ? (hmg_rt ? AMB : ui_mix(SCR, PH, 0.7)) : PHD);
  hmg_in ? hmg_r(hmg_x + hmg_sw * 0.18, hmg_sty + 8, max(hmg_sw * 0.64, 1), 26) : hmg_r(hmg_x + hmg_sw * 0.3, hmg_sty + 26, max(hmg_sw * 0.4, 1), 8);
  hmg_v > 0.5 ? ( ui_col(SCR); hmg_r(hmg_x, hmg_sty + 4, hmg_sw, 32); ui_cola(PHL, 0.3 + 0.7 * hmg_v);
    gfx_rect((hmg_x + hmg_sw * 0.12) * sc, (hmg_sty + 8) * sc, max(hmg_sw * 0.76, 1) * sc, 26 * sc, 0); );
  (hmg_n % 12) == 0 ? ( gfx_setfont(11); ui_col(PHD); hmg_tc(hmg_x + hmg_sw * 0.5, hmg_sty + 46, hmg_nname(hmg_n)); );
  hmg_i += 1;
);

// ======================== the display: the cloud hanging from the beam, inverted ========================
ui_cola(0x000000, 0.35); hmg_rr(411, 72, 384, 352, 12);
ui_col(INK); hmg_rr(408, 68, 384, 352, 12);
ui_col(0x1A2A30); hmg_rr(411.5, 71.5, 377, 345, 10);
ui_col(SCR); hmg_rr(417, 77, 366, 334, 7);
hmg_sx = 419; hmg_sw = 362; hmg_by = 100; hmg_rh = 5.85;
hmg_plo = hm_hlo; hmg_phi = hm_hhi; hmg_phi <= hmg_plo + 1 ? ( hmg_plo = 39; hmg_phi = 88; );
function hmg_px(p) ( hmg_sx + (p - hmg_plo) / (hmg_phi - hmg_plo) * hmg_sw; );
// the history: each row a moment of the cloud (the newest under the beam, older ones sinking); the voids hollow, with
// bright walls
hmg_j = 0;
loop(HNR,
  hmg_row = (hm_hrow - hmg_j + HNR) % HNR; hmg_q = HIS + hmg_row * HNB; hmg_w = HVD + hmg_row * HNB;
  hmg_age = 1 - 0.55 * hmg_j / HNR;
  hmg_y = hmg_by + 4 + hmg_j * hmg_rh;
  hmg_i = 0;
  loop(HNB,
    hmg_e = min(hmg_q[hmg_i] * 0.9, 1); hmg_v = hmg_w[hmg_i];
    hmg_c = ui_mix(SCR, PH, sqrt(hmg_e) * 0.5 * hmg_age);
    hmg_v > 0.35 ? (
      (hmg_i > 0 && hmg_w[hmg_i - 1] <= 0.35) || (hmg_i < HNB - 1 && hmg_w[hmg_i + 1] <= 0.35) ?
        hmg_c = ui_mix(SCR, PHL, min(hmg_v, 1) * 0.85 * hmg_age) : hmg_c = ui_mix(hmg_c, 0x000000, 0.75 * min(hmg_v, 1));
    );
    ui_col(hmg_c); hmg_r(hmg_sx + hmg_i * hmg_sw / HNB, hmg_y, hmg_sw / HNB + 0.4, hmg_rh + 0.4);
    hmg_i += 1;
  );
  hmg_j += 1;
);
// the beam, with the octaves marked
ui_col(RULE); hmg_r(417, hmg_by - 1, 366, 1.5);
gfx_setfont(11);
hmg_n = ceil(hmg_plo / 12) * 12;
while (hmg_n <= hmg_phi) ( hmg_x = hmg_px(hmg_n); ui_col(PHD); hmg_r(hmg_x, hmg_by - 5, 1, 4); ui_col(PH); hmg_tc(hmg_x, hmg_by - 13, hmg_nname(hmg_n)); hmg_n += 12; );
// the living partials: threads hanging from the beam, longer and brighter the louder they are
hmg_i = 0;
loop(NV,
  VC[hmg_i * 4 + 3] && VC[hmg_i * 4 + 1] * hm_gate > 0.01 ? (
    hmg_x = hmg_px(VC[hmg_i * 4]); hmg_e = min(VC[hmg_i * 4 + 1] * hm_gate, 1);
    ui_cola(PHL, 0.25 + 0.6 * hmg_e); hmg_l1(hmg_x, hmg_by + 1, hmg_x, hmg_by + 1 + 34 * hmg_e);
    hmg_disc(hmg_x, hmg_by + 1 + 34 * hmg_e, 1.3);
  );
  hmg_i += 1;
);
// the voids: an inverted mark on the beam (in every octave when OCTAVES is lit), its ring closing as it heals
hmg_j = 0;
loop(NVD,
  hmg_q = VD + hmg_j * VDS;
  hmg_q[0] ? (
    hmg_n = hmg_q[1]; hmg_v = min(hmg_q[11], 1);
    slider26 >= 0.5 ? hmg_n -= 12 * floor((hmg_n - hmg_plo) / 12);
    while (hmg_n <= hmg_phi) (
      hmg_n >= hmg_plo ? (
        hmg_x = hmg_px(hmg_n);
        ui_cola(PHL, 0.35 + 0.65 * hmg_v); hmg_itri(hmg_x, hmg_by - 3, 4.5, 1);
        ui_cola(AMB, 0.8); gfx_arc(hmg_x * sc, (hmg_by - 3) * sc, 7.5 * sc, 0, 2 * $pi * (1 - hmg_q[7]), 1);
      );
      hmg_n += slider26 >= 0.5 ? 12 : 1000;
    );
  );
  hmg_j += 1;
);
// the plumes: amber light swelling backwards into the note (rings closing in, a beam growing down the tunnel)
hmg_j = 0;
loop(NPL,
  PD[hmg_j * 4 + 3] ? (
    hmg_n = PD[hmg_j * 4]; hmg_m = (slider5 + slider6) * 0.5; hmg_n += 12 * floor((hmg_m - hmg_n) / 12 + 0.5);
    hmg_x = hmg_px(hmg_n); hmg_u = PD[hmg_j * 4 + 1]; hmg_e = min(PD[hmg_j * 4 + 2], 1);
    ui_cola(AMB, 0.15 + 0.6 * hmg_e); hmg_ln(hmg_x, hmg_by + 2, hmg_x, hmg_by + 2 + 260 * hmg_e, 1 + 4 * hmg_e);
    ui_cola(AMBL, 0.2 + 0.7 * hmg_e); hmg_l1(hmg_x, hmg_by + 2, hmg_x, hmg_by + 2 + 260 * hmg_e);
    hmg_i = 0;
    loop(3,
      hmg_r_ = ((1 - hmg_u) * 3 + hmg_i) / 3; hmg_r_ -= floor(hmg_r_); hmg_r_ = 6 + hmg_r_ * 46;
      ui_cola(AMB, (0.15 + 0.55 * hmg_e) * (1 - (hmg_r_ - 6) / 46)); gfx_arc(hmg_x * sc, hmg_by * sc, hmg_r_ * sc, 0.55 * $pi, 1.45 * $pi, 1);
      hmg_i += 1;
    );
  );
  hmg_j += 1;
);
gfx_setfont(11); ui_col(PHD);
hm_gate < 0.02 && hmg_e_ < 0.01 ? ( ui_col(PH); hmg_tc(600, 260, slider1 >= 0.5 ? "THE CLOUD GATHERS" : "TRANSPORT OR RUN WAKES THE CLOUD"); );
ui_col(INK); hmg_rr(421, 389, 358, 18, 2);
sprintf(#hmg_g, "CYCLE %.1f s", hm_cyc); ui_col(PH); hmg_tr(774, 398, #hmg_g);
hmg_t(426, 390, "THE CLOUD HANGS FROM THE BEAM");

// ======================== REGENERATION ========================
hmg_sect(802, 68, 376, 168, "REGENERATION");
hmg_cap(814, 96, "CYCLE");
hmg_dd(814, 112, 132, 26, 33, 0, 13, HMG_CYC, pk_pitem("1 BAR|2 BARS|4 BARS|8 BARS|16 BARS|32 BARS|5 S|10 S|20 S|30 S|1 MIN|2 MIN|5 MIN", floor(slider33 + 0.5) + 1, #hmg_k2));
hmg_toggle(954, 112, 76, 26, 27, "HOLD");
gfx_setfont(11); ui_col(LBL); sprintf(#hmg_g, "= %.1f s", hm_cyc); hmg_t(1040, 118, #hmg_g);
// the heal curve and the voids along it
hmg_gx = 814; hmg_gy = 148; hmg_gw = 270; hmg_gh = 76;
ui_col(INK); hmg_rr(hmg_gx - 2, hmg_gy - 2, hmg_gw + 4, hmg_gh + 4, 3); ui_col(SCR); hmg_rr(hmg_gx, hmg_gy, hmg_gw, hmg_gh, 2);
ui_col(GRID); hmg_r(hmg_gx + 4, hmg_gy + 10, hmg_gw - 8, 1); hmg_r(hmg_gx + 4, hmg_gy + hmg_gh - 8, hmg_gw - 8, 1);
hmg_hc = slider34 / 100; hmg_i = 0;
loop(41, hmg_u = hmg_i / 40; hmg_v = hmg_hc < 0 ? (1 - hmg_u) ^ (1 + 3 * -hmg_hc) : 1 - hmg_u ^ (1 + 3 * hmg_hc);
  hmg_x = hmg_gx + 6 + hmg_u * (hmg_gw - 12); hmg_y = hmg_gy + hmg_gh - 8 - hmg_v * (hmg_gh - 18);
  hmg_i > 0 ? ( ui_col(PH); hmg_ln(hmg_ox, hmg_oy, hmg_x, hmg_y, 1.4); ); hmg_ox = hmg_x; hmg_oy = hmg_y; hmg_i += 1; );
hmg_j = 0;
loop(NVD,
  hmg_q = VD + hmg_j * VDS;
  hmg_q[0] ? (
    hmg_x = hmg_gx + 6 + (hmg_q[6] == 0 ? 0 : hmg_q[7]) * (hmg_gw - 12);
    hmg_y = hmg_gy + hmg_gh - 8 - min(hmg_q[11] / max(hmg_q[2], 0.0001), 1) * (hmg_gh - 18);
    ui_cola(AMB, 0.35); hmg_disc(hmg_x, hmg_y, 5.5); ui_col(hmg_q[6] == 2 ? AMBD : AMBL); hmg_disc(hmg_x, hmg_y, 2.8);
  );
  hmg_j += 1;
);
gfx_setfont(11); ui_col(PHD); hmg_tr(hmg_gx + hmg_gw - 6, hmg_gy + 12, "HEAL CURVE");
hmg_knob(1132, 180, 22, 34, -100, 100, 0, 0, "HEAL", slider34 < -0.5 ? "FAST %.0f" : slider34 > 0.5 ? "SLOW %.0f" : "EVEN", 0, 0, -1, 0);

// ======================== REVERSE PLUME ========================
hmg_sect(802, 244, 376, 176, "REVERSE PLUME");
hmg_fader(836, 284, 96, 29, 0.5, 6, 2.5, "%.2f s", hm_plen, "LENGTH");
hmg_fader(888, 284, 96, 30, 0, 100, 50, "%.0f%%", slider30, "CURVE");
hmg_fader(940, 284, 96, 31, 0, 100, 35, "%.0f%%", hm_ptl * 100, "TAIL");
hmg_fader(992, 284, 96, 28, 0, 100, 60, "%.0f%%", hm_plg * 100, "LEVEL");
hmg_knob(1048, 330, 17, 32, 0, 100, 40, 0, "TONE", slider32 < 35 ? "NARROW %.0f%%" : slider32 > 65 ? "WIDE %.0f%%" : "%.0f%%", 0, 0, -1, 0);
// the plume's swell (forward time; it is the past read backwards) and the plumes in flight
hmg_gx = 1078; hmg_gy = 270; hmg_gw = 92; hmg_gh = 122;
ui_col(INK); hmg_rr(hmg_gx - 2, hmg_gy - 2, hmg_gw + 4, hmg_gh + 4, 3); ui_col(SCR); hmg_rr(hmg_gx, hmg_gy, hmg_gw, hmg_gh, 2);
hmg_p = 1 + 5 * slider30 / 100; hmg_i = 0;
loop(31, hmg_u = hmg_i / 30; hmg_v = hmg_u ^ hmg_p;
  hmg_x = hmg_gx + 6 + hmg_u * (hmg_gw - 12); hmg_y = hmg_gy + hmg_gh - 8 - hmg_v * (hmg_gh - 30);
  hmg_i > 0 ? ( ui_col(AMB); hmg_ln(hmg_ox, hmg_oy, hmg_x, hmg_y, 1.4); ); hmg_ox = hmg_x; hmg_oy = hmg_y; hmg_i += 1; );
hmg_i = 0;
loop(21, hmg_u = 0.4 + 0.6 * hmg_i / 20; hmg_v = ((hmg_u - 0.4) / 0.6) ^ hmg_p * slider31 / 100;
  hmg_x = hmg_gx + 6 + hmg_u * (hmg_gw - 12); hmg_y = hmg_gy + hmg_gh - 8 - hmg_v * (hmg_gh - 30);
  hmg_i > 0 ? ( ui_cola(AMB, 0.55); hmg_l1(hmg_ox, hmg_oy, hmg_x, hmg_y); ); hmg_ox = hmg_x; hmg_oy = hmg_y; hmg_i += 1; );
hmg_j = 0; hmg_e_ = 0;
loop(NPL,
  PD[hmg_j * 4 + 3] ? (
    hmg_u = PD[hmg_j * 4 + 1]; hmg_e_ = max(hmg_e_, PD[hmg_j * 4 + 2]);
    hmg_x = hmg_gx + 6 + hmg_u * (hmg_gw - 12); hmg_y = hmg_gy + hmg_gh - 8 - hmg_u ^ hmg_p * (hmg_gh - 30);
    ui_cola(AMBL, 0.4); hmg_disc(hmg_x, hmg_y, 5); ui_col(AMBL); hmg_disc(hmg_x, hmg_y, 2.4);
  );
  hmg_j += 1;
);
gfx_setfont(11); ui_col(PHD); hmg_tc(hmg_gx + hmg_gw * 0.5, hmg_gy + 10, "SWELL");

// ======================== LFO MATRIX ========================
hmg_sect(22, 428, 376, 176, "LFO MATRIX  ·  SLOW TIDES");
hmg_i = 0;
loop(4,
  hmg_x = 30 + hmg_i * 92;
  hmg_i > 0 ? ( ui_cola(ETCH, 0.5); hmg_r(hmg_x - 4, 462, 1, 130); );
  gfx_setfont(12); ui_col(LBL); hmg_tc(hmg_x + 44, 470, pk_pitem("TUNE|DRIFT|FILTER|TIME", hmg_i + 1, #hmg_k));
  hmg_lv = hmg_i == 0 ? hm_l1 : hmg_i == 1 ? hm_l2 : hmg_i == 2 ? hm_l3 : hm_l4;
  hmg_ld = hmg_i == 0 ? hm_ld1 : hmg_i == 1 ? hm_ld2 : hmg_i == 2 ? hm_ld3 : hm_ld4;
  hmg_knob(hmg_x + 24, 524, 15, 13 + hmg_i * 2, 2, 300, hmg_i == 0 ? 47 : hmg_i == 1 ? 31 : hmg_i == 2 ? 73 : 113,
           1, "RATE", slider(13 + hmg_i * 2) < 60 ? "%.1f s" : "%.0f s", 0, 0, -1, 0);
  // the LFO now: a dot on its orbit round the RATE knob
  ui_col(INK); hmg_r(hmg_x + 2, 484, 44, 4); ui_col(PHD); hmg_r(hmg_x + 23.5, 482, 1, 8);
  ui_col(AMB); hmg_r(hmg_x + 23 + hmg_lv * 20 * min(hmg_ld * 2 + 0.1, 1), 482, 3, 8);
  hmg_fader(hmg_x + 66, 484, 92, 14 + hmg_i * 2, 0, 100, hmg_i == 0 ? 25 : 30,
            "%.0f%%", hmg_ld * 100 * (0.5 + 0.5 * hmg_lv), "DEPTH");
  hmg_i += 1;
);

// ======================== THE CLEARING ========================
hmg_sect(408, 428, 384, 176, "THE CLEARING  ·  NOTES CARVE");
hmg_knob(450, 496, 19, 21, 0, 100, 100, 0, "DEPTH", "%.0f%%", 0, 0, -1, 0);
hmg_knob(524, 496, 19, 22, 0.1, 3, 0.6, 1, "WIDTH", "%.2f st", 0, 0, -1, 0);
hmg_knob(598, 496, 19, 23, 5, 4000, 300, 1, "SPEED", slider23 < 1000 ? "%.0f ms" : "%.0f ms", 0, 0, -1, 0);
hmg_knob(672, 496, 19, 24, 0, 100, 40, 0, "VELOCITY", "%.0f%%", 0, 0, -1, 0);
hmg_knob(746, 496, 19, 25, 0, 100, 35, 0, "RESONANCE", "%.0f%%", 0, 0, -1, 0);
