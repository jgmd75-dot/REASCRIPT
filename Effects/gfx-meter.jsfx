    (rL_ > mt_dL || (slider4 == 1 && t_ - mt_tL > 2)) ? ( mt_dL = rL_; mt_tL = t_; );
    (rR_ > mt_dR || (slider4 == 1 && t_ - mt_tR > 2)) ? ( mt_dR = rR_; mt_tR = t_; );
    slider4 == 1 && t_ - mt_tL > 2 ? mt_dL = rL_; slider4 == 1 && t_ - mt_tR > 2 ? mt_dR = rR_;
  );
  mt_dL < -200 && slider4 > 0 ? mt_dL = rL_; mt_dR < -200 && slider4 > 0 ? mt_dR = rR_;
