desc:Elbe [channel strip] (GFX)
//tags: channel strip valve tube preamp eq compressor broadcast vintage
//author: JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-output, gfx-glow (.jsfx-inc) in the same folder.
//
// Elbe - a 1950s-60s German valve broadcast channel: the elder of the Mistral / Spree family. In the spirit of the
// valve broadcast amplifiers (the V76-style microphone / line amplifier), a passive programme equaliser with valve
// make-up gain, and the valve broadcast compressor (the U73-style feedback compressor). Reference names live in these
// comments only - never on the panel.
//
// SIGNAL FLOW
//   INPUT TRANSFORMER (always in: the core thickens the lows first when driven)
//   AMPLIFIER   GAIN (-6 .. +18 dB in 3 dB steps) into a biased triode stage (even harmonics, a soft top),
//               BASS CUT (off / 60 / 120 Hz), PHASE; IN key (out = straight through)
//   then, in the order the ORDER key sets (EQ > COMP or COMP > EQ; the modules swap places on the panel):
//   EQUALISER   passive LOW shelf (40 - 220 Hz), PRESENCE lift (1.4 - 5.6 kHz, broad, boost only), HIGH shelf
//               (5 - 14 kHz), stepped like the originals; the valve make-up stage after it adds a little colour
//   COMPRESSOR  a feedback valve compressor (the detector hears the output): soft knee, the ratio grows the further it
//               is pushed (COMP), or a firm LIMIT; THRESHOLD (dBu), ATTACK (fast / medium / slow), RELEASE
//               (0.3 - 5 s or AUTO, programme-dependent), GAIN = make-up through its own valve: the harder GAIN is
//               pushed, the more that valve colours and the deeper a gentle, broad dip around 2 kHz (to -3 dB)
//   OUTPUT TRANSFORMER, LEVEL, then the house output stage (CLIP always on: a character unit), ceiling -0.3 dBFS
// Linked stereo: one set of controls, one compressor detector; each side's valves drift on their own.
// An ORDER change ducks the output for a few ms and swaps the chain at the silent point; IN keys crossfade (12 ms).
// Calibration: 0 dBu = -18 dBFS. VU meters: 0 VU = 0 dBu.
//
// DRIFT (0 - 100 %, 50 % = standard):
//   heaters   each side's valve bias and gain wander slowly (the colour breathes)
//   mains     a faint, slower wobble of the output level
//   warm-up   from load the unit starts a touch quieter and more coloured and settles over about a minute
//             (counted on processed audio); the HEATERS lamp brightens as it settles
//   ageing    the compressor's capacitors: its attack / release times and threshold wander a little
//   0 % = none (and no warm-up), 100 % = twice the standard amount, a little faster.
//
// GUI: S / M / L / ? size picker; drag knobs (Shift = fine), mouse wheel, double-click or Ctrl-click = default.
// PRESETS: Init, Vocal Warmth, Radio Voice, Spoken Word, Drum Bus, Snare Crack, Bass Weight, Acoustic Guitar, Piano Sheen, Hot Valve, Bus Glue, Brickwall.
//   Each is level-matched to Init on programme with LEVEL.
// Latency: 0 samples.
//
// TWEAK points are marked TWEAK.
// STATUS: Stable v2.0 (from the Lab, Oct 2026). v0.3 (complete: sound engine, 500-series lunchbox faceplate,
//   12 factory presets).

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-glow.jsfx-inc

slider1:pre_in=1<0,1,1{Out,In}>-Amplifier in
slider2:pre_gain=0<-6,18,3>-Amplifier gain (dB)
slider3:pre_cut=0<0,2,1{Off,60 Hz,120 Hz}>-Bass cut
slider4:pre_ph=0<0,1,1{Normal,Reversed}>-Phase
slider5:eq_in=1<0,1,1{Out,In}>-Equaliser in
slider6:lo_g=0<-12,12,2>-Low (dB)
slider7:lo_f=2<0,4,1{40 Hz,60 Hz,100 Hz,150 Hz,220 Hz}>-Low frequency
slider8:pr_g=0<0,10,2>-Presence (dB)
slider9:pr_f=1<0,4,1{1.4 kHz,2 kHz,2.8 kHz,4 kHz,5.6 kHz}>-Presence frequency
slider10:hi_g=0<-12,12,2>-High (dB)
slider11:hi_f=1<0,3,1{5 kHz,7 kHz,10 kHz,14 kHz}>-High frequency
slider12:c_in=1<0,1,1{Out,In}>-Compressor in
slider13:c_thr=6<-20,20,0.5>-Threshold (dBu)
slider14:c_mode=0<0,1,1{Comp,Limit}>-Mode
slider15:c_atk=1<0,2,1{Fast,Medium,Slow}>-Attack
slider16:c_rel=2<0,5,1{0.3 s,0.6 s,1.2 s,2.5 s,5 s,Auto}>-Release
slider17:c_gain=0<0,20,0.5>-Gain (dB)
slider18:order=0<0,1,1{EQ first,COMP first}>-Order
slider19:out_lvl=0<-18,6,0.1>-Level (dB)
slider20:drift=50<0,100,1>-Drift (%)
slider21:prs_sel=0<0,12,1{No preset,Init,Vocal Warmth,Radio Voice,Spoken Word,Drum Bus,Snare Crack,Bass Weight,Acoustic Guitar,Piano Sheen,Hot Valve,Bus Glue,Brickwall}>-Preset

@init
#ui_man = "gfx-elbe";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );   // first instance: M size, the Init preset (later loads restore their own)
ui_dflt = 1;
gfx_ext_retina = 1;
CR = 16;                                  // control rate: every 16 samples

ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();

// ---------- tables ----------
LOF = 0;  LOF[0] = 40;  LOF[1] = 60;  LOF[2] = 100;  LOF[3] = 150;  LOF[4] = 220;
PRF = 8;  PRF[0] = 1400;  PRF[1] = 2000;  PRF[2] = 2800;  PRF[3] = 4000;  PRF[4] = 5600;
HIF = 16; HIF[0] = 5000;  HIF[1] = 7000;  HIF[2] = 10000;  HIF[3] = 14000;
RELT = 24; RELT[0] = 0.3;  RELT[1] = 0.6;  RELT[2] = 1.2;  RELT[3] = 2.5;  RELT[4] = 5;
ATKT = 32; ATKT[0] = 2;  ATKT[1] = 8;  ATKT[2] = 25;        // ms  TWEAK

// ---------- tuning (TWEAK) ----------
PRE_K = 0.32;     // triode drive per unit of input (program at 0 dBu and +18 dB gain: clearly coloured)
PRE_B = 0.14;     // triode bias: the even harmonics
EQ_K = 0.16;      // the EQ's make-up valve (gentle)
EQ_B = 0.08;
MU_K0 = 0.12;     // the compressor's make-up valve: drive at GAIN 0 ...
MU_K1 = 0.42;     // ... and at GAIN +20 dB
MU_B = 0.10;
XI_K = 0.55;      // input transformer core
XO_K = 0.40;      // output transformer core
DIP_DB = -3;      // the make-up dip at full GAIN (2 kHz, broad)

// ---------- drift sources (each its own instance) ----------
HTL.drift_init(0.8 + rand(0.4));  HTR.drift_init(0.8 + rand(0.4));     // heaters, left / right
HGL.drift_init(0.7 + rand(0.4));  HGR.drift_init(0.7 + rand(0.4));     // heater gain, left / right
MNS.drift_init(1.0 + rand(0.4));                                        // mains
CPA.drift_init(0.6 + rand(0.4));  CPR.drift_init(0.6 + rand(0.4));  CPT.drift_init(0.6 + rand(0.4));   // capacitors
warm_t = 0;

// ---------- helpers (audio thread) ----------
function db2g(d) ( exp(d * 0.11512925464970228); );
function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
// the slope of ts at b (its small-signal gain), so a biased stage keeps unity gain for small signals
function dts(b) local(u, v) ( u = 27 + 9 * b * b;  v = 27 + b * b;  ((27 + 3 * b * b) * u - b * v * 18 * b) / (u * u); );

// a biased valve stage: unity small-signal gain, soft and asymmetric when driven, DC removed (5 Hz)
function valve(x, k, b, sl) instance(dx, dy) local(y) (
  y = (ts(x * k + b) - ts(b)) / (k * sl);
  dy = y - dx + dc_r * dy;  dx = y;
  dy;
);
// a transformer: its core saturates the lows first (below ~120 Hz), the top passes
function xfmr(x, k) instance(lp) (
  lp += (x - lp) * xf_c;
  x - lp + ts(lp * k) / k;
);
// biquads (RBJ), transposed direct form II. kind: 0 bell, 1 low shelf, 2 high shelf, 3 high-pass
function bq_set(kind, f, db, q) instance(b0, b1, b2, a1, a2, n0, n1, n2, m1, m2, bq_n) local(A, w, cw, sw, al, a0, sa) (
  A = 10 ^ (db / 40);  w = 2 * $pi * min(f, 0.45 * srate) / srate;  cw = cos(w);  sw = sin(w);  al = sw / (2 * q);
  kind == 0 ? (
    a0 = 1 + al / A;  n0 = (1 + al * A) / a0;  n1 = -2 * cw / a0;  n2 = (1 - al * A) / a0;  m1 = -2 * cw / a0;  m2 = (1 - al / A) / a0;
  ) : kind == 1 ? (
    sa = 2 * sqrt(A) * al;
    a0 = (A + 1) + (A - 1) * cw + sa;
    n0 = A * ((A + 1) - (A - 1) * cw + sa) / a0;  n1 = 2 * A * ((A - 1) - (A + 1) * cw) / a0;  n2 = A * ((A + 1) - (A - 1) * cw - sa) / a0;
    m1 = -2 * ((A - 1) + (A + 1) * cw) / a0;  m2 = ((A + 1) + (A - 1) * cw - sa) / a0;
  ) : kind == 2 ? (
    sa = 2 * sqrt(A) * al;
    a0 = (A + 1) - (A - 1) * cw + sa;
    n0 = A * ((A + 1) + (A - 1) * cw + sa) / a0;  n1 = -2 * A * ((A - 1) + (A + 1) * cw) / a0;  n2 = A * ((A + 1) + (A - 1) * cw - sa) / a0;
    m1 = 2 * ((A - 1) - (A + 1) * cw) / a0;  m2 = ((A + 1) - (A - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al;  n0 = (1 + cw) * 0.5 / a0;  n1 = -(1 + cw) / a0;  n2 = (1 + cw) * 0.5 / a0;  m1 = -2 * cw / a0;  m2 = (1 - al) / a0;
  );
  // (computed straight into the targets) bq() ramps to them over the next CR samples; bq_jump = set at once (load)
  bq_jump ? ( b0 = n0;  b1 = n1;  b2 = n2;  a1 = m1;  a2 = m2;  bq_n = 0; ) : bq_n = CR;
);
function bq(x) instance(b0, b1, b2, a1, a2, n0, n1, n2, m1, m2, bq_n, z1, z2) local(y, t) (
  bq_n > 0 ? ( t = 1 / bq_n;  b0 += (n0 - b0) * t;  b1 += (n1 - b1) * t;  b2 += (n2 - b2) * t;  a1 += (m1 - a1) * t;  a2 += (m2 - a2) * t;  bq_n -= 1; );
  y = b0 * x + z1;  z1 = b1 * x - a1 * y + z2;  z2 = b2 * x - a2 * y;  y;
);

// ---------- parameters -> engine targets (audio thread: @slider, and @block after a panel edit) ----------
function update_params() (
  drift_macro(drift);                                       // dm_a: amount 0 - 2 (50 % = 1), dm_s: speed 0.5 - 1.5
  t_pre = pre_in >= 0.5;  t_eq = eq_in >= 0.5;  t_cmp = c_in >= 0.5;
  t_pg = pre_gain;  t_pol = pre_ph >= 0.5 ? -1 : 1;
  t_cutf = log(pre_cut < 0.5 ? 8 : pre_cut < 1.5 ? 60 : 120);        // off = 8 Hz: below hearing, so it simply glides away
  t_lo = lo_g;  t_lof = log(LOF[floor(lo_f + 0.5)]);
  t_pr = pr_g;  t_prf = log(PRF[floor(pr_f + 0.5)]);
  t_hi = hi_g;  t_hif = log(HIF[floor(hi_f + 0.5)]);
  t_thr = c_thr;  t_mk = c_gain;
  lim = c_mode >= 0.5;
  atk_ms = ATKT[floor(c_atk + 0.5)];
  rel_auto = c_rel >= 4.5;  rel_s = rel_auto ? 1 : RELT[floor(c_rel + 0.5)];
  t_out = out_lvl;
);

xf_c = 1 - exp(-2 * $pi * 120 / srate);
dc_r = 1 - 2 * $pi * 5 / srate;
sm_c = 1 - exp(-CR / (0.03 * srate));        // control-rate glides: 30 ms
sw_c = 1 - exp(-1 / (0.012 * srate));        // IN keys: 12 ms crossfades
rms_c = 1 - exp(-1 / (0.003 * srate));       // detector: 3 ms mean square
dkr = 1 / (0.005 * srate);                   // ORDER: 5 ms duck each way
dk = 1;  ord_cur = order >= 0.5;  ord_st = 0;
update_params();
s_pg = t_pg;  s_lo = t_lo;  s_lof = t_lof;  s_pr = t_pr;  s_prf = t_prf;  s_hi = t_hi;  s_hif = t_hif;
s_thr = t_thr;  s_mk = t_mk;  s_out = t_out;  s_cutf = t_cutf;
m_pre = t_pre;  m_eq = t_eq;  m_cmp = t_cmp;  pol_s = t_pol;
pre_g = db2g(s_pg);  mk_g = db2g(s_mk);  out_g = db2g(s_out);  pg_i = mk_i = og_i = 0;
gr = 0;  gr_avg = 0;  cg = 1;  cgt = 1;  cgi = 0;  det_ms = 0;
cr_n = 0;  eq_tick = 1;  bq_jump = 1;

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function param_touched_au(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 1); pv(2, 0); pv(3, 0); pv(4, 0); pv(5, 1); pv(6, 0); pv(7, 2); pv(8, 0); pv(9, 1); pv(10, 0);
  pv(11, 1); pv(12, 1); pv(13, 6); pv(14, 0); pv(15, 1); pv(16, 2); pv(17, 0); pv(18, 0); pv(19, 0); pv(20, 50);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? ( pv(2, 3); pv(3, 1); pv(6, 2); pv(7, 2); pv(8, 4); pv(9, 2); pv(10, 4); pv(11, 2); pv(13, 0); pv(15, 1); pv(16, 1); pv(17, 4); pv(19, -5.0); );   // Vocal Warmth
  p == 3 ? ( pv(2, 9); pv(3, 2); pv(6, -4); pv(7, 3); pv(8, 8); pv(9, 3); pv(10, 2); pv(11, 1); pv(13, -6); pv(15, 0); pv(16, 5); pv(17, 8); pv(19, -6.5); );   // Radio Voice
  p == 4 ? ( pv(2, 3); pv(3, 2); pv(8, 4); pv(9, 2); pv(13, 2); pv(15, 1); pv(16, 1); pv(17, 3); pv(19, -5.0); );   // Spoken Word
  p == 5 ? ( pv(2, 6); pv(6, 4); pv(7, 1); pv(8, 2); pv(9, 3); pv(10, 4); pv(11, 3); pv(13, -2); pv(15, 2); pv(16, 0); pv(17, 5); pv(19, -6.0); );   // Drum Bus
  p == 6 ? ( pv(2, 9); pv(3, 1); pv(6, 2); pv(7, 3); pv(8, 6); pv(9, 4); pv(10, 4); pv(11, 2); pv(13, -6); pv(15, 0); pv(16, 0); pv(17, 8); pv(19, -6.5); );   // Snare Crack
  p == 7 ? ( pv(2, 6); pv(6, 6); pv(7, 1); pv(8, 2); pv(9, 0); pv(10, -4); pv(11, 1); pv(13, 0); pv(15, 1); pv(16, 2); pv(17, 4); pv(19, -4.5); );   // Bass Weight
  p == 8 ? ( pv(2, 3); pv(3, 2); pv(6, -2); pv(7, 4); pv(8, 4); pv(9, 3); pv(10, 4); pv(11, 3); pv(13, 4); pv(15, 1); pv(16, 1); pv(17, 2); pv(19, -5.0); );   // Acoustic Guitar
  p == 9 ? ( pv(2, 3); pv(3, 1); pv(6, 2); pv(7, 2); pv(8, 2); pv(9, 4); pv(10, 2); pv(11, 2); pv(13, 6); pv(15, 2); pv(16, 2); pv(17, 2); pv(19, -5.5); );   // Piano Sheen
  p == 10 ? ( pv(2, 18); pv(6, 2); pv(7, 2); pv(12, 0); pv(19, -17.5); );   // Hot Valve
  p == 11 ? ( pv(6, 2); pv(7, 0); pv(10, 2); pv(11, 3); pv(13, 2); pv(15, 2); pv(16, 5); pv(17, 3); pv(19, -3.0); );   // Bus Glue
  p == 12 ? ( pv(5, 0); pv(13, 6); pv(14, 1); pv(15, 0); pv(16, 1); pv(17, 4); pv(19, -4.0); );   // Brickwall
  i = 1;  loop(20, param_touched_au(i);  i += 1; );
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
gui_dirty ? ( gui_dirty = 0;  update_params(); );
bdt = samplesblock / srate;
// drift: heaters (bias + gain, each side), mains, capacitors; warm-up counted on processed audio
warm_t += bdt;
wu = exp(-warm_t / 22) * min(dm_a, 1);                     // TWEAK: settles over about a minute
hsp = 0.035 * dm_s * samplesblock / srate;
bias_l = PRE_B + 0.06 * dm_a * HTL.drift_tick(hsp) + 0.10 * wu;
bias_r = PRE_B + 0.06 * dm_a * HTR.drift_tick(hsp) + 0.10 * wu;
hg_l = db2g(0.18 * dm_a * HGL.drift_tick(hsp) - 1.2 * wu);
hg_r = db2g(0.18 * dm_a * HGR.drift_tick(hsp) - 1.2 * wu);
sl_l = dts(bias_l);  sl_r = dts(bias_r);
mains_g = db2g(0.06 * dm_a * MNS.drift_tick(0.12 * dm_s * samplesblock / srate));
csp = 0.02 * dm_s * samplesblock / srate;
age_a = 1 + 0.18 * dm_a * CPA.drift_tick(csp);
age_r = 1 + 0.18 * dm_a * CPR.drift_tick(csp);
age_t = 0.6 * dm_a * CPT.drift_tick(csp);
// the make-up valve and the 2 kHz dip follow GAIN (glided)
mu_k = MU_K0 + (MU_K1 - MU_K0) * min(1, s_mk / 20);
mu_sl = dts(MU_B);  eq_sl = dts(EQ_B);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);                    // house output stage: CLIP, always on, -0.3 dBFS
// display hand-offs
gr_disp = min(gr_disp, gr);
vu_disp = vu_n > 0 ? vu_acc / vu_n : 0;  vu_acc = 0;  vu_n = 0;
in_disp = in_n > 0 ? in_acc / in_n : 0;  in_acc = 0;  in_n = 0;
ost_clipped ? ( clip_disp = 1;  ost_clipped = 0; );
wu_disp = wu;
ord_disp = ord_cur;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- control rate: glides, filter coefficients, the compressor's gain computer ----------
cr_n <= 0 ? (
  cr_n = CR;
  s_pg += (t_pg - s_pg) * sm_c;  s_thr += (t_thr - s_thr) * sm_c;  s_mk += (t_mk - s_mk) * sm_c;  s_out += (t_out - s_out) * sm_c;
  // EQ coefficients only while something is moving
  e_mv = abs(t_lo - s_lo) + abs(t_lof - s_lof) + abs(t_pr - s_pr) + abs(t_prf - s_prf) + abs(t_hi - s_hi) + abs(t_hif - s_hif);
  abs(t_cutf - s_cutf) > 0.0001 || eq_tick ? (
    s_cutf += (t_cutf - s_cutf) * sm_c;  abs(t_cutf - s_cutf) <= 0.0001 ? s_cutf = t_cutf;
    HPL.bq_set(3, exp(s_cutf), 0, 0.707);  HPR.bq_set(3, exp(s_cutf), 0, 0.707);
  );
  e_mv > 0.0001 || eq_tick || abs(s_mk - mk_last) > 0.001 ? (
    s_lo += (t_lo - s_lo) * sm_c;  s_lof += (t_lof - s_lof) * sm_c;  s_pr += (t_pr - s_pr) * sm_c;
    s_prf += (t_prf - s_prf) * sm_c;  s_hi += (t_hi - s_hi) * sm_c;  s_hif += (t_hif - s_hif) * sm_c;
    // passive shelves: gentle slopes (S ~ 0.5); presence: broad (Q 0.7)
    LSL.bq_set(1, exp(s_lof), s_lo, 0.5);  LSR.bq_set(1, exp(s_lof), s_lo, 0.5);
    PRL.bq_set(0, exp(s_prf), s_pr, 0.7);  PRR.bq_set(0, exp(s_prf), s_pr, 0.7);
    HSL.bq_set(2, exp(s_hif), s_hi, 0.5);  HSR.bq_set(2, exp(s_hif), s_hi, 0.5);
    dipv = DIP_DB * (min(1, s_mk / 20)) ^ 1.5;                                         // the make-up dip, 2 kHz, broad
    DPL.bq_set(0, 2000, dipv, 0.45);  DPR.bq_set(0, 2000, dipv, 0.45);
    mk_last = s_mk;  eq_tick = 0;
  );
  bq_jump = 0;
  // gains ramp per sample to their control-rate targets (no zipper steps)
  pg_i = (db2g(s_pg) - pre_g) / CR;  mk_i = (db2g(s_mk) - mk_g) / CR;  og_i = (db2g(s_out) * mains_g - out_g) / CR;
  // the compressor: a feedback detector (it hears its own output), soft knee; COMP's ratio grows with the overshoot
  lv = 10 * log10(det_ms + 0.0000000001) + 18;                                        // dBu (RMS: 0 dBu = -18 dBFS, as the VUs)
  ov = lv - (s_thr + age_t);
  // feedback law: the detector hears the output, so the reduction is (r - 1) x the output's overshoot (ratio r : 1)
  lim ? ( kw = 2;  rr = 10; ) : ( kw = 6;  rr = min(3.5, 1.5 + 0.25 * max(ov, 0)); );  // TWEAK: COMP's ratio grows with the push (1.5 -> 3.5 : 1)
  tgr = ov <= -kw * 0.5 ? 0 : ov < kw * 0.5 ? (1 - rr) * sqr(ov + kw * 0.5) / (2 * kw) : (1 - rr) * ov;
  ac = 1 - exp(-CR / (atk_ms * 0.001 * age_a * srate));
  rel_auto ? (
    gr_avg += (gr - gr_avg) * (1 - exp(-CR / (3 * srate)));
    rt = 0.3 + 3 * min(1, -gr_avg / 10);                                             // short peaks recover fast, sustained GR slowly
  ) : rt = rel_s;
  rc = 1 - exp(-CR / (rt * age_r * srate));
  gr += (tgr - gr) * (tgr < gr ? ac : rc);
  cgt = db2g(gr);  cgi = (cgt - cg) / CR;
);
cr_n -= 1;

// ---------- per-sample glides ----------
m_pre += (t_pre - m_pre) * sw_c;  m_eq += (t_eq - m_eq) * sw_c;  m_cmp += (t_cmp - m_cmp) * sw_c;
pol_s += (t_pol - pol_s) * sw_c;
cg += cgi;  pre_g += pg_i;  mk_g += mk_i;  out_g += og_i;

xl = spl0;  xr = spl1;
in_acc += (xl * xl + xr * xr) * 0.5;  in_n += 1;

// ---------- input transformer ----------
xl = XIL.xfmr(xl, XI_K);  xr = XIR.xfmr(xr, XI_K);

// ---------- AMPLIFIER ----------
m_pre > 0.00001 ? (
  al = AVL.valve(xl * pre_g * hg_l, PRE_K, bias_l, sl_l) * pol_s;
  ar = AVR.valve(xr * pre_g * hg_r, PRE_K, bias_r, sl_r) * pol_s;
  // bass cut (its cutoff glides; off = 8 Hz)
  al = HPL.bq(al);  ar = HPR.bq(ar);
  xl += (al - xl) * m_pre;  xr += (ar - xr) * m_pre;
);

// ---------- EQ and COMP in the ORDER set; a change ducks the output and swaps at the silent point ----------
ord_st == 0 && (order >= 0.5) != ord_cur ? ord_st = 1;
k_ = 0;
loop(2,
  (k_ == 0) == (ord_cur == 0) ? (
    // EQUALISER: the passive network, then its make-up valve
    m_eq > 0.00001 ? (
      el = HSL.bq(PRL.bq(LSL.bq(xl)));  er = HSR.bq(PRR.bq(LSR.bq(xr)));
      el = EVL.valve(el, EQ_K, EQ_B, eq_sl);  er = EVR.valve(er, EQ_K, EQ_B, eq_sl);
      xl += (el - xl) * m_eq;  xr += (er - xr) * m_eq;
    );
  ) : (
    // COMPRESSOR: the gain cell, the detector on its output, then the make-up valve and the 2 kHz dip
    m_cmp > 0.00001 ? (
      cpl = xl * cg;  cpr = xr * cg;
      det_ms += (max(cpl * cpl, cpr * cpr) - det_ms) * rms_c;
      cpl = DPL.bq(MVL.valve(cpl * mk_g, mu_k, MU_B, mu_sl));  cpr = DPR.bq(MVR.valve(cpr * mk_g, mu_k, MU_B, mu_sl));
      xl += (cpl - xl) * m_cmp;  xr += (cpr - xr) * m_cmp;
    ) : ( det_ms = 0;  gr = 0;  cg = 1;  cgi = 0; );
  );
  k_ += 1;
);
ord_st == 1 ? ( dk -= dkr;  dk <= 0 ? ( dk = 0;  ord_cur = order >= 0.5;  ord_st = 2; ); ) :
ord_st == 2 ? ( dk += dkr;  dk >= 1 ? ( dk = 1;  ord_st = 0; ); );
ord_st ? ( g_ = dk * dk * (3 - 2 * dk);  xl *= g_;  xr *= g_; );

// ---------- output transformer, LEVEL, the house output stage ----------
xl = XOL.xfmr(xl, XO_K);  xr = XOR.xfmr(xr, XO_K);
xl *= out_g;  xr *= out_g;
vu_acc += (xl * xl + xr * xr) * 0.5;  vu_n += 1;
xl = ostL.ost_band(xl);  xr = ostR.ost_band(xr);
ost_out(xl, xr);
spl0 = ost_l;  spl1 = ost_r;

@gfx 820 668
// =====================================================================
// GUI - a 500-series lunchbox: four modules (AMPLIFIER, the EQUALISER and COMPRESSOR in the ORDER set, OUTPUT) in the
// grey-green broadcast finish, slotted into a dark frame under a header bar (title, HEATERS lamp, presets, S/M/L/?).
// Knobs: pointer knobs with a raised fin and a white tip over printed scales (gain controls red, timing / threshold
// black, output grey-blue, the bass cut yellow); the EQ's concentric knobs: a knurled silver FREQ ring with the band's
// colour, an inner cap for the boost / cut, amber dots for its steps. Layout (design units, 820 x 668): header 0 - 58;
// frame 66 - 656; modules 176 x 554 at y 86, x 16 / 200 / 384 / 568 (8 apart).
// =====================================================================
C_FACE = 0x7F8F80;  C_FACEL = 0x8C9C8C;  C_FACED = 0x6C7B6D;  C_BAR = 0x37433A;  C_FRAME = 0x232826;
C_INK = 0x141B16;  C_INK2 = 0x2E3A31;  C_BRASS = 0xC9A24A;  C_CREAM = 0xEFE6CC;
C_LCDBG = 0x0B120D;  C_LCDTX = 0xF2C26A;  C_AMBDOT = 0xE8A23A;
K_RED = 0xC2382E;  K_BLK = 0x262626;  K_BLUE = 0x7C93A3;  K_YEL = 0xE2B23A;
B_LOW = 0x7A4E2E;  B_PRES = 0x3E7A4E;  B_HIGH = 0xA8302A;               // house band colours: LF brown, HMF green, HF red
LK_YEL = 0xF2C230;  LK_AMB = 0xF2A41E;  LK_SKY = 0x9FD0E8;  lk_well = 0x141518;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rivet(x, y) (
  col(0x9AA79C, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.6);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
// a section: its shade, a narrow darker bottom / right edge, a light top line, the title on the header band's line
function section(x, y, w, h, c, title) (
  col(c, 1);  u_rect(x, y, w, h);
  col(shade(c, 0.8), 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h);
  col(0xFFFFFF, 0.45);  u_rect(x, y, w - 2, 1);
  gfx_setfont(4);  col(C_TITLE, 1);  text_l(px(x + 16), py(y + 20), title);
);
function u_g2db(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );          // the GUI's own
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%+d dB", v) :
  fmt == 2 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 3 ? sprintf(#kv, "%+.1f dBu", v) :
  fmt == 4 ? sprintf(#kv, "%d %%", v) :
  fmt == 5 ? strcpy(#kv, v < 0.5 ? "40 Hz" : v < 1.5 ? "60 Hz" : v < 2.5 ? "100 Hz" : v < 3.5 ? "150 Hz" : "220 Hz") :
  fmt == 6 ? strcpy(#kv, v < 0.5 ? "1.4 kHz" : v < 1.5 ? "2 kHz" : v < 2.5 ? "2.8 kHz" : v < 3.5 ? "4 kHz" : "5.6 kHz") :
  fmt == 7 ? strcpy(#kv, v < 0.5 ? "5 kHz" : v < 1.5 ? "7 kHz" : v < 2.5 ? "10 kHz" : "14 kHz") :
  fmt == 8 ? strcpy(#kv, v < 0.5 ? "FAST" : v < 1.5 ? "MEDIUM" : "SLOW") :
  fmt == 10 ? strcpy(#kv, v < 0.5 ? "OFF" : v < 1.5 ? "60 Hz" : "120 Hz") :
  fmt == 9 ? strcpy(#kv, v < 0.5 ? "0.3 s" : v < 1.5 ? "0.6 s" : v < 2.5 ? "1.2 s" : v < 3.5 ? "2.5 s" : v < 4.5 ? "5 s" : "AUTO") :
             sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
// ---------- knob control: click-drag (Shift = fine), wheel, double-click / Ctrl-click = default; returns the value ----------
function kctl(hov, idx, vmin, vmax, def, st, did) local(v, t, now)
(
  v = max(vmin, min(vmax, slider(idx)));  t = (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == did && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = did;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = did;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) :
      v = vmin + max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03))) * (vmax - vmin);
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == did ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : (st > 0 ? 160 : 220))));
    v = vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st : v = floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  max(vmin, min(vmax, slider(idx)));
);
function k_ang(t) ( -0.75 * $pi + t * 1.5 * $pi; );
// a printed scale: n ticks over the sweep at radius r0 .. r1, and the labels of a "|" list at radius rl on every
// lab-th tick (lab = 1: every tick)
function k_scale(cx, cy, r0, r1, rl, n, list, lab) local(j, a, x, y)
(
  j = 0;
  loop(n,
    a = k_ang(n > 1 ? j / (n - 1) : 0.5);
    col(C_INK, 0.9);  gfx_line(px(cx + sin(a) * r0), py(cy - cos(a) * r0), px(cx + sin(a) * r1), py(cy - cos(a) * r1), 1);
    gfx_line(px(cx + sin(a) * r0) + 0.6, py(cy - cos(a) * r0), px(cx + sin(a) * r1) + 0.6, py(cy - cos(a) * r1), 1);
    strlen(list) && j % lab == 0 ? (
      gfx_setfont(5);  col(C_INK, 1);  text_c(px(cx + sin(a) * rl), py(cy - cos(a) * rl), pb_item(list, j / lab + 1, #ks));
    );
    j += 1;
  );
);
// the pointer knob: a round body, a raised fin across it ending in a white triangle; a coloured cap
function chk(cx, cy, r, idx, vmin, vmax, def, cap, lbl, fmt) local(x, y, rr, v, t, hov, a, sa, ca, st, dm, w0, w1, rb, tip, j)
(
  st = kstep;  kstep = 0;  dm = kdim;  kdim = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.2);
  v = kctl(hov, idx, vmin, vmax, def, st, idx);
  t = (v - vmin) / (vmax - vmin);  a = k_ang(t);  sa = sin(a);  ca = cos(a);
  // shadow, skirt, body
  col(0x0A0F0B, 0.35);  gfx_circle(x + ps(2), y + ps(3), rr, 1, 1);
  col(shade(cap, 0.62), 1);  gfx_circle(x, y, rr, 1, 1);
  col(cap, 1);  gfx_circle(x, y, rr * 0.86, 1, 1);
  col(0xFFFFFF, 0.14);  gfx_arc(x, y, rr * 0.8, -1.75, -0.25, 1);
  // the fin: from behind the centre to the rim, tapering; a lighter top face
  w0 = rr * 0.30;  w1 = rr * 0.13;  rb = rr * 0.66;  tip = rr * 1.02;
  col(shade(cap, 0.55), 1);
  gfx_triangle(x - sa * rb + ca * w0 + ps(1), y + ca * rb + sa * w0 + ps(2), x + sa * tip + ca * w1 + ps(1), y - ca * tip + sa * w1 + ps(2),
               x + sa * tip - ca * w1 + ps(1), y - ca * tip - sa * w1 + ps(2), x - sa * rb - ca * w0 + ps(1), y + ca * rb - sa * w0 + ps(2));
  col(shade(cap, 1.18), 1);
  gfx_triangle(x - sa * rb + ca * w0, y + ca * rb + sa * w0, x + sa * tip + ca * w1, y - ca * tip + sa * w1,
               x + sa * tip - ca * w1, y - ca * tip - sa * w1, x - sa * rb - ca * w0, y + ca * rb - sa * w0);
  col(0xFFFFFF, 0.18);
  gfx_triangle(x - sa * rb + ca * w0 * 0.4, y + ca * rb + sa * w0 * 0.4, x + sa * tip * 0.96 + ca * w1 * 0.4, y - ca * tip * 0.96 + sa * w1 * 0.4,
               x + sa * tip * 0.96 - ca * w1 * 0.2, y - ca * tip * 0.96 - sa * w1 * 0.2, x - sa * rb - ca * w0 * 0.2, y + ca * rb - sa * w0 * 0.2);
  // the white triangle at the tip
  col(0xF6F2E6, 1);
  gfx_triangle(x + sa * tip * 0.99, y - ca * tip * 0.99, x + sa * rr * 0.6 + ca * rr * 0.17, y - ca * rr * 0.6 + sa * rr * 0.17,
               x + sa * rr * 0.6 - ca * rr * 0.17, y - ca * rr * 0.6 - sa * rr * 0.17);
  dm ? ( col(C_FACE, 0.5);  gfx_circle(x, y, rr + ps(1), 1, 1); );
  gfx_setfont(6);  col(C_INK, 1);  text_c(x, y + rr + ps(r >= 24 ? 30 : 26), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(16), fmtv(v, fmt));
);
// the concentric EQ knob: an outer knurled silver ring for FREQ (stepped), the band's colour on it, an inner cap for
// the boost / cut (stepped); amber dots for the cap's steps, the frequencies printed around
function conc(cx, cy, r, io, on, idef, ii, ilo, ihi, iidef, ist, band, flist, lbl, ffmt, gfmt)
  local(x, y, rr, ri, d2, ho, hi, vo, vi, ao, ai, j, n, a, did)
(
  x = px(cx);  y = py(cy);  rr = ps(r);  ri = rr * 0.56;
  d2 = sqr(mouse_x - x) + sqr(mouse_y - y);
  hi = d2 <= sqr(ri);  ho = !hi && d2 <= sqr(rr * 1.2);
  drag_idx == ii ? ( hi = 1;  ho = 0; );  drag_idx == 100 + io ? ( ho = 1;  hi = 0; );
  vo = kctl(ho, io, 0, on - 1, idef, 1, 100 + io);
  vi = kctl(hi, ii, ilo, ihi, iidef, ist, ii);
  ao = k_ang(vo / (on - 1));  ai = k_ang((vi - ilo) / (ihi - ilo));
  // the cap's steps: amber dots; the frequencies at the ring's step angles
  n = (ihi - ilo) / ist + 1;  j = 0;
  loop(n, a = k_ang(j / (n - 1));  col(C_AMBDOT, 1);  gfx_circle(x + sin(a) * (rr + ps(7)), y - cos(a) * (rr + ps(7)), ps(1.8), 1, 1);  j += 1; );
  gfx_setfont(5);  col(C_INK, 1);  j = 0;
  loop(on, a = k_ang(j / (on - 1));  text_c(x + sin(a) * (rr + ps(21)), y - cos(a) * (rr + ps(21)), pb_item(flist, j + 1, #kf));  j += 1; );
  // the knurled ring
  col(0x0A0F0B, 0.35);  gfx_circle(x + ps(2), y + ps(3), rr, 1, 1);
  col(0x8E9496, 1);  gfx_circle(x, y, rr, 1, 1);
  col(0x5E6466, 1);  j = 0;
  loop(40, a = j / 40 * 2 * $pi;  gfx_line(x + sin(a) * rr * 0.86, y - cos(a) * rr * 0.86, x + sin(a) * rr * 0.99, y - cos(a) * rr * 0.99, 1);  j += 1; );
  col(0xC9CED0, 1);  gfx_circle(x, y, rr * 0.82, 1, 1);
  col(band, 1);  gfx_circle(x, y, rr * 0.74, 1, 1);
  col(0xD7DBDD, 1);  gfx_circle(x, y, rr * 0.64, 1, 1);
  col(0xF6F2E6, 1);  pointer(x, y, sin(ao), cos(ao), rr * 0.64, rr * 0.98, ps(1.6));
  // the inner cap
  col(0x0A0F0B, 0.3);  gfx_circle(x + ps(1), y + ps(2), ri, 1, 1);
  col(0xB9BFC2, 1);  gfx_circle(x, y, ri, 1, 1);
  col(0xDDE1E3, 1);  gfx_circle(x - ri * 0.08, y - ri * 0.1, ri * 0.82, 1, 1);
  col(0x1A1A1A, 1);  pointer(x, y, sin(ai), cos(ai), ri * 0.15, ri * 0.95, ps(1.4));
  kdim ? ( col(C_FACE, 0.5);  gfx_circle(x, y, rr + ps(1), 1, 1); );
  kdim = 0;
  gfx_setfont(6);  col(C_INK, 1);  text_c(x, y + rr + ps(32), lbl);
  hi || drag_idx == ii ? hover_tag(x, y - rr - ps(30), fmtv(vi, gfmt)) :
  ho || drag_idx == 100 + io ? hover_tag(x, y - rr - ps(30), fmtv(vo, ffmt));
);
// a 500-series module: the faceplate, a thin inset outline, screws top and bottom, the title; returns nothing
function module(x, y, w, h, title) (
  col(0x0A0F0B, 0.5);  u_rect(x + 2, y + 3, w, h);
  col(C_FACE, 1);  u_rect(x, y, w, h);
  col(C_FACEL, 1);  u_rect(x, y, w, 1.5);  u_rect(x, y, 1.5, h);
  col(C_FACED, 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h);
  col(C_INK, 0.55);  u_rect(x + 10, y + 26, w - 20, 1.2);  u_rect(x + 10, y + h - 30, w - 20, 1.2);
  u_rect(x + 10, y + 26, 1.2, h - 56);  u_rect(x + w - 11.2, y + 26, 1.2, h - 56);
  // screws
  col(0x3A4038, 1);  gfx_circle(px(x + w * 0.5), py(y + 13), ps(5), 1, 1);  gfx_circle(px(x + w * 0.5), py(y + h - 14), ps(5), 1, 1);
  col(0x9AA79C, 1);  gfx_circle(px(x + w * 0.5), py(y + 13), ps(4), 1, 1);  gfx_circle(px(x + w * 0.5), py(y + h - 14), ps(4), 1, 1);
  col(0x3A4038, 1);  u_rect(x + w * 0.5 - 3, y + 12.4, 6, 1.2);  u_rect(x + w * 0.5 - 3, y + h - 14.6, 6, 1.2);
  gfx_setfont(4);  col(C_INK, 1);  text_c(px(x + w * 0.5), py(y + 44), title);
);
function dim_module(x, y, w, h) ( col(C_FACE, 0.5);  u_rect(x + 10, y + 56, w - 20, h - 92); );

// ---------- house lamp keys ----------
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(11);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
// small cream push-button (one of a set; the pressed one sits down and glows warm), returns 1 when clicked
function cr_key(x, y, w, h, on, str) local(hov, hit, b, dn) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  b = 1.5;  dn = on ? 0 : 1.5;
  col(0x000000, 0.3);  u_rect(x + 1, y + 2, w, h);                       // shadow on the panel
  col(0x16140F, 1);  u_rect(x, y, w, h);                                 // the well
  on ? ( col(0xFFB030, 0.22);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(0x16140F, 1);  u_rect(x, y, w, h); );
  col(on ? 0xF4EBCF : 0xBDB6A6, 1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn);
  on ? ( col(0xFFD27A, 0.18);  u_rect(x + b, y + b, w - 2 * b, h - 2 * b);
         col(0xFFFFFF, 0.55);  u_rect(x + b, y + b, w - 2 * b, 1);
         col(0x000000, 0.15);  u_rect(x + b, y + h - b - 2, w - 2 * b, 2); )
     : ( col(0x000000, 0.3);  u_rect(x + b, y + b + dn, w - 2 * b, 1.5); );
  hov ? ( col(0xFFFFFF, 0.1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn); );
  gfx_setfont(2);  col(on ? 0x2A2620 : 0x57524A, 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5 + dn * 0.5), str);
  hit;
);
function lcd(x, y, w, h, fnt, str) local(tw, th, gy) (
  col(0x6F7A70, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x020403, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);
// ---------- house preset bar: [PRESETS][<][>][LCD] ----------
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xD8DCD2, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xD8DCD2, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xD8DCD2, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(C_INK, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
// a lamp key that opens a menu of a list slider's values; shows the current one
function lk_menu(x, y, w, h, idx, list, n, c) local(t, sel, i) (
  t = floor(slider(idx) + 0.5);
  lk_key(x, y, w, h, 1, c, pb_item(list, t + 1, #lm)) ? (
    strcpy(#lmm, "");  i = 0;
    loop(n, i == t ? strcat(#lmm, "!");  strcat(#lmm, pb_item(list, i + 1, #lmt));  i < n - 1 ? strcat(#lmm, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h + 4);  sel = gfx_showmenu(#lmm);
    sel > 0 ? ( slider(idx) = sel - 1;  param_touched(idx); );
  );
);
// a VU meter, 170 x 96: cream face, -20 .. +3 (or a GR scale: 0 at the right, 20 dB of reduction at the left);
// the needle on a spring (pos / vel kept by the caller's slot), pivot below the face
function vu(x, y, w, h, val, grm, lbl, slot) local(cx, cyp, R, j, d, t, a, xx, yy, n, lin, sp, ti, to, tl, nl)
(
  vg_spill(px(x - 3), py(y - 3), ps(w + 6), ps(h + 6), 1);              // backlit (gfx-glow)
  col(0x2A2F2B, 1);  u_rect(x - 3, y - 3, w + 6, h + 6);
  vg_glow(px(x), py(y), ps(w), ps(h), 1);
  cx = x + w * 0.5;
  h < 70 ? ( cyp = y + h + 90;  R = h + 78;  sp = 0.42;  ti = R - 17;  to = R - 9;  tl = R + 1;  nl = R - 11; )   // short face: flat arc, numbers above the ticks
         : ( cyp = y + h + 34;  R = h + 14;  sp = 0.78;  ti = R - 10;  to = R;  tl = R - 20;  nl = R - 2; );
  // scale: angle from -sp to +sp rad
  j = 0;
  loop(grm ? 5 : 10,
    grm ? ( d = j == 0 ? 0 : j == 1 ? 3 : j == 2 ? 6 : j == 3 ? 10 : 20;  t = 1 - sqrt(d / 20); ) :
          ( d = j == 0 ? -20 : j == 1 ? -10 : j == 2 ? -7 : j == 3 ? -5 : j == 4 ? -3 : j == 5 ? -1 : j == 6 ? 0 : j == 7 ? 1 : j == 8 ? 2 : 3;
            lin = 10 ^ (d / 20);  t = (lin - 0.1) / (1.4125 - 0.1); );
    a = -sp + t * 2 * sp;
    col(!grm && d > 0 ? 0xC0302A : 0x1E1E1A, 1);
    gfx_line(px(cx + sin(a) * ti), py(cyp - cos(a) * ti), px(cx + sin(a) * to), py(cyp - cos(a) * to), 1);
    gfx_setfont(5);
    grm ? sprintf(#vl, "%d", d) : sprintf(#vl, d > 0 ? "+%d" : "%d", d);
    (grm || j == 0 || j == 1 || j == 3 || j == 6 || j == 9) ? text_c(px(cx + sin(a) * tl), py(cyp - cos(a) * tl), #vl);
    j += 1;
  );
  !grm ? ( col(0xC0302A, 1);  n = 0;                                   // the red arc above 0 VU
    loop(20, t = (1 + n / 20 * 0.4125 - 0.1) / 1.3125;  a = -sp + t * 2 * sp;  gfx_rect(px(cx + sin(a) * R) - 1, py(cyp - cos(a) * R) - 1, ps(2), ps(2), 1);  n += 1; ); );
  gfx_setfont(6);  col(0x1E1E1A, 1);  text_c(px(cx), py(y + h - 14), lbl);
  // the needle (spring ballistics, ~300 ms)
  grm ? t = 1 - sqrt(min(20, max(0, -val)) / 20) :
        ( lin = 10 ^ (max(-30, min(4, val)) / 20);  t = max(-0.04, min(1.04, (lin - 0.1) / 1.3125)); );
  VUS[slot * 2 + 1] += ((t - VUS[slot * 2]) * 0.24 - VUS[slot * 2 + 1] * 0.5);
  VUS[slot * 2] += VUS[slot * 2 + 1];
  a = -sp + max(-0.06, min(1.06, VUS[slot * 2])) * 2 * sp;
  gfx_x = 0;  col(0x111111, 1);
  xx = cx + sin(a) * nl;  yy = cyp - cos(a) * nl;
  n = (cyp - (y + h - 4)) / cos(a);                                   // the needle starts where it leaves the face's foot
  gfx_line(px(cx + sin(a) * n), py(cyp - cos(a) * n), px(xx), py(yy), 1);
  col(0x2A2F2B, 1);  u_rect(x, y + h - 4, w, 4);
);

PRESET_MENU = "Init|Vocal Warmth|Radio Voice|Spoken Word|Drum Bus|Snare Crack|Bass Weight|Acoustic Guitar|Piano Sheen|Hot Valve|Bus Glue|Brickwall";

// ---------- frame setup ----------
VUS = 4000;                                  // GUI memory: VU needles (pos, vel) x 2 (the audio tables sit at 0 - 40)
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;                          // S / M / L
sc = g_ret * max(min(g_want, min(gfx_w / (820 * g_ret), gfx_h / (668 * g_ret))), 0.5);
ox = (gfx_w - 820 * sc) * 0.5;
oy = (gfx_h - 668 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
kstep = 0;  kdim = 0;

gfx_setfont(1, "Georgia", ps(30), 'b');
gfx_setfont(10, "Trebuchet MS", ps(11), 'b');
gfx_setfont(2, "Trebuchet MS", ps(12), 'b');
gfx_setfont(3, "Verdana", ps(13), 'b');
gfx_setfont(4, "Georgia", ps(17), 'b');
gfx_setfont(5, "Trebuchet MS", ps(11), 'b');
gfx_setfont(6, "Trebuchet MS", ps(13), 'b');
gfx_setfont(8, "Courier New", ps(17), 'b');
gfx_setfont(9, "Verdana", ps(10), 'b');
gfx_setfont(11, "Trebuchet MS", ps(14.5), 'b');      // lamp-key legends (bigger than before: easier to read)

// ---------- the header bar and the frame ----------
col(C_FRAME, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(C_BAR, 1);  u_rect(0, 0, 820, 58);
col(C_BRASS, 1);  u_rect(0, 58, 820, 2);
gfx_setfont(1);  col(C_CREAM, 1);  text_l(px(20), py(24), "ELBE");
gfx_setfont(10);  col(0xC9C1A6, 1);  text_l(px(22), py(47), "VALVE BROADCAST CHANNEL");
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(240, 12, 34, 206, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > 12 ? 1 : pb_k; );
// the lunchbox: rails top and bottom with their slots, the corner rivets
col(0x2E3431, 1);  u_rect(8, 68, 804, 14);  u_rect(8, 644, 804, 14);
col(0x151917, 1);  g_j = 0;  loop(13, u_rect(24 + g_j * 61, 73, 34, 4);  u_rect(24 + g_j * 61, 649, 34, 4);  g_j += 1; );
rivet(14, 75);  rivet(806, 75);  rivet(14, 651);  rivet(806, 651);

// ---------- AMPLIFIER ----------  (content from y 150, keys on one line at 552 in every module)
g_x = 16;
module(g_x, 86, 176, 554, "AMPLIFIER");
k_scale(g_x + 88, 226, 42, 50, 62, 9, "-6|0|+6|+12|+18", 2);
kstep = 3;  chk(g_x + 88, 226, 34, 2, -6, 18, 0, K_RED, "GAIN", 1);
k_scale(g_x + 88, 392, 30, 37, 49, 3, "OFF|60|120", 1);
kstep = 1;  chk(g_x + 88, 392, 22, 3, 0, 2, 0, K_YEL, "BASS CUT", 10);
pre_in < 0.5 ? dim_module(g_x, 86, 176, 554);
lk_key(g_x + 20, 560, 64, 30, pre_ph >= 0.5, LK_YEL, "PHASE") ? ( slider(4) = pre_ph >= 0.5 ? 0 : 1;  param_touched(4); );
lk_key(g_x + 92, 560, 64, 30, pre_in >= 0.5, LK_AMB, "IN") ? ( slider(1) = pre_in >= 0.5 ? 0 : 1;  param_touched(1); );

// ---------- the two swappable modules (the ORDER key sets which comes first) ----------
g_xe = ord_disp ? 444 : 200;  g_xc = ord_disp ? 200 : 384;
// EQUALISER: three concentric knobs, FREQ on the ring, the boost / cut on the cap
module(g_xe, 86, 176, 554, "EQUALISER");
g_d = eq_in < 0.5;
kdim = g_d;  conc(g_xe + 88, 462, 28, 7, 5, 2, 6, -12, 12, 0, 2, B_LOW, "40|60|100|150|220", "LOW", 5, 1);
kdim = g_d;  conc(g_xe + 88, 334, 28, 9, 5, 1, 8, 0, 10, 0, 2, B_PRES, "1.4|2|2.8|4|5.6", "PRESENCE", 6, 1);
kdim = g_d;  conc(g_xe + 88, 206, 28, 11, 4, 1, 10, -12, 12, 0, 2, B_HIGH, "5|7|10|14", "HIGH", 7, 1);
g_d ? dim_module(g_xe, 86, 176, 554);
lk_key(g_xe + 56, 560, 64, 30, eq_in >= 0.5, LK_AMB, "IN") ? ( slider(5) = eq_in >= 0.5 ? 0 : 1;  param_touched(5); );
// COMPRESSOR: the GR meter, THRESHOLD and GAIN, ATTACK and RELEASE
module(g_xc, 86, 236, 554, "COMPRESSOR");
g_gr = gr_disp;  gr_disp = 0;
vu(g_xc + 48, 152, 140, 60, c_in >= 0.5 ? g_gr : 0, 1, "GR", 0);
g_d = c_in < 0.5;
k_scale(g_xc + 118, 284, 27, 33, 42, 9, "-20|-10|0|+10|+20", 2);
kdim = g_d;  chk(g_xc + 118, 284, 22, 13, -20, 20, 6, K_BLK, "THRESHOLD", 3);
k_scale(g_xc + 118, 392, 27, 33, 42, 5, "0|5|10|15|20", 1);
kdim = g_d;  chk(g_xc + 118, 392, 22, 17, 0, 20, 0, K_RED, "GAIN", 2);
g_j = 0;  loop(3,                                                        // ATTACK: three cream push-buttons
  cr_key(g_xc + 37 + g_j * 24, 490, 22, 24, floor(c_atk + 0.5) == g_j, g_j == 0 ? "F" : g_j == 1 ? "M" : "S") ? ( slider(15) = g_j;  param_touched(15); );
  g_j += 1; );
gfx_setfont(6);  col(C_INK, 1);  text_c(px(g_xc + 72), py(536), "ATTACK");
k_scale(g_xc + 164, 494, 23, 29, 39, 6, ".3|.6|1.2|2.5|5|A", 1);
kstep = 1;  kdim = g_d;  chk(g_xc + 164, 494, 16, 16, 0, 5, 2, K_BLK, "RELEASE", 9);
g_d ? dim_module(g_xc, 86, 236, 554);
lk_key(g_xc + 50, 560, 64, 30, c_mode >= 0.5, LK_YEL, c_mode >= 0.5 ? "LIMIT" : "COMP") ? ( slider(14) = c_mode >= 0.5 ? 0 : 1;  param_touched(14); );
lk_key(g_xc + 122, 560, 64, 30, c_in >= 0.5, LK_AMB, "IN") ? ( slider(12) = c_in >= 0.5 ? 0 : 1;  param_touched(12); );

// ---------- OUTPUT ----------
g_x = 628;
module(g_x, 86, 176, 554, "OUTPUT");
g_vu = vu_disp > 0 ? 10 * log10(vu_disp) + 18 : -60;  vu_disp = 0;
vu(g_x + 18, 152, 140, 76, g_vu, 0, "VU", 1);
// the CLIP lamp inside the meter's top-right corner
clip_disp ? ( clip_t = time_precise();  clip_disp = 0; );
g_on = time_precise() - clip_t < 0.4;
col(g_on ? 0xFF4A30 : 0x8A3A30, 1);  gfx_circle(px(g_x + 148), py(162), ps(3.5), 1, 1);
g_on ? ( col(0xFF4A30, 0.3);  gfx_circle(px(g_x + 148), py(162), ps(6), 1, 1); );
gfx_setfont(9);  col(0x1E1E1A, 1);  text_c(px(g_x + 128), py(162), "CLIP");
k_scale(g_x + 88, 284, 27, 33, 42, 9, "-18|-12|-6|0|+6", 2);
chk(g_x + 88, 284, 22, 19, -18, 6, 0, K_BLUE, "LEVEL", 2);
k_scale(g_x + 88, 396, 21, 27, 37, 5, "0|50|100", 2);
chk(g_x + 88, 396, 14, 20, 0, 100, 50, K_BLK, "DRIFT", 4);
// the HEATERS pilot lamp: dim while the valves warm, full once settled (always lit at DRIFT 0)
g_w = 1 - wu_disp;
col(0x2A1E10, 1);  gfx_circle(px(g_x + 88), py(472), ps(9), 1, 1);
col(0xFFB040, 0.25 + 0.75 * g_w);  gfx_circle(px(g_x + 88), py(472), ps(7), 1, 1);
col(0xFFE0A0, 0.5 * g_w);  gfx_circle(px(g_x + 86), py(470), ps(3), 1, 1);
col(0xFFB040, 0.22 * g_w);  gfx_circle(px(g_x + 88), py(472), ps(13), 1, 1);
gfx_setfont(6);  col(C_INK, 1);  text_c(px(g_x + 88), py(500), "HEATERS");
lk_key(g_x + 28, 560, 120, 30, 1, LK_YEL, order >= 0.5 ? "COMP > EQ" : "EQ > COMP") ? ( slider(18) = order >= 0.5 ? 0 : 1;  param_touched(18); );
gfx_setfont(9);  col(C_INK, 1);  text_c(px(g_x + 88), py(544), "ORDER");

// ---------- S / M / L / ? (size picker and credits): four 13 x 18 keys on a 14 pitch ----------
g_j = 0;
loop(4,
  g_x = 738 + g_j * 14;  g_on = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(0x020403, 1);  u_rect(g_x, 20, 13, 18);
  col(g_on ? C_LCDTX : 0x2E3A31, 1);  u_rect(g_x + 1, 21, 11, 16);
  gfx_setfont(5);  col(g_on ? C_LCDBG : 0xC9C1A6, 1);  text_c(px(g_x + 6.5), py(29), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(20) && mouse_y < py(38) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
sz_help && click && !sz_new ? sz_help = 0;
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
  gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
  g_cw = max(g_tw + ps(40), ps(380));  g_ch = ps(130);
  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(0xE0603A, 1);    gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(102);  gfx_drawstr("Click anywhere to close.");
);

// ---------- end of frame ----------
!lmb ? drag_idx = 0;
mouse_wheel = 0;
last_lmb = lmb;
