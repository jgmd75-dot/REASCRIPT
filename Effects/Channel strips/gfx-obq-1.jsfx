desc:OBQ-1 [channel strip] (GFX)
//tags: channel strip eq preamp transformer pan stereo spaced pair location mixer
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-ui, gfx-panel, gfx-os, gfx-bypass and gfx-drift (.jsfx-inc) in the same folder.
//
// OBQ-1 (named after the address of a famous 60s / 70s Soho studio: 17 St Anne's Court, W1F 0BQ).
// A location-mixer channel in the spirit of a 70s / 80s British portable field mixer (battery powered,
// transformer-balanced mic / line pre, a simple broadcast-style three-band EQ, A-B pan, a VU pair).
// LAB HYBRID (Oct 2026) - what the original never had:
//   SPACED PAIR PAN: A-PAN-B places the (mono) source the way a spaced pair of microphones hears it - the far side
//     hears it a little later as well as a little quieter - so the image has the width and depth of a spaced
//     pair. SPACING (0 - 60 cm) sets how far apart the pair is: 0 = an ordinary level pan. MONO-SAFE: the time
//     difference lives only in the side signal, so the mono sum is always exactly the plain level-panned channel
//     (no comb filtering when the mix is folded to mono).
//
// MONO IN = MONO OUT, STEREO IN = STEREO OUT (JG, 27 Oct 2026): A and B each run through their own circuit (the
//   rail, EQ and COMP linked). The centre of the sound is placed by PAN / SPACING as a spaced pair; a stereo
//   source's own width is kept, with PAN acting as a balance on it. A mono source comes out exactly as before.
// SIGNAL FLOW (per side)
//   input -> GAIN -> [oversampled: INPUT TRANSFORMER (the lows thicken first when pushed) -> PRE on a
//   12 V rail (clean and quick at normal levels, rounds and squeezes earlier than a studio desk when pushed) ->
//   HPF -> EQ -> LINE AMP (the same rail, 6 dB more headroom)] -> DC blocker -> COMP -> LEVEL -> PAN / SPACING ->
//   out A / B.
// GAIN -20 .. +30 dB. O.L. lights when the pre is within 3 dB of its rail.
// HPF: OFF / 90 Hz / 150 Hz, 12 dB/oct (glided; switching in / out crossfades 10 ms).
// EQ (broad, gentle broadcast-style curves; EQ key = the whole EQ in / out, crossfaded):
//   HF  +/-12 dB shelf at 10 kHz
//   MF  +/-10 dB broad bell at 2.8 kHz (presence)
//   LF  +/-12 dB shelf at 100 Hz
// PAN: A (left) - B (right), constant power, unity in the centre (+3 dB at a hard pan). SPACING 0 - 60 cm: up to 1.75 ms between the two sides at full pan;
//   the far side also comes up a little (a spaced pair has a smaller level difference than a coincident one).
// DRIFT (0 - 100 %, 50 % = standard) = BATTERY: the cells tire. The 12 V rail sits lower (about 1.5 dB at 50 %,
//   3 dB at 100 %), wanders slowly, and sags under loud programme (up to 2 dB at 50 %), so the pre runs out of
//   headroom sooner; the level wanders a hair. The V lamp flickers when the rail falls far enough. 0 % =
//   fresh cells: a steady rail.
// COMP (JG, 27 Oct 2026): an EQ-focused compressor for the voice. It watches the harsh middle of the voice
//   (800 Hz - 2 kHz) against the whole signal over a long 900 ms RMS window; when that band stands out it is
//   pulled down dynamically (a broad dip at 1.26 kHz, 3 : 1 on what stands more than 9 dB proud, up to 6 dB) and the lows and highs come up
//   gently (shelves at 220 Hz and 5 kHz) by enough to keep the overall loudness where it was - the voice's harshness
//   is tamed without the level dropping. The orange lamp by the key glows with the dip. Works after the EQ, at 1x.
//   DEPTH (0 - 100 %, 50 % = the standard above): scales the dip and the lift (100 % = up to 12 dB of dip).
// OS (1x / 2x / 4x, default 2x): the transformer, pre, HPF, EQ and line amp run at the chosen rate (gfx-os);
//   changing it dips the sound for 5 ms and swaps at the silent point.
// BYPASS (top bar): crossfades to the dry input, kept in time with the latency.
// Every knob glides (30 ms), every key crossfades (10 ms). Mix tool: no clip stage (the rail rounds the top).
// GUI: drag a knob (SHIFT = fine), wheel, double-click = default; values show while a knob is touched.
//   METERS: a VU pair (A / B, 0 VU = -18 dBFS), backlit, dimmed while bypassed.
// PRESETS: Init, Dialogue: Close Mic, Dialogue: Boom, Interview: A Side, Interview: B Side, Acoustic Guitar Pair,
//   Piano Wide, Vocal Warm Push, Drum Room Pair, Field Ambience, Tired Batteries (OS stays as it is).
// Latency: 0 / 31 / 37 samples at 1x / 2x / 4x (reported).
//
// STATUS: Lab v0.1 (deployed 28 Oct 2026).

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:gain_db=0<-20,30,0.1>-Gain (dB)
slider2:hpf_sel=0<0,2,1{Off,90 Hz,150 Hz}>-HPF
slider3:hf_db=0<-12,12,0.1>-HF (dB)
slider4:mf_db=0<-10,10,0.1>-MF (dB)
slider5:lf_db=0<-12,12,0.1>-LF (dB)
slider6:eq_in=1<0,1,1{Out,In}>-EQ
slider7:pan_pc=0<-100,100,1>-Pan (%)
slider8:space_cm=0<0,60,1>-Spacing (cm)
slider9:level_db=0<-40,10,0.1>-Level (dB)
slider10:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider11:drift_pc=50<0,100,1>-Drift (%)
slider12:byp=0<0,1,1{Off,On}>-Bypass
slider13:comp=0<0,1,1{Off,On}>-Voice comp
slider14:depth_pc=50<0,100,1>-Comp depth (%)
slider15:prs_sel=0<0,11,1{No preset,Init,Dialogue: Close Mic,Dialogue: Boom,Interview: A Side,Interview: B Side,Acoustic Guitar Pair,Piano Wide,Vocal Warm Push,Drum Room Pair,Field Ambience,Tired Batteries}>-Preset

import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc
import gfx-drift.jsfx-inc

@init
#ui_man = "gfx-obq-1";
ext_noinit = 1;

DL = 20000; DL_M = 4095;                     // the spaced pair's delay line (mono, after LEVEL)
CR = 16;                                     // control rate: coefficients every 16 samples

function db2g(d) ( exp(d * 0.11512925464970228); );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );
// soft saturation (rational tanh): unity slope at 0, flat beyond +/-3
function ts(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

// =====================================================================
// THE PRE: input transformer + a 12 V rail (all at the oversampled rate)
// =====================================================================
// TWEAK: R0 = the fresh rail (+2 dBFS = about +20 dBu); PB = asymmetry (a touch of 2nd); XK / XW = how hard the
// transformer's lows saturate / their weight; LINE_HR = the line amp's extra headroom.
R0 = 1.2589; PB = 0.015; XK = 1.5; XW = 1.03; LINE_HR = 2;
pb_d = (ts(PB + 0.0001) - ts(PB - 0.0001)) / 0.0002;     // the curve's small-signal slope (kept at unity)
pb_0 = ts(PB);
function rail(x, r) ( r * (ts(x / r + PB) - pb_0) / pb_d; );
// the input transformer: the lows (below ~150 Hz) saturate on their own, with a touch of weight
function xfmr(x, r) instance(lo) local(s) (
  lo += (x - lo) * xf_c;
  s = ts(lo * XK / r) * r / XK * XW;
  x + s - lo;
);

// =====================================================================
// FILTERS: zero-delay state-variable designs (C2E's), coefficients at the running rate (eq_fs)
//    bell:       H(s) = (s^2 + s A/Q + 1) / (s^2 + s/(A Q) + 1),  A = 10^(dB/40)
//    low shelf:  A (s^2 + s sqrtA/Q + A) / (A s^2 + s sqrtA/Q + 1)
//    high shelf: A (A s^2 + s sqrtA/Q + 1) / (s^2 + s sqrtA/Q + A)
// =====================================================================
function hp_c(fc) instance(a1, a2, a3) local(g, k) (
  g = tan($pi * min(fc, 0.45 * eq_fs) / eq_fs); k = 1.41421356;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function hp_t(x) instance(a1, a2, a3, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  x - 1.41421356 * v1 - v2;
);
// kind: 0 bell, 1 low shelf, 2 high shelf
function eq_c(kind, fc, db, q) instance(a1, a2, a3, m0, m1, m2, k) local(a, g) (
  a = 10 ^ (db / 40);
  g = tan($pi * min(fc, 0.45 * eq_fs) / eq_fs);
  kind == 0 ? ( k = 1 / (q * a); m0 = 1; m1 = k * (a * a - 1); m2 = 0; ) :
  kind == 1 ? ( g /= sqrt(a); k = 1 / q; m0 = 1; m1 = k * (a - 1); m2 = a * a - 1; ) :
              ( g *= sqrt(a); k = 1 / q; m0 = a * a; m1 = k * (1 - a) * a; m2 = 1 - a * a; );
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function eq_t(x) instance(a1, a2, a3, m0, m1, m2, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  m0 * x + m1 * v1 + m2 * v2;
);
// TWEAK: the fixed frequencies and the broad, gentle Qs of a broadcast-style EQ
HF_F = 10000; MF_F = 2800; LF_F = 100; SHELF_Q = 0.55; MF_Q = 0.7;

// one oversampled sample through the channel (mono)
function chan(x) local(y, h) (
  y = XF.xfmr(x, r_s);
  y = rail(y, r_s);
  ol_v = max(ol_v, abs(y) / r_s);
  h = HP.hp_t(y); y += (h - y) * hp_s;
  h = HFQ.eq_t(MFQ.eq_t(LFQ.eq_t(y))); y += (h - y) * eq_s;
  rail(y, r_s * LINE_HR);
);
// the B channel: the same circuit with its own filter memories (coefficients copied from A in chan_coefs)
function chan_b(x) local(y, h) (
  y = XFB.xfmr(x, r_s);
  y = rail(y, r_s);
  ol_v = max(ol_v, abs(y) / r_s);
  h = HPB.hp_t(y); y += (h - y) * hp_s;
  h = HFB.eq_t(MFB.eq_t(LFB.eq_t(y))); y += (h - y) * eq_s;
  rail(y, r_s * LINE_HR);
);
function chan_clear() (
  XF.lo = 0; HP.ic1 = HP.ic2 = 0; LFQ.ic1 = LFQ.ic2 = MFQ.ic1 = MFQ.ic2 = HFQ.ic1 = HFQ.ic2 = 0;
  XFB.lo = 0; HPB.ic1 = HPB.ic2 = 0; LFB.ic1 = LFB.ic2 = MFB.ic1 = MFB.ic2 = HFB.ic1 = HFB.ic2 = 0;
);
function chan_coefs() (
  eq_fs = srate * os_f;
  xf_c = 1 - exp(-2 * $pi * 150 / eq_fs);
  HP.hp_c(exp(hpf_s));
  LFQ.eq_c(1, LF_F, lf_s, SHELF_Q); MFQ.eq_c(0, MF_F, mf_s, MF_Q); HFQ.eq_c(2, HF_F, hf_s, SHELF_Q);
  HPB.a1 = HP.a1; HPB.a2 = HP.a2; HPB.a3 = HP.a3;
  LFB.a1 = LFQ.a1; LFB.a2 = LFQ.a2; LFB.a3 = LFQ.a3; LFB.m0 = LFQ.m0; LFB.m1 = LFQ.m1; LFB.m2 = LFQ.m2;
  MFB.a1 = MFQ.a1; MFB.a2 = MFQ.a2; MFB.a3 = MFQ.a3; MFB.m0 = MFQ.m0; MFB.m1 = MFQ.m1; MFB.m2 = MFQ.m2;
  HFB.a1 = HFQ.a1; HFB.a2 = HFQ.a2; HFB.a3 = HFQ.a3; HFB.m0 = HFQ.m0; HFB.m1 = HFQ.m1; HFB.m2 = HFQ.m2;
);

// =====================================================================
// COMP (JG): the voice's middle against the whole signal, each over a 900 ms RMS window (the windows are running
// sums of the squared signal, kept per control tick in a ring at CPR), at the base rate after the EQ
// =====================================================================
// TWEAK: CP_F / CP_Q = the band watched and dipped (Q 1.05: -3 dB at about 800 Hz and 2 kHz); CP_OFS = how far
// below the whole signal the band may sit before the dip starts; CP_RAT = ratio on the excess; CP_MAX = the deepest
// dip; CP_LO / CP_HI = the lift shelves; CP_LIFT = their lift per dB of dip (keeps the loudness level).
CP_F = 1265; CP_Q = 1.05; CP_DQ = 0.8; CP_OFS = 9; CP_RAT = 3; CP_MAX = 6; CP_LO = 220; CP_HI = 5000; CP_LIFT = 0.6;
CPR = 30000;                                 // 2 x up to 10800 entries (900 ms at 192 kHz / CR)
function bp_c(fc, q) instance(a1, a2, a3, k) local(g) (
  g = tan($pi * min(fc, 0.45 * srate) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function bp_t(x) instance(a1, a2, a3, k, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  k * v1;                                    // band-pass, unity at the centre
);
function cp_clear() (
  memset(CPR, 0, 2 * 10800); cp_w = 0; cp_sb = cp_sf = 0; cp_eb = cp_ef = 0;
  CPB.ic1 = CPB.ic2 = CPD.ic1 = CPD.ic2 = CPL.ic1 = CPL.ic2 = CPH.ic1 = CPH.ic2 = 0;
  CDB.ic1 = CDB.ic2 = CLB.ic1 = CLB.ic2 = CHB.ic1 = CHB.ic2 = 0;
);
// one control tick: the windows move on, the dip and lift are worked out and glided, the filters rebuilt
function cp_tick() local(ob, of, bd, fd, ex, cut) (
  ob = CPR[cp_w]; of = CPR[10800 + cp_w];
  CPR[cp_w] = cp_eb; CPR[10800 + cp_w] = cp_ef;
  cp_sb = max(cp_sb + cp_eb - ob, 0); cp_sf = max(cp_sf + cp_ef - of, 0);
  cp_eb = cp_ef = 0; cp_w += 1; cp_w >= cp_n ? cp_w = 0;
  cp_s += (comp - cp_s) * c_ct;
  cut = 0;
  cp_sf > 0.000000001 * cp_n * CR ? (                  // below about -90 dBFS: nothing to judge
    bd = 10 * log10(max(cp_sb, 0.0000000000001)); fd = 10 * log10(cp_sf);
    ex = bd - fd + CP_OFS;
    cut = min(max(ex, 0) * (1 - 1 / CP_RAT), CP_MAX) * depth_pc / 50;
  ) : cut = cp_g / max(cp_s, 0.001);                     // silence: hold
  cp_g += (cut * cp_s - cp_g) * c_ct;
  cp_disp = cp_g;
  eq_fs = srate;
  CPD.eq_c(0, CP_F, -cp_g, CP_DQ); CPL.eq_c(1, CP_LO, cp_g * CP_LIFT, SHELF_Q); CPH.eq_c(2, CP_HI, cp_g * CP_LIFT, SHELF_Q);
  CDB.a1 = CPD.a1; CDB.a2 = CPD.a2; CDB.a3 = CPD.a3; CDB.m0 = CPD.m0; CDB.m1 = CPD.m1; CDB.m2 = CPD.m2;
  CLB.a1 = CPL.a1; CLB.a2 = CPL.a2; CLB.a3 = CPL.a3; CLB.m0 = CPL.m0; CLB.m1 = CPL.m1; CLB.m2 = CPL.m2;
  CHB.a1 = CPH.a1; CHB.a2 = CPH.a2; CHB.a3 = CPH.a3; CHB.m0 = CPH.m0; CHB.m1 = CPH.m1; CHB.m2 = CPH.m2;
);

// ---------- parameters from the sliders (run from @slider and every @block: panel moves don't run @slider) ----------
function fd_params() (
  g_t = db2g(gain_db); lv_t = db2g(level_db);
  hpf_sel >= 0.5 ? hpf_t = log(hpf_sel >= 1.5 ? 150 : 90);
  hpo_t = hpf_sel >= 0.5;
  os_tf = os_f2n(os_sl);
  drift_macro(drift_pc);
);

function set_rate() (
  c_kn = coef(0.03); c_sw = coef(0.01); c_ct = 1 - exp(-CR / (0.03 * srate));
  c_vu = coef(0.3); dc_c = 1 - 2 * $pi * 5 / srate;
  c_sga = coef(0.02); c_sgr = coef(0.4);
  cp_n = min(floor(0.9 * srate / CR + 0.5), 10800);
  CPB.bp_c(CP_F, CP_Q);
);

fd_params();
set_rate();
os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
os_gsetup();
hpf_t = hpf_sel >= 1.5 ? log(150) : log(90); hpf_s = hpf_t; hp_s = hpo_t;
hf_s = hf_db; mf_s = mf_db; lf_s = lf_db; eq_s = eq_in;
g_s = g_t; lv_s = lv_t; r_s = R0; r_t = R0;
pan_s = pan_pc; sp_s = space_cm; tau_s = 0; cp_s = comp;
chan_coefs(); chan_clear();
cp_g = 0; cp_clear(); cp_tick();
memset(DL, 0, DL_M + 1); dw = 0;
RW.drift_init(0.8 + rand(1) * 0.4); LW.drift_init(0.8 + rand(1) * 0.4);
rs_f = 1; rs_c = 1 / (0.015 * srate);
by_setup(12);

// ---------- presets (OS and BYPASS stay as they are) ----------
#fd_pmn = "Init|Dialogue: Close Mic|Dialogue: Boom|Interview: A Side|Interview: B Side|Acoustic Guitar Pair|Piano Wide|Vocal Warm Push|Drum Room Pair|Field Ambience|Tired Batteries";
function fd_set(g, h, hf, mf, lf, pn, spc, lv, dft, cmp) (
  gain_db = g; hpf_sel = h; hf_db = hf; mf_db = mf; lf_db = lf; eq_in = 1; pan_pc = pn; space_cm = spc;
  level_db = lv; drift_pc = dft; comp = cmp; depth_pc = 50;
);
function load_preset(p) local(i) (
  //            GAIN HPF  HF   MF   LF  PAN  SPACE LEVEL DRIFT COMP
  p == 2  ? fd_set(0,   1,   1,   2,  -2,   0,   0,    0,  50,    1) :
  p == 3  ? fd_set(4,   2,   2,   3,  -3,   0,   0,   -4,  50,    1) :
  p == 4  ? fd_set(0,   1,   1,   2,  -2, -45,  25,    0,  50,    1) :
  p == 5  ? fd_set(0,   1,   1,   2,  -2,  45,  25,    0,  50,    1) :
  p == 6  ? fd_set(0,   1,   3,  -1,  -2, -35,  40,    0,  50,    0) :
  p == 7  ? fd_set(0,   0,   2,   0,   1,  30,  60,    0,  50,    0) :
  p == 8  ? fd_set(12,  1,   2,   1,   2,   0,   0,  -10,  50,    1) :
  p == 9  ? fd_set(6,   0,   4,  -2,   3, -70,  60,   -5,  50,    0) :
  p == 10 ? fd_set(0,   1,   3,   0,  -1,  20,  60,    0,  50,    0) :
  p == 11 ? fd_set(10,  0,   0,   0,   0,   0,   0,   -8, 100,    0) :
            fd_set(0,   0,   0,   0,   0,   0,   0,    0,   50,    0);
  i = 1; loop(9, ui_auto(i); i += 1; ); ui_auto(11); ui_auto(13); ui_auto(14);
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;                           // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );           // new instances open in Medium, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@slider
prs_chk();
fd_params();

@block
prs_chk();
fd_params();
// resume after REAPER's bypass (or any gap): the buffers hold stale audio, so @sample clears them and fades in
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? rs_req = 1;
rs_last = rs_now;
// BATTERY drift: the rail sits lower as the cells tire, wanders, and sags under load (sg_env, from @sample)
bdt = samplesblock / srate;
d_rw = RW.drift_tick(0.07 * dm_s * bdt); d_lw = LW.drift_tick(0.11 * dm_s * bdt);
bat_db = dm_a * (1.5 + 0.4 * d_rw) + 2 * dm_a * min(sg_env, 1);
r_t = R0 * db2g(-bat_db);
lw_g = db2g(0.1 * dm_a * d_lw);
lo_disp = bat_db;

@sample
by_in();
rs_req ? (
  rs_req = 0; rs_f = 0;
  OSU.os_clr(); OSD.os_clr(); OSUB.os_clr(); OSDB.os_clr(); chan_clear(); memset(DL, 0, DL_M + 1);
  dcx = dcy = dcxb = dcyb = 0;
  CPD.ic1 = CPD.ic2 = CPL.ic1 = CPL.ic2 = CPH.ic1 = CPH.ic2 = CPB.ic1 = CPB.ic2 = 0;
  CDB.ic1 = CDB.ic2 = CLB.ic1 = CLB.ic2 = CHB.ic1 = CHB.ic2 = 0;
);
// ---------- control rate: glide the EQ / filter / rail, rebuild coefficients ----------
cr_n <= 0 ? (
  cr_n = CR;
  hf_s += (hf_db - hf_s) * c_ct; mf_s += (mf_db - mf_s) * c_ct; lf_s += (lf_db - lf_s) * c_ct;
  hpf_s += (hpf_t - hpf_s) * c_ct;
  r_s += (r_t - r_s) * c_ct;
  cp_tick();
  chan_coefs();
  // the pan: constant-power gains, the spaced pair's level blend, and how much of the side signal is timed
  pn_t = (pan_s * 0.01 + 1) * 0.25 * $pi; p_gl = cos(pn_t) * 1.41421356; p_gr = sin(pn_t) * 1.41421356;   // unity in the centre
  sp_u = sp_s / 60;
  p_b = 0.4 * min(sp_s / 30, 1); p_a = 0.6 * min(sp_s / 20, 1);
  p_gl2 = p_gl + (1 - p_gl) * p_b; p_gr2 = p_gr + (1 - p_gr) * p_b;
  tau_t = sp_s / 34300 * sin(pan_s * 0.005 * $pi) * srate;   // samples; > 0 = towards B, so A is the far side
);
cr_n -= 1;
// ---------- per-sample glides ----------
g_s += (g_t - g_s) * c_kn; lv_s += (lv_t - lv_s) * c_kn;
hp_s += (hpo_t - hp_s) * c_sw; eq_s += (eq_in - eq_s) * c_sw;
pan_s += (pan_pc - pan_s) * c_kn; sp_s += (space_cm - sp_s) * c_kn;
tau_s += (tau_t - tau_s) * c_kn;

// ---------- the channel ----------
// A and B each through their own circuit (a mono source = both the same, so it stays mono)
x = spl0 * g_s; xb = spl1 * g_s;
sg_x = max(abs(x), abs(xb)) / R0;
sg_env += (min(sg_x, 2) - sg_env) * (sg_x > sg_env ? c_sga : c_sgr);
os_gate();
os_chg ? ( chan_coefs(); chan_clear(); os_hold += 2 * samplesblock; );
OSU.os_up(x); OSUB.os_up(xb);
os_f == 1 ? ( y = chan(OSU.s0); yb = chan_b(OSUB.s0); ) :
os_f == 2 ? (
  a0 = chan(OSU.s0); a1 = chan(OSU.s1); y = OSD.os_dn(a0, a1, 0, 0);
  a0 = chan_b(OSUB.s0); a1 = chan_b(OSUB.s1); yb = OSDB.os_dn(a0, a1, 0, 0);
) : (
  a0 = chan(OSU.s0); a1 = chan(OSU.s1); a2 = chan(OSU.s2); a3 = chan(OSU.s3); y = OSD.os_dn(a0, a1, a2, a3);
  a0 = chan_b(OSUB.s0); a1 = chan_b(OSUB.s1); a2 = chan_b(OSUB.s2); a3 = chan_b(OSUB.s3); yb = OSDB.os_dn(a0, a1, a2, a3);
);
// DC blocker (the pre's asymmetry), then LEVEL and the supply's level wander
dcy = y - dcx + dc_c * dcy; dcx = y; y = dcy;
dcyb = yb - dcxb + dc_c * dcyb; dcxb = yb; yb = dcyb;
// COMP (linked): the detector hears the sum after the EQ; the dip and the lift (0 dB = untouched) always run
cp_m = (y + yb) * 0.5; cp_v = CPB.bp_t(cp_m); cp_eb += cp_v * cp_v; cp_ef += cp_m * cp_m;
y = CPH.eq_t(CPL.eq_t(CPD.eq_t(y))); yb = CHB.eq_t(CLB.eq_t(CDB.eq_t(yb)));
// the centre (A + B) goes through the spaced pair; a stereo source's own width (A - B) is kept, balanced by PAN
m = (y + yb) * 0.5 * lv_s * lw_g; sd = (y - yb) * 0.5 * lv_s * lw_g;
ol_disp = max(ol_disp, ol_v); ol_v = 0;

// ---------- PAN + SPACED PAIR (mono-safe: the time difference lives only in the side signal) ----------
DL[dw] = m;
td = max(tau_s, 0); ti = floor(td); tf = td - ti;
mA = DL[(dw - ti) & DL_M] * (1 - tf) + DL[(dw - ti - 1) & DL_M] * tf;
td = max(-tau_s, 0); ti = floor(td); tf = td - ti;
mB = DL[(dw - ti) & DL_M] * (1 - tf) + DL[(dw - ti - 1) & DL_M] * tf;
dw = (dw + 1) & DL_M;
mm = 0.5 * (p_gl + p_gr) * m;
sl = 0.5 * (p_gl - p_gr) * m;
ss = sl + p_a * (0.5 * (p_gl2 * mA - p_gr2 * mB) - sl);
oa = mm + ss + sd * p_gl; ob = mm - ss - sd * p_gr;

oa *= os_g * os_g * (3 - 2 * os_g); ob *= os_g * os_g * (3 - 2 * os_g);   // the OS swap's dip (an S-curve)
// the resume fade: from the dry input (delayed by the latency, from the bypass line) into the processed sound
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_q = rs_f * rs_f * (3 - 2 * rs_f);
  pdc_delay > 0 ? ( rs_dl = BY_BUF[(by_w - pdc_delay) & (BY_N - 1)]; rs_dr = BY_BUF[BY_N + ((by_w - pdc_delay) & (BY_N - 1))]; )
                : ( rs_dl = spl0; rs_dr = spl1; );
  oa = rs_dl + (oa - rs_dl) * rs_q; ob = rs_dr + (ob - rs_dr) * rs_q;
);
spl0 = oa; spl1 = ob;
by_out();
// the VU pair (mean square, 300 ms)
vu_a_disp += (spl0 * spl0 - vu_a_disp) * c_vu; vu_b_disp += (spl1 * spl1 - vu_b_disp) * c_vu;

@gfx 1080 420
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1080, 420);
// =====================================================================
// GUI (design space 1080 x 420; S / M / L = 85 / 100 / 130 %). The original's light alloy plate with black print
// and red legends, black-skirted knobs with flat coloured caps (GAIN red, HF green, MF grey, LF blue, PAN yellow),
// thin printed outlines round each group, and a VU pair in heavy black bezels. A charcoal top bar carries the
// presets, BYPASS, OS and the size picker.
// =====================================================================
// amber (JG, 27 Oct 2026): a deep amber-brown backplate, bright amber front panels raised on it, dark print
BG = 0x1E150B; HDR = 0x241A10; BP = 0x5A3C17; FP = 0xD9A24A; FP_LT = 0xF2C878; FP_DK = 0x3A2509;
PL = FP; INK = 0x1E1608; RED = 0x9E2A1E; DIM = 0x4E3615; LINE = 0x2A1A08;
C_RED = 0xD23A2E; C_GRN = 0x2F5F4A; C_GRY = 0xD9D9D6; C_BLU = 0x2E6FAE; C_YEL = 0xF2CF2E; C_CRM = 0xEDE6D2;
sc != fd_lsc ? (
  fd_lsc = sc;
  fd_f2 = ui_fitfont(2, 16 * sc);                    // knob labels / values (JG: about 16 design px)
  gfx_setfont(10, "Trebuchet MS", 30 * sc, 'b');     // the unit's name
  gfx_setfont(11, "Trebuchet MS", 18 * sc, 'b');     // section titles
  gfx_setfont(13, "Trebuchet MS", 13 * sc, 'b');     // small print
  gfx_setfont(14, "Trebuchet MS", 14.5 * sc, 'b');   // key legends
);
gfx_setfont(2, "Trebuchet MS", fd_f2, 'b'); gfx_setfont(3, "Trebuchet MS", fd_f2, 'b');
C_INK = INK; lk_font = 14; lk_font2 = 14; lk_well = 0x111214; ck_font = 14;

function fd_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function fd_rr(x, y, w, h, r) ( ui_rrs(x * sc, y * sc, w * sc, h * sc, r * sc); );
function fd_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function fd_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function fd_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// soft drop shadow, light from the top left: 4 layers, (+2, +3) to (+6, +8)
function fd_shadow(x, y, w, h, r) local(j) (
  j = 0; loop(4, ui_cola(0x000000, 0.13); fd_rr(x + 2 + j * 1.3, y + 3 + j * 1.7, w + j * 0.4, h + j * 0.4, r + j); j += 1; );
);
// a front panel: bright amber, raised on the backplate (soft shadow, a light top / left edge, a dark bottom / right
// edge, each drawn once), a small rivet in each corner
function fd_box(x, y, w, h) (
  fd_shadow(x, y, w, h, 6);
  ui_col(FP_DK); fd_rr(x, y, w, h, 6);
  ui_col(FP_LT); fd_rr(x, y, w - 1.5, h - 1.5, 6);
  ui_col(FP); fd_rr(x + 1.5, y + 1.5, w - 3.5, h - 3.5, 5);
  gfx_gradrect((x + 3) * sc, (y + 3) * sc, (w - 6) * sc, h * 0.35 * sc, 1, 1, 1, 0.10, 0, 0, 0, 0, 0, 0, 0, -0.10 / (h * 0.35 * sc));
  ui_screw((x + 10) * sc, (y + 10) * sc); ui_screw((x + w - 10) * sc, (y + 10) * sc);
  ui_screw((x + 10) * sc, (y + h - 10) * sc); ui_screw((x + w - 10) * sc, (y + h - 10) * sc);
);
// a section title, printed on the plate (small caps look: bold, dark ink)
function fd_title(x, y, s) ( gfx_setfont(11); ui_col(INK); fd_tl(x, y, s); );

// The original's knob: a black fluted skirt, a flat coloured cap with one soft highlight and a light vignette edge,
// a pointer line across cap and skirt (supersampled), scale dots round it. Drag 200 px (SHIFT = fine, 1000 px),
// 3 px dead zone, wheel 3 % (SHIFT 0.5 %), double-click = default. The label below shows the value while touched.
function fd_kn(cx, cy, r, idx, lo, hi, def, cap, pc, lbl, fmt, nd) local(kx, ky, kr, v, n, a, hov, act, i, t, rc) (
  kx = cx * sc; ky = cy * sc; kr = r * sc;
  v = slider(idx); n = (v - lo) / (hi - lo);
  hov = sqr(mouse_x - kx) + sqr(mouse_y - ky) <= sqr(kr + 6 * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - lastclick_t < 0.35 && lastclick_id == idx ? (
      slider(idx) = def; ui_auto(idx); drag_id = -1; lastclick_t = 0;
    ) : (
      drag_id = idx; drag_y = mouse_y; drag_y0 = mouse_y; drag_moved = 0; drag_n = n;
      lastclick_t = time_precise(); lastclick_id = idx;
    );
  );
  drag_id == idx && !drag_moved && abs(mouse_y - drag_y0) > 3 * sc ? ( drag_moved = 1; drag_y = mouse_y; );
  drag_id == idx && drag_moved ? (
    drag_n = min(max(drag_n + (drag_y - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1); drag_y = mouse_y;
    v = lo + drag_n * (hi - lo); fd_step > 0 ? v = floor(v / fd_step + 0.5) * fd_step;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    v = lo + n * (hi - lo); fd_step > 0 ? v = floor(v / fd_step + 0.5) * fd_step;
    slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
  );
  fd_step = 0;
  v = slider(idx); n = (v - lo) / (hi - lo); a = -0.75 * $pi + n * 1.5 * $pi;
  act = hov || drag_id == idx;
  // scale dots
  ui_cola(INK, 0.8); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(kx + sin(t) * (kr + 8 * sc), ky - cos(t) * (kr + 8 * sc), (i == 0 || i == nd || i * 2 == nd ? 1.6 : 1.2) * sc, 1, 1); i += 1; );
  // drop shadow (4 soft layers)
  i = 0; loop(4, ui_cola(0x000000, 0.13); gfx_circle(kx + (2 + i * 1.3) * sc, ky + (3 + i * 1.7) * sc, kr + i * 0.4 * sc, 1, 1); i += 1; );
  // the black fluted skirt
  ui_col(0x141416); gfx_circle(kx, ky, kr, 1, 1);
  ui_col(0x2A2B2E); gfx_circle(kx - 0.6 * sc, ky - 0.6 * sc, kr - 1.2 * sc, 1, 1);
  ui_col(0x1B1C1E); gfx_circle(kx, ky, kr - 2.4 * sc, 1, 1);
  ui_cola(0x000000, 0.5); i = 0;
  loop(24, t = i / 24 * 2 * $pi; gfx_line(kx + sin(t) * (kr - 1.5 * sc), ky - cos(t) * (kr - 1.5 * sc), kx + sin(t) * (kr * 0.8), ky - cos(t) * (kr * 0.8), 1); i += 1; );
  // the flat coloured cap, a light vignette towards its rim (more on the bottom right), one soft highlight
  rc = kr * 0.7;
  ui_col(cap); gfx_circle(kx, ky, rc, 1, 1);
  ui_cola(0x000000, 0.10); gfx_circle(kx, ky, rc, 0, 1); gfx_circle(kx, ky, rc - 1 * sc, 0, 1);
  ui_cola(0x000000, 0.08); gfx_arc(kx, ky, rc - 2 * sc, 0.25 * $pi, 1.25 * $pi, 1); gfx_arc(kx, ky, rc - 3 * sc, 0.35 * $pi, 1.15 * $pi, 1);
  ui_cola(0xFFFFFF, act ? 0.40 : 0.28); ui_ssarc(kx, ky, rc * 0.82, -1.75, -0.25, 1.2 * sc);
  // pointer
  ui_col(pc); ui_ssline(kx + sin(a) * rc * 0.15, ky - cos(a) * rc * 0.15, kx + sin(a) * kr * 0.97, ky - cos(a) * kr * 0.97, (r > 24 ? 3.2 : 2.6) * sc, 1);
  // label / value
  gfx_setfont(2); ui_col(INK);
  act ? sprintf(#fd_kv, fmt, v) : strcpy(#fd_kv, lbl);
  fd_tc(cx, cy + r + 13, #fd_kv);
);
// end labels printed beside a dial (at the two ends of its travel)
function fd_ends(cx, cy, r, s0, s1) local(tw, th, a) (
  gfx_setfont(13); ui_col(DIM);
  a = -0.75 * $pi; gfx_measurestr(s0, tw, th); gfx_x = (cx + sin(a) * (r + 14)) * sc - tw; gfx_y = (cy - cos(a) * (r + 14)) * sc - th * 0.3; gfx_drawstr(s0);
  a = 0.75 * $pi; gfx_x = (cx + sin(a) * (r + 14)) * sc; gfx_y = (cy - cos(a) * (r + 14)) * sc - th * 0.3; gfx_drawstr(s1);
);
// a small "0" at the top of a centre-zero dial
function fd_zero(cx, cy, r) ( gfx_setfont(13); ui_col(DIM); fd_tc(cx, cy - r - 27, "0"); );
// a round lamp (O.L., V): 5 px LED in a black ring, lit with a small highlight and a halo; v = 0..1
function fd_led(cx, cy, v, c) (
  ui_col(0x0A0A0B); gfx_circle(cx * sc, cy * sc, 7.5 * sc, 1, 1);
  ui_col(ui_mix(c, 0x000000, 0.72)); gfx_circle(cx * sc, cy * sc, 5.5 * sc, 1, 1);
  v > 0.01 ? (
    ui_cola(c, 0.25 * v); gfx_circle(cx * sc, cy * sc, 12 * sc, 1, 1);
    ui_cola(c, v); gfx_circle(cx * sc, cy * sc, 5.5 * sc, 1, 1);
    ui_cola(0xFFFFFF, 0.6 * v); gfx_circle((cx - 1.6) * sc, (cy - 1.6) * sc, 1.6 * sc, 1, 1);
  );
);
// a lamp key from its slider: lit = on; the click toggles
function fd_key(x, y, w, h, idx, c, s) (
  lk_key(x, y, w, h, slider(idx) >= 0.5, c, s) ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
);

// ---------- hand-offs from the audio thread ----------
fd_now = time_precise();
ol_disp > 0.708 ? fd_olt = fd_now; ol_disp = 0;            // O.L.: within 3 dB of the rail, held 0.3 s
fd_ol = fd_now - fd_olt < 0.3 ? 1 : 0;
fd_cp = cp_disp;
fd_lv = min(max((lo_disp - 2.4) / 0.6, 0), 1);             // V: the rail more than about 2.5 dB down

// ---------- faceplate and header ----------
ui_col(BG); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(HDR); fd_r(0, 0, 1080, 64);
ui_col(FP); fd_r(0, 63, 1080, 2); ui_col(0x101113); fd_r(0, 65, 1080, 1);
ui_cola(0x000000, 0.22); fd_r(1077, 66, 3, 354); fd_r(0, 417, 1080, 3);           // a narrow darker right / bottom edge
ui_screw(9 * sc, 9 * sc); ui_screw((1080 - 9) * sc, 9 * sc); ui_screw(9 * sc, (420 - 9) * sc); ui_screw((1080 - 9) * sc, (420 - 9) * sc);
ui_col(C_CRM); gfx_circle(40 * sc, 32 * sc, 16 * sc, 1, 1);
gfx_setfont(13); ui_col(HDR); ui_keytext(40 * sc, 32 * sc, "GFX");
gfx_setfont(10); ui_col(C_CRM); fd_tl(68, 15, "OBQ-1"); gfx_measurestr("OBQ-1", fd_tw, fd_th);
gfx_setfont(13); ui_col(FP_LT); fd_tl(82 + fd_tw / sc, 20, "LOCATION"); ver_tag_at("v3", 16, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1); fd_tl(82 + fd_tw / sc, 34, "CHANNEL");
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
fd_k = pk_preset(340 * sc, 15 * sc, 290 * sc, 34 * sc, pr_cur, #fd_pmn);
fd_k > 0 ? prs_dirty = fd_k;
os_key(960, 21, 10, C_CRM, 12);
by_keywh(830, 19, 84, 28, 12, 16);                    // BYPASS: the house keycap
ui_size_picker(998 * sc, 23 * sc);

// ---------- the plate ----------
fd_shadow(16, 80, 1048, 324, 6);
ui_col(0x140E06); fd_rr(16, 80, 1048, 324, 6);
ui_col(0x7A5622); fd_rr(16, 80, 1047, 323, 6);
ui_col(BP); fd_rr(17, 81, 1045.5, 321.5, 5);

// INPUT: GAIN in its red-ruled box, O.L. below
fd_box(28, 88, 156, 308); fd_title(48, 102, "INPUT");
fd_kn(106, 204, 32, 1, -20, 30, 0, C_RED, 0xF6F6F4, "GAIN", "%+.1f dB", 10);
gfx_setfont(13); fd_ends(106, 204, 32, "-20", "+30");
fd_led(86, 330, fd_ol, 0xFF3A2A); gfx_setfont(13); ui_col(INK); fd_tl(100, 322, "O.L.");

// HPF: three cream selector keys
fd_box(194, 88, 96, 308); fd_title(208, 102, "H.P.F.");
fd_i = 0;
loop(3,
  ck_key(206, 144 + fd_i * 56, 72, 38, hpf_sel == fd_i, fd_i == 0 ? "OFF" : fd_i == 1 ? "90 Hz" : "150 Hz") ? ( hpf_sel = fd_i; ui_auto(2); );
  fd_i += 1;
);

// EQ: LF blue, MF grey, HF green (JG: low to high, left to right); the EQ key in / out
fd_box(300, 88, 336, 308); fd_title(320, 102, "EQUALISER");
fd_kn(574, 204, 27, 3, -12, 12, 0, C_GRN, 0xF6F6F4, "HF", "%+.1f dB", 8);
fd_kn(468, 204, 27, 4, -10, 10, 0, C_GRY, 0x1C1C1E, "MF", "%+.1f dB", 8);
fd_kn(362, 204, 27, 5, -12, 12, 0, C_BLU, 0xF6F6F4, "LF", "%+.1f dB", 8);
fd_zero(362, 204, 27); fd_zero(468, 204, 27); fd_zero(574, 204, 27);
gfx_setfont(13); ui_col(DIM); fd_tc(362, 270, "100 Hz"); fd_tc(468, 270, "2.8 kHz"); fd_tc(574, 270, "10 kHz");
!eq_in ? ( ui_cola(FP, 0.5); fd_r(316, 140, 304, 150); );
fd_key(544, 98, 76, 30, 6, LK_AMB, "EQ IN");             // JG: top right of the EQ section
// COMP (JG: at the foot of the EQ section) with its lamp, and DEPTH (LEVEL's style); DEPTH greyed while COMP is off
fd_key(340, 313, 86, 34, 13, LK_ORA, "COMP");
fd_led(450, 330, comp ? min(fd_cp / 4, 1) : 0, 0xFF9A2A);
fd_kn(540, 330, 22, 14, 0, 100, 50, 0x2B2B2E, 0xF6F6F4, "DEPTH", "%.0f %%", 10);
!comp ? ( ui_cola(FP, 0.5); fd_r(504, 298, 72, 84); );

// OUTPUT: PAN (yellow) and SPACING - the spaced pair; LEVEL; DRIFT (battery) with its V lamp
fd_box(646, 88, 214, 308); fd_title(664, 102, "OUTPUT");
fd_kn(700, 204, 28, 7, -100, 100, 0, C_YEL, 0x1C1C1E, "PAN", "%+.0f %%", 10);
fd_ends(700, 204, 28, "A", "B"); fd_zero(700, 204, 28);
fd_kn(806, 204, 24, 8, 0, 60, 0, C_CRM, 0x1C1C1E, "SPACING", "%.0f cm", 6);
fd_ends(806, 204, 24, "0", "60");
fd_kn(700, 326, 22, 9, -40, 10, 0, 0x2B2B2E, 0xF6F6F4, "LEVEL", "%+.1f dB", 10);
fd_kn(792, 326, 15, 11, 0, 100, 50, 0x6E6A62, 0xF6F6F4, "DRIFT", "%.0f %%", 10);
fd_led(836, 318, fd_lv, 0xFF3A2A); gfx_setfont(13); ui_col(INK); fd_tc(836, 330, "V");

// METERS: the VU pair (A / B, 0 VU = -18 dBFS), backlit white, dimmed while bypassed
fd_box(870, 88, 186, 308);
fd_va = vu_a_disp; fd_vb = vu_b_disp; ui_vu_dim = byp;
ui_glblue = 2;                                          // JG: a daylight-white lamp (the complement of the amber plate)
vuA.ui_vu(878 * sc, 140 * sc, 170 * sc, 96 * sc, 10 * log10(max(fd_va, 0.0000000001)) + 18, "A");
vuB.ui_vu(878 * sc, 248 * sc, 170 * sc, 96 * sc, 10 * log10(max(fd_vb, 0.0000000001)) + 18, "B");

pk_end();
ui_end();
