desc:FIELD 76 [channel strip] (GFX)
//tags: channel strip eq preamp transformer pan stereo spaced pair location mixer
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-ui, gfx-panel, gfx-os, gfx-bypass and gfx-drift (.jsfx-inc) in the same folder.

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:gain_db=0<-20,30,0.1>-Gain (dB)
slider2:hpf_sel=0<0,2,1{Off,90 Hz,150 Hz}>-HPF
slider3:hf_db=0<-12,12,0.1>-HF (dB)
slider4:mf_db=0<-10,10,0.1>-MF (dB)
slider5:lf_db=0<-12,12,0.1>-LF (dB)
slider6:eq_in=1<0,1,1{Out,In}>-EQ
slider7:pan_pc=0<-100,100,1>-Pan (%)
slider8:space_cm=0<0,60,1>-Spacing (cm)
slider9:level_db=0<-40,10,0.1>-Level (dB)
slider10:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider11:drift_pc=50<0,100,1>-Drift (%)
slider12:byp=0<0,1,1{Off,On}>-Bypass
slider13:comp=0<0,1,1{Off,On}>-Voice comp
slider14:depth_pc=50<0,100,1>-Comp depth (%)
slider15:prs_sel=0<0,11,1{No preset,Init,Dialogue: Close Mic,Dialogue: Boom,Interview: A Side,Interview: B Side,Acoustic Guitar Pair,Piano Wide,Vocal Warm Push,Drum Room Pair,Field Ambience,Tired Batteries}>-Preset

import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc
import gfx-drift.jsfx-inc

@init
#ui_man = "gfx-obq-1";
ext_noinit = 1;

DL = 20000; DL_M = 4095;
CR = 16;

function db2g(d) ( exp(d * 0.11512925464970228); );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );
function ts(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

R0 = 1.2589; PB = 0.015; XK = 1.5; XW = 1.03; LINE_HR = 2;
pb_d = (ts(PB + 0.0001) - ts(PB - 0.0001)) / 0.0002;
pb_0 = ts(PB);
function rail(x, r) ( r * (ts(x / r + PB) - pb_0) / pb_d; );
function xfmr(x, r) instance(lo) local(s) (
  lo += (x - lo) * xf_c;
  s = ts(lo * XK / r) * r / XK * XW;
  x + s - lo;
);

function hp_c(fc) instance(a1, a2, a3) local(g, k) (
  g = tan($pi * min(fc, 0.45 * eq_fs) / eq_fs); k = 1.41421356;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function hp_t(x) instance(a1, a2, a3, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  x - 1.41421356 * v1 - v2;
);
function eq_c(kind, fc, db, q) instance(a1, a2, a3, m0, m1, m2, k) local(a, g) (
  a = 10 ^ (db / 40);
  g = tan($pi * min(fc, 0.45 * eq_fs) / eq_fs);
  kind == 0 ? ( k = 1 / (q * a); m0 = 1; m1 = k * (a * a - 1); m2 = 0; ) :
  kind == 1 ? ( g /= sqrt(a); k = 1 / q; m0 = 1; m1 = k * (a - 1); m2 = a * a - 1; ) :
              ( g *= sqrt(a); k = 1 / q; m0 = a * a; m1 = k * (1 - a) * a; m2 = 1 - a * a; );
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function eq_t(x) instance(a1, a2, a3, m0, m1, m2, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  m0 * x + m1 * v1 + m2 * v2;
);
HF_F = 10000; MF_F = 2800; LF_F = 100; SHELF_Q = 0.55; MF_Q = 0.7;

function chan(x) local(y, h) (
  y = XF.xfmr(x, r_s);
  y = rail(y, r_s);
  ol_v = max(ol_v, abs(y) / r_s);
  h = HP.hp_t(y); y += (h - y) * hp_s;
  h = HFQ.eq_t(MFQ.eq_t(LFQ.eq_t(y))); y += (h - y) * eq_s;
  rail(y, r_s * LINE_HR);
);
function chan_b(x) local(y, h) (
  y = XFB.xfmr(x, r_s);
  y = rail(y, r_s);
  ol_v = max(ol_v, abs(y) / r_s);
  h = HPB.hp_t(y); y += (h - y) * hp_s;
  h = HFB.eq_t(MFB.eq_t(LFB.eq_t(y))); y += (h - y) * eq_s;
  rail(y, r_s * LINE_HR);
);
function chan_clear() (
  XF.lo = 0; HP.ic1 = HP.ic2 = 0; LFQ.ic1 = LFQ.ic2 = MFQ.ic1 = MFQ.ic2 = HFQ.ic1 = HFQ.ic2 = 0;
  XFB.lo = 0; HPB.ic1 = HPB.ic2 = 0; LFB.ic1 = LFB.ic2 = MFB.ic1 = MFB.ic2 = HFB.ic1 = HFB.ic2 = 0;
);
function chan_coefs() (
  eq_fs = srate * os_f;
  xf_c = 1 - exp(-2 * $pi * 150 / eq_fs);
  HP.hp_c(exp(hpf_s));
  LFQ.eq_c(1, LF_F, lf_s, SHELF_Q); MFQ.eq_c(0, MF_F, mf_s, MF_Q); HFQ.eq_c(2, HF_F, hf_s, SHELF_Q);
  HPB.a1 = HP.a1; HPB.a2 = HP.a2; HPB.a3 = HP.a3;
  LFB.a1 = LFQ.a1; LFB.a2 = LFQ.a2; LFB.a3 = LFQ.a3; LFB.m0 = LFQ.m0; LFB.m1 = LFQ.m1; LFB.m2 = LFQ.m2;
  MFB.a1 = MFQ.a1; MFB.a2 = MFQ.a2; MFB.a3 = MFQ.a3; MFB.m0 = MFQ.m0; MFB.m1 = MFQ.m1; MFB.m2 = MFQ.m2;
  HFB.a1 = HFQ.a1; HFB.a2 = HFQ.a2; HFB.a3 = HFQ.a3; HFB.m0 = HFQ.m0; HFB.m1 = HFQ.m1; HFB.m2 = HFQ.m2;
);

CP_F = 1265; CP_Q = 1.05; CP_DQ = 0.8; CP_OFS = 9; CP_RAT = 3; CP_MAX = 6; CP_LO = 220; CP_HI = 5000; CP_LIFT = 0.6;
CPR = 30000;
function bp_c(fc, q) instance(a1, a2, a3, k) local(g) (
  g = tan($pi * min(fc, 0.45 * srate) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function bp_t(x) instance(a1, a2, a3, k, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  k * v1;
);
function cp_clear() (
  memset(CPR, 0, 2 * 10800); cp_w = 0; cp_sb = cp_sf = 0; cp_eb = cp_ef = 0;
  CPB.ic1 = CPB.ic2 = CPD.ic1 = CPD.ic2 = CPL.ic1 = CPL.ic2 = CPH.ic1 = CPH.ic2 = 0;
  CDB.ic1 = CDB.ic2 = CLB.ic1 = CLB.ic2 = CHB.ic1 = CHB.ic2 = 0;
);
function cp_tick() local(ob, of, bd, fd, ex, cut) (
  ob = CPR[cp_w]; of = CPR[10800 + cp_w];
  CPR[cp_w] = cp_eb; CPR[10800 + cp_w] = cp_ef;
  cp_sb = max(cp_sb + cp_eb - ob, 0); cp_sf = max(cp_sf + cp_ef - of, 0);
  cp_eb = cp_ef = 0; cp_w += 1; cp_w >= cp_n ? cp_w = 0;
  cp_s += (comp - cp_s) * c_ct;
  cut = 0;
  cp_sf > 0.000000001 * cp_n * CR ? (
    bd = 10 * log10(max(cp_sb, 0.0000000000001)); fd = 10 * log10(cp_sf);
    ex = bd - fd + CP_OFS;
    cut = min(max(ex, 0) * (1 - 1 / CP_RAT), CP_MAX) * depth_pc / 50;
  ) : cut = cp_g / max(cp_s, 0.001);
  cp_g += (cut * cp_s - cp_g) * c_ct;
  cp_disp = cp_g;
  eq_fs = srate;
  CPD.eq_c(0, CP_F, -cp_g, CP_DQ); CPL.eq_c(1, CP_LO, cp_g * CP_LIFT, SHELF_Q); CPH.eq_c(2, CP_HI, cp_g * CP_LIFT, SHELF_Q);
  CDB.a1 = CPD.a1; CDB.a2 = CPD.a2; CDB.a3 = CPD.a3; CDB.m0 = CPD.m0; CDB.m1 = CPD.m1; CDB.m2 = CPD.m2;
  CLB.a1 = CPL.a1; CLB.a2 = CPL.a2; CLB.a3 = CPL.a3; CLB.m0 = CPL.m0; CLB.m1 = CPL.m1; CLB.m2 = CPL.m2;
  CHB.a1 = CPH.a1; CHB.a2 = CPH.a2; CHB.a3 = CPH.a3; CHB.m0 = CPH.m0; CHB.m1 = CPH.m1; CHB.m2 = CPH.m2;
);

function fd_params() (
  g_t = db2g(gain_db); lv_t = db2g(level_db);
  hpf_sel >= 0.5 ? hpf_t = log(hpf_sel >= 1.5 ? 150 : 90);
  hpo_t = hpf_sel >= 0.5;
  os_tf = os_f2n(os_sl);
  drift_macro(drift_pc);
);

function set_rate() (
  c_kn = coef(0.03); c_sw = coef(0.01); c_ct = 1 - exp(-CR / (0.03 * srate));
  c_vu = coef(0.3); dc_c = 1 - 2 * $pi * 5 / srate;
  c_sga = coef(0.02); c_sgr = coef(0.4);
  cp_n = min(floor(0.9 * srate / CR + 0.5), 10800);
  CPB.bp_c(CP_F, CP_Q);
);

fd_params();
set_rate();
os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
os_gsetup();
hpf_t = hpf_sel >= 1.5 ? log(150) : log(90); hpf_s = hpf_t; hp_s = hpo_t;
hf_s = hf_db; mf_s = mf_db; lf_s = lf_db; eq_s = eq_in;
g_s = g_t; lv_s = lv_t; r_s = R0; r_t = R0;
pan_s = pan_pc; sp_s = space_cm; tau_s = 0; cp_s = comp;
chan_coefs(); chan_clear();
cp_g = 0; cp_clear(); cp_tick();
memset(DL, 0, DL_M + 1); dw = 0;
RW.drift_init(0.8 + rand(1) * 0.4); LW.drift_init(0.8 + rand(1) * 0.4);
rs_f = 1; rs_c = 1 / (0.015 * srate);
by_setup(12);

#fd_pmn = "Init|Dialogue: Close Mic|Dialogue: Boom|Interview: A Side|Interview: B Side|Acoustic Guitar Pair|Piano Wide|Vocal Warm Push|Drum Room Pair|Field Ambience|Tired Batteries";
function fd_set(g, h, hf, mf, lf, pn, spc, lv, dft, cmp) (
  gain_db = g; hpf_sel = h; hf_db = hf; mf_db = mf; lf_db = lf; eq_in = 1; pan_pc = pn; space_cm = spc;
  level_db = lv; drift_pc = dft; comp = cmp; depth_pc = 50;
);
function load_preset(p) local(i) (
  p == 2  ? fd_set(0,   1,   1,   2,  -2,   0,   0,    0,  50,    1) :
  p == 3  ? fd_set(4,   2,   2,   3,  -3,   0,   0,   -4,  50,    1) :
  p == 4  ? fd_set(0,   1,   1,   2,  -2, -45,  25,    0,  50,    1) :
  p == 5  ? fd_set(0,   1,   1,   2,  -2,  45,  25,    0,  50,    1) :
  p == 6  ? fd_set(0,   1,   3,  -1,  -2, -35,  40,    0,  50,    0) :
  p == 7  ? fd_set(0,   0,   2,   0,   1,  30,  60,    0,  50,    0) :
  p == 8  ? fd_set(12,  1,   2,   1,   2,   0,   0,  -10,  50,    1) :
  p == 9  ? fd_set(6,   0,   4,  -2,   3, -70,  60,   -5,  50,    0) :
  p == 10 ? fd_set(0,   1,   3,   0,  -1,  20,  60,    0,  50,    0) :
  p == 11 ? fd_set(10,  0,   0,   0,   0,   0,   0,   -8, 100,    0) :
            fd_set(0,   0,   0,   0,   0,   0,   0,    0,   50,    0);
  i = 1; loop(9, ui_auto(i); i += 1; ); ui_auto(11); ui_auto(13); ui_auto(14);
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(15, i != 15 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@slider
prs_chk();
fd_params();

@block
prs_chk();
fd_params();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? rs_req = 1;
rs_last = rs_now;
bdt = samplesblock / srate;
d_rw = RW.drift_tick(0.07 * dm_s * bdt); d_lw = LW.drift_tick(0.11 * dm_s * bdt);
bat_db = dm_a * (1.5 + 0.4 * d_rw) + 2 * dm_a * min(sg_env, 1);
r_t = R0 * db2g(-bat_db);
lw_g = db2g(0.1 * dm_a * d_lw);
lo_disp = bat_db;

@sample
by_in();
rs_req ? (
  rs_req = 0; rs_f = 0;
  OSU.os_clr(); OSD.os_clr(); OSUB.os_clr(); OSDB.os_clr(); chan_clear(); memset(DL, 0, DL_M + 1);
  dcx = dcy = dcxb = dcyb = 0;
  CPD.ic1 = CPD.ic2 = CPL.ic1 = CPL.ic2 = CPH.ic1 = CPH.ic2 = CPB.ic1 = CPB.ic2 = 0;
  CDB.ic1 = CDB.ic2 = CLB.ic1 = CLB.ic2 = CHB.ic1 = CHB.ic2 = 0;
);
cr_n <= 0 ? (
  cr_n = CR;
  hf_s += (hf_db - hf_s) * c_ct; mf_s += (mf_db - mf_s) * c_ct; lf_s += (lf_db - lf_s) * c_ct;
  hpf_s += (hpf_t - hpf_s) * c_ct;
  r_s += (r_t - r_s) * c_ct;
  cp_tick();
  chan_coefs();
  pn_t = (pan_s * 0.01 + 1) * 0.25 * $pi; p_gl = cos(pn_t) * 1.41421356; p_gr = sin(pn_t) * 1.41421356;
  sp_u = sp_s / 60;
  p_b = 0.4 * min(sp_s / 30, 1); p_a = 0.6 * min(sp_s / 20, 1);
  p_gl2 = p_gl + (1 - p_gl) * p_b; p_gr2 = p_gr + (1 - p_gr) * p_b;
  tau_t = sp_s / 34300 * sin(pan_s * 0.005 * $pi) * srate;
);
cr_n -= 1;
g_s += (g_t - g_s) * c_kn; lv_s += (lv_t - lv_s) * c_kn;
hp_s += (hpo_t - hp_s) * c_sw; eq_s += (eq_in - eq_s) * c_sw;
pan_s += (pan_pc - pan_s) * c_kn; sp_s += (space_cm - sp_s) * c_kn;
tau_s += (tau_t - tau_s) * c_kn;

x = spl0 * g_s; xb = spl1 * g_s;
sg_x = max(abs(x), abs(xb)) / R0;
sg_env += (min(sg_x, 2) - sg_env) * (sg_x > sg_env ? c_sga : c_sgr);
os_gate();
os_chg ? ( chan_coefs(); chan_clear(); os_hold += 2 * samplesblock; );
OSU.os_up(x); OSUB.os_up(xb);
os_f == 1 ? ( y = chan(OSU.s0); yb = chan_b(OSUB.s0); ) :
os_f == 2 ? (
  a0 = chan(OSU.s0); a1 = chan(OSU.s1); y = OSD.os_dn(a0, a1, 0, 0);
  a0 = chan_b(OSUB.s0); a1 = chan_b(OSUB.s1); yb = OSDB.os_dn(a0, a1, 0, 0);
) : (
  a0 = chan(OSU.s0); a1 = chan(OSU.s1); a2 = chan(OSU.s2); a3 = chan(OSU.s3); y = OSD.os_dn(a0, a1, a2, a3);
  a0 = chan_b(OSUB.s0); a1 = chan_b(OSUB.s1); a2 = chan_b(OSUB.s2); a3 = chan_b(OSUB.s3); yb = OSDB.os_dn(a0, a1, a2, a3);
);
dcy = y - dcx + dc_c * dcy; dcx = y; y = dcy;
dcyb = yb - dcxb + dc_c * dcyb; dcxb = yb; yb = dcyb;
cp_m = (y + yb) * 0.5; cp_v = CPB.bp_t(cp_m); cp_eb += cp_v * cp_v; cp_ef += cp_m * cp_m;
y = CPH.eq_t(CPL.eq_t(CPD.eq_t(y))); yb = CHB.eq_t(CLB.eq_t(CDB.eq_t(yb)));
m = (y + yb) * 0.5 * lv_s * lw_g; sd = (y - yb) * 0.5 * lv_s * lw_g;
ol_disp = max(ol_disp, ol_v); ol_v = 0;

DL[dw] = m;
td = max(tau_s, 0); ti = floor(td); tf = td - ti;
mA = DL[(dw - ti) & DL_M] * (1 - tf) + DL[(dw - ti - 1) & DL_M] * tf;
td = max(-tau_s, 0); ti = floor(td); tf = td - ti;
mB = DL[(dw - ti) & DL_M] * (1 - tf) + DL[(dw - ti - 1) & DL_M] * tf;
dw = (dw + 1) & DL_M;
mm = 0.5 * (p_gl + p_gr) * m;
sl = 0.5 * (p_gl - p_gr) * m;
ss = sl + p_a * (0.5 * (p_gl2 * mA - p_gr2 * mB) - sl);
oa = mm + ss + sd * p_gl; ob = mm - ss - sd * p_gr;

oa *= os_g * os_g * (3 - 2 * os_g); ob *= os_g * os_g * (3 - 2 * os_g);
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_q = rs_f * rs_f * (3 - 2 * rs_f);
  pdc_delay > 0 ? ( rs_dl = BY_BUF[(by_w - pdc_delay) & (BY_N - 1)]; rs_dr = BY_BUF[BY_N + ((by_w - pdc_delay) & (BY_N - 1))]; )
                : ( rs_dl = spl0; rs_dr = spl1; );
  oa = rs_dl + (oa - rs_dl) * rs_q; ob = rs_dr + (ob - rs_dr) * rs_q;
);
spl0 = oa; spl1 = ob;
by_out();
vu_a_disp += (spl0 * spl0 - vu_a_disp) * c_vu; vu_b_disp += (spl1 * spl1 - vu_b_disp) * c_vu;

@gfx 1080 420
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1080, 420);
BG = 0x1E150B; HDR = 0x241A10; BP = 0x5A3C17; FP = 0xD9A24A; FP_LT = 0xF2C878; FP_DK = 0x3A2509;
PL = FP; INK = 0x1E1608; RED = 0x9E2A1E; DIM = 0x4E3615; LINE = 0x2A1A08;
C_RED = 0xD23A2E; C_GRN = 0x2F5F4A; C_GRY = 0xD9D9D6; C_BLU = 0x2E6FAE; C_YEL = 0xF2CF2E; C_CRM = 0xEDE6D2;
sc != fd_lsc ? (
  fd_lsc = sc;
  fd_f2 = ui_fitfont(2, 16 * sc);
  gfx_setfont(10, "Trebuchet MS", 30 * sc, 'b');
  gfx_setfont(11, "Trebuchet MS", 18 * sc, 'b');
  gfx_setfont(13, "Trebuchet MS", 13 * sc, 'b');
  gfx_setfont(14, "Trebuchet MS", 14.5 * sc, 'b');
);
gfx_setfont(2, "Trebuchet MS", fd_f2, 'b'); gfx_setfont(3, "Trebuchet MS", fd_f2, 'b');
