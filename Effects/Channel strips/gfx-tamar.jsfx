desc:TAMAR [channel strip] (GFX)
//tags: channel strip preamp filter tape drive eq optical compressor de-esser vca compressor chorus width delay reverb
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-power, gfx-thick, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-os, gfx-bypass

slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,2,1{1x,2x,4x}>-Oversampling
slider3:0<-24,24,0.1>-Trim gain (dB)
slider4:0<0,1,1{Off,On}>-Pad
slider5:0<0,1,1{Normal,Inverted}>-Phase
slider6:88<20,250,1>-HPF (Hz)
slider7:0<0,1,1{Off,On}>-HPF in
slider8:22000<3000,30000,10>-LPF (Hz)
slider9:0<0,1,1{Off,On}>-LPF in
slider10:3<0,10,0.01>-Drive
slider11:0<0,1,1{Warm,Crisp}>-Drive character
slider12:1<0,1,1{Off,On}>-Drive in
slider13:0<-16,16,0.1>-LF gain (dB)
slider14:1<0,1,1{55 Hz,99 Hz}>-LF frequency
slider15:0<-16,16,0.1>-LMF gain (dB)
slider16:440<110,2200,1>-LMF frequency (Hz)
slider17:0<-16,16,0.1>-HMF gain (dB)
slider18:3300<880,8800,10>-HMF frequency (Hz)
slider19:0<-16,16,0.1>-HF gain (dB)
slider20:0<0,1,1{7.7 kHz,11 kHz}>-HF frequency
slider21:1<0,1,1{Off,On}>-EQ in
slider22:1<0,1,1{Off,On}>-Opto in
slider23:0<0,10,0.01>-Opto peak reduction
slider24:0<-12,18,0.1>-Opto gain (dB)
slider25:0<0,1,1{Slow,Fast}>-Opto response
slider26:0<0,1,1{Off,On}>-De-ess in
slider27:6600<4400,11000,10>-De-ess frequency (Hz)
slider28:-24<-40,0,0.1>-De-ess threshold (dB)
slider29:0<0,1,1{Off,On}>-De-ess listen
slider30:0<0,1,1{Off,On}>-VCA in
slider31:-12<-40,0,0.1>-VCA threshold (dB)
slider32:2<0,6,1{2,3,4,6,10,20,Limit}>-VCA ratio
slider33:3<0.1,30,0.01>-VCA attack (ms)
slider34:0.3<0.1,1.2,0.01>-VCA release (s)
slider35:0<0,1,1{Off,On}>-VCA auto release
slider36:0<0,1,1{Off,On}>-VCA SC HPF
slider37:0<0,1,1{Feed-forward,Feedback}>-VCA detector
slider38:0<-12,18,0.1>-VCA gain (dB)
slider39:0<0,1,1{Off,On}>-Chorus in
slider40:0.55<0.1,5,0.01>-Chorus rate (Hz)
slider41:50<0,100,1>-Chorus depth (%)
slider42:50<0,100,1>-Chorus mix (%)
slider43:100<0,200,1>-Width (%)
slider44:0<0,1,1{Off,On}>-Delay in
slider45:330<10,1000,1>-Delay time (ms)
slider46:30<0,95,1>-Delay feedback (%)
slider47:50<0,100,1>-Delay tone (%)
slider48:25<0,100,1>-Delay mix (%)
slider49:0<0,1,1{Off,On}>-Reverb in
slider50:1.5<0.2,8,0.01>-Reverb decay (s)
slider51:0<0,1,1>-(unused, was reverb pre-delay)
slider52:40<0,100,1>-Reverb damp (%)
slider53:20<0,100,1>-Reverb mix (%)
slider54:1<0,2,1{Room,Plate,Hall}>-Reverb mode
slider55:0<-24,12,0.1>-Output (dB)
slider56:0<0,1,1>-(unused, was mute)
slider57:1<0,1,1{5 %,33 %}>-Drift
slider58:0<0,1,1{Off,On}>-Thick
slider59:0<0,1,1{Off,On}>-Delay sync
slider60:5<0,7,1{1/16,1/8T,1/8,1/4T,1/8D,1/4,1/4D,1/2}>-Delay division
slider61:0<0,1,1{Drive first,EQ first}>-Order
slider62:prs_sel=0<0,10,1{No preset,Init,Vocal Chain,Warm Vocal Room,Acoustic Guitar,Bass DI,Drum Bus Punch,Snare Crack,Wide Synth Pad,Slapback Vocal,Tape Lo-Fi}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-drift.jsfx-inc
import gfx-power.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc
import gfx-thick.jsfx-inc

@init
#ui_man = "gfx-tamar";
ext_noinit = 1;

function kn_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function kn_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function kn_db(d) ( exp(0.11512925464970228 * d); );
function kn_ldb(x) ( 20 * log10(max(x, 0.0000001)); );
function kn_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function kn_over(o, kw) ( o <= -kw * 0.5 ? 0 : o >= kw * 0.5 ? o : sqr(o + kw * 0.5) / (2 * kw); );
function kn_dry(m) ( min(1, 2 * (1 - m)); );
function kn_wet(m) ( min(1, 2 * m); );
function kn_beats(i) ( i < 0.5 ? 0.25 : i < 1.5 ? 1 / 3 : i < 2.5 ? 0.5 : i < 3.5 ? 2 / 3 : i < 4.5 ? 0.75 : i < 5.5 ? 1 : i < 6.5 ? 1.5 : 2; );
function kn_rt(i) ( i < 0.5 ? 2 : i < 1.5 ? 3 : i < 2.5 ? 4 : i < 3.5 ? 6 : i < 4.5 ? 10 : i < 5.5 ? 20 : 1000; );

function sv_set(f) instance(k, a1, a2, a3) local(g) (
  g = tan($pi * min(max(f, 5), 0.45 * srate) / srate); k = 1.41421356;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function sv_run(x) instance(k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  lp = v2; bp = v1; hp = x - k * v1 - v2;
);
function sv_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function sv_den() instance(ic1, ic2) ( ic1 = kn_tn(ic1); ic2 = kn_tn(ic2); );
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function bq_den() instance(x1, x2, y1, y2) ( x1 = kn_tn(x1); x2 = kn_tn(x2); y1 = kn_tn(y1); y2 = kn_tn(y2); );

function hd_eq(crisp, gm) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop) (
  emp.bq_set(3, 3000, 0.7, 4); dem.bq_set(3, 3000, 0.7, -4);
  crisp ? ( vpre.bq_set(3, 6000, 0.7, 5); vpost.bq_set(3, 6000, 0.7, -2); ) :
          ( vpre.bq_set(2, 1000, 0.7, 0); vpost.bq_set(2, 1000, 0.7, 0); );
  bump.bq_set(2, 70, 0.9, hd_bump);
  gap.bq_set(0, (crisp ? 21000 : 16000) * gm, 0.55, 0);
  dcb.bq_set(1, 10, 0.7, 0);
  lop.bq_set(0, 250, 0.6, 0);
);
function hd_sat(x, b) local(tb) ( tb = kn_tanh(b); (kn_tanh(hd_g * x + b) - tb) * hd_c; );
function hd_pre(x) instance(emp, vpre, lop, lo) (
  lo = lop.bq_run(x) * hd_lb;
  vpre.bq_run(emp.bq_run(x - lo)) * 0.5;
);
function hd_post(y, lod) instance(dem, vpost, bump, gap, dcb) (
  dcb.bq_run(gap.bq_run(bump.bq_run(vpost.bq_run(dem.bq_run(y * 2)) + lod * hd_lg)));
);
function hd_clr() instance(lo) (
  lo = 0; this.emp.bq_clr(); this.dem.bq_clr(); this.vpre.bq_clr(); this.vpost.bq_clr(); this.bump.bq_clr();
  this.gap.bq_clr(); this.dcb.bq_clr(); this.lop.bq_clr();
);
function hd_den() (
  this.emp.bq_den(); this.dem.bq_den(); this.vpre.bq_den(); this.vpost.bq_den(); this.bump.bq_den();
  this.gap.bq_den(); this.dcb.bq_den(); this.lop.bq_den();
);
function hd_law(d) (
  hd_g = 10 ^ (d * 2.2 / 20);
  hd_c = 0.25 / ((kn_tanh(hd_g * 0.125) - 0) - (kn_tanh(-hd_g * 0.125) - 0));
  hd_lb = (d / 10) ^ 1.2;
  hd_lg = sqrt(hd_g * hd_c);
  hd_bump = 1.5 * (1 - 0.5 * d / 10);
);
KN_LD = 64;
function ld_run(x, mem) instance(w) ( mem[w] = x; w = (w + 1) & (KN_LD - 1); mem[(w - 1 - kn_lat) & (KN_LD - 1)]; );

function op_run(l, r) instance(ms, of, osl) local(t, lv) (
  ms += kn_kms * (0.5 * (l * l + r * r) - ms);
  lv = 10 * log10(max(ms, 0.00000000001)) + 3;
  t = kn_over(lv - op_th, 12) * (2 / 3);
  of += (t > of ? op_ka : op_kf) * (t - of);
  osl += (t > osl ? op_ksa : 1 / (srate * (op_fast ? 0.5 : 1.2) * (0.8 + 0.12 * osl))) * (t - osl);
  min(0.8 * of + 0.2 * osl, 30);
);
function de_run(pk) instance(env, g) local(t) (
  env += (pk > env ? de_ka : de_kr) * (pk - env);
  t = min(max(kn_ldb(env) - de_th, 0) * 0.75, 20);
  g += (t > g ? de_ga : de_gr) * (t - g);
  g;
);
function vc_run(pk) instance(gr, fa, sa, hold) local(t, s) (
  s = vc_fb ? min(vc_sl / max(1 - vc_sl, 0.025), 40) : vc_sl;
  t = min(kn_over(kn_ldb(pk) - vc_th, 4) * s, 40);
  vc_auto > 0.5 ? (
    fa += (t > fa ? vc_ka : vc_kfr) * (t - fa);
    sa += (t > sa ? vc_ksa : vc_ksr) * (t - sa);
    gr = 0.8 * fa + 0.2 * max(sa, 0);
    gr = max(gr, 0);
  ) : (
    gr += (t > gr ? vc_ka : vc_kr) * (t - gr);
    fa = sa = gr;
  );
  min(gr, 40);
);

function rg_rd(mem, n, w, d) local(p, i, f) (
  p = w - d; i = floor(p); f = p - i;
  mem[i & (n - 1)] * (1 - f) + mem[(i + 1) & (n - 1)] * f;
);
function dl_rd(mem, n, w, d) local(p, i, f, y0, y1, y2, y3, c1, c2, c3) (
  d = min(max(d, 1), n - 4);
  p = w - 1 - d; p < 0 ? p += n;
  i = floor(p); f = p - i;
  y0 = mem[i == 0 ? n - 1 : i - 1]; y1 = mem[i]; y2 = mem[(i + 1) % n]; y3 = mem[(i + 2) % n];
  c1 = 0.5 * (y2 - y0); c2 = y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3; c3 = 0.5 * (y3 - y0) + 1.5 * (y1 - y2);
  ((c3 * f + c2) * f + c1) * f + y1;
);
function ch_tone(x) instance(a, b) ( a += kn_kbbd * (x - a); b += kn_kbbd * (a - b); b; );
function dl_sat(x) local(y) ( y = min(max(x, -3), 3); y * (27 + y * y) / (27 + 9 * y * y); );
function dl_tone(x) instance(lp, hp) ( lp += dl_klp * (x - lp); hp += kn_k88 * (lp - hp); lp - hp; );

function rv_mode(m) local(k, hall, room) (
  hall = m == 2; room = m == 0;
  k = 0;
  loop(8,
    rv_len[k] = srate * 0.001 * (hall ?
      (k == 0 ? 29.1 : k == 1 ? 34.7 : k == 2 ? 41.3 : k == 3 ? 47.9 : k == 4 ? 53.3 : k == 5 ? 61.7 : k == 6 ? 71.9 : 83.3) :
      room ?
      (k == 0 ? 4.3 : k == 1 ? 5.9 : k == 2 ? 7.1 : k == 3 ? 8.9 : k == 4 ? 10.3 : k == 5 ? 12.7 : k == 6 ? 14.9 : 17.3) :
      (k == 0 ? 11.3 : k == 1 ? 13.7 : k == 2 ? 16.1 : k == 3 ? 19.3 : k == 4 ? 22.7 : k == 5 ? 26.9 : k == 6 ? 31.3 : 37.1));
    k += 1;
  );
  rv_ap[0] = srate * 0.001 * (hall ? 7.3 : room ? 1.7 : 4.1); rv_ap[1] = srate * 0.001 * (hall ? 11.9 : room ? 2.9 : 5.3);
  rv_ap[2] = srate * 0.001 * (hall ? 8.9 : room ? 2.3 : 4.7); rv_ap[3] = srate * 0.001 * (hall ? 13.1 : room ? 3.7 : 6.1);
  rv_apg = hall ? 0.62 : room ? 0.6 : 0.72;
  rv_md = hall ? srate * 0.0004 : srate * 0.00008;
  rv_pre = srate * 0.001 * (hall ? 24 : room ? 3 : 11);
);
function rv_gains(t60, dmp) local(k) (
  k = 0; loop(8, rv_g[k] = 10 ^ (-3 * rv_len[k] / (max(t60, 0.1) * srate)); k += 1; );
  rv_kd = 1 - exp(-2 * $pi * min(16000 * (0.09 ^ dmp), 0.45 * srate) / srate);
);
function rv_apr(k, x) local(b, i, v, y) (
  b = MRV_AP + k * 8192;
  i = (rv_apw - floor(rv_ap[k])) & 8191;
  v = b[i]; y = v - rv_apg * x; b[rv_apw] = x + rv_apg * y;
  y;
);
function rv_run(l, r) local(k, b, v, a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7, c0, c1, c2, c3, c4, c5, c6, c7, hs, d) (
  l = rv_apr(1, rv_apr(0, l)); r = rv_apr(3, rv_apr(2, r));
  rv_apw = (rv_apw + 1) & 8191;
  rv_ph += rv_phi; rv_ph >= 1 ? rv_ph -= 1;
  k = 0;
  loop(8,
    b = MRV_LN + k * 32768;
    d = rv_len[k] + (k < 4 ? rv_md * (1 + sin(2 * $pi * (rv_ph + k * 0.25))) : 0);
    v = rg_rd(b, 32768, rv_w, d);
    rv_lp[k] += rv_kd * (v - rv_lp[k]);
    rv_v[k] = rv_lp[k] * rv_g[k];
    k += 1;
  );
  a0 = rv_v[0]; a1 = rv_v[1]; a2 = rv_v[2]; a3 = rv_v[3]; a4 = rv_v[4]; a5 = rv_v[5]; a6 = rv_v[6]; a7 = rv_v[7];
  b0 = a0 + a1; b1 = a0 - a1; b2 = a2 + a3; b3 = a2 - a3; b4 = a4 + a5; b5 = a4 - a5; b6 = a6 + a7; b7 = a6 - a7;
  c0 = b0 + b2; c1 = b1 + b3; c2 = b0 - b2; c3 = b1 - b3; c4 = b4 + b6; c5 = b5 + b7; c6 = b4 - b6; c7 = b5 - b7;
  hs = 0.35355339;
  MRV_LN[rv_w] = (c0 + c4) * hs + l * 0.5;
  (MRV_LN + 32768)[rv_w] = (c1 + c5) * hs + r * 0.5;
  (MRV_LN + 65536)[rv_w] = (c2 + c6) * hs - l * 0.5;
  (MRV_LN + 98304)[rv_w] = (c3 + c7) * hs - r * 0.5;
  (MRV_LN + 131072)[rv_w] = (c0 - c4) * hs + l * 0.5;
  (MRV_LN + 163840)[rv_w] = (c1 - c5) * hs + r * 0.5;
  (MRV_LN + 196608)[rv_w] = (c2 - c6) * hs - l * 0.5;
  (MRV_LN + 229376)[rv_w] = (c3 - c7) * hs - r * 0.5;
  rv_w = (rv_w + 1) & 32767;
  rv_l = 0.5 * (a0 - a2 + a4 + a6 - 0.6 * a1 + 0.6 * a7);
  rv_r = 0.5 * (a1 + a3 - a5 + a7 + 0.6 * a0 - 0.6 * a6);
);
function rv_den() local(k) ( k = 0; loop(8, rv_lp[k] = kn_tn(rv_lp[k]); k += 1; ); );

KN_RV_T = 1000;
rv_len = 1000; rv_ap = 1010; rv_g = 1020; rv_lp = 1030; rv_v = 1040;
MLD = 1100;
MCH = 4096;
MPR = 32768;
MRV_AP = 131072;
MRV_LN = 196608;
MDLY = 524288;

#tm_pm = "Init|Vocal Chain|Warm Vocal Room|Acoustic Guitar|Bass DI|Drum Bus Punch|Snare Crack|Wide Synth Pad|Slapback Vocal|Tape Lo-Fi";
function kp_u1(trm, pd, ph, hp, hpi, lp, lpi, drv, cr, dri, lf, lff, lm, lmf, hm, hmf, hf, hff, eqi) (
  slider3 = trm; slider4 = pd; slider5 = ph; slider6 = hp; slider7 = hpi; slider8 = lp; slider9 = lpi;
  slider10 = drv; slider11 = cr; slider12 = dri; slider13 = lf; slider14 = lff; slider15 = lm; slider16 = lmf;
  slider17 = hm; slider18 = hmf; slider19 = hf; slider20 = hff; slider21 = eqi;
);
function kp_u2(oi, pr, og, of, di, df, dt, vi, vt, vr, va, vl, au, sh, fb, vg) (
  slider22 = oi; slider23 = pr; slider24 = og; slider25 = of; slider26 = di; slider27 = df; slider28 = dt; slider29 = 0;
  slider30 = vi; slider31 = vt; slider32 = vr; slider33 = va; slider34 = vl; slider35 = au; slider36 = sh; slider37 = fb; slider38 = vg;
);
function kp_u3(ci, cr, cd, cm, wd, di, dt, df, dn, dm, ri, rd, rp, rdm, rm, rh, ou) (
  slider39 = ci; slider40 = cr; slider41 = cd; slider42 = cm; slider43 = wd; slider44 = di; slider45 = dt; slider46 = df;
  slider47 = dn; slider48 = dm; slider49 = ri; slider50 = rd; slider51 = 0; slider52 = rdm; slider53 = rm; slider54 = rh + 1;
  slider55 = ou; slider56 = 0;
);
function load_preset(p) local(i) (
  p == 1 || p == 11 ? (
    kp_u1(0, 0, 0, 88, 0, 22000, 0, 3, 0, 1, 0, 1, 0, 440, 0, 3300, 0, 0, 1);
    kp_u2(1, 0, 0, 0, 0, 6600, -24, 0, -12, 2, 3, 0.3, 0, 0, 0, 0);
    kp_u3(0, 0.55, 50, 50, 100, 0, 330, 30, 50, 25, 0, 1.5, 22, 40, 20, 0, 0);
  ) : p == 2 ? (
    kp_u1(0, 0, 0, 99, 1, 22000, 0, 2.5, 0, 1, 0, 1, -2, 330, 2, 3300, 3, 1, 1);
    kp_u2(1, 4, 3, 0, 1, 6600, -26, 1, -14, 2, 5, 0.25, 1, 1, 0, 1);
    kp_u3(0, 0.55, 50, 50, 100, 0, 330, 30, 50, 25, 1, 1.2, 33, 45, 14, 0, 0);
  ) : p == 3 ? (
    kp_u1(0, 0, 0, 88, 1, 16500, 1, 4.5, 0, 1, 1, 1, -1.5, 440, 1.5, 2200, 1, 0, 1);
    kp_u2(1, 5, 4, 0, 1, 5500, -28, 0, -12, 2, 3, 0.3, 0, 0, 0, 0);
    kp_u3(0, 0.55, 50, 50, 100, 1, 220, 18, 30, 12, 1, 2.2, 22, 55, 22, 1, 0);
  ) : p == 4 ? (
    kp_u1(0, 0, 0, 110, 1, 22000, 0, 1.5, 1, 1, -1, 1, -3, 220, 1.5, 4400, 2.5, 1, 1);
    kp_u2(1, 3, 2, 1, 0, 6600, -24, 1, -16, 1, 10, 0.4, 1, 1, 0, 1);
    kp_u3(1, 0.4, 30, 25, 115, 0, 330, 30, 50, 25, 1, 1.4, 11, 35, 16, 0, 0);
  ) : p == 5 ? (
    kp_u1(0, 0, 0, 33, 1, 7700, 1, 5.5, 0, 1, 2, 0, -2.5, 330, 2, 1100, -2, 0, 1);
    kp_u2(1, 4, 3, 0, 0, 6600, -24, 1, -10, 2, 12, 0.3, 0, 1, 0, 1);
    kp_u3(0, 0.55, 50, 50, 60, 0, 330, 30, 50, 25, 0, 1.5, 22, 40, 20, 0, 0);
  ) : p == 6 ? (
    kp_u1(0, 0, 0, 44, 1, 22000, 0, 4, 0, 1, 2.5, 0, -2, 440, 1.5, 4400, 2, 1, 1);
    kp_u2(0, 0, 0, 0, 0, 6600, -24, 1, -18, 1, 20, 0.2, 1, 1, 0, 3);
    kp_u3(0, 0.55, 50, 50, 105, 0, 330, 30, 50, 25, 1, 0.8, 0, 30, 10, 0, 0);
  ) : p == 7 ? (
    kp_u1(0, 0, 0, 110, 1, 16500, 1, 6, 1, 1, 1.5, 1, -3, 550, 3, 2200, 1.5, 0, 1);
    kp_u2(0, 0, 0, 0, 0, 6600, -24, 1, -20, 2, 15, 0.15, 0, 1, 0, 4);
    kp_u3(0, 0.55, 50, 50, 100, 0, 330, 30, 50, 25, 1, 1.1, 0, 25, 18, 0, -1);
  ) : p == 8 ? (
    kp_u1(0, 0, 0, 99, 1, 16500, 1, 2, 0, 1, 0, 1, -2, 330, 1, 3300, 1, 1, 1);
    kp_u2(1, 3, 2, 0, 0, 6600, -24, 0, -12, 2, 3, 0.3, 0, 0, 0, 0);
    kp_u3(1, 0.35, 60, 50, 150, 1, 440, 35, 35, 18, 1, 4.5, 44, 50, 30, 1, -1);
  ) : p == 9 ? (
    kp_u1(0, 0, 0, 110, 1, 22000, 0, 4, 0, 1, 0, 1, -1.5, 330, 2, 3300, 2, 1, 1);
    kp_u2(1, 5, 4, 1, 1, 7700, -26, 0, -12, 2, 3, 0.3, 0, 0, 0, 0);
    kp_u3(0, 0.55, 50, 50, 100, 1, 110, 8, 40, 22, 0, 1.5, 22, 40, 20, 0, 0);
  ) : p == 10 ? (
    kp_u1(4, 0, 0, 220, 1, 4400, 1, 8, 0, 1, 1, 1, 0, 440, 3, 1650, 0, 0, 1);
    kp_u2(1, 5, 2, 0, 0, 6600, -24, 0, -12, 2, 3, 0.3, 0, 0, 0, 0);
    kp_u3(1, 0.9, 70, 40, 70, 1, 280, 45, 15, 25, 0, 1.5, 22, 40, 20, 0, -3);
  );
  slider58 = p == 3 || p == 5 || p == 6 || p == 10;
  slider59 = p == 8; slider60 = p == 8 ? 6 : 5; slider61 = 0;
  i = 3; loop(59, ui_auto(i); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function kn_osclr() (
  ouL.os_clr(); ouR.os_clr(); odL.os_clr(); odR.os_clr();
  memset(MLD, 0, 4 * KN_LD);
);
function kn_reset() (
  kn_osclr(); memset(BY_BUF, 0, 2 * BY_N);
  memset(MCH, 0, 2 * 8192); memset(MPR, 0, 2 * 32768); memset(MRV_AP, 0, 4 * 8192); memset(MRV_LN, 0, 8 * 32768);
  memset(MDLY, 0, 2 * dly_n); memset(rv_lp, 0, 8);
  hL.hd_clr(); hR.hd_clr();
  hpL.sv_clr(); hpR.sv_clr(); lpL.sv_clr(); lpR.sv_clr(); deL.sv_clr(); deR.sv_clr(); scL.sv_clr(); scR.sv_clr();
  e1L.bq_clr(); e1R.bq_clr(); e2L.bq_clr(); e2R.bq_clr(); e3L.bq_clr(); e3R.bq_clr(); e4L.bq_clr(); e4R.bq_clr();
  tpL.lp = tpL.hp = tpR.lp = tpR.hp = 0; bbL.a = bbL.b = bbR.a = bbR.b = bbL2.a = bbL2.b = bbR2.a = bbR2.b = 0;
  op.ms = op.of = op.osl = 0; de.env = de.g = 0; vc.gr = vc.fa = vc.sa = 0; vc_ol = vc_or = 0; dc_xl = dc_yl = dc_xr = dc_yr = 0; rv_cold = dl_cold = ch_cold = 1;
  kn_fi = 0;
);
function kn_drive() (
  hd_ct != hd_cc ? ( kn_dk = max(kn_dk - kn_dks, 0); kn_dk == 0 ? ( hd_cc = hd_ct; kn_gc = 7; kn_cr = 0; ); ) :
    kn_dk < 1 ? kn_dk = min(kn_dk + kn_dks, 1);
  os_gate();
  os_chg ? ( kn_osclr(); os_hold += 2 * samplesblock; );
  kn_lat = os_lat(os_f);
  kn_pl = hL.hd_pre(kn_l); kn_pr = hR.hd_pre(kn_r);
  ouL.os_up(kn_pl); ouR.os_up(kn_pr);
  os_f == 1 ? (
    kn_yl = hd_sat(ouL.s0, hd_bl); kn_yr = hd_sat(ouR.s0, hd_br);
  ) : os_f == 2 ? (
    kn_yl = odL.os_dn(hd_sat(ouL.s0, hd_bl), hd_sat(ouL.s1, hd_bl), 0, 0);
    kn_yr = odR.os_dn(hd_sat(ouR.s0, hd_br), hd_sat(ouR.s1, hd_br), 0, 0);
  ) : (
    kn_yl = odL.os_dn(hd_sat(ouL.s0, hd_bl), hd_sat(ouL.s1, hd_bl), hd_sat(ouL.s2, hd_bl), hd_sat(ouL.s3, hd_bl));
    kn_yr = odR.os_dn(hd_sat(ouR.s0, hd_br), hd_sat(ouR.s1, hd_br), hd_sat(ouR.s2, hd_br), hd_sat(ouR.s3, hd_br));
  );
  kn_yl = hL.hd_post(kn_yl, lnA.ld_run(hL.lo, MLD)); kn_yr = hR.hd_post(kn_yr, lnB.ld_run(hR.lo, MLD + KN_LD));
  kn_l = lnC.ld_run(kn_l, MLD + 2 * KN_LD); kn_r = lnD.ld_run(kn_r, MLD + 3 * KN_LD);
  kn_dg = g_dri * kn_dk * kn_dk * (3 - 2 * kn_dk);
  kn_l += kn_dg * (kn_yl - kn_l); kn_r += kn_dg * (kn_yr - kn_r);
  kn_og = os_g * os_g * (3 - 2 * os_g);
  kn_l *= kn_og; kn_r *= kn_og;
);
function kn_eqs() (
  kn_el = e4L.bq_run(e3L.bq_run(e2L.bq_run(e1L.bq_run(kn_l)))); kn_er = e4R.bq_run(e3R.bq_run(e2R.bq_run(e1R.bq_run(kn_r))));
  kn_l += g_eqi * (kn_el - kn_l); kn_r += g_eqi * (kn_er - kn_r);
);

function kn_srinit() (
  kn_sr = srate;
  c_kn = kn_tc(30); c_sw = kn_tc(15); c_sl = kn_tc(180);
  kn_kms = kn_tc(5);
  kn_kbbd = 1 - exp(-2 * $pi * min(8000, 0.4 * srate) / srate);
  kn_k88 = 1 - exp(-2 * $pi * 88 / srate);
  kn_k110 = 1 - exp(-2 * $pi * 110 / srate);
  kn_kpk = exp(-1 / (0.25 * srate));
  de_ka = kn_tc(0.5); de_kr = kn_tc(40); de_ga = kn_tc(1); de_gr = kn_tc(60);
  vc_ksa = kn_tc(250); vc_ksr = kn_tc(1500);
  kn_dks = 1 / (0.010 * srate); kn_oks = 1 / (0.006 * srate);
  kn_fis = 1 / (0.01 * srate);
  kn_dcc = 1 - 2 * $pi * 5 / srate;
  dly_n = ceil(2.1 * srate) + 16; dly_w = 0;
  rv_mc = floor(min(max(slider54, 0), 2) + 0.5); rv_mode(rv_mc); rv_phi = 0.13 / srate;
  scL.sv_set(88); scR.sv_set(88);
  kn_reset(); kn_fi = 1;
  hd_law(slider10); hL.hd_eq(slider11 >= 0.5, 1); hR.hd_eq(slider11 >= 0.5, 1); hd_cc = slider11 >= 0.5;
  thk_init(); thk_lift = 3; thk_drv = 1.5; thk_asym = 0.12; thk_tr = 1.2; thk_trim = 0;
  ost_init(0);
);
os_design();
os_f = os_tf = os_f2n(slider2); os_base = 0;
kn_srinit();
os_gsetup();
kn_snap = 1; kn_dk = 1; rv_dk = 1; kn_ok = 1; kn_oc = kn_ot = slider61 >= 0.5;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_wu_loss = 0.8;  pwr_wu_drv = 1.5;  pwr_wu_lp = 8000;  pwr_bloom = 0.15;
drL.drift_init(0.8 + rand(1) * 0.4); drR.drift_init(0.8 + rand(1) * 0.4);
dgL.drift_init(0.8 + rand(1) * 0.4); dgR.drift_init(0.8 + rand(1) * 0.4);
dcL.drift_init(0.8 + rand(1) * 0.4); dwL.drift_init(0.8 + rand(1) * 0.4); dwR.drift_init(0.8 + rand(1) * 0.4);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(62, i != 62 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(2));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != kn_sr ? kn_srinit();
kn_now = time_precise();
kn_tp > 0 && kn_now - kn_tp > max(0.25, 4 * samplesblock / srate) ? kn_reset();
kn_tp = kn_now;
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider2); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider57 >= 0.5 ? 33 : 5);
kn_dra = dm_a;

t_trim = kn_db(slider3 - 20 * (slider4 >= 0.5)) * (slider5 >= 0.5 ? -1 : 1);
t_hpf = log(min(max(slider6, 20), 250)); t_hpi = slider7 >= 0.5;
t_lpf = log(min(max(slider8, 3000), 30000)); t_lpi = slider9 >= 0.5;
t_drv = min(max(slider10, 0), 10); t_dri = slider12 >= 0.5; hd_ct = slider11 >= 0.5;
t_lf = slider13; t_lff = slider14 >= 0.5 ? 99 : 55; t_lm = slider15; t_lmf = log(min(max(slider16, 110), 2200));
t_hm = slider17; t_hmf = log(min(max(slider18, 880), 8800)); t_hf = slider19; t_hff = slider20 >= 0.5 ? 11000 : 7700;
t_eqi = slider21 >= 0.5;
t_opi = slider22 >= 0.5; op_th = -min(max(slider23, 0), 10) * 3; t_opg = kn_db(slider24); op_fast = slider25 >= 0.5;
op_ka = kn_tc(op_fast ? 4 : 18); op_kf = kn_tc(op_fast ? 50 : 140); op_ksa = kn_tc(op_fast ? 150 : 400);
t_dei = slider26 >= 0.5; t_def = log(min(max(slider27, 4400), 11000)); de_th = slider28; t_del = slider29 >= 0.5;
t_vci = slider30 >= 0.5; vc_th = slider31; vc_sl = 1 - 1 / kn_rt(slider32);
vc_ka = kn_tc(min(max(slider33, 0.1), 30)); vc_kr = kn_tc(1000 * min(max(slider34, 0.1), 1.2));
vc_kfr = kn_tc(500 * min(max(slider34, 0.1), 1.2)); vc_auto = slider35 >= 0.5;
t_sch = slider36 >= 0.5; vc_fb = slider37 >= 0.5; t_vcg = kn_db(slider38);
t_chi = slider39 >= 0.5; t_chr = min(max(slider40, 0.1), 5); t_chd = slider41 / 100; t_chm = slider42 / 100;
kn_wn = min(max(slider43, 0), 200) / 200;
t_ws = 2 * kn_wn; t_wm = kn_wn <= 0.5 ? 1 : 1 - (kn_wn - 0.5);
t_dli = slider44 >= 0.5;
t_dlt = slider59 >= 0.5 ? min(kn_beats(slider60) * 60 / max(tempo, 20), 2) * srate : min(max(slider45, 10), 1000) * 0.001 * srate; t_dlf = min(max(slider46, 0), 95) / 100;
t_dln = slider47 / 100; t_dlm = slider48 / 100;
t_rvi = slider49 >= 0.5; t_rvd = min(max(slider50, 0.2), 8);
t_rvdm = slider52 / 100; t_rvm = slider53 / 100; rv_mt = floor(min(max(slider54, 0), 2) + 0.5);
t_out = kn_db(min(max(slider55, -24), 12)); t_mut = 1; kn_ot = slider61 >= 0.5;
kn_snap ? (
  g_trim = t_trim; g_hpf = t_hpf; g_hpi = t_hpi; g_lpf = t_lpf; g_lpi = t_lpi; g_drv = t_drv; g_dri = t_dri;
  g_lf = t_lf; g_lff = t_lff; g_lm = t_lm; g_lmf = t_lmf; g_hm = t_hm; g_hmf = t_hmf; g_hf = t_hf; g_hff = t_hff; g_eqi = t_eqi;
  g_opi = t_opi; g_opg = t_opg; g_dei = t_dei; g_def = t_def; g_del = t_del; g_vci = t_vci; g_sch = t_sch; g_vcg = t_vcg;
  g_chi = t_chi; g_chr = t_chr; g_chd = t_chd; g_chm = t_chm; g_ws = t_ws; g_wm = t_wm;
  g_dli = t_dli; g_dlt = t_dlt; g_dlf = t_dlf; g_dln = t_dln; g_dlm = t_dlm;
  g_rvi = t_rvi; g_rvd = t_rvd; g_rvdm = t_rvdm; g_rvm = t_rvm; g_out = t_out; g_mut = t_mut;
  kn_cr = 0;
);
kn_snap = 0;
hL.hd_den(); hR.hd_den(); hpL.sv_den(); hpR.sv_den(); lpL.sv_den(); lpR.sv_den(); deL.sv_den(); deR.sv_den(); scL.sv_den(); scR.sv_den();
e1L.bq_den(); e1R.bq_den(); e2L.bq_den(); e2R.bq_den(); e3L.bq_den(); e3R.bq_den(); e4L.bq_den(); e4R.bq_den();
rv_den(); op.ms = kn_tn(op.ms);
kn_pk_d = max(kn_pk_d, kn_pkm); kn_pkm = 0;
kn_go_d = max(kn_go_d, kn_gom); kn_ge_d = max(kn_ge_d, kn_gem); kn_gv_d = max(kn_gv_d, kn_gvm); kn_gom = kn_gem = kn_gvm = 0;
kn_ol_d = max(kn_ol_d, kn_olm); kn_or_d = max(kn_or_d, kn_orm); kn_olm = kn_orm = 0;
os_snapb(slider(2));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
g_trim += (t_trim - g_trim) * c_kn;
g_hpf += (t_hpf - g_hpf) * c_kn; g_hpi += (t_hpi - g_hpi) * c_sw; g_lpf += (t_lpf - g_lpf) * c_kn; g_lpi += (t_lpi - g_lpi) * c_sw;
g_drv += (t_drv - g_drv) * c_kn; g_dri += (t_dri - g_dri) * c_sw;
g_lf += (t_lf - g_lf) * c_kn; g_lff += (t_lff - g_lff) * c_kn; g_lm += (t_lm - g_lm) * c_kn; g_lmf += (t_lmf - g_lmf) * c_kn;
g_hm += (t_hm - g_hm) * c_kn; g_hmf += (t_hmf - g_hmf) * c_kn; g_hf += (t_hf - g_hf) * c_kn; g_hff += (t_hff - g_hff) * c_kn;
g_eqi += (t_eqi - g_eqi) * c_sw;
g_opi += (t_opi - g_opi) * c_sw; g_opg += (t_opg - g_opg) * c_kn;
g_dei += (t_dei - g_dei) * c_sw; g_def += (t_def - g_def) * c_kn; g_del += (t_del - g_del) * c_sw;
g_vci += (t_vci - g_vci) * c_sw; g_sch += (t_sch - g_sch) * c_sw; g_vcg += (t_vcg - g_vcg) * c_kn;
g_chi += (t_chi - g_chi) * c_sw; g_chr += (t_chr - g_chr) * c_kn; g_chd += (t_chd - g_chd) * c_kn; g_chm += (t_chm - g_chm) * c_kn;
g_ws += (t_ws - g_ws) * c_kn; g_wm += (t_wm - g_wm) * c_kn;
g_dli += (t_dli - g_dli) * c_sw; g_dlt += (t_dlt - g_dlt) * c_sl; g_dlf += (t_dlf - g_dlf) * c_kn;
g_dln += (t_dln - g_dln) * c_kn; g_dlm += (t_dlm - g_dlm) * c_kn;
g_rvi += (t_rvi - g_rvi) * c_sw; g_rvd += (t_rvd - g_rvd) * c_kn;
g_rvdm += (t_rvdm - g_rvdm) * c_kn; g_rvm += (t_rvm - g_rvm) * c_kn;
g_out += (t_out - g_out) * c_kn; g_mut += (t_mut - g_mut) * c_sw;

kn_cr <= 0 ? (
  kn_cr = 16;
  hpL.sv_set(exp(g_hpf)); hpR.k = hpL.k; hpR.a1 = hpL.a1; hpR.a2 = hpL.a2; hpR.a3 = hpL.a3;
  lpL.sv_set(exp(g_lpf)); lpR.k = lpL.k; lpR.a1 = lpL.a1; lpR.a2 = lpL.a2; lpR.a3 = lpL.a3;
  deL.sv_set(exp(g_def)); deR.k = deL.k; deR.a1 = deL.a1; deR.a2 = deL.a2; deR.a3 = deL.a3;
  hd_law(g_drv);
  kn_v1 = drL.drift_tick(16 * 0.11 * dm_s / srate); kn_v2 = drR.drift_tick(16 * 0.11 * dm_s / srate);
  kn_v3 = dgL.drift_tick(16 * 0.07 * dm_s / srate); kn_v4 = dgR.drift_tick(16 * 0.07 * dm_s / srate);
  kn_v5 = dcL.drift_tick(16 * 0.09 * dm_s / srate);
  kn_v6 = dwL.drift_tick(16 * 0.6 * dm_s / srate); kn_v7 = dwR.drift_tick(16 * 0.5 * dm_s / srate);
  hd_bl = 0.06 * kn_dra * kn_v1; hd_br = 0.06 * kn_dra * kn_v2;
  kn_gc += 1; kn_gc >= 8 ? (
    kn_gc = 0;
    hL.hd_eq(hd_cc, 2 ^ (0.2 * kn_dra * kn_v3)); hR.hd_eq(hd_cc, 2 ^ (0.2 * kn_dra * kn_v4));
    e1L.bq_set(4, g_lff, 0.7, g_lf); e2L.bq_set(2, exp(g_lmf), 0.5 + 0.11 * abs(g_lm), g_lm);
    e3L.bq_set(2, exp(g_hmf), 0.5 + 0.11 * abs(g_hm), g_hm); e4L.bq_set(3, g_hff, 0.7, g_hf);
    e1R.b0 = e1L.b0; e1R.b1 = e1L.b1; e1R.b2 = e1L.b2; e1R.a1 = e1L.a1; e1R.a2 = e1L.a2;
    e2R.b0 = e2L.b0; e2R.b1 = e2L.b1; e2R.b2 = e2L.b2; e2R.a1 = e2L.a1; e2R.a2 = e2L.a2;
    e3R.b0 = e3L.b0; e3R.b1 = e3L.b1; e3R.b2 = e3L.b2; e3R.a1 = e3L.a1; e3R.a2 = e3L.a2;
    e4R.b0 = e4L.b0; e4R.b1 = e4L.b1; e4R.b2 = e4L.b2; e4R.a1 = e4L.a1; e4R.a2 = e4L.a2;
    rv_gains(g_rvd, g_rvdm);
    dl_klp = 1 - exp(-2 * $pi * min(1100 * (10 ^ g_dln), 0.45 * srate) / srate);
  );
  ch_inc = g_chr * (1 + 0.06 * kn_dra * kn_v5) / srate;
);
kn_cr -= 1;

kn_l = spl0 * g_trim; kn_r = spl1 * g_trim;
pwr_in(kn_l, kn_r); kn_l = pwr_l; kn_r = pwr_r;
kn_pkm = max(kn_pkm, max(abs(kn_l), abs(kn_r)));
hpL.sv_run(kn_l); hpR.sv_run(kn_r);
kn_l += g_hpi * (hpL.hp - kn_l); kn_r += g_hpi * (hpR.hp - kn_r);
lpL.sv_run(kn_l); lpR.sv_run(kn_r);
kn_l += g_lpi * (lpL.lp - kn_l); kn_r += g_lpi * (lpR.lp - kn_r);
kn_ot != kn_oc ? ( kn_ok = max(kn_ok - kn_oks, 0); kn_ok == 0 ? kn_oc = kn_ot; ) : kn_ok < 1 ? kn_ok = min(kn_ok + kn_oks, 1);
kn_ogg = kn_ok * kn_ok * (3 - 2 * kn_ok);
kn_l *= kn_ogg; kn_r *= kn_ogg;
kn_oc ? ( kn_eqs(); kn_drive(); ) : ( kn_drive(); kn_eqs(); );
kn_l *= kn_ogg; kn_r *= kn_ogg;

op_gr = op.op_run(kn_l, kn_r);
kn_g = kn_db(-op_gr) * g_opg;
kn_l += g_opi * (kn_l * kn_g - kn_l); kn_r += g_opi * (kn_r * kn_g - kn_r);
kn_gom = max(kn_gom, op_gr * t_opi);
thk_proc(kn_l, kn_r, slider58 >= 0.5); kn_l = thk_l; kn_r = thk_r;
deL.sv_run(kn_l); deR.sv_run(kn_r);
de_gr = de.de_run(max(abs(deL.hp), abs(deR.hp)));
kn_g = kn_db(-de_gr);
kn_el = kn_l - deL.hp + deL.hp * kn_g; kn_er = kn_r - deR.hp + deR.hp * kn_g;
kn_el += g_del * (deL.hp - kn_el); kn_er += g_del * (deR.hp - kn_er);
kn_l += g_dei * (kn_el - kn_l); kn_r += g_dei * (kn_er - kn_r);
kn_gem = max(kn_gem, de_gr * t_dei);
kn_a = vc_fb ? vc_ol : kn_l; kn_b = vc_fb ? vc_or : kn_r;
scL.sv_run(kn_a); scR.sv_run(kn_b);
kn_pk = max(abs(kn_a + g_sch * (scL.hp - kn_a)), abs(kn_b + g_sch * (scR.hp - kn_b)));
vc_gr = vc.vc_run(kn_pk);
kn_g = kn_db(-vc_gr) * g_vcg;
vc_ol = kn_l * kn_db(-vc_gr); vc_or = kn_r * kn_db(-vc_gr);
kn_l += g_vci * (kn_l * kn_g - kn_l); kn_r += g_vci * (kn_r * kn_g - kn_r);
kn_gvm = max(kn_gvm, vc_gr * t_vci);

ch_ph += ch_inc; ch_ph >= 1 ? ch_ph -= 1;
kn_t = 2 * abs(2 * ch_ph - 1) - 1;
kn_t2 = -kn_t;
MCH[ch_w] = bbL.ch_tone(kn_l); (MCH + 8192)[ch_w] = bbR.ch_tone(kn_r);
kn_a = rg_rd(MCH, 8192, ch_w, srate * 0.001 * (7.5 + 3.5 * g_chd * kn_t));
kn_b = rg_rd(MCH + 8192, 8192, ch_w, srate * 0.001 * (7.5 + 3.5 * g_chd * kn_t2));
ch_w = (ch_w + 1) & 8191;
kn_a = bbL2.ch_tone(kn_a); kn_b = bbR2.ch_tone(kn_b);
kn_el = kn_l * kn_dry(g_chm) + kn_a * kn_wet(g_chm); kn_er = kn_r * kn_dry(g_chm) + kn_b * kn_wet(g_chm);
