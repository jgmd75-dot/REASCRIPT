desc:Duplex [dual compressor + EQ] (GFX)
//tags: compressor limiter de-esser vca broadcast dual-channel mid-side eq
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-instrument, gfx-dyn, gfx-clip (.jsfx-inc).
//
// DUPLEX (JG, 28 Oct 2026: "its own unit again, not paired with OBQ"): the DUPLEX model of the Stable OB Q on its own.
// An 80s British two-channel dynamics processor in spirit: clean, snappy and responsive. No transformer; a fast
// detector that leans on the peaks (70 % peak with a 12 ms hold, 30 % RMS over 3 ms), a 6 dB knee or a FIRM 1 dB knee,
// and a release that closes cleanly (a straight-line term on top of the curve). Grey and green face.
//   MODE      - STEREO: channel A runs both sides. DUAL: A = left, B = right. M-S: A = mid, B = side.
//   LINK      - the two detectors share the louder level, so the image stays put; in DUAL and M-S the two channels'
//               controls are ganged too (turning one moves the other by the same amount; offsets are kept).
//   Per channel: THRESHOLD, RATIO (1:1 - INF:1), ATTACK, RELEASE, AUTO timing, GAIN, IN, and
//   DE-ESS    - the compressor listens only above the DE-ESS frequency, lifted by AMOUNT (0 - 12 dB), so it reacts
//               to sibilance. SPLIT: the gain reduction is applied only above that frequency (a 24 dB/oct
//               Linkwitz-Riley split at 3/4 of it), so the body of the voice is untouched; off: wideband.
//   LIMIT     - a fast peak limiter after the compressor (fully left = off).
//   MIX       - parallel compression: the dry signal blended back in.
//   EQ        - HPF / LPF, LF and HF (shelf or BELL), LMF and HMF with Q, BROWN / BLACK voicing, IN.
//   ORDER     - the EQ after the dynamics or in front of them.
// Sliders keep OB Q's numbers (1 and 30 - 35 unused here), so its DUPLEX settings carry across.
// PRESETS: Vocal Compressor, De-esser (split), M-S Glue (sides held), Dual Mono Pair, Brickwall Safety
// (+ Reset all to defaults). No latency.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-clip.jsfx-inc

slider1:1<0,1,1{OB,Duplex}>-(unused, was Model)
slider2:0<0,2,1{Stereo,Dual,M-S}>-Mode
slider3:1<0,1,1{Off,On}>-Link
slider4:100<0,100,1>-Mix (%)
slider5:0<0,1,1{Dynamics then EQ,EQ then Dynamics}>-Order
slider6:1<0,1,1{Out,In}>-A in
slider7:-20<-40,0,0.1>-A threshold (dB)
slider8:3<1,20,0.1>-A ratio (20 = inf)
slider9:5<0.1,50,0.1>-A attack (ms)
slider10:250<20,3000,1>-A release (ms)
slider11:0<0,1,1{Off,On}>-A auto timing (Duplex)
slider12:0<-10,20,0.1>-A gain (dB)
slider13:0<0,1,1{Off,On}>-A de-ess
slider14:6000<2000,12000,10>-A de-ess frequency (Hz)
slider15:1<0,1,1{Off,On}>-A de-ess split (off = wideband)
slider16:6<0,12,0.1>-A de-ess amount (dB)
slider17:0<-24,0,0.1>-A limit (dB, 0 = off)
slider18:1<0,1,1{Out,In}>-B in
slider19:-20<-40,0,0.1>-B threshold (dB)
slider20:3<1,20,0.1>-B ratio (20 = inf)
slider21:5<0.1,50,0.1>-B attack (ms)
slider22:250<20,3000,1>-B release (ms)
slider23:0<0,1,1{Off,On}>-B auto timing (Duplex)
slider24:0<-10,20,0.1>-B gain (dB)
slider25:0<0,1,1{Off,On}>-B de-ess
slider26:6000<2000,12000,10>-B de-ess frequency (Hz)
slider27:1<0,1,1{Off,On}>-B de-ess split (off = wideband)
slider28:6<0,12,0.1>-B de-ess amount (dB)
slider29:0<-24,0,0.1>-B limit (dB, 0 = off)
slider30:0<0,1,1{Out,In}>-(unused, was Gate in)
slider31:-50<-80,0,0.1>-(unused, was Gate threshold)
slider32:20<0,60,0.1>-(unused, was Gate range)
slider33:200<20,2000,1>-(unused, was Gate release)
slider34:1<0,1,1{Gate,Expander}>-(unused, was Gate type)
slider35:1<0,1,1{Off,On}>-(unused, was Transformer)
slider36:0<0,1,1{Soft,Firm}>-Knee (Duplex)
slider37:1<0,1,1{Off,On}>-Input guard
slider38:20<20,400,1>-EQ: HPF (Hz, 20 = off)
slider39:22000<3000,22000,10>-EQ: LPF (Hz, 22000 = off)
slider40:0<-15,15,0.1>-EQ: LF gain (dB)
slider41:100<30,450,1>-EQ: LF freq (Hz)
slider42:0<0,1,1{Shelf,Bell}>-EQ: LF bell
slider43:0<-15,15,0.1>-EQ: LMF gain (dB)
slider44:600<200,2500,1>-EQ: LMF freq (Hz)
slider45:1<0.4,3,0.01>-EQ: LMF Q
slider46:0<-15,15,0.1>-EQ: HMF gain (dB)
slider47:2500<600,7000,1>-EQ: HMF freq (Hz)
slider48:1<0.4,3,0.01>-EQ: HMF Q
slider49:0<-15,15,0.1>-EQ: HF gain (dB)
slider50:8000<1500,16000,10>-EQ: HF freq (Hz)
slider51:0<0,1,1{Shelf,Bell}>-EQ: HF bell
slider52:1<0,1,1{Out,In}>-EQ: EQ in
slider53:1<0,1,1{Brown,Black}>-EQ: Voicing
slider54:prs_sel=0<0,5,1{No preset,Vocal Compressor,De-esser (split),M-S Glue (sides held),Dual Mono Pair,Brickwall Safety}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-duplex";                                       // the ? pop-up links to this manual
ext_noinit = 1;                                             // @init only on load / rate change: settings and meters persist across playback
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;                   // house drive standard: ADAA, pre-filter, knee tracking (character stage)

// ================= one signal path (P1, P2): settings + state =================
// DE-ESS: the side-chain high-pass at the frequency; SPLIT: a 24 dB/oct Linkwitz-Riley split at 3/4 of it
function p_xo(f) instance(hs, la, lb, ha, hb) (
  hs.bq_set(1, f, 0.70710678, 0);
  f *= 0.75;
  la.bq_set(0, f, 0.70710678, 0); lb.bq_set(0, f, 0.70710678, 0);
  ha.bq_set(1, f, 0.70710678, 0); hb.bq_set(1, f, 0.70710678, 0);
);
// settings of channel A (base 6) or B (base 18), read once per block
function p_cfg(base) instance(on, thr, sl, ac, rc, acs, rcs, rcl, aut, mk, de, spl, damt, lon, ltg, dfr) local(at, rl) (
  on = slider(base) >= 0.5; thr = slider(base + 1);
  sl = slider(base + 2) >= 19.95 ? 0 : 1 / slider(base + 2);
  at = slider(base + 3); rl = slider(base + 4);
  ac = dy_ms(at); rc = dy_ms(rl);
  acs = dy_ms(max(at * 20, 150)); rcs = dy_ms(rl * SLR);      // OB: the slow stage of the two-stage release
  rcl = 4 / (rl * 0.001 * srate);                           // DUPLEX: a straight-line release term, 4 dB per release time
  aut = slider(base + 5) >= 0.5; mk = 10 ^ (slider(base + 6) / 20);
  de = slider(base + 7) >= 0.5; spl = slider(base + 9) >= 0.5; damt = 10 ^ (slider(base + 10) / 20);
  lon = slider(base + 11) < -0.05; ltg = 10 ^ (slider(base + 11) / 20);
  dfr != slider(base + 8) ? ( dfr = slider(base + 8); this.p_xo(dfr); );
);
// gate (OB): its own level (6 ms RMS, so it does not chatter), then the gain in dB
function p_glv(x) instance(gms) ( gms += (x * x - gms) * gdet_c; 10 * log10(gms + 0.0000000001) + 3; );
function p_gate(lv) instance(ge) local(t, o) (
  g_on ? (
    o = lv - gthr;
    t = gtyp ? max(min(o, 0), -grange) : (o < 0 ? -grange : 0);
    ge += (t - ge) * (t > ge ? gatt_c : grel_c);
  ) : ge += (0 - ge) * gatt_c;
  ge;
);
// compressor detector (dB, a sine reads its peak). DE-ESS: only what lies above the frequency, lifted by AMOUNT.
// OB: RMS over 5 ms. DUPLEX: 70 % peak (instant, 12 ms hold, 20 ms fall) + 30 % RMS over 3 ms.
function p_det(x) instance(hs, ms, pk, hc, de, damt) local(sk, ak, h) (
  h = hs.bq_run(x);
  sk = de ? damt * h : x;
  eng ? (
    ms += (sk * sk - ms) * dd_c;
    ak = abs(sk); ak >= pk ? ( pk = ak; hc = dd_hold; ) : hc > 0 ? hc -= 1 : pk *= dd_fall;
    0.7 * 20 * log10(pk + 0.00001) + 0.3 * (10 * log10(ms + 0.0000000001) + 3);
  ) : (
    ms += (sk * sk - ms) * do_c;
    10 * log10(ms + 0.0000000001) + 3;
  );
);
// gain computer + timing (dB domain)
function p_gain(lv) instance(on, thr, sl, ac, rc, acs, rcs, rcl, aut, e, ef, es, sust) local(t, c) (
  on ? (
    eng ? (
      t = -(1 - sl) * dy_curve(lv - thr, dkn);
      t < e ? (
        c = aut ? min(1, max(e - t, 5) / (0.15 * srate)) : ac;    // AUTO: the attack follows how far over it is
        e += (t - e) * c;
      ) : (
        aut ? e += (t - e) * dy_ms(80 + 900 * sust / 1.5)        // AUTO: quick after short peaks, slow after long passages
            : e = min(e + (t - e) * rc + (t - e > 1 ? rcl : 0), t);   // the straight-line term only on a real recovery
      );
      sust = min(max(sust + (e < -1 ? 1 : -2) / srate, 0), 1.5);
    ) : (
      t = -(1 - sl) * dy_curve(lv - thr, 10);
      ef += (t - ef) * (t < ef ? ac : rc);                       // fast stage
      es += (t - es) * (t < es ? acs : rcs);                     // slow stage: charges only on long passages
      e = min(ef, es * SLW);
    );
  ) : ( e += (0 - e) * off_c; ef = es = e; sust = 0; );
  e;
);
// apply the gain: wideband, or only above the split (SPLIT); the two are cross-faded (10 ms), never switched
function p_apply(x) instance(e, on, de, spl, sw, la, lb, ha, hb, mk, mks) local(g, lo, hi) (
  g = 10 ^ (e / 20);
  lo = lb.bq_run(la.bq_run(x)); hi = hb.bq_run(ha.bq_run(x));
  sw += ((on && de && spl) - sw) * xs_c;
  mks += ((on ? mk * (eng ? 1 : ob_trim) : 1) - mks) * xs_c;
  sw < 0.00001 ? x * g : (x * g) * (1 - sw) + (lo + hi * g) * sw;
);
// OB: the VCA stage's saturation. Soft (a knee clipper, anti-aliased, its half-sample lag made up), biased a little
// for even harmonics, read relative to the threshold, and pushed harder (with a wider knee and a little less top)
// as the gain reduction rises. Unity small-signal gain.
function p_sat(x) instance(st, e, thk, c1, on, sow) local(k, u, y, c) (
  sow += (on - sow) * xs_c;                                 // with the compressor (IN), cross-faded
  k = thk * (1 + SATK * min(-e, 20));
  u = st.clp_pf_run(x) * k + sat_b;
  y = st.clp_run(u); c = st.clp_crv(u);
  y += 0.5 * (c - c1); c1 = c;
  x + ((y - st.cb) / (k * st.csl) - x) * sow;
);
// fast peak limiter: instant attack, 50 ms release; returns the gain
function p_limt(x) instance(lg, lon, ltg, on) local(t) (
  t = lon && on && abs(x) > ltg ? ltg / abs(x) : 1;
  lg = t < lg ? t : lg + (1 - lg) * lim_r;
  lg;
);
// per block: the saturation's drive from the gain reduction (pre-filter and knee follow it), its rest point
function p_blk() instance(st, e, thr, thk) local(d, w) (
  d = min(max(-e / 15, 0), 1);
  st.clp_pf_block(d, srate, samplesblock);
  w = st.clp_kt_block(d, srate, samplesblock); st.clp_knee(w);
  st.cb = st.clp_crv(sat_b);
  st.csl = sat_b <= 1 - w ? 1 : 1 - (sat_b - 1 + w) / (2 * w);
  thk = SATR * 10 ^ (-thr / 20);
  st.clp_tidy();
);
function p_init() instance(st, lg, mks) (
  st.clp_set(2, 1, 1, 0); st.clp_pf_cfg(22000, 11000, -1, 70); st.clp_kt_cfg(0.55, 1); st.clp_pf_reset();
  lg = 1; mks = 1;
);

// ================= OB transformers (one per side, in and out) =================
// The core saturates the lows first (a soft clipper on the band below 150 Hz, anti-aliased, biased a little
// for even harmonics; the one-pole split is its pre-filter), and the band comes back with a little more weight.
// The output transformer also carries a low-mid lift and rounds the extreme top.
function xf_run(x, kx, wt) instance(lo, c, c1) local(u, y, cc) (
  lo += (x - lo) * xf_lc;
  u = lo * kx + xf_b;
  y = c.clp_run(u); cc = c.clp_crv(u); y += 0.5 * (cc - c1); c1 = cc;
  x - lo + wt * (y - xf_cb) / (kx * xf_sl);
);
function xo_run(x) instance(lm, hi) (
  x = this.xf_run(x, XOK, 1.06);
  x = lm.bq_run(x);
  hi += (x - hi) * xf_hc;
  hi;
);
function xf_init() instance(c) ( c.clp_set(1, 1, 1, 0); );

function update() (
  // the engine (eng) and the matrix (emd) change only at the silent point of a duck
  P1.p_cfg(6); P2.p_cfg(emd == 0 ? 6 : 18);
  lnk = slider3 >= 0.5; mix_t = slider4 / 100;
  g_on = slider30 >= 0.5 && slider31 > -79.9 && eng == 0; gthr = slider31; grange = slider32; grel_c = dy_ms(slider33); gtyp = slider34 >= 0.5;
  xfm_t = slider35 >= 0.5;
  dkn = slider36 >= 0.5 ? 1 : 6;
  in_setup(0, slider37);
  ost_setup(0, 0, 120, 6000, -0.3, 0);   // output stage: straight through
);

// ---------- presets (each sets the whole unit; INPUT GUARD stays) ----------
// master: model, mode, link, mix, order, knee (Duplex), transformer (OB)
function pmst(mdl, md, lk, mx, od, kn, xf) ( slider1 = mdl; slider2 = md; slider3 = lk; slider4 = mx; slider5 = od; slider36 = kn; slider35 = xf; );
// one channel (base 6 = A, 18 = B): threshold, ratio, attack, release, auto, gain, de-ess, freq, split, amount, limit
function pch(bs, t, r, at, rl, au, g, de, f, sp, am, lm) (
  slider(bs) = 1; slider(bs + 1) = t; slider(bs + 2) = r; slider(bs + 3) = at; slider(bs + 4) = rl; slider(bs + 5) = au;
  slider(bs + 6) = g; slider(bs + 7) = de; slider(bs + 8) = f; slider(bs + 9) = sp; slider(bs + 10) = am; slider(bs + 11) = lm;
);
function pboth(t, r, at, rl, au, g, de, f, sp, am, lm) ( pch(6, t, r, at, rl, au, g, de, f, sp, am, lm); pch(18, t, r, at, rl, au, g, de, f, sp, am, lm); );
// gate (OB): in, threshold, range, release, type (1 = expander)
function pgt(on, t, r, rl, ty) ( slider30 = on; slider31 = t; slider32 = r; slider33 = rl; slider34 = ty; );
// EQ: HPF, LPF, LF gain / freq / bell, LMF gain / freq / Q, HMF gain / freq / Q, HF gain / freq / bell, voicing
function peq(hp, lp, lg, lf, lb, mg, mf, mq, hg, hfr, hq, fg, ff, fb, vo) (
  slider38 = hp; slider39 = lp; slider40 = lg; slider41 = lf; slider42 = lb; slider43 = mg; slider44 = mf; slider45 = mq;
  slider46 = hg; slider47 = hfr; slider48 = hq; slider49 = fg; slider50 = ff; slider51 = fb; slider52 = 1; slider53 = vo;
);
function peq0() ( peq(20, 22000, 0, 100, 0, 0, 600, 1, 0, 2500, 1, 0, 8000, 0, 1); );
function load_old(p) local(k) (
  p == 1  ? ( pmst(0, 0, 1, 100, 0, 0, 1); pboth(-22, 2.5, 8, 300, 0, 0.8, 0, 6000, 1, 6, 0);    pgt(0, -50, 20, 200, 1); peq0(); ) :   // Desk Glue (OB)
  p == 2  ? ( pmst(0, 0, 1, 100, 0, 0, 1); pboth(-28, 6, 10, 180, 0, 7.0, 0, 6000, 1, 6, -1);    pgt(0, -50, 20, 200, 1);
              peq(30, 22000, 2, 80, 0, -2, 400, 1, 1.5, 4000, 1, 0, 8000, 0, 1); ) :                                                    // Pillow Drum Bus (OB)
  p == 3  ? ( pmst(0, 0, 1, 100, 0, 0, 1); pboth(-26, 4, 3, 150, 0, 2.2, 1, 6500, 0, 3, -2);     pgt(1, -55, 12, 250, 1);
              peq(80, 22000, 0, 100, 0, -2, 300, 1, 2, 3500, 1.2, 1.5, 10000, 0, 1); ) :                                                // Presenter Voice (OB)
  p == 4  ? ( pmst(0, 0, 1, 100, 0, 0, 1); pboth(-22, 5, 1, 120, 0, 2.2, 0, 6000, 1, 6, -1);     pgt(1, -45, 40, 120, 0); peq0(); ) :   // Tight Drums (gated) (OB)
  p == 5  ? ( pmst(0, 0, 1, 70, 0, 0, 1);  pboth(-34, 10, 2, 100, 0, 11.3, 0, 6000, 1, 6, -2);      pgt(0, -50, 20, 200, 1); peq0(); ) :   // Parallel Squash (OB)
  p == 6  ? ( pmst(0, 0, 1, 100, 0, 0, 1); pboth(-24, 4, 12, 250, 0, 3.0, 0, 6000, 1, 6, 0);     pgt(0, -50, 20, 200, 1);
              peq(30, 22000, 2, 80, 0, -2, 300, 1, 0, 2500, 1, 0, 8000, 0, 0); ) :                                                      // Bass DI (OB)
  p == 7  ? ( pmst(0, 0, 1, 100, 0, 0, 1); pboth(-16, 2, 20, 600, 0, -2.4, 0, 6000, 1, 6, -1);    pgt(0, -50, 15, 300, 1); peq0(); ) :   // Gentle Programme Bus (OB)
  p == 8  ? ( pmst(1, 0, 1, 100, 0, 0, 1); pboth(-28, 3, 5, 180, 0, 5.7, 0, 6000, 1, 6, -3);     pgt(0, -50, 20, 200, 1);
              peq(80, 22000, 0, 100, 0, 0, 600, 1, 1.5, 3500, 1, 1, 12000, 0, 1); ) :                                                   // Vocal Compressor (Duplex)
  p == 9  ? ( pmst(1, 0, 1, 100, 0, 0, 1); pboth(-30, 6, 0.5, 80, 0, -4.0, 1, 6500, 1, 6, 0);    pgt(0, -50, 20, 200, 1); peq0(); ) :   // De-esser (split) (Duplex)
  p == 10 ? ( pmst(1, 2, 0, 100, 0, 0, 1); pch(6, -22, 2.5, 15, 250, 0, 0.0, 0, 6000, 1, 6, 0); pch(18, -32, 4, 5, 150, 0, 1.0, 0, 6000, 1, 6, 0);
              pgt(0, -50, 20, 200, 1); peq0(); ) :                                                                                      // M-S Glue (sides held) (Duplex)
  p == 11 ? ( pmst(1, 1, 0, 100, 0, 0, 1); pboth(-22, 3, 8, 200, 1, 1.4, 0, 6000, 1, 6, -1);       pgt(0, -50, 20, 200, 1); peq0(); ) :   // Dual Mono Pair (Duplex)
  p == 12 ? ( pmst(1, 0, 1, 100, 0, 1, 1); pboth(-12, 20, 0.3, 60, 0, -4.5, 0, 6000, 1, 6, -1);  pgt(0, -50, 20, 200, 1); peq0(); ) :   // Brickwall Safety (Duplex)
  p == 13 ? ( pmst(0, 0, 1, 100, 0, 0, 1); pboth(-20, 3, 5, 250, 0, 0, 0, 6000, 1, 6, 0);        pgt(0, -50, 20, 200, 1); peq0();       // Reset all to defaults
              slider37 = 1; );
  p >= 1 && p <= 13 ? ( k = 1; loop(53, (k != 37 || p == 13) ? ui_auto(k); k += 1; ); );
);
// Duplex's presets are OB Q's DUPLEX ones (8 - 12), then Reset all to defaults (13)
function load_preset(p) ( p >= 1 && p <= 6 ? load_old(p <= 5 ? p + 7 : 13); );

// OB voicing: VCA saturation drive (rise per dB of GR, level relative to the threshold), input / output transformer
// drive, detector RMS time, slow release stage (x the RELEASE time, share of the gain reduction it holds)
SATK = 0.06; SATR = 0.18; XIK = 1.0; XOK = 1.1; DOMS = 0.005; SLR = 2; SLW = 0.6;
in_init();
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
gdet_c = 1 - exp(-1 / (0.006 * srate));
gatt_c = 1 - exp(-1 / (0.0005 * srate));           // gate opens in 0.5 ms
do_c = 1 - exp(-1 / (DOMS * srate));              // OB detector: RMS
dd_c = 1 - exp(-1 / (0.003 * srate));              // DUPLEX detector: RMS part, 3 ms
dd_hold = floor(0.012 * srate); dd_fall = exp(-1 / (0.02 * srate));   // DUPLEX detector: peak part, 12 ms hold, 20 ms fall
off_c = 1 - exp(-1 / (0.01 * srate));              // IN switched out: the gain eases back in 10 ms
xs_c = 1 - exp(-1 / (0.01 * srate));               // SPLIT / wide, gain and XFMR cross-fades: 10 ms
lim_r = 1 - exp(-1 / (0.05 * srate));
sm = 1 - exp(-1 / (0.03 * srate));
sat_b = 0.12;                                      // VCA saturation bias (even harmonics)
xf_b = 0.1; xf_lc = 1 - exp(-2 * $pi * 150 / srate); xf_hc = 1 - exp(-2 * $pi * min(19000, srate * 0.42) / srate);
xf_cb = xf_b - 4 / 27 * xf_b ^ 3; xf_sl = 1 - 4 / 9 * xf_b * xf_b;   // the soft clipper: rest point and slope at the bias
P1.p_init(); P2.p_init();
TIL.xf_init(); TIR.xf_init(); TOL.xf_init(); TOR.xf_init();
TOL.lm.bq_set(2, 220, 0.7, 0.8); TOR.lm.bq_set(2, 220, 0.7, 0.8);   // output transformer: a little low-mid weight
ob_trim = 10 ^ (-1.9 / 20);                 // OB: level-matched to DUPLEX at Init (pink noise, -21 dBFS)
dkr = 1 / (0.012 * srate);                         // MODEL / MODE change: 12 ms out, 12 ms in
!ui_dflt ? ui_thm = 5; !ui_dflt ? ui_hw = 1;                              // fixed faceplate
// OB face colours
PNL = 0x2C2C2E; INKC = 0xEDE6D8; BRN = 0x5C3A22; BRNL = 0x7A4E2E; ORG = 0xE8782A; YEL = 0xF0C030;
// DUPLEX face colours: grey panel, black print, green; pointer colours: compressor, gain, de-ess, limit
DPNL = 0xA9ACA7; INKD = 0x1C201E; GRN = 0x2E7A4C; GRND = 0x1E5A36;
CAP_C = 0xF2F2EE; CAP_G = 0xF2F2EE; CAP_D = 0x2FC46A; CAP_L = 0xE8402E;
eng = 1; emd = slider2; dk = 1; dst = 0; xw = slider35 >= 0.5 && !eng;
update();
mix_s = mix_t;


// ================= EQ (the Board EQ engine, names q_..., sliders 38 - 53) =================
// one-pole high-pass (the third pole of the 18 dB HPF)
function q_hp1(x) instance(x1, y1) ( y1 = q_hp1_a * (x - x1) + q_hp1_b * y1; x1 = x; y1; );
function q_hp1set(f) local(k) ( k = tan($pi * min(f, srate * 0.45) / srate); q_hp1_a = 1 / (1 + k); q_hp1_b = (1 - k) / (1 + k); );

// one channel's chain
function q_chain(x) instance() local(y) (
  q_hp_on ? x = this.h1.q_hp1(this.h2.bq_run(x));
  q_eq_on ? (
    x = this.lf.bq_run(x); q_lfx ? x = this.lx.bq_run(x);
    x = this.lm.bq_run(x); x = this.hm.bq_run(x);
    x = this.hf.bq_run(x); q_hfx ? x = this.hx.bq_run(x);
  );
  y = this.lp.bq_run(x);                     // the LPF always runs (primed) and is faded in / out, never switched
  q_bd_lpw >= 1 ? x = y : q_bd_lpw > 0 ? x += (y - x) * q_bd_lpw;
  x;
);

function q_setch() instance() (
  q_hp_on ? this.h2.bq_set(1, slider38, 1, 0);
  this.lp.bq_set(0, q_bd_lpf, 0.707, 0);     // q_bd_lpf: the LPF frequency, glided in q_proc
  // proportional Q on the black card
  this.lf.bq_set(slider42 ? 2 : 4, slider41, slider42 ? (q_blk ? 0.6 + abs(slider40) / 15 * 0.9 : 0.55) : (q_blk ? 1.15 : 0.6), slider40);
  this.lm.bq_set(2, slider44, slider45 * (q_blk ? 0.6 + abs(slider43) / 15 * 1.2 : 0.7), slider43);
  this.hm.bq_set(2, slider47, slider48 * (q_blk ? 0.6 + abs(slider46) / 15 * 1.2 : 0.7), slider46);
  this.hf.bq_set(slider51 ? 2 : 3, slider50, slider51 ? (q_blk ? 0.6 + abs(slider49) / 15 * 0.9 : 0.55) : (q_blk ? 1.15 : 0.6), slider49);
  // the black card's shelves: a small opposite dip just inside the corner
  q_lfx ? this.lx.bq_set(2, slider41 * 2.2, 1.2, -slider40 * 0.12);
  q_hfx ? this.hx.bq_set(2, slider50 * 0.45, 1.2, -slider49 * 0.12);
);

function q_update() local(b, q_cs) (
  q_cs = 0; b = 1; loop(16, q_cs += slider(b + 37) * (b * 7.31 + 1); b += 1; );
  q_cs != q_last_cs ? (
    q_last_cs = q_cs;
    q_hp_on = slider38 > 20.5; q_lp_on = slider39 < 21990; q_eq_on = slider52; q_blk = slider53;
    q_lfx = q_blk && !slider42; q_hfx = q_blk && !slider51;
    q_hp1set(slider38);
    q_CL.q_setch(); q_CR.q_setch();
  );
);

q_bd_lpf = min(slider39, srate * 0.45); q_bd_lpk = 1 - exp(-16 / (0.02 * srate)); q_bd_lpn = 0;   // LPF glide (~20 ms)
q_last_cs = -1; q_update();
q_bd_lpw = q_lp_on; q_bd_lpxs = 1 / (0.02 * srate);   // LPF on / off fade: 20 ms

function q_proc(cb_inl, cb_inr) (
  q_bd_lpw = q_lp_on ? min(q_bd_lpw + q_bd_lpxs, 1) : max(q_bd_lpw - q_bd_lpxs, 0);
  q_bd_lpt = min(slider39, srate * 0.45);
  q_bd_lpf != q_bd_lpt ? ( (q_bd_lpn += 1) >= 16 ? ( q_bd_lpn = 0; q_bd_lpf *= (q_bd_lpt / q_bd_lpf) ^ q_bd_lpk; abs(q_bd_lpf - q_bd_lpt) < 0.0005 * q_bd_lpt ? q_bd_lpf = q_bd_lpt;
    q_CL.lp.bq_set(0, q_bd_lpf, 0.707, 0); q_CR.lp.bq_set(0, q_bd_lpf, 0.707, 0); ); );
  q_out_l = q_CL.q_chain(cb_inl); q_out_r = q_CR.q_chain(cb_inr);
);
q_ord = slider5;
GNG = 60000;   // LINK ganging: last seen values of the two channels
rs_f = 1; rs_req = 0;                                       // no resume fade on load
ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
q_update();
q_ord = slider5;
update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(5, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 5 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
// resume after REAPER's bypass (or any gap in processing): the filters and detectors hold stale audio, so @sample
// fades in from the dry input over 15 ms
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? rs_req = 1;
rs_last = rs_now;
rs_c = 1 / (0.015 * srate);
q_update();
q_ord = slider5;
update();
dst == 0 && slider2 != emd ? dst = 1;   // MODEL / MODE change: duck, swap at silence, fade in
eng == 0 ? ( P1.p_blk(); P2.p_blk(); TIL.c.clp_tidy(); TIR.c.clp_tidy(); TOL.c.clp_tidy(); TOR.c.clp_tidy(); );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
rw_l = spl0; rw_r = spl1;
rs_req ? ( rs_req = 0; rs_f = 0; );
in_process(spl0, spl1);
!q_ord ? ( q_proc(in_l, in_r); in_l = q_out_l; in_r = q_out_r; );   // EQ first
dl = in_l; dr = in_r;
// OB: input transformer (cross-faded in / out with XFMR, 10 ms)
xw += ((xfm_t && !eng) - xw) * xs_c;
xw > 0.00001 ? ( tl = TIL.xf_run(dl, XIK, 1.04); tr = TIR.xf_run(dr, XIK, 1.04); xl = dl + (tl - dl) * xw; xr = dr + (tr - dr) * xw; ) : ( xl = dl; xr = dr; );
emd == 2 ? ( x1 = 0.5 * (xl + xr); x2 = 0.5 * (xl - xr); ) : ( x1 = xl; x2 = xr; );
// OB: gate (expander) on each path
eng == 0 ? (
  gv1 = P1.p_glv(x1); gv2 = P2.p_glv(x2);
  lnk ? ( gv1 = gv2 = max(gv1, gv2); );
  ga1 = P1.p_gate(gv1); ga2 = P2.p_gate(gv2);
  x1 *= 10 ^ (ga1 / 20); x2 *= 10 ^ (ga2 / 20);
) : ( ga1 = ga2 = 0; );
// compressor: the detector hears the gated signal
v1 = P1.p_det(x1); v2 = P2.p_det(x2);
lnk ? ( v1 = v2 = max(v1, v2); );
P1.p_gain(v1); P2.p_gain(v2);
y1 = P1.p_apply(x1); y2 = P2.p_apply(x2);
eng == 0 ? ( y1 = P1.p_sat(y1); y2 = P2.p_sat(y2); );
y1 *= P1.mks; y2 *= P2.mks;
// limiter
g1 = P1.p_limt(y1); g2 = P2.p_limt(y2);
lnk ? ( g1 = g2 = min(g1, g2); );
y1 *= g1; y2 *= g2;
emd == 2 ? ( wl = y1 + y2; wr = y1 - y2; ) : ( wl = y1; wr = y2; );
// OB: output transformer
xw > 0.00001 ? ( tl = TOL.xo_run(wl); tr = TOR.xo_run(wr); wl += (tl - wl) * xw; wr += (tr - wr) * xw; );
// meters (mailboxes: the audio thread raises them, the panel reads and clears them)
gm1_disp = min(gm1_disp, P1.e + 20 * log10(g1)); gm2_disp = min(gm2_disp, P2.e + 20 * log10(g2));
lm1_disp = max(lm1_disp, g1 < 0.999); lm2_disp = max(lm2_disp, g2 < 0.999);
gtm_disp = min(gtm_disp, min(ga1, ga2));
// mix + output stage
mix_s += (mix_t - mix_s) * sm;
oL = dl + (wl - dl) * mix_s; oR = dr + (wr - dr) * mix_s;
q_ord ? ( q_proc(oL, oR); oL = q_out_l; oR = q_out_r; );   // EQ after
// MODEL / MODE change: duck the output, swap the engine at the silent point, fade back in
dst == 1 ? ( dk -= dkr; dk <= 0 ? (
    dk = 0; eng = 1; emd = slider2; update();
    P1.ef = P1.es = P1.e; P2.ef = P2.es = P2.e; P1.sust = P2.sust = 0;
    xw = xfm_t && !eng; dst = 2; ); ) :
dst == 2 ? ( dk += dkr; dk >= 1 ? ( dk = 1; dst = 0; ); );
dst ? ( dkg = dk * dk * (3 - 2 * dk); oL *= dkg; oR *= dkg; );
oL = ostL.ost_band(oL * in_comp); oR = ostR.ost_band(oR * in_comp);
ost_out(oL, oR);
spl0 = ost_l; spl1 = ost_r;
pkI = max(pkI, max(abs(dl), abs(dr)));
pkO = max(pkO, max(abs(spl0), abs(spl1)));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f); spl0 = rw_l + (spl0 - rw_l) * rs_s; spl1 = rw_r + (spl1 - rw_r) * rs_s; );   // resume fade

@gfx 900 512
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_begin(900, 512);
ui_swb();   // drawn off-screen, then shown with the units in signal order (ORDER)

// ---------- shared ----------
// LINK (DUAL / M-S): the two channels' controls are ganged - turning one moves the other by the same amount
// (dB controls by the same dB, times and frequencies by the same factor), switches copy across; offsets stay.
function gang_val(k, v) ( k == 1 ? min(max(v, -40), 0) : k == 2 ? min(max(v, 1), 20) : k == 3 ? min(max(v, 0.1), 50) :
  k == 4 ? min(max(v, 20), 3000) : k == 6 ? min(max(v, -10), 20) : k == 8 ? min(max(v, 2000), 12000) :
  k == 10 ? min(max(v, 0), 12) : min(max(v, -24), 0); );
function gang() local(k, va, vb, pa, pb, mul, nv) (
  slider3 && slider2 != 0 && gang_ok ? (
    k = 0;
    loop(12,
      va = slider(6 + k); vb = slider(18 + k); pa = GNG[k]; pb = GNG[16 + k];
      mul = k == 3 || k == 4 || k == 8;
      va != pa && vb == pb ? (
        nv = k == 0 || k == 5 || k == 7 || k == 9 ? va : gang_val(k, mul ? vb * va / max(pa, 0.0001) : vb + va - pa);
        slider(18 + k) = nv; ui_auto(18 + k);
      ) : vb != pb && va == pa ? (
        nv = k == 0 || k == 5 || k == 7 || k == 9 ? vb : gang_val(k, mul ? va * vb / max(pb, 0.0001) : va + vb - pb);
        slider(6 + k) = nv; ui_auto(6 + k);
      );
      k += 1;
    );
  );
  k = 0; loop(12, GNG[k] = slider(6 + k); GNG[16 + k] = slider(18 + k); k += 1; );
  gang_ok = 1;
);
gang();
// the meters' mailboxes, read and cleared here
lmd1 = lm1_disp; lmd2 = lm2_disp; lm1_disp = 0; lm2_disp = 0;
gd1 = min(gm1_disp, gd1 * 0.82); gd2 = min(gm2_disp, gd2 * 0.82); gm1_disp = 0; gm2_disp = 0;
gtd = min(gtm_disp, gtd * 0.8); gtm_disp = 0;
#pmenu = "Vocal Compressor|De-esser (split)|M-S Glue (sides held)|Dual Mono Pair|Brickwall Safety";
pk_pextra = "Reset all to defaults";   // the house preset display: PRESETS, prev / next, LCD (click it for the list)
function qhz(f) ( f >= 1000 ? sprintf(#qv, "%.1fk", f / 1000) : sprintf(#qv, "%.0f", f); #qv; );

// =====================================================================================================
// The DUPLEX face (grey / green), as on OB Q
// =====================================================================================================
// a section heading in the EQ strip with its accent colour
function qsec(x0, x1, lbl, col) ( ui_col(col); gfx_rect(x0 * sc, 376 * sc, (x1 - x0) * sc, 2 * sc); dy_lbl((x0 + x1) * 0.5, 381, lbl, 0.85); );
function hz_txt(dst, f) ( f >= 1000 ? sprintf(dst, "%.1f kHz", f / 1000) : sprintf(dst, "%.0f Hz", f); );
// one channel (unscaled x = the section's left edge)
function chan(x, base, k, name, role) local(r) (
  pk_box((x - 2) * sc, 72 * sc, 328 * sc, 252 * sc, GRND, ""); ui_col(GRN); gfx_rect((x - 2) * sc, 72 * sc, 328 * sc, 22 * sc);
  gfx_setfont(6, "Trebuchet MS", 14 * sc, 'b'); ui_col(0xF2F2EE); gfx_x = (x + 6) * sc; gfx_y = 75 * sc; gfx_drawstr(name);
  gfx_setfont(4); ui_cola(0xF2F2EE, 0.8); gfx_x = (x + 120) * sc; gfx_y = 79 * sc; gfx_drawstr(role);
  pk_ledbtn((x + 282) * sc, 98 * sc, 30 * sc, 22 * sc, slider(base), dy_grn) ? ( slider(base) = 1 - slider(base); ui_auto(base); );
  dy_lbl(x + 266, 104, "IN", 0.8);
  // compressor row
  sprintf(#v, "%.1f dB", slider(base + 1)); dy_knob(x + 32, 150, 18, base + 1, -40, 0, -20, 0, CAP_C, "THRESH", #v);
  r = slider(base + 2); r >= 19.95 ? strcpy(#v, "INF:1") : sprintf(#v, "%.1f:1", r);
  dy_knob(x + 96, 150, 18, base + 2, 1, 20, 3, 1, CAP_C, "RATIO", #v);
  slider(base + 5) ? strcpy(#v, "AUTO") : sprintf(#v, "%.1f ms", slider(base + 3));
  dy_knob(x + 160, 150, 18, base + 3, 0.1, 50, 5, 1, CAP_C, "ATTACK", #v);
  slider(base + 5) ? strcpy(#v, "AUTO") : sprintf(#v, "%.0f ms", slider(base + 4));
  dy_knob(x + 224, 150, 18, base + 4, 20, 3000, 250, 1, CAP_C, "RELEASE", #v);
  sprintf(#v, "%+.1f dB", slider(base + 6)); dy_knob(x + 288, 150, 18, base + 6, -10, 20, 0, 0, CAP_G, "GAIN", #v);
  // de-ess + limit row
  hz_txt(#v, slider(base + 8)); dy_knob(x + 32, 240, 18, base + 8, 2000, 12000, 6000, 1, CAP_D, "DS FREQ", #v);
  sprintf(#v, "+%.1f dB", slider(base + 10)); dy_knob(x + 90, 240, 18, base + 10, 0, 12, 6, 0, CAP_D, "AMOUNT", #v);
  slider(base + 11) < -0.05 ? sprintf(#v, "%.1f dB", slider(base + 11)) : strcpy(#v, "OFF");
  dy_knob(x + 148, 240, 18, base + 11, -24, 0, 0, 0, CAP_L, "LIMIT", #v);
  pk_led((x + 174) * sc, 218 * sc, 3.5 * sc, k == 0 ? lmd1 : lmd2, dy_red);
  dy_btn(x + 188, 220, slider(base + 5), dy_amb, "AUTO") ? ( slider(base + 5) = 1 - slider(base + 5); ui_auto(base + 5); );
  dy_btn(x + 231, 220, slider(base + 7), CAP_D, "DE-ESS") ? ( slider(base + 7) = 1 - slider(base + 7); ui_auto(base + 7); );
  dy_btn(x + 274, 220, slider(base + 9), dy_grn, "SPLIT") ? ( slider(base + 9) = 1 - slider(base + 9); ui_auto(base + 9); );
);
function dup_face() local(k_) (
  dy_ink = INKD; dy_bg = DPNL; dy_kst = 3; dy_nov = 1; dy_ntick = 11;   // values float only while a knob is touched
  fh = 504;
  ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
  pk_chassis(8 * sc, 4 * sc, 884 * sc, fh * sc, DPNL);
  ui_col(dy_ink); gfx_circle(40 * sc, 34 * sc, 14 * sc, 1, 1);
  gfx_setfont(4); ui_col(DPNL); ui_text(40 * sc, 29 * sc, "GFX");
  gfx_setfont(6, "Trebuchet MS", 24 * sc, 'b'); ui_col(dy_ink); gfx_x = 62 * sc; gfx_y = 20 * sc; gfx_drawstr("DUPLEX"); ver_tag("v3", 16, 0, 0);
  gfx_setfont(4); ui_cola(dy_ink, 0.6); gfx_x = 176 * sc; gfx_y = 22 * sc; gfx_drawstr("COMP - DE-ESS");
  gfx_x = 176 * sc; gfx_y = 36 * sc; gfx_drawstr("LIMIT");
  k_ = pk_preset(544 * sc, 15 * sc, 270 * sc, 34 * sc, pr_cur, #pmenu);   // JG: moved right into the old MODEL keys' place
  k_ > 0 ? ( prs_dirty = (k_); pr_cur = k_ > 5 ? 0 : k_; );
  ui_size_picker(828 * sc, 22 * sc);
  // ORDER: in the top bar; the unit the signal meets first is shown on top
  ui_orderkey(388 * sc, 20 * sc, 146 * sc, 26 * sc, 5, "COMPRESSOR > EQ", "EQ > COMPRESSOR", 4);
  ui_col(GRN); gfx_rect(14 * sc, 60 * sc, 872 * sc, 4 * sc);
  ui_col(INKD); gfx_rect(14 * sc, 64 * sc, 872 * sc, 1 * sc);

  ui_swu(slider5 ? 492 - 327 : 0);
  chan(20, 6, 0, "CHANNEL A", slider2 == 0 ? "BOTH SIDES" : slider2 == 1 ? "LEFT" : "MID");
  dy_grrow(54, 300, gd1);
  slider2 == 0 ? (
    pk_box(352 * sc, 72 * sc, 328 * sc, 252 * sc, GRND, ""); ui_col(GRN); gfx_rect(352 * sc, 72 * sc, 328 * sc, 22 * sc);
    gfx_setfont(6, "Trebuchet MS", 14 * sc, 'b'); ui_col(0xF2F2EE); gfx_x = 360 * sc; gfx_y = 75 * sc; gfx_drawstr("CHANNEL B");
    dy_lbl(516, 170, "STEREO MODE", 0.8);
    dy_lbl(516, 186, "CHANNEL A RUNS BOTH SIDES", 0.5);
    dy_lbl(516, 202, "(switch MODE to DUAL or M-S to use B)", 0.4);
    pk_led(500 * sc, 230 * sc, 3.5 * sc, lmd2, dy_red);
  ) : (
    chan(354, 18, 1, "CHANNEL B", slider2 == 1 ? "RIGHT" : "SIDE");
  );
  dy_grrow(388, 300, gd2);

  // ---------- MASTER ----------
  pk_box(686 * sc, 72 * sc, 196 * sc, 252 * sc, GRND, ""); ui_col(GRN); gfx_rect(686 * sc, 72 * sc, 196 * sc, 22 * sc);
  gfx_setfont(6, "Trebuchet MS", 14 * sc, 'b'); ui_col(0xF2F2EE); gfx_x = 694 * sc; gfx_y = 75 * sc; gfx_drawstr("MASTER");
  dy_lbl(784, 102, "MODE", 0.8);
  dy_btn(716, 116, slider2 == 0, dy_grn, "STEREO") ? ( slider2 = 0; ui_auto(2); );
  dy_btn(764, 116, slider2 == 1, dy_grn, "DUAL") ? ( slider2 = 1; ui_auto(2); );
  dy_btn(812, 116, slider2 == 2, dy_grn, "M-S") ? ( slider2 = 2; ui_auto(2); );
  dy_btn(716, 196, slider3, dy_grn, "LINK") ? ( slider3 = 1 - slider3; ui_auto(3); );
  dy_btn(764, 196, slider36, dy_amb, "FIRM") ? ( slider36 = 1 - slider36; ui_auto(36); );
  sprintf(#v, "WET %.0f", slider4); dy_knob(846, 212, 16, 4, 0, 100, 100, 0, CAP_G, "MIX", #v);
  mI.ui_ledm(712 * sc, 296 * sc, 120 * sc, 9 * sc, pkI);
  mO.ui_ledm(712 * sc, 309 * sc, 120 * sc, 9 * sc, pkO);
