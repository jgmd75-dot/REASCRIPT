desc:CH34 [channel strip] (GFX)
//tags: channel strip preamp drive parametric eq compressor limiter vca soft knee sidechain
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui, gfx-panel, gfx-dyn and gfx-clip (.jsfx-inc) in the same folder.
//
// CH34. A vintage American studio strip in one rack: a warm analogue PREAMP (the input stage of a classic 70s
// analogue delay), a 3-band parametric EQ and a VCA COMP / limiter (the sound is designed from scratch). The preamp
// always comes first; the ORDER key swaps the EQ and the COMP. Linked stereo: one set of controls and one compressor
// detector for both sides.
//
//   PREAMP  DRIVE -24 .. +24 dB (0): the input trim and the drive in one. Below 0 it turns the strip's input down,
//           above 0 it pushes the preamp's gently lopsided transistor stage harder (house clipper: ADAA, drive-tracking
//           pre-filter and knee). Not level-compensated: it is the gain into the strip. With the preamp's IN key out
//           DRIVE is a clean trim. SC HPF (OFF, 20 .. 300 Hz): only what is above it goes through the transistor stage;
//           the lows go round it clean and are added back, so the bass stays solid and unmuddied as it is driven. It
//           rises with DRIVE, an octave for every 12 dB above 0 (x4 at +24 dB). In: a 20 Hz coupling high-pass, the transistor stage, a little low-mid warmth (+1 dB
//           shelf at 180 Hz) and the delay's input filter (a 13 kHz roll-off).
//   EQ      three peaking bands. FREQ stepped as on the hardware:
//             LOW  31, 62, 125, 250, 500 Hz, 1, 2, 4 kHz      MID  62 Hz .. 8 kHz      HIGH  125 Hz .. 16 kHz
//           WIDTH (Q) 0.25 .. 4 and GAIN -20 .. +20 dB sweep. Every change glides (80 ms): no zipper, no click.
//   COMP    a feed-forward VCA compressor with a true-RMS detector (linked stereo): THRESHOLD -40 .. 0 dBFS, RATIO
//           1:1 .. 20:1 and INF, ATTACK 0.1 .. 100 ms, RELEASE 20 ms .. 2 s, SOFT KNEE (10 dB), AUTO (program-dependent
//           attack and release; it overrides ATTACK and RELEASE), and MAKEUP -20 .. +20 dB.
//   ORDER   EQ > COMP or COMP > EQ. A change runs the new chain alongside the old one for 40 ms, then crossfades into it
//           over 25 ms: no click. IN keys fade each module in / out (10 ms).
//   DRIFT   (0 - 100 %, 50 % = standard, 0 = none): "voltage, drive, bias" - the supply sags with what the preamp
//           draws and wanders slowly (the preamp's headroom breathes), the drive wanders a little, and the bias wanders:
//           the preamp's asymmetry and the compressor VCA's control voltage (its threshold, by a few tenths of a dB).
//   OUTPUT -12 .. +12 dB, then PEAK LIMIT: a fast peak limiter, the last thing in the strip (its ceiling -20 .. 0 dBFS,
//           on its LIMIT key; instant attack, 60 ms release, then a hard ceiling on the sample peaks). The house output stage passes straight through (a mix tool: no clip).
//   VFD / MATRIX  the panel's look (VFD charcoal and orange; MATRIX battleship grey with cream). The look only.
//   PRESETS 12 (Init + 11) plus Reset all to defaults. A preset sets the modules (keys, knobs) and the order; DRIVE,
//           OUTPUT, DRIFT and the look are left alone (Reset all restores them too).

slider1:0<-24,24,0.1>-Drive (dB)
slider2:0<0,1,1{EQ then Comp,Comp then EQ}>-Order
slider3:1<0,1,1{Out,In}>-Preamp in
slider4:1<0,1,1{Out,In}>-EQ in
slider5:2<0,7,1{31 Hz,62 Hz,125 Hz,250 Hz,500 Hz,1 kHz,2 kHz,4 kHz}>-Low freq
slider6:1<0.25,4,0.01>-Low width (Q)
slider7:0<-20,20,0.1>-Low gain (dB)
slider8:4<0,7,1{62 Hz,125 Hz,250 Hz,500 Hz,1 kHz,2 kHz,4 kHz,8 kHz}>-Mid freq
slider9:1<0.25,4,0.01>-Mid width (Q)
slider10:0<-20,20,0.1>-Mid gain (dB)
slider11:5<0,7,1{125 Hz,250 Hz,500 Hz,1 kHz,2 kHz,4 kHz,8 kHz,16 kHz}>-High freq
slider12:1<0.25,4,0.01>-High width (Q)
slider13:0<-20,20,0.1>-High gain (dB)
slider14:1<0,1,1{Out,In}>-Comp in
slider15:-20<-40,0,0.1>-Threshold (dBFS)
slider16:3<1,21,0.1>-Ratio (21 = inf)
slider17:10<0.1,100,0.1>-Attack (ms)
slider18:200<20,2000,1>-Release (ms)
slider19:0<0,1,1{Off,On}>-Auto
slider20:1<0,1,1{Off,On}>-Soft knee
slider21:0<-20,20,0.1>-Makeup (dB)
slider22:-1<-20,0,0.1>-Peak limit (dBFS)
slider23:0<0,1,1{Off,On}>-Peak limit on
slider24:0<0,300,1>-SC HPF (Hz, under 20 = off)
slider25:0<-12,12,0.1>-Output (dB)
slider26:50<0,100,1>-Drift (%)
slider27:0<0,1,1{VFD,Matrix}>-Look
slider28:prs_sel=0<0,12,1{No preset,Init,Warm Vocal,Bright Vocal,Bass DI,Kick Punch,Snare Crack,Acoustic Guitar,Electric Guitar,Drum Bus,Mix Bus Glue,Squashed Room,Broadcast Voice}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-clip.jsfx-inc

@init
#ui_man = "gfx-ch34";                                 // the ? pop-up links to this manual
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;             // gfx-clip: ADAA, pre-filter, knee tracking (the preamp)

function cs_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function cs_op(f) ( 1 - exp(-2 * $pi * min(f, 0.49 * srate) / srate); );
function cs_tc(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );

function cs_lf(i) ( i == 0 ? 31 : i == 1 ? 62 : i == 2 ? 125 : i == 3 ? 250 : i == 4 ? 500 : i == 5 ? 1000 : i == 6 ? 2000 : 4000; );
function cs_mf(i) ( i == 0 ? 62 : 125 * 2 ^ (i - 1); );             // MID: 62 Hz, then 125 Hz .. 8 kHz
// coefficients of the three bands (shared by both sides and both chain sets): EQC[band * 5 + k]
EQC = 100;
function cs_peak(band, f, q, gdb) local(A, w, cw, al, n, o) (
  o = EQC + band * 5;
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al / A;
  o[0] = (1 + al * A) / n; o[1] = -2 * cw / n; o[2] = (1 - al * A) / n; o[3] = -2 * cw / n; o[4] = (1 - al / A) / n;
);

// the EQ glide (every 32 samples): frequencies and widths on a log scale, gains in dB; coefficients recomputed
// only while something moves
function cs_equpd(k) local(m) (
  m = abs(cs_lf_ - cs_lft) + abs(cs_mf_ - cs_mft) + abs(cs_hf_ - cs_hft) + abs(cs_lq_ - cs_lqt) + abs(cs_mq_ - cs_mqt) + abs(cs_hq_ - cs_hqt)
    + abs(cs_lg_ - cs_lgt) + abs(cs_mg_ - cs_mgt) + abs(cs_hg_ - cs_hgt);
  m > 0.0001 || k >= 1 ? (
    cs_lf_ *= (cs_lft / cs_lf_) ^ k; cs_mf_ *= (cs_mft / cs_mf_) ^ k; cs_hf_ *= (cs_hft / cs_hf_) ^ k;
    cs_lq_ *= (cs_lqt / cs_lq_) ^ k; cs_mq_ *= (cs_mqt / cs_mq_) ^ k; cs_hq_ *= (cs_hqt / cs_hq_) ^ k;
    cs_lg_ += (cs_lgt - cs_lg_) * k; cs_mg_ += (cs_mgt - cs_mg_) * k; cs_hg_ += (cs_hgt - cs_hg_) * k;
    cs_peak(0, cs_lf_, cs_lq_, cs_lg_); cs_peak(1, cs_mf_, cs_mq_, cs_mg_); cs_peak(2, cs_hf_, cs_hq_, cs_hg_);
  );
);
// the SC HPF in front of the drive (12 dB/oct, Q 0.707): SCC[0..4]
SCC = 140;
function cs_schp(f) local(w, cw, al, n) (
  w = 2 * $pi * min(max(f, 10), 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * 0.70710678); n = 1 + al;
  SCC[0] = (1 + cw) * 0.5 / n; SCC[1] = -(1 + cw) / n; SCC[2] = SCC[0]; SCC[3] = -2 * cw / n; SCC[4] = (1 - al) / n;
);

// ---------- the order: P E C (0) or P C E (1) ----------
CS_PERM = 0;
CS_PERM[0] = 0; CS_PERM[1] = 1; CS_PERM[2] = 2;      // P E C
CS_PERM[3] = 0; CS_PERM[4] = 2; CS_PERM[5] = 1;      // P C E

// =====================================================================
// THE MODULES - each instance holds both sides' state; they read and write the pair cs_a / cs_b (left / right)
// =====================================================================
// ---- PREAMP (DRIVE is applied before it: this is the colour) ----
function pr_run() instance(hpL, hpR, wL, wR, l1L, l2L, l1R, l2R, rest, z1L, z2L, z1R, z2R) local(xl, xr, hl, hr) (
  xl = cs_a - hpL; hpL += pr_khp * (cs_a - hpL); xr = cs_b - hpR; hpR += pr_khp * (cs_b - hpR);
  // SC HPF: only what is above it goes through the transistor stage; the lows go round it, clean (always running)
  hl = SCC[0] * xl + z1L; z1L = SCC[1] * xl - SCC[3] * hl + z2L; z2L = SCC[2] * xl - SCC[4] * hl;
  hr = SCC[0] * xr + z1R; z1R = SCC[1] * xr - SCC[3] * hr + z2R; z2R = SCC[2] * xr - SCC[4] * hr;
  cs_lo = pr_sce * (xl - hl); cs_ro = pr_sce * (xr - hr); xl -= cs_lo; xr -= cs_ro;   // (faded in / out: 20 ms)
  xl = this.cL.clp_pf_run(xl); xr = this.cR.clp_pf_run(xr);
  xl = (this.cL.clp_run(xl * 0.6 + pr_b) - rest) * 1.6666667 + cs_lo;   // the transistor stage (ADAA), unity small-signal
  xr = (this.cR.clp_run(xr * 0.6 + pr_b) - rest) * 1.6666667 + cs_ro;
  wL += pr_kw * (xl - wL); xl += 0.122 * wL; wR += pr_kw * (xr - wR); xr += 0.122 * wR;   // low-mid warmth
  l1L += pr_klp * (xl - l1L); l2L += pr_klp * (l1L - l2L);              // the delay's input filter (2 poles)
  l1R += pr_klp * (xr - l1R); l2R += pr_klp * (l1R - l2R);
  cs_a = l2L * pr_out; cs_b = l2R * pr_out;
);
function pr_cfg(n) instance(rest) (
  this.cL.clp_set(2, pr_v, pr_v * 0.85, 0); this.cR.clp_set(2, pr_v, pr_v * 0.85, 0);
  this.cL.clp_kt_cfg(0.25, 0.45); this.cR.clp_kt_cfg(0.25, 0.45);
  this.cL.clp_knee(this.cL.clp_kt_block(pr_vd, srate, n)); this.cR.clp_knee(this.cR.clp_kt_block(pr_vd, srate, n));
  this.cL.clp_pf_cfg(0.45 * srate, 12000, -1, 120); this.cR.clp_pf_cfg(0.45 * srate, 12000, -1, 120);
  this.cL.clp_pf_block(pr_vd, srate, n); this.cR.clp_pf_block(pr_vd, srate, n);
  rest = this.cL.clp_crv(pr_b);
);
function pr_prime() ( this.cL.x1 = this.cR.x1 = pr_b; this.cL.ad1 = this.cR.ad1 = this.cL.clp_ad(pr_b); );
function pr_reset() instance(hpL, hpR, wL, wR, l1L, l2L, l1R, l2R, z1L, z2L, z1R, z2R) (
  hpL = hpR = wL = wR = l1L = l2L = l1R = l2R = z1L = z2L = z1R = z2R = 0;
  this.cL.clp_reset(); this.cR.clp_reset(); this.cL.clp_pf_reset(); this.cR.clp_pf_reset();
);
function pr_tidy() instance(hpL, hpR, wL, wR, l1L, l2L, l1R, l2R, z1L, z2L, z1R, z2R) (
  z1L = cs_tn(z1L); z2L = cs_tn(z2L); z1R = cs_tn(z1R); z2R = cs_tn(z2R);
  hpL = cs_tn(hpL); hpR = cs_tn(hpR); wL = cs_tn(wL); wR = cs_tn(wR);
  l1L = cs_tn(l1L); l2L = cs_tn(l2L); l1R = cs_tn(l1R); l2R = cs_tn(l2R);
  this.cL.clp_tidy(); this.cR.clp_tidy();
);

// ---- EQ: three peaking bands, transposed direct form II; states in the instance ----
function eq_bq(x, o) instance(s1, s2) local(y) ( y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y; );
function eq_run() (
  cs_a = this.h0.eq_bq(this.m0.eq_bq(this.l0.eq_bq(cs_a, EQC), EQC + 5), EQC + 10);
  cs_b = this.h1.eq_bq(this.m1.eq_bq(this.l1.eq_bq(cs_b, EQC), EQC + 5), EQC + 10);
);
function eq_reset() (
  this.l0.s1 = this.l0.s2 = this.m0.s1 = this.m0.s2 = this.h0.s1 = this.h0.s2 = 0;
  this.l1.s1 = this.l1.s2 = this.m1.s1 = this.m1.s2 = this.h1.s1 = this.h1.s2 = 0;
);
function eq_tidy() (
  this.l0.s1 = cs_tn(this.l0.s1); this.l0.s2 = cs_tn(this.l0.s2); this.m0.s1 = cs_tn(this.m0.s1); this.m0.s2 = cs_tn(this.m0.s2);
  this.h0.s1 = cs_tn(this.h0.s1); this.h0.s2 = cs_tn(this.h0.s2); this.l1.s1 = cs_tn(this.l1.s1); this.l1.s2 = cs_tn(this.l1.s2);
  this.m1.s1 = cs_tn(this.m1.s1); this.m1.s2 = cs_tn(this.m1.s2); this.h1.s1 = cs_tn(this.h1.s1); this.h1.s2 = cs_tn(this.h1.s2);
);

// ---- COMP: true-RMS detector (linked), static curve (soft or hard knee), attack / release on the gain, VCA,
//      makeup ----
function cp_run() instance(ms, gdb, fst, slw, grm) local(x2, lv, ov, k, tgt, g) (
  x2 = 0.5 * (cs_a * cs_a + cs_b * cs_b);
  ms += cp_krms * (x2 - ms);                                           // the RMS average (5 ms)
  lv = 10 * log10(max(ms, 0.0000000001)) + 3.0103;                     // dB, a sine reads its peak
  ov = lv - cp_th;                                                     // over the threshold
  cp_soft ? (
    k = 5;                                                             // half the 10 dB knee
    tgt = ov <= -k ? 0 : ov >= k ? ov * cp_sl : cp_sl * sqr(ov + k) / (4 * k);
  ) : ( tgt = ov > 0 ? ov * cp_sl : 0; );
  tgt = -tgt;                                                          // the gain wanted (dB, <= 0)
  cp_auto ? (                                                          // AUTO: program-dependent
    fst += (tgt < fst ? cp_kaf : cp_krf) * (tgt - fst);                // fast path: transients
    slw += (tgt < slw ? cp_kas : cp_krs) * (tgt - slw);                // slow path: the body
    gdb = min(fst, slw) + 0.35 * (fst - min(fst, slw));
  ) : (
    gdb += (tgt < gdb ? cp_ka : cp_kr) * (tgt - gdb);
  );
  grm = min(grm, gdb);
  g = exp(0.115129255 * (gdb + cp_mk));                                // the VCA and the makeup
  cs_a *= g; cs_b *= g;
);
function cp_reset() instance(ms, gdb, fst, slw) ( ms = 0; gdb = fst = slw = 0; );
function cp_tidy() instance(ms) ( ms = cs_tn(ms); );

// ---------- one chain set: the three modules in the order o, each faded by its IN key ----------
function set_run(xl, xr, o) local(k, m, ol, or) (
  cs_a = xl; cs_b = xr; k = 0;
  loop(3,
    m = CS_PERM[o * 3 + k]; ol = cs_a; or = cs_b;
    m == 0 ? ( cs_gP > 0 ? ( this.pr.pr_run(); cs_a = ol + cs_eP * (cs_a - ol); cs_b = or + cs_eP * (cs_b - or); ); ) :
    m == 1 ? ( cs_gE > 0 ? ( this.eq.eq_run(); cs_a = ol + cs_eE * (cs_a - ol); cs_b = or + cs_eE * (cs_b - or); ); ) :
             ( cs_gC > 0 ? ( this.cp.cp_run(); cs_a = ol + cs_eK * (cs_a - ol); cs_b = or + cs_eK * (cs_b - or); ); );
    k += 1;
  );
);
function set_reset() ( this.pr.pr_reset(); this.eq.eq_reset(); this.cp.cp_reset(); );
function set_tidy() ( this.pr.pr_tidy(); this.eq.eq_tidy(); this.cp.cp_tidy(); );

// ---------- presets ----------
#cs_pm = "Init|Warm Vocal|Bright Vocal|Bass DI|Kick Punch|Snare Crack|Acoustic Guitar|Electric Guitar|Drum Bus|Mix Bus Glue|Squashed Room|Broadcast Voice";
function cs_mods(o, pi, ei, lf, lq, lg, mf, mq, mg, hf, hq, hg, ci, th, ra, at, re, au, sk, mk, pl, po, sc) (
  slider2 = o; slider3 = pi; slider4 = ei; slider5 = lf; slider6 = lq; slider7 = lg; slider8 = mf; slider9 = mq; slider10 = mg;
  slider11 = hf; slider12 = hq; slider13 = hg; slider14 = ci; slider15 = th; slider16 = ra; slider17 = at; slider18 = re;
  slider19 = au; slider20 = sk; slider21 = mk; slider22 = pl; slider23 = po; slider24 = sc;
);
function load_preset(p) local(i) (
  //       ord pre eq  lf lq   lg    mf mq   mg   hf hq   hg    cp  thr  rat  att  rel au sk mk   plim  pon sc
  p == 1  ? cs_mods(0, 1, 1, 2, 1,   0,    4, 1,   0,   5, 1,   0,    1, -20, 3,   10,  200, 0, 1, 0,   -1,   0, 0) :     // Init
  p == 2  ? cs_mods(0, 1, 1, 1, 0.5, -3,   3, 1,   3,   6, 0.5, 3.5,  1, -24, 3,   8,   180, 0, 1, 3,   -1,   1, 80) :    // Warm Vocal
  p == 3  ? cs_mods(0, 1, 1, 2, 1,   -4,   5, 1,   3,   6, 0.5, 6,    1, -22, 4,   5,   150, 0, 1, 3,   -1,   1, 100) :   // Bright Vocal
  p == 4  ? cs_mods(0, 1, 1, 1, 0.7, 4,    4, 1.2, 3,   3, 0.5, -4,   1, -24, 4,   15,  250, 0, 1, 3,   -1,   1, 0) :     // Bass DI
  p == 5  ? cs_mods(1, 1, 1, 1, 1,   6,    3, 2,   -7,  4, 1,   4,    1, -18, 6,   20,  120, 0, 0, 4,   -1,   1, 0) :     // Kick Punch
  p == 6  ? cs_mods(1, 1, 1, 3, 1.2, 4,    4, 2,   -4,  5, 1,   6,    1, -20, 5,   15,  100, 0, 0, 4,   -1,   1, 60) :    // Snare Crack
  p == 7  ? cs_mods(0, 1, 1, 3, 1,   -3,   4, 0.5, 1,   6, 0.5, 3,    1, -20, 2.5, 12,  250, 1, 1, 2,   -1,   0, 80) :    // Acoustic Guitar
  p == 8  ? cs_mods(0, 1, 1, 1, 1,   -4,   4, 0.8, 3,   5, 1,   -3,   1, -18, 3,   10,  200, 1, 1, 2,   -1,   0, 60) :    // Electric Guitar
  p == 9  ? cs_mods(0, 1, 1, 1, 0.5, 3,    4, 0.5, -3,  6, 0.5, 3,    1, -16, 4,   30,  150, 0, 1, 3,   -0.5, 1, 90) :    // Drum Bus
  p == 10 ? cs_mods(0, 1, 1, 1, 0.5, 1.5,  4, 0.3, 0,   7, 0.5, 2,    1, -14, 2,   30,  300, 1, 1, 1.5, -0.3, 1, 120) :   // Mix Bus Glue
  p == 11 ? cs_mods(0, 1, 1, 2, 0.5, 4,    5, 0.5, -4,  6, 0.5, 7,    1, -32, 21,  0.5, 80,  0, 0, 10,  -1,   1, 150) :   // Squashed Room
  p == 12 ? cs_mods(1, 1, 1, 2, 0.5, -6,   5, 0.6, 5,   5, 0.5, 3,    1, -26, 8,   2,   120, 1, 1, 6,   -1,   1, 100) :   // Broadcast Voice
  p == 13 ? ( cs_mods(0, 1, 1, 2, 1, 0, 4, 1, 0, 5, 1, 0, 1, -20, 3, 10, 200, 0, 1, 0, -1, 0, 0);
              slider1 = 0; slider25 = 0; slider26 = 50; slider27 = 0; );                      // Reset all to defaults
  i = 1; loop(27, ui_auto(i); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

// ---------- state ----------
function cs_srinit() (
  cs_sr = srate;
  pr_khp = cs_op(20); pr_kw = cs_op(180); pr_klp = cs_op(13000 * 1.27);   // (two poles: -3 dB near 13 kHz)
  cp_krms = cs_tc(5); cp_kpr = cs_tc(60);
  cp_kaf = cs_tc(2); cp_krf = cs_tc(60); cp_kas = cs_tc(30); cp_krs = cs_tc(900);
  cs_fst = 1 / (0.01 * srate);                        // IN keys: 10 ms
  cs_xst = 1 / (0.025 * srate);
  cs_sst = 1 / (0.02 * srate);                        // SC HPF in / out: 20 ms                       // the order crossfade: 25 ms
  cs_gsm = 1 - exp(-1 / (0.015 * srate));
  cs_eqk = 1 - exp(-32 / (0.08 * srate));             // the EQ glide: 80 ms
  cs_eat = cs_tc(30); cs_ert = cs_tc(1200);           // the supply: draw / recovery
  ost_init(0);
);
cs_srinit();
in_init();
dV.drift_init(0.8 + rand(1) * 0.4); dD.drift_init(0.8 + rand(1) * 0.4); dB.drift_init(0.8 + rand(1) * 0.4); dC.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
cs_schp(20);
cs_pg = 1;
sA.set_reset(); sB.set_reset();
cs_cur = 0; cs_oCur = cs_oNew = slider2 >= 0.5; cs_xf = 0;
cs_gP = slider3 >= 0.5; cs_gE = slider4 >= 0.5; cs_gC = slider14 >= 0.5;
cs_snap = 1;

ui_thm = 5; ui_hw = 1;                                // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );                // new instances open in Medium, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
  0
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@block
prs_chk();
srate != cs_sr ? cs_srinit();
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);                // the house output stage: straight through (a mix tool)
drift_macro(slider26);
// the order: a change starts the crossfade into the other set (warmed up first); one more change waits for it
cs_ot = slider2 >= 0.5;
cs_xf <= 0 && cs_ot != cs_oCur ? (
  cs_snap ? cs_oCur = cs_ot : (
    cs_oNew = cs_ot; cs_xf = 0.000001; cs_wu = floor(0.04 * srate);
    cs_cur ? ( sA.set_reset(); cs_prime = 1; ) : ( sB.set_reset(); cs_prime = 2; );
  );
);
cs_tP = slider3 >= 0.5; cs_tE = slider4 >= 0.5; cs_tK = slider14 >= 0.5;
cs_gl = cs_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));          // knob glides: 30 ms
// DRIFT: voltage (a slow wander and the sag), drive, bias
cs_n = samplesblock / srate;
cs_vv = dV.drift_tick(0.04 * dm_s * cs_n); cs_vd = dD.drift_tick(0.06 * dm_s * cs_n);
cs_vb = dB.drift_tick(0.05 * dm_s * cs_n); cs_vc = dC.drift_tick(0.05 * dm_s * cs_n);
// DRIVE: -24 .. +24 dB into the strip (with its wander); the preamp's knee and pre-filter track the drive above 0
cs_drdb += (min(max(slider1, -24), 24) - cs_drdb) * cs_gl;
cs_dg = 10 ^ ((cs_drdb + 0.5 * dm_a * cs_vd * cs_tP) / 20);              // (the wander only with the preamp in)
pr_vd = min(max(cs_drdb, 0), 24) / 24;
pr_v = 1 - 0.04 * dm_a * (0.5 + 0.5 * cs_vv) - 0.12 * dm_a * cs_env;   // the supply: wander and sag
pr_b = 0.05 + 0.03 * dm_a * cs_vb;
pr_out = 0.95;
// EQ: the stepped frequencies, the swept widths and gains, glided in Hz / Q (log) and dB
cs_lft = cs_lf(floor(slider5 + 0.5)); cs_mft = cs_mf(floor(slider8 + 0.5)); cs_hft = 125 * 2 ^ floor(min(max(slider11, 0), 7) + 0.5);
cs_lqt = min(max(slider6, 0.25), 4); cs_mqt = min(max(slider9, 0.25), 4); cs_hqt = min(max(slider12, 0.25), 4);
cs_lgt = min(max(slider7, -20), 20); cs_mgt = min(max(slider10, -20), 20); cs_hgt = min(max(slider13, -20), 20);
cs_snap ? ( cs_lf_ = cs_lft; cs_mf_ = cs_mft; cs_hf_ = cs_hft; cs_lq_ = cs_lqt; cs_mq_ = cs_mqt; cs_hq_ = cs_hqt; cs_lg_ = cs_lgt; cs_mg_ = cs_mgt; cs_hg_ = cs_hgt;
            cs_equpd(1); );                                    // (then glided every 32 samples in @sample)
// COMP
cp_th = min(max(slider15, -40), 0) + 0.4 * dm_a * cs_vc;                // the VCA's control voltage wanders a little
cs_r = min(max(slider16, 1), 21); cp_sl = cs_r >= 20.95 ? 1 : 1 - 1 / cs_r;
cp_ka = cs_tc(min(max(slider17, 0.1), 100)); cp_kr = cs_tc(min(max(slider18, 20), 2000));
cp_auto = slider19 >= 0.5; cp_soft = slider20 >= 0.5;
cs_mkt = min(max(slider21, -20), 20); cs_snap ? cp_mk = cs_mkt; cp_mk += (cs_mkt - cp_mk) * cs_gl;
cp_ceil = 10 ^ (min(max(slider22, -20), 0) / 20); cp_pon = slider23 >= 0.5;
// SC HPF (the drive's): the set point, raised an octave for every 12 dB of DRIVE above 0
pr_scon = slider24 >= 20;
cs_snap ? ( pr_scg = pr_scon; pr_sce = pr_scg; );
pr_scon || cs_snap ? cs_scb = min(max(slider24, 20), 300);                   // (held while it fades out)
cs_scf = cs_scb * 2 ^ (min(max(cs_drdb, 0), 24) / 12); cs_schp(cs_scf);
csa_scf = cs_scf;
cs_outt = 10 ^ (min(max(slider25, -12), 12) / 20);
// the chain sets: the preamp's clipper set-up; a set that has just been reset starts at rest
sA.pr.pr_cfg(samplesblock); sB.pr.pr_cfg(samplesblock);
cs_snap || cs_prime == 1 ? sA.pr.pr_prime(); cs_snap || cs_prime == 2 ? sB.pr.pr_prime(); cs_prime = 0;
cs_snap ? ( cs_dgs = cs_dg; cs_outs = cs_outt; );
cs_snap = 0;
sA.set_tidy(); sB.set_tidy();
cs_env = cs_tn(cs_env);
// the panel's mailboxes
csa_pl = max(csa_pl, cs_pl); csa_pr = max(csa_pr, cs_pr); csa_ol = max(csa_ol, cs_ol); csa_or = max(csa_or, cs_or);
cs_pl = cs_pr = cs_ol = cs_or = 0;
csa_gr = min(csa_gr, cs_cur ? sB.cp.grm : sA.cp.grm); sA.cp.grm = sB.cp.grm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
in_process(spl0, spl1);
cs_xl = in_l; cs_xr = in_r;
abs(cs_xl) < 0.000000000000001 ? cs_xl = 0; abs(cs_xr) < 0.000000000000001 ? cs_xr = 0;
cs_pl = max(cs_pl, abs(cs_xl)); cs_pr = max(cs_pr, abs(cs_xr));
// IN keys: 10 ms fades (a module coming back in starts from rest)
cs_gP != cs_tP ? ( cs_gP == 0 ? ( sA.pr.pr_reset(); sB.pr.pr_reset(); sA.pr.pr_prime(); sB.pr.pr_prime(); );
                   cs_gP = cs_tP ? min(cs_gP + cs_fst, 1) : max(cs_gP - cs_fst, 0); );
cs_gE != cs_tE ? ( cs_gE == 0 ? ( sA.eq.eq_reset(); sB.eq.eq_reset(); ); cs_gE = cs_tE ? min(cs_gE + cs_fst, 1) : max(cs_gE - cs_fst, 0); );
cs_gC != cs_tK ? ( cs_gC == 0 ? ( sA.cp.cp_reset(); sB.cp.cp_reset(); ); cs_gC = cs_tK ? min(cs_gC + cs_fst, 1) : max(cs_gC - cs_fst, 0); );
cs_eP = cs_gP * cs_gP * (3 - 2 * cs_gP); cs_eE = cs_gE * cs_gE * (3 - 2 * cs_gE); cs_eK = cs_gC * cs_gC * (3 - 2 * cs_gC);
// the order crossfade (after the warm-up)
cs_xf > 0 ? ( cs_wu > 0 ? cs_wu -= 1 : ( cs_xf += cs_xst; cs_xf >= 1 ? ( cs_xf = 0; cs_cur = 1 - cs_cur; cs_oCur = cs_oNew; ); ); );
cs_ex = cs_xf * cs_xf * (3 - 2 * cs_xf);
// glides (the EQ's every 32 samples: 80 ms)
(cs_eqcnt += 1) >= 32 ? ( cs_eqcnt = 0; cs_equpd(cs_eqk); );
pr_scg != pr_scon ? ( pr_scg = pr_scon ? min(pr_scg + cs_sst, 1) : max(pr_scg - cs_sst, 0); pr_sce = pr_scg * pr_scg * (3 - 2 * pr_scg); );
cs_dgs += (cs_dg - cs_dgs) * cs_gsm;
cs_outs += (cs_outt - cs_outs) * cs_gsm;
// DRIVE, then the chain
cs_xl *= cs_dgs; cs_xr *= cs_dgs;
cs_cur ? sB.set_run(cs_xl, cs_xr, cs_oCur) : sA.set_run(cs_xl, cs_xr, cs_oCur);
cs_yl = cs_a; cs_yr = cs_b;
cs_xf > 0 ? (
  cs_cur ? sA.set_run(cs_xl, cs_xr, cs_oNew) : sB.set_run(cs_xl, cs_xr, cs_oNew);
  cs_yl += cs_ex * (cs_a - cs_yl); cs_yr += cs_ex * (cs_b - cs_yr);
);
// the supply sags with what the preamp draws (the level into it)
cs_d = max(abs(cs_xl), abs(cs_xr)) * 0.18 * cs_gP; cs_env += (cs_d > cs_env ? cs_eat : cs_ert) * (min(cs_d, 1) - cs_env);
cs_yl *= cs_outs; cs_yr *= cs_outs;
// PEAK LIMIT (the output section, last in the strip): instant attack, 60 ms release, then the hard ceiling
cp_pon ? (
  cs_pa = max(abs(cs_yl), abs(cs_yr));
  cs_pc = cs_pa > cp_ceil ? cp_ceil / cs_pa : 1;
  cs_pg = cs_pc < cs_pg ? cs_pc : cs_pg + (1 - cs_pg) * cp_kpr;
  cs_yl *= cs_pg; cs_yr *= cs_pg;
  cs_yl = max(-cp_ceil, min(cp_ceil, cs_yl)); cs_yr = max(-cp_ceil, min(cp_ceil, cs_yr));
) : cs_pg = 1;
cs_yl != cs_yl ? cs_yl = 0; cs_yr != cs_yr ? cs_yr = 0;
ost_out(cs_yl, cs_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
cs_ol = max(cs_ol, abs(spl0)); cs_or = max(cs_or, abs(spl1));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 1080 430
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1080, 430);
// =====================================================================
// GUI - in the manner of KRT81: sharp-cornered sections, black bakelite knobs with printed scales, small capped knobs,
// a column of LEVEL / GR meters on the right. Two looks: VFD (dark charcoal and orange) and MATRIX (battleship grey,
// elephant's breath print, cream accent). PREAMP first; the EQ and the COMP sit in their running order (the ORDER key
// swaps them). Design space 1080 x 430. Knobs: drag (SHIFT = fine), wheel, double-click = default; the name shows the
// value while the knob is touched.
// =====================================================================
krv_mx = 0;                                  // one look (VFD); slider27 kept so old projects load
!krv_mx ? (                                               // VFD: dark charcoal and orange
  KRP = 0x2E2F31; KRF = 0x202123; KRI = 0xFFD2AE; KRA = 0xFF8A1F; KRW = 0x121314; KRM = 0x55575A;
  KRC = 0xFF8A1F; KRPT = 0x1A0C02; KRCN = 0xFF8A1F; KRGH = 0x2E2721; KRAMB = 0xFFD24A; KRRED = 0xFF3B1F; KRKT = 0x140A02;
) : (                                                     // MATRIX: battleship grey, elephant's breath, cream
  KRP = 0x222528; KRF = ui_mix(0x222528, 0x000000, 0.25); KRI = 0xC7BEB3; KRA = 0xF3E5C0; KRW = ui_mix(0x222528, 0x000000, 0.45);
  KRM = 0x4A4E4A; KRC = 0xF3E5C0; KRPT = 0x17191B; KRCN = 0x1E5631; KRGH = 0x2C302E; KRAMB = 0xD4A373; KRRED = 0xBC3908; KRKT = 0x17191B;
);
KRH = ui_mix(KRP, 0x000000, 0.35); KRI2 = ui_mix(KRI, KRF, 0.35);
// the EQ caps (the house colour code): LOW brown, MID blue, HIGH red
KCLO = 0x8B5A3C; KCMI = 0x3C6CC8; KCHI = 0xC8402E;

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');
gfx_setfont(10, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(14, "Trebuchet MS", 15 * sc, 'b');
gfx_setfont(15, "Trebuchet MS", 12 * sc, 'b');     // lamp key legends

function kr_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kr_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function kr_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_lbl(x, y, s) ( gfx_setfont(11); ui_col(KRI2); kr_txt(x, y, s); );
function kr_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function kr_thick(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, k) (       // (drawn here: works with any system files)
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l; ny = dx / l;
  k = -0.5 * w; loop(floor(w * 2.5) + 1, gfx_line(x1 + nx * k, y1 + ny * k, x2 + nx * k, y2 + ny * k, 1); k += 0.4; );
);
// panel keys: house lamp keys (gfx-ui). kr_kc = the key's lamp colour (set before the call; cleared after;
// none = the face's accent colour)
function kr_key(x, y, w, h, lbl, on) local(c) (
  c = kr_kc ? kr_kc : KRA; kr_kc = 0;
  lk_well = 0x0A0A0B; lk_font = 15; lk_font2 = 15;
  lk_fit(x, y, w, h, on, c, lbl);
);
// a section that's switched off: greyed slightly (its IN key is redrawn on top)
function kr_off(x, y, w, h) ( ui_cola(KRF, 0.5); kr_r(x + 1, y + 1, w - 2, h - 2); );
// a key that isn't live: an unlit lamp key, dimmed
function kr_dim(x, y, w, h, lbl) local(c) (
  c = kr_kc ? kr_kc : KRA; kr_kc = 0;
  lk_well = 0x0A0A0B; lk_font = 15; lk_font2 = 15; lk_inert = 1;
  lk_fit(x, y, w, h, 0, c, lbl);
  ui_cola(KRF, 0.55); kr_r(x, y, w, h); 0;
);
function kr_sect(x, y, w, h, name) (
  ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRF); kr_r(x + 1, y + 1, w - 2, h - 2);
  strlen(name) ? kr_lbl(x + 9, y + 6, name);
);
function kr_scale(cx, cy, r, n, nr, labels, minor) local(i, k, k0, len, c, a, ca, sa, m) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  minor > 0 ? (
    m = 0; ui_col(KRI2);
    loop((n - 1) * minor + 1,
      a = -0.75 * $pi + m / ((n - 1) * minor) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 6)) * sc, (cy + sa * (r + 6)) * sc, 1);
      m += 1;
    );
  );
  gfx_setfont(10);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#krv_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      ui_col(KRI);
      gfx_line((cx + ca * (r + 3)) * sc, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 7)) * sc, (cy + sa * (r + 7)) * sc, 1);
      strlen(#krv_sl) ? kr_ctxt(cx + ca * (r + nr), cy + sa * (r + nr), #krv_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
function kr_bake(cx, cy, r, a) local(i, t, ca, sa, k) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.55); gfx_circle(cx + 2.5 * sc, cy + 4.5 * sc, r * 1.02, 1, 1);
  ui_col(0x0A0A0A); gfx_circle(cx, cy, r + 1 * sc, 1, 1);
  ui_col(0x191817); gfx_circle(cx, cy, r, 1, 1);
  i = 0;
  loop(16,
    t = i / 16 * 2 * $pi; k = 0.5 + 0.5 * cos(t + 0.8);
    ui_col(ui_mix(0x0D0C0B, 0x48443F, k * 0.8)); gfx_circle(cx + sin(t) * r * 0.86, cy - cos(t) * r * 0.86, r * 0.15, 1, 1);
    ui_col(0x0D0C0B); gfx_circle(cx + sin(t + 0.196) * r * 0.9, cy - cos(t + 0.196) * r * 0.9, r * 0.075, 1, 1);
    i += 1;
  );
  ui_col(0x090808); gfx_circle(cx, cy, r * 0.70 + 1 * sc, 1, 1);
  ui_col(0x22201E); gfx_circle(cx, cy, r * 0.70, 1, 1);
  ui_cola(0xFFFFFF, 0.08); gfx_circle(cx, cy, r * 0.70, 0, 1);
  ui_col(0x060606); kr_thick(cx + ca * r * 0.18, cy + sa * r * 0.18, cx + ca * r * 0.98, cy + sa * r * 0.98, 4.2 * sc);
  ui_col(KRA); kr_thick(cx + ca * r * 0.22, cy + sa * r * 0.22, cx + ca * r * 0.95, cy + sa * r * 0.95, 2.5 * sc);
);
function kr_scap(cx, cy, r, a, cap) local(ca, sa, k, pc) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(0x121212); gfx_circle(cx, cy, r, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx, cy, r, 0, 1);
  k = r * 0.74;
  ui_col(cap); gfx_circle(cx, cy, k, 1, 1);
  ui_col(ui_mix(cap, 0x000000, 0.35)); gfx_circle(cx, cy, k, 0, 1);
  pc = (cap & 255) + ((cap >> 8) & 255) + ((cap >> 16) & 255) > 380 ? KRPT : 0xF4F0E6;
  ui_col(pc); kr_thick(cx + ca * k * 0.2, cy + sa * k * 0.2, cx + ca * r * 0.94, cy + sa * r * 0.94, 2.6 * sc);
);
krv_small = 0; krv_lg = 0; krv_step = 0; krv_cap = 0;
function kr_kn(v, lo, hi) ( krv_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function kr_kv(n, lo, hi) ( krv_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function kr_knob(cx, cy, r, idx, lo, hi, def) local(v, n, dx, dy, hov, did) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - krv_lt < 0.35 && krv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; krv_lt = 0; ) : (
      drag_id = did; krv_y = mouse_y; krv_lt = time_precise(); krv_lid = idx; krv_n = kr_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    krv_n = min(max(krv_n + (krv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : (krv_step ? 160 : 240)) * sc), 0), 1); krv_y = mouse_y;
    v = kr_kv(krv_n, lo, hi); krv_step ? v = floor(v + 0.5);
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    krv_step ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(kr_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
      slider(idx) = kr_kv(n, lo, hi);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(kr_kn(v, lo, hi), 0), 1);
  krv_small ? kr_scap(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi, krv_cap ? krv_cap : KRC) : kr_bake(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi);
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  hov || drag_id == did;
);
function kr_name(cx, cy, act, name, val) ( gfx_setfont(14); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy, act ? val : name); );
// a small knob with a tick ring (or n step ticks) and its name; the value while touched
function kr_small(cx, cy, r, idx, lo, hi, def, nt, name, val) local(i, t, act) (
  ui_cola(KRI, 0.85); i = 0;
  loop(nt, t = -0.75 * $pi + i / (nt - 1) * 1.5 * $pi;
    gfx_line((cx + sin(t) * (r + 4)) * sc, (cy - cos(t) * (r + 4)) * sc, (cx + sin(t) * (r + 8)) * sc, (cy - cos(t) * (r + 8)) * sc, 1); i += 1; );
  krv_small = 1; act = kr_knob(cx, cy, r, idx, lo, hi, def); krv_small = 0;
  strlen(name) ? ( gfx_setfont(11); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy + r + 15, act ? val : name); );
  act;
);
function kr_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? KRRED : zone == 1 ? KRAMB : KRCN;
  lit ? ( ui_cola(c, 0.16); kr_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); kr_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); kr_r(x, y, w, 1.5); )
      : ( ui_col(KRGH); kr_r(x, y, w, h); ui_cola(0x000000, 0.25); kr_r(x, y + h - 1, w, 1); );
);
function kr_hbar(x, y, w, h, v) local(n, i, sw, d) (
  n = 32; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; kr_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d, d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);
function kr_grbar(x, y, w, h, gr) local(n, i, sw, d) (                     // gain reduction: 0 .. -24 dB, from the left
  n = 24; sw = w / n; i = 0;
  loop(n, d = -(i + 0.5); kr_cell(x + i * sw + 0.5, y, sw - 2, h, gr <= d, 1); i += 1; );
);
function kr_window(x, y, w, h) ( ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRW); kr_r(x + 1, y + 1, w - 2, h - 2); );
// vertical meters: a level bar (-48 .. 0 dBFS, from the bottom) and a GR bar (0 .. -24 dB, from the top)
function kr_vbar(x, y, w, h, v) local(n, i, sh, d) (
  n = 32; sh = h / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; kr_cell(x, y + h - (i + 1) * sh + 1, w, sh - 2, v >= d, d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);
function kr_vgr(x, y, w, h, gr) local(n, i, sh, d) (
  n = 24; sh = h / n; i = 0;
  loop(n, d = -(i + 0.5); kr_cell(x, y + i * sh + 1, w, sh - 2, gr <= d, 1); i += 1; );
);
function kr_db(v) ( sprintf(#krd, "%+.1f dB", v); #krd; );
function kr_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
function kr_hz(f) ( f >= 1000 ? sprintf(#krh, "%g kHz", f / 1000) : sprintf(#krh, "%d Hz", floor(f + 0.5)); #krh; );

// ---------- the EQ or the COMP at slot s (0 = left, 1 = right) ----------
function kr_module(m, s) local(x, w, y, inn, a, c, base, cx, cy, f, r) (
  w = 345; x = 178 + s * 351; y = 72;
  kr_sect(x, y, w, 338, m == 1 ? "EQ" : "COMP");
  gfx_setfont(13); ui_col(KRI2); kr_txt(x + 9, y + 22, m == 1 ? "3-BAND PARAMETRIC" : "VCA COMPRESSOR");
  inn = m == 1 ? 4 : 14;
  kr_kc = LK_AMB; kr_key(x + w - 62, y + 8, 52, 24, "IN", slider(inn) >= 0.5) ? kr_tog(inn);
  m == 1 ? (
    // rows FREQ / WIDTH / GAIN; columns LOW / MID / HIGH; each knob's setting always shown under it
    gfx_setfont(11); ui_col(KRI2);
    kr_txt(x + 14, y + 104, "FREQ"); kr_txt(x + 14, y + 194, "WIDTH"); kr_txt(x + 14, y + 284, "GAIN");
    f = 0; r = 23;
    loop(3,
      cx = x + 128 + f * 88; base = f == 0 ? 5 : f == 1 ? 8 : 11;
      c = f == 0 ? KCLO : f == 1 ? KCMI : KCHI;
      ui_col(c); kr_r(cx - 22, y + 62, 44, 3);
      gfx_setfont(11); ui_col(KRI); kr_ctxt(cx, y + 52, f == 0 ? "LOW" : f == 1 ? "MID" : "HIGH");
      krv_cap = c;
      krv_step = 1;
      kr_hz(f == 0 ? cs_lf(floor(slider(base) + 0.5)) : f == 1 ? cs_mf(floor(slider(base) + 0.5)) : 125 * 2 ^ floor(slider(base) + 0.5));
      kr_small(cx, y + 104, r, base, 0, 7, f == 0 ? 2 : f == 1 ? 4 : 5, 8, #krh, #krh);
      krv_step = 0; krv_lg = 1;
      sprintf(#krq, "Q %.2f", slider(base + 1));
      kr_small(cx, y + 194, r, base + 1, 0.25, 4, 1, 5, #krq, #krq);
      krv_lg = 0;
      sprintf(#krg, "%+.1f dB", slider(base + 2));
      kr_small(cx, y + 284, r, base + 2, -20, 20, 0, 11, #krg, #krg);
      krv_cap = 0;
      f += 1;
    );
  ) : (
    kr_kc = LK_YEL; kr_key(x + 14, y + 44, 70, 24, "AUTO", slider19 >= 0.5) ? kr_tog(19);
    kr_kc = LK_AMB; kr_key(x + 90, y + 44, 96, 24, "SOFT KNEE", slider20 >= 0.5) ? kr_tog(20);
    kr_scale(x + 110, y + 160, 36, 5, 19, "-40|-30|-20|-10|0", 2);
    a = kr_knob(x + 110, y + 160, 36, 15, -40, 0, -20); sprintf(#krv, "%.1f dBFS", slider15); kr_name(x + 110, y + 222, a, "THRESHOLD", #krv);
    // RATIO / ATTACK / RELEASE stacked on the EQ's rows
    slider16 >= 20.95 ? strcpy(#krr, "INF : 1") : sprintf(#krr, "%.1f : 1", slider16);
    kr_small(x + 290, y + 104, 19, 16, 1, 21, 3, 11, "RATIO", #krr);
    krv_lg = 1;
    sprintf(#kra, "%.1f ms", slider17); kr_small(x + 290, y + 194, 19, 17, 0.1, 100, 10, 11, "ATTACK", #kra);
    sprintf(#krl, "%d ms", floor(slider18 + 0.5)); kr_small(x + 290, y + 284, 19, 18, 20, 2000, 200, 11, "RELEASE", #krl);
    krv_lg = 0;
    slider19 >= 0.5 ? ( ui_cola(KRF, 0.65); kr_r(x + 250, y + 162, 84, 160); gfx_setfont(13); ui_col(KRA); kr_ctxt(x + 290, y + 244, "AUTO"); );
    kr_small(x + 110, y + 284, 23, 21, -20, 20, 0, 11, "MAKEUP", kr_db(slider21));
  );
  slider(inn) < 0.5 ? ( kr_off(x, y, w, 338); kr_kc = LK_AMB; kr_key(x + w - 62, y + 8, 52, 24, "IN", 0) ? kr_tog(inn); );
);

// =====================================================================
// Faceplate and header
// =====================================================================
ui_col(ui_mix(KRP, 0x000000, 0.35)); gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0xFFFFFF, 0.08); kr_r(0, 0, 1080, 1.5); kr_r(0, 0, 1.5, 430);
ui_cola(0x000000, 0.35); kr_r(0, 428.5, 1080, 1.5); kr_r(1078.5, 0, 1.5, 430);
ui_col(KRP); kr_r(12, 12, 1056, 406);
ui_cola(0x000000, 0.30); kr_r(12, 12, 1056, 1.5); kr_r(12, 12, 1.5, 406);
ui_cola(0xFFFFFF, 0.07); kr_r(12, 416.5, 1056, 1.5); kr_r(1066.5, 12, 1.5, 406);
ui_col(KRH); kr_r(13.5, 13.5, 1053, 50.5);
ui_col(KRA); kr_r(13.5, 64, 1053, 2);
ui_col(KRA); gfx_circle(45 * sc, 39 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(KRKT); ui_text(45 * sc, 33.5 * sc, "GFX");
gfx_setfont(6); ui_col(KRI); kr_txt(72, 24, "CH34"); gfx_measurestr("CH34", krv_tw, krv_th); ver_tag("v3", 16, 5.25, 0);
krv_tx = 72 + krv_tw / sc + 14;
gfx_setfont(11); ui_col(KRI2); kr_txt(krv_tx, 25, "CHANNEL STRIP"); kr_txt(krv_tx, 40, "PREAMP · EQ · COMP");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(318 * sc, 22 * sc, 290 * sc, 34 * sc, pr_cur, #cs_pm);
k_ > 0 ? prs_dirty = k_;
gfx_setfont(11); ui_col(KRI2); kr_txt(628, 33, "ORDER");
kr_kc = LK_BLU; kr_key(676, 25, 104, 28, slider2 >= 0.5 ? "COMP ► EQ" : "EQ ► COMP", 0) ? ( slider2 = slider2 >= 0.5 ? 0 : 1; ui_auto(2); );
ui_size_picker(1000 * sc, 30 * sc);

// =====================================================================
// PREAMP (x 22) | EQ / COMP in their running order (x 178, 529) | OUTPUT (x 880) | METERS (x 982)
// =====================================================================
kr_sect(22, 72, 150, 338, "PREAMP");
kr_kc = LK_AMB; kr_key(114, 80, 50, 24, "IN", slider3 >= 0.5) ? kr_tog(3);
kr_scale(97, 210, 40, 5, 21, "-24|-12|0|+12|+24", 2);
krv_a = kr_knob(97, 210, 40, 1, -24, 24, 0); kr_name(97, 280, krv_a, "DRIVE", kr_db(slider1));
gfx_setfont(13); ui_col(KRI2); kr_ctxt(97, 132, slider3 >= 0.5 ? "TRIM + DRIVE" : "TRIM ONLY");
slider24 < 20 ? strcpy(#krs, "OFF") : sprintf(#krs, "%d Hz", floor(slider24 + 0.5));
kr_small(97, 350, 17, 24, 0, 300, 0, 11, "SC HPF", #krs);
slider24 >= 20 ? ( sprintf(#krs2, "> %d Hz", floor(csa_scf + 0.5)); gfx_setfont(13); ui_col(KRI2); kr_ctxt(97, 398, #krs2); );

krv_o = slider2 >= 0.5;
kr_module(krv_o ? 2 : 1, 0); kr_module(krv_o ? 1 : 2, 1);

kr_sect(880, 72, 96, 338, "OUTPUT");
kr_scale(928, 150, 26, 3, 15, "-12|0|+12", 4);
krv_a = kr_knob(928, 150, 26, 25, -12, 12, 0); kr_name(928, 202, krv_a, "LEVEL", kr_db(slider25));
kr_small(928, 250, 17, 22, -20, 0, -1, 11, "PEAK", kr_db(slider22));
kr_kc = LK_RED; kr_key(898, 298, 60, 24, "LIMIT", slider23 >= 0.5) ? kr_tog(23);
sprintf(#krv, "%d%%", floor(slider26 + 0.5)); kr_small(928, 360, 17, 26, 0, 100, 50, 11, "DRIFT", #krv);

kr_sect(982, 72, 76, 338, "METERS");
kr_window(988, 96, 64, 274);
function kr_fall(v, pk) ( pk = pk > 0.0000001 ? 20 * log10(pk) : -90; pk > v ? pk : max(v - 0.6, -90); );
krv_il = kr_fall(krv_il, csa_pl); krv_ir = kr_fall(krv_ir, csa_pr); krv_ol = kr_fall(krv_ol, csa_ol); krv_or = kr_fall(krv_or, csa_or);
csa_pl = csa_pr = csa_ol = csa_or = 0;
krv_gr = csa_gr < krv_gr ? csa_gr : min(krv_gr + 0.5, 0); csa_gr = 0;
kr_vbar(993, 102, 8, 262, krv_il); kr_vbar(1002, 102, 8, 262, krv_ir);
kr_vgr(1015, 102, 10, 262, krv_gr);
kr_vbar(1030, 102, 8, 262, krv_ol); kr_vbar(1039, 102, 8, 262, krv_or);
gfx_setfont(10); ui_col(KRI); kr_ctxt(999, 379, "IN"); kr_ctxt(1041, 379, "OUT");
sprintf(#krv_g, "GR %.1f", krv_gr); gfx_setfont(13); ui_col(KRAMB); kr_ctxt(1020, 396, #krv_g);

pk_end();
ui_end();
