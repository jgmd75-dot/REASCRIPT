dq_c1 = dq_sx + 42; dq_c2 = dq_sx + 116; dq_c3 = dq_sx + 190; dq_c4 = dq_sx + 264;
dq_gt ? dq_sknob(dq_c1, 132, 22, 5, 60, 1000, 300, 1, 0, 0, 0, 3, dq_ta == 4 ? "GATE" : (dq_de ? "LÄNGE" : "LENGTH"), 0)
      : dq_sknob(dq_c1, 132, 22, 4, 0.2, 10, 2.4, 1, 0, 0, 0, 3, dq_de ? "NACHHALL" : "DECAY", 0);
dq_sknob(dq_c2, 132, 22, 7, 0, 300, 20, 0, 0, 0, 0, 2, dq_de ? "VORVERZ." : "PRE-DELAY", 0);
dq_sknob(dq_c3, 132, 22, 8, 0, 100, 40, 0, 10, 0, 0, 4, dq_de ? "DÄMPF." : "HF DAMP", 0);
dq_sknob(dq_c4, 132, 20, 9, 20, 600, 80, 1, 0, 1, 0, 5, dq_de ? "TIEFEN" : "LOW CUT", 0);
dq_sknob(dq_c1, 250, 22, 11, 50, 150, 100, 0, 0, 0, 0, 6, dq_de ? "GRÖSSE" : "SIZE", dq_gt);
dq_sknob(dq_c2, 250, 22, 12, 0, 100, 70, 0, 0, 0, 0, 7, "DIFFUSION", dq_ta == 3);
dq_sknob(dq_c3, 250, 22, 6, 0, 100, 30, 0, 0, 0, 0, 8, dq_de ? "FORM" : "SHAPE", !dq_gt);
dq_sknob(dq_c4, 250, 22, 10, 0, 100, 20, 0, 0, 0, 0, 9, dq_de ? "ANTRIEB" : "DRIVE", 0);

// OUTPUT section
dq_ox = 794; dq_ow = 116;
pk_inset((dq_ox + 5) * sc, 69 * sc, (dq_ow - 10) * sc, 256 * sc, DQS);
gfx_setfont(13); ui_col(DQI2); dq_txt(dq_ox + 14, 74, dq_de ? "AUSGANG" : "OUTPUT");
dq_sknob(dq_ox + 58, 124, 20, 15, 0, 100, 30, 0, 0, 0, 0, 10, dq_de ? "MISCHUNG" : "MIX", 0);
dq_sknob(dq_ox + 58, 200, 14, 18, -24, 12, 0, 0, 0, 2, 0x9DA2A8, 12, dq_de ? "PEGEL" : "LEVEL", 0);
dq_sknob(dq_ox + 32, 264, 11, 19, 0, 100, 0, 0, 0, 2, 0xD8B040, 0, dq_de ? "SÄTT." : "SAT", 0);
dq_sknob(dq_ox + 84, 264, 11, 16, 0, 100, 50, 0, 0, 2, 0x9DA2A8, 11, "DRIFT", 0);
mtL.ui_ledm((dq_ox + 14) * sc, 300 * sc, 88 * sc, 7 * sc, dp_opkL); mtR.ui_ledm((dq_ox + 14) * sc, 311 * sc, 88 * sc, 7 * sc, dp_opkR);
dp_opkL = 0; dp_opkR = 0;

// ---------- data-entry keys (clicky, low profile) ----------
dq_ky = 240;
pk_inset(15 * sc, (dq_ky + 1) * sc, 458 * sc, 34 * sc, DQS);
gfx_setfont(11); ui_col(DQI2); dq_txt(22, dq_ky + 10, "PARAM");
dq_dkey(78, dq_ky + 3, 38, 30, "◄") ? ( dq_sel = dq_sel <= 1 ? 15 : dq_sel - 1; );
dq_dkey(120, dq_ky + 3, 38, 30, "►") ? ( dq_sel = dq_sel >= 15 ? 1 : dq_sel + 1; );
gfx_setfont(11); ui_col(DQI2); dq_txt(176, dq_ky + 10, dq_de ? "WERT" : "VALUE");
dq_inc = 0;
dq_dkey(230, dq_ky + 3, 38, 30, "-") ? dq_inc = -1;
dq_dkey(272, dq_ky + 3, 38, 30, "+") ? dq_inc = 1;
dq_inc != 0 ? (
  dq_pinfo(dq_sel);
  dq_sel == 1 ? slider2 = (dq_ta + dq_inc + 7) % 7 : slider(dq_pi) = min(max(slider(dq_pi) + dq_inc * dq_pst, dq_plo), dq_phi);
  dq_sel == 3 && !dq_gt ? slider4 = floor(slider4 * 100 + 0.5) / 100;
