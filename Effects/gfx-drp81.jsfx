);

// ---------- the rubberised program selectors ----------
dq_ry = 282;
dq_i = 0;
loop(7,
  dq_k = 12 + dq_i * 66.6; dq_on = dq_ta == dq_i;
  dq_hv = dq_hov(dq_k, dq_ry, 63, 46);
  dq_hv && pressed && drag_id == 0 ? ( drag_id = -1; slider2 = dq_i; ui_auto(2); dq_sel = 1; );
  dq_hv ? dq_hp = 1;
  ui_cola(0x000000, 0.55); rd_rr((dq_k + 1) * sc, (dq_ry + 3) * sc, 63 * sc, 46 * sc, 8 * sc);
  ui_col(0x18191B); rd_rr(dq_k * sc, (dq_ry + (dq_on ? 1.5 : 0)) * sc, 63 * sc, 46 * sc, 8 * sc);
  ui_col(dq_on ? 0x34363A : dq_hv ? 0x404247 : 0x3A3C40); rd_rr((dq_k + 2) * sc, (dq_ry + 2 + (dq_on ? 1.5 : 0)) * sc, 59 * sc, 40 * sc, 7 * sc);
  gfx_gradrect((dq_k + 6) * sc, (dq_ry + 3 + (dq_on ? 1.5 : 0)) * sc, 51 * sc, 14 * sc, 1, 1, 1, 0.07, 0, 0, 0, 0, 0, 0, 0, -0.07 / (14 * sc));
  rd_led(dq_k + 12, dq_ry + 13 + (dq_on ? 1.5 : 0), 3, dq_on, DQV);
  gfx_setfont(11); ui_col(DQI2); sprintf(#dqs, "%02d", dq_i + 1); dq_rtxt(dq_k + 56, dq_ry + 13 + (dq_on ? 1.5 : 0), #dqs);
  gfx_setfont(11); gfx_measurestr(dq_alg(dq_i), dq_tw, dq_th);
  dq_tw > 55 * sc ? gfx_setfont(9, "Trebuchet MS", 11.5 * sc, 'b');                   // the longest names (seven keys now) a size down
  ui_col(dq_on ? DQV : 0xE6EAEE);
  dq_ctxt(dq_k + 31.5, dq_ry + 31 + (dq_on ? 1.5 : 0), dq_alg(dq_i));
  dq_i += 1;
);

// ---------- the VFD content ----------
dq_p = dq_hp > 0 ? dq_hp : dq_sel;
dq_pinfo(dq_p);
dq_pn_ = dq_plg ? log(max(slider(dq_pi), dq_plo) / dq_plo) / log(dq_phi / dq_plo) : (slider(dq_pi) - dq_plo) / (dq_phi - dq_plo);
dq_p == 1 && 0 ? 0;
sprintf(#dqs, "P-%02d %-10s", dq_p, #dq_pn);
gfx_setfont(15); dq_vtxt(dq_vx + 20, dq_vy + 30, #dqs, 1);
gfx_measurestr("P-01 ALGORITHM ", dq_tw, dq_th);
sprintf(#dqs, "%s", #dq_fv); dq_vtxt(dq_vx + 20 + dq_tw / sc + 6, dq_vy + 30, #dqs, 1);
sprintf(#dqs, "[0x%02X]", floor(min(max(dq_pn_, 0), 1) * 255 + 0.5)); ui_cola(DQV, 0.8); dq_rtxt(dq_vx + dq_vw - 20, dq_vy + 30, #dqs);
// status line
gfx_setfont(16);
sprintf(#dqs, dq_de ? "PRG %02d %-9s" : "ALG %02d %-9s", dq_ta + 1, dq_alg(dq_ta));
dq_vtxt(dq_vx + 20, dq_vy + 54, #dqs, 0.85);
dq_vtxt(dq_vx + 170, dq_vy + 54, dq_ta <= 2 || dq_ta == 6 ? "FDN 16x16" : dq_ta == 3 ? "ER 16 TAP" : "NL 96 TAP", 0.6);
sprintf(#dqs, "%dBIT %.1fkHz", slider27 < 0.5 ? 12 : slider27 < 1.5 ? 16 : 24, srate / 1000); dq_dec(#dqs); ui_cola(DQV, 0.6); dq_rtxt(dq_vx + dq_vw - 20, dq_vy + 54, #dqs);
ui_cola(DQV, 0.25); dq_r(dq_vx + 18, dq_vy + 67, dq_vw - 36, 1);
// the decay-time matrix: six bands x time (newest on the right), RT60 per band on the right
dq_now - dq_ht > 0.06 ? (
  dq_ht = dq_now; dq_hc = (dq_hc + 1) % 32;
  dq_i = 0;
  loop(6,
    dq_e = dq_i == 0 ? dp_e0 : dq_i == 1 ? dp_e1 : dq_i == 2 ? dp_e2 : dq_i == 3 ? dp_e3 : dq_i == 4 ? dp_e4 : dp_e5;
    dp_his[dq_i * 32 + dq_hc] = 20 * log10(max(dq_e, 0.0000001)) + dq_i * 3;
    dq_i += 1;
  );
);
dq_mx = dq_vx + 62; dq_gy = dq_vy + 75; dq_cw = 11.5; dq_chh = 12; dq_nc = 28;
gfx_setfont(16);
dq_i = 0;
loop(6,
  dq_yy = dq_gy + dq_i * (dq_chh + 1.5);
  ui_cola(DQV, 0.7); dq_rtxt(dq_mx - 8, dq_yy + dq_chh * 0.5, dq_i == 0 ? "125" : dq_i == 1 ? "400" : dq_i == 2 ? "1K" : dq_i == 3 ? "2K5" : dq_i == 4 ? "6K" : "12K");
  dq_j = 0;
  loop(dq_nc,
    dq_l = dp_his[dq_i * 32 + (dq_hc - (dq_nc - 1 - dq_j) + 64) % 32];
    dq_lv = min(max((dq_l + 78) / 60, 0), 1);
    dq_xx = dq_mx + dq_j * dq_cw;
    ui_cola(DQV, 0.07); dq_r(dq_xx, dq_yy, dq_cw - 2, dq_chh);
    dq_lv > 0.04 ? ( ui_cola(DQV, 0.15 + 0.85 * dq_lv); dq_r(dq_xx, dq_yy, dq_cw - 2, dq_chh); );
    dq_j += 1;
  );
  // the predicted RT60 of this band, from the tank's loss filters
  dq_f = dq_i == 0 ? 125 : dq_i == 1 ? 400 : dq_i == 2 ? 1000 : dq_i == 3 ? 2500 : dq_i == 4 ? 6000 : 12000;
  dq_ta <= 2 || dq_ta == 6 ? (
    dq_q = dq_f / 300; dq_g1 = sqrt((sqr(1 + dp_kl[0]) + dq_q * dq_q) / (1 + dq_q * dq_q));
    dq_q = dq_f / 3500; dq_g2 = sqrt((1 + sqr(dq_q * (1 + dp_ja[0]))) / (1 + dq_q * dq_q));
    dq_g = dp_jb[0] * dq_g1 * dq_g2;
    dq_rt = dq_g < 1 ? -3 * (dp_ln[0] + dp_apl[0]) / srate / log10(dq_g) : 99;
    sprintf(#dqs, "%4.1fs", min(dq_rt, 99));
  ) : dq_ta == 3 ? strcpy(#dqs, " ER") : sprintf(#dqs, "%.2fs", slider5 / 1000);
  ui_cola(DQV, 0.85); dq_rtxt(dq_vx + dq_vw - 20, dq_yy + dq_chh * 0.5, #dqs);
  dq_i += 1;
);
) : (

// =====================================================================
// BERLIN: the laboratory rack
// =====================================================================
dq_ec = dq_ba == 3;
// a section: a sharp-cornered face with a heavy black 90-degree frame and its silkscreened name
// heavy square lit push-button: lights red when in


// ---------- PROGRAMM ----------
dq_sect(10, 64, 212, 222, DQF, dq_de ? "PROGRAMM" : "PROGRAM");
dq_i = 0;
loop(4,
  dq_big(22 + (dq_i % 2) * 100, 96 + floor(dq_i / 2) * 70, 90, 60, dq_balg(dq_i),
         dq_i == 0 ? "1" : dq_i == 1 ? "2" : dq_i == 2 ? "3" : "4", dq_ba == dq_i) ? ( slider3 = dq_i; ui_auto(3); );
  dq_i += 1;
);
// lamps: ready, processor overload
dq_ov = dp_ovt; dp_ovt = 0; dq_ov ? dq_ovt = dq_now;
dq_lamp(32, 254, 1, 0xFFA126, dq_de ? "BEREIT" : "READY");
dq_lamp(124, 254, dq_now - dq_ovt < 0.25, DQRED, dq_de ? "ÜBERLAST" : "OVERLOAD");

// ---------- ZEIT: pre-delay and decay, coarse + fine ----------
dq_sect(230, 64, 240, 222, DQF, dq_de ? "ZEIT" : "TIME");
// pre-delay: coarse 20 ms steps 0 .. 300, fine 0 .. 20 ms
dq_pc = min(floor(slider7 / 20 + 0.0001), 15); dq_pf = slider7 - dq_pc * 20;
dq_cx = 296;
dq_i = 0; loop(16, dq_a = -0.75 * $pi + dq_i / 15 * 1.5 * $pi; ui_col(DQI2);
  gfx_line((dq_cx + sin(dq_a) * 30) * sc, (130 - cos(dq_a) * 30) * sc, (dq_cx + sin(dq_a) * (dq_i % 5 ? 34 : 37)) * sc, (130 - cos(dq_a) * (dq_i % 5 ? 34 : 37)) * sc, 1); dq_i += 1; );
dq_slbl(dq_cx - 34, 162, "0"); dq_slbl(dq_cx - 37, 106, "100"); dq_slbl(dq_cx + 37, 106, "200"); dq_slbl(dq_cx + 36, 162, "300");
dq_n_ = dq_knob(dq_cx, 130, 24, 107, dq_pc / 15, 1 / 15, -15);
dq_chg ? ( slider7 = min(floor(dq_n_ * 15 + 0.5) * 20 + dq_pf, 300); ui_auto(7); );
dq_a1 = dq_act;
dq_bcap(dq_cx, 130, 24, dq_n_);
dq_n_ = dq_knob(dq_cx, 222, 14, 207, dq_pf / 20, 0, 0);
dq_chg ? ( slider7 = min(dq_pc * 20 + min(dq_n_ * 20, 19.9), 300); slider7 = floor(slider7 * 10 + 0.5) / 10; ui_auto(7); );
dq_a2 = dq_act;
dq_ticks(dq_cx, 222, 14, 5, DQI2, 0.8); dq_bcap(dq_cx, 222, 14, dq_n_);
gfx_setfont(11); ui_col(DQI2); dq_rtxt(dq_cx - 22, 222, dq_de ? "FEIN" : "FINE");
gfx_setfont(14);
(dq_a1 || dq_a2) ? ( dq_fmt(7); ui_col(DQHI); dq_ctxt(dq_cx, 266, #dq_fv); ) : ( gfx_setfont(11); ui_col(DQI); dq_ctxt(dq_cx + 2, 266, dq_de ? "VORVERZÖGERUNG" : "PRE-DELAY"); );
// decay: coarse 13 steps 0.2 .. 10 s, fine between two steps
dq_dc = 0; loop(12, dq_dstep(dq_dc + 1) <= slider4 + 0.0001 ? dq_dc += 1; );
dq_df = dq_dc < 12 ? log(slider4 / dq_dstep(dq_dc)) / log(dq_dstep(dq_dc + 1) / dq_dstep(dq_dc)) : 0;
dq_df = min(max(dq_df, 0), 0.999);
dq_cx = 414;
dq_i = 0; loop(13, dq_a = -0.75 * $pi + dq_i / 12 * 1.5 * $pi; ui_col(DQI2);
  gfx_line((dq_cx + sin(dq_a) * 30) * sc, (130 - cos(dq_a) * 30) * sc, (dq_cx + sin(dq_a) * (dq_i % 3 ? 34 : 37)) * sc, (130 - cos(dq_a) * (dq_i % 3 ? 34 : 37)) * sc, 1); dq_i += 1; );
dq_slbl(dq_cx - 36, 162, dq_de ? "0,2" : "0.2"); dq_slbl(dq_cx - 45, 104, dq_de ? "0,6" : "0.6"); dq_slbl(dq_cx, 84, "2"); dq_slbl(dq_cx + 44, 104, dq_de ? "5,6" : "5.6"); dq_slbl(dq_cx + 37, 162, "10");
dq_n_ = dq_knob(dq_cx, 130, 24, 104, dq_dc / 12, 7 / 12, -12);
dq_chg ? ( dq_k = floor(dq_n_ * 12 + 0.5);
           slider4 = dq_k >= 12 ? 10 : dq_dstep(dq_k) * (dq_dstep(dq_k + 1) / dq_dstep(dq_k)) ^ dq_df;
           dq_n_ == 7 / 12 && dq_lt == 0 ? slider4 = 2.4;
           slider4 = floor(slider4 * 100 + 0.5) / 100; ui_auto(4); );
dq_a1 = dq_act;
dq_bcap(dq_cx, 130, 24, dq_n_);
dq_n_ = dq_knob(dq_cx, 222, 14, 204, dq_df, 0, 0);
dq_chg ? ( slider4 = dq_dc >= 12 ? 10 : dq_dstep(dq_dc) * (dq_dstep(dq_dc + 1) / dq_dstep(dq_dc)) ^ min(dq_n_, 0.999);
           slider4 = floor(slider4 * 100 + 0.5) / 100; ui_auto(4); );
dq_a2 = dq_act;
dq_ticks(dq_cx, 222, 14, 5, DQI2, 0.8); dq_bcap(dq_cx, 222, 14, dq_n_);
gfx_setfont(11); ui_col(DQI2); dq_rtxt(dq_cx - 22, 222, dq_de ? "FEIN" : "FINE");
gfx_setfont(14);
(dq_a1 || dq_a2) ? ( dq_fmt(4); ui_col(DQHI); dq_ctxt(dq_cx, 266, #dq_fv); ) : ( ui_col(DQI); dq_ctxt(dq_cx, 266, dq_ec ? (dq_de ? "ABKLINGEN" : "FEEDBACK") : (dq_de ? "NACHHALL" : "DECAY")); );

// ---------- KLANG ----------
dq_sect(478, 64, 240, 222, DQF, dq_de ? "KLANG" : "TONE");
dq_c1 = 524; dq_c2 = 598; dq_c3 = 672;
dq_sknob(dq_c1, 122, 21, 8, 0, 100, 40, 0, 10, 0, 0, 0, dq_de ? "DÄMPFUNG" : "DAMPING", 0);
dq_sknob(dq_c2, 122, 19, 9, 20, 600, 80, 1, 0, 1, 0, 0, dq_de ? "TIEFEN" : "LOW CUT", 0);
dq_sknob(dq_c3, 122, 21, 10, 0, 100, 20, 0, 0, 0, 0, 0, dq_de ? "ANTRIEB" : "DRIVE", 0);
dq_sknob(dq_c1, 218, 21, 13, 0, 100, 50, 0, 0, 0, 0, 0, dq_de ? "KÖRNUNG" : "GRAIN", 0);
dq_ec ? dq_sknob(dq_c2, 218, 21, 14, 40, 1000, 300, 1, 0, 0, 0, 0, dq_de ? "ECHOZEIT" : "DELAY", 0)
      : dq_sknob(dq_c2, 218, 21, 11, 50, 150, 100, 0, 0, 0, 0, 0, dq_de ? "GRÖSSE" : "SIZE", 0);
dq_sknob(dq_c3, 218, 21, 12, 0, 100, 70, 0, 0, 0, 0, 0, "DIFFUSION", 0);

// ---------- PEGEL: the vertical meter ladders ----------
dq_sect(726, 64, 74, 222, DQF, "");
dq_ip = dp_ipk; dp_ipk = 0;
dq_idb = 20 * log10(max(dq_ip, 0.000001)) + (dq_b ? 0 : 0);
dq_iv = max(dq_idb, (dq_ivi ? dq_iv : -100) - 24 * dq_dt); dq_ivi = 1;
dq_gp = dp_gpk; dp_gpk = 0;
dq_res = 20 * log10(0.9 / max(dq_gp, 0.000001));  // reserve before the tank overloads (dB)
dq_rv = dq_rv == 0 ? dq_res : (dq_res < dq_rv ? dq_res : dq_rv + 18 * dq_dt);
dq_rv = min(dq_rv, 40);
dq_ladder(746, 74, 12, 196, floor((min(dq_iv, 6) + 42) / 3 + 0.5), 0);
dq_ladder(768, 74, 12, 196, floor(dq_rv / 2.5 + 0.5), 1);
// the names, silkscreened vertically
gfx_setfont(11); ui_col(DQI);
// (centred on the 12-letter column; these words have no umlauts, so one byte per letter)
strcpy(#dqw, dq_de ? "AUSSTEUERUNG" : "INPUT LEVEL");
dq_i = 0; loop(strlen(#dqw), strcpy_substr(#dqs, #dqw, dq_i, 1); dq_ctxt(736, 82 + (12 - strlen(#dqw)) * 7.9 + dq_i * 15.8, #dqs); dq_i += 1; );
strcpy(#dqw, dq_de ? "REGELRESERVE" : "HEADROOM");
dq_i = 0; loop(strlen(#dqw), strcpy_substr(#dqs, #dqw, dq_i, 1); dq_ctxt(790, 82 + (12 - strlen(#dqw)) * 7.9 + dq_i * 15.8, #dqs); dq_i += 1; );

// ---------- AUSGANG ----------
dq_sect(808, 64, 102, 222, DQS, dq_de ? "AUSGANG" : "OUTPUT");
dq_sknob(859, 120, 18, 15, 0, 100, 30, 0, 0, 0, 0, 0, dq_de ? "MISCHUNG" : "MIX", 0);
dq_sknob(859, 194, 13, 18, -24, 12, 0, 0, 0, 2, 0x9DA2A8, 0, dq_de ? "PEGEL" : "LEVEL", 0);
dq_sknob(834, 248, 10, 19, 0, 100, 0, 0, 0, 2, 0xD8B040, 0, dq_de ? "SÄTT." : "SAT", 0);
dq_sknob(884, 248, 10, 16, 0, 100, 50, 0, 0, 2, dq_sk == 0 ? 0x6F8794 : DQI2, 0, "DRIFT", 0);

// ---------- bottom band: the silkscreen ----------
dq_sect(10, 294, 900, 38, DQS, "");
gfx_setfont(13); ui_col(DQI); dq_ctxt(600, 313, dq_de ? "DRP81   DIGITALER RAUMKLANG-PROZESSOR" : "DRP81   DIGITAL REVERB PROCESSOR");
gfx_setfont(11); ui_col(DQI2); dq_rtxt(898, 313, "12 BIT · 9 kHz");
);

pk_end();
ui_end();
