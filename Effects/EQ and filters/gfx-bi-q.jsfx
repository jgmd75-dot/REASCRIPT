desc:Bi-Q [tone control] (GFX)
//tags: equaliser eq tone control baxandall bass treble hifi saturation width
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift and gfx-input (.jsfx-inc) in the same folder.
//
// Bi-Q - a two-knob tone control for single tracks (designed from scratch), reinstated from the archive with a
// new panel and new sections (Oct 2026). Sliders 1 - 11 and 17 are the archived Bi-Q's; with the new sections at
// their defaults it sounds exactly as before.
//
// SIGNAL FLOW: input (TRIM, GUARD) -> HPF / LPF -> BASS / TREBLE shelves + MID -> SAT LO / SAT HI -> LOW / HIGH
//   WIDTH -> OUTPUT. Straight through at the end (house rule for mix tools).
//   BASS / TREBLE - +/-12 dB in 0.5 dB detents (Shift = free). Baxandall-style curves: broad 6 dB / octave
//                   shelves that keep rising gently towards the extremes rather than flattening off, so a
//                   little goes a long way and the middle is left alone.
//   TURNOVER      - where each control is half-way to its full effect: bass 75 / 150 / 300 Hz,
//                   treble 1.5 / 3 / 6 kHz (glided, so a change never clicks).
//   MID           - DIP / NEUTRAL / PUSH: a broad, gentle bell (Q 0.5) of -3 / 0 / +3 dB at 800 Hz.
//   HPF / LPF     - 12 dB/oct, HPF 20 - 400 Hz (fully left = off), LPF 2.5 - 20 kHz (fully right = off).
//   SAT LO / HI   - the "console channel" spin: a low saturator under the bass shelf and a mild exciter over the
//                   treble shelf. Each one's drive follows its shelf's boost (boost the bass = more weight, not
//                   just more level) and the level coming in. The SAT knob sets the amount (0 = clean).
//                   Anti-aliased curves (first-order antiderivative), DC blocked, zero latency.
//   LOW / HIGH WIDTH - side-only width in each shelf's region (0 = as it was, left = towards mono, right = wider).
//                   The side signal is split by its own first-order networks at the turnover points, so the side
//                   shelves' phase shifts differently from the mid: the image opens up without delay or chorus.
//                   Only the side changes, so it all cancels in mono.
//   OUTPUT        - level. IN switches the tone controls (shelves + MID) out, glided.
// DRIFT (0 - 100 %, 50 % = standard): only SAT and WIDTH wander - each side's SAT drive (about +/-15 %) and the
//   side WIDTH gains (about +/-0.6 dB, only while a WIDTH knob is off its centre). The shelves never drift.
// GUI: a hi-fi fascia - BASS and TREBLE desk knobs in the band colours with their TURNOVER keys, HPF / LOW WIDTH /
//   SAT LO beside BASS, LPF / HIGH WIDTH / SAT HI beside TREBLE, the response curve with the MID keys between
//   them, and DRIFT, TRIM + GUARD, SAT, OUTPUT and an LED level meter along the foot.
// Latency: 0 samples.
//
// STATUS: Stable v2.0 (reinstated from the archive with a new panel, 21 Oct 2026).

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc

slider1:0<-12,12,0.5>-Bass (dB)
slider2:0<-12,12,0.5>-Treble (dB)
slider3:1<0,2,1{75 Hz,150 Hz,300 Hz}>-Bass turnover
slider4:1<0,2,1{1.5 kHz,3 kHz,6 kHz}>-Treble turnover
slider5:0<-12,12,0.1>-Output (dB)
slider6:1<0,1,1{Out,In}>-Tone in
slider7:0<-24,12,0.1>-Input trim (dB)
slider8:1<0,1,1{Off,On}>-Input guard
slider9:25<0,100,1>-Drift amount (%)
slider10:0.25<0.02,2,0.01>-Drift speed (Hz)
slider11:0<0,100,1>-Sat amount (%)
slider12:30<0,100,1>-(unused, was bias)
slider13:120<40,400,1>-(unused, was sat low band)
slider14:6000<2000,16000,10>-(unused, was sat high band)
slider15:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider16:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider17:50<0,100,1>-Drift (%)
slider18:20<20,400,1>-HPF (Hz)
slider19:20000<2500,20000,10>-LPF (Hz)
slider20:0<-100,100,1>-Low width (%)
slider21:0<-100,100,1>-High width (%)
slider22:1<0,2,1{Dip,Neutral,Push}>-Mid
slider23:1<0,1,1{Off,On}>-Sat low
slider24:1<0,1,1{Off,On}>-Sat high

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-bi-q";                                       // the ? pop-up links to this manual
ext_noinit = 1;
CR = 16;                                                    // filter coefficients every 16 samples

// ---------- first-order shelves (bilinear, prewarped): the broad Baxandall slopes ----------
// low shelf  H(s) = (s + w*sqrt(G)) / (s + w/sqrt(G))        DC gain G, HF 1, half-way (in dB) at w
// high shelf H(s) = G (s + w/sqrt(G)) / (s + w*sqrt(G))      DC 1, HF gain G, half-way at w
function sh_set(hi, f, gdb) instance(b0, b1, a1) local(k, g, r, n) (
  k = tan($pi * min(f, srate * 0.45) / srate); g = 10 ^ (gdb / 20); r = sqrt(g);
  hi ? (
    n = 1 / k + r; b0 = g * (1 / k + 1 / r) / n; b1 = g * (-1 / k + 1 / r) / n; a1 = (-1 / k + r) / n;
  ) : (
    n = 1 / k + 1 / r; b0 = (1 / k + r) / n; b1 = (-1 / k + r) / n; a1 = (-1 / k + 1 / r) / n;
  );
);
function sh_run(x) instance(b0, b1, a1, x1, y1) local(y) (
  y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y;
);
function tone_set(fm, gm) instance(lo, hi) (
  lo.sh_set(0, bf_s * fm, tone_on * bass_g * gm);
  hi.sh_set(1, tf_s * fm, tone_on * treb_g * gm);
);
function tone_run(x) instance(lo, hi) ( hi.sh_run(lo.sh_run(x)); );

// ---------- MID: a broad peaking bell (RBJ), coefficients shared by both sides; gain 0 = exactly flat ----------
function mid_coef(f, q, gdb) local(a, w, al, a0) (
  a = 10 ^ (gdb / 40); w = 2 * $pi * f / srate; al = sin(w) / (2 * q); a0 = 1 + al / a;
  MB0 = (1 + al * a) / a0; MB1 = -2 * cos(w) / a0; MB2 = (1 - al * a) / a0; MA1 = MB1; MA2 = (1 - al / a) / a0;
);
function mid_run(x) instance(x1, x2, y1, y2) local(y) (
  y = MB0 * x + MB1 * x1 + MB2 * x2 - MA1 * y1 - MA2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);

// ---------- 12 dB/oct state-variable filters (TPT, stay clean while they move) ----------
function svf_lp(x, a1, a2, a3) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; v2;
);
function svf_hp(x, a1, a2, a3) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; x - 1.41421356 * v1 - v2;
);
function filt_coefs() local(g) (
  hp_ls += (log(hp_ft) - hp_ls) * c_cr;  lp_ls += (log(lp_ft) - lp_ls) * c_cr;
  hp_m += (hp_on - hp_m) * c_cr;  abs(hp_m - hp_on) < 0.0001 ? hp_m = hp_on;
  lp_m += (lp_on - lp_m) * c_cr;  abs(lp_m - lp_on) < 0.0001 ? lp_m = lp_on;
  g = tan($pi * min(exp(hp_ls), srate * 0.45) / srate);
  HA1 = 1 / (1 + g * (g + 1.41421356)); HA2 = g * HA1; HA3 = g * HA2;
  g = tan($pi * min(exp(lp_ls), srate * 0.45) / srate);
  LA1 = 1 / (1 + g * (g + 1.41421356)); LA2 = g * LA1; LA3 = g * LA2;
);

// ---------- SAT: anti-aliased soft curve f(u) = u / sqrt(1 + u^2), F(u) = sqrt(1 + u^2) ----------
// Over the step from the last input: (F(z) - F(z1)) / (z - z1) = (z + z1) / (F(z) + F(z1)) - no small division.
// Scaled to unity small-signal gain round the bias point; returns only what the curve adds (beyond the
// half-sample average of the input), so a clean signal is never touched.
function sat_add(x, k, b) instance(x1) local(z, z1, fb, d, y) (
  z = k * (x + b); z1 = k * (x1 + b);
  fb = k * b / sqrt(1 + k * b * k * b); d = 1 + k * b * k * b; d = k / (d * sqrt(d));
  y = (z + z1) / (sqrt(1 + z * z) + sqrt(1 + z1 * z1));
  y = (y - fb) / d - 0.5 * (x + x1);
  x1 = x; y;
);
// one side: low band under the bass shelf, high band over the treble shelf, the added parts DC blocked
function sat_run(x, dk) instance(lo, hi, sat_lo, sat_hi, dcx, dcy) local(a) (
  a = 0;
  slo_m > 0 ? a += slo_m * sat_lo.sat_add(lo.svf_lp(x, SLA1, SLA2, SLA3), 1 + (slo_k - 1) * dk, slo_b) : lo.svf_lp(x, SLA1, SLA2, SLA3);
  shi_m > 0 ? a += shi_m * sat_hi.sat_add(hi.svf_hp(x, SHA1, SHA2, SHA3), 1 + (shi_k - 1) * dk, shi_b) : hi.svf_hp(x, SHA1, SHA2, SHA3);
  dcy = a - dcx + 0.9995 * dcy; dcx = a;
  x + sat_w * dcy;
);

function update() (
  bass_f = slider3 == 0 ? 75 : slider3 == 1 ? 150 : 300;
  treb_f = slider4 == 0 ? 1500 : slider4 == 1 ? 3000 : 6000;
  out_t = 10 ^ (slider5 / 20);
  drift_macro(slider17);                 // DRIFT dial: 50% = the drift settings, 100% = twice, 0 = none
  drift = slider9 / 100 * dm_a; dspd = slider10 * dm_s;
  in_setup(slider7, slider8);
  hp_on = slider18 > 20.5; hp_ft = max(slider18, 20);
  lp_on = slider19 < 19990; lp_ft = min(slider19, 20000);
  mid_t = slider22 < 0.5 ? -3 : slider22 > 1.5 ? 3 : 0;
);

dFL.drift_init(0.8 + rand(1)); dFR.drift_init(0.8 + rand(1));
dGL.drift_init(0.8 + rand(1)); dGR.drift_init(0.8 + rand(1));
in_init();
sm = 1 - exp(-1 / (0.03 * srate));
c_cr = 1 - exp(-CR / (0.03 * srate));
!ui_dflt ? ui_sz = 0;                   // first instance: M size (later loads restore their own)
ui_dflt = 1;
update();
bass_g = slider1; treb_g = slider2; tone_on = slider6; out_s = out_t;
bf_s = bass_f; tf_s = treb_f; mid_g = mid_t * tone_on;
hp_ls = log(hp_ft); lp_ls = log(lp_ft); hp_m = hp_on; lp_m = lp_on; cnt = 0;
wl_s = slider20 / 100; wh_s = slider21 / 100;
slo_m = slider23; shi_m = slider24; sat_a = slider11 / 100;

@slider
update();

@block
update();
bs = 1 - exp(-samplesblock / (0.03 * srate));
bass_g += (slider1 - bass_g) * bs; treb_g += (slider2 - treb_g) * bs; tone_on += (slider6 - tone_on) * bs;
// turnovers glide in octaves
bf_s *= (bass_f / bf_s) ^ bs;  abs(bf_s / bass_f - 1) < 0.000001 ? bf_s = bass_f;
tf_s *= (treb_f / tf_s) ^ bs;  abs(tf_s / treb_f - 1) < 0.000001 ? tf_s = treb_f;
dinc = dspd * samplesblock / srate;
vfL = dFL.drift_tick(dinc); vfR = dFR.drift_tick(dinc);
vgL = dGL.drift_tick(dinc); vgR = dGR.drift_tick(dinc);
tL.tone_set(1, 1);  tR.tone_set(1, 1);                 // the shelves never drift (JG, 21 Oct 2026)
// DRIFT: each side's SAT drive and side WIDTH gains wander on their own
sdL = 1 + 0.6 * drift * vfL;  sdR = 1 + 0.6 * drift * vfR;
// MID (switched out with the tone controls)
mid_g += (mid_t * (slider6 >= 0.5) - mid_g) * bs;  abs(mid_g - mid_t * (slider6 >= 0.5)) < 0.000001 ? mid_g = mid_t * (slider6 >= 0.5);
mid_coef(800, 0.5, mid_g);
// SAT: amount, keys, drive from each shelf's boost
sat_a += (slider11 / 100 - sat_a) * bs;  abs(sat_a - slider11 / 100) < 0.000001 ? sat_a = slider11 / 100;
slo_m += (slider23 - slo_m) * bs;  abs(slo_m - slider23) < 0.0001 ? slo_m = slider23;
shi_m += (slider24 - shi_m) * bs;  abs(shi_m - slider24) < 0.0001 ? shi_m = slider24;
sat_w = min(sat_a * 3, 1);
// (at full SAT and +12 dB the curve bends about 1 dB at -18 dBFS in the band, 3 dB at -12 dBFS)
slo_k = 1 + 3 * sat_a * (0.35 + 0.65 * max(bass_g * tone_on, 0) / 12);   slo_b = 0.15 / slo_k;
shi_k = 1 + 4 * sat_a * (0.35 + 0.65 * max(treb_g * tone_on, 0) / 12);   shi_b = 0.1 / shi_k;
u_g = tan($pi * min(bf_s * 1.5, srate * 0.45) / srate);  SLA1 = 1 / (1 + u_g * (u_g + 1.41421356)); SLA2 = u_g * SLA1; SLA3 = u_g * SLA2;
u_g = tan($pi * min(tf_s, srate * 0.45) / srate);        SHA1 = 1 / (1 + u_g * (u_g + 1.41421356)); SHA2 = u_g * SHA1; SHA3 = u_g * SHA2;
// WIDTH: side gains per band (left = towards mono, right = up to +5 dB of side), side split at the turnovers
wl_s += (slider20 / 100 - wl_s) * bs;  abs(wl_s - slider20 / 100) < 0.000001 ? wl_s = slider20 / 100;
wh_s += (slider21 / 100 - wh_s) * bs;  abs(wh_s - slider21 / 100) < 0.000001 ? wh_s = slider21 / 100;
wl_g = (wl_s < 0 ? 1 + wl_s : 1 + 0.8 * wl_s) * (1 + 0.3 * drift * vgL);
wh_g = (wh_s < 0 ? 1 + wh_s : 1 + 0.8 * wh_s) * (1 + 0.3 * drift * vgR);
w_on = wl_s != 0 || wh_s != 0;
wl_c = 1 - exp(-2 * $pi * bf_s / srate);  wh_c = 1 - exp(-2 * $pi * tf_s / srate);
grd_disp = max(grd_disp, in_grd); in_grd = 0;          // GUARD lamp (the GUI reads and clears grd_disp)

@serialize
file_var(0, ui_sz);

@sample
in_process(spl0, spl1);
l = in_l; r = in_r;
// HPF / LPF (each fades in and out with its OFF position)
(cnt -= 1) <= 0 ? ( cnt = CR; filt_coefs(); );
hp_m > 0 ? ( l += (fHL.svf_hp(l, HA1, HA2, HA3) - l) * hp_m;  r += (fHR.svf_hp(r, HA1, HA2, HA3) - r) * hp_m; );
lp_m > 0 ? ( l += (fLL.svf_lp(l, LA1, LA2, LA3) - l) * lp_m;  r += (fLR.svf_lp(r, LA1, LA2, LA3) - r) * lp_m; );
// BASS / TREBLE, MID
l = tL.tone_run(l); r = tR.tone_run(r);
mid_g != 0 ? ( l = mL.mid_run(l); r = mR.mid_run(r); ) : ( mL.x1 = mL.y1 = l; mL.x2 = mL.y2 = l; mR.x1 = mR.y1 = r; mR.x2 = mR.y2 = r; );
// SAT LO / HI
sat_w > 0 ? ( l = sL.sat_run(l, sdL); r = sR.sat_run(r, sdR); );
// LOW / HIGH WIDTH: side only
u_s = 0.5 * (l - r);
w_lo += (u_s - w_lo) * wl_c;  w_lp2 += (u_s - w_lp2) * wh_c;     // the side's own networks (always running)
w_on ? (
  u_m = 0.5 * (l + r);
  u_hi = u_s - w_lp2;
  u_s = w_lo * wl_g + (u_s - w_lo - u_hi) + u_hi * wh_g;
  l = u_m + u_s; r = u_m - u_s;
);
out_s += (out_t - out_s) * sm;
spl0 = l * out_s;
spl1 = r * out_s;
out_disp = max(out_disp, max(abs(spl0), abs(spl1)));

@gfx 1080 520
// =====================================================================
// GUI - a 70s hi-fi fascia: champagne plate, three recessed plates (BASS, RESPONSE, TREBLE) and a
// foot strip for the I/O. Desk knobs in the band colours (LF brown, HF red; HPF yellow, LPF black), centre-zero
// WIDTH knobs (blue low, red high), cream selector keys with amber LEDs for TURNOVER, orange SAT lamp keys,
// MID keys with their own LEDs, an amber IN lamp key. Values show only while a knob is touched.
// =====================================================================
function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function u_db(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_l(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
// house drop shadow: light from the top left, 4 soft layers at 13 % black, (+2, +3) to (+6, +8)
function shadow_r(x, y, w, h, r) local(i) (
  i = 0;  loop(4, col(0x000000, 0.13);  lk_rr(x + 2 + i * 1.33, y + 3 + i * 1.67, w + i, h + i, r + i);  i += 1; );
);
function shadow_c(x, y, rr) local(i) (
  i = 0;  loop(4, col(0x000000, 0.13);  gfx_circle(x + ps(2 + i * 1.33), y + ps(3 + i * 1.67), rr + ps(i * 0.6), 1, 1);  i += 1; );
);
function rivet(x, y) (
  col(0x8E8676, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.6); gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
// a recessed plate: a shade of the fascia, shaded top + left inside (light from the top left), its name plate
function plate(x, y, w, h, c, title) (
  col(c, 1);  u_rect(x, y, w, h);
  col(0x000000, 0.16);  u_rect(x, y, w, 2);  u_rect(x, y + 2, 2, h - 2);       // one L: the corner shaded once
  col(0xFFFFFF, 0.45);  u_rect(x + 2, y + h - 1, w - 2, 1);  u_rect(x + w - 1, y + 2, 1, h - 3);
  strlen(title) ? ( gfx_setfont(4);  col(C_INK, 1);  text_l(px(x + 16), py(y + 20), title); );
);
function param_touched(idx) ( slider_automate(2 ^ (idx - 1)); );
// pointer as a filled quad, with anti-aliased edges: clean at any angle
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 2 ? sprintf(#kv, "%d %%", v) :
  fmt == 3 ? ( v <= 20.5 ? strcpy(#kv, "OFF") : sprintf(#kv, "%d Hz", v); ) :
  fmt == 5 ? ( v >= 19990 ? strcpy(#kv, "OFF") : sprintf(#kv, "%.1f kHz", v / 1000); ) :
  fmt == 4 ? ( abs(v) < 0.5 ? strcpy(#kv, "0 %") : sprintf(#kv, "%+d %%", v); ) :
             sprintf(#kv, "%.1f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(0x1E1B17, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(0xF2E8D0, 1);  text_c(x, y, str);
);

// Desk knob: grey skirt, light body, flat coloured cap, full-length pointer, a ring of scale dots.
// kstep > 0 before a call: detents (Shift = free); klog = 1: log taper; kctr = 1: centre-zero value arc;
// ktop = 1: the label above the knob (the end figures stay below it). #klo / #khi: the end figures; kzero = 1: a "0" over the top dot.
// Drag 220 px (Shift 1100), wheel 3 % (Shift 0.5 %), double-click / Ctrl-click = default.
function kn(cx, cy, r, idx, vmin, vmax, def, cap, pcol, lbl, fmt)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, st, w, h, fine, lg)
(
  st = kstep;  kstep = 0;  lg = klog;  klog = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);  fine = mouse_cap & 8;
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx && !sz_help ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = -1;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t;  drag_mv = 0; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 && !fine ? v = max(vmin, min(vmax, floor((v - vmin) / st + 0.5) * st + vmin + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * (fine ? 0.005 : 0.03)));
      v = lg ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    !drag_mv && abs(mouse_y - drag_y) > ps(3) ? ( drag_mv = 1;  drag_y = mouse_y; );     // 3 px dead zone
    drag_mv ? (
      drag_t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps(fine ? 1100 : 220)));  drag_y = mouse_y;
      v = lg ? vmin * exp(drag_t * log(vmax / vmin)) : vmin + drag_t * (vmax - vmin);
      v = st > 0 && !fine ? vmin + floor((v - vmin) / st + 0.5) * st : lg ? floor(v + 0.5) : floor(v * 100 + 0.5) / 100;
      v = max(vmin, min(vmax, v));
      v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  // scale dots, the "0" mark, the end figures
  col(C_INK, 0.75);  j = 0;
  loop(11, b = a0 + j / 10 * (a1 - a0);  gfx_circle(x + sin(b) * (rr + ps(7)), y - cos(b) * (rr + ps(7)), ps(r > 24 ? 1.6 : 1.2), 1, 1);  j += 1; );
  gfx_setfont(5);  col(C_INK, 0.85);
  kzero ? text_c(x, y - rr - ps(17), "0");
  strlen(#klo) ? ( gfx_measurestr(#klo, w, h);  gfx_x = x + sin(a0) * (rr + ps(13)) - w;  gfx_y = y - cos(a0) * (rr + ps(13)) - h * 0.2;  gfx_drawstr(#klo); );
  strlen(#khi) ? ( gfx_x = x + sin(a1) * (rr + ps(13));  gfx_y = y - cos(a1) * (rr + ps(13)) - h * 0.2;  gfx_drawstr(#khi); );
  strcpy(#klo, "");  strcpy(#khi, "");  kzero = 0;
  // kctr = 1: a value arc in the cap colour from the top (the centre zero) to the pointer
  kctr ? (
    col(C_INK, 0.9);  gfx_circle(x, y - rr - ps(7), ps(2.4), 1, 1);
    col(cap, 0.95);  j = 0;
    loop(3, gfx_arc(x, y, rr + ps(2.5 + j * 0.8), min(0, tv), max(0, tv), 1);  j += 1; );
  );  kctr = 0;
  // the knob: shadow, skirt, body, cap with its edge vignette and highlight, pointer
  shadow_c(x, y, rr);
  col(0x8A8C86, 1);     gfx_circle(x, y, rr, 1, 1);
  col(0x5E605B, 1);     gfx_circle(x, y, rr, 0, 1);
  col(0xC9C7BF, 1);     gfx_circle(x, y, rr * 0.78, 1, 1);
  col(0x000000, 0.10);  gfx_circle(x, y, rr * 0.78, 0, 1);  gfx_circle(x, y, rr * 0.77, 0, 1);
  col(shade(cap, 0.86), 1);  gfx_circle(x, y, rr * 0.6, 1, 1);
  col(cap, 1);          gfx_circle(x - ps(0.5), y - ps(0.5), rr * 0.56, 1, 1);
  col(0xFFFFFF, 0.28);  gfx_arc(x, y, rr * 0.52, -1.7, -0.2, 1);
  col(shade(cap, 0.7), 1);  gfx_circle(x, y, rr * 0.6, 0, 1);
  col(pcol, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.97, ps(r > 24 ? 1.7 : 1.3));
  strlen(lbl) ? ( gfx_setfont(6);  col(C_INK, 1);  text_c(x, ktop ? y - rr - ps(22) : y + rr + ps(19), lbl); );  ktop = 0;
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(r > 24 ? 40 : 18), fmtv(v, fmt));
);

// ---------- house lamp key (as on the Cherwell units): a coloured lens in a dark well ----------
LK_AMB = 0xF2A41E;  lk_well = 0x141518;
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !sz_help;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  shadow_r(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(9);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
// ---------- cream selector key with an amber LED (the house "Q22 white" key) ----------
function ck_key(x, y, w, h, on, str) local(hov, hit, b, dn, tw, th) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !sz_help;
  b = 1.5;  dn = on ? 0 : 1.5;
  shadow_r(x, y, w, h, 2);
  col(0x16140F, 1);  u_rect(x, y, w, h);
  col(on ? 0xEDE5CF : 0xBDB6A6, 1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn);
  on ? (
    col(0xFFFFFF, 0.55);  u_rect(x + b, y + b, w - 2 * b, 1);
    col(0x000000, 0.14);  u_rect(x + b, y + h - b - 2, w - 2 * b, 2);  u_rect(x + w - b - 2, y + b, 2, h - 2 * b - 2);
  ) : (
    col(0x000000, 0.3);  u_rect(x + b, y + b + dn, w - 2 * b, 1.5);
  );
  hov ? ( col(0xFFFFFF, 0.1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn); );
  on ? (
    col(0xFFB030, 0.35);  gfx_circle(px(x + 8), py(y + 8), ps(5), 1, 1);
    col(0xFFB030, 1);     gfx_circle(px(x + 8), py(y + 8), ps(2.6), 1, 1);
    col(0xFFFFFF, 0.6);   gfx_circle(px(x + 7.3), py(y + 7.3), ps(0.9), 1, 1);
  ) : ( col(0x6B5A3C, 1);  gfx_circle(px(x + 8), py(y + 8 + dn), ps(2.6), 1, 1); );
  gfx_setfont(9);  gfx_measurestr(str, tw, th);  col(on ? 0x2A2620 : 0x57524A, 1);
  gfx_x = px(x + w * 0.5 + 4) - tw * 0.5;  gfx_y = py(y + h * 0.5 + dn * 0.5 + 1) - th * 0.5;  gfx_drawstr(str);
  hit;
);

// ---------- MID key: a small cream key with its own round LED above it (lit in its colour when chosen) ----------
function md_key(x, y, w, h, on, c, str) local(hov, hit, tw, th, lx, ly) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y - 18) && mouse_y < py(y + h);
  hit = click && hov && !sz_help;
  lx = x + w * 0.5;  ly = y - 11;
  col(0x140A08, 1);  gfx_circle(px(lx), py(ly), ps(5.5), 1, 1);
  on ? (
    col(c, 0.3);  gfx_circle(px(lx), py(ly), ps(9), 1, 1);
    col(c, 1);    gfx_circle(px(lx), py(ly), ps(3.8), 1, 1);
    col(0xFFFFFF, 0.6);  gfx_circle(px(lx - 1.2), py(ly - 1.2), ps(1.1), 1, 1);
  ) : ( col(shade(c, 0.4), 1);  gfx_circle(px(lx), py(ly), ps(3.8), 1, 1); );
  shadow_r(x, y, w, h, 2);
  col(0x16140F, 1);  u_rect(x, y, w, h);
  col(on ? 0xEDE5CF : 0xC9C2B2, 1);  u_rect(x + 1.5, y + 1.5 + !on, w - 3, h - 3 - !on);
  col(0xFFFFFF, on ? 0.55 : 0.3);  u_rect(x + 1.5, y + 1.5 + !on, w - 3, 1);
  col(0x000000, 0.14);  u_rect(x + 1.5, y + h - 3.5, w - 3, 2);  u_rect(x + w - 3.5, y + 1.5, 2, h - 3);
  hov ? ( col(0xFFFFFF, 0.1);  u_rect(x + 1.5, y + 1.5, w - 3, h - 3); );
  gfx_setfont(9);  gfx_measurestr(str, tw, th);  col(on ? 0x2A2620 : 0x57524A, 1);
  gfx_x = px(x + w * 0.5) - tw * 0.5;  gfx_y = py(y + h * 0.5 + 0.5 * !on) - th * 0.5;  gfx_drawstr(str);
  hit;
);

// ---------- response: the whole curve from the analogue prototypes (prewarped, as the DSP) ----------
function rsp_mag(w, n2, n1, n0, d2, d1, d0) local(nr, ni, dr_, di) (
  nr = n0 - n2 * w * w;  ni = n1 * w;  dr_ = d0 - d2 * w * w;  di = d1 * w;
  sqrt((nr * nr + ni * ni) / max(dr_ * dr_ + di * di, 0.00000000000000000001));
);
function rsp_db(f) local(k, w, g, m, a) (
  m = 1;
  k = tan($pi * min(f, 0.49 * srate) / srate);
  slider18 > 20.5 ? ( w = k / tan($pi * min(slider18, 0.45 * srate) / srate);  m *= rsp_mag(w, 1, 0, 0, 1, 1.41421356, 1); );
  slider19 < 19990 ? ( w = k / tan($pi * min(slider19, 0.45 * srate) / srate);  m *= rsp_mag(w, 0, 0, 1, 1, 1.41421356, 1); );
  slider6 >= 0.5 ? (
    w = k / tan($pi * min(r_bf, 0.45 * srate) / srate);  g = 10 ^ (slider1 / 20);
    m *= sqrt((w * w + g) / (w * w + 1 / g));
    w = k / tan($pi * min(r_tf, 0.45 * srate) / srate);  g = 10 ^ (slider2 / 20);
    m *= g * sqrt((w * w + 1 / g) / (w * w + g));
    r_mid != 0 ? (
      a = 10 ^ (r_mid / 40);  w = k / tan($pi * 800 / srate);
      m *= rsp_mag(w, 1, a / 0.5, 1, 1, 1 / (a * 0.5), 1);
    );
  );
  20 * log10(max(m, 0.000001));
);
function response(x, y, w, h) local(i, f, d, yy, lx, ly, gx, mx) (
  col(0x000000, 0.3);  u_rect(x - 3, y - 3, w + 6, h + 6);
  col(0x8E8676, 1);    u_rect(x - 2, y - 2, w + 4, h + 4);
  col(C_DISP, 1);      u_rect(x, y, w, h);
  col(0x000000, 0.35); u_rect(x, y, w, 2);  u_rect(x, y + 2, 2, h - 2);
  // grid: 100 Hz, 1 kHz, 10 kHz; +/-6, +/-12 dB (the display spans +/-15 dB)
  col(0x3A342C, 1);
  i = 0;  loop(3, gx = x + w * (log10(100 * 10 ^ i) - log10(20)) / 3;  gfx_line(px(gx), py(y), px(gx), py(y + h), 1);  i += 1; );
  i = -2;  loop(5, yy = y + h * 0.5 - i * 6 * h / 30;  gfx_line(px(x), py(yy), px(x + w), py(yy), 1);  i += 1; );
  col(0x5A5044, 1);  gfx_line(px(x), py(y + h * 0.5), px(x + w), py(y + h * 0.5), 1);
  gfx_setfont(5);  col(0x9C8E78, 1);
  gfx_x = px(x + w * (2 - log10(20)) / 3) + ps(4);  gfx_y = py(y + h - 18);  gfx_drawstr("100");
  gfx_x = px(x + w * (3 - log10(20)) / 3) + ps(4);  gfx_y = py(y + h - 18);  gfx_drawstr("1k");
  gfx_x = px(x + w * (4 - log10(20)) / 3) + ps(4);  gfx_y = py(y + h - 18);  gfx_drawstr("10k");
  gfx_x = px(x + 6);  gfx_y = py(y + h * 0.5 - 12 * h / 30) - ps(15);  gfx_drawstr("+12");
  gfx_x = px(x + 6);  gfx_y = py(y + h * 0.5 + 12 * h / 30) + ps(2);  gfx_drawstr("-12");
  // the curve (dimmed while the tone controls are switched out)
  i = 0;  mx = slider6 >= 0.5 ? 1 : 0.6;
  loop(181,
    f = 20 * 10 ^ (3 * i / 180);
    d = max(-15, min(15, rsp_db(f)));
    yy = y + h * 0.5 - d * h / 30;
    lx = x + w * i / 180;
    i > 0 ? (
      col(0xF2A41E, 0.22 * mx);  gfx_line(px(gx), py(ly) + ps(1.5), px(lx), py(yy) + ps(1.5), 1);
      col(0xF6C04A, mx);         gfx_line(px(gx), py(ly), px(lx), py(yy), 1);  gfx_line(px(gx), py(ly) + 1, px(lx), py(yy) + 1, 1);
    );
    gx = lx;  ly = yy;  i += 1;
  );
);

// ---------- output LED meter: -42..+3 dBFS in 3 dB steps, peak hold 1.2 s then 0.6 dB / frame ----------
function ledmeter(x, y, w, h, db, pk) local(n, sw, j, d, c) (
  n = 15;  sw = w / n;
  col(0x000000, 0.3);  u_rect(x - 3, y - 3, w + 8, h + 8);
  col(0x16140F, 1);    u_rect(x - 4, y - 4, w + 8, h + 8);
  j = 0;
  loop(n,
    d = -42 + (j + 1) * 3;
    c = d > 0 ? 0xE0503A : d > -9 ? 0xE8C060 : 0x8FC47A;
    col(c, db >= d - 3 || (pk > d - 3 && pk <= d) ? 1 : 0.14);
    u_rect(x + j * sw + 1, y, sw - 2, h);
    j += 1;
  );
);

// ---------- frame setup ----------
C_FACE = 0xD8D0BE;  C_PL1 = 0xCFC6B2;  C_PL2 = 0xC9C0AB;  C_PL3 = 0xD2CAB7;   // champagne fascia + three plate shades
C_INK = 0x2A2620;  C_INK2 = 0x6A6152;  C_DISP = 0x221E19;
C_BASS = 0x7A4A2C;  C_TREB = 0xB8392B;  C_HPF = 0xE2B33A;  C_LPF = 0x1E1F1E;  C_WLO = 0x2F6FB8;  C_WHI = 0xC23A2E;
LK_ORG = 0xE8782A;
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;                          // S / M / L
sc = g_ret * max(min(g_want, min(gfx_w / (1080 * g_ret), gfx_h / (520 * g_ret))), 0.5);
ox = floor((gfx_w - 1080 * sc) * 0.5);
oy = floor((gfx_h - 520 * sc) * 0.5);
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
r_bf = slider3 < 0.5 ? 75 : slider3 < 1.5 ? 150 : 300;
r_tf = slider4 < 0.5 ? 1500 : slider4 < 1.5 ? 3000 : 6000;
r_mid = slider22 < 0.5 ? -3 : slider22 > 1.5 ? 3 : 0;

gfx_setfont(1, "Trebuchet MS", ps(30), 'b');
gfx_setfont(3, "Trebuchet MS", ps(13), 'b');
gfx_setfont(4, "Trebuchet MS", ps(15), 'b');
gfx_setfont(5, "Trebuchet MS", ps(12), 'b');
gfx_setfont(6, "Trebuchet MS", ps(14), 'b');
gfx_setfont(9, "Trebuchet MS", ps(14), 'b');      // key legends: 14 px

// meter: decay, floating peak (click it to clear)
!g_init ? ( opk_h = -60;  g_init = 1; );
out_m = max(out_disp, out_m * 0.8);  u_pd = u_db(out_disp);  out_disp = 0;
u_now = time_precise();
u_pd >= opk_h ? ( opk_h = u_pd;  opk_t = u_now; ) : u_now - opk_t > 1.2 ? opk_h -= 0.6;
opk_h = max(opk_h, -60);
grd_on = grd_disp > 0.05 ? 6 : max(grd_on - 1, 0);  grd_disp = 0;

// ---------- fascia ----------
col(0x0E0F11, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(C_FACE, 1);  u_rect(0, 0, 1080, 520);
gx = 0;  loop(90, col(gx % 3 ? 0xFFFFFF : 0x000000, gx % 3 ? 0.05 : 0.025);  u_rect(4, 62 + gx * 5, 1072, 1);  gx += 1; );   // brushed grain
col(0x000000, 0.22);  u_rect(0, 517, 1080, 3);  u_rect(1077, 0, 3, 517);                                   // narrow darker edge
col(0xFFFFFF, 0.5);   u_rect(0, 0, 1077, 1);
rivet(8, 8);  rivet(1072, 8);  rivet(8, 512);  rivet(1072, 512);
// header: title, subtitle, IN, S / M / L / ?
gfx_setfont(1);  col(C_INK, 1);  gfx_x = px(24);  gfx_y = py(13);  gfx_drawstr("BI-Q");
gfx_setfont(5);  col(C_INK2, 1);  gfx_x += ps(14);  gfx_y = py(27);  gfx_drawstr("TONE CONTROL");
gfx_x += ps(12);  col(0xC0661E, 1);  gfx_drawstr("GFX");
lk_key(902, 15, 66, 30, slider6 >= 0.5, LK_AMB, "IN") ? ( slider6 = slider6 >= 0.5 ? 0 : 1;  param_touched(6); );
col(C_INK, 0.55);  u_rect(16, 60, 1048, 1.5);  col(0xFFFFFF, 0.5);  u_rect(16, 61.5, 1048, 1);

// ---------- BASS: the big knob and its TURNOVER keys; HPF, LOW WIDTH and SAT LO towards the centre ----------
plate(16, 76, 344, 300, C_PL1, "BASS");
strcpy(#klo, "-12");  strcpy(#khi, "+12");  kzero = 1;  kstep = 0.5;
kn(118, 200, 40, 1, -12, 12, 0, C_BASS, 0xF4F0E6, "", 1);
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(118), py(274), "TURNOVER");
ck_key(32, 290, 54, 30, slider3 < 0.5, "75") ? ( slider3 = 0;  param_touched(3); );
ck_key(91, 290, 54, 30, slider3 >= 0.5 && slider3 < 1.5, "150") ? ( slider3 = 1;  param_touched(3); );
ck_key(150, 290, 54, 30, slider3 >= 1.5, "300") ? ( slider3 = 2;  param_touched(3); );
col(C_INK, 0.25);  u_rect(222, 96, 1, 264);  col(0xFFFFFF, 0.4);  u_rect(223, 96, 1, 264);
klog = 1;  strcpy(#klo, "OFF");  strcpy(#khi, "400");  ktop = 1;
kn(290, 166, 20, 18, 20, 400, 20, C_HPF, 0x1E1F1E, "HPF", 3);
strcpy(#klo, "MONO");  strcpy(#khi, "WIDE");  kctr = 1;  ktop = 1;
kn(290, 264, 20, 20, -100, 100, 0, C_WLO, 0xF4F0E6, "LOW WIDTH", 4);
lk_key(254, 322, 72, 32, slider23 >= 0.5, LK_ORG, "SAT LO") ? ( slider23 = slider23 >= 0.5 ? 0 : 1;  param_touched(23); );

// ---------- RESPONSE + MID ----------
plate(376, 76, 328, 300, C_PL3, "RESPONSE");
response(392, 124, 296, 168);
gfx_setfont(5);  col(C_INK2, 1);  text_l(px(392), py(330), "MID");
md_key(434, 318, 76, 30, slider22 < 0.5, 0xFF4A30, "DIP") ? ( slider22 = 0;  param_touched(22); );
md_key(518, 318, 84, 30, slider22 >= 0.5 && slider22 < 1.5, 0xFFB030, "NEUTRAL") ? ( slider22 = 1;  param_touched(22); );
md_key(610, 318, 76, 30, slider22 >= 1.5, 0x5CD46E, "PUSH") ? ( slider22 = 2;  param_touched(22); );

// ---------- TREBLE: LPF, HIGH WIDTH and SAT HI towards the centre; the big knob and its TURNOVER keys ----------
plate(720, 76, 344, 300, C_PL1, "TREBLE");
klog = 1;  strcpy(#klo, "2.5k");  strcpy(#khi, "OFF");  ktop = 1;
kn(790, 166, 20, 19, 2500, 20000, 20000, C_LPF, 0xF4F0E6, "LPF", 5);
strcpy(#klo, "MONO");  strcpy(#khi, "WIDE");  kctr = 1;  ktop = 1;
kn(790, 264, 20, 21, -100, 100, 0, C_WHI, 0xF4F0E6, "HIGH WIDTH", 4);
lk_key(754, 322, 72, 32, slider24 >= 0.5, LK_ORG, "SAT HI") ? ( slider24 = slider24 >= 0.5 ? 0 : 1;  param_touched(24); );
col(C_INK, 0.25);  u_rect(856, 96, 1, 264);  col(0xFFFFFF, 0.4);  u_rect(857, 96, 1, 264);
strcpy(#klo, "-12");  strcpy(#khi, "+12");  kzero = 1;  kstep = 0.5;
kn(962, 200, 40, 2, -12, 12, 0, C_TREB, 0xF4F0E6, "", 1);
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(962), py(274), "TURNOVER");
ck_key(876, 290, 54, 30, slider4 < 0.5, "1.5k") ? ( slider4 = 0;  param_touched(4); );
ck_key(935, 290, 54, 30, slider4 >= 0.5 && slider4 < 1.5, "3k") ? ( slider4 = 1;  param_touched(4); );
ck_key(994, 290, 54, 30, slider4 >= 1.5, "6k") ? ( slider4 = 2;  param_touched(4); );
// tone switched out: the BASS and TREBLE knobs and the MID keys greyed (filters and width stay live)
slider6 < 0.5 ? (
  col(C_PL1, 0.5);  u_rect(18, 96, 202, 278);  u_rect(860, 96, 202, 278);
  col(C_PL3, 0.5);  u_rect(378, 300, 324, 74);
);

// ---------- foot strip: DRIFT | TRIM + GUARD | SAT, OUTPUT, level ----------
plate(16, 392, 1048, 112, C_PL2, "");
function vdiv(x) ( col(C_INK, 0.3);  u_rect(x, 410, 1, 76);  col(0xFFFFFF, 0.4);  u_rect(x + 1, 410, 1, 76); );
kn(76, 436, 15, 17, 0, 100, 50, 0x6B6458, 0xF4F0E6, "DRIFT", 2);
vdiv(140);
kn(204, 436, 15, 7, -24, 12, 0, 0xEEEFEA, 0x1E1F1E, "TRIM", 1);
lk_key(254, 420, 72, 28, slider8 >= 0.5, LK_AMB, "GUARD") ? ( slider8 = slider8 >= 0.5 ? 0 : 1;  param_touched(8); );
col(0x140A08, 1);  gfx_circle(px(290), py(470), ps(5), 1, 1);
col(0xFF4A30, grd_on > 0 ? 1 : 0.15);  gfx_circle(px(290), py(470), ps(3.4), 1, 1);
grd_on > 0 ? ( col(0xFF4A30, 0.3);  gfx_circle(px(290), py(470), ps(7), 1, 1); );
vdiv(354);
kn(420, 436, 15, 11, 0, 100, 0, LK_ORG, 0x1E1F1E, "SAT", 2);
kn(530, 433, 18, 5, -12, 12, 0, 0x1E1F1E, 0xF4F0E6, "OUTPUT", 1);
vdiv(594);
ledmeter(630, 429, 330, 14, u_db(out_m), opk_h);
gfx_setfont(5);  col(C_INK2, 1);
text_c(px(630), py(463), "-42");  text_c(px(630 + 22 * 7), py(463), "-21");
text_c(px(630 + 22 * 12), py(463), "-6");  text_c(px(630 + 22 * 14 + 11), py(463), "0");
opk_h <= -59.9 ? strcpy(#opk, "-inf") : sprintf(#opk, "%+.1f", opk_h);
col(0x16140F, 1);  u_rect(984, 425, 60, 22);
col(opk_h > 0 ? 0xE0503A : opk_h > -6 ? 0xE8C060 : 0xF2E8D0, 1);  gfx_setfont(3);  text_c(px(1014), py(436), #opk);
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1014), py(463), "PEAK");
click && mouse_x >= px(630) && mouse_x < px(1044) && mouse_y >= py(421) && mouse_y < py(449) ? opk_h = -60;

// ---------- S / M / L / ? (size picker and credits): four 13 x 18 keys on a 14 pitch ----------
g_j = 0;
loop(4,
  g_x = 998 + g_j * 14;  g_on = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(0x16140F, 1);  u_rect(g_x, 21, 13, 18);
  col(g_on ? 0xF2A41E : 0xEDE5CF, 1);  u_rect(g_x + 1, 22, 11, 16);
  gfx_setfont(5);  col(g_on ? 0x2A1A06 : 0x57524A, 1);  text_c(px(g_x + 6.5), py(30), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(21) && mouse_y < py(39) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
sz_help && click && !sz_new ? sz_help = 0;            // any click closes the pop-up
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
  gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
  g_cw = max(g_tw + ps(40), ps(380));  g_ch = ps(130);
  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(0xE0603A, 1);    gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(102);  gfx_drawstr("Click anywhere to close.");
);

// ---------- end of frame ----------
!lmb ? drag_idx = 0;
mouse_wheel = 0;
last_lmb = lmb;
