desc:Bern EQ [broadcast EQ] (GFX)
//tags: equalizer eq channel strip broadcast console analog transformer
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// gfx-bern-eq - three-band broadcast channel equaliser with transformer-coupled input and output stages
//
// The channel EQ in the spirit of the classic Swiss broadcast consoles: musical, very open and very clean, with
// discrete-transistor / transformer amplifiers that have so much headroom they only colour the sound when pushed.
// The companion of the Bern 16 summing mixer.
//
// CHAIN   IN -> INPUT trim -> input amplifier -> LOW -> MID -> HIGH -> output amplifier / transformer -> OUTPUT
//         -> the GFX output stage.
// INPUT   -18 .. +18 dB into the input amplifier (about +14 dB of headroom above 0 dBFS). Transparent at normal levels;
//         push it and a little even-harmonic warmth comes in, then a soft round limit. The WARMTH lamp shows how
//         hard the amplifier is working.
// LOW     SHELF: a gentle low shelf at 60 or 100 Hz, +/-15 dB (GAIN).
//         HPF: a clean 12 dB/oct high-pass at 40, 80 or 120 Hz instead (GAIN has no effect in HPF mode).
//         Choosing one of the 60 / 100 keys selects the shelf, one of the 40 / 80 / 120 keys the high-pass.
// MID     "presence": a bell sweepable from 150 Hz to 7 kHz, +/-15 dB. BROAD (Q 0.8) is the musical, moderately
//         broad curve; NARROW (Q 2) is for tighter work.
// HIGH    a smooth, open high shelf hinged at 10, 15 or 20 kHz (the half-gain point), +/-15 dB. A gentle
//         second-order slope made of two first-order sections, Baxandall-like: no bump, no harshness, glassy air.
// EQ IN   the three bands in or out (the amplifiers stay in, as on the desk).
// OUTPUT  -18 .. +18 dB after the output amplifier and transformer (its core thickens the lows first when driven).
// DRIFT   the supply voltage is not quite steady: the band gains and frequencies ease very slightly with it, and the
//         amplifiers' headroom breathes (a hot signal softens a little more when the rail sags). 0 - 100 %, 20 % default.
//
// Filters: matched (pole / zero matched to the analogue prototype) bell and high shelf, so the curves stay true
// right up to the top of the band without the usual digital cramping; parameters glide (30 ms) and coefficients are
// recomputed every 16 samples, so sweeping and switching never click.
//
// GUI: drag knobs (Shift = fine), double-click = reset. Click PRESETS or the LCD for the preset list.
// S / M / L / ? = size and help.
//
// Requires gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.

import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<-18,18,0.1>-Input (dB)
slider2:0<0,1,1{Shelf,High-pass}>-Low mode
slider3:1<0,1,1{60 Hz,100 Hz}>-Low shelf freq
slider4:0<-15,15,0.1>-Low gain (dB)
slider5:1<0,2,1{40 Hz,80 Hz,120 Hz}>-HPF freq
slider6:1200<150,7000,1>-Mid freq (Hz)
slider7:0<-15,15,0.1>-Mid gain (dB)
slider8:0<0,1,1{Broad,Narrow}>-Mid Q
slider9:1<0,2,1{10 kHz,15 kHz,20 kHz}>-High freq
slider10:0<-15,15,0.1>-High gain (dB)
slider11:1<0,1,1{Out,In}>-EQ In
slider12:0<-18,18,0.1>-Output (dB)
slider13:20<0,100,1>-Drift (%)
slider14:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider15:prs_sel=0<0,11,1{No preset,Init,Vocal Air,Broadcast Voice,Kick Weight,Guitar Presence,Bass Clean-Up,Mix Bus Sheen,Telephone,De-Mud,Piano Open,Warm Drive}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
#ui_man = "gfx-bern-eq";                                  // the ? pop-up links to this manual
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function db2g(d) ( exp(d*0.11512925465); );
ost_init(alloc(4096));

function bz_lsHz(i) ( i < 0.5 ? 60 : 100; );
function bz_hpHz(i) ( i < 0.5 ? 40 : i < 1.5 ? 80 : 120; );
function bz_hsHz(i) ( i < 0.5 ? 10000 : i < 1.5 ? 15000 : 20000; );
function bz_mq(i) ( i < 0.5 ? 0.8 : 2; );

// ---------- filter design (audio thread). c = [b0 b1 b2 a1 a2], y = b0 x + b1 x1 + b2 x2 - a1 y1 - a2 y2 ----------
// matched bell: poles matched to the analogue prototype, zeros fitted to its magnitude at DC, Nyquist and the centre
function bz_pk(c, f, g, q) local(A, w0, z, e, pa1, pa2, m0, m1, m2, p0, p1, p2, GG, R1, R2, B0, B1, B2, W, t) (
  A = 10^(g/40); w0 = 2*$pi*min(f, srate*0.45)/srate; z = 1/(2*A*q); e = exp(-z*w0);
  z <= 1 ? pa1 = -2*e*cos(w0*sqrt(1 - z*z)) : ( t = w0*sqrt(z*z - 1); pa1 = -e*(exp(t) + exp(-t)); );
  pa2 = e*e;
  m0 = sqr(1 + pa1 + pa2); m1 = sqr(1 - pa1 + pa2); m2 = -4*pa2;
  p1 = sqr(sin(w0*0.5)); p0 = 1 - p1; p2 = 4*p0*p1;
  GG = A*A;
  R1 = (m0*p0 + m1*p1 + m2*p2)*GG*GG;
  R2 = (-m0 + m1 + 4*(p0 - p1)*m2)*GG*GG;
  B0 = m0; B2 = (R1 - R2*p1 - B0)/(4*p1*p1); B1 = R2 + B0 + 4*(p1 - p0)*B2;
  W = 0.5*(sqrt(B0) + sqrt(max(B1, 0)));
  c[0] = 0.5*(W + sqrt(max(W*W + B2, 0))); c[1] = 0.5*(sqrt(B0) - sqrt(max(B1, 0))); c[2] = -B2/(4*c[0]);
  c[3] = pa1; c[4] = pa2;
);
// first-order high shelf, hinge f (half-gain point), matched pole, unity at DC and the analogue gain at Nyquist
function bz_hs(c, f, g) local(GG, w0, sg, wp, wz, pp, wn, hn, s, d) (
  GG = 10^(g/20); w0 = 2*$pi*f; sg = sqrt(GG); wp = w0*sg; wz = w0/sg;
  pp = exp(-wp/srate); wn = $pi*srate;
  hn = GG*sqrt((wn*wn + wz*wz)/(wn*wn + wp*wp));
  s = 1 - pp; d = hn*(1 + pp);
  c[0] = 0.5*(s + d); c[1] = 0.5*(s - d); c[2] = 0; c[3] = -pp; c[4] = 0;
);
// low shelf (RBJ, gentle slope)
function bz_ls(c, f, g, q) local(A, w, cs, al, sa, a0) (
  A = 10^(g/40); w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*q); sa = 2*sqrt(A)*al;
  a0 = (A + 1) + (A - 1)*cs + sa;
  c[0] = A*((A + 1) - (A - 1)*cs + sa)/a0; c[1] = 2*A*((A - 1) - (A + 1)*cs)/a0; c[2] = A*((A + 1) - (A - 1)*cs - sa)/a0;
  c[3] = -2*((A - 1) + (A + 1)*cs)/a0; c[4] = ((A + 1) + (A - 1)*cs - sa)/a0;
);
// high-pass (Butterworth 12 dB/oct)
function bz_hp(c, f) local(w, cs, al, a0) (
  w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*0.70711); a0 = 1 + al;
  c[0] = (1 + cs)*0.5/a0; c[1] = -(1 + cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0;
);
function bz_bq(x, c, s) local(y) (
  y = c[0]*x + c[1]*s[0] + c[2]*s[1] - c[3]*s[2] - c[4]*s[3];
  s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y;
  y;
);

// ---------- memory: coefficients and per-channel states ----------
bz_cLS = alloc(5); bz_cHP = alloc(5); bz_cPK = alloc(5); bz_cHS = alloc(5);
bz_sLS0 = alloc(4); bz_sLS1 = alloc(4); bz_sHP0 = alloc(4); bz_sHP1 = alloc(4);
bz_sPK0 = alloc(4); bz_sPK1 = alloc(4);
bz_sHa0 = alloc(4); bz_sHa1 = alloc(4); bz_sHb0 = alloc(4); bz_sHb1 = alloc(4);
// GUI-thread coefficient copies (the response window)
gz_cLS = alloc(5); gz_cHP = alloc(5); gz_cPK = alloc(5); gz_cHS = alloc(5);

// ---------- the amplifiers ----------
// input: discrete transistor stage - even harmonics that only appear when pushed, then a soft round limit about
// +14 dB over 0 dBFS
function bz_inamp(x) instance(dx, dy) local(u, y, d) (
  u = x*bz_ihI;
  y = min(max(u, -4), 4); y = u + 0.3*abs(y)*y*y;      // even products grow with the square of the level
  y = y/sqrt(sqrt(1 + sqr(sqr(y))));
  d = y - u;                                       // what the stage adds, DC-blocked so the clean part stays exact
  dy = d - dx + bz_dcR*dy; dx = d;
  (u + dy)*bz_hrI;
);
// output: amplifier into the transformer - the core thickens the lows first, then the amplifier rounds the peaks
function bz_outamp(x) instance(lp) local(lo, k, y) (
  lp += (x - lp)*bz_lpc;
  k = lp*bz_ihO*1.6;
  lo = lp/sqrt(1 + k*k);
  y = (x - lp + lo)*bz_ihO;
  y = y/sqrt(sqrt(1 + sqr(sqr(y))));
  y*bz_hrO;
);

// ---------- parameters: targets in @block, glided every 16 samples in @sample ----------
bz_dV = 0; bz_dT = 0; bz_dW = 0; bz_mOut = 0; bz_heat = 0; bz_cnt = 0; bz_first = 1;
bz_dcR = 1 - 2*$pi*4/srate;
bz_lpc = 1 - exp(-2*$pi*140/srate);
bz_kS = 1 - exp(-16/(0.03*srate));                 // 30 ms glide, stepped every 16 samples
bz_kD = 1 - exp(-1/(0.03*srate));                  // per-sample glide for the gains and the crossfades

function bz_targets() local(v, gk, fk) (
  v = bz_dV*slider13/100;                         // -1 .. +1 at 100 %: the rail wandering about its nominal
  gk = 1 + 0.025*v; fk = 1 + 0.006*v;              // gains ease by up to 2.5 %, frequencies by up to 0.6 %
  bz_tLg = slider4*gk;   bz_tLf = log(bz_lsHz(slider3)*fk);
  bz_tHp = log(bz_hpHz(slider5)*fk);
  bz_tMg = slider7*gk;   bz_tMf = log(min(max(slider6, 150), 7000)*fk); bz_tMq = bz_mq(slider8);
  bz_tHg = slider10*gk;  bz_tHf = log(bz_hsHz(slider9)*fk);
  bz_tMode = slider2 > 0.5; bz_tEq = slider11 > 0.5;
  bz_tIn = db2g(slider1); bz_tOut = db2g(slider12);
  bz_hrI = db2g(14 - 2*v); bz_ihI = 1/bz_hrI;      // the headroom breathes with the rail
  bz_hrO = db2g(16 - 2*v); bz_ihO = 1/bz_hrO;
);
function bz_coefs() (
  bz_ls(bz_cLS, exp(bz_Lf), bz_Lg, 0.6);
  bz_hp(bz_cHP, exp(bz_Hp));
  bz_pk(bz_cPK, exp(bz_Mf), bz_Mg, bz_Mq);
  bz_hs(bz_cHS, exp(bz_Hf), bz_Hg*0.5);            // two equal first-order sections in series
);
function bz_glide() local(k, ch) (
  k = bz_kS;
  ch = abs(bz_tLg - bz_Lg) + abs(bz_tLf - bz_Lf) + abs(bz_tHp - bz_Hp) + abs(bz_tMg - bz_Mg) + abs(bz_tMf - bz_Mf)
     + abs(bz_tMq - bz_Mq) + abs(bz_tHg - bz_Hg) + abs(bz_tHf - bz_Hf);
  ch > 0.00001 ? (
    bz_Lg += (bz_tLg - bz_Lg)*k; bz_Lf += (bz_tLf - bz_Lf)*k; bz_Hp += (bz_tHp - bz_Hp)*k;
    bz_Mg += (bz_tMg - bz_Mg)*k; bz_Mf += (bz_tMf - bz_Mf)*k; bz_Mq += (bz_tMq - bz_Mq)*k;
    bz_Hg += (bz_tHg - bz_Hg)*k; bz_Hf += (bz_tHf - bz_Hf)*k;
    bz_coefs();
  );
);
bz_targets();
bz_Lg = bz_tLg; bz_Lf = bz_tLf; bz_Hp = bz_tHp; bz_Mg = bz_tMg; bz_Mf = bz_tMf; bz_Mq = bz_tMq; bz_Hg = bz_tHg; bz_Hf = bz_tHf;
bz_mode = bz_tMode; bz_eq = bz_tEq; bz_gIn = bz_tIn; bz_gOut = bz_tOut;
bz_coefs();

// ---------- presets (1-based, as the house preset bar counts) ----------
function bz_p(it, md, lf, lg, hp, mf, mg, mq, hf, hg, ot) (
  slider1 = it; slider2 = md; slider3 = lf; slider4 = lg; slider5 = hp; slider6 = mf; slider7 = mg; slider8 = mq;
  slider9 = hf; slider10 = hg; slider11 = 1; slider12 = ot;
);
function load_preset(p) (
  p == 1  ? ( bz_p(0, 0, 1, 0, 1, 1200, 0, 0, 1, 0, 0); slider13 = 20; slider14 = 1; ) :     // Init (the defaults)
  p == 2  ? bz_p(0, 1, 1, 0, 1, 3200, 1.5, 0, 1, 5, -1) :                                    // Vocal Air
  p == 3  ? bz_p(3, 1, 1, 0, 2, 2500, 3, 0, 0, 2, -4) :                                      // Broadcast Voice
  p == 4  ? bz_p(0, 0, 0, 6, 1, 320, -3.5, 0, 0, 1.5, -1) :                                  // Kick Weight
  p == 5  ? bz_p(0, 1, 1, 0, 1, 2200, 3.5, 0, 0, 1.5, -1) :                                  // Guitar Presence
  p == 6  ? bz_p(0, 1, 1, 0, 0, 250, -3, 0, 0, -2, 0.5) :                                    // Bass Clean-Up
  p == 7  ? bz_p(0, 0, 0, 1, 1, 3000, -0.5, 0, 2, 3, -0.5) :                                 // Mix Bus Sheen
  p == 8  ? bz_p(6, 1, 1, 0, 2, 1500, 10, 1, 0, -15, -8) :                                   // Telephone
  p == 9  ? bz_p(0, 0, 1, -1, 1, 300, -5, 0, 1, 1.5, 1) :                                    // De-Mud
  p == 10 ? bz_p(0, 0, 1, -1.5, 1, 600, -2, 0, 1, 3, 0) :                                    // Piano Open
  p == 11 ? bz_p(4, 0, 0, 2.5, 1, 1800, 1, 0, 2, 2, -4);                                     // Warm Drive
  slider_automate(16383);                          // sliders 1-14
);

!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );             // new instances open Large, on Init
ui_dflt = 1;
ui_thm = 5; ui_hw = 1;                             // the house hardware keycaps; the faceplate is the plug-in's own

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@slider
prs_chk();
bz_targets();
ost_setup(0, 0, 120, 6000, -0.3, 0);   // output stage: straight through

@block
prs_chk();
// DRIFT: the supply voltage - a slow random walk, eased so it never steps
bz_dW -= samplesblock; bz_dW <= 0 ? ( bz_dW = srate*(0.7 + rand(1) * 2.3); bz_dT = rand(2) - 1; );
bz_dV += (bz_dT - bz_dV)*min(1, samplesblock/(1.2*srate));
bz_targets();
ost_setup(0, 0, 120, 6000, -0.3, 0);   // output stage: straight through

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
bz_cnt <= 0 ? ( bz_glide(); bz_cnt = 16; ); bz_cnt -= 1;
bz_gIn += (bz_tIn - bz_gIn)*bz_kD; bz_gOut += (bz_tOut - bz_gOut)*bz_kD;
bz_mode += (bz_tMode - bz_mode)*bz_kD; bz_eq += (bz_tEq - bz_eq)*bz_kD;
abs(bz_mode - bz_tMode) < 0.0001 ? bz_mode = bz_tMode;
abs(bz_eq - bz_tEq) < 0.0001 ? bz_eq = bz_tEq;

// input trim and amplifier (a whisper of DC keeps the filters out of denormals; the HPF / DC blockers remove it)
bz_x0 = spl0*bz_gIn + 0.000000000000000001; bz_x1 = spl1*bz_gIn + 0.000000000000000001;
bz_a_ = max(abs(bz_x0), abs(bz_x1))*bz_ihI; bz_heat = bz_a_ > bz_heat ? bz_a_ : bz_heat*0.99993;
bz_x0 = bz_iL.bz_inamp(bz_x0); bz_x1 = bz_iR.bz_inamp(bz_x1);

// the three bands (both LOW circuits run, so SHELF / HPF crossfades without a click)
bz_eq > 0 ? (
  bz_y0 = bz_x0; bz_y1 = bz_x1;
  bz_mode < 1 ? ( bz_s0 = bz_bq(bz_y0, bz_cLS, bz_sLS0); bz_s1 = bz_bq(bz_y1, bz_cLS, bz_sLS1); );
  bz_mode > 0 ? ( bz_h0 = bz_bq(bz_y0, bz_cHP, bz_sHP0); bz_h1 = bz_bq(bz_y1, bz_cHP, bz_sHP1); );
  bz_y0 = bz_mode <= 0 ? bz_s0 : bz_mode >= 1 ? bz_h0 : bz_s0 + (bz_h0 - bz_s0)*bz_mode;
  bz_y1 = bz_mode <= 0 ? bz_s1 : bz_mode >= 1 ? bz_h1 : bz_s1 + (bz_h1 - bz_s1)*bz_mode;
  bz_y0 = bz_bq(bz_y0, bz_cPK, bz_sPK0); bz_y1 = bz_bq(bz_y1, bz_cPK, bz_sPK1);
  bz_y0 = bz_bq(bz_bq(bz_y0, bz_cHS, bz_sHa0), bz_cHS, bz_sHb0);
  bz_y1 = bz_bq(bz_bq(bz_y1, bz_cHS, bz_sHa1), bz_cHS, bz_sHb1);
  bz_x0 += (bz_y0 - bz_x0)*bz_eq; bz_x1 += (bz_y1 - bz_x1)*bz_eq;
);
// a circuit switched out starts again from rest next time
bz_mode <= 0 ? memset(bz_sHP0, 0, 8) : bz_mode >= 1 ? memset(bz_sLS0, 0, 8);
bz_eq <= 0 ? ( memset(bz_sLS0, 0, 8); memset(bz_sHP0, 0, 8); memset(bz_sPK0, 0, 8); memset(bz_sHa0, 0, 16); );

// output amplifier / transformer, OUTPUT, the house output stage
bz_x0 = bz_oL.bz_outamp(bz_x0); bz_x1 = bz_oR.bz_outamp(bz_x1);
ost_out(bz_x0*bz_gOut, bz_x1*bz_gOut);
spl0 = ost_l; spl1 = ost_r;
bz_a_ = max(abs(spl0), abs(spl1)); bz_mOut = bz_a_ > bz_mOut ? bz_a_ : bz_mOut*0.9997;

@gfx 900 360
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
// =====================================================================
// GUI - a console module: a slate meter-bridge strip over a light blue-grey faceplate; the sections sit in
// recessed warm-grey wells. Response window, INPUT, LOW, MID, HIGH, OUTPUT in signal order.
// Design space 1200 x 480 at qs = 0.75 * sc (900 x 360 at size M).
// =====================================================================
ui_begin(900, 360);
qs = sc*0.75;

gfx_setfont(8, "Trebuchet MS", 15*qs, 'b');               // captions
gfx_setfont(10, "Trebuchet MS", 15*qs, 'b');              // window scale
gfx_setfont(12, "Trebuchet MS", 36*qs, 'b');              // title
gfx_setfont(13, "Trebuchet MS", 18*qs, 'b');              // section titles
gfx_setfont(11, "Trebuchet MS", 15*qs, 'b');              // key legends
sc != bz_lsc ? ( bz_lsc = sc; gfx_setfont(15, "Trebuchet MS", 10.5*sc, 'b'); gfx_setfont(16, "Trebuchet MS", 9.5*sc, 'b'); );   // lamp key legends

GRN = 0x46D86A; AMB = 0xFFB030; RED = 0xFF3A2A; YEL = 0xF2C21B;
HDR = 0x3B4650; PNL = 0xBCC6CC; WEL = 0xD3CAC2; INK = 0x262A2E; INK2 = 0x55595E; SCR = 0x0F1519; TRACE = 0xF2D27A;
CL = 0x2F68B0; CM = 0x2F9A58; CH = 0xC63A2C; KG = 0x9DA2A8;

function R(x, y, w, h) ( gfx_rect(x*qs, y*qs, max(1, w*qs), max(1, h*qs)); );
function CIRC(x, y, rr, f) ( gfx_circle(x*qs, y*qs, rr*qs, f, 1); );
function TX(x, y, t) ( gfx_x = x*qs; gfx_y = y*qs; gfx_drawstr(t); );
function TC(cx, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = cx*qs - w*0.5; gfx_y = y*qs; gfx_drawstr(t); );
function TR(rx, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = rx*qs - w; gfx_y = y*qs; gfx_drawstr(t); );
function tog(idx) ( slider(idx) = slider(idx) < 0.5; ui_auto(idx); );
function setv(idx, v) ( slider(idx) = v; ui_auto(idx); );
function lum(c) ( (c & 255) + ((c >> 8) & 255) + ((c >> 16) & 255); );

// recessed well with sloped walls: the upper walls in shade, the lower ones catching the light
function well(x, y, w, h, col) local(d) (
  d = 5;
  ui_col(ui_mix(col, 0xFFFFFF, 0.45)); R(x - 1, y - 1, w + 2, h + 2);
  ui_col(ui_mix(col, 0x000000, 0.30)); R(x - 1, y - 1, w + 1, h + 1);
  ui_col(ui_mix(col, 0x000000, 0.20)); gfx_triangle(x*qs, y*qs, (x + w)*qs, y*qs, (x + w - d)*qs, (y + d)*qs, (x + d)*qs, (y + d)*qs);
  ui_col(ui_mix(col, 0x000000, 0.13)); gfx_triangle(x*qs, y*qs, (x + d)*qs, (y + d)*qs, (x + d)*qs, (y + h - d)*qs, x*qs, (y + h)*qs);
  ui_col(ui_mix(col, 0xFFFFFF, 0.30)); gfx_triangle(x*qs, (y + h)*qs, (x + d)*qs, (y + h - d)*qs, (x + w - d)*qs, (y + h - d)*qs, (x + w)*qs, (y + h)*qs);
  ui_col(ui_mix(col, 0xFFFFFF, 0.18)); gfx_triangle((x + w)*qs, y*qs, (x + w)*qs, (y + h)*qs, (x + w - d)*qs, (y + h - d)*qs, (x + w - d)*qs, (y + d)*qs);
  ui_col(col); R(x + d, y + d, w - 2*d, h - 2*d);
  gfx_gradrect((x + d)*qs, (y + d)*qs, (w - 2*d)*qs, 14*qs, 0, 0, 0, 0.10, 0, 0, 0, 0, 0, 0, 0, -0.10/(14*qs));
);
// section title with a coloured rule
function title(cx, y, s, col, rw) (
  gfx_setfont(13); ui_col(INK); TC(cx, y, s);
  ui_col(col); R(cx - rw*0.5, y + 24, rw, 3);
);
// panel key: the house lamp key (gfx-ui) in the old key's footprint, legend on the cap (design units)
function key(x, y, w, h, on, col, s) (
  lk_well = 0x2A2722; lk_font = 15; lk_font2 = strlen(s) > 4 ? 16 : 15;   // (BROAD / NARROW: a size smaller, to fit)
  lk_fit(x*0.75, y*0.75, w*0.75, h*0.75, on, col, s);
);
// house coloured-cap knob (design units), value on hover / drag only
function knob(idx, cx, cy, r, lo, hi, def, lg, cap, label, val) (
  dy_kst = 7; dy_ink = INK; dy_ntick = 11;
  dy_knob(cx*0.75, cy*0.75, r*0.75, idx, lo, hi, def, lg, cap, label, val);
);
// small cap (INPUT, OUTPUT, DRIFT)
function sknob(idx, cx, cy, r, lo, hi, def, cap, label, val, ink) (
  dy_kst = 20; dy_ink = ink; dy_ntick = 11;
  dy_knob(cx*0.75, cy*0.75, r*0.75, idx, lo, hi, def, 0, cap, label, val);
);
function fdb(v, d) local(q) (
  q = floor(v*10 + 0.5)/10; q > 0 ? sprintf(d, "+%.1f dB", q) : q < 0 ? sprintf(d, "%.1f dB", q) : strcpy(d, "0.0 dB"); d;
);
function fhz(v, d) ( v >= 1000 ? sprintf(d, "%.2f kHz", v/1000) : sprintf(d, "%d Hz", floor(v + 0.5)); d; );

// ---- GUI-thread copies of the filter design (the response window; never shared with the audio thread) ----
function gz_pk(c, f, g, q) local(A, w0, z, e, pa1, pa2, m0, m1, m2, p0, p1, p2, GG, R1, R2, B0, B1, B2, W, t) (
  A = 10^(g/40); w0 = 2*$pi*min(f, srate*0.45)/srate; z = 1/(2*A*q); e = exp(-z*w0);
  z <= 1 ? pa1 = -2*e*cos(w0*sqrt(1 - z*z)) : ( t = w0*sqrt(z*z - 1); pa1 = -e*(exp(t) + exp(-t)); );
  pa2 = e*e;
  m0 = sqr(1 + pa1 + pa2); m1 = sqr(1 - pa1 + pa2); m2 = -4*pa2;
  p1 = sqr(sin(w0*0.5)); p0 = 1 - p1; p2 = 4*p0*p1;
  GG = A*A;
  R1 = (m0*p0 + m1*p1 + m2*p2)*GG*GG;
  R2 = (-m0 + m1 + 4*(p0 - p1)*m2)*GG*GG;
  B0 = m0; B2 = (R1 - R2*p1 - B0)/(4*p1*p1); B1 = R2 + B0 + 4*(p1 - p0)*B2;
  W = 0.5*(sqrt(B0) + sqrt(max(B1, 0)));
  c[0] = 0.5*(W + sqrt(max(W*W + B2, 0))); c[1] = 0.5*(sqrt(B0) - sqrt(max(B1, 0))); c[2] = -B2/(4*c[0]);
  c[3] = pa1; c[4] = pa2;
);
function gz_hs(c, f, g) local(GG, w0, sg, wp, wz, pp, wn, hn, s, d) (
  GG = 10^(g/20); w0 = 2*$pi*f; sg = sqrt(GG); wp = w0*sg; wz = w0/sg;
  pp = exp(-wp/srate); wn = $pi*srate;
  hn = GG*sqrt((wn*wn + wz*wz)/(wn*wn + wp*wp));
  s = 1 - pp; d = hn*(1 + pp);
  c[0] = 0.5*(s + d); c[1] = 0.5*(s - d); c[2] = 0; c[3] = -pp; c[4] = 0;
);
function gz_ls(c, f, g, q) local(A, w, cs, al, sa, a0) (
  A = 10^(g/40); w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*q); sa = 2*sqrt(A)*al;
  a0 = (A + 1) + (A - 1)*cs + sa;
  c[0] = A*((A + 1) - (A - 1)*cs + sa)/a0; c[1] = 2*A*((A - 1) - (A + 1)*cs)/a0; c[2] = A*((A + 1) - (A - 1)*cs - sa)/a0;
  c[3] = -2*((A - 1) + (A + 1)*cs)/a0; c[4] = ((A + 1) + (A - 1)*cs - sa)/a0;
);
function gz_hp(c, f) local(w, cs, al, a0) (
  w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*0.70711); a0 = 1 + al;
  c[0] = (1 + cs)*0.5/a0; c[1] = -(1 + cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0;
);
// a biquad's response at f Hz, in dB
function gz_db(c, f) local(w, c1, c2, nu, de) (
  w = 2*$pi*f/srate; c1 = cos(w); c2 = cos(2*w);
  nu = c[0]*c[0] + c[1]*c[1] + c[2]*c[2] + 2*(c[0]*c[1] + c[1]*c[2])*c1 + 2*c[0]*c[2]*c2;
  de = 1 + c[3]*c[3] + c[4]*c[4] + 2*(c[3] + c[3]*c[4])*c1 + 2*c[4]*c2;
  10*log10(max(nu, 0.000000000001)/max(de, 0.000000000001));
);

// ---------------------------------------------------------------------
ui_col(0x101214); gfx_rect(0, 0, gfx_w, gfx_h);

// ---- the meter-bridge strip: roundel, name, presets, EQ IN, drift, size ----
ui_col(HDR); R(0, 0, 1200, 84);
gfx_gradrect(0, 0, 1200*qs, 40*qs, 1, 1, 1, 0.08, 0, 0, 0, 0, 0, 0, 0, -0.08/(40*qs));
ui_col(0x262E35); R(0, 82, 1200, 2);
ui_col(0xC8402A); CIRC(44, 42, 25, 1);
ui_cola(0xFFFFFF, 0.22); CIRC(39, 36, 10, 1);
gfx_setfont(2); ui_col(0xF2EEE4); ui_text(44*qs, 35*qs, "GFX");
gfx_setfont(12); ui_col(0xEEEFEA); TX(82, 10, "BERN EQ"); ver_tag("v3", 14, 0, 0);
gfx_setfont(8); ui_col(0xAEB8C0); TX(84, 53, "BROADCAST CHANNEL");

prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(316*qs, 16*qs, 404*qs, 52*qs, pr_cur,
  "Init|Vocal Air|Broadcast Voice|Kick Weight|Guitar Presence|Bass Clean-Up|Mix Bus Sheen|Telephone|De-Mud|Piano Open|Warm Drive");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_; );

lk_well = 0x141518; lk_font = 15; lk_font2 = 15;
lk_fit(746*0.75, 16*0.75, 62*0.75, 34*0.75, slider11 > 0.5, LK_AMB, "IN") ? tog(11);
gfx_setfont(8); ui_col(0xC9D0D6); TC(777, 56, "EQ IN");
sknob(13, 852, 34, 21, 0, 100, 20, 0x8A6BD8, "", "", 0xD8DCE0);
gfx_setfont(8); ui_col(0xC9D0D6); TC(852, 60, "DRIFT");
dy_act ? ( sprintf(#g_dr, "%.0f%%", slider13); gfx_setfont(8); ui_col(0xF2D27A); TX(880, 26, #g_dr); );
ui_okfs = 1; ui_outkeys(920*0.75, 8*0.75, 66*0.75, 16, 3, 14); ui_okfs = 0.85;
gfx_setfont(8, "Trebuchet MS", 15*qs, 'b');
ui_size_picker(1012*qs, 24*qs);

// ---- the faceplate ----
ui_col(PNL); R(0, 84, 1200, 396);
gfx_gradrect(0, 84*qs, 1200*qs, 120*qs, 1, 1, 1, 0.10, 0, 0, 0, 0, 0, 0, 0, -0.10/(120*qs));
ui_cola(0x000000, 0.25); R(0, 478, 1200, 2);
rd_screw(10*0.75, 96*0.75); rd_screw(10*0.75, 468*0.75); rd_screw(1190*0.75, 96*0.75); rd_screw(1190*0.75, 468*0.75);

// response window
RX = 24; RY = 96; RW = 340; RH = 372;
well(RX, RY, RW, RH, 0x8E9AA2);
ui_col(0x05080A); R(RX + 8, RY + 8, RW - 16, RH - 16);
ui_col(SCR); R(RX + 10, RY + 10, RW - 20, RH - 20);
gx0 = RX + 22; gw = RW - 44; gyc = RY + RH*0.5 - 6; gyh = 150;     // 20 Hz .. 20 kHz across, +/-18 dB up the side
function fx(f) ( gx0 + gw*log(f/20)/log(1000); );
function fy(d) ( gyc - min(max(d, -19), 19)/18*gyh; );
ui_cola(0xFFFFFF, 0.07);
f_ = 20; loop(3, j = 1; loop(9, x_ = fx(f_*j); x_ <= gx0 + gw + 0.5 ? R(x_, gyc - gyh, 1, 2*gyh); j += 1; ); f_ *= 10; );
d_ = -18; loop(7, ui_cola(0xFFFFFF, d_ == 0 ? 0.22 : 0.08); R(gx0, fy(d_), gw, 1); d_ += 6; );
gfx_setfont(10); ui_cola(0xFFFFFF, 0.45);
TC(fx(100), gyc + gyh + 8, "100"); TC(fx(1000), gyc + gyh + 8, "1k"); TC(fx(10000), gyc + gyh + 8, "10k");
TX(gx0 + 2, fy(12) - 16, "+12"); TX(gx0 + 2, fy(-12) + 2, "-12"); TX(gx0 + 2, fy(6) - 16, "+6"); TX(gx0 + 2, fy(-6) + 2, "-6");

eq_ = slider11 > 0.5; hpm_ = slider2 > 0.5;
gz_ls(gz_cLS, bz_lsHz(slider3), slider4, 0.6);
gz_hp(gz_cHP, bz_hpHz(slider5));
gz_pk(gz_cPK, min(max(slider6, 150), 7000), slider7, bz_mq(slider8));
gz_hs(gz_cHS, bz_hsHz(slider9), slider10*0.5);
px_ = 0; py_ = 0; j = 0;
loop(181,
  f_ = 20*1000^(j/180); x_ = fx(f_);
  l_ = hpm_ ? gz_db(gz_cHP, f_) : gz_db(gz_cLS, f_); m_ = gz_db(gz_cPK, f_); h_ = 2*gz_db(gz_cHS, f_);
  eq_ ? (
    ui_cola(hpm_ ? YEL : CL, 0.55); abs(l_) > 0.05 ? R(x_, min(fy(0), fy(l_)), 2, max(1, abs(fy(l_) - fy(0))));
    ui_cola(CM, 0.55); abs(m_) > 0.05 ? R(x_, min(fy(0), fy(m_)), 2, max(1, abs(fy(m_) - fy(0))));
    ui_cola(CH, 0.55); abs(h_) > 0.05 ? R(x_, min(fy(0), fy(h_)), 2, max(1, abs(fy(h_) - fy(0))));
  );
  y_ = fy(eq_ ? l_ + m_ + h_ : 0);
  j > 0 ? ( ui_col(TRACE); gfx_line(px_*qs, py_*qs, x_*qs, y_*qs, 1); gfx_line(px_*qs, py_*qs + 1, x_*qs, y_*qs + 1, 1); );
  px_ = x_; py_ = y_; j += 1;
);
// band markers in their cap colours
function mark(f, d, c) ( ui_col(c); CIRC(fx(f), fy(d), 6, 1); ui_col(0xFFFFFF); CIRC(fx(f), fy(d), 6, 0); );
eq_ ? (
  hpm_ ? mark(bz_hpHz(slider5), -3, YEL) : mark(bz_lsHz(slider3), slider4*0.5, CL);
  mark(slider6, slider7, CM);
  mark(min(bz_hsHz(slider9), 19000), slider10*0.5, CH);
);
gfx_setfont(10); ui_cola(TRACE, eq_ ? 0.8 : 0.45); TR(gx0 + gw, RY + 18, eq_ ? "EQ IN" : "EQ OUT");

// ---- INPUT ----
well(376, 96, 120, 372, WEL);
title(436, 108, "INPUT", INK2, 76);
sprintf(#g_in, "%+.1f dB", slider1); slider1 == 0 ? strcpy(#g_in, "0.0 dB");
sknob(1, 436, 196, 32, -18, 18, 0, KG, "TRIM", #g_in, INK);
g_heat = min(max((bz_heat - 0.12)/0.55, 0), 1);
rd_lamp(436*0.75, 318*0.75, 11*0.75, g_heat, AMB);
gfx_setfont(8); ui_col(INK); TC(436, 340, "WARMTH");
// signal flow, lit while it is in the path
gfx_setfont(8); k = 0;
loop(4,
  ui_col(k == 1 && !eq_ ? ui_mix(WEL, INK, 0.35) : INK2);
  TC(436, 376 + k*20, k == 0 ? "IN AMP" : k == 1 ? "EQ" : k == 2 ? "IRON" : "OUT");
  k += 1;
);

// ---- LOW ----
well(508, 96, 196, 372, WEL);
title(606, 108, "LOW", CL, 150);
knob(4, 606, 196, 40, -15, 15, 0, 0, hpm_ ? ui_mix(CL, WEL, 0.55) : CL, "GAIN", fdb(slider4, #g_lg));
gfx_setfont(8); ui_col(hpm_ ? ui_mix(WEL, INK, 0.45) : INK); TC(606, 290, "SHELF  Hz");
key(548, 314, 54, 32, !hpm_ && slider3 < 0.5, LK_BLU_LT, "60") ? ( setv(2, 0); setv(3, 0); );
key(610, 314, 54, 32, !hpm_ && slider3 > 0.5, LK_BLU_LT, "100") ? ( setv(2, 0); setv(3, 1); );
gfx_setfont(8); ui_col(hpm_ ? INK : ui_mix(WEL, INK, 0.45)); TC(606, 366, "HIGH-PASS  Hz");
key(524, 390, 50, 32, hpm_ && slider5 < 0.5, LK_YEL, "40") ? ( setv(2, 1); setv(5, 0); );
key(581, 390, 50, 32, hpm_ && slider5 > 0.5 && slider5 < 1.5, LK_YEL, "80") ? ( setv(2, 1); setv(5, 1); );
key(638, 390, 50, 32, hpm_ && slider5 > 1.5, LK_YEL, "120") ? ( setv(2, 1); setv(5, 2); );

// ---- MID ----
well(716, 96, 236, 372, WEL);
title(834, 108, "MID  PRESENCE", CM, 190);
knob(7, 834, 196, 40, -15, 15, 0, 0, CM, "GAIN", fdb(slider7, #g_mg));
knob(6, 790, 362, 32, 150, 7000, 1200, 1, KG, "FREQ", fhz(slider6, #g_mf));
gfx_setfont(10); ui_col(INK2); TR(760, 398, "150"); TX(818, 398, "7k");
key(864, 322, 72, 32, slider8 < 0.5, LK_YEL, "BROAD") ? setv(8, 0);
key(864, 368, 72, 32, slider8 > 0.5, LK_YEL, "NARROW") ? setv(8, 1);
gfx_setfont(8); ui_col(INK); TC(900, 410, "Q");

// ---- HIGH ----
well(964, 96, 132, 372, WEL);
title(1030, 108, "HIGH", CH, 96);
knob(10, 1030, 196, 40, -15, 15, 0, 0, CH, "GAIN", fdb(slider10, #g_hg));
gfx_setfont(8); ui_col(INK); TC(1030, 290, "HINGE  kHz");
key(998, 314, 64, 30, slider9 < 0.5, LK_RED, "10") ? setv(9, 0);
key(998, 354, 64, 30, slider9 > 0.5 && slider9 < 1.5, LK_RED, "15") ? setv(9, 1);
key(998, 394, 64, 30, slider9 > 1.5, LK_RED, "20") ? setv(9, 2);
// EQ out: the three band sections are slightly greyed (their IN key is up in the strip)
!eq_ ? ( ui_cola(WEL, 0.5); R(508, 96, 196, 372); R(716, 96, 236, 372); R(964, 96, 132, 372); );

// ---- OUTPUT ----
well(1108, 96, 72, 372, WEL);
title(1144, 108, "OUT", INK2, 50);
sprintf(#g_ot, "%+.1f dB", slider12); slider12 == 0 ? strcpy(#g_ot, "0.0 dB");
sknob(12, 1144, 182, 24, -18, 18, 0, KG, "LEVEL", #g_ot, INK);
g_vo = max(bz_mOut, g_vo*0.9); g_od = 20*log10(max(g_vo, 0.00001));
ui_col(0x0A0A0B); R(1130, 250, 28, 206);
k = 0;
loop(16, lit_ = g_od >= -30 + (16 - k)*2 - 2; c_ = k < 2 ? RED : k < 5 ? AMB : GRN;
  ui_col(lit_ ? c_ : ui_mix(c_, 0x000000, 0.82)); R(1133, 253 + k*12.6 + 1, 22, 10); k += 1; );

pk_end();
ui_end();
