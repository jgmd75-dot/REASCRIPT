desc:CW Dynamic EQ [dynamic eq] (GFX)
//tags: dynamic-eq eq dynamics mid-side width
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Cherwell series — clinical mid-90s digital console processing.
// Dynamic EQ: four bands (LF, LMF, HMF, HF) that move only when their own
// frequency range crosses a threshold. Brand names live in comments only.
//
// Per band: FREQ, Q, GAIN (static), THRESH, RANGE, ATTACK, RELEASE,
//   ON, EXP (lit = expand, unlit = compress), EXT (key from inputs 3/4), LSN.
//   LF and HF also have SHELF (lit = shelf, unlit = bell).
// RANGE sets how far and which way the band moves: negative cuts, positive
// boosts. COMP moves the band while its level is above THRESH, EXP while it is
// below. The move follows the level at 2:1 until it reaches RANGE.
// The detector hears the band itself (bell = band-pass at FREQ / Q,
// LF shelf = low-pass, HF shelf = high-pass), from the input or the EXT key.
// Stereo-linked: one gain move per band for both channels.
// LSN solos what that band's detector hears.
// Static HPF / LPF, 12 or 24 dB/oct (HPF at 20 Hz / LPF at 20 kHz = off).
// Latency: 0 samples. No DRIFT (clinical digital unit). Output passes straight
// through (house rule for mix tools).
//
// MONO BELOW (Off / 60 / 220 / 440 Hz keys): the sides are high-passed there (24 dB/oct), so everything below is mono.
// WIDTH (0 - 100 %, added only): adds side up to +6 dB, gently more in the top - the boost at 7 kHz is 1.5 x the
// boost at 700 Hz in dB (full: +6 dB at 700 Hz, +9 dB at 7 kHz; half: +3.5 / +5.6 dB). Side += w x (0.975 S + 1.48 x
// first-order high-pass at 6.96 kHz). Both after the EQ, before OUTPUT;
// keys crossfade and the frequency glides (JG, 30 Oct 2026).
// STATUS: Lab copy (Oct 2026) of the Stable v2.0: with MONO BELOW Off and WIDTH 0 % it sounds as the Stable; a wider panel (1240 x 636) where each
// section (FILTERS, LF, LMF, HMF, HF, OUTPUT) sits on its own faceplate, light and dark in turn, with more room
// between the controls (JG, 30 Oct 2026).

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

slider1:b0_on=1<0,1,1{Off,On}>-LF On
slider2:b0_type=0<0,1,1{Shelf,Bell}>-LF Type
slider3:b0_f=100<20,500,1>-LF Freq (Hz)
slider4:b0_q=1<0.3,6,0.01>-LF Q
slider5:b0_g=0<-18,18,0.1>-LF Gain (dB)
slider6:b0_thr=-20<-60,0,0.1>-LF Threshold (dB)
slider7:b0_rng=0<-18,18,0.1>-LF Range (dB)
slider8:b0_atk=10<0.5,100,0.1>-LF Attack (ms)
slider9:b0_rel=150<20,1000,1>-LF Release (ms)
slider10:b0_mode=0<0,1,1{Comp,Exp}>-LF Mode
slider11:b0_ext=0<0,1,1{Internal,External}>-LF Key
slider12:b1_on=1<0,1,1{Off,On}>-LMF On
slider13:b1_type=1<0,1,1{Shelf,Bell}>-LMF Type
slider14:b1_f=400<60,3000,1>-LMF Freq (Hz)
slider15:b1_q=1<0.3,6,0.01>-LMF Q
slider16:b1_g=0<-18,18,0.1>-LMF Gain (dB)
slider17:b1_thr=-20<-60,0,0.1>-LMF Threshold (dB)
slider18:b1_rng=0<-18,18,0.1>-LMF Range (dB)
slider19:b1_atk=10<0.5,100,0.1>-LMF Attack (ms)
slider20:b1_rel=150<20,1000,1>-LMF Release (ms)
slider21:b1_mode=0<0,1,1{Comp,Exp}>-LMF Mode
slider22:b1_ext=0<0,1,1{Internal,External}>-LMF Key
slider23:b2_on=1<0,1,1{Off,On}>-HMF On
slider24:b2_type=1<0,1,1{Shelf,Bell}>-HMF Type
slider25:b2_f=2500<500,12000,1>-HMF Freq (Hz)
slider26:b2_q=1<0.3,6,0.01>-HMF Q
slider27:b2_g=0<-18,18,0.1>-HMF Gain (dB)
slider28:b2_thr=-20<-60,0,0.1>-HMF Threshold (dB)
slider29:b2_rng=0<-18,18,0.1>-HMF Range (dB)
slider30:b2_atk=10<0.5,100,0.1>-HMF Attack (ms)
slider31:b2_rel=150<20,1000,1>-HMF Release (ms)
slider32:b2_mode=0<0,1,1{Comp,Exp}>-HMF Mode
slider33:b2_ext=0<0,1,1{Internal,External}>-HMF Key
slider34:b3_on=1<0,1,1{Off,On}>-HF On
slider35:b3_type=0<0,1,1{Shelf,Bell}>-HF Type
slider36:b3_f=8000<2000,20000,1>-HF Freq (Hz)
slider37:b3_q=1<0.3,6,0.01>-HF Q
slider38:b3_g=0<-18,18,0.1>-HF Gain (dB)
slider39:b3_thr=-20<-60,0,0.1>-HF Threshold (dB)
slider40:b3_rng=0<-18,18,0.1>-HF Range (dB)
slider41:b3_atk=10<0.5,100,0.1>-HF Attack (ms)
slider42:b3_rel=150<20,1000,1>-HF Release (ms)
slider43:b3_mode=0<0,1,1{Comp,Exp}>-HF Mode
slider44:b3_ext=0<0,1,1{Internal,External}>-HF Key
slider45:listen=0<0,4,1{Off,LF,LMF,HMF,HF}>-Listen
slider46:hpf=20<20,1000,1>-HPF (Hz, 20 = Off)
slider47:hpf24=0<0,1,1{12 dB,24 dB}>-HPF Slope
slider48:lpf=20000<1000,20000,1>-LPF (Hz, 20k = Off)
slider49:lpf24=0<0,1,1{12 dB,24 dB}>-LPF Slope
slider50:out_db=0<-12,12,0.1>-Output (dB)
slider51:dq_on=1<0,1,1{Off,On}>-In
slider52:mono_sel=0<0,3,1{Off,60 Hz,220 Hz,440 Hz}>-Mono below
slider53:width_pc=0<0,100,1>-Width (added, %)
slider54:prs_sel=0<0,12,1{No preset,Init,Vocal: De-Esser,Vocal: Tame the Mud,Vocal: Harshness,Bass: Even Low End,Kick: Boom Control,Acoustic: Boom Tamer,Guitar: Fizz Control,Drums: Ring Taming,Mix: Smooth Mids,Mix: Dynamic Air,Key: Mid Duck (in 3/4)}>-Preset

@init
ext_noinit = 1;
pr_cur = 1;              // preset shown on the LCD (saved with the project)
gfx_ext_retina = 1;

// ---------- per-band memory ----------
// band b: params at P + b*16, coefficients at C + b*8, state at S + b*16
PRM = 0;  CFB = 100;  STB = 200;
// P offsets
B_ON = 0; B_TYPE = 1; B_F = 2; B_Q = 3; B_G = 4; B_THR = 5; B_RNG = 6; B_AC = 7; B_RC = 8;
B_MODE = 9; B_EXT = 10; B_KIND = 11; B_G0 = 12; B_DG = 13; B_LAST = 14; B_ENV = 15;
// C offsets: a1 a2 a3 m0 m1 m2 (shared by both channels)
// S offsets: 0-1 L eq state, 2-3 R eq state, 4-5 L detector, 6-7 R detector
dgpk = 300;  dg_d = 310;  dgm = 320;          // per-band gain-move peaks for the display
first_run = 1;

// =====================================================================
// DSP building blocks
// =====================================================================
function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );
function tg(f) ( tan($pi * min(f, srate * 0.45) / srate); );

// band coefficients into C + b*8. kind: 0 low shelf, 1 bell, 2 high shelf
function band_coef(b, db) local(c, A, g, k, a1, kind) (
  c = CFB + b * 8;  kind = PRM[b * 16 + B_KIND];
  A = exp(db * 0.05756462732485115);
  kind == 0 ? ( g = PRM[b * 16 + B_G0] / sqrt(A);  k = 1.41421356;
                c[3] = 1;  c[4] = k * (A - 1);  c[5] = A * A - 1; ) :
  kind == 2 ? ( g = PRM[b * 16 + B_G0] * sqrt(A);  k = 1.41421356;
                c[3] = A * A;  c[4] = k * (1 - A) * A;  c[5] = 1 - A * A; ) :
              ( g = PRM[b * 16 + B_G0];  k = 1 / (PRM[b * 16 + B_Q] * A);
                c[3] = 1;  c[4] = k * (A * A - 1);  c[5] = 0; );
  a1 = 1 / (1 + g * (g + k));
  c[0] = a1;  c[1] = g * a1;  c[2] = g * g * a1;
);
// one SVF step with coefficients c and state at s: returns m0 x + m1 v1 + m2 v2
function svfc(x, c, s) local(v1, v2, v3) (
  v3 = x - s[1];
  v1 = c[0] * s[0] + c[1] * v3;
  v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
  c[3] * x + c[4] * v1 + c[5] * v2;
);

// plain SVF (filters and detectors)
function svf_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tg(fc);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf_tick(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;
  lp = v2;  bp = v1;  hp = x - k * v1 - v2;
);

// static HPF / LPF on one channel (12 dB = one stage, 24 dB = two Butterworth stages)
function filt(x) instance(h1, h2, l1, l2) local(y) (
  y = x;
  hpf_on ? ( h1.svf_tick(y);  y = h1.hp;  hpf24 ? ( h2.svf_tick(y);  y = h2.hp; ); );
  lpf_on ? ( l1.svf_tick(y);  y = l1.lp;  lpf24 ? ( l2.svf_tick(y);  y = l2.lp; ); );
  y;
);
function filt_set() instance(h1, h2, l1, l2) (
  h1.svf_set(hpf, hpf24 ? 0.5411961 : 0.7071068);  h2.svf_set(hpf, 1.3065630);
  l1.svf_set(lpf, lpf24 ? 0.5411961 : 0.7071068);  l2.svf_set(lpf, 1.3065630);
);

// MONO BELOW: a 12 dB/oct TPT high-pass on the side (two in a row = 24 dB/oct); coefficients from mg / mk / ma
function mhp(x) instance(s1, s2) local(hp, v1, v2) (
  hp = (x - (mg + mk) * s1 - s2) * ma;
  v1 = mg * hp + s1;  s1 = mg * hp + v1;
  v2 = mg * v1 + s2;  s2 = mg * v1 + v2;
  hp;
);
// WIDTH tilt: a TPT one-pole low-pass at 6.96 kHz (wg); its high-pass is x - low-pass
function wlp(x) instance(s1) local(v, y) ( v = (x - s1) * wg / (1 + wg);  y = v + s1;  s1 = y + v;  y; );
function mono_set() (
  mono_sel > 0.5 ? mf_t = mono_sel < 1.5 ? 60 : mono_sel < 2.5 ? 220 : 440;
  mf_t < 20 ? mf_t = 220;
  mf_s += (mf_t - mf_s) * mf_c;
  wg = tan($pi * min(6958, srate * 0.45) / srate);
  mg = tan($pi * min(mf_s, srate * 0.45) / srate);  mk = 1.41421356;  ma = 1 / (1 + mg * (mg + mk));
);

function update_params() local(b, p, i) (
  b = 0;
  loop(4,
    p = b * 16;  i = 1 + b * 11;
    PRM[p + B_ON]   = slider(i);
    PRM[p + B_TYPE] = slider(i + 1);
    PRM[p + B_F]    = slider(i + 2);
    PRM[p + B_Q]    = slider(i + 3);
    PRM[p + B_G]    = slider(i + 4);
    PRM[p + B_THR]  = slider(i + 5);
    PRM[p + B_RNG]  = slider(i + 6);
    PRM[p + B_AC]   = 1 - exp(-1000 / (slider(i + 7) * srate));
    PRM[p + B_RC]   = 1 - exp(-1000 / (slider(i + 8) * srate));
    PRM[p + B_MODE] = slider(i + 9);
    PRM[p + B_EXT]  = slider(i + 10);
    PRM[p + B_KIND] = (b == 0 && PRM[p + B_TYPE] < 0.5) ? 0 : (b == 3 && PRM[p + B_TYPE] < 0.5) ? 2 : 1;
    PRM[p + B_G0]   = tg(PRM[p + B_F]);
    PRM[p + B_LAST] = -999;                         // force a coefficient refresh
    // detector filters: bell = band-pass at FREQ / Q, LF shelf = LP, HF shelf = HP
    b == 0 ? ( d0L.svf_set(PRM[p + B_F], PRM[p + B_KIND] == 1 ? PRM[p + B_Q] : 0.7071);  d0R.svf_set(PRM[p + B_F], PRM[p + B_KIND] == 1 ? PRM[p + B_Q] : 0.7071); ) :
    b == 1 ? ( d1L.svf_set(PRM[p + B_F], PRM[p + B_Q]);  d1R.svf_set(PRM[p + B_F], PRM[p + B_Q]); ) :
    b == 2 ? ( d2L.svf_set(PRM[p + B_F], PRM[p + B_Q]);  d2R.svf_set(PRM[p + B_F], PRM[p + B_Q]); ) :
             ( d3L.svf_set(PRM[p + B_F], PRM[p + B_KIND] == 1 ? PRM[p + B_Q] : 0.7071);  d3R.svf_set(PRM[p + B_F], PRM[p + B_KIND] == 1 ? PRM[p + B_Q] : 0.7071); );
    b += 1;
  );
  hpf_on = hpf > 20.5;  lpf_on = lpf < 19999.5;
  chL.filt_set();  chR.filt_set();
  out_t  = db2g(out_db);
  sm     = 1 - exp(-1 / (0.02 * srate));
  env_a  = 1 - exp(-1000 / (2 * srate));          // level follower: 2 ms up, 40 ms down
  env_r  = 1 - exp(-1000 / (40 * srate));
  ramp_step = 1 / (0.010 * srate);
  first_run ? ( out_s = out_t;  on_s = dq_on;  mono_set();  mf_s = mf_t;  mo_s = mono_sel > 0.5;  wid_s = width_pc * 0.01;  first_run = 0; );
  mf_c = 1 - exp(-1 / (0.03 * srate / max(1, samplesblock)));   // MONO BELOW glides over about 30 ms (per block)
);

// what band b's detector hears from (l, r); leaves the pair in dtl, dtr
function det_pair(b, l, r) local(kind) (
  kind = PRM[b * 16 + B_KIND];
  b == 0 ? ( d0L.svf_tick(l);  d0R.svf_tick(r);
             kind == 0 ? ( dtl = d0L.lp;  dtr = d0R.lp; ) : ( dtl = d0L.k * d0L.bp;  dtr = d0R.k * d0R.bp; ); ) :
  b == 1 ? ( d1L.svf_tick(l);  d1R.svf_tick(r);  dtl = d1L.k * d1L.bp;  dtr = d1R.k * d1R.bp; ) :
  b == 2 ? ( d2L.svf_tick(l);  d2R.svf_tick(r);  dtl = d2L.k * d2L.bp;  dtr = d2R.k * d2R.bp; ) :
           ( d3L.svf_tick(l);  d3R.svf_tick(r);
             kind == 2 ? ( dtl = d3L.hp;  dtr = d3R.hp; ) : ( dtl = d3L.k * d3L.bp;  dtr = d3R.k * d3R.bp; ); );
);

// one band's dynamics: level -> gain move (dB), smoothed; refresh coefficients when it moves
function band_dyn(b, lvl) local(p, env, edb, rng, amt, t, dg, tot) (
  p = b * 16;
  env = PRM[p + B_ENV];
  env += (lvl - env) * (lvl > env ? env_a : env_r);
  PRM[p + B_ENV] = env;
  rng = PRM[p + B_RNG];
  rng != 0 ? (
    edb = env > 0.000001 ? g2db(env) : -120;
    amt = PRM[p + B_MODE] < 0.5 ? (edb - PRM[p + B_THR]) * 0.5 : (PRM[p + B_THR] - edb) * 0.5;
    amt = max(0, min(abs(rng), amt));
    t = rng < 0 ? -amt : amt;
    dg = PRM[p + B_DG];
    dg += (t - dg) * (abs(t) > abs(dg) ? PRM[p + B_AC] : PRM[p + B_RC]);
    PRM[p + B_DG] = dg;
  ) : ( PRM[p + B_DG] = 0; );
  tot = PRM[p + B_G] + PRM[p + B_DG];
  abs(tot - PRM[p + B_LAST]) > 0.01 ? ( band_coef(b, tot);  PRM[p + B_LAST] = tot; );
  abs(PRM[p + B_DG]) > abs(dgpk[b]) ? ( dgpk[b] = PRM[p + B_DG]; );
);

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function load_preset(p) (
  p == 1 ? ( slider(1) = 1;  slider(2) = 0;  slider(3) = 100;  slider(4) = 1;  slider(5) = 0;  slider(6) = -20;  slider(7) = 0;  slider(8) = 10;  slider(9) = 150;  slider(10) = 0;  slider(11) = 0;  slider(12) = 1;  slider(13) = 1;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = -20;  slider(18) = 0;  slider(19) = 10;  slider(20) = 150;  slider(21) = 0;  slider(22) = 0;  slider(23) = 1;  slider(24) = 1;  slider(25) = 2500;  slider(26) = 1;  slider(27) = 0;  slider(28) = -20;  slider(29) = 0;  slider(30) = 10;  slider(31) = 150;  slider(32) = 0;  slider(33) = 0;  slider(34) = 1;  slider(35) = 0;  slider(36) = 8000;  slider(37) = 1;  slider(38) = 0;  slider(39) = -20;  slider(40) = 0;  slider(41) = 10;  slider(42) = 150;  slider(43) = 0;  slider(44) = 0;  slider(45) = 0;  slider(46) = 20;  slider(47) = 0;  slider(48) = 20000;  slider(49) = 0;  slider(50) = 0;  slider(51) = 1;  slider(52) = 0;  slider(53) = 0; ) :   // Init
  p == 2 ? ( slider(1) = 1;  slider(2) = 0;  slider(3) = 100;  slider(4) = 1;  slider(5) = 0;  slider(6) = -20;  slider(7) = 0;  slider(8) = 10;  slider(9) = 150;  slider(10) = 0;  slider(11) = 0;  slider(12) = 1;  slider(13) = 1;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = -20;  slider(18) = 0;  slider(19) = 10;  slider(20) = 150;  slider(21) = 0;  slider(22) = 0;  slider(23) = 1;  slider(24) = 1;  slider(25) = 6500;  slider(26) = 2;  slider(27) = 0;  slider(28) = -30;  slider(29) = -8;  slider(30) = 1;  slider(31) = 80;  slider(32) = 0;  slider(33) = 0;  slider(34) = 1;  slider(35) = 0;  slider(36) = 10000;  slider(37) = 1;  slider(38) = 0;  slider(39) = -32;  slider(40) = -4;  slider(41) = 1;  slider(42) = 80;  slider(43) = 0;  slider(44) = 0;  slider(45) = 0;  slider(46) = 20;  slider(47) = 0;  slider(48) = 20000;  slider(49) = 0;  slider(50) = 0;  slider(51) = 1;  slider(52) = 0;  slider(53) = 0; ) :   // Vocal: De-Esser
  p == 3 ? ( slider(1) = 1;  slider(2) = 0;  slider(3) = 100;  slider(4) = 1;  slider(5) = 0;  slider(6) = -20;  slider(7) = 0;  slider(8) = 10;  slider(9) = 150;  slider(10) = 0;  slider(11) = 0;  slider(12) = 1;  slider(13) = 1;  slider(14) = 300;  slider(15) = 1.2;  slider(16) = 0;  slider(17) = -28;  slider(18) = -6;  slider(19) = 10;  slider(20) = 150;  slider(21) = 0;  slider(22) = 0;  slider(23) = 1;  slider(24) = 1;  slider(25) = 2500;  slider(26) = 1;  slider(27) = 0;  slider(28) = -20;  slider(29) = 0;  slider(30) = 10;  slider(31) = 150;  slider(32) = 0;  slider(33) = 0;  slider(34) = 1;  slider(35) = 0;  slider(36) = 8000;  slider(37) = 1;  slider(38) = 0;  slider(39) = -20;  slider(40) = 0;  slider(41) = 10;  slider(42) = 150;  slider(43) = 0;  slider(44) = 0;  slider(45) = 0;  slider(46) = 80;  slider(47) = 0;  slider(48) = 20000;  slider(49) = 0;  slider(50) = 0.5;  slider(51) = 1;  slider(52) = 0;  slider(53) = 0; ) :   // Vocal: Tame the Mud
  p == 4 ? ( slider(1) = 1;  slider(2) = 0;  slider(3) = 100;  slider(4) = 1;  slider(5) = 0;  slider(6) = -20;  slider(7) = 0;  slider(8) = 10;  slider(9) = 150;  slider(10) = 0;  slider(11) = 0;  slider(12) = 1;  slider(13) = 1;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = -20;  slider(18) = 0;  slider(19) = 10;  slider(20) = 150;  slider(21) = 0;  slider(22) = 0;  slider(23) = 1;  slider(24) = 1;  slider(25) = 3200;  slider(26) = 2.5;  slider(27) = 0;  slider(28) = -30;  slider(29) = -6;  slider(30) = 3;  slider(31) = 100;  slider(32) = 0;  slider(33) = 0;  slider(34) = 1;  slider(35) = 0;  slider(36) = 8000;  slider(37) = 1;  slider(38) = 3;  slider(39) = -20;  slider(40) = 0;  slider(41) = 10;  slider(42) = 150;  slider(43) = 0;  slider(44) = 0;  slider(45) = 0;  slider(46) = 20;  slider(47) = 0;  slider(48) = 20000;  slider(49) = 0;  slider(50) = 0.5;  slider(51) = 1;  slider(52) = 0;  slider(53) = 0; ) :   // Vocal: Harshness
