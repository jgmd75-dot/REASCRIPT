  p == 11 ? ( slider(1) = 0; slider(2) = 80; slider(3) = 0; slider(4) = 1; slider(5) = 0; slider(6) = 0; slider(7) = -30; slider(8) = 0; slider(9) = 0; slider(10) = 250; slider(11) = 0; slider(12) = 1; slider(13) = 0; slider(14) = 0; slider(15) = -30; slider(16) = 0; slider(17) = 0; slider(18) = 800; slider(19) = 0; slider(20) = 1; slider(21) = 0; slider(22) = 0; slider(23) = -30; slider(24) = 0; slider(25) = 0; slider(26) = 2500; slider(27) = 0; slider(28) = 1; slider(29) = 0; slider(30) = 0; slider(31) = -30; slider(32) = 0; slider(33) = 0; slider(34) = 6000; slider(35) = 0; slider(36) = 1; slider(37) = 0; slider(38) = 0; slider(39) = -30; slider(40) = 0; slider(41) = 0; slider(42) = 12000; slider(43) = 0; slider(44) = 1; slider(45) = 0; slider(46) = 0; slider(47) = -30; slider(48) = 0; slider(49) = 5; slider(50) = 120; slider(51) = 0; slider(60) = 40; slider(61) = 20000; slider(62) = 1; slider(63) = 1; );   // Rumble Cut
  p == 12 ? ( slider(1) = 0; slider(2) = 80; slider(3) = 0; slider(4) = 1; slider(5) = 0; slider(6) = 0; slider(7) = -30; slider(8) = 0; slider(9) = 0; slider(10) = 250; slider(11) = 0; slider(12) = 1; slider(13) = 0; slider(14) = 0; slider(15) = -30; slider(16) = 0; slider(17) = 1; slider(18) = 1500; slider(19) = 4; slider(20) = 1; slider(21) = 0; slider(22) = 0; slider(23) = -30; slider(24) = 0; slider(25) = 0; slider(26) = 2500; slider(27) = 0; slider(28) = 1; slider(29) = 0; slider(30) = 0; slider(31) = -30; slider(32) = 0; slider(33) = 0; slider(34) = 6000; slider(35) = 0; slider(36) = 1; slider(37) = 0; slider(38) = 0; slider(39) = -30; slider(40) = 0; slider(41) = 0; slider(42) = 12000; slider(43) = 0; slider(44) = 1; slider(45) = 0; slider(46) = 0; slider(47) = -30; slider(48) = 0; slider(49) = 5; slider(50) = 120; slider(51) = 2.6; slider(60) = 400; slider(61) = 3000; slider(62) = 2; slider(63) = 2; );   // Telephone
  slider_automate(2 ^ 0); slider_automate(2 ^ 1); slider_automate(2 ^ 2); slider_automate(2 ^ 3); slider_automate(2 ^ 4); slider_automate(2 ^ 5); slider_automate(2 ^ 6); slider_automate(2 ^ 7); slider_automate(2 ^ 8); slider_automate(2 ^ 9); slider_automate(2 ^ 10); slider_automate(2 ^ 11); slider_automate(2 ^ 12); slider_automate(2 ^ 13); slider_automate(2 ^ 14); slider_automate(2 ^ 15); slider_automate(2 ^ 16); slider_automate(2 ^ 17); slider_automate(2 ^ 18); slider_automate(2 ^ 19); slider_automate(2 ^ 20); slider_automate(2 ^ 21); slider_automate(2 ^ 22); slider_automate(2 ^ 23); slider_automate(2 ^ 24); slider_automate(2 ^ 25); slider_automate(2 ^ 26); slider_automate(2 ^ 27); slider_automate(2 ^ 28); slider_automate(2 ^ 29); slider_automate(2 ^ 30); slider_automate(2 ^ 31); slider_automate(2 ^ 32); slider_automate(2 ^ 33); slider_automate(2 ^ 34); slider_automate(2 ^ 35); slider_automate(2 ^ 36); slider_automate(2 ^ 37); slider_automate(2 ^ 38); slider_automate(2 ^ 39); slider_automate(2 ^ 40); slider_automate(2 ^ 41); slider_automate(2 ^ 42); slider_automate(2 ^ 43); slider_automate(2 ^ 44); slider_automate(2 ^ 45); slider_automate(2 ^ 46); slider_automate(2 ^ 47); slider_automate(2 ^ 48); slider_automate(2 ^ 49); slider_automate(2 ^ 50); slider_automate(2 ^ 59); slider_automate(2 ^ 60); slider_automate(2 ^ 61); slider_automate(2 ^ 62);
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
update();
bs = 1 - exp(-samplesblock / (0.03 * srate));
b1.bd_setup(1); b2.bd_setup(9); b3.bd_setup(17); b4.bd_setup(25); b5.bd_setup(33); b6.bd_setup(41);
hp_lf += (log(max(slider60, 10)) - hp_lf) * bs; lp_lf += (log(max(slider61, 10)) - lp_lf) * bs;   // (the cuts glide too)
hpc.fc_set(1, exp(hp_lf), slider60 <= 20.5 ? 0 : slider62 + 1);
lpc.fc_set(0, exp(lp_lf), slider61 >= 19990 ? 0 : slider63 + 1);

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_var(0, es_an);
file_avail(0) != 0 ? file_var(0, pr_cur);   // the preset shown (28 Oct 2026)
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
es_solo > 0 ? (
  es_solo == 1 ? b1.bd_solo(in_l, in_r) : es_solo == 2 ? b2.bd_solo(in_l, in_r) : es_solo == 3 ? b3.bd_solo(in_l, in_r) :
  es_solo == 4 ? b4.bd_solo(in_l, in_r) : es_solo == 5 ? b5.bd_solo(in_l, in_r) : b6.bd_solo(in_l, in_r);
) : (
  bl = lpc.fc_l(hpc.fc_l(in_l)); br = lpc.fc_r(hpc.fc_r(in_r));
  b1.bd_run(); b2.bd_run(); b3.bd_run(); b4.bd_run(); b5.bd_run(); b6.bd_run();
);
out_s += (out_t - out_s) * sm;
oL = ostL.ost_band(bl * out_s); oR = ostR.ost_band(br * out_s);
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;
SP_RING[sp_w] = (spl0 + spl1) * 0.5; sp_w = (sp_w + 1) & (SP_N - 1);
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 780 546
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(780, 546);
// ---------- the house graphite face (fixed: no theme picker or HW toggle); sections take the selected band's colour ----------
FACE = 0x2A2C30; INK = 0xE6E1D6; DIM = 0x8A867E; WHT = 0xEEEFEA; YEL = 0xF2C83E; SECT = 0x232528;
dy_ink = INK; dy_bg = SECT;
ui_col(0x0A0A0B); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(FACE); gfx_rect(0, 0, 780 * sc, 546 * sc);
gfx_gradrect(0, 0, 780 * sc, 260 * sc, 1, 1, 1, 0.04, 0, 0, 0, 0, 0, 0, 0, -0.04 / (260 * sc));
ui_cola(0x000000, 0.4); gfx_rect(0, 0, 780 * sc, 2 * sc); gfx_rect(0, 544 * sc, 780 * sc, 2 * sc);
rd_screw(10, 532); rd_screw(770, 532);
rd_badge(36, 24, 13, INK, FACE);
rd_title(56, 9, "SURGICAL EQ", 22, INK); ver_tag_at("v2", 16, gfx_x + 0.2 * gfx_texth, gfx_y + 0.8 * gfx_texth, 0.4 * gfx_texth, -1);
// [PRESETS][<][>][LCD] (28 Oct 2026), in the subtitle's place
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
sq_k = pk_preset(214 * sc, 9 * sc, 252 * sc, 26 * sc, pr_cur, "Init|Vocal De-Mud|Dynamic De-Ess|Harsh Tamer|Kick Clean-up|Bass Control|Hum Notch 50 Hz|Hum Notch 60 Hz|Air Lift|M/S Master Clarity|Rumble Cut|Telephone");
sq_k > 0 ? ( prs_dirty = sq_k; pr_cur = sq_k; );
// a section: darker well, accent bar and title in the selected band's colour
function es_sect(x, y, w, h, t) (
  ui_cola(0x000000, 0.25); ui_rrect((x + 1) * sc, (y + 2) * sc, w * sc, h * sc, 5 * sc);
  ui_col(SECT); ui_rrect(x * sc, y * sc, w * sc, h * sc, 5 * sc);
  ui_col(ACC); gfx_rect((x + 10) * sc, (y + 10) * sc, 3 * sc, 9 * sc); rd_sub(x + 17, y + 8, t, ACC, 1);
);

// ---------- helpers ----------
// magnitude (dB) of one RBJ section at frequency fr
function es_mag(fr, typ, f0, ge, q) local(w, w2, Ag, n, d, s) (
  w = tan($pi * min(fr, srate * 0.49) / srate) / tan($pi * min(f0, srate * 0.45) / srate);
  w2 = w * w; Ag = 10 ^ (ge / 40);
  typ == 0 ? ( n = sqr(1 - w2) + sqr(Ag * w / q); d = sqr(1 - w2) + sqr(w / (Ag * q)); ) :
  typ == 1 ? ( s = Ag * w2 / (q * q); n = Ag * Ag * (sqr(Ag - w2) + s); d = sqr(1 - Ag * w2) + s; ) :
  typ == 2 ? ( s = Ag * w2 / (q * q); n = Ag * Ag * (sqr(1 - Ag * w2) + s); d = sqr(Ag - w2) + s; ) :
  typ == 3 ? ( n = w2 * w2; d = sqr(1 - w2) + w2 / (q * q); ) :
  typ == 4 ? ( n = 1;       d = sqr(1 - w2) + w2 / (q * q); ) :
             ( n = sqr(1 - w2); d = sqr(1 - w2) + w2 / (q * q); );     // notch
  10 * log10(max(n, 0.000000000001) / max(d, 0.000000000001));
);
// one band's response (dB) at fr; gd = gain to draw (static or the live dynamic one)
function es_band_db(fr, i0, gd) local(ty, f, q) (
  ty = slider(i0); f = slider(i0 + 1); q = slider(i0 + 3);
  ty == 1 ? es_mag(fr, 0, f, gd, q) :
  ty == 2 ? es_mag(fr, 1, f, gd, max(q, 0.3)) :
  ty == 3 ? es_mag(fr, 2, f, gd, max(q, 0.3)) :
  ty == 4 ? max(es_mag(fr, 5, f, 0, q), -40) :
  ty == 5 ? es_mag(fr, 3, f, 0, 0.5412) + es_mag(fr, 3, f, 0, 1.3066) :
  ty == 6 ? es_mag(fr, 4, f, 0, 0.5412) + es_mag(fr, 4, f, 0, 1.3066) : 0;
);
function es_bcol(b) ( b == 0 ? 0xFF6B5B : b == 1 ? 0xFFB347 : b == 2 ? 0xE8DC5A : b == 3 ? 0x5CD68D : b == 4 ? 0x4FA8FF : 0xB685FF; );
function es_live(b) ( b == 0 ? b1.gs : b == 1 ? b2.gs : b == 2 ? b3.gs : b == 3 ? b4.gs : b == 4 ? b5.gs : b6.gs; );

// ---------- header controls ----------
ACC = es_bcol(es_sel);
ui_col(ACC); gfx_rect(0, 44 * sc, 780 * sc, 2 * sc);
rd_sq(476, 9, 104, 26, es_an, YEL, "ANALYSER") ? es_an = !es_an;
rd_sq(586, 9, 104, 26, es_solo > 0, 0xC7BEB3, es_solo ? "SOLO OFF" : "FLAT ALL") ? (
  es_solo ? es_solo = 0 : ( b_ = 0; loop(6, slider(1 + b_ * 8 + 2) = 0; slider_automate(2 ^ (b_ * 8 + 2)); b_ += 1; ); );
);
ui_size_picker(708 * sc, 13 * sc);

// ---------- the display: spectrum, curve, band dots ----------
dx0 = 16 * sc; dy0 = 52 * sc; dw = 748 * sc; dh = 250 * sc;
ui_col(0x050505); ui_rrect(dx0, dy0, dw, dh, 5 * sc);
ui_col(0x0C0D10); gfx_rect(dx0 + 4 * sc, dy0 + 4 * sc, dw - 8 * sc, dh - 8 * sc);
gfx_gradrect(dx0 + 4 * sc, dy0 + 4 * sc, dw - 8 * sc, 80 * sc, 1, 1, 1, 0.04, 0, 0, 0, 0, 0, 0, 0, -0.04 / (80 * sc));
C_SG = 0x2E3138; C_ST = 0x8A867E; C_VA = 0xEEEFEA; C_VB = YEL;
gx0 = dx0 + 30 * sc; gw = dw - 40 * sc; gy0 = dy0 + 10 * sc; gh = dh - 28 * sc; gmid = gy0 + gh * 0.5;
DBR = 24;                                           // curve range: +/-24 dB
// grid
gfx_setfont(4);
d_ = 10;
loop(4,
  j_ = 1;
  loop(9,
    fq_ = d_ * j_;
    fq_ >= 20 && fq_ <= 20000 ? (
      qx = gx0 + log(fq_ / 20) / log(1000) * gw;
      ui_cola(C_SG, j_ == 1 ? 0.9 : 0.35); gfx_line(qx, gy0, qx, gy0 + gh);
      (j_ == 1 || j_ == 2 || j_ == 5) ? (
        ui_col(C_ST); gfx_x = qx + 2 * sc; gfx_y = gy0 + gh + 3 * sc;
        sprintf(#gl, fq_ >= 1000 ? "%dk" : "%d", fq_ >= 1000 ? fq_ / 1000 : fq_); gfx_drawstr(#gl);
      );
    );
    j_ += 1;
  );
  d_ *= 10;
);
g_ = -24;
loop(9,
  qy = gmid - g_ / DBR * gh * 0.5;
  ui_cola(C_SG, g_ == 0 ? 0.9 : 0.35); gfx_line(gx0, qy, gx0 + gw, qy);
  ui_col(C_ST); sprintf(#gl, "%+d", g_); gfx_x = dx0 + 4 * sc; gfx_y = qy - 5 * sc; gfx_drawstr(g_ == 0 ? "0" : #gl);
  g_ += 6;
);

// spectrum (output, after the EQ): FFT of the last 4096 samples, peak per column, slow fall
es_an ? (
  i = 0; j = sp_w;
  loop(SP_N, SP_FFT[2 * i] = SP_RING[j] * SP_WIN[i]; SP_FFT[2 * i + 1] = 0; j = (j + 1) & (SP_N - 1); i += 1; );
  fft(SP_FFT, SP_N); fft_permute(SP_FFT, SP_N);
  c = 0;
  loop(SP_NC,
    fa_ = 20 * 1000 ^ (c / SP_NC); fb_ = 20 * 1000 ^ ((c + 1) / SP_NC);
    ka = max(floor(fa_ / srate * SP_N), 1); kb_ = max(floor(fb_ / srate * SP_N), ka);
    mx = 0; k = ka;
    loop(kb_ - ka + 1, mx = max(mx, sqr(SP_FFT[2 * k]) + sqr(SP_FFT[2 * k + 1])); k += 1; );
    v = 10 * log10(max(mx, 0.0000000000001)) + 20 * log10(4 / SP_N);
    SP_COL[c] = max(v, SP_COL[c] - 1.2);
    c += 1;
  );
  // draw: -96 .. 0 dBFS over the full height, filled
  ui_cola(C_VA, 0.16);
  c = 0;
  loop(SP_NC,
    qx = gx0 + c / SP_NC * gw; qy = gy0 + gh - min(max((SP_COL[c] + 96) / 96, 0), 1) * gh;
    gfx_rect(qx, qy, max(gw / SP_NC, 1) + 1, gy0 + gh - qy);
    c += 1;
  );
);

// band curves: each active band faintly in its colour, then the total
b_ = 0;
loop(6,
  i0 = 1 + b_ * 8;
  slider(i0) > 0 ? (
    ui_cola(es_bcol(b_), b_ == es_sel ? 0.5 : 0.22);
    i = 0;
    loop(181,
      fr_ = 20 * 1000 ^ (i / 180);
      db_ = es_band_db(fr_, i0, slider(i0 + 2));
      qx = gx0 + i / 180 * gw; qy = gmid - min(max(db_, -DBR), DBR) / DBR * gh * 0.5;
      i > 0 ? gfx_line(px, py, qx, qy, 1);
      px = qx; py = qy; i += 1;
    );
  );
  b_ += 1;
);
// total: static (bright) and, where a band is dynamic, the live curve (accent)
pass = 0;
loop(2,
  pass == 0 ? ui_col(C_VA) : ui_cola(C_VB, 0.9);
  i = 0;
  loop(241,
    fr_ = 20 * 1000 ^ (i / 240);
    db_ = 0; b_ = 0;
    loop(6, i0 = 1 + b_ * 8; db_ += es_band_db(fr_, i0, pass ? es_live(b_) : slider(i0 + 2)); b_ += 1; );
    slider60 > 20.5 ? ( k_ = 0; loop(slider62 + 1, db_ += es_mag(fr_, 3, slider60, 0, bw_q(slider62 + 1, k_)); k_ += 1; ); );
    slider61 < 19990 ? ( k_ = 0; loop(slider63 + 1, db_ += es_mag(fr_, 4, slider61, 0, bw_q(slider63 + 1, k_)); k_ += 1; ); );
    qx = gx0 + i / 240 * gw; qy = gmid - min(max(db_, -DBR), DBR) / DBR * gh * 0.5;
    i > 0 ? ( gfx_line(px, py, qx, qy, 1); pass == 0 ? gfx_line(px, py + 1, qx, qy + 1, 1); );
    px = qx; py = qy; i += 1;
  );
  pass += 1;
  any_dyn = slider(6) || slider(14) || slider(22) || slider(30) || slider(38) || slider(46);
  !any_dyn ? pass = 2;
);

// dots: drag = frequency + gain (Shift = fine), wheel = Q, double-click = off; double-click empty = add
dr = 7 * sc; hit_any = 0;
b_ = 0;
loop(6,
  i0 = 1 + b_ * 8;
  slider(i0) > 0 ? (
    ty_ = slider(i0);
    bx = gx0 + log(slider(i0 + 1) / 20) / log(1000) * gw;
    by = ty_ <= 3 ? gmid - min(max(slider(i0 + 2), -DBR), DBR) / DBR * gh * 0.5 : gmid;
    hov_ = (mouse_x - bx) ^ 2 + (mouse_y - by) ^ 2 <= (dr + 2 * sc) ^ 2;
    hov_ ? hit_any = 1;
    pressed && drag_id == 0 && hov_ ? (
      time_precise() - es_clk < 0.3 && es_clkb == b_ ? ( slider(i0) = 0; slider_automate(2 ^ (i0 - 1)); drag_id = -1; )
      : ( drag_id = 300 + b_; es_sel = b_; es_mx = mouse_x; es_my = mouse_y; es_f0 = slider(i0 + 1); es_g0 = slider(i0 + 2); );
      es_clk = time_precise(); es_clkb = b_;
    );
    drag_id == 300 + b_ && mdown ? (
      k_ = (mouse_cap & 8) ? 0.2 : 1;
      slider(i0 + 1) = floor(min(max(es_f0 * 1000 ^ ((mouse_x - es_mx) * k_ / gw), 20), 20000) + 0.5);
      ty_ <= 3 ? slider(i0 + 2) = floor(min(max(es_g0 + (es_my - mouse_y) * k_ / (gh * 0.5) * DBR, -24), 24) * 10 + 0.5) / 10;
      slider_automate(2 ^ i0); slider_automate(2 ^ (i0 + 1));
    );
    hov_ && mouse_wheel != 0 && drag_id == 0 ? (
      slider(i0 + 3) = min(max(slider(i0 + 3) * 2 ^ (mouse_wheel / 120 * 0.2), 0.1), 30); slider_automate(2 ^ (i0 + 2)); mouse_wheel = 0;
    );
    (hov_ || drag_id == 300 + b_ || es_sel == b_) ? ( ui_cola(es_bcol(b_), 0.35); gfx_circle(bx, by, dr + 3 * sc, 1, 1); );
    ui_col(es_bcol(b_)); ty_ == 1 || ty_ == 4 ? gfx_circle(bx, by, dr - 1 * sc, 1, 1) : ui_rrect(bx - dr + 1 * sc, by - dr + 1 * sc, 2 * dr - 2 * sc, 2 * dr - 2 * sc, 2 * sc);
    gfx_setfont(4); ui_col(0x101010); sprintf(#dn, "%d", b_ + 1); ui_text(bx + 0.5, by - 5 * sc, #dn);
    slider(i0 + 4) ? ( ui_col(es_bcol(b_)); ui_text(bx, by + dr + 2 * sc, slider(i0 + 4) == 1 ? "M" : "S"); );
  );
  b_ += 1;
);
// double-click on empty space: switch on the first free band there
mouse_x >= gx0 && mouse_x <= gx0 + gw && mouse_y >= gy0 && mouse_y <= gy0 + gh && !hit_any && pressed && drag_id == 0 ? (
  time_precise() - es_eclk < 0.3 ? (
    b_ = 0; fnd = -1; loop(6, fnd < 0 && slider(1 + b_ * 8) == 0 ? fnd = b_; b_ += 1; );
    fnd >= 0 ? (
      i0 = 1 + fnd * 8; slider(i0) = 1;
      slider(i0 + 1) = floor(min(max(20 * 1000 ^ ((mouse_x - gx0) / gw), 20), 20000) + 0.5);
      slider(i0 + 2) = floor(min(max((gmid - mouse_y) / (gh * 0.5) * DBR, -24), 24) * 10 + 0.5) / 10;
      slider(i0 + 3) = 1; slider_automate(2 ^ (i0 - 1)); slider_automate(2 ^ i0); slider_automate(2 ^ (i0 + 1));
      es_sel = fnd;
    );
    es_eclk = 0;
  ) : es_eclk = time_precise();
);

// ---------- selected band ----------
i0 = 1 + es_sel * 8;
sprintf(#bn, "BAND %d", es_sel + 1);
es_sect(16, 310, 470, 122, #bn);
// band picker: six keys in the band colours
b_ = 0;
loop(6, sprintf(#dn, "%d", b_ + 1); rd_sq(96 + b_ * 32, 314, 28, 22, es_sel == b_, es_bcol(b_), #dn) ? es_sel = b_; b_ += 1; );
i0 = 1 + es_sel * 8;
// type: a key that opens a menu
rd_sq(296, 314, 112, 22, slider(i0) > 0, ACC, slider(i0) == 0 ? "OFF" : slider(i0) == 1 ? "BELL" : slider(i0) == 2 ? "LOW SHELF" :
      slider(i0) == 3 ? "HIGH SHELF" : slider(i0) == 4 ? "NOTCH" : slider(i0) == 5 ? "LOW CUT" : "HIGH CUT") ? (
  gfx_x = 296 * sc; gfx_y = 338 * sc;
  m_ = gfx_showmenu("Off|Bell|Low shelf|High shelf|Notch|Low cut (24 dB/oct)|High cut (24 dB/oct)");
  m_ > 0 ? ( slider(i0) = m_ - 1; slider_automate(2 ^ (i0 - 1)); );
);
rd_sq(414, 314, 62, 22, es_solo == es_sel + 1, YEL, "SOLO") ? es_solo = es_solo == es_sel + 1 ? 0 : es_sel + 1;
// knobs (the value shows on hover): FREQ in the band's colour, GAIN and Q white
dy_kst = 36; sprintf(#v, "%.0f Hz", slider(i0 + 1)); dy_knob(78, 382, 24, i0 + 1, 20, 20000, 1000, 1, ACC, "FREQ", #v);
dy_kst = 35;
slider(i0) <= 3 ? ( sprintf(#v, "%+.1f dB", slider(i0 + 2)); dy_knob(162, 382, 24, i0 + 2, -24, 24, 0, 0, WHT, "GAIN", #v); )
               : ( rd_lbl(162, 378, "-", DIM, 0.6); );
slider(i0) <= 4 ? ( sprintf(#v, "%.2f", slider(i0 + 3)); dy_knob(246, 382, 24, i0 + 3, 0.1, 30, 1, 1, WHT, "Q", #v); )
               : ( rd_lbl(246, 378, "24 dB/OCT", DIM, 0.8); );
// target
b_ = 0;
loop(3, rd_sq(306 + b_ * 40, 366, 36, 24, slider(i0 + 4) == b_, 0xC7BEB3, b_ == 0 ? "ST" : b_ == 1 ? "M" : "S") ? (
  slider(i0 + 4) = b_; slider_automate(2 ^ (i0 + 3)); ); b_ += 1; );
rd_lbl(364, 398, "TARGET", DIM, 1);
es_solo ? ( sprintf(#sl, "SOLO: BAND %d", es_solo); rd_lbl(440, 366, #sl, es_bcol(es_solo - 1), 1); );

// ---------- dynamics (the selected band) ----------
es_sect(494, 310, 270, 122, "DYNAMICS");
dy_kst = 35;
slider(i0) == 1 ? (
  rd_sq(690, 314, 64, 22, slider(i0 + 5), ACC, "DYN") ? ( slider(i0 + 5) = 1 - slider(i0 + 5); slider_automate(2 ^ (i0 + 4)); );
  sprintf(#v, "%.1f dB", slider(i0 + 6)); dy_knob(530, 384, 19, i0 + 6, -60, 0, -30, 0, WHT, "THRESH", #v);
  sprintf(#v, "%+.1f dB", slider(i0 + 7)); dy_knob(590, 384, 19, i0 + 7, -24, 24, 0, 0, WHT, "RANGE", #v);
) : ( rd_lbl(560, 380, "BELLS ONLY", DIM, 0.8); );
sprintf(#v, "%.1f ms", slider49); dy_knob(650, 384, 19, 49, 0.5, 100, 5, 1, WHT, "ATTACK", #v);
sprintf(#v, "%.0f ms", slider50); dy_knob(712, 384, 19, 50, 10, 1000, 120, 1, WHT, "RELEASE", #v);

// ---------- FILTERS, IN / OUT, MASTER ----------
es_sect(16, 440, 258, 94, "FILTERS");
// house caps: HPF yellow, LPF black
dy_kst = 36;
slider60 <= 20.5 ? strcpy(#v, "off") : sprintf(#v, "%.0f Hz", slider60); dy_knob(64, 488, 19, 60, 20, 1000, 20, 1, YEL, "HPF", #v);
slider61 >= 19990 ? strcpy(#v, "off") : sprintf(#v, "%.0f Hz", slider61); dy_knob(176, 488, 19, 61, 1000, 20000, 20000, 1, 0x1A1A1C, "LPF", #v);
// slope multipliers: click to step x1 -> x4 (12 - 48 dB / octave)
sprintf(#hs, "x%d", slider62 + 1); sprintf(#ls, "x%d", slider63 + 1);
rd_sq(102, 470, 34, 22, slider60 > 20.5, 0xC7BEB3, #hs) ? ( slider62 = (slider62 + 1) % 4; slider_automate(2 ^ 61); );
rd_sq(214, 470, 34, 22, slider61 < 19990, 0xC7BEB3, #ls) ? ( slider63 = (slider63 + 1) % 4; slider_automate(2 ^ 62); );
sprintf(#hs, "%d dB", (slider62 + 1) * 12); rd_lbl(119, 500, #hs, DIM, 1);
sprintf(#ls, "%d dB", (slider63 + 1) * 12); rd_lbl(231, 500, #ls, DIM, 1);
es_sect(282, 440, 270, 94, "IN / OUT");
rd_ioc1 = 0x3A3B40; rd_ioc2 = YEL; rd_ioc3 = 0xFF4A30; rd_iok = 35;
rd_io(322, 470, 52, 53, 54, 59);
es_sect(560, 440, 204, 94, "MASTER");
dy_kst = 35; sprintf(#v, "%+.1f dB", slider51); dy_knob(630, 490, 22, 51, -24, 12, 0, 0, WHT, "OUTPUT", #v);
ui_col(0x141518); gfx_rect(700 * sc, 452 * sc, 50 * sc, 74 * sc);
mL.ui_ledm(708 * sc, 456 * sc, 14 * sc, 66 * sc, pkL);
mR.ui_ledm(728 * sc, 456 * sc, 14 * sc, 66 * sc, pkR);
pkL *= 0.85; pkR *= 0.85;
dy_kst = 0;
pk_end();
ui_end();
