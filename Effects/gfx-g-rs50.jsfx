  g_hov && pressed && drag_id == 0 ? ( drag_id = -1;  aud_t_d = g_tv;  aud_n_d += 1; );
  g_k > 0 ? ( ui_cola(KRI, 0.1);  kr_r(g_cx - 31.5, 104, 1, 488); );
