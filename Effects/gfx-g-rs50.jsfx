slider9:lv_ch=60<0,100,1>-Cl Hat level (%)
slider10:lv_oh=60<0,100,1>-Op Hat level (%)
slider11:lv_cr=50<0,100,1>-Crash level (%)
slider12:lv_rd=50<0,100,1>-Ride level (%)
