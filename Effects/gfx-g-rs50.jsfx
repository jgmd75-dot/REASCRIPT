    g_tv == 6 ? "CLAP" : g_tv == 7 ? "CL HAT" : g_tv == 8 ? "OP HAT" : g_tv == 9 ? "CRASH" : g_tv == 10 ? "RIDE" : g_tv == 11 ? "LO CGA" :
