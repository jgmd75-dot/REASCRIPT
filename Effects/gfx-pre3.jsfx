desc:GFX PRE3 [preamp]
//tags: preamp drive saturation transformer console discrete transistor
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-clip (.jsfx-inc) in the same folder.
//
// PRE3: three overlooked studio preamp topologies in one box, each with its own face.
//   WEST - a 70s West Coast discrete-transistor and transformer preamp: a warm, woody low-mid lift (280 Hz) going
//          into a soft, asymmetric curve (2nd and 3rd harmonic thickness), the output iron saturating the lows on
//          their own, a gentle golden roll-off at the top. Saturates earliest.
//   JH   - a 70s / 80s American console preamp: flat and high-headroom, a touch of low weight, then an op-amp that
//          stays clean until it reaches its rail and clips proportionally (firm knee) when pushed past it.
//   AERO - an aerospace-derived op-amp preamp: flat, fast and clean, the most headroom of the three (+4 dB over JH),
//          a hard / soft hybrid limit whose knee softens as it is driven. The least colour, the most snap.
// Each face sets the sound; changing the model fades out (15 ms), switches at the silent point and fades back in.
//
// SIGNAL FLOW (per channel; stereo, both sides identical)
//   input -> DRIVE (-12 .. +15 dB; below 0 a plain trim, 0 neutral, above 0 into the model) -> HPF (OFF, 30, 50, 80, 120, 180 Hz, 12 dB/oct) -> the model's pre-EQ
//   -> drive-tracking pre-filter (house clipper standard: a low-pass sliding down and a low shelf pulling the lows
//   back as DRIVE rises, not made up) -> the model's curve (anti-aliased, house clip kit) -> the model's post-EQ
//   -> AUTO gain (takes the DRIVE back out, so DRIVE changes the colour, not the level) -> OUTPUT (-24 .. +24 dB)
//   -> 2 Hz DC blocker -> the house output stage (CLIP, always on) -> BYPASS crossfade (20 ms). Latency 0 (the
//   anti-aliased curves lag half a sample, as on every house drive unit).
// DRIVE: below 0 a plain trim (cuts the level, nothing else); at 0 neutral (the model's EQ, curve and iron are faded
//   out); above 0 the model fades in over the first 3 dB, up to +15 dB into the model. At -18 dBFS in, WEST thickens
//   from about +6, JH just starts to bite at +15, AERO stays clean (it colours only louder material).
// Levels: 0 dBFS = +18 dBu.
// DRIFT (0 - 100 %, 50 % = standard): supply + iron. Loud passages sag the supply (the headroom drops a little and
//   comes back over about 120 ms: WEST most, JH less, AERO hardly at all), and the bias / iron wanders slowly on each
//   side (the balance of 2nd to 3rd harmonic breathes). 0 % = steady.
// METERS: IN (the input, before DRIVE) and OUT (after OUTPUT), peak, -48 .. 0 dBFS, L / R. SAT lights while the
//   curve is bending the signal.
// GUI: drag a knob (shift = fine, double-click = default, wheel); click a key; click the LCD for the preset list.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,2,1{West,JH,Aero}>-Model
slider2:0<-12,15,0.1>-Drive (dB)
slider3:0<-24,24,0.1>-Output (dB)
slider4:0<0,5,1{OFF,30 Hz,50 Hz,80 Hz,120 Hz,180 Hz}>-HPF
slider5:1<0,1,1{Off,On}>-Auto gain
slider6:50<0,100,1>-Drift (%)
slider7:0<0,1,1{Off,On}>-Bypass

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
#ui_man = "gfx-pre3";                                  // the ? pop-up links to this manual
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
p3_C   = alloc(8);                                      // HPF state-variable coefficients
p3_THP = alloc(8);
p3_THP[0] = 0; p3_THP[1] = 30; p3_THP[2] = 50; p3_THP[3] = 80; p3_THP[4] = 120; p3_THP[5] = 180;
p3_TBL = alloc(16 * 6);                                 // preset rows: model, drive, output, hpf, auto
ost_init(0);

// ---------- the TPT state-variable filter (as KRT81): high-pass out in p3_hp ----------
function p3_svf(v0, c) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = v0 - ic2;
  v1 = c[0] * ic1 + c[1] * v3;
  v2 = ic2 + c[1] * ic1 + c[2] * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  p3_hp = v0 - c[3] * v1 - v2;
  v2;
);
function p3_cset(c, f, k) local(g) (
  g = tan($pi * min(max(f, 5), 0.45 * srate) / srate);
  c[0] = 1 / (1 + g * (g + k)); c[1] = g * c[0]; c[2] = g * c[1]; c[3] = k;
);

// ---------- the curve, anti-aliased on its residual (as the house output stage's clipper) ----------
// Only what the curve adds (crv(v) - v) is anti-aliased (first-order antiderivative), with its half-sample lag made up;
// while the curve is straight the signal passes bit for bit, so a clean preamp stays flat to the top of the band.
// Called on a clp-kit curve instance: cv.p3_res(v).
function p3_res(v) instance(v1, ra1, rq1) local(ra, rq, dv, y) (
  ra = this.clp_ad(v) - 0.5 * v * v; rq = this.clp_crv(v) - v;
  dv = v - v1;
  y = abs(dv) > 0.00001 ? (ra - ra1) / dv : this.clp_crv(0.5 * (v + v1)) - 0.5 * (v + v1);
  y = v + y + 0.5 * (rq - rq1);
  v1 = v; ra1 = ra; rq1 = rq;
  y;
);
// re-read the stored point under the curve as it is now (after the curve or its knee changed)
function p3_rres() instance(v1, ra1, rq1) ( ra1 = this.clp_ad(v1) - 0.5 * v1 * v1; rq1 = this.clp_crv(v1) - v1; );
function p3_zres() instance(v1, ra1, rq1) ( v1 = ra1 = rq1 = 0; );

// the model's EQ at the current colour amount (p3_w: 0 at DRIVE 0, all of it from +3 dB)
function p3_eqset() instance(pre, post) (
  pre.bq_set(p3_et1, p3_ef1, 0.7, p3_eg1 * p3_w); post.bq_set(3, min(p3_ef2, 0.4 * srate), 0.7, p3_eg2 * p3_w);
);

// ---------- the model's curves and EQ (set per channel instance when the model changes) ----------
// WEST: SOFT, asymmetric (+0.95 / -0.80) with a bias (2nd harmonic); the iron: SOFT on the lows only.
// JH:   KNEE, +1.10 / -1.05, firm knee (0.12): clean to its rail, then proportional clipping.
// AERO: KNEE, +/-1.60, knee 0.20 widening to 0.50 with DRIVE (hard / soft hybrid).
function p3_model(m) instance(cv, ir, pre, post, pf) (
  m == 0 ? (
    cv.clp_set(1, 0.95, 0.80, 0); ir.clp_set(1, 0.45, 0.45, 0);
    p3_et1 = 2; p3_ef1 = 280; p3_eg1 = 1.5; p3_ef2 = 10000; p3_eg2 = -0.8;
    pf.clp_pf_cfg(0.45 * srate, 9000, -2, 120);
  ) : m == 1 ? (
    cv.clp_set(2, 1.10, 1.05, 0); cv.clp_knee(0.12);
    p3_et1 = 4; p3_ef1 = 80; p3_eg1 = 0.6; p3_ef2 = 10000; p3_eg2 = 0;
    pf.clp_pf_cfg(0.45 * srate, 12000, -1, 120);
  ) : (
    cv.clp_set(2, 1.60, 1.60, 0); cv.clp_knee(0.2);
    p3_et1 = 2; p3_ef1 = 280; p3_eg1 = 0; p3_ef2 = 16000; p3_eg2 = 0.4;
    pf.clp_pf_cfg(0.45 * srate, 16000, 0, 120);
  );
  cv.p3_zres(); ir.p3_zres(); pf.clp_pf_reset();
  pre.x1 = pre.x2 = pre.y1 = pre.y2 = 0; post.x1 = post.x2 = post.y1 = post.y2 = 0;
  this.p3_eqset();
  this.ilp = this.dx = this.dy = this.env = 0; this.hs.ic1 = this.hs.ic2 = 0;
);

// ---------- one channel ----------
function p3_ch(x) instance(cv, ir, pre, post, pf, hs, ilp, env, dx, dy, wb) local(u, b, a, s, y, lo, d) (
  u = x * p3_gin;
  p3_hpon ? ( hs.p3_svf(u, p3_C); u = p3_hp; );
  u = pre.bq_run(u);
  p3_pfw > 0 ? u += (pf.clp_pf_run(u) - u) * p3_pfw;   // the pre-filter comes in with DRIVE (none on AERO)
  // supply sag: the headroom drops on loud passages (drive the curve harder, take it back after)
  a = abs(u); env += (a - env) * (a > env ? p3_sa : p3_srl);
  s = 1 - p3_sag * min(env / p3_cl, 1);
  u /= s;
  abs(u) > p3_kn ? p3_sat = 1;
  p3_mod == 0 ? (
    b = 0.06 + wb;                                      // the bias, wandering with DRIFT
    y = u + p3_wc * (cv.p3_res(u + b) - cv.clp_crv(b) - u);
    ilp += (y - ilp) * p3_ilc; lo = ilp;                // the output iron: the lows saturate on their own
    y += p3_wc * (ir.p3_res(lo) - lo);
  ) : (
    b = wb;
    y = u + p3_wc * (cv.p3_res(u + b) - cv.clp_crv(b) - u);
  );
  y *= s;
  y = post.bq_run(y);
  y *= p3_mk;                                            // AUTO gain and OUTPUT
  d = y; dy = d - dx + p3_dcd * dy; dx = d;             // 2 Hz DC blocker
  dy;
);
function p3_tidy() instance(cv, ir, pre, post, hs, ilp, env, dx, dy) (
  abs(cv.v1) < 0.000000000001 ? cv.p3_zres(); abs(ir.v1) < 0.000000000001 ? ir.p3_zres();
  abs(pre.y1) < 0.0000000001 ? pre.x1 = pre.x2 = pre.y1 = pre.y2 = 0;
  abs(post.y1) < 0.0000000001 ? post.x1 = post.x2 = post.y1 = post.y2 = 0;
  abs(hs.ic1) < 0.0000000001 ? hs.ic1 = 0; abs(hs.ic2) < 0.0000000001 ? hs.ic2 = 0;
  abs(ilp) < 0.0000000001 ? ilp = 0; env < 0.0000000001 ? env = 0;
  abs(dy) < 0.0000000001 ? dx = dy = 0;
);

function p3_srinit() (
  p3_sr  = srate;
  p3_sa  = 1 - exp(-1 / (0.003 * srate)); p3_srl = 1 - exp(-1 / (0.120 * srate));   // supply sag follower
  p3_ilc = 1 - exp(-2 * $pi * 120 / srate);              // the iron's low band
  p3_dcd = 1 - 2 * $pi * 2 / srate;
  p3_psm = 1 - exp(-1 / (0.02 * srate));
  p3_xf  = 1 / (0.02 * srate);
  p3_mst = 1 / (0.015 * srate); p3_mhd = floor(0.010 * srate);
  ost_init(0);
  cL.p3_model(p3_mod); cR.p3_model(p3_mod);
);

function p3_update() (
  p3_tmod = min(max(slider1 | 0, 0), 2);
  p3_tdrv = min(max(slider2, -12), 15);
  p3_tout = min(max(slider3, -24), 24);
  p3_hps  = min(max(slider4 | 0, 0), 5);
  p3_auto = slider5 >= 0.5;
  drift_macro(slider6);
  p3_tbyp = slider7 >= 0.5;
  ost_setup(0, 0, 120, 6000, -0.3, 1);                  // the house output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
);

// ---------- presets ----------
function p3_row(p, m, d, o, h, a) local(r) ( r = p3_TBL + p * 6; r[0] = m; r[1] = d; r[2] = o; r[3] = h; r[4] = a; );
//          model drive  out  hpf auto
p3_row(1,  0,    0,    0,   0,  1);                     // Init
p3_row(2,  0,    5,    0,   3,  1);                     // West Vocal
p3_row(3,  0,    8,   -1,   1,  1);                     // West Bass Iron
p3_row(4,  0,   11,   -2,   2,  1);                     // West Drums
p3_row(5,  1,    8,    0,   2,  1);                     // JH Punch Drums
p3_row(6,  1,    4,    0,   3,  1);                     // JH Clean Gain
p3_row(7,  1,   12,   -2,   1,  1);                     // JH Hot Bus
p3_row(8,  2,    5,    0,   3,  1);                     // Aero Clean Lift
p3_row(9,  2,   10,    0,   2,  1);                     // Aero Transient
p3_row(10, 2,   15,   -3,   1,  1);                     // Aero Hard Edge
function load_preset(p) local(r) (
  p >= 1 && p <= 10 ? (
    r = p3_TBL + p * 6;
    slider1 = r[0]; slider2 = r[1]; slider3 = r[2]; slider4 = r[3]; slider5 = r[4];
    slider_automate(31);                                 // sliders 1-5
  ) : (                                                  // Reset all to defaults
    r = p3_TBL + 6;
    slider1 = r[0]; slider2 = r[1]; slider3 = r[2]; slider4 = r[3]; slider5 = r[4];
    slider6 = 50; slider7 = 0; slider_automate(127);
  );
);

// ---------- state ----------
dBL.drift_init(0.8 + rand(0.4)); dBR.drift_init(0.8 + rand(0.4));
p3_update();
p3_mod = p3_tmod; p3_mg = 1; p3_mh = 0;
p3_srinit();
p3_drv = p3_tdrv; p3_out = p3_tout; p3_bx = p3_tbyp; p3_dint = max(p3_drv, 0); p3_w = p3_wc = min(max(p3_drv / 3, 0), 1);
p3_fh = p3_hps ? log(p3_THP[p3_hps]) : log(5); p3_hpon = p3_hps > 0;
p3a_i0 = p3a_i1 = p3a_o0 = p3a_o1 = -60; p3a_sat = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

@slider
p3_update();

@block
srate != p3_sr ? p3_srinit();
p3_update();
p3_bdt = samplesblock / srate;
// ---- the model's settings (headroom for the sag and the SAT lamp; sag and wander amounts at DRIFT 50 %)
p3_cl  = p3_mod == 0 ? 0.95 : p3_mod == 1 ? 1.10 : 1.60;
p3_kn  = p3_mod == 0 ? 0.25 : p3_mod == 1 ? 0.98 : 1.30;   // where the curve starts to bend
p3_sag = dm_a * (p3_mod == 0 ? 0.10 : p3_mod == 1 ? 0.05 : 0.02);
p3_wa  = dm_a * (p3_mod == 0 ? 0.03 : p3_mod == 1 ? 0.012 : 0.004);
cL.wb = p3_wa * dBL.drift_tick(0.08 * dm_s * p3_bdt);
cR.wb = p3_wa * dBR.drift_tick(0.08 * dm_s * p3_bdt);
// ---- DRIVE into the pre-filter and (AERO) the knee: 0 at -12 dB, 1 at +30 dB
p3_dn = p3_dint / 15;
p3_w = min(max(p3_drv / 3, 0), 1);                     // the model's colour: none at DRIVE 0, all of it from +3 dB
cL.p3_eqset(); cR.p3_eqset();
cL.pf.clp_pf_block(p3_dn, srate, samplesblock); cR.pf.clp_pf_block(p3_dn, srate, samplesblock);
p3_mod == 2 ? ( p3_kw = 0.2 + 0.3 * p3_dn; cL.cv.clp_knee(p3_kw); cR.cv.clp_knee(p3_kw); cL.cv.p3_rres(); cR.cv.p3_rres(); );
// the pre-filter's share: WEST from 0 to +12 dB of drive, JH from +12 to +24 dB, AERO never (no smear)
p3_pfw = p3_mod == 0 ? min(max(p3_dint / 12, 0), 1) : p3_mod == 1 ? min(max((p3_dint - 12) / 12, 0), 1) : 0;
// ---- HPF: glide in log frequency (50 ms); OFF slides out of the band, then switches out
p3_k = 1 - exp(-p3_bdt / 0.05); p3_fmin = log(5);
p3_th = p3_hps ? log(p3_THP[p3_hps]) : p3_fmin;
p3_hps && !p3_hpon ? ( p3_hpon = 1; p3_fh = p3_fmin; cL.hs.ic1 = cL.hs.ic2 = cR.hs.ic1 = cR.hs.ic2 = 0; );
p3_fh += (p3_th - p3_fh) * p3_k;
!p3_hps && p3_fh < p3_fmin + 0.02 ? p3_hpon = 0;
p3_cset(p3_C, exp(p3_fh), 1.41421356);
// ---- housekeeping and meters (peaks fall 20 dB/s)
cL.p3_tidy(); cR.p3_tidy();
function p3_db(v) ( 8.68588963807 * log(max(v, 0.00001)) );
p3a_i0 = max(p3_db(p3_pi0), p3a_i0 - 20 * p3_bdt); p3a_i1 = max(p3_db(p3_pi1), p3a_i1 - 20 * p3_bdt);
p3a_o0 = max(p3_db(p3_po0), p3a_o0 - 20 * p3_bdt); p3a_o1 = max(p3_db(p3_po1), p3a_o1 - 20 * p3_bdt);
p3a_sat = p3_sat ? 0.08 : max(p3a_sat - p3_bdt, 0);
p3_pi0 = p3_pi1 = p3_po0 = p3_po1 = 0; p3_sat = 0;

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
p3_il = spl0; p3_ir = spl1;
p3_pi0 = max(p3_pi0, abs(p3_il)); p3_pi1 = max(p3_pi1, abs(p3_ir));
p3_drv += (p3_tdrv - p3_drv) * p3_psm; p3_out += (p3_tout - p3_out) * p3_psm;
p3_dint = max(p3_drv, 0);                              // the drive into the model: 0 .. +15 dB
p3_wc = min(max(p3_drv / 3, 0), 1);                     // the curve's share (none at DRIVE 0: neutral)
p3_gin = exp((p3_dint + min(p3_drv, 0)) * 0.115129255);   // below 0: a plain trim (cut)
// ---- a model change: fade out, switch at the silent point (states cleared), wait, fade in
p3_mod != p3_tmod ? (
  p3_mg -= p3_mst;
  p3_mg <= 0 ? ( p3_mg = 0; p3_mod = p3_tmod; cL.p3_model(p3_mod); cR.p3_model(p3_mod); p3_mh = p3_mhd; );
) : p3_mh > 0 ? p3_mh -= 1 : p3_mg < 1 ? p3_mg = min(p3_mg + p3_mst, 1);
p3_mk = exp(((p3_auto ? -p3_dint : 0) + p3_out) * 0.115129255) * p3_mg * p3_mg * (3 - 2 * p3_mg);
p3_l = cL.p3_ch(p3_il); p3_r = cR.p3_ch(p3_ir);
ost_out(p3_l, p3_r);
p3_bx = p3_tbyp ? min(p3_bx + p3_xf, 1) : max(p3_bx - p3_xf, 0);
p3_bx > 0 ? (
  p3_t = p3_bx * p3_bx * (3 - 2 * p3_bx);
  spl0 = ost_l + (p3_il - ost_l) * p3_t; spl1 = ost_r + (p3_ir - ost_r) * p3_t;
) : ( spl0 = ost_l; spl1 = ost_r; );
p3_po0 = max(p3_po0, abs(spl0)); p3_po1 = max(p3_po1, abs(spl1));

@gfx 860 300
ui_begin(860, 300);

// =====================================================================
// One face per model
// =====================================================================
p3v_m = slider1 | 0;
p3v_m == 0 ? (                                          // WEST: brushed gold, walnut header, oxblood
  PFC = 0xB89550; PS = 0xA8864A; PH = 0x4A3220; PHI = 0xE6C98A;
  PI = 0x2B1B0E; PI2 = 0x5E4426; PA = 0x8C2A1E; PW = 0x1E140C; PCAP = 0xEBDDBE; PSK = 0x2A1C10;
  PLED = 0xE8B23A; #p3v_sub = "WEST COAST"; #p3v_sub2 = "DISCRETE + IRON";
) : p3v_m == 1 ? (                                      // JH: console blue-grey, orange
  PFC = 0x8F9BA3; PS = 0x7D8A93; PH = 0x2C3238; PHI = 0xD8DEE2;
  PI = 0x101418; PI2 = 0x3A444C; PA = 0xE07B2A; PW = 0x111417; PCAP = 0x30363C; PSK = 0x181C20;
  PLED = 0xFF8C2A; #p3v_sub = "70s / 80s CONSOLE"; #p3v_sub2 = "OP-AMP PREAMP";
) : (                                                   // AERO: aerospace white, black header, red
  PFC = 0xE9E8E2; PS = 0xF4F3EE; PH = 0x1B1F24; PHI = 0xF4F3EE;
  PI = 0x15181C; PI2 = 0x5A6068; PA = 0xD62828; PW = 0x15181C; PCAP = 0xF6F6F2; PSK = 0x2A2E33;
  PLED = 0xFF3A2A; #p3v_sub = "AEROSPACE"; #p3v_sub2 = "SOLID-STATE PREAMP";
);

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(14, "Trebuchet MS", 15 * sc, 'b');
gfx_setfont(15, "Trebuchet MS", 14 * sc, 'b');

function p3_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function p3_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function p3_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function p3_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function p3_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function p3_lum(c) ( (c & 255) + ((c >> 8) & 255) + ((c >> 16) & 255); );
// a pointer / thick line (pixels), round ends
function p3_line(x1, y1, x2, y2, w) local(k, dx, dy, l, nx, ny) (
  k = max(w, 0.6) * 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001);
  nx = -dy / l * k; ny = dx / l * k;
  gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
  gfx_circle(x1, y1, k, 1, 1); gfx_circle(x2, y2, k, 1, 1);
);

// a flat lit key: lit = the face's accent; returns 1 when clicked
function p3_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = p3_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(ui_mix(PH, 0x000000, 0.4)); p3_r(x, y, w, h);
  on ? ( ui_cola(PA, 0.25); p3_r(x - 2, y - 2, w + 4, h + 4); ui_col(PA); p3_r(x + 1, y + 1, w - 2, h - 2);
         ui_cola(0xFFFFFF, 0.3); p3_r(x + 1, y + 1, w - 2, 1); )
     : ( ui_col(hov ? ui_mix(PH, 0xFFFFFF, 0.12) : ui_mix(PH, 0xFFFFFF, 0.05)); p3_r(x + 1, y + 1, w - 2, h - 2); );
  ui_col(on ? (p3_lum(PA) > 380 ? 0x141416 : 0xF6F2EA) : PHI);
  gfx_setfont(12); p3_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);
// a section: a slightly different shade with a thin frame and its name
function p3_sect(x, y, w, h, name) (
  ui_col(ui_mix(PFC, 0x000000, 0.35)); p3_r(x, y, w, h); ui_col(PS); p3_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.10); p3_r(x + 1, y + 1, w - 2, 1);
  strlen(name) ? ( gfx_setfont(11); ui_col(PI2); p3_txt(x + 9, y + 6, name); );
);
// a knob (pixels): dark skirt, the face's flat cap with one soft edge highlight, a pointer line; the thin track and
// the smooth value arc round it (from the centre on a bipolar knob)
function p3_cap(cx, cy, r, n, bip, cap) local(a, a0, ca, sa, i, pc) (
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(PI2, 0.35); i = 0; loop(2, gfx_arc(cx, cy, r + 6 * sc + i * 0.6, -0.75 * $pi, 0.75 * $pi, 1); i += 1; );
  a0 = bip ? 0 : -0.75 * $pi;
  ui_col(PA); i = 0; loop(5, gfx_arc(cx, cy, r + 5 * sc + i * 0.55 * sc, min(a0, a), max(a0, a), 1); i += 1; );
  ui_cola(0x000000, 0.4); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(PSK); gfx_circle(cx, cy, r, 1, 1);
  ui_col(cap); gfx_circle(cx, cy, r * 0.80, 1, 1);
  ui_cola(0xFFFFFF, 0.28); gfx_arc(cx, cy, r * 0.80 - 1, -1.9, -0.5, 1);
  ui_col(ui_mix(cap, 0x000000, 0.3)); gfx_circle(cx, cy, r * 0.80, 0, 1);
  pc = p3_lum(cap) > 380 ? 0x141416 : 0xF4F0E6;
  ui_col(pc); p3_line(cx + ca * r * 0.15, cy + sa * r * 0.15, cx + ca * r * 0.92, cy + sa * r * 0.92, max(2.2, r * 0.09));
);
p3v_stp = 0; p3v_pw = 0;
// p3v_pw: a knob with 0 at the top (DRIVE): lo .. 0 on the left half, 0 .. hi on the right
function p3_kn(v, lo, hi) ( p3v_pw ? ( v < 0 ? 0.5 * (v - lo) / -lo : 0.5 + 0.5 * v / hi ) : (v - lo) / (hi - lo); );
function p3_kv(n, lo, hi) ( p3v_pw ? ( n < 0.5 ? lo + 2 * n * -lo : (n - 0.5) * 2 * hi ) : lo + n * (hi - lo); );
// a knob: drag (shift = fine), double-click = default, wheel; returns 1 while touched
function p3_knob(cx, cy, r, idx, lo, hi, def, bip, cap) local(v, n, dx, dy, hov, did) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - p3v_lt < 0.35 && p3v_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; p3v_lt = 0; ) : (
      drag_id = did; p3v_my = mouse_y; p3v_lt = time_precise(); p3v_lid = idx; p3v_n = p3_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    p3v_n = min(max(p3v_n + (p3v_my - mouse_y) / (((mouse_cap & 8) ? 1200 : 240) * sc), 0), 1); p3v_my = mouse_y;
    v = p3_kv(p3v_n, lo, hi);
    p3v_stp > 0 ? v = lo + floor((v - lo) / p3v_stp + 0.5) * p3v_stp;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    p3v_stp > 0 ? v = min(max(v + (mouse_wheel > 0 ? p3v_stp : -p3v_stp), lo), hi)
                : v = p3_kv(min(max(p3_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1), lo, hi);
    slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(p3_kn(v, lo, hi), 0), 1);
  p3_cap(cx * sc, cy * sc, r * sc, n, bip, cap);
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.08); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  hov || drag_id == did;
);
// printed scale numbers round a knob ("a|b|c")
function p3_scale(cx, cy, r, n, labels) local(i, k, k0, len, c, a) (
  len = strlen(labels); k0 = 0; i = 0; k = 0; gfx_setfont(13); ui_col(PI);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#p3v_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi;
      p3_ctxt(cx + sin(a) * (r + 22), cy - cos(a) * (r + 22), #p3v_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
// name under a knob; the value replaces it while touched
function p3_name(cx, cy, act, name, val, f) ( gfx_setfont(f); ui_col(act ? PA : PI); p3_ctxt(cx, cy, act ? val : name); );
// a horizontal peak ladder, -48 .. 0 dBFS
function p3_bar(x, y, w, h, v) local(i, n, sw, d, c) (
  n = 24; sw = w / n; i = 0;
  loop(n,
    d = -48 + (i + 0.5) / n * 48;
    c = d > -3 ? 0xFF3A2A : d > -12 ? PLED : 0x46D86A;
    v >= d ? ( ui_cola(c, 0.2); p3_r(x + i * sw - 0.5, y - 1, sw, h + 2); ui_col(c); p3_r(x + i * sw + 0.5, y, sw - 2, h); )
           : ( ui_col(ui_mix(PW, 0xFFFFFF, 0.06)); p3_r(x + i * sw + 0.5, y, sw - 2, h); );
    i += 1;
  );
);
// the corner rivets (house style)
function p3_rivet(cx, cy) local(c) (
  c = ui_mix(PFC, 0x808080, 0.55);
  ui_cola(0x000000, 0.45); gfx_circle((cx + 0.8) * sc, (cy + 1.2) * sc, 3.6 * sc, 1, 1);
  ui_col(ui_mix(c, 0x000000, 0.35)); gfx_circle(cx * sc, cy * sc, 3.6 * sc, 1, 1);
  ui_col(c); gfx_circle(cx * sc, cy * sc, 3 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.35); gfx_circle((cx - 0.9) * sc, (cy - 0.9) * sc, 1.1 * sc, 1, 1);
);

// =====================================================================
// Faceplate and header
// =====================================================================
ui_col(ui_mix(PFC, 0x000000, 0.45)); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(PFC); p3_r(12, 12, 836, 276);
ui_cola(0xFFFFFF, 0.18); p3_r(12, 12, 836, 1.5); ui_cola(0x000000, 0.3); p3_r(12, 286.5, 836, 1.5);
ui_col(PH); p3_r(13.5, 13.5, 833, 50.5);
ui_col(PA); p3_r(13.5, 64, 833, 2);
ui_col(PHI); gfx_circle(45 * sc, 39 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(PH); ui_text(45 * sc, 33.5 * sc, "GFX");
gfx_setfont(6); ui_col(PHI); p3_txt(72, 24, "PRE3");
gfx_setfont(11); ui_col(ui_mix(PHI, PH, 0.3)); p3_txt(150, 25, #p3v_sub); p3_txt(150, 40, #p3v_sub2);
pk_pextra = "Reset all to defaults";
k_ = pk_preset(338 * sc, 22 * sc, 262 * sc, 34 * sc, pr_cur,
  "Init|West Vocal|West Bass Iron|West Drums|JH Punch Drums|JH Clean Gain|JH Hot Bus|Aero Clean Lift|Aero Transient|Aero Hard Edge");
k_ > 0 ? ( load_preset(k_); pr_cur = k_ > 10 ? 1 : k_; );
p3_key(610, 25, 54, 28, "WEST", p3v_m == 0) ? ( slider1 = 0; ui_auto(1); );
p3_key(668, 25, 44, 28, "JH",   p3v_m == 1) ? ( slider1 = 1; ui_auto(1); );
p3_key(716, 25, 54, 28, "AERO", p3v_m == 2) ? ( slider1 = 2; ui_auto(1); );
ui_size_picker(784 * sc, 30 * sc);

// =====================================================================
// INPUT (22 .. 282) | METERS (288 .. 578) | OUTPUT (584 .. 838)
// =====================================================================
p3_sect(22, 74, 260, 206, "INPUT");
p3_scale(100, 168, 34, 7, "-12|-8|-4|0|+5|+10|+15");
p3v_pw = 1; p3v_a = p3_knob(100, 168, 34, 2, -12, 15, 0, 1, PCAP); p3v_pw = 0;
sprintf(#p3v_v, "%+.1f dB", slider2); p3_name(100, 258, p3v_a, "DRIVE", #p3v_v, 14);
p3v_s = slider4 | 0; p3v_s == 0 ? strcpy(#p3v_v, "OFF") : sprintf(#p3v_v, "%d Hz", p3_THP[p3v_s]);
p3v_stp = 1; p3v_a = p3_knob(226, 132, 17, 4, 0, 5, 0, 0, 0xE8C21E); p3v_stp = 0;
p3_name(226, 166, p3v_a, "HPF", #p3v_v, 11);
p3_key(200, 208, 52, 26, "AUTO", slider5 >= 0.5) ? ( slider5 = slider5 >= 0.5 ? 0 : 1; ui_auto(5); );
gfx_setfont(13); ui_col(PI2); p3_ctxt(226, 248, "GAIN MATCH");

p3_sect(288, 74, 290, 206, "");
ui_col(ui_mix(PFC, 0x000000, 0.5)); p3_r(298, 84, 270, 186); ui_col(PW); p3_r(299, 85, 268, 184);
gfx_setfont(11); ui_col(0xC9C4B8);
p3_txt(310, 96, "IN"); p3_txt(310, 160, "OUT");
p3_bar(350, 98, 206, 9, p3a_i0); p3_bar(350, 110, 206, 9, p3a_i1);
p3_bar(350, 162, 206, 9, p3a_o0); p3_bar(350, 174, 206, 9, p3a_o1);
gfx_setfont(13); p3v_i = 0;
loop(5, p3v_d = -48 + p3v_i * 12; p3v_xx = 350 + (p3v_d + 48) / 48 * 206;
  ui_col(0x8F8A80); sprintf(#p3v_tl, "%d", p3v_d); p3_ctxt(p3v_xx - (p3v_i == 4 ? 5 : 0), 134, #p3v_tl); p3_ctxt(p3v_xx - (p3v_i == 4 ? 5 : 0), 198, #p3v_tl);
  p3v_i += 1; );
pk_led(330 * sc, 236 * sc, 5 * sc, p3a_sat > 0, PLED);
gfx_setfont(11); ui_col(0xC9C4B8); p3_txt(344, 229, "SAT");
gfx_setfont(14); ui_col(PLED); p3_rtxt(556, 236, p3v_m == 0 ? "WEST" : p3v_m == 1 ? "JH" : "AERO");

p3_sect(584, 74, 254, 206, "OUTPUT");
p3_scale(660, 168, 32, 5, "-24|-12|0|+12|+24");
p3v_a = p3_knob(660, 168, 32, 3, -24, 24, 0, 1, PCAP);
sprintf(#p3v_v, "%+.1f dB", slider3); p3_name(660, 258, p3v_a, "OUTPUT", #p3v_v, 14);
p3v_a = p3_knob(786, 124, 15, 6, 0, 100, 50, 0, ui_mix(PCAP, PI2, 0.35));
sprintf(#p3v_v, "%.0f%%", slider6); p3_name(786, 156, p3v_a, "DRIFT", #p3v_v, 11);
// BYPASS: a heavy lit key, lit = bypassed
p3v_on = slider7 >= 0.5; p3v_h = p3_hov(744, 196, 84, 48);
ui_cola(0x000000, 0.35); p3_r(745, 199, 84, 48);
ui_col(ui_mix(PH, 0x000000, 0.4)); p3_r(742, 194, 88, 52);
p3v_on ? ( ui_cola(PA, 0.25); p3_r(738, 190, 96, 60); ui_col(PA); p3_r(744, 198, 84, 46); )
       : ( ui_col(p3v_h ? ui_mix(PH, 0xFFFFFF, 0.12) : ui_mix(PH, 0xFFFFFF, 0.05)); p3_r(744, 196, 84, 46); );
gfx_setfont(15); ui_col(p3v_on ? (p3_lum(PA) > 380 ? 0x141416 : 0xF6F2EA) : PHI); p3_ctxt(786, 220 + (p3v_on ? 1 : 0), "BYPASS");
p3v_h && pressed && drag_id == 0 ? ( drag_id = -1; slider7 = p3v_on ? 0 : 1; ui_auto(7); );

p3_rivet(6.5, 6.5); p3_rivet(853.5, 6.5); p3_rivet(6.5, 293.5); p3_rivet(853.5, 293.5);

pk_end();
ui_end();
