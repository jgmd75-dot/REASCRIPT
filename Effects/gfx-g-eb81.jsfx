eg_kn(eg_x + 119, eg_ky, 16, 35, 0, 100, 30, 0, "SUS", "%.0f%%", 2);
eg_kn(eg_x + 163, eg_ky, 16, 36, 5, 8000, 400, 1, "REL", "%.0f ms", 2);
eg_kn(eg_x + 207, eg_ky, 16, 37, -100, 100, 30, 0, "DEPTH", "%+.0f%%", 2);
eg_kn(eg_x + 251, eg_ky, 16, 38, -100, 100, 0, 0, "CUTOFF", "%+.0f%%", 2);
// LFO
eg_x = 496; eg_mod(eg_x, eg_by, 214, eg_bh, "LFO");
eg_keys(eg_x + 10, eg_by + 30, 32, 26, 3, 41, 4, "SIN|TRI|SQR|S&H", 0);
