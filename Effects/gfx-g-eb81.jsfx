eg_i = 0;
loop(3,
  eg_dx = 494 + eg_i * 86; eg_dy = 266;
  ui_col(floor(slider23 + 0.5) == eg_i ? (eg_th == 0 ? eg_ink : eg_a) : eg_i2);
  eg_box(eg_dx + 8, eg_dy, "A"); eg_box(eg_dx + 54, eg_dy, "B");
  eg_i == 0 ? ( eg_arrow(eg_dx + 27, eg_dy + 7.5, eg_dx + 53, eg_dy + 7.5); eg_arrow(eg_dx + 73, eg_dy + 7.5, eg_dx + 79, eg_dy + 7.5); ) :
  eg_i == 1 ? ( eg_arrow(eg_dx + 53, eg_dy + 7.5, eg_dx + 27, eg_dy + 7.5); eg_ln(eg_dx + 17, eg_dy + 16, eg_dx + 17, eg_dy + 24); eg_ln(eg_dx + 63, eg_dy + 16, eg_dx + 63, eg_dy + 24); eg_ln(eg_dx + 17, eg_dy + 24, eg_dx + 63, eg_dy + 24); gfx_setfont(10); eg_ct(eg_dx + 40, eg_dy + 19, "+"); ) :
  ( eg_arrow(eg_dx + 27, eg_dy + 4, eg_dx + 53, eg_dy + 4); eg_arrow(eg_dx + 53, eg_dy + 11, eg_dx + 27, eg_dy + 11); gfx_setfont(10); eg_ct(eg_dx + 40, eg_dy + 22, "LIMIT"); );
  eg_i += 1;
);
eg_i = 0;

// =====================================================================
