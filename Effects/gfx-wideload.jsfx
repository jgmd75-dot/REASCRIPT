  p == 8 ? ( slider(1) = 0;  slider(2) = 0;  slider(3) = 1;  slider(4) = 0;  slider(5) = 1;  slider(6) = 0;  slider(7) = 0;  slider(8) = 0;  slider(9) = 1;  slider(10) = 1;  slider(11) = 0;  slider(12) = 1;  slider(13) = 0;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = 0;  slider(18) = 2500;  slider(19) = 1;  slider(20) = 0;  slider(21) = 0;  slider(22) = 0;  slider(23) = 0;  slider(24) = 0;  slider(25) = -10;  slider(26) = 0;  slider(27) = 2;  slider(28) = 1;  slider(29) = 1;  slider(30) = 0;  slider(31) = 1;  slider(33) = 0;  slider(34) = 30;  slider(35) = 0;  slider(36) = 0;  slider(37) = 2;  slider(38) = 6;  slider(39) = 4;  slider(40) = 3;  slider(41) = 5;  slider(42) = 0;  slider(43) = 1;  slider(44) = 0;  slider(45) = 0;  slider(46) = 5;  slider(47) = 1;  slider(48) = 0;  slider(49) = 30;  slider(50) = 120;  slider(51) = 6000;  slider(52) = -0.3; ) :   // Bass: Low Trick
  p == 9 ? ( slider(1) = 0;  slider(2) = 1;  slider(3) = 0;  slider(4) = 0;  slider(5) = 1;  slider(6) = 0;  slider(7) = 0;  slider(8) = 0;  slider(9) = 1;  slider(10) = 1;  slider(11) = 0;  slider(12) = 1;  slider(13) = 0;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = 0;  slider(18) = 2200;  slider(19) = 1;  slider(20) = 3;  slider(21) = 0;  slider(22) = 2;  slider(23) = 0;  slider(24) = 0;  slider(25) = -10;  slider(26) = 0;  slider(27) = 2;  slider(28) = 1;  slider(29) = 1;  slider(30) = 0;  slider(31) = -4.5;  slider(33) = 18;  slider(34) = 80;  slider(35) = 0;  slider(36) = -12;  slider(37) = 1;  slider(38) = 0;  slider(39) = 0;  slider(40) = 3;  slider(41) = 5;  slider(42) = 0;  slider(43) = 1;  slider(44) = 0;  slider(45) = 0;  slider(46) = 5;  slider(47) = 1;  slider(48) = 0;  slider(49) = 30;  slider(50) = 120;  slider(51) = 6000;  slider(52) = -0.3; ) :   // Guitar: Crunchy Pre
  p == 10 ? ( slider(1) = 0;  slider(2) = 0;  slider(3) = 0;  slider(4) = 0;  slider(5) = 1;  slider(6) = 0;  slider(7) = 0;  slider(8) = 0;  slider(9) = 1;  slider(10) = 1;  slider(11) = 0;  slider(12) = 2;  slider(13) = 2;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = 0;  slider(18) = 2500;  slider(19) = 1;  slider(20) = 0;  slider(21) = 0;  slider(22) = 0;  slider(23) = 0;  slider(24) = 1;  slider(25) = -12;  slider(26) = 2;  slider(27) = 4;  slider(28) = 4;  slider(29) = 1;  slider(30) = 2;  slider(31) = -2;  slider(33) = 0;  slider(34) = 30;  slider(35) = 0;  slider(36) = 0;  slider(37) = 1;  slider(38) = 0;  slider(39) = 0;  slider(40) = 3;  slider(41) = 5;  slider(42) = 0;  slider(43) = 1;  slider(44) = 0;  slider(45) = 0;  slider(46) = 5;  slider(47) = 1;  slider(48) = 0;  slider(49) = 30;  slider(50) = 120;  slider(51) = 6000;  slider(52) = -0.3; ) :   // Mix Bus: Glue
