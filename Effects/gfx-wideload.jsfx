  p == 12 ? ( slider(1) = 0;  slider(2) = 1;  slider(3) = 1;  slider(4) = 1;  slider(5) = 1;  slider(6) = 0;  slider(7) = 0;  slider(8) = 40;  slider(9) = 1;  slider(10) = 1;  slider(11) = 0;  slider(12) = 1;  slider(13) = 0;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = 0;  slider(18) = 2500;  slider(19) = 1;  slider(20) = 0;  slider(21) = 0;  slider(22) = 0;  slider(23) = 0;  slider(24) = 1;  slider(25) = -10;  slider(26) = 0;  slider(27) = 2;  slider(28) = 1;  slider(29) = 1;  slider(30) = 0;  slider(31) = -8.5;  slider(33) = 24;  slider(34) = 100;  slider(35) = 0;  slider(36) = -18;  slider(37) = 1;  slider(38) = 0;  slider(39) = 0;  slider(40) = 3;  slider(41) = 5;  slider(42) = 2;  slider(43) = 1;  slider(44) = 0;  slider(45) = 18;  slider(46) = 3;  slider(47) = 2;  slider(48) = 0;  slider(49) = 30;  slider(50) = 120;  slider(51) = 6000;  slider(52) = -0.3; ) :   // Colour: All B, Hot
  p == 13 ? ( slider(1) = 0;  slider(2) = 0;  slider(3) = 0;  slider(4) = 0;  slider(5) = 1;  slider(6) = 0;  slider(7) = 0;  slider(8) = 0;  slider(9) = 1;  slider(10) = 1;  slider(11) = 0;  slider(12) = 1;  slider(13) = 0;  slider(14) = 400;  slider(15) = 1;  slider(16) = 0;  slider(17) = 0;  slider(18) = 2500;  slider(19) = 1;  slider(20) = 0;  slider(21) = 0;  slider(22) = 0;  slider(23) = 0;  slider(24) = 0;  slider(25) = -10;  slider(26) = 0;  slider(27) = 2;  slider(28) = 1;  slider(29) = 1;  slider(30) = 0;  slider(31) = 0;  slider(32) = 0;  slider(33) = 0;  slider(34) = 30;  slider(35) = 0;  slider(36) = 0;  slider(37) = 1;  slider(38) = 0;  slider(39) = 0;  slider(40) = 3;  slider(41) = 5;  slider(42) = 0;  slider(43) = 1;  slider(44) = 0;  slider(45) = 0;  slider(46) = 5;  slider(47) = 1;  slider(48) = 0;  slider(49) = 30;  slider(50) = 120;  slider(51) = 6000;  slider(52) = -0.3; ) : 0;   // Reset all to defaults
  slider_automate(p == 13 ? 4503599627370495 : 4503597479886847);
  gui_dirty = 1;
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
update_params();
ost_setup(out_sat / 100, os_bias / 100, os_lo, os_hi, os_ceil, 1);   // output stage: band SAT + CLIP, always on
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
// GUI edits arrive as a flag; parameters are only ever rebuilt on the audio thread
prm_dirty ? ( prm_dirty = 0;  update_params(); );
ord_dirty = ord_new != ord_act || mdl_new != mdl_act;   // ORDER or an A/B change: dip, swap, return
// DRIFT: slow rail wander (smoothed random walk)
dw_t += samplesblock / srate;
dw_t > 0.7 ? ( dw_t = 0;  dw_target = rand(2) - 1; );
dw += (dw_target - dw) * (1 - exp(-samplesblock / (srate * 1.5)));
gb_thr_d = gb_thr + drift_amt * 0.6 * dw;             // GB-2: VCA threshold wander
vm_thr_d = vm_thr_db + drift_amt * 0.8 * dw;          // VM-67: tube bias wander
// meter hand-offs
inL_d  = max(inL_d,  inpkL);   inpkL = 0;   inR_d  = max(inR_d,  inpkR);   inpkR = 0;
outL_d = max(outL_d, outpkL);  outpkL = 0;  outR_d = max(outR_d, outpkR);  outpkR = 0;
gr_d   = max(gr_d, gb_gr_pk);  gb_gr_pk = 0;
arpk_d = max(arpk_d, ar_pk);   ar_pk = 0;

@sample
aL = spl0;  aR = spl1;
inpkL = max(inpkL, abs(aL));  inpkR = max(inpkR, abs(aR));

// AR-70 DRIFT: sag on loud material + rail wander shrink the stage's headroom
lvl = max(abs(aL), abs(aR));
sag_env += (lvl - sag_env) * (lvl > sag_env ? sag_a : sag_r);
sg = min(sag_env, 1);
ar_kd = AR_K * (1 + drift_amt * (0.12 * dw + 0.6 * sg));
ar_nd = sqr(1 + AR_BIAS) / ar_kd;

i = 0;
loop(3,
  t = mod_tgt[i];  v = mod_on[i];
  v != t ? ( mod_on[i] = t > v ? min(t, v + ramp_step) : max(t, v - ramp_step); );
  i += 1;
);

ord_dirty ? (
  fade_g = max(0, fade_g - fade_step);
  fade_g == 0 ? ( ord_act = ord_new;  mdl_act = mdl_new;  ord_dirty = 0; );
) : fade_g < 1 ? ( fade_g = min(1, fade_g + fade_step); );

run_module(0);
ord_act ? ( run_module(2); run_module(1); ) : ( run_module(1); run_module(2); );

out_s += (out_t - out_s) * out_sm;
aL = ostL.ost_band(aL) * out_s * fade_g;
aR = ostR.ost_band(aR) * out_s * fade_g;
ost_out(aL, aR);  aL = ost_l;  aR = ost_r;            // house clipper, -0.3 dBFS ceiling
outpkL = max(outpkL, abs(aL));  outpkR = max(outpkR, abs(aR));
spl0 = aL;  spl1 = aR;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@serialize
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@gfx 1000 684
function gdb(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );   // GUI copy of g2db (audio and GUI threads must not share functions)
// =====================================================================
// GUI — grimy underground-comix rack (inked outlines, hatching, newsprint and head-shop colours), 150 px slots. Double-wide modules
// take two slots; a single-wide model in a double slot leaves a blank plate.
// House style skew: satin knob caps in the house colour code, 34-series lamp
// keys, rivets; each module borrows its reference's character.
// =====================================================================
function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function param_touched(idx) ( slider_automate(2 ^ (idx - 1)); gui_dirty = 1; );
function inr(X, Y, W, H) ( mouse_x >= X && mouse_x <= X + W && mouse_y >= Y && mouse_y <= Y + H; );

// cross-head screw
function screw(x, y) local(X, Y, R) (
  X = px(x);  Y = py(y);  R = ps(7);
  col(0x000000, 0.3);  gfx_circle(X + ps(1), Y + ps(1.5), R, 1, 1);
  col(0x8E887A, 1);    gfx_circle(X, Y, R, 1, 1);
  col(0xC9C0A8, 1);    gfx_arc(X, Y, R - ps(1), -1.9, -0.3, 1);
  col(0x2E2B24, 1);
  gfx_line(X - R * 0.55, Y, X + R * 0.55, Y, 1);  gfx_line(X, Y - R * 0.55, X, Y + R * 0.55, 1);
);

// knob pointer: one filled bar, constant width at any angle
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);

// ---------- house lamp keys (34-series), ported from gfx-lab-ui lk_key / lk_fit ----------
lk_well = 0x141518;
LK_AMB = 0xF2A41E;  LK_YEL = 0xF2C230;  LK_BLU_LT = 0x5C9AEC;  LK_WHT = 0xE9E2CC;  LK_RED = 0xD8332E;  LK_VIO = 0xA47BE0;
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lk_fit(x, y, w, h, on, c, str) local(k) (
  k = min(w / 62, h / 48);
  lk_key(x + 4 * k, y + 4 * k, w - 8 * k, h - 8 * k, on, c, str);
);

// ---------- comix drawing helpers (Wideload look: grimy underground-comix ink) ----------
// Inked outline: a rounded rectangle th px thick (pixel coordinates)
function rr_line(xa, ya, wa, ha, r, th) local(k) (
  k = 0;
  loop(max(1, floor(th + 0.5)),
    gfx_roundrect(xa + k, ya + k, wa - 2 * k, ha - 2 * k, max(1, r - k), 1);
    k += 1;
  );
);
// 45-degree hatching in a vertical strip and a horizontal strip (pixel coordinates)
function hatch_v(xa, ya, wd, ht) local(y) (
  y = ya + wd;
  while (y <= ya + ht) ( gfx_line(xa, y, xa + wd, y - wd, 1);  y += ps(4); );
);
function hatch_h(xa, ya, wd, ht) local(x) (
  x = xa;
  while (x <= xa + wd - ht) ( gfx_line(x, ya + ht, x + ht, ya, 1);  x += ps(4); );
);
// hatching across a disc
function hatch_disc(x, y, rr) local(d, l) (
  d = -rr + ps(2);
  while (d < rr) (
    l = sqrt(max(0, rr * rr - d * d));
    gfx_line(x + d * 0.7071 + l * 0.7071, y + d * 0.7071 - l * 0.7071, x + d * 0.7071 - l * 0.7071, y + d * 0.7071 + l * 0.7071, 1);
    d += ps(4);
  );
);

// Comix dial: soft shadow below-right, flat cap, inked outline, pointer bar.
// Style from globals set by each module: k_ink (outline), k_ptr (pointer),
// k_hatch / k_shine (1 = hatched cap with a faint shine, as on the main D dials),
// scale_col / label_col. Set klog = 1 before a call for a log-taper knob.
// fmt: 0 dB, 1 %, 3 Hz, 4 Q, >=1000 enum (hover strings at fmt-1000).
// sb >= 0: printed labels from string slots; sb < 0: numeric; nl = label count.
function knob(cx, cy, r, idx, vmin, vmax, step, def, cap, lbl, fmt, sb, nl)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, n, w, h, ty, lr, fr, lg, hw)
(
  lg = klog;  klog = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = slider(idx);
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps(220)));
    v = lg ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    step > 0 ? ( v = vmin + floor((v - vmin) / step + 0.5) * step; );
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = slider(idx);
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);

  // scale dots and printed labels
  col(scale_col, 0.9);
  n = step > 0 ? floor((vmax - vmin) / step + 0.5) : 10;
  n > 24 ? n = 10;
  j = 0;
  loop(n + 1,
    b = a0 + (j / n) * (a1 - a0);
    gfx_circle(x + sin(b) * (rr + ps(6)), y - cos(b) * (rr + ps(6)), ps(1.3), 1, 1);
    j += 1;
  );
  gfx_setfont(5);  lr = rr + ps(17);  j = 0;
  loop(nl,
    fr = nl > 1 ? j / (nl - 1) : 0.5;
    b = a0 + fr * (a1 - a0);
    sb >= 0 ? ( text_c(x + sin(b) * lr, y - cos(b) * lr, sb + j); ) : (
      sprintf(#sl, "%d", floor(vmin + fr * (vmax - vmin) + 0.5));
      text_c(x + sin(b) * lr, y - cos(b) * lr, #sl);
    );
    j += 1;
  );
  // dial
  col(0x000000, 0.28);  gfx_circle(x + ps(2.5), y + ps(3), rr, 1, 1);      // subtle shadow below and right
  col(cap, 1);          gfx_circle(x, y, rr, 1, 1);
  k_hatch ? ( col(k_ink, 0.3);  hatch_disc(x, y, rr); );
  k_shine ? ( col(label_col, 0.45);  gfx_circle(x - rr * 0.34, y - rr * 0.38, rr * 0.13, 1, 1);
                                     gfx_circle(x - rr * 0.24, y - rr * 0.46, rr * 0.09, 1, 1); );
  col(k_ink, 1);  j = 0;
  loop(3, gfx_circle(x, y, rr - j * ps(0.8), 0, 1);  j += 1; );
  hw = ps(r > 30 ? 2.1 : 1.6);
  col(k_ptr, 1);
  pointer(x, y, sin(tv), cos(tv), rr * 0.12, rr * 0.84, hw);
  gfx_circle(x + sin(tv) * rr * 0.84, y - cos(tv) * rr * 0.84, hw, 1, 1);
  // label
  gfx_setfont(6);  col(label_col, 1);  text_c(x, y + rr + ps(25), lbl);
  // value on hover only (house rule)
  hov || drag_idx == idx ? (
    fmt == 0 ? sprintf(#kv, "%+.1f dB", v) :
    fmt == 1 ? sprintf(#kv, "%d%%", v) :
    fmt == 2 ? sprintf(#kv, "%.1f", v) :
    fmt == 3 ? ( v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
    fmt == 4 ? sprintf(#kv, "Q %.2f", v) :
               sprintf(#kv, "%s", fmt - 1000 + floor((v - vmin) / step + 0.5));
    gfx_setfont(3);  gfx_measurestr(#kv, w, h);
    ty = y - lr - ps(12) - h;
    col(0x14130E, 0.95);  gfx_rect(x - w * 0.5 - ps(6), ty - ps(3), w + ps(12), h + ps(6), 1);
    col(0xD6C79C, 1);     text_c(x, ty + h * 0.5, #kv);
  );
);

// Comix key: greyed out when off; lit in its colour with a soft glow when on. Returns 1 on click.
function ckey(x, y, w, h, on, c, str) local(xa, ya, wa, ha, hov, dn, lum) (
  xa = px(x);  ya = py(y);  wa = ps(w);  ha = ps(h);
  hov = mouse_x >= xa && mouse_x <= xa + wa && mouse_y >= ya && mouse_y <= ya + ha;
  dn = hov && lmb ? ps(1) : 0;
  on ? (
    col(c, 0.10);  ui_rrs(xa - ps(10), ya - ps(10), wa + ps(20), ha + ps(20), ps(9));
    col(c, 0.18);  ui_rrs(xa - ps(6),  ya - ps(6),  wa + ps(12), ha + ps(12), ps(7));
    col(c, 0.30);  ui_rrs(xa - ps(3),  ya - ps(3),  wa + ps(6),  ha + ps(6),  ps(5));
  );
  col(0x000000, 0.35);  ui_rrs(xa + ps(2.5), ya + ps(3), wa, ha, ps(4));
  on ? col(c, 1) : col(0x6E6A5E, 1);
  ui_rrs(xa + dn, ya + dn, wa, ha, ps(4));
  on ? ( col(0xFFFFFF, 0.25);  gfx_rect(xa + dn + ps(4), ya + dn + ps(3), wa - ps(8), ps(2), 1); );
  col(0x14130E, 1);  rr_line(xa + dn, ya + dn, wa, ha, ps(4), ps(1.6));
  gfx_setfont(2);
  lum = 0.3 * floor(c / 65536) + 0.59 * (floor(c / 256) % 256) + 0.11 * (c % 256);
  on ? ( lum > 110 ? col(0x14130E, 1) : col(0xEFE3C0, 1); ) : col(0x2E2B24, 1);
  text_c(xa + wa * 0.5 + dn, ya + ha * 0.5 + dn, str);
  click && hov;
);

// Name plate set into the panel: a recess with its shadow on the top / left inside
// edge and the panel's light catching the bottom / right lip; engraved lettering.
function name_plate(cx, y, str, pc, tc) local(w, h, xa, ya, wa, ha, fc) (
  gfx_setfont(4);  gfx_measurestr(str, w, h);
  wa = w + ps(26);  ha = h + ps(8);  xa = px(cx) - wa * 0.5;  ya = py(y) - ha * 0.5;
  fc = shade(pc, 0.8);
  col(0xFFFFFF, 0.14);  ui_rrs(xa - ps(2), ya - ps(2), wa + ps(4), ha + ps(4), ps(3));   // lip, lit bottom / right
  col(0x000000, 0.55);  ui_rrs(xa - ps(2), ya - ps(2), wa + ps(2.5), ha + ps(2.5), ps(3));
  col(fc, 1);           ui_rrs(xa, ya, wa, ha, ps(2));
  col(0x000000, 0.32);  gfx_rect(xa + ps(1), ya, wa - ps(2), ps(3), 1);  gfx_rect(xa, ya + ps(1), ps(2.5), ha - ps(2), 1);
  col(0x000000, 0.45);  text_c(px(cx) - ps(1), py(y) - ps(1), str);                        // engraved: dark upper edge
  col(tc, 1);           text_c(px(cx), py(y), str);
);

// Module panel: flat colour, hatched right + bottom edges, wobbly inked outline
function cplate(x0, w, c, ink, hc, ha, th, seed) local(xa, ya, wa, hh) (
  xa = px(x0);  ya = py(40);  wa = ps(w);  hh = ps(560);
  col(0x000000, 0.45);  ui_rrs(xa + ps(3), ya + ps(3), wa, hh, ps(8));
  col(c, 1);            ui_rrs(xa, ya, wa, hh, ps(8));
  col(hc, ha);
  hatch_v(xa + wa - ps(12), ya + ps(10), ps(11), hh - ps(22));
  hatch_h(xa + ps(10), ya + hh - ps(12), wa - ps(22), ps(11));
  col(ink, 1);  rr_line(xa, ya, wa, hh, ps(8), ps(th * 0.8));
);

// A / B rocker (illuminated, as a mains rocker): click a half to pick that unit.
// The chosen half is pressed in with the lamp glowing behind its legend; the other
// half stands proud. Model names either side, the chosen one bright.
function rocker(cx, y, idx, la, lb, lc) local(xa, ya, wa, ha, sel, hl, hr, fx, fy, fw, fh, hw, k, w, h, px0, rx0) (
  wa = ps(58);  ha = ps(32);  xa = px(cx) - wa * 0.5;  ya = py(y);
  hl = inr(xa, ya, wa * 0.5, ha);  hr = inr(xa + wa * 0.5, ya, wa * 0.5, ha);
  sel = slider(idx) >= 0.5;
  click && hl && sel ? ( slider(idx) = 0;  param_touched(idx);  sel = 0; );
  click && hr && !sel ? ( slider(idx) = 1;  param_touched(idx);  sel = 1; );
  // lit lens glow
  col(0xFF3A1E, 0.08);  ui_rrs(xa - ps(8), ya - ps(8), wa + ps(16), ha + ps(16), ps(10));
  col(0xFF3A1E, 0.14);  ui_rrs(xa - ps(4), ya - ps(4), wa + ps(8), ha + ps(8), ps(7));
  // black bezel
  col(0x000000, 0.4);   ui_rrs(xa + ps(2.5), ya + ps(3), wa, ha, ps(4));
  col(0x16140F, 1);     ui_rrs(xa, ya, wa, ha, ps(4));
  col(0x45413A, 1);     gfx_rect(xa + ps(4), ya + ps(1), wa - ps(8), max(1, ps(1)), 1);
  fx = xa + ps(5);  fy = ya + ps(5);  fw = wa - ps(10);  fh = ha - ps(10);  hw = fw * 0.5;
  px0 = sel ? fx + hw : fx;  rx0 = sel ? fx : fx + hw;          // pressed half, raised half
  // raised half: brighter, light catching its top edge
  col(0xC42A1E, 1);  gfx_rect(rx0, fy, hw, fh, 1);
  col(0xF06048, 1);  gfx_rect(rx0, fy, hw, max(1, ps(2)), 1);
  col(0x7A140E, 1);  gfx_rect(rx0, fy + fh - max(1, ps(2)), hw, max(1, ps(2)), 1);
  // pressed half: sunk, shadow from the raised half at the pivot, lamp hot spot
  col(0xA81E14, 1);  gfx_rect(px0, fy, hw, fh, 1);
  col(0x000000, 0.35);  gfx_rect(px0, fy, hw, max(1, ps(2)), 1);
  col(0x000000, 0.45);  gfx_rect(sel ? px0 : px0 + hw - ps(3), fy, ps(3), fh, 1);
  k = 0;
  loop(3,
    col(k == 0 ? 0xFF7A3A : k == 1 ? 0xFFA45A : 0xFFD890, 0.35);
    gfx_circle(px0 + hw * 0.5, fy + fh * 0.5, min(hw, fh) * (0.40 - k * 0.11), 1, 1);
    k += 1;
  );
  // legends
  gfx_setfont(2);
  col(0xFFF0E0, sel ? 0.55 : 1);  text_c(fx + hw * 0.5, fy + fh * 0.5, "A");
  col(0xFFF0E0, sel ? 1 : 0.55);  text_c(fx + hw * 1.5, fy + fh * 0.5, "B");
  // model names
  gfx_setfont(5);
  gfx_measurestr(la, w, h);  col(lc, sel ? 0.45 : 1);  gfx_x = xa - ps(7) - w;  gfx_y = ya + ha * 0.5 - h * 0.5;  gfx_drawstr(la);
  col(lc, sel ? 1 : 0.45);   gfx_x = xa + wa + ps(7);    gfx_drawstr(lb);
);

// small paper tag (band names on the EQ)
// band tags take the house band colour: LF brown, LMF blue, HMF green, HF red
B_LF = 0x8A5A3A;  B_LMF = 0x3E6E9E;  B_HMF = 0x3F8A5A;  B_HF = 0xB5443A;
function plaque(cx, y, str, bc) local(w, h) (
  gfx_setfont(5);  gfx_measurestr(str, w, h);
  col(0x000000, 0.35);  ui_rrs(px(cx) - w * 0.5 - ps(6) + ps(2), py(y) + ps(2), w + ps(12), h + ps(3), ps(2));
  col(bc, 1);           ui_rrs(px(cx) - w * 0.5 - ps(6), py(y), w + ps(12), h + ps(3), ps(2));
  col(0xF2E6C4, 1);     text_c(px(cx), py(y) + h * 0.5 + ps(1.5), str);
);

// a lamp with a glow when lit
function glamp(x, y, r, on, c) (
  on ? ( col(c, 0.25);  gfx_circle(px(x), py(y), ps(r * 2), 1, 1);  col(c, 0.4);  gfx_circle(px(x), py(y), ps(r * 1.45), 1, 1); );
  col(0x14130E, 1);  gfx_circle(px(x), py(y), ps(r + 2), 1, 1);
  on ? col(c, 1) : col(0x4A4838, 1);
  gfx_circle(px(x), py(y), ps(r), 1, 1);
);

// blank filler plate (a single-wide model in a double slot)
function blank(x0) ( cplate(x0, 150, 0x3B3A2C, 0x14130E, 0x14130E, 1, 2.6, x0);  screw(x0 + 75, 56);  screw(x0 + 75, 584); );

// LED meter column, -48..+3 dB (olive / mustard / rust)
function ledcol(x, y0, h, db) local(n, sh, j, d, yy) (
  n = 34;  sh = h / n;
  col(0x14130E, 1);  gfx_rect(px(x - 2), py(y0 - 2), ps(16), ps(h + 4), 1);
  j = 0;
  loop(n,
    d = -48 + (j + 1) * 1.5;  yy = y0 + h - (j + 1) * sh;
    d > 0 ? col(0xC8642E, db >= d - 1.5 ? 1 : 0.14) :
    d > -6 ? col(0xD8A84A, db >= d - 1.5 ? 1 : 0.14) :
             col(0x9AAA52, db >= d - 1.5 ? 1 : 0.14);
    gfx_rect(px(x), py(yy) + 1, ps(12), ps(sh) - 1, 1);
    j += 1;
  );
);

// the two dial styles shared across modules
function dial_main(ink) ( k_ink = ink;  k_ptr = 0x14130E;  k_hatch = 1;  k_shine = 0; );   // D: rust cap, hatched
function dial_out(ink, ptr) ( k_ink = ink;  k_ptr = ptr;  k_hatch = 0;  k_shine = 0; );   // A: plain dark cap, cream pointer

// ---------- AR-70 (single-wide, PRE A) — D: grubby olive, rust, stained cream ----------
function draw_ar(x0) local(cx, c, sig) (
  cx = x0 + 75;  c = 0x3B3A2C;
  cplate(x0, 150, c, 0x14130E, 0x14130E, 1, 2.6, 1.1);  screw(cx, 56);
  name_plate(cx, 92, "AR-70", 0x4A4936, 0xC9B98A);
  scale_col = 0xC9B98A;  label_col = 0xC9B98A;
  dial_main(0x14130E);
  knob(cx, 196, 40, 6, -24, 24, 6, 0, 0x8A4A2A, "INPUT LEVEL", 0, -1, 9);
  // SIG lamp: olive with signal, lit rust near the stage's limit
  sig = arpk_m > 0.55 ? 2 : gdb(max(inL_m, inR_m)) + ar_gain > -50;
  glamp(cx, 300, 6, sig > 0, sig == 2 ? 0xE0602E : 0xA8BA5A);
  gfx_setfont(5);  col(0xC9B98A, 1);  text_c(px(cx), py(322), "SIG");
  dial_out(0x14130E, 0xD6C79C);
  knob(cx, 404, 26, 7, -20, 10, 0.5, 0, 0x3E3A2E, "OUTPUT", 0, -1, 3);
  !pre_on ? ( col(c, 0.5);  gfx_rect(px(x0 + 3), py(112), ps(132), ps(372), 1); );
  ckey(cx - 29, 492, 58, 28, pre_on, 0xE0802E, "IN") ? ( slider(5) = pre_on ? 0 : 1;  param_touched(5); );
  rocker(cx, 532, 2, "AR-70", "SX-6", 0xC9B98A);
  screw(cx, 586);
);

// ---------- SX-6 (single-wide, PRE B) — smoky charcoal, oxblood gain, mustard VHD ----------
function draw_sx(x0) local(cx, c, sig) (
  cx = x0 + 75;  c = 0x2E302C;
  cplate(x0, 150, c, 0x0E0F0D, 0x0E0F0D, 1, 2.6, 1.7);  screw(cx, 56);
  name_plate(cx, 92, "SX-6", 0x3E413B, 0xD6CDB0);
  scale_col = 0xD6CDB0;  label_col = 0xD6CDB0;
  dial_main(0x0E0F0D);  k_ptr = 0xE6D6A4;          // cream pointer on the dark oxblood cap
  knob(cx, 192, 36, 33, -6, 30, 0.5, 0, 0x6E2A1F, "GAIN", 0, -1, 4);
  dial_out(0x0E0F0D, 0x14130E);
  knob(cx - 30, 300, 17, 34, 0, 100, 1, 30, 0xB08A3A, "DRV", 1, -1, 0);
  ckey(cx + 8, 282, 50, 24, sx_hpf, 0xE6D6A4, "HPF") ? ( slider(35) = sx_hpf ? 0 : 1;  param_touched(35); );
  sig = arpk_m > 0.55 ? 2 : gdb(max(inL_m, inR_m)) + sx_gain > -50;
  glamp(cx + 33, 326, 5, sig > 0, sig == 2 ? 0xE0602E : 0xA8BA5A);
  gfx_setfont(5);  col(0xD6CDB0, 1);  text_c(px(cx + 33), py(342), "SIG");
  dial_out(0x0E0F0D, 0xD6C79C);
  knob(cx, 420, 24, 36, -20, 10, 0.5, 0, 0x3E3A2E, "OUTPUT", 0, -1, 3);
  !pre_on ? ( col(c, 0.5);  gfx_rect(px(x0 + 3), py(112), ps(132), ps(372), 1); );
  ckey(cx - 29, 492, 58, 28, pre_on, 0xE0802E, "IN") ? ( slider(5) = pre_on ? 0 : 1;  param_touched(5); );
  rocker(cx, 532, 2, "AR-70", "SX-6", 0xD6CDB0);
  screw(cx, 586);
);

// Slot widths: the EQs get the extra room (four bands of controls), the compressors less.
EQ_W = 350;  CMP_W = 262;

// ---------- VX-4 (double-wide, EQ A) — B: head-shop ink, cream linework, mustard ----------
function draw_vx(x0) local(cx, c, c1, c2, c3, c4, w) (
  w = EQ_W;  cx = x0 + w * 0.5;  c = 0x2B2420;
  c1 = x0 + 58;  c2 = x0 + 138;  c3 = x0 + 212;  c4 = x0 + 292;
  cplate(x0, w, c, 0xD9CBA3, 0xD9CBA3, 0.35, 1.8, 2.2);  screw(x0 + 24, 56);  screw(x0 + w - 24, 56);
  scale_col = 0xD9CBA3;  label_col = 0xD9CBA3;
  plaque((c1 + c2) * 0.5, 70, "LF", B_LF);  plaque((c3 + c4) * 0.5, 70, "HF", B_HF);
  dial_out(0xD9CBA3, 0xD9CBA3);
  knob(c1, 125, 18, 10, 0, 3, 1, 1, B_LF, "FREQ",  1100, 200, 4);
  knob(c2, 125, 18, 11, -9, 9, 0.5, 0, B_LF, "GAIN", 0, -1, 3);
  knob(c3, 125, 18, 13, -9, 9, 0.5, 0, B_HF, "GAIN", 0, -1, 3);
  knob(c4, 125, 18, 12, 0, 3, 1, 1, B_HF, "FREQ",  1110, 210, 4);
  // centre band: name plate with a mustard lamp
  col(0xD9CBA3, 0.35);  gfx_line(px(x0 + 20), py(194), px(x0 + w - 20), py(194), 1);
  glamp(cx - 62, 212, 4, eq_on, 0xD8A84A);
  name_plate(cx + 8, 212, "VX-4", 0x3A302A, 0xD9CBA3);
  col(0xD9CBA3, 0.35);  gfx_line(px(x0 + 20), py(230), px(x0 + w - 20), py(230), 1);
  plaque((c1 + c2) * 0.5, 272, "LMF", B_LMF);  plaque((c3 + c4) * 0.5, 272, "HMF", B_HMF);
  klog = 1;  knob(c1, 327, 18, 14, 100, 1100, 0, 400,  B_LMF, "FREQ", 3, 270, 3);
  knob(c2, 327, 18, 16, -9, 9, 0.5, 0, B_LMF, "GAIN", 0, -1, 3);
  knob(c3, 327, 18, 20, -9, 9, 0.5, 0, B_HMF, "GAIN", 0, -1, 3);
  klog = 1;  knob(c4, 327, 18, 18, 600, 9000, 0, 2500, B_HMF, "FREQ", 3, 280, 3);
  knob(c1, 417, 15, 15, 0.5, 3, 0, 1, B_LMF, "Q", 4, -1, 0);
  ckey(c2 - 29, 403, 58, 26, lmf_fc, 0xD8A84A, "FOCUS") ? ( slider(17) = lmf_fc ? 0 : 1;  param_touched(17); );
  ckey(c3 - 29, 403, 58, 26, hmf_fc, 0xD8A84A, "FOCUS") ? ( slider(21) = hmf_fc ? 0 : 1;  param_touched(21); );
  knob(c4, 417, 15, 19, 0.5, 3, 0, 1, B_HMF, "Q", 4, -1, 0);
  dial_out(0xD9CBA3, 0xD9CBA3);
  !eq_on ? ( col(c, 0.5);  gfx_rect(px(x0 + 3), py(62), ps(w - 18), ps(422), 1); );
  ckey(cx - 29, 492, 58, 28, eq_on, 0xE0B04A, "IN") ? ( slider(9) = eq_on ? 0 : 1;  param_touched(9); );
  rocker(cx, 532, 3, "VX-4", "MT-7", 0xD9CBA3);
  screw(x0 + 24, 586);  screw(x0 + w - 24, 586);
);

// ---------- MT-7 (double-wide, EQ B) — dusty slate, cream ink; boost left, CPS / KCS centre, atten right ----------
function draw_mt(x0) local(cx, c, c1, c4, w, bx, ax, tw, th) (
  w = EQ_W;  cx = x0 + w * 0.5;  c = 0x3A4246;
  c1 = x0 + 74;  c4 = x0 + w - 74;
  cplate(x0, w, c, 0xD9CBA3, 0xD9CBA3, 0.3, 1.8, 2.9);  screw(x0 + 24, 56);  screw(x0 + w - 24, 56);
  scale_col = 0xD9CBA3;  label_col = 0xD9CBA3;
  plaque(cx, 64, "LOW FREQUENCY", B_LF);
  dial_out(0xD9CBA3, 0xD9CBA3);
  knob(c1, 135, 22, 38, 0, 10, 0.1, 0, B_LF, "BOOST", 2, -1, 6);
  knob(cx, 135, 19, 37, 0, 3, 1, 1, shade(B_LF, 0.7), "CPS", 1300, 310, 4);
  knob(c4, 135, 22, 39, 0, 10, 0.1, 0, B_LF, "ATTEN", 2, -1, 6);
  // centre band: name plate with a tube-amber lamp
  col(0xD9CBA3, 0.35);  gfx_line(px(x0 + 20), py(194), px(x0 + w - 20), py(194), 1);
  glamp(cx - 62, 212, 4, eq_on, 0xE8903A);
  name_plate(cx + 8, 212, "MT-7", 0x485256, 0xD9CBA3);
  col(0xD9CBA3, 0.35);  gfx_line(px(x0 + 20), py(230), px(x0 + w - 20), py(230), 1);
  plaque(cx, 240, "HIGH FREQUENCY", B_HF);
  knob(c1, 305, 22, 42, 0, 10, 0.1, 0, B_HF, "BOOST", 2, -1, 6);
  knob(cx, 305, 19, 40, 0, 6, 1, 3, shade(B_HF, 0.7), "KCS", 1320, 330, 7);
  knob(c4, 305, 22, 44, 0, 10, 0.1, 0, B_HF, "ATTEN", 2, -1, 6);
  // bottom row: BANDWIDTH with SHARP / BROAD set out either side, ATTEN SEL mirrored
  bx = x0 + 112;  ax = x0 + w - 112;
  knob(bx, 425, 18, 41, 1, 10, 0.1, 5, B_HF, "BANDWIDTH", 2, -1, 0);
  gfx_setfont(5);  col(0xD9CBA3, 0.85);
  gfx_measurestr("SHARP", tw, th);  gfx_x = px(bx - 30) - tw;  gfx_y = py(440) - th * 0.5;  gfx_drawstr("SHARP");
  gfx_x = px(bx + 30);  gfx_drawstr("BROAD");
  knob(ax, 425, 18, 43, 0, 2, 1, 1, shade(B_HF, 0.7), "ATTEN SEL", 1340, 345, 3);
  !eq_on ? ( col(c, 0.5);  gfx_rect(px(x0 + 3), py(62), ps(w - 18), ps(422), 1); );
  ckey(cx - 29, 492, 58, 28, eq_on, 0xE0B04A, "IN") ? ( slider(9) = eq_on ? 0 : 1;  param_touched(9); );
  rocker(cx, 532, 3, "VX-4", "MT-7", 0xD9CBA3);
  screw(x0 + 24, 586);  screw(x0 + w - 24, 586);
);

// gain-reduction needle meter, 0..20 dB (shared by both compressors), centred on cx
function gr_meter(cx, fr, face, ink, ndl) local(mx0, mx, my, mr, j, b, a) (
  mx0 = cx - 107;
  col(0x000000, 0.35);  gfx_rect(px(mx0 + 3), py(91), ps(214), ps(108), 1);
  col(fr, 1);    gfx_rect(px(mx0), py(88), ps(214), ps(108), 1);
  col(face, 1);  gfx_rect(px(mx0 + 6), py(94), ps(202), ps(96), 1);
  mx = px(cx);  my = py(232);  mr = ps(118);
  gfx_setfont(5);  j = 0;
  loop(6,
    b = -0.62 + j * 0.248;
    col(ink, 1);
    gfx_line(mx + sin(b) * (mr - ps(8)), my - cos(b) * (mr - ps(8)), mx + sin(b) * (mr - ps(2)), my - cos(b) * (mr - ps(2)), 1);
    sprintf(#sl, "%d", j * 4);  text_c(mx + sin(b) * (mr - ps(18)), my - cos(b) * (mr - ps(18)), #sl);
    j += 1;
  );
  text_c(mx, py(166), "dB  COMPRESSION");
  a = -0.62 + 1.24 * min(1, gr_m / 20);
  col(ndl, 1);
  pointer(mx, my, sin(a), cos(a), ps(64), mr - ps(2), ps(0.8));
  col(fr, 1);  gfx_rect(px(mx0), py(190), ps(214), ps(6), 1);
);

// ---------- GB-2 (double-wide, COMP A) — A colours: yellowed paper, oxblood, brown-black ink ----------
function draw_gb(x0) local(cx, c, kl, kr, w) (
  w = CMP_W;  cx = x0 + w * 0.5;  c = 0xD6C79C;  kl = cx - 53;  kr = cx + 53;
  cplate(x0, w, c, 0x2A2018, 0x2A2018, 0.8, 2.2, 3.3);  screw(x0 + 22, 56);  screw(x0 + w - 22, 56);
  name_plate(cx, 58, "GB-2", 0xE6D9B2, 0x2A2018);
  col(0x2A2018, 0.45);  gfx_rect(px(x0 + 14), py(80), ps(w - 30), ps(1), 1);  gfx_rect(px(x0 + 14), py(80), ps(1), ps(405), 1);
  gfx_rect(px(x0 + 14), py(485), ps(w - 30), ps(1), 1);  gfx_rect(px(x0 + w - 16), py(80), ps(1), ps(405), 1);
  gr_meter(cx, 0x2A2018, 0x1E1812, 0xD6C79C, 0xE6D9B2);
  scale_col = 0x2A2018;  label_col = 0x2A2018;
  dial_out(0x2A2018, 0xD6C79C);
  knob(kl, 250, 20, 25, -30, 0, 0.5, -10, 0x6E2A1F, "THRESHOLD", 0, -1, 3);
  knob(kr, 250, 20, 26, 0, 20, 0.5, 0, 0x3E3A2E, "MAKE UP", 0, -1, 3);
  knob(kl, 340, 20, 27, 0, 5, 1, 2, 0x3E3A2E, "ATTACK", 1130, 230, 6);
  knob(kr, 340, 20, 28, 0, 4, 1, 1, 0x3E3A2E, "RELEASE", 1140, 240, 5);
  knob(kl, 430, 20, 29, 0, 3, 1, 1, 0x3E3A2E, "RATIO", 1150, 250, 4);
  dial_out(0x2A2018, 0x2A2018);
  knob(kr, 430, 20, 30, 0, 5, 1, 0, 0xB08A3A, "SC HPF", 1160, 260, 6);
  !comp_on ? ( col(c, 0.5);  gfx_rect(px(x0 + 3), py(206), ps(w - 18), ps(278), 1); );
  ckey(cx - 29, 492, 58, 28, comp_on, 0xC8402E, "IN") ? ( slider(24) = comp_on ? 0 : 1;  param_touched(24); );
  rocker(cx, 532, 4, "GB-2", "VM-67", 0x2A2018);
  screw(x0 + 22, 586);  screw(x0 + w - 22, 586);
);

// ---------- VM-67 (double-wide, COMP B) — stained gunmetal, cream-faced meter, rust input ----------
function draw_vm(x0) local(cx, c, kl, kr, w) (
  w = CMP_W;  cx = x0 + w * 0.5;  c = 0x45443C;  kl = cx - 53;  kr = cx + 53;
  cplate(x0, w, c, 0x14130E, 0xD6C79C, 0.22, 2.2, 3.9);  screw(x0 + 22, 56);  screw(x0 + w - 22, 56);
  name_plate(cx, 58, "VM-67", 0x55544A, 0xD6C79C);
  gr_meter(cx, 0x14130E, 0xD6C79C, 0x2A2018, 0x14130E);
  scale_col = 0xD6C79C;  label_col = 0xD6C79C;
  dial_main(0x14130E);
  knob(kl, 275, 22, 45, 0, 20, 0.5, 0, 0x8A4A2A, "INPUT", 0, -1, 3);
  dial_out(0x14130E, 0xD6C79C);
  knob(kr, 275, 22, 46, 0, 10, 0.1, 5, 0x3E3A2E, "THRESHOLD", 2, -1, 6);
  knob(kl, 410, 22, 47, 0, 5, 1, 1, 0x3E3A2E, "TIME CONST", 1350, 360, 6);
  knob(kr, 410, 22, 48, -20, 10, 0.5, 0, 0x3E3A2E, "OUTPUT", 0, -1, 3);
  !comp_on ? ( col(c, 0.5);  gfx_rect(px(x0 + 3), py(206), ps(w - 18), ps(278), 1); );
  ckey(cx - 29, 492, 58, 28, comp_on, 0xC8402E, "IN") ? ( slider(24) = comp_on ? 0 : 1;  param_touched(24); );
  rocker(cx, 532, 4, "GB-2", "VM-67", 0xD6C79C);
  screw(x0 + 22, 586);  screw(x0 + w - 22, 586);
);

// ---------- OUTPUT (single-wide) — D; house output stage SAT + CLIP lamp ----------
function draw_out(x0) local(cx, c) (
  cx = x0 + 75;  c = 0x3B3A2C;
  cplate(x0, 150, c, 0x14130E, 0x14130E, 1, 2.6, 4.4);  screw(cx, 56);
  name_plate(cx, 92, "WIDELOAD", 0x4A4936, 0xC9B98A);
  gfx_setfont(5);  col(0xC9B98A, 0.8);  text_c(px(cx), py(118), "GFX");
  ledcol(cx - 30, 134, 184, gdb(max(inL_m, inR_m)));
  ledcol(cx - 6,  134, 184, gdb(outL_m));
  ledcol(cx + 18, 134, 184, gdb(outR_m));
  glamp(cx + 48, 142, 4, clip_hold > 0, 0xE0402E);
  gfx_setfont(5);  col(0xC9B98A, 1);  text_c(px(cx + 48), py(158), "CLIP");
  text_c(px(cx - 24), py(330), "IN");  text_c(px(cx + 12), py(330), "OUT");
  scale_col = 0xC9B98A;  label_col = 0xC9B98A;
  dial_out(0x14130E, 0xD6C79C);
  knob(cx, 392, 24, 31, -12, 12, 0.5, 0, 0x3E3A2E, "OUTPUT", 0, -1, 3);
  knob(cx - 32, 468, 14, 8, 0, 100, 1, 0, 0x8A4A2A, "SAT", 1, -1, 0);
  knob(cx + 32, 468, 14, 32, 0, 100, 1, 0, 0x3E3A2E, "DRIFT", 1, -1, 0);
  ckey(cx - 38, 518, 76, 26, order, 0xB4C460, "ORDER") ? ( slider(1) = order ? 0 : 1;  param_touched(1); );
  gfx_setfont(5);  col(0xC9B98A, 1);  text_c(px(cx), py(564), order ? "COMP > EQ" : "EQ > COMP");
  screw(cx, 586);
);

// ---------- fonts: Cooper Black (70s comix lettering) with fallbacks ----------
function font_ok(name, flags) local(w0, h0, w1, h1) (
  gfx_setfont(9, "GFX-no-such-font", 20, flags);  gfx_measurestr("WIDELOAD 0123", w0, h0);
  gfx_setfont(9, name, 20, flags);                gfx_measurestr("WIDELOAD 0123", w1, h1);
  abs(w1 - w0) > 0.5;
);
function pick_fonts() (
  font_ok("Cooper Black", 0)     ? ( strcpy(#fc, "Cooper Black");     fc_fl = 0; ) :
  font_ok("Cooper Std Black", 0) ? ( strcpy(#fc, "Cooper Std Black"); fc_fl = 0; ) :
  font_ok("Arial Black", 0)      ? ( strcpy(#fc, "Arial Black");      fc_fl = 0; ) :
                                   ( strcpy(#fc, "Verdana");          fc_fl = 'b'; );
  fonts_picked = 1;
);

// ---------- house preset bar (ported from gfx-panel pk_preset): [PRESETS][<][>][LCD] ----------
// PRESETS, or a click on the LCD, opens the list; the arrows step through it. menu = "Name 1|...|Name n".
// The list ends with "Reset all to defaults" (returns n + 1). Returns the preset to load, 0 for none.
// Keys are this unit's lamp keys (PB_KEY lens, PB_INK arrows); the LCD is the house amber one.
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, tw, th, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  ckey(x, y + 2, 100, h - 4, 0, PB_KEY, "PRESETS") ? open = 1;
  ckey(x + 108, y + 2, 40, h - 4, 0, PB_KEY, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  ckey(x + 154, y + 2, 40, h - 4, 0, PB_KEY, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(PB_INK, 1);  pb_tri(x + 128, y + h * 0.5, 5, -1);  pb_tri(x + 174, y + h * 0.5, 5, 1);
  // the LCD: black bezel, dark amber glass, the patch name only
  lx = x + 206;
  col(0x000000, 0.3);  gfx_rect(px(lx + 2), py(y + 5), ps(lw), ps(h - 6), 1);
  col(0x050505, 1);    gfx_rect(px(lx), py(y + 3), ps(lw), ps(h - 6), 1);
  gfx_gradrect(px(lx + 3), py(y + 6), ps(lw - 6), ps(h - 12), 0.17, 0.10, 0.02, 1, 0, 0, 0, 0, -0.06 / ps(h), -0.04 / ps(h), -0.01 / ps(h), 0);
  col(0xFFFFFF, 0.06); gfx_line(px(lx + 4), py(y + 7), px(lx + lw - 5), py(y + 7), 1);
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  gfx_setfont(8);  col(0xE8A33A, 1);  gfx_measurestr(#pb_nm, tw, th);
  gfx_x = px(lx + 10);  gfx_y = py(y + h * 0.5) - th * 0.5;  gfx_drawstr(#pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- presets (OUTPUT evens the loudness; GUI thread only) ----------
PRESET_MENU = "Init|Vocal: Vintage Chain|Vocal: Silky Tube|Vocal: Up Front|Drums: Bus Slam|Drums: Vari-Mu Room|Bass: Iron and Glue|Bass: Low Trick|Guitar: Crunchy Pre|Mix Bus: Glue|Mix Bus: Tube Polish|Colour: All B, Hot";
PB_KEY = 0xD8A84A;  PB_INK = 0x2E2B24;

// ---------- frame setup ----------
sc = min(gfx_w / 1000, gfx_h / 684);
ox = (gfx_w - 1000 * sc) * 0.5;
oy = (gfx_h - 684 * sc) * 0.5 + 44 * sc;   // y 0 = the old top edge; the preset bar sits above it
lmb = mouse_cap & 1;
click = lmb && !last_lmb;

!fonts_picked ? pick_fonts();
gfx_setfont(1, #fc, ps(18), fc_fl);
gfx_setfont(2, #fc, ps(12), fc_fl);
gfx_setfont(3, "Verdana", ps(12), 'b');
gfx_setfont(4, #fc, ps(19), fc_fl);
gfx_setfont(5, #fc, ps(11), fc_fl);
gfx_setfont(6, #fc, ps(12), fc_fl);
gfx_setfont(8, "Courier New", ps(17), 'b');

inL_m  = max(inL_d,  inL_m * 0.85);   inL_d = 0;   inR_m  = max(inR_d,  inR_m * 0.85);   inR_d = 0;
outL_m = max(outL_d, outL_m * 0.85);  outL_d = 0;  outR_m = max(outR_d, outR_m * 0.85);  outR_d = 0;
gr_m   = max(gr_d, gr_m * 0.8);       gr_d = 0;
arpk_m = max(arpk_d, arpk_m * 0.9);   arpk_d = 0;
ost_clipped ? ( clip_hold = 8;  ost_clipped = 0; ) : clip_hold > 0 ? ( clip_hold -= 1; );   // CLIP lamp hold

// ---------- rack ----------
col(0x1C1916, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(0x000000, 0.45);  gfx_rect(px(22), py(22), ps(956), ps(596), 1);
col(0x100E0C, 1);     gfx_rect(px(24), py(24), ps(952), ps(592), 1);
col(0x2E2B22, 1);  gfx_rect(px(24), py(30), ps(952), ps(4), 1);  gfx_rect(px(24), py(606), ps(952), ps(4), 1);   // rails

// slots: PRE 35 | EQ (350) and COMP (262) in either order, 191..809 | OUT 815
pre_model >= 0.5 ? draw_sx(35) : draw_ar(35);
// EQ and COMP units are all double-wide, so ORDER swaps the two blocks.
order ? ( comp_model >= 0.5 ? draw_vm(191) : draw_gb(191);  eq_model >= 0.5 ? draw_mt(197 + CMP_W) : draw_vx(197 + CMP_W); )
      : ( eq_model >= 0.5 ? draw_mt(191) : draw_vx(191);  comp_model >= 0.5 ? draw_vm(197 + EQ_W) : draw_gb(197 + EQ_W); );
draw_out(815);

// ---------- preset bar, above the rack ----------
col(0x000000, 0.35);  gfx_rect(px(232), py(-38), ps(536), ps(36), 1);
col(0x3A352C, 0.8);   gfx_rect(px(232), py(-3), ps(536), ps(1), 1);
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(240, -35, 30, 320, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > 12 ? 1 : pb_k; );

// ---------- end of frame ----------
!lmb ? drag_idx = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // rebuilt in @block, never on the GUI thread
