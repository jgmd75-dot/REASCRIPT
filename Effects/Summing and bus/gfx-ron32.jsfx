@init
#ui_man = "gfx-ron32";
ext_noinit = 1;
os_design(); os_f = os_tf = os_f2n(slider47); os_base = 0; os_gsetup();   // OS: TONE's saturation only (1x = 0 latency)
by_setup(23);                                           // the BYPASS key (15 ms to the plain sum, in time with OS)
pwr_init();  pwr_wu_drv = 0;  pwr_wu_loss = 0.6;  pwr_wu_lp = 9000;  pwr_bloom = 0.1;   // mains + warm-up: no curve to drive

// ---------- memory (pair p = 0 .. RN_NP - 1, band b = 0..5, cell k = p * 6 + b) ----------
RN_NP = 16; RN_NK = RN_NP * 6; RN_NB = 6;
// the sliders of each pair: PLACE, MONO, MUTE, SOLO, NUDGE (pair p = base + p)
S_PL = 7; S_MO = 31; S_MU = 48; S_SO = 64; S_NU = 80; S_FR = 96;
M_BF = 20000;    // per band: centre (Hz)
M_DB0 = 20010;   //   band-pass b0, a1, a2
M_DA1 = 20020;
M_DA2 = 20030;
M_REF = 20040;   //   the reference tilt (power) a home band is judged against
M_KW = 20050;    //   K-weighting (power) for MATCH
M_MOT = 20100;   // per pair (32 each): MONO
M_PK = 20132;    //   peaks this block (64: L, R)
M_PKD = 20200;   //   peaks handed to the panel (64)
M_EF = 20264;    //   transient detector: fast / slow mean squares, attack strength
M_ES = 20296;
M_XT = 20328;
M_WR = 20360;    //   PLACE weight (FRONT 1, MID 0.6, BACK 0.3), PLACE
M_PL = 20392;
M_HOME = 20424;  //   home band
M_SHG = 20456;   //   BACK air shelf: gain (dB) now / target, its k
M_SKT = 20488;
M_SHT = 20520;
M_DGT = 20552;   //   BACK attack rounding: target gain
M_TQ = 20584;    //   the pairs hitting now
M_CP = 20616;    //   a copy of 1-2 (the COPY GUARD: left out of the listening)
M_MUG = 20648;   //   MUTE gain (before the listening), SOLO gain (after: the pair as it sits in the mix)
M_SOG = 20680;
M_DSH = 20712;   //   the ROOM MAP's home band (read by the panel)
M_NDT = 20744;   //   NUDGE: the pair's delay (samples)
M_KT = 21000;    // per cell (100 each): k target (gain - 1)
M_ACC = 21100;   //   this chunk's sum of squares
M_RS = 21200;    //   the 900 ms window's running sum
M_E = 21300;     //   mean square
M_REL = 21400;   //   level against the pair's strongest band (0 .. 1)
M_CUT = 21500;   //   UNMASK cut (dB): now, target
M_CUTT = 21600;
M_DK = 21700;    //   TRANSIENT dip (dB): now, target
M_DKT = 21800;
M_DSA = 21900;   //   the ROOM MAP (read by the panel): level, cut, dip per cell
M_DSC = 22000;
M_DSK = 22100;
M_GN = 22200;    //   the cut its k was last set to
M_EQ = 22300;    //   FAST: an 80 ms mean square, and the level the decisions hear (between it and the window)
M_EX = 22400;
M_DLY = 23000;   // DELTA, delayed by the OS latency (2 x 64)
M_RING = 1048576; RN_WMAX = 5400;                     // the 900 ms windows: a ring of chunk sums per cell (to 192 kHz)
M_NB = 2097152; RN_NL = 16384;                         // NUDGE: a delay line per pair (L, R: 2 x 16384, to 192 kHz)
RN_CN = 32;                                             // control rate: every 32 samples

M_BF[0] = 110; M_BF[1] = 330; M_BF[2] = 990; M_BF[3] = 2200; M_BF[4] = 5500; M_BF[5] = 11000;
// the tilt a home band is judged against (programme falls away in the top octaves)
M_KW[0] = 10 ^ (-0.1); M_KW[1] = 1; M_KW[2] = 1; M_KW[3] = 10 ^ 0.2; M_KW[4] = 10 ^ 0.4; M_KW[5] = 10 ^ 0.4;
M_REF[0] = 1; M_REF[1] = 1; M_REF[2] = 1; M_REF[3] = 10 ^ (-0.2); M_REF[4] = 10 ^ (-0.5); M_REF[5] = 10 ^ (-0.9);

// ---------- TONE's filters (RBJ, as SIFON's): 0 high-pass, 1 peak, 2 high shelf, 4 band-pass (0 dB peak) ----------
function rn_bqset(t, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w, cw, al, a, sa, n) (
  w = 2 * $pi * min(f, 0.45 * rn_bfs) / rn_bfs; cw = cos(w); al = sin(w) / (2 * q); a = 10 ^ (gdb / 40);
  t == 0 ? ( n = 1 + al; b0 = (1 + cw) / 2 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  t == 1 ? ( n = 1 + al / a; b0 = (1 + al * a) / n; b1 = -2 * cw / n; b2 = (1 - al * a) / n; a1 = b1; a2 = (1 - al / a) / n; ) :
  t == 2 ? ( sa = 2 * sqrt(a) * al; n = (a + 1) + (a - 1) * cw + sa;
    b0 = a * ((a + 1) - (a - 1) * cw + sa) / n; b1 = 2 * a * ((a - 1) - (a + 1) * cw) / n; b2 = a * ((a + 1) - (a - 1) * cw - sa) / n;
    a1 = -2 * ((a - 1) + (a + 1) * cw) / n; a2 = ((a + 1) + (a - 1) * cw - sa) / n; ) :
  ( n = 1 + al; b0 = al / n; b1 = 0; b2 = -b0; a1 = -2 * cw / n; a2 = (1 - al) / n; );
);
function rn_bqrun(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function rn_bqclr() instance(z1, z2) ( z1 = z2 = 0; );
function rn_op(x, g) instance(z) local(v, y) ( v = (x - z) * g; y = v + z; z = y + v; y; );   // one-pole low-pass

// ---------- the coefficients (per sample rate) ----------
function rn_coef() local(b, w, f, t, a0) (
  rn_sr = srate; rn_bfs = srate;
  b = 0; loop(RN_NB,
    f = min(M_BF[b], 0.42 * srate); w = 2 * $pi * f / srate;
    t = sin(w) / 2; a0 = 1 + t;                         // Q 1: about 1.4 octaves, the bands overlap gently
    M_DB0[b] = t / a0; M_DA1[b] = -2 * cos(w) / a0; M_DA2[b] = (1 - t) / a0;
    b += 1; );
  rn_b00 = M_DB0[0]; rn_a10 = M_DA1[0]; rn_a20 = M_DA2[0]; rn_b01 = M_DB0[1]; rn_a11 = M_DA1[1]; rn_a21 = M_DA2[1];
  rn_b02 = M_DB0[2]; rn_a12 = M_DA1[2]; rn_a22 = M_DA2[2]; rn_b03 = M_DB0[3]; rn_a13 = M_DA1[3]; rn_a23 = M_DA2[3];
  rn_b04 = M_DB0[4]; rn_a14 = M_DA1[4]; rn_a24 = M_DA2[4]; rn_b05 = M_DB0[5]; rn_a15 = M_DA1[5]; rn_a25 = M_DA2[5];
  rn_wl = max(1, min(RN_WMAX, floor(0.9 * srate / RN_CN + 0.5)));   // the 900 ms window, in chunks
  rn_dn = max(1, floor(0.005 * srate / RN_CN + 0.5));                // decisions every ~5 ms
  rn_kca = 1 - exp(-RN_CN / (0.03 * srate)); rn_kc0 = 1 - exp(-RN_CN / (0.15 * srate));   // cuts in 30 ms, out 150 ms
  rn_kc1 = 1 - exp(-RN_CN / (0.04 * srate)); rn_kfq = 1 - exp(-RN_CN / (0.08 * srate));  //   FAST: out 40 ms, an 80 ms ear
  rn_kfr = 1 - exp(-RN_CN / (0.015 * srate));                                           //   the FAST key glides 15 ms
  rn_nxk = 1 / (0.015 * srate); rn_ngk = 1 / (0.005 * srate);                           // NUDGE: 15 ms crossfade, 5 ms dip
  rn_kda = 1 - exp(-RN_CN / (0.003 * srate)); rn_kdr = 1 - exp(-RN_CN / (0.06 * srate)); // dips in 3 ms, out 60 ms
  rn_kef = 1 - exp(-1 / (0.005 * srate)); rn_kes = 1 - exp(-1 / (0.05 * srate));          // attacks: 5 ms vs 50 ms
  rn_ksh = 1 - exp(-RN_CN / (0.03 * srate));
  rn_kg = 1 - exp(-1 / (0.002 * srate)); rn_kgr = 1 - exp(-1 / (0.04 * srate));          // rounding: 2 ms / 40 ms
  rn_sm = 1 - exp(-1 / (0.02 * srate));                                                  // 20 ms glides
  rn_dlk = 1 / (0.015 * srate);                                                          // DELTA: 15 ms
  rn_kmg = 1 - exp(-1 / (0.5 * srate));                                                  // MATCH glides 0.5 s
  rn_kmt = 1 - exp(-rn_dn * RN_CN / (3 * srate));                                       // MATCH: 3 s
  // the BACK air shelf: a first-order high-pass from 8 kHz
  t = tan($pi * min(8000, 0.42 * srate) / srate); rn_hp = (1 - t) / (1 + t); rn_hg = (1 + rn_hp) * 0.5;
  // TONE (as SIFON's LOW / HIGH lifts and DIP keys, without the harmonics)
  tnL.hp30.rn_bqset(0, 30, 0.707, 0); tnR.hp30.rn_bqset(0, 30, 0.707, 0);
  rn_dd2.rn_bqset(4, 220, 2.5, 0); rn_dd3.rn_bqset(4, 3000, 0.6, 0);                     // the DIP detectors
  // MATCH for TONE: K-weighting (a high shelf +4 dB from 1.7 kHz, a 38 Hz high-pass) before and after TONE, 3 s
  rkA.hs.rn_bqset(2, 1681, 0.707, 4); rkA.hp.rn_bqset(0, 38, 0.5, 0); rkB.hs.rn_bqset(2, 1681, 0.707, 4); rkB.hp.rn_bqset(0, 38, 0.5, 0);
  rn_kte = 1 - exp(-1 / (3 * srate));
  rn_tq = -1;                                                                            // rework the TONE filters
  rn_kdw = 1 - exp(-1 / (0.02 * srate));                                                 // DIP: 20 ms energies
  rn_kat = 1 - exp(-RN_CN / (0.005 * srate)); rn_krl = 1 - exp(-RN_CN / (0.12 * srate)); //   5 ms / 120 ms
  rn_ksw = 1 - exp(-1 / (0.015 * srate));
  rn_cql = rn_cqh = -1;                                                                  // rework TONE's saturation
  rn_kms = 1 - exp(-1 / (0.01 * srate));                                                 // MUTE / SOLO: 10 ms                                                // TONE keys: 15 ms
  memset(M_RING, 0, RN_NK * RN_WMAX); memset(M_RS, 0, RN_NK); memset(M_ACC, 0, RN_NK); memset(M_EQ, 0, RN_NK);
  rn_wp = 0; rn_cc = 0; rn_dc = 0;
);
// ---------- the controls ----------
function rn_update() local(p, v) (
  rn_um = min(max(slider1, 0), 100) / 100; rn_tr = min(max(slider2, 0), 100) / 100; rn_dp = min(max(slider3, 0), 100) / 100;
  rn_ttr = 10 ^ (min(max(slider4, -3), 3) / 20);
  rn_mt = slider5 >= 0.5; rn_dlt = slider6 >= 0.5;
  os_tf = os_f2n(slider47);
  // FOCUS: -1 = MID (the room made in the centre only), 0 = both, +1 = WIDE (the sides only)
  v = min(max(slider24, -100), 100) / 100; rn_fwm = min(1, 1 - v); rn_fws = min(1, 1 + v);
  rn_fpt = 0.5 * (rn_fwm + rn_fws); rn_fqt = 0.5 * (rn_fwm - rn_fws); rn_fmw = 0.75 * rn_fwm + 0.25 * rn_fws;
  rn_frt = slider(S_FR) >= 0.5;
  // NUDGE (3 ms steps, -30 .. +30): later = the pair delayed; earlier = every other pair delayed instead, by the
  // most any pair is moved earlier (the latency RON32 then reports)
  v = 0; p = 0; loop(RN_NP, M_NDT[p] = min(max(floor(slider(S_NU + p) / 3 + 0.5) * 3, -30), 30); v = min(v, M_NDT[p]); p += 1; );
  rn_ltt = floor(-v * srate / 1000 + 0.5); rn_nreq = 0;
  p = 0; loop(RN_NP, M_NDT[p] = floor((M_NDT[p] - v) * srate / 1000 + 0.5); rn_nreq |= M_NDT[p] > 0; p += 1; );
  rn_lwt = slider25 >= 0.5; rn_llt = min(max(slider26, 0), 100) / 100;
  rn_hwt = slider27 >= 0.5; rn_hlt = min(max(slider28, 0), 100) / 100;
  rn_d2t = slider29 >= 0.5 && rn_lwt; rn_d3t = slider30 >= 0.5 && rn_hwt;            // each DIP only with its band
  rn_so = 0; p = 0; loop(RN_NP, rn_so |= slider(S_SO + p) >= 0.5; p += 1; );
  p = 0; loop(RN_NP, M_MUG[p] = slider(S_MU + p) >= 0.5 ? 0 : 1; M_SOG[p] = !rn_so || slider(S_SO + p) >= 0.5; p += 1; );
  p = 0; loop(RN_NP,
    v = min(max(floor(slider(S_PL + p) + 0.5), 0), 2); M_PL[p] = v; M_WR[p] = v == 0 ? 1 : v == 1 ? 0.6 : 0.3;
    M_MOT[p] = slider(S_MO + p) >= 0.5;                   // (each pair takes it at its next control step)
    p += 1; );
);

// ---------- one pair (instances p0 .. p7): MONO, the six band filters, the room it makes ----------
// Each band is a constant-peak band-pass (Q 1) of the pair, run all the time: the detectors listen to it and the
// room is made by adding back k x the band (k = gain - 1; a cut of g dB at the centre, a peaking filter in
// Regalia-Mitra form). k = 0 adds nothing at all, so a pair that needs no room is the input itself, bit for bit;
// k glides sample by sample across each 32-sample step, so nothing zips or clicks.
function rn_pair(a, b) instance(nba, nd, nd0, nm, cpd, mg, mgt, sg, sgt, df, mo, mot, aw, pl, pr, cpk, ef, es, n, sk, sd, st, hl, hr, hxl, hxr, dg, dgt, l0a, l0b, r0a, r0b, k0, d0, t0, e0, l1a, l1b, r1a, r1b, k1, d1, t1, e1, l2a, l2b, r2a, r2b, k2, d2, t2, e2, l3a, l3b, r3a, r3b, k3, d3, t3, e3, l4a, l4b, r4a, r4b, k4, d4, t4, e4, l5a, l5b, r5a, r5b, k5, d5, t5, e5) local(c, x, oa, ob, yl, yr, m, i, j, s) (
  a != rn_c0l || b != rn_c0r ? df = 1;                  // the COPY GUARD: anything that differs from 1-2
  // MUTE (before everything: a muted pair isn't heard and isn't listened to) and SOLO (after: glides 10 ms)
  mg != mgt ? ( mg += (mgt - mg) * rn_kms; abs(mg - mgt) < 0.00001 ? mg = mgt; );
  sg != sgt ? ( sg += (sgt - sg) * rn_kms; abs(sg - sgt) < 0.00001 ? sg = sgt; );
  mg != 1 ? ( a *= mg; b *= mg; );
  rn_xl = a; rn_xr = b;                                  // the plain sum (BYPASS) mutes and solos the same
  pl = max(pl, abs(a)); pr = max(pr, abs(b)); cpk = max(cpk, abs(a) + abs(b));
  // NUDGE: the pair read back late from its own line (0 = straight through); a change crossfades 15 ms
  rn_nwon ? (                                            // (the lines only run while some pair is nudged)
    nba[rn_nw] = a; nba[RN_NL + rn_nw] = b;
    nd > 0 || nm < 1 ? (
      j = (rn_nw - nd) & (RN_NL - 1);
      nm < 1 ? (
        i = (rn_nw - nd0) & (RN_NL - 1); nm = min(nm + rn_nxk, 1); s = nm * nm * (3 - 2 * nm);
        a = nba[i] + (nba[j] - nba[i]) * s; b = nba[RN_NL + i] + (nba[RN_NL + j] - nba[RN_NL + i]) * s;
      ) : ( a = nba[j]; b = nba[RN_NL + j]; );
      cpd = max(cpd, abs(a) + abs(b));
    );
  );
  rn_ql = a; rn_qr = b;                                  // the plain sum in time with the nudges (DELTA)
  mo != mot ? ( mo += (mot - mo) * rn_sm; abs(mo - mot) < 0.00001 ? mo = mot; );
  mo > 0 ? ( c = (a + b) * 0.5; a += (c - a) * mo; b += (c - b) * mo; );
  aw || a != 0 || b != 0 ? (
    x = (a + b) * 0.5; x *= x; ef += (x - ef) * rn_kef; es += (x - es) * rn_kes;
    n > 0 ? ( n -= 1; n > 0 ? ( k0 += d0; k1 += d1; k2 += d2; k3 += d3; k4 += d4; k5 += d5; sk += sd; ) : ( k0 = t0; k1 = t1; k2 = t2; k3 = t3; k4 = t4; k5 = t5; sk = st; ); );
    yl = rn_b00 * a + l0a; l0a = l0b - rn_a10 * yl; l0b = -rn_b00 * a - rn_a20 * yl;
    yr = rn_b00 * b + r0a; r0a = r0b - rn_a10 * yr; r0b = -rn_b00 * b - rn_a20 * yr;
    m = yl + yr; e0 += m * m; oa = k0 * yl; ob = k0 * yr;
    yl = rn_b01 * a + l1a; l1a = l1b - rn_a11 * yl; l1b = -rn_b01 * a - rn_a21 * yl;
    yr = rn_b01 * b + r1a; r1a = r1b - rn_a11 * yr; r1b = -rn_b01 * b - rn_a21 * yr;
    m = yl + yr; e1 += m * m; oa += k1 * yl; ob += k1 * yr;
    yl = rn_b02 * a + l2a; l2a = l2b - rn_a12 * yl; l2b = -rn_b02 * a - rn_a22 * yl;
    yr = rn_b02 * b + r2a; r2a = r2b - rn_a12 * yr; r2b = -rn_b02 * b - rn_a22 * yr;
    m = yl + yr; e2 += m * m; oa += k2 * yl; ob += k2 * yr;
    yl = rn_b03 * a + l3a; l3a = l3b - rn_a13 * yl; l3b = -rn_b03 * a - rn_a23 * yl;
    yr = rn_b03 * b + r3a; r3a = r3b - rn_a13 * yr; r3b = -rn_b03 * b - rn_a23 * yr;
    m = yl + yr; e3 += m * m; oa += k3 * yl; ob += k3 * yr;
    yl = rn_b04 * a + l4a; l4a = l4b - rn_a14 * yl; l4b = -rn_b04 * a - rn_a24 * yl;
    yr = rn_b04 * b + r4a; r4a = r4b - rn_a14 * yr; r4b = -rn_b04 * b - rn_a24 * yr;
    m = yl + yr; e4 += m * m; oa += k4 * yl; ob += k4 * yr;
    yl = rn_b05 * a + l5a; l5a = l5b - rn_a15 * yl; l5b = -rn_b05 * a - rn_a25 * yl;
    yr = rn_b05 * b + r5a; r5a = r5b - rn_a15 * yr; r5b = -rn_b05 * b - rn_a25 * yr;
    m = yl + yr; e5 += m * m; oa += k5 * yl; ob += k5 * yr;
    // FOCUS: the room made in the centre (MID) or at the sides (WIDE) of the pair only
    rn_fq != 0 ? ( c = oa; oa = rn_fp * oa + rn_fq * ob; ob = rn_fq * c + rn_fp * ob; );
    a += oa; b += ob;
    // DEPTH (BACK pairs): the air shelf (a first-order high-pass from 8 kHz, added back x sk) and softer attacks
    yl = rn_hg * (a - hxl) + rn_hp * hl; hxl = a; hl = yl; yr = rn_hg * (b - hxr) + rn_hp * hr; hxr = b; hr = yr;
    a += sk * yl; b += sk * yr;
    dg != dgt ? ( dg += (dgt - dg) * (dgt < dg ? rn_kg : rn_kgr); abs(dg - dgt) < 0.000001 ? dg = dgt; );
    dg != 1 ? ( a *= dg; b *= dg; );
  );
  sg != 1 ? ( a *= sg; b *= sg; rn_xl *= sg; rn_xr *= sg; rn_ql *= sg; rn_qr *= sg; );
  rn_l = a; rn_r = b;
);
// every 32 samples: hand the chunk's band energies, peaks and attack levels to the control rate
function rn_pull(p) instance(nd, nd0, nm, cpd, mg, mgt, sg, sgt, df, mo, mot, aw, pl, pr, cpk, ef, es, n, sk, sd, st, hl, hr, hxl, hxr, dg, dgt, l0a, l0b, r0a, r0b, k0, d0, t0, e0, l1a, l1b, r1a, r1b, k1, d1, t1, e1, l2a, l2b, r2a, r2b, k2, d2, t2, e2, l3a, l3b, r3a, r3b, k3, d3, t3, e3, l4a, l4b, r4a, r4b, k4, d4, t4, e4, l5a, l5b, r5a, r5b, k5, d5, t5, e5) local(k) (
  k = p * 6;
  M_ACC[k + 0] = e0 * 0.25; e0 = 0; M_ACC[k + 1] = e1 * 0.25; e1 = 0; M_ACC[k + 2] = e2 * 0.25; e2 = 0; M_ACC[k + 3] = e3 * 0.25; e3 = 0; M_ACC[k + 4] = e4 * 0.25; e4 = 0; M_ACC[k + 5] = e5 * 0.25; e5 = 0;
  M_EF[p] = ef; M_ES[p] = es; M_PK[2 * p] = max(M_PK[2 * p], pl); M_PK[2 * p + 1] = max(M_PK[2 * p + 1], pr); pl = pr = 0;
  // the COPY GUARD: a whole chunk that sounded and was 1-2 sample for sample = a copy (a silent chunk keeps the verdict)
  p > 0 && cpk > 0.00002 ? M_CP[p] = !df; df = 0;            // (above -100 dB: a denormal guard's tiny DC is no verdict)
  M_CP[p] ? ( memset(M_ACC + k, 0, 6); M_EF[p] = 0; );
  // silent for a whole chunk (and the tails gone): asleep, the filters cleared
  aw = cpk > 0 || cpd > 0 || ef > 0.0000000001; cpk = cpd = 0;
  // NUDGE: a pair's own move crossfades (a change of the latency swaps every pair at once, in @sample)
  rn_lat == rn_ltt && rn_nfill == 0 && nm >= 1 && M_NDT[p] != nd ? ( nd0 = nd; nd = M_NDT[p]; nm = 0; );
  rn_nact |= nd > 0 || nm < 1;
  !aw ? ( l0a = l0b = r0a = r0b = 0; l1a = l1b = r1a = r1b = 0; l2a = l2b = r2a = r2b = 0; l3a = l3b = r3a = r3b = 0; l4a = l4b = r4a = r4b = 0; l5a = l5b = r5a = r5b = 0; hl = hr = hxl = hxr = ef = es = 0; );
  mot = M_MOT[p]; mgt = M_MUG[p]; sgt = M_SOG[p];
);
// ... and take back the room each band makes (k targets, reached by gliding over the next 32 samples)
function rn_push(p) instance(mo, mot, aw, pl, pr, cpk, ef, es, n, sk, sd, st, hl, hr, hxl, hxr, dg, dgt, l0a, l0b, r0a, r0b, k0, d0, t0, e0, l1a, l1b, r1a, r1b, k1, d1, t1, e1, l2a, l2b, r2a, r2b, k2, d2, t2, e2, l3a, l3b, r3a, r3b, k3, d3, t3, e3, l4a, l4b, r4a, r4b, k4, d4, t4, e4, l5a, l5b, r5a, r5b, k5, d5, t5, e5) local(k) (
  k = p * 6;
  t0 = M_KT[k + 0]; t1 = M_KT[k + 1]; t2 = M_KT[k + 2]; t3 = M_KT[k + 3]; t4 = M_KT[k + 4]; t5 = M_KT[k + 5]; st = M_SKT[p]; dgt = M_DGT[p];
  d0 = (t0 - k0) / RN_CN; d1 = (t1 - k1) / RN_CN; d2 = (t2 - k2) / RN_CN; d3 = (t3 - k3) / RN_CN; d4 = (t4 - k4) / RN_CN; d5 = (t5 - k5) / RN_CN; sd = (st - sk) / RN_CN;
  n = t0 != k0 || t1 != k1 || t2 != k2 || t3 != k3 || t4 != k4 || t5 != k5 || st != sk ? RN_CN : 0;
);
function rn_start(p) instance(nba, nd, nd0, nm, mg, mgt, sg, sgt, mo, mot, aw, pl, pr, cpk, ef, es, n, sk, sd, st, hl, hr, hxl, hxr, dg, dgt, l0a, l0b, r0a, r0b, k0, d0, t0, e0, l1a, l1b, r1a, r1b, k1, d1, t1, e1, l2a, l2b, r2a, r2b, k2, d2, t2, e2, l3a, l3b, r3a, r3b, k3, d3, t3, e3, l4a, l4b, r4a, r4b, k4, d4, t4, e4, l5a, l5b, r5a, r5b, k5, d5, t5, e5) ( mo = mot = M_MOT[p]; mg = mgt = M_MUG[p]; sg = sgt = M_SOG[p]; dg = dgt = 1; aw = 0;
  nba = M_NB + p * 2 * RN_NL; nd = nd0 = M_NDT[p]; nm = 1; );
function rn_nsnap(p) instance(nd, nd0, nm) ( nd = nd0 = M_NDT[p]; nm = 1; );
function rn_nsnapall() ( p0.rn_nsnap(0); p1.rn_nsnap(1); p2.rn_nsnap(2); p3.rn_nsnap(3); p4.rn_nsnap(4); p5.rn_nsnap(5); p6.rn_nsnap(6); p7.rn_nsnap(7); p8.rn_nsnap(8); p9.rn_nsnap(9); p10.rn_nsnap(10); p11.rn_nsnap(11); p12.rn_nsnap(12); p13.rn_nsnap(13); p14.rn_nsnap(14); p15.rn_nsnap(15); );

// ---------- the decisions (every ~5 ms): home bands, how much each pair needs each band, the UNMASK cuts, MATCH ----------
function rn_decide() local(p, q, b, k, e, mx, h, np, nq, d, m, pr, loss, tot, s, num, den, g) (
  p = 0; loop(RN_NP,
    k = p * 6; mx = 0; h = M_HOME[p];
    b = 0; loop(6, e = M_E[k + b] / M_REF[b]; e > mx ? ( mx = e; s = b; ); b += 1; );
    // the home band moves only when another band is clearly (3 dB) stronger
    mx > 0 ? ( M_E[k + h] / M_REF[h] * 2 < mx ? M_HOME[p] = s; ) : M_HOME[p] = 0;
    b = 0; loop(6, M_REL[k + b] = mx > 0 ? M_E[k + b] / M_REF[b] / mx : 0; b += 1; );
    p += 1; );
  num = den = 0;
  p = 0; loop(RN_NP,
    k = p * 6; loss = 0; tot = 0;
    b = 0; loop(6,
      pr = 0;
      // only what is a real part of the pair's sound (within 15 dB of its strongest band) is ever moved
      M_EX[k + b] > 0.000001 && M_REL[k + b] > 0.03 && b != M_HOME[p] && rn_um > 0 && !M_CP[p] ? (
        np = M_WR[p] * 0.5 * M_REL[k + b];
        q = 0; loop(RN_NP,
          q != p && !M_CP[q] && M_EX[q * 6 + b] > 0.000001 && M_REL[q * 6 + b] > 0.03 ? (
            nq = M_WR[q] * (b == M_HOME[q] ? 1 : 0.5 * M_REL[q * 6 + b]);
            nq > np ? (
              d = (nq - np) / nq;
              m = min(max((10 * log10(M_EX[k + b] / M_E[q * 6 + b]) + 9) / 12, 0), 1);   // p loud enough to mask q
              pr = max(pr, d * m);
            );
          );
          q += 1; );
      );
      M_CUTT[k + b] = rn_um * 4 * pr;
      loss += M_E[k + b] * (1 - 10 ^ (-M_CUTT[k + b] / 10)); tot += M_E[k + b];
      // MATCH: the K-weighted level of every band before and after (pairs taken as unrelated)
      g = (M_CUT[k + b] + M_DK[k + b]) * rn_fmw; b == 5 ? g -= M_SHG[p];   // (FOCUS: the part of the pair cut)
      den += M_KW[b] * M_E[k + b]; num += M_KW[b] * M_E[k + b] * 10 ^ (-g / 10);
      M_DSA[k + b] = M_E[k + b] > 0 ? min(max((10 * log10(M_E[k + b]) + 60) / 48, 0), 1) : 0;
      b += 1; );
    // never more than 3 dB of the pair's level in all
    tot > 0 && loss > 0 ? ( d = -10 * log10(max(1 - loss / tot, 0.000001)); d > 3 ? ( m = 3 / d; b = 0; loop(6, M_CUTT[k + b] *= m; b += 1; ); ); );
    M_DSH[p] = M_HOME[p];
    p += 1; );
  // MATCH (3 s): only ever makes up what was taken out, at most 1.5 dB
  g = rn_mt && den > 0.0000001 && num > 0 ? min(max(sqrt(den / num), 1), 1.1885) : rn_mt ? rn_mtt : 1;
  rn_mtt += (g - rn_mtt) * rn_kmt; abs(rn_mtt - g) < 0.000000001 ? rn_mtt = g;
);

// ---------- TONE's saturation (as SIFON's COLOUR): the coefficients at the OS rate ----------
function rc_th(v) local(e) ( e = exp(2 * max(min(v, 20), -20)); (e - 1) / (e + 1); );
function rn_ccoef() local(t, f) (
  f = srate * os_f;
  t = tan($pi * 300 / f); rn_cgb = t / (1 + t);                       // LOW: the band below 300 Hz
  t = tan($pi * 4730 / f); rn_cgs = t / (1 + t);                      // HIGH's lift: the shelf from 4.7 kHz
  t = tan($pi * 3000 * 2 ^ (-1.6 * rn_hls) / f); rn_cgr = t / (1 + t);   // HIGH's band: from 3 kHz, down to 1 kHz at 100 %
  rn_khf = 1 - exp(-1 / (0.03 * f)); rn_cdc = 1 - 2 * $pi * 5 / f;
  // each TEXTURE drives its band from 0 to +18 dB, the curve's output set so a band peaking at -12 dBFS keeps its level
  rn_ghl = 10 ^ (18 * rn_lls / 20); rn_ghh = 10 ^ (18 * rn_hls / 20);
  rn_tbh = rc_th(0.3); rn_ch = 0.25 / (rc_th(rn_ghh * 0.125 + 0.3) - rc_th(0.3 - rn_ghh * 0.125));
  rn_tbl = rc_th(0.4); rn_cl = 0.25 / (rc_th(rn_ghl * 0.125 + 0.4) - rc_th(0.4 - rn_ghl * 0.125));
  // the DIP keys also dip the harmonics: HIGH's broadly at 3 kHz, LOW's narrowly at 220 Hz
  rn_g3q = -9 * rn_d2s; rn_g4q = -6 * rn_d3s; rn_bfs = f;
  cnL.hd.rn_bqset(1, 3000, 0.6, rn_g4q); cnR.hd.rn_bqset(1, 3000, 0.6, rn_g4q);
  cnL.ld.rn_bqset(1, 220, 2.5, rn_g3q); cnR.ld.rn_bqset(1, 220, 2.5, rn_g3q);
  rn_bfs = srate; rn_cql = rn_lls; rn_cqh = rn_hls;
);
// harmonics only: takes out of a saturated band (h) the part that still follows the band itself (x), over 30 ms
function rc_hf(h, x) instance(cxy, cxx) (
  cxy += (h * x - cxy) * rn_khf; cxx += (x * x - cxx) * rn_khf;
  h - x * (cxx > 0.000000000001 ? cxy / cxx : 1);
);
// one channel of LOW / HIGH at the OS rate (instances cnL, cnR): each band's lift, and its parallel saturation (the
// HEAD curve: tanh with a small bias) adding only harmonics, DC-blocked at 5 Hz
function rn_col(u) instance(rp, bp, ep, sp, hc, lc, hd, ld, xa, ya) local(hi, bl, dd, ev, dr, h, d) (
  hi = u - this.rp.rn_op(u, rn_cgr);
  bl = this.bp.rn_op(u, rn_cgb);
  dd = this.ld.rn_bqrun(this.lc.rc_hf((rc_th(rn_ghl * bl + 0.4) - rn_tbl) * rn_cl, bl));
  ev = this.hc.rc_hf((rc_th(rn_ghh * hi + 0.3) - rn_tbh) * rn_ch, hi);
  dr = this.hd.rn_bqrun(ev - this.ep.rn_op(ev, rn_cgr));
  h = rn_lw * dd + rn_hw * dr;
  d = h - xa + rn_cdc * ya; xa = h; ya = d;
  u + rn_hw * rn_shh * (u - this.sp.rn_op(u, rn_cgs)) + rn_lw * rn_shl * bl + d;
);
function rn_cclr() instance(rp, bp, ep, sp, hc, lc, hd, ld, xa, ya) (
  this.rp.z = this.bp.z = this.ep.z = this.sp.z = 0; this.hc.cxy = this.hc.cxx = this.lc.cxy = this.lc.cxx = 0;
  this.hd.rn_bqclr(); this.ld.rn_bqclr(); xa = ya = 0;
);
// ---------- TONE (every 32 samples): the TEXTURE dials glide 30 ms, the DIPs follow the mix ----------
function rn_tctl() local(t2, t2h, x2, x3) (
  rn_lls += (rn_llt - rn_lls) * rn_ksh; abs(rn_lls - rn_llt) < 0.0005 ? rn_lls = rn_llt;
  rn_hls += (rn_hlt - rn_hls) * rn_ksh; abs(rn_hls - rn_hlt) < 0.0005 ? rn_hls = rn_hlt;
  rn_shl = 10 ^ (2.5 * min(rn_lls, 0.5) / 20) - 1;         // LOW: the band below 300 Hz to +1.25 dB
  rn_shh = 10 ^ (3.1 * rn_hls / 20) - 1;                   // HIGH: the shelf from 4.7 kHz to +3.1 dB
  t2 = max(0, 2 * rn_lls - 1); t2h = max(0, 2 * rn_hls - 1); rn_t2 = t2;
  abs(rn_lls - rn_cql) > 0.002 || (rn_lls != rn_cql && rn_lls == rn_llt) || abs(rn_hls - rn_cqh) > 0.002 ||
    (rn_hls != rn_cqh && rn_hls == rn_hlt) || abs(-9 * rn_d2s - rn_g3q) > 0.03 || abs(-6 * rn_d3s - rn_g4q) > 0.03 ? rn_ccoef();
  rn_bfs = srate;
  rn_tq != rn_lls + 3 * rn_hls ? (
    rn_tq = rn_lls + 3 * rn_hls;                           // from 50 %: 120 Hz +2.3 dB (and 30 Hz out), 15 kHz +3 dB
    tnL.pk.rn_bqset(1, 120, 0.707, 2.3 * t2); tnR.pk.rn_bqset(1, 120, 0.707, 2.3 * t2);
    tnL.h15.rn_bqset(2, 15000, 0.707, 3 * t2h); tnR.h15.rn_bqset(2, 15000, 0.707, 3 * t2h);
  );
  // the DIPs: half of what 220 Hz / 3 kHz stands out from the whole mix by, up to 6 dB
  rn_dpf > 0.0000000001 ? (
    x2 = min(6, max(0, 0.5 * (10 * log10(rn_dpa / rn_dpf + 0.000000000001) + 10))) * rn_d2s * rn_lw;
    x3 = min(6, max(0, 0.5 * (10 * log10(rn_dpb / rn_dpf + 0.000000000001) + 9))) * rn_d3s * rn_hw;
  ) : x2 = x3 = 0;
  rn_dga += (x2 - rn_dga) * (x2 > rn_dga ? rn_kat : rn_krl); rn_dga < 0.0005 && x2 == 0 ? rn_dga = 0;
  rn_dgb += (x3 - rn_dgb) * (x3 > rn_dgb ? rn_kat : rn_krl); rn_dgb < 0.0005 && x3 == 0 ? rn_dgb = 0;
  rn_dga != rn_dqa ? ( rn_dqa = rn_dga; tnL.da.rn_bqset(1, 220, 2.5, -rn_dga); tnR.da.rn_bqset(1, 220, 2.5, -rn_dga); );
  rn_dgb != rn_dqb ? ( rn_dqb = rn_dgb; tnL.db.rn_bqset(1, 3000, 0.6, -rn_dgb); tnR.db.rn_bqset(1, 3000, 0.6, -rn_dgb); );
  rn_dsd_d = max(rn_dga, rn_dgb);
  // MATCH for TONE: what TONE adds or takes (K-weighted, 3 s) comes back off (-6 .. +1.5 dB), so TONE is colour, not level
  rn_tgt = rn_mt && rn_co ? ( rn_tet > 0.0000000001 && rn_tep > 0 ? min(max(sqrt(rn_tep / rn_tet), 0.5), 1.1885) : rn_tgt ) : 1;
);
// one channel of TONE's 1x part (instances tnL, tnR): from 50 % TEXTURE the 15 kHz / 120 Hz lifts, the 30 Hz filter
function rn_tone(x) instance(h15, hp30, pk, da, db) local(y) (
  y = x + rn_hw * (this.h15.rn_bqrun(x) - x);
  y += rn_lw * rn_t2 * (this.hp30.rn_bqrun(y) - y);
  y + rn_lw * (this.pk.rn_bqrun(y) - y);
);
function rn_tdip(x) instance(da, db) ( this.db.rn_bqrun(this.da.rn_bqrun(x)); );
function rn_kw(x) instance(hs, hp) ( this.hs.rn_bqrun(this.hp.rn_bqrun(x)); );
function rn_tclr() instance(h15, hp30, pk, da, db) (
  this.h15.rn_bqclr(); this.hp30.rn_bqclr(); this.pk.rn_bqclr(); this.da.rn_bqclr(); this.db.rn_bqclr();
);

// ---------- the control rate (every 32 samples) ----------
function rn_ctl() local(p, q, b, k, r, e, x, w, dk, g, c, bb, t, n) (
  p0.rn_pull(0); p1.rn_pull(1); p2.rn_pull(2); p3.rn_pull(3); p4.rn_pull(4); p5.rn_pull(5); p6.rn_pull(6); p7.rn_pull(7); p8.rn_pull(8); p9.rn_pull(9); p10.rn_pull(10); p11.rn_pull(11); p12.rn_pull(12); p13.rn_pull(13); p14.rn_pull(14); p15.rn_pull(15);
  // the 900 ms windows: this chunk in, the oldest out
  k = 0; loop(RN_NK,
    r = M_RING + k * RN_WMAX + rn_wp;
    M_RS[k] = max(M_RS[k] + M_ACC[k] - r[0], 0); M_RS[k] < 0.0000000000000000001 ? M_RS[k] = 0;
    r[0] = M_ACC[k];
    M_E[k] = M_RS[k] / (rn_wl * RN_CN);
    // FAST: the decisions hear the quieter of the window and an 80 ms ear, so a clash that ends lets go at once
    M_EQ[k] += (M_ACC[k] / RN_CN - M_EQ[k]) * rn_kfq; M_EQ[k] < 0.0000000000000000001 ? M_EQ[k] = 0;
    M_EX[k] = M_E[k] + (min(M_E[k], M_EQ[k]) - M_E[k]) * rn_fr;
    k += 1; );
  rn_wp += 1; rn_wp >= rn_wl ? rn_wp = 0;
  rn_dc -= 1; rn_dc <= 0 ? ( rn_dc = rn_dn; rn_decide(); );
  rn_fr != rn_frt ? ( rn_fr += (rn_frt - rn_fr) * rn_kfr; abs(rn_fr - rn_frt) < 0.0001 ? rn_fr = rn_frt; );
  rn_kcr = rn_kc0 + (rn_kc1 - rn_kc0) * rn_fr;          // FAST: cuts let go in 40 ms, not 150 ms
  // attacks: the pairs that are hitting now (M_TQ, n of them)
  n = 0;
  p = 0; loop(RN_NP,
    M_XT[p] = M_EF[p] > 0.000001 && M_ES[p] > 0 ? min(max((10 * log10(M_EF[p] / M_ES[p]) - 3) / 9, 0), 1) : 0;
    M_XT[p] > 0 ? ( M_TQ[n] = p; n += 1; );
    p += 1; );
  // the TRANSIENT dips, then every cell's cut and dip glide into its k
  p = 0; loop(RN_NP,
    k = p * 6;
    b = 0; loop(6,
      dk = 0;
      rn_tr > 0 && n > 0 && M_E[k + b] > 0.000001 && !M_CP[p] ? (
        x = 0; loop(n,
          q = M_TQ[x];
          q != p ? ( w = min(max(1 + M_WR[q] - M_WR[p], 0.3), 1); dk = max(dk, M_XT[q] * M_REL[q * 6 + b] * w); );
          x += 1; );
      );
      M_DKT[k + b] = rn_tr * 2.5 * dk;
      t = M_CUTT[k + b]; c = M_CUT[k + b];
      c != t ? ( c += (t - c) * (t > c ? rn_kca : rn_kcr); t == 0 && c < 0.0005 ? c = 0; M_CUT[k + b] = c; );
      t = M_DKT[k + b]; e = M_DK[k + b];
      e != t ? ( e += (t - e) * (t > e ? rn_kda : rn_kdr); t == 0 && e < 0.0005 ? e = 0; M_DK[k + b] = e; );
      g = c + e;
      g != M_GN[k + b] ? ( M_GN[k + b] = g; M_KT[k + b] = g > 0 ? 10 ^ (-g / 20) - 1 : 0; );
      M_DSC[k + b] = c; M_DSK[k + b] = e;
      b += 1; );
    // DEPTH: BACK pairs lose a little air and their attacks round off
    bb = M_PL[p] == 2 && !M_CP[p];
    M_SHT[p] = bb ? -1.5 * rn_dp : 0;
    M_DGT[p] = bb && rn_dp > 0 ? 10 ^ (-2 * rn_dp * M_XT[p] / 20) : 1;
    t = M_SHT[p]; e = M_SHG[p];
    e != t ? ( e += (t - e) * rn_ksh; t == 0 && e > -0.0005 ? e = 0; M_SHG[p] = e; M_SKT[p] = e < 0 ? 10 ^ (e / 20) - 1 : 0; );
    p += 1; );
  p0.rn_push(0); p1.rn_push(1); p2.rn_push(2); p3.rn_push(3); p4.rn_push(4); p5.rn_push(5); p6.rn_push(6); p7.rn_push(7); p8.rn_push(8); p9.rn_push(9); p10.rn_push(10); p11.rn_push(11); p12.rn_push(12); p13.rn_push(13); p14.rn_push(14); p15.rn_push(15);
  rn_tctl();
);

rn_coef(); rn_update();
memset(M_CUT, 0, RN_NK); memset(M_DK, 0, RN_NK); memset(M_GN, 0, RN_NK); memset(M_KT, 0, RN_NK); memset(M_SHG, 0, RN_NP); memset(M_SKT, 0, RN_NP); memset(M_TQ, 0, RN_NP);
rn_i = 0; loop(RN_NP, M_DGT[rn_i] = 1; M_HOME[rn_i] = 0; rn_i += 1; );
p0.rn_start(0); p1.rn_start(1); p2.rn_start(2); p3.rn_start(3); p4.rn_start(4); p5.rn_start(5); p6.rn_start(6); p7.rn_start(7); p8.rn_start(8); p9.rn_start(9); p10.rn_start(10); p11.rn_start(11); p12.rn_start(12); p13.rn_start(13); p14.rn_start(14); p15.rn_start(15);
rn_fr = rn_frt; rn_kcr = rn_kc0 + (rn_kc1 - rn_kc0) * rn_fr; memset(M_EX, 0, RN_NK);
rn_lat = rn_ltt; rn_nwon = rn_nreq; rn_nfill = 0; memset(M_NB, 0, 2 * RN_NL * RN_NP); rn_ng = 1; rn_nh = 0; rn_nw = 0; os_base = rn_lat; pdc_delay = os_base + os_lat(os_f);
rn_trm = rn_ttr; rn_dl = rn_dlt; rn_mg = rn_mtt = 1; rn_tg = rn_tgt = 1;
memset(M_CP, 0, RN_NP); rn_fp = rn_fpt; rn_fq = rn_fqt;
rn_lw = rn_lwt; rn_hw = rn_hwt; rn_lls = rn_llt; rn_hls = rn_hlt; rn_d2s = rn_d2t; rn_d3s = rn_d3t;
rn_dga = rn_dgb = 0; rn_dqa = rn_dqb = -1; rn_tctl(); tnL.rn_tclr(); tnR.rn_tclr(); cnL.rn_cclr(); cnR.rn_cclr();
memset(M_DLY, 0, 128); rn_dw = 0;

// ---------- presets: UNMASK (with FAST), TRANSIENT, DEPTH, FOCUS, TONE, MATCH, TRIM (PLACE, MONO, NUDGE and the names belong to the mix) ----------
function rn_set(u, t, d, m, tr, fo, lo, ll, hi, hl, d2, d3, fr) (
  slider1 = u; slider2 = t; slider3 = d; slider4 = tr; slider5 = m; slider6 = 0;
  slider24 = fo; slider25 = lo; slider26 = ll; slider27 = hi; slider28 = hl; slider29 = d2; slider30 = d3;
  slider(S_FR) = fr;
  slider_automate(63 + 127 * 2 ^ 23);                       // sliders 1-6, 24-30
  S_FR <= 63 ? slider_automate(2 ^ (S_FR - 1)) : slider_automate(slider96);   // FAST (RON32: slider 96)
);
#rn_pm = "Init|Clean Sum|Light Touch|Clear|Deep Stage|Punch Through|Full Separation";
function load_preset(p) local(i) (
  //                 unmask trans depth match trim focus  LOW lift HIGH lift DIP220 DIP3K FAST
  p == 1 ? rn_set(  50,   30,   50,   1,   0,    0,   0,  30,   0,  30,   0,   0,   0) :   // Init
  p == 2 ? rn_set(   0,    0,    0,   1,   0,    0,   0,  30,   0,  30,   0,   0,   0) :   // Clean Sum (the plain sum)
  p == 3 ? rn_set(  25,   15,   25,   1,   0,    0,   0,  30,   0,  30,   0,   0,   1) :   // Light Touch
  p == 4 ? rn_set(  65,   30,   40,   1,   0,  -40,   0,  30,   1,  35,   0,   1,   0) :   // Clear
  p == 5 ? rn_set(  45,   25,   90,   1,   0,    0,   1,  30,   0,  30,   1,   0,   0) :   // Deep Stage
  p == 6 ? rn_set(  40,   75,   40,   1,   0,  -30,   0,  30,   0,  30,   0,   0,   1) :   // Punch Through
  p == 7 ? rn_set(  90,   55,   70,   1,   0,    0,   1,  20,   1,  25,   1,   1,   0) :   // Full Separation
  p == 8 ? (                                       // Reset all to defaults
    rn_set(50, 30, 50, 1, 0, 0, 0, 30, 0, 30, 0, 0, 0);
    i = 0; loop(RN_NP, slider(S_PL + i) = 1; slider(S_MO + i) = slider(S_MU + i) = slider(S_SO + i) = slider(S_NU + i) = 0; i += 1; );
    slider(S_FR) = 0;
    slider_automate(65535 * 2 ^ 6 + 65535 * 2 ^ 30 + 65535 * 2 ^ 47);   // sliders 7-22, 31-46, 48-63
    slider_automate(slider64); slider_automate(slider65); slider_automate(slider66); slider_automate(slider67); slider_automate(slider68); slider_automate(slider69); slider_automate(slider70); slider_automate(slider71); slider_automate(slider72); slider_automate(slider73); slider_automate(slider74); slider_automate(slider75); slider_automate(slider76); slider_automate(slider77); slider_automate(slider78); slider_automate(slider79); slider_automate(slider80); slider_automate(slider81); slider_automate(slider82); slider_automate(slider83); slider_automate(slider84); slider_automate(slider85); slider_automate(slider86); slider_automate(slider87); slider_automate(slider88); slider_automate(slider89); slider_automate(slider90); slider_automate(slider91); slider_automate(slider92); slider_automate(slider93); slider_automate(slider94); slider_automate(slider95); slider_automate(slider96);
  );
  pr_cur = p > 7 ? 1 : p;
);

ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (accessibility, JG 28 Oct 2026): a change of prs_sel loads that preset (0 = nothing loaded); the
// preset bar asks through prs_dirty; both load here, on the audio side only. prs_last is saved, so recalling a project
// never reloads a preset over its settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 7 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(7, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
rn_update();

@block
prs_chk();
srate != rn_sr ? rn_coef();
dv_ack_d != rn_seen ? ( rn_okl = rn_okr = 0; rn_seen = dv_ack_d; );
rn_update();
pwr_block(slider23 < 0.5);                              // mains + warm-up: BYPASS switches the heater off
// the pairs' signal-present peaks, held a moment for the panel (the panel only reads them)
rn_i = 0; loop(2 * RN_NP, M_PKD[rn_i] = max(M_PK[rn_i], M_PKD[rn_i] * 0.9); M_PK[rn_i] = 0; rn_i += 1; );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall
pwr_ser();
rn_si = 0; loop(RN_NP, file_avail(0) != 0 ? file_string(0, UI_NM + rn_si); rn_si += 1; );   // the pairs' names

@sample
// the plain sum (by_il / by_ir, built pair by pair): BYPASS, DELTA and MATCH compare against it
rn_c0l = spl0; rn_c0r = spl1;                           // the COPY GUARD compares every pair with these
rn_fp != rn_fpt || rn_fq != rn_fqt ? (                   // FOCUS glides 20 ms
  rn_fp += (rn_fpt - rn_fp) * rn_sm; rn_fq += (rn_fqt - rn_fq) * rn_sm;
  abs(rn_fp - rn_fpt) < 0.000001 && abs(rn_fq - rn_fqt) < 0.000001 ? ( rn_fp = rn_fpt; rn_fq = rn_fqt; );
);
// NUDGE: a change of the latency (a pair moved earlier) dips 5 ms, swaps every pair's delay at the dip, reports it
// (the lines start writing 61 ms before a first nudge is taken up, and stop once every pair is back at 0)
rn_nreq && !rn_nwon ? ( rn_nwon = 1; rn_nfill = floor(0.061 * srate); ) : rn_nfill > 0 ? rn_nfill -= 1;
rn_ltt != rn_lat && rn_nfill == 0 ? (
  rn_ng = max(rn_ng - rn_ngk, 0);
  rn_ng == 0 ? ( rn_lat = rn_ltt; rn_nsnapall(); os_base = rn_lat; pdc_delay = os_base + os_lat(os_f); rn_nh = pdc_delay + 8; );
) : rn_nh > 0 ? rn_nh -= 1 : rn_ng < 1 ? rn_ng = min(rn_ng + rn_ngk, 1);
p0.rn_pair(spl0, spl1); rn_ml = rn_l; rn_mr = rn_r; by_il = rn_xl; by_ir = rn_xr; rn_pl = rn_ql; rn_pr = rn_qr;
p1.rn_pair(spl2, spl3); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p2.rn_pair(spl4, spl5); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p3.rn_pair(spl6, spl7); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p4.rn_pair(spl8, spl9); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p5.rn_pair(spl10, spl11); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p6.rn_pair(spl12, spl13); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p7.rn_pair(spl14, spl15); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p8.rn_pair(spl16, spl17); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p9.rn_pair(spl18, spl19); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p10.rn_pair(spl20, spl21); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p11.rn_pair(spl22, spl23); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p12.rn_pair(spl24, spl25); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p13.rn_pair(spl26, spl27); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p14.rn_pair(spl28, spl29); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
p15.rn_pair(spl30, spl31); rn_ml += rn_l; rn_mr += rn_r; by_il += rn_xl; by_ir += rn_xr; rn_pl += rn_ql; rn_pr += rn_qr;
rn_nw = (rn_nw + 1) & (RN_NL - 1);
rn_cc += 1; rn_cc >= RN_CN ? ( rn_cc = 0; rn_nact = 0; rn_ctl(); !rn_nreq && !rn_nact && rn_lat == 0 && rn_nfill == 0 ? rn_nwon = 0; );
rn_rl = rn_ml; rn_rr = rn_mr;                            // (DELTA hears the room only, not TONE)

// ---------- TONE: LOW / HIGH lift, then the DIPs (the keys fade 15 ms; off = not run at all) ----------
rn_lw != rn_lwt ? ( rn_lw += (rn_lwt - rn_lw) * rn_ksw; abs(rn_lw - rn_lwt) < 0.00001 ? rn_lw = rn_lwt; );
rn_hw != rn_hwt ? ( rn_hw += (rn_hwt - rn_hw) * rn_ksw; abs(rn_hw - rn_hwt) < 0.00001 ? rn_hw = rn_hwt; );
rn_d2s != rn_d2t ? ( rn_d2s += (rn_d2t - rn_d2s) * rn_ksw; abs(rn_d2s - rn_d2t) < 0.00001 ? rn_d2s = rn_d2t; );
rn_d3s != rn_d3t ? ( rn_d3s += (rn_d3t - rn_d3s) * rn_ksw; abs(rn_d3s - rn_d3t) < 0.00001 ? rn_d3s = rn_d3t; );
os_gate();
os_chg ? ( rn_ccoef(); cnL.rn_cclr(); cnR.rn_cclr(); upL.os_clr(); upR.os_clr(); dnL.os_clr(); dnR.os_clr(); );
rn_co = rn_lw > 0 || rn_hw > 0;
// LOW / HIGH (lifts + the parallel saturation) at the OS rate; at 2x / 4x the mix goes through the oversampler either way
os_f == 1 ? ( rn_co ? ( rn_ml = cnL.rn_col(rn_ml); rn_mr = cnR.rn_col(rn_mr); ); ) : (
  upL.os_up(rn_ml); upR.os_up(rn_mr);
  rn_a0 = upL.s0; rn_b0 = upR.s0; rn_a1 = upL.s1; rn_b1 = upR.s1; rn_a2 = upL.s2; rn_b2 = upR.s2; rn_a3 = upL.s3; rn_b3 = upR.s3;
  rn_co ? (
    rn_a0 = cnL.rn_col(rn_a0); rn_b0 = cnR.rn_col(rn_b0); rn_a1 = cnL.rn_col(rn_a1); rn_b1 = cnR.rn_col(rn_b1);
    os_f == 4 ? ( rn_a2 = cnL.rn_col(rn_a2); rn_b2 = cnR.rn_col(rn_b2); rn_a3 = cnL.rn_col(rn_a3); rn_b3 = cnR.rn_col(rn_b3); );
  );
  rn_ml = dnL.os_dn(rn_a0, rn_a1, rn_a2, rn_a3); rn_mr = dnR.os_dn(rn_b0, rn_b1, rn_b2, rn_b3);
);
rn_co ? (
  rn_ml = tnL.rn_tone(rn_ml); rn_mr = tnR.rn_tone(rn_mr); rn_tz = 1;
  rn_d2s * rn_lw + rn_d3s * rn_hw > 0.0001 || rn_dga > 0 || rn_dgb > 0 ? (
    rn_m = 0.5 * (rn_ml + rn_mr); rn_pa = rn_dd2.rn_bqrun(rn_m); rn_pb = rn_dd3.rn_bqrun(rn_m);
    rn_dpf += (rn_m * rn_m - rn_dpf) * rn_kdw; rn_dpa += (rn_pa * rn_pa - rn_dpa) * rn_kdw; rn_dpb += (rn_pb * rn_pb - rn_dpb) * rn_kdw;
    rn_ml = tnL.rn_tdip(rn_ml); rn_mr = tnR.rn_tdip(rn_mr); rn_dz = 1;
  ) : rn_dz ? (
    rn_dpf = rn_dpa = rn_dpb = 0; rn_dd2.rn_bqclr(); rn_dd3.rn_bqclr();
    tnL.da.rn_bqclr(); tnL.db.rn_bqclr(); tnR.da.rn_bqclr(); tnR.db.rn_bqclr(); rn_dz = 0;
  );
) : rn_tz ? ( tnL.rn_tclr(); tnR.rn_tclr(); cnL.rn_cclr(); cnR.rn_cclr(); rn_dd2.rn_bqclr(); rn_dd3.rn_bqclr(); rn_dpf = rn_dpa = rn_dpb = 0; rn_tz = rn_dz = 0; );

// ---------- MATCH: made up by the level taken out (worked out with the decisions), and TONE's level, gliding 0.5 s ----------
rn_mt && rn_co ? (
  rn_k1 = rkA.rn_kw(0.5 * (rn_rl + rn_rr)); rn_k2 = rkB.rn_kw(0.5 * (rn_ml + rn_mr));
  rn_tep += (rn_k1 * rn_k1 - rn_tep) * rn_kte; rn_tet += (rn_k2 * rn_k2 - rn_tet) * rn_kte; rn_kz = 1;
) : rn_kz ? ( rn_tep = rn_tet = 0; rkA.hs.rn_bqclr(); rkA.hp.rn_bqclr(); rkB.hs.rn_bqclr(); rkB.hp.rn_bqclr(); rn_kz = 0; );
rn_mg != rn_mtt ? ( rn_mg += (rn_mtt - rn_mg) * rn_kmg; abs(rn_mg - rn_mtt) < 0.000000001 ? rn_mg = rn_mtt; );
rn_tg != rn_tgt ? ( rn_tg += (rn_tgt - rn_tg) * rn_kmg; abs(rn_tg - rn_tgt) < 0.000000001 ? rn_tg = rn_tgt; );
rn_ol = rn_ml * rn_mg * rn_tg; rn_or = rn_mr * rn_mg * rn_tg;
pwr_in(rn_ol, rn_or); rn_ol = pwr_l; rn_or = pwr_r;      // mains hum + sag, warm-up (OFF + NEAR: untouched)
pwr_out(rn_ol, rn_or); rn_ol = pwr_l; rn_or = pwr_r;
// ---------- DELTA: only what was taken out (crossfaded 15 ms) ----------
rn_dl != rn_dlt ? rn_dl = rn_dlt ? min(rn_dl + rn_dlk, 1) : max(rn_dl - rn_dlk, 0);
rn_dw = (rn_dw + 1) & 63; M_DLY[rn_dw] = rn_pl - rn_rl; M_DLY[64 + rn_dw] = rn_pr - rn_rr;   // (in time with OS)
rn_dl > 0 ? ( rn_s = rn_dl * rn_dl * (3 - 2 * rn_dl); rn_j = (rn_dw - os_lat(os_f)) & 63;
  rn_ol += (M_DLY[rn_j] - rn_ol) * rn_s; rn_or += (M_DLY[64 + rn_j] - rn_or) * rn_s; );
os_g < 1 ? ( rn_s = os_g * os_g * (3 - 2 * os_g); rn_ol *= rn_s; rn_or *= rn_s; );   // the OS swap's dip
rn_ng < 1 ? ( rn_s = rn_ng * rn_ng * (3 - 2 * rn_ng); rn_ol *= rn_s; rn_or *= rn_s; );   // the NUDGE latency swap's dip
// ---------- LEVEL TRIM; straight through (no clip) ----------
rn_trm != rn_ttr ? ( rn_trm += (rn_ttr - rn_trm) * rn_sm; abs(rn_trm - rn_ttr) < 0.0000001 ? rn_trm = rn_ttr; );
spl0 = rn_ol * rn_trm; spl1 = rn_or * rn_trm;
by_out();
// the output meter: the peak since the panel last read it (the panel acknowledges through dv_ack_d)
rn_okl = max(rn_okl, abs(spl0)); rn_okr = max(rn_okr, abs(spl1)); rn_opl_d = rn_okl; rn_opr_d = rn_okr;
spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = spl8 = spl9 = spl10 = spl11 = spl12 = spl13 = spl14 = spl15 = spl16 = spl17 = spl18 = spl19 = spl20 = spl21 = spl22 = spl23 = spl24 = spl25 = spl26 = spl27 = spl28 = spl29 = spl30 = spl31 = 0;

@gfx 1280 776
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1280, 776);

// ---------- palette and fonts: a cool slate faceplate (crystalline), the pairs' pastels from SUM DR2 ----------
RG_FACE = 0x27303A; RG_PLT = 0x2E3945; RG_INS = 0x161C22; RG_INK = 0xDCE3EA; RG_DIM = 0x8D9AA8; RG_ICE = 0xA8DCF4;
RG_SIG = 0x3DFF62; RG_AMB = 0xFFB020; rg_k0 = "0"; rg_bk = RN_NP > 8 ? rg_bk : 0;
sc != rg_fsc ? (
  rg_f11 = ui_fitfont(11, 16 * sc); rg_f12 = ui_fitfont(12, 16 * sc); rg_f13 = ui_fitfont(13, 13.5 * sc);
  rg_f14 = ui_fitfont(14, 28 * sc); rg_f15 = ui_fitfont(15, 18 * sc); rg_fsc = sc;
);
gfx_setfont(11, "Trebuchet MS", rg_f11, 'b');             // labels
gfx_setfont(12, "Trebuchet MS", rg_f12, 'b');             // key legends
gfx_setfont(13, "Trebuchet MS", rg_f13, 'b');             // scale numbers, small print
gfx_setfont(14, "Trebuchet MS", rg_f14, 'b');             // the title
gfx_setfont(15, "Trebuchet MS", rg_f15, 'b');             // section titles

function rg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function rg_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function rg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rg_set(idx, v) ( slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); ); );
// the house drop shadow: 4 layers at 13 % black, (+2, +3) .. (+6, +8), each a little larger
function rg_shadow(x, y, w, h, rr) local(i) (
  i = 0; loop(4, ui_cola(0x000000, 0.13);
    ui_rrect((x + 2 + i * 1.33) * sc, (y + 3 + i * 1.67) * sc, (w + i * 0.6) * sc, (h + i * 0.6) * sc, rr * sc); i += 1; );
);
// a section title: the name in the 32-high header band, an engraved line under the band
function rg_ttl(x1, x2, y, s) (
  gfx_setfont(15); ui_col(RG_INK); gfx_x = x1 * sc; gfx_y = (y + 20) * sc - gfx_texth * 0.5; gfx_drawstr(s);
  ui_cola(RG_DIM, 0.45); rg_r(x1, y + 34, x2 - x1, 1);
);
// a value pill (the house hover value)
function rg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(0x0A0D10); gfx_rect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 4 * sc);
  ui_col(RG_ICE); gfx_rect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, 1 * sc);
  ui_col(0xFFFFFF); gfx_x = cx * sc - tw * 0.5; gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);
// the lit square key: a black bezel, a frosted cap that glows in its colour when lit
function rg_key(x, y, w, h, on, col, s) local(hov, hit) (
  hov = rg_in(x - 3, y - 3, w + 6, h + 6); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  rg_shadow(x - 3, y - 3, w + 6, h + 6, 3);
  ui_col(0x07090B); ui_rrect((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 3 * sc);
  on ? (
    ui_cola(col, 0.10); rg_r(x - 8, y - 8, w + 16, h + 16);
    ui_cola(col, 0.16); rg_r(x - 5, y - 5, w + 10, h + 10);
    ui_col(ui_mix(col, 0x000000, 0.25)); rg_r(x, y, w, h);
    ui_col(col); rg_r(x + 2, y + 2, w - 4, h - 4);
    ui_cola(0xFFFFFF, 0.28); rg_r(x + 6, y + 5, w - 12, h - 10);
  ) : (
    ui_col(ui_mix(col, 0x0B0D10, 0.84)); rg_r(x, y, w, h);
    ui_col(ui_mix(col, 0x0B0D10, 0.76)); rg_r(x + 2, y + 2, w - 4, h - 4);
  );
  // the vignette edge: darker towards the rim, more on the bottom and right
  ui_cola(0x000000, 0.12); rg_r(x, y + h - 3, w, 3); rg_r(x + w - 3, y, 3, h);
  ui_cola(0x000000, 0.08); rg_r(x, y, w, 2); rg_r(x, y, 2, h);
  hov ? ( ui_cola(0xFFFFFF, 0.08); rg_r(x, y, w, h); );
  strlen(s) ? ( gfx_setfont(12); ui_col(on ? 0x141414 : ui_mix(col, 0xD0D0D0, 0.5)); rg_tc(x + w * 0.5, y + h * 0.5 + 0.5, s); );
  hit;
);
// a round LED
function rg_led(cx, cy, r, lv, col) (
  ui_col(0x07090B); gfx_circle(cx * sc, cy * sc, (r + 1.5) * sc, 1, 1);
  lv > 0 ? (
    ui_cola(col, 0.22 * lv); gfx_circle(cx * sc, cy * sc, (r + 4.5) * sc, 1, 1);
    ui_col(ui_mix(ui_mix(col, 0x000000, 0.75), col, lv)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
    ui_cola(0xFFFFFF, 0.55 * lv); gfx_circle((cx - r * 0.3) * sc, (cy - r * 0.3) * sc, r * 0.32 * sc, 1, 1);
  ) : ( ui_col(ui_mix(col, 0x000000, 0.8)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
);
// the cased square lamp key (FAST): a lens in a black well, set in a raised grey casing lit from the top left;
// lit = the lens glows in its colour, paler in the middle, light spilling round the casing
function rg_lamp(x, y, s, on, col) local(hov, hit) (
  hov = rg_in(x - 6, y - 6, s + 12, s + 12); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  rg_shadow(x - 6, y - 6, s + 12, s + 12, 3);
  on ? ( ui_cola(col, 0.10); rg_r(x - 13, y - 13, s + 26, s + 26); ui_cola(col, 0.14); rg_r(x - 9, y - 9, s + 18, s + 18); );
  ui_col(0x4A545F); ui_rrect((x - 6) * sc, (y - 6) * sc, (s + 12) * sc, (s + 12) * sc, 2.5 * sc);
  ui_cola(0xFFFFFF, 0.20); rg_r(x - 5, y - 6, s + 10, 1.5); rg_r(x - 6, y - 5, 1.5, s + 10);
  ui_cola(0x000000, 0.35); rg_r(x - 5, y + s + 4.5, s + 10, 1.5); rg_r(x + s + 4.5, y - 5, 1.5, s + 10);
  ui_col(0x07090B); rg_r(x - 2, y - 2, s + 4, s + 4);
  on ? (
    ui_col(col); rg_r(x, y, s, s);
    ui_cola(0xFFE6D8, 0.38); rg_r(x + 5, y + 5, s - 10, s - 10);
    ui_cola(0xFFFFFF, 0.30); rg_r(x + 2, y + 2, s - 4, 1.5);
  ) : (
    ui_col(ui_mix(col, 0x101214, 0.70)); rg_r(x, y, s, s);
    ui_cola(0xFFFFFF, 0.06); rg_r(x + 2, y + 2, s - 4, s - 4);
    ui_cola(0x000000, 0.30); rg_r(x, y, s, 3); rg_r(x, y + 3, 3, s - 3);   // the casing's shadow inside: top and left
  );
  hov ? ( ui_cola(0xFFFFFF, 0.08); rg_r(x, y, s, s); );
  hit;
);
// the glowing knob: a dark track, the value ring lit in its colour, a halo that grows with it; the name above it,
// the end figures below. stp > 0: the value moves in steps. Values show on hover / drag.
function rg_knob(cx, cy, r, idx, lo, hi, def, col, bip, name, n0, n1, stp) local(v, n, dx, dy, hov, did, i, a, ca, sa, k) (
  did = 5000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 8) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - rg_lt < 0.35 && rg_lid == idx && !rg_mv) || (mouse_cap & 4) ? ( rg_set(idx, def); drag_id = -1; rg_lt = 0; ) : (
      drag_id = did; rg_ky = mouse_y; rg_ky0 = mouse_y; rg_mv = 0; rg_lt = time_precise(); rg_lid = idx;
      rg_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !rg_mv && abs(mouse_y - rg_ky0) > 3 * sc ? ( rg_mv = 1; rg_ky = mouse_y; );
  drag_id == did && rg_mv ? (
    rg_kn = min(max(rg_kn + (rg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 200) * sc), 0), 1); rg_ky = mouse_y;
    v = lo + rg_kn * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    rg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 && stp / (hi - lo) > 0.02 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.03)), 0), 1);
    v = lo + n * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    rg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  gfx_setfont(11); ui_col(RG_INK); rg_tc(cx, cy - r - 30, name);
  gfx_setfont(13); ui_cola(RG_INK, 0.8);
  k = r + 24; a = -0.75 * $pi; rg_tc(cx + sin(a) * k, cy - cos(a) * k + 6, n0);
  a = 0.75 * $pi; rg_tc(cx + sin(a) * k, cy - cos(a) * k + 6, n1);
  bip ? rg_tc(cx, cy - r - 13, rg_k0); rg_k0 = "0";
  a = -0.75 * $pi + n * 1.5 * $pi;
  k = bip ? abs(n - 0.5) * 2 : n;
  ui_cola(col, 0.08 + 0.20 * k); gfx_circle(cx * sc, cy * sc, (r + 13) * sc, 1, 1);
  ui_cola(col, 0.08 + 0.18 * k); gfx_circle(cx * sc, cy * sc, (r + 9) * sc, 1, 1);
  ui_col(0x080A0C); ui_ssarc(cx * sc, cy * sc, (r + 5) * sc, -0.75 * $pi, 0.75 * $pi, 6 * sc);
  ui_col(ui_mix(col, 0x000000, 0.72)); ui_ssarc(cx * sc, cy * sc, (r + 5) * sc, -0.75 * $pi, 0.75 * $pi, 3 * sc);
  i = bip ? 0 : -0.75 * $pi;
  k > 0.005 ? (
    ui_cola(col, 0.35); ui_ssarc(cx * sc, cy * sc, (r + 5) * sc, min(i, a), max(i, a), 8 * sc);
    ui_col(col); ui_ssarc(cx * sc, cy * sc, (r + 5) * sc, min(i, a), max(i, a), 3.5 * sc);
    ui_cola(0xFFFFFF, 0.45); ui_ssarc(cx * sc, cy * sc, (r + 5) * sc, min(i, a), max(i, a), 1.2 * sc);
  );
  // the cap: drop shadow, dark body with a soft vignette edge, the lit pointer
  i = 0; loop(4, ui_cola(0x000000, 0.13); gfx_circle((cx + 2 + i * 1.33) * sc, (cy + 3 + i * 1.67) * sc, (r + i * 0.3) * sc, 1, 1); i += 1; );
  ui_col(0x323A44); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(0x151A20); gfx_circle(cx * sc, cy * sc, (r - 1.5) * sc, 1, 1);
  ui_col(0x1E242B); gfx_circle(cx * sc, cy * sc, r * 0.62 * sc, 1, 1);
  ca = sin(a); sa = -cos(a);
  ui_col(ui_mix(col, 0xFFFFFF, 0.35));
  ui_kdotc(cx * sc, cy * sc, ca, sa, (r - 1.5) * sc);   // dot pointer (JG, 31 Oct 2026)
  (hov || drag_id == did) ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1); );
  rg_act = hov || drag_id == did;
);

RG_PAS = 200100;                                          // the pairs' pastels (as SUM DR2)
RG_PAS[0] = 0xF59A9A; RG_PAS[1] = 0xF7BE84; RG_PAS[2] = 0xEFE07E; RG_PAS[3] = 0x9EDB8C;
RG_PAS[4] = 0x84D8CC; RG_PAS[5] = 0x8FB8F2; RG_PAS[6] = 0xB79CF0; RG_PAS[7] = 0x6F86E6;

// ---------- the faceplate: slate, light from the top left, a narrow darker bottom / right edge, corner rivets ----------
ui_col(0x0E1216); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(RG_FACE); rg_r(0, 0, 1280, 776);
gfx_gradrect(0, 0, 1280 * sc, 200 * sc, 1, 1, 1, 0.04, 0, 0, 0, 0, 0, 0, 0, -0.04 / (200 * sc));
ui_cola(0x000000, 0.35); rg_r(0, 772, 1280, 4); rg_r(1276, 0, 4, 772);
ui_cola(0xFFFFFF, 0.06); rg_r(0, 0, 1280, 1); rg_r(0, 0, 1, 776);
ui_screw(10 * sc, 10 * sc); ui_screw(1270 * sc, 10 * sc); ui_screw(10 * sc, 766 * sc); ui_screw(1270 * sc, 766 * sc);

// ---------- the header: the badge, the title, the preset bar, BYPASS, the size keys ----------
ui_col(RG_ICE); gfx_circle(40 * sc, 32 * sc, 16 * sc, 1, 1);
ui_col(RG_FACE); gfx_circle(40 * sc, 32 * sc, 14 * sc, 1, 1);
ui_col(RG_ICE); gfx_circle(40 * sc, 32 * sc, 12.5 * sc, 1, 1);
gfx_setfont(13); ui_col(0x13181D); rg_tc(40, 33, "GFX");
gfx_setfont(14); ui_col(RG_INK); gfx_measurestr("RON32", rg_tw, rg_th); gfx_x = 68 * sc; gfx_y = 32 * sc - rg_th * 0.5; gfx_drawstr("RON32");
gfx_setfont(13); ui_col(RG_DIM); gfx_x = 68 * sc + rg_tw + 16 * sc; gfx_y = 26 * sc; gfx_drawstr("32-CHANNEL UNMASKING SUMMING MIXER"); ver_tag_at("v3", 16, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
rg_k = pk_preset(470 * sc, 15 * sc, 330 * sc, 34 * sc, pr_cur, #rn_pm);
// BANK: which eight pairs the strips and the ROOM MAP show
rg_key(820, 19, 72, 28, rg_bk == 0, RG_ICE, "1-16") ? rg_bk = 0;
rg_key(902, 19, 72, 28, rg_bk == 1, RG_ICE, "17-32") ? rg_bk = 1;
rg_k > 0 ? prs_dirty = rg_k;
by_key3(990, 18, 23, 16);                               // BYPASS: the house key (its top lights amber)
os_key(1130, 21, 47, RG_INK, 20);                       // OS: TONE's saturation
ui_size_picker(1180 * sc, 23 * sc);
ui_cola(0x000000, 0.5); rg_r(16, 64, 1248, 2); ui_cola(RG_ICE, 0.45); rg_r(16, 66, 1248, 1);

// a pair's NAME box: a dark recessed display, light text; click to type, Enter / click elsewhere keeps it, Esc drops it
// (the names live in UI_NM + i, typed through ui_name_keys, saved in @serialize)
function rg_name(x, y, w, h, i, col, cp) local(inb, ed, tw, th, fs) (
  inb = rg_in(x, y, w, h);
  pressed && inb && drag_id == 0 ? (
    ui_nm_ed >= 0 && ui_nm_ed != i ? strcpy(UI_NM + ui_nm_ed, #ui_nmed);   // switching boxes keeps the last one
    ui_nm_ed != i ? ( ui_nm_ed = i; strcpy(#ui_nmed, UI_NM + i); );
    drag_id = -1;
  );
  ed = ui_nm_ed == i; ed && inb ? ui_nm_hit = 1;
  ui_col(0x0B0F13); ui_rrect(x * sc, y * sc, w * sc, h * sc, 3 * sc);
  ui_cola(0x000000, 0.45); rg_r(x + 1, y + 1, w - 2, 2); rg_r(x + 1, y + 1, 2, h - 2);   // recessed: top and left
  ed ? ( ui_cola(col, 0.9); rg_r(x, y, w, 1.5); rg_r(x, y + h - 1.5, w, 1.5); rg_r(x, y, 1.5, h); rg_r(x + w - 1.5, y, 1.5, h); ) : inb ? ( ui_cola(0xFFFFFF, 0.06); rg_r(x, y, w, h); );
  ed ? strcpy(#rg_nm, #ui_nmed) : cp ? strcpy(#rg_nm, "COPY OF 1-2") : strlen(UI_NM + i) ? strcpy(#rg_nm, UI_NM + i) : strcpy(#rg_nm, "NAME");
  gfx_setfont(12); gfx_measurestr(#rg_nm, tw, th);
  tw > (w - 12) * sc ? ( fs = rg_f12 * (w - 12) * sc / tw; gfx_setfont(19, "Trebuchet MS", fs, 'b'); gfx_measurestr(#rg_nm, tw, th); );
  cp && !ed ? ui_col(RG_AMB) : !ed && !strlen(UI_NM + i) ? ui_cola(RG_DIM, 0.55) : ui_col(ui_mix(col, 0xFFFFFF, 0.55));
  gfx_x = (x + w * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5) * sc - th * 0.5; gfx_drawstr(#rg_nm);
  ed && floor(time_precise() * 2) % 2 ? ( ui_col(0xFFFFFF); gfx_rect((x + w * 0.5) * sc + tw * 0.5 + 1, (y + 5) * sc, max(1, sc), (h - 10) * sc); );
);

// ---------- row 1: the channels - the NAME, SIGNAL PRESENT, FRONT / MID / BACK, MONO, SOLO / MUTE, NUDGE ----------
rg_c = 0; rg_ncp = 0; rg_p = 0; loop(RN_NP, rg_ncp += M_CP[rg_p] > 0; rg_p += 1; );
loop(8,
  rg_p = rg_bk * 8 + rg_c;                                 // the pair (RON32: the bank's)
  rg_x = 22 + rg_c * 156; rg_cx = rg_x + 72; rg_col = RG_PAS[rg_c]; rg_cp = M_CP[rg_p] > 0;
  rg_shadow(rg_x, 80, 144, 242, 8);
  ui_col(rg_cp ? RG_AMB : rg_col); ui_rrect(rg_x * sc, 80 * sc, 144 * sc, 242 * sc, 8 * sc);
  ui_col(RG_PLT); ui_rrect((rg_x + 2) * sc, 82 * sc, 140 * sc, 238 * sc, 6.5 * sc);
  ui_cola(rg_col, 0.05); ui_rrect((rg_x + 2) * sc, 82 * sc, 140 * sc, 238 * sc, 6.5 * sc);
  gfx_setfont(15); ui_col(rg_col); sprintf(#rg_s, "%d-%d", 2 * rg_p + 1, 2 * rg_p + 2); rg_tc(rg_x + 34, 100, #rg_s);
  rg_led(rg_x + 92, 100, 5, M_PKD[2 * rg_p] > 0.00316 ? min(1, 0.55 + 0.45 * min(M_PKD[2 * rg_p] / 0.1, 1)) : 0, RG_SIG);
  rg_led(rg_x + 116, 100, 5, M_PKD[2 * rg_p + 1] > 0.00316 ? min(1, 0.55 + 0.45 * min(M_PKD[2 * rg_p + 1] / 0.1, 1)) : 0, RG_SIG);
  rg_name(rg_x + 10, 116, 124, 26, rg_p, rg_col, rg_cp);
  rg_pl = floor(slider(S_PL + rg_p) + 0.5);
  // PLACE: one key, each click FRONT -> MID -> BACK -> FRONT; lit brightest at FRONT, dimmest at BACK (JG, 29 Oct 2026)
  rg_key(rg_x + 22, 156, 100, 30, 1, ui_mix(rg_col, 0x1A1E24, rg_pl == 0 ? 0 : rg_pl == 1 ? 0.38 : 0.62),
         rg_pl == 0 ? "FRONT" : rg_pl == 1 ? "MID" : "BACK") ? rg_set(S_PL + rg_p, rg_pl >= 2 ? 0 : rg_pl + 1);
  rg_key(rg_x + 22, 198, 100, 30, slider(S_MO + rg_p) >= 0.5, rg_col, "MONO") ? rg_set(S_MO + rg_p, slider(S_MO + rg_p) >= 0.5 ? 0 : 1);
  // SOLO (hear the pair as it sits in the mix: RON32 still listens to all of them) and MUTE (out of the mix and the listening)
  rg_key(rg_x + 22, 240, 46, 28, slider(S_SO + rg_p) >= 0.5, 0xFFE08A, "SOLO") ? rg_set(S_SO + rg_p, slider(S_SO + rg_p) >= 0.5 ? 0 : 1);
  rg_key(rg_x + 76, 240, 46, 28, slider(S_MU + rg_p) >= 0.5, 0xFF8A5E, "MUTE") ? rg_set(S_MU + rg_p, slider(S_MU + rg_p) >= 0.5 ? 0 : 1);
  // NUDGE: - = 3 ms earlier, + = 3 ms later (-30 .. +30 ms); the readout says NUDGE at 0 (double-click or CTRL-click = 0)
  rg_nu = slider(S_NU + rg_p);
  rg_key(rg_x + 14, 282, 26, 28, 0, rg_col, "") ? rg_set(S_NU + rg_p, max(rg_nu - 3, -30));
  rg_key(rg_x + 104, 282, 26, 28, 0, rg_col, "") ? rg_set(S_NU + rg_p, min(rg_nu + 3, 30));
  ui_col(ui_mix(rg_col, 0xD0D0D0, 0.5)); rg_r(rg_x + 22, 295, 10, 2.5); rg_r(rg_x + 112, 295, 10, 2.5); rg_r(rg_x + 115.75, 291.25, 2.5, 10);
  ui_col(0x0B0F13); ui_rrect((rg_x + 44) * sc, 282 * sc, 56 * sc, 28 * sc, 3 * sc);
  ui_cola(0x000000, 0.45); rg_r(rg_x + 45, 283, 54, 2); rg_r(rg_x + 45, 283, 2, 26);
  pressed && rg_in(rg_x + 44, 282, 56, 28) && drag_id == 0 ? (
    (time_precise() - rg_nlt < 0.35 && rg_nlp == rg_p) || (mouse_cap & 4) ? ( rg_set(S_NU + rg_p, 0); rg_nlt = 0; ) : ( rg_nlt = time_precise(); rg_nlp = rg_p; );
    drag_id = -1;
  );
  rg_nu = slider(S_NU + rg_p);
  rg_nu == 0 ? ( gfx_setfont(13); ui_cola(RG_DIM, 0.75); rg_tc(rg_x + 72, 296, "NUDGE"); ) : (
    sprintf(#rg_s, "%+d ms", rg_nu); gfx_setfont(12); ui_col(ui_mix(rg_col, 0xFFFFFF, 0.55)); rg_tc(rg_x + 72, 296, #rg_s); );
  rg_c += 1;
);

// ---------- row 2, left: the ROOM MAP ----------
rg_y2 = 338;
rg_shadow(22, rg_y2, 632, 222, 6);
ui_col(RG_INS); ui_rrect(22 * sc, rg_y2 * sc, 632 * sc, 222 * sc, 6 * sc);
ui_cola(0x000000, 0.35); rg_r(24, rg_y2 + 2, 628, 3); rg_r(24, rg_y2 + 2, 3, 218);        // recessed: shaded top and left
gfx_setfont(15); ui_col(RG_ICE); gfx_x = 38 * sc; gfx_y = (rg_y2 + 20) * sc - gfx_texth * 0.5; gfx_drawstr("ROOM MAP");
gfx_setfont(13); gfx_x = 150 * sc; gfx_y = (rg_y2 + 20) * sc - gfx_texth * 0.5;
rg_ncp > 0 ? ( ui_col(RG_AMB); gfx_drawstr("COPIES OF 1-2 LEFT OUT: RESET THE PIN CONNECTOR") ) : ( ui_col(RG_DIM);
gfx_drawstr(rn_dl > 0.5 ? "DELTA: HEARING WHAT IS TAKEN OUT" : "LIT = LEVEL   MARK = HOME BAND   BAR = MAKING ROOM"); );
rg_b = 0;
loop(6,
  rg_y = rg_y2 + 46 + (5 - rg_b) * 26;                           // 11 kHz at the top, 110 Hz at the bottom
  gfx_setfont(13); ui_col(RG_DIM);
  rg_b == 0 ? strcpy(#rg_s, "110") : rg_b == 1 ? strcpy(#rg_s, "330") : rg_b == 2 ? strcpy(#rg_s, "990") :
  rg_b == 3 ? strcpy(#rg_s, "2.2k") : rg_b == 4 ? strcpy(#rg_s, "5.5k") : strcpy(#rg_s, "11k");
  gfx_measurestr(#rg_s, rg_tw, rg_th); gfx_x = 82 * sc - rg_tw; gfx_y = (rg_y + 11) * sc - rg_th * 0.5; gfx_drawstr(#rg_s);
  rg_c = 0;
  loop(8,
    rg_x = 94 + rg_c * 69; rg_p = rg_bk * 8 + rg_c; rg_k = rg_p * 6 + rg_b; rg_col = RG_PAS[rg_c];
    rg_lv = M_DSA[rg_k]; rg_cut = M_DSC[rg_k]; rg_dk = M_DSK[rg_k];
    // the cell: dark glass, lit by the pair's level in the band, dimmed by its cut
    ui_col(0x0B0F13); rg_r(rg_x, rg_y, 62, 22);
    rg_lv > 0 ? ( ui_cola(rg_col, (0.12 + 0.78 * rg_lv) * (1 - 0.14 * min(rg_cut + rg_dk, 4))); rg_r(rg_x + 1, rg_y + 1, 60, 20); );
    ui_cola(0xFFFFFF, 0.06); rg_r(rg_x + 1, rg_y + 1, 60, 1);
    // the home band's mark
    M_DSH[rg_p] == rg_b && rg_lv > 0.05 ? ( ui_col(0xFFFFFF); gfx_circle((rg_x + 8) * sc, (rg_y + 11) * sc, 3 * sc, 1, 1); );
    // making room: the cut as a dark bar from the right (4 dB = the whole cell), the transient dip as a white flick
    rg_cut > 0.05 ? ( ui_cola(0x05070A, 0.85); rg_r(rg_x + 61 - 44 * min(rg_cut / 4, 1), rg_y + 14, 44 * min(rg_cut / 4, 1), 5);
                      ui_cola(RG_ICE, 0.9); rg_r(rg_x + 61 - 44 * min(rg_cut / 4, 1), rg_y + 14, 2, 5); );
    rg_dk > 0.05 ? ( ui_cola(0xFFFFFF, min(rg_dk / 2.5, 1) * 0.7); rg_r(rg_x + 1, rg_y + 1, 60, 4); );
    rg_c += 1;
  );
  rg_b += 1;
);
// the columns' names (the pair's own name when it has one), fitted to the column
rg_c = 0;
loop(8,
  rg_p = rg_bk * 8 + rg_c;
  M_CP[rg_p] > 0 ? strcpy(#rg_s, "COPY") : strlen(UI_NM + rg_p) ? strcpy(#rg_s, UI_NM + rg_p) : sprintf(#rg_s, "%d-%d", 2 * rg_p + 1, 2 * rg_p + 2);
  gfx_setfont(13); gfx_measurestr(#rg_s, rg_tw, rg_th);
  loop(16, rg_tw > 64 * sc && strlen(#rg_s) > 1 ? ( strcpy_substr(#rg_s, #rg_s, 0, strlen(#rg_s) - 1); gfx_measurestr(#rg_s, rg_tw, rg_th); ); );
  ui_col(M_CP[rg_p] > 0 ? RG_AMB : RG_PAS[rg_c]); rg_tc(94 + rg_c * 69 + 31, rg_y2 + 208, #rg_s);
  rg_c += 1;
);

// ---------- row 2, right: MAKE ROOM - UNMASK, TRANSIENT, DEPTH, FOCUS (glowing dials, 0 = out) ----------
rg_ttl(676, 1258, rg_y2, "MAKE ROOM");
rg_cy = rg_y2 + 132;
rg_knob(748, rg_cy, 28, 1, 0, 100, 50, 0x8FD0F4, 0, "UNMASK", "0", "10", 1);
rg_act ? ( sprintf(#rg_s, "%.0f%%", slider1); rg_pill(748, rg_cy + 42, #rg_s); );
// FAST (UNMASK's release): a square red lamp key in its casing, its name printed on the panel to the right (JG)
gfx_setfont(11); ui_col(RG_INK); gfx_measurestr("FAST", rg_tw, rg_th); gfx_x = 752 * sc; gfx_y = (rg_cy + 80) * sc - rg_th * 0.5; gfx_drawstr("FAST");
rg_lamp(714, rg_cy + 68, 24, slider(S_FR) >= 0.5, 0xFF3A2A) ? rg_set(S_FR, slider(S_FR) >= 0.5 ? 0 : 1);
rg_knob(893, rg_cy, 28, 2, 0, 100, 30, 0xF4D27A, 0, "TRANSIENT", "0", "10", 1);
rg_act ? ( sprintf(#rg_s, "%.0f%%", slider2); rg_pill(893, rg_cy + 42, #rg_s); );
rg_knob(1038, rg_cy, 28, 3, 0, 100, 50, 0xB8A2F2, 0, "DEPTH", "0", "10", 1);
rg_act ? ( sprintf(#rg_s, "%.0f%%", slider3); rg_pill(1038, rg_cy + 42, #rg_s); );
rg_k0 = "";
rg_knob(1183, rg_cy, 28, 24, -100, 100, 0, 0x8FE8C8, 1, "FOCUS", "MID", "WIDE", 1);
rg_act ? ( slider24 < 0 ? sprintf(#rg_s, "MID %.0f%%", -slider24) : slider24 > 0 ? sprintf(#rg_s, "WIDE %.0f%%", slider24) : strcpy(#rg_s, "0");
           rg_pill(1183, rg_cy + 42, #rg_s); );

// ---------- row 3, left: TONE - LOW / HIGH lift and the DIPs (in the spirit of SIFON's, clean) ----------
rg_y3 = 588; rg_k3 = rg_y3 + 62; rg_cy = rg_y3 + 104;
rg_ttl(22, 654, rg_y3, "TONE");
rg_lo = slider25 >= 0.5; rg_hi = slider27 >= 0.5;
rg_key(74, rg_k3, 84, 30, rg_lo, 0x8EC6F0, "LOW") ? rg_set(25, rg_lo ? 0 : 1);
rg_key(390, rg_k3, 84, 30, rg_hi, 0xEC7A6E, "HIGH") ? rg_set(27, rg_hi ? 0 : 1);
// each DIP key works on its own band: dimmed (and inert) while that band is off
rg_k = rg_key(74, rg_k3 + 48, 84, 30, slider29 >= 0.5 && rg_lo, 0x8FE0A0, "DIP 220");
rg_k && rg_lo ? rg_set(29, slider29 >= 0.5 ? 0 : 1);
!rg_lo ? ( ui_cola(RG_FACE, 0.55); rg_r(66, rg_k3 + 40, 100, 46); );
rg_k = rg_key(390, rg_k3 + 48, 84, 30, slider30 >= 0.5 && rg_hi, RG_AMB, "DIP 3K");
rg_k && rg_hi ? rg_set(30, slider30 >= 0.5 ? 0 : 1);
!rg_hi ? ( ui_cola(RG_FACE, 0.55); rg_r(382, rg_k3 + 40, 100, 46); );
rg_knob(240, rg_cy, 22, 26, 0, 100, 30, 0x8EC6F0, 0, "TEXTURE", "0", "10", 1);
rg_act ? ( sprintf(#rg_s, "%.0f%%", slider26); rg_pill(240, rg_cy + 36, #rg_s); );
!rg_lo ? ( ui_cola(RG_FACE, 0.5); rg_r(190, rg_y3 + 44, 100, 124); );
rg_knob(556, rg_cy, 22, 28, 0, 100, 30, 0xEC7A6E, 0, "TEXTURE", "0", "10", 1);
rg_act ? ( sprintf(#rg_s, "%.0f%%", slider28); rg_pill(556, rg_cy + 36, #rg_s); );
!rg_hi ? ( ui_cola(RG_FACE, 0.5); rg_r(506, rg_y3 + 44, 100, 124); );
ui_cola(RG_DIM, 0.3); rg_r(338, rg_y3 + 52, 1, 110);

// ---------- row 3, right: OUTPUT - MATCH, DELTA, the L / R meter, LEVEL TRIM ----------
// the divider between TONE and OUTPUT: an engraved line (dark, light beside it)
ui_cola(0x000000, 0.45); rg_r(664, rg_y3 + 6, 2, 168); ui_cola(RG_DIM, 0.35); rg_r(666, rg_y3 + 6, 1, 168);
rg_ttl(676, 1258, rg_y3, "OUTPUT");
rg_key(694, rg_k3, 84, 30, slider5 >= 0.5, 0x8FE0A0, "MATCH") ? rg_set(5, slider5 >= 0.5 ? 0 : 1);
rg_key(694, rg_k3 + 48, 84, 30, slider6 >= 0.5, RG_AMB, "DELTA") ? rg_set(6, slider6 >= 0.5 ? 0 : 1);
// the peaks since the last frame, held 1.2 s then falling 0.6 dB a frame; the bar falls about 26 dB / s
rg_pl = rn_opl_d; rg_pr = rn_opr_d; dv_ack_d += 1;
rg_dt = max(time_precise() - rg_mt, 0); rg_mt = time_precise(); rg_dt > 0.5 ? rg_dt = 0.5;
rg_ml = max(rg_pl > 0.00001 ? 20 * log10(rg_pl) : -120, rg_ml - 26 * rg_dt);
rg_mr = max(rg_pr > 0.00001 ? 20 * log10(rg_pr) : -120, rg_mr - 26 * rg_dt);
rg_ml >= rg_hl ? ( rg_hl = rg_ml; rg_htl = time_precise(); ) : time_precise() - rg_htl > 1.2 ? rg_hl -= 0.6;
rg_mr >= rg_hr ? ( rg_hr = rg_mr; rg_htr = time_precise(); ) : time_precise() - rg_htr > 1.2 ? rg_hr -= 0.6;
pressed && rg_in(806, rg_k3 - 8, 260, 84) ? ( rg_hl = rg_ml; rg_hr = rg_mr; drag_id = -1; );   // click clears the holds
rg_i = 0;
loop(16,
  rg_db = -42 + 3 * rg_i; rg_lx = 846 + rg_i * 14;
  rg_lc = RG_PAS[7 - floor(rg_i / 2)];
  rg_led(rg_lx, rg_k3 + 12, 4, rg_ml >= rg_db || (rg_hl >= rg_db && rg_hl < rg_db + 3) ? 1 : 0, rg_lc);
  rg_led(rg_lx, rg_k3 + 36, 4, rg_mr >= rg_db || (rg_hr >= rg_db && rg_hr < rg_db + 3) ? 1 : 0, rg_lc);
  rg_i += 1;
);
gfx_setfont(13); ui_col(RG_DIM); rg_tc(826, rg_k3 + 12, "L"); rg_tc(826, rg_k3 + 36, "R");
rg_tc(846, rg_k3 + 60, "-42"); rg_tc(846 + 14 * 14, rg_k3 + 60, "0");
rg_knob(1180, rg_cy, 22, 4, -3, 3, 0, 0x3CDC6A, 1, "TRIM", "-3", "+3", 0.5);
rg_act ? ( sprintf(#rg_s, "%+.1f dB", slider4); rg_pill(1180, rg_cy + 36, #rg_s); );

// typing into the open name box (as ui_name_keys), plus TAB to the next pair's name (SHIFT+TAB: the one before)
function rg_name_keys() local(c, n) (
  ui_nm_ed >= 0 ? (
    loop(32,
      c = gfx_getchar();
      c > 0 && ui_nm_ed >= 0 ? (
        c == 13 ? ( strcpy(UI_NM + ui_nm_ed, #ui_nmed); ui_nm_ed = -1; ) :
        c == 27 ? ui_nm_ed = -1 :
        c == 9 ? ( strcpy(UI_NM + ui_nm_ed, #ui_nmed); ui_nm_ed = (ui_nm_ed + ((mouse_cap & 8) ? RN_NP - 1 : 1)) % RN_NP; rg_bk = floor(ui_nm_ed / 8); strcpy(#ui_nmed, UI_NM + ui_nm_ed); ) :
        c == 8 ? ( n = strlen(#ui_nmed); n > 0 ? strcpy_substr(#ui_nmed, #ui_nmed, 0, n - 1); ) :
        c >= 32 && c < 127 && strlen(#ui_nmed) < 16 ? ( sprintf(#ui_nmc, "%c", c); strcat(#ui_nmed, #ui_nmc); );
      );
    );
    pressed && !ui_nm_hit && ui_nm_ed >= 0 ? ( strcpy(UI_NM + ui_nm_ed, #ui_nmed); ui_nm_ed = -1; );
  );
  ui_nm_hit = 0;
);
pk_end();
// the ? pop-up (ui_end, opened out): credits and links, then MAINS / EQUATOR PROXIMITY under them
ui_help_xh = 192;
rg_name_keys(); ui_help();
ui_help_open ? ( mouse_x = ui_mx; mouse_y = ui_my;  pwr_panel(ui_help_cx + 30 * ui_help_s, ui_help_cy + 118 * ui_help_s, ui_help_s, 17, ui_help_clk, ui_mw); );
prev_down = mdown; mouse_wheel = 0;
