desc:Sum 74 [summing mixer] (GFX)
//tags: summing mixer outside broadcast ob truck broadcast desk transformer console bus stems series74
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel and gfx-s74 (.jsfx-inc) in the same folder.
//
// SUM 74 (Series 74: the OB remote and broadcast series): the summing mixer of the series - the sound desk of a
// 1970s outside-broadcast truck, with two models on one switch.
//
// SET-UP (REAPER), as SUM 92's MODEL 12: the bus track needs 12 channels. Send the stems to the channels below and turn
// off the stem tracks' master / parent send. The mix always leaves on 1/2; outputs 3 - 12 are silenced.
//   1, 2, 3, 4          MONO channels (send to one channel each): PAN (constant loudness: centre = unity, +3 dB at
//                       the sides)
//   5/6, 7/8, 9/10, 11/12  STEREO pairs: BALANCE (centre = both sides at full level)
//   Every channel: a FADER (-60 dB = off .. +10 dB), PAN / BAL, MUTE, SOLO, a signal lamp (amber; red within 3 dB of
//   full scale) and its name (click the name and type; Enter keeps it, Escape cancels). Names are saved.
// THE MODELS:
//   OB     the truck: transformer-coupled and ballsy. Every channel comes in through its input transformer (the
//          lows saturate first), the summing amp is an asymmetric discrete stage that thickens as it is pushed, and
//          the mix leaves through the output transformer. A little noisy with NOISE on: hiss and a trace of the
//          generator's 50 Hz buzz.
//   CLEAN  the light-grey broadcast desk of the late 70s: IC summing amps, electronically balanced, no iron - clean
//          until the rails, where it rounds off evenly; a low hiss with NOISE on. (IRON has no effect: its caption
//          greys out.)
//   Level matched at the default settings; switching fades out and back in.
// THE BUS:
//   DRIVE   (0 - 18 dB) how hard the mix drives the summing amp - more DRIVE, more colour, the same level (matched).
//   IRON    (0 - 100 %, OB) the input and output transformers.
//   NOISE   the desk's floor (OB about -80 dBFS with the buzz, CLEAN about -94 dBFS).
//   WANDER  (0 - 100 %, 50 % = standard) OB: the summing amp's bias and the iron drift a little, and the two sides
//           never quite match; CLEAN: only a trace remains.
//   MASTER  the master fader (-60 dB = off .. +10 dB). Two edgewise VU meters read the output (0 VU = -18 dBFS).
// At the minimum (DRIVE 0, IRON 0, NOISE off, WANDER 0) with every channel at 0 dB both models are close to a wire.
// The bus runs at 2x (linear-phase half-bands); latency 31 samples, reported.
// OUTPUT: the house CLIP at -0.3 dBFS, always on, no controls (as SUM 92). Below about -2 dBFS it does nothing.
// PRESETS: the house preset bar. The presets set the model and the bus (DRIVE, IRON, NOISE, WANDER) and leave the
//   channels alone, except "Flat all channels" (every channel to 0 dB, centre, no mute or solo). "Reset all to
//   defaults" (in the list) resets everything (the names are kept).
// GUI: drag a knob or a fader (SHIFT = fine, double-click = default, wheel); click a lens; click the LCD (or PRESETS)
//   for the preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s74.jsfx-inc

slider1:0<0,1,1{OB,Clean}>-Model
slider2:0<-60,10,0.1>-Ch 1 level (dB)
slider3:0<-60,10,0.1>-Ch 2 level (dB)
slider4:0<-60,10,0.1>-Ch 3 level (dB)
slider5:0<-60,10,0.1>-Ch 4 level (dB)
slider6:0<-60,10,0.1>-Ch 5-6 level (dB)
slider7:0<-60,10,0.1>-Ch 7-8 level (dB)
slider8:0<-60,10,0.1>-Ch 9-10 level (dB)
slider9:0<-60,10,0.1>-Ch 11-12 level (dB)
slider10:0<-100,100,1>-Ch 1 pan
slider11:0<-100,100,1>-Ch 2 pan
slider12:0<-100,100,1>-Ch 3 pan
slider13:0<-100,100,1>-Ch 4 pan
slider14:0<-100,100,1>-Ch 5-6 balance
slider15:0<-100,100,1>-Ch 7-8 balance
slider16:0<-100,100,1>-Ch 9-10 balance
slider17:0<-100,100,1>-Ch 11-12 balance
slider18:0<0,1,1{Off,On}>-Ch 1 mute
slider19:0<0,1,1{Off,On}>-Ch 2 mute
slider20:0<0,1,1{Off,On}>-Ch 3 mute
slider21:0<0,1,1{Off,On}>-Ch 4 mute
slider22:0<0,1,1{Off,On}>-Ch 5-6 mute
slider23:0<0,1,1{Off,On}>-Ch 7-8 mute
slider24:0<0,1,1{Off,On}>-Ch 9-10 mute
slider25:0<0,1,1{Off,On}>-Ch 11-12 mute
slider26:0<0,1,1{Off,On}>-Ch 1 solo
slider27:0<0,1,1{Off,On}>-Ch 2 solo
slider28:0<0,1,1{Off,On}>-Ch 3 solo
slider29:0<0,1,1{Off,On}>-Ch 4 solo
slider30:0<0,1,1{Off,On}>-Ch 5-6 solo
slider31:0<0,1,1{Off,On}>-Ch 7-8 solo
slider32:0<0,1,1{Off,On}>-Ch 9-10 solo
slider33:0<0,1,1{Off,On}>-Ch 11-12 solo
slider34:6<0,18,0.1>-Drive (dB)
slider35:40<0,100,1>-Iron (%, OB)
slider36:0<0,1,1{Off,On}>-Noise
slider37:50<0,100,1>-Wander (%)
slider38:0<-60,10,0.1>-Master (dB)
slider39:prs_sel=0<0,12,1{No preset,Init,Clean Desk,OB Truck,Hot Truck,Heavy Iron,Stadium Feed,News Desk,Live Music Truck,Clean - Driven,Long Shift,Generator Buzz,Flat all channels}>-Preset

in_pin:ch 1
in_pin:ch 2
in_pin:ch 3
in_pin:ch 4
in_pin:ch 5
in_pin:ch 6
in_pin:ch 7
in_pin:ch 8
in_pin:ch 9
in_pin:ch 10
in_pin:ch 11
in_pin:ch 12
out_pin:mix L
out_pin:mix R

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0;
#ui_man = "gfx-sum-74";
ext_noinit = 1;
s74_mem = 0;
q4_HB = s74_alloc(64); s74_hbdesign(q4_HB, 63, 8);
q4uL.s74_upinit(63, q4_HB, 64); q4uR.s74_upinit(63, q4_HB, 64); q4dL.s74_dninit(63, q4_HB, 64); q4dR.s74_dninit(63, q4_HB, 64);
q4_LAT = 31;
q4_TL = s74_alloc(8); q4_TR = s74_alloc(8);             // the channels' target gains onto the bus (left, right)
q4_GL = s74_alloc(8); q4_GR = s74_alloc(8);             // ... and the gliding gains
q4_PK = s74_alloc(8);                                   // the channels' input peaks (audio side)
q4_PA = s74_alloc(8);                                   // ... handed to the panel in @block
q4_LH = s74_alloc(8);                                   // the panel's held lamp levels
q4_IL = s74_alloc(12);                                  // OB: the twelve input transformers' low-pass states

// the make-up's loudness correction (dB) at DRIVE 0 .. 18 in 3 dB steps (measured on pink noise at -21 dBFS)
function q4_mk(d) local(p, i, f, a, b) (
  p = min(max(d, 0), 18) / 3; i = min(floor(p), 5); f = p - i;
  q4_mod ? (
    a = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0 : 0.03;
    b = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0.03 : 0.30;
  ) : (
    a = i == 0 ? 0 : i == 1 ? 0.03 : i == 2 ? 0.07 : i == 3 ? 0.16 : i == 4 ? 0.33 : 0.65;
    b = i == 0 ? 0.03 : i == 1 ? 0.07 : i == 2 ? 0.16 : i == 3 ? 0.33 : i == 4 ? 0.65 : 1.19;
  );
  a + (b - a) * f;
);
// the model: OB (0) / CLEAN (1)
function q4_model() local(fs) (
  fs = 2 * srate;
  q4_K0 = 0.5;                          // the summing amp's drive at DRIVE 0
  q4_klo = s74_k(100, fs); q4_ig = 3; q4_khf = s74_k(26000, fs);   // the output transformer
  q4_kli = s74_k(90, srate); q4_igi = 2.6;              // the input transformers
  q4_mg = q4_mod ? 10 ^ (0 / 20) : 1;                   // the models' level match
  q4_HIS = 10 ^ ((q4_mod ? -82 : -68) / 20);            // NOISE: hiss (CLEAN about -94 dBFS, OB about -80 dBFS)
  q4_BUZ = q4_mod ? 0 : 10 ^ (-96 / 20);                // OB: the generator's 50 Hz buzz
  q4_R = 1 - 2 * $pi * 2.5 / fs;                        // the DC blocker after the summing amp (2.5 Hz)
);
function q4_update() local(i, any, on, lv, a, t, g) (
  any = 0; i = 0; loop(8, slider(26 + i) >= 0.5 ? any = 1; i += 1; );
  i = 0;
  loop(8,
    lv = slider(2 + i);
    on = slider(18 + i) < 0.5 && (!any || slider(26 + i) >= 0.5) && lv > -59.95;
    g = on ? 10 ^ (lv / 20) : 0;
    i < 4 ? (
      t = (slider(10 + i) / 100 + 1) * 0.25 * $pi;      // mono: constant loudness, centre = unity
      q4_TL[i] = g * cos(t) * sqrt(2); q4_TR[i] = g * sin(t) * sqrt(2);
    ) : (
      a = (slider(10 + i) + 100) / 200;                 // stereo: balance, centre = both sides at full level
      q4_TL[i] = g * min(1, 2 * (1 - a)); q4_TR[i] = g * min(1, 2 * a);
    );
    i += 1;
  );
  q4_tmod = slider1 >= 0.5;
  q4_tk = q4_K0 * 10 ^ (slider34 / 20);
  q4_tgm = 10 ^ (q4_mk(slider34) / 20) * q4_mg;
  q4_tir = q4_mod ? 0 : slider35 / 100;
  q4_tnz = slider36 >= 0.5;
  q4_tms = slider38 <= -59.95 ? 0 : 10 ^ (slider38 / 20);
  drift_macro(slider37);
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);               // the house CLIP at -0.3 dBFS, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = q4_LAT;
);
function q4_srinit() (
  q4_sr = srate;
  q4_sm = s74_kt(0.02, srate); q4_fd = 1 / (0.01 * srate); q4_vuc = s74_kt(0.3, srate);
  q4_model(); ost_init(0);
);

q4_mod = q4_tmod = slider1 >= 0.5;
q4_srinit(); q4_update();
q4_k = q4_tk; q4_gm = q4_tgm; q4_ir = q4_tir; q4_ms = q4_tms; q4_nz = q4_tnz;
q4_i = 0; loop(8, q4_GL[q4_i] = q4_TL[q4_i]; q4_GR[q4_i] = q4_TR[q4_i]; q4_i += 1; );
q4_dA.drift_init(0.8 + rand(0.4)); q4_dB.drift_init(0.8 + rand(0.4)); q4_dI.drift_init(0.6 + rand(0.4));
q4_sA = rand(2) - 1; q4_sB = rand(2) - 1;
q4_fade = 1; q4_fst = 0; q4_iw = 1;

// ---------- OB: one channel's input transformer (n = its state slot): the lows saturate first ----------
function q4_in(x, n) local(lo) (
  lo = q4_IL[n]; lo += (x - lo) * q4_kli; q4_IL[n] = lo;
  x + q4_ir * (s74_th(lo * q4_igi * q4_iw) / (q4_igi * q4_iw) - lo);
);
// ---------- the bus at 2x: the summing amp, the DC blocker, the output transformer (OB) ----------
function q4_stage(x) instance(db, b0, d0, dcx, dcy, lo, hf) local(u, y, b, t, a) (
  q4_mod ? (
    // CLEAN: the IC summing amp, linear until its rails, then an even, rounded limit
    u = x * q4_k; a = abs(u);
    y = (a < 0.7 ? u : sign(u) * (0.7 + 0.3 * s74_th((a - 0.7) / 0.3))) / q4_k * q4_gm;
  ) : (
    // OB: the discrete summing amp, asymmetric (it thickens as it is pushed); unity small-signal gain
    b = 0.15 + db;
    b != b0 ? ( b0 = b; d0 = (s74_th(b + 0.0005) - s74_th(b - 0.0005)) / 0.001; );
    y = (s74_th(x * q4_k + b) - s74_th(b)) / (q4_k * d0) * q4_gm;
    dcy = y - dcx + q4_R * dcy; dcx = y; y = dcy;
    lo += (y - lo) * q4_klo;                                  // the output transformer: the lows saturate first ...
    t = y - lo + s74_th(lo * q4_ig * q4_iw) / (q4_ig * q4_iw);
    hf += (t - hf) * q4_khf;                                  // ... and the top softens
    y += q4_ir * (hf - y);
  );
  y;
);

// ---------- presets: the model and the bus; the channels are left alone (except Flat all channels) ----------
function q4_set(m, d, ir, nz, w) (
  slider1 = m; slider34 = d; slider35 = ir; slider36 = nz; slider37 = w;
  ui_auto(1); ui_auto(34); ui_auto(35); ui_auto(36); ui_auto(37);
);
function q4_flat() local(i) (
  i = 0; loop(8, slider(2 + i) = 0; slider(10 + i) = 0; slider(18 + i) = 0; slider(26 + i) = 0; i += 1; );
  i = 2; loop(32, ui_auto(i); i += 1; );
);
#q4_pm = "Init|Clean Desk|OB Truck|Hot Truck|Heavy Iron|Stadium Feed|News Desk|Live Music Truck|Clean, Driven|Long Shift|Generator Buzz|Flat all channels";
function load_preset(p) (
  //               model drive iron noise wander
  p == 1  ? q4_set(0,  6,   40,  0,  50) :     // Init
  p == 2  ? q4_set(1,  0,   40,  0,   0) :     // Clean Desk
  p == 3  ? q4_set(0,  9,   55,  0,  50) :     // OB Truck
  p == 4  ? q4_set(0, 15,   60,  0,  60) :     // Hot Truck
  p == 5  ? q4_set(0,  6,   95,  0,  50) :     // Heavy Iron
  p == 6  ? q4_set(0, 12,   70,  1,  70) :     // Stadium Feed
  p == 7  ? q4_set(1,  4,   40,  1,  30) :     // News Desk
  p == 8  ? q4_set(0, 10,   50,  0,  40) :     // Live Music Truck
  p == 9  ? q4_set(1, 15,   40,  0,  50) :     // Clean, Driven
  p == 10 ? q4_set(0,  8,   45,  0, 100) :     // Long Shift
  p == 11 ? q4_set(0, 12,   80,  1,  90) :     // Generator Buzz
  p == 12 ? q4_flat() :                        // Flat all channels
  p == 13 ? (                                  // Reset all to defaults
    q4_set(0, 6, 40, 0, 50); q4_flat(); slider38 = 0; ui_auto(38);
  );
  pr_cur = p > 12 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
q4_update();

@block
prs_chk();
srate != q4_sr ? ( q4_srinit(); q4_update(); );
q4_update();
q4_tmod != q4_mod && q4_fst == 0 ? q4_fst = 1;
// WANDER: OB the summing amp's bias and the iron, CLEAN only a trace
q4_di = 0.1 * dm_s * samplesblock / srate; q4_wa = dm_a * (q4_mod ? 0.15 : 1);
q4sL.db = q4_wa * (0.03 * q4_dA.drift_tick(q4_di) + 0.012 * q4_sA); q4sR.db = q4_wa * (0.03 * q4_dB.drift_tick(q4_di) + 0.012 * q4_sB);
q4_iw = 1 + q4_wa * 0.12 * q4_dI.drift_tick(q4_di);
// the meters, handed to the panel
q4_bi = 0; loop(8, q4_PA[q4_bi] = max(q4_PA[q4_bi], q4_PK[q4_bi]); q4_PK[q4_bi] = 0; q4_bi += 1; );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
q4_n = 0; loop(8, file_avail(0) != 0 ? file_string(0, UI_NM + q4_n); q4_n += 1; );   // the channel names
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
q4_k += (q4_tk - q4_k) * q4_sm; q4_gm += (q4_tgm - q4_gm) * q4_sm; q4_ir += (q4_tir - q4_ir) * q4_sm;
q4_ms += (q4_tms - q4_ms) * q4_sm; q4_nz += (q4_tnz - q4_nz) * q4_sm;
// the model change: fade out, change at the silent point, wait for the half-bands to clear, fade back in
q4_fst == 1 ? ( q4_fade -= q4_fd; q4_fade <= 0 ? (
  q4_fade = 0; q4_mod = q4_tmod; q4_model(); q4_update(); q4_k = q4_tk; q4_gm = q4_tgm; q4_ir = q4_tir;
  q4sL.dcx = q4sL.dcy = q4sL.lo = q4sL.hf = 0; q4sR.dcx = q4sR.dcy = q4sR.lo = q4sR.hf = 0; memset(q4_IL, 0, 12);
  q4_hold = q4_LAT + 8; q4_fst = 2; ); ) :
q4_fst == 2 ? ( q4_hold -= 1; q4_hold <= 0 ? q4_fst = 3; ) :
q4_fst == 3 ? ( q4_fade += q4_fd; q4_fade >= 1 ? ( q4_fade = 1; q4_fst = 0; ); );

// ---------- the channels: (OB) the input transformers, then the faders and pans onto the bus ----------
q4_GL[0] += (q4_TL[0] - q4_GL[0]) * q4_sm; q4_GR[0] += (q4_TR[0] - q4_GR[0]) * q4_sm;
q4_GL[1] += (q4_TL[1] - q4_GL[1]) * q4_sm; q4_GR[1] += (q4_TR[1] - q4_GR[1]) * q4_sm;
q4_GL[2] += (q4_TL[2] - q4_GL[2]) * q4_sm; q4_GR[2] += (q4_TR[2] - q4_GR[2]) * q4_sm;
q4_GL[3] += (q4_TL[3] - q4_GL[3]) * q4_sm; q4_GR[3] += (q4_TR[3] - q4_GR[3]) * q4_sm;
q4_GL[4] += (q4_TL[4] - q4_GL[4]) * q4_sm; q4_GR[4] += (q4_TR[4] - q4_GR[4]) * q4_sm;
q4_GL[5] += (q4_TL[5] - q4_GL[5]) * q4_sm; q4_GR[5] += (q4_TR[5] - q4_GR[5]) * q4_sm;
q4_GL[6] += (q4_TL[6] - q4_GL[6]) * q4_sm; q4_GR[6] += (q4_TR[6] - q4_GR[6]) * q4_sm;
q4_GL[7] += (q4_TL[7] - q4_GL[7]) * q4_sm; q4_GR[7] += (q4_TR[7] - q4_GR[7]) * q4_sm;
q4_PK[0] = max(q4_PK[0], abs(spl0)); q4_PK[1] = max(q4_PK[1], abs(spl1));
q4_PK[2] = max(q4_PK[2], abs(spl2)); q4_PK[3] = max(q4_PK[3], abs(spl3));
q4_PK[4] = max(q4_PK[4], max(abs(spl4), abs(spl5))); q4_PK[5] = max(q4_PK[5], max(abs(spl6), abs(spl7)));
q4_PK[6] = max(q4_PK[6], max(abs(spl8), abs(spl9))); q4_PK[7] = max(q4_PK[7], max(abs(spl10), abs(spl11)));
q4_ir > 0.00001 ? (
  q4_x0 = q4_in(spl0, 0); q4_x1 = q4_in(spl1, 1); q4_x2 = q4_in(spl2, 2); q4_x3 = q4_in(spl3, 3);
  q4_x4 = q4_in(spl4, 4); q4_x5 = q4_in(spl5, 5); q4_x6 = q4_in(spl6, 6); q4_x7 = q4_in(spl7, 7);
  q4_x8 = q4_in(spl8, 8); q4_x9 = q4_in(spl9, 9); q4_x10 = q4_in(spl10, 10); q4_x11 = q4_in(spl11, 11);
) : (
  q4_x0 = spl0; q4_x1 = spl1; q4_x2 = spl2; q4_x3 = spl3; q4_x4 = spl4; q4_x5 = spl5;
  q4_x6 = spl6; q4_x7 = spl7; q4_x8 = spl8; q4_x9 = spl9; q4_x10 = spl10; q4_x11 = spl11;
);
q4_ml = q4_x0 * q4_GL[0] + q4_x1 * q4_GL[1] + q4_x2 * q4_GL[2] + q4_x3 * q4_GL[3] + q4_x4 * q4_GL[4] + q4_x6 * q4_GL[5] + q4_x8 * q4_GL[6] + q4_x10 * q4_GL[7];
q4_mr = q4_x0 * q4_GR[0] + q4_x1 * q4_GR[1] + q4_x2 * q4_GR[2] + q4_x3 * q4_GR[3] + q4_x5 * q4_GR[4] + q4_x7 * q4_GR[5] + q4_x9 * q4_GR[6] + q4_x11 * q4_GR[7];
// ---------- the desk's floor: hiss (OB also the generator's buzz) ----------
q4_nz > 0.00001 ? (
  q4_bz = 0;
  !q4_mod ? ( q4_hph += 50 / srate; q4_hph -= floor(q4_hph);
              q4_bz = (sin(2 * $pi * q4_hph) + 0.6 * sin(6 * $pi * q4_hph) + 0.4 * sin(10 * $pi * q4_hph) + 0.25 * sin(14 * $pi * q4_hph)) * q4_BUZ; );
  q4_ml += (q4pL.s74_pink() * q4_HIS + q4_bz) * q4_nz; q4_mr += (q4pR.s74_pink() * q4_HIS + q4_bz) * q4_nz;
);
// ---------- the summing amp and the output transformer, at 2x ----------
q4uL.s74_up(q4_ml); q4uR.s74_up(q4_mr);
q4_q0l = q4sL.q4_stage(q4uL.o0); q4_q0r = q4sR.q4_stage(q4uR.o0);
q4_q1l = q4sL.q4_stage(q4uL.o1); q4_q1r = q4sR.q4_stage(q4uR.o1);
q4_fg = q4_fade * q4_fade * (3 - 2 * q4_fade);         // the model fade, an S-curve
q4_yl = q4dL.s74_dn(q4_q0l, q4_q1l) * q4_ms * q4_fg * (1 + 0.022 * q4_ir); q4_yr = q4dR.s74_dn(q4_q0r, q4_q1r) * q4_ms * q4_fg * (1 + 0.022 * q4_ir);
q4_vmL += (q4_yl * q4_yl - q4_vmL) * q4_vuc; q4_vmR += (q4_yr * q4_yr - q4_vmR) * q4_vuc;
ost_out(q4_yl, q4_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = spl8 = spl9 = spl10 = spl11 = 0;

@gfx 1040 528
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_begin(1040, 528);
s74_pal(slider1);
s74_fonts();
sc != q4_fsc ? ( q4_fsc = sc; q4_f3 = ui_fitfont(13, (11 * sc) * max(ui_tf, 1)); );
gfx_setfont(13, "Arial", q4_f3, 'b');                  // small print at 11 px
s74_lamp = 1;                                           // the house lamp keys on the panel (gfx-s74 / gfx-ui)
sc != q4_lsc ? ( q4_lsc = sc; gfx_setfont(16, "Arial", (11 * sc) * max(ui_tf, 1), 'b'); gfx_setfont(10, "Arial", (11 * sc) * max(ui_tf, 1), 'b'); );
lk_font = 16; lk_font2 = 10;                            // lamp-key legends: caps 26 px tall or more / smaller caps
lk_well = 0x141518;                                     // the header's OB / CLEAN keys sit on the dark steel
s74_face(1040, 528);
q4_kp = s74_header(1040, "SUM 74", "SERIES 74", "SUMMING MIXER", #q4_pm, 1); vtg_f = gfx_getfont(); gfx_setfont(13); gfx_measurestr("SERIES 74", vtg_w, vtg_h); ver_tag_at("v3", 9, s74_sx * sc + vtg_w + 6 * sc, 15 * sc + 0.8 * vtg_h, 11 * sc, 0xE9E6D6); gfx_setfont(vtg_f + 1);
q4_kp > 0 ? prs_dirty = (q4_kp);
q4_cl = slider1 >= 0.5;
lk_well = q4_cl ? 0x2A2722 : 0x141518;                  // the panel keys: CLEAN's light-grey plates are a light face

// ---------- the channel modules ----------
q4_c = 0;
loop(8,
  q4_x = 16 + q4_c * 84; q4_cx = q4_x + 39;
  s74_mod(q4_x, 64, 78, 450, "");
  gfx_setfont(13); ui_col(S74_INK); s74_tc(q4_cx, 76, q4_c < 4 ? "MONO" : "STEREO");
  q4_c < 4 ? sprintf(#q4_cn, "%d", q4_c + 1) : sprintf(#q4_cn, "%d-%d", 5 + 2 * (q4_c - 4), 6 + 2 * (q4_c - 4));
  ui_namebox(q4_cx, 94, 66, q4_c, #q4_cn, S74_INK);
  // the signal lamp (amber; red within 3 dB of full scale), held so it does not flicker between blocks
  q4_LH[q4_c] = max(q4_PA[q4_c], q4_LH[q4_c] * 0.85); q4_PA[q4_c] = 0;
  pk_led(q4_cx * sc, 122 * sc, 4 * sc, q4_LH[q4_c] > 0.003, q4_LH[q4_c] > 0.708 ? 0xFF3A22 : S74_LAMP);
  slider(10 + q4_c) == 0 ? strcpy(#s74_vs, "C") : sprintf(#s74_vs, "%s %.0f", slider(10 + q4_c) < 0 ? "L" : "R", abs(slider(10 + q4_c)));
  s74_knob(q4_cx, 162, 15, 10 + q4_c, -100, 100, 0, 0, q4_c < 4 ? "PAN" : "BAL", "", 0);
  slider(2 + q4_c) <= -59.95 ? strcpy(#s74_vs, "OFF") : sprintf(#s74_vs, "%+.1f dB", slider(2 + q4_c));
  s74_fc = q4_c < 4 ? S74_F_CREAM : S74_F_BLUE;
  s74_fader(q4_cx, 222, 160, 2 + q4_c, -60, 10, 0, 0, "LEVEL", "", 0);
  s74_fc = 0;
  s74_lk = LK_RED; s74_lens(q4_cx - 27, 420, 54, 24, slider(18 + q4_c) >= 0.5, "MUTE") ? s74_set(18 + q4_c, slider(18 + q4_c) >= 0.5 ? 0 : 1);
  s74_lk = LK_YEL; s74_lens(q4_cx - 27, 452, 54, 24, slider(26 + q4_c) >= 0.5, "SOLO") ? s74_set(26 + q4_c, slider(26 + q4_c) >= 0.5 ? 0 : 1);
  q4_c += 1;
);

// ---------- the programme module ----------
s74_mod(696, 64, 328, 450, "PROGRAMME");
q4mL.s74_edge(710, 98, 148, 58, sqrt(2 * q4_vmL) / 0.12589, "L");
q4mR.s74_edge(862, 98, 148, 58, sqrt(2 * q4_vmR) / 0.12589, "R");
s74_kc = S74_C_HF; s74_knob(774, 220, 26, 34, 0, 18, 6, 0, "DRIVE", "%.1f dB", 0); s74_kc = 0;
s74_kc = S74_C_LF; s74_off = q4_cl; s74_knob(904, 220, 22, 35, 0, 100, 40, 0, "IRON", "%.0f%%", 0); s74_off = 0; s74_kc = 0;
s74_knob(890, 370, 18, 37, 0, 100, 50, 0, "WANDER", "%.0f%%", 0);
s74_lk = LK_YEL; s74_lens(714, 318, 96, 28, slider36 >= 0.5, "NOISE") ? s74_set(36, slider36 >= 0.5 ? 0 : 1);
// the SOLO lamp: flashes while anything is soloed
q4_sl = 0; q4_c = 0; loop(8, slider(26 + q4_c) >= 0.5 ? q4_sl = 1; q4_c += 1; );
pk_led(726 * sc, 372 * sc, 5 * sc, q4_sl && (time_precise() * 2.5) % 1 < 0.6, S74_LAMP);
s74_small(738, 366, "SOLO");
s74_smallc(762, 420, q4_cl ? "IC  ·  NO IRON" : "TRANSFORMER");
s74_smallc(762, 436, q4_cl ? "BALANCED" : "COUPLED");
slider38 <= -59.95 ? strcpy(#s74_vs, "OFF") : sprintf(#s74_vs, "%+.1f dB", slider38);
s74_fc = S74_F_YELLOW; s74_fader(980, 290, 140, 38, -60, 10, 0, 0, "MASTER", "", 0); s74_fc = 0;

pk_end();
ui_end();
