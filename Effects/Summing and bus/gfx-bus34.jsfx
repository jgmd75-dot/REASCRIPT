@gfx 1080 430
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
function ver_tag_hold(s, slot, dy) local(th) (
  th = gfx_texth; strcpy(#vt_s, s); vt_slot = slot; vt_xr = gfx_x; vt_yb = gfx_y + (0.8 + dy) * th;
  vt_fs = 0.5 * th; vt_gap = 0.3 * th; vt_r = gfx_r; vt_g = gfx_g; vt_b = gfx_b; vt_a = gfx_a;
);
function vt_mark() ( vt_xr = max(vt_xr, gfx_x); );
function ver_tag_put() local(r, g, b, a) (
  r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; gfx_r = vt_r; gfx_g = vt_g; gfx_b = vt_b; gfx_a = vt_a;
  ver_tag_at(#vt_s, vt_slot, vt_xr + vt_gap, vt_yb, vt_fs, -1);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a;
);
ui_begin(1080, 430);
krv_mx = 0;
!krv_mx ? (
  KRP = 0x37383B; KRF = 0x2A2B2E; KRI = 0xE6DEFF; KRA = 0xA58BFF; KRW = 0x121314; KRM = 0x55575A;
  KRC = 0xA58BFF; KRPT = 0x140B2E; KRCN = 0xA58BFF; KRGH = 0x2A2733; KRAMB = 0xFFD24A; KRRED = 0xFF3B1F; KRKT = 0x140B2E;
) : (
  KRP = 0x222528; KRF = ui_mix(0x222528, 0x000000, 0.25); KRI = 0xC7BEB3; KRA = 0xBFD9F2; KRW = ui_mix(0x222528, 0x000000, 0.45);
  KRM = 0x4A4E4A; KRC = 0xBFD9F2; KRPT = 0x17191B; KRCN = 0x1E5631; KRGH = 0x2C302E; KRAMB = 0xD4A373; KRRED = 0xBC3908; KRKT = 0x17191B;
);
KRH = ui_mix(KRP, 0x000000, 0.35); KRI2 = ui_mix(KRI, KRF, 0.35);
KCLO = 0x8B5A3C; KCHI = 0xC8402E;
KPIN = 0xC9B6E8; KPHP = 0xF2DC8A; KPDR = 0xF4B886; KPHF = 0x9CC8EE; KPIM = 0xA8DCC2; KPOU = 0xC8CACE;

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');
gfx_setfont(10, "Trebuchet MS", 12 * sc, 'b');
