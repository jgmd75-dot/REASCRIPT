desc:BUS34 [stereo colour unit] (GFX)
//tags: mix bus colour saturation drive density eq shelf hf compressor stereo width transformer mid side
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui, gfx-panel, gfx-dyn, gfx-clip, gfx-os and gfx-bypass (.jsfx-inc) in the same folder.

slider1:0<-12,12,0.1>-Input trim (dB)
slider2:0<0,3,1{Off,30 Hz,40 Hz,50 Hz}>-HPF
slider3:1<0,1,1{Out,In}>-Drive in
slider4:3<0,10,0.1>-Drive
slider5:5<0,10,0.1>-Density
slider6:1<0,1,1{Out,In}>-EQ in
slider7:50<30,90,1>-Low freq (Hz)
slider8:0<-9,9,0.1>-Low gain (dB)
slider9:12<8,20,0.1>-High freq (kHz)
slider10:0<-9,9,0.1>-High gain (dB)
slider11:0<0,1,1{Out,In}>-HF comp in
slider12:-10<-30,0,0.1>-HF threshold (dBFS)
slider13:8<3,20,0.1>-HF x-over (kHz)
slider14:0<0,1,1{Out,In}>-Image in
slider15:0<-6,6,0.1>-Space (dB)
slider16:0<-6,6,0.1>-Width (dB)
slider17:0<0,1,1{Off,On}>-Transformer
slider18:0<0,1,1{Stereo,MS}>-Mode
slider19:0<-12,12,0.1>-Output trim (dB)
slider20:50<0,100,1>-Drift (%)
slider21:0<0,1,1{VFD,Matrix}>-Look
slider22:1<0,1,1{Off,On}>-Link
slider23:0<0,2,1{1x,2x,4x}>-Oversampling
slider24:0<0,1,1{Off,On}>-Bypass
slider25:prs_sel=0<0,12,1{No preset,Init,Mix Bus Warmth,Dense Drums,Air Lift,Wide Master,Tame a Bright Mix,Low Weight,Tight Low End,Vocal Stem Sheen,M/S Glue,Loud and Proud,Subtle Polish}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-clip.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc

@init
#ui_man = "gfx-bus34";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 0; clp_kt_on = 0;

function bs_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function bs_op(f) ( 1 - exp(-2 * $pi * min(f, 0.49 * srate) / srate); );
function bs_tc(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );
function bs_sm(g) ( g * g * (3 - 2 * g); );

LSC = 100; HSC = 105; XCC = 110; SPC = 115; TBC = 120; HPC = 125; XLC = 130;
function bs_w(f) ( 2 * $pi * min(max(f, 5), 0.45 * srate) / srate; );
function bs_lsh(o, f, gdb, q) local(A, w, cw, al, s, a0) (
  A = 10 ^ (gdb / 40); w = bs_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(A) * al;
  a0 = (A + 1) + (A - 1) * cw + s;
  o[0] = A * ((A + 1) - (A - 1) * cw + s) / a0; o[1] = 2 * A * ((A - 1) - (A + 1) * cw) / a0; o[2] = A * ((A + 1) - (A - 1) * cw - s) / a0;
  o[3] = -2 * ((A - 1) + (A + 1) * cw) / a0; o[4] = ((A + 1) + (A - 1) * cw - s) / a0;
);
function bs_hsh(o, f, gdb, q) local(A, w, cw, al, s, a0) (
  A = 10 ^ (gdb / 40); w = bs_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(A) * al;
  a0 = (A + 1) - (A - 1) * cw + s;
  o[0] = A * ((A + 1) + (A - 1) * cw + s) / a0; o[1] = -2 * A * ((A - 1) + (A + 1) * cw) / a0; o[2] = A * ((A + 1) + (A - 1) * cw - s) / a0;
  o[3] = 2 * ((A - 1) - (A + 1) * cw) / a0; o[4] = ((A + 1) - (A - 1) * cw - s) / a0;
);
function bs_pk(o, f, gdb, q) local(A, w, cw, al, n) (
  A = 10 ^ (gdb / 40); w = bs_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al / A;
  o[0] = (1 + al * A) / n; o[1] = -2 * cw / n; o[2] = (1 - al * A) / n; o[3] = -2 * cw / n; o[4] = (1 - al / A) / n;
);
function bs_hp2(o, f, q) local(w, cw, al, n) (
  w = bs_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function bs_lp2(o, f, q) local(w, cw, al, n) (
  w = bs_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function bs_bq(x, o) instance(s1, s2) local(y) ( y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y; );
function bs_bqz() instance(s1, s2) ( s1 = s2 = 0; );
function bs_bqt() instance(s1, s2) ( s1 = bs_tn(s1); s2 = bs_tn(s2); );

function bs_upd(k) local(m) (
  m = abs(bs_lf_ - bs_lft) + abs(bs_lg_ - bs_lgt) + abs(bs_hf_ - bs_hft) + abs(bs_hg_ - bs_hgt) + abs(bs_xf_ - bs_xft)
    + abs(bs_sp_ - bs_spt) + abs(bs_hp_ - bs_hpt);
  m > 0.0001 || k >= 1 ? (
    bs_lf_ *= (bs_lft / bs_lf_) ^ k; bs_hf_ *= (bs_hft / bs_hf_) ^ k; bs_xf_ *= (bs_xft / bs_xf_) ^ k; bs_hp_ *= (bs_hpt / bs_hp_) ^ k;
    bs_lg_ += (bs_lgt - bs_lg_) * k; bs_hg_ += (bs_hgt - bs_hg_) * k; bs_sp_ += (bs_spt - bs_sp_) * k;
    bs_lsh(LSC, bs_lf_, bs_lg_, 0.9); bs_hsh(HSC, bs_hf_, bs_hg_, 0.8);
    bs_hp2(XCC, bs_xf_, 0.70710678); bs_lp2(XLC, bs_xf_, 0.70710678); bs_pk(SPC, 400, bs_sp_, 0.6);
    bs_hp2(HPC, bs_hp_, 1); bs_h1 = bs_op(bs_hp_);
  );
);

function dr_run() instance(rs, rh) local(ua, ub, ya, yb, ha, hb) (
  ua = bs_a * bs_dgs; ub = bs_b * bs_dgs;
  bs_dpk = max(bs_dpk, max(abs(ua), abs(ub)));
  ya = this.sA.clp_run(ua + dr_bs) - rs; yb = this.sB.clp_run(ub + dr_bs) - rs;
  ha = this.hA.clp_run(ua + dr_bh) - rh; hb = this.hB.clp_run(ub + dr_bh) - rh;
  bs_a = (ya + bs_dns * (ha - ya)) / bs_dgs; bs_b = (yb + bs_dns * (hb - yb)) / bs_dgs;
);
function dr_cfg() instance(rs, rh) (
  this.sA.clp_set(1, 1, 0.82, 0); this.sB.clp_set(1, 1, 0.82, 0);
  this.hA.clp_set(1, 0.55, 0.55, 0); this.hB.clp_set(1, 0.55, 0.55, 0);
  rs = this.sA.clp_crv(dr_bs); rh = this.hA.clp_crv(dr_bh);
);
function dr_prime() (
  this.sA.x1 = this.sB.x1 = dr_bs; this.sA.ad1 = this.sB.ad1 = this.sA.clp_ad(dr_bs);
  this.hA.x1 = this.hB.x1 = dr_bh; this.hA.ad1 = this.hB.ad1 = this.hA.clp_ad(dr_bh);
);
function dr_os() instance(rs, rh) local(u, v, i, ya, yb, ha, hb, p0, p1, p2, p3, q0, q1, q2, q3) (
  bs_dpk = max(bs_dpk, max(abs(bs_a), abs(bs_b)) * bs_dgs);
  this.upA.os_up(bs_a); this.upB.os_up(bs_b);
  i = 0;
  loop(os_f,
    u = i == 0 ? this.upA.s0 : i == 1 ? this.upA.s1 : i == 2 ? this.upA.s2 : this.upA.s3;
    v = i == 0 ? this.upB.s0 : i == 1 ? this.upB.s1 : i == 2 ? this.upB.s2 : this.upB.s3;
    bs_gD > 0 ? (
      ya = this.sA.clp_run(u * bs_dgs + dr_bs) - rs; yb = this.sB.clp_run(v * bs_dgs + dr_bs) - rs;
      ha = this.hA.clp_run(u * bs_dgs + dr_bh) - rh; hb = this.hB.clp_run(v * bs_dgs + dr_bh) - rh;
      u += bs_eD * ((ya + bs_dns * (ha - ya)) / bs_dgs - u); v += bs_eD * ((yb + bs_dns * (hb - yb)) / bs_dgs - v);
    );
    i == 0 ? ( p0 = u; q0 = v; ) : i == 1 ? ( p1 = u; q1 = v; ) : i == 2 ? ( p2 = u; q2 = v; ) : ( p3 = u; q3 = v; );
    i += 1;
  );
  bs_a = this.dnA.os_dn(p0, p1, p2, p3); bs_b = this.dnB.os_dn(q0, q1, q2, q3);
);
function dr_osclr() ( this.upA.os_clr(); this.upB.os_clr(); this.dnA.os_clr(); this.dnB.os_clr(); );
function dr_reset() ( this.sA.clp_reset(); this.sB.clp_reset(); this.hA.clp_reset(); this.hB.clp_reset(); );
function dr_tidy() ( this.sA.clp_tidy(); this.sB.clp_tidy(); this.hA.clp_tidy(); this.hB.clp_tidy(); );

function eq_run() (
  bs_a = this.ha.bs_bq(this.la.bs_bq(bs_a, LSC), HSC); bs_b = this.hb.bs_bq(this.lb.bs_bq(bs_b, LSC), HSC);
);
function eq_reset() ( this.la.bs_bqz(); this.lb.bs_bqz(); this.ha.bs_bqz(); this.hb.bs_bqz(); );
function eq_tidy() ( this.la.bs_bqt(); this.lb.bs_bqt(); this.ha.bs_bqt(); this.hb.bs_bqt(); );

function hc_law(ov) ( ov <= -3 ? 0 : ov >= 3 ? ov * 0.75 : 0.75 * sqr(ov + 3) / 12; );
function hc_run() instance(env, enva, envb, grm) local(ta, tb, la, lb, pk, ov, t, g, w, t1, t2, g2) (
  ta = this.xa2.bs_bq(this.xa.bs_bq(bs_a, XCC), XCC); tb = this.xb2.bs_bq(this.xb.bs_bq(bs_b, XCC), XCC);
  la = this.ya2.bs_bq(this.ya.bs_bq(bs_a, XLC), XLC); lb = this.yb2.bs_bq(this.yb.bs_bq(bs_b, XLC), XLC);
  pk = max(abs(ta), abs(tb));
  env += (pk > env ? hc_ka : hc_kr) * (pk - env);
  ov = 20 * log10(max(env, 0.000001)) - hc_th;
  t = ov <= -3 ? 0 : ov >= 3 ? ov * 0.75 : 0.75 * sqr(ov + 3) / 12;
  bs_lkm > 0 ? (
    w = abs(ta); enva += (w > enva ? hc_ka : hc_kr) * (w - enva);
    w = abs(tb); envb += (w > envb ? hc_ka : hc_kr) * (w - envb);
    t1 = hc_law(20 * log10(max(enva, 0.000001)) - hc_th); t2 = hc_law(20 * log10(max(envb, 0.000001)) - hc_th);
    t1 = t + (t1 - t) * bs_lkm; t2 = t + (t2 - t) * bs_lkm;
    g = 10 ^ (-t1 / 20); g2 = 10 ^ (-t2 / 20); grm = max(grm, max(t1, t2));
  ) : (
    enva = envb = env;
    g = 10 ^ (-t / 20); g2 = g; grm = max(grm, t);
  );
  bs_a = la + ta * g; bs_b = lb + tb * g2;
);
function hc_reset() instance(env, enva, envb) ( env = enva = envb = 0; this.xa.bs_bqz(); this.xb.bs_bqz(); this.xa2.bs_bqz(); this.xb2.bs_bqz();
  this.ya.bs_bqz(); this.yb.bs_bqz(); this.ya2.bs_bqz(); this.yb2.bs_bqz(); );
function hc_tidy() instance(env, enva, envb) ( env = bs_tn(env); enva = bs_tn(enva); envb = bs_tn(envb); this.xa.bs_bqt(); this.xb.bs_bqt(); this.xa2.bs_bqt(); this.xb2.bs_bqt();
  this.ya.bs_bqt(); this.yb.bs_bqt(); this.ya2.bs_bqt(); this.yb2.bs_bqt(); );

function set_run(xl, xr, ms) local(oa, ob) (
  bs_lkm = ms ? 0 : bs_lu;
  ms ? ( bs_a = (xl + xr) * 0.5; bs_b = (xl - xr) * 0.5; ) : ( bs_a = xl; bs_b = xr; );
  os_f > 1 ? this.dr.dr_os() :
  bs_gD > 0 ? ( oa = bs_a; ob = bs_b; this.dr.dr_run(); bs_a = oa + bs_eD * (bs_a - oa); bs_b = ob + bs_eD * (bs_b - ob); );
  bs_gE > 0 ? ( oa = bs_a; ob = bs_b; this.eq.eq_run(); bs_a = oa + bs_eE * (bs_a - oa); bs_b = ob + bs_eE * (bs_b - ob); );
  bs_gH > 0 ? ( oa = bs_a; ob = bs_b; this.hc.hc_run(); bs_a = oa + bs_eH * (bs_a - oa); bs_b = ob + bs_eH * (bs_b - ob); );
  ms ? ( oa = bs_a; bs_a = oa + bs_b; bs_b = oa - bs_b; );
);
function set_reset() ( this.dr.dr_reset(); this.dr.dr_osclr(); this.eq.eq_reset(); this.hc.hc_reset(); );
function set_tidy() ( this.dr.dr_tidy(); this.eq.eq_tidy(); this.hc.hc_tidy(); );

function hp_run() instance(pa, pb) local(ya, yb) (
  ya = bs_a - pa; pa += bs_h1 * (bs_a - pa); yb = bs_b - pb; pb += bs_h1 * (bs_b - pb);
  ya = this.qa.bs_bq(ya, HPC); yb = this.qb.bs_bq(yb, HPC);
  bs_a += bs_eF * (ya - bs_a); bs_b += bs_eF * (yb - bs_b);
);
function hp_tidy() instance(pa, pb) ( pa = bs_tn(pa); pb = bs_tn(pb); this.qa.bs_bqt(); this.qb.bs_bqt(); );
function im_run() local(m, s, s2) (
  m = (bs_a + bs_b) * 0.5; s = (bs_a - bs_b) * 0.5;
  s2 = this.sp.bs_bq(s, SPC) * bs_wds;
  s += bs_eI * (s2 - s);
  bs_a = m + s; bs_b = m - s;
);
function tf_run() instance(la, lb, rest) local(ya, yb, sa, sb) (
  la += tf_klp * (bs_a - la); lb += tf_klp * (bs_b - lb);
  sa = (this.ca.clp_run(la * tf_k + tf_b) - rest) / tf_k;
  sb = (this.cb.clp_run(lb * tf_k + tf_b) - rest) / tf_k;
  ya = this.ba.bs_bq(bs_a + sa - la, TBC); yb = this.bb.bs_bq(bs_b + sb - lb, TBC);
  bs_tfd = max(abs(la), abs(lb)) * tf_k;
  bs_a += bs_eT * (ya - bs_a); bs_b += bs_eT * (yb - bs_b);
);
function tf_cfg() instance(rest) ( this.ca.clp_set(1, 1, 0.9, 0); this.cb.clp_set(1, 1, 0.9, 0); rest = this.ca.clp_crv(tf_b); );
function tf_prime() ( this.ca.x1 = this.cb.x1 = tf_b; this.ca.ad1 = this.cb.ad1 = this.ca.clp_ad(tf_b); );
function tf_tidy() instance(la, lb) ( la = bs_tn(la); lb = bs_tn(lb); this.ca.clp_tidy(); this.cb.clp_tidy(); this.ba.bs_bqt(); this.bb.bs_bqt(); );

#bs_pm = "Init|Mix Bus Warmth|Dense Drums|Air Lift|Wide Master|Tame a Bright Mix|Low Weight|Tight Low End|Vocal Stem Sheen|M/S Glue|Loud and Proud|Subtle Polish";
function bs_mods(hp, di, dr, dn, ei, lf, lg, hf, hg, ci, th, xo, ii, sp, wd, tf, ms) (
  slider2 = hp; slider3 = di; slider4 = dr; slider5 = dn; slider6 = ei; slider7 = lf; slider8 = lg; slider9 = hf; slider10 = hg;
  slider11 = ci; slider12 = th; slider13 = xo; slider14 = ii; slider15 = sp; slider16 = wd; slider17 = tf; slider18 = ms;
);
function load_preset(p) local(i) (
  p == 1  ? bs_mods(0, 1, 3,   5,   1, 50, 0,    12, 0,    0, -10, 8,  0, 0,    0,   0, 0) :
  p == 2  ? bs_mods(1, 1, 4,   4,   1, 50, 1.5,  16, 1.5,  1, -16, 8,  1, 1,    1,   1, 0) :
  p == 3  ? bs_mods(0, 1, 7,   8,   1, 70, 2,    12, 2,    1, -14, 6,  0, 0,    0,   1, 0) :
  p == 4  ? bs_mods(0, 1, 2,   3,   1, 50, 0,    20, 4,    1, -12, 10, 1, 0,    1.5, 0, 0) :
  p == 5  ? bs_mods(1, 1, 3,   5,   1, 40, 1,    16, 1,    1, -10, 12, 1, 2,    2,   0, 0) :
  p == 6  ? bs_mods(0, 1, 3,   5,   1, 50, 0,    12, -1.5, 1, -24, 5,  0, 0,    0,   0, 0) :
  p == 7  ? bs_mods(1, 1, 3,   6,   1, 60, 3,    12, 0,    0, -10, 8,  0, 0,    0,   1, 0) :
  p == 8  ? bs_mods(3, 1, 4,   5,   1, 90, 2,    12, 0,    0, -10, 8,  1, -3,   0,   0, 0) :
  p == 9  ? bs_mods(3, 1, 3,   3,   1, 90, -2,   12, 3,    1, -18, 6,  0, 0,    0,   0, 0) :
  p == 10 ? bs_mods(0, 1, 5,   6,   1, 50, 0,    12, 0,    0, -10, 8,  1, 0,    1.5, 1, 1) :
  p == 11 ? bs_mods(1, 1, 8,   9,   1, 50, 1.5,  16, 1.5,  1, -14, 8,  1, 1,    1,   1, 0) :
  p == 12 ? bs_mods(0, 1, 2,   3,   1, 30, 1,    20, 1,    1, -8,  10, 0, 0,    0,   0, 0) :
  p == 13 ? ( bs_mods(0, 1, 3, 5, 1, 50, 0, 12, 0, 0, -10, 8, 0, 0, 0, 0, 0);
              slider1 = 0; slider19 = 0; slider20 = 50; slider21 = 0; slider22 = 1; );
  i = 1; loop(22, ui_auto(i); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

function bs_srinit() (
  bs_sr = srate;
  hc_ka = bs_tc(0.5); hc_kr = bs_tc(60);
  bs_lkk = bs_tc(10);
  tf_klp = bs_op(150); tf_kh = bs_tc(2000); tf_kc = bs_tc(6000);
  bs_fst = 1 / (0.01 * srate);
  bs_xst = 1 / (0.025 * srate);
  bs_hst = 1 / (0.03 * srate);
  bs_gsm = 1 - exp(-1 / (0.015 * srate));
  bs_gk = 1 - exp(-32 / (0.06 * srate));
  bs_olh = floor(0.3 * srate);
  bs_pk(TBC, 45, 1.2, 0.8);
  ost_init(0);
);
bs_srinit();
os_design(); os_base = 0; os_f = os_tf = os_f2n(slider23); os_gsetup();
in_init();
dB.drift_init(0.8 + rand(1) * 0.4); dT.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
sA.set_reset(); sB.set_reset();
bs_cur = 0; bs_mCur = bs_mNew = slider18 >= 0.5; bs_xf = 0;
bs_gD = slider3 >= 0.5; bs_gE = slider6 >= 0.5; bs_gH = slider11 >= 0.5; bs_gI = slider14 >= 0.5; bs_gT = slider17 >= 0.5;
bs_gF = slider2 >= 0.5;
bs_snap = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
by_setup(24);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(25, i != 25 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != bs_sr ? ( bs_srinit(); os_gsetup(); );
os_tf = os_f2n(slider23);
in_setup(slider1, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_delay = os_base + os_lat(os_f);
drift_macro(slider20);
bs_mt = slider18 >= 0.5;
bs_xf <= 0 && bs_mt != bs_mCur ? (
  bs_snap ? bs_mCur = bs_mt : (
    bs_mNew = bs_mt; bs_xf = 0.000001; bs_wu = floor(0.04 * srate);
    bs_cur ? ( sA.set_reset(); bs_prime = 1; ) : ( sB.set_reset(); bs_prime = 2; );
  );
