desc:Sum 81 [summing mixer] (GFX)
//tags: summing mixer console 1980s japanese european ic transformer vfd matrix stems bus series81
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// SUM 81 (Series 81): the summing mixer of the series - the mix bus of a 1980s console, with the series' MODE switch:
//   VFD     the Japanese module: the VFD look (charcoal, glowing cyan segment meters), English labels, and a Japanese
//           80s console voice - transistor / IC, electronically balanced, clean and precise: the summing amps stay
//           linear until their rails and then round off evenly; COLOUR gives the desk's tight, crisp voicing (a
//           firmer low end, a clear top).
//   MATRIX  the European module: the Matrix look (battleship grey, LED block ladders), German labels, and a European
//           80s console voice - transformer-balanced and warmer: a discrete class-A summing amp (a little even
//           colour as it is pushed) into the output transformer; COLOUR gives the transformer's weight (the lows
//           saturate first, a fuller low end, a softer top).
//   Level matched; switching fades out and back in.
//
// SET-UP (REAPER), as SUM 92's MODEL 12: the bus track needs 12 channels. Send the stems to the channels below and turn
// off the stem tracks' master / parent send. The mix always leaves on 1/2; outputs 3 - 12 are silenced.
//   1, 2, 3, 4          MONO channels (send to one channel each): PAN (constant loudness: centre = unity, +3 dB at
//                       the sides)
//   5/6, 7/8, 9/10, 11/12  STEREO pairs: BALANCE (centre = both sides at full level)
//   Every channel: a FADER (-60 dB = off .. +10 dB), PAN / BAL, MUTE, SOLO, a segment meter of its input (-48 .. 0
//   dBFS) and its name (click the name and type; Enter keeps it, Escape cancels). Names are saved.
// THE BUS:
//   DRIVE   (0 - 18 dB) how hard the mix drives the summing amp - more DRIVE, more colour, the same level (matched).
//   COLOUR  (0 - 100 %) how much of the module's own voicing is in the circuit (0 = flat).
//   NOISE   the desk's floor: VFD about -98 dBFS, MATRIX about -92 dBFS.
//   DRIFT   (0 - 100 %, 50 % = standard) the summing amp's bias wanders a trace (MATRIX more than VFD).
//   MASTER  the master fader (-60 dB = off .. +10 dB). Segment meters and a peak read-out (dBFS) on the output.
// At the minimum (DRIVE 0, COLOUR 0, NOISE off, DRIFT 0) with every channel at 0 dB both modes are close to a wire.
// The bus runs at 2x (linear-phase half-bands); latency 31 samples, reported.
// OUTPUT: the house CLIP at -0.3 dBFS, always on, no controls (as SUM 92). Below about -2 dBFS it does nothing.
// PRESETS: the house preset bar. The presets set the mode and the bus (DRIVE, COLOUR, NOISE, DRIFT) and leave the
//   channels alone, except "Flat all channels" (every channel to 0 dB, centre, no mute or solo). "Reset all to
//   defaults" (in the list) resets everything (the names are kept).
// GUI: drag a knob or a fader (SHIFT = fine, double-click = default, wheel); click a key; click the LCD (or PRESETS)
//   for the preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<0,1,1{VFD,Matrix}>-Mode
slider2:0<-60,10,0.1>-Ch 1 level (dB)
slider3:0<-60,10,0.1>-Ch 2 level (dB)
slider4:0<-60,10,0.1>-Ch 3 level (dB)
slider5:0<-60,10,0.1>-Ch 4 level (dB)
slider6:0<-60,10,0.1>-Ch 5-6 level (dB)
slider7:0<-60,10,0.1>-Ch 7-8 level (dB)
slider8:0<-60,10,0.1>-Ch 9-10 level (dB)
slider9:0<-60,10,0.1>-Ch 11-12 level (dB)
slider10:0<-100,100,1>-Ch 1 pan
slider11:0<-100,100,1>-Ch 2 pan
slider12:0<-100,100,1>-Ch 3 pan
slider13:0<-100,100,1>-Ch 4 pan
slider14:0<-100,100,1>-Ch 5-6 balance
slider15:0<-100,100,1>-Ch 7-8 balance
slider16:0<-100,100,1>-Ch 9-10 balance
slider17:0<-100,100,1>-Ch 11-12 balance
slider18:0<0,1,1{Off,On}>-Ch 1 mute
slider19:0<0,1,1{Off,On}>-Ch 2 mute
slider20:0<0,1,1{Off,On}>-Ch 3 mute
slider21:0<0,1,1{Off,On}>-Ch 4 mute
slider22:0<0,1,1{Off,On}>-Ch 5-6 mute
slider23:0<0,1,1{Off,On}>-Ch 7-8 mute
slider24:0<0,1,1{Off,On}>-Ch 9-10 mute
slider25:0<0,1,1{Off,On}>-Ch 11-12 mute
slider26:0<0,1,1{Off,On}>-Ch 1 solo
slider27:0<0,1,1{Off,On}>-Ch 2 solo
slider28:0<0,1,1{Off,On}>-Ch 3 solo
slider29:0<0,1,1{Off,On}>-Ch 4 solo
slider30:0<0,1,1{Off,On}>-Ch 5-6 solo
slider31:0<0,1,1{Off,On}>-Ch 7-8 solo
slider32:0<0,1,1{Off,On}>-Ch 9-10 solo
slider33:0<0,1,1{Off,On}>-Ch 11-12 solo
slider34:6<0,18,0.1>-Drive (dB)
slider35:50<0,100,1>-Colour (%)
slider36:0<0,1,1{Off,On}>-Noise
slider37:50<0,100,1>-Drift (%)
slider38:0<-60,10,0.1>-Master (dB)
slider39:prs_sel=0<0,12,1{No preset,Init,Straight Wire,TKY Studio,TKY Hot Bus,Digital Era,Berlin Studio,Berlin Iron,Warm Bus,Broadcast Line,Pushed Console,Old Console - Noisy,Flat all channels}>-Preset

in_pin:ch 1
in_pin:ch 2
in_pin:ch 3
in_pin:ch 4
in_pin:ch 5
in_pin:ch 6
in_pin:ch 7
in_pin:ch 8
in_pin:ch 9
in_pin:ch 10
in_pin:ch 11
in_pin:ch 12
out_pin:mix L
out_pin:mix R

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0;
#ui_man = "gfx-sum-81";
ext_noinit = 1;

// ---------- DSP helpers (this unit's own) ----------
q1_mem = 0;
function q1_alloc(n) local(p) ( p = q1_mem; q1_mem += n; memset(p, 0, n); p; );
// tanh (Pade 3/2), exactly 1 with zero slope at +/-3
function q1_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function q1_kf(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
function q1_kt(t, fs) ( 1 - exp(-1 / (max(t, 0.00001) * fs)); );
// RBJ shelves: t 4 low shelf, 5 high shelf
function q1_bqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(A, w, cs, sn, al, a0, sa) (
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * q); sa = 2 * sqrt(A) * al;
  t == 4 ? ( a0 = (A + 1) + (A - 1) * cs + sa;
             b0 = A * ((A + 1) - (A - 1) * cs + sa) / a0; b1 = 2 * A * ((A - 1) - (A + 1) * cs) / a0; b2 = A * ((A + 1) - (A - 1) * cs - sa) / a0;
             a1 = -2 * ((A - 1) + (A + 1) * cs) / a0; a2 = ((A + 1) + (A - 1) * cs - sa) / a0; ) :
           ( a0 = (A + 1) - (A - 1) * cs + sa;
             b0 = A * ((A + 1) + (A - 1) * cs + sa) / a0; b1 = -2 * A * ((A - 1) + (A + 1) * cs) / a0; b2 = A * ((A + 1) + (A - 1) * cs - sa) / a0;
             a1 = 2 * ((A - 1) - (A + 1) * cs) / a0; a2 = ((A + 1) - (A - 1) * cs - sa) / a0; );
);
function q1_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
// 2x oversampling: linear-phase half-bands (Kaiser windowed, polyphase), as the other series' units
function q1_bi0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= sqr(x / (2 * k)); s += t; k += 1; ); s; );
function q1_hbdesign(h, n, beta) local(c, t, k, w, x, se, i0) (
  c = (n - 1) / 2; i0 = q1_bi0(beta); t = 0;
  loop(n, k = t - c; x = 2 * t / (n - 1) - 1; w = q1_bi0(beta * sqrt(max(0, 1 - x * x))) / i0;
          h[t] = k == 0 ? 0.5 : sin($pi * k / 2) / ($pi * k) * w; t += 1; );
  se = 0; t = 0; loop((n + 1) / 2, se += h[2 * t]; t += 1; );
  t = 0; loop((n + 1) / 2, h[2 * t] *= 0.5 / se; t += 1; );
);
function q1_upinit(n, h, sz) instance(buf, sz2, w, hu, np, mm, dd) local(j) (
  buf = q1_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; dd = ((n - 1) / 2 - 1) / 2;
  hu = q1_alloc(np); j = 0; loop(np, hu[j] = 2 * h[2 * j]; j += 1; );
);
function q1_up(x) instance(buf, sz2, w, hu, np, mm, dd, o0, o1) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x; buf[w + sz2] = x;
  p = buf + w + sz2; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-j] + p[j + 1 - mm]); j += 1; );
  o0 = s; o1 = p[-dd];
);
function q1_dninit(n, h, sz) instance(buf, sz2, w, hu, np, mm, cc) local(j) (
  buf = q1_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; cc = (n - 1) / 2;
  hu = q1_alloc(np); j = 0; loop(np, hu[j] = h[2 * j]; j += 1; );
);
function q1_dn(x0, x1) instance(buf, sz2, w, hu, np, mm, cc) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x0; buf[w + sz2] = x0;
  w += 1; w >= sz2 ? w = 0; buf[w] = x1; buf[w + sz2] = x1;
  p = buf + w + sz2 - 1; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-2 * j] + p[2 * (j + 1 - mm)]); j += 1; );
  s + 0.5 * p[-cc];
);
// pink-ish noise (Paul Kellet's economy filter on white), about -12 dBFS RMS
function q1_pink() instance(p0, p1, p2) local(w) (
  w = rand(2) - 1; p0 = 0.99765 * p0 + w * 0.099046; p1 = 0.963 * p1 + w * 0.2965164; p2 = 0.57 * p2 + w * 1.0526913;
  (p0 + p1 + p2 + w * 0.1848) * 0.12;
);

q1_HB = q1_alloc(64); q1_hbdesign(q1_HB, 63, 8);
q1uL.q1_upinit(63, q1_HB, 64); q1uR.q1_upinit(63, q1_HB, 64); q1dL.q1_dninit(63, q1_HB, 64); q1dR.q1_dninit(63, q1_HB, 64);
q1_LAT = 31;
q1_TL = q1_alloc(8); q1_TR = q1_alloc(8);               // the channels' target gains onto the bus (left, right)
q1_GL = q1_alloc(8); q1_GR = q1_alloc(8);               // ... and the gliding gains
q1_PK = q1_alloc(8);                                    // the channels' input peaks (audio side)
q1_PA = q1_alloc(8);                                    // ... handed to the panel in @block
q1_LH = q1_alloc(10);                                   // the panel's falling meter levels (8 channels, L, R)
q1_HO = q1_alloc(2);                                    // the panel's peak read-out holds

// the make-up's loudness correction (dB) at DRIVE 0 .. 18 in 3 dB steps (measured on pink noise at -21 dBFS)
function q1_mk(d) local(p, i, f, a, b) (
  p = min(max(d, 0), 18) / 3; i = min(floor(p), 5); f = p - i;
  q1_mx ? (
    a = i == 0 ? 0 : i == 1 ? 0.03 : i == 2 ? 0.08 : i == 3 ? 0.17 : i == 4 ? 0.35 : 0.66;
    b = i == 0 ? 0.03 : i == 1 ? 0.08 : i == 2 ? 0.17 : i == 3 ? 0.35 : i == 4 ? 0.66 : 1.24;
  ) : (
    a = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0.01 : 0.02;
    b = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0.01 : i == 4 ? 0.02 : 0.24;
  );
  a + (b - a) * f;
);
// the mode: VFD (0) / MATRIX (1)
function q1_mode() local(fs) (
  fs = 2 * srate;
  q1_klo = q1_kf(110, fs); q1_ig = 2.8;                 // MATRIX: the output transformer
  q1_dcr = 1 - 2 * $pi * 2.5 / fs;                        // MATRIX: the DC blocker after the class-A stage (2.5 Hz)
  q1_HIS = 10 ^ ((q1_mx ? -80 : -86) / 20);             // NOISE: hiss (MATRIX about -92 dBFS, VFD about -98 dBFS)
  q1_mg = q1_mx ? 10 ^ (0 / 20) : 1;                    // the modes' level match
);
// COLOUR: the module's voicing - two shelves at full depth, blended with the dry signal by the gliding amount q1_c
// (set once per mode, so COLOUR itself never changes a coefficient)
function q1_voice() (
  q1_mx ? (
    q1eL1.q1_bqset(4, 120, 0.8, 0.6, srate); q1eR1.q1_bqset(4, 120, 0.8, 0.6, srate);           // a fuller low end
    q1eL2.q1_bqset(5, 14000, -0.9, 0.6, srate); q1eR2.q1_bqset(5, 14000, -0.9, 0.6, srate);     // a softer top
  ) : (
    q1eL1.q1_bqset(4, 55, -0.6, 0.7, srate); q1eR1.q1_bqset(4, 55, -0.6, 0.7, srate);           // a firmer low end
    q1eL2.q1_bqset(5, 11000, 0.8, 0.7, srate); q1eR2.q1_bqset(5, 11000, 0.8, 0.7, srate);       // a clear top
  );
);
function q1_update() local(i, any, on, lv, a, t, g) (
  any = 0; i = 0; loop(8, slider(26 + i) >= 0.5 ? any = 1; i += 1; );
  i = 0;
  loop(8,
    lv = slider(2 + i);
    on = slider(18 + i) < 0.5 && (!any || slider(26 + i) >= 0.5) && lv > -59.95;
    g = on ? 10 ^ (lv / 20) : 0;
    i < 4 ? (
      t = (slider(10 + i) / 100 + 1) * 0.25 * $pi;      // mono: constant loudness, centre = unity
      q1_TL[i] = g * cos(t) * sqrt(2); q1_TR[i] = g * sin(t) * sqrt(2);
    ) : (
      a = (slider(10 + i) + 100) / 200;                 // stereo: balance, centre = both sides at full level
      q1_TL[i] = g * min(1, 2 * (1 - a)); q1_TR[i] = g * min(1, 2 * a);
    );
    i += 1;
  );
  q1_tmx = slider1 >= 0.5;
  q1_tk = 0.5 * 10 ^ (slider34 / 20);
  q1_tgm = 10 ^ (q1_mk(slider34) / 20) * q1_mg;
  q1_tc = slider35 / 100;
  q1_tnz = slider36 >= 0.5;
  q1_tms = slider38 <= -59.95 ? 0 : 10 ^ (slider38 / 20);
  drift_macro(slider37);
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);               // the house CLIP at -0.3 dBFS, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = q1_LAT;
);
function q1_srinit() (
  q1_sr = srate;
  q1_sm = q1_kt(0.02, srate); q1_fd = 1 / (0.01 * srate);
  q1_mode(); q1_voice(); ost_init(0);
);

q1_mx = q1_tmx = slider1 >= 0.5;
q1_c = slider35 / 100;
q1_srinit(); q1_update();
q1_k = q1_tk; q1_gm = q1_tgm; q1_ms = q1_tms; q1_nz = q1_tnz;
q1_i = 0; loop(8, q1_GL[q1_i] = q1_TL[q1_i]; q1_GR[q1_i] = q1_TR[q1_i]; q1_i += 1; );
q1_dA.drift_init(0.8 + rand(0.4)); q1_dB.drift_init(0.8 + rand(0.4));
q1_sA = rand(2) - 1; q1_sB = rand(2) - 1;
q1_fade = 1; q1_fst = 0;

// ---------- the bus at 2x ----------
function q1_stage(x) instance(db, b0, d0, dcx, dcy, lo) local(u, y, a, b, t) (
  u = x * q1_k;
  q1_mx ? (
    // MATRIX: the discrete class-A summing amp (a little even colour as it is pushed), unity small-signal gain ...
    b = 0.1 + db;
    b != b0 ? ( b0 = b; d0 = (q1_th(b + 0.0005) - q1_th(b - 0.0005)) / 0.001; );
    y = (q1_th(u + b) - q1_th(b)) / (q1_k * d0) * q1_gm;
    dcy = y - dcx + q1_dcr * dcy; dcx = y; y = dcy;
    // ... into the output transformer (COLOUR): the lows saturate first
    lo += (y - lo) * q1_klo; t = y - lo + q1_th(lo * q1_ig) / q1_ig;
    y += q1_c * (t - y);
  ) : (
    // VFD: the IC summing amp, linear until its rails, then an even, rounded limit
    a = abs(u); b = 0.8 + db;
    y = (a < b ? u : sign(u) * (b + (1 - b) * q1_th((a - b) / (1 - b)))) / q1_k * q1_gm;
  );
  y;
);

// ---------- presets: the mode and the bus; the channels are left alone (except Flat all channels) ----------
function q1_set(m, d, c, nz, dr) (
  slider1 = m; slider34 = d; slider35 = c; slider36 = nz; slider37 = dr;
  ui_auto(1); ui_auto(34); ui_auto(35); ui_auto(36); ui_auto(37);
);
function q1_flat() local(i) (
  i = 0; loop(8, slider(2 + i) = 0; slider(10 + i) = 0; slider(18 + i) = 0; slider(26 + i) = 0; i += 1; );
  i = 2; loop(32, ui_auto(i); i += 1; );
);
#q1_pm = "Init|Straight Wire|TKY Studio|TKY Hot Bus|Digital Era|Berlin Studio|Berlin Iron|Warm Bus|Broadcast Line|Pushed Console|Old Console, Noisy|Flat all channels";
function load_preset(p) (
  //               mode drive colour noise drift
  p == 1  ? q1_set(0,  6,   50,   0,  50) :     // Init
  p == 2  ? q1_set(0,  0,    0,   0,   0) :     // Straight Wire
  p == 3  ? q1_set(0,  8,   70,   0,  40) :     // TKY Studio
  p == 4  ? q1_set(0, 15,   60,   0,  50) :     // TKY Hot Bus
  p == 5  ? q1_set(0,  3,  100,   0,  20) :     // Digital Era
  p == 6  ? q1_set(1,  6,   60,   0,  50) :     // Berlin Studio
  p == 7  ? q1_set(1, 10,  100,   0,  60) :     // Berlin Iron
  p == 8  ? q1_set(1,  8,   80,   0,  50) :     // Warm Bus
  p == 9  ? q1_set(1,  5,   40,   1,  30) :     // Broadcast Line
  p == 10 ? q1_set(1, 16,   70,   0,  70) :     // Pushed Console
  p == 11 ? q1_set(1, 12,   90,   1, 100) :     // Old Console, Noisy
  p == 12 ? q1_flat() :                         // Flat all channels
  p == 13 ? (                                   // Reset all to defaults
    q1_set(0, 6, 50, 0, 50); q1_flat(); slider38 = 0; ui_auto(38);
  );
  pr_cur = p > 12 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
q1_update();

@block
prs_chk();
srate != q1_sr ? ( q1_srinit(); q1_update(); );
q1_update();
q1_tmx != q1_mx && q1_fst == 0 ? q1_fst = 1;
q1_di = 0.1 * dm_s * samplesblock / srate; q1_wa = dm_a * (q1_mx ? 1 : 0.3);
q1sL.db = q1_wa * (0.025 * q1_dA.drift_tick(q1_di) + 0.01 * q1_sA); q1sR.db = q1_wa * (0.025 * q1_dB.drift_tick(q1_di) + 0.01 * q1_sB);
// the meters, handed to the panel
q1_bi = 0; loop(8, q1_PA[q1_bi] = max(q1_PA[q1_bi], q1_PK[q1_bi]); q1_PK[q1_bi] = 0; q1_bi += 1; );
q1a_l = max(q1a_l, q1_pl); q1a_r = max(q1a_r, q1_pr); q1_pl = q1_pr = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
q1_n = 0; loop(8, file_avail(0) != 0 ? file_string(0, UI_NM + q1_n); q1_n += 1; );   // the channel names
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
q1_k += (q1_tk - q1_k) * q1_sm; q1_gm += (q1_tgm - q1_gm) * q1_sm; q1_c += (q1_tc - q1_c) * q1_sm;
q1_ms += (q1_tms - q1_ms) * q1_sm; q1_nz += (q1_tnz - q1_nz) * q1_sm;
// the mode change: fade out, change at the silent point, wait for the half-bands to clear, fade back in
q1_fst == 1 ? ( q1_fade -= q1_fd; q1_fade <= 0 ? (
  q1_fade = 0; q1_mx = q1_tmx; q1_mode(); q1_update(); q1_k = q1_tk; q1_gm = q1_tgm; q1_c = q1_tc; q1_voice();
  q1eL1.z1 = q1eL1.z2 = q1eR1.z1 = q1eR1.z2 = q1eL2.z1 = q1eL2.z2 = q1eR2.z1 = q1eR2.z2 = 0;
  q1sL.dcx = q1sL.dcy = q1sL.lo = q1sR.dcx = q1sR.dcy = q1sR.lo = 0;
  q1_hold = q1_LAT + 8; q1_fst = 2; ); ) :
q1_fst == 2 ? ( q1_hold -= 1; q1_hold <= 0 ? q1_fst = 3; ) :
q1_fst == 3 ? ( q1_fade += q1_fd; q1_fade >= 1 ? ( q1_fade = 1; q1_fst = 0; ); );

// ---------- the channels onto the bus ----------
q1_GL[0] += (q1_TL[0] - q1_GL[0]) * q1_sm; q1_GR[0] += (q1_TR[0] - q1_GR[0]) * q1_sm;
q1_GL[1] += (q1_TL[1] - q1_GL[1]) * q1_sm; q1_GR[1] += (q1_TR[1] - q1_GR[1]) * q1_sm;
q1_GL[2] += (q1_TL[2] - q1_GL[2]) * q1_sm; q1_GR[2] += (q1_TR[2] - q1_GR[2]) * q1_sm;
q1_GL[3] += (q1_TL[3] - q1_GL[3]) * q1_sm; q1_GR[3] += (q1_TR[3] - q1_GR[3]) * q1_sm;
q1_GL[4] += (q1_TL[4] - q1_GL[4]) * q1_sm; q1_GR[4] += (q1_TR[4] - q1_GR[4]) * q1_sm;
q1_GL[5] += (q1_TL[5] - q1_GL[5]) * q1_sm; q1_GR[5] += (q1_TR[5] - q1_GR[5]) * q1_sm;
q1_GL[6] += (q1_TL[6] - q1_GL[6]) * q1_sm; q1_GR[6] += (q1_TR[6] - q1_GR[6]) * q1_sm;
q1_GL[7] += (q1_TL[7] - q1_GL[7]) * q1_sm; q1_GR[7] += (q1_TR[7] - q1_GR[7]) * q1_sm;
q1_PK[0] = max(q1_PK[0], abs(spl0)); q1_PK[1] = max(q1_PK[1], abs(spl1));
q1_PK[2] = max(q1_PK[2], abs(spl2)); q1_PK[3] = max(q1_PK[3], abs(spl3));
q1_PK[4] = max(q1_PK[4], max(abs(spl4), abs(spl5))); q1_PK[5] = max(q1_PK[5], max(abs(spl6), abs(spl7)));
q1_PK[6] = max(q1_PK[6], max(abs(spl8), abs(spl9))); q1_PK[7] = max(q1_PK[7], max(abs(spl10), abs(spl11)));
q1_ml = spl0 * q1_GL[0] + spl1 * q1_GL[1] + spl2 * q1_GL[2] + spl3 * q1_GL[3] + spl4 * q1_GL[4] + spl6 * q1_GL[5] + spl8 * q1_GL[6] + spl10 * q1_GL[7];
q1_mr = spl0 * q1_GR[0] + spl1 * q1_GR[1] + spl2 * q1_GR[2] + spl3 * q1_GR[3] + spl5 * q1_GR[4] + spl7 * q1_GR[5] + spl9 * q1_GR[6] + spl11 * q1_GR[7];
// ---------- the desk's floor ----------
q1_nz > 0.00001 ? ( q1_ml += q1pL.q1_pink() * q1_HIS * q1_nz; q1_mr += q1pR.q1_pink() * q1_HIS * q1_nz; );
// ---------- the summing amp (and MATRIX's transformer) at 2x, then the voicing ----------
q1uL.q1_up(q1_ml); q1uR.q1_up(q1_mr);
q1_q0l = q1sL.q1_stage(q1uL.o0); q1_q0r = q1sR.q1_stage(q1uR.o0);
q1_q1l = q1sL.q1_stage(q1uL.o1); q1_q1r = q1sR.q1_stage(q1uR.o1);
q1_yl = q1dL.q1_dn(q1_q0l, q1_q1l); q1_yr = q1dR.q1_dn(q1_q0r, q1_q1r);
q1_yl += q1_c * (q1eL2.q1_bq(q1eL1.q1_bq(q1_yl)) - q1_yl); q1_yr += q1_c * (q1eR2.q1_bq(q1eR1.q1_bq(q1_yr)) - q1_yr);
q1_fg = q1_fade * q1_fade * (3 - 2 * q1_fade);         // the mode fade, an S-curve
q1_yl *= q1_ms * q1_fg; q1_yr *= q1_ms * q1_fg;
ost_out(q1_yl, q1_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
q1_pl = max(q1_pl, abs(spl0)); q1_pr = max(q1_pr, abs(spl1));
spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = spl8 = spl9 = spl10 = spl11 = 0;

@gfx 1040 500
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1040, 500);
q1_m = slider1 >= 0.5;                                  // the look follows the mode: VFD (English) / MATRIX (German)

// ---------- the two looks ----------
q1_m ? (                                                // MATRIX: battleship grey, black linework, mustard lamps
  QP = 0x222528; QF = ui_mix(QP, 0x000000, 0.22); QH = ui_mix(QP, 0x000000, 0.32);
  QI = 0xC7BEB3; QI2 = ui_mix(0xC7BEB3, QP, 0.38); QA = 0xD4A373; QL = 0x0B0C0D; QG = 0x0E0F10; QO = 0x2C302E;
) : (                                                   // VFD: charcoal slate, cyan vacuum-fluorescent glow
  QP = 0x181A1B; QF = 0x131516; QH = 0x0F1112;
  QI = 0xD5DCDE; QI2 = 0x7D888C; QA = 0x4EE1DC; QL = 0x2E3235; QG = 0x070808; QO = 0x2A2D30;
);
gfx_setfont(11, "Trebuchet MS", (12 * sc) * max(ui_tf, 1), 'b');          // labels
gfx_setfont(12, "Trebuchet MS", (12.5 * sc) * max(ui_tf, 1), 'b');        // key captions
gfx_setfont(13, "Courier New", (15 * sc) * max(ui_tf, 1), 'b');           // the read-out
gfx_setfont(14, "Trebuchet MS", (13 * sc) * max(ui_tf, 1), 'b');          // knob and fader names
gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');          // the name

function q1_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function q1_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function q1_ct(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function q1_rt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function q1_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function q1_set1(idx, v) ( slider(idx) = v; ui_auto(idx); );
// English (VFD) or German (MATRIX)
function q1_s(en, de) ( en; );   // English labels in both modes
// German prints decimal commas
function q1_dec(s) local(i) ( i = 0; loop(strlen(s), str_getchar(s, i) == '.' ? str_setchar(s, i, ','); i += 1; ); s; );

// a section: MATRIX a sharp face with a black frame; VFD a shallow recess
function q1_sect(x, y, w, h) (
  q1_m ? ( ui_col(QL); q1_r(x, y, w, h); ui_col(QF); q1_r(x + 2, y + 2, w - 4, h - 4); )
       : pk_inset((x + 3) * sc, (y + 3) * sc, (w - 6) * sc, (h - 6) * sc, QF);
);
// a lit key: MATRIX a mustard block key, VFD a rubber key lit in the display colour; returns 1 on a click
function q1_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = q1_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  q1_m ? (
    on ? ( ui_cola(QA, 0.22); q1_r(x - 3, y - 3, w + 6, h + 6); );
    ui_col(0x0B0C0D); q1_r(x, y, w, h);
    ui_col(on ? QA : hov ? 0x353A37 : QO); q1_r(x + 1.5, y + 1.5, w - 3, h - 4);
    ui_cola(0xFFFFFF, on ? 0.3 : 0.08); q1_r(x + 1.5, y + 1.5, w - 3, 1);
    ui_col(on ? 0x17191B : QI);
  ) : (
    ui_cola(0x000000, 0.55); rd_rr((x + 0.5) * sc, (y + 2) * sc, w * sc, h * sc, 5 * sc);
    on ? ( ui_cola(QA, 0.18); rd_rr((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 7 * sc); );
    ui_col(0x0A0B0C); rd_rr(x * sc, y * sc, w * sc, h * sc, 5 * sc);
    ui_col(on ? ui_mix(QA, 0x000000, 0.12) : hov ? 0x34383B : 0x2A2D30); rd_rr((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, 4 * sc);
    ui_col(on ? 0x0B0C0D : 0xB4BDC0);
  );
  gfx_setfont(12); q1_ct(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);
// a smooth thick arc and a pointer (pixels)
function q1_arcw(cx, cy, r, a1, a2, w) local(k) ( ui_ssarc(cx, cy, r, a1, a2, w); );   // (supersampled: an even ring)
function q1_ptr(cx, cy, a, r1, r2, w) local(ca, sa, k) (
  ca = sin(a); sa = -cos(a); k = -w * 0.5;
  loop(max(1, floor(w * 2) + 1), gfx_line(cx + ca * r1 - sa * k, cy + sa * r1 + ca * k, cx + ca * r2 - sa * k, cy + sa * r2 + ca * k, 1); k += 0.5; );
);
// a knob: VFD a black rubber knob with its value arc glowing in the display colour; MATRIX a flat satin-silver face
// on a dark skirt, ticks printed round it. Its name below, the value in its place while touched.
function q1_knob(cx, cy, r, idx, lo, hi, def, name, val) local(v, n, dx, dy, hov, did, a, i, t, rr, x, y) (
  did = 5000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - q1_klt < 0.35 && q1_kid == idx) || (mouse_cap & 4) ? ( q1_set1(idx, def); drag_id = -1; q1_klt = 0; ) : (
      drag_id = did; q1_ky = mouse_y; q1_klt = time_precise(); q1_kid = idx; q1_kn = (v - lo) / (hi - lo); );
  );
  drag_id == did ? (
    q1_kn = min(max(q1_kn + (q1_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); q1_ky = mouse_y;
    v = floor((lo + q1_kn * (hi - lo)) * 10 + 0.5) / 10; slider(idx) != v ? q1_set1(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max((v - lo) / (hi - lo) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    q1_set1(idx, floor((lo + n * (hi - lo)) * 10 + 0.5) / 10); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1); a = -0.75 * $pi + n * 1.5 * $pi;
  x = cx * sc; y = cy * sc; rr = r * sc;
  q1_m ? (
    ui_col(QI2); i = 0;
    loop(11, t = -0.75 * $pi + i * 0.15 * $pi;
      gfx_line(x + sin(t) * (rr + 4 * sc), y - cos(t) * (rr + 4 * sc), x + sin(t) * (rr + (i == 0 || i == 5 || i == 10 ? 9 : 7) * sc), y - cos(t) * (rr + (i == 0 || i == 5 || i == 10 ? 9 : 7) * sc), 1);
      i += 1; );
    ui_cola(0x000000, 0.35); gfx_circle(x + 1.5 * sc, y + 3 * sc, rr, 1, 1);
    ui_col(0x1A1B1E); gfx_circle(x, y, rr, 1, 1);
    ui_col(0x5B6168); gfx_circle(x, y, rr * 0.8, 1, 1);
    ui_col(0xB7BCC2); gfx_circle(x, y, rr * 0.8 - 1.2 * sc, 1, 1);
    ui_col(0xDCDFE3); q1_arcw(x, y, rr * 0.8 - 2.6 * sc, -0.66 * $pi, 0.06 * $pi, 1.3 * sc);
    ui_col(0x141416); q1_ptr(x, y, a, rr * 0.2, rr * 0.95, 2 * sc);
  ) : (
    t = rr + 5 * sc;
    ui_col(0x2A2E30); q1_arcw(x, y, t, -0.75 * $pi, 0.75 * $pi, 1.4 * sc);
    n > 0.004 ? (
      ui_col(ui_mix(QA, QF, 0.78)); q1_arcw(x, y, t, -0.75 * $pi, a, 5 * sc);
      ui_col(QA); q1_arcw(x, y, t, -0.75 * $pi, a, 2.2 * sc);
    );
    ui_cola(0x000000, 0.5); gfx_circle(x + 1.5 * sc, y + 3 * sc, rr, 1, 1);
    ui_col(0x090A0B); gfx_circle(x, y, rr, 1, 1);
    ui_col(0x1B1E20); gfx_circle(x, y, rr - 1.5 * sc, 1, 1);
    ui_col(0x34383B); q1_arcw(x, y, rr - 2.5 * sc, -0.66 * $pi, 0.06 * $pi, 1.2 * sc);
    ui_col(ui_mix(QA, 0xFFFFFF, 0.35)); q1_ptr(x, y, a, rr * 0.3, rr - 4 * sc, 2 * sc);
  );
  q1_act = hov || drag_id == did;
  q1_act ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(x, y, (r + 3) * sc, 1, 1); );
  gfx_setfont(14); ui_col(q1_act ? QA : QI); q1_ct(cx, cy + r + 18, q1_act ? val : name);
);
// a fader: a slot with its scale, the cap (VFD a black cap with a glowing line, MATRIX a grey block with a white
// line). x = the slot's centre, y = its top, h = its travel. Its name below, the value in its place while touched.
function q1_fader(x, y, h, idx, lo, hi, def, name, val) local(v, n, hov, did, cy, i, ty) (
  did = 6000 + idx; v = slider(idx);
  n = min(max((v - lo) / (hi - lo), 0), 1); cy = y + h * (1 - n);
  hov = q1_hov(x - 16, y - 10, 32, h + 20);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - q1_klt < 0.35 && q1_kid == idx) || (mouse_cap & 4) ? ( q1_set1(idx, def); drag_id = -1; q1_klt = 0; ) : (
      drag_id = did; q1_ky = mouse_y; q1_klt = time_precise(); q1_kid = idx; q1_kn = n;
      abs(mouse_y / sc - cy) > 9 ? ( q1_kn = min(max(1 - (mouse_y / sc - y) / h, 0), 1); q1_set1(idx, floor((lo + q1_kn * (hi - lo)) * 10 + 0.5) / 10); );
    );
  );
  drag_id == did ? (
    q1_kn = min(max(q1_kn + (q1_ky - mouse_y) / ((mouse_cap & 8) ? h * 6 * sc : h * sc), 0), 1); q1_ky = mouse_y;
    v = floor((lo + q1_kn * (hi - lo)) * 10 + 0.5) / 10; slider(idx) != v ? q1_set1(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    q1_set1(idx, floor((lo + n * (hi - lo)) * 10 + 0.5) / 10); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1); cy = y + h * (1 - n);
  // the scale: 0 dB marked, ticks every 10 dB
  i = 0; loop(8, ty = y + h * (1 - (10 - i * 10 - lo) / (hi - lo)); ui_col(i == 1 ? QA : QI2); q1_r(x - 18, ty - 0.5, i == 1 ? 8 : 5, 1); i += 1; );
  ui_col(0x050606); q1_r(x - 2.5, y - 4, 5, h + 8);
  ui_cola(0xFFFFFF, 0.08); q1_r(x + 2.5, y - 4, 1, h + 8);
  ui_cola(0x000000, 0.5); q1_r(x - 11 + 1.5, cy - 9 + 3, 22, 18);
  q1_m ? (
    ui_col(0x0B0C0D); q1_r(x - 11, cy - 9, 22, 18);
    ui_col(0x8E9399); q1_r(x - 10, cy - 8, 20, 15);
    ui_cola(0xFFFFFF, 0.3); q1_r(x - 10, cy - 8, 20, 1);
    ui_col(0xF2F0EA); q1_r(x - 10, cy - 1, 20, 2);
  ) : (
    ui_col(0x090A0B); rd_rr((x - 11) * sc, (cy - 9) * sc, 22 * sc, 18 * sc, 3 * sc);
    ui_col(0x24272A); rd_rr((x - 10) * sc, (cy - 8) * sc, 20 * sc, 15 * sc, 2 * sc);
    ui_cola(QA, 0.3); q1_r(x - 10, cy - 2, 20, 4);
    ui_col(QA); q1_r(x - 10, cy - 1, 20, 2);
  );
  q1_act = hov || drag_id == did;
  gfx_setfont(14); ui_col(q1_act ? QA : QI); q1_ct(x, y + h + 18, q1_act ? val : name);
);
// a vertical segment meter (x, y, w, h), lit to the level v (linear peak): -48 .. 0 dBFS. VFD: cyan segments with
// their unlit ghosts, the top ones orange; MATRIX: LED blocks, green, amber, red.
function q1_bar(x, y, w, h, v, n) local(i, sh, p, lit, c, sy, d) (
  d = 20 * log10(max(v, 0.000001)); p = min(max((d + 48) / 48, 0), 1);
  ui_col(QG); q1_r(x - 2, y - 2, w + 4, h + 4);
  sh = h / n; i = 0;
  loop(n,
    sy = y + h - (i + 1) * sh; lit = p >= (i + 0.5) / n;
    q1_m ? (
      c = i >= n - 2 ? 0xBC3908 : i >= n - 5 ? 0xD4A373 : 0x2E9A58;
      ui_col(lit ? c : ui_mix(c, 0x000000, 0.8)); q1_r(x, sy + 0.8, w, sh - 1.6);
      lit ? ( ui_cola(0xFFFFFF, 0.25); q1_r(x, sy + 0.8, w, 1); );
    ) : (
      c = i >= n - 2 ? 0xFF4A2A : i >= n - 5 ? 0xFF8C00 : QA;
      lit ? ( ui_cola(c, 0.2); q1_r(x - 1, sy, w + 2, sh); ui_col(c); ) : ui_col(ui_mix(c, 0x070808, 0.9));
      q1_r(x, sy + 0.8, w, sh - 1.6);
    );
    i += 1;
  );
);
// the falling meter level (time based, so the frame rate does not matter): 20 dB in 1.5 s
function q1_fall(i, v) local(dt) (
  dt = min(max(time_precise() - q1_lt, 0), 0.1);
  q1_LH[i] = max(v, q1_LH[i] * 10 ^ (-13.3 * dt / 20));
);

// ---------- the panel and the header ----------
ui_col(QP); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(QH); q1_r(0, 0, 1040, 54);
ui_col(q1_m ? QL : 0x050606); q1_r(0, 54, 1040, 2);
ui_col(QA); q1_r(0, 56, 1040, 1);
ui_col(q1_m ? QA : QI); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(QH); ui_text(31 * sc, 21.5 * sc, "GFX");
gfx_setfont(15); ui_col(QI); q1_t(58, 11, "SUM 81"); ver_tag("v3", 16, 0.05, 0);
gfx_setfont(11); ui_col(QI2); q1_t(184, 14, q1_s("SERIES 81", "SERIE 81")); q1_t(184, 29, q1_s("SUMMING MIXER", "SUMMENMISCHER"));
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
q1_kp = pk_preset(318 * sc, 10 * sc, 450 * sc, 34 * sc, pr_cur, #q1_pm);
q1_kp > 0 ? prs_dirty = q1_kp;
q1_key(790, 13, 58, 28, "VFD", !q1_m) ? q1_set1(1, 0);
q1_key(854, 13, 80, 28, "MATRIX", q1_m) ? q1_set1(1, 1);
ui_size_picker(966 * sc, 18 * sc);

// ---------- the channel strips ----------
q1_now = time_precise();
q1_ci = 0;
loop(8,
  q1_x = 12 + q1_ci * 86; q1_cx = q1_x + 40;
  q1_sect(q1_x, 66, 80, 422);
  q1_ci < 4 ? sprintf(#q1_cn, "%d", q1_ci + 1) : sprintf(#q1_cn, "%d-%d", 5 + 2 * (q1_ci - 4), 6 + 2 * (q1_ci - 4));
  ui_namebox(q1_cx, 74, 68, q1_ci, #q1_cn, QI);
  gfx_setfont(11); ui_col(QI2); q1_ct(q1_cx, 97, q1_ci < 4 ? "MONO" : "STEREO");
  slider(10 + q1_ci) == 0 ? strcpy(#q1_v, "C") : sprintf(#q1_v, "%s %.0f", slider(10 + q1_ci) < 0 ? "L" : "R", abs(slider(10 + q1_ci)));
  q1_knob(q1_cx, 134, 15, 10 + q1_ci, -100, 100, 0, q1_ci < 4 ? "PAN" : q1_s("BAL", "BAL."), #q1_v);
  slider(2 + q1_ci) <= -59.95 ? strcpy(#q1_v, q1_s("OFF", "AUS")) : sprintf(#q1_v, "%+.1f dB", slider(2 + q1_ci));
  q1_m ? strcpy(#q1_v, q1_dec(#q1_v));
  q1_fader(q1_cx - 6, 196, 196, 2 + q1_ci, -60, 10, 0, q1_s("LEVEL", "PEGEL"), #q1_v);
  q1_fall(q1_ci, q1_PA[q1_ci]); q1_PA[q1_ci] = 0;
  q1_bar(q1_cx + 22, 196, 9, 196, q1_LH[q1_ci], 24);
  q1_key(q1_cx - 30, 426, 60, 22, q1_s("MUTE", "STUMM"), slider(18 + q1_ci) >= 0.5) ? q1_set1(18 + q1_ci, slider(18 + q1_ci) >= 0.5 ? 0 : 1);
  q1_key(q1_cx - 30, 456, 60, 22, "SOLO", slider(26 + q1_ci) >= 0.5) ? q1_set1(26 + q1_ci, slider(26 + q1_ci) >= 0.5 ? 0 : 1);
  q1_ci += 1;
);

// ---------- the master section ----------
q1_sect(702, 66, 326, 422);
gfx_setfont(11); ui_col(QI2); q1_t(714, 74, q1_s("MASTER", "SUMME"));
// the output meters and their scale
q1_fall(8, q1a_l); q1_fall(9, q1a_r);
q1_HO[0] = q1_now - q1_ht0 > 1.5 ? q1a_l : max(q1_HO[0], q1a_l); q1a_l > q1_HO[0] - 0.000001 && q1a_l > 0 ? q1_ht0 = q1_now;
q1_HO[1] = q1_now - q1_ht1 > 1.5 ? q1a_r : max(q1_HO[1], q1a_r); q1a_r > q1_HO[1] - 0.000001 && q1a_r > 0 ? q1_ht1 = q1_now;
q1a_l = q1a_r = 0;
q1_lt = q1_now;
q1_bar(718, 100, 12, 340, q1_LH[8], 36); q1_bar(738, 100, 12, 340, q1_LH[9], 36);
gfx_setfont(11); ui_col(QI2); q1_ct(724, 462, "L"); q1_ct(744, 462, "R");
q1_i = 0; loop(7, q1_d = q1_i == 0 ? 0 : q1_i == 1 ? -6 : q1_i == 2 ? -12 : q1_i == 3 ? -18 : q1_i == 4 ? -24 : q1_i == 5 ? -36 : -48;
  sprintf(#q1_e, "%d", q1_d); q1_t(758, 100 + 340 * (1 - (q1_d + 48) / 48) - 7, #q1_e); q1_i += 1; );
// the peak read-out
ui_col(q1_m ? QL : 0x2E3235); q1_r(796, 82, 220, 50);
ui_col(QG); q1_r(798, 84, 216, 46);
!q1_m ? ( ui_cola(QA, 0.035); q1_r(798, 84, 216, 46); );
q1_i = 0;
loop(2,
  q1_d = 20 * log10(max(q1_HO[q1_i], 0.000001));
  q1_d < -59.9 ? strcpy(#q1_e, "  ---") : sprintf(#q1_e, "%+5.1f", q1_d);
  q1_m ? strcpy(#q1_e, q1_dec(#q1_e));
  gfx_setfont(13); ui_col(ui_mix(QA, QG, q1_m ? 0.85 : 0.9)); q1_rt(892 + q1_i * 106, 100, "-88.8");
  ui_col(q1_d > -0.5 ? 0xFF4A2A : QA); q1_rt(892 + q1_i * 106, 100, #q1_e);
  q1_i += 1;
);
gfx_setfont(11); ui_col(ui_mix(QA, QG, 0.35)); q1_t(806, 113, q1_s("PEAK DBFS  L", "SPITZE DBFS  L")); q1_rt(1004, 120, "R");
// the bus controls
sprintf(#q1_v, "%.1f dB", slider34); q1_m ? strcpy(#q1_v, q1_dec(#q1_v));
q1_knob(818, 210, 24, 34, 0, 18, 6, q1_s("DRIVE", "ANTRIEB"), #q1_v);
sprintf(#q1_v, "%.0f%%", slider35);
q1_knob(924, 210, 24, 35, 0, 100, 50, q1_s("COLOUR", "FARBE"), #q1_v);
sprintf(#q1_v, "%.0f%%", slider37);
q1_knob(871, 330, 15, 37, 0, 100, 50, "DRIFT", #q1_v);
q1_key(827, 426, 88, 22, q1_s("NOISE", "RAUSCHEN"), slider36 >= 0.5) ? q1_set1(36, slider36 >= 0.5 ? 0 : 1);
// the SOLO lamp: flashes while anything is soloed
q1_sl = 0; q1_ci = 0; loop(8, slider(26 + q1_ci) >= 0.5 ? q1_sl = 1; q1_ci += 1; );
q1_on = q1_sl && (q1_now * 2.5) % 1 < 0.6;
q1_m ? ( ui_col(0x0B0C0D); q1_r(835, 462, 14, 10); ui_col(q1_on ? QA : ui_mix(QA, QO, 0.8)); q1_r(836, 463, 12, 8); )
     : rd_led(842, 467, 4, q1_on, QA);
gfx_setfont(11); ui_col(QI2); q1_t(857, 460, "SOLO");
slider38 <= -59.95 ? strcpy(#q1_v, q1_s("OFF", "AUS")) : sprintf(#q1_v, "%+.1f dB", slider38);
q1_m ? strcpy(#q1_v, q1_dec(#q1_v));
q1_fader(986, 196, 196, 38, -60, 10, 0, q1_s("MASTER", "SUMME"), #q1_v);
pk_end();
ui_end();
