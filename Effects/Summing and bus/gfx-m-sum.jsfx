desc:M-Sum [summing mixer] (GFX)
//tags: summing mixer bus console transformer vca compressor stems
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-dyn (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-dyn.jsfx-inc

slider1:0<0,24,0.1>-Console input drive (dB)
slider2:0.15<0,1,0.01>-Iron core saturation
slider3:0.05<0,0.3,0.01>-Power rail bus sag
slider4:-12<-30,0,0.5>-VCA threshold (dB)
slider5:4<1,20,0.5>-VCA ratio
slider6:1<0.1,20,0.1>-VCA attack (ms)
slider7:150<10,600,1>-VCA release (ms)
slider8:0<0,18,0.5>-VCA makeup (dB)
slider9:-60<-60,0,1>-Crosstalk / bleed (dB, -60 = off)
slider10:0<-24,12,0.5>-Master output trim (dB)
slider11:1<0,1,1{Out,In}>-VCA in
slider12:0<0,1,1{Off,On}>-VCA auto makeup
slider13:0<-60,6,0.1>-Main 1/2 level (dB)
slider14:0<-60,6,0.1>-Stem 1 level (dB)
slider15:0<-60,6,0.1>-Stem 2 level (dB)
slider16:0<-60,6,0.1>-Stem 3 level (dB)
slider17:0<-60,6,0.1>-Stem 4 level (dB)
slider18:0<-60,6,0.1>-Stem 5 level (dB)
slider19:0<-60,6,0.1>-Stem 6 level (dB)
slider20:0<-60,6,0.1>-Stem 7 level (dB)
slider21:0<0,1,1{Off,On}>-Main 1/2 mute
slider22:0<0,1,1{Off,On}>-Stem 1 mute
slider23:0<0,1,1{Off,On}>-Stem 2 mute
slider24:0<0,1,1{Off,On}>-Stem 3 mute
slider25:0<0,1,1{Off,On}>-Stem 4 mute
slider26:0<0,1,1{Off,On}>-Stem 5 mute
slider27:0<0,1,1{Off,On}>-Stem 6 mute
slider28:0<0,1,1{Off,On}>-Stem 7 mute
slider29:0<0,1,1{Off,On}>-Main 1/2 solo
slider30:0<0,1,1{Off,On}>-Stem 1 solo
slider31:0<0,1,1{Off,On}>-Stem 2 solo
slider32:0<0,1,1{Off,On}>-Stem 3 solo
slider33:0<0,1,1{Off,On}>-Stem 4 solo
slider34:0<0,1,1{Off,On}>-Stem 5 solo
slider35:0<0,1,1{Off,On}>-Stem 6 solo
slider36:0<0,1,1{Off,On}>-Stem 7 solo
slider37:0<0,100,1>-Band sat (%)
slider38:30<0,100,1>-Bias (%)
slider39:120<40,400,1>-Sat low band (Hz)
slider40:6000<2000,16000,10>-Sat high band (Hz)
slider41:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider42:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider43:prs_sel=0<0,8,1{No preset,Clean Sum,Warm Console,Driven Desk,Broadcast Glue,Heavy Iron,Punch Bus,Stressed Rail,Straight Sum (no colour)}>-Preset

in_pin:main L
in_pin:main R
in_pin:stem 1 L
in_pin:stem 1 R
in_pin:stem 2 L
in_pin:stem 2 R
in_pin:stem 3 L
in_pin:stem 3 R
in_pin:stem 4 L
in_pin:stem 4 R
in_pin:stem 5 L
in_pin:stem 5 R
in_pin:stem 6 L
in_pin:stem 6 R
in_pin:stem 7 L
in_pin:stem 7 R
out_pin:mix L
out_pin:mix R

@init
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0; gdc_x12 = gdc_y12 = 0; gdc_x13 = gdc_y13 = 0; gdc_x14 = gdc_y14 = 0; gdc_x15 = gdc_y15 = 0;
#ui_man = "gfx-m-sum";

LHD = 180;

DEN = 0.00000000000000000001;
SG = 100; SGT = 110; SPK = 120;
memset(SG, 0, 30);

function update() local(i) (
  drv = 10 ^ (slider1 / 20);
  iron_d = 1 + slider2 * 3;
  sag = slider3;
  thr = slider4; rat = max(slider5, 1);
  ac = dy_ms(slider6); rc_f = dy_ms(slider7); rc_s = dy_ms(slider7 * 4);
  bleed = slider9 <= -59.5 ? 0 : 10 ^ (slider9 / 20);
  trim = 10 ^ (slider10 / 20);
  c_on = slider11;
  mk = 10 ^ ((slider12 ? 0.5 * -thr * (1 - 1 / rat) : slider8) / 20);
  i = 0;
  any_solo = 0; i = 0; loop(8, any_solo |= slider(29 + i); i += 1; );
  i = 0;
  loop(8,
    SGT[i] = slider(21 + i) || (any_solo && !slider(29 + i)) || slider(13 + i) <= -59.9 ? 0 : 10 ^ (slider(13 + i) / 20);
    i += 1;
  );
  ost_setup(0, 0, 120, 6000, -0.3, 0);
);

function pp(dv, ir, sg, ct, t, r, a, rl, mu, au, ci, tr) (
  slider1 = dv; slider2 = ir; slider3 = sg; slider9 = ct; slider4 = t; slider5 = r; slider6 = a; slider7 = rl;
  slider8 = mu; slider12 = au; slider11 = ci; slider10 = tr;
);
function load_preset(p) (
  p == 1 ? pp(0, 0.1, 0.03, -60, -12, 2, 5, 200, 0, 0, 0, 0) :
  p == 2 ? pp(3, 0.3, 0.06, -54, -14, 2, 10, 250, 1, 0, 1, -1) :
  p == 3 ? pp(8, 0.55, 0.1, -50, -16, 3, 3, 150, 2, 0, 1, -4) :
  p == 4 ? pp(2, 0.2, 0.05, -60, -18, 4, 1, 120, 0, 1, 1, -1) :
  p == 5 ? pp(6, 1, 0.08, -60, -12, 2, 10, 300, 0, 0, 1, -3) :
  p == 6 ? pp(4, 0.3, 0.12, -48, -20, 6, 0.3, 80, 0, 1, 1, -2) :
  p == 7 ? pp(10, 0.7, 0.2, -45, -10, 2, 10, 300, 0, 0, 1, -6) :
  p == 8 ? pp(0, 0, 0, -60, -12, 1, 1, 150, 0, 0, 0, 0);
  p >= 1 && p <= 8 ? slider_automate(4095);
  p == 9 ? (
    pp(0, 0.15, 0.05, -60, -12, 4, 1, 150, 0, 0, 1, 0);
    i = 0; loop(8, slider(13 + i) = 0; slider(21 + i) = 0; slider(29 + i) = 0; i += 1; );
    slider37 = 0; slider38 = 30; slider39 = 120; slider40 = 6000; slider41 = -0.3; slider42 = 1;
    slider_automate(4398046511103);
  );
);

ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
en_a = 1 - exp(-1 / (0.002 * srate)); en_r = 1 - exp(-1 / (0.06 * srate));
lp_c = 1 - exp(-2 * $pi * 150 / srate);
bumpL.bq_set(2, 35, 1.2, 0.5); bumpR.bq_set(2, 35, 1.2, 0.5);
det_r = exp(-1 / (0.005 * srate));
sm = 1 - exp(-1 / (0.02 * srate));
vuc = 1 - exp(-1 / (0.3 * srate));
vu_sine = 10 * log10(2);
!ui_dflt ? ui_thm = 5; !ui_dflt ? ui_hw = 1;
PNL = 0x74777C; INKW = 0xF4F2EA; YEL = 0xF2D04A; KDK = 0x3A3C40;
update();
i = 0; loop(8, SG[i] = SGT[i]; i += 1; );
ui_dflt = 1;

function prs_sl() (
update();
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(43, i != 43 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
update();

@serialize
file_var(0, ui_sz);
gn = 0; loop(8, file_avail(0) != 0 ? file_string(0, UI_NM + gn); gn += 1; );
file_avail(0) != 0 ? file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
gdc_y12 = spl12 - gdc_x12 + gdc_r * gdc_y12; gdc_x12 = spl12; spl12 = gdc_y12;
gdc_y13 = spl13 - gdc_x13 + gdc_r * gdc_y13; gdc_x13 = spl13; spl13 = gdc_y13;
gdc_y14 = spl14 - gdc_x14 + gdc_r * gdc_y14; gdc_x14 = spl14; spl14 = gdc_y14;
gdc_y15 = spl15 - gdc_x15 + gdc_r * gdc_y15; gdc_x15 = spl15; spl15 = gdc_y15;
sl = 0; sr = 0; ab = 0; k = 0;
loop(8,
  SG[k] += (SGT[k] - SG[k]) * sm;
  xl = spl(2 * k) * SG[k]; xr = spl(2 * k + 1) * SG[k];
  SPK[k] = max(SPK[k], max(abs(spl(2 * k)), abs(spl(2 * k + 1))));
  sl += xl; sr += xr;
  ab += abs(xl) + abs(xr);
  k += 1;
);
ab *= drv;
en += (ab - en) * (ab > en ? en_a : en_r);
v_rail = max(0.65, 1 - en * sag);
g = v_rail * drv;
bl = (sl + sr * bleed) * g; br = (sr + sl * bleed) * g;

loL += (bl - loL) * lp_c + DEN; loR += (br - loR) * lp_c + DEN;
satL = ost_tanh(loL * iron_d) / iron_d; satR = ost_tanh(loR * iron_d) / iron_d;
bl = bumpL.bq_run(bl - loL + satL); br = bumpR.bq_run(br - loR + satR);

pk = max(abs(bl), abs(br));
env = max(pk, env * det_r) + DEN;
c_on ? (
  t_ = -max(0, 20 * log10(env) - thr) * (1 - 1 / rat);
  t_ < e_ ? e_ += (t_ - e_) * ac : (
    e_ += (t_ - e_) * (rc_f + (rc_s - rc_f) * min(hold, 1));
  );
  hold = e_ < -2 ? min(hold + 1 / srate, 1) : max(hold - 2 / srate, 0);
  cg = 10 ^ (e_ / 20) * mk;
) : ( e_ = 0; cg = 1; );
bl *= cg * trim; br *= cg * trim;
grm = min(grm, e_);

bl = ostL.ost_band(bl); br = ostR.ost_band(br);
ost_out(bl, br);
spl0 = ost_l; spl1 = ost_r;
vm += (0.5 * (spl0 * spl0 + spl1 * spl1) - vm) * vuc;
railm = min(railm, v_rail);
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );

@gfx 900 410
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
function ver_tag_hold(s, slot, dy) local(th) (
  th = gfx_texth; strcpy(#vt_s, s); vt_slot = slot; vt_xr = gfx_x; vt_yb = gfx_y + (0.8 + dy) * th;
  vt_fs = 0.5 * th; vt_gap = 0.3 * th; vt_r = gfx_r; vt_g = gfx_g; vt_b = gfx_b; vt_a = gfx_a;
);
function vt_mark() ( vt_xr = max(vt_xr, gfx_x); );
function ver_tag_put() local(r, g, b, a) (
  r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; gfx_r = vt_r; gfx_g = vt_g; gfx_b = vt_b; gfx_a = vt_a;
  ver_tag_at(#vt_s, vt_slot, vt_xr + vt_gap, vt_yb, vt_fs, -1);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a;
);
ui_begin(900, ins_show_out ? 530 : 410);
dy_ink = INKW; dy_bg = PNL; dy_kst = 3;

function brushed(x, y, w, h) local(i, gk) (
  i = 0;
  loop(floor(h * sc),
    gk = ui_hash(i * 1.37 + 0.5);
    ui_cola(gk > 0.5 ? 0xFFFFFF : 0x000000, 0.012 + 0.04 * abs(gk - 0.5));
    gfx_line(x * sc, y * sc + i, (x + w) * sc, y * sc + i);
    i += 1;
  );
);
function sect(x, y, w, h, t) (
  ui_cola(0x000000, 0.18); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  ui_cola(0xFFFFFF, 0.15); gfx_rect(x * sc, (y + h) * sc, w * sc, 1 * sc);
  gfx_setfont(6, "Trebuchet MS", 13 * sc, 'b'); ui_col(YEL); gfx_x = (x + 8) * sc; gfx_y = (y + 5) * sc; gfx_drawstr(t);
  ui_col(YEL); gfx_rect((x + 8) * sc, (y + 21) * sc, (w - 16) * sc, 1 * sc);
);

fh = ins_show_out ? 522 : 402;
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
pk_chassis(8 * sc, 4 * sc, 884 * sc, fh * sc, PNL);
brushed(10, 6, 880, fh - 6);
ui_col(INKW); gfx_circle(40 * sc, 34 * sc, 14 * sc, 1, 1);
gfx_setfont(4); ui_col(PNL); ui_ctext(40 * sc, 34 * sc, "GFX");
gfx_setfont(6, "Trebuchet MS", 24 * sc, 'b'); ui_col(INKW); gfx_x = 62 * sc; gfx_y = 20 * sc; gfx_drawstr("M-SUM"); ver_tag_hold("v3", 16, 0);
gfx_setfont(4); ui_col(YEL); gfx_x = 160 * sc; gfx_y = 30 * sc; gfx_drawstr("BROADCAST CONSOLE SUMMING BUS"); vt_mark(); ver_tag_put();
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );
k_ = pk_preset(470 * sc, 14 * sc, 346 * sc, 36 * sc, pr_cur, "Clean Sum|Warm Console|Driven Desk|Broadcast Glue|Heavy Iron|Punch Bus|Stressed Rail|Straight Sum (no colour)");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 8 ? 0 : k_; );
ui_size_picker(828 * sc, 22 * sc);

ui_col(YEL); gfx_rect(14 * sc, 60 * sc, 872 * sc, 2 * sc);

sect(18, 70, 466, 172, "STEMS");
gk = 0;
loop(8,
  cx = 50 + gk * 56;
  gk == 0 ? strcpy(#sn, "MAIN") : sprintf(#sn, "%d", gk); ui_namebox(cx, 91, 52, gk, #sn, INKW);
  sprintf(#sn, "%d-%d", 2 * gk + 1, 2 * gk + 2); dy_lbl(cx, 112, #sn, 0.55);
  LHD[gk] = max(SPK[gk], LHD[gk] * 0.9); SPK[gk] = 0;
  pk_led(cx * sc, 128 * sc, 3.5 * sc, LHD[gk] > 0.001 && SGT[gk] > 0, dy_grn);
  slider(13 + gk) <= -59.9 ? strcpy(#v, "OFF") : sprintf(#v, "%+.1f", slider(13 + gk));
  dy_knob(cx, 152, 13, 13 + gk, -60, 6, 0, 0, INKW, "", #v);
  pk_ledbtn((cx - 24) * sc, 200 * sc, 22 * sc, 20 * sc, slider(29 + gk), YEL) ? ( slider(29 + gk) = 1 - slider(29 + gk); ui_auto(29 + gk); );
  pk_ledbtn((cx + 2) * sc, 200 * sc, 22 * sc, 20 * sc, slider(21 + gk), dy_red) ? ( slider(21 + gk) = 1 - slider(21 + gk); ui_auto(21 + gk); );
  dy_lbl(cx - 13, 224, "SOLO", 0.6); dy_lbl(cx + 13, 224, "MUTE", 0.6);
  gk += 1;
);

sect(496, 70, 388, 172, "CONSOLE BUS");
sprintf(#v, "%.1f dB", slider1); dy_knob(536, 140, 18, 1, 0, 24, 0, 0, YEL, "DRIVE", #v);
sprintf(#v, "%.0f", slider2 * 100); dy_knob(612, 140, 18, 2, 0, 1, 0.15, 0, YEL, "IRON", #v);
sprintf(#v, "%.2f", slider3); dy_knob(688, 140, 18, 3, 0, 0.3, 0.05, 0, INKW, "SAG", #v);
slider9 <= -59.5 ? strcpy(#v, "OFF") : sprintf(#v, "%.0f dB", slider9);
dy_knob(764, 140, 18, 9, -60, 0, -60, 0, INKW, "CROSSTALK", #v);
rd = railm; railm = 1;
rdisp = rd < rdisp ? rd : rdisp + (rd - rdisp) * 0.08;
pk_led(840 * sc, 112 * sc, 5 * sc, rdisp < 0.985, 0xFF8A1A);
dy_lbl(840, 124, "STRESS", 0.8);
ui_col(0x101112); gfx_rect(832 * sc, 140 * sc, 16 * sc, 70 * sc);
ui_col(rdisp < 0.9 ? 0xFF8A1A : dy_grn); gfx_rect(834 * sc, (142 + (1 - (rdisp - 0.65) / 0.35) * 66) * sc, 12 * sc, ((rdisp - 0.65) / 0.35 * 66) * sc);
dy_lbl(840, 214, "RAIL", 0.8);
sprintf(#v, "%.0f", rdisp * 100); dy_lbl(840, 226, #v, 0.6);

sect(18, 254, 518, 140, "VCA BUS COMPRESSOR");
sprintf(#v, "%.1f dB", slider4); dy_knob(60, 316, 18, 4, -30, 0, -12, 0, YEL, "THRESH", #v);
sprintf(#v, "%.1f:1", slider5); dy_knob(132, 316, 18, 5, 1, 20, 4, 1, INKW, "RATIO", #v);
sprintf(#v, "%.1f ms", slider6); dy_knob(204, 316, 18, 6, 0.1, 20, 1, 1, INKW, "ATTACK", #v);
sprintf(#v, "%.0f ms", slider7); dy_knob(276, 316, 18, 7, 10, 600, 150, 1, INKW, "RELEASE", #v);
slider12 ? strcpy(#v, "AUTO") : sprintf(#v, "+%.1f dB", slider8); dy_knob(348, 316, 18, 8, 0, 18, 0, 0, INKW, "MAKEUP", #v);
dy_btn(388, 290, slider11, dy_grn, "IN") ? ( slider11 = 1 - slider11; ui_auto(11); );
dy_btn(434, 290, slider12, YEL, "AUTO") ? ( slider12 = 1 - slider12; ui_auto(12); );
sprintf(#v, "%+.1f dB", slider10); dy_knob(504, 316, 18, 10, -24, 12, 0, 0, YEL, "OUTPUT", #v);

sect(548, 254, 336, 140, "METERS");
grd = min(grm, grd * 0.85); grm = 0;
vuG.ui_vu(558 * sc, 282 * sc, 156 * sc, 100 * sc, grd, "GR");
vuO.ui_vu(720 * sc, 282 * sc, 156 * sc, 100 * sc, 10 * log10(vm + 0.0000000001) + 18 + vu_sine, "BUS OUT");

pk_end();
ui_end();
