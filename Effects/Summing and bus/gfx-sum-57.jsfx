desc:Sum 57 [summing mixer] (GFX)
//tags: summing mixer valve broadcast desk mixing network make-up transformer stems bus series57
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel and gfx-s57 (.jsfx-inc) in the same folder.
//
// SUM 57 (Series 57): the summing mixer of the series - a late-50s / early-60s valve broadcast and studio desk.
// Eight channels feed a passive mixing network; its loss is made up by a valve amplifier, and the mix leaves through
// the output transformer.
//
// SET-UP (REAPER), as SUM 92's MODEL 12: the bus track needs 12 channels. Send the stems to the channels below and turn
// off the stem tracks' master / parent send. The mix always leaves on 1/2; outputs 3 - 12 are silenced.
//   1, 2, 3, 4          MONO channels (send to one channel each): PAN (constant loudness: centre = unity, +3 dB at
//                       the sides)
//   5/6, 7/8, 9/10, 11/12  STEREO pairs: BALANCE (centre = both sides at full level)
//   Every channel: LEVEL (-60 dB = off .. +10 dB), PAN / BAL, MUTE, SOLO, a signal lamp (amber; red within 3 dB of
//   full scale), and its name (click the name and type; Enter keeps it, Escape cancels). Names are saved.
// THE BUS:
//   DRIVE   (0 - 18 dB) how hard the mix drives the make-up valve - more DRIVE, more colour, the same level (matched).
//   IRON    (0 - 100 %) the output transformer: the lows saturate first and the top softens a little.
//   NOISE   the desk's own floor: valve hiss (about -88 dBFS) and a trace of 50 Hz mains hum.
//   DRIFT   (0 - 100 %, 50 % = standard) the valve's bias wanders, and the two sides never quite match.
//   MASTER  (-60 dB = off .. +10 dB). Two edgewise VU meters read the output (0 VU = -18 dBFS).
// ULM / COPENHAGEN (the face, the model): ULM - a tight make-up stage (mostly odd, little even colour), a firm,
//   tight transformer. COPENHAGEN - a warmer valve (more even harmonics), a richer transformer with a softer top.
//   Level matched; switching fades out and back in.
// At the minimum (DRIVE 0, IRON 0, NOISE off, DRIFT 0) with every channel at 0 dB the desk is close to a wire: the
//   valve still adds a trace of colour on loud peaks.
// The bus runs at 2x (linear-phase half-bands); latency 31 samples, reported.
// OUTPUT: the house CLIP at -0.3 dBFS, always on, no controls (as SUM 92). Below about -2 dBFS it does nothing.
// PRESETS: the house preset bar. The presets set the face and the bus (DRIVE, IRON, NOISE, DRIFT) and leave the
//   channels alone, except "Flat all channels" (every channel to 0 dB, centre, no mute or solo). "Reset all to
//   defaults" (in the list) resets everything (the names are kept).
// GUI: drag a knob (SHIFT = fine, double-click = default, wheel); click a key; click the LCD (or PRESETS) for the
//   preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s57.jsfx-inc

slider1:0<0,1,1{Ulm,Copenhagen}>-Model (face)
slider2:0<-60,10,0.1>-Ch 1 level (dB)
slider3:0<-60,10,0.1>-Ch 2 level (dB)
slider4:0<-60,10,0.1>-Ch 3 level (dB)
slider5:0<-60,10,0.1>-Ch 4 level (dB)
slider6:0<-60,10,0.1>-Ch 5-6 level (dB)
slider7:0<-60,10,0.1>-Ch 7-8 level (dB)
slider8:0<-60,10,0.1>-Ch 9-10 level (dB)
slider9:0<-60,10,0.1>-Ch 11-12 level (dB)
slider10:0<-100,100,1>-Ch 1 pan
slider11:0<-100,100,1>-Ch 2 pan
slider12:0<-100,100,1>-Ch 3 pan
slider13:0<-100,100,1>-Ch 4 pan
slider14:0<-100,100,1>-Ch 5-6 balance
slider15:0<-100,100,1>-Ch 7-8 balance
slider16:0<-100,100,1>-Ch 9-10 balance
slider17:0<-100,100,1>-Ch 11-12 balance
slider18:0<0,1,1{Off,On}>-Ch 1 mute
slider19:0<0,1,1{Off,On}>-Ch 2 mute
slider20:0<0,1,1{Off,On}>-Ch 3 mute
slider21:0<0,1,1{Off,On}>-Ch 4 mute
slider22:0<0,1,1{Off,On}>-Ch 5-6 mute
slider23:0<0,1,1{Off,On}>-Ch 7-8 mute
slider24:0<0,1,1{Off,On}>-Ch 9-10 mute
slider25:0<0,1,1{Off,On}>-Ch 11-12 mute
slider26:0<0,1,1{Off,On}>-Ch 1 solo
slider27:0<0,1,1{Off,On}>-Ch 2 solo
slider28:0<0,1,1{Off,On}>-Ch 3 solo
slider29:0<0,1,1{Off,On}>-Ch 4 solo
slider30:0<0,1,1{Off,On}>-Ch 5-6 solo
slider31:0<0,1,1{Off,On}>-Ch 7-8 solo
slider32:0<0,1,1{Off,On}>-Ch 9-10 solo
slider33:0<0,1,1{Off,On}>-Ch 11-12 solo
slider34:6<0,18,0.1>-Drive (dB)
slider35:30<0,100,1>-Iron (%)
slider36:0<0,1,1{Off,On}>-Noise
slider37:50<0,100,1>-Drift (%)
slider38:0<-60,10,0.1>-Master (dB)
slider39:prs_sel=0<0,12,1{No preset,Init,Clean Network,Warm Valve,Driven Valve,Heavy Iron,Broadcast House,Copenhagen Glow,Ulm Precision,Hot Programme,Concert Hall Desk,Old Desk - Noisy,Flat all channels}>-Preset

in_pin:ch 1
in_pin:ch 2
in_pin:ch 3
in_pin:ch 4
in_pin:ch 5
in_pin:ch 6
in_pin:ch 7
in_pin:ch 8
in_pin:ch 9
in_pin:ch 10
in_pin:ch 11
in_pin:ch 12
out_pin:mix L
out_pin:mix R

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0;
#ui_man = "gfx-sum-57";
s57_lamp = 1;                                           // Series 57 keys drawn as the house lamp keys
ext_noinit = 1;
s57_mem = 0;
q7_HB = s57_alloc(64); s57_hbdesign(q7_HB, 63, 8);
q7uL.s57_upinit(63, q7_HB, 64); q7uR.s57_upinit(63, q7_HB, 64); q7dL.s57_dninit(63, q7_HB, 64); q7dR.s57_dninit(63, q7_HB, 64);
q7_LAT = 31;
q7_TL = s57_alloc(8); q7_TR = s57_alloc(8);             // the channels' target gains into the network (left, right)
q7_GL = s57_alloc(8); q7_GR = s57_alloc(8);             // ... and the gliding gains
q7_PK = s57_alloc(8);                                   // the channels' input peaks (audio side)
q7_PA = s57_alloc(8);                                   // ... handed to the panel in @block
q7_LH = s57_alloc(8);                                   // the panel's held lamp levels
q7_G0 = 0.5;                                            // the valve's drive at DRIVE 0
q7_HIS = 10 ^ (-76 / 20); q7_HUM = 10 ^ (-100 / 20);    // NOISE: hiss (about -88 dBFS), mains hum

// the slope of the valve curve at its bias point (for the small-signal make-up)
function q7_slope(b) ( (s57_th(b + 0.001) - s57_th(b - 0.001)) / 0.002; );
// the make-up's loudness correction (dB) at DRIVE 0 .. 18 in 3 dB steps (measured on pink noise at -21 dBFS)
function q7_mk(d) local(p, i, f, a, b) (
  p = min(max(d, 0), 18) / 3; i = min(floor(p), 5); f = p - i;
  a = i == 0 ? 0 : i == 1 ? 0.03 : i == 2 ? 0.06 : i == 3 ? 0.14 : i == 4 ? 0.28 : 0.51;
  b = i == 0 ? 0.03 : i == 1 ? 0.06 : i == 2 ? 0.14 : i == 3 ? 0.28 : i == 4 ? 0.51 : 0.93;
  a + (b - a) * f;
);
// the face: ULM (0) / COPENHAGEN (1)
function q7_face() local(fs) (
  fs = 2 * srate;
  q7_pb = q7_fc ? 0.22 : 0.08;                          // the valve's bias: COPENHAGEN more even harmonics
  q7_slp = q7_slope(q7_pb);
  q7_klo = s57_k(q7_fc ? 80 : 120, fs); q7_ig = q7_fc ? 3.3 : 2.5; q7_khf = s57_k(q7_fc ? 21000 : 30000, fs);
  q7_fcg = q7_fc ? 10 ^ (0 / 20) : 1;                   // the faces' level match
  q7_ic = q7_fc ? 0.03 : 0.015;                        // IRON's level match (per unit of IRON)
  q7_R = 1 - 2 * $pi * 2.5 / fs;                        // the DC blocker after the valve (2.5 Hz)
);
function q7_update() local(i, any, on, lv, a, t, g) (
  any = 0; i = 0; loop(8, slider(26 + i) >= 0.5 ? any = 1; i += 1; );
  i = 0;
  loop(8,
    lv = slider(2 + i);
    on = slider(18 + i) < 0.5 && (!any || slider(26 + i) >= 0.5) && lv > -59.95;
    g = on ? 10 ^ (lv / 20) : 0;
    i < 4 ? (
      t = (slider(10 + i) / 100 + 1) * 0.25 * $pi;      // mono: constant loudness, centre = unity
      q7_TL[i] = g * cos(t) * sqrt(2); q7_TR[i] = g * sin(t) * sqrt(2);
    ) : (
      a = (slider(10 + i) + 100) / 200;                 // stereo: balance, centre = both sides at full level
      q7_TL[i] = g * min(1, 2 * (1 - a)); q7_TR[i] = g * min(1, 2 * a);
    );
    i += 1;
  );
  q7_tfc = slider1 >= 0.5;
  q7_tg = q7_G0 * 10 ^ (slider34 / 20);
  q7_tgm = 10 ^ (q7_mk(slider34) / 20) * q7_fcg;          // (the small-signal make-up follows the gliding drive)
  q7_tir = slider35 / 100;
  q7_tnz = slider36 >= 0.5;
  q7_tms = slider38 <= -59.95 ? 0 : 10 ^ (slider38 / 20);
  drift_macro(slider37);
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);               // the house CLIP at -0.3 dBFS, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = q7_LAT;
);
function q7_srinit() (
  q7_sr = srate;
  q7_sm = s57_kt(0.02, srate); q7_fd = 1 / (0.01 * srate); q7_vuc = s57_kt(0.3, srate);
  q7_face(); ost_init(0);
);

q7_fc = q7_tfc = slider1 >= 0.5;
q7_srinit(); q7_update();
q7_g = q7_tg; q7_gm = q7_tgm; q7_ir = q7_tir; q7_ms = q7_tms; q7_nz = q7_tnz;
q7_i = 0; loop(8, q7_GL[q7_i] = q7_TL[q7_i]; q7_GR[q7_i] = q7_TR[q7_i]; q7_i += 1; );
q7_dA.drift_init(0.8 + rand(0.4)); q7_dB.drift_init(0.8 + rand(0.4));
q7_sA = rand(2) - 1; q7_sB = rand(2) - 1;
q7_fade = 1; q7_fst = 0;

// ---------- the bus at 2x: the make-up valve, the DC blocker, the output transformer ----------
function q7_stage(x) instance(db, dcx, dcy, lo, hf) local(u, y, b, t) (
  b = q7_pb + db;
  u = x * q7_g;
  y = u >= -b ? s57_th(u + b) : s57_th(0.6 * (u + b)) / 0.6;   // a triode: softer on one side (even harmonics)
  y = (y - s57_th(b)) * q7_gm / (q7_g * q7_slp);
  dcy = y - dcx + q7_R * dcy; dcx = y;
  lo += (dcy - lo) * q7_klo;                                  // the transformer: the lows saturate first ...
  t = dcy - lo + s57_th(lo * q7_ig) / q7_ig;
  hf += (t - hf) * q7_khf;                                    // ... and the top softens
  dcy + q7_ir * (hf - dcy);
);

// ---------- presets: the face and the bus; the channels are left alone (except Flat all channels) ----------
function q7_set(f, d, ir, nz, dr) (
  slider1 = f; slider34 = d; slider35 = ir; slider36 = nz; slider37 = dr;
  ui_auto(1); ui_auto(34); ui_auto(35); ui_auto(36); ui_auto(37);
);
function q7_flat() local(i) (
  i = 0; loop(8, slider(2 + i) = 0; slider(10 + i) = 0; slider(18 + i) = 0; slider(26 + i) = 0; i += 1; );
  i = 2; loop(32, ui_auto(i); i += 1; );
);
#q7_pm = "Init|Clean Network|Warm Valve|Driven Valve|Heavy Iron|Broadcast House|Copenhagen Glow|Ulm Precision|Hot Programme|Concert Hall Desk|Old Desk, Noisy|Flat all channels";
function load_preset(p) (
  //               face drive iron noise drift
  p == 1  ? q7_set(0,  6,   30,  0,  50) :     // Init
  p == 2  ? q7_set(0,  0,    0,  0,   0) :     // Clean Network
  p == 3  ? q7_set(1,  8,   40,  0,  50) :     // Warm Valve
  p == 4  ? q7_set(1, 15,   45,  0,  60) :     // Driven Valve
  p == 5  ? q7_set(0,  6,   90,  0,  50) :     // Heavy Iron
  p == 6  ? q7_set(0,  9,   50,  1,  50) :     // Broadcast House
  p == 7  ? q7_set(1, 11,   60,  0,  70) :     // Copenhagen Glow
  p == 8  ? q7_set(0,  4,   20,  0,  30) :     // Ulm Precision
  p == 9  ? q7_set(0, 18,   35,  0,  50) :     // Hot Programme
  p == 10 ? q7_set(1,  5,   30,  0,  40) :     // Concert Hall Desk
  p == 11 ? q7_set(1, 12,   70,  1, 100) :     // Old Desk, Noisy
  p == 12 ? q7_flat() :                        // Flat all channels
  p == 13 ? (                                  // Reset all to defaults
    q7_set(0, 6, 30, 0, 50); q7_flat(); slider38 = 0; ui_auto(38);
  );
  pr_cur = p > 12 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
q7_update();

@block
prs_chk();
srate != q7_sr ? ( q7_srinit(); q7_update(); );
q7_update();
q7_tfc != q7_fc && q7_fst == 0 ? q7_fst = 1;
q7_di = 0.12 * dm_s * samplesblock / srate;
q7sL.db = dm_a * (0.04 * q7_dA.drift_tick(q7_di) + 0.015 * q7_sA); q7sR.db = dm_a * (0.04 * q7_dB.drift_tick(q7_di) + 0.015 * q7_sB);
// the meters, handed to the panel
q7_bi = 0; loop(8, q7_PA[q7_bi] = max(q7_PA[q7_bi], q7_PK[q7_bi]); q7_PK[q7_bi] = 0; q7_bi += 1; );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
q7_n = 0; loop(8, file_avail(0) != 0 ? file_string(0, UI_NM + q7_n); q7_n += 1; );   // the channel names
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
q7_g += (q7_tg - q7_g) * q7_sm; q7_gm += (q7_tgm - q7_gm) * q7_sm; q7_ir += (q7_tir - q7_ir) * q7_sm;
q7_ms += (q7_tms - q7_ms) * q7_sm; q7_nz += (q7_tnz - q7_nz) * q7_sm;
// the face change: fade out, change at the silent point, wait for the half-bands to clear, fade back in
q7_fst == 1 ? ( q7_fade -= q7_fd; q7_fade <= 0 ? (
  q7_fade = 0; q7_fc = q7_tfc; q7_face(); q7_update(); q7_gm = q7_tgm;
  q7sL.dcx = q7sL.dcy = q7sL.lo = q7sL.hf = 0; q7sR.dcx = q7sR.dcy = q7sR.lo = q7sR.hf = 0;
  q7_hold = q7_LAT + 8; q7_fst = 2; ); ) :
q7_fst == 2 ? ( q7_hold -= 1; q7_hold <= 0 ? q7_fst = 3; ) :
q7_fst == 3 ? ( q7_fade += q7_fd; q7_fade >= 1 ? ( q7_fade = 1; q7_fst = 0; ); );

// ---------- the channels into the mixing network ----------
q7_GL[0] += (q7_TL[0] - q7_GL[0]) * q7_sm; q7_GR[0] += (q7_TR[0] - q7_GR[0]) * q7_sm;
q7_GL[1] += (q7_TL[1] - q7_GL[1]) * q7_sm; q7_GR[1] += (q7_TR[1] - q7_GR[1]) * q7_sm;
q7_GL[2] += (q7_TL[2] - q7_GL[2]) * q7_sm; q7_GR[2] += (q7_TR[2] - q7_GR[2]) * q7_sm;
q7_GL[3] += (q7_TL[3] - q7_GL[3]) * q7_sm; q7_GR[3] += (q7_TR[3] - q7_GR[3]) * q7_sm;
q7_GL[4] += (q7_TL[4] - q7_GL[4]) * q7_sm; q7_GR[4] += (q7_TR[4] - q7_GR[4]) * q7_sm;
q7_GL[5] += (q7_TL[5] - q7_GL[5]) * q7_sm; q7_GR[5] += (q7_TR[5] - q7_GR[5]) * q7_sm;
q7_GL[6] += (q7_TL[6] - q7_GL[6]) * q7_sm; q7_GR[6] += (q7_TR[6] - q7_GR[6]) * q7_sm;
q7_GL[7] += (q7_TL[7] - q7_GL[7]) * q7_sm; q7_GR[7] += (q7_TR[7] - q7_GR[7]) * q7_sm;
q7_PK[0] = max(q7_PK[0], abs(spl0)); q7_PK[1] = max(q7_PK[1], abs(spl1));
q7_PK[2] = max(q7_PK[2], abs(spl2)); q7_PK[3] = max(q7_PK[3], abs(spl3));
q7_PK[4] = max(q7_PK[4], max(abs(spl4), abs(spl5))); q7_PK[5] = max(q7_PK[5], max(abs(spl6), abs(spl7)));
q7_PK[6] = max(q7_PK[6], max(abs(spl8), abs(spl9))); q7_PK[7] = max(q7_PK[7], max(abs(spl10), abs(spl11)));
q7_ml = spl0 * q7_GL[0] + spl1 * q7_GL[1] + spl2 * q7_GL[2] + spl3 * q7_GL[3] + spl4 * q7_GL[4] + spl6 * q7_GL[5] + spl8 * q7_GL[6] + spl10 * q7_GL[7];
q7_mr = spl0 * q7_GR[0] + spl1 * q7_GR[1] + spl2 * q7_GR[2] + spl3 * q7_GR[3] + spl5 * q7_GR[4] + spl7 * q7_GR[5] + spl9 * q7_GR[6] + spl11 * q7_GR[7];
// ---------- the desk's floor: valve hiss and a trace of mains hum ----------
q7_nz > 0.00001 ? (
  q7_hph += 50 / srate; q7_hph -= floor(q7_hph);
  q7_hm = (sin(2 * $pi * q7_hph) + 0.5 * sin(6 * $pi * q7_hph) + 0.25 * sin(4 * $pi * q7_hph)) * q7_HUM;
  q7_ml += (q7pL.s57_pink() * q7_HIS + q7_hm) * q7_nz; q7_mr += (q7pR.s57_pink() * q7_HIS + q7_hm) * q7_nz;
);
// ---------- the make-up valve and the output transformer, at 2x ----------
q7uL.s57_up(q7_ml); q7uR.s57_up(q7_mr);
q7_q0l = q7sL.q7_stage(q7uL.o0); q7_q0r = q7sR.q7_stage(q7uR.o0);
q7_q1l = q7sL.q7_stage(q7uL.o1); q7_q1r = q7sR.q7_stage(q7uR.o1);
q7_fg = q7_fade * q7_fade * (3 - 2 * q7_fade);         // the face fade, an S-curve
q7_yl = q7dL.s57_dn(q7_q0l, q7_q1l) * q7_ms * q7_fg * (1 + q7_ic * q7_ir); q7_yr = q7dR.s57_dn(q7_q0r, q7_q1r) * q7_ms * q7_fg * (1 + q7_ic * q7_ir);
q7_vmL += (q7_yl * q7_yl - q7_vmL) * q7_vuc; q7_vmR += (q7_yr * q7_yr - q7_vmR) * q7_vuc;
ost_out(q7_yl, q7_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
spl2 = spl3 = spl4 = spl5 = spl6 = spl7 = spl8 = spl9 = spl10 = spl11 = 0;

@gfx 1040 420
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_begin(1040, 420);
s57_pal(slider1);
s57_fonts();
sc != q7_fsc ? ( q7_fsc = sc; q7_f3 = ui_fitfont(13, 11 * sc); );
gfx_setfont(13, "Arial", q7_f3, 'b');                  // small print at 11 px
s57_face(1040, 420);
q7_k = s57_header(1040, "SUM 57", "SERIES 57", "SUMMING MIXER", #q7_pm, 1); vtg_f = gfx_getfont(); gfx_setfont(13); gfx_measurestr("SERIES 57", vtg_w, vtg_h); ver_tag_at("v2", 16, s57_sx * sc + vtg_w + 6 * sc, 16 * sc + 0.8 * vtg_h, 11 * sc, S57_INK); gfx_setfont(vtg_f + 1);
q7_k > 0 ? prs_dirty = (q7_k);

// ---------- the channels ----------
s57_well(20, 66, 332, 340); s57_well(360, 66, 332, 340);
q7_c = 0;
loop(8,
  q7_cx = q7_c < 4 ? 61.5 + q7_c * 83 : 401.5 + (q7_c - 4) * 83;
  q7_c > 0 && q7_c != 4 ? ( ui_cola(S57_INK, 0.16); s57_r(q7_cx - 41.5, 74, 1, 324); );
  q7_c < 4 ? sprintf(#q7_cn, "%d", q7_c + 1) : sprintf(#q7_cn, "%d-%d", 5 + 2 * (q7_c - 4), 6 + 2 * (q7_c - 4));
  ui_namebox(q7_cx, 74, 74, q7_c, #q7_cn, S57_INK);
  gfx_setfont(13); ui_col(S57_DIM); s57_tc(q7_cx, 98, q7_c < 4 ? "MONO" : "STEREO");
  // the signal lamp (amber; red within 3 dB of full scale), held so it does not flicker between blocks
  q7_LH[q7_c] = max(q7_PA[q7_c], q7_LH[q7_c] * 0.85); q7_PA[q7_c] = 0;
  pk_led(q7_cx * sc, 116 * sc, 4 * sc, q7_LH[q7_c] > 0.003, q7_LH[q7_c] > 0.708 ? 0xFF3A22 : S57_AMB);
  slider(10 + q7_c) == 0 ? strcpy(#s57_vs, "C") : sprintf(#s57_vs, "%s %.0f", slider(10 + q7_c) < 0 ? "L" : "R", abs(slider(10 + q7_c)));
  s57_knob(q7_cx, 160, 16, 10 + q7_c, -100, 100, 0, 0, q7_c < 4 ? "PAN" : "BAL", "", 0);
  slider(2 + q7_c) <= -59.95 ? strcpy(#s57_vs, "OFF") : sprintf(#s57_vs, "%+.1f dB", slider(2 + q7_c));
  s57_hv = 1; s57_knob(q7_cx, 262, 24, 2 + q7_c, -60, 10, 0, 0, "LEVEL", "", 0); s57_hv = 0;
  s57_lcol = LK_RED; s57_key(q7_cx - 32, 330, 64, 26, slider(18 + q7_c) >= 0.5, "MUTE") ? s57_set(18 + q7_c, slider(18 + q7_c) >= 0.5 ? 0 : 1);
  s57_lcol = LK_YEL; s57_key(q7_cx - 32, 364, 64, 26, slider(26 + q7_c) >= 0.5, "SOLO") ? s57_set(26 + q7_c, slider(26 + q7_c) >= 0.5 ? 0 : 1);
  q7_c += 1;
);

// ---------- the main section ----------
s57_plate(704, 66, 316, 340);
s57_title(716, 74, "MAIN");
q7mL.s57_edge(716, 96, 144, 58, sqrt(2 * q7_vmL) / 0.12589, "L");
q7mR.s57_edge(864, 96, 144, 58, sqrt(2 * q7_vmR) / 0.12589, "R");
s57_valve(752, 214, 0.85, 0.35 + 0.65 * slider34 / 18);
gfx_setfont(13); ui_col(S57_DIM); s57_tc(752, 264, "VALVE");
s57_knob(848, 212, 26, 34, 0, 18, 6, 0, "DRIVE", "%.1f dB", 0);
s57_knob(958, 212, 22, 35, 0, 100, 30, 0, "IRON", "%.0f%%", 0);
s57_knob(752, 334, 13, 37, 0, 100, 50, 0, "DRIFT", "%.0f%%", 0);
s57_lcol = LK_YEL; s57_key(808, 304, 72, 26, slider36 >= 0.5, "NOISE") ? s57_set(36, slider36 >= 0.5 ? 0 : 1);
// the SOLO lamp: flashes while anything is soloed
q7_sl = 0; q7_c = 0; loop(8, slider(26 + q7_c) >= 0.5 ? q7_sl = 1; q7_c += 1; );
pk_led(824 * sc, 362 * sc, 5 * sc, q7_sl && (time_precise() * 2.5) % 1 < 0.6, S57_KEYC);
gfx_setfont(13); ui_col(S57_INK); s57_t(836, 356, "SOLO");
slider38 <= -59.95 ? strcpy(#s57_vs, "OFF") : sprintf(#s57_vs, "%+.1f dB", slider38);
s57_hv = 1; s57_knob(958, 322, 28, 38, -60, 10, 0, 0, "MASTER", "", 0); s57_hv = 0;

s57_cheeks(1040, 420);
pk_end();
ui_end();
