  cb_a0l.cb_pe.x1 = cb_a0l.cb_pe.x2 = cb_a0l.cb_pe.y1 = cb_a0l.cb_pe.y2 = cb_a0r.cb_be = cb_a0r.cb_bh = 0;
  cb_a0r.cb_dbe = cb_a0r.cb_de.a1 = cb_a0r.cb_de.a2 = cb_a0r.cb_de.b0 = cb_a0r.cb_de.b1 = cb_a0r.cb_de.b2 = 0;
  cb_a0r.cb_de.x1 = cb_a0r.cb_de.x2 = cb_a0r.cb_de.y1 = cb_a0r.cb_de.y2 = cb_a0r.cb_dh = cb_a0r.cb_ed = 0;
  cb_a0r.cb_ee = cb_a0r.cb_hb.a1 = cb_a0r.cb_hb.a2 = cb_a0r.cb_hb.b0 = cb_a0r.cb_hb.b1 = cb_a0r.cb_hb.b2 = 0;
  cb_a0r.cb_hb.x1 = cb_a0r.cb_hb.x2 = cb_a0r.cb_hb.y1 = cb_a0r.cb_hb.y2 = cb_a0r.cb_hl.a1 = cb_a0r.cb_hl.a2 = 0;
  cb_a0r.cb_hl.b0 = cb_a0r.cb_hl.b1 = cb_a0r.cb_hl.b2 = cb_a0r.cb_hl.x1 = cb_a0r.cb_hl.x2 = cb_a0r.cb_hl.y1 = 0;
  cb_a0r.cb_hl.y2 = cb_a0r.cb_pe.a1 = cb_a0r.cb_pe.a2 = cb_a0r.cb_pe.b0 = cb_a0r.cb_pe.b1 = cb_a0r.cb_pe.b2 = 0;
  cb_a0r.cb_pe.x1 = cb_a0r.cb_pe.x2 = cb_a0r.cb_pe.y1 = cb_a0r.cb_pe.y2 = cb_a1l.cb_be = cb_a1l.cb_bh = 0;
  cb_a1l.cb_dbe = cb_a1l.cb_de.a1 = cb_a1l.cb_de.a2 = cb_a1l.cb_de.b0 = cb_a1l.cb_de.b1 = cb_a1l.cb_de.b2 = 0;
  cb_a1l.cb_de.x1 = cb_a1l.cb_de.x2 = cb_a1l.cb_de.y1 = cb_a1l.cb_de.y2 = cb_a1l.cb_dh = cb_a1l.cb_ed = 0;
