  ca_TG = 100; ca_TGT = 110; ca_TPK = 120; ca_PL = 130; ca_PR = 140; // per track: gain, target, peak, pan L / R gains
  ca_NZ = 160;                                           // hiss state per track side (8)
  memset(10000, 0, ca_BSZ * 8); memset(100, 0, 70);
  ca_sm = 1 - exp(-1 / (0.02 * srate));
  ca_vuc = 1 - exp(-1 / (0.3 * srate));
  ca_vu_sine = 10 * log10(2);   // +3.01 dB: RMS -> sine peak, so a sine peaking at the ref level reads 0 VU
  ca_dr_r = 1 - exp(-1 / (0.03 * srate));
  ca_wpos = 0; ca_drop_g = 1; ca_drop_t = 1;
  ca_update();
  ca_i = 0; loop(4, ca_TG[ca_i] = ca_TGT[ca_i]; ca_i += 1; );
  ca_c4_dkr = 1 / (0.012 * srate); ca_c4_dk = 1; ca_c4_dst = 0;   // preset duck: 12 ms out, hold through the tape delay, 12 ms in
  ca_aer = 1 - exp(-1 / (0.01 * srate)); ca_aes = 1 - exp(-1 / (0.003 * srate));   // the ADAA lag's envelope
  ca_a0l.ca_aareset(); ca_a0r.ca_aareset(); ca_a1l.ca_aareset(); ca_a1r.ca_aareset();
  ca_a2l.ca_aareset(); ca_a2r.ca_aareset(); ca_a3l.ca_aareset(); ca_a3r.ca_aareset();
);

function ca_run() (
  // preset duck-and-swap: model, noise reduction, drive and wow change in silence; stay silent while the tape
  // delay and the NR envelopes catch up with the new settings
  ca_c4_dst == 1 ? ( ca_c4_dk -= ca_c4_dkr; ca_c4_dk <= 0 ? ( ca_c4_dk = 0; ca_update(); ca_c4_hc = floor(0.008 * srate); ca_c4_dst = 2; ); ) :
  ca_c4_dst == 2 ? ( ca_c4_hc > 0 ? ca_c4_hc -= 1 : ( ca_c4_dk += ca_c4_dkr; ca_c4_dk >= 1 ? ( ca_c4_dk = 1; ca_c4_dst = 0; ); ); );
  // ---------- transport: wow (0.6 Hz + a slow wander) and flutter (6 Hz), one for all tracks ----------
  ca_wph += 0.6 / srate; ca_wph -= floor(ca_wph);
  ca_fph += 6.2 / srate; ca_fph -= floor(ca_fph);
  ca_wnd += ((rand(2) - 1) - ca_wnd) * 0.00002;
  ca_wdel = s92_lat + ca_wow_a * (0.45 * sin(2 * $pi * ca_wph) + 1.5 * ca_wnd + 0.06 * sin(2 * $pi * ca_fph)) * 0.001 * srate;   // centred on the reported latency
  // dropouts (AGE): now and then the tape loses contact for a moment
  ca_age > 0 && rand(1) < ca_age * ca_age * 1.2 / srate ? ( ca_drop_t = 10 ^ (-(4 + rand(10)) / 20); ca_drop_n = (0.02 + rand(0.06)) * srate; );
  ca_drop_n > 0 ? ca_drop_n -= 1 : ca_drop_t = 1;
  ca_drop_g += (ca_drop_t - ca_drop_g) * ca_dr_r;
  // hiss: an independent noise per track side, gently pink
  ca_k = 0;
  loop(8, ca_NZ[ca_k] += ((rand(2) - 1) - ca_NZ[ca_k]) * 0.5; ca_k += 1; );
  // ---------- the four tracks: record, tape, playback ----------
  ca_k = 0; loop(4, ca_TG[ca_k] += (ca_TGT[ca_k] - ca_TG[ca_k]) * ca_sm; ca_TPK[ca_k] = max(ca_TPK[ca_k], max(abs(spl(2 * ca_k)), abs(spl(2 * ca_k + 1)))); ca_k += 1; );
  ca_t0l = ca_a0l.ca_tp(spl0, 10000, ca_NZ[0] * ca_hiss_g); ca_t0r = ca_a0r.ca_tp(spl1, 10000 + ca_BSZ, ca_NZ[1] * ca_hiss_g);
  ca_t1l = ca_a1l.ca_tp(spl2, 10000 + 2 * ca_BSZ, ca_NZ[2] * ca_hiss_g); ca_t1r = ca_a1r.ca_tp(spl3, 10000 + 3 * ca_BSZ, ca_NZ[3] * ca_hiss_g);
  ca_t2l = ca_a2l.ca_tp(spl4, 10000 + 4 * ca_BSZ, ca_NZ[4] * ca_hiss_g); ca_t2r = ca_a2r.ca_tp(spl5, 10000 + 5 * ca_BSZ, ca_NZ[5] * ca_hiss_g);
  ca_t3l = ca_a3l.ca_tp(spl6, 10000 + 6 * ca_BSZ, ca_NZ[6] * ca_hiss_g); ca_t3r = ca_a3r.ca_tp(spl7, 10000 + 7 * ca_BSZ, ca_NZ[7] * ca_hiss_g);
  ca_wpos = (ca_wpos + 1) & ca_BMSK;
  // ---------- mixdown: EQ, level, pan ----------
  ca_ml = ca_e0l.ca_eq(ca_t0l) * ca_TG[0] * ca_PL[0] + ca_e1l.ca_eq(ca_t1l) * ca_TG[1] * ca_PL[1] + ca_e2l.ca_eq(ca_t2l) * ca_TG[2] * ca_PL[2] + ca_e3l.ca_eq(ca_t3l) * ca_TG[3] * ca_PL[3];
  ca_mr = ca_e0r.ca_eq(ca_t0r) * ca_TG[0] * ca_PR[0] + ca_e1r.ca_eq(ca_t1r) * ca_TG[1] * ca_PR[1] + ca_e2r.ca_eq(ca_t2r) * ca_TG[2] * ca_PR[2] + ca_e3r.ca_eq(ca_t3r) * ca_TG[3] * ca_PR[3];
  ca_ml *= ca_mst; ca_mr *= ca_mst;
  ca_c4_dst ? ( ca_c4_dkg = ca_c4_dk * ca_c4_dk * (3 - 2 * ca_c4_dk); ca_ml *= ca_c4_dkg; ca_mr *= ca_c4_dkg; );
);

// ================================================================ 44 (ported from gfx-cassette-4, MODEL 44)


// ---------- one tape path (one side of one track) ----------
function cb_tp_set() instance(cb_hl, cb_hb, cb_pe, cb_de) (
  cb_hl.bq_set(0, cb_hfc, 0.65, 0);                      // playback head: top-end loss
  cb_hb.bq_set(2, cb_bumpf, 1.1, cb_bumpg);                 // head bump
  cb_pe.bq_set(3, 2000, 0.6, 10);                     // compander NR: treble lift into the tape ...
  cb_de.bq_set(3, 2000, 0.6, -10);                    // ... and back down after the expander
);
// x in -> tape out. buf = this path's wow delay line; nz = its hiss sample
function cb_tp(cb_x, cb_buf, cb_nz) instance(cb_hl, cb_hb, cb_pe, cb_de, cb_ee, cb_ed, cb_bh, cb_be, cb_dh, cb_dbe) local(cb_y, cb_lv, cb_g, cb_h, cb_k, cb_rp, cb_i, cb_f) (
  cb_y = cb_x * cb_rec_g;
  // ---- record: noise-reduction encode ----
  cb_nr ? (
    cb_model ? (
      cb_y = cb_pe.bq_run(cb_y);                            // compander: treble lift, then 2:1 around -20 dBFS
      cb_ee += (cb_y * cb_y - cb_ee) * cb_nr_c + cb_DEN;
      cb_y *= min(1 / sqrt(sqrt(100 * cb_ee)), 15.848931924611133);   // = 10^(min(-0.5 * (10 log10(ee) + 20), 24) / 20)
    ) : (
      cb_bh += (cb_y - cb_bh) * cb_b_c; cb_h = cb_y - cb_bh;            // B-type: lift the highs when they are quiet
      cb_be += (abs(cb_h) - cb_be) * cb_nr_c; cb_k = 2.16 * (1 - min(cb_be / 0.06, 1));   // up to +10 dB
      cb_y += cb_k * cb_h;
    );
  );
  // ---- the tape: saturation (soft, a touch asymmetric) ----
  cb_y = ost_tanh(cb_y * cb_sat_k + 0.03) * cb_isk - cb_t03;   // (1 / sat_k and the bias term: set in cb_update)
  // ---- transport: wow / flutter (a modulated delay) ----
  cb_buf[cb_wpos] = cb_y;
  cb_rp = cb_wpos - cb_wdel; cb_rp < 0 ? cb_rp += cb_BSZ;
  cb_i = floor(cb_rp); cb_f = cb_rp - cb_i;
  cb_y = cb_buf[cb_i & cb_BMSK] * (1 - cb_f) + cb_buf[(cb_i + 1) & cb_BMSK] * cb_f;
  // ---- playback head: top-end loss, head bump, dropouts, hiss ----
  cb_y = cb_hb.bq_run(cb_hl.bq_run(cb_y)) * cb_drop_g + cb_nz;
  // ---- noise-reduction decode ----
  cb_nr ? (
    cb_model ? (
      cb_ed += (cb_y * cb_y - cb_ed) * cb_nr_c + cb_DEN;      // 1:2 expander hears what came off the tape
      cb_y *= max(10 * sqrt(cb_ed), 0.001);           // = 10^(max(10 log10(ed) + 20, -60) / 20)
      cb_y = cb_de.bq_run(cb_y);
    ) : (
      cb_dh += (cb_y - cb_dh) * cb_b_c; cb_h = cb_y - cb_dh;
      cb_dbe += (abs(cb_h) - cb_dbe) * cb_nr_c; cb_k = 2.16 * (1 - min(cb_dbe / 0.06, 1));
      cb_y -= cb_k / (1 + cb_k) * cb_h;
    );
  );
  cb_y * cb_play_g;
);

// ---------- mixer channel EQ (treble 10 kHz, bass 100 Hz shelves) ----------
function cb_eq_set(cb_tr, cb_bs) instance(cb_ts, cb_bsf) ( cb_ts.bq_set(3, 10000, 0.7, cb_tr); cb_bsf.bq_set(4, 100, 0.7, cb_bs); );
function cb_eq(cb_x) instance(cb_ts, cb_bsf) ( cb_bsf.bq_run(cb_ts.bq_run(cb_x)) );

function cb_update() local(cb_i, cb_a, cb_any) (
  cb_model = 1; cb_nr = slider2;
  cb_hfc = (cb_model ? 15000 : 9500) * (1 - 0.45 * slider6 / 100);
  cb_bumpf = cb_model ? 95 : 70; cb_bumpg = cb_model ? 1.5 : 2.5;
  cb_sat_k = cb_model ? 1.3 : 1.6; cb_isk = 1 / cb_sat_k; cb_t03 = ost_tanh(0.03) / cb_sat_k;
  cb_nr_c = 1 - exp(-1 / ((cb_model ? 0.015 : 0.008) * srate));
  cb_b_c = 1 - exp(-2 * $pi * 3000 / srate);
  cb_rec_g = 10 ^ (slider3 / 20); cb_play_g = 1 / cb_rec_g;
  cb_wow_a = slider4 / 100 * (cb_model ? 0.55 : 1);
  cb_hiss_g = (slider5 / 50) * 10 ^ ((cb_model ? -54 : -50) / 20);
  cb_age = slider6 / 100;
  cb_mst = 10 ^ (slider7 / 20);
  cb_a0l.cb_tp_set(); cb_a0r.cb_tp_set(); cb_a1l.cb_tp_set(); cb_a1r.cb_tp_set(); cb_a2l.cb_tp_set(); cb_a2r.cb_tp_set(); cb_a3l.cb_tp_set(); cb_a3r.cb_tp_set();
  cb_e0l.cb_eq_set(slider12, slider16); cb_e0r.cb_eq_set(slider12, slider16); cb_e1l.cb_eq_set(slider13, slider17); cb_e1r.cb_eq_set(slider13, slider17);
  cb_e2l.cb_eq_set(slider14, slider18); cb_e2r.cb_eq_set(slider14, slider18); cb_e3l.cb_eq_set(slider15, slider19); cb_e3r.cb_eq_set(slider15, slider19);
  cb_any = slider28 || slider29 || slider30 || slider31;
  cb_i = 0;
  loop(4,
    cb_TGT[cb_i] = slider( 0 + 24 + cb_i) || (cb_any && !slider( 0 + 28 + cb_i)) || slider( 0 + 8 + cb_i) <= -59.9 ? 0 : 10 ^ (slider( 0 + 8 + cb_i) / 20);
    cb_a = (slider( 0 + 20 + cb_i) + 100) / 200;              // balance: centre = both sides at full level
    cb_PL[cb_i] = min(1, 2 * (1 - cb_a)); cb_PR[cb_i] = min(1, 2 * cb_a);
    cb_i += 1;
  );
);



function cb_reset() (
  // all state back to zero (as a fresh instance), then the original @init
  cb_age = cb_b_c = cb_bmsk = cb_bsz = cb_bumpf = cb_bumpg = cb_c4_dk = cb_c4_dkg = cb_c4_dkr = cb_c4_dst = 0;
  cb_c4_hc = cb_den = cb_dr_r = cb_drop_g = cb_drop_n = cb_drop_t = cb_fph = cb_hfc = cb_hiss_g = cb_i = cb_k = 0;
  cb_ml = cb_model = cb_mr = cb_mst = cb_nr = cb_nr_c = cb_nz = cb_pl = cb_play_g = cb_pr = cb_rec_g = 0;
  cb_sat_k = cb_sm = cb_t0l = cb_t0r = cb_t1l = cb_t1r = cb_t2l = cb_t2r = cb_t3l = cb_t3r = cb_tg = cb_tgt = 0;
  cb_tpk = cb_vu_sine = cb_vuc = cb_wdel = cb_wnd = cb_wow_a = cb_wph = cb_wpos = cb_a0l.cb_be = cb_a0l.cb_bh = 0;
  cb_a0l.cb_dbe = cb_a0l.cb_de.a1 = cb_a0l.cb_de.a2 = cb_a0l.cb_de.b0 = cb_a0l.cb_de.b1 = cb_a0l.cb_de.b2 = 0;
  cb_a0l.cb_de.x1 = cb_a0l.cb_de.x2 = cb_a0l.cb_de.y1 = cb_a0l.cb_de.y2 = cb_a0l.cb_dh = cb_a0l.cb_ed = 0;
  cb_a0l.cb_ee = cb_a0l.cb_hb.a1 = cb_a0l.cb_hb.a2 = cb_a0l.cb_hb.b0 = cb_a0l.cb_hb.b1 = cb_a0l.cb_hb.b2 = 0;
  cb_a0l.cb_hb.x1 = cb_a0l.cb_hb.x2 = cb_a0l.cb_hb.y1 = cb_a0l.cb_hb.y2 = cb_a0l.cb_hl.a1 = cb_a0l.cb_hl.a2 = 0;
