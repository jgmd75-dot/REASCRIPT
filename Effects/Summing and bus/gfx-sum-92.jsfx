@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0;
#ui_man = "gfx-sum-92";                           // the ? pop-up links to this manual
ext_noinit = 1;                                    // @init runs once; a sample-rate change re-inits from @block
s92_raw = 300000; s92_dly = 300016; s92_ln = 301024;   // the latency match: the 12 inputs as they came, delayed, and their 12 x 1024 lines
// host automation (sliders above 128 are passed by name)
function s92_auto(i) (
  i <= 128 ? ui_auto(i) :
  i == 129 ? slider_automate(slider129) :
  i == 130 ? slider_automate(slider130) :
  i == 132 ? slider_automate(slider132) :
  i == 133 ? slider_automate(slider133) :
  i == 134 ? slider_automate(slider134);
);
function s92_auto_au(i) (
  i <= 128 ? ui_auto(i) :
  i == 129 ? slider_automate(slider129) :
  i == 130 ? slider_automate(slider130) :
  i == 132 ? slider_automate(slider132) :
  i == 133 ? slider_automate(slider133) :
  i == 134 ? slider_automate(slider134);
);
function s92_autor(a, b) local(i) ( i = a; loop(b - a + 1, s92_auto_au(i); i += 1; ); );

// memory: 15 tape 10000 - 75535 and 100 - 167, 44 tape 80000 - 145535 and 200 - 267, 15 / 44 panel 300 - 303,
// 12 400 - 447 and panel 500 - 507, FIELD output stage 150000 - 154095

// ================================================================ 15 (ported from gfx-cassette-4, MODEL 15)


// ---------- one tape path (one side of one track) ----------
function ca_tp_set() instance(ca_hl, ca_hb, ca_pe, ca_de) (
  ca_hl.bq_set(0, ca_hfc, 0.65, 0);                      // playback head: top-end loss
  ca_hb.bq_set(2, ca_bumpf, 1.1, ca_bumpg);                 // head bump
  ca_pe.bq_set(3, 2000, 0.6, 10);                     // compander NR: treble lift into the tape ...
  ca_de.bq_set(3, 2000, 0.6, -10);                    // ... and back down after the expander
);
// the tape's saturation is anti-aliased (the house drive standard): first-order ADAA on tanh, read over the step from
// the previous argument u1 to u as (L(u) - L(u1)) / (u - u1), L = ln cosh (tanh at the midpoint when the two are
// within 1e-5). That reading sits half a sample late, so half the step, times the slope the signal sees, is added back:
// tanh's slope at the bias, eased by the swing round it (e: its smoothed RMS x sqrt 2, a sine's peak; about
// s / sqrt(1 + (s e)^2)). Small signals pass exactly (no droop, no lag), the driven fundamental keeps its level and the
// folded-back products are those of ADAA. No oversampling, no latency, no pre-filter (the noise reduction's own lift
// and its decode must stay matched round the tape); the curve is smooth (no knee to track).
// ln cosh: its series below |u| = 0.5 (no exp / log for the quieter samples), joined exactly to the full form above
function ca_lc(u) local(a, q) (
  a = abs(u);
  a < 0.5 ? ( q = u * u; q * (0.5 - q * (0.0833333333333 - q * (0.0222222222222 - q * (0.00674603174603 - q * (0.00218694885362 - q * 0.00147717362455))))); )
          : a + log(1 + exp(-2 * a)) - ca_lcc;
);
ca_lcc = 0.5 + log(1 + exp(-1)) - 0.25 * (0.5 - 0.25 * (0.0833333333333 - 0.25 * (0.0222222222222 - 0.25 * (0.00674603174603 - 0.25 * (0.00218694885362 - 0.25 * 0.00147717362455)))));
function ca_aareset() instance(ca_u1, ca_f1, ca_ms, ca_es) ( ca_u1 = 0.03; ca_f1 = ca_lc(0.03); ca_ms = ca_es = 0; );
ca_s03 = 1 - sqr(ost_tanh(0.03)); ca_s03q = 2 * ca_s03 * ca_s03;   // tanh's slope at the bias, and 2 s^2
// x in -> tape out. buf = this path's wow delay line; nz = its hiss sample
function ca_tp(ca_x, ca_buf, ca_nz) instance(ca_hl, ca_hb, ca_pe, ca_de, ca_ee, ca_ed, ca_bh, ca_be, ca_dh, ca_dbe, ca_u1, ca_f1, ca_ms, ca_es) local(ca_y, ca_lv, ca_g, ca_h, ca_k, ca_rp, ca_i, ca_f) (
  ca_y = ca_x * ca_rec_g;
  // ---- record: noise-reduction encode ----
  ca_nr ? (
    ca_model ? (
      ca_y = ca_pe.bq_run(ca_y);                            // compander: treble lift, then 2:1 around -20 dBFS
      ca_ee += (ca_y * ca_y - ca_ee) * ca_nr_c + ca_DEN;
      ca_y *= min(1 / sqrt(sqrt(100 * ca_ee)), 15.848931924611133);   // = 10^(min(-0.5 * (10 log10(ee) + 20), 24) / 20)
    ) : (
      ca_bh += (ca_y - ca_bh) * ca_b_c; ca_h = ca_y - ca_bh;            // B-type: lift the highs when they are quiet
      ca_be += (abs(ca_h) - ca_be) * ca_nr_c; ca_k = 2.16 * (1 - min(ca_be / 0.06, 1));   // up to +10 dB
      ca_y += ca_k * ca_h;
    );
  );
  // ---- the tape: saturation (soft, a touch asymmetric) ----
  ca_y = ca_y * ca_sat_k + 0.03; ca_f = ca_lc(ca_y); ca_h = ca_y - ca_u1;   // (1 / sat_k and the bias term: set in ca_update)
  ca_g = abs(ca_h) > 0.00001 ? (ca_f - ca_f1) / ca_h : ost_tanh(0.5 * (ca_y + ca_u1));
  ca_ms += (sqr(ca_y - 0.03) - ca_ms) * ca_aer; ca_es += (ca_ms - ca_es) * ca_aes;
  ca_u1 = ca_y; ca_f1 = ca_f;
  ca_y = (ca_g + 0.5 * ca_h * ca_s03 / sqrt(1 + ca_s03q * ca_es)) * ca_isk - ca_t03;
  // ---- transport: wow / flutter (a modulated delay) ----
  ca_buf[ca_wpos] = ca_y;
  ca_rp = ca_wpos - ca_wdel; ca_rp < 0 ? ca_rp += ca_BSZ;
  ca_i = floor(ca_rp); ca_f = ca_rp - ca_i;
  ca_y = ca_buf[ca_i & ca_BMSK] * (1 - ca_f) + ca_buf[(ca_i + 1) & ca_BMSK] * ca_f;
  // ---- playback head: top-end loss, head bump, dropouts, hiss ----
  ca_y = ca_hb.bq_run(ca_hl.bq_run(ca_y)) * ca_drop_g + ca_nz;
  // ---- noise-reduction decode ----
  ca_nr ? (
    ca_model ? (
      ca_ed += (ca_y * ca_y - ca_ed) * ca_nr_c + ca_DEN;      // 1:2 expander hears what came off the tape
      ca_y *= max(10 * sqrt(ca_ed), 0.001);           // = 10^(max(10 log10(ed) + 20, -60) / 20)
      ca_y = ca_de.bq_run(ca_y);
    ) : (
      ca_dh += (ca_y - ca_dh) * ca_b_c; ca_h = ca_y - ca_dh;
      ca_dbe += (abs(ca_h) - ca_dbe) * ca_nr_c; ca_k = 2.16 * (1 - min(ca_dbe / 0.06, 1));
      ca_y -= ca_k / (1 + ca_k) * ca_h;
    );
  );
  ca_y * ca_play_g;
);

// ---------- mixer channel EQ (treble 10 kHz, bass 100 Hz shelves) ----------
function ca_eq_set(ca_tr, ca_bs) instance(ca_ts, ca_bsf) ( ca_ts.bq_set(3, 10000, 0.7, ca_tr); ca_bsf.bq_set(4, 100, 0.7, ca_bs); );
function ca_eq(ca_x) instance(ca_ts, ca_bsf) ( ca_bsf.bq_run(ca_ts.bq_run(ca_x)) );

function ca_update() local(ca_i, ca_a, ca_any) (
  ca_model = 0; ca_nr = slider2;
  ca_hfc = (ca_model ? 15000 : 9500) * (1 - 0.45 * slider6 / 100);
  ca_bumpf = ca_model ? 95 : 70; ca_bumpg = ca_model ? 1.5 : 2.5;
  ca_sat_k = ca_model ? 1.3 : 1.6; ca_isk = 1 / ca_sat_k; ca_t03 = ost_tanh(0.03) / ca_sat_k;
  ca_nr_c = 1 - exp(-1 / ((ca_model ? 0.015 : 0.008) * srate));
  ca_b_c = 1 - exp(-2 * $pi * 3000 / srate);
  ca_rec_g = 10 ^ (slider3 / 20); ca_play_g = 1 / ca_rec_g;
  ca_wow_a = slider4 / 100 * (ca_model ? 0.55 : 1);
  ca_hiss_g = (slider5 / 50) * 10 ^ ((ca_model ? -54 : -50) / 20);
  ca_age = slider6 / 100;
  ca_mst = 10 ^ (slider7 / 20);
  ca_a0l.ca_tp_set(); ca_a0r.ca_tp_set(); ca_a1l.ca_tp_set(); ca_a1r.ca_tp_set(); ca_a2l.ca_tp_set(); ca_a2r.ca_tp_set(); ca_a3l.ca_tp_set(); ca_a3r.ca_tp_set();
  ca_e0l.ca_eq_set(slider12, slider16); ca_e0r.ca_eq_set(slider12, slider16); ca_e1l.ca_eq_set(slider13, slider17); ca_e1r.ca_eq_set(slider13, slider17);
  ca_e2l.ca_eq_set(slider14, slider18); ca_e2r.ca_eq_set(slider14, slider18); ca_e3l.ca_eq_set(slider15, slider19); ca_e3r.ca_eq_set(slider15, slider19);
  ca_any = slider28 || slider29 || slider30 || slider31;
  ca_i = 0;
  loop(4,
    ca_TGT[ca_i] = slider( 0 + 24 + ca_i) || (ca_any && !slider( 0 + 28 + ca_i)) || slider( 0 + 8 + ca_i) <= -59.9 ? 0 : 10 ^ (slider( 0 + 8 + ca_i) / 20);
    ca_a = (slider( 0 + 20 + ca_i) + 100) / 200;              // balance: centre = both sides at full level
    ca_PL[ca_i] = min(1, 2 * (1 - ca_a)); ca_PR[ca_i] = min(1, 2 * ca_a);
    ca_i += 1;
  );
);

// ---------- presets (track levels, pans, mutes and solos are left alone) ----------
// model, nr, drive, wow, hiss, age
function ca_pp(ca_m, ca_n, ca_d, ca_w, ca_h, ca_a) ( slider1 = ca_m; slider2 = ca_n; slider3 = ca_d; slider4 = ca_w; slider5 = ca_h; slider6 = ca_a; );
function ca_load_preset(ca_p) (
  ca_c4_dst = 1;                                // duck the output, swap the settings at silence, fade back in
  ca_p == 1 ? ca_pp(0, 1, 0, 30, 50, 10) :       // Bedroom Demo (15)
  ca_p == 2 ? ca_pp(0, 1, 6, 45, 60, 30) :       // Hot and Woolly (15)
  ca_p == 3 ? ca_pp(0, 0, 3, 60, 100, 50) :      // No NR, Old Tape (15)
  ca_p == 4 ? ca_pp(0, 1, 9, 80, 70, 70) :       // Worn-out Cassette (15)
  ca_p == 5 ? ca_pp(1, 1, 0, 20, 50, 5) :        // Clean Double Speed (44)
  ca_p == 6 ? ca_pp(1, 1, 6, 25, 50, 10) :       // Pumping Compander (44)
  ca_p == 7 ? ca_pp(1, 1, 10, 35, 80, 20) :      // Squashed Tape (44)
  ca_p == 8 ? ca_pp(1, 0, 2, 20, 70, 10);        // 44 without NR
  s92_autor(1, 6);
);


