  cb_a1r.cb_ee = cb_a1r.cb_hb.a1 = cb_a1r.cb_hb.a2 = cb_a1r.cb_hb.b0 = cb_a1r.cb_hb.b1 = cb_a1r.cb_hb.b2 = 0;
  cb_a1r.cb_hb.x1 = cb_a1r.cb_hb.x2 = cb_a1r.cb_hb.y1 = cb_a1r.cb_hb.y2 = cb_a1r.cb_hl.a1 = cb_a1r.cb_hl.a2 = 0;
