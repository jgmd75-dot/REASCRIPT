  cb_a1r.cb_pe.x1 = cb_a1r.cb_pe.x2 = cb_a1r.cb_pe.y1 = cb_a1r.cb_pe.y2 = cb_a2l.cb_be = cb_a2l.cb_bh = 0;
  cb_a2l.cb_dbe = cb_a2l.cb_de.a1 = cb_a2l.cb_de.a2 = cb_a2l.cb_de.b0 = cb_a2l.cb_de.b1 = cb_a2l.cb_de.b2 = 0;
  cb_a2l.cb_de.x1 = cb_a2l.cb_de.x2 = cb_a2l.cb_de.y1 = cb_a2l.cb_de.y2 = cb_a2l.cb_dh = cb_a2l.cb_ed = 0;
  cb_a2l.cb_ee = cb_a2l.cb_hb.a1 = cb_a2l.cb_hb.a2 = cb_a2l.cb_hb.b0 = cb_a2l.cb_hb.b1 = cb_a2l.cb_hb.b2 = 0;
