  cb_a2l.cb_hl.y2 = cb_a2l.cb_pe.a1 = cb_a2l.cb_pe.a2 = cb_a2l.cb_pe.b0 = cb_a2l.cb_pe.b1 = cb_a2l.cb_pe.b2 = 0;
  cb_a2l.cb_pe.x1 = cb_a2l.cb_pe.x2 = cb_a2l.cb_pe.y1 = cb_a2l.cb_pe.y2 = cb_a2r.cb_be = cb_a2r.cb_bh = 0;
  cb_a2r.cb_dbe = cb_a2r.cb_de.a1 = cb_a2r.cb_de.a2 = cb_a2r.cb_de.b0 = cb_a2r.cb_de.b1 = cb_a2r.cb_de.b2 = 0;
