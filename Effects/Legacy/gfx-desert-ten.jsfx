desc:Desert Ten [practice amp] (GFX)
//tags: amp amplifier guitar solid state practice combo fuzz saturation cabinet tuner
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate, gfx-instrument, gfx-headsmooth and gfx-amp
// (.jsfx-inc) in the same folder.
//
// Desert Ten - a little 10-watt solid-state practice combo with an 8" open-back speaker, in the spirit of the
// one the desert-rock records were made with (personal use; the sound is designed from scratch).
//   PRE         - the op-amp preamp gain: clean to a raspy rail clip.
//   SATURATION  - switches in the diode clipper with its midrange push: the gnarly, fuzzy tone.
//   LOW / MID / HIGH - the tone controls, 0..10 (5 = flat).
//   POST        - the volume into the 10-watt power amp: clean at first, then a hard solid-state clip.
//   CAB / MIC   - the 8" open-back speaker on or off (line out), and the mic from on axis to off axis.
//   GATE        - a noise gate before the amp (fully down = off).   TUNER - shows the note and mutes the output.
// THEME colours the control panel, pinstripe and lamp; HW switches between the faceplate and the flat look.
// The amp runs in linked stereo at twice the sample rate: two identical amps, one per side, sharing every control
// (a mono source comes out identical on both sides).
// ANTI-ALIASING (the house drive standard): first-order ADAA on all three clippers (the op-amp's rails, the diodes
//   and the power amp's rails; each stage's input gets a small pre-emphasis so its half-sample average does not dull
//   the top), a drive-tracking pre-filter into the op-amp (a low-pass sliding from 40 kHz down to 9 kHz at full PRE,
//   and a low shelf easing the lows below 150 Hz down by up to 1.5 dB) and a fixed post-shelf that makes up the
//   pre-filter's top at the default PRE. No drive-tracking knee: the solid-state clipping is meant to stay hard.
// PRE glides (25 ms) with everything that follows it, so a jump never clicks. CAB off: the line out follows PRE with a
//   shelf, a peak and a trim that keep its level and top end as before.
// DRIFT: the clipping diodes' balance wanders slightly. The DRIFT dial scales it (50% = the drift amount / speed
// settings, 100% = twice, 0 = none).
// IN / OUT: TRIM (with the GUARD key), SAT (the output soft clip is always on) along the bottom of the combo.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-headsmooth.jsfx-inc
import gfx-amp.jsfx-inc
import gfx-clip.jsfx-inc

slider1:5<0,10,0.1>-Pre
slider2:0<0,1,1{Off,On}>-Saturation
slider3:5<0,10,0.1>-Low
slider4:5<0,10,0.1>-Mid
slider5:5<0,10,0.1>-High
slider6:4<0,10,0.1>-Post
slider7:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider8:1<0,1,1{Off,On}>-Cabinet
slider9:3<0,10,0.1>-Mic position (on - off axis)
slider10:0<-24,12,0.1>-Output (dB)
slider11:0<0,1,1{Off,On}>-Tuner (mutes)
slider12:0<-24,12,0.1>-Input trim (dB)
slider13:0<0,1,1{Off,On}>-Input guard
slider14:25<0,100,1>-Drift amount (%)
slider15:0.25<0.02,2,0.01>-Drift speed (Hz)
slider16:0<0,100,1>-Band sat (%)
slider17:30<0,100,1>-Bias (%)
slider18:120<40,400,1>-Sat low band (Hz)
slider19:6000<2000,16000,10>-Sat high band (Hz)
slider20:-0.3<-24,0,0.1>-Ceiling (dB)
slider21:1<0,1,1{Off,Clip}>-(unused, was output stage)
// DRIFT dial: scales how far the clipping diodes' balance and the power amp's bias wander, and how fast
slider22:50<0,100,1>-Drift (%)
slider23:prs_sel=0<0,12,1{No preset,Init,Clean Practice,Edge of Break-up,Desert Crunch,Full Saturation Lead,Scooped Metal,Bluesy Mid Push,Bright Jangle,Off-Axis Warm,Direct Line,Dark Jazz,Bedroom Fuzz}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-desert-ten";                                  // the ? pop-up links to this manual

// ---------- the amp core, run at twice the sample rate ----------
// op-amp into its rails: a firm knee (k sets the hardness): r(x) = x / (1 + |x|^k)^(1/k)
function dt_rail(x, k) ( x / (1 + abs(x) ^ k) ^ (1 / k); );
// silicon diode pair to ground: soft-ish, with a slight imbalance
function dt_diode(x, a) ( x >= 0 ? 1 - exp(-x) : -(1 - exp(x * (1 + a))) / (1 + a); );
// ... and its antiderivative (F(0) = 0)
function dt_diodeF(x, a) local(b) ( x >= 0 ? x + exp(-x) - 1 : ( b = 1 + a; (exp(x * b) - 1) / (b * b) - x / b; ); );
// ANTI-ALIASING (the house drive standard): first-order ADAA on all three clippers, at 2x. The rails have no closed
// antiderivative, so each is a table (read linearly) with its exact running integral: DT_RN points over |x| <= DT_RU,
// a straight continuation beyond (the curve is within 1e-4 of the rail there). No pow() per sample.
DT_RN = 2048; DT_RU = 8; DT_RS = (DT_RN - 1) / DT_RU;
DT_R4 = 970000; DT_R8 = DT_R4 + 2 * (DT_RN + 2);      // (rail k = 4: curve, integral; then k = 8)
function dt_rbuild(t, k) local(i, x, c) (
  c = t + DT_RN + 1; i = 0;
  loop(DT_RN, x = i / DT_RS; t[i] = dt_rail(x, k); i += 1; );
  t[DT_RN] = t[DT_RN - 1]; c[0] = 0; i = 0;
  loop(DT_RN - 1, c[i + 1] = c[i] + 0.5 * (t[i] + t[i + 1]) / DT_RS; i += 1; );
);
function dt_rc(x, t) local(a, p, i) (
  a = min(abs(x) * DT_RS, DT_RN - 1.001); i = floor(a); p = a - i;
  a = t[i] + (t[i + 1] - t[i]) * p; x < 0 ? -a : a;
);
function dt_rF(x, t) local(a, p, i, c) (
  a = abs(x) * DT_RS; c = t + DT_RN + 1;
  a >= DT_RN - 1 ? c[DT_RN - 1] + t[DT_RN - 1] * (a - DT_RN + 1) / DT_RS : (
    i = floor(a); p = a - i; c[i] + (t[i] * p + 0.5 * (t[i + 1] - t[i]) * p * p) / DT_RS;
  );
);
dt_rbuild(DT_R4, 4); dt_rbuild(DT_R8, 8);
// one anti-aliased clipper: y = (F(u) - F(u1)) / (u - u1) (the curve at the midpoint when within 1e-5); each stage's
// input gets a first-order pre-emphasis (dt_eb) so the stage's half-sample average does not dull the top end
function dt_aar(x, t, o) instance(u1, f1, xp) local(u, f, d, y) (      // a rail table t, offset o
  u = x + dt_eb * (x - xp) + o; xp = x; f = dt_rF(u, t); d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : dt_rc(0.5 * (u + u1), t);
  u1 = u; f1 = f; y;
);
function dt_aad(x, o, a) instance(u1, f1, xp, ao, oo) local(u, f, d, y) (   // the diodes: offset o, imbalance a
  u1 === 1000000 ? ( u1 = o; xp = 0; f1 = dt_diodeF(u1, a); ao = a; oo = o; ) :           // back from rest
  a !== ao || o !== oo ? ( u1 += o - oo; f1 = dt_diodeF(u1, a); ao = a; oo = o; );   // re-read under a new curve
  u = x + dt_eb * (x - xp) + o; xp = x; f = dt_diodeF(u, a); d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : dt_diode(0.5 * (u + u1), a);
  u1 = u; f1 = f; y;
);
dt_eb = 0.25;
function amp_core(x) local(y) (
  y = ihp.am_run(pf.clp_pf_run(x));                  // the drive-tracking pre-filter (gfx-clip)
  y = (s1.dt_aar(y * g1, DT_R4, 0.06) - dt_r06) * c1;   // PRE: the op-amp stage (slightly off centre)
  slider2 ? (                                        // SATURATION: midrange push into the diodes
    y = shp.am_run(y); y = spk.am_run(y);
    y = s2.dt_aad(y * gs, dbias, dasy) - dt_diode(dbias, dasy);
    y = slp.am_run(y) * cs;
  ) : ( s2.u1 = 1000000; );                       // (switched out: the diodes re-read their rest point when back)
  y = tl.am_run(y); y = tm.am_run(y); y = th.am_run(y);     // tone controls
  y = phc.am_run(y) * pm;                            // POST into the power amp
  y = s3.dt_aar(y, DT_R8, 0);                        // 10 W solid state: clean, then a hard clip
  y = plp.am_run(y);
  y * mk;
);

// ---------- LINKED STEREO: the right side runs the same amp with its own memory. Each filter / clipper instance keeps
// one set of settings (made in update()) and two sets of state: the left side's (x1 ...) and the right side's (rx1 ...).
function am_runR(x) instance(b0, b1, b2, a1, a2, rx1, rx2, ry1, ry2) local(y) (
  y = b0 * x + b1 * rx1 + b2 * rx2 - a1 * ry1 - a2 * ry2;
  rx2 = rx1; rx1 = x; ry2 = ry1; ry1 = y;
  y;
);
function am_aa_runR(x) instance() ( this.f4.am_runR(this.f3.am_runR(this.f2.am_runR(this.f1.am_runR(x)))); );
function am_cab_runR(x) instance() (
  this.c7.am_runR(this.c6.am_runR(this.c5.am_runR(this.c4.am_runR(this.c3.am_runR(this.c2.am_runR(this.c1.am_runR(x)))))));
);
function dt_aarR(x, t, o) instance(ru1, rf1, rxp) local(u, f, d, y) (
  u = x + dt_eb * (x - rxp) + o; rxp = x; f = dt_rF(u, t); d = u - ru1;
  y = abs(d) > 0.00001 ? (f - rf1) / d : dt_rc(0.5 * (u + ru1), t);
  ru1 = u; rf1 = f; y;
);
function dt_aadR(x, o, a) instance(ru1, rf1, rxp, rao, roo) local(u, f, d, y) (
  ru1 === 1000000 ? ( ru1 = o; rxp = 0; rf1 = dt_diodeF(ru1, a); rao = a; roo = o; ) :
  a !== rao || o !== roo ? ( ru1 += o - roo; rf1 = dt_diodeF(ru1, a); rao = a; roo = o; );
  u = x + dt_eb * (x - rxp) + o; rxp = x; f = dt_diodeF(u, a); d = u - ru1;
  y = abs(d) > 0.00001 ? (f - rf1) / d : dt_diode(0.5 * (u + ru1), a);
  ru1 = u; rf1 = f; y;
);
function clpR_pf_run(x) instance(ic1, ic2, sx1, sy1, ric1, ric2, rsx1, rsy1) local(t1, t2, t3, t4, y) (
  t1 = ic1; t2 = ic2; t3 = sx1; t4 = sy1; ic1 = ric1; ic2 = ric2; sx1 = rsx1; sy1 = rsy1;
  y = this.clp_pf_run(x);
  ric1 = ic1; ric2 = ic2; rsx1 = sx1; rsy1 = sy1; ic1 = t1; ic2 = t2; sx1 = t3; sy1 = t4;
  y;
);
function amp_coreR(x) local(y) (
  y = ihp.am_runR(pf.clpR_pf_run(x));                  // the drive-tracking pre-filter (gfx-clip)
  y = (s1.dt_aarR(y * g1, DT_R4, 0.06) - dt_r06) * c1;   // PRE: the op-amp stage (slightly off centre)
  slider2 ? (                                        // SATURATION: midrange push into the diodes
    y = shp.am_runR(y); y = spk.am_runR(y);
    y = s2.dt_aadR(y * gs, dbias, dasy) - dt_diode(dbias, dasy);
    y = slp.am_runR(y) * cs;
  ) : ( s2.ru1 = 1000000; );                       // (switched out: the diodes re-read their rest point when back)
  y = tl.am_runR(y); y = tm.am_runR(y); y = th.am_runR(y);     // tone controls
  y = phc.am_runR(y) * pm;                            // POST into the power amp
  y = s3.dt_aarR(y, DT_R8, 0);                        // 10 W solid state: clean, then a hard clip
  y = plp.am_runR(y);
  y * mk;
);
dt_r06 = dt_rc(0.06, DT_R4);
// PRE glides (25 ms, per sample) and everything that follows it - the drive into the op-amp and the diodes, the
// pre-filter, the level trim and the line out - reads the glided value dt_gs, so a jump of the knob never clicks
function dt_gset() (
  g1 = exp(0.1151292546 * (dt_gs * 3.6 - 6)); c1 = exp(-0.06907755279 * (dt_gs * 3.6 - 6));   // -6 .. +30 dB into the op-amp
  gs = exp(0.1151292546 * (dt_gs * 1.2 + 14));                                              // +14 .. +26 dB into the diodes
);
// the level trim: driven hard, the pre-filtered, anti-aliased amp comes out a little louder than before (the clippers
// see less of the very top); dB at PRE 0, 1 .. 10, SATURATION off / on (pink noise, -21 dBFS RMS)
DT_TR = DT_R8 + 2 * (DT_RN + 2);
function dt_trow(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = DT_TR + k; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
dt_trow(0, 0, 0, 0, 0, 0, 0, 0, 0.15, 0.35, 0.63, 0.92);
dt_trow(11, 0.05, 0.05, 0.06, 0.08, 0.1, 0.16, 0.25, 0.38, 0.54, 0.7, 0.84);
function dt_trim(v, k) local(i, f) ( v = min(max(v, 0), 10); i = min(floor(v), 9); f = v - i; k += DT_TR; k[i] * (1 - f) + k[i + 1] * f; );
// the line out (CAB off): with PRE away from 5 the top end and level drift from the former amp's (the pre-filter); a
// high shelf (12 kHz), a peak (8 kHz) and a trim, all following PRE, put them back (dB at PRE 0, 1 .. 10, fitted on
// pink noise in 1/3 octaves): shelf, peak, trim rows - SATURATION off, then on
dt_trow(22, -2.04, -2.00, -1.76, -1.37, -0.81, 0.02, 1.16, 2.63, 4.32, 5.88, 7.02);
dt_trow(33, -0.40, -0.38, -0.36, -0.31, -0.24, -0.11, 0.10, 0.44, 0.91, 1.45, 2.04);
dt_trow(44, -0.02, 0.01, 0.03, 0.06, 0.09, 0.10, 0.07, 0.08, 0.03, -0.02, -0.10);
dt_trow(55, -1.94, -1.90, -1.67, -1.31, -0.79, -0.08, 0.84, 1.93, 3.16, 4.41, 5.51);
dt_trow(66, -0.46, -0.42, -0.38, -0.31, -0.22, -0.09, 0.10, 0.35, 0.70, 1.17, 1.73);
dt_trow(77, 0.06, 0.07, 0.07, 0.08, 0.06, 0.06, 0.05, 0.04, 0.02, -0.02, -0.08);
function dt_lo(k, v) ( dt_trim(v, k + 22); );

// the filters (only when a control they follow has moved: no sin / cos / tan per block otherwise)
function update() local(fs2, ch) (
  fs2 = 2 * srate;
  ch = slider1 + 3 * slider3 + 7 * slider4 + 11 * slider5 + 13 * slider6 + 17 * slider8 + 19 * slider9 + 23 * fs2;
  ch !== dt_lch ? ( dt_lch = ch;
  cs = 0.26;                                         // (PRE's drive: see dt_gset, it glides)
  pm = 10 ^ ((slider6 * 3.4 - 18) / 20); mk = 0.42 / (pm ^ 0.78);       // -18 .. +16 dB into the power amp
  ihp.am_bq(1, 80, 0.7, 0, fs2);
  shp.am_bq(1, 220, 0.7, 0, fs2);
  spk.am_bq(2, 900, 0.7, 8, fs2);
  slp.am_bq(0, 5000, 0.7, 0, fs2);
  tl.am_bq(4, 120, 0.7, (slider3 - 5) * 2.6, fs2);
  tm.am_bq(2, 700, 0.6, (slider4 - 5) * 2.6 + 1.5, fs2);
  th.am_bq(3, 2800, 0.7, (slider5 - 5) * 2.6, fs2);
  phc.am_bq(1, 50, 0.7, 0, fs2);
  plp.am_bq(0, 16000, 0.7, 0, fs2);
  cab.am_cab_set(slider8 ? 4 : 0, slider9);
  );
  dt_lk = slider2 ? 33 : 0;
  out_t = 10 ^ ((slider10 - dt_trim(dt_gs, slider2 ? 11 : 0) + (slider8 ? 0 : dt_lo(dt_lk + 22, dt_gs))) / 20);
  // the line out (CAB off) follows the glided PRE
  !slider8 && (dt_gs !== dt_lgs || dt_lk !== dt_llk) ? ( dt_lgs = dt_gs; dt_llk = dt_lk;
    lo1.am_bq(3, 0.25 * srate, 0.8, dt_lo(dt_lk, dt_gs), srate); lo2.am_bq(2, 0.1666667 * srate, 0.7, dt_lo(dt_lk + 11, dt_gs), srate); );
  drift_macro(slider22);
  drift = slider14 / 100 * dm_a; dspd = slider15 * dm_s;
  in_setup(slider12, slider13);
  ins_output_setup(16);   // output stage: CLIP, always on
);

up.am_aa(); dn.am_aa();
dt_gk = 1 - exp(-1 / (0.025 * srate)); dt_gs = slider1; dt_lgs = -1; dt_gset();   // PRE's glide
pf.clp_pf_cfg(40000, 9000, -1.5, 150); pf.clp_pf_reset();   // the house pre-filter: 40 kHz to 9 kHz, -1.5 dB lows
clp_kt_on = 0;                                           // no drive-tracking knee: solid-state clipping, meant hard
// the fixed post-shelf (host rate): makes up the pre-filter's top at the default PRE (the small-signal response there
// matches the former amp within 0.05 dB to 14 kHz, cab off)
pks.am_bq(3, 0.32713 * srate, 0.56, 5.55, srate);
dB1.drift_init(0.8 + rand(0.5)); dB2.drift_init(0.8 + rand(0.5));
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
sm = 1 - exp(-1 / (0.03 * srate));
mpk = 0;
!ui_dflt ? ui_thm = 5; !ui_dflt ? ui_hw = 1; !ui_dflt ? ui_kstyle = 0;   // defaults for new instances: Graphite (aluminium panel), hardware
BH_TOL = 0x141416;
update();
out_s = out_t; mute_s = 1;
!ui_dflt ? pr_cur = 1;
ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme

// ---------- a mono input runs one side ----------
// With the same signal on both inputs the two sides are bit-identical, so only the left one runs and the right copies its
// output. When the input turns stereo, the right side takes the left side's whole state first; after a stereo passage
// the sides are checked once a block and the shortcut returns once they are identical again.
// the right side's state taken from the left (135 variables)
function dt_lr_copy() (
  cab.c1.rx1 = cab.c1.x1; cab.c1.rx2 = cab.c1.x2; cab.c1.ry1 = cab.c1.y1; cab.c1.ry2 = cab.c1.y2; cab.c2.rx1 = cab.c2.x1; cab.c2.rx2 = cab.c2.x2;
  cab.c2.ry1 = cab.c2.y1; cab.c2.ry2 = cab.c2.y2; cab.c3.rx1 = cab.c3.x1; cab.c3.rx2 = cab.c3.x2; cab.c3.ry1 = cab.c3.y1; cab.c3.ry2 = cab.c3.y2;
  cab.c4.rx1 = cab.c4.x1; cab.c4.rx2 = cab.c4.x2; cab.c4.ry1 = cab.c4.y1; cab.c4.ry2 = cab.c4.y2; cab.c5.rx1 = cab.c5.x1; cab.c5.rx2 = cab.c5.x2;
  cab.c5.ry1 = cab.c5.y1; cab.c5.ry2 = cab.c5.y2; cab.c6.rx1 = cab.c6.x1; cab.c6.rx2 = cab.c6.x2; cab.c6.ry1 = cab.c6.y1; cab.c6.ry2 = cab.c6.y2;
  cab.c7.rx1 = cab.c7.x1; cab.c7.rx2 = cab.c7.x2; cab.c7.ry1 = cab.c7.y1; cab.c7.ry2 = cab.c7.y2; dn.f1.rx1 = dn.f1.x1; dn.f1.rx2 = dn.f1.x2;
  dn.f1.ry1 = dn.f1.y1; dn.f1.ry2 = dn.f1.y2; dn.f2.rx1 = dn.f2.x1; dn.f2.rx2 = dn.f2.x2; dn.f2.ry1 = dn.f2.y1; dn.f2.ry2 = dn.f2.y2;
  dn.f3.rx1 = dn.f3.x1; dn.f3.rx2 = dn.f3.x2; dn.f3.ry1 = dn.f3.y1; dn.f3.ry2 = dn.f3.y2; dn.f4.rx1 = dn.f4.x1; dn.f4.rx2 = dn.f4.x2;
  dn.f4.ry1 = dn.f4.y1; dn.f4.ry2 = dn.f4.y2; ihp.rx1 = ihp.x1; ihp.rx2 = ihp.x2; ihp.ry1 = ihp.y1; ihp.ry2 = ihp.y2; lo1.rx1 = lo1.x1;
  lo1.rx2 = lo1.x2; lo1.ry1 = lo1.y1; lo1.ry2 = lo1.y2; lo2.rx1 = lo2.x1; lo2.rx2 = lo2.x2; lo2.ry1 = lo2.y1; lo2.ry2 = lo2.y2; pf.ric1 = pf.ic1;
  pf.ric2 = pf.ic2; pf.rsx1 = pf.sx1; pf.rsy1 = pf.sy1; phc.rx1 = phc.x1; phc.rx2 = phc.x2; phc.ry1 = phc.y1; phc.ry2 = phc.y2; pks.rx1 = pks.x1;
  pks.rx2 = pks.x2; pks.ry1 = pks.y1; pks.ry2 = pks.y2; plp.rx1 = plp.x1; plp.rx2 = plp.x2; plp.ry1 = plp.y1; plp.ry2 = plp.y2; s1.rf1 = s1.f1;
  s1.ru1 = s1.u1; s1.rxp = s1.xp; s2.rao = s2.ao; s2.rf1 = s2.f1; s2.roo = s2.oo; s2.ru1 = s2.u1; s2.rxp = s2.xp; s3.rf1 = s3.f1; s3.ru1 = s3.u1;
  s3.rxp = s3.xp; shp.rx1 = shp.x1; shp.rx2 = shp.x2; shp.ry1 = shp.y1; shp.ry2 = shp.y2; slp.rx1 = slp.x1; slp.rx2 = slp.x2; slp.ry1 = slp.y1;
  slp.ry2 = slp.y2; spk.rx1 = spk.x1; spk.rx2 = spk.x2; spk.ry1 = spk.y1; spk.ry2 = spk.y2; th.rx1 = th.x1; th.rx2 = th.x2; th.ry1 = th.y1;
  th.ry2 = th.y2; tl.rx1 = tl.x1; tl.rx2 = tl.x2; tl.ry1 = tl.y1; tl.ry2 = tl.y2; tm.rx1 = tm.x1; tm.rx2 = tm.x2; tm.ry1 = tm.y1; tm.ry2 = tm.y2;
  up.f1.rx1 = up.f1.x1; up.f1.rx2 = up.f1.x2; up.f1.ry1 = up.f1.y1; up.f1.ry2 = up.f1.y2; up.f2.rx1 = up.f2.x1; up.f2.rx2 = up.f2.x2;
  up.f2.ry1 = up.f2.y1; up.f2.ry2 = up.f2.y2; up.f3.rx1 = up.f3.x1; up.f3.rx2 = up.f3.x2; up.f3.ry1 = up.f3.y1; up.f3.ry2 = up.f3.y2;
  up.f4.rx1 = up.f4.x1; up.f4.rx2 = up.f4.x2; up.f4.ry1 = up.f4.y1; up.f4.ry2 = up.f4.y2; ostR.ah.c1 = ostL.ah.c1; ostR.ah.lc1 = ostL.ah.lc1;
  ostR.ah.th1 = ostL.ah.th1; ostR.ah.x1 = ostL.ah.x1; ostR.ah.z1 = ostL.ah.z1; ostR.dcx = ostL.dcx; ostR.dcy = ostL.dcy; ostR.env = ostL.env;
  ostR.hz1 = ostL.hz1; ostR.hz2 = ostL.hz2; ostR.lz1 = ostL.lz1; ostR.lz2 = ostL.lz2;
);
function dt_lr_same() (
  cab.c1.rx1 == cab.c1.x1 && cab.c1.rx2 == cab.c1.x2 && cab.c1.ry1 == cab.c1.y1 && cab.c1.ry2 == cab.c1.y2 && cab.c2.rx1 == cab.c2.x1 &&
  cab.c2.rx2 == cab.c2.x2 && cab.c2.ry1 == cab.c2.y1 && cab.c2.ry2 == cab.c2.y2 && cab.c3.rx1 == cab.c3.x1 && cab.c3.rx2 == cab.c3.x2 &&
  cab.c3.ry1 == cab.c3.y1 && cab.c3.ry2 == cab.c3.y2 && cab.c4.rx1 == cab.c4.x1 && cab.c4.rx2 == cab.c4.x2 && cab.c4.ry1 == cab.c4.y1 &&
  cab.c4.ry2 == cab.c4.y2 && cab.c5.rx1 == cab.c5.x1 && cab.c5.rx2 == cab.c5.x2 && cab.c5.ry1 == cab.c5.y1 && cab.c5.ry2 == cab.c5.y2 &&
  cab.c6.rx1 == cab.c6.x1 && cab.c6.rx2 == cab.c6.x2 && cab.c6.ry1 == cab.c6.y1 && cab.c6.ry2 == cab.c6.y2 && cab.c7.rx1 == cab.c7.x1 &&
  cab.c7.rx2 == cab.c7.x2 && cab.c7.ry1 == cab.c7.y1 && cab.c7.ry2 == cab.c7.y2 && dn.f1.rx1 == dn.f1.x1 && dn.f1.rx2 == dn.f1.x2 &&
  dn.f1.ry1 == dn.f1.y1 && dn.f1.ry2 == dn.f1.y2 && dn.f2.rx1 == dn.f2.x1 && dn.f2.rx2 == dn.f2.x2 && dn.f2.ry1 == dn.f2.y1 &&
  dn.f2.ry2 == dn.f2.y2 && dn.f3.rx1 == dn.f3.x1 && dn.f3.rx2 == dn.f3.x2 && dn.f3.ry1 == dn.f3.y1 && dn.f3.ry2 == dn.f3.y2 &&
  dn.f4.rx1 == dn.f4.x1 && dn.f4.rx2 == dn.f4.x2 && dn.f4.ry1 == dn.f4.y1 && dn.f4.ry2 == dn.f4.y2 && ihp.rx1 == ihp.x1 && ihp.rx2 == ihp.x2 &&
  ihp.ry1 == ihp.y1 && ihp.ry2 == ihp.y2 && lo1.rx1 == lo1.x1 && lo1.rx2 == lo1.x2 && lo1.ry1 == lo1.y1 && lo1.ry2 == lo1.y2 && lo2.rx1 == lo2.x1 &&
  lo2.rx2 == lo2.x2 && lo2.ry1 == lo2.y1 && lo2.ry2 == lo2.y2 && pf.ric1 == pf.ic1 && pf.ric2 == pf.ic2 && pf.rsx1 == pf.sx1 && pf.rsy1 == pf.sy1 &&
  phc.rx1 == phc.x1 && phc.rx2 == phc.x2 && phc.ry1 == phc.y1 && phc.ry2 == phc.y2 && pks.rx1 == pks.x1 && pks.rx2 == pks.x2 && pks.ry1 == pks.y1 &&
  pks.ry2 == pks.y2 && plp.rx1 == plp.x1 && plp.rx2 == plp.x2 && plp.ry1 == plp.y1 && plp.ry2 == plp.y2 && s1.rf1 == s1.f1 && s1.ru1 == s1.u1 &&
  s1.rxp == s1.xp && s2.rao == s2.ao && s2.rf1 == s2.f1 && s2.roo == s2.oo && s2.ru1 == s2.u1 && s2.rxp == s2.xp && s3.rf1 == s3.f1 &&
  s3.ru1 == s3.u1 && s3.rxp == s3.xp && shp.rx1 == shp.x1 && shp.rx2 == shp.x2 && shp.ry1 == shp.y1 && shp.ry2 == shp.y2 && slp.rx1 == slp.x1 &&
  slp.rx2 == slp.x2 && slp.ry1 == slp.y1 && slp.ry2 == slp.y2 && spk.rx1 == spk.x1 && spk.rx2 == spk.x2 && spk.ry1 == spk.y1 && spk.ry2 == spk.y2 &&
  th.rx1 == th.x1 && th.rx2 == th.x2 && th.ry1 == th.y1 && th.ry2 == th.y2 && tl.rx1 == tl.x1 && tl.rx2 == tl.x2 && tl.ry1 == tl.y1 &&
  tl.ry2 == tl.y2 && tm.rx1 == tm.x1 && tm.rx2 == tm.x2 && tm.ry1 == tm.y1 && tm.ry2 == tm.y2 && up.f1.rx1 == up.f1.x1 && up.f1.rx2 == up.f1.x2 &&
  up.f1.ry1 == up.f1.y1 && up.f1.ry2 == up.f1.y2 && up.f2.rx1 == up.f2.x1 && up.f2.rx2 == up.f2.x2 && up.f2.ry1 == up.f2.y1 &&
  up.f2.ry2 == up.f2.y2 && up.f3.rx1 == up.f3.x1 && up.f3.rx2 == up.f3.x2 && up.f3.ry1 == up.f3.y1 && up.f3.ry2 == up.f3.y2 &&
  up.f4.rx1 == up.f4.x1 && up.f4.rx2 == up.f4.x2 && up.f4.ry1 == up.f4.y1 && up.f4.ry2 == up.f4.y2 && ostR.ah.c1 == ostL.ah.c1 &&
  ostR.ah.lc1 == ostL.ah.lc1 && ostR.ah.th1 == ostL.ah.th1 && ostR.ah.x1 == ostL.ah.x1 && ostR.ah.z1 == ostL.ah.z1 && ostR.dcx == ostL.dcx &&
  ostR.dcy == ostL.dcy && ostR.env == ostL.env && ostR.hz1 == ostL.hz1 && ostR.hz2 == ostL.hz2 && ostR.lz1 == ostL.lz1 && ostR.lz2 == ostL.lz2;
);
dt_sync = 0; dt_rst = 0;

// ---------- factory presets (JG, 28 Oct 2026); 1 = Init, the unit as it opens ----------
function load_preset(p) (
  p == 1 ? ( slider(1) = 5; slider(2) = 0; slider(3) = 5; slider(4) = 5; slider(5) = 5; slider(6) = 4; slider(7) = -80; slider(8) = 1; slider(9) = 3; slider(10) = 0; );   // Init
  p == 2 ? ( slider(1) = 3; slider(2) = 0; slider(3) = 5; slider(4) = 5; slider(5) = 6; slider(6) = 5; slider(7) = -80; slider(8) = 1; slider(9) = 2; slider(10) = 1.4; );   // Clean Practice
  p == 3 ? ( slider(1) = 6; slider(2) = 0; slider(3) = 5; slider(4) = 6; slider(5) = 5; slider(6) = 5; slider(7) = -80; slider(8) = 1; slider(9) = 3; slider(10) = -2.6; );   // Edge of Break-up
  p == 4 ? ( slider(1) = 6; slider(2) = 1; slider(3) = 5; slider(4) = 6.5; slider(5) = 5.5; slider(6) = 4; slider(7) = -80; slider(8) = 1; slider(9) = 3; slider(10) = -6.1; );   // Desert Crunch
  p == 5 ? ( slider(1) = 8.5; slider(2) = 1; slider(3) = 5; slider(4) = 7; slider(5) = 6; slider(6) = 3.5; slider(7) = -70; slider(8) = 1; slider(9) = 3; slider(10) = -5.9; );   // Full Saturation Lead
  p == 6 ? ( slider(1) = 9; slider(2) = 1; slider(3) = 7; slider(4) = 2.5; slider(5) = 7; slider(6) = 3.5; slider(7) = -55; slider(8) = 1; slider(9) = 3; slider(10) = 1.6; );   // Scooped Metal
  p == 7 ? ( slider(1) = 6.5; slider(2) = 0; slider(3) = 4.5; slider(4) = 7; slider(5) = 5; slider(6) = 4.5; slider(7) = -80; slider(8) = 1; slider(9) = 4; slider(10) = -3.4; );   // Bluesy Mid Push
  p == 8 ? ( slider(1) = 3.5; slider(2) = 0; slider(3) = 4; slider(4) = 5; slider(5) = 7.5; slider(6) = 5; slider(7) = -80; slider(8) = 1; slider(9) = 1; slider(10) = 0.7; );   // Bright Jangle
  p == 9 ? ( slider(1) = 6; slider(2) = 1; slider(3) = 5.5; slider(4) = 5.5; slider(5) = 5; slider(6) = 4; slider(7) = -80; slider(8) = 1; slider(9) = 8; slider(10) = -4.2; );   // Off-Axis Warm
  p == 10 ? ( slider(1) = 5; slider(2) = 0; slider(3) = 5; slider(4) = 5; slider(5) = 5; slider(6) = 4; slider(7) = -80; slider(8) = 0; slider(9) = 3; slider(10) = 1.4; );   // Direct Line
  p == 11 ? ( slider(1) = 3; slider(2) = 0; slider(3) = 6.5; slider(4) = 5; slider(5) = 3; slider(6) = 5; slider(7) = -80; slider(8) = 1; slider(9) = 5; slider(10) = 1.1; );   // Dark Jazz
  p == 12 ? ( slider(1) = 10; slider(2) = 1; slider(3) = 5; slider(4) = 5.5; slider(5) = 5.5; slider(6) = 2.5; slider(7) = -65; slider(8) = 1; slider(9) = 3; slider(10) = -1.8; );   // Bedroom Fuzz
  slider_automate(2 ^ 0); slider_automate(2 ^ 1); slider_automate(2 ^ 2); slider_automate(2 ^ 3); slider_automate(2 ^ 4); slider_automate(2 ^ 5); slider_automate(2 ^ 6); slider_automate(2 ^ 7); slider_automate(2 ^ 8); slider_automate(2 ^ 9);
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
!dt_sync && !dt_rst ? dt_sync = dt_lr_same();
update();
pf.clp_pf_block(dt_gs / 10, 2 * srate, samplesblock);
dinc = dspd * samplesblock / srate;
dasy = 0.15 + 0.1 * drift * dB1.drift_tick(dinc);
dbias = 0.03 * drift * dB2.drift_tick(dinc);

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_avail(0) != 0 ? file_var(0, pr_cur);   // the preset shown (28 Oct 2026)
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
dt_gs !== slider1 ? ( dt_gs += (slider1 - dt_gs) * dt_gk; abs(dt_gs - slider1) < 0.00001 ? dt_gs = slider1; dt_gset(); );
x = in_l; xr = in_r;
dt_m1 = dt_sync && x == xr;                              // mono in: the right side would only repeat the left
!dt_m1 ? ( dt_rst ? ( dt_lr_copy(); dt_rst = 0; ); x != xr ? dt_sync = 0; );
slider11 ? am_tun_push((x + xr) * 0.5);
g = gt.am_gate(abs(x) > abs(xr) ? x : xr, slider7);           // the gate (linked: the louder side)
x *= g; xr *= g;
// amp at 2x
z = up.am_aa_run(x * 2); dn.am_aa_run(amp_core(z));
z = up.am_aa_run(0);     y = dn.am_aa_run(amp_core(z)) * 2;
dt_m1 ? (
  dt_rst = 1;
  y = pks.am_run(y); y = cab.am_cab_run(y);
  !slider8 ? y = lo2.am_run(lo1.am_run(y));                                         // the line out
  yr = y;
) : (
  z = up.am_aa_runR(xr * 2); dn.am_aa_runR(amp_coreR(z));
  z = up.am_aa_runR(0);    yr = dn.am_aa_runR(amp_coreR(z)) * 2;
  y = pks.am_run(y); yr = pks.am_runR(yr);
  y = cab.am_cab_run(y); yr = cab.am_cab_runR(yr);
  !slider8 ? ( y = lo2.am_run(lo1.am_run(y)); yr = lo2.am_runR(lo1.am_runR(yr)); );   // the line out
);
out_s += (out_t - out_s) * sm;
mute_s += ((slider11 ? 0 : 1) - mute_s) * sm;
y *= out_s * mute_s; yr *= out_s * mute_s;
oL = ostL.ost_band(y); oR = dt_m1 ? oL : ostR.ost_band(yr);
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;
mpk = max(mpk, max(abs(spl0), abs(spl1)));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 780 315
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(780, 315);
ui_col(ui_hw ? 0x0B0C0D : C_BG); gfx_rect(0, 0, gfx_w, gfx_h);

// colours from the theme: the panel takes its light tone, the pinstripe and lamp its accent
// (Graphite keeps the aluminium panel with an orange stripe and lamp)
BH_PNL = ui_hw ? C_S2 : C_HDR; BH_INK = ui_ink(BH_PNL);
BH_ACC = ui_thm == 5 ? 0xFF8A1E : C_ACC;
BH_TXT = ui_hw ? 0xD8DCE2 : C_TITLE;

// a big control: the hardware knob, or the flat GFX knob
function bh_big(cx, cy, idx, vmin, vmax, vdef, step, label, fmt) (
  ui_hw ? ( pk_bkstep = step; pk_bigknob(cx * sc, cy * sc, 22 * sc, idx, vmin, vmax, vdef, 11, 0, 1, label, fmt); pk_bkstep = 0; )
        : ( knob_step = step; ui_section(0); C_INK = BH_INK; ui_knob(cx * sc, cy * sc, idx, vmin, vmax, vdef, 0, label, fmt); );
);

// ---------- the head: tolex box, control panel ----------
function bh_tolex(x, y, w, h) local(i, px, py) (
  ui_hw ? (
    ui_col(0x050506); ui_rrs(x * sc, y * sc, w * sc, h * sc, 8 * sc);
    ui_col(BH_TOL); ui_rrs((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, 7 * sc);
    i = 0;
    loop(900,                                       // the grain
      px = x + 4 + ((i * 7919) % 997) / 997 * (w - 8); py = y + 4 + ((i * 104729) % 991) / 991 * (h - 8);
      ui_cola(i % 2 ? 0xFFFFFF : 0x000000, i % 2 ? 0.035 : 0.25); gfx_rect(px * sc, py * sc, 1 * sc + 1, 1 * sc + 1);
      i += 1;
    );
    gfx_gradrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, 30 * sc, 1, 1, 1, 0.06, 0, 0, 0, 0, 0, 0, 0, -0.06 / (30 * sc));
  ) : (
    ui_col(C_BG); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  );
);
T = 8; TH = 298;
bh_tolex(8, T, 764, TH);
// name and the pilot lamp
gfx_setfont(6, "Trebuchet MS", 22 * sc, 'bi');
ui_hw ? ( ui_cola(0x000000, 0.6); gfx_x = 33 * sc; gfx_y = (T + 11) * sc; gfx_drawstr("Desert Ten"); );
ui_col(BH_TXT); gfx_x = 32 * sc; gfx_y = (T + 10) * sc; gfx_drawstr("Desert Ten");
gfx_setfont(4); ui_cola(BH_TXT, 0.6); gfx_x += 10 * sc; gfx_y = (T + 20) * sc; gfx_drawstr("GFX  ·  SOLID STATE 10"); ver_tag_at("v2", 16, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1);
// [PRESETS][<][>][LCD] (28 Oct 2026); the lamp and keys moved right to make room
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
dt_k = pk_preset(262 * sc, (T + 11) * sc, 296 * sc, 28 * sc, pr_cur, "Init|Clean Practice|Edge of Break-up|Desert Crunch|Full Saturation Lead|Scooped Metal|Bluesy Mid Push|Bright Jangle|Off-Axis Warm|Direct Line|Dark Jazz|Bedroom Fuzz");
dt_k > 0 ? ( prs_dirty = dt_k; pr_cur = dt_k; );
pk_led(576 * sc, (T + 24) * sc, 5 * sc, 1, BH_ACC);
ui_theme_picker(598 * sc, (T + 15) * sc);
BH_PNL = ui_hw ? C_S2 : C_HDR; BH_INK = ui_ink(BH_PNL); BH_ACC = ui_thm == 5 ? 0xFF8A1E : C_ACC; BH_TXT = ui_hw ? 0xD8DCE2 : C_TITLE;
ui_hw_toggle(626 * sc, (T + 15) * sc);
ui_size_picker(690 * sc, (T + 15) * sc);

// control panel
px0 = 20; py0 = T + 46; pw = 740; ph = 150;
ui_hw ? (
  ui_col(0x2A2C30); ui_rrs(px0 * sc, py0 * sc, pw * sc, ph * sc, 4 * sc);
  ui_col(BH_PNL); ui_rrs((px0 + 1) * sc, (py0 + 1) * sc, (pw - 2) * sc, (ph - 2) * sc, 3 * sc);
  gi = 0; loop(floor((ph - 4) / 2), ui_cola(gi % 3 ? 0xFFFFFF : 0x000000, gi % 3 ? 0.06 : 0.03);
    gfx_line((px0 + 2) * sc, (py0 + 2 + gi * 2) * sc, (px0 + pw - 3) * sc, (py0 + 2 + gi * 2) * sc); gi += 1; );
  ui_col(ui_mix(BH_ACC, 0x000000, 0.35)); gfx_rect((px0 + 2) * sc, (py0 + ph - 9) * sc, (pw - 4) * sc, 3 * sc);   // pinstripe
  pk_screw((px0 + 10) * sc, (py0 + 12) * sc); pk_screw((px0 + pw - 10) * sc, (py0 + 12) * sc);
) : (
  ui_col(BH_PNL); ui_rrect(px0 * sc, py0 * sc, pw * sc, ph * sc, 5 * sc);
  ui_col(C_ACC); gfx_rect(px0 * sc, (py0 + 8) * sc, 3 * sc, (ph - 16) * sc);
);

pk_ink = BH_INK; pk_bg = BH_PNL; pk_bkfs = 11; pk_nonum = 1; pk_ptr = 0xEDE3C8; pk_kstyle = 0;
ky = py0 + 72;
// the two sections, as on the original: GAIN (PRE, SATURATION, POST) | EQUALIZATION (LOW, MID, HIGH)
function dt_bracket(x1, x2, y, txt) local(w, h, cx) (
  gfx_setfont(4); gfx_measurestr(txt, w, h); cx = (x1 + x2) * 0.5 * sc;
  ui_col(BH_INK);
  gfx_line(x1 * sc, (y + 5) * sc, x1 * sc, y * sc); gfx_line(x2 * sc, (y + 5) * sc, x2 * sc, y * sc);
  gfx_line(x1 * sc, y * sc, cx - w * 0.5 - 5 * sc, y * sc); gfx_line(cx + w * 0.5 + 5 * sc, y * sc, x2 * sc, y * sc);
  gfx_x = cx - w * 0.5; gfx_y = y * sc - h * 0.5; gfx_drawstr(txt);
);
function dt_sep(x) (
  ui_hw ? ( ui_cola(0x000000, 0.35); gfx_rect(x * sc, (py0 + 6) * sc, max(1, sc), (ph - 18) * sc);
            ui_cola(0xFFFFFF, 0.45); gfx_rect(x * sc + max(1, sc), (py0 + 6) * sc, max(1, sc), (ph - 18) * sc); )
        : ( ui_cola(BH_INK, 0.25); gfx_rect(x * sc, (py0 + 8) * sc, max(1, sc), (ph - 16) * sc); );
);
dt_sep(340);
dt_bracket(80, 280, py0 + 16, "GAIN");
dt_bracket(430, 670, py0 + 16, "EQUALIZATION");
pk_kstyle = 7; pk_kcol = 0xE6E0D0;   // cream PRE cap
bh_big(90, ky, 1, 0, 10, 5, 0, "PRE", "%.1f");
ui_keycap(138 * sc, (ky + 18) * sc, 84 * sc, 22 * sc, "SATURATION", slider2, 1) ? ( slider2 = 1 - slider2; slider_automate(2 ^ 1); );
pk_kcol = 0x7FB2DC;                  // the blue POST cap
bh_big(270, ky, 6, 0, 10, 4, 0, "POST", "%.1f");
pk_kcol = 0x75787D;                  // grey EQ caps
bh_big(440, ky, 3, 0, 10, 5, 0, "LOW", "%.1f");
bh_big(550, ky, 4, 0, 10, 5, 0, "MID", "%.1f");
bh_big(660, ky, 5, 0, 10, 5, 0, "HIGH", "%.1f");
pk_kstyle = 0;
pk_nonum = 0; pk_bkfs = 15; pk_ptr = -1;

// lower strip: GATE | TUNER | CAB + MIC | OUTPUT + meter
ly = T + 246;
ui_section(2); C_INK = BH_TXT; ui_knonum = 2;
ui_knob(60 * sc, ly * sc, 7, -80, -20, -80, 0, "GATE", slider7 <= -79.5 ? "OFF" : "%.0f dB");
ui_keycap(108 * sc, (ly - 22) * sc, 56 * sc, 22 * sc, "TUNER", slider11, 1) ? ( slider11 = 1 - slider11; slider_automate(2 ^ 10); );
slider11 ? am_tun_draw(172 * sc, (ly - 24) * sc, 130 * sc, 44 * sc, 0xD8DCE2, 0xFFB030)
         : ( ui_col(0x0A0B0C); ui_rrect(172 * sc, (ly - 24) * sc, 130 * sc, 44 * sc, 3 * sc); gfx_setfont(4); ui_cola(0xD8DCE2, 0.3); ui_text(237 * sc, (ly - 7) * sc, "TUNER OFF"); );
ui_keycap(340 * sc, (ly - 22) * sc, 56 * sc, 22 * sc, "CAB", slider8, 1) ? ( slider8 = 1 - slider8; slider_automate(2 ^ 7); );
ui_knob(440 * sc, ly * sc, 9, 0, 10, 3, 0, "MIC", "%.1f");
ui_knob(560 * sc, ly * sc, 10, -24, 12, 0, 0, "OUTPUT", "%+.1f dB");
ui_knonum = 0;
bh_lv = max(mpk, bh_lv * 0.8); mpk = 0;
hs_leds(690, ly - 4, bh_lv, BH_TXT);

// bottom row: DRIFT | IN / OUT
// by = T + 294; kc = by + (ui_hw ? 40 : 48); // the flat knobs carry their name above
