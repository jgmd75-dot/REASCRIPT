// ui_knob(268 * sc, kc * sc, 22, 0, 100, 50, 0, "DRIFT", "%.0f%%");
// ui_io(338, kc - 30, 12, 13, 16, 21);
// ui_knonum = 0;


pk_end();
ui_end();
