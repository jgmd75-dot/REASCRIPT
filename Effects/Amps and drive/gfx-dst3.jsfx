desc:DST3 [drive] (GFX)
//tags: drive overdrive fuzz vibe preamp parallel stompbox guitar
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui, gfx-panel, gfx-dyn and gfx-clip (.jsfx-inc) in the same folder.
//
// DST3. A three-stage drive unit: three pedal circuits in series, then the house output stage (the sound is designed
// from scratch). Linked stereo: two identical signal paths sharing every control, the lamp and the supply.
// WIDTH (lit key, INPUT): the right side's parts sit slightly off the left (photocell corner and swing, drive, tone,
// fuzz, bias) for a subtle stereo spread from a mono source; off = both sides identical.
//   1 VIBE PREAMP - the discrete transistor input preamp of a classic 60s photocell vibe pedal: the low input impedance
//          that loads the pickup (a gentle top loss), the preamp's low-mid lift and coupling high-pass (30 Hz), its
//          gentle, lopsided soft saturation (anti-aliased), a rounded top (11 kHz) - and the pedal's four unequal
//          photocell phase stages running at a fixed, very subtle setting (about 1/10 of the usual speed and 1/10 of
//          the depth, 20 % blended): a warm, phase-coloured buffer, not a modulation effect.
//          IN (lit key), INPUT TRIM (-24 .. +12 dB: the level into everything after it), WIDTH (lit key: see above).
//   2 OVERDRIVE - two late-80s / 90s budget overdrive circuits (lit model keys):
//          MODEL A the classic op-amp overdrive: the diodes in the op-amp's feedback loop clip only the gain portion
//                 (high-passed at 720 Hz) and the clean input rides under it - soft, mid-humped; the feedback cap rolls
//                 the gain portion off from 60 kHz (DRIVE 0) to 5.6 kHz (full); a passive 723 Hz low-pass with TONE
//                 restoring the top; output roll-off 8.5 kHz.
//          MODEL B its bass variant: the gain portion high-passed at only 90 Hz (the lows clip too: it keeps the low
//                 end), asymmetric clipping (one diode against two), less gain, a wider feedback roll-off, the tone
//                 corner at 1.6 kHz and the output at 13 kHz.
//          DRIVE (audio taper; level-compensated), TONE.
//          House drive standard (gfx-clip): a drive-tracking pre-filter into the clipper (low-pass 40 kHz at DRIVE 0
//          sliding to 9.5 kHz at full, a 120 Hz low shelf going down to -1.5 dB), the ADAA knee clipper with the
//          drive-tracking knee ON (it softens as it is pushed). Coefficients follow the glided DRIVE every block.
//          A model change crossfades the two circuits (10 ms): no click.
//   3 FUZZ with transient retention - a gated, biased two-stage fuzz (a starved, lopsided first stage, a
//          symmetric second stage with a dead zone that gates the decay), after the overdrive. FUZZ (level-
//          compensated), BIAS (the first stage's bias: 0 = near symmetric and smooth, 5 = the standard starved and
//          lopsided bias, 10 = starved hard, sputtering). House standard: ADAA, pre-filter (18 -> 12 kHz,
//          180 Hz shelf to -2 dB), knee OFF. Both paths go through the same oversampling filters; the clean path is
//          delayed to match the clippers' half-sample lag and phase-matched to the fuzz path's filters (two allpasses at
//          4.2 kHz, within 50 degrees from 150 Hz to 9 kHz): no comb filtering when they sum.
//   BLEND - one large dial across the overdrive / fuzz divider: the overdrive -> fuzz chain against the clean signal
//          tapped AFTER column 1 (0 % = the preamp alone, 100 % = the chain alone). With the fuzz in, the clean
//          share rises on its own as FUZZ goes up (the dynamic link: up to 0.45 x FUZZ squared, two thirds of it
//          riding on the pick attack) so the natural attack stays under the fuzz; the panel shows the effective
//          blend, link included, while BLEND is touched. With the overdrive and fuzz both out, BLEND does nothing.
//   IN keys on every column (columns 2 and 3 too): each fades its circuit in / out (10 ms), click-free.
//   OVERSAMPLING: columns 2 and 3 (and the parallel clean path) run at 4x (two cascaded 2x stages of polyphase IIR
//          half-bands, 12 coefficients, flat to 20 kHz, ~105 dB rejection). Minimum phase: no latency to report.
//   DRIFT (0 - 100 %, 50 % = standard, 0 = none): "vibe lamp + supply" - the vibe's lamp and photocell wander slowly
//          within the subtle colour, and the drives' supply sags with what they draw (drawn down in ~30 ms on hard
//          hits, ~1.2 s to recover): drive heat and headroom breathe.
//   OUTPUT: LEVEL (the whole unit: 5 = matched, 10 = +6 dB, 0 = silent), BLEND (above); the house output stage (the
//          soft CLIP always on, ceiling -0.3 dBFS), IN / OUT meters.
//   PRESETS: 12 (Init + 11) plus Reset all to defaults. A preset sets the three columns (keys, model, knobs); INPUT
//          TRIM and DRIFT are left alone (Reset all restores them too). Levelled against Init on plucked guitar notes
//          and chords.

slider1:1<0,1,1{Out,In}>-Vibe preamp in
slider2:0<-24,12,0.1>-Input trim (dB)
slider3:1<0,1,1{Out,In}>-Overdrive in
slider4:0<0,1,1{Model A,Model B}>-Overdrive model
slider5:5<0,10,0.1>-Drive
slider6:5<0,10,0.1>-Tone
slider7:5<0,10,0.1>-Level (unit)
slider8:1<0,1,1{Out,In}>-Fuzz in
slider9:5<0,10,0.1>-Fuzz
slider10:50<0,100,1>-Blend (chain / clean, %)
slider12:50<0,100,1>-Drift (%)
slider13:5<0,10,0.1>-Fuzz bias
slider14:0<0,1,1{Off,On}>-Width
slider15:prs_sel=0<0,12,1{No preset,Init,Warm Buffer,Edge of Breakup,Mid Hump Lead,Bass Overdrive,Low End Grind,Stacked Grit,Fuzz Under Glass,Attack Keeper,Wall of Fuzz,Gated Sputter,Dry Fuzz Bed}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-clip.jsfx-inc

@init
#ui_man = "gfx-dst3";                                 // the ? pop-up links to this manual
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;             // gfx-clip: ADAA, pre-filters, knee tracking (the overdrive)

// ---------- small helpers ----------
function d3_op(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.49 * fs) / fs); );          // one-pole coefficient
function d3_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );                          // denormal housekeeping
function d3_apc(f) local(t) ( t = tan($pi * min(max(f, 5), 0.45 * srate) / srate); (t - 1) / (t + 1); );

// ---------- oversampling (two cascaded 2x stages = 4x): polyphase IIR half-band (two allpass chains, 12 coefficients: flat to 20 kHz,
// ~105 dB rejection; minimum phase, no latency to report) ----------
d3_h0 = 0.036681502164; d3_h1 = 0.136547624632; d3_h2 = 0.274631759379; d3_h3 = 0.423138617437;
d3_h4 = 0.561098697879; d3_h5 = 0.677540049974; d3_h6 = 0.769741833863; d3_h7 = 0.839889624850;
d3_h8 = 0.892260818004; d3_h9 = 0.931541959963; d3_h10 = 0.962094548378; d3_h11 = 0.987816370733;
// up: one sample in -> this.o0, this.o1 (chain A gives the even, chain B the odd output)
function hb_up(x) instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5, o0, o1) local(t, y) (
  t = x;
  y = d3_h0 * (t - ua0) + ux0; ux0 = t; ua0 = y; t = y;
  y = d3_h2 * (t - ua1) + ux1; ux1 = t; ua1 = y; t = y;
  y = d3_h4 * (t - ua2) + ux2; ux2 = t; ua2 = y; t = y;
  y = d3_h6 * (t - ua3) + ux3; ux3 = t; ua3 = y; t = y;
  y = d3_h8 * (t - ua4) + ux4; ux4 = t; ua4 = y; t = y;
  y = d3_h10 * (t - ua5) + ux5; ux5 = t; ua5 = y; o0 = y;
  t = x;
  y = d3_h1 * (t - ub0) + uy0; uy0 = t; ub0 = y; t = y;
  y = d3_h3 * (t - ub1) + uy1; uy1 = t; ub1 = y; t = y;
  y = d3_h5 * (t - ub2) + uy2; uy2 = t; ub2 = y; t = y;
  y = d3_h7 * (t - ub3) + uy3; uy3 = t; ub3 = y; t = y;
  y = d3_h9 * (t - ub4) + uy4; uy4 = t; ub4 = y; t = y;
  y = d3_h11 * (t - ub5) + uy5; uy5 = t; ub5 = y; o1 = y;
);
// down: two samples in (s0 then s1) -> one out
function hb_dn(s0, s1) instance(da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5, dy0, dy1, dy2, dy3, dy4, dy5) local(t, y, p) (
  t = s1;
  y = d3_h0 * (t - da0) + dx0; dx0 = t; da0 = y; t = y;
  y = d3_h2 * (t - da1) + dx1; dx1 = t; da1 = y; t = y;
  y = d3_h4 * (t - da2) + dx2; dx2 = t; da2 = y; t = y;
  y = d3_h6 * (t - da3) + dx3; dx3 = t; da3 = y; t = y;
  y = d3_h8 * (t - da4) + dx4; dx4 = t; da4 = y; t = y;
  y = d3_h10 * (t - da5) + dx5; dx5 = t; da5 = y; p = y;
  t = s0;
  y = d3_h1 * (t - db0) + dy0; dy0 = t; db0 = y; t = y;
  y = d3_h3 * (t - db1) + dy1; dy1 = t; db1 = y; t = y;
  y = d3_h5 * (t - db2) + dy2; dy2 = t; db2 = y; t = y;
  y = d3_h7 * (t - db3) + dy3; dy3 = t; db3 = y; t = y;
  y = d3_h9 * (t - db4) + dy4; dy4 = t; db4 = y; t = y;
  y = d3_h11 * (t - db5) + dy5; dy5 = t; db5 = y;
  0.5 * (p + y);
);
function hb_utidy() instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5) (
  ua0 = d3_tn(ua0); ua1 = d3_tn(ua1); ua2 = d3_tn(ua2); ua3 = d3_tn(ua3); ua4 = d3_tn(ua4); ua5 = d3_tn(ua5);
  ux0 = d3_tn(ux0); ux1 = d3_tn(ux1); ux2 = d3_tn(ux2); ux3 = d3_tn(ux3); ux4 = d3_tn(ux4); ux5 = d3_tn(ux5);
  ub0 = d3_tn(ub0); ub1 = d3_tn(ub1); ub2 = d3_tn(ub2); ub3 = d3_tn(ub3); ub4 = d3_tn(ub4); ub5 = d3_tn(ub5);
  uy0 = d3_tn(uy0); uy1 = d3_tn(uy1); uy2 = d3_tn(uy2); uy3 = d3_tn(uy3); uy4 = d3_tn(uy4); uy5 = d3_tn(uy5);
);
function hb_dtidy() instance(da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5, dy0, dy1, dy2, dy3, dy4, dy5) (
  da0 = d3_tn(da0); da1 = d3_tn(da1); da2 = d3_tn(da2); da3 = d3_tn(da3); da4 = d3_tn(da4); da5 = d3_tn(da5);
  dx0 = d3_tn(dx0); dx1 = d3_tn(dx1); dx2 = d3_tn(dx2); dx3 = d3_tn(dx3); dx4 = d3_tn(dx4); dx5 = d3_tn(dx5);
  db0 = d3_tn(db0); db1 = d3_tn(db1); db2 = d3_tn(db2); db3 = d3_tn(db3); db4 = d3_tn(db4); db5 = d3_tn(db5);
  dy0 = d3_tn(dy0); dy1 = d3_tn(dy1); dy2 = d3_tn(dy2); dy3 = d3_tn(dy3); dy4 = d3_tn(dy4); dy5 = d3_tn(dy5);
);

// ---------- level tables (dB, 11 points over 0 .. 10): the level compensation, interpolated ----------
D3T = 0;                                              // MODEL A at 0, MODEL B at 11, FUZZ at 22
function d3_tab(base, v) local(i, f) (
  v = min(max(v, 0), 1) * 10; i = min(floor(v), 9); f = v - i;
  10 ^ ((D3T[base + i] * (1 - f) + D3T[base + i + 1] * f) / 20);
);
function d3_tset(base, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) (
  D3T[base] = a0; D3T[base + 1] = a1; D3T[base + 2] = a2; D3T[base + 3] = a3; D3T[base + 4] = a4; D3T[base + 5] = a5;
  D3T[base + 6] = a6; D3T[base + 7] = a7; D3T[base + 8] = a8; D3T[base + 9] = a9; D3T[base + 10] = a10;
);
d3_tset(0,  -14.47, -15.23, -15.88, -16.80, -17.50, -18.53, -19.27, -20.09, -20.49, -21.09, -21.62);
d3_tset(11, -13.31, -14.34, -15.78, -17.32, -18.97, -20.35, -21.69, -23.04, -24.20, -24.25, -25.07);
d3_tset(22, -12.51, -16.81, -20.07, -22.81, -24.88, -26.21, -27.10, -27.76, -28.66, -29.33, -29.49);

// =====================================================================
// LINKED STEREO: every function below runs once per side (chL / chR namespaces); the controls, the lamp, the
// supply and the transient detector are shared, so the two sides behave as one unit. With WIDTH off a mono input
// comes out identical on both sides; WIDTH gives the right side slightly different component values.
// =====================================================================
// COLUMN 1: the vibe preamp (1x)
// =====================================================================
function c1_reset() instance(c_l1, c_lm, c_hs, c_o, c_s1x, c_s1y, c_s2x, c_s2y, c_s3x, c_s3y, c_s4x, c_s4y) (
  c_l1 = c_lm = c_hs = c_o = 0; c_s1x = c_s1y = c_s2x = c_s2y = c_s3x = c_s3y = c_s4x = c_s4y = 0;
  this.c1c.clp_reset();
);
function c1_run(x) instance(c_l1, c_lm, c_hs, c_o, c_s1x, c_s1y, c_s2x, c_s2y, c_s3x, c_s3y, c_s4x, c_s4y, c_a1, c_a2, c_a3, c_a4) local(y, h, a) (
  c_l1 += c1_kld * (x - c_l1);                       // the low input impedance loading the pickup
  c_lm += c1_klm * (c_l1 - c_lm);
  y = c_l1 + 0.26 * c_lm;                             // the preamp's low-mid lift (+2 dB below ~300 Hz)
  h = y - c_hs; c_hs += c1_khp * (y - c_hs);         // coupling high-pass (30 Hz)
  y = (this.c1c.clp_run(1.6 * h + 0.12) - c1_rb) * 0.625; // the transistor stage: lopsided soft saturation (ADAA)
  // the four unequal photocell phase stages (coefficients per block), blended 20 %
  a = c_a1 * y + c_s1x - c_a1 * c_s1y; c_s1x = y; c_s1y = a;
  h = c_a2 * a + c_s2x - c_a2 * c_s2y; c_s2x = a; c_s2y = h;
  a = c_a3 * h + c_s3x - c_a3 * c_s3y; c_s3x = h; c_s3y = a;
  h = c_a4 * a + c_s4x - c_a4 * c_s4y; c_s4x = a; c_s4y = h;
  y = 0.8 * y + 0.2 * h;
  c_o += c1_ktop * (y - c_o);                         // the rounded top
  1.315 * c_o;                                        // (level matched: IN = OUT on plucked notes)
);
// per block, per side: the phase stages' coefficients from the photocell's corner, clipper set-up, tidy
function c1_side(fb) instance(c_l1, c_lm, c_hs, c_o, c_s1x, c_s1y, c_s2x, c_s2y, c_s3x, c_s3y, c_s4x, c_s4y, c_a1, c_a2, c_a3, c_a4) (
  c_a1 = d3_apc(fb * 0.313); c_a2 = d3_apc(fb * 0.0214); c_a3 = d3_apc(fb * 10); c_a4 = d3_apc(fb);
  this.c1c.clp_set(1, 1, 0.75, 0);
  this.c1c.clp_tidy();
  c_l1 = d3_tn(c_l1); c_lm = d3_tn(c_lm); c_hs = d3_tn(c_hs); c_o = d3_tn(c_o);
  c_s1x = d3_tn(c_s1x); c_s1y = d3_tn(c_s1y); c_s2x = d3_tn(c_s2x); c_s2y = d3_tn(c_s2y);
  c_s3x = d3_tn(c_s3x); c_s3y = d3_tn(c_s3y); c_s4x = d3_tn(c_s4x); c_s4y = d3_tn(c_s4y);
);
// per block: the lamp (LFO -> bulb -> photocell), its drift (one lamp for both sides)
function c1_blk(n) local(u, k, v, fb) (
  c1_ph += 0.2 * (1 + 0.15 * dm_a * c1R.drift_tick(0.05 * dm_s * n / srate)) * n / srate;
  c1_ph -= floor(c1_ph);
  u = 0.5 + 0.5 * sin(2 * $pi * c1_ph);
  k = u > c1_bulb ? 1 - exp(-n / (0.015 * srate)) : 1 - exp(-n / (0.09 * srate)); c1_bulb += (u - c1_bulb) * k;
  k = c1_bulb > c1_ldr ? 1 - exp(-n / (0.005 * srate)) : 1 - exp(-n / (0.05 * srate)); c1_ldr += (c1_bulb - c1_ldr) * k;
  v = c1D.drift_tick(0.08 * dm_s * n / srate);
  c1_light = min(max(0.7 * c1_ldr + 0.15 + 0.22 * dm_a * v, 0), 1);
  fb = 380 * 2 ^ (0.07 * 1.75 * (2 * c1_light - 1));  // 1/10 of the usual depth
  chL.c1_side(fb);
  // WIDTH: the right side's photocell sits a little higher and moves against the left
  chR.c1_side(d3_wd > 0 ? fb + d3_wd * (380 * 1.35 * 2 ^ (0.07 * 1.75 * (1 - 2 * c1_light)) - fb) : fb);
  c1_rb = chL.c1c.clp_crv(0.12);
);

// =====================================================================
// COLUMN 2: the overdrive (4x) - one instance per model (odA, odB) per side, crossfaded on a change
// =====================================================================
function od_set(md, d, t, fs, n) instance(G, kfb, khp, ktl, tg, kol, kdc) local(tp, rf) (
  tp = (10 ^ (2 * d) - 1) / 99;                      // audio-taper DRIVE pot
  md == 0 ? (                                         // MODEL A: diodes in the feedback loop, 720 Hz into the gain
    rf = 51000 + 1500000 * tp; G = 1 + rf / 4700; kfb = d3_op(1 / (2 * $pi * min(rf, 700000) * 0.000000000051), fs);   // (gain to ~50 dB; the roll-off stops at ~4.5 kHz)
    khp = d3_op(720, fs); ktl = d3_op(723, fs); tg = 0.1 + 1.4 * t * t; kol = d3_op(8500, fs);
    this.clp_set(2, 0.45, 0.45, 0); this.clp_kt_cfg(0.1, 0.3);
  ) : (                                               // MODEL B: wide band, keeps the lows, asymmetric
    rf = 22000 + 900000 * tp; G = 1 + rf / 4700; kfb = d3_op(1 / (2 * $pi * min(rf, 450000) * 0.000000000033), fs);    // (gain to ~46 dB; the roll-off stops at ~10.7 kHz)
    khp = d3_op(90, fs); ktl = d3_op(1600, fs); tg = 0.2 + 1.3 * t * t; kol = d3_op(13000, fs);
    this.clp_set(2, 0.4, 0.7, 0); this.clp_kt_cfg(0.08, 0.25);
  );
  kdc = d3_op(15, fs);
  this.clp_knee(this.clp_kt_block(d, fs, n));
  this.clp_pf_cfg(40000, 9500, -1.5, 120);
  this.clp_pf_block(d, fs, n);
);
function od_run(x) instance(G, Gs, kfb, khp, ktl, tg, kol, kdc, hs, f1, t1, t2, dc) local(v, h, y) (
  Gs += (G - Gs) * d3_gsm2;
  v = this.clp_pf_run(x);                             // the drive-tracking pre-filter (into the clipper only)
  h = v - hs; hs += khp * (v - hs);
  f1 += kfb * (Gs * h - f1);                          // the gain portion and its feedback-cap roll-off
  y = x + d3_k2 * this.clp_run(f1 * d3_ik2);         // the clean input under the clipped gain portion
  t1 += ktl * (y - t1); y = t1 + tg * (y - t1);       // tone
  t2 += kol * (y - t2);
  y = t2 - dc; dc += kdc * (t2 - dc);
  y;
);
function od_reset() instance(G, Gs, hs, f1, t1, t2, dc) (
  Gs = G; hs = f1 = t1 = t2 = dc = 0; this.clp_reset(); this.clp_pf_reset();
);
function od_tidy() instance(hs, f1, t1, t2, dc) (
  hs = d3_tn(hs); f1 = d3_tn(f1); t1 = d3_tn(t1); t2 = d3_tn(t2); dc = d3_tn(dc); this.clp_tidy();
);

// =====================================================================
// COLUMN 3: the parallel fuzz (4x)
// =====================================================================
function fz_set(f, fs, n) (                           // shared coefficients
  fz_GA = 2.5 * 10 ^ (40 * f / 20); fz_GB = 3;
  fz_khp = d3_op(50, fs); fz_kL1 = d3_op(6000, fs); fz_kH1 = d3_op(80, fs); fz_kp = d3_op(5200, fs);
);
function fz_cfg(f, vbi, fs, n) instance(z_bA) (       // per side: the bias and the clippers
  // BIAS: the first stage's operating point against its lopsided clipper (+1 / -0.6, centre 0.2): 0 = centred
  // (symmetric, smooth), 5 = 0.15 (the standard), 10 = starved hard towards the near rail (gated, sputtering)
  z_bA = vbi <= 0.5 ? 0.2 - 0.1 * vbi : 0.15 - 0.6 * ((vbi - 0.5) * 2) ^ 1.5;
  this.fzA.clp_set(1, 1, 0.6, 0);
  this.fzB.clp_set(1, 0.8, 0.8, 0.02 + 0.05 * f + 0.3 * (1 - d3_kfb));
  this.fzA.clp_pf_cfg(18000, 12000, -2, 180); this.fzA.clp_pf_block(f, fs, n);
);
function fz_rc() instance(z_bA, z_rA) ( z_rA = this.fzA.clp_crv(z_bA * d3_ikf); );
function fz_run(x) instance(z_GAs, z_hs, z_s1, z_s2, z_p1, z_p2, z_bA, z_rA) local(v, h, a) (
  z_GAs += (fz_GA - z_GAs) * d3_gsm2;
  v = this.fzA.clp_pf_run(x);
  h = v - z_hs; z_hs += fz_khp * (v - z_hs);
  a = d3_kf * (this.fzA.clp_run((z_GAs * h + z_bA) * d3_ikf) - z_rA);   // starved, biased first stage
  z_s1 += fz_kL1 * (a - z_s1); z_s2 += fz_kH1 * (z_s1 - z_s2);
  a = d3_kf * this.fzB.clp_run(fz_GB * (z_s1 - z_s2) * d3_ikf);          // second stage, its dead zone gates
  z_p1 += fz_kp * (a - z_p1); z_p2 += fz_kp * (z_p1 - z_p2);
  z_p2;
);
function fz_reset() instance(z_GAs, z_hs, z_s1, z_s2, z_p1, z_p2) (
  z_GAs = fz_GA; z_hs = z_s1 = z_s2 = z_p1 = z_p2 = 0; this.fzA.clp_reset(); this.fzA.clp_pf_reset(); this.fzB.clp_reset();
);

// ---------- one oversampled (4x) sample through columns 2 and 3 (s: column 1's output, the clean tap) ----------
function d3_x2(s) instance(lw, lf, ax1, ay1, ax2, ay2, dp) local(o2, w, w2, y) (
  o2 = s;
  d3_c2on ? (
    w = 0;
    d3_wA > 0 ? w = d3_wA * d3_trA * this.odA.od_run(s);
    d3_wB > 0 ? w += d3_wB * d3_trB * this.odB.od_run(s);
    lw = w;
    o2 = s + d3_g2 * (w - s);
  );
  y = o2;
  d3_c3on ? (
    w = this.fz_run(o2); lf = w;
    y = o2 + d3_g3 * (w * d3_ftr - o2);
  );
  // the clean tap (column 1's output): with the fuzz in, one 4x sample late (the clippers' lag) and through two
  // allpasses (4.2 kHz) that follow the phase of the fuzz path's filters: the two paths sum without comb notches
  w = d3_apk * dp + ax1 - d3_apk * ay1; ax1 = dp; ay1 = w;
  w2 = d3_apk * w + ax2 - d3_apk * ay2; ax2 = w; ay2 = w2;
  w2 = s + d3_g3 * (w2 - s);
  // BLEND: the chain against the clean tap (only while the overdrive or the fuzz is in)
  y = s + max(d3_g2, d3_g3) * (d3_wet * y + d3_dry * w2 - s);
  dp = s;
  y;
);
// one 1x sample through the oversampled columns 2 and 3 (1x -> 2x -> 4x -> 2x -> 1x)
function d3_os(s) instance() local(y0, y1, z0, z1) (
  this.hbA.hb_up(s);
  this.hbB.hb_up(this.hbA.o0); y0 = this.d3_x2(this.hbB.o0); y1 = this.d3_x2(this.hbB.o1); z0 = this.hbC.hb_dn(y0, y1);
  this.hbB.hb_up(this.hbA.o1); y0 = this.d3_x2(this.hbB.o0); y1 = this.d3_x2(this.hbB.o1); z1 = this.hbC.hb_dn(y0, y1);
  this.hbD.hb_dn(z0, z1);
);
// output coupling (15 Hz)
function d3_dc(y) instance(dcx, dcy) ( dcy = y - dcx + d3_dcr * dcy; dcx = y; dcy; );
// per block: denormal housekeeping for one side
function d3_tidy() instance(lw, lf, ax1, ay1, ax2, ay2, dp, dcx, dcy, z_hs, z_s1, z_s2, z_p1, z_p2) (
  this.hbA.hb_utidy(); this.hbB.hb_utidy(); this.hbC.hb_dtidy(); this.hbD.hb_dtidy(); this.odA.od_tidy(); this.odB.od_tidy();
  z_hs = d3_tn(z_hs); z_s1 = d3_tn(z_s1); z_s2 = d3_tn(z_s2); z_p1 = d3_tn(z_p1); z_p2 = d3_tn(z_p2);
  this.fzA.clp_tidy(); this.fzB.clp_tidy();
  ax1 = d3_tn(ax1); ay1 = d3_tn(ay1); ax2 = d3_tn(ax2); ay2 = d3_tn(ay2); dp = d3_tn(dp);
  dcx = d3_tn(dcx); dcy = d3_tn(dcy);
);

