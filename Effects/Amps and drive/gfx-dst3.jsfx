  chR.hbB.uy1 == chL.hbB.uy1 && chR.hbB.uy2 == chL.hbB.uy2 && chR.hbB.uy3 == chL.hbB.uy3 && chR.hbB.uy4 == chL.hbB.uy4 && chR.hbB.uy5 == chL.hbB.uy5 &&
  chR.hbC.da0 == chL.hbC.da0 && chR.hbC.da1 == chL.hbC.da1 && chR.hbC.da2 == chL.hbC.da2 && chR.hbC.da3 == chL.hbC.da3 && chR.hbC.da4 == chL.hbC.da4 &&
  chR.hbC.da5 == chL.hbC.da5 && chR.hbC.db0 == chL.hbC.db0 && chR.hbC.db1 == chL.hbC.db1 && chR.hbC.db2 == chL.hbC.db2 && chR.hbC.db3 == chL.hbC.db3 &&
  chR.hbC.db4 == chL.hbC.db4 && chR.hbC.db5 == chL.hbC.db5 && chR.hbC.dx0 == chL.hbC.dx0 && chR.hbC.dx1 == chL.hbC.dx1 && chR.hbC.dx2 == chL.hbC.dx2 &&
  chR.hbC.dx3 == chL.hbC.dx3 && chR.hbC.dx4 == chL.hbC.dx4 && chR.hbC.dx5 == chL.hbC.dx5 && chR.hbC.dy0 == chL.hbC.dy0 && chR.hbC.dy1 == chL.hbC.dy1 &&
  chR.hbC.dy2 == chL.hbC.dy2 && chR.hbC.dy3 == chL.hbC.dy3 && chR.hbC.dy4 == chL.hbC.dy4 && chR.hbC.dy5 == chL.hbC.dy5 && chR.hbD.da0 == chL.hbD.da0 &&
  chR.hbD.da1 == chL.hbD.da1 && chR.hbD.da2 == chL.hbD.da2 && chR.hbD.da3 == chL.hbD.da3 && chR.hbD.da4 == chL.hbD.da4 && chR.hbD.da5 == chL.hbD.da5 &&
  chR.hbD.db0 == chL.hbD.db0 && chR.hbD.db1 == chL.hbD.db1 && chR.hbD.db2 == chL.hbD.db2 && chR.hbD.db3 == chL.hbD.db3 && chR.hbD.db4 == chL.hbD.db4 &&
  chR.hbD.db5 == chL.hbD.db5 && chR.hbD.dx0 == chL.hbD.dx0 && chR.hbD.dx1 == chL.hbD.dx1 && chR.hbD.dx2 == chL.hbD.dx2 && chR.hbD.dx3 == chL.hbD.dx3 &&
  chR.hbD.dx4 == chL.hbD.dx4 && chR.hbD.dx5 == chL.hbD.dx5 && chR.hbD.dy0 == chL.hbD.dy0 && chR.hbD.dy1 == chL.hbD.dy1 && chR.hbD.dy2 == chL.hbD.dy2 &&
  chR.hbD.dy3 == chL.hbD.dy3 && chR.hbD.dy4 == chL.hbD.dy4 && chR.hbD.dy5 == chL.hbD.dy5 && chR.lf == chL.lf && chR.lw == chL.lw &&
  chR.odA.G == chL.odA.G && chR.odA.Gs == chL.odA.Gs && chR.odA.a1 == chL.odA.a1 && chR.odA.a2 == chL.odA.a2 && chR.odA.a3 == chL.odA.a3 &&
  chR.odA.ad1 == chL.odA.ad1 && chR.odA.cd == chL.odA.cd && chR.odA.cn == chL.odA.cn && chR.odA.cp == chL.odA.cp && chR.odA.cw == chL.odA.cw &&
  chR.odA.dc == chL.odA.dc && chR.odA.f1 == chL.odA.f1 && chR.odA.fc == chL.odA.fc && chR.odA.gd == chL.odA.gd && chR.odA.hs == chL.odA.hs &&
  chR.odA.ic1 == chL.odA.ic1 && chR.odA.ic2 == chL.odA.ic2 && chR.odA.kdc == chL.odA.kdc && chR.odA.kfb == chL.odA.kfb && chR.odA.khp == chL.odA.khp &&
  chR.odA.kol == chL.odA.kol && chR.odA.kti == chL.odA.kti && chR.odA.ktl == chL.odA.ktl && chR.odA.kw == chL.odA.kw && chR.odA.kw0 == chL.odA.kw0 &&
  chR.odA.kw1 == chL.odA.kw1 && chR.odA.pff0 == chL.odA.pff0 && chR.odA.pff1 == chL.odA.pff1 && chR.odA.pfi == chL.odA.pfi &&
  chR.odA.pfsd == chL.odA.pfsd && chR.odA.pfsf == chL.odA.pfsf && chR.odA.sa1 == chL.odA.sa1 && chR.odA.sb0 == chL.odA.sb0 &&
  chR.odA.sb1 == chL.odA.sb1 && chR.odA.sx1 == chL.odA.sx1 && chR.odA.sy1 == chL.odA.sy1 && chR.odA.t1 == chL.odA.t1 && chR.odA.t2 == chL.odA.t2 &&
  chR.odA.tg == chL.odA.tg && chR.odA.ty == chL.odA.ty && chR.odA.x1 == chL.odA.x1 && chR.odB.G == chL.odB.G && chR.odB.Gs == chL.odB.Gs &&
  chR.odB.a1 == chL.odB.a1 && chR.odB.a2 == chL.odB.a2 && chR.odB.a3 == chL.odB.a3 && chR.odB.ad1 == chL.odB.ad1 && chR.odB.cd == chL.odB.cd &&
  chR.odB.cn == chL.odB.cn && chR.odB.cp == chL.odB.cp && chR.odB.cw == chL.odB.cw && chR.odB.dc == chL.odB.dc && chR.odB.f1 == chL.odB.f1 &&
  chR.odB.fc == chL.odB.fc && chR.odB.gd == chL.odB.gd && chR.odB.hs == chL.odB.hs && chR.odB.ic1 == chL.odB.ic1 && chR.odB.ic2 == chL.odB.ic2 &&
  chR.odB.kdc == chL.odB.kdc && chR.odB.kfb == chL.odB.kfb && chR.odB.khp == chL.odB.khp && chR.odB.kol == chL.odB.kol && chR.odB.kti == chL.odB.kti &&
  chR.odB.ktl == chL.odB.ktl && chR.odB.kw == chL.odB.kw && chR.odB.kw0 == chL.odB.kw0 && chR.odB.kw1 == chL.odB.kw1 && chR.odB.pff0 == chL.odB.pff0 &&
  chR.odB.pff1 == chL.odB.pff1 && chR.odB.pfi == chL.odB.pfi && chR.odB.pfsd == chL.odB.pfsd && chR.odB.pfsf == chL.odB.pfsf &&
  chR.odB.sa1 == chL.odB.sa1 && chR.odB.sb0 == chL.odB.sb0 && chR.odB.sb1 == chL.odB.sb1 && chR.odB.sx1 == chL.odB.sx1 && chR.odB.sy1 == chL.odB.sy1 &&
  chR.odB.t1 == chL.odB.t1 && chR.odB.t2 == chL.odB.t2 && chR.odB.tg == chL.odB.tg && chR.odB.ty == chL.odB.ty && chR.odB.x1 == chL.odB.x1 &&
  chR.z_GAs == chL.z_GAs && chR.z_bA == chL.z_bA && chR.z_hs == chL.z_hs && chR.z_p1 == chL.z_p1 && chR.z_p2 == chL.z_p2 && chR.z_rA == chL.z_rA &&
  chR.z_s1 == chL.z_s1 && chR.z_s2 == chL.z_s2;
);

// ---------- presets ----------
function d3_cols(a, m, d, t, b, f, bl, lv) (
  slider3 = a; slider4 = m; slider5 = d; slider6 = t; slider8 = b; slider9 = f; slider10 = bl; slider7 = lv;
);
#d3_pm = "Init|Warm Buffer|Edge of Breakup|Mid Hump Lead|Bass Overdrive|Low End Grind|Stacked Grit|Fuzz Under Glass|Attack Keeper|Wall of Fuzz|Gated Sputter|Dry Fuzz Bed";
function load_preset(p) local(i) (
  slider1 = 1; slider13 = 5;
  d3_cols(1, 0, 5, 5, 1, 5, 50, 5);
  p == 2  ? ( d3_cols(0, 0, 5, 5, 0, 5, 100, 5); ) :                  // Warm Buffer
  p == 3  ? ( d3_cols(1, 0, 2, 6, 0, 5, 100, 4.8); ) :                  // Edge of Breakup
  p == 4  ? ( d3_cols(1, 0, 7.5, 6.5, 0, 5, 100, 4.6); ) :              // Mid Hump Lead
  p == 5  ? ( d3_cols(1, 1, 5.5, 5, 0, 5, 100, 5.6); ) :                // Bass Overdrive
  p == 6  ? ( d3_cols(1, 1, 8.5, 4, 1, 3, 30, 4.9); ) :                // Low End Grind
  p == 7  ? ( d3_cols(1, 0, 6, 5.5, 1, 4, 35, 4.9); ) :                // Stacked Grit
  p == 8  ? ( d3_cols(1, 0, 2.5, 4.5, 1, 7, 60, 5.3); ) :              // Fuzz Under Glass
  p == 9  ? ( d3_cols(0, 0, 5, 5, 1, 8, 75, 5.4); ) :                  // Attack Keeper
  p == 10 ? ( d3_cols(1, 0, 7, 6, 1, 10, 90, 5.9); ) :                 // Wall of Fuzz
  p == 11 ? ( d3_cols(0, 1, 5, 5, 1, 9.5, 100, 6.2); ) :               // Gated Sputter
  p == 12 ? ( d3_cols(1, 1, 3, 5, 1, 6, 25, 4.9); ) :                  // Dry Fuzz Bed
  p == 13 ? ( slider2 = 0; slider12 = 50; slider14 = 0; );              // Reset all to defaults
  i = 1; loop(14, ui_auto(i); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

// ---------- state ----------
function d3_srinit() (
  d3_sr = srate; d3_fs2 = 4 * srate;              // (d3_fs2: the oversampled rate, 4x)
  c1_kld = d3_op(12500, srate); c1_klm = d3_op(300, srate); c1_khp = d3_op(30, srate); c1_ktop = d3_op(11000, srate);
  d3_fst = 1 / (0.01 * srate);                        // key / model fades: 10 ms
  d3_gsm = 1 - exp(-1 / (0.012 * srate));             // gains: 12 ms
  d3_gsm2 = 1 - exp(-1 / (0.012 * d3_fs2));
  d3_eat = 1 - exp(-1 / (0.03 * srate)); d3_ert = 1 - exp(-1 / (1.2 * srate));       // supply: draw / recovery
  d3_tfa = 1 - exp(-1 / (0.0005 * srate)); d3_tfr = 1 - exp(-1 / (0.02 * srate));    // transient: fast envelope
  d3_tsa = 1 - exp(-1 / (0.04 * srate)); d3_tsr = 1 - exp(-1 / (0.3 * srate));       // slow envelope
  d3_tsm = 1 - exp(-1 / (0.002 * srate));
  d3_dcr = 1 - 2 * $pi * 15 / srate;
  d3_apk = tan($pi * 4200 / d3_fs2); d3_apk = (d3_apk - 1) / (d3_apk + 1);   // the clean tap's phase-match allpasses
  ost_init(0);
);
d3_srinit();
in_init();
ostL.ost_ch_init();
c1R.drift_init(0.8 + rand(1) * 0.4); c1D.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
c1_bulb = c1_ldr = 0.5; c1_ph = rand(1); c1_light = 0.5;
d3_sync = 0; d3_rst = 0;                              // (the block check finds the two sides in step)
d3_k2 = d3_ik2 = d3_kf = d3_ikf = 1; d3_kfb = 1; d3_wd = slider14 >= 0.5;
d3_g1 = slider1 >= 0.5; d3_g2 = slider3 >= 0.5; d3_g3 = slider8 >= 0.5;
d3_wA = slider4 < 0.5; d3_wB = 1 - d3_wA; d3_c2on = d3_c3on = 1;
d3_snap = 1;                                          // the first block snaps every glide

ui_thm = 5; ui_hw = 1;                                // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );                // new instances open in Medium, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@block
prs_chk();
srate != d3_sr ? d3_srinit();
in_setup(slider2, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);                // the house output stage: CLIP, always on
drift_macro(slider12);
// targets
d3_t1 = slider1 >= 0.5; d3_t2 = slider3 >= 0.5; d3_t3 = slider8 >= 0.5; d3_tm = slider4 >= 0.5;
d3_qd = min(max(slider5, 0), 10) / 10; d3_qt = min(max(slider6, 0), 10) / 10; d3_ql = min(max(slider7, 0), 10) / 10;
d3_qf = min(max(slider9, 0), 10) / 10; d3_qb = min(max(slider10, 0), 100) / 100; d3_qbi = min(max(slider13, 0), 10) / 10;
// knob glides (30 ms), per block
d3_gl = d3_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
d3_vd += (d3_qd - d3_vd) * d3_gl; d3_vt += (d3_qt - d3_vt) * d3_gl; d3_vf += (d3_qf - d3_vf) * d3_gl; d3_vbi += (d3_qbi - d3_vbi) * d3_gl;
d3_snap = 0;
// coefficients from the glided knobs (both models: the crossfade needs the incoming one ready)
d3_n2 = 4 * samplesblock;
// WIDTH: the right side's parts a little off the left (drive +10 %, tone -10 %, fuzz +8 %, bias +12 %), glided
d3_wd += ((slider14 >= 0.5) - d3_wd) * (d3_snap ? 1 : d3_gl);
slider14 < 0.5 && d3_wd < 0.000001 ? d3_wd = 0;         // (settles exactly: mono inputs can then run one side)
d3_rst && d3_wd > 0 ? ( d3_lr_copy(); d3_rst = 0; );
!d3_sync && d3_wd == 0 && !d3_rst ? d3_sync = d3_lr_same();
chL.odA.od_set(0, d3_vd, d3_vt, d3_fs2, d3_n2);
chL.odB.od_set(1, d3_vd, d3_vt, d3_fs2, d3_n2);
chR.odA.od_set(0, min(d3_vd * (1 + 0.1 * d3_wd), 1), d3_vt * (1 - 0.1 * d3_wd), d3_fs2, d3_n2);
chR.odB.od_set(1, min(d3_vd * (1 + 0.1 * d3_wd), 1), d3_vt * (1 - 0.1 * d3_wd), d3_fs2, d3_n2);
d3_trA = d3_tab(0, d3_vd); d3_trB = d3_tab(11, d3_vd);
fz_set(d3_vf, d3_fs2, d3_n2);
chL.fz_cfg(d3_vf, d3_vbi, d3_fs2, d3_n2);
chR.fz_cfg(min(d3_vf * (1 + 0.08 * d3_wd), 1), min(d3_vbi + 0.12 * d3_wd, 1), d3_fs2, d3_n2);
d3_ftr = d3_tab(22, d3_vf);
// levels: LEVEL (the unit) 5 = matched (10 = +6 dB), the blend
d3_lv2 = d3_ql <= 0.5 ? sqr(d3_ql / 0.5) : 1 + (d3_ql - 0.5) * 2;
d3_lk = d3_t3 * 0.45 * d3_qf * d3_qf;                 // the dynamic link: clean rises with FUZZ (fuzz in only)
d3_dst = 1 - d3_qb + 0.35 * d3_lk;                    // the steady clean share (what the level is normalised on)
d3_nrm = 1 / max((d3_qb ^ 1.4 + d3_dst ^ 1.4) ^ (1 / 1.4), 0.000001);   // (partly correlated paths: a 1.4-norm)
d3_twet = d3_qb * d3_nrm; d3_tdry0 = (1 - d3_qb) * d3_nrm; d3_tlk = d3_lk * d3_nrm;
// DRIFT: the supply's depth and where it starts
d3_sg = 0.08 * dm_a; d3_kb = 1 - 0.03 * dm_a;
d3_kfb = d3_kf;
c1_blk(samplesblock);
// denormal housekeeping
chL.d3_tidy(); chR.d3_tidy();
d3_e2 = d3_tn(d3_e2); d3_e3 = d3_tn(d3_e3); d3_ef = d3_tn(d3_ef); d3_es = d3_tn(d3_es); d3_trs = d3_tn(d3_trs);
ostL.dcx = d3_tn(ostL.dcx); ostL.dcy = d3_tn(ostL.dcy);
// the panel's mailboxes (the audio thread writes, the panel reads and clears the peaks)
d3a_pi = max(d3a_pi, d3_pi); d3_pi = 0; d3a_po = max(d3a_po, d3_po); d3_po = 0;
d3a_tr = max(d3a_tr, d3_trm); d3_trm = 0;
d3a_sup = d3_kmin; d3_kmin = 1;
d3a_lamp = c1_light;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
in_process(spl0, spl1);
d3_xl = in_l; d3_xr = in_r;
abs(d3_xl) < 0.000000000000001 ? d3_xl = 0;
abs(d3_xr) < 0.000000000000001 ? d3_xr = 0;
d3_pi = max(d3_pi, max(abs(d3_xl), abs(d3_xr)));
// the keys and the model: 10 ms fades (a circuit coming back in starts from a clean state)
d3_g1 != d3_t1 ? ( d3_g1 == 0 ? ( chL.c1_reset(); chR.c1_reset(); ); d3_g1 = d3_t1 ? min(d3_g1 + d3_fst, 1) : max(d3_g1 - d3_fst, 0); );
d3_g2 != d3_t2 ? ( d3_g2 == 0 && !d3_c2on ? ( chL.odA.od_reset(); chL.odB.od_reset(); chR.odA.od_reset(); chR.odB.od_reset(); d3_c2on = 1; );
                   d3_g2 = d3_t2 ? min(d3_g2 + d3_fst, 1) : max(d3_g2 - d3_fst, 0); );
d3_c2on = d3_g2 > 0;
d3_g3 != d3_t3 ? ( d3_g3 == 0 && !d3_c3on ? ( chL.fz_reset(); chR.fz_reset(); d3_c3on = 1; );
                   d3_g3 = d3_t3 ? min(d3_g3 + d3_fst, 1) : max(d3_g3 - d3_fst, 0); );
d3_c3on = d3_g3 > 0;
d3_tm ? (
  d3_wB < 1 ? ( d3_wB == 0 ? ( chL.odB.od_reset(); chR.odB.od_reset(); ); d3_wB = min(d3_wB + d3_fst, 1); d3_wA = 1 - d3_wB; );
) : (
  d3_wA < 1 ? ( d3_wA == 0 ? ( chL.odA.od_reset(); chR.odA.od_reset(); ); d3_wA = min(d3_wA + d3_fst, 1); d3_wB = 1 - d3_wA; );
);
// mono in, WIDTH off: the right side would only repeat the left (see d3_lr_copy)
d3_m1 = d3_sync && d3_xl == d3_xr && d3_wd == 0;
!d3_m1 ? ( d3_rst ? ( d3_lr_copy(); d3_rst = 0; ); d3_xl != d3_xr || d3_wd != 0 ? d3_sync = 0; );
// column 1
d3_c1l = d3_g1 > 0 ? d3_xl + d3_g1 * (chL.c1_run(d3_xl) - d3_xl) : d3_xl;
d3_c1r = d3_m1 ? d3_c1l : d3_g1 > 0 ? d3_xr + d3_g1 * (chR.c1_run(d3_xr) - d3_xr) : d3_xr;
// transient retention: how much the pick attack stands out (fast against slow envelope of the clean tap; linked)
d3_a = max(abs(d3_c1l), abs(d3_c1r));
d3_ef += (d3_a > d3_ef ? d3_tfa : d3_tfr) * (d3_a - d3_ef);
d3_es += (d3_a > d3_es ? d3_tsa : d3_tsr) * (d3_a - d3_es);
d3_tr = min(max((d3_ef - 1.5 * d3_es) / (1.5 * d3_es + 0.00001), 0), 1);
d3_trs += (d3_tr - d3_trs) * d3_tsm;
d3_trm = max(d3_trm, d3_trs);
// gains (12 ms)
d3_lv2s += (d3_lv2 - d3_lv2s) * d3_gsm;
d3_wet += (d3_twet - d3_wet) * d3_gsm;
d3_dry += (d3_tdry0 + d3_tlk * (0.35 + 0.65 * d3_trs) - d3_dry) * d3_gsm;
// the supply (one for both sides): sags with what the drives draw
d3_k2 = max(d3_kb - d3_sg * d3_e2, 0.5); d3_ik2 = 1 / d3_k2;
d3_kf = max(d3_kb - d3_sg * d3_e3, 0.5); d3_ikf = 1 / d3_kf; d3_kmin = min(d3_kmin, min(d3_k2, d3_kf));
chL.fz_rc(); !d3_m1 ? chR.fz_rc();
// columns 2 and 3 at 4x, LEVEL
d3_yl = chL.d3_os(d3_c1l) * d3_lv2s;
d3_m1 ? ( d3_yr = d3_yl; d3_rst = 1; ) : d3_yr = chR.d3_os(d3_c1r) * d3_lv2s;
d3_a = d3_m1 ? abs(chL.lw) : max(abs(chL.lw), abs(chR.lw)); d3_e2 += (d3_a > d3_e2 ? d3_eat : d3_ert) * (d3_a - d3_e2);
d3_a = d3_m1 ? abs(chL.lf) : max(abs(chL.lf), abs(chR.lf)); d3_e3 += (d3_a > d3_e3 ? d3_eat : d3_ert) * (d3_a - d3_e3);
// output coupling (15 Hz), the house output stage
d3_yl = chL.d3_dc(d3_yl); d3_yr = d3_m1 ? d3_yl : chR.d3_dc(d3_yr);
d3_yl != d3_yl ? d3_yl = 0; d3_yr != d3_yr ? d3_yr = 0;
ost_out(d3_yl, d3_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
d3_po = max(d3_po, max(abs(spl0), abs(spl1)));

@gfx 1200 388
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1200, 388);
// =====================================================================
// GUI - medium-dark grey pedal-unit panel (design space 1200 x 388; S / M / L = 85 / 100 / 130 %).
// One row of four sections (INPUT green, OVERDRIVE yellow, FUZZ pink, OUTPUT grey), a DRIFT / meter strip below.
// Knobs: drag (SHIFT = fine), wheel, double-click = default; the label shows the value while the knob is touched.
// =====================================================================
sc != g3_lsc ? (
  g3_lsc = sc;
  gfx_setfont(11, "Trebuchet MS", 18 * sc, 'b');     // column titles
  gfx_setfont(12, "Trebuchet MS", 18 * sc, 'b');     // knob labels / values (18: 14 was too small to read - JG, 31 Oct 2026)
  gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');     // small print
  gfx_setfont(14, "Trebuchet MS", 13 * sc, 'b');     // keys, tray titles
  gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');     // the unit's name
);
G3_FACE = 0x3A3D43; G3_PLATE = 0x2D3035; G3_EDGE = 0x4B5058; G3_INK = 0xEEF0F3; G3_DIM = 0xA2A8B1; G3_TRAY = 0x26292D;
G3_GRN = 0x3EE07E; G3_PNK = 0xFF4FA8; G3_YEL = 0xFFD43B;

function g3_rr(x, y, w, h, r) local(x1, y1, x2, y2, rr) (
  x1 = floor(x * sc + 0.5); y1 = floor(y * sc + 0.5); x2 = floor((x + w) * sc + 0.5); y2 = floor((y + h) * sc + 0.5);
  rr = min(floor(r * sc + 0.5), floor((min(x2 - x1, y2 - y1)) * 0.5));
  gfx_a < 1 ? ui_rrs(x1, y1, x2 - x1, y2 - y1, rr) : (
    gfx_rect(x1 + rr, y1, x2 - x1 - 2 * rr, y2 - y1);
    gfx_rect(x1, y1 + rr, rr + 1, y2 - y1 - 2 * rr); gfx_rect(x2 - rr - 1, y1 + rr, rr + 1, y2 - y1 - 2 * rr);
    gfx_circle(x1 + rr, y1 + rr, rr, 1, 1); gfx_circle(x2 - rr - 1, y1 + rr, rr, 1, 1);
    gfx_circle(x1 + rr, y2 - rr - 1, rr, 1, 1); gfx_circle(x2 - rr - 1, y2 - rr - 1, rr, 1, 1);
  );
);
function g3_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function g3_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function g3_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function g3_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function g3_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a flat lit key (the caption on it); returns 1 when clicked
function g3_key(x, y, w, h, on, col, s) local(hov, hit) (
  hov = g3_in(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.35); g3_rr(x + 1, y + 2, w, h, 4);
  on ? ( ui_cola(col, 0.22); g3_rr(x - 3, y - 3, w + 6, h + 6, 6); );
  ui_col(on ? col : 0x1E2024); g3_rr(x, y, w, h, 4);
  !on ? ( ui_col(ui_mix(col, 0x1E2024, 0.75)); g3_rr(x, y, w, max(2, 2 / sc), 1); );
  hov ? ( ui_cola(0xFFFFFF, 0.1); g3_rr(x, y, w, h, 4); );
  gfx_setfont(14); ui_col(on ? 0x15171A : ui_mix(col, G3_INK, 0.45));
  ui_keytext((x + w * 0.5) * sc, (y + h * 0.5) * sc, s);
  hit;
);
function g3_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
// a section's plate (x, width), title, subtitle and IN key (idx 0: no key)
function g3_sec(x0, w, title, sub, col, idx) (
  ui_cola(0x000000, 0.4); g3_rr(x0 + 1, 74, w, 226, 8);
  ui_col(G3_EDGE); g3_rr(x0, 72, w, 226, 8);
  ui_col(G3_PLATE); g3_rr(x0 + 1.5, 73.5, w - 3, 223, 7);
  ui_col(col); g3_r(x0 + 18, 84, 4, 22);
  gfx_setfont(11); ui_col(G3_INK); g3_tl(x0 + 30, 85, title);
  gfx_setfont(13); ui_col(G3_DIM); g3_tl(x0 + 18, 114, sub);
  idx > 0 ? ( g3_key(x0 + w - 18 - 56, 82, 56, 26, slider(idx) >= 0.5, col, "IN") ? g3_tog(idx); );
  dy_bg = G3_PLATE; dy_ink = G3_INK;
);
// a dark grey pointer dot over the cap's white one (JG, 31 Oct 2026: the white dot was hard to read on the light caps; "dark grey");
// same place as dy_ccap's dot, a touch larger so none of the white one shows round it
function g3_dot(cx, cy, r, idx, lo, hi) local(n, a, cr, x, y, rd) (
  n = min(max((slider(idx) - lo) / (hi - lo), 0), 1); a = -0.75 * $pi + n * 1.5 * $pi;
  cr = (r - 1.5) * sc; rd = max(cr * 0.19, 2 * sc) + 0.7 * sc;
  x = cx * sc + sin(a) * cr * 0.62; y = cy * sc - cos(a) * cr * 0.62;
  ui_col(0x4A4D52); ui_ss_begin(x - rd, y - rd, x + rd, y + rd); gfx_circle(ui_ssx(x), ui_ssy(y), ui_ssk(rd), 1, 1); ui_ss_end();
);
// the knob row: every label on one line (y 268), the knobs centred on y 214; the label shows the value while touched
function g3_row(cx, r, idx, lo, hi, def, col, lbl, val) (
  dy_kst = 36; dy_knob(cx, 214, r, idx, lo, hi, def, 0, col, "", ""); g3_dot(cx, 214, r, idx, lo, hi);
  gfx_setfont(12); ui_col(dy_act ? col : G3_INK); g3_tc(cx, 268, dy_act ? val : lbl);
);
function g3_row10(cx, r, idx, col, lbl) ( sprintf(#g3v, "%.1f", slider(idx)); g3_row(cx, r, idx, 0, 10, 5, col, lbl, #g3v); );
function g3_inset(x, y, w, h) ( pk_inset(x * sc, y * sc, w * sc, h * sc, G3_TRAY); );

// =====================================================================
// Draw
// =====================================================================
ui_col(G3_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0x000000, 0.18); g3_r(0, 58, 1200, 1);
ui_cola(0xFFFFFF, 0.05); g3_r(0, 59, 1200, 1);

// ---------- header ----------
ui_col(G3_INK); gfx_circle(48 * sc, 30 * sc, 16 * sc, 1, 1);
gfx_setfont(13); ui_col(G3_FACE); ui_keytext(48 * sc, 30 * sc, "GFX");
gfx_setfont(15); ui_col(G3_INK); g3_tl(76, 13, "DST3"); gfx_measurestr("DST3", g3_tw, g3_th); ver_tag("v3", 16, 1.5, -0.22);
g3_x = 88 + g3_tw / sc;
ui_col(G3_GRN); g3_r(g3_x, 20, 8, 8); ui_col(G3_YEL); g3_r(g3_x + 11, 20, 8, 8); ui_col(G3_PNK); g3_r(g3_x + 22, 20, 8, 8);
gfx_setfont(13); ui_col(G3_DIM); g3_tl(g3_x, 33, "THREE-STAGE DRIVE");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
g3_k = pk_preset(470 * sc, 14 * sc, 430 * sc, 30 * sc, pr_cur, #d3_pm);
g3_k > 0 ? prs_dirty = g3_k;
ui_size_picker(1104 * sc, 20 * sc);

// ---------- INPUT: the vibe preamp's lamp and the input trim ----------
g3_x0 = 24;
g3_sec(g3_x0, 236, "INPUT", "VIBE PREAMP", G3_GRN, 1);
g3_l = slider1 >= 0.5 ? min(max(d3a_lamp, 0), 1) : 0;
g3_i = 0; loop(4, ui_cola(G3_GRN, (0.05 + 0.1 * g3_l) * (1 - g3_i * 0.22)); gfx_circle((g3_x0 + 66) * sc, 214 * sc, (30 + g3_i * 7) * sc, 1, 1); g3_i += 1; );
ui_col(ui_mix(0x1C2A22, G3_GRN, 0.25 + 0.75 * g3_l)); gfx_circle((g3_x0 + 66) * sc, 214 * sc, 26 * sc, 1, 1);
ui_cola(0xFFFFFF, 0.25 + 0.5 * g3_l); gfx_circle((g3_x0 + 66) * sc, 214 * sc, 9 * sc, 1, 1);
gfx_setfont(12); ui_col(slider1 >= 0.5 ? G3_INK : G3_DIM); g3_tc(g3_x0 + 66, 268, "LAMP");
sprintf(#g3v, "%+.1f dB", slider2); g3_row(g3_x0 + 168, 30, 2, -24, 12, 0, G3_GRN, "INPUT", #g3v);
g3_key(g3_x0 + 130, 120, 88, 26, slider14 >= 0.5, G3_GRN, "WIDTH") ? g3_tog(14);

// ---------- OVERDRIVE: model keys, then TONE (small) and DRIVE (large) ----------
g3_x0 = 272;
g3_sec(g3_x0, 336, "OVERDRIVE", "", G3_YEL, 3);
g3_m = slider4 >= 0.5;
g3_key(g3_x0 + 18, 118, 144, 28, !g3_m, G3_YEL, "MODEL A") ? ( slider4 = 0; ui_auto(4); );
g3_key(g3_x0 + 174, 118, 144, 28, g3_m, G3_YEL, "MODEL B") ? ( slider4 = 1; ui_auto(4); );
g3_row10(g3_x0 + 92, 26, 6, G3_YEL, "TONE");
g3_row10(g3_x0 + 222, 40, 5, G3_YEL, "DRIVE");

// ---------- FUZZ: BIAS (small) and FUZZ (large) ----------
g3_x0 = 620;
g3_sec(g3_x0, 280, "FUZZ", "GATED BIAS FUZZ", G3_PNK, 8);
g3_row10(g3_x0 + 82, 26, 13, G3_PNK, "BIAS");
g3_row10(g3_x0 + 190, 40, 9, G3_PNK, "FUZZ");

// ---------- OUTPUT: LEVEL (small, the whole unit) and BLEND (large: the chain against the clean preamp) ----------
g3_x0 = 912;
g3_sec(g3_x0, 264, "OUTPUT", "CHAIN AGAINST CLEAN", 0xB8BEC8, 0);
g3_f = min(max(slider9, 0), 10) / 10; g3_b = min(max(slider10, 0), 100) / 100;
g3_lk = (slider8 >= 0.5) * 0.45 * g3_f * g3_f;
g3_ds = 1 - g3_b + 0.35 * g3_lk;                      // steady clean share
g3_eff = g3_b / max(g3_b + g3_ds, 0.0001);
g3_row10(g3_x0 + 76, 26, 7, 0xB8BEC8, "LEVEL");
sprintf(#g3b, "%d%%  ·  eff %d%%", floor(slider10 + 0.5), floor(100 * g3_eff + 0.5));
g3_row(g3_x0 + 180, 40, 10, 0, 100, 50, ui_mix(G3_YEL, G3_PNK, 0.5), "BLEND", #g3b);

// ---------- DRIFT / meter strip ----------
dy_bg = G3_TRAY; dy_ink = G3_INK;
g3_inset(24, 310, 376, 66);
sprintf(#g3v, "%d%%", floor(slider12 + 0.5)); dy_kst = 36; dy_knob(62, 343, 20, 12, 0, 100, 50, 0, 0xB8BEC8, "", ""); g3_dot(62, 343, 20, 12, 0, 100);
gfx_setfont(12); ui_col(dy_act ? 0xB8BEC8 : G3_INK); g3_tl(92, 328, dy_act ? #g3v : "DRIFT");
g3_sup = min(max(d3a_sup, 0), 1);
g3_st = min(max((g3_sup - 0.85) / 0.15, 0), 1);
pk_led(196 * sc, 334 * sc, 6 * sc, 1, g3_st > 0.5 ? ui_mix(G3_YEL, G3_GRN, (g3_st - 0.5) * 2) : ui_mix(G3_PNK, G3_YEL, g3_st * 2));
gfx_setfont(14); ui_col(G3_INK); sprintf(#g3s, "SUPPLY %.1f V", 9 * g3_sup); g3_tl(210, 327, #g3s);
gfx_setfont(13); ui_col(G3_DIM); g3_tl(92, 350, "VIBE LAMP + SUPPLY SAG");
g3_inset(412, 310, 764, 66);
g3_pi = d3a_pi; d3a_pi = 0; g3_po = d3a_po; d3a_po = 0;
g3mI.ui_ledm(470 * sc, 328 * sc, 590 * sc, 9 * sc, g3_pi);
g3mO.ui_ledm(470 * sc, 350 * sc, 590 * sc, 9 * sc, g3_po);
gfx_setfont(13); ui_col(G3_DIM); g3_tr(456, 326, "IN"); g3_tr(456, 348, "OUT");
ui_col(G3_INK); g3_tl(1074, 326, "CLIP"); ui_col(G3_DIM); g3_tl(1074, 348, "-0.3 dB");

pk_end();
ui_end();
