  S74_OLIVE = 0x3C3E41; S74_INK = 0xECE7DB; S74_DIM = 0xABA79D; S74_HAZ = 0xF07C1E;
  S74_LAMP = 0xF5862A; S74_LTXT = 0x24140A; B3_KB = 0x1D1F21; B3_KF = 0x2E3135;
);
sc != b3g_calsc ? (
  b3g_calsc = sc;
  b3g_f1 = ui_fitarial(11, 14.5 * sc);
  b3g_f2 = ui_fitarial(12, 13.5 * sc);
  b3g_f3 = ui_fitarial(13, 12 * sc);
);
gfx_setfont(11, "Arial", b3g_f1, 'b'); gfx_setfont(12, "Arial", b3g_f2, 'b'); gfx_setfont(13, "Arial", b3g_f3, 'b');
gfx_setfont(14, "Arial", 28 * sc, 'b'); gfx_setfont(15, "Arial", 15 * sc, 'b');
s74_lamp = 1;
sc != b3g_lsc ? ( b3g_lsc = sc; gfx_setfont(16, "Arial", 12 * sc, 'b'); gfx_setfont(10, "Arial", 11 * sc, 'b'); );
lk_font = 16; lk_font2 = 10;

function b3g_cap(cx, cy, r, n) local(a, ca, sa, i, t, l, qx, qy, rp, tx, ty, px, py, w0, w1) (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 10 : 7;
    ui_cola(S74_INK, 0.85); gfx_circle((cx + sin(t) * (r + 4 + r + l) * 0.5) * sc, (cy - cos(t) * (r + 4 + r + l) * 0.5) * sc, max((i == 0 || i == 5 || i == 10 ? 1.8 : 1.2) * 0.75, 0.9) * sc, 1, 1);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  qx = cx * sc; qy = cy * sc; rp = r * sc;
  ui_cola(0x000000, 0.5); gfx_circle(qx + 1.6 * sc, qy + 3 * sc, rp, 1, 1);
  ui_col(0x16181A); gfx_circle(qx, qy, rp, 1, 1);
  ui_col(B3_KB); gfx_circle(qx, qy, rp - 1.2 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.13); gfx_arc(qx, qy, rp - 1.6 * sc, -0.8 * $pi, 0.05 * $pi, 1);
  tx = qx - ca * rp * 0.62; ty = qy - sa * rp * 0.62; px = qx + ca * rp * 0.97; py = qy + sa * rp * 0.97;
  w0 = rp * 0.30; w1 = rp * 0.13;
  ui_cola(0x000000, 0.35);
  ui_ssquad(tx - sa * w0 + 1.2 * sc, ty + ca * w0 + 2 * sc, px - sa * w1 + 1.2 * sc, py + ca * w1 + 2 * sc,
               px + sa * w1 + 1.2 * sc, py - ca * w1 + 2 * sc, tx + sa * w0 + 1.2 * sc, ty - ca * w0 + 2 * sc);
  ui_col(B3_KF);
  ui_ssquad(tx - sa * w0, ty + ca * w0, px - sa * w1, py + ca * w1, px + sa * w1, py - ca * w1, tx + sa * w0, ty - ca * w0);
  ui_col(S74_IDX); gfx_circle((cx + ca * r * 0.74) * sc, (cy + sa * r * 0.74) * sc, max(2, r * 0.1) * sc, 1, 1);
);
function b3g_knob(cx, cy, r, idx, lo, hi, def, label, fmt) local(v, n, dx, dy, hov, did) (
  did = 4000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - b3g_lt < 0.35 && b3g_lid == idx && !b3g_mv) || (mouse_cap & 4) ? ( s74_set(idx, def); drag_id = -1; b3g_lt = 0; ) : (
      drag_id = did; b3g_ky = mouse_y; b3g_ky0 = mouse_y; b3g_mv = 0; b3g_lt = time_precise(); b3g_lid = idx;
      b3g_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !b3g_mv && abs(mouse_y - b3g_ky0) > 3 * sc ? ( b3g_mv = 1; b3g_ky = mouse_y; );
  drag_id == did && b3g_mv ? (
    b3g_kn = min(max(b3g_kn + (b3g_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); b3g_ky = mouse_y;
    v = floor((lo + b3g_kn * (hi - lo)) * 10 + 0.5) / 10;
    slider(idx) != v ? s74_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max((v - lo) / (hi - lo) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    s74_set(idx, floor((lo + n * (hi - lo)) * 10 + 0.5) / 10); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  b3g_cap(cx, cy, r, n);
  (hov || drag_id == did) ? (
    sprintf(#b3g_v, fmt, v); s74_pill(cx, cy + r + 8, #b3g_v);
  ) : (
    gfx_setfont(11); ui_col(S74_INK); s74_tc(cx, cy + r + 18, label);
  );
);
function b3g_sec(x, y, s) ( ui_col(S74_HAZ); gfx_circle((x + 2) * sc, (y + 8.5) * sc, 3 * sc, 1, 1); gfx_setfont(12); ui_col(S74_INK); s74_t(x + 9, y, s); );
function b3g_vr(x, y1, y2) ( ui_cola(S74_HAZ, 0.85); s74_r(x, y1, 1, y2 - y1); );
function b3g_hr(x1, x2, y) ( ui_cola(S74_HAZ, 0.85); s74_r(x1, y, x2 - x1, 1); );

