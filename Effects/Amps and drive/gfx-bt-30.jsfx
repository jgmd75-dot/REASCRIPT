desc:BT-30 [hybrid combo amp] (GFX)
//tags: amp amplifier guitar combo hybrid solid state valve tube spring reverb cabinet 1x12 80s
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-s74 and gfx-amp (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s74.jsfx-inc
import gfx-amp.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{OG,MOD}>-Model
slider2:4<0,10,0.1>-Gain
slider3:0<0,1,1{Off,On}>-Bright
slider4:5<0,10,0.1>-Bass
slider5:5<0,10,0.1>-Middle
slider6:5<0,10,0.1>-Treble
slider7:5<0,10,0.1>-Presence
slider8:2.5<0,10,0.1>-Reverb
slider9:5<0,10,0.1>-Master
slider10:1<0,1,1{Off,On}>-Cab
slider11:3<0,10,0.1>-Mic (on - off axis)
slider12:0<0,1,1{Off,On}>-Mono in
slider13:50<0,100,1>-Drift (%)
slider14:0<-24,12,0.1>-Output (dB)
slider15:0<-24,12,0.1>-Input trim (dB)
slider16:0<0,1,1{Off,On}>-Input guard
slider17:0<0,100,1>-Band sat (%)
slider18:30<0,100,1>-Bias (%)
slider19:120<40,400,1>-Sat low band (Hz)
slider20:6000<2000,16000,10>-Sat high band (Hz)
slider21:-0.3<-24,0,0.1>-Ceiling (dB)
slider22:prs_sel=0<0,12,1{No preset,Init,Chime Clean,New Wave Jangle,City Pop Clean,Funk Snap,Arena Crunch,Big Hair Lead,Pop Rock Rhythm,Fusion Lead,Studio Direct,Surf Spring,Cranked Valves}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=4194304

@init
#ui_man = "gfx-bt-30";
ext_noinit = 1;

function b3_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function b3_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function b3_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function b3_tra(u) ( u >= 0 ? b3_th(u) : 0.68 * b3_th(u * 1.4705882) );
function b3_traF(u) ( u >= 0 ? b3_F(u) : 0.4624 * b3_F(u * 1.4705882) );
function b3_tr2(u) ( b3_th(u) - b3_xo * u / (1 + 400 * u * u) );
function b3_tr2F(u) ( b3_F(u) - b3_xo * 0.00125 * log(1 + 400 * u * u) );
function b3_aa1(u) instance(u1, g1) local(g, d, y) (
  g = b3_traF(u); d = u - u1; y = abs(d) > 0.00001 ? (g - g1) / d : b3_tra(0.5 * (u + u1)); u1 = u; g1 = g; y;
);
function b3_aa2(u) instance(u1, g1) local(g, d, y) (
  g = b3_tr2F(u); d = u - u1; y = abs(d) > 0.00001 ? (g - g1) / d : b3_tr2(0.5 * (u + u1)); u1 = u; g1 = g; y;
);
function b3_aa3(u) instance(u1, g1) local(g, d, y) (
  g = b3_F(u); d = u - u1; y = abs(d) > 0.00001 ? (g - g1) / d : b3_th(0.5 * (u + u1)); u1 = u; g1 = g; y;
);

function b3_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function b3_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f; b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
function b3_lpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * min(f, 0.45 * fs); b0 = w / (c + w); b1 = b0; a1 = (w - c) / (c + w);
);
function b3_1clr() instance(x1, y1) ( x1 = y1 = 0; );
function b3_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function b3_syset(b) instance(b0, g0, n0, aa) ( aa.u1 += b - b0; aa.g1 = b3_F(aa.u1); b0 = b; g0 = b3_th(b); n0 = 1 / max(b3_thd(b), 0.05); );
function b3_syrun(x) instance(b0, g0, n0, aa) ( (aa.b3_aa3(x * 0.5 + b0) - g0) * n0 * 2 + b3_dn );

function b3_tsset(t, m, l, fs) instance(b0, b1, b2, b3, a1, a2, a3)
  local(C1, C2, C3, R1, R2, R3, R4, nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  C1 = 0.00000000047; C2 = 0.000000022; C3 = 0.000000022;
  R1 = 220000; R2 = 1000000; R3 = 22000; R4 = 33000;
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  b0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  b1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  b2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  b3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  a1 = k1 * q; a2 = k2 * q; a3 = k3 * q;
);
function b3_tsrun(x) instance(b0, b1, b2, b3, a1, a2, a3, x1, x2, x3, y1, y2, y3) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 + b3 * x3 - a1 * y1 - a2 * y2 - a3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);
function b3_tsclr() instance(x1, x2, x3, y1, y2, y3) ( x1 = x2 = x3 = y1 = y2 = y3 = 0; );

b3_qn = 4096; b3_qr = 4; b3_qs = (b3_qn - 1) / (2 * b3_qr);
function b3_qbuild(t, A, B) local(i, U, lo, hi, m) (
  i = 0;
  loop(b3_qn,
    U = -b3_qr + i / b3_qs; lo = -1; hi = 1;
    loop(44, m = 0.5 * (lo + hi); m - b3_th(A * (U - B * m)) > 0 ? hi = m : lo = m; );
    t[i] = 0.5 * (lo + hi);
    i += 1;
  );
  t[b3_qn] = t[b3_qn - 1];
);
function b3_qint(t, c) local(i, h) (
  h = 1 / b3_qs; c[0] = 0; i = 0;
  loop(b3_qn, c[i + 1] = c[i] + h * 0.5 * (t[i] + t[i + 1]); i += 1; );
);
function b3_qF(p) local(i, f, q) (
  p <= 0 ? b3_qt[0] * p / b3_qs : p >= b3_qn - 1 ? b3_qc[b3_qn - 1] + b3_qt[b3_qn - 1] * (p - b3_qn + 1) / b3_qs : (
    i = floor(p); f = p - i; q = b3_qt + i;
    b3_qc[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / b3_qs;
  );
);
function b3_qQ(p) local(i, q) ( p = min(max(p, 0), b3_qn - 1.001); i = floor(p); p -= i; q = b3_qt + i; q[0] + (q[1] - q[0]) * p; );
function b3_paset(d) instance(t0, ofs, p1, f1) local(o) (
  t0 = b3_th(d); o = d / b3_paA + b3_paB * t0; p1 += (o - ofs) * b3_qs; f1 = b3_qF(p1); ofs = o;
);
function b3_pa(u) instance(y, sup, sbase, env, t0, ofs, p1, f1) local(p, a, f, d) (
  p = (u / sup + ofs + b3_qr) * b3_qs; f = b3_qF(p); d = p - p1;
  y = sup * ((abs(d) > 0.00001 ? (f - f1) / d * b3_qs : b3_qQ(0.5 * (p + p1))) - t0);
  p1 = p; f1 = f;
  a = abs(y);
  env += (a - env) * (a > env ? b3_sga : b3_sgr);
  sup = sbase * (1 - b3_sgd * min(max(env - b3_sgt, 0) * 2.2, 1));
  y;
);
function b3_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * b3_xlk + x * b3_xc; s = b3_th(ph * b3_otk) / b3_otk; y = (s - sp * b3_xlk) / b3_xc; sp = s; y;
);

function b3_core(x, rv) instance(ip, il, ts, m1, m2, m3, pin, pr, pa, ot, sacc, tb, s1, s2, op, ev, md) local(u, y, b) (
  x += b3_dn;
  u = x * b3_g;
  ev += (min(abs(u), 3) - ev) * (abs(u) > ev ? b3_eva : b3_evr);
  b = b3_bg + b3_bd * ev;
  b3_mod == 0 ? (
    b += tb;
    y = s1.b3_aa1(u + b) - b3_tra(b);
    y = il.b3_1run(ip.b3_1run(y));
    y = s2.b3_aa2(y * 2.2);
    y = ts.b3_tsrun(y) * 3.2;
  ) : (
    y = il.b3_1run(ip.b3_1run(op.clp_run(u + b) - op.clp_crv(b)));
    y = m3.am_run(m2.am_run(m1.am_run(y)));
  );
  y = md.am_run(y);
  sacc += y;
  y = (y + rv * b3_rvg) * b3_mv;
  y = pin.b3_syrun(y);
  y = pr.am_run(y);
  y = pa.b3_pa(y);
  ot.b3_ot(y);
);
function b3_clr() instance(ip, il, ts, m1, m2, m3, md, op, ev) (
  ip.b3_1clr(); il.b3_1clr(); ts.b3_tsclr(); m1.b3_bqclr(); m2.b3_bqclr(); m3.b3_bqclr(); md.b3_bqclr();
  op.clp_set(2, 1, 1, 0); op.clp_knee(0.2); op.clp_reset(); ev = 0;
);
function b3_bias(w1, w2, w3, w4) instance(pin, pa, tb) local(a) (
  a = dm_a;
  tb = 0.07 + 0.006 * a * w1;
  pin.b3_syset(0.04 + 0.03 * a * w2);
  pa.b3_paset(0.025 * a * w4);
  pa.sbase = 1 + 0.012 * a * w3;
);

function b3_cabset(mic) instance(c1, c2, c3, c4, c5, c6, c7) local(m, lp) (
  m = mic / 10;
  c1.am_bq(1, 86, 0.95, 0, srate);
  c2.am_bq(2, 118, 1.3, 2.5, srate);
  c3.am_bq(2, 520, 1.1, -2.2, srate);
  c4.am_bq(2, 2600, 1.3, 4.5 * (1 - m * 0.75), srate);
  lp = 6400 - 2600 * m;
  c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
  c7.am_bq(2, 7400, 2.5, -2 - 8 * m, srate);
);
function b3_cabrun(x) instance(c1, c2, c3, c4, c5, c6, c7) (
  c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c2.am_run(c1.am_run(x)))))));
);

function b3_send(x) instance(lp) ( lp.am_run(x * b3_ksend); );

function b3_mem() local(n) (
  s74_mem = 0;
  b3_QT0 = s74_alloc(b3_qn + 2); b3_QT1 = s74_alloc(b3_qn + 2); b3_QC0 = s74_alloc(b3_qn + 2); b3_QC1 = s74_alloc(b3_qn + 2);
  b3_MKT = s74_alloc(32);
  n = floor(0.1 * srate) + 64;
  rsL.am_spring_init(s74_alloc(2 * n), srate); rsR.am_spring_init(s74_alloc(2 * n), srate);
  rsL.n1 = floor(0.0331 * srate); rsL.n2 = floor(0.0389 * srate); rsL.b2 = rsL.b1 + rsL.n1 + 8;
  rsR.n1 = floor(0.0353 * srate); rsR.n2 = floor(0.0413 * srate); rsR.b2 = rsR.b1 + rsR.n1 + 8;
  rsL.lc = rsR.lc = 1 - exp(-2 * $pi * 4600 / srate);
  rsL.hp.am_bq(1, 320, 0.7, 0, srate); rsR.hp.am_bq(1, 320, 0.7, 0, srate);
  ost_init(0);
);
b3_LAT = 0;

function b3_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = b3_MKT + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function b3_tables() (
  b3_row(0, -2.04, -5.41, -8.16, -10.79, -12.61, -13.56, -14.37, -14.72, -14.92, -15.07, -14.87);
  b3_row(1, 15.80, 13.13, 10.75, 7.91, 5.20, 2.81, 0.38, -1.62, -3.02, -4.04, -4.55);
);
function b3_mkdb(md, v) local(p, i, f, q) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i; q = b3_MKT + md * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);

function b3_fixside() instance(hi, bv) (
  b3_mod == 0 ? (
    hi.b3_hpset(70, srate); bv.am_bq(2, 1700, 0.8, 3, srate);
  ) : (
    hi.b3_hpset(22, srate); bv.am_thru();
  );
);
function b3_fixcore() instance(ip, il) (
  b3_mod == 0 ? ( ip.b3_hpset(140, srate); il.b3_lpset(6500, srate); )
              : ( ip.b3_hpset(5, srate); il.b3_lpset(19000, srate); );
);
function b3_fix() ( pL.b3_fixside(); pR.b3_fixside(); cL.b3_fixcore(); cR.b3_fixcore(); );

function b3_tone(force) local(k, ch, db, fs2) (
  fs2 = srate;
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  b3_s2 += (slider2 - b3_s2) * k; b3_s3 += ((slider3 >= 0.5) - b3_s3) * k;
  b3_s4 += (slider4 - b3_s4) * k; b3_s5 += (slider5 - b3_s5) * k; b3_s6 += (slider6 - b3_s6) * k;
  b3_s7 += (slider7 - b3_s7) * k; b3_s11 += (slider11 - b3_s11) * k;
  ch = b3_s2 + 2 * b3_s3 + 3 * b3_s4 + 5 * b3_s5 + 7 * b3_s6 + 11 * b3_s7 + 13 * b3_s11;
  force || abs(ch - b3_lts) > 0.00001 ? (
    b3_lts = ch;
    db = b3_s3 * (b3_mod == 0 ? 8 : 4) * (1 - 0.65 * b3_s2 / 10);
    pL.bb.am_bq(3, 1500, 0.6, db, srate); pR.bb.am_bq(3, 1500, 0.6, db, srate);
    b3_mod == 0 ? (
      cL.ts.b3_tsset(b3_s6 / 10, b3_s5 / 10, b3_s4 / 10, fs2); cR.ts.b3_tsset(b3_s6 / 10, b3_s5 / 10, b3_s4 / 10, fs2);
      db = -2.5 + 1.1 * b3_s7;
    ) : (
      cL.m1.am_bq(4, 110, 0.7, (b3_s4 - 5) * 2.4, fs2); cR.m1.am_bq(4, 110, 0.7, (b3_s4 - 5) * 2.4, fs2);
      cL.m2.am_bq(2, 850, 0.6, (b3_s5 - 5) * 1.8, fs2); cR.m2.am_bq(2, 850, 0.6, (b3_s5 - 5) * 1.8, fs2);
      cL.m3.am_bq(3, 3200, 0.7, (b3_s6 - 5) * 2.4, fs2); cR.m3.am_bq(3, 3200, 0.7, (b3_s6 - 5) * 2.4, fs2);
      db = -5 + 1.0 * b3_s7;
    );
    cL.pr.am_bq(3, 2800, 0.6, db, fs2); cR.pr.am_bq(3, 2800, 0.6, db, fs2);
    cabL.b3_cabset(b3_s11); cabR.b3_cabset(b3_s11);
  );
);

function b3_gaindb(md, v) ( md == 0 ? 2 + 3.8 * v : 2.8 * v );
function b3_setmodel(m) (
  b3_mod = m;
  b3_mod == 0 ? (
    b3_qt = b3_QT0; b3_qc = b3_QC0; b3_paA = 8; b3_paB = 0.25; b3_sgd = 0.2; b3_sgt = 0.42; b3_otk = 0.8; b3_xo = 0.12;
  ) : (
    b3_qt = b3_QT1; b3_qc = b3_QC1; b3_paA = 10; b3_paB = 0.6; b3_sgd = 0.06; b3_sgt = 0.55; b3_otk = 0.45; b3_xo = 0;
  );
  b3_fix();
  cL.b3_clr(); cR.b3_clr();
  b3_mod == 0 ? (
    k1L.s74_bqset(3, 0.2994 * srate, 12.5, 1.13, srate); k2L.s74_bqset(5, 0.2125 * srate, 8.92, 0.55, srate);
  ) : (
    k1L.s74_bqset(3, 0.3020 * srate, 12.5, 0.82, srate); k2L.s74_bqset(5, 0.2076 * srate, 0.62, 0.68, srate);
  );
  k1R.b0 = k1L.b0; k1R.b1 = k1L.b1; k1R.b2 = k1L.b2; k1R.a1 = k1L.a1; k1R.a2 = k1L.a2;
  k2R.b0 = k2L.b0; k2R.b1 = k2L.b1; k2R.b2 = k2L.b2; k2R.a1 = k2L.a1; k2R.a2 = k2L.a2;
  pL.pf.clp_pf_cfg(40000, m ? 9000 : 7000, -3, 160); pR.pf.clp_pf_cfg(40000, m ? 9000 : 7000, -3, 160);
  pL.pf.clp_pf_reset(); pR.pf.clp_pf_reset();
  pL.pf.clp_pf_block(slider2 / 10, srate, 1); pR.pf.clp_pf_block(slider2 / 10, srate, 1);
  b3_tone(1);
  cL.b3_bias(cL.w1, cL.w2, cL.w3, cL.w4); cR.b3_bias(cR.w1, cR.w2, cR.w3, cR.w4);
  b3_mkd = b3_tmkd = b3_mkdb(b3_mod, slider2);
  b3_gd = b3_tgd = b3_gaindb(b3_mod, slider2);
);

b3_kout = 1;
b3_ksend = 0.5;
function update() (
  b3_tmod = slider1 >= 0.5;
  b3_tgd = b3_gaindb(b3_mod, slider2);
  b3_tmkd = b3_mkdb(b3_mod, slider2);
  b3_tmvd = -34 + 34 * slider9 / 10;
  b3_trv = 0.9 * (slider8 / 10) ^ 1.6;
  b3_tcab = slider10 >= 0.5;
  b3_tmono = slider12 >= 0.5;
  drift_macro(slider13);
  b3_to = 10 ^ (slider14 / 20) * b3_kout;
  in_setup(slider15, slider16 >= 0.5);
  ost_setup(slider17 / 100, slider18 / 100, slider19, slider20, slider21, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = b3_LAT;
);

function b3_set(md, g, br, b, m, t, pr, rv, ms, cb, mc, df, ou) (
  slider1 = md; slider2 = g; slider3 = br; slider4 = b; slider5 = m; slider6 = t; slider7 = pr; slider8 = rv;
  slider9 = ms; slider10 = cb; slider11 = mc; slider13 = df; slider14 = ou;
  slider_automate(2047 + 4096 + 8192);
);
function load_preset(p) (
  p == 1  ? b3_set(0,    4,   0,  5,    5,   5,   5,   2.5,  5,   1,  3,  50,   0.0) :
  p == 2  ? b3_set(0,    1.5, 1,  4.5,  5,   6.5, 6,   3,    5,   1,  2,  45,   -6.2) :
  p == 3  ? b3_set(0,    2.5, 1,  4,    6,   7,   6.5, 2,    5,   1,  2.5,50,   -5.8) :
  p == 4  ? b3_set(1,    2,   0,  5,    5.5, 5.5, 5,   2.5,  5,   1,  3,  40,   -0.8) :
  p == 5  ? b3_set(1,    3,   1,  4.5,  4,   6,   6,   0.5,  5,   1,  2,  40,   -2.0) :
  p == 6  ? b3_set(0,    6,   0,  5.5,  6.5, 6,   5.5, 1.5,  6,   1,  3,  50,   -3.6) :
  p == 7  ? b3_set(0,    9,   0,  5,    7.5, 6,   6,   2.5,  6.5, 1,  4,  55,   -3.5) :
  p == 8  ? b3_set(0,    5,   1,  5,    5.5, 5.5, 5,   1.5,  5.5, 1,  3,  50,   -2.9) :
  p == 9  ? b3_set(1,    7.5, 0,  5,    6,   5,   4.5, 3,    5,   1,  5,  45,   -0.5) :
  p == 10 ? b3_set(1,    3,   0,  5,    5,   5,   5,   0,    5,   0,  3,  30,   -0.5) :
  p == 11 ? b3_set(0,    2,   1,  4,    5,   6.5, 6,   7.5,  5,   1,  2,  50,   -6.1) :
  p == 12 ? b3_set(0,    3,   0,  5.5,  6,   5,   5,   2,    9,   1,  3.5,60,   -8.2) :
  p == 13 ? (
    b3_set(0, 4, 0, 5, 5, 5, 5, 2.5, 5, 1, 3, 50, 0);
    slider12 = 0; slider15 = 0; slider16 = 0; slider17 = 0; slider18 = 30; slider19 = 120; slider20 = 6000; slider21 = -0.3;
    slider_automate(2097151);
  );
);

function b3_start() (
  b3_sr = srate;
  b3_mem();
  b3_qbuild(b3_QT0, 8, 0.25); b3_qbuild(b3_QT1, 10, 0.6); b3_qint(b3_QT0, b3_QC0); b3_qint(b3_QT1, b3_QC1);
  b3_tables();
  b3_xc = 2 * $pi * 40 / srate; b3_xlk = 1 - 2 * $pi * 5 / srate;
  b3_sga = 1 - exp(-1 / (0.012 * srate)); b3_sgr = 1 - exp(-1 / (0.16 * srate));
  b3_smk = 1 - exp(-1 / (0.02 * srate));
  b3_fd = 1 / (0.008 * srate);
  b3_eva = 1 - exp(-1 / (0.003 * srate)); b3_evr = 1 - exp(-1 / (0.12 * srate));
  b3_mea = 1 - exp(-1 / (0.03 * srate)); b3_mer = 1 - exp(-1 / (0.25 * srate));
  b3_me = 0.0079; b3_mc = 0;
  sL.lp.am_bq(0, 4500, 0.7, 0, srate); sR.lp.am_bq(0, 4500, 0.7, 0, srate);
  cL.pa.sup = cL.pa.sbase = 1; cR.pa.sup = cR.pa.sbase = 1;
  in_init();
  update();
  b3_setmodel(b3_tmod);
  b3_mvd = b3_tmvd; b3_rvg = b3_trv; b3_cabm = b3_tcab; b3_mn = b3_tmono; b3_o = b3_to;
  b3_fade = 1; b3_fst = 0;
);
b3_dn = 0.000000000000000001;
b3_start();
ostL.ost_ch_init(); ostR.ost_ch_init();
dw1.drift_init(0.8 + rand(1) * 0.5); dw2.drift_init(0.8 + rand(1) * 0.5); dw3.drift_init(0.8 + rand(1) * 0.5); dw4.drift_init(0.8 + rand(1) * 0.5);
dw5.drift_init(0.8 + rand(1) * 0.5); dw6.drift_init(0.8 + rand(1) * 0.5); dw7.drift_init(0.8 + rand(1) * 0.5); dw8.drift_init(0.8 + rand(1) * 0.5);
b3_pk = 0; b3_sgm = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(22, i != 22 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
srate != b3_sr ? b3_start();
update();
b3_tone(0);
b3_gg = b3_s2 / 10;
b3_bg = (b3_mod ? 0.10 : 0.16) * b3_gg ^ 1.5; b3_bd = (b3_mod ? 0.06 : 0.10) * b3_gg * b3_gg;
pL.pf.clp_pf_block(b3_gg, srate, samplesblock); pR.pf.clp_pf_block(b3_gg, srate, samplesblock);
b3_di = 0.2 * dm_s * samplesblock / srate;
cL.w1 = dw1.drift_tick(b3_di); cL.w2 = dw2.drift_tick(b3_di); cL.w3 = dw3.drift_tick(b3_di); cL.w4 = dw4.drift_tick(b3_di);
cR.w1 = dw5.drift_tick(b3_di); cR.w2 = dw6.drift_tick(b3_di); cR.w3 = dw7.drift_tick(b3_di); cR.w4 = dw8.drift_tick(b3_di);
cL.b3_bias(cL.w1, cL.w2, cL.w3, cL.w4); cR.b3_bias(cR.w1, cR.w2, cR.w3, cR.w4);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
in_process(spl0, spl1);
b3_xl = in_l; b3_xr = in_r;
b3_mn += (b3_tmono - b3_mn) * b3_smk;
b3_xm = 0.5 * (b3_xl + b3_xr); b3_xl += (b3_xm - b3_xl) * b3_mn; b3_xr += (b3_xm - b3_xr) * b3_mn;
b3_dn = -b3_dn;
b3_tmod != b3_mod && b3_fst == 0 ? b3_fst = 1;
b3_fst == 1 ? ( b3_fade -= b3_fd; b3_fade <= 0 ? ( b3_fade = 0; b3_setmodel(b3_tmod); b3_hold = b3_LAT + 48; b3_fst = 2; ); ) :
b3_fst == 2 ? ( b3_hold -= 1; b3_hold <= 0 ? b3_fst = 3; ) :
b3_fst == 3 ? ( b3_fade += b3_fd; b3_fade >= 1 ? ( b3_fade = 1; b3_fst = 0; ); );
b3_gd += (b3_tgd - b3_gd) * b3_smk; b3_mkd += (b3_tmkd - b3_mkd) * b3_smk; b3_mvd += (b3_tmvd - b3_mvd) * b3_smk;
b3_g = exp(b3_gd * 0.1151293); b3_mv = exp(b3_mvd * 0.1151293);
b3_rvg += (b3_trv - b3_rvg) * b3_smk; b3_cabm += (b3_tcab - b3_cabm) * b3_smk; b3_o += (b3_to - b3_o) * b3_smk;
b3_xl = pL.pf.clp_pf_run(pL.bb.am_run(pL.bv.am_run(pL.hi.b3_1run(b3_xl))));
b3_xr = pR.pf.clp_pf_run(pR.bb.am_run(pR.bv.am_run(pR.hi.b3_1run(b3_xr))));
b3_x2 = 0.5 * (b3_xl * b3_xl + b3_xr * b3_xr);
b3_me += (b3_x2 - b3_me) * (b3_x2 > b3_me ? b3_mea : b3_mer);
(b3_mc -= 1) <= 0 ? (
  b3_mc = 32;
  b3_e = min(max((10 * log10(b3_me + 0.0000000001) + 33) / 18, 0), 1);
  b3_md = -(b3_gg ^ 1.4) * (b3_mod ? 1.5 + 1.5 * b3_e : 2 + 2 * b3_e);
  cL.md.am_bq(2, b3_mod ? 750 : 650, 0.6, b3_md, srate); cR.md.b0 = cL.md.b0; cR.md.b1 = cL.md.b1;
  cR.md.b2 = cL.md.b2; cR.md.a1 = cL.md.a1; cR.md.a2 = cL.md.a2;
);
b3_rl = rsL.am_spring_run(sL.b3_send(cL.sacc), 0.7); b3_rr = rsR.am_spring_run(sR.b3_send(cR.sacc), 0.7);
cL.sacc = 0; cR.sacc = 0;
b3_yl = k2L.s74_bq(k1L.s74_bq(cL.b3_core(b3_xl, b3_rl))); b3_yr = k2R.s74_bq(k1R.s74_bq(cR.b3_core(b3_xr, b3_rr)));
b3_sgm = max(b3_sgm, max(cL.pa.env, cR.pa.env));
b3_cl = cabL.b3_cabrun(b3_yl); b3_cr = cabR.b3_cabrun(b3_yr);
b3_yl += (b3_cl - b3_yl) * b3_cabm; b3_yr += (b3_cr - b3_yr) * b3_cabm;
b3_k = exp(b3_mkd * 0.1151293) * b3_o * b3_fade;
b3_yl = ostL.ost_band(b3_yl * b3_k); b3_yr = ostR.ost_band(b3_yr * b3_k);
ost_out(b3_yl, b3_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
b3_pk = max(b3_pk, max(abs(spl0), abs(spl1)));

@gfx 1000 390
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
