desc:BT-30 [hybrid combo amp] (GFX)
//tags: amp amplifier guitar combo hybrid solid state valve tube spring reverb cabinet 1x12 80s
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-s74 and gfx-amp (.jsfx-inc) in the same folder.
//
// BT-30. A hybrid combo in the spirit of the early-1980s Japanese 30-watt hybrids: a transistor preamp (bright,
// chimey, with a slightly odd solid-state bite) driving a pair of 6L6-style power valves, one 12" speaker in an
// open-back cabinet and a simple spring reverb (personal use; the sound is designed from scratch).
//
// MODELS (the two lit lenses in the header; the panel's look changes with them)
//   OG      the original voicing (dark grey and orange panel). Two discrete transistor stages: the first clips asymmetrically (silicon saturates
//           on one side earlier than it cuts off on the other), a tight interstage coupling cap, then a second
//           stage with a touch of crossover grit; a 'chime' peak and a strong BRIGHT cap ahead of them. The passive
//           treble / bass / middle stack after them is worked out from its parts (470 pF, 22 nF, 22 nF, 220 k treble,
//           1 M bass, 22 k middle, 33 k slope: the third-order transfer function, its mid scoop included). The
//           power valves run with light negative feedback, the supply sags when they are pushed and the small
//           output transformer saturates at low frequencies: crisp transistor transients melting into valve warmth.
//   MOD     the refined solid-state voicing (ivory and charcoal panel): one clean op-amp stage (linear to the rails, then a firm, symmetric
//           limit), an active flat-response tone circuit (BASS / MIDDLE / TREBLE shelves and peak, flat at 5), a
//           gentle BRIGHT, then the same valves held by much more negative feedback, a stiffer supply and a larger
//           transformer: tight, high-headroom, DI-like precision.
// SIGNAL FLOW (each side, L and R, runs its own complete amp; MONO IN feeds both with L + R)
//   input coupling -> BRIGHT / voicing -> pre-filter -> transistor (or op-amp) preamp -> tone stack -> + spring return
//   -> MASTER -> phase inverter -> PRESENCE (the feedback loop opening up at the top) -> push-pull 6L6-style pair
//   inside its feedback loop (solved exactly, a table per model) with supply sag -> output transformer (flux
//   saturation) -> SPEAKER: 12" open back (CAB) with the MIC from on axis to off axis.
//   ANTI-ALIASING (the house drive standard): the amp runs at the host rate (no latency) with first-order ADAA on
//   every clipping stage (both transistor stages, the op-amp - the house KNEE clipper -, the phase inverter, and the
//   power stage's closed loop through the running integral of its table), a drive-tracking pre-filter into the
//   preamp (a low-pass from 40 kHz, capped near the Nyquist, down to 7 kHz on OG / 9 kHz on MOD at full GAIN, and a
//   160 Hz low shelf that eases the lows into the drive down by up to 3 dB), and a fixed post-shelf per model that
//   makes up the stages' top-end droop. No drive-tracking knee: the transistor clip (OG) and the op-amp's rails (MOD)
//   are meant to stay hard. The spring tank is driven by a solid-state send.
// CONTROLS
//   GAIN      the preamp drive. It is level matched (OG and MOD, every setting, on pink noise): it changes the
//             colour, not the loudness. As GAIN rises the drive's bias rises (more even harmonics; at high GAIN a loud
//             passage pushes it further, a sag-like give), the lows into the drive ease down (the pre-filter's shelf)
//             and a wide mid dip after the preamp deepens: OG 650 Hz, MOD 750 Hz, to -2 / -1.5 dB at full GAIN on
//             quiet playing and to -4 / -3 dB on loud passages (a gentle level follower, 30 ms in, 250 ms out).
//   BRIGHT    a treble lift ahead of the preamp, strongest at low GAIN (as the real bright cap).
//   BASS / MIDDLE / TREBLE   the tone stack (passive on OG, active and flat at 5 on MOD).
//   PRESENCE  the top end of the power amp's feedback loop (more top, more bite in the valves).
//   MASTER    how hard the power valves are driven: the musical master - louder, then sag and valve compression.
//   REVERB    the spring tank's return.
//   CAB       the 1x12 open-back speaker on, or off (a line out for your own impulse responses). MIC: on axis
//             (bright, forward) to off axis (darker, softer).
//   DRIFT     valve and supply wander (0 - 100 %, 50 % = standard): the power valves' balance and the phase
//             inverter's bias wander, the supply breathes; the transistor preamp barely moves. 0 % = steady.
//   INPUT     trim (click the knob for the house GUARD), OUTPUT, SAT (the output soft clip is always on).
// GUI: drag a knob (SHIFT = fine, double-click / Ctrl-click = default, wheel); values show while a knob is touched.
//   Click the LCD (or PRESETS) for the preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s74.jsfx-inc
import gfx-amp.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{OG,MOD}>-Model
slider2:4<0,10,0.1>-Gain
slider3:0<0,1,1{Off,On}>-Bright
slider4:5<0,10,0.1>-Bass
slider5:5<0,10,0.1>-Middle
slider6:5<0,10,0.1>-Treble
slider7:5<0,10,0.1>-Presence
slider8:2.5<0,10,0.1>-Reverb
slider9:5<0,10,0.1>-Master
slider10:1<0,1,1{Off,On}>-Cab
slider11:3<0,10,0.1>-Mic (on - off axis)
slider12:0<0,1,1{Off,On}>-Mono in
slider13:50<0,100,1>-Drift (%)
slider14:0<-24,12,0.1>-Output (dB)
slider15:0<-24,12,0.1>-Input trim (dB)
slider16:0<0,1,1{Off,On}>-Input guard
slider17:0<0,100,1>-Band sat (%)
slider18:30<0,100,1>-Bias (%)
slider19:120<40,400,1>-Sat low band (Hz)
slider20:6000<2000,16000,10>-Sat high band (Hz)
slider21:-0.3<-24,0,0.1>-Ceiling (dB)
slider22:prs_sel=0<0,12,1{No preset,Init,Chime Clean,New Wave Jangle,City Pop Clean,Funk Snap,Arena Crunch,Big Hair Lead,Pop Rock Rhythm,Fusion Lead,Studio Direct,Surf Spring,Cranked Valves}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=4194304

@init
#ui_man = "gfx-bt-30";                                 // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- curves ----------
// a smooth saturator (rational, exactly 1 from |x| = 3) and its slope
function b3_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function b3_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
// its antiderivative (th = x / 9 + (8 / 3) x / (x^2 + 3)): x^2 / 18 + (4 / 3) ln(1 + x^2 / 3) to |x| = 3, then linear
function b3_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
// OG, first transistor stage: saturation (positive) is firm, cut-off (negative) comes earlier and softer
function b3_tra(u) ( u >= 0 ? b3_th(u) : 0.68 * b3_th(u * 1.4705882) );
function b3_traF(u) ( u >= 0 ? b3_F(u) : 0.4624 * b3_F(u * 1.4705882) );
// OG, second stage: the same clip with a little crossover grit (the gain dips round zero: odd, low-level bite)
function b3_tr2(u) ( b3_th(u) - b3_xo * u / (1 + 400 * u * u) );
function b3_tr2F(u) ( b3_F(u) - b3_xo * 0.00125 * log(1 + 400 * u * u) );
// first-order ADAA on each curve: (G(u) - G(u1)) / (u - u1), the curve at the midpoint when they are within 1e-5
function b3_aa1(u) instance(u1, g1) local(g, d, y) (
  g = b3_traF(u); d = u - u1; y = abs(d) > 0.00001 ? (g - g1) / d : b3_tra(0.5 * (u + u1)); u1 = u; g1 = g; y;
);
function b3_aa2(u) instance(u1, g1) local(g, d, y) (
  g = b3_tr2F(u); d = u - u1; y = abs(d) > 0.00001 ? (g - g1) / d : b3_tr2(0.5 * (u + u1)); u1 = u; g1 = g; y;
);
function b3_aa3(u) instance(u1, g1) local(g, d, y) (
  g = b3_F(u); d = u - u1; y = abs(d) > 0.00001 ? (g - g1) / d : b3_th(0.5 * (u + u1)); u1 = u; g1 = g; y;
);
// MOD: the op-amp, linear to 0.8 then a firm limit at the rails: the house KNEE clipper (gfx-clip, limit 1, knee
// half-width 0.2, anti-aliased)

// ---------- first-order sections (bilinear, c = 2 fs) ----------
function b3_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function b3_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f; b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
function b3_lpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * min(f, 0.45 * fs); b0 = w / (c + w); b1 = b0; a1 = (w - c) / (c + w);
);
function b3_1clr() instance(x1, y1) ( x1 = y1 = 0; );
function b3_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

// ---------- the phase inverter: a long-tailed pair, nearly symmetric (unity small-signal gain, nothing at rest) ----------
// (a new bias re-reads the anti-aliaser's last point on the shifted curve, so a DRIFT change never steps)
function b3_syset(b) instance(b0, g0, n0, aa) ( aa.u1 += b - b0; aa.g1 = b3_F(aa.u1); b0 = b; g0 = b3_th(b); n0 = 1 / max(b3_thd(b), 0.05); );
function b3_syrun(x) instance(b0, g0, n0, aa) ( (aa.b3_aa3(x * 0.5 + b0) - g0) * n0 * 2 + b3_dn );

// ---------- OG: the passive treble / bass / middle stack, third order, from the parts ----------
// t, m, l = treble, middle, bass pot positions 0..1 (middle and bass audio taper)
function b3_tsset(t, m, l, fs) instance(b0, b1, b2, b3, a1, a2, a3)
  local(C1, C2, C3, R1, R2, R3, R4, nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  C1 = 0.00000000047; C2 = 0.000000022; C3 = 0.000000022;
  R1 = 220000; R2 = 1000000; R3 = 22000; R4 = 33000;
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  b0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  b1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  b2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  b3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  a1 = k1 * q; a2 = k2 * q; a3 = k3 * q;
);
function b3_tsrun(x) instance(b0, b1, b2, b3, a1, a2, a3, x1, x2, x3, y1, y2, y3) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 + b3 * x3 - a1 * y1 - a2 * y2 - a3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);
function b3_tsclr() instance(x1, x2, x3, y1, y2, y3) ( x1 = x2 = x3 = y1 = y2 = y3 = 0; );

// ---------- the power stage: the push-pull pair inside its negative-feedback loop ----------
// y = S * (th(A (u - B y) / S + d) - th(d)); S = the supply, d = the pair's imbalance. With y = S Y, u = S U the loop
// reduces to one curve, Y = Q(U + d / A + B th(d)) - th(d), Q solving Q = th(A (U - B Q)): worked out once per model
// (a table, by bisection), so the feedback is exact and stable at any drive.
b3_qn = 4096; b3_qr = 4; b3_qs = (b3_qn - 1) / (2 * b3_qr);
function b3_qbuild(t, A, B) local(i, U, lo, hi, m) (
  i = 0;
  loop(b3_qn,
    U = -b3_qr + i / b3_qs; lo = -1; hi = 1;
    loop(44, m = 0.5 * (lo + hi); m - b3_th(A * (U - B * m)) > 0 ? hi = m : lo = m; );
    t[i] = 0.5 * (lo + hi);
    i += 1;
  );
  t[b3_qn] = t[b3_qn - 1];
);
// ... and its running integral (exact for the table read linearly): c[i] = Int Q from the bottom to point i
function b3_qint(t, c) local(i, h) (
  h = 1 / b3_qs; c[0] = 0; i = 0;
  loop(b3_qn, c[i + 1] = c[i] + h * 0.5 * (t[i] + t[i + 1]); i += 1; );
);
// the antiderivative at p (in table points): inside the table a quadratic per cell, outside a straight continuation
function b3_qF(p) local(i, f, q) (
  p <= 0 ? b3_qt[0] * p / b3_qs : p >= b3_qn - 1 ? b3_qc[b3_qn - 1] + b3_qt[b3_qn - 1] * (p - b3_qn + 1) / b3_qs : (
    i = floor(p); f = p - i; q = b3_qt + i;
    b3_qc[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / b3_qs;
  );
);
function b3_qQ(p) local(i, q) ( p = min(max(p, 0), b3_qn - 1.001); i = floor(p); p -= i; q = b3_qt + i; q[0] + (q[1] - q[0]) * p; );
function b3_paset(d) instance(t0, ofs, p1, f1) local(o) (
  t0 = b3_th(d); o = d / b3_paA + b3_paB * t0; p1 += (o - ofs) * b3_qs; f1 = b3_qF(p1); ofs = o;
);
// anti-aliased: the closed loop is one static curve of U, so ADAA runs on the table's integral (b3_qF)
function b3_pa(u) instance(y, sup, sbase, env, t0, ofs, p1, f1) local(p, a, f, d) (
  p = (u / sup + ofs + b3_qr) * b3_qs; f = b3_qF(p); d = p - p1;
  y = sup * ((abs(d) > 0.00001 ? (f - f1) / d * b3_qs : b3_qQ(0.5 * (p + p1))) - t0);
  p1 = p; f1 = f;
  // supply sag: only when the valves are pushed
  a = abs(y);
  env += (a - env) * (a > env ? b3_sga : b3_sgr);
  sup = sbase * (1 - b3_sgd * min(max(env - b3_sgt, 0) * 2.2, 1));
  y;
);
// output transformer: the core saturates on flux (integrate, saturate, differentiate)
function b3_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * b3_xlk + x * b3_xc; s = b3_th(ph * b3_otk) / b3_otk; y = (s - sp * b3_xlk) / b3_xc; sp = s; y;
);

// ---------- one side of the amp: x in (pre-filtered), rv = the spring's return ----------
function b3_core(x, rv) instance(ip, il, ts, m1, m2, m3, pin, pr, pa, ot, sacc, tb, s1, s2, op, ev, md) local(u, y, b) (
  x += b3_dn;
  u = x * b3_g;
  // the drive's bias: rises with GAIN (more even harmonics) and, at high GAIN, with the stage's own envelope (a loud
  // passage pushes the operating point over: a sag-like give); the rest value is taken off, so no DC step
  ev += (min(abs(u), 3) - ev) * (abs(u) > ev ? b3_eva : b3_evr);
  b = b3_bg + b3_bd * ev;
  b3_mod == 0 ? (                                      // OG: two transistor stages, the passive stack
    b += tb;
    y = s1.b3_aa1(u + b) - b3_tra(b);
    y = il.b3_1run(ip.b3_1run(y));                     // the interstage coupling cap, the stage's bandwidth
    y = s2.b3_aa2(y * 2.2);
    y = ts.b3_tsrun(y) * 3.2;                          // the stack's loss made up by the recovery stage
  ) : (                                                // MOD: the op-amp, the active tone circuit
    y = il.b3_1run(ip.b3_1run(op.clp_run(u + b) - op.clp_crv(b)));
    y = m3.am_run(m2.am_run(m1.am_run(y)));
  );
  y = md.am_run(y);                                    // the dynamic mid dip (deepens with GAIN and with level)
  sacc += y;                                     // the reverb send (the tank runs at the host rate)
  y = (y + rv * b3_rvg) * b3_mv;                       // the return, MASTER
  y = pin.b3_syrun(y);                                 // the phase inverter
  y = pr.am_run(y);                                    // PRESENCE: the loop opens up at the top
  y = pa.b3_pa(y);
  ot.b3_ot(y);
);
function b3_clr() instance(ip, il, ts, m1, m2, m3, md, op, ev) (
  ip.b3_1clr(); il.b3_1clr(); ts.b3_tsclr(); m1.b3_bqclr(); m2.b3_bqclr(); m3.b3_bqclr(); md.b3_bqclr();
  op.clp_set(2, 1, 1, 0); op.clp_knee(0.2); op.clp_reset(); ev = 0;
);
// the valves' operating points (DRIFT moves them; the transistor stage barely)
function b3_bias(w1, w2, w3, w4) instance(pin, pa, tb) local(a) (
  a = dm_a;
  tb = 0.07 + 0.006 * a * w1;
  pin.b3_syset(0.04 + 0.03 * a * w2);
  pa.b3_paset(0.025 * a * w4);                         // the power valves drift out of balance
  pa.sbase = 1 + 0.012 * a * w3;                        // the supply breathes
);

// ---------- the speaker: one 12" in an open-back cabinet; mic 0 = on axis ... 10 = off axis ----------
function b3_cabset(mic) instance(c1, c2, c3, c4, c5, c6, c7) local(m, lp) (
  m = mic / 10;
  c1.am_bq(1, 86, 0.95, 0, srate);                     // open back: the low end falls away under the cone's bump
  c2.am_bq(2, 118, 1.3, 2.5, srate);                   // the cone resonance
  c3.am_bq(2, 520, 1.1, -2.2, srate);                  // the open-back dip
  c4.am_bq(2, 2600, 1.3, 4.5 * (1 - m * 0.75), srate); // the presence peak (on axis)
  lp = 6400 - 2600 * m;
  c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
  c7.am_bq(2, 7400, 2.5, -2 - 8 * m, srate);           // the cone break-up notch, deeper off axis
);
function b3_cabrun(x) instance(c1, c2, c3, c4, c5, c6, c7) (
  c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c2.am_run(c1.am_run(x)))))));
);

// the reverb send (host rate): a solid-state driver into the tank's input transducer
function b3_send(x) instance(lp) ( lp.am_run(x * b3_ksend); );

// ---------- memory and everything that depends on the sample rate ----------
function b3_mem() local(n) (
  s74_mem = 0;
  b3_QT0 = s74_alloc(b3_qn + 2); b3_QT1 = s74_alloc(b3_qn + 2); b3_QC0 = s74_alloc(b3_qn + 2); b3_QC1 = s74_alloc(b3_qn + 2);
  b3_MKT = s74_alloc(32);
  n = floor(0.1 * srate) + 64;
  rsL.am_spring_init(s74_alloc(2 * n), srate); rsR.am_spring_init(s74_alloc(2 * n), srate);
  // two short, bright tanks, a little apart
  rsL.n1 = floor(0.0331 * srate); rsL.n2 = floor(0.0389 * srate); rsL.b2 = rsL.b1 + rsL.n1 + 8;
  rsR.n1 = floor(0.0353 * srate); rsR.n2 = floor(0.0413 * srate); rsR.b2 = rsR.b1 + rsR.n1 + 8;
  rsL.lc = rsR.lc = 1 - exp(-2 * $pi * 4600 / srate);
  rsL.hp.am_bq(1, 320, 0.7, 0, srate); rsR.hp.am_bq(1, 320, 0.7, 0, srate);
  ost_init(0);
);
b3_LAT = 0;                                            // no oversampling: no latency

// ---------- the makeup that keeps every GAIN level matched (dB, GAIN 0 .. 10; measured on pink noise, GUARD off) ----------
function b3_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = b3_MKT + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function b3_tables() (
  b3_row(0, -2.04, -5.41, -8.16, -10.79, -12.61, -13.56, -14.37, -14.72, -14.92, -15.07, -14.87);   // OG
  b3_row(1, 15.80, 13.13, 10.75, 7.91, 5.20, 2.81, 0.38, -1.62, -3.02, -4.04, -4.55);         // MOD
);
function b3_mkdb(md, v) local(p, i, f, q) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i; q = b3_MKT + md * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);

// ---------- the fixed filters of the current model ----------
function b3_fixside() instance(hi, bv) (
  b3_mod == 0 ? (
    hi.b3_hpset(70, srate); bv.am_bq(2, 1700, 0.8, 3, srate);       // the input coupling cap; the 'chime' peak
  ) : (
    hi.b3_hpset(22, srate); bv.am_thru();
  );
);
function b3_fixcore() instance(ip, il) (
  b3_mod == 0 ? ( ip.b3_hpset(140, srate); il.b3_lpset(6500, srate); )   // interstage cap; stage bandwidth
              : ( ip.b3_hpset(5, srate); il.b3_lpset(19000, srate); );
);
function b3_fix() ( pL.b3_fixside(); pR.b3_fixside(); cL.b3_fixcore(); cR.b3_fixcore(); );

// the tone stack, BRIGHT, PRESENCE and the MIC follow the knobs smoothly (recomputed every block from glided values)
function b3_tone(force) local(k, ch, db, fs2) (
  fs2 = srate;                                         // the amp runs at the host rate
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  b3_s2 += (slider2 - b3_s2) * k; b3_s3 += ((slider3 >= 0.5) - b3_s3) * k;
  b3_s4 += (slider4 - b3_s4) * k; b3_s5 += (slider5 - b3_s5) * k; b3_s6 += (slider6 - b3_s6) * k;
  b3_s7 += (slider7 - b3_s7) * k; b3_s11 += (slider11 - b3_s11) * k;
  ch = b3_s2 + 2 * b3_s3 + 3 * b3_s4 + 5 * b3_s5 + 7 * b3_s6 + 11 * b3_s7 + 13 * b3_s11;
  force || abs(ch - b3_lts) > 0.00001 ? (
    b3_lts = ch;
    // BRIGHT: strongest at low GAIN
    db = b3_s3 * (b3_mod == 0 ? 8 : 4) * (1 - 0.65 * b3_s2 / 10);
    pL.bb.am_bq(3, 1500, 0.6, db, srate); pR.bb.am_bq(3, 1500, 0.6, db, srate);
    b3_mod == 0 ? (
      cL.ts.b3_tsset(b3_s6 / 10, b3_s5 / 10, b3_s4 / 10, fs2); cR.ts.b3_tsset(b3_s6 / 10, b3_s5 / 10, b3_s4 / 10, fs2);
      db = -2.5 + 1.1 * b3_s7;
    ) : (
      cL.m1.am_bq(4, 110, 0.7, (b3_s4 - 5) * 2.4, fs2); cR.m1.am_bq(4, 110, 0.7, (b3_s4 - 5) * 2.4, fs2);
      cL.m2.am_bq(2, 850, 0.6, (b3_s5 - 5) * 1.8, fs2); cR.m2.am_bq(2, 850, 0.6, (b3_s5 - 5) * 1.8, fs2);
      cL.m3.am_bq(3, 3200, 0.7, (b3_s6 - 5) * 2.4, fs2); cR.m3.am_bq(3, 3200, 0.7, (b3_s6 - 5) * 2.4, fs2);
      db = -5 + 1.0 * b3_s7;
    );
    cL.pr.am_bq(3, 2800, 0.6, db, fs2); cR.pr.am_bq(3, 2800, 0.6, db, fs2);
    cabL.b3_cabset(b3_s11); cabR.b3_cabset(b3_s11);
  );
);

// ---------- the model: everything that changes with OG / MOD (switched at the silent point of a dip) ----------
function b3_gaindb(md, v) ( md == 0 ? 2 + 3.8 * v : 2.8 * v );
function b3_setmodel(m) (
  b3_mod = m;
  b3_mod == 0 ? (
    b3_qt = b3_QT0; b3_qc = b3_QC0; b3_paA = 8; b3_paB = 0.25; b3_sgd = 0.2; b3_sgt = 0.42; b3_otk = 0.8; b3_xo = 0.12;
  ) : (
    b3_qt = b3_QT1; b3_qc = b3_QC1; b3_paA = 10; b3_paB = 0.6; b3_sgd = 0.06; b3_sgt = 0.55; b3_otk = 0.45; b3_xo = 0;
  );
  b3_fix();
  cL.b3_clr(); cR.b3_clr();
  // the fixed post-shelf per model: makes up the top-end droop of the anti-aliased stages (fitted so the small-signal
  // response at GAIN 0 matches the earlier oversampled amp within 0.1 dB to 11 kHz)
  b3_mod == 0 ? (
    k1L.s74_bqset(3, 0.2994 * srate, 12.5, 1.13, srate); k2L.s74_bqset(5, 0.2125 * srate, 8.92, 0.55, srate);
  ) : (
    k1L.s74_bqset(3, 0.3020 * srate, 12.5, 0.82, srate); k2L.s74_bqset(5, 0.2076 * srate, 0.62, 0.68, srate);
  );
  k1R.b0 = k1L.b0; k1R.b1 = k1L.b1; k1R.b2 = k1L.b2; k1R.a1 = k1L.a1; k1R.a2 = k1L.a2;
  k2R.b0 = k2L.b0; k2R.b1 = k2L.b1; k2R.b2 = k2L.b2; k2R.a1 = k2L.a1; k2R.a2 = k2L.a2;
  // the house pre-filter into the drive: a low-pass from 40 kHz (capped) down to 7 kHz (OG) / 9 kHz (MOD) at full
  // GAIN, and a low shelf at 160 Hz easing the lows into the drive down by up to 3 dB
  pL.pf.clp_pf_cfg(40000, m ? 9000 : 7000, -3, 160); pR.pf.clp_pf_cfg(40000, m ? 9000 : 7000, -3, 160);
  pL.pf.clp_pf_reset(); pR.pf.clp_pf_reset();
  pL.pf.clp_pf_block(slider2 / 10, srate, 1); pR.pf.clp_pf_block(slider2 / 10, srate, 1);
  b3_tone(1);
  cL.b3_bias(cL.w1, cL.w2, cL.w3, cL.w4); cR.b3_bias(cR.w1, cR.w2, cR.w3, cR.w4);
  b3_mkd = b3_tmkd = b3_mkdb(b3_mod, slider2);
  b3_gd = b3_tgd = b3_gaindb(b3_mod, slider2);
);

// ---------- settings ----------
b3_kout = 1;
b3_ksend = 0.5;
function update() (
  b3_tmod = slider1 >= 0.5;
  b3_tgd = b3_gaindb(b3_mod, slider2);                 // GAIN and its makeup glide in dB (a jump never bumps the level)
  b3_tmkd = b3_mkdb(b3_mod, slider2);
  b3_tmvd = -34 + 34 * slider9 / 10;                   // MASTER (dB)
  b3_trv = 0.9 * (slider8 / 10) ^ 1.6;                 // REVERB
  b3_tcab = slider10 >= 0.5;
  b3_tmono = slider12 >= 0.5;
  drift_macro(slider13);
  b3_to = 10 ^ (slider14 / 20) * b3_kout;
  in_setup(slider15, slider16 >= 0.5);
  ost_setup(slider17 / 100, slider18 / 100, slider19, slider20, slider21, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = b3_LAT;
);

// ---------- presets (MONO IN, the input trim / guard and the output stage are left alone; OUTPUT evens the loudness) ----------
function b3_set(md, g, br, b, m, t, pr, rv, ms, cb, mc, df, ou) (
  slider1 = md; slider2 = g; slider3 = br; slider4 = b; slider5 = m; slider6 = t; slider7 = pr; slider8 = rv;
  slider9 = ms; slider10 = cb; slider11 = mc; slider13 = df; slider14 = ou;
  slider_automate(2047 + 4096 + 8192);                 // sliders 1-11, 13 and 14
);
function load_preset(p) (
  //               MODEL GAIN BR  BASS  MID  TREB PRES  REV  MAST CAB MIC DRIFT OUTPUT
  p == 1  ? b3_set(0,    4,   0,  5,    5,   5,   5,   2.5,  5,   1,  3,  50,   0.0) :  // Init
  p == 2  ? b3_set(0,    1.5, 1,  4.5,  5,   6.5, 6,   3,    5,   1,  2,  45,   -6.2) :  // Chime Clean
  p == 3  ? b3_set(0,    2.5, 1,  4,    6,   7,   6.5, 2,    5,   1,  2.5,50,   -5.8) :  // New Wave Jangle
  p == 4  ? b3_set(1,    2,   0,  5,    5.5, 5.5, 5,   2.5,  5,   1,  3,  40,   -0.8) :  // City Pop Clean
  p == 5  ? b3_set(1,    3,   1,  4.5,  4,   6,   6,   0.5,  5,   1,  2,  40,   -2.0) :  // Funk Snap
  p == 6  ? b3_set(0,    6,   0,  5.5,  6.5, 6,   5.5, 1.5,  6,   1,  3,  50,   -3.6) :  // Arena Crunch
  p == 7  ? b3_set(0,    9,   0,  5,    7.5, 6,   6,   2.5,  6.5, 1,  4,  55,   -3.5) :  // Big Hair Lead
  p == 8  ? b3_set(0,    5,   1,  5,    5.5, 5.5, 5,   1.5,  5.5, 1,  3,  50,   -2.9) :  // Pop Rock Rhythm
  p == 9  ? b3_set(1,    7.5, 0,  5,    6,   5,   4.5, 3,    5,   1,  5,  45,   -0.5) :  // Fusion Lead
  p == 10 ? b3_set(1,    3,   0,  5,    5,   5,   5,   0,    5,   0,  3,  30,   -0.5) :  // Studio Direct
  p == 11 ? b3_set(0,    2,   1,  4,    5,   6.5, 6,   7.5,  5,   1,  2,  50,   -6.1) :  // Surf Spring
  p == 12 ? b3_set(0,    3,   0,  5.5,  6,   5,   5,   2,    9,   1,  3.5,60,   -8.2) :  // Cranked Valves
  p == 13 ? (                                           // Reset all to defaults
    b3_set(0, 4, 0, 5, 5, 5, 5, 2.5, 5, 1, 3, 50, 0);
    slider12 = 0; slider15 = 0; slider16 = 0; slider17 = 0; slider18 = 30; slider19 = 120; slider20 = 6000; slider21 = -0.3;
    slider_automate(2097151);                           // sliders 1-21
  );
);

// ---------- state ----------
function b3_start() (
  b3_sr = srate;
  b3_mem();
  b3_qbuild(b3_QT0, 8, 0.25); b3_qbuild(b3_QT1, 10, 0.6); b3_qint(b3_QT0, b3_QC0); b3_qint(b3_QT1, b3_QC1);
  b3_tables();
  b3_xc = 2 * $pi * 40 / srate; b3_xlk = 1 - 2 * $pi * 5 / srate;
  b3_sga = 1 - exp(-1 / (0.012 * srate)); b3_sgr = 1 - exp(-1 / (0.16 * srate));
  b3_smk = 1 - exp(-1 / (0.02 * srate));
  b3_fd = 1 / (0.008 * srate);
  b3_eva = 1 - exp(-1 / (0.003 * srate)); b3_evr = 1 - exp(-1 / (0.12 * srate));   // the bias envelope
  b3_mea = 1 - exp(-1 / (0.03 * srate)); b3_mer = 1 - exp(-1 / (0.25 * srate));            // the mid dip's follower
  b3_me = 0.0079; b3_mc = 0;
  sL.lp.am_bq(0, 4500, 0.7, 0, srate); sR.lp.am_bq(0, 4500, 0.7, 0, srate);
  cL.pa.sup = cL.pa.sbase = 1; cR.pa.sup = cR.pa.sbase = 1;
  in_init();
  update();
  b3_setmodel(b3_tmod);
  b3_mvd = b3_tmvd; b3_rvg = b3_trv; b3_cabm = b3_tcab; b3_mn = b3_tmono; b3_o = b3_to;
  b3_fade = 1; b3_fst = 0;
);
b3_dn = 0.000000000000000001;
b3_start();
ostL.ost_ch_init(); ostR.ost_ch_init();
dw1.drift_init(0.8 + rand(0.5)); dw2.drift_init(0.8 + rand(0.5)); dw3.drift_init(0.8 + rand(0.5)); dw4.drift_init(0.8 + rand(0.5));
dw5.drift_init(0.8 + rand(0.5)); dw6.drift_init(0.8 + rand(0.5)); dw7.drift_init(0.8 + rand(0.5)); dw8.drift_init(0.8 + rand(0.5));
b3_pk = 0; b3_sgm = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
srate != b3_sr ? b3_start();
update();
b3_tone(0);
// GAIN: the drive's bias (static and dynamic), the pre-filter
b3_gg = b3_s2 / 10;
b3_bg = (b3_mod ? 0.10 : 0.16) * b3_gg ^ 1.5; b3_bd = (b3_mod ? 0.06 : 0.10) * b3_gg * b3_gg;
pL.pf.clp_pf_block(b3_gg, srate, samplesblock); pR.pf.clp_pf_block(b3_gg, srate, samplesblock);
// DRIFT: per side, the transistor bias (barely), the phase inverter, the supply and the power valves' balance
b3_di = 0.2 * dm_s * samplesblock / srate;
cL.w1 = dw1.drift_tick(b3_di); cL.w2 = dw2.drift_tick(b3_di); cL.w3 = dw3.drift_tick(b3_di); cL.w4 = dw4.drift_tick(b3_di);
cR.w1 = dw5.drift_tick(b3_di); cR.w2 = dw6.drift_tick(b3_di); cR.w3 = dw7.drift_tick(b3_di); cR.w4 = dw8.drift_tick(b3_di);
cL.b3_bias(cL.w1, cL.w2, cL.w3, cL.w4); cR.b3_bias(cR.w1, cR.w2, cR.w3, cR.w4);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
b3_xl = in_l; b3_xr = in_r;
// MONO IN (glides, no clicks)
b3_mn += (b3_tmono - b3_mn) * b3_smk;
b3_xm = 0.5 * (b3_xl + b3_xr); b3_xl += (b3_xm - b3_xl) * b3_mn; b3_xr += (b3_xm - b3_xr) * b3_mn;
b3_dn = -b3_dn;
// a change of model: fade out, switch at the silent point, wait for the filters to clear, fade in
b3_tmod != b3_mod && b3_fst == 0 ? b3_fst = 1;
b3_fst == 1 ? ( b3_fade -= b3_fd; b3_fade <= 0 ? ( b3_fade = 0; b3_setmodel(b3_tmod); b3_hold = b3_LAT + 48; b3_fst = 2; ); ) :
b3_fst == 2 ? ( b3_hold -= 1; b3_hold <= 0 ? b3_fst = 3; ) :
b3_fst == 3 ? ( b3_fade += b3_fd; b3_fade >= 1 ? ( b3_fade = 1; b3_fst = 0; ); );
// glides
b3_gd += (b3_tgd - b3_gd) * b3_smk; b3_mkd += (b3_tmkd - b3_mkd) * b3_smk; b3_mvd += (b3_tmvd - b3_mvd) * b3_smk;
b3_g = exp(b3_gd * 0.1151293); b3_mv = exp(b3_mvd * 0.1151293);
b3_rvg += (b3_trv - b3_rvg) * b3_smk; b3_cabm += (b3_tcab - b3_cabm) * b3_smk; b3_o += (b3_to - b3_o) * b3_smk;
// the input coupling, the voicing and BRIGHT (host rate)
b3_xl = pL.pf.clp_pf_run(pL.bb.am_run(pL.bv.am_run(pL.hi.b3_1run(b3_xl))));
b3_xr = pR.pf.clp_pf_run(pR.bb.am_run(pR.bv.am_run(pR.hi.b3_1run(b3_xr))));
// the dynamic mid dip: a wide cut (OG 650 Hz, MOD 750 Hz) that deepens with GAIN (to 2 / 1.5 dB at full GAIN on
// quiet playing) and with the playing level (a gentle follower: 30 ms in, 250 ms out; up to 4 / 3 dB on loud passages)
b3_x2 = 0.5 * (b3_xl * b3_xl + b3_xr * b3_xr);
b3_me += (b3_x2 - b3_me) * (b3_x2 > b3_me ? b3_mea : b3_mer);
(b3_mc -= 1) <= 0 ? (
  b3_mc = 32;
  b3_e = min(max((10 * log10(b3_me + 0.0000000001) + 33) / 18, 0), 1);
  b3_md = -(b3_gg ^ 1.4) * (b3_mod ? 1.5 + 1.5 * b3_e : 2 + 2 * b3_e);
  cL.md.am_bq(2, b3_mod ? 750 : 650, 0.6, b3_md, srate); cR.md.b0 = cL.md.b0; cR.md.b1 = cL.md.b1;
  cR.md.b2 = cL.md.b2; cR.md.a1 = cL.md.a1; cR.md.a2 = cL.md.a2;
);
// the spring tanks (host rate; fed with the send of the last sample)
b3_rl = rsL.am_spring_run(sL.b3_send(cL.sacc), 0.7); b3_rr = rsR.am_spring_run(sR.b3_send(cR.sacc), 0.7);
cL.sacc = 0; cR.sacc = 0;
// the amps (anti-aliased stages; the fixed post-shelf)
b3_yl = k2L.s74_bq(k1L.s74_bq(cL.b3_core(b3_xl, b3_rl))); b3_yr = k2R.s74_bq(k1R.s74_bq(cR.b3_core(b3_xr, b3_rr)));
b3_sgm = max(b3_sgm, max(cL.pa.env, cR.pa.env));       // the sag lamp (read by the panel)
// the speaker (CAB off = line out), the output section
b3_cl = cabL.b3_cabrun(b3_yl); b3_cr = cabR.b3_cabrun(b3_yr);
b3_yl += (b3_cl - b3_yl) * b3_cabm; b3_yr += (b3_cr - b3_yr) * b3_cabm;
b3_k = exp(b3_mkd * 0.1151293) * b3_o * b3_fade;
b3_yl = ostL.ost_band(b3_yl * b3_k); b3_yr = ostR.ost_band(b3_yr * b3_k);
ost_out(b3_yl, b3_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
b3_pk = max(b3_pk, max(abs(spl0), abs(spl1)));

@gfx 1000 390
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1000, 390);

// =====================================================================
// A field chassis on a dark-steel case: hex screws, cast-metal pointer knobs, backlit square lenses, thin accent rules
// grouping the sections. OG wears dark grey and orange, MOD ivory and charcoal with red accents.
// =====================================================================
s74_pal(0);
S74_OLIVE = 0xECE8DC; S74_INK = 0x2A2C2F; S74_DIM = 0x5C5F63; S74_HAZ = 0xC8312B;
S74_LAMP = 0xD8403A; S74_LTXT = 0xFFF6EE; B3_KB = 0x2E3134; B3_KF = 0x3E4246;
// the look follows the model: OG = dark grey and orange, MOD = ivory and charcoal (above)
!b3_tmod ? (
  S74_OLIVE = 0x3C3E41; S74_INK = 0xECE7DB; S74_DIM = 0xABA79D; S74_HAZ = 0xF07C1E;
  S74_LAMP = 0xF5862A; S74_LTXT = 0x24140A; B3_KB = 0x1D1F21; B3_KF = 0x2E3135;
);
sc != b3g_calsc ? (
  b3g_calsc = sc;
  b3g_f1 = ui_fitfont(11, 14.5 * sc);                  // knob names
  b3g_f2 = ui_fitfont(12, 13.5 * sc);                  // section titles
  b3g_f3 = ui_fitfont(13, 12 * sc);                    // small print, lens captions, values
);
gfx_setfont(11, "Arial", b3g_f1, 'b'); gfx_setfont(12, "Arial", b3g_f2, 'b'); gfx_setfont(13, "Arial", b3g_f3, 'b');
gfx_setfont(14, "Arial", 28 * sc, 'b'); gfx_setfont(15, "Arial", 15 * sc, 'b');
s74_lamp = 1;                                           // the house lamp keys on the panel (gfx-s74 / gfx-ui)
sc != b3g_lsc ? ( b3g_lsc = sc; gfx_setfont(16, "Arial", 12 * sc, 'b'); gfx_setfont(10, "Arial", 11 * sc, 'b'); );
lk_font = 16; lk_font2 = 10;                            // lamp-key legends: caps 26 px tall or more / smaller caps

// ---------- the cast-metal pointer knob: one solid body, a cast pointer fin, a bold index line ----------
function b3g_cap(cx, cy, r, n) local(a, ca, sa, i, t, l, qx, qy, rp, tx, ty, px, py, w0, w1) (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 10 : 7;
    ui_cola(S74_INK, 0.85); s74_ln(cx + sin(t) * (r + 4), cy - cos(t) * (r + 4), cx + sin(t) * (r + l), cy - cos(t) * (r + l), i == 0 || i == 5 || i == 10 ? 1.8 : 1.2);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  qx = cx * sc; qy = cy * sc; rp = r * sc;
  ui_cola(0x000000, 0.5); gfx_circle(qx + 1.6 * sc, qy + 3 * sc, rp, 1, 1);
  ui_col(0x16181A); gfx_circle(qx, qy, rp, 1, 1);
  ui_col(B3_KB); gfx_circle(qx, qy, rp - 1.2 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.13); gfx_arc(qx, qy, rp - 1.6 * sc, -0.8 * $pi, 0.05 * $pi, 1);
  // the pointer fin, cast with the body: wide at the tail, narrow at the tip
  tx = qx - ca * rp * 0.62; ty = qy - sa * rp * 0.62; px = qx + ca * rp * 0.97; py = qy + sa * rp * 0.97;
  w0 = rp * 0.30; w1 = rp * 0.13;
  ui_cola(0x000000, 0.35);
  ui_ssquad(tx - sa * w0 + 1.2 * sc, ty + ca * w0 + 2 * sc, px - sa * w1 + 1.2 * sc, py + ca * w1 + 2 * sc,
               px + sa * w1 + 1.2 * sc, py - ca * w1 + 2 * sc, tx + sa * w0 + 1.2 * sc, ty - ca * w0 + 2 * sc);
  ui_col(B3_KF);
  ui_ssquad(tx - sa * w0, ty + ca * w0, px - sa * w1, py + ca * w1, px + sa * w1, py - ca * w1, tx + sa * w0, ty - ca * w0);
  // the index line along the fin
  ui_col(S74_IDX); s74_ln(cx + ca * r * 0.05, cy + sa * r * 0.05, cx + ca * r * 0.93, cy + sa * r * 0.93, max(2.4, r * 0.11));
);
// a knob: drag (SHIFT = fine), double-click / Ctrl-click = default, wheel; the value shows only while touched
function b3g_knob(cx, cy, r, idx, lo, hi, def, label, fmt) local(v, n, dx, dy, hov, did) (
  did = 4000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - b3g_lt < 0.35 && b3g_lid == idx && !b3g_mv) || (mouse_cap & 4) ? ( s74_set(idx, def); drag_id = -1; b3g_lt = 0; ) : (
      drag_id = did; b3g_ky = mouse_y; b3g_ky0 = mouse_y; b3g_mv = 0; b3g_lt = time_precise(); b3g_lid = idx;
      b3g_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !b3g_mv && abs(mouse_y - b3g_ky0) > 3 * sc ? ( b3g_mv = 1; b3g_ky = mouse_y; );
  drag_id == did && b3g_mv ? (
    b3g_kn = min(max(b3g_kn + (b3g_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); b3g_ky = mouse_y;
    v = floor((lo + b3g_kn * (hi - lo)) * 10 + 0.5) / 10;
    slider(idx) != v ? s74_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max((v - lo) / (hi - lo) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    s74_set(idx, floor((lo + n * (hi - lo)) * 10 + 0.5) / 10); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  b3g_cap(cx, cy, r, n);
  (hov || drag_id == did) ? (
    sprintf(#b3g_v, fmt, v); s74_pill(cx, cy + r + 8, #b3g_v);
  ) : (
    gfx_setfont(11); ui_col(S74_INK); s74_tc(cx, cy + r + 18, label);
  );
);
// a section title: a hazard-orange tick, the title
function b3g_sec(x, y, s) ( ui_col(S74_HAZ); gfx_circle((x + 2) * sc, (y + 8.5) * sc, 3 * sc, 1, 1); gfx_setfont(12); ui_col(S74_INK); s74_t(x + 9, y, s); );
// a thin hazard-orange rule
function b3g_vr(x, y1, y2) ( ui_cola(S74_HAZ, 0.85); s74_r(x, y1, 1, y2 - y1); );
function b3g_hr(x1, x2, y) ( ui_cola(S74_HAZ, 0.85); s74_r(x1, y, x2 - x1, 1); );

// ---------- the case, the header ----------
s74_face(1000, 390);
b3g_m = b3_tmod;                                         // the model the panel shows (the switch, not the dip)
ui_col(S74_HAZ); s74_r(16, 12, 46, 30);
gfx_setfont(15); ui_col(0xF4F0E4); s74_tc(39, 27, "GFX");
gfx_setfont(14); gfx_measurestr("BT-30", b3g_w, b3g_h);
ui_col(0xE9E6D6); gfx_x = 72 * sc; gfx_y = 13 * sc - b3g_h * 0.17; gfx_drawstr("BT-30"); ver_tag("v3", 9, 5.35, 0);
b3g_x = 72 + b3g_w / sc + 14;
gfx_setfont(13); ui_col(0xA9A98E); s74_t(b3g_x, 14, "HYBRID COMBO  ·  1x12"); s74_t(b3g_x, 29, "SS PRE  ·  VALVE POWER");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
b3g_k = pk_preset(332 * sc, 10 * sc, 380 * sc, 34 * sc, pr_cur,
  "Init|Chime Clean|New Wave Jangle|City Pop Clean|Funk Snap|Arena Crunch|Big Hair Lead|Pop Rock Rhythm|Fusion Lead|Studio Direct|Surf Spring|Cranked Valves");
b3g_k > 0 ? ( prs_dirty = b3g_k; pr_cur = b3g_k > 12 ? 1 : b3g_k; );
lk_well = 0x141518;                                     // the header keys sit on the dark steel
s74_lk = LK_YEL; s74_lens(730, 14, 72, 26, !b3g_m, "OG") ? s74_set(1, 0);
s74_lk = LK_YEL; s74_lens(808, 14, 82, 26, b3g_m, "MOD") ? s74_set(1, 1);
lk_well = b3g_m ? 0x2A2722 : 0x141518;                  // the panel keys: MOD's ivory plate is a light face
ui_size_picker(926 * sc, 18 * sc);

// ---------- the chassis plate ----------
ui_cola(0x000000, 0.5); s74_r(11, 57, 978, 324);
ui_col(S74_OLIVE); s74_r(12, 58, 976, 322);
ui_cola(0xFFFFFF, 0.10); s74_r(12, 58, 976, 1); s74_r(12, 58, 1, 322);
ui_cola(0x000000, 0.30); s74_r(12, 379, 976, 1); s74_r(987, 58, 1, 322);
s74_hex(25, 71, 4.2); s74_hex(975, 71, 4.2); s74_hex(25, 367, 4.2); s74_hex(975, 367, 4.2);
b3g_vr(262, 70, 236); b3g_vr(532, 70, 236); b3g_vr(792, 70, 236);
b3g_hr(40, 960, 248);
b3g_vr(262, 260, 368); b3g_vr(532, 260, 368);

// ---------- the amp: PREAMP | TONE | POWER AMP | REVERB ----------
b3g_sec(40, 70, "PREAMP  ·  SOLID STATE");
b3g_knob(100, 150, 38, 2, 0, 10, 4, "GAIN", "%.1f");
s74_lk = LK_YEL; s74_lens(170, 136, 72, 28, slider3 >= 0.5, "BRIGHT") ? s74_set(3, slider3 >= 0.5 ? 0 : 1);
b3g_sec(282, 70, b3g_m ? "TONE  ·  ACTIVE" : "TONE  ·  PASSIVE");
b3g_knob(318, 150, 28, 4, 0, 10, 5, "BASS", "%.1f");
b3g_knob(400, 150, 28, 5, 0, 10, 5, "MIDDLE", "%.1f");
b3g_knob(482, 150, 28, 6, 0, 10, 5, "TREBLE", "%.1f");
b3g_sec(552, 70, "POWER AMP  ·  2 x 6L6");
b3g_knob(596, 150, 28, 7, 0, 10, 5, "PRESENCE", "%.1f");
b3g_knob(706, 150, 38, 9, 0, 10, 5, "MASTER", "%.1f");
b3g_sec(812, 70, "SPRING");
b3g_knob(852, 150, 28, 8, 0, 10, 2.5, "REVERB", "%.1f");
// the valve lamp: glows with the power stage's load (it flares as the supply sags)
b3g_sg = max(b3_sgm, b3g_sg * 0.8); b3_sgm = 0;
b3g_lv = min(0.35 + 0.9 * b3g_sg, 1);
b3g_lx = 940 * sc; b3g_ly = 150 * sc;
ui_cola(0xFFAE3A, 0.10 * b3g_lv); gfx_circle(b3g_lx, b3g_ly, 22 * sc, 1, 1);
ui_cola(0xFFAE3A, 0.16 * b3g_lv); gfx_circle(b3g_lx, b3g_ly, 16 * sc, 1, 1);
ui_col(0x101112); gfx_circle(b3g_lx, b3g_ly, 12.5 * sc, 1, 1);
ui_col(0x3A3E41); gfx_circle(b3g_lx, b3g_ly, 11.2 * sc, 1, 1);
ui_col(ui_mix(0x5A3A12, 0xFFB648, b3g_lv)); gfx_circle(b3g_lx, b3g_ly, 8.6 * sc, 1, 1);
ui_cola(0xFFFFFF, 0.35); gfx_circle(b3g_lx - 2.8 * sc, b3g_ly - 3 * sc, 2 * sc, 1, 1);
gfx_setfont(11); ui_col(S74_INK); s74_tc(940, 196, "VALVES");

// ---------- the bottom row: SPEAKER | AMP | IN / OUT ----------
b3g_sec(40, 260, "SPEAKER  ·  1x12 OPEN");
s74_lk = LK_AMB; s74_lens(52, 300, 78, 28, slider10 >= 0.5, "CAB") ? s74_set(10, slider10 >= 0.5 ? 0 : 1);
s74_smallc(91, 342, slider10 >= 0.5 ? "SPEAKER" : "LINE OUT");
b3g_knob(200, 316, 22, 11, 0, 10, 3, "MIC", "%.1f");
// the speaker section switched off (line out): greyed a little, its CAB key redrawn clear on top
slider10 < 0.5 ? (
  ui_cola(S74_OLIVE, 0.5); s74_r(30, 278, 228, 96);
  s74_lk = LK_AMB; s74_lens(52, 300, 78, 28, slider10 >= 0.5, "CAB") ? s74_set(10, slider10 >= 0.5 ? 0 : 1);
);
b3g_sec(282, 260, "AMP");
s74_lk = LK_RED; s74_lens(300, 300, 90, 28, slider12 >= 0.5, "MONO IN") ? s74_set(12, slider12 >= 0.5 ? 0 : 1);
s74_smallc(345, 342, slider12 >= 0.5 ? "L + R" : "STEREO");
b3g_knob(470, 316, 22, 13, 0, 100, 50, "DRIFT", "%.0f%%");
b3g_sec(552, 260, "IN / OUT");
b3g_knob(584, 316, 22, 15, -24, 12, 0, "INPUT", "%+.1f dB");
ui_guardclick(4000 + 15, 16, 584, 316, 22);             // click INPUT for the house GUARD (its LED, upper right)
b3g_knob(664, 316, 22, 17, 0, 100, 0, "SAT", "%.0f%%");
ost_clipped ? pk_led(690 * sc, 292 * sc, 3.5 * sc, 1, 0xFF3A22); ost_clipped = 0;
b3g_knob(744, 316, 22, 14, -24, 12, 0, "OUTPUT", "%+.1f dB");
b3g_pkv = max(b3_pk, b3g_pkv * 0.85); b3_pk = 0;
b3mO.s74_edge(800, 282, 170, 62, b3g_pkv * 4, "OUT");

pk_end();
ui_end();
