s74_pal(0);
S74_OLIVE = 0xECE8DC; S74_INK = 0x2A2C2F; S74_DIM = 0x5C5F63; S74_HAZ = 0xC8312B;
S74_LAMP = 0xD8403A; S74_LTXT = 0xFFF6EE; B3_KB = 0x2E3134; B3_KF = 0x3E4246;
