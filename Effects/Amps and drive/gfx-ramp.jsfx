// ================================================================ POWER AMP
rg_tray(632, 300, 180, 180, rg_tray0, "POWER AMP");
rg_w = floor(slider2 + 0.5);
rg_disp(644, 354, 156, 48, 2, PRE_LIST, "MODULE",
  rg_w == 0 ? "EL34 PUSH-PULL" : rg_w == 1 ? "FOUR 6L6, FEEDBACK" : rg_w == 2 ? "SOLID STATE" : "FOUR EL34");
gfx_setfont(5);  rg_col(rg_cink2, 1);
rg_step(644, 414, 74, 2, 4);
rg_x0 = 824;  rg_y0 = 300;
