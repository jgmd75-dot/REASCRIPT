  gfx_setfont(6);  rg_col(rg_cink2, 1);  rg_tc(rg_px(rg_x0 + 99), rg_py(rg_y0 + 74), "LINE OUT");
  rg_kn(rg_x0 + 290, rg_y0 + 68, 18, 5, 0, 100, 100, 0, 0x8A8C86, "WIDTH", "%.0f %%");
);

// ================================================================ IN / OUT
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(552, 496, 512, 148, rg_tray0, "IN / OUT");
rg_tog(568, 540, 96, 28, 6, 0xF2A41E, "MONO IN");
rg_tog(568, 588, 96, 28, 10, 0x5FC4C0, "GUARD");
rg_kn(718, 578, 18, 7, -80, -20, -80, 0, 0x8A8C86, "GATE", slider7 <= -79.5 ? "off" : "%.0f dB");
rg_kn(790, 578, 18, 9, -24, 12, 0, 0, 0xE6E3DC, "TRIM", "%+.1f dB");
rg_kn(862, 578, 18, 11, 0, 100, 50, 0, 0x6F8794, "DRIFT", "%.0f %%");
rg_kn(934, 578, 18, 12, -24, 12, 0, 0, 0xE0A030, "OUTPUT", "%+.1f dB");
// the output meter: L / R LED bars, -42 .. +3 dBFS in 3 dB steps, the peak held 1.2 s then falling
!rg_minit ? ( rg_hl = rg_hr = -120;  rg_minit = 1; );
rg_ml = max(rp_pkL_disp, rg_ml * 0.85);  rg_mr = max(rp_pkR_disp, rg_mr * 0.85);  rp_pkL_disp = rp_pkR_disp = 0;
rg_now = time_precise();
rg_j = 0;
loop(2,
  rg_v = rg_j ? rg_mr : rg_ml;  rg_db = rg_v > 0.000001 ? 20 * log10(rg_v) : -120;
  rg_db >= (rg_j ? rg_hr : rg_hl) || rg_now - (rg_j ? rg_tmr : rg_tml) > 1.2 ? (
    rg_db >= (rg_j ? rg_hr : rg_hl) ? ( rg_j ? ( rg_hr = rg_db; rg_tmr = rg_now; ) : ( rg_hl = rg_db; rg_tml = rg_now; ); ) :
      ( rg_j ? rg_hr = max(rg_db, rg_hr - 0.6) : rg_hl = max(rg_db, rg_hl - 0.6); );
  );
  rg_mx = 1000 + rg_j * 22;
  rg_col(0x0E0D0C, 1);  rg_rect(rg_mx, 520, 18, 100);
  rg_i = 0;
  loop(15,
    rg_d = -42 + rg_i * 3;
    rg_col(rg_d >= 0 ? 0xE0503A : rg_d >= -9 ? 0xF2A41E : 0x5FC4C0, rg_db >= rg_d ? 1 : 0.14);
    rg_rect(rg_mx + 3, 616 - (rg_i + 1) * 6.4 + 1, 12, 5);
    rg_i += 1;
  );
  rg_h = rg_j ? rg_hr : rg_hl;
  rg_h > -42 ? ( rg_col(0xFFFFFF, 0.95);  rg_rect(rg_mx + 2, 616 - (floor((min(rg_h, 3) + 42) / 3) + 1) * 6.4 + 1, 14, 2); );
  rg_j += 1;
);
rg_click && rg_in(1000, 520, 40, 100) ? rg_hl = rg_hr = -120;   // clear the peaks
gfx_setfont(5);  rg_col(rg_cink2, 1);  rg_tc(rg_px(1009), rg_py(630), "L");  rg_tc(rg_px(1031), rg_py(630), "R");

// ---------- OS key (house): left of the S / M / L / ? picker; cycles 1x -> 2x -> 4x ----------
os_key(rg_ox / sc + 956, rg_oy / sc + 18, 8, 0xE0A030, 12);

// ---------- S / M / L / ? (size picker and credits), four 13 x 18 keys on a 14 pitch ----------
rg_j = 0;
loop(4,
  rg_gx = 1006 + rg_j * 14;  rg_on = rg_j == 0 ? ui_sz == 1 : rg_j == 1 ? ui_sz == 0 : rg_j == 2 ? ui_sz == 2 : rg_help;
  rg_col(0x050302, 1);  rg_rect(rg_gx, 20, 13, 18);
  rg_col(rg_on ? 0xFFB347 : 0x3A3632, 1);  rg_rect(rg_gx + 1, 21, 11, 16);
  gfx_setfont(5);  rg_col(rg_on ? 0x140D06 : 0xE0C8A0, 1);  rg_tc(rg_px(rg_gx + 6.5), rg_py(29), rg_j == 0 ? "S" : rg_j == 1 ? "M" : rg_j == 2 ? "L" : "?");
  rg_click && !rg_help && rg_in(rg_gx, 20, 13, 18) ? (
    rg_j == 0 ? ui_sz = 1 : rg_j == 1 ? ui_sz = 0 : rg_j == 2 ? ui_sz = 2 : ( rg_help = 1;  rg_hnew = 1; );
  );
  rg_j += 1;
);
// the card: credits, website, manual; a click anywhere closes it
strcpy(#rgh3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#rgh3, #ui_man);  strcat(#rgh3, ".pdf");
gfx_setfont(5);  gfx_measurestr(#rgh3, rg_tw, rg_th);
rg_cw = max(rg_tw + rg_ps(40), rg_ps(440));  rg_ch = rg_ps(140);
rg_cx = (gfx_w - rg_cw) * 0.5;  rg_cy = (gfx_h - rg_ch) * 0.5;
rg_help && rg_hclick && !rg_hnew ? ( rg_help = 0;  rg_hclick = 0; );
rg_hnew = 0;
rg_help ? (
  rg_col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  rg_col(0x000000, 0.5);  rg_rrs(rg_cx + rg_ps(3), rg_cy + rg_ps(5), rg_cw, rg_ch, rg_ps(8));
  rg_col(0x1C1D20, 1);    rg_rrs(rg_cx, rg_cy, rg_cw, rg_ch, rg_ps(8));
  rg_col(0xE0A030, 1);    gfx_rect(rg_cx + rg_ps(20), rg_cy + rg_ps(36), rg_cw - rg_ps(40), max(1, rg_ps(1)), 1);
  gfx_setfont(6);  rg_col(0xF2F2EE, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  rg_col(0xE8B23A, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  rg_col(0xD8D6D0, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(72);  gfx_drawstr(#rgh3);
  rg_col(0x85837E, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(110);  gfx_drawstr("Click anywhere to close.");
);

