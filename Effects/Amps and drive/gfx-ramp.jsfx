rg_kdim = slider42 < 0.5;  rg_kn(272, 436, 18, 44, 0, 10, 3, 0, 0xC9A040, "LEVEL", "%.1f");
rg_kdim = slider42 < 0.5;  rg_kn(356, 436, 18, 45, 0, 10, 5, 0, 0xC9A040, "DWELL", "%.1f");
slider42 < 0.5 ? rg_dim(230, 374, 176, 34);
