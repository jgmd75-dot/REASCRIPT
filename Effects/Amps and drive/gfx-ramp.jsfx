  rg_rad(rg_x0 + 188, rg_y0 + 8, 44, 22, rwi(73), 1, rg_kc, "LEAD");
  rg_kn(rg_x0 + 70, rg_y0 + 108, 24, rwi(74), 0, 10, 5, rg_ks, 0, "PRESENCE", "%.1f");
  rg_kn(rg_x0 + 170, rg_y0 + 108, 24, rwi(75), 0, 10, 5, rg_ks, 0, "MASTER", "%.1f");
);

// ================================================================ CABINET
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 496, 180, 148, rg_tray0, "CABINET");
rg_cb = floor(slider3 + 0.5);
rg_disp(28, 550, 156, 48, 3, CAB_LIST, "SPEAKERS",
  rg_cb == 0 ? "NO CABINET" : rg_cb <= 2 ? "AMP HEAD" : rg_cb == 3 ? "FULLERTON 65" : rg_cb == 4 ? "MALI 120" : rg_cb == 5 ? "MALI 55" : "GR-120");
rg_step(28, 606, 74, 3, 7);
rg_m = rg_cb == 0 ? -1 : rg_cb <= 2 ? 0 : rg_cb == 3 ? 1 : rg_cb <= 5 ? 2 : 3;
rg_x0 = 208;  rg_y0 = 496;
rg_m >= 0 ? (
  rg_livery(rg_m);
  rg_i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(rg_x0 + 2 + rg_i * 1.33, rg_y0 + 3 + rg_i * 1.67, 328 + rg_i * 0.6, 148 + rg_i * 0.6);  rg_i += 1; );
  rg_col(rg_plate, 1);  rg_rect(rg_x0, rg_y0, 328, 148);
  // the grille cloth: each maker's weave
  rg_gc = rg_m == 0 ? 0x2A2826 : rg_m == 1 ? 0x8C8E90 : rg_m == 2 ? 0x141518 : 0x2A2420;
  rg_col(rg_gc, 1);  rg_rect(rg_x0 + 14, rg_y0 + 14, 170, 120);
  rg_i = 0;
  loop(rg_m == 2 ? 30 : 40,
    rg_m == 2 ? ( rg_col(0x3A3D44, 0.6);  rg_rect(rg_x0 + 14 + rg_i * 5.67, rg_y0 + 14, 1, 120);  rg_rect(rg_x0 + 14, rg_y0 + 14 + rg_i * 4, 170, 1); ) :
    ( rg_col(rg_m == 1 ? 0xFFFFFF : 0xC8B898, rg_m == 1 ? 0.12 : 0.08);  rg_rect(rg_x0 + 14 + rg_i * 4.25, rg_y0 + 14, 1, 120);
      rg_col(0x000000, 0.12);  rg_rect(rg_x0 + 14, rg_y0 + 14 + rg_i * 3, 170, 1); );
    rg_i += 1;
  );
  rg_m == 1 ? ( rg_col(0xFFFFFF, 0.18);  gfx_circle(rg_px(rg_x0 + 70), rg_py(rg_y0 + 74), rg_ps(42), 0, 1);  gfx_circle(rg_px(rg_x0 + 128), rg_py(rg_y0 + 74), rg_ps(42), 0, 1); );
  rg_col(0x000000, 0.4);  rg_rect(rg_x0 + 14, rg_y0 + 14, 170, 2);  rg_rect(rg_x0 + 14, rg_y0 + 14, 2, 120);
  gfx_setfont(6);  rg_col(rg_m == 1 ? 0x1A1A1A : 0xD8CCB4, 0.8);
  rg_tc(rg_px(rg_x0 + 99), rg_py(rg_y0 + 74), rg_cb == 1 || rg_cb == 3 ? "2 x 12  OPEN" : rg_cb == 2 || rg_cb == 6 ? "4 x 12  CLOSED" : rg_cb == 4 ? "2 x 12" : "2 x 8");
  rg_col(0x000000, 0.25);  rg_rect(rg_x0, rg_y0 + 146, 328, 2);  rg_rect(rg_x0 + 326, rg_y0, 2, 146);
