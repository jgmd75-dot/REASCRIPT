desc:Ramp [guitar amp] (GFX)
//tags: amp amplifier guitar valve tube solid state head combo cabinet reverb spring tremolo chorus modular
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-amp, gfx-clip, gfx-os (.jsfx-inc) in the same folder.
//
// RAMP - one guitar amp built from interchangeable pieces. The four GFX guitar amps (Amp Head's GUITAR model,
// Fullerton 65, Mali 120, GR-120) are each split into a PREAMP, a POWER AMP and a CABINET, and any piece plugs into
// any other: the GR-120's graphic preamp into the Fullerton's 6L6 power amp and the Mali's 2x12, say. Most of the
// combinations never existed as hardware. Choose the three pieces of one original and you have that amp, sample for
// sample (each piece is its original's code, ported; a matched set nulls against the original with DRIFT at 0).
//   PREAMP     AMP HEAD    all-valve, CLEAN / DRIVE channels, BRIGHT, a tone stack and a spring tank.
//              FULLERTON   black-panel NORMAL / VIBRATO channels (JUMPER), the passive stack, a three-spring tank and
//                          the optical tremolo.
//              MALI 120    solid-state NORMAL / EFFECT channels, the op-amp DISTORTION (smoothed: JG found the
//                          original's too harsh) and a short spring; its chorus / vibrato is the FX LOOP's (JG, 27 Oct 2026).
//              GR-120      the cascaded graphic preamp: GAIN, BASS / TREBLE, FREQ CONTOUR, the six-band GRAPHIC and a
//                          DOOM / LEAD voicing.
//   POWER AMP  AMP HEAD    EL34-style push-pull, shared supply sag, PRESENCE, MASTER.
//              FULLERTON   four 6L6-style valves inside a feedback loop, MASTER (new: 5 = the original's drive).
//              MALI 120    a clean solid-state stage that clips hard at the rails, MASTER (new: 5 = as the original).
//              GR-120      four EL34-style valves with little feedback, grid blocking, a big transformer, PRESENCE,
//                          MASTER and its own DOOM / LEAD voicing.
//   CABINET    2x12 open and 4x12 closed (Amp Head), 2x12 open (Fullerton 65, the two speakers not quite matched),
//              2x12 and 2x8 (Mali 120 and its 55 sibling), 4x12 closed (GR-120), or off (the line out).
//              MIC (on to off axis) moves the Amp Head and GR-120 mics; WIDTH spreads the two speakers (100 % = L / R).
//   FX LOOP    between the preamp and the power amp (new): the Mali's CHORUS / VIBRATO (SPEED, DEPTH), a SPRING tank
//              (the Amp Head's long one or the Mali's short one; LEVEL, DWELL) and the Fullerton's optical TREMOLO (SPEED,
//              INTENSITY, STEREO), each with its own IN key, any of them with any preamp.
// Levels: a piece feeding another's input is scaled so the next piece sees the level its own partner gives it, and
//   each mixed pair is level-matched to the preamp's own amp.
// Piece changes duck (8 ms out, the swap at silence, 8 ms back), so nothing clicks.
// ANTI-ALIASING / OS: the preamp and power amp run together at 1x, 2x or 4x (the OS key; 2x = 31 samples of latency,
//   4x = 37). 1x keeps each original's own host-rate anti-aliasing (ADAA on every valve, the drive-tracking pre-filter,
//   the post-shelves); the GR-120 pieces always ran at 2x, so they match their original at 2x.
// DRIFT (0 - 100 %, 50 % = standard; JG, 27 Oct 2026): each piece brings the drift of its original - the preamp
//   valves' bias, the power valves' balance and the supply's breathing, the Mali's distortion bias and rails.
// IN / OUT: TRIM (GUARD), MONO IN, GATE (fully down = off), OUTPUT, and the house output stage (CLIP, always on).
// GUI: each slot (PREAMP, POWER AMP, CABINET) has a display box - click it for the menu - and the piece in it wears its
//   own amp's colours. Drag a knob (Shift = fine), double-click or Ctrl-click = default; values show while touched.
//
// Latency: 0 samples at 1x, 31 at 2x, 37 at 4x (reported).

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-amp.jsfx-inc
import gfx-clip.jsfx-inc
import gfx-os.jsfx-inc

slider1:0<0,3,1{Amp Head,Fullerton 65,Mali 120,GR-120}>-Preamp
slider2:0<0,3,1{Amp Head,Fullerton 65,Mali 120,GR-120}>-Power amp
slider3:1<0,6,1{Off (line out),2x12 open (Amp Head),4x12 closed (Amp Head),2x12 open (Fullerton 65),2x12 (Mali 120),2x8 (Mali 55),4x12 closed (GR-120)}>-Cabinet
slider4:3<0,10,0.1>-Mic position (on - off axis)
slider5:100<0,100,1>-Width (%)
slider6:0<0,1,1{Off,On}>-Mono in
slider7:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider8:0<0,2,1{1x,2x,4x}>-Oversampling
slider9:0<-24,12,0.1>-Input trim (dB)
slider10:0<0,1,1{Off,On}>-Input guard
slider11:50<0,100,1>-Drift (%)
slider12:0<-24,12,0.1>-Output (dB)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-Ceiling (dB)
slider18:5<-12,12,0.1>-Preamp control 1
slider19:0<-12,12,0.1>-Preamp control 2
slider20:0<-12,12,0.1>-Preamp control 3
slider21:5<-12,12,0.1>-Preamp control 4
slider22:5<-12,12,0.1>-Preamp control 5
slider23:5<-12,12,0.1>-Preamp control 6
slider24:2<-12,12,0.1>-Preamp control 7
slider25:0<-12,12,0.1>-Preamp control 8
slider26:0<-12,12,0.1>-Preamp control 9
slider27:0<-12,12,0.1>-Preamp control 10
slider28:0<-12,12,0.1>-Preamp control 11
slider29:0<-12,12,0.1>-Preamp control 12
slider30:0<-12,12,0.1>-Preamp control 13
slider31:0<-12,12,0.1>-Preamp control 14
slider32:0<-12,12,0.1>-Preamp control 15
slider33:0<-12,12,0.1>-Preamp control 16
slider34:5<-12,12,0.1>-Power amp control 1
slider35:4<-12,12,0.1>-Power amp control 2
slider36:0<-12,12,0.1>-Power amp control 3
slider38:0<0,1,1{Off,On}>-Loop chorus
slider39:0<0,1,1{Chorus,Vibrato}>-Loop chorus mode
slider40:5<0,10,0.1>-Loop chorus speed
slider41:5<0,10,0.1>-Loop chorus depth
slider42:0<0,1,1{Off,On}>-Loop spring
slider43:0<0,1,1{Amp Head,Mali 120}>-Loop spring tank
slider44:3<0,10,0.1>-Loop spring level
slider45:5<0,10,0.1>-Loop spring dwell
slider46:0<0,1,1{Off,On}>-Loop tremolo
slider47:5<1,10,0.1>-Loop tremolo speed
slider48:5<1,10,0.1>-Loop tremolo intensity
slider49:0<0,1,1{Off,On}>-Loop tremolo stereo
slider50:prs_sel=0<0,13,1{No preset,Init,Fullerton Clean,Mali Chorus,Head Crunch,GR Doom,GR Lead,Black Panel Crunch,Chorus Stack,Fizz Wall,Surf Trem,Vibrato Drive,Small Box Lead,Ambient Clean}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-ramp";                                  // the ? pop-up links to this manual
ext_noinit = 1;

// ================================================================ shared
rp_dn = 0.000000000000000001;
function rp_alloc(n) local(p) ( p = rp_nm; rp_nm += n; memset(p, 0, n); p; );
function rp_p2(n) local(p) ( p = 1; while (p < n) ( p *= 2; ); p; );
function rp_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
// a first-order allpass coefficient for a low-frequency delay of d samples (the springs' chirp follows the rate)
function rp_apa(d) ( (d - 1) / (d + 1); );
// a spring tank (gfx-amp's am_spring) with its chirp coefficients as arguments, so it can run at any rate
function rp_spring_run(x, dwell, sa, se) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) local(y, s1, s2, fb) (
  y = hp.am_run(x);
  y = d6.am_ap1(d5.am_ap1(d4.am_ap1(d3.am_ap1(d2.am_ap1(d1.am_ap1(y, sa), sa), sa), sa), sa), sa);
  fb = 0.55 + 0.35 * dwell;
  s1 = b1[w1]; s2 = b2[w2];
  lp1 += (s1 - lp1) * lc; lp2 += (s2 - lp2) * lc;
  b1[w1] = y + e1.am_ap1(e2.am_ap1(lp2 * fb, se), se);
  b2[w2] = y + e3.am_ap1(e4.am_ap1(lp1 * fb, se), se);
  w1 += 1; w1 >= n1 ? w1 = 0; w2 += 1; w2 >= n2 ? w2 = 0;
  (s1 + s2) * 0.5;
);
function rp_spring_clr() instance(b1, b2, n1, n2, w1, w2, lp1, lp2, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) (
  memset(b1, 0, n1 + 8); memset(b2, 0, n2 + 8); w1 = w2 = 0; lp1 = lp2 = 0;
  d1.z = d2.z = d3.z = d4.z = d5.z = d6.z = e1.z = e2.z = e3.z = e4.z = 0;
  this.hp.rp_bqclr();
);

// ================================================================ AMP HEAD (the GUITAR model of gfx-amp-head)
// a valve stage, anti-aliased (am_tube's tanh with first-order ADAA on ln cosh); ah_tset(b) moves the bias smoothly
function ah_tset(b) instance(tb, tt, tn, u1, f1) local(a) (
  b !== tb ? (
    u1 += b - tb; tb = b; tt = am_tanh(b); tn = 1 / (1 - tt * tt);
    a = abs(u1); f1 = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  );
);
function ah_tube(x) instance(tb, tt, tn, u1, f1) local(u, a, f, d, y) (
  u = x + tb; a = abs(u);
  f = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : am_tanh(0.5 * (u + u1));
  u1 = u; f1 = f;
  (y - tt) * tn;
);
function ah_tzero() instance(tb, tt, tn, u1, f1) ( tb = tt = u1 = f1 = 0; tn = 1; );
// the level trims (dB at GAIN / MASTER 0, 1 .. 10): CLEAN, DRIVE, MASTER; and the line-out shelf / peak / trim rows
function ah_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = ah_trt + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function ah_trim(k, v) local(p, i, f, q) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i; q = ah_trt + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
function ah_lo(k, v) ( ah_trim(k + 3, v); );
function ah_loset(k, g) instance(s1, s2) (
  s1.am_bq(3, 0.25 * srate, 0.8, ah_lo(k, g), srate); s2.am_bq(2, 0.1666667 * srate, 0.7, ah_lo(k + 1, g), srate);
);
function ah_tables() (
  ah_trt = rp_alloc(15 * 11);
  ah_row(0, 0, 0, 0, 0, 0, 0, 0.05, 0.17, 0.34, 0.58, 0.82);
  ah_row(1, 0, 0, 0, 0, 0.02, 0.09, 0.17, 0.23, 0.29, 0.33, 0.36);
  ah_row(2, 0, 0, 0, 0, 0, 0, 0.05, 0.14, 0.24, 0.43, 0.65);
  ah_row(3, -2.66, -2.48, -1.93, -1.12, -0.05, 1.26, 2.74, 4.23, 5.45, 6.09, 6.06);
  ah_row(4, -0.73, -0.68, -0.62, -0.52, -0.38, -0.18, 0.09, 0.43, 0.84, 1.28, 1.70);
  ah_row(5, 0.12, 0.14, 0.16, 0.17, 0.16, 0.12, 0.08, 0.04, -0.04, -0.10, -0.18);
  ah_row(6, 6.97, 7.33, 6.92, 5.12, 1.67, -1.83, -3.85, -4.97, -5.64, -6.01, -6.23);
  ah_row(7, 0.58, 0.56, 0.66, 0.87, 1.06, 0.98, 0.75, 0.54, 0.45, 0.51, 0.70);
  ah_row(8, -0.02, -0.01, -0.02, -0.07, -0.13, -0.14, -0.10, -0.07, -0.02, 0.01, 0.01);
);
// the output transformer: the core saturates on flux
function ga_xf_run(ga_x, ga_k) instance(ga_ph, ga_sp) local(ga_s, ga_y) (
  ga_ph = ga_ph * ga_xf_lk + ga_x * ga_xf_c; ga_s = am_tanh(ga_ph * ga_k) / ga_k; ga_y = (ga_s - ga_sp * ga_xf_lk) / ga_xf_c; ga_sp = ga_s; ga_y;
);
// ---- AMP HEAD preamp (per side: ga_ghL / ga_ghR): x (after the pre-filter) -> ga_py, and the spring tank -> ga_ry
function ga_pre(ga_x) instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt, ga_rv, ga_py, ga_ry, ga_v1, ga_v2) local(ga_y) (
  ga_y = ga_ihp.am_run(ga_x);
  ga_y = ga_brt.am_run(ga_y);                                // bright cap
  ga_y = ga_v1.ah_tube(ga_y * ga_g1);                        // V1
  ga_y = ga_mil.am_run(ga_y);
  ga_s_drive ? (                                             // DRIVE: a second cascaded valve
    ga_y = ga_d2hp.am_run(ga_y); ga_y = ga_d2lp.am_run(ga_y);
    ga_y = ga_v2.ah_tube(ga_y * ga_g2) * ga_c2;
  ) : (
    ga_y *= ga_c1;
  );
  ga_y = ga_tb.am_run(ga_y); ga_y = ga_tm.am_run(ga_y); ga_y = ga_tt.am_run(ga_y);     // tone stack
  ga_py = ga_y; ga_ry = ga_rv.rp_spring_run(ga_y, 0.5, ah_sa, ah_se);
);
function ga_preset() instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt) (
  ga_ihp.am_bq(1, 70, 0.7, 0, rp_fs);
  ga_brt.am_bq(3, 2500, 0.6, ga_s_brt ? 9 * (1 - ga_gs / 13) : 0, rp_fs);
  ga_mil.am_bq(0, ga_s_drive ? 9000 : 12000, 0.7, 0, rp_fs);
  ga_d2hp.am_bq(1, 160, 0.7, 0, rp_fs);
  ga_d2lp.am_bq(0, 6500, 0.7, 0, rp_fs);
  ga_tb.am_bq(4, 110, 0.7, (RP_ST[21] - 5) * 2.4, rp_fs);
  ga_tm.am_bq(2, 700, 0.8, (RP_ST[22] - 5) * 2.4 - 2, rp_fs);
  ga_tt.am_bq(3, 3200, 0.7, (RP_ST[23] - 5) * 2.4, rp_fs);
);
function ga_gset() (
  ga_g1 = exp(0.1151292546 * (ga_gs * 3.4 - 4)); ga_c1 = 1 / sqrt(ga_g1);
  ga_g2 = exp(0.1151292546 * (ga_gs * 1.4 + 6)); ga_c2 = 0.32 * max(1, 2.2 - ga_gs * 0.3);
);
// ---- AMP HEAD power amp (per side: ga_pwL / ga_pwR); the supply (ga_sup) is shared by both sides
function ga_pow(ga_y) instance(ga_phc, ga_pres, ga_xfo, ga_pa, ga_vpi, ga_vpw) (
  ga_y = ga_vpi.ah_tube(ga_y * 0.9);                         // phase inverter
  ga_y = ga_phc.am_run(ga_y) * ga_pm;                        // MASTER
  ga_y = ga_sup * ga_vpw.ah_tube(ga_y / ga_sup);             // EL34-style push-pull with supply sag
  ga_pa = abs(ga_y);
  ga_y = ga_pres.am_run(ga_y);                               // presence
  ga_y = ga_xfo.ga_xf_run(ga_y + ga_pbias * ga_y * ga_y, 0.6);
  ga_y * ga_mk;
);
function ga_powset() instance(ga_phc, ga_pres) (
  ga_pres.am_bq(3, 4500, 0.7, RP_ST[25] * 1.1 - 3, rp_fs);
  ga_phc.am_bq(1, 40, 0.7, 0, rp_fs);
);
function ga_sag() local(ga_a) (
  ga_a = max(ga_pwL.ga_pa, ga_pwR.ga_pa);
  ga_sgenv += (ga_a - ga_sgenv) * (ga_a > ga_sgenv ? ga_sg_att : ga_sg_rel);
  ga_sup = 1 - 0.35 * min(ga_sgenv, 1);
);
// a side's spring tank (delay lengths scaled by k: the two sides differ a little)
function ga_tank(ga_mem, ga_k) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc) (
  b1 = ga_mem; n1 = floor(0.0371 * ga_k * rp_fs); b2 = ga_mem + n1 + 8; n2 = floor(0.0433 * ga_k * rp_fs);
  memset(ga_mem, 0, n1 + n2 + 16); w1 = 0; w2 = 0; lp1 = 0; lp2 = 0;
  hp.am_bq(1, 250, 0.7, 0, rp_fs); lc = 1 - exp(-2 * $pi * 3800 / rp_fs);
);
function ga_mem() ( ga_mL = rp_alloc(ceil(0.0836 * 1.05 * 4 * srate) + 64); ga_mR = rp_alloc(ceil(0.0836 * 1.05 * 4 * srate) + 64); );
// everything that depends on the amp's rate (and a clean state): the preamp side ...
function ga_prerate() (
  ah_sa = rp_apa(2.131360 * os_f); ah_se = rp_apa(1.5 * os_f);   // (0.3613 and 0.2 at 1x, as the original)
  ga_ghL.ga_v1.ah_tzero(); ga_ghL.ga_v2.ah_tzero(); ga_ghR.ga_v1.ah_tzero(); ga_ghR.ga_v2.ah_tzero();
  ga_ghL.ga_v1.ah_tset(ga_b1); ga_ghL.ga_v2.ah_tset(ga_b2); ga_ghR.ga_v1.ah_tset(ga_b1); ga_ghR.ga_v2.ah_tset(ga_b2);
  ga_ghL.ga_rv.ga_tank(ga_mL, 1.0); ga_ghR.ga_rv.ga_tank(ga_mR, 1.04);
  ga_ghL.ga_ihp.rp_bqclr(); ga_ghL.ga_brt.rp_bqclr(); ga_ghL.ga_mil.rp_bqclr(); ga_ghL.ga_d2hp.rp_bqclr(); ga_ghL.ga_d2lp.rp_bqclr();
  ga_ghL.ga_tb.rp_bqclr(); ga_ghL.ga_tm.rp_bqclr(); ga_ghL.ga_tt.rp_bqclr();
  ga_ghR.ga_ihp.rp_bqclr(); ga_ghR.ga_brt.rp_bqclr(); ga_ghR.ga_mil.rp_bqclr(); ga_ghR.ga_d2hp.rp_bqclr(); ga_ghR.ga_d2lp.rp_bqclr();
  ga_ghR.ga_tb.rp_bqclr(); ga_ghR.ga_tm.rp_bqclr(); ga_ghR.ga_tt.rp_bqclr();
  ga_ghL.ga_rv.d1.z = ga_ghL.ga_rv.d2.z = ga_ghL.ga_rv.d3.z = ga_ghL.ga_rv.d4.z = ga_ghL.ga_rv.d5.z = ga_ghL.ga_rv.d6.z = 0;
  ga_ghL.ga_rv.e1.z = ga_ghL.ga_rv.e2.z = ga_ghL.ga_rv.e3.z = ga_ghL.ga_rv.e4.z = 0; ga_ghL.ga_rv.hp.rp_bqclr();
  ga_ghR.ga_rv.d1.z = ga_ghR.ga_rv.d2.z = ga_ghR.ga_rv.d3.z = ga_ghR.ga_rv.d4.z = ga_ghR.ga_rv.d5.z = ga_ghR.ga_rv.d6.z = 0;
  ga_ghR.ga_rv.e1.z = ga_ghR.ga_rv.e2.z = ga_ghR.ga_rv.e3.z = ga_ghR.ga_rv.e4.z = 0; ga_ghR.ga_rv.hp.rp_bqclr();
  ga_ghL.ga_py = ga_ghL.ga_ry = ga_ghR.ga_py = ga_ghR.ga_ry = 0;
  ga_ghL.ga_preset(); ga_ghR.ga_preset();
  // the fixed post-shelf (host rate; 1x only - it makes up the host-rate ADAA's top-end droop)
  ga_k1L.am_bq(2, 0.28304 * srate, 1.05, 13.43, srate); ga_k1R.am_bq(2, 0.28304 * srate, 1.05, 13.43, srate);
  ga_k2L.am_bq(3, 0.19492 * srate, 0.44, 1.05, srate); ga_k2R.am_bq(3, 0.19492 * srate, 0.44, 1.05, srate);
  ga_k1L.rp_bqclr(); ga_k1R.rp_bqclr(); ga_k2L.rp_bqclr(); ga_k2R.rp_bqclr();
  ga_loL.s1.rp_bqclr(); ga_loL.s2.rp_bqclr(); ga_loR.s1.rp_bqclr(); ga_loR.s2.rp_bqclr(); ga_lgs = -1;
);
// ... and the power side
function ga_powrate() (
  ga_xf_c = 2 * $pi * 40 / rp_fs; ga_xf_lk = 1 - 2 * $pi * 5 / rp_fs;
  ga_sg_att = 1 - exp(-1 / (0.004 * rp_fs)); ga_sg_rel = 1 - exp(-1 / (0.09 * rp_fs));
  ga_sup = 1; ga_sgenv = 0;
  ga_pwL.ga_vpi.ah_tzero(); ga_pwL.ga_vpw.ah_tzero(); ga_pwR.ga_vpi.ah_tzero(); ga_pwR.ga_vpw.ah_tzero();
  ga_pwL.ga_vpi.ah_tset(-0.04); ga_pwL.ga_vpw.ah_tset(0.22); ga_pwR.ga_vpi.ah_tset(-0.04); ga_pwR.ga_vpw.ah_tset(0.22);
  ga_pwL.ga_phc.rp_bqclr(); ga_pwL.ga_pres.rp_bqclr(); ga_pwR.ga_phc.rp_bqclr(); ga_pwR.ga_pres.rp_bqclr();
  ga_pwL.ga_xfo.ga_ph = ga_pwL.ga_xfo.ga_sp = ga_pwR.ga_xfo.ga_ph = ga_pwR.ga_xfo.ga_sp = 0; ga_pwL.ga_pa = ga_pwR.ga_pa = 0;
  ga_pwL.ga_powset(); ga_pwR.ga_powset();
);
function ga_preupd() (
  ga_s_gain = RP_ST[18]; ga_s_brt = RP_ST[19] >= 0.5; ga_s_drive = RP_ST[20] >= 0.5;
  ga_rvw = (RP_ST[24] / 10) ^ 1.5 * 0.9;
  ga_ghL.ga_preset(); ga_ghR.ga_preset();
);
function ga_powupd() (
  ga_pm = 10 ^ ((RP_ST[26] * 3.2 - 14) / 20); ga_mk = 0.5 / (ga_pm ^ 0.55);    // -14 .. +18 dB into the power stage
  ga_pwL.ga_powset(); ga_pwR.ga_powset();
);
// DRIFT (the original's 25 % amount and 0.25 Hz speed, scaled by the DRIFT dial)
function ga_drift() (
  ga_dinc = 0.25 * dm_s * samplesblock / srate;
  ga_dv1 = ga_dB1.drift_tick(ga_dinc); ga_dv2 = ga_dB2.drift_tick(ga_dinc);
  ga_b1 = 0.15 + 0.06 * 0.25 * dm_a * ga_dv1;
  ga_b2 = 0.20 + 0.05 * 0.25 * dm_a * ga_dv2;
  ga_pbias = 0.02 * 0.25 * dm_a * ga_dv2;
);
function ga_glide() (
  ga_gs !== ga_s_gain ? ( ga_gs += (ga_s_gain - ga_gs) * rp_gk; abs(ga_gs - ga_s_gain) < 0.00001 ? ga_gs = ga_s_gain; ga_gset(); );
);

// ================================================================ FULLERTON 65 (gfx-fullerton-65)
function fl_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function fl_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function fl_tg(u) ( u >= 0 ? fl_th(u) : 1.8 * fl_th(u * 0.5555556) );
function fl_tgd(u) ( u >= 0 ? fl_thd(u) : fl_thd(u * 0.5555556) );
function fl_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function fl_tgF(u) ( u >= 0 ? fl_F(u) : 3.24 * fl_F(u * 0.5555556) );
function fl_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = fl_tgF(u1); b0 = b; g0 = fl_tg(b); n0 = 1 / max(fl_tgd(b), 0.05); );
function fl_strun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + fl_eb * (x - xp) + b0; xp = x; ga = fl_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : fl_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
function fl_strest() instance(b0, u1, ga1, xp) ( u1 = b0; ga1 = fl_tgF(b0); xp = 0; );
function fl_stzero() instance(b0, g0, n0, u1, ga1, xp) ( b0 = u1 = ga1 = xp = g0 = 0; n0 = 1; );
function fl_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = fl_F(u1); b0 = b; g0 = fl_th(b); n0 = 1 / max(fl_thd(b), 0.05); );
function fl_syrun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + fl_eb * (x - xp) + b0; xp = x; ga = fl_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : fl_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
function fl_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function fl_1clr() instance(x1, y1) ( x1 = y1 = 0; );
function fl_shset(fz, Fk, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * Fk;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function fl_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
function fl_lpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * min(f, 0.45 * fs);
  b0 = w / (c + w); b1 = b0; a1 = (w - c) / (c + w);
);
function fl_volset(p, bri, fs) instance(k, hb0, ha1, kb) local(fr, Ra, Rb, tp, c, w) (
  fr = p <= 0 ? 0 : (10 ^ (2 * p) - 1) / 99;
  Rb = fr * 1000000; Ra = (1 - fr) * 1000000;
  k = fr; kb = bri * (1 - fr);
  tp = max(Ra * Rb / (Ra + Rb + 1) * 0.00000000012, 0.0000000001);
  c = 2 * fs; w = 1 / tp;
  hb0 = c / (c + w); ha1 = (w - c) / (c + w);
);
function fl_volrun(x) instance(k, hb0, ha1, kb, x1, y1) local(h) (
  h = hb0 * (x - x1) - ha1 * y1; x1 = x; y1 = h;
  k * x + kb * h;
);
// the passive tone stack (third order, from the parts; Fullerton: 250 pF / 100 nF / 47 nF, 250 k, 250 k, 10 k, 100 k;
// GR-120: 470 pF / 22 nF / 22 nF, 220 k, 1 M, 25 k, 33 k)
function rp_tsset(t, m, l, fs, Ca, Cb, Cc, R1, R2, R3, R4) instance(b0, b1, b2, b3, a1, a2, a3)
  local(nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*Ca*R1 + m*Cc*R3 + l*(Ca*R2 + Cb*R2) + (Ca*R3 + Cb*R3);
  nb2 = t*(Ca*Cb*R1*R4 + Ca*Cc*R1*R4) - m*m*(Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + m*(Ca*Cc*R1*R3 + Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + l*(Ca*Cb*R1*R2 + Ca*Cb*R2*R4 + Ca*Cc*R2*R4)
     + l*m*(Ca*Cc*R2*R3 + Cb*Cc*R2*R3)
     + (Ca*Cb*R1*R3 + Ca*Cb*R3*R4 + Ca*Cc*R3*R4);
  nb3 = l*m*(Ca*Cb*Cc*R1*R2*R3 + Ca*Cb*Cc*R2*R3*R4)
     - m*m*(Ca*Cb*Cc*R1*R3*R3 + Ca*Cb*Cc*R3*R3*R4)
     + m*(Ca*Cb*Cc*R1*R3*R3 + Ca*Cb*Cc*R3*R3*R4)
     + t*Ca*Cb*Cc*R1*R3*R4 - t*m*Ca*Cb*Cc*R1*R3*R4
     + t*l*Ca*Cb*Cc*R1*R2*R4;
  da0 = 1;
  da1 = (Ca*R1 + Ca*R3 + Cb*R3 + Cb*R4 + Cc*R4) + m*Cc*R3 + l*(Ca*R2 + Cb*R2);
  da2 = m*(Ca*Cc*R1*R3 - Cb*Cc*R3*R4 + Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + l*m*(Ca*Cc*R2*R3 + Cb*Cc*R2*R3)
     - m*m*(Ca*Cc*R3*R3 + Cb*Cc*R3*R3)
     + l*(Ca*Cb*R2*R4 + Ca*Cb*R1*R2 + Ca*Cc*R2*R4 + Cb*Cc*R2*R4)
     + (Ca*Cb*R1*R4 + Ca*Cc*R1*R4 + Ca*Cb*R3*R4 + Ca*Cb*R1*R3 + Ca*Cc*R3*R4 + Cb*Cc*R3*R4);
  da3 = l*m*(Ca*Cb*Cc*R1*R2*R3 + Ca*Cb*Cc*R2*R3*R4)
     - m*m*(Ca*Cb*Cc*R1*R3*R3 + Ca*Cb*Cc*R3*R3*R4)
     + m*(Ca*Cb*Cc*R3*R3*R4 + Ca*Cb*Cc*R1*R3*R3 - Ca*Cb*Cc*R1*R3*R4)
     + l*Ca*Cb*Cc*R1*R2*R4
     + Ca*Cb*Cc*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  b0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  b1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  b2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  b3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  a1 = k1 * q; a2 = k2 * q; a3 = k3 * q;
);
function fl_tsset(t, m, l, fs) ( this.rp_tsset(t, m, l, fs, 0.00000000025, 0.0000001, 0.000000047, 250000, 250000, 10000, 100000); );
function rp_tsrun(x) instance(b0, b1, b2, b3, a1, a2, a3, x1, x2, x3, y1, y2, y3) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 + b3 * x3 - a1 * y1 - a2 * y2 - a3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);
function rp_tsclr() instance(x1, x2, x3, y1, y2, y3) ( x1 = x2 = x3 = y1 = y2 = y3 = 0; );
// the power stage's closed loop as a table (and its integral, for the anti-aliasing)
fl_paA = 8; fl_paB = 0.4; fl_qn = 4096; fl_qr = 4; fl_qs = (fl_qn - 1) / (2 * fl_qr);
function fl_qbuild() local(i, uu, lo, hi, m, h) (
  i = 0;
  loop(fl_qn,
    uu = -fl_qr + i / fl_qs; lo = -1; hi = 1;
    loop(44, m = 0.5 * (lo + hi); m - fl_th(fl_paA * (uu - fl_paB * m)) > 0 ? hi = m : lo = m; );
    fl_qt[i] = 0.5 * (lo + hi);
    i += 1;
  );
  h = 1 / fl_qs; fl_qc[0] = 0; i = 0;
  loop(fl_qn - 1, fl_qc[i + 1] = fl_qc[i] + h * 0.5 * (fl_qt[i] + fl_qt[i + 1]); i += 1; );
);
function fl_qF(p) local(i, f, q) (
  p <= 0 ? fl_qt[0] * p / fl_qs : p >= fl_qn - 1 ? fl_qc[fl_qn - 1] + fl_qt[fl_qn - 1] * (p - fl_qn + 1) / fl_qs : (
    i = floor(p); f = p - i; q = fl_qt + i;
    fl_qc[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / fl_qs;
  );
);
function fl_qQ(p) local(i, q) ( p = min(max(p, 0), fl_qn - 1.001); i = floor(p); p -= i; q = fl_qt + i; q[0] + (q[1] - q[0]) * p; );
function fl_paset(d) instance(pd, t0, ofs, p1, f1) local(o) (
  pd = d; t0 = fl_th(d); o = d / fl_paA + fl_paB * t0; p1 += (o - ofs) * fl_qs; f1 = fl_qF(p1); ofs = o;
);
function fl_pazero() instance(y, sup, sbase, env, pd, t0, ofs, p1, f1, xp) (
  y = env = pd = t0 = ofs = xp = 0; sup = sbase = 1; p1 = fl_qr * fl_qs; f1 = fl_qF(p1);
);
function fl_pa(u) instance(y, sup, sbase, env, t0, ofs, p1, f1, xp) local(p, a, f, d) (
  p = u + fl_eb * (u - xp); xp = u;
  p = (p / sup + ofs + fl_qr) * fl_qs; f = fl_qF(p); d = p - p1;
  y = sup * ((abs(d) > 0.00001 ? (f - f1) / d * fl_qs : fl_qQ(0.5 * (p + p1))) - t0);
  p1 = p; f1 = f;
  a = abs(y);
  env += (a - env) * (a > env ? fl_sga : fl_sgr);
  sup = sbase * (1 - 0.14 * min(max(env - 0.55, 0) * 2.2, 1));
  y;
);
function fl_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * fl_xlk + x * fl_xc; s = fl_th(ph * 0.55) / 0.55; y = (s - sp * fl_xlk) / fl_xc; sp = s; y;
);
// ---- FULLERTON preamp, one side (cL / cR): x -> the mixer's output into the phase inverter
function fl_pre(x, rv, tg) instance(v1a, cs1, ts1, vo1, v1b, hp1, v2a, cs3, ts2, vo2, v2b, hp2, v4b, hp3, sacc, nz, ne, non, von) local(n, v, u) (
  x += rp_dn;
  n = 0;
  fl_nrun ? (
    u = cs1.fl_1run(x * fl_kN);
    u = -70 * v1a.fl_strun(u);
    u = ts1.rp_tsrun(u);
    u = vo1.fl_volrun(u);
    n = -45 * v1b.fl_strun(u);
    n = hp1.fl_1run(n);
    u = 0.5 * (n + nz); nz = n; n = u + fl_eb * (u - ne); ne = u;
    non = 1;
  ) : non ? (
    v1a.fl_strest(); v1b.fl_strest(); non = 0;
  );
  v = 0;
  fl_vrun ? (
    u = cs3.fl_1run(x * fl_kV);
    u = -70 * v2a.fl_strun(u);
    u = ts2.rp_tsrun(u);
    u = vo2.fl_volrun(u);
    u = -45 * v2b.fl_strun(u);
    u = hp2.fl_1run(u);
    sacc += u * 0.5;
    v = -30 * v4b.fl_strun(u * 0.035 + rv * fl_rvg);
    v = hp3.fl_1run(v) * tg;
    v = -v;
    von = 1;
  ) : von ? (
    v2a.fl_strest(); v2b.fl_strest(); v4b.fl_strest(); von = 0;
  );
  (n + v) * 0.026;
);
function fl_send(x) instance(sh1, sl0, drv, sl1, sh2) (
  x = sl0.fl_1run(sh1.fl_1run(x * fl_ksend));
  sh2.am_run(sl1.am_run(drv.fl_strun(x)));
);
// ---- FULLERTON power amp, one side (fpL / fpR): the phase inverter, the 6L6s in their loop, the transformer
function fl_pow(m) instance(pin, pa, ot) (
  m = pin.fl_syrun(m * fl_pm);
  m = pa.fl_pa(m);
  ot.fl_ot(m) * fl_pmk;
);
// the reverb tanks (three springs each)
function fl_sread(i) local(b, s, st, v) (
  b = fl_tb[i]; s = b[(fl_tw - fl_tn[i]) & fl_tm];
  st = fl_tst + i; st[0] += (s - st[0]) * fl_tlc; s = st[0];
  b = fl_tab[i] + fl_tp;
  loop(6, st = b[0]; v = s - fl_ta * st; s = fl_ta * v + st; b[0] = v; b += fl_tK; );
  s;
);
function fl_swrite(i, v) local(b) ( b = fl_tb[i]; b[fl_tw] = min(max(v + rp_dn, -3), 3); );
function fl_tank(x, k) instance(lo, hi) local(s0, s1, s2, m, o) (
  s0 = fl_sread(k); s1 = fl_sread(k + 1); s2 = fl_sread(k + 2);
  o = s0 - s1 + 0.9 * s2;
  m = (s0 + s1 + s2) * 0.6666667;
  fl_swrite(k, x + fl_tgk[k] * (s0 - m)); fl_swrite(k + 1, x + fl_tgk[k + 1] * (s1 - m)); fl_swrite(k + 2, -x + fl_tgk[k + 2] * (s2 - m));
  lo += (o - lo) * fl_tol;
  hi += (lo - hi) * fl_toh;
  (lo - hi) * fl_trg;
);
function fl_trow(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = fl_trt + k; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function fl_trim(v, bri) local(i, f, a, b) (
  v = min(max(v, 0), 10); i = min(floor(v), 9); f = v - i;
  a = fl_trt[i] * (1 - f) + fl_trt[i + 1] * f; b = fl_trt[11 + i] * (1 - f) + fl_trt[12 + i] * f;
  a + (b - a) * bri;
);
function fl_tables() (
  fl_qt = rp_alloc(fl_qn + 1); fl_qc = rp_alloc(fl_qn + 1); fl_qbuild();
  fl_trt = rp_alloc(22);
  fl_trow(0, 0, 0, 0, 0, 0, 0, 0, 0.2, 0.33, 0.4, 0.46);
  fl_trow(11, 0, 0, 0.21, 0.48, 1.14, 1.5, 1.32, 1.03, 0.75, 0.6, 0.47);
  fl_tb = rp_alloc(6); fl_tn = rp_alloc(6); fl_tgk = rp_alloc(6); fl_tab = rp_alloc(6); fl_tst = rp_alloc(6);
);
// the tanks' memory, sized for 4x (allocated once per sample rate)
function fl_mem() local(i) (
  fl_tsz = rp_p2(0.08 * 0.5 * 4 * srate); fl_tm = fl_tsz - 1;
  i = 0; loop(6, fl_tb[i] = rp_alloc(fl_tsz); fl_tab[i] = rp_alloc(6 * 32); i += 1; );
);
function fl_fixpre(fs2, fsh) instance(cs1, hp1, cs3, hp2, sh1, sl0, sl1, sh2, hp3) (
  cs1.fl_shset(4.2, 1.9, fs2); hp1.fl_hpset(16, fs2);
  cs3.fl_shset(4.2, 1.9, fs2); hp2.fl_hpset(16, fs2);
  sh1.fl_hpset(260, fsh); sl0.fl_lpset(7000, fsh); sl1.am_bq(0, 4800, 0.7, 0, fsh); sh2.am_bq(1, 380, 0.7, 0, fsh);
  hp3.fl_hpset(14, fs2);
);
function fl_clrpre() instance(v1a, v1b, v2a, v2b, v4b, drv, cs1, hp1, cs3, hp2, sh1, sl0, sl1, sh2, hp3, vo1, vo2, ts1, ts2, sacc, nz, ne, non, von) (
  v1a.fl_stzero(); v1b.fl_stzero(); v2a.fl_stzero(); v2b.fl_stzero(); v4b.fl_stzero(); drv.fl_stzero();
  cs1.fl_1clr(); hp1.fl_1clr(); cs3.fl_1clr(); hp2.fl_1clr(); sh1.fl_1clr(); sl0.fl_1clr(); hp3.fl_1clr();
  sl1.rp_bqclr(); sh2.rp_bqclr(); vo1.x1 = vo1.y1 = vo2.x1 = vo2.y1 = 0; ts1.rp_tsclr(); ts2.rp_tsclr();
  sacc = nz = ne = non = von = 0;
);
fl_kin = 1 / 1.3; fl_eb = 0.25; fl_ksend = 0.05;
function fl_preupd() (
  fl_gNt = RP_ST[28] >= 0.5 || RP_ST[27] < 0.5 ? 1 : 0;
  fl_gVt = RP_ST[28] >= 0.5 || RP_ST[27] >= 0.5 ? 1 : 0;
  fl_stt = RP_ST[42] >= 0.5;
  fl_rate = 1.5 * 6 ^ ((RP_ST[40] - 1) / 9);
  fl_Dt = 10 * sqr((RP_ST[41] - 1) / 9);
  fl_rvt = 1.5 * ((RP_ST[39] - 1) / 9) ^ 1.6;
);
function fl_powupd() (
  fl_pm = 10 ^ ((RP_ST[43] - 5) * 3 / 20); fl_pmk = fl_pm ^ -0.55;      // MASTER (new): +/-15 dB, 5 = as the original
);
// the tone stacks, VOLUME and BRIGHT follow the knobs smoothly (per block)
function fl_tone(force) local(k, ch) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  fl_s3 += (RP_ST[29] - fl_s3) * k; fl_s4 += (RP_ST[30] - fl_s4) * k; fl_s5 += (RP_ST[31] - fl_s5) * k; fl_s6 += (RP_ST[32] - fl_s6) * k;
  fl_s7 += ((RP_ST[33] >= 0.5) - fl_s7) * k;
  fl_s8 += (RP_ST[34] - fl_s8) * k; fl_s9 += (RP_ST[35] - fl_s9) * k; fl_s10 += (RP_ST[36] - fl_s10) * k; fl_s11 += (RP_ST[37] - fl_s11) * k;
  fl_s12 += ((RP_ST[38] >= 0.5) - fl_s12) * k;
  fl_rvg += (fl_rvt - fl_rvg) * k;
  ch = fl_s3 + 2 * fl_s4 + 3 * fl_s5 + 5 * fl_s6 + 7 * fl_s7 + 11 * fl_s8 + 13 * fl_s9 + 17 * fl_s10 + 19 * fl_s11 + 23 * fl_s12;
  force || abs(ch - fl_lts) > 0.00001 ? (
    fl_lts = ch;
    cL.ts1.fl_tsset((fl_s4 - 1) / 9, (fl_s5 - 1) / 9, (fl_s6 - 1) / 9, rp_fs);
    cL.ts2.fl_tsset((fl_s9 - 1) / 9, (fl_s10 - 1) / 9, (fl_s11 - 1) / 9, rp_fs);
    cL.vo1.fl_volset((fl_s3 - 1) / 9, fl_s7, rp_fs);
    cL.vo2.fl_volset((fl_s8 - 1) / 9, fl_s12, rp_fs);
    cR.ts1.b0 = cL.ts1.b0; cR.ts1.b1 = cL.ts1.b1; cR.ts1.b2 = cL.ts1.b2; cR.ts1.b3 = cL.ts1.b3;
    cR.ts1.a1 = cL.ts1.a1; cR.ts1.a2 = cL.ts1.a2; cR.ts1.a3 = cL.ts1.a3;
    cR.ts2.b0 = cL.ts2.b0; cR.ts2.b1 = cL.ts2.b1; cR.ts2.b2 = cL.ts2.b2; cR.ts2.b3 = cL.ts2.b3;
    cR.ts2.a1 = cL.ts2.a1; cR.ts2.a2 = cL.ts2.a2; cR.ts2.a3 = cL.ts2.a3;
    cR.vo1.k = cL.vo1.k; cR.vo1.kb = cL.vo1.kb; cR.vo1.hb0 = cL.vo1.hb0; cR.vo1.ha1 = cL.vo1.ha1;
    cR.vo2.k = cL.vo2.k; cR.vo2.kb = cL.vo2.kb; cR.vo2.hb0 = cL.vo2.hb0; cR.vo2.ha1 = cL.vo2.ha1;
  );
);
// the valves' operating points (DRIFT): w = 1 the preamp's valves, 2 the power amp's (each side its own wander)
function fl_bias1(w1, w2, w3) instance(v1a, v1b, v2a, v2b, v4b, drv) local(a) (
  a = dm_a;
  v1a.fl_stset(-0.30 + 0.05 * a * w1); v1b.fl_stset(-0.25 + 0.05 * a * w2);
  v2a.fl_stset(-0.30 + 0.05 * a * w2); v2b.fl_stset(-0.25 + 0.05 * a * w1);
  v4b.fl_stset(-0.20 + 0.05 * a * w3); drv.fl_stset(-0.10 + 0.04 * a * w3);
);
function fl_bias2(w3, w4) instance(pin, pa) local(a) (
  a = dm_a;
  pin.fl_syset(0.04 + 0.03 * a * w4);
  pa.fl_paset(0.025 * a * w4);
  pa.sbase = 1 + 0.012 * a * w3;
);
function fl_bias(w) (
  w & 1 ? ( cL.fl_bias1(fl_w1, fl_w2, fl_w3); cR.fl_bias1(fl_w5, fl_w6, fl_w7); );
  w & 2 ? ( fpL.fl_bias2(fl_w3, fl_w4); fpR.fl_bias2(fl_w7, fl_w8); );
);
function fl_drift() local(di) (
  di = 0.2 * dm_s * samplesblock / srate;
  fl_w1 = dw1.drift_tick(di); fl_w2 = dw2.drift_tick(di); fl_w3 = dw3.drift_tick(di); fl_w4 = dw4.drift_tick(di);
  fl_w5 = dw5.drift_tick(di); fl_w6 = dw6.drift_tick(di); fl_w7 = dw7.drift_tick(di); fl_w8 = dw8.drift_tick(di);
  fl_rw = 1 + 0.025 * dm_a * dwr.drift_tick(di * 1.5);
);

function fl_prerate() local(i, ms, fsh) (
  fsh = 0.5 * rp_fs;
  fl_tK = max(1, floor(fsh / 8600 + 0.5));
  i = 0;
  loop(6,
    ms = i == 0 ? 33.1 : i == 1 ? 38.9 : i == 2 ? 45.7 : i == 3 ? 35.3 : i == 4 ? 41.3 : 47.9;
    fl_tn[i] = floor(ms * 0.001 * fsh);
    fl_tgk[i] = 10 ^ (-3 * (ms + 3) * 0.001 / 3.5);
    memset(fl_tb[i], 0, fl_tsz); memset(fl_tab[i], 0, 6 * 32);
    i += 1;
  );
  fl_ta = 0.75;
  fl_tlc = 1 - exp(-2 * $pi * 4200 / fsh);
  fl_tol = 1 - exp(-2 * $pi * 3000 / fsh); fl_toh = 1 - exp(-2 * $pi * 180 / fsh);
  fl_trg = 1.0;
  fl_tw = 0; fl_tp = 0; fl_tph = 0;
  memset(fl_tst, 0, 6);
  tkL.lo = tkL.hi = tkR.lo = tkR.hi = 0;
  cL.fl_clrpre(); cR.fl_clrpre();
  cL.fl_fixpre(rp_fs, fsh); cR.fl_fixpre(rp_fs, fsh);
  fl_rL = fl_rR = fl_rL1 = fl_rR1 = 0;
  // the fixed post-shelf (host rate, 1x only)
  fl_k1L.am_bq(2, 0.1875 * srate, 0.336, -0.436, srate); fl_k1R.am_bq(2, 0.1875 * srate, 0.336, -0.436, srate);
  fl_k2L.am_bq(2, 0.2674 * srate, 2.097, 3.834, srate); fl_k2R.am_bq(2, 0.2674 * srate, 2.097, 3.834, srate);
  fl_k3L.am_bq(3, 0.20319 * srate, 0.882, 2.015, srate); fl_k3R.am_bq(3, 0.20319 * srate, 0.882, 2.015, srate);
  fl_k1L.rp_bqclr(); fl_k1R.rp_bqclr(); fl_k2L.rp_bqclr(); fl_k2R.rp_bqclr(); fl_k3L.rp_bqclr(); fl_k3R.rp_bqclr();
  fl_lts = -1; fl_tone(1);
  fl_bias(1);
);
function fl_powrate() (
  fl_xc = 2 * $pi * 40 / rp_fs; fl_xlk = 1 - 2 * $pi * 5 / rp_fs;
  fl_sga = 1 - exp(-1 / (0.012 * rp_fs)); fl_sgr = 1 - exp(-1 / (0.16 * rp_fs));
  fpL.pin.fl_stzero(); fpR.pin.fl_stzero(); fpL.pa.fl_pazero(); fpR.pa.fl_pazero();
  fpL.ot.ph = fpL.ot.sp = fpR.ot.ph = fpR.ot.sp = 0;
  fl_bias(2);
);
// ================================================================ MALI 120 (gfx-mali-120, the 120 model)
ML_BB = 16384; ML_BM = ML_BB - 1;
// the clip: a cubic soft clip (JG, 27 Oct 2026: the original's hard clip was too harsh), with ADAA
function ml_hcF(u) ( abs(u) <= 1 ? 1.5 * (0.5 * u * u - u * u * u * u / 12) : abs(u) - 0.375; );
function ml_sc(u) ( u = min(max(u, -1), 1); 1.5 * (u - u * u * u / 3); );
function ml_clip(u) instance(x1, Fa, b1) local(Fv, y, d) (
  u += ml_bias; Fv = ml_hcF(u); d = u - x1;
  y = abs(d) > 0.00001 ? (Fv - Fa) / d : ml_sc(0.5 * (u + x1));
  y -= ml_sc(0.5 * (ml_bias + b1));
  x1 = u; Fa = Fv; b1 = ml_bias;
  y;
);
// the distortion's own 2x (8th-order Butterworth either side, at twice the amp's rate)
function ml_aa() instance(f1, f2, f3, f4) local(fc, fs2) (
  fs2 = 2 * rp_fs; fc = min(0.42 * rp_fs, 20000);
  f1.am_bq(0, fc, 0.5098, 0, fs2); f2.am_bq(0, fc, 0.6013, 0, fs2);
  f3.am_bq(0, fc, 0.9000, 0, fs2); f4.am_bq(0, fc, 2.5629, 0, fs2);
  f1.rp_bqclr(); f2.rp_bqclr(); f3.rp_bqclr(); f4.rp_bqclr();
);
function ml_pre_set() instance(nbr, nb, nm, nt, nv1, nv2, ebr, eb, em, et, ev1, ev2, ehp, dpe, dlp, dlp2, dhp) (
  this.nbr.am_bq(3, 2400, 0.6, ml_nbrd, rp_fs);
  this.nb.am_bq(4, 110, 0.7, ml_nbd, rp_fs); this.nm.am_bq(2, ml_mf, 0.75, ml_nmd, rp_fs); this.nt.am_bq(3, 3200, 0.7, ml_ntd, rp_fs);
  this.nv1.am_bq(2, 1300, 0.7, ml_vmid, rp_fs); this.nv2.am_bq(3, 6500, 0.7, ml_vglass, rp_fs);
  this.ebr.am_bq(3, 2400, 0.6, ml_ebrd, rp_fs);
  this.eb.am_bq(4, 110, 0.7, ml_ebd, rp_fs); this.em.am_bq(2, ml_mf, 0.75, ml_emd, rp_fs); this.et.am_bq(3, 3200, 0.7, ml_etd, rp_fs);
  this.ev1.am_bq(2, 1300, 0.7, ml_vmid, rp_fs); this.ev2.am_bq(3, 6500, 0.7, ml_vglass, rp_fs);
  this.ehp.am_bq(1, 110, 0.7, 0, rp_fs);
  this.dpe.am_bq(3, 1500, 0.7, 5, rp_fs);      // (the original: +9 dB; smoothed)
  this.dlp.am_bq(0, 4500, 0.8, 0, rp_fs);      // (6200 Hz, Q 1.05)
  this.dlp2.am_bq(0, 8000, 0.6, 0, rp_fs);     // (10500 Hz)
  this.dhp.am_bq(1, 30, 0.7, 0, rp_fs);
);
function ml_pre_clr() instance(nbr, nb, nm, nt, nv1, nv2, ebr, eb, em, et, ev1, ev2, ehp, dpe, dlp, dlp2, dhp, gn, ge, db, rw, on, oe) (
  nbr.rp_bqclr(); nb.rp_bqclr(); nm.rp_bqclr(); nt.rp_bqclr(); nv1.rp_bqclr(); nv2.rp_bqclr();
  ebr.rp_bqclr(); eb.rp_bqclr(); em.rp_bqclr(); et.rp_bqclr(); ev1.rp_bqclr(); ev2.rp_bqclr();
  ehp.rp_bqclr(); dpe.rp_bqclr(); dlp.rp_bqclr(); dlp2.rp_bqclr(); dhp.rp_bqclr();
  this.up.ml_aa(); this.dn.ml_aa(); this.ad.x1 = this.ad.Fa = this.ad.b1 = 0;
  gn = ge = db = rw = on = oe = 0;
);
function ml_pre(x) instance(on, oe, gn, ge, db, rw, nbr, nb, nm, nt, nv1, nv2, ebr, eb, em, et, ev1, ev2, ehp, dpe, dlp, dlp2, dhp, up, dn, ad, rv)
  local(y, z, c, d) (
  ml_nrm ? (
    y = this.nbr.am_run(x);
    y = this.nb.am_run(y); y = this.nm.am_run(y); y = this.nt.am_run(y);
    y = this.nv1.am_run(y); y = this.nv2.am_run(y);
    gn += (ml_gn - gn) * ml_sm; on = y * gn;
  ) : ( gn = 0; on = 0; );
  ml_eff ? (
    y = this.ebr.am_run(x);
    db += (ml_db - db) * ml_sm;
    db > 0.0005 ? (
      c = this.dpe.am_run(this.ehp.am_run(y)) * ml_gd;
      z = this.up.am_aa_run(c * 2); this.dn.am_aa_run(this.ad.ml_clip(z));
      z = this.up.am_aa_run(0);     d = this.dn.am_aa_run(this.ad.ml_clip(z));
      d = this.dhp.am_run(this.dlp2.am_run(this.dlp.am_run(d))) * ml_cd;
      y += (d - y) * db;
    );
    y = this.eb.am_run(y); y = this.em.am_run(y); y = this.et.am_run(y);
    y = this.ev1.am_run(y); y = this.ev2.am_run(y);
    ge += (ml_ge - ge) * ml_sm; y *= ge;
    rw += (ml_rw - rw) * ml_sm;
    oe = y + this.rv.rp_spring_run(y, 0.7, ml_sa, ml_se) * rw;
  ) : ( ge = 0; oe = 0; );
);
// ---- MALI preamp, both sides: (xl, xr) -> ml_sL / ml_sR (the two speakers' feeds; its chorus / vibrato moved to the FX LOOP)
function ml_prerun(xl, xr) (
  rp_mono ? (
    PL.ml_pre(xl);
    ml_nL = ml_nR = PL.on; ml_eL = ml_eR = PL.oe;
  ) : (
    PL.ml_pre(xl); PR.ml_pre(xr);
    ml_nL = PL.on; ml_nR = PR.on; ml_eL = PL.oe; ml_eR = PR.oe;
  );
  ml_sL = ml_nL + ml_eL; ml_sR = ml_nR + ml_eR;
);
// ---- MALI power amp, one side (OL / OR): the clean solid-state stage, the rails clip hard, a touch of sag
function ml_pow(x) instance(env) local(a, r, k, y) (
  x *= ml_pm;
  a = abs(x);
  env += (a - env) * (a > env ? ml_satt : ml_srel);
  r = ml_rail * (1 - ml_sag * min(env / ml_rail, 1));
  k = 0.9 * r;
  y = a < k ? x : sign(x) * (k + (r - k) * am_tanh((a - k) / (r - k)));
  y * ml_mk * ml_pmk;
);
// ---- the MALI speakers (cabinet: 120 = two 12", 55 = two 8")
function ml_spk_set(m) instance(s1, s2, s3, s4, s5, s6, s7) (
  m ? (
    this.s1.am_bq(1, 105, 0.8, 0, srate); this.s2.am_bq(2, 175, 1.2, 2, srate); this.s3.am_bq(2, 950, 1.0, 2.5, srate);
    this.s4.am_bq(2, 2800, 1.0, 2, srate); this.s5.am_bq(2, 420, 1.4, 0, srate);
    this.s6.am_bq(0, 6000, 0.8, 0, srate); this.s7.am_bq(0, 9000, 0.6, 0, srate);
  ) : (
    this.s1.am_bq(1, 72, 0.85, 0, srate); this.s2.am_bq(2, 120, 1.1, 2.5, srate); this.s3.am_bq(2, 460, 1.4, 1.8, srate);
    this.s4.am_bq(2, 2600, 0.9, 3, srate); this.s5.am_bq(2, 1500, 1.2, -1.5, srate);
    this.s6.am_bq(0, 6800, 0.8, 0, srate); this.s7.am_bq(0, 10000, 0.6, 0, srate);
  );
);
function ml_spk(y) instance(s1, s2, s3, s4, s5, s6, s7) (
  y = this.s1.am_run(y); y = this.s2.am_run(y); y = this.s3.am_run(y); y = this.s4.am_run(y);
  y = this.s5.am_run(y); y = this.s6.am_run(y); this.s7.am_run(y);
);
function ml_mem() (
  ml_rvn = floor(0.09 * 4 * srate) + 64;
  ml_rvL = rp_alloc(ml_rvn); ml_rvR = rp_alloc(ml_rvn);
);
function ml_preupd() local(v) (
  ml_nrm = RP_ST[44] != 1;
  ml_eff = RP_ST[44] != 0;
  ml_gn = sqr(RP_ST[45] / 10) * 4; ml_ge = sqr(RP_ST[50] / 10) * 4;
  ml_ntd = (RP_ST[46] - 5) * 2.6; ml_nmd = (RP_ST[47] - 5) * 2.0; ml_nbd = (RP_ST[48] - 5) * 2.6;
  ml_etd = (RP_ST[51] - 5) * 2.6; ml_emd = (RP_ST[52] - 5) * 2.0; ml_ebd = (RP_ST[53] - 5) * 2.6;
  ml_nbrd = RP_ST[49] ? 7 - 3 * RP_ST[45] / 10 : 0;
  ml_ebrd = RP_ST[54] ? 7 - 3 * RP_ST[50] / 10 : 0;
  ml_mf = 750; ml_vmid = 1.5; ml_vglass = 2.5;
  v = RP_ST[55];
  ml_gd = 10 ^ ((6 + 4.4 * v) / 20); ml_cd = max(1 / ml_gd, 0.13);
  ml_db = min(v * 2, 1);
  ml_rw = (RP_ST[56] / 10) ^ 1.5 * 1.5;
  PL.ml_pre_set(); PR.ml_pre_set();
);
function ml_powupd() (
  ml_rail0 = 1; ml_mk = 0.8;
  ml_pm = 10 ^ ((RP_ST[60] - 5) * 3 / 20); ml_pmk = ml_pm ^ -0.55;      // MASTER (new): +/-15 dB, 5 = as the original
);
// DRIFT: the distortion's bias (the preamp), the rails and their sag (the power amp)
function ml_drift() local(di) (
  di = 0.25 * dm_s * samplesblock / srate;
  ml_rail = ml_rail0 * (1 + 0.015 * dm_a * drS.drift_tick(di));
  ml_sag = 0.035 * dm_a;
  ml_bias = 0.1 + 0.03 * dm_a * drB.drift_tick(di);
);

function ml_prerate() (
  PL.rv.am_spring_init(ml_rvL, rp_fs); PR.rv.am_spring_init(ml_rvR, rp_fs);
  PL.rv.n1 = floor(0.0291 * rp_fs); PL.rv.n2 = floor(0.0337 * rp_fs);
  PR.rv.n1 = floor(0.0306 * rp_fs); PR.rv.n2 = floor(0.0352 * rp_fs);
  PL.rv.lc = PR.rv.lc = 1 - exp(-2 * $pi * 6200 / rp_fs);
  PL.rv.hp.am_bq(1, 300, 0.7, 0, rp_fs); PR.rv.hp.am_bq(1, 300, 0.7, 0, rp_fs);
  PL.rv.rp_spring_clr(); PR.rv.rp_spring_clr();
  ml_sa = rp_apa(4.263158 * os_f / 1); ml_se = rp_apa(3 * os_f);   // (0.62 and 0.5 at 1x, as the original)
  PL.ml_pre_clr(); PR.ml_pre_clr();
  ml_sm = 1 - exp(-1 / (0.02 * rp_fs));
  ml_preupd();
);
function ml_powrate() (
  ml_satt = 1 - exp(-1 / (0.005 * rp_fs)); ml_srel = 1 - exp(-1 / (0.15 * rp_fs));
  OL.env = OR.env = 0;
);
// ================================================================ GR-120 (gfx-gr-120)
function g1_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function g1_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function g1_tg(u) ( u >= 0 ? g1_th(u) : 1.8 * g1_th(u * 0.5555556) );
function g1_tgd(u) ( u >= 0 ? g1_thd(u) : g1_thd(u * 0.5555556) );
function g1_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function g1_tgF(u) ( u >= 0 ? g1_F(u) : 3.24 * g1_F(u * 0.5555556) );
function g1_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = g1_tgF(u1); b0 = b; g0 = g1_tg(b); n0 = 1 / max(g1_tgd(b), 0.05); );
function g1_strun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + g1_eb * (x - xp) + b0; xp = x; ga = g1_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : g1_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
// V1a and the cathode follower: plain at 2x and 4x (as the original at 2x), anti-aliased at 1x
function g1_strp(x) instance(b0, g0, n0) ( os_f > 1 ? (g1_tg(x + b0) - g0) * n0 + rp_dn : this.g1_strun(x); );
function g1_stzero() instance(b0, g0, n0, u1, ga1, xp) ( b0 = u1 = ga1 = xp = g0 = 0; n0 = 1; );
function g1_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = g1_F(u1); b0 = b; g0 = g1_th(b); n0 = 1 / max(g1_thd(b), 0.05); );
function g1_syrun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + g1_eb * (x - xp) + b0; xp = x; ga = g1_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : g1_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
g1_eb = 0.25;
function g1_lcset(f, a, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = (c + w * a) / (c + w); b1 = (w * a - c) / (c + w); a1 = (w - c) / (c + w);
);
function g1_tsset(t, m, l, fs) ( this.rp_tsset(t, m, l, fs, 0.00000000047, 0.000000022, 0.000000022, 220000, 1000000, 25000, 33000); );
G1_QN = 4096; G1_QR = 4; G1_QS = (G1_QN - 1) / (2 * G1_QR);
function g1_ppc(v, b) local(p, n) (
  p = b + v; n = b - v;
  g1_th(((p > 0 ? p * sqrt(p) : 0) - (n > 0 ? n * sqrt(n) : 0)) / (3 * sqrt(b)));
);
function g1_qbuild(tab, ga, fb, bi) local(i, uu, lo, hi, m) (
  i = 0;
  loop(G1_QN,
    uu = -G1_QR + i / G1_QS; lo = -1; hi = 1;
    loop(40, m = 0.5 * (lo + hi); m - g1_ppc(ga * (uu - fb * m), bi) > 0 ? hi = m : lo = m; );
    tab[i] = 0.5 * (lo + hi);
    i += 1;
  );
  tab[G1_QN] = tab[G1_QN - 1];
);
function g1_qint(tab, c) local(i, h) (
  h = 1 / G1_QS; c[0] = 0; i = 0;
  loop(G1_QN - 1, c[i + 1] = c[i] + h * 0.5 * (tab[i] + tab[i + 1]); i += 1; );
);
function g1_qF(p) local(i, f, q) (
  p <= 0 ? g1_qt[0] * p / G1_QS : p >= G1_QN - 1 ? g1_qc[G1_QN - 1] + g1_qt[G1_QN - 1] * (p - G1_QN + 1) / G1_QS : (
    i = floor(p); f = p - i; q = g1_qt + i;
    g1_qc[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / G1_QS;
  );
);
function g1_q(u) local(p, i) (
  p = min(max((u + G1_QR) * G1_QS, 0), G1_QN - 1.001);
  i = floor(p); p -= i;
  g1_qt[i] + (g1_qt[i + 1] - g1_qt[i]) * p;
);
function g1_paset(d) instance(ofs, t0, p1, f1) local(o) ( o = d / g1_pgA; p1 += (o - ofs) * G1_QS; f1 = g1_qF(p1); ofs = o; t0 = g1_q(ofs); );
function g1_pare() instance(p1, f1) ( f1 = g1_qF(p1); );
function g1_pazero() instance(y, sup, sbase, env, genv, ofs, t0, p1, f1, xp) (
  y = env = genv = ofs = xp = 0; sup = sbase = 1; p1 = G1_QR * G1_QS; f1 = g1_qF(p1); t0 = g1_q(0);
);
function g1_pa(u) instance(y, sup, sbase, env, genv, ofs, t0, p1, f1, xp) local(a, d, p, f) (
  a = abs(u);
  genv += (a - genv) * (a > genv ? g1_gba : g1_gbr);
  d = g1_blk * max(genv - 0.5, 0);
  d > 0.00001 ? u -= d * g1_th(u / d);
  p = u + g1_eb * (u - xp); xp = u;
  p = (p * g1_pn / sup + ofs + G1_QR) * G1_QS; f = g1_qF(p); d = p - p1;
  y = sup * ((abs(d) > 0.00001 ? (f - f1) / d * G1_QS : g1_q((0.5 * (p + p1)) / G1_QS - G1_QR)) - t0);
  p1 = p; f1 = f;
  a = abs(y);
  env += (a - env) * (a > env ? g1_sga : g1_sgr);
  sup = sbase * (1 - g1_sgd * min(max(env - g1_sgk, 0) * 1.8, 1));
  y;
);
function g1_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * g1_xlk + x * g1_xc; s = g1_th(ph * g1_otk) / g1_otk; y = (s - sp * g1_xlk) / g1_xc; sp = s; y;
);
function g1_otre() instance(ph, sp) ( sp = g1_th(ph * g1_otk) / g1_otk; );
// ---- GR-120 preamp, one side (g1L / g1R): x (after the pre-filter) -> the graphic's output
function g1_pre(x) instance(cs1, v1a, cp1, cn, cs2, v1b, cp2, v2a, cf, ts, e1, e2, e3, e4, e5, e6) local(u) (
  u = cs1.fl_1run(x * g1_kin + rp_dn);
  u = -60 * v1a.g1_strp(u);
  u = cp1.fl_1run(u * g1_gk);
  u = cn.fl_1run(u);
  u = cs2.fl_1run(u);
  u = -45 * v1b.g1_strun(u);
  u = cp2.fl_1run(u) * g1_k3;
  u = -35 * v2a.g1_strun(u);
  u = cf.g1_strp(u * 0.022);
  u = ts.rp_tsrun(u);
  g1_geq ? (
    u = e1.am_run(u); u = e2.am_run(u); u = e3.am_run(u); u = e4.am_run(u); u = e5.am_run(u); u = e6.am_run(u);
  );
  u;
);
// ---- GR-120 power amp, one side (g1wL / g1wR): MASTER, the phase inverter, the EL34s, the transformer
function g1_pow(u) instance(pin, pa, ot) (
  u = pin.g1_syrun(u * g1_mv);
  u = pa.g1_pa(u * g1_kpa);
  ot.g1_ot(u);
);
// ... and its host-rate side: PRESENCE and the speaker's back-EMF (no feedback)
function g1_tailset() instance(p1, p2, p3) (
  p1.am_bq(3, 3400, 0.7, (g1_pres - 5) * 1.3, srate);
  p2.am_bq(2, 105, 1.1, g1_e1, srate);
  p3.am_bq(3, 2600, 0.6, g1_e2, srate);
);
function g1_tail(x) instance(p1, p2, p3) ( p3.am_run(p2.am_run(p1.am_run(x))); );
// ---- the GR-120 4x12 (cabinet), with MIC
function g1_cabset(m) instance(c1, c2, c3, c4, c5, c6, c7, c8) local(lp) (
  m = min(max(m, 0), 10) / 10;
  c1.am_bq(1, 72, 1.15, 0, srate);
  c2.am_bq(2, 108, 1.4, 3.5, srate);
  c3.am_bq(2, 420, 1.0, -3, srate);
  c4.am_bq(2, 1750, 1.2, 2, srate);
  c5.am_bq(2, 3100 - 500 * m, 1.7, 5.5 * (1 - 0.75 * m), srate);
  lp = 5900 - 2300 * m;
  c6.am_bq(0, lp, 0.5412, 0, srate); c7.am_bq(0, lp, 1.3066, 0, srate);
  c8.am_bq(2, 7400, 3, -10 * m, srate);
);
function g1_cab(x) instance(c1, c2, c3, c4, c5, c6, c7, c8) (
  c8.am_run(c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c2.am_run(c1.am_run(x))))))));
);
function g1_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = g1_mkt + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function g1_mkup(m, g) local(p, i, f, q) (
  p = min(max(g, 0), 10); i = min(floor(p), 9); f = p - i; q = g1_mkt + m * 11;
  10 ^ ((q[i] * (1 - f) + q[i + 1] * f) / 20);
);
function g1_mtrim(v, g) local(t) (
  t = min(max(v - 5, 0), 5);
  t = t < 1 ? 0.07 * t : t < 2 ? 0.07 + 0.08 * (t - 1) : t < 3 ? 0.15 + 0.1 * (t - 2) : t < 4 ? 0.25 + 0.15 * (t - 3) : 0.4 + 0.13 * (t - 4);
  t * (g < 5 ? 0.1 + 0.18 * g : 1 - 0.14 * (g - 5));
);
function g1_tables() (
  g1_qd = rp_alloc(G1_QN + 1); g1_ql = rp_alloc(G1_QN + 1); g1_qdc = rp_alloc(G1_QN + 1); g1_qlc = rp_alloc(G1_QN + 1);
  g1_qbuild(g1_qd, 4.5, 0.03, 0.10); g1_qbuild(g1_ql, 9, 0.30, 0.28);
  g1_qint(g1_qd, g1_qdc); g1_qint(g1_ql, g1_qlc);
  g1_qt = g1_qd; g1_qc = g1_qdc;
  g1_mkt = rp_alloc(32);
  g1_row(0, -2.60, -5.05, -7.37, -9.78, -11.49, -12.41, -13.53, -13.83, -14.16, -14.29, -14.24);
  g1_row(1, 2.66, -0.29, -2.97, -5.70, -7.82, -9.51, -10.80, -11.75, -12.25, -13.14, -13.04);
  g1_gb = rp_alloc(8);
);
// the voicings: the preamp's (coupling caps, cathode bypass, the stack's middle, the valves' bias) ...
function g1_pvset(m) (
  g1_pmod = m;
  m ? (
    g1_c1f = 70; g1_c2f = 90; g1_k2z = 150; g1_k2F = 2.6; g1_k3 = 0.05; g1_mid = 0.78;
    g1_vb1 = -0.30; g1_vb2 = -0.22; g1_vb3 = -0.20; g1_vb4 = -0.10;
  ) : (
    g1_c1f = 22; g1_c2f = 30; g1_k2z = 30; g1_k2F = 1.6; g1_k3 = 0.07; g1_mid = 0.52;
    g1_vb1 = -0.30; g1_vb2 = -0.18; g1_vb3 = -0.48; g1_vb4 = -0.06;
  );
  g1L.cp1.fl_hpset(g1_c1f, rp_fs); g1R.cp1.fl_hpset(g1_c1f, rp_fs);
  g1L.cp2.fl_hpset(g1_c2f, rp_fs); g1R.cp2.fl_hpset(g1_c2f, rp_fs);
  g1L.cs2.fl_shset(g1_k2z, g1_k2F, rp_fs); g1R.cs2.fl_shset(g1_k2z, g1_k2F, rp_fs);
  g1_sm = g1_mid; g1_lts = -1;
);
// ... and the power amp's (the loop, bias, blocking, sag, the transformer, the back-EMF)
function g1_wvset(m) (
  g1_wmod = m;
  m ? (
    g1_qt = g1_ql; g1_qc = g1_qlc; g1_pgA = 9; g1_pn = (1 + 9 * 0.30) / 9;
    g1_blk = 0.06; g1_sgd = 0.10; g1_sgk = 0.45;
    g1_sga = 1 - exp(-1 / (0.008 * rp_fs)); g1_sgr = 1 - exp(-1 / (0.12 * rp_fs));
    g1_otk = 0.45; g1_emfl = 1; g1_emfh = 1;
  ) : (
    g1_qt = g1_qd; g1_qc = g1_qdc; g1_pgA = 4.5; g1_pn = (1 + 4.5 * 0.03) / 4.5;
    g1_blk = 0.20; g1_sgd = 0.30; g1_sgk = 0.22;
    g1_sga = 1 - exp(-1 / (0.025 * rp_fs)); g1_sgr = 1 - exp(-1 / (0.38 * rp_fs));
    g1_otk = 1.05; g1_emfl = 3.5; g1_emfh = 2.5;
  );
  g1wL.ot.g1_otre(); g1wR.ot.g1_otre(); g1wL.pa.g1_pare(); g1wR.pa.g1_pare();
  g1_e1 = g1_emfl; g1_e2 = g1_emfh; g1_lsp = -1;
);
g1_kin = 1 / 1.3; G1_PF1 = 14000; G1_LODOOM = 2; G1_LOLEAD = 3;
G1_KF = 0.2586; G1_KQ = 0.797; G1_KG = 1.475;
g1_kpa = 1.0;
function g1_cnf(p) ( p < 1 ? 18 + 22 * p : p < 2 ? 40 + 40 * (p - 1) : p < 3 ? 80 + 70 * (p - 2) : p < 4 ? 150 + 110 * (p - 3) : 260 + 190 * (p - 4); );
function g1_cna(p) ( p < 1 ? 1 - 0.4 * p : p < 2 ? 0.6 - 0.15 * (p - 1) : p < 3 ? 0.45 - 0.13 * (p - 2) : p < 4 ? 0.32 - 0.1 * (p - 3) : 0.22 - 0.07 * (p - 4); );
// the preamp's stack, contour and graphic follow the controls smoothly (per block)
function g1_pretone(force) local(k, ch, i, f, gd) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  g1_s3 += (RP_ST[63] - g1_s3) * k; g1_s4 += (RP_ST[64] - g1_s4) * k; g1_s5 += (RP_ST[65] - g1_s5) * k;
  g1_sm += (g1_mid - g1_sm) * k;
  ch = g1_s3 + 3 * g1_s4 + 7 * g1_s5 + 11 * g1_sm;
  force || abs(ch - g1_lts) > 0.00001 ? (
    g1_lts = ch;
    g1L.ts.g1_tsset(g1_s4 / 10, g1_sm, g1_s3 / 10, rp_fs); g1R.ts.g1_tsset(g1_s4 / 10, g1_sm, g1_s3 / 10, rp_fs);
    f = g1_cnf(g1_s5); gd = g1_cna(g1_s5);
    g1L.cn.g1_lcset(f, gd, rp_fs); g1R.cn.g1_lcset(f, gd, rp_fs);
  );
  ch = 0; i = 0;
  loop(6,
    f = RP_ST[66] >= 0.5 ? RP_ST[67 + i] : 0;
    g1_gb[i] += (f - g1_gb[i]) * k;
    abs(g1_gb[i] - f) < 0.005 ? g1_gb[i] = f;
    ch += abs(g1_gb[i]) * (i + 1) + g1_gb[i] * 0.37;
    i += 1;
  );
  force || abs(ch - g1_lgs) > 0.00001 ? (
    g1_lgs = ch;
    gd = abs(g1_gb[0]) + abs(g1_gb[1]) + abs(g1_gb[2]) + abs(g1_gb[3]) + abs(g1_gb[4]) + abs(g1_gb[5]);
    gd > 0 && !g1_geq ? (
      g1L.e1.rp_bqclr(); g1L.e2.rp_bqclr(); g1L.e3.rp_bqclr(); g1L.e4.rp_bqclr(); g1L.e5.rp_bqclr(); g1L.e6.rp_bqclr();
      g1R.e1.rp_bqclr(); g1R.e2.rp_bqclr(); g1R.e3.rp_bqclr(); g1R.e4.rp_bqclr(); g1R.e5.rp_bqclr(); g1R.e6.rp_bqclr();
    );
    g1_geq = gd > 0;
    g1L.e1.am_bq(2, 100, 1.1, g1_gb[0], rp_fs); g1R.e1.am_bq(2, 100, 1.1, g1_gb[0], rp_fs);
    g1L.e2.am_bq(2, 200, 1.1, g1_gb[1], rp_fs); g1R.e2.am_bq(2, 200, 1.1, g1_gb[1], rp_fs);
    g1L.e3.am_bq(2, 400, 1.1, g1_gb[2], rp_fs); g1R.e3.am_bq(2, 400, 1.1, g1_gb[2], rp_fs);
    g1L.e4.am_bq(2, 800, 1.1, g1_gb[3], rp_fs); g1R.e4.am_bq(2, 800, 1.1, g1_gb[3], rp_fs);
    g1L.e5.am_bq(2, 1600, 1.1, g1_gb[4], rp_fs); g1R.e5.am_bq(2, 1600, 1.1, g1_gb[4], rp_fs);
    g1L.e6.am_bq(2, 3200, 1.1, g1_gb[5], rp_fs); g1R.e6.am_bq(2, 3200, 1.1, g1_gb[5], rp_fs);
  );
);
// the power amp's PRESENCE and back-EMF (per block)
function g1_powtone(force) local(k, ch) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  g1_pres += (RP_ST[74] - g1_pres) * k;
  g1_e1 += (g1_emfl - g1_e1) * k; g1_e2 += (g1_emfh - g1_e2) * k;
  ch = g1_pres + 7 * g1_e1 + 11 * g1_e2;
  force || abs(ch - g1_lsp) > 0.00001 ? ( g1_lsp = ch; g1wL.g1_tailset(); g1wR.g1_tailset(); );
);
function g1_bias1(w1, w2, w3) instance(v1a, v1b, v2a, cf) local(a) (
  a = dm_a;
  v1a.g1_stset(g1_vb1 + 0.05 * a * w1); v1b.g1_stset(g1_vb2 + 0.05 * a * w2);
  v2a.g1_stset(g1_vb3 + 0.06 * a * w3); cf.g1_stset(g1_vb4 + 0.03 * a * w1);
);
function g1_bias2(w3, w4) instance(pin, pa) local(a) (
  a = dm_a;
  pin.g1_syset(0.04 + 0.03 * a * w4);
  pa.g1_paset(0.03 * a * w4);
  pa.sbase = 1 + 0.015 * a * w3;
);
function g1_bias(w) (
  w & 1 ? ( g1L.g1_bias1(g1_w1, g1_w2, g1_w3); g1R.g1_bias1(g1_w5, g1_w6, g1_w7); );
  w & 2 ? ( g1wL.g1_bias2(g1_w3, g1_w4); g1wR.g1_bias2(g1_w7, g1_w8); );
);
function g1_drift() local(di) (
  di = 0.2 * dm_s * samplesblock / srate;
  g1_w1 = g1dw1.drift_tick(di); g1_w2 = g1dw2.drift_tick(di); g1_w3 = g1dw3.drift_tick(di); g1_w4 = g1dw4.drift_tick(di);
  g1_w5 = g1dw5.drift_tick(di); g1_w6 = g1dw6.drift_tick(di); g1_w7 = g1dw7.drift_tick(di); g1_w8 = g1dw8.drift_tick(di);
);
function g1_clrpre() instance(cs1, v1a, cp1, cn, cs2, v1b, cp2, v2a, cf, ts, e1, e2, e3, e4, e5, e6) (
  cs1.fl_1clr(); cp1.fl_1clr(); cn.fl_1clr(); cs2.fl_1clr(); cp2.fl_1clr();
  v1a.g1_stzero(); v1b.g1_stzero(); v2a.g1_stzero(); cf.g1_stzero(); ts.rp_tsclr();
  e1.rp_bqclr(); e2.rp_bqclr(); e3.rp_bqclr(); e4.rp_bqclr(); e5.rp_bqclr(); e6.rp_bqclr();
);
function g1_prerate() (
  g1L.g1_clrpre(); g1R.g1_clrpre();
  g1L.cs1.fl_shset(4.2, 1.9, rp_fs); g1R.cs1.fl_shset(4.2, 1.9, rp_fs);
  g1_pvset(RP_ST[61] >= 0.5);
  g1_lgs = -1; g1_geq = 0; g1_pretone(1);
  g1_bias(1);
  g1_k1L.am_bq(3, G1_KF * srate, G1_KQ, G1_KG, srate); g1_k1R.am_bq(3, G1_KF * srate, G1_KQ, G1_KG, srate);
  g1_k1L.rp_bqclr(); g1_k1R.rp_bqclr(); g1_loL.rp_bqclr(); g1_loR.rp_bqclr(); g1_lsg = -1;
);
function g1_powrate() (
  g1wL.pin.g1_stzero(); g1wR.pin.g1_stzero(); g1wL.pa.g1_pazero(); g1wR.pa.g1_pazero();
  g1wL.ot.ph = g1wL.ot.sp = g1wR.ot.ph = g1wR.ot.sp = 0;
  g1_xc = 2 * $pi * 40 / rp_fs; g1_xlk = 1 - 2 * $pi * 4 / rp_fs;
  g1_gba = 1 - exp(-1 / (0.003 * rp_fs)); g1_gbr = 1 - exp(-1 / (0.15 * rp_fs));
  g1_wvset(RP_ST[73] >= 0.5);
  g1wL.p1.rp_bqclr(); g1wL.p2.rp_bqclr(); g1wL.p3.rp_bqclr(); g1wR.p1.rp_bqclr(); g1wR.p2.rp_bqclr(); g1wR.p3.rp_bqclr();
  g1_powtone(1);
  g1_bias(2);
);
function g1_powupd() (
  g1_tmv = 6 * 10 ^ (1.6 * (RP_ST[75] / 10 - 1));
  RP_ST[75] < 0.05 ? g1_tmv *= RP_ST[75] / 0.05;
);
// the line out (CAB off): a high shelf rising with GAIN gives back the top the anti-aliasing kept out of the clipping
function g1_lot(g) local(k) ( k = (g1_pmod ? G1_LOLEAD : G1_LODOOM) * (g / 10) ^ 1.5; g1_loL.am_bq(3, 9000, 0.7, k, srate); g1_loR.am_bq(3, 9000, 0.7, k, srate); );


// ================================================================ the FX LOOP (new): between the preamp and the power amp
// Three of the amps' own effects, free for any preamp: the Mali's bucket-brigade CHORUS / VIBRATO, a SPRING tank (the
// Amp Head's long one or the Mali's short one) and the Fullerton's optical TREMOLO, in that order. The chorus and the
// spring run at the host rate (both are band-limited well below it; at 2x / 4x their input is the amp-rate samples'
// average), the dry path and the tremolo at the amp's rate.
// Each switches in and out with a glide; a tank change fades the reverb out, swaps the tank, fades back in.
function lp_bbd(x, d) instance(buf, wp, p1, p2, q) local(rp, i, f, xm1, x0, x1, x2, y) (
  p1 += (x - p1) * lp_bc; p2 += (p1 - p2) * lp_bc;
  buf[wp] = p2;
  rp = wp - d; rp < 0 ? rp += ML_BB;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + ML_BM) & ML_BM]; x0 = buf[i & ML_BM]; x1 = buf[(i + 1) & ML_BM]; x2 = buf[(i + 2) & ML_BM];
  wp = (wp + 1) & ML_BM;
  y = (((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f + 0.5 * (x1 - xm1)) * f + x0;
  y = min(max(y, -3), 3); y = y * (27 + y * y) / (27 + 9 * y * y);
  this.q.am_run(y);
);
function lp_bclr() instance(buf, wp, p1, p2) ( memset(buf, 0, ML_BB); wp = p1 = p2 = 0; this.q.rp_bqclr(); );
// a side's tank: t = 0 the Amp Head's (37 / 43 ms), 1 the Mali's (29 / 34 ms); k spreads the two sides
function lp_tank(mem, t, k) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc) (
  b1 = mem; n1 = floor((t ? 0.0291 : 0.0371) * k * srate); b2 = mem + n1 + 8; n2 = floor((t ? 0.0337 : 0.0433) * k * srate);
  hp.am_bq(1, t ? 300 : 250, 0.7, 0, srate); lc = 1 - exp(-2 * $pi * (t ? 6200 : 3800) / srate);
  this.rp_spring_clr();
);
function lp_tset() (
  lrL.lp_tank(lp_mL, lp_ty, 1.0); lrR.lp_tank(lp_mR, lp_ty, lp_ty ? 1.0515 : 1.04);
  lp_sa = rp_apa(lp_ty ? 4.263158 : 2.131360); lp_se = rp_apa(lp_ty ? 3 : 1.5);
);
function lp_mem() (
  lpBL.buf = rp_alloc(ML_BB); lpBR.buf = rp_alloc(ML_BB);
  lp_mL = rp_alloc(ceil(0.0836 * 1.06 * srate) + 64); lp_mR = rp_alloc(ceil(0.0836 * 1.06 * srate) + 64);
);
// the loop's settings (every block)
function lp_update() local(c) (
  lp_con = slider38 >= 0.5; lp_vib = slider39 >= 0.5;
  lp_vib ? (
    lp_crate = 0.5 * 20 ^ (slider40 / 10);
    c = 50 * (slider41 / 10) ^ 1.3;
    lp_dept = min((2 ^ (c / 1200) - 1) / (2 * $pi * lp_crate) * 1000, 6);
    lp_cent = lp_dept + 1.3;
  ) : (
    lp_crate = 0.15 * 20 ^ (slider40 / 10);                    // 5 = 0.67 Hz (the Mali's chorus: 0.72)
    lp_dept = 0.4 + 0.3 * slider41;                             // 5 = 1.9 ms, as the Mali
    lp_cent = 4.6;
  );
  lp_ron = slider42 >= 0.5; lp_tyt = slider43 >= 0.5;
  lp_rwt = (slider44 / 10) ^ 1.5 * (lp_ty ? 1.5 : 0.9); lp_dw = slider45 / 10;
  lp_ton = slider46 >= 0.5;
  lp_trate = 1.5 * 6 ^ ((slider47 - 1) / 9);
  lp_Dt = lp_ton ? 10 * sqr((slider48 - 1) / 9) : 0;
  lp_stt = slider49 >= 0.5;
  lp_any = lp_con || lp_ron || lp_ton || lp_cm > 0 || lp_rm > 0 || lp_D > 0.0001;
);
// per block: DRIFT (the chorus clock, as the Mali's), the rates
function lp_block() local(di) (
  lp_update();
  di = 0.25 * dm_s * samplesblock / srate;
  lp_clk = 1 + 0.03 * dm_a * lpC.drift_tick(di);
  lp_cinc = lp_crate * (1 + 0.05 * dm_a * lpR.drift_tick(di)) / srate;
  lp_tinc = lp_trate / srate;
);
// a clean start (the start, a new sample rate, the OS key); the loop itself always runs at the host rate
function lp_rate() (
  lp_bc = 1 - exp(-2 * $pi * 11000 / srate);
  lpBL.q.am_bq(0, 8500, 0.65, 0, srate); lpBR.q.am_bq(0, 8500, 0.65, 0, srate);
  lpBL.lp_bclr(); lpBR.lp_bclr();
  lp_msr = srate / 1000;
  lp_sm = 1 - exp(-1 / (0.02 * srate)); lp_sm2 = 1 - exp(-1 / (0.08 * srate));
  lp_ty = lp_tyt; lp_tset();
  lp_cph = 0; lp_cs = lp_cent; lp_ds = lp_dept; lp_vm = lp_vib;
  lp_cm = lp_con; lp_rm = lp_ron * lp_rwt; lp_cact = lp_ract = 0;
  lp_wcL = lp_wcR = lp_rL = lp_rR = lp_pcL = lp_pcR = lp_prL = lp_prR = lp_aL = lp_aR = 0; lp_m = 0;
);
lp_smk = 0; lp_ldra = lp_ldrr = 0;
// the tremolo's light and its two cells (per host sample, as the Fullerton's)
function lp_trem() local(s, v) (
  lp_D += (lp_Dt - lp_D) * lp_smk; lp_D < 0.00001 && lp_Dt == 0 ? lp_D = 0;
  lp_st += (lp_stt - lp_st) * lp_smk;
  lp_tph += lp_tinc; lp_tph >= 1 ? lp_tph -= 1;
  s = sin(2 * $pi * lp_tph);
  v = max((s - 0.15) * 1.1764706, 0); v *= sqrt(v);
  lp_g1 += (v - lp_g1) * (v > lp_g1 ? lp_ldra : lp_ldrr);
  v = max((-s - 0.15) * 1.1764706, 0); v *= sqrt(v);
  lp_g2 += (v - lp_g2) * (v > lp_g2 ? lp_ldra : lp_ldrr);
  lp_tgL = 1 / (1 + lp_D * lp_g1);
  lp_tgR = 1 / (1 + lp_D * (lp_g1 + (lp_g2 - lp_g1) * lp_st));
);
// the loop's host-rate half: chorus and spring on (xl, xr) -> lp_wcL / lp_wcR (the chorus's wet), lp_m (its mix), lp_rL /
// lp_rR (the spring's return); at 2x / 4x the input is the average of the last host sample's amp-rate samples
function lp_host(xl, xr) local(lv, t, w) (
  lp_pcL = lp_wcL; lp_pcR = lp_wcR; lp_prL = lp_rL; lp_prR = lp_rR;
  // CHORUS / VIBRATO (the switch and the mode both glide: the shape crossfades, the mix follows)
  lp_cm += ((lp_con ? 1 : 0) - lp_cm) * lp_sm;
  lp_cm > 0.00001 ? (
    lp_vm += ((lp_vib ? 1 : 0) - lp_vm) * lp_sm;
    lp_cs += (lp_cent * lp_clk - lp_cs) * lp_sm2; lp_ds += (lp_dept * lp_clk - lp_ds) * lp_sm2;
    lp_cph += lp_cinc; lp_cph >= 1 ? lp_cph -= 1;
    t = 4 * abs(lp_cph - 0.5) - 1; t *= 1.5 - 0.5 * t * t;
    lv = t + (sin(2 * $pi * lp_cph) - t) * lp_vm;
    lp_wcL = lpBL.lp_bbd(xl, (lp_cs + lp_ds * lv) * lp_msr);
    t = lp_cph + 0.25; t -= floor(t); t = 4 * abs(t - 0.5) - 1; t *= 1.5 - 0.5 * t * t;
    lv += (t - lv) * (1 - lp_vm);                               // chorus: the right side a quarter turn on; vibrato: both alike
    lp_wcR = lpBR.lp_bbd(xr, (lp_cs + lp_ds * lv) * lp_msr);
    lp_m = lp_cm * (0.5 + 0.5 * lp_vm);
    xl += (lp_wcL - xl) * lp_m; xr += (lp_wcR - xr) * lp_m;
    lp_cact = 1;
  ) : lp_cact ? ( lp_cm = lp_m = 0; lp_wcL = lp_wcR = 0; lpBL.lp_bclr(); lpBR.lp_bclr(); lp_cact = 0; );
  // SPRING: a tank change fades the return out, swaps the tank at silence, fades back in
  lp_rm += ((lp_ron && lp_tyt == lp_ty ? lp_rwt : 0) - lp_rm) * lp_sm;
  lp_rm > 0.00001 || lp_ron ? (
    lp_ty != lp_tyt && lp_rm < 0.0001 ? ( lp_ty = lp_tyt; lp_tset(); );
    w = lrL.rp_spring_run(xl, lp_dw, lp_sa, lp_se); t = lrR.rp_spring_run(xr, lp_dw, lp_sa, lp_se);
    lp_rL = (w + 0.3 * t) * lp_rm; lp_rR = (t + 0.3 * w) * lp_rm;
    lp_ract = 1;
  ) : lp_ract ? (
    lp_rm = 0; lp_rL = lp_rR = 0; lrL.rp_spring_clr(); lrR.rp_spring_clr();
    lp_ty != lp_tyt ? ( lp_ty = lp_tyt; lp_tset(); ); lp_ract = 0;
  );
);
// the amp-rate half: the dry at the amp's rate, the wet parts eased in between host samples (k = 1 at the last one)
function lp_mix(k) local(w) (
  w = lp_pcL + (lp_wcL - lp_pcL) * k; lp_l += (w - lp_l) * lp_m;
  w = lp_pcR + (lp_wcR - lp_pcR) * k; lp_r += (w - lp_r) * lp_m;
  lp_l += lp_prL + (lp_rL - lp_prL) * k; lp_r += lp_prR + (lp_rR - lp_prR) * k;
  lp_D > 0 ? ( lp_l *= lp_tgL; lp_r *= lp_tgR; );               // TREMOLO
);

// ================================================================ the chassis
// the level each preamp hands its own power amp (the interface), so another power amp sees the same drive; and the
// level match of every mixed pair to the preamp's own amp (dB, row = preamp, column = power amp) - measured
function rp_tables() (
  rp_nk = rp_alloc(4); rp_nk[0] = 10 ^ (-22.86 / 20); rp_nk[1] = 10 ^ (-29.38 / 20); rp_nk[2] = 10 ^ (-26.27 / 20); rp_nk[3] = 10 ^ (-13.89 / 20);
  rp_zt = rp_alloc(16);                                   // (measured on a guitar riff, CAB off, at the defaults)
  rp_zt[0] = 0.0; rp_zt[1] = -6.66; rp_zt[2] = 3.66; rp_zt[3] = -9.93;
  rp_zt[4] = 6.73; rp_zt[5] = 0.0; rp_zt[6] = 10.18; rp_zt[7] = -3.26;
  rp_zt[8] = -3.39; rp_zt[9] = -10.09; rp_zt[10] = 0.0; rp_zt[11] = -13.01;
  rp_zt[12] = 10.12; rp_zt[13] = 3.55; rp_zt[14] = 13.96; rp_zt[15] = 0.0;
);
// the Fullerton's two speakers (open back, not quite matched)
function fl_cabset(side) instance(c1, c3, c4, c5, c6, c7) local(lp) (
  side == 0 ? (
    c1.am_bq(1, 88, 1.25, 0, srate);
    c3.am_bq(2, 480, 0.9, -2.5, srate); c4.am_bq(2, 2400, 1.4, 3.5, srate); lp = 5200; c7.am_bq(2, 7600, 2.2, -8, srate);
  ) : (
    c1.am_bq(1, 92, 1.35, 0, srate);
    c3.am_bq(2, 560, 1.0, -2.0, srate); c4.am_bq(2, 3000, 1.7, 4.0, srate); lp = 5700; c7.am_bq(2, 8200, 2.2, -7, srate);
  );
  c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
);
function fl_cabrun(x) instance(c1, c3, c4, c5, c6, c7) (
  c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c1.am_run(x))))));
);
// the pieces in use: rp_p (preamp), rp_w (power amp), rp_c (cabinet); targets rp_tp / rp_tw / rp_tc
function rp_cabset() (
  rp_c == 1 || rp_c == 2 ? (
    ga_cabL.am_cab_set(rp_c == 1 ? 2 : 3, max(rp_mic - 0.15, 0)); ga_cabR.am_cab_set(rp_c == 1 ? 2 : 3, min(rp_mic + 0.15, 10));
  ) : rp_c == 3 ? (
    fl_cabL.fl_cabset(0); fl_cabR.fl_cabset(1);
  ) : rp_c == 4 || rp_c == 5 ? (
    ml_cabL.ml_spk_set(rp_c == 5); ml_cabR.ml_spk_set(rp_c == 5);
  ) : rp_c == 6 ? (
    g1_cabL.g1_cabset(rp_mic - 0.3); g1_cabR.g1_cabset(rp_mic + 0.3);
  );
);
function rp_cabclr() (
  ga_cabL.c1.rp_bqclr(); ga_cabL.c2.rp_bqclr(); ga_cabL.c3.rp_bqclr(); ga_cabL.c4.rp_bqclr(); ga_cabL.c5.rp_bqclr(); ga_cabL.c6.rp_bqclr(); ga_cabL.c7.rp_bqclr();
  ga_cabR.c1.rp_bqclr(); ga_cabR.c2.rp_bqclr(); ga_cabR.c3.rp_bqclr(); ga_cabR.c4.rp_bqclr(); ga_cabR.c5.rp_bqclr(); ga_cabR.c6.rp_bqclr(); ga_cabR.c7.rp_bqclr();
  fl_cabL.c1.rp_bqclr(); fl_cabL.c3.rp_bqclr(); fl_cabL.c4.rp_bqclr(); fl_cabL.c5.rp_bqclr(); fl_cabL.c6.rp_bqclr(); fl_cabL.c7.rp_bqclr();
  fl_cabR.c1.rp_bqclr(); fl_cabR.c3.rp_bqclr(); fl_cabR.c4.rp_bqclr(); fl_cabR.c5.rp_bqclr(); fl_cabR.c6.rp_bqclr(); fl_cabR.c7.rp_bqclr();
  ml_cabL.s1.rp_bqclr(); ml_cabL.s2.rp_bqclr(); ml_cabL.s3.rp_bqclr(); ml_cabL.s4.rp_bqclr(); ml_cabL.s5.rp_bqclr(); ml_cabL.s6.rp_bqclr(); ml_cabL.s7.rp_bqclr();
  ml_cabR.s1.rp_bqclr(); ml_cabR.s2.rp_bqclr(); ml_cabR.s3.rp_bqclr(); ml_cabR.s4.rp_bqclr(); ml_cabR.s5.rp_bqclr(); ml_cabR.s6.rp_bqclr(); ml_cabR.s7.rp_bqclr();
  g1_cabL.c1.rp_bqclr(); g1_cabL.c2.rp_bqclr(); g1_cabL.c3.rp_bqclr(); g1_cabL.c4.rp_bqclr(); g1_cabL.c5.rp_bqclr(); g1_cabL.c6.rp_bqclr(); g1_cabL.c7.rp_bqclr(); g1_cabL.c8.rp_bqclr();
  g1_cabR.c1.rp_bqclr(); g1_cabR.c2.rp_bqclr(); g1_cabR.c3.rp_bqclr(); g1_cabR.c4.rp_bqclr(); g1_cabR.c5.rp_bqclr(); g1_cabR.c6.rp_bqclr(); g1_cabR.c7.rp_bqclr(); g1_cabR.c8.rp_bqclr();
);
// a piece coming in starts from a clean state (at the silent point of the duck)
function rp_prein(p) (
  p == 0 ? ( ga_gs = ga_s_gain = RP_ST[18]; ga_gset(); ga_drift(); ga_preupd(); ga_prerate(); rpfL.clp_pf_cfg(40000, 9000, -1.5, 150); ) :
  p == 1 ? ( fl_preupd(); fl_prerate(); fl_gN = fl_gNt; fl_gV = fl_gVt; fl_D = fl_Dt; fl_st = fl_stt; fl_vh = fl_vhold; fl_g1 = fl_g2 = 0; fl_ph = 0;
             rpfL.clp_pf_cfg(40000, 40000, -1.5, 150); ) :
  p == 2 ? ( ml_preupd(); ml_prerate(); ) :
  ( g1_prerate(); g1_sg = RP_ST[62]; g1_gk = g1_tgk = 10 ^ (1.6 * (g1_sg / 10 - 1)); g1_lot(g1_sg); rpfL.clp_pf_cfg(40000, G1_PF1, -1.5, 150); );
  rpfR.clp_pf_cfg(rpfL.pff0, rpfL.pff1, rpfL.pfsd, rpfL.pfsf); rpfL.clp_pf_reset(); rpfR.clp_pf_reset();
  rp_pfon = p != 2;
);
function rp_powin(w) (
  w == 0 ? ( ga_powupd(); ga_powrate(); ) :
  w == 1 ? ( fl_powupd(); fl_powrate(); ) :
  w == 2 ? ( ml_powupd(); ml_powrate(); ) :
  ( g1_powupd(); g1_mv = g1_tmv; g1_powrate(); );
);
// the settings (per block and from @slider)
function rp_update() (
  rp_tp = slider1 | 0; rp_tw = slider2 | 0; rp_tc = slider3 | 0;
  rp_tmono = slider6 >= 0.5;
  rp_mic = slider4;
  rp_wid = slider5 / 100;
  rp_gate = slider7;
  os_tf = os_f2n(slider8);
  in_setup(slider9, slider10 >= 0.5);
  drift_macro(slider11);
  rp_out = 10 ^ (slider12 / 20);
  ost_setup(slider13 / 100, slider14 / 100, slider15, slider16, slider17, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
);
// everything the pieces in use need per block
function rp_block() local(g) (
  // the preamp
  rp_p == 0 ? (
    ga_drift(); ga_s_gain = RP_ST[18];
    ga_preupd();
    ga_ghL.ga_v1.ah_tset(ga_b1); ga_ghL.ga_v2.ah_tset(ga_b2); ga_ghR.ga_v1.ah_tset(ga_b1); ga_ghR.ga_v2.ah_tset(ga_b2);
    rpfL.clp_pf_block(ga_gs / 10, srate, samplesblock); rpfR.clp_pf_block(ga_gs / 10, srate, samplesblock);
    ga_s_brt && ga_gs !== ga_lbg ? ( ga_ghL.ga_brt.am_bq(3, 2500, 0.6, 9 * (1 - ga_gs / 13), rp_fs); ga_ghR.ga_brt.am_bq(3, 2500, 0.6, 9 * (1 - ga_gs / 13), rp_fs); );
    ga_lbg = ga_gs;
    rp_ptrim = -ah_trim(ga_s_drive ? 1 : 0, ga_gs);
    g = ga_s_drive ? 3 : 0;
    rp_c == 0 ? (
      rp_ptrim += ah_lo(g + 2, ga_gs);
      ga_gs !== ga_lgs || g !== ga_lk ? ( ga_lgs = ga_gs; ga_lk = g; ga_loL.ah_loset(g, ga_gs); ga_loR.ah_loset(g, ga_gs); );
    );
    rp_pk = 1;
  ) : rp_p == 1 ? (
    fl_drift(); fl_preupd(); fl_tone(0); fl_bias(1);
    fl_tq = fl_trim(fl_s3, fl_s7); fl_tv = fl_trim(fl_s8, fl_s12);
    fl_tq = fl_gNt && fl_gVt ? max(fl_tq, fl_tv) + 0.5 * min(fl_tq, fl_tv) : fl_gNt ? fl_tq : fl_tv;
    rp_ptrim = -fl_tq;
    g = max(fl_gNt ? fl_s3 : 1, fl_gVt ? fl_s8 : 1);
    rpfL.clp_pf_block((g - 1) / 9, srate, samplesblock); rpfR.clp_pf_block((g - 1) / 9, srate, samplesblock);
    fl_isr = fl_rate * fl_rw / srate;
    rp_pk = 0.75;
  ) : rp_p == 2 ? (
    ml_drift(); ml_preupd();
    rp_ptrim = 0; rp_pk = 1;
  ) : (
    g1_drift(); g1_pretone(0); g1_bias(1);
    g1_sg += (RP_ST[62] - g1_sg) * (1 - exp(-samplesblock / (0.025 * srate)));
    abs(g1_sg - RP_ST[62]) < 0.001 ? g1_sg = RP_ST[62];
    g1_tgk = 10 ^ (1.6 * (g1_sg / 10 - 1));
    rp_c == 0 && g1_sg !== g1_lsg ? ( g1_lsg = g1_sg; g1_lot(g1_sg); );
    rpfL.clp_pf_block(g1_sg / 10, srate, samplesblock); rpfR.clp_pf_block(g1_sg / 10, srate, samplesblock);
    rp_ptrim = 20 * log10(g1_mkup(g1_pmod, g1_sg)); rp_pk = 1;
  );
  // the power amp (its drift: the same wander as its own preamp's, ticked once per block)
  rp_w == 0 ? (
    rp_p != 0 ? ga_drift();
    ga_powupd();
    rp_wtrim = -0.5 * ah_trim(2, RP_ST[26]); rp_wk = 2;
  ) : rp_w == 1 ? (
    rp_p != 1 ? fl_drift();
    fl_powupd(); fl_bias(2);
    rp_wtrim = 0; rp_wk = 2;
  ) : rp_w == 2 ? (
    rp_p != 2 ? ml_drift();
    ml_powupd();
    rp_wtrim = 0; rp_wk = 1;
  ) : (
    rp_p != 3 ? g1_drift();
    g1_powupd(); g1_powtone(0); g1_bias(2);
    rp_wtrim = -g1_mtrim(RP_ST[75], rp_p == 3 ? g1_sg : 5); rp_wk = 1;
  );
  // the pair's level
  rp_kin = rp_nk[rp_w] / rp_nk[rp_p];
  rp_tg = rp_out * rp_pk * rp_wk * 10 ^ ((rp_ptrim + rp_wtrim + rp_zt[rp_p * 4 + rp_w]) / 20);
  rp_mic != rp_lmic ? ( rp_lmic = rp_mic; rp_cabset(); );
);
// a piece change (or MONO IN): duck out, swap at the silent point, a short hold, back in
function rp_swap() (
  rp_mono = rp_tmono;
  rp_tp != rp_p ? ( rp_p = rp_tp; rp_prein(rp_p); );
  rp_tw != rp_w ? ( rp_w = rp_tw; rp_powin(rp_w); );
  rp_tc != rp_c ? ( rp_c = rp_tc; rp_cabset(); rp_cabclr(); ga_lgs = g1_lsg = -1; );
  rp_p == 2 ? ml_preupd();
  g1_pmod != (RP_ST[61] >= 0.5) ? ( g1_pvset(RP_ST[61] >= 0.5); g1_lot(g1_sg); );
  g1_wmod != (RP_ST[73] >= 0.5) ? g1_wvset(RP_ST[73] >= 0.5);
  rp_block();
  rp_g = rp_tg;
);
// a preset: every piece starts afresh with its new settings (at the silent point of the duck)
function rp_swapall() (
  rp_mono = rp_tmono;
  rp_p = rp_tp; rp_prein(rp_p); rp_w = rp_tw; rp_powin(rp_w);
  rp_c = rp_tc; rp_cabset(); rp_cabclr(); ga_lgs = g1_lsg = -1;
  rp_p == 2 ? ml_preupd();
  g1_pvset(RP_ST[61] >= 0.5); g1_lot(g1_sg); g1_wvset(RP_ST[73] >= 0.5);
  rp_block();
  rp_g = rp_tg;
);
// everything that depends on the rate the amp runs at (the start, a new sample rate, the OS key)
function rp_rate() (
  rp_fs = srate * os_f;
  rp_gk = 1 - exp(-1 / (0.025 * srate));
  rp_prein(rp_p); rp_powin(rp_w);
  rp_cabset(); rp_cabclr();
  uL.os_clr(); uR.os_clr(); dL.os_clr(); dR.os_clr();
  lp_rate();
);
function rp_start() (
  rp_sr = srate; rp_nm = 0;
  ost_init(rp_alloc(4096)); ostL.ost_ch_init(); ostR.ost_ch_init();
  ah_tables(); fl_tables(); g1_tables(); rp_tables();
  ga_mem(); fl_mem(); ml_mem(); lp_mem();
  in_init();
  rp_update(); lp_update();
  lp_smk = 1 - exp(-1 / (0.02 * srate));
  lp_ldra = 1 - exp(-1 / (0.004 * srate)); lp_ldrr = 1 - exp(-1 / (0.045 * srate));
  os_f = os_tf;
  rp_p = rp_tp; rp_w = rp_tw; rp_c = rp_tc; rp_mono = rp_tmono; rp_lmic = rp_mic;
  g1_pmod = RP_ST[61] >= 0.5; g1_wmod = RP_ST[73] >= 0.5;
  fl_vhold = floor(5 * srate);
  fl_smk = 1 - exp(-1 / (0.02 * srate));
  fl_ldra = 1 - exp(-1 / (0.004 * srate)); fl_ldrr = 1 - exp(-1 / (0.045 * srate));
  g1_smk = 1 - exp(-1 / (0.02 * srate));
  rp_ogk = 1 - exp(-1 / (0.03 * srate)); rp_wsg = 1 - exp(-1 / (0.02 * srate)); rp_ws = rp_wid;
  rp_rate();
  rp_block();
  rp_g = rp_tg;
  rp_dk = 1; rp_dst = 0; rp_dkr = 1 / (0.008 * srate);
  os_gsetup();
);

// ================================================================ the pieces' settings
// Every piece keeps its own settings in a store (RP_ST[n], n = the control's number below), saved with the project, so
// a piece swapped out and back comes back as it was. The host sees only the chosen preamp's and power amp's controls,
// through 16 + 3 generic sliders (REAPER 6 takes 64 sliders); rp_sync() keeps them and the store in step.
RP_ST = 4000000; RP_DF = 4000100;
RP_DF[18] = 5;   // AMP HEAD pre Gain
RP_DF[19] = 0;   // AMP HEAD pre Bright
RP_DF[20] = 0;   // AMP HEAD pre Channel
RP_DF[21] = 5;   // AMP HEAD pre Bass
RP_DF[22] = 5;   // AMP HEAD pre Middle
RP_DF[23] = 5;   // AMP HEAD pre Treble
RP_DF[24] = 2;   // AMP HEAD pre Reverb
RP_DF[25] = 5;   // AMP HEAD power Presence
RP_DF[26] = 4;   // AMP HEAD power Master
RP_DF[27] = 1;   // FULLERTON pre Channel
RP_DF[28] = 0;   // FULLERTON pre Jumper
RP_DF[29] = 4;   // FULLERTON pre Normal volume
RP_DF[30] = 6;   // FULLERTON pre Normal treble
RP_DF[31] = 5;   // FULLERTON pre Normal middle
RP_DF[32] = 4;   // FULLERTON pre Normal bass
RP_DF[33] = 0;   // FULLERTON pre Normal bright
RP_DF[34] = 4;   // FULLERTON pre Vibrato volume
RP_DF[35] = 6;   // FULLERTON pre Vibrato treble
RP_DF[36] = 5;   // FULLERTON pre Vibrato middle
RP_DF[37] = 4;   // FULLERTON pre Vibrato bass
RP_DF[38] = 0;   // FULLERTON pre Vibrato bright
RP_DF[39] = 3;   // FULLERTON pre Reverb
RP_DF[40] = 5;   // FULLERTON pre Speed
RP_DF[41] = 1;   // FULLERTON pre Intensity
RP_DF[42] = 0;   // FULLERTON pre Stereo tremolo
RP_DF[43] = 5;   // FULLERTON power Master
RP_DF[44] = 1;   // MALI pre Input channel
RP_DF[45] = 5;   // MALI pre Normal volume
RP_DF[46] = 5;   // MALI pre Normal treble
RP_DF[47] = 5;   // MALI pre Normal middle
RP_DF[48] = 5;   // MALI pre Normal bass
RP_DF[49] = 0;   // MALI pre Normal bright
RP_DF[50] = 5;   // MALI pre Effect volume
RP_DF[51] = 5;   // MALI pre Effect treble
RP_DF[52] = 5;   // MALI pre Effect middle
RP_DF[53] = 5;   // MALI pre Effect bass
RP_DF[54] = 0;   // MALI pre Effect bright
RP_DF[55] = 0;   // MALI pre Distortion
RP_DF[56] = 2;   // MALI pre Reverb
RP_DF[57] = 0;   // (unused, was MALI pre Modulation: moved to the FX LOOP)
RP_DF[58] = 5;   // (unused, was MALI pre Vibrato speed)
RP_DF[59] = 5;   // (unused, was MALI pre Vibrato depth)
RP_DF[60] = 5;   // MALI power Master
RP_DF[61] = 0;   // GR-120 pre Voicing
RP_DF[62] = 5;   // GR-120 pre Gain
RP_DF[63] = 5;   // GR-120 pre Bass
RP_DF[64] = 5;   // GR-120 pre Treble
RP_DF[65] = 2;   // GR-120 pre Freq contour
RP_DF[66] = 1;   // GR-120 pre Graphic
RP_DF[67] = 0;   // GR-120 pre Graphic 100 Hz (dB)
RP_DF[68] = 0;   // GR-120 pre Graphic 200 Hz (dB)
RP_DF[69] = 0;   // GR-120 pre Graphic 400 Hz (dB)
RP_DF[70] = 0;   // GR-120 pre Graphic 800 Hz (dB)
RP_DF[71] = 0;   // GR-120 pre Graphic 1.6 kHz (dB)
RP_DF[72] = 0;   // GR-120 pre Graphic 3.2 kHz (dB)
RP_DF[73] = 0;   // GR-120 power Voicing
RP_DF[74] = 5;   // GR-120 power Presence
RP_DF[75] = 5;   // GR-120 power Master
// preamp p's controls are RP_ST[rp_pb[p] .. + rp_pn[p] - 1], power amp w's RP_ST[rp_wb[w] .. + rp_wn[w] - 1]
rp_pb = 4000200; rp_pn = 4000204; rp_wb = 4000208; rp_wn = 4000212;
rp_pb[0] = 18; rp_pb[1] = 27; rp_pb[2] = 44; rp_pb[3] = 61; rp_pn[0] = 7; rp_pn[1] = 16; rp_pn[2] = 16; rp_pn[3] = 12;
rp_wb[0] = 25; rp_wb[1] = 43; rp_wb[2] = 60; rp_wb[3] = 73; rp_wn[0] = 2; rp_wn[1] = 1; rp_wn[2] = 1; rp_wn[3] = 3;
!rp_pinit ? ( memcpy(RP_ST + 18, RP_DF + 18, 58); rp_pinit = 1; );
rp_lpre = slider1 | 0; rp_lpow = slider2 | 0;
// a preset (asked for by the panel, loaded in @block at the silent point of a duck); every preset starts from Init
// (every control at its default); OS is not part of a preset. rp_s(n, v) sets a piece's control n (the store's numbers).
function rp_s(i, v) ( RP_ST[i] = v; );
function rp_preset(n) (
  memcpy(RP_ST + 18, RP_DF + 18, 58);
  slider1 = 0; slider2 = 0; slider3 = 1; slider4 = 3; slider5 = 100; slider6 = 0; slider7 = -80;
  slider9 = 0; slider10 = 0; slider11 = 50; slider12 = 0;
  slider13 = 0; slider14 = 30; slider15 = 120; slider16 = 6000; slider17 = -0.3;
  slider38 = 0; slider39 = 0; slider40 = 5; slider41 = 5; slider42 = 0; slider43 = 0; slider44 = 3; slider45 = 5;
  slider46 = 0; slider47 = 5; slider48 = 5; slider49 = 0;
  // ---- the originals
  n == 2 ? (                                                   // Fullerton Clean: the vibrato channel, its own tank
    slider12 = -2.6; slider1 = 1; slider2 = 1; slider3 = 3;
    rp_s(27, 1); rp_s(34, 4); rp_s(35, 6.5); rp_s(36, 4.5); rp_s(37, 4); rp_s(39, 3.5);
  ) : n == 3 ? (                                               // Mali Chorus: the normal channel, the loop chorus on
    slider12 = 6.8; slider1 = 2; slider2 = 2; slider3 = 4;
    rp_s(44, 0); rp_s(45, 5); rp_s(46, 6); rp_s(47, 5); rp_s(48, 5); rp_s(49, 1); rp_s(56, 2.5); slider38 = 1;
  ) : n == 4 ? (                                               // Head Crunch: DRIVE, the closed 4x12
    slider12 = -8.9; slider1 = 0; slider2 = 0; slider3 = 2;
    rp_s(18, 6); rp_s(20, 1); rp_s(21, 6); rp_s(22, 6); rp_s(23, 5.5); rp_s(24, 1); rp_s(25, 6); rp_s(26, 6);
  ) : n == 5 ? (                                               // GR Doom: the low-tuned wall
    slider1 = 3; slider2 = 3; slider3 = 6; slider7 = -62;
    rp_s(61, 0); rp_s(62, 8); rp_s(63, 7); rp_s(64, 5); rp_s(65, 1); rp_s(73, 0); rp_s(74, 5); rp_s(75, 6);
  ) : n == 6 ? (                                               // GR Lead: LEAD voicing, a mid push on the graphic
    slider12 = -3.5; slider1 = 3; slider2 = 3; slider3 = 6; slider7 = -64;
    rp_s(61, 1); rp_s(62, 7); rp_s(63, 5); rp_s(64, 6); rp_s(65, 3); rp_s(66, 1); rp_s(69, 3); rp_s(70, 4); rp_s(71, 2);
    rp_s(73, 1); rp_s(74, 6); rp_s(75, 6);
    slider42 = 1; slider43 = 0; slider44 = 2; slider45 = 4;
  // ---- the hybrids
  ) : n == 7 ? (                                               // Black Panel Crunch: the Fullerton pushed into the Head's EL34s
    slider12 = -13.5; slider1 = 1; slider2 = 0; slider3 = 2;
    rp_s(27, 0); rp_s(29, 8); rp_s(30, 6); rp_s(31, 6); rp_s(32, 5); rp_s(33, 1); rp_s(25, 6); rp_s(26, 7);
  ) : n == 8 ? (                                               // Chorus Stack: the Head's drive into the GR power amp and 4x12, chorus in the loop
    slider12 = -3.3; slider1 = 0; slider2 = 3; slider3 = 6;
    rp_s(18, 7); rp_s(20, 1); rp_s(22, 5.5); rp_s(23, 6); rp_s(24, 0); rp_s(73, 1); rp_s(74, 5); rp_s(75, 5);
    slider38 = 1; slider39 = 0; slider40 = 4; slider41 = 6;
  ) : n == 9 ? (                                               // Fizz Wall: the Mali's distortion into the GR's EL34s
    slider12 = -4.3; slider1 = 2; slider2 = 3; slider3 = 6;
    rp_s(44, 1); rp_s(50, 6); rp_s(51, 5); rp_s(52, 6); rp_s(53, 6); rp_s(55, 7); rp_s(56, 0); rp_s(74, 4); rp_s(75, 5);
  ) : n == 10 ? (                                              // Surf Trem: the Fullerton's normal channel, a wet tank, stereo trem
    slider12 = -8.8; slider1 = 1; slider2 = 2; slider3 = 4;
    rp_s(27, 0); rp_s(29, 5); rp_s(30, 7); rp_s(31, 4); rp_s(32, 4); rp_s(33, 1);
    slider42 = 1; slider43 = 0; slider44 = 6; slider45 = 8; slider46 = 1; slider47 = 6.5; slider48 = 6; slider49 = 1;
  ) : n == 11 ? (                                              // Vibrato Drive: the Head's drive through the loop's vibrato into the Fullerton
    slider12 = -6.3; slider1 = 0; slider2 = 1; slider3 = 3;
    rp_s(18, 6.5); rp_s(20, 1); rp_s(21, 5); rp_s(23, 6); rp_s(24, 0);
    slider38 = 1; slider39 = 1; slider40 = 5.5; slider41 = 3.5; slider42 = 1; slider43 = 1; slider44 = 2.5;
  ) : n == 12 ? (                                              // Small Box Lead: the GR's lead into the Mali's power amp and 2x8
    slider12 = 1.2; slider1 = 3; slider2 = 2; slider3 = 5; slider7 = -66;
    rp_s(61, 1); rp_s(62, 6.5); rp_s(63, 4); rp_s(64, 6); rp_s(65, 2); rp_s(60, 5);
  ) : n == 13 ? (                                              // Ambient Clean: the Mali's effect channel, chorus, long spring, slow trem
    slider12 = 10.9; slider1 = 2; slider2 = 1; slider3 = 3;
    rp_s(44, 1); rp_s(50, 4.5); rp_s(51, 6); rp_s(53, 4); rp_s(56, 0);
    slider38 = 1; slider40 = 3; slider41 = 7; slider42 = 1; slider43 = 0; slider44 = 6; slider45 = 9;
    slider46 = 1; slider47 = 2; slider48 = 4; slider49 = 1;
  );
  rp_lpre = rp_lpow = -1;                                      // rp_sync() hands the store to the generic sliders
  sliderchange(2 ^ 49 - 1 - 2 ^ 7);
);
// the generic sliders -> the store; a new piece chosen: its stored settings -> the sliders
function rp_sync() local(p, w, k, m) (
  p = slider1 | 0; w = slider2 | 0; m = 0;
  p == rp_lpre ? ( k = 0; loop(rp_pn[p], RP_ST[rp_pb[p] + k] = slider(18 + k); k += 1; ); ) : (
    k = 0; loop(16, slider(18 + k) = k < rp_pn[p] ? RP_ST[rp_pb[p] + k] : 0; k += 1; ); m = 1; rp_lpre = p;
  );
  w == rp_lpow ? ( k = 0; loop(rp_wn[w], RP_ST[rp_wb[w] + k] = slider(34 + k); k += 1; ); ) : (
    k = 0; loop(3, slider(34 + k) = k < rp_wn[w] ? RP_ST[rp_wb[w] + k] : 0; k += 1; ); m = 1; rp_lpow = w;
  );
  m ? sliderchange(2 ^ 17 * 524287);
);

os_design();
os_base = 0;
ga_dB1.drift_init(0.8 + rand(1) * 0.5); ga_dB2.drift_init(0.8 + rand(1) * 0.5);
dw1.drift_init(0.8 + rand(1) * 0.5); dw2.drift_init(0.8 + rand(1) * 0.5); dw3.drift_init(0.8 + rand(1) * 0.5); dw4.drift_init(0.8 + rand(1) * 0.5);
dw5.drift_init(0.8 + rand(1) * 0.5); dw6.drift_init(0.8 + rand(1) * 0.5); dw7.drift_init(0.8 + rand(1) * 0.5); dw8.drift_init(0.8 + rand(1) * 0.5);
dwr.drift_init(0.8 + rand(1) * 0.5);
lpC.drift_init(0.8 + rand(1) * 0.5); lpR.drift_init(0.8 + rand(1) * 0.5);
drS.drift_init(0.8 + rand(1) * 0.5); drB.drift_init(0.8 + rand(1) * 0.5);
g1dw1.drift_init(0.8 + rand(1) * 0.5); g1dw2.drift_init(0.8 + rand(1) * 0.5); g1dw3.drift_init(0.8 + rand(1) * 0.5); g1dw4.drift_init(0.8 + rand(1) * 0.5);
g1dw5.drift_init(0.8 + rand(1) * 0.5); g1dw6.drift_init(0.8 + rand(1) * 0.5); g1dw7.drift_init(0.8 + rand(1) * 0.5); g1dw8.drift_init(0.8 + rand(1) * 0.5);
rp_start();
rp_pkL_disp = rp_pkR_disp = 0;
rp_rf = 1;

ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function rp_req(p) ( rp_prq_d = p; );   // a preset change (swapped in @block behind a short duck)

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; rp_req(k);
    k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( rp_req(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
rp_sync();
rp_update();

@block
prs_chk();
srate != rp_sr ? rp_start();
// back on after REAPER's bypass (the plug-in wasn't called): clear the stale state, crossfade 15 ms from the dry input
rp_now = time_precise();
rp_last > 0 && rp_now - rp_last > max(0.15, 4 * samplesblock / srate) ? ( rp_rate(); rp_rf = 0; rp_rc = 1 / (0.015 * srate); );
rp_last = rp_now;
// a preset asked for (by the panel): duck out, load it at the silent point (below), come back in
rp_prq_d > 0 && rp_dst == 0 ? ( rp_prn = rp_prq_d; rp_prq_d = 0; rp_dfor = 1; rp_dst = 1; );
rp_sync();
rp_update();
rp_dst == 3 ? (
  rp_preset(rp_prn); rp_sync(); rp_update(); lp_update(); rp_swapall();
  rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dfor = 0; rp_dst = 2;
);
// a piece, MONO IN or a voicing asked for: start the duck
rp_dst == 0 && (rp_tp != rp_p || rp_tw != rp_w || rp_tc != rp_c || rp_tmono != rp_mono ||
  g1_pmod != (RP_ST[61] >= 0.5) || g1_wmod != (RP_ST[73] >= 0.5)) ? rp_dst = 1;
rp_dst < 2 ? rp_block();
lp_block();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_mem(0, RP_ST + 18, 58);
rp_lpre = slider1 | 0; rp_lpow = slider2 | 0;
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// the duck: out, the swap at silence, a hold while the old state rings out, back in
rp_dst == 1 ? ( rp_dk -= rp_dkr; rp_dk <= 0 ? ( rp_dk = 0; rp_dfor ? rp_dst = 3 : ( rp_swap(); rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dst = 2; ); ); ) :
rp_dst == 2 ? ( rp_hc > 0 ? rp_hc -= 1 : ( rp_dk += rp_dkr; rp_dk >= 1 ? ( rp_dk = 1; rp_dst = 0; ); ); );
// the OS key: a factor change swaps in at the silent point of its own dip
os_gate();
os_chg ? rp_rate();

rp_dl = spl0; rp_dr = spl1;
in_process(spl0, spl1);
rp_xl = in_l; rp_xr = in_r;
rp_gate > -79.5 ? ( rp_gg = rp_gt.am_gate(max(abs(rp_xl), abs(rp_xr)), rp_gate); rp_xl *= rp_gg; rp_xr *= rp_gg; );
rp_mono ? ( rp_xl = rp_xr = 0.5 * (rp_xl + rp_xr); );
rp_pfon ? ( rp_xl = rpfL.clp_pf_run(rp_xl); rp_xr = rpfR.clp_pf_run(rp_xr); );
rp_dn = -rp_dn;

// the host-rate work of the preamp in use
rp_p == 0 ? ga_glide() :
rp_p == 1 ? (
  fl_gN += (fl_gNt - fl_gN) * fl_smk; fl_gV += (fl_gVt - fl_gV) * fl_smk;
  fl_nrun = fl_gN > 0.00001; fl_kN = fl_gN * fl_kin; fl_kV = fl_gV * fl_kin;
  fl_gV > 0.00001 ? fl_vh = fl_vhold : fl_vh > 0 ? fl_vh -= 1;
  fl_vrun = fl_vh > 0;
  fl_D += (fl_Dt - fl_D) * fl_smk;
  fl_st += (fl_stt - fl_st) * fl_smk;
  fl_ph += fl_isr; fl_ph >= 1 ? fl_ph -= 1;
  fl_s = sin(2 * $pi * fl_ph);
  fl_lv = max((fl_s - 0.15) * 1.1764706, 0); fl_lv *= sqrt(fl_lv);
  fl_g1 += (fl_lv - fl_g1) * (fl_lv > fl_g1 ? fl_ldra : fl_ldrr);
  fl_lv = max((-fl_s - 0.15) * 1.1764706, 0); fl_lv *= sqrt(fl_lv);
  fl_g2 += (fl_lv - fl_g2) * (fl_lv > fl_g2 ? fl_ldra : fl_ldrr);
  fl_tgL = 1 / (1 + fl_D * fl_g1);
  fl_tgR = 1 / (1 + fl_D * (fl_g1 + (fl_g2 - fl_g1) * fl_st));
) :
rp_p == 3 ? ( g1_gk += (g1_tgk - g1_gk) * g1_smk; );
lp_any ? lp_trem();
rp_w == 3 ? ( g1_mv += (g1_tmv - g1_mv) * g1_smk; );

// the preamp and power amp at the amp's rate (1x, 2x or 4x)
uL.os_up(rp_xl); uR.os_up(rp_xr);
rp_i = 0;
loop(os_f,
  rp_al = uL.os_s(rp_i); rp_ar = uR.os_s(rp_i);
  // the preamp -> rp_al / rp_ar
  rp_p == 0 ? (
    ga_ghL.ga_pre(rp_al); ga_ghR.ga_pre(rp_ar);
    rp_al = ga_ghL.ga_py + (ga_ghL.ga_ry + ga_ghR.ga_ry * 0.4) * ga_rvw;
    rp_ar = ga_ghR.ga_py + (ga_ghR.ga_ry + ga_ghL.ga_ry * 0.4) * ga_rvw;
  ) : rp_p == 1 ? (
    fl_vrun && fl_tph ? (
      fl_rL1 = fl_rL; fl_rR1 = fl_rR;
      fl_rL = tkL.fl_tank(cL.fl_send(cL.sacc), 0); fl_rR = tkR.fl_tank(cR.fl_send(cR.sacc), 3);
      cL.sacc = 0; cR.sacc = 0;
      fl_tw = (fl_tw + 1) & fl_tm; fl_tp += 1; fl_tp >= fl_tK ? fl_tp = 0;
    );
    fl_tph = !fl_tph;
    rp_al = cL.fl_pre(rp_al, fl_tph ? fl_rL : 0.5 * (fl_rL + fl_rL1), fl_tgL);
    rp_ar = cR.fl_pre(rp_ar, fl_tph ? fl_rR : 0.5 * (fl_rR + fl_rR1), fl_tgR);
  ) : rp_p == 2 ? (
    ml_prerun(rp_al, rp_ar); rp_al = ml_sL; rp_ar = ml_sR;
  ) : (
    rp_al = g1L.g1_pre(rp_al); rp_ar = g1R.g1_pre(rp_ar);
  );
  // the power amp
  (
    rp_al *= rp_kin; rp_ar *= rp_kin;
    lp_any ? (                                                  // the FX LOOP
      os_f == 1 ? ( lp_host(rp_al, rp_ar); lp_k = 1; ) : (
        rp_i == 0 ? ( lp_host(lp_aL / os_f, lp_aR / os_f); lp_aL = lp_aR = 0; );
        lp_aL += rp_al; lp_aR += rp_ar; lp_k = (rp_i + 1) / os_f;
      );
      lp_l = rp_al; lp_r = rp_ar; lp_mix(lp_k); rp_al = lp_l; rp_ar = lp_r;
    );
    rp_w == 0 ? (
      rp_al = ga_pwL.ga_pow(rp_al); rp_ar = ga_pwR.ga_pow(rp_ar); ga_sag();
    ) : rp_w == 1 ? (
      rp_al = fpL.fl_pow(rp_al); rp_ar = fpR.fl_pow(rp_ar);
    ) : rp_w == 2 ? (
      rp_al = OL.ml_pow(rp_al); rp_ar = OR.ml_pow(rp_ar);
    ) : (
      rp_al = g1wL.g1_pow(rp_al); rp_ar = g1wR.g1_pow(rp_ar);
    );
  );
  rp_i == 0 ? ( rp_a0 = rp_al; rp_b0 = rp_ar; ) : rp_i == 1 ? ( rp_a1 = rp_al; rp_b1 = rp_ar; ) :
  rp_i == 2 ? ( rp_a2 = rp_al; rp_b2 = rp_ar; ) : ( rp_a3 = rp_al; rp_b3 = rp_ar; );
  rp_i += 1;
);
rp_yl = dL.os_dn(rp_a0, rp_a1, rp_a2, rp_a3); rp_yr = dR.os_dn(rp_b0, rp_b1, rp_b2, rp_b3);

(
  // the preamp's post-shelf (host rate; the Amp Head's and Fullerton's at 1x only), the power amp's host-rate side
  rp_p == 0 ? ( os_f == 1 ? ( rp_yl = ga_k2L.am_run(ga_k1L.am_run(rp_yl)); rp_yr = ga_k2R.am_run(ga_k1R.am_run(rp_yr)); ); ) :
  rp_p == 1 ? ( os_f == 1 ? ( rp_yl = fl_k3L.am_run(fl_k2L.am_run(fl_k1L.am_run(rp_yl))); rp_yr = fl_k3R.am_run(fl_k2R.am_run(fl_k1R.am_run(rp_yr))); ); ) :
  rp_p == 3 ? ( rp_yl = g1_k1L.am_run(rp_yl); rp_yr = g1_k1R.am_run(rp_yr); );
  rp_w == 3 ? ( rp_yl = g1wL.g1_tail(rp_yl); rp_yr = g1wR.g1_tail(rp_yr); );
  // the cabinet (or the line out)
  rp_c == 1 || rp_c == 2 ? ( rp_yl = ga_cabL.am_cab_run(rp_yl); rp_yr = ga_cabR.am_cab_run(rp_yr); ) :
  rp_c == 3 ? ( rp_yl = fl_cabL.fl_cabrun(rp_yl); rp_yr = fl_cabR.fl_cabrun(rp_yr); ) :
  rp_c == 4 || rp_c == 5 ? ( rp_yl = ml_cabL.ml_spk(rp_yl); rp_yr = ml_cabR.ml_spk(rp_yr); ) :
  rp_c == 6 ? ( rp_yl = g1_cabL.g1_cab(rp_yl); rp_yr = g1_cabR.g1_cab(rp_yr); ) : (
    rp_p == 0 ? ( rp_yl = ga_loL.s2.am_run(ga_loL.s1.am_run(rp_yl)); rp_yr = ga_loR.s2.am_run(ga_loR.s1.am_run(rp_yr)); ) :
    rp_p == 3 ? ( rp_yl = g1_loL.am_run(rp_yl); rp_yr = g1_loR.am_run(rp_yr); );
  );
  // WIDTH: the speakers' spread
  rp_ws += (rp_wid - rp_ws) * rp_wsg;
  rp_ws < 0.99999 ? (
    rp_a = 0.5 + 0.5 * rp_ws; rp_b = 0.5 - 0.5 * rp_ws;
    rp_t = rp_yl; rp_yl = rp_yl * rp_a + rp_yr * rp_b; rp_yr = rp_yr * rp_a + rp_t * rp_b;
  );
  rp_g += (rp_tg - rp_g) * rp_ogk;
  rp_k = rp_g;
);
rp_dst ? ( rp_dkg = rp_dk * rp_dk * (3 - 2 * rp_dk); rp_k *= rp_dkg; );
os_g < 1 ? rp_k *= os_g;
rp_yl *= rp_k; rp_yr *= rp_k;
rp_yl = ostL.ost_band(rp_yl); rp_yr = ostR.ost_band(rp_yr);
ost_out(rp_yl, rp_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rp_rf < 1 ? (                                                   // the resume crossfade (see @block)
  rp_rf = min(rp_rf + rp_rc, 1); rp_rs = rp_rf * rp_rf * (3 - 2 * rp_rf);
  spl0 = rp_dl + (spl0 - rp_dl) * rp_rs; spl1 = rp_dr + (spl1 - rp_dr) * rp_rs;
);
rp_pkL_disp = max(rp_pkL_disp, abs(spl0)); rp_pkR_disp = max(rp_pkR_disp, abs(spl1));

@gfx 1080 660
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
// =====================================================================
// GUI - RAMP faceplate: a dark chassis with three slots (PREAMP, POWER AMP, CABINET). The piece in each slot brings its
// own amp's livery: Amp Head brushed silver, Fullerton black panel, Mali black and silver, GR-120 aubergine and gold.
// The FX LOOP and IN / OUT are the chassis's own. House parts: lamp keys, LCD preset bar, display boxes (click for the
// menu), S / M / L / ?, the OS key.
// =====================================================================
function rpi(n) ( 18 + n - rp_pb[slider1 | 0]; );   // a preamp control's number -> its generic slider
function rwi(n) ( 34 + n - rp_wb[slider2 | 0]; );   // a power amp control's number -> its generic slider
// a preset: asked for here, loaded in @block at the silent point of a duck (the pieces' store is the audio thread's)
function load_preset(p) ( rp_prq_d = p; );
function rg_col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function rg_shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function rg_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function rg_px(v) ( rg_ox + v * sc; );
function rg_py(v) ( rg_oy + v * sc; );
function rg_ps(v) ( v * sc; );
function rg_rect(x, y, w, h) ( gfx_rect(rg_px(x), rg_py(y), rg_ps(w), rg_ps(h), 1); );
function rg_tc(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_tl(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_tr(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_rivet(x, y) (
  rg_col(0x6A655E, 1);  gfx_circle(rg_px(x), rg_py(y), rg_ps(3.5), 1, 1);
  rg_col(0xFFFFFF, 0.55);  gfx_circle(rg_px(x) - rg_ps(1), rg_py(y) - rg_ps(1), rg_ps(1.2), 1, 1);
);
function rg_in(x, y, w, h) ( mouse_x >= rg_px(x) && mouse_x < rg_px(x + w) && mouse_y >= rg_py(y) && mouse_y < rg_py(y + h); );
function rg_touch(idx) ( ui_auto(idx); );
// soft drop shadow, down and to the right: 4 layers at 13 % black
function rg_dshadow(x, y, r) local(i) (
  i = 0;  loop(4, rg_col(0x000000, 0.13);  gfx_circle(x + rg_ps(2 + i * 1.33), y + rg_ps(3 + i * 1.67), r + rg_ps(i * 0.6), 1, 1);  i += 1; );
);
// pointer as a filled quad with anti-aliased edges: clean at any angle
function rg_ptr(x, y, sn, cs, ri, ro, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sn * ri;  ay = y - cs * ri;  bx = x + sn * ro;  by = y - cs * ro;  dx = cs * hw;  dy = sn * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function rg_dotarc(x, y, r, a0, a1, w) local(n, i, a) (
  n = max(2, ceil(abs(a1 - a0) * r / max(w * 0.6, 0.5)));  i = 0;
  loop(n + 1, a = a0 + (a1 - a0) * i / n;  gfx_circle(x + sin(a) * r, y - cos(a) * r, w * 0.5, 1, 1);  i += 1; );
);
function rg_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  rg_col(0x14110D, 0.95);  gfx_rect(x - w * 0.5 - rg_ps(6), y - h * 0.5 - rg_ps(3), w + rg_ps(12), h + rg_ps(6), 1);
  rg_col(0xFFB347, 1);  rg_tc(x, y, str);
);

// ---------- the knob faces: 0 desk (the chassis), 1 Amp Head, 2 Fullerton, 3 Mali, 4 GR-120 ----------
function rg_face(x, y, rr, tv, k, cap) (
  k == 1 ? (                                                   // black ribbed skirt, chrome centre, white line
    rg_col(0x0E0E0F, 1);  gfx_circle(x, y, rr, 1, 1);
    rg_col(0x3A3B3E, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0x1C1D1F, 1);  gfx_circle(x, y, rr * 0.86, 1, 1);
    rg_col(0xFFFFFF, 0.9);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.55, rr * 0.97, rg_ps(1.4));
    rg_col(0x9A9DA2, 1);  gfx_circle(x, y, rr * 0.48, 1, 1);
    rg_col(0xE4E6EA, 1);  gfx_circle(x, y, rr * 0.42, 1, 1);
    rg_col(0xFFFFFF, 0.8);  gfx_arc(x, y, rr * 0.36, -1.7, -0.2, 1);
    rg_col(0x6E7176, 1);  gfx_circle(x, y, rr * 0.42, 0, 1);
  ) : k == 2 ? (                                               // black skirt, white cap, red value arc
    rg_col(0xE24A3A, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, tv, rg_ps(3));
    rg_col(0x0C0C0D, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x34353A, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xB9BCC2, 1);  gfx_circle(x, y, rr * 0.7, 1, 1);
    rg_col(0xF2F2F0, 1);  gfx_circle(x, y, rr * 0.64, 1, 1);
    rg_col(0xFFFFFF, 0.9);  gfx_arc(x, y, rr * 0.58, -1.7, -0.2, 1);
    rg_col(0x1A1A1C, 1);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.12, rr * 0.95, rg_ps(1.3));
  ) : k == 3 ? (                                               // dark knob, silver cap, blue value arc
    rg_col(0x2C2F35, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, 0.75 * $pi, rg_ps(2));
    rg_col(0x3C96F0, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, tv, rg_ps(3.2));
    rg_col(0x15171A, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x3A3E46, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xC9CDD3, 1);  gfx_circle(x, y, rr * 0.66, 1, 1);
    rg_col(0xFFFFFF, 0.7);  gfx_arc(x, y, rr * 0.6, -1.7, -0.2, 1);
    rg_col(0x15171A, 1);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.95, rg_ps(1.3));
  ) : k == 4 ? (                                               // big black knob, white line (gold ticks round it)
    rg_col(0x0B0B0C, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x2E2A2E, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0x18181A, 1);  gfx_circle(x, y, rr * 0.9, 1, 1);
    rg_col(0xFFFFFF, 0.1);  gfx_arc(x, y, rr * 0.84, -1.7, -0.2, 1);
    rg_col(0xF4F4F2, 1);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.3, rr * 0.92, rg_ps(1.8));
  ) : (                                                        // the desk knob: grey skirt, light body, coloured cap
    rg_col(0x7E848A, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x5E646A, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xE6E3DC, 1);  gfx_circle(x, y, rr * 0.78, 1, 1);
    rg_col(0xFFFFFF, 0.5);  gfx_arc(x, y, rr * 0.74, -1.6, -0.3, 1);
    rg_col(cap, 1);  gfx_circle(x, y, rr * 0.5, 1, 1);  rg_col(rg_shade(cap, 0.75), 1);  gfx_circle(x, y, rr * 0.5, 0, 1);
    rg_col(0x1A1A1A, 1);  rg_ptr(x, y, sin(tv), cos(tv), 0, rr * 0.98, rg_ps(1.4));
  );
  // a light vignette edge: darker towards the rim (more on the bottom right)
  rg_col(0x000000, 0.10);  gfx_arc(x, y, rr - rg_ps(1), 0.6, 2.9, 1);  gfx_arc(x, y, rr - rg_ps(2), 0.9, 2.6, 1);
);
// Knob: style k (above), cap colour for the desk knob. rg_kstep > 0 = stepped, rg_kdim = shown dimmed, rg_kzero = a
// "0" at the top. Drag 200 px (Shift = fine), wheel 3 % (Shift 0.5 %), double-click / Ctrl-click = default. The value
// shows in a tag above the knob while it is touched.
function rg_kn(cx, cy, r, idx, vmin, vmax, def, k, cap, lbl, fmt)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, st, dm, zr)
(
  st = rg_kstep;  rg_kstep = 0;  dm = rg_kdim;  rg_kdim = 0;  zr = rg_kzero;  rg_kzero = 0;
  x = rg_px(cx);  y = rg_py(cy);  rr = rg_ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = (v - vmin) / (vmax - vmin);
  rg_click && hov && !rg_drag ? (
    now = time_precise();
    (mouse_cap & 4) || (rg_lci == idx && now - rg_lct < 0.35) ? (
      slider(idx) = def;  rg_touch(idx);  rg_drag = 0;
    ) : ( rg_drag = idx;  rg_dy = mouse_y;  rg_dt = t;  rg_dmv = 0; );
    rg_lci = idx;  rg_lct = now;
  );
  hov && mouse_wheel != 0 && !rg_drag ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));  v = vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    mouse_wheel = 0;
  );
  rg_drag == idx ? (
    !rg_dmv && abs(mouse_y - rg_dy) > rg_ps(3) ? ( rg_dmv = 1;  rg_dy = mouse_y; );   // a 3 px dead zone
    rg_dmv ? (
      t = max(0, min(1, rg_dt + (rg_dy - mouse_y) / rg_ps((mouse_cap & 8) ? 1100 : 200)));
      v = vmin + t * (vmax - vmin);
      v = st > 0 ? vmin + floor((v - vmin) / st + 0.5) * st : floor(v * 1000 + 0.5) / 1000;
      v = max(vmin, min(vmax, v));
      v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  k != 2 && k != 3 ? (                                         // the scale: eleven dots (the arcs mark the others)
    rg_col(rg_ink2, 0.85);  j = 0;
    loop(11, b = a0 + j / 10 * (a1 - a0);
      !(zr && j == 5) ? gfx_circle(x + sin(b) * (rr + rg_ps(6)), y - cos(b) * (rr + rg_ps(6)), rg_ps(k == 4 ? 1.6 : 1.2), 1, 1);  j += 1; );
  );
  zr ? ( gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tc(x, y - rr - rg_ps(9), "0"); );
  rg_dshadow(x, y, rr);
  rg_face(x, y, rr, tv, k, cap);
  dm ? ( rg_col(rg_plate, 0.55);  gfx_circle(x, y, rr + rg_ps(5), 1, 1); );
  gfx_setfont(6);  rg_col(dm ? rg_mix(rg_ink, rg_plate, 0.5) : rg_ink, 1);  rg_tc(x, y + rr + rg_ps(19), lbl);
  hov || rg_drag == idx ? ( sprintf(#rgv, fmt, v);  rg_tag(x, y - rr - rg_ps(17), #rgv); );
);
// a vertical fader (the GR-120's graphic): drag in its column, double-click / Ctrl-click = default
function rg_fader(x, y0, h, idx, vmin, vmax, def, lbl, fmt) local(t, v, cy, hov, now, j, cx) (
  cx = rg_px(x);
  v = slider(idx);  t = (v - vmin) / (vmax - vmin);
  hov = abs(mouse_x - cx) < rg_ps(14) && mouse_y >= rg_py(y0 - 10) && mouse_y <= rg_py(y0 + h + 10);
  rg_click && hov && !rg_drag ? (
    now = time_precise();
    (mouse_cap & 4) || (rg_lci == idx && now - rg_lct < 0.35) ? (
      slider(idx) = def;  rg_touch(idx);  rg_drag = 0;
    ) : ( rg_drag = idx;  rg_dy = mouse_y;  rg_dt = t;  rg_dmv = 1; );
    rg_lci = idx;  rg_lct = now;
  );
  hov && mouse_wheel != 0 && !rg_drag ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));  v = vmin + t * (vmax - vmin);
    v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    mouse_wheel = 0;
  );
  rg_drag == idx ? (
    t = max(0, min(1, rg_dt + (rg_dy - mouse_y) / rg_ps((mouse_cap & 8) ? h * 5 : h)));
    v = floor((vmin + t * (vmax - vmin)) * 2 + 0.5) / 2;
    v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
  );
  v = slider(idx);  t = (v - vmin) / (vmax - vmin);
  cy = y0 + h * (1 - t);
  rg_col(rg_ink2, 0.7);  j = 0;  loop(5, rg_rect(x - 14, y0 + j * h / 4, 5, 1);  rg_rect(x + 9, y0 + j * h / 4, 5, 1);  j += 1; );
  rg_col(0x000000, 0.6);  rg_rect(x - 3, y0 - 4, 6, h + 8);  rg_col(0x050505, 1);  rg_rect(x - 1, y0 - 2, 2, h + 4);
  j = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(x - 11 + 2 + j * 1.33, cy - 8 + 3 + j * 1.67, 22, 16);  j += 1; );
  rg_col(0x1A1A1C, 1);  rg_rect(x - 11, cy - 8, 22, 16);
  rg_col(0xFFFFFF, 0.25);  rg_rect(x - 11, cy - 8, 22, 1.5);
  rg_col(0xF4F4F2, 1);  rg_rect(x - 11, cy - 1, 22, 2);
  gfx_setfont(6);  rg_col(rg_ink, 1);  rg_tc(cx, rg_py(y0 + h + 22), lbl);
  hov || rg_drag == idx ? ( sprintf(#rgv, fmt, v);  rg_tag(cx, rg_py(y0 - 18), #rgv); );
);

// ---------- house lamp keys: a coloured lens in a dark well (lit = feathered glow) ----------
function rg_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function rg_rr(x, y, w, h, r) ( rg_rrs(rg_px(x), rg_py(y), rg_ps(w), rg_ps(h), rg_ps(r)); );
function rg_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy, tw, th) (
  hov = rg_in(x, y, w, h);
  hit = rg_click && hov && !rg_drag;
  dn = hov && rg_lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = rg_shade(rg_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rr(x - 4 * k + 2 + i * 1.33, y - 4 * k + 3 + i * 1.67, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  on ? (
    rg_col(c, 0.10); rg_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    rg_col(c, 0.18); rg_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  rg_col(0x141518, 1);           rg_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  rg_col(rg_shade(lens, 0.55), 1); rg_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    rg_col(lens, 1); rg_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;  dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      rg_col(rg_mix(c, 0xFFFFFF, t), 1); rg_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    rg_col(rg_shade(lens, 0.62), 1); rg_rr(x, y, w, h - 1 / sc, 4 * k);
    rg_col(rg_shade(lens, 0.78), 1); rg_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    rg_col(rg_shade(lens, 0.92), 1); rg_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    rg_col(lens, 1);                 rg_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  rg_col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(rg_px(x + 4 * k), rg_py(y), rg_ps(w - 8 * k), max(1, rg_ps(1.5)));
  hov && !dn ? ( rg_col(0xFFFFFF, 0.07); rg_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  rg_col(rg_shade(c, on ? 0.30 : 0.17), 1);
  gfx_measurestr(str, tw, th);  gfx_x = floor(rg_px(x + w * 0.5) - tw * 0.5 + 0.5);  gfx_y = floor(rg_py(y + h * 0.5) - th * 0.58 + 0.5);
  gfx_drawstr(str);
  hit;
);
// a toggle key for a slider
function rg_tog(x, y, w, h, idx, c, str) ( rg_key(x, y, w, h, slider(idx) >= 0.5, c, str) ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1;  rg_touch(idx); ); );
// a radio key: lit when the slider holds v, a click sets it
function rg_rad(x, y, w, h, idx, v, c, str) ( rg_key(x, y, w, h, floor(slider(idx) + 0.5) == v, c, str) ? ( slider(idx) = v;  rg_touch(idx); ); );

// ---------- list helpers, menus ----------
function rg_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function rg_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function rg_menu(x, y, idx, list) local(n, t, i, sel) (
  n = rg_count(list);  t = floor(slider(idx) + 0.5);  strcpy(#rgm, "");  i = 0;
  loop(n, i == t ? strcat(#rgm, "!");  strcat(#rgm, rg_item(list, i + 1, #rgmt));  i < n - 1 ? strcat(#rgm, "|");  i += 1; );
  gfx_x = rg_px(x);  gfx_y = rg_py(y);  sel = gfx_showmenu(#rgm);
  sel > 0 && sel - 1 != t ? ( slider(idx) = sel - 1;  rg_touch(idx); );
);
// a display box (a dark recessed box, light text, its label above): a click opens the menu of its slider's values
function rg_disp(x, y, w, h, idx, list, lbl, sub) local(hov, tw, th) (
  hov = rg_in(x, y, w, h);
  gfx_setfont(5);  rg_col(rg_cink2, 1);  rg_tl(rg_px(x), rg_py(y - 12), lbl);
  rg_col(0x000000, 0.45);  rg_rect(x - 2, y - 2, w + 4, 2);  rg_rect(x - 2, y, 2, h + 2);
  rg_col(0xFFFFFF, 0.12);  rg_rect(x - 2, y + h, w + 4, 2);  rg_rect(x + w, y - 2, 2, h + 2);
  rg_col(0x14120F, 1);  rg_rect(x, y, w, h);
  rg_col(0x000000, 0.5);  rg_rect(x, y, w, 2);  rg_rect(x, y, 2, h);
  hov ? ( rg_col(0xFFFFFF, 0.05);  rg_rect(x, y, w, h); );
  gfx_setfont(7);  rg_col(0xF2E8D2, 1);  rg_tl(rg_px(x + 12), rg_py(y + (strlen(sub) ? h * 0.36 : h * 0.5)), rg_item(list, floor(slider(idx) + 0.5) + 1, #rgd));
  strlen(sub) ? ( gfx_setfont(5);  rg_col(0xC8B898, 1);  rg_tl(rg_px(x + 12), rg_py(y + h * 0.74), sub); );
  rg_col(0xE0A030, 1);
  gfx_triangle(rg_px(x + w - 20), rg_py(y + h * 0.5 - 3), rg_px(x + w - 10), rg_py(y + h * 0.5 - 3), rg_px(x + w - 15), rg_py(y + h * 0.5 + 3));
  rg_click && hov && !rg_drag ? rg_menu(x, y + h + 4, idx, list);
);
// ---------- LCD (the preset bar) ----------
function rg_lcd(x, y, w, h, str) local(tw, th) (
  rg_col(0x000000, 0.6);  rg_rect(x - 2, y - 2, w + 4, h + 4);
  rg_col(0x050302, 1);  rg_rect(x, y, w, h);
  rg_col(0x140D06, 1);  rg_rect(x + 3, y + 3, w - 6, h - 6);
  rg_col(0xFFFFFF, 0.06);  rg_rect(x + 4, y + 4, w - 8, 1);
  gfx_setfont(8);  gfx_measurestr(str, tw, th);
  rg_col(0xFFB347, 0.22);  gfx_x = rg_px(x + 10) - 1;  gfx_y = rg_py(y + h * 0.5) - th * 0.5;  gfx_drawstr(str);
  rg_col(0xFFB347, 1);  gfx_x = rg_px(x + 10);  gfx_y = rg_py(y + h * 0.5) - th * 0.5;  gfx_drawstr(str);
);
function rg_tri(cx, cy, s, dir) ( gfx_triangle(rg_px(cx + dir * s), rg_py(cy), rg_px(cx - dir * s), rg_py(cy - s), rg_px(cx - dir * s), rg_py(cy + s)); );
// ◄ ► keys under a slot's box: step through its choices (wrapping)
function rg_step(x, y, w, idx, n) local(v) (
  v = floor(slider(idx) + 0.5);
  rg_key(x, y, w, 30, 0, 0xE2DCD2, "") ? ( slider(idx) = v <= 0 ? n - 1 : v - 1;  rg_touch(idx); );
  rg_key(x + w + 8, y, w, 30, 0, 0xE2DCD2, "") ? ( slider(idx) = v >= n - 1 ? 0 : v + 1;  rg_touch(idx); );
  rg_col(0x2A2620, 1);  rg_tri(x + w * 0.5, y + 15, 5, -1);  rg_tri(x + w * 1.5 + 8, y + 15, 5, 1);
);
// [PRESETS][<][>][LCD]: h 34, PRESETS 64 wide, arrows 24, 4 px after PRESETS, 2 between the arrows, 6 before the LCD
function rg_pbar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = rg_count(menu);  sel = 0;  open = 0;
  rg_key(x, y + 3, 76, h - 6, 0, 0xE2DCD2, "PRESETS") ? open = 1;
  rg_key(x + 84, y + 3, 26, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  rg_key(x + 114, y + 3, 26, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  rg_col(0x2A2620, 1);  rg_tri(x + 96, y + h * 0.5, 4.5, -1);  rg_tri(x + 128, y + h * 0.5, 4.5, 1);
  lx = x + 150;
  cur >= 1 && cur <= n ? rg_item(menu, cur, #rgpn) : strcpy(#rgpn, "--");
  rg_lcd(lx, y, lw, h, #rgpn);
  rg_click && rg_in(lx, y, lw, h) ? open = 1;
  open ? (
    strcpy(#rgpm, "");  i = 1;
    loop(n, i == cur ? strcat(#rgpm, "!");  strcat(#rgpm, rg_item(menu, i, #rgpt));  i < n ? strcat(#rgpm, "|");  i += 1; );
    gfx_x = rg_px(x);  gfx_y = rg_py(y + h);  i = gfx_showmenu(#rgpm);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- plates ----------
// the chassis's own plate: a recessed tray (a darker lip, an inner shadow top and left drawn as an L, a light edge)
function rg_tray(x, y, w, h, c, title) local(i) (
  rg_col(0x000000, 0.35);  rg_rect(x - 2, y - 2, w + 4, 2);  rg_rect(x - 2, y, 2, h + 2);
  rg_col(0xFFFFFF, 0.10);  rg_rect(x - 2, y + h, w + 4, 2);  rg_rect(x + w, y - 2, 2, h + 2);
  rg_col(c, 1);  rg_rect(x, y, w, h);
  i = 0;  loop(5, rg_col(0x000000, 0.16 - i * 0.03);  rg_rect(x + i, y + i, w - i, 1);  rg_rect(x + i, y + i + 1, 1, h - i - 1);  i += 1; );
  rg_col(0xFFFFFF, 0.08);  rg_rect(x + 1, y + h - 1, w - 1, 1);  rg_rect(x + w - 1, y + 1, 1, h - 2);
  strlen(title) ? ( gfx_setfont(4);  rg_col(rg_cink, 1);  rg_tl(rg_px(x + 16), rg_py(y + 20), title); );
);
// a module's livery (m = 0 Amp Head, 1 Fullerton 65, 2 Mali 120, 3 GR-120): plate, inks, knob style, key colour
function rg_livery(m) (
  m == 0 ? ( rg_plate = 0xC4C7CA; rg_ink = 0x17181A; rg_ink2 = 0x45474B; rg_acc = 0xB8322A; rg_ks = 1; rg_kc = 0xF2A41E; ) :
  m == 1 ? ( rg_plate = 0x1B1C1E; rg_ink = 0xF0EBDD; rg_ink2 = 0xBDB6A6; rg_acc = 0xE24A3A; rg_ks = 2; rg_kc = 0xF4EBC4; ) :
  m == 2 ? ( rg_plate = 0x1F2125; rg_ink = 0xF2F4F6; rg_ink2 = 0xAEB4BC; rg_acc = 0x3C96F0; rg_ks = 3; rg_kc = 0x6AB4F4; ) :
           ( rg_plate = 0x3E2939; rg_ink = 0xF2C455; rg_ink2 = 0xC9A040; rg_acc = 0xF2C455; rg_ks = 4; rg_kc = 0xF2C230; );
);
// a module plate in its livery, with its own name and a subtitle; a small rivet in each corner
function rg_module(x, y, w, h, m, name, sub) local(i, tw, th) (
  rg_livery(m);
  i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(x + 2 + i * 1.33, y + 3 + i * 1.67, w + i * 0.6, h + i * 0.6);  i += 1; );
  rg_col(rg_plate, 1);  rg_rect(x, y, w, h);
  m == 0 ? (                                                   // brushed metal: fine horizontal lines, the red pinstripe
    i = 0;  loop(h / 2, rg_col(i % 3 ? 0xFFFFFF : 0x000000, 0.035);  rg_rect(x, y + i * 2, w, 1);  i += 1; );
    rg_col(rg_acc, 1);  rg_rect(x + 4, y + h - 9, w - 8, 2);
  ) : m == 2 ? (                                               // the Mali's silver frame
    rg_col(0xC9CDD3, 0.85);  rg_rect(x + 5, y + 5, w - 10, 2);  rg_rect(x + 5, y + h - 7, w - 10, 2);
    rg_rect(x + 5, y + 5, 2, h - 10);  rg_rect(x + w - 7, y + 5, 2, h - 10);
  ) : m == 3 ? (                                               // the GR-120's gold rule under its title band
    rg_col(rg_acc, 0.6);  rg_rect(x + 16, y + 34, w - 32, 1);
  ) : (                                                        // the Fullerton's thin light rule
    rg_col(0xFFFFFF, 0.12);  rg_rect(x + 16, y + 34, w - 32, 1);
  );
  // depth: a narrow darker bottom / right edge, a light top / left one
  rg_col(0x000000, 0.25);  rg_rect(x, y + h - 2, w, 2);  rg_rect(x + w - 2, y, 2, h - 2);
  rg_col(0xFFFFFF, m == 0 ? 0.5 : 0.10);  rg_rect(x, y, w - 2, 1);  rg_rect(x, y + 1, 1, h - 3);
  rg_col(rg_shade(rg_plate, m == 0 ? 0.7 : 1.9), 1);
  gfx_circle(rg_px(x + 8), rg_py(y + 8), rg_ps(2.5), 1, 1);  gfx_circle(rg_px(x + w - 8), rg_py(y + 8), rg_ps(2.5), 1, 1);
  gfx_circle(rg_px(x + 8), rg_py(y + h - 8), rg_ps(2.5), 1, 1);  gfx_circle(rg_px(x + w - 8), rg_py(y + h - 8), rg_ps(2.5), 1, 1);
  gfx_setfont(4);  rg_col(rg_ink, 1);  rg_tl(rg_px(x + 20), rg_py(y + 20), name);
  gfx_measurestr(name, tw, th);
  gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tl(rg_px(x + 20) + tw + rg_ps(12), rg_py(y + 21), sub);
);
// a thin inked line splitting a plate into parts
function rg_div(x, y0, y1) ( rg_col(0x000000, 0.35);  rg_rect(x, y0, 1, y1 - y0);  rg_col(0xFFFFFF, 0.14);  rg_rect(x + 1, y0, 1, y1 - y0); );
function rg_sub(x, y, str) ( gfx_setfont(6);  rg_col(rg_ink, 1);  rg_tl(rg_px(x), rg_py(y), str); );
function rg_small(x, y, str) ( gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tc(rg_px(x), rg_py(y), str); );
// dims a switched-off part (the plate's colour at about half over it)
function rg_dim(x, y, w, h) ( rg_col(rg_plate, 0.5);  rg_rect(x, y, w, h); );

// Labels in the house font, Trebuchet MS bold, sized by width (as ui_fitfont: "THRESHOLD" = 5.28 x the size) so they
// read the same size on every system. Re-measured when the scale changes.
function rg_fit(idx, size) local(fs, w, h, target) (
  target = 5.28 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, "Trebuchet MS", fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);

// ---------- frame setup ----------
rg_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
rg_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;                         // S / M / L
sc = rg_ret * max(min(rg_want, min(gfx_w / (1080 * rg_ret), gfx_h / (660 * rg_ret))), 0.5);
ui_tf = sc < (gfx_ext_retina > 1 ? gfx_ext_retina : 1) ? min(sqrt((gfx_ext_retina > 1 ? gfx_ext_retina : 1) / sc), 1.15) : 1;   // text shrinks half as fast as the panel below M (JG, 30 Oct 2026; at most 15 % bigger)
rg_ox = (gfx_w - 1080 * sc) * 0.5;
rg_oy = (gfx_h - 660 * sc) * 0.5;
rg_lmb = mouse_cap & 1;
rg_click = rg_lmb && !rg_llmb;
// while the ? pop-up is open, it takes the clicks (the panel under it doesn't)
rg_hclick = rg_help ? rg_click : 0;
rg_help ? ( rg_click = 0;  mouse_wheel = 0; );
rg_kstep = 0;  rg_kdim = 0;  rg_kzero = 0;
sc != rg_fsc ? (
  rg_fsc = sc;
  rg_f1 = rg_fit(1, rg_ps(30));     // title
  rg_f10 = rg_fit(10, (rg_ps(12)) * max(ui_tf, 1));   // header subtitle
  rg_f2 = rg_fit(2, (rg_ps(15)) * max(ui_tf, 1));     // key legends
  rg_f3 = rg_fit(3, (rg_ps(14)) * max(ui_tf, 1));     // hover values
  rg_f4 = rg_fit(4, rg_ps(18));     // plate titles
  rg_f5 = rg_fit(5, (rg_ps(13)) * max(ui_tf, 1));     // small print
  rg_f6 = rg_fit(6, (rg_ps(16)) * max(ui_tf, 1));     // knob labels, part titles
  rg_f7 = rg_fit(7, rg_ps(17));     // display boxes
);
gfx_setfont(1, "Trebuchet MS", rg_f1, 'b');  gfx_setfont(10, "Trebuchet MS", rg_f10, 'b');
gfx_setfont(2, "Trebuchet MS", rg_f2, 'b');  gfx_setfont(3, "Trebuchet MS", rg_f3, 'b');
gfx_setfont(4, "Trebuchet MS", rg_f4, 'b');  gfx_setfont(5, "Trebuchet MS", rg_f5, 'b');
gfx_setfont(6, "Trebuchet MS", rg_f6, 'b');  gfx_setfont(7, "Trebuchet MS", rg_f7, 'b');
gfx_setfont(8, "Courier New", rg_ps(20), 'b');

// the chassis colours
rg_chas = 0x3A2322;  rg_tray0 = 0x482C2A;  rg_cink = 0xEDE4D0;  rg_cink2 = 0xB9AE98;   // oxblood (JG: each Ramp its own colour)
PRESET_MENU = "Init|Fullerton Clean|Mali Chorus|Head Crunch|GR Doom|GR Lead|Black Panel Crunch|Chorus Stack|Fizz Wall|Surf Trem|Vibrato Drive|Small Box Lead|Ambient Clean";
PRE_LIST = "Amp Head|Fullerton 65|Mali 120|GR-120";
CAB_LIST = "Line out|2x12 open|4x12 closed|2x12 open|2x12|2x8|4x12 closed";

// ---------- the chassis ----------
rg_col(rg_chas, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
rg_col(0x141312, 1);  rg_rect(0, 0, 1080, 58);
rg_col(0x000000, 1);  rg_rect(0, 58, 1080, 3);  rg_col(0xE0A030, 1);  rg_rect(0, 61, 1080, 1);
rg_col(rg_shade(rg_chas, 0.7), 1);  rg_rect(0, 657, 1080, 3);  rg_rect(1077, 62, 3, 598);
rg_rivet(8, 70);  rg_rivet(1072, 70);  rg_rivet(8, 651);  rg_rivet(1072, 651);
gfx_setfont(1);  rg_col(0xF4EEDF, 1);  rg_tl(rg_px(24), rg_py(23), "RAMP");
gfx_setfont(10);  rg_col(0xE0A030, 1);  rg_tl(rg_px(26), rg_py(46), "MODULAR GUITAR AMP"); ver_tag_at("v3", 16, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1);
gfx_setfont(4);  rg_col(0xE0A030, 1);  rg_tl(rg_px(150), rg_py(24), "GFX");

rg_k = rg_pbar(330, 12, 34, 300, pr_cur, PRESET_MENU);
rg_k > 0 ? ( prs_dirty = (rg_k);  pr_cur = rg_k; );

// ================================================================ PREAMP
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 74, 180, 210, rg_tray0, "PREAMP");
rg_p = floor(slider1 + 0.5);
rg_disp(28, 128, 156, 48, 1, PRE_LIST, "MODULE",
  rg_p == 0 ? "ALL VALVE" : rg_p == 1 ? "BLACK PANEL" : rg_p == 2 ? "SOLID STATE" : "CASCADED VALVE");
gfx_setfont(5);  rg_col(rg_cink2, 1);
rg_step(28, 188, 74, 1, 4);

rg_x0 = 208;  rg_y0 = 74;
rg_p == 0 ? (
  rg_module(rg_x0, rg_y0, 856, 210, 0, "AMP HEAD", "PREAMP  -  ALL VALVE");
  rg_kn(rg_x0 + 90, rg_y0 + 124, 28, rpi(18), 0, 10, 5, rg_ks, 0, "GAIN", "%.1f");
  rg_tog(rg_x0 + 168, rg_y0 + 82, 84, 28, rpi(19), rg_kc, "BRIGHT");
  rg_tog(rg_x0 + 168, rg_y0 + 128, 84, 28, rpi(20), rg_kc, "DRIVE");
  rg_kn(rg_x0 + 340, rg_y0 + 124, 24, rpi(21), 0, 10, 5, rg_ks, 0, "BASS", "%.1f");
  rg_kn(rg_x0 + 440, rg_y0 + 124, 24, rpi(22), 0, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
  rg_kn(rg_x0 + 540, rg_y0 + 124, 24, rpi(23), 0, 10, 5, rg_ks, 0, "TREBLE", "%.1f");
  rg_div(rg_x0 + 630, rg_y0 + 50, rg_y0 + 186);
  rg_kn(rg_x0 + 730, rg_y0 + 124, 24, rpi(24), 0, 10, 2, rg_ks, 0, "REVERB", "%.1f");
) : rg_p == 1 ? (
  rg_module(rg_x0, rg_y0, 856, 210, 1, "FULLERTON 65", "PREAMP  -  BLACK PANEL");
  rg_c = slider(rpi(27)) >= 0.5;  rg_j = slider(rpi(28)) >= 0.5;
  // NORMAL (top row), VIBRATO (bottom row): the channel keys pick the input; JUMPER feeds both
  rg_key(rg_x0 + 20, rg_y0 + 66, 100, 28, !rg_c || rg_j, rg_kc, "NORMAL") ? ( slider(rpi(27)) = 0;  rg_touch(rpi(27)); );
  rg_key(rg_x0 + 20, rg_y0 + 140, 100, 28, rg_c || rg_j, rg_kc, "VIBRATO") ? ( slider(rpi(27)) = 1;  rg_touch(rpi(27)); );
  rg_kdim = rg_c && !rg_j;  rg_kn(rg_x0 + 170, rg_y0 + 80, 18, rpi(29), 1, 10, 4, rg_ks, 0, "VOLUME", "%.1f");
  rg_kdim = rg_c && !rg_j;  rg_kn(rg_x0 + 246, rg_y0 + 80, 18, rpi(30), 1, 10, 6, rg_ks, 0, "TREBLE", "%.1f");
  rg_kdim = rg_c && !rg_j;  rg_kn(rg_x0 + 322, rg_y0 + 80, 18, rpi(31), 1, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
  rg_kdim = rg_c && !rg_j;  rg_kn(rg_x0 + 398, rg_y0 + 80, 18, rpi(32), 1, 10, 4, rg_ks, 0, "BASS", "%.1f");
  rg_tog(rg_x0 + 446, rg_y0 + 66, 80, 28, rpi(33), rg_kc, "BRIGHT");
  rg_kdim = !rg_c && !rg_j;  rg_kn(rg_x0 + 170, rg_y0 + 154, 18, rpi(34), 1, 10, 4, rg_ks, 0, "VOLUME", "%.1f");
  rg_kdim = !rg_c && !rg_j;  rg_kn(rg_x0 + 246, rg_y0 + 154, 18, rpi(35), 1, 10, 6, rg_ks, 0, "TREBLE", "%.1f");
  rg_kdim = !rg_c && !rg_j;  rg_kn(rg_x0 + 322, rg_y0 + 154, 18, rpi(36), 1, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
  rg_kdim = !rg_c && !rg_j;  rg_kn(rg_x0 + 398, rg_y0 + 154, 18, rpi(37), 1, 10, 4, rg_ks, 0, "BASS", "%.1f");
  rg_tog(rg_x0 + 446, rg_y0 + 140, 80, 28, rpi(38), rg_kc, "BRIGHT");
  rg_div(rg_x0 + 548, rg_y0 + 50, rg_y0 + 196);
  // the vibrato channel's reverb and tremolo
  rg_kdim = !rg_c && !rg_j;  rg_kn(rg_x0 + 606, rg_y0 + 80, 18, rpi(39), 1, 10, 3, rg_ks, 0, "REVERB", "%.1f");
  rg_kdim = !rg_c && !rg_j;  rg_kn(rg_x0 + 690, rg_y0 + 80, 18, rpi(40), 1, 10, 5, rg_ks, 0, "SPEED", "%.1f");
  rg_kdim = !rg_c && !rg_j;  rg_kn(rg_x0 + 780, rg_y0 + 80, 18, rpi(41), 1, 10, 1, rg_ks, 0, "INTENSITY", "%.1f");
  rg_tog(rg_x0 + 570, rg_y0 + 140, 100, 28, rpi(28), rg_kc, "JUMPER");
  rg_tog(rg_x0 + 682, rg_y0 + 140, 150, 28, rpi(42), rg_kc, "STEREO TREM");
) : rg_p == 2 ? (
  rg_module(rg_x0, rg_y0, 856, 210, 2, "MALI 120", "PREAMP  -  SOLID STATE");
  rg_c = floor(slider(rpi(44)) + 0.5);
  // INPUT (normal / effect / both), NORMAL channel (top row), EFFECT channel (bottom row)
  rg_small(rg_x0 + 62, rg_y0 + 52, "INPUT");
  rg_rad(rg_x0 + 20, rg_y0 + 68, 84, 26, rpi(44), 0, rg_kc, "NORMAL");
  rg_rad(rg_x0 + 20, rg_y0 + 108, 84, 26, rpi(44), 1, rg_kc, "EFFECT");
  rg_rad(rg_x0 + 20, rg_y0 + 148, 84, 26, rpi(44), 2, rg_kc, "BOTH");
  rg_tog(rg_x0 + 120, rg_y0 + 66, 76, 28, rpi(49), rg_kc, "BRIGHT");
  rg_kdim = rg_c == 1;  rg_kn(rg_x0 + 260, rg_y0 + 80, 18, rpi(45), 0, 10, 5, rg_ks, 0, "VOLUME", "%.1f");
  rg_kdim = rg_c == 1;  rg_kn(rg_x0 + 356, rg_y0 + 80, 18, rpi(46), 0, 10, 5, rg_ks, 0, "TREBLE", "%.1f");
  rg_kdim = rg_c == 1;  rg_kn(rg_x0 + 452, rg_y0 + 80, 18, rpi(47), 0, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
  rg_kdim = rg_c == 1;  rg_kn(rg_x0 + 548, rg_y0 + 80, 18, rpi(48), 0, 10, 5, rg_ks, 0, "BASS", "%.1f");
  rg_tog(rg_x0 + 120, rg_y0 + 140, 76, 28, rpi(54), rg_kc, "BRIGHT");
  rg_kdim = rg_c == 0;  rg_kn(rg_x0 + 260, rg_y0 + 154, 18, rpi(50), 0, 10, 5, rg_ks, 0, "VOLUME", "%.1f");
  rg_kdim = rg_c == 0;  rg_kn(rg_x0 + 356, rg_y0 + 154, 18, rpi(51), 0, 10, 5, rg_ks, 0, "TREBLE", "%.1f");
  rg_kdim = rg_c == 0;  rg_kn(rg_x0 + 452, rg_y0 + 154, 18, rpi(52), 0, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
