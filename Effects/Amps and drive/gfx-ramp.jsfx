rg_kdim = slider46 < 0.5;  rg_kn(556, 436, 18, 48, 1, 10, 5, 0, 0xB8322A, "INTENSITY", "%.1f");
slider46 < 0.5 ? rg_dim(430, 374, 176, 34);
