  rg_kn(rg_x0 + 290, rg_y0 + 68, 18, 5, 0, 100, 100, rg_ks, 0, "WIDTH", "%.0f %%");
  rg_cb == 1 || rg_cb == 2 || rg_cb == 6 ? rg_small(rg_x0 + 228, rg_y0 + 126, "ON - OFF AXIS");
) : (
