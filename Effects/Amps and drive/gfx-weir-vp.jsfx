desc:Weir VP [voicing preamp] (GFX)
//tags: preamp voicing drive overdrive equaliser parametric transformer guitar bass
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui, gfx-panel, gfx-os, gfx-bypass, gfx-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-20,20,0.1>-Input (dB)
slider3:0<0,1,1{Off,On}>-Line pad
slider4:0<-15,15,0.1>-Bass (dB)
slider5:0<-15,15,0.1>-Treble (dB)
slider6:0<-15,15,0.1>-Low gain (dB)
slider7:110<30,240,1>-Low freq (Hz)
slider8:0<-15,15,0.1>-Low-mid gain (dB)
slider9:330<100,800,1>-Low-mid freq (Hz)
slider10:0<-15,15,0.1>-Hi-mid gain (dB)
slider11:1100<450,3600,1>-Hi-mid freq (Hz)
slider12:0<-15,15,0.1>-Hi gain (dB)
slider13:3300<1200,9600,1>-Hi freq (Hz)
slider14:1<0,2,1{Clean,Voice,Both}>-Channel
slider15:0<-30,10,0.1>-Clean level (dB)
slider16:18<0,40,0.1>-Drive (dB)
slider17:50<0,100,1>-Iron (%)
slider18:0<-30,10,0.1>-Voice level (dB)
slider19:0<0,1,1{Before voice,After voice}>-EQ position
slider20:0<-30,10,0.1>-Master (dB)
slider21:50<0,100,1>-Drift (%)
slider22:1<0,2,1{1x,2x,4x}>-Oversampling
slider23:prs_sel=0<0,9,1{No preset,Init,Bite and Sizzle,Bass Grind,Studio Clean,Nasal Lead,Blend Bass,Heavy Iron,Post Carve,Line Keys}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc
import gfx-power.jsfx-inc

@init
#ui_man = "gfx-weir-vp";
ext_noinit = 1;

LD_CF = 100;
LD_ST = 140;
LD_GL = 170;
LD_CD = 1000;
LD_PT = 1200;

function ld_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function ld_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function ld_db(d) ( exp(d * 0.11512925464970228); );
function ld_t(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

function ld_bq(b, f, g) local(av, w, s, c, al, q, a0, o) (
  av = exp(g * 0.05756462732485114); w = 2 * $pi * min(f, 0.45 * srate) / srate; s = sin(w); c = cos(w);
  q = 0.6 + 0.07 * abs(g); al = s / (2 * q); a0 = 1 + al / av; o = LD_CF + b * 5;
  o[0] = (1 + al * av) / a0; o[1] = -2 * c / a0; o[2] = (1 - al * av) / a0; o[3] = -2 * c / a0; o[4] = (1 - al / av) / a0;
);
function ld_bqr(b, ch, x) local(o, s, y) (
  o = LD_CF + b * 5; s = LD_ST + b * 4 + ch * 2;
  y = o[0] * x + s[0]; s[0] = o[1] * x - o[3] * y + s[1]; s[1] = o[2] * x - o[4] * y; y;
);
function ld_eq(ch, x) local(b) ( b = 0; loop(4, LD_GL[b * 4 + 0] != 0 || LD_GL[b * 4 + 2] != 0 ? x = ld_bqr(b, ch, x); b += 1; ); x; );
function ld_eqclr() ( memset(LD_ST, 0, 16); );
function ld_eqglide() local(b, o, g, f) (
  b = 0;
  loop(4, o = LD_GL + b * 4;
    g = o[0] + (o[2] - o[0]) * ld_k16; abs(g - o[2]) < 0.005 ? g = o[2];
    f = o[1] + (o[3] - o[1]) * ld_k16; abs(f - o[3]) < 0.0005 ? f = o[3];
    (g != o[0] || f != o[1] || ld_eqfix) ? ( o[0] = g; o[1] = f; ld_bq(b, exp(f), g); );
    g == 0 ? ( LD_ST[b * 4] = LD_ST[b * 4 + 1] = LD_ST[b * 4 + 2] = LD_ST[b * 4 + 3] = 0; );
    b += 1; );
  ld_eqfix = 0;
);
function ld_shc(g, fc) local(t, v) ( v = ld_db(g); t = tan($pi * fc / srate); g >= 0 ? (t - 1) / (t + 1) : (t - v) / (t + v); );
function ld_shh(g, fc) local(t, v) ( v = ld_db(g); t = tan($pi * fc / srate); g >= 0 ? (t - 1) / (t + 1) : (t * v - 1) / (t * v + 1); );

function ld_vc(x) instance(ph) local(y, f) (
  x = 4 * ld_t(x * 0.25);
  y = (ld_t(x * ld_hd + ld_bs) - ld_t0) / ld_hd;
  ph += ld_ik * (y - ph);
  f = ph * ld_fs;
  y - (f - ld_t(f + ld_rm) + ld_t1) / ld_fs;
);
function ld_vclr() ( voL.ph = voR.ph = 0; );
function ld_os(xl, xr) ( ld_pl = voL.ld_vc(xl); ld_pr = voR.ld_vc(xr); );

function ld_clear() ( uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); ld_vclr(); memset(LD_CD, 0, 128); );
function ld_reset() (
  ld_clear(); ld_eqclr(); memset(BY_BUF, 0, 2 * BY_N);
  ld_dxl = ld_dyl = ld_dxr = ld_dyr = 0; ld_hpl = ld_hpr = 0;
  ld_l1l = ld_l2l = ld_l1r = ld_l2r = 0; ld_al = ld_ar = ld_bl = ld_br = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  ld_fi = 0;
);

#ld_pm = "Init|Bite and Sizzle|Bass Grind|Studio Clean|Nasal Lead|Blend Bass|Heavy Iron|Post Carve|Line Keys";
function ld_w(v) ( LD_PT[ld_wi] = v; ld_wi += 1; );
function ld_row(p, inp, ln, bs, tr, lg, lf, mg, mf, hg, hf, ig, iff) ( ld_wi = (p - 1) * 20; ld_w(inp); ld_w(ln); ld_w(bs); ld_w(tr);
  ld_w(lg); ld_w(lf); ld_w(mg); ld_w(mf); ld_w(hg); ld_w(hf); ld_w(ig); ld_w(iff); );
function ld_row2(ch, cl, dr, ir, vl, eq, ms) ( ld_w(ch); ld_w(cl); ld_w(dr); ld_w(ir); ld_w(vl); ld_w(eq); ld_w(ms); );
ld_row(1,    0,   0,   0,   0,    0,  110,   0,  330,    0, 1100,  0, 3300); ld_row2(1,   0,  18,  50,   0, 0,  0);
ld_row(2,    0,   0,  -3,   4,   -4,  110,  -6,  440,    6, 2200,  5, 4400); ld_row2(1,   0,  28,  40,   0, 0,  0);
ld_row(3,    0,   0,   4,  -2,    5,   55,  -4,  330,    3,  880, -3, 3300); ld_row2(2,  -6,  24,  70,  -2, 0,  0);
ld_row(4,    0,   0,   2,   2,    0,  110,  -2,  330,    0, 1100,  2, 5500); ld_row2(0,   0,  10,  30,   0, 0,  0);
ld_row(5,    0,   0,  -4,   0,   -6,  110,   0,  550,    9, 1100, -4, 6600); ld_row2(1,   0,  34,  50,  -2, 0,  0);
ld_row(6,    0,   0,   3,   0,    3,   77,  -3,  220,    4, 1100,  0, 3300); ld_row2(2,  -2,  30,  60,  -8, 0,  0);
ld_row(7,    3,   0,   6,  -3,    4,   66,   0,  330,   -3, 1100,  0, 3300); ld_row2(1,   0,  32, 100,  -1, 0,  0);
ld_row(8,    0,   0,   0,   0,   -8,  220,  10,  770,  -10, 2200,  6, 7700); ld_row2(1,   0,  36,  50,  -3, 1,  0);
ld_row(9,    0,   1,   2,   3,    0,  110,  -3,  440,    3, 2200,  2, 6600); ld_row2(2,  -4,  16,  40,  -8, 0,  4);
function load_preset(p) local(i) (
  p >= 1 && p <= 9 ? ( i = 2; loop(19, slider(i) = LD_PT[(p - 1) * 20 + i - 2]; i += 1; ); );
  p == 10 ? ( i = 2; loop(19, slider(i) = LD_PT[i - 2]; i += 1; ); slider21 = 50; );
  i = 2; loop(20, ui_auto(i); i += 1; );
  pr_cur = p == 10 ? 1 : p;
);

function ld_srinit() local(w, s, c, al, a0) (
  ld_sr = srate;
  c_kn = ld_tc(30); c_sw = ld_tc(15);
  ld_k16 = 1 - exp(-16 / (0.03 * srate));
  ld_dcc = 1 - 2 * $pi * 5 / srate;
  ld_hpk = 1 - exp(-2 * $pi * 33 / srate);
  w = 2 * $pi * min(8800, 0.45 * srate) / srate; s = sin(w); c = cos(w); al = s / (2 * 0.85); a0 = 1 + al;
  ld_lb0 = (1 - c) * 0.5 / a0; ld_lb1 = (1 - c) / a0; ld_la1 = -2 * c / a0; ld_la2 = (1 - al) / a0;
  ld_fis = 1 / (0.01 * srate);
  ld_dks = 1 / (0.005 * srate);
  ost_init(0);
  ld_clear(); ld_eqclr(); ld_eqfix = 1;
);
os_design();
os_f = os_tf = os_f2n(slider22); os_base = 0;
ld_srinit();
os_gsetup();
in_init();
dSup.drift_init(0.8 + rand(1) * 0.4); dBi.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
ld_rm = 0.15; ld_t1 = ld_t(ld_rm);
ld_snap = 1; ld_fi = 1; ld_dk = 1; ld_ord = slider19 >= 0.5;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_hum_db = -84; pwr_sag = 0.35; pwr_wu_loss = 0.5; pwr_wu_drv = 1.2; pwr_wu_lp = 12000; pwr_wu_wob = 0.25; pwr_bloom = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(23, i != 23 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(22));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != ld_sr ? ld_srinit();
ld_now = time_precise();
ld_tp > 0 && ld_now - ld_tp > max(0.25, 4 * samplesblock / srate) ? ld_reset();
ld_tp = ld_now;
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider22); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
pwr_block(slider1 < 0.5);
drift_macro(slider21);
ld_bn = samplesblock / srate;
ld_vs = dSup.drift_tick(0.05 * dm_s * ld_bn); ld_vb = dBi.drift_tick(0.04 * dm_s * ld_bn);
ld_hdt = ld_db(0.6 * dm_a * ld_vs);
ld_bst = 0.07 + 0.03 * dm_a * ld_vb;
ld_igt = ld_db(min(max(slider2, -20), 20) - (slider3 >= 0.5 ? 12 : 0));
ld_gbt = min(max(slider4, -15), 15); ld_gtt = min(max(slider5, -15), 15);
ld_b = 0;
loop(4, LD_GL[ld_b * 4 + 2] = min(max(slider(6 + ld_b * 2), -15), 15);
  LD_GL[ld_b * 4 + 3] = log(min(max(slider(7 + ld_b * 2), 20), 20000)); ld_b += 1; );
ld_snap ? ( ld_b = 0; loop(4, LD_GL[ld_b * 4] = LD_GL[ld_b * 4 + 2]; LD_GL[ld_b * 4 + 1] = LD_GL[ld_b * 4 + 3]; ld_b += 1; ); ld_eqfix = 1; );
ld_ch = slider14 | 0;
ld_cot = (ld_ch == 0 || ld_ch == 2) * ld_db(min(max(slider15, -30), 10));
ld_vot = (ld_ch >= 1) * ld_db(min(max(slider18, -30), 10));
ld_dr = min(max(slider16, 0), 40);
ld_dgt = ld_db(ld_dr); ld_mut = ld_db(-26 * (1 - exp(-ld_dr / 18)));
ld_fst = 0.4 + 5.6 * min(max(slider17, 0), 100) / 100;
ld_ordt = slider19 >= 0.5;
ld_mst = ld_db(min(max(slider20, -30), 10));
ld_ik = 1 - exp(-2 * $pi * 120 / (srate * os_f));
ld_snap ? ( ld_ig = ld_igt; ld_gb = ld_gbt; ld_gt = ld_gtt; ld_co = ld_cot; ld_vo = ld_vot; ld_dg = ld_dgt; ld_mu = ld_mut;
  ld_fs = ld_fst; ld_ms = ld_mst; ld_hd = ld_hdt; ld_bs = ld_bst; ld_ord = ld_ordt; );
ld_snap = 0;
ld_hpl = ld_tn(ld_hpl); ld_hpr = ld_tn(ld_hpr); ld_al = ld_tn(ld_al); ld_ar = ld_tn(ld_ar); ld_bl = ld_tn(ld_bl); ld_br = ld_tn(ld_br);
ld_l1l = ld_tn(ld_l1l); ld_l2l = ld_tn(ld_l2l); ld_l1r = ld_tn(ld_l1r); ld_l2r = ld_tn(ld_l2r);
ld_b = 0; loop(16, LD_ST[ld_b] = ld_tn(LD_ST[ld_b]); ld_b += 1; );
voL.ph = ld_tn(voL.ph); voR.ph = ld_tn(voR.ph);
ld_ol_d = max(ld_ol_d, ld_ol); ld_or_d = max(ld_or_d, ld_or); ld_ol = ld_or = 0;
ld_pk_d = max(ld_pk_d, ld_pkb); ld_pkb = 0;
os_snapb(slider(22));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
ld_ig += (ld_igt - ld_ig) * c_kn; ld_dg += (ld_dgt - ld_dg) * c_kn; ld_mu += (ld_mut - ld_mu) * c_kn;
ld_co += (ld_cot - ld_co) * c_sw; ld_vo += (ld_vot - ld_vo) * c_sw; ld_ms += (ld_mst - ld_ms) * c_kn;
ld_fs += (ld_fst - ld_fs) * c_kn; ld_hd += (ld_hdt - ld_hd) * c_kn; ld_bs += (ld_bst - ld_bs) * c_kn;
ld_t0 = ld_t(ld_bs);
(ld_cr -= 1) <= 0 ? (
  ld_cr = 16;
  ld_gb += (ld_gbt - ld_gb) * ld_k16; abs(ld_gb - ld_gbt) < 0.005 ? ld_gb = ld_gbt;
  ld_gt += (ld_gtt - ld_gt) * ld_k16; abs(ld_gt - ld_gtt) < 0.005 ? ld_gt = ld_gtt;
  ld_cb = ld_shc(ld_gb, 66); ld_hb = ld_db(ld_gb) - 1;
  ld_ct = ld_shh(ld_gt, 3300); ld_ht = ld_db(ld_gt) - 1;
  ld_eqglide();
);
ld_xl = in_l * ld_ig; ld_xr = in_r * ld_ig;
ld_z = ld_cb * ld_xl + ld_al; ld_al = ld_xl - ld_cb * ld_z; ld_xl += ld_hb * 0.5 * (ld_xl + ld_z);
ld_z = ld_cb * ld_xr + ld_ar; ld_ar = ld_xr - ld_cb * ld_z; ld_xr += ld_hb * 0.5 * (ld_xr + ld_z);
ld_z = ld_ct * ld_xl + ld_bl; ld_bl = ld_xl - ld_ct * ld_z; ld_xl += ld_ht * 0.5 * (ld_xl - ld_z);
ld_z = ld_ct * ld_xr + ld_br; ld_br = ld_xr - ld_ct * ld_z; ld_xr += ld_ht * 0.5 * (ld_xr - ld_z);
ld_ord != ld_ordt ? ( ld_dk -= ld_dks; ld_dk <= 0 ? ( ld_dk = 0; ld_ord = ld_ordt; ld_eqclr(); ); ) : ld_dk < 1 ? ld_dk = min(ld_dk + ld_dks, 1);
!ld_ord ? ( ld_xl = ld_eq(0, ld_xl); ld_xr = ld_eq(1, ld_xr); );
abs(ld_xl) < 0.000000000000001 ? ld_xl = 0; abs(ld_xr) < 0.000000000000001 ? ld_xr = 0;
pwr_in(ld_xl, ld_xr); ld_xl = pwr_l; ld_xr = pwr_r;
ld_cw = (ld_cw + 1) & 63; LD_CD[ld_cw] = ld_xl; LD_CD[64 + ld_cw] = ld_xr;
ld_ci = (ld_cw - os_lat(os_f)) & 63; ld_cl = LD_CD[ld_ci]; ld_cr2 = LD_CD[64 + ld_ci];
ld_hpl += ld_hpk * (ld_xl - ld_hpl); ld_hpr += ld_hpk * (ld_xr - ld_hpr);
ld_vl = (ld_xl - ld_hpl) * ld_dg; ld_vr = (ld_xr - ld_hpr) * ld_dg;
ld_pkb = max(ld_pkb, max(abs(ld_vl), abs(ld_vr)) * ld_hd);
os_gate();
os_chg ? ( ld_clear(); os_hold += 2 * samplesblock; );
uxL.os_up(ld_vl); uxR.os_up(ld_vr);
os_f == 1 ? (
  ld_os(uxL.s0, uxR.s0); ld_yl = ld_pl; ld_yr = ld_pr;
) : (
  ld_os(uxL.s0, uxR.s0); ld_a0 = ld_pl; ld_b0 = ld_pr;
  ld_os(uxL.s1, uxR.s1); ld_a1 = ld_pl; ld_b1 = ld_pr;
  os_f == 2 ? ( ld_yl = dnL.os_dn(ld_a0, ld_a1, 0, 0); ld_yr = dnR.os_dn(ld_b0, ld_b1, 0, 0); ) : (
    ld_os(uxL.s2, uxR.s2); ld_a2 = ld_pl; ld_b2 = ld_pr;
    ld_os(uxL.s3, uxR.s3); ld_a3 = ld_pl; ld_b3 = ld_pr;
    ld_yl = dnL.os_dn(ld_a0, ld_a1, ld_a2, ld_a3); ld_yr = dnR.os_dn(ld_b0, ld_b1, ld_b2, ld_b3);
  );
);
ld_z = ld_yl - ld_dxl + ld_dcc * ld_dyl; ld_dxl = ld_yl; ld_dyl = ld_z; ld_yl = ld_z;
ld_z = ld_yr - ld_dxr + ld_dcc * ld_dyr; ld_dxr = ld_yr; ld_dyr = ld_z; ld_yr = ld_z;
ld_z = ld_lb0 * ld_yl + ld_l1l; ld_l1l = ld_lb1 * ld_yl - ld_la1 * ld_z + ld_l2l; ld_l2l = ld_lb0 * ld_yl - ld_la2 * ld_z; ld_yl = ld_z;
ld_z = ld_lb0 * ld_yr + ld_l1r; ld_l1r = ld_lb1 * ld_yr - ld_la1 * ld_z + ld_l2r; ld_l2r = ld_lb0 * ld_yr - ld_la2 * ld_z; ld_yr = ld_z;
ld_yl = ld_cl * ld_co + ld_yl * ld_mu * ld_vo;
ld_yr = ld_cr2 * ld_co + ld_yr * ld_mu * ld_vo;
ld_ord ? ( ld_yl = ld_eq(0, ld_yl); ld_yr = ld_eq(1, ld_yr); );
ld_z = ld_dk * ld_dk * (3 - 2 * ld_dk);
ld_yl *= ld_z; ld_yr *= ld_z;
pwr_out(ld_yl, ld_yr); ld_yl = pwr_l; ld_yr = pwr_r;
ld_osg = os_g * os_g * (3 - 2 * os_g);
ld_yl *= ld_ms * ld_osg; ld_yr *= ld_ms * ld_osg;
ld_yl != ld_yl ? ld_yl = 0; ld_yr != ld_yr ? ld_yr = 0;
ld_fi < 1 ? (
  ld_fi = min(ld_fi + ld_fis, 1); ld_z = ld_fi * ld_fi * (3 - 2 * ld_fi);
  ld_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; ld_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  ld_yl = ld_a + ld_z * (ld_yl - ld_a); ld_yr = ld_b + ld_z * (ld_yr - ld_b);
);
ost_out(ld_yl, ld_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
ld_ol = max(ld_ol, abs(spl0)); ld_or = max(ld_or, abs(spl1));

@gfx 1080 524
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
function ver_tag_hold(s, slot, dy) local(th) (
  th = gfx_texth; strcpy(#vt_s, s); vt_slot = slot; vt_xr = gfx_x; vt_yb = gfx_y + (0.8 + dy) * th;
