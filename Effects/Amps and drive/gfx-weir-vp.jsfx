function ld_v2n(v, lo, hi, lg) ( min(max(lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo), 0), 1); );
function ld_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function ld_knob(cx, cy, r, idx, lo, hi, def, cap, lg) local(v, n, dx, dy, hov, did, act) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - ld_lt < 0.35 && ld_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; ld_lt = 0; ) : (
      drag_id = did; ld_my = mouse_y; ld_dz = 0; ld_lt = time_precise(); ld_lid = idx; ld_n = ld_v2n(v, lo, hi, lg);
