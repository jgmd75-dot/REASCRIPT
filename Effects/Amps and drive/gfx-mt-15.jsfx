desc:MT-15 [hybrid amp head] (GFX)
//tags: amp amplifier guitar head hybrid valve tube solid-state crunch distortion cabinet gate
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-s74 and gfx-amp (.jsfx-inc) in the same folder.
//
// MT-15. A tiny hybrid amp head in the spirit of the 2010s micro "lunchbox" heads: one 12AX7 (both halves, run on a
// low, starved supply) for the preamp, a small solid-state power amp behind it, and a closed-back 12" cabinet
// (personal use; the sound is designed from scratch).
//
// SIGNAL FLOW (each side, L and R, runs its own identical amp; MONO IN feeds both with L + R)
//   input -> TRIM / GUARD -> GATE (linked) -> the drive-tracking pre-filter -> 2x oversampling (linear-phase
//   half-band) ->
//   V1a: the first triode, its cathode bypass a shelf (MICRO: a small cap, the lows tightened before the valve)
//     -> the coupling cap (its corner rises with GAIN, to twice at full GAIN: tighter lows into the drive) and the
//     grid-stopper / Miller roll-off -> the voicing network -> a wide 300 Hz dip that deepens with GAIN (to -3.5 dB)
//     -> GAIN (the preamp gain)
//   V1b: the second triode on the starved supply: it clips early and lopsided (the positive side, grid conduction,
//     firmly; the cutoff side further and softer) - the fizz and the even harmonics of the little valve
//     -> the coupling cap and roll-off -> TONE (the single passive tone pot: a treble bleed round a 1st-order split;
//     brighter also loses a little bass, as the real network does) -> VOLUME (the master: an audio-taper pot)
//   the SOLID-STATE POWER AMP: very clean, then a hard, square crunch at its rails. Its supply is unregulated: the
//     rails sag under a hard-driven chord and the preamp's supply droops with them (one amp, one supply, L and R).
//   -> back to the host rate -> a fixed post-shelf -> CAB: a procedural closed-back cabinet (1x12 or 2x12; OFF = line out for your own
//   IRs) and the MIC from on axis (bright) to off axis (darker) -> OUTPUT -> the house output stage (CLIP always on).
// MODEL (the two lenses in the header; the panel's colour changes with them):
//   MICRO  raw and aggressive - the tight, bright, mid-pushed high-gain bite ("box of bees"), the valve starved,
//          the power amp on low rails with a hard knee. Toxic-yellow panel.
//   FAT    fuller lower-mid punch, more headroom in both valves and the power amp, a softer knee that softens further
//          as GAIN rises, the fizz tamed. Rust-orange panel.
// ANTI-ALIASING (the house drive standard): first-order ADAA on both triodes and on the power amp's knee (the house
//   KNEE clipper), at 2x; the pre-filter into V1a slides from 40 kHz (capped near the Nyquist) down to 8 kHz (MICRO)
//   / 6.5 kHz (FAT) at full GAIN and eases the lows below 150 Hz down by up to 1.5 dB; a fixed post-shelf per model
//   makes up the stages' top-end droop. The power amp's knee tracks GAIN on FAT (character) and stays hard on MICRO.
// GAIN is level matched in both models (and the models to each other): GAIN changes the colour, not the loudness.
// VOLUME is the musical master: it gets louder, and from about 6 it pushes the power amp into its solid-state crunch.
// DRIFT (0 - 100 %, 50 % = standard): the two valves' bias wanders (each side on its own) and the preamp supply
//   breathes; the solid-state power amp only drifts a trace. 0 % = perfectly steady.
// IN / OUT: INPUT trim (click the knob for the house GUARD), MONO IN, DRIFT, OUTPUT, band SAT; the meters.
// The model and cabinet keys fade the sound out and back in (no clicks). Latency: 31 samples (reported).
//
// GUI: drag a knob (SHIFT = fine, double-click or Ctrl-click = default, wheel); values show while a knob is touched.
//   Click the LCD (or PRESETS) for the preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s74.jsfx-inc
import gfx-amp.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{Micro,Fat}>-Model
slider2:5<0,10,0.1>-Gain
slider3:5<0,10,0.1>-Tone
slider4:5<0,10,0.1>-Volume
slider5:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider6:1<0,2,1{Off (line out),1x12 closed,2x12 closed}>-Cabinet
slider7:3<0,10,0.1>-Mic position (on - off axis)
slider8:0<0,1,1{Off,On}>-Mono in
slider9:0<-24,12,0.1>-Input trim (dB)
slider10:0<0,1,1{Off,On}>-Input guard
slider11:50<0,100,1>-Drift (%)
slider12:0<-24,12,0.1>-Output (dB)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-Ceiling (dB)
slider18:1<0,1,1{Off,Clip}>-(unused, output stage)
slider19:prs_sel=0<0,12,1{No preset,Init,Bedroom Crunch,Box of Bees,Garage Punk,Indie Jangle,Blues Breakup,Rock Crunch,Sludge Riff,Grunge Wall,Hardcore Chug,Singing Lead,Line Out Crunch}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-mt-15";                                   // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
s74_mem = 0;
m5_H1 = s74_alloc(64);
m5_MKT = s74_alloc(32);                                  // the makeup tables: MICRO, FAT (11 points each, dB)
m5_ostm = s74_alloc(16);

// ---------- 2x oversampling: the house half-band (63 taps, polyphase), 31 samples of latency ----------
s74_hbdesign(m5_H1, 63, 8);
m5u1L.s74_upinit(63, m5_H1, 64); m5u1R.s74_upinit(63, m5_H1, 64); m5d1L.s74_dninit(63, m5_H1, 64); m5d1R.s74_dninit(63, m5_H1, 64);
m5_LAT = 31;

// ---------- the valve curves ----------
// a smooth saturator (rational, exactly 1 from |x| = 3) and its slope
function m5_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function m5_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
// a triode: the grid-conduction side (positive) saturates at ap, the cutoff side softer and further out (an)
function m5_tg(u, ap, an) ( u >= 0 ? ap * m5_th(u / ap) : an * m5_th(u / an); );
function m5_tgd(u, ap, an) ( u >= 0 ? m5_thd(u / ap) : m5_thd(u / an); );
// the antiderivatives (for the anti-aliasing): th = x / 9 + (8 / 3) x / (x^2 + 3), so Int th = x^2 / 18 +
// (4 / 3) ln(1 + x^2 / 3) up to |x| = 3, then linear; the triode's two sides scale it (ap^2, an^2)
function m5_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function m5_tgF(u, ap, an) ( u >= 0 ? ap * ap * m5_F(u / ap) : an * an * m5_F(u / an); );
// a stage at operating point b: unity small-signal gain, nothing out at rest (the caller inverts). First-order ADAA on
// u = x + b: (G(u) - G(u1)) / (u - u1), the curve at the midpoint when the two are within 1e-5; a new operating
// point (DRIFT, the model) re-reads the last point on the new curve, so nothing steps
function m5_stset(b, pp, nn) instance(b0, g0, n0, ap, an, u1, ga1) (
  ap = pp; an = nn; u1 += b - b0; ga1 = m5_tgF(u1, ap, an);
  b0 = b; g0 = m5_tg(b, ap, an); n0 = 1 / max(m5_tgd(b, ap, an), 0.05);
);
function m5_strun(x) instance(b0, g0, n0, ap, an, u1, ga1) local(u, ga, d, y) (
  u = x + b0; ga = m5_tgF(u, ap, an); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : m5_tg(0.5 * (u + u1), ap, an);
  u1 = u; ga1 = ga;
  (y - g0) * n0 + m5_dn;
);

// ---------- first-order sections ----------
// the cathode bypass: the gain falls by F below fz (Rk Ck), a shelf between fz and F * fz (bilinear)
function m5_shset(fz, fr, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * fr;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function m5_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function m5_k(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );

// ---------- one side of the amp, at twice the rate: the preamp, TONE, VOLUME, the power amp ----------
function m5_core(x) instance(cs, v1, mid, dp, v2, h1, l1, h2, l2, tz, ps, rl, yo, pa) local(y) (
  y = cs.m5_1run(x * m5_K1);
  y = -v1.m5_strun(y);                                  // V1a
  h1 += (y - h1) * m5_kh1; y -= h1;                     // the coupling cap (its corner rises with GAIN)
  l1 += (y - l1) * m5_kl1;                              // the grid stopper / Miller roll-off
  y = dp.am_run(mid.am_run(l1)) * m5_gn;                 // the voicing network, the 300 Hz dip (deepens with GAIN), GAIN
  y = -ps * v2.m5_strun(y / ps);                        // V1b, on the (sagging) preamp supply
  h2 += (y - h2) * m5_kh2; y -= h2;
  l2 += (y - l2) * m5_kl2;
  tz += (l2 - tz) * m5_ktn;                             // TONE: a treble bleed round a 1st-order split
  y = (tz * m5_tl + (l2 - tz) * m5_tk) * m5_vk;         // ... and VOLUME (the master)
  // the solid-state power amp: clean to its knee, then a hard round-off into the rails (the house KNEE clipper,
  // anti-aliased, read relative to the sagging rails)
  y = rl * pa.clp_run(y / rl);
  yo = y;
  y;
);
// the shared supply (one amp, L and R): the power amp draws, the rails sag, the preamp's supply droops with them
function m5_sag() local(a, s) (
  a = max(abs(cL.yo), abs(cR.yo)) / m5_rail;
  m5_env += (a - m5_env) * (a > m5_env ? m5_sga : m5_sgr);
  s = m5_sagk * min(max(m5_env - 0.45, 0) * 1.8, 1);
  cL.rl = m5_rail * (1 - s) * cL.rd; cR.rl = m5_rail * (1 - s) * cR.rd;
  cL.ps = (1 - 0.45 * s) * cL.sb; cR.ps = (1 - 0.45 * s) * cR.sb;
);

// ---------- the model: its fixed constants and filters (only at a silent point) ----------
function m5_side() instance(cs, mid, pa) (
  pa.clp_set(2, 1, 1, 0); pa.clp_kt_cfg(m5_kw0, m5_kw1);
  !m5_mod ? ( cs.m5_shset(240, 2.6, m5_FS); mid.am_bq(2, 950, 0.7, 5.5, m5_FS); )
          : ( cs.m5_shset(32, 1.9, m5_FS);  mid.am_bq(2, 380, 0.75, 4.5, m5_FS); );
);
// the valves' operating points (DRIFT moves them; w1..w3 are the side's wander, -1..1)
function m5_bias(w1, w2, w3) instance(v1, v2, sb, rd, d1, d2, d3) (
  d1 = w1; d2 = w2; d3 = w3;
  v1.m5_stset(m5_b1 + 0.05 * dm_a * w1, m5_P1, m5_N1);
  v2.m5_stset(m5_b2 + 0.05 * dm_a * w2, m5_P2, m5_N2);
  sb = 1 + 0.015 * dm_a * w3;                           // the preamp supply breathes
  rd = 1 + 0.003 * dm_a * w3;                           // the solid-state rails: a trace
);
// the fixed post-shelves (peak + high shelf per model, corners as a fraction of the host rate): fitted so the
// small-signal response at GAIN 0 matches the earlier 4x amp
M5_C1F = 0.0885; M5_C1G = -0.07; M5_C1Q = 0.46; M5_C2F = 0.3241; M5_C2G = 6.16; M5_C2Q = 0.49;   // MICRO
M5_C3F = 0.1631; M5_C3G = 0.28; M5_C3Q = 0.87; M5_C4F = 0.2404; M5_C4G = 2.95; M5_C4Q = 0.67;     // FAT
function m5_modset() (
  !m5_mod ? (                                           // MICRO: starved, tight, mid-pushed, low rails
    m5_K1 = 1.7; m5_P1 = 0.75; m5_N1 = 1.15; m5_b1 = -0.18; m5_P2 = 0.6; m5_N2 = 0.95; m5_b2 = -0.14;
    m5_kh1 = m5_k(150, m5_FS); m5_kl1 = m5_k(11000, m5_FS); m5_kh2 = m5_k(80, m5_FS); m5_kl2 = m5_k(7500, m5_FS);
    m5_glo = -2; m5_ghi = 36; m5_Gpa = 8; m5_rail = 1; m5_sagk = 0.12; m5_ktn = m5_k(900, m5_FS);
    m5_hp0 = 150; m5_kw0 = m5_kw1 = 0.15; m5_kt = 0;   // the coupling cap; the power amp's knee: hard, fixed
    m5pL.clp_pf_cfg(40000, 8000, -1.5, 150); m5pR.clp_pf_cfg(40000, 8000, -1.5, 150);
    m5k1L.s74_bqset(3, M5_C1F * srate, M5_C1G, M5_C1Q, srate); m5k2L.s74_bqset(5, M5_C2F * srate, M5_C2G, M5_C2Q, srate);
  ) : (                                                 // FAT: headroom, lower-mid punch, the fizz tamed
    m5_K1 = 1.2; m5_P1 = 1.0; m5_N1 = 1.8; m5_b1 = -0.3; m5_P2 = 0.95; m5_N2 = 1.6; m5_b2 = -0.25;
    m5_kh1 = m5_k(40, m5_FS); m5_kl1 = m5_k(6500, m5_FS); m5_kh2 = m5_k(30, m5_FS); m5_kl2 = m5_k(4800, m5_FS);
    m5_glo = -6; m5_ghi = 28; m5_Gpa = 8; m5_rail = 1.4; m5_sagk = 0.06; m5_ktn = m5_k(650, m5_FS);
    m5_hp0 = 40; m5_kw0 = 0.42; m5_kw1 = 0.6; m5_kt = 1;  // the knee softens as GAIN rises (character)
    m5pL.clp_pf_cfg(40000, 6500, -1.5, 150); m5pR.clp_pf_cfg(40000, 6500, -1.5, 150);
    m5k1L.s74_bqset(3, M5_C3F * srate, M5_C3G, M5_C3Q, srate); m5k2L.s74_bqset(5, M5_C4F * srate, M5_C4G, M5_C4Q, srate);
  );
  m5k1R.b0 = m5k1L.b0; m5k1R.b1 = m5k1L.b1; m5k1R.b2 = m5k1L.b2; m5k1R.a1 = m5k1L.a1; m5k1R.a2 = m5k1L.a2;
  m5k2R.b0 = m5k2L.b0; m5k2R.b1 = m5k2L.b1; m5k2R.b2 = m5k2L.b2; m5k2R.a1 = m5k2L.a1; m5k2R.a2 = m5k2L.a2;
  m5pL.clp_pf_reset(); m5pR.clp_pf_reset();
  cL.m5_side(); cR.m5_side();
  cL.m5_bias(cL.d1, cL.d2, cL.d3); cR.m5_bias(cR.d1, cR.d2, cR.d3);
);
// per block, from the glided GAIN: the coupling cap's corner rises (to 2x at full GAIN: tighter lows into V1b), the
// 300 Hz dip deepens (to -3.5 dB, wide), the pre-filter slides, the power amp's knee tracks (FAT only)
function m5_gblk(force) local(g, k) (
  m5_gb += (slider2 - m5_gb) * (force ? 1 : 1 - exp(-samplesblock / (0.03 * srate)));
  g = min(max(m5_gb, 0), 10) / 10;
  m5_kh1 = m5_k(m5_hp0 * (1 + g), m5_FS);
  cL.dp.am_bq(2, 300, 0.9, -3.5 * g ^ 1.3, m5_FS);
  cR.dp.b0 = cL.dp.b0; cR.dp.b1 = cL.dp.b1; cR.dp.b2 = cL.dp.b2; cR.dp.a1 = cL.dp.a1; cR.dp.a2 = cL.dp.a2;
  m5pL.clp_pf_block(g, srate, force ? 1 : samplesblock); m5pR.clp_pf_block(g, srate, force ? 1 : samplesblock);
  clp_kt_on = m5_kt;
  k = cL.pa.clp_kt_block(g, srate, force ? 1 : samplesblock); cL.pa.clp_knee(k);
  k = cR.pa.clp_kt_block(g, srate, force ? 1 : samplesblock); cR.pa.clp_knee(k);
  cL.pa.clp_tidy(); cR.pa.clp_tidy();
);

// ---------- the cabinets (procedural filters), mic 0 = on axis .. 10 = off axis ----------
function m5_cabset(type, mic) instance(c1, c2, c3, c4, c5, c6, c7) local(m, lp) (
  m = min(max(mic, 0), 10) / 10;
  type == 1 ? (                                         // 1x12 closed back: a tight thump, a bright upper-mid bite
    c1.am_bq(1, 72, 0.95, 0, srate);
    c2.am_bq(2, 115, 1.3, 3.5, srate);                  // the box resonance
    c3.am_bq(2, 480, 1.0, -2.5, srate);                 // the cone's dip
    c4.am_bq(2, 2300, 1.4, 5 * (1 - 0.7 * m), srate);   // the cone's bite, on axis
    lp = 5800 - 2100 * m;
    c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
    c7.am_bq(2, 7500, 3, -9 * m, srate);                // off axis: a notch above the roll-off
  ) : type == 2 ? (                                     // 2x12 closed back: deeper, broader, a little darker
    c1.am_bq(1, 65, 1.05, 0, srate);
    c2.am_bq(2, 105, 1.2, 4.5, srate);
    c3.am_bq(2, 400, 0.9, -3, srate);
    c4.am_bq(2, 2700, 1.5, 4.5 * (1 - 0.7 * m), srate);
    lp = 5400 - 2000 * m;
    c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
    c7.am_bq(2, 6800, 2.6, -10 * m, srate);
  ) : (
    c1.am_thru(); c2.am_thru(); c3.am_thru(); c4.am_thru(); c5.am_thru(); c6.am_thru(); c7.am_thru();
  );
);
function m5_cabrun(x) instance(c1, c2, c3, c4, c5, c6, c7) (
  c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c2.am_run(c1.am_run(x)))))));
);

// ---------- level matching: the makeup for each GAIN (dB, GAIN 0 .. 10; measured on pink noise, GUARD off) ----------
function m5_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = m5_MKT + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
m5_row(0, 7.26, 3.55, 0.22, -3.09, -5.85, -7.79, -9.32, -10.23, -10.79, -11.13, -11.17);
m5_row(1, 11.28, 8.10, 5.26, 1.93, -1.26, -4.05, -6.91, -9.54, -11.65, -13.41, -14.52);
function m5_mk(m, g) local(p, i, f, q) (
  p = min(max(g, 0), 10); i = min(floor(p), 9); f = p - i; q = m5_MKT + m * 11;
  10 ^ ((q[i] * (1 - f) + q[i + 1] * f) / 20);
);
m5_kout = 1;

// ---------- settings (every block: the knobs on the panel do not run @slider) ----------
function m5_upd() local(t, p) (
  m5_tmod = slider1 >= 0.5;
  m5_tcab = min(max(floor(slider6 + 0.5), 0), 2);
  m5_tgn = (m5_glo + (m5_ghi - m5_glo) * min(max(slider2, 0), 10) / 10) * 0.11512925;   // GAIN (glided as a log)
  m5_tmk = log(m5_mk(m5_mod, slider2));                 // ... and its makeup, in step
  t = min(max(slider3, 0), 10) / 10;
  m5_ttk = 0.16 * 8 ^ t; m5_ttl = 1 - 0.3 * t;         // TONE: the treble bleed, the bass it costs
  p = min(max(slider4, 0), 10) / 10;
  m5_tvp = p;                                           // VOLUME: a 1 M audio-taper pot, into the power amp
  m5_gthr = slider5;
  m5_mt = slider8 >= 0.5;
  m5_to = 10 ^ (slider12 / 20) * m5_kout;
  in_setup(slider9, slider10 >= 0.5);
  drift_macro(slider11);
  ost_setup(slider13 / 100, slider14 / 100, slider15, slider16, slider17, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = m5_LAT;
);
// the cabinet and MIC (the mic glides; the two mics sit a hair apart, so a mono source still opens up)
function m5_cabupd(force) (
  m5_micg += (slider7 - m5_micg) * (force ? 1 : 1 - exp(-samplesblock / (0.03 * srate)));
  force || abs(m5_micg - m5_micl) > 0.001 ? (
    m5_micl = m5_micg;
    cabL.m5_cabset(m5_cab, m5_micg - 0.15); cabR.m5_cabset(m5_cab, m5_micg + 0.15);
  );
);
function m5_srinit() (
  m5_sr = srate; m5_FS = 2 * srate;
  m5_mod = slider1 >= 0.5; m5_cab = min(max(floor(slider6 + 0.5), 0), 2);
  m5_modset();
  m5_sga = 1 - exp(-1 / (0.006 * m5_FS)); m5_sgr = 1 - exp(-1 / (0.18 * m5_FS));
  m5_env = 0; cL.rl = cR.rl = m5_rail; cL.ps = cR.ps = 1; cL.rd = cR.rd = cL.sb = cR.sb = 1;
  m5_sm = 1 - exp(-1 / (0.025 * srate));
  m5_fd = 1 / (0.008 * srate);
  ost_init(m5_ostm); in_init();
  m5_upd(); m5_cabupd(1);
  m5_lgn = m5_tgn; m5_lmk = m5_tmk; m5_tk = m5_ttk; m5_tl = m5_ttl; m5_vp = m5_tvp; m5_o = m5_to; m5_mn = m5_mt;
  m5_fst = 0; m5_fade = 1;
  m5_gblk(1);
);
m5_dn = 0.000000000000000001;
cL.d1 = cL.d2 = cL.d3 = cR.d1 = cR.d2 = cR.d3 = 0;
m5_srinit();
ostL.ost_ch_init(); ostR.ost_ch_init();
dw1.drift_init(0.8 + rand(0.5)); dw2.drift_init(0.8 + rand(0.5)); dw3.drift_init(0.8 + rand(0.5));
dw4.drift_init(0.8 + rand(0.5)); dw5.drift_init(0.8 + rand(0.5)); dw6.drift_init(0.8 + rand(0.5));
m5_pkL = m5_pkR = 0;

// ---------- presets (the input trim / guard, MONO IN, DRIFT and the output stage are left alone) ----------
function m5_set(md, g, t, v, gt, cb, mc, ou) (
  slider1 = md; slider2 = g; slider3 = t; slider4 = v; slider5 = gt; slider6 = cb; slider7 = mc; slider12 = ou;
  slider_automate(127 + 2048);                          // sliders 1-7 and 12
);
function load_preset(p) (
  //                  MODEL GAIN TONE VOL  GATE CAB MIC  OUTPUT
  p == 1  ? m5_set(0,   5,   5,   5,   -80, 1,  3,    0.0) :   // Init
  p == 2  ? m5_set(0,   3.5, 6,   5,   -80, 1,  2.5,  -0.8) :   // Bedroom Crunch
  p == 3  ? m5_set(0,   9,   7,   5.5, -66, 1,  2,    -3.9) :   // Box of Bees
  p == 4  ? m5_set(0,   7,   6.5, 6.5, -70, 1,  3,    -7.4) :   // Garage Punk
  p == 5  ? m5_set(1,   1.5, 6.5, 4.5, -80, 1,  3,    1.8) :   // Indie Jangle
  p == 6  ? m5_set(1,   4,   5,   6,   -80, 1,  4,    -4.1) :   // Blues Breakup
  p == 7  ? m5_set(1,   6,   5.5, 6,   -80, 2,  3,    -4.4) :   // Rock Crunch
  p == 8  ? m5_set(1,   9,   3.5, 7,   -66, 2,  6,    -6.6) :   // Sludge Riff
  p == 9  ? m5_set(1,   8,   4.5, 7.5, -70, 2,  4,    -8.9) :   // Grunge Wall
  p == 10 ? m5_set(0,   8.5, 5.5, 6,   -60, 2,  3.5,  -4.3) :   // Hardcore Chug
  p == 11 ? m5_set(1,   10,  6,   6,   -66, 1,  5,    -4.2) :   // Singing Lead
  p == 12 ? m5_set(0,   6,   5.5, 5.5, -80, 0,  3,    -1.9) :   // Line Out Crunch
  p == 13 ? (                                           // Reset all to defaults
    m5_set(0, 5, 5, 5, -80, 1, 3, 0);
    slider8 = 0; slider9 = 0; slider10 = 0; slider11 = 50; slider13 = 0; slider14 = 30; slider15 = 120;
    slider16 = 6000; slider17 = -0.3; slider18 = 1;
    slider_automate(262143);                            // sliders 1-18
  );
);

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
m5_upd();

@block
prs_chk();
srate != m5_sr ? ( m5_srinit(); ostL.ost_ch_init(); ostR.ost_ch_init(); );
m5_upd();
m5_cabupd(0);
m5_gblk(0);
// DRIFT: the valves' bias and the preamp supply wander, each side on its own; the power amp only a trace
m5_di = 0.2 * dm_s * samplesblock / srate;
cL.m5_bias(dw1.drift_tick(m5_di), dw2.drift_tick(m5_di), dw3.drift_tick(m5_di));
cR.m5_bias(dw4.drift_tick(m5_di), dw5.drift_tick(m5_di), dw6.drift_tick(m5_di));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- glides; a change of MODEL or CAB: fade out, switch at the silent point, wait, fade back in ----------
m5_lgn += (m5_tgn - m5_lgn) * m5_sm; m5_gn = exp(m5_lgn); m5_lmk += (m5_tmk - m5_lmk) * m5_sm; m5_mkg = exp(m5_lmk);
m5_tk += (m5_ttk - m5_tk) * m5_sm; m5_tl += (m5_ttl - m5_tl) * m5_sm;
m5_vp += (m5_tvp - m5_vp) * m5_sm; m5_vk = (exp(4.6051702 * m5_vp) - 1) * 0.01010101 * m5_Gpa;
m5_o += (m5_to - m5_o) * m5_sm; m5_mn += (m5_mt - m5_mn) * m5_sm;
(m5_tmod != m5_mod || m5_tcab != m5_cab) && m5_fst == 0 ? m5_fst = 1;
m5_fst == 1 ? ( m5_fade -= m5_fd; m5_fade <= 0 ? (
  m5_fade = 0;
  m5_tmod != m5_mod ? (
    m5_mod = m5_tmod; m5_modset();
    m5_tgn = (m5_glo + (m5_ghi - m5_glo) * min(max(slider2, 0), 10) / 10) * 0.11512925; m5_lgn = m5_tgn;
    m5_tmk = log(m5_mk(m5_mod, slider2)); m5_lmk = m5_tmk;
    m5_gblk(1);
  );
  m5_tcab != m5_cab ? ( m5_cab = m5_tcab; m5_cabupd(1); );
  m5_hold = floor(0.012 * srate); m5_fst = 2; ); ) :
m5_fst == 2 ? ( m5_hold -= 1; m5_hold <= 0 ? m5_fst = 3; ) :
m5_fst == 3 ? ( m5_fade += m5_fd; m5_fade >= 1 ? ( m5_fade = 1; m5_fst = 0; ); );

// ---------- input: TRIM / GUARD, MONO IN, the linked GATE ----------
in_process(spl0, spl1);
m5_xl = in_l; m5_xr = in_r;
m5_xm = 0.5 * (m5_xl + m5_xr); m5_xl += (m5_xm - m5_xl) * m5_mn; m5_xr += (m5_xm - m5_xr) * m5_mn;
m5_gg = m5_gt.am_gate(max(abs(m5_xl), abs(m5_xr)), m5_gthr);
m5_xl *= m5_gg; m5_xr *= m5_gg;
m5_dn = -m5_dn;

// ---------- the drive-tracking pre-filter, then the amp at twice the rate (one supply for both sides) ----------
m5_xl = m5pL.clp_pf_run(m5_xl); m5_xr = m5pR.clp_pf_run(m5_xr);
m5u1L.s74_up(m5_xl); m5u1R.s74_up(m5_xr);
m5_q0l = cL.m5_core(m5u1L.o0); m5_q0r = cR.m5_core(m5u1R.o0); m5_sag();
m5_q1l = cL.m5_core(m5u1L.o1); m5_q1r = cR.m5_core(m5u1R.o1); m5_sag();
m5_yl = m5d1L.s74_dn(m5_q0l, m5_q1l); m5_yr = m5d1R.s74_dn(m5_q0r, m5_q1r);
// the fixed post-shelf (makes up the anti-aliased stages' top-end droop)
m5_yl = m5k2L.s74_bq(m5k1L.s74_bq(m5_yl)); m5_yr = m5k2R.s74_bq(m5k1R.s74_bq(m5_yr));

// ---------- the cabinet, the output section ----------
m5_yl = cabL.m5_cabrun(m5_yl); m5_yr = cabR.m5_cabrun(m5_yr);
m5_og = m5_o * m5_mkg * m5_fade * m5_fade * (3 - 2 * m5_fade);
m5_yl = ostL.ost_band(m5_yl * m5_og); m5_yr = ostR.ost_band(m5_yr * m5_og);
ost_out(m5_yl, m5_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
m5_pkL = max(m5_pkL, abs(spl0)); m5_pkR = max(m5_pkR, abs(spl1));

@gfx 1040 404
ui_begin(1040, 404);

// =====================================================================
// A matte olive-drab "field telemetry" chassis: a charcoal header strip, the controls on the olive plate grouped by
// thin hazard-orange rules, monolithic cast-metal pointer knobs, backlit square lenses for every switch.
// =====================================================================
M5_OL = 0xE8D21E; M5_OLD = 0xD9C214; M5_CHAR = 0x111111; M5_HAZ = 0x111111;
M5_INK = 0x111111; M5_DIM = 0x2E2A08; M5_LAMP = 0xF2DC24;
M5_HINK = 0xF4F1E2; M5_HDIM = 0xBDBAA8;
// FAT: the panel turns rust orange (dark print kept, the lenses light a warm amber); MICRO keeps the toxic yellow
slider1 >= 0.5 ? ( M5_OL = 0xB4541F; M5_OLD = 0x9E4818; M5_DIM = 0x2A1206; M5_LAMP = 0xFFB347; );

gfx_setfont(11, "Arial", 15 * sc, 'b');                 // knob labels
gfx_setfont(12, "Arial", 13.5 * sc, 'b');               // lens captions
gfx_setfont(13, "Arial", 12.5 * sc, 'b');               // section titles, small print
gfx_setfont(14, "Arial", 31 * sc, 'b');                 // the name
gfx_setfont(15, "Arial", 14 * sc, 'b');                 // values (while touched)

function m5r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function m5t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function m5tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.5 + 0.5); gfx_drawstr(s); );
function m5hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function m5set(idx, v) ( slider(idx) = v; ui_auto(idx); );

// a section title in small capitals with a thin hazard-orange rule running on to x2
function m5sect(x1, x2, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(M5_INK); m5t(x1, y - th / sc * 0.5, s);
  ui_col(M5_HAZ); m5r(x1 + tw / sc + 10, y, x2 - x1 - tw / sc - 10, 1);
);

// ---------- the monolithic cast-metal pointer knob ----------
// one solid gunmetal casting, a thin dark rim, a bold cream pointer to the edge; printed ticks round it
function m5kdraw(cx, cy, r, n) local(a, ca, sa, i, t, l) (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 12 : 8.5;
    ui_cola(M5_INK, 0.9); s74_ln(cx + sin(t) * (r + 5), cy - cos(t) * (r + 5), cx + sin(t) * (r + l), cy - cos(t) * (r + l), i == 0 || i == 5 || i == 10 ? 2 : 1.3);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle((cx + 1.8) * sc, (cy + 3.2) * sc, r * sc, 1, 1);
  ui_col(0x141618); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(0x1B1C1E); gfx_circle(cx * sc, cy * sc, (r - 1.4) * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.30); s74_ln(cx - r * 0.55, cy - r * 0.72, cx - r * 0.72, cy - r * 0.55, 1.2);
  ui_cola(0x000000, 0.45); s74_ln(cx + ca * r * 0.12 + 1, cy + sa * r * 0.12 + 1, cx + ca * (r - 1) + 1, cy + sa * (r - 1) + 1, max(3, r * 0.14));
  ui_col(0xFFFFFF); s74_ln(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * (r - 1), cy + sa * (r - 1), max(3, r * 0.14));
);
// drag (SHIFT = fine), double-click / Ctrl-click = default, wheel; the value shows (in place of the label) while touched
function m5knob(cx, cy, r, idx, lo, hi, def, label, fmt) local(v, n, dx, dy, hov, did, tw, th) (
  did = 5000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - m5g_lt < 0.35 && m5g_lid == idx && !m5g_mv) || (mouse_cap & 4) ? ( m5set(idx, def); drag_id = -1; m5g_lt = 0; ) : (
      drag_id = did; m5g_ky = mouse_y; m5g_ky0 = mouse_y; m5g_mv = 0; m5g_lt = time_precise(); m5g_lid = idx;
      m5g_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !m5g_mv && abs(mouse_y - m5g_ky0) > 3 * sc ? ( m5g_mv = 1; m5g_ky = mouse_y; );
  drag_id == did && m5g_mv ? (
    m5g_kn = min(max(m5g_kn + (m5g_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); m5g_ky = mouse_y;
    v = lo + floor(m5g_kn * (hi - lo) * 10 + 0.5) / 10;
    slider(idx) != v ? m5set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    v = min(max(floor((v + mouse_wheel / 120 * (hi - lo) * ((mouse_cap & 8) ? 0.01 : 0.05)) * 10 + 0.5) / 10, lo), hi);
    m5set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  m5kdraw(cx, cy, r, n);
  (hov || drag_id == did) ? (
    strcpy(#m5v, fmt); idx == 5 && v <= -79.5 ? strcpy(#m5v, "OFF") : sprintf(#m5v, fmt, v);
    gfx_setfont(15); gfx_measurestr(#m5v, tw, th);
    ui_col(M5_CHAR); gfx_rect(cx * sc - tw * 0.5 - 7 * sc, (cy + r + 10) * sc, tw + 14 * sc, th + 4 * sc);
    ui_col(M5_LAMP); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = (cy + r + 12) * sc; gfx_drawstr(#m5v);
  ) : (
    gfx_setfont(11); ui_col(M5_INK); m5tc(cx, cy + r + 20, label);
  );
);

// ---------- the backlit square lens: a black bezel, a smoked lens that lights hazard amber; returns 1 on a click ----------
function m5lens(x, y, w, h, on, s) local(hov, hit, i) (
  hov = m5hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.45); m5r(x + 1, y + 2, w, h);
  ui_col(0x0E0F10); m5r(x, y, w, h);
  ui_col(0x3A3E41); m5r(x + 1, y + 1, w - 2, 1);
  on ? (
    i = 0; loop(3, ui_cola(M5_LAMP, 0.10); m5r(x - 2 - i * 2, y - 2 - i * 2, w + 4 + i * 4, h + 4 + i * 4); i += 1; );
    ui_col(M5_LAMP); m5r(x + 3, y + 3, w - 6, h - 6);
    ui_cola(0xFFFFFF, 0.28); m5r(x + 3, y + 3, w - 6, (h - 6) * 0.4);
  ) : (
    ui_col(hov ? 0x3B3E34 : 0x2A2C27); m5r(x + 3, y + 3, w - 6, h - 6);
    ui_cola(0xFFFFFF, 0.06); m5r(x + 3, y + 3, w - 6, (h - 6) * 0.4);
  );
  gfx_setfont(12); ui_col(on ? 0x231507 : 0xB9B9A2); m5tc(x + w * 0.5, y + h * 0.5, s);
  hit;
);

// ---------- the chassis ----------
ui_col(0x1B1D1E); gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0x000000, 0.5); m5r(7, 8, 1028, 392);
ui_col(M5_OL); m5r(6, 6, 1028, 392);
ui_cola(0xFFFFFF, 0.10); m5r(6, 6, 1028, 1); m5r(6, 6, 1, 392);
ui_cola(0x000000, 0.35); m5r(6, 397, 1028, 1); m5r(1033, 6, 1, 392);
m5g_i = 0; loop(6, ui_cola(0xFFFFFF, 0.012); m5r(6, 64, 1028, 200 * (1 - m5g_i / 6)); m5g_i += 1; );
// the header strip
ui_col(M5_CHAR); m5r(6, 6, 1028, 56);
ui_col(0x000000); m5r(6, 62, 1028, 2);
// the lower strip: IN / OUT
ui_col(M5_OLD); m5r(14, 272, 1012, 118);
ui_cola(0xFFFFFF, 0.08); m5r(14, 272, 1012, 1);
ui_cola(0x000000, 0.30); m5r(14, 389, 1012, 1);
s74_hex(26, 334, 4.4); s74_hex(1014, 334, 4.4);

// ---------- the header: name, type, presets, the MODEL lenses, size ----------
ui_col(M5_OL); m5r(18, 17, 36, 34);
gfx_setfont(13); ui_col(0x16181A); m5tc(36, 34, "GFX");
gfx_setfont(14); ui_col(M5_HINK); m5t(64, 16, "MT-15");
gfx_setfont(13); ui_col(M5_HDIM); m5t(184, 18, "HYBRID AMP HEAD"); m5t(184, 35, "12AX7 · 15 W SOLID STATE");
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
m5g_k = pk_preset(404 * sc, 17 * sc, 370 * sc, 32 * sc, pr_cur,
  "Init|Bedroom Crunch|Box of Bees|Garage Punk|Indie Jangle|Blues Breakup|Rock Crunch|Sludge Riff|Grunge Wall|Hardcore Chug|Singing Lead|Line Out Crunch");
m5g_k > 0 ? ( prs_dirty = m5g_k; pr_cur = m5g_k > 12 ? 1 : m5g_k; );
m5lens(792, 17, 82, 32, slider1 < 0.5, "MICRO") ? m5set(1, 0);
m5lens(880, 17, 64, 32, slider1 >= 0.5, "FAT") ? m5set(1, 1);
ui_size_picker(962 * sc, 24 * sc);

// ---------- PREAMP: GAIN, TONE, VOLUME ----------
m5sect(24, 498, 84, "PREAMP");
m5knob(112, 166, 42, 2, 0, 10, 5, "GAIN", "%.1f");
m5knob(262, 166, 42, 3, 0, 10, 5, "TONE", "%.1f");
m5knob(412, 166, 42, 4, 0, 10, 5, "VOLUME", "%.1f");
ui_col(M5_HAZ); m5r(512, 78, 1, 176);

// ---------- CABINET: off (line out) / 1x12 / 2x12, MIC ----------
m5sect(528, 798, 84, "CABINET");
m5lens(536, 106, 96, 32, slider6 < 0.5, "LINE OUT") ? m5set(6, 0);
m5lens(536, 148, 96, 32, slider6 >= 0.5 && slider6 < 1.5, "1x12") ? m5set(6, 1);
m5lens(536, 190, 96, 32, slider6 >= 1.5, "2x12") ? m5set(6, 2);
m5knob(714, 166, 36, 7, 0, 10, 3, "MIC", "%.1f");
ui_col(M5_HAZ); m5r(812, 78, 1, 176);

// ---------- GATE ----------
m5sect(828, 1016, 84, "GATE");
m5knob(904, 166, 36, 5, -80, -20, -80, "THRESHOLD", "%.1f dB");
m5g_gl = slider5 > -79.5 && m5_gg > 0.5;
ui_col(0x0E0F10); gfx_circle(978 * sc, 166 * sc, 7 * sc, 1, 1);
m5g_gl ? ( ui_cola(M5_LAMP, 0.25); gfx_circle(978 * sc, 166 * sc, 11 * sc, 1, 1); ui_col(M5_LAMP); ) : ui_col(0x3A2A18);
gfx_circle(978 * sc, 166 * sc, 5 * sc, 1, 1);
gfx_setfont(13); ui_col(M5_DIM); m5tc(978, 186, "OPEN");

// ---------- IN / OUT: INPUT (GUARD), MONO IN, DRIFT, OUTPUT, SAT, the meters ----------
m5sect(44, 1000, 284, "IN / OUT");
m5knob(84, 334, 24, 9, -24, 12, 0, "INPUT", "%+.1f dB");
ui_guardclick(5000 + 9, 10, 84, 334, 27);              // click INPUT for the house GUARD (its LED, upper right)
m5lens(140, 318, 96, 32, slider8 >= 0.5, "MONO IN") ? m5set(8, slider8 >= 0.5 ? 0 : 1);
m5knob(300, 334, 24, 11, 0, 100, 50, "DRIFT", "%.0f%%");
m5knob(392, 334, 24, 12, -24, 12, 0, "OUTPUT", "%+.1f dB");
m5knob(484, 334, 24, 13, 0, 100, 0, "SAT", "%.0f%%");
gfx_setfont(13); ui_col(M5_DIM); m5tc(570, 327, "L"); m5tc(570, 349, "R");
!m5_mi ? ( mtL.hold = mtR.hold = -100; m5_mi = 1; );   // seed the ledm peak-hold below the scale (an instance var starts at 0 dB = the red LED)
mtL.ui_ledm(584 * sc, 321 * sc, 404 * sc, 11 * sc, m5_pkL); mtR.ui_ledm(584 * sc, 343 * sc, 404 * sc, 11 * sc, m5_pkR);
m5_pkL = 0; m5_pkR = 0;
gfx_setfont(13); ui_col(M5_DIM); m5tc(786, 370, "OUTPUT LEVEL");

pk_end();
ui_end();
