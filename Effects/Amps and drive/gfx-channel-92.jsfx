  s92_autor(47, 55);
);
function s92_load(p) (
  p == 1 ? ( s92_cur == 0 ? m15_m15_dst = 1; slider1 = 0; m15_setp(6, 0, 0, 35, 25, 50, 15, 1, 100, 0); s92_autor(2, 11); ) :
  p >= 2 && p <= 6 ? ( slider1 = 0; m15_load_preset(p - 1); ) :
