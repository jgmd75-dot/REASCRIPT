  k = pk_preset(544 * sc, 14 * sc, 332 * sc, 36 * sc, s92_pr, "Init|15: Bedroom Demo|15: Hot and Boxy|15: No NR, Open Tape|15: Worn-out Portable|15: Clean-ish Portable|44: Clean Double Speed|44: Normal Speed Warm|44: Rack Punch|44: Scooped Mids|44: No NR|12: Vocal|12: Acoustic Guitar|12: Bass DI|12: Keys|12: Hot and Noisy|FIELD: Init|FIELD: Dialogue Boom|FIELD: Lavalier|FIELD: Acoustic|FIELD: Drum Room|FIELD: Kick and Bass|FIELD: Hot Field|FIELD: Safety Net");
  k > 0 ? prs_dirty = k;
  ui_size_picker(888 * sc, 23 * sc);
);
