desc:PRE92 [90s preamps] (GFX)
//tags: channel strip preamp tape cassette lo-fi hiss transformer limiter field location portable 92
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate and gfx-clip (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,3,1{15 (lo-fi channel),44 (tape channel),12 (desk channel),FIELD (location mic pre)}>-Model
slider2:6<-6,24,0.1>-15 Gain (dB)
slider3:0<-10,10,0.1>-15 Treble (10 kHz) (dB)
slider4:0<-10,10,0.1>-15 Bass (100 Hz) (dB)
slider5:35<0,100,1>-15 Tape drive (%)
slider6:25<0,100,1>-15 Wow / flutter (%)
slider7:50<0,100,1>-15 Hiss (%)
slider8:15<0,100,1>-15 Age (%)
slider9:1<0,1,1{Off,On}>-15 Noise reduction
slider10:100<0,100,1>-15 Mix (%)
slider11:0<-24,12,0.1>-15 Output (dB)
slider12:0<-24,12,0.1>-15 Input trim (dB)
slider13:1<0,1,1{Off,On}>-15 Input guard
slider14:6<-6,24,0.1>-44 Gain (dB)
slider15:1000<200,5000,1>-44 Mid freq (Hz)
slider16:0<-12,12,0.1>-44 Mid gain (dB)
slider17:0<-10,10,0.1>-44 Treble (12 kHz) (dB)
slider18:0<-10,10,0.1>-44 Bass (80 Hz) (dB)
slider19:35<0,100,1>-44 Tape drive (%)
slider20:0<0,1,1{Normal (1 7/8 ips),Double (3 3/4 ips)}>-44 Speed
slider21:1<0,1,1{Off,On}>-44 Noise reduction
slider22:100<0,100,1>-44 Mix (%)
slider23:0<-24,12,0.1>-44 Output (dB)
slider24:0<-24,12,0.1>-44 Input trim (dB)
slider25:1<0,1,1{Off,On}>-44 Input guard
slider26:75<75,240,1>-FIELD HPF (Hz, 75 = off)
slider27:0<-20,40,0.1>-FIELD Trim (dB)
slider28:1<0,1,1{Off,On}>-FIELD Input limiter
slider29:0<0,1,1{Normal,Reversed}>-FIELD Polarity
slider30:0<-100,100,1>-FIELD Pan
slider31:0<-40,10,0.1>-FIELD Fader (dB)
slider32:2<0,2,1{Off,On,Link}>-FIELD Output limiter
slider33:20<4,20,1>-FIELD Output limiter threshold (dBu)
slider34:30<0,100,1>-FIELD Iron (output transformer, %)
slider35:0<0,1,1{Off,On}>-FIELD Tone
slider36:0<0,2,1{1 kHz,400 Hz,100 Hz}>-FIELD Tone frequency
slider37:0<-20,8,1>-FIELD Tone level (dBu)
slider38:50<0,100,1>-FIELD Drift (%)
slider39:30<0,100,1>-FIELD Input iron (%)
slider40:1<0.1,10,0.1>-FIELD Limiter attack (ms)
slider41:200<50,1000,1>-FIELD Limiter release (ms)
slider42:0<0,100,1>-Band sat (%)
slider43:30<0,100,1>-Bias (%)
slider44:120<40,400,1>-Sat low band (Hz)
slider45:6000<2000,16000,10>-Sat high band (Hz)
slider46:-0.3<-24,0,0.1>-Ceiling (dB)
slider47:0<-15,15,0.1>-12 Hi (dB)
slider48:0<-12,12,0.1>-12 Mid (dB)
slider49:0<-15,15,0.1>-12 Low (dB)
slider50:0<0,10,0.1>-12 Comp
slider51:0<-60,10,0.1>-12 Main mix (dB)
slider52:0<0,1,1{Off,On}>-12 Hot
slider53:0<0,1,1{Off,On}>-12 Desk noise
slider54:0<-24,24,0.1>-12 Gain (dB)
slider55:0<0,1,1{Off,On}>-12 HPF 80 Hz
slider56:prs_sel=0<0,24,1{No preset,Init,15: Bedroom Demo,15: Hot and Boxy,15: No NR - Open Tape,15: Worn-out Portable,15: Clean-ish Portable,44: Clean Double Speed,44: Normal Speed Warm,44: Rack Punch,44: Scooped Mids,44: No NR,12: Vocal,12: Acoustic Guitar,12: Bass DI,12: Keys,12: Hot and Noisy,FIELD: Init,FIELD: Dialogue Boom,FIELD: Lavalier,FIELD: Acoustic,FIELD: Drum Room,FIELD: Kick and Bass,FIELD: Hot Field,FIELD: Safety Net}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-channel-92";
ext_noinit = 1;
clp_kt_on = 1;
function s92_dl(x) instance(b, p) local(y) ( b[p] = x; y = b[(p - s92_lat) & 1023]; p = (p + 1) & 1023; y; );
function s92_dlclr() instance(b, p) ( memset(b, 0, 1024); p = 0; );
s92_dyL.b = 300000; s92_dyR.b = 301024;
s92_inL.b = 302048; s92_inR.b = 303072;
function s92_autor(a, b) local(i) ( i = a; loop(b - a + 1, ui_auto(i); i += 1; ); );

function m15_in_init() (
  m15_in_g = 1; m15_in_ag = 1; m15_in_ms = 0; m15_in_pk = 0; m15_in_comp = 1; m15_in_grd = 0; m15_in_env = 0;
  m15_in_dxL = 0; m15_in_dyL = 0; m15_in_dxR = 0; m15_in_dyR = 0;
  m15_in_dcc = 1 - 2 * $pi * 1 / srate;
  m15_in_msc  = 1 - exp(-1 / (0.3 * srate));
  m15_in_agc  = 1 - exp(-1 / (1.2 * srate));
  m15_in_gsm  = 1 - exp(-1 / (0.03 * srate));
  m15_in_catt = 1 - exp(-1 / (0.002 * srate));
  m15_in_crel = 1 - exp(-1 / (0.1 * srate));
);

function m15_in_setup(m15_trim_db, m15_guard) (
  m15_in_trim = 10 ^ (m15_trim_db / 20); m15_in_grdon = m15_guard;
);

function m15_in_process(m15_l, m15_r) local(m15_x, m15_ag_t, m15_pk, m15_ov, m15_cgr) (
  m15_x = m15_l - m15_in_dxL + m15_in_dcc * m15_in_dyL; m15_in_dxL = m15_l; m15_in_dyL = m15_x; m15_l = m15_x;
  m15_x = m15_r - m15_in_dxR + m15_in_dcc * m15_in_dyR; m15_in_dxR = m15_r; m15_in_dyR = m15_x; m15_r = m15_x;

  m15_in_g += (m15_in_trim - m15_in_g) * m15_in_gsm;
  m15_l *= m15_in_g; m15_r *= m15_in_g;

  m15_cgr = 0;
  m15_in_grdon ? (
    m15_in_ms += (0.5 * (m15_l * m15_l + m15_r * m15_r) - m15_in_ms) * m15_in_msc;
    m15_ag_t = m15_in_ms > 0.0159 ? 0.126 / sqrt(m15_in_ms) : 1;
    m15_in_ag += (m15_ag_t - m15_in_ag) * m15_in_agc;
    m15_l *= m15_in_ag; m15_r *= m15_in_ag;

    m15_pk = max(abs(m15_l), abs(m15_r));
    m15_in_env += (m15_pk - m15_in_env) * (m15_pk > m15_in_env ? m15_in_catt : m15_in_crel);
    m15_ov = 20 * log10(max(m15_in_env, 0.000001)) + 6;
    m15_cgr = m15_ov <= -3 ? 0 : ( m15_ov >= 3 ? 0.875 * m15_ov : 0.875 * (m15_ov + 3) * (m15_ov + 3) / 12 );
    m15_cgr > 0 ? ( m15_x = 10 ^ (-m15_cgr / 20); m15_l *= m15_x; m15_r *= m15_x; );
  ) : (
    m15_in_ag += (1 - m15_in_ag) * m15_in_gsm;
    m15_l *= m15_in_ag; m15_r *= m15_in_ag;
  );

  m15_in_grd = max(m15_in_grd, m15_cgr - 20 * log10(max(m15_in_ag, 0.0001)));
  m15_in_l = m15_l; m15_in_r = m15_r;
  m15_in_comp = 1;
  m15_in_pk = max(m15_in_pk, max(abs(m15_l), abs(m15_r)));
);

function m15_lc(u) local(a, q) (
  a = abs(u);
  a < 0.5 ? ( q = u * u; q * (0.5 - q * (0.0833333333333 - q * (0.0222222222222 - q * (0.00674603174603 - q * (0.00218694885362 - q * 0.00147717362455))))); )
          : a + log(1 + exp(-2 * a)) - m15_lcc;
);
m15_lcc = 0.5 + log(1 + exp(-1)) - 0.25 * (0.5 - 0.25 * (0.0833333333333 - 0.25 * (0.0222222222222 - 0.25 * (0.00674603174603 - 0.25 * (0.00218694885362 - 0.25 * 0.00147717362455)))));
function m15_ath(x, k, b, s) instance(x1, u1, f1, ms, es) local(u, f, du, y) (
  u = k * (x1 + b); u !== u1 ? ( u1 = u; f1 = m15_lc(u); );
  u = k * (x + b); f = m15_lc(u); du = u - u1;
  y = abs(du) > 0.00001 ? (f - f1) / du : ost_tanh(0.5 * (u + u1));
  ms += (sqr(x * k) - ms) * m15_aer; es += (ms - es) * m15_aes;
  x1 = x; u1 = u; f1 = f;
  y + 0.5 * du * s / sqrt(1 + 4 * s * s * es);
);
function m15_aaz() instance(x1, u1, f1, ms, es) ( x1 = u1 = f1 = ms = es = 0; );

function m15_f15_pre(m15_x) ( (this.m15_ath(m15_x * m15_g_lin, m15_pre_drv, m15_pre_bias, m15_pre_sl) - m15_pre_tb) / (m15_pre_drv * m15_pre_sl) );

function m15_f15_eq_set() instance(m15_ts, m15_bsf) ( m15_ts.bq_set(3, 10000, 0.6, m15_tr_db); m15_bsf.bq_set(4, 100, 0.6, m15_bs_db); );
function m15_f15_eq(m15_x) instance(m15_ts, m15_bsf, m15_ah, m15_al) local(m15_y, m15_addhi, m15_bsy, m15_addlo) (
  m15_y = m15_ts.bq_run(m15_x);
  m15_addhi = m15_tr_db ? m15_ah.m15_ath(m15_y - m15_x, m15_shelf_drv, 0, 1) / max(m15_shelf_drv, 0.0001) : m15_ah.x1 = 0;
  m15_y = m15_x + m15_addhi;
  m15_bsy = m15_bsf.bq_run(m15_y);
  m15_addlo = m15_bs_db ? m15_al.m15_ath(m15_bsy - m15_y, m15_shelf_drv * 0.6, 0, 1) / max(m15_shelf_drv * 0.6, 0.0001) : m15_al.x1 = 0;
  m15_y + m15_addlo;
);

function m15_f15_tape_set() instance(m15_hb) ( m15_hb.bq_set(2, 80, 1.1, 2.0); );
function m15_f15_tape(m15_x, m15_buf, m15_nz, m15_nron) instance(m15_hy, m15_env, m15_lp, m15_bhr, m15_ber, m15_bhp, m15_bep, m15_hsv, m15_hb, m15_at, m15_pf)
  local(m15_y, m15_h, m15_k, m15_cutoff, m15_lpc, m15_rp, m15_i, m15_fr, m15_duck) (
  m15_nron ? (
    m15_bhr += (m15_x - m15_bhr) * m15_b_c; m15_h = m15_x - m15_bhr;
    m15_ber += (abs(m15_h) - m15_ber) * m15_nr_c; m15_k = 2.0 * (1 - min(m15_ber / 0.06, 1));
    m15_y = m15_x + m15_k * m15_h;
  ) : m15_y = m15_x;
  m15_hy += (m15_y - m15_hy) * m15_hy_c;
  m15_y = 0.6 * m15_y + 0.4 * m15_hy;
  m15_y = m15_pf.clp_pf_run(m15_y);
  m15_y = m15_y + m15_tape_wet * ((m15_at.m15_ath(m15_y, m15_drv_k, m15_bias_tape, m15_tape_sl) - m15_tape_tb) / (m15_drv_k * m15_tape_sl) - m15_y);
  m15_y = m15_hb.bq_run(m15_y);
  m15_buf[m15_wpos] = m15_y;
  m15_rp = m15_wpos - m15_wdel; m15_rp < 0 ? m15_rp += m15_WBSZ;
  m15_i = floor(m15_rp); m15_fr = m15_rp - m15_i;
  m15_y = m15_buf[m15_i & m15_WBMSK] * (1 - m15_fr) + m15_buf[(m15_i + 1) & m15_WBMSK] * m15_fr;
  m15_env += (abs(m15_y) - m15_env) * m15_env_c;
  m15_cutoff = max(m15_hf_min, m15_hf_max - (m15_hf_max - m15_hf_min) * min(m15_env * m15_env_gain, 1));
  m15_lpc = 1 - exp(-2 * $pi * min(m15_cutoff, srate * 0.45) / srate);
  m15_lp += (m15_y - m15_lp) * m15_lpc;
  m15_y = m15_lp * m15_drop_g;
  m15_hsv += (abs(m15_x) - m15_hsv) * (abs(m15_x) > m15_hsv ? m15_hiss_fast : m15_hiss_slow);
  m15_duck = 1 / (1 + 4 * m15_hsv);
  m15_y += m15_nz * m15_hiss_g * m15_duck;
  m15_nron ? (
    m15_bhp += (m15_y - m15_bhp) * m15_b_c; m15_h = m15_y - m15_bhp;
    m15_bep += (abs(m15_h) - m15_bep) * m15_nr_c; m15_k = 2.0 * (1 - min(m15_bep / 0.06, 1));
    m15_y -= m15_k / (1 + m15_k) * m15_h;
  );
  m15_y;
);

function m15_pfblock() local(d) (
  d = max(slider5 - 35, 0) / 65;
  m15_tpL.m15_pf.clp_pf_block(d, srate, samplesblock); m15_tpR.m15_pf.clp_pf_block(d, srate, samplesblock);
);
function m15_update() (
  m15_g_db = slider2; m15_g_lin = 10 ^ (m15_g_db / 20);
  m15_pre_pos = max(m15_g_db, 0) / 24;
  m15_pre_drv = 1 + 2.2 * m15_pre_pos;
  m15_pre_bias = 0.05 + 0.11 * m15_pre_pos;
  m15_pre_tb = ost_tanh(m15_pre_drv * m15_pre_bias); m15_pre_sl = 1 - m15_pre_tb * m15_pre_tb;

  m15_tr_db = slider3; m15_bs_db = slider4;
  m15_shelf_drv = 1 + (abs(m15_tr_db) + abs(m15_bs_db)) / 10 * 1.1;

  m15_tape_amt = slider5 / 100;
  m15_hy_c = 1 - exp(-1 / (0.008 * srate));
  m15_drv_k = 1 + 2 * m15_tape_amt;
  m15_bias_tape = 0.03 + 0.05 * m15_tape_amt;
  m15_tape_wet = min(m15_tape_amt * 1.4, 1);
  m15_tape_tb = ost_tanh(m15_drv_k * m15_bias_tape); m15_tape_sl = 1 - m15_tape_tb * m15_tape_tb;
  m15_amk = 10 ^ (-0.007 * max(m15_g_db, 0) * (1 + 0.9 * max(slider5 - 35, 0) / 65) / 20);

  m15_age = slider8 / 100;
  m15_hf_max = 9500;
  m15_hf_min = max(2800, m15_hf_max - 6000 * m15_tape_amt - 2000 * m15_age);
  m15_env_c = 1 - exp(-1 / (0.015 * srate));
  m15_env_gain = 2 + 3 * m15_tape_amt;

  m15_b_c = 1 - exp(-2 * $pi * 3000 / srate);
  m15_nr_c = 1 - exp(-1 / (0.008 * srate));

  m15_wow_a = slider6 / 100;
  m15_hiss_g = (slider7 / 50) * 0.3 * 10 ^ (-50 / 20);
  m15_hiss_fast = 1 - exp(-1 / (0.01 * srate));
  m15_hiss_slow = 1 - exp(-1 / (0.4 * srate));
  m15_nr_on = slider9;
  m15_mix_t = slider10 / 100;
  m15_out_t = 10 ^ (slider11 / 20);

  m15_pfblock();
  m15_eqL.m15_f15_eq_set(); m15_eqR.m15_f15_eq_set();
  m15_tpL.m15_f15_tape_set(); m15_tpR.m15_f15_tape_set();
  m15_in_setup(slider12, slider13);
);

function m15_setp(m15_g, m15_tr, m15_bs, m15_dr, m15_w, m15_h, m15_a, m15_n, m15_mx, m15_o) (
  slider2 = m15_g; slider3 = m15_tr; slider4 = m15_bs; slider5 = m15_dr; slider6 = m15_w; slider7 = m15_h; slider8 = m15_a; slider9 = m15_n; slider10 = m15_mx; slider11 = m15_o;
);
function m15_load_preset(m15_p) (
  m15_p >= 1 ? m15_m15_dst = 1;
  m15_p == 1 ? m15_setp(6, 1, 1, 45, 25, 50, 15, 1, 100, -0.4) :
  m15_p == 2 ? m15_setp(15, 2, 2, 70, 35, 60, 25, 1, 100, -5.6) :
  m15_p == 3 ? m15_setp(9, 0, 0, 55, 30, 90, 20, 0, 100, -2.4) :
  m15_p == 4 ? m15_setp(12, -1, 3, 60, 70, 75, 65, 1, 100, -4.4) :
  m15_p == 5 ? m15_setp(0, 0, 0, 15, 15, 40, 5, 1, 100, 4.7);
  s92_autor(2, 11);
);

function m15_reset() (
  m15_age = m15_b_c = m15_bias_tape = m15_bs_db = m15_cur_preset = m15_dr_r = m15_drop_g = m15_drop_n = 0;
  m15_drop_t = m15_drv_k = m15_el = m15_env_c = m15_env_gain = m15_er = m15_fph = m15_g_db = m15_g_lin = 0;
  m15_hf_max = m15_hf_min = m15_hiss_fast = m15_hiss_g = m15_hiss_slow = m15_hy_c = m15_in_ag = m15_in_agc = 0;
  m15_in_catt = m15_in_comp = m15_in_crel = m15_in_dcc = m15_in_dxl = m15_in_dxr = m15_in_dyl = m15_in_dyr = 0;
  m15_in_env = m15_in_g = m15_in_grd = m15_in_grdon = m15_in_gsm = m15_in_l = m15_in_ms = m15_in_msc = 0;
  m15_in_pk = m15_in_r = m15_in_trim = m15_inl = m15_inr = m15_m15_dk = m15_m15_dkg = m15_m15_dkr = 0;
  m15_m15_dst = m15_m15_hc = m15_mix_s = m15_mix_t = m15_nr_c = m15_nr_on = m15_nz0 = m15_nz1 = m15_ol = 0;
  m15_or = m15_out_s = m15_out_t = m15_pl = m15_pr = m15_pre_bias = m15_pre_drv = m15_pre_pos = m15_shelf_drv = 0;
  m15_sm = m15_tape_amt = m15_tape_wet = m15_tl = m15_tr = m15_tr_db = m15_vu_sine = m15_vuc = m15_wbmsk = 0;
  m15_wbsz = m15_wdel = m15_wnd = m15_wow_a = m15_wph = m15_wpos = m15_eql.m15_bsf.a1 = m15_eql.m15_bsf.a2 = 0;
  m15_eql.m15_bsf.b0 = m15_eql.m15_bsf.b1 = m15_eql.m15_bsf.b2 = m15_eql.m15_bsf.x1 = m15_eql.m15_bsf.x2 = 0;
  m15_eql.m15_bsf.y1 = m15_eql.m15_bsf.y2 = m15_eql.m15_ts.a1 = m15_eql.m15_ts.a2 = m15_eql.m15_ts.b0 = 0;
  m15_eql.m15_ts.b1 = m15_eql.m15_ts.b2 = m15_eql.m15_ts.x1 = m15_eql.m15_ts.x2 = m15_eql.m15_ts.y1 = 0;
  m15_eql.m15_ts.y2 = m15_eqr.m15_bsf.a1 = m15_eqr.m15_bsf.a2 = m15_eqr.m15_bsf.b0 = m15_eqr.m15_bsf.b1 = 0;
  m15_eqr.m15_bsf.b2 = m15_eqr.m15_bsf.x1 = m15_eqr.m15_bsf.x2 = m15_eqr.m15_bsf.y1 = m15_eqr.m15_bsf.y2 = 0;
  m15_eqr.m15_ts.a1 = m15_eqr.m15_ts.a2 = m15_eqr.m15_ts.b0 = m15_eqr.m15_ts.b1 = m15_eqr.m15_ts.b2 = 0;
  m15_eqr.m15_ts.x1 = m15_eqr.m15_ts.x2 = m15_eqr.m15_ts.y1 = m15_eqr.m15_ts.y2 = m15_tpl.m15_bep = 0;
  m15_tpl.m15_ber = m15_tpl.m15_bhp = m15_tpl.m15_bhr = m15_tpl.m15_env = m15_tpl.m15_hb.a1 = 0;
  m15_tpl.m15_hb.a2 = m15_tpl.m15_hb.b0 = m15_tpl.m15_hb.b1 = m15_tpl.m15_hb.b2 = m15_tpl.m15_hb.x1 = 0;
  m15_tpl.m15_hb.x2 = m15_tpl.m15_hb.y1 = m15_tpl.m15_hb.y2 = m15_tpl.m15_hsv = m15_tpl.m15_hy = 0;
  m15_tpl.m15_lp = m15_tpr.m15_bep = m15_tpr.m15_ber = m15_tpr.m15_bhp = m15_tpr.m15_bhr = m15_tpr.m15_env = 0;
  m15_tpr.m15_hb.a1 = m15_tpr.m15_hb.a2 = m15_tpr.m15_hb.b0 = m15_tpr.m15_hb.b1 = m15_tpr.m15_hb.b2 = 0;
  m15_tpr.m15_hb.x1 = m15_tpr.m15_hb.x2 = m15_tpr.m15_hb.y1 = m15_tpr.m15_hb.y2 = m15_tpr.m15_hsv = 0;
  m15_tpr.m15_hy = m15_tpr.m15_lp = 0;
  m15_WBSZ = 8192; m15_WBMSK = m15_WBSZ - 1;
  memset(10000, 0, m15_WBSZ * 2);
  m15_in_init();
  m15_aer = 1 - exp(-1 / (0.01 * srate)); m15_aes = 1 - exp(-1 / (0.003 * srate));
  m15_paL.m15_aaz(); m15_paR.m15_aaz(); m15_eqL.m15_ah.m15_aaz(); m15_eqL.m15_al.m15_aaz(); m15_eqR.m15_ah.m15_aaz();
  m15_eqR.m15_al.m15_aaz(); m15_tpL.m15_at.m15_aaz(); m15_tpR.m15_at.m15_aaz();
  m15_tpL.m15_pf.clp_pf_cfg(40000, 12000, 0, 150); m15_tpR.m15_pf.clp_pf_cfg(40000, 12000, 0, 150);
  m15_tpL.m15_pf.clp_pf_reset(); m15_tpR.m15_pf.clp_pf_reset();
  m15_sm = 1 - exp(-1 / (0.02 * srate));
  m15_vuc = 1 - exp(-1 / (0.3 * srate));
  m15_vu_sine = 10 * log10(2);
  m15_dr_r = 1 - exp(-1 / (0.03 * srate));
  m15_wpos = 0; m15_drop_g = 1; m15_drop_t = 1;
  m15_update();
  m15_mix_s = m15_mix_t; m15_out_s = m15_out_t;
  m15_m15_dkr = 1 / (0.012 * srate);
  m15_m15_dk = 0; m15_m15_dst = 2; m15_m15_hc = floor(0.003 * srate);
);

function m15_run() (
  m15_in_process(spl0, spl1);
  m15_inL = m15_in_l; m15_inR = m15_in_r;
  m15_m15_dst == 1 ? ( m15_m15_dk -= m15_m15_dkr; m15_m15_dk <= 0 ? ( m15_m15_dk = 0; m15_update(); m15_m15_hc = floor(0.008 * srate); m15_m15_dst = 2; ); ) :
  m15_m15_dst == 2 ? ( m15_m15_hc > 0 ? m15_m15_hc -= 1 : ( m15_m15_dk += m15_m15_dkr; m15_m15_dk >= 1 ? ( m15_m15_dk = 1; m15_m15_dst = 0; ); ); );

  m15_wph += 0.6 / srate; m15_wph -= floor(m15_wph);
  m15_fph += 6.2 / srate; m15_fph -= floor(m15_fph);
  m15_wnd += ((rand(2) - 1) - m15_wnd) * 0.00002;
  m15_wdel = s92_lat + m15_wow_a * (0.45 * sin(2 * $pi * m15_wph) + 1.5 * m15_wnd + 0.06 * sin(2 * $pi * m15_fph)) * 0.001 * srate;
  m15_age > 0 && rand(1) < m15_age * m15_age * 1.2 / srate ? ( m15_drop_t = 10 ^ (-(2 + rand(6)) / 20); m15_drop_n = (0.01 + rand(1) * 0.04) * srate; );
  m15_drop_n > 0 ? m15_drop_n -= 1 : m15_drop_t = 1;
  m15_drop_g += (m15_drop_t - m15_drop_g) * m15_dr_r;
  m15_NZ0 += ((rand(2) - 1) - m15_NZ0) * 0.5;
  m15_NZ1 += ((rand(2) - 1) - m15_NZ1) * 0.5;

  m15_pL = m15_paL.m15_f15_pre(m15_inL); m15_pR = m15_paR.m15_f15_pre(m15_inR);
  m15_eL = m15_eqL.m15_f15_eq(m15_pL); m15_eR = m15_eqR.m15_f15_eq(m15_pR);
  m15_tL = m15_tpL.m15_f15_tape(m15_eL, 10000, m15_NZ0, m15_nr_on); m15_tR = m15_tpR.m15_f15_tape(m15_eR, 10000 + m15_WBSZ, m15_NZ1, m15_nr_on);
  m15_wpos = (m15_wpos + 1) & m15_WBMSK;
  m15_m15_dst ? ( m15_m15_dkg = m15_m15_dk * m15_m15_dk * (3 - 2 * m15_m15_dk); m15_tL *= m15_m15_dkg; m15_tR *= m15_m15_dkg; );

  m15_mix_s += (m15_mix_t - m15_mix_s) * m15_sm;
  m15_out_s += (m15_out_t - m15_out_s) * m15_sm;

  s92_dyn < 1000000 ? s92_dyn += 1; s92_dyg = min(max((s92_dyn - s92_lat) * s92_dyk, 0), 1);
  m15_oL = s92_dyL.s92_dl(m15_inL) * s92_dyg * (1 - m15_mix_s) + m15_tL * m15_mix_s * s92_mk15 * m15_amk;
  m15_oR = s92_dyR.s92_dl(m15_inR) * s92_dyg * (1 - m15_mix_s) + m15_tR * m15_mix_s * s92_mk15 * m15_amk;
);

cs_h0 = 0.036681502164; cs_h1 = 0.136547624632; cs_h2 = 0.274631759379; cs_h3 = 0.423138617437;
cs_h4 = 0.561098697879; cs_h5 = 0.677540049974; cs_h6 = 0.769741833863; cs_h7 = 0.839889624850;
cs_h8 = 0.892260818004; cs_h9 = 0.931541959963; cs_h10 = 0.962094548378; cs_h11 = 0.987816370733;
function cs_up(x) instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5,
  uy0, uy1, uy2, uy3, uy4, uy5, o0, o1) local(t, y) (
  t = x;
  y = cs_h0 * (t - ua0) + ux0; ux0 = t; ua0 = y; t = y;
  y = cs_h2 * (t - ua1) + ux1; ux1 = t; ua1 = y; t = y;
  y = cs_h4 * (t - ua2) + ux2; ux2 = t; ua2 = y; t = y;
  y = cs_h6 * (t - ua3) + ux3; ux3 = t; ua3 = y; t = y;
  y = cs_h8 * (t - ua4) + ux4; ux4 = t; ua4 = y; t = y;
  y = cs_h10 * (t - ua5) + ux5; ux5 = t; ua5 = y; o0 = y;
  t = x;
  y = cs_h1 * (t - ub0) + uy0; uy0 = t; ub0 = y; t = y;
  y = cs_h3 * (t - ub1) + uy1; uy1 = t; ub1 = y; t = y;
  y = cs_h5 * (t - ub2) + uy2; uy2 = t; ub2 = y; t = y;
  y = cs_h7 * (t - ub3) + uy3; uy3 = t; ub3 = y; t = y;
  y = cs_h9 * (t - ub4) + uy4; uy4 = t; ub4 = y; t = y;
  y = cs_h11 * (t - ub5) + uy5; uy5 = t; ub5 = y; o1 = y;
);
function cs_dn(s0, s1) instance(da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5,
  dy0, dy1, dy2, dy3, dy4, dy5) local(t, y, p) (
  t = s1;
  y = cs_h0 * (t - da0) + dx0; dx0 = t; da0 = y; t = y;
  y = cs_h2 * (t - da1) + dx1; dx1 = t; da1 = y; t = y;
  y = cs_h4 * (t - da2) + dx2; dx2 = t; da2 = y; t = y;
  y = cs_h6 * (t - da3) + dx3; dx3 = t; da3 = y; t = y;
  y = cs_h8 * (t - da4) + dx4; dx4 = t; da4 = y; t = y;
  y = cs_h10 * (t - da5) + dx5; dx5 = t; da5 = y; p = y;
  t = s0;
  y = cs_h1 * (t - db0) + dy0; dy0 = t; db0 = y; t = y;
  y = cs_h3 * (t - db1) + dy1; dy1 = t; db1 = y; t = y;
  y = cs_h5 * (t - db2) + dy2; dy2 = t; db2 = y; t = y;
  y = cs_h7 * (t - db3) + dy3; dy3 = t; db3 = y; t = y;
  y = cs_h9 * (t - db4) + dy4; dy4 = t; db4 = y; t = y;
  y = cs_h11 * (t - db5) + dy5; dy5 = t; db5 = y; y = y;
  0.5 * (p + y);
);
function cs_osclr() instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5,
  da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5, dy0, dy1, dy2, dy3, dy4, dy5) (
  ua0 = ua1 = ua2 = ua3 = ua4 = ua5 = ux0 = ux1 = ux2 = ux3 = ux4 = ux5 = ub0 = ub1 = ub2 = ub3 = ub4 = ub5 = uy0 = uy1 = uy2 = uy3 = uy4 = uy5 = 0;
  da0 = da1 = da2 = da3 = da4 = da5 = dx0 = dx1 = dx2 = dx3 = dx4 = dx5 = db0 = db1 = db2 = db3 = db4 = db5 = dy0 = dy1 = dy2 = dy3 = dy4 = dy5 = 0;
);
function cs_ostidy() instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5,
  da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5, dy0, dy1, dy2, dy3, dy4, dy5) (
  abs(ua0) < 0.000000000001 ? ua0 = 0; abs(ua1) < 0.000000000001 ? ua1 = 0; abs(ua2) < 0.000000000001 ? ua2 = 0; abs(ua3) < 0.000000000001 ? ua3 = 0; abs(ua4) < 0.000000000001 ? ua4 = 0; abs(ua5) < 0.000000000001 ? ua5 = 0;
  abs(ux0) < 0.000000000001 ? ux0 = 0; abs(ux1) < 0.000000000001 ? ux1 = 0; abs(ux2) < 0.000000000001 ? ux2 = 0; abs(ux3) < 0.000000000001 ? ux3 = 0; abs(ux4) < 0.000000000001 ? ux4 = 0; abs(ux5) < 0.000000000001 ? ux5 = 0;
  abs(ub0) < 0.000000000001 ? ub0 = 0; abs(ub1) < 0.000000000001 ? ub1 = 0; abs(ub2) < 0.000000000001 ? ub2 = 0; abs(ub3) < 0.000000000001 ? ub3 = 0; abs(ub4) < 0.000000000001 ? ub4 = 0; abs(ub5) < 0.000000000001 ? ub5 = 0;
  abs(uy0) < 0.000000000001 ? uy0 = 0; abs(uy1) < 0.000000000001 ? uy1 = 0; abs(uy2) < 0.000000000001 ? uy2 = 0; abs(uy3) < 0.000000000001 ? uy3 = 0; abs(uy4) < 0.000000000001 ? uy4 = 0; abs(uy5) < 0.000000000001 ? uy5 = 0;
  abs(da0) < 0.000000000001 ? da0 = 0; abs(da1) < 0.000000000001 ? da1 = 0; abs(da2) < 0.000000000001 ? da2 = 0; abs(da3) < 0.000000000001 ? da3 = 0; abs(da4) < 0.000000000001 ? da4 = 0; abs(da5) < 0.000000000001 ? da5 = 0;
  abs(dx0) < 0.000000000001 ? dx0 = 0; abs(dx1) < 0.000000000001 ? dx1 = 0; abs(dx2) < 0.000000000001 ? dx2 = 0; abs(dx3) < 0.000000000001 ? dx3 = 0; abs(dx4) < 0.000000000001 ? dx4 = 0; abs(dx5) < 0.000000000001 ? dx5 = 0;
  abs(db0) < 0.000000000001 ? db0 = 0; abs(db1) < 0.000000000001 ? db1 = 0; abs(db2) < 0.000000000001 ? db2 = 0; abs(db3) < 0.000000000001 ? db3 = 0; abs(db4) < 0.000000000001 ? db4 = 0; abs(db5) < 0.000000000001 ? db5 = 0;
  abs(dy0) < 0.000000000001 ? dy0 = 0; abs(dy1) < 0.000000000001 ? dy1 = 0; abs(dy2) < 0.000000000001 ? dy2 = 0; abs(dy3) < 0.000000000001 ? dy3 = 0; abs(dy4) < 0.000000000001 ? dy4 = 0; abs(dy5) < 0.000000000001 ? dy5 = 0;
);

function m44_in_init() (
  m44_in_g = 1; m44_in_ag = 1; m44_in_ms = 0; m44_in_pk = 0; m44_in_comp = 1; m44_in_grd = 0; m44_in_env = 0;
  m44_in_dxL = 0; m44_in_dyL = 0; m44_in_dxR = 0; m44_in_dyR = 0;
  m44_in_dcc = 1 - 2 * $pi * 1 / srate;
  m44_in_msc  = 1 - exp(-1 / (0.3 * srate));
  m44_in_agc  = 1 - exp(-1 / (1.2 * srate));
  m44_in_gsm  = 1 - exp(-1 / (0.03 * srate));
  m44_in_catt = 1 - exp(-1 / (0.002 * srate));
  m44_in_crel = 1 - exp(-1 / (0.1 * srate));
);

function m44_in_setup(m44_trim_db, m44_guard) (
  m44_in_trim = 10 ^ (m44_trim_db / 20); m44_in_grdon = m44_guard;
);

function m44_in_process(m44_l, m44_r) local(m44_x, m44_ag_t, m44_pk, m44_ov, m44_cgr) (
  m44_x = m44_l - m44_in_dxL + m44_in_dcc * m44_in_dyL; m44_in_dxL = m44_l; m44_in_dyL = m44_x; m44_l = m44_x;
  m44_x = m44_r - m44_in_dxR + m44_in_dcc * m44_in_dyR; m44_in_dxR = m44_r; m44_in_dyR = m44_x; m44_r = m44_x;

  m44_in_g += (m44_in_trim - m44_in_g) * m44_in_gsm;
  m44_l *= m44_in_g; m44_r *= m44_in_g;

  m44_cgr = 0;
  m44_in_grdon ? (
    m44_in_ms += (0.5 * (m44_l * m44_l + m44_r * m44_r) - m44_in_ms) * m44_in_msc;
    m44_ag_t = m44_in_ms > 0.0159 ? 0.126 / sqrt(m44_in_ms) : 1;
    m44_in_ag += (m44_ag_t - m44_in_ag) * m44_in_agc;
    m44_l *= m44_in_ag; m44_r *= m44_in_ag;

    m44_pk = max(abs(m44_l), abs(m44_r));
    m44_in_env += (m44_pk - m44_in_env) * (m44_pk > m44_in_env ? m44_in_catt : m44_in_crel);
    m44_ov = 20 * log10(max(m44_in_env, 0.000001)) + 6;
    m44_cgr = m44_ov <= -3 ? 0 : ( m44_ov >= 3 ? 0.875 * m44_ov : 0.875 * (m44_ov + 3) * (m44_ov + 3) / 12 );
    m44_cgr > 0 ? ( m44_x = 10 ^ (-m44_cgr / 20); m44_l *= m44_x; m44_r *= m44_x; );
  ) : (
    m44_in_ag += (1 - m44_in_ag) * m44_in_gsm;
    m44_l *= m44_in_ag; m44_r *= m44_in_ag;
  );

  m44_in_grd = max(m44_in_grd, m44_cgr - 20 * log10(max(m44_in_ag, 0.0001)));
  m44_in_l = m44_l; m44_in_r = m44_r;
  m44_in_comp = 1;
  m44_in_pk = max(m44_in_pk, max(abs(m44_l), abs(m44_r)));
);

function m44_vx_gain(m44_x) ( m44_x * m44_g_lin );

function m44_vx_eq_set() instance(m44_mid, m44_ts, m44_bsf) ( m44_mid.bq_set(2, m44_mid_hz, 0.9, m44_mid_db); m44_ts.bq_set(3, 12000, 0.7, m44_tr_db); m44_bsf.bq_set(4, 80, 0.7, m44_bs_db); );
function m44_vx_eq(m44_x) instance(m44_mid, m44_ts, m44_bsf) ( m44_bsf.bq_run(m44_ts.bq_run(m44_mid.bq_run(m44_x))) );

function m44_vx_ceil(m44_x) local(m44_a, m44_y) (
  m44_a = abs(m44_x);
  m44_a <= m44_vx_knee ? m44_y = m44_a : m44_y = m44_vx_knee + (1 - m44_vx_knee) * ost_tanh((m44_a - m44_vx_knee) * m44_vx_drv / max(1 - m44_vx_knee, 0.0001));
  sign(m44_x) * m44_y;
);

function m44_u2(x) instance(ua, ux, ub, uy, o0, o1) (
  o0 = 0.138024994073 * (x - ua) + ux; ux = x; ua = o0;
  o1 = 0.584683257487 * (x - ub) + uy; uy = x; ub = o1;
);
function m44_d2(s0, s1) instance(da, dx, db, dy) local(p, y) (
  p = 0.138024994073 * (s1 - da) + dx; dx = s1; da = p;
  y = 0.584683257487 * (s0 - db) + dy; dy = s0; db = y;
  0.5 * (p + y);
);
function m44_o2clr() instance(ua, ux, ub, uy, da, dx, db, dy) ( ua = ux = ub = uy = da = dx = db = dy = 0; );
function m44_o2tidy() instance(ua, ux, ub, uy, da, dx, db, dy) (
  abs(ua) < 0.000000000001 ? ua = 0; abs(ux) < 0.000000000001 ? ux = 0; abs(ub) < 0.000000000001 ? ub = 0; abs(uy) < 0.000000000001 ? uy = 0;
  abs(da) < 0.000000000001 ? da = 0; abs(dx) < 0.000000000001 ? dx = 0; abs(db) < 0.000000000001 ? db = 0; abs(dy) < 0.000000000001 ? dy = 0;
);
function m44_vx_g(m44_x) local(m44_a, m44_u, m44_c) (
  m44_a = abs(m44_x);
  m44_a <= m44_vx_knee ? m44_c = 0.5 * m44_x * m44_x : (
    m44_u = (m44_a - m44_vx_knee) * m44_vx_dk;
    m44_c = m44_vx_knee * m44_a + m44_vx_ck * (m44_u + log(1 + exp(-2 * min(m44_u, 300))) - 0.69314718056) - m44_vx_k2;
  );
  0.5 * m44_vx_dw * m44_x * m44_x + m44_tape_wet * m44_c;
);
function m44_vx_aa(m44_x) instance(x1, g1, cv1) local(m44_g, m44_d, m44_y) (
  cv1 !== m44_vx_cv ? ( cv1 = m44_vx_cv; g1 = m44_vx_g(x1); );
  m44_g = m44_vx_g(m44_x); m44_d = m44_x - x1;
  m44_y = abs(m44_d) > 0.00001 ? (m44_g - g1) / m44_d : ( m44_y = 0.5 * (m44_x + x1); m44_y + m44_tape_wet * (m44_vx_ceil(m44_y) - m44_y) );
  x1 = m44_x; g1 = m44_g;
  m44_y;
);

function m44_vx_tape_set() instance(m44_hp, m44_ds) ( m44_hp.bq_set(1, m44_sub_hz, 0.7, 0); m44_ds.bq_set(3, 0.3373 * srate, 0.4505, 0.613); );
function m44_vx_lblock() instance(m44_eo, m44_en, m44_lgt) (
  m44_lgt = m44_en > 0.0000000001 ? min(max(sqrt(m44_eo / m44_en), 0.8), 1.25) : 1;
  abs(m44_eo) < 0.000000000001 ? m44_eo = 0; abs(m44_en) < 0.000000000001 ? m44_en = 0;
);
function m44_vx_tape(m44_x, m44_nron) instance(m44_pe, m44_de, m44_hp, m44_lp, m44_ee, m44_ed, m44_os, m44_o2, m44_aa, m44_ds, m44_slp, m44_eo, m44_en, m44_lg, m44_lgt)
  local(m44_y, m44_lv, m44_a, m44_b) (
  m44_nron ? (
    m44_y = m44_pe.bq_run(m44_x);
    m44_ee += (m44_y * m44_y - m44_ee) * m44_nr_c + m44_DEN; m44_lv = 10 * log10(m44_ee);
    m44_y *= 10 ^ (min(-0.5 * (m44_lv + 20), 24) / 20);
  ) : m44_y = m44_x;
  m44_slp += (m44_y + m44_tape_wet * (m44_vx_ceil(m44_y) - m44_y) - m44_slp) * m44_hf_c; m44_eo += (m44_slp * m44_slp - m44_eo) * m44_lm_c;
  m44_os.cs_up(m44_y); m44_b = m44_os.o1;
  m44_o2.m44_u2(m44_os.o0); m44_a = m44_aa.m44_vx_aa(m44_o2.o0); m44_a = m44_o2.m44_d2(m44_a, m44_aa.m44_vx_aa(m44_o2.o1));
  m44_o2.m44_u2(m44_b); m44_b = m44_aa.m44_vx_aa(m44_o2.o0); m44_b = m44_o2.m44_d2(m44_b, m44_aa.m44_vx_aa(m44_o2.o1));
  m44_y = m44_ds.bq_run(m44_os.cs_dn(m44_a, m44_b));
  m44_lp += (m44_y - m44_lp) * m44_hf_c;
  m44_en += (m44_lp * m44_lp - m44_en) * m44_lm_c; m44_lg += (m44_lgt - m44_lg) * m44_lg_c;
  m44_y = m44_hp.bq_run(m44_lp * m44_lg);
  m44_nron ? (
    m44_ed += (m44_y * m44_y - m44_ed) * m44_nr_c + m44_DEN; m44_lv = 10 * log10(m44_ed);
    m44_y *= 10 ^ (max(m44_lv + 20, -60) / 20);
    m44_y = m44_de.bq_run(m44_y);
  );
  m44_y;
);

function m44_vx_dry(m44_x) instance(m44_os, m44_o2, m44_ds, x1) local(m44_a, m44_b) (
  m44_os.cs_up(m44_x); m44_b = m44_os.o1;
  m44_o2.m44_u2(m44_os.o0); m44_a = 0.5 * (m44_o2.o0 + x1); x1 = m44_o2.o1; m44_a = m44_o2.m44_d2(m44_a, 0.5 * (x1 + m44_o2.o0));
  m44_o2.m44_u2(m44_b); m44_b = 0.5 * (m44_o2.o0 + x1); x1 = m44_o2.o1; m44_b = m44_o2.m44_d2(m44_b, 0.5 * (x1 + m44_o2.o0));
  m44_ds.bq_run(m44_os.cs_dn(m44_a, m44_b));
);

function m44_dyclr() (
  m44_dyL.m44_os.cs_osclr(); m44_dyR.m44_os.cs_osclr(); m44_dyL.m44_o2.m44_o2clr(); m44_dyR.m44_o2.m44_o2clr(); m44_dyL.x1 = m44_dyR.x1 = 0;
  m44_dyL.m44_ds.x1 = m44_dyL.m44_ds.x2 = m44_dyL.m44_ds.y1 = m44_dyL.m44_ds.y2 = m44_dyR.m44_ds.x1 = m44_dyR.m44_ds.x2 = m44_dyR.m44_ds.y1 = m44_dyR.m44_ds.y2 = 0;
  m44_dyon = 0;
);

function m44_update() (
  m44_g_db = slider14; m44_g_lin = 10 ^ (m44_g_db / 20);

  m44_mid_hz = slider15; m44_mid_db = slider16; m44_tr_db = slider17; m44_bs_db = slider18;

  m44_tape_amt = slider19 / 100;
  m44_speed = slider20;
  m44_vx_knee = m44_speed ? 0.75 : 0.55;
  m44_vx_drv = 2 + 7 * m44_tape_amt;
  m44_tape_wet = min(m44_tape_amt * 2, 1);
  m44_vx_dk = m44_vx_drv / max(1 - m44_vx_knee, 0.0001); m44_vx_ck = (1 - m44_vx_knee) / m44_vx_dk; m44_vx_k2 = 0.5 * m44_vx_knee * m44_vx_knee;
  m44_vx_dw = 1 - m44_tape_wet;
  m44_vx_ck !== m44_vx_ck1 || m44_vx_knee !== m44_vx_kn1 || m44_tape_wet !== m44_vx_tw1 ? (
    m44_vx_cv += 1; m44_vx_ck1 = m44_vx_ck; m44_vx_kn1 = m44_vx_knee; m44_vx_tw1 = m44_tape_wet; );
  m44_sub_hz = m44_speed ? 45 : 25;
  m44_hf_hz = m44_speed ? 16000 : 10000;
  m44_hf_c = 1 - exp(-2 * $pi * min(m44_hf_hz, srate * 0.45) / srate);

  m44_nr_c = 1 - exp(-1 / (0.035 * srate));
  m44_nr_on = slider21;
  m44_mix_t = slider22 / 100;
  m44_out_t = 10 ^ (slider23 / 20);

  m44_eqL.m44_vx_eq_set(); m44_eqR.m44_vx_eq_set();
  m44_tpL.m44_pe.bq_set(3, 2000, 0.6, 10); m44_tpL.m44_de.bq_set(3, 2000, 0.6, -10);
  m44_tpR.m44_pe.bq_set(3, 2000, 0.6, 10); m44_tpR.m44_de.bq_set(3, 2000, 0.6, -10);
  m44_tpL.m44_vx_tape_set(); m44_tpR.m44_vx_tape_set();
  m44_tpL.m44_os.cs_ostidy(); m44_tpR.m44_os.cs_ostidy(); m44_tpL.m44_o2.m44_o2tidy(); m44_tpR.m44_o2.m44_o2tidy();
  m44_dyon ? ( m44_mix_s < 1 ? ( m44_dyL.m44_os.cs_ostidy(); m44_dyR.m44_os.cs_ostidy(); m44_dyL.m44_o2.m44_o2tidy(); m44_dyR.m44_o2.m44_o2tidy(); ) : m44_dyclr(); ); m44_tpL.m44_vx_lblock(); m44_tpR.m44_vx_lblock();
  m44_in_setup(slider24, slider25);
);

function m44_setp(m44_g, m44_mf, m44_mg, m44_tr, m44_bs, m44_dr, m44_sp, m44_n, m44_mx, m44_o) (
  slider14 = m44_g; slider15 = m44_mf; slider16 = m44_mg; slider17 = m44_tr; slider18 = m44_bs; slider19 = m44_dr; slider20 = m44_sp; slider21 = m44_n; slider22 = m44_mx; slider23 = m44_o;
);
function m44_load_preset(m44_p) (
  m44_p == 1 ? m44_setp(6, 1000, 0, 2, 0, 20, 1, 1, 100, -0.8) :
  m44_p == 2 ? m44_setp(9, 800, 1, 0, 1, 35, 0, 1, 100, -3.5) :
  m44_p == 3 ? m44_setp(14, 2500, 2, 3, 0, 55, 1, 1, 100, -9.4) :
  m44_p == 4 ? m44_setp(6, 600, -4, 1, 1, 25, 1, 1, 100, 0) :
  m44_p == 5 ? m44_setp(6, 1000, 0, 0, 0, 30, 0, 0, 100, -1.5);
  s92_autor(14, 23);
);

function m44_reset() (
  m44_bs_db = m44_cur_preset = m44_den = m44_el = m44_er = m44_g_db = m44_g_lin = m44_gl = m44_gr = m44_hf_c = 0;
  m44_hf_hz = m44_in_ag = m44_in_agc = m44_in_catt = m44_in_comp = m44_in_crel = m44_in_dcc = m44_in_dxl = 0;
  m44_in_dxr = m44_in_dyl = m44_in_dyr = m44_in_env = m44_in_g = m44_in_grd = m44_in_grdon = m44_in_gsm = 0;
  m44_in_l = m44_in_ms = m44_in_msc = m44_in_pk = m44_in_r = m44_in_trim = m44_inl = m44_inr = m44_mid_db = 0;
  m44_mid_hz = m44_mix_s = m44_mix_t = m44_nr_c = m44_nr_on = m44_ol = m44_or = m44_out_s = m44_out_t = m44_sm = 0;
  m44_speed = m44_sub_hz = m44_tape_amt = m44_tape_wet = m44_tl = m44_tr = m44_tr_db = m44_vu_sine = m44_vuc = 0;
  m44_vx_drv = m44_vx_knee = m44_eql.m44_bsf.a1 = m44_eql.m44_bsf.a2 = m44_eql.m44_bsf.b0 = m44_eql.m44_bsf.b1 = 0;
  m44_eql.m44_bsf.b2 = m44_eql.m44_bsf.x1 = m44_eql.m44_bsf.x2 = m44_eql.m44_bsf.y1 = m44_eql.m44_bsf.y2 = 0;
  m44_eql.m44_mid.a1 = m44_eql.m44_mid.a2 = m44_eql.m44_mid.b0 = m44_eql.m44_mid.b1 = m44_eql.m44_mid.b2 = 0;
  m44_eql.m44_mid.x1 = m44_eql.m44_mid.x2 = m44_eql.m44_mid.y1 = m44_eql.m44_mid.y2 = m44_eql.m44_ts.a1 = 0;
  m44_eql.m44_ts.a2 = m44_eql.m44_ts.b0 = m44_eql.m44_ts.b1 = m44_eql.m44_ts.b2 = m44_eql.m44_ts.x1 = 0;
  m44_eql.m44_ts.x2 = m44_eql.m44_ts.y1 = m44_eql.m44_ts.y2 = m44_eqr.m44_bsf.a1 = m44_eqr.m44_bsf.a2 = 0;
  m44_eqr.m44_bsf.b0 = m44_eqr.m44_bsf.b1 = m44_eqr.m44_bsf.b2 = m44_eqr.m44_bsf.x1 = m44_eqr.m44_bsf.x2 = 0;
  m44_eqr.m44_bsf.y1 = m44_eqr.m44_bsf.y2 = m44_eqr.m44_mid.a1 = m44_eqr.m44_mid.a2 = m44_eqr.m44_mid.b0 = 0;
  m44_eqr.m44_mid.b1 = m44_eqr.m44_mid.b2 = m44_eqr.m44_mid.x1 = m44_eqr.m44_mid.x2 = m44_eqr.m44_mid.y1 = 0;
  m44_eqr.m44_mid.y2 = m44_eqr.m44_ts.a1 = m44_eqr.m44_ts.a2 = m44_eqr.m44_ts.b0 = m44_eqr.m44_ts.b1 = 0;
  m44_eqr.m44_ts.b2 = m44_eqr.m44_ts.x1 = m44_eqr.m44_ts.x2 = m44_eqr.m44_ts.y1 = m44_eqr.m44_ts.y2 = 0;
  m44_tpl.m44_de.a1 = m44_tpl.m44_de.a2 = m44_tpl.m44_de.b0 = m44_tpl.m44_de.b1 = m44_tpl.m44_de.b2 = 0;
  m44_tpl.m44_de.x1 = m44_tpl.m44_de.x2 = m44_tpl.m44_de.y1 = m44_tpl.m44_de.y2 = m44_tpl.m44_ed = 0;
  m44_tpl.m44_ee = m44_tpl.m44_hp.a1 = m44_tpl.m44_hp.a2 = m44_tpl.m44_hp.b0 = m44_tpl.m44_hp.b1 = 0;
  m44_tpl.m44_hp.b2 = m44_tpl.m44_hp.x1 = m44_tpl.m44_hp.x2 = m44_tpl.m44_hp.y1 = m44_tpl.m44_hp.y2 = 0;
  m44_tpl.m44_lp = m44_tpl.m44_pe.a1 = m44_tpl.m44_pe.a2 = m44_tpl.m44_pe.b0 = m44_tpl.m44_pe.b1 = 0;
  m44_tpl.m44_pe.b2 = m44_tpl.m44_pe.x1 = m44_tpl.m44_pe.x2 = m44_tpl.m44_pe.y1 = m44_tpl.m44_pe.y2 = 0;
  m44_tpr.m44_de.a1 = m44_tpr.m44_de.a2 = m44_tpr.m44_de.b0 = m44_tpr.m44_de.b1 = m44_tpr.m44_de.b2 = 0;
  m44_tpr.m44_de.x1 = m44_tpr.m44_de.x2 = m44_tpr.m44_de.y1 = m44_tpr.m44_de.y2 = m44_tpr.m44_ed = 0;
  m44_tpr.m44_ee = m44_tpr.m44_hp.a1 = m44_tpr.m44_hp.a2 = m44_tpr.m44_hp.b0 = m44_tpr.m44_hp.b1 = 0;
  m44_tpr.m44_hp.b2 = m44_tpr.m44_hp.x1 = m44_tpr.m44_hp.x2 = m44_tpr.m44_hp.y1 = m44_tpr.m44_hp.y2 = 0;
  m44_tpr.m44_lp = m44_tpr.m44_pe.a1 = m44_tpr.m44_pe.a2 = m44_tpr.m44_pe.b0 = m44_tpr.m44_pe.b1 = 0;
  m44_tpr.m44_pe.b2 = m44_tpr.m44_pe.x1 = m44_tpr.m44_pe.x2 = m44_tpr.m44_pe.y1 = m44_tpr.m44_pe.y2 = 0;
  m44_tpL.m44_os.cs_osclr(); m44_tpR.m44_os.cs_osclr(); m44_tpL.m44_o2.m44_o2clr(); m44_tpR.m44_o2.m44_o2clr();
  m44_dyclr();
  m44_dyL.m44_ds.bq_set(3, 0.3373 * srate, 0.4505, 0.613); m44_dyR.m44_ds.bq_set(3, 0.3373 * srate, 0.4505, 0.613);
  m44_tpL.m44_slp = m44_tpL.m44_eo = m44_tpL.m44_en = m44_tpR.m44_slp = m44_tpR.m44_eo = m44_tpR.m44_en = 0;
  m44_tpL.m44_lg = m44_tpL.m44_lgt = m44_tpR.m44_lg = m44_tpR.m44_lgt = 1;
  m44_lm_c = 1 - exp(-1 / (0.1 * srate)); m44_lg_c = 1 - exp(-1 / (0.05 * srate));
  m44_tpL.m44_aa.x1 = m44_tpL.m44_aa.g1 = m44_tpR.m44_aa.x1 = m44_tpR.m44_aa.g1 = 0; m44_tpL.m44_aa.cv1 = m44_tpR.m44_aa.cv1 = -1;
  m44_tpL.m44_ds.x1 = m44_tpL.m44_ds.x2 = m44_tpL.m44_ds.y1 = m44_tpL.m44_ds.y2 = m44_tpR.m44_ds.x1 = m44_tpR.m44_ds.x2 = m44_tpR.m44_ds.y1 = m44_tpR.m44_ds.y2 = 0;
  m44_DEN = 0.00000000000000000001;
  m44_in_init();
  m44_sm = 1 - exp(-1 / (0.02 * srate));
  m44_vuc = 1 - exp(-1 / (0.3 * srate));
  m44_vu_sine = 10 * log10(2);
  m44_update();
  m44_mix_s = m44_mix_t; m44_out_s = m44_out_t;
);

function m44_run() (
  m44_in_process(spl0, spl1);
  m44_inL = m44_in_l; m44_inR = m44_in_r;

  m44_gL = m44_vx_gain(m44_inL); m44_gR = m44_vx_gain(m44_inR);
  m44_eL = m44_eqL.m44_vx_eq(m44_gL); m44_eR = m44_eqR.m44_vx_eq(m44_gR);
  m44_tL = m44_tpL.m44_vx_tape(m44_eL, m44_nr_on); m44_tR = m44_tpR.m44_vx_tape(m44_eR, m44_nr_on);

  m44_mix_s += (m44_mix_t - m44_mix_s) * m44_sm;
  m44_out_s += (m44_out_t - m44_out_s) * m44_sm;

  abs(m44_mix_t - m44_mix_s) < 0.000001 ? m44_mix_s = m44_mix_t;
  m44_mix_s < 1 ? ( m44_dyon = 1; m44_dyoL = m44_dyL.m44_vx_dry(m44_inL); m44_dyoR = m44_dyR.m44_vx_dry(m44_inR); ) : m44_dyoL = m44_dyoR = 0;
  m44_oL = m44_dyoL * (1 - m44_mix_s) + m44_tL * m44_mix_s * s92_mk44;
  m44_oR = m44_dyoR * (1 - m44_mix_s) + m44_tR * m44_mix_s * s92_mk44;
);

function f42_f4_hp(f42_f) instance(f42_b0, f42_b1, f42_b2, f42_a1, f42_a2) local(f42_w, f42_cw, f42_al, f42_d0) (
  f42_w = 2 * $pi * f42_f / srate; f42_cw = cos(f42_w); f42_al = sin(f42_w) / (2 * 0.7071); f42_d0 = 1 + f42_al;
  f42_b0 = (1 + f42_cw) / 2 / f42_d0; f42_b1 = -(1 + f42_cw) / f42_d0; f42_b2 = (1 + f42_cw) / 2 / f42_d0; f42_a1 = -2 * f42_cw / f42_d0; f42_a2 = (1 - f42_al) / f42_d0;
);
function f42_f4_bq(f42_x) instance(f42_b0, f42_b1, f42_b2, f42_a1, f42_a2, f42_z1, f42_z2) local(f42_y) (
  f42_y = f42_b0 * f42_x + f42_z1; f42_z1 = f42_b1 * f42_x - f42_a1 * f42_y + f42_z2; f42_z2 = f42_b2 * f42_x - f42_a2 * f42_y; f42_y;
);
function f42_f4_iron(f42_x, f42_amt, f42_drv) instance(f42_lf, f42_hf) local(f42_d, f42_c, f42_sc_) (
  f42_lf += (f42_x - f42_lf) * f42_f4_ia;
  f42_d = 1 + 5 * f42_drv * f42_amt;
  f42_c = f42_lf * f42_d; f42_sc_ = f42_c / sqrt(1 + f42_c * f42_c);
  f42_x += (f42_sc_ - f42_c) / f42_d * (0.6 + 0.4 * f42_amt) + f42_amt * 0.03 * f42_lf * f42_lf * f42_d;
  f42_hf += (f42_x - f42_hf) * f42_f4_ha;
  f42_x + (f42_hf - f42_x) * f42_amt * 0.35;
);
function f42_f4_rail(f42_x, f42_hv) ( f42_x / (1 + (abs(f42_x) / f42_hv) ^ 4) ^ 0.25; );

function f42_setp(f42_h, f42_t, f42_il, f42_ol, f42_th, f42_ir, f42_ii, f42_fd) ( slider26 = f42_h; slider27 = f42_t; slider28 = f42_il; slider32 = f42_ol; slider33 = f42_th + min(f42_fd, 0); slider34 = f42_ir; slider39 = f42_ii; slider31 = f42_fd; );
function f42_apply_preset(f42_n) (
  f42_n == 0 ? f42_setp( 75,  0, 1, 2, 20, 30, 30, 0) :
  f42_n == 1 ? f42_setp(120,  6, 1, 2, 18, 25, 25, -4.7) :
  f42_n == 2 ? f42_setp(160,  4, 1, 2, 18, 20, 20, -2.4) :
  f42_n == 3 ? f42_setp( 85,  4, 1, 2, 20, 30, 35, -2.9) :
  f42_n == 4 ? f42_setp( 75, 12, 1, 2, 14, 60, 55, -7.5) :
  f42_n == 5 ? f42_setp( 75,  6, 1, 1, 18, 70, 60, -5.6) :
  f42_n == 6 ? f42_setp( 75, 18, 1, 2, 12, 80, 80, -6.6) :
           f42_setp( 75,  0, 1, 2, 10, 20, 20, 0);
  ui_auto(26); ui_auto(27); ui_auto(28); ui_auto(31); ui_auto(32); ui_auto(33); ui_auto(34); ui_auto(39);
);

function f42_update() local(f42_th) (
  f42_hp_on = slider26 > 75.5;
  f42_hpL.f42_f4_hp(slider26); f42_hpR.f42_f4_hp(slider26);
  f42_trim = 10 ^ (slider27 / 20);
  f42_il_on = slider28 > 0.5; f42_pol = slider29 > 0.5 ? -1 : 1;
  f42_th = (slider30 / 100 + 1) * $pi / 4; f42_pnL = cos(f42_th) * sqrt(2); f42_pnR = sin(f42_th) * sqrt(2);
  f42_fad = slider31 <= -39.95 ? 0 : 10 ^ (slider31 / 20);
  f42_ol_m = floor(slider32 + 0.5); f42_ol_thr = slider33 - 20;
  f42_iron_o = slider34 / 100; f42_iron_i = slider39 / 100;
  f42_tone_on = slider35 > 0.5; f42_tone_f = slider36 < 0.5 ? 1000 : slider36 < 1.5 ? 400 : 100; f42_tone_a = 10 ^ ((slider37 - 20) / 20) * sqrt(2);
  drift_macro(slider38);
  f42_l_at = 1 - exp(-1 / (max(slider40, 0.05) * 0.001 * srate)); f42_l_rl = 1 - exp(-1 / (slider41 * 0.001 * srate));
);

function f42_reset() (
  f42_f4_ha = f42_f4_ia = f42_f4_trc = f42_f4_trs = f42_fad = f42_grl = f42_grr = f42_hp_on = f42_hv = 0;
  f42_il_e = f42_il_g = f42_il_gr = f42_il_hit = f42_il_on = f42_il_thr = f42_iron_i = f42_iron_o = f42_l_at = 0;
  f42_l_rl = f42_lastp = f42_lv = f42_ol_hit = f42_ol_m = f42_ol_t = f42_ol_thr = f42_oll_e = f42_olr_e = 0;
  f42_pnl = f42_pnr = f42_pol = f42_sag = f42_sag_c = f42_sup = f42_tn_ph = f42_tone_a = f42_tone_f = 0;
  f42_tone_on = f42_trim = f42_vu_c = f42_vu_e = f42_vu_sine = f42_vv = f42_xl = f42_xr = f42_drv.a = 0;
  f42_drv.b = f42_drv.ph = f42_drv.rm = f42_drv.v = f42_hpl.f42_a1 = f42_hpl.f42_a2 = f42_hpl.f42_b0 = 0;
  f42_hpl.f42_b1 = f42_hpl.f42_b2 = f42_hpl.f42_z1 = f42_hpl.f42_z2 = f42_hpr.f42_a1 = f42_hpr.f42_a2 = 0;
  f42_hpr.f42_b0 = f42_hpr.f42_b1 = f42_hpr.f42_b2 = f42_hpr.f42_z1 = f42_hpr.f42_z2 = f42_iil.f42_hf = 0;
  f42_iil.f42_lf = f42_iir.f42_hf = f42_iir.f42_lf = f42_iol.f42_hf = f42_iol.f42_lf = f42_ior.f42_hf = 0;
  f42_ior.f42_lf = 0;
  pk_in = 0;
  f42_drV.drift_init(0.8 + rand(1) * 0.5);
  f42_f4_ia = 1 - exp(-2 * $pi * 110 / srate);
  f42_f4_ha = 1 - exp(-2 * $pi * 14000 / srate);
  f42_vu_c = 1 - exp(-1 / (0.065 * srate));
  f42_vu_sine = 10 * log10(2);
  f42_sag_c = 1 - exp(-1 / (0.6 * srate));
  f42_update();
  f42_f4_trs = f42_trim; f42_f4_trc = 1 - exp(-1 / (0.02 * srate));
);

function f42_run() (
  f42_xL = spl0; f42_xR = spl1;
  f42_hp_on ? ( f42_xL = f42_hpL.f42_f4_bq(f42_xL); f42_xR = f42_hpR.f42_f4_bq(f42_xR); );
  f42_f4_trs != f42_trim ? ( f42_f4_trs += (f42_trim - f42_f4_trs) * f42_f4_trc; abs(f42_trim - f42_f4_trs) < 0.000001 * f42_trim ? f42_f4_trs = f42_trim; );
  f42_xL *= f42_f4_trs; f42_xR *= f42_f4_trs;
  f42_xL = f42_iiL.f42_f4_iron(f42_xL, f42_iron_i, f42_sup); f42_xR = f42_iiR.f42_f4_iron(f42_xR, f42_iron_i, f42_sup);
  f42_hv = 1.58 * f42_sup;
  f42_xL = f42_f4_rail(f42_xL, f42_hv); f42_xR = f42_f4_rail(f42_xR, f42_hv);
  f42_sag += (min((abs(f42_xL) + abs(f42_xR)) * 0.5, 2) - f42_sag) * f42_sag_c;

  f42_vu_e += ((f42_xL * f42_xL + f42_xR * f42_xR) * 0.5 - f42_vu_e) * f42_vu_c;
  pk_in = max(pk_in, max(abs(f42_xL), abs(f42_xR)));

  f42_il_on ? (
    f42_lv = max(abs(f42_xL), abs(f42_xR)); f42_il_e += (f42_lv - f42_il_e) * (f42_lv > f42_il_e ? f42_l_at : f42_l_rl);
    f42_il_gr = max(20 * log10(max(f42_il_e, 0.000001)) - f42_il_thr, 0) * 0.95;
    f42_il_g = 10 ^ (-f42_il_gr / 20); f42_xL *= f42_il_g; f42_xR *= f42_il_g;
    f42_il_hit = max(f42_il_hit, f42_il_gr);
  );

  f42_xL *= f42_pol * f42_fad * f42_pnL; f42_xR *= f42_pol * f42_fad * f42_pnR;

