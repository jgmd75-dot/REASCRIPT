function cs_set(g, hp, hi, mid, lo, cmp, mm, hot, nse) ( slider54 = g; slider55 = hp; slider47 = hi; slider48 = mid; slider49 = lo; slider50 = cmp; slider51 = mm; slider52 = hot; slider53 = nse; );
function cs_preset(p) (
  p == 1 ? cs_set(6, 1, 3, 2, -2, 4, -5.7, 0, 0) :
  p == 2 ? cs_set(4, 1, 4, -1, -3, 3, -3.3, 0, 0) :
  p == 3 ? cs_set(3, 0, -3, -2, 4, 6, -3.4, 0, 0) :
