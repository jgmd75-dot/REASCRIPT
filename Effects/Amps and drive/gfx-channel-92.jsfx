  slider1 = 0;
  slider2 = 6;
  slider3 = 0;
  slider4 = 0;
  slider5 = 35;
  slider6 = 25;
  slider7 = 50;
  slider8 = 15;
  slider9 = 1;
  slider10 = 100;
  slider11 = 0;
  slider12 = 0;
  slider13 = 1;
  slider14 = 6;
