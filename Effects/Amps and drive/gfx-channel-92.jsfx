  slider16 = 0;
  slider17 = 0;
  slider18 = 0;
  slider19 = 35;
  slider20 = 0;
  slider21 = 1;
  slider22 = 100;
  slider23 = 0;
  slider24 = 0;
  slider25 = 1;
  slider26 = 75;
  slider27 = 0;
  slider28 = 1;
  slider29 = 0;
  slider30 = 0;
  slider31 = 0;
  slider32 = 2;
