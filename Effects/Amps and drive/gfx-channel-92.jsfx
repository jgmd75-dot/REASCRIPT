function cs_eq_set(cs_hi, cs_mid, cs_lo) instance(cs_h, cs_m, cs_l) ( cs_h.bq_set(3, 12000, 0.7, cs_hi); cs_m.bq_set(2, 2500, 0.9, cs_mid); cs_l.bq_set(4, 80, 0.7, cs_lo); );
