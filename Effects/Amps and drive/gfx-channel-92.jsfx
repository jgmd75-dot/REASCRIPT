function s92_reset(m) ( m == 0 ? ( m15_reset(); s92_dyL.s92_dlclr(); s92_dyR.s92_dlclr(); s92_dyn = 0; ) : m == 1 ? m44_reset() : m == 2 ? cs_reset() : f42_reset(); );
