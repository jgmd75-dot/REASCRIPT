desc:Amp Head [guitar / bass amp] (GFX)
//tags: amp amplifier guitar bass valve tube cabinet reverb spring di tuner
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate, gfx-instrument, gfx-headsmooth and gfx-amp
// (.jsfx-inc) in the same folder.
//
// AMP HEAD - two all-valve amp heads in one plug-in; the MODEL keys choose which one is in the circuit (it replaces the
// former Guitar Head and Bass Head). Each model is the original plug-in ported sample for sample (it nulls against
// it), with its own controls and faceplate (personal use; the sound is designed from scratch).
//
//   GUITAR  an all-valve guitar amp with spring reverb and a 2x12 or 4x12 cabinet, in the spirit of the classic
//           50-watt heads.
//           GAIN        - the preamp. CLEAN: one valve, sparkly to edge-of-breakup. DRIVE: a second cascaded valve.
//           BRIGHT      - a treble lift ahead of the gain, strongest at low gain (as the real bright cap).
//           BASS / MIDDLE / TREBLE - the tone stack, 0..10 (5 = flat).
//           PRESENCE    - the top end after the power stage, 0..10.
//           REVERB      - a spring tank between the preamp and the power stage.
//           MASTER      - how hard the EL34-style power stage is driven: headroom, then sag and crunch.
//           CAB / MIC   - off (line out), 2x12 open back or 4x12 closed back, and the mic from on axis to off axis.
//           GATE        - a noise gate before the amp (fully down = off).   TUNER - shows the note and mutes the output.
//           TRUE STEREO, linked: L and R each go through their own identical amp channel (preamp, tone stack, spring
//           tank, power stage, cabinet), with every control shared. The two power stages
//           share one supply (one amp, one sag), the gate is linked, the two spring tanks are slightly different
//           lengths and the two mics sit a hair apart, so a mono source still opens up. MONO IN sums the input and
//           feeds both channels (for a mono guitar); off (the default), stereo sources stay stereo.
//   BASS    a big all-valve bass amp and an 8x10 cabinet, in the spirit of the classic 300-watt heads.
//           GAIN        - the preamp valve: clean and round low down, growling as it goes up.
//           ULTRA LO    - deep low lift with a scooped midrange.   ULTRA HI - a bright top-end lift.
//           BASS / TREBLE - shelves, +/-12 dB.   MIDRANGE - +/-12 dB at 220 / 450 / 800 / 1.6k / 3k (FREQUENCY).
//           MASTER      - how hard the push-pull power stage is driven: headroom, then sag and compression.
//           CAB / MIC   - the 8x10 cabinet on or off (line out), and the mic from on axis (bright) to off axis (dark).
//           DI BLEND    - the clean DI signal mixed under the amp.
//           GATE        - a noise gate before the amp (fully down = off).   TUNER - shows the note and mutes the output.
//           The amp runs in mono (as a real amp); both outputs carry it.
// ANTI-ALIASING (the house drive standard): both models run at the host rate (no oversampling, no latency) with
//   first-order ADAA on every valve stage (the preamp valves, the phase inverter and the power stage), a
//   drive-tracking pre-filter into the first valve (a low-pass sliding from 40 kHz, capped near the Nyquist, down to
//   9 kHz at full GAIN, and a low shelf easing the lows below 150 Hz down by up to 1.5 dB as GAIN rises) and a fixed
//   post-shelf per model that makes up the stages' top-end droop. The stages are smooth valve curves (no hard knee),
//   so there is no knee to track.
// GAIN glides (25 ms) with everything that follows it, so a jump never clicks. CAB off: the line out follows GAIN with
//   a shelf, a peak and a trim that keep its level and top end as the former 2x amp's.
//
// THEME colours the control panel, pinstripe and lamp (Graphite: red for GUITAR, blue for BASS); HW switches between
//   the faceplate and the flat look.
// DRIFT (parameter list only): the valves' bias wanders slightly. The DRIFT dial scales it (50% = the drift amount /
//   speed settings, 100% = twice, 0 = none). Shared by both models, as are the input TRIM / GUARD and the output stage.
// OUTPUT: the house output stage, CLIP always on (no keys; band SAT, BIAS, LOW / HIGH bands and CEILING in the
//   parameter list, as on the originals).
// MODEL SWITCH: only the selected model runs (CPU = that model). A change crossfades the outgoing model (frozen at
//   its settings) into the incoming one over 20 ms; the incoming model starts from a clean, reset state.
// PRESETS: the house preset bar. "Init" = GUITAR at its defaults, "BASS: Init" = BASS at its defaults, and factory
//   sounds for each model ("GUITAR: ..." / "BASS: ...", level-matched with the model's OUTPUT); choosing one also
//   selects its model. They set the model's tone only (MONO IN and the shared settings stay as they are).
//   "Reset all to defaults" (in the list) resets both models, the MODEL and the shared settings. A preset for the model in
//   use changes without a click (the output ducks for a moment while the new settings go in); one for the other
//   model crossfades.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-headsmooth.jsfx-inc
import gfx-amp.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{Guitar,Bass}>-Model
slider2:5<0,10,0.1>-GUITAR Gain
slider3:0<0,1,1{Off,On}>-GUITAR Bright
slider4:0<0,1,1{Clean,Drive}>-GUITAR Channel
slider5:5<0,10,0.1>-GUITAR Bass
slider6:5<0,10,0.1>-GUITAR Middle
slider7:5<0,10,0.1>-GUITAR Treble
slider8:5<0,10,0.1>-GUITAR Presence
slider9:4<0,10,0.1>-GUITAR Master
slider10:2<0,10,0.1>-GUITAR Reverb
slider11:-80<-80,-20,0.5>-GUITAR Gate threshold (dB, -80 = off)
slider12:1<0,2,1{Off,2x12 open,4x12 closed}>-GUITAR Cabinet
slider13:3<0,10,0.1>-GUITAR Mic position (on - off axis)
slider14:0<-24,12,0.1>-GUITAR Output (dB)
slider15:0<0,1,1{Off,On}>-GUITAR Tuner (mutes)
slider16:0<0,1,1{Off,On}>-GUITAR Mono in
slider17:4<0,10,0.1>-BASS Gain
slider18:0<0,1,1{Off,On}>-BASS Ultra lo
slider19:0<0,1,1{Off,On}>-BASS Ultra hi
slider20:0<-12,12,0.1>-BASS Bass (dB)
slider21:0<-12,12,0.1>-BASS Midrange (dB)
slider22:1<0,4,1{220 Hz,450 Hz,800 Hz,1.6 kHz,3 kHz}>-BASS Midrange frequency
slider23:0<-12,12,0.1>-BASS Treble (dB)
slider24:4<0,10,0.1>-BASS Master
slider25:-80<-80,-20,0.5>-BASS Gate threshold (dB, -80 = off)
slider26:1<0,1,1{Off,On}>-BASS Cabinet
slider27:3<0,10,0.1>-BASS Mic position (on - off axis)
slider28:0<0,100,1>-BASS DI blend (%)
slider29:0<-24,12,0.1>-BASS Output (dB)
slider30:0<0,1,1{Off,On}>-BASS Tuner (mutes)
slider31:0<-24,12,0.1>-Input trim (dB)
slider32:0<0,1,1{Off,On}>-Input guard
slider33:25<0,100,1>-Drift amount (%)
slider34:0.25<0.02,2,0.01>-Drift speed (Hz)
// DRIFT dial: scales how far the valves' bias wanders (the preamp valves and the power stage) and how fast
slider35:50<0,100,1>-Drift (%)
slider36:0<0,100,1>-Band sat (%)
slider37:30<0,100,1>-Bias (%)
slider38:120<40,400,1>-Sat low band (Hz)
slider39:6000<2000,16000,10>-Sat high band (Hz)
slider40:-0.3<-24,0,0.1>-Ceiling (dB)
slider41:prs_sel=0<0,20,1{No preset,Init,GUITAR: Clean Jazz,GUITAR: Sparkle Clean,GUITAR: Edge of Breakup,GUITAR: Classic Crunch,GUITAR: Rhythm Crunch 4x12,GUITAR: Hot Lead,GUITAR: Saturated Lead,GUITAR: Blues,GUITAR: Spring Surf,GUITAR: Ambient Clean,BASS: Init,BASS: DI Clean,BASS: Warm Valve,BASS: Vintage Round,BASS: Growl,BASS: Pick Rock,BASS: Fat Dub,BASS: Bright Slap,BASS: Overdriven}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-amp-head";                         // the ? pop-up links to this manual
ext_noinit = 1;                                    // @init runs once; a sample-rate change re-inits from @block
// host automation for a run of sliders
function ah_autor(a, b) local(i) ( i = a; loop(b - a + 1, ui_auto(i); i += 1; ); );

// memory: GUITAR spring tanks 200000 (L) and 300000 (R); the tuner (gfx-amp) 960000 - 966143; the level trims 966400 -
// 966454; the line-out tables 966500 - 966598. BASS uses none.

// ---------- the house drive standard (both models run at the host rate: no oversampling, no latency) ----------
// a valve stage, anti-aliased: am_tube's curve (tanh about the operating point b; unity small-signal gain, nothing out
// at rest) with first-order ADAA: y = (F(u) - F(u1)) / (u - u1) on u = x + b, F = ln cosh (tanh's antiderivative,
// one exp and one log), the curve read at the midpoint when the two are within 1e-5. ah_tset(b) per block (the
// bias): the last point is re-read on the shifted curve, so DRIFT never steps. The stages' top-end droop is made up
// by a fixed post-shelf per model.
function ah_tset(b) instance(tb, tt, tn, u1, f1) local(a) (
  b !== tb ? (
    u1 += b - tb; tb = b; tt = am_tanh(b); tn = 1 / (1 - tt * tt);
    a = abs(u1); f1 = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  );
);
function ah_tube(x) instance(tb, tt, tn, u1, f1) local(u, a, f, d, y) (
  u = x + tb; a = abs(u);
  f = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : am_tanh(0.5 * (u + u1));
  u1 = u; f1 = f;
  (y - tt) * tn;
);
function ah_tzero() instance(tb, tt, tn, u1, f1) ( tb = tt = u1 = f1 = 0; tn = 1; );
function ah_trest() instance(tb, u1, f1) local(a) ( u1 !== tb ? ( u1 = tb; a = abs(tb); f1 = a + log(1 + exp(-2 * a)) - 0.6931471805599453; ); );
// the spring tank at the host rate (gfx-amp's am_spring, with its chirp re-tuned: the allpasses' low-frequency delay
// is the same time as the original's at twice the rate, ah_sa / ah_se)
function ah_spring_init(mem, fs) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc) (
  b1 = mem; n1 = floor(0.0371 * fs); b2 = mem + n1 + 8; n2 = floor(0.0433 * fs);
  memset(mem, 0, n1 + n2 + 16); w1 = 0; w2 = 0; lp1 = 0; lp2 = 0;
  hp.am_bq(1, 250, 0.7, 0, fs); lc = 1 - exp(-2 * $pi * 3800 / fs);
);
function ah_spring_run(x, dwell) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, hp, lc, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) local(y, s1, s2, fb) (
  y = hp.am_run(x);
  y = d6.am_ap1(d5.am_ap1(d4.am_ap1(d3.am_ap1(d2.am_ap1(d1.am_ap1(y, ah_sa), ah_sa), ah_sa), ah_sa), ah_sa), ah_sa);   // the chirp
  fb = 0.55 + 0.35 * dwell;
  s1 = b1[w1]; s2 = b2[w2];
  lp1 += (s1 - lp1) * lc; lp2 += (s2 - lp2) * lc;
  b1[w1] = y + e1.am_ap1(e2.am_ap1(lp2 * fb, ah_se), ah_se);
  b2[w2] = y + e3.am_ap1(e4.am_ap1(lp1 * fb, ah_se), ah_se);
  w1 += 1; w1 >= n1 ? w1 = 0; w2 += 1; w2 >= n2 ? w2 = 0;
  (s1 + s2) * 0.5;
);
ah_sa = 0.3613; ah_se = 0.2;                       // (0.62 and 0.5 at twice the rate)
// the level trim: driven hard, the host-rate amp (pre-filter, anti-aliased stages) comes out a little louder than the
// former 2x amp did; these take it back (dB at GAIN / MASTER 0, 1 .. 10, measured on pink noise at -21 dBFS RMS):
// GUITAR clean, GUITAR drive, GUITAR master, BASS gain, BASS master. trim = gain row + half the master row.
AH_TRT = 966400;
function ah_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = AH_TRT + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
ah_row(0, 0, 0, 0, 0, 0, 0, 0.05, 0.17, 0.34, 0.58, 0.82);
ah_row(1, 0, 0, 0, 0, 0.02, 0.09, 0.17, 0.23, 0.29, 0.33, 0.36);
ah_row(2, 0, 0, 0, 0, 0, 0, 0.05, 0.14, 0.24, 0.43, 0.65);
ah_row(3, 0, 0, 0, 0, 0, 0.06, 0.17, 0.36, 0.57, 0.81, 0.99);
ah_row(4, 0, 0, 0, 0, 0, 0, 0.03, 0.11, 0.19, 0.36, 0.53);
function ah_trim(k, v) local(p, i, f, q) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i; q = AH_TRT + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
// GAIN glides (25 ms, per sample) and everything that follows it - the valves' drive, the pre-filter, the BRIGHT cap,
// the level trims and the line out - reads the glided value, so a jump of the knob never clicks
ah_gk = 1 - exp(-1 / (0.025 * srate));
// the line out (CAB off): driven harder, the host-rate amp's top end and level drift from the former 2x amp's; a high
// shelf (12 kHz), a peak (8 kHz) and a trim, all following GAIN, put them back (dB at GAIN 0, 1 .. 10, fitted on pink
// noise in 1/3 octaves): GUITAR clean, GUITAR drive, BASS - shelf, peak, trim rows
AH_LOT = 966500;
function ah_lrow(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = AH_LOT + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
ah_lrow(0, -2.66, -2.48, -1.93, -1.12, -0.05, 1.26, 2.74, 4.23, 5.45, 6.09, 6.06);
ah_lrow(1, -0.73, -0.68, -0.62, -0.52, -0.38, -0.18, 0.09, 0.43, 0.84, 1.28, 1.70);
ah_lrow(2, 0.12, 0.14, 0.16, 0.17, 0.16, 0.12, 0.08, 0.04, -0.04, -0.10, -0.18);
ah_lrow(3, 6.97, 7.33, 6.92, 5.12, 1.67, -1.83, -3.85, -4.97, -5.64, -6.01, -6.23);
ah_lrow(4, 0.58, 0.56, 0.66, 0.87, 1.06, 0.98, 0.75, 0.54, 0.45, 0.51, 0.70);
ah_lrow(5, -0.02, -0.01, -0.02, -0.07, -0.13, -0.14, -0.10, -0.07, -0.02, 0.01, 0.01);
ah_lrow(6, -0.78, -0.52, 0.01, 0.78, 1.78, 2.97, 4.19, 5.18, 5.68, 5.62, 5.25);
ah_lrow(7, -0.61, -0.59, -0.54, -0.46, -0.33, -0.14, 0.10, 0.40, 0.69, 0.93, 1.13);
ah_lrow(8, 0.10, 0.12, 0.14, 0.14, 0.11, 0.09, 0.05, 0.02, -0.03, -0.06, -0.11);
function ah_lo(k, v) local(p, i, f, q) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i; q = AH_LOT + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
// set one line-out pair (shelf, peak) for table set k (0 GUITAR clean, 3 GUITAR drive, 6 BASS) at GAIN g
function ah_loset(k, g) instance(s1, s2) (
  s1.am_bq(3, 0.25 * srate, 0.8, ah_lo(k, g), srate); s2.am_bq(2, 0.1666667 * srate, 0.7, ah_lo(k + 1, g), srate);
);

// ================================================================ GUITAR (ported from gfx-guitar-head)
// ---------- the amp core (host rate) ----------
// output transformer: the core saturates on flux (integrate, saturate, differentiate)
function ga_xf_run(ga_x, ga_k) instance(ga_ph, ga_sp) local(ga_s, ga_y) (
  ga_ph = ga_ph * ga_xf_lk + ga_x * ga_xf_c; ga_s = am_tanh(ga_ph * ga_k) / ga_k; ga_y = (ga_s - ga_sp * ga_xf_lk) / ga_xf_c; ga_sp = ga_s; ga_y;
);
// one amp channel (instance: ghL / ghR), in two halves: the preamp and its spring tank, then (after the two tank
// returns are blended, see GH_RVX) the power stage. The power supply (sup) is shared by both channels.
function ga_amp_pre(ga_x) instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt, ga_rv, ga_py, ga_ry, ga_v1, ga_v2, ga_pf) local(ga_y) (
  ga_y = ga_ihp.am_run(ga_pf.clp_pf_run(ga_x));             // the drive-tracking pre-filter (gfx-clip)
  ga_y = ga_brt.am_run(ga_y);                                // bright cap
  ga_y = ga_v1.ah_tube(ga_y * ga_g1);                        // V1 (bias ga_b1, anti-aliased)
  ga_y = ga_mil.am_run(ga_y);
  ga_s_drive ? (                                             // DRIVE: a second cascaded valve
    ga_y = ga_d2hp.am_run(ga_y); ga_y = ga_d2lp.am_run(ga_y);
    ga_y = ga_v2.ah_tube(ga_y * ga_g2) * ga_c2;              // (bias ga_b2)
  ) : (
    ga_y *= ga_c1;
    ga_v2.ah_trest();                                        // (V2 out of the circuit: at rest)
  );
  ga_y = ga_tb.am_run(ga_y); ga_y = ga_tm.am_run(ga_y); ga_y = ga_tt.am_run(ga_y);     // tone stack
  ga_py = ga_y; ga_ry = ga_rv.ah_spring_run(ga_y, 0.5);      // spring reverb tank
);
function ga_amp_post(ga_r) instance(ga_phc, ga_pres, ga_xfo, ga_py, ga_pa, ga_vpi, ga_vpw) local(ga_y) (
  ga_y = ga_py + ga_r * ga_rvw;                              // spring reverb return
  ga_y = ga_vpi.ah_tube(ga_y * 0.9);                         // phase inverter (bias -0.04)
  ga_y = ga_phc.am_run(ga_y) * ga_pm;                        // into the power stage (MASTER)
  ga_y = ga_sup * ga_vpw.ah_tube(ga_y / ga_sup);             // EL34-style push-pull: asymmetric (bias 0.22), with supply sag
  ga_pa = abs(ga_y);                                         // what this channel draws from the shared supply
  ga_y = ga_pres.am_run(ga_y);                               // presence (after the power stage)
  ga_y = ga_xfo.ga_xf_run(ga_y + ga_pbias * ga_y * ga_y, 0.6);
  ga_y * ga_mk;
);
// the shared supply sags on whichever channel draws the most (one amp, one power supply)
function ga_amp_sag() local(ga_a) (
  ga_a = max(ga_ghL.ga_pa, ga_ghR.ga_pa);
  ga_sgenv += (ga_a - ga_sgenv) * (ga_a > ga_sgenv ? ga_sg_att : ga_sg_rel);
  ga_sup = 1 - 0.35 * min(ga_sgenv, 1);
);
// a spring tank with its delay lengths scaled by k (the two channels' tanks differ slightly: decorrelated L / R)
// (its members are the spring's own, see am_spring_init)
function ga_gh_tank(ga_mem, ga_fs, ga_k) instance(b1, b2, n1, n2, w1, w2) (
  b1 = ga_mem; n1 = floor(0.0371 * ga_k * ga_fs); b2 = ga_mem + n1 + 8; n2 = floor(0.0433 * ga_k * ga_fs);
  memset(ga_mem, 0, n1 + n2 + 16); w1 = 0; w2 = 0;
);
// one channel's filters (both channels get identical coefficients: the controls are linked)
function ga_amp_set() instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt, ga_phc, ga_pres) local(ga_fs2) (
  ga_fs2 = srate;
  ga_ihp.am_bq(1, 70, 0.7, 0, ga_fs2);
  ga_brt.am_bq(3, 2500, 0.6, ga_s_brt ? 9 * (1 - ga_gs / 13) : 0, ga_fs2);
  ga_mil.am_bq(0, slider4 ? 9000 : 12000, 0.7, 0, ga_fs2);
  ga_d2hp.am_bq(1, 160, 0.7, 0, ga_fs2);                     // tight low end into the second valve
  ga_d2lp.am_bq(0, 6500, 0.7, 0, ga_fs2);
  ga_tb.am_bq(4, 110, 0.7, (slider5 - 5) * 2.4, ga_fs2);
  ga_tm.am_bq(2, 700, 0.8, (slider6 - 5) * 2.4 - 2, ga_fs2);
  ga_tt.am_bq(3, 3200, 0.7, (slider7 - 5) * 2.4, ga_fs2);
  ga_pres.am_bq(3, 4500, 0.7, slider8 * 1.1 - 3, ga_fs2);
  ga_phc.am_bq(1, 40, 0.7, 0, ga_fs2);
);
// the drive that follows GAIN, from the glided GAIN ga_gs: -4 .. +30 dB into V1, +6 .. +20 dB into V2 (DRIVE)
function ga_gset() (
  ga_g1 = exp(0.1151292546 * (ga_gs * 3.4 - 4)); ga_c1 = 1 / sqrt(ga_g1);
  ga_g2 = exp(0.1151292546 * (ga_gs * 1.4 + 6)); ga_c2 = 0.32 * max(1, 2.2 - ga_gs * 0.3);
);
// per sample: GAIN glides (only while it moves)
function ga_glide() (
  ga_gs !== ga_s_gain ? ( ga_gs += (ga_s_gain - ga_gs) * ah_gk; abs(ga_gs - ga_s_gain) < 0.00001 ? ga_gs = ga_s_gain; ga_gset(); );
);
// per block: OUTPUT with the level trims, and the line out (CAB off), from the glided GAIN
function ga_outset() local(k) (
  k = ga_s_drive ? 3 : 0;
  ga_out_t = 10 ^ ((ga_s_out - ah_trim(ga_s_drive ? 1 : 0, ga_gs) - 0.5 * ah_trim(2, ga_s_mst) + (ga_s_cab ? 0 : ah_lo(k + 2, ga_gs))) / 20);
  !ga_s_cab && (ga_gs !== ga_lgs || k !== ga_lk) ? ( ga_lgs = ga_gs; ga_lk = k; ga_loL.ah_loset(k, ga_gs); ga_loR.ah_loset(k, ga_gs); );
);
function ga_update() (
  ga_s_gain = slider2; ga_s_brt = slider3;                  // (GAIN: see ga_gset; the valves' drive follows it gliding)
  ga_pm = 10 ^ ((slider9 * 3.2 - 14) / 20); ga_mk = 0.5 / (ga_pm ^ 0.55);       // -14 .. +18 dB into the power stage
  ga_ghL.ga_amp_set(); ga_ghR.ga_amp_set();
  ga_rvw = (slider10 / 10) ^ 1.5 * 0.9;
