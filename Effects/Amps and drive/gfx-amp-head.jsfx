  ga_k1L.am_bq(2, 0.28304 * srate, 1.05, 13.43, srate); ga_k1R.am_bq(2, 0.28304 * srate, 1.05, 13.43, srate);
  ga_k2L.am_bq(3, 0.19492 * srate, 0.44, 1.05, srate); ga_k2R.am_bq(3, 0.19492 * srate, 0.44, 1.05, srate);
  ga_k1L.x1 = ga_k1L.x2 = ga_k1L.y1 = ga_k1L.y2 = ga_k2L.x1 = ga_k2L.x2 = ga_k2L.y1 = ga_k2L.y2 = 0;
  ga_k1R.x1 = ga_k1R.x2 = ga_k1R.y1 = ga_k1R.y2 = ga_k2R.x1 = ga_k2R.x2 = ga_k2R.y1 = ga_k2R.y2 = 0;
  ga_ghL.ga_rv.ah_spring_init(200000, srate); ga_ghL.ga_rv.ga_gh_tank(200000, srate, 1.0);   // L tank a little shorter,
  ga_ghR.ga_rv.ah_spring_init(300000, srate); ga_ghR.ga_rv.ga_gh_tank(300000, srate, 1.04);   // R a little longer
  ga_gh_mono = slider16;
  // the two tank returns are cross-blended a little, so the tanks stay decorrelated (width) but the centre
  // (L + R) keeps the old mono reverb level
  ga_GH_RVX = 0.4;
  ga_dB1.drift_init(0.8 + rand(0.5)); ga_dB2.drift_init(0.8 + rand(0.5));
  ga_sm = 1 - exp(-1 / (0.03 * srate));
  ga_gs = slider2; ga_lgs = -1;
  ga_update(); ga_gset(); ga_outset();
  ga_out_s = ga_out_t; ga_mute_s = 1;
);
// per block (after the settings): the valves' bias drift
function ga_blockrun() (
  ga_dinc = ga_dspd * samplesblock / srate;
  ga_b1 = 0.15 + 0.06 * ga_drift * ga_dB1.drift_tick(ga_dinc);
  ga_b2 = 0.20 + 0.05 * ga_drift * ga_dB2.drift_tick(ga_dinc);
  ga_pbias = 0.02 * ga_drift * ga_dB2.v;
  ga_ghL.ga_v1.ah_tset(ga_b1); ga_ghL.ga_v2.ah_tset(ga_b2); ga_ghR.ga_v1.ah_tset(ga_b1); ga_ghR.ga_v2.ah_tset(ga_b2);
  ga_ghL.ga_pf.clp_pf_block(ga_gs / 10, srate, samplesblock); ga_ghR.ga_pf.clp_pf_block(ga_gs / 10, srate, samplesblock);
  ga_s_brt && ga_gs !== ga_lbg ? ( ga_ghL.ga_brt.am_bq(3, 2500, 0.6, 9 * (1 - ga_gs / 13), srate); ga_ghR.ga_brt.am_bq(3, 2500, 0.6, 9 * (1 - ga_gs / 13), srate); );
  ga_lbg = ga_gs;
  ga_outset();
);
// one sample: in_l / in_r (after the input stage) -> ga_y / ga_gh_yr (into the output stage)
function ga_run() (
  ga_glide();
  ga_x = (in_l + in_r) * 0.5;
  ga_s_tun && ah_cur == 0 ? am_tun_push(ga_x);
  ga_gh_mono += (ga_s_mono - ga_gh_mono) * ga_sm;          // MONO IN: crossfade to the summed input on both channels
  ga_gh_xl = in_l + (ga_x - in_l) * ga_gh_mono; ga_gh_xr = in_r + (ga_x - in_r) * ga_gh_mono;
  ga_gh_g = ga_gt.am_gate(max(abs(ga_gh_xl), abs(ga_gh_xr)), ga_s_gate);    // linked gate
  ga_gh_xl *= ga_gh_g; ga_gh_xr *= ga_gh_g;
  // two amp channels (host rate), one shared supply
  ga_ghL.ga_amp_pre(ga_gh_xl); ga_ghR.ga_amp_pre(ga_gh_xr);
  ga_y = ga_ghL.ga_amp_post(ga_ghL.ga_ry + ga_ghR.ga_ry * ga_GH_RVX) * 2;     // (x 2: the level of the former 2x amp)
  ga_gh_yr = ga_ghR.ga_amp_post(ga_ghR.ga_ry + ga_ghL.ga_ry * ga_GH_RVX) * 2; ga_amp_sag();
  ga_y = ga_k2L.am_run(ga_k1L.am_run(ga_y)); ga_gh_yr = ga_k2R.am_run(ga_k1R.am_run(ga_gh_yr));   // the post-shelf
  ga_y = ga_ghcabL.am_cab_run(ga_y); ga_gh_yr = ga_ghcabR.am_cab_run(ga_gh_yr);
  !ga_s_cab ? ( ga_y = ga_loL.s2.am_run(ga_loL.s1.am_run(ga_y)); ga_gh_yr = ga_loR.s2.am_run(ga_loR.s1.am_run(ga_gh_yr)); );   // the line out
  ga_out_s += (ga_out_t - ga_out_s) * ga_sm;
  ga_mute_s += ((ga_s_tun ? 0 : 1) - ga_mute_s) * ga_sm;
  ga_y *= ga_out_s * ga_mute_s; ga_gh_yr *= ga_out_s * ga_mute_s;
);

// ================================================================ BASS (ported from gfx-bass-head)
// ---------- the amp core (host rate) ----------
// output transformer: the core saturates on flux (integrate, saturate, differentiate)
function ba_xf_run(ba_x, ba_k) instance(ba_ph, ba_sp) local(ba_s, ba_y) (
  ba_ph = ba_ph * ba_xf_lk + ba_x * ba_xf_c; ba_s = am_tanh(ba_ph * ba_k) / ba_k; ba_y = (ba_s - ba_sp * ba_xf_lk) / ba_xf_c; ba_sp = ba_s; ba_y;
);
function ba_amp_core(ba_x) local(ba_y) (
  ba_y = ba_ihp.am_run(ba_pf.clp_pf_run(ba_x));             // the drive-tracking pre-filter (gfx-clip)
  ba_y = ba_v1.ah_tube(ba_y * ba_g1);                        // V1 (bias ba_b1, anti-aliased)
  ba_y = ba_mil.am_run(ba_y) * ba_c1;
  ba_y = ba_tb.am_run(ba_y); ba_y = ba_tm.am_run(ba_y); ba_y = ba_tt.am_run(ba_y);     // tone stack
  ba_y = ba_ul1.am_run(ba_y); ba_y = ba_ul2.am_run(ba_y); ba_y = ba_uh.am_run(ba_y);
  ba_y = ba_c2hp.am_run(ba_y);
  ba_y = ba_v2.ah_tube(ba_y * 2.5) * 0.4;                    // V2 + cathode follower (bias ba_b2)
  ba_y = ba_vpi.ah_tube(ba_y * 0.9);                         // (bias -0.04)
  ba_y = ba_phc.am_run(ba_y) * ba_pm;                        // into the power stage (MASTER)
  ba_y = ba_sup * ba_vpw.ah_tube(ba_y / ba_sup);             // push-pull, with supply sag (symmetric: bias 0)
  ba_sgenv += (abs(ba_y) - ba_sgenv) * (abs(ba_y) > ba_sgenv ? ba_sg_att : ba_sg_rel);
  ba_sup = 1 - 0.3 * min(ba_sgenv, 1);
  ba_y = ba_xfo.ba_xf_run(ba_y + ba_pbias * ba_y * ba_y, 0.5);
  ba_y * ba_mk;
);
// the drive that follows GAIN, from the glided GAIN ba_gs: -6 .. +36 dB into V1
function ba_gset() ( ba_g1 = exp(0.1151292546 * (ba_gs * 4.2 - 6)); ba_c1 = 1 / sqrt(ba_g1); );
function ba_glide() (
  ba_gs !== ba_s_gain ? ( ba_gs += (ba_s_gain - ba_gs) * ah_gk; abs(ba_gs - ba_s_gain) < 0.00001 ? ba_gs = ba_s_gain; ba_gset(); );
);
function ba_outset() (
  ba_out_t = 10 ^ ((ba_s_out - ah_trim(3, ba_gs) - 0.5 * ah_trim(4, ba_s_mst) + (ba_s_cab ? 0 : ah_lo(8, ba_gs))) / 20);
  !ba_s_cab && ba_gs !== ba_lgs ? ( ba_lgs = ba_gs; ba_lo.ah_loset(6, ba_gs); );
);
function ba_update() local(ba_fs2, ba_mf) (
  ba_fs2 = srate;
  ba_pm = 10 ^ ((slider24 * 3.4 - 15) / 20); ba_mk = 0.55 / (ba_pm ^ 0.55);     // -15 .. +19 dB into the power stage
  ba_mf = slider22 == 0 ? 220 : slider22 == 1 ? 450 : slider22 == 2 ? 800 : slider22 == 3 ? 1600 : 3000;
  ba_ihp.am_bq(1, 35, 0.7, 0, ba_fs2);
  ba_mil.am_bq(0, 14000, 0.7, 0, ba_fs2);
  ba_tb.am_bq(4, 80, 0.7, slider20, ba_fs2);
  ba_tm.am_bq(2, ba_mf, 0.9, slider21, ba_fs2);
  ba_tt.am_bq(3, 5000, 0.7, slider23, ba_fs2);
  ba_ul1.am_bq(4, 40, 0.8, slider18 ? 4 : 0, ba_fs2);
  ba_ul2.am_bq(2, 500, 0.8, slider18 ? -10 : 0, ba_fs2);
  ba_uh.am_bq(3, 8000, 0.7, slider19 ? 8 : 0, ba_fs2);
  ba_c2hp.am_bq(1, 20, 0.7, 0, ba_fs2);
  ba_phc.am_bq(1, 25, 0.7, 0, ba_fs2);
  ba_cab.am_cab_set(slider26 ? 1 : 0, slider27);
  ba_dihp.am_bq(1, 30, 0.7, 0, srate);
  ba_di_t = slider28 / 100;
  ba_s_out = slider29; ba_s_mst = slider24; ba_s_cab = slider26;   // (OUTPUT and its trims: see ba_outset)
  drift_macro(slider35);
  ba_drift = slider33 / 100 * dm_a; ba_dspd = slider34 * dm_s;
  // the switches the audio reads (held with the rest of the settings while a model is frozen or a preset ducks)
  ba_s_gate = slider25; ba_s_tun = slider30; ba_s_gain = slider17;
);
function ba_reset() (
  // all state back to zero (as a fresh instance), then the original @init
  ba_b1 = ba_b2 = ba_c1 = ba_di_s = ba_di_t = ba_dinc = ba_drift = ba_dspd = ba_g1 = ba_mk = ba_mute_s = 0;
  ba_out_s = ba_out_t = ba_pbias = ba_pm = ba_s_gate = ba_s_tun = ba_sg_att = ba_sg_rel = ba_sgenv = ba_sm = 0;
  ba_sup = ba_x = ba_xf_c = ba_xf_lk = ba_y = ba_z = ba_c2hp.a1 = ba_c2hp.a2 = ba_c2hp.b0 = ba_c2hp.b1 = 0;
  ba_c2hp.b2 = ba_c2hp.x1 = ba_c2hp.x2 = ba_c2hp.y1 = ba_c2hp.y2 = ba_cab.c1.a1 = ba_cab.c1.a2 = ba_cab.c1.b0 = 0;
  ba_cab.c1.b1 = ba_cab.c1.b2 = ba_cab.c1.x1 = ba_cab.c1.x2 = ba_cab.c1.y1 = ba_cab.c1.y2 = ba_cab.c2.a1 = 0;
  ba_cab.c2.a2 = ba_cab.c2.b0 = ba_cab.c2.b1 = ba_cab.c2.b2 = ba_cab.c2.x1 = ba_cab.c2.x2 = ba_cab.c2.y1 = 0;
  ba_cab.c2.y2 = ba_cab.c3.a1 = ba_cab.c3.a2 = ba_cab.c3.b0 = ba_cab.c3.b1 = ba_cab.c3.b2 = ba_cab.c3.x1 = 0;
  ba_cab.c3.x2 = ba_cab.c3.y1 = ba_cab.c3.y2 = ba_cab.c4.a1 = ba_cab.c4.a2 = ba_cab.c4.b0 = ba_cab.c4.b1 = 0;
  ba_cab.c4.b2 = ba_cab.c4.x1 = ba_cab.c4.x2 = ba_cab.c4.y1 = ba_cab.c4.y2 = ba_cab.c5.a1 = ba_cab.c5.a2 = 0;
  ba_cab.c5.b0 = ba_cab.c5.b1 = ba_cab.c5.b2 = ba_cab.c5.x1 = ba_cab.c5.x2 = ba_cab.c5.y1 = ba_cab.c5.y2 = 0;
  ba_cab.c6.a1 = ba_cab.c6.a2 = ba_cab.c6.b0 = ba_cab.c6.b1 = ba_cab.c6.b2 = ba_cab.c6.x1 = ba_cab.c6.x2 = 0;
  ba_cab.c6.y1 = ba_cab.c6.y2 = ba_cab.c7.a1 = ba_cab.c7.a2 = ba_cab.c7.b0 = ba_cab.c7.b1 = ba_cab.c7.b2 = 0;
  ba_cab.c7.x1 = ba_cab.c7.x2 = ba_cab.c7.y1 = ba_cab.c7.y2 = ba_db1.a = ba_db1.b = ba_db1.ph = ba_db1.rm = 0;
  ba_db1.v = ba_db2.a = ba_db2.b = ba_db2.ph = ba_db2.rm = ba_db2.v = ba_dihp.a1 = ba_dihp.a2 = ba_dihp.b0 = 0;
  ba_dihp.b1 = ba_dihp.b2 = ba_dihp.x1 = ba_dihp.x2 = ba_dihp.y1 = ba_dihp.y2 = ba_dn.f1.a1 = ba_dn.f1.a2 = 0;
  ba_dn.f1.b0 = ba_dn.f1.b1 = ba_dn.f1.b2 = ba_dn.f1.x1 = ba_dn.f1.x2 = ba_dn.f1.y1 = ba_dn.f1.y2 = 0;
  ba_dn.f2.a1 = ba_dn.f2.a2 = ba_dn.f2.b0 = ba_dn.f2.b1 = ba_dn.f2.b2 = ba_dn.f2.x1 = ba_dn.f2.x2 = 0;
  ba_dn.f2.y1 = ba_dn.f2.y2 = ba_dn.f3.a1 = ba_dn.f3.a2 = ba_dn.f3.b0 = ba_dn.f3.b1 = ba_dn.f3.b2 = 0;
  ba_dn.f3.x1 = ba_dn.f3.x2 = ba_dn.f3.y1 = ba_dn.f3.y2 = ba_dn.f4.a1 = ba_dn.f4.a2 = ba_dn.f4.b0 = 0;
  ba_dn.f4.b1 = ba_dn.f4.b2 = ba_dn.f4.x1 = ba_dn.f4.x2 = ba_dn.f4.y1 = ba_dn.f4.y2 = ba_gt.env = ba_gt.g = 0;
  ba_gt.hold = ba_ihp.a1 = ba_ihp.a2 = ba_ihp.b0 = ba_ihp.b1 = ba_ihp.b2 = ba_ihp.x1 = ba_ihp.x2 = ba_ihp.y1 = 0;
  ba_ihp.y2 = ba_mil.a1 = ba_mil.a2 = ba_mil.b0 = ba_mil.b1 = ba_mil.b2 = ba_mil.x1 = ba_mil.x2 = ba_mil.y1 = 0;
  ba_mil.y2 = ba_phc.a1 = ba_phc.a2 = ba_phc.b0 = ba_phc.b1 = ba_phc.b2 = ba_phc.x1 = ba_phc.x2 = ba_phc.y1 = 0;
  ba_phc.y2 = ba_tb.a1 = ba_tb.a2 = ba_tb.b0 = ba_tb.b1 = ba_tb.b2 = ba_tb.x1 = ba_tb.x2 = ba_tb.y1 = ba_tb.y2 = 0;
  ba_tm.a1 = ba_tm.a2 = ba_tm.b0 = ba_tm.b1 = ba_tm.b2 = ba_tm.x1 = ba_tm.x2 = ba_tm.y1 = ba_tm.y2 = ba_tt.a1 = 0;
  ba_tt.a2 = ba_tt.b0 = ba_tt.b1 = ba_tt.b2 = ba_tt.x1 = ba_tt.x2 = ba_tt.y1 = ba_tt.y2 = ba_uh.a1 = ba_uh.a2 = 0;
  ba_uh.b0 = ba_uh.b1 = ba_uh.b2 = ba_uh.x1 = ba_uh.x2 = ba_uh.y1 = ba_uh.y2 = ba_ul1.a1 = ba_ul1.a2 = 0;
  ba_ul1.b0 = ba_ul1.b1 = ba_ul1.b2 = ba_ul1.x1 = ba_ul1.x2 = ba_ul1.y1 = ba_ul1.y2 = ba_ul2.a1 = ba_ul2.a2 = 0;
  ba_ul2.b0 = ba_ul2.b1 = ba_ul2.b2 = ba_ul2.x1 = ba_ul2.x2 = ba_ul2.y1 = ba_ul2.y2 = ba_up.f1.a1 = 0;
  ba_up.f1.a2 = ba_up.f1.b0 = ba_up.f1.b1 = ba_up.f1.b2 = ba_up.f1.x1 = ba_up.f1.x2 = ba_up.f1.y1 = 0;
  ba_up.f1.y2 = ba_up.f2.a1 = ba_up.f2.a2 = ba_up.f2.b0 = ba_up.f2.b1 = ba_up.f2.b2 = ba_up.f2.x1 = 0;
  ba_up.f2.x2 = ba_up.f2.y1 = ba_up.f2.y2 = ba_up.f3.a1 = ba_up.f3.a2 = ba_up.f3.b0 = ba_up.f3.b1 = 0;
  ba_up.f3.b2 = ba_up.f3.x1 = ba_up.f3.x2 = ba_up.f3.y1 = ba_up.f3.y2 = ba_up.f4.a1 = ba_up.f4.a2 = 0;
  ba_up.f4.b0 = ba_up.f4.b1 = ba_up.f4.b2 = ba_up.f4.x1 = ba_up.f4.x2 = ba_up.f4.y1 = ba_up.f4.y2 = 0;
  ba_xfo.ba_ph = ba_xfo.ba_sp = 0;
  ba_xf_c = 2 * $pi * 40 / srate; ba_xf_lk = 1 - 2 * $pi * 5 / srate;
  ba_sg_att = 1 - exp(-1 / (0.005 * srate)); ba_sg_rel = 1 - exp(-1 / (0.12 * srate));
  ba_sup = 1; ba_sgenv = 0;
  ba_v1.ah_tzero(); ba_v2.ah_tzero(); ba_vpi.ah_tzero(); ba_vpw.ah_tzero(); ba_vpi.ah_tset(-0.04);
  ba_pf.clp_pf_cfg(40000, 9000, -1.5, 150); ba_pf.clp_pf_reset();   // 40 kHz (capped) to 9 kHz, -1.5 dB lows
  // the fixed post-shelf (as GUITAR's; fitted at the default GAIN, within 0.02 dB from 500 Hz to 11 kHz, cab off)
  ba_k1.am_bq(2, 0.27808 * srate, 1.02, 12.82, srate); ba_k2.am_bq(3, 0.16527 * srate, 0.54, 2.76, srate);
  ba_k1.x1 = ba_k1.x2 = ba_k1.y1 = ba_k1.y2 = ba_k2.x1 = ba_k2.x2 = ba_k2.y1 = ba_k2.y2 = 0;
  ba_dB1.drift_init(0.8 + rand(0.5)); ba_dB2.drift_init(0.8 + rand(0.5));
  ba_sm = 1 - exp(-1 / (0.03 * srate));
  ba_gs = slider17; ba_lgs = -1;
  ba_update(); ba_gset(); ba_outset();
  ba_out_s = ba_out_t; ba_di_s = ba_di_t; ba_mute_s = 1;
);
function ba_blockrun() (
  ba_dinc = ba_dspd * samplesblock / srate;
  ba_b1 = 0.15 + 0.06 * ba_drift * ba_dB1.drift_tick(ba_dinc);
  ba_b2 = 0.10 + 0.05 * ba_drift * ba_dB2.drift_tick(ba_dinc);
  ba_pbias = 0.02 * ba_drift * ba_dB2.v;
  ba_v1.ah_tset(ba_b1); ba_v2.ah_tset(ba_b2);
  ba_pf.clp_pf_block(ba_gs / 10, srate, samplesblock);
  ba_outset();
);
// one sample: in_l / in_r -> ba_y (mono, into both sides of the output stage)
function ba_run() (
  ba_glide();
  ba_x = (in_l + in_r) * 0.5;
  ba_s_tun && ah_cur == 1 ? am_tun_push(ba_x);
  ba_x *= ba_gt.am_gate(ba_x, ba_s_gate);
  ba_y = ba_amp_core(ba_x) * 2;                              // the amp (host rate; x 2: the level of the former 2x amp)
  ba_y = ba_k2.am_run(ba_k1.am_run(ba_y));                   // the post-shelf
  ba_y = ba_cab.am_cab_run(ba_y);
  !ba_s_cab ? ba_y = ba_lo.s2.am_run(ba_lo.s1.am_run(ba_y));     // the line out
  ba_di_s += (ba_di_t - ba_di_s) * ba_sm; ba_out_s += (ba_out_t - ba_out_s) * ba_sm;
  ba_mute_s += ((ba_s_tun ? 0 : 1) - ba_mute_s) * ba_sm;
  ba_y = (ba_y * (1 - ba_di_s) + ba_dihp.am_run(ba_x) * ba_di_s) * ba_out_s * ba_mute_s;
);

// ================================================================ the Amp Head chassis
// MODEL: 0 = GUITAR, 1 = BASS. The selected model: reset (clean state + its own init), settings, per-block work, one
// sample (result in ah_rL / R).
function ah_reset(m) ( m ? ba_reset() : ga_reset(); );
function ah_upd(m) ( m ? ba_update() : ga_update(); );
function ah_block(m) (
  !(ah_dst == 1 && m == ah_cur) ? ah_upd(m);        // a preset for the model in use waits for the duck's silence
  m ? ba_blockrun() : ga_blockrun();
);
function ah_run(m) (
  m ? ( ba_run(); ah_rL = ah_rR = ba_y; ) : ( ga_run(); ah_rL = ga_y; ah_rR = ga_gh_yr; );
);
// the shared input stage (TRIM / GUARD) and output stage (CLIP, always on), as on the originals
function ah_chassis() (
  ah_dst != 1 ? (
    in_setup(slider31, slider32);
    ost_setup(slider36 / 100, slider37 / 100, slider38, slider39, slider40, 1);   // output stage: CLIP, always on
  );
);
// MODEL change: start the 20 ms crossfade into a freshly reset incoming model. A change back during a fade turns
// the fade round from where it is (both models keep running, nothing is reset), so nothing steps.
function ah_switch() local(m) (
  m = min(max(floor(slider1 + 0.5), 0), 1);
  m != ah_cur ? (
    ah_xf && m == ah_old ? ( ah_old = ah_cur; ah_cur = m; ah_xt = 1 - ah_xt; )
                         : ( ah_old = ah_cur; ah_cur = m; ah_reset(m); ah_xt = 0; ah_xf = 1; );
  );
);
// everything that depends on the sample rate
function ah_srinit() (
  ah_sr = srate; ah_gk = 1 - exp(-1 / (0.025 * srate));
  ost_init(20000); ah_ostL.ost_ch_init(); ah_ostR.ost_ch_init();
  in_init();
  ah_cur = min(max(floor(slider1 + 0.5), 0), 1); ah_xf = 0; ah_xt = 0;
  ah_dst = 0;
  ah_reset(ah_cur);
  ah_chassis();
  ah_xfc = 1 / (0.02 * srate);
  ah_dkr = 1 / (0.012 * srate); ah_dk = 1;          // the preset duck
  ah_mpk = 0;
);

// ---------------------------------------------------------------- presets
function ga_defaults() (
  slider2 = 5;
  slider3 = 0;
  slider4 = 0;
  slider5 = 5;
  slider6 = 5;
  slider7 = 5;
  slider8 = 5;
  slider9 = 4;
  slider10 = 2;
  slider11 = -80;
  slider12 = 1;
  slider13 = 3;
  slider14 = 0;
  slider15 = 0;
  slider16 = 0;
);
function ba_defaults() (
  slider17 = 4;
  slider18 = 0;
  slider19 = 0;
  slider20 = 0;
  slider21 = 0;
  slider22 = 1;
  slider23 = 0;
  slider24 = 4;
  slider25 = -80;
  slider26 = 1;
  slider27 = 3;
  slider28 = 0;
  slider29 = 0;
  slider30 = 0;
);
// a GUITAR / BASS factory preset: the model and its tone (MONO IN is left as it is; the tuner goes off)
function ga_pp(g, br, ch, b, m, t, pr, ms, rv, gt, cab, mic, out) (
  slider1 = 0; slider2 = g; slider3 = br; slider4 = ch; slider5 = b; slider6 = m; slider7 = t; slider8 = pr;
  slider9 = ms; slider10 = rv; slider11 = gt; slider12 = cab; slider13 = mic; slider14 = out; slider15 = 0;
  ah_autor(1, 15);
);
function ba_pp(g, ul, uh, b, m, mf, t, ms, gt, cab, mic, di, out) (
  slider1 = 1; slider17 = g; slider18 = ul; slider19 = uh; slider20 = b; slider21 = m; slider22 = mf; slider23 = t;
  slider24 = ms; slider25 = gt; slider26 = cab; slider27 = mic; slider28 = di; slider29 = out; slider30 = 0;
  ui_auto(1); ah_autor(17, 30);
);
function ah_load(p) (
  p == 1 ? ( slider1 = 0; ga_defaults(); ah_autor(1, 16); ) :          // Init = GUITAR at its defaults
  p == 2 ? ga_pp(2.5, 0, 0, 6.5, 5, 3.5, 3, 3, 1.5, -80, 1, 6, 3.5) :   // GUITAR: Clean Jazz
  p == 3 ? ga_pp(3, 1, 0, 5, 4, 6.5, 6, 3.5, 4.5, -80, 1, 2, -3.2) :   // GUITAR: Sparkle Clean
  p == 4 ? ga_pp(6, 1, 0, 5, 6, 6, 5, 5.5, 2, -80, 1, 3, -5.4) :   // GUITAR: Edge of Breakup
  p == 5 ? ga_pp(6, 0, 1, 5.5, 7, 6, 5.5, 6, 1.5, -70, 2, 3, -7) :   // GUITAR: Classic Crunch
  p == 6 ? ga_pp(7, 0, 1, 6.5, 6, 6.5, 6, 6.5, 0.5, -64, 2, 2.5, -7.7) :   // GUITAR: Rhythm Crunch 4x12
  p == 7 ? ga_pp(8, 0, 1, 5.5, 7.5, 6, 6, 6, 2.5, -66, 2, 4, -7.6) :   // GUITAR: Hot Lead
  p == 8 ? ga_pp(10, 0, 1, 6, 6.5, 5.5, 5, 7, 3, -60, 2, 5, -6.2) :   // GUITAR: Saturated Lead
  p == 9 ? ga_pp(7, 1, 0, 5, 7, 5.5, 5, 6.5, 2.5, -80, 1, 4, -5.4) :   // GUITAR: Blues
  p == 10 ? ga_pp(4, 1, 0, 4, 4.5, 7, 6.5, 4, 8, -80, 1, 2, -5.8) :   // GUITAR: Spring Surf
  p == 11 ? ga_pp(2.5, 0, 0, 5.5, 4, 5.5, 4.5, 3, 7, -80, 1, 5, 2) :   // GUITAR: Ambient Clean
  p == 12 ? ( slider1 = 1; ba_defaults(); ui_auto(1); ah_autor(17, 30); ) :   // BASS: Init
  p == 13 ? ba_pp(2.5, 0, 0, 0, 0, 1, 1, 3, -80, 0, 3, 60, 2.7) :   // BASS: DI Clean
  p == 14 ? ba_pp(4.5, 0, 0, 3, 1, 1, -2, 5, -80, 1, 5, 0, -1.4) :   // BASS: Warm Valve
  p == 15 ? ba_pp(3.5, 0, 0, 4, -1, 0, -6, 4.5, -80, 1, 8, 10, 2.1) :   // BASS: Vintage Round
  p == 16 ? ba_pp(7, 0, 0, 2, 5, 2, 2, 6, -80, 1, 3, 25, -1.5) :   // BASS: Growl
  p == 17 ? ba_pp(6, 0, 1, 2, 3, 3, 4, 6.5, -80, 1, 2, 20, -4.1) :   // BASS: Pick Rock
  p == 18 ? ba_pp(4, 1, 0, 6, -3, 2, -9, 4.5, -80, 1, 9, 0, 2.7) :   // BASS: Fat Dub
  p == 19 ? ba_pp(3, 1, 1, 3, -4, 1, 5, 4, -80, 1, 1, 35, 3.2) :   // BASS: Bright Slap
  p == 20 ? ba_pp(9.5, 0, 0, 2, 4, 2, 3, 7.5, -66, 1, 3, 30, 0) :   // BASS: Overdriven
  p == 21 ? (                                                            // Reset all to defaults
    slider1 = 0;
    slider2 = 5;
    slider3 = 0;
    slider4 = 0;
    slider5 = 5;
    slider6 = 5;
    slider7 = 5;
    slider8 = 5;
    slider9 = 4;
    slider10 = 2;
    slider11 = -80;
    slider12 = 1;
    slider13 = 3;
    slider14 = 0;
    slider15 = 0;
    slider16 = 0;
    slider17 = 4;
    slider18 = 0;
    slider19 = 0;
    slider20 = 0;
    slider21 = 0;
    slider22 = 1;
    slider23 = 0;
    slider24 = 4;
    slider25 = -80;
    slider26 = 1;
    slider27 = 3;
    slider28 = 0;
    slider29 = 0;
    slider30 = 0;
    slider31 = 0;
    slider32 = 0;
    slider33 = 25;
    slider34 = 0.25;
    slider35 = 50;
    slider36 = 0;
    slider37 = 30;
    slider38 = 120;
    slider39 = 6000;
    slider40 = -0.3;
    ah_autor(1, 40);
  );
  // a preset for the model in use changes without a click: the output ducks (12 ms out, the new settings at
  // silence, 8 ms hold, 12 ms back); a preset for the other model crossfades instead
  floor(slider1 + 0.5) == ah_cur ? ah_dst = 1;
  ah_pr = p > 20 ? 1 : p;
);

ah_srinit();
!ah_dflt ? ( ui_thm = 5; ui_hw = 1; ui_kstyle = 0; ah_pr = 1; ah_dflt = 1; );   // new instances: Graphite (aluminium panel), hardware

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; ah_load(k);
    k <= 20 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(20, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( ah_load(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
ah_switch();
!(ah_dst == 1) ? ah_upd(ah_cur);   // the outgoing model of a crossfade keeps its settings until it is gone
ah_chassis();

@block
prs_chk();
srate != ah_sr ? ah_srinit();
ah_switch();
ah_block(ah_cur);
ah_chassis();

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_avail(0) != 0 ? file_var(0, ah_pr);          // the preset in use
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
// the preset duck: out, the new settings at silence, a short hold, back in
ah_dst == 1 ? ( ah_dk -= ah_dkr; ah_dk <= 0 ? ( ah_dk = 0; ah_dst = 2; ah_upd(ah_cur); ah_chassis(); ah_hc = floor(0.008 * srate); ); ) :
ah_dst == 2 ? ( ah_hc > 0 ? ah_hc -= 1 : ( ah_dk += ah_dkr; ah_dk >= 1 ? ( ah_dk = 1; ah_dst = 0; ); ); );
ah_run(ah_cur); ah_yL = ah_rL; ah_yR = ah_rR;
ah_dst ? ( ah_dkg = ah_dk * ah_dk * (3 - 2 * ah_dk); ah_yL *= ah_dkg; ah_yR *= ah_dkg; );
ah_xf ? (
  // the MODEL crossfade: the outgoing model (frozen at its settings) runs alongside for 20 ms
  ah_w = 0.5 - 0.5 * cos($pi * ah_xt);
  ah_run(ah_old);
  ah_yL = ah_yL * ah_w + ah_rL * (1 - ah_w); ah_yR = ah_yR * ah_w + ah_rR * (1 - ah_w);
  ah_xt += ah_xfc; ah_xt >= 1 ? ah_xf = 0;
);
ah_yL = ah_ostL.ost_band(ah_yL); ah_yR = ah_ostR.ost_band(ah_yR);
ost_out(ah_yL, ah_yR);
spl0 = ost_l;
spl1 = ost_r;
ah_mpk = max(ah_mpk, ah_cur ? abs(spl0) : max(abs(spl0), abs(spl1)));   // the level LEDs (as each original)

@gfx 780 315
ui_begin(780, 315);
ui_col(ui_hw ? 0x0B0C0D : C_BG); gfx_rect(0, 0, gfx_w, gfx_h);

// colours from the theme: the panel takes its light tone, the pinstripe and lamp its accent
// (Graphite keeps the aluminium panel with a red (GUITAR) or blue (BASS) stripe and lamp)
function ah_cols() (
  BH_PNL = ui_hw ? C_S2 : C_HDR; BH_INK = ui_ink(BH_PNL);
  BH_ACC = ui_thm == 5 ? (ah_cur ? 0x3A8DFF : 0xFF3B30) : C_ACC;
  BH_TXT = ui_hw ? 0xD8DCE2 : C_TITLE;
);
ah_cols();

// a big control: the hardware knob, or the flat GFX knob
function bh_big(cx, cy, idx, vmin, vmax, vdef, step, label, fmt) (
  ui_hw ? ( pk_bkstep = step; pk_bigknob(cx * sc, cy * sc, 28 * sc, idx, vmin, vmax, vdef, 0, 0, 1, label, fmt); pk_bkstep = 0; )
        : ( knob_step = step; ui_section(0); C_INK = BH_INK; ui_knob(cx * sc, cy * sc, idx, vmin, vmax, vdef, 0, label, fmt); );
);

// ---------- the head: tolex box, control panel ----------
function bh_tolex(x, y, w, h) local(i, px, py) (
  ui_hw ? (
    ui_col(0x050506); ui_rrs(x * sc, y * sc, w * sc, h * sc, 8 * sc);
    ui_col(BH_TOL); ui_rrs((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, 7 * sc);
    i = 0;
    loop(900,                                       // the grain
      px = x + 4 + ((i * 7919) % 997) / 997 * (w - 8); py = y + 4 + ((i * 104729) % 991) / 991 * (h - 8);
      ui_cola(i % 2 ? 0xFFFFFF : 0x000000, i % 2 ? 0.035 : 0.25); gfx_rect(px * sc, py * sc, 1 * sc + 1, 1 * sc + 1);
      i += 1;
    );
    gfx_gradrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, 30 * sc, 1, 1, 1, 0.06, 0, 0, 0, 0, 0, 0, 0, -0.06 / (30 * sc));
  ) : (
    ui_col(C_BG); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  );
);
BH_TOL = 0x141416;
T = 8; TH = 298;
bh_tolex(8, T, 764, TH);

// ---------- the header: name, the selected model's badge, MODEL keys, presets, lamp, theme, HW, size ----------
gfx_setfont(6, "Trebuchet MS", 22 * sc, 'bi');
ui_hw ? ( ui_cola(0x000000, 0.6); gfx_x = 33 * sc; gfx_y = (T + 11) * sc; gfx_drawstr("Amp Head"); );
ui_col(BH_TXT); gfx_x = 32 * sc; gfx_y = (T + 10) * sc; gfx_drawstr("Amp Head");
gfx_setfont(4); ui_cola(BH_TXT, 0.6); gfx_x += 10 * sc; gfx_y = (T + 20) * sc; gfx_drawstr(ah_cur ? "ALL VALVE 300" : "ALL VALVE 50");
// MODEL: lit house keys
ui_keycap(226 * sc, (T + 13) * sc, 62 * sc, 22 * sc, "GUITAR", ah_cur == 0, 1) ? ( slider1 = 0; ui_auto(1); );
ui_keycap(292 * sc, (T + 13) * sc, 56 * sc, 22 * sc, "BASS", ah_cur == 1, 1) ? ( slider1 = 1; ui_auto(1); );
// the house preset bar
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( ah_pr = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ah_k = pk_preset(360 * sc, (T + 11) * sc, 236 * sc, 26 * sc, ah_pr,
  "Init|GUITAR: Clean Jazz|GUITAR: Sparkle Clean|GUITAR: Edge of Breakup|GUITAR: Classic Crunch|GUITAR: Rhythm Crunch 4x12|GUITAR: Hot Lead|GUITAR: Saturated Lead|GUITAR: Blues|GUITAR: Spring Surf|GUITAR: Ambient Clean|BASS: Init|BASS: DI Clean|BASS: Warm Valve|BASS: Vintage Round|BASS: Growl|BASS: Pick Rock|BASS: Fat Dub|BASS: Bright Slap|BASS: Overdriven");
ah_k > 0 ? prs_dirty = ah_k;
pk_led(610 * sc, (T + 24) * sc, 5 * sc, 1, BH_ACC);
ui_theme_picker(624 * sc, (T + 15) * sc);
ah_cols();
ui_hw_toggle(652 * sc, (T + 15) * sc);
ui_size_picker(694 * sc, (T + 15) * sc);

// ---------- control panel ----------
px0 = 20; py0 = T + 46; pw = 740; ph = 150;
ui_hw ? (
  ui_col(0x2A2C30); ui_rrs(px0 * sc, py0 * sc, pw * sc, ph * sc, 4 * sc);
  ui_col(BH_PNL); ui_rrs((px0 + 1) * sc, (py0 + 1) * sc, (pw - 2) * sc, (ph - 2) * sc, 3 * sc);
  gi = 0; loop(floor((ph - 4) / 2), ui_cola(gi % 3 ? 0xFFFFFF : 0x000000, gi % 3 ? 0.06 : 0.03);
    gfx_line((px0 + 2) * sc, (py0 + 2 + gi * 2) * sc, (px0 + pw - 3) * sc, (py0 + 2 + gi * 2) * sc); gi += 1; );
  ui_col(ui_mix(BH_ACC, 0x000000, 0.35)); gfx_rect((px0 + 2) * sc, (py0 + ph - 9) * sc, (pw - 4) * sc, 3 * sc);   // pinstripe
  pk_screw((px0 + 10) * sc, (py0 + 12) * sc); pk_screw((px0 + pw - 10) * sc, (py0 + 12) * sc);
) : (
  ui_col(BH_PNL); ui_rrect(px0 * sc, py0 * sc, pw * sc, ph * sc, 5 * sc);
  ui_col(C_ACC); gfx_rect(px0 * sc, (py0 + 8) * sc, 3 * sc, (ph - 16) * sc);
);

pk_ink = BH_INK; pk_bg = BH_PNL; pk_bkfs = 11; pk_nonum = 1; pk_ptr = 0xEDE3C8; pk_kstyle = 8;   // skirted amp knobs
ky = py0 + 66;
ly = T + 246;
ah_cur == 0 ? (
  // ---------------- GUITAR
  bh_big(76, ky, 2, 0, 10, 5, 0, "GAIN", "%.1f");
  ui_keycap(128 * sc, (py0 + 34) * sc, 64 * sc, 22 * sc, "BRIGHT", slider3, 1) ? ( slider3 = 1 - slider3; ui_auto(3); );
  ui_keycap(128 * sc, (py0 + 64) * sc, 64 * sc, 22 * sc, "DRIVE", slider4, 1) ? ( slider4 = 1 - slider4; ui_auto(4); );
  bh_big(250, ky, 5, 0, 10, 5, 0, "BASS", "%.1f");
  bh_big(328, ky, 6, 0, 10, 5, 0, "MIDDLE", "%.1f");
  bh_big(406, ky, 7, 0, 10, 5, 0, "TREBLE", "%.1f");
  bh_big(484, ky, 8, 0, 10, 5, 0, "PRESENCE", "%.1f");
  bh_big(580, ky, 10, 0, 10, 2, 0, "REVERB", "%.1f");
  bh_big(676, ky, 9, 0, 10, 4, 0, "MASTER", "%.1f");
  pk_nonum = 0; pk_bkfs = 15; pk_ptr = -1; pk_kstyle = 0;
  // lower strip: GATE | TUNER | CAB + MIC | OUTPUT + meter
  ui_section(2); C_INK = BH_TXT; ui_knonum = 2;
  ui_knob(60 * sc, ly * sc, 11, -80, -20, -80, 0, "GATE", slider11 <= -79.5 ? "OFF" : "%.0f dB");
  ui_keycap(108 * sc, (ly - 22) * sc, 56 * sc, 22 * sc, "TUNER", slider15, 1) ? ( slider15 = 1 - slider15; ui_auto(15); );
  ui_keycap(108 * sc, (ly + 4) * sc, 56 * sc, 22 * sc, "MONO IN", slider16, 1) ? ( slider16 = 1 - slider16; ui_auto(16); );
  slider15 ? am_tun_draw(172 * sc, (ly - 24) * sc, 130 * sc, 44 * sc, 0xD8DCE2, 0xFFB030)
           : ( ui_col(0x0A0B0C); ui_rrect(172 * sc, (ly - 24) * sc, 130 * sc, 44 * sc, 3 * sc); gfx_setfont(4); ui_cola(0xD8DCE2, 0.3); ui_text(237 * sc, (ly - 7) * sc, "TUNER OFF"); );
  knob_step = 1;
  ui_knob(370 * sc, ly * sc, 12, 0, 2, 1, 0, "CAB", slider12 == 0 ? "OFF" : slider12 == 1 ? "2x12 OPEN" : "4x12");
  ui_knob(450 * sc, ly * sc, 13, 0, 10, 3, 0, "MIC", "%.1f");
  ui_knob(560 * sc, ly * sc, 14, -24, 12, 0, 0, "OUTPUT", "%+.1f dB");
  ui_knonum = 0;
) : (
  // ---------------- BASS
  bh_big(80, ky, 17, 0, 10, 4, 0, "GAIN", "%.1f");
  ui_keycap(134 * sc, (py0 + 34) * sc, 70 * sc, 22 * sc, "ULTRA LO", slider18, 1) ? ( slider18 = 1 - slider18; ui_auto(18); );
  ui_keycap(134 * sc, (py0 + 64) * sc, 70 * sc, 22 * sc, "ULTRA HI", slider19, 1) ? ( slider19 = 1 - slider19; ui_auto(19); );
  bh_big(260, ky, 20, -12, 12, 0, 0.5, "BASS", "%+.1f dB");
  bh_big(350, ky, 21, -12, 12, 0, 0.5, "MIDRANGE", "%+.1f dB");
  ui_hw ? pk_step(440, ky, 22, 5, "220|450|800|1.6k|3k", "FREQUENCY") : (
    knob_step = 1; ui_section(0); C_INK = BH_INK;
    ui_knob(440 * sc, ky * sc, 22, 0, 4, 1, 0, "FREQ", slider22 == 0 ? "220 Hz" : slider22 == 1 ? "450 Hz" : slider22 == 2 ? "800 Hz" : slider22 == 3 ? "1.6 kHz" : "3 kHz");
  );
  bh_big(530, ky, 23, -12, 12, 0, 0.5, "TREBLE", "%+.1f dB");
  bh_big(640, ky, 24, 0, 10, 4, 0, "MASTER", "%.1f");
  pk_nonum = 0; pk_bkfs = 15; pk_ptr = -1; pk_kstyle = 0;
  // lower strip: GATE | TUNER | CAB + MIC | DI BLEND | OUTPUT + meter
  ui_section(2); C_INK = BH_TXT; ui_knonum = 2;
  ui_knob(60 * sc, ly * sc, 25, -80, -20, -80, 0, "GATE", slider25 <= -79.5 ? "OFF" : "%.0f dB");
  ui_keycap(108 * sc, (ly - 22) * sc, 56 * sc, 22 * sc, "TUNER", slider30, 1) ? ( slider30 = 1 - slider30; ui_auto(30); );
  slider30 ? am_tun_draw(172 * sc, (ly - 24) * sc, 130 * sc, 44 * sc, 0xD8DCE2, 0xFFB030)
           : ( ui_col(0x0A0B0C); ui_rrect(172 * sc, (ly - 24) * sc, 130 * sc, 44 * sc, 3 * sc); gfx_setfont(4); ui_cola(0xD8DCE2, 0.3); ui_text(237 * sc, (ly - 7) * sc, "TUNER OFF"); );
  ui_keycap(326 * sc, (ly - 22) * sc, 56 * sc, 22 * sc, "CAB", slider26, 1) ? ( slider26 = 1 - slider26; ui_auto(26); );
  ui_knob(410 * sc, ly * sc, 27, 0, 10, 3, 0, "MIC", "%.1f");
  ui_knob(490 * sc, ly * sc, 28, 0, 100, 0, 0, "DI BLEND", "%.0f%%");
  ui_knob(570 * sc, ly * sc, 29, -24, 12, 0, 0, "OUTPUT", "%+.1f dB");
  ui_knonum = 0;
);
bh_lv = max(ah_mpk, bh_lv * 0.8); ah_mpk = 0;
hs_leds(690, ly - 4, bh_lv, BH_TXT);

pk_end();
ui_end();
