desc:Duo81 [bitcrusher/limiter] (GFX)
//tags: lo-fi sampler bitcrusher decimator 12-bit limiter brickwall data-reduction digital vintage
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// Duo81. Two half-rack units bolted side by side by a central mounting bracket (the 81 family):
//   LEFT  - a sampler engine in the spirit of the late-80s 12-bit studio samplers (punchy low-bit converters,
//           sample-rate reduction, steep analogue input / output filters).
//   RIGHT - a limiter in the spirit of early consumer digital data-reduction (brickwall digital
//           clamping, the high-frequency management of early psychoacoustic coding, hard digital saturation).
// MODE (the VFD / MATRIX keys in the header) sets both units, their sound, their faceplates and the labels:
//   VFD    - the Japanese pair, DS-81 + DL-81: charcoal faces with glowing VFD readouts, English labels.
//   MATRIX - the European pair, ZA-81 + BG-81: battleship-grey faces with LED-matrix readouts, German labels.
//   A change ducks the output (12 ms), swaps the engines at the silent point and fades back in.
//   (Old projects keep their sound: the sampler's old style picks the mode; an old limiter style that differed
//   from it is kept until the MODE is next pressed or a preset is loaded.)
//   DS-81 (VFD sampler)    crisp and punchy: a light input transformer, rounded 12-bit steps, clean filters.
//   ZA-81 (MATRIX sampler) darker: a heavier transformer (the lows saturate first, even harmonics, a softer top),
//                          a slightly noisier converter (hiss about -80 dBFS), coarser rounding (sign-magnitude
//                          truncation: a dead zone round zero), a darker, driven output ladder, more clock jitter.
//   DL-81 (VFD limiter)    glassy and precise: a soft digital clip, 5.8 ms coding frames with smooth band changes,
//                          a light pump.
//   BG-81 (MATRIX limiter) grittier: a hard digital clip, 11.6 ms frames with abrupt band switching, coarser band
//                          quantising, more emphasis in the detector and a deeper pump after every hit.
//
// SIGNAL FLOW (fixed order, as on the recipe: the sampler feeds the limiter)
//   input -> SAMPLER: DRIVE (0 .. +24 dB into the input transformer: low-frequency core saturation and a gentle
//   biased curve) -> analogue clipper (soft, into the converter's full scale) -> ANTI-ALIAS (8-pole Chebyshev,
//   0.5 dB ripple; AA 100 % = 0.42 x the converter rate, just under its Nyquist: clean; AA 0 % = 0.8 x the rate:
//   lots of fold-back; the key switches it out completely) -> the converter: sample and hold at RATE (each sample
//   taken at the exact clock instant, interpolated between host samples) quantised to BITS (linear, or NON-LIN:
//   companded, finer steps for quiet signals and coarser ones for loud) -> the output filter: a 4-pole ladder
//   (ZDF) plus a 2-pole stage, FILTER sets the cutoff as a share of the converter's Nyquist (0 % = 0.3 x, 100 % =
//   1.05 x), so it tracks RATE -> DC blocker -> TRIM.
//   -> LIMITER: DRIVE (0 .. +24 dB, i.e. the threshold sits DRIVE dB under the CEILING) -> DC blocker -> SAT
//   (digital clip ahead of the limiter) -> pre-emphasis (high shelf at 4.5 kHz, up to +9 / +11 dB with SPECTRAL)
//   -> the HF manager: the signal is split (complementary, so it sums back exactly) into the band below 5 kHz and
//   five bands above it (5-7, 7-9.5, 9.5-12.5, 12.5-16 kHz and above). Every coding frame the level of each band is
//   compared with a masking threshold (the full-band level minus 70 .. 10 dB as SPECTRAL rises, each higher band
//   masked 4 dB more easily, plus an absolute threshold rising from -100 to -40 dBFS): masked bands are dropped for the next frame, the others are
//   re-quantised with a step size from their own peak and the level above the threshold (the bit allocation).
//   The quantising noise is kept above 4.5 kHz. -> de-emphasis -> the brickwall limiter: 2 ms lookahead, sliding
//   minimum + box smoothing (the gain is always down before a peak arrives), RELEASE 0 (instant) .. 300 ms, the
//   detector also hears the pre-emphasised copy (pushed highs clamp harder: the papery top), a pump that ducks
//   after hits (VFD light, MATRIX deep), and a final clamp: no output sample exceeds the CEILING (-12 .. 0 dBFS).
//   -> MIX (the dry input, latency matched) -> OUTPUT -> the house output stage (band SAT, and a soft clip that is
//   always on; the limiter's CEILING is the brickwall before it).
//   Latency: the 2 ms lookahead (reported; constant whether the units are on or off).
//   ON keys: each unit fades in / out (10 ms).
//
// BITS  - 8 / 10 / 12 / 16 / 24 (the knob clicks into these). RATE - 8 / 11 / 16 / 22 / 26 / 32 / 40 / 48 kHz.
//         FREE (the 'between' key): both knobs run continuously instead.
// DRIFT (0 - 100 %, 50 % = standard): converter clock jitter - the sampling instant jitters at random (about
//         +/-0.15 % of a period at 50 %, MATRIX 1.6x) and the clock wanders slowly (+/-0.1 %), and the analogue
//         output filter's cutoff drifts (+/-1.5 %). 0 % = a perfect clock.
// GUI: drag a knob (SHIFT = fine, double-click = default, wheel); values show while a knob is touched; click a key;
//      click the LCD (or PRESETS) for the preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:1<0,1,1{Off,On}>-Sampler on
slider2:0<0,1,1{VFD,Matrix}>-Mode
slider3:0<0,24,0.1>-Sampler drive (dB)
slider4:12<8,24,0.01>-Bits
slider5:0<0,1,1{Off,On}>-Free (continuous bits / rate)
slider6:0<0,1,1{Linear,Non-linear}>-Rounding
slider7:40000<8000,48000,1>-Sample rate (Hz)
slider8:1<0,1,1{Off,On}>-Anti-alias filter
slider9:100<0,100,1>-Anti-alias amount (%)
slider10:85<0,100,1>-Output filter (%)
slider11:0<-24,12,0.1>-Sampler trim (dB)
slider12:1<0,1,1{Off,On}>-Limiter on
slider13:-1<-1,1,1>-(unused, was limiter style)
slider14:0<0,24,0.1>-Limiter drive (dB)
slider15:-1<-12,0,0.1>-Ceiling (dBFS)
slider16:30<0,300,0.1>-Release (ms)
slider17:15<0,100,1>-Spectral (%)
slider18:0<0,100,1>-Digital saturation (%)
slider19:100<0,100,1>-Mix (%)
slider20:50<0,100,1>-Drift (%)
slider21:0<-24,12,0.1>-Output (dB)
slider22:0<0,100,1>-Band sat (%)
slider23:30<0,100,1>-Bias (%)
slider24:120<40,400,1>-Sat low band (Hz)
slider25:6000<2000,16000,10>-Sat high band (Hz)
slider26:-0.3<-24,0,0.1>-Ceiling (dB)
slider27:0<0,1,1{Off,Clip}>-(unused, was output stage)
slider28:0<0,1,1>-(unused, was label language)
slider29:prs_sel=0<0,12,1{No preset,Init,12-Bit Drums,Hip-Hop Crunch,8-Bit Grit,Tape-Fed Sampler,Berlin Dust,Data Squash,Glassy Highs,Pump Bus,Broadcast Brick,Warsaw Lab,Full Crush}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
#ui_man = "gfx-duo81";                                  // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
kx_dlL = alloc(1024); kx_dlR = alloc(1024);             // limiter lookahead (the processed signal)
kx_dbL = alloc(1024); kx_dbR = alloc(1024);             // the limiter's input, delayed (its bypass)
kx_ddL = alloc(1024); kx_ddR = alloc(1024);             // the chain's input, delayed (MIX)
kx_qi = alloc(1024); kx_qv = alloc(1024);               // sliding-minimum queue (index, gain)
kx_bx = alloc(1024);                                    // box smoother
kx_C = alloc(80);                                       // biquad sections (5 coefficients each):
                                                        //   0-3 anti-alias, 4 output 2-pole, 5-9 band splits,
                                                        //   10 pre-emphasis, 11 de-emphasis, 12 noise high-pass
kx_ZL = alloc(32); kx_ZR = alloc(32); kx_ZQ = alloc(32); kx_ZS = alloc(32);   // section states (2 per section)
kx_E = alloc(8); kx_P = alloc(8); kx_g = alloc(8); kx_gt = alloc(8); kx_st = alloc(8);
kx_BTAB = alloc(8); kx_RTAB = alloc(8);                     // the BITS and RATE detents
kx_ostm = alloc(4096); ost_init(kx_ostm);

kx_BTAB[0] = 8; kx_BTAB[1] = 10; kx_BTAB[2] = 12; kx_BTAB[3] = 16; kx_BTAB[4] = 24;
kx_RTAB[0] = 8000; kx_RTAB[1] = 11025; kx_RTAB[2] = 16000; kx_RTAB[3] = 22050;
kx_RTAB[4] = 26040; kx_RTAB[5] = 32000; kx_RTAB[6] = 40000; kx_RTAB[7] = 48000;
function kx_snap(t, n, v) local(i, b, d) (
  b = t[0]; d = abs(v - b); i = 1;
  loop(n - 1, abs(v - t[i]) < d ? ( d = abs(v - t[i]); b = t[i]; ); i += 1; );
  b;
);

// ---------- biquad sections in memory (shared coefficients, per-channel states) ----------
function kx_sec(x, c, z) local(y) (
  y = c[0] * x + z[0];
  z[0] = c[1] * x - c[3] * y + z[1];
  z[1] = c[2] * x - c[4] * y;
  y;
);
function kx_lpset(k, f, q) local(w0, cw, al, n, c) (
  w0 = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al; c = kx_C + k * 5;
  c[0] = (1 - cw) * 0.5 / n; c[1] = (1 - cw) / n; c[2] = c[0]; c[3] = -2 * cw / n; c[4] = (1 - al) / n;
);
function kx_hpset(k, f, q) local(w0, cw, al, n, c) (
  w0 = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al; c = kx_C + k * 5;
  c[0] = (1 + cw) * 0.5 / n; c[1] = -(1 + cw) / n; c[2] = c[0]; c[3] = -2 * cw / n; c[4] = (1 - al) / n;
);
function kx_shelf(k, f, gdb) local(w0, cw, sw, al, A, sa, n, c) (
  w0 = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * 0.7071); A = 10 ^ (gdb / 40);
  sa = 2 * sqrt(A) * al; n = (A + 1) - (A - 1) * cw + sa; c = kx_C + k * 5;
  c[0] = A * ((A + 1) + (A - 1) * cw + sa) / n; c[1] = -2 * A * ((A - 1) + (A + 1) * cw) / n;
  c[2] = A * ((A + 1) + (A - 1) * cw - sa) / n; c[3] = 2 * ((A - 1) - (A + 1) * cw) / n; c[4] = ((A + 1) - (A - 1) * cw - sa) / n;
);
// 8-pole Chebyshev low-pass (0.5 dB ripple), unity at DC, as four sections 0-3
function kx_cheb(fc) local(eps, v, bk, wc, k, th, sg, om, a, w2, d0, c) (
  fc = min(fc, 0.46 * srate);
  eps = 0.3493114; v = log(1 / eps + sqrt(1 / (eps * eps) + 1)) / 8;
  bk = 2 * srate; wc = bk * tan($pi * fc / srate);
  k = 0;
  loop(4,
    th = (2 * k + 1) * $pi / 16;
    sg = (exp(v) - exp(-v)) * 0.5 * sin(th); om = (exp(v) + exp(-v)) * 0.5 * cos(th);
    a = 2 * sg * wc; w2 = (sg * sg + om * om) * wc * wc;
    d0 = bk * bk + a * bk + w2; c = kx_C + k * 5;
    c[0] = w2 / d0; c[1] = 2 * w2 / d0; c[2] = c[0];
    c[3] = (2 * w2 - 2 * bk * bk) / d0; c[4] = (bk * bk - a * bk + w2) / d0;
    k += 1;
  );
);

// ---------- curves ----------
function kx_soft(x, k) local(a) (
  a = abs(x);
  a < k ? x : sign(x) * (k + (1 - k) * ost_tanh((a - k) / (1 - k)));
);
// the converter's quantiser (y within -1 .. 1). Linear: rounded (TOKYO) or sign-magnitude truncation (BERLIN).
// NON-LIN: companded, quantised in the compressed domain.
function kx_quant(y) local(a) (
  a = abs(y);
  kx_nl ? a = log(1 + kx_mu * a) * kx_mui;
  a = kx_tr ? floor(a * kx_Q) / kx_Q : floor(a * kx_Q + 0.5) / kx_Q;
  a = min(a, kx_Qm);
  kx_nl ? a = ((1 + kx_mu) ^ a - 1) / kx_mu;
  sign(y) * a;
);

// ---------- the sampler, one channel ----------
function kx_chan(x) instance(Z, lo, lp, prv, hold, s1, s2, s3, s4, dcx, dcy) local(t, y, u, S, v, y1, y2, y3) (
  // input transformer: the core saturates the lows first, then a gentle biased curve; MATRIX loses a little top
  t = x * kx_gin;
  lo += (t - lo) * kx_cLF;
  t += lo / sqrt(1 + sqr(kx_kT * lo)) - lo;
  t = ost_curve(t, kx_td, kx_tb);
  kx_bl ? ( lp += (t - lp) * kx_cHF; t = lp; );
  // analogue clipper into the converter's full scale
  t = kx_soft(t, kx_ck);
  kx_ipk = max(kx_ipk, abs(t));
  // anti-alias filter
  kx_aa ? (
    t = kx_sec(t, kx_C, Z);      t = kx_sec(t, kx_C + 5, Z + 2);
    t = kx_sec(t, kx_C + 10, Z + 4); t = kx_sec(t, kx_C + 15, Z + 6);
  );
  // sample and hold at the clock instant, quantise
  kx_ev ? (
    y = prv + (t - prv) * kx_fr + kx_nz * (rand(2) - 1);
    y = min(max(y, -1), 1);
    hold = kx_quant(y);
  );
  prv = t;
  // the output ladder (4 poles, zero-delay feedback), then a 2-pole stage
  S = kx_lG1 * (kx_lG3 * s1 + kx_lG2 * s2 + kx_lG * s3 + s4);
  y = (kx_lG4 * hold + S) / (1 + kx_lk * kx_lG4);
  u = hold - kx_lk * y;
  kx_bl ? u = ost_tanh(u * 1.4) * 0.7142857;
  v = (u - s1) * kx_lG; y1 = v + s1; s1 = y1 + v;
  v = (y1 - s2) * kx_lG; y2 = v + s2; s2 = y2 + v;
  v = (y2 - s3) * kx_lG; y3 = v + s3; s3 = y3 + v;
  v = (y3 - s4) * kx_lG; y = v + s4; s4 = y + v;
  y = kx_sec(y * (1 + kx_lk), kx_C + 20, Z + 8);
  t = y - dcx + kx_dcr * dcy; dcx = y; dcy = t;
  t * kx_trim;
);
function kx_cflush() instance(lo, lp, prv, hold, s1, s2, s3, s4, dcx, dcy) (
  abs(lo) < 0.000000000001 ? lo = 0; abs(lp) < 0.000000000001 ? lp = 0;
  abs(s1) < 0.000000000001 ? s1 = 0; abs(s2) < 0.000000000001 ? s2 = 0;
  abs(s3) < 0.000000000001 ? s3 = 0; abs(s4) < 0.000000000001 ? s4 = 0;
  abs(dcx) < 0.000000000001 ? dcx = 0; abs(dcy) < 0.000000000001 ? dcy = 0;
);

// ---------- the limiter's front end, one channel: drive, DC, SAT, pre-emphasis, HF manager, de-emphasis ----------
function kx_rpre(x) instance(Z, dcx, dcy, ue) local(y, u, r, b, sb, se, gb, st, k) (
  x *= kx_ldg;
  y = x - dcx + kx_dcr * dcy; dcx = x; dcy = y;
  kx_sat ? y += kx_satw * (kx_cl * kx_soft(y * kx_cli, kx_sk) - y);
  kx_ovp = max(kx_ovp, abs(y));
  u = kx_sec(y, kx_C + 50, Z + 20);
  ue = u;
  b = kx_sec(u, kx_C + 25, Z + 10);
  sb = b; se = 0; r = u - b; k = 0;
  loop(5,
    b = k < 4 ? kx_sec(r, kx_C + 30 + k * 5, Z + 12 + k * 2) : r;
    r -= b;
    kx_E[k] += b * b; kx_P[k] = max(kx_P[k], abs(b));
    gb = kx_g[k]; st = kx_st[k];
    sb += gb * b;
    st > 0 ? se += gb * (floor(b / st + 0.5) * st - b);
    k += 1;
  );
  kx_Et += u * u;
  sb += kx_sec(se, kx_C + 60, Z + 24);
  kx_sec(sb, kx_C + 55, Z + 22);
);
function kx_rflush() instance(dcx, dcy) (
  abs(dcx) < 0.000000000001 ? dcx = 0; abs(dcy) < 0.000000000001 ? dcy = 0;
);
function kx_zflush(z) local(i) ( i = 0; loop(26, abs(z[i]) < 0.000000000001 ? z[i] = 0; i += 1; ); );

// ---------- settings ----------
function kx_update() local(b, rt, fq, sp, bl) (
  // the sampler
  // MODE: the target (kx_tmd); the engines run on kx_md, which changes only at the silent point of a duck
  kx_tmd = slider2 >= 0.5;
  kx_son = slider1 >= 0.5; kx_bl = kx_md;
  kx_tgin = 10 ^ (slider3 / 20);
  kx_free = slider5 >= 0.5;
  b = kx_free ? slider4 : kx_snap(kx_BTAB, 5, slider4);
  kx_bits = min(max(b, 8), 24); kx_Q = 2 ^ (kx_bits - 1); kx_Qm = (kx_Q - 1) / kx_Q;
  kx_nl = slider6 >= 0.5;
  rt = kx_free ? slider7 : kx_snap(kx_RTAB, 8, slider7);
  kx_rate = min(max(rt, 8000), 48000);
  kx_aa = slider8 >= 0.5;
  fq = kx_rate * (0.8 - 0.38 * min(max(slider9, 0), 100) / 100);
  fq != kx_aafc ? ( kx_aafc = fq; kx_cheb(fq); );
  kx_flt = min(max(slider10, 0), 100) / 100;
  kx_ttrim = 10 ^ (slider11 / 20);
  kx_bl ? (                                             // ZA-81
    kx_kT = 0.7; kx_td = 0.65; kx_tb = 0.16; kx_ck = 0.6; kx_nz = 0.00012; kx_tr = 1; kx_mu = 16;
    kx_lk = 1.0; kx_fsc = 0.84; kx_jsc = 1.6;
  ) : (                                                 // DS-81
    kx_kT = 0.25; kx_td = 0.3; kx_tb = 0.05; kx_ck = 0.8; kx_nz = 0; kx_tr = 0; kx_mu = 10;
    kx_lk = 0.35; kx_fsc = 1; kx_jsc = 1;
  );
  kx_mui = 1 / log(1 + kx_mu);
  // the limiter
  // the limiter follows the mode; an old project's differing limiter style (slider13 0 / 1) is kept until the MODE
  // is pressed or a preset loads (both set it back to -1); a matching one retires at once
  slider13 > -0.5 && (slider13 >= 0.5) == (slider2 >= 0.5) ? slider13 = -1;
  kx_lon = slider12 >= 0.5; bl = slider13 > -0.5 ? slider13 >= 0.5 : kx_md; kx_lbl = bl;
  kx_tldg = 10 ^ (slider14 / 20);
  kx_ct = 10 ^ (min(max(slider15, -12), 0) / 20);
  kx_rel = max(slider16, 0);
  kx_relc = kx_rel < 0.05 ? 1 : 1 - exp(-1 / (kx_rel * 0.001 * srate));
  sp = min(max(slider17, 0), 100) / 100; kx_spec = sp;
  kx_satv = min(max(slider18, 0), 100) / 100;
  kx_sat = kx_satv > 0.001;
  kx_cl = 10 ^ ((4 - 7 * kx_satv) / 20) * kx_ct; kx_cli = 1 / kx_cl; kx_satw = min(kx_satv * 4, 1);
  bl ? (                                                // BG-81
    kx_pump = 0.45; kx_F = floor(0.0116 * srate); kx_gc = 1 - exp(-1 / (0.0003 * srate)); kx_bb = 1;
    kx_sk = 0.88; kx_eg = 0.7 * sp; kx_pdb = 11 * sp;
  ) : (                                                 // DL-81
    kx_pump = 0.12; kx_F = floor(0.0058 * srate); kx_gc = 1 - exp(-1 / (0.002 * srate)); kx_bb = 3;
    kx_sk = 0.55; kx_eg = 0.5 * sp; kx_pdb = 9 * sp;
  );
  kx_pdb != kx_pdbl ? ( kx_pdbl = kx_pdb; kx_shelf(10, 4500, kx_pdb); kx_shelf(11, 4500, -kx_pdb); );
  kx_MSK = 70 - 60 * sp ^ 0.6; kx_ATH = -100 + 60 * sp ^ 0.6; kx_spon = sp > 0.004;
  kx_pr = 1 - exp(-1 / (max(kx_rel * 3, 80) * 0.001 * srate));
  // the chain
  kx_tmix = min(max(slider19, 0), 100) / 100;
  drift_macro(slider20);
  kx_tog = 10 ^ (slider21 / 20);
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, slider26, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2;
  pdc_delay = kx_L - 1;
);

// ---------- presets ----------
function kx_setL(on, md, dr, bt, fr, nl, rt, aa, am, fl, tr) (
  slider1 = on; slider2 = md; slider13 = -1; slider3 = dr; slider4 = bt; slider5 = fr; slider6 = nl; slider7 = rt;
  slider8 = aa; slider9 = am; slider10 = fl; slider11 = tr;
);
function kx_setR(on, dr, ce, rl, sp, sa, mx, df, lv) (
  slider12 = on; slider14 = dr; slider15 = ce; slider16 = rl; slider17 = sp; slider18 = sa;
  slider19 = mx; slider20 = df; slider21 = lv;          // OUTPUT: each preset is levelled against Init
  slider_automate(2097151);                             // sliders 1-21 (the output stage's settings stay)
);
function load_preset(p) (
  kx_dst = 1;                                           // duck the output, swap the settings at silence, fade back in
  p == 1  ? ( kx_setL(1, 0,  0, 12, 0, 0, 40000, 1, 100, 85,   0); kx_setR(1,  0,  -1,    30,  15,  0, 100, 50, 0.0); ) : // Init
  p == 2  ? ( kx_setL(1, 0,  4, 12, 0, 0, 26040, 1,  70, 80,  -3); kx_setR(1,  4,  -0.5,  20,  20, 15, 100, 50, -4.8); ) : // 12-Bit Drums
  p == 3  ? ( kx_setL(1, 0,  6, 12, 0, 1, 22050, 0,   0, 70,  -4); kx_setR(1,  6,  -0.8,  60,  25, 40, 100, 50, -7.4); ) : // Hip-Hop Crunch
  p == 4  ? ( kx_setL(1, 0,  3,  8, 0, 0, 16000, 0,   0, 75,  -2); kx_setR(1,  3,  -1,    15,  10, 20, 100, 40, -3.5); ) : // 8-Bit Grit
  p == 5  ? ( kx_setL(1, 1,  8, 12, 0, 0, 32000, 1,  90, 65,  -6); kx_setR(1,  2,  -0.5,  80,  10,  0, 100, 70, -3.6); ) : // Tape-Fed Sampler
  p == 6  ? ( kx_setL(1, 1,  5, 10, 0, 1, 22050, 1,  60, 60,  -4); kx_setR(1,  4,  -1,    50,  30, 20, 100, 65, -4.8); ) : // Berlin Dust
  p == 7  ? ( kx_setL(0, 0,  0, 24, 0, 0, 48000, 1, 100, 100,  0); kx_setR(1, 10,  -0.3,   8,  45, 25, 100, 50, -10.8); ) : // Data Squash
  p == 8  ? ( kx_setL(1, 0,  0, 16, 0, 0, 48000, 1, 100, 100,  0); kx_setR(1,  4,  -0.5,  25,  85,  0, 100, 40, -5.1); ) : // Glassy Highs
  p == 9  ? ( kx_setL(1, 1,  2, 16, 0, 0, 40000, 1, 100, 90,   0); kx_setR(1,  9,  -1,   120,  20, 20, 100, 50, -10.3); ) : // Pump Bus
  p == 10 ? ( kx_setL(0, 1,  0, 24, 0, 0, 48000, 1, 100, 100,  0); kx_setR(1,  8,  -1,     5,  35, 40, 100, 50, -8.7); ) : // Broadcast Brick
  p == 11 ? ( kx_setL(1, 1, 10, 10.5, 1, 0, 19000, 1, 40, 55, -9); kx_setR(1,  6,  -1,    40,  50, 35, 100, 80, -5.8); ) : // Warsaw Lab
  p == 12 ? ( kx_setL(1, 1, 16,  8, 0, 1,  8000, 0,   0, 50, -14); kx_setR(1, 12,  -0.5, 200, 100, 80, 100, 60, -11.1); ) : // Full Crush
  p == 13 ? (                                           // Reset all to defaults
    kx_setL(1, 0, 0, 12, 0, 0, 40000, 1, 100, 85, 0); kx_setR(1, 0, -1, 30, 15, 0, 100, 50, 0);
    slider21 = 0; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000; slider26 = -0.3; slider27 = 0;
    slider_automate(134217727);                         // sliders 1-27
  );
);

// the output filter follows RATE (per block, and at a preset swap)
function kx_ofilt() (
  kx_fo = min(0.5 * kx_rate * (0.3 + 0.75 * kx_flt) * kx_fsc * (1 + kx_fdr), 0.42 * srate);
  kx_lG = tan($pi * kx_fo / srate); kx_lG /= 1 + kx_lG;
  kx_lG1 = 1 - kx_lG; kx_lG2 = kx_lG * kx_lG; kx_lG3 = kx_lG2 * kx_lG; kx_lG4 = kx_lG2 * kx_lG2;
  kx_lpset(4, kx_fo * 1.25, 0.7071);
);

// ---------- state ----------
// everything that depends on the sample rate (run again from @block if the rate changes: ext_noinit keeps @init
// from running then)
function kx_srinit() local(i) (
  kx_sr = srate;
  kx_L = min(floor(0.002 * srate), 1000) + 1;           // lookahead window (latency = kx_L - 1)
  kx_sm  = 1 - exp(-1 / (0.02 * srate));                // knob glides
  kx_swc = 1 - exp(-1 / (0.01 * srate));                // ON fades
  kx_dkr = 1 / (0.012 * srate);                         // preset duck: 12 ms out, 12 ms in
  kx_cLF = 1 - exp(-2 * $pi * 100 / srate);             // transformer low band
  kx_cHF = 1 - exp(-2 * $pi * 12000 / srate);           // MATRIX transformer top
  kx_dcr = 1 - 2 * $pi * 4 / srate;                     // DC blockers, 4 Hz
  kx_pa  = 1 - exp(-1 / (0.002 * srate));               // pump attack
  i = 0; loop(5, kx_lpset(5 + i, i == 0 ? 5000 : i == 1 ? 7000 : i == 2 ? 9500 : i == 3 ? 12500 : 16000, 0.7071); i += 1; );
  kx_hpset(12, 4500, 0.7071);
  kx_pdbl = -1; kx_aafc = -1;                           // recompute the shelves and the anti-alias filter
  i = 0; loop(1024, kx_bx[i] = 1; i += 1; );
  kx_bs = kx_L; kx_bp = 0; kx_rg = 1; kx_pe = 0; kx_qh = kx_qt = 0;
  ost_init(kx_ostm);
);
kx_srinit();
sL.Z = kx_ZL; sR.Z = kx_ZR; rL.Z = kx_ZQ; rR.Z = kx_ZS;
kx_i = 0; loop(8, kx_g[kx_i] = 1; kx_gt[kx_i] = 1; kx_i += 1; );
kx_n = 0;
kx_wp = 0; kx_dph = 0; kx_ev = 0; kx_fr = 1; kx_fc = 0; kx_Et = 0;
kx_ipk = 0; kx_ovp = 0; kx_opk = 0; kx_gmin = 1;
kxdC.drift_init(0.8 + rand(0.4)); kxdF.drift_init(0.8 + rand(0.5));
kxoL.ost_ch_init(); kxoR.ost_ch_init();
kx_md = slider2 >= 0.5;
kx_update();
kx_gin = kx_tgin; kx_trim = kx_ttrim; kx_ldg = kx_tldg; kx_cs = kx_ct; kx_mix = kx_tmix; kx_og = kx_tog;
kx_sw = kx_son; kx_lw = kx_lon;
kx_dk = 1; kx_dst = 0;
kxa_ipk = 0; kxa_gr = 0; kxa_opk = 0; kxa_ovp = 0; kxa_bands = 31;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
kx_dst != 1 ? kx_update();                              // during a preset duck the swap applies the new settings

@block
prs_chk();
srate != kx_sr ? kx_srinit();
kx_dst != 1 ? kx_update();                              // knobs moved on the panel do not run @slider
kx_dst == 0 && kx_tmd != kx_md ? kx_dst = 1;            // a MODE change: duck, swap the engines in silence, fade in
// DRIFT: converter clock jitter and wander, analogue output filter drift
kx_di = 0.25 * dm_s * samplesblock / srate;
kx_wd = 0.001 * dm_a * kxdC.drift_tick(kx_di);
kx_fdr = 0.015 * dm_a * kxdF.drift_tick(kx_di * 0.7);
kx_jw = 0.0015 * dm_a * kx_jsc;
kx_dinc = kx_rate * (1 + kx_wd) / srate;
// the output filter follows RATE
kx_ofilt();
// denormal housekeeping
sL.kx_cflush(); sR.kx_cflush(); rL.kx_rflush(); rR.kx_rflush();
kx_zflush(kx_ZL); kx_zflush(kx_ZR); kx_zflush(kx_ZQ); kx_zflush(kx_ZS);
kx_pe < 0.0000001 ? kx_pe = 0;
// the panel's meters (mailboxes: the audio thread raises them, the panel reads and clears them)
kxa_ipk = max(kxa_ipk, kx_ipk); kx_ipk = 0;
kxa_gr = max(kxa_gr, -20 * log10(max(kx_gmin, 0.00001))); kx_gmin = 1;
kxa_opk = max(kxa_opk, kx_opk); kx_opk = 0;
kxa_ovp = max(kxa_ovp, kx_ovp); kx_ovp = 0;
kxa_bands = kx_gt[0] + 2 * kx_gt[1] + 4 * kx_gt[2] + 8 * kx_gt[3] + 16 * kx_gt[4];

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
kx_il = spl0; kx_ir = spl1;
// ---------- glides ----------
kx_gin  += (kx_tgin - kx_gin) * kx_sm;
kx_trim += (kx_ttrim - kx_trim) * kx_sm;
kx_ldg  += (kx_tldg - kx_ldg) * kx_sm;
kx_cs   += (kx_ct - kx_cs) * kx_sm;
kx_mix  += (kx_tmix - kx_mix) * kx_sm;
kx_og   += (kx_tog - kx_og) * kx_sm;
kx_sw   += (kx_son - kx_sw) * kx_swc;
kx_lw   += (kx_lon - kx_lw) * kx_swc;
// preset duck-and-swap: the engine's switches (style, bits, rate, filters, frames) change in silence
kx_dst == 1 ? ( kx_dk -= kx_dkr; kx_dk <= 0 ? ( kx_dk = 0; kx_md = slider2 >= 0.5; kx_update(); kx_ofilt(); kx_dst = 2; ); ) :
kx_dst == 2 ? ( kx_dk += kx_dkr; kx_dk >= 1 ? ( kx_dk = 1; kx_dst = 0; ); );

// ---------- LEFT: the sampler engine ----------
kx_sw > 0.00001 ? (
  // the converter clock (one clock for both channels)
  kx_dinc >= 1 ? ( kx_ev = 1; kx_fr = 1; ) : (
    kx_dph += kx_dinc; kx_ev = kx_dph >= 1;
    kx_ev ? ( kx_fr = 1 - (kx_dph - 1) / kx_dinc; kx_dph = max(kx_dph - 1 + kx_jw * (rand(2) - 1), 0); );
  );
  kx_al = sL.kx_chan(kx_il); kx_ar = sR.kx_chan(kx_ir);
  kx_sw < 0.99999 ? ( kx_al = kx_il + (kx_al - kx_il) * kx_sw; kx_ar = kx_ir + (kx_ar - kx_ir) * kx_sw; );
) : ( kx_al = kx_il; kx_ar = kx_ir; );

// ---------- RIGHT: the data-reduction limiter ----------
kx_yl = rL.kx_rpre(kx_al); kx_yr = rR.kx_rpre(kx_ar);
// the bands' gains glide to this frame's decisions
kx_i = 0; loop(5, kx_g[kx_i] += (kx_gt[kx_i] - kx_g[kx_i]) * kx_gc; kx_i += 1; );
// coding frame: allocate the bands for the next frame
kx_fc += 1;
kx_fc >= kx_F ? (
  kx_fc = 0;
  kx_lt = 10 * log10(kx_Et / (2 * kx_F) + 0.0000000001);
  kx_i = 0;
  loop(5,
    kx_lb = 10 * log10(kx_E[kx_i] / (2 * kx_F) + 0.0000000001);
    kx_th = max(kx_lt - kx_MSK + 4 * kx_i, kx_ATH + 3 * kx_i);
    kx_spon ? (
      kx_gt[kx_i] = kx_lb > kx_th;
      kx_nb = min(max(floor((kx_lb - kx_th) / 6.02) + kx_bb, 1), 14);
      kx_st[kx_i] = kx_lb > kx_th ? kx_P[kx_i] * 2 ^ (1 - kx_nb) : 0;
    ) : ( kx_gt[kx_i] = 1; kx_st[kx_i] = 0; );
    kx_E[kx_i] = 0; kx_P[kx_i] = 0;
    kx_i += 1;
  );
  kx_Et = 0;
);
// the gain the next sample needs (the detector also hears the pre-emphasised copy)
kx_a = max(max(abs(kx_yl), abs(kx_yr)), max(abs(rL.ue), abs(rR.ue)) * kx_eg);
kx_req = kx_a > kx_cs ? kx_cs / kx_a : 1;
// sliding minimum over the lookahead window
kx_n += 1;
while (kx_qt != kx_qh && kx_qv[(kx_qt - 1) & 1023] >= kx_req) ( kx_qt = (kx_qt - 1) & 1023; );
kx_qi[kx_qt] = kx_n; kx_qv[kx_qt] = kx_req; kx_qt = (kx_qt + 1) & 1023;
while (kx_qi[kx_qh] <= kx_n - kx_L) ( kx_qh = (kx_qh + 1) & 1023; );
kx_mn = kx_qv[kx_qh];
// release (never above the minimum), then the box smoother: the gain is down before the peak arrives
kx_rg = kx_mn < kx_rg ? kx_mn : kx_rg + (kx_mn - kx_rg) * kx_relc;
kx_bs += kx_rg - kx_bx[kx_bp]; kx_bx[kx_bp] = kx_rg; kx_bp += 1;
kx_bp >= kx_L ? ( kx_bp = 0; kx_bs = 0; kx_i = 0; loop(kx_L, kx_bs += kx_bx[kx_i]; kx_i += 1; ); );
kx_s = kx_bs / kx_L;
// pump: a duck that follows the gain reduction
kx_d = 1 - kx_s; kx_pe += (kx_d - kx_pe) * (kx_d > kx_pe ? kx_pa : kx_pr);
kx_gg = min(kx_s * (1 - kx_pump * kx_pe), 1);
kx_gmin = min(kx_gmin, kx_gg);
// the delay lines
kx_wp = (kx_wp + 1) & 1023;
kx_dlL[kx_wp] = kx_yl; kx_dlR[kx_wp] = kx_yr;
kx_dbL[kx_wp] = kx_al; kx_dbR[kx_wp] = kx_ar;
kx_ddL[kx_wp] = kx_il; kx_ddR[kx_wp] = kx_ir;
kx_rp = (kx_wp - kx_L + 1) & 1023;
kx_ol = min(max(kx_dlL[kx_rp] * kx_gg, -kx_cs), kx_cs);
kx_or = min(max(kx_dlR[kx_rp] * kx_gg, -kx_cs), kx_cs);
kx_opk = max(kx_opk, max(abs(kx_ol), abs(kx_or)));
kx_lw < 0.99999 ? ( kx_ol = kx_dbL[kx_rp] + (kx_ol - kx_dbL[kx_rp]) * kx_lw; kx_or = kx_dbR[kx_rp] + (kx_or - kx_dbR[kx_rp]) * kx_lw; );

// ---------- MIX, OUTPUT and the house output stage ----------
kx_mix < 0.99999 ? ( kx_ol = kx_ddL[kx_rp] + (kx_ol - kx_ddL[kx_rp]) * kx_mix; kx_or = kx_ddR[kx_rp] + (kx_or - kx_ddR[kx_rp]) * kx_mix; );
kx_dst ? ( kx_dkg = kx_dk * kx_dk * (3 - 2 * kx_dk); kx_ol *= kx_dkg; kx_or *= kx_dkg; );
kx_ol = kxoL.ost_band(kx_ol) * kx_og;
kx_or = kxoR.ost_band(kx_or) * kx_og;
ost_out(kx_ol, kx_or);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;      // nothing below -400 dB reaches the host
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;

@gfx 980 320
ui_begin(980, 320);

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');          // title
gfx_setfont(10, "Trebuchet MS", 12.5 * sc, 'b');        // scale numbers
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');          // labels
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');          // key captions
gfx_setfont(13, "Courier New", 27 * sc, 'b');           // display digits
gfx_setfont(14, "Trebuchet MS", 14 * sc, 'b');          // knob names
gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');          // model numbers
gfx_setfont(16, "Trebuchet MS", 12 * sc, 'b');          // display print

function kv_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kv_fr(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc, 0); );
function kv_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function kv_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kv_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kv_ltxt(lx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = lx * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kv_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// MODE (slider2): VFD prints English, MATRIX German
kv_de = 0;   // English labels in both modes
// DE prints decimal commas
function kv_dec(s) local(i) ( kv_de ? ( i = 0; loop(strlen(s), str_getchar(s, i) == '.' ? str_setchar(s, i, ','); i += 1; ); ); s; );

// =====================================================================
// The unit faces: u = 0 sampler / 1 limiter, b = MATRIX
// =====================================================================
function kv_style(u, b) (
  kv_u = b ? 1 : u; kv_b = b;                           // (MATRIX dresses both units alike)
  b ? (                                                 // MATRIX: battleship grey, black linework, mustard lamps
    KF  = 0x222528; KS = ui_mix(KF, 0x000000, 0.28); KT = ui_mix(KF, 0x000000, 0.42);
    KI  = 0xC7BEB3; KI2 = ui_mix(0xC7BEB3, KF, 0.38); KA = 0xD4A373; KL = 0x0B0C0D; KHI = 0xD4A373;
    KD  = 0xD4A373; KW = 0x0E0F10; KG = 0x2C302E; KLW = 2;
  ) : (                                                 // VFD: charcoal, VFD glow (sampler cyan, limiter green)
    KF  = 0x181A1B; KS = 0x131516; KT = 0x0F1112;
    KI  = 0xD5DCDE; KI2 = 0x7D888C; KA = u == 0 ? 0x4EE1DC : 0x5CF09A; KL = 0x2E3235; KHI = KA;
    KD  = KA; KW = 0x070808; KG = ui_mix(KA, 0x070808, 0.92); KLW = 1;
  );
);

// a section on the face: MATRIX a sharp enamel face with its frame, VFD a shallow recess
function kv_sect(x, y, w, h) (
  kv_b ? (
    ui_col(KL); kv_r(x, y, w, h);
    ui_col(KS); kv_r(x + KLW, y + KLW, w - 2 * KLW, h - 2 * KLW);
  ) : (
    pk_inset((x + 3) * sc, (y + 3) * sc, (w - 6) * sc, (h - 6) * sc, KS);
  );
);

// a key; returns 1 when clicked. MATRIX: flat enamel keys (cream: orange when lit; grey: mustard block keys);
// VFD: rubberised keys that light up in the display colour
function kv_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = kv_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  kv_b ? (
    kv_u == 0 ? (
      ui_col(KL); kv_r(x, y, w, h);
      on ? ui_col(KA) : ui_col(hov ? 0xF1EEE5 : ui_mix(KF, 0xFFFFFF, 0.35)); kv_r(x + 2, y + 2, w - 4, h - 4);
      on ? ( ui_cola(0xFFFFFF, 0.28); kv_r(x + 2, y + 2, w - 4, 1); );
      ui_col(KI);
    ) : (
      on ? ( ui_cola(KA, 0.22); kv_r(x - 3, y - 3, w + 6, h + 6); );
      ui_col(0x0B0C0D); kv_r(x, y, w, h);
      on ? ui_col(KA) : ui_col(hov ? 0x353A37 : 0x2C302E); kv_r(x + 1.5, y + 1.5, w - 3, h - 4);
      ui_cola(0xFFFFFF, on ? 0.3 : 0.08); kv_r(x + 1.5, y + 1.5, w - 3, 1);
      on ? ui_col(0x17191B) : ui_col(KI);
    );
  ) : (
    ui_cola(0x000000, 0.55); rd_rr((x + 0.5) * sc, (y + 2) * sc, w * sc, h * sc, 5 * sc);
    on ? ( ui_cola(KA, 0.18); rd_rr((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 7 * sc); );
    ui_col(0x0A0B0C); rd_rr(x * sc, y * sc, w * sc, h * sc, 5 * sc);
    on ? ui_col(ui_mix(KA, 0x000000, 0.12)) : ui_col(hov ? 0x34383B : 0x2A2D30);
    rd_rr((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, 4 * sc);
    on ? ui_col(0x0B0C0D) : ui_col(0xB4BDC0);
  );
  gfx_setfont(12); kv_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);

// a status lamp (x, y = centre)
function kv_lamp(x, y, r, on, col) (
  kv_b && kv_u == 0 ? (
    ui_col(0x141414); gfx_circle(x * sc, y * sc, (r + 2.5) * sc, 1, 1);
    ui_col(0x8A867A); gfx_circle(x * sc, y * sc, (r + 1) * sc, 1, 1);
    rd_lamp(x, y, r, on, col);
  ) : (
    on ? ( ui_cola(col, 0.25); gfx_circle(x * sc, y * sc, (r + 4) * sc, 1, 1); );
    ui_col(0x050606); gfx_circle(x * sc, y * sc, (r + 1.2) * sc, 1, 1);
    ui_col(on ? col : ui_mix(col, 0x000000, 0.8)); gfx_circle(x * sc, y * sc, r * sc, 1, 1);
    on ? ( ui_cola(0xFFFFFF, 0.6); gfx_circle((x - r * 0.3) * sc, (y - r * 0.3) * sc, r * 0.3 * sc, 1, 1); );
  );
);

// a display window: MATRIX black glass in a black bezel, VFD smoked VFD glass
function kv_glass(x, y, w, h) (
  kv_b ? (
    ui_col(KL); kv_r(x - 2, y - 2, w + 4, h + 4);
    ui_col(KW); kv_r(x, y, w, h);
    ui_cola(0xFFFFFF, 0.05); kv_r(x, y, w, h * 0.4);
  ) : (
    ui_col(0x2E3235); kv_r(x - 1, y - 1, w + 2, h + 2);
    ui_col(KW); kv_r(x, y, w, h);
    ui_cola(KA, 0.035); kv_r(x, y, w, h);
    ui_cola(0xFFFFFF, 0.04); kv_r(x, y, w, 1);
  );
);
// glowing digits, right-aligned at rx, with their unlit ghost behind (VFD shows the ghost segments)
function kv_digits(rx, cy, s, ghost, col) (
  gfx_setfont(13);
  ui_col(KG); kv_rtxt(rx, cy, ghost);
  ui_cola(col, 0.22); kv_rtxt(rx + 0.8, cy + 0.8, s);
  ui_col(col); kv_rtxt(rx, cy, s);
);
// a segmented bar: n segments, q = 0..1 lit, fromr = lit from the right; zone starts zA / zR (0..1 from the
// lit end's far side). VFD: VFD segments with ghosts; MATRIX: LED blocks.
function kv_bar(x, y, w, h, n, q, fromr, zA, zR) local(i, sw, p, lit, c, sx) (
  sw = w / n; i = 0;
  loop(n,
    sx = x + i * sw;
    p = fromr ? (n - i - 0.5) / n : (i + 0.5) / n;
    lit = q >= p;
    p = fromr ? 1 - p : p;
    kv_b ? (
      c = kv_u == 0 ? ( p >= zR ? 0xFF3A2A : p >= zA ? 0xFFB030 : 0x46D86A ) : ( p >= zR ? 0xBC3908 : p >= zA ? 0xD4A373 : 0x2E7A48 );
      lit ? (
        ui_cola(c, 0.18); kv_r(sx - 0.5, y - 1, sw + 1, h + 2);
        ui_col(c); kv_r(sx + 1, y, sw - 2.5, h);
        ui_cola(0xFFFFFF, 0.25); kv_r(sx + 1, y, sw - 2.5, 1.5);
      ) : (
        ui_col(ui_mix(c, 0x000000, 0.8)); kv_r(sx + 1, y, sw - 2.5, h);
      );
    ) : (
      c = p >= zR ? (kv_u == 0 ? 0xFF8C00 : 0xFF4A2A) : KD;
      lit ? (
        ui_cola(c, 0.2); kv_r(sx - 0.5, y - 1.5, sw, h + 3);
        ui_col(c); kv_r(sx + 0.5, y, sw - 2, h);
        ui_cola(0xFFFFFF, 0.25); kv_r(sx + 0.5 + (sw - 2) * 0.5 - 0.5, y + 2, 1, h - 4);
      ) : (
        ui_col(ui_mix(c, 0x070808, 0.9)); kv_r(sx + 0.5, y, sw - 2, h);
      );
    );
    i += 1;
  );
);

// ---------- knobs ----------
// kind: 0 linear, 1 BITS detents, 2 RATE detents (log between), 3 square law (RELEASE)
function kv_v2n(kind, v, lo, hi) local(i, n) (
  kind == 1 ? (
    v = min(max(v, 8), 24); i = v < 10 ? 0 : v < 12 ? 1 : v < 16 ? 2 : 3;
    (i + (v - kx_BTAB[i]) / (kx_BTAB[i + 1] - kx_BTAB[i])) / 4;
  ) : kind == 2 ? (
    v = min(max(v, 8000), 48000); i = 0; loop(6, v >= kx_RTAB[i + 1] ? i += 1; );
    (i + log(v / kx_RTAB[i]) / log(kx_RTAB[i + 1] / kx_RTAB[i])) / 7;
  ) : kind == 3 ? sqrt(max(v - lo, 0) / (hi - lo)) : (v - lo) / (hi - lo);
);
function kv_n2v(kind, n, lo, hi) local(i, f) (
  n = min(max(n, 0), 1);
  kind == 1 ? ( f = n * 4; i = min(floor(f), 3); f -= i; kx_BTAB[i] + (kx_BTAB[i + 1] - kx_BTAB[i]) * f; ) :
  kind == 2 ? ( f = n * 7; i = min(floor(f), 6); f -= i; kx_RTAB[i] * (kx_RTAB[i + 1] / kx_RTAB[i]) ^ f; ) :
  kind == 3 ? lo + (hi - lo) * n * n : lo + (hi - lo) * n;
);
// a printed tick and its number at n (0..1) round a knob
function kv_tick(cx, cy, r, n, s, big) local(a, ca, sa) (
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  kv_b || kv_tl ? (                                     // (VFD main knobs: their value ring takes the place of the ticks)
    ui_col(KI2);
    gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + (big ? 8 : 6))) * sc, (cy + sa * (r + (big ? 8 : 6))) * sc, 1);
    big ? gfx_line((cx + ca * (r + 4)) * sc + 1, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 8)) * sc + 1, (cy + sa * (r + 8)) * sc, 1);
  );
  strlen(s) ? ( gfx_setfont(10); ui_col(KI); kv_ctxt(cx + ca * (r + 14), cy + sa * (r + 13), s); );
);
// numbers from a list "a|b|c", evenly spread
function kv_scale(cx, cy, r, labels) local(i, k, k0, len, c, n) (
  len = strlen(labels); n = 1; k = 0; loop(len, str_getchar(labels, k) == 124 ? n += 1; k += 1; );
  k0 = 0; i = 0; k = 0;
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? ( strcpy_substr(#kv_sl, labels, k0, k - k0); kv_tick(cx, cy, r, i / max(n - 1, 1), #kv_sl, 1); i += 1; k0 = k + 1; );
    k += 1;
  );
);
kv_tl = 1;                                              // tick lines round the knobs (0: VFD main knobs)
// a smooth thick arc (pixels): anti-aliased arcs every half pixel
function kv_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
// a straight pointer line, w pixels wide (pixel coordinates)
function kv_ptr(cx, cy, a, r1, r2, w) local(ca, sa, k) (
  ca = sin(a); sa = -cos(a); k = -w * 0.5;
  loop(max(1, floor(w * 2) + 1), gfx_line(cx + ca * r1 - sa * k, cy + sa * r1 + ca * k, cx + ca * r2 - sa * k, cy + sa * r2 + ca * k, 1); k += 0.5; );
);
// VFD knob: a smooth black rubber body with one soft highlight, a thin track with the value arc glowing in the
// display colour
function kv_tcap(cx, cy, r, n) local(rr, a, a0) (
  a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; rr = r + 5 * sc;
  ui_col(0x2A2E30); kv_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  n > 0.004 ? (
    ui_col(ui_mix(KA, KS, 0.78)); kv_arcw(cx, cy, rr, a0, a, 5 * sc);
    ui_col(KA); kv_arcw(cx, cy, rr, a0, a, 2.2 * sc);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, 1.1 * sc, 1, 1); gfx_circle(cx + sin(a) * rr, cy - cos(a) * rr, 1.1 * sc, 1, 1);
  );
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 3 * sc, r, 1, 1);
  ui_col(0x090A0B); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0x1B1E20); gfx_circle(cx, cy, r - 1.5 * sc, 1, 1);
  ui_col(0x34383B); kv_arcw(cx, cy, r - 2.5 * sc, -0.66 * $pi, 0.06 * $pi, 1.2 * sc);
  ui_col(ui_mix(KA, 0xFFFFFF, 0.35)); kv_ptr(cx, cy, a, r * 0.3, r - 4 * sc, 2 * sc);
);
// MATRIX knob: a plain dark skirt, a flat satin-silver face with one soft highlight on its edge, a black pointer
function kv_bcap(cx, cy, r, a) (
  ui_cola(0x000000, 0.35); gfx_circle(cx + 1.5 * sc, cy + 3 * sc, r, 1, 1);
  ui_col(0x1A1B1E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0x5B6168); gfx_circle(cx, cy, r * 0.8, 1, 1);
  ui_col(0xB7BCC2); gfx_circle(cx, cy, r * 0.8 - 1.2 * sc, 1, 1);
  ui_col(0xDCDFE3); kv_arcw(cx, cy, r * 0.8 - 2.6 * sc, -0.66 * $pi, 0.06 * $pi, 1.3 * sc);
  ui_col(0x141416); kv_ptr(cx, cy, a, r * 0.2, r * 0.95, 2 * sc);
);
// a knob: cap 0 = the unit's main knob (VFD rubber / MATRIX cast aluminium), 1 = black low-pass filter cap,
// otherwise a small house knob with that cap colour. Its name below; the value replaces it while touched.
function kv_knob(cx, cy, r, idx, kind, lo, hi, def, cap, name, val) local(v, n, dx, dy, hov, did, st, nst, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  st = (kind == 1 || kind == 2) && slider5 < 0.5; nst = kind == 1 ? 5 : 8;
  pressed && hov && drag_id == 0 ? (
    time_precise() - kv_lt < 0.35 && kv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; kv_lt = 0; ) : (
      drag_id = did; kv_y = mouse_y; kv_lt = time_precise(); kv_lid = idx; kv_n = kv_v2n(kind, v, lo, hi);
    );
  );
  drag_id == did ? (
    kv_n = min(max(kv_n + (kv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); kv_y = mouse_y;
    v = kv_n2v(kind, st ? floor(kv_n * (nst - 1) + 0.5) / (nst - 1) : kv_n, lo, hi);
    kind == 0 || kind == 3 ? v = floor(v * 10 + 0.5) / 10;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = kv_v2n(kind, v, lo, hi);
    n = st ? min(max(floor(n * (nst - 1) + 0.5) + sign(mouse_wheel), 0), nst - 1) / (nst - 1)
           : min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    slider(idx) = kv_n2v(kind, n, lo, hi); ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = kv_v2n(kind, v, lo, hi); a = -0.75 * $pi + n * 1.5 * $pi;
  cap == 0 ? (
    kv_b ? kv_bcap(cx * sc, cy * sc, r * sc, a) : kv_tcap(cx * sc, cy * sc, r * sc, n);
  ) : cap == 1 ? (
    strcpy(#kf_lo, ""); strcpy(#kf_hi, ""); ui_knob_filter(cx * sc, cy * sc, r * sc, a, 0, 2);
  ) : dy_fcap(cx * sc, cy * sc, r * sc, a, cap);
  kv_act = hov || drag_id == did;
  kv_act ? ( ui_cola(0xFFFFFF, 0.08); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1); );
  gfx_setfont(cap == 0 || cap == 1 ? 14 : 11);
  ui_col(kv_act ? KHI : KI);
  kv_ctxt(cx, cy + r + (cap == 0 || cap == 1 ? 19 : 14), kv_act ? val : name);
);
// eleven plain ticks round a small knob
function kv_ticks(cx, cy, r) local(i) ( i = 0; loop(11, kv_tick(cx, cy, r, i / 10, "", i == 0 || i == 5 || i == 10); i += 1; ); );

// =====================================================================
// A half-rack unit: case, corner screws, model plate and ON key
// =====================================================================
function kv_unit(x, y, w, h, model, s1, s2, oidx) local(tw, th) (
  ui_cola(0x000000, 0.45); kv_r(x + 2, y + 4, w, h);
  ui_col(kv_b ? KL : 0x050606); kv_r(x, y, w, h);
  ui_col(KF); kv_r(x + KLW, y + KLW, w - 2 * KLW, h - 2 * KLW);
  !kv_b ? ( ui_cola(0xFFFFFF, 0.06); kv_r(x + 1, y + 1, w - 2, 1); gfx_gradrect((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, 40 * sc, 1, 1, 1, 0.03, 0, 0, 0, 0, 0, 0, 0, -0.03 / (40 * sc)); );
  rd_screw(x + 11, y + 11); rd_screw(x + w - 11, y + 11); rd_screw(x + 11, y + h - 11); rd_screw(x + w - 11, y + h - 11);
  // model plate
  gfx_setfont(15); ui_col(kv_b ? KI : KI); kv_txt(x + 24, y + 8, model);
  gfx_measurestr(model, tw, th);
  kv_b ? ( ui_col(KA); kv_r(x + 24, y + 40, tw / sc, 3); ) : ( ui_col(KA); kv_r(x + 24, y + 41, tw / sc, 2); ui_cola(KA, 0.25); kv_r(x + 24, y + 40, tw / sc, 4); );
  gfx_setfont(11); ui_col(KI2); kv_txt(x + 32 + tw / sc, y + 11, s1); kv_txt(x + 32 + tw / sc, y + 26, s2);
  // ON
  kv_key(x + w - 64, y + 10, 42, 26, kv_de ? "EIN" : "ON", slider(oidx) >= 0.5) ? ( slider(oidx) = slider(oidx) >= 0.5 ? 0 : 1; ui_auto(oidx); );
);

// =====================================================================
// Panel and header
// =====================================================================
KH = 0x2A2D30; KHI_ = 0xEEEFEA;
ui_col(0x1D1F21); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(KH); kv_r(0, 0, 980, 54);
ui_cola(0xFFFFFF, 0.06); kv_r(0, 0, 980, 1);
ui_col(0x111213); kv_r(0, 54, 980, 2);
ui_col(KHI_); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(KH); ui_text(31 * sc, 21.5 * sc, "GFX");
gfx_setfont(6); ui_col(KHI_); kv_txt(58, 12, "DUO81");
gfx_setfont(11); ui_col(0xA99999); kv_txt(206, 14, kv_de ? "ABTASTEINHEIT" : "SAMPLER ENGINE"); kv_txt(206, 29, kv_de ? "+ DIGITALER BEGRENZER" : "+ DIGITAL LIMITER");
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(370 * sc, 10 * sc, 368 * sc, 34 * sc, pr_cur,
  "Init|12-Bit Drums|Hip-Hop Crunch|8-Bit Grit|Tape-Fed Sampler|Berlin Dust|Data Squash|Glassy Highs|Pump Bus|Broadcast Brick|Warsaw Lab|Full Crush");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 12 ? 1 : k_; );
// MODE: two lit keys in the mode's own dress (VFD = DS-81 + DL-81, English; MATRIX = ZA-81 + BG-81, German).
// Pressing one also retires an old project's differing limiter style (slider13 back to -1).
kv_style(0, slider2 >= 0.5);
kv_key(752, 15, 70, 24, "VFD", slider2 < 0.5) ? ( slider2 = 0; slider13 = -1; ui_auto(2); ui_auto(13); );
kv_key(826, 15, 76, 24, "MATRIX", slider2 >= 0.5) ? ( slider2 = 1; slider13 = -1; ui_auto(2); ui_auto(13); );
kv_de = 0;   // English labels in both modes
ui_size_picker(912 * sc, 18 * sc);

// ---------- meter smoothing (frame-rate independent) ----------
kv_now = time_precise();
kv_dt = kv_t0 > 0 ? min(max(kv_now - kv_t0, 0), 0.25) : 1; kv_t0 = kv_now;
kv_ipd = max(20 * log10(max(kxa_ipk, 0.000001)), kv_ipd - 30 * kv_dt); kxa_ipk >= 0.98 ? kv_clt = kv_now; kxa_ipk = 0;
kv_grd = max(kxa_gr, kv_grd - 25 * kv_dt); kxa_gr = 0;
kv_opd = max(20 * log10(max(kxa_opk, 0.000001)), kv_opd - 30 * kv_dt); kxa_opk = 0;
kxa_ovp >= 1 ? kv_ovt = kv_now; kxa_ovp = 0;

// =====================================================================
// LEFT UNIT: DS-81 / ZA-81 sampler engine (x 8..440)
// =====================================================================
kv_style(0, slider2 >= 0.5);
kv_x = 8;
kv_unit(kv_x, 60, 432, 254, kv_b ? "ZA-81" : "DS-81", kv_de ? "DIGITALE" : "DIGITAL SAMPLER", kv_de ? "ABTASTEINHEIT" : "ENGINE", 1);
kv_on = slider1 >= 0.5;
// ---------- the display ----------
kv_sect(kv_x + 12, 108, 268, 86);
kv_glass(kv_x + 20, 115, 252, 72);
kv_bt = slider5 >= 0.5 ? slider4 : kx_snap(kx_BTAB, 5, slider4);
kv_rt = slider5 >= 0.5 ? slider7 : kx_snap(kx_RTAB, 8, slider7);
kv_dc = kv_on ? KD : ui_mix(KD, KW, 0.75);
slider5 >= 0.5 && kv_bt != floor(kv_bt) ? sprintf(#kvs, "%.1f", kv_bt) : sprintf(#kvs, "%d", kv_bt);
kv_digits(kv_x + 92, 134, #kvs, slider5 >= 0.5 && kv_bt != floor(kv_bt) ? "88.8" : "88", kv_dc);
gfx_setfont(16); ui_col(kv_b ? KD : KI2); kv_txt(kv_x + 96, 136, "BIT");
sprintf(#kvs, "%.1f", kv_rt / 1000); kv_dec(#kvs);
kv_digits(kv_x + 196, 134, #kvs, "88.8", kv_dc);
gfx_setfont(16); ui_col(kv_b ? KD : KI2); kv_txt(kv_x + 200, 136, "kHz");
// mode flags
gfx_setfont(11);
kv_i = 0;
loop(3,
  kv_f = kv_i == 0 ? slider8 >= 0.5 : kv_i == 1 ? slider6 >= 0.5 : slider5 >= 0.5;
  ui_col(kv_f && kv_on ? KD : ui_mix(KD, KW, 0.82));
  kv_rtxt(kv_x + 267, 126 + kv_i * 19, kv_i == 0 ? "AA" : kv_i == 1 ? "NL" : (kv_de ? "FREI" : "FREE"));
  kv_i += 1;
);
// converter level: -36 .. 0 dBFS, CLIP lamp
gfx_setfont(16); ui_col(kv_b ? KD : KI2); kv_txt(kv_x + 28, 158, kv_de ? "EIN" : "IN");
kv_bar(kv_x + 56, 158, 140, 12, kv_b ? 18 : 36, kv_on ? (kv_ipd + 36) / 36 : 0, 0, 30 / 36, 34 / 36);
gfx_setfont(10); ui_col(kv_b ? ui_mix(KD, KW, 0.4) : KI2);
kv_i = 0; loop(4, kv_v = kv_i == 0 ? -36 : kv_i == 1 ? -24 : kv_i == 2 ? -12 : 0;
  sprintf(#kvs, "%d", kv_v); kv_ctxt(kv_x + 56 + 140 * (kv_v + 36) / 36, 179, #kvs); kv_i += 1; );
kv_lamp(kv_x + 222, 164, 4.5, kv_on && kv_now - kv_clt < 0.3, 0xFF3A2A);
gfx_setfont(10); ui_col(kv_b ? ui_mix(KD, KW, 0.4) : KI2); kv_ctxt(kv_x + 222, 179, "CLIP");

// ---------- keys and TRIM ----------
kv_sect(kv_x + 286, 108, 134, 86);
kv_key(kv_x + 296, 115, 82, 22, kv_de ? "AA-FILTER" : "AA FILTER", slider8 >= 0.5) ? ( slider8 = slider8 >= 0.5 ? 0 : 1; ui_auto(8); );
kv_key(kv_x + 296, 141, 82, 22, kv_de ? "NICHTLIN." : "NON-LIN", slider6 >= 0.5) ? ( slider6 = slider6 >= 0.5 ? 0 : 1; ui_auto(6); );
kv_key(kv_x + 296, 167, 82, 22, kv_de ? "FREI" : "FREE", slider5 >= 0.5) ? (
  slider5 = slider5 >= 0.5 ? 0 : 1;
  slider5 < 0.5 ? ( slider4 = kx_snap(kx_BTAB, 5, slider4); slider7 = kx_snap(kx_RTAB, 8, slider7); );   // back onto the detents
  ui_auto(5); ui_auto(4); ui_auto(7);
);
sprintf(#kvv, "%+.1f dB", slider11); kv_dec(#kvv);
kv_ticks(kv_x + 400, 142, 11);
kv_knob(kv_x + 400, 142, 11, 11, 0, -24, 12, 0, 0x9DA2A8, "TRIM", #kvv);

// ---------- the knob row ----------
kv_sect(kv_x + 12, 200, 408, 106);
kv_cy = 244; kv_kr = 22;
kv_tl = 0;                                              // (VFD: no tick lines round the main knobs)
sprintf(#kvv, "+%.1f dB", slider3); kv_dec(#kvv);
kv_scale(kv_x + 58, kv_cy, kv_kr, "0||12||24");
kv_knob(kv_x + 58, kv_cy, kv_kr, 3, 0, 0, 24, 0, 0, kv_de ? "EINGANG" : "DRIVE", #kvv);
slider5 >= 0.5 ? sprintf(#kvv, "%.2f bit", slider4) : sprintf(#kvv, "%d bit", kx_snap(kx_BTAB, 5, slider4)); kv_dec(#kvv);
kv_scale(kv_x + 136, kv_cy, kv_kr, "8|10|12|16|24");
kv_knob(kv_x + 136, kv_cy, kv_kr, 4, 1, 8, 24, 12, 0, "BITS", #kvv);
sprintf(#kvv, "%.2f kHz", (slider5 >= 0.5 ? slider7 : kx_snap(kx_RTAB, 8, slider7)) / 1000); kv_dec(#kvv);
kv_i = 0; loop(8, kv_tick(kv_x + 214, kv_cy, kv_kr, kv_i / 7, kv_i == 0 ? "8" : kv_i == 3 ? "22" : kv_i == 5 ? "32" : kv_i == 7 ? "48" : "", 1); kv_i += 1; );
kv_knob(kv_x + 214, kv_cy, kv_kr, 7, 2, 8000, 48000, 40000, 0, kv_de ? "TAKT" : "RATE", #kvv);
slider8 >= 0.5 ? sprintf(#kvv, "%.0f %%", slider9) : strcpy(#kvv, kv_de ? "AA AUS" : "AA OFF");
kv_tl = 1;                                              // (the AA and FILTER filter caps keep their ticks)
kv_scale(kv_x + 292, kv_cy, kv_kr - 2, "0|5|10");
kv_knob(kv_x + 292, kv_cy, kv_kr - 2, 9, 0, 0, 100, 100, 1, "AA", #kvv);
sprintf(#kvv, "%.0f %%  %.1f kHz", slider10, kx_fo / 1000); kv_dec(#kvv);
kv_scale(kv_x + 370, kv_cy, kv_kr - 2, "0|5|10");
kv_knob(kv_x + 370, kv_cy, kv_kr - 2, 10, 0, 0, 100, 85, 1, "FILTER", #kvv);
kv_tl = 0;

// =====================================================================
// RIGHT UNIT: DL-81 / BG-81 digital limiter (x 540..972)
// =====================================================================
kv_style(1, slider2 >= 0.5);
kv_x = 540;
kv_unit(kv_x, 60, 432, 254, (slider13 > -0.5 ? slider13 >= 0.5 : kv_b) ? "BG-81" : "DL-81", kv_de ? "DIGITALER" : "DIGITAL LIMITER", kv_de ? "BEGRENZER" : "UNIT", 12);
kv_on = slider12 >= 0.5;
kv_sect(kv_x + 12, 108, 408, 86);
kv_glass(kv_x + 20, 115, 392, 72);
kv_dc = kv_on ? KD : ui_mix(KD, KW, 0.75);
// GR ladder, lit from the right: 0 .. 20 dB
gfx_setfont(16); ui_col(kv_b ? KD : KI2); kv_txt(kv_x + 28, 120, kv_de ? "RED." : "GR");
kv_bar(kv_x + 66, 121, 220, 13, kv_b ? 20 : 40, kv_on ? kv_grd / 20 : 0, 1, 0.3, 0.6);
gfx_setfont(10); ui_col(kv_b ? ui_mix(KD, KW, 0.4) : KI2);
kv_i = 0; loop(5, sprintf(#kvs, "%d", kv_i * 5); kv_ctxt(kv_x + 66 + 220 * (1 - kv_i / 4), 143, #kvs); kv_i += 1; );
// output peak: -30 .. 0 dBFS
gfx_setfont(16); ui_col(kv_b ? KD : KI2); kv_txt(kv_x + 28, 155, kv_de ? "AUS" : "OUT");
kv_bar(kv_x + 66, 156, 220, 13, kv_b ? 20 : 40, (kv_opd + 30) / 30, 0, 0.7, 0.94);
gfx_setfont(10); ui_col(kv_b ? ui_mix(KD, KW, 0.4) : KI2);
kv_i = 0; loop(6, sprintf(#kvs, "%d", -30 + kv_i * 6); kv_ctxt(kv_x + 66 + 220 * kv_i / 5, 178, #kvs); kv_i += 1; );
// GR readout and OVER
kv_on ? ( kv_grd < 0.05 ? strcpy(#kvs, " 0.0") : sprintf(#kvs, "%4.1f", -kv_grd); ) : strcpy(#kvs, " ---");
kv_dec(#kvs);
kv_digits(kv_x + 374, 132, #kvs, "88.8", kv_dc);
gfx_setfont(16); ui_col(kv_b ? KD : KI2); kv_txt(kv_x + 378, 133, "dB");
kv_lamp(kv_x + 312, 167, 5, kv_now - kv_ovt < 0.4, 0xFF3A2A);
gfx_setfont(16); ui_col(kv_b ? KD : KI2); kv_ltxt(kv_x + 324, 167, kv_de ? "ÜBERSTEUERT" : "OVER");
// the HF bands the coder keeps (lit) or drops (dark)
gfx_setfont(10); ui_col(kv_b ? ui_mix(KD, KW, 0.4) : KI2); kv_ctxt(kv_x + 300, 152, "HF");
kv_i = 0; loop(5, ui_col(kv_on && (kxa_bands & (1 << kv_i)) ? KD : ui_mix(KD, KW, 0.85)); kv_r(kv_x + 312 + kv_i * 18, 150, 13, 4); kv_i += 1; );

// ---------- the knob row ----------
kv_sect(kv_x + 12, 200, 408, 106);
sprintf(#kvv, "+%.1f dB", slider14); kv_dec(#kvv);
kv_scale(kv_x + 58, kv_cy, kv_kr, "0||12||24");
kv_knob(kv_x + 58, kv_cy, kv_kr, 14, 0, 0, 24, 0, 0, kv_de ? "ANTRIEB" : "DRIVE", #kvv);
sprintf(#kvv, "%.1f dBFS", slider15); kv_dec(#kvv);
kv_scale(kv_x + 136, kv_cy, kv_kr, "-12||-6||0");
kv_knob(kv_x + 136, kv_cy, kv_kr, 15, 0, -12, 0, -1, 0, kv_de ? "GRENZE" : "CEILING", #kvv);
slider16 < 0.05 ? strcpy(#kvv, kv_de ? "SOFORT" : "INSTANT") : slider16 < 10 ? sprintf(#kvv, "%.1f ms", slider16) : sprintf(#kvv, "%.0f ms", slider16); kv_dec(#kvv);
kv_tick(kv_x + 214, kv_cy, kv_kr, 0, "0", 1); kv_tick(kv_x + 214, kv_cy, kv_kr, sqrt(10 / 300), "10", 1);
kv_tick(kv_x + 214, kv_cy, kv_kr, sqrt(50 / 300), "50", 1); kv_tick(kv_x + 214, kv_cy, kv_kr, sqrt(150 / 300), "150", 1);
kv_tick(kv_x + 214, kv_cy, kv_kr, 1, "300", 1);
kv_knob(kv_x + 214, kv_cy, kv_kr, 16, 3, 0, 300, 30, 0, kv_de ? "RÜCKLAUF" : "RELEASE", #kvv);
sprintf(#kvv, "%.0f %%", slider17);
kv_scale(kv_x + 292, kv_cy, kv_kr, "0|5|10");
kv_knob(kv_x + 292, kv_cy, kv_kr, 17, 0, 0, 100, 15, 0, kv_de ? "SPEKTRAL" : "SPECTRAL", #kvv);
sprintf(#kvv, "%.0f %%", slider18);
kv_scale(kv_x + 370, kv_cy, kv_kr, "0|5|10");
kv_knob(kv_x + 370, kv_cy, kv_kr, 18, 0, 0, 100, 0, 0, kv_de ? "SÄTTIG." : "SAT", #kvv);

// =====================================================================
// The central mounting bracket: the chain's MIX, DRIFT, OUTPUT and band SAT (x 430..550)
// =====================================================================
KF = 0x9DA2A8; KI = 0x1C1C1C; KI2 = 0x3A3D40; KHI = 0x8A2E00; kv_b = 1; kv_u = 0;
ui_cola(0x000000, 0.5); kv_r(432, 62, 120, 256);
rd_brushed(430, 58, 120, 258, 0x9AA0A6);
ui_cola(0x000000, 0.45); kv_fr(430, 58, 120, 258);
ui_cola(0xFFFFFF, 0.35); kv_r(431, 59, 118, 1);
ui_cola(0x000000, 0.25); kv_r(441, 66, 1, 244); kv_r(538, 66, 1, 244);
rd_screw(440, 72); rd_screw(540, 72); rd_screw(440, 302); rd_screw(540, 302);
gfx_setfont(11); ui_col(0x1C1C1C); kv_ctxt(490, 76, kv_de ? "KETTE" : "CHAIN");
sprintf(#kvv, "%.0f %%", slider19);
kv_ticks(466, 136, 13); kv_knob(466, 136, 13, 19, 0, 0, 100, 100, 0xC7BEB3, kv_de ? "MISCH." : "MIX", #kvv);
sprintf(#kvv, "%.0f %%", slider20);
kv_ticks(514, 136, 13); kv_knob(514, 136, 13, 20, 0, 0, 100, 50, 0x6F8794, "DRIFT", #kvv);
sprintf(#kvv, "%+.1f dB", slider21);
kv_ticks(466, 228, 13); kv_knob(466, 228, 13, 21, 0, -24, 12, 0, 0x9DA2A8, kv_de ? "AUSG." : "OUTPUT", #kvv);
sprintf(#kvv, "%.0f %%", slider22);
kv_ticks(514, 228, 13); kv_knob(514, 228, 13, 22, 0, 0, 100, 0, 0xD8B040, kv_de ? "SÄTT." : "SAT", #kvv);

pk_end();
ui_end();
