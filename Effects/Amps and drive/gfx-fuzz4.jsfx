function load_preset(p) local(i) (
  fz_def();
  p == 2  ? ( fz_hy(2, 8.5, 6.5, 6, 4.6); slider3 = -62; slider8 = 65; ) :
  p == 3  ? ( fz_hy(1, 7.5, 4.5, 6.5, 4.8); slider8 = 60; ) :
