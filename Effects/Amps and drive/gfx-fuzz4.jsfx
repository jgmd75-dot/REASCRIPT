@gfx 1100 420
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1100, 420);
sc != fg_lsc ? (
  fg_lsc = sc;
  gfx_setfont(11, "Trebuchet MS", 15 * sc, 'b');
  gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');
  gfx_setfont(13, "Trebuchet MS", 11 * sc, 'b');
  gfx_setfont(14, "Trebuchet MS", 12 * sc, 'b');
  gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');
);
FG_FACE = 0x2A2236; FG_PLATE = 0x211B2B; FG_EDGE = 0x3D3350; FG_INK = 0xEDE6F5; FG_DIM = 0xA597B8;
FG_ACC = 0xFF7A1F; FG_TRAYC = 0x1B1623;

function fg_rr(x, y, w, h, r) local(x1, y1, x2, y2, rr) (
  x1 = floor(x * sc + 0.5); y1 = floor(y * sc + 0.5); x2 = floor((x + w) * sc + 0.5); y2 = floor((y + h) * sc + 0.5);
  rr = min(floor(r * sc + 0.5), floor((min(x2 - x1, y2 - y1)) * 0.5));
  gfx_a < 1 ? ui_rrs(x1, y1, x2 - x1, y2 - y1, rr) : (
    gfx_rect(x1 + rr, y1, x2 - x1 - 2 * rr, y2 - y1);
    gfx_rect(x1, y1 + rr, rr + 1, y2 - y1 - 2 * rr); gfx_rect(x2 - rr - 1, y1 + rr, rr + 1, y2 - y1 - 2 * rr);
    gfx_circle(x1 + rr, y1 + rr, rr, 1, 1); gfx_circle(x2 - rr - 1, y1 + rr, rr, 1, 1);
    gfx_circle(x1 + rr, y2 - rr - 1, rr, 1, 1); gfx_circle(x2 - rr - 1, y2 - rr - 1, rr, 1, 1);
  );
);
function fg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function fg_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function fg_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function fg_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function fg_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );

function fg_key(x, y, w, h, on, col, s, fnt) local(hov, hit) (
  hov = fg_in(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.45); fg_rr(x + 1, y + 2, w, h, 3);
  ui_col(0x0B0910); fg_rr(x, y, w, h, 3);
  on ? (
    ui_cola(col, 0.2); fg_rr(x - 3, y - 3, w + 6, h + 6, 5);
    ui_col(col); fg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
    gfx_gradrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc * 0.5, 1, 1, 1, 0.3, 0, 0, 0, 0, 0, 0, 0, -0.3 / ((h - 4) * sc * 0.5));
  ) : (
    ui_col(ui_mix(col, 0x17121F, 0.8)); fg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  );
  hov ? ( ui_cola(0xFFFFFF, 0.08); fg_rr(x, y, w, h, 3); );
  gfx_setfont(fnt); ui_col(on ? 0x1C0E02 : ui_mix(col, FG_INK, 0.55));
  ui_keytext((x + w * 0.5) * sc, (y + h * 0.5) * sc, s);
  hit;
);
function fg_kn(cx, cy, r, idx, lo, hi, def, kst, cap, lbl, val) (
  dy_kst = kst; dy_knob(cx, cy, r, idx, lo, hi, def, 0, cap, "", "");
  gfx_setfont(12); ui_col(dy_act ? FG_ACC : FG_INK); fg_tc(cx, cy + r + 9, dy_act ? val : lbl);
);
function fg_v10(idx) ( sprintf(#fgv, "%.1f", slider(idx)); );
function fg_k10(cx, cy, r, idx, def, kst, cap, lbl) ( fg_kn(cx, cy, r, idx, 0, 10, def, kst, cap, lbl, fg_v10(idx)); );
function fg_modes(x, y, w, idx, n, l0, l1, l2) local(kw, j, v) (
  kw = (w - (n - 1) * 6) / n; v = floor(slider(idx) + 0.5); j = 0;
  loop(n,
    fg_key(x + j * (kw + 6), y, kw, 22, v == j, FG_ACC, j == 0 ? l0 : j == 1 ? l1 : l2, 14) ? ( slider(idx) = j; ui_auto(idx); );
    j += 1;
  );
);
function fg_tray(x, y, w, h, title) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, FG_TRAYC);
  gfx_setfont(14); ui_col(FG_DIM); fg_tl(x + 10, y + 6, title);
);

function fg_name(i) ( i == 0 ? "HYPER" : i == 1 ? "MODEL" : i == 2 ? "ROUND" : "OCTA"; );
function fg_sub(i) (
  i == 0 ? "HYPER FUZZ  ·  SILICON" : i == 1 ? "MODELLING FUZZ  ·  3 CLASSICS" :
  i == 2 ? (slider33 >= 0.5 ? "ROUND FUZZ  ·  SILICON" : "ROUND FUZZ  ·  GERMANIUM") : "OCTAVE FUZZ  ·  BOUTIQUE";
);
function fg_sec(i) local(x0, on, cx, t, w) (
  x0 = 40 + i * 258; on = fg_sel == i;
  ui_cola(0x000000, 0.5); fg_rr(x0 + 1, 64, 248, 238, 7);
  ui_col(on ? ui_mix(FG_ACC, FG_PLATE, 0.45) : FG_EDGE); fg_rr(x0, 62, 248, 238, 7);
  ui_col(FG_PLATE); fg_rr(x0 + 1.5, 63.5, 245, 235, 6);
  gfx_gradrect((x0 + 3) * sc, 65 * sc, 242 * sc, 40 * sc, 1, 1, 1, 0.04, 0, 0, 0, 0, 0, 0, 0, -0.04 / (40 * sc));
  dy_bg = FG_PLATE; dy_ink = FG_INK;
  fg_key(x0 + 12, 72, 224, 28, on, FG_ACC, fg_name(i), 11) ? ( slider1 = i; ui_auto(1); );
  gfx_setfont(13); ui_col(FG_DIM); fg_tc(x0 + 124, 106, fg_sub(i));
  i == 0 ? (
    fg_modes(x0 + 12, 124, 224, 11, 3, "BOOST", "FUZZ I", "FUZZ II");
    fg_k10(x0 + 70, 184, 21, 12, 6, 36, 0xD8692A, "GAIN"); fg_k10(x0 + 178, 184, 21, 15, 5, 35, 0, "LEVEL");
    fg_k10(x0 + 70, 252, 16, 13, 5, 36, 0x9A6238, "BASS"); fg_k10(x0 + 178, 252, 16, 14, 5, 36, 0xC0423B, "TREBLE");
  ) : i == 1 ? (
    fg_modes(x0 + 12, 124, 224, 21, 3, "BRASS", "TWIN", "UPPER");
    fg_k10(x0 + 70, 184, 21, 22, 6, 36, 0xD8692A, "FUZZ"); fg_k10(x0 + 178, 184, 21, 24, 5, 35, 0, "LEVEL");
    fg_k10(x0 + 124, 252, 16, 23, 5, 36, 0x3A78C0, "TONE");
  ) : i == 2 ? (
    fg_modes(x0 + 12, 124, 224, 33, 2, "GE", "SI", "");
    fg_k10(x0 + 70, 184, 21, 31, 7, 36, 0xD8692A, "FUZZ"); fg_k10(x0 + 178, 184, 21, 32, 5, 35, 0, "VOLUME");
    cx = x0 + 124; w = 150;
    gfx_setfont(13);
    slider33 < 0.5 ? (
      ui_col(0x120E18); fg_rr(cx - w * 0.5, 248, w, 8, 4);
      t = min(max(fza_T, -1), 1);
      ui_col(ui_mix(0x5AA0FF, 0xFF6A2A, 0.5 + 0.5 * t)); gfx_circle((cx + t * (w * 0.5 - 6)) * sc, 252 * sc, 5 * sc, 1, 1);
      ui_col(FG_DIM); fg_tr(cx - w * 0.5 - 6, 245, "COOL"); fg_tl(cx + w * 0.5 + 6, 245, "WARM");
      ui_col(FG_INK); fg_tc(cx, 266, "GE TEMPERATURE");
    ) : (
      ui_col(FG_DIM); fg_tc(cx, 252, "SILICON  ·  TEMPERATURE STABLE");
