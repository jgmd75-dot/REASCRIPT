  p == 10 ? ( fz_ro(1, 8, 4.9); slider3 = -66; slider8 = 65; ) :
  p == 11 ? ( fz_oc(0, 7, 6, 4.7); slider8 = 60; ) :
  p == 12 ? ( fz_oc(1, 6.5, 4, 4.9); slider8 = 60; ) :
  p == 13 ? ( slider4 = 50; slider5 = 0; slider6 = 0; slider7 = 0; slider8 = 50; slider9 = -0.3; slider46 = 75; slider47 = 1; slider48 = 0; );
  i = 1; loop(48, (i <= 9 || (i >= 11 && i <= 15) || (i >= 21 && i <= 24) || (i >= 31 && i <= 33) || (i >= 41 && i <= 48)) ? ui_auto(i); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

