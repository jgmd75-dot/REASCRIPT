desc:Fuzz4 [fuzz rack] (GFX)
//tags: fuzz distortion germanium silicon octave stompbox fuzz guitar rack
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui, gfx-panel, gfx-dyn, gfx-clip and gfx-os (.jsfx-inc) in the same folder.

slider1:0<0,3,1{Hyper,Model,Round,Octa}>-Module
slider2:10<0,10,0.1>-Input (guitar volume)
slider3:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider4:50<0,100,1>-Drift (%)
slider5:0<-24,12,0.1>-Output (dB)
slider6:0<-24,12,0.1>-Input trim (dB)
slider7:0<0,1,1{Off,On}>-Input guard
slider8:50<0,100,1>-Band sat (%)
slider9:-0.3<-24,0,0.1>-Ceiling (dB)

slider11:1<0,2,1{Boost,Fuzz I,Fuzz II}>-Hyper mode
slider12:6<0,10,0.1>-Hyper gain
slider13:5<0,10,0.1>-Hyper bass
slider14:5<0,10,0.1>-Hyper treble
slider15:5<0,10,0.1>-Hyper level

slider21:0<0,2,1{Brass,Twin,Upper}>-Model mode
slider22:6<0,10,0.1>-Model fuzz
slider23:5<0,10,0.1>-Model tone
slider24:5<0,10,0.1>-Model level

slider31:7<0,10,0.1>-Round fuzz
slider32:5<0,10,0.1>-Round volume
slider33:0<0,1,1{GE,SI}>-Round transistors

slider41:0<0,1,1{Octave,Thick}>-Octa voicing
slider42:6<0,10,0.1>-Octa fuzz
slider43:5<0,10,0.1>-Octa tone
slider44:5<0,10,0.1>-Octa level
slider45:3<0,10,0.1>-Octa hi-mid
slider46:75<0,100,1>-Tame (%)
slider47:1<0,1,1{Off,On}>-Tame on
slider48:0<0,1,1{Off,On}>-Width
slider49:prs_sel=0<0,12,1{No preset,Init,Hyper Wall,Singing Lead,Boosted Crunch,Brass Buzz,Modelled Round,Ring Upper,Germanium Round,Volume Clean-Up,Silicon Scream,Octave Lead,Thick Octave}>-Preset
slider50:2<0,2,1{1x,2x,4x}>-Oversampling

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-clip.jsfx-inc
import gfx-os.jsfx-inc

@init
#ui_man = "gfx-fuzz4";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 0;

function fz_op(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.49 * fs) / fs); );
function fz_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function fz_bqs(t, f, q, g, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, A, sa, n) (
  w0 = 2 * $pi * min(f, 0.45 * fs) / fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); A = 10 ^ (g / 40); sa = 2 * sqrt(A) * al;
  t == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  t == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  t == 5 ? ( n = 1 + al; b0 = al / n; b1 = 0; b2 = -al / n; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  t == 2 ? ( n = 1 + al / A; b0 = (1 + al * A) / n; b1 = -2 * cw / n; b2 = (1 - al * A) / n; a1 = b1; a2 = (1 - al / A) / n; ) :
  t == 3 ? (
    n = (A + 1) - (A - 1) * cw + sa;
    b0 = A * ((A + 1) + (A - 1) * cw + sa) / n; b1 = -2 * A * ((A - 1) + (A + 1) * cw) / n;
    b2 = A * ((A + 1) + (A - 1) * cw - sa) / n; a1 = 2 * ((A - 1) - (A + 1) * cw) / n; a2 = ((A + 1) - (A - 1) * cw - sa) / n;
  ) : (
    n = (A + 1) + (A - 1) * cw + sa;
    b0 = A * ((A + 1) - (A - 1) * cw + sa) / n; b1 = 2 * A * ((A - 1) - (A + 1) * cw) / n;
    b2 = A * ((A + 1) - (A - 1) * cw - sa) / n; a1 = -2 * ((A - 1) + (A + 1) * cw) / n; a2 = ((A + 1) + (A - 1) * cw - sa) / n;
  );
);
function fz_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function fz_bqc() instance(z1, z2) ( z1 = z2 = 0; );
function fz_bqt() instance(z1, z2) ( z1 = fz_tn(z1); z2 = fz_tn(z2); );
function fz_bqR(x) instance(b0, b1, b2, a1, a2, zr1, zr2) local(y) ( y = b0 * x + zr1; zr1 = b1 * x - a1 * y + zr2; zr2 = b2 * x - a2 * y; y; );
function fz_bqcR() instance(zr1, zr2) ( zr1 = zr2 = 0; );
function fz_bqtR() instance(zr1, zr2) ( zr1 = fz_tn(zr1); zr2 = fz_tn(zr2); );
function clpR_run(x) instance(x1, ad1, rx1, rad1, ty, cp, cn, cd, cw, rty, rcp, rcn, rcd, rcw) local(t1, t2, y) (
  ty != rty || cp != rcp || cn != rcn || cd != rcd || cw != rcw ? (
    rty = ty; rcp = cp; rcn = cn; rcd = cd; rcw = cw; rad1 = this.clp_ad(rx1);
  );
  t1 = x1; t2 = ad1; x1 = rx1; ad1 = rad1;
  y = this.clp_run(x);
  rx1 = x1; rad1 = ad1; x1 = t1; ad1 = t2;
  y;
);
function clpR_reset() instance(rx1, rad1) ( rx1 = rad1 = 0; );
function clpR_tidy() instance(rx1, rad1) ( abs(rx1) < 0.000000000001 ? ( rx1 = 0; rad1 = 0; ); );
function clpR_pf_run(x) instance(ic1, ic2, sx1, sy1, ric1, ric2, rsx1, rsy1) local(t1, t2, t3, t4, y) (
  t1 = ic1; t2 = ic2; t3 = sx1; t4 = sy1; ic1 = ric1; ic2 = ric2; sx1 = rsx1; sy1 = rsy1;
  y = this.clp_pf_run(x);
  ric1 = ic1; ric2 = ic2; rsx1 = sx1; rsy1 = sy1; ic1 = t1; ic2 = t2; sx1 = t3; sy1 = t4;
  y;
);
function clpR_pf_reset() instance(ric1, ric2, rsx1, rsy1) ( ric1 = ric2 = rsx1 = rsy1 = 0; );
function clpR_pf_tidy() instance(ric1, ric2, rsx1, rsy1) (
  ric1 = fz_tn(ric1); ric2 = fz_tn(ric2); rsx1 = fz_tn(rsx1); rsy1 = fz_tn(rsy1);
);

fz_h0 = 0.036681502164; fz_h1 = 0.136547624632; fz_h2 = 0.274631759379; fz_h3 = 0.423138617437;
fz_h4 = 0.561098697879; fz_h5 = 0.677540049974; fz_h6 = 0.769741833863; fz_h7 = 0.839889624850;
fz_h8 = 0.892260818004; fz_h9 = 0.931541959963; fz_h10 = 0.962094548378; fz_h11 = 0.987816370733;
function fz_up(x) local(t, y) (
  t = x;
  y = fz_h0 * (t - fz_ua0) + fz_ux0; fz_ux0 = t; fz_ua0 = y; t = y;
  y = fz_h2 * (t - fz_ua1) + fz_ux1; fz_ux1 = t; fz_ua1 = y; t = y;
  y = fz_h4 * (t - fz_ua2) + fz_ux2; fz_ux2 = t; fz_ua2 = y; t = y;
  y = fz_h6 * (t - fz_ua3) + fz_ux3; fz_ux3 = t; fz_ua3 = y; t = y;
  y = fz_h8 * (t - fz_ua4) + fz_ux4; fz_ux4 = t; fz_ua4 = y; t = y;
  y = fz_h10 * (t - fz_ua5) + fz_ux5; fz_ux5 = t; fz_ua5 = y; fz_o0 = y;
  t = x;
  y = fz_h1 * (t - fz_ub0) + fz_uy0; fz_uy0 = t; fz_ub0 = y; t = y;
  y = fz_h3 * (t - fz_ub1) + fz_uy1; fz_uy1 = t; fz_ub1 = y; t = y;
  y = fz_h5 * (t - fz_ub2) + fz_uy2; fz_uy2 = t; fz_ub2 = y; t = y;
  y = fz_h7 * (t - fz_ub3) + fz_uy3; fz_uy3 = t; fz_ub3 = y; t = y;
  y = fz_h9 * (t - fz_ub4) + fz_uy4; fz_uy4 = t; fz_ub4 = y; t = y;
  y = fz_h11 * (t - fz_ub5) + fz_uy5; fz_uy5 = t; fz_ub5 = y; fz_o1 = y;
);
function fz_dn(s0, s1) local(t, y, p) (
  t = s1;
  y = fz_h0 * (t - fz_da0) + fz_dx0; fz_dx0 = t; fz_da0 = y; t = y;
  y = fz_h2 * (t - fz_da1) + fz_dx1; fz_dx1 = t; fz_da1 = y; t = y;
  y = fz_h4 * (t - fz_da2) + fz_dx2; fz_dx2 = t; fz_da2 = y; t = y;
  y = fz_h6 * (t - fz_da3) + fz_dx3; fz_dx3 = t; fz_da3 = y; t = y;
  y = fz_h8 * (t - fz_da4) + fz_dx4; fz_dx4 = t; fz_da4 = y; t = y;
  y = fz_h10 * (t - fz_da5) + fz_dx5; fz_dx5 = t; fz_da5 = y; p = y;
  t = s0;
  y = fz_h1 * (t - fz_db0) + fz_dy0; fz_dy0 = t; fz_db0 = y; t = y;
  y = fz_h3 * (t - fz_db1) + fz_dy1; fz_dy1 = t; fz_db1 = y; t = y;
  y = fz_h5 * (t - fz_db2) + fz_dy2; fz_dy2 = t; fz_db2 = y; t = y;
  y = fz_h7 * (t - fz_db3) + fz_dy3; fz_dy3 = t; fz_db3 = y; t = y;
  y = fz_h9 * (t - fz_db4) + fz_dy4; fz_dy4 = t; fz_db4 = y; t = y;
  y = fz_h11 * (t - fz_db5) + fz_dy5; fz_dy5 = t; fz_db5 = y; y = y;
  0.5 * (p + y);
);
function fz_ostidy() (
  fz_ua0 = fz_tn(fz_ua0); fz_ua1 = fz_tn(fz_ua1); fz_ua2 = fz_tn(fz_ua2); fz_ua3 = fz_tn(fz_ua3); fz_ua4 = fz_tn(fz_ua4); fz_ua5 = fz_tn(fz_ua5); fz_ux0 = fz_tn(fz_ux0); fz_ux1 = fz_tn(fz_ux1);
  fz_ux2 = fz_tn(fz_ux2); fz_ux3 = fz_tn(fz_ux3); fz_ux4 = fz_tn(fz_ux4); fz_ux5 = fz_tn(fz_ux5); fz_ub0 = fz_tn(fz_ub0); fz_ub1 = fz_tn(fz_ub1); fz_ub2 = fz_tn(fz_ub2); fz_ub3 = fz_tn(fz_ub3);
  fz_ub4 = fz_tn(fz_ub4); fz_ub5 = fz_tn(fz_ub5); fz_uy0 = fz_tn(fz_uy0); fz_uy1 = fz_tn(fz_uy1); fz_uy2 = fz_tn(fz_uy2); fz_uy3 = fz_tn(fz_uy3); fz_uy4 = fz_tn(fz_uy4); fz_uy5 = fz_tn(fz_uy5);
  fz_da0 = fz_tn(fz_da0); fz_da1 = fz_tn(fz_da1); fz_da2 = fz_tn(fz_da2); fz_da3 = fz_tn(fz_da3); fz_da4 = fz_tn(fz_da4); fz_da5 = fz_tn(fz_da5); fz_dx0 = fz_tn(fz_dx0); fz_dx1 = fz_tn(fz_dx1);
  fz_dx2 = fz_tn(fz_dx2); fz_dx3 = fz_tn(fz_dx3); fz_dx4 = fz_tn(fz_dx4); fz_dx5 = fz_tn(fz_dx5); fz_db0 = fz_tn(fz_db0); fz_db1 = fz_tn(fz_db1); fz_db2 = fz_tn(fz_db2); fz_db3 = fz_tn(fz_db3);
  fz_db4 = fz_tn(fz_db4); fz_db5 = fz_tn(fz_db5); fz_dy0 = fz_tn(fz_dy0); fz_dy1 = fz_tn(fz_dy1); fz_dy2 = fz_tn(fz_dy2); fz_dy3 = fz_tn(fz_dy3); fz_dy4 = fz_tn(fz_dy4); fz_dy5 = fz_tn(fz_dy5);
);

function fz_c0(x) ( fz_k * fzA.clp_run(fz_GA * x * fz_ik); );
function fz_c1(x) local(y) (
  y = fz_k * (fzA.clp_run((fz_GA * x + fz_bA) * fz_ik) - fz_rA);
  fz_s1 += fz_kL1 * (y - fz_s1);
  fz_s2 += fz_kH1 * (fz_s1 - fz_s2);
  fz_k * (fzB.clp_run((fz_GB * (fz_s1 - fz_s2) + fz_bB) * fz_ik) - fz_rB);
);
function fz_c2(x) local(s, r) (
  s = fzA.clp_run(fz_GA * x);
  fz_s2 += fz_kL2 * (s - fz_s2);
  r = fzR.clp_run(fz_s2);
  fz_s3 += fz_kD * (r - fz_s3);
  fz_s1 += fz_kL1 * (fz_cr * (r - fz_s3) + fz_cs * s - fz_s1);
  fz_k * (fzB.clp_run((fz_GB * fz_s1 + fz_bB) * fz_ik) - fz_rB);
);
function fz_c3(x) local(bt, y) (
  bt = (fz_bA + fz_fbk * fz_fb) * fz_ik;
  y = fz_k * (fzA.clp_run((fz_GA * x) * fz_ik + bt) - fzA.clp_crv(bt));
  fz_s1 += fz_kL1 * (y - fz_s1);
  y = fz_k * (fzB.clp_run((fz_GB * fz_s1 + fz_bB) * fz_ik) - fz_rB);
  fz_fb += fz_kF * (y - fz_fb);
  y;
);
function fz_core(x) ( fz_tp == 1 ? fz_c1(x) : fz_tp == 3 ? fz_c3(x) : fz_tp == 2 ? fz_c2(x) : fz_c0(x); );
function fz_smo(y) local(lo, r, hi) (
  lo = fzSl.fz_bq(y); r = y - lo; hi = fzSh.fz_bq(r);
  fzSL.clp_run(lo) + (r - hi) + fzSH.clp_run(hi * fz_hk) * fz_hL;
);
function fz_cs(x) ( fz_smo(fz_core(x)); );
function fzq_up(x) local(t, y) (
  t = x;
  y = fz_h0 * (t - fzq_ua0) + fzq_ux0; fzq_ux0 = t; fzq_ua0 = y; t = y;
  y = fz_h2 * (t - fzq_ua1) + fzq_ux1; fzq_ux1 = t; fzq_ua1 = y; t = y;
  y = fz_h4 * (t - fzq_ua2) + fzq_ux2; fzq_ux2 = t; fzq_ua2 = y; t = y;
  y = fz_h6 * (t - fzq_ua3) + fzq_ux3; fzq_ux3 = t; fzq_ua3 = y; t = y;
  y = fz_h8 * (t - fzq_ua4) + fzq_ux4; fzq_ux4 = t; fzq_ua4 = y; t = y;
  y = fz_h10 * (t - fzq_ua5) + fzq_ux5; fzq_ux5 = t; fzq_ua5 = y; fzq_o0 = y;
  t = x;
  y = fz_h1 * (t - fzq_ub0) + fzq_uy0; fzq_uy0 = t; fzq_ub0 = y; t = y;
  y = fz_h3 * (t - fzq_ub1) + fzq_uy1; fzq_uy1 = t; fzq_ub1 = y; t = y;
  y = fz_h5 * (t - fzq_ub2) + fzq_uy2; fzq_uy2 = t; fzq_ub2 = y; t = y;
  y = fz_h7 * (t - fzq_ub3) + fzq_uy3; fzq_uy3 = t; fzq_ub3 = y; t = y;
  y = fz_h9 * (t - fzq_ub4) + fzq_uy4; fzq_uy4 = t; fzq_ub4 = y; t = y;
  y = fz_h11 * (t - fzq_ub5) + fzq_uy5; fzq_uy5 = t; fzq_ub5 = y; fzq_o1 = y;
);
function fzq_dn(s0, s1) local(t, y, p) (
  t = s1;
  y = fz_h0 * (t - fzq_da0) + fzq_dx0; fzq_dx0 = t; fzq_da0 = y; t = y;
  y = fz_h2 * (t - fzq_da1) + fzq_dx1; fzq_dx1 = t; fzq_da1 = y; t = y;
  y = fz_h4 * (t - fzq_da2) + fzq_dx2; fzq_dx2 = t; fzq_da2 = y; t = y;
  y = fz_h6 * (t - fzq_da3) + fzq_dx3; fzq_dx3 = t; fzq_da3 = y; t = y;
  y = fz_h8 * (t - fzq_da4) + fzq_dx4; fzq_dx4 = t; fzq_da4 = y; t = y;
  y = fz_h10 * (t - fzq_da5) + fzq_dx5; fzq_dx5 = t; fzq_da5 = y; p = y;
  t = s0;
  y = fz_h1 * (t - fzq_db0) + fzq_dy0; fzq_dy0 = t; fzq_db0 = y; t = y;
  y = fz_h3 * (t - fzq_db1) + fzq_dy1; fzq_dy1 = t; fzq_db1 = y; t = y;
  y = fz_h5 * (t - fzq_db2) + fzq_dy2; fzq_dy2 = t; fzq_db2 = y; t = y;
  y = fz_h7 * (t - fzq_db3) + fzq_dy3; fzq_dy3 = t; fzq_db3 = y; t = y;
  y = fz_h9 * (t - fzq_db4) + fzq_dy4; fzq_dy4 = t; fzq_db4 = y; t = y;
  y = fz_h11 * (t - fzq_db5) + fzq_dy5; fzq_dy5 = t; fzq_db5 = y; y = y;
  0.5 * (p + y);
);
function fz_osclr() (
  fz_ua0 = fz_ua1 = fz_ua2 = fz_ua3 = fz_ua4 = fz_ua5 = fz_ux0 = fz_ux1 = fz_ux2 = fz_ux3 = fz_ux4 = fz_ux5 = fz_ub0 = fz_ub1 = fz_ub2 = fz_ub3 = fz_ub4 = fz_ub5 = fz_uy0 = fz_uy1 = fz_uy2 = fz_uy3 = fz_uy4 = fz_uy5 = fz_da0 = fz_da1 = fz_da2 = fz_da3 = fz_da4 = fz_da5 = fz_dx0 = fz_dx1 = fz_dx2 = fz_dx3 = fz_dx4 = fz_dx5 = fz_db0 = fz_db1 = fz_db2 = fz_db3 = fz_db4 = fz_db5 = fz_dy0 = fz_dy1 = fz_dy2 = fz_dy3 = fz_dy4 = fz_dy5 = 0;
  fzq_ua0 = fzq_ua1 = fzq_ua2 = fzq_ua3 = fzq_ua4 = fzq_ua5 = fzq_ux0 = fzq_ux1 = fzq_ux2 = fzq_ux3 = fzq_ux4 = fzq_ux5 = fzq_ub0 = fzq_ub1 = fzq_ub2 = fzq_ub3 = fzq_ub4 = fzq_ub5 = fzq_uy0 = fzq_uy1 = fzq_uy2 = fzq_uy3 = fzq_uy4 = fzq_uy5 = fzq_da0 = fzq_da1 = fzq_da2 = fzq_da3 = fzq_da4 = fzq_da5 = fzq_dx0 = fzq_dx1 = fzq_dx2 = fzq_dx3 = fzq_dx4 = fzq_dx5 = fzq_db0 = fzq_db1 = fzq_db2 = fzq_db3 = fzq_db4 = fzq_db5 = fzq_dy0 = fzq_dy1 = fzq_dy2 = fzq_dy3 = fzq_dy4 = fzq_dy5 = 0;
);
function f2_up(x) instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5, o0, o1) local(t, y) (
  t = x;
  y = fz_h0 * (t - ua0) + ux0; ux0 = t; ua0 = y; t = y;
  y = fz_h2 * (t - ua1) + ux1; ux1 = t; ua1 = y; t = y;
  y = fz_h4 * (t - ua2) + ux2; ux2 = t; ua2 = y; t = y;
  y = fz_h6 * (t - ua3) + ux3; ux3 = t; ua3 = y; t = y;
  y = fz_h8 * (t - ua4) + ux4; ux4 = t; ua4 = y; t = y;
  y = fz_h10 * (t - ua5) + ux5; ux5 = t; ua5 = y; o0 = y;
  t = x;
  y = fz_h1 * (t - ub0) + uy0; uy0 = t; ub0 = y; t = y;
  y = fz_h3 * (t - ub1) + uy1; uy1 = t; ub1 = y; t = y;
  y = fz_h5 * (t - ub2) + uy2; uy2 = t; ub2 = y; t = y;
