function prs_hash() local(i, h) ( h = 0; i = 1; loop(50, i != 49 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != fz_sr ? fz_srinit();
in_setup(slider6, slider7 >= 0.5);
ost_setup(slider8 / 100, 0.3, 120, 6000, slider9, 1);
drift_macro(slider4);
fz_tout = 10 ^ (slider5 / 20);
fz_gthr = slider3 <= -79.5 ? 0 : 10 ^ (slider3 / 20);
fz_tg();
fz_Ft = slider50 >= 1.5 ? 4 : slider50 >= 0.5 ? 2 : 1;
fz_tm != fz_m || fz_tmd != fz_md || fz_Ft != fz_F ? fz_pend = 1;
