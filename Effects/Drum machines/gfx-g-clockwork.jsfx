pdef(30, 1, 10, "x.x.x.x.x.x.x.x.");
pdef(30, 2, 2, "........X.xxX.x."); pdef(30, 2, 8, "........x.xXx.XX"); pdef(30, 2, 6, ".........x.x.xx.");
pmeta(31, 16, 0.25, "Cumbia");
pdef(31, 0, 11, "X.xxX.xxX.xxX.xx");
pdef(31, 0, 10, "x.x.x.x.x.x.x.x.");
pdef(31, 0, 8, "..X...X...X...X.");
