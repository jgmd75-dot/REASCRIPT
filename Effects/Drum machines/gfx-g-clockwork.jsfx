pdef(23, 2, 12, "........x.X.x.X."); pdef(23, 2, 6, "........x.xx.xx."); pdef(23, 2, 7, "........X.....XX");
pmeta(24, 16, 0.25, "Reggae Perc");
pdef(24, 0, 2, "........X.......");
pdef(24, 0, 10, "x.x.x.x.x.x.x.x.");
pdef(24, 0, 7, "..........x..x..");
pdef(24, 0, 6, "..x...x...x...x.");
pdef(24, 1, 12, "....X.......X...");
pdef(24, 1, 9, "...x......x.....");
pdef(24, 2, 10, "........x.x.x.x."); pdef(24, 2, 2, "........X......."); pdef(24, 2, 7, "...........xx.XX");
pmeta(25, 16, 0.25, "Merengue");
pdef(25, 0, 11, "X.xxX.xxX.xxX.xx");
pdef(25, 0, 8, "X..x..x.X..x.xxX");
pdef(25, 0, 13, "X...X...X...X...");
pdef(25, 1, 6, "..x...x...x...x.");
pdef(25, 1, 10, "xxxxxxxxxxxxxxxx");
pdef(25, 2, 11, "........X.xxX.xx"); pdef(25, 2, 8, "........XxxXxxXX"); pdef(25, 2, 7, "...........x..x.");
pmeta(26, 16, 0.25, "Baiao");
pdef(26, 0, 14, "x.xXx.xXx.xXx.xX");
pdef(26, 0, 8, "X..x....X..x....");
pdef(26, 0, 7, "....x.......x...");
pdef(26, 1, 10, "xxxxxxxxxxxxxxxx");
pdef(26, 1, 6, "......x.......x.");
pdef(26, 2, 14, "........x.xXx.xX"); pdef(26, 2, 8, "........X..x.xXX"); pdef(26, 2, 6, "..........x.x...");
pmeta(27, 16, 0.25, "Shaker Pop");
pdef(27, 0, 10, "xxXxxxXxxxXxxxXx");
pdef(27, 0, 12, "....X.......X...");
pdef(27, 0, 8, "X......xX.x....x");
pdef(27, 1, 6, "..x...x...x.x.x.");
pdef(27, 1, 9, "......x.......x.");
pdef(27, 2, 10, "........xxXxxxXx"); pdef(27, 2, 12, "............X..."); pdef(27, 2, 8, "........X.x.xxXX");
pmeta(28, 16, 0.25, "Tamb Soul");
pdef(28, 0, 12, "x.x.X.x.x.x.X.x.");
pdef(28, 0, 9, "......x.......x.");
pdef(28, 0, 8, "X......xX.x.....");
pdef(28, 1, 10, "xxxxxxxxxxxxxxxx");
