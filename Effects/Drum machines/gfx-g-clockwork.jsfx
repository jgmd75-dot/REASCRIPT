slider47:100<25,400,1>-Cowbell decay (%)
slider48:55<0,100,1>-Cowbell level (%)
slider49:0<-12,12,0.1>-Metal beat tune (st)
slider50:100<25,400,1>-Metal beat decay (%)
slider51:50<0,100,1>-Metal beat level (%)
slider52:30<0,100,1>-Hit variation (%)
slider53:0<0,20,0.1>-Timing variation (ms)
slider54:0<0,16,1>-MIDI channel (0 = omni)
slider55:60<0,100,1>-Stereo spread (%)
slider56:0<-24,12,0.1>-Output (dB)
slider57:0<0,100,1>-Band sat (%)
slider58:30<0,100,1>-Bias (%)
slider59:120<40,400,1>-Sat low band (Hz)
slider60:6000<2000,16000,10>-Sat high band (Hz)
slider61:-0.3<-24,0,0.1>-Ceiling (dB)
slider62:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider63:25<0,100,1>-Drift (%)
slider64:20<20,500,1>-Mono below (Hz, 20 = off)
slider65:0<0,100,1>-Stereo width (%)
slider66:0<0,1,1{Off,On}>-Phaser
slider67:0.3<0.05,8,0.01>-Phaser rate (Hz)
slider68:70<0,100,1>-Phaser depth (%)
slider69:50<0,95,1>-Phaser feedback (%)
slider70:100<0,100,1>-Phaser mix (%)
slider71:90<0,180,1>-Phaser stereo (deg)
slider72:prs_sel=0<0,10,1{No preset,Classic,Tight and Dry,Deep and Boomy,Bright,Long Tails,Disco,Latin,Lo-Fi,Electro,Brushes}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-clockwork";                                  // the ? pop-up links to this manual

NVO = 15;
// ---------- memory map ----------
vt = 0;  vd = 20;  vl = 40;  vp = 60;     // per-voice tune ratio, decay mult, level, pan
lt = 80;                                  // per-voice trigger light
pend = 100; pvel = 120;                   // per-voice pending (delayed) hit
nmap = 200;                               // MIDI note -> voice (128)
evq = 400;                                // MIDI event queue (4 x 512)
pn = 2500; psb = 2550;                    // pattern step count, step length (beats)
PAT = 3000;                               // patterns: ((p * 3 + layer) * 15 + v) * 16 + step
memset(0, 0, 3000); memset(PAT, 0, 32 * 3 * 15 * 16);
i = 0; loop(128, nmap[i] = -1; i += 1; );
nmap[35] = 0; nmap[36] = 0; nmap[38] = 1; nmap[40] = 1; nmap[37] = 2; nmap[42] = 3; nmap[44] = 3; nmap[46] = 4;
nmap[49] = 5; nmap[51] = 5; nmap[52] = 5; nmap[55] = 5; nmap[57] = 5; nmap[59] = 5;
nmap[60] = 6; nmap[61] = 7; nmap[62] = 8; nmap[63] = 8; nmap[64] = 8; nmap[75] = 9; nmap[70] = 10;
nmap[73] = 11; nmap[74] = 11; nmap[54] = 12; nmap[56] = 13; nmap[80] = 14; nmap[81] = 14;
vp[0] = 0; vp[1] = 0; vp[2] = -0.2; vp[3] = 0.3; vp[4] = 0.3; vp[5] = -0.3; vp[6] = 0.45; vp[7] = -0.45;
vp[8] = -0.3; vp[9] = 0.25; vp[10] = 0.5; vp[11] = -0.5; vp[12] = 0.4; vp[13] = -0.2; vp[14] = 0.2;

// ---------- rhythm patterns ----------
function pmeta(p, n, sb, name) ( pn[p] = n; psb[p] = sb; strcpy(100 + p, name); );
function pdef(p, layer, v, str) local(i, c) (
  i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    PAT[((p * 3 + layer) * 15 + v) * 16 + i] = c == 'X' ? 2 : c == 'x' ? 1 : 0;
    i += 1;
  );
);
pmeta(0, 16, 0.25, "Rock 1");
pdef(0, 0, 0, "X.......X.x.....");
pdef(0, 0, 1, "....X.......X...");
pdef(0, 0, 3, "x.x.x.x.x.x.x.x.");
pdef(0, 1, 4, "..............x.");
pdef(0, 1, 5, "X...............");
pdef(0, 2, 0, "X.......x......."); pdef(0, 2, 1, "........x.xx.xXX");
pmeta(1, 16, 0.25, "Rock 2");
pdef(1, 0, 0, "X.....x.X.x.....");
pdef(1, 0, 1, "....X.......X..x");
pdef(1, 0, 3, "XxxxXxxxXxxxXxxx");
pdef(1, 1, 12, "....x.......x...");
pdef(1, 1, 4, "......x.......x.");
pdef(1, 2, 0, "X.......x......."); pdef(1, 2, 1, "........x.xx.xXX");
