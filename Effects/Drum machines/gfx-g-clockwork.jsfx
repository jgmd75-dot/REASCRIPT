slider29:100<25,400,1>-Bongo low decay (%)
slider30:65<0,100,1>-Bongo low level (%)
slider31:0<-12,12,0.1>-Conga tune (st)
slider32:100<25,400,1>-Conga decay (%)
slider33:65<0,100,1>-Conga level (%)
slider34:0<-12,12,0.1>-Clave tune (st)
slider35:100<25,400,1>-Clave decay (%)
slider36:55<0,100,1>-Clave level (%)
slider37:0<-12,12,0.1>-Maracas tune (st)
slider38:100<25,400,1>-Maracas decay (%)
slider39:55<0,100,1>-Maracas level (%)
slider40:0<-12,12,0.1>-Guiro tune (st)
slider41:100<25,400,1>-Guiro decay (%)
slider42:50<0,100,1>-Guiro level (%)
slider43:0<-12,12,0.1>-Tambourine tune (st)
slider44:100<25,400,1>-Tambourine decay (%)
