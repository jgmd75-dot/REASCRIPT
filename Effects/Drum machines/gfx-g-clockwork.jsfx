// ---------- the rhythm memories ----------
// a memory holds one rhythm laid out as the bank does (3 layers x 15 voices x 16 steps), its length and grid.
// A new instance starts with the first 15 bank rhythms in memories 1 - 15 (16 empty), as the RS machines do.
function slot_fill(s, b) (
  memcpy(SLOT + s * 720, PAT + b * 720, 720);
  SLN[s] = pn[b]; SSB[s] = psb[b] > 0.3; SRC[s] = b; EDT[s] = 0;
);
!seq_ok ? (
  i = 0; loop(15, slot_fill(i, i); i += 1; );
  memset(SLOT + 15 * 720, 0, 720); SLN[15] = 16; SSB[15] = 0; SRC[15] = -1; EDT[15] = 0;
  seq_ok = 1;
);
// a step's value (0 off, 1 hit, 2 accent) in memory s: FILL replaces the bar's second half; VAR B adds its part
function cell(s, fl, v, st) local(b, x) (
  b = SLOT + s * 720 + v * 16 + st;
  fl ? b[480] : ( x = b[0]; varb_on ? max(x, b[240]) : x );
);
// does memory s have a fill? (an empty FILL layer plays the bar as it is)
function has_fill(s) local(b, n) ( b = SLOT + s * 720 + 480; n = 0; loop(240, b[0] > 0 ? n = 1; b += 1; ); n; );

// ---------- voice defaults (the EDIT page) ----------
// tune st, decay %, attack ms, env decay ms (4000 = natural), sustain %, release ms (5000 = natural), ECHO / SPRING send %
function vp_def(v) local(p) ( p = VPAR + v * 8; p[0] = 0; p[1] = 100; p[2] = 0; p[3] = 4000; p[4] = 100; p[5] = 5000; p[6] = 0; p[7] = 0; );
function env_def(v) local(p) ( p = VPAR + v * 8; p[2] = 0; p[3] = 4000; p[4] = 100; p[5] = 5000; );
!vp_ok ? ( v = 0; loop(NVO, vp_def(v); v += 1; ); vp_ok = 1; );
i = 0; loop(NVO, ENVV[i] = 1; ENVS[i * 8] = 0; i += 1; );

// the amp envelope: ATTACK rises from silence, DECAY falls to SUSTAIN, which holds for the gate, then RELEASE
function env_trig(k, gate) local(e, p, a, d, s, r) (
  e = ENVS + k * 8; p = VPAR + k * 8; a = p[2]; d = p[3]; s = p[4] / 100; r = p[5];
  e[7] = a > 0.5 || s < 0.995 || r < 4990;
  e[7] ? (
    e[0] = a > 0.5 ? 1 : 2; e[1] = a > 0.5 ? 0 : 1; e[2] = gate; e[3] = 1 / max(1, a * 0.001 * srate);
    e[4] = exp(-6.9 / (max(d, 1) * 0.001 * srate)); e[5] = s; e[6] = r >= 4990 ? 1 : exp(-6.9 / (max(r, 1) * 0.001 * srate));
  ) : ( e[0] = 0; ENVV[k] = 1; );
);
function env_rel(k) local(e) ( e = ENVS + k * 8; e[0] > 0 && e[0] < 3 ? e[2] = 0; );
function env_tick(k) local(e, v) (
  e = ENVS + k * 8;
  e[0] == 0 ? 1 : (
    v = e[1];
    e[0] == 1 ? ( v += e[3]; v >= 1 ? ( v = 1; e[0] = 2; ); ) : e[0] == 2 ? ( v = e[5] + (v - e[5]) * e[4]; ) : ( v *= e[6]; );
    e[0] < 3 ? ( e[2] -= 1; e[2] <= 0 ? e[0] = 3; );
    e[1] = v; v;
  );
);
// ---------- building blocks ----------
function tcoef(t) ( exp(-1 / (max(t, 0.0003) * srate)) );
function f_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(fc, srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function f_run(x) instance(g, k, a1, a2, a3, ic1, ic2, bp, lp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  bp = v1; lp = v2; hp = x - k * v1 - v2;
  bp;
);
// decaying sine with a pitch drop (bridged-T style "ping")
function tone_trig(vel, f, drop, dt) instance(ph, env, pe, f0, ed, pd, dr) (
  ph = 0; env = vel; pe = 1; f0 = f; dr = drop; ed = tcoef(dt); pd = tcoef(0.012);
);
function tone_run() instance(ph, env, pe, f0, ed, pd, dr) local(y) (
  env > 0.00005 ? (
    ph += f0 * (1 + dr * pe) / srate; ph >= 1 ? ph -= 1;
    pe *= pd; y = sin(2 * $pi * ph) * env; env *= ed; y;
  ) : 0;
);
// simple envelope
function env_trig(vel, dt) instance(env, ed) ( env = vel; ed = tcoef(dt); );
function env_run() instance(env, ed) local(y) ( y = env; env *= ed; y );
function sq(ph) ( ph - floor(ph) < 0.5 ? 1 : -1 );

// tambourine: six jingle resonances (pairs a few Hz apart, so they shimmer), struck by a quick cluster of
// collisions; TAM holds each resonator's coefficients and state (7 fields x 6)
TAM = 30000; memset(TAM, 0, 64);
function tam_trig(l, t, d) local(k, f, a, tau, r) (
  k = 0;
  loop(6,
    f = (k == 0 ? 5150 : k == 1 ? 5235 : k == 2 ? 6880 : k == 3 ? 7015 : k == 4 ? 8640 : 11250) * t;
    a = k == 0 ? 1 : k == 1 ? 0.8 : k == 2 ? 0.9 : k == 3 ? 0.65 : k == 4 ? 0.7 : 0.4;
    tau = (0.16 - 0.015 * k) * d;
    r = f < srate * 0.45 ? exp(-1 / (tau * srate)) : 0;
    TAM[k * 7] = 2 * r * cos(2 * $pi * min(f, srate * 0.45) / srate); TAM[k * 7 + 1] = r * r;
    TAM[k * 7 + 2] = a * (1 - r); TAM[k * 7 + 3] = 0; TAM[k * 7 + 4] = 0;
    k += 1;
  );
  ta_l = l; ta_t = 0; ta_on = 1; ta_env = 1; ta_ec = tcoef(0.5 * d);
);
// the shake: collisions at 0, 8, 19 and 33 ms, each a 3 ms grain of noise
function tam_run(nz) local(g, ts, k, y, x, w) (
  ts = ta_t / srate;
  g = ts < 0.003 ? 1 : (ts >= 0.008 && ts < 0.011) ? 0.7 : (ts >= 0.019 && ts < 0.022) ? 0.5 : (ts >= 0.033 && ts < 0.036) ? 0.3 : 0;
  x = nz * g * ta_l;
  y = 0; k = 0;
  loop(6,
    w = TAM[k * 7] * TAM[k * 7 + 3] - TAM[k * 7 + 1] * TAM[k * 7 + 4] + TAM[k * 7 + 2] * x;
    TAM[k * 7 + 4] = TAM[k * 7 + 3]; TAM[k * 7 + 3] = w;
    y += w; k += 1;
  );
  ta_t += 1; ta_env *= ta_ec;
  taF.f_run(x);                                   // a little bright sizzle on each collision
  ta_t > srate * 2 || (ta_t > srate * 0.05 && ta_env < 0.0005) ? ta_on = 0;
  (y * 61 + taF.hp * 2.4) * ta_env;
);

// phaser: six first-order allpass stages swept by a sine LFO, with feedback around the chain;
// the right channel's LFO runs STEREO degrees ahead
function ph_coef(f) local(t) ( t = tan($pi * min(f, srate * 0.42) / srate); (t - 1) / (t + 1) );
function ph_run(x, a) instance(z1, z2, z3, z4, z5, z6, lst) local(y, u) (
  u = x + ph_fb * lst;
  y = a * u + z1; z1 = u - a * y; u = y;
  y = a * u + z2; z2 = u - a * y; u = y;
  y = a * u + z3; z3 = u - a * y; u = y;
  y = a * u + z4; z4 = u - a * y; u = y;
  y = a * u + z5; z5 = u - a * y; u = y;
  y = a * u + z6; z6 = u - a * y;
  lst = y;
  x + ph_mx * (y - x) * 0.5;
);
// the swept frequency for an LFO phase (0..1)
function ph_freq(lp) ( 160 * 2 ^ (ph_dep * 6.2 * (0.5 + 0.5 * sin(2 * $pi * lp))) );


// ---------- trigger one voice ----------
function trig(v, vel, gate) local(t, d, l, hv, nc, mtn, sg) (
  hv = hitvar;
  sg = min(sag, 1);                                       // DRIFT: the supply sags under busy, accented playing
  t = vt[v] * (1 + hv * 0.03 * (rand(2) - 1)) * ins_pitch * ins_note_detune() * 2 ^ (-sag_ct * sg / 1200);
  d = vd[v] * (1 + hv * 0.15 * (rand(2) - 1)) * (1 + 0.2 * ins_fx);
  nc = 2 ^ ins_cut; mtn = 2 ^ ins_tone;                  // drift: noise brightness, metal tone
  l = vel * vl[v] * (1 + hv * 0.15 * (rand(2) - 1)) * (1 - sag_lv * sg);
  sag += vel * vl[v] * 0.09;
  lt[v] = 1;
  env_trig(v, gate);
  v == 0 ? ( kT.tone_trig(l * 1.2, 56 * t, 0.7, 0.2 * d); ) :
  v == 1 ? ( snT1.tone_trig(l * 0.55, 180 * t, 0.1, 0.05 * d); snT2.tone_trig(l * 0.35, 330 * t, 0.05, 0.04 * d);
             snN.env_trig(l * 0.7, 0.12 * d); snF.f_set(4200 * t * nc, 0.6); ) :
  v == 2 ? ( rmT1.tone_trig(l * 0.7, 1700 * t, 0.05, 0.01 * d); rmT2.tone_trig(l * 0.5, 460 * t, 0.1, 0.008 * d); ) :
  v == 3 ? ( hcE.env_trig(l * 1.4, 0.035 * d); hcF.f_set(9000 * t * nc, 0.8); hoE.env = 0; ) :       // closed hat chokes the open one
  v == 4 ? ( hoE.env_trig(l * 1.4, 0.28 * d); hoF.f_set(8500 * t * nc, 0.8); ) :
  v == 5 ? ( cyE.env_trig(l, 0.9 * d); cyF.f_set(7000 * t * mtn, 0.7); cy_t = t; ) :
  v == 6 ? ( bhT.tone_trig(l, 420 * t, 0.15, 0.07 * d); ) :
  v == 7 ? ( blT.tone_trig(l, 300 * t, 0.15, 0.09 * d); ) :
  v == 8 ? ( cgT.tone_trig(l, 200 * t, 0.1, 0.16 * d); ) :
  v == 9 ? ( clT.tone_trig(l * 0.8, 2500 * t, 0, 0.025 * d); ) :
  v == 10 ? ( maE.env_trig(l, 0.03 * d); maF.f_set(6500 * t * nc, 0.7); ma_a = 0; ) :
  v == 11 ? ( guE.env_trig(l, 0.006); guF.f_set(2800 * t, 3); gu_len = 0.1 * d * srate; gu_n = gu_len; gu_t = t; gu_ph = 0; ) :
  v == 12 ? ( tam_trig(l, t * nc, d); taF.f_set(9000 * t * nc, 0.7); ) :
  v == 13 ? ( cbE1.env_trig(l * 0.6, 0.015); cbE2.env_trig(l * 0.4, 0.25 * d); cbF.f_set(700 * t * mtn, 2.5); cb_t = t; ) :
  v == 14 ? ( mbE.env_trig(l, 0.07 * d); mbF.f_set(2500 * t * mtn, 0.7); mb_t = t; );
);
// a hit from the rhythm, optionally loosened in time
function hit(v, vel, gate) (
  timevar > 0 ? ( pend[v] = 1 + floor(rand(1) * timevar * 0.001 * srate); pvel[v] = vel; pgat[v] = gate; ) : trig(v, vel, gate);
);
// a step of one player: plays the voices whose value is set (k = the player: 0 A, 1 B; s = its memory)
function step_vel(x) ( x == 2 ? 1 : 1 - acc * 0.45 );

function update() local(v, p) (
  fill_n = fill == 1 ? 2 : fill == 2 ? 4 : fill == 3 ? 8 : 0;
  varb_on = var_b >= 0.5;
  acc = accent / 100;
  v = 0;
  loop(NVO,
    p = VPAR + v * 8;
    vt[v] = 2 ^ (p[0] / 12); vd[v] = p[1] / 100; vl[v] = sqr(slider(LVL + v) / 100);
    v += 1;
  );
  hitvar = hits / 100; timevar = timing;
  width = spread / 100;
  out_t = 10 ^ (out_db / 20);
  dm = drift / 50;                                     // 1 at the standard 50 %
  ins_output_setup(27); ins_stereo_setup(33);          // output stage: CLIP, always on
  ph_rate_v = ph_rate; ph_dep = ph_depth / 100; ph_fb = ph_fbk / 100 * 0.8;
  ph_mix_t = ph_on >= 0.5 ? ph_mixp / 100 : 0; ph_off = ph_ster / 360;
  sag_ct = 10 * dm; sag_lv = 0.045 * dm;               // supply sag at its deepest: -10 cents, -0.4 dB
  ec_fb = 0.98 * ec_fbk / 100;                         // ECHO
  ec_lc = 1 - exp(-2 * $pi * min(1200 * 2 ^ (ec_tone / 100 * 3.5), srate * 0.4) / srate);
  ec_hc = 1 - exp(-2 * $pi * (130 - ec_tone * 0.6) / srate);
  ec_wd = ec_wow / 100;
  ec_rt = ec_on >= 0.5 ? sqr(ec_ret / 100) * 1.8 : 0;
  sp_fb = 0.55 + 0.42 * sp_dec / 100;                   // SPRING
  sp_lc = 1 - exp(-2 * $pi * 1800 * 2 ^ (sp_tone / 100 * 2.2) / srate);
  spHL.f_set(sp_hpf, 0.707); spHR.f_set(sp_hpf, 0.707); spLL.f_set(sp_lpf, 0.707); spLR.f_set(sp_lpf, 0.707);
  sp_rt = sp_on >= 0.5 ? sqr(sp_ret / 100) * 3.6 : 0;
);

// ---------- presets: Init and the kits (audio side) ----------
lvdef = 2600;
function setlv(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14) (
  lvdef[0] = a0; lvdef[1] = a1; lvdef[2] = a2; lvdef[3] = a3; lvdef[4] = a4; lvdef[5] = a5; lvdef[6] = a6;
  lvdef[7] = a7; lvdef[8] = a8; lvdef[9] = a9; lvdef[10] = a10; lvdef[11] = a11; lvdef[12] = a12; lvdef[13] = a13; lvdef[14] = a14;
);
setlv(90, 75, 60, 60, 55, 50, 65, 65, 65, 55, 55, 50, 55, 55, 50);
// a kit also sets the ECHO and SPRING back to their starting point, every send at 0 (dry)
function kit(tn, dc, ktn, kdc) local(v, p) (
  v = 0; loop(NVO, p = VPAR + v * 8; p[0] = tn; p[1] = dc; p[6] = 0; p[7] = 0; env_def(v); slider(LVL + v) = lvdef[v]; v += 1; );
  VPAR[0] = ktn; VPAR[1] = kdc;
  ec_on = 1; ec_time = 5; ec_fbk = 40; ec_tone = 50; ec_wow = 30; ec_ret = 60;
  sp_on = 1; sp_dec = 50; sp_tone = 50; sp_hpf = 220; sp_lpf = 5500; sp_ret = 60;
);
function snds(v, e, sp) local(p) ( p = VPAR + v * 8; p[6] = e; p[7] = sp; );
function lvs(v, l) ( slider(LVL + v) = l; );
function snd(v, tn, dc) local(p) ( p = VPAR + v * 8; p[0] = tn; p[1] = dc; );
function load_preset(k) local(i, v) (
  k == 1 ? (                               // Init: every control back to the start (the rhythm memories are kept)
    slot_a = 0; follow = 0; var_b = 0; fill = 0; swing = 0; accent = 50;
    hits = 30; timing = 0; chan = 0; spread = 60; out_db = 0;
    slider(27) = 0; slider(28) = 30; slider(29) = 120; slider(30) = 6000; slider(31) = -0.3;
    drift = 50; slider(33) = 20; slider(34) = 0;
    ph_on = 0; ph_rate = 0.3; ph_depth = 70; ph_fbk = 50; ph_mixp = 100; ph_ster = 90;
    kit(0, 100, 0, 100);
  );
  k == 2 ? kit(0, 100, 0, 100);                                                                   // Classic
  k == 3 ? kit(0, 55, 0, 70);                                                                     // Tight and Dry
  k == 4 ? kit(-3, 140, -4, 200);                                                                 // Deep and Boomy
  k == 5 ? kit(3, 90, 2, 90);                                                                     // Bright
  k == 6 ? kit(0, 220, 0, 160);                                                                   // Long Tails
  k == 7 ? ( kit(1, 80, -2, 130); lvs(0, 95); lvs(3, 72); lvs(4, 66); lvs(12, 62); );            // Disco
  k == 8 ? ( kit(0, 110, 0, 90); lvs(0, 70); lvs(1, 55); lvs(6, 78); lvs(7, 78); lvs(8, 80);     // Latin
             lvs(9, 70); lvs(10, 66); lvs(11, 62); lvs(13, 66); );
  k == 9 ? ( kit(-2, 75, -3, 90); lvs(3, 50); lvs(4, 45); lvs(5, 38); );                         // Lo-Fi
  k == 10 ? ( kit(-1, 60, -5, 260); lvs(0, 100); lvs(1, 80); snd(1, -1, 70); );                  // Electro
  k == 11 ? ( kit(0, 130, 0, 80); snd(1, -2, 200); lvs(0, 70); lvs(1, 55); lvs(3, 45);           // Brushes
              lvs(4, 40); lvs(5, 45); );
  // the ECHO and SPRING kits
  k == 12 ? ( kit(0, 90, 0, 110);                                                                 // Dub Rim: the rim and clave echo
              snds(2, 70, 15); snds(9, 55, 0); snds(1, 20, 30); snds(13, 30, 0);
              ec_time = 5; ec_fbk = 62; ec_tone = 35; ec_wow = 45; ec_ret = 60; sp_dec = 55; sp_ret = 45; );
  k == 13 ? ( kit(0, 100, 0, 100); lvs(1, 80);                                                    // Spring Snare
              snds(1, 0, 80); snds(2, 0, 50); snds(6, 0, 30); snds(7, 0, 30); snds(8, 0, 30); snds(3, 0, 12); snds(4, 0, 15);
              ec_on = 0; sp_dec = 72; sp_tone = 60; sp_hpf = 330; sp_lpf = 6600; sp_ret = 70; );
  k == 14 ? ( kit(1, 75, 0, 80);                                                                  // Tape Slap: a short slap on snare and hats
              snds(1, 45, 15); snds(3, 40, 0); snds(4, 30, 0); snds(2, 30, 0);
              ec_time = 0; ec_fbk = 15; ec_tone = 60; ec_wow = 20; ec_ret = 65; sp_dec = 40; sp_ret = 40; );
  k == 15 ? ( kit(0, 110, 0, 90); lvs(0, 70); lvs(1, 55); lvs(6, 78); lvs(7, 78); lvs(8, 80);    // Echo Percussion
              lvs(9, 70); lvs(10, 66); lvs(11, 62); lvs(13, 66);
              snds(6, 45, 25); snds(7, 40, 25); snds(8, 35, 30); snds(9, 60, 20); snds(13, 50, 15); snds(10, 25, 20); snds(11, 30, 25);
              ec_time = 4; ec_fbk = 50; ec_tone = 45; ec_wow = 35; ec_ret = 60; sp_dec = 50; sp_ret = 50; );
  k == 16 ? ( kit(-1, 100, -1, 110);                                                              // Surf Room: springs on all but the kick
              snds(1, 20, 55); snds(2, 0, 45); snds(3, 0, 25); snds(4, 0, 30); snds(5, 0, 30);
              v = 6; loop(9, snds(v, 0, 35); v += 1; );
              ec_time = 6; ec_fbk = 25; ec_tone = 40; ec_wow = 30; ec_ret = 50;
              sp_dec = 62; sp_tone = 45; sp_hpf = 220; sp_lpf = 4400; sp_ret = 65; );
  i = 1; loop(52, slider_automate(2 ^ (i - 1)); i += 1; );
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset
// bar asks through prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling
// its state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 16 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

// ---------- ECHO: a tape echo on its own send ----------
// Two lines (left / right). TIME is a note value at the project tempo; a new TIME (or tempo) moves to a second playback
// head and crossfades to it over 80 ms, so it never clicks or slides. WOW (a slow wander and a faster flutter, the
// right side a quarter-turn apart) and DRIFT (the tape speed) bend the heads. TONE darkens or brightens every repeat;
// each pass is recorded through a soft tape saturation, so high FEEDBACK thickens rather than runs away.
function ec_beats(k) ( k == 0 ? 0.25 : k == 1 ? 1 / 3 : k == 2 ? 0.375 : k == 3 ? 0.5 : k == 4 ? 2 / 3 : k == 5 ? 0.75 :
                       k == 6 ? 1 : k == 7 ? 4 / 3 : k == 8 ? 1.5 : 2; );
function ec_rd(b, d) local(p, i, f, y0, y1, y2, y3) (
  p = ec_w - 1 - d; p < 0 ? p += EC_N;
  i = floor(p); f = p - i;
  y0 = b[i > 0 ? i - 1 : EC_N - 1]; y1 = b[i];
  i += 1; i >= EC_N ? i = 0; y2 = b[i];
  i += 1; i >= EC_N ? i = 0; y3 = b[i];
  ((((0.5 * (y3 - y0) + 1.5 * (y1 - y2)) * f + (y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3)) * f + 0.5 * (y2 - y0)) * f + y1);
);
function ec_sat(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
// one side: the head(s) at the modulated time, TONE, the record path; returns the repeat
function ec_side(b, x, m) instance(lp, hp) local(y) (
  y = ec_rd(b, ec_dc * m);
  ec_xr ? y = y * cos(ec_xp * 0.5 * $pi) + ec_rd(b, ec_dn * m) * sin(ec_xp * 0.5 * $pi);
  lp += (y - lp) * ec_lc; hp += (lp - hp) * ec_hc; y = lp - hp;
  b[ec_w] = ec_sat(x + y * ec_fb);
  y;
);
function ec_clr() ( memset(EC_L, 0, EC_N); memset(EC_R, 0, EC_N); ecL.lp = ecL.hp = ecR.lp = ecR.hp = 0; );

// ---------- SPRING: a spring reverb on its own send ----------
// Two tanks of two springs each (the right tank a little longer), the house tank's chirpy dispersion (allpasses scaled
// to the rate), DECAY = how much each pass feeds back, TONE = the damping in the loop. The send is band-limited by its
// own HPF and LPF first, so a kick can feed it without booming.
function sp_apc(d) ( (d - 1) / (d + 1); );
function sp_ap(x, a) instance(z) local(y) ( y = -a * x + z; z = x + a * y; y; );
function sp_init(mem, k) instance(b1, b2, n1, n2, w1, w2, lp1, lp2) (
  b1 = mem; n1 = floor(0.0371 * k * srate); b2 = mem + n1 + 8; n2 = floor(0.0433 * k * srate);
  memset(mem, 0, n1 + n2 + 16); w1 = 0; w2 = 0; lp1 = 0; lp2 = 0;
);
function sp_run(x) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) local(y, s1, s2) (
  y = d6.sp_ap(d5.sp_ap(d4.sp_ap(d3.sp_ap(d2.sp_ap(d1.sp_ap(x, sp_sa), sp_sa), sp_sa), sp_sa), sp_sa), sp_sa);   // the chirp
  s1 = b1[w1]; s2 = b2[w2];
  lp1 += (s1 - lp1) * sp_lc; lp2 += (s2 - lp2) * sp_lc;
  b1[w1] = y + e1.sp_ap(e2.sp_ap(lp2 * sp_fb, sp_se), sp_se);
  b2[w2] = y + e3.sp_ap(e4.sp_ap(lp1 * sp_fb, sp_se), sp_se);
  w1 += 1; w1 >= n1 ? w1 = 0; w2 += 1; w2 >= n2 ? w2 = 0;
  (s1 + s2) * 0.5;
);
function sp_clr() instance(b1, n1, n2, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4, lp1, lp2, w1, w2) (
  memset(b1, 0, n1 + n2 + 16); w1 = w2 = 0; lp1 = lp2 = 0;
  d1.z = d2.z = d3.z = d4.z = d5.z = d6.z = e1.z = e2.z = e3.z = e4.z = 0;
);
// (the rate-dependent parts, set up in @init)
EC_N = ceil(4.2 * srate); EC_R = EC_L + EC_N + 16;
ec_w = 0; ec_dc = ec_dn = ec_beats(ec_time) * 60 / max(tempo, 20) * srate; ec_xr = 0; ec_xp = 0; ec_xi = 1 / (0.08 * srate);
ec_wp = 0; ec_fp = 0; ec_q = 0; ec_rs = 0; ec_sp = 0; ec_drv.drift_init(0.9 + rand(1) * 0.4);
ec_clr();
spL.sp_init(SP_M, 1); spR.sp_init(SP_M + 40000, 1.087);
sp_sa = sp_apc(4.263 * srate / 44100); sp_se = sp_apc(3 * srate / 44100);
sp_q = 0; sp_rs = 0; eL = eR = sL = sR = 0; blk_t = 0;
xs = 1 - exp(-1 / (0.015 * srate));                    // 15 ms: the IN keys and RETURN levels
memset(esm, 0, NVO); memset(ssm, 0, NVO);

// ---------- state ----------
ost_init(40000); ostL.ost_ch_init(); ostR.ost_ch_init();
sm = 1 - exp(-1 / (0.03 * srate));
pkL = 0; pkR = 0;
cy_ph1 = 0; cy_ph2 = 0; cy_ph3 = 0; cy_ph4 = 0; cy_ph5 = 0; cy_ph6 = 0;
ins_drift_init();
ph_lp = 0; ph_cnt = 0; ph_mx = 0; ph_aL = ph_aR = ph_coef(400);
run = 0; fbeat = 0; sag = 0;
pa = slot_a; qa = -1; ka = -1;
step_a_d = -1;
update();
out_s = out_t;
ui_dflt = 1;   // first-instance defaults above apply once

// ---------- the player ----------
function play_a(bt) local(n, sb, rl, br, s_, sb_, fr_, sw_, st_, key, fl, gate, v, xa) (
  n = max(1, SLN[pa]); sb = SSB[pa] ? 1 / 3 : 0.25; rl = n * sb;
  br = floor(bt / rl);
  br != qa ? (
    qa = br;
    pa != slot_a ? ( pa = slot_a; n = max(1, SLN[pa]); sb = SSB[pa] ? 1 / 3 : 0.25; rl = n * sb; br = floor(bt / rl); qa = br; );
    fa_ok = has_fill(pa);
  );
  s_ = (bt - br * rl) / sb; sb_ = floor(s_); fr_ = s_ - sb_;
  sw_ = !SSB[pa] && n % 2 == 0 ? swing / 100 * 0.5 : 0;  // swing: the off-beat 16ths come later
  st_ = (sb_ & 1) && fr_ < sw_ ? sb_ - 1 : sb_;
  key = br * 64 + st_;
  key != ka ? (
    ka = key; step_a_d = st_; bar_a_d = br;
    fl = fill_n > 0 && (br % fill_n) == fill_n - 1 && st_ >= n / 2;
    fill_a_d = fl && fa_ok;
    gate = sb * 60 / max(tempo, 20) * srate;
    v = 0;
    loop(NVO,
      xa = cell(pa, fl && fa_ok, v, st_);
      xa > 0 ? hit(v, step_vel(xa), gate);
      v += 1;
    );
  );
);

@slider
prs_chk();
update();

@block
prs_chk();
evn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  stt = m1 & 0xF0;
  ins_chan_ok(m1, chan) && evn < 512 && (stt == 0x90 || stt == 0x80) ? (
    evq[evn * 4] = mofs; evq[evn * 4 + 1] = stt; evq[evn * 4 + 2] = m2; evq[evn * 4 + 3] = m3; evn += 1;
  );
  midisend(mofs, m1, m2, m3);
);
evi = 0; spos = 0;
update();
aud_n_d != aud_seen ? ( aud_seen = aud_n_d; trig(max(0, min(14, aud_v_d | 0)), 1, 0.15 * srate); );   // a voice clicked on screen
// RUN (never on by itself) or FOLLOW (with REAPER's transport)
run_t = follow >= 0.5 ? (play_state & 1) : run_req;
run_t != run ? ( run = run_t; fbeat = 0; ka = qa = -1; pa = slot_a; );
tl_play = play_state & 1;
bps = tempo / 60 / srate;
bp0 = tl_play ? beat_position : fbeat;                  // the timeline while REAPER plays, else free-running
run ? ( fbeat = bp0 + samplesblock * bps; ) : (
  pa = slot_a; step_a_d = -1; fill_a_d = 0;
);
// REAPER's bypass stops the plug-in: on re-enable the echo and spring would replay the old tails, so they start clean
blk_tn = time_precise();
blk_t > 0 && blk_tn - blk_t > 0.5 + samplesblock / srate ? ( ec_clr(); spL.sp_clr(); spR.sp_clr(); ec_q = sp_q = 0; );
blk_t = blk_tn;
sag *= exp(-samplesblock / (0.3 * srate));
ins_drift_block(dm * 0.25, samplesblock);               // GFX instrument drift (50 % = the Stable Clockwork's amount)
// ECHO: the time at the project tempo; a change of more than 0.2 % moves to the other head (80 ms crossfade)
ec_tg = min(ec_beats(ec_time) * 60 / max(tempo, 20) * srate, EC_N * 0.96);
!ec_xr && abs(ec_tg - ec_dc) > ec_dc * 0.002 ? ( ec_dn = ec_tg; ec_xr = 1; ec_xp = 0; );
ec_sp = ec_drv.drift_tick(0.35 * samplesblock / srate) * dm * 0.004;   // DRIFT: the tape speed wanders (+/- 0.4 %)
pkL *= exp(-samplesblock / (0.15 * srate)); pkR *= exp(-samplesblock / (0.15 * srate));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, seq_ok);
file_var(0, vp_ok);
file_mem(0, SLOT, 16 * 720);
file_mem(0, SLN, 16); file_mem(0, SSB, 16); file_mem(0, SRC, 16); file_mem(0, EDT, 16);
file_mem(0, VPAR, NVO * 8);
file_var(0, ed_layer);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// MIDI hits (note-offs release the voice's envelope)
while (evi < evn && (evq[evi * 4] <= spos || spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  e1 = evq[evi * 4 + 1]; e2 = evq[evi * 4 + 2]; e3 = evq[evi * 4 + 3]; ev_v = nmap[e2];
  ev_v >= 0 ? ( e1 == 0x90 && e3 > 0 ? ( trig(ev_v, e3 / 127, 10 * srate); ins_midi_hit(); ) : env_rel(ev_v); );
  evi += 1;
);

// the rhythm, locked to the project's beat position (or free-running)
run ? (
  beat = bp0 + spos * bps;
  beat >= 0 ? (
    play_a(beat);
  );
);
spos += 1;

// delayed (loosened) hits
av = 0; loop(NVO, pend[av] > 0 ? ( pend[av] -= 1; pend[av] == 0 ? trig(av, pvel[av], pgat[av]); ); av += 1; );

// ---------- voices ----------
nz = rand(2) - 1;
y0 = kT.tone_run();
y1 = snT1.tone_run() + snT2.tone_run() + (snN.env > 0.00005 ? ( snF.f_run(nz); snF.hp * snN.env_run() ) : 0);
y2 = rmT1.tone_run() + rmT2.tone_run();
hcE.env > 0.00005 ? ( hcF.f_run(nz); y3 = (hcF.bp + 0.6 * hcF.hp) * hcE.env_run(); ) : y3 = 0;
hoE.env > 0.00005 ? ( hoF.f_run(nz); y4 = (hoF.bp + 0.6 * hoF.hp) * hoE.env_run(); ) : y4 = 0;
cyE.env > 0.00005 ? (
  cy_ph1 += 205.3 * cy_t / srate; cy_ph2 += 304.4 * cy_t / srate; cy_ph3 += 369.6 * cy_t / srate;
  cy_ph4 += 522.7 * cy_t / srate; cy_ph5 += 540 * cy_t / srate;   cy_ph6 += 800 * cy_t / srate;
  mt = (sq(cy_ph1) + sq(cy_ph2) + sq(cy_ph3) + sq(cy_ph4) + sq(cy_ph5) + sq(cy_ph6)) / 6;
  cyF.f_run(mt + 0.4 * nz); y5 = cyF.hp * cyE.env_run();
) : y5 = 0;
y6 = bhT.tone_run(); y7 = blT.tone_run(); y8 = cgT.tone_run(); y9 = clT.tone_run();
maE.env > 0.00005 ? ( ma_a = min(ma_a + 1 / (0.002 * srate), 1); maF.f_run(nz); y10 = maF.hp * maE.env_run() * ma_a; ) : y10 = 0;
gu_len > 0 || guE.env > 0.00005 ? (
  gu_len > 0 ? gu_len -= 1;
  gu_ph += 50 * gu_t / srate; gu_ph >= 1 ? gu_ph -= 1;
  // a short scrape (about 100 ms) that fades as the stick runs out, then a quick 6 ms stop
  guF.f_run(nz); y11 = guF.bp * (gu_ph < 0.5 ? 1 : 0.08) * (gu_len > 0 ? guE.env * (0.45 + 0.55 * gu_len / gu_n) : guE.env_run()) * 1.25;
) : y11 = 0;
y12 = ta_on ? tam_run(nz) : 0;
(cbE1.env + cbE2.env) > 0.00005 ? (
  cb_ph1 += 562 * cb_t / srate; cb_ph2 += 845 * cb_t / srate;
  y13 = cbF.f_run(sq(cb_ph1) + sq(cb_ph2)) * (cbE1.env_run() + cbE2.env_run()) * 0.5;
) : y13 = 0;
mbE.env > 0.00005 ? (
  mb_ph1 += 1180 * mb_t / srate; mb_ph2 += 1720 * mb_t / srate;
  mbF.f_run(sq(mb_ph1) * sq(mb_ph2)); y14 = mbF.hp * mbE.env_run() * 0.6;
) : y14 = 0;


// mix with pan (SPREAD scales the pan positions); each voice through its envelope (transparent by default)
oL = 0; oR = 0;
av = 0;
loop(NVO,
  yv = av == 0 ? y0 : av == 1 ? y1 : av == 2 ? y2 : av == 3 ? y3 : av == 4 ? y4 : av == 5 ? y5 : av == 6 ? y6 : av == 7 ? y7 :
       av == 8 ? y8 : av == 9 ? y9 : av == 10 ? y10 : av == 11 ? y11 : av == 12 ? y12 : av == 13 ? y13 : y14;
  ENVS[av * 8] > 0 ? yv *= env_tick(av);
  pn_ = vp[av] * width;
  gL = yv * (1 - max(pn_, 0)); gR = yv * (1 + min(pn_, 0));
  oL += gL; oR += gR;
  esm[av] += (VPAR[av * 8 + 6] * 0.01 - esm[av]) * sm; ssm[av] += (VPAR[av * 8 + 7] * 0.01 - ssm[av]) * sm;   // the sends glide
  eL += gL * esm[av]; eR += gR * esm[av]; sL += gL * ssm[av]; sR += gR * ssm[av];
  av += 1;
);
// ECHO and SPRING returns (each sleeps once its input and its tail are silent; the tails ring on after the rhythm stops)
ec_rs += (ec_rt - ec_rs) * xs; sp_rs += (sp_rt - sp_rs) * xs;
abs(eL) + abs(eR) > 0.000001 ? ec_q = 2 * EC_N;
ec_q > 0 ? (
  ec_q -= 1;
  ec_wp += 0.55 / srate; ec_wp >= 1 ? ec_wp -= 1; ec_fp += 6.3 / srate; ec_fp >= 1 ? ec_fp -= 1;
  ec_m = 1 + ec_sp + ec_wd * 0.0007 * sin(2 * $pi * ec_fp);
  ecy = ecL.ec_side(EC_L, eL, ec_m + ec_wd * 0.005 * sin(2 * $pi * ec_wp));
  ecz = ecR.ec_side(EC_R, eR, ec_m + ec_wd * 0.005 * cos(2 * $pi * ec_wp));
  ec_w += 1; ec_w >= EC_N ? ec_w = 0;
  ec_xr ? ( ec_xp += ec_xi; ec_xp >= 1 ? ( ec_dc = ec_dn; ec_xr = 0; ); );
  abs(ecy) + abs(ecz) > 0.000001 ? ec_q = max(ec_q, 2 * ec_dc + 64);
  oL += ecy * ec_rs; oR += ecz * ec_rs;
) : ( ec_xr ? ( ec_dc = ec_dn; ec_xr = 0; ); );
abs(sL) + abs(sR) > 0.000001 ? sp_q = 0.2 * srate;
sp_q > 0 ? (
  sp_q -= 1;
  spHL.f_run(sL); spLL.f_run(spHL.hp); spHR.f_run(sR); spLR.f_run(spHR.hp);
  spy = spL.sp_run(spLL.lp); spz = spR.sp_run(spLR.lp);
  abs(spy) + abs(spz) > 0.000001 ? sp_q = max(sp_q, 0.2 * srate);
  oL += spy * sp_rs; oR += spz * sp_rs;
);
eL = eR = sL = sR = 0;
// phaser (fades in and out with the ON key, so switching it never clicks)
ph_mx += (ph_mix_t - ph_mx) * sm;
ph_mx > 0.0005 ? (
  ph_cnt <= 0 ? (
    ph_cnt = 32; ph_lp += ph_rate_v * 32 / srate; ph_lp >= 1 ? ph_lp -= 1;
    ph_aL = ph_coef(ph_freq(ph_lp)); ph_aR = ph_coef(ph_freq(ph_lp + ph_off));
  );
  ph_cnt -= 1;
  oL = phL.ph_run(oL, ph_aL); oR = phR.ph_run(oR, ph_aR);
);
out_s += (out_t - out_s) * sm;
oL = ostL.ost_band(oL * 0.5) * out_s;
oR = ostR.ost_band(oR * 0.5) * out_s;
ins_stereo(oL, oR); ost_out(ins_sl, ins_sr);           // mono-maker / widener, then the output stage
spl0 = ost_l;
spl1 = ost_r;
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));

@gfx 1200 888
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
// ---------------------------------------------------------------------------------------------------------
// Champagne keyboard case. Header: badge, name, presets, EDIT, MIDI, size. Main page: RHYTHM A / MORPH / RHYTHM B,
// then the PATTERN grid (the shown memory and part), then SEQUENCER / FEEL / PHASER / MASTER and the IN / OUT strip.
// EDIT page: the 15 voices - TUNE / DECAY / LEVEL and the envelope - in place of the rhythm rows.
// (Panel-side names start w_ so they never share a variable with the audio.)
// ---------------------------------------------------------------------------------------------------------
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_thm = 5; ui_hw = 0;
ui_begin(1200, 888);
ui_fitfont(4, 10.5 * sc);                     // small print (values while touched), a little bigger than the house's
ui_fitfont(5, 13.5 * sc);                     // knob labels
ui_fitfont(10, 13.5 * sc);                    // labels
ui_fitfont(11, 16 * sc);                      // section titles
ui_fitfont(12, 11.5 * sc);                    // step numbers, column heads
ui_fitfont(13, 14 * sc);                      // lamp-key legends
gfx_setfont(14, "Courier New", 19 * sc, 'b'); // the rhythm LCDs: name
gfx_setfont(15, "Courier New", 13 * sc, 'b'); // the rhythm LCDs: details
lk_font = 13; lk_font2 = 13; ck_font = 13;

BODY = 0xCDBFA6; BODYL = 0xDCD1BC; BODYD = 0xB3A48A; INKB = 0x3A2C20; BRN = 0x5B3A22; CRM = 0xF1E6D0; BLUE = 0x5C9AEC;
C_BG = BODY; C_ACC = BRN; C_S0 = 0x8A5A34; C_S2 = 0x8A5A34; C_KC = 0x2A2018; C_KNOB = 0x6B4A30; C_KEDGE = 0x4A3220;
C_DIM = BODYD; C_LABEL = INKB; C_VALUE = INKB; C_INK = INKB; C_PTR = CRM; C_KA = 0x8A5A34; C_KAH = 0xB0703C;
C_BTN = 0xC9C6C0; C_BTNT = INKB; C_HDR = BODYL; C_TITLE = INKB;
dr_tabc = 0xE4DBC8; dr_tabs = 0xEFE7D6; dr_ink = INKB; dr_c0 = 0xC9BCA2; dr_c1 = 0xBDAF94; dr_hl = 0x000000;
dy_ink = INKB; dy_bg = BODYL; dy_kst = 36; dy_nov = 1;
lk_well = 0x2A2018;
#w_pm = "Init|Classic|Tight and Dry|Deep and Boomy|Bright|Long Tails|Disco|Latin|Lo-Fi|Electro|Brushes|Dub Rim|Spring Snare|Tape Slap|Echo Percussion|Surf Room";
w_now = time_precise(); w_blink = (w_now * 4 % 2) < 1;

// voice colours by family (darker = lower): kick brown, snare / rim red, hats yellow, cymbal blue, percussion violet
function w_vcol(v) (
  v == 0 ? 0x8A5530 : v == 1 ? 0xB8362E : v == 2 ? 0xE0605A : v == 3 ? 0xF0D060 : v == 4 ? 0xD8B030 : v == 5 ? 0x4A86D0 :
  v == 6 ? 0x7A5AAE : v == 7 ? 0x6A4A9C : v == 8 ? 0x5A3A8A : v == 9 ? 0xA890D4 : v == 10 ? 0xC2B2E8 : v == 11 ? 0x9070C0 :
  v == 12 ? 0xB4A0DE : v == 13 ? 0x8466B8 : 0x9C80CA;
);
function w_vname(v) (
  v == 0 ? "KICK" : v == 1 ? "SNARE" : v == 2 ? "RIMSHOT" : v == 3 ? "CLOSED HAT" : v == 4 ? "OPEN HAT" : v == 5 ? "CYMBAL" :
  v == 6 ? "BONGO HIGH" : v == 7 ? "BONGO LOW" : v == 8 ? "CONGA" : v == 9 ? "CLAVE" : v == 10 ? "MARACAS" : v == 11 ? "GUIRO" :
  v == 12 ? "TAMBOURINE" : v == 13 ? "COWBELL" : "METAL BEAT";
);
function w_vnote(v) (
  v == 0 ? "36" : v == 1 ? "38" : v == 2 ? "37" : v == 3 ? "42" : v == 4 ? "46" : v == 5 ? "49" : v == 6 ? "60" : v == 7 ? "61" :
  v == 8 ? "62" : v == 9 ? "75" : v == 10 ? "70" : v == 11 ? "73" : v == 12 ? "54" : v == 13 ? "56" : "80";
);
function w_rect(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function w_txt(x, y, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = y * sc - th * 0.5; gfx_drawstr(s); );
function w_ctxt(x, y, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw * 0.5; gfx_y = y * sc - th * 0.5; gfx_drawstr(s); );
function w_rtxt(x, y, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = y * sc - th * 0.5; gfx_drawstr(s); );
function w_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a section: soft drop shadow (light from the top left), the face, a brown header band with the title on it
function sect(x, y, w, h, title) local(i) (
  i = 1; loop(4, ui_cola(0x000000, 0.13 * 0.5); ui_rrect((x + 1 + i) * sc, (y + 1 + i * 1.6) * sc, (w + i * 0.5) * sc, (h + i * 0.5) * sc, 7 * sc); i += 1; );
  ui_col(BODYL); ui_rrect(x * sc, y * sc, w * sc, h * sc, 6 * sc);
  ui_col(BRN); ui_rrect(x * sc, y * sc, w * sc, 32 * sc, 6 * sc); w_rect(x, y + 16, w, 16);
  ui_cola(0xFFFFFF, 0.12); w_rect(x + 6, y + 1, w - 12, 1);
  gfx_setfont(11); ui_col(CRM); w_txt(x + 14, y + 16, title);
);
// a display box: dark recessed window with light text; returns 1 when clicked
function dbox(x, y, w, h, s) local(hit, hov) (
  hov = w_in(x, y, w, h);
  hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.3); w_rect(x + 1, y + 2, w, h);
  ui_col(0x0A0A08); w_rect(x, y, w, h);
  ui_col(0x2A2622); w_rect(x + 2, y + 2, w - 4, h - 4);
  ui_cola(0x000000, 0.5); w_rect(x + 2, y + 2, w - 4, 2); w_rect(x + 2, y + 2, 2, h - 4);
  hov ? ( ui_cola(0xFFFFFF, 0.07); w_rect(x + 2, y + 2, w - 4, h - 4); );
  gfx_setfont(13); ui_col(0xF2E6C8); w_ctxt(x + w * 0.5, y + h * 0.5, s);
  hit;
);
// a knob on a slider: flat coloured cap, value ring, name under it, the value while touched
function kb(cx, cy, r, idx, lo, hi, def, lg, cap, lbl, fmt) (
  sprintf(#w_kv, fmt, slider(idx));
  dy_knob(cx, cy, r, idx, lo, hi, def, lg, cap, lbl, #w_kv);
);
// a small knob on a voice value (memory, or a slider when idx > 0); the value shows to its right while touched
function mk(cx, cy, r, ptr, idx, lo, hi, def, lg, step, col, fmt, id) local(v, n, dx, dy, hov, did, ch) (
  did = 7000 + id; ch = 0;
  v = idx > 0 ? slider(idx) : ptr[0];
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    w_now - w_mlt < 0.35 && w_mlid == id ? ( v = def; ch = 1; drag_id = -1; w_mlt = 0; ) : (
      drag_id = did; w_my = mouse_y; w_mlt = w_now; w_mlid = id;
      w_mn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    w_mn = min(max(w_mn + (w_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1); w_my = mouse_y;
    v = lg ? lo * (hi / lo) ^ w_mn : lo + w_mn * (hi - lo); ch = 1;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo); mouse_wheel = 0; ch = 1;
  );
  step > 0 ? v = lo + floor((v - lo) / step + 0.5) * step;
  ch ? ( idx > 0 ? ( slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); ); ) : ptr[0] = v; );
  n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  dy_ccap(cx * sc, cy * sc, r * sc, n, col);
  (hov || drag_id == did) ? (
    sprintf(#w_mv, fmt, v); gfx_setfont(12);
    ui_cola(0x1E1812, 0.92); gfx_measurestr(#w_mv, w_tw, w_th);
    w_mx = w_mkl ? (cx - r - 9) * sc - w_tw - 8 * sc : (cx + r + 9) * sc;
    gfx_rect(w_mx, cy * sc - w_th * 0.5 - 2 * sc, w_tw + 8 * sc, w_th + 4 * sc);
    ui_col(CRM); gfx_x = w_mx + 4 * sc; gfx_y = cy * sc - w_th * 0.5; gfx_drawstr(#w_mv);
  );
);
// a rhythm memory's name: the bank rhythm it came from (USER when cleared / your own)
function w_name(s) ( SRC[s] >= 0 && SRC[s] < 32 ? strcpy(#w_nm, 100 + SRC[s]) : strcpy(#w_nm, "User"); #w_nm; );
function w_meter(s) ( SSB[s] ? "TRIPLETS" : SLN[s] == 16 ? "4/4" : SLN[s] == 12 ? "3/4" : "16THS"; );
function slot_fill_ui(s, b) (
  memcpy(SLOT + s * 720, PAT + b * 720, 720);
  SLN[s] = pn[b]; SSB[s] = psb[b] > 0.3; SRC[s] = b; EDT[s] = 0;
);
function w_set(idx, v) ( slider(idx) = v; ui_auto(idx); );

// ---------- the case ----------
ui_col(0x8E8C88); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(BODY); w_rect(0, 0, 1200, 888);
ui_cola(0x000000, 0.18); w_rect(1196, 0, 4, 888); w_rect(0, 884, 1196, 4);          // a narrow darker right / bottom edge
ui_cola(0xFFFFFF, 0.25); w_rect(0, 0, 1196, 2);
rd_screw(10, 10); rd_screw(1188, 10); rd_screw(10, 876); rd_screw(1188, 876);

// ---------- header ----------
rd_badge(40, 33, 16, INKB, BODY);
rd_title(64, 13, "CLOCKWORK", 28, INKB); ver_tag("v3", 16, 0, 0);
gfx_setfont(10); ui_cola(INKB, 0.72); gfx_x = 66 * sc; gfx_y = 46 * sc; gfx_drawstr("ANALOGUE RHYTHM BOX  -  ECHO AND SPRING");
w_k = pk_preset(392 * sc, 15 * sc, 380 * sc, 34 * sc, pr_cur, #w_pm);
w_k > 0 ? ( prs_dirty = w_k; pr_cur = w_k; );
lk_key(796, 17, 84, 30, lb_on, LK_ORA, "EDIT") ? lb_on = !lb_on;      // the voice page
rd_led(918, 27, 5, ins_midi_lit(), 0x3ADF6A); gfx_setfont(12); ui_col(INKB); w_ctxt(918, 44, "MIDI");
ui_size_picker(1118 * sc, 24 * sc);
ui_col(BRN); w_rect(0, 64, 1196, 4);

!lb_on ? (
  // ---------- RHYTHM: the memory it plays, its LCD and the 16 memory keys ----------
  w_x = 16; w_y = 80; w_sl = slot_a; w_pl = pa;
  sect(w_x, w_y, 436, 140, "RHYTHM");
  pk_lcd((w_x + 16) * sc, (w_y + 42) * sc, 404 * sc, 48 * sc, 0);
  gfx_setfont(14); ui_col(pk_lcdc);
  run && w_sl != w_pl && !w_blink ? sprintf(#w_lt, "   %s", w_name(w_sl)) : sprintf(#w_lt, "%02d %s", w_sl + 1, w_name(w_sl));
  gfx_x = (w_x + 26) * sc; gfx_y = (w_y + 46) * sc; gfx_drawstr(#w_lt);
  gfx_setfont(15); ui_cola(pk_lcdc, 0.85);
  sprintf(#w_lt, "%s  %d STEPS%s", w_meter(w_sl), SLN[w_sl], EDT[w_sl] ? "  EDITED" : "");
  gfx_x = (w_x + 26) * sc; gfx_y = (w_y + 71) * sc; gfx_drawstr(#w_lt);
  !run ? strcpy(#w_lt, "STOPPED") : w_sl != w_pl ? strcpy(#w_lt, "NEXT BAR") : sprintf(#w_lt, "BAR %d%s", bar_a_d + 1, fill_a_d ? " FILL" : "");
  w_rtxt(w_x + 408, w_y + 78, #w_lt);
  w_s = 0;
  loop(16,
    sprintf(#w_kn, "%d", w_s + 1);
    lk_key(w_x + 18 + w_s * 25, w_y + 102, 22, 24, w_s == w_sl && !(run && w_sl != w_pl && !w_blink), LK_AMB, #w_kn) ? w_set(1, w_s);
    w_s += 1;
  );

  // ---------- ECHO: TIME, FEEDBACK, TONE, WOW, RETURN; IN in the header band ----------
  sect(464, 80, 354, 140, "ECHO");
  lk_key(762, 84, 44, 24, ec_on >= 0.5, LK_AMB, "IN") ? w_set(41, ec_on >= 0.5 ? 0 : 1);
  gfx_setfont(5); ui_col(INKB); w_ctxt(520, 136, "TIME");
  dbox(482, 150, 76, 30, ec_time == 0 ? "1/16" : ec_time == 1 ? "1/8 T" : ec_time == 2 ? "1/16 D" : ec_time == 3 ? "1/8" :
       ec_time == 4 ? "1/4 T" : ec_time == 5 ? "1/8 D" : ec_time == 6 ? "1/4" : ec_time == 7 ? "1/2 T" : ec_time == 8 ? "1/4 D" : "1/2") ? (
    gfx_x = 482 * sc + ui_mdx; gfx_y = 180 * sc + ui_mdy;
    strcpy(#w_mm, ""); w_k = 0;
    loop(10,
      strcat(#w_mm, ec_time == w_k ? "!" : "");
      strcat(#w_mm, w_k == 0 ? "1/16" : w_k == 1 ? "1/8 triplet" : w_k == 2 ? "1/16 dotted" : w_k == 3 ? "1/8" : w_k == 4 ? "1/4 triplet" :
                    w_k == 5 ? "1/8 dotted" : w_k == 6 ? "1/4" : w_k == 7 ? "1/2 triplet" : w_k == 8 ? "1/4 dotted" : "1/2");
      w_k < 9 ? strcat(#w_mm, "|"); w_k += 1;
    );
    w_k = gfx_showmenu(#w_mm); w_k > 0 ? w_set(42, w_k - 1);
  );
  kb(600, 160, 17, 43, 0, 100, 40, 0, BRN, "FEEDBACK", "%.0f%%");
  kb(664, 160, 17, 44, 0, 100, 50, 0, BRN, "TONE", "%.0f%%");
  kb(726, 160, 17, 45, 0, 100, 30, 0, BRN, "WOW", "%.0f%%");
  kb(788, 160, 17, 46, 0, 100, 60, 0, LK_AMB, "RETURN", "%.0f%%");
  ec_on < 0.5 ? ( ui_cola(BODYL, 0.5); w_rect(470, 116, 342, 100); );        // switched off: drawn greyed

  // ---------- SPRING: DECAY, TONE, HPF / LPF on the send, RETURN; IN in the header band ----------
  sect(830, 80, 354, 140, "SPRING");
  lk_key(1128, 84, 44, 24, sp_on >= 0.5, LK_AMB, "IN") ? w_set(47, sp_on >= 0.5 ? 0 : 1);
  kb(876, 160, 17, 48, 0, 100, 50, 0, BRN, "DECAY", "%.0f%%");
  kb(942, 160, 17, 49, 0, 100, 50, 0, BRN, "TONE", "%.0f%%");
  kb(1008, 160, 17, 50, 55, 1100, 220, 1, 0xE0B830, "HPF", "%.0f Hz");
  kb(1074, 160, 17, 51, 1100, 11000, 5500, 1, 0x2A2420, "LPF", "%.0f Hz");
  kb(1140, 160, 17, 52, 0, 100, 60, 0, LK_AMB, "RETURN", "%.0f%%");
  sp_on < 0.5 ? ( ui_cola(BODYL, 0.5); w_rect(836, 116, 342, 100); );

  // ---------- PATTERN: the grid of the shown memory and part, a send pair per voice ----------
  w_es = slot_a;
  sprintf(#w_lt, "PATTERN  -  MEMORY %d: %s", w_es + 1, w_name(w_es));
  sect(16, 236, 1168, 440, #w_lt);
  gfx_setfont(10); ui_cola(CRM, 0.85); w_rtxt(1170, 252, "click a step: off > hit > accent  -  drag to paint a row");
  w_gy = 236;
  gfx_setfont(10); ui_col(INKB); w_txt(32, w_gy + 57, "PART");
  ck_key(76, w_gy + 44, 74, 26, ed_layer == 0, "MAIN") ? ed_layer = 0;
  ck_key(156, w_gy + 44, 74, 26, ed_layer == 1, "VAR B") ? ed_layer = 1;
  ck_key(236, w_gy + 44, 74, 26, ed_layer == 2, "FILL") ? ed_layer = 2;
  gfx_setfont(10); ui_col(INKB); w_txt(342, w_gy + 57, "LENGTH");
  sprintf(#w_kn, "%d", SLN[w_es]);
  dbox(402, w_gy + 44, 54, 26, #w_kn) ? (
    strcpy(#w_mm, ""); w_k = 1;
    loop(16, sprintf(#w_kn, "%s%d step%s", SLN[w_es] == w_k ? "!" : "", w_k, w_k > 1 ? "s" : ""); strcat(#w_mm, #w_kn); w_k < 16 ? strcat(#w_mm, "|"); w_k += 1; );
    gfx_x = 402 * sc + ui_mdx; gfx_y = (w_gy + 70) * sc + ui_mdy; w_k = gfx_showmenu(#w_mm);
    w_k > 0 ? ( SLN[w_es] = w_k; EDT[w_es] = 1; );
  );
  gfx_setfont(10); ui_col(INKB); w_txt(484, w_gy + 57, "GRID");
  dbox(526, w_gy + 44, 104, 26, SSB[w_es] ? "TRIPLETS" : "16THS") ? (
    gfx_x = 526 * sc + ui_mdx; gfx_y = (w_gy + 70) * sc + ui_mdy;
    w_k = gfx_showmenu(SSB[w_es] ? "16th notes|!Triplets (four to the bar)" : "!16th notes|Triplets (four to the bar)");
    w_k > 0 ? ( SSB[w_es] = w_k - 1; EDT[w_es] = 1; );
  );
  ck_key(660, w_gy + 44, 112, 26, 0, "PATTERN ...") ? (
    strcpy(#w_mm, ">Load a kit rhythm from the bank|"); w_k = 0;
    loop(16, w_k == 15 ? strcat(#w_mm, "<"); strcat(#w_mm, 100 + w_k); strcat(#w_mm, "|"); w_k += 1; );
    strcat(#w_mm, ">Load a percussion rhythm from the bank|");
    loop(16, w_k == 31 ? strcat(#w_mm, "<"); strcat(#w_mm, 100 + w_k); strcat(#w_mm, "|"); w_k += 1; );
    strcat(#w_mm, "Clear this part|Clear the whole rhythm|Copy the rhythm|");
    strcat(#w_mm, w_clip ? "Paste the rhythm" : "#Paste the rhythm");
    gfx_x = 660 * sc + ui_mdx; gfx_y = (w_gy + 70) * sc + ui_mdy; w_k = gfx_showmenu(#w_mm);
    w_k >= 1 && w_k <= 32 ? slot_fill_ui(w_es, w_k - 1) :
    w_k == 33 ? ( memset(SLOT + w_es * 720 + ed_layer * 240, 0, 240); EDT[w_es] = 1; ) :
    w_k == 34 ? ( memset(SLOT + w_es * 720, 0, 720); SRC[w_es] = -1; EDT[w_es] = 0; ) :
    w_k == 35 ? ( memcpy(CLIPB, SLOT + w_es * 720, 720); CLIPB[720] = SLN[w_es]; CLIPB[721] = SSB[w_es]; CLIPB[722] = SRC[w_es]; w_clip = 1; ) :
    w_k == 36 ? ( memcpy(SLOT + w_es * 720, CLIPB, 720); SLN[w_es] = CLIPB[720]; SSB[w_es] = CLIPB[721]; SRC[w_es] = CLIPB[722]; EDT[w_es] = 1; );
  );
  // the step numbers, then a row per voice: its name (click to hear it), 16 steps
  w_play = run && w_es == pa ? step_a_d : -1;
  w_grp = SSB[w_es] ? 3 : 4;                        // triplets: steps grouped in threes
  gfx_setfont(12);
  w_s = 0;
  loop(16,
    w_cx = 206 + w_s * 52 + floor(w_s / w_grp) * 10;
    ui_cola(INKB, w_s < SLN[w_es] ? (SSB[w_es] ? (w_s % 3 == 0 ? 1 : 0.55) : (w_s % 4 == 0 ? 1 : 0.55)) : 0.25);
    sprintf(#w_kn, "%d", w_s + 1); w_ctxt(w_cx + 24, w_gy + 84, #w_kn);
    w_s += 1;
  );
  gfx_setfont(12); ui_col(INKB); w_ctxt(1112, w_gy + 84, "ECHO"); w_ctxt(1158, w_gy + 84, "SPRING");
  w_v = 0;
  loop(NVO,
    w_ry = w_gy + 94 + w_v * 22; w_c = w_vcol(w_v);
    dr_tab(32, w_ry, 160, 20, w_c, w_vname(w_v), w_vnote(w_v), lt[w_v], 0) ? ( aud_v_d = w_v; aud_n_d += 1; );
    lt[w_v] *= 0.82;
    w_s = 0;
    loop(16,
      w_cx = 206 + w_s * 52 + floor(w_s / w_grp) * 10;
      w_b = SLOT + w_es * 720 + ed_layer * 240 + w_v * 16 + w_s;
      w_val = w_b[0];
      w_hov = w_in(w_cx, w_ry, 48, 20);
      pressed && w_hov && drag_id == 0 ? ( drag_id = 9100; w_pv = (w_val + 1) % 3; w_prow = w_v; w_b[0] = w_pv; w_val = w_pv; EDT[w_es] = 1; );
      drag_id == 9100 && mdown && w_hov && w_v == w_prow && w_val != w_pv ? ( w_b[0] = w_pv; w_val = w_pv; EDT[w_es] = 1; );
      w_on = SSB[w_es] ? w_s % 3 == 0 : (w_s >> 2) % 2 == 0;
      dr_cell(w_cx, w_ry, 48, 20, w_val, w_c, w_play == w_s, w_on);
      w_s >= SLN[w_es] ? ( ui_cola(BODYL, 0.62); w_rect(w_cx, w_ry, 48, 20); );   // past the rhythm's length
      w_s += 1;
    );
    // the voice's ECHO and SPRING sends (the value shows to the left while touched)
    w_p = VPAR + w_v * 8; w_mkl = 1;
    mk(1112, w_ry + 10, 7.5, w_p + 6, 0, 0, 100, 0, 0, 1, w_c, "%.0f%%", 200 + w_v * 2);
    mk(1158, w_ry + 10, 7.5, w_p + 7, 0, 0, 100, 0, 0, 1, w_c, "%.0f%%", 201 + w_v * 2);
    w_mkl = 0;
    w_v += 1;
  );
) : (
  // ---------- EDIT: each voice's sound and envelope ----------
  sect(16, 80, 1168, 596, "VOICES  -  SOUND AND ENVELOPE FOR EACH VOICE");
  gfx_setfont(10); ui_cola(CRM, 0.85); w_rtxt(1170, 96, "click a voice's name to hear it  -  double-click a knob to reset it");
  gfx_setfont(10); ui_col(INKB);
  w_ctxt(342, 124, "SOUND"); w_ctxt(728, 124, "ENVELOPE");
  ui_cola(INKB, 0.4); w_rect(232, 134, 220, 1); w_rect(548, 134, 360, 1);
  gfx_setfont(12); ui_col(INKB);
  w_txt(40, 146, "VOICE"); w_ctxt(262, 146, "TUNE"); w_ctxt(342, 146, "DECAY"); w_ctxt(422, 146, "LEVEL");
  w_ctxt(578, 146, "ATTACK"); w_ctxt(668, 146, "DECAY"); w_ctxt(758, 146, "SUSTAIN"); w_ctxt(848, 146, "RELEASE");
  w_ctxt(1010, 124, "SENDS"); ui_cola(INKB, 0.4); w_rect(950, 134, 120, 1); ui_col(INKB);
  w_ctxt(970, 146, "ECHO"); w_ctxt(1050, 146, "SPRING"); w_ctxt(1130, 146, "HIT");
  w_v = 0;
  loop(NVO,
    w_ry = 160 + w_v * 33; w_c = w_vcol(w_v); w_p = VPAR + w_v * 8;
    dr_tab(32, w_ry, 180, 26, w_c, w_vname(w_v), w_vnote(w_v), lt[w_v], 0) ? ( aud_v_d = w_v; aud_n_d += 1; );
    w_lit = lt[w_v]; lt[w_v] *= 0.82;
    dr_band(220, w_ry, 952, 26, w_c, w_in(220, w_ry, 952, 26));
    ui_cola(INKB, 0.25); w_rect(500, w_ry + 3, 1, 20); w_rect(920, w_ry + 3, 1, 20);
    mk(262, w_ry + 13, 10, w_p, 0, -12, 12, 0, 0, 0.1, w_c, "%+.1f st", w_v * 8);
    mk(342, w_ry + 13, 10, w_p + 1, 0, 25, 400, 100, 0, 1, w_c, "%.0f%%", w_v * 8 + 1);
    mk(422, w_ry + 13, 10, 0, LVL + w_v, 0, 100, lvdef[w_v], 0, 1, w_c, "%.0f%%", w_v * 8 + 2);
    mk(578, w_ry + 13, 10, w_p + 2, 0, 0, 200, 0, 0, 1, w_c, "%.0f ms", w_v * 8 + 3);
    mk(668, w_ry + 13, 10, w_p + 3, 0, 5, 4000, 4000, 1, 1, w_c, "%.0f ms", w_v * 8 + 4);
    mk(758, w_ry + 13, 10, w_p + 4, 0, 0, 100, 100, 0, 1, w_c, "%.0f%%", w_v * 8 + 5);
    mk(848, w_ry + 13, 10, w_p + 5, 0, 5, 5000, 5000, 1, 1, w_c, w_p[5] >= 4990 ? "NATURAL" : "%.0f ms", w_v * 8 + 6);
    mk(970, w_ry + 13, 10, w_p + 6, 0, 0, 100, 0, 0, 1, w_c, "%.0f%%", w_v * 8 + 7);
    mk(1050, w_ry + 13, 10, w_p + 7, 0, 0, 100, 0, 0, 1, w_c, "%.0f%%", 300 + w_v);
    rd_led(1130, w_ry + 13, 5, w_lit > 0.15, w_c);
    w_v += 1;
  );
);

// ---------- SEQUENCER ----------
sect(16, 692, 316, 124, "SEQUENCER");
follow >= 0.5 ? ( lk_inert = 1; lk_key(32, 736, 76, 30, run, LK_RED, "RUN"); ) :
  ( lk_key(32, 736, 76, 30, run, LK_RED, "RUN") ? run_req = !run_req; );
lk_key(32, 776, 76, 26, follow >= 0.5, LK_YEL, "FOLLOW") ? ( w_set(2, follow >= 0.5 ? 0 : 1); run_req = 0; );
lk_key(120, 736, 72, 30, var_b >= 0.5, LK_AMB, "VAR B") ? w_set(3, var_b >= 0.5 ? 0 : 1);
dbox(120, 776, 72, 26, fill == 0 ? "NO FILL" : fill == 1 ? "FILL 2" : fill == 2 ? "FILL 4" : "FILL 8") ? (
  gfx_x = 120 * sc + ui_mdx; gfx_y = 802 * sc + ui_mdy;
  sprintf(#w_mm, "%sNo fill|%sFill every 2 bars|%sFill every 4 bars|%sFill every 8 bars", fill == 0 ? "!" : "", fill == 1 ? "!" : "", fill == 2 ? "!" : "", fill == 3 ? "!" : "");
  w_k = gfx_showmenu(#w_mm); w_k > 0 ? w_set(4, w_k - 1);
);
kb(236, 762, 18, 6, 0, 100, 50, 0, BRN, "ACCENT", "%.0f%%");
kb(298, 762, 18, 5, 0, 100, 0, 0, BRN, "SWING", "%.0f%%");

// ---------- FEEL + DRIFT ----------
sect(348, 692, 236, 124, "FEEL  +  DRIFT");
kb(394, 762, 18, 32, 0, 100, 50, 0, 0x8A5A34, "DRIFT", "%.0f%%");
kb(466, 762, 18, 22, 0, 100, 30, 0, BRN, "HITS", "%.0f%%");
kb(538, 762, 18, 23, 0, 20, 0, 0, BRN, "TIMING", "%.1f ms");

// ---------- PHASER ----------
sect(600, 692, 384, 124, "PHASER");
lk_key(616, 748, 50, 30, ph_on >= 0.5, LK_AMB, "ON") ? w_set(35, ph_on >= 0.5 ? 0 : 1);
kb(704, 762, 16, 36, 0.05, 8, 0.3, 1, BRN, "RATE", "%.2f Hz");
kb(766, 762, 16, 37, 0, 100, 70, 0, BRN, "DEPTH", "%.0f%%");
kb(834, 762, 16, 38, 0, 95, 50, 0, BRN, "FEEDBACK", "%.0f%%");
kb(902, 762, 16, 39, 0, 100, 100, 0, BRN, "MIX", "%.0f%%");
kb(954, 762, 16, 40, 0, 180, 90, 0, BRN, "STEREO", "%.0f deg");
ph_on < 0.5 ? ( ui_cola(BODYL, 0.5); w_rect(684, 736, 296, 76); );          // switched off: drawn greyed

// ---------- MASTER: SPREAD, OUTPUT and the L / R meter ----------
sect(1000, 692, 184, 124, "MASTER");
kb(1036, 762, 18, 25, 0, 100, 60, 0, BRN, "SPREAD", "%.0f%%");
kb(1098, 762, 18, 26, -24, 12, 0, 0, BRN, "OUTPUT", "%.1f dB");
ui_col(0x2A231C); ui_rrect(1134 * sc, 738 * sc, 38 * sc, 70 * sc, 3 * sc);
w_i = 0;
loop(2,
  w_m = w_i ? pkR : pkL; w_m = min(max((20 * log10(max(w_m, 0.00001)) + 48) / 48, 0), 1);
  w_k = 0;
  loop(16,
    ui_col(w_k >= 14 ? 0xE5453A : w_k >= 11 ? 0xE5C437 : 0xE5A637);
    gfx_a = w_m * 16 > w_k + 0.5 ? 1 : 0.14;
    w_rect(1140 + w_i * 14, 798 - w_k * 3.6, 12, 2.6);
    w_k += 1;
  );
  w_i += 1;
);

// ---------- IN / OUT strip: SAT, MONO / WIDTH, MIDI channel ----------
ins_strip(16, 828, 1168, 27, 33, INKB, BODYD);
gfx_setfont(10); ui_col(INKB); w_rtxt(1072, 850, "MIDI CHANNEL");
chan == 0 ? strcpy(#w_kn, "OMNI") : sprintf(#w_kn, "CH %d", chan);
dbox(1084, 836, 88, 28, #w_kn) ? (
  strcpy(#w_mm, chan == 0 ? "!Omni" : "Omni"); w_k = 1;
  loop(16, sprintf(#w_lt, "|%sChannel %d", chan == w_k ? "!" : "", w_k); strcat(#w_mm, #w_lt); w_k += 1; );
  gfx_x = 1084 * sc + ui_mdx; gfx_y = 864 * sc + ui_mdy; w_k = gfx_showmenu(#w_mm); w_k > 0 ? w_set(24, w_k - 1);
);
pk_end();
ui_end();
