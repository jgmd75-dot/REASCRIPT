  g_j += 1; );
g_k = 0;
loop(NV,
  g_cx = 200 + g_k * 92;  g_v = vord(g_k);  g_c = vcol(g_v);
  g_hov = mouse_x >= (g_cx - 40) * sc && mouse_x < (g_cx + 40) * sc && mouse_y >= 100 * sc && mouse_y < 124 * sc;
  gfx_setfont(6, "Trebuchet MS", 14 * sc, 'b');  ui_col(g_hov ? YEL : INKC);
  ui_text(g_cx * sc, 104 * sc, g_v == 0 ? "BASS" : g_v == 1 ? "SNARE" : g_v == 2 ? "LOW TOM" : g_v == 3 ? "MID TOM" : g_v == 4 ? "HI TOM" :
    g_v == 5 ? "RIM" : g_v == 6 ? "CLAP" : g_v == 7 ? "CL HAT" : g_v == 8 ? "OP HAT" : g_v == 9 ? "CRASH" : "RIDE");
  ui_col(g_c);  gfx_rect((g_cx - 30) * sc, 122 * sc, 60 * sc, 3 * sc);                              // the voice's colour
