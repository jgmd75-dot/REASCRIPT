g_j = 0;
loop(5,
  g_y = 172 + g_j * 88;
  gfx_setfont(6, "Trebuchet MS", 15 * sc, 'b');  ui_col(INKC);  gfx_x = 32 * sc;  gfx_y = (g_y - 14) * sc;
  gfx_drawstr(g_j == 0 ? "TUNE" : g_j == 1 ? "ATTACK" : g_j == 2 ? "DECAY" : g_j == 3 ? "SUSTAIN" : "RELEASE");
