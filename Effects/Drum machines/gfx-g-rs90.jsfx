function lbk(cx, cy, idx, lo, hi, def, lg, cap, f) ( kb(cx, cy, 16, idx, lo, hi, def, lg, cap, "", f); );
// the voice colour code (a rainbow in pad order, darker = lower): kick brown, snare / rim red, clap orange,
// hats yellow, toms green, cymbals blue
function vcol(v) (
  v == 0 ? 0x9A6440 : v == 1 ? 0xC8463D : v == 2 ? 0x3E8048 : v == 3 ? 0x55A35C : v == 4 ? 0x8CCB84 :
  v == 5 ? 0xE8857E : v == 6 ? 0xE08A2E : v == 7 ? 0xD9B630 : v == 8 ? 0xF0D873 : v == 9 ? 0x86AEE0 : 0x3D74B8;
);
// the pad order (John's): BD, SN, RIM, CLAP, HH, OH, HT, MT, LT, RD, CR -> the voice number
function vord(i) ( i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 5 : i == 3 ? 6 : i == 4 ? 7 : i == 5 ? 8 : i == 6 ? 4 : i == 7 ? 3 : i == 8 ? 2 : i == 9 ? 10 : 9; );
!lb_on ? (
// ---------- the voices: parameters on the top row, LEVEL on the bottom row (like the original) ----------
R1 = 150;  R2 = 236;  KR = 15;
sect(18, 72, 182, 236, "BASS DRUM", ORG);
kb(53, R1, KR, 2, 0, 100, 50, 0, vcol(0), "TUNE", 1);  kb(109, R1, KR, 3, 0, 100, 50, 0, vcol(0), "ATTACK", 1);
kb(165, R1, KR, 4, 0, 100, 50, 0, vcol(0), "DECAY", 1);  kb(109, R2, KR, 5, 0, 100, 80, 0, vcol(0), "LEVEL", 1);
sect(214, 72, 182, 236, "SNARE DRUM", ORG);
kb(249, R1, KR, 6, 0, 100, 50, 0, vcol(1), "TUNE", 1);  kb(305, R1, KR, 7, 0, 100, 50, 0, vcol(1), "TONE", 1);
kb(361, R1, KR, 8, 0, 100, 50, 0, vcol(1), "SNAPPY", 1);  kb(305, R2, KR, 9, 0, 100, 70, 0, vcol(1), "LEVEL", 1);
sect(410, 72, 126, 236, "RIM / CLAP", ORG);
big_lbl(445, R1 - 8, "RIM");  big_lbl(501, R1 - 8, "CLAP");
kb(445, R2, KR, 19, 0, 100, 60, 0, vcol(5), "LEVEL", 1);  kb(501, R2, KR, 20, 0, 100, 65, 0, vcol(6), "LEVEL", 1);
vline(473, 104, 190);
sect(550, 72, 126, 236, "HI-HATS", YEL);
dy_lbl(613, 106, "DECAY", 0.75);
kb(585, R1, KR, 22, 0, 100, 40, 0, vcol(7), "CLOSED", 1);  kb(641, R1, KR, 23, 0, 100, 40, 0, vcol(8), "OPEN", 1);
kb(613, R2, KR, 21, 0, 100, 60, 0, vcol(7), "LEVEL", 1);
sect(690, 72, 350, 236, "TOMS", ORG);
g_j = 0;
loop(3, g_x = 690 + 7 + g_j * 112;  g_v = 2 - g_j;                       // high, mid, low
  dy_lbl(g_x + 56, 106, g_j == 0 ? "HIGH" : g_j == 1 ? "MID" : "LOW", 0.75);
  kb(g_x + 28, R1, KR, 10 + g_v * 3, 0, 100, 50, 0, vcol(4 - g_j), "TUNE", 1);  kb(g_x + 84, R1, KR, 11 + g_v * 3, 0, 100, 50, 0, vcol(4 - g_j), "DECAY", 1);
  kb(g_x + 56, R2, KR, 12 + g_v * 3, 0, 100, 65, 0, vcol(4 - g_j), "LEVEL", 1);
  g_j > 0 ? vline(g_x, 104, 190);
  g_j += 1; );
sect(1054, 72, 126, 236, "CYMBALS", YEL);
dy_lbl(1089, 106, "RIDE", 0.75);  dy_lbl(1145, 106, "CRASH", 0.75);
kb(1089, R1, KR, 27, 0, 100, 50, 0, vcol(10), "TUNE", 1);  kb(1145, R1, KR, 25, 0, 100, 50, 0, vcol(9), "TUNE", 1);
kb(1089, R2, KR, 26, 0, 100, 50, 0, vcol(10), "LEVEL", 1);  kb(1145, R2, KR, 24, 0, 100, 50, 0, vcol(9), "LEVEL", 1);
vline(1117, 104, 190);

// ---------- the sequencer ----------
sect(18, 320, 864, 292, "SEQUENCER", ORG);
gfx_setfont(4);  ui_cola(INKC, 0.7);  gfx_x = 470 * sc;  gfx_y = 327 * sc;  gfx_drawstr("CLICK A STEP: HIT > ACCENT > OFF  -  DRAG TO PAINT");
// RUN / STOP (never starts by itself)
follow >= 0.5 ? rs_runbtn(34 * sc, 352 * sc, 96 * sc, 40 * sc, run, dy_red) :
  rs_runbtn(34 * sc, 352 * sc, 96 * sc, 40 * sc, run_req, dy_red) ? run_req = !run_req;
dy_lbl(82, 398, follow >= 0.5 ? "RUNS WITH REAPER" : "RUN / STOP", 0.9);
mkey(34, 412, 96, 24, "FOLLOW", follow >= 0.5, YEL) ? ( slider(52) = follow >= 0.5 ? 0 : 1;  run_req = 0;  ui_auto(52); );
dy_lbl(82, 446, "LAST STEP", 0.75);
sprintf(#ls, "%d", LEN[cur_pat]);
menu_box(54, 458, 56, 26, #ls) ? (
  strcpy(#lm, "");  g_j = 1;  loop(16, g_j == LEN[cur_pat] ? strcat(#lm, "!");  strcat(#lm, sprintf(#stp, "%d", g_j));  g_j < 16 ? strcat(#lm, "|");  g_j += 1; );
  gfx_x = 54 * sc;  gfx_y = 486 * sc;  g_k = gfx_showmenu(#lm);  g_k > 0 ? LEN[cur_pat] = g_k;
);
kb(82, 530, KR, 28, 0, 100, 0, 0, CRMC, "SWING", 1);
mkey(34, 582, 96, 24, "PATTERN", 0, ORG) ? (
  strcpy(#em, "Clear this pattern|>Copy this pattern to");  g_j = 1;
  loop(16, strcat(#em, g_j == 16 ? "|<" : "|");  strcat(#em, sprintf(#stp, "%d", g_j));  g_j += 1; );
  strcat(#em, "|>Load a pattern from the bank|Four to the floor|House|Deep house|Chicago jack|Techno|Detroit|Hard techno|Acid|Trance|Minimal|Electro|Electro funk|Breakbeat|Garage shuffle|<Tribal toms");
  gfx_x = 34 * sc;  gfx_y = 608 * sc;  g_k = gfx_showmenu(#em);
  g_k == 1 ? ( memset(SEQ + cur_pat * NV * 16, 0, NV * 16); );
  g_k >= 2 && g_k <= 17 ? ( g_p = g_k - 2;  g_p != cur_pat ? ( memcpy(SEQ + g_p * NV * 16, SEQ + cur_pat * NV * 16, NV * 16);  LEN[g_p] = LEN[cur_pat]; ); );
  g_k >= 18 ? ( memcpy(SEQ + cur_pat * NV * 16, DEMO + (g_k - 18) * NV * 16, NV * 16);  LEN[cur_pat] = 16; );
);
vline(150, 344, 260);
// pattern keys (on the step columns): the playing one lit orange, a waiting one lit yellow
dy_lbl(181, 357, "PAT", 0.75);
g_s = 0;
loop(16, g_x = 200 + g_s * 40 + floor(g_s / 4) * 6;
  mkey(g_x, 348, 36, 24, sprintf(#stp, "%d", g_s + 1), g_s == cur_pat || g_s == pending_pat, g_s == cur_pat ? ORG : YEL) ? pat_sel_d = g_s;
  g_s += 1; );
// the step bar: the original's four colour groups, a light on the playing step
g_sd = step_disp;
g_s = 0;
loop(16, g_x = 200 + g_s * 40 + floor(g_s / 4) * 6;
  ui_col(g_s < 4 ? 0xD8402A : g_s < 8 ? ORG : g_s < 12 ? YEL : CRMC);  gfx_rect(g_x * sc, 384 * sc, 36 * sc, 4 * sc);
  gfx_setfont(4);  ui_cola(INKC, g_s < LEN[cur_pat] ? 0.85 : 0.35);  ui_text((g_x + 12) * sc, 389 * sc, sprintf(#stp, "%d", g_s + 1));
  pk_led((g_x + 28) * sc, 396 * sc, 3.2 * sc, g_s == g_sd, dy_red);
  g_s += 1; );
// the grid: 11 tracks x 16 steps
g_t = 0;
loop(11,
  g_y = 410 + g_t * 18;  g_tv = vord(g_t);
  ui_col(vcol(g_tv));  gfx_rect(156 * sc, (g_y + 2) * sc, 5 * sc, 12 * sc);       // the voice's colour
  gfx_setfont(5);
  g_hov = mouse_x >= 158 * sc && mouse_x < 198 * sc && mouse_y >= g_y * sc && mouse_y < (g_y + 16) * sc;
  ui_cola(INKC, g_hov ? 1 : 0.8);
  ui_text(180 * sc, (g_y + 1) * sc, g_tv == 0 ? "BD" : g_tv == 1 ? "SD" : g_tv == 2 ? "LT" : g_tv == 3 ? "MT" : g_tv == 4 ? "HT" :
    g_tv == 5 ? "RS" : g_tv == 6 ? "CP" : g_tv == 7 ? "CH" : g_tv == 8 ? "OH" : g_tv == 9 ? "CR" : "RD");
  g_hov && pressed && drag_id == 0 ? ( drag_id = -1;  aud_t_d = g_tv;  aud_n_d += 1; );     // audition
  g_s = 0;
  loop(16,
    g_x = 200 + g_s * 40 + floor(g_s / 4) * 6;
    g_a = (cur_pat * 11 + g_tv) * 16 + g_s;  g_v = SEQ[g_a];
    g_in = mouse_x >= g_x * sc && mouse_x < (g_x + 36) * sc && mouse_y >= g_y * sc && mouse_y < (g_y + 16) * sc;
    g_in && pressed && drag_id == 0 ? ( drag_id = -3;  paint_v = (g_v + 1) % 3;  SEQ[g_a] = paint_v;  g_v = paint_v; );
    g_in && drag_id == -3 && mdown && g_v != paint_v ? ( SEQ[g_a] = paint_v;  g_v = paint_v; );
    ui_col(0x0C0C0E);  gfx_rect(g_x * sc, g_y * sc, 36 * sc, 16 * sc);
    ui_col(g_v == 2 ? 0xE0301E : g_v == 1 ? 0xF2C840 : g_in ? 0x3A3A3E : 0x2A2A2D);
    gfx_rect((g_x + 1) * sc, (g_y + 1) * sc, 34 * sc, 14 * sc);
    g_v > 0 ? ( ui_cola(0xFFFFFF, 0.3);  gfx_rect((g_x + 3) * sc, (g_y + 2) * sc, 30 * sc, 2 * sc); );
    g_s == g_sd ? ( ui_cola(0xFFFFFF, 0.14);  gfx_rect(g_x * sc, g_y * sc, 36 * sc, 16 * sc); );
    g_s >= LEN[cur_pat] ? ( ui_cola(SECC, 0.7);  gfx_rect(g_x * sc, g_y * sc, 36 * sc, 16 * sc); );
    g_s += 1; );
  g_t += 1;
);

