  slider53 < 4.5 ? "16 kHz" : slider53 < 5.5 ? "12 kHz" : "8 kHz") ? (
  #rm = ""; gi = 0; loop(7, abs(slider53 - gi) < 0.5 ? strcat(#rm, "!");
    strcat(#rm, gi == 0 ? "40 kHz" : gi == 1 ? "32 kHz" : gi == 2 ? "24 kHz" : gi == 3 ? "20 kHz" : gi == 4 ? "16 kHz" : gi == 5 ? "12 kHz" : "8 kHz");
    gi < 6 ? strcat(#rm, "|"); gi += 1; );
  gfx_x = 704 * sc; gfx_y = 478 * sc; gsel = gfx_showmenu(#rm);
  gsel > 0 ? ( slider53 = gsel - 1; slider_automate(2 ^ 52); );
);
pc_dbox(704, 510, 182, 32, "BITS", slider54 < 0.5 ? "12-BIT" : slider54 < 1.5 ? "10-BIT" : slider54 < 2.5 ? "8-BIT" : "6-BIT") ? (
  #rm = ""; gi = 0; loop(4, abs(slider54 - gi) < 0.5 ? strcat(#rm, "!"); strcat(#rm, gi == 0 ? "12-bit" : gi == 1 ? "10-bit" : gi == 2 ? "8-bit" : "6-bit");
    gi < 3 ? strcat(#rm, "|"); gi += 1; );
  gfx_x = 704 * sc; gfx_y = 542 * sc; gsel = gfx_showmenu(#rm);
