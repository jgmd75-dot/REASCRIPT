ui_knob(84 * sc, 230 * sc, 31, 0, 100, 0, 0, "WAVE", slider31 < 1 ? "SINE" : slider31 > 99 ? "SQUARE" : abs(slider31 - 50) < 1 ? "TRIANGLE" : "%.0f%%");
ui_knob(194 * sc, 230 * sc, 32, 20, 2000, 55, 1, "PITCH", "%.0f Hz");
