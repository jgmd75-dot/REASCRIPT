ui_col(0x0A0B0C); ui_rrect(922 * sc, 424 * sc, 222 * sc, 210 * sc, 4 * sc);
gfx_gradrect(926 * sc, 428 * sc, 214 * sc, 202 * sc, 0.50, 0.80, 0.78, 1, 0, 0, 0, 0, -0.12 / (202 * sc), -0.14 / (202 * sc), -0.14 / (202 * sc), 0);
gsl = sel * 2 + UCUR[sel]; gn = ULEN[gsl]; gbs = USR + gsl * 65536;
pk_lcdfont(8, 11 * sc); ui_col(0x0C2228);
(syn_busy && rs_p == sel) || SVER[sel] != SREN[sel] ? strcpy(#l3, "BUILDING ...") :
  sprintf(#l3, "%s  %.0f kHz  %.2f S", slider54 < 0.5 ? "12-BIT" : slider54 < 1.5 ? "10-BIT" : slider54 < 2.5 ? "8-BIT" : "6-BIT", URT[gsl] / 1000, gn / max(URT[gsl], 1));
gfx_x = 934 * sc; gfx_y = 434 * sc; gfx_drawstr(#l3);
ui_cola(0x0C2228, 0.25); gfx_rect(930 * sc, 538 * sc, 206 * sc, 1 * sc);
gn > 0 ? (
  gx = 0; gw = 204;
  loop(gw,
    gi = floor(gx * gn / gw); gj = max(gi + 1, floor((gx + 1) * gn / gw)); gmn = 1; gmx = -1;
    loop(gj - gi, gmn = min(gmn, gbs[gi]); gmx = max(gmx, gbs[gi]); gi += 1; );
    ui_col(0x0C2228); gfx_rect((931 + gx) * sc, (538 - gmx * 80) * sc, max(1, sc), max(1, (gmx - gmn) * 80 * sc));
    gx += 1;
  );
);
// a knob move: the pad plays its synth, and is heard once the new sound is built (mouse up)
!ed_load_dirty ? ( syn_sl_store() ? ( CHP[sel * 16] != SYN ? pad_setsnd(sel, SYN); aud_w = 1; aud_wp = sel; ); );
);
aud_w && !mdown && SVER[aud_wp] == SREN[aud_wp] && !(syn_busy && rs_p == aud_wp) ? ( aud_w = 0; aud_p_d = aud_wp; aud_n_d += 1; );
!ed_load_dirty ? sliders_to_ed();
pkL_d *= 0.85; pkR_d *= 0.85;

pk_end();
ui_end();
