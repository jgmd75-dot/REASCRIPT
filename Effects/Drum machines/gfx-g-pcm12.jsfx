ui_kmini = 1;
ui_knob(1006 * sc, 466 * sc, 1, -24, 12, 0, 0, "VOLUME", "%.1f dB");
ui_knob(1054 * sc, 466 * sc, 3, 0, 100, 60, 0, "VELO", "%.0f%%");
