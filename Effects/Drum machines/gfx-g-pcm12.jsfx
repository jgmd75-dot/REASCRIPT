pc_key(40, 442, 176, 36, tpl_name(SYP[sel * 32]), -1, fcol(TFAM[SYP[sel * 32]])) ? (
  #tm = ""; gi = 0; loop(16, SYP[sel * 32] == gi ? strcat(#tm, "!"); strcat(#tm, tpl_name(gi)); gi < 15 ? strcat(#tm, "|"); gi += 1; );
  gfx_x = 40 * sc; gfx_y = 478 * sc; gsel = gfx_showmenu(#tm);
  gsel > 0 ? (
    gi = 0; loop(26, SYP[sel * 32 + gi] = TPL[(gsel - 1) * 32 + gi]; gi += 1; );
    SVER[sel] += 1; syn_sl_load(); gi = 31; loop(25, ui_auto(gi); gi += 1; );
    CHP[sel * 16] != SYN ? pad_setsnd(sel, SYN); aud_w = 1; aud_wp = sel;
  );
);
pc_key(40, 492, 176, 36, "USE SYNTH", CHP[sel * 16] == SYN, LEDR) ? (
  CHP[sel * 16] == SYN ? pad_setsnd(sel, SYP[sel * 32 + 26]) : pad_setsnd(sel, SYN);
  aud_p_d = sel; aud_n_d += 1;
);
