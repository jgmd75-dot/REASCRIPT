mR.ui_ledm(1118 * sc, 450 * sc, 20 * sc, 180 * sc, pkR_d);
);

lb_on ? (
// ---------- PAD SYNTH (layer B): build the selected pad's own sound ----------
// the 12 pads: click one to hear it and build it (its LED: the pad plays its synth)
gr = 0;
loop(NCH,
  gx = 24 + gr * 94.4; gy = 90; gb = CHP + gr * 16;
  ghv = pc_in(gx, gy, 88, 54);
  ui_cola(0x000000, 0.4); gfx_rect((gx + 2) * sc, (gy + 3) * sc, 88 * sc, 54 * sc);
  ui_col(sel == gr ? LEDR : 0x141517); ui_rrect(gx * sc, gy * sc, 88 * sc, 54 * sc, 5 * sc);
  ui_col(ghv ? (mdown ? 0x26272B : RUBH) : RUB); ui_rrect((gx + 2) * sc, (gy + 2) * sc, 84 * sc, 50 * sc, 4 * sc);
  lt[gr] > 0.05 ? ( ui_cola(LEDR, 0.35 * lt[gr]); ui_rrect((gx + 2) * sc, (gy + 2) * sc, 84 * sc, 50 * sc, 4 * sc); );
  ui_col(fcol(TFAM[SYP[gr * 32]])); gfx_rect((gx + 6) * sc, (gy + 45) * sc, 76 * sc, 4 * sc);
  gfx_setfont(13); sprintf(#pn, "%d", gr + 1); pc_txt(gx + 8, gy + 5, #pn, 0xE8EAEC);
  gfx_setfont(11); pc_txt(gx + 8, gy + 25, tpl_name(SYP[gr * 32]), 0xE8EAEC);
  pc_led(gx + 76, gy + 12, 3, gb[0] == SYN);
  pressed && drag_id == 0 && ghv ? ( drag_id = -1; aud_p_d = gr; aud_n_d += 1; sel != gr ? ( sel = gr; ed_load_dirty = 1; ); );
  lt[gr] *= 0.85;
  gr += 1;
);
