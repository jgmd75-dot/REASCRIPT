// 0 Burl Grain
pp = PRV + 0*54; pp[0]=0; pp[1]=55; pp[2]=20; pp[3]=30; pp[4]=70; pp[5]=55; pp[6]=0; pp[7]=0; pp[8]=85; pp[9]=0; pp[10]=25; pp[11]=15; pp[12]=45; pp[13]=75; pp[14]=35; pp[15]=5; pp[16]=-8; pp[17]=70; pp[18]=0; pp[19]=30; pp[20]=10; pp[21]=35; pp[22]=60; pp[23]=45; pp[24]=0; pp[25]=-35; pp[26]=65; pp[27]=0; pp[28]=30; pp[29]=10; pp[30]=35; pp[31]=60; pp[32]=48; pp[33]=0; pp[34]=35; pp[35]=65; pp[36]=0; pp[37]=10; pp[38]=25; pp[39]=50; pp[40]=85; pp[41]=18; pp[42]=0; pp[43]=25; pp[44]=55; pp[45]=0; pp[46]=60; pp[47]=30; pp[48]=75; pp[49]=70; pp[50]=40; pp[51]=20; pp[52]=-25; pp[53]=50;
PRG[0*14+0]=0; PRG[0*14+1]=10; PRG[0*14+2]=20; PRG[0*14+3]=7; PRG[0*14+4]=0; PRG[0*14+5]=0; PRG[0*14+6]=0; PRG[0*14+7]=25; PRG[0*14+8]=16; PRG[0*14+9]=16; PRG[0*14+10]=16; PRG[0*14+11]=16; PRG[0*14+12]=16; PRG[0*14+13]=16;
// 1 Bongo Ping
pp = PRV + 1*54; pp[0]=-2; pp[1]=40; pp[2]=10; pp[3]=25; pp[4]=60; pp[5]=50; pp[6]=0; pp[7]=0; pp[8]=80; pp[9]=5; pp[10]=15; pp[11]=5; pp[12]=20; pp[13]=55; pp[14]=25; pp[15]=0; pp[16]=-10; pp[17]=55; pp[18]=3; pp[19]=12; pp[20]=5; pp[21]=20; pp[22]=45; pp[23]=40; pp[24]=0; pp[25]=-40; pp[26]=75; pp[27]=-2; pp[28]=12; pp[29]=5; pp[30]=25; pp[31]=45; pp[32]=42; pp[33]=0; pp[34]=40; pp[35]=75; pp[36]=0; pp[37]=5; pp[38]=10; pp[39]=35; pp[40]=70; pp[41]=14; pp[42]=0; pp[43]=20; pp[44]=45; pp[45]=5; pp[46]=40; pp[47]=20; pp[48]=60; pp[49]=60; pp[50]=30; pp[51]=10; pp[52]=-30; pp[53]=35;
PRG[1*14+0]=1; PRG[1*14+1]=15; PRG[1*14+2]=15; PRG[1*14+3]=1; PRG[1*14+4]=0; PRG[1*14+5]=0; PRG[1*14+6]=0; PRG[1*14+7]=25; PRG[1*14+8]=16; PRG[1*14+9]=16; PRG[1*14+10]=16; PRG[1*14+11]=16; PRG[1*14+12]=16; PRG[1*14+13]=16;
// 2 Fold Engine
pp = PRV + 2*54; pp[0]=-1; pp[1]=65; pp[2]=55; pp[3]=25; pp[4]=85; pp[5]=52; pp[6]=0; pp[7]=0; pp[8]=85; pp[9]=-3; pp[10]=30; pp[11]=55; pp[12]=60; pp[13]=85; pp[14]=38; pp[15]=15; pp[16]=-10; pp[17]=65; pp[18]=-5; pp[19]=35; pp[20]=50; pp[21]=55; pp[22]=75; pp[23]=40; pp[24]=10; pp[25]=-30; pp[26]=60; pp[27]=-7; pp[28]=35; pp[29]=50; pp[30]=55; pp[31]=75; pp[32]=44; pp[33]=10; pp[34]=30; pp[35]=60; pp[36]=0; pp[37]=15; pp[38]=60; pp[39]=70; pp[40]=90; pp[41]=16; pp[42]=10; pp[43]=20; pp[44]=50; pp[45]=-5; pp[46]=70; pp[47]=60; pp[48]=85; pp[49]=85; pp[50]=38; pp[51]=35; pp[52]=-20; pp[53]=50;
PRG[2*14+0]=2; PRG[2*14+1]=0; PRG[2*14+2]=25; PRG[2*14+3]=2; PRG[2*14+4]=0; PRG[2*14+5]=0; PRG[2*14+6]=0; PRG[2*14+7]=25; PRG[2*14+8]=16; PRG[2*14+9]=16; PRG[2*14+10]=16; PRG[2*14+11]=16; PRG[2*14+12]=16; PRG[2*14+13]=16;
