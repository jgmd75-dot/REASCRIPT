function pname(n) ( n==0 ? "Burl Grain" : n==1 ? "Bongo Ping" : n==2 ? "Fold Engine" : n==3 ? "Laser Clave" : n==4 ? "Vactrol Rain" : n==5 ? "Industrial Scrape" : n==6 ? "Metal Rite" : n==7 ? "Sluggish Gate" : n==8 ? "Oak Knot" : n==9 ? "Ringing Hollow" : n==10 ? "Zap Ritual" : n==11 ? "Dead Reckoning" : n==12 ? "Polymeter Grove" : n==13 ? "Tangle Root" : n==14 ? "Fold Storm" : n==15 ? "Slow Vactrol" : n==16 ? "Seven Against Five" : "Warm Optocouplers" );
function load_bank(b) local(i) ( memcpy(PAT, BANK + clampv(b, 0, 5)*384, 384); i = 0; loop(24, LEN[i] = 16; i += 1; ); );
function unc_v(s, v) ( UNC[s*18 + v*3] = rand(2) - 1; UNC[s*18 + v*3 + 1] = rand(2) - 1; UNC[s*18 + v*3 + 2] = rand(2) - 1; );
function unc_new(s) local(v) ( v = 0; loop(18, UNC[s*18 + v] = rand(2) - 1; v += 1; ); );
function unc_all() local(s) ( s = 0; loop(16, unc_new(s); s += 1; ); );
function load_preset(n) local(i, g) (
  n = clampv(floor(n), 0, NPRE - 1);
  i = 0; loop(54, slider(10 + i) = PRV[n*54 + i]; i += 1; );
  g = PRG + n*14;
  slider4 = g[1]; slider5 = g[2]; slider64 = g[3]; ulock = g[4]; slider6 = g[5]; slider7 = g[6]; slider8 = g[7];
  pr_cur = n;
  load_bank(g[0]); unc_all();
  i = 0; loop(24, LEN[i] = g[8 + (i % 6)]; i += 1; );   // the preset's lane lengths, for all four patterns
  i = 1; loop(64, sliderchange(2^(i - 1)); i += 1; );
);
load_bank(PRG[0]); unc_all(); ulock = PRG[4]; pr_cur = 0;

// ---- DSP helpers ----
function blep(t, dt) ( t < dt ? (t /= dt; 2*t - t*t - 1) : t > 1 - dt ? (t = (t - 1)/dt; t*t + 2*t + 1) : 0 );
function sqw(ph, dt) local(y, t) ( y = (ph < 0.5 ? 1 : -1) + blep(ph, dt); t = ph + 0.5; t -= floor(t); y - blep(t, dt) );
function tri(ph) ( ph -= floor(ph); 1 - 4*abs(ph - 0.5) );
function th(x) local(x2) ( x = clampv(x, -3, 3); x2 = x*x; x*(27 + x2)/(27 + 9*x2) );
// the output clipper: anti-aliased (first-order ADAA) hard clip
function adaa_c(x) instance(xp, fp) local(f, y) (
  f = abs(x) <= 1 ? 0.5*x*x : abs(x) - 0.5;
  abs(x - xp) > 0.000001 ? ( y = (f - fp)/(x - xp); ) : ( y = clampv(0.5*(x + xp), -1, 1); );
  xp = x; fp = f; y;
);
function dcb(x) instance(x1, y1) ( y1 = x - x1 + 0.9995*y1; x1 = x; y1 );

// ---- events ----
function ev_add(ofs, v, vel, k) local(i) (
  ne < 256 ? (
    i = ne; while (i > 0 && EVO[i - 1] > ofs) ( EVO[i] = EVO[i - 1]; EVV[i] = EVV[i - 1]; EVL[i] = EVL[i - 1]; EVK[i] = EVK[i - 1]; i -= 1; );
    EVO[i] = ofs; EVV[i] = v; EVL[i] = vel; EVK[i] = k; ne += 1;
  );
);

// ---- per-voice controls (per block, and at a strike) ----
// state: 0 on, 1 gate g, 2 pulse left, 3 pulse height, 4 release coef, 5/6 gate filter, 7-12 phases,
// 13 pitch env, 14 its coef, 15 base Hz, 16 fold gain, 17 previous folded out (LOOP), 18/19 folder ADAA,
// 20 ping, 21 out (FM bus), 22 variant, 23/24 burst filter, 25/26 metal HP, 27 noise HP, 28 level, 29/30 pan,
// 31 decay time (s, at the strike), 33 snap (octaves), 34 FM, 35 character, 36 uncertainty fold, 42 attack coef
function v_ctl(v) local(d, fo, dm, k, t) (
  d = VS + v*64;
  fo = vp(v, 2)/100 + slider6/200 + d[36] + WLK[v*3 + 1]*0.12*drift;
  fo = clampv(fo, 0, 1.3);
  d[16] = 1 + fo*(v == 0 ? 3 : v == 4 ? 7 : 5.5);
  dm = 2^(slider7/50);
  t = max(0.008, d[31]*dm);
  k = 1 + WLK[v*3 + 2]*0.25*drift;
  d[4] = min(0.5, 6.9/(t*srate)*k);
  d[42] = 1 - exp(-1/(0.0015*srate/k));
  d[28] = vnorm(v)*(vp(v, 8)/100)^1.5*1.5;
  t = (vp(v, 7)/100 + 1)*$pi/4; d[29] = cos(t)*1.4142; d[30] = sin(t)*1.4142;
  d[34] = vp(v, 6)/100;
  d[35] = vp(v, 3)/100;
);

function v_strike(v, vel, k) local(d, s, us, ua, tg, st, tune, snap, ch, dec, tc, pit) (
  d = VS + v*64;
  // the uncertainty generator: the held values of the sequencer step that struck (k carries it), or, for a
  // MIDI / panel hit, of this voice's own hit count
  s = floor(k/4) - 1; k = k % 4;
  s < 0 ? ( s = CNT[v] % 16; !ulock ? unc_new(s); CNT[v] += 1; );
  us = UNC + s*18 + v*3;
  ua = sqr(slider5/100); tg = slider64|0;
  tune = vp(v, 0) + (k == 1 ? 19 : 0) + ((tg & 1) ? us[0]*ua*12 : 0);
  pit = tune + (WLK[v*3]*25*drift + (rand(2) - 1)*4*drift)/100;
  d[36] = (tg & 2) ? us[1]*ua*0.6 : 0;
  st = vp(v, 4)/100; snap = vp(v, 1)/100; ch = vp(v, 3)/100; dec = vp(v, 5)/100;
  d[15] = basef(v)*2^(pit/12);
  d[33] = snap*(v == 0 ? 3 : v == 1 ? 1.5 : v == 4 ? 0.5 : v == 5 ? 5 : 1);
  tc = v == 0 ? 0.005 + ch*ch*0.15 : v == 1 ? 0.012 : v == 4 ? 0.01 : v == 5 ? 0.05 : 0.02;
  d[13] = 1; d[44] = exp(-8/(tc*srate)); d[43] = 0;
  d[31] = 0.02*150^dec*((tg & 4) ? 2^(us[2]*ua*1.5) : 1)*(k == 2 ? 6 : k == 1 ? 0.5 : 1);
  d[31] = min(d[31], 10);
  d[22] = k;
  // a fresh voice starts its cores from the top (a sounding one carries on: no click)
  d[1] < 0.02 ? ( d[7] = 0; d[8] = 0; d[9] = rand(); d[10] = rand(); d[11] = rand(); d[12] = rand(); d[17] = 0; );
  v_ctl(v);
  d[2] = floor((0.0005 + st*0.006)*srate); d[3] = min(1, (0.4 + 0.6*(vel/127)^1.3)*(0.6 + 0.4*st));
  d[20] = st*vel/127*0.35;
  d[0] = 1;
  HIT[v] = 1;
);

// ---- the uncertainty / drift state ----
sq_was = 0; sq_fb = 0; sq_exp = -1; sq_step = -1; ne = 0;
sel = 0;
vf = 1; pending = -1; vfstep = 1/(0.004*srate); opkd = exp(-1/(0.25*srate));
t = tan($pi*2400/srate); hp1 = 1/(1 + t*(t + 1.4142)); hp2 = t*hp1; hp3 = t*hp2; outg_s = 10^(slider9/20);
drift = slider8/100;
i = 0; loop(6, v_ctl(i); i += 1; );

// the PRESET parameter asks for a preset the way the panel does: 'pending' (0-based), faded in @block
function bu_req(k) ( pending = k - 1; pend_t = time_precise(); );

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; bu_req(k);
    k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( bu_req(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
drift = slider8/100;

@block
prs_chk();
drift = slider8/100;
outg_t = 10^(slider9/20);
// DRIFT: three slow, mean-reverting wanders per voice (pitch, fold, gate speed)
dtb = samplesblock/srate;
i = 0; loop(18, WLK[i] += -WLK[i]*dtb/6 + 0.45*sqrt(dtb)*(rand() + rand() + rand() - 1.5)*2; i += 1; );
i = 0; loop(6, (VS + i*64)[0] ? v_ctl(i); i += 1; );

// anything the last block didn't reach is played now, never dropped
while (ei < ne) ( v_strike(EVV[ei], EVL[ei], EVK[ei]); ei += 1; );
ne = 0; ei = 0; spos = 0;

// ---- MIDI ----
while (midirecv(mo, m1, m2, m3)) (
  1 ? (
    mst = m1 & 0xF0;
    mst == 0x90 && m3 > 0 ? (
      m2 == 36 || m2 == 35 ? ev_add(mo, 0, m3, 0) :
      m2 == 38 || m2 == 40 ? ev_add(mo, 1, m3, 0) :
      m2 == 37 ? ev_add(mo, 1, m3, 1) :
      m2 == 48 || m2 == 50 ? ev_add(mo, 2, m3, 0) :
      m2 == 45 || m2 == 47 || m2 == 43 || m2 == 41 || m2 == 58 ? ev_add(mo, 3, m3, 0) :
      m2 == 42 || m2 == 44 ? ev_add(mo, 4, m3, 0) :
      m2 == 46 || m2 == 51 || m2 == 53 || m2 == 59 ? ev_add(mo, 4, m3, 2) :
      m2 == 49 || m2 == 52 || m2 == 55 || m2 == 57 ? ev_add(mo, 5, m3, 0);
    ) :
    mst == 0xB0 && (m2 == 120 || m2 == 123) ? ( i = 0; loop(6, d = VS + i*64; d[2] = 0; d[31] = 0.005; v_ctl(i); i += 1; ); );
  );
  midisend(mo, m1, m2, m3);
);

// ---- the sequencer: RUN by hand, or with REAPER's playback (SYNC) ----
sq_play = play_state & 1;
sq_on = slider1 >= 0.5 || (slider2 >= 0.5 && sq_play);
sq_bps = tempo/60/srate;
sq_on ? (
  sq_play ? ( sq_t0 = beat_position; ) : ( !sq_was || sq_wasplay ? sq_fb = 0; sq_t0 = sq_fb; );
  sq_t1 = sq_t0 + sq_bps*samplesblock;
  sq_L = 0.25; sq_sw = slider4/100; sq_tp = clampv(slider3|0, 0, 3);
  !sq_was ? sq_pat = sq_tp;                               // starting: the chosen pattern at once
  k = floor(sq_t0/sq_L) - 1;
  while (k*sq_L < sq_t1) (
    tv = (k & 1) ? k*sq_L + sq_L*sq_sw : k*sq_L;
    k >= 0 && tv >= sq_t0 && tv < sq_t1 ? (
      k % 16 == 0 ? sq_pat = sq_tp;                         // a new pattern takes over at the bar
      ofs = min(floor((tv - sq_t0)/sq_bps), samplesblock - 1);
      i = 0;
      loop(6,
        // each lane counts round its own LENGTH (its uncertainty values follow it, so LOCK repeats with the lane)
        ln = LEN[sq_pat*6 + i]; ln = ln < 1 ? 16 : min(ln, 16);
        s = k % ln;
        !ulock ? unc_v(s, i);
        c = PAT[(sq_pat*6 + i)*16 + s];
        c > 0 ? ev_add(ofs, i, c == 2 ? 127 : c == 3 ? 110 : 96, (i == 4 && c == 3 ? 2 : 0) + 4*(s + 1));
        i += 1;
      );
    );
    k*sq_L >= sq_t0 && k*sq_L < sq_t1 && k >= 0 ? ( sq_step = k % 16; sq_k = k; );
    k += 1;
  );
  sq_exp = sq_t1;
  !sq_play ? sq_fb = sq_t1;
) : (
  sq_step = -1; sq_pat = clampv(slider3|0, 0, 3);            // stopped: a new pattern applies at once
);
sq_was = sq_on; sq_wasplay = sq_play;
// the panel's audition
aud > 0 ? ( ev_add(0, aud - 1, 110, 0); aud = 0; );

// the scope's gate history (one point a block)
eh_p = (eh_p + 1) % 200; ENVH[eh_p] = (VS + sel*64)[1];

@sample
while (ei < ne && (EVO[ei] <= spos || spos >= samplesblock - 1)) ( v_strike(EVV[ei], EVL[ei], EVK[ei]); ei += 1; );
spos += 1;

oL = oR = 0; busn = 0;
v = 0; d = VS;
loop(6,
  d[0] ? (
    // ---- the vactrol: a fast rise while the strike's pulse lasts, then a release that slows as it falls ----
    g = d[1];
    d[2] > 0 ? ( g += (d[3] - g)*d[42]; d[2] -= 1; ) : ( g *= 1 - d[4]*(0.3 + 0.7*g); );
    d[1] = g;
    // ---- pitch: the snap falls back exponentially ----
    // control rate (every 8 samples): the pitch, the gate's and the burst filter's coefficients
    (d[43] -= 1) <= 0 ? (
      d[43] = 8;
      d[13] *= d[44];
      d[37] = d[15]*2^(d[33]*d[13]);
      fc = min((v == 4 ? 700 : v == 1 ? 150 : v == 5 ? 160 : 70)*2^(g*(v == 4 ? 5.2 : v == 1 ? 7.1 : 7.6)), 0.45*srate); gl = tan($pi*fc/srate);
      d[45] = 1/(1 + gl*(gl + 1.15)); d[46] = gl*d[45]; d[47] = gl*d[46];
      v == 5 ? (
        fc = min(d[37], 0.45*srate); gb = tan($pi*fc/srate); kb = 2 - 1.97*d[35];
        d[48] = 1/(1 + gb*(gb + kb)); d[49] = gb*d[48]; d[50] = gb*d[49];
      );
    );
    f = d[37];
    fmb = d[34]*(bus - d[21])*0.35;
    // ---- the core ----
    v == 0 ? (
      d[7] += f/srate; d[7] -= floor(d[7]);
      x = sin(2*$pi*(d[7] + fmb));
    ) : v == 1 ? (
      d[7] += f/srate; d[7] -= floor(d[7]);
      d[8] += f*(1.4 + 3.3*d[35])/srate; d[8] -= floor(d[8]);
      x = sin(2*$pi*(d[7] + fmb) + (0.8 + 5*g)*sin(2*$pi*d[8]));
      d[22] != 1 ? ( nz = rand(2) - 1; d[27] += (nz - d[27])*0.5; x = x*0.65 + (nz - d[27])*0.8; );
    ) : v <= 3 ? (
      d[7] += f/srate; d[7] -= floor(d[7]);
      d[8] += f*1.593/srate; d[8] -= floor(d[8]);
      fb = d[35]*d[17]*0.35;
      x = tri(d[7] + fb + fmb)*0.75 + tri(d[8] + fb*0.5 + fmb)*0.3;
    ) : v == 4 ? (
      sp = 0.4 + 1.2*d[35];
      dt = f/srate;
      d[7] += dt; d[7] -= floor(d[7]);                       a1 = sqw(d[7] + fmb - floor(d[7] + fmb), dt);
      t = dt*(1 + 0.483*sp); d[8] += t; d[8] -= floor(d[8]);   a2 = sqw(d[8], t);
      t = dt*(1 + 0.932*sp); d[9] += t; d[9] -= floor(d[9]);   a3 = sqw(d[9], t);
      t = dt*(1 + 1.546*sp); d[10] += t; d[10] -= floor(d[10]); a4 = sqw(d[10], t);
      t = dt*(1 + 2.103*sp); d[11] += t; d[11] -= floor(d[11]); a5 = sqw(d[11], t);
      t = dt*(1 + 2.68*sp); d[12] += t; d[12] -= floor(d[12]);  a6 = sqw(d[12], t);
      x = (a1*a2 + a3*a4 + a5*a6)*0.45;
    ) : (
      d[7] += f/srate; d[7] -= floor(d[7]);
      nz = rand(2) - 1;
      xi = nz*0.55 + 0.6*sin(2*$pi*(d[7] + fmb));
      v3 = xi - d[24]; v1 = d[48]*d[23] + d[49]*v3; v2 = d[24] + d[49]*d[23] + d[50]*v3;
      d[23] = 3*th((2*v1 - d[23])/3); d[24] = 2*v2 - d[24];
      x = v1*(0.6 + 1.6*d[35]);
    );
    // ---- the wavefolder (anti-aliased sine fold) ----
    u = x*d[16];
    ff = -cos(1.5707963*u)/1.5707963;
    y = abs(u - d[18]) > 0.000001 ? (ff - d[19])/(u - d[18]) : sin(0.78539816*(u + d[18]));
    d[18] = u; d[19] = ff;
    d[17] = y;
    v == 4 ? (   // METAL: high-passed (2-pole, ~2.4 kHz)
      v3 = y - d[26]; v1 = hp1*d[25] + hp2*v3; v2 = d[26] + hp2*d[25] + hp3*v3;
      d[25] = 2*v1 - d[25]; d[26] = 2*v2 - d[26];
      y = y - 1.4142*v1 - v2;
    );
    v == sel ? ( scw = (scw + 1) & 1023; SCB[scw] = y; scf = f; );
    // ---- the low-pass gate: one vactrol opens the level and the brightness together ----
    xi = y + d[20]; d[20] = 0;
    v3 = xi - d[6]; v1 = d[45]*d[5] + d[46]*v3; v2 = d[6] + d[46]*d[5] + d[47]*v3;
    d[5] = 2*v1 - d[5]; d[6] = 2*v2 - d[6];
    o = v2*g*sqrt(g)*d[28];
    d[21] = o; busn += o;
    oL += o*d[29]; oR += o*d[30];
    d[2] <= 0 && g < 0.00003 ? ( d[0] = 0; d[1] = 0; d[5] = d[6] = d[21] = d[23] = d[24] = d[25] = d[26] = 0; d[36] = 0; );
  );
  v += 1; d += 64;
);
bus = busn;

// preset change: fade, load, fade back (no clicks)
pending >= 0 ? (
  vf -= vfstep;
  vf <= 0 ? ( vf = 0; load_preset(pending); i = 0; loop(6, v_ctl(i); i += 1; ); pending = -1; );
) : ( vf < 1 ? vf = min(1, vf + vfstep); );

outg_s += (outg_t - outg_s)*0.002;
spl0 = cpL.adaa_c(dcL.dcb(oL)*0.75*outg_s*vf);
spl1 = cpR.adaa_c(dcR.dcb(oR)*0.75*outg_s*vf);
opk = max(opk*opkd, max(abs(spl0), abs(spl1)));

@serialize
file_var(0, sel);
file_var(0, pr_cur);
file_var(0, ulock);
file_mem(0, PAT, 384);
file_mem(0, UNC, 288);
file_mem(0, LEN, 24);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@gfx 1180 828
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
W0 = 1180; H0 = 828;
sc = max(0.3, min(gfx_w/W0, gfx_h/H0));
ui_tf = sc < (gfx_ext_retina > 1 ? gfx_ext_retina : 1) ? min(sqrt((gfx_ext_retina > 1 ? gfx_ext_retina : 1) / sc), 1.15) : 1;   // text shrinks half as fast as the panel below M (JG, 30 Oct 2026; at most 15 % bigger)
ox = floor((gfx_w - W0*sc)*0.5); oy = floor((gfx_h - H0*sc)*0.5);
gfx_mode = 0; gfx_a2 = 1;
lmb = mouse_cap & 1; rmb = mouse_cap & 2;
click = lmb && !plmb; rclick = rmb && !prmb; wheeled = 0;
!lmb ? ( drag = 0; sdrag = 0; gpaint = -1; );

gfx_setfont(1, "Arial", (13*sc) * max(ui_tf, 1), 'b');   // knob labels
gfx_setfont(2, "Arial", 30*sc, 'b');   // title
gfx_setfont(3, "Arial", (12*sc) * max(ui_tf, 1), 'b');   // keys
gfx_setfont(4, "Arial", 18*sc, 'b');   // LCD / GFX
gfx_setfont(5, "Arial", (14*sc) * max(ui_tf, 1), 'b');   // section titles
gfx_setfont(6, "Arial", (12*sc) * max(ui_tf, 1));        // small text
gfx_setfont(7, "Arial", (15*sc) * max(ui_tf, 1), 'b');   // voice names

function colx(h, a) ( gfx_r = ((h >> 16) & 255)/255; gfx_g = ((h >> 8) & 255)/255; gfx_b = (h & 255)/255; gfx_a = a; );
function X(x) ( ox + x*sc );
function Y(y) ( oy + y*sc );
function ctext(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x - w*0.5; gfx_y = y - h*0.5; gfx_drawstr(s); );
function ltext(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x; gfx_y = y - h*0.5; gfx_drawstr(s); );
function rtext(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x - w; gfx_y = y - h*0.5; gfx_drawstr(s); );
function inrect(x, y, w, h) ( mouse_x >= X(x) && mouse_x < X(x + w) && mouse_y >= Y(y) && mouse_y < Y(y + h) );
function rng_lo(i) ( i == 64 ? 0 : i >= 10 ? ((i - 10) % 9 == 0 ? -24 : (i - 10) % 9 == 7 ? -100 : 0) : i == 6 || i == 7 ? -100 : i == 9 ? -24 : 0 );
function rng_hi(i) ( i == 64 ? 7 : i >= 10 ? ((i - 10) % 9 == 0 ? 24 : 100) : i <= 3 ? (i == 3 ? 3 : 1) : i == 4 ? 75 : i == 9 ? 12 : 100 );
function defv(i) ( i >= 10 ? PRV[pr_cur*54 + i - 10] : i == 4 ? PRG[pr_cur*14 + 1] : i == 5 ? PRG[pr_cur*14 + 2] : i == 6 ? PRG[pr_cur*14 + 5] : i == 7 ? PRG[pr_cur*14 + 6] : i == 8 ? PRG[pr_cur*14 + 7] : 0 );
function setv(i, v) local(lo, hi) (
  lo = rng_lo(i); hi = rng_hi(i);
  slider(i) = clampv(v, lo, hi); slider_automate(2^(i - 1));
);

function fmtt(t) ( t < 1 ? sprintf(#vs, "%d ms", t*1000 + 0.5) : sprintf(#vs, "%.2f s", t) );
function fmtv(i, v) local(j, vv) (
  i >= 10 ? (
    j = (i - 10) % 9; vv = floor((i - 10)/9);
    j == 0 ? sprintf(#vs, "%+.1f st", v) :
    j == 3 && vv == 0 ? fmtt(0.005 + sqr(v/100)*0.15) :
    j == 3 && vv == 1 ? sprintf(#vs, "1 : %.2f", 1.4 + 3.3*v/100) :
    j == 5 ? fmtt(0.02*150^(v/100)) :
    j == 7 ? ( abs(v) < 0.5 ? strcpy(#vs, "C") : v < 0 ? sprintf(#vs, "L %d", -v + 0.5) : sprintf(#vs, "R %d", v + 0.5) ) :
    sprintf(#vs, "%d%%", v + 0.5);
  ) :
  i == 9 ? sprintf(#vs, "%+.1f dB", v) :
  sprintf(#vs, "%d%%", v + 0.5);
);

// cap: 0 charcoal, 1 amber, 2 burnt orange, 3 cream
function knob(i, x, y, r, cap, lab) local(cx, cy, rr, v, mn, mx, t, hov, a0, a1, av, pc, px, py) (
  cx = X(x); cy = Y(y); rr = r*sc;
  mn = rng_lo(i); mx = rng_hi(i); v = slider(i);
  hov = sqr(mouse_x - cx) + sqr(mouse_y - cy) < sqr(rr + 6*sc);
  click && hov ? (
    (mouse_cap & 4) || (time_precise() - lastclk < 0.3 && lastk == i) ? ( setv(i, defv(i)); drag = 0; lastk = -1; ) :
    ( drag = i; dy0 = mouse_y; v0 = v; lastclk = time_precise(); lastk = i; );
  );
  hov && mouse_wheel != 0 && !wheeled ? ( setv(i, v + sign(mouse_wheel)*(mx - mn)*((mouse_cap & 8) ? 0.002 : 0.01)); wheeled = 1; );
  drag == i && lmb ? setv(i, v0 + (dy0 - mouse_y)/(((mouse_cap & 8) ? 900 : 220)*sc)*(mx - mn));
  v = slider(i); t = (v - mn)/(mx - mn);
  a0 = -2.356; a1 = 2.356; av = a0 + t*(a1 - a0);
  colx(0x1C1C1E, 1); ui_ssarc(cx, cy, rr + 4.5*sc, a0, a1, 2.6*sc);
  colx(0xF0A830, 0.95);
  mn < 0 ? ( av > 0.003 ? ui_ssarc(cx, cy, rr + 4.5*sc, 0, av, 2.6*sc) : av < -0.003 ? ui_ssarc(cx, cy, rr + 4.5*sc, av, 0, 2.6*sc); ) :
           t > 0.002 ? ui_ssarc(cx, cy, rr + 4.5*sc, a0, av, 2.6*sc);
  colx(0x141415, 0.55); gfx_circle(cx + 1*sc, cy + 1.5*sc, rr, 1, 1);
  cap == 1 ? colx(0xE2A23C, 1) : cap == 2 ? colx(0xBF5A22, 1) : cap == 3 ? colx(0xD9D2C2, 1) : colx(0x434346, 1);
  gfx_circle(cx, cy, rr, 1, 1);
  colx(0xFFFFFF, cap == 0 ? 0.16 : 0.32); gfx_arc(cx, cy, rr - 1*sc, -1.9, -0.7, 1);
  colx(0x000000, 0.25); gfx_arc(cx, cy, rr - 0.5*sc, 1.2, 2.4, 1);
  pc = cap == 0 || cap == 2 ? 0xF2EBDD : 0x1E1E20; colx(pc, 1);
  px = sin(av); py = -cos(av);
  ui_ssline(cx + px*rr*0.28, cy + py*rr*0.28, cx + px*rr*0.84, cy + py*rr*0.84, max(1.6, 2.6*sc), 1);
  gfx_setfont(1);
  (hov || drag == i) ? ( fmtv(i, v); colx(0xF4C46A, 1); ctext(cx, cy + rr + 14*sc, #vs); ) :
                       ( colx(0xE8E2D4, 0.85); ctext(cx, cy + rr + 14*sc, lab); );
);

function keyb(x, y, w, h, lit) local(c) (
  c = click && inrect(x, y, w, h);
  lit ? (
    colx(0xF0A830, 0.2); gfx_rect(X(x - 2), Y(y - 2), (w + 4)*sc, (h + 4)*sc);
    colx(0xE79A2A, 1); gfx_rect(X(x), Y(y), w*sc, h*sc);
    colx(0xFFE2A8, 0.7); gfx_line(X(x), Y(y), X(x + w) - 1, Y(y));
  ) : (
    colx(0x47474A, 1); gfx_rect(X(x), Y(y), w*sc, h*sc);
    colx(0x5A5A5E, 1); gfx_line(X(x), Y(y), X(x + w) - 1, Y(y));
    colx(0x1E1E20, 1); gfx_line(X(x), Y(y + h) - 1, X(x + w) - 1, Y(y + h) - 1);
  );
  c;
);
function keyt(x, y, w, h, lit, lab) local(c) (
  c = keyb(x, y, w, h, lit);
  gfx_setfont(3); lit ? colx(0x1E1E20, 1) : colx(0xE8E2D4, 0.85);
  ctext(X(x + w*0.5), Y(y + h*0.5), lab);
  c;
);

function recess(x, y, w, h, shade, title) local(d, x1, y1, x2, y2) (
  d = 6*sc; x1 = X(x); y1 = Y(y); x2 = X(x + w); y2 = Y(y + h);
  colx(0x1F1F21, 1); gfx_triangle(x1, y1, x2, y1, x2 - d, y1 + d, x1 + d, y1 + d);
  colx(0x242426, 1); gfx_triangle(x1, y1, x1 + d, y1 + d, x1 + d, y2 - d, x1, y2);
  colx(0x46464A, 1); gfx_triangle(x1, y2, x1 + d, y2 - d, x2 - d, y2 - d, x2, y2);
  colx(0x3E3E42, 1); gfx_triangle(x2, y1, x2, y2, x2 - d, y2 - d, x2 - d, y1 + d);
  shade == 0 ? colx(0x2E2E31, 1) : shade == 1 ? colx(0x323235, 1) : colx(0x36363A, 1);
  gfx_rect(x1 + d, y1 + d, x2 - x1 - 2*d, y2 - y1 - 2*d);
  title != 0 ? ( gfx_setfont(5); colx(0xC8561E, 0.95); ltext(X(x + 14), Y(y + 18), title); );
);

function vname(v) ( v == 0 ? "KICK" : v == 1 ? "SNARE" : v == 2 ? "TOM 1" : v == 3 ? "TOM 2" : v == 4 ? "METAL" : "BURST" );
function cname(v) ( v == 0 ? "SWEEP" : v == 1 ? "RATIO" : v <= 3 ? "LOOP" : v == 4 ? "SPREAD" : "RESO" );
function sx(v) ( v < 3 ? 16 + v*144 : 736 + (v - 3)*144 );

// a voice strip
function strip(v) local(x, b, cx1, cx2, hl) (
  x = sx(v); b = 10 + v*9;
  recess(x, 62, 140, 396, v & 1 ? 1 : 2, 0);
  // the name: click = choose (scope) and hear it
  hl = HL[v];
  sel == v ? ( colx(0xF0A830, 0.12); gfx_rect(X(x + 8), Y(70), 124*sc, 28*sc); );
  gfx_setfont(7); colx(sel == v ? 0xF0A830 : 0xE8E2D4, sel == v ? 1 : 0.85);
  ltext(X(x + 14), Y(84), sprintf(#vt, "%d  %s", v + 1, vname(v)));
  colx(0xC8561E, 0.25 + 0.75*hl); gfx_circle(X(x + 122), Y(84), 5*sc, 1, 1);
  colx(0xFF8A3D, 0.35*hl); gfx_circle(X(x + 122), Y(84), 9*sc, 1, 1);
  click && inrect(x + 6, 68, 128, 32) ? ( sel = v; aud = v + 1; );
  cx1 = x + 38; cx2 = x + 102;
  knob(b + 0, cx1, 136, 17, 1, "TUNE");
  knob(b + 1, cx2, 136, 17, 1, "SNAP");
  knob(b + 2, cx1, 206, 17, 2, "FOLD");
  knob(b + 3, cx2, 206, 17, 2, cname(v));
  knob(b + 4, cx1, 276, 17, 3, "STRIKE");
  knob(b + 5, cx2, 276, 17, 3, "DECAY");
  knob(b + 6, cx1, 346, 17, 0, "FM");
  knob(b + 7, cx2, 346, 17, 0, "PAN");
  knob(b + 8, cx1, 416, 17, 0, "LEVEL");
  keyt(x + 78, 402, 48, 28, hl > 0.5, "HIT") ? ( aud = v + 1; sel = v; );
);

// the fold scope: the chosen voice's folded wave (live while it sounds) and its gate's decay curve
function scope() local(cx, cy, r, d, act, n, st, i, j, x, y, px, py, t, c, gg, fo, a, xs, amp, yc, sp, gsel, M, k, yb, hh) (
  cx = X(590); cy = Y(196); r = 116*sc;
  d = VS + sel*64; act = d[0];
  gsel = d[1];
  colx(0x19191A, 1); gfx_circle(cx, cy, r + 10*sc, 1, 1);
  colx(0x4A4A4E, 1); ui_ssarc(cx, cy, r + 6*sc, -$pi, $pi, 2*sc);
  colx(0x0F0F10, 1); gfx_circle(cx, cy, r, 1, 1);
  // graticule
  colx(0xF0A830, 0.07); gfx_circle(cx, cy, r*0.5, 0, 1); gfx_circle(cx, cy, r*0.82, 0, 1);
  gfx_line(cx - r*0.92, cy, cx + r*0.92, cy); gfx_line(cx, cy - r*0.92, cx, cy + r*0.92);
  // the gate's glow round the rim
  colx(0xC8561E, 0.12 + 0.88*min(1, gsel*1.3)); ui_ssarc(cx, cy, r - 5*sc, -$pi, $pi, 4*sc);
  gfx_setfont(5); colx(0xF0A830, 0.9); ctext(cx, cy - r*0.7, vname(sel));
  // the wave
  M = 150; xs = r*0.78; amp = r*0.3; yc = cy - r*0.12;
  fo = clampv(vp(sel, 2)/100 + slider6/200, 0, 1.3); gg = 1 + fo*(sel == 0 ? 3 : sel == 4 ? 7 : 5.5);
  c = vp(sel, 3)/100;
  act && scf > 1 ? (
    n = clampv(floor(2*srate/scf), 64, 900);
    st = scw - n; j = 0;
    while (j < n && !(SCB[(st - j - 1) & 1023] < 0 && SCB[(st - j) & 1023] >= 0)) ( j += 1; );
    st = j < n ? st - j : st;
  );
  i = 0;
  loop(M + 1,
    act && scf > 1 ? (
      y = SCB[(st + floor(i*n/M)) & 1023];
    ) : (
      t = i/M*2;
      sel == 0 ? x = sin(2*$pi*t) :
      sel == 1 ? x = sin(2*$pi*t + 3*sin(2*$pi*t*(1.4 + 3.3*c))) :
      sel <= 3 ? x = tri(t)*0.75 + tri(t*1.593)*0.3 :
      sel == 4 ? ( sp = 0.4 + 1.2*c; x = (sign(sin(2*$pi*t))*sign(sin(2*$pi*t*(1 + 0.483*sp))) + sign(sin(2*$pi*t*(1 + 0.932*sp)))*sign(sin(2*$pi*t*(1 + 1.546*sp))))*0.45; ) :
      x = 0.6*sin(2*$pi*t) + 0.3*sin(2*$pi*t*7.31 + 2*sin(2*$pi*t*3.1));
      y = sin(1.5707963*x*gg);
    );
    px = cx - xs + 2*xs*i/M; py = yc - clampv(y, -1.2, 1.2)*amp;
    i > 0 ? ( colx(0xF0A830, 0.95); gfx_line(lx, ly, px, py, 1); gfx_line(lx, ly + 0.8*sc, px, py + 0.8*sc, 1); );
    lx = px; ly = py;
    i += 1;
  );
  // the gate's decay curve (last ~2 s)
  yb = cy + r*0.66; hh = r*0.3;
  colx(0xE8E2D4, 0.12); gfx_line(cx - r*0.7, yb, cx + r*0.7, yb);
  k = 0;
  loop(200,
    a = ENVH[(eh_p + 1 + k) % 200];
    px = cx - r*0.7 + 1.4*r*k/199; py = yb - min(1, a)*hh;
    k > 0 ? ( colx(0xC8561E, 1); gfx_line(lx, ly, px, py, 1); gfx_line(lx, ly - 0.8*sc, px, py - 0.8*sc, 1); );
    lx = px; ly = py; k += 1;
  );
  gfx_setfont(6); colx(0xE8E2D4, 0.45); ctext(cx, cy + r*0.83, "GATE");
);

// a voltage strip (touch plate): click or drag anywhere on it; double-click = centre
function vstrip(i, x, y, w, h, lab) local(v, t, cx, hov, k) (
  gfx_setfont(5); colx(0xE8E2D4, 0.8); ltext(X(32), Y(y + h*0.5), lab);
  hov = inrect(x, y, w, h);
  click && hov ? (
    time_precise() - lastclk < 0.3 && lastk == 1000 + i ? ( setv(i, 0); lastk = -1; ) : ( sdrag = i; lastclk = time_precise(); lastk = 1000 + i; );
  );
  sdrag == i && lmb ? setv(i, ((mouse_x - X(x))/(w*sc)*2 - 1)*100);
  hov && mouse_wheel != 0 && !wheeled ? ( setv(i, slider(i) + sign(mouse_wheel)*2); wheeled = 1; );
  v = slider(i)/100; cx = x + w*0.5;
  colx(0x161617, 1); gfx_rect(X(x), Y(y), w*sc, h*sc);
  colx(0x000000, 0.6); gfx_line(X(x), Y(y), X(x + w), Y(y)); gfx_line(X(x), Y(y), X(x), Y(y + h));
  k = 0; loop(21, colx(0xE8E2D4, k == 10 ? 0.35 : 0.1); gfx_line(X(x + w*k/20), Y(y + 3), X(x + w*k/20), Y(y + (k == 10 ? h - 3 : 9))); k += 1; );
  t = cx + v*w*0.5;
  colx(0xF0A830, 0.28); gfx_rect(X(min(cx, t)), Y(y + 6), abs(t - cx)*sc, (h - 12)*sc);
  colx(0xF0A830, 0.18); gfx_rect(X(t - 9), Y(y + 2), 18*sc, (h - 4)*sc);
  colx(0xF0A830, 1); gfx_rect(X(t - 2), Y(y + 2), 4*sc, (h - 4)*sc);
  (hov || sdrag == i) ? ( gfx_setfont(1); colx(0xF4C46A, 1); rtext(X(x - 10), Y(y + h*0.5), sprintf(#vs, "%+d%%", slider(i))); );
);

// ===================== draw =====================
colx(0x232325, 1); gfx_rect(0, 0, gfx_w, gfx_h);
colx(0x2B2B2D, 1); gfx_rect(X(0), Y(0), W0*sc, H0*sc);
colx(0xFFFFFF, 0.018); gk = 0; loop(200, gfx_line(X(0), Y(gk*4), X(W0) - 1, Y(gk*4)); gk += 1; );
colx(0xC8561E, 0.35); gfx_rect(X(6), Y(6), (W0 - 12)*sc, 2*sc); gfx_rect(X(6), Y(H0 - 8), (W0 - 12)*sc, 2*sc);

// header
gfx_setfont(4); colx(0xE8E2D4, 0.9); ltext(X(24), Y(34), "GFX");
gfx_setfont(6); colx(0xF0A830, 0.7); ltext(X(70), Y(35), "WEST COAST PERCUSSION");
gfx_setfont(2); colx(0xF0A830, 1); ctext(X(590), Y(34), "B U R L"); ver_tag("v3", 16, 0, 0);
keyt(832, 21, 74, 26, 0, "PRESETS") ? open_menu = 1;
keyt(910, 21, 28, 26, 0, "<") ? ( pr_cur = (pr_cur + NPRE - 1) % NPRE; prs_dirty = pr_cur + 1; );
keyt(942, 21, 28, 26, 0, ">") ? ( pr_cur = (pr_cur + 1) % NPRE; prs_dirty = pr_cur + 1; );
colx(0x141415, 1); gfx_rect(X(974), Y(19), 190*sc, 30*sc);
colx(0x000000, 0.6); gfx_line(X(974), Y(19), X(1164), Y(19)); gfx_line(X(974), Y(19), X(974), Y(49));
gfx_setfont(4); colx(0xF4B44E, 1); ctext(X(1069), Y(34), pname(pr_cur));
click && inrect(974, 19, 190, 30) ? open_menu = 1;

// hit lights
gk = 0; loop(6, HL[gk] = max(HL[gk]*0.82, HIT[gk]); HIT[gk] = 0; gk += 1; );

// voices
gk = 0; loop(6, strip(gk); gk += 1; );

// centre: scope + uncertainty
recess(448, 62, 284, 396, 0, 0);
scope();
gfx_setfont(5); colx(0xC8561E, 0.95); ltext(X(462), Y(366), "UNCERTAINTY GENERATOR");
knob(5, 486, 414, 18, 2, "AMOUNT");
tg = slider64|0;
keyt(524, 404, 62, 26, tg & 1, "PITCH") ? setv(64, tg ~ 1);
keyt(592, 404, 62, 26, tg & 2, "FOLD") ? setv(64, tg ~ 2);
keyt(660, 404, 62, 26, tg & 4, "DECAY") ? setv(64, tg ~ 4);
keyt(660, 372, 62, 26, ulock, "LOCK") ? ulock = !ulock;

// sequencer
recess(16, 464, 1148, 222, 1, "SEQUENCER");
keyt(28, 498, 60, 28, slider1 >= 0.5, "RUN") ? setv(1, slider1 >= 0.5 ? 0 : 1);
keyt(94, 498, 60, 28, slider2 >= 0.5, "SYNC") ? setv(2, slider2 >= 0.5 ? 0 : 1);
gfx_setfont(6); colx(0xE8E2D4, 0.55); ltext(X(30), Y(542), "PATTERN");
// the pattern playing is lit; the next one (chosen while running) flashes until it takes over at the bar
gk = 0; loop(4, gq = sq_on && (slider3|0) == gk && sq_pat != gk;
  keyt(28 + gk*32, 552, 28, 26, gq ? (time_precise() * 4 % 2) < 1 : (sq_on ? sq_pat == gk : (slider3|0) == gk), gk == 0 ? "A" : gk == 1 ? "B" : gk == 2 ? "C" : "D") ? setv(3, gk); gk += 1; );
keyt(28, 588, 124, 22, 0, "CLEAR") ? ( memset(PAT + (slider3|0)*96, 0, 96); );
knob(4, 92, 640, 17, 0, "SWING");
// the grid
gp = slider3|0;
gk = 0;
loop(16,
  gx = 266 + gk*52;
  colx(0xF0A830, gk == sq_step ? 1 : 0.12); gfx_circle(X(gx + 24), Y(487), 4*sc, 1, 1);
  gk % 4 == 0 ? ( gfx_setfont(6); colx(0xE8E2D4, 0.4); ltext(X(gx + 2), Y(487), sprintf(#vs, "%d", gk + 1)); );
  gk += 1;
);
gfx_setfont(6); colx(0xE8E2D4, 0.55); ctext(X(1127), Y(487), "LENGTH");
gv = 0;
loop(6,
  gy = 498 + gv*30;
  gfx_setfont(1); colx(sel == gv ? 0xF0A830 : 0xE8E2D4, sel == gv ? 1 : 0.8); rtext(X(256), Y(gy + 13), vname(gv));
  gln = LEN[gp*6 + gv]; gln = gln < 1 ? 16 : min(gln, 16);
  gcur = sq_step >= 0 ? sq_k % gln : -1;
  // LENGTH: click for the list (1 - 16)
  keyt(1104, gy, 46, 26, 0, sprintf(#vl, "%d", gln)) ? (
    strcpy(#menu, ""); gk = 1;
    loop(16, gk > 1 ? strcat(#menu, "|"); gk == gln ? strcat(#menu, "!"); strcat(#menu, sprintf(#vl, "%d", gk)); gk += 1; );
    gfx_x = X(1104); gfx_y = Y(gy + 28); gk = gfx_showmenu(#menu);
    gk > 0 ? LEN[gp*6 + gv] = gk;
  );
  gk = 0;
  loop(16,
    gx = 266 + gk*52;
    gc = PAT[(gp*6 + gv)*16 + gk];
    hv = inrect(gx, gy, 48, 26);
    // click cycles the step; dragging paints the same state along the row; right-click clears
    click && hv ? ( gc = gc == 0 ? 1 : gv == 4 ? (gc == 1 ? 3 : 0) : (gc == 1 ? 2 : 0); PAT[(gp*6 + gv)*16 + gk] = gc; gpaint = gc; gprow = gv; ) :
    lmb && hv && gpaint >= 0 && gprow == gv ? ( PAT[(gp*6 + gv)*16 + gk] = gpaint; gc = gpaint; );
    rclick && hv ? ( PAT[(gp*6 + gv)*16 + gk] = 0; gc = 0; );
    // past the lane's length: drawn dim (still editable)
    gdim = gk >= gln;
    gdim ? colx(0x2A2A2C, 1) : floor(gk/4) & 1 ? colx(0x3A3A3E, 1) : colx(0x434347, 1);
    gc == 0 ? gfx_rect(X(gx), Y(gy), 48*sc, 26*sc) : (
      gdim ? colx(0x5A4A32, 1) : gc == 2 ? colx(0xF0A830, 1) : gc == 3 ? colx(0xC8561E, 1) : colx(0xA8752A, 1);
      gfx_rect(X(gx), Y(gy), 48*sc, 26*sc);
      gc == 2 ? ( colx(0xFFE6B0, 0.8); gfx_rect(X(gx), Y(gy), 48*sc, 2*sc); );
      gc == 3 ? ( gfx_setfont(3); colx(0x1E1E20, 1); ctext(X(gx + 24), Y(gy + 13), "OPEN"); );
    );
    gk == gcur ? ( colx(0xFFFFFF, 0.16); gfx_rect(X(gx), Y(gy), 48*sc, 26*sc); );
    gk += 1;
  );
  gv += 1;
);

// voltage strips
recess(16, 692, 860, 124, 2, 0);
gfx_setfont(5); colx(0xC8561E, 0.95); ltext(X(30), Y(708), "VOLTAGE STRIPS");
vstrip(6, 116, 718, 744, 36, "FOLD");
vstrip(7, 116, 766, 744, 36, "DECAY");
// drift + output
recess(882, 692, 282, 124, 1, 0);
knob(8, 944, 750, 20, 0, "DRIFT");
knob(9, 1060, 746, 26, 3, "OUTPUT");
opg += (min(1, opk*1.4) - opg)*0.3;
colx(0xF0A830, 0.15 + 0.85*opg); gfx_circle(X(1118), Y(746), 5*sc, 1, 1);
colx(0xF0A830, 0.3*opg); gfx_circle(X(1118), Y(746), 10*sc, 1, 1);

wheeled ? mouse_wheel = 0;

// preset list
open_menu ? (
  open_menu = 0;
  strcpy(#menu, ""); gk = 0;
  loop(NPRE, gk > 0 ? strcat(#menu, "|"); gk == pr_cur ? strcat(#menu, "!"); strcat(#menu, pname(gk)); gk += 1; );
  gfx_x = X(974); gfx_y = Y(51);
  gk = gfx_showmenu(#menu);
  gk > 0 ? ( prs_dirty = gk; pr_cur = gk - 1; );
);
// audio not running: apply the preset from here
pending >= 0 && time_precise() - pend_t > 0.25 ? ( load_preset(pending); gk = 0; loop(6, v_ctl(gk); gk += 1; ); pending = -1; vf = 1; );

plmb = lmb; prmb = rmb;
