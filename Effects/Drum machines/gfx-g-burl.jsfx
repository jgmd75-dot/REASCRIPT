slider64:7<0,7,1>-Uncertainty targets (1 pitch + 2 fold + 4 decay)
slider65:prs_sel=0<0,18,1{No preset,Burl Grain,Bongo Ping,Fold Engine,Laser Clave,Vactrol Rain,Industrial Scrape,Metal Rite,Sluggish Gate,Oak Knot,Ringing Hollow,Zap Ritual,Dead Reckoning,Polymeter Grove,Tangle Root,Fold Storm,Slow Vactrol,Seven Against Five,Warm Optocouplers}>-Preset

options:gfx_hz=60

@init
ext_noinit = 1;
NPRE = 18;
NV = 6;
// ---- memory ----
PAT  = 10000;   // 4 patterns x 6 rows x 16 steps (0 off, 1 hit, 2 accent, 3 open)
UNC  = 11000;   // 16 steps x 6 voices x 3 (pitch, fold, decay)
EVO  = 12000; EVV = 12300; EVL = 12600; EVK = 12900;   // block events (256)
SCB  = 14000;   // the scope's capture ring (1024)
ENVH = 16000;   // the gate's history (200)
VS   = 17000;   // voice state, 6 x 64
PRV  = 20000;   // preset voice values, 12 x 54
PRG  = 21000;   // preset globals (14 each): bank, swing, uncertainty, targets, lock, fold strip, decay strip, drift, 6 lane lengths
BANK = 30000;   // pattern banks, 6 x 384
HIT  = 24000;   // the panel's hit lights
CNT  = 24100;   // per-voice hit counters (MIDI, when the sequencer is stopped)
WLK  = 24200;   // drift walks: 6 x 3
HL   = 24300;   // the panel's hit glow
LEN  = 24400;   // each lane's length, 4 patterns x 6 lanes (1 - 16)
memset(VS, 0, 6*64); memset(HIT, 0, 8); memset(CNT, 0, 8); memset(WLK, 0, 18); memset(SCB, 0, 1024); memset(ENVH, 0, 200);

BASEF0 = 48; BASEF1 = 185; BASEF2 = 196; BASEF3 = 131; BASEF4 = 330; BASEF5 = 520;
function basef(v) ( v == 0 ? 48 : v == 1 ? 185 : v == 2 ? 196 : v == 3 ? 131 : v == 4 ? 330 : 520 );
function vnorm(v) ( v == 0 ? 0.6 : v == 1 ? 0.6 : v == 2 ? 0.6 : v == 3 ? 0.6 : v == 4 ? 0.5 : 0.75 );
function clampv(x, a, b) ( x < a ? a : x > b ? b : x );
function vp(v, j) ( slider(10 + v*9 + j) );

// ---- pattern banks / presets ----
function bk_row(b, p, r, s) local(i) ( i = 0; loop(16, BANK[b*384 + (p*6 + r)*16 + i] = str_getchar(s, i) == 'x' ? 1 : str_getchar(s, i) == 'X' ? 2 : str_getchar(s, i) == 'o' ? 3 : 0; i += 1; ); );
bk_row(0, 0, 0, "X.....x...x.....");
bk_row(0, 0, 1, "....X.......X...");
bk_row(0, 0, 2, "..x.....x.....x.");
bk_row(0, 0, 3, ".....x.......x..");
