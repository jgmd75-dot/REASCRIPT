slider35:-35<-100,100,1>-Tom 1 Pan
slider36:65<0,100,0.1>-Tom 1 Level
slider37:0<-24,24,0.1>-Tom 2 Tune (st)
slider38:30<0,100,0.1>-Tom 2 Snap
slider39:10<0,100,0.1>-Tom 2 Fold
slider40:35<0,100,0.1>-Tom 2 Character
