sg_knob(178, 690, 21, 26, 0, 95, 45, 0, "FEEDBACK", "%.0f%%", 0, 0);
sg_knob(250, 690, 21, 27, 0, 100, 40, 0, "SMEAR", "%.0f%%", 0, 0);
sg_knob(322, 690, 21, 28, 0, 100, 55, 0, "TONE", "%.0f%%", 0, 0);
sg_knob(394, 690, 21, 29, 0, 100, 25, 0, "MIX", "%.0f%%", 0, 0);
sg_sect(452, 614, 250, 146, "CHORUS");
sg_toggle(628, 616, 66, 20, 30, "IN");
sg_knob(500, 690, 21, 31, 0.05, 5, 0.35, 1, "RATE", "%.2f Hz", 0, 0);
sg_knob(577, 690, 21, 32, 0, 100, 45, 0, "DEPTH", "%.0f%%", 0, 0);
sg_knob(654, 690, 21, 33, 0, 100, 35, 0, "MIX", "%.0f%%", 0, 0);
sg_sect(712, 614, 180, 146, "WIDTH");
sg_toggle(818, 616, 66, 20, 34, "IN");
sg_knob(802, 680, 23, 35, 0, 200, 100, 0, "SIDE", "%.0f%%", 0, 0);
gfx_setfont(11); ui_col(LBL); sg_tc(802, 740, "MONO BELOW 150 HZ");
