sg_toggle(1104, 616, 66, 20, 36, "IN");
sg_knob(980, 690, 21, 37, 0, 100, 60, 0, "SIZE", "%.0f%%", 0, 0);
sg_knob(1100, 690, 21, 38, 0, 100, 25, 0, "MIX", "%.0f%%", 0, 0);

// ======================== the foot of the card: FATE, VOLUME, LEVEL, the name between two suns, SAT, the level ========================
ui_col(INK); sg_r(13, 768, 1174, 2);
ui_col(BRZD); sg_r(13, 770, 1174, 67);
sg_knob(48, 803, 13, 39, 0, 100, 50, 0, "", "%.0f%%", 0, 0);
drag_id != 2039 && !(sqr(mouse_x - 48 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(AMB); sg_t(70, 794, "FATE"); );
sg_knob(146, 803, 13, 40, -24, 6, -3, 0, "", "%+.1f dB", 0, 0);
drag_id != 2040 && !(sqr(mouse_x - 146 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(AMB); sg_t(168, 794, "VOLUME"); );
sg_knob(266, 803, 13, 41, 0, 100, 60, 0, "", "%.0f%%", 0, 0);
drag_id != 2041 && !(sqr(mouse_x - 266 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(AMB); sg_t(288, 794, "LEVEL"); );
// the name plate, between two suns
ui_col(INK); sg_rr(430, 781, 340, 44, 5); ui_col(FACEL); sg_rr(432, 783, 336, 40, 4);
ui_col(AMBD); sg_r(440, 818, 320, 1.5);
