in_pin:input L
in_pin:input R
in_pin:listen (sidechain) L
in_pin:listen (sidechain) R
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-sun";                                     // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
SUDEF = 1000; SUTMP = 1200;                                // the Init values; the preset parser's scratch (panel only)
SUSC  = 2000;                                              // the scales: 14 x 8 (how many notes, then the pitch classes)
SUHN  = 2200; SUHV = 2340;                                 // the keys held, in the order played, and their velocities
SURG  = 3000;                                              // the seven rings: 40 slots each (see below)
SUVO  = 3400;                                              // the 21 ring voices: 32 slots each (three to a ring)
SUTN  = 4100;                                              // a ring's tones (scratch)
SUHI  = 4200;                                              // LISTEN (audio): the twelve pitch-class votes
SUYD  = 5000;                                              // LISTEN (audio): YIN's difference function (320)
SUSE  = 4220;                                              // the strings now, for the panel: 5 x 4 (level, note, pluck)
SUSP  = 4250; SUSQ = 4270;                                 // the strings' pan gains: targets, now (5 x 2)
SUSB  = 10000; SUSBN = 8192; SUSBM = 8191;                 // the five string lines
SUSCP = 60000; SUSCN = 4096; SUSCM = 4095;                 // the scope: the tanpura (every 2nd sample), and x / y
SUSCX = 64096; SUSCY = 68192;
SUPD  = 72300; SUPDN = 2048; SUPDM = 2047;                 // LISTEN (audio): the decimated input
SUCL  = 80000; SUCR = 88192; SUCHM = 8191;                 // the chorus lines
SUTL  = 100000; SUTLN = 16384; SUTLM = 16383;              // the tail: four lines
SUTA  = 170000; SUTAN = 2048; SUTAM = 2047;                // the tail's two input all-passes
SUSM  = 180000; SUSMN = 8192; SUSMM = 8191;                // the smear: eight all-passes
SUDL  = 300000; SUDR = 824288; SUDLM = 524287;             // the delay lines (2^19 each)
memset(SURG, 0, 7 * 40); memset(SUVO, 0, 21 * 32); memset(SUHI, 0, 12); memset(SUSE, 0, 20);
memset(SUSB, 0, 5 * SUSBN); memset(SUSCP, 0, 3 * SUSCN); memset(SUPD, 0, SUPDN);
memset(SUCL, 0, 2 * 8192); memset(SUTL, 0, 4 * SUTLN); memset(SUTA, 0, 2 * SUTAN); memset(SUSM, 0, 8 * SUSMN);
memset(SUDL, 0, 524288 * 2);
// ring slots (q = SURG + 40 * r): 0 on  2 level (target)  3 gain now  4 / 5 / 6 / 7 attack, decay, sustain, release
//   8 timbre  9 pan  11 scale  12 transpose  13 interval (st)  14 pattern  15 step (beats)  16 notes  17 next step (beats)
//   18 rate index  26 voices alive  27 / 28 FM index (held / struck)  29 bell  30 / 31 the indexes with FATE's tide
// voice slots (v = SUVO + 32 * i, ring = floor(i / 3)): 0 state (0 free, 1 attack, 2 decay / sustain, 3 release,
//   4 fading out for a new note)  1 level  2 / 3 phase, increment  4 / 5 the bell partial's  6 strike  7 velocity
//   8 gate (samples)  10 note  11 fade gain  12 / 13 / 14 / 15 the waiting note, velocity, gate, pan
//   16 / 17 pan gains  18 age  19 bell on
L12 = log(2) / 12; TWOPI = 2 * $pi;

// ---------- the scales ----------
function su_scale(i, n, a, b, c, d, e, f, g) local(q) (
  q = SUSC + i * 8; q[0] = n; q[1] = a; q[2] = b; q[3] = c; q[4] = d; q[5] = e; q[6] = f; q[7] = g;
);
su_scale(0, 7, 0, 2, 4, 5, 7, 9, 11);                     // Major (Ionian, Bilawal)
su_scale(1, 7, 0, 2, 3, 5, 7, 9, 10);                     // Dorian
su_scale(2, 7, 0, 1, 3, 5, 7, 8, 10);                     // Phrygian
su_scale(3, 7, 0, 2, 4, 6, 7, 9, 11);                     // Lydian
su_scale(4, 7, 0, 2, 4, 5, 7, 9, 10);                     // Mixolydian
su_scale(5, 7, 0, 2, 3, 5, 7, 8, 10);                     // Aeolian
su_scale(6, 7, 0, 1, 3, 5, 6, 8, 10);                     // Locrian
su_scale(7, 7, 0, 2, 3, 5, 7, 8, 11);                     // Harmonic minor
su_scale(8, 7, 0, 1, 4, 5, 7, 8, 11);                     // Bhairav
su_scale(9, 7, 0, 2, 4, 6, 7, 9, 11);                     // Yaman (the Kalyan thaat)
su_scale(10, 7, 0, 2, 3, 5, 7, 9, 10);                    // Kafi
su_scale(11, 7, 0, 1, 3, 5, 7, 8, 10);                    // Bhairavi
su_scale(12, 5, 0, 2, 4, 7, 9, 0, 0);                     // Pentatonic major
su_scale(13, 5, 0, 3, 5, 7, 10, 0, 0);                    // Pentatonic minor
// scale s, degree d (any integer; 0 = Sa) to semitones from Sa
function su_d2s(s, d) local(q, n, o) ( q = SUSC + s * 8; n = q[0]; o = floor(d / n); q[1 + d - o * n] + 12 * o; );

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#su_def = "0 0 55 50 9 1.4 0 1 25 70 60 0 2 0 3 -45 0 4 0 85 30 50 70 1 6 45 40 55 25 1 0.35 45 35 1 140 1 60 25 50 -3 60 0 0 30 120 6000 -0.3 1 1 60 15 900 35 1600 55 -35 0 0 0 0 4 5 0 55 500 2500 70 3000 30 35 0 2 2 5 3 5 0 45 3 1200 0 2600 88 10 0 4 4 7 6 7 0 50 1800 3000 80 4000 20 -55 0 7 7 4 1 5 1 55 1400 3000 75 4200 25 25 0 0 0 4 2 5 0 50 30 1500 30 2200 60 55 0 2 3 2 7 4 0 45 900 2500 60 5000 10 -20 0 7 7 1 0 3 0 1000 100 20000 20000 0 0 2 900 20 1500 1";
function su_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
su_nums(#su_def, SUDEF);
#su_pm = "Init|Dawn Raga|Midday Radiance|Saffron Drone|Corona|Solar Wind|Bhairav Morning|Golden Hour|Seven Rays|Zenith|Sunset Kafi|Eternal Noon";
su_npre = 12;
// rings: slider 49 + 14 r + (0 on, 1 level, 2 A, 3 D, 4 S, 5 R, 6 timbre, 7 pan, 8 scale, 9 transpose, 10 interval,
// 11 pattern, 12 rate, 13 notes)
function su_pstr(p) (
  p == 2  ? "3:60 6:1.6 17:11 20:70 60:2 61:4 62:6 55:45 51:40 52:1200 53:40 54:2200 50:50 77:1 78:35 83:90 88:7 89:6 117:1 107:2500 110:5000 111:15 106:50 133:1 134:45 144:1 145:0 146:3 139:10 27:50 37:70 38:30 41:62.8" :
  p == 3  ? "3:45 4:70 7:1 8:1 17:0 18:5 25:4 26:40 29:22 27:25 33:30 35:150 60:0 61:6 62:7 55:60 50:45 63:1 75:4 74:5 64:45 69:40 65:30 77:1 88:7 89:8 78:30 83:92 91:1 102:4 103:2 97:30 92:40 117:1 106:45 41:50.6" :
  p == 4  ? "3:85 5:16 6:1.8 4:40 10:80 9:35 37:80 38:35 29:15 49:0 116:4 117:0 106:35 111:10 107:4000 108:4000 109:85 110:6000 41:58.1" :
  p == 5  ? "17:3 3:50 20:60 25:5 26:70 27:85 29:40 28:45 37:70 38:35 60:0 61:6 55:95 50:40 62:7 51:3 52:1500 53:0 54:2500 63:1 74:6 75:7 69:85 64:35 65:3 66:1500 67:0 77:1 88:7 89:8 83:100 78:25 119:1 130:2 131:5 125:80 120:35 121:3 123:0 105:0 41:61.9" :
  p == 6  ? "17:1 31:1.2 32:75 33:55 35:185 7:1 8:3 25:4 26:50 29:25 60:6 61:8 62:7 55:55 50:40 51:5 52:400 53:20 54:600 63:1 74:2 75:6 76:6 69:45 64:40 119:1 130:1 131:7 125:60 120:35 117:2 106:40 41:59.5" :
  p == 7  ? "12:2 14:1 17:8 6:2 27:50 60:0 61:4 62:5 55:50 117:1 133:1 144:1 145:1 146:3 139:15 134:45 41:64.4" :
  p == 8  ? "17:4 37:75 38:35 33:40 60:0 61:3 55:25 51:300 52:2000 53:70 54:3000 50:50 63:1 74:5 75:2 69:20 65:1500 67:80 68:4000 64:45 91:1 102:4 103:1 97:15 93:2500 96:5000 92:45 117:2 111:25 106:45 41:57.6" :
  p == 9  ? "20:60 23:65 60:0 61:4 50:40 63:1 74:5 75:6 64:38 77:1 88:7 89:7 78:30 91:1 102:4 103:1 92:38 116:4 117:2 106:40 119:1 130:2 131:7 120:34 133:1 144:1 145:0 134:40 41:65.8" :
  p == 10 ? "2:4 17:12 18:7 4:75 12:2 14:2 25:4 27:60 26:55 35:170 60:0 61:6 55:90 50:40 51:3 52:1200 53:10 63:1 74:7 75:8 69:100 64:30 77:1 88:6 89:7 83:85 78:34 91:1 102:4 103:2 97:70 92:36 105:0 41:65.5" :
  p == 11 ? "2:1 17:10 6:1.8 27:70 26:55 28:40 29:30 60:2 61:4 55:30 50:45 117:1 111:15 119:1 130:1 131:6 125:40 120:30 41:61.1" :
  p == 12 ? "2:3 17:13 12:2 14:3 20:35 37:90 38:45 25:7 26:60 27:70 60:7 61:6 55:92 50:45 62:7 51:3 53:0 54:3000 77:1 88:7 89:4 83:88 78:40 133:1 144:4 145:0 139:10 134:40 105:0 41:65.1" :
  "";
);
function load_preset(p) local(n, i) (
  // PLAY, TRANSPORT, FATE, the MIDI channel and the output stage stay as they are (a preset never starts the Sun)
  i = 0; loop(158, ((i != 38 && i < 41) || i >= 48) && i != 0 && i != 157 ? slider(i + 1) = SUDEF[i]; i += 1; );
  n = su_nums(su_pstr(p), SUTMP);
  i = 0; loop(floor(n / 2), SUTMP[i * 2] >= 2 && SUTMP[i * 2] <= 157 ? slider(SUTMP[i * 2]) = SUTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(158, ui_auto(i); i += 1; );
  pr_cur = p; su_panic = 1;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(158, slider(i + 1) = SUDEF[i]; ui_auto(i + 1); i += 1; );
);

// ---------- divisions (in beats; su_bpb = beats a bar) ----------
function su_rbeats(i) ( i == 0 ? 4 * su_bpb : i == 1 ? 2 * su_bpb : i == 2 ? su_bpb : i == 3 ? 2 : i == 4 ? 1 : i == 5 ? 2 / 3 :
                        i == 6 ? 0.5 : i == 7 ? 1 / 3 : 0.25; );
function su_tbeats(i) ( i == 0 ? 0.5 : i == 1 ? 1 : i == 2 ? 1.5 : i == 3 ? 2 : i == 4 ? 3 : i == 5 ? su_bpb : 2 * su_bpb; );
function su_dbeats(i) ( i == 0 ? 0.25 : i == 1 ? 1 / 3 : i == 2 ? 0.5 : i == 3 ? 2 / 3 : i == 4 ? 0.75 : i == 5 ? 1 : i == 6 ? 1.5 :
                        i == 7 ? 2 : i == 8 ? 3 : su_bpb; );
function su_ivl(i) ( i == 0 ? 0 : i == 1 ? 3 : i == 2 ? 4 : i == 3 ? 5 : i == 4 ? 7 : i == 5 ? 8 : i == 6 ? 9 : 12; );
// the tuning: string k's offset from Sa (semitones); 4 or 5 strings
function su_toff(t, k) (
  k == 0 ? ( t == 0 || t == 4 ? -5 : t == 1 || t == 5 ? -7 : t == 2 ? -1 : 0 ) :
  t >= 4 ? ( k == 1 ? -1 : k == 4 ? -12 : 0 ) : ( k == 3 ? -12 : 0 );
);
// the unison strings are never quite in unison (cents / 100)
function su_tdet(k) ( k == 1 ? 0.012 : k == 2 ? -0.011 : k == 3 ? 0.005 : k == 4 ? -0.004 : 0; );

// ---------- a tanpura string: a waveguide on a curved (jawari) bridge ----------
// The line holds one period; a two-tap loop filter (BRIGHTNESS) and the loop gain (DECAY) shape its decay; where
// the string's swing passes the bridge's height (jb) it touches the bridge and is folded back (the buzz); a DC
// block keeps the loop centred. The jawari cloud: two broad, overlapping bands over the bridge-contact pulses.
function su_sinit() instance(w, dl, dlt, x1, dcx, dcy, jb, ei, en, ea, nz, b1, b2, ba1, ba2, ba3, bg, c1, c2, ca1, ca2, ca3, cg, hb, hd, tt, f, aref, env, g,
                             ae, ast, fe, fst, gt, l1, l2, la1, la2, la3) (
  w = 0; x1 = dcx = dcy = 0; jb = 10; ei = en = 1; ea = 0; nz = 0; b1 = b2 = 0; ba1 = 1; ba2 = ba3 = 0; bg = 0;
  c1 = c2 = 0; ca1 = 1; ca2 = ca3 = 0; cg = 0; hb = 7; hd = 0;
  tt = 100; aref = 0; env = 0; g = 0.99; f = 130; dl = dlt = 300;
  ae = 1; ast = 2; fe = 0; fst = 0; gt = 0; l1 = l2 = 0; la1 = 1; la2 = la3 = 0;
);
function su_str(buf) instance(w, dl, dlt, g, x1, dcx, dcy, jb, jm, jc, ei, en, ea, nz, b1, b2, ba1, ba2, ba3, bg, c1, c2, ca1, ca2, ca3, cg, env, ep,
                              ae, ast, l1, l2, la1, la2, la3)
                     local(rp, i0, fr, a, y, v, v1, v2, v3, u1, u2) (
  dl += (dlt - dl) * su_glk;
  // the jawari: where the string's swing passes the bridge's height it wraps onto the curved bridge, and its speaking
  // length shortens with it (the buzz: no energy is lost, it is thrown up into the harmonics)
  rp = w - dl + (x1 > jb ? min((x1 - jb) * jm, su_jcap) : 0);
  i0 = floor(rp); fr = rp - i0;
  a = buf[i0 & SUSBM]; y = a + (buf[(i0 + 1) & SUSBM] - a) * fr;
  v = g * (y + su_fs * (x1 - y)); x1 = y;
  dcy = v - dcx + su_dcr * dcy; dcx = v; v = dcy;
  abs(v) < 0.000000000001 ? v = dcy = 0;                    // (no denormals)
  ei < en ? (                                              // the pluck: a soft finger-pad shape with a little grit
    nz += (rand(2) - 1 - nz) * su_nzk;
    v += ea * (0.5 - 0.5 * cos(ei * TWOPI / en)) * (1 + nz * su_pn);
    ei += 1;
  );
  buf[w] = v; w = (w + 1) & SUSBM;
  // the cloud: the tips of each swing, where the string lies on the bridge, are narrow pulses full of harmonics; two
  // broad, overlapping bands (low Q: a timbre, not a pitch) lift a bright, buzzing spread of upper partials out of them
  env = max(abs(y), env * su_envd); ep = max(y, ep * su_envd);
  a = y - jc * ep; a < 0 ? a = 0;
  v3 = a - b2; v1 = ba1 * b1 + ba2 * v3; v2 = b2 + ba2 * b1 + ba3 * v3;
  b1 = 2 * v1 - b1; b2 = 2 * v2 - b2;
  v3 = a - c2; u1 = ca1 * c1 + ca2 * v3; u2 = c2 + ca2 * c1 + ca3 * v3;
  c1 = 2 * u1 - c1; c2 = 2 * u2 - c2;
  // (held below about half the string's own swing, softly: a buzz, not a spike)
  v = ep * 0.5 + 0.000001; y += vo_tanh((v1 * bg + u1 * cg) / v) * v;
  // the tone filter (a gentle 12 dB low-pass with its own envelope; faded out of the way when it is neutral)
  v3 = y - l2; v1 = la1 * l1 + la2 * v3; v2 = l2 + la2 * l1 + la3 * v3;
  l1 = 2 * v1 - l1; l2 = 2 * v2 - l2;
  abs(l1) + abs(l2) < 0.000000000001 ? l1 = l2 = 0;
  y += (v2 - y) * su_flm;
  // the AMP envelope (each pluck: attack from where it is, decay to the sustain, release when the gate ends)
  ast == 1 ? ( ae += (1.3 - ae) * su_aac; ae >= 1 ? ( ae = 1; ast = 2; ); ) :
  ast == 2 ? ( ae += (su_asu - ae) * su_adc; ) :
  ast == 3 ? ( ae -= ae * su_arc; );
  y * ae;
);
// at the control tick: tuning (it glides), loss, the bridge's height, the cloud's bloom and drift
function su_stk(note) instance(dl, dlt, g, jb, jm, jc, tt, ba1, ba2, ba3, bg, ca1, ca2, ca3, cg, hb, hd, f, aref, ast, fe, fst, gt, la1, la2, la3)
                      local(fq, b, b2, h, gg, fc, n) (
  fq = 440 * 2 ^ ((note - 69) / 12); f = fq;
  dlt = min(srate / fq - su_fs + atan(su_fdc / fq) / TWOPI * srate / fq, SUSBN - 8);
  // a re-tune: while the string glides it is damped a little (the ringing note gives way to the new one)
  g = 10 ^ (-3 / fq * (1 / su_dec + 0.8 * su_rdmp));
  tt += su_tks;
  b = 1 - exp(-tt / su_tb); b2 = 1 - exp(-tt / su_ts);
  jb = aref * (1 - 0.85 * su_jwe * b) + 0.000001;
  jm = su_jwe * su_jdep / max(aref, 0.0001);
  // the cloud's centre: this pluck's own (hb), drifting slowly and shallowly (hd), breathing with FATE
  h = (hb + hd * b2) * su_hbr * srate / max(dl + su_fs, 2) / fq;   // (it follows the string as a re-tune glides)
  fc = min(fq * h, su_fmax); gg = tan($pi * fc / srate);
  ba1 = 1 / (1 + gg * (gg + su_bk)); ba2 = gg * ba1; ba3 = gg * ba2;
  fc = min(fq * h * 1.75, su_fmax); gg = tan($pi * fc / srate);
  ca1 = 1 / (1 + gg * (gg + su_bk2)); ca2 = gg * ca1; ca3 = gg * ca2;
  jc = 0.45 + 0.1 * b2;                                    // the contact narrows a little as it settles
  n = su_jwe * su_bjg * b / (1.2 - jc);
  bg = n * su_bk; cg = n * 1.1 * su_bk2;
  // the gate (one pluck interval), the FILTER envelope, the tone filter's coefficients
  gt -= 8; gt <= 0 && ast > 0 && ast < 3 && !su_ahold ? ast = 3;
  fst == 1 ? ( fe += (1.3 - fe) * su_fac; fe >= 1 ? ( fe = 1; fst = 2; ); ) :
  fst == 2 ? ( fe += (su_fsu - fe) * su_fdcy; gt <= 0 ? fst = 3; ) :
  fst == 3 ? ( fe -= fe * su_frc; );
  su_flm > 0.0001 ? (
    fc = min(max(su_fcut * 2 ^ (su_fenv * 5 * fe), 30), su_fmax); gg = tan($pi * fc / srate);
    la1 = 1 / (1 + gg * (gg + su_fk)); la2 = gg * la1; la3 = gg * la2;
  );
);
function su_spl(a) instance(ei, en, ea, tt, aref, f, env, hb, hd, ast, fst, gt) (
  ei = 0; en = max(floor(srate / f * su_ew), 4); ea = a; tt = 0; aref = max(a * su_aref, env * 0.8);
  ast = 1; fst = 1; gt = su_plg;                       // the envelopes start again (from where they are)
  // every pluck blooms a little differently: where its cloud sits (about the 6th - 9th harmonic, higher with more
  // JAWARI) and which way, and how far, it drifts
  hb = 5.5 + 2.2 * su_jaw + rand(1.5); hd = (rand(2) - 0.6) * (1 + 2 * su_jaw);
);
function su_snap(note) instance(dl, dlt, f) ( f = 440 * 2 ^ ((note - 69) / 12); dl = dlt = min(srate / f, SUSBN - 8); );

// ---------- the ring voices ----------
function su_vgo(v, n, vel, gate, pan) local(f) (
  f = 440 * 2 ^ ((n - 69) / 12);
  v[0] = 1; v[1] = 0; v[2] = 0; v[3] = TWOPI * min(f, srate * 0.4) / srate;
  v[4] = 0; v[5] = v[3] * 2.756; v[19] = v[5] < 0.85 * $pi;
  v[6] = 1; v[7] = vel; v[8] = gate; v[10] = n; v[11] = 1;
  v[16] = cos((pan + 1) * 0.25 * $pi); v[17] = sin((pan + 1) * 0.25 * $pi);
  v[18] = su_age; su_age += 1;
);
// a new note for ring r: a free voice, else the quietest releasing one, else the oldest (it fades out in 6 ms)
function su_vstart(r, n, vel, gate) local(i, v, q, pick, bl, ba, pan) (
  pick = -1; i = 0;
  loop(3, v = SUVO + (r * 3 + i) * 32; pick < 0 && v[0] == 0 ? pick = i; i += 1; );
  pick < 0 ? ( bl = 10; i = 0; loop(3, v = SUVO + (r * 3 + i) * 32; v[0] == 3 && v[1] < bl ? ( bl = v[1]; pick = i; ); i += 1; ); );
  pick < 0 ? ( ba = 1000000000000; i = 0; loop(3, v = SUVO + (r * 3 + i) * 32; v[0] != 4 && v[18] < ba ? ( ba = v[18]; pick = i; ); i += 1; ); );
  pick < 0 ? pick = 0;
  v = SUVO + (r * 3 + pick) * 32;
  q = SURG + r * 40; pan = min(max(q[9] + (pick - 1) * 0.12, -1), 1);
  n = min(max(n, 24), 108);
  v[0] == 0 ? su_vgo(v, n, vel, gate, pan) : ( v[0] = 4; v[12] = n; v[13] = vel; v[14] = gate; v[15] = pan; );
  q[26] = 3;
);
// a step of ring r: its tones (low to high) into SUTN, then the pattern picks
function su_rstep(r) local(q, k, n, dir, sc, i, j, m, s, deg, pat, vel, gate, cnt, ivl) (
  q = SURG + r * 40;
  k = floor(su_bp / q[15] + 0.5);                          // the step's number on the song's grid
  q[17] += q[15];
  su_ton && q[0] > 0.5 && q[2] > 0.00001 && rand(1) < su_gen ? (   // (PLAY lets the rings play too)
    n = q[16]; dir = r < su_above ? 1 : -1; sc = q[11]; pat = q[14];
    ivl = su_imode ? dir * q[13] : 0;
    vel = min(max(0.75 + su_vsp * (rand(1) - 0.5) * 0.7, 0.12), 1);
    vel = min(max(vel * (1 + su_kvel * (su_kv - 0.75) * 1.3), 0.08), 1);
    gate = max(q[15] * 60 / su_tmp * srate * 0.9, 64);
    pat == 3 && su_nh > 0 ? (
      // AS PLAYED: the keys held, in the order played, in this ring's register
      cnt = min(su_nh, 7); m = SUHN[k % cnt] - su_sa; m -= 12 * floor(m / 12);
      su_vstart(r, su_rc + (dir > 0 ? m : m - 12) + ivl, vel, gate);
    ) : (
      i = 0;
      loop(n,
        deg = su_imode ? dir * i : dir * (q[12] + i);
        SUTN[dir > 0 ? i : n - 1 - i] = su_rc + su_d2s(sc, deg) + ivl;
        i += 1;
      );
      pat == 4 ? (
        // CHORD: a stack of thirds from the tones (three at most)
        i = 0; loop(n >= 5 ? 3 : n >= 3 ? 2 : 1, su_vstart(r, SUTN[i * 2], vel * 0.8, gate); i += 1; );
        n == 2 ? su_vstart(r, SUTN[1], vel * 0.8, gate);
        n == 4 ? su_vstart(r, SUTN[3], vel * 0.8, gate);
      ) : (
        m = k % n;
        pat == 0 ? j = m :
        pat == 1 ? j = n - 1 - m :
        pat == 2 ? ( n < 2 ? j = 0 : ( m = k % (2 * n - 2); j = m < n ? m : 2 * n - 2 - m; ); ) :
        pat == 5 || pat == 6 ? (
          s = pat == 5 ? 2 : 3;
          j = (s * m) % n + (n % s == 0 ? floor(s * m / n) : 0);
          dir < 0 ? j = n - 1 - j;
        ) :
        pat == 7 ? ( j = floor(rand(n)); n > 1 && j == q[20] ? j = (j + 1 + floor(rand(n - 1))) % n; q[20] = j; ) :
        ( j = dir > 0 ? m : n - 1 - m; );                    // (AS PLAYED with no keys held: outward from the start)
        su_vstart(r, SUTN[j], vel, gate);
      );
    );
  );
);

// ---------- LISTEN ----------
function su_setsa(pc) ( su_pc = pc; su_sat = 12 * (su_oct + 1) + pc - (pc > 6 ? 12 : 0); );
function su_levent() local(i, b, m) (
  su_src == 1 ? (
    b = -1; m = 0; i = 0; loop(12, SUHI[i] > m ? ( m = SUHI[i]; b = i; ); i += 1; );
    b >= 0 ? su_pend = b;
    memset(SUHI, 0, 12); su_hmax = 0;
  );
  su_src < 2 && su_pend >= 0 && su_pend != su_pc ? ( su_setsa(su_pend); su_sa != su_sat ? su_rdmp = 1; su_sa = su_sat; su_nret += 1; );
);
// YIN on the latest window of the decimated input; a confident pitch votes for its pitch class
function su_yin() local(st, wn, tmax, tmin, t, j, d, e, s, a, b, best, bv, x0, x1, x2, sh, f, n, pc, rms) (
  wn = 256; tmax = min(floor(su_pfs / 45), 300); tmin = max(floor(su_pfs / 1100), 2);
  st = su_pw - wn - tmax;
  e = 0; j = 0; loop(wn, a = SUPD[(st + j) & SUPDM]; e += a * a; j += 1; );
  rms = sqrt(e / wn); su_prms = rms;
  rms > su_pgate ? (
    s = 0; t = 1; best = -1; bv = 1;
    loop(tmax,
      d = 0; j = 0;
      loop(wn, a = SUPD[(st + j) & SUPDM] - SUPD[(st + j + t) & SUPDM]; d += a * a; j += 1; );
      s += d; SUYD[t] = d * t / max(s, 0.0000000001);
      t += 1;
    );
    t = tmin;
    while (t < tmax && best < 0) (
      SUYD[t] < 0.15 ? ( while (t + 1 < tmax && SUYD[t + 1] < SUYD[t]) ( t += 1; ); best = t; );
      t += 1;
    );
    best < 0 ? ( t = tmin; loop(tmax - tmin, SUYD[t] < bv ? ( bv = SUYD[t]; best = t; ); t += 1; ); bv > 0.35 ? best = -1; );
    best > tmin && best < tmax - 1 ? (
      x0 = SUYD[best - 1]; x1 = SUYD[best]; x2 = SUYD[best + 1];
      d = x0 - 2 * x1 + x2; sh = abs(d) > 0.0000001 ? 0.5 * (x0 - x2) / d : 0;
      f = su_pfs / (best + min(max(sh, -1), 1));
      n = 69 + 12 * log(f / 440) / log(2); pc = floor(n + 0.5); pc -= 12 * floor(pc / 12);
      su_pconf = 1 - x1; su_pnote = n;
      SUHI[pc] += rms * max(su_pconf, 0);
      SUHI[pc] > su_hmax ? ( su_hmax = SUHI[pc]; su_pend = pc; );
    );
  );
);

// ---------- parameters ----------
function su_update() local(r, q, b, t, s, v) (
  su_tmp = tempo > 0 ? tempo : 120;
  su_bpb = (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  su_ton = slider1 >= 0.5; su_tun = floor(slider2 + 0.5); su_ns = su_tun >= 4 ? 5 : 4;
  // JAWARI's buzz on a slow taper (even to the ear); the cloud's brightness follows the knob directly
  su_jaw = slider3 / 100; su_jamt = min(su_jaw ^ JTP * JTG, JTG);
  su_bri = slider4 / 100; su_dec = slider5; su_rfree = slider6; su_sync = slider7 >= 0.5;
  t = su_tbeats(floor(slider8 + 0.5)); t != su_tdb ? ( su_tdb = t; su_tnext = ceil(su_bp / su_tdb - 0.000001) * su_tdb; );
  su_hum = slider9 / 100; su_tlev = sqr(slider10 / 100) * 1.1; su_spr = slider11 / 100;
  // the strings: tone and pluck from BRIGHTNESS; the bloom and the sweep take longer the longer they ring
  su_fs = 0.5 - 0.44 * su_bri; su_ew = 0.62 - 0.4 * su_bri; su_pn = 0.25 + 0.6 * su_bri;
  su_tb = 0.03 + 0.02 * (1 - su_bri); su_ts = 2.5 + 0.1 * su_dec;   // the bloom (to 95 % in 90 - 150 ms); the slow drift
  su_bk = 1 / 1.1; su_bk2 = 1 / 0.8;                       // the cloud's two bands: Q 1.1 and 0.8
  // the AMP and FILTER envelopes, the tone filter
  su_aac = vo_coef(max(slider147, 1)); su_adc = vo_coef(slider148); su_asu = slider149 / 100; su_arc = vo_coef(slider150);
  su_ahold = slider150 >= 19999;
  su_fcut = slider151; su_fk = 1.414 - 1.05 * slider152 / 100; su_fenv = slider153 / 100;
  su_fac = 1 - exp(-8 * 4.6 / (max(slider154, 1) * 0.001 * srate)); su_fdcy = 1 - exp(-8 * 4.6 / (slider155 * 0.001 * srate));
  su_fsu = slider156 / 100; su_frc = 1 - exp(-8 * 4.6 / (slider157 * 0.001 * srate));
  su_flt = slider151 < 19999 || abs(slider153) > 0.5;
  su_plg = max((su_sync ? su_tdb * 60 / su_tmp : su_rfree) * srate, 64);   // a pluck's gate: one pluck interval
  // the strings fanned across (equal power): 1 left .. 4 (5) right
  r = 0; loop(5, t = su_ns > 1 ? (2 * r / (su_ns - 1) - 1) * su_spr : 0; t = min(max(t, -1), 1);
         SUSP[r * 2] = cos((t + 1) * 0.25 * $pi); SUSP[r * 2 + 1] = sin((t + 1) * 0.25 * $pi); r += 1; );
  // LISTEN
  su_src = floor(slider12 + 0.5);
  t = su_bpb * (2 ^ floor(slider13 + 0.5)); t != su_lper ? ( su_lper = t; su_lnext = ceil(su_bp / su_lper - 0.000001) * su_lper; );
  su_root = floor(slider14 + 0.5); v = floor(slider15 + 0.5);
  v != su_oct ? ( su_oct = v; su_setsa(su_pc); su_sa != su_sat ? su_rdmp = 1; su_sa = su_sat; );
  su_src == 2 && (su_root != su_pc || su_sa != su_sat) ? ( su_setsa(su_root); su_sa != su_sat ? su_rdmp = 1; su_sa = su_sat; su_pend = -1; );
  su_pgate = 10 ^ (slider16 / 20);
  // the rings
  su_gsc = floor(slider17 + 0.5); su_above = floor(slider18 + 0.5); su_imode = slider19 >= 0.5;
  su_gen = slider20 / 100; su_vsp = slider21 / 100; su_kvel = slider22 / 100; su_rlev = sqr(slider23 / 100) * 0.55;
  r = 0;
  loop(7,
    q = SURG + r * 40; b = 49 + r * 14;
    q[0] = slider(b) >= 0.5; q[2] = sqr(slider(b + 1) / 100);
    q[4] = vo_coef(max(slider(b + 2), 2)); q[5] = vo_coef(slider(b + 3)); q[6] = slider(b + 4) / 100; q[7] = vo_coef(slider(b + 5));
    t = slider(b + 6) / 100; q[8] = t;
    q[27] = 1.5 * min(t / 0.5, 1) ^ 1.4;                   // the held FM index: a sine .. a warm glow
    q[28] = t > 0.5 ? 3.2 * (t - 0.5) / 0.5 : 0;           // the struck index: the bell's attack
    q[29] = t > 0.4 ? 0.65 * (t - 0.4) / 0.6 : 0;          // the bell partial
    q[9] = slider(b + 7) / 100;
    s = floor(slider(b + 8) + 0.5); q[11] = s == 0 ? su_gsc : s - 1;
    q[12] = floor(slider(b + 9) + 0.5); q[13] = su_ivl(floor(slider(b + 10) + 0.5)); q[14] = floor(slider(b + 11) + 0.5);
    t = su_rbeats(floor(slider(b + 12) + 0.5)); t != q[15] ? ( q[15] = t; q[17] = ceil(su_bp / t - 0.000001) * t; );
    q[16] = min(max(floor(slider(b + 13) + 0.5), 1), 7);
    r += 1;
  );
  // DELAY
  su_din = slider24 >= 0.5; su_dlb = su_dbeats(floor(slider25 + 0.5)); su_dfb = slider26 / 100;
  su_smk = slider27 / 100 * 0.72; su_dtc = 1 - exp(-TWOPI * min(700 * 2 ^ (slider28 / 100 * 4.5), srate * 0.45) / srate);
  su_dmix = slider29 / 100;
  su_dtt = max(min(su_dlb * 60 / su_tmp * srate, SUDLM - 8), max(su_smcl, su_smcr) + 64);
  // CHORUS, WIDTH, TAIL
  su_cin = slider30 >= 0.5; su_cr0 = slider31; su_cdp = slider32 / 100; su_cmix = slider33 / 100;
  su_win = slider34 >= 0.5; su_wgt = slider35 / 100;
  su_tin = slider36 >= 0.5; su_tsz = slider37 / 100; su_tmix = slider38 / 100;
  t = (0.55 + 1.05 * su_tsz) * srate / 1000;
  SUTN[8] = min(floor(29.7 * t), SUTLN - 2); SUTN[9] = min(floor(37.1 * t), SUTLN - 2);
  SUTN[10] = min(floor(43.3 * t), SUTLN - 2); SUTN[11] = min(floor(49.9 * t), SUTLN - 2);
  t = 0.7 + 5.5 * su_tsz * su_tsz;                        // RT60 (s)
  su_tg0 = 10 ^ (-3 * SUTN[8] / (t * srate)); su_tg1 = 10 ^ (-3 * SUTN[9] / (t * srate));
  su_tg2 = 10 ^ (-3 * SUTN[10] / (t * srate)); su_tg3 = 10 ^ (-3 * SUTN[11] / (t * srate));
  su_tdmp = 1 - exp(-TWOPI * (4200 - 1800 * su_tsz) / srate);
  // MASTER
  su_fate = slider39 / 100; su_volt = 10 ^ (slider40 / 20) * sqr(slider41 / 100) * 5.6; su_chan = floor(slider42 + 0.5);
  ins_output_setup(43);   // output stage: CLIP, always on
);
function su_resync() local(r, q) (
  su_tnext = ceil(su_bp / su_tdb - 0.000001) * su_tdb;
  su_lnext = ceil(su_bp / su_lper - 0.000001) * su_lper;
  r = 0; loop(7, q = SURG + r * 40; q[17] = ceil(su_bp / q[15] - 0.000001) * q[15]; r += 1; );
);
// pluck the next string
function su_pluck() local(k, a) (
  k = su_sti; su_sti = (su_sti + 1) % su_ns;
  a = su_pamp * (1 - su_hum * 0.4 * rand(1));
  k == 0 ? su_s0.su_spl(a) : k == 1 ? su_s1.su_spl(a) : k == 2 ? su_s2.su_spl(a) : k == 3 ? su_s3.su_spl(a) : su_s4.su_spl(a);
  SUSE[k * 4 + 2] += 1;
);
// an all-pass (smear and tail)
function su_ap(base, n, x, k, m) instance(w) local(d, v) (
  d = base[(w - n) & m]; v = x + k * d; abs(v) < 0.000000000001 ? v = 0; base[w & m] = v; w = (w + 1) & m;
  d - k * v;
);

ins_drift_init();
su_ds0.drift_init(0.8 + rand(0.5)); su_ds1.drift_init(0.8 + rand(0.5)); su_ds2.drift_init(0.8 + rand(0.5));
su_ds3.drift_init(0.8 + rand(0.5)); su_ds4.drift_init(0.8 + rand(0.5));
su_djw.drift_init(0.8 + rand(0.5)); su_dlf.drift_init(0.8 + rand(0.5));
su_dhb.drift_init(0.8 + rand(0.5)); su_hbr = 1; su_dtm.drift_init(0.8 + rand(0.5)); su_dch.drift_init(0.8 + rand(0.5));
i_ = 0; loop(5, SUTN[56 + i_] = i_ * 0.2; i_ += 1; );   // (the detune's phases: 72 degrees apart)
su_dr0.drift_init(0.8 + rand(0.5)); su_dr1.drift_init(0.8 + rand(0.5)); su_dr2.drift_init(0.8 + rand(0.5));
su_dr3.drift_init(0.8 + rand(0.5)); su_dr4.drift_init(0.8 + rand(0.5)); su_dr5.drift_init(0.8 + rand(0.5));
su_dr6.drift_init(0.8 + rand(0.5));
su_s0.su_sinit(); su_s1.su_sinit(); su_s2.su_sinit(); su_s3.su_sinit(); su_s4.su_sinit();
su_bp = 0; su_tp = 0; su_tpw = 0; su_rs = 1; su_tdb = -1; su_lper = -1; su_oct = -1; su_pc = 0; su_pend = -1; su_nret = 0;
su_sti = 0; su_tcnt = 0; su_pdue = 0; su_nh = 0; su_kv = 0.75; su_age = 0; su_hmax = 0; su_pw = 0; su_pdc = 0; su_pnew = 0;
su_pcf = 0; su_pcg = 1; su_ct = 7; su_first = 1; su_tng = 0; su_dgn = su_cgn = su_wgn = su_tgn = 0;
su_cc = 1; su_cs = 0; su_scw = 0; su_scd = 0; su_jwe = 0.5;
su_pamp = 0.5; su_aref = 0.62;                             // the pluck's strength; its swing (for the bridge's height)
su_bjg = 6; su_fdc = 4; JTP = 1.5; JTG = 1.1;
function su_srinit() local(t) (
  su_sr = srate; ost_init(20000);
  su_glk = 1 - exp(-1 / (0.25 * srate));                   // a re-tune glides over about a quarter of a second
  su_rdk = exp(-8 / (0.4 * srate));
  su_dcr = 1 - TWOPI * su_fdc / srate;
  su_nzk = 1 - exp(-TWOPI * 2500 / srate);
  su_envd = exp(-1 / (0.05 * srate));
  su_tks = 8 / srate; su_fmax = srate * 0.42;
  su_jdep = 5 * srate / 48000; su_jcap = 6 * srate / 48000;   // the bridge's grip (samples)
  su_sk = 1 - exp(-8 / (0.02 * srate));                    // continuous controls glide (about 20 ms, at the tick)
  su_sm = 1 - exp(-1 / (0.03 * srate));
  su_kstp = 1 / (0.008 * srate);                           // a stolen note fades out in 8 ms
  su_sdk = exp(-1 / (0.7 * srate));                        // the bell's strike
  su_dsk = 1 - exp(-1 / (0.12 * srate));                   // the delay time glides
  su_pcdn = 1 / (0.012 * srate); su_pcup = 1 / (0.02 * srate);   // preset change: 12 ms out, 20 ms in
  // LISTEN: decimate to about 8 kHz (two low-pass poles at 1 kHz first)
  su_pdec = max(1, floor(srate / 8000 + 0.5)); su_pfs = srate / su_pdec; su_plk = 1 - exp(-TWOPI * 1000 / srate);
  su_phk = 1 - exp(-TWOPI * 30 / srate);
  // the smear's all-pass lengths (ms) and their sum (the feedback tap reads that much earlier)
  t = srate / 1000;
  SUTN[24] = floor(4.7 * t); SUTN[25] = floor(9.3 * t); SUTN[26] = floor(15.1 * t); SUTN[27] = floor(23.9 * t);
  SUTN[28] = floor(5.3 * t); SUTN[29] = floor(10.1 * t); SUTN[30] = floor(16.7 * t); SUTN[31] = floor(21.3 * t);
  su_smcl = SUTN[24] + SUTN[25] + SUTN[26] + SUTN[27]; su_smcr = SUTN[28] + SUTN[29] + SUTN[30] + SUTN[31];
  SUTN[32] = min(floor(5.9 * t), SUTAN - 2); SUTN[33] = min(floor(8.3 * t), SUTAN - 2);
  // WIDTH: the side's high-pass (mono below about 150 Hz)
  t = tan($pi * 150 / srate); su_wk = sqrt(2); su_wa1 = 1 / (1 + t * (t + su_wk)); su_wa2 = t * su_wa1; su_wa3 = t * su_wa2;
  su_cbase = 0.011 * srate; su_cdep = 0.0055 * srate;
  su_update();
  su_dts = su_dtt;
);
su_srinit();
su_setsa(su_root); su_sa = su_sat;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
su_vol = su_volt;
ui_dflt = 1;

@slider
!su_pcf && !su_panic ? su_update();

@block
srate != su_sr ? su_srinit();
// a preset change: the old sound fades out (12 ms), everything is cleared at the silent point, then it fades in (20 ms)
su_panic && !su_pcf ? ( su_pcf = 1; su_panic = 0; );
su_pcf == 2 ? (
  memset(SUVO, 0, 21 * 32); memset(SUSB, 0, 5 * SUSBN); memset(SUCL, 0, 2 * 8192); memset(SUTL, 0, 4 * SUTLN);
  memset(SUTA, 0, 2 * SUTAN); memset(SUSM, 0, 8 * SUSMN); memset(SUDL, 0, 524288 * 2); memset(SUHI, 0, 12); su_hmax = 0;
  su_s0.su_sinit(); su_s1.su_sinit(); su_s2.su_sinit(); su_s3.su_sinit(); su_s4.su_sinit();
  su_dfl = su_dfr = su_tlp0 = su_tlp1 = su_tlp2 = su_tlp3 = 0; su_wi1 = su_wi2 = 0; su_dcxl = su_dcxr = su_dcyl = su_dcyr = 0;
  i_ = 0; loop(7, SURG[i_ * 40 + 26] = 0; i_ += 1; );
  su_first = 1; su_sti = 0; su_pdue = 0; su_tcnt = 0; su_pend = -1; su_tng = 0; su_dgn = su_cgn = su_wgn = su_tgn = 0;
  su_pcf = 3; su_rootnow = 1;
);
// TRANSPORT: while lit, REAPER's play (or record) presses PLAY and its stop releases it; PLAY still works by hand
su_xp = play_state & 1;
slider158 >= 0.5 && su_xp != su_xpw ? ( slider1 = su_xp; su_ton = su_xp; ui_auto(1); );
su_xpw = su_xp;
su_pcf != 1 ? su_update();
su_rootnow ? ( su_setsa(su_root); su_sa = su_sat; su_rootnow = 0; su_rdmp = 0; );

// ---------- MIDI: the keys held (LISTEN, AS PLAYED, KEY VEL) ----------
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, su_chan) ? (
    su_st = m1 & 0xF0;
    su_st == 0x90 && m3 > 0 ? (
      ins_midi_hit();
      i_ = 0; j_ = 0; loop(su_nh, SUHN[i_] != m2 ? ( SUHN[j_] = SUHN[i_]; SUHV[j_] = SUHV[i_]; j_ += 1; ); i_ += 1; ); su_nh = j_;
      su_nh < 64 ? ( SUHN[su_nh] = m2; SUHV[su_nh] = m3 / 127; su_nh += 1; );
    ) : su_st == 0x80 || (su_st == 0x90 && m3 == 0) ? (
      i_ = 0; j_ = 0; loop(su_nh, SUHN[i_] != m2 ? ( SUHN[j_] = SUHN[i_]; SUHV[j_] = SUHV[i_]; j_ += 1; ); i_ += 1; ); su_nh = j_;
    ) : su_st == 0xB0 && (m2 == 120 || m2 == 123) ? su_nh = 0;
  );
  midisend(mofs, m1, m2, m3);
);
// the lowest key held is the root that waits (MIDI); the keys' velocity
su_nh > 0 ? (
  su_lo = 128; su_kv = 0; i_ = 0; loop(su_nh, su_lo = min(su_lo, SUHN[i_]); su_kv += SUHV[i_]; i_ += 1; ); su_kv /= su_nh;
  su_src == 0 ? su_pend = su_lo % 12;
) : su_kv = 0.75;
su_src == 2 ? su_pend = -1;

// ---------- the clock: REAPER's position while it plays, its own at the project tempo while stopped ----------
su_dbp = su_tmp / 60 / srate;
su_tp = play_state & 1;
su_tp ? ( (!su_tpw || abs(beat_position - su_bp) > 0.05) ? su_rs = 1; su_bp = beat_position; );
su_tpw = su_tp;
su_rs ? ( su_resync(); su_rs = 0; );
su_rc = su_sa + 12;                                         // the rings' centre: Sa an octave above the tanpura's

// ---------- LISTEN (audio): every 512 decimated samples (64 ms) ----------
su_src == 1 && su_pnew >= 512 ? ( su_pnew = 0; su_yin(); );

// ---------- FATE: the solar breath ----------
ins_drift_block(su_fate * 0.5, samplesblock);
su_di = 0.09 * samplesblock / srate;
su_fa = su_fate * 2;                                        // (1 = the standard amount)
SUTN[40] = su_ds0.drift_tick(su_di * 1.2) * su_fa * 0.03; SUTN[41] = su_ds1.drift_tick(su_di * 1.2) * su_fa * 0.03;   // +/-3 cents
SUTN[42] = su_ds2.drift_tick(su_di * 1.2) * su_fa * 0.03; SUTN[43] = su_ds3.drift_tick(su_di * 1.2) * su_fa * 0.03;
SUTN[44] = su_ds4.drift_tick(su_di * 1.2) * su_fa * 0.03;
// the jawari's slow, fine detune: always on, each string at its own rate and phase, so they beat gently
su_lr = 0.13 * 2 ^ (su_dlf.drift_tick(su_di) * su_fa * 0.25) * samplesblock / srate;
su_ld = (0.8 + 3 * su_jaw) / 100;                           // depth: 0.8 - 3.8 cents (2.5 at JAWARI 55 %)
i_ = 0; loop(5, SUTN[56 + i_] += su_lr * (i_ == 0 ? 1 : i_ == 1 ? 1.17 : i_ == 2 ? 0.89 : i_ == 3 ? 1.06 : 0.94); SUTN[56 + i_] -= floor(SUTN[56 + i_]);
  SUTN[40 + i_] += su_ld * sin(TWOPI * SUTN[56 + i_]); i_ += 1; );
su_jwe = min(max(su_jamt * (1 + su_djw.drift_tick(su_di * 0.8) * su_fa * 0.3), 0), 1.25);   // the buzz breathes
su_tbr = 1 + su_dtm.drift_tick(su_di) * su_fa * 0.08;      // the plucks' timing breathes
su_hbr = 2 ^ (su_dhb.drift_tick(su_di * 0.6) * su_fa * 0.1);   // and the cloud's brightness
su_cr = su_cr0 * 2 ^ (su_dch.drift_tick(su_di) * su_fa * 0.25);
SUTN[48] = 2 ^ (su_dr0.drift_tick(su_di * 0.7) * su_fa * 0.6); SUTN[49] = 2 ^ (su_dr1.drift_tick(su_di * 0.7) * su_fa * 0.6);
SUTN[50] = 2 ^ (su_dr2.drift_tick(su_di * 0.7) * su_fa * 0.6); SUTN[51] = 2 ^ (su_dr3.drift_tick(su_di * 0.7) * su_fa * 0.6);
SUTN[52] = 2 ^ (su_dr4.drift_tick(su_di * 0.7) * su_fa * 0.6); SUTN[53] = 2 ^ (su_dr5.drift_tick(su_di * 0.7) * su_fa * 0.6);
SUTN[54] = 2 ^ (su_dr6.drift_tick(su_di * 0.7) * su_fa * 0.6);
su_ptune = 12 * log(ins_pitch) / log(2);
su_cw_ = TWOPI * su_cr / srate; su_ccw = cos(su_cw_); su_csw = sin(su_cw_);
su_ct_ = sqrt(su_cc * su_cc + su_cs * su_cs); su_cc /= su_ct_; su_cs /= su_ct_;   // (the chorus phasor stays on its circle)
// the TAIL switched fully out: its lines are emptied, so switching it back in starts clean
su_tgn > 0.0001 ? su_tact = 1 : su_tact ? ( memset(SUTL, 0, 4 * SUTLN); memset(SUTA, 0, 2 * SUTAN); su_tlp0 = su_tlp1 = su_tlp2 = su_tlp3 = 0; su_tact = 0; );
// (no denormals)
abs(su_dfl) + abs(su_dfr) < 0.0000000001 ? su_dfl = su_dfr = 0;
abs(su_tlp0) + abs(su_tlp1) + abs(su_tlp2) + abs(su_tlp3) < 0.0000000001 ? su_tlp0 = su_tlp1 = su_tlp2 = su_tlp3 = 0;
abs(su_wi1) + abs(su_wi2) < 0.0000000001 ? su_wi1 = su_wi2 = 0;
abs(su_dcyl) + abs(su_dcyr) < 0.0000000001 ? su_dcyl = su_dcyr = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
su_bp += su_dbp;
// ---------- the control tick (every 8 samples) ----------
su_ct += 1;
su_ct >= 8 ? (
  su_ct = 0;
  su_s0.su_stk(su_sa + su_toff(su_tun, 0) + SUTN[40] + su_ptune);
  su_s1.su_stk(su_sa + su_toff(su_tun, 1) + su_tdet(1) + SUTN[41] + su_ptune);
  su_s2.su_stk(su_sa + su_toff(su_tun, 2) + su_tdet(2) + SUTN[42] + su_ptune);
  su_s3.su_stk(su_sa + su_toff(su_tun, 3) + su_tdet(3) + SUTN[43] + su_ptune);
  su_ns == 5 || su_s4.env > 0.00001 ? su_s4.su_stk(su_sa + su_toff(su_tun, 4) + su_tdet(4) + SUTN[44] + su_ptune);
  su_first ? (
    su_s0.su_snap(su_sa + su_toff(su_tun, 0)); su_s1.su_snap(su_sa + su_toff(su_tun, 1)); su_s2.su_snap(su_sa + su_toff(su_tun, 2));
    su_s3.su_snap(su_sa + su_toff(su_tun, 3)); su_s4.su_snap(su_sa + su_toff(su_tun, 4));
    i_ = 0; loop(10, SUSQ[i_] = SUSP[i_]; i_ += 1; );
    su_vol = su_volt; su_first = 0;
  );
  i_ = 0; loop(10, SUSQ[i_] += (SUSP[i_] - SUSQ[i_]) * su_sk; i_ += 1; );
  su_tng += ((su_ton ? su_tlev : 0) - su_tng) * su_sk;
  su_flm += (su_flt - su_flm) * su_sk; su_flm < 0.0001 && !su_flt ? su_flm = 0;
  su_dgn += (su_din - su_dgn) * su_sk; su_cgn += (su_cin - su_cgn) * su_sk;
  su_wgn += (su_win - su_wgn) * su_sk; su_tgn += (su_tin - su_tgn) * su_sk;
  su_dfbn += (su_dfb - su_dfbn) * su_sk; su_dmn += (su_dmix - su_dmn) * su_sk; su_smn += (su_smk - su_smn) * su_sk;
  su_cmn += (su_cmix - su_cmn) * su_sk; su_cdn += (su_cdp - su_cdn) * su_sk; su_wgv += (su_wgt - su_wgv) * su_sk;
  su_tmn += (su_tmix - su_tmn) * su_sk;
  su_rdmp *= su_rdk;                                       // (a re-tune's damping wears off)
  // the rings' gains (ON fades, LEVEL glides) and FATE's tide on their brightness
  su_q = SURG; i_ = 0;
  loop(7,
    su_q[3] += (su_q[0] * su_q[2] * su_rlev - su_q[3]) * su_sk;
    su_q[30] = su_q[27] * SUTN[48 + i_]; su_q[31] = su_q[28] * SUTN[48 + i_];
    su_q += 40; i_ += 1;
  );
  // (for the panel)
  SUSE[0] = su_s0.env; SUSE[4] = su_s1.env; SUSE[8] = su_s2.env; SUSE[12] = su_s3.env; SUSE[16] = su_s4.env;
);

// ---------- LISTEN: the bar line on the clock divider ----------
su_bp >= su_lnext ? ( su_lnext += su_lper; su_levent(); );

// ---------- the tanpura's plucks: 1 - 2 - 3 - 4 (- 5), free or on the grid; HUMANISE plays them a little late ----------
su_ton ? (
  su_sync ? (
    su_bp >= su_tnext ? ( su_tnext += su_tdb; su_pdue = 1 + floor(rand(1) * su_hum * (0.02 + 0.03 * su_fa) * srate); );
  ) : (
    su_tcnt -= 1;
    su_tcnt <= 0 ? ( su_tcnt += max(su_rfree * su_tbr, 0.1) * srate; su_pdue = 1 + floor(rand(1) * su_hum * 0.07 * srate); );
  );
) : ( su_tcnt = 0; su_tnext = ceil(su_bp / su_tdb - 0.000001) * su_tdb; );
su_pdue > 0 ? ( su_pdue -= 1; su_pdue == 0 ? su_pluck(); );

// ---------- the rings' steps ----------
su_q = SURG; su_rn = 0;
loop(7, su_bp >= su_q[17] ? su_rstep(su_rn); su_q += 40; su_rn += 1; );

// ---------- the tanpura ----------
su_y0 = su_s0.su_str(SUSB); su_y1 = su_s1.su_str(SUSB + SUSBN); su_y2 = su_s2.su_str(SUSB + 2 * SUSBN);
su_y3 = su_s3.su_str(SUSB + 3 * SUSBN);
su_y4 = su_ns == 5 || su_s4.env > 0.00001 ? su_s4.su_str(SUSB + 4 * SUSBN) : 0;
su_L = (su_y0 * SUSQ[0] + su_y1 * SUSQ[2] + su_y2 * SUSQ[4] + su_y3 * SUSQ[6] + su_y4 * SUSQ[8]) * su_tng;
su_R = (su_y0 * SUSQ[1] + su_y1 * SUSQ[3] + su_y2 * SUSQ[5] + su_y3 * SUSQ[7] + su_y4 * SUSQ[9]) * su_tng;
// (the scope: every second sample)
su_scd = !su_scd;
su_scd ? (
  SUSCP[su_scw] = su_y0 + su_y1 + su_y2 + su_y3 + su_y4; SUSCX[su_scw] = su_y0 + su_y3 + su_y4; SUSCY[su_scw] = su_y1 + su_y2;
  su_scw = (su_scw + 1) & SUSCM;
);

// ---------- the seven rings ----------
su_q = SURG; su_v = SUVO;
loop(7,
  su_q[26] > 0 ? (
    su_ac = su_q[4]; su_dc = su_q[5]; su_su = su_q[6]; su_rl = su_q[7]; su_i0 = su_q[30]; su_is = su_q[31]; su_bl = su_q[29];
    su_al = 0; su_xl = su_xr = 0;
    loop(3,
      su_st_ = su_v[0];
      su_st_ ? (
        su_lv = su_v[1];
        su_st_ == 1 ? ( su_lv += (1.3 - su_lv) * su_ac; su_lv >= 1 ? ( su_lv = 1; su_v[0] = 2; ); ) :
        su_st_ == 2 ? ( su_lv += (su_su - su_lv) * su_dc; ) :
        su_st_ == 3 ? ( su_lv -= su_lv * su_rl; su_lv < 0.00002 ? ( su_lv = 0; su_v[0] = 0; ); ) :
        ( su_v[11] -= su_kstp; su_v[11] <= 0 ? ( su_vgo(su_v, su_v[12], su_v[13], su_v[14], su_v[15]); su_lv = 0; ); );
        su_st_ <= 2 ? ( su_v[8] -= 1; su_v[8] <= 0 ? su_v[0] = 3; );
        su_v[1] = su_lv;
        su_ph = su_v[2] + su_v[3]; su_ph >= TWOPI ? su_ph -= TWOPI; su_v[2] = su_ph;
        su_pb = su_v[4] + su_v[5]; su_pb >= TWOPI ? su_pb -= TWOPI; su_v[4] = su_pb;
        su_se = su_v[6] * su_sdk; su_v[6] = su_se;
        su_y = sin(su_ph + (su_i0 + su_is * su_se) * sin(su_ph));
        su_v[19] ? su_y += su_bl * su_se * sin(su_pb);
        su_g = su_v[11]; su_g = su_lv * su_v[7] * su_g * su_g * (3 - 2 * su_g);   // (a steal fades on an S-curve)
        su_xl += su_y * su_g * su_v[16]; su_xr += su_y * su_g * su_v[17];
        su_al += 1;
      );
      su_v += 32;
    );
    su_q[26] = su_al;
    su_L += su_xl * su_q[3]; su_R += su_xr * su_q[3];
  ) : su_v += 96;
  su_q += 40;
);

// ---------- DELAY: the echo tap, and (earlier by the smear's own delay) the feedback through TONE and SMEAR ----------
su_dts += (su_dtt - su_dts) * su_dsk;
su_rp = su_dw - su_dts; su_ri = floor(su_rp); su_rf = su_rp - su_ri;
su_a = SUDL[su_ri & SUDLM]; su_el = su_a + (SUDL[(su_ri + 1) & SUDLM] - su_a) * su_rf;
su_a = SUDR[su_ri & SUDLM]; su_er = su_a + (SUDR[(su_ri + 1) & SUDLM] - su_a) * su_rf;
su_rp = su_dw - su_dts + su_smcl; su_ri = floor(su_rp); su_rf = su_rp - su_ri;
su_a = SUDL[su_ri & SUDLM]; su_fl = su_a + (SUDL[(su_ri + 1) & SUDLM] - su_a) * su_rf;
su_rp = su_dw - su_dts + su_smcr; su_ri = floor(su_rp); su_rf = su_rp - su_ri;
su_a = SUDR[su_ri & SUDLM]; su_fr = su_a + (SUDR[(su_ri + 1) & SUDLM] - su_a) * su_rf;
su_dfl += (su_fl - su_dfl) * su_dtc; su_dfr += (su_fr - su_dfr) * su_dtc;
su_fl = su_m0.su_ap(SUSM, SUTN[24], su_dfl, su_smn, SUSMM); su_fl = su_m1.su_ap(SUSM + SUSMN, SUTN[25], su_fl, su_smn, SUSMM);
su_fl = su_m2.su_ap(SUSM + 2 * SUSMN, SUTN[26], su_fl, su_smn, SUSMM); su_fl = su_m3.su_ap(SUSM + 3 * SUSMN, SUTN[27], su_fl, su_smn, SUSMM);
su_fr = su_m4.su_ap(SUSM + 4 * SUSMN, SUTN[28], su_dfr, su_smn, SUSMM); su_fr = su_m5.su_ap(SUSM + 5 * SUSMN, SUTN[29], su_fr, su_smn, SUSMM);
su_fr = su_m6.su_ap(SUSM + 6 * SUSMN, SUTN[30], su_fr, su_smn, SUSMM); su_fr = su_m7.su_ap(SUSM + 7 * SUSMN, SUTN[31], su_fr, su_smn, SUSMM);
su_a = su_L * su_dgn + vo_tanh(su_dfbn * (su_fl * 0.75 + su_fr * 0.25)); SUDL[su_dw] = abs(su_a) < 0.000000000001 ? 0 : su_a;
su_a = su_R * su_dgn + vo_tanh(su_dfbn * (su_fr * 0.75 + su_fl * 0.25)); SUDR[su_dw] = abs(su_a) < 0.000000000001 ? 0 : su_a;
su_dw = (su_dw + 1) & SUDLM;
su_L += su_el * su_dmn * su_dgn * 1.1; su_R += su_er * su_dmn * su_dgn * 1.1;

// ---------- CHORUS: three voices a side, 120 degrees apart (the right side turned 60 degrees on) ----------
SUCL[su_cwp] = su_L; SUCR[su_cwp] = su_R;
su_cgn > 0.0001 ? (
  su_t = su_cc * su_ccw - su_cs * su_csw; su_cs = su_cs * su_ccw + su_cc * su_csw; su_cc = su_t;
  su_s1_ = su_cs * -0.5 + su_cc * 0.8660254; su_s2_ = su_cs * -0.5 - su_cc * 0.8660254;
  su_d = su_cbase + su_cdep * su_cdn * (1 + su_cs);
  su_rp = su_cwp - su_d; su_ri = floor(su_rp); su_rf = su_rp - su_ri; su_a = SUCL[su_ri & SUCHM]; su_wl = su_a + (SUCL[(su_ri + 1) & SUCHM] - su_a) * su_rf;
  su_d = su_cbase * 1.21 + su_cdep * su_cdn * (1 + su_s1_);
  su_rp = su_cwp - su_d; su_ri = floor(su_rp); su_rf = su_rp - su_ri; su_a = SUCL[su_ri & SUCHM]; su_wl += su_a + (SUCL[(su_ri + 1) & SUCHM] - su_a) * su_rf;
  su_d = su_cbase * 1.43 + su_cdep * su_cdn * (1 + su_s2_);
  su_rp = su_cwp - su_d; su_ri = floor(su_rp); su_rf = su_rp - su_ri; su_a = SUCL[su_ri & SUCHM]; su_wl += su_a + (SUCL[(su_ri + 1) & SUCHM] - su_a) * su_rf;
  su_d = su_cbase * 1.1 + su_cdep * su_cdn * (1 - su_cs);
  su_rp = su_cwp - su_d; su_ri = floor(su_rp); su_rf = su_rp - su_ri; su_a = SUCR[su_ri & SUCHM]; su_wr = su_a + (SUCR[(su_ri + 1) & SUCHM] - su_a) * su_rf;
  su_d = su_cbase * 1.32 + su_cdep * su_cdn * (1 - su_s1_);
  su_rp = su_cwp - su_d; su_ri = floor(su_rp); su_rf = su_rp - su_ri; su_a = SUCR[su_ri & SUCHM]; su_wr += su_a + (SUCR[(su_ri + 1) & SUCHM] - su_a) * su_rf;
  su_d = su_cbase * 1.52 + su_cdep * su_cdn * (1 - su_s2_);
  su_rp = su_cwp - su_d; su_ri = floor(su_rp); su_rf = su_rp - su_ri; su_a = SUCR[su_ri & SUCHM]; su_wr += su_a + (SUCR[(su_ri + 1) & SUCHM] - su_a) * su_rf;
  su_t = su_cmn * su_cgn;
  su_L += (su_wl * 0.42 - su_L * 0.35) * su_t; su_R += (su_wr * 0.42 - su_R * 0.35) * su_t;
  su_cdisp = su_cs;
);
su_cwp = (su_cwp + 1) & SUCHM;

// ---------- TAIL: four lines, Householder-mixed ----------
su_tgn > 0.0001 ? (
  su_x = (su_L + su_R) * 0.5;
  su_x = su_ta0.su_ap(SUTA, SUTN[32], su_x, 0.6, SUTAM); su_x = su_ta1.su_ap(SUTA + SUTAN, SUTN[33], su_x, 0.6, SUTAM);
  su_t0 = SUTL[(su_tw - SUTN[8]) & SUTLM]; su_t1 = SUTL[SUTLN + ((su_tw - SUTN[9]) & SUTLM)];
  su_t2 = SUTL[2 * SUTLN + ((su_tw - SUTN[10]) & SUTLM)]; su_t3 = SUTL[3 * SUTLN + ((su_tw - SUTN[11]) & SUTLM)];
  su_tlp0 += (su_t0 - su_tlp0) * su_tdmp; su_tlp1 += (su_t1 - su_tlp1) * su_tdmp;
  su_tlp2 += (su_t2 - su_tlp2) * su_tdmp; su_tlp3 += (su_t3 - su_tlp3) * su_tdmp;
  su_h = (su_tlp0 + su_tlp1 + su_tlp2 + su_tlp3) * 0.5;
  abs(su_h) + abs(su_x) < 0.000000000001 ? su_h = su_x = su_tlp0 = su_tlp1 = su_tlp2 = su_tlp3 = 0;
  SUTL[su_tw] = (su_tlp0 - su_h) * su_tg0 + su_x;
  SUTL[SUTLN + su_tw] = (su_tlp1 - su_h) * su_tg1 - su_x;
  SUTL[2 * SUTLN + su_tw] = (su_tlp2 - su_h) * su_tg2 + su_x;
  SUTL[3 * SUTLN + su_tw] = (su_tlp3 - su_h) * su_tg3 - su_x;
  su_t = su_tmn * su_tgn * 0.6;
  su_L += (su_t0 - su_t2) * su_t; su_R += (su_t1 - su_t3) * su_t;
);
su_tw = (su_tw + 1) & SUTLM;

// ---------- WIDTH: mid / side, the side high-passed at 150 Hz (mono bass) ----------
su_wgn > 0.0001 ? (
  su_m = (su_L + su_R) * 0.5; su_s = (su_L - su_R) * 0.5;
  su_v3 = su_s - su_wi2; su_v1 = su_wa1 * su_wi1 + su_wa2 * su_v3; su_v2 = su_wi2 + su_wa2 * su_wi1 + su_wa3 * su_v3;
  su_wi1 = 2 * su_v1 - su_wi1; su_wi2 = 2 * su_v2 - su_wi2;
  su_s += ((su_s - su_wk * su_v1 - su_v2) * su_wgv - su_s) * su_wgn;
  su_L = su_m + su_s; su_R = su_m - su_s;
);

// ---------- LISTEN (audio): the sidechain, decimated ----------
su_src == 1 ? (
  su_x = (spl2 + spl3) * 0.5;
  su_ph1 += (su_x - su_ph1) * su_phk; su_x -= su_ph1;
  su_pl1 += (su_x - su_pl1) * su_plk; su_pl2 += (su_pl1 - su_pl2) * su_plk;
  su_pdc -= 1;
  su_pdc <= 0 ? ( su_pdc = su_pdec; SUPD[su_pw] = su_pl2; su_pw = (su_pw + 1) & SUPDM; su_pnew += 1; );
);

// DC block
su_dcyl = su_L - su_dcxl + 0.9997 * su_dcyl; su_dcxl = su_L; su_L = su_dcyl;
su_dcyr = su_R - su_dcxr + 0.9997 * su_dcyr; su_dcxr = su_R; su_R = su_dcyr;

// ---------- MASTER ----------
su_pcf == 1 ? ( su_pcg -= su_pcdn; su_pcg <= 0 ? ( su_pcg = 0; su_pcf = 2; ); ) :
su_pcf == 3 ? ( su_pcg += su_pcup; su_pcg >= 1 ? ( su_pcg = 1; su_pcf = 0; ); );
su_vol += (su_volt - su_vol) * su_sm;
su_L *= su_pcg * su_vol; su_R *= su_pcg * su_vol;
su_L = ostL.ost_band(su_L); su_R = ostR.ost_band(su_R);
ost_out(su_L, su_R);
spl0 = ost_l; spl1 = ost_r;
su_pk = max(su_pk, max(abs(spl0), abs(spl1)));

@gfx 1200 850
ui_thm = 5; ui_hw = 1;
ui_begin(1200, 850);

// ---------- the card's colours: champagne-gold brushed aluminium, deep bronze anodising, the amber vector display ----------
FACE = 0xCDB98F; FACEL = 0xE6D8B4; FACED = 0xA08A5E; TRAY = 0xC4AF84;
BRZ = 0x4A321C; BRZL = 0x7A5834; BRZD = 0x2C1C0D; INK = 0x1B1209; LBL = 0x2A1C0D; CHL = 0xF2E2BC;
AMB = 0xFFB12E; AMBL = 0xFFE3A0; AMBD = 0xA0600E; AMBF = 0x3A2308; SCR = 0x120B04; SCRH = 0x2A1A08;
KEYOFF = 0x3B2A17; KEYHOV = 0x5A4228; KEYT = 0xEEDDB6;
SGA = 6000;                                                // (panel memory: each ring's glow, smoothed)

// fonts, calibrated once per scale (a reference word fills the same width everywhere); large, for reading
sc != sg_calsc ? (
  sg_calsc = sc;
  sg_f11 = ui_fitfont(11, 13 * sc);         // key captions, small print
  sg_f12 = ui_fitfont(12, 15.5 * sc);       // section titles
  sg_f13 = ui_fitfont(13, 14.5 * sc);       // knob labels, values, fields
);
gfx_setfont(11, "Trebuchet MS", sg_f11, 'b'); gfx_setfont(12, "Trebuchet MS", sg_f12, 'b');
gfx_setfont(13, "Trebuchet MS", sg_f13, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');    // the card's name
gfx_setfont(15, "Georgia", 19 * sc, 'b');    // the numeral

// ---------- drawing helpers (base coordinates) ----------
function sg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function sg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function sg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function sg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function sg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function sg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function sg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function sg_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function sg_ln(x1, y1, x2, y2, w) ( sg_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function sg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function sg_ring(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); );
function sg_disc(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
// sparse brushing lines over a box: flat means, no textures
function sg_brush(x, y, w, h, n, seed) local(i, yy, x0, l) (
  i = 0;
  loop(n,
    yy = y + 1 + ui_hash(seed + i * 3.1) * (h - 2); x0 = x + ui_hash(seed + i * 7.7) * w * 0.7;
    l = min(w * (0.15 + 0.6 * ui_hash(seed + i * 1.3)), x + w - x0);
    ui_cola(i & 1 ? 0xFFFFFF : 0x5A4020, i & 1 ? 0.2 : 0.07); sg_r(x0, yy, l, 1);
    i += 1;
  );
);
// a section: an ink frame, the brushed champagne tray, a bronze-anodised title band ruled in amber
function sg_sect(x, y, w, h, title) (
  ui_col(INK); sg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  ui_col(TRAY); sg_r(x, y, w, h);
  sg_brush(x, y + 25, w, h - 25, floor(w * h / 1500), x * 0.37 + y * 0.11);
  ui_cola(0xFFFFFF, 0.3); sg_r(x, y + h - 1, w, 1); sg_r(x + w - 1, y + 25, 1, h - 25);
  ui_col(BRZ); sg_r(x, y, w, 24);
  ui_cola(0xFFFFFF, 0.14); sg_r(x, y, w, 1);
  ui_col(AMB); sg_r(x, y + 24, w, 1.5);
  strlen(title) ? ( gfx_setfont(12); ui_col(CHL); sg_t(x + 10, y + 3, title); );
);
function sg_cap(x, y, s) ( gfx_setfont(11); ui_col(LBL); sg_t(x, y, s); );
// the value pill (shown only while a control is touched)
function sg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 4 * sc, 3 * sc);
  ui_col(AMB); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc + 1 * sc, tw + 12 * sc, th + 2 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);

// ---------- the knobs: a value arc in amber on a thin track; big = the heat-sink (finned skirt, smooth flat top) ----------
function sg_kcap(cx, cy, r, n, bip, big) local(rr, a, a0, ca, sa, w, i, b, k) (
  rr = r + (big ? 7 : 5) * sc; w = (big ? 3.2 : 2.4) * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(INK, 0.45); sg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.1 * sc);
  ui_col(AMBD);
  bip ? ( abs(n - 0.5) > 0.004 ? sg_arcw(cx, cy, rr, min(a, 0), max(a, 0), w); ) :
        ( n > 0.004 ? ( sg_arcw(cx, cy, rr, a0, a, w); gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); ); );
  ui_cola(0x000000, 0.3); gfx_circle(cx + 1.5 * sc, cy + 2.6 * sc, r, 1, 1);
  big ? (
    // the heat-sink: a dark bronze body ringed by radial fins, a smooth flat top
    ui_col(BRZD); gfx_circle(cx, cy, r, 1, 1);
    i = 0;
    loop(36,
      b = a + i / 36 * 2 * $pi;
      ui_col(i & 1 ? BRZL : 0x5C4126);
      sg_lnp(cx + sin(b) * r * 0.7, cy - cos(b) * r * 0.7, cx + sin(b) * (r - 0.6 * sc), cy - cos(b) * (r - 0.6 * sc), 1.5 * sc);
      i += 1;
    );
    ui_col(INK); gfx_circle(cx, cy, r * 0.69, 1, 1);
    ui_col(0x6A4B2B); gfx_circle(cx, cy, r * 0.66, 1, 1);
    ui_cola(0xFFFFFF, 0.08); gfx_circle(cx, cy, r * 0.66, 0, 1);
    ui_col(AMB); sg_lnp(cx + ca * r * 0.16, cy + sa * r * 0.16, cx + ca * r * 0.6, cy + sa * r * 0.6, max(2.4 * sc, r * 0.1));
  ) : (
    // the precision knob: a slim bronze cap, a champagne collar, an amber index
    ui_col(INK); gfx_circle(cx, cy, r, 1, 1);
    ui_col(FACEL); gfx_circle(cx, cy, r - 1.2 * sc, 1, 1);
    ui_col(BRZ); gfx_circle(cx, cy, r * 0.76, 1, 1);
    ui_cola(0xFFFFFF, 0.1); gfx_circle(cx, cy, r * 0.76, 0, 1);
    ui_col(AMB); sg_lnp(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * r * 0.7, cy + sa * r * 0.7, max(2 * sc, r * 0.12));
  );
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps
function sg_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp, big) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - sg_lt < 0.35 && sg_lid == idx && !sg_mv) || (mouse_cap & 4) ? ( sg_set(idx, def); drag_id = -1; sg_lt = 0; ) : (
      drag_id = did; sg_ky = mouse_y; sg_ky0 = mouse_y; sg_mv = 0; sg_lt = time_precise(); sg_lid = idx;
      sg_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !sg_mv && abs(mouse_y - sg_ky0) > 3 * sc ? ( sg_mv = 1; sg_ky = mouse_y; );
  drag_id == did && sg_mv ? (
    sg_kn = min(max(sg_kn + (sg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); sg_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ sg_kn : lo + sg_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? sg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    sg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  sg_kcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), lo < 0 && hi > 0, big);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.13); gfx_circle(cx * sc, cy * sc, r * 0.66 * sc, 1, 1);
    sprintf(#sg_vv, fmt, v);
    sg_pill(cx, cy + r + 6, #sg_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(strlen(label) > 8 ? 11 : 13); ui_col(LBL); sg_tc(cx, cy + r + (big ? 18 : 14), label); );
  );
);

// ---------- lit keys (amber = on); returns 1 when clicked ----------
function sg_key(x, y, w, h, on, s) local(hov, hit) (
  hov = sg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(AMBL, 0.4); sg_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.3); sg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); sg_rr(x, y, w, h, 3);
  ui_col(on ? AMB : hov ? KEYHOV : KEYOFF); sg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.45); sg_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.12); sg_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? INK : KEYT); sg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function sg_keys(x, y, w, h, gap, idx, lo, n, labels) local(i) (
  i = 0;
  loop(n, sg_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == lo + i, pk_pitem(labels, i + 1, #sg_k)) ? sg_set(idx, lo + i); i += 1; );
);
function sg_toggle(x, y, w, h, idx, s) ( sg_key(x, y, w, h, slider(idx) >= 0.5, s) ? sg_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// ---------- the drop-down box: shows the setting in amber; a click opens the list (the current one ticked), the wheel steps ----------
// list = the menu's items ("|"), n of them, for the values lo .. lo + n - 1; s = what the box shows
function sg_dd(x, y, w, h, idx, lo, n, list, s) local(hov, i, k) (
  hov = sg_hov(x, y, w, h);
  ui_cola(0x000000, 0.25); sg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); sg_rr(x, y, w, h, 3);
  ui_col(hov ? SCRH : SCR); sg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(13); ui_col(AMB); sg_tc(x + (w - 12) * 0.5, y + h * 0.5, s);
  ui_col(AMBD); gfx_triangle((x + w - 15) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 7) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 11) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1; strcpy(#sg_m, ""); i = 0; k = floor(slider(idx) + 0.5) - lo;
    loop(n, i == k ? strcat(#sg_m, "!"); strcat(#sg_m, pk_pitem(list, i + 1, #sg_k)); i < n - 1 ? strcat(#sg_m, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#sg_m); i > 0 ? sg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    sg_set(idx, min(max(floor(slider(idx) + 0.5) - sign(mouse_wheel), lo), lo + n - 1)); mouse_wheel = 0;
  );
);
function sg_nname(n) local(o) (
  o = floor(n / 12) - 1;
  sprintf(#sg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #sg_k), o);
  #sg_nn;
);
function sg_pcname(pc) ( pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", pc + 1, #sg_pn); );
// a small sun: a disc and its rays
function sg_sun(cx, cy, r, n, col, a0) local(i, a) (
  ui_col(col); i = 0;
  loop(n, a = a0 + i / n * 2 * $pi;
    gfx_triangle((cx + sin(a - 0.13) * r * 1.12) * sc, (cy - cos(a - 0.13) * r * 1.12) * sc,
                 (cx + sin(a + 0.13) * r * 1.12) * sc, (cy - cos(a + 0.13) * r * 1.12) * sc,
                 (cx + sin(a) * r * 1.6) * sc, (cy - cos(a) * r * 1.6) * sc);
    i += 1; );
  sg_disc(cx, cy, r);
);
function sg_swara(t, k) local(o) (
  o = su_toff(t, k); o == -5 ? "PA" : o == -7 ? "MA" : o == -1 ? "NI" : o == -12 ? "SA ." : "SA";
);

// ======================== the faceplate: champagne-gold brushed aluminium ========================
ui_col(FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); sg_rr(4, 4, 1192, 842, 9);
ui_col(FACEL); sg_rr(6.5, 6.5, 1187, 837, 7);
ui_col(INK); sg_r(11, 11, 1178, 828);
ui_col(FACE); sg_r(13, 13, 1174, 824);
sg_brush(13, 59, 1174, 708, 280, 5.3);
// the sunburst: razor-thin rays from the display's centre (they show in the gutters and round the edges)
sg_i = 0;
loop(144,
  sg_a = sg_i / 144 * 2 * $pi;
  ui_cola(sg_i % 6 == 0 ? AMBD : BRZ, sg_i % 6 == 0 ? 0.42 : 0.16);
  gfx_line((600 + sin(sg_a) * 205) * sc, (270 - cos(sg_a) * 205) * sc, (600 + sin(sg_a) * 1100) * sc, (270 - cos(sg_a) * 1100) * sc, 1);
  sg_i += 1;
);
// the header: deep bronze, ruled in amber
ui_col(BRZD); sg_r(13, 13, 1174, 44);
ui_col(AMB); sg_r(13, 57, 1174, 2);
// the numeral on a sun
sg_sun(600, 35, 19, 16, AMBD, 0.1);
ui_col(INK); sg_disc(600, 35, 20.5); ui_col(AMB); sg_ring(600, 35, 19.5); ui_col(FACEL); sg_disc(600, 35, 18);
ui_cola(AMBD, 0.6); sg_ring(600, 35, 15.5);
gfx_setfont(15); ui_col(INK); sg_tc(600, 35.5, "XIX");
// presets
pk_pextra = "Reset all to defaults";
sg_k_ = pk_preset(22 * sc, 18 * sc, 330 * sc, 34 * sc, pr_cur, #su_pm);
sg_k_ > 0 ? ( sg_k_ > su_npre ? reset_all() : load_preset(sg_k_); );
gfx_setfont(12); ui_col(AMB); sg_t(366, 18, "SOLAR DRONE"); ui_col(CHL); sg_t(366, 35, "TANPURA · SEVEN RINGS");
// MIDI: activity and channel
pk_led(668 * sc, 35 * sc, 4.5 * sc, ins_midi_lit(), AMB);
gfx_setfont(11); ui_col(CHL); sg_tc(668, 21, "MIDI");
sprintf(#sg_g, slider42 < 0.5 ? "OMNI" : "CH %.0f", slider42);
sg_dd(684, 22, 86, 26, 42, 0, 17, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", #sg_g);
// the clock's state
ui_col(INK); sg_rr(782, 22, 324, 26, 3); ui_col(SCR); sg_rr(783.5, 23.5, 321, 23, 2);
gfx_setfont(11); ui_col(AMB);
sg_t_ = (play_state & 1) ? "LOCKED TO REAPER" : "FREE RUN AT THE TEMPO";
sprintf(#sg_g, "%s  ·  %.0f BPM  ·  BAR %d", sg_t_, su_tmp, floor(su_bp / su_bpb) + 1);
sg_tc(944, 35, #sg_g);
ui_size_picker(1118 * sc, 26 * sc);

// ======================== TANPURA ========================
sg_sect(22, 72, 370, 344, "TANPURA");
sg_toggle(222, 74, 88, 20, 158, "TRANSPORT");
sg_toggle(318, 74, 66, 20, 1, "PLAY");
sg_cap(34, 101, "TUNING"); sg_cap(216, 101, "PLUCK RATE");
sg_dd(34, 117, 174, 26, 2, 0, 6, "Pa - Sa - Sa - Sa  (the lower 5th)|Ma - Sa - Sa - Sa  (the lower 4th)|Ni - Sa - Sa - Sa  (the major 7th)|Sa - Sa - Sa - Sa|Pa - Ni - Sa - Sa - Sa  (five strings)|Ma - Ni - Sa - Sa - Sa  (five strings)",
      pk_pitem("PA-SA-SA-SA|MA-SA-SA-SA|NI-SA-SA-SA|SA-SA-SA-SA|PA-NI-SA-SA-SA|MA-NI-SA-SA-SA", floor(slider2 + 0.5) + 1, #sg_k2));
sg_toggle(216, 117, 70, 26, 7, "SYNC");
sg_dd(294, 117, 86, 26, 8, 0, 7, "1/8|1/4|1/4 dotted|1/2|1/2 dotted|1 bar|2 bars",
      pk_pitem("1/8|1/4|1/4D|1/2|1/2D|1 BAR|2 BARS", floor(slider8 + 0.5) + 1, #sg_k2));
slider7 < 0.5 ? ( ui_cola(TRAY, 0.55); sg_r(292, 115, 90, 30); );
// the heat-sinks
sg_knob(76, 178, 20, 3, 0, 100, 55, 0, "JAWARI", "%.0f%%", 0, 1);
sg_knob(164, 178, 20, 4, 0, 100, 50, 0, "BRIGHTNESS", "%.0f%%", 0, 1);
sg_knob(252, 178, 20, 5, 2, 30, 9, 1, "DECAY", "%.1f s", 0, 1);
sg_knob(340, 178, 20, 10, 0, 100, 70, 0, "LEVEL", "%.0f%%", 0, 1);
sg_knob(76, 258, 20, 6, 0.3, 6, 1.4, 1, slider7 >= 0.5 ? "(RATE)" : "RATE", "%.2f s", 0, 1);
slider7 >= 0.5 ? ( ui_cola(TRAY, 0.55); sg_disc(76, 258, 27); );
sg_knob(164, 258, 20, 9, 0, 100, 25, 0, "HUMANISE", "%.0f%%", 0, 1);
sg_knob(252, 258, 20, 11, 0, 100, 60, 0, "PAN SPREAD", "%.0f%%", 0, 1);
// the strings: a lamp for each, lit as it is plucked and glowing while it rings
ui_col(INK); sg_rr(304, 232, 76, 58, 4); ui_col(SCR); sg_rr(305.5, 233.5, 73, 55, 3);
sg_ns = su_ns; sg_tun = floor(slider2 + 0.5);
sg_i = 0;
loop(sg_ns,
  sg_x = 342 + (sg_i - (sg_ns - 1) * 0.5) * 14;
  sg_e = min(SUSE[sg_i * 4] * 6, 1);
  SUSE[sg_i * 4 + 2] != SGA[20 + sg_i] ? ( SGA[20 + sg_i] = SUSE[sg_i * 4 + 2]; SGA[30 + sg_i] = 1; );
  SGA[30 + sg_i] *= 0.88;
  sg_g = max(sg_e * 0.6, SGA[30 + sg_i]);
  ui_cola(AMB, 0.25 * sg_g); sg_disc(sg_x, 250, 6.5);
  ui_col(ui_mix(AMBF, AMBL, sg_g)); sg_disc(sg_x, 250, 4);
  gfx_setfont(11); ui_col(ui_mix(AMBD, AMBL, SGA[30 + sg_i])); sg_tc(sg_x, 272, strncpy(#sg_sw, sg_swara(sg_tun, sg_i), 1));
  sg_i += 1;
);
// the envelopes: AMP / FILTER pick which one the four knobs set; its shape beside the keys; the tone filter after them
ui_cola(INK, 0.35); sg_r(34, 304, 346, 1);
sg_key(34, 312, 62, 22, sg_ten == 0, "AMP") ? sg_ten = 0;
sg_key(100, 312, 62, 22, sg_ten == 1, "FILTER") ? sg_ten = 1;
sg_eb = sg_ten ? 154 : 147;
ui_col(INK); sg_rr(170, 312, 210, 22, 3); ui_col(SCR); sg_rr(171.5, 313.5, 207, 19, 2);
sg_ea = log(1 + slider(sg_eb)); sg_ed = log(1 + slider(sg_eb + 1)); sg_es = slider(sg_eb + 2) / 100;
sg_hold = !sg_ten && slider150 >= 19999;
sg_er = sg_hold ? 0 : log(1 + slider(sg_eb + 3));
sg_tt = sg_ea + sg_ed + sg_er + 2.5; sg_sx = 196 / sg_tt; sg_x = 177;
ui_col(AMB);
sg_ln(sg_x, 329, sg_x + sg_ea * sg_sx, 317, 1.3); sg_x += sg_ea * sg_sx;
sg_ln(sg_x, 317, sg_x + sg_ed * sg_sx, 329 - 12 * sg_es, 1.3); sg_x += sg_ed * sg_sx;
sg_hold ? sg_ln(sg_x, 329 - 12 * sg_es, 373, 329 - 12 * sg_es, 1.3) : (
  sg_ln(sg_x, 329 - 12 * sg_es, sg_x + 2.5 * sg_sx, 329 - 12 * sg_es, 1.3); sg_x += 2.5 * sg_sx;
  sg_ln(sg_x, 329 - 12 * sg_es, 373, 329, 1.3);
);
sg_knob(52, 362, 14, sg_eb, 0, 5000, sg_ten ? 2 : 0, 0, "ATT", "%.0f ms", 0, 0);
sg_knob(100, 362, 14, sg_eb + 1, 5, 10000, sg_ten ? 900 : 1000, 1, "DEC", "%.0f ms", 0, 0);
sg_knob(148, 362, 14, sg_eb + 2, 0, 100, sg_ten ? 20 : 100, 0, "SUS", "%.0f%%", 0, 0);
sg_ten ? sg_knob(196, 362, 14, 157, 10, 20000, 1500, 1, "REL", "%.0f ms", 0, 0) :
         sg_knob(196, 362, 14, 150, 10, 20000, 20000, 1, "REL", slider150 >= 19999 ? "HOLD" : "%.0f ms", 0, 0);
ui_cola(INK, 0.35); sg_r(229.5, 344, 1, 52);
sg_knob(264, 362, 14, 151, 40, 20000, 20000, 1, "CUTOFF", "%.0f Hz", 0, 0);
sg_knob(314, 362, 14, 152, 0, 100, 0, 0, "RESO", "%.0f%%", 0, 0);
sg_knob(362, 362, 14, 153, -100, 100, 0, 0, "ENV", "%+.0f%%", 0, 0);

// ======================== LISTEN ========================
sg_sect(22, 426, 370, 178, "LISTEN");
sg_src = floor(slider12 + 0.5);
pk_led(372 * sc, 438 * sc, 4.5 * sc, su_nret != sg_nret0 || time_precise() - sg_rlt < 0.4, AMB);
su_nret != sg_nret0 ? ( sg_nret0 = su_nret; sg_rlt = time_precise(); );
sg_cap(34, 434 + 24, "SOURCE");
sg_keys(34, 474, 74, 28, 6, 12, 0, 3, "MIDI|AUDIO|OFF");
sg_knob(330, 488, 15, 16, -70, -20, -45, 0, "GATE", "%.0f dB", 0, 0);
sg_src != 1 ? ( ui_cola(TRAY, 0.55); sg_disc(330, 488, 22); );
sg_cap(34, 512, "EVERY"); sg_cap(152, 512, "ROOT"); sg_cap(238, 512, "OCTAVE");
sg_dd(34, 528, 108, 28, 13, 0, 5, "Every bar|Every 2 bars|Every 4 bars|Every 8 bars|Every 16 bars",
      pk_pitem("1 BAR|2 BARS|4 BARS|8 BARS|16 BARS", floor(slider13 + 0.5) + 1, #sg_k2));
sg_dd(152, 528, 76, 28, 14, 0, 12, "C|C#|D|D#|E|F|F#|G|G#|A|A#|B", sg_pcname(floor(slider14 + 0.5)));
sprintf(#sg_g, "%d", floor(slider15 + 0.5));
sg_dd(238, 528, 70, 28, 15, 1, 5, "1|2|3|4|5", #sg_g);
sg_src != 2 ? ( ui_cola(TRAY, 0.5); sg_r(150, 526, 80, 32); );
// Sa now, the root that waits, and the way to the next bar line on the divider
ui_col(INK); sg_rr(34, 566, 346, 28, 3); ui_col(SCR); sg_rr(35.5, 567.5, 343, 25, 2);
sg_left = max(su_lnext - su_bp, 0) / su_lper; sg_left = min(max(sg_left, 0), 1);
ui_cola(AMB, 0.22); sg_r(37, 569, 339 * (1 - sg_left), 21);
gfx_setfont(13); ui_col(AMBL);
sg_src == 2 ? strcpy(#sg_g, "FIXED ROOT") : (
  su_pend >= 0 && su_pend != su_pc ? sprintf(#sg_g, "NEXT %s", sg_pcname(su_pend)) : strcpy(#sg_g, "LISTENING");
);
sg_t(46, 572, #sg_g);
sg_src != 2 ? (
  sg_bl = max(ceil((su_lnext - su_bp) / su_bpb - 0.001), 1);
  sprintf(#sg_g, sg_bl == 1 ? "AT THE NEXT BAR" : "IN %d BARS", sg_bl); sg_tr(370, 580, #sg_g);
);

// ======================== THE SUN: the display ========================
ui_cola(0x000000, 0.32); sg_rr(405, 76, 396, 396, 14);
ui_col(INK); sg_rr(402, 72, 396, 396, 14);
ui_col(BRZ); sg_rr(405.5, 75.5, 389, 389, 11.5);
ui_cola(0xFFFFFF, 0.12); sg_rr(405.5, 75.5, 389, 2, 1);
ui_col(SCR); sg_rr(412, 82, 376, 376, 9);
sg_cx = 600; sg_cy = 270;
// the guide: faint rays and the seven tracks
sg_i = 0; loop(12, sg_a = sg_i / 12 * 2 * $pi; ui_cola(AMBF, 1); gfx_line((sg_cx + sin(sg_a) * 84) * sc, (sg_cy - cos(sg_a) * 84) * sc, (sg_cx + sin(sg_a) * 186) * sc, (sg_cy - cos(sg_a) * 186) * sc, 1); sg_i += 1; );
// pick a ring: a click on its circle, or the keys 1 - 7
sg_dx = mouse_x / sc - sg_cx; sg_dy = mouse_y / sc - sg_cy; sg_d = sqrt(sg_dx * sg_dx + sg_dy * sg_dy);
pressed && drag_id == 0 && sg_d > 88 && sg_d < 190 ? ( sg_sel = min(max(floor((sg_d - 89) / 14 + 0.5), 0), 6); drag_id = -1; );
ui_nm_ed < 0 ? ( loop(4, sg_c = gfx_getchar(); sg_c >= 49 && sg_c <= 55 ? sg_sel = sg_c - 49; ); );
sg_k = 0;
loop(7,
  sg_q = SURG + sg_k * 40; sg_b = 49 + sg_k * 14; sg_rad = 96 + sg_k * 14;
  sg_on = slider(sg_b) >= 0.5;
  // its glow: the voices' levels and velocities
  sg_act = 0; sg_vi = 0;
  loop(3, sg_v = SUVO + (sg_k * 3 + sg_vi) * 32; sg_v[0] ? sg_act = max(sg_act, sg_v[1] * sg_v[7] * (sg_v[0] == 4 ? sg_v[11] : 1)); sg_vi += 1; );
  SGA[sg_k] = max(sg_act, SGA[sg_k] * 0.86);
  sg_g = min(SGA[sg_k] * 1.4, 1);
  sg_k == sg_sel ? ( ui_cola(CHL, 0.5); sg_ring(sg_cx, sg_cy, sg_rad); ui_cola(CHL, 0.18); sg_ring(sg_cx, sg_cy, sg_rad + 1); ) :
                   ( ui_cola(AMB, (sg_on ? 0.12 : 0.05) + 0.35 * sg_g * sg_on); sg_ring(sg_cx, sg_cy, sg_rad); );
  // its LEDs: thirty-six; its scale's notes faintly lit (Sa at the top)
  sg_sc = SUSC + sg_q[11] * 8; sg_n = sg_sc[0];
  sg_j = 0;
  loop(36,
    sg_a = sg_j / 36 * 2 * $pi; sg_x = sg_cx + sin(sg_a) * sg_rad; sg_y = sg_cy - cos(sg_a) * sg_rad;
    sg_in = 0; sg_j % 3 == 0 ? ( sg_m = 0; loop(sg_n, sg_sc[1 + sg_m] == sg_j / 3 ? sg_in = 1; sg_m += 1; ); );
    sg_in ? ( ui_col(sg_on ? ui_mix(AMBD, AMB, 0.6 * sg_g) : 0x5A3810); sg_disc(sg_x, sg_y, 2.2); ) :
            ( ui_col(sg_on ? 0x4A2C0A : 0x2A190A); sg_disc(sg_x, sg_y, sg_j % 3 == 0 ? 1.5 : 1.1); );
    sg_j += 1;
  );
  // its notes now: a bloom at each note's place
  sg_vi = 0;
  loop(3,
    sg_v = SUVO + (sg_k * 3 + sg_vi) * 32;
    sg_v[0] ? (
      sg_e = sg_v[1] * sg_v[7] * (sg_v[0] == 4 ? sg_v[11] : 1);
      sg_e > 0.004 ? (
        sg_pc = sg_v[10] - su_sa; sg_pc -= 12 * floor(sg_pc / 12);
        sg_a = sg_pc / 12 * 2 * $pi; sg_x = sg_cx + sin(sg_a) * sg_rad; sg_y = sg_cy - cos(sg_a) * sg_rad;
        sg_e = min(sg_e * 1.5, 1);
        ui_cola(AMB, 0.16 * sg_e); sg_disc(sg_x, sg_y, 4 + 7 * sg_e);
        ui_cola(AMB, 0.35 * sg_e); sg_disc(sg_x, sg_y, 2.5 + 3.5 * sg_e);
        ui_col(ui_mix(AMBD, AMBL, sg_e)); sg_disc(sg_x, sg_y, 2.3 + 1.2 * sg_e);
      );
    );
    sg_vi += 1;
  );
  sg_k += 1;
);
// the core: the tanpura's strings as a corona (their sum round the circle, over two periods of the lowest string)
sg_f = 440 * 2 ^ ((su_sa - 12 - 69) / 12); sg_n = min(floor(srate / sg_f), 1800);   // (the buffer holds every 2nd sample)
sg_w = su_scw; sg_st = sg_w - sg_n - 4;
sg_j = 0; loop(min(floor(srate / sg_f / 2), 600), sg_a = SUSCP[(sg_st - 1) & SUSCM]; sg_b = SUSCP[sg_st & SUSCM]; sg_a < 0 && sg_b >= 0 ? sg_j = 1000000 : sg_st -= 1; sg_j += 1; );
sg_pk = 0.0001; sg_i = 0; loop(sg_n, sg_pk = max(sg_pk, abs(SUSCP[(sg_st + sg_i) & SUSCM])); sg_i += 1; );
sg_spk = max(sg_pk, sg_spk * 0.97);
ui_cola(AMB, 0.1); sg_disc(sg_cx, sg_cy, 50);
sg_i = 0;
loop(161,
  sg_a = sg_i / 160 * 2 * $pi;
  sg_s = SUSCP[(sg_st + floor(sg_i / 160 * sg_n)) & SUSCM] / sg_spk;
  sg_x = sg_cx + sin(sg_a) * (52 + 22 * sg_s); sg_y = sg_cy - cos(sg_a) * (52 + 22 * sg_s);
  sg_i > 0 ? ( ui_cola(AMB, 0.22); sg_ln(sg_ox, sg_oy, sg_x, sg_y, 3.2); ui_col(AMBL); sg_ln(sg_ox, sg_oy, sg_x, sg_y, 1.1); );
  sg_ox = sg_x; sg_oy = sg_y; sg_i += 1;
);
// and their interference: the outer strings against the Sa pair (a Lissajous)
sg_px = sg_py = 0.0001; sg_i = 0;
loop(400, sg_px = max(sg_px, abs(SUSCX[(sg_w - 400 + sg_i) & SUSCM])); sg_py = max(sg_py, abs(SUSCY[(sg_w - 400 + sg_i) & SUSCM])); sg_i += 1; );
sg_lpx = max(sg_px, sg_lpx * 0.97); sg_lpy = max(sg_py, sg_lpy * 0.97);
sg_i = 0;
loop(200,
  sg_x = sg_cx + SUSCX[(sg_w - 200 + sg_i) & SUSCM] / sg_lpx * 30; sg_y = sg_cy - SUSCY[(sg_w - 200 + sg_i) & SUSCM] / sg_lpy * 30;
  sg_i > 0 ? ( ui_cola(AMB, 0.5); sg_ln(sg_ox, sg_oy, sg_x, sg_y, 1); );
  sg_ox = sg_x; sg_oy = sg_y; sg_i += 1;
);
// the readouts in the corners
gfx_setfont(11); ui_col(AMBD); sg_t(424, 90, "SA");
gfx_setfont(12); ui_col(AMBL); sg_t(424, 104, sg_nname(su_sa));
gfx_setfont(11); ui_col(AMBD);
sg_src == 2 ? strcpy(#sg_g, "FIXED ROOT") : sprintf(#sg_g, "%s · EVERY %s", sg_src == 0 ? "MIDI" : "AUDIO", pk_pitem("BAR|2 BARS|4 BARS|8 BARS|16 BARS", floor(slider13 + 0.5) + 1, #sg_k2));
sg_tr(776, 96, #sg_g);
sg_src != 2 ? (
  gfx_setfont(11); ui_col(AMBD); sg_t(424, 422, "NEXT");
  gfx_setfont(12); ui_col(su_pend >= 0 && su_pend != su_pc ? AMBL : AMBD);
  sg_t(424, 436, su_pend >= 0 ? sg_pcname(su_pend) : "-");
  gfx_setfont(11); ui_col(AMBD); sprintf(#sg_g, "%d", sg_bl); sg_tr(776, 430, sg_bl == 1 ? "NEXT BAR" : "BARS");
  gfx_setfont(12); ui_col(AMBL); sg_tr(776, 446, sg_bl == 1 ? "" : #sg_g);
);

// ======================== the seven rings at a glance ========================
sg_sect(402, 478, 396, 126, "THE SEVEN RINGS");
sg_k = 0;
loop(7,
  sg_x = 410 + sg_k * 55; sg_b = 49 + sg_k * 14;
  sprintf(#sg_g, "%d", sg_k + 1);
  sg_key(sg_x + 3, 510, 48, 24, sg_k == sg_sel, #sg_g) ? sg_sel = sg_k;
  sg_on = slider(sg_b) >= 0.5;
  pk_led((sg_x + 27) * sc, 545 * sc, 4 * sc, sg_on, AMB);
  sg_hov(sg_x + 3, 539, 48, 13) && pressed && drag_id == 0 ? ( drag_id = -1; sg_set(sg_b, sg_on ? 0 : 1); );
  gfx_setfont(11); ui_col(sg_on ? LBL : FACED);
  sg_tc(sg_x + 27, 561, pk_pitem("GLOBAL|MAJOR|DORIAN|PHRYG|LYDIAN|MIXO|AEOL|LOCR|H.MIN|BHAIRV|YAMAN|KAFI|BHRVI|P.MAJ|P.MIN", floor(slider(sg_b + 8) + 0.5) + 1, #sg_k2));
  sg_tc(sg_x + 27, 576, pk_pitem("UP|DOWN|UP/DN|PLAYED|CHORD|2ND|3RD|RAND", floor(slider(sg_b + 11) + 0.5) + 1, #sg_k2));
  ui_col(INK); sg_r(sg_x + 6, 588, 42, 6); ui_col(SCR); sg_r(sg_x + 7, 589, 40, 4);
  ui_col(sg_on ? AMB : AMBD); sg_r(sg_x + 7, 589, 40 * slider(sg_b + 1) / 100, 4);
  sg_k += 1;
);

// ======================== RING n: the edit panel ========================
sg_b = 49 + sg_sel * 14; sg_dir = sg_sel < floor(slider18 + 0.5);
sprintf(#sg_g, "RING %d  ·  %s", sg_sel + 1, sg_dir ? "RADIATES ABOVE SA" : "RADIATES BELOW SA");
sg_sect(808, 72, 370, 396, #sg_g);
sg_toggle(1106, 74, 66, 20, sg_b, "ON");
sg_k = 0;
loop(7, sprintf(#sg_g, "%d", sg_k + 1); sg_key(820 + sg_k * 50, 104, 44, 26, sg_k == sg_sel, #sg_g) ? sg_sel = sg_k; sg_k += 1; );
sg_cap(820, 142, "SCALE"); sg_cap(1000, 142, "PATTERN");
sg_scl = floor(slider(sg_b + 8) + 0.5);
sg_scl == 0 ? sprintf(#sg_g, "GLOBAL (%s)", pk_pitem("MAJOR|DORIAN|PHRYGIAN|LYDIAN|MIXOLYDIAN|AEOLIAN|LOCRIAN|HARM MINOR|BHAIRAV|YAMAN|KAFI|BHAIRAVI|PENTA MAJ|PENTA MIN", floor(slider17 + 0.5) + 1, #sg_k2)) :
              strcpy(#sg_g, pk_pitem("GLOBAL|MAJOR|DORIAN|PHRYGIAN|LYDIAN|MIXOLYDIAN|AEOLIAN|LOCRIAN|HARMONIC MINOR|BHAIRAV|YAMAN|KAFI|BHAIRAVI|PENTATONIC MAJ|PENTATONIC MIN", sg_scl + 1, #sg_k2));
sg_dd(820, 158, 172, 28, sg_b + 8, 0, 15, "Global (the harmony's scale)|Major (Ionian)|Dorian|Phrygian|Lydian|Mixolydian|Aeolian (natural minor)|Locrian|Harmonic minor|Bhairav|Yaman|Kafi|Bhairavi|Pentatonic major|Pentatonic minor", #sg_g);
sg_dd(1000, 158, 166, 28, sg_b + 11, 0, 8, "Up|Down|Up / Down|As played (the keys held)|Chord|Every other|Every third|Random",
      pk_pitem("UP|DOWN|UP / DOWN|AS PLAYED|CHORD|EVERY OTHER|EVERY THIRD|RANDOM", floor(slider(sg_b + 11) + 0.5) + 1, #sg_k2));
sg_cap(820, 200, "RATE"); sg_cap(940, 200, "NOTES");
sg_dd(820, 216, 106, 28, sg_b + 12, 0, 9, "4 bars|2 bars|1 bar|1/2|1/4|1/4 triplet|1/8|1/8 triplet|1/16",
      pk_pitem("4 BARS|2 BARS|1 BAR|1/2|1/4|1/4T|1/8|1/8T|1/16", floor(slider(sg_b + 12) + 0.5) + 1, #sg_k2));
sg_keys(940, 216, 28, 28, 4, sg_b + 13, 1, 7, "1|2|3|4|5|6|7");
slider19 >= 0.5 ? (
  sg_cap(820, 266, "INTERVAL");
  sg_dd(820, 282, 96, 28, sg_b + 10, 0, 8, "Unison|Minor 3rd|Major 3rd|4th|5th|Minor 6th|Major 6th|Octave",
        pk_pitem("UNISON|MIN 3RD|MAJ 3RD|4TH|5TH|MIN 6TH|MAJ 6TH|OCTAVE", floor(slider(sg_b + 10) + 0.5) + 1, #sg_k2));
  gfx_setfont(11); ui_col(LBL); sg_tc(868, 326, sg_dir ? "UP" : "DOWN");
) : (
  sg_knob(866, 296, 20, sg_b + 9, -14, 14, 0, 0, "TRANSPOSE", "%+.0f degrees", 1, 0);
);
sg_knob(956, 296, 20, sg_b + 1, 0, 100, 50, 0, "LEVEL", "%.0f%%", 0, 0);
sg_knob(1046, 296, 20, sg_b + 6, 0, 100, 50, 0, "TIMBRE", "%.0f%%", 0, 0);
sg_knob(1136, 296, 20, sg_b + 7, -100, 100, 0, 0, "PAN", "%+.0f", 0, 0);
// the envelope's shape
ui_col(INK); sg_rr(820, 344, 346, 28, 3); ui_col(SCR); sg_rr(821.5, 345.5, 343, 25, 2);
sg_ea = log(1 + slider(sg_b + 2)); sg_ed = log(1 + slider(sg_b + 3)); sg_er = log(1 + slider(sg_b + 5)); sg_es = slider(sg_b + 4) / 100;
sg_tt = sg_ea + sg_ed + sg_er + 2; sg_sx = 330 / sg_tt; sg_x = 828;
ui_col(AMB);
sg_ln(sg_x, 366, sg_x + sg_ea * sg_sx, 350, 1.4); sg_x += sg_ea * sg_sx;
sg_ln(sg_x, 350, sg_x + sg_ed * sg_sx, 366 - 16 * sg_es, 1.4); sg_x += sg_ed * sg_sx;
sg_ln(sg_x, 366 - 16 * sg_es, sg_x + 2 * sg_sx, 366 - 16 * sg_es, 1.4); sg_x += 2 * sg_sx;
sg_ln(sg_x, 366 - 16 * sg_es, 1158, 366, 1.4);
sg_knob(866, 406, 18, sg_b + 2, 1, 8000, 15, 1, "ATTACK", "%.0f ms", 0, 0);
sg_knob(956, 406, 18, sg_b + 3, 5, 10000, 900, 1, "DECAY", "%.0f ms", 0, 0);
sg_knob(1046, 406, 18, sg_b + 4, 0, 100, 50, 0, "SUSTAIN", "%.0f%%", 0, 0);
sg_knob(1136, 406, 18, sg_b + 5, 5, 12000, 1600, 1, "RELEASE", "%.0f ms", 0, 0);

// ======================== HARMONY: all rings ========================
sg_sect(808, 478, 370, 126, "HARMONY  ·  ALL RINGS");
sg_cap(820, 506, "GLOBAL SCALE"); sg_cap(1000, 506, "ABOVE  ·  BELOW");
sg_dd(820, 522, 172, 28, 17, 0, 14, "Major (Ionian)|Dorian|Phrygian|Lydian|Mixolydian|Aeolian (natural minor)|Locrian|Harmonic minor|Bhairav|Yaman|Kafi|Bhairavi|Pentatonic major|Pentatonic minor",
      pk_pitem("MAJOR|DORIAN|PHRYGIAN|LYDIAN|MIXOLYDIAN|AEOLIAN|LOCRIAN|HARMONIC MINOR|BHAIRAV|YAMAN|KAFI|BHAIRAVI|PENTATONIC MAJ|PENTATONIC MIN", floor(slider17 + 0.5) + 1, #sg_k2));
sprintf(#sg_g, "%d UP  ·  %d DOWN", floor(slider18 + 0.5), 7 - floor(slider18 + 0.5));
sg_dd(1000, 522, 166, 28, 18, 0, 8, "All seven below|1 above, 6 below|2 above, 5 below|3 above, 4 below|4 above, 3 below|5 above, 2 below|6 above, 1 below|All seven above", #sg_g);
sg_keys(820, 560, 76, 26, 6, 19, 0, 2, "DEGREE|INTERVAL");
sg_knob(1000, 568, 13, 20, 0, 100, 85, 0, "GEN", "%.0f%%", 0, 0);
sg_knob(1052, 568, 13, 21, 0, 100, 30, 0, "VELO", "%.0f%%", 0, 0);
sg_knob(1106, 568, 13, 22, 0, 100, 50, 0, "KEYS", "%.0f%%", 0, 0);
sg_knob(1156, 568, 13, 23, 0, 100, 70, 0, "LEVEL", "%.0f%%", 0, 0);

// ======================== the light's path: DELAY, CHORUS, WIDTH, TAIL ========================
sg_sect(22, 614, 420, 146, "DELAY");
sg_toggle(368, 616, 66, 20, 24, "IN");
sg_cap(34, 648, "TIME");
sg_dd(34, 664, 96, 28, 25, 0, 10, "1/16|1/8 triplet|1/8|1/4 triplet|1/8 dotted|1/4|1/4 dotted|1/2|1/2 dotted|1 bar",
