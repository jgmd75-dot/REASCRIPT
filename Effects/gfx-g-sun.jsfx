sg_sun(400, 803, 9, 12, AMB, time_precise() * 0.05); sg_sun(800, 803, 9, 12, AMB, -time_precise() * 0.05);
ins_io(960, 785, 43, CHL);
sg_lv = min(max((20 * log10(max(su_pk, 0.00001)) + 48) / 48, 0), 1); su_pk *= 0.8;
ui_col(INK); sg_r(1060, 802, 112, 14); ui_col(SCR); sg_r(1061.5, 803.5, 109, 11);
sg_i = 0; loop(18, sg_on = sg_i / 18 < sg_lv; ui_col(sg_on ? (sg_i >= 16 ? 0xFF3A2A : sg_i >= 13 ? AMBL : AMB) : AMBF); sg_r(1063 + sg_i * 6, 805, 4.6, 8); sg_i += 1; );
gfx_setfont(11); ui_col(CHL); sg_t(1060, 786, "OUTPUT");

