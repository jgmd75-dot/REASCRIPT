desc:Telemetry [spectrum analyser] (GFX)
//tags: analyser analyzer spectrum fft meter true-peak loudness lufs ebu r128 bs1770 lra k-system correlation goniometer surround
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-ui and gfx-panel (.jsfx-inc) in the same folder.
//
// TELEMETRY: a real-time FFT spectrum analyser with a level, loudness and phase meter suite, a sibling of the
// Meter81 / Tuner81 family (the VFD face: cold turquoise and neon amber on a dark slate panel, flat sharp-cornered
// lit keys, drop-downs, values on hover).
// The audio is NOT touched: the plug-in only reads spl0 .. spl7 and never writes them, so every channel passes
// through bit-exact, with no latency. There is no output stage and no drift (a measuring tool must not wander).
//
// SPECTRUM
//   BLOCK      the FFT size, 1024 .. 32768 samples (REAPER's built-in real FFT). OVERLAP 0 / 50 / 75 / 87.5 %.
//   WINDOW     HANN, BLACKMAN-HARRIS (4-term, deep sidelobes) or FLAT-TOP (5-term: tone levels exact to about
//              0.01 dB wherever the tone falls). Every window's coherent gain is corrected: a sine reads its peak
//              level in dBFS (a -6 dBFS sine reads -6 dB).
//   AVERAGE    time averaging of the power: OFF, FAST (0.1 s), MEDIUM (0.3 s), SLOW (1 s), VERY SLOW (3 s).
//   SMOOTH     fractional-octave smoothing (the mean power over the band): OFF, 1/24, 1/12, 1/6, 1/3 octave.
//              With smoothing OFF each point of the display holds the largest bin it covers (tone peaks stay true).
//   SLOPE      a display tilt of 0, 3 or 4.5 dB per octave about 1 kHz (3 dB/oct shows pink noise flat).
//   TOP / BOTTOM  the dB range;  FREQUENCY  the frequency range of the log axis.  FILL / LINE  the curve style.
//   HOVER      over the spectrum: the nearest spectral peak, refined between the bins - frequency, note and cents
//              (A4 = 440 Hz) and the level in dBFS (the true level: the SLOPE tilt is not included).
//   MODE       STEREO (L and R), MONO (L+R)/2, MID-SIDE (M = (L+R)/2, S = (L-R)/2), LEFT, RIGHT,
//              SURROUND 5.1 / 7.1 (L R C LFE Ls Rs [Lb Rb], one curve each; the channel keys over the spectrum
//              show or hide them, FRONT / SURR / ALL as groups). Up to 8 pins, all passed through untouched.
//   The FFTs run in @block (only while the panel is open or the instance SENDs); @sample only writes ring buffers.
//
// OVERLAYS
//   MAX        a peak-hold curve per channel that falls at the DECAY rate.  ALL-TIME  the highest level ever seen
//              (CLEAR resets both).
//   REFERENCE  four snapshot slots R1 .. R4: FREEZE stores the current spectrum (the power average of the shown
//              curves) in a slot; the R keys show or hide each. The snapshots are saved with the project.
//   SHARE      cross-instance comparison: SEND puts this instance's spectrum (the power average of its shown
//              curves) into one of 8 shared slots; the SHOW keys overlay other instances' slots in their colours
//              (e.g. the kick on one track against the bass on another). Every instance resamples its spectrum to
//              one common log-frequency grid (1024 points, 10 Hz .. 24 kHz) before sharing, so block sizes and
//              sample rates may differ; a slot that has not been refreshed for 1.5 s (the sender was removed,
//              bypassed or went idle) disappears. Tones read alike everywhere; broadband noise sits lower on a
//              larger block (the sine-referenced scale of every FFT analyser).
//
// METERS (always running, whatever is shown)
//   LEVEL      per channel: sample peak (BALLISTICS: FAST 20 dB in 0.75 s, MEDIUM 20 dB in 1.7 s, SLOW 20 dB in
//              3.5 s, instant attack) with a HOLD marker (OFF / 1 / 2 / 5 s / INF), and the RMS (RMS integration
//              50 ms .. 3 s; dBFS: a full-scale sine reads -3 dB).
//              TRUE PEAK per ITU-R BS.1770-4 (4x oversampled, a 48-tap Kaiser-windowed interpolator), held until
//              reset; PEAK MAX; HEADROOM to 0 dBFS and to the true-peak CEILING; CLIP (each run of samples at or
//              above full scale counts once; the lamp stays lit). Click the readouts to reset them.
//   K-SYSTEM   SCALE K-20 / K-14 / K-12: the bars show the RMS (sine-referenced, AES17) with 0 = -20 / -14 / -12
//              dBFS (moved by the calibration OFFSET), green to 0, amber to +4, red above; the peak as a thin bar.
//   LOUDNESS   ITU-R BS.1770-4 / EBU R128: K-weighted, momentary (400 ms), short-term (3 s), integrated (gated
//              -70 LUFS absolute, -10 LU relative), loudness range LRA (EBU Tech 3342: short-term values gated
//              -70 / -20 LU, 10th to 95th percentile), and the distance of the integrated loudness from the TARGET.
//              Surround weights: L R C 1.0, LFE out, the surrounds 1.41. RESET starts the integration afresh.
//   PHASE      correlation (-1 .. +1, 200 ms), a goniometer (M up, auto-ranging), and the correlation in three
//              bands (LOW < 250 Hz, MID 250 Hz - 4 kHz, HIGH > 4 kHz; from the FFT, in STEREO and MID-SIDE).
// WIDE         the spectrum fills the panel; the meters fold into a slim strip on the right.
// GUI: click a key or a drop-down; click the LCD for the preset list. S / M / L / ? = size and help.

options:gmem=GFX_Telemetry
options:maxmem=2097152

import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc

slider1:0<0,6,1{Stereo,Mono,Mid-Side,Left,Right,Surround 5.1,Surround 7.1}>-Mode
slider2:3<0,5,1{1024,2048,4096,8192,16384,32768}>-Block size
slider3:2<0,3,1{0 %,50 %,75 %,87.5 %}>-Overlap
slider4:0<0,2,1{Hann,Blackman-Harris,Flat-top}>-Window
slider5:2<0,4,1{Off,Fast,Medium,Slow,Very slow}>-Average
slider6:0<0,4,1{Off,1/24 oct,1/12 oct,1/6 oct,1/3 oct}>-Smoothing
slider7:2<0,2,1{0 dB/oct,3 dB/oct,4.5 dB/oct}>-Slope
slider8:1<0,5,1{+12 dB,+6 dB,0 dB,-6 dB,-12 dB,-20 dB}>-Range top
slider9:4<0,6,1{-48 dB,-60 dB,-72 dB,-84 dB,-96 dB,-120 dB,-144 dB}>-Range bottom
slider10:0<0,5,1{20 Hz - 20 kHz,10 Hz - 24 kHz,20 Hz - 2 kHz,20 Hz - 500 Hz,200 Hz - 20 kHz,1 kHz - 24 kHz}>-Frequency range
slider11:0<0,1,1{Fill,Line}>-Curve style
slider12:1<0,1,1{Off,On}>-Max hold
slider13:2<0,4,1{1 dB/s,3 dB/s,6 dB/s,12 dB/s,24 dB/s}>-Max decay
slider14:0<0,1,1{Off,On}>-All-time max
slider15:0<0,15,1>-Reference show (bits)
slider16:0<0,8,1{Off,Slot 1,Slot 2,Slot 3,Slot 4,Slot 5,Slot 6,Slot 7,Slot 8}>-Send to slot
slider17:0<0,255,1>-Show slots (bits)
slider18:255<0,255,1>-Surround channels shown (bits)
slider19:1<0,2,1{Fast,Medium,Slow}>-Peak ballistics
slider20:2<0,4,1{Off,1 s,2 s,5 s,Inf}>-Peak hold
slider21:1<0,4,1{50 ms,300 ms,600 ms,1 s,3 s}>-RMS integration
slider22:0<0,3,1{dBFS,K-20,K-14,K-12}>-Meter scale
slider23:3<0,6,1{-3 dB,-2 dB,-1 dB,0 dB,+1 dB,+2 dB,+3 dB}>-K calibration offset
slider24:4<0,5,1{0.0 dBTP,-0.1 dBTP,-0.3 dBTP,-0.5 dBTP,-1.0 dBTP,-2.0 dBTP}>-True-peak ceiling
slider25:0<0,5,1{-23 LUFS,-24 LUFS,-20 LUFS,-18 LUFS,-16 LUFS,-14 LUFS}>-Loudness target
slider26:0<0,1,1{Off,On}>-Wide display
slider27:prs_sel=0<0,10,1{No preset,Init,Mix,Mastering,Low-End Detail,Broadcast R128,K-14 Mastering,Streaming -14,Tone Check,Surround 5.1,Surround 7.1}>-Preset

in_pin:L
in_pin:R
in_pin:C
in_pin:LFE
in_pin:Ls
in_pin:Rs
in_pin:Lb
in_pin:Rb
out_pin:L
out_pin:R
out_pin:C
out_pin:LFE
out_pin:Ls
out_pin:Rs
out_pin:Lb
out_pin:Rb

@init
#ui_man = "gfx-telemetry";                             // the ? pop-up links to this manual
ext_nodenorm = 1;                                       // no anti-denormal noise added to the input: the pass-through stays bit-exact

// =====================================================================================================================
// Memory (the FFT buffers sit on 65536-item boundaries, as REAPER's FFT requires)
// =====================================================================================================================
RB    = 0;                                              // ring buffers: 8 channels x 65536 samples (the panel reads them while
                                                        // the audio writes: a ring twice the largest block keeps them apart)
// the two analysis engines: the panel's (ga, any block size) and the audio thread's (ba: SEND with the panel closed)
FB    = 524288;   FB2  = 589824;                        // ga: FFT work buffers (curve 1 in FB2, kept for the band correlation)
FBB   = 655360;   FB2B = 663552;                        // ba: FFT work buffers (block size up to 8192)
WIN   = 720896;   WINB = 753664;                        // the windows (ga 32768, ba 8192)
PW    = 761856;   PS   = 778244;                        // ga: power per bin, its prefix sums
PWB   = 794640;   PSB  = 798740;                        // ba: the same
RAW   = 802850;                                         // the latest power per bin, largest over the shown curves (hover)
MAPA  = 819240;   MAPB = 820264;   MAPT = 821288;       // ga: bin -> grid map (two bin positions and the kind)
MAPAB = 822312;   MAPBB = 823336;  MAPTB = 824360;      // ba: the same
DBG   = 825400;                                         // the curves on the common grid (dB): 8 x 1024
MXH   = 833600;                                         // max hold (dB)
ATM   = 841800;                                         // all-time max (dB)
SUMP  = 850000;                                         // power average of the shown curves (scratch)
SUMDB = 851030;                                         // ... in dB: what SEND and FREEZE take
REF   = 852060;                                         // 4 reference snapshots x 1024 (dB), then 4 valid flags (panel + @serialize)
GFQ   = 856170;                                         // the grid's frequencies
TPH   = 857200;                                         // the true-peak interpolator: 4 phases x 12 taps
TPB   = 857250;                                         // its delay lines, 8 x 32
TPW   = 857510;                                         // its write positions (8)
KWS   = 857520;                                         // K-weighting states, 8 x 4
MSQ   = 857560;                                         // RMS mean square (8)
BPK   = 857570;                                         // sample peak of this block (8)
BTP   = 857580;                                         // true peak of this block (8)
PKD   = 857590;                                         // the peak bar (dB, with its ballistics) (8)
PKH   = 857600; PKT = 857610;                           // the hold marker (dB) and its age (8 + 8)
TPM   = 857620;                                         // true-peak maximum since reset (linear) (8)
SPM   = 857630;                                         // sample-peak maximum since reset (linear) (8)
CLC   = 857640; CLR = 857650;                           // clip counts and the run flags (8 + 8)
CHW   = 857660;                                         // loudness channel weights (8)
EKB   = 857670;                                         // K-weighted energy of each 100 ms sub-block (a ring of 32)
HIS   = 857710; HIC = 858460;                           // integrated loudness histogram: energy and count per 0.1 dB
LRS   = 859210; LRC = 859960;                           // LRA histogram (short-term values): energy and count
BCOR  = 860720;                                         // band correlation sums: 3 bands x (xy, xx, yy), then the results
COLG  = 860760;                                         // panel scratch: grid position per drawn column (4096)
COLT  = 864860;                                         // panel scratch: tilt per drawn column (4096)
SLOTF = 868960;                                         // panel scratch: shared slot fresh flags (8)
BCV   = 868970;                                         // panel scratch: smoothed band correlation (3)
GSC   = 868980;                                         // panel scratch: a shared slot copied out of gmem (1024)
BAV   = 870016;                                         // ga: averaged power per bin, 8 curves x 16384
BAVB  = 1001100;                                        // ba: averaged power per bin, 8 curves x 4096
ENG   = 1033900;                                        // [0] the CLEAR request handled last (by either engine)
GN    = 1024;                                           // the common grid
G_LO  = 10; G_HI = 24000;
tg_gr = log(G_HI / G_LO) / (GN - 1);
GMB   = 64; GMS = 1040;                                 // gmem: slot s at GMB + s * GMS: [0] stamp, [1] owner id, [2] sequence, then 1024 dB values

// =====================================================================================================================
// Helpers
// =====================================================================================================================
function tg_db(v) ( 20 * log10(max(v, 0.00000001)); );                  // amplitude -> dB, floor -160
function tg_fillv(p, n, v) ( loop(n, p[0] = v; p += 1; ); );
function tg_bi0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= sqr(x / (2 * k)); s += t; k += 1; ); s; );

// ---------- the true-peak interpolator (as the Meter74): a 48-tap Kaiser-windowed sinc for 4x, in 4 phases ----------
function tg_tpdesign() local(n, t, x, w, i0, ph, j, s) (
  i0 = tg_bi0(7); n = 0;
  loop(48, t = (n - 23.5) / 4; x = 2 * n / 47 - 1; w = tg_bi0(7 * sqrt(max(0, 1 - x * x))) / i0;
    TPH[(n % 4) * 12 + floor(n / 4)] = sin($pi * t) / ($pi * t) * w; n += 1; );
  ph = 0; loop(4, s = 0; j = 0; loop(12, s += TPH[ph * 12 + j]; j += 1; );
    j = 0; loop(12, TPH[ph * 12 + j] /= s; j += 1; ); ph += 1; );
);
// one channel: the largest of the four interpolated points (and the sample itself)
function tg_tp(c, x) local(b, w, p, a, bb, cc, d, v) (
  b = TPB + c * 32; w = (TPW[c] + 1) & 15; TPW[c] = w; b[w] = x; b[w + 16] = x; p = b + w + 16;
  v = p[0];   a = TPH[0] * v;  bb = TPH[12] * v; cc = TPH[24] * v; d = TPH[36] * v;
  v = p[-1];  a += TPH[1] * v; bb += TPH[13] * v; cc += TPH[25] * v; d += TPH[37] * v;
  v = p[-2];  a += TPH[2] * v; bb += TPH[14] * v; cc += TPH[26] * v; d += TPH[38] * v;
  v = p[-3];  a += TPH[3] * v; bb += TPH[15] * v; cc += TPH[27] * v; d += TPH[39] * v;
  v = p[-4];  a += TPH[4] * v; bb += TPH[16] * v; cc += TPH[28] * v; d += TPH[40] * v;
  v = p[-5];  a += TPH[5] * v; bb += TPH[17] * v; cc += TPH[29] * v; d += TPH[41] * v;
  v = p[-6];  a += TPH[6] * v; bb += TPH[18] * v; cc += TPH[30] * v; d += TPH[42] * v;
  v = p[-7];  a += TPH[7] * v; bb += TPH[19] * v; cc += TPH[31] * v; d += TPH[43] * v;
  v = p[-8];  a += TPH[8] * v; bb += TPH[20] * v; cc += TPH[32] * v; d += TPH[44] * v;
  v = p[-9];  a += TPH[9] * v; bb += TPH[21] * v; cc += TPH[33] * v; d += TPH[45] * v;
  v = p[-10]; a += TPH[10] * v; bb += TPH[22] * v; cc += TPH[34] * v; d += TPH[46] * v;
  v = p[-11]; a += TPH[11] * v; bb += TPH[23] * v; cc += TPH[35] * v; d += TPH[47] * v;
  max(max(abs(a), abs(bb)), max(max(abs(cc), abs(d)), abs(x)));
);

// ---------- the K-weighting (ITU-R BS.1770, as the Meter74): head shelf, then the RLB high-pass, any sample rate ----------
function tg_kset() local(f, g, q, k, vh, vb, a0) (
  f = 1681.974450955533; g = 3.999843853973347; q = 0.7071752369554196;
  k = tan($pi * f / srate); vh = 10 ^ (g / 20); vb = vh ^ 0.4996667741545416; a0 = 1 + k / q + k * k;
  tg_pb0 = (vh + vb * k / q + k * k) / a0; tg_pb1 = 2 * (k * k - vh) / a0; tg_pb2 = (vh - vb * k / q + k * k) / a0;
  tg_pa1 = 2 * (k * k - 1) / a0; tg_pa2 = (1 - k / q + k * k) / a0;
  f = 38.13547087602444; q = 0.5003270373238773;
  k = tan($pi * f / srate); a0 = 1 + k / q + k * k;
  tg_ra1 = 2 * (k * k - 1) / a0; tg_ra2 = (1 - k / q + k * k) / a0;
);
function tg_kw(c, x) local(s, y) (
  s = KWS + c * 4;
  y = tg_pb0 * x + s[0]; s[0] = tg_pb1 * x - tg_pa1 * y + s[1]; s[1] = tg_pb2 * x - tg_pa2 * y;
  x = y; y = x + s[2]; s[2] = -2 * x - tg_ra1 * y + s[3]; s[3] = x - tg_ra2 * y;
  y;
);

// ---------- one input channel, every sample: ring buffer, peak, true peak, RMS, clip; returns its weighted K energy ----------
function tg_ch(c, x) local(a, t, y) (
  RB[c * 65536 + tg_rw] = x;
  a = abs(x); a > BPK[c] ? BPK[c] = a;
  t = tg_tp(c, x); t > BTP[c] ? BTP[c] = t;
  MSQ[c] += (x * x - MSQ[c]) * tg_krms;
  a >= 1 ? ( CLR[c] == 0 ? ( CLC[c] += 1; CLR[c] = 1; ); ) : CLR[c] = 0;
  y = tg_kw(c, x);
  CHW[c] * y * y;
);

// ---------- loudness: integrated (BS.1770-4 gating) and LRA (EBU Tech 3342) from their histograms ----------
function tg_iclear() ( memset(HIS, 0, 750); memset(HIC, 0, 750); memset(LRS, 0, 750); memset(LRC, 0, 750);
  tg_li = -999; tg_lra = -1; tg_mmax = -999; );
function tg_integ() local(i, s, c, thr, n, lo, hi, k) (
  s = c = 0; i = 0; loop(750, s += HIS[i]; c += HIC[i]; i += 1; );
  c > 0 ? (
    thr = -0.691 + 10 * log10(s / c) - 10;
    s = c = 0; i = 0; loop(750, -70 + (i + 0.5) / 10 > thr ? ( s += HIS[i]; c += HIC[i]; ); i += 1; );
    tg_li = c > 0 ? -0.691 + 10 * log10(s / c) : -999;
  ) : tg_li = -999;
  // LRA: the short-term values above -70 LUFS, then above (their power mean - 20 LU); 95th minus 10th percentile
  s = c = 0; i = 0; loop(750, s += LRS[i]; c += LRC[i]; i += 1; );
  c > 0 ? (
    thr = -0.691 + 10 * log10(s / c) - 20;
    n = 0; i = 0; loop(750, -70 + (i + 0.5) / 10 > thr ? n += LRC[i]; i += 1; );
    n > 0 ? (
      lo = hi = -1; k = 0; i = 0;
      loop(750,
        -70 + (i + 0.5) / 10 > thr ? (
          k += LRC[i];
          lo < 0 && k >= 0.10 * n ? lo = i;
          hi < 0 && k >= 0.95 * n ? hi = i;
        );
        i += 1;
      );
      tg_lra = max(hi - lo, 0) / 10;
    ) : tg_lra = -1;
  ) : tg_lra = -1;
);

// ---------- settings: the sliders, read every block (keys pressed on the panel do not run @slider) ----------
function tg_srinit() (
  tg_sr = srate;
  tg_kset();
  tg_nsb = floor(0.1 * srate + 0.5);                    // samples per 100 ms loudness sub-block
  tg_kcr = 1 - exp(-1 / (0.2 * srate));                 // correlation (200 ms)
  memset(KWS, 0, 32); tg_ek = 0; tg_n = 0; tg_sb = 0; memset(EKB, 0, 32); tg_lm = tg_ls = -999; tg_iclear();
);
function tg_cfg() (
  tg_md = slider1 | 0;
  tg_nm = tg_md == 5 ? 6 : tg_md == 6 ? 8 : 2;          // meter / ring channels
  tg_nc = tg_md == 1 || tg_md == 3 || tg_md == 4 ? 1 : tg_md == 5 ? 6 : tg_md == 6 ? 8 : 2;   // curves
  tg_fn = 2 ^ (10 + min(max(slider2 | 0, 0), 5));       // the FFT size
  tg_ovf = slider3 < 0.5 ? 1 : slider3 < 1.5 ? 0.5 : slider3 < 2.5 ? 0.25 : 0.125;   // hop / block
  tg_hop = floor(tg_fn * tg_ovf);
  tg_wt = slider4 | 0; tg_sm = slider6 | 0;
  tg_tau = slider5 < 0.5 ? 0 : slider5 < 1.5 ? 0.1 : slider5 < 2.5 ? 0.3 : slider5 < 3.5 ? 1 : 3;
  tg_dec = slider13 < 0.5 ? 1 : slider13 < 1.5 ? 3 : slider13 < 2.5 ? 6 : slider13 < 3.5 ? 12 : 24;
  tg_cmask = tg_nc > 2 ? slider18 | 0 : 255;
  tg_send = slider16 | 0;
  tg_fall = slider19 < 0.5 ? 20 / 0.75 : slider19 < 1.5 ? 20 / 1.7 : 20 / 3.5;   // peak fall, dB/s
  tg_hs = slider20 < 0.5 ? 0 : slider20 < 1.5 ? 1 : slider20 < 2.5 ? 2 : slider20 < 3.5 ? 5 : 1000000;
  tg_rmst = slider21 < 0.5 ? 0.05 : slider21 < 1.5 ? 0.3 : slider21 < 2.5 ? 0.6 : slider21 < 3.5 ? 1 : 3;
  tg_krms = 1 - exp(-1 / (tg_rmst * srate));
  CHW[0] = CHW[1] = 1; CHW[2] = 1; CHW[3] = 0; CHW[4] = CHW[5] = CHW[6] = CHW[7] = 1.41;
);

// =====================================================================================================================
// The analysis engine: one FFT per shown curve, mapped onto the common grid. Two instances, each with its own
// buffers and tables: "ga" runs in @gfx while the panel is open (UI cost, any block size); "ba" runs in @block only
// when the instance SENDs with its panel closed (at most 10 analyses a second, block size up to 8192). They hand over
// through the panel's heartbeat (tg_gvis) and the audio thread's busy flag (tg_bana): never both at once.
// =====================================================================================================================
function en_init(w, f1, f2, p, q, a, b, t, v, vs) instance(ewn, ef1, ef2, epw, eps, ma, mb, mt, eav, bst, fn, wt, sm, sr, last) (
  ewn = w; ef1 = f1; ef2 = f2; epw = p; eps = q; ma = a; mb = b; mt = t; eav = v; bst = vs;
  fn = 0; wt = -1; sm = -1; sr = 0; last = 0;
);
// the window and the bin -> grid map for block size n. Map kinds: 0 = interpolate at bin position A, 1 = the largest
// bin from A to B, 2 = the mean power between the bin edges A and B (prefix sums), 3 = above Nyquist (nothing)
function en_tables(n) instance(ewn, ma, mb, mt, eav, bst, fn, wt, sm, sr, cg, norm) local(i, x, g, f, kc, lo, hi, i0, i1, h, b) (
  (n != fn || tg_wt != wt) ? (
    fn = n; wt = tg_wt; i = 0;
    wt == 0 ? ( loop(n, x = 2 * $pi * i / n; ewn[i] = 0.5 - 0.5 * cos(x); i += 1; ); cg = 0.5; ) :
    wt == 1 ? ( loop(n, x = 2 * $pi * i / n; ewn[i] = 0.35875 - 0.48829 * cos(x) + 0.14128 * cos(2 * x) - 0.01168 * cos(3 * x); i += 1; );
                cg = 0.35875; ) :
    ( loop(n, x = 2 * $pi * i / n;
        ewn[i] = 0.21557895 - 0.41663158 * cos(x) + 0.277263158 * cos(2 * x) - 0.083578947 * cos(3 * x) + 0.006947368 * cos(4 * x);
        i += 1; ); cg = 0.21557895; );
    norm = 1 / sqr(n * cg);                             // |X|^2 -> (sine peak amplitude)^2
    memset(eav, 0, 8 * bst); sm = -1;
  );
  (tg_sm != sm || srate != sr) ? (
    sm = tg_sm; sr = srate;
    h = fn / 2; b = sm == 1 ? 1 / 24 : sm == 2 ? 1 / 12 : sm == 3 ? 1 / 6 : sm == 4 ? 1 / 3 : 0;
    g = 0;
    loop(GN,
      f = GFQ[g]; kc = f * fn / srate;
      f >= srate * 0.4995 || kc >= h - 1 ? mt[g] = 3 : b == 0 ? (
        lo = kc * exp(-tg_gr * 0.5); hi = kc * exp(tg_gr * 0.5);
        i0 = ceil(lo); i1 = min(floor(hi), h - 1);
        i1 >= i0 && i0 >= 1 ? ( mt[g] = 1; ma[g] = i0; mb[g] = i1; ) : ( mt[g] = 0; ma[g] = kc; );
      ) : (
        lo = kc * 2 ^ (-b * 0.5); hi = kc * 2 ^ (b * 0.5);
        hi - lo < 1 ? ( mt[g] = 0; ma[g] = kc; ) : ( mt[g] = 2; ma[g] = lo + 0.5; mb[g] = min(hi + 0.5, h - 0.5); );
      );
      g += 1;
    );
  );
);
// one curve: the windowed source (the newest fn samples of the ring), FFT, power per bin averaged in time (before any
// span is reduced to its maximum), onto the grid (dB), max hold, all-time; the hover copy keeps the largest per bin
function en_curve(c, buf, ka, dk, first) instance(ewn, epw, eps, ma, mb, mt, eav, bst, fn, sm, norm, st)
  local(h, n, i, j, a, b, k, p, g, t, x, f, e, lo, hi, u, v, d, base, q) (
  n = fn; h = n / 2; i = 0;
  tg_md == 0 || tg_md >= 5 ? ( a = RB + c * 65536; loop(n, j = (st + i) & 65535; buf[i] = a[j] * ewn[i]; i += 1; ); ) :
  tg_md == 3 ? ( loop(n, j = (st + i) & 65535; buf[i] = RB[j] * ewn[i]; i += 1; ); ) :
  tg_md == 4 ? ( b = RB + 65536; loop(n, j = (st + i) & 65535; buf[i] = b[j] * ewn[i]; i += 1; ); ) :
  tg_md == 1 || c == 0 ? ( b = RB + 65536; loop(n, j = (st + i) & 65535; buf[i] = (RB[j] + b[j]) * 0.5 * ewn[i]; i += 1; ); ) :
  ( b = RB + 65536; loop(n, j = (st + i) & 65535; buf[i] = (RB[j] - b[j]) * 0.5 * ewn[i]; i += 1; ); );
  fft_real(buf, n); fft_permute(buf, h);
  b = eav + c * bst;
  q = b[0]; q += (sqr(buf[0] * 0.5) * norm - q) * ka; b[0] = q; epw[0] = q; k = 1;
  loop(h - 1,
    q = b[k]; q += ((sqr(buf[2 * k]) + sqr(buf[2 * k + 1])) * norm - q) * ka; q < 0.000000000000000000001 ? q = 0; b[k] = q; epw[k] = q;
    k += 1;
  );
  first ? memcpy(RAW, epw, h) : ( k = 1; loop(h - 1, epw[k] > RAW[k] ? RAW[k] = epw[k]; k += 1; ); );
  epw[h] = epw[h + 1] = 0;
  sm > 0 ? ( eps[0] = 0; k = 0; loop(h + 1, eps[k + 1] = eps[k] + epw[k]; k += 1; ); );
  base = c * GN; g = 0;
  loop(GN,
    t = mt[g];
    t == 1 ? ( k = ma[g]; e = mb[g]; p = epw[k]; loop(e - k, k += 1; epw[k] > p ? p = epw[k]; ); ) :
    t == 0 ? ( x = ma[g]; k = floor(x); f = x - k; p = epw[k] + (epw[k + 1] - epw[k]) * f; ) :
    t == 2 ? ( lo = ma[g]; hi = mb[g];
               j = floor(lo); u = eps[j] + (lo - j) * epw[j];
               j = floor(hi); v = eps[j] + (hi - j) * epw[j];
               p = (v - u) / (hi - lo); ) :
    p = 0;
    d = 10 * log10(p + 0.00000000000000000001); DBG[base + g] = d;
    MXH[base + g] = max(d, MXH[base + g] - dk);
    d > ATM[base + g] ? ATM[base + g] = d;
    SUMP[g] += p;
    g += 1;
  );
);
// the correlation in three bands, from the L and R spectra (STEREO), or L = M + S, R = M - S (MID-SIDE)
function en_bands(ka) instance(ef1, ef2, fn) local(k, h, f, lr, li, rr, ri, b, i, x) (
  memset(BCOR + 12, 0, 9);
  h = fn / 2; k = 1;
  loop(h - 1,
    f = k * srate / fn;
    f >= 20 && f < 20000 ? (
      tg_md == 2 ? ( lr = ef1[2 * k] + ef2[2 * k]; li = ef1[2 * k + 1] + ef2[2 * k + 1]; rr = ef1[2 * k] - ef2[2 * k]; ri = ef1[2 * k + 1] - ef2[2 * k + 1]; )
                 : ( lr = ef1[2 * k]; li = ef1[2 * k + 1]; rr = ef2[2 * k]; ri = ef2[2 * k + 1]; );
      b = BCOR + 12 + (f < 250 ? 0 : f < 4000 ? 3 : 6);
      b[0] += lr * rr + li * ri; b[1] += lr * lr + li * li; b[2] += rr * rr + ri * ri;
    );
    k += 1;
  );
  i = 0; loop(9, BCOR[i] += (BCOR[12 + i] - BCOR[i]) * ka; i += 1; );
  i = 0; loop(3, x = sqrt(BCOR[i * 3 + 1] * BCOR[i * 3 + 2]); BCOR[24 + i] = x > 0.0000000000001 ? min(max(BCOR[i * 3] / x, -1), 1) : 0; i += 1; );
);
// one analysis of every shown curve (dt = the time since the last one), then SEND
function en_analyse(dt, n) instance(ef1, ef2, fn, st, bok, busy, rawn, nvis) local(ka, dk, c, k, first, g, b, now, sq) (
  this.en_tables(n);
  st = (tg_rw - fn) & 65535;                            // the newest fn samples (the audio writes ahead of them)
  ENG[0] != tg_rqm ? ( ENG[0] = tg_rqm; tg_fillv(MXH, 8 * GN, -200); tg_fillv(ATM, 8 * GN, -200); );   // CLEAR
  ka = tg_tau > 0 ? 1 - exp(-dt / tg_tau) : 1;
  dk = tg_dec * dt;
  memset(SUMP, 0, GN);
  c = 0; k = 0; first = 1;
  loop(tg_nc,
    (tg_cmask >> c) & 1 ? ( this.en_curve(c, c == 1 ? ef2 : ef1, ka, dk, first); first = 0; k += 1; );
    c += 1;
  );
  nvis = k;
  g = 0; loop(GN, SUMDB[g] = 10 * log10(SUMP[g] / max(k, 1) + 0.00000000000000000001); g += 1; );
  (tg_md == 0 || tg_md == 2) && k == 2 ? ( this.en_bands(1 - exp(-dt / 0.3)); bok = 1; ) : bok = 0;
  rawn = fn;
  // SEND: this instance's spectrum to its shared slot (a stamp, the owner, a sequence number, the grid)
  tg_send > 0 && k > 0 ? (
    now = time_precise(); b = GMB + (tg_send - 1) * GMS;
    busy = gmem[b + 1] != tg_id && gmem[b + 1] != 0 && now - gmem[b] < 0.5 && gmem[b] <= now;
    sq = gmem[b + 2] + 1;
    gmem[b] = now; gmem[b + 1] = tg_id; gmem[b + 2] = sq;
    g = 0; loop(GN, gmem[b + 16 + g] = SUMDB[g]; g += 1; );
  ) : busy = 0;
);

// ---------- presets (view settings; the snapshots and the share slots stay) ----------
function tg_set(md, bl, ov, wi, av, sm, sl, tp, bt, fr, mh, at, bal, ho, rm, scl, ko, ce, ta) (
  md >= 0 ? slider1 = md;
  slider2 = bl; slider3 = ov; slider4 = wi; slider5 = av; slider6 = sm; slider7 = sl; slider8 = tp; slider9 = bt;
  slider10 = fr; slider12 = mh; slider14 = at; slider19 = bal; slider20 = ho; slider21 = rm; slider22 = scl;
  slider23 = ko; slider24 = ce; slider25 = ta;
  slider_automate(33554431);                            // sliders 1-25
);
#tg_pm = "Init|Mix|Mastering|Low-End Detail|Broadcast R128|K-14 Mastering|Streaming -14|Tone Check|Surround 5.1|Surround 7.1";
function load_preset(p) (
  //                  mode blk ovl win avg smo slp top bot frq max all bal hld rms scl kof ceil tgt
  p == 1  ? tg_set(  0,  3,  2,  0,  2,  0,  2,  1,  4,  0,  1,  0,  1,  2,  1,  0,  3,  4,  0) :   // Init
  p == 2  ? tg_set( -1,  3,  2,  0,  2,  1,  2,  1,  4,  0,  1,  0,  1,  2,  1,  0,  3,  4,  0) :   // Mix
  p == 3  ? tg_set( -1,  4,  2,  1,  3,  1,  2,  1,  4,  1,  1,  1,  1,  4,  1,  0,  3,  4,  5) :   // Mastering
  p == 4  ? tg_set( -1,  5,  3,  1,  2,  0,  0,  1,  2,  3,  1,  0,  1,  2,  1,  0,  3,  4,  0) :   // Low-End Detail
  p == 5  ? tg_set( -1,  3,  2,  0,  3,  2,  1,  1,  4,  0,  1,  0,  1,  2,  1,  0,  3,  4,  0) :   // Broadcast R128
  p == 6  ? tg_set( -1,  4,  2,  1,  3,  1,  2,  1,  4,  0,  1,  1,  1,  4,  1,  2,  3,  4,  5) :   // K-14 Mastering
  p == 7  ? tg_set( -1,  3,  2,  0,  2,  1,  2,  1,  4,  0,  1,  0,  1,  2,  1,  0,  3,  4,  5) :   // Streaming -14
  p == 8  ? tg_set( -1,  5,  2,  2,  0,  0,  0,  1,  6,  1,  0,  0,  0,  2,  1,  0,  3,  4,  0) :   // Tone Check
  p == 9  ? ( tg_set( 5,  3,  2,  0,  2,  1,  2,  1,  4,  0,  1,  0,  1,  2,  1,  0,  3,  4,  1); slider18 = 255; ui_auto(18); ) :   // Surround 5.1
  p == 10 ? ( tg_set( 6,  3,  2,  0,  2,  1,  2,  1,  4,  0,  1,  0,  1,  2,  1,  0,  3,  4,  1); slider18 = 255; ui_auto(18); ) :   // Surround 7.1
  p == 11 ? (                                                                                         // Reset all to defaults
    tg_set(0, 3, 2, 0, 2, 0, 2, 1, 4, 0, 1, 0, 1, 2, 1, 0, 3, 4, 0);
    slider11 = 0; slider13 = 2; slider15 = 0; slider16 = 0; slider17 = 0; slider18 = 255; slider26 = 0;
    ui_auto(11); ui_auto(13); ui_auto(15); ui_auto(16); ui_auto(17); ui_auto(18); ui_auto(26);
  );
  pr_cur = p <= 10 ? p : 1;
);

// ---------- start ----------
tg_tpdesign();
g_ = 0; loop(GN, GFQ[g_] = G_LO * exp(g_ * tg_gr); g_ += 1; );
tg_fillv(DBG, 8 * GN, -200); tg_fillv(MXH, 8 * GN, -200); tg_fillv(ATM, 8 * GN, -200); tg_fillv(SUMDB, GN, -200);
ga.en_init(WIN, FB, FB2, PW, PS, MAPA, MAPB, MAPT, BAV, 16384);
ba.en_init(WINB, FBB, FB2B, PWB, PSB, MAPAB, MAPBB, MAPTB, BAVB, 4096);
tg_rw = 0; tg_tot = 0; tg_bana = 0; ENG[0] = tg_rqm;
tg_id = floor(rand(1000000)) + 1 + (floor(time_precise() * 1000) % 1000) * 1000000;   // this instance's owner id
tg_srinit();
tg_cfg();
tg_rql0 = tg_rql; tg_rqc0 = tg_rqc;
tg_cor = 0; tg_cl = tg_cr = tg_cx = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
tg_cfg();

@block
prs_chk();
srate != tg_sr ? tg_srinit();
tg_cfg();
tg_bdt = samplesblock / srate;
// ---- requests from the panel (one-way mailboxes: written only by the panel) ----
tg_rql != tg_rql0 ? ( tg_rql0 = tg_rql; tg_iclear(); );
tg_rqc != tg_rqc0 ? ( tg_rqc0 = tg_rqc; memset(TPM, 0, 8); memset(SPM, 0, 8); memset(CLC, 0, 8); tg_clip = 0; );
// ---- level meters: the block's peaks through the ballistics ----
tg_c = 0;
loop(tg_nm,
  tg_v = tg_db(BPK[tg_c]);
  PKD[tg_c] = max(tg_v, PKD[tg_c] - tg_fall * tg_bdt);
  tg_v >= PKH[tg_c] ? ( PKH[tg_c] = tg_v; PKT[tg_c] = 0; ) : (
    PKT[tg_c] += tg_bdt; PKT[tg_c] > tg_hs ? PKH[tg_c] = max(PKD[tg_c], PKH[tg_c] - 20 * tg_bdt); );
  BTP[tg_c] > TPM[tg_c] ? TPM[tg_c] = BTP[tg_c];
  BPK[tg_c] > SPM[tg_c] ? SPM[tg_c] = BPK[tg_c];
  CLC[tg_c] > 0 ? tg_clip = 1;
  MSQ[tg_c] < 0.0000000000000000001 ? MSQ[tg_c] = 0;
  BPK[tg_c] = BTP[tg_c] = 0;
  tg_c += 1;
);
tg_c = tg_nm; loop(8 - tg_nm, PKD[tg_c] = PKH[tg_c] = -160; MSQ[tg_c] = 0; tg_c += 1; );
// ---- correlation ----
tg_cl < 0.0000000001 ? tg_cl = 0; tg_cr < 0.0000000001 ? tg_cr = 0; abs(tg_cx) < 0.0000000001 ? tg_cx = 0;
tg_cd = sqrt(tg_cl * tg_cr);
tg_cor = tg_cd > 0.0000000001 ? min(max(tg_cx / tg_cd, -1), 1) : 0;
// ---- loudness: the integrated value and the LRA, once per new 100 ms sub-block ----
tg_intq ? ( tg_intq = 0; tg_integ(); );
// ---- the spectrum: one analysis per hop, while the panel is open or the instance sends ----
// ---- the spectrum on the audio thread: only to SEND while the panel is closed (the panel analyses when it is open);
// at most 10 analyses a second, the block size capped at 8192 ----
tg_tot += samplesblock;
tg_send > 0 && time_precise() - tg_gvis > 1 ? (
  tg_bn = min(tg_fn, 8192);
  tg_tot - ba.last >= max(tg_bn * tg_ovf, srate * 0.1) ? (
    tg_bana = 1;
    ba.en_analyse(min((tg_tot - ba.last) / srate, 1), tg_bn); ba.last = tg_tot;
    tg_bana = 0;
  );
) : ba.last = tg_tot;
tg_blk += 1;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, REF, 4100);                                 // the four reference snapshots and their valid flags
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// read only: spl0 .. spl7 are never written, so every channel passes through bit-exact
tg_e = tg_ch(0, spl0) + tg_ch(1, spl1);
tg_nm > 2 ? (
  tg_e += tg_ch(2, spl2) + tg_ch(3, spl3) + tg_ch(4, spl4) + tg_ch(5, spl5);
  tg_nm > 6 ? tg_e += tg_ch(6, spl6) + tg_ch(7, spl7);
);
tg_rw = (tg_rw + 1) & 65535;
// correlation sums (L / R)
tg_cl += (spl0 * spl0 - tg_cl) * tg_kcr;
tg_cr += (spl1 * spl1 - tg_cr) * tg_kcr;
tg_cx += (spl0 * spl1 - tg_cx) * tg_kcr;
// loudness: K-weighted energy in 100 ms sub-blocks; momentary = 4 of them, short-term = 30
tg_ek += tg_e; tg_n += 1;
tg_n >= tg_nsb ? (
  EKB[tg_sb & 31] = tg_ek / tg_nsb; tg_sb += 1; tg_ek = 0; tg_n = 0;
  tg_sb >= 4 ? (
    tg_z = (EKB[(tg_sb - 1) & 31] + EKB[(tg_sb - 2) & 31] + EKB[(tg_sb - 3) & 31] + EKB[(tg_sb - 4) & 31]) / 4;
    tg_lm = -0.691 + 10 * log10(max(tg_z, 0.00000000000000000001));
    tg_lm > tg_mmax ? tg_mmax = tg_lm;
    tg_lm > -70 ? ( tg_i = min(749, floor((tg_lm + 70) * 10)); HIS[tg_i] += tg_z; HIC[tg_i] += 1; );
    tg_j = min(tg_sb, 30); tg_z = 0; tg_i = 1; loop(tg_j, tg_z += EKB[(tg_sb - tg_i) & 31]; tg_i += 1; );
    tg_z /= tg_j;
    tg_ls = -0.691 + 10 * log10(max(tg_z, 0.00000000000000000001));
    tg_sb >= 30 && tg_ls > -70 ? ( tg_i = min(749, floor((tg_ls + 70) * 10)); LRS[tg_i] += tg_z; LRC[tg_i] += 1; );
    tg_intq = 1;
  );
);

@gfx 1040 600
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1040, 600);
// the panel is open: it runs the analysis itself (UI cost), unless the audio thread is in the middle of one
tg_gvis = time_precise();
!tg_bana ? (
  tv_el = tg_tot - ga.last;
  tv_el < 0 ? ga.last = tg_tot : tv_el >= tg_hop ? ( ga.en_analyse(min(tv_el / srate, 1), tg_fn); ga.last = tg_tot; );
);

// =====================================================================================================================
// The VFD palette (the Meter81 / Tuner81 VFD face)
// =====================================================================================================================
TP_  = 0x181A1B;                                        // charcoal-black slate
TH_  = ui_mix(TP_, 0x000000, 0.35);                     // header strip
TGL  = 0x070808;                                        // display glass
TI_  = 0x4EE1DC;                                        // cold turquoise glow
TI2  = ui_mix(TI_, TP_, 0.45);
TA_  = 0xFF8C00;                                        // neon amber
TR_  = 0xFF3A1A;                                        // over red
TGH  = 0x0D0E0F;                                        // unlit ghost segments
TBZ  = 0x2E3235;                                        // window bezel
TGR  = 0x1A2425;                                        // graticule

// fonts (the house face, bold; sizes in design pixels)
gfx_setfont(11, "Trebuchet MS", 12 * sc, 'b');          // labels and scale numbers
gfx_setfont(12, "Trebuchet MS", 12.5 * sc, 'b');        // key and drop-down captions
gfx_setfont(13, "Courier New", 24 * sc, 'b');           // big readout digits
gfx_setfont(14, "Trebuchet MS", 27 * sc, 'b');          // title, big letters
gfx_setfont(15, "Courier New", 16 * sc, 'b');           // small readout digits

function tg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function tg_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// text at (x, cy): al 0 left, 1 centre, 2 right; cy = the vertical centre
function tg_t(x, cy, s, al) local(tw, th) (
  gfx_measurestr(s, tw, th);
  gfx_x = x * sc - (al == 1 ? tw * 0.5 : al == 2 ? tw : 0); gfx_y = cy * sc - th * 0.5; gfx_drawstr(s);
);
function tg_cap(x, cy, s) ( gfx_setfont(11); ui_col(TI2); tg_t(x, cy, s, 0); );
// a flat, sharp-cornered lit key (the Meter81 VFD key); lc = the lit colour; returns 1 when clicked
function tg_key(x, y, w, h, lbl, on, en, lc) local(hov, hit) (
  hov = en && tg_in(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(on ? lc : ui_mix(TI_, TP_, 0.7)); tg_r(x, y, w, h);
  ui_col(0x0A0B0C); tg_r(x + 1, y + 1, w - 2, h - 2);
  on ? ( ui_cola(lc, 0.22); tg_r(x + 1, y + 1, w - 2, h - 2); ui_cola(lc, 0.12); tg_r(x - 2, y - 2, w + 4, h + 4); )
     : hov ? ( ui_cola(TI_, 0.08); tg_r(x + 1, y + 1, w - 2, h - 2); );
  on ? ui_col(ui_mix(lc, 0xFFFFFF, 0.35)) : ui_cola(TI_, en ? 0.55 : 0.2);
  gfx_setfont(12); tg_t(x + w * 0.5, y + h * 0.5 + 0.5, lbl, 1);
  hit;
);
// a drop-down in the same manner: the current item and a small triangle; a click opens the list.
// lbl = a fixed caption instead of the current item (an action menu). Returns the item picked (0-based) or -1.
function tg_dd(x, y, w, h, menu, v, en, lbl) local(hov, i, n, sel, cx, cy) (
  hov = en && tg_in(x, y, w, h);
  ui_col(ui_mix(TI_, TP_, 0.62)); tg_r(x, y, w, h);
  ui_col(0x0A0B0C); tg_r(x + 1, y + 1, w - 2, h - 2);
  hov ? ( ui_cola(TI_, 0.08); tg_r(x + 1, y + 1, w - 2, h - 2); );
  strlen(lbl) ? strcpy(#tg_ddi, lbl) : pk_pitem(menu, v + 1, #tg_ddi);
  gfx_setfont(12); ui_cola(TI_, en ? 0.92 : 0.3); tg_t(x + 8, y + h * 0.5 + 0.5, #tg_ddi, 0);
  cx = (x + w - 11) * sc; cy = (y + h * 0.5) * sc;
  ui_cola(TI_, en ? 0.7 : 0.25); gfx_triangle(cx - 4 * sc, cy - 2 * sc, cx + 4 * sc, cy - 2 * sc, cx, cy + 3 * sc);
  sel = -1;
  pressed && hov && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#tg_ddm, ""); n = pk_pcount(menu); i = 1;
    loop(n, i == v + 1 && !strlen(lbl) ? strcat(#tg_ddm, "!"); strcat(#tg_ddm, pk_pitem(menu, i, #tg_ddt)); i < n ? strcat(#tg_ddm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#tg_ddm); i > 0 ? sel = i - 1;
  );
  sel;
);
// a drop-down bound to a slider (with its caption above)
function tg_sdd(x, y, w, cap, idx, menu) local(k) (
  tg_cap(x, y - 9, cap);
  k = tg_dd(x, y, w, 24, menu, slider(idx), 1, "");
  k >= 0 ? ( slider(idx) = k; ui_auto(idx); );
);
// a module: a bezel, the glass, a caption in the top-left corner
function tg_mod(x, y, w, h) ( ui_col(TBZ); tg_r(x, y, w, h); ui_col(TGL); tg_r(x + 1, y + 1, w - 2, h - 2); );
// a hover tip (a small window with one line) at the mouse
function tg_tip(s) local(tw, th, x, y) (
  gfx_setfont(11); gfx_measurestr(s, tw, th);
  x = min(mouse_x + 14 * sc, min(gfx_w, 1040 * sc) - tw - 16 * sc); y = max(mouse_y - th - 14 * sc, 4 * sc);
  ui_col(TI_); gfx_rect(x - 6 * sc, y - 4 * sc, tw + 12 * sc, th + 8 * sc);
  ui_col(0x0A0B0C); gfx_rect(x - 5 * sc, y - 3 * sc, tw + 10 * sc, th + 6 * sc);
  ui_col(TI_); gfx_x = x; gfx_y = y; gfx_drawstr(s);
);
// the transform of the analysis window (normalised to 1 at the centre) at an offset of d bins
function tg_sinc(x) ( abs(x) < 0.000001 ? 1 : sin($pi * x) / ($pi * x); );
function tg_wsh(d) (
  tg_wt == 0 ? ( 0.5 * tg_sinc(d) + 0.25 * (tg_sinc(d - 1) + tg_sinc(d + 1)) ) / 0.5 :
  tg_wt == 1 ? ( 0.35875 * tg_sinc(d) + 0.244145 * (tg_sinc(d - 1) + tg_sinc(d + 1)) + 0.07064 * (tg_sinc(d - 2) + tg_sinc(d + 2))
                 + 0.00584 * (tg_sinc(d - 3) + tg_sinc(d + 3)) ) / 0.35875 :
  ( 0.21557895 * tg_sinc(d) + 0.20831579 * (tg_sinc(d - 1) + tg_sinc(d + 1)) + 0.138631579 * (tg_sinc(d - 2) + tg_sinc(d + 2))
    + 0.0417894735 * (tg_sinc(d - 3) + tg_sinc(d + 3)) + 0.003473684 * (tg_sinc(d - 4) + tg_sinc(d + 4)) ) / 0.21557895;
);
function tg_lufs(v, s) ( v > -70 ? sprintf(s, "%.1f", v) : strcpy(s, "---"); s; );

// channel names and curve colours
function tg_chname(c) (
  tg_md >= 5 ? ( c == 0 ? "L" : c == 1 ? "R" : c == 2 ? "C" : c == 3 ? "LFE" : c == 4 ? "Ls" : c == 5 ? "Rs" : c == 6 ? "Lb" : "Rb"; ) :
  tg_md == 1 ? "MONO" : tg_md == 2 ? ( c == 0 ? "M" : "S" ) : tg_md == 3 ? "L" : tg_md == 4 ? "R" : ( c == 0 ? "L" : "R" );
);
function tg_ccol(c) (
  c == 0 ? TI_ : c == 1 ? TA_ : c == 2 ? 0xF2F1EA : c == 3 ? 0xB07CFF : c == 4 ? 0x5CD65C : c == 5 ? 0xFF5A8C : c == 6 ? 0x5A9BFF : 0xF2D04E;
);
function tg_mcol(c) (                                   // meter channel names (L R C LFE ... ; L / R otherwise)
  c == 0 ? "L" : c == 1 ? "R" : c == 2 ? "C" : c == 3 ? "LFE" : c == 4 ? "Ls" : c == 5 ? "Rs" : c == 6 ? "Lb" : "Rb";
);
function tg_refcol(i) ( i == 0 ? 0xC9A0FF : i == 1 ? 0x9BE07A : i == 2 ? 0xFF9EC4 : 0xFFE08A; );
function tg_slotcol(i) (
  i == 0 ? 0xFF6B6B : i == 1 ? 0xFFB347 : i == 2 ? 0xF2E85C : i == 3 ? 0x7CE07C : i == 4 ? 0x5CD6E8 : i == 5 ? 0x6E9BFF : i == 6 ? 0xC38CFF : 0xFF8FD8;
);

tv_now = time_precise();
tv_wide = slider26 >= 0.5;

// =====================================================================================================================
// Panel and header
// =====================================================================================================================
ui_col(TP_); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(TH_); tg_r(0, 0, 1040, 54);
ui_col(TA_); tg_r(0, 54, 1040, 2);
ui_col(TI_); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);  // the series badge
gfx_setfont(12); ui_col(0x111213); tg_t(31, 27.5, "81", 1);
gfx_setfont(14); ui_col(TI_); tg_t(58, 27, "TELEMETRY", 0); ver_tag("v3", 16, 3.15, 0);
gfx_setfont(11); ui_col(TI2); tg_t(232, 21, "SPECTRUM", 0); tg_t(232, 35, "ANALYSER", 0);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(318 * sc, 10 * sc, 330 * sc, 34 * sc, pr_cur, #tg_pm);
k_ > 0 ? prs_dirty = k_;
tg_key(662, 15, 64, 24, "WIDE", tv_wide, 1, TA_) ? ( slider26 = tv_wide ? 0 : 1; ui_auto(26); tv_wide = !tv_wide; );
ui_size_picker(970 * sc, 18 * sc);

// =====================================================================================================================
// The spectrum window
// =====================================================================================================================
tv_wx = 12; tv_wy = 64; tv_ww = tv_wide ? 950 : 696; tv_wh = tv_wide ? 524 : 326;
tg_mod(tv_wx, tv_wy, tv_ww, tv_wh);
tv_px = tv_wx + 44; tv_py = tv_wy + 34; tv_pw = tv_ww - 44 - 14; tv_ph = tv_wh - 34 - 24;
// the view
tv_top = slider8 < 0.5 ? 12 : slider8 < 1.5 ? 6 : slider8 < 2.5 ? 0 : slider8 < 3.5 ? -6 : slider8 < 4.5 ? -12 : -20;
tv_bot = slider9 < 0.5 ? -48 : slider9 < 1.5 ? -60 : slider9 < 2.5 ? -72 : slider9 < 3.5 ? -84 : slider9 < 4.5 ? -96 : slider9 < 5.5 ? -120 : -144;
tv_bot > tv_top - 24 ? tv_bot = tv_top - 24;
tv_fr = slider10 | 0;
tv_f0 = tv_fr == 0 ? 20 : tv_fr == 1 ? 10 : tv_fr == 2 ? 20 : tv_fr == 3 ? 20 : tv_fr == 4 ? 200 : 1000;
tv_f1 = tv_fr == 0 ? 20000 : tv_fr == 1 ? 24000 : tv_fr == 2 ? 2000 : tv_fr == 3 ? 500 : tv_fr == 4 ? 20000 : 24000;
tv_lr = log(tv_f1 / tv_f0);
tv_slp = slider7 < 0.5 ? 0 : slider7 < 1.5 ? 3 : 4.5;
function tg_fx(f) ( tv_px + log(f / tv_f0) / tv_lr * tv_pw; );          // frequency -> x (design units)
function tg_dy(d) ( tv_py + min(max((tv_top - d) / (tv_top - tv_bot), 0), 1) * tv_ph; );

// the columns: one per pixel step, each with its grid position and tilt
tv_stp = max(1, floor(sc + 0.5));
tv_x0 = floor(tv_px * sc); tv_x1 = floor((tv_px + tv_pw) * sc);
tv_ncol = min(floor((tv_x1 - tv_x0) / tv_stp) + 1, 4096);
tv_i = 0;
loop(tv_ncol,
  tv_f = tv_f0 * exp((tv_i * tv_stp) / (tv_x1 - tv_x0) * tv_lr);
  COLG[tv_i] = min(max(log(tv_f / G_LO) / tg_gr, 0), GN - 1.001);
  COLT[tv_i] = tv_slp * log(tv_f / 1000) / log(2);
  tv_i += 1;
);

// the graticule: dB lines and frequency lines with their numbers
tv_span = tv_top - tv_bot;
tv_ds = tv_span <= 48 ? 6 : tv_span <= 96 ? 12 : 24;
gfx_setfont(11);
tv_d = floor(tv_top / tv_ds) * tv_ds;
while (tv_d >= tv_bot) (
  tv_y = tg_dy(tv_d);
  ui_col(tv_d == 0 ? ui_mix(TI_, TGL, 0.72) : TGR); tg_r(tv_px, tv_y, tv_pw, 1 / sc);
  tv_y > tv_py + 6 && tv_y < tv_py + tv_ph - 4 || tv_d == 0 ? (
    ui_col(TI2); tv_d > 0 ? sprintf(#tg_s, "+%d", tv_d) : sprintf(#tg_s, "%d", tv_d); tg_t(tv_px - 6, tv_y, #tg_s, 2); );
  tv_d -= tv_ds;
);
tv_dec_ = log10(tv_f1 / tv_f0);
tv_lx = -1000;
tv_m = 1;
while (tv_m <= 10000) (
  tv_k = 1;
  loop(9,
    tv_f = tv_k * tv_m;
    tv_f >= tv_f0 * 0.999 && tv_f <= tv_f1 * 1.001 ? (
      tv_x = tg_fx(tv_f);
      ui_col(tv_k == 1 ? ui_mix(TGR, TI_, 0.12) : TGR); tg_r(tv_x, tv_py, 1 / sc, tv_ph);
      (tv_k == 1 || tv_k == 2 || tv_k == 5 || (tv_dec_ < 1.8 && (tv_k == 3 || tv_k == 4 || tv_k == 7))) ? (
        tv_f >= 1000 ? sprintf(#tg_s, "%dk", tv_f / 1000) : sprintf(#tg_s, "%d", tv_f);
        gfx_measurestr(#tg_s, tg_tw, tg_th);
        tv_x - tg_tw / sc * 0.5 > tv_lx + 6 && tv_x + tg_tw / sc * 0.5 < tv_wx + tv_ww - 4 ? (
          ui_col(TI2); tg_t(tv_x, tv_py + tv_ph + 12, #tg_s, 1); tv_lx = tv_x + tg_tw / sc * 0.5; );
      );
    );
    tv_k += 1;
  );
  tv_m *= 10;
);
tv_f1 > 20000 && tv_f0 < 20000 ? ( ui_cola(TA_, 0.25); tg_r(tg_fx(20000), tv_py, 1 / sc, tv_ph); );
// the plot frame
ui_cola(TI_, 0.3); gfx_rect(tv_px * sc, tv_py * sc, tv_pw * sc, tv_ph * sc, 0);

// one curve from a grid of dB values (base), tilted; fill: the area under it; dot: dotted line
function tg_plot(base, col, fill, al, dot) local(i, x, y, yp, xp, gp, k, f, v, yb, n) (
  yb = (tv_py + tv_ph) * sc; i = 0; xp = -1; yp = 0; n = 0;
  loop(tv_ncol,
    gp = COLG[i]; k = floor(gp); f = gp - k;
    v = base[k] + (base[k + 1] - base[k]) * f + COLT[i];
    x = tv_x0 + i * tv_stp;
    y = (tv_py + min(max((tv_top - v) / (tv_top - tv_bot), 0), 1) * tv_ph) * sc;
    fill && y < yb - 0.5 ? ( ui_cola(col, al * 0.11); gfx_rect(x, y, tv_stp, yb - y); );
    xp >= 0 && (y < yb - 0.5 || yp < yb - 0.5) && (!dot || (n & 2)) ? ( ui_cola(col, al); gfx_line(xp, yp, x, y, 1); );
    xp = x; yp = y; n += 1;
    i += 1;
  );
);

tv_fill = slider11 < 0.5;
// references (behind everything)
tv_i = 0;
loop(4,
  (slider15 >> tv_i) & 1 && REF[4096 + tv_i] ? tg_plot(REF + tv_i * GN, tg_refcol(tv_i), 0, 0.9, 1);
  tv_i += 1;
);
// other instances' shared slots (fresh within 1.5 s; never this instance's own SEND)
tv_live = 0;
tv_i = 0;
loop(8,
  tv_b = GMB + tv_i * GMS;
  tv_fresh = gmem[tv_b + 1] != 0 && abs(tv_now - gmem[tv_b]) < 1.5;
  tv_fresh && tv_i + 1 != tg_send ? tv_live += 1;
  (slider17 >> tv_i) & 1 && tv_fresh && tv_i + 1 != tg_send ? (
    tv_j = 0; loop(GN, GSC[tv_j] = gmem[tv_b + 16 + tv_j]; tv_j += 1; );
    tg_plot(GSC, tg_slotcol(tv_i), 0, 0.95, 0);
  );
  SLOTF[tv_i] = tv_fresh;
  tv_i += 1;
);
// the curves: all-time, max hold, then the live spectra
tv_c = 0;
loop(tg_nc,
  (tg_cmask >> tv_c) & 1 ? (
    slider14 >= 0.5 ? tg_plot(ATM + tv_c * GN, ui_mix(tg_ccol(tv_c), TR_, 0.55), 0, 0.85, 1);
    slider12 >= 0.5 ? tg_plot(MXH + tv_c * GN, ui_mix(tg_ccol(tv_c), 0xFFFFFF, 0.45), 0, 0.55, 0);
  );
  tv_c += 1;
);
tv_c = tg_nc - 1;
loop(tg_nc,
  (tg_cmask >> tv_c) & 1 ? tg_plot(DBG + tv_c * GN, tg_ccol(tv_c), tv_fill, tg_nc > 2 ? 0.5 : 1, 0);
  tv_c -= 1;
);

// the legend strip: the curves (channel keys in surround), the resolution
gfx_setfont(11);
tv_c = 0; tv_x = tv_px;
tg_nc > 2 ? (
  loop(tg_nc,
    tv_k = (tg_cmask >> tv_c) & 1;
    tg_key(tv_x, tv_wy + 7, 36, 20, tg_chname(tv_c), tv_k, 1, tg_ccol(tv_c)) ? ( slider18 = (slider18 | 0) ~ (1 << tv_c); ui_auto(18); );
    tv_x += 40; tv_c += 1;
  );
  tv_x += 6;
  tg_key(tv_x, tv_wy + 7, 52, 20, "FRONT", tg_cmask == 7, 1, TI_) ? ( slider18 = 7; ui_auto(18); ); tv_x += 56;
  tg_key(tv_x, tv_wy + 7, 46, 20, "SURR", tg_cmask == (tg_nc > 6 ? 240 : 48), 1, TI_) ? ( slider18 = tg_nc > 6 ? 240 : 48; ui_auto(18); ); tv_x += 50;
  tg_key(tv_x, tv_wy + 7, 40, 20, "ALL", (tg_cmask & (tg_nc > 6 ? 255 : 63)) == (tg_nc > 6 ? 255 : 63), 1, TI_) ? ( slider18 = 255; ui_auto(18); ); tv_x += 44;
) : (
  loop(tg_nc,
    ui_col(tg_ccol(tv_c)); tg_r(tv_x, tv_wy + 16, 18, 3);
    tg_t(tv_x + 24, tv_wy + 17, tg_chname(tv_c), 0);
    gfx_measurestr(tg_chname(tv_c), tg_tw, tg_th); tv_x += 34 + tg_tw / sc; tv_c += 1;
  );
);
sprintf(#tg_s, "%d  ·  %.1f Hz / BIN  ·  %d ms", tg_fn, srate / tg_fn, floor(tg_hop / srate * 1000 + 0.5));
gfx_setfont(11); gfx_measurestr(#tg_s, tg_tw, tg_th);
tv_wx + tv_ww - 12 - tg_tw / sc > tv_x + 8 ? ( ui_col(TI2); tg_t(tv_wx + tv_ww - 12, tv_wy + 17, #tg_s, 2); );   // (only where the legend leaves room)

// hover: the nearest peak (refined between the bins), its note and its level
tg_in(tv_px, tv_py, tv_pw, tv_ph) && ga.rawn > 0 ? (
  tv_mf = tv_f0 * exp((mouse_x / sc - tv_px) / tv_pw * tv_lr);
  tv_k0 = max(floor(tv_f0 * exp((mouse_x / sc - 8 - tv_px) / tv_pw * tv_lr) * ga.rawn / srate), 1);
  tv_k1 = min(ceil(tv_f0 * exp((mouse_x / sc + 8 - tv_px) / tv_pw * tv_lr) * ga.rawn / srate), ga.rawn / 2 - 2);
  tv_k0 = min(tv_k0, floor(tv_mf * ga.rawn / srate) - 2); tv_k1 = max(tv_k1, ceil(tv_mf * ga.rawn / srate) + 2);
  tv_k0 = max(tv_k0, 1); tv_k1 = min(tv_k1, ga.rawn / 2 - 2);
  tv_bk = tv_k0; tv_bv = RAW[tv_k0]; tv_k = tv_k0;
  loop(max(tv_k1 - tv_k0 + 1, 0), RAW[tv_k] > tv_bv ? ( tv_bv = RAW[tv_k]; tv_bk = tv_k; ); tv_k += 1; );
  // the window's own shape locates the tone between the bins: the ratio of the two neighbours fixes the offset,
  // the window's transform at that offset restores the level (exact for a steady tone, any of the three windows)
  tv_l = sqrt(RAW[tv_bk - 1]); tv_b = sqrt(RAW[tv_bk]); tv_u = sqrt(RAW[tv_bk + 1]);
  tv_p = 0; tv_g = 1;
  tv_bk > tv_k0 && tv_bk < tv_k1 && tv_b > 0 ? (
    tv_lo = -0.5; tv_hi = 0.5;
    loop(24, tv_p = (tv_lo + tv_hi) * 0.5;
      abs(tg_wsh(tv_p - 1)) * tv_l - abs(tg_wsh(tv_p + 1)) * tv_u < 0 ? tv_lo = tv_p : tv_hi = tv_p; );
    tv_g = abs(tg_wsh(tv_p));
  );
  tv_pf = (tv_bk + tv_p) * srate / ga.rawn;
  tv_pl = 20 * log10(tv_b / max(tv_g, 0.01) + 0.000000000001);
  tv_pl > -150 && tv_pf >= tv_f0 * 0.98 && tv_pf <= tv_f1 * 1.02 ? (
    tv_mi = 69 + 12 * log(tv_pf / 440) / log(2); tv_nn = floor(tv_mi + 0.5); tv_ct = (tv_mi - tv_nn) * 100;
    tv_nm_ = tv_nn % 12; tv_oc = floor(tv_nn / 12) - 1;
    strcpy(#tg_nt, tv_nm_ == 0 ? "C" : tv_nm_ == 1 ? "C#" : tv_nm_ == 2 ? "D" : tv_nm_ == 3 ? "D#" : tv_nm_ == 4 ? "E" : tv_nm_ == 5 ? "F" :
                   tv_nm_ == 6 ? "F#" : tv_nm_ == 7 ? "G" : tv_nm_ == 8 ? "G#" : tv_nm_ == 9 ? "A" : tv_nm_ == 10 ? "A#" : "B");
    tv_pf < 1000 ? sprintf(#tg_fs, "%.1f Hz", tv_pf) : sprintf(#tg_fs, "%.3f kHz", tv_pf / 1000);
    sprintf(#tg_s, "%s   %s%d %+.0f ct   %.1f dB", #tg_fs, #tg_nt, tv_oc, tv_ct, tv_pl);
    // the marker on the peak (where the tilted curve shows it)
    tv_x = tg_fx(tv_pf); tv_y = tg_dy(tv_pl + tv_slp * log(tv_pf / 1000) / log(2));
    ui_cola(0xFFFFFF, 0.35); tg_r(tv_x, tv_py, 1 / sc, tv_ph);
    ui_col(0xFFFFFF); gfx_circle(tv_x * sc, tv_y * sc, 3.5 * sc, 0, 1); gfx_circle(tv_x * sc, tv_y * sc, 2.5 * sc, 0, 1);
    tg_tip(#tg_s);
  ) : (
    tv_mf < 1000 ? sprintf(#tg_s, "%.1f Hz", tv_mf) : sprintf(#tg_s, "%.3f kHz", tv_mf / 1000);
    tg_tip(#tg_s);
  );
);

// =====================================================================================================================
// The controls under the spectrum (hidden in WIDE)
// =====================================================================================================================
!tv_wide ? (
  // row 1: the analysis
  tg_sdd(12, 416, 128, "MODE", 1, "STEREO|MONO|MID-SIDE|LEFT|RIGHT|SURROUND 5.1|SURROUND 7.1");
  tg_sdd(148, 416, 76, "BLOCK", 2, "1024|2048|4096|8192|16384|32768");
  tg_sdd(232, 416, 80, "OVERLAP", 3, "0 %|50 %|75 %|87.5 %");
  tg_sdd(320, 416, 164, "WINDOW", 4, "HANN|BLACKMAN-HARRIS|FLAT-TOP");
  tg_sdd(492, 416, 104, "AVERAGE", 5, "OFF|FAST|MEDIUM|SLOW|VERY SLOW");
  tg_sdd(604, 416, 104, "SMOOTH", 6, "OFF|1/24 OCT|1/12 OCT|1/6 OCT|1/3 OCT");
  // row 2: the view
  tg_sdd(12, 464, 128, "SLOPE", 7, "0 dB/OCT|3 dB/OCT|4.5 dB/OCT");
  tg_sdd(148, 464, 76, "TOP", 8, "+12 dB|+6 dB|0 dB|-6 dB|-12 dB|-20 dB");
  tg_sdd(232, 464, 80, "BOTTOM", 9, "-48 dB|-60 dB|-72 dB|-84 dB|-96 dB|-120 dB|-144 dB");
  tg_sdd(320, 464, 164, "FREQUENCY", 10, "20 Hz - 20 kHz|10 Hz - 24 kHz|20 Hz - 2 kHz|20 Hz - 500 Hz|200 Hz - 20 kHz|1 kHz - 24 kHz");
  tg_cap(492, 455, "CURVE");
  tg_key(492, 464, 50, 24, "FILL", tv_fill, 1, TI_) ? ( slider11 = 0; ui_auto(11); );
  tg_key(546, 464, 50, 24, "LINE", !tv_fill, 1, TI_) ? ( slider11 = 1; ui_auto(11); );
  // row 3: the overlays and the reference snapshots
  tg_cap(12, 503, "MAX HOLD  ·  DECAY");
  tg_key(12, 512, 50, 24, "MAX", slider12 >= 0.5, 1, TI_) ? ( slider12 = slider12 >= 0.5 ? 0 : 1; ui_auto(12); );
  tg_sdd(66, 512, 92, "", 13, "1 dB/s|3 dB/s|6 dB/s|12 dB/s|24 dB/s");
  tg_cap(166, 503, "ALL-TIME MAX");
  tg_key(166, 512, 50, 24, "ALL", slider14 >= 0.5, 1, TI_) ? ( slider14 = slider14 >= 0.5 ? 0 : 1; ui_auto(14); );
  tg_key(220, 512, 62, 24, "CLEAR", 0, 1, TI_) ? tg_rqm += 1;
  tg_cap(320, 503, "REFERENCE");
  tv_i = 0;
  loop(4,
    sprintf(#tg_s, "R%d", tv_i + 1);
    tg_key(320 + tv_i * 40, 512, 36, 24, #tg_s, (slider15 >> tv_i) & 1 && REF[4096 + tv_i], REF[4096 + tv_i] > 0, tg_refcol(tv_i)) ?
      ( slider15 = (slider15 | 0) ~ (1 << tv_i); ui_auto(15); );
    tv_i += 1;
  );
  tv_k = tg_dd(484, 512, 112, 24, "Freeze into R1|Freeze into R2|Freeze into R3|Freeze into R4|Clear R1|Clear R2|Clear R3|Clear R4", 0, 1, "FREEZE");
  tv_k >= 0 && tv_k < 4 ? (
    memcpy(REF + tv_k * GN, SUMDB, GN); REF[4096 + tv_k] = 1;
    slider15 = (slider15 | 0) | (1 << tv_k); ui_auto(15);
  );
  tv_k >= 4 ? ( REF[4096 + tv_k - 4] = 0; slider15 = (slider15 | 0) & (15 ~ (1 << (tv_k - 4))); ui_auto(15); );
  // row 4: cross-instance sharing
  tg_sdd(12, 560, 128, "SEND", 16, "OFF|SLOT 1|SLOT 2|SLOT 3|SLOT 4|SLOT 5|SLOT 6|SLOT 7|SLOT 8");
  tg_cap(148, 551, "SHOW SHARED SLOTS");
  tv_i = 0;
  loop(8,
    sprintf(#tg_s, "%d", tv_i + 1);
    tg_key(148 + tv_i * 38, 560, 34, 24, #tg_s, (slider17 >> tv_i) & 1, tv_i + 1 != tg_send, tg_slotcol(tv_i)) ?
      ( slider17 = (slider17 | 0) ~ (1 << tv_i); ui_auto(17); );
    // a live slot: a small lamp under the key
    SLOTF[tv_i] && tv_i + 1 != tg_send ? ( ui_col(tg_slotcol(tv_i)); tg_r(148 + tv_i * 38 + 13, 587, 8, 2); );
    tv_i += 1;
  );
  gfx_setfont(11);
  ga.busy && tg_send > 0 ? ( ui_col(TA_); tg_t(456, 572, "SLOT ALSO SENT BY ANOTHER INSTANCE", 0); ) : (
    ui_col(TI2);
    tg_send > 0 ? sprintf(#tg_s, "SENDING TO SLOT %d  ·  %d OTHER%s LIVE", tg_send, tv_live, tv_live == 1 ? "" : "S")
                : sprintf(#tg_s, "%d SLOT%s LIVE", tv_live, tv_live == 1 ? "" : "S");
    tg_t(456, 572, #tg_s, 0);
  );
);

// =====================================================================================================================
// The meters
// =====================================================================================================================
tv_scl = slider22 | 0;
tv_kref = tv_scl == 1 ? -20 : tv_scl == 2 ? -14 : tv_scl == 3 ? -12 : 0;
tv_kref += (slider23 | 0) - 3;                          // the calibration offset moves 0 K
tv_ceil = slider24 < 0.5 ? 0 : slider24 < 1.5 ? -0.1 : slider24 < 2.5 ? -0.3 : slider24 < 3.5 ? -0.5 : slider24 < 4.5 ? -1 : -2;
tv_tgt = slider25 < 0.5 ? -23 : slider25 < 1.5 ? -24 : slider25 < 2.5 ? -20 : slider25 < 3.5 ? -18 : slider25 < 4.5 ? -16 : -14;
// the bar scale (dBFS): -60 .. -30 compressed, -30 .. 0 open, 0 .. +3 the overs
function tg_bpos(d) ( d < -30 ? 0.24 * (max(d, -60) + 60) / 30 : d < 0 ? 0.24 + 0.70 * (d + 30) / 30 : min(0.94 + 0.06 * d / 3, 1); );
// the colour of a segment at level d (dBFS)
function tg_zcol(d) (
  tv_scl > 0 ? ( d >= tv_kref + 4 ? TR_ : d >= tv_kref ? TA_ : 0x5CD65C ) : ( d >= -0.001 ? TR_ : d >= -12 ? TA_ : TI_ );
);
tv_tpmx = tv_spmx = 0; tv_clc = 0; tv_c = 0;
loop(tg_nm, tv_tpmx = max(tv_tpmx, TPM[tv_c]); tv_spmx = max(tv_spmx, SPM[tv_c]); tv_clc += CLC[tv_c]; tv_c += 1; );
// one vertical segmented bar from the bottom yb, height h: level d (dBFS), hold marker hd (-999 = none)
function tg_vbar(x, yb, w, h, d, hd) local(n, i, sh, p, lit, sd, q, hi) (
  n = floor(h / 3); sh = h / n;
  q = tg_bpos(d); hi = hd > -200 ? min(floor(tg_bpos(hd) * n), n - 1) : -1;
  i = 0;
  loop(n,
    p = (i + 0.5) / n; lit = q >= p;
    sd = p < 0.24 ? -60 + p / 0.24 * 30 : p < 0.94 ? -30 + (p - 0.24) / 0.70 * 30 : (p - 0.94) / 0.06 * 3;
    lit || i == hi ? ( ui_col(i == hi && !lit ? ui_mix(tg_zcol(sd), 0xFFFFFF, 0.3) : tg_zcol(sd)); tg_r(x, yb - (i + 1) * sh + 0.5, w, sh - 1); )
                   : ( ui_col(TGH); tg_r(x, yb - (i + 1) * sh + 0.5, w, sh - 1); );
    i += 1;
  );
);
// the meter bars of all channels in a box (x, y, w, h); thin = a slim strip (no scale numbers)
function tg_bars(x, y, w, h, thin) local(c, cw, bx, pkw, rw, rms, pk, hd, yb, d, i, tx) (
  cw = w / tg_nm; yb = y + h;
  c = 0;
  loop(tg_nm,
    bx = x + c * cw;
    rms = 10 * log10(max(MSQ[c], 0.0000000000000001)) + (tv_scl > 0 ? 3.0103 : 0);   // K: sine-referenced RMS
    pk = PKD[c]; hd = slider20 >= 0.5 ? PKH[c] : -999;
    tv_scl > 0 ? (                                      // K-SYSTEM: the RMS is the bar, the peak a thin bar
      pkw = max(floor(cw * 0.62), 3); rw = max(floor(cw * 0.18), 2);
      tg_vbar(bx + 1, yb, pkw, h, rms, -999); tg_vbar(bx + 2 + pkw, yb, rw, h, pk, hd);
    ) : (
      pkw = max(floor(cw * 0.6), 3); rw = max(floor(cw * 0.2), 2);
      tg_vbar(bx + 1, yb, pkw, h, pk, hd); tg_vbar(bx + 2 + pkw, yb, rw, h, rms, -999);
    );
    !thin ? ( gfx_setfont(11); ui_col(tg_ccol(tg_md >= 5 ? c : c)); tg_t(bx + 1 + (pkw + rw + 1) * 0.5, yb + 10, tg_mcol(c), 1); );
    // values on hover
    tg_in(bx, y, cw, h + 18) ? (
      sprintf(#tg_tt, "%s   PEAK %.1f dBFS   TP MAX %.1f dBTP   RMS %.1f dB%s", tg_mcol(c), max(pk, -99.9),
              max(tg_db(TPM[c]), -99.9), max(rms, -99.9), tv_scl > 0 ? " (AES17)" : "FS");
      tv_hovm = 1;
    );
    c += 1;
  );
  // the scale
  !thin ? (
    gfx_setfont(11); i = 0;
    loop(9,
      d = i == 0 ? 0 : i == 1 ? -999 : i == 2 ? -6 : i == 3 ? -12 : i == 4 ? -18 : i == 5 ? -24 : i == 6 ? -30 : i == 7 ? -999 : -60;
      tv_scl > 0 ? d = i == 0 ? tv_kref + 4 : i == 1 ? tv_kref : i == 2 ? -999 : i == 3 ? tv_kref - 10 : i == 4 ? tv_kref - 20 :
                   i == 6 ? 0 : -999;
      d > -61 && d <= 3 ? (
        tx = yb - tg_bpos(d) * h;
        ui_col(TI2); tg_r(x - 6, tx, 4, 1 / sc);
        tv_scl > 0 ? ( abs(d - tv_kref - 4) < 0.1 ? strcpy(#tg_s, "") : d - tv_kref > 0.5 ? sprintf(#tg_s, "+%d", d - tv_kref) : sprintf(#tg_s, "%d", d - tv_kref); )
                   : sprintf(#tg_s, "%d", d);
        ui_col(tv_scl > 0 ? (d - tv_kref >= 4 ? TR_ : d - tv_kref >= 0 ? TA_ : TI2) : (d >= 0 ? TR_ : TI2));
        tg_t(x - 9, tx, #tg_s, 2);
      );
      i += 1;
    );
  );
);

tv_hovm = 0;
!tv_wide ? (
  // ---------- LEVEL ----------
  tv_mx = 720; tv_mw = 308;
  tg_mod(tv_mx, 64, tv_mw, 276);
  tg_cap(tv_mx + 10, 76, "LEVEL");
  gfx_setfont(11); ui_col(TI_);
  tv_scl > 0 ? sprintf(#tg_s, "K-%d  ·  0 = %d dBFS RMS", tv_scl == 1 ? 20 : tv_scl == 2 ? 14 : 12, tv_kref)
             : strcpy(#tg_s, "PEAK / RMS  dBFS");
  tg_t(tv_mx + 58, 76, #tg_s, 0);
  tg_bars(tv_mx + 42, 92, 146, 138, 0);
  // the readouts (click them to reset)
  tv_rx = tv_mx + 198;
  tg_cap(tv_rx, 96, "TRUE PEAK MAX");
  gfx_setfont(15); ui_col(tg_db(tv_tpmx) > tv_ceil ? TR_ : TI_);
  tv_tpmx > 0.0000001 ? sprintf(#tg_s, "%.1f", tg_db(tv_tpmx)) : strcpy(#tg_s, "---"); tg_t(tv_rx, 113, #tg_s, 0);
  gfx_setfont(11); ui_col(TI2); tg_t(tv_rx + 98, 114, "dBTP", 2);
  tg_cap(tv_rx, 134, "PEAK MAX");
  gfx_setfont(15); ui_col(tv_spmx >= 1 ? TR_ : TI_);
  tv_spmx > 0.0000001 ? sprintf(#tg_s, "%.1f", tg_db(tv_spmx)) : strcpy(#tg_s, "---"); tg_t(tv_rx, 151, #tg_s, 0);
  gfx_setfont(11); ui_col(TI2); tg_t(tv_rx + 98, 152, "dBFS", 2);
  tg_cap(tv_rx, 172, "HEADROOM");
  gfx_setfont(11); ui_col(TI_);
  tv_spmx > 0.0000001 ? sprintf(#tg_s, "0 dBFS   %.1f", -tg_db(tv_spmx)) : strcpy(#tg_s, "0 dBFS   ---"); tg_t(tv_rx, 188, #tg_s, 0);
  ui_col(tv_tpmx > 0.0000001 && tv_ceil - tg_db(tv_tpmx) < 0 ? TR_ : TI_);
  tv_tpmx > 0.0000001 ? sprintf(#tg_s, "CEIL     %.1f", tv_ceil - tg_db(tv_tpmx)) : strcpy(#tg_s, "CEIL     ---"); tg_t(tv_rx, 204, #tg_s, 0);
  // CLIP: the lamp and the count
  tg_cap(tv_rx, 224, "CLIP");
  tg_clip ? ( ui_cola(TR_, 0.3); tg_r(tv_rx + 34, 217, 18, 14); ui_col(TR_); ) : ui_col(0x2A1410);
  tg_r(tv_rx + 36, 219, 14, 10);
  gfx_setfont(11); ui_col(tg_clip ? TR_ : TI2); sprintf(#tg_s, "%d", tv_clc); tg_t(tv_rx + 98, 224, #tg_s, 2);
  tg_in(tv_rx - 4, 88, 108, 148) ? (
    ui_cola(TI_, 0.06); tg_r(tv_rx - 4, 88, 106, 148);
    strcpy(#tg_tt, "CLICK TO RESET THE MAXIMA AND THE CLIP COUNT"); tv_hovm = 1;
    pressed && drag_id == 0 ? ( drag_id = -1; tg_rqc += 1; );
  );
  // the meter settings
  tg_sdd(tv_mx + 10, 268, 92, "BALLISTICS", 19, "FAST|MEDIUM|SLOW");
  tg_sdd(tv_mx + 108, 268, 92, "HOLD", 20, "OFF|1 s|2 s|5 s|INF");
  tg_sdd(tv_mx + 206, 268, 92, "RMS", 21, "50 ms|300 ms|600 ms|1 s|3 s");
  tg_sdd(tv_mx + 10, 310, 92, "SCALE", 22, "dBFS|K-20|K-14|K-12");
  tv_k = tg_dd(tv_mx + 108, 310, 92, 24, "-3 dB|-2 dB|-1 dB|0 dB|+1 dB|+2 dB|+3 dB", slider23, tv_scl > 0, "");
  tg_cap(tv_mx + 108, 301, "K OFFSET");
  tv_k >= 0 ? ( slider23 = tv_k; ui_auto(23); );
  tg_sdd(tv_mx + 206, 310, 92, "TP CEILING", 24, "0.0 dBTP|-0.1 dBTP|-0.3 dBTP|-0.5 dBTP|-1.0 dBTP|-2.0 dBTP");

  // ---------- LOUDNESS ----------
  tg_mod(tv_mx, 346, tv_mw, 126);
  tg_cap(tv_mx + 10, 358, "LOUDNESS  ·  BS.1770 / R128");
  tv_i = 0;
  loop(3,
    tv_x = tv_mx + 10 + tv_i * 98;
    ui_col(TBZ); tg_r(tv_x, 370, 92, 44); ui_col(0x0A0B0C); tg_r(tv_x + 1, 371, 90, 42);
    gfx_setfont(11); ui_col(TI2); tg_t(tv_x + 6, 380, tv_i == 0 ? "M" : tv_i == 1 ? "S" : "I", 0);
    ui_cola(TI2, 0.8); tg_t(tv_x + 86, 380, "LUFS", 2);
    tv_v = tv_i == 0 ? tg_lm : tv_i == 1 ? tg_ls : tg_li;
    gfx_setfont(13);
    ui_col(tv_i == 2 && tv_v > -70 ? (abs(tv_v - tv_tgt) <= 1 ? 0x5CD65C : tv_v > tv_tgt ? TA_ : TI_) : TI_);
    tg_t(tv_x + 46, 400, tg_lufs(tv_v, #tg_s), 1);
    tg_in(tv_x, 370, 92, 44) ? (
      tv_i == 0 ? ( sprintf(#tg_tt, "MOMENTARY (400 ms)   MAX %s LUFS", tg_lufs(tg_mmax, #tg_s2)); ) :
      tv_i == 1 ? strcpy(#tg_tt, "SHORT-TERM (3 s)") : strcpy(#tg_tt, "INTEGRATED (GATED -70 LUFS / -10 LU)");
      tv_hovm = 1;
    );
    tv_i += 1;
  );
  // LRA, the distance to the target, TARGET and RESET
  tv_x = tv_mx + 10;
  ui_col(TBZ); tg_r(tv_x, 420, 92, 44); ui_col(0x0A0B0C); tg_r(tv_x + 1, 421, 90, 42);
  gfx_setfont(11); ui_col(TI2); tg_t(tv_x + 6, 430, "LRA", 0); ui_cola(TI2, 0.8); tg_t(tv_x + 86, 430, "LU", 2);
  gfx_setfont(15); ui_col(TI_); tg_lra >= 0 ? sprintf(#tg_s, "%.1f", tg_lra) : strcpy(#tg_s, "---"); tg_t(tv_x + 46, 450, #tg_s, 1);
  tv_x += 98;
  ui_col(TBZ); tg_r(tv_x, 420, 92, 44); ui_col(0x0A0B0C); tg_r(tv_x + 1, 421, 90, 42);
  gfx_setfont(11); ui_col(TI2); tg_t(tv_x + 6, 430, "I - TARGET", 0);
  gfx_setfont(15); tg_li > -70 ? ( sprintf(#tg_s, "%+.1f LU", tg_li - tv_tgt); ui_col(abs(tg_li - tv_tgt) <= 1 ? 0x5CD65C : TA_); )
                               : ( strcpy(#tg_s, "---"); ui_col(TI_); );
  tg_t(tv_x + 46, 450, #tg_s, 1);
  tv_x += 98;
  tv_k = tg_dd(tv_x, 420, 92, 20, "-23 LUFS|-24 LUFS|-20 LUFS|-18 LUFS|-16 LUFS|-14 LUFS", slider25, 1, "");
  tv_k >= 0 ? ( slider25 = tv_k; ui_auto(25); );
  tg_key(tv_x, 444, 92, 20, "RESET", 0, 1, TI_) ? tg_rql += 1;

  // ---------- PHASE: goniometer, correlation, the three bands ----------
  tg_mod(tv_mx, 478, tv_mw, 110);
  tv_gx = tv_mx + 8; tv_gy = 484; tv_gs = 98;
  ui_col(0x0A0B0C); tg_r(tv_gx, tv_gy, tv_gs, tv_gs);
  ui_col(TGR); tg_r(tv_gx + tv_gs * 0.5, tv_gy, 1 / sc, tv_gs); tg_r(tv_gx, tv_gy + tv_gs * 0.5, tv_gs, 1 / sc);
  ui_cola(TGR, 0.8); gfx_line(tv_gx * sc, tv_gy * sc, (tv_gx + tv_gs) * sc, (tv_gy + tv_gs) * sc, 1);
  gfx_line((tv_gx + tv_gs) * sc, tv_gy * sc, tv_gx * sc, (tv_gy + tv_gs) * sc, 1);
  // the last 1024 samples of L and R from the ring (auto-ranging)
  tv_st = (tg_rw - 1024) & 65535; tv_pk = 0.000001; tv_i = 0;
  loop(1024, tv_j = (tv_st + tv_i) & 65535; tv_pk = max(tv_pk, max(abs(RB[tv_j]), abs(RB[65536 + tv_j]))); tv_i += 2; );
  tv_gr_ = tv_gr_ > 0 ? max(tv_pk, tv_gr_ * 0.92) : tv_pk;
  tv_gk = tv_gs * 0.46 / max(tv_gr_, 0.001);
  ui_cola(TI_, 0.55); tv_i = 0;
  loop(512,
    tv_j = (tv_st + tv_i * 2) & 65535; tv_l = RB[tv_j]; tv_rr = RB[65536 + tv_j];
    tv_x = tv_gx + tv_gs * 0.5 + (tv_l - tv_rr) * 0.70711 * tv_gk; tv_y = tv_gy + tv_gs * 0.5 - (tv_l + tv_rr) * 0.70711 * tv_gk;
    gfx_rect(floor(tv_x * sc), floor(tv_y * sc), max(1, floor(sc * 1.4)), max(1, floor(sc * 1.4)));
    tv_i += 1;
  );
  gfx_setfont(11); ui_col(TI2); tg_t(tv_gx + tv_gs * 0.5, tv_gy + 8, "M", 1); tg_t(tv_gx + 7, tv_gy + 14, "L", 1); tg_t(tv_gx + tv_gs - 7, tv_gy + 14, "R", 1);
  // correlation: the VFD segment bar from the centre
  tv_cx0 = tv_mx + 116; tv_cw = 180;
  tg_cap(tv_cx0, 492, "CORRELATION");
  tv_cr_ += (tg_cor - tv_cr_) * 0.25;
  sprintf(#tg_s, "%+.2f", tv_cr_); gfx_setfont(11); ui_col(tv_cr_ < 0 ? TA_ : TI_); tg_t(tv_cx0 + tv_cw, 492, #tg_s, 2);
  tv_n = 45; tv_sw = tv_cw / tv_n; tv_i = 0;
  loop(tv_n,
    tv_v = -1 + (tv_i + 0.5) / tv_n * 2;
    tv_lit = tv_cr_ >= 0 ? (tv_v > 0 && tv_v <= tv_cr_ + 1 / tv_n) : (tv_v < 0 && tv_v >= tv_cr_ - 1 / tv_n);
    abs(tv_v) < 1.01 / tv_n ? tv_lit = 1;
    ui_col(tv_lit ? (tv_v < 0 ? TA_ : TI_) : TGH); tg_r(tv_cx0 + tv_i * tv_sw, 502, tv_sw - 1, 12);
    tv_i += 1;
  );
  gfx_setfont(11); ui_col(TI2);
  tg_t(tv_cx0, 524, "-1", 0); tg_t(tv_cx0 + tv_cw * 0.5, 524, "0", 1); tg_t(tv_cx0 + tv_cw, 524, "+1", 2);
  // the bands (from the FFT, in STEREO and MID-SIDE)
  tv_i = 0;
  loop(3,
    tv_x = tv_cx0 + tv_i * 62; tv_w = 56;
    gfx_setfont(11); ui_col(TI2); tg_t(tv_x, 546, tv_i == 0 ? "LOW" : tv_i == 1 ? "MID" : "HIGH", 0);
    tv_v = BCOR[24 + tv_i];
    BCV[tv_i] += (tv_v - BCV[tv_i]) * 0.25;
    ui_col(TGH); tg_r(tv_x, 556, tv_w, 10);
    ga.bok ? (
      tv_v = BCV[tv_i];
      ui_col(tv_v < 0 ? TA_ : TI_);
      tv_v >= 0 ? tg_r(tv_x + tv_w * 0.5, 556, tv_w * 0.5 * tv_v, 10) : tg_r(tv_x + tv_w * 0.5 * (1 + tv_v), 556, -tv_w * 0.5 * tv_v, 10);
      sprintf(#tg_s, "%+.2f", tv_v);
    ) : strcpy(#tg_s, "--");
    ui_col(TI2); tg_r(tv_x + tv_w * 0.5, 554, 1 / sc, 14);
    gfx_setfont(11); ui_col(TI_); tg_t(tv_x + tv_w, 577, #tg_s, 2);
    tv_i += 1;
  );
) : (
  // ---------- WIDE: the slim strip ----------
  tv_mx = 970; tv_mw = 58;
  tg_mod(tv_mx, 64, tv_mw, 524);
  gfx_setfont(11); ui_col(TI2); tg_t(tv_mx + tv_mw * 0.5, 76, tv_scl > 0 ? "K/PK" : "PK/RMS", 1);
  tg_bars(tv_mx + 6, 88, tv_mw - 12, 330, 1);
  tv_i = 0;
  loop(4,
    tv_y = 432 + tv_i * 38;
    gfx_setfont(11); ui_col(TI2); tg_t(tv_mx + tv_mw * 0.5, tv_y, tv_i == 0 ? "TP" : tv_i == 1 ? "S" : tv_i == 2 ? "I" : "CORR", 1);
    tv_i == 0 ? ( ui_col(tg_db(tv_tpmx) > tv_ceil ? TR_ : TI_); tv_tpmx > 0.0000001 ? sprintf(#tg_s, "%.1f", tg_db(tv_tpmx)) : strcpy(#tg_s, "---"); ) :
    tv_i == 1 ? ( ui_col(TI_); tg_lufs(tg_ls, #tg_s); ) :
    tv_i == 2 ? ( ui_col(tg_li > -70 && abs(tg_li - tv_tgt) <= 1 ? 0x5CD65C : TI_); tg_lufs(tg_li, #tg_s); ) :
                ( ui_col(tg_cor < 0 ? TA_ : TI_); sprintf(#tg_s, "%+.2f", tg_cor); );
    tg_t(tv_mx + tv_mw * 0.5, tv_y + 15, #tg_s, 1);
    tv_i += 1;
  );
  tg_clip ? ( ui_col(TR_); tg_r(tv_mx + 8, 578, tv_mw - 16, 4); );
);
tv_hovm ? tg_tip(#tg_tt);

pk_end();
ui_end();
