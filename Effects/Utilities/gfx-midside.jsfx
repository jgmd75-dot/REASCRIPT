desc:Mid/Side [mid/side width] (GFX)
//tags: mid side stereo width imaging mastering
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output and gfx-ui (.jsfx-inc) in the same folder.
//
// Mid/side processor:
//   MID / SIDE gain, WIDTH (0-200 %, loudness kept steady), BASS MONO (sides removed below a frequency, 24 dB/oct),
//   AIR (high shelf on the sides), FOCUS (presence on the mid), L/R or M/S input and output formats.
//   Listen: STEREO, MID solo, SIDE solo (monitoring only).
// Drift: width breathes, air wanders, balance leans. The DRIFT dial scales the three drift amounts
// (50% = the drift settings, 100% = twice, 0 = none) and speeds the wander up with them.
// IN / OUT: TRIM (with the GUARD key) and SAT sit on the panel.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc

slider1:0<0,2,1{Stereo,Mid,Side}>-Listen
slider2:0<-12,12,0.1>-Mid gain (dB)
slider3:0<-12,12,0.1>-Side gain (dB)
slider4:100<0,200,1>-Width (%)
slider5:0<0,300,1>-Bass mono (Hz, 0 = off)
slider6:0<0,9,0.1>-Air (dB)
slider7:0<0,6,0.1>-Mid focus (dB)
slider8:0<0,1,1{L/R,M/S}>-Input format
slider9:0<0,1,1{L/R,M/S}>-Output format
slider10:10<0,50,1>-Width drift (%)
slider11:10<0,50,1>-Air drift (%)
slider12:5<0,50,1>-Balance drift (%)
slider13:0.25<0.02,2,0.01>-Drift speed (Hz)
slider14:0<-24,12,0.1>-Output (dB)
slider15:0<-100,100,1>-Balance (%)
slider16:0<0,100,1>-Band sat (%)
slider17:30<0,100,1>-Bias (%)
slider18:120<40,400,1>-Sat low band (Hz)
slider19:6000<2000,16000,10>-Sat high band (Hz)
slider20:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider21:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider22:0<-24,12,0.1>-Input trim (dB)
slider23:1<0,1,1{Off,On}>-Input guard
slider24:50<0,100,1>-Drift (%)
slider25:prs_sel=0<0,8,1{No preset,Subtle Widen,Wide Master,Mono Bass,Vocal Focus,Super Wide,Narrow & Tight,M/S Decode,M/S Encode}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-midside";                                  // the ? pop-up links to this manual

// biquad (RBJ) with coefficients in the instance
function bq_hp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_shelf(f, gdb) instance(b0, b1, b2, a1, a2) local(amp, w0, cw, sw, al, sq, n) (
  amp = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0);
  al = sw / 2 * sqrt(2); sq = 2 * sqrt(amp) * al;
  n = (amp + 1) - (amp - 1) * cw + sq;
  b0 = amp * ((amp + 1) + (amp - 1) * cw + sq) / n;
  b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
  b2 = amp * ((amp + 1) + (amp - 1) * cw - sq) / n;
  a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;
  a2 = ((amp + 1) - (amp - 1) * cw - sq) / n;
);
function bq_peak(f, gdb, q) instance(b0, b1, b2, a1, a2) local(amp, w0, cw, al, n) (
  amp = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * q);
  n = 1 + al / amp;
  b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = -2 * cw / n; a2 = (1 - al / amp) / n;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);

function update() (
  listen = slider1;
  mid_t = 10 ^ (slider2 / 20);
  side_t = 10 ^ (slider3 / 20);
  wid_t = slider4 / 100;
  bmono = slider5;
  bmono >= 20 ? ( hpS.bq_hp(bmono); hpS2.bq_hp(bmono); );
  air_db = slider6;
  slider7 != lastfoc ? ( lastfoc = slider7; pkM.bq_peak(2500, slider7, 0.8); );
  infmt = slider8; outfmt = slider9;
  drift_macro(slider24);
  wd = slider10 / 100 * dm_a; ad = slider11 / 100 * dm_a; bd = slider12 / 100 * dm_a;
  dspd = slider13 * dm_s;
  out_t = 10 ^ (slider14 / 20);
  bal_t = slider15 / 100;
  in_setup(slider22, slider23);
  ost_setup(slider16 / 100, slider17 / 100, slider18, slider19, slider20, 0);   // output stage: straight through
);

// ---------- presets (leave Output, Drift speed and the I/O rows alone) ----------
function setp(ms, ss, w, bm, ai, fo, inf, outf, w_, a_, b_) (
  slider2 = ms; slider3 = ss; slider4 = w; slider5 = bm; slider6 = ai; slider7 = fo;
  slider8 = inf; slider9 = outf; slider10 = w_; slider11 = a_; slider12 = b_;
);
function load_preset(p) (
  p == 1 ? setp(0,  0,   120, 0,   1.5, 0, 0, 0, 10, 10, 5) :   // Subtle Widen
  p == 2 ? setp(0,  0.5, 140, 120, 2.5, 0, 0, 0,  8, 10, 3) :   // Wide Master
  p == 3 ? setp(0,  0,   100, 150, 0,   0, 0, 0,  0,  0, 0) :   // Mono Bass
  p == 4 ? setp(1,  0,    90, 100, 0,   3, 0, 0,  5,  5, 3) :   // Vocal Focus
  p == 5 ? setp(0,  1,   175, 200, 4,   0, 0, 0, 15, 15, 5) :   // Super Wide
  p == 6 ? setp(0, -2,    70, 150, 0,   0, 0, 0,  0,  0, 0) :   // Narrow & Tight
  p == 7 ? setp(0,  0,   100, 0,   0,   0, 1, 0,  0,  0, 0) :   // M/S Decode
  p == 8 ? setp(0,  0,   100, 0,   0,   0, 0, 1,  0,  0, 0);    // M/S Encode
  p >= 1 && p <= 8 ? slider_automate(4094);   // sliders 2-12
  p == 9 ? (                                   // Reset all to defaults
    slider1 = 0; slider2 = 0; slider3 = 0; slider4 = 100; slider5 = 0; slider6 = 0; slider7 = 0;
    slider8 = 0; slider9 = 0; slider10 = 10; slider11 = 10; slider12 = 5; slider13 = 0.25;
    slider14 = 0; slider15 = 0;
    slider16 = 0; slider17 = 30; slider18 = 120; slider19 = 6000; slider20 = -0.3; slider21 = 1;
    slider22 = 0; slider23 = 1; slider24 = 50;
    slider_automate(16777215);
  );
);

// ---------- memory ----------
scL = 0; scR = 512; scN = 512;   // vectorscope ring
memset(0, 0, 1024);
scw = 0; scd = 0;

// ---------- state ----------
sm  = 1 - exp(-1 / (0.03 * srate));
vuc = 1 - exp(-1 / (0.01 * srate));
vu_sine = 10 * log10(2);   // +3.01 dB: RMS -> sine peak, so a sine peaking at the ref level reads 0 VU
crc = 1 - exp(-1 / (0.3 * srate));
drW.drift_init(0.8 + rand(0.5));
drA.drift_init(0.8 + rand(0.5));
drB.drift_init(0.8 + rand(0.5));
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
pkL = 0; pkR = 0; vu_ms = 0; cLR = 0; cLL = 0; cRR = 0; eM = 0; eS = 0;
lastfoc = -1; lastair = -99;
ms_pkM = 0; ms_pkS = 0;                           // display only: output mid / side peaks for the strip meters
ui_thm = 5; ui_hw = 1;                            // one look: house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 0; );            // new instances open in Medium, on Init

update();
mid_s = mid_t; side_s = side_t; wid_s = wid_t; out_s = out_t; bal_s = bal_t;
ui_dflt = 1;   // the defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved size / preset

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
update();

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_avail(0) != 0 ? file_var(0, pr_cur);    // the preset in use (older projects end before it)
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// input stage: DC block, trim, guard
in_process(spl0, spl1);
inL = in_l; inR = in_r;
vu_ms += (0.5 * (inL * inL + inR * inR) - vu_ms) * vuc;

// drift
dinc = dspd / srate;
vW = drW.drift_tick(dinc);
vA = drA.drift_tick(dinc);
vB = drB.drift_tick(dinc);

// smoothing
mid_s  += (mid_t  - mid_s)  * sm;
side_s += (side_t - side_s) * sm;
wid_s  += (wid_t  - wid_s)  * sm;
out_s  += (out_t  - out_s)  * sm;
bal_s  += (bal_t  - bal_s)  * sm;

// air shelf follows its drift (recomputed only when it moves noticeably)
airnow = air_db * (1 + ad * vA);
abs(airnow - lastair) > 0.05 ? ( lastair = airnow; shS.bq_shelf(8000, airnow); );

// encode
infmt ? ( m = inL; s = inR; ) : ( m = 0.5 * (inL + inR); s = 0.5 * (inL - inR); );

// process
bmono >= 20 ? s = hpS2.bq_run(hpS.bq_run(s));   // 24 dB/oct
air_db > 0.05 ? s = shS.bq_run(s);
slider7 > 0.05 ? m = pkM.bq_run(m);
w = max(wid_s * (1 + wd * 0.5 * vW), 0);
gM = min(sqrt(2 / (1 + w * w)), 1.4142);
m *= mid_s * gM;
s *= side_s * w * gM;

eM += (m * m - eM) * crc; eS += (s * s - eS) * crc;

// listen / decode
listen == 1 ? ( oL = m; oR = m; ) :
listen == 2 ? ( oL = s; oR = s; ) :
outfmt ? ( oL = m; oR = s; ) : ( oL = m + s; oR = m - s; );

// balance (with drift)
bal = min(max(bal_s + bd * 0.3 * vB, -1), 1);
oL *= min(1, 1 - bal); oR *= min(1, 1 + bal);

// output stage
oL = ostL.ost_band(oL) * out_s;
oR = ostR.ost_band(oR) * out_s;
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));

// vectorscope + correlation
cLR += (spl0 * spl1 - cLR) * crc; cLL += (spl0 * spl0 - cLL) * crc; cRR += (spl1 * spl1 - cRR) * crc;
(scd += 1) >= 3 ? ( scd = 0; scL[scw] = spl0; scR[scw] = spl1; scw = (scw + 1) % scN; );
// display only: output mid / side peaks (M/S output: the channels are already mid and side)
ms_pkM = max(ms_pkM, abs(outfmt ? spl0 : 0.5 * (spl0 + spl1)));
ms_pkS = max(ms_pkS, abs(outfmt ? spl1 : 0.5 * (spl0 - spl1)));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 960 388
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 5; ui_hw = 1;   // one look: older projects reload their saved theme / HW flag (kept in @serialize, no longer drawn)
ui_begin(960, 388);
// =====================================================================
// GUI - graphite panel, cyan (MID) / magenta (SIDE) / warm white accents (design space 960 x 388; S / M / L).
// ROUTING | FIELD (vectorscope, width, correlation) | M / S | OUTPUT; the DRIFT + MID / SIDE meter strip below.
// Knobs: drag (SHIFT = fine), wheel, double-click = default; the label shows the value while the knob is touched.
// TRIM: click the knob (or its LED, upper right) for the input GUARD.
// =====================================================================
sc != ms_lsc ? (
  ms_lsc = sc;
  gfx_setfont(11, "Trebuchet MS", 18 * sc, 'b');     // section titles
  gfx_setfont(12, "Trebuchet MS", 14 * sc, 'b');     // big knob label / DRIFT
  gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');     // small print, small knob labels, routing keys
  gfx_setfont(14, "Trebuchet MS", 13 * sc, 'b');     // keys
  gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');     // the unit's name
  gfx_setfont(9, "Trebuchet MS", 16 * sc, 'b');     // the WIDTH read-out
  gfx_setfont(10, "Trebuchet MS", 10 * sc, 'b');     // the display's print
);
MS_FACE = 0x141517; MS_PLATE = 0x1E2023; MS_EDGE = 0x383B40; MS_INK = 0xF0F1F2; MS_DIM = 0x9A9EA5;
MS_CYN = 0x3CD6E6; MS_MAG = 0xE64CB4; MS_WRM = 0xE8E0CC; MS_TRAY = 0x0B0C0D; MS_KEY = 0x2A2C30; MS_CAP = 0xC9CED8;

function ms_rr(x, y, w, h, r) local(x1, y1, x2, y2, rr) (
  x1 = floor(x * sc + 0.5); y1 = floor(y * sc + 0.5); x2 = floor((x + w) * sc + 0.5); y2 = floor((y + h) * sc + 0.5);
  rr = min(floor(r * sc + 0.5), floor((min(x2 - x1, y2 - y1)) * 0.5));
  gfx_a < 1 ? ui_rrs(x1, y1, x2 - x1, y2 - y1, rr) : (
    gfx_rect(x1 + rr, y1, x2 - x1 - 2 * rr, y2 - y1);
    gfx_rect(x1, y1 + rr, rr + 1, y2 - y1 - 2 * rr); gfx_rect(x2 - rr - 1, y1 + rr, rr + 1, y2 - y1 - 2 * rr);
    gfx_circle(x1 + rr, y1 + rr, rr, 1, 1); gfx_circle(x2 - rr - 1, y1 + rr, rr, 1, 1);
    gfx_circle(x1 + rr, y2 - rr - 1, rr, 1, 1); gfx_circle(x2 - rr - 1, y2 - rr - 1, rr, 1, 1);
  );
);
function ms_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function ms_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function ms_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function ms_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function ms_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a flat key, lit in its colour when on; ms_kfont picks its caption font (reset to 14 after each key)
ms_kfont = 14;
function ms_key(x, y, w, h, on, col, s) local(hov, hit) (
  hov = ms_in(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.4); ms_rr(x + 1, y + 2, w, h, 4);
  on ? ( ui_cola(col, 0.22); ms_rr(x - 3, y - 3, w + 6, h + 6, 6); );
  ui_cola(on ? col : MS_KEY, 1); ms_rr(x, y, w, h, 4);
  !on ? ( ui_col(ui_mix(col, MS_KEY, 0.7)); ms_r(x + 3, y, w - 6, 2); );
  hov ? ( ui_cola(0xFFFFFF, 0.1); ms_rr(x, y, w, h, 4); );
  gfx_setfont(ms_kfont); ui_cola(on ? 0x14161C : ui_mix(col, MS_INK, 0.45), 1);
  ui_keytext((x + w * 0.5) * sc, (y + h * 0.5) * sc, s);
  gfx_a = 1; ms_kfont = 14;
  hit;
);
function ms_sec(x0, w, title) (
  ui_cola(0x000000, 0.47); ms_rr(x0 + 1, 74, w, 226, 8);
  ui_col(MS_EDGE); ms_rr(x0, 72, w, 226, 8);
  ui_col(MS_PLATE); ms_rr(x0 + 1.5, 73.5, w - 3, 223, 7);
  ui_col(MS_CYN); ms_r(x0 + 18, 84, 4, 22);
  gfx_setfont(11); ui_col(MS_INK); ms_tl(x0 + 30, 85, title);
  dy_bg = 0x494D54; dy_ink = MS_INK;   // (dy_bg: the knob track is drawn 30 % darker: 0x33363B)
);
function ms_inset(x, y, w, h) ( pk_inset(x * sc, y * sc, w * sc, h * sc, MS_TRAY); );
function ms_rivet(x, y) (
  ui_cola(0x000000, 0.4); gfx_circle((x + 0.5) * sc, (y + 1) * sc, 3 * sc, 1, 1);
  ui_col(0x444850); gfx_circle(x * sc, y * sc, 3 * sc, 1, 1);
  ui_col(0x5C616B); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 1.2 * sc, 1, 1);
);
// the knob's normalised position (0 .. 1)
function ms_n(idx, lo, hi, lg) local(n) (
  n = lg ? log(slider(idx) / lo) / log(hi / lo) : (slider(idx) - lo) / (hi - lo); min(max(n, 0), 1);
);
// the value arc in col (over dy_ccap's own, which follows the cap) and a dark pointer (over the cap's light one)
function ms_ptr(cx, cy, r, idx, lo, hi, lg, col) local(n, a, a0, ca, sa, x1, y1, x2, y2, k, rr) (
  n = ms_n(idx, lo, hi, lg); a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  n > 0.004 ? (
    rr = (r + 6) * sc; ui_col(col); dy_arcw(cx * sc, cy * sc, rr, a0, a, 3 * sc);
    gfx_circle(cx * sc + sin(a0) * rr, cy * sc - cos(a0) * rr, 1.5 * sc, 1, 1); gfx_circle(cx * sc + ca * rr, cy * sc + sa * rr, 1.5 * sc, 1, 1);
  );
  ui_col(0x181C26);
  x1 = (cx + ca * r * 0.3) * sc; y1 = (cy + sa * r * 0.3) * sc; x2 = (cx + ca * (r - 3)) * sc; y2 = (cy + sa * (r - 3)) * sc;
  k = -1.2; loop(7, gfx_line(x1 - sa * k * sc, y1 + ca * k * sc, x2 - sa * k * sc, y2 + ca * k * sc, 1); k += 0.4; );
);
// a knob: cap colour, arc colour; the label (or, while touched, the value) under it (big: 14 px, 18 below; small: 12 px, 14 below)
function ms_knob(cx, cy, r, idx, lo, hi, def, lg, cap, col, lbl, val, big) (
  dy_kst = 36; dy_knob(cx, cy, r, idx, lo, hi, def, lg, cap, "", ""); ms_ptr(cx, cy, r, idx, lo, hi, lg, col);
  gfx_setfont(big ? 12 : 13); ui_col(dy_act ? col : MS_INK); ms_tc(cx, cy + r + (big ? 18 : 14), dy_act ? val : lbl);
);
// a 40-segment LED row (x, y unscaled; -54 .. +4.5 dBFS, 1.5 dB steps): col up to -9 dB, amber to 0 dB, red above;
// a floating peak segment holds for 1.2 s
function ms_ledrow(x, y, pk, col) instance(hold, ht) local(db, sdb, c, lit, hi, j) (
  db = pk > 0.00001 ? 20 * log10(pk) : -100;
  ht == 0 && hold == 0 ? hold = -100;
  db > hold ? ( hold = db; ht = time_precise(); ) : ( time_precise() - ht > 1.2 ? hold = max(hold - 0.6, db); );
  j = 0;
  loop(40,
    sdb = -54 + j * 1.5;
    c = j < 30 ? col : j < 36 ? 0xF0B030 : 0xF04030;
    lit = db >= sdb; hi = hold >= sdb && hold < sdb + 1.5 && hold > -54;
    ui_col(lit || hi ? c : ui_mix(c, 0x000000, 0.8)); ms_r(x + j * 11.6, y, 10, 9);
    j += 1;
  );
);

// =====================================================================
// Draw
// =====================================================================
ui_col(MS_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(MS_CYN); ms_r(0, 58, 480, 1.5); ui_col(MS_MAG); ms_r(480, 58, 480, 1.5);
ms_rivet(8, 8); ms_rivet(952, 8); ms_rivet(8, 380); ms_rivet(952, 380);

// ---------- header ----------
ui_col(MS_CYN); gfx_circle(48 * sc, 30 * sc, 16 * sc, 1, 1);
gfx_setfont(13); ui_col(MS_FACE); ui_keytext(48 * sc, 30 * sc, "GFX");
gfx_setfont(15); ui_col(MS_INK); ms_tl(76, 12, "MID / SIDE"); gfx_measurestr("MID / SIDE", ms_tw, ms_th); ver_tag("v2", 16, 1.1, -0.22);
ms_x = 88 + ms_tw / sc;
ui_col(MS_CYN); ms_r(ms_x, 20, 8, 8); ui_col(MS_MAG); ms_r(ms_x + 11, 20, 8, 8);
gfx_setfont(13); ui_col(MS_DIM); ms_tl(ms_x, 33, "M/S MATRIX  ·  WIDTH");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ms_k = pk_preset(452 * sc, 14 * sc, 390 * sc, 30 * sc, pr_cur, "Subtle Widen|Wide Master|Mono Bass|Vocal Focus|Super Wide|Narrow & Tight|M/S Decode|M/S Encode");
ms_k > 0 ? ( prs_dirty = ms_k; pr_cur = ms_k > 8 ? 0 : ms_k; );
// no preset in use (new instance, or after Reset all): the LCD reads Init (laid out as pk_preset lays it out)
pr_cur < 1 || pr_cur > 8 ? (
  ms_ph = 30 * sc; ms_lx = 452 * sc + floor(max(ms_ph * 1.65, 64 * sc)) + 2 * floor(ms_ph * 0.7) + 12 * sc; ms_lw = 842 * sc - ms_lx;
  pk_lcd(ms_lx, 14 * sc, ms_lw, ms_ph, 0); ui_col(pk_lcdc);
  pk_lcdfont(9, max(9, ms_ph * 0.58)); gfx_measurestr("Init", ms_tw, ms_th);
  pk_fitstr("Init", ms_lx + 8 * sc, 14 * sc + (ms_ph - ms_th) * 0.5, max(9, ms_ph * 0.58), ms_lw - 14 * sc);
);
ui_size_picker(864 * sc, 20 * sc);

// ---------- ROUTING ----------
ms_sec(24, 214, "ROUTING");
gfx_setfont(13); ui_col(MS_DIM); ms_tl(42, 114, "LISTEN");
ms_kfont = 13; ms_key(42,  130, 56, 28, slider1 == 0, MS_WRM, "STEREO") ? ( slider1 = 0; ui_auto(1); );
ms_kfont = 13; ms_key(103, 130, 56, 28, slider1 == 1, MS_CYN, "MID")    ? ( slider1 = 1; ui_auto(1); );
ms_kfont = 13; ms_key(164, 130, 56, 28, slider1 == 2, MS_MAG, "SIDE")   ? ( slider1 = 2; ui_auto(1); );
gfx_setfont(13); ui_col(MS_DIM); ms_tl(42, 170, "INPUT");
ms_key(42,  186, 86, 28, slider8 < 0.5,  MS_WRM, "L / R") ? ( slider8 = 0; ui_auto(8); );
ms_key(136, 186, 84, 28, slider8 >= 0.5, MS_WRM, "M / S") ? ( slider8 = 1; ui_auto(8); );
gfx_setfont(13); ui_col(MS_DIM); ms_tl(42, 226, "OUTPUT");
ms_key(42,  242, 86, 28, slider9 < 0.5,  MS_WRM, "L / R") ? ( slider9 = 0; ui_auto(9); );
ms_key(136, 242, 84, 28, slider9 >= 0.5, MS_WRM, "M / S") ? ( slider9 = 1; ui_auto(9); );

// ---------- FIELD: vectorscope (M up, S across), WIDTH, correlation ----------
ms_sec(248, 286, "FIELD");
ms_inset(266, 108, 250, 100);
ms_cx = 330; ms_cy = 158;
ui_col(0x303338);
gfx_line((ms_cx - 40) * sc, (ms_cy + 40) * sc, (ms_cx + 40) * sc, (ms_cy - 40) * sc);
gfx_line((ms_cx - 40) * sc, (ms_cy - 40) * sc, (ms_cx + 40) * sc, (ms_cy + 40) * sc);
// the ring holds the output channels: mid / side directly when the output is M/S, else (L + R) / 2 and (L - R) / 2
ms_vk = 40 * 0.9 / max(sqrt(max(cLL, cRR)) * 2.5, 0.05);
ui_cola(MS_CYN, 0.7);
ms_i = 0;
loop(scN,
  ms_l = scL[ms_i]; ms_q = scR[ms_i];
  outfmt ? ( ms_pm = ms_l; ms_ps = ms_q; ) : ( ms_pm = 0.5 * (ms_l + ms_q); ms_ps = 0.5 * (ms_l - ms_q); );
  ms_qx = -ms_ps * 1.4142 * ms_vk; ms_qy = -ms_pm * 1.4142 * ms_vk;   // L to the upper left, R to the upper right
  abs(ms_qx) < 44 && abs(ms_qy) < 46 ? gfx_rect((ms_cx + ms_qx) * sc, (ms_cy + ms_qy) * sc, max(1, 1.5 * sc), max(1, 1.5 * sc));
  ms_i += 1;
);
gfx_a = 1;
gfx_setfont(10); ui_col(MS_CYN); ms_tc(ms_cx, 112, "M"); ui_col(MS_MAG); ms_tl(ms_cx + 44, ms_cy - 6, "S");
gfx_setfont(10); ui_col(MS_DIM); ms_tl(392, 120, "WIDTH");
sprintf(#ms_v, "%.0f %%", slider4); gfx_setfont(9); ui_col(MS_INK); ms_tl(392, 134, #ms_v);
gfx_setfont(10); ui_col(MS_DIM); ms_tl(392, 160, "CORRELATION");
ms_cr = cLL > 0.0000001 && cRR > 0.0000001 ? cLR / sqrt(cLL * cRR) : 0; ms_cr = min(max(ms_cr, -1), 1);
sprintf(#ms_v, "%+.2f", ms_cr); ui_col(MS_INK); ms_tr(504, 160, #ms_v);
ui_col(0x24262A); ms_rr(392, 176, 112, 10, 3);
ui_col(ms_cr >= 0 ? MS_CYN : 0xF04030);
abs(ms_cr) > 0.01 ? ( ms_cr >= 0 ? ms_rr(448, 178, 54 * ms_cr, 6, 3) : ms_rr(448 + 54 * ms_cr, 178, -54 * ms_cr, 6, 3); );
ui_col(MS_DIM); ms_r(447.5, 174, 1, 14);
sprintf(#ms_v, "%.0f Hz", slider5);
ms_knob(330, 248, 18, 5, 0, 300, 0, 0, MS_CAP, MS_WRM, "BASS MONO", slider5 < 20 ? "OFF" : #ms_v, 0);
sprintf(#ms_v, "%+.0f%%", slider15); ms_knob(452, 248, 18, 15, -100, 100, 0, 0, MS_CAP, MS_WRM, "BALANCE", #ms_v, 0);

// ---------- M / S ----------
ms_sec(544, 250, "M / S");
sprintf(#ms_v, "%.0f%%", slider4);    ms_knob(608, 178, 36, 4, 0, 200, 100, 0, MS_CAP, MS_WRM, "WIDTH", #ms_v, 1);
sprintf(#ms_v, "%+.1f dB", slider2);  ms_knob(694, 140, 20, 2, -12, 12, 0, 0, MS_CAP, MS_CYN, "MID", #ms_v, 0);
sprintf(#ms_v, "%+.1f dB", slider3);  ms_knob(766, 140, 20, 3, -12, 12, 0, 0, MS_CAP, MS_MAG, "SIDE", #ms_v, 0);
sprintf(#ms_v, "+%.1f dB", slider7);  ms_knob(694, 240, 20, 7, 0, 6, 0, 0, MS_CAP, MS_CYN, "FOCUS", #ms_v, 0);
sprintf(#ms_v, "+%.1f dB", slider6);  ms_knob(766, 240, 20, 6, 0, 9, 0, 0, MS_CAP, MS_MAG, "AIR", #ms_v, 0);

// ---------- OUTPUT ----------
ms_sec(804, 132, "OUTPUT");
sprintf(#ms_v, "%+.1f dB", slider14); ms_knob(840, 140, 18, 14, -24, 12, 0, 0, MS_CAP, MS_WRM, "LEVEL", #ms_v, 0);
sprintf(#ms_v, "%.0f%%", slider16);   ms_knob(900, 140, 18, 16, 0, 100, 0, 0, 0xD8B040, MS_WRM, "SAT", #ms_v, 0);
// TRIM, its GUARD LED at the upper right (click the knob, or the LED, to switch it)
ms_gd = (25.5 + 2.6 + 2.6 * 1.618) * 0.7071;
pressed && drag_id == 0 && sqr(mouse_x - (840 + ms_gd) * sc) + sqr(mouse_y - (232 - ms_gd) * sc) <= sqr(6 * sc) ? (
  slider23 = 1 - slider23; ui_auto(23); drag_id = -1;
);
sprintf(#ms_v, "%+.1f dB", slider22); ms_knob(840, 232, 18, 22, -24, 12, 0, 0, 0x60636A, MS_WRM, "TRIM", #ms_v, 0);
ui_guardclick(1600 + 22, 23, 840, 232, 25.5);

// ---------- strip: DRIFT ----------
ms_inset(24, 310, 376, 66);
dy_bg = 0x494D54;
dy_kst = 36; dy_knob(62, 343, 18, 24, 0, 100, 50, 0, MS_CAP, "", ""); ms_ptr(62, 343, 18, 24, 0, 100, 0, MS_MAG);
sprintf(#ms_v, "DRIFT  %.0f%%", slider24);
gfx_setfont(12); ui_col(dy_act ? MS_MAG : MS_INK); ms_tl(92, 328, dy_act ? #ms_v : "DRIFT");
gfx_setfont(13); ui_col(MS_DIM); ms_tl(92, 350, "WIDTH · AIR · BALANCE WANDER");

// ---------- strip: MID / SIDE output meters ----------
ms_inset(412, 310, 524, 66);
msmM.ms_ledrow(470, 326, ms_pkM, MS_CYN);
msmS.ms_ledrow(470, 348, ms_pkS, MS_MAG);
ms_pkM *= 0.85; ms_pkS *= 0.85;
gfx_setfont(13); ui_col(MS_DIM); ms_tr(456, 324, "MID"); ms_tr(456, 346, "SIDE");

pk_end();
ui_end();
