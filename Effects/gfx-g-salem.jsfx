slider66:sp_on=0<0,1,1{Off,On}>-Space
slider67:sp_size=0.6<0,1,0.001>-Space size
slider68:sp_decay=4.2<0.2,12,0.01:log>-Space decay (s)
slider69:sp_damp=0.4<0,1,0.001>-Space damping
slider70:sp_mix=0.35<0,1,0.001>-Space mix
slider71:sp_freeze=0<0,1,1{Off,On}>-Space freeze
slider72:pm_rate=0.25<0.02,8,0.001:log>-Pad motion speed (Hz)
slider73:pm_depth=0<0,1,0.001>-Pad motion amount
slider74:pm_shape=0<0,3,1{Circle,Figure 8,Lissajous,Drift}>-Pad motion shape
slider75:prs_sel=0<0,18,1{No preset,Init,Supersaw Lead,Warm Pad,Pluck,Square Bass,PWM Strings,Soft Brass,Band Sweep,Thin Pulse,Glide Lead,Additive Organ,Glass Bell,Formant Choir,Sync Sweep Lead,Fold Bass,Morph Pad,Vowel Lead,Bell Organ}>-Preset

@init
ext_noinit = 1;
pr_cur = 1;                       // preset shown on the LCD (saved with the project)
CR = 16;                          // control rate: every 16 samples

// ---------- memory map ----------
NV = 8;  VS = 64;  VOX = 0;       // voice records: VOX + v * VS
MQ = 4096;                        // MIDI queue: 4 slots per event (offset, status, data1, data2)
MQMAX = 1000;

// ---------- voice record fields ----------
F_ON = 0;   F_NOTE = 1;  F_VEL = 2;   F_AGE = 3;   F_GATE = 4;  F_SUS = 5;
F_AEN = 6;  F_AST = 7;   F_FEN = 8;   F_FST = 9;                   // amp / filter env level + stage
F_PIT = 10; F_PITT = 11; F_INC = 12;  F_PH = 13;                   // pitch (semitones), target, increment, phase
F_FADE = 14; F_PEND = 15; F_PVEL = 16; F_STEAL = 17;               // steal fade gain, pending note
F_AV = 18;  F_AS = 19;                                             // amp value + per-sample step (ramp)
F_G = 20;   F_GS = 21;  F_K = 22;  F_KS = 23;                      // filter g, k + steps (ramp)
F_IC1 = 24; F_IC2 = 25;
F_DV = 26;  F_DT = 27;  F_DTM = 28;  F_NDT = 29;                   // drift: value, target, timer, per-note offset
F_GAIN = 30;
F_IC1R = 31; F_IC2R = 32;                                          // the right channel's filter state
U_MEM = 1024;                       // unison: U_MEM + v * 32 + u * 4 (phase, increment, gain L, gain R)
F_ENG = 33;                                                        // the note's engine (latched at note-on)
F_NACT = 34; F_RMP = 35;                                           // ADD: partials still audible; amplitudes ramping
F_STR = 36;  F_LVL = 37;  F_TK = 38;                               // ADD: stretched (phasor) path; table level; tick count
F_WP = 39;  F_WPS = 40;                                            // WT: frame position + per-sample step (ramp)
// fields 33 - 40 are Source A's; Source B's are the same + 8 (41 - 48)
F_CAB = 49;  F_CAA = 50;  F_CBB = 51;  F_COR = 52;                 // A / B: running products, correlation
F_MGA = 53;  F_MGAS = 54;  F_MGB = 55;  F_MGBS = 56;               // A / B gains + per-sample steps (ramp)
U_MEMB = 1280;                      // Source B's unison phases (same layout as U_MEM; only the phase is used)
SN = 1600;                          // the pad's 8 snapshots x 16 morph values (saved with the project)
MPX = 1730;                         // the slider each morph value belongs to
EP = 1750;                          // the morph values in use (the pad's blend, or the knobs)
WTS = 1770;                         // each snapshot's weight (also shown on the pad)
UT = 1900;                          // unison: detune ratios [0..6], pans left [8..14], right [16..22]
RVM = 1960;                         // reverb read wander phases [0..7]
SRC = 1800;                         // per source (+ 32 for B): its live parameters and table state
SQ_SHP = 1;  SQ_TLT = 2;  SQ_EVN = 3;  SQ_STR = 4;  SQ_BNK = 5;  SQ_FRM = 6;  SQ_SWP = 7;  SQ_WOB = 8;  SQ_RAT = 9;
SQ_BKC = 10;  SQ_BKX = 11;  SQ_BKT = 12;  SQ_BKE = 13;  SQ_BKI = 14;            // ADD tables: current bank, crossfade, baked tilt / even, ready
SQ_WTC = 15;  SQ_WTX = 16;  SQ_WTB = 17;  SQ_WTJ = 18;  SQ_WJB = 19;  SQ_WTI = 20;  // WT: current, crossfade, baked bank, job frame, job bank, ready
SQ_TB = 21;  SQ_WT = 22;  SQ_AM = 23;  SQ_UP = 24;                               // memory bases: ADD tables, WT tables, ADD phasors, unison phases
// morph values: 0 A shape, 1 A tilt, 2 A even, 3 A frame, 4 B shape, 5 B tilt, 6 B even, 7 B frame,
// 8 A / B mix, 9 cutoff (blended in octaves), 10 reso, 11 filter env, 12 filter mode, 13 detune, 14 PWM, 15 width
MPX[0] = 1;  MPX[1] = 27;  MPX[2] = 28;  MPX[3] = 31;  MPX[4] = 35;  MPX[5] = 36;  MPX[6] = 37;  MPX[7] = 40;
MPX[8] = 46;  MPX[9] = 4;  MPX[10] = 5;  MPX[11] = 6;  MPX[12] = 8;  MPX[13] = 23;  MPX[14] = 2;  MPX[15] = 24;
AT = 8200;                          // ADD: the partial amplitude table (65 slots, scratch)
ADD_MEM = 16384;                    // ADD (stretched): ADD_MEM + v * 384 + 6 * k (re, im, cos, sin, amp, amp step)
TB = 32768;                         // ADD (harmonic): 2 banks x 8 levels x 2048-sample tables, shared by all voices
FFTB = 65536;                       // inverse-FFT scratch (4096 slots; must not cross a 65536 boundary)
SPEC = 69632;                       // WT: one frame's spectrum (4096 slots)
WT_MEM = 131072;                    // WT: 2 banks x (8 frames x 8 levels) x 2048: WT_MEM + bank * 131072 + (fr * 8 + lv) * 2048
WT_MEM_B = 393216;                  // Source B's WT banks (same layout)
TB_B = 655360;                      // Source B's ADD tables (same layout as TB)
ADD_MEM_B = ADD_MEM + 3072;         // Source B's ADD phasors (same layout as ADD_MEM)

memset(VOX, 0, NV * VS);
memset(U_MEM, 0, NV * 32);  memset(U_MEMB, 0, NV * 32);
memset(ADD_MEM, 0, 2 * NV * 384);
memset(SRC, 0, 64);
SRC[SQ_TB] = TB;          SRC[SQ_WT] = WT_MEM;           SRC[SQ_AM] = ADD_MEM;          SRC[SQ_UP] = U_MEM;
SRC[32 + SQ_TB] = TB_B;   SRC[32 + SQ_WT] = WT_MEM_B;   SRC[32 + SQ_AM] = ADD_MEM_B;   SRC[32 + SQ_UP] = U_MEMB;
SRC[SQ_RAT] = 1;  SRC[32 + SQ_RAT] = 1;
src_ok = 0;  ut_u = 0;
ed_on = 1;                // GUI: EDIT lit (the selected snapshot follows the knobs)

// ---------- FX memory: the reverb lines, then the delay lines (sized for the running rate) ----------
FX_MEM = 1048576;
bv_alloc(FX_MEM);
bd_alloc(BV_END);
dl_g = 0;  sp_g = 0;  dv_g = 0;
dvL.clp_pf_cfg(0.45 * srate, 9000, -1.5, 150);  dvR.clp_pf_cfg(0.45 * srate, 9000, -1.5, 150);
dvL.clp_pf_reset();  dvR.clp_pf_reset();  dvL.clp_reset();  dvR.clp_reset();
dwL.drift_init(0.8 + rand(0.4));  dwR.drift_init(0.8 + rand(0.4));      // delay time wander, each side its own
pmx.drift_init(1);  pmy.drift_init(1);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();                 // house output stage (CLIP)                                  // pad motion: DRIFT shape
k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );                           // reverb read wander phases

// ---------- helpers ----------
function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function blep(t, dt) (
  t < dt ? ( t /= dt;  2 * t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt;  t * t + 2 * t + 1; ) : 0;
);
// falling saw (sine-phase fundamental, same polarity as the square) and DC-free pulse
function va_saw(ph, dt) ( 1 - 2 * ph + blep(ph, dt); );
function va_pulse(ph, dt, pw) local(p2) (
  p2 = ph - pw;  p2 += p2 < 0;
  (ph < pw ? 1 : -1) + blep(ph, dt) - blep(p2, dt) - (2 * pw - 1);
);
// SHAPE 0..0.5: saw -> square; 0.5..1: the pulse narrows to 5 %. PWM rides on top.
function va_shape(ph, dt, shp, pmod) local(pw, s, p) (
  pw = shp < 0.5 ? 0.5 : 0.5 - (shp - 0.5) * 0.9;
  pw = max(0.05, min(0.95, pw + pmod));
  shp < 0.0005 ? va_saw(ph, dt) :                                 // pure saw: no pulse to blend
  shp < 0.4995 ? (
    s = va_saw(ph, dt);  p = va_pulse(ph, dt, pw);
    s + (p - s) * shp * 2;
  ) : va_pulse(ph, dt, pw);
);
function env_coef(ms) ( exp(-4.6 * CR / max(1, ms * 0.001 * srate)); );   // one tick of a ~ms fall to 1 %

// ---------- unison: per voice, the increments and the equal-power pan of up to 7 copies ----------
// offsets spread on -1..1, curved (o * sqrt|o|) so the outer copies detune most; level 1 / sqrt(U)
function v_unison(b, dt0) local(u, p) (
  p = U_MEM + (b - VOX) / VS * 32;  u = 0;
  loop(uni, p[1] = min(dt0 * UT[u], 0.45);  p[2] = UT[8 + u];  p[3] = UT[16 + u];  p += 4;  u += 1; );
);

// ---------- ADD engine: per tick, the phasor rotations and amplitude ramps for one voice ----------
// k-th phasor of unison copy u = partial h (1..n) at w_h = w * h * sqrt(1 + B h^2); n = 64 / UNISON.
function add_tick(b, s) local(sp, q, p, h, n, a, sum, nrm, w, wh, c1, s1, c, sn_, t, bb, f, fade, na, rm, tg, rt, tl, ev) (
  sp = SRC + s * 32;  rt = sp[SQ_RAT];  tl = sp[SQ_TLT];  ev = sp[SQ_EVN];
  q = sp[SQ_AM] + (b - VOX) / VS * 384;  p = U_MEM + (b - VOX) / VS * 32;  n = add_n;
  bb = 0.002 * sqr(sp[SQ_STR]);
  sum = 0;  h = 1;
  loop(n, a = h ^ (-tl) * (h % 2 == 0 ? ev : 1);  AT[h] = a;  sum += a * a;  h += 1; );
  nrm = 0.85 / sqrt(sum + 0.000000001);                            // TILT / EVEN keep roughly the same loudness
  na = 0;  rm = 0;
  loop(uni,
    w = 2 * $pi * min(p[1] * rt, 0.45);  c1 = cos(w);  s1 = sin(w);  c = c1;  sn_ = s1;  h = 1;
    loop(n,
      bb > 0 ? ( wh = w * h * sqrt(1 + bb * h * h);  q[2] = cos(wh);  q[3] = sin(wh); )
             : ( wh = w * h;  q[2] = c;  q[3] = sn_;  t = c * c1 - sn_ * s1;  sn_ = sn_ * c1 + c * s1;  c = t; );
      f = wh / (2 * $pi);
      fade = f < 0.40 ? 1 : f > 0.45 ? 0 : (0.45 - f) * 20;        // fade out near Nyquist: no aliasing, no pops
      tg = AT[h] * nrm * fade;
      q[5] = (tg - q[4]) / CR;                                      // ramp to the new amplitude across the tick
      abs(q[5]) > 0.0000001 ? rm = 1;
      (tg > 0 || q[4] > 0.0000001) && h > na ? na = h;              // the highest partial still sounding
      t = 1.5 - 0.5 * (q[0] * q[0] + q[1] * q[1]);  q[0] *= t;  q[1] *= t;   // keep |phasor| = 1
      q += 6;  h += 1;
    );
    p += 4;
  );
  b[F_NACT + s * 8] = na;  b[F_RMP + s * 8] = rm;
);
// ---------- ADD (harmonic): bake the spectrum into band-limited tables, shared by every voice ----------
// level L holds partials 1 .. 128 / 2^L, so a voice reads the richest level with nothing above Nyquist.
// One scale for all levels (from the level-0 RMS): changing level never changes the loudness.
function add_bake(bank, s) local(sp, lv, hm, h, i, base, a, sum, sc, tl, ev) (
  sp = SRC + s * 32;  tl = sp[SQ_TLT];  ev = sp[SQ_EVN];
  sum = 0;  h = 1;
  loop(128, a = h ^ (-tl) * (h % 2 == 0 ? ev : 1);  sum += a * a;  h += 1; );
  sc = 0.6 / sqrt(2 * sum + 0.000000001);                          // ~ the RMS of a saw, whatever the TILT
  lv = 0;
  loop(8,
    hm = 128 / (2 ^ lv);
    memset(FFTB, 0, 4096);
    h = 1;
    loop(hm,
      a = h ^ (-tl) * (h % 2 == 0 ? ev : 1);
      FFTB[2 * h + 1] = -a;  FFTB[2 * (2048 - h) + 1] = a;          // sine phase (same as the VA and the phasors)
      h += 1;
    );
    fft_ipermute(FFTB, 2048);
    ifft(FFTB, 2048);
    base = sp[SQ_TB] + bank * 16384 + lv * 2048;  i = 0;
    loop(2048, base[i] = FFTB[2 * i] * sc;  i += 1; );
    lv += 1;
  );
  sp[SQ_BKT] = tl;  sp[SQ_BKE] = ev;
);
// the table level for an increment: the richest level whose top partial stays under 0.45 x srate
function add_level(inc) local(hn, lv) (
  hn = floor(0.45 / max(inc * 1.03, 0.0000001));                   // 1.03: room for the widest unison detune
  lv = 0;  loop(7, 128 / (2 ^ lv) > hn ? lv += 1; );
  lv;
);

// between rebuilds the amplitudes hold (ramps were sized for one tick)
function add_zero_ramp(b, s) local(q) ( q = SRC[s * 32 + SQ_AM] + (b - VOX) / VS * 384 + 5;  loop(add_n * uni, q[0] = 0;  q += 6; ); );

// ---------- WT: the frame generators (no samples) ----------
// Spectral banks write the sine-phase spectrum into SPEC; time-domain banks draw one cycle into FFTB
// and are FFT'd into SPEC. Saw / square shapes fall at the start, so every bank shares the
// sine-phase polarity of the VA and ADD engines (frames morph without cancelling).
function wt_amp_set(h, a) ( SPEC[2 * h + 1] = -a;  SPEC[2 * (2048 - h) + 1] = a; );
function wt_gauss(h, c, w) ( exp(-sqr((h - c) / w)); );
function wt_vowel(v, i) (                                          // formant centres (harmonic numbers) of 5 vowels
  i == 0 ? ( v == 0 ? 5.6 : v == 1 ? 4.1 : v == 2 ? 2.1 : v == 3 ? 4.4 : 2.3; ) :
  i == 1 ? ( v == 0 ? 8.4 : v == 1 ? 14.2 : v == 2 ? 17.6 : v == 3 ? 6.5 : 6.7; ) :
           ( v == 0 ? 18.8 : v == 1 ? 19 : v == 2 ? 23 : v == 3 ? 18.5 : 17.2; );
);
function wt_fill(bank, k) local(h, i, t, y, a, v0, v1, vt, c, g, x, lev) (
  memset(SPEC, 0, 4096);
  bank == 1 ? (
    // Formant: A > E > I > O > U across the frames, on a soft saw
    vt = k * 4 / 7;  v0 = floor(vt);  v1 = min(v0 + 1, 4);  vt -= v0;
    h = 1;
    loop(160,
      a = 0;  i = 0;
      loop(3, c = wt_vowel(v0, i) + (wt_vowel(v1, i) - wt_vowel(v0, i)) * vt;  a += (i == 0 ? 1 : i == 1 ? 0.7 : 0.35) * wt_gauss(h, c, 0.8 + c * 0.12);  i += 1; );
      wt_amp_set(h, h ^ -0.7 * (0.04 + a));  h += 1;
    );
  ) : bank == 2 ? (
    // Organ: drawbar registrations (16', 8', 5 1/3', 4', 2 2/3', 2', 1 3/5', 1 1/3', 1' -> harmonics)
    i = 0;
    loop(9,
      h = i == 0 ? 1 : i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 8 : i == 6 ? 10 : i == 7 ? 12 : 16;
      g = k == 0 ? ( i == 0 ) : k == 1 ? ( i <= 1 ) : k == 2 ? ( i <= 2 ) : k == 3 ? ( i <= 3 ? 1 : 0.4 ) :
          k == 4 ? ( i == 0 || i == 2 || i == 4 ) : k == 5 ? ( i == 0 || i == 1 || i == 3 || i == 5 ) :
          k == 6 ? ( i == 0 ? 1 : i >= 4 ) : 1;
      g > 0 ? wt_amp_set(h, g / (1 + i * 0.15));
      i += 1;
    );
  ) : bank == 7 ? (
    // Sweep: a saw with a resonant peak moving from the 2nd to the 40th partial
    c = log(2 * 20 ^ (k / 7)) / log(2);
    h = 1;  loop(400, wt_amp_set(h, (1 / h) * (1 + 8 * exp(-sqr((log(h) / log(2) - c) / 0.25))));  h += 1; );
  ) : (
    // time-domain banks: draw one cycle, then FFT it into SPEC
    i = 0;
    loop(2048,
      t = i / 2048;
      bank == 0 ? (
        // Classic: sine, triangle, tri-saw, saw, square, pulses 30 / 15 / 7 %
        y = sin(2 * $pi * t);
        k == 1 ? y = (t < 0.25 ? 4 * t : t < 0.75 ? 2 - 4 * t : 4 * t - 4);
        k == 2 ? y = 0.5 * (t < 0.25 ? 4 * t : t < 0.75 ? 2 - 4 * t : 4 * t - 4) + 0.5 * (1 - 2 * t);
        k == 3 ? y = 1 - 2 * t;
        k >= 4 ? ( x = k == 4 ? 0.5 : k == 5 ? 0.3 : k == 6 ? 0.15 : 0.07;  y = t < x ? 1 : -1; );
      ) : bank == 3 ? (
        // Digital: a stepped sine (32 > 3 levels), then a stepped saw (16 > 2 levels)
        lev = k == 0 ? 32 : k == 1 ? 12 : k == 2 ? 6 : k == 3 ? 3 : k == 4 ? 16 : k == 5 ? 8 : k == 6 ? 4 : 2;
        y = k < 4 ? sin(2 * $pi * t) : 1 - 2 * t;
        y = floor(y * lev * 0.5 + 0.5) / (lev * 0.5);
      ) : bank == 4 ? (
        // Fold: a sine through a wavefolder, driven harder frame by frame
        x = sin(2 * $pi * t) * (1 + k * 1.1);
        y = 4 * abs((x + 1) / 4 - floor((x + 1) / 4 + 0.5)) - 1;
        y = -y;
      ) : bank == 5 ? (
        // Sync: a saw hard-synced at 1 > 5.2 times the cycle
        x = t * (1 + k * 0.6);  y = 1 - 2 * (x - floor(x));
      ) : (
        // PWM: pulse width 50 % > 3 %
        x = 0.5 - k * 0.067;  y = t < x ? 1 : -1;
      );
      FFTB[2 * i] = y;  FFTB[2 * i + 1] = 0;
      i += 1;
    );
    fft(FFTB, 2048);  fft_permute(FFTB, 2048);
    memcpy(SPEC, FFTB, 4096);
  );
  SPEC[0] = 0;  SPEC[1] = 0;                                       // no DC
);
// bake frame k of a bank into its 8 levels (partials 1 .. 1024 / 2^level), one RMS scale for all levels
function wt_bake_frame(bank, dst, k, s) local(lv, hm, i, base, sum, sc) (
  wt_fill(bank, k);
  lv = 0;
  loop(8,
    hm = 1024 / (2 ^ lv);
    memcpy(FFTB, SPEC, 4096);
    i = hm + 1;  loop(2047 - hm, FFTB[2 * i] = 0;  FFTB[2 * i + 1] = 0;  i += 1; );     // bins above hm (and their mirrors below)
    i = 2048 - hm;  loop(hm, FFTB[2 * i] = SPEC[2 * i];  FFTB[2 * i + 1] = SPEC[2 * i + 1];  i += 1; );
    fft_ipermute(FFTB, 2048);  ifft(FFTB, 2048);
    lv == 0 ? ( sum = 0;  i = 0;  loop(2048, sum += sqr(FFTB[2 * i]);  i += 1; );  sc = 0.55 / sqrt(sum / 2048 + 0.0000000001); );
    base = SRC[s * 32 + SQ_WT] + dst * 131072 + (k * 8 + lv) * 2048;  i = 0;
    loop(2048, base[i] = FFTB[2 * i] * sc;  i += 1; );
    lv += 1;
  );
);
// the WT level for an increment: the richest level whose top partial stays under 0.45 x srate
function wt_level(inc) local(hn, lv) (
  hn = floor(0.45 / max(inc * 1.03, 0.0000001));
  lv = 0;  loop(7, 1024 / (2 ^ lv) > hn ? lv += 1; );
  lv;
);
// WT frame position for a voice (frame knob + filter envelope sweep + LFO wobble), 0 .. 7
function wt_pos(b, s) local(sp) (
  sp = SRC + s * 32;
  max(0, min(7, sp[SQ_FRM] + sp[SQ_SWP] * 7 * b[F_FEN] + sp[SQ_WOB] * 3.5 * wob_lfo));
);

// note-on: the phasors' start phases (RESET = sine phase, the same attack; FREE = random) and silence
function add_start(b, s) local(q, ph) (
  q = SRC[s * 32 + SQ_AM] + (b - VOX) / VS * 384;
  loop(64, ph = phmode ? 0 : rand(2 * $pi);  q[0] = cos(ph);  q[1] = sin(ph);  q[4] = 0;  q[5] = 0;  q += 6; );
);

// ---------- a source's note-on and control tick (s = 0 A, 1 B; its voice fields are + s * 8) ----------
function src_start(b, s) local(sp, fo, inc) (
  sp = SRC + s * 32;  fo = s * 8;  inc = min(b[F_INC] * sp[SQ_RAT], 0.45);
  b[F_ENG + fo] = floor((s ? eng_b : eng_a) + 0.5);              // the engine is latched for the note (0 VA, 1 ADD, 2 WT)
  b[F_STR + fo] = sp[SQ_STR] > 0.001;                              // ADD: stretched (inharmonic) notes use the phasors
  b[F_TK + fo] = (b - VOX) / VS + s * 2;                           // stagger the stretched rebuilds across voices
  b[F_ENG + fo] == 2 ? ( b[F_LVL + fo] = wt_level(inc);  b[F_WP + fo] = wt_pos(b, s);  b[F_WPS + fo] = 0; );
  b[F_ENG + fo] == 1 ? b[F_LVL + fo] = add_level(inc);
  b[F_ENG + fo] == 1 && b[F_STR + fo] ? ( (!b[F_AV] || phmode) ? add_start(b, s);  add_tick(b, s); );
);
function src_tick(b, s) local(sp, fo, inc) (
  sp = SRC + s * 32;  fo = s * 8;  inc = min(b[F_INC] * sp[SQ_RAT], 0.45);
  b[F_ENG + fo] == 2 ? ( b[F_LVL + fo] = wt_level(inc);  b[F_WPS + fo] = (wt_pos(b, s) - b[F_WP + fo]) / CR; );
  b[F_ENG + fo] == 1 ? (
    b[F_STR + fo] ? ( b[F_TK + fo] += 1;  (b[F_TK + fo] & 3) == 0 ? add_tick(b, s) : b[F_RMP + fo] ? ( b[F_RMP + fo] = 0;  add_zero_ramp(b, s); ); )
                  : b[F_LVL + fo] = add_level(inc);
  );
);

// ---------- voices ----------
function v_start(b, note, vel) local(u_p, m) (
  b[F_ON] = 1;  b[F_NOTE] = note;  b[F_VEL] = vel;  b[F_GATE] = 1;  b[F_SUS] = 0;
  age_n += 1;  b[F_AGE] = age_n;
  b[F_AST] = 1;  b[F_FST] = 1;                                     // attack (levels carry on: no click)
  b[F_PITT] = note;
  (glide <= 0 || last_note < 0) ? b[F_PIT] = note : b[F_PIT] = last_note;
  last_note = note;
  b[F_NDT] = (rand(2) - 1) * 0.06 * drift / 100;                  // per-note offset, up to +/-6 cents
  b[F_GAIN] = 1 - vsens + vsens * vel / 127;
  b[F_FADE] = 1;  b[F_STEAL] = 0;  b[F_AS] = 0;  b[F_GS] = 0;  b[F_KS] = 0;
  b[F_INC] = min(440 * 2 ^ ((b[F_PIT] - 69) / 12) / srate, 0.45);  // sound at once, before the next tick
  !b[F_AV] ? ( b[F_IC1] = 0;  b[F_IC2] = 0;  b[F_IC1R] = 0;  b[F_IC2R] = 0; );   // a silent voice starts clean
  // unison phases: FREE = random (analogue, a little different every note); RESET = all from 0 (the same attack)
  u_p = U_MEM + (b - VOX) / VS * 32;
  loop(8, (!b[F_AV] || phmode) ? ( u_p[0] = phmode ? 0 : rand(1);  u_p[256] = phmode ? 0 : rand(1); );  u_p += 4; );   // + 256: B's phases
  v_unison(b, b[F_INC]);
  src_start(b, 0);  src_start(b, 1);
  // a silent voice starts at the A / B gains at once (no correlation history yet)
  !b[F_AV] ? (
    m = e_mix * $pi * 0.5;
    b[F_MGA] = b_on ? cos(m) : 1;  b[F_MGB] = b_on ? sin(m) : 0;  b[F_MGAS] = 0;  b[F_MGBS] = 0;
    b[F_CAB] = 0;  b[F_CAA] = 0;  b[F_CBB] = 0;  b[F_COR] = 0;
  );
);
// a free voice; else the quietest releasing; else the oldest held. A busy voice fades 3 ms first.
function v_alloc(note, vel) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? b[F_AEN] : 2 + b[F_AGE];
    b[F_ON] && b[F_NOTE] == note && !b[F_STEAL] ? q = -2;          // same note again: reuse its voice
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  b = VOX + best * VS;
  (b[F_ON] && b[F_AV] > 0.0005 && b[F_NOTE] != note) ? (
    b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel;
  ) : v_start(b, note, vel);
);
function v_release(note) local(v, b) (
  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_NOTE] == note ? (
      sustain ? b[F_SUS] = 1;
      b[F_GATE] = 0;  b[F_AST] = 4;  b[F_FST] = 4;
    );
    b[F_STEAL] && b[F_PEND] == note ? b[F_PEND] = -1;              // released before it started
    v += 1;
  );
);
function v_pedal_up() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_SUS] = 0;  v += 1; );
);
function v_all_off() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_ON] ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_AST] = 4;  b[F_FST] = 4; );  v += 1; );
);
function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? v_alloc(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? v_release(d1) :
  st == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * bend_st :
  st == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);

// ---------- envelope tick (stage: 1 attack, 2 decay / sustain, 4 release, 0 done) ----------
function env_tick(lv, stg, a_inc, d_c, s_lv, r_c) (
  stg == 1 ? ( lv += a_inc;  lv >= 1 ? ( lv = 1;  stg = 2; ); ) :
  stg == 2 ? ( lv = s_lv + (lv - s_lv) * d_c; ) :
  stg == 4 ? ( lv *= r_c; );
  env_out_stg = stg;
  lv;
);

// ---------- control tick for one voice ----------
function v_tick(b) local(p, f, fc, g, k, a, t, m, ga, gb, r, cl) (
  // a held pedal keeps a released note sounding at sustain
  b[F_SUS] && !b[F_GATE] && b[F_AST] == 4 ? ( b[F_AST] = 2;  b[F_FST] = 2; );
  !b[F_SUS] && !b[F_GATE] && b[F_AST] != 4 ? ( b[F_AST] = 4;  b[F_FST] = 4; );
  // envelopes
  b[F_AEN] = env_tick(b[F_AEN], b[F_AST], a_ainc, a_dc, a_sl, a_rc);  b[F_AST] = env_out_stg;
  b[F_FEN] = env_tick(b[F_FEN], b[F_FST], f_ainc, f_dc, f_sl, f_rc);  b[F_FST] = env_out_stg;
  // drift: each voice's own slow wander (a new target every 1.5 - 4 s, smoothed)
  b[F_DTM] -= CR / srate;
  b[F_DTM] <= 0 ? ( b[F_DT] = rand(2) - 1;  b[F_DTM] = 1.5 + rand(2.5); );
  b[F_DV] += (b[F_DT] - b[F_DV]) * dr_c;
  // pitch: glide in semitones, then one 2 ^ per tick
  b[F_PIT] += (b[F_PITT] - b[F_PIT]) * gl_c;
  p = b[F_PIT] + bend + b[F_NDT] + b[F_DV] * 0.15 * drift / 100;   // wander up to +/-15 cents
  f = 440 * 2 ^ ((p - 69) / 12);
  b[F_INC] = min(f / srate, 0.45);
  v_unison(b, b[F_INC]);
  // A / B mix: equal-power when the sources are unrelated, linear as they become alike (correlation-aware),
  // so the level holds steady across the whole fade. A source at zero gain isn't run at all.
  b_on ? (
    r = b[F_CAA] * b[F_CBB] > 0.000000000001 ? b[F_CAB] / sqrt(b[F_CAA] * b[F_CBB]) : 0;
    b[F_COR] += (max(0, min(1, r)) - b[F_COR]) * 0.1;
    b[F_CAB] *= 0.95;  b[F_CAA] *= 0.95;  b[F_CBB] *= 0.95;           // ~ a 20 ms window
    m = e_mix;  cl = b[F_COR];
    ga = cos(m * $pi * 0.5);  gb = sin(m * $pi * 0.5);
    ga += (1 - m - ga) * cl;  gb += (m - gb) * cl;
    m < 0.001 ? gb = 0;  m > 0.999 ? ga = 0;
  ) : ( ga = 1;  gb = 0; );
  abs(ga - b[F_MGA]) < 0.000001 ? b[F_MGA] = ga;  abs(gb - b[F_MGB]) < 0.000001 ? b[F_MGB] = gb;   // land exactly (0 = not run)
  b[F_MGAS] = (ga - b[F_MGA]) / CR;  b[F_MGBS] = (gb - b[F_MGB]) / CR;
  (ga > 0 || b[F_MGA] > 0) ? src_tick(b, 0);
  (gb > 0 || b[F_MGB] > 0) ? src_tick(b, 1);
  // filter: cutoff in octaves from the knob (or pad), envelope and key tracking
  fc = exp(fl_c2 + (b[F_FEN] * fl_ev + (b[F_NOTE] - 60) / 12 * ktrk) * 0.693147);
  fc = max(20, min(fc, 0.45 * srate));
  g = tan($pi * fc / srate);  k = 2 - 1.98 * fl_rs;
  b[F_GS] = (g - b[F_G]) / CR;  b[F_KS] = (k - b[F_K]) / CR;
  // amp: ramp to the new level across the tick
  a = b[F_AEN] * b[F_GAIN];
  b[F_AS] = (a - b[F_AV]) / CR;
  // finished: released and silent
  b[F_AST] == 4 && b[F_AEN] < 0.0001 && b[F_AV] < 0.0001 && !b[F_STEAL] ? (
    b[F_ON] = 0;  b[F_AEN] = 0;  b[F_FEN] = 0;  b[F_AV] = 0;  b[F_AS] = 0;
  );
);

// ---------- one source of one voice, one sample: its unison copies, panned, into src_l / src_r ----------
function src_run(b, s) local(sp, fo, p, r, rt, q, qq, na, ph, dt, x, xl, xr, m, w, re, im, a1, v1, v2, cur, xf, sh, en) (
  sp = SRC + s * 32;  fo = s * 8;  rt = sp[SQ_RAT];  en = b[F_ENG + fo];
  p = U_MEM + (b - VOX) / VS * 32;  r = sp[SQ_UP] + (b - VOX) / VS * 32;  xl = 0;  xr = 0;
  en == 2 ? (
    // WT: neighbouring frames read at the same phase and blended by the frame position (crossfading banks while one bakes)
    m = b[F_WP + fo];  b[F_WP + fo] += b[F_WPS + fo];  w = min(floor(m), 6);  m -= w;
    cur = sp[SQ_WTC];  xf = sp[SQ_WTX];
    q = sp[SQ_WT] + cur * 131072 + (w * 8 + b[F_LVL + fo]) * 2048;  qq = q + 16384;
    loop(uni,
      dt = s ? min(p[1] * rt, 0.45) : p[1];
      ph = r[0] + dt;  ph -= floor(ph);  r[0] = ph;
      re = ph * 2048;  na = floor(re);  re -= na;  dt = (na + 1) & 2047;
      x = q[na] + (q[dt] - q[na]) * re;  im = qq[na] + (qq[dt] - qq[na]) * re;
      x += (im - x) * m;
      xf > 0 ? (
        a1 = q + (cur ? -131072 : 131072);  v1 = a1 + 16384;
        im = a1[na] + (a1[dt] - a1[na]) * re;  v2 = v1[na] + (v1[dt] - v1[na]) * re;
        im += (v2 - im) * m;  x += (im - x) * xf;
      );
      xl += x * p[2];  xr += x * p[3];
      p += 4;  r += 4;
    );
  ) : en == 1 && !b[F_STR + fo] ? (
    // ADD (harmonic): every unison copy reads the shared band-limited table (crossfading while it re-bakes)
    cur = sp[SQ_BKC];  xf = sp[SQ_BKX];
    q = sp[SQ_TB] + cur * 16384 + b[F_LVL + fo] * 2048;  qq = sp[SQ_TB] + (1 - cur) * 16384 + b[F_LVL + fo] * 2048;
    loop(uni,
      dt = s ? min(p[1] * rt, 0.45) : p[1];
      ph = r[0] + dt;  ph -= floor(ph);  r[0] = ph;
      m = ph * 2048;  na = floor(m);  m -= na;
      x = q[na] + (q[(na + 1) & 2047] - q[na]) * m;
      xf > 0 ? ( re = qq[na] + (qq[(na + 1) & 2047] - qq[na]) * m;  x += (re - x) * xf; );
      xl += x * p[2];  xr += x * p[3];
      p += 4;  r += 4;
    );
  ) : en == 1 ? (
    // ADD (stretched): each unison copy's partial stack (rotating phasors, sine phase), panned
    q = sp[SQ_AM] + (b - VOX) / VS * 384;  na = b[F_NACT + fo];
    loop(uni,
      x = 0;  qq = q;
      b[F_RMP + fo] ? (
        loop(na,
          re = qq[0] * qq[2] - qq[1] * qq[3];  im = qq[0] * qq[3] + qq[1] * qq[2];
          qq[0] = re;  qq[1] = im;  qq[4] += qq[5];  x += qq[4] * im;
          qq += 6;
        );
      ) : (
        loop(na,
          re = qq[0] * qq[2] - qq[1] * qq[3];  im = qq[0] * qq[3] + qq[1] * qq[2];
          qq[0] = re;  qq[1] = im;  x += qq[4] * im;
          qq += 6;
        );
      );
      xl += x * p[2];  xr += x * p[3];
      p += 4;  q += add_n * 6;
    );
  ) : (
    // VA: unison copies, each on its own phase, panned
    sh = sp[SQ_SHP];
    loop(uni,
      dt = s ? min(p[1] * rt, 0.45) : p[1];
      ph = r[0] + dt;  ph -= floor(ph);  r[0] = ph;
      x = va_shape(ph, dt, sh, pmod);
      xl += x * p[2];  xr += x * p[3];
      p += 4;  r += 4;
    );
  );
  src_l = xl;  src_r = xr;
);

// ---------- one voice, one sample: A and B, mixed, filtered, into mixL / mixR ----------
function v_run(b) local(xl, xr, al, ar, bl, br, ga, gb, g, k, a1, v1, v2, v3, yl, yr, m, w, u, c) (
  b[F_MGA] += b[F_MGAS];  b[F_MGB] += b[F_MGBS];
  ga = max(0, b[F_MGA]);  gb = max(0, b[F_MGB]);
  ga > 0 || b[F_MGAS] > 0 ? ( src_run(b, 0);  al = src_l;  ar = src_r; ) : ( al = 0;  ar = 0; );
  b_on && (gb > 0 || b[F_MGBS] > 0) ? (
    src_run(b, 1);  bl = src_l;  br = src_r;
    u = al + ar;  c = bl + br;                                      // how alike are A and B (for the mix law)
    b[F_CAB] += u * c;  b[F_CAA] += u * u;  b[F_CBB] += c * c;
  ) : ( bl = 0;  br = 0; );
  xl = al * ga + bl * gb;  xr = ar * ga + br * gb;
  // SVF per side (ramped coefficients, shared)
  b[F_G] += b[F_GS];  b[F_K] += b[F_KS];
  g = b[F_G];  k = b[F_K];  m = e_fmode;
  a1 = 1 / (1 + g * (g + k));
  v3 = xl - b[F_IC2];  v1 = a1 * b[F_IC1] + g * a1 * v3;  v2 = b[F_IC2] + g * v1;
  b[F_IC1] = 2 * v1 - b[F_IC1];  b[F_IC2] = 2 * v2 - b[F_IC2];
  yl = m < 0.5 ? v2 + (v1 * 1.4 - v2) * m * 2 : v1 * 1.4 + ((xl - k * v1 - v2) - v1 * 1.4) * (m - 0.5) * 2;
  uni == 1 ? ( yr = yl;  b[F_IC1R] = b[F_IC1];  b[F_IC2R] = b[F_IC2]; ) : (     // one copy: centred, so both sides are the same
    v3 = xr - b[F_IC2R];  v1 = a1 * b[F_IC1R] + g * a1 * v3;  v2 = b[F_IC2R] + g * v1;
    b[F_IC1R] = 2 * v1 - b[F_IC1R];  b[F_IC2R] = 2 * v2 - b[F_IC2R];
    yr = m < 0.5 ? v2 + (v1 * 1.4 - v2) * m * 2 : v1 * 1.4 + ((xr - k * v1 - v2) - v1 * 1.4) * (m - 0.5) * 2;
  );
  // amp ramp, steal fade
  b[F_AV] += b[F_AS];
  w = b[F_AV] * b[F_FADE];
  mixL += yl * w;  mixR += yr * w;
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? (
      b[F_FADE] = 0;  b[F_STEAL] = 0;
      b[F_PEND] >= 0 ? ( b[F_AV] = 0;  b[F_AEN] = 0;  b[F_FEN] = 0;  v_start(b, b[F_PEND], b[F_PVEL]); )
                     : ( b[F_ON] = 0;  b[F_AV] = 0;  b[F_AEN] = 0; );
    );
  );
);

last_note = -1;  bend = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  fl_ok = 0;

// ---------- the pad: blend the 8 snapshots by inverse distance (SNAP sets how sharply each one pulls) ----------
// cells sit on a 4 x 2 grid; the puck glides (SLEW). Pad OUT: the knobs are used as they are.
function ctl_update() local(c, j, w, ws, dx, dy, d2, pw, v, sp, cd, o, a, nrm) (
  pad_on || ctl_dirty ? (
  cd = ctl_dirty;  ctl_dirty = 0;
  pad_on ? (
    // MOTION: the XY LFO around the puck (held while a cell is being edited)
    pm_ph += pm_rate * CR / srate;  pm_ph -= floor(pm_ph);
    pm_shape < 0.5 ? ( pm_dx = cos(2 * $pi * pm_ph);  pm_dy = sin(2 * $pi * pm_ph); ) :
    pm_shape < 1.5 ? ( pm_dx = sin(2 * $pi * pm_ph);  pm_dy = sin(4 * $pi * pm_ph); ) :
    pm_shape < 2.5 ? ( pm_ph2 += 1.5 * pm_rate * CR / srate;  pm_ph2 -= floor(pm_ph2);  pm_dx = sin(2 * $pi * pm_ph);  pm_dy = sin(2 * $pi * pm_ph2); ) :
                     ( pm_dx = pmx.drift_tick(pm_rate * CR / srate);  pm_dy = pmy.drift_tick(pm_rate * 0.83 * CR / srate); );
    pw = pm_hold_d ? 0 : pm_depth * 0.5;
    pm_x = pad_x + pm_dx * pw;  pm_x < 0 ? pm_x = -pm_x;  pm_x > 1 ? pm_x = 2 - pm_x;   // bounce off the edges
    pm_y = pad_y + pm_dy * pw;  pm_y < 0 ? pm_y = -pm_y;  pm_y > 1 ? pm_y = 2 - pm_y;
    pxs += (pm_x - pxs) * pad_sc;  pys += (pm_y - pys) * pad_sc;
    // the blend is worked out again only when the puck has moved or a control / cell changed
    cd || abs(pxs - pk_lx) > 0.0000001 || abs(pys - pk_ly) > 0.0000001 ? (
    pk_lx = pxs;  pk_ly = pys;  cd = 1;
    pw = 1 + snap * 7;  ws = 0;  c = 0;
    loop(8,
      dx = (pxs - ((c % 4) + 0.5) / 4) * 1.667;  dy = pys - (floor(c / 4) + 0.5) / 2;    // the pad is 280 x 168
      d2 = dx * dx + dy * dy;
      w = d2 < 0.0000001 ? 10000000000 : d2 ^ (-0.5 * pw);
      WTS[c] = w;  ws += w;  c += 1;
    );
    j = 0;
    loop(16,
      v = 0;  c = 0;
      j == 9 ? ( loop(8, v += WTS[c] * log(max(20, SN[c * 16 + j]));  c += 1; );  EP[j] = exp(v / ws); )
             : ( loop(8, v += WTS[c] * SN[c * 16 + j];  c += 1; );  EP[j] = v / ws; );
      j += 1;
    );
    c = 0;  loop(8, WTS[c] /= ws;  c += 1; );
    );
  ) : (
    j = 0;  loop(16, EP[j] = slider(MPX[j]);  j += 1; );
    pxs = pad_x;  pys = pad_y;  cd = 1;
  );
  cd ? (
  sp = SRC;
  sp[SQ_SHP] = EP[0];  sp[SQ_TLT] = EP[1];  sp[SQ_EVN] = EP[2];  sp[SQ_FRM] = EP[3];
  sp[SQ_STR] = stretch;  sp[SQ_BNK] = floor(wt_bank + 0.5);  sp[SQ_SWP] = wt_sweep;  sp[SQ_WOB] = wt_wob;
  sp = SRC + 32;
  sp[SQ_SHP] = EP[4];  sp[SQ_TLT] = EP[5];  sp[SQ_EVN] = EP[6];  sp[SQ_FRM] = EP[7];
  sp[SQ_STR] = b_stretch;  sp[SQ_BNK] = floor(b_bank + 0.5);  sp[SQ_SWP] = b_sweep;  sp[SQ_WOB] = b_wob;
  sp[SQ_RAT] = 2 ^ ((b_tune + b_fine / 100) / 12);
  e_mix = EP[8];  e_cutoff = EP[9];  e_reso = EP[10];  e_fenv = EP[11];  e_fmode = EP[12];
  e_detune = EP[13];  e_pwm = EP[14];  e_width = EP[15];
  );
  );
  // unison: the copies' detune ratios and pans, shared by every voice (worked out only when they change)
  uni != ut_u || e_detune != ut_d || e_width != ut_w ? (
    ut_u = uni;  ut_d = e_detune;  ut_w = e_width;  nrm = 1 / sqrt(uni) * 1.4142;  c = 0;
    loop(uni,
      o = uni > 1 ? 2 * c / (uni - 1) - 1 : 0;
      o = o * sqrt(abs(o));                                        // curved: the outer copies detune most
      UT[c] = 2 ^ (o * e_detune / 1200);
      a = (o * e_width / 100 + 1) * $pi * 0.25;                    // pan angle: 0 = left, pi/2 = right
      UT[8 + c] = cos(a) * nrm;  UT[16 + c] = sin(a) * nrm;        // centre = unity on both sides
      c += 1;
    );
  );
);
// ---------- FX setup (per block) ----------
function fx_block() local(k, sz, ms, t, g) (
  // DRIVE: 0 .. 36 dB into the clipper; BIAS opens the positive side (asymmetry); TONE: a post low-pass 1.5 k .. 20 kHz
  dv_gin = 0.6 * 10 ^ (drv * 36 / 20);
  dv_gout = 1 / min(dv_gin, 1) / max(dv_gin, 1) ^ 0.65;
  dvL.clp_set(1, 1 + drv_bias * 0.8, 1 - drv_bias * 0.35, 0);  dvR.clp_set(1, 1 + drv_bias * 0.8, 1 - drv_bias * 0.35, 0);
  dvL.clp_pf_block(drv, srate, samplesblock);  dvR.clp_pf_block(drv, srate, samplesblock);
  dv_tc = 1 - exp(-2 * $pi * min(1500 * 13.3 ^ drv_tone, 0.45 * srate) / srate);
  // DELAY: the time (sync: host tempo), damping in the loop, a ~120 Hz low cut in the loop
  t = dl_sync >= 0.5 ? 60 / max(tempo, 20) * bd_beats(floor(dl_div + 0.5)) : dl_ms * 0.001;
  dl_t = min(t * srate, 3 * srate);
  dl_dc = 1 - exp(-2 * $pi * min(18000 * 0.06 ^ dl_damp, 0.45 * srate) / srate);
  dl_hc = 1 - exp(-2 * $pi * 120 / srate);
  sl_c = 1 - exp(-1 / (0.15 * srate));                            // the head glides to a new time in ~150 ms
  // SPACE: line lengths from SIZE; decay; damping = shorter highs; FREEZE = no loss, no input
  sz = 0.3 + 0.7 * sp_size;
  k = 0;
  loop(8,
    ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
    ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
    k += 1;
  );
  bv_t60 = sp_freeze >= 0.5 ? 100000 : sp_decay;
  bv_rtlo = sp_freeze >= 0.5 ? 1 : 1.25;  bv_rthi = sp_freeze >= 0.5 ? 1 : 1 - 0.82 * sp_damp;
  k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
  bv_xover();
  sp_pre = (0.008 + 0.03 * sp_size) * srate;
  // reverb read wander: a slow, small chorus on the lines (keeps the tail from ringing metallic)
  k = 0;
  loop(8,
    RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
    ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
    k += 1;
  );
  // IN keys: fade in / out over 10 ms; a unit switched in from silence starts with clean lines
  fx_st = 1 / (0.01 * srate);
  dl_on >= 0.5 && dl_g == 0 && !dl_live ? ( memset(BD_L, 0, 2 * DL_N);  dlL.init = 0;  dlR.init = 0;  dl_fl = dl_fr = dl_hl = dl_hr = 0; );
  sp_on >= 0.5 && sp_g == 0 && !sp_live ? bv_alloc(FX_MEM);
);
// (audio-thread copies: a fresh instance spreads its cells the same way as a preset)
function a_mlo(j) ( j == 1 || j == 5 ? 0.3 : j == 9 ? 20 : j == 11 ? -4 : 0; );
function a_mhi(j) ( j == 1 || j == 5 ? 2.5 : j == 3 || j == 7 ? 7 : j == 9 ? 20000 : j == 11 ? 6 : j == 13 ? 50 : j == 14 ? 0.45 : j == 15 ? 100 : 1; );
function a_sn_set(c, j, v) ( (SN + (c - 1) * 16)[j] = max(a_mlo(j), min(a_mhi(j), v)); );
function sn_vary() local(b) (
  b = SN;   // cell 1's values
  a_sn_set(2, 9, b[9] * 1.6);  a_sn_set(2, 10, b[10] + 0.1);
  a_sn_set(3, 9, b[9] * 2.5);  a_sn_set(3, 10, b[10] + 0.15);  a_sn_set(3, 13, b[13] * 1.5 + 3);
  a_sn_set(4, 9, b[9] * 4);    a_sn_set(4, 0, b[0] + 0.3);  a_sn_set(4, 4, b[4] + 0.3);  a_sn_set(4, 15, 100);
  a_sn_set(5, 9, b[9] * 0.6);  a_sn_set(5, 12, b[12] + 0.4);  a_sn_set(5, 10, b[10] + 0.2);
  a_sn_set(6, 9, b[9] * 0.8);  a_sn_set(6, 0, b[0] + 0.15);  a_sn_set(6, 3, b[3] + 2);  a_sn_set(6, 7, b[7] + 2);  a_sn_set(6, 1, b[1] * 1.3);  a_sn_set(6, 8, b[8] + 0.3);
  a_sn_set(7, 9, b[9] * 1.3);  a_sn_set(7, 3, b[3] + 4);  a_sn_set(7, 7, b[7] + 4);  a_sn_set(7, 1, b[1] * 0.7);  a_sn_set(7, 2, b[2] * 0.5);  a_sn_set(7, 14, b[14] + 0.15);
  a_sn_set(8, 9, b[9] * 2);    a_sn_set(8, 0, b[0] + 0.5);  a_sn_set(8, 4, b[4] + 0.5);  a_sn_set(8, 3, b[3] + 7);  a_sn_set(8, 7, b[7] + 7);  a_sn_set(8, 8, b[8] + 0.6);  a_sn_set(8, 10, b[10] + 0.25);
);
// every snapshot = the knobs (first run)
function sn_fill() local(c, j) (
  c = 0;  loop(8, j = 0;  loop(16, SN[c * 16 + j] = slider(MPX[j]);  j += 1; );  c += 1; );
);
// a source's table crossfade, once per sample: when it completes, the new bank becomes current
function xf_adv(sp) (
  sp[SQ_BKX] > 0 ? ( sp[SQ_BKX] += bk_step;  sp[SQ_BKX] >= 1 ? ( sp[SQ_BKC] = 1 - sp[SQ_BKC];  sp[SQ_BKX] = 0; ); );
  sp[SQ_WTX] > 0 ? ( sp[SQ_WTX] += wt_step;  sp[SQ_WTX] >= 1 ? ( sp[SQ_WTC] = 1 - sp[SQ_WTC];  sp[SQ_WTX] = 0; ); );
);
// a source's background work, once per block: ADD re-bake on a TILT / EVEN change; WT bank bake, one frame per block
function src_bake(s) local(sp, k) (
  sp = SRC + s * 32;
  !sp[SQ_BKI] ? ( add_bake(0, s);  sp[SQ_BKC] = 0;  sp[SQ_BKX] = 0;  sp[SQ_BKI] = 1; );
  !sp[SQ_WTI] ? (
    sp[SQ_WTC] = 0;  sp[SQ_WTX] = 0;  sp[SQ_WTJ] = -1;  sp[SQ_WTI] = 1;
    s == 0 ? ( k = 0;  loop(8, wt_bake_frame(sp[SQ_BNK], 0, k, s);  k += 1; );  sp[SQ_WTB] = sp[SQ_BNK]; )   // A: at once
           : ( sp[SQ_WTB] = -1;  sp[SQ_WTJ] = 0;  sp[SQ_WJB] = sp[SQ_BNK]; );                                 // B: in the background
  );
  sp[SQ_WTJ] < 0 && sp[SQ_WTX] == 0 && sp[SQ_BNK] != sp[SQ_WTB] ? ( sp[SQ_WTJ] = 0;  sp[SQ_WJB] = sp[SQ_BNK]; );
  sp[SQ_WTJ] >= 0 ? (
    wt_bake_frame(sp[SQ_WJB], sp[SQ_WTB] < 0 ? 0 : 1 - sp[SQ_WTC], sp[SQ_WTJ], s);  sp[SQ_WTJ] += 1;
    sp[SQ_WTJ] >= 8 ? ( sp[SQ_WTJ] = -1;  sp[SQ_WTB] < 0 ? sp[SQ_WTB] = sp[SQ_WJB] : ( sp[SQ_WTB] = sp[SQ_WJB];  sp[SQ_WTX] = 0.000001; ); );
  );
  sp[SQ_BKX] == 0 && (abs(sp[SQ_TLT] - sp[SQ_BKT]) > 0.003 || abs(sp[SQ_EVN] - sp[SQ_BKE]) > 0.003) ? (
    add_bake(1 - sp[SQ_BKC], s);  sp[SQ_BKX] = 0.000001;
  );
);

function update_params() (
  a_ainc = CR / max(1, aa * 0.001 * srate);  a_dc = env_coef(ad);  a_sl = as / 100;  a_rc = env_coef(ar);
  f_ainc = CR / max(1, fa * 0.001 * srate);  f_dc = env_coef(fd);  f_sl = fs / 100;  f_rc = env_coef(fr);
  gl_c = glide > 0 ? 1 - exp(-4.6 * CR / (glide * 0.001 * srate)) : 1;
  dr_c = 1 - exp(-CR / (1.2 * srate));                             // drift smoothing (~1.2 s)
  fade_step = 1 / (0.003 * srate);
  add_n = max(1, floor(20 / uni));                              // ADD (stretched) partials per unison copy (20 in all)
  dc_r = 1 - 2 * $pi * 5 / srate;                                // DC blockers: 5 Hz
  bk_step = 1 / (0.02 * srate);  wt_step = 1 / (0.03 * srate);   // table crossfades: ADD 20 ms, WT 30 ms
  pad_sc = 1 - exp(-CR / max(1, slew * 0.001 * srate));            // pad slew
  ctl_dirty = 1;                                                  // pad OUT: the knobs are read again at the next tick
  out_g = 10 ^ (vol / 20) * 0.35;
);

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function sl_auto(idx) (
  idx == 33 ? slider_automate(wt_wob) : idx == 34 ? slider_automate(eng_b) : idx == 35 ? slider_automate(b_shape) :
  idx == 36 ? slider_automate(b_tilt) : idx == 37 ? slider_automate(b_even) : idx == 38 ? slider_automate(b_stretch) :
  idx == 39 ? slider_automate(b_bank) : idx == 40 ? slider_automate(b_frame) : idx == 41 ? slider_automate(b_sweep) :
  idx == 42 ? slider_automate(b_wob) : idx == 43 ? slider_automate(b_tune) : idx == 44 ? slider_automate(b_fine) :
  idx == 45 ? slider_automate(b_on) : idx == 46 ? slider_automate(ab_mix) : idx == 47 ? slider_automate(pad_on) :
  idx == 48 ? slider_automate(pad_x) : idx == 49 ? slider_automate(pad_y) : idx == 50 ? slider_automate(snap) :
  idx == 51 ? slider_automate(slew) : idx == 52 ? slider_automate(drv_on) : idx == 53 ? slider_automate(drv) :
  idx == 54 ? slider_automate(drv_bias) : idx == 55 ? slider_automate(drv_tone) : idx == 56 ? slider_automate(drv_mix) :
  idx == 57 ? slider_automate(dl_on) : idx == 58 ? slider_automate(dl_sync) : idx == 59 ? slider_automate(dl_ms) :
  idx == 60 ? slider_automate(dl_div) : idx == 61 ? slider_automate(dl_fb) : idx == 62 ? slider_automate(dl_damp) :
  idx == 63 ? slider_automate(dl_send) : idx == 64 ? slider_automate(dl_mix) : idx == 65 ? slider_automate(dl_pp) :
  idx == 66 ? slider_automate(sp_on) : idx == 67 ? slider_automate(sp_size) : idx == 68 ? slider_automate(sp_decay) :
  idx == 69 ? slider_automate(sp_damp) : idx == 70 ? slider_automate(sp_mix) : idx == 71 ? slider_automate(sp_freeze) :
  idx == 72 ? slider_automate(pm_rate) : idx == 73 ? slider_automate(pm_depth) : idx == 74 ? slider_automate(pm_shape);
);
function sl_auto_au(idx) (
  idx == 33 ? slider_automate(wt_wob) : idx == 34 ? slider_automate(eng_b) : idx == 35 ? slider_automate(b_shape) :
  idx == 36 ? slider_automate(b_tilt) : idx == 37 ? slider_automate(b_even) : idx == 38 ? slider_automate(b_stretch) :
  idx == 39 ? slider_automate(b_bank) : idx == 40 ? slider_automate(b_frame) : idx == 41 ? slider_automate(b_sweep) :
  idx == 42 ? slider_automate(b_wob) : idx == 43 ? slider_automate(b_tune) : idx == 44 ? slider_automate(b_fine) :
  idx == 45 ? slider_automate(b_on) : idx == 46 ? slider_automate(ab_mix) : idx == 47 ? slider_automate(pad_on) :
  idx == 48 ? slider_automate(pad_x) : idx == 49 ? slider_automate(pad_y) : idx == 50 ? slider_automate(snap) :
  idx == 51 ? slider_automate(slew) : idx == 52 ? slider_automate(drv_on) : idx == 53 ? slider_automate(drv) :
  idx == 54 ? slider_automate(drv_bias) : idx == 55 ? slider_automate(drv_tone) : idx == 56 ? slider_automate(drv_mix) :
  idx == 57 ? slider_automate(dl_on) : idx == 58 ? slider_automate(dl_sync) : idx == 59 ? slider_automate(dl_ms) :
  idx == 60 ? slider_automate(dl_div) : idx == 61 ? slider_automate(dl_fb) : idx == 62 ? slider_automate(dl_damp) :
  idx == 63 ? slider_automate(dl_send) : idx == 64 ? slider_automate(dl_mix) : idx == 65 ? slider_automate(dl_pp) :
  idx == 66 ? slider_automate(sp_on) : idx == 67 ? slider_automate(sp_size) : idx == 68 ? slider_automate(sp_decay) :
  idx == 69 ? slider_automate(sp_damp) : idx == 70 ? slider_automate(sp_mix) : idx == 71 ? slider_automate(sp_freeze) :
  idx == 72 ? slider_automate(pm_rate) : idx == 73 ? slider_automate(pm_depth) : idx == 74 ? slider_automate(pm_shape);
);
function g_store(c) local(j) ( j = 0;  loop(16, SN[c * 16 + j] = slider(MPX[j]);  j += 1; );  gui_dirty = 1; );
function g_store_au(c) local(j) ( j = 0;  loop(16, SN[c * 16 + j] = slider(MPX[j]);  j += 1; );  gui_dirty = 1; );
function g_sn_fill() local(c) ( c = 0;  loop(8, g_store_au(c);  c += 1; ); );
function sn_put(c, j, v) ( SN[(c - 1) * 16 + j] = v; );
function g_mlo(j) ( j == 1 || j == 5 ? 0.3 : j == 9 ? 20 : j == 11 ? -4 : 0; );
function g_mlo_au(j) ( j == 1 || j == 5 ? 0.3 : j == 9 ? 20 : j == 11 ? -4 : 0; );
function g_mhi(j) ( j == 1 || j == 5 ? 2.5 : j == 3 || j == 7 ? 7 : j == 9 ? 20000 : j == 11 ? 6 : j == 13 ? 50 : j == 14 ? 0.45 : j == 15 ? 100 : 1; );
function g_mhi_au(j) ( j == 1 || j == 5 ? 2.5 : j == 3 || j == 7 ? 7 : j == 9 ? 20000 : j == 11 ? 6 : j == 13 ? 50 : j == 14 ? 0.45 : j == 15 ? 100 : 1; );
function sn_set(c, j, v) ( (SN + (c - 1) * 16)[j] = max(g_mlo_au(j), min(g_mhi_au(j), v)); );
function g_sn_vary() local(b) (
  b = SN;   // cell 1's values
  sn_set(2, 9, b[9] * 1.6);  sn_set(2, 10, b[10] + 0.1);
  sn_set(3, 9, b[9] * 2.5);  sn_set(3, 10, b[10] + 0.15);  sn_set(3, 13, b[13] * 1.5 + 3);
  sn_set(4, 9, b[9] * 4);    sn_set(4, 0, b[0] + 0.3);  sn_set(4, 4, b[4] + 0.3);  sn_set(4, 15, 100);
  sn_set(5, 9, b[9] * 0.6);  sn_set(5, 12, b[12] + 0.4);  sn_set(5, 10, b[10] + 0.2);
  sn_set(6, 9, b[9] * 0.8);  sn_set(6, 0, b[0] + 0.15);  sn_set(6, 3, b[3] + 2);  sn_set(6, 7, b[7] + 2);  sn_set(6, 1, b[1] * 1.3);  sn_set(6, 8, b[8] + 0.3);
  sn_set(7, 9, b[9] * 1.3);  sn_set(7, 3, b[3] + 4);  sn_set(7, 7, b[7] + 4);  sn_set(7, 1, b[1] * 0.7);  sn_set(7, 2, b[2] * 0.5);  sn_set(7, 14, b[14] + 0.15);
  sn_set(8, 9, b[9] * 2);    sn_set(8, 0, b[0] + 0.5);  sn_set(8, 4, b[4] + 0.5);  sn_set(8, 3, b[3] + 7);  sn_set(8, 7, b[7] + 7);  sn_set(8, 8, b[8] + 0.6);  sn_set(8, 10, b[10] + 0.25);
);
function load_preset(p) local(i) (
