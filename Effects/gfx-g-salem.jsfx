  slider_automate(4294967295);  i = 33;  loop(42, sl_auto_au(i);  i += 1; );   // sliders 1-32, then 33-74
  ed_cell = 0;  store_arm = 0;
  gui_dirty = 1;
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
// MIDI into the timed queue (fired at its exact sample in @sample)
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);                        // pass MIDI through
);
mq_i = 0;  spos = 0;
// first run: every snapshot starts as the knobs
!sn_ok ? ( sn_fill();  sn_vary();  sn_ok = 1; );
!src_ok ? ( ctl_update();  src_ok = 1; );
// tables: ADD re-bakes into a spare bank and crossfades in 20 ms; a WT bank change bakes one frame
// per block into the spare buffer, then crossfades in 30 ms (Source B's first bake runs the same way)
src_bake(0);  src_bake(1);
fx_block();
prm_dirty ? ( prm_dirty = 0;  update_params(); );          // a change from the faceplate
ost_setup(0, 0.3, 120, 6000, -0.3, 1);                      // house output stage: CLIP, always on, -0.3 dBFS
outpk_disp = max(outpk_disp, outpk);  outpk = 0;            // OUT meter hand-off
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

// table crossfades (both sources)
xf_adv(SRC);  xf_adv(SRC + 32);
// control tick
cr_n <= 0 ? (
  cr_n = CR;
  pwm_ph += pwm_hz * CR / srate;  pwm_ph -= floor(pwm_ph);
  ctl_update();                                                  // the pad (or the knobs) -> the values in use
  // the filter's CUTOFF (two 15 ms stages), RESO and ENV glide, so a turned knob, automation or the pad never steps
  fl_k = 1 - exp(-CR / (0.015 * srate));
  !fl_ok ? ( fl_c1 = fl_c2 = log(e_cutoff);  fl_rs = e_reso;  fl_ev = e_fenv;  fl_ok = 1; );
  fl_c1 += (log(e_cutoff) - fl_c1) * fl_k;  fl_c2 += (fl_c1 - fl_c2) * fl_k;  fl_rs += (e_reso - fl_rs) * fl_k;  fl_ev += (e_fenv - fl_ev) * fl_k;
  wob_lfo = sin(2 * $pi * pwm_ph);                               // WT wobble shares the mod LFO
  pmod = e_pwm * wob_lfo;
  vb = VOX;  loop(NV, vb[F_ON] ? v_tick(vb);  vb += VS; );
);
cr_n -= 1;

// voices
mixL = 0;  mixR = 0;  vb = VOX;
loop(NV, vb[F_ON] ? v_run(vb);  vb += VS; );

yl = mixL * out_g;  yr = mixR * out_g;
// DC blocker at the start of the master chain (5 Hz, first order): nothing below it reaches the FX
dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;

// ---------- DRIVE ----------
dv_g += drv_on >= 0.5 ? (dv_g < 1 ? fx_st : 0) : (dv_g > 0 ? -fx_st : 0);  dv_g = max(0, min(1, dv_g));
dv_g > 0 ? (
  u_l = dvL.clp_run(dvL.clp_pf_run(yl * dv_gin));  u_r = dvR.clp_run(dvR.clp_pf_run(yr * dv_gin));
  dv_xl = u_l - dv_pl + 0.9995 * dv_xl;  dv_pl = u_l;  dv_xr = u_r - dv_pr + 0.9995 * dv_xr;  dv_pr = u_r;   // DC block (BIAS)
  dv_tl += (dv_xl - dv_tl) * dv_tc;  dv_tr += (dv_xr - dv_tr) * dv_tc;                                      // TONE
  u_m = dv_g * drv_mix;
  yl += (dv_tl * dv_gout - yl) * u_m;  yr += (dv_tr * dv_gout - yr) * u_m;
);

// ---------- DELAY ----------
dl_g += dl_on >= 0.5 ? (dl_g < 1 ? fx_st : 0) : (dl_g > 0 ? -fx_st : 0);  dl_g = max(0, min(1, dl_g));
dl_live = dl_g > 0;
dl_live ? (
  cr_n == CR ? ( dl_wl = dwL.drift_tick(CR * 0.35 / srate);  dl_wr = dwR.drift_tick(CR * 0.31 / srate); );   // DRIFT: tape-like wander
  u_dl = dlL.sl_run(BD_L, dl_t * (1 + dl_wl * 0.005 * drift / 100));
  u_dr = dlR.sl_run(BD_R, dl_t * (1 + dl_wr * 0.005 * drift / 100));
  dl_hl += (u_dl - dl_hl) * dl_hc;  dl_hr += (u_dr - dl_hr) * dl_hc;                     // low cut in the loop
  dl_fl += (u_dl - dl_hl - dl_fl) * dl_dc;  dl_fr += (u_dr - dl_hr - dl_fr) * dl_dc;     // damping
  u_fl = ts(dl_fl * dl_fb * 1.25) * 0.8;  u_fr = ts(dl_fr * dl_fb * 1.25) * 0.8;         // the loop can't run away
  u_m = dl_g * dl_send;
  dl_pp >= 0.5 ? bd_put((yl + yr) * 0.5 * u_m + u_fr + bv_dn, u_fl + bv_dn)              // ping-pong: in on the left, crossing
               : bd_put(yl * u_m + u_fl + bv_dn, yr * u_m + u_fr + bv_dn);
  u_m = dl_g * dl_mix;
  yl = yl * min(1, 2 - 2 * u_m) + u_dl * min(1, 2 * u_m);
  yr = yr * min(1, 2 - 2 * u_m) + u_dr * min(1, 2 * u_m);
);

// ---------- SPACE ----------
sp_g += sp_on >= 0.5 ? (sp_g < 1 ? fx_st : 0) : (sp_g > 0 ? -fx_st : 0);  sp_g = max(0, min(1, sp_g));
sp_live = sp_g > 0;
sp_live ? (
  u_m = sp_freeze >= 0.5 ? 0 : 1;
  bv_pre(yl * u_m, yr * u_m);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, sp_size);
  fdn_run(dif_l, dif_r);
  u_m = sp_g * sp_mix;
  yl = yl * min(1, 2 - 2 * u_m) + fdn_l * 0.55 * min(1, 2 * u_m);
  yr = yr * min(1, 2 - 2 * u_m) + fdn_r * 0.55 * min(1, 2 * u_m);
);

// a second DC blocker after the FX, ahead of the clipper (the clipper keeps the last word on the ceiling)
dc_ol = yl - dc_qol + dc_r * dc_ol;  dc_qol = yl;  yl = dc_ol;
dc_or = yr - dc_qor + dc_r * dc_or;  dc_qor = yr;  yr = dc_or;
// the house output stage: CLIP, always on, ceiling -0.3 dBFS (anti-aliased, zero latency)
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, sn_ok);
file_mem(0, SN, 128);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@gfx 1100 700
// =====================================================================
// GUI — Salem faceplate: bluish white, silver, blue and cyan; LCDs with bright blue text;
// chunky knobs for the main control of each section, small desk knobs, faders and sliders.
// =====================================================================
C_PANEL = 0xE6EDF4;  C_SEC1 = 0xDCE5EE;  C_SEC2 = 0xD3DEE9;  C_SEC3 = 0xE0E8F0;  C_EDGE = 0xA9B6C4;
C_INK = 0x1E3550;  C_INK2 = 0x4A6280;  C_BLUE = 0x2F5D9E;  C_CYAN = 0x2FB6D4;  C_SILV = 0xBFC7CF;
C_LCDBG = 0x07111F;  C_LCDTX = 0x56B6FF;  C_CAPW = 0xEEF2F6;
LK_YEL = 0xF2C230;  LK_SKY = 0x7FB8E6;  LK_AMB = 0xF2A41E;  lk_well = 0x141518;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_l(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
// ---------- the top bar: a pink / purple nebula in deep space with distant stars ----------
// Painted once into image 120 (again only when the window is resized), then blitted each frame.
// Its own random sequence, so the sky is the same every time the plug-in opens.
function nb_rnd() ( nb_s = (nb_s * 16807) % 2147483647;  nb_s / 2147483647; );
function nb_col(c, a) ( col(c, a); );
function nb_build() local(w, h, i, x, y, r, t, c, a, k, cy, q) (
  w = ceil(ps(1100));  h = ceil(ps(58));
  gfx_setimgdim(120, w, h);  gfx_dest = 120;
  nb_s = 9137;
  // deep space: a dark violet gradient, lighter toward the middle of the band
  i = 0;
  loop(h,
    t = i / max(h - 1, 1);  t = 1 - abs(t - 0.55) * 1.6;
    col(ui_mix(0x070312, 0x150A2E, max(0, t)), 1);  gfx_rect(0, i, w, 1, 1);
    i += 1;
  );
  // the cloud: soft overlapping glows along a meandering band, purple underneath, pink on top
  k = 0;
  loop(4,
    i = 0;
    loop(k == 0 ? 45 : k == 1 ? 70 : k == 2 ? 70 : 28,
      r = k == 0 ? 26 + nb_rnd() * 34 : k == 1 ? 14 + nb_rnd() * 22 : k == 2 ? 8 + nb_rnd() * 14 : 3 + nb_rnd() * 6;
      x = 190 + nb_rnd() * 360;  x = min(x, 552 - r * 0.7);         // the cloud sits right of the title, ending before PRESETS
      cy = 29 + 9 * sin(x / 360 * 2 * $pi * 0.9 + 0.6) + 5 * sin(x / 360 * 2 * $pi * 2.3);
      y = cy + (nb_rnd() - 0.5) * (k == 0 ? 40 : k == 1 ? 30 : 20);
      // it thickens from the left, fullest around 420, and thins out toward its right-hand edge
      a = x < 420 ? max(0, (x - 190) / 230) : max(0, 1 - (x - 420) / 150 * 0.6);
      a = a * a * (3 - 2 * a);
      c = k == 0 ? (nb_rnd() < 0.5 ? 0x3A1D8C : 0x4E2399) : k == 1 ? (nb_rnd() < 0.5 ? 0x8A2DB8 : 0xB0359E) :
          k == 2 ? (nb_rnd() < 0.6 ? 0xE0509E : 0xC94FD6) : 0xFFB3E0;
      t = (k == 0 ? 0.022 : k == 1 ? 0.028 : k == 2 ? 0.034 : 0.05) * a;
      // a soft glow: stacked rings, so it fades out to nothing at the edge (no visible disc)
      q = 0;  loop(8, col(c, t);  gfx_circle(px(x) - ox, py(y) - oy, ps(r * (1 - q / 8)), 1, 1);  q += 1; );
      i += 1;
    );
    k += 1;
  );
  // dark dust lanes across the cloud
  i = 0;
  loop(14,
    x = 260 + nb_rnd() * 270;  y = 29 + 9 * sin(x / 360 * 2 * $pi * 0.9 + 0.6) + (nb_rnd() - 0.5) * 16;
    r = 4 + nb_rnd() * 10;  q = 0;
    loop(5, col(0x08040F, 0.04);  gfx_circle(px(x) - ox, py(y) - oy, ps(r * (1 - q / 5)), 1, 1);  q += 1; );
    i += 1;
  );
  // distant stars: mostly faint pin-pricks, a few brighter with a soft halo and a glint
  i = 0;
  loop(320,
    x = nb_rnd() * 1100;  y = nb_rnd() * 58;  t = nb_rnd();
    c = nb_rnd() < 0.15 ? 0xFFD6EE : nb_rnd() < 0.3 ? 0xCFE0FF : 0xFFFFFF;
    t < 0.92 ? ( col(c, 0.25 + 0.6 * nb_rnd());  gfx_rect(floor(px(x) - ox), floor(py(y) - oy), max(1, floor(ps(t < 0.7 ? 0.8 : 1.3))), max(1, floor(ps(t < 0.7 ? 0.8 : 1.3))), 1); ) : (
      col(c, 0.18);  gfx_circle(px(x) - ox, py(y) - oy, ps(3.2), 1, 1);
      col(c, 0.95);  gfx_circle(px(x) - ox, py(y) - oy, ps(1.1), 1, 1);
      col(c, 0.35);  gfx_rect(px(x) - ox - ps(4), py(y) - oy, ps(8), 1, 1);  gfx_rect(px(x) - ox, py(y) - oy - ps(4), 1, ps(8), 1);
    );
    i += 1;
  );
  gfx_dest = -1;
  nb_w = gfx_w;  nb_h = gfx_h;
);

function rivet(x, y) (
  col(0x9AA7B4, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.7); gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
// a section: its shade, a narrow darker bottom / right edge, a light top line, the title
function section(x, y, w, h, c, title) (
  col(c, 1);  u_rect(x, y, w, h);
  col(shade(c, 0.82), 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h);
  col(0xFFFFFF, 0.8);  u_rect(x, y, w - 2, 1);
  gfx_setfont(4);  col(C_BLUE, 1);  text_l(px(x + 12), py(y + 15), title);
);
// the morph value a slider belongs to (-1: none)
function g_mj(idx) local(j, r) ( r = -1;  j = 0;  loop(16, MPX[j] == idx ? r = j;  j += 1; );  r; );
// sliders past 32 are automated by name
// a knob moved: automation; with EDIT lit, the selected snapshot takes the new value
function param_touched(idx) local(j) (
  idx <= 32 ? slider_automate(2 ^ (idx - 1)) : sl_auto(idx);
  ed_on && ed_cell > 0 ? ( j = g_mj(idx);  j >= 0 ? SN[(ed_cell - 1) * 16 + j] = slider(idx); );
  gui_dirty = 1;
);
// snapshots from the GUI: recall one into the knobs (and the puck onto it); store the knobs into one; all = the knobs
function g_recall(c) local(j) (
  ed_cell = 0;  j = 0;
  loop(16, slider(MPX[j]) = SN[c * 16 + j];  param_touched(MPX[j]);  j += 1; );
  slider(48) = ((c % 4) + 0.5) / 4;  slider(49) = (floor(c / 4) + 0.5) / 2;  param_touched(48);  param_touched(49);
  ed_cell = c + 1;
);
// each morph value's range
// a control turned while the pad is playing (no cell selected): every cell moves by the same amount
// (cutoff by the same ratio), so the knob always works and the pad keeps its shape around it
function sn_shift(j, nv, ov) local(c, q) (
  c = 0;
  loop(8,
    q = (SN + c * 16)[j];
    q = j == 9 ? q * nv / max(ov, 1) : q + nv - ov;
    (SN + c * 16)[j] = max(g_mlo(j), min(g_mhi(j), q));
    c += 1;
  );
);
// a starting spread for a preset's cells (cell 1 = the preset itself): the top row opens the filter
// step by step, the bottom row changes character (shape, tilt, frame, mix, filter mode)
// pointer as a filled quad, with anti-aliased edges: clean at any angle
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
// value text for the hover tag
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v * 100 + 0.5) :
  fmt == 2 ? ( v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
  fmt == 3 ? ( v < 10 ? sprintf(#kv, "%.1f ms", v) : v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 4 ? sprintf(#kv, "%d %%", v) :
  fmt == 5 ? sprintf(#kv, "%.1f c", v) :
  fmt == 6 ? sprintf(#kv, "%d", v) :
  fmt == 7 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 8 ? sprintf(#kv, "%d st", v) :
  fmt == 9 ? sprintf(#kv, "%+.1f oct", v) :
  fmt == 10 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 12 ? sprintf(#kv, "%+d %%", v * 100) :
  fmt == 13 ? sprintf(#kv, "%.1f", v + 1) :
  fmt == 14 ? sprintf(#kv, "%+d st", v) :
  fmt == 15 ? sprintf(#kv, "%+.1f c", v) :
  fmt == 16 ? ( #kv = v < 0.5 ? "1/1" : v < 1.5 ? "1/2" : v < 2.5 ? "1/2 D" : v < 3.5 ? "1/2 T" : v < 4.5 ? "1/4" : v < 5.5 ? "1/4 D" : v < 6.5 ? "1/4 T" :
                       v < 7.5 ? "1/8" : v < 8.5 ? "1/8 D" : v < 9.5 ? "1/8 T" : v < 10.5 ? "1/16" : v < 11.5 ? "1/16 D" : v < 12.5 ? "1/16 T" : "1/32"; ) :
  fmt == 17 ? sprintf(#kv, "%.1f s", v) :
              sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);

// Knob. big = 1: chunky silver knob with a blue cap; 0: small desk knob. klog = 1 before a call: log taper;
// kstep > 0: stepped. inert = 1: drawn only (a section still to come). Double-click / Ctrl-click = default.
function kn(cx, cy, r, idx, vmin, vmax, def, cap, pcol, lbl, fmt, big)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lg, st, ine, lk, mj, ov)
(
  lg = klog;  klog = 0;  st = kstep;  kstep = 0;  ine = inert;
  // pad IN (and no cell being edited): a morphed control shows the pad's value; turning it moves every cell
  mj = ine ? -1 : g_mj(idx);  lk = mj >= 0 && pad_on && !(ed_on && ed_cell > 0);
  x = px(cx);  y = py(cy - 4);  rr = ps(r);                      // the dial sits 4 above its place; the label stays
  hov = !ine && sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = ine ? def : lk ? (drag_idx == idx ? kd_last : EP[mj]) : slider(idx);
  v = max(vmin, min(vmax, v));
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      lk ? sn_shift(mj, def, EP[mj]);
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t;  kd_last = v; );
    last_click_idx = idx;  last_click_t = now;
  );
  !ine && drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps(220)));
    v = lg ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st :
    lg ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 1000 + 0.5) / 1000;
    v = max(vmin, min(vmax, v));
    lk ? ( v != kd_last ? ( ov = kd_last;  kd_last = v;  sn_shift(mj, v, ov);  slider(idx) = v;  param_touched(idx); ); )
       : ( v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); ); );
  );
  v = ine ? def : lk ? (drag_idx == idx ? kd_last : EP[mj]) : slider(idx);
  v = max(vmin, min(vmax, v));
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  lk ? ( col(C_CYAN, 0.85);  gfx_circle(x, y, rr + ps(2.5), 0, 1);  gfx_circle(x, y, rr + ps(3.2), 0, 1); );   // on the pad
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  col(C_INK2, 0.8);  j = 0;
  loop(11, b = a0 + j / 10 * (a1 - a0);  gfx_circle(x + sin(b) * (rr + ps(6)), y - cos(b) * (rr + ps(6)), ps(big ? 1.4 : 1.1), 1, 1);  j += 1; );
  col(0x24364D, 0.28);  gfx_circle(x + ps(2), y + ps(3), rr, 1, 1);
  big ? (
    col(0xA3ADB8, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x7D8894, 1);  gfx_circle(x, y, rr, 0, 1);
    col(C_SILV, 1);    gfx_circle(x, y, rr * 0.84, 1, 1);
    col(cap, 1);       gfx_circle(x, y, rr * 0.62, 1, 1);
    col(0xFFFFFF, 0.35);  gfx_arc(x, y, rr * 0.58, -1.7, -0.2, 1);
    col(shade(cap, 0.7), 1);  gfx_circle(x, y, rr * 0.62, 0, 1);
    col(pcol, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.08, rr * 0.97, ps(1.9));
  ) : (
    col(0x8A949F, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x66707A, 1);  gfx_circle(x, y, rr, 0, 1);
    col(0xC9D0D7, 1);  gfx_circle(x, y, rr * 0.76, 1, 1);
    col(cap, 1);       gfx_circle(x, y, rr * 0.6, 1, 1);
    col(0xFFFFFF, 0.3);  gfx_arc(x, y, rr * 0.55, -1.7, -0.2, 1);
    col(shade(cap, 0.7), 1);  gfx_circle(x, y, rr * 0.6, 0, 1);
    col(pcol, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.97, ps(1.3));
  );
  gfx_setfont(6);  col(C_INK, 1);  text_c(x, y + rr + ps(19), lbl);      // label 19 below the rim
  lk && hov ? ( strcpy(#kp, "PAD  ");  strcat(#kp, fmtv(v, fmt));  hover_tag(x, y - rr - ps(16), #kp); ) :
  hov || (!ine && drag_idx == idx) ? hover_tag(x, y - rr - ps(16), fmtv(v, fmt));
);

// Vertical fader: drag anywhere in its column; double-click / Ctrl-click = default; value on hover.
function fader(x, y0, h, idx, vmin, vmax, def, lg, lbl, fmt) local(t, v, cy, hov, now, j, cx)
(
  cx = px(x);
  v = slider(idx);  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  hov = abs(mouse_x - cx) < ps(12) && mouse_y >= py(y0 - 10) && mouse_y <= py(y0 + h + 10);
  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps(h)));
    v = lg ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    lg ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = slider(idx);  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  cy = y0 + h * (1 - t);
  col(0x2A3A4E, 1);  u_rect(x - 3, y0, 6, h);  col(0x0E1824, 1);  u_rect(x - 1, y0 + 2, 2, h - 4);
  col(C_INK2, 0.7);  j = 0;  loop(5, u_rect(x - 10, y0 + j * h / 4, 4, 1);  j += 1; );
  col(0x24364D, 0.3);  u_rect(x - 8, cy - 5, 20, 16);
  col(C_SILV, 1);  u_rect(x - 10, cy - 8, 20, 16);
  col(0xFFFFFF, 0.6);  u_rect(x - 10, cy - 8, 20, 1.5);
  col(shade(C_SILV, 0.75), 1);  u_rect(x - 10, cy + 6.5, 20, 1.5);  u_rect(x + 8.5, cy - 8, 1.5, 16);
  col(C_CYAN, 1);  u_rect(x - 10, cy - 1, 20, 2);
  gfx_setfont(6);  col(C_INK, 1);  text_c(cx, py(y0 + h + 14), lbl);
  hov || drag_idx == idx ? hover_tag(cx, py(y0 - 14), fmtv(v, fmt));
);

// ---------- house lamp keys: a coloured lens in a dark well (lit = feathered glow) ----------
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = !inert && mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);

// ---------- LCD: dark navy glass, bright blue text with a faint glow ----------
function lcd(x, y, w, h, fnt, str) local(tw, th, gy) (
  col(0x8C99A6, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x02060C, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  col(0xFFFFFF, 0.06);  u_rect(x + 4, y + 4, w - 8, 1);
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);
  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);
  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);

// ---------- house preset bar: [PRESETS][<][>][LCD] ----------
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xD8DEE6, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xD8DEE6, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xD8DEE6, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(C_INK, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- presets (GUI thread only) ----------
PRESET_MENU = "Init|Supersaw Lead|Warm Pad|Pluck|Square Bass|PWM Strings|Soft Brass|Band Sweep|Thin Pulse|Glide Lead|Additive Organ|Glass Bell|Formant Choir|Sync Sweep Lead|Fold Bass|Morph Pad|Vowel Lead|Bell Organ";

// ---------- one source panel (A live; B drawn inert until checkpoint 5) ----------
function source_panel(sy, nm, s) local(sh, ad, wt, i, e, o, sp) (
  section(16, sy, 400, 188, C_SEC1, nm);
  sp = SRC + s * 32;                                                // the live values (the pad's, when it's IN)
  e = s ? 34 : 26;  o = s ? 9 : 0;                                  // engine slider; B's sliders sit 9 past A's (27 -> 36 ...)
  ad = floor(slider(e) + 0.5) == 1;  wt = floor(slider(e) + 0.5) == 2;
  lk_key(176, sy + 6, 48, 24, !ad && !wt, LK_YEL, "VA") ? ( slider(e) = 0;  param_touched(e); );
  lk_key(230, sy + 6, 48, 24, ad, LK_YEL, "ADD") ? ( slider(e) = 1;  param_touched(e); );
  lk_key(284, sy + 6, 48, 24, wt, LK_YEL, "WT") ? ( slider(e) = 2;  param_touched(e); );
  s ? ( lk_key(346, sy + 6, 58, 24, b_on >= 0.5, LK_AMB, "IN") ? ( slider(45) = b_on >= 0.5 ? 0 : 1;  param_touched(45); ); )
    : ( lk_key(346, sy + 6, 58, 24, phmode >= 0.5, LK_SKY, "RESET") ? ( slider(25) = phmode >= 0.5 ? 0 : 1;  param_touched(25); ); );
  wt ? (
    i = floor(slider(30 + o) + 0.5);
    #wb = i == 0 ? "CLASSIC" : i == 1 ? "FORMANT" : i == 2 ? "ORGAN" : i == 3 ? "DIGITAL" : i == 4 ? "FOLD" : i == 5 ? "SYNC" : i == 6 ? "PWM" : "SWEEP";
    sprintf(#ln, "WT   %s  FRAME %.1f", #wb, sp[SQ_FRM] + 1);
    sp[SQ_WTJ] >= 0 ? strcat(#ln, "  ...");
  ) : ad ? ( slider(29 + o) > 0.001 ? sprintf(#ln, "ADD  STRETCHED  %d PARTIALS", add_n * uni) : sprintf(#ln, "ADD  128 PARTIALS  TILT %.2f", sp[SQ_TLT]); ) : (
    sh = sp[SQ_SHP];
    sh < 0.02 ? strcpy(#ln, "VA   SAW") : sh < 0.48 ? strcpy(#ln, "VA   SAW > SQUARE") :
    sh < 0.52 ? strcpy(#ln, "VA   SQUARE") : sprintf(#ln, "VA   PULSE %d%%", (0.5 - (sh - 0.5) * 0.9) * 100 + 0.5);
  );
  s ? (
    b_tune != 0 || b_fine != 0 ? ( abs(b_fine) >= 0.05 ? sprintf(#lt, "   %+d st %+.0fc", b_tune, b_fine) : sprintf(#lt, "   %+d st", b_tune);  strcat(#ln, #lt); );
    b_on < 0.5 ? ( strcpy(#lt, "OFF  ");  strcat(#lt, #ln);  strcpy(#ln, #lt); );
  ) : ( uni > 1 ? ( sprintf(#lt, "   x%d %.0fc", uni, e_detune);  strcat(#ln, #lt); ); );
  lcd(28, sy + 38, 376, 28, 7, #ln);
  wt && click && mouse_x >= px(28) && mouse_x < px(404) && mouse_y >= py(sy + 38) && mouse_y < py(sy + 66) ? (
    gfx_x = px(28);  gfx_y = py(sy + 66);
    i = gfx_showmenu("Classic|Formant|Organ|Digital|Fold|Sync|PWM|Sweep");
    i > 0 ? ( slider(30 + o) = i - 1;  param_touched(30 + o); );
  );
  wt ? (
    kn(56, sy + 124, 26, 31 + o, 0, 7, 0, C_BLUE, 0xFFFFFF, "FRAME", 13, 1);
    kn(116, sy + 126, 15, 32 + o, -1, 1, 0, C_CYAN, 0xFFFFFF, "SWEEP", 12, 0);       // filter envelope > frame
    kn(166, sy + 126, 15, 33 + o, 0, 1, 0, C_CAPW, C_INK, "LFO", 1, 0);             // LFO > frame (wobble depth)
    klog = 1;  kn(212, sy + 126, 15, 3, 0.05, 10, 0.6, C_CAPW, C_INK, "RATE", 10, 0);  // shared mod LFO speed
  ) : ad ? (
    kn(66, sy + 124, 26, 27 + o, 0.3, 2.5, 1, C_BLUE, 0xFFFFFF, "TILT", 0, 1);
    kn(140, sy + 126, 15, 28 + o, 0, 1, 1, C_CYAN, 0xFFFFFF, "EVEN", 1, 0);
    kn(200, sy + 126, 15, 29 + o, 0, 1, 0, C_CAPW, C_INK, "STRETCH", 1, 0);
  ) : (
    kn(66, sy + 124, 26, s ? 35 : 1, 0, 1, 0, C_BLUE, 0xFFFFFF, "SHAPE", 1, 1);
    kn(140, sy + 126, 15, 2, 0, 0.45, 0.15, C_CYAN, 0xFFFFFF, "PWM", 11, 0);       // shared by A and B
    klog = 1;  kn(200, sy + 126, 15, 3, 0.05, 10, 0.6, C_CAPW, C_INK, "RATE", 10, 0);
  );
  s ? (
    kstep = 1;  kn(298, sy + 126, 15, 43, -24, 24, 0, C_CAPW, C_INK, "TUNE", 14, 0);
    kn(362, sy + 126, 15, 44, -50, 50, 0, C_CAPW, C_INK, "FINE", 15, 0);
  ) : (
    kstep = 1;  kn(266, sy + 126, 15, 22, 1, 7, 1, C_CAPW, C_INK, "UNISON", 6, 0);
    kn(328, sy + 126, 15, 23, 0, 50, 12, C_CAPW, C_INK, "DETUNE", 5, 0);
    kn(388, sy + 126, 15, 24, 0, 100, 70, C_BLUE, 0xFFFFFF, "WIDTH", 4, 0);
  );
);

// ---------- frame setup ----------
sc = min(gfx_w / 1100, gfx_h / 700);
ox = (gfx_w - 1100 * sc) * 0.5;
oy = (gfx_h - 700 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
inert = 0;  klog = 0;  kstep = 0;

gfx_setfont(1, "Monoton", ps(28));                 // title (a free Google font: install Monoton to see it)
gfx_setfont(10, "Monoton", ps(11));
gfx_setfont(2, "Century Gothic", ps(11), 'b');
gfx_setfont(3, "Verdana", ps(13), 'b');
gfx_setfont(4, "Century Gothic", ps(15), 'b');
gfx_setfont(5, "Verdana", ps(11), 'b');
gfx_setfont(6, "Century Gothic", ps(13), 'b');
gfx_setfont(7, "Courier New", ps(15), 'b');
gfx_setfont(8, "Courier New", ps(17), 'b');

out_m = max(outpk_disp, out_m * 0.85);  outpk_disp = 0;

// ---------- faceplate ----------
col(C_PANEL, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
nb_w != gfx_w || nb_h != gfx_h ? nb_build();
gfx_a = 1;  gfx_x = px(0);  gfx_y = py(0);  gfx_blit(120, 1, 0);                  // the nebula top bar
col(0x6E5A9E, 1);  u_rect(0, 58, 1100, 2);
col(shade(C_PANEL, 0.78), 1);  u_rect(0, 697, 1100, 3);  u_rect(1097, 0, 3, 700);
rivet(8, 8);  rivet(1092, 8);  rivet(8, 692);  rivet(1092, 692);
gfx_setfont(1);  col(0xFF7AC8, 0.16);                                                // a soft pink glow
j = 0;  loop(8, text_l(px(24) + ps(2.2) * cos(j * $pi / 4), py(23) + ps(2.2) * sin(j * $pi / 4), "SALEM");  j += 1; );
col(0xFFF4FB, 1);  text_l(px(24), py(23), "SALEM");
gfx_setfont(10);  col(0xE7B6FF, 1);  text_l(px(26), py(47), "MORPHING SYNTHESIZER");
gfx_setfont(4);  col(0xFFC2E8, 1);  text_l(px(1046), py(29), "GFX");

prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(560, 12, 34, 270, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > 18 ? 1 : pb_k; );

// ---------- sources ----------
source_panel(72, "SOURCE A", 0);
source_panel(268, "SOURCE B", 1);

// ---------- transform pad ----------
// 8 snapshot cells; the puck blends them (SNAP: how sharply each pulls, SLEW: how the puck glides).
// Click a cell's number: recall it (knobs + puck); with EDIT lit the knobs then edit that cell.
// STORE, then a number: the knobs into that cell. IN: the pad drives the morphed controls (cyan rings).
section(426, 72, 308, 384, C_SEC2, "TRANSFORM PAD");
col(0x8C99A6, 1);  u_rect(438, 96, 284, 172);  col(C_LCDBG, 1);  u_rect(440, 98, 280, 168);
ed_cell > 0 ? (                                                    // the puck left the cell: editing stops
  abs(pad_x - (((ed_cell - 1) % 4) + 0.5) / 4) > 0.002 || abs(pad_y - (floor((ed_cell - 1) / 4) + 0.5) / 2) > 0.002 ? ed_cell = 0;
);
pm_hold_d = ed_cell > 0;                                            // MOTION holds still while a cell is edited
u_hit = 0;  j = 0;
loop(8,
  u_x = 440 + (j % 4) * 70;  u_y = 98 + floor(j / 4) * 84;
  pad_on ? ( col(C_CYAN, 0.04 + 0.42 * WTS[j]);  u_rect(u_x + 3, u_y + 3, 64, 78); );
  col(C_LCDTX, ed_cell == j + 1 ? 0.95 : 0.2);
  u_w = ed_cell == j + 1 ? 2 : 1;
  u_rect(u_x + 3, u_y + 3, 64, u_w);  u_rect(u_x + 3, u_y + 81 - u_w, 64, u_w);
  u_rect(u_x + 3, u_y + 3, u_w, 78);  u_rect(u_x + 67 - u_w, u_y + 3, u_w, 78);
  // the number badge (a click target)
  u_hov = mouse_x >= px(u_x + 6) && mouse_x < px(u_x + 32) && mouse_y >= py(u_y + 6) && mouse_y < py(u_y + 28);
  col(store_arm ? LK_AMB : ed_cell == j + 1 ? C_LCDTX : 0x1C3550, store_arm ? 0.9 : 1);  u_rect(u_x + 6, u_y + 6, 26, 22);
  u_hov ? ( col(0xFFFFFF, 0.18);  u_rect(u_x + 6, u_y + 6, 26, 22); );
  gfx_setfont(7);  col(store_arm || ed_cell == j + 1 ? C_LCDBG : C_LCDTX, 1);  sprintf(#pn, "%d", j + 1);  text_c(px(u_x + 19), py(u_y + 17), #pn);
  click && u_hov ? (
    u_hit = 1;
    store_arm ? ( g_store(j);  store_arm = 0;  ed_cell = 0; ) : g_recall(j);
  );
  j += 1;
);
// the puck: drag anywhere else on the pad
u_in = mouse_x >= px(440) && mouse_x < px(720) && mouse_y >= py(98) && mouse_y < py(266);
click && u_in && !u_hit ? ( drag_idx = 1000;  ed_cell = 0; );
drag_idx == 1000 ? (
  u_v = max(0, min(1, (mouse_x - px(440)) / ps(280)));  u_v != pad_x ? ( slider(48) = u_v;  param_touched(48); );
  u_v = max(0, min(1, (mouse_y - py(98)) / ps(168)));   u_v != pad_y ? ( slider(49) = u_v;  param_touched(49); );
);
// MOTION's path, faintly, around where the puck was put
pad_on && pm_depth > 0.001 && !pm_hold_d ? (
  col(C_LCDTX, 0.22);  j = 0;
  loop(72,
    u_t = j / 72;
    pm_shape < 0.5 ? ( u_dx = cos(2 * $pi * u_t);  u_dy = sin(2 * $pi * u_t); ) :
    pm_shape < 1.5 ? ( u_dx = sin(2 * $pi * u_t);  u_dy = sin(4 * $pi * u_t); ) :
    pm_shape < 2.5 ? ( u_dx = sin(4 * $pi * u_t);  u_dy = sin(6 * $pi * u_t); ) : ( u_dx = 0;  u_dy = 0; );
    pm_shape < 2.5 ? (
      u_v = pad_x + u_dx * pm_depth * 0.5;  u_v < 0 ? u_v = -u_v;  u_v > 1 ? u_v = 2 - u_v;
      u_w = pad_y + u_dy * pm_depth * 0.5;  u_w < 0 ? u_w = -u_w;  u_w > 1 ? u_w = 2 - u_w;
      gfx_circle(px(440 + u_v * 280), py(98 + u_w * 168), ps(1), 1, 1);
    );
    j += 1;
  );
  pm_shape >= 2.5 ? ( gfx_circle(px(440 + pad_x * 280), py(98 + pad_y * 168), ps(pm_depth * 70), 0, 1); );   // DRIFT: its reach
);
u_px = 440 + (pad_on ? pxs : pad_x) * 280;  u_py = 98 + (pad_on ? pys : pad_y) * 168;
col(C_LCDTX, pad_on ? 0.25 : 0.12);  u_rect(u_px, 99, 1, 166);  u_rect(441, u_py, 278, 1);
col(C_LCDTX, pad_on ? 1 : 0.45);
gfx_circle(px(u_px), py(u_py), ps(9), 0, 1);  gfx_circle(px(u_px), py(u_py), ps(8), 0, 1);  gfx_circle(px(u_px), py(u_py), ps(3), 1, 1);
pad_on && (abs(pad_x * 280 + 440 - u_px) > 2 || abs(pad_y * 168 + 98 - u_py) > 2) ? (
  col(C_LCDTX, 0.6);  gfx_circle(px(440 + pad_x * 280), py(98 + pad_y * 168), ps(2.5), 1, 1);   // where the puck was put
);
store_arm ? ( gfx_setfont(5);  col(LK_AMB, 1);  text_c(px(580), py(258), "STORE: CLICK A NUMBER"); );
// A / B mix (a morphed control): drag along the track
u_lk = pad_on && !(ed_on && ed_cell > 0);
u_v = u_lk ? (drag_idx == 46 ? kd_last : EP[8]) : ab_mix;
u_hov = mouse_x >= px(456) && mouse_x < px(704) && mouse_y >= py(272) && mouse_y < py(300);
click && u_hov ? (
  now_t = time_precise();
  (mouse_cap & 4) || (last_click_idx == 46 && now_t - last_click_t < 0.3) ? (
    u_lk ? sn_shift(8, 0.5, EP[8]);  slider(46) = 0.5;  param_touched(46);  drag_idx = 0;
  ) : ( drag_idx = 46;  drag_x = mouse_x;  drag_t = u_v;  kd_last = u_v; );
  last_click_idx = 46;  last_click_t = now_t;
);
drag_idx == 46 ? (
  u_v = max(0, min(1, drag_t + (mouse_x - drag_x) / ps(236)));  u_v = floor(u_v * 1000 + 0.5) / 1000;
  u_v != kd_last ? (
    u_lk ? sn_shift(8, u_v, kd_last);
    kd_last = u_v;  slider(46) = u_v;  param_touched(46);
    b_on < 0.5 ? ( slider(45) = 1;  param_touched(45); );          // moving the mix brings Source B in
  );
);
u_a = b_on >= 0.5 ? 1 : 0.4;
col(0x2A3A4E, u_a);  u_rect(462, 283, 236, 6);  col(0x0E1824, u_a);  u_rect(464, 285, 232, 2);
u_x = 462 + u_v * 236;
u_lk ? ( col(C_CYAN, 0.85);  u_rect(u_x - 10, 272, 20, 1);  u_rect(u_x - 10, 299, 20, 1); );
col(0x24364D, 0.3 * u_a);  u_rect(u_x - 6, 277, 16, 22);
col(C_SILV, u_a);  u_rect(u_x - 8, 275, 16, 22);  col(C_CYAN, u_a);  u_rect(u_x - 1, 275, 2, 22);
gfx_setfont(6);  col(C_BLUE, u_a);  text_c(px(448), py(286), "A");  text_c(px(712), py(286), "B");
col(C_INK, 1);  text_c(px(580), py(311), b_on >= 0.5 ? "A / B MIX" : "A / B MIX  (B IS OFF)");
(u_hov || drag_idx == 46) ? ( sprintf(#kp, u_lk ? "PAD  A %d / B %d" : "A %d / B %d", (1 - u_v) * 100 + 0.5, u_v * 100 + 0.5);  hover_tag(px(u_x), py(262), #kp); );
// the pad's own controls (left) and MOTION (right)
col(C_EDGE, 1);  u_rect(586, 330, 1, 104);
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(654), py(331), "MOTION");
kn(470, 356, 15, 50, 0, 1, 0.3, C_CAPW, C_INK, "SNAP", 1, 0);
kn(538, 356, 15, 51, 0, 2000, 200, C_CAPW, C_INK, "SLEW", 3, 0);
klog = 1;  kn(626, 360, 15, 72, 0.02, 8, 0.25, C_CAPW, C_INK, "SPEED", 10, 0);
kn(686, 360, 15, 73, 0, 1, 0, C_CYAN, 0xFFFFFF, "MOVE", 1, 0);
lk_key(440, 404, 44, 28, ed_on, LK_SKY, "EDIT") ? ( ed_on = !ed_on; );
lk_key(490, 404, 50, 28, store_arm, LK_YEL, "STORE") ? ( store_arm = !store_arm; );
lk_key(546, 404, 34, 28, pad_on >= 0.5, LK_AMB, "IN") ? ( slider(47) = pad_on >= 0.5 ? 0 : 1;  param_touched(47); );
u_k = floor(pm_shape + 0.5);
lcd(596, 404, 124, 28, 7, u_k == 0 ? "CIRCLE" : u_k == 1 ? "FIGURE 8" : u_k == 2 ? "LISSAJOUS" : "DRIFT");
click && mouse_x >= px(596) && mouse_x < px(720) && mouse_y >= py(404) && mouse_y < py(432) ? (
  gfx_x = px(596);  gfx_y = py(432);
  u_k = gfx_showmenu(u_k == 0 ? "!Circle|Figure 8|Lissajous|Drift" : u_k == 1 ? "Circle|!Figure 8|Lissajous|Drift" : u_k == 2 ? "Circle|Figure 8|!Lissajous|Drift" : "Circle|Figure 8|Lissajous|!Drift");
  u_k > 0 ? ( slider(74) = u_k - 1;  param_touched(74); );
);

