  p == 17 ? ( slider(1) = 0;  slider(2) = 0.15;  slider(3) = 0.6;  slider(4) = 2600;  slider(5) = 0.2;  slider(6) = 1;  slider(7) = 0.5;  slider(8) = 0;  slider(9) = 2;  slider(10) = 600;  slider(11) = 50;  slider(12) = 300;  slider(13) = 3;  slider(14) = 600;  slider(15) = 80;  slider(16) = 350;  slider(17) = 0.6;  slider(18) = 60;  slider(19) = 2;  slider(20) = 50;  slider(21) = -6;  slider(22) = 2;  slider(23) = 6;  slider(24) = 50;  slider(25) = 0;  slider(26) = 2;  slider(30) = 1;  slider(31) = 0;  slider(34) = 0;  slider(43) = 12;  slider(45) = 1;  slider(46) = 0.25;  slider(47) = 1;  slider(48) = 0.125;  slider(49) = 0.25;  slider(50) = 0.5;  slider(51) = 150;  slider(57) = 1;  slider(60) = 8;  slider(61) = 0.4;  slider(64) = 0.22;  slider(66) = 1;  slider(70) = 0.18;  slider(72) = 0.3;  slider(73) = 0.35;  slider(74) = 1;  g_sn_fill();  sn_put(2, 3, 2);  sn_put(2, 9, 3000);  sn_put(3, 3, 4);  sn_put(3, 9, 3400);  sn_put(4, 3, 6);  sn_put(4, 9, 3800);  sn_put(4, 8, 0.35);  sn_put(5, 3, 1);  sn_put(5, 9, 2200);  sn_put(5, 8, 0.15);  sn_put(6, 3, 3);  sn_put(6, 9, 2600);  sn_put(7, 3, 5);  sn_put(7, 9, 3200);  sn_put(7, 10, 0.35);  sn_put(8, 3, 7);  sn_put(8, 9, 4200);  sn_put(8, 8, 0.4); ) :   // Vowel Lead
  p == 18 ? ( slider(1) = 0;  slider(2) = 0.15;  slider(3) = 0.6;  slider(4) = 8000;  slider(5) = 0.1;  slider(6) = 0.5;  slider(7) = 0.5;  slider(8) = 0;  slider(9) = 2;  slider(10) = 800;  slider(11) = 80;  slider(12) = 600;  slider(13) = 2;  slider(14) = 800;  slider(15) = 85;  slider(16) = 500;  slider(17) = 0.4;  slider(18) = 0;  slider(19) = 2;  slider(20) = 50;  slider(21) = -8;  slider(22) = 1;  slider(23) = 12;  slider(24) = 70;  slider(25) = 0;  slider(26) = 1;  slider(27) = 0.8;  slider(28) = 0.3;  slider(34) = 2;  slider(39) = 2;  slider(40) = 0;  slider(45) = 1;  slider(46) = 0;  slider(47) = 1;  slider(48) = 0.125;  slider(49) = 0.25;  slider(50) = 0.4;  slider(51) = 300;  slider(66) = 1;  slider(67) = 0.5;  slider(68) = 2.5;  slider(70) = 0.25;  g_sn_fill();  sn_put(2, 8, 0.3);  sn_put(2, 1, 1.2);  sn_put(2, 7, 2);  sn_put(3, 8, 0.6);  sn_put(3, 1, 1.6);  sn_put(3, 7, 5);  sn_put(4, 8, 1);  sn_put(4, 7, 7);  sn_put(5, 2, 1);  sn_put(5, 1, 1.4);  sn_put(5, 9, 4000);  sn_put(6, 8, 0.4);  sn_put(6, 2, 0.6);  sn_put(6, 7, 3);  sn_put(6, 9, 5000);  sn_put(7, 8, 0.75);  sn_put(7, 7, 6);  sn_put(7, 9, 6000);  sn_put(8, 8, 0.5);  sn_put(8, 1, 2.2);  sn_put(8, 7, 4);  sn_put(8, 9, 3000);  sn_put(8, 10, 0.3); ) :   // Bell Organ
