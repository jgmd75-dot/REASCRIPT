// OUT meter, -48 .. 0 dB, with a floating peak hold (1.5 s, then it falls) and its figure; CLIP lamp
u_db = out_m > 0.000001 ? 8.685889638065035 * log(out_m) : -120;
u_now = time_precise();
u_db >= pk_db || u_now - pk_t > 1.5 ? (
  u_db >= pk_db ? ( pk_db = u_db;  pk_t = u_now; ) : pk_db = max(u_db, pk_db - 20 * (u_now - pk_last));
);
pk_last = u_now;
col(0x141815, 1);  u_rect(1043, 497, 20, 146);
j = 0;
loop(24,
  u_d = -48 + (j + 1) * 2;
  col(u_d > -1 ? 0xE0503A : u_d > -6 ? 0x2E7BE0 : C_CYAN, u_db >= u_d - 2 ? 1 : 0.14);
  u_rect(1046, 640 - (j + 1) * 140 / 24 + 1, 14, 140 / 24 - 1.5);
  j += 1;
);
pk_db > -48 ? (
  u_y = 640 - (min(pk_db, 0) + 48) / 48 * 140;
  col(0xFFFFFF, 0.95);  u_rect(1045, u_y - 1, 16, 2);
);
gfx_setfont(5);  col(C_INK, 1);
pk_db > -48 ? sprintf(#pk, "%.1f", min(pk_db, 0)) : strcpy(#pk, "-inf");
text_c(px(1053), py(481), #pk);
clip_d ? ( clip_t = u_now;  clip_d = 0; );
u_on = u_now - clip_t < 0.4;
col(u_on ? 0xFF4A30 : 0x5A2620, 1);  gfx_circle(px(1024), py(481), ps(4), 1, 1);
u_on ? ( col(0xFF4A30, 0.3);  gfx_circle(px(1024), py(481), ps(7), 1, 1); );
gfx_setfont(6);  col(C_INK, 1);  text_c(px(1053), py(656), "OUT");

