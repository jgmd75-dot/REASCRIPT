section(866, 466, 218, 220, C_SEC2, "MASTER");
u_t = drift / 100;
col(C_CYAN, 0.25);  gfx_arc(px(902), py(536), ps(23), -0.75 * $pi, -0.75 * $pi + u_t * 1.5 * $pi, 1);
col(C_CYAN, 0.6);   gfx_arc(px(902), py(536), ps(22), -0.75 * $pi, -0.75 * $pi + u_t * 1.5 * $pi, 1);
kn(902, 540, 16, 20, 0, 100, 50, C_CAPW, C_INK, "DRIFT", 4, 0);
