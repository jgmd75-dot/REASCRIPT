lk_font = lk_font2 = 14;

// ---------- the meters plate ----------
bw_plate(16, 368, 1048, 116);
ui_kdesk = 0x4A5552; ui_kdesk_r = 16; ui_knob(52 * sc, 400 * sc, 25, -24, 12, 0, 0, "TRIM", "%+.1f dB"); ui_kdesk = 0; ui_kdesk_r = 0;
lk_font = lk_font2 = 13; bw_key(24, 448, 56, 24, 26, LK_AMB, "GUARD"); lk_font = lk_font2 = 14;
bw_kn(124, 404, 14, 28, 0, 100, 50, 0, 0x8A5A2E, "DRIFT", "%.0f %%");
// GR: PRE-COMP, MAIN, LIMIT
gfx_setfont(13); ui_col(DIM); bw_tl(176, 378, "GAIN REDUCTION (dB)");
ui_col(INK); bw_tl(176, 398, "PRE-COMP"); bw_tl(176, 420, "MAIN"); bw_tl(176, 442, "LIMIT");
bw_gr(248, 400, 190, 12, bw_grp, 0xF2A41E);
bw_gr(248, 422, 190, 12, bw_grm, 0xE0463A);
bw_gr(248, 444, 190, 12, bw_grl, 0xF2D84A);
ui_col(DIM); bw_i = 0;
loop(5, bw_n = bw_i == 0 ? 0 : bw_i == 1 ? 3 : bw_i == 2 ? 6 : bw_i == 3 ? 10 : 20;
  sprintf(#bw_s, "%d", bw_n); bw_tc(248 + bw_n * 9.5 - (bw_n == 20 ? 6 : 0) + (bw_n == 0 ? 4 : 0), 462, #bw_s); bw_i += 1; );
// IN and OUT: L and R rows each
gfx_setfont(13); ui_col(DIM); bw_tl(466, 378, "IN (dBFS)"); bw_tl(720, 378, "OUT (dBFS)");
ui_col(INK); bw_tl(466, 403, "L"); bw_tl(466, 431, "R"); bw_tl(720, 403, "L"); bw_tl(720, 431, "R");
mIL.ui_ledm(484 * sc, 404 * sc, 206 * sc, 14 * sc, bw_il); mIR.ui_ledm(484 * sc, 432 * sc, 206 * sc, 14 * sc, bw_ir);
