// PARALLEL EQ (checkpoint 3)
bw_kn(690, 170, 22, 15, 0, 6, 0, 0, 0x6B4A2E, "BODY", "+%.1f dB");
bw_kn(782, 176, 16, 16, 100, 800, 250, 1, 0x6B4A2E, "FREQ", "%.0f Hz");
bw_kn(690, 280, 22, 17, 0, 6, 0, 0, 0xA8382E, "OPEN", "+%.1f dB");
bw_v = bw_box(740, 272, 84, 30, "FREQ", "2.5 kHz|5 kHz|10 kHz|20 kHz|40 kHz", open_f); bw_v >= 0 ? ( open_f = bw_v; ui_auto(18); );

// OUTPUT
bw_kn(888, 182, 22, 20, -12, 0, -1, 0, SEAG, "CEILING", "%.1f dB");
bw_kn(962, 184, 20, 23, 0, 100, 100, 0, BRASS, "MIX", "%.0f %%");
bw_kn(1030, 184, 20, 24, -12, 12, 0, 0, BRASS, "OUTPUT", "%+.1f dB");
bw_zero(1030, 184, 20, 0.5);
bw_key(856, 262, 72, 32, 21, LK_BLU_LT, "BRICK");
gfx_setfont(13); ui_col(DIM);
bw_tl(940, 266, brick ? "TRUE PEAK" : "SOFT KNEE"); bw_tl(940, 282, brick ? "LOOK-AHEAD" : "NO LOOK-AHEAD");
sprintf(#bw_s, "LATENCY %d SAMPLES", lat_disp); bw_tc(950, 322, #bw_s);

// sections still to come, and switched-off ones (greyed, IN keys on top)
!edge_in ? ( ui_cola(PL, 0.5); bw_r(17, 114, 188, 236); );
!peq_in ? ( ui_cola(PL, 0.5); bw_r(637, 114, 198, 236); );
!lim_in ? ( ui_cola(PL, 0.5); bw_r(837, 114, 100, 116); bw_r(837, 230, 226, 120); );   // CEILING and the limiter row below (an L, no overlap)
!main_in ? ( ui_cola(PL, 0.5); bw_r(207, 114, 428, 236); );
lk_font = lk_font2 = 13;
bw_key(146, 86, 52, 22, 14, LK_AMB, "IN");
bw_key(576, 86, 52, 22, 10, LK_AMB, "IN");
bw_key(776, 86, 52, 22, 19, LK_AMB, "IN");
