// ---------- header art: a rope knot in the gap before BYPASS (JG, 25 Oct 2026) ----------
// drawn once per scale at 2x into image 117 (anti-aliased circles), then blitted back at half size; 55 % size
// a point on the rope's path (u = 0 .. 1) -> ka_x, ka_y
function ka_pt(u) local(t, d) (
  u < 0.14 ? ( ka_x = 30 + (71 - 30) * u / 0.14; ka_y = 30; ) :
  u > 0.86 ? ( ka_x = 159 + (200 - 159) * (u - 0.86) / 0.14; ka_y = 30; ) : (
    t = $pi + 3 * $pi * (u - 0.14) / 0.72; d = 1 + sqr(sin(t));
    ka_x = 115 + 44 * cos(t) / d; ka_y = 30 + 64 * sin(t) * cos(t) / d;
  );
);
ka_x0 = 596; ka_y0 = 2; ka_w = 230; ka_h = 60; ka_z = 0.55;
ka_sc != sc ? (
  ka_sc = sc; ka_k = 2 * sc * ka_z; ka_iw = ceil(ka_w * ka_k) + 2; ka_ih = ceil(ka_h * ka_k) + 2;
  gfx_setimgdim(117, ka_iw, ka_ih); gfx_dest = 117; gfx_mode = 0;
  gfx_a = 1; gfx_a2 = 0; gfx_rect(0, 0, ka_iw, ka_ih); gfx_a2 = 1;
  // the rope's path: in from the left, a figure-of-eight knot (one and a half turns of a lemniscate), out to the
  // right, laid in three pieces. Each piece in passes: dark rim (not at its start, so the joins don't show), body,
  // the shaded underside, the lit top, then the strands' lay as slanted lines - a later piece sits on top where
  // it crosses
  ka_p = 0;
  loop(3,
    ka_u0 = ka_p == 0 ? 0 : 0.14 + 0.24 * ka_p; ka_u1 = ka_p == 2 ? 1 : 0.14 + 0.24 * (ka_p + 1);
    ka_q = 0;
    loop(5,
      ka_i = 0; ka_s = 0; ka_ln = -1;
      loop(400,
        ka_u = ka_u0 + (ka_u1 - ka_u0) * ka_i / 399;
        ka_pt(min(ka_u + 0.0005, 1)); ka_tx = ka_x; ka_ty = ka_y;
        ka_pt(max(ka_u - 0.0005, 0)); ka_tx -= ka_x; ka_ty -= ka_y;
        ka_d = sqrt(ka_tx * ka_tx + ka_ty * ka_ty); ka_tx /= ka_d; ka_ty /= ka_d;
        // the normal, scaled by how much it faces the light (top left): lit top and shaded underside move smoothly
        ka_nx = ka_ty; ka_ny = -ka_tx; ka_l = -0.45 * ka_nx - 0.89 * ka_ny; ka_lx = ka_nx * ka_l; ka_ly = ka_ny * ka_l;
        ka_pt(ka_u);
        ka_i > 0 ? ka_s += sqrt(sqr(ka_x - ka_px) + sqr(ka_y - ka_py)); ka_px = ka_x; ka_py = ka_y;
        ka_q == 0 ? (
          (ka_p == 0 || ka_i > 40) ? ( ui_col(0x2A1E10); gfx_circle(ka_x * ka_k, ka_y * ka_k, 6.6 * ka_k, 1, 0); );
        ) : ka_q == 1 ? (
          ui_col(0xC9A86C); gfx_circle(ka_x * ka_k, ka_y * ka_k, 5.4 * ka_k, 1, 1);
        ) : ka_q == 2 ? (
          ui_col(0x9C7C48); gfx_circle((ka_x - 2.7 * ka_lx) * ka_k, (ka_y - 2.7 * ka_ly) * ka_k, 2.6 * ka_k, 1, 1);
        ) : ka_q == 3 ? (
          ui_col(0xF0DDB0); gfx_circle((ka_x + 2.4 * ka_lx) * ka_k, (ka_y + 2.4 * ka_ly) * ka_k, 1.6 * ka_k, 1, 1);
        ) : (
          floor(ka_s / 3.4) != ka_ln ? (
            ka_ln = floor(ka_s / 3.4);
            ui_col(0x6E5230); gfx_a = 0.75;
            gfx_line((ka_x + 4.2 * ka_nx + 1.8 * ka_tx) * ka_k, (ka_y + 4.2 * ka_ny + 1.8 * ka_ty) * ka_k,
                     (ka_x - 4.2 * ka_nx - 1.8 * ka_tx) * ka_k, (ka_y - 4.2 * ka_ny - 1.8 * ka_ty) * ka_k, 1);
            gfx_line((ka_x + 4.2 * ka_nx + 1.8 * ka_tx) * ka_k + 1, (ka_y + 4.2 * ka_ny + 1.8 * ka_ty) * ka_k,
                     (ka_x - 4.2 * ka_nx - 1.8 * ka_tx) * ka_k + 1, (ka_y - 4.2 * ka_ny - 1.8 * ka_ty) * ka_k, 1);
            gfx_a = 1;
          );
        );
        ka_i += 1;
      );
      ka_q += 1;
    );
    ka_p += 1;
  );
  // whipped ends
  // whippings: a band of red twine a little in from each end, its turns marked
  ka_i = 0;
  loop(2,
    ka_bx = ka_i == 0 ? 30 : 194;
    ui_col(0x8A2A22); gfx_rect(ka_bx * ka_k, 24.8 * ka_k, 6 * ka_k, 10.4 * ka_k);
    ui_col(0xC0584A); gfx_rect(ka_bx * ka_k, 26.2 * ka_k, 6 * ka_k, 1.6 * ka_k);
    ui_col(0x4A1410); ka_j = 1; loop(3, gfx_rect((ka_bx + ka_j * 1.5) * ka_k, 24.8 * ka_k, max(1, 0.4 * ka_k), 10.4 * ka_k); ka_j += 1; );
    ka_i += 1;
  );
  gfx_dest = -1;
);
gfx_a = 1; gfx_mode = 0; gfx_blit(117, 1, 0, 0, 0, ka_iw, ka_ih, (ka_x0 + ka_w * (1 - ka_z) / 2) * sc, (ka_y0 + ka_h * (1 - ka_z) / 2) * sc, ka_iw / 2, ka_ih / 2);

// ---------- the controls plate ----------
