gfx_setfont(13); ui_col(DIM);
bw_tc(484 + 206 * 2 / 15, 452, "-36"); bw_tc(484 + 206 * 6 / 15, 452, "-24"); bw_tc(484 + 206 * 10 / 15, 452, "-12"); bw_tc(484 + 206 * 14 / 15, 452, "0");
bw_tc(738 + 230 * 2 / 15, 452, "-36"); bw_tc(738 + 230 * 6 / 15, 452, "-24"); bw_tc(738 + 230 * 10 / 15, 452, "-12"); bw_tc(738 + 230 * 14 / 15, 452, "0");
bw_pk = max(mOL.hold, mOR.hold);
gfx_setfont(15); ui_col(bw_pk > -0.05 ? 0xFF5A4A : INK);
bw_pk > -60 ? sprintf(#bw_s, bw_pk > 0.05 ? "+%.1f" : "%.1f", bw_pk) : strcpy(#bw_s, "--"); bw_tr(1048, 412, #bw_s);
gfx_setfont(13); ui_col(DIM); bw_tr(1048, 440, "PEAK");

