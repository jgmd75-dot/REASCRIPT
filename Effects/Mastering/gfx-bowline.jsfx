bw_v = bw_box(46, 264, 120, 30, "FREQUENCY", "2 kHz|3 kHz|4.5 kHz", edge_f); bw_v >= 0 ? ( edge_f = bw_v; ui_auto(13); );

// MAIN COMPRESSOR
