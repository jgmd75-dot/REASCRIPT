bw_v = bw_box(226, 264, 92, 30, "RANGE", "4 dB|8 dB|12 dB|16 dB", range_i); bw_v >= 0 ? ( range_i = bw_v; ui_auto(3); );
bw_v = bw_box(334, 264, 92, 30, "SC HPF", "OFF|40 Hz|80 Hz|120 Hz|220 Hz", schpf); bw_v >= 0 ? ( schpf = bw_v; ui_auto(7); );
bw_key(446, 262, 72, 32, 6, LK_AMB, "AUTO");
