desc:Bowline [mastering compressor] (GFX)
//tags: compressor serial precomp mastering bus dynamic eq parallel limiter
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-ui, gfx-panel and gfx-os (.jsfx-inc) in the same folder.
//
// Bowline. A mastering compressor in the spirit of the modern serial (two-stage) mastering compressors: a small, quick PRE-COMP stage
// that only bites on harsh build-ups around 3 kHz, so the MAIN compressor never over-reacts to a vocal crack or a
// snare, then a PARALLEL EQ that brings back presence and air instead of plain make-up gain, then a soft limiter.
// Named after the knot that holds under load and still unties easily.
//
// SIGNAL FLOW
//   input -> TRIM (+ optional GUARD) -> PRE-COMP -> MAIN COMPRESSOR -> PARALLEL EQ -> MIX with the input -> OUTPUT
//   -> [oversampled: VALVE + DC blocker + SOFT LIMITER] -> BRICKWALL (when chosen) -> out.
// PRE-COMP: a dynamic bell that only turns down the harsh region when it pokes out - a vocal crack, a snare's bite,
//   a hard cymbal - so the MAIN compressor never over-reacts to it. FREQUENCY 2 / 3 / 4.5 kHz (an octave-wide bell,
//   glided), THRESHOLD -40 .. 0 dBFS on the band's own level, AMOUNT 0 - 8 dB = the deepest it can cut (4 : 1 above
//   the threshold, easing into that limit). Soft knee: 12 dB wide with THRESHOLD fully up, hardening gradually to
//   6 dB as THRESHOLD comes down to -40 (it starts early and gently when set light, firmer when set deep). Fixed fast timing (1 ms attack, 80 ms release). It follows LINK: linked =
//   the same cut on both sides. Below the threshold the bell is flat: nothing changes. Zero latency.
// MAIN COMPRESSOR: feed-forward, soft knee (6 dB).
//   THRESHOLD -40 .. 0 dBFS (the "0" marks -18 dBFS = 0 VU). RATIO 1.3 : 1 .. 13 : 1 (glided).
//   RANGE 4 / 8 / 12 / 16 dB: the most it can ever take off - the gain reduction eases into that limit, so heavy
//   ratios stay musical and the master never gets crushed past it.
//   ATTACK 1 - 200 ms, RELEASE 50 ms - 2 s or AUTO (a fast release for short peaks plus a slow one that only builds
//   up under sustained compression).
//   SC HPF (off / 40 / 80 / 120 / 220 Hz, 12 dB/oct, glided) keeps the kick from pumping the mix.
//   RMS: the detector reads the average level (15 ms, scaled so a steady sine compresses at the same THRESHOLD as
//   in PEAK) and lets short transients through. LINK on = one gain for both sides (the image never moves), off =
//   each side its own (glided 10 ms).
// PARALLEL EQ: make-up that brings back what heavy compression dulls, built as filtered copies of the compressed
//   signal added back on top (boost only, so it can only lift). BODY: a broad bell (Q 0.7), 0 - +6 dB, FREQ
//   100 - 800 Hz. OPEN: a gentle first-order shelf, 0 - +6 dB, its corner at 2.5 / 5 / 10 / 20 / 40 kHz - the
//   high corners still lift the audible top a little and keep rising past it (air without fizz; the 40 kHz corner
//   is matched to the analogue curve, not cramped at the top of the band). At 0 dB nothing is added. Zero latency.
// MIX (0 - 100 %): parallel compression - the compressed sound against the input (after TRIM).
// OUTPUT: -12 .. +12 dB, the make-up and the final level.
// VALVE (always on): a gentle valve stage - mostly 2nd harmonic, rising with level: about -0.4 dB of rounding on
//   full-scale peaks, nothing you'd hear on quiet material.
// LIMITER (LIMITER IN): CEILING -12 .. 0 dBFS.
//   SOFT: a soft-knee limiter with no look-ahead (latency only from OS) - flat up to 3 dB under the CEILING, then
//   rounding the peaks into it; no sample passes the CEILING (at 2x / 4x a last clamp catches the ring of the
//   down-sampling filter). Peaks between samples can: choose BRICK for a true-peak ceiling.
//   BRICK: 1.5 ms look-ahead and a true-peak detector (8x, 24-tap): the gain is down before a peak arrives, so
//   neither the samples nor the peaks between them pass the CEILING. Latency 1.5 ms + 12 samples (84 at 48 kHz).
// OS (1x / 2x / 4x, default 1x): the VALVE and the SOFT limiter run at the chosen rate (gfx-os). The rest runs
//   at 1x. Changing it, or LIMITER IN / BRICK when that changes the latency, dips the sound for 5 ms and swaps at
//   the silent point.
// DRIFT (0 - 100 %, 50 % = standard): valve heat. As the unit warms and cools, the MAIN threshold wanders slowly by
//   up to +/-0.4 dB and the release breathes by up to +/-12 % (each side a little differently when LINK is off);
//   the VALVE's drive wanders by up to +/-1.5 dB and its bias (the 2nd harmonic) with it.
// BYPASS (top bar): crossfades to the dry input (15 ms), kept in time with the latency.
// METERS: GR = PRE-COMP (amber), MAIN (red) and LIMIT (yellow), 0 - 20 dB; IN and OUT = an LED row each for L and R
//   (-42 .. +3 dBFS, 1.2 s floating peak hold); the OUT peak figure beside them - click a meter to clear it.
// GUI: drag a knob (SHIFT = fine), wheel, double-click = default; values show while a knob is touched. Display
//   boxes: click for the list. Keys light when on. S / M / L / ? = size and help.
// PRESETS: Init, Gentle Glue, Master Control, Vocal Bus, Drum Bus, Parallel Crush, Warm Mix Bus, Loud Master,
//   Acoustic Polish, Bass Control, De-Harsh, Broadcast Ready, Streaming Master, Big Room Drums (TRIM, GUARD, DRIFT, OS and
//   BYPASS stay as they are).
// Latency: 0 / 31 / 37 samples at 1x / 2x / 4x; BRICK adds 1.5 ms + 12 samples (84 at 48 kHz); reported. Stereo pins are declared, so on a multichannel track REAPER carries channels 3 and
//   up round the unit and keeps them in time.

slider1:thr_db=-18<-40,0,0.1>-Threshold (dB)
slider2:ratio=2<1.3,13,0.01>-Ratio
slider3:range_i=1<0,3,1{4 dB,8 dB,12 dB,16 dB}>-Range
slider4:att_ms=20<1,200,0.1>-Attack (ms)
slider5:rel_ms=300<50,2000,1>-Release (ms)
slider6:rel_auto=0<0,1,1{Off,On}>-Auto release
slider7:schpf=0<0,4,1{Off,40 Hz,80 Hz,120 Hz,220 Hz}>-SC HPF
slider8:rmsdet=0<0,1,1{Peak,RMS}>-Detector level
slider9:lnk=1<0,1,1{Off,On}>-Link
slider10:main_in=1<0,1,1{Out,In}>-Main compressor
slider11:edge_thr=-24<-40,0,0.1>-Pre-comp threshold (dB)
slider12:edge_amt=4<0,8,0.1>-Pre-comp amount (dB)
slider13:edge_f=1<0,2,1{2 kHz,3 kHz,4.5 kHz}>-Pre-comp frequency
slider14:edge_in=1<0,1,1{Out,In}>-Pre-comp
slider15:body_db=0<0,6,0.1>-Body (dB)
slider16:body_f=250<100,800,1>-Body frequency (Hz)
slider17:open_db=0<0,6,0.1>-Open (dB)
slider18:open_f=2<0,4,1{2.5 kHz,5 kHz,10 kHz,20 kHz,40 kHz}>-Open frequency
slider19:peq_in=1<0,1,1{Out,In}>-Parallel EQ
slider20:lim_ceil=-1<-12,0,0.1>-Limiter ceiling (dB)
slider21:brick=0<0,1,1{Soft,Brickwall}>-Limiter type
slider22:lim_in=0<0,1,1{Out,In}>-Limiter
slider23:mix_pc=100<0,100,1>-Mix (%)
slider24:out_db=0<-12,12,0.1>-Output (dB)
slider25:trim_db=0<-24,12,0.1>-Input trim (dB)
slider26:guard=0<0,1,1{Off,On}>-Guard
slider27:byp=0<0,1,1{Off,On}>-Bypass
slider28:drift=50<0,100,1>-Drift (%)
slider29:os_sl=0<0,2,1{1x,2x,4x}>-Oversampling
slider30:prs_sel=0<0,14,1{No preset,Init,Gentle Glue,Master Control,Vocal Bus,Drum Bus,Parallel Crush,Warm Mix Bus,Loud Master,Acoustic Polish,Bass Control,De-Harsh,Broadcast Ready,Streaming Master,Big Room Drums}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-os.jsfx-inc

@init
#ui_man = "gfx-bowline";
ext_noinit = 1;

DLINE = 10000;                                // BRICK audio delay, L / R (1024 each)
GHIST = 12100;                                // look-ahead gain history for the moving average
DQV = 13200; DQI = 14300;                     // sliding-minimum queue (values, times)
TPK = 15400;                                  // true-peak interpolator taps: 7 phases x 24
TPH = 15600;                                  // true-peak histories, L / R (64 each)
DRY = 16000;                                  // the dry input delayed by the latency, L / R (1024 each)
RMASK = 1023;

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(g) ( log(max(g, 0.000000001)) * 8.685889638065035; );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );

// TPT state-variable high-pass (12 dB/oct, Q 0.707) for the side-chain; its cutoff word sc_gw is glided
function svf_hp(x) instance(s1, s2) local(hp, v1, v2, bp) (
  hp = (x - (sc_gw + 1.4142135623730951) * s1 - s2) * sc_h;
  v1 = sc_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = sc_gw * bp; s2 = s2 + 2 * v2;
  hp;
);
// PRE-COMP's bell: a TPT state-variable band-pass on its own (glided) cutoff word pc_gw, damping pc_k; returns the
// band normalised to unity at the centre. The bell is then x + (G - 1) * band (G = the cut, 1 = flat).
function svf_bp(x) instance(s1, s2) local(hp, v1, bp, v2) (
  hp = (x - (pc_gw + pc_k) * s1 - s2) * pc_h;
  v1 = pc_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = pc_gw * bp; s2 = s2 + 2 * v2;
  pc_k * bp;
);
// static curve: dB over threshold -> dB of reduction (slope, knee width)
function gcurve(o, sl, kw) (
  o <= -0.5 * kw ? 0 : o >= 0.5 * kw ? o * sl : sl * sqr(o + 0.5 * kw) / (2 * kw);
);
// RANGE: the reduction eases into its limit r (straight up to half of it, then bending towards r)
function rcap(g, r) local(x) (
  x = g / r;
  x <= 0.5 ? g : r * (0.5 + 0.5 * (1 - exp(-2 * (x - 0.5))));
);

// PARALLEL EQ: BODY's band (a TPT band-pass on bd_gw, Q 0.7, unity at the centre) and OPEN's first-order high-pass
// (on op_gw, matched to the analogue curve near the top of the band)
function bd_bp(x) instance(s1, s2) local(hp, v1, bp, v2) (
  hp = (x - (bd_gw + 1.4142135623730951) * s1 - s2) * bd_h;
  v1 = bd_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = bd_gw * bp; s2 = s2 + 2 * v2;
  1.4142135623730951 * bp;
);
function op_hp(x) instance(s) local(v, lp) ( v = (x - s) * op_gw / (1 + op_gw); lp = v + s; s = lp + v; x - lp; );
// smooth saturator: x (27 + x^2) / (27 + 9 x^2), flat from |x| = 3
function sat3(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function sat3d(b) ( (sat3(b + 0.0001) - sat3(b - 0.0001)) * 5000; );
// one oversampled sample through the VALVE (unity for small signals: the curve's slope at the bias is divided out),
// its DC blocker (5 Hz, before the limiter so the ceiling holds) and the SOFT limiter (flat to 3 dB under the
// ceiling, then t / (1 + t) into it: never past it)
function vs_run(x) instance(dx, dy) local(a, t, k) (
  x = (sat3(vh_k * x + vh_b) - vh_o) * vh_n;
  a = x - dx + dc_co * dy; dx = x; dy = a; x = a;
  a = abs(x); k = 0.7079457843841379 * sl_c;
  a > k && sl_w > 0 ? (
    t = (a - k) / (sl_c - k);
    x += ((x > 0 ? 1 : -1) * (k + (sl_c - k) * t / (1 + t)) - x) * sl_w;
  );
  x;
);
// true-peak interpolator: 24-tap Kaiser-windowed sinc (beta 6) at the seven 8x points between taps 11 and 12
function bessel_i0(x) local(s, t, k) (
  s = t = 1; k = 1;
  loop(30, t *= (x * 0.5 / k) * (x * 0.5 / k); s += t; k += 1; );
  s;
);
function tp_design() local(p, k, t, w, x, s, i0b) (
  i0b = bessel_i0(6);
  p = 0;
  loop(7,
    s = 0; k = 0;
    loop(24,
      t = (k - 11) - (p + 1) * 0.125;
      x = t / 12.5; w = abs(x) < 1 ? bessel_i0(6 * sqrt(1 - x * x)) / i0b : 0;
      TPK[p * 24 + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
      s += TPK[p * 24 + k]; k += 1;
    );
    k = 0; loop(24, TPK[p * 24 + k] /= s; k += 1; );
    p += 1;
  );
);
// one new sample into channel ch's history -> the largest of samples n-12, n-11 and the seven 8x points between
function tp_peak(ch, x) local(h, b, p, m, y) (
  h = TPH + ch * 64 + (tp_w % 24);
  h[0] = x; h[24] = x;
  h = TPH + ch * 64 + ((tp_w + 1) % 24);
  m = max(abs(h[11]), abs(h[12])); p = 0;
  loop(7,
    b = TPK + p * 24;
    y = b[0] * h[0] + b[1] * h[1] + b[2] * h[2] + b[3] * h[3] + b[4] * h[4] + b[5] * h[5]
      + b[6] * h[6] + b[7] * h[7] + b[8] * h[8] + b[9] * h[9] + b[10] * h[10] + b[11] * h[11]
      + b[12] * h[12] + b[13] * h[13] + b[14] * h[14] + b[15] * h[15] + b[16] * h[16] + b[17] * h[17]
      + b[18] * h[18] + b[19] * h[19] + b[20] * h[20] + b[21] * h[21] + b[22] * h[22] + b[23] * h[23];
    m = max(m, abs(y)); p += 1;
  );
  m;
);
function clear_lim() local(k) (
  memset(DLINE, 0, 2048); memset(GHIST, 0, 1024);
  dq_h = dq_t = 0; g_rl = 1; wp = 0; tn = 0;
  memset(TPH, 0, 128); tp_w = 0;
  k = 0; loop(1024, GHIST[k] = 1; k += 1; ); g_sum = la_n;
);

function set_rate() (
  c_sw = coef(0.015); c_rms = coef(0.015); c_kn = coef(0.03); c_lk = coef(0.01);
  c_af = coef(0.08); c_as = coef(2.0); c_aa = coef(0.4);   // AUTO: fast release, slow release, slow build-up
  sc_tw = tan($pi * 10 / srate);
  rs_c = 1 / (0.015 * srate);
  c_pa = coef(0.001); c_pr = coef(0.08);              // PRE-COMP: fixed fast timing
  pc_k = 1.4142135623730951;                         // an octave-wide bell (Q 0.707)
  la_n = ceil(0.0015 * srate); la_w = la_n + 1; la_d = la_n + 12;   // BRICK: the detector looks 12 samples back
  c_lrel = coef(0.12); dip_c = 1 / (0.005 * srate);
);
// parameters derived from the sliders: run from @slider and every @block (panel moves don't trigger @slider)
function bw_params() (
  sc_f = schpf == 1 ? 40 : schpf == 2 ? 80 : schpf == 3 ? 120 : schpf == 4 ? 220 : 10;
  sc_tt = tan($pi * sc_f / srate);
  c_att = coef(att_ms * 0.001);
  rng_t = range_i == 0 ? 4 : range_i == 1 ? 8 : range_i == 2 ? 12 : 16;
  pc_tw = tan($pi * (edge_f == 0 ? 2000 : edge_f == 2 ? 4500 : 3000) / srate);
  in_setup(trim_db, guard);
  drift_macro(drift);
  bd_tw = tan($pi * body_f / srate);
  op_fc = open_f == 0 ? 2500 : open_f == 1 ? 5000 : open_f == 2 ? 10000 : open_f == 3 ? 20000 : 40000;
  op_tw = tan($pi * 0.4) * op_fc / (0.4 * srate);     // matched to the analogue first-order curve at 0.4 x the rate
  ceil_t = db2g(lim_ceil);
  os_tf = os_f2n(os_sl);
  brk_t = lim_in && brick;
);

in_init();
set_rate();
bw_params();
thr_s = thr_db; rat_s = ratio; rng_s = rng_t; mix_s = mix_pc * 0.01; out_s = db2g(out_db);
lk_s = lnk; min_s = main_in; rms_s = rmsdet; by_s = byp;
pc_gw = pc_tw; pc_h = 1 / (1 + pc_gw * (pc_gw + pc_k)); pin_s = edge_in; pth_s = edge_thr; pam_s = edge_amt;
pe_a = pe_b = 0;
sc_gw = sc_tw; sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
env_a = env_b = env_sa = env_sb = 0; rq_a = rq_b = 0;
rs_f = 1;
dThr.drift_init(0.8 + rand(1) * 0.4); dRel.drift_init(0.8 + rand(1) * 0.4);
dSide.drift_init(0.8 + rand(1) * 0.4); dHeat.drift_init(0.8 + rand(1) * 0.4); dBias.drift_init(0.8 + rand(1) * 0.4);
bd_gw = bd_tw; bd_h = 1 / (1 + bd_gw * (bd_gw + 1.4142135623730951)); op_gw = op_tw;
bd_s = db2g(body_db) - 1; op_s = db2g(open_db) - 1; peq_s = peq_in;
ceil_s = ceil_t; lin_s = lim_in; brs_s = brick;
vh_k = db2g(-6); vh_b = 0.2; vh_o = sat3(vh_b); vh_n = 1 / (vh_k * sat3d(vh_b));
tp_design(); clear_lim();
os_design();
os_f = os_tf = os_f2n(os_sl);
brk_eng = brk_t; os_base = brk_eng ? la_d : 0;
os_gsetup();
dip_g = 1; dip_hold = 0; dw = 0; memset(DRY, 0, 2048);

// ---------- presets (TRIM and GUARD stay as they are) ----------
#bw_pmn = "Init|Gentle Glue|Master Control|Vocal Bus|Drum Bus|Parallel Crush|Warm Mix Bus|Loud Master|Acoustic Polish|Bass Control|De-Harsh|Broadcast Ready|Streaming Master|Big Room Drums";
function load_preset(p) local(i) (
  thr_db = -18; ratio = 2; range_i = 1; att_ms = 20; rel_ms = 300; rel_auto = 0; schpf = 0; rmsdet = 0; lnk = 1;
  main_in = 1; mix_pc = 100; out_db = 0; edge_in = 1; edge_thr = -24; edge_amt = 4; edge_f = 1;
  body_db = 0; body_f = 250; open_db = 0; open_f = 2; peq_in = 1; lim_ceil = -1; brick = 0; lim_in = 0;
  // glue: slow, low ratio, a touch of air
  p == 2 ? ( thr_db = -22; ratio = 1.5; att_ms = 30; rel_auto = 1; schpf = 2; out_db = 4; open_db = 1; open_f = 3; ) :
  // a master: RMS, auto release, light pre-comp, brickwall at -1
  p == 3 ? ( thr_db = -16; ratio = 2; range_i = 0; att_ms = 25; rel_auto = 1; schpf = 2; rmsdet = 1; out_db = 3; edge_thr = -28; edge_amt = 3;
            body_db = 1; body_f = 200; open_db = 1.5; open_f = 3; lim_in = 1; brick = 1; ) :
  // vocals: firmer, pre-comp on the 2k bite
  p == 4 ? ( thr_db = -24; ratio = 3; att_ms = 5; rel_ms = 150; rmsdet = 1; out_db = 7.5; edge_thr = -30; edge_amt = 6; edge_f = 0;
            body_db = 1.5; body_f = 300; open_db = 2; open_f = 2; ) :
  // drums: lets the attack through, body under the kick
  p == 5 ? ( thr_db = -26; ratio = 4; range_i = 2; att_ms = 10; rel_ms = 120; mix_pc = 70; out_db = 6.5; edge_thr = -26; edge_amt = 5; edge_f = 2;
            body_db = 2; body_f = 120; open_db = 1.5; open_f = 1; lim_in = 1; lim_ceil = -1.5; ) :
  // New York style: crushed, blended low
  p == 6 ? ( thr_db = -36; ratio = 13; range_i = 3; att_ms = 1; rel_ms = 80; mix_pc = 35; out_db = 5; edge_in = 0; ) :
  // warmth on the mix bus: barely compressing, BODY in the low mids
  p == 7 ? ( thr_db = -20; ratio = 1.3; att_ms = 40; rel_ms = 600; schpf = 1; out_db = 3; edge_in = 0;
            body_db = 1.5; body_f = 160; open_db = 0.5; open_f = 4; ) :
  // loud: firmer master into the brickwall
  p == 8 ? ( thr_db = -24; ratio = 3; range_i = 1; att_ms = 15; rel_auto = 1; schpf = 2; out_db = 9.5; edge_thr = -30; edge_amt = 3;
            body_db = 1; body_f = 180; open_db = 2; open_f = 3; lim_in = 1; brick = 1; lim_ceil = -1; ) :
  // acoustic: RMS, slow and open, gentle top
  p == 9 ? ( thr_db = -20; ratio = 1.5; range_i = 0; att_ms = 50; rel_ms = 500; rmsdet = 1; out_db = 4; edge_thr = -30; edge_amt = 2; edge_f = 2;
            open_db = 1.5; open_f = 3; ) :
  // bass: holds the low end steady, slow enough to keep the note's front
  p == 10 ? ( thr_db = -24; ratio = 4; range_i = 2; att_ms = 30; rel_ms = 250; rmsdet = 1; out_db = 8.5; edge_in = 0;
            body_db = 1; body_f = 100; open_db = 1; open_f = 0; ) :
  // de-harsh: the pre-comp does the work on 3k, MAIN just holds
  p == 11 ? ( thr_db = -16; ratio = 1.5; range_i = 0; att_ms = 20; rel_auto = 1; out_db = 3.5; edge_thr = -34; edge_amt = 7; edge_f = 1; ) :
  // broadcast: dense, steady, soft limit
  p == 12 ? ( thr_db = -28; ratio = 4; range_i = 2; att_ms = 8; rel_auto = 1; schpf = 2; rmsdet = 1; out_db = 11.5; edge_thr = -30; edge_amt = 4;
            open_db = 1; open_f = 2; lim_in = 1; lim_ceil = -2; ) :
  // streaming: light master to -1 dBTP
  p == 13 ? ( thr_db = -18; ratio = 1.5; range_i = 0; att_ms = 30; rel_auto = 1; schpf = 2; out_db = 3.5; edge_thr = -28; edge_amt = 2;
            open_db = 1; open_f = 3; lim_in = 1; brick = 1; ) :
  // big room drums: parallel squash with body and top
  p == 14 ? ( thr_db = -32; ratio = 8; range_i = 3; att_ms = 3; rel_ms = 100; mix_pc = 50; out_db = 6; edge_thr = -28; edge_amt = 4; edge_f = 2;
            body_db = 3; body_f = 100; open_db = 3; open_f = 2; lim_in = 1; lim_ceil = -1; );
  i = 1; loop(24, ui_auto(i); i += 1; );            // (TRIM, GUARD, BYPASS, DRIFT and OS stay as they are)
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;                               // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );               // new instances open in Medium, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@slider
prs_chk();
bw_params();

@block
prs_chk();
bw_params();
// resume after REAPER's bypass (or any gap in processing): fade in from the dry signal
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? rs_req = 1;
rs_last = rs_now;
c_rel = coef(rel_ms * 0.001 * (1 + rel_w));
// stereo pins are declared: REAPER carries any other channels round the unit
pdc_bot_ch = 0; pdc_top_ch = 2;

@sample
rs_req ? (
  rs_req = 0; rs_f = 0; rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay;
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  memset(DLINE, 0, 2048); memset(DRY, 0, 2048);
);
rw_l = spl0; rw_r = spl1;
// ---------- BRICK in / out changes the latency: dip, swap at the silent point, wait for the new latency ----------
brk_t != brk_eng ? (
  dip_g = max(dip_g - dip_c, 0);
  dip_g == 0 ? (
    brk_eng = brk_t; clear_lim();
    os_base = brk_eng ? la_d : 0; pdc_delay = os_base + os_lat(os_f);
    dip_hold = pdc_delay + 8 + 2 * samplesblock;
  );
) : dip_hold > 0 ? dip_hold -= 1 : dip_g < 1 ? dip_g = min(dip_g + dip_c, 1);
os_gate();
os_chg ? ( ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr(); os_hold += 2 * samplesblock; );

// ---------- glides ----------
thr_s += (thr_db - thr_s) * c_kn;
rat_s += (ratio - rat_s) * c_kn;
rng_s += (rng_t - rng_s) * c_kn;
mix_s += (mix_pc * 0.01 - mix_s) * c_kn;
out_s += (db2g(out_db) - out_s) * c_kn;
lk_s += (lnk - lk_s) * c_lk;
min_s += (main_in - min_s) * c_sw;
rms_s += (rmsdet - rms_s) * c_sw; rmsdet < 0.5 && rms_s < 0.000001 ? rms_s = 0;
pc_gw += (pc_tw - pc_gw) * c_kn; pc_h = 1 / (1 + pc_gw * (pc_gw + pc_k));
pin_s += (edge_in - pin_s) * c_sw; pth_s += (edge_thr - pth_s) * c_kn; pam_s += (edge_amt - pam_s) * c_kn;
sc_gw += (sc_tt - sc_gw) * c_kn;
sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
bd_gw += (bd_tw - bd_gw) * c_kn; bd_h = 1 / (1 + bd_gw * (bd_gw + 1.4142135623730951)); op_gw += (op_tw - op_gw) * c_kn;
bd_s += (db2g(body_db) - 1 - bd_s) * c_kn; op_s += (db2g(open_db) - 1 - op_s) * c_kn; peq_s += (peq_in - peq_s) * c_sw;
ceil_s += (ceil_t - ceil_s) * c_kn; lin_s += (lim_in - lin_s) * c_sw; brs_s += (brick - brs_s) * c_sw;
sl_c = ceil_s; sl_w = lin_s * (1 - brs_s);

// ---------- DRIFT: valve heat (slow; worked every 32 samples) ----------
(dr_n += 1) >= 32 ? (
  dr_n = 0;
  thr_w = dThr.drift_tick(32 * 0.05 * dm_s / srate) * 0.4 * dm_a;
  rel_w = dRel.drift_tick(32 * 0.07 * dm_s / srate) * 0.12 * dm_a;
  sid_w = dSide.drift_tick(32 * 0.09 * dm_s / srate) * 0.15 * dm_a;
  // the VALVE: drive and bias wander with the heat
  vh_k = db2g(-6 + dHeat.drift_tick(32 * 0.04 * dm_s / srate) * 1.5 * dm_a);
  vh_b = 0.2 + dBias.drift_tick(32 * 0.06 * dm_s / srate) * 0.05 * dm_a;
  vh_o = sat3(vh_b); vh_n = 1 / (vh_k * sat3d(vh_b));
);

in_process(spl0, spl1);
xl = in_l; xr = in_r;
il_d = max(il_d, abs(xl)); ir_d = max(ir_d, abs(xr));

// ---------- PRE-COMP: the dynamic bell ----------
ba = pba.svf_bp(xl); bb = pbb.svf_bp(xr);
pa = abs(ba); pb = abs(bb); pm = max(pa, pb); pa += (pm - pa) * lk_s; pb += (pm - pb) * lk_s;
// the knee hardens as THRESHOLD comes down: 12 dB wide at 0 dBFS (starts gently, early), 6 dB at -40 (JG)
pkw = 6 + 6 * (pth_s + 40) / 40;
pt_a = pam_s > 0.01 ? rcap(gcurve(g2db(pa) - pth_s, 0.75, pkw), pam_s) : 0;
pt_b = pam_s > 0.01 ? rcap(gcurve(g2db(pb) - pth_s, 0.75, pkw), pam_s) : 0;
pe_a += (pt_a - pe_a) * (pt_a > pe_a ? c_pa : c_pr);
pe_b += (pt_b - pe_b) * (pt_b > pe_b ? c_pa : c_pr);
grp_disp = max(grp_disp, max(pe_a, pe_b) * pin_s);
xl += (db2g(-pe_a) - 1) * pin_s * ba; xr += (db2g(-pe_b) - 1) * pin_s * bb;

// ---------- MAIN compressor ----------
sl = 1 - 1 / rat_s;
ha = hpa.svf_hp(xl); hb = hpb.svf_hp(xr); da = abs(ha); db = abs(hb);
rq_a += (ha * ha - rq_a) * c_rms; rq_b += (hb * hb - rq_b) * c_rms;      // RMS: always running, so the key never jumps
rms_s > 0 ? ( da += (sqrt(2 * rq_a) - da) * rms_s; db += (sqrt(2 * rq_b) - db) * rms_s; );
dm = max(da, db); da += (dm - da) * lk_s; db += (dm - db) * lk_s;
// the drift's side-to-side difference fades out as LINK comes in (linked = one threshold)
ta = rcap(gcurve(g2db(da) - thr_s - thr_w - sid_w * (1 - lk_s), sl, 6), rng_s);
tb = rcap(gcurve(g2db(db) - thr_s - thr_w + sid_w * (1 - lk_s), sl, 6), rng_s);
// ballistics in dB (AUTO: the larger of a fast-release and a slow, slowly-built envelope)
rel_auto ? (
  env_a += (ta - env_a) * (ta > env_a ? c_att : c_af);
  env_b += (tb - env_b) * (tb > env_b ? c_att : c_af);
  env_sa += (ta - env_sa) * (ta > env_sa ? c_aa : c_as);
  env_sb += (tb - env_sb) * (tb > env_sb ? c_aa : c_as);
  gra = max(env_a, env_sa); grb = max(env_b, env_sb);
) : (
  // AUTO just switched off: carry its gain reduction over, so it releases instead of jumping
  env_a = max(env_a, env_sa); env_b = max(env_b, env_sb); env_sa = env_sb = 0;
  env_a += (ta - env_a) * (ta > env_a ? c_att : c_rel);
  env_b += (tb - env_b) * (tb > env_b ? c_att : c_rel);
  gra = env_a; grb = env_b;
);
grm_disp = max(grm_disp, max(gra, grb) * min_s);
cl = xl * (1 + min_s * (db2g(-gra) - 1)); cr = xr * (1 + min_s * (db2g(-grb) - 1));

// ---------- PARALLEL EQ: filtered copies added on top (boost only) ----------
cl += (bd_s * bpl.bd_bp(cl) + op_s * ohl.op_hp(cl)) * peq_s;
cr += (bd_s * bpr.bd_bp(cr) + op_s * ohr.op_hp(cr)) * peq_s;

// ---------- MIX (against the input after TRIM), OUTPUT ----------
ol = (in_l + (cl - in_l) * mix_s) * out_s; orr = (in_r + (cr - in_r) * mix_s) * out_s;

// the SOFT limiter's reduction for the meter (its static curve on the louder side's peak)
sl_w > 0.001 ? (
  pk = max(abs(ol), abs(orr)); sl_k = 0.7079457843841379 * sl_c;
  pk > sl_k ? ( sl_t = (pk - sl_k) / (sl_c - sl_k); lgr_disp = max(lgr_disp, g2db(pk / (sl_k + (sl_c - sl_k) * sl_t / (1 + sl_t))) * sl_w); );
);

// ---------- VALVE + SOFT limiter (oversampled) ----------
ul.os_up(ol); ur.os_up(orr);
dc_co = 1 - 2 * $pi * 5 / (srate * os_f);
os_f == 1 ? (
  ol = vl.vs_run(ul.s0); orr = vr.vs_run(ur.s0);
) : os_f == 2 ? (
  ol = dl_.os_dn(vl.vs_run(ul.s0), vl.vs_run(ul.s1), 0, 0); orr = dr_.os_dn(vr.vs_run(ur.s0), vr.vs_run(ur.s1), 0, 0);
) : (
  ol = dl_.os_dn(vl.vs_run(ul.s0), vl.vs_run(ul.s1), vl.vs_run(ul.s2), vl.vs_run(ul.s3));
  orr = dr_.os_dn(vr.vs_run(ur.s0), vr.vs_run(ur.s1), vr.vs_run(ur.s2), vr.vs_run(ur.s3));
);
// the down-sampling filter rings a little past the knee's ceiling on hard peaks: a last clamp catches that
sl_w > 0 && os_f > 1 ? (
  ol += (max(min(ol, sl_c), -sl_c) - ol) * sl_w; orr += (max(min(orr, sl_c), -sl_c) - orr) * sl_w;
);

// ---------- BRICK: look-ahead true-peak limiter ----------
brk_eng ? (
  pk = max(tp_peak(0, ol), tp_peak(1, orr)); tp_w += 1;
  gq = pk > ceil_s * 0.994 ? ceil_s * 0.994 / pk : 1;           // 0.05 dB in hand
  while (dq_t > dq_h && DQV[(dq_t - 1) & RMASK] >= gq) ( dq_t -= 1; );
  DQV[dq_t & RMASK] = gq; DQI[dq_t & RMASK] = tn; dq_t += 1;
  while (DQI[dq_h & RMASK] <= tn - la_w) ( dq_h += 1; );
  gmin = DQV[dq_h & RMASK];
  g_rl = gmin < g_rl ? gmin : g_rl + (gmin - g_rl) * c_lrel;
  g_sum += g_rl - GHIST[(wp - la_n) & RMASK]; GHIST[wp & RMASK] = g_rl;
  lg = min(g_sum / la_n, 1);
  DLINE[wp & RMASK] = ol; DLINE[1024 + (wp & RMASK)] = orr;
  ol = DLINE[(wp - la_d) & RMASK] * lg; orr = DLINE[1024 + ((wp - la_d) & RMASK)] * lg;
  wp += 1; tn += 1;
  (wp & 65535) == 0 ? ( g_sum = 0; k_ = 0; loop(la_n, g_sum += GHIST[(wp - 1 - k_) & RMASK]; k_ += 1; ); );
  ol = max(min(ol, ceil_s), -ceil_s); orr = max(min(orr, ceil_s), -ceil_s);   // the last safety
  lgr_disp = max(lgr_disp, -g2db(lg));
);

dip_s = min(dip_g, os_g); dip_s *= dip_s * (3 - 2 * dip_s);   // an S-curve dip: no corners
ol *= dip_s; orr *= dip_s;
// the resume fade and BYPASS use the dry input delayed by the latency, so they stay in time
DRY[dw] = rw_l; DRY[1024 + dw] = rw_r;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
  rs_s = rs_f * rs_f * (3 - 2 * rs_f); rs_xs = rs_x * rs_x * (3 - 2 * rs_x);
  rs_dl = rw_l + (DRY[(dw - pdc_delay) & RMASK] - rw_l) * rs_xs;
  rs_dr = rw_r + (DRY[1024 + ((dw - pdc_delay) & RMASK)] - rw_r) * rs_xs;
  ol = rs_dl + (ol - rs_dl) * rs_s; orr = rs_dr + (orr - rs_dr) * rs_s;
);
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? (
  ol += (DRY[(dw - pdc_delay) & RMASK] - ol) * by_s; orr += (DRY[1024 + ((dw - pdc_delay) & RMASK)] - orr) * by_s;
);
dw = (dw + 1) & RMASK;
spl0 = ol; spl1 = orr;
lat_disp = pdc_delay;
mo_l_d = max(mo_l_d, abs(spl0)); mo_r_d = max(mo_r_d, abs(spl1));

@gfx 1080 500
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1080, 500);
// =====================================================================
// GUI (design space 1080 x 500; S / M / L = 85 / 100 / 130 %). Deep sea-green faceplate, cream print, brass caps on
// the main controls and sea-glass caps on the secondary ones. Two plates: the controls (PRE-COMP | MAIN COMPRESSOR |
// PARALLEL EQ | OUTPUT) and the meters (TRIM, DRIFT, GR, IN, OUT). A rope knot in the header.
// =====================================================================
BG = 0x22403C; HDR = 0x19302D; PL = 0x284A45; PLD = 0x213E3A; HAIR = 0x9CC8BE; INK = 0xEDE6D2; DIM = 0xA8C2BA;
BRASS = 0xB8913E; SEAG = 0x5E9C92; GLASS = 0x0F1A19;
sc != bw_lsc ? (
  bw_lsc = sc;
  bw_f2 = ui_fitfont(2, 14 * sc);                    // knob labels / values: 14 px
  gfx_setfont(10, "Trebuchet MS", 30 * sc, 'b');     // the unit's name
  gfx_setfont(11, "Trebuchet MS", 15 * sc, 'b');     // section titles
  gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');     // small print
  gfx_setfont(14, "Trebuchet MS", 14 * sc, 'b');     // key legends, display boxes
  gfx_setfont(15, "Trebuchet MS", 18 * sc, 'b');     // the OUT peak figure
);
gfx_setfont(2, "Trebuchet MS", bw_f2, 'b'); gfx_setfont(3, "Trebuchet MS", bw_f2, 'b');
C_INK = INK; lk_font = 14; lk_font2 = 14; lk_well = 0x0E1716;

function bw_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function bw_rr(x, y, w, h, r) ( ui_rrs(x * sc, y * sc, w * sc, h * sc, r * sc); );
function bw_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function bw_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function bw_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function bw_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// soft drop shadow, light from the top left: 4 layers, (+2, +3) to (+6, +8)
function bw_shadow(x, y, w, h, r) local(j) (
  j = 0; loop(4, ui_cola(0x000000, 0.13); bw_rr(x + 2 + j * 1.3, y + 3 + j * 1.7, w + j * 0.4, h + j * 0.4, r + j); j += 1; );
);
// a plate: shadow, a light top / left edge, a dark bottom / right edge
function bw_plate(x, y, w, h) (
  bw_shadow(x, y, w, h, 6);
  ui_col(0x0F1D1B); bw_rr(x, y, w, h, 6);
  ui_col(0x4F7570); bw_rr(x, y, w - 1, h - 1, 6);
  ui_col(PL); bw_rr(x + 1, y + 1, w - 2.5, h - 2.5, 5);
);
// a section header band: the title on the band's centre line, a hairline under it
function bw_head(x, w, title) local(tw, th) (
  ui_col(PLD); bw_r(x + 1, 81, w - 2, 32);
  ui_cola(HAIR, 0.5); bw_r(x + 1, 113, w - 2, 1);
  gfx_setfont(11); gfx_measurestr(title, tw, th);
  ui_col(INK); gfx_x = (x + 16) * sc; gfx_y = 97 * sc - th * 0.5; gfx_drawstr(title);
);
// a divider between two sections: a dark and a light hairline
function bw_div(x) ( ui_col(0x142725); bw_r(x, 82, 1, 268); ui_cola(0xFFFFFF, 0.07); bw_r(x + 1, 82, 1, 268); );
// a dark recessed display box: the current item and a down-pointing triangle; a click opens the list. Its name sits
// above it. Returns the chosen index or -1.
function bw_box(x, y, w, h, name, menu, v) local(hov, sel, n, i, tw, th) (
  hov = bw_in(x, y, w, h);
  gfx_setfont(13); ui_col(DIM); bw_tc(x + w * 0.5, y - 17, name);
  ui_col(0x081110); bw_rr(x - 1, y - 1, w + 2, h + 2, 4);
  ui_col(GLASS); bw_rr(x, y, w, h, 3);
  ui_cola(0x000000, 0.5); bw_r(x + 1, y + 1, w - 2, 2);
  hov ? ( ui_cola(0xFFFFFF, 0.06); bw_rr(x, y, w, h, 3); );
  pk_pitem(menu, v + 1, #bw_di);
  gfx_setfont(14); ui_col(HAIR); gfx_measurestr(#bw_di, tw, th);
  gfx_x = (x + (w - 14) * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5) * sc - th * 0.5; gfx_drawstr(#bw_di);
  ui_col(DIM); ui_sstri((x + w - 17) * sc, (y + h * 0.5 - 3) * sc, (x + w - 7) * sc, (y + h * 0.5 - 3) * sc, (x + w - 12) * sc, (y + h * 0.5 + 3) * sc);
  sel = -1;
  pressed && hov && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#bw_dm, ""); n = pk_pcount(menu); i = 1;
    loop(n, i == v + 1 ? strcat(#bw_dm, "!"); strcat(#bw_dm, pk_pitem(menu, i, #bw_dt)); i < n ? strcat(#bw_dm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#bw_dm); i > 0 ? sel = i - 1;
  );
  sel;
);
// a desk knob (ui_knob does the mouse, the value on touch and the label)
function bw_kn(cx, cy, r, idx, lo, hi, def, lg, cap, lbl, fmt) (
  ui_kdesk = cap; ui_kdesk_r = r; ui_kdesk_p = 0;
  ui_knob(cx * sc, cy * sc, idx, lo, hi, def, lg, lbl, fmt);
  ui_kdesk = 0; ui_kdesk_r = 0;
);
// a small "0" printed outside a dial at the normalised position n
function bw_zero(cx, cy, r, n) local(a) (
  a = -0.75 * $pi + n * 1.5 * $pi; gfx_setfont(13); ui_col(HAIR);
  bw_tc(cx + sin(a) * (r + 17), cy - cos(a) * (r + 17) - 7, "0");
);
// a lamp key from its slider: lit = on; the click toggles
function bw_key(x, y, w, h, idx, col, s) (
  lk_key(x, y, w, h, slider(idx) >= 0.5, col, s) ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
);
// a GR bar: 20 segments of 1 dB, from the left
function bw_gr(x, y, w, h, gr, col) local(i, c, lit) (
  ui_col(0x0A0F0E); bw_r(x - 2, y - 2, w + 4, h + 4);
  c = w / 20; i = 0;
  loop(20,
    lit = gr >= i + 0.5;
    lit ? ( ui_cola(col, 0.3); bw_r(x + i * c - 0.5, y - 1, c, h + 2); ui_col(col); ) : ui_cola(col, 0.12);
    bw_r(x + i * c + 0.5, y, c - 1.5, h);
    i += 1;
  );
);

// ---------- the meters' hand-off (the audio thread fills, the panel takes and clears) ----------
bw_grm = max(grm_disp, bw_grm * 0.85); grm_disp = 0;
bw_grp = max(grp_disp, bw_grp * 0.85); grp_disp = 0;
bw_grl = max(lgr_disp, bw_grl * 0.85); lgr_disp = 0;
bw_il = il_d; bw_ir = ir_d; il_d = ir_d = 0;
bw_ol = mo_l_d; bw_or = mo_r_d; mo_l_d = mo_r_d = 0;

// ---------- faceplate and header ----------
ui_col(BG); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(HDR); bw_r(0, 0, 1080, 64);
ui_col(HAIR); bw_r(0, 63, 1080, 2); ui_col(0x0E1A18); bw_r(0, 65, 1080, 1);
ui_cola(0x000000, 0.35); bw_r(1077, 0, 3, 500); bw_r(0, 497, 1080, 3);       // a narrow darker right / bottom edge
ui_screw(9 * sc, 9 * sc); ui_screw((1080 - 9) * sc, 9 * sc); ui_screw(9 * sc, (500 - 9) * sc); ui_screw((1080 - 9) * sc, (500 - 9) * sc);
ui_col(INK); gfx_circle(40 * sc, 32 * sc, 16 * sc, 1, 1);
gfx_setfont(13); ui_col(HDR); ui_keytext(40 * sc, 32 * sc, "GFX");
gfx_setfont(10); ui_col(INK); bw_tl(68, 15, "BOWLINE"); gfx_measurestr("BOWLINE", bw_tw, bw_th); ver_tag("v3", 16, 2.9, 0);
gfx_setfont(13); ui_col(HAIR); bw_tl(82 + bw_tw / sc, 20, "MASTERING"); bw_tl(82 + bw_tw / sc, 34, "COMPRESSOR");
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
bw_k = pk_preset(340 * sc, 15 * sc, 290 * sc, 34 * sc, pr_cur, #bw_pmn);
bw_k > 0 ? prs_dirty = bw_k;
bw_key(818, 20, 84, 26, 27, LK_WHT, "BYPASS");
