desc:Ferrum [dual-valve mastering compressor] (GFX)
// gfx-ferrum - Dual-valve variable-mu mastering compressor in the spirit of the modern twin-tube vari-mu units.
//tags: compressor vari-mu tube valve mastering bus mid-side
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// CHAIN    IN -> (M/S encode) -> HEADROOM drive -> IRON (input transformer) -> two valve stages in parallel,
//          recombined -> GAIN -> IRON (out) -> (M/S decode) -> WIDTH / MONO -> PASSIVE EQ -> MIX -> OUTPUT
// VALVES   The transformer feeds two compressing valve stages side by side and sums them: a 12AX7-style stage
//          (wide knee, gentle ratio, warm 2nd harmonic) and a 12AU7-style stage (narrower knee, firmer ratio,
//          a touch of 3rd, starts a little later). TUBE BIAS leans both harder: the 12AX7 stage from 1.5:1 to
//          4:1, the 12AU7 stage from 2:1 to 8:1. As they compress, their bias shifts and the colour grows, the
//          way a vari-mu valve's does.
// DETECTOR Feed-forward with an opto (vactrol) stage: the recovery slows the longer the unit has been
//          compressing (program dependent). ATTACK 1 (slow, 60 ms) .. 6 (fast, 1 ms); RELEASE 1 (slow, 2.5 s)
//          .. 6 (fast, 100 ms). RECTIFIER: the diodes that rectify the detector signal - GE (germanium: earlier,
//          softer onset, gentler timing), SI (silicon: the reference), LED (later, harder onset, snappier),
//          G+S, S+L and ALL (blends). SIDECHAIN: SC HPF swept OFF .. 330 Hz, LIFT (presence 3 kHz +4 dB:
//          sibilance and snare lean on it), FOCUS (250 Hz - 4 kHz), EXT (the external sidechain on inputs 3 / 4).
// LINK     Channel 1's THRESHOLD, TUBE BIAS, GAIN, ATTACK, RELEASE, RECTIFIER and sidechain set both channels and
//          the two detectors are linked. LINK and M/S exclude each other (switching one on turns the other off).
// M/S      Channel 1 (left) = mid, channel 2 (right) = side; turns LINK off. WIDTH 0 .. 200 %, MONO below 60 .. 250 Hz (sides high-passed).
// PASSIVE EQ  Two fixed sounds on the master out: BASS LIFT (low shelf +1.5 dB at 70 Hz with a shallow 250 Hz
//          dip) and AIR BAND (high shelf +1.8 dB from 14 kHz).
// TOLERANCE  Component spread: each channel's threshold, timing and valve drive sit slightly apart and wander
//          slowly, as two real channels do (0 = identical, 100 % = a well-worn unit).
// HEADROOM  Where 0 VU sits: 6 .. 24 dB below full scale (18 = -18 dBFS). Less headroom drives the iron and
//          the valves harder; the level stays where it was.
// No latency.
//
// Requires gfx-ui, gfx-panel, gfx-faceplate (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc

slider1:0<0,9,1{Init,Gentle Glue,Master Polish,Warm Vari-Mu,Punchy Drums,Vocal Silk,Bass Control,Parallel Squeeze,M/S Tighten,Opto Smooth}>-Preset
slider2:10<-20,20,0.1>-Ch1 threshold (dB re 0 VU)
slider3:5<0,10,0.1>-Ch1 tube bias
slider4:0<0,20,0.1>-Ch1 gain (dB)
slider5:2<0,5,1{1,2,3,4,5,6}>-Ch1 attack
slider6:2<0,5,1{1,2,3,4,5,6}>-Ch1 release
slider7:1<0,5,1{GE,SI,LED,G+S,S+L,ALL}>-Ch1 rectifier
slider8:0<0,330,1>-Ch1 SC HPF (Hz, below 20 = off)
slider9:10<-20,20,0.1>-Ch2 threshold (dB re 0 VU)
slider10:5<0,10,0.1>-Ch2 tube bias
slider11:0<0,20,0.1>-Ch2 gain (dB)
slider12:2<0,5,1{1,2,3,4,5,6}>-Ch2 attack
slider13:2<0,5,1{1,2,3,4,5,6}>-Ch2 release
slider14:1<0,5,1{GE,SI,LED,G+S,S+L,ALL}>-Ch2 rectifier
slider15:0<0,330,1>-Ch2 SC HPF (Hz, below 20 = off)
slider16:1<0,1,1{Off,On}>-Link
slider17:0<0,1,1{Off,On}>-M/S
slider18:0<0,1,1{Off,On}>-Bypass
slider19:100<0,100,1>-Mix (%)
slider20:0<-12,12,0.1>-Output (dB)
slider21:100<0,200,1>-Width (%)
slider22:0<0,5,1{Off,60 Hz,90 Hz,120 Hz,160 Hz,250 Hz}>-Mono below
slider23:0<0,1,1{Off,On}>-Bass lift
slider24:0<0,1,1{Off,On}>-Air band
slider25:1<0,1,1{Off,On}>-Iron
slider26:30<0,100,1>-Tolerance (%)
slider27:18<6,24,0.1>-Headroom (dB)
slider28:0<0,1,1{Off,On}>-Ch1 SC lift
slider29:0<0,1,1{Off,On}>-Ch1 SC focus
slider30:0<0,1,1{Off,On}>-Ch1 SC external
slider31:0<0,1,1{Off,On}>-Ch2 SC lift
slider32:0<0,1,1{Off,On}>-Ch2 SC focus
slider33:0<0,1,1{Off,On}>-Ch2 SC external

in_pin:Left
in_pin:Right
in_pin:Sidechain L
in_pin:Sidechain R
out_pin:Left
out_pin:Right

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0;
#ui_man = "gfx-ferrum";
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function db2g(d) ( exp(d*0.11512925465); );
function g2db(g) ( 8.68588963807*log(max(g, 0.0000000001)); );
function tanh(v) ( v = max(-20, min(20, v)); 1 - 2/(exp(2*v) + 1); );
function softk(o, w) ( o <= -w*0.5 ? 0 : o >= w*0.5 ? o : (o + w*0.5)*(o + w*0.5)/(2*w); );
function cms(t) ( 1 - exp(-1/(max(0.000001, t)*srate)); );

// biquads (c = b0 b1 b2 a1 a2, s = x1 x2 y1 y2)
function bqf(x, c, s) local(y) (
  y = c[0]*x + c[1]*s[0] + c[2]*s[1] - c[3]*s[2] - c[4]*s[3];
  s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y; y;
);
function cset(c, t, f, g, q) local(A, w, cs, al, sa, a0) (   // t: 0 LP, 1 HP, 2 peak, 3 high shelf, 4 low shelf, 5 BP
  w = 2*$pi*min(f, srate*0.45)/srate; cs = cos(w); al = sin(w)/(2*q); A = 10^(g/40);
  t == 0 ? ( a0 = 1 + al; c[0] = (1 - cs)*0.5/a0; c[1] = (1 - cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0; ) :
  t == 1 ? ( a0 = 1 + al; c[0] = (1 + cs)*0.5/a0; c[1] = -(1 + cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0; ) :
  t == 2 ? ( a0 = 1 + al/A; c[0] = (1 + al*A)/a0; c[1] = -2*cs/a0; c[2] = (1 - al*A)/a0; c[3] = -2*cs/a0; c[4] = (1 - al/A)/a0; ) :
  t == 3 ? ( sa = 2*sqrt(A)*al; a0 = (A + 1) - (A - 1)*cs + sa;
             c[0] = A*((A + 1) + (A - 1)*cs + sa)/a0; c[1] = -2*A*((A - 1) + (A + 1)*cs)/a0; c[2] = A*((A + 1) + (A - 1)*cs - sa)/a0;
             c[3] = 2*((A - 1) - (A + 1)*cs)/a0; c[4] = ((A + 1) - (A - 1)*cs - sa)/a0; ) :
  t == 4 ? ( sa = 2*sqrt(A)*al; a0 = (A + 1) + (A - 1)*cs + sa;
             c[0] = A*((A + 1) - (A - 1)*cs + sa)/a0; c[1] = 2*A*((A - 1) - (A + 1)*cs)/a0; c[2] = A*((A + 1) - (A - 1)*cs - sa)/a0;
             c[3] = -2*((A - 1) + (A + 1)*cs)/a0; c[4] = ((A + 1) + (A - 1)*cs - sa)/a0; ) :
           ( a0 = 1 + al; c[0] = al/a0; c[1] = 0; c[2] = -al/a0; c[3] = -2*cs/a0; c[4] = (1 - al)/a0; );
);

ironC = 1 - exp(-2*$pi*110/srate);
ironDc = tanh(0.1);

// ---- tolerance: each channel's own component spread, kept with the project ----
!tol_seeded ? ( tr1 = rand(1); tr2 = rand(1); tr3 = rand(1); tr4 = rand(1); tr5 = rand(1); tr6 = rand(1); tol_seeded = 1; );

// ---- one channel ----
function ch_init() instance(sc1, sc2, ss1, ss2, sc3, ss3, sc4, ss4, e, mem, wand, wv, lpA, lpB, ipl, ipl2, opl, opl2, dcA, dcB, grA, grB) (
  sc1 = alloc(5); sc2 = alloc(5); sc3 = alloc(5); sc4 = alloc(5); ss1 = alloc(4); ss2 = alloc(4); ss3 = alloc(4); ss4 = alloc(4);
  e = 0; mem = 0; wand = 0; wv = 0; dcA = dcB = 0; grA = grB = 1;
);
// sidechain: HPF (sweepable, off below 20 Hz), LIFT (+4 dB at 3 kHz), FOCUS (250 Hz - 4 kHz band), EXT (inputs 3 / 4)
function ch_scset(hp, lift, foc) instance(sc1, sc2, sc3, sc4, hpOn, lfOn, fcOn) (
  hpOn = hp >= 20; lfOn = lift; fcOn = foc;
  hpOn ? cset(sc1, 1, hp, 0, 0.707);
  cset(sc2, 2, 3000, 4, 1.0);
  cset(sc3, 1, 250, 0, 0.6); cset(sc4, 0, 4000, 0, 0.6);
);
function ch_sc(x, ext, useExt) instance(sc1, sc2, sc3, sc4, ss1, ss2, ss3, ss4, hpOn, lfOn, fcOn) (
  useExt ? x = ext;
  hpOn ? x = bqf(x, sc1, ss1);
  lfOn ? x = bqf(x, sc2, ss2);
  fcOn ? x = bqf(bqf(x, sc3, ss3), sc4, ss4);
  x;
);
// the transformer: two-pole split, only the lows reach the core
function ch_iron(x, amt) instance(ipl, ipl2) local(lo) (
  ipl += (x - ipl)*ironC; ipl2 += (ipl - ipl2)*ironC;
  lo = (tanh(ipl2*amt + 0.1) - ironDc)/amt;
  lo + (x - ipl2);
);
function ch_iron2(x, amt) instance(opl, opl2) local(lo) (
  opl += (x - opl)*ironC; opl2 += (opl - opl2)*ironC;
  lo = (tanh(opl2*amt + 0.1) - ironDc)/amt;
  lo + (x - opl2);
);
// detector: level (linear) -> dB envelope with rectifier, attack, release and the opto memory
function ch_detect(s, atkC, relC, roff) instance(e, mem) local(r, l) (
  r = abs(s);
  e = r > e ? e + (r - e)*atkC : e + (r - e)*relC/(1 + 2.5*mem);
  l = g2db(e) + roff;
  l;
);
// valves: unity small-signal gain, bias shift with gain reduction (k = drive, a = bias)
function valve(x, k, a) local(t) ( t = tanh(k*a); (tanh(k*(x + a)) - t)/(k*(1 - t*t)); );

c1.ch_init(); c2.ch_init();
// passive EQ, mono maker
bl1 = alloc(5); bl2 = alloc(5); air = alloc(5);
sB1L = alloc(4); sB1R = alloc(4); sB2L = alloc(4); sB2R = alloc(4); sAL = alloc(4); sAR = alloc(4);
cset(bl1, 4, 70, 1.5, 0.9); cset(bl2, 2, 250, -0.6, 0.8); cset(air, 3, 14000, 1.8, 0.6);
mm = alloc(5); smm1 = alloc(4); smm2 = alloc(4);
lastMono = -1; lastSc1 = -1; lastSc2 = -1;
dcC = 1 - exp(-2*$pi*8/srate);
by_st = 1 / (0.015 * srate); by_x = slider18 > 0.5;      // BYPASS crossfade (15 ms)
vu1 = vu2 = 0; vuC = cms(0.3/2.2); lvlM = 0; glow = 0;

// ---- presets ----
// sf: 0 off, 1 HPF 80 Hz, 2 HPF 150 Hz, 3 HPF 100 Hz + LIFT, 4 FOCUS
function pch(c, th, bi, gn, at, re, rc, sf) local(hp, lf, fc) (
  hp = sf == 1 ? 80 : sf == 2 ? 150 : sf == 3 ? 100 : 0; lf = sf == 3; fc = sf == 4;
  c == 1 ? ( slider2 = th; slider3 = bi; slider4 = gn; slider5 = at; slider6 = re; slider7 = rc; slider8 = hp; slider28 = lf; slider29 = fc; slider30 = 0; )
         : ( slider9 = th; slider10 = bi; slider11 = gn; slider12 = at; slider13 = re; slider14 = rc; slider15 = hp; slider31 = lf; slider32 = fc; slider33 = 0; );
);
function pm(lk, ms, mx, ou, wd, mo, bl, ai, ir) (
  slider16 = lk; slider17 = ms; slider18 = 0; slider19 = mx; slider20 = ou; slider21 = wd; slider22 = mo; slider23 = bl; slider24 = ai; slider25 = ir;
);
function apply_preset(n) (
  pch(1, 10, 5, 0, 2, 2, 1, 0); pch(2, 10, 5, 0, 2, 2, 1, 0); pm(1, 0, 100, 0, 100, 0, 0, 0, 1);
  n == 1 ? ( pch(1, 7, 3, 1.5, 1, 1, 0, 1); pch(2, 7, 3, 1.5, 1, 1, 0, 1); pm(1, 0, 100, 0, 100, 0, 0, 0, 1); ) :              // Gentle Glue
  n == 2 ? ( pch(1, 5, 4, 2, 2, 2, 3, 1); pch(2, 5, 4, 2, 2, 2, 3, 1); pm(1, 0, 100, 0, 100, 2, 0, 1, 1); ) :              // Master Polish
  n == 3 ? ( pch(1, 3, 6, 5, 1, 1, 0, 0); pch(2, 3, 6, 5, 1, 1, 0, 0); pm(1, 0, 100, 0, 100, 0, 1, 0, 1); ) :              // Warm Vari-Mu
  n == 4 ? ( pch(1, -6, 7, 6, 0, 4, 2, 2); pch(2, -6, 7, 6, 0, 4, 2, 2); pm(1, 0, 100, 0, 100, 0, 1, 1, 1); ) :              // Punchy Drums
  n == 5 ? ( pch(1, 3, 5, 4.5, 3, 3, 3, 3); pch(2, 3, 5, 4.5, 3, 3, 3, 3); pm(1, 0, 100, 0, 100, 0, 0, 1, 1); ) :              // Vocal Silk
  n == 6 ? ( pch(1, 4.5, 6, 3, 2, 2, 1, 0); pch(2, 4.5, 6, 3, 2, 2, 1, 0); pm(1, 0, 100, 0, 100, 3, 1, 0, 1); ) :                  // Bass Control
  n == 7 ? ( pch(1, -6, 9, 10, 4, 5, 2, 1); pch(2, -6, 9, 10, 4, 5, 2, 1); pm(1, 0, 40, 0, 100, 0, 0, 0, 1); ) :                   // Parallel Squeeze
  n == 8 ? ( pch(1, 3, 4, 1.5, 2, 2, 1, 1); pch(2, 0, 7, 3, 3, 3, 4, 2); pm(0, 1, 100, 0, 100, 3, 0, 0, 1); ) :                  // M/S Tighten
  n == 9 ? ( pch(1, 2, 4, 3, 1, 0, 2, 1); pch(2, 2, 4, 3, 1, 0, 2, 1); pm(1, 0, 100, 0, 100, 0, 0, 0, 1); );                   // Opto Smooth
);
function pname(n) (
  n == 0 ? "INIT" : n == 1 ? "GENTLE GLUE" : n == 2 ? "MASTER POLISH" : n == 3 ? "WARM VARI-MU" : n == 4 ? "PUNCHY DRUMS" :
  n == 5 ? "VOCAL SILK" : n == 6 ? "BASS CONTROL" : n == 7 ? "PARALLEL SQUEEZE" : n == 8 ? "M/S TIGHTEN" : "OPTO SMOOTH";
);
!ui_dflt ? ( ui_hw = 1; lastPreset = slider1; );
ui_dflt = 1;

@serialize
file_var(0, ui_sz);
file_var(0, ui_hw);
file_var(0, lastPreset);
file_var(0, tol_seeded);
file_var(0, tr1); file_var(0, tr2); file_var(0, tr3); file_var(0, tr4); file_var(0, tr5); file_var(0, tr6);

@slider
slider1 != lastPreset ? ( apply_preset(slider1); lastPreset = slider1; );

@block
ms = slider17 > 0.5; link = slider16 > 0.5 && !ms; byp = slider18 > 0.5; ironOn = slider25 > 0.5;
mix = slider19*0.01; outG = db2g(slider20); wid = slider21*0.01;
hr = db2g(18 - slider27); ihr = 1/hr;
tol = slider26*0.01;
// slow wander (the tolerance's living part)
wv1 += (rand(2) - 1)*0.02; wv1 *= 0.995; wv2 += (rand(2) - 1)*0.02; wv2 *= 0.995;
function attms(i) ( i == 0 ? 60 : i == 1 ? 30 : i == 2 ? 15 : i == 3 ? 8 : i == 4 ? 3 : 1; );
function relms(i) ( i == 0 ? 2500 : i == 1 ? 1200 : i == 2 ? 600 : i == 3 ? 350 : i == 4 ? 200 : 100; );
// rectifier: onset offset (dB), knee (dB), attack and release scaling
function rof(i) ( i == 0 ? 1 : i == 1 ? 0 : i == 2 ? -2 : i == 3 ? 0.5 : i == 4 ? -1 : -0.3; );
function rkn(i) ( i == 0 ? 4 : i == 1 ? 0 : i == 2 ? -2 : i == 3 ? 2 : i == 4 ? -1 : 1.5; );
function rat(i) ( i == 0 ? 1.3 : i == 1 ? 1 : i == 2 ? 0.7 : i == 3 ? 1.15 : i == 4 ? 0.85 : 1; );
function rrl(i) ( i == 0 ? 1.2 : i == 1 ? 1 : i == 2 ? 0.8 : i == 3 ? 1.1 : i == 4 ? 0.9 : 1; );
// per channel settings (LINK: channel 1's for both)
function setch(ch) local(b, th, bi, at, re, rc, sf, sp, xb) (
  b = (link || ch == 1) ? 2 : 9; xb = b == 2 ? 28 : 31;
  th = slider(b); bi = slider(b + 1); at = floor(slider(b + 3) + 0.5); re = floor(slider(b + 4) + 0.5);
  rc = floor(slider(b + 5) + 0.5); sf = floor(slider(b + 6) + 0.5);
  ch == 1 ? ( lf1 = slider(xb) > 0.5; fc1 = slider(xb + 1) > 0.5; ex1 = slider(xb + 2) > 0.5; )
          : ( lf2 = slider(xb) > 0.5; fc2 = slider(xb + 1) > 0.5; ex2 = slider(xb + 2) > 0.5; );
  sp = ch == 1 ? 0 : 1;
  ch == 1 ? (
    t1 = th + tol*((tr1 - 0.5)*1.0 + wv1*0.4); kn1 = 2 + rkn(rc); ro1 = rof(rc);
    a1C = cms(attms(at)*0.001*rat(rc)*(1 + tol*(tr2 - 0.5)*0.2)); r1C = cms(relms(re)*0.001*rrl(rc)*(1 + tol*(tr3 - 0.5)*0.2));
    rA1 = 1.5 + 0.25*bi; rB1 = 2 + 0.6*bi; kd1 = 1 + tol*(tr4 - 0.5)*0.15; sf1 = sf;
  ) : (
    t2 = th + tol*((tr4 - 0.5)*1.0 + wv2*0.4); kn2 = 2 + rkn(rc); ro2 = rof(rc);
    a2C = cms(attms(at)*0.001*rat(rc)*(1 + tol*(tr5 - 0.5)*0.2)); r2C = cms(relms(re)*0.001*rrl(rc)*(1 + tol*(tr6 - 0.5)*0.2));
    rA2 = 1.5 + 0.25*bi; rB2 = 2 + 0.6*bi; kd2 = 1 + tol*(tr1 - 0.5)*0.15; sf2 = sf;
  );
);
setch(1); setch(2);
g1 = db2g(slider4); g2 = link ? g1 : db2g(slider11);           // LINK: channel 1's gain for both
k1_ = sf1 + lf1*1000 + fc1*2000; k1_ != lastSc1 ? ( c1.ch_scset(sf1, lf1, fc1); lastSc1 = k1_; );
k2_ = sf2 + lf2*1000 + fc2*2000; k2_ != lastSc2 ? ( c2.ch_scset(sf2, lf2, fc2); lastSc2 = k2_; );
mono = floor(slider22 + 0.5);
mono != lastMono ? ( mf = mono == 1 ? 60 : mono == 2 ? 90 : mono == 3 ? 120 : mono == 4 ? 160 : 250; cset(mm, 1, mf, 0, 0.7071); lastMono = mono; );
memC = cms(1.5);

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
inL = spl0; inR = spl1;
// BYPASS: the unit keeps running and crossfades 15 ms to the input (a hard switch clicked)
by_x = byp ? min(by_x + by_st, 1) : max(by_x - by_st, 0);
(
  ms ? ( a = (inL + inR)*0.5; b = (inL - inR)*0.5; ) : ( a = inL; b = inR; );
  ea = spl2; eb = spl3; ms ? ( t_ = (ea + eb)*0.5; eb = (ea - eb)*0.5; ea = t_; );
  a *= hr; b *= hr; ea *= hr; eb *= hr;
  ironOn ? ( a = c1.ch_iron(a, 0.7); b = c2.ch_iron(b, 0.7); );
  // detectors
  d1 = c1.ch_detect(c1.ch_sc(a, ea, ex1), a1C, r1C, ro1);
  d2 = c2.ch_detect(c2.ch_sc(b, eb, ex2), a2C, r2C, ro2);
  link ? ( d1 = d2 = max(d1, d2); );
  // the two valve stages' gain reduction (dB): the 12AX7 wide and gentle, the 12AU7 narrower, firmer, later
  o1 = d1 - (t1 - 18); o2 = d2 - (t2 - 18);    // thresholds read against 0 VU = -18 dBFS inside the unit
  gA1 = -softk(o1, 14 + kn1)*(1 - 1/rA1); gB1 = -softk(o1 - 3, 7 + kn1)*(1 - 1/rB1);
  gA2 = -softk(o2, 14 + kn2)*(1 - 1/rA2); gB2 = -softk(o2 - 3, 7 + kn2)*(1 - 1/rB2);
  // opto memory: the deeper and longer the reduction, the slower the recovery
  c1.mem += (min(1, -0.5*(gA1 + gB1)/10) - c1.mem)*memC; c2.mem += (min(1, -0.5*(gA2 + gB2)/10) - c2.mem)*memC;
  // valves (bias shifts with reduction: the colour grows as they work)
  vA1 = valve(a*db2g(gA1), 0.6*kd1, 0.12 - 0.012*gA1); vB1 = valve(a*db2g(gB1), 0.9*kd1, 0.04 - 0.004*gB1);
  vA2 = valve(b*db2g(gA2), 0.6*kd2, 0.12 - 0.012*gA2); vB2 = valve(b*db2g(gB2), 0.9*kd2, 0.04 - 0.004*gB2);
  y1 = 0.5*(vA1 + vB1); y2 = 0.5*(vA2 + vB2);
  // DC from the bias shift
  dc1 += (y1 - dc1)*dcC; y1 -= dc1; dc2 += (y2 - dc2)*dcC; y2 -= dc2;
  y1 *= g1; y2 *= g2;
  ironOn ? ( y1 = c1.ch_iron2(y1, 0.45); y2 = c2.ch_iron2(y2, 0.45); );
  y1 *= ihr; y2 *= ihr;
  // decode, width, mono maker
  ms ? ( l_ = y1 + y2; r_ = y1 - y2; ) : ( l_ = y1; r_ = y2; );
  mid = (l_ + r_)*0.5; sid = (l_ - r_)*0.5*wid;
  mono > 0 ? sid = bqf(bqf(sid, mm, smm1), mm, smm2);
  l_ = mid + sid; r_ = mid - sid;
  // passive EQ
  slider23 > 0.5 ? ( l_ = bqf(bqf(l_, bl1, sB1L), bl2, sB2L); r_ = bqf(bqf(r_, bl1, sB1R), bl2, sB2R); );
  slider24 > 0.5 ? ( l_ = bqf(l_, air, sAL); r_ = bqf(r_, air, sAR); );
  spl0 = (inL*(1 - mix) + l_*mix)*outG; spl1 = (inR*(1 - mix) + r_*mix)*outG;
  // meters: GR as the two stages' average
  gr1 = -0.5*(gA1 + gB1); gr2 = -0.5*(gA2 + gB2);
  vu1 += (gr1 - vu1)*vuC; vu2 += (gr2 - vu2)*vuC;
);
by_x > 0 ? ( spl0 += (inL - spl0)*by_x; spl1 += (inR - spl1)*by_x; );
byp ? ( vu1 = vu1d *= 0.999; vu2 = vu2d *= 0.999; ) : ( vu1d = vu1; vu2d = vu2; );
a_ = max(abs(spl0), abs(spl1)); lvlM = a_ > lvlM ? a_ : lvlM*0.9999;

@gfx 900 504
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
// =====================================================================
// GUI - 900 x 504 at scale sc. HW = hammertone iron grey with copper screws and amber VU meters (default);
// flat = the same layout on clean dark panels. Stepped settings are stepped dials with their positions printed round them.
// =====================================================================
ui_begin(900, 504);
hw = ui_hw;

function mkfont(idx, size) local(fs, w, h, target) (
  target = 6.6*size; fs = size;
  loop(3, gfx_setfont(idx, "Arial", fs, 'b'); gfx_measurestr("THRESHOLD", w, h); fs = min(max(fs*target/max(w, 1), size*0.75), size*1.8); );
  gfx_setfont(idx, "Arial", fs, 'b'); gfx_measurestr("THRESHOLD", w, h);
  loop(3, w > target*1.01 ? ( fs -= 0.5; gfx_setfont(idx, "Arial", fs, 'b'); gfx_measurestr("THRESHOLD", w, h); ); );
  fs;
);
sc != f_fsc ? ( f_fsc = sc; f_f6 = mkfont(6, 8.5*sc); f_f8 = mkfont(8, 7.5*sc); f_f13 = mkfont(13, 8*sc); f_f7 = mkfont(7, 6.5*sc); );
gfx_setfont(6, "Arial", f_f6, 'b'); gfx_setfont(8, "Arial", f_f8, 'b'); gfx_setfont(13, "Arial", f_f13, 'b'); gfx_setfont(7, "Arial", f_f7, 'b');
gfx_setfont(12, "Georgia", 26*sc, 'b'); gfx_setfont(9, "Courier New", 15*sc, 'b');

CU = 0xE8A26A; INK = 0xE8E2D6; INK2 = 0xB8B2A8; INK3 = 0x6A665E;

function R(x, y, w, h) ( gfx_rect(x*sc, y*sc, max(1, w*sc), max(1, h*sc)); );
function RR(x, y, w, h, r) ( rd_rr(x*sc, y*sc, w*sc, h*sc, r*sc); );
function CI(x, y, r) ( gfx_circle(x*sc, y*sc, r*sc, 1, 1); );
function LN(x1, y1, x2, y2) ( gfx_line(x1*sc, y1*sc, x2*sc, y2*sc, 1); );
function LNW(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, i, o) (
  dx = x2 - x1; dy = y2 - y1; l = sqrt(dx*dx + dy*dy) + 0.0001; nx = -dy/l; ny = dx/l;
  i = 0; loop(max(1, ceil(w*sc)), o = (i - (ceil(w*sc) - 1)*0.5)/sc;
    gfx_line((x1 + nx*o)*sc, (y1 + ny*o)*sc, (x2 + nx*o)*sc, (y2 + ny*o)*sc, 1); i += 1; );
);
function TC(cx, cy, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = cx*sc - w*0.5; gfx_y = cy*sc - h*0.5; gfx_drawstr(t); );
function TL(x, cy, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = x*sc; gfx_y = cy*sc - h*0.5; gfx_drawstr(t); );
function inbox(x, y, w, h) ( mouse_x >= x*sc && mouse_x < (x + w)*sc && mouse_y >= y*sc && mouse_y < (y + h)*sc; );
function hitbox(x, y, w, h) local(h_) ( h_ = pressed && drag_id == 0 && inbox(x, y, w, h); h_ ? drag_id = -1; h_; );
function bright(c) ( (c & 255) + ((c >> 8) & 255) + ((c >> 16) & 255) > 450; );
function setv(idx, v) ( slider(idx) = v; ui_auto(idx); );
function tog(idx) ( slider(idx) = slider(idx) < 0.5; ui_auto(idx); );

function key(x, y, w, h, t, on, c, dim) local(hov, hit, dn) (
  hov = inbox(x, y, w, h);
  hit = !dim && pressed && drag_id == 0 && hov; hit ? drag_id = -1;
  dn = hov && mdown && drag_id == -1;
  hw ? (
    ui_cola(0x000000, 0.5); RR(x + 1, y + 2, w, h, 3);
    ui_col(0x141516); RR(x - 1, y - 1, w + 2, h + 2, 4);
    ui_col(on ? c : (dn ? 0x262728 : 0x2E2F31)); RR(x, y, w, h, 3);
    on ? ( ui_cola(0xFFFFFF, 0.25); RR(x + 2, y + 2, w - 4, h*0.42, 2); ) : ( ui_cola(0xFFFFFF, 0.05); RR(x + 1, y + 1, w - 2, h*0.45, 2); );
    gfx_setfont(13); ui_col(on ? (bright(c) ? 0x141414 : 0xFFFFFF) : INK2);
  ) : (
    ui_col(on ? c : (hov ? 0x5C5E60 : 0x46484A)); RR(x, y, w, h, 4);
    ui_col(on ? ui_mix(0x26272A, c, 0.14) : (dn ? 0x242527 : 0x2C2D30)); RR(x + 1, y + 1, w - 2, h - 2, 3);
    gfx_setfont(13); ui_col(on ? c : INK2);
  );
  TC(x + w*0.5, y + h*0.5, t);
  dim ? ( ui_cola(hw ? 0x2C2E30 : 0x222326, 0.6); RR(x - 1, y - 1, w + 2, h + 2, 4); );
  hit;
);
// knob: black skirt, cap colour, copper pointer
function knob(idx, cx, cy, r, lo, hi, def, cap, label, val, dim) local(v, n, dx, dy, hov, did, a, i, t) (
  did = 1600 + idx;
  dx = mouse_x - cx*sc; dy = mouse_y - cy*sc; hov = !dim && dx*dx + dy*dy <= sqr((r + 6)*sc);
  v = slider(idx);
  pressed && hov && drag_id == 0 ? (
    time_precise() - k_lt < 0.35 && k_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; k_lt = 0; ) :
      ( drag_id = did; k_y = mouse_y; k_n = (v - lo)/(hi - lo); k_lt = time_precise(); k_lid = idx; );
  );
  drag_id == did ? (
    k_n = min(max(k_n + (k_y - mouse_y)/(((mouse_cap & 8) ? 1200 : 180)*sc), 0), 1); k_y = mouse_y;
    v = lo + k_n*(hi - lo); slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    slider(idx) = min(max(v + (hi - lo)*mouse_wheel/120*((mouse_cap & 8) ? 0.005 : 0.025), lo), hi); ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo)/(hi - lo), 0), 1); a = (-0.75 + 1.5*n)*$pi;
  ui_col(dim ? INK3 : INK); i = 0;
  loop(11, t = (-0.75 + 1.5*i/10)*$pi; LNW(cx + sin(t)*(r + 4), cy - cos(t)*(r + 4), cx + sin(t)*(r + 8), cy - cos(t)*(r + 8), 1.1); i += 1; );
  ui_cola(0x000000, 0.45); CI(cx + 1.5, cy + 2.5, r);
  i = 0; loop(14, ui_col(ui_mix(0x141516, 0x4A4C4E, (i/13)^1.5)); CI(cx - i*r*0.012, cy - i*r*0.014, r*(1 - i*0.035)); i += 1; );   // matte: a soft, even sheen
  ui_col(0x141516); CI(cx, cy, r*0.8);
  ui_col(0x3A3C3E); CI(cx, cy, r*0.72); ui_col(dim ? ui_mix(cap, 0x2E3032, 0.65) : cap); CI(cx, cy, r*0.72 - 1);
  ui_col(dim ? INK3 : CU); LNW(cx + sin(a)*r*0.25, cy - cos(a)*r*0.25, cx + sin(a)*(r - 2), cy - cos(a)*(r - 2), 2.2);
  gfx_setfont(6); ui_col(dim ? INK3 : INK); TC(cx, cy + r + 16, label);
  (hov || drag_id == did) ? ( gfx_setfont(7); ui_cola(0x000000, 0.6); gfx_measurestr(val, tw_, th_); RR(cx - tw_/(2*sc) - 4, cy + r + 23, tw_/sc + 8, 11, 2);
    ui_col(0xFFFFFF); TC(cx, cy + r + 28.5, val); );
);
// stepped dial: n positions, labels printed round it; drag, wheel, double-click = default
function sknob(idx, cx, cy, r, n, def, label, l0, l1, l2, l3, l4, l5, dim) local(v, dx, dy, hov, did, a, i, t) (
  did = 1600 + idx;
  dx = mouse_x - cx*sc; dy = mouse_y - cy*sc; hov = !dim && dx*dx + dy*dy <= sqr((r + 8)*sc);
  v = floor(slider(idx) + 0.5);
  pressed && hov && drag_id == 0 ? (
    time_precise() - k_lt < 0.35 && k_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; k_lt = 0; ) :
      ( drag_id = did; k_y = mouse_y; k_n = v/(n - 1); k_lt = time_precise(); k_lid = idx; );
  );
  drag_id == did ? (
    k_n = min(max(k_n + (k_y - mouse_y)/(110*sc), 0), 1); k_y = mouse_y;
    v = floor(k_n*(n - 1) + 0.5); slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( slider(idx) = min(max(v + sign(mouse_wheel), 0), n - 1); ui_auto(idx); mouse_wheel = 0; );
  v = floor(slider(idx) + 0.5); a = (-0.75 + 1.5*v/(n - 1))*$pi;
  gfx_setfont(7); i = 0;
  loop(n, t = (-0.75 + 1.5*i/(n - 1))*$pi;
    ui_col(dim ? INK3 : INK); LNW(cx + sin(t)*(r + 4), cy - cos(t)*(r + 4), cx + sin(t)*(r + 8), cy - cos(t)*(r + 8), 1.1);
    ui_col(dim ? INK3 : (i == v ? CU : INK2));
    TC(cx + sin(t)*(r + 17), cy - cos(t)*(r + 17), i == 0 ? l0 : i == 1 ? l1 : i == 2 ? l2 : i == 3 ? l3 : i == 4 ? l4 : l5);
    i += 1; );
  ui_cola(0x000000, 0.45); CI(cx + 1.5, cy + 2.5, r);
  i = 0; loop(14, ui_col(ui_mix(0x141516, 0x4A4C4E, (i/13)^1.5)); CI(cx - i*r*0.012, cy - i*r*0.014, r*(1 - i*0.035)); i += 1; );   // matte: a soft, even sheen
  ui_col(0x141516); CI(cx, cy, r*0.8); ui_col(0x3A3C3E); CI(cx, cy, r*0.72); ui_col(0x1C1D1E); CI(cx, cy, r*0.72 - 1);
  ui_col(dim ? INK3 : CU); LNW(cx + sin(a)*r*0.25, cy - cos(a)*r*0.25, cx + sin(a)*(r - 2), cy - cos(a)*(r - 2), 2.2);
  gfx_setfont(6); ui_col(dim ? INK3 : INK); TC(cx, cy + r + 26, label);
);
function screw(x, y) (
  hw ? ( ui_col(0x5A3418); CI(x, y + 0.6, 4.2); ui_col(0xC8844E); CI(x, y, 4); ui_col(0xE8A26A); CI(x - 0.8, y - 0.8, 2.6);
         ui_col(0x5A3418); LNW(x - 2.6, y, x + 2.6, y, 1.2); );
);
function panel(x, y, w, h, title) (
  hw ? ( ui_cola(0x000000, 0.4); RR(x + 1, y + 3, w, h, 6); ui_col(0x4A4C4E); RR(x, y, w, h, 6); ui_col(0x2E3032); RR(x + 1, y + 1, w - 2, h - 2, 5);
         screw(x + 9, y + 9); screw(x + w - 9, y + 9); screw(x + 9, y + h - 9); screw(x + w - 9, y + h - 9); )
     : ( ui_col(0x3A3C3F); RR(x, y, w, h, 8); ui_col(0x232427); RR(x + 1, y + 1, w - 2, h - 2, 7); );
  gfx_setfont(6); ui_col(CU); TC(x + w*0.5, y + 16, title);
);
// VU (gain reduction): 0 at the right, 20 dB at the left
function vu(x, y, w, h, gr) local(cx, cy, k, a, rr, tw, th) (
  ui_vu_dim = slider18 > 0.5; ui_spill((x - 4)*sc, (y - 4)*sc, (w + 8)*sc, (h + 8)*sc, 0.4);   // dims while bypassed
  hw ? ( ui_col(0xA8602E); RR(x - 4, y - 4, w + 8, h + 8, 6); ui_col(0xE8A26A); RR(x - 3, y - 3, w + 6, 2, 1); )
     : ( ui_col(0x3A3C3F); RR(x - 3, y - 3, w + 6, h + 6, 6); );
  ui_glow(x*sc, y*sc, w*sc, h*sc, 1);                                       // backlit (gfx-ui ui_glow), kept subtle (JG):
  ui_cola(0xE2A85A, 0.45); RR(x, y, w, h, 4);                                // the old amber face over it at 45 %
  gfx_gradrect(x*sc, y*sc, w*sc, h*sc, 1, 0.86, 0.63, 0.45, 0, 0, 0, 0, -0.06/(h*sc), -0.16/(h*sc), -0.2/(h*sc), 0);
  cx = x + w*0.5; cy = y + h + 22; rr = h + 4;
  gfx_setfont(8); ui_col(0x2A1A0A);
  k = 0;
  loop(6,
    a = (-40 + k*16)*$pi/180;
    LNW(cx + sin(a)*rr, cy - cos(a)*rr, cx + sin(a)*(rr + 8), cy - cos(a)*(rr + 8), 1.3);
    TC(cx + sin(a)*(rr + 17), cy - cos(a)*(rr + 17), k == 0 ? "20" : k == 1 ? "15" : k == 2 ? "10" : k == 3 ? "6" : k == 4 ? "3" : "0");
    k += 1;
  );
  gfx_setfont(8); ui_col(0x2A1A0A); TC(cx, y + h - 24, "12AX7 + 12AU7"); gfx_setfont(7); ui_col(0x5A3A1A); TC(cx, y + h - 12, "GAIN REDUCTION dB");
  // needle: position by the scale's spacing (20 15 10 6 3 0)
  a = gr >= 20 ? 0 : gr >= 15 ? (20 - gr)/5 : gr >= 10 ? 1 + (15 - gr)/5 : gr >= 6 ? 2 + (10 - gr)/4 : gr >= 3 ? 3 + (6 - gr)/3 : 4 + (3 - max(gr, 0))/3;
  a = (-40 + a*16)*$pi/180;
  ui_col(0x1A0F05);
  // clip the needle to the face
  LNW(cx + sin(a)*(cy - y - h + 2)/cos(a), y + h - 2, cx + sin(a)*(rr + 6), cy - cos(a)*(rr + 6), 1.4);
  ui_cola(0xFFFFFF, 0.1); R(x + 2, y + 2, w - 4, h*0.4);
);
function fdb(v) ( floor(v*10 + 0.5) == 0 ? strcpy(#vt, "0.0 dB") : sprintf(#vt, "%+.1f dB", v); #vt; );
function go_preset(n) local(i) ( slider1 = n; apply_preset(n); lastPreset = n; i = 1; loop(33, ui_auto(i); i += 1; ); );

// ---- background ----
hw ? (
  ui_col(0x353739); R(0, 0, 900, 504);
  k = 0; loop(600, ui_cola((k & 1) ? 0xFFFFFF : 0x000000, 0.035); CI(900*rd_hash(k*2 + 1), 504*rd_hash(k*2 + 7.3), 0.8 + 2*rd_hash(k + 0.5)); k += 1; );
) : ( ui_col(0x1D1E20); R(0, 0, 900, 504); );
ui_col(0x1A1B1C); R(0, 0, 900, 56); ui_col(hw ? 0xA8602E : CU); R(0, 55, 900, 2);
ui_col(0xC8402A); CI(34, 28, 14); gfx_setfont(2); ui_col(0xFFFFFF); ui_text(34*sc, 23*sc, "GFX");
gfx_setfont(12); ui_col(CU); TL(58, 23, "FERRUM"); ver_tag("v3", 16, 0, 0);
gfx_setfont(7); ui_col(INK2); TL(59, 44, "DUAL-VALVE MASTERING COMPRESSOR");
ui_col(0x0C0A08); RR(300, 10, 240, 36, 4);
gfx_setfont(9); ui_col(0xFFB46A); TL(314, 28, pname(slider1));
hitbox(300, 10, 240, 36) ? (
  strcpy(#pm, ""); k = 0; loop(10, k == slider1 ? strcat(#pm, "!"); strcat(#pm, pname(k)); k < 9 ? strcat(#pm, "|"); k += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y; ps_ = gfx_showmenu(#pm); ps_ > 0 ? go_preset(ps_ - 1);
);
key(550, 13, 28, 30, "<", 0, CU, 0) ? go_preset((slider1 + 9) % 10);
key(584, 13, 28, 30, ">", 0, CU, 0) ? go_preset((slider1 + 1) % 10);
key(712, 16, 30, 24, "S", ui_sz == 1, CU, 0) ? ui_sz = 1;
key(748, 16, 30, 24, "M", ui_sz == 0, CU, 0) ? ui_sz = 0;
key(784, 16, 30, 24, "L", ui_sz == 2, CU, 0) ? ui_sz = 2;
key(820, 16, 30, 24, "?", ui_help_open, CU, 0) ? ( ui_help_open = 1; ui_help_new = 1; );
key(856, 16, 30, 24, "HW", hw, CU, 0) ? ( ui_hw = 1 - ui_hw; ui_bgok = 0; );

// ---- the two channels ----
function chan(x0, b, ttl, gr, isone) local(dim, xb) (
  dim = !isone && slider16 > 0.5 && slider17 < 0.5;  // LINK: channel 1 drives channel 2's settings
  xb = isone ? 28 : 31;
  panel(x0, 68, 334, 324, ttl);
  vu(x0 + 57, 100, 220, 84, gr);
  knob(b, x0 + 80, 240, 22, -20, 20, 10, 0x1C1D1E, "THRESHOLD", fdb(slider(b)), dim);
  sprintf(#bv, "%.1f", slider(b + 1));
  knob(b + 1, x0 + 167, 240, 22, 0, 10, 5, 0x1C1D1E, "TUBE BIAS", #bv, dim);
  knob(b + 2, x0 + 254, 240, 22, 0, 20, 0, 0x1C1D1E, "GAIN", fdb(slider(b + 2)), dim);
  sknob(b + 3, x0 + 60, 336, 14, 6, 2, "ATTACK", "1", "2", "3", "4", "5", "6", dim);
  sknob(b + 4, x0 + 138, 336, 14, 6, 2, "RELEASE", "1", "2", "3", "4", "5", "6", dim);
  sknob(b + 5, x0 + 216, 336, 14, 6, 1, "RECTIFIER", "GE", "SI", "LED", "G+S", "S+L", "ALL", dim);
  slider(b + 6) < 20 ? strcpy(#hp, "OFF") : sprintf(#hp, "%d Hz", slider(b + 6));
  knob(b + 6, x0 + 290, 336, 14, 0, 330, 0, 0xF2C83E, "SC HPF", #hp, dim);
  // sidechain keys beside the meter
  gfx_setfont(7); ui_col(dim ? INK3 : INK2); TC(x0 + 306, 100, "SC");
  key(x0 + 286, 108, 40, 20, "LIFT", slider(xb) > 0.5, 0xF2C83E, dim) ? tog(xb);
  key(x0 + 286, 134, 40, 20, "FOCUS", slider(xb + 1) > 0.5, 0xF2C83E, dim) ? tog(xb + 1);
  key(x0 + 286, 160, 40, 20, "EXT", slider(xb + 2) > 0.5, CU, dim) ? tog(xb + 2);
);
chan(14, 2, slider17 > 0.5 ? "1  -  MID" : "1  -  LEFT", vu1, 1);
chan(552, 9, slider17 > 0.5 ? "2  -  SIDE" : "2  -  RIGHT", vu2, 0);

// ---- master ----
panel(356, 68, 188, 324, "MASTER");
// valve window: a wide, narrow lit strip
glow += (min(1, 0.25 + 0.5*min(1, (vu1 + vu2)/10) + 0.25*min(1, lvlM*3)) - glow)*0.2;
ui_col(0x120A04); RR(372, 96, 156, 30, 9);
k = 0; loop(8, ui_cola(0xFF7A1A, (0.06 + 0.05*k)*glow); RR(376 + k*4, 100 + k*1.6, 148 - k*8, 22 - k*3.2, 7 - k*0.6); k += 1; );
ui_cola(0xFFC88A, 0.5*glow); RR(410, 108, 80, 6, 3);
gfx_setfont(7); ui_col(INK2); TC(450, 142, "VALVES");
key(372, 166, 52, 22, "LINK", slider16 > 0.5, CU, 0) ? ( tog(16); slider16 > 0.5 && slider17 > 0.5 ? setv(17, 0); );   // LINK and M/S exclude each other
key(430, 166, 52, 22, "M/S", slider17 > 0.5, CU, 0) ? ( tog(17); slider17 > 0.5 && slider16 > 0.5 ? setv(16, 0); );
key(488, 166, 52, 22, "BYPASS", slider18 > 0.5, 0xFF6A4A, 0) ? tog(18);
sprintf(#mx, "%d %%", slider19); knob(19, 400, 236, 18, 0, 100, 100, 0x1C1D1E, "MIX", #mx, 0);
knob(20, 500, 236, 18, -12, 12, 0, 0x1C1D1E, "OUTPUT", fdb(slider20), 0);
