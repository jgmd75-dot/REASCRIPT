desc:MasterSuite [mastering strip] (GFX)
//tags: mastering channel strip saturation eq mid-side compressor limiter clipper
//author: JGWizrad / Garden FX (GFX)
//
// A modular mastering strip (personal use; designed from scratch), in seven stages:
//   1 INPUT      - trim, and the oversampling wrapper (linear-phase half-band FIR, 2x / 4x) for the non-linear stages
//   2 TUBE + TONE - asymmetric valve saturation (BIAS low / mid / high), then a broad 4-band EQ and a tape roll-off
//   3 STEREO     - mid / side: MONO MAKER (a 24 dB/oct high-pass on the side only: the lows go mono) and side WIDTH
//   4 VARI-MU    - stereo-linked RMS compressor in the log domain, soft knee; like a valve vari-mu the ratio grows a
//                  little as it works harder. RECTIFIER sets the timing: GERMANIUM slow and smooth, SILICON medium,
//                  LED fast; the release slows after long gain reduction (program-dependent). MIX = parallel blend.
//   5 HF LIMITER - a fast peak limiter keyed from above 6 kHz that turns down only the top band, for harshness and
//                  sibilance. The split is a Linkwitz-Riley crossover (both bands stay in phase, so turning the top
//                  down is a true cut and at rest the response is flat)
//   6 CLIPPER    - DRIVE into a SOFT (polynomial) or HARD clipper at 0 dBFS, oversampled with the same setting
//   7 LIMITER    - true-peak brickwall: inter-sample peaks are found by 4x interpolation, 1.5 ms lookahead, and
//                  the gain is shaped so it never overshoots the CEILING; RELEASE sets the recovery
// Every stage has its own bypass switch (each crossfades over 10 ms, so switching never clicks).
// Latency (oversampling + lookahead) is reported to the host.
//
// LINK (INPUT, top left): lit (the default) - the VARI-MU, the HF LIMITER and the LIMITER each hear both sides
// and turn them down together, so the image stays put. Dark: dual mono - each side has its own detector and gain
// in all three, so a loud hit on one side leaves the other alone. A change crossfades over 10 ms.
//
// OUTPUT gain feeds the limiter, so the CEILING always has the final say.
// INPUT (top left): the input TRIM and the GFX output stage's SAT (band saturation),
// which sits just before the true-peak limiter.
// DRIFT (in TUBE): the valve's bias and drive wander a little. The dial scales the drift amount
// (50% = the Drift amount setting, 100% = twice, 0 = none) and speeds the wander up with it.
//
// OS (header, left of the size picker): the oversampling - 1x, 2x (the default), 4x; each click steps on (the house
// OS key). A change ducks the output, swaps at silence and comes back, as a preset does.
//
// BYPASS: lit = bypassed - the output crossfades (15 ms) to the untouched input, kept in time with the latency,
//   so it never clicks the way REAPER's own on / off can.
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate, gfx-instrument
//, gfx-os and gfx-bypass (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc

slider1:0<-12,12,0.1>-Input trim (dB)
slider2:1<0,2,1{1x,2x,4x}>-Oversampling
slider3:1<0,1,1{Bypass,On}>-Tube stage
slider4:-3<-12,12,0.1>-Tube drive (dB)
slider5:1<0,2,1{Low,Mid,High}>-Tube bias
slider6:1<0,1,1{Bypass,On}>-Tone stage
slider7:0<-6,6,0.1>-Bass (dB, 90 Hz shelf)
slider8:0<-6,6,0.1>-Low-mid (dB, 350 Hz)
slider9:0<-6,6,0.1>-High-mid (dB, 2.8 kHz)
slider10:0<-6,6,0.1>-Presence (dB, 7 kHz shelf)
slider11:0<0,1,1{Off,On}>-Tape roll-off (18 kHz)
slider12:1<0,1,1{Bypass,On}>-Stereo stage
slider13:20<20,200,1>-Mono maker (Hz, 20 = off)
slider14:100<0,200,1>-Side width (%)
slider15:0<0,1,1{Bypass,On}>-Compressor
slider16:-18<-40,0,0.1>-Comp threshold (dB)
slider17:2<1,10,0.1>-Comp ratio
slider18:6<0,12,0.1>-Comp knee (dB)
slider19:1<0,2,1{Germanium,Silicon,LED}>-Comp rectifier
slider20:0<0,12,0.1>-Comp makeup (dB)
slider21:100<0,100,1>-Comp mix (%)
slider22:0<0,1,1{Bypass,On}>-HF limiter
slider23:-12<-30,0,0.1>-HF limiter threshold (dB)
slider24:0<0,2,1{Bypass,Soft,Hard}>-Clipper
slider25:0<0,12,0.1>-Clipper drive (dB)
slider26:1<0,1,1{Bypass,On}>-True-peak limiter
slider27:-0.3<-1,-0.1,0.01>-Limiter ceiling (dB)
slider28:80<10,500,1>-Limiter release (ms)
slider29:0<-12,12,0.1>-Output (dB, into the limiter)
slider30:10<0,50,1>-Drift amount (%)
slider31:0.2<0.02,2,0.01>-Drift speed (Hz)
slider32:0<0,100,1>-Band sat (%)
slider33:30<0,100,1>-Bias (%)
slider34:120<40,400,1>-Sat low band (Hz)
slider35:6000<2000,16000,10>-Sat high band (Hz)
slider36:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider37:0<0,1,1{Off,Clip}>-(unused, was output stage)
slider38:50<0,100,1>-Drift (%)
slider39:1<0,1,1{Off,On}>-Link
slider40:0<0,1,1{Off,On}>-Bypass
slider41:prs_sel=0<0,10,1{No preset,Transparent,Warm Glue,Loud & Punchy,Vintage Tape,Bright Pop,Bass Heavy,Acoustic / Classical,Podcast / Voice,Parallel Punch,Streaming Safe (-1 dBTP)}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;                                       // keep the state across transport start / stop (no reset mid-signal)
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
#ui_man = "gfx-mastersuite";                                  // the ? pop-up links to this manual

// ======================================================================
//  CORE MATH HELPERS
// ======================================================================
function db2g(d) ( 10 ^ (d / 20); );
function g2db(g) ( 20 * log10(max(g, 0.0000000001)); );
function tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function coef(ms) ( 1 - exp(-1 / (max(ms, 0.001) * 0.001 * srate)); );        // one-pole smoothing coefficient

// ---------- RBJ biquad (transposed direct form II) ----------
// type 0 low-pass, 1 high-pass, 2 bell, 3 high shelf, 4 low shelf; q = Q (shelves: slope)
function bq_set(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w, cw, sw, al, A, sa, n) (
  f = min(max(f, 5), fs * 0.45);
  w = 2 * $pi * f / fs; cw = cos(w); sw = sin(w); A = 10 ^ (gdb / 40);
  type <= 2 ? al = sw / (2 * q) : al = sw / 2 * sqrt((A + 1 / A) * (1 / q - 1) + 2);
  type == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / A; b0 = (1 + al * A) / n; b1 = -2 * cw / n; b2 = (1 - al * A) / n; a1 = b1; a2 = (1 - al / A) / n; ) :
  type == 3 ? (
    sa = 2 * sqrt(A) * al; n = (A + 1) - (A - 1) * cw + sa;
    b0 = A * ((A + 1) + (A - 1) * cw + sa) / n; b1 = -2 * A * ((A - 1) + (A + 1) * cw) / n;
    b2 = A * ((A + 1) + (A - 1) * cw - sa) / n; a1 = 2 * ((A - 1) - (A + 1) * cw) / n; a2 = ((A + 1) - (A - 1) * cw - sa) / n;
  ) : (
    sa = 2 * sqrt(A) * al; n = (A + 1) + (A - 1) * cw + sa;
    b0 = A * ((A + 1) - (A - 1) * cw + sa) / n; b1 = 2 * A * ((A - 1) - (A + 1) * cw) / n;
    b2 = A * ((A + 1) - (A - 1) * cw - sa) / n; a1 = -2 * ((A - 1) + (A + 1) * cw) / n; a2 = ((A + 1) + (A - 1) * cw - sa) / n;
  );
);
function bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);

// ---------- half-band FIR (linear phase), polyphase ----------
// K taps per side on the odd offsets (the centre tap is 0.5, the even offsets are zero).
// Up by 2: input x -> two output samples (returned even, the odd one in .o).  Down by 2: two in -> one out.
// Delay: K samples at the lower rate for each direction.
function i0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= (x / (2 * k)) ^ 2; s += t; k += 1; ); s; );
function hb_taps(h, K, beta) local(j, o, w, sum) (
  sum = 0; j = 0;
  loop(K,
    o = 2 * j + 1;
    w = i0(beta * sqrt(max(1 - (o / (2 * K)) ^ 2, 0))) / i0(beta);                  // Kaiser window
    h[j] = 0.5 * sin($pi * o / 2) / ($pi * o / 2) * w;
    sum += h[j]; j += 1;
  );
  j = 0; loop(K, h[j] *= 0.25 / sum; j += 1; );                                     // unity gain at DC
);
function hb_init(K, h, mem) instance(kk, hh, xb, eb, pos, L) (
  kk = K; hh = h; L = 2 * K + 1; xb = mem; eb = mem + 2 * L; pos = 0;
  memset(mem, 0, 4 * L);
);
function hb_up(x) instance(kk, hh, xb, pos, L, o) local(j, n, s) (
  xb[pos] = x; xb[pos + L] = x; pos += 1; pos >= L ? pos = 0;                         // newest at xb[pos + L - 1]
  n = pos + L - 1; s = 0; j = 0;
  loop(kk, s += hh[j] * (xb[n - kk - j] + xb[n - kk + 1 + j]); j += 1; );
  o = 2 * s;                                                                         // the in-between sample
  xb[n - kk];                                                                        // the original sample, delayed
);
function hb_down(e, od) instance(kk, hh, xb, eb, pos, L) local(j, n, s) (
  xb[pos] = od; xb[pos + L] = od; eb[pos] = e; eb[pos + L] = e; pos += 1; pos >= L ? pos = 0;
  n = pos + L - 1; s = 0; j = 0;
  loop(kk, s += hh[j] * (xb[n - kk - j - 1] + xb[n - kk + j]); j += 1; );
  0.5 * eb[n - kk] + s;
);

// ---------- valve stage: asymmetric tanh, unity gain for small signals ----------
// y = (tanh(k x + b) - tanh(b)) / (k (1 - tanh(b)^2))
function tube(x, k, b, tb) ( (tanh(k * x + b) - tb) / (k * (1 - tb * tb)) * tmk; );
// (tmk: make-up as DRIVE rises above 0 dB, so turning it up adds saturation rather than losing level)

// ---------- one channel's oversampled tube block ----------
// os 0: straight through; 1: 2x; 2: 4x. mix = the stage's on / bypass crossfade (inside, so timing never changes).
function tube_run(x) instance(u1, u2, d1, d2) local(e, o, a0, a1, a2, a3, de, dn) (
  os_n == 0 ? (
    x + (tube(x, tk, tb, ttb) - x) * tmix;
  ) : os_n == 1 ? (
    e = u1.hb_up(x); o = u1.o;
    e += (tube(e, tk, tb, ttb) - e) * tmix; o += (tube(o, tk, tb, ttb) - o) * tmix;
    d1.hb_down(e, o);
  ) : (
    e = u1.hb_up(x); o = u1.o;
    a0 = u2.hb_up(e); a1 = u2.o; a2 = u2.hb_up(o); a3 = u2.o;
    a0 += (tube(a0, tk, tb, ttb) - a0) * tmix; a1 += (tube(a1, tk, tb, ttb) - a1) * tmix;
    a2 += (tube(a2, tk, tb, ttb) - a2) * tmix; a3 += (tube(a3, tk, tb, ttb) - a3) * tmix;
    de = d2.hb_down(a0, a1); dn = d2.hb_down(a2, a3);
    d1.hb_down(de, dn);
  );
);

// ---------- soft-knee gain computer (dB in -> gain reduction in dB, <= 0) ----------
function knee_gr(lv, thr, ratio, knee) local(o, sl) (
  o = lv - thr; sl = 1 / ratio - 1;
  2 * o < -knee ? 0 : 2 * abs(o) <= knee ? sl * sqr(o + knee * 0.5) / (2 * knee) : sl * o;
);

// ---------- clipper: soft = cubic that lands flat at 1 (from 1.5), hard = clamp ----------
function clip_s(u) ( abs(u) >= 1.5 ? sign(u) : u - 0.148148148 * u * u * u; );
function clip_x(u) ( clip_mode == 1 ? clip_s(u) : min(max(u, -1), 1); );
// one channel's oversampled clipper (same structure as the tube block)
function clip_run(x) instance(u1, u2, d1, d2) local(e, o, a0, a1, a2, a3, de, dn) (
  x *= cdrv;
  os_n == 0 ? (
    x + (clip_x(x) - x) * cmix;
  ) : os_n == 1 ? (
    e = u1.hb_up(x); o = u1.o;
    e += (clip_x(e) - e) * cmix; o += (clip_x(o) - o) * cmix;
    d1.hb_down(e, o);
  ) : (
    e = u1.hb_up(x); o = u1.o;
    a0 = u2.hb_up(e); a1 = u2.o; a2 = u2.hb_up(o); a3 = u2.o;
    a0 += (clip_x(a0) - a0) * cmix; a1 += (clip_x(a1) - a1) * cmix;
    a2 += (clip_x(a2) - a2) * cmix; a3 += (clip_x(a3) - a3) * cmix;
    de = d2.hb_down(a0, a1); dn = d2.hb_down(a2, a3);
    d1.hb_down(de, dn);
  );
);

// ---------- true-peak: 4x interpolation of the last 8 samples (inter-sample peaks), 4 samples late ----------
TPH = 1300;                                       // 3 phases x 8 taps
function tp_taps() local(ph, k, t, w) (
  ph = 1;
  loop(3,
    k = 0;
    loop(8,
      t = (k - 3) - ph / 4;                       // tap position relative to the point between x[3] and x[4]
      w = 0.5 + 0.5 * cos($pi * t / 4.5);         // Hann
      TPH[(ph - 1) * 8 + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
      k += 1;
    );
    ph += 1;
  );
);
function tp_peak(x) instance(buf, pos) local(n, m, ph, k, v) (
  buf[pos] = x; buf[pos + 8] = x; pos = (pos + 1) & 7;     // oldest at buf[pos], newest at buf[pos + 7]
  n = buf + pos;
  m = abs(n[3]);
  ph = 0;
  loop(3,
    v = 0; k = 0; loop(8, v += TPH[ph * 8 + k] * n[k]; k += 1; );
    m = max(m, abs(v)); ph += 1;
  );
  m;
);

// ======================================================================
//  MEMORY + STATE
// ======================================================================
K1 = 16; K2 = 8;                        // 2x stage: 63-tap half-band; the 4x stage (already band-limited): 31 taps
H1 = 1000; H2 = 1100;
hb_taps(H1, K1, 8); hb_taps(H2, K2, 7);
// oversampler ring buffers (4 * (2K + 1) each)
tL.u1.hb_init(K1, H1, 2000); tL.d1.hb_init(K1, H1, 2200); tL.u2.hb_init(K2, H2, 2400); tL.d2.hb_init(K2, H2, 2500);
tR.u1.hb_init(K1, H1, 2600); tR.d1.hb_init(K1, H1, 2800); tR.u2.hb_init(K2, H2, 3000); tR.d2.hb_init(K2, H2, 3100);

// clipper oversamplers
cL.u1.hb_init(K1, H1, 3200); cL.d1.hb_init(K1, H1, 3400); cL.u2.hb_init(K2, H2, 3600); cL.d2.hb_init(K2, H2, 3700);
cR.u1.hb_init(K1, H1, 3800); cR.d1.hb_init(K1, H1, 4000); cR.u2.hb_init(K2, H2, 4200); cR.d2.hb_init(K2, H2, 4300);
// true-peak limiter: detector rings, audio delay lines, gain ring for the lookahead minimum and average
tp_taps();
tpL.buf = 4400; tpR.buf = 4420; memset(4400, 0, 40);
LA = max(1, floor(0.0015 * srate));      // lookahead
LDEL = LA + 3;                           // the audio waits for the lookahead and the detector (4 late, held over LA)
DLL = 10000; DLR = 12100; GRB = 14200;       // 2048 each, kept apart
memset(DLL, 0, 2048); memset(DLR, 0, 2048); memset(GRB, 0, 2048);
lmA.buf = 16400; lmB.buf = 18500;            // LINK off: each side's own lookahead gains, 2048 each
gi = 0; loop(2048, GRB[gi] = 1; gi += 1; );
lw = 0; l_sum = LA; l_g = 1; l_gm_d = 1;

sm10 = coef(10);                        // 10 ms: bypass crossfades, gain changes
msx_dkr = 1 / (0.012 * srate); msx_dk = 1; msx_dst = 0;   // preset duck: 12 ms out, hold through the latency, 12 ms in
sm30 = coef(30);
hf_att = coef(0.3); hf_rel = coef(60);
dw = 0;
ost_init(30000); ostL.ost_ch_init(); ostR.ost_ch_init();
dA.drift_init(0.8 + rand(0.5)); dB.drift_init(0.8 + rand(0.5));
dcL.bq_set(1, 5, 0.707, 0, srate); dcR.bq_set(1, 5, 0.707, 0, srate);     // the bias leaves a little DC: 5 Hz high-pass

// smoothed state (start at their targets)
function targets() (
  in_t = db2g(slider1);
  // the OS key: a change ducks the output first and is taken at the silent point (as a preset's settings are)
  mz_osi ? ( slider2 != os_n ? ( msx_dst == 0 ? msx_dst = 1 : msx_dst == 1 && msx_dk <= 0 ? os_n = slider2; ); ) : ( os_n = slider2; mz_osi = 1; );
  tmix_t = slider3;
  bias_b = slider5 == 0 ? 0.05 : slider5 == 1 ? 0.15 : 0.3;                       // asymmetry: more even harmonics
  bias_k = slider5 == 0 ? 0.85 : slider5 == 1 ? 1 : 1.2;                           // and how hard it bites
  tk_t = db2g(slider4) * bias_k;
  tmk_t = max(db2g(slider4), 1) ^ 0.55;
  eq_t = slider6;
  out_t = db2g(slider29);
  st_t = slider12;
  wid_t = slider14 / 100;
  cmp_t = slider15;
  c_thr = slider16; c_ratio = slider17; c_knee = max(slider18, 0.01);
  // rectifier timing: RMS window, attack, release (fast part), release (slow part)
  slider19 == 0 ? ( c_rms = 30; c_att = 30; c_rel = 350; c_rel2 = 1500; ) :     // germanium: slow, smooth
  slider19 == 1 ? ( c_rms = 15; c_att = 10; c_rel = 180; c_rel2 = 900; ) :      // silicon: medium
                  ( c_rms = 5;  c_att = 2;  c_rel = 70;  c_rel2 = 400; );       // LED: fast
  c_rmsc = coef(c_rms); c_attc = coef(c_att); c_relc = coef(c_rel); c_rel2c = coef(c_rel2);
  c_mk_t = db2g(slider20);
  c_mix_t = slider21 / 100;
  hf_t = slider22; hf_thr = db2g(slider23);
  cmix_t = slider24 > 0; clip_mode = slider24 > 0 ? slider24 : clip_mode; cdrv_t = db2g(slider25);
  slider24 > 0 ? clip_last = slider24;
  lim_t = slider26; l_ceil = db2g(slider27); l_relc = coef(slider28);
  lk_t = slider39 >= 0.5;
);


// ---------- presets (the seven stages; drift and the output stage are left alone - Reset also sets the DRIFT dial) ----------
function p_in(trim, os) ( slider1 = trim; slider2 = os; );
function p_tube(on, drv, bias) ( slider3 = on; slider4 = drv; slider5 = bias; );
function p_tone(on, b, lm, hm, pr, tape) ( slider6 = on; slider7 = b; slider8 = lm; slider9 = hm; slider10 = pr; slider11 = tape; );
function p_st(on, mono, wid) ( slider12 = on; slider13 = mono; slider14 = wid; );
function p_cmp(on, thr, ratio, knee, rect, mk, mix) ( slider15 = on; slider16 = thr; slider17 = ratio; slider18 = knee; slider19 = rect; slider20 = mk; slider21 = mix; );
function p_hf(on, thr) ( slider22 = on; slider23 = thr; );
function p_clip(mode, drv) ( slider24 = mode; slider25 = drv; mode > 0 ? clip_last = mode; );
function p_lim(on, ceil, rel, out) ( slider26 = on; slider27 = ceil; slider28 = rel; slider29 = out; );
function load_preset(p) (
  msx_dst = 1;      // duck the output, swap the settings at silence (oversampling, clipper, EQ), fade back in
  p == 1 ? (        // TRANSPARENT: gentle glue and a safe ceiling, nothing coloured
    p_in(0, 1); p_tube(0, -3, 1); p_tone(1, 0, 0, 0, 0, 0); p_st(1, 30, 100); p_cmp(1, -16, 1.5, 8, 1, 1, 100);
    p_hf(0, -12); p_clip(0, 0); p_lim(1, -1, 120, 2);
  ) : p == 2 ? (    // WARM GLUE
    p_in(0, 1); p_tube(1, -3, 1); p_tone(1, 1, 0, -0.5, 0.5, 1); p_st(1, 80, 100); p_cmp(1, -18, 2, 6, 0, 2, 100);
    p_hf(1, -14); p_clip(1, 2); p_lim(1, -0.5, 100, 4);
  ) : p == 3 ? (    // LOUD & PUNCHY: parallel compression, clipper into the limiter
    p_in(0, 2); p_tube(1, 0, 1); p_tone(1, 1.5, 0, 0.5, 1, 0); p_st(1, 100, 110); p_cmp(1, -20, 3, 4, 2, 3, 70);
    p_hf(1, -12); p_clip(1, 4); p_lim(1, -0.3, 60, 3);
  ) : p == 4 ? (    // VINTAGE TAPE
    p_in(0, 1); p_tube(1, 3, 0); p_tone(1, 1.5, 0, 0, -1, 1); p_st(1, 120, 90); p_cmp(1, -18, 2.5, 8, 0, 2, 100);
    p_hf(1, -10); p_clip(1, 1); p_lim(1, -1, 150, 6);
  ) : p == 5 ? (    // BRIGHT POP
    p_in(0, 1); p_tube(1, -3, 2); p_tone(1, 0, -1, 1, 2, 0); p_st(1, 100, 120); p_cmp(1, -18, 2, 6, 1, 2, 100);
    p_hf(1, -15); p_clip(1, 3); p_lim(1, -0.3, 80, 3);
  ) : p == 6 ? (    // BASS HEAVY: wide mono lows, fast compression, hard clip
    p_in(0, 2); p_tube(1, 0, 1); p_tone(1, 2, -1, 0, 0.5, 0); p_st(1, 150, 110); p_cmp(1, -16, 2.5, 6, 2, 2, 80);
    p_hf(1, -14); p_clip(2, 3); p_lim(1, -0.3, 50, 3);
  ) : p == 7 ? (    // ACOUSTIC / CLASSICAL: almost nothing, slow and wide open
    p_in(0, 1); p_tube(0, -6, 1); p_tone(1, 0.5, 0, 0, 0.5, 0); p_st(1, 20, 100); p_cmp(1, -24, 1.3, 12, 0, 1, 100);
    p_hf(0, -12); p_clip(0, 0); p_lim(1, -1, 300, 2);
  ) : p == 8 ? (    // PODCAST / VOICE: mono, forward, de-essed, steady
    p_in(0, 1); p_tube(1, -6, 1); p_tone(1, -2, -1, 1.5, 1, 0); p_st(1, 200, 0); p_cmp(1, -24, 3, 6, 1, 4, 100);
    p_hf(1, -16); p_clip(1, 2); p_lim(1, -1, 100, 6);
  ) : p == 9 ? (    // PARALLEL PUNCH: heavy fast compression blended under the dry mix
    p_in(0, 1); p_tube(1, 0, 1); p_tone(1, 0, 0, 0, 0, 0); p_st(1, 60, 100); p_cmp(1, -30, 6, 3, 2, 6, 40);
    p_hf(0, -12); p_clip(1, 2); p_lim(1, -0.3, 80, 2);
  ) : p == 10 ? (   // STREAMING SAFE: controlled, -1 dB true-peak ceiling, no clipper
    p_in(0, 2); p_tube(0, -3, 1); p_tone(1, 0, 0, 0, 0.5, 0); p_st(1, 40, 100); p_cmp(1, -18, 1.8, 8, 1, 1.5, 100);
    p_hf(1, -14); p_clip(0, 0); p_lim(1, -1, 150, 3);
  ) : p == 11 ? (   // RESET: the defaults
    p_in(0, 1); p_tube(1, -3, 1); p_tone(1, 0, 0, 0, 0, 0); p_st(1, 20, 100); p_cmp(0, -18, 2, 6, 1, 0, 100);
    p_hf(0, -12); p_clip(0, 0); p_lim(1, -0.3, 80, 0);
    slider38 = 50; slider39 = 1; slider_automate(2 ^ 37 + 2 ^ 38);
  );
  p > 0 ? slider_automate(536870911);       // sliders 1-29
);

// ======================================================================
//  @slider work, kept in functions so @block can refresh after automation
// ======================================================================
function update() (
  targets();
  // tone stack: broad bands (low Q), at the host rate
  eqB_L.bq_set(4, 90,   0.6, slider7,  srate); eqB_R.bq_set(4, 90,   0.6, slider7,  srate);
  eqM_L.bq_set(2, 350,  0.6, slider8,  srate); eqM_R.bq_set(2, 350,  0.6, slider8,  srate);
  eqH_L.bq_set(2, 2800, 0.6, slider9,  srate); eqH_R.bq_set(2, 2800, 0.6, slider9,  srate);
  eqP_L.bq_set(3, 7000, 0.6, slider10, srate); eqP_R.bq_set(3, 7000, 0.6, slider10, srate);
  tape_on = slider11;
  tapeL.bq_set(0, 18000, 0.707, 0, srate); tapeR.bq_set(0, 18000, 0.707, 0, srate);
  // mono maker: 4th-order Butterworth high-pass on the side
  mm_on = slider13 > 20.5;
  mmA.bq_set(1, slider13, 0.5412, 0, srate); mmB.bq_set(1, slider13, 1.3066, 0, srate);
  // HF limiter: a 4th-order Linkwitz-Riley split at 6 kHz (two Butterworth sections each side)
  hfA_L.bq_set(1, 6000, 0.7071, 0, srate); hfB_L.bq_set(1, 6000, 0.7071, 0, srate);
  hfA_R.bq_set(1, 6000, 0.7071, 0, srate); hfB_R.bq_set(1, 6000, 0.7071, 0, srate);
  lfA_L.bq_set(0, 6000, 0.7071, 0, srate); lfB_L.bq_set(0, 6000, 0.7071, 0, srate);
  lfA_R.bq_set(0, 6000, 0.7071, 0, srate); lfB_R.bq_set(0, 6000, 0.7071, 0, srate);
  // latency: the oversampler (more stages add their own later)
  mz_oslat = os_n == 0 ? 0 : os_n == 1 ? 2 * K1 : 2 * K1 + K2;
  ins_output_straight(32);   // output stage: straight through (it writes pdc_delay: put ours back straight away)
  lat_t = 2 * mz_oslat + LDEL;                   // oversamplers, limiters
  pdc_delay = lat_t; pdc_bot_ch = 0; pdc_top_ch = 2;
  // (kept constant whatever is bypassed, so switching a stage never shifts the timing)
);

clip_last = 1;
ui_thm = 5; ui_hw = 1;                       // one look: house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 0; );       // new instances open in Medium, on Init
update();
in_s = in_t; tmix = tmix_t; tk = tk_t; tmk = tmk_t; tb = bias_b; ttb = tanh(tb); eq_s = eq_t; out_s = out_t;
st_s = st_t; wid_s = wid_t; cmp_s = cmp_t; c_mk = c_mk_t; c_mix = c_mix_t;
c_ms = 0; c_gr = 0; c_slow = 0; c_grm_d = 0;
lk_s = lk_t; lk_u = 1 - lk_s;
hf_s = hf_t; hf_g = 1; hf_grm_d = 1; cmix = cmix_t; cdrv = cdrv_t; lim_s = lim_t; clip_mode = max(clip_mode, 1);
ui_dflt = 1;   // the defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved size
mz_hL = mz_hR = -100;   // the output meters' peak holds start empty

// ---------- dual mono (LINK off): each side its own detector and gain, the same laws as the linked ones ----------
function cm_side(x2) instance(ms, cg, slow) local(lv, tg) (
  ms += (x2 - ms) * c_rmsc;
  lv = 10 * log10(max(ms, 0.0000000001)) + 3.01;
  tg = knee_gr(lv, c_thr, c_ratio * (1 + 0.25 * min(-cg / 12, 1)), c_knee);
  slow += ((cg < -1 ? 1 : 0) - slow) * c_rel2c * 0.5;
  cg += (tg - cg) * (tg < cg ? c_attc : c_relc + (c_rel2c - c_relc) * slow);
);
function hf_side(pk) instance(g) local(tg) (
  tg = pk > hf_thr ? hf_thr / pk : 1;
  g += (tg - g) * (tg < g ? hf_att : hf_rel);
);
function lm_side(tg, w) instance(buf, sum, g) local(mn, i, k, av) (
  buf[w] = tg;
  mn = 1; i = 0; loop(LA, k = w - i; k < 0 ? k += 1024; mn = min(mn, buf[k]); i += 1; );
  buf[1024 + w] = mn;
  k = w - LA; k < 0 ? k += 1024;
  sum += mn - buf[1024 + k];
  av = sum / LA;
  g = av < g ? av : g + (av - g) * l_relc;
);
// while linked, each side follows the linked state, so LINK off starts from where it is
function lm_follow(tg, mn, w) instance(buf, sum, g) ( buf[w] = tg; buf[1024 + w] = mn; sum = l_sum; g = l_g; );
by_setup(40);                                           // BYPASS (gfx-bypass)

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
msx_dst != 1 ? update();                  // during a preset duck the swap applies the new settings

@block
prs_chk();
msx_dst != 1 ? update();                  // knobs and keys on the faceplate do not run @slider, so read them here
// drift: the valve's bias and drive wander a little
drift_macro(slider38);
dinc = slider31 * dm_s * samplesblock / srate;
drv_d = min(slider30 / 100 * dm_a, 1);
bias_b += 0.05 * drv_d * dA.drift_tick(dinc);
tk_t *= 1 + 0.06 * drv_d * dB.drift_tick(dinc);

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_var(0, clip_last);
file_avail(0) != 0 ? file_var(0, pr_cur);    // the preset in use (older projects end before it)
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
by_in();                                                // BYPASS: the untouched input
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
// preset duck-and-swap: out, swap, stay silent while the old audio leaves the latency, back in
msx_dst == 1 ? ( msx_dk -= msx_dkr; msx_dk <= 0 ? ( msx_dk = 0; update(); msx_hc = lat_t + floor(0.002 * srate); msx_dst = 2; ); ) :
msx_dst == 2 ? ( msx_hc > 0 ? msx_hc -= 1 : ( msx_dk += msx_dkr; msx_dk >= 1 ? ( msx_dk = 1; msx_dst = 0; ); ); );
// ======================================================================
//  STAGE 1: INPUT TRIM
// ======================================================================
in_s += (in_t - in_s) * sm10;
lk_s += (lk_t - lk_s) * sm10; lk_s > 0.9999 && lk_t ? lk_s = 1; lk_s < 0.0001 && !lk_t ? lk_s = 0;
lk_u = 1 - lk_s;                                           // the dual-mono share (0 = linked, as v2.0)
xL = spl0 * in_s;
xR = spl1 * in_s;
ipL_d = max(ipL_d, abs(xL)); ipR_d = max(ipR_d, abs(xR));

// ======================================================================
//  STAGE 2: TUBE SATURATION (oversampled) + TONE STACK
// ======================================================================
tmix += (tmix_t - tmix) * sm10;
tk   += (tk_t - tk) * sm30; tmk += (tmk_t - tmk) * sm30;
tb   += (bias_b - tb) * sm30; ttb = tanh(tb);
xL = tL.tube_run(xL);
xR = tR.tube_run(xR);
xL = dcL.bq(xL); xR = dcR.bq(xR);                        // DC from the bias

eq_s += (eq_t - eq_s) * sm10;
eq_s > 0.0001 ? (
  yL = eqP_L.bq(eqH_L.bq(eqM_L.bq(eqB_L.bq(xL))));
  yR = eqP_R.bq(eqH_R.bq(eqM_R.bq(eqB_R.bq(xR))));
  tape_on ? ( yL = tapeL.bq(yL); yR = tapeR.bq(yR); );
  xL += (yL - xL) * eq_s;
  xR += (yR - xR) * eq_s;
);

// ======================================================================
//  STAGE 3: STEREO (mid / side): mono maker on the side, then side width
// ======================================================================
st_s += (st_t - st_s) * sm10; wid_s += (wid_t - wid_s) * sm30;
st_s > 0.0001 ? (
  mid = (xL + xR) * 0.5; sid = (xL - xR) * 0.5;
  mm_on ? sid = mmB.bq(mmA.bq(sid));
  sid *= wid_s;
  xL += (mid + sid - xL) * st_s;
  xR += (mid - sid - xR) * st_s;
);

// ======================================================================
//  STAGE 4: VARI-MU COMPRESSOR
// ======================================================================
cmp_s += (cmp_t - cmp_s) * sm10;
c_mk += (c_mk_t - c_mk) * sm10; c_mix += (c_mix_t - c_mix) * sm10;
cmp_s > 0.0001 ? (
  // stereo-linked RMS, in dB
  c_ms += ((xL * xL + xR * xR) * 0.5 - c_ms) * c_rmsc;
  c_lv = 10 * log10(max(c_ms, 0.0000000001)) + 3.01;                       // + 3 dB: a sine reads its peak level
  // vari-mu: the ratio rises a little as the gain reduction deepens
  c_tg = knee_gr(c_lv, c_thr, c_ratio * (1 + 0.25 * min(-c_gr / 12, 1)), c_knee);
  // attack / release in the dB domain; the release slows the longer it has been working (program-dependent)
  c_slow += ((c_gr < -1 ? 1 : 0) - c_slow) * c_rel2c * 0.5;
  c_gr += (c_tg - c_gr) * (c_tg < c_gr ? c_attc : c_relc + (c_rel2c - c_relc) * c_slow);
  c_mx = c_mix * cmp_s;                                                      // parallel blend, and the bypass
  lk_u > 0 ? (
    cmA.cm_side(xL * xL); cmB.cm_side(xR * xR);
    lk_a = c_gr + (cmA.cg - c_gr) * lk_u; lk_b = c_gr + (cmB.cg - c_gr) * lk_u;
    xL += (xL * db2g(lk_a) * c_mk - xL) * c_mx;
    xR += (xR * db2g(lk_b) * c_mk - xR) * c_mx;
    c_grm_d = min(c_grm_d, min(lk_a, lk_b));
  ) : (
    cmA.ms = cmB.ms = c_ms; cmA.cg = cmB.cg = c_gr; cmA.slow = cmB.slow = c_slow;
    c_g = db2g(c_gr) * c_mk;
    xL += (xL * c_g - xL) * c_mx;
    xR += (xR * c_g - xR) * c_mx;
    c_grm_d = min(c_grm_d, c_gr);                                                  // for a meter (reset by the display)
  );
);

// ======================================================================
//  STAGE 5: HF LIMITER (keyed from above 6 kHz, turns down only that band)
// ======================================================================
hf_s += (hf_t - hf_s) * sm10;
hf_s > 0.0001 ? (
  hL = hfB_L.bq(hfA_L.bq(xL)); hR = hfB_R.bq(hfA_R.bq(xR));
  lL = lfB_L.bq(lfA_L.bq(xL)); lR = lfB_R.bq(lfA_R.bq(xR));
  hf_pk = max(abs(hL), abs(hR));
  hf_tg = hf_pk > hf_thr ? hf_thr / hf_pk : 1;
  hf_g += (hf_tg - hf_g) * (hf_tg < hf_g ? hf_att : hf_rel);       // fast: 0.3 ms attack, 60 ms release
  lk_u > 0 ? (
    hfA.hf_side(abs(hL)); hfB.hf_side(abs(hR));
    lk_a = hf_g + (hfA.g - hf_g) * lk_u; lk_b = hf_g + (hfB.g - hf_g) * lk_u;
    xL += (lL + hL * lk_a - xL) * hf_s;
    xR += (lR + hR * lk_b - xR) * hf_s;
    hf_grm_d = min(hf_grm_d, min(lk_a, lk_b));
  ) : (
    hfA.g = hfB.g = hf_g;
    xL += (lL + hL * hf_g - xL) * hf_s;                              // low band + top band x gain
    xR += (lR + hR * hf_g - xR) * hf_s;
    hf_grm_d = min(hf_grm_d, hf_g);
  );
);

// ======================================================================
//  STAGE 6: CLIPPER (oversampled)
// ======================================================================
cmix += (cmix_t - cmix) * sm10; cdrv += ((slider24 > 0 ? cdrv_t : 1) - cdrv) * sm10;
xL = cL.clip_run(xL);
xR = cR.clip_run(xR);

// output gain, then the GFX output stage (band saturation), into the limiter
out_s += (out_t - out_s) * sm10;
xL = ostL.ost_band(xL * out_s); xR = ostR.ost_band(xR * out_s);
ost_out(xL, xR); xL = ost_l; xR = ost_r;

// ======================================================================
//  STAGE 7: TRUE-PEAK LOOKAHEAD LIMITER
// ======================================================================
lim_s += (lim_t - lim_s) * sm10;
l_pa = tpL.tp_peak(xL); l_pb = tpR.tp_peak(xR);
l_pk = max(l_pa, l_pb);                                          // inter-sample peak of the sample 4 back
l_tg = l_pk > l_ceil ? l_ceil / l_pk : 1;
// hold the lowest gain needed across the lookahead, then average across it: the gain is fully down by the
// time the peak arrives, with a smooth (box-shaped) fall and no overshoot
GRB[lw] = l_tg;
l_mn = 1; l_i = 0; loop(LA, l_k = lw - l_i; l_k < 0 ? l_k += 1024; l_mn = min(l_mn, GRB[l_k]); l_i += 1; );   // (own names: @gfx runs alongside)
GRB[1024 + lw] = l_mn;                                            // the held gains, for the average
l_k = lw - LA; l_k < 0 ? l_k += 1024;
l_sum += l_mn - GRB[1024 + l_k];
l_w0 = lw;
lw += 1; lw >= 1024 ? lw = 0;
l_av = l_sum / LA;
l_g = l_av < l_g ? l_av : l_g + (l_av - l_g) * l_relc;            // release
lk_u > 0 ? (
  lmA.lm_side(l_pa > l_ceil ? l_ceil / l_pa : 1, l_w0); lmB.lm_side(l_pb > l_ceil ? l_ceil / l_pb : 1, l_w0);
) : (
  lmA.lm_follow(l_tg, l_mn, l_w0); lmB.lm_follow(l_tg, l_mn, l_w0);
);
// the audio, delayed to meet its gain
DLL[dw] = xL; DLR[dw] = xR;
dr = dw - LDEL; dr < 0 ? dr += 2048; dw += 1; dw >= 2048 ? dw = 0;   // (EEL2 & does not wrap negatives)
yL = DLL[dr]; yR = DLR[dr];
lk_u > 0 ? (
  lk_a = l_g + (lmA.g - l_g) * lk_u; lk_b = l_g + (lmB.g - l_g) * lk_u;
  gL = yL * lk_a; gR = yR * lk_b;
) : (
  gL = yL * l_g; gR = yR * l_g;
);
gL = min(max(gL, -l_ceil), l_ceil); gR = min(max(gR, -l_ceil), l_ceil);    // last-sample safety
xL = yL + (gL - yL) * lim_s;
xR = yR + (gR - yR) * lim_s;
l_gm_d = min(l_gm_d, lk_u > 0 ? min(lk_a, lk_b) : l_g);

msx_dst ? ( msx_dkg = msx_dk * msx_dk * (3 - 2 * msx_dk); xL *= msx_dkg; xR *= msx_dkg; );
spl0 = xL;
spl1 = xR;
by_out();                                               // BYPASS: the crossfade to the untouched input
opL_d = max(opL_d, abs(spl0)); opR_d = max(opR_d, abs(spl1));

@gfx 1120 466
ui_thm = 5; ui_hw = 1;                                // one look (old projects may have saved another theme / flat)
ui_begin(1120, 466);
// =====================================================================
// GUI - a hardware mastering rack (design space 1120 x 466; S / M / L): lamp keys for the stage INs,
// cream selector keys, satin knobs (coloured caps on the tone bands, gold on SAT).
// Knobs: drag (SHIFT = fine), wheel, double-click = default; the label shows the value while the knob is touched.
// A stage whose IN is off is greyed.
// =====================================================================
sc != mz_lsc ? (
  mz_lsc = sc;
  gfx_setfont(10, "Trebuchet MS", 11 * sc, 'b');      // small print
  gfx_setfont(11, "Trebuchet MS", 16 * sc, 'b');     // section titles
  gfx_setfont(12, "Trebuchet MS", 13.5 * sc, 'b');     // knob labels, the badge
  gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');     // key legends, the subtitle, meter labels
  gfx_setfont(14, "Trebuchet MS", 26 * sc, 'b');     // the unit's name
  gfx_setfont(15, "Trebuchet MS", 14 * sc, 'b');     // section numbers, the latency
  gfx_setfont(16, "Courier New", 16 * sc, 'b');      // the limiter's read-outs
);
MZ_FACE = 0x1B202A; MZ_PANEL = 0x242A36; MZ_EDGE = 0x3C4556; MZ_INK = 0xECEEF2; MZ_DIM = 0x949CAC;
MZ_ACC = 0xD9B86A; MZ_TRAY = 0x0C0E12; MZ_HEAD = 0x12151C; MZ_STRIP = 0x1C212B; MZ_LCD = 0xFFB446;
lk_font = 13; lk_font2 = 13; ck_font = 13; lk_well = MZ_TRAY;
dy_bg = 0x1D212B; dy_ink = MZ_INK;                    // (dy_bg: the knobs' unlit track is 30 % darker)

function mz_rr(x0, y0, ww, hgt, rad) local(x1, y1, x2, y2, rr) (
  x1 = floor(x0 * sc + 0.5); y1 = floor(y0 * sc + 0.5); x2 = floor((x0 + ww) * sc + 0.5); y2 = floor((y0 + hgt) * sc + 0.5);
  rr = min(floor(rad * sc + 0.5), floor((min(x2 - x1, y2 - y1)) * 0.5));
  gfx_a < 1 ? ui_rrs(x1, y1, x2 - x1, y2 - y1, rr) : (
    gfx_rect(x1 + rr, y1, x2 - x1 - 2 * rr, y2 - y1);
    gfx_rect(x1, y1 + rr, rr + 1, y2 - y1 - 2 * rr); gfx_rect(x2 - rr - 1, y1 + rr, rr + 1, y2 - y1 - 2 * rr);
    gfx_circle(x1 + rr, y1 + rr, rr, 1, 1); gfx_circle(x2 - rr - 1, y1 + rr, rr, 1, 1);
    gfx_circle(x1 + rr, y2 - rr - 1, rr, 1, 1); gfx_circle(x2 - rr - 1, y2 - rr - 1, rr, 1, 1);
  );
);
function mz_r(x0, y0, ww, hgt) ( gfx_rect(x0 * sc, y0 * sc, max(1, ww * sc), max(1, hgt * sc)); );
function mz_tc(cx, y0, txt) ( ui_text(cx * sc, y0 * sc, txt); );
function mz_tl(x0, y0, txt) ( gfx_x = x0 * sc; gfx_y = y0 * sc; gfx_drawstr(txt); );
function mz_tr(x0, y0, txt) local(tw, th) ( gfx_measurestr(txt, tw, th); gfx_x = x0 * sc - tw; gfx_y = y0 * sc; gfx_drawstr(txt); );
function mz_rivet(cx, cy) ( ui_col(0x465062); gfx_circle(cx * sc, cy * sc, 3.5 * sc, 1, 1); );
function mz_set(idx, vv) ( slider(idx) = vv; ui_auto(idx); );
// a section: panel, title strip, number (gold) and title
function mz_sec(x0, y0, ww, hgt, ttl, num) (
  ui_cola(0x000000, 0.47); mz_rr(x0 + 1, y0 + 2, ww, hgt, 5);
  ui_col(MZ_EDGE); mz_rr(x0, y0, ww, hgt, 5);
  ui_col(MZ_PANEL); mz_rr(x0 + 1.5, y0 + 1.5, ww - 3, hgt - 3, 4);
  ui_col(MZ_STRIP); mz_r(x0 + 1.5, y0 + 1.5, ww - 3, 26);
  gfx_setfont(11); ui_col(MZ_INK); mz_tl(x0 + 12, y0 + 7, ttl);   // name only, no section numbers
);
// a stage's IN lamp key (amber), top right of its section
function mz_in(x0, y0, idx) ( lk_fit(x0, y0, 48, 22, slider(idx) > 0, LK_AMB, "IN") ? mz_set(idx, slider(idx) > 0 ? 0 : 1); );
// a stage that is switched out: grey its panel, then its IN key again on top
function mz_grey(x0, y0, ww, hgt, kx, idx) (
  slider(idx) < 0.5 ? (
    ui_cola(MZ_PANEL, 0.51); mz_r(x0 + 1.5, y0 + 28, ww - 3, hgt - 29.5);
    mz_in(kx, y0 + 3, idx);
  );
);
// knob + label under it; the label turns into the value (gold) while the knob is touched
// kst 35: white satin cap (col = the value arc); 36: coloured cap (col = the cap)
function mz_knob(cx, cy, rad, idx, lo, hi, def, lg, kst, col, lbl, val) (
  dy_kst = kst; dy_knob(cx, cy, rad, idx, lo, hi, def, lg, col, "", "");
  gfx_setfont(12); ui_col(dy_act ? MZ_ACC : MZ_INK); mz_tc(cx, cy + rad + 9, dy_act ? val : lbl);
);
// a gain-reduction bar, 0 to -20 dB
function mz_grbar(x0, y0, ww, gr, lbl) local(nn, fr, k) (
  ui_col(MZ_TRAY); mz_rr(x0, y0, ww, 10, 2);
  nn = floor(ww / 6); fr = min(max(-gr / 20, 0), 1); k = 0;
  loop(nn, ui_col(k / nn < fr ? 0xF2A41E : 0x3A2C12); mz_r(x0 + 2 + k * 6, y0 + 2, 4, 6); k += 1; );
  gfx_setfont(10); ui_col(MZ_DIM); mz_tl(x0, y0 - 14, lbl);
);
// an LED level meter row: 34 segments, -48 to +3 dBFS; hd = a floating peak-hold segment (dB, -100 = none)
function mz_ledrow(x0, y0, pk, hd, lbl) local(db, k, c, kh) (
  db = g2db(pk); k = 0;
  kh = hd > -48 ? min(33, floor((hd + 48) / 1.5)) : -1;
  loop(34,
    c = k < 25 ? 0x3CD06A : k < 31 ? 0xF0B030 : 0xF04030;
    ui_col(db > -48 + k * 1.5 || k == kh ? c : ui_mix(c, 0x000000, 0.8)); mz_r(x0 + k * 6.2, y0, 5, 9);
    k += 1;
  );
  gfx_setfont(13); ui_col(MZ_DIM); mz_tr(x0 - 8, y0 - 1, lbl);
);

// meter readings: peaks fall back smoothly, gain reductions recover
mIL = max(ipL_d, mIL * 0.85); mIR = max(ipR_d, mIR * 0.85); ipL_d = 0; ipR_d = 0;
mOL = max(opL_d, mOL * 0.85); mOR = max(opR_d, mOR * 0.85); opL_d = 0; opR_d = 0;
dC = min(c_grm_d, dC * 0.85); c_grm_d = 0;
dH = min(g2db(hf_grm_d), dH * 0.85); hf_grm_d = 1;
dL = min(g2db(l_gm_d), dL * 0.85); l_gm_d = 1;
// the output meters' peak holds: 1.2 s, then fall 0.6 dB a frame
mz_dL = g2db(mOL); mz_dL >= mz_hL ? ( mz_hL = mz_dL; mz_htl = time_precise(); ) : time_precise() - mz_htl > 1.2 ? mz_hL = max(mz_dL, mz_hL - 0.6);
mz_dR = g2db(mOR); mz_dR >= mz_hR ? ( mz_hR = mz_dR; mz_htr = time_precise(); ) : time_precise() - mz_htr > 1.2 ? mz_hR = max(mz_dR, mz_hR - 0.6);
// the output peak read-out holds for 1.5 s, then falls back
mz_op = max(mOL, mOR);
mz_op >= mz_ph ? ( mz_ph = mz_op; mz_pt = time_precise(); ) : time_precise() - mz_pt > 1.5 ? mz_ph = max(mz_op, mz_ph * 0.9);

// =====================================================================
// Draw
// =====================================================================
// the face with a fine brushed speckle, drawn once into image 120 (again when the size changes)
(gfx_w != mz_sw || gfx_h != mz_sh || sc != mz_ssc) ? (
  mz_sw = gfx_w; mz_sh = gfx_h; mz_ssc = sc;
  gfx_setimgdim(120, gfx_w, gfx_h); gfx_dest = 120; gfx_mode = 0;
  ui_col(MZ_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
  mz_i = 0;
  loop(9000,
    mz_i & 1 ? ui_cola(0xFFFFFF, 0.04) : ui_cola(0x000000, 0.16);
    gfx_rect(floor(ui_hash(mz_i * 2 + 1) * gfx_w), floor(ui_hash(mz_i * 2 + 2.5) * gfx_h), max(1, floor(sc * 0.5)), max(1, floor(sc * 0.5)));
    mz_i += 1;
  );
  gfx_dest = -1; gfx_a = 1;
);
gfx_x = 0; gfx_y = 0; gfx_a = 1; gfx_mode = 0; gfx_blit(120, 1, 0);

// ---------- header ----------
ui_col(MZ_HEAD); mz_r(0, 0, 1120, 58); ui_col(MZ_ACC); mz_r(0, 56, 1120, 2);
ui_col(MZ_ACC); mz_rr(16, 13, 32, 32, 4);
gfx_setfont(12); ui_col(MZ_HEAD); ui_keytext(32 * sc, 29 * sc, "GFX");
gfx_setfont(14); ui_col(MZ_INK); mz_tl(60, 9, "MASTERSUITE");
gfx_setfont(13); ui_col(MZ_DIM); mz_tl(60, 39, "SEVEN-STAGE MASTERING STRIP");
pk_pextra = "Reset to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(432 * sc, 14 * sc, 408 * sc, 30 * sc, pr_cur, "Transparent|Warm Glue|Loud & Punchy|Vintage Tape|Bright Pop|Bass Heavy|Acoustic / Classical|Podcast / Voice|Parallel Punch|Streaming Safe (-1 dBTP)");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 10 ? 0 : k_; );
// no preset in use (new instance, or after Reset): the LCD reads Init (laid out as pk_preset lays it out)
pr_cur < 1 || pr_cur > 10 ? (
  mz_ph2 = 30 * sc; mz_lx = 432 * sc + floor(max(mz_ph2 * 1.65, 64 * sc)) + 2 * floor(mz_ph2 * 0.7) + 12 * sc; mz_lw = 840 * sc - mz_lx;
  pk_lcd(mz_lx, 14 * sc, mz_lw, mz_ph2, 0); ui_col(pk_lcdc);
  pk_lcdfont(9, max(9, mz_ph2 * 0.58)); gfx_measurestr("Init", mz_tw, mz_th);
  pk_fitstr("Init", mz_lx + 8 * sc, 14 * sc + (mz_ph2 - mz_th) * 0.5, max(9, mz_ph2 * 0.58), mz_lw - 14 * sc);
);
gfx_setfont(10); ui_col(MZ_DIM); mz_tl(858, 16, "LATENCY");
sprintf(#mz_lat, "%d smp", lat_t); gfx_setfont(15); ui_col(MZ_INK); mz_tl(858, 28, #mz_lat);
os_key(1008, 18, 2, MZ_INK, 7);
by_key(348, 18, 40, 7);                               // BYPASS, left of PRESETS
ui_size_picker(1046 * sc, 20 * sc);
mz_rivet(8, 66); mz_rivet(1112, 66); mz_rivet(8, 458); mz_rivet(1112, 458);

// ================= row 1 =================
mz_y = 70; mz_h = 190;
// ---------- 1 INPUT ----------
mz_sec(16, mz_y, 130, mz_h, "INPUT", "1");
lk_fit(88, mz_y + 3, 52, 22, slider39 >= 0.5, LK_BLU, "LINK") ? mz_set(39, slider39 >= 0.5 ? 0 : 1);
sprintf(#mz_v, "%+.1f dB", slider1); mz_knob(60, mz_y + 70, 18, 1, -12, 12, 0, 0, 35, MZ_ACC, "TRIM", #mz_v);
sprintf(#mz_v, "%.0f%%", slider32); mz_knob(112, mz_y + 70, 18, 32, 0, 100, 0, 0, 36, 0xD8B040, "SAT", #mz_v);

// ---------- 2 TUBE ----------
mz_sec(152, mz_y, 172, mz_h, "TUBE", "2");
mz_in(270, mz_y + 3, 3);
sprintf(#mz_v, "%+.1f dB", slider4); mz_knob(206, mz_y + 72, 28, 4, -12, 12, -3, 0, 35, MZ_ACC, "DRIVE", #mz_v);
sprintf(#mz_v, "%.0f%%", slider38); mz_knob(286, mz_y + 66, 15, 38, 0, 100, 50, 0, 35, MZ_ACC, "DRIFT", #mz_v);
gfx_setfont(10); ui_col(MZ_DIM); mz_tl(166, mz_y + 136, "BIAS");
ck_key(166, mz_y + 152, 46, 24, slider5 == 0, "LOW") ? mz_set(5, 0);
ck_key(216, mz_y + 152, 46, 24, slider5 == 1, "MID") ? mz_set(5, 1);
ck_key(266, mz_y + 152, 46, 24, slider5 == 2, "HIGH") ? mz_set(5, 2);
mz_grey(152, mz_y, 172, mz_h, 270, 3);

// ---------- 2 TONE ----------
mz_sec(330, mz_y, 330, mz_h, "TONE", "2");
mz_in(606, mz_y + 3, 6);
gfx_setfont(10); ui_col(MZ_DIM);
mz_tc(378, mz_y + 36, "90 Hz"); mz_tc(450, mz_y + 36, "350 Hz"); mz_tc(522, mz_y + 36, "2.8 kHz"); mz_tc(594, mz_y + 36, "7 kHz");
sprintf(#mz_v, "%+.1f dB", slider7);  mz_knob(378, mz_y + 84, 22, 7,  -6, 6, 0, 0, 36, 0x8A5A3A, "BASS", #mz_v);
sprintf(#mz_v, "%+.1f dB", slider8);  mz_knob(450, mz_y + 84, 22, 8,  -6, 6, 0, 0, 36, 0x3D7FD6, "LO-MID", #mz_v);
sprintf(#mz_v, "%+.1f dB", slider9);  mz_knob(522, mz_y + 84, 22, 9,  -6, 6, 0, 0, 36, 0x3FA45B, "HI-MID", #mz_v);
sprintf(#mz_v, "%+.1f dB", slider10); mz_knob(594, mz_y + 84, 22, 10, -6, 6, 0, 0, 36, 0xD8332E, "PRESENCE", #mz_v);
lk_fit(352, mz_y + 146, 92, 26, slider11 > 0, LK_YEL, "TAPE 18k") ? mz_set(11, slider11 > 0 ? 0 : 1);
gfx_setfont(10); ui_col(MZ_DIM); mz_tl(456, mz_y + 152, "ROLL-OFF");
mz_grey(330, mz_y, 330, mz_h, 606, 6);

// ---------- 3 STEREO ----------
mz_sec(666, mz_y, 172, mz_h, "STEREO", "3");
mz_in(784, mz_y + 3, 12);
slider13 < 20.5 ? strcpy(#mz_v, "OFF") : sprintf(#mz_v, "%.0f Hz", slider13);
gfx_setfont(10); ui_col(MZ_DIM); mz_tc(712, mz_y + 40, #mz_v);
mz_knob(712, mz_y + 88, 24, 13, 20, 200, 20, 1, 35, MZ_ACC, "MONO MAKER", #mz_v);
sprintf(#mz_v, "%.0f %%", slider14);
gfx_setfont(10); ui_col(MZ_DIM); mz_tc(792, mz_y + 40, #mz_v);
mz_knob(792, mz_y + 88, 24, 14, 0, 200, 100, 0, 35, MZ_ACC, "WIDTH", #mz_v);
mz_grey(666, mz_y, 172, mz_h, 784, 12);

// ---------- METERS ----------
mz_sec(844, mz_y, 260, mz_h, "METERS", "");
mz_ledrow(890, mz_y + 38, max(mIL, mIR), -100, "IN");
mz_ledrow(890, mz_y + 60, mOL, mz_hL, "OUT L");
mz_ledrow(890, mz_y + 78, mOR, mz_hR, "R");
// click the output meters (or the OUT PEAK read-out) to clear their peaks
pressed && ((mouse_x >= 848 * sc && mouse_x < 1100 * sc && mouse_y >= (mz_y + 56) * sc && mouse_y < (mz_y + 91) * sc) ||
            (mouse_x >= 822 * sc && mouse_x < 1084 * sc && mouse_y >= 400 * sc && mouse_y < 438 * sc)) ? (
  mz_hL = mz_hR = -100; mz_ph = 0;
);
mz_grbar(862, mz_y + 118, 224, dC, "VARI-MU GR");
mz_grbar(862, mz_y + 148, 224, dH, "HF LIMIT GR");
mz_grbar(862, mz_y + 174, 224, dL, "LIMITER GR");

// ================= row 2 =================
mz_y = 268; mz_h = 186;
// ---------- 4 VARI-MU ----------
mz_sec(16, mz_y, 428, mz_h, "VARI-MU", "4");
mz_in(390, mz_y + 3, 15);
sprintf(#mz_v, "%.1f dB", slider16);   mz_knob(62,  mz_y + 74, 24, 16, -40, 0, -18, 0, 35, MZ_ACC, "THRESH", #mz_v);
sprintf(#mz_v, "%.1f:1", slider17);    mz_knob(138, mz_y + 74, 20, 17, 1, 10, 2, 0, 35, MZ_ACC, "RATIO", #mz_v);
sprintf(#mz_v, "%.1f dB", slider18);   mz_knob(216, mz_y + 74, 20, 18, 0, 12, 6, 0, 35, MZ_ACC, "KNEE", #mz_v);
sprintf(#mz_v, "%+.1f dB", slider20);  mz_knob(294, mz_y + 74, 20, 20, 0, 12, 0, 0, 35, MZ_ACC, "MAKEUP", #mz_v);
sprintf(#mz_v, "%.0f%%", slider21);    mz_knob(372, mz_y + 74, 20, 21, 0, 100, 100, 0, 35, MZ_ACC, "MIX", #mz_v);
gfx_setfont(10); ui_col(MZ_DIM); mz_tl(30, mz_y + 128, "RECTIFIER");
ck_key(30,  mz_y + 144, 90, 26, slider19 == 0, "GERMANIUM") ? mz_set(19, 0);
ck_key(126, mz_y + 144, 90, 26, slider19 == 1, "SILICON") ? mz_set(19, 1);
ck_key(222, mz_y + 144, 90, 26, slider19 == 2, "LED") ? mz_set(19, 2);
mz_grey(16, mz_y, 428, mz_h, 390, 15);

// ---------- 5 HF LIMITER ----------
mz_sec(450, mz_y, 168, mz_h, "HF LIMITER", "5");
mz_in(564, mz_y + 3, 22);
sprintf(#mz_v, "%.1f dB", slider23); mz_knob(534, mz_y + 84, 26, 23, -30, 0, -12, 0, 35, MZ_ACC, "THRESH", #mz_v);
gfx_setfont(10); ui_col(MZ_DIM); mz_tc(534, mz_y + 136, "ABOVE 6 kHz");
mz_grey(450, mz_y, 168, mz_h, 564, 22);

// ---------- 6 CLIPPER ----------
mz_sec(624, mz_y, 172, mz_h, "CLIPPER", "6");
ck_key(638, mz_y + 40, 46, 26, slider24 == 0, "OFF") ? mz_set(24, 0);
ck_key(688, mz_y + 40, 46, 26, slider24 == 1, "SOFT") ? ( clip_last = 1; mz_set(24, 1); );
ck_key(738, mz_y + 40, 46, 26, slider24 == 2, "HARD") ? ( clip_last = 2; mz_set(24, 2); );
sprintf(#mz_v, "%+.1f dB", slider25); mz_knob(710, mz_y + 116, 24, 25, 0, 12, 0, 0, 35, MZ_ACC, "DRIVE", #mz_v);

// ---------- 7 LIMITER ----------
mz_sec(802, mz_y, 302, mz_h, "LIMITER", "7");
mz_in(1050, mz_y + 3, 26);
sprintf(#mz_v, "%+.1f dB", slider29); mz_knob(867,  mz_y + 80, 22, 29, -12, 12, 0, 0, 35, MZ_ACC, "OUTPUT", #mz_v);
sprintf(#mz_v, "%.2f dB", slider27);  mz_knob(953,  mz_y + 80, 22, 27, -1, -0.1, -0.3, 0, 35, MZ_ACC, "CEILING", #mz_v);
sprintf(#mz_v, "%.0f ms", slider28);  mz_knob(1039, mz_y + 80, 22, 28, 10, 500, 80, 1, 35, MZ_ACC, "RELEASE", #mz_v);
ui_col(MZ_TRAY); mz_rr(822, mz_y + 132, 262, 38, 4);
gfx_setfont(10); ui_col(MZ_DIM); mz_tl(834, mz_y + 138, "OUT PEAK"); mz_tr(1072, mz_y + 138, "CEILING");
mz_ph < 0.00001 ? strcpy(#mz_v, "-inf dBFS") : sprintf(#mz_v, "%.2f dBFS", g2db(mz_ph));
gfx_setfont(16); ui_col(MZ_LCD); mz_tl(834, mz_y + 150, #mz_v);
sprintf(#mz_v, "%.2f", slider27); ui_col(MZ_INK); mz_tr(1072, mz_y + 150, #mz_v);
mz_grey(802, mz_y, 302, mz_h, 1050, 26);

pk_end();
ui_end();
