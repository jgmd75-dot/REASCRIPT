  gfx_x = (x + (w - 14) * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5) * sc - th * 0.5; gfx_drawstr(#hy_di);
  ui_col(DIM); ui_sstri((x + w - 17) * sc, (y + h * 0.5 - 3) * sc, (x + w - 7) * sc, (y + h * 0.5 - 3) * sc, (x + w - 12) * sc, (y + h * 0.5 + 3) * sc);
  sel = -1;
  pressed && hov && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#hy_dm, ""); n = pk_pcount(menu); i = 1;
    loop(n, i == v + 1 ? strcat(#hy_dm, "!"); strcat(#hy_dm, pk_pitem(menu, i, #hy_dt)); i < n ? strcat(#hy_dm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#hy_dm); i > 0 ? sel = i - 1;
  );
