  i = 1; loop(3, ui_cola(GLITE, 0.12); hy_r(x + s * i / 4, y, 1, s); hy_r(x, y + s * i / 4, s, 1); i += 1; );
  ui_cola(INK, 0.25); ui_ssline(x * sc, (y + s) * sc, (x + s) * sc, y * sc, sc, 1);
