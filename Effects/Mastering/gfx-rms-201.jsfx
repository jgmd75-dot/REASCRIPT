function hy_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function hy_rr(x, y, w, h, r) ( ui_rrs(x * sc, y * sc, w * sc, h * sc, r * sc); );
function hy_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function hy_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function hy_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function hy_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function hy_shadow(x, y, w, h, r) local(j) (
  j = 0; loop(4, ui_cola(0x000000, 0.13); hy_rr(x + 2 + j * 1.3, y + 3 + j * 1.7, w + j * 0.4, h + j * 0.4, r + j); j += 1; );
);
function hy_plate(x, y, w, h) (
  hy_shadow(x, y, w, h, 6);
  ui_col(0x1F1816); hy_rr(x, y, w, h, 6);
  ui_col(0x6B5D5A); hy_rr(x, y, w - 1, h - 1, 6);
  ui_col(PL); hy_rr(x + 1, y + 1, w - 2.5, h - 2.5, 5);
  gfx_gradrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, h * 0.4 * sc, 1, 1, 1, 0.05, 0, 0, 0, 0, 0, 0, 0, -0.05 / (h * 0.4 * sc));
);
function hy_head(x, w, title) local(tw, th) (
  ui_col(PLD); hy_r(x + 1, 81, w - 2, 32);
  ui_cola(GLITE, 0.55); hy_r(x + 1, 113, w - 2, 1);
  gfx_setfont(11); gfx_measurestr(title, tw, th);
