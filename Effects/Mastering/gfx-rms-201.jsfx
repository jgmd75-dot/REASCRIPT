function hy_div(x) ( ui_col(0x2A211F); hy_r(x, 82, 1, 268); ui_cola(0xFFFFFF, 0.07); hy_r(x + 1, 82, 1, 268); );
function hy_box(x, y, w, h, name, menu, v) local(hov, sel, n, i, tw, th) (
  hov = hy_in(x, y, w, h);
  gfx_setfont(13); ui_col(DIM); hy_tc(x + w * 0.5, y - 18, name);
  ui_col(0x161110); hy_rr(x - 1, y - 1, w + 2, h + 2, 4);
  ui_col(0x241D1B); hy_rr(x, y, w, h, 3);
  ui_cola(0x000000, 0.5); hy_r(x + 1, y + 1, w - 2, 2);
  hov ? ( ui_cola(0xFFFFFF, 0.06); hy_rr(x, y, w, h, 3); );
  pk_pitem(menu, v + 1, #hy_di);
