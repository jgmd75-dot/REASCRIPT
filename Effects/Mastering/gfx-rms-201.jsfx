);
function hy_gr(x, y, w, h, gr, col) local(i, c, lit) (
  ui_col(0x100C0C); hy_r(x - 2, y - 2, w + 4, h + 4);
  c = w / 20; i = 0;
  loop(20,
    lit = gr >= i + 0.5;
    lit ? ( ui_cola(col, 0.3); hy_r(x + i * c - 0.5, y - 1, c, h + 2); ui_col(col); ) : ui_cola(col, 0.12);
    hy_r(x + i * c + 0.5, y, c - 1.5, h);
    i += 1;
  );
);
function hy_tilt(x, y, w, h, t) local(i, c, n, lit) (
  ui_col(0x100C0C); hy_r(x - 2, y - 2, w + 4, h + 4);
  c = w / 20; n = floor(abs(t) * 20 + 0.5); i = 0;
  loop(20,
    lit = t > 0 ? (i < 10 && 10 - i <= n) : (i >= 10 && i - 9 <= n);
    lit ? ( ui_cola(GLITE, 0.3); hy_r(x + i * c - 0.5, y - 1, c, h + 2); ui_col(GLITE); ) : ui_cola(GLITE, 0.12);
    hy_r(x + i * c + 0.5, y, c - 1.5, h);
    i += 1;
  );
  ui_col(INK); hy_r(x + w * 0.5 - 0.5, y - 3, 1, h + 6);
);
function hy_curve(o, sl, kw) (
  kw < 0.01 ? (o > 0 ? o * sl : 0) :
  o <= -0.5 * kw ? 0 : o >= 0.5 * kw ? o * sl : sl * sqr(o + 0.5 * kw) / (2 * kw);
);
function hy_xfer(x, y, s, lvl) local(i, p, q, xi, yo, px, py, ox, oy, sl, cy, d) (
  ui_col(0x161110); hy_rr(x - 2, y - 2, s + 4, s + 4, 4);
