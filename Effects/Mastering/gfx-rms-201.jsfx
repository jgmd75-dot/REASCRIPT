desc:RMS 201 [mastering limiter] (GFX)
//tags: mastering compressor limiter rms true peak saturation tape tube diode tilt
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-input, gfx-ui, gfx-panel, gfx-os and gfx-bypass (.jsfx-inc) in the same folder.

slider1:thr_db=-18<-40,0,0.1>-Threshold (dB)
slider2:ratio=2<1,10,0.01>-Ratio
slider3:knee_db=6<0,18,0.1>-Knee (dB)
slider4:att_ms=10<0.1,100,0.1>-Attack (ms)
slider5:rel_ms=250<20,2500,1>-Release (ms)
slider6:rel_auto=0<0,1,1{Off,On}>-Auto release
slider7:mkup_db=0<0,20,0.1>-Make-up (dB)
slider8:mix_pc=100<0,100,1>-Mix (%)
slider9:comp_in=1<0,1,1{Out,In}>-Compressor
slider10:rms_t=0<0,4,1{Auto,3 ms,10 ms,30 ms,50 ms}>-RMS time
slider11:sc_hz=60<20,300,1>-SC HPF (Hz)
slider12:msw=0<-100,100,1>-SC M/S weighting (%)
slider13:tilt=0<0,100,1>-Tilt comp (%)
slider14:lnk=1<0,1,1{Off,On}>-Link
slider15:lim_ceil=-1<-12,0,0.1>-Ceiling (dB)
slider16:lim_rel=60<5,1000,1>-Limiter release (ms)
slider17:lim_auto=0<0,1,1{Off,On}>-Limiter auto release
slider18:tp_on=1<0,1,1{Off,On}>-True peak
slider19:lim_in=1<0,1,1{Out,In}>-Limiter
slider20:col_type=0<0,2,1{Tape,Tube,Diode}>-Colour type
slider21:col_drv=30<0,100,1>-Colour drive (%)
slider22:col_mix=50<0,100,1>-Colour blend (%)
slider23:col_in=0<0,1,1{Out,In}>-Colour
slider24:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider25:trim_db=0<-24,12,0.1>-Input trim (dB)
slider26:guard=0<0,1,1{Off,On}>-Guard
slider27:byp=0<0,1,1{Off,On}>-Bypass
slider28:prs_sel=0<0,12,1{No preset,Init,Gentle Glue,Transparent Master,Loud and Open,Punchy Pop,Dense Rock,Acoustic Air,Low End Hold,Tape Master,Tube Glow,Diode Edge,Broadcast Ride}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc

@init
#ui_man = "gfx-rms-201";
ext_noinit = 1;

LIMA = 100000;
LIMB = 106000;
TPK = 112000;
DRY = 113000;
XCH = 116000;
RMASK = 1023;

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(g) ( log(max(g, 0.000000001)) * 8.685889638065035; );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );

function svf_hp(x) instance(s1, s2) local(hp, v1, v2, bp) (
  hp = (x - (sc_gw + 1.4142135623730951) * s1 - s2) * sc_h;
  v1 = sc_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = sc_gw * bp; s2 = s2 + 2 * v2;
  hp;
);
function svf_lp(x) instance(s1, s2) local(hp, v1, v2, bp, lp) (
  hp = (x - (tl_g + 1.4142135623730951) * s1 - s2) * tl_h;
  v1 = tl_g * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = tl_g * bp; lp = s2 + v2; s2 = lp + v2;
  lp;
);
function op_lp(x, gg) instance(s) local(v, y) ( v = (x - s) * gg; y = v + s; s = y + v; y; );

function gcurve(o, sl, kw) (
  kw < 0.01 ? (o > 0 ? o * sl : 0) :
  o <= -0.5 * kw ? 0 : o >= 0.5 * kw ? o * sl : sl * sqr(o + 0.5 * kw) / (2 * kw);
);

function tp_design() local(p, k, t, w, x, s, i0) (
  p = 0; i0 = os_bi0(2.5);
  loop(7,
    s = 0; k = 0;
    loop(16,
      t = (k - 7) - (p + 1) * 0.125;
      x = t / 8.5; w = abs(x) < 1 ? os_bi0(2.5 * sqrt(1 - x * x)) / i0 : 0;
      TPK[p * 16 + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
      s += TPK[p * 16 + k]; k += 1;
    );
    k = 0; loop(16, TPK[p * 16 + k] /= s; k += 1; );
    p += 1;
  );
);
function tp_peak(hb, w, x, tp) local(h, b, p, m, y, a, c, e, d, q, pv) (
  h = hb + (w & 15);
  h[0] = x; h[16] = x;
  h = hb + ((w + 1) & 15);
  !tp ? max(abs(h[7]), abs(h[8])) : (
    pv = h[7]; m = abs(pv); a = c = e = 0; p = 0;
    loop(8,
      p < 7 ? (
        b = TPK + p * 16;
        y = b[0] * h[0] + b[1] * h[1] + b[2] * h[2] + b[3] * h[3] + b[4] * h[4] + b[5] * h[5] + b[6] * h[6] + b[7] * h[7]
          + b[8] * h[8] + b[9] * h[9] + b[10] * h[10] + b[11] * h[11] + b[12] * h[12] + b[13] * h[13] + b[14] * h[14]
          + b[15] * h[15];
      ) : y = h[8];
      abs(y) > m ? ( m = abs(y); a = pv; c = y; e = 0; q = 1; ) : q ? ( e = y; q = 0; );
      pv = y; p += 1;
    );
    c != 0 && e != 0 ? (
      c < 0 ? ( a = -a; c = -c; e = -e; );
      d = 2 * c - a - e;
      d > 0.000000001 ? (
        b = max(min(0.5 * (e - a) / d, 0.5), -0.5);
        m = max(m, c + 0.5 * (e - a) * b - 0.5 * d * b * b);
      );
    );
    m;
  );
);

function la_init(base, n) instance(bb, nn, ww, dd, gsum, grl, wp, tn, qh, qt, tw, g) local(k) (
  bb = base; nn = n; ww = n + 1; dd = n + 7;
  memset(bb, 0, 5184);
  k = 0; loop(1024, bb[2048 + k] = 1; k += 1; );
  gsum = nn; grl = 1; wp = tn = qh = qt = tw = 0; g = 1;
);
function la_run(xl, xr, cg, crel, tp, amt) instance(bb, nn, ww, dd, gsum, grl, wp, tn, qh, qt, tw, g, ol, orr)
  local(pk, gq, gmin, k) (
  pk = max(tp_peak(bb + 5120, tw, xl, tp), tp_peak(bb + 5152, tw, xr, tp)); tw += 1;
  gq = pk > cg ? cg / pk : 1;
  while (qt > qh && bb[3072 + ((qt - 1) & RMASK)] >= gq) ( qt -= 1; );
  bb[3072 + (qt & RMASK)] = gq; bb[4096 + (qt & RMASK)] = tn; qt += 1;
  while (bb[4096 + (qh & RMASK)] <= tn - ww) ( qh += 1; );
  gmin = bb[3072 + (qh & RMASK)];
  grl = gmin < grl ? gmin : grl + (gmin - grl) * crel;
  gsum += grl - bb[2048 + ((wp - nn) & RMASK)]; bb[2048 + (wp & RMASK)] = grl;
  bb[wp & RMASK] = xl; bb[1024 + (wp & RMASK)] = xr;
  ol = bb[(wp - dd) & RMASK]; orr = bb[1024 + ((wp - dd) & RMASK)];
  wp += 1; tn += 1;
  (wp & 65535) == 0 ? ( gsum = 0; k = 0; loop(nn, gsum += bb[2048 + ((wp - 1 - k) & RMASK)]; k += 1; ); );
  g = 1 + amt * (min(gsum / nn, 1) - 1);
  ol *= g; orr *= g;
  amt > 0.999 ? ( ol = max(min(ol, cg), -cg); orr = max(min(orr, cg), -cg); );
);

function sat3(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function col_curve(v) local(y, a) (
  y = 0;
  cw_tp > 0.0001 ? y += cw_tp * sat3(v);
  cw_tb > 0.0001 ? y += cw_tb * (sat3(v + 0.35) - sat3_b) * sat3_d;
  cw_dd > 0.0001 ? ( a = v * v; y += cw_dd * v / sqrt(sqrt(1 + a * a)); );
  y;
);
function col_run(u) ( u + cl_m * (col_curve(u * cl_k) * cl_o - u); );

function set_rate() (
  la_n = ceil(0.0015 * srate); lc_n = ceil(0.0005 * srate);
  limx.la_init(LIMA, la_n); ceilx.la_init(LIMB, lc_n);
  os_base = la_n + 7 + lc_n + 7;
  c_sw = coef(0.015); c_kn = coef(0.03); c_lk = coef(0.01);
  c_cr = coef(0.03);
  c_1s = coef(1); c_tb = coef(0.3);
  c_fe = coef(0.03); c_fa = coef(0.0005); c_se = coef(0.3); c_sa = coef(0.04);
  ho_n = floor(0.04 * srate);
  tl_g = tan($pi * 800 / srate); tl_h = 1 / (1 + tl_g * (tl_g + 1.4142135623730951));
  tb_g = tan($pi * 800 / srate); tb_g = tb_g / (1 + tb_g);
  dc_c = 1 - 2 * $pi * 5 / srate;
);

function hy_params() local(t) (
  sc_tt = tan($pi * min(max(sc_hz, 20), 300) / srate);
  c_att = coef(att_ms * 0.001);
  c_rel = coef(rel_ms * 0.001);
  t = rms_t == 0 ? min(max(2 * att_ms, 3), 40) : rms_t == 1 ? 3 : rms_t == 2 ? 10 : rms_t == 3 ? 30 : 50;
  c_rms = coef(t * 0.001);
  c_aa = coef(1.2); c_as = coef(1.5 * rel_ms / 250);
  ceil_t = db2g(lim_ceil);
  in_setup(trim_db, guard);
  os_tf = os_f2n(os_sl);
);

function clear_dsp() (
  limx.la_init(LIMA, la_n); ceilx.la_init(LIMB, lc_n);
  memset(DRY, 0, 2048); memset(XCH, 0, 62 * 1024);
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  dcx_l = dcy_l = dcx_r = dcy_r = 0;
);

in_init();
os_design();
tp_design();
sat3_b = sat3(0.35); sat3_d = 1 / ((sat3(0.3501) - sat3(0.3499)) * 5000);
set_rate();
os_f = os_tf = os_f2n(os_sl);
os_gsetup();
hy_params();
clear_dsp();

rs_f = 1; rs_c = 1 / (0.015 * srate); dw = 0;
env_fa = env_fb = env_sa = env_sb = 0; rq_a = rq_b = 0;
thr_s = thr_db; rat_s = ratio; kn_s = knee_db; mk_s = db2g(mkup_db); mx_s = mix_pc * 0.01;
lk_s = lnk; cin_s = comp_in; lin_s = lim_in; ceil_s = ceil_t; lrl_s = lim_rel;
sc_gw = sc_tt; sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
ms_s = msw * 0.01; tl_s = tilt * 0.01; tbal = 0;
cw_tp = col_type == 0; cw_tb = col_type == 1; cw_dd = col_type == 2;
cdr_s = col_drv * 0.01; cmx_s = col_mix * 0.01; cin2_s = col_in;
lv_d = -150; dens = 0; ho_c = 0; fe = se = 0; gh_f = 1; sus = 0; cr_n = 0;

#hy_pmn = "Init|Gentle Glue|Transparent Master|Loud and Open|Punchy Pop|Dense Rock|Acoustic Air|Low End Hold|Tape Master|Tube Glow|Diode Edge|Broadcast Ride";
function load_preset(p) local(i) (
  thr_db = -18; ratio = 2; knee_db = 6; att_ms = 10; rel_ms = 250; rel_auto = 0; mkup_db = 0; mix_pc = 100;
  comp_in = 1; rms_t = 0; sc_hz = 60; msw = 0; tilt = 0; lnk = 1;
  lim_ceil = -1; lim_rel = 60; lim_auto = 0; tp_on = 1; lim_in = 1;
  col_type = 0; col_drv = 30; col_mix = 50; col_in = 0;
  p == 2 ? ( thr_db = -22; ratio = 1.5; knee_db = 12; att_ms = 30; rel_auto = 1; mkup_db = 4; sc_hz = 90; ) :
  p == 3 ? ( thr_db = -20; ratio = 1.8; knee_db = 10; att_ms = 20; rel_ms = 400; mkup_db = 4; sc_hz = 120; tilt = 30; lim_auto = 1; ) :
  p == 4 ? ( thr_db = -24; ratio = 2.5; knee_db = 8; att_ms = 15; rel_auto = 1; mkup_db = 11; sc_hz = 100; tilt = 60;
             lim_ceil = -1; lim_auto = 1; ) :
  p == 5 ? ( thr_db = -20; ratio = 3; knee_db = 6; att_ms = 25; rel_ms = 120; mkup_db = 7; sc_hz = 80; tilt = 40; lim_rel = 40; ) :
  p == 6 ? ( thr_db = -22; ratio = 4; knee_db = 6; att_ms = 5; rel_auto = 1; mkup_db = 11.5; mix_pc = 70; sc_hz = 80;
             col_in = 1; col_type = 1; col_drv = 40; col_mix = 40; ) :
  p == 7 ? ( thr_db = -24; ratio = 1.6; knee_db = 14; att_ms = 40; rel_ms = 600; mkup_db = 3.5; sc_hz = 150; tilt = 80; msw = -30; ) :
  p == 8 ? ( thr_db = -22; ratio = 2; knee_db = 10; att_ms = 30; rel_auto = 1; mkup_db = 5; sc_hz = 200; tilt = 50; ) :
  p == 9 ? ( thr_db = -20; ratio = 2; att_ms = 20; rel_auto = 1; mkup_db = 4.5; sc_hz = 90;
             col_in = 1; col_type = 0; col_drv = 45; col_mix = 60; lim_auto = 1; ) :
  p == 10 ? ( thr_db = -20; ratio = 1.8; knee_db = 10; att_ms = 25; rel_auto = 1; mkup_db = 4.5; sc_hz = 90;
              col_in = 1; col_type = 1; col_drv = 55; col_mix = 45; ) :
  p == 11 ? ( thr_db = -22; ratio = 2.5; att_ms = 10; rel_ms = 200; mkup_db = 7; sc_hz = 100; tilt = 30;
              col_in = 1; col_type = 2; col_drv = 35; col_mix = 30; ) :
  p == 12 ? ( thr_db = -26; ratio = 4; knee_db = 4; att_ms = 3; rel_auto = 1; rel_ms = 400; mkup_db = 16; rms_t = 2;
              sc_hz = 120; tilt = 50; lim_ceil = -0.5; lim_auto = 1; );
  i = 1; loop(23, ui_auto(i); i += 1; );
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(28, i != 28 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@slider
prs_chk();
hy_params();
os_snap(slider(24));

@block
prs_chk();
hy_params();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? rs_req = 1;
rs_last = rs_now;
xn = min(num_ch, 64) - 2;
pdc_bot_ch = 0; pdc_top_ch = 2 + max(xn, 0);
os_snapb(slider(24));

@sample
rs_req ? (
  rs_req = 0; rs_f = 0; rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay;
  limx.la_init(LIMA, la_n); ceilx.la_init(LIMB, lc_n);
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  memset(DRY, 0, 2048); memset(XCH, 0, 62 * 1024);
);
rw_l = spl0; rw_r = spl1;

thr_s += (thr_db - thr_s) * c_kn;
rat_s += (ratio - rat_s) * c_kn;
kn_s += (knee_db - kn_s) * c_kn;
mk_s += (db2g(mkup_db) - mk_s) * c_kn;
mx_s += (mix_pc * 0.01 - mx_s) * c_kn;
lk_s += (lnk - lk_s) * c_lk;
cin_s += (comp_in - cin_s) * c_sw;
lin_s += (lim_in - lin_s) * c_sw;
ceil_s += (ceil_t - ceil_s) * c_kn;
lrl_s += (lim_rel - lrl_s) * c_kn;
sc_gw += (sc_tt - sc_gw) * c_kn;
sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
ms_s += (msw * 0.01 - ms_s) * c_kn;
tl_s += (tilt * 0.01 - tl_s) * c_kn;
cw_tp += ((col_type == 0) - cw_tp) * c_sw; cw_tb += ((col_type == 1) - cw_tb) * c_sw; cw_dd += ((col_type == 2) - cw_dd) * c_sw;
cdr_s += (col_drv * 0.01 - cdr_s) * c_kn;
cmx_s += (col_mix * 0.01 - cmx_s) * c_kn;
cin2_s += (col_in - cin2_s) * c_sw;
cl_m = cmx_s * cin2_s;
cl_m > 0 || cl_m != cl_mq ? (
  cl_mq = cl_m; cl_d = db2g(-6 + 14 * cdr_s); cl_k = cl_d / ceil_s;
  cl_o = 0.3 * ceil_s / col_curve(0.3 * cl_d);
);
os_gate();
os_chg ? (
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  os_hold += 2 * samplesblock;
);

in_process(spl0, spl1);
xl = in_l; xr = in_r;
mi_l_d = max(mi_l_d, abs(xl)); mi_r_d = max(mi_r_d, abs(xr));

sm = 0.5 * (xl + xr); ss = 0.5 * (xl - xr);
dgm = min(1, 1 - ms_s); dgs = min(1, 1 + ms_s);
ha = hpa.svf_hp(dgm * sm + dgs * ss); hb = hpb.svf_hp(dgm * sm - dgs * ss);
rq_a += (ha * ha - rq_a) * c_rms; rq_b += (hb * hb - rq_b) * c_rms;
da = sqrt(2 * rq_a); db = sqrt(2 * rq_b);
dm = max(da, db); da += (dm - da) * lk_s; db += (dm - db) * lk_s;
lv_db = g2db(dm);
sl = 1 - 1 / max(rat_s, 1);
tga = gcurve(g2db(da) - thr_s, sl, kn_s); tgb = gcurve(g2db(db) - thr_s, sl, kn_s);

fe += (dm - fe) * (dm > fe ? c_fa : c_fe);
se += (dm - se) * (dm > se ? c_sa : c_se);
ho_c > 0 ? ho_c -= 1 : fe > 1.6 * se && fe > 0.0001 ? ( dens += 1; ho_c = ho_n; );
dens -= dens * c_1s;
(cr_n -= 1) <= 0 ? (
  cr_n = 32;
  dn_k = min(dens / 8, 1);
  gh_f = lv_db < thr_s - 10 ? 3 : 1;
  c_af = coef(rel_ms * 0.001 * (0.35 + 0.85 * dn_k) / gh_f);
  c_as2 = 1 - (1 - c_as) ^ gh_f;
  sus += ((limx.g < 0.98) - sus) * 32 * c_1s;
  c_lr = coef(lrl_s * 0.001 * (lim_auto ? (0.6 + 3 * sus) / gh_f : 1));
);
rel_auto ? (
  env_fa += (tga - env_fa) * (tga > env_fa ? c_att : c_af);
  env_fb += (tgb - env_fb) * (tgb > env_fb ? c_att : c_af);
  env_sa += (tga - env_sa) * (tga > env_sa ? c_aa : c_as2);
  env_sb += (tgb - env_sb) * (tgb > env_sb ? c_aa : c_as2);
  gra = max(env_fa, env_sa); grb = max(env_fb, env_sb);
) : (
  env_fa = max(env_fa, env_sa); env_fb = max(env_fb, env_sb);
  env_fa += (tga - env_fa) * (tga > env_fa ? c_att : c_rel);
  env_fb += (tgb - env_fb) * (tgb > env_fb ? c_att : c_rel);
  gra = env_fa; grb = env_fb;
  env_sa = env_sb = 0;
);
grc_disp = max(grc_disp, max(gra, grb) * cin_s);
lv_d = lv_db;

blo = tbl.op_lp(sm, tb_g); bhi = sm - blo;
e_lo += (blo * blo - e_lo) * c_tb; e_hi += (bhi * bhi - e_hi) * c_tb;
tb_t = e_lo + e_hi > 0.00000001 ? min(max((10 * log10((e_lo + 0.000000000001) / (e_hi + 0.000000000001)) - 3) / 12, -1), 1) : 0;
tbal += (tb_t - tbal) * c_tb;
tk = 0.5 * tl_s * tbal;
tilt_d = tk * (max(gra, grb) > 0.1);

la = lsa.svf_lp(xl); lb = lsb.svf_lp(xr);
gla = db2g(-gra * (1 + tk)); gha = db2g(-gra * (1 - tk));
glb = db2g(-grb * (1 + tk)); ghb = db2g(-grb * (1 - tk));
wa = (la * gla + (xl - la) * gha) * mk_s; wb = (lb * glb + (xr - lb) * ghb) * mk_s;
cl = xl + (wa - xl) * mx_s * cin_s; cr = xr + (wb - xr) * mx_s * cin_s;

limx.la_run(cl, cr, ceil_s, c_lr, tp_on, lin_s);
cl = limx.ol; cr = limx.orr;

ul.os_up(cl); ur.os_up(cr);
a0 = col_run(ul.s0); b0 = col_run(ur.s0);
os_f == 1 ? (
  cl = a0; cr = b0;
) : (
  a1 = col_run(ul.s1); b1 = col_run(ur.s1);
  os_f == 2 ? (
    cl = dl_.os_dn(a0, a1, 0, 0); cr = dr_.os_dn(b0, b1, 0, 0);
  ) : (
    a2 = col_run(ul.s2); b2 = col_run(ur.s2);
    a3 = col_run(ul.s3); b3 = col_run(ur.s3);
    cl = dl_.os_dn(a0, a1, a2, a3); cr = dr_.os_dn(b0, b1, b2, b3);
  );
);
dcv = cl - dcx_l + dc_c * dcy_l; dcx_l = cl; dcy_l = dcv; cl = dcv;
dcv = cr - dcx_r + dc_c * dcy_r; dcx_r = cr; dcy_r = dcv; cr = dcv;

ceilx.la_run(cl, cr, ceil_s, c_cr, tp_on, lin_s);
ol = ceilx.ol; orr = ceilx.orr;
lgr_disp = max(lgr_disp, -g2db(limx.g * ceilx.g));

dip_s = os_g; dip_s *= dip_s * (3 - 2 * dip_s);
spl0 = ol * dip_s; spl1 = orr * dip_s;
DRY[dw] = rw_l; DRY[1024 + dw] = rw_r;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
  rs_s = rs_f * rs_f * (3 - 2 * rs_f); rs_xs = rs_x * rs_x * (3 - 2 * rs_x);
  rs_dl = rw_l + (DRY[(dw - pdc_delay) & RMASK] - rw_l) * rs_xs;
  rs_dr = rw_r + (DRY[1024 + ((dw - pdc_delay) & RMASK)] - rw_r) * rs_xs;
  spl0 = rs_dl + (spl0 - rs_dl) * rs_s; spl1 = rs_dr + (spl1 - rs_dr) * rs_s;
);
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? (
  rs_dl = DRY[(dw - pdc_delay) & RMASK]; rs_dr = DRY[1024 + ((dw - pdc_delay) & RMASK)];
  spl0 += (rs_dl - spl0) * by_s; spl1 += (rs_dr - spl1) * by_s;
);
xn > 0 ? (
  xs = rs_f < 1 ? rs_xs : 1; k = 0;
  loop(xn,
    XCH[k * 1024 + dw] = spl(k + 2);
    spl(k + 2) = (spl(k + 2) + (XCH[k * 1024 + ((dw - pdc_delay) & RMASK)] - spl(k + 2)) * xs) * dip_s;
    k += 1;
  );
);
dw = (dw + 1) & RMASK;
mo_l_d = max(mo_l_d, abs(spl0)); mo_r_d = max(mo_r_d, abs(spl1));
lat_disp = pdc_delay;

