  ui_hw_toggle(1206*qs, 36*qs);
  ui_button(1258*qs, 36*qs, 30*sc, 18*sc, "", 0, 1) ? ( slider8 = slider8 < 0.5; ui_auto(8); ui_bgok = 0; setmsg("HW FINISH", slider8 > 0.5 ? "CREAM & WALNUT" : "GRAPHITE"); );
  ui_col(wal ? 0x26272B : 0x6B4630); CIRC(1278, 48, 7, 1); ui_col(wal ? 0x9A958A : 0xE8E0CB); CIRC(1278, 48, 7, 0);
  gfx_setfont(8); ui_col(TOPI); TC(1278, 68, "FINISH");
) : (
