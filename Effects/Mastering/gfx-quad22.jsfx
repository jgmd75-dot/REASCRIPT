  gfx_setfont(8); ui_col(NTX); TX(94, 60, "4-BAND COMPANDER");
);

lcd(342, 14, 330, 72);
hitbox(342, 14, 330, 72) ? (
  strcpy(#pmenu, ""); k = 0;
  loop(8, k == slider6 ? strcat(#pmenu, "!"); strcat(#pmenu, pname(k)); k < 7 ? strcat(#pmenu, "|"); k += 1; );
  gfx_x = mouse_x; gfx_y = mouse_y;
  psel = gfx_showmenu(#pmenu);
  psel > 0 ? go_preset(psel - 1);
);
hkey(690, 30, 40, 40, "<", 0) ? go_preset((slider6 + 7) % 8);
by_keyw(588, 27, 66, 50, 14);
hkey(736, 30, 40, 40, ">", 0) ? go_preset((slider6 + 1) % 8);
gfx_setfont(8); ui_col(hw ? TOPI : NTX); TC(733, 76, "PRESET");
gfx_setfont(8); ui_col(hw ? TOPI : NTX); TC(940, 34, "MODEL Q22"); TC(940, 52, "COMP / SAT / EQ");

hw ? (
