  gfx_setfont(2); ui_col(0x141414); ui_ctext(56*qs, 49*qs, "GFX");
  gfx_setfont(12); ui_col(0xEDEBE4); TX(92, 18, "QUAD22"); ver_tag("v3", 14, 0, 0);
