in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-lovers";                                  // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
LVDEF = 1000; LVTMP = 1200;                                // the Init values; the preset parser's scratch (panel only)
LVSC = 1500;                                               // the scale library: one interval mask a scale
LVCS = 1600;                                               // the scale in use: its intervals (lv_n of them)
LVHN = 1650;                                               // the keys held (the pedal is the lowest)
LVPH = 1750; LVPV = 1790; LVPM = 1830;                     // the phrases: notes, velocities, where each came from (2 x 16)
LVS = 1900;                                                // the two spirals' settings and state: 32 a side
LVSX = 4000; LVSL = 8200; LVSR = 12400; LVSN = 4096; LVSM = 4095;   // the scope: the drone, the left and right spirals
LVDL = 20000; LVDR = 290000; LVDN = 262144; LVDM = 262143;  // the cross-feedback delay's two lines
LVCH = 560000; LVCR = 570000; LVCM = 4095;                 // the modulation's two chorus lines
LVPD = 580000; LVPDM = 16383;                              // the shimmer reverb's pre-delay
LVAP = 600000; LVAPN = 4096; LVAPM = 4095;                 // its four input all-passes
LVRV = 620000; LVRN = 16384; LVRM = 16383;                 // its eight lines
LVPS = 760000; LVPSM = 8191;                               // its octave-up shifter
memset(LVHN, 0, 100); memset(LVPH, 0, 150); memset(LVS, 0, 64); memset(LVSX, 0, 3 * 4200);
memset(LVDL, 0, LVDN); memset(LVDR, 0, LVDN); memset(LVCH, 0, 4096); memset(LVCR, 0, 4096);
memset(LVPD, 0, 16384); memset(LVAP, 0, 4 * LVAPN); memset(LVRV, 0, 8 * LVRN); memset(LVPS, 0, 8192);
TWOPI = 2 * $pi; TK = 16;                                  // the control tick: every 16 samples

// ---------- the scale library ----------
function lv_scm(i, m) ( LVSC[i] = m; );
// the scale library: 53 scales (interval masks, bit k = k semitones above the tonic)
lv_scm(0, 2741);   // Ionian: 0 2 4 5 7 9 11
lv_scm(1, 1709);   // Dorian: 0 2 3 5 7 9 10
lv_scm(2, 1451);   // Phrygian: 0 1 3 5 7 8 10
lv_scm(3, 2773);   // Lydian: 0 2 4 6 7 9 11
lv_scm(4, 1717);   // Mixolydian: 0 2 4 5 7 9 10
lv_scm(5, 1453);   // Aeolian: 0 2 3 5 7 8 10
lv_scm(6, 1387);   // Locrian: 0 1 3 5 6 8 10
lv_scm(7, 2477);   // Harmonic minor: 0 2 3 5 7 8 11
lv_scm(8, 2733);   // Melodic minor: 0 2 3 5 7 9 11
lv_scm(9, 2485);   // Harmonic major: 0 2 4 5 7 8 11
lv_scm(10, 1459);   // Phrygian dominant: 0 1 4 5 7 8 10
lv_scm(11, 1749);   // Lydian dominant: 0 2 4 6 7 9 10
lv_scm(12, 1371);   // Altered: 0 1 3 4 6 8 10
lv_scm(13, 2901);   // Lydian augmented: 0 2 4 6 8 9 11
lv_scm(14, 1741);   // Ukrainian Dorian: 0 2 3 6 7 9 10
lv_scm(15, 2731);   // Neapolitan major: 0 1 3 5 7 9 11
lv_scm(16, 2475);   // Neapolitan minor: 0 1 3 5 7 8 11
lv_scm(17, 2509);   // Hungarian minor: 0 2 3 6 7 8 11
lv_scm(18, 1753);   // Hungarian major: 0 3 4 6 7 9 10
lv_scm(19, 2483);   // Double harmonic: 0 1 4 5 7 8 11
lv_scm(20, 2419);   // Persian: 0 1 4 5 6 8 11
lv_scm(21, 3411);   // Enigmatic: 0 1 4 6 8 10 11
lv_scm(22, 1403);   // Spanish eight-tone: 0 1 3 4 5 6 8 10
lv_scm(23, 1365);   // Whole tone: 0 2 4 6 8 10
lv_scm(24, 2925);   // Diminished (whole-half): 0 2 3 5 6 8 9 11
lv_scm(25, 1755);   // Diminished (half-whole): 0 1 3 4 6 7 9 10
lv_scm(26, 2457);   // Augmented: 0 3 4 7 8 11
lv_scm(27, 1621);   // Prometheus: 0 2 4 6 9 10
lv_scm(28, 1235);   // Tritone: 0 1 4 6 7 10
lv_scm(29, 661);   // Major pentatonic: 0 2 4 7 9
lv_scm(30, 1193);   // Minor pentatonic: 0 3 5 7 10
lv_scm(31, 1257);   // Blues: 0 3 5 6 7 10
lv_scm(32, 669);   // Major blues: 0 2 3 4 7 9
lv_scm(33, 2483);   // Bhairav: 0 1 4 5 7 8 11
lv_scm(34, 2507);   // Todi: 0 1 3 6 7 8 11
lv_scm(35, 2771);   // Marwa: 0 1 4 6 7 9 11
lv_scm(36, 1709);   // Kafi: 0 2 3 5 7 9 10
lv_scm(37, 2515);   // Purvi: 0 1 4 6 7 8 11
lv_scm(38, 1461);   // Charukesi: 0 2 4 5 7 8 10
lv_scm(39, 397);   // Hirajoshi: 0 2 3 7 8
lv_scm(40, 1187);   // In Sen: 0 1 5 7 10
lv_scm(41, 1123);   // Iwato: 0 1 5 6 10
lv_scm(42, 653);   // Kumoi: 0 2 3 7 9
lv_scm(43, 677);   // Yo: 0 2 5 7 9
lv_scm(44, 2225);   // Ryukyu: 0 4 5 7 11
lv_scm(45, 395);   // Pelog: 0 1 3 7 8
lv_scm(46, 1189);   // Slendro: 0 2 5 7 10
lv_scm(47, 661);   // Tezeta major: 0 2 4 7 9
lv_scm(48, 397);   // Tezeta minor: 0 2 3 7 8
lv_scm(49, 2225);   // Bati major: 0 4 5 7 11
lv_scm(50, 1193);   // Bati minor: 0 3 5 7 10
lv_scm(51, 419);   // Ambassel: 0 1 5 7 8
lv_scm(52, 611);   // Anchihoye: 0 1 5 6 9

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#lv_def = "0 1 0 2 1 0 0 1 0 1 0 1 1 0 1 0 1 0 1 777 4 35 0 70 40 15 45 20 7 300 0 20 25 6 2 0 2 0 55 0 50 70 35 20 30 7 2 4 2 0 55 2 50 70 35 20 30 1 1 6 5 380 290 45 60 45 40 0 1 0.35 45 35 120 50 1 70 60 40 35 50 -3 60 0 30 120 6000 -0.3 1";
function lv_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function lv_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
lv_nums(#lv_def, LVDEF);
#lv_pm = "Init|Two Orbits|Courtship Dance|Mirror Vows|Twin Flames|The Meeting|Silver Thread|Rose and Ash|Kindred Bells|Promise at Dusk|Lantern Duet|Eternal Return";
lv_npre = 12;
function lv_pstr(p) (
  p == 2 ? "3:2 5:3 20:1204 21:3 34:5 36:2 40:1 41:45 46:7 48:3 52:0 65:70 82:60.4" :
  p == 3 ? "3:4 5:39 6:1 20:3131 22:55 34:6 35:5 36:4 40:2 41:65 46:5 47:5 48:6 52:2 53:55 64:35 68:1 82:57.2" :
  p == 4 ? "3:9 5:7 7:1 20:808 34:8 36:0 40:0 42:60 46:8 48:1 52:0 54:60 65:90 67:50 82:62.4" :
  p == 5 ? "3:4 5:10 20:5150 25:55 26:45 34:7 35:5 36:5 40:1 41:65 46:9 47:5 48:3 52:1 53:60 60:4 61:2 78:20 79:25 82:57.1" :
  p == 6 ? "3:5 5:48 6:1 20:2626 34:4 35:0 36:0 37:1 39:90 40:3 46:6 47:3 48:6 52:0 77:80 78:70 79:50 82:57.3" :
  p == 7 ? "3:7 5:42 20:9090 21:6 22:70 34:9 35:6 36:7 39:35 40:0 46:10 47:6 48:2 51:35 52:2 82:54.8" :
  p == 8 ? "3:2 5:33 20:4321 27:70 28:35 34:5 35:1 36:4 40:3 46:6 48:1 52:1 71:70 72:60 74:70 82:60" :
  p == 9 ? "3:9 5:45 20:6006 34:6 36:0 40:0 41:70 46:7 47:3 48:0 52:0 53:70 64:60 65:80 82:59" :
  p == 10 ? "3:11 5:5 6:1 20:1999 24:80 25:25 34:7 36:6 40:2 46:3 47:0 48:0 49:1 51:95 52:3 77:75 82:56.6" :
  p == 11 ? "3:5 5:11 20:7171 21:2 34:12 35:5 36:3 40:1 41:40 46:11 47:5 48:4 52:2 53:40 69:0 82:60.2" :
  p == 12 ? "3:9 5:53 9:0 10:1 11:1 12:0 13:0 15:1 16:0 17:1 18:0 19:0 20:1313 21:8 22:45 34:16 36:7 40:0 46:5 47:0 48:1 52:3 68:1 77:85 82:62.6" :
  "";
);
function lv_pstr_au(p) (
  p == 2 ? "3:2 5:3 20:1204 21:3 34:5 36:2 40:1 41:45 46:7 48:3 52:0 65:70 82:60.4" :
  p == 3 ? "3:4 5:39 6:1 20:3131 22:55 34:6 35:5 36:4 40:2 41:65 46:5 47:5 48:6 52:2 53:55 64:35 68:1 82:57.2" :
  p == 4 ? "3:9 5:7 7:1 20:808 34:8 36:0 40:0 42:60 46:8 48:1 52:0 54:60 65:90 67:50 82:62.4" :
  p == 5 ? "3:4 5:10 20:5150 25:55 26:45 34:7 35:5 36:5 40:1 41:65 46:9 47:5 48:3 52:1 53:60 60:4 61:2 78:20 79:25 82:57.1" :
  p == 6 ? "3:5 5:48 6:1 20:2626 34:4 35:0 36:0 37:1 39:90 40:3 46:6 47:3 48:6 52:0 77:80 78:70 79:50 82:57.3" :
  p == 7 ? "3:7 5:42 20:9090 21:6 22:70 34:9 35:6 36:7 39:35 40:0 46:10 47:6 48:2 51:35 52:2 82:54.8" :
  p == 8 ? "3:2 5:33 20:4321 27:70 28:35 34:5 35:1 36:4 40:3 46:6 48:1 52:1 71:70 72:60 74:70 82:60" :
  p == 9 ? "3:9 5:45 20:6006 34:6 36:0 40:0 41:70 46:7 47:3 48:0 52:0 53:70 64:60 65:80 82:59" :
  p == 10 ? "3:11 5:5 6:1 20:1999 24:80 25:25 34:7 36:6 40:2 46:3 47:0 48:0 49:1 51:95 52:3 77:75 82:56.6" :
  p == 11 ? "3:5 5:11 20:7171 21:2 34:12 35:5 36:3 40:1 41:40 46:11 47:5 48:4 52:2 53:40 69:0 82:60.2" :
  p == 12 ? "3:9 5:53 9:0 10:1 11:1 12:0 13:0 15:1 16:0 17:1 18:0 19:0 20:1313 21:8 22:45 34:16 36:7 40:0 46:5 47:0 48:1 52:3 68:1 77:85 82:62.6" :
  "";
);
// a preset leaves RUN, TRANSPORT, the MIDI channel, FATE, VOLUME and the output stage as they are (it never starts
// the run)
function lv_keep(k) ( k == 1 || k == 2 || k == 23 || k == 80 || k == 81 || k >= 83; );
function lv_keep_au(k) ( k == 1 || k == 2 || k == 23 || k == 80 || k == 81 || k >= 83; );
function load_preset(p) local(n, i, k) (
  i = 1; loop(88, !lv_keep(i) ? slider(i) = LVDEF[i - 1]; i += 1; );
  n = lv_nums(lv_pstr(p), LVTMP);
  i = 0; loop(floor(n / 2), k = LVTMP[i * 2]; k >= 1 && k <= 88 && !lv_keep(k) ? slider(k) = LVTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(88, ui_auto(i); i += 1; );
  pr_cur = p; lv_panic = 1;
);
function load_preset_au(p) local(n, i, k) (
  i = 1; loop(88, !lv_keep_au(i) ? slider(i) = LVDEF[i - 1]; i += 1; );
  n = lv_nums_au(lv_pstr_au(p), LVTMP);
  i = 0; loop(floor(n / 2), k = LVTMP[i * 2]; k >= 1 && k <= 88 && !lv_keep_au(k) ? slider(k) = LVTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(88, ui_auto(i); i += 1; );
  pr_cur = p; lv_panic = 1;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(88, slider(i + 1) = LVDEF[i]; ui_auto(i + 1); i += 1; );
);

// ---------- small helpers ----------
function lv_md(a, b) ( a - b * floor(a / b); );
// a hash of four whole numbers, 0 .. 1 (exact in doubles: the same everywhere, so a SEED always gives the same piece)
function lv_r(x) ( x - 65521 * floor(x / 65521); );
function lv_h(a, b, c, d) local(x) (
  x = lv_r(a * 131 + 7);
  x = lv_r(x * x + b * 257 + 3);
  x = lv_r(x * x + c * 523 + 11);
  x = lv_r(x * x + d * 1031 + 17);
  x = lv_r(x * x + 29);
  x = lv_r(x * x + 31);
  x / 65521;
);
// the spirals' rates (beats a step) and the delay's divisions (beats)
function lv_rdiv(i) ( i == 0 ? 1 : i == 1 ? 0.75 : i == 2 ? 0.5 : i == 3 ? 1 / 3 : i == 4 ? 0.375 : i == 5 ? 0.25 : i == 6 ? 1 / 6 : 0.125; );
function lv_ddiv(i) ( i == 0 ? 0.25 : i == 1 ? 1 / 3 : i == 2 ? 0.5 : i == 3 ? 2 / 3 : i == 4 ? 0.75 : i == 5 ? 1 : i == 6 ? 1.5 :
                      i == 7 ? 2 : i == 8 ? 3 : lv_bpb; );
// SHIFT: each tier moves a side's delay to a related division (x 1, dotted, triplet, double, ...)
function lv_shiftf(t) ( t == 0 ? 1 : t == 1 ? 1.5 : t == 2 ? 2 / 3 : t == 3 ? 2 : t == 4 ? 0.75 : t == 5 ? 4 / 3 : t == 6 ? 0.5 : 1.25; );

// ---------- harmony: a degree of the scale in use as a MIDI note (reg = the tonic's note) ----------
function lv_dn(reg, d) local(o, i) ( o = floor(d / lv_n); i = d - o * lv_n; reg + 12 * o + LVCS[i]; );
// the PATTERN shapes: the degree (0 .. the span) a step plays; M = the chord tones (every other degree) in the span
function lv_pat(p, j, sp, mc, sd) local(q, w, k, t) (
  p == 0 ? 2 * lv_md(j, mc) :                                                // UP the chord tones
  p == 1 ? 2 * (mc - 1 - lv_md(j, mc)) :                                      // DOWN
  p == 2 ? ( q = lv_md(j, 2 * mc - 2); q < mc ? 2 * q : 2 * (2 * mc - 2 - q) ) :   // UP-DOWN
  p == 3 ? lv_md(floor(j / 2) + (j & 1) * 2, sp) :                          // THIRDS: up a third, back a step
  p == 4 ? ( t = j & 3; 2 * lv_md(floor(j / 4) + (t == 0 ? 0 : t == 1 ? 2 : t == 2 ? 1 : 3), mc) ) :   // BROKEN CHORD 1-3-2-4
  p == 5 ? lv_md(j, sp) :                                                   // SCALE RUN
  p == 6 ? ( (j & 1) ? 2 * (1 + lv_md(floor(j / 2), max(mc - 1, 1))) : 0 ) :   // PENDULUM: the low tone against a climb
  ( w = 0; k = 1;                                                           // SEEDED WALK
    loop(j, t = floor(lv_h(sd, k, 91, 0) * 6); w += t == 0 ? -2 : t == 1 ? -1 : t == 2 ? 1 : t == 3 ? 2 : t == 4 ? 3 : -3;
      w < 0 ? w = -w; w > sp - 1 ? w = 2 * (sp - 1) - w; w = min(max(w, 0), sp - 1); k += 1; );
    w );
);
// REASSIGN: a step's degree offset in generation g - the last reassignment (within 24 generations) holds
function lv_evo(s, j, g) local(k, r, f) (
  r = 0; f = 0;
  lv_ra > 0 ? (
    k = g;
    while (!f && k >= 1 && k > g - 24) (
      lv_h(lv_seed, s * 16 + j, k, 1) < lv_ra ? ( f = 1; r = floor(lv_h(lv_seed, s * 16 + j, k, 2) * 5) - 2; );
      k -= 1;
    );
  );
  r;
);
// ... and whether the step has migrated to the other side (it plays the other spiral's note)
function lv_mig(s, j, g) local(k, r, f) (
  r = 0; f = 0;
  lv_ra > 0 ? (
    k = g;
    while (!f && k >= 1 && k > g - 24) (
      lv_h(lv_seed, s * 16 + j, k, 3) < lv_ra * 0.5 ? ( f = 1; r = lv_h(lv_seed, s * 16 + j, k, 4) < 0.5; );
      k -= 1;
    );
  );
  r;
);
// a side's own note: step j of loop Lp (its tier climbs an inversion a loop; its generation sets the reassignments)
function lv_note0(s, j, Lp) local(q, tr, g, d) (
  q = LVS + s * 32;
  tr = lv_md(Lp, lv_tiers); g = floor(Lp / lv_tiers);
  d = q[12] + 2 * (q[13] + tr) + lv_pat(q[2], j, q[15], q[16], lv_seed * 2 + s) + lv_evo(s, j, g);
  lv_dn(q[14], d) + 12 * q[4];
);
// a side's phrase for the loop that step k is in: its notes, with the migrations and the courtship's figures
function lv_prep(s, k) local(q, o, nst, Lp, j, nt, tr, g, lop, No, mg, v, d) (
  q = LVS + s * 32; o = LVS + (1 - s) * 32; nst = q[0];
  Lp = floor(k / nst); tr = lv_md(Lp, lv_tiers); g = floor(Lp / lv_tiers);
  No = o[0]; lop = floor(floor(lv_bp / o[1] + 0.000001) / No);              // the other side's loop now
  q[19] = Lp; q[20] = tr; q[21] = g;
  j = 0;
  loop(nst,
    nt = lv_note0(s, j, Lp); mg = 0;
    lv_cev == 4 && s == 1 ? (
      // MIRROR: the right side plays the left's figure upside down, from its own place
      d = q[12] + 2 * (q[13] + tr) + (o[15] - 1 - lv_pat(o[2], lv_md(j, No), o[15], o[16], lv_seed * 2));
      nt = lv_dn(q[14], d) + 12 * q[4]; mg = 3;
    ) : lv_cev == 5 && s == 1 ? (
      // MEETING: the right side joins the left in unison
      nt = lv_note0(0, lv_md(j, No), lop); mg = 4;
    ) : (lv_mig(s, j, g) || (lv_cev == 1 && lv_h(lv_seed, lv_cep, s * 16 + j, 6) < 0.4)) ? (
      // a note that has migrated: the other side's note at this step
      nt = lv_note0(1 - s, lv_md(j, No), lop); mg = 1;
    );
    lv_cev == 3 ? nt += s ? -12 : 12;                                         // OCTAVES traded
    while (nt > 108) ( nt -= 12; ); while (nt < lv_pdt + 5) ( nt += 12; );
    // the phrase's dynamics: an accent on its first step; the last tier fades, the first swells back
    v = j == 0 ? 1 : 0.8 + 0.12 * lv_h(lv_seed, Lp + 7, s * 16 + j, 8);
    lv_tiers > 1 ? ( tr == lv_tiers - 1 ? v *= 1 - 0.5 * j / nst : tr == 0 ? v *= 0.55 + 0.45 * j / nst; ) : v *= 1 - 0.25 * j / nst;
    LVPH[s * 16 + j] = nt; LVPV[s * 16 + j] = v; LVPM[s * 16 + j] = mg;
    j += 1;
  );
);

// ---------- the voices: BELL (two-operator FM), PLUCK (two saws through a low-pass with its envelope), MALLET (three
// modes of a struck bar), PAD (two saws, a slow swell). Six a side; a note on a busy side takes the quietest voice,
// which fades out in 3 ms first ----------
function lv_vgo(n, v, s) instance(st, fd, pn, pv, ps, pd) (
  pn = n; pv = v; ps = s; pd = lv_sdur;
  st == 0 ? fd = 0;
  st = 2;
);
function lv_vclr() instance(st, es, env, am, fd, f1, f2) ( st = 0; es = 0; env = 0; am = 1; fd = 0; f1 = f2 = 0; );
function lv_vtk() instance(ty, fe, fek, fb, fsp, fa1, fa2, fa3) local(fc, g) (
  ty == 1 ? (
    fe *= fek;
    fc = min(fb * 2 ^ (fsp * fe), lv_fmax); g = tan($pi * fc / srate); fa1 = 1 / (1 + g * (g + 1.3)); fa2 = g * fa1; fa3 = g * fa2;
  );
);
function lv_vrun() instance(st, es, ty, env, am, ar, ak, dk, sl, rk, hold, ph, inc, ph2, inc2, mph, minc, ix, ixk, f1, f2, fa1, fa2, fa3,
    fe, fek, fb, fsp, ya1, ya2, yb1, yb2, yc1, yc2, ka, kb, kc, za, zb, zc, wb, wc, vg, fd, pn, pv, ps, pd)
    local(y, t, v1, v2, v3, f, q, tn, gt, w, r, g) (
  st == 2 ? (
    fd -= lv_fdk;
    fd <= 0 ? (
      // the waiting note starts
      q = LVS + ps * 32; ty = q[6]; tn = q[7]; gt = q[5];
      f = 440 * 2 ^ ((pn - 69) / 12) * ins_pitch; inc = min(f / srate, 0.45);
      hold = max(gt * pd, 0.012 * srate);
      env = 0; es = 1; am = 1; ar = 1; fd = 1; st = 1; f1 = f2 = 0;
      ty == 0 ? (
        // BELL: a glassy pair (the modulator 3.5 x the carrier); TONE sets the index, GATE the ring; the index decays
        // faster than the bell, and is held under the band limit (two sidebands past the index still under 45 % of the rate)
        ph = 0; mph = 0; minc = inc * 3.5; minc -= floor(minc);
        ix = min(0.5 + 3.5 * tn, max((0.45 * srate - f) / (3.5 * f) - 2.3, 0));
        ixk = exp(-1 / ((0.06 + 0.5 * gt) * (0.5 + tn) * srate));
        ak = 1 - exp(-1 / (0.0015 * srate)); sl = 0; dk = 1 - exp(-1 / ((0.3 + 3.2 * gt) * srate)); rk = exp(-1 / (0.4 * srate));
        vg = pv * 0.5;
      ) : ty == 1 ? (
        // PLUCK: two saws a few cents apart, the low-pass opening on the pluck (TONE: its height and sweep)
        ph = rand(1); ph2 = rand(1); inc2 = min(inc * 1.0035, 0.45);
        ak = 1 - exp(-1 / (0.002 * srate)); sl = 0; dk = 1 - exp(-1 / ((0.12 + 1.1 * gt) * srate)); rk = exp(-1 / (0.12 * srate));
        fb = min(140 * 2 ^ (tn * 5.2) * sqrt(f / 261.6), lv_fmax); fsp = 1.5 + 3 * tn; fe = 1;
        fek = exp(-TK / ((0.05 + 0.25 * gt) * srate));
        r = min(fb * 2 ^ fsp, lv_fmax); g = tan($pi * r / srate); fa1 = 1 / (1 + g * (g + 1.3)); fa2 = g * fa1; fa3 = g * fa2;
        vg = pv * 1.24;
      ) : ty == 2 ? (
        // MALLET: a bar's three modes (1 : 3.93 : 9.6), the higher ones shorter; TONE is the mallet's hardness
        t = 0.3 + 2.2 * gt;
        w = TWOPI * f / srate; r = exp(-1 / (t * srate)); ka = 2 * r * cos(w); za = r * r; ya1 = sin(w); ya2 = 0; ar = r;
        w = TWOPI * min(f * 3.93, 0.45 * srate) / srate; r = exp(-1 / (0.3 * t * srate)); kb = 2 * r * cos(w); zb = r * r;
        yb1 = sin(w); yb2 = 0; wb = f * 3.93 < 0.45 * srate ? 0.2 + 0.55 * tn : 0;
        w = TWOPI * min(f * 9.6, 0.45 * srate) / srate; r = exp(-1 / (0.1 * t * srate)); kc = 2 * r * cos(w); zc = r * r;
        yc1 = sin(w); yc2 = 0; wc = f * 9.6 < 0.45 * srate ? 0.03 + 0.4 * tn * tn : 0;
        env = 1; es = 2; sl = 1; dk = 0; rk = exp(-1 / (0.1 * srate));
        vg = pv * 0.635;
      ) : (
        // PAD: two saws (10 cents apart) through a gentle low-pass (TONE), swelling in and dying slowly
        ph = rand(1); ph2 = rand(1); inc2 = min(inc * 1.0058, 0.45);
        ak = 1 - exp(-1 / (min(max(0.4 * hold / srate, 0.04), 0.8) * srate)); sl = 1; dk = 0;
        rk = exp(-1 / ((0.4 + 1.2 * gt) * srate));
        fb = min(220 * 2 ^ (tn * 4.6) * sqrt(f / 261.6), lv_fmax); g = tan($pi * fb / srate);
        fa1 = 1 / (1 + g * (g + 1.4)); fa2 = g * fa1; fa3 = g * fa2;
        vg = pv * 0.66;
      );
    );
  );
  ty == 0 ? (
    ph += inc; ph -= floor(ph); mph += minc; mph -= floor(mph);
    y = sin(TWOPI * ph + ix * sin(TWOPI * mph)); ix *= ixk;
  ) : ty == 2 ? (
    t = ka * ya1 - za * ya2; ya2 = ya1; ya1 = t; y = t;
    t = kb * yb1 - zb * yb2; yb2 = yb1; yb1 = t; y += t * wb;
    t = kc * yc1 - zc * yc2; yc2 = yc1; yc1 = t; y += t * wc;
    am *= ar;
  ) : (
    ph += inc; ph -= floor(ph); ph2 += inc2; ph2 -= floor(ph2);
    t = (2 * ph - 1 - vo_blep(ph, inc) + 2 * ph2 - 1 - vo_blep(ph2, inc2)) * 0.5;
    v3 = t - f2; v1 = fa1 * f1 + fa2 * v3; v2 = f2 + fa2 * f1 + fa3 * v3; f1 = 2 * v1 - f1; f2 = 2 * v2 - f2; y = v2;
  );
  // the envelope: attack, decay to SUSTAIN while the gate is held, release
  es == 1 ? ( env += (1.25 - env) * ak; env >= 1 ? ( env = 1; es = 2; ); ) :
  es == 2 ? ( env += (sl - env) * dk; (hold -= 1) <= 0 ? es = 3; ) :
  env *= rk;
  st == 1 && es >= 2 && env * am < 0.00003 ? ( st = 0; env = 0; f1 = f2 = 0; );
  y * env * vg * fd;
);

// ---------- the pedal drone: a detuned pair of band-limited saws, a square an octave down (SUB), a saw a fifth up
// (FIFTH); two of them, so a pedal that moves far crossfades instead of sliding ----------
function lv_dosc() instance(p1, p2, p3, p4, i1, i2, i3, i4) local(y, t) (
  p1 += i1; p1 -= floor(p1); p2 += i2; p2 -= floor(p2); p3 += i3; p3 -= floor(p3); p4 += i4; p4 -= floor(p4);
  y = (2 * p1 - 1 - vo_blep(p1, i1) + 2 * p2 - 1 - vo_blep(p2, i2)) * 0.5;
  t = p3 + 0.5; t -= floor(t);
  y += (2 * p3 - 1 - vo_blep(p3, i3) - (2 * t - 1 - vo_blep(t, i3))) * 0.5 * lv_dsub;
  y + (2 * p4 - 1 - vo_blep(p4, i4)) * 0.35 * lv_d5;
);
function lv_dset() instance(i1, i2, i3, i4, pn) local(f) (
  f = 440 * 2 ^ ((pn - 69) / 12);
  i1 = min(f * 2 ^ (lv_ddet / 2400), lv_f45) / srate; i2 = min(f * 2 ^ (-lv_ddet / 2400), lv_f45) / srate;
  i3 = f * 0.5 / srate; i4 = min(f * 1.5, lv_f45) / srate;
);
function lv_dph() instance(p1, p2, p3, p4) ( p1 = rand(1); p2 = rand(1); p3 = rand(1); p4 = rand(1); );

// ---------- the shimmer reverb's parts ----------
function lv_rl(base, n, gn, m) instance(z) local(rp, ri, f, d) (
  m != 0 ? ( rp = lv_rw - n - m; ri = floor(rp); f = rp - ri; d = base[ri & LVRM]; d += (base[(ri + 1) & LVRM] - d) * f; ) :
           d = base[(lv_rw - n) & LVRM];
  z += (d - z) * lv_rdmp;
  z * gn;
);
function lv_ap(base, n, x, k) instance(wp) local(d, v) (
  d = base[(wp - n) & LVAPM]; v = x + k * d; abs(v) < 0.000000000001 ? v = 0; base[wp] = v; wp = (wp + 1) & LVAPM;
  d - k * v;
);

function lv_goL(n, v) local(b, k) (
  !lvl0.st ? lvl0.lv_vgo(n, v, 0) : !lvl1.st ? lvl1.lv_vgo(n, v, 0) : !lvl2.st ? lvl2.lv_vgo(n, v, 0) : !lvl3.st ? lvl3.lv_vgo(n, v, 0) : !lvl4.st ? lvl4.lv_vgo(n, v, 0) : !lvl5.st ? lvl5.lv_vgo(n, v, 0) : (
    b = lvl0.env * lvl0.am; k = 0;
    lvl1.st == 1 && lvl1.env * lvl1.am < b ? ( b = lvl1.env * lvl1.am; k = 1; );
    lvl2.st == 1 && lvl2.env * lvl2.am < b ? ( b = lvl2.env * lvl2.am; k = 2; );
    lvl3.st == 1 && lvl3.env * lvl3.am < b ? ( b = lvl3.env * lvl3.am; k = 3; );
    lvl4.st == 1 && lvl4.env * lvl4.am < b ? ( b = lvl4.env * lvl4.am; k = 4; );
    lvl5.st == 1 && lvl5.env * lvl5.am < b ? ( b = lvl5.env * lvl5.am; k = 5; );
    k == 0 ? lvl0.lv_vgo(n, v, 0) : k == 1 ? lvl1.lv_vgo(n, v, 0) : k == 2 ? lvl2.lv_vgo(n, v, 0) : k == 3 ? lvl3.lv_vgo(n, v, 0) : k == 4 ? lvl4.lv_vgo(n, v, 0) : lvl5.lv_vgo(n, v, 0);
  );
);
function lv_goR(n, v) local(b, k) (
  !lvr0.st ? lvr0.lv_vgo(n, v, 1) : !lvr1.st ? lvr1.lv_vgo(n, v, 1) : !lvr2.st ? lvr2.lv_vgo(n, v, 1) : !lvr3.st ? lvr3.lv_vgo(n, v, 1) : !lvr4.st ? lvr4.lv_vgo(n, v, 1) : !lvr5.st ? lvr5.lv_vgo(n, v, 1) : (
    b = lvr0.env * lvr0.am; k = 0;
    lvr1.st == 1 && lvr1.env * lvr1.am < b ? ( b = lvr1.env * lvr1.am; k = 1; );
    lvr2.st == 1 && lvr2.env * lvr2.am < b ? ( b = lvr2.env * lvr2.am; k = 2; );
    lvr3.st == 1 && lvr3.env * lvr3.am < b ? ( b = lvr3.env * lvr3.am; k = 3; );
    lvr4.st == 1 && lvr4.env * lvr4.am < b ? ( b = lvr4.env * lvr4.am; k = 4; );
    lvr5.st == 1 && lvr5.env * lvr5.am < b ? ( b = lvr5.env * lvr5.am; k = 5; );
    k == 0 ? lvr0.lv_vgo(n, v, 1) : k == 1 ? lvr1.lv_vgo(n, v, 1) : k == 2 ? lvr2.lv_vgo(n, v, 1) : k == 3 ? lvr3.lv_vgo(n, v, 1) : k == 4 ? lvr4.lv_vgo(n, v, 1) : lvr5.lv_vgo(n, v, 1);
  );
);
function lv_vclear() ( lvl0.lv_vclr(); lvl1.lv_vclr(); lvl2.lv_vclr(); lvl3.lv_vclr(); lvl4.lv_vclr(); lvl5.lv_vclr(); lvr0.lv_vclr(); lvr1.lv_vclr(); lvr2.lv_vclr(); lvr3.lv_vclr(); lvr4.lv_vclr(); lvr5.lv_vclr(); );
// a step: the side's phrase for this loop, its note on the side's voices; the side moves on
function lv_fire(s) local(q, k, nst, j, nt, v) (
  q = LVS + s * 32; k = s ? lv_kr : lv_kl; nst = q[0];
  j = lv_md(k, nst);
  lv_prep(s, k);
  nt = LVPH[s * 16 + j]; v = LVPV[s * 16 + j];
  q[22] = j; q[23] = nt; q[24] = k;
  // a new generation (the tiers wrapped back to the base): SHIFT softly resets the delay
  j == 0 && q[20] == 0 && lv_shift && q[19] > 0 ? lv_drq = 1;
  lv_sdur = q[1] * 60 / lv_tmp * srate;
  s ? lv_goR(nt, v) : lv_goL(nt, v);
  s ? ( lv_kr += 1; lv_tr = lv_kr * lv_divr; ) : ( lv_kl += 1; lv_tl = lv_kl * lv_divl; );
);

// ---------- parameters ----------
function lv_update() local(t, i, m, s, b, q) (
  lv_tmp = tempo > 0 ? tempo : 120;
  lv_bpb = (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  lv_runk = slider1 >= 0.5;
  lv_rpc = floor(slider3 + 0.5); lv_oct = floor(slider4 + 0.5);
  lv_scl = floor(slider5 + 0.5); lv_cpl = slider6 >= 0.5; lv_lock = slider7 >= 0.5;
  // the scale: one from the library, or CUSTOM (its twelve keys; the tonic is always in)
  m = 1; i = 1; loop(11, slider(8 + i) >= 0.5 ? m += 2 ^ i; i += 1; );
  lv_cmask = m;
  t = lv_scl >= 53 ? lv_cmask : LVSC[lv_scl];
  t !== lv_mask ? (
    lv_mask = t; lv_n = 0; i = 0;
    loop(12, floor(t / 2 ^ i) - 2 * floor(t / 2 ^ (i + 1)) ? ( LVCS[lv_n] = i; lv_n += 1; ); i += 1; );
    lv_n < 1 ? ( LVCS[0] = 0; lv_n = 1; );
  );
  lv_seed = floor(slider20 + 0.5); lv_tiers = max(floor(slider21 + 0.5), 1); lv_ra = slider22 / 100;
  lv_chan = floor(slider23 + 0.5);
  // the drone
  lv_dlev = sqr(slider24 / 100); lv_dtone = slider25 / 100; lv_ddrv = slider26 / 100;
  lv_dsub = slider27 / 100; lv_d5 = slider28 / 100; lv_ddet = slider29; lv_glms = slider30;
  lv_sdd = slider31 / 100; lv_sdm = slider32 / 100; lv_sds = slider33 / 100;
  // the spirals: STEPS, RATE, PATTERN, RANGE, OCTAVE, GATE, VOICE, TONE, LEVEL, the three sends
  s = 0;
  loop(2,
    b = 34 + s * 12; q = LVS + s * 32;
    q[0] = floor(slider(b) + 0.5); q[1] = lv_rdiv(floor(slider(b + 1) + 0.5)); q[2] = floor(slider(b + 2) + 0.5);
    q[3] = floor(slider(b + 3) + 0.5); q[4] = floor(slider(b + 4) + 0.5); q[5] = slider(b + 5) / 100;
    q[6] = floor(slider(b + 6) + 0.5); q[7] = slider(b + 7) / 100; q[8] = sqr(slider(b + 8) / 100);
    q[9] = slider(b + 9) / 100; q[10] = slider(b + 10) / 100; q[11] = slider(b + 11) / 100;
    q[15] = q[3] * lv_n; q[16] = max(2, ceil(q[15] / 2));
    s += 1;
  );
  lv_divl = LVS[1]; lv_divr = LVS[33];
  // the cross-feedback delay
  lv_dlin = slider58 >= 0.5; lv_dsync = slider59 >= 0.5;
  lv_ddl = lv_ddiv(floor(slider60 + 0.5)); lv_ddr = lv_ddiv(floor(slider61 + 0.5));
  lv_dml = slider62; lv_dmr = slider63;
  lv_dfb = slider64 / 100; lv_dx = slider65 / 100;
  lv_dtc = 1 - exp(-TWOPI * min(700 * 2 ^ (slider66 / 100 * 4.3), srate * 0.45) / srate);
  lv_dmix = slider67 / 100; lv_shift = slider68 >= 0.5;
  // the modulation
  lv_mdin = slider69 >= 0.5; lv_mrate = slider70; lv_mdep = slider71 / 100; lv_mph = slider72 / 100;
  lv_mwid = slider73 / 100; lv_mmix = slider74 / 100;
  // the shimmer reverb
  lv_rvin = slider75 >= 0.5; lv_rsz = slider76 / 100; lv_rdc = slider77 / 100; lv_rsh = slider78 / 100; lv_rmix = slider79 / 100;
  lv_rdec = 1.5 + 23.5 * lv_rdc ^ 1.7;                       // RT60 (s): 1.5 - 25
  t = srate / 1000 * (0.7 + 1.15 * lv_rsz);
  LVTMP[180] = min(37.1 * t, LVRN - 40); LVTMP[181] = min(41.3 * t, LVRN - 40); LVTMP[182] = min(47.9 * t, LVRN - 40);
  LVTMP[183] = min(53.3 * t, LVRN - 40); LVTMP[184] = min(59.7 * t, LVRN - 40); LVTMP[185] = min(67.1 * t, LVRN - 40);
  LVTMP[186] = min(73.9 * t, LVRN - 40); LVTMP[187] = min(81.7 * t, LVRN - 40);
  // MASTER
  lv_fa = slider80 / 50;                                     // FATE: 1 = the standard amount
  lv_volt = 10 ^ (slider81 / 20) * sqr(slider82 / 100) * 2.3;
  ins_output_setup(83);   // output stage: CLIP, always on
);
function lv_clear() (
  memset(LVDL, 0, LVDN); memset(LVDR, 0, LVDN); memset(LVCH, 0, 4096); memset(LVCR, 0, 4096);
  memset(LVPD, 0, 16384); memset(LVAP, 0, 4 * LVAPN); memset(LVRV, 0, 8 * LVRN); memset(LVPS, 0, 8192);
  lv_vclear();
  lv_s1 = lv_s2 = 0; lvkD.clp_reset(); lvfD.clp_pf_reset();
  lv_dfl = lv_dfr = lv_dhl = lv_dhr = 0;
  lv_pa1 = lv_pa2 = lv_pa3 = lv_pa4 = lv_pb1 = lv_pb2 = lv_pb3 = lv_pb4 = lv_pfl = lv_pfr = 0;
  lvq0.z = lvq1.z = lvq2.z = lvq3.z = lvq4.z = lvq5.z = lvq6.z = lvq7.z = 0;
  lv_rh1 = lv_sl = lv_sh = lv_shf = lv_hl = lv_hr = 0; lv_rsil = 0;
  lv_dcxl = lv_dcxr = lv_dcyl = lv_dcyr = 0;
);

function lv_srinit() (
  lv_sr = srate; ost_init(20000);
  lv_sk = 1 - exp(-TK / (0.02 * srate));                   // controls glide: about 20 ms
  lv_ek = 1 - exp(-TK / (0.12 * srate));                   // the effects in / out: 120 ms
  lv_pnk = 1 - exp(-TK / (0.25 * srate));                  // the pans glide: 250 ms
  lv_gak = 1 - exp(-TK / (0.7 * srate)); lv_grk = 1 - exp(-TK / (1.5 * srate));   // the drone: swells in, dies away
  lv_sm = 1 - exp(-1 / (0.03 * srate));
  lv_dsk = 1 - exp(-1 / (0.3 * srate));                    // the delay times glide (like tape)
  lv_fdk = 1 / (0.003 * srate);                            // a voice taken: 3 ms out
  lv_pcdn = 1 / (0.012 * srate); lv_pcup = 1 / (0.02 * srate);   // preset change: 12 ms out, 20 ms in
  lv_drk = 1 / (0.15 * srate);                             // the delay's soft reset: 150 ms out, 150 ms in
  lv_f45 = 0.45 * srate; lv_fmax = 0.42 * srate;
  lv_dhk = 1 - exp(-TWOPI * 60 / srate);                   // the delay's feedback high-pass
  LVTMP[190] = min(floor(4.77 * srate / 1000), LVAPN - 2); LVTMP[191] = min(floor(3.59 * srate / 1000), LVAPN - 2);
  LVTMP[192] = min(floor(12.73 * srate / 1000), LVAPN - 2); LVTMP[193] = min(floor(9.31 * srate / 1000), LVAPN - 2);
  lv_pdn = floor(0.024 * srate);
  lv_rhk = 1 - exp(-TWOPI * 140 / srate);                  // the shimmer's input high-pass
  lv_rdmp = 1 - exp(-TWOPI * min(9000, 0.42 * srate) / srate);   // its lines' damping (bright)
  lv_psw = floor(0.045 * srate);                           // the octave shifter's window
  lv_slk = 1 - exp(-TWOPI * min(7000, 0.42 * srate) / srate); lv_shk = 1 - exp(-TWOPI * 300 / srate);
  lv_hlk = 1 - exp(-TWOPI * 3000 / srate);                 // the high lift
  lv_sck = 1 - exp(-TWOPI * 900 / srate);                  // (the scope's smoothing)
  lv_pkd = exp(-1 / (0.25 * srate));                       // (the output meter's fall)
  lv_update();
  lv_first = 1;
);

ins_drift_init();
// the house drive on the drone: the KNEE clipper (anti-aliased), the drive-tracking pre-filter and knee
clp_kt_on = 1;
lvkD.clp_set(2, 1, 1, 0); lvkD.clp_kt_cfg(0.3, 0.65); lvfD.clp_pf_cfg(40000, 9000, -1.5, 150);
lv_dgd = lv_dgdt = lv_dmd = 1; lv_pcf = 0; lv_pcg = 1; lv_ct = TK - 1;
lv_bp = 0; lv_kl = lv_kr = 0; lv_tl = lv_tr = 0; lv_runw = 0; lv_tpw = 0; lv_nh = 0; lv_pdw = -1; lv_act = 0; lv_xf = 0;
lv_mask = -1; lv_cev = 0; lv_cep = 0; lv_pl = lv_pls = -1; lv_pr = lv_prs = 1; lv_drs = 0; lv_drf = 1; lv_drq = 0;
lv_dw = 0; lv_cw = 0; lv_rw = 0; lv_pw_ = 0; lv_psp = 0; lv_pph = 0; lv_scw = 0; lv_scd = 0; lv_mp = 0; lv_mp2 = 0; lv_rp1 = 0;
lv_dg = 0; lv_pvt = 6; lv_dts_l = lv_dts_r = -1; lv_xpw = play_state & 1; lv_bfirst = 1;
lv_srinit();
lv_vclear();
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
lv_vol = lv_volt;
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
!lv_pcf && !lv_panic ? lv_update();

@block
prs_chk();
srate != lv_sr ? lv_srinit();
// it loads stopped: whatever RUN was saved as, nothing plays until REAPER plays (TRANSPORT) or RUN is pressed
lv_bfirst ? ( slider1 >= 0.5 ? ( slider1 = 0; ui_auto(1); ); lv_bfirst = 0; );
// TRANSPORT: while lit, REAPER's play (or record) starts the run and its stop stops it; RUN still works by hand
lv_xp = play_state & 1;
slider2 >= 0.5 && lv_xp != lv_xpw ? ( slider1 = lv_xp; ui_auto(1); );
lv_xpw = lv_xp;
// a preset change: the old sound fades out (12 ms), everything is cleared at the silent point, then it fades in (20 ms)
lv_panic && !lv_pcf ? ( lv_pcf = 1; lv_panic = 0; );
lv_pcf == 2 ? ( lv_clear(); lv_first = 1; lv_pcf = 3; );
lv_pcf != 1 ? lv_update();

// ---------- MIDI: the keys held; the lowest sets the pedal ----------
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, lv_chan) ? (
    lv_ms = m1 & 0xF0;
    lv_ms == 0x90 && m3 > 0 ? (
      ins_midi_hit();
      i_ = 0; j_ = 0; loop(lv_nh, LVHN[i_] != m2 ? ( LVHN[j_] = LVHN[i_]; j_ += 1; ); i_ += 1; ); lv_nh = j_;
      lv_nh < 64 ? ( LVHN[lv_nh] = m2; lv_nh += 1; );
    ) : lv_ms == 0x80 || (lv_ms == 0x90 && m3 == 0) ? (
      i_ = 0; j_ = 0; loop(lv_nh, LVHN[i_] != m2 ? ( LVHN[j_] = LVHN[i_]; j_ += 1; ); i_ += 1; ); lv_nh = j_;
    ) : lv_ms == 0xB0 && (m2 == 120 || m2 == 123) ? lv_nh = 0;
  );
  midisend(mofs, m1, m2, m3);
);
// the pedal: the lowest key held (its note name, in the panel's OCTAVE), else the panel's ROOT
lv_lo = 128; i_ = 0; loop(lv_nh, lv_lo = min(lv_lo, LVHN[i_]); i_ += 1; );
lv_ppc = lv_nh > 0 ? lv_lo % 12 : lv_rpc;
lv_pdt = 12 * (lv_oct + 1) + lv_ppc;
lv_panp = 12 * (lv_oct + 1) + lv_rpc;
// the coupling: MODE FOLLOWS BASS roots the scale on the pedal; BASS FOLLOWS MODE keeps the tonic (ROOT) and the
// pedal becomes a degree of it - the spirals start from the scale's degree at (or just above) the pedal
lv_ton = lv_cpl ? lv_rpc : lv_ppc;
lv_rel = lv_md(lv_ppc - lv_ton, 12);
lv_reg = lv_pdt - lv_rel + 12;
lv_base = 0;
lv_cpl ? ( i_ = lv_n - 1; lv_base = lv_n; while (i_ >= 0) ( LVCS[i_] >= lv_rel ? lv_base = i_; i_ -= 1; ); );
// a new pedal draws new inversions (from the SEED); LOCK keeps the ROOT's own
lv_ivk = lv_lock ? lv_panp : lv_pdt;
LVS[12] = lv_base; LVS[13] = floor(lv_h(lv_seed, lv_ivk, 0, 3) * 4); LVS[14] = lv_reg;
LVS[44] = lv_base + 2; LVS[45] = floor(lv_h(lv_seed, lv_ivk, 1, 3) * 4); LVS[46] = lv_reg;   // (the right side a third up)
// the drone's two voices: a move of a tone or less glides; further, the other voice takes the new pedal and they crossfade
lv_pdt !== lv_pdw ? (
  lv_pdw < 0 ? ( lvdA.pn = lvdA.pt = lv_pdt; lv_act = 0; lv_xf = 0; ) :
  abs(lv_pdt - (lv_act ? lvdB.pt : lvdA.pt)) <= 2.01 ? ( lv_act ? lvdB.pt = lv_pdt : lvdA.pt = lv_pdt; ) : (
    lv_act = !lv_act;
    lv_act ? ( lvdB.pt = lvdB.pn = lv_pdt; lvdB.lv_dph(); ) : ( lvdA.pt = lvdA.pn = lv_pdt; lvdA.lv_dph(); );
  );
  lv_pdw = lv_pdt;
);
lv_glk = 1 - exp(-TK / (max(lv_glms, 1) * 0.001 * srate) * 2.3);
lv_xfk = TK / (max(lv_glms, 40) * 0.001 * srate);

// ---------- the clock: REAPER's position while it plays, its own at the project tempo while stopped (from the bar) ----------
lv_run = slider1 >= 0.5;
lv_tp = play_state & 1;
lv_dbp = lv_tmp / 60 / srate;
lv_run ? (
  !lv_runw ? ( lv_bp = lv_tp ? beat_position : 0; lv_rsy = 1; ) :
  lv_tp ? ( (!lv_tpw || abs(beat_position - lv_bp) > 0.05) ? lv_rsy = 1; lv_bp = beat_position; );
  (lv_divl !== lv_divlw || lv_divr !== lv_divrw) ? lv_rsy = 1;
  lv_rsy ? (
    lv_kl = ceil(lv_bp / lv_divl - 0.000001); lv_tl = lv_kl * lv_divl;
    lv_kr = ceil(lv_bp / lv_divr - 0.000001); lv_tr = lv_kr * lv_divr;
    lv_rsy = 0;
  );
);
// (stopped: the phrases about to play, for the panel - refreshed a few times a second)
!lv_run ? ( (lv_pvt += 1) >= 6 ? ( lv_pvt = 0; lv_prep(0, max(lv_kl, 0)); lv_prep(1, max(lv_kr, 0)); LVS[22] = lv_md(lv_kl, LVS[0]); LVS[54] = lv_md(lv_kr, LVS[32]); ); );
lv_runw = lv_run; lv_tpw = lv_tp; lv_divlw = lv_divl; lv_divrw = lv_divr;

// ---------- FATE: the courtship - the song is cut into four-bar spans; in some (more often with more FATE) the two
// orbits court: they EXCHANGE notes, trade PANS (cross over and back), trade OCTAVES, MIRROR each other or MEET in
// unison; between spans they drift apart again. All of it from the song position and the SEED, so a render repeats ----------
lv_epl = 4 * lv_bpb;
lv_cep = floor(lv_bp / lv_epl); lv_cu = lv_bp / lv_epl - lv_cep;
lv_cev = 0;
lv_fa > 0 && lv_h(lv_seed, lv_cep + 1000, 0, 5) < min(0.35 * lv_fa, 0.85) ? (
  lv_t = lv_h(lv_seed, lv_cep + 1000, 0, 7);
  lv_cev = lv_t < 0.3 ? 1 : lv_t < 0.55 ? 2 : lv_t < 0.7 ? 3 : lv_t < 0.85 ? 4 : 5;
);
lv_w = sqr(sin($pi * lv_cu));
lv_pl = -1;
lv_cev == 2 ? lv_pl = -1 + 1.8 * lv_w * min(lv_fa, 1) : lv_cev == 5 ? lv_pl = -1 + 0.75 * lv_w * min(lv_fa, 1);
lv_pl += 0.06 * lv_fa * (1 - cos(TWOPI * lv_bp / (11 * lv_bpb)));            // and a slow sway
lv_pl = min(max(lv_pl, -1), 1); lv_pr = -lv_pl;
ins_drift_block(slider80 / 200, samplesblock);

// ---------- the delay: its times (synced or free; SHIFT moves each side's with its tier), its soft reset ----------
lv_t = lv_dsync ? lv_ddl * 60 / lv_tmp : lv_dml * 0.001;
lv_dtt_l = min(max(lv_t * (lv_shift ? lv_shiftf(LVS[20] & 7) : 1) * srate, 16), LVDN - 0.02 * srate - 8);
lv_t = lv_dsync ? lv_ddr * 60 / lv_tmp : lv_dmr * 0.001;
lv_dtt_r = min(max(lv_t * (lv_shift ? lv_shiftf(LVS[52] & 7) : 1) * srate, 16), LVDN - 0.02 * srate - 8);
lv_drs == 2 ? ( memset(LVDL, 0, LVDN); memset(LVDR, 0, LVDN); lv_dfl = lv_dfr = lv_dhl = lv_dhr = 0; lv_drs = 3; );

// ---------- the drone's drive (the house standard): DRIVE to +30 dB into the knee, glided, level-matched ----------
lv_g = 10 ^ (1.5 * lv_ddrv);
lv_dgdt += (lv_g - lv_dgdt) * (1 - exp(-samplesblock / (0.03 * srate))); lv_dgdi = (lv_dgdt - lv_dgd) / samplesblock;
lv_dmdi = (1 / min(lv_dgdt, 2.86) - lv_dmd) / samplesblock;
lvfD.clp_pf_block(lv_ddrv, srate, samplesblock); lv_k = lvkD.clp_kt_block(lv_ddrv, srate, samplesblock); lvkD.clp_knee(lv_k);
lvkD.clp_tidy();
// the effects switched fully out: their lines are emptied, so switching them back in starts clean
lv_rvg > 0.0001 ? lv_ract = 1 : lv_ract ? (
  memset(LVRV, 0, 8 * LVRN); memset(LVAP, 0, 4 * LVAPN); memset(LVPS, 0, 8192);
  lvq0.z = lvq1.z = lvq2.z = lvq3.z = lvq4.z = lvq5.z = lvq6.z = lvq7.z = 0; lv_shf = lv_sl = lv_sh = lv_rh1 = 0; lv_ract = 0; );
lv_dlg > 0.0001 ? lv_dact = 1 : lv_dact ? ( memset(LVDL, 0, LVDN); memset(LVDR, 0, LVDN); lv_dfl = lv_dfr = lv_dhl = lv_dhr = 0; lv_dact = 0; );
lv_mdg > 0.0001 ? lv_mact = 1 : lv_mact ? ( memset(LVCH, 0, 4096); memset(LVCR, 0, 4096);
  lv_pa1 = lv_pa2 = lv_pa3 = lv_pa4 = lv_pb1 = lv_pb2 = lv_pb3 = lv_pb4 = lv_pfl = lv_pfr = 0; lv_mact = 0; );
// (no denormals)
abs(lv_s1) + abs(lv_s2) < 0.000000000001 ? lv_s1 = lv_s2 = 0;
abs(lv_dfl) + abs(lv_dfr) + abs(lv_dhl) + abs(lv_dhr) < 0.000000000001 ? lv_dfl = lv_dfr = lv_dhl = lv_dhr = 0;
abs(lv_dcyl) + abs(lv_dcyr) < 0.000000000001 ? lv_dcyl = lv_dcyr = 0;
abs(lv_pa1) + abs(lv_pa4) + abs(lv_pb1) + abs(lv_pb4) + abs(lv_pfl) + abs(lv_pfr) < 0.000000000001 ?
  lv_pa1 = lv_pa2 = lv_pa3 = lv_pa4 = lv_pb1 = lv_pb2 = lv_pb3 = lv_pb4 = lv_pfl = lv_pfr = 0;
abs(lv_sl) + abs(lv_sh) + abs(lv_shf) + abs(lv_rh1) + abs(lv_hl) + abs(lv_hr) < 0.000000000001 ? lv_sl = lv_sh = lv_shf = lv_rh1 = lv_hl = lv_hr = 0;
abs(ostL.lz1) + abs(ostL.lz2) + abs(ostL.hz1) + abs(ostL.hz2) + abs(ostL.dcy) < 0.000000000001 ? ostL.lz1 = ostL.lz2 = ostL.hz1 = ostL.hz2 = ostL.dcy = 0;
abs(ostR.lz1) + abs(ostR.lz2) + abs(ostR.hz1) + abs(ostR.hz2) + abs(ostR.dcy) < 0.000000000001 ? ostR.lz1 = ostR.lz2 = ostR.hz1 = ostR.hz2 = ostR.dcy = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the control tick (every 16 samples) ----------
lv_ct += 1;
lv_ct >= TK ? (
  lv_ct = 0;
  lv_first ? (
    lv_vol = lv_volt; lv_dts_l = lv_dtt_l; lv_dts_r = lv_dtt_r; lv_pls = lv_pl; lv_prs = lv_pr;
    lv_gl = LVS[8]; lv_gr = LVS[40]; lv_first = 0;
  );
  // the drone: the run swells it in and lets it die away; its pitches glide; its two voices crossfade
  lv_dg += (lv_run - lv_dg) * (lv_run ? lv_gak : lv_grk); !lv_run && lv_dg < 0.000001 ? lv_dg = 0;
  lvdA.pn += (lvdA.pt - lvdA.pn) * lv_glk; lvdB.pn += (lvdB.pt - lvdB.pn) * lv_glk;
  lv_xf = lv_act ? min(lv_xf + lv_xfk, 1) : max(lv_xf - lv_xfk, 0);
  lv_xa = cos(lv_xf * 0.5 * $pi); lv_xb = sin(lv_xf * 0.5 * $pi);
  lv_xa > 0.00001 ? lvdA.lv_dset(); lv_xb > 0.00001 ? lvdB.lv_dset();
  lv_f = min(max(55 * 2 ^ (lv_dtone * 7.2) * (1 + 0.004 * (lv_pdt - 36)), 30), lv_fmax);
  lv_t = tan($pi * lv_f / srate); lv_da1 = 1 / (1 + lv_t * (lv_t + 1.35)); lv_da2 = lv_t * lv_da1; lv_da3 = lv_t * lv_da2;
  lv_dgn += (lv_dlev * lv_dg - lv_dgn) * lv_sk;
  // the spirals' levels, pans (equal power) and sends
  lv_gl += (LVS[8] - lv_gl) * lv_sk; lv_gr += (LVS[40] - lv_gr) * lv_sk;
  lv_pls += (lv_pl - lv_pls) * lv_pnk; lv_prs += (lv_pr - lv_prs) * lv_pnk;
  lv_all = cos((lv_pls + 1) * 0.25 * $pi); lv_alr = sin((lv_pls + 1) * 0.25 * $pi);
  lv_arl = cos((lv_prs + 1) * 0.25 * $pi); lv_arr = sin((lv_prs + 1) * 0.25 * $pi);
  lv_e1 += (LVS[9] - lv_e1) * lv_sk; lv_e2 += (LVS[10] - lv_e2) * lv_sk; lv_e3 += (LVS[11] - lv_e3) * lv_sk;
  lv_h1 += (LVS[41] - lv_h1) * lv_sk; lv_h2 += (LVS[42] - lv_h2) * lv_sk; lv_h3 += (LVS[43] - lv_h3) * lv_sk;
  lv_c1 += (lv_sdd - lv_c1) * lv_sk; lv_c2 += (lv_sdm - lv_c2) * lv_sk; lv_c3 += (lv_sds - lv_c3) * lv_sk;
  lvl0.st ? lvl0.lv_vtk(); lvl1.st ? lvl1.lv_vtk(); lvl2.st ? lvl2.lv_vtk(); lvl3.st ? lvl3.lv_vtk(); lvl4.st ? lvl4.lv_vtk(); lvl5.st ? lvl5.lv_vtk(); lvr0.st ? lvr0.lv_vtk(); lvr1.st ? lvr1.lv_vtk(); lvr2.st ? lvr2.lv_vtk(); lvr3.st ? lvr3.lv_vtk(); lvr4.st ? lvr4.lv_vtk(); lvr5.st ? lvr5.lv_vtk();
  // the effects in / out and their levels
  lv_dlg += (lv_dlin - lv_dlg) * lv_ek; lv_dlg < 0.00001 && !lv_dlin ? lv_dlg = 0;
  lv_mdg += (lv_mdin - lv_mdg) * lv_ek; lv_mdg < 0.00001 && !lv_mdin ? lv_mdg = 0;
  lv_rvg += (lv_rvin - lv_rvg) * lv_ek; lv_rvg < 0.00001 && !lv_rvin ? lv_rvg = 0;
  lv_dmn += (lv_dmix - lv_dmn) * lv_sk; lv_dfn += (lv_dfb - lv_dfn) * lv_sk; lv_dxn += (lv_dx - lv_dxn) * lv_sk;
  lv_mmn += (lv_mmix - lv_mmn) * lv_sk; lv_mwn += (lv_mwid - lv_mwn) * lv_sk; lv_mphn += (lv_mph - lv_mphn) * lv_sk;
  lv_rmn += (lv_rmix - lv_rmn) * lv_sk; lv_rshn += (lv_rsh - lv_rshn) * lv_sk;
  // MODULATION: the chorus taps (7 - 12 ms, the right side a quarter turn on), the phaser's sweep (300 Hz - 3 kHz)
  lv_mp += lv_mrate * (1 + 0.15 * ins_fx) * TK / srate; lv_mp -= floor(lv_mp);
  lv_mp2 += lv_mrate * 0.43 * TK / srate; lv_mp2 -= floor(lv_mp2);
  lv_t = 0.0025 * lv_mdep * srate;
  lv_cdl = 0.007 * srate + lv_t * (1 + sin(TWOPI * lv_mp)); lv_cdr = 0.007 * srate + lv_t * (1 + cos(TWOPI * lv_mp));
  lv_f = min(300 * 10 ^ (0.5 + 0.5 * sin(TWOPI * lv_mp2)), lv_fmax); lv_t = tan($pi * lv_f / srate); lv_pca = (lv_t - 1) / (lv_t + 1);
  lv_f = min(300 * 10 ^ (0.5 - 0.5 * sin(TWOPI * lv_mp2)), lv_fmax); lv_t = tan($pi * lv_f / srate); lv_pcb = (lv_t - 1) / (lv_t + 1);
  // SHIMMER: the lines' lengths glide, their gains follow the decay, two of them swim
  lv_n0 += (LVTMP[180] - lv_n0) * lv_sk * 0.1; lv_n1 += (LVTMP[181] - lv_n1) * lv_sk * 0.1; lv_n2 += (LVTMP[182] - lv_n2) * lv_sk * 0.1;
  lv_n3 += (LVTMP[183] - lv_n3) * lv_sk * 0.1; lv_n4 += (LVTMP[184] - lv_n4) * lv_sk * 0.1; lv_n5 += (LVTMP[185] - lv_n5) * lv_sk * 0.1;
  lv_n6 += (LVTMP[186] - lv_n6) * lv_sk * 0.1; lv_n7 += (LVTMP[187] - lv_n7) * lv_sk * 0.1;
  lv_t = -3 / (lv_rdec * srate);
  lv_rg0 = 10 ^ (lv_t * lv_n0); lv_rg1 = 10 ^ (lv_t * lv_n1); lv_rg2 = 10 ^ (lv_t * lv_n2); lv_rg3 = 10 ^ (lv_t * lv_n3);
  lv_rg4 = 10 ^ (lv_t * lv_n4); lv_rg5 = 10 ^ (lv_t * lv_n5); lv_rg6 = 10 ^ (lv_t * lv_n6); lv_rg7 = 10 ^ (lv_t * lv_n7);
  lv_i1 = floor(lv_n1); lv_i3 = floor(lv_n3); lv_i5 = floor(lv_n5); lv_i7 = floor(lv_n7);
  lv_rp1 += 0.21 * TK / srate; lv_rp1 -= floor(lv_rp1);
  lv_rm0 = 1 + 0.0008 * srate * (1 + sin(TWOPI * lv_rp1)); lv_rm1 = 1 + 0.0008 * srate * (1 + cos(TWOPI * lv_rp1));
);

// ---------- the clock: each side steps on its own grid ----------
lv_run ? (
  lv_bp += lv_dbp;
  lv_bp >= lv_tl ? lv_fire(0);
  lv_bp >= lv_tr ? lv_fire(1);
);

lv_dgd += lv_dgdi; lv_dmd += lv_dmdi;
// ---------- the pedal drone (centre): its voices, TONE (12 dB low-pass), DRIVE, LEVEL ----------
lv_dg > 0 ? (
  lv_y = (lv_xa > 0.00001 ? lvdA.lv_dosc() * lv_xa : 0) + (lv_xb > 0.00001 ? lvdB.lv_dosc() * lv_xb : 0);
  lv_v3 = lv_y - lv_s2; lv_v1 = lv_da1 * lv_s1 + lv_da2 * lv_v3; lv_v2 = lv_s2 + lv_da2 * lv_s1 + lv_da3 * lv_v3;
  lv_s1 = 2 * lv_v1 - lv_s1; lv_s2 = 2 * lv_v2 - lv_s2;
  lv_dr = lvkD.clp_run(lvfD.clp_pf_run(lv_v2 * 0.6) * lv_dgd) * lv_dmd * lv_dgn;
) : lv_dr = 0;

// ---------- the spirals: the left and the right voices, each side's level, its pan ----------
lv_yl = ((lvl0.st ? lvl0.lv_vrun() : 0) + (lvl1.st ? lvl1.lv_vrun() : 0) + (lvl2.st ? lvl2.lv_vrun() : 0) + (lvl3.st ? lvl3.lv_vrun() : 0) + (lvl4.st ? lvl4.lv_vrun() : 0) + (lvl5.st ? lvl5.lv_vrun() : 0)) * lv_gl;
lv_yr = ((lvr0.st ? lvr0.lv_vrun() : 0) + (lvr1.st ? lvr1.lv_vrun() : 0) + (lvr2.st ? lvr2.lv_vrun() : 0) + (lvr3.st ? lvr3.lv_vrun() : 0) + (lvr4.st ? lvr4.lv_vrun() : 0) + (lvr5.st ? lvr5.lv_vrun() : 0)) * lv_gr;
lv_xll = lv_yl * lv_all; lv_xlr = lv_yl * lv_alr; lv_xrl = lv_yr * lv_arl; lv_xrr = lv_yr * lv_arr;
lv_ol = lv_dr + lv_xll + lv_xrl; lv_or = lv_dr + lv_xlr + lv_xrr;
// (the scope: every second sample)
lv_scd = !lv_scd;
lv_sgx += (lv_dr - lv_sgx) * lv_sck; lv_sgl += (lv_yl - lv_sgl) * lv_sck; lv_sgr += (lv_yr - lv_sgr) * lv_sck;
lv_scd ? ( LVSX[lv_scw] = lv_sgx; LVSL[lv_scw] = lv_sgl; LVSR[lv_scw] = lv_sgr; lv_scw = (lv_scw + 1) & LVSM; );

// ---------- the CROSS-FEEDBACK DELAY: each side's echo feeds back into the other (CROSS) or itself ----------
lv_dlg > 0 ? (
  lv_drs == 1 ? ( lv_drf -= lv_drk; lv_drf <= 0 ? ( lv_drf = 0; lv_drs = 2; ); ) :
  lv_drs == 3 ? ( lv_drf += lv_drk; lv_drf >= 1 ? ( lv_drf = 1; lv_drs = 0; ); ) :
  lv_drq && lv_drs == 0 ? ( lv_drs = 1; lv_drq = 0; );
  lv_dts_l += (lv_dtt_l - lv_dts_l) * lv_dsk; lv_dts_r += (lv_dtt_r - lv_dts_r) * lv_dsk;
  lv_rp = lv_dw - lv_dts_l; lv_ri = floor(lv_rp); lv_rf = lv_rp - lv_ri;
  lv_a = LVDL[lv_ri & LVDM]; lv_el = lv_a + (LVDL[(lv_ri + 1) & LVDM] - lv_a) * lv_rf;
  lv_rp = lv_dw - lv_dts_r; lv_ri = floor(lv_rp); lv_rf = lv_rp - lv_ri;
  lv_a = LVDR[lv_ri & LVDM]; lv_er = lv_a + (LVDR[(lv_ri + 1) & LVDM] - lv_a) * lv_rf;
  lv_dfl += (lv_el - lv_dfl) * lv_dtc; lv_dfr += (lv_er - lv_dfr) * lv_dtc;
  lv_dhl += (lv_dfl - lv_dhl) * lv_dhk; lv_dhr += (lv_dfr - lv_dhr) * lv_dhk;
  lv_a = lv_dfl - lv_dhl; lv_b = lv_dfr - lv_dhr;
  lv_x = (lv_dr * lv_c1 + lv_xll * lv_e1 + lv_xrl * lv_h1) * lv_dlg + vo_tanh(lv_dfn * lv_drf * ((1 - lv_dxn) * lv_a + lv_dxn * lv_b) * 1.1) / 1.1;
  LVDL[lv_dw] = abs(lv_x) < 0.000000000001 ? 0 : lv_x;
  lv_x = (lv_dr * lv_c1 + lv_xlr * lv_e1 + lv_xrr * lv_h1) * lv_dlg + vo_tanh(lv_dfn * lv_drf * ((1 - lv_dxn) * lv_b + lv_dxn * lv_a) * 1.1) / 1.1;
  LVDR[lv_dw] = abs(lv_x) < 0.000000000001 ? 0 : lv_x;
  lv_dw = (lv_dw + 1) & LVDM;
  lv_t = lv_dmn * lv_dlg * lv_drf;
  lv_dol = (lv_dfl * 0.5 + lv_el * 0.5) * lv_t; lv_dor = (lv_dfr * 0.5 + lv_er * 0.5) * lv_t;
) : lv_dol = lv_dor = 0;

// ---------- MODULATION: an analogue-style chorus into a four-stage phaser, WIDTH on its return ----------
lv_mdg > 0 ? (
  LVCH[lv_cw] = (lv_dr * lv_c2 + lv_xll * lv_e2 + lv_xrl * lv_h2) * lv_mdg; LVCR[lv_cw] = (lv_dr * lv_c2 + lv_xlr * lv_e2 + lv_xrr * lv_h2) * lv_mdg;
  lv_rp = lv_cw - lv_cdl; lv_ri = floor(lv_rp); lv_rf = lv_rp - lv_ri;
  lv_a = LVCH[lv_ri & LVCM]; lv_ml = lv_a + (LVCH[(lv_ri + 1) & LVCM] - lv_a) * lv_rf;
  lv_rp = lv_cw - lv_cdr; lv_ri = floor(lv_rp); lv_rf = lv_rp - lv_ri;
  lv_a = LVCR[lv_ri & LVCM]; lv_mr = lv_a + (LVCR[(lv_ri + 1) & LVCM] - lv_a) * lv_rf;
  lv_cw = (lv_cw + 1) & LVCM;
  lv_x = lv_ml + lv_pfl * 0.45;
  lv_y = lv_pca * lv_x + lv_pa1; lv_pa1 = lv_x - lv_pca * lv_y; lv_x = lv_y;
  lv_y = lv_pca * lv_x + lv_pa2; lv_pa2 = lv_x - lv_pca * lv_y; lv_x = lv_y;
  lv_y = lv_pca * lv_x + lv_pa3; lv_pa3 = lv_x - lv_pca * lv_y; lv_x = lv_y;
  lv_y = lv_pca * lv_x + lv_pa4; lv_pa4 = lv_x - lv_pca * lv_y; lv_pfl = vo_tanh(lv_y);
  lv_ml += (lv_y - lv_ml) * lv_mphn * 0.5;
  lv_x = lv_mr + lv_pfr * 0.45;
  lv_y = lv_pcb * lv_x + lv_pb1; lv_pb1 = lv_x - lv_pcb * lv_y; lv_x = lv_y;
  lv_y = lv_pcb * lv_x + lv_pb2; lv_pb2 = lv_x - lv_pcb * lv_y; lv_x = lv_y;
  lv_y = lv_pcb * lv_x + lv_pb3; lv_pb3 = lv_x - lv_pcb * lv_y; lv_x = lv_y;
  lv_y = lv_pcb * lv_x + lv_pb4; lv_pb4 = lv_x - lv_pcb * lv_y; lv_pfr = vo_tanh(lv_y);
  lv_mr += (lv_y - lv_mr) * lv_mphn * 0.5;
  lv_a = (lv_ml + lv_mr) * 0.5; lv_b = (lv_ml - lv_mr) * 0.5 * lv_mwn;
  lv_t = lv_mmn * lv_mdg;
  lv_mol = (lv_a + lv_b) * lv_t; lv_mor = (lv_a - lv_b) * lv_t;
) : lv_mol = lv_mor = 0;

// ---------- SHIMMER REVERB: pre-delay, four diffusers, eight long lines (Hadamard); its own sound, an octave up
// (two crossfaded read heads), climbs back into it (SHIMMER); a lift on the top ----------
lv_x = ((lv_dr * lv_c3 + (lv_xll + lv_xlr) * lv_e3 + (lv_xrl + lv_xrr) * lv_h3) * 0.7 + (lv_dol + lv_dor + lv_mol + lv_mor) * 0.12) * lv_rvg + lv_shf;
lv_rh1 += (lv_x - lv_rh1) * lv_rhk; lv_x -= lv_rh1;
LVPD[lv_pw_] = lv_x; lv_x = LVPD[(lv_pw_ - lv_pdn) & LVPDM]; lv_pw_ = (lv_pw_ + 1) & LVPDM;
lv_rvg > 0 && (lv_rsil < srate || abs(lv_x) > 0.000001) ? (
  lv_x = lva0.lv_ap(LVAP, LVTMP[190], lv_x, 0.62); lv_x = lva1.lv_ap(LVAP + LVAPN, LVTMP[191], lv_x, 0.62);
  lv_x = lva2.lv_ap(LVAP + 2 * LVAPN, LVTMP[192], lv_x, 0.62); lv_x = lva3.lv_ap(LVAP + 3 * LVAPN, LVTMP[193], lv_x, 0.62);
  lv_y0 = lvq0.lv_rl(LVRV,            lv_n0, lv_rg0, lv_rm0);
  lv_y1 = lvq1.lv_rl(LVRV + LVRN,     lv_i1, lv_rg1, 0);
  lv_y2 = lvq2.lv_rl(LVRV + 2 * LVRN, lv_n2, lv_rg2, lv_rm1);
  lv_y3 = lvq3.lv_rl(LVRV + 3 * LVRN, lv_i3, lv_rg3, 0);
  lv_y4 = lvq4.lv_rl(LVRV + 4 * LVRN, lv_n4, lv_rg4, 1);
  lv_y5 = lvq5.lv_rl(LVRV + 5 * LVRN, lv_i5, lv_rg5, 0);
  lv_y6 = lvq6.lv_rl(LVRV + 6 * LVRN, lv_n6, lv_rg6, 1);
  lv_y7 = lvq7.lv_rl(LVRV + 7 * LVRN, lv_i7, lv_rg7, 0);
  lv_a0 = lv_y0 + lv_y1; lv_a1 = lv_y0 - lv_y1; lv_a2 = lv_y2 + lv_y3; lv_a3 = lv_y2 - lv_y3;
  lv_a4 = lv_y4 + lv_y5; lv_a5 = lv_y4 - lv_y5; lv_a6 = lv_y6 + lv_y7; lv_a7 = lv_y6 - lv_y7;
  lv_b0 = lv_a0 + lv_a2; lv_b2 = lv_a0 - lv_a2; lv_b1 = lv_a1 + lv_a3; lv_b3 = lv_a1 - lv_a3;
  lv_b4 = lv_a4 + lv_a6; lv_b6 = lv_a4 - lv_a6; lv_b5 = lv_a5 + lv_a7; lv_b7 = lv_a5 - lv_a7;
  lv_ri = lv_rw & LVRM; lv_x *= 0.6;
  LVRV[lv_ri]            = (lv_b0 + lv_b4) * 0.35355339 + lv_x;
  LVRV[LVRN + lv_ri]     = (lv_b1 + lv_b5) * 0.35355339 - lv_x;
  LVRV[2 * LVRN + lv_ri] = (lv_b2 + lv_b6) * 0.35355339 + lv_x;
  LVRV[3 * LVRN + lv_ri] = (lv_b3 + lv_b7) * 0.35355339 - lv_x;
  LVRV[4 * LVRN + lv_ri] = (lv_b0 - lv_b4) * 0.35355339 + lv_x;
  LVRV[5 * LVRN + lv_ri] = (lv_b1 - lv_b5) * 0.35355339 - lv_x;
  LVRV[6 * LVRN + lv_ri] = (lv_b2 - lv_b6) * 0.35355339 + lv_x;
  LVRV[7 * LVRN + lv_ri] = (lv_b3 - lv_b7) * 0.35355339 - lv_x;
  lv_wl = (lv_y0 - lv_y2 + lv_y4 - lv_y6) * 0.5; lv_wr = (lv_y1 - lv_y3 + lv_y5 - lv_y7) * 0.5;
  // the octave up: two read heads sweep the window at twice the speed, crossfaded (Hann)
  LVPS[lv_psp] = (lv_wl + lv_wr) * 0.5;
  lv_t = lv_psw * (1 - lv_pph); lv_rp = lv_psp - lv_t - 2; lv_ri = floor(lv_rp); lv_rf = lv_rp - lv_ri;
  lv_a = LVPS[lv_ri & LVPSM]; lv_u1 = lv_a + (LVPS[(lv_ri + 1) & LVPSM] - lv_a) * lv_rf;
  lv_t = lv_pph + 0.5; lv_t -= floor(lv_t); lv_t = lv_psw * (1 - lv_t); lv_rp = lv_psp - lv_t - 2; lv_ri = floor(lv_rp); lv_rf = lv_rp - lv_ri;
  lv_a = LVPS[lv_ri & LVPSM]; lv_u2 = lv_a + (LVPS[(lv_ri + 1) & LVPSM] - lv_a) * lv_rf;
  lv_t = sin($pi * lv_pph); lv_t *= lv_t;
  lv_u = lv_u1 * lv_t + lv_u2 * (1 - lv_t);
  lv_pph += 1 / lv_psw; lv_pph -= floor(lv_pph); lv_psp = (lv_psp + 1) & LVPSM;
  lv_sl += (lv_u - lv_sl) * lv_slk; lv_sh += (lv_sl - lv_sh) * lv_shk; lv_u = lv_sl - lv_sh;
  lv_shf = vo_tanh(lv_u * lv_rshn * 1.6) * 0.5 * lv_rvg;
  abs(lv_x) + abs(lv_wl) + abs(lv_wr) < 0.000001 ? lv_rsil += 1 : lv_rsil = 0;
  lv_t = lv_rmn * lv_rvg; lv_u *= lv_rshn * 0.5;
  lv_wl += lv_u; lv_wr += lv_u;
  lv_hl += (lv_wl - lv_hl) * lv_hlk; lv_hr += (lv_wr - lv_hr) * lv_hlk;
  lv_rol = (lv_wl + (lv_wl - lv_hl) * 0.4) * lv_t; lv_ror = (lv_wr + (lv_wr - lv_hr) * 0.4) * lv_t;
) : ( lv_rol = lv_ror = 0; lv_shf = 0; );
lv_rw = (lv_rw + 1) & LVRM;

lv_ol += lv_dol + lv_mol + lv_rol; lv_or += lv_dor + lv_mor + lv_ror;

// DC block
lv_dcyl = lv_ol - lv_dcxl + 0.9997 * lv_dcyl; lv_dcxl = lv_ol; lv_ol = lv_dcyl;
lv_dcyr = lv_or - lv_dcxr + 0.9997 * lv_dcyr; lv_dcxr = lv_or; lv_or = lv_dcyr;

// ---------- MASTER ----------
lv_pcf == 1 ? ( lv_pcg -= lv_pcdn; lv_pcg <= 0 ? ( lv_pcg = 0; lv_pcf = 2; ); ) :
lv_pcf == 3 ? ( lv_pcg += lv_pcup; lv_pcg >= 1 ? ( lv_pcg = 1; lv_pcf = 0; ); );
lv_vol += (lv_volt - lv_vol) * lv_sm;
lv_ol *= lv_pcg * lv_vol; lv_or *= lv_pcg * lv_vol;
lv_ol = ostL.ost_band(lv_ol); lv_or = ostR.ost_band(lv_or);
ost_out(lv_ol, lv_or);
spl0 = ost_l; spl1 = ost_r;
lv_pk = max(lv_pk * lv_pkd, max(abs(spl0), abs(spl1)));

@gfx 1200 850
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 5; ui_hw = 1; lg_fdk = 0;
ui_begin(1200, 850);

// ---------- the card's colours: a split faceplate - brushed ROSE GOLD (left) and deep CHARCOAL (right), joined by a
// razor-thin hazard-orange line; a dual-colour phosphor display (the left spiral rose, the right cyan, the drone gold) ----------
ROSE = 0xC99B8C; ROSEB = 0xD6AC9E; ROSEK = 0xBA8A7B; ROSET = 0xBE8F80; ROSEH = 0xA9786A; RINK = 0x2A1C19; RLBL = 0x2E1F1C; RDIM = 0x5E4038;
CHAR = 0x2B2D31; CHARB = 0x33363B; CHART = 0x222428; CHARH = 0x191A1D; CLBL = 0xEADCD5; CDIM = 0xA3A6AD;
INK = 0x0B0B0D; HAZ = 0xFF6A13;
PHL = 0xFF9A7A; PHLD = 0x6E3328; PHR = 0x5FE2D4; PHRD = 0x1C5A55; PHD = 0xF4E3BC; SCR = 0x0A0B0F; SCRH = 0x161922; GRID = 0x1E222C;
MRG = 0xDDB09F; MRGD = 0x9C6E60; MRGE = 0x6B463C;      // rose-gold metal (the outer rings, the rose-side knobs)
MSV = 0xB9BEC6; MSVD = 0x7D838C; MSVE = 0x4A4F57;      // silver (the inner caps, the charcoal-side knobs)
KEYOFFR = 0xAE7E70; KEYOFFC = 0x3A3D43; KEYON = 0xFF6A13;

// fonts, calibrated once per scale (a reference word fills the same width everywhere); large, for reading
sc != lg_calsc ? (
  lg_calsc = sc;
  lg_f11 = ui_fitfont(11, 13 * sc);         // key captions, small print
  lg_f12 = ui_fitfont(12, 15.5 * sc);       // section titles
  lg_f13 = ui_fitfont(13, 14.5 * sc);       // knob labels, values, fields
);
gfx_setfont(11, "Trebuchet MS", lg_f11, 'b'); gfx_setfont(12, "Trebuchet MS", lg_f12, 'b');
gfx_setfont(13, "Trebuchet MS", lg_f13, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');    // the card's name
gfx_setfont(15, "Georgia", 19 * sc, 'b');    // the numeral

// ---------- drawing helpers (base coordinates) ----------
function lg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function lg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function lg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function lg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function lg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function lg_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function lg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function lg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function lg_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function lg_ln(x1, y1, x2, y2, w) ( lg_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function lg_l1(x1, y1, x2, y2) ( gfx_line(x1 * sc, y1 * sc, x2 * sc, y2 * sc, 1); );
function lg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function lg_ring(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); );
function lg_disc(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
function lg_dk(x) ( lg_fdk || x >= 600; );         // (lg_fdk: a section that straddles the line is all charcoal)                              // which half: the charcoal (1) or the rose gold (0)
function lg_lbl(x) ( lg_dk(x) ? CLBL : RLBL; );
function lg_dim(x) ( lg_dk(x) ? CDIM : RDIM; );
// a section: an ink frame, its tray (rose or charcoal; split down the centre line if it straddles), a title band
function lg_sect(x, y, w, h, title) local(m) (
  ui_col(INK); lg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  // (a section that straddles the line sits on one solid charcoal tray: its labels never cross two grounds)
  x + w <= 600 && !lg_fdk ? ( ui_col(ROSET); lg_r(x, y, w, h); ui_col(ROSEH); lg_r(x, y, w, 24); ) :
                            ( ui_col(CHART); lg_r(x, y, w, h); ui_col(CHARH); lg_r(x, y, w, 24); );
  ui_cola(INK, 0.6); lg_r(x, y + 24, w, 1);
  ui_col(HAZ); lg_r(x + 8, y + 8, 2, 9);
  m = x + w <= 600 ? 0 : 1;
  strlen(title) ? ( gfx_setfont(12); ui_col(x + w <= 600 && !lg_fdk ? RLBL : CLBL); lg_t(x + 16, y + 3, title); );
);
function lg_cap(x, y, s) ( gfx_setfont(11); ui_col(lg_dim(x)); lg_t(x, y, s); );
// the value pill (shown only while a control is touched)
function lg_pill(cx, y, s, col) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 4 * sc, 3 * sc);
  ui_col(col); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc + 1 * sc, tw + 12 * sc, th + 2 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);

// ---------- the knobs: flat metal (rose gold on the rose half, silver on the charcoal), a strong dark pointer, the value
// arc round them. cap 1 = the black cap (a low-pass / tone: the house colour code) ----------
function lg_kcap(cx, cy, r, n, bip, cap, dk) local(rr, a, a0, ca, sa, w, i, b, mc, md, me, ac) (
  rr = r + 5 * sc; w = 2.6 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  mc = dk ? MSV : MRG; md = dk ? MSVD : MRGD; me = dk ? MSVE : MRGE; ac = dk ? PHL : 0x6A2420;
  ui_cola(dk ? 0x000000 : RINK, 0.35); lg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  ui_col(ac);
  bip ? ( abs(n - 0.5) > 0.004 ? lg_arcw(cx, cy, rr, min(a, 0), max(a, 0), w); ) :
        ( n > 0.004 ? ( lg_arcw(cx, cy, rr, a0, a, w); gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); ); );
  ui_cola(0x000000, 0.35); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(me); gfx_circle(cx, cy, r, 1, 1);
  ui_col(md); gfx_circle(cx, cy, r - 1.2 * sc, 1, 1);
  // the skirt's grip flutes (they turn with the knob)
  ui_col(me); i = 0;
  loop(12, b = a + (i + 0.5) / 12 * 2 * $pi;
    gfx_circle(cx + sin(b) * (r - 1.2 * sc), cy - cos(b) * (r - 1.2 * sc), max(1.1 * sc, r * 0.07), 1, 1); i += 1; );
  ui_col(me); gfx_circle(cx, cy, r * 0.76, 1, 1);
  ui_col(cap == 1 ? 0x101113 : mc); gfx_circle(cx, cy, r * 0.73, 1, 1);
  ui_col(cap == 1 ? HAZ : INK); gfx_circle(cx + ca * (r * 0.73) * 0.62, cy + sa * (r * 0.73) * 0.62, (r * 0.73) * 0.19, 1, 1);   // dot pointer (JG, 31 Oct 2026)
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps
function lg_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp, cap) local(v, n, dx, dy, hov, did, dk) (
  did = 2000 + idx; v = slider(idx); dk = lg_dk(cx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - lg_lt < 0.35 && lg_lid == idx && !lg_mv) || (mouse_cap & 4) ? ( lg_set(idx, def); drag_id = -1; lg_lt = 0; ) : (
      drag_id = did; lg_ky = mouse_y; lg_ky0 = mouse_y; lg_mv = 0; lg_lt = time_precise(); lg_lid = idx;
      lg_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !lg_mv && abs(mouse_y - lg_ky0) > 3 * sc ? ( lg_mv = 1; lg_ky = mouse_y; );
  drag_id == did && lg_mv ? (
    lg_kn = min(max(lg_kn + (lg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); lg_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ lg_kn : lo + lg_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? lg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    lg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  lg_kcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), lo < 0 && hi > 0, cap, dk);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, r * 0.73 * sc, 1, 1);
    sprintf(#lg_vv, fmt, v);
    lg_pill(cx, cy + r + 6, #lg_vv, HAZ);
  ) : (
    strlen(label) ? ( gfx_setfont(strlen(label) > 7 ? 11 : 13); ui_col(lg_lbl(cx)); lg_tc(cx, cy + r + 14, label); );
  );
);

// ---------- the TWIN GENERATORS' dual-concentric knobs: the OUTER RING (rose gold) sets the LEFT spiral - drag its
// rim; the INNER CAP (silver) sets the RIGHT spiral - drag the centre. Each part has its own hover value, wheel,
// SHIFT-fine and double-click default. The left's value arc runs outside the ring (rose), the right's in the groove
// (cyan) ----------
function lg_cpart(cx, cy, idx, lo, hi, def, stp, zone, did) local(v, n) (
  v = slider(idx);
  pressed && zone && drag_id == 0 ? (
    (time_precise() - lg_lt < 0.35 && lg_lid == idx && !lg_mv) || (mouse_cap & 4) ? ( lg_set(idx, def); drag_id = -1; lg_lt = 0; ) : (
      drag_id = did; lg_ky = mouse_y; lg_ky0 = mouse_y; lg_mv = 0; lg_lt = time_precise(); lg_lid = idx;
      lg_kn = (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !lg_mv && abs(mouse_y - lg_ky0) > 3 * sc ? ( lg_mv = 1; lg_ky = mouse_y; );
  drag_id == did && lg_mv ? (
    lg_kn = min(max(lg_kn + (lg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); lg_ky = mouse_y;
    v = lo + lg_kn * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? lg_set(idx, v);
  );
  zone && mouse_wheel != 0 && drag_id == 0 ? (
    n = (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lo + n * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    lg_set(idx, v); mouse_wheel = 0;
  );
  min(max((slider(idx) - lo) / (hi - lo), 0), 1);
);
function lg_cknob(cx, cy, iL, iR, lo, hi, dL, dR, stp, label, fmt, cap) local(ro, ri, kx, ky, d, zo, zi, nL, nR, a0, a, ca, sa, i, b, w, hv) (
  ro = 30 * sc; ri = 16.5 * sc; kx = cx * sc; ky = cy * sc; w = 2.8 * sc; a0 = -0.75 * $pi;
  d = sqrt(sqr(mouse_x - kx) + sqr(mouse_y - ky));
  zi = d <= ri + 2 * sc; zo = !zi && d <= ro + 7 * sc;
  nL = lg_cpart(cx, cy, iL, lo, hi, dL, stp, zo, 3000 + iL);
  nR = lg_cpart(cx, cy, iR, lo, hi, dR, stp, zi, 3000 + iR);
  // the left's arc (outside), its track
  ui_cola(0x000000, 0.45); lg_arcw(kx, ky, ro + 5 * sc, a0, 0.75 * $pi, 1.4 * sc);
  a = a0 + nL * 1.5 * $pi;
  nL > 0.004 ? ( ui_col(PHL); lg_arcw(kx, ky, ro + 5 * sc, a0, a, w); gfx_circle(kx + sin(a0) * (ro + 5 * sc), ky - cos(a0) * (ro + 5 * sc), w * 0.5, 1, 1); );
  // the outer ring: rose-gold metal, fluted, its pointer
  ui_cola(0x000000, 0.4); gfx_circle(kx + 1.5 * sc, ky + 2.5 * sc, ro, 1, 1);
  ui_col(MRGE); gfx_circle(kx, ky, ro, 1, 1);
  ui_col(MRG); gfx_circle(kx, ky, ro - 1.3 * sc, 1, 1);
  ui_col(MRGD); i = 0;
  loop(16, b = a + (i + 0.5) / 16 * 2 * $pi; gfx_circle(kx + sin(b) * (ro - 1.3 * sc), ky - cos(b) * (ro - 1.3 * sc), 1.5 * sc, 1, 1); i += 1; );
  ca = sin(a); sa = -cos(a);
  ui_col(RINK); gfx_circle(kx + ca * (ri + ro + 3 * sc) * 0.5, ky + sa * (ri + ro + 3 * sc) * 0.5, 2.2 * sc, 1, 1);   // dot pointers (JG, 31 Oct 2026)
  // the groove, the right's arc in it
  ui_col(0x141518); gfx_circle(kx, ky, ri + 4 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.08); lg_arcw(kx, ky, ri + 2.2 * sc, a0, 0.75 * $pi, 1 * sc);
  a = a0 + nR * 1.5 * $pi;
  nR > 0.004 ? ( ui_col(PHR); lg_arcw(kx, ky, ri + 2.2 * sc, a0, a, 2 * sc); );
  // the inner cap: silver (black for TONE), its pointer
  ui_col(MSVE); gfx_circle(kx, ky, ri, 1, 1);
  ui_col(cap ? 0x101113 : MSV); gfx_circle(kx, ky, ri - 1.2 * sc, 1, 1);
  ca = sin(a); sa = -cos(a);
  ui_col(cap ? PHR : INK); gfx_circle(kx + ca * ri * 0.6, ky + sa * ri * 0.6, max(ri * 0.19, 2 * sc), 1, 1);
  // hover: the part under the mouse lights, its value in its colour
  hv = drag_id == 3000 + iL ? 1 : drag_id == 3000 + iR ? 2 : drag_id == 0 ? (zo ? 1 : zi ? 2 : 0) : 0;
  hv == 1 ? (
    ui_cola(PHL, 0.6); lg_arcw(kx, ky, ro + 0.5 * sc, 0, 2 * $pi, 1.5 * sc);
    strcpy(#lg_vv, "LEFT "); sprintf(#lg_v2, fmt, slider(iL)); strcat(#lg_vv, #lg_v2); lg_pill(cx, cy + 36, #lg_vv, PHL);
  ) : hv == 2 ? (
    ui_cola(PHR, 0.7); lg_arcw(kx, ky, ri + 0.3 * sc, 0, 2 * $pi, 1.5 * sc);
    strcpy(#lg_vv, "RIGHT "); sprintf(#lg_v2, fmt, slider(iR)); strcat(#lg_vv, #lg_v2); lg_pill(cx, cy + 36, #lg_vv, PHR);
  ) : (
    gfx_setfont(13); ui_col(CLBL); lg_tc(cx, cy + 46, label);
  );
);

// ---------- lit keys (hazard orange = on); returns 1 when clicked ----------
function lg_key(x, y, w, h, on, s) local(hov, hit, dk) (
  hov = lg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1; dk = lg_dk(x + w * 0.5);
  on ? ( ui_cola(HAZ, 0.3); lg_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.3); lg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); lg_rr(x, y, w, h, 3);
  ui_col(on ? KEYON : dk ? (hov ? 0x484B52 : KEYOFFC) : (hov ? 0xC08F81 : KEYOFFR)); lg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.4); lg_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.1); lg_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? INK : dk ? CLBL : RINK); lg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function lg_toggle(x, y, w, h, idx, s) ( lg_key(x, y, w, h, slider(idx) >= 0.5, s) ? lg_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
function lg_scmenu(cur) (
  strcpy(#lg_m, "");
  strcat(#lg_m, ">Church modes|");
  strcat(#lg_m, cur == 0 ? "!Ionian|" : "Ionian|");
  strcat(#lg_m, cur == 1 ? "!Dorian|" : "Dorian|");
  strcat(#lg_m, cur == 2 ? "!Phrygian|" : "Phrygian|");
  strcat(#lg_m, cur == 3 ? "!Lydian|" : "Lydian|");
  strcat(#lg_m, cur == 4 ? "!Mixolydian|" : "Mixolydian|");
  strcat(#lg_m, cur == 5 ? "!Aeolian|" : "Aeolian|");
  strcat(#lg_m, cur == 6 ? "<!Locrian|" : "<Locrian|");
  strcat(#lg_m, ">Minor and major colours|");
  strcat(#lg_m, cur == 7 ? "!Harmonic minor|" : "Harmonic minor|");
  strcat(#lg_m, cur == 8 ? "!Melodic minor|" : "Melodic minor|");
  strcat(#lg_m, cur == 9 ? "!Harmonic major|" : "Harmonic major|");
  strcat(#lg_m, cur == 10 ? "!Phrygian dominant|" : "Phrygian dominant|");
  strcat(#lg_m, cur == 11 ? "!Lydian dominant|" : "Lydian dominant|");
  strcat(#lg_m, cur == 12 ? "!Altered|" : "Altered|");
  strcat(#lg_m, cur == 13 ? "!Lydian augmented|" : "Lydian augmented|");
  strcat(#lg_m, cur == 14 ? "!Ukrainian Dorian|" : "Ukrainian Dorian|");
  strcat(#lg_m, cur == 15 ? "!Neapolitan major|" : "Neapolitan major|");
  strcat(#lg_m, cur == 16 ? "!Neapolitan minor|" : "Neapolitan minor|");
  strcat(#lg_m, cur == 17 ? "!Hungarian minor|" : "Hungarian minor|");
  strcat(#lg_m, cur == 18 ? "!Hungarian major|" : "Hungarian major|");
  strcat(#lg_m, cur == 19 ? "!Double harmonic|" : "Double harmonic|");
  strcat(#lg_m, cur == 20 ? "!Persian|" : "Persian|");
  strcat(#lg_m, cur == 21 ? "!Enigmatic|" : "Enigmatic|");
  strcat(#lg_m, cur == 22 ? "<!Spanish eight-tone|" : "<Spanish eight-tone|");
  strcat(#lg_m, ">Symmetric|");
  strcat(#lg_m, cur == 23 ? "!Whole tone|" : "Whole tone|");
  strcat(#lg_m, cur == 24 ? "!Diminished (whole-half)|" : "Diminished (whole-half)|");
  strcat(#lg_m, cur == 25 ? "!Diminished (half-whole)|" : "Diminished (half-whole)|");
  strcat(#lg_m, cur == 26 ? "!Augmented|" : "Augmented|");
  strcat(#lg_m, cur == 27 ? "!Prometheus|" : "Prometheus|");
  strcat(#lg_m, cur == 28 ? "<!Tritone|" : "<Tritone|");
  strcat(#lg_m, ">Pentatonic and blues|");
  strcat(#lg_m, cur == 29 ? "!Major pentatonic|" : "Major pentatonic|");
  strcat(#lg_m, cur == 30 ? "!Minor pentatonic|" : "Minor pentatonic|");
  strcat(#lg_m, cur == 31 ? "!Blues|" : "Blues|");
  strcat(#lg_m, cur == 32 ? "<!Major blues|" : "<Major blues|");
  strcat(#lg_m, ">Indian ragas|");
  strcat(#lg_m, cur == 33 ? "!Bhairav|" : "Bhairav|");
  strcat(#lg_m, cur == 34 ? "!Todi|" : "Todi|");
  strcat(#lg_m, cur == 35 ? "!Marwa|" : "Marwa|");
  strcat(#lg_m, cur == 36 ? "!Kafi|" : "Kafi|");
  strcat(#lg_m, cur == 37 ? "!Purvi|" : "Purvi|");
  strcat(#lg_m, cur == 38 ? "<!Charukesi|" : "<Charukesi|");
  strcat(#lg_m, ">Japanese|");
  strcat(#lg_m, cur == 39 ? "!Hirajoshi|" : "Hirajoshi|");
  strcat(#lg_m, cur == 40 ? "!In Sen|" : "In Sen|");
  strcat(#lg_m, cur == 41 ? "!Iwato|" : "Iwato|");
  strcat(#lg_m, cur == 42 ? "!Kumoi|" : "Kumoi|");
  strcat(#lg_m, cur == 43 ? "!Yo|" : "Yo|");
  strcat(#lg_m, cur == 44 ? "<!Ryukyu|" : "<Ryukyu|");
  strcat(#lg_m, ">Indonesian|");
  strcat(#lg_m, cur == 45 ? "!Pelog|" : "Pelog|");
  strcat(#lg_m, cur == 46 ? "<!Slendro|" : "<Slendro|");
  strcat(#lg_m, ">Ethiopian|");
  strcat(#lg_m, cur == 47 ? "!Tezeta major|" : "Tezeta major|");
  strcat(#lg_m, cur == 48 ? "!Tezeta minor|" : "Tezeta minor|");
  strcat(#lg_m, cur == 49 ? "!Bati major|" : "Bati major|");
  strcat(#lg_m, cur == 50 ? "!Bati minor|" : "Bati minor|");
  strcat(#lg_m, cur == 51 ? "!Ambassel|" : "Ambassel|");
  strcat(#lg_m, cur == 52 ? "<!Anchihoye|" : "<Anchihoye|");
  strcat(#lg_m, cur == 53 ? "!Custom (the twelve keys)" : "Custom (the twelve keys)");
  #lg_m;
);
// ---------- the drop-down box: the setting in the half's colour; a click opens the list (the current one ticked), the
// wheel steps ----------
function lg_dd(x, y, w, h, idx, lo, n, list, s) local(hov, i, k, dk) (
  hov = lg_hov(x, y, w, h); dk = lg_dk(x + w * 0.5);
  ui_cola(0x000000, 0.3); lg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); lg_rr(x, y, w, h, 3);
  ui_col(hov ? SCRH : SCR); lg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(13); ui_col(dk ? PHR : PHL); lg_tc(x + (w - 12) * 0.5, y + h * 0.5, s);
  ui_col(HAZ); gfx_triangle((x + w - 15) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 7) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 11) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    idx == 5 ? strcpy(#lg_m, lg_scmenu(floor(slider(5) + 0.5))) : (
      strcpy(#lg_m, ""); i = 0; k = floor(slider(idx) + 0.5) - lo;
      loop(n, i == k ? strcat(#lg_m, "!"); strcat(#lg_m, pk_pitem(list, i + 1, #lg_k)); i < n - 1 ? strcat(#lg_m, "|"); i += 1; );
    );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#lg_m); i > 0 ? lg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    lg_set(idx, min(max(floor(slider(idx) + 0.5) - sign(mouse_wheel), lo), lo + n - 1)); mouse_wheel = 0;
  );
);
function lg_nname(n) ( sprintf(#lg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #lg_k), floor(n / 12) - 1); #lg_nn; );
LG_SCN = "Ionian|Dorian|Phrygian|Lydian|Mixolydian|Aeolian|Locrian|Harmonic minor|Melodic minor|Harmonic major|Phrygian dominant|Lydian dominant|Altered|Lydian augmented|Ukrainian Dorian|Neapolitan major|Neapolitan minor|Hungarian minor|Hungarian major|Double harmonic|Persian|Enigmatic|Spanish eight-tone|Whole tone|Diminished (whole-half)|Diminished (half-whole)|Augmented|Prometheus|Tritone|Major pentatonic|Minor pentatonic|Blues|Major blues|Bhairav|Todi|Marwa|Kafi|Purvi|Charukesi|Hirajoshi|In Sen|Iwato|Kumoi|Yo|Ryukyu|Pelog|Slendro|Tezeta major|Tezeta minor|Bati major|Bati minor|Ambassel|Anchihoye|Custom";
LG_RATES = "1/4|1/8 dotted|1/8|1/8 triplet|1/16 dotted|1/16|1/16 triplet|1/32"; LG_PATS = "Up|Down|Up-down|Thirds|Broken chord|Scale run|Pendulum|Seeded walk"; LG_VOX = "Bell|Pluck|Mallet|Pad"; LG_DDIV = "1/16|1/8 triplet|1/8|1/4 triplet|1/8 dotted|1/4|1/4 dotted|1/2|1/2 dotted|1 bar";
LG_CEV = "|NOTES EXCHANGED|PANS TRADED|OCTAVES TRADED|MIRRORED|THE MEETING";

// ---------- a spiral's section: VOICE, PATTERN, RATE; its phrase as a lane of steps; its tier and generation ----------
function lg_side(x, s) local(y, b, q, nst, j, lo, hi, i, n, h, bx, bw, col, cold, mg, cur, cx, tt, dk, lbl, dim) (
  y = 68; b = 34 + s * 12; q = LVS + s * 32; dk = s; lbl = s ? CLBL : RLBL; dim = s ? CDIM : RDIM;
  lg_sect(x, y, 370, 262, s ? "RIGHT SPIRAL  ·  HARD RIGHT" : "LEFT SPIRAL  ·  HARD LEFT");
  col = s ? PHR : PHL; cold = s ? PHRD : PHLD;
  lg_cap(x + 12, y + 32, "VOICE"); lg_cap(x + 120, y + 32, "PATTERN"); lg_cap(x + 260, y + 32, "RATE");
  lg_dd(x + 12, y + 48, 100, 26, b + 6, 0, 4, LG_VOX, pk_pitem("BELL|PLUCK|MALLET|PAD", floor(slider(b + 6) + 0.5) + 1, #lg_k2));
  lg_dd(x + 120, y + 48, 132, 26, b + 2, 0, 8, LG_PATS, pk_pitem("UP|DOWN|UP-DOWN|THIRDS|BROKEN CHORD|SCALE RUN|PENDULUM|SEEDED WALK", floor(slider(b + 2) + 0.5) + 1, #lg_k2));
  lg_dd(x + 260, y + 48, 98, 26, b + 1, 0, 8, LG_RATES, pk_pitem("1/4|1/8 D|1/8|1/8 T|1/16 D|1/16|1/16 T|1/32", floor(slider(b + 1) + 0.5) + 1, #lg_k2));
  // the phrase: each step a bar as high as its note (over the two sides' range); a migrated note in the other side's
  // colour, a mirrored / unison one ringed in orange; the step playing lit
  bx = x + 12; bw = 346;
  ui_col(INK); lg_rr(bx, y + 84, bw, 132, 4); ui_col(SCR); lg_rr(bx + 1.5, y + 85.5, bw - 3, 129, 3);
  lo = 200; hi = 0; i = 0;
  loop(2, j = 0; loop(LVS[i * 32], n = LVPH[i * 16 + j]; n > 0 ? ( lo = min(lo, n); hi = max(hi, n); ); j += 1; ); i += 1; );
  hi < lo ? ( lo = 48; hi = 72; ); hi - lo < 12 ? ( hi = lo + 12; );
  nst = q[0]; cur = slider1 >= 0.5 ? q[22] : -1;
  ui_col(GRID); i = 0; loop(5, lg_r(bx + 6, y + 96 + i * 26, bw - 12, 1); i += 1; );
  j = 0;
  loop(nst,
    n = LVPH[s * 16 + j]; mg = LVPM[s * 16 + j];
    cx = bx + 8 + (j + 0.5) * (bw - 16) / nst; tt = max(min((bw - 16) / nst * 0.55, 14), 4);
    n > 0 ? (
      h = 10 + 96 * (n - lo) / (hi - lo);
      ui_col(mg == 1 ? (s ? PHLD : PHRD) : cold); lg_r(cx - tt * 0.5, y + 202 - h, tt, h);
      ui_col(mg == 1 ? (s ? PHL : PHR) : col); lg_r(cx - tt * 0.5, y + 202 - h, tt, 3);
      mg >= 3 ? ( ui_col(HAZ); lg_r(cx - tt * 0.5 - 2, y + 199 - h, tt + 4, 1.5); );
      j == cur ? ( ui_cola(mg == 1 ? (s ? PHL : PHR) : col, 0.85); lg_r(cx - tt * 0.5, y + 202 - h, tt, h); );
    );
    j += 1;
  );
  // tier, generation, the note now
  ui_col(lbl); gfx_setfont(11);
  lg_t(x + 14, y + 226, "TIER"); i = 0;
  loop(lv_tiers, ui_col(i == q[20] ? HAZ : (s ? 0x4A4D54 : ROSEH)); lg_r(x + 50 + i * 13, y + 229, 10, 10); i += 1; );
  sprintf(#lg_g, "GEN %d", max(q[21], 0)); ui_col(lbl); lg_t(x + 160, y + 226, #lg_g);
  sprintf(#lg_g, "STEP %d / %d", (q[22] % max(nst, 1)) + 1, nst); lg_t(x + 222, y + 226, #lg_g);
  gfx_setfont(13); ui_col(s ? PHR : 0x6E241D);
  lg_tr(x + 358, y + 233, q[23] > 0 ? lg_nname(q[23]) : "-");
);

// ======================== the faceplate: the two halves ========================
ui_col(CHAR); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); lg_rr(4, 4, 1192, 842, 9);
ui_col(0x55433E); lg_rr(6.5, 6.5, 1187, 837, 7);
ui_col(INK); lg_r(11, 11, 1178, 828);
ui_col(ROSE); lg_r(13, 13, 587, 824);
ui_col(CHAR); lg_r(600, 13, 587, 824);
// the brushing: sparse fine lines, lighter and darker, across each half
lg_i = 0; loop(118, lg_y = 15 + lg_i * 7;
  ui_cola(lg_i % 3 == 0 ? ROSEB : ROSEK, 0.55); lg_l1(15 + (lg_i * 37) % 23, lg_y, 598 - (lg_i * 53) % 31, lg_y);
  ui_cola(lg_i % 3 == 0 ? CHARB : 0x25272B, 0.7); lg_l1(602 + (lg_i * 41) % 29, lg_y, 1185 - (lg_i * 29) % 19, lg_y);
  lg_i += 1; );
// the header
ui_col(ROSEH); lg_r(13, 13, 587, 44); ui_col(CHARH); lg_r(600, 13, 587, 44);
ui_col(INK); lg_r(13, 57, 1174, 1.5);
// decorative etching: two interlocking orbits round the numeral, fine arcs at the card's edges
ui_cola(RINK, 0.35); lg_i = 0; loop(3, gfx_arc(600 * sc, 35 * sc, (30 + lg_i * 4) * sc, -0.98 * $pi, -0.02 * $pi, 1); lg_i += 1; );
ui_cola(PHR, 0.3); lg_i = 0; loop(3, gfx_arc(600 * sc, 35 * sc, (30 + lg_i * 4) * sc, 0.02 * $pi, 0.98 * $pi, 1); lg_i += 1; );
// the numeral on its seal (a rose-gold ring and a silver ring, interlaced)
ui_col(INK); lg_disc(600, 35, 21);
ui_col(MRG); lg_ring(596, 35, 17); lg_ring(596, 35, 16.5); ui_col(MSV); lg_ring(604, 35, 17); lg_ring(604, 35, 16.5);
gfx_setfont(15); ui_col(HAZ); lg_tc(600, 35.5, "VI");
// the centre line: razor-thin hazard orange, top to bottom
ui_col(HAZ); lg_r(599.5, 58.5, 1, 708);
// presets
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
lg_k_ = pk_preset(22 * sc, 18 * sc, 330 * sc, 34 * sc, pr_cur, #lv_pm);
lg_k_ > 0 ? ( lg_k_ > lv_npre ? reset_all() : prs_dirty = lg_k_; );
gfx_setfont(12); ui_col(RLBL); lg_t(366, 18, "PEDAL DRONE"); lg_t(366, 35, "TWO SPIRALS · LCR");
// MIDI, TRANSPORT, RUN, the state of things
pk_led(652 * sc, 35 * sc, 4.5 * sc, ins_midi_lit(), HAZ);
gfx_setfont(11); ui_col(CLBL); lg_tc(652, 21, "MIDI");
sprintf(#lg_g, slider23 < 0.5 ? "OMNI" : "CH %.0f", slider23);
lg_dd(666, 22, 82, 26, 23, 0, 17, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", #lg_g);
lg_toggle(756, 23, 92, 24, 2, "TRANSPORT");
lg_toggle(854, 23, 56, 24, 1, "RUN");
ui_col(INK); lg_rr(918, 22, 194, 26, 3); ui_col(SCR); lg_rr(919.5, 23.5, 191, 23, 2);
gfx_setfont(11); ui_col(PHD);
sprintf(#lg_g, "%s  ·  %s", slider1 < 0.5 ? "STOPPED" : (play_state & 1) ? "WITH REAPER" : "FREE RUN", lv_nh > 0 ? "KEY PEDAL" : "ROOT PEDAL");
lg_tc(1015, 35, #lg_g);
ui_size_picker(1124 * sc, 26 * sc);

// ======================== the two spirals ========================
lg_side(22, 0);
lg_side(808, 1);

// ======================== the display: the drone's figure, the two orbits, the steps round them ========================
ui_cola(0x000000, 0.4); lg_rr(407, 72, 392, 262, 12);
ui_col(INK); lg_rr(404, 68, 392, 262, 12);
ui_col(0x3A3C41); lg_rr(407.5, 71.5, 385, 255, 10);
ui_col(SCR); lg_rr(413, 77, 374, 244, 7);
lg_cx = 600; lg_cy = 199;
// the phase field (etched): rings and a cross
ui_col(GRID); lg_ring(lg_cx, lg_cy, 40); lg_ring(lg_cx, lg_cy, 75); lg_l1(lg_cx - 116, lg_cy, lg_cx + 116, lg_cy); lg_l1(lg_cx, lg_cy - 116, lg_cx, lg_cy + 116);
// the steps: the left's on the outer orbit, the right's on the inner; the step playing lit
lg_s = 0;
loop(2,
  lg_n = max(LVS[lg_s * 32], 1); lg_rad = lg_s ? 98 : 112; lg_cur = LVS[lg_s * 32 + 22];
  ui_col(lg_s ? PHRD : PHLD); lg_ring(lg_cx, lg_cy, lg_rad);
  lg_i = 0;
  loop(lg_n,
    lg_a = lg_i / lg_n * 2 * $pi + (lg_s ? $pi / lg_n : 0);
    lg_on = slider1 >= 0.5 && lg_i == lg_cur;
    ui_col(lg_on ? (lg_s ? PHR : PHL) : (lg_s ? PHRD : PHLD));
    lg_disc(lg_cx + sin(lg_a) * lg_rad, lg_cy - cos(lg_a) * lg_rad, lg_on ? 4.5 : 2.6);
    lg_i += 1;
  );
  lg_s += 1;
);
// the drone: its phase portrait (the signal against itself a quarter-period on) - a still figure at the centre
lg_w = lv_scw;
lg_f = 440 * 2 ^ ((lvdA.pn * cos(lv_xf * 0.5 * $pi) ^ 2 + lvdB.pn * sin(lv_xf * 0.5 * $pi) ^ 2 - 69) / 12);
lg_lag = max(1, floor(srate * 0.5 / lg_f / 4 + 0.5));
lg_px = 0.0001; lg_i = 0; loop(600, lg_px = max(lg_px, abs(LVSX[(lg_w - 600 + lg_i) & LVSM])); lg_i += 1; );
lg_dpk = max(lg_px, lg_dpk * 0.95);
lg_px > 0.0004 ? (
  lg_i = 0;
  loop(300,
    lg_j = (lg_w - 610 + lg_i * 2) & LVSM;
    lg_x = lg_cx + LVSX[lg_j] / lg_dpk * 34; lg_y = lg_cy - LVSX[(lg_j - lg_lag) & LVSM] / lg_dpk * 34;
    lg_i > 0 ? ( ui_cola(PHD, 0.25); lg_ln(lg_ox, lg_oy, lg_x, lg_y, 3); ui_cola(PHD, 0.9); lg_ln(lg_ox, lg_oy, lg_x, lg_y, 1); );
    lg_ox = lg_x; lg_oy = lg_y; lg_i += 1;
  );
) : ( gfx_setfont(11); ui_col(0x8A7C5E); lg_tc(lg_cx, lg_cy, slider1 < 0.5 ? "RUN (OR REAPER'S PLAY)" : "THE PEDAL WAKES"); );
// the two spirals' orbits: each its own phase portrait (a note rings round, then winds in as it dies), placed where
// its pan has it - when FATE trades the pans, the orbits cross
lg_s = 0;
loop(2,
  lg_buf = lg_s ? LVSR : LVSL;
  lg_nt = LVS[lg_s * 32 + 23]; lg_f = 440 * 2 ^ (((lg_nt > 0 ? lg_nt : 60) - 69) / 12);
  lg_lag = max(1, floor(srate * 0.5 / lg_f / 4 + 0.5));
  lg_px = 0.0001; lg_i = 0; loop(600, lg_px = max(lg_px, abs(lg_buf[(lg_w - 600 + lg_i) & LVSM])); lg_i += 1; );
  lg_s ? ( lg_rpk = max(lg_px, lg_rpk * 0.97); lg_pk = lg_rpk; ) : ( lg_lpk = max(lg_px, lg_lpk * 0.97); lg_pk = lg_lpk; );
  lg_ox_ = lg_cx + (lg_s ? lv_prs : lv_pls) * 40;
  lg_px > 0.0004 ? (
    lg_i = 0;
    loop(260,
      lg_j = (lg_w - 530 + lg_i * 2) & LVSM;
      lg_x = lg_ox_ + lg_buf[lg_j] / lg_pk * 66; lg_y = lg_cy - lg_buf[(lg_j - lg_lag) & LVSM] / lg_pk * 66;
      lg_i > 0 ? ( ui_cola(lg_s ? PHR : PHL, 0.12 + 0.75 * lg_i / 260); lg_ln(lg_ox, lg_oy, lg_x, lg_y, 1.2); );
      lg_ox = lg_x; lg_oy = lg_y; lg_i += 1;
    );
  );
  lg_s += 1;
);
// the captions: the sides, the courtship, the pedal and the scale
gfx_setfont(11);
ui_col(PHL); lg_t(422, 84, "LEFT"); ui_col(PHR); lg_tr(778, 91, "RIGHT");
ui_cola(PHL, 0.6); lg_t(422, 100, pk_pitem("BELL|PLUCK|MALLET|PAD", LVS[6] + 1, #lg_k));
ui_cola(PHR, 0.6); lg_tr(778, 107, pk_pitem("BELL|PLUCK|MALLET|PAD", LVS[38] + 1, #lg_k));
// the pans: where each side sits (a bar along the foot of the screen)
ui_col(GRID); lg_r(470, 306, 260, 1); lg_r(600, 302, 1, 9);
ui_col(PHL); lg_disc(600 + lv_pls * 130, 306.5, 3.5); ui_col(PHR); lg_disc(600 + lv_prs * 130, 306.5, 3.5);
ui_col(0x9A8A66); lg_t(422, 293, "PANS");
lg_cev_ = slider1 >= 0.5 ? lv_cev : 0;
ui_col(lg_cev_ ? HAZ : 0x5A5F6A); lg_tr(778, 299, lg_cev_ ? pk_pitem(LG_CEV, lg_cev_ + 1, #lg_k) : slider80 < 0.5 ? "NO COURTSHIP" : "APART");
ui_col(PHD); sprintf(#lg_g, "PEDAL %s", lg_nname(lv_pdt)); lg_t(422, 116, #lg_g);

// ======================== the TWIN GENERATORS: the dual-concentric knobs ========================
ui_col(INK); lg_r(20.5, 338.5, 1159, 133);
ui_col(0x1C1D21); lg_r(22, 340, 1156, 130);
ui_col(0x141518); lg_r(22, 340, 1156, 24);
ui_col(MRG); lg_r(22, 364, 578, 1.5); ui_col(MSV); lg_r(600, 364, 578, 1.5);
ui_col(HAZ); lg_r(30, 348, 2, 9); lg_r(599.5, 365.5, 1, 9);
gfx_setfont(12); ui_col(CLBL); lg_t(38, 343, "TWIN GENERATORS");
gfx_setfont(11); ui_col(PHL); lg_t(212, 346, "OUTER RING = LEFT (drag the rim)"); ui_col(PHR); lg_t(470, 346, "CENTRE = RIGHT (drag the cap)");
ui_col(CDIM); lg_tr(1170, 352, "WHEEL · SHIFT FINE · DOUBLE-CLICK DEFAULT");
lg_cknob(86, 412, 34, 46, 3, 16, 6, 7, 1, "STEPS", "%.0f STEPS", 0);
lg_cknob(214, 412, 37, 49, 1, 4, 2, 2, 1, "RANGE", "%.0f OCT", 0);
lg_cknob(342, 412, 38, 50, -1, 2, 0, 0, 1, "OCTAVE", "%+.0f OCT", 0);
lg_cknob(470, 412, 39, 51, 5, 100, 55, 55, 0, "GATE", "%.0f%%", 0);
lg_cknob(600, 412, 41, 53, 0, 100, 50, 50, 0, "TONE", "%.0f%%", 1);
lg_cknob(730, 412, 42, 54, 0, 100, 70, 70, 0, "LEVEL", "%.0f%%", 0);
lg_cknob(858, 412, 43, 55, 0, 100, 35, 35, 0, "DELAY", "SEND %.0f%%", 0);
lg_cknob(986, 412, 44, 56, 0, 100, 20, 20, 0, "MOD", "SEND %.0f%%", 0);
lg_cknob(1114, 412, 45, 57, 0, 100, 30, 30, 0, "SHIMMER", "SEND %.0f%%", 0);

// ======================== PEDAL DRONE ========================
lg_sect(22, 480, 370, 280, "PEDAL DRONE  ·  CENTRE");
lg_cap(34, 510, "ROOT"); lg_cap(112, 510, "OCTAVE");
lg_dd(34, 526, 70, 26, 3, 0, 12, "C|C#|D|D#|E|F|F#|G|G#|A|A#|B", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", floor(slider3 + 0.5) + 1, #lg_k2));
sprintf(#lg_g, "%d", floor(slider4 + 0.5));
lg_dd(112, 526, 62, 26, 4, 1, 4, "1 (C1 - B1)|2 (C2 - B2)|3 (C3 - B3)|4 (C4 - B4)", #lg_g);
ui_col(INK); lg_rr(184, 526, 196, 26, 3); ui_col(SCR); lg_rr(185.5, 527.5, 193, 23, 2);
gfx_setfont(11); ui_col(PHD);
sprintf(#lg_g, "PEDAL %s  ·  %s", lg_nname(lv_pdt), lv_nh > 0 ? "LOWEST KEY" : "THE ROOT"); lg_tc(282, 539, #lg_g);
lg_knob(56, 604, 17, 24, 0, 100, 70, 0, "LEVEL", "%.0f%%", 0, 0);
lg_knob(116, 604, 17, 25, 0, 100, 40, 0, "TONE", "%.0f%%", 0, 1);
lg_knob(176, 604, 17, 26, 0, 100, 15, 0, "DRIVE", "%.0f%%", 0, 0);
lg_knob(236, 604, 17, 27, 0, 100, 45, 0, "SUB", "%.0f%%", 0, 0);
lg_knob(296, 604, 17, 28, 0, 100, 20, 0, "FIFTH", "%.0f%%", 0, 0);
lg_knob(356, 604, 17, 29, 0, 30, 7, 0, "DETUNE", "%.1f cents", 0, 0);
ui_cola(RINK, 0.35); lg_r(34, 648, 346, 1);
lg_knob(56, 694, 17, 30, 0, 2000, 300, 0, "GLIDE", "%.0f ms", 0, 0);
ui_cola(RINK, 0.35); lg_r(96, 664, 1, 70);
lg_knob(176, 700, 17, 31, 0, 100, 0, 0, "DELAY", "SEND %.0f%%", 0, 0);
lg_knob(236, 700, 17, 32, 0, 100, 20, 0, "MOD", "SEND %.0f%%", 0, 0);
lg_knob(296, 700, 17, 33, 0, 100, 25, 0, "SHIMMER", "SEND %.0f%%", 0, 0);
gfx_setfont(11); ui_col(RDIM); lg_tc(236, 662, "SENDS");

// ======================== HARMONY: the scale, the coupling, the custom keys, tiers, reassignment, the seed ========================
lg_fdk = 1;
