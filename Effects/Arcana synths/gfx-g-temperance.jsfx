tg_knob(85, 166, 34, 1, 0, 100, 55, 0, "TENSION", "%.0f%%", 0, 1, te_tn * 100, 0);
tg_knob(207, 166, 34, 2, 0, 100, 25, 0, "STIFFNESS", "%.0f%%", 0, 1, (te_stf / 0.95) ^ (1 / 1.5) * 100, 0);
tg_knob(329, 166, 34, 3, 0, 100, 55, 0, "LENGTH", "%.0f%%", 0, 1, te_ln * 100, 0);
// what the knobs have made of the strings (middle C, a felt hammer, as they stand now)
ui_col(INK); tg_rr(34, 236, 346, 84, 4); ui_col(SCR); tg_rr(35.5, 237.5, 343, 81, 3);
ui_cola(GRNF, 1); tg_r(44, 290, 326, 1);
