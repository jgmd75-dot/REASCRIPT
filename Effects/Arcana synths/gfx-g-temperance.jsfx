  gfx_setfont(12); ui_col(LBL); tg_tc(tg_x + 23, 516, tg_k == 0 ? "DETUNE" : tg_k == 1 ? "MUTE" : "RELEASE");
  tg_key(tg_x - 6, 530, 26, 20, slider(tg_b + 2) < 0.5, "I") ? tg_set(tg_b + 2, 0);
  tg_key(tg_x + 26, 530, 26, 20, slider(tg_b + 2) >= 0.5, "II") ? tg_set(tg_b + 2, 1);
  tg_k == 0 ? (
    tg_fader(tg_x, 570, 130, 18, 0, 20, 2.5, "%.1f cents", te_dsp, "SPREAD");
    tg_fader(tg_x + 46, 570, 130, 19, 0, 30, 3, "%.1f cents", te_ddp, "DEPTH");
  ) : tg_k == 1 ? (
