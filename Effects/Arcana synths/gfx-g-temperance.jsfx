sprintf(#tg_g, "%+.1f CENTS AT THE 8TH PARTIAL", tg_s8); tg_tr(370, 250, #tg_g);
tg_m = te_mrl; tg_t60 = te_t60b * (0.75 + 0.5 * te_tn) * (1 - 0.94 * tg_m);
sprintf(#tg_g, "%.1f S AT C4%s", tg_t60, tg_m > 0.01 ? "  (MUTED)" : ""); tg_tr(370, 305, #tg_g);
// the stretch's little picture: eight partials, where they would sit (ticks) and where they are (green)
ui_cola(GRNF, 1); tg_r(46, 278, 324, 1);
tg_i = 1; loop(8, tg_x = 6 + tg_i * 40; ui_col(GRND); tg_r(tg_x, 266, 1, 16); tg_i += 1; );
tg_i = 1; loop(8, tg_x = 6 + tg_i * 40 * 2 ^ (tg_stretch(tg_i) / 1200); ui_col(GRN); tg_r(tg_x - 1, 268, 3, 12); tg_i += 1; );
// the bridge: crosstalk, spread, bend
ui_cola(INK, 0.35); tg_r(34, 330, 346, 1);
tg_knob(78, 372, 21, 10, 0, 100, 30, 0, "CROSSTALK", "%.0f%%", 0, 0, -1, 0);
tg_knob(166, 372, 21, 11, 0, 100, 60, 0, "SPREAD", "%.0f%%", 0, 0, -1, 0);
tg_cap(234, 340, "BEND RANGE");
sprintf(#tg_g, slider50 < 0.5 ? "OFF" : "+/- %.0f ST", slider50);
tg_dd(234, 356, 146, 30, 50, 0, 13, "Off|1 semitone|2 semitones|3 semitones|4 semitones|5 semitones|6 semitones|7 semitones|8 semitones|9 semitones|10 semitones|11 semitones|12 semitones", #tg_g);
gfx_setfont(11); ui_col(LBL); tg_t(234, 398, te_ped ? "SUSTAIN PEDAL DOWN" : "SUSTAIN PEDAL UP");
tg_cross(372, 452, 5);

// ======================== the oscilloscope ========================
ui_cola(0x000000, 0.32); tg_rr(405, 76, 396, 396, 14);
ui_col(INK); tg_rr(402, 72, 396, 396, 14);
ui_col(LEAD); tg_rr(405.5, 75.5, 389, 389, 11.5);
ui_cola(0xFFFFFF, 0.12); tg_rr(405.5, 75.5, 389, 2, 1);
ui_col(SCR); tg_rr(412, 82, 376, 376, 9);
// the graticule and its calibration crosshair
tg_i = 1; loop(9, ui_cola(GRNF, 0.7); tg_r(412 + tg_i * 37.6, 86, 1, 368); tg_r(416, 82 + tg_i * 37.6, 368, 1); tg_i += 1; );
ui_cola(GRND, 0.35); tg_r(600, 86, 1, 368); tg_r(416, 270, 368, 1);
tg_i = 0; loop(41, ui_cola(GRND, 0.4); tg_r(412 + tg_i * 9.4, tg_i % 5 == 0 ? 266 : 268, 1, tg_i % 5 == 0 ? 9 : 5); tg_i += 1; );
// the twelve strings between their two bridges: each one's travelling wave as it circulates now
tg_pk = 0.0001; tg_i = 0; loop(12, te_vst(tg_i) ? tg_pk = max(tg_pk, te_venv(tg_i)); tg_i += 1; );
tg_spk = max(tg_pk, tg_spk * 0.95);
ui_col(GRND); tg_r(444, 96, 2, 228); tg_r(756, 96, 2, 228);
tg_i = 0;
loop(12,
  tg_y = 104 + tg_i * 19;
  tg_on = te_vst(tg_i);
  gfx_setfont(11);
  tg_on ? (
    tg_e = min(te_venv(tg_i) / tg_spk, 1);
    tg_bf = TEB + tg_i * TEBN;
    tg_w = tg_i == 0 ? tv0.w : tg_i == 1 ? tv1.w : tg_i == 2 ? tv2.w : tg_i == 3 ? tv3.w : tg_i == 4 ? tv4.w : tg_i == 5 ? tv5.w :
           tg_i == 6 ? tv6.w : tg_i == 7 ? tv7.w : tg_i == 8 ? tv8.w : tg_i == 9 ? tv9.w : tg_i == 10 ? tv10.w : tv11.w;
    tg_dl = tg_i == 0 ? tv0.dl : tg_i == 1 ? tv1.dl : tg_i == 2 ? tv2.dl : tg_i == 3 ? tv3.dl : tg_i == 4 ? tv4.dl : tg_i == 5 ? tv5.dl :
            tg_i == 6 ? tv6.dl : tg_i == 7 ? tv7.dl : tg_i == 8 ? tv8.dl : tg_i == 9 ? tv9.dl : tg_i == 10 ? tv10.dl : tv11.dl;
    tg_j = 0;
    loop(73,
      tg_x = 446 + tg_j / 72 * 310;
      tg_s = tg_bf[floor(tg_w - tg_dl + tg_j / 72 * tg_dl) & TEBM] / max(te_venv(tg_i), 0.25 * tg_spk);
      tg_yy = tg_y - min(max(tg_s, -1), 1) * 8;
      tg_j > 0 ? ( ui_cola(GRN, 0.2 + 0.2 * tg_e); tg_ln(tg_ox, tg_oy, tg_x, tg_yy, 3.2); ui_col(ui_mix(GRND, GRNL, tg_e)); tg_ln(tg_ox, tg_oy, tg_x, tg_yy, 1.1); );
      tg_ox = tg_x; tg_oy = tg_yy; tg_j += 1;
    );
    ui_col(ui_mix(GRND, GRNL, tg_e)); tg_tr(440, tg_y, tg_nname(te_vk(tg_i)));
  ) : (
    ui_cola(GRND, 0.6); tg_r(446, tg_y, 310, 1);
  );
  tg_i += 1;
);
ui_cola(GRND, 0.5); tg_r(420, 334, 360, 1);
// the patience: the two LFOs' orbits, each string a point at its own phase
tg_cx = 478; tg_cy = 396;
ui_cola(GRND, 0.55); tg_ring(tg_cx, tg_cy, 26); tg_ring(tg_cx, tg_cy, 48);
ui_cola(GRNF, 1); tg_r(tg_cx - 54, tg_cy, 108, 1); tg_r(tg_cx, tg_cy - 54, 1, 108);
tg_i = 0;
loop(12,
  tg_on = te_vst(tg_i);
  tg_a = TWOPI * (te_p1 + te_o1 * tg_i / 12); ui_col(tg_on ? GRNL : GRND); tg_disc(tg_cx + sin(tg_a) * 26, tg_cy - cos(tg_a) * 26, tg_on ? 2.8 : 1.6);
  tg_a = TWOPI * (te_p2 + te_o2 * tg_i / 12); ui_col(tg_on ? GRN : GRND); tg_disc(tg_cx + sin(tg_a) * 48, tg_cy - cos(tg_a) * 48, tg_on ? 2.8 : 1.6);
  tg_i += 1;
);
gfx_setfont(11); ui_col(GRND); tg_tc(tg_cx, tg_cy, "I"); tg_t(tg_cx + 50, tg_cy - 58, "II");
// FATE's tension creep: the balance tips as the strings relax and tighten
tg_scales(612, 372, 70, min(max(te_cr / 0.12, -1), 1) * 2, GRN, 0.85);
gfx_setfont(11); ui_col(GRND); tg_tc(612, 432, "TENSION CREEP");
sprintf(#tg_g, "%+.1f CENTS", te_crc); ui_col(GRNL); tg_tc(612, 446, #tg_g);
// the readouts
gfx_setfont(11); ui_col(GRND); tg_t(690, 348, "HAMMER"); tg_t(690, 392, "STRIKE");
gfx_setfont(13); ui_col(GRNL); tg_t(690, 362, pk_pitem("FELT|DULCIMER|TACK|PREPARED|AUTOHARP", te_hm + 1, #tg_k2));
sprintf(#tg_g, "%.0f %%", slider6); tg_t(690, 406, #tg_g);
gfx_setfont(11); ui_col(GRND); sprintf(#tg_g, "FATE %.0f %%", slider46); tg_t(690, 432, #tg_g);

// ======================== THE HAMMERS ========================
tg_sect(808, 72, 370, 396, "THE HAMMERS");
tg_hm = floor(slider4 + 0.5);
tg_i = 0;
loop(5,
  tg_x = 818 + tg_i * 71;
  tg_key(tg_x, 104, 66, 72, tg_hm == tg_i, "") ? tg_set(4, tg_i);
  tg_glyph(tg_i, tg_x + 33, 130, tg_hm == tg_i ? INK : KEYT);
  gfx_setfont(11); ui_col(tg_hm == tg_i ? INK : KEYT); tg_tc(tg_x + 33, 160, pk_pitem("FELT|DULCIMER|TACK|PREPARED|AUTOHARP", tg_i + 1, #tg_k2));
  tg_i += 1;
);
// where the hammer meets the string: the string between its bridges, the hammer at STRIKE
ui_col(INK); tg_rr(820, 190, 346, 62, 4); ui_col(SCR); tg_rr(821.5, 191.5, 343, 59, 3);
tg_x0 = 838; tg_x1 = 1148; tg_bx = tg_x0 + (tg_x1 - tg_x0) * slider6 / 100;
ui_col(GRND); gfx_triangle(tg_x0 * sc, 230 * sc, (tg_x0 - 6) * sc, 240 * sc, (tg_x0 + 6) * sc, 240 * sc);
gfx_triangle(tg_x1 * sc, 230 * sc, (tg_x1 - 6) * sc, 240 * sc, (tg_x1 + 6) * sc, 240 * sc);
tg_j = 0; loop(64, tg_a = tg_j / 63; tg_x = tg_x0 + tg_a * (tg_x1 - tg_x0); tg_y = 230 - sin($pi * tg_a) * 10;
  tg_j > 0 ? ( ui_cola(GRND, 0.6); tg_ln(tg_ox, tg_oy, tg_x, tg_y, 1); ); tg_ox = tg_x; tg_oy = tg_y; tg_j += 1; );
ui_col(GRN); tg_r(tg_x0, 229.5, tg_x1 - tg_x0, 1.2);
