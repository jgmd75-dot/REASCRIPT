ui_col(GRNL); tg_disc(tg_bx, 230, 2.5);
gfx_setfont(11); ui_col(GRND);
sprintf(#tg_g, "STRUCK AT 1/%.0f: PARTIAL %.0f SILENCED", 100 / max(slider6, 1), floor(100 / max(slider6, 1) + 0.5));
tg_tc(993, 244, #tg_g);
tg_knob(864, 296, 22, 5, 0, 100, 50, 0, "HARDNESS", "%.0f%%", 0, 0, -1, 0);
tg_knob(993, 296, 22, 6, 4, 50, 12, 0, "STRIKE", "%.0f%% of the length", 1, 0, -1, 0);
tg_knob(1122, 296, 22, 7, 0, 100, 70, 0, "VELOCITY", "%.0f%%", 0, 0, -1, 0);
// AUTOHARP: the strum
ui_cola(INK, 0.35); tg_r(820, 340, 346, 1);
gfx_setfont(12); ui_col(tg_hm == 4 ? LBL : FACED); tg_t(820, 350, "AUTOHARP");
gfx_setfont(11); tg_t(820, 368, "THE KEYS HELD ARE THE CHORD BAR");
tg_knob(864, 418, 19, 8, 5, 120, 28, 1, "STRUM", "%.0f ms", 0, 0, -1, 0);
