desc:Temperance [Arcana synth] (GFX)
//tags: instrument synth physical model string waveguide hammer dulcimer prepared piano autoharp polyphonic reverb arcana
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-voice (.jsfx-inc) in the same folder.
//
// TEMPERANCE (card XIV of the GFX Arcana series): patience, balance, the slow pouring of one cup into the other.
// A polyphonic physical string instrument with no samples at all: twelve synthetic strings, five ways of striking
// them, and a "patience" matrix of slow LFOs that lean on the strings while they ring - into a vibrato, a tremolo,
// a chorus, a delay and a long, dark reverb.
//   STRINGS    each voice is a waveguide string: a delay line one period long, a loss filter (how fast the string
//              dies, high partials first) and two all-pass sections in the loop (the string's stiffness: the upper
//              partials run sharp, as on a real piano string, a bar or a bell). The three heavy knobs are oil-damped
//              (they move the sound over about half a second, whatever the hand does):
//              TENSION   a tighter string is brighter, rings longer and is less stiff (less stretched); a slack one
//                        is duller, shorter and more inharmonic.
//              STIFFNESS the inharmonicity itself: 0 = an ideal string (harmonic), up = stretched partials, at the top
//                        a clangorous, bar-like string (the bass most of all).
//              LENGTH    a longer string sustains longer (about 2 s .. 20 s at middle C), is a little darker and less
//                        stiff.
//              CROSSTALK the strings share a bridge: each one hears the others a little (sympathetic resonance).
//              SPREAD    the strings fanned across the stereo field by pitch (low left, high right).
//              BEND      the pitch-bend range (0 - 12 semitones).
//   HAMMERS    five lit keys pick how the next notes are struck (the strings already ringing are not touched):
//              FELT      a soft, warm felt hammer: a long, round contact, a deep fundamental.
//              DULCIMER  a wooden mallet: a short, hard contact, a bright crisp ping and the mallet's own woody knock.
//              TACK      a tack piano: a metal tack on the hammer, a very short click that bounces once, and the
//                        bell-like zing of the tack in the high mids.
//              PREPARED  bolts and rubber wedges between the strings, a different preparation on every key (as in
//                        the classic prepared piano): bolted keys clang with inharmonic metal partials, rubbered keys
//                        give a short, muted thud, and some keys have both.
//              AUTOHARP  a narrow pick through felt-damped strings: the keys held are the chord bar. A strum crosses
//                        the strings of the chord held (STRINGS: how many, 4 - 12, upward from the lowest key held),
//                        STRUM ms apart, down and up in turn; letting a key go drops the felt on its strings. The
//                        strings share their bridge more tightly here (crosstalk doubled).
//              HARDNESS  the hammer's hardness (brighter, shorter contact). STRIKE  where the string is struck, as a
//              share of its length (4 - 50 %: near the end = thin and bright, near the middle = hollow).
//              VELOCITY  how much the key velocity sets the strength and the brightness of the strike.
//   PATIENCE   two slow LFOs (I and II: RATE 0.01 - 2 Hz, SHAPE sine, triangle, drift (smooth random) or step;
//              ORBIT: how far apart the twelve strings' own LFO phases are spread - 0 = all in step, 100 % = evenly
//              round the circle, so every string wanders on its own). Three destinations, each with two slow-glide
//              faders (the faders' settings glide in over about a second) and a source key (I / II):
//              DETUNE    SPREAD: each new note's own fixed detune (cents); DEPTH: the LFO's pitch wander (cents).
//              MUTE      RAIL: a felt mute rail pressed on all the strings (damping and darkening); DEPTH: the LFO
//                        presses and lifts it.
//              RELEASE   TIME: how fast a string is damped when its key is let go (and the pedal is up); DEPTH: the
//                        LFO lengthens and shortens it (up to two octaves of time either way).
//   VIBRATO    a pitch vibrato on the whole instrument (a modulated delay): RATE, DEPTH (cents), SHAPE (sine,
//              triangle, square (rounded), drift), PHASE (the right side's offset: 0 = mono, 180 = opposite) and
//              SYNC (FREE, or KEY: it starts from its zero point at the first key after silence). IN.
//   TREMOLO    RATE, DEPTH, SHAPE, PHASE (180 = an auto-pan), SYNC (FREE, KEY, or VIBRATO: it rides the vibrato's
//              own rate and phase). IN.
//   CHORUS     a rich, gentle stereo ensemble (three voices a side): RATE, DEPTH, MIX. IN.
//   DELAY      TIME free (20 - 1500 ms) or SYNC to a division (1/16 .. 1 bar, the drop-down); FEEDBACK; TONE (the
//              repeats dark .. bright); MIX; PING (ping-pong: the repeats cross from side to side). IN.
//              The chain: strings -> vibrato -> tremolo -> chorus -> delay -> reverb.
//   REVERB     a lush algorithmic hall (eight lines, slowly moving): DECAY (0.8 - 30 s), SIZE, DARK (the tail's
//              damping), PRE (pre-delay), MOD (the tail's slow motion), MIX. IN.
//   FATE       the series' drift (0 - 100 %, 50 % = the standard amount), here both, blended: TENSION CREEP - the
//              strings' tension slowly relaxes and re-tightens over minutes, so the stretch tuning, the brightness
//              and the pitch breathe (each string a little differently) - and PATIENT HANDS - every strike's
//              strength, position and timing vary a little, like an unhurried player.
//   VOLUME, LEVEL, SAT (the output soft clip is always on).
// MIDI: notes (velocity: strength and brightness), sustain pedal (CC64), pitch bend, CC120 / CC123 all notes off;
// the channel drop-down in the title bar. Twelve voices; a new note takes a free string, else the quietest released
// one, else the oldest - fading it out in 5 ms first. The same key struck again strikes its ringing string again.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc

slider1:55<0,100,1>-Tension (%)
slider2:25<0,100,1>-Stiffness (%)
slider3:55<0,100,1>-Length (%)
slider4:0<0,4,1{Felt,Dulcimer,Tack,Prepared,Autoharp}>-Hammer
slider5:50<0,100,1>-Hardness (%)
slider6:12<4,50,1>-Strike position (%)
slider7:70<0,100,1>-Velocity (%)
slider8:28<5,120,1>-Strum (ms)
slider9:8<4,12,1>-Strum strings
slider10:30<0,100,1>-Crosstalk (%)
slider11:60<0,100,1>-Spread (%)
slider12:0.06<0.01,2,0.001>-LFO I rate (Hz)
slider13:0<0,3,1{Sine,Triangle,Drift,Step}>-LFO I shape
slider14:60<0,100,1>-LFO I orbit (%)
slider15:0.17<0.01,2,0.001>-LFO II rate (Hz)
slider16:2<0,3,1{Sine,Triangle,Drift,Step}>-LFO II shape
slider17:100<0,100,1>-LFO II orbit (%)
slider18:2.5<0,20,0.1>-Detune spread (cents)
slider19:3<0,30,0.1>-Detune depth (cents)
slider20:0<0,1,1{LFO I,LFO II}>-Detune source
slider21:0<0,100,1>-Mute rail (%)
slider22:0<0,100,1>-Mute depth (%)
slider23:1<0,1,1{LFO I,LFO II}>-Mute source
slider24:0.45<0.05,8,0.01>-Release (s)
slider25:0<0,100,1>-Release depth (%)
slider26:0<0,1,1{LFO I,LFO II}>-Release source
slider27:0<0,1,1{Out,In}>-Vibrato
slider28:4.8<0.1,8,0.01>-Vibrato rate (Hz)
slider29:10<0,50,0.1>-Vibrato depth (cents)
slider30:0<0,3,1{Sine,Triangle,Square,Drift}>-Vibrato shape
slider31:60<0,180,1>-Vibrato phase (deg)
slider32:0<0,1,1{Free,Key}>-Vibrato sync
slider33:0<0,1,1{Out,In}>-Tremolo
slider34:4<0.1,12,0.01>-Tremolo rate (Hz)
slider35:40<0,100,1>-Tremolo depth (%)
slider36:0<0,3,1{Sine,Triangle,Square,Drift}>-Tremolo shape
slider37:0<0,180,1>-Tremolo phase (deg)
slider38:0<0,2,1{Free,Key,Vibrato}>-Tremolo sync
slider39:1<0,1,1{Out,In}>-Reverb
slider40:5.5<0.8,30,0.1>-Reverb decay (s)
slider41:60<0,100,1>-Reverb size (%)
slider42:55<0,100,1>-Reverb dark (%)
slider43:25<0,200,1>-Reverb pre-delay (ms)
slider44:35<0,100,1>-Reverb mod (%)
slider45:28<0,100,1>-Reverb mix (%)
slider46:50<0,100,1>-Fate (%)
slider47:-3<-24,6,0.1>-Volume (dB)
slider48:60<0,100,0.1>-Level (%)
slider49:0<0,16,1>-MIDI channel (0 = omni)
slider50:2<0,12,1>-Pitch bend (semitones)
slider51:0<0,100,1>-Band sat (%)
slider52:30<0,100,1>-Bias (%)
slider53:120<40,400,1>-Sat low band (Hz)
slider54:6000<2000,16000,10>-Sat high band (Hz)
slider55:-0.3<-24,0,0.1>-Ceiling (dB)
slider56:1<0,1,1{Off,Clip}>-(unused, output stage)
slider57:0<0,1,1{Out,In}>-Chorus
slider58:0.4<0.05,3,0.01>-Chorus rate (Hz)
slider59:50<0,100,1>-Chorus depth (%)
slider60:35<0,100,1>-Chorus mix (%)
slider61:0<0,1,1{Out,In}>-Delay
slider62:0<0,1,1{Free,Sync}>-Delay sync
slider63:380<20,1500,1>-Delay time (ms)
slider64:5<0,9,1{1/16,1/8T,1/8,1/8D,1/4T,1/4,1/4D,1/2,1/2D,1 bar}>-Delay division
slider65:35<0,95,1>-Delay feedback (%)
slider66:40<0,100,1>-Delay tone (%)
slider67:22<0,100,1>-Delay mix (%)
slider68:0<0,1,1{Off,On}>-Delay ping-pong
slider69:prs_sel=0<0,12,1{No preset,Init,Still Water,Two Cups,Iris Path,Mercury Rain,Nigredo,Circulatio,Aqua Vitae,Patient Hands,Quintessence,Prima Materia,The Middle Way}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-temperance";                              // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
TEDEF = 1000; TETMP = 1200;                                // the Init values; the preset parser's scratch (panel only)
TEHN = 1500; TEHV = 1600;                                  // the keys held (AUTOHARP: the chord bar)
TEB = 10000; TEBN = 8192; TEBM = 8191;                     // the twelve string lines (10000 - 108303)
TEVL = 110000; TEVR = 120000; TEVM = 8191;                 // the vibrato's lines
TEPD = 130000; TEPDM = 16383;                              // the reverb's pre-delay
TEAP = 150000; TEAPN = 4096; TEAPM = 4095;                 // the reverb's four input all-passes
TERV = 170000; TERN = 16384; TERM = 16383;                 // the reverb's eight lines (170000 - 301071)
TECL = 320000; TECR = 328192; TECM = 8191;                 // the chorus lines
TEDL = 400000; TEDR = 924288; TEDM = 524287;               // the delay lines (2^19 each)
memset(TECL, 0, 2 * 8192); memset(TEDL, 0, 2 * 524288);
TEDS = 310000;                                             // the strings' stiffness sections: 2 x 256 each (310000 - 316143)
memset(TEVL, 0, 2 * 10000); memset(TEPD, 0, 16384); memset(TEAP, 0, 4 * TEAPN); memset(TERV, 0, 8 * TERN);
TWOPI = 2 * $pi; TEK = 1 / 32;

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#te_def = "55 25 55 0 50 12 70 28 8 30 60 0.06 0 60 0.17 2 100 2.5 3 0 0 0 1 0.45 0 0 0 4.8 10 0 60 0 0 4 40 0 0 0 1 5.5 60 55 25 35 28 50 -3 60 0 2 0 30 120 6000 -0.3 1 0 0.4 50 35 0 0 380 5 35 40 22 0";
function te_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function te_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
te_nums(#te_def, TEDEF);
#te_pm = "Init|Still Water|Two Cups|Iris Path|Mercury Rain|Nigredo|Circulatio|Aqua Vitae|Patient Hands|Quintessence|Prima Materia|The Middle Way";
te_npre = 12;
function te_pstr(p) (
  p == 2 ? "1:45 2:15 3:85 5:30 21:10 22:25 23:1 16:2 15:0.05 24:1.4 25:40 40:12 41:90 42:70 43:60 45:42 48:57.1" :
  p == 3 ? "4:4 1:60 2:20 3:50 5:60 8:34 9:10 10:60 40:7 41:75 45:32 18:4 19:3 48:47.7" :
  p == 4 ? "4:1 1:70 2:30 3:60 5:65 6:14 33:1 34:2.2 35:35 36:1 37:120 40:4.5 45:26 19:4 48:53.6" :
  p == 5 ? "4:2 1:78 2:35 3:45 5:75 6:8 18:6 19:2 27:1 28:5.5 29:7 40:3.5 41:45 42:35 45:22 48:47.6" :
  p == 6 ? "1:35 2:20 3:85 5:15 6:16 7:55 21:35 22:30 23:1 15:0.03 16:2 17:100 18:4 19:5 20:1 24:2.5 25:40 12:0.05 13:2 40:14 41:95 42:85 43:50 44:50 45:45 57:1 58:0.18 59:45 60:30 48:55" :
  p == 7 ? "4:4 1:62 2:15 3:80 5:40 8:95 9:12 10:70 11:90 12:0.025 14:100 18:5 19:7 21:10 22:20 23:1 24:1.6 25:45 57:1 58:0.3 59:60 60:40 61:1 62:1 64:6 65:45 66:35 67:22 68:1 40:18 41:100 42:60 43:70 44:75 45:46 48:53.4" :
  p == 8 ? "4:1 1:60 2:20 3:65 5:50 18:9 19:10 14:100 12:0.11 27:1 28:0.35 29:18 30:3 31:150 40:8 45:33 48:49.5" :
  p == 9 ? "21:15 22:45 23:0 12:0.04 13:2 14:100 25:50 26:1 19:6 5:40 7:85 40:9 45:34 48:64.1" :
  p == 10 ? "4:2 1:85 2:70 3:80 5:80 6:6 40:24 41:100 42:60 43:90 44:60 45:45 19:4 48:46.3" :
  p == 11 ? "1:58 2:22 3:100 5:30 10:55 18:12 19:8 12:0.04 13:2 14:100 15:0.09 16:0 17:50 21:12 22:25 23:1 24:2.2 25:30 26:1 57:1 58:0.22 59:55 60:35 61:1 63:620 65:30 66:25 67:14 40:10 41:80 42:70 43:40 44:45 45:40 48:57" :
  p == 12 ? "1:40 2:25 3:55 5:25 21:55 22:20 23:1 24:0.9 33:1 34:0.18 35:25 36:2 37:180 40:6 41:55 42:70 45:30 48:73.7" :
  "";
);
function te_pstr_au(p) (
  p == 2 ? "1:45 2:15 3:85 5:30 21:10 22:25 23:1 16:2 15:0.05 24:1.4 25:40 40:12 41:90 42:70 43:60 45:42 48:57.1" :
  p == 3 ? "4:4 1:60 2:20 3:50 5:60 8:34 9:10 10:60 40:7 41:75 45:32 18:4 19:3 48:47.7" :
  p == 4 ? "4:1 1:70 2:30 3:60 5:65 6:14 33:1 34:2.2 35:35 36:1 37:120 40:4.5 45:26 19:4 48:53.6" :
  p == 5 ? "4:2 1:78 2:35 3:45 5:75 6:8 18:6 19:2 27:1 28:5.5 29:7 40:3.5 41:45 42:35 45:22 48:47.6" :
  p == 6 ? "1:35 2:20 3:85 5:15 6:16 7:55 21:35 22:30 23:1 15:0.03 16:2 17:100 18:4 19:5 20:1 24:2.5 25:40 12:0.05 13:2 40:14 41:95 42:85 43:50 44:50 45:45 57:1 58:0.18 59:45 60:30 48:55" :
  p == 7 ? "4:4 1:62 2:15 3:80 5:40 8:95 9:12 10:70 11:90 12:0.025 14:100 18:5 19:7 21:10 22:20 23:1 24:1.6 25:45 57:1 58:0.3 59:60 60:40 61:1 62:1 64:6 65:45 66:35 67:22 68:1 40:18 41:100 42:60 43:70 44:75 45:46 48:53.4" :
  p == 8 ? "4:1 1:60 2:20 3:65 5:50 18:9 19:10 14:100 12:0.11 27:1 28:0.35 29:18 30:3 31:150 40:8 45:33 48:49.5" :
  p == 9 ? "21:15 22:45 23:0 12:0.04 13:2 14:100 25:50 26:1 19:6 5:40 7:85 40:9 45:34 48:64.1" :
  p == 10 ? "4:2 1:85 2:70 3:80 5:80 6:6 40:24 41:100 42:60 43:90 44:60 45:45 19:4 48:46.3" :
  p == 11 ? "1:58 2:22 3:100 5:30 10:55 18:12 19:8 12:0.04 13:2 14:100 15:0.09 16:0 17:50 21:12 22:25 23:1 24:2.2 25:30 26:1 57:1 58:0.22 59:55 60:35 61:1 63:620 65:30 66:25 67:14 40:10 41:80 42:70 43:40 44:45 45:40 48:57" :
  p == 12 ? "1:40 2:25 3:55 5:25 21:55 22:20 23:1 24:0.9 33:1 34:0.18 35:25 36:2 37:180 40:6 41:55 42:70 45:30 48:73.7" :
  "";
);
function load_preset(p) local(n, i) (
  // FATE, the MIDI channel, the bend range and the output stage stay as they are
  i = 0; loop(68, (i != 45 && (i < 48 || i >= 56)) ? slider(i + 1) = TEDEF[i]; i += 1; );
  n = te_nums(te_pstr(p), TETMP);
  i = 0; loop(floor(n / 2), TETMP[i * 2] >= 1 && TETMP[i * 2] <= 68 ? slider(TETMP[i * 2]) = TETMP[i * 2 + 1]; i += 1; );
  i = 1; loop(68, ui_auto(i); i += 1; );
  pr_cur = p; te_panic = 1;
);
function load_preset_au(p) local(n, i) (
  // FATE, the MIDI channel, the bend range and the output stage stay as they are
  i = 0; loop(68, (i != 45 && (i < 48 || i >= 56)) ? slider(i + 1) = TEDEF[i]; i += 1; );
  n = te_nums_au(te_pstr_au(p), TETMP);
  i = 0; loop(floor(n / 2), TETMP[i * 2] >= 1 && TETMP[i * 2] <= 68 ? slider(TETMP[i * 2]) = TETMP[i * 2 + 1]; i += 1; );
  i = 1; loop(68, ui_auto(i); i += 1; );
  pr_cur = p; te_panic = 1;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(68, slider(i + 1) = TEDEF[i]; ui_auto(i + 1); i += 1; );
);

// ---------- small helpers ----------
function te_h(k) local(t) ( t = sin(k * 12.9898 + 78.233) * 43758.5453; (t - floor(t)) * 2 - 1; );   // a hash, -1 .. 1
// an LFO's value at phase p: 0 sine, 1 triangle, 2 drift (smooth random), 3 step; sd = its seed
function te_lfo(p, s, sd) local(k, f, a, b) (
  k = floor(p); f = p - k;
  s == 0 ? sin(TWOPI * f) : s == 1 ? 1 - 4 * abs(f - 0.5) :
  s == 2 ? ( a = te_h(k + sd); b = te_h(k + 1 + sd); a + (b - a) * (0.5 - 0.5 * cos($pi * f)); ) : te_h(k + sd);
);
// the master LFO shapes (vibrato, tremolo): 0 sine, 1 triangle, 2 square (rounded), 3 drift
function te_mlfo(p, s, sd) local(f) (
  f = p - floor(p);
  s == 0 ? sin(TWOPI * f) : s == 1 ? 1 - 4 * abs(f - 0.5) : s == 2 ? vo_tanh(3 * sin(TWOPI * f)) * 1.0037 : te_lfo(p, 2, sd);
);
// phase delays (samples) at w: a first-order all-pass (coefficient a), and the two-tap loss filter (tap s)
function te_apd(a, w) ( -(atan2(-sin(w), a + cos(w)) - atan2(-a * sin(w), 1 + a * cos(w))) / w; );
// the loss filter is a one-pole low-pass fixed in Hz (so every sample rate sounds the same): the two-tap brightness
// figure s (as tuned at 48 kHz) gives the pole with the same loss curve over the partials (in Hz) at this rate
function te_lossp(s) local(q) ( q = s * (1 - s) * sqr(srate / 48000); ((2 * q + 1) - sqrt(4 * q + 1)) / (2 * q); );
function te_lpd(p, w) ( atan2(p * sin(w), 1 - p * cos(w)) / w; );
// a frequency folded into 250 Hz .. 5 kHz by octaves (the preparations' clang)
function te_fold(f) ( loop(8, f > 5000 ? f *= 0.5 : f < 250 ? f *= 2; ); f; );
// the hammers' strength trims (levelled: FELT, DULCIMER, TACK, PREPARED, AUTOHARP)
function te_mg(m) ( m == 0 ? 1 : m == 1 ? 0.93 : m == 2 ? 1.25 : m == 3 ? 1.3 : 1.12; );

// ---------- a string (each voice in its own namespace) ----------
// st: 0 free, 2 sounding, 4 fading out (stolen: the new note waits 5 ms); sw: samples until the hammer strikes (-1 none);
// hk: its key (or the chord bar) is held. The line holds one period less the filters' own delays (dl, gliding to dlt
// over each control tick).
function te_init(b, i) instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) (
  bf = b; vi = i; st = 0; nt = 60; w = 0; dl = dlt = 100; ddl = 0; g = 0; fs = 0.3; ap = 0; x1 = 0; sb = TEDS + i * 512; j = 0; kk = 1; eo = 0; ki = 0; kc = 0; d1 = d2 = 0;
  ei = et = 0; en = 5; ew = 1; ea = 0; eb = 1; ec = 0.92; ebb = 0; eab = 0; sw = -1; pv = 0; pm = 0; pn = 60; pw = 0; hk = 0;
  fd = 1; pk = env = 0; yo = 0; gl = gr = 0.7071; age = 0; dn = 0; l1 = l2 = 0; f0 = 261.6; md = 1; mf = 0; ma = 0;
  ra1 = ra2 = rb1 = rb2 = 0; rc1 = rd1 = rc2 = rd2 = 0; rn = 0; rg = 0; sn = 1; prep = 0;
  memset(bf, 0, TEBN); memset(sb, 0, 512);
);
// the hammer's lasting effect on the string (decay, loss, least stiffness), from the model and this key's preparation
function te_model() instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) local(bolt, rub) (
  pm == 0 ? ( md = 1; mf = 0.06; ma = 0; ) :
  pm == 1 ? ( md = 0.8; mf = -0.06; ma = 0; ) :
  pm == 2 ? ( md = 0.6; mf = -0.1; ma = 0; ) :
  pm == 3 ? ( bolt = prep < 0.62; rub = prep > 0.38;
              md = rub ? (bolt ? 0.22 : 0.07) : 0.9; mf = rub ? 0.28 : -0.04; ma = bolt ? 0.78 : 0.15; ) :
  ( md = 0.45; mf = 0.12; ma = 0; );
);
// the control tick (every 32 samples): this string's LFOs, pitch, stiffness, damping, loss; its level; free when silent
function te_tk() instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) local(semi, f, pp, w0, a, dap, dlo, t60, m, fsx, tn, v1, v2, t) (
  v1 = te_lfo(te_p1 + te_o1 * vi / 12, te_s1, 0); v2 = te_lfo(te_p2 + te_o2 * vi / 12, te_s2, 40);
  l1 += (v1 - l1) * te_lk; l2 += (v2 - l2) * te_lk;
  semi = nt + te_bnd + (dn * te_dsp + (te_dsrc ? l2 : l1) * te_ddp + te_crc * (1 + 0.4 * dn)) * 0.01;
  f = 440 * 2 ^ ((semi - 69) / 12); f0 = f;
  pp = srate / f; w0 = TWOPI * f / srate;
  // the tension (the oil-damped knob, and FATE's creep: each string takes its own share)
  tn = min(max(te_tn + te_cr * (1 + 0.4 * dn), 0), 1);
  // the stiffness: the all-pass coefficient (a slack, short string is stiffer; the treble a little more)
  a = te_stf * (1.3 - 0.7 * tn) * (1.25 - 0.5 * te_ln) * (f / 261.6) ^ 0.25;
  a = -min(max(a, ma), 0.9);
  // the felt mute rail (pressed by its LFO)
  m = te_mrl + (1 - te_mrl) * te_mdp * (0.5 + 0.5 * (te_msrc ? l2 : l1)); m = min(max(m, 0), 1);
  // the decay (T60, s) and the loss
  t60 = te_t60b * (0.75 + 0.5 * tn) * (261.6 / f) ^ 0.55 * md * (1 - 0.94 * m);
  fsx = te_fsb - 0.2 * tn + mf + 0.32 * m;
  // its key let go (and the pedal up): the damper
  !hk && !te_ped ? ( t60 = min(t60, te_rel * 4 ^ (te_rdp * (te_rsrc ? l2 : l1))); fsx += 0.12; );
  fsx = te_lossp(min(max(fsx, 0.02), 0.49));
  // the all-passes and the loss filter must leave the line two samples at least
  dap = 2 * kk * te_apd(a, kk * w0); dlo = te_lpd(fsx, w0);
  loop(8, pp - dap - dlo < 2.5 ? ( a *= 0.7; dap = 2 * kk * te_apd(a, kk * w0); ); );
  dlt = min(max(pp - dap - dlo, 2), TEBN - 4);
  // the line: ni whole samples, then a first-order all-pass for the fraction (flat: no loss of its own, whatever the
  // note or the sample rate), its coefficient set for the exact delay at the fundamental
  dl = dlt; sn = 0; ni = floor(dlt - 0.5); t = dlt - ni; af = sin((1 - t) * w0 * 0.5) / sin((1 + t) * w0 * 0.5);
  ap = a; fs = fsx;
  g = exp(-6.9078 / (max(t60, 0.02) * f));
  env = max(pk, env * 0.97); pk = 0;
  env > 3 ? g *= 0.97;                                     // (a safety: never more than it was struck with)
  ho -= 1;
  st == 2 && sw < 0 && ho < 0 && rn <= 0 && env < 0.000002 ? st = 0;
);
// a struck note on a fresh string: it lands on its pitch at once, silent until the hammer strikes
function te_fresh(n) instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) local(t) (
  nt = n; st = 2; memset(bf, 0, TEBN); memset(sb, 0, 512); x1 = 0; w = 0; j = 0; ya = 0;
  // the stiffness sections' spacing: their dispersion spans the first 18 or so partials, whatever the note
  // (as at 48 kHz, scaled to this rate: a whole number of samples plus a fraction, kept by a small all-pass inside)
  kk = min(max(floor(48000 / (36 * 440 * 2 ^ ((n - 69) / 12))) * srate / 48000, 1), 250);
  ki = floor(kk - 0.5); t = kk - ki;
  ki < 1 && t > 1.001 ? ( ki = 1; t = max(kk - 1, 0.3); );   // (below 44.1 kHz: never a section with no whole sample of delay - it fed straight back)
  kc = (1 - t) / (1 + t); d1 = d2 = 0; ei = et = 0; rn = 0; ra1 = ra2 = rb1 = rb2 = 0;
  pk = env = 0; yo = 0; fd = 1; dn = rand(2) - 1; sn = 1; sw = 0;
  t = min(max((n - 64) / 36, -1), 1) * te_spr; gl = cos((t + 1) * 0.25 * $pi); gr = sin((t + 1) * 0.25 * $pi);
  prep = te_h(n * 7 + 3) * 0.5 + 0.5;
  this.te_model(); this.te_tk();
);
// the two modal resonators (the mallet's knock, the tack's zing, the bolts' clang, the rubber's thud): f Hz, T60 s, amp
function te_res(fa, ta, aa, fb, tb, ab) instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) local(r, wa) (
  wa = TWOPI * min(fa, srate * 0.42) / srate; r = exp(-6.9078 / (ta * srate));
  rc1 = 2 * r * cos(wa); rd1 = r * r; ra1 = 0; ra2 = -aa * sin(wa) / r;
  wa = TWOPI * min(max(fb, 20), srate * 0.42) / srate; r = exp(-6.9078 / (max(tb, 0.001) * srate));
  rc2 = 2 * r * cos(wa); rd2 = r * r; rb1 = 0; rb2 = -ab * sin(wa) / r;
  rn = floor(max(ta, tb) * srate * 1.2);
);
// the hammer strikes: its contact (a raised-cosine pulse, en samples), the reflection from the strike point (the same
// pulse inverted eb samples later: the strike position's comb), the tack's bounce, the resonators. PATIENT HANDS: the
// strength and the position vary a little every time
function te_strike() instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) local(pp, v, h, ms, b, bolt, rub) (
  pp = srate / f0;
  v = 1 - te_vs + te_vs * pv;
  v = min(max(v * (1 + te_hv * (rand(2) - 1)), 0.03), 1.2);
  b = te_beta * (1 + te_hb * (rand(2) - 1));
  h = min(max(te_hard + 0.4 * te_vs * (pv - 0.65), 0), 1);
  this.te_model();
  ms = pm == 0 ? 3.4 - 2.3 * h : pm == 1 ? 0.95 - 0.6 * h : pm == 2 ? 0.2 - 0.1 * h : pm == 3 ? 1.7 - 1.1 * h : 0.55 - 0.32 * h;
  // (fractional lengths: the same contact and the same strike point at every sample rate)
  en = max(min(ms * 0.001 * srate, pp * 0.9), 5 * srate / 48000); ew = TWOPI / en;
  eb = max(b * pp, 1);
  ea = v ^ 1.3 * te_mg(pm) * min(sqrt(pp / (2 * en)), 3) * 0.5;
  pm == 2 ? ( ebb = 0.0013 * srate; eab = 0.45 * ea; ) : ( ebb = 0; eab = 0; );
  et = max(eb + en, ebb + en) + 1; ei = 0; ho = 2 + ceil((et + dl) / 32);
  pm == 1 ? this.te_res(700 + 1100 * h, 0.022, 0.25 * v, 1900 + 1400 * h, 0.012, 0.1 * v) :
  pm == 2 ? this.te_res(2300 * (f0 / 261.6) ^ 0.2, 0.3, 0.07 * v, 3380 * (f0 / 261.6) ^ 0.2, 0.18, 0.05 * v) :
  pm == 3 ? (
    bolt = prep < 0.62; rub = prep > 0.38;
    bolt ? this.te_res(te_fold(f0 * 2.41), 1.3, (rub ? 0.1 : 0.2) * v, te_fold(f0 * 3.17), 0.8, (rub ? 0.08 : 0.16) * v) :
           this.te_res(70 + 0.25 * f0, 0.09, 0.45 * v, 140 + 0.4 * f0, 0.05, 0.2 * v);
  ) : rn = 0;
);
// a note for this string: free, the same note (struck again), or stolen (fade, then the new note)
function te_on(n, v, wt, m) instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) (
  // (wt in samples, with a fraction: the hammer lands between samples, the same moment at every sample rate)
  st == 0 ? ( pm = m; pv = v; this.te_fresh(n); sw = floor(wt); eo = wt - sw; ) :
  st == 2 && nt == n ? ( sw = floor(wt); eo = wt - sw; pv = v; pm = m; ) :
  ( st = 4; pn = n; pv = v; pw = wt; pm = m; );
  hk = 1; age = te_age; te_age += 1;
);
function te_key() instance(st, nt, pn) ( st == 4 ? pn : nt; );
// one sample of the string
function te_run() instance(st, nt, vi, bf, w, dl, dlt, ddl, g, fs, ap, x1, sb, j, kk, ei, et, en, ew, ea, eb, ec, ebb, eab, sw, pv, pm, pn, pw, hk, fd, pk, env, yo, gl, gr, age, dn, l1, l2, f0, md, mf, ma, ra1, ra2, rc1, rd1, rb1, rb2, rc2, rd2, rn, rg, sn, prep, ho, ni, af, ya, ki, kc, d1, d2, eo) local(a, y, v, t, k) (
  y = af * (bf[(w - ni) & TEBM] - ya) + bf[(w - ni - 1) & TEBM]; ya = y;
  x1 = y + fs * (x1 - y); v = g * x1;                      // the loss (a one-pole low-pass)
  // the stiffness: two all-passes (a + z^-kk) / (1 + a z^-kk), one-multiplier lattices
  a = kc * (sb[(j - ki) & 255] - d1) + sb[(j - ki - 1) & 255]; d1 = a; t = v - ap * a; sb[j] = t; v = ap * t + a;
  a = kc * (sb[256 + ((j - ki) & 255)] - d2) + sb[256 + ((j - ki - 1) & 255)]; d2 = a;
  t = v - ap * a; abs(t) < 0.000000000001 ? t = 0; sb[256 + j] = t; v = ap * t + a;
  j = (j + 1) & 255;
  v += te_cx * (te_brp - yo);                              // the bridge: the other strings, a little
  sw >= 0 ? ( sw -= 1; sw < 0 ? this.te_strike(); );
  ei < et ? (
    k = ei - eo; t = k >= 0 && k < en ? ea * (0.5 - 0.5 * cos(k * ew)) : 0;
    k = ei - eo - eb; k >= 0 && k < en ? t -= ea * ec * (0.5 - 0.5 * cos(k * ew));
    k = ei - eo - ebb; eab > 0 && k >= 0 && k < en ? t += eab * (0.5 - 0.5 * cos(k * ew));
    v += t; ei += 1;
  );
  abs(v) < 0.000000000001 ? v = 0;
  bf[w] = v; w = (w + 1) & TEBM;
  yo = y; t = abs(y); t > pk ? pk = t;
  rn > 0 ? (
    t = rc1 * ra1 - rd1 * ra2; ra2 = ra1; ra1 = t; k = rc2 * rb1 - rd2 * rb2; rb2 = rb1; rb1 = k;
    y += t + k; rn -= 1;
  );
  st == 4 ? (
    fd -= te_fdk;
    fd <= 0 ? ( this.te_fresh(pn); sw = floor(pw); eo = pw - sw; y = 0; ) : y *= fd * fd * (3 - 2 * fd);
  );
  y;
);

// ---------- the voices: dispatch by number ----------
function te_vst(i) ( i == 0 ? tv0.st : i == 1 ? tv1.st : i == 2 ? tv2.st : i == 3 ? tv3.st : i == 4 ? tv4.st : i == 5 ? tv5.st : i == 6 ? tv6.st : i == 7 ? tv7.st : i == 8 ? tv8.st : i == 9 ? tv9.st : i == 10 ? tv10.st : tv11.st; );
function te_venv(i) ( i == 0 ? tv0.env : i == 1 ? tv1.env : i == 2 ? tv2.env : i == 3 ? tv3.env : i == 4 ? tv4.env : i == 5 ? tv5.env : i == 6 ? tv6.env : i == 7 ? tv7.env : i == 8 ? tv8.env : i == 9 ? tv9.env : i == 10 ? tv10.env : tv11.env; );
function te_vage(i) ( i == 0 ? tv0.age : i == 1 ? tv1.age : i == 2 ? tv2.age : i == 3 ? tv3.age : i == 4 ? tv4.age : i == 5 ? tv5.age : i == 6 ? tv6.age : i == 7 ? tv7.age : i == 8 ? tv8.age : i == 9 ? tv9.age : i == 10 ? tv10.age : tv11.age; );
function te_vhk(i) ( i == 0 ? tv0.hk : i == 1 ? tv1.hk : i == 2 ? tv2.hk : i == 3 ? tv3.hk : i == 4 ? tv4.hk : i == 5 ? tv5.hk : i == 6 ? tv6.hk : i == 7 ? tv7.hk : i == 8 ? tv8.hk : i == 9 ? tv9.hk : i == 10 ? tv10.hk : tv11.hk; );
function te_von(i, n, v, wt, m) ( i == 0 ? tv0.te_on(n, v, wt, m) : i == 1 ? tv1.te_on(n, v, wt, m) : i == 2 ? tv2.te_on(n, v, wt, m) : i == 3 ? tv3.te_on(n, v, wt, m) : i == 4 ? tv4.te_on(n, v, wt, m) : i == 5 ? tv5.te_on(n, v, wt, m) : i == 6 ? tv6.te_on(n, v, wt, m) : i == 7 ? tv7.te_on(n, v, wt, m) : i == 8 ? tv8.te_on(n, v, wt, m) : i == 9 ? tv9.te_on(n, v, wt, m) : i == 10 ? tv10.te_on(n, v, wt, m) : tv11.te_on(n, v, wt, m); );
function te_voff(i) ( i == 0 ? tv0.hk = 0 : i == 1 ? tv1.hk = 0 : i == 2 ? tv2.hk = 0 : i == 3 ? tv3.hk = 0 : i == 4 ? tv4.hk = 0 : i == 5 ? tv5.hk = 0 : i == 6 ? tv6.hk = 0 : i == 7 ? tv7.hk = 0 : i == 8 ? tv8.hk = 0 : i == 9 ? tv9.hk = 0 : i == 10 ? tv10.hk = 0 : tv11.hk = 0; );
function te_vk(i) ( i == 0 ? tv0.te_key() : i == 1 ? tv1.te_key() : i == 2 ? tv2.te_key() : i == 3 ? tv3.te_key() : i == 4 ? tv4.te_key() :
  i == 5 ? tv5.te_key() : i == 6 ? tv6.te_key() : i == 7 ? tv7.te_key() : i == 8 ? tv8.te_key() : i == 9 ? tv9.te_key() :
  i == 10 ? tv10.te_key() : tv11.te_key(); );
function te_vpm(i) ( i == 0 ? tv0.pm : i == 1 ? tv1.pm : i == 2 ? tv2.pm : i == 3 ? tv3.pm : i == 4 ? tv4.pm : i == 5 ? tv5.pm :
  i == 6 ? tv6.pm : i == 7 ? tv7.pm : i == 8 ? tv8.pm : i == 9 ? tv9.pm : i == 10 ? tv10.pm : tv11.pm; );
// play a note: the string already on that key, else a free one, else the quietest released one, else the oldest
function te_play(n, v, wt) local(i, pick, best) (
  n = min(max(n, 21), 108);
  pick = -1; i = 0; loop(12, pick < 0 && te_vst(i) && te_vk(i) == n ? pick = i; i += 1; );
  pick < 0 ? ( i = 0; loop(12, pick < 0 && te_vst(i) == 0 ? pick = i; i += 1; ); );
  pick < 0 ? ( best = 1000000; i = 0; loop(12, te_vst(i) == 2 && !te_vhk(i) && te_venv(i) < best ? ( best = te_venv(i); pick = i; ); i += 1; ); );
  pick < 0 ? ( best = 1000000000000; i = 0; loop(12, te_vst(i) != 4 && te_vage(i) < best ? ( best = te_vage(i); pick = i; ); i += 1; ); );
  pick < 0 ? pick = 0;
  te_von(pick, n, v, wt, te_hm);
);
function te_release(n) local(i) ( i = 0; loop(12, te_vst(i) && te_vk(i) == n ? te_voff(i); i += 1; ); );
// AUTOHARP: the chord bar (the pitch classes held) and the strum across its strings
function te_hmask() local(i, m) ( m = 0; i = 0; loop(te_nh, m |= (2 ^ (TEHN[i] % 12)); i += 1; ); m; );
function te_strum() local(lo, i, n, k, cnt, m, wt) (
  te_nh > 0 ? (
    m = te_hmask(); lo = 128; i = 0; loop(te_nh, lo = min(lo, TEHN[i]); i += 1; );
    // the strings: upward from the lowest key held, every note of the chord, STRINGS of them
    cnt = 0; n = lo; while (cnt < te_nstr && n <= 108) ( (m & (2 ^ (n % 12))) ? ( TETMP[100 + cnt] = n; cnt += 1; ); n += 1; );
    k = 0;
    loop(cnt,
      i = te_sdir ? cnt - 1 - k : k;
      wt = (k * te_strum + rand(1) * te_hw * 0.4) * srate;
      te_play(TETMP[100 + i], te_svel * (0.9 + 0.1 * rand(1)), wt);
      k += 1;
    );
    te_sdir = !te_sdir;
  );
);
function te_hdamp() local(i, m) (                          // the felt drops on the strings no longer in the chord
  m = te_hmask(); i = 0;
  loop(12, te_vst(i) && te_vpm(i) == 4 && !(m & (2 ^ (te_vk(i) % 12))) ? te_voff(i); i += 1; );
);

// ---------- the reverb's lines ----------
function te_rl(base, n, gn, m) instance(z) local(rp, ri, f, d) (
  m != 0 ? ( rp = te_rw - n - m; ri = floor(rp); f = rp - ri; d = base[ri & TERM]; d += (base[(ri + 1) & TERM] - d) * f; ) :
           d = base[(te_rw - n) & TERM];
  z += (d - z) * te_rdmp;
  z * gn;
);
function te_ap(base, n, x, k) instance(wp) local(d, v) (
  d = base[(wp - n) & TEAPM]; v = x + k * d; abs(v) < 0.000000000001 ? v = 0; base[wp] = v; wp = (wp + 1) & TEAPM;
  d - k * v;
);

// ---------- parameters ----------
function te_update() local(t) (
  te_tnt = slider1 / 100; te_stft = (slider2 / 100) ^ 1.5 * 0.95; te_lnt = slider3 / 100;
  te_hm = floor(slider4 + 0.5); te_hard = slider5 / 100; te_beta = slider6 / 100; te_vs = slider7 / 100;
  te_strum = slider8 / 1000; te_nstr = floor(slider9 + 0.5);
  te_cx = slider10 / 100 * 0.0011 * (te_hm == 4 ? 2 : 1); te_spr = slider11 / 100;
  te_r1 = slider12; te_s1 = floor(slider13 + 0.5); te_o1 = slider14 / 100;
  te_r2 = slider15; te_s2 = floor(slider16 + 0.5); te_o2 = slider17 / 100;
  te_dspt = slider18; te_ddpt = slider19; te_dsrc = slider20 >= 0.5;
  te_mrlt = slider21 / 100; te_mdpt = slider22 / 100; te_msrc = slider23 >= 0.5;
  te_relt = slider24; te_rdpt = slider25 / 100; te_rsrc = slider26 >= 0.5;
  te_vin = slider27 >= 0.5; te_vr = slider28; te_vdc = slider29; te_vsh = floor(slider30 + 0.5); te_vph = slider31 / 360;
  te_vsy = slider32 >= 0.5;
  te_tin = slider33 >= 0.5; te_tr = slider34; te_tdp = slider35 / 100; te_tsh = floor(slider36 + 0.5); te_tph = slider37 / 360;
  te_tsy = floor(slider38 + 0.5);
  te_rin = slider39 >= 0.5; te_rdec = slider40; te_rsz = slider41 / 100;
  te_rdmp = 1 - exp(-TWOPI * min(7000 * 2 ^ (-3 * slider42 / 100), srate * 0.45) / srate);
  te_pdn = min(floor(slider43 * 0.001 * srate), TEPDM - 2); te_rmdt = slider44 / 100 * 14 * srate / 48000;
  te_rmix = slider45 / 100;
  // CHORUS, DELAY
  te_cin = slider57 >= 0.5; te_crt = slider58; te_cdpt = slider59 / 100; te_cmixt = slider60 / 100;
  te_din = slider61 >= 0.5; te_dsy = slider62 >= 0.5; t = floor(slider64 + 0.5);
  t = t == 0 ? 0.25 : t == 1 ? 1 / 3 : t == 2 ? 0.5 : t == 3 ? 0.75 : t == 4 ? 2 / 3 : t == 5 ? 1 : t == 6 ? 1.5 : t == 7 ? 2 : t == 8 ? 3 :
      (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  te_dtt = min(max((te_dsy ? t * 60 / (tempo > 0 ? tempo : 120) : slider63 * 0.001) * srate, 8), TEDM - 8);
  te_dfbt = slider65 / 100; te_dtc = 1 - exp(-TWOPI * min(700 * 2 ^ (slider66 / 100 * 4.5), srate * 0.45) / srate);
  te_dmixt = slider67 / 100; te_dppt = slider68 >= 0.5;
  // the lines' lengths (ms, mutually prime-ish), scaled by SIZE
  t = srate / 1000 * (0.55 + 1.3 * te_rsz);
  TETMP[180] = min(37.1 * t, TERN - 40); TETMP[181] = min(41.3 * t, TERN - 40); TETMP[182] = min(47.9 * t, TERN - 40);
  TETMP[183] = min(53.3 * t, TERN - 40); TETMP[184] = min(59.7 * t, TERN - 40); TETMP[185] = min(67.1 * t, TERN - 40);
  TETMP[186] = min(73.9 * t, TERN - 40); TETMP[187] = min(81.7 * t, TERN - 40);
  te_fa = slider46 / 50;                                   // FATE: 1 = the standard amount
  te_hv = 0.1 * te_fa; te_hb = 0.25 * te_fa; te_hw = 0.012 * te_fa;   // PATIENT HANDS: strength, position, timing
  te_volt = 10 ^ (slider47 / 20) * sqr(slider48 / 100) * 1.5; te_chan = floor(slider49 + 0.5); te_brng = slider50;
  ins_output_setup(51);   // output stage: CLIP, always on
);

function te_clear() (
  tv0.te_init(TEB + 0 * TEBN, 0);
tv1.te_init(TEB + 1 * TEBN, 1);
tv2.te_init(TEB + 2 * TEBN, 2);
tv3.te_init(TEB + 3 * TEBN, 3);
tv4.te_init(TEB + 4 * TEBN, 4);
tv5.te_init(TEB + 5 * TEBN, 5);
tv6.te_init(TEB + 6 * TEBN, 6);
tv7.te_init(TEB + 7 * TEBN, 7);
tv8.te_init(TEB + 8 * TEBN, 8);
tv9.te_init(TEB + 9 * TEBN, 9);
tv10.te_init(TEB + 10 * TEBN, 10);
tv11.te_init(TEB + 11 * TEBN, 11);
  memset(TEVL, 0, 2 * 10000); memset(TEPD, 0, 16384); memset(TEAP, 0, 4 * TEAPN); memset(TERV, 0, 8 * TERN);
  tr0.z = tr1.z = tr2.z = tr3.z = tr4.z = tr5.z = tr6.z = tr7.z = 0;
  memset(TECL, 0, 2 * 8192); memset(TEDL, 0, 2 * 524288); te_dfl = te_dfr = 0;
  te_brp = te_br = te_brl = 0; te_nh = 0; te_spend = 0; te_dcxl = te_dcxr = te_dcyl = te_dcyr = 0; te_rsil = 0;
);
function te_srinit() (
  te_sr = srate; ost_init(20000);
  te_lk = 1 - exp(-32 / (0.05 * srate));                   // (the strings' LFO values, smoothed: 50 ms)
  te_ok = 1 - exp(-32 / (0.5 * srate));                    // the oil-damped knobs: about half a second
  te_gk = 1 - exp(-32 / (1.0 * srate));                    // the slow-glide faders: about a second
  te_sk = 1 - exp(-32 / (0.02 * srate));                   // other controls: 20 ms
  te_vk = 1 - exp(-32 / (0.4 * srate));                    // the vibrato in / out: 0.4 s
  te_ek = 1 - exp(-32 / (0.12 * srate));                   // the chorus and the delay in / out: 120 ms
  te_bhk = 1 - exp(-TWOPI * 80 / srate);
  te_fdk = 1 / (0.005 * srate);                            // a stolen string fades out in 5 ms
  te_sm = 1 - exp(-1 / (0.03 * srate));
  te_cbase = 0.011 * srate; te_cdep = 0.0055 * srate;       // the chorus: 11 ms, swinging up to 5.5 ms
  te_dsk = 1 - exp(-1 / (0.3 * srate));                    // the delay time glides (about 0.3 s, like tape)
  te_pcdn = 1 / (0.012 * srate); te_pcup = 1 / (0.02 * srate);   // preset change: 12 ms out, 20 ms in
  TETMP[190] = min(floor(4.77 * srate / 1000), TEAPN - 2); TETMP[191] = min(floor(3.59 * srate / 1000), TEAPN - 2);
  TETMP[192] = min(floor(12.73 * srate / 1000), TEAPN - 2); TETMP[193] = min(floor(9.31 * srate / 1000), TEAPN - 2);
  te_update();
  te_first = 1;
);

ins_drift_init();
te_dc1.drift_init(0.8 + rand(1) * 0.5); te_dc2.drift_init(0.8 + rand(1) * 0.5);
tv0.te_init(TEB + 0 * TEBN, 0);
tv1.te_init(TEB + 1 * TEBN, 1);
tv2.te_init(TEB + 2 * TEBN, 2);
tv3.te_init(TEB + 3 * TEBN, 3);
tv4.te_init(TEB + 4 * TEBN, 4);
tv5.te_init(TEB + 5 * TEBN, 5);
tv6.te_init(TEB + 6 * TEBN, 6);
tv7.te_init(TEB + 7 * TEBN, 7);
tv8.te_init(TEB + 8 * TEBN, 8);
tv9.te_init(TEB + 9 * TEBN, 9);
tv10.te_init(TEB + 10 * TEBN, 10);
tv11.te_init(TEB + 11 * TEBN, 11);
te_age = 0; te_ct = 31; te_pcf = 0; te_pcg = 1; te_ped = 0; te_bnd = te_bndt = 0; te_nh = 0; te_sdir = 0; te_spend = 0;
te_p1 = 0; te_p2 = 0.37; te_vp = 0; te_tp = 0; te_vg = te_tg = te_rg = 0; te_rw = 0; te_vw = 0; te_rsil = 0;
te_vdl = te_vdr = 0; te_vdi = te_vdri = 0; te_vA = 0; te_tgl = te_tgr = 1; te_tgli = te_tgri = 0; te_cr = te_crc = 0;
te_rp1 = 0; te_rp2 = 0.25; te_cc = 1; te_cs = 0; te_cg = te_dg = 0; te_cw = te_dw = 0; te_dfl = te_dfr = 0; te_dts = -1;
te_srinit();
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
!te_pcf && !te_panic ? te_update();

@block
prs_chk();
srate != te_sr ? te_srinit();
// a preset change: the old sound fades out (12 ms), everything is cleared at the silent point, then it fades in (20 ms)
te_panic && !te_pcf ? ( te_pcf = 1; te_panic = 0; );
te_pcf == 2 ? ( te_clear(); te_first = 1; te_pcf = 3; );
te_pcf != 1 ? te_update();

// ---------- MIDI ----------
te_nact = 0; i_ = 0; loop(12, te_vst(i_) ? te_nact += 1; i_ += 1; );
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, te_chan) && te_pcf == 0 ? (
    te_st = m1 & 0xF0;
    te_st == 0x90 && m3 > 0 ? (
      ins_midi_hit();
      te_nact == 0 ? ( te_vsy ? te_vp = 0; te_tsy == 1 ? te_tp = 0; );   // KEY sync: from the zero point after silence
      te_hm == 4 ? (
        // AUTOHARP: the key joins the chord bar; the strum waits a moment for the rest of the chord
        i_ = 0; j_ = 0; loop(te_nh, TEHN[i_] != m2 ? ( TEHN[j_] = TEHN[i_]; j_ += 1; ); i_ += 1; ); te_nh = j_;
        te_nh < 32 ? ( TEHN[te_nh] = m2; te_nh += 1; );
        te_svel = m3 / 127; te_spend = 1; te_scnt = floor(0.018 * srate) + mofs;
      ) : (
        te_play(m2, m3 / 127, mofs + rand(1) * te_hw * srate);
      );
      te_nact += 1;
    ) : te_st == 0x80 || (te_st == 0x90 && m3 == 0) ? (
      te_hm == 4 ? (
        i_ = 0; j_ = 0; loop(te_nh, TEHN[i_] != m2 ? ( TEHN[j_] = TEHN[i_]; j_ += 1; ); i_ += 1; ); te_nh = j_;
        te_hdamp();
      );
      te_release(m2);
    ) : te_st == 0xE0 ? (
      te_bndt = (((m3 * 128 + m2) - 8192) / 8192) * te_brng;
    ) : te_st == 0xB0 ? (
      m2 == 64 ? te_ped = m3 >= 64 :
      m2 == 120 || m2 == 123 ? ( te_nh = 0; te_spend = 0; i_ = 0; loop(12, te_voff(i_); i_ += 1; ); );
    );
  );
  midisend(mofs, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( te_nh = 0; te_spend = 0; i_ = 0; loop(12, te_voff(i_); i_ += 1; ); );
gfx_pst_prev = gfx_pst;
// AUTOHARP: the strum, once the chord has been gathered
te_spend ? ( te_scnt -= samplesblock; te_scnt <= 0 ? ( te_spend = 0; te_strum(); ); );

// ---------- FATE: tension creep (minutes) ----------
ins_drift_block(te_fa * 0.25, samplesblock);
te_cr = (te_dc1.drift_tick(0.011 * samplesblock / srate) * 0.75 + te_dc2.drift_tick(0.027 * samplesblock / srate) * 0.25) * 0.12 * te_fa;
te_crc = te_cr * 25;                                       // (a relaxed string sags flat: +/-3 cents at the standard amount)

// ---------- the slow LFOs, the vibrato and tremolo phases ----------
te_p1 += te_r1 * samplesblock / srate; te_p1 -= floor(te_p1);
te_p2 += te_r2 * samplesblock / srate; te_p2 -= floor(te_p2);
te_rp1 += 0.31 * samplesblock / srate; te_rp1 -= floor(te_rp1); te_rp2 += 0.47 * samplesblock / srate; te_rp2 -= floor(te_rp2);
// the reverb switched fully out: its lines are emptied, so switching it back in starts clean
te_rg > 0.0001 ? te_ract = 1 : te_ract ? ( memset(TERV, 0, 8 * TERN); memset(TEAP, 0, 4 * TEAPN); tr0.z = tr1.z = tr2.z = tr3.z = tr4.z = tr5.z = tr6.z = tr7.z = 0; te_ract = 0; );
abs(te_dcyl) + abs(te_dcyr) < 0.0000000001 ? te_dcyl = te_dcyr = 0;
// the chorus's phasor (it stays on its circle); the delay switched fully out is emptied, so it comes back clean
te_t = TWOPI * te_crt / srate; te_ccw = cos(te_t); te_csw = sin(te_t);
te_t = sqrt(te_cc * te_cc + te_cs * te_cs); te_cc /= te_t; te_cs /= te_t;
te_dg > 0.0001 ? te_dact = 1 : te_dact ? ( memset(TEDL, 0, 2 * 524288); te_dfl = te_dfr = 0; te_dact = 0; );
abs(te_dfl) + abs(te_dfr) < 0.0000000001 ? te_dfl = te_dfr = 0;
te_dts < 0 ? te_dts = te_dtt;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the control tick (every 32 samples) ----------
te_ct += 1;
te_ct >= 32 ? (
  te_ct = 0;
  te_first ? (
    te_tn = te_tnt; te_stf = te_stft; te_ln = te_lnt; te_dsp = te_dspt; te_ddp = te_ddpt; te_mrl = te_mrlt; te_mdp = te_mdpt;
    te_rel = te_relt; te_rdp = te_rdpt; te_vol = te_volt; te_bnd = te_bndt;
    te_n0 = TETMP[180]; te_n1 = TETMP[181]; te_n2 = TETMP[182]; te_n3 = TETMP[183];
    te_n4 = TETMP[184]; te_n5 = TETMP[185]; te_n6 = TETMP[186]; te_n7 = TETMP[187];
    te_first = 0;
  );
  // the oil-damped knobs; the slow-glide faders; the bend
  te_tn += (te_tnt - te_tn) * te_ok; te_stf += (te_stft - te_stf) * te_ok; te_ln += (te_lnt - te_ln) * te_ok;
  te_dsp += (te_dspt - te_dsp) * te_gk; te_ddp += (te_ddpt - te_ddp) * te_gk; te_mrl += (te_mrlt - te_mrl) * te_gk;
  te_mdp += (te_mdpt - te_mdp) * te_gk; te_rel += (te_relt - te_rel) * te_gk; te_rdp += (te_rdpt - te_rdp) * te_gk;
  te_bnd += (te_bndt - te_bnd) * te_sk;
  te_t60b = 1.5 + 18 * te_ln ^ 1.4; te_fsb = 0.34 - 0.1 * te_ln;
  // the strings
  tv0.st ? tv0.te_tk();
  tv1.st ? tv1.te_tk();
  tv2.st ? tv2.te_tk();
  tv3.st ? tv3.te_tk();
  tv4.st ? tv4.te_tk();
  tv5.st ? tv5.te_tk();
  tv6.st ? tv6.te_tk();
  tv7.st ? tv7.te_tk();
  tv8.st ? tv8.te_tk();
  tv9.st ? tv9.te_tk();
  tv10.st ? tv10.te_tk();
  tv11.st ? tv11.te_tk();
  // VIBRATO: two delay taps (the right one PHASE on); the depth in cents at the rate (the swing glides)
  // IN / OUT: the whole delay glides from nothing (the dry signal itself) to the vibrato and back, over 0.4 s
  te_vg += (te_vin - te_vg) * te_vk; te_vg < 0.0005 && !te_vin ? te_vg = 0;
  te_vp += te_vr * 32 / srate; te_vp -= floor(te_vp);
  te_vAt = min((2 ^ (te_vdc / 1200) - 1) * srate / (TWOPI * te_vr), 0.035 * srate);
  te_vA += (te_vAt - te_vA) * te_ok;
  te_t = (te_vA + 3 + te_vA * te_mlfo(te_vp, te_vsh, 7)) * te_vg; te_vdi = (te_t - te_vdl) * TEK;
  te_t = (te_vA + 3 + te_vA * te_mlfo(te_vp + te_vph, te_vsh, 7)) * te_vg; te_vdri = (te_t - te_vdr) * TEK;
  // TREMOLO (SYNC VIBRATO: at the vibrato's own rate and phase)
  te_tg += (te_tin - te_tg) * te_sk; te_tg < 0.0001 && !te_tin ? te_tg = 0;
  te_tsy == 2 ? te_tp = te_vp : ( te_tp += te_tr * 32 / srate; te_tp -= floor(te_tp); );
  te_t = 1 - te_tdp * te_tg * (0.5 - 0.5 * te_mlfo(te_tp, te_tsh, 13)); te_tgli = (te_t - te_tgl) * TEK;
  te_t = 1 - te_tdp * te_tg * (0.5 - 0.5 * te_mlfo(te_tp + te_tph, te_tsh, 13)); te_tgri = (te_t - te_tgr) * TEK;
  // REVERB: the lines' lengths glide, their gains follow DECAY, four of them swim
  te_rg += (te_rin - te_rg) * te_sk; te_rg < 0.0001 && !te_rin ? te_rg = 0;
  te_n0 += (TETMP[180] - te_n0) * te_sk * 0.1; te_n1 += (TETMP[181] - te_n1) * te_sk * 0.1; te_n2 += (TETMP[182] - te_n2) * te_sk * 0.1;
  te_n3 += (TETMP[183] - te_n3) * te_sk * 0.1; te_n4 += (TETMP[184] - te_n4) * te_sk * 0.1; te_n5 += (TETMP[185] - te_n5) * te_sk * 0.1;
  te_n6 += (TETMP[186] - te_n6) * te_sk * 0.1; te_n7 += (TETMP[187] - te_n7) * te_sk * 0.1;
  te_t = -3 / (te_rdec * srate);
  te_g0 = 10 ^ (te_t * te_n0); te_g1 = 10 ^ (te_t * te_n1); te_g2 = 10 ^ (te_t * te_n2); te_g3 = 10 ^ (te_t * te_n3);
  te_g4 = 10 ^ (te_t * te_n4); te_g5 = 10 ^ (te_t * te_n5); te_g6 = 10 ^ (te_t * te_n6); te_g7 = 10 ^ (te_t * te_n7);
  te_i1 = floor(te_n1); te_i3 = floor(te_n3); te_i5 = floor(te_n5); te_i7 = floor(te_n7);
  te_rmd += (te_rmdt - te_rmd) * te_sk;
  te_m0 = te_rmd * (1 + sin(TWOPI * te_rp1)); te_m1 = te_rmd * (1 + cos(TWOPI * te_rp1));
  te_m2 = te_rmd * (1 + sin(TWOPI * te_rp2)); te_m3 = te_rmd * (1 + cos(TWOPI * te_rp2));
  te_rwet = te_rmix * te_rg * 0.9; te_rdry = 1 - 0.45 * te_rmix * te_rg;
  // CHORUS, DELAY: IN / OUT glide, their settings glide
  te_cg += (te_cin - te_cg) * te_ek; te_cg < 0.0001 && !te_cin ? te_cg = 0;
  te_cdp += (te_cdpt - te_cdp) * te_sk; te_cmix += (te_cmixt - te_cmix) * te_sk;
  te_dg += (te_din - te_dg) * te_ek; te_dg < 0.0001 && !te_din ? te_dg = 0;
  te_dfb += (te_dfbt - te_dfb) * te_sk; te_dmix += (te_dmixt - te_dmix) * te_sk; te_dpp += (te_dppt - te_dpp) * te_sk;
);

// ---------- the twelve strings ----------
te_L = te_R = 0; te_br = 0;
tv0.st ? ( te_y = tv0.te_run(); te_L += te_y * tv0.gl; te_R += te_y * tv0.gr; te_br += tv0.yo; );
tv1.st ? ( te_y = tv1.te_run(); te_L += te_y * tv1.gl; te_R += te_y * tv1.gr; te_br += tv1.yo; );
tv2.st ? ( te_y = tv2.te_run(); te_L += te_y * tv2.gl; te_R += te_y * tv2.gr; te_br += tv2.yo; );
tv3.st ? ( te_y = tv3.te_run(); te_L += te_y * tv3.gl; te_R += te_y * tv3.gr; te_br += tv3.yo; );
tv4.st ? ( te_y = tv4.te_run(); te_L += te_y * tv4.gl; te_R += te_y * tv4.gr; te_br += tv4.yo; );
tv5.st ? ( te_y = tv5.te_run(); te_L += te_y * tv5.gl; te_R += te_y * tv5.gr; te_br += tv5.yo; );
tv6.st ? ( te_y = tv6.te_run(); te_L += te_y * tv6.gl; te_R += te_y * tv6.gr; te_br += tv6.yo; );
tv7.st ? ( te_y = tv7.te_run(); te_L += te_y * tv7.gl; te_R += te_y * tv7.gr; te_br += tv7.yo; );
tv8.st ? ( te_y = tv8.te_run(); te_L += te_y * tv8.gl; te_R += te_y * tv8.gr; te_br += tv8.yo; );
tv9.st ? ( te_y = tv9.te_run(); te_L += te_y * tv9.gl; te_R += te_y * tv9.gr; te_br += tv9.yo; );
tv10.st ? ( te_y = tv10.te_run(); te_L += te_y * tv10.gl; te_R += te_y * tv10.gr; te_br += tv10.yo; );
tv11.st ? ( te_y = tv11.te_run(); te_L += te_y * tv11.gl; te_R += te_y * tv11.gr; te_br += tv11.yo; );
// the bridge carries no DC or rumble (every string resonates there): high-passed at about 80 Hz
te_brl += (te_br - te_brl) * te_bhk; te_brp = te_br - te_brl;

// ---------- VIBRATO ----------
TEVL[te_vw] = te_L; TEVR[te_vw] = te_R;
te_vg > 0 ? (
  te_vdl += te_vdi; te_vdr += te_vdri;
  te_rp = te_vw - te_vdl; te_ri = floor(te_rp); te_rf = te_rp - te_ri;
  te_a = TEVL[te_ri & TEVM]; te_wl = te_a + (TEVL[(te_ri + 1) & TEVM] - te_a) * te_rf;
  te_rp = te_vw - te_vdr; te_ri = floor(te_rp); te_rf = te_rp - te_ri;
  te_a = TEVR[te_ri & TEVM]; te_wr = te_a + (TEVR[(te_ri + 1) & TEVM] - te_a) * te_rf;
  te_L = te_wl; te_R = te_wr;
);
te_vw = (te_vw + 1) & TEVM;

// ---------- TREMOLO ----------
te_tg > 0 ? (
  te_tgl += te_tgli; te_tgr += te_tgri;
  te_L *= te_tgl; te_R *= te_tgr;
);

// ---------- CHORUS: three voices a side, 120 degrees apart (the right side turned 60 degrees on) ----------
TECL[te_cw] = te_L; TECR[te_cw] = te_R;
te_cg > 0 ? (
  te_t = te_cc * te_ccw - te_cs * te_csw; te_cs = te_cs * te_ccw + te_cc * te_csw; te_cc = te_t;
  te_s1 = te_cs * -0.5 + te_cc * 0.8660254; te_s2 = te_cs * -0.5 - te_cc * 0.8660254;
  te_d = te_cbase + te_cdep * te_cdp * (1 + te_cs);
  te_rp = te_cw - te_d; te_ri = floor(te_rp); te_rf = te_rp - te_ri; te_a = TECL[te_ri & TECM]; te_wl = te_a + (TECL[(te_ri + 1) & TECM] - te_a) * te_rf;
  te_d = te_cbase * 1.21 + te_cdep * te_cdp * (1 + te_s1);
  te_rp = te_cw - te_d; te_ri = floor(te_rp); te_rf = te_rp - te_ri; te_a = TECL[te_ri & TECM]; te_wl += te_a + (TECL[(te_ri + 1) & TECM] - te_a) * te_rf;
  te_d = te_cbase * 1.43 + te_cdep * te_cdp * (1 + te_s2);
  te_rp = te_cw - te_d; te_ri = floor(te_rp); te_rf = te_rp - te_ri; te_a = TECL[te_ri & TECM]; te_wl += te_a + (TECL[(te_ri + 1) & TECM] - te_a) * te_rf;
  te_d = te_cbase * 1.1 + te_cdep * te_cdp * (1 - te_cs);
  te_rp = te_cw - te_d; te_ri = floor(te_rp); te_rf = te_rp - te_ri; te_a = TECR[te_ri & TECM]; te_wr = te_a + (TECR[(te_ri + 1) & TECM] - te_a) * te_rf;
  te_d = te_cbase * 1.32 + te_cdep * te_cdp * (1 - te_s1);
  te_rp = te_cw - te_d; te_ri = floor(te_rp); te_rf = te_rp - te_ri; te_a = TECR[te_ri & TECM]; te_wr += te_a + (TECR[(te_ri + 1) & TECM] - te_a) * te_rf;
  te_d = te_cbase * 1.52 + te_cdep * te_cdp * (1 - te_s2);
  te_rp = te_cw - te_d; te_ri = floor(te_rp); te_rf = te_rp - te_ri; te_a = TECR[te_ri & TECM]; te_wr += te_a + (TECR[(te_ri + 1) & TECM] - te_a) * te_rf;
  te_t = te_cmix * te_cg;
  te_L += (te_wl * 0.4 - te_L * 0.3) * te_t; te_R += (te_wr * 0.4 - te_R * 0.3) * te_t;
);
te_cw = (te_cw + 1) & TECM;

// ---------- DELAY: stereo, or PING-PONG (the input to the left, the repeats crossing); TONE in the feedback ----------
te_dg > 0 ? (
  te_dts += (te_dtt - te_dts) * te_dsk;
  te_rp = te_dw - te_dts; te_ri = floor(te_rp); te_rf = te_rp - te_ri;
  te_a = TEDL[te_ri & TEDM]; te_el = te_a + (TEDL[(te_ri + 1) & TEDM] - te_a) * te_rf;
  te_a = TEDR[te_ri & TEDM]; te_er = te_a + (TEDR[(te_ri + 1) & TEDM] - te_a) * te_rf;
  te_dfl += (te_el - te_dfl) * te_dtc; te_dfr += (te_er - te_dfr) * te_dtc;
  te_x = (te_L + te_R) * 0.5;
  te_a = ((te_L + (te_x - te_L) * te_dpp) * te_dg + te_dfb * (te_dfl + (te_dfr - te_dfl) * te_dpp)) * 0.999;
  TEDL[te_dw] = abs(te_a) < 0.000000000001 ? 0 : te_a;
  te_a = (te_R * (1 - te_dpp) * te_dg + te_dfb * (te_dfr + (te_dfl - te_dfr) * te_dpp)) * 0.999;
  TEDR[te_dw] = abs(te_a) < 0.000000000001 ? 0 : te_a;
  te_t = te_dmix * te_dg; te_L += te_el * te_t; te_R += te_er * te_t;
);
te_dw = (te_dw + 1) & TEDM;

// ---------- REVERB: pre-delay, four diffusers, eight lines (Hadamard) ----------
TEPD[te_pw] = (te_L + te_R) * 0.5; te_x = TEPD[(te_pw - te_pdn) & TEPDM]; te_pw = (te_pw + 1) & TEPDM;
te_rg > 0 && (te_rsil < srate || abs(te_x) > 0.000001) ? (
  te_x = ta0.te_ap(TEAP, TETMP[190], te_x, 0.62); te_x = ta1.te_ap(TEAP + TEAPN, TETMP[191], te_x, 0.62);
  te_x = ta2.te_ap(TEAP + 2 * TEAPN, TETMP[192], te_x, 0.62); te_x = ta3.te_ap(TEAP + 3 * TEAPN, TETMP[193], te_x, 0.62);
  te_y0 = tr0.te_rl(TERV,            te_n0, te_g0, te_m0 + 1);
  te_y1 = tr1.te_rl(TERV + TERN,     te_i1, te_g1, 0);
  te_y2 = tr2.te_rl(TERV + 2 * TERN, te_n2, te_g2, te_m1 + 1);
  te_y3 = tr3.te_rl(TERV + 3 * TERN, te_i3, te_g3, 0);
  te_y4 = tr4.te_rl(TERV + 4 * TERN, te_n4, te_g4, te_m2 + 1);
  te_y5 = tr5.te_rl(TERV + 5 * TERN, te_i5, te_g5, 0);
  te_y6 = tr6.te_rl(TERV + 6 * TERN, te_n6, te_g6, te_m3 + 1);
  te_y7 = tr7.te_rl(TERV + 7 * TERN, te_i7, te_g7, 0);
  te_a0 = te_y0 + te_y1; te_a1 = te_y0 - te_y1; te_a2 = te_y2 + te_y3; te_a3 = te_y2 - te_y3;
  te_a4 = te_y4 + te_y5; te_a5 = te_y4 - te_y5; te_a6 = te_y6 + te_y7; te_a7 = te_y6 - te_y7;
  te_b0 = te_a0 + te_a2; te_b2 = te_a0 - te_a2; te_b1 = te_a1 + te_a3; te_b3 = te_a1 - te_a3;
  te_b4 = te_a4 + te_a6; te_b6 = te_a4 - te_a6; te_b5 = te_a5 + te_a7; te_b7 = te_a5 - te_a7;
  te_ri = te_rw & TERM; te_x *= 0.6;
  TERV[te_ri]            = (te_b0 + te_b4) * 0.35355339 + te_x;
  TERV[TERN + te_ri]     = (te_b1 + te_b5) * 0.35355339 - te_x;
  TERV[2 * TERN + te_ri] = (te_b2 + te_b6) * 0.35355339 + te_x;
  TERV[3 * TERN + te_ri] = (te_b3 + te_b7) * 0.35355339 - te_x;
  TERV[4 * TERN + te_ri] = (te_b0 - te_b4) * 0.35355339 + te_x;
  TERV[5 * TERN + te_ri] = (te_b1 - te_b5) * 0.35355339 - te_x;
  TERV[6 * TERN + te_ri] = (te_b2 - te_b6) * 0.35355339 + te_x;
  TERV[7 * TERN + te_ri] = (te_b3 - te_b7) * 0.35355339 - te_x;
  te_wl = (te_y0 - te_y2 + te_y4 - te_y6) * 0.5; te_wr = (te_y1 - te_y3 + te_y5 - te_y7) * 0.5;
  te_L = te_L * te_rdry + te_wl * te_rwet; te_R = te_R * te_rdry + te_wr * te_rwet;
  abs(te_x) + abs(te_wl) + abs(te_wr) < 0.000001 ? te_rsil += 1 : te_rsil = 0;
);
te_rw = (te_rw + 1) & TERM;

// DC block
te_dcyl = te_L - te_dcxl + 0.9997 * te_dcyl; te_dcxl = te_L; te_L = te_dcyl;
te_dcyr = te_R - te_dcxr + 0.9997 * te_dcyr; te_dcxr = te_R; te_R = te_dcyr;

// ---------- MASTER ----------
te_pcf == 1 ? ( te_pcg -= te_pcdn; te_pcg <= 0 ? ( te_pcg = 0; te_pcf = 2; ); ) :
te_pcf == 3 ? ( te_pcg += te_pcup; te_pcg >= 1 ? ( te_pcg = 1; te_pcf = 0; ); );
te_vol += (te_volt - te_vol) * te_sm;
te_L *= te_pcg * te_vol; te_R *= te_pcg * te_vol;
te_L = ostL.ost_band(te_L); te_R = ostR.ost_band(te_R);
ost_out(te_L, te_R);
spl0 = ost_l; spl1 = ost_r;
te_pk = max(te_pk, max(abs(spl0), abs(spl1)));

@gfx 1200 850
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 5; ui_hw = 1;
ui_begin(1200, 850);

// ---------- the card's colours: weathered lead-grey / mercury-silver aluminium, the phosphor-green oscilloscope ----------
// THE COLOURWAY: oxidised copper / verdigris - a weathered verdigris face, oxidised-copper title bands, copper caps.
// (Other colourways tried, kept as data: lead-grey FACE A3A8AC TRAY 989DA2 LEAD 30363B MERC D9DDE0; indigo FACE 2B3050
// LEAD 15182A MERC CBD0DB, light labels; parchment FACE D8CEB6 LEAD 1C1C1A MERC B9B1A0; umber FACE 684830 LEAD 2D1C0F
// MERC D6AB3E, light labels.) The scope's phosphor green is fixed.
FACE = 0x5F8F80; FACEL = 0x93BBAD; FACED = 0x456E62; TRAY = 0x6A9A8B; ETCH = 0x2C4C43; BRD = 0x1E3A32;
LEAD = 0x5B3A26; LEADL = 0x8C5C3B; LEADD = 0x3A2417; INK = 0x0F1513; LBL = 0x0E1D18; CHL = 0xF3DCC6; MERC = 0xD38C5B;
KEYOFF = 0x3A2A20; KEYHOV = 0x5A4130; KEYT = 0xF3DCC6; PLATE = FACEL;
GRN = 0x4CF58A; GRNL = 0xC2FFD8; GRND = 0x1E9A50; GRNF = 0x0D3A20; SCR = 0x040D07; SCRH = 0x0C2214;

// fonts, calibrated once per scale (a reference word fills the same width everywhere); large, for reading
sc != tg_calsc ? (
  tg_calsc = sc;
  tg_f11 = ui_fitfont(11, 13 * sc);         // key captions, small print
  tg_f12 = ui_fitfont(12, 15.5 * sc);       // section titles
  tg_f13 = ui_fitfont(13, 14.5 * sc);       // knob labels, values, fields
);
gfx_setfont(11, "Trebuchet MS", tg_f11, 'b'); gfx_setfont(12, "Trebuchet MS", tg_f12, 'b');
gfx_setfont(13, "Trebuchet MS", tg_f13, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');    // the card's name
gfx_setfont(15, "Georgia", 19 * sc, 'b');    // the numeral

// ---------- drawing helpers (base coordinates) ----------
function tg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function tg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function tg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function tg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function tg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function tg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function tg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function tg_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function tg_ln(x1, y1, x2, y2, w) ( tg_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function tg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function tg_ring(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); );
function tg_disc(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
// sparse brushing lines over a box: flat means, no textures
function tg_brush(x, y, w, h, n, seed) local(i, yy, x0, l) (
  i = 0;
  loop(n,
    yy = y + 1 + ui_hash(seed + i * 3.1) * (h - 2); x0 = x + ui_hash(seed + i * 7.7) * w * 0.7;
    l = min(w * (0.15 + 0.6 * ui_hash(seed + i * 1.3)), x + w - x0);
    ui_cola(i & 1 ? 0xFFFFFF : BRD, i & 1 ? 0.22 : 0.08); tg_r(x0, yy, l, 1);
    i += 1;
  );
);
// an etched calibration crosshair
function tg_cross(cx, cy, r) (
  ui_cola(ETCH, 0.75); tg_r(cx - r, cy - 0.5, 2 * r, 1); tg_r(cx - 0.5, cy - r, 1, 2 * r); tg_ring(cx, cy, r * 0.55);
);
// the etched balance: a fulcrum, the beam (tilted by t, -1 .. 1) and two hanging pans
function tg_scales(cx, cy, w, t, col, al) local(a, dx, dy, lx, ly, rx, ry, ph) (
  ui_cola(col, al);
  a = t * 0.22; dx = cos(a) * w * 0.5; dy = sin(a) * w * 0.5; ph = w * 0.32;
  lx = cx - dx; ly = cy - dy; rx = cx + dx; ry = cy + dy;
  tg_ln(cx, cy - 3, cx, cy + w * 0.5, 1); tg_ln(cx - w * 0.14, cy + w * 0.5, cx + w * 0.14, cy + w * 0.5, 1);
  tg_ln(lx, ly, rx, ry, 1.2); tg_disc(cx, cy, 2);
  tg_ln(lx, ly, lx - w * 0.09, ly + ph, 0.8); tg_ln(lx, ly, lx + w * 0.09, ly + ph, 0.8);
  tg_ln(rx, ry, rx - w * 0.09, ry + ph, 0.8); tg_ln(rx, ry, rx + w * 0.09, ry + ph, 0.8);
  gfx_arc(lx * sc, (ly + ph - w * 0.05) * sc, w * 0.12 * sc, 0.5 * $pi + 0.35, 1.5 * $pi - 0.35, 1);
  gfx_arc(rx * sc, (ry + ph - w * 0.05) * sc, w * 0.12 * sc, 0.5 * $pi + 0.35, 1.5 * $pi - 0.35, 1);
);
// a section: an ink frame, the brushed tray, a lead title band ruled in mercury
function tg_sect(x, y, w, h, title) (
  ui_col(INK); tg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  ui_col(TRAY); tg_r(x, y, w, h);
  tg_brush(x, y + 25, w, h - 25, floor(w * h / 1700), x * 0.37 + y * 0.11);
  ui_cola(0xFFFFFF, 0.3); tg_r(x, y + h - 1, w, 1); tg_r(x + w - 1, y + 25, 1, h - 25);
  ui_col(LEAD); tg_r(x, y, w, 24);
  ui_cola(0xFFFFFF, 0.12); tg_r(x, y, w, 1);
  ui_col(MERC); tg_r(x, y + 24, w, 1.5);
  strlen(title) ? ( gfx_setfont(12); ui_col(CHL); tg_t(x + 10, y + 3, title); );
);
function tg_cap(x, y, s) ( gfx_setfont(11); ui_col(LBL); tg_t(x, y, s); );
// the value pill (shown only while a control is touched)
function tg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 4 * sc, 3 * sc);
  ui_col(GRN); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc + 1 * sc, tw + 12 * sc, th + 2 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);

// ---------- the knobs ----------
// big = the heavy oil-damped knob: a flat lead skirt with grip notches, a flat mercury cap; the value arc is where it
// is set, the pointer where the oil has let it go so far (an = that position, 0 .. 1). cap: 1 = a black cap (LPF)
function tg_kcap(cx, cy, r, n, an, bip, big, cap) local(rr, a, a0, ca, sa, w, i, b) (
  rr = r + (big ? 8 : 5) * sc; w = (big ? 3.4 : 2.4) * sc; a0 = -0.75 * $pi;
  ui_cola(INK, 0.45); tg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.1 * sc);
  ui_col(GRND);
  bip ? ( abs(n - 0.5) > 0.004 ? tg_arcw(cx, cy, rr, min(a0 + n * 1.5 * $pi, 0), max(a0 + n * 1.5 * $pi, 0), w); ) :
        ( n > 0.004 ? ( tg_arcw(cx, cy, rr, a0, a0 + n * 1.5 * $pi, w); gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); ); );
  a = a0 + an * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.3); gfx_circle(cx + 1.5 * sc, cy + 2.6 * sc, r, 1, 1);
  big ? (
    ui_col(LEADD); gfx_circle(cx, cy, r, 1, 1);
    i = 0;
    loop(30, b = a + i / 30 * 2 * $pi; ui_col(LEADL);
      tg_lnp(cx + sin(b) * r * 0.8, cy - cos(b) * r * 0.8, cx + sin(b) * (r - 1.2 * sc), cy - cos(b) * (r - 1.2 * sc), 1.3 * sc); i += 1; );
    ui_col(INK); gfx_circle(cx, cy, r * 0.74, 1, 1);
    ui_col(MERC); gfx_circle(cx, cy, r * 0.71, 1, 1);
    ui_cola(0xFFFFFF, 0.5); gfx_arc(cx, cy, r * 0.69, -0.9, 0.5, 1);
    ui_col(INK); tg_lnp(cx + ca * r * 0.14, cy + sa * r * 0.14, cx + ca * r * 0.64, cy + sa * r * 0.64, max(2.6 * sc, r * 0.09));
    ui_col(GRN); gfx_circle(cx + ca * r * 0.88, cy + sa * r * 0.88, max(2.2 * sc, r * 0.07), 1, 1);
  ) : (
    ui_col(INK); gfx_circle(cx, cy, r, 1, 1);
    ui_col(cap == 1 ? 0x3A3F44 : FACEL); gfx_circle(cx, cy, r - 1.2 * sc, 1, 1);
    ui_col(cap == 1 ? 0x101214 : LEAD); gfx_circle(cx, cy, r * 0.76, 1, 1);
    ui_cola(0xFFFFFF, 0.1); gfx_circle(cx, cy, r * 0.76, 0, 1);
    ui_col(CHL); tg_lnp(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * r * 0.7, cy + sa * r * 0.7, max(2 * sc, r * 0.12));
  );
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps. act >= 0: where
// the oil-damped value is now (in the slider's units)
function tg_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp, big, act, cap) local(v, n, an, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - tg_lt < 0.35 && tg_lid == idx && !tg_mv) || (mouse_cap & 4) ? ( tg_set(idx, def); drag_id = -1; tg_lt = 0; ) : (
      drag_id = did; tg_ky = mouse_y; tg_ky0 = mouse_y; tg_mv = 0; tg_lt = time_precise(); tg_lid = idx;
      tg_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !tg_mv && abs(mouse_y - tg_ky0) > 3 * sc ? ( tg_mv = 1; tg_ky = mouse_y; );
  drag_id == did && tg_mv ? (
    tg_kn = min(max(tg_kn + (tg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); tg_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ tg_kn : lo + tg_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? tg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    tg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1);
  an = act >= 0 ? min(max(lg ? log(max(act, lo) / lo) / log(hi / lo) : (act - lo) / (hi - lo), 0), 1) : n;
  tg_kcap(cx * sc, cy * sc, r * sc, n, an, lo < 0 && hi > 0, big, cap);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.13); gfx_circle(cx * sc, cy * sc, r * 0.7 * sc, 1, 1);
    sprintf(#tg_vv, fmt, v);
    tg_pill(cx, cy + r + (big ? 9 : 6), #tg_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(strlen(label) > 9 ? 11 : 13); ui_col(LBL); tg_tc(cx, cy + r + (big ? 21 : 14), label); );
  );
);

// ---------- lit keys (phosphor green = on); returns 1 when clicked ----------
function tg_key(x, y, w, h, on, s) local(hov, hit) (
  hov = tg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(GRNL, 0.38); tg_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.3); tg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); tg_rr(x, y, w, h, 3);
  ui_col(on ? GRN : hov ? KEYHOV : KEYOFF); tg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.45); tg_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.12); tg_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? INK : KEYT); tg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function tg_keys(x, y, w, h, gap, idx, lo, n, labels) local(i) (
  i = 0;
  loop(n, tg_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == lo + i, pk_pitem(labels, i + 1, #tg_k)) ? tg_set(idx, lo + i); i += 1; );
);
function tg_toggle(x, y, w, h, idx, s) ( tg_key(x, y, w, h, slider(idx) >= 0.5, s) ? tg_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// ---------- the drop-down box: the setting in green; a click opens the list (the current one ticked), the wheel steps ----------
function tg_dd(x, y, w, h, idx, lo, n, list, s) local(hov, i, k) (
  hov = tg_hov(x, y, w, h);
  ui_cola(0x000000, 0.25); tg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); tg_rr(x, y, w, h, 3);
  ui_col(hov ? SCRH : SCR); tg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(13); ui_col(GRN); tg_tc(x + (w - 12) * 0.5, y + h * 0.5, s);
  ui_col(GRND); gfx_triangle((x + w - 15) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 7) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 11) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1; strcpy(#tg_m, ""); i = 0; k = floor(slider(idx) + 0.5) - lo;
    loop(n, i == k ? strcat(#tg_m, "!"); strcat(#tg_m, pk_pitem(list, i + 1, #tg_k)); i < n - 1 ? strcat(#tg_m, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#tg_m); i > 0 ? tg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    tg_set(idx, min(max(floor(slider(idx) + 0.5) - sign(mouse_wheel), lo), lo + n - 1)); mouse_wheel = 0;
  );
);
// ---------- the slow-glide fader (upright): a black slot, a scale, a flat mercury cap with an ink line and a green notch;
// the small green marker beside the slot is where the glide has reached ----------
function tg_fader(x, y, len, idx, lo, hi, def, fmt, act, label) local(v, n, hov, did, py, i, t, an) (
  did = 3000 + idx; v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  hov = tg_hov(x - 16, y - 10, 32, len + 20);
  i = 0; loop(11, t = i / 10;
    ui_cola(INK, i == 0 || i == 10 || i == 5 ? 0.8 : 0.4);
    tg_r(x - 14, y + len - t * len, i % 5 == 0 ? 7 : 4, 1); tg_r(x + 14 - (i % 5 == 0 ? 7 : 4), y + len - t * len, i % 5 == 0 ? 7 : 4, 1);
    i += 1; );
  ui_col(INK); tg_rr(x - 3, y - 2, 6, len + 4, 3);
  ui_col(GRND); tg_r(x - 1, y + len - n * len, 2, n * len);
  an = min(max((act - lo) / (hi - lo), 0), 1);
  ui_col(GRN); gfx_triangle((x + 5) * sc, (y + len - an * len) * sc, (x + 10) * sc, (y + len - an * len - 3.5) * sc, (x + 10) * sc, (y + len - an * len + 3.5) * sc);
  py = y + len - n * len;
  ui_cola(0x000000, 0.3); tg_rr(x - 13 + 1, py - 8 + 2, 26, 16, 2);
  ui_col(INK); tg_rr(x - 13, py - 8, 26, 16, 2);
  ui_col(hov || drag_id == did ? 0xEEF1F3 : MERC); tg_rr(x - 12, py - 7, 24, 14, 1.5);
  ui_col(INK); tg_r(x - 10, py - 0.75, 20, 1.5);
  ui_col(GRND); tg_r(x - 12, py - 1.5, 3, 3);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - tg_lt < 0.35 && tg_lid == idx) || (mouse_cap & 4) ? ( tg_set(idx, def); drag_id = -1; tg_lt = 0; ) :
    ( drag_id = did; tg_fy0 = mouse_y; tg_fn = n; tg_lt = time_precise(); tg_lid = idx; );
  );
  drag_id == did ? (
    t = tg_fy0 - mouse_y; tg_fy0 = mouse_y;
    tg_fn = min(max(tg_fn + t / (len * sc) * ((mouse_cap & 8) ? 0.15 : 1), 0), 1);
    v = lo + tg_fn * (hi - lo);
    slider(idx) != v ? tg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    tg_set(idx, min(max(v + mouse_wheel / 120 * (hi - lo) * ((mouse_cap & 8) ? 0.005 : 0.02), lo), hi)); mouse_wheel = 0;
  );
  (hov || drag_id == did) ? ( sprintf(#tg_vv, fmt, slider(idx)); tg_pill(x, y + len + 8, #tg_vv); ) :
    ( gfx_setfont(11); ui_col(LBL); tg_tc(x, y + len + 17, label); );
);
function tg_nname(n) ( sprintf(#tg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #tg_k), floor(n / 12) - 1); #tg_nn; );
// the stretch (cents) of partial k of middle C, as the strings are now (felt): the loop's phase solved for that partial
function tg_stretch(k) local(f, w0, kk, tn, a, fsx, pp, dap, dlo, nn, w) (
  f = 261.63; w0 = TWOPI * f / srate; kk = max(floor(48000 / (36 * f)) * srate / 48000, 1); tn = te_tn;
  a = -min(te_stf * (1.3 - 0.7 * tn) * (1.25 - 0.5 * te_ln), 0.9);
  fsx = te_lossp(min(max(te_fsb - 0.2 * tn + 0.06, 0.02), 0.49)); pp = srate / f;
  dap = 2 * kk * te_apd(a, kk * w0); dlo = te_lpd(fsx, w0);
  loop(8, pp - dap - dlo < 2.5 ? ( a *= 0.7; dap = 2 * kk * te_apd(a, kk * w0); ); );
  nn = pp - dap - dlo; w = k * w0;
  loop(10, w = TWOPI * k / (nn + 2 * kk * te_apd(a, kk * w) + te_lpd(fsx, w)); );
  1200 * log(w / (k * w0)) / log(2);
);
// the hammers' little pictures (cx, cy: the glyph's centre)
function tg_glyph(m, cx, cy, col) local(i) (
  ui_col(col);
  m == 0 ? ( tg_rr(cx - 9, cy - 8, 18, 11, 5); tg_r(cx - 1.5, cy + 3, 3, 8); ) :
  m == 1 ? ( tg_ln(cx - 9, cy + 9, cx + 4, cy - 4, 2); tg_disc(cx + 6, cy - 6, 5); ) :
  m == 2 ? ( tg_rr(cx - 9, cy - 8, 18, 9, 2); tg_r(cx - 1.5, cy + 1, 3, 9); i = 0; loop(4, tg_disc(cx - 6 + i * 4, cy - 9.5, 1.3); i += 1; ); ) :
  m == 3 ? ( i = 0; loop(6, tg_ln(cx + 8 * cos(i * $pi / 3), cy + 8 * sin(i * $pi / 3), cx + 8 * cos((i + 1) * $pi / 3), cy + 8 * sin((i + 1) * $pi / 3), 2); i += 1; );
             tg_ring(cx, cy, 3.5); ) :
  ( i = 0; loop(4, tg_r(cx - 10, cy - 7 + i * 4.5, 20, 1.2); i += 1; ); gfx_triangle((cx + 2) * sc, (cy - 10) * sc, (cx + 9) * sc, (cy - 3) * sc, (cx + 3) * sc, (cy + 1) * sc); );
);

// ======================== the faceplate: brushed lead-grey aluminium ========================
ui_col(FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); tg_rr(4, 4, 1192, 842, 9);
ui_col(FACEL); tg_rr(6.5, 6.5, 1187, 837, 7);
ui_col(INK); tg_r(11, 11, 1178, 828);
ui_col(FACE); tg_r(13, 13, 1174, 824);
tg_brush(13, 59, 1174, 708, 240, 9.1);
// etched geometry: fine construction lines through the card's centre line, and calibration crosshairs in the gutters
ui_cola(ETCH, 0.35); tg_r(600, 59, 1, 13); tg_r(600, 468, 1, 10); tg_r(13, 473, 1174, 1);
tg_cross(397, 473, 6); tg_cross(803, 473, 6); tg_cross(17, 473, 3); tg_cross(1183, 473, 3); tg_cross(553, 764, 5);
// the header: dark lead, ruled in mercury
