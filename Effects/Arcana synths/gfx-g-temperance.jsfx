// presets
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
tg_k_ = pk_preset(22 * sc, 18 * sc, 330 * sc, 34 * sc, pr_cur, #te_pm);
tg_k_ > 0 ? ( tg_k_ > te_npre ? reset_all() : prs_dirty = tg_k_; );
gfx_setfont(12); ui_col(GRN); tg_t(366, 18, "SYNTHETIC STRINGS"); ui_col(CHL); tg_t(366, 35, "HAMMERS · PATIENCE");
