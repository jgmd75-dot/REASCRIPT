    tg_fader(tg_x + 46, 570, 130, 22, 0, 100, 0, "%.0f%%", te_mdp * 100, "DEPTH");
  ) : (
    tg_fader(tg_x, 570, 130, 24, 0.05, 8, 0.45, "%.2f s", te_rel, "TIME");
    tg_fader(tg_x + 46, 570, 130, 25, 0, 100, 0, "%.0f%%", te_rdp * 100, "DEPTH");
  );
  tg_k += 1;
);

