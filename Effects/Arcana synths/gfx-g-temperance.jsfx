ui_col(MERC); tg_r(13, 57, 1174, 2);
// the numeral, on the balance
tg_scales(600, 22, 108, sin(time_precise() * 0.21) * 0.25 + te_cr * 3, MERC, 0.45);
ui_col(INK); tg_disc(600, 35, 20.5); ui_col(MERC); tg_ring(600, 35, 19.5); ui_col(PLATE); tg_disc(600, 35, 18);
ui_cola(ETCH, 0.7); tg_ring(600, 35, 15.5);
