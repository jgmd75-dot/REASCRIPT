  cg_key(cg_x + 172, 102, 102, 28, floor(slider(cg_b) + 0.5) == 2, "STR · BRASS") ? cg_set(cg_b, 2);
  cg_fader(cg_x + 36, 150, 140, 1, cg_b + 1, 0, 100, 80, "%.0f%%", 0);
