cg_wa = cg_run ? ch_t * 2 * $pi / 6 : 0;
cg_wheel(392, 865, 15, cg_wa, ALU); cg_wheel(808, 865, 15, cg_wa, ALU);
ins_io(952, 847, 44, 0xC8CCD0);
cg_lv = min(max((20 * log10(max(ch_pk, 0.00001)) + 48) / 48, 0), 1); ch_pk *= 0.8;
ui_col(INK); cg_r(1060, 862, 112, 14); ui_col(SCR); cg_r(1061.5, 863.5, 109, 11);
cg_i = 0; loop(18, cg_on = cg_i / 18 < cg_lv; ui_col(cg_on ? (cg_i >= 16 ? 0xFF3A2A : cg_i >= 13 ? PHL : PH) : PHF); cg_r(1063 + cg_i * 6, 865, 4.6, 8); cg_i += 1; );
gfx_setfont(11); ui_col(0xC8CCD0); cg_t(1060, 847, "OUTPUT");

pk_end();
