  cg_knob(cg_x + 128, 178, 20, cg_b + 2, -100, 100, cg_trk ? 50 : -50, 0, "PAN", "%+.0f", 1);
  cg_knob(cg_x + 218, 178, 20, cg_b + 3, -100, 100, 0, 0, "TONE", "%+.0f", 1);
  cg_cap(cg_x + 82, 240, "OCTAVE");
  cg_keys(cg_x + 82, 256, 34, 26, 4, cg_b + 4, -2, 5, "-2|-1|0|+1|+2");
  cg_trk += 1;
);

// ======================== CLOCK ========================
cg_sect(22, 332, 284, 258, "CLOCK");
cg_sknob(100, 434, 28, 3, 0, 5, "1/8|1/8T|1/16|1/16T|1/32", 2, -0.75 * $pi, 0.75 * $pi, 58, "");
