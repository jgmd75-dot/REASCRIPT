// presets
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(22 * sc, 18 * sc, 330 * sc, 34 * sc, pr_cur, #ch_pm);
k_ > 0 ? ( k_ > ch_npre ? reset_all() : prs_dirty = k_; );
gfx_setfont(12); ui_col(ORG); cg_t(366, 18, "PHASING ENGINE"); ui_col(0xC8CCD0); cg_t(366, 35, "ONE PATTERN, TWO CLOCKS");
// MIDI: activity and channel; RUN; the clock's state
