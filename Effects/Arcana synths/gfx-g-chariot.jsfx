cg_dfield(714, 22, 70, 26, 5, 0, 16, #cg_g, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", 0);
cg_key(794, 22, 54, 26, slider1 >= 0.5, "RUN") ? cg_set(1, slider1 >= 0.5 ? 0 : 1);
cg_key(856, 22, 90, 26, slider105 >= 0.5, "TRANSPORT") ? cg_set(105, slider105 >= 0.5 ? 0 : 1);
ui_col(INK); cg_rr(954, 22, 152, 26, 3); ui_col(SCR); cg_rr(955.5, 23.5, 149, 23, 2);
gfx_setfont(11); ui_col(PH);
slider1 < 0.5 ? strcpy(#cg_g, "STOPPED") : (play_state & 1) ? strcpy(#cg_g, "LOCKED TO REAPER") : strcpy(#cg_g, "FREE RUN AT THE TEMPO");
cg_tc(1030, 35, #cg_g);
ui_size_picker(1118 * sc, 26 * sc);

cg_run = slider1 >= 0.5;
cg_len = min(max(floor(slider4 + 0.5), 8), 16);
cg_now = ch_clk;

// ======================== TRACK A and TRACK B ========================
cg_trk = 0;
loop(2,
  cg_x = cg_trk ? 894 : 22; cg_b = cg_trk ? 16 : 11;
  cg_sect(cg_x, 72, 284, 250, cg_trk ? "TRACK B  ·  RIGHT" : "TRACK A  ·  LEFT");
  pk_led((cg_x + 268) * sc, 83 * sc, 4.5 * sc, cg_run && (cg_now - (cg_trk ? ch_htb : ch_hta)) < 0.08 * srate, ORG);
  cg_key(cg_x + 10, 102, 82, 28, floor(slider(cg_b) + 0.5) == 0, "MALLETS") ? cg_set(cg_b, 0);
