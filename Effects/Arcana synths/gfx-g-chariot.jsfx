cg_sknob(236, 434, 28, 4, 8, 9, "8|9|10|11|12|13|14|15|16", 12, -0.75 * $pi, 0.75 * $pi, 52, "");
gfx_setfont(13); ui_col(LBL); cg_tc(236, 494, "LENGTH");
cg_cap(34, 508, "ROOT");
cg_dfield(34, 526, 84, 30, 2, 36, 72, cg_nname(floor(slider2 + 0.5)), "C2|C#2|D2|D#2|E2|F2|F#2|G2|G#2|A2|A#2|B2|C3|C#3|D3|D#3|E3|F3|F#3|G3|G#3|A3|A#3|B3|C4|C#4|D4|D#4|E4|F4|F#4|G4|G#4|A4|A#4|B4|C5", 12);
cg_knob(176, 540, 16, 39, 0, 100, 50, 0, "ACCENT", "%.0f%%", 0);
cg_knob(250, 540, 16, 40, 0, 100, 50, 0, "VELOCITY", "%.0f%%", 0);
gfx_setfont(11); ui_col(LBL);
sprintf(#cg_g, "STEP %.0f MS", floor(slider3 + 0.5) == 0 ? 30000 / ch_tmp : floor(slider3 + 0.5) == 1 ? 20000 / ch_tmp :
        floor(slider3 + 0.5) == 2 ? 15000 / ch_tmp : floor(slider3 + 0.5) == 3 ? 10000 / ch_tmp : 7500 / ch_tmp);
cg_tc(76, 572, #cg_g);

// ======================== PHASE ========================
cg_sect(894, 332, 284, 258, "PHASE  ·  DRIFT");
cg_cap(906, 360, "PHASE SHIFT");
gfx_setfont(11); ui_col(slider6 > 0.5 || slider6 < -0.5 ? ORGD : LBL); cg_tr(1166, 367, cg_rtxt(slider6));
cg_fader(918, 400, 236, 0, 6, -100, 100, 0, "%+.1f", 1);
gfx_setfont(11); ui_col(LBL); cg_t(906, 420, "BEHIND"); cg_tc(1036, 427, "LOCKED"); cg_tr(1166, 427, "AHEAD");
cg_keys(906, 446, 62, 28, 4, 8, 0, 2, "DRIFT|STEP");
sprintf(#cg_g, "EVERY %d", floor(slider9 + 0.5));
cg_dfield(1046, 446, 120, 28, 9, 1, 16, #cg_g, "Every cycle|Every 2 cycles|Every 3 cycles|Every 4 cycles|Every 5 cycles|Every 6 cycles|Every 7 cycles|Every 8 cycles|Every 9 cycles|Every 10 cycles|Every 11 cycles|Every 12 cycles|Every 13 cycles|Every 14 cycles|Every 15 cycles|Every 16 cycles", 0);
gfx_setfont(11); ui_col(slider8 >= 0.5 ? LBL : FACED); cg_tc(1106, 483, "CYCLES (STEP MODE)");
cg_knob(938, 530, 20, 7, -16, 16, 0, 0, "PHASE", "%+.2f steps", 0);
cg_key(978, 510, 82, 40, 0, "RESYNC") ? ( cg_set(10, (floor(slider10 + 0.5) + 1) % 1000000); cg_set(7, 0); );
// the offset readout
ui_col(INK); cg_rr(1070, 500, 98, 80, 4); ui_col(SCR); cg_rr(1071.5, 501.5, 95, 77, 3);
cg_off = ch_offd; cg_off > cg_len * 0.5 ? cg_off -= cg_len;
