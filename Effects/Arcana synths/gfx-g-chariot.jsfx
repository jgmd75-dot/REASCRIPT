cg_sect(220, 602, 190, 130, "VOICES");
cg_vw = min(max(floor(slider24 / 25 + 0.5), 0), 4);
cg_knob(254, 670, 18, 24, 0, 100, 50, 0, pk_pitem("VOWEL U|VOWEL O|VOWEL A|VOWEL E|VOWEL I", cg_vw + 1, #cg_k2), "%.0f%%", 0);
cg_knob(315, 670, 18, 25, 5, 100, 35, 0, "LENGTH", "%.0f%%", 0);
cg_knob(376, 670, 18, 26, 0, 100, 50, 0, "SPREAD", "%.0f%%", 0);
cg_sect(418, 602, 190, 130, "STRINGS  ·  BRASS");
cg_knob(452, 670, 18, 27, 0, 100, 50, 0, "BLEND", "%.0f%% strings", 0);
cg_knob(513, 670, 18, 28, 0, 100, 50, 0, "SWELL", "%.0f%%", 0);
cg_knob(574, 670, 18, 29, 5, 100, 70, 0, "LENGTH", "%.0f%%", 0);
