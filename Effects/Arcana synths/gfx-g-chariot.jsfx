cg_knob(708, 668, 17, 31, 0, 100, 45, 0, "TONE", "%.0f%%", 0);
cg_sect(756, 602, 294, 130, "PULSE");
cg_sknob(828, 680, 16, 32, 0, 4, "1/16|1/16T|1/32|1/8T", 0, -0.62 * $pi, 0.62 * $pi, 46, "");
gfx_setfont(11); ui_col(LBL); cg_tc(828, 723, "DIVISION");
cg_fader(886, 654, 70, 0, 33, 0, 100, 70, "%.0f%%", 0);
