cg_knob(908, 696, 13, 34, 0, 100, 30, 0, "SHAPE", "%.0f%% swell", 0);
cg_knob(960, 696, 13, 35, 0, 50, 0, 0, "SWING", "%.0f%%", 1);
cg_key(988, 682, 54, 28, slider36 >= 0.5, "TRACKS") ? cg_set(36, slider36 >= 0.5 ? 0 : 1);
// the gate it makes (the pad always; the tracks too when lit)
ui_col(INK); cg_r(988, 640, 54, 30); ui_col(SCR); cg_r(989, 641, 52, 28);
cg_i = 0; cg_ox = 0;
loop(51, cg_p = (cg_i / 50 * 3) - floor(cg_i / 50 * 3);
  cg_gh = max(min(min(cg_p / 0.08, (0.52 - cg_p) / 0.08), 1), 0); cg_gs = sqr(sin($pi * cg_p));
  cg_gv = 1 - slider33 / 100 * (1 - (cg_gh + (cg_gs - cg_gh) * slider34 / 100));
  cg_x = 990 + cg_i; cg_y = 665 - cg_gv * 20;
  cg_i > 0 ? ( ui_col(PH); cg_ln(cg_ox, cg_oy, cg_x, cg_y, 1); ); cg_ox = cg_x; cg_oy = cg_y; cg_i += 1; );
cg_sect(1058, 602, 120, 130, "ROOM");
cg_knob(1090, 670, 17, 37, 0, 100, 40, 0, "SIZE", "%.0f%%", 0);
cg_knob(1146, 670, 17, 38, 0, 100, 18, 0, "MIX", "%.0f%%", 0);

// ======================== the three LFOs: one for each voice (track A, track B, the pad) ========================
cg_k = 0;
loop(3,
  cg_x = 22 + cg_k * 388; cg_b = 84 + cg_k * 7;
  cg_sect(cg_x, 742, 380, 92, pk_pitem("LFO  ·  TRACK A|LFO  ·  TRACK B|LFO  ·  PAD", cg_k + 1, #cg_k2));
  // where it is now: a dot on a short rail in the title band
  cg_y = CHLF[cg_k * 8 + 5];
  ui_cola(ORG, 0.45); cg_r(cg_x + 290, 753, 76, 1); cg_r(cg_x + 328, 750, 1, 7);
  ui_col(ORG); gfx_circle((cg_x + 328 + 36 * cg_y) * sc, 753.5 * sc, 3.2 * sc, 1, 1);
  cg_sy = floor(slider(cg_b) + 0.5);
  cg_sy > 0 ? sprintf(#cg_g, cg_sy == 1 ? "1 BAR" : "%d BARS", 2 ^ (cg_sy - 1)) : strcpy(#cg_g, "FREE");
  cg_dfield(cg_x + 10, 772, 92, 24, cg_b, 0, 8, #cg_g, "Free|1 bar|2 bars|4 bars|8 bars|16 bars|32 bars|64 bars|128 bars", 0);
  cg_dfield(cg_x + 10, 802, 92, 24, cg_b + 2, 0, 3, pk_pitem("SINE|TRIANGLE|SMOOTH RND|S&H SLEW", floor(slider(cg_b + 2) + 0.5) + 1, #cg_k3), "Sine|Triangle|Smooth random|Sample-hold slew", 0);
  cg_knob(cg_x + 136, 792, 13, cg_b + 1, 0.001, 1, 0.02, 1, cg_sy > 0 ? "(RATE)" : "RATE", "%.4f Hz", 0);
  cg_knob(cg_x + 188, 792, 13, cg_b + 6, 0, 360, cg_k * 120, 0, "PHASE", "%.0f°", 1);
  cg_knob(cg_x + 240, 792, 13, cg_b + 3, 0, 100, 0, 0, "LEVEL", "%.0f%%", 0);
  cg_knob(cg_x + 292, 792, 13, cg_b + 4, 0, 100, 0, 0, "PAN", "%.0f%%", 0);
  cg_knob(cg_x + 342, 792, 13, cg_b + 5, 0, 100, 0, 0, "FILTER", "%.0f%%", 0);
  cg_k += 1;
);

// ======================== the foot of the card: FATE, VOLUME, LEVEL, the name between two wheels, SAT, the level ========================
ui_col(INK); cg_r(13, 842, 1174, 2);
ui_col(0x151617); cg_r(13, 844, 1174, 43);
cg_i = 0; loop(3, ui_cola(cg_i == 1 ? ORG : 0x6A6E72, 1); cg_r(352 - cg_i * 12, 856 + cg_i * 8, 18 + cg_i * 12, 1); cg_r(830, 856 + cg_i * 8, 18 + cg_i * 12, 1); cg_i += 1; );
cg_knob(44, 866, 12, 41, 0, 100, 35, 0, "", "%.0f%%", 0);
drag_id != 2041 && !(sqr(mouse_x - 44 * sc) + sqr(mouse_y - 866 * sc) <= sqr(18 * sc)) ? ( gfx_setfont(12); ui_col(ORG); cg_t(64, 857, "FATE"); );
cg_knob(140, 866, 12, 42, -24, 6, -4, 0, "", "%+.1f dB", 0);
drag_id != 2042 && !(sqr(mouse_x - 140 * sc) + sqr(mouse_y - 866 * sc) <= sqr(18 * sc)) ? ( gfx_setfont(12); ui_col(ORG); cg_t(160, 857, "VOLUME"); );
cg_knob(256, 866, 12, 43, 0, 100, 60, 0, "", "%.0f%%", 0);
drag_id != 2043 && !(sqr(mouse_x - 256 * sc) + sqr(mouse_y - 866 * sc) <= sqr(18 * sc)) ? ( gfx_setfont(12); ui_col(ORG); cg_t(276, 857, "LEVEL"); );
// the name plate, between the chariot's two wheels (they turn with the clock)
