in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-star";
ext_noinit = 1;
fl_ok = 0;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
NC = 3; NVC = 4; NVX = NC * NVC;
SVB = 30000; VSZ = 48;                         // voices: 3 channels x 4, 48 fields each
SHN = 31000; SHV = 31200; SHO = 31400;         // held notes: sorted, velocities, played order (128)
SKD = 31600;                                   // keys down (128 flags)
SQO = 32000; SQC = 32400; SQT = 32800; SQN = 33200; SQV = 33600;   // the block's events (400)
SPO = 34000; SPT = 34400; SPN = 34800;         // pending arp note-offs (beat time, note), 128 a channel
SPC = 35200;                                   // their counts (3)
SCS = 36000; CSZ = 128;                        // channel state, 128 fields each
DLN = 262144;                                  // delay line length (5.4 s at 48 kHz, 2.7 at 96)
SDL = 100000;                                  // 3 channels x 2 lines
SCH = SDL + 6 * DLN + 1000; CHN = 4096;        // chorus lines: 3 channels x 2
memset(SVB, 0, NVX * VSZ); memset(SKD, 0, 128); memset(SPC, 0, 3); memset(SCS, 0, NC * CSZ);
memset(SDL, 0, 6 * DLN); memset(SCH, 0, 6 * CHN);
c = 0; loop(NC, (SCS + c * CSZ)[0] = -1; c += 1; );    // no last note yet (glide)
nh = 0; nord = 0; vage = 0; pedal = 0; nkeys = 0;
ck_fb = 0; ck_was = 0; ck_exp = -1; ck_on = 0; st_pk = 0;
L12 = log(2) / 12;

// ---------- presets: "slider:value" changes from the defaults ----------
#sr_pm = "Init|First Light|Healing Water|Seven Small Stars|Night Garden|Pour|Ibis|Clear Sky|Renewal";
sr_npre = 9;
function pre_str(k) (
  k == 2 ? "1:0 3:0 5:12 26:35 8:1800 9:45 10:60 14:300 15:10 18:300 19:40 20:350 44:3 45:2 46:45 54:5 55:45 56:30 72:5 70:1 71:2 73:2 74:35 75:7 82:8 84:20 100:4 101:3 102:40 103:12 104:3 110:9 111:40 112:28 39:30" :
  k == 3 ? "1:3 3:2 4:12 5:0 6:35 8:3200 9:15 10:20 13:2 14:900 15:0 17:1 18:1200 19:0 20:900 21:60 42:1 43:0 44:3 45:3 54:7 55:55 56:35 59:40 58:0 70:0 87:45 86:1 88:0.2 82:10 83:40 84:30 98:1 99:4 100:5 101:2 103:24 110:6 111:50 112:30 117:30 118:0 119:3 39:20" :
  k == 4 ? "1:1 3:1 4:7 7:30 8:2600 9:35 10:55 14:250 15:0 18:220 19:0 20:200 42:1 43:0 44:3 45:1 48:0 70:1 71:0 72:3 73:1 75:7 76:5 98:1 99:0 100:3 101:1 103:12 104:10 54:5 82:7 110:4 56:22 84:20 112:22 39:60" :
  k == 5 ? "1:2 3:3 4:12 6:40 8:900 9:55 10:45 12:70 13:4 14:600 15:30 17:30 18:800 19:80 20:1200 22:0.3 24:20 42:1 43:2 44:2 45:2 46:90 70:0 87:60 86:1 88:0.15 82:11 83:55 84:30 98:1 99:4 100:1 101:2 102:90 103:19 110:11 111:55 112:30 64:40 65:0 66:2 120:40 121:0 122:3 39:70" :
  k == 6 ? "1:0 3:0 4:-12 5:4 26:20 8:600 9:65 10:70 13:1 14:180 15:0 17:1 18:200 19:0 20:120 25:40 27:30 42:1 43:5 44:3 45:1 46:70 70:0 71:0 75:-12 84:0 98:1 99:2 100:5 101:2 103:12 104:4 110:2 111:30 112:20 57:25 113:25 39:85 40:35" :
  k == 7 ? "1:1 3:0 5:5 7:25 8:1400 9:40 10:50 14:350 15:20 18:400 19:60 20:500 23:8 42:1 43:5 44:1 45:1 46:80 48:0 70:1 71:5 72:1 73:1 75:7 76:2 98:1 99:5 100:1 103:12 104:5 54:9 55:40 82:10 83:35 110:11 111:45 56:30 112:30 61:40 62:1 63:2 117:40 118:1 119:2 39:40" :
  k == 8 ? "1:3 3:3 4:7 5:3 6:50 8:5000 9:10 10:15 13:20 14:900 15:60 17:60 18:900 19:85 20:900 42:1 43:0 44:3 45:4 46:40 70:1 71:1 72:4 73:4 74:40 75:12 98:1 99:4 100:4 101:3 102:40 103:24 54:3 55:50 56:35 82:5 83:45 84:30 110:2 111:50 112:35 59:30 87:30 115:30 39:15" :
  k == 9 ? "1:0 3:1 5:-7 26:60 25:30 8:1100 9:50 10:65 11:50 13:2 14:500 15:15 18:600 19:55 20:700 42:1 43:2 44:3 45:2 46:55 70:1 71:6 72:0 73:1 74:90 75:-12 98:1 99:4 100:5 101:3 103:12 54:7 82:8 110:10 55:45 83:30 111:50 56:28 84:15 112:30 95:40 67:30 123:30 87:40 86:1 39:50 40:30" :
  "";
);
function pre_str_au(k) (
  k == 2 ? "1:0 3:0 5:12 26:35 8:1800 9:45 10:60 14:300 15:10 18:300 19:40 20:350 44:3 45:2 46:45 54:5 55:45 56:30 72:5 70:1 71:2 73:2 74:35 75:7 82:8 84:20 100:4 101:3 102:40 103:12 104:3 110:9 111:40 112:28 39:30" :
  k == 3 ? "1:3 3:2 4:12 5:0 6:35 8:3200 9:15 10:20 13:2 14:900 15:0 17:1 18:1200 19:0 20:900 21:60 42:1 43:0 44:3 45:3 54:7 55:55 56:35 59:40 58:0 70:0 87:45 86:1 88:0.2 82:10 83:40 84:30 98:1 99:4 100:5 101:2 103:24 110:6 111:50 112:30 117:30 118:0 119:3 39:20" :
  k == 4 ? "1:1 3:1 4:7 7:30 8:2600 9:35 10:55 14:250 15:0 18:220 19:0 20:200 42:1 43:0 44:3 45:1 48:0 70:1 71:0 72:3 73:1 75:7 76:5 98:1 99:0 100:3 101:1 103:12 104:10 54:5 82:7 110:4 56:22 84:20 112:22 39:60" :
  k == 5 ? "1:2 3:3 4:12 6:40 8:900 9:55 10:45 12:70 13:4 14:600 15:30 17:30 18:800 19:80 20:1200 22:0.3 24:20 42:1 43:2 44:2 45:2 46:90 70:0 87:60 86:1 88:0.15 82:11 83:55 84:30 98:1 99:4 100:1 101:2 102:90 103:19 110:11 111:55 112:30 64:40 65:0 66:2 120:40 121:0 122:3 39:70" :
  k == 6 ? "1:0 3:0 4:-12 5:4 26:20 8:600 9:65 10:70 13:1 14:180 15:0 17:1 18:200 19:0 20:120 25:40 27:30 42:1 43:5 44:3 45:1 46:70 70:0 71:0 75:-12 84:0 98:1 99:2 100:5 101:2 103:12 104:4 110:2 111:30 112:20 57:25 113:25 39:85 40:35" :
  k == 7 ? "1:1 3:0 5:5 7:25 8:1400 9:40 10:50 14:350 15:20 18:400 19:60 20:500 23:8 42:1 43:5 44:1 45:1 46:80 48:0 70:1 71:5 72:1 73:1 75:7 76:2 98:1 99:5 100:1 103:12 104:5 54:9 55:40 82:10 83:35 110:11 111:45 56:30 112:30 61:40 62:1 63:2 117:40 118:1 119:2 39:40" :
  k == 8 ? "1:3 3:3 4:7 5:3 6:50 8:5000 9:10 10:15 13:20 14:900 15:60 17:60 18:900 19:85 20:900 42:1 43:0 44:3 45:4 46:40 70:1 71:1 72:4 73:4 74:40 75:12 98:1 99:4 100:4 101:3 102:40 103:24 54:3 55:50 56:35 82:5 83:45 84:30 110:2 111:50 112:35 59:30 87:30 115:30 39:15" :
  k == 9 ? "1:0 3:1 5:-7 26:60 25:30 8:1100 9:50 10:65 11:50 13:2 14:500 15:15 18:600 19:55 20:700 42:1 43:2 44:3 45:2 46:55 70:1 71:6 72:0 73:1 74:90 75:-12 98:1 99:4 100:5 101:3 103:12 54:7 82:8 110:10 55:45 83:30 111:50 56:28 84:15 112:30 95:40 67:30 123:30 87:40 86:1 39:50 40:30" :
  "";
);
function sr_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
function sr_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
// the defaults, taken from the slider lines once
SDEF = 37000;
function load_preset(k) local(n, i) (
  i = 1; loop(128, i != 29 && i != 30 && (i < 31 || i > 38) ? slider(i) = SDEF[i]; i += 1; );
  n = sr_nums(pre_str(k), SDEF + 200); i = 0;
  loop(floor(n / 2), SDEF[200 + i * 2] >= 1 && SDEF[200 + i * 2] <= 128 ? slider(SDEF[200 + i * 2]) = SDEF[200 + i * 2 + 1]; i += 1; );
  i = 1; loop(128, ui_auto(i); i += 1; );
  pr_cur = k;
);
function load_preset_au(k) local(n, i) (
  i = 1; loop(128, i != 29 && i != 30 && (i < 31 || i > 38) ? slider(i) = SDEF[i]; i += 1; );
  n = sr_nums_au(pre_str_au(k), SDEF + 200); i = 0;
  loop(floor(n / 2), SDEF[200 + i * 2] >= 1 && SDEF[200 + i * 2] <= 128 ? slider(SDEF[200 + i * 2]) = SDEF[200 + i * 2 + 1]; i += 1; );
  i = 1; loop(128, ui_auto(i); i += 1; );
  pr_cur = k;
);
#sr_def = "0 0 0 0 9 50 50 2400 30 45 30 50 3 420 25 400 2 500 70 450 50 4.5 0 0 15 0 0 0 0 0 35 -4 60 0 30 120 6000 -0.3 50 20 100 1 0 1 2 60 0 0 20 20000 0 0 0 7 35 25 0 0 0 0.6 0 0 3 0 0 1 0 100 -3 0 0 3 1 60 0 0 20 20000 0 0 0 8 25 12 0 0 30 0.4 0 0 3 0 1 2 0 100 -8 1 1 3 1 45 12 2 20 20000 0 0 0 6 35 25 0 0 0 0.6 0 0 3 0 0 1 0 100 -3 0 0 0";
sr_nums(#sr_def, SDEF + 1);
!sr_defok ? ( sr_defok = 1; pr_cur = 1; ui_sz = 1; );
function reset_all() (
  load_preset(1);
  slider29 = 0; slider30 = 0; slider31 = 35; slider32 = -4; slider33 = 60;
  slider34 = 0; slider35 = 30; slider36 = 120; slider37 = 6000; slider38 = -0.3;
  i_ = 29; loop(10, ui_auto(i_); i_ += 1; );
);

// ---------- tempo divisions ----------
function arp_beats(r) ( r == 0 ? 1 : r == 1 ? 0.5 : r == 2 ? 1 / 3 : r == 3 ? 0.25 : r == 4 ? 1 / 6 : r == 5 ? 0.125 : r == 6 ? 2 / 3 : 0.75; );
function dly_beats(r) ( r == 0 ? 0.125 : r == 1 ? 1 / 6 : r == 2 ? 0.25 : r == 3 ? 1 / 3 : r == 4 ? 0.375 : r == 5 ? 0.5 :
                        r == 6 ? 2 / 3 : r == 7 ? 0.75 : r == 8 ? 1 : r == 9 ? 4 / 3 : r == 10 ? 1.5 : 2; );
function trem_beats(r) ( r == 0 ? 2 : r == 1 ? 1 : r == 2 ? 0.5 : r == 3 ? 0.25 : r == 4 ? 2 / 3 : r == 5 ? 1 / 3 : 0.75; );
function auto_beats(r) ( r == 0 ? 2 : r == 1 ? 4 : r == 2 ? 8 : r == 3 ? 16 : r == 4 ? 32 : 1; );

// ---------- held notes ----------
function held_add(n, v) local(i, j) (
  i = 0; j = -1; loop(nh, SHN[i] == n ? j = i; i += 1; );
  j < 0 && nh < 64 ? (
    i = nh; while (i > 0 && SHN[i - 1] > n) ( SHN[i] = SHN[i - 1]; SHV[i] = SHV[i - 1]; i -= 1; );
    SHN[i] = n; SHV[i] = v; nh += 1;
    SHO[nord] = n; nord += 1;
  );
  j >= 0 ? SHV[j] = v;
);
function held_del(n) local(i, j) (
  i = 0; j = -1; loop(nh, SHN[i] == n ? j = i; i += 1; );
  j >= 0 ? ( i = j; loop(nh - j - 1, SHN[i] = SHN[i + 1]; SHV[i] = SHV[i + 1]; i += 1; ); nh -= 1; );
  i = 0; j = -1; loop(nord, SHO[i] == n ? j = i; i += 1; );
  j >= 0 ? ( i = j; loop(nord - j - 1, SHO[i] = SHO[i + 1]; i += 1; ); nord -= 1; );
);

// ---------- events (sample offset order) ----------
nq = 0;
function q_add(ofs, ch, typ, n, v) local(i) (
  nq < 400 ? (
    i = nq; while (i > 0 && SQO[i - 1] > ofs) ( SQO[i] = SQO[i - 1]; SQC[i] = SQC[i - 1]; SQT[i] = SQT[i - 1]; SQN[i] = SQN[i - 1]; SQV[i] = SQV[i - 1]; i -= 1; );
    SQO[i] = ofs; SQC[i] = ch; SQT[i] = typ; SQN[i] = n; SQV[i] = v; nq += 1;
  );
);

// ---------- the voices ----------
// v = SVB + (ch * 4 + i) * VSZ:  0 on  1 note  2 gate  3 age  4 vel 0..1  5 pitch now  6 pitch target  7 - 10 phases
//  (osc 1, osc 2, their unison twins)  11 filter env  12 its stage  13 amp env  14 its stage  15 / 16 filter (low, band)
//  17 tail  18 last out  19 fate tuning (cents)  20 - 23 increments  24 filter f  25 tick  26 drift  27 drift target
//  28 decimator state  29 fade (samples left, a stolen voice)  30 / 31 / 32 the waiting note, velocity, gate
function v_ptr(c, i) ( SVB + (c * NVC + i) * VSZ; );
function v_start(p, n, vel) (
  p[17] += p[0] ? p[18] : 0;                           // the old sound fades under the new one
  p[0] = 1; p[1] = n; p[2] = 1; p[4] = vel / 127; vage += 1; p[3] = vage;
  p[11] = 0; p[12] = 1; p[13] = p[13] * 0.3; p[14] = 1; p[25] = 0;
  p[19] = (rand(2) - 1) * 9 * slider31 * 0.01;
);
function ch_note_on(c, n, vel) local(i, p, b, ba, cs) (
  n = min(max(n, 0), 127);
  cs = SCS + c * CSZ;
  b = -1; i = 0; loop(NVC, p = v_ptr(c, i); p[0] && p[1] == n && b < 0 ? b = i; i += 1; );
  b < 0 ? ( i = 0; loop(NVC, p = v_ptr(c, i); !p[0] && b < 0 ? b = i; i += 1; ); );
  b < 0 ? ( ba = 1000000000; i = 0; loop(NVC, p = v_ptr(c, i); !p[2] && p[3] < ba ? ( b = i; ba = p[3]; ); i += 1; ); );
  b < 0 ? ( ba = 1000000000; i = 0; loop(NVC, p = v_ptr(c, i); p[3] < ba ? ( b = i; ba = p[3]; ); i += 1; ); );
  p = v_ptr(c, b);
  p[6] = n; p[5] = slider27 > 0 && cs[0] >= 0 ? cs[0] : n;
  cs[0] = n; cs[3] = time_precise();
  v_start(p, n, vel);
);
function ch_note_off(c, n) local(i, p) (
  i = 0; loop(NVC, p = v_ptr(c, i); p[0] && p[1] == n && p[2] ? ( p[2] = 0; p[12] = 4; p[14] = 4; ); i += 1; );
);
function ch_all_off(c) local(i, p) ( i = 0; loop(NVC, p = v_ptr(c, i); p[0] ? ( p[2] = 0; p[12] = 4; p[14] = 4; ); i += 1; ); );

// ---------- the arpeggiators: each channel walks the held chord its own way ----------
function arp_note(c, k, md, oc) local(N, p, q) (
  N = nh * oc;
  md == 5 ? ( q = k % (nord * oc); SHO[q % nord] + 12 * floor(q / nord); ) : (
    p = md == 0 ? k % N :
        md == 1 ? N - 1 - k % N :
        md == 2 || md == 3 ? ( N < 2 ? 0 : ( q = k % (2 * N - 2); q = q < N ? q : 2 * N - 2 - q; md == 3 ? N - 1 - q : q; ); ) :
        floor(rand(N));
    SHN[p % nh] + 12 * floor(p / nh);
  );
);
function pend_add(c, t, n) local(k) (
  k = SPC[c]; k < 128 ? ( SPO[c * 128 + k] = t; SPN[c * 128 + k] = n; SPC[c] = k + 1; );
);

// ---------- the channel's delay unit: filters and helpers ----------
// a TPT state-variable: 1 low-pass, 2 high-pass; (g, k) given
function svf(x, g, k, mode) instance(s1, s2) local(a1, a2, a3, v1, v2, v3) (
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - s2; v1 = a1 * s1 + a2 * v3; v2 = s2 + a2 * s1 + a3 * v3;
  s1 = 2 * v1 - s1; s2 = 2 * v2 - s2;
  mode == 1 ? v2 : x - k * v1 - v2;
);
function op(x, a) instance(z) ( z += (x - z) * a; z; );      // one-pole low-pass
function ap1(x, a) instance(z) local(y) ( y = a * x + z; z = x - a * y; y; );   // first-order allpass

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
sr_volt = 10 ^ (slider32 / 20) * sqr(slider33 / 100) * 2.5;
ins_output_setup(34);

@block
prs_chk();
sr_volt = 10 ^ (slider32 / 20) * sqr(slider33 / 100) * 2.5;
nq = 0;
// ---------- MIDI ----------
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, slider30) ? (
    mst = m1 & 0xF0;
    mst == 0x90 && m3 > 0 ? (
      ins_midi_hit();
      // LATCH: a new chord after every key is up replaces the old one
      nkeys == 0 && slider29 >= 0.5 && nh > 0 ? (
        i_ = 0; loop(nh, c = 0; loop(NC, slider(42 + c * 28) < 0.5 ? q_add(mofs, c, 0, SHN[i_] + slider(47 + c * 28), 0); c += 1; ); i_ += 1; );
        nh = 0; nord = 0;
      );
      // the first key from silence starts the free clock (while REAPER is stopped); what the arps still hold stops
      nh == 0 && !(play_state & 1) ? (
        ck_fb = 0;
        c = 0; loop(NC, k_ = 0; loop(SPC[c], q_add(mofs, c, 0, SPN[c * 128 + k_], 0); k_ += 1; ); SPC[c] = 0; c += 1; );
      );
      held_add(m2, m3); SKD[m2] = 1; nkeys += 1;
      c = 0; loop(NC, slider(42 + c * 28) < 0.5 ? q_add(mofs, c, 1, m2 + slider(47 + c * 28), m3); c += 1; );
    ) :
    mst == 0x80 || (mst == 0x90 && m3 == 0) ? (
      SKD[m2] ? ( SKD[m2] = 0; nkeys = max(nkeys - 1, 0); );
      slider29 < 0.5 && !pedal ? (
        held_del(m2);
        c = 0; loop(NC, slider(42 + c * 28) < 0.5 ? q_add(mofs, c, 0, m2 + slider(47 + c * 28), 0); c += 1; );
      );
    ) :
    mst == 0xB0 ? (
      m2 == 1 ? sr_mw = m3 / 127 :
      m2 == 64 ? (
        pedal = m3 >= 64;
        // pedal up: let go of the notes no longer held (unless LATCH)
        !pedal && slider29 < 0.5 ? (
          i_ = nh - 1; loop(nh, !SKD[SHN[i_]] ? ( n_ = SHN[i_]; held_del(n_); c = 0; loop(NC, slider(42 + c * 28) < 0.5 ? q_add(mofs, c, 0, n_ + slider(47 + c * 28), 0); c += 1; ); ); i_ -= 1; );
        );
      ) :
      m2 == 120 || m2 == 123 ? ( nh = 0; nord = 0; memset(SKD, 0, 128); nkeys = 0; q_add(mofs, -1, 2, 0, 0); );
    );
  );
  midisend(mofs, m1, m2, m3);
);
// LATCH switched off: keep only the keys still down
slider29 < 0.5 && sr_latwas && !pedal ? (
  i_ = nh - 1; loop(nh, !SKD[SHN[i_]] ? ( n_ = SHN[i_]; held_del(n_); c = 0; loop(NC, q_add(0, c, 0, n_ + slider(47 + c * 28), 0); c += 1; ); ); i_ -= 1; );
);
sr_latwas = slider29 >= 0.5;

// ---------- the clock: REAPER's while it plays, free at the tempo while stopped ----------
ck_play = play_state & 1;
ck_bps = tempo / 60 / srate;
ck_t0 = ck_play ? beat_position : ck_fb;
ck_t1 = ck_t0 + ck_bps * samplesblock;
ck_jump = ck_play && (!ck_was || abs(ck_t0 - ck_exp) > 0.05);
ck_fate = slider31 * 0.01;
c = 0;
loop(NC,
  b_ = 42 + c * 28; cs_ = SCS + c * CSZ;
  arp_on = slider(b_) >= 0.5;
  // the arp switched off or the timeline jumped: its sounding notes stop
  (!arp_on && cs_[1]) || ck_jump ? (
    k_ = 0; loop(SPC[c], q_add(0, c, 0, SPN[c * 128 + k_], 0); k_ += 1; ); SPC[c] = 0;
  );
  // the arp switched on: notes played straight stop; off: the held chord sounds straight
  arp_on && !cs_[1] ? ch_all_off(c);
  !arp_on && cs_[1] ? ( k_ = 0; loop(nh, q_add(0, c, 1, SHN[k_] + slider(b_ + 5), SHV[k_]); k_ += 1; ); );
  cs_[1] = arp_on;
  arp_on && nh > 0 ? (
    L_ = arp_beats(floor(slider(b_ + 2) + 0.5)); md_ = floor(slider(b_ + 1) + 0.5); oc_ = floor(slider(b_ + 3) + 0.5);
    k = floor(ck_t0 / L_);
    k * L_ < ck_t0 ? k += 1;
    while (k * L_ < ck_t1) (
      tv_ = k * L_;
      ofs_ = floor((tv_ - ck_t0) / ck_bps);
      ck_fate > 0 ? ofs_ = max(ofs_ + floor((rand(2) - 1) * ck_fate * 0.004 * srate), 0);
      ofs_ = min(max(ofs_, 0), samplesblock - 1);
      kk_ = k + floor(slider(b_ + 6) + 0.5);
      md_ == 6 ? (
        // CHORD: the whole chord, each step an octave on in turn
        i_ = 0; loop(nh, n_ = SHN[i_] + 12 * (kk_ % oc_) + slider(b_ + 5);
          q_add(ofs_, c, 1, n_, SHV[i_]); pend_add(c, tv_ + L_ * slider(b_ + 4) * 0.01, n_); i_ += 1; );
      ) : (
        n_ = arp_note(c, kk_, md_, oc_) + slider(b_ + 5);
        q_add(ofs_, c, 1, n_, SHV[0]);
        pend_add(c, tv_ + L_ * slider(b_ + 4) * 0.01, n_);
      );
      cs_[2] = kk_; cs_[3] = time_precise();
      k += 1;
    );
  );
  // the arp's notes that end in this block (or every one, once the chord is gone and the arp has nothing to play)
  k_ = 0;
  while (k_ < SPC[c]) (
    SPO[c * 128 + k_] < ck_t1 ? (
      q_add(min(max(floor((SPO[c * 128 + k_] - ck_t0) / ck_bps), 0), samplesblock - 1), c, 0, SPN[c * 128 + k_], 0);
      SPC[c] -= 1; SPO[c * 128 + k_] = SPO[c * 128 + SPC[c]]; SPN[c * 128 + k_] = SPN[c * 128 + SPC[c]];
    ) : k_ += 1;
  );
  c += 1;
);
ck_was = ck_play; ck_exp = ck_t1;
!ck_play ? ck_fb = ck_t1;
ck_pos = ck_t0;

// ---------- the synth's shared values ----------
w1 = floor(slider1 + 0.5); w2 = floor(slider3 + 0.5);
mx2 = slider6 * 0.01; pw = slider7 * 0.01;
uni = slider26 * 0.01; uni_c = uni * 18; uni_n = 1 / (1 + uni * 0.6);               // unison: the twins +/- up to 18 cents
drv = (1 + slider25 * 0.06) * 0.7; drv_n = 1 / vo_tanh(drv);
fl_k = 1 - exp(-1 / (0.015 * srate));                       // CUTOFF / RESO / ENV glide per sample (res_q follows fl_rs)
raw = slider129 >= 0.5; npass = raw ? 1 : 2; osr = npass * srate;
glide_k = slider27 > 0 ? 1 - exp(-16 / (slider27 * 0.001 * srate)) : 1;
fa = 1 / max(1, slider13 * 0.001 * srate); fd = exp(-6.9 / (slider14 * 0.001 * srate)); fs_ = slider15 * 0.01; fr = exp(-6.9 / (slider16 * 0.001 * srate));
aa = 1 / max(1, slider17 * 0.001 * srate); ad = exp(-6.9 / (slider18 * 0.001 * srate)); as_ = slider19 * 0.01; ar = exp(-6.9 / (slider20 * 0.001 * srate));
synth_g = 10 ^ (slider28 / 20) * 0.58;
lfo_inc = slider22 / srate;
dm_ = slider31 * 0.01;

// ---------- each channel's delay unit: coefficients ----------
c = 0;
loop(NC,
  b_ = 42 + c * 28; cs_ = SCS + c * CSZ;
  cs_[10] = tan($pi * min(slider(b_ + 7), srate * 0.45) / srate);            // HPF g
  cs_[11] = tan($pi * min(slider(b_ + 8), srate * 0.45) / srate);            // LPF g
  dg_ = slider(b_ + 9); cs_[12] = 10 ^ (dg_ / 20); cs_[13] = dg_ > 0;         // drive / trim
  cs_[14] = 10 ^ (slider(b_ + 10) / 20) - 1; cs_[15] = 10 ^ (slider(b_ + 11) / 20) - 1;   // bass, treble
  cs_[37] = slider(b_ + 7) > 20.5; cs_[38] = slider(b_ + 8) < 19900; cs_[39] = abs(cs_[14]) > 0.001 || abs(cs_[15]) > 0.001;
  tdl_ = dly_beats(floor(slider(b_ + 12) + 0.5)) * 60 / max(tempo, 20) * srate;
  cs_[16] = min(tdl_, DLN - 8); cs_[17] = min(tdl_ * 1.012 + 0.0004 * srate, DLN - 8);   // left, right (a hair behind)
  cs_[18] = slider(b_ + 13) * 0.01; cs_[19] = slider(b_ + 14) * 0.01;
  cs_[20] = slider(b_ + 15) * 0.01;                                            // sat
  cs_[21] = slider(b_ + 16) >= 0.5; cs_[22] = slider(b_ + 17) * 0.01; cs_[23] = slider(b_ + 18) / srate;
  cs_[24] = slider(b_ + 19) * 0.01; cs_[25] = slider(b_ + 20) >= 0.5; cs_[26] = 1 / (trem_beats(floor(slider(b_ + 21) + 0.5)) * 60 / max(tempo, 20) * srate);
  cs_[27] = slider(b_ + 22) * 0.01; cs_[28] = slider(b_ + 23) >= 0.5; cs_[29] = 1 / (auto_beats(floor(slider(b_ + 24) + 0.5)) * 60 / max(tempo, 20) * srate);
  cm_ = slider(b_ + 25) * 0.01; cs_[30] = 10 ^ ((-6 - 24 * cm_) / 20); cs_[31] = 1 - 1 / (1 + 3 * cm_); cs_[32] = 10 ^ (cm_ * 9 / 20);
  cs_[33] = slider(b_ + 26) * 0.01;
  sol_ = slider130 >= 0.5 || slider131 >= 0.5 || slider132 >= 0.5;
  cs_[34] = slider(126 + c) >= 0.5 || (sol_ && slider(130 + c) < 0.5) ? 0 : 10 ^ (slider(b_ + 27) / 20) * (slider(b_ + 27) <= -59.9 ? 0 : 1);
  // where it sits: L and R out from the centre by SPREAD
  pos_ = (c - 1) * slider41 * 0.01;
  cs_[35] = sqrt(0.5 * (1 - pos_)) * 1.4142; cs_[36] = sqrt(0.5 * (1 + pos_)) * 1.4142;
  // the tremolo and auto phases lock to the song while it plays
  ck_play ? ( cs_[40] = beat_position / trem_beats(floor(slider(b_ + 21) + 0.5)); cs_[41] = beat_position / auto_beats(floor(slider(b_ + 24) + 0.5)); );
  c += 1;
);
fd_k = 1 - exp(-1 / (0.005 * srate));
cmp_a = 1 - exp(-1 / (0.008 * srate)); cmp_r = 1 - exp(-1 / (0.15 * srate));
// the master: tape <-> iron
mbl = slider39 * 0.01; mdr = slider40 * 0.01;
m_tg = 1 + 3 * mdr; m_tn = 1 / vo_tanh(m_tg) * (0.75 + 0.25 / m_tg);
m_tl = 1 - exp(-2 * $pi * (16000 - 8000 * mdr) / srate);
m_ig = 1 + 4 * mdr; m_is = 1 / sqrt(m_ig); m_lo = 1 - exp(-2 * $pi * 180 / srate);
qi = 0; spos = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
while (qi < nq && (SQO[qi] <= spos || spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  SQT[qi] == 1 ? ch_note_on(SQC[qi], SQN[qi], SQV[qi]) :
  SQT[qi] == 0 ? ch_note_off(SQC[qi], SQN[qi]) :
  ( c = 0; loop(NC, ch_all_off(c); c += 1; ); );
  qi += 1;
);
spos += 1;
// the filter's CUTOFF (two 15 ms stages), RESO and ENV glide, so a turned knob or automation never steps
!fl_ok ? ( fl_c1 = fl_c2 = log(slider8); fl_rs = slider9; fl_ev = slider10; fl_ok = 1; );
fl_c1 += (log(slider8) - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (slider9 - fl_rs) * fl_k; fl_ev += (slider10 - fl_ev) * fl_k;
res_q = 2 - 1.94 * fl_rs * 0.01;
lfo_ph += lfo_inc; lfo_ph -= floor(lfo_ph);
lfo_v = sin(2 * $pi * lfo_ph);
vib = lfo_v * (slider23 * 0.01 + sr_mw * 0.5) * 0.6;   // up to +/- 0.6 st (+ the wheel)
lfo_ct = lfo_v * slider24 * 0.01 * 2;                 // up to +/- 2 octaves

c = 0;
loop(NC,
  cs_ = SCS + c * CSZ;
  // ---------- the channel's voices ----------
  x = 0;
  i = 0;
  loop(NVC,
    p = SVB + (c * NVC + i) * VSZ;
    p[0] ? (
      // control every 16 samples: pitch (glide, LFO, drift, fate), the filter
      (p[25] -= 1) <= 0 ? (
        p[25] = 16;
        p[5] += (p[6] - p[5]) * glide_k;
        (p[27] == 0 || rand(1) < 16 / srate) ? p[27] = (rand(2) - 1) * 6 * dm_;
        p[26] += (p[27] - p[26]) * 0.002;
        pt = p[5] + slider2 * 12 + vib + (p[19] + p[26]) * 0.01;
        f1 = 440 * exp((pt - 69) * L12) / osr;
        f2 = 440 * exp((pt + slider4 + slider5 * 0.01 - 69) * L12) / osr;
        ud = exp(uni_c * 0.01 * L12);
        p[20] = min(f1, 0.45); p[21] = min(f2, 0.45); p[22] = min(f1 * ud, 0.45); p[23] = min(f2 / ud, 0.45);
        oct = fl_ev * 0.01 * 6 * p[11] * (1 - slider11 * 0.01 + slider11 * 0.01 * p[4]) + slider12 * 0.01 * (p[5] - 60) / 12 + lfo_ct;
        fc = min(max(exp(fl_c2 + oct * 0.693147), 20), 0.155 * osr);
        p[24] = 2 * sin($pi * fc / osr);
      );
      // the envelopes (per sample)
      st = p[12]; e = p[11];
      st == 1 ? ( e += fa; e >= 1 ? ( e = 1; st = 2; ); ) : st == 2 ? ( e = fs_ + (e - fs_) * fd; ) : st == 4 ? e *= fr;
      p[12] = st; p[11] = e;
      st = p[14]; a = p[13];
      st == 1 ? ( a += aa; a >= 1 ? ( a = 1; st = 2; ); ) : st == 2 ? ( a = as_ + (a - as_) * ad; ) : st == 4 ? ( a *= ar; a < 0.00002 ? ( st = 0; a = 0; ); );
      p[14] = st; p[13] = a;
      // two passes at twice the rate: the plain oscillators, the drive, the state-variable low-pass
      ff = p[24]; lo = p[15]; bd = p[16]; acc = 0;
      q1 = p[7]; q2 = p[8]; i1 = p[20]; i2 = p[21];
      uni > 0.001 ? ( q3 = p[9]; q4 = p[10]; i3 = p[22]; i4 = p[23]; );
      loop(npass,
        q1 += i1; q1 >= 1 ? q1 -= 1;
        o1 = w1 == 0 ? 2 * q1 - 1 : w1 == 1 ? (q1 < pw ? 1 : -1) : w1 == 2 ? (q1 < 0.5 ? 4 * q1 - 1 : 3 - 4 * q1) : sin(6.283185307 * q1);
        q2 += i2; q2 >= 1 ? q2 -= 1;
        o2 = w2 == 0 ? 2 * q2 - 1 : w2 == 1 ? (q2 < pw ? 1 : -1) : w2 == 2 ? (q2 < 0.5 ? 4 * q2 - 1 : 3 - 4 * q2) : sin(6.283185307 * q2);
        uni > 0.001 ? (
          q3 += i3; q3 >= 1 ? q3 -= 1;
          o1 = (o1 + (w1 == 0 ? 2 * q3 - 1 : w1 == 1 ? (q3 < pw ? 1 : -1) : w1 == 2 ? (q3 < 0.5 ? 4 * q3 - 1 : 3 - 4 * q3) : sin(6.283185307 * q3)) * uni) * uni_n;
          q4 += i4; q4 >= 1 ? q4 -= 1;
          o2 = (o2 + (w2 == 0 ? 2 * q4 - 1 : w2 == 1 ? (q4 < pw ? 1 : -1) : w2 == 2 ? (q4 < 0.5 ? 4 * q4 - 1 : 3 - 4 * q4) : sin(6.283185307 * q4)) * uni) * uni_n;
        );
        xi = (o1 + (o2 - o1) * mx2) * drv; xi = xi * (27 + xi * xi) / (27 + 9 * xi * xi) * drv_n;
        lo += ff * bd; bd += ff * (xi - lo - res_q * bd);
        bd = min(max(bd, -3), 3);
        acc += lo;
      );
      p[7] = q1; p[8] = q2;
      uni > 0.001 ? ( p[9] = q3; p[10] = q4; );
      p[15] = lo; p[16] = bd;
      raw ? y = acc : ( y = acc * 0.5; p[28] += (y - p[28]) * 0.62; y = p[28]; );   // folded down: a plain one-pole
      y = y * a * (1 - slider21 * 0.01 + slider21 * 0.01 * p[4]) + p[17];
      p[17] *= 0.993;
      p[18] = y;
      x += y;
      p[14] == 0 && abs(p[17]) < 0.00002 ? ( p[0] = 0; p[17] = 0; p[18] = 0; );
    );
    i += 1;
  );
  x *= synth_g;

  // ---------- INPUT: drive / trim, HPF, LPF ----------
  x *= cs_[12]; cs_[13] ? x = vo_tanh(x);
  hon_ = cs_[37]; lon_ = cs_[38];
  c == 0 ? ( hon_ ? x = h0.svf(x, cs_[10], 1.4142, 2); lon_ ? x = l0.svf(x, cs_[11], 1.4142, 1); ) :
  c == 1 ? ( hon_ ? x = h1.svf(x, cs_[10], 1.4142, 2); lon_ ? x = l1.svf(x, cs_[11], 1.4142, 1); ) :
           ( hon_ ? x = h2.svf(x, cs_[10], 1.4142, 2); lon_ ? x = l2.svf(x, cs_[11], 1.4142, 1); );
  // ---------- EQ: broad Baxandall shelves (lows below ~250 Hz, highs above ~3 kHz) ----------
  cs_[39] ? (
    c == 0 ? ( eb = b0.op(x, 0.033); et = x - t0.op(x, 0.33); ) : c == 1 ? ( eb = b1.op(x, 0.033); et = x - t1.op(x, 0.33); ) : ( eb = b2.op(x, 0.033); et = x - t2.op(x, 0.33); );
    x += cs_[14] * eb + cs_[15] * et;
  );
  // ---------- DELAY: two lines (the right a hair behind), the repeats through a soft tone ----------
  dl_ = SDL + c * 2 * DLN; dr_ = dl_ + DLN; w_ = cs_[42];
  rp = w_ - cs_[16]; rp < 0 ? rp += DLN; ri = floor(rp); rf = rp - ri; yl = dl_[ri] + (dl_[(ri + 1) % DLN] - dl_[ri]) * rf;
  rp = w_ - cs_[17]; rp < 0 ? rp += DLN; ri = floor(rp); rf = rp - ri; yr = dr_[ri] + (dr_[(ri + 1) % DLN] - dr_[ri]) * rf;
  // the repeats darken and thin a little each time round
  c == 0 ? ( fl = f0l.op(yl, 0.45); fr_ = f0r.op(yr, 0.45); fl -= g0l.op(fl, 0.008); fr_ -= g0r.op(fr_, 0.008); ) :
  c == 1 ? ( fl = f1l.op(yl, 0.45); fr_ = f1r.op(yr, 0.45); fl -= g1l.op(fl, 0.008); fr_ -= g1r.op(fr_, 0.008); ) :
           ( fl = f2l.op(yl, 0.45); fr_ = f2r.op(yr, 0.45); fl -= g2l.op(fl, 0.008); fr_ -= g2r.op(fr_, 0.008); );
  dl_[w_] = vo_tanh(x + fl * cs_[18]); dr_[w_] = vo_tanh(x + fr_ * cs_[18]);
  cs_[42] = (w_ + 1) % DLN;
  sl = x * (1 - cs_[19] * 0.5) + yl * cs_[19]; sr = x * (1 - cs_[19] * 0.5) + yr * cs_[19];
  // ---------- FX ----------
  // SAT: tape saturation and its soft top
  cs_[20] > 0.001 ? (
    sg_ = 1 + cs_[20] * 4; sn_ = 1 / vo_tanh(sg_) * (0.7 + 0.3 / sg_);
    sl = vo_tanh(sl * sg_) * sn_; sr = vo_tanh(sr * sg_) * sn_;
    ta_ = 1 - exp(-2 * $pi * (18000 - 11000 * cs_[20]) / srate);
    c == 0 ? ( sl = s0l.op(sl, ta_); sr = s0r.op(sr, ta_); ) : c == 1 ? ( sl = s1l.op(sl, ta_); sr = s1r.op(sr, ta_); ) : ( sl = s2l.op(sl, ta_); sr = s2r.op(sr, ta_); );
  );
  // MOD: chorus (two short lines swept in quadrature) or phaser (four allpasses a side)
  cs_[22] > 0.001 ? (
    cs_[43] += cs_[23]; cs_[43] -= floor(cs_[43]);
    ml = sin(2 * $pi * cs_[43]); mr = cos(2 * $pi * cs_[43]);
    !cs_[21] ? (
      ch_ = SCH + c * 2 * CHN; cw_ = cs_[44];
      ch_[cw_] = sl; ch_[CHN + cw_] = sr;
      rp = cw_ - (0.007 + 0.0035 * cs_[22] * ml) * srate; rp < 0 ? rp += CHN; ri = floor(rp); rf = rp - ri;
      cl_ = ch_[ri] + (ch_[(ri + 1) % CHN] - ch_[ri]) * rf;
      rp = cw_ - (0.0075 + 0.0035 * cs_[22] * mr) * srate; rp < 0 ? rp += CHN; ri = floor(rp); rf = rp - ri;
      cr_ = ch_[CHN + ri] + (ch_[CHN + (ri + 1) % CHN] - ch_[CHN + ri]) * rf;
      cs_[44] = (cw_ + 1) % CHN;
      sl = sl * (1 - 0.35 * cs_[22]) + cl_ * 0.7 * cs_[22]; sr = sr * (1 - 0.35 * cs_[22]) + cr_ * 0.7 * cs_[22];
    ) : (
      al_ = tan($pi * min(250 * 2 ^ (3.3 * (0.5 + 0.5 * ml)), srate * 0.4) / srate); al_ = (al_ - 1) / (al_ + 1);
      ar_ = tan($pi * min(250 * 2 ^ (3.3 * (0.5 + 0.5 * mr)), srate * 0.4) / srate); ar_ = (ar_ - 1) / (ar_ + 1);
      pl_ = sl + cs_[45] * 0.35; pr_ = sr + cs_[46] * 0.35;
      c == 0 ? ( pl_ = a0a.ap1(a0b.ap1(a0c.ap1(a0d.ap1(pl_, al_), al_), al_), al_); pr_ = b0a.ap1(b0b.ap1(b0c.ap1(b0d.ap1(pr_, ar_), ar_), ar_), ar_); ) :
      c == 1 ? ( pl_ = a1a.ap1(a1b.ap1(a1c.ap1(a1d.ap1(pl_, al_), al_), al_), al_); pr_ = b1a.ap1(b1b.ap1(b1c.ap1(b1d.ap1(pr_, ar_), ar_), ar_), ar_); ) :
               ( pl_ = a2a.ap1(a2b.ap1(a2c.ap1(a2d.ap1(pl_, al_), al_), al_), al_); pr_ = b2a.ap1(b2b.ap1(b2c.ap1(b2d.ap1(pr_, ar_), ar_), ar_), ar_); );
      cs_[45] = pl_; cs_[46] = pr_;
      sl += pl_ * cs_[22]; sr += pr_ * cs_[22];
      sl /= 1 + cs_[22] * 0.6; sr /= 1 + cs_[22] * 0.6;
    );
  );
  // TREM: sine or (softened) square, in tempo
  cs_[24] > 0.001 ? (
    cs_[40] += cs_[26] / (ck_play ? 1 : 1); cs_[40] -= floor(cs_[40]);
    tq_ = cs_[25] ? ( tz_ = sin(2 * $pi * cs_[40]); tz_ = vo_tanh(tz_ * 6) / vo_tanh(6); 0.5 + 0.5 * tz_; ) : 0.5 + 0.5 * sin(2 * $pi * cs_[40]);
    tg_ = 1 - cs_[24] * tq_; sl *= tg_; sr *= tg_;
  );
  // AUTO: a slow pan, or a slow swell in level
  cs_[27] > 0.001 ? (
    cs_[41] += cs_[29]; cs_[41] -= floor(cs_[41]);
    az_ = sin(2 * $pi * cs_[41]);
    cs_[28] ? ( ag_ = 1 - cs_[27] * (0.5 - 0.5 * az_); sl *= ag_; sr *= ag_; ) :
              ( sl *= 1 - cs_[27] * max(az_, 0); sr *= 1 + cs_[27] * min(az_, 0); );
  );
  // ---------- OUTPUT: COMP (stereo-linked), WIDTH ----------
  cs_[31] > 0.001 ? (
    lv_ = max(abs(sl), abs(sr));
    cs_[47] += (lv_ - cs_[47]) * (lv_ > cs_[47] ? cmp_a : cmp_r);
    cg_ = cs_[47] > cs_[30] ? (cs_[30] / cs_[47]) ^ cs_[31] : 1;
    sl *= cg_ * cs_[32]; sr *= cg_ * cs_[32];
  );
  mm_ = (sl + sr) * 0.5; ss_ = (sl - sr) * 0.5 * cs_[33];
  sl = mm_ + ss_; sr = mm_ - ss_;
  // the fader (glided, so MUTE and SOLO don't click), and where it sits
  cs_[49] += (cs_[34] - cs_[49]) * fd_k;
  cs_[48] = max(cs_[48] * 0.9995, max(abs(sl), abs(sr)) * cs_[49]);
  c == 0 ? ( o0l = sl * cs_[49]; o0r = sr * cs_[49]; ) : c == 1 ? ( o1l = sl * cs_[49]; o1r = sr * cs_[49]; ) : ( o2l = sl * cs_[49]; o2r = sr * cs_[49]; );
  c += 1;
);
// ---------- the mixer: each channel placed by SPREAD (its mid panned, its side kept) ----------
cs_ = SCS;
ml = 0; mr = 0;
xm_ = (o0l + o0r) * 0.5; xs_ = (o0l - o0r) * 0.5; ml += xm_ * cs_[35] + xs_; mr += xm_ * cs_[36] - xs_;
cs_ = SCS + CSZ;
xm_ = (o1l + o1r) * 0.5; xs_ = (o1l - o1r) * 0.5; ml += xm_ * cs_[35] + xs_; mr += xm_ * cs_[36] - xs_;
cs_ = SCS + 2 * CSZ;
xm_ = (o2l + o2r) * 0.5; xs_ = (o2l - o2r) * 0.5; ml += xm_ * cs_[35] + xs_; mr += xm_ * cs_[36] - xs_;
// ---------- TAPE <-> IRON ----------
tl_ = vo_tanh(ml * m_tg) * m_tn; tr_ = vo_tanh(mr * m_tg) * m_tn;
tl_ = mtl.op(tl_, m_tl); tr_ = mtr.op(tr_, m_tl);
lol = mil.op(ml, m_lo); lor = mir.op(mr, m_lo);
il_ = ml - lol + vo_tanh(lol * m_ig + 0.12 * mdr * lol * lol) * m_is; ir_ = mr - lor + vo_tanh(lor * m_ig + 0.12 * mdr * lor * lor) * m_is;
il_ = vo_tanh(il_ * (1 + mdr)) / (1 + mdr * 0.5); ir_ = vo_tanh(ir_ * (1 + mdr)) / (1 + mdr * 0.5);
ml = tl_ + (il_ - tl_) * mbl; mr = tr_ + (ir_ - tr_) * mbl;
ml -= dcl.op(ml, 0.0004); mr -= dcr.op(mr, 0.0004);
ml = ostL.ost_band(ml * sr_volt); mr = ostR.ost_band(mr * sr_volt);
ost_out(ml, mr);
spl0 = ost_l; spl1 = ost_r;
st_pk = max(st_pk, max(abs(spl0), abs(spl1)));

@gfx 1200 1040
ui_thm = 5; ui_hw = 1;
ui_begin(1200, 1040);

// ---------- the card's colours: a late-90s silver-grey software face, night-navy title bars, the star's gold ----------
SC_BG = 0xA9ACB0; SC_FACE = 0xC3C6CA; SC_FACEL = 0xD4D7DB; SC_HI = 0xF4F6F8; SC_SH = 0x707479; SC_DK = 0x26282C;
SC_TXT = 0x111316; SC_TXTD = 0x4A4E54; SC_NAV1 = 0x0B1D52; SC_NAV2 = 0x3566B8; SC_GOLD = 0xF2CF5B; SC_GOLDL = 0xFFE9A0;
SC_NIGHT = 0x0A1424; SC_LCDT = 0xBFE6FF; SC_LCDD = 0x31506E; SC_ARC = 0x22408E; SC_WELL = 0xB7BABE;

sc != sc_calsc ? (
  sc_calsc = sc;
  sc_f11 = ui_fitfont(11, 12 * sc);
  sc_f12 = ui_fitfont(12, 14 * sc);
  sc_f13 = ui_fitfont(13, 13.5 * sc);
);
gfx_setfont(11, "Trebuchet MS", sc_f11, 'b'); gfx_setfont(12, "Trebuchet MS", sc_f12, 'b');
gfx_setfont(13, "Trebuchet MS", sc_f13, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');
gfx_setfont(15, "Georgia", 13 * sc, 'b');

// ---------- drawing helpers (base coordinates) ----------
function sc_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function sc_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function sc_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function sc_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function sc_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function sc_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function sc_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function sc_ln(x1, y1, x2, y2, w) ( sc_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function sc_arcw(cx, cy, r, a1, a2, w) local(k) ( ui_ssarc(cx, cy, r, a1, a2, w); );   // (supersampled: an even ring)
// the bevel of the period: light top-left, dark bottom-right (raised), or the reverse (sunken)
function sc_bevel(x, y, w, h, sunk) (
  ui_col(sunk ? SC_SH : SC_HI); sc_r(x, y, w, 1); sc_r(x, y, 1, h);
  ui_col(sunk ? SC_HI : SC_SH); sc_r(x, y + h - 1, w, 1); sc_r(x + w - 1, y, 1, h);
);
// an eight-pointed star (the card's), radius r, the inner points at ri
function sc_star(cx, cy, r, ri) local(i, a, b, x1, y1, x2, y2, x3, y3) (
  i = 0;
  loop(8, a = i / 8 * 2 * $pi; b = a + $pi / 8;
    x1 = cx + sin(a) * r; y1 = cy - cos(a) * r;
    x2 = cx + sin(b) * ri; y2 = cy - cos(b) * ri; x3 = cx + sin(a - $pi / 8) * ri; y3 = cy - cos(a - $pi / 8) * ri;
    gfx_triangle(cx * sc, cy * sc, x3 * sc, y3 * sc, x1 * sc, y1 * sc, x2 * sc, y2 * sc);
    i += 1; );
);
// a window: a raised grey frame and a night-navy title bar (the gradient of the period)
function sc_win(x, y, w, h, title) (
  ui_col(SC_DK); sc_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(SC_FACE); sc_r(x, y, w, h);
  sc_bevel(x, y, w, h, 0); sc_bevel(x + 1, y + 1, w - 2, h - 2, 0);
  gfx_gradrect((x + 3) * sc, (y + 3) * sc, (w - 6) * sc, 18 * sc,
    ((SC_NAV1 >> 16) & 255) / 255, ((SC_NAV1 >> 8) & 255) / 255, (SC_NAV1 & 255) / 255, 1,
    ((((SC_NAV2 >> 16) & 255) - ((SC_NAV1 >> 16) & 255)) / 255) / ((w - 6) * sc), ((((SC_NAV2 >> 8) & 255) - ((SC_NAV1 >> 8) & 255)) / 255) / ((w - 6) * sc),
    (((SC_NAV2 & 255) - (SC_NAV1 & 255)) / 255) / ((w - 6) * sc), 0, 0, 0, 0, 0);
  strlen(title) ? ( gfx_setfont(12); ui_col(0xFFFFFF); sc_t(x + 9, y + 4, title); );
);
function sc_cap(x, y, s) ( gfx_setfont(11); ui_col(SC_TXTD); sc_t(x, y, s); );
function sc_capc(cx, y, s) ( gfx_setfont(11); ui_col(SC_TXTD); sc_tc(cx, y, s); );
function sc_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(SC_DK); gfx_rect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 4 * sc);
  ui_col(0xFFFFE1); gfx_rect(cx * sc - tw * 0.5 - 5 * sc, y * sc + 1 * sc, tw + 10 * sc, th + 2 * sc);   // the tooltip yellow
  ui_col(SC_TXT); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);
// the knob: a dark plastic cap with a silver skirt and a white line, the value as a navy arc
function sc_kcap(cx, cy, r, n, bip) local(rr, a, a0, ca, sa, w) (
  rr = r + 4.5 * sc; w = 2.4 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(0x8E9298); sc_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.2 * sc);
  ui_col(SC_ARC);
  bip ? ( abs(n - 0.5) > 0.004 ? sc_arcw(cx, cy, rr, min(a, 0), max(a, 0), w); ) :
        ( n > 0.004 ? sc_arcw(cx, cy, rr, a0, a, w); );
  ui_cola(0x000000, 0.25); gfx_circle(cx + 1.5 * sc, cy + 2 * sc, r, 1, 1);
  ui_col(0xE6E8EB); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0x7C8086); gfx_circle(cx + 0.6 * sc, cy + 0.6 * sc, r - 1.2 * sc, 1, 1);
  ui_col(0x34373C); gfx_circle(cx, cy, r * 0.78, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx - r * 0.18, cy - r * 0.2, r * 0.42, 1, 1);
  ui_col(0xF4F6F8); sc_lnp(cx + ca * r * 0.2, cy + sa * r * 0.2, cx + ca * r * 0.74, cy + sa * r * 0.74, max(1.8 * sc, r * 0.11));
);
function sc_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - sc_lt < 0.35 && sc_lid == did && !sc_mv) || (mouse_cap & 4) ? ( sc_set(idx, def); drag_id = -1; sc_lt = 0; ) : (
      drag_id = did; sc_ky = mouse_y; sc_ky0 = mouse_y; sc_mv = 0; sc_lt = time_precise(); sc_lid = did;
      sc_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !sc_mv && abs(mouse_y - sc_ky0) > 3 * sc ? ( sc_mv = 1; sc_ky = mouse_y; );
  drag_id == did && sc_mv ? (
    sc_kn = min(max(sc_kn + (sc_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); sc_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ sc_kn : lo + sc_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? sc_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    sc_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  sc_kcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), lo < 0 && hi > 0);
  (hov || drag_id == did) && strlen(fmt) ? ( sprintf(#sc_vv, fmt, v); sc_pill(cx, cy + r + 5, #sc_vv); ) :
  strlen(label) ? ( gfx_setfont(11); ui_col(SC_TXT); sc_tc(cx, cy + r + 13, label); );
);
// a push button of the period: raised grey, pressed in (with a gold lamp) when on
function sc_key(x, y, w, h, on, s) local(hov, hit) (
  hov = sc_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(SC_DK); sc_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(on ? SC_WELL : hov ? SC_FACEL : SC_FACE); sc_r(x, y, w, h);
  sc_bevel(x, y, w, h, on);
  on ? ( ui_col(SC_GOLD); gfx_circle((x + 7) * sc, (y + h * 0.5) * sc, 2.6 * sc, 1, 1); ui_cola(SC_GOLDL, 0.6); gfx_circle((x + 6.4) * sc, (y + h * 0.5 - 0.6) * sc, 1 * sc, 1, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? SC_NAV1 : SC_TXT); sc_tc(x + w * 0.5 + (on ? 4 : 0), y + h * 0.5 + (on ? 0.5 : 0), s); );
  hit;
);
// a small title-bar key: S (gold when on) or M (red when on)
function sc_tkey(x, y, w, h, on, s, col) local(hov, hit) (
  hov = sc_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(SC_DK); sc_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(on ? col : hov ? SC_FACEL : SC_FACE); sc_r(x, y, w, h);
  sc_bevel(x, y, w, h, on);
  gfx_setfont(11); ui_col(SC_TXT); sc_tc(x + w * 0.5 + (on ? 0.5 : 0), y + h * 0.5 + (on ? 0.5 : 0), s);
  hit;
);
function sc_keys(x, y, w, h, gap, idx, lo, n, labels) local(i) (
  i = 0;
  loop(n, sc_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == lo + i, pk_pitem(labels, i + 1, #sc_k)) ? sc_set(idx, lo + i); i += 1; );
);
// a drop-down field: white, sunken, the value and an arrow button; a click opens the list
function sc_field(x, y, w, h, idx, lo, list) local(hov, i, cur) (
  hov = sc_hov(x, y, w, h); cur = floor(slider(idx) + 0.5) - lo;
  ui_col(0xFFFFFF); sc_r(x, y, w, h); sc_bevel(x, y, w, h, 1);
  ui_col(SC_FACE); sc_r(x + w - h + 1, y + 2, h - 3, h - 4); sc_bevel(x + w - h + 1, y + 2, h - 3, h - 4, 0);
  ui_col(SC_TXT); gfx_triangle((x + w - h * 0.5 - 3.5) * sc, (y + h * 0.5 - 1.5) * sc, (x + w - h * 0.5 + 3.5) * sc, (y + h * 0.5 - 1.5) * sc, (x + w - h * 0.5) * sc, (y + h * 0.5 + 2) * sc);
  gfx_setfont(11); ui_col(SC_TXT); sc_t(x + 5, y + h * 0.5 - 6, pk_pitem(list, cur + 1, #sc_k));
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#sc_ml, ""); i = 0; loop(pk_pcount(list), i == cur ? strcat(#sc_ml, "!"); strcat(#sc_ml, pk_pitem(list, i + 1, #sc_mi)); strcat(#sc_ml, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#sc_ml);
    i > 0 ? sc_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( sc_set(idx, lo + min(max(cur + sign(mouse_wheel) * -1, 0), pk_pcount(list) - 1)); mouse_wheel = 0; );
);
// a trackbar of the period, vertical (ADSR) or horizontal (the faders): a sunken slot, a raised thumb
function sc_track(x, y, len, vert, idx, lo, hi, def, lg, fmt) local(v, n, hov, did, px, py, t) (
  did = 3000 + idx; v = slider(idx); n = min(max(lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo), 0), 1);
  hov = vert ? sc_hov(x - 10, y - 8, 20, len + 16) : sc_hov(x - 8, y - 10, len + 16, 20);
  ui_col(SC_DK); vert ? sc_r(x - 2, y, 4, len) : sc_r(x, y - 2, len, 4);
  vert ? sc_bevel(x - 2, y, 4, len, 1) : sc_bevel(x, y - 2, len, 4, 1);
  t = 0; loop(6, ui_col(SC_SH); vert ? sc_r(x + 8, y + t / 5 * len, 3, 1) : sc_r(x + t / 5 * len, y + 8, 1, 3); t += 1; );
  vert ? ( px = x; py = y + len - n * len; ) : ( px = x + n * len; py = y; );
  ui_col(SC_DK); vert ? sc_r(px - 8, py - 5, 16, 10) : sc_r(px - 5, py - 8, 10, 16);
  ui_col(hov || drag_id == did ? SC_FACEL : SC_FACE); vert ? sc_r(px - 7, py - 4, 14, 8) : sc_r(px - 4, py - 7, 8, 14);
  vert ? sc_bevel(px - 7, py - 4, 14, 8, 0) : sc_bevel(px - 4, py - 7, 8, 14, 0);
  ui_col(SC_ARC); vert ? sc_r(px - 5, py - 0.5, 10, 1) : sc_r(px - 0.5, py - 5, 1, 10);
  pressed && hov && drag_id == 0 ? (
    time_precise() - sc_lt < 0.35 && sc_lid == did ? ( sc_set(idx, def); drag_id = -1; sc_lt = 0; ) :
    ( drag_id = did; sc_fx0 = vert ? mouse_y : mouse_x; sc_fn = n; sc_lt = time_precise(); sc_lid = did; );
  );
  drag_id == did ? (
    t = vert ? (sc_fx0 - mouse_y) : (mouse_x - sc_fx0); sc_fx0 = vert ? mouse_y : mouse_x;
    sc_fn = min(max(sc_fn + t / (len * sc) * ((mouse_cap & 8) ? 0.15 : 1), 0), 1);
    v = lg ? lo * (hi / lo) ^ sc_fn : lo + sc_fn * (hi - lo);
    slider(idx) != v ? sc_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.02), 0), 1);
    sc_set(idx, lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo)); mouse_wheel = 0;
  );
  (hov || drag_id == did) ? ( sprintf(#sc_vv, fmt, slider(idx)); vert ? sc_pill(x, y + len + 6, #sc_vv) : sc_pill(x + len * 0.5, y + 10, #sc_vv); );
);

// ======================== the faceplate ========================
ui_col(SC_BG); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(SC_DK); sc_r(4, 4, 1192, 1032);
ui_col(SC_BG); sc_r(6, 6, 1188, 1028); sc_bevel(6, 6, 1188, 1028, 0);
// a faint grid of the period's dither on the panel
sc_i = 0; loop(60, ui_cola(0xFFFFFF, 0.05); sc_r(6, 60 + sc_i * 16.5, 1188, 1); sc_i += 1; );
// the header: the night sky, a few stars, the gold rule
ui_col(SC_NIGHT); sc_r(8, 8, 1184, 50);
sc_i = 0; loop(70, sc_sx = 10 + ui_hash(sc_i * 3.7) * 1180; sc_sy = 10 + ui_hash(sc_i * 9.1) * 46;
  ui_cola(0xFFFFFF, 0.15 + 0.5 * ui_hash(sc_i * 1.3)); gfx_circle(sc_sx * sc, sc_sy * sc, (0.5 + ui_hash(sc_i * 5.3)) * sc, 1, 1); sc_i += 1; );
ui_col(SC_GOLD); sc_r(8, 58, 1184, 2);
// the numeral: a silver ring, the night, the great star, XVII
ui_col(SC_DK); gfx_circle(600 * sc, 35 * sc, 30 * sc, 1, 1);
ui_col(0xD7DADE); gfx_circle(600 * sc, 35 * sc, 28 * sc, 1, 1);
ui_col(0x8E9298); gfx_circle(600 * sc, 35 * sc, 26 * sc, 0, 1);
ui_col(SC_NIGHT); gfx_circle(600 * sc, 35 * sc, 25 * sc, 1, 1);
ui_col(SC_GOLD); sc_star(600, 28, 13, 5);
ui_col(SC_GOLDL); gfx_circle(600 * sc, 28 * sc, 2 * sc, 1, 1);
gfx_setfont(15); ui_col(0xFFFFFF); sc_tc(600, 50, "XVII");
// presets
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
st_gk = pk_preset(22 * sc, 18 * sc, 330 * sc, 34 * sc, pr_cur, #sr_pm);
st_gk > 0 ? ( st_gk > sr_npre ? reset_all() : prs_dirty = st_gk; );
gfx_setfont(12); ui_col(SC_GOLD); sc_t(366, 18, "VIRTUAL ANALOGUE  ·  1999"); ui_col(0xB8C4D6); sc_t(366, 35, "THREE ARPS, THREE ECHOES");
pk_led(698 * sc, 35 * sc, 4.5 * sc, ins_midi_lit(), SC_GOLD);
gfx_setfont(11); ui_col(0xB8C4D6); sc_tc(698, 21, "MIDI");
sc_field(714, 23, 74, 24, 30, 0, "OMNI|CH 1|CH 2|CH 3|CH 4|CH 5|CH 6|CH 7|CH 8|CH 9|CH 10|CH 11|CH 12|CH 13|CH 14|CH 15|CH 16");
sc_key(798, 23, 62, 24, slider29 >= 0.5, "LATCH") ? sc_set(29, slider29 >= 0.5 ? 0 : 1);
sc_key(866, 23, 52, 24, slider129 >= 0.5, "RAW") ? sc_set(129, slider129 >= 0.5 ? 0 : 1);
ui_col(0x000000); sc_r(926, 23, 180, 24); ui_col(SC_LCDD); sc_r(927, 24, 178, 22);
gfx_setfont(11); ui_col(SC_LCDT);
nh > 0 ? sprintf(#sc_g, "%d NOTE%s HELD%s", nh, nh == 1 ? "" : "S", slider29 >= 0.5 ? "  ·  LATCHED" : "") :
         strcpy(#sc_g, slider29 >= 0.5 ? "LATCH  ·  PLAY A CHORD" : "PLAY A CHORD");
sc_tc(1016, 35, #sc_g);
ui_size_picker(1118 * sc, 26 * sc);

// ======================== the synthesiser ========================
sc_win(22, 70, 150, 250, "OSC 1");
sc_keys(32, 102, 62, 22, 6, 1, 0, 2, "SAW|SQUARE");
sc_key(32, 130, 62, 22, floor(slider1 + 0.5) == 2, "TRI") ? sc_set(1, 2);
sc_key(100, 130, 62, 22, floor(slider1 + 0.5) == 3, "SINE") ? sc_set(1, 3);
sc_cap(34, 172, "OCTAVE");
sc_keys(32, 190, 29, 22, 4, 2, -2, 4, "-2|-1|0|+1");
// the wave it makes
ui_col(0xFFFFFF); sc_r(32, 232, 130, 76); sc_bevel(32, 232, 130, 76, 1); ui_col(SC_NIGHT); sc_r(34, 234, 126, 72);
function sc_wave(w, ph, pw) ( w == 0 ? 2 * ph - 1 : w == 1 ? (ph < pw ? 1 : -1) : w == 2 ? (ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph) : sin(2 * $pi * ph); );
sc_i = 0; loop(121, sc_ph = sc_i / 120 * 2; sc_ph -= floor(sc_ph); sc_o = sc_wave(floor(slider1 + 0.5), sc_ph, slider7 * 0.01);
  sc_x = 37 + sc_i; sc_y = 270 - sc_o * 26;
  sc_i > 0 ? ( ui_col(SC_LCDT); sc_ln(sc_ox, sc_oy, sc_x, sc_y, 1.2); ); sc_ox = sc_x; sc_oy = sc_y; sc_i += 1; );

sc_win(180, 70, 186, 250, "OSC 2");
sc_keys(190, 102, 80, 22, 6, 3, 0, 2, "SAW|SQUARE");
sc_key(190, 130, 80, 22, floor(slider3 + 0.5) == 2, "TRI") ? sc_set(3, 2);
sc_key(276, 130, 80, 22, floor(slider3 + 0.5) == 3, "SINE") ? sc_set(3, 3);
sc_knob(228, 210, 22, 4, -12, 12, 0, 0, "SEMI", "%+.0f st", 1);
sc_knob(318, 210, 22, 5, -50, 50, 9, 0, "DETUNE", "%+.1f cents", 0);
ui_col(0xFFFFFF); sc_r(190, 258, 166, 50); sc_bevel(190, 258, 166, 50, 1); ui_col(SC_NIGHT); sc_r(192, 260, 162, 46);
sc_i = 0; loop(157, sc_ph = sc_i / 156 * 2 * 2 ^ ((slider4 + slider5 * 0.01) / 12); sc_ph -= floor(sc_ph); sc_o = sc_wave(floor(slider3 + 0.5), sc_ph, slider7 * 0.01);
  sc_x = 195 + sc_i; sc_y = 283 - sc_o * 18;
  sc_i > 0 ? ( ui_col(SC_LCDT); sc_ln(sc_ox, sc_oy, sc_x, sc_y, 1.2); ); sc_ox = sc_x; sc_oy = sc_y; sc_i += 1; );

sc_win(374, 70, 150, 250, "MIX");
sc_knob(414, 132, 20, 6, 0, 100, 50, 0, "OSC 1 · 2", "%.0f%%", 0);
sc_knob(486, 132, 17, 7, 5, 95, 50, 0, "PW", "%.0f%%", 0);
sc_knob(414, 240, 17, 26, 0, 100, 0, 0, "UNISON", "%.0f%%", 0);
sc_knob(486, 240, 17, 25, 0, 100, 15, 0, "DRIVE", "%.0f%%", 0);

sc_win(532, 70, 214, 250, "FILTER  ·  LOW-PASS");
sc_knob(590, 140, 28, 8, 40, 16000, 2400, 1, "CUTOFF", "%.0f Hz", 0);
sc_knob(684, 132, 19, 9, 0, 100, 30, 0, "RESO", "%.0f%%", 0);
sc_knob(566, 252, 15, 10, -100, 100, 45, 0, "ENV", "%+.0f%%", 0);
sc_knob(632, 252, 15, 12, 0, 100, 50, 0, "KEY", "%.0f%%", 0);
sc_knob(698, 252, 15, 11, 0, 100, 30, 0, "VEL", "%.0f%%", 0);

function sc_adsr(x, b, title) local(i) (
  sc_win(x, 70, 136, 250, title);
  sc_track(x + 22, 102, 168, 1, b, 1, 5000, b == 13 ? 3 : 2, 1, "%.1f ms");
  sc_track(x + 52, 102, 168, 1, b + 1, 5, 5000, b == 13 ? 420 : 500, 1, "%.0f ms");
  sc_track(x + 82, 102, 168, 1, b + 2, 0, 100, b == 13 ? 25 : 70, 0, "%.0f%%");
  sc_track(x + 112, 102, 168, 1, b + 3, 5, 5000, b == 13 ? 400 : 450, 1, "%.0f ms");
  i = 0; loop(4, sc_capc(x + 22 + i * 30, 296, pk_pitem("A|D|S|R", i + 1, #sc_k)); i += 1; );
);
sc_adsr(754, 13, "FILTER ENV");
sc_adsr(898, 17, "AMP ENV");

sc_win(1042, 70, 136, 250, "LFO · PLAY");
sc_knob(1076, 124, 16, 22, 0.05, 20, 4.5, 1, "RATE", "%.2f Hz", 0);
sc_knob(1144, 124, 16, 23, 0, 100, 0, 0, "PITCH", "%.0f%%", 0);
sc_knob(1076, 196, 16, 24, 0, 100, 0, 0, "CUTOFF", "%.0f%%", 0);
sc_knob(1144, 196, 16, 27, 0, 1000, 0, 0, "GLIDE", "%.0f ms", 0);
sc_knob(1076, 268, 16, 21, 0, 100, 50, 0, "VEL", "%.0f%%", 0);
sc_knob(1144, 268, 16, 28, -24, 6, 0, 0, "LEVEL", "%+.1f dB", 0);

// ======================== the three channels ========================
sc_c = 0;
loop(3,
  sc_ox = 22 + sc_c * 388; sc_b = 42 + sc_c * 28; sc_cs = SCS + sc_c * CSZ;
  sc_win(sc_ox, 330, 380, 538, pk_pitem("L  ·  LEFT|C  ·  CENTRE|R  ·  RIGHT", sc_c + 1, #sc_k2));
  // its star lights as it plays
  sc_lit = time_precise() - sc_cs[3] < 0.08;
  ui_col(sc_lit ? SC_GOLD : 0x5C6E96); sc_star(sc_ox + 312, 341, 7, 3);
  sc_tkey(sc_ox + 328, 334, 20, 15, slider(130 + sc_c) >= 0.5, "S", SC_GOLD) ? sc_set(130 + sc_c, slider(130 + sc_c) >= 0.5 ? 0 : 1);
  sc_tkey(sc_ox + 352, 334, 20, 15, slider(126 + sc_c) >= 0.5, "M", 0xE0504A) ? sc_set(126 + sc_c, slider(126 + sc_c) >= 0.5 ? 0 : 1);
  // ---------- ARP ----------
  sc_cap(sc_ox + 12, 360, "ARPEGGIATOR");
  sc_key(sc_ox + 12, 378, 64, 24, slider(sc_b) >= 0.5, "ARP") ? sc_set(sc_b, slider(sc_b) >= 0.5 ? 0 : 1);
  sc_field(sc_ox + 86, 379, 110, 22, sc_b + 1, 0, "UP|DOWN|UP-DN|DN-UP|RANDOM|PLAYED|CHORD");
  sc_field(sc_ox + 204, 379, 76, 22, sc_b + 2, 0, "1/4|1/8|1/8T|1/16|1/16T|1/32|1/4T|1/8D");
  slider(sc_b) < 0.5 ? ( gfx_setfont(11); ui_col(SC_TXTD); sc_t(sc_ox + 290, 384, "PLAYS HELD"); );
  sc_knob(sc_ox + 44, 444, 15, sc_b + 3, 1, 4, 1, 0, "OCT", "%.0f", 1);
  sc_knob(sc_ox + 118, 444, 15, sc_b + 4, 10, 200, 60, 0, "GATE", "%.0f%%", 0);
  sc_knob(sc_ox + 192, 444, 15, sc_b + 5, -24, 24, 0, 0, "TRANS", "%+.0f st", 1);
  sc_knob(sc_ox + 266, 444, 15, sc_b + 6, 0, 15, 0, 0, "OFFSET", "%.0f steps", 1);
  // where the walk is: a row of small stars, the current one lit
  sc_i = 0; loop(8, ui_col(sc_lit && (sc_cs[2] % 8) == sc_i ? SC_GOLD : 0x8E9298); sc_star(sc_ox + 322 + (sc_i & 1) * 22, 422 + floor(sc_i / 2) * 14, 4.5, 2); sc_i += 1; );
  ui_col(SC_SH); sc_r(sc_ox + 10, 482, 360, 1); ui_col(SC_HI); sc_r(sc_ox + 10, 483, 360, 1);
  gfx_setfont(12); ui_col(SC_NAV1); sc_t(sc_ox + 12, 488, "DELAY UNIT");
  // ---------- INPUT · EQ ----------
  sc_cap(sc_ox + 12, 510, "INPUT"); sc_cap(sc_ox + 236, 510, "EQ");
  sc_knob(sc_ox + 36, 548, 14, sc_b + 7, 20, 2000, 20, 1, "HPF", "%.0f Hz", 0);
  sc_knob(sc_ox + 100, 548, 14, sc_b + 8, 500, 20000, 20000, 1, "LPF", "%.0f Hz", 0);
  sc_knob(sc_ox + 164, 548, 14, sc_b + 9, -12, 12, 0, 0, "DRIVE", "%+.1f dB", 0);
  sc_knob(sc_ox + 260, 548, 14, sc_b + 10, -12, 12, 0, 0, "BASS", "%+.1f dB", 0);
  sc_knob(sc_ox + 330, 548, 14, sc_b + 11, -12, 12, 0, 0, "TREBLE", "%+.1f dB", 0);
  // ---------- DELAY ----------
  sc_cap(sc_ox + 12, 592, "DELAY");
  sc_field(sc_ox + 12, 610, 76, 22, sc_b + 12, 0, "1/32|1/16T|1/16|1/8T|1/16D|1/8|1/4T|1/8D|1/4|1/2T|1/4D|1/2");
  sc_knob(sc_ox + 124, 622, 14, sc_b + 13, 0, 95, 35, 0, "FEEDBACK", "%.0f%%", 0);
  sc_knob(sc_ox + 188, 622, 14, sc_b + 14, 0, 100, 25, 0, "MIX", "%.0f%%", 0);
  // the echoes: a field of stars fading away along the beats
  ui_col(0xFFFFFF); sc_r(sc_ox + 222, 600, 148, 46); sc_bevel(sc_ox + 222, 600, 148, 46, 1); ui_col(SC_NIGHT); sc_r(sc_ox + 224, 602, 144, 42);
  sc_dt = dly_beats(floor(slider(sc_b + 12) + 0.5)); sc_a = slider(sc_b + 14) * 0.01; sc_i = 0;
  loop(12, sc_x = sc_ox + 230 + sc_i * sc_dt * 34; sc_x < sc_ox + 364 ? (
    ui_cola(sc_i == 0 ? 0xFFFFFF : SC_GOLD, sc_i == 0 ? 0.9 : min(sc_a * (slider(sc_b + 13) * 0.01) ^ (sc_i - 1) * 1.6, 1));
    sc_star(sc_x, 623, sc_i == 0 ? 6 : 5, 2); ); sc_i += 1; );
  // ---------- FX ----------
  ui_col(SC_SH); sc_r(sc_ox + 10, 666, 360, 1); ui_col(SC_HI); sc_r(sc_ox + 10, 667, 360, 1);
  sc_cap(sc_ox + 12, 672, "SAT"); sc_cap(sc_ox + 80, 672, "MOD");
  sc_knob(sc_ox + 36, 710, 14, sc_b + 15, 0, 100, 0, 0, "TAPE", "%.0f%%", 0);
  sc_keys(sc_ox + 80, 690, 66, 20, 4, sc_b + 16, 0, 2, "CHORUS|PHASER");
  sc_knob(sc_ox + 252, 710, 14, sc_b + 17, 0, 100, 0, 0, "AMOUNT", "%.0f%%", 0);
  sc_knob(sc_ox + 318, 710, 14, sc_b + 18, 0.05, 8, 0.6, 1, "RATE", "%.2f Hz", 0);
  // TREMOLO and AUTO side by side: depth, the shape (or what it moves), the rate
  sc_cap(sc_ox + 12, 748, "TREMOLO"); sc_cap(sc_ox + 132, 748, "AUTO");
  sc_knob(sc_ox + 32, 786, 13, sc_b + 19, 0, 100, 0, 0, "DEPTH", "%.0f%%", 0);
  sc_key(sc_ox + 58, 768, 58, 18, floor(slider(sc_b + 20) + 0.5) == 0, "SINE") ? sc_set(sc_b + 20, 0);
  sc_key(sc_ox + 58, 790, 58, 18, floor(slider(sc_b + 20) + 0.5) == 1, "SQUARE") ? sc_set(sc_b + 20, 1);
  sc_field(sc_ox + 12, 826, 104, 20, sc_b + 21, 0, "1/2|1/4|1/8|1/16|1/4T|1/8T|1/8D");
  sc_knob(sc_ox + 152, 786, 13, sc_b + 22, 0, 100, 0, 0, "DEPTH", "%.0f%%", 0);
  sc_key(sc_ox + 178, 768, 58, 18, floor(slider(sc_b + 23) + 0.5) == 0, "PAN") ? sc_set(sc_b + 23, 0);
  sc_key(sc_ox + 178, 790, 58, 18, floor(slider(sc_b + 23) + 0.5) == 1, "VOLUME") ? sc_set(sc_b + 23, 1);
  sc_field(sc_ox + 132, 826, 104, 20, sc_b + 24, 0, "1/2 BAR|1 BAR|2 BARS|4 BARS|8 BARS|1/4");
  // ---------- OUTPUT ----------
  ui_col(SC_SH); sc_r(sc_ox + 250, 748, 1, 112); ui_col(SC_HI); sc_r(sc_ox + 251, 748, 1, 112);
  sc_cap(sc_ox + 262, 748, "OUTPUT");
  sc_knob(sc_ox + 286, 800, 15, sc_b + 25, 0, 100, 0, 0, "COMP", "%.0f%%", 0);
  sc_knob(sc_ox + 344, 800, 15, sc_b + 26, 0, 200, 100, 0, "WIDTH", "%.0f%%", 1);
  sc_c += 1;
);

// ======================== the mixer ========================
sc_win(22, 878, 1156, 96, "MIXER");
sc_c = 0;
loop(3,
  sc_x = 36 + sc_c * 262; sc_cs = SCS + sc_c * CSZ;
  gfx_setfont(12); ui_col(SC_TXT); sc_t(sc_x, 912, pk_pitem("L|C|R", sc_c + 1, #sc_k));
  sc_track(sc_x + 24, 920, 150, 0, 69 + sc_c * 28, -60, 6, sc_c == 1 ? -8 : -3, 0, "%+.1f dB");
  sc_key(sc_x + 186, 909, 46, 22, slider(126 + sc_c) >= 0.5, "MUTE") ? sc_set(126 + sc_c, slider(126 + sc_c) >= 0.5 ? 0 : 1);
  // its level
