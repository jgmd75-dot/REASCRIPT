in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-empress";
ext_noinit = 1;
s57_mem = 0;

// ---------- memory ----------
EMVN = 8; EMVS = 64; EMV = s57_alloc(EMVN * EMVS);      // the pad voices (OSC 1 and OSC 2 together)
// pad voice slots (q = EMV + v * EMVS): 0 on  1 note  2 velocity gain  3 key down  4 age  5 the note's frequency
//   6 key tracking (octaves from C4)  layer 1 from 8, layer 2 from 32 (L = q + 8 / q + 32):
//   L0 stage (0 off, 1 A, 2 D/S, 4 R)  L1 level  L2 phase  L3 sub flip  L4 .. L7 ladder  L8 g  L9 g target
//   L10 increment  L11 the note's own detune  L12 resonance easing
EMLN = 8; EMLS = 48; EML = s57_alloc(EMLN * EMLS);      // the lead voices (OSC 3)
// lead slots: 0 on  1 note  2 velocity gain  3 key down  4 age  5 stage  6 level  7 pitch now (st)  8 pitch target
//   9 phase A  10 phase B  11 .. 14 ladder  15 filter envelope  16 inc A  17 inc B  18 g  19 g target  20 vibrato fade
//   21 the note's detune  22 resonance easing
EMC = s57_alloc(3 * 48);                                 // the three layers' parameters (C = EMC + ch * 48)
// C: 1 on (faded)  2 saw / A-pulse  3 pulse / B-pulse  4 pw  5 pwm depth / mix  6 lfo phase  7 lfo inc  8 pw now
//   9 sub / filter-env decay  10 noise / B ratio  11 cutoff  12 resonance k  13 its make-up  14 attack inc  15 decay k
//   16 sustain  17 release k  18 pitch multiplier  19 cutoff offset (oct)  20 env amount  21 level  22 pan L  23 pan R
//   24 duck gain  25 its step  26 key  27 key tracking; targets from 30
EMQ = s57_alloc(1024);                                   // the note queue: offset, on, note, velocity
EMHN = s57_alloc(128);                                   // keys down (OSC 3 mono / legato)
EMH = s57_alloc(256); EMK = s57_alloc(256);              // the last bar: the duck envelope, the kick's hits
EMAP = s57_alloc(32);                                    // the phaser's all-passes (x, y per stage, L and R)
EMXC = s57_alloc(32);                                    // the crossovers' coefficients (LP1, HP1, LP2, HP2, AP2)
EMDEF = s57_alloc(128); EMTMP = s57_alloc(256);
EMCL = s57_alloc(8192); EMCR = s57_alloc(8192);          // the chorus lines
EMDL = s57_alloc(262144); EMDR = s57_alloc(262144);      // the delay lines
emr0.s57_dlinit(16384); emr1.s57_dlinit(16384); emr2.s57_dlinit(16384); emr3.s57_dlinit(16384);
emr4.s57_dlinit(16384); emr5.s57_dlinit(16384); emr6.s57_dlinit(16384); emr7.s57_dlinit(16384);
emra.s57_dlinit(4096); emrb.s57_dlinit(4096); emrc.s57_dlinit(4096); emrd.s57_dlinit(4096);
EMRL = s57_alloc(8); EMRD = s57_alloc(8); EMRG = s57_alloc(8); EMRY = s57_alloc(8); EMRP = s57_alloc(8);
EMRL[0] = 37.1; EMRL[1] = 43.9; EMRL[2] = 51.3; EMRL[3] = 59.7; EMRL[4] = 67.1; EMRL[5] = 75.9; EMRL[6] = 83.3; EMRL[7] = 97.7;

ost_init(0); emoL.ost_ch_init(); emoR.ost_ch_init();
ins_drift_init();
// FATE: breathing growth - each pad layer's detune, pulse width and filter, the three autopan rates
em_dD1.drift_init(0.7 + rand(0.4)); em_dD2.drift_init(0.7 + rand(0.4)); em_dW1.drift_init(0.6 + rand(0.4)); em_dW2.drift_init(0.6 + rand(0.4));
em_dC1.drift_init(0.5 + rand(0.4)); em_dC2.drift_init(0.5 + rand(0.4)); em_dC3.drift_init(0.5 + rand(0.4));
em_dP0.drift_init(0.5 + rand(0.3)); em_dP1.drift_init(0.6 + rand(0.3)); em_dP2.drift_init(0.7 + rand(0.3));

// ---------- the presets: the Init values and each preset's changes ----------
#em_def = "1 80 -20 0 80 0 50 0 0.5 35 0 1500 15 20 0.6 1.5 80 2.5 5 -4 1 60 20 1 0 80 50 60 0.7 0 3 2600 10 15 0.9 2 85 3 5 6 0 70 0 0 0 0 0 7 50 50 2200 25 45 0.35 0.003 0.3 85 0.4 0 2 8 0 1 0 0 50 420 300 60 1 0 0.25 70 35 1 250 2500 0.07 15 0.19 45 0.31 70 1 1 3 40 3500 18 4 1 65 3.5 45 22 6 50 -6 0 40 0 30 120 6000 -0.3 1 60 0";
function em_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
function em_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
em_nums(#em_def, EMDEF);
#em_pm = "Init|Fields of Wheat|Venus Rising|Deep Garden|Harvest Moon|Moss and Honey|Fertile Pump|Gilded Lead|Abundance|Sunday Morning House|The Orchard|Earth Mother";
function em_pstr(p) (
  p == 2  ? "3:-35 5:60 6:30 7:40 8:35 9:0.18 10:20 12:1100 14:10 15:2.5 16:4 17:90 18:6 19:0 23:35 26:70 28:75 29:0.33 32:3200 35:3 36:4 37:90 38:7 39:0 40:9 70:3 76:220 78:0.05 79:20 80:0.13 81:70 82:0.21 83:95 89:16 90:0 92:85 93:8 94:35 95:42 96:0 107:53.9" :
  p == 3  ? "2:55 12:1200 15:1.2 19:3 22:40 32:2000 35:1.5 39:3 41:1 42:75 47:12 48:5 49:35 51:1800 52:30 53:40 54:0.5 55:0.02 56:0.6 57:80 58:0.8 59:25 60:2 61:12 62:0 86:3 87:45 89:22 90:3 93:4.5 95:26 96:4 107:71.0" :
  p == 4  ? "2:85 5:90 10:45 12:620 13:42 14:35 15:0.01 16:0.6 17:70 18:0.35 19:8 22:45 24:0 26:60 28:30 29:0.45 32:1500 33:30 35:0.02 36:0.8 37:75 38:0.4 39:8 70:1 79:5 81:35 83:60 86:3 87:35 88:2600 89:20 90:7 95:14 96:8 107:81.4" :
  p == 5  ? "5:40 6:50 7:35 8:40 9:0.12 10:10 12:900 13:25 15:3 16:5 17:85 18:8 19:0 24:2 26:60 28:80 29:0.21 32:4200 35:4 37:80 38:9 39:0 70:2 71:1 72:0.06 73:85 74:55 79:25 81:65 83:90 84:0.6 89:12 90:0 92:90 93:11 94:55 95:45 96:0 107:64.4" :
  p == 6  ? "2:75 5:30 6:70 7:30 8:20 9:0.4 10:40 12:1300 13:20 15:0.15 17:85 18:1.2 19:6 24:0 25:50 26:40 27:60 28:35 29:1.1 32:1900 35:0.2 37:85 38:1.5 39:6 70:2 86:4 87:30 89:15 90:5 95:16 107:62.7" :
  p == 7  ? "2:85 5:85 10:50 12:800 13:30 14:40 15:0.005 16:0.4 17:90 18:0.3 19:10 22:55 24:0 25:60 26:40 32:1400 33:20 35:0.005 36:0.4 37:90 38:0.3 39:10 68:380 69:80 70:1 79:0 81:30 83:50 86:2 87:30 89:15 90:8 95:12 96:9 107:80.8" :
  p == 8  ? "2:45 15:1.5 19:3 22:35 35:2 39:3 41:1 42:85 45:1 46:0 47:-12 48:4 49:40 50:30 51:2600 52:35 53:55 54:0.45 55:0.004 56:0.5 57:75 58:0.6 59:12 60:2 61:14 62:2 86:5 87:40 89:24 90:5 95:20 96:5 107:76.8" :
  p == 9  ? "2:75 5:85 6:20 10:40 12:2000 15:1 18:4 19:4 22:65 25:30 26:70 28:55 32:3600 35:1.4 38:5 39:4 41:1 42:45 46:1 47:7 48:3 49:45 51:3000 52:15 53:20 55:0.8 56:2 57:90 58:4 60:0 61:4 62:4 70:3 79:20 81:55 83:85 87:45 89:20 92:85 93:6 95:32 107:59.7" :
  p == 10 ? "2:80 5:20 6:80 7:30 8:15 9:0.3 10:30 12:1700 13:25 15:0.004 16:0.5 17:75 18:0.25 19:7 22:50 24:1 25:0 26:90 27:45 28:20 29:0.5 32:2200 35:0.004 36:0.5 37:70 38:0.3 39:7 64:3 68:180 69:65 70:1 79:5 81:40 83:60 86:2 87:35 89:18 90:6 95:12 96:7 107:69.1" :
  p == 11 ? "2:80 5:70 6:30 12:2400 14:45 15:0.01 16:1.2 17:35 18:2.5 19:2 22:60 26:70 32:3400 35:0.02 36:1.6 37:30 38:3 39:2 41:1 42:75 45:1 46:1 47:12 48:-6 49:30 50:40 51:3200 52:20 53:50 54:0.3 55:0.002 56:0.6 57:20 58:1.2 60:0 61:0 62:2 70:3 79:30 81:75 83:100 84:1.4 86:4 87:50 89:28 90:2 95:30 96:2 107:74.1" :
  p == 12 ? "2:90 4:-1 5:70 6:30 7:30 8:30 9:0.08 10:55 11:6 12:520 13:35 14:25 15:4 16:6 17:90 18:9 19:4 22:55 24:0 26:70 28:85 29:0.11 32:1100 33:20 35:5 37:90 38:10 39:4 64:2 68:900 69:70 70:3 79:10 80:0.09 81:55 82:0.15 83:80 89:10 92:100 93:13 94:65 95:48 96:3 107:66.0" :
  "";
);
function em_pstr_au(p) (
  p == 2  ? "3:-35 5:60 6:30 7:40 8:35 9:0.18 10:20 12:1100 14:10 15:2.5 16:4 17:90 18:6 19:0 23:35 26:70 28:75 29:0.33 32:3200 35:3 36:4 37:90 38:7 39:0 40:9 70:3 76:220 78:0.05 79:20 80:0.13 81:70 82:0.21 83:95 89:16 90:0 92:85 93:8 94:35 95:42 96:0 107:53.9" :
  p == 3  ? "2:55 12:1200 15:1.2 19:3 22:40 32:2000 35:1.5 39:3 41:1 42:75 47:12 48:5 49:35 51:1800 52:30 53:40 54:0.5 55:0.02 56:0.6 57:80 58:0.8 59:25 60:2 61:12 62:0 86:3 87:45 89:22 90:3 93:4.5 95:26 96:4 107:71.0" :
  p == 4  ? "2:85 5:90 10:45 12:620 13:42 14:35 15:0.01 16:0.6 17:70 18:0.35 19:8 22:45 24:0 26:60 28:30 29:0.45 32:1500 33:30 35:0.02 36:0.8 37:75 38:0.4 39:8 70:1 79:5 81:35 83:60 86:3 87:35 88:2600 89:20 90:7 95:14 96:8 107:81.4" :
  p == 5  ? "5:40 6:50 7:35 8:40 9:0.12 10:10 12:900 13:25 15:3 16:5 17:85 18:8 19:0 24:2 26:60 28:80 29:0.21 32:4200 35:4 37:80 38:9 39:0 70:2 71:1 72:0.06 73:85 74:55 79:25 81:65 83:90 84:0.6 89:12 90:0 92:90 93:11 94:55 95:45 96:0 107:64.4" :
  p == 6  ? "2:75 5:30 6:70 7:30 8:20 9:0.4 10:40 12:1300 13:20 15:0.15 17:85 18:1.2 19:6 24:0 25:50 26:40 27:60 28:35 29:1.1 32:1900 35:0.2 37:85 38:1.5 39:6 70:2 86:4 87:30 89:15 90:5 95:16 107:62.7" :
  p == 7  ? "2:85 5:85 10:50 12:800 13:30 14:40 15:0.005 16:0.4 17:90 18:0.3 19:10 22:55 24:0 25:60 26:40 32:1400 33:20 35:0.005 36:0.4 37:90 38:0.3 39:10 68:380 69:80 70:1 79:0 81:30 83:50 86:2 87:30 89:15 90:8 95:12 96:9 107:80.8" :
  p == 8  ? "2:45 15:1.5 19:3 22:35 35:2 39:3 41:1 42:85 45:1 46:0 47:-12 48:4 49:40 50:30 51:2600 52:35 53:55 54:0.45 55:0.004 56:0.5 57:75 58:0.6 59:12 60:2 61:14 62:2 86:5 87:40 89:24 90:5 95:20 96:5 107:76.8" :
  p == 9  ? "2:75 5:85 6:20 10:40 12:2000 15:1 18:4 19:4 22:65 25:30 26:70 28:55 32:3600 35:1.4 38:5 39:4 41:1 42:45 46:1 47:7 48:3 49:45 51:3000 52:15 53:20 55:0.8 56:2 57:90 58:4 60:0 61:4 62:4 70:3 79:20 81:55 83:85 87:45 89:20 92:85 93:6 95:32 107:59.7" :
  p == 10 ? "2:80 5:20 6:80 7:30 8:15 9:0.3 10:30 12:1700 13:25 15:0.004 16:0.5 17:75 18:0.25 19:7 22:50 24:1 25:0 26:90 27:45 28:20 29:0.5 32:2200 35:0.004 36:0.5 37:70 38:0.3 39:7 64:3 68:180 69:65 70:1 79:5 81:40 83:60 86:2 87:35 89:18 90:6 95:12 96:7 107:69.1" :
  p == 11 ? "2:80 5:70 6:30 12:2400 14:45 15:0.01 16:1.2 17:35 18:2.5 19:2 22:60 26:70 32:3400 35:0.02 36:1.6 37:30 38:3 39:2 41:1 42:75 45:1 46:1 47:12 48:-6 49:30 50:40 51:3200 52:20 53:50 54:0.3 55:0.002 56:0.6 57:20 58:1.2 60:0 61:0 62:2 70:3 79:30 81:75 83:100 84:1.4 86:4 87:50 89:28 90:2 95:30 96:2 107:74.1" :
  p == 12 ? "2:90 4:-1 5:70 6:30 7:30 8:30 9:0.08 10:55 11:6 12:520 13:35 14:25 15:4 16:6 17:90 18:9 19:4 22:55 24:0 26:70 28:85 29:0.11 32:1100 33:20 35:5 37:90 38:10 39:4 64:2 68:900 69:70 70:3 79:10 80:0.09 81:55 82:0.15 83:80 89:10 92:100 93:13 94:65 95:48 96:3 107:66.0" :
  "";
);
function load_preset(p) local(n, i) (
  // the kick's RUN, KICK level, FATE, VOLUME, the MIDI channel, the output stage and the finish stay as they are
  i = 1; loop(107, i != 63 && i != 65 && i != 97 && i != 98 && i != 99 && (i < 101 || i > 106) ? slider(i) = EMDEF[i - 1]; i += 1; );
  n = em_nums(em_pstr(p), EMTMP);
  i = 0; loop(floor(n / 2), EMTMP[i * 2] >= 1 && EMTMP[i * 2] <= 107 ? slider(EMTMP[i * 2]) = EMTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(107, ui_auto(i); i += 1; );
  pr_cur = p; em_panic = 1;
);
function load_preset_au(p) local(n, i) (
  // the kick's RUN, KICK level, FATE, VOLUME, the MIDI channel, the output stage and the finish stay as they are
  i = 1; loop(107, i != 63 && i != 65 && i != 97 && i != 98 && i != 99 && (i < 101 || i > 106) ? slider(i) = EMDEF[i - 1]; i += 1; );
  n = em_nums_au(em_pstr_au(p), EMTMP);
  i = 0; loop(floor(n / 2), EMTMP[i * 2] >= 1 && EMTMP[i * 2] <= 107 ? slider(EMTMP[i * 2]) = EMTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(107, ui_auto(i); i += 1; );
  pr_cur = p; em_panic = 1;
);

// ---------- the crossovers: biquads with shared coefficients (c: b0 b1 b2 a1 a2) ----------
function em_bqd(c, t, f) local(w, cs, al, a0) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cs = cos(w); al = sin(w) / (2 * 0.70710678); a0 = 1 + al;
  t == 0 ? ( c[0] = (1 - cs) / 2 / a0; c[1] = (1 - cs) / a0; c[2] = c[0]; ) :
  t == 1 ? ( c[0] = (1 + cs) / 2 / a0; c[1] = -(1 + cs) / a0; c[2] = c[0]; ) :
           ( c[0] = (1 - al) / a0; c[1] = -2 * cs / a0; c[2] = 1; );
  c[3] = -2 * cs / a0; c[4] = (1 - al) / a0;
);
function em_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );

// ---------- voices ----------
function em_pfree() local(v, q, best, bl) (
  best = -1; bl = 10; v = 0;
  loop(EMVN, q = EMV + v * EMVS; !q[0] ? ( best = v; bl = -1; ) : bl >= 0 && !q[3] && max(q[9], q[33]) < bl ? ( bl = max(q[9], q[33]); best = v; ); v += 1; );
  best < 0 ? ( bl = 1000000000000; v = 0; loop(EMVN, q = EMV + v * EMVS; q[4] < bl ? ( bl = q[4]; best = v; ); v += 1; ); );
  best;
);
function em_lfree() local(v, q, best, bl) (
  best = -1; bl = 10; v = 0;
  loop(EMLN, q = EML + v * EMLS; !q[0] ? ( best = v; bl = -1; ) : bl >= 0 && !q[3] && q[6] < bl ? ( bl = q[6]; best = v; ); v += 1; );
  best < 0 ? ( bl = 1000000000000; v = 0; loop(EMLN, q = EML + v * EMLS; q[4] < bl ? ( bl = q[4]; best = v; ); v += 1; ); );
  best;
);
// a layer's start: its envelope from where it is (a stolen voice never jumps), a random phase when it was silent
function em_lstart(L) (
  L[0] == 0 ? ( L[2] = rand(1); L[3] = 0; L[4] = L[5] = L[6] = L[7] = 0; L[8] = L[9]; );
  L[0] = 1; L[11] = ins_note_detune();
);
function em_on(note, vel) local(v, q, legato, held, k) (
  em_vg = 1 - em_vs + em_vs * vel;
  // OSC 1 and OSC 2: a pad voice
  v = em_pfree(); q = EMV + v * EMVS;
  q[0] = 1; q[1] = note; q[2] = em_vg; q[3] = 1; q[4] = em_age; em_age += 1;
  q[5] = 440 * 2 ^ ((note - 69) / 12); q[6] = (note - 60) / 12;
  em_lstart(q + 8); em_lstart(q + 32);
  // OSC 3: its own voice (POLY), or the one voice (MONO / LEGATO), gliding
  held = 0; k = 0; loop(128, EMHN[k] && k != note ? held = 1; k += 1; );
  legato = slider60 == 2 && held;
  v = slider60 >= 1 ? 0 : em_lfree(); q = EML + v * EMLS;
  q[8] = note;
  slider59 <= 0 ? q[7] = note : ( !q[0] ? q[7] = (em_llast > 0 ? em_llast : note); );
  em_llast = note;
  q[1] = note; q[3] = 1; q[4] = em_age; em_age += 1;
  !legato || !q[0] ? (
    !q[0] ? ( q[9] = rand(1); q[10] = rand(1); q[11] = q[12] = q[13] = q[14] = 0; q[20] = 0; q[18] = q[19]; );
    q[0] = 1; q[5] = 1; q[2] = em_vg; q[21] = ins_note_detune();
  );
  ins_midi_hit();
);
function em_off(note) local(v, q, k, b) (
  v = 0; loop(EMVN, q = EMV + v * EMVS; q[0] && q[1] == note && q[3] ? ( q[3] = 0; !em_ped ? ( q[8] ? q[8] = 4; q[32] ? q[32] = 4; ); ); v += 1; );
  slider60 >= 1 ? (
    // MONO / LEGATO: back to the highest key still held (gliding), else release
    q = EML; b = -1; k = 0; loop(128, EMHN[k] && k != note ? b = k; k += 1; );
    q[0] && q[1] == note ? ( b >= 0 ? ( q[1] = b; q[8] = b; em_llast = b; ) : ( q[3] = 0; !em_ped ? q[5] = 4; ); );
  ) : (
    v = 0; loop(EMLN, q = EML + v * EMLS; q[0] && q[1] == note && q[3] ? ( q[3] = 0; !em_ped ? q[5] = 4; ); v += 1; );
  );
);
function em_all_off() local(v, q) (
  v = 0; loop(EMVN, q = EMV + v * EMVS; q[3] = 0; q[8] ? q[8] = 4; q[32] ? q[32] = 4; v += 1; );
  v = 0; loop(EMLN, q = EML + v * EMLS; q[3] = 0; q[0] ? q[5] = 4; v += 1; );
);
function em_pedal_up() local(v, q) (
  v = 0; loop(EMVN, q = EMV + v * EMVS; q[0] && !q[3] ? ( q[8] && q[8] < 4 ? q[8] = 4; q[32] && q[32] < 4 ? q[32] = 4; ); v += 1; );
  v = 0; loop(EMLN, q = EML + v * EMLS; q[0] && !q[3] && q[5] < 4 ? q[5] = 4; v += 1; );
);

// one pad layer, one sample: the envelope, the DCO (saw, pulse, sub, noise), the ladder
function em_pad(L, C) local(st, dt, p, y, x, sp, u, g, ds) (
  st = L[0];
  st == 1 ? ( L[1] += C[14]; L[1] >= 1 ? ( L[1] = 1; L[0] = 2; ); ) :
  st == 2 ? ( L[1] += (C[16] - L[1]) * C[15]; ) :
  ( L[1] -= L[1] * C[17]; L[1] < 0.00005 ? ( L[0] = 0; L[1] = 0; ); );
  dt = L[10];
  p = L[2] + dt; p >= 1 ? ( p -= 1; L[3] = 1 - L[3]; ); L[2] = p;
  y = p + p - 1;
  p < dt ? ( g = p / dt; y -= g + g - g * g - 1; ) : p > 1 - dt ? ( g = (p - 1) / dt; y -= g * g + g + g + 1; );
  x = y * C[2];
  // the pulse: the saw less the saw shifted by the width
  C[3] > 0.0005 ? (
    sp = p + 1 - C[8]; sp >= 1 ? sp -= 1;
    u = sp + sp - 1;
    sp < dt ? ( g = sp / dt; u -= g + g - g * g - 1; ) : sp > 1 - dt ? ( g = (sp - 1) / dt; u -= g * g + g + g + 1; );
    x += (y - u) * C[3];
  );
  // the sub: a square an octave down, locked to the oscillator (the saw's half-speed phase, two edges)
  C[9] > 0.0005 ? (
    ds = dt * 0.5; sp = (p + L[3]) * 0.5;
    u = sp < 0.5 ? -1 : 1;
    sp < ds ? ( g = sp / ds; u -= g + g - g * g - 1; ) : sp > 1 - ds ? ( g = (sp - 1) / ds; u -= g * g + g + g + 1; );
    g = sp - 0.5; abs(g) < ds ? ( g < 0 ? ( g = g / ds; u -= g * g + g + g + 1; ) : ( g = g / ds; u += g + g - g * g - 1; ); );
    x += u * C[9];
  );
  C[10] > 0.0005 ? x += (rand(2) - 1) * C[10];
  // the ladder
  L[8] += (L[9] - L[8]) * 0.05; g = L[8];
  u = s57_th(x * 0.55 - C[12] * L[12] * L[7]);
  L[4] += g * (u - L[4]); L[5] += g * (L[4] - L[5]); L[6] += g * (L[5] - L[6]); L[7] += g * (L[6] - L[7]);
  L[7] * L[1];
);
// one lead voice, one sample: two oscillators (saw or pulse each, faded), the ladder, the envelopes
function em_lead(q, C) local(st, dt, p, y, a, b, sp, u, g) (
  st = q[5];
  st == 1 ? ( q[6] += C[14]; q[6] >= 1 ? ( q[6] = 1; q[5] = 2; ); q[15] = q[6]; ) :
  st == 2 ? ( q[6] += (C[16] - q[6]) * C[15]; q[15] -= q[15] * C[9]; ) :
  ( q[6] -= q[6] * C[17]; q[15] -= q[15] * C[9]; q[6] < 0.00005 ? ( q[0] = 0; q[6] = 0; q[5] = 0; ); );
  // A
  dt = q[16]; p = q[9] + dt; p >= 1 ? p -= 1; q[9] = p;
  y = p + p - 1;
  p < dt ? ( g = p / dt; y -= g + g - g * g - 1; ) : p > 1 - dt ? ( g = (p - 1) / dt; y -= g * g + g + g + 1; );
  a = y;
  C[2] > 0.0005 ? (
    sp = p + 1 - C[4]; sp >= 1 ? sp -= 1; u = sp + sp - 1;
    sp < dt ? ( g = sp / dt; u -= g + g - g * g - 1; ) : sp > 1 - dt ? ( g = (sp - 1) / dt; u -= g * g + g + g + 1; );
    a += (y - u - y) * C[2];
  );
  // B
  dt = q[17]; p = q[10] + dt; p >= 1 ? p -= 1; q[10] = p;
  y = p + p - 1;
  p < dt ? ( g = p / dt; y -= g + g - g * g - 1; ) : p > 1 - dt ? ( g = (p - 1) / dt; y -= g * g + g + g + 1; );
  b = y;
  C[3] > 0.0005 ? (
    sp = p + 1 - C[4]; sp >= 1 ? sp -= 1; u = sp + sp - 1;
    sp < dt ? ( g = sp / dt; u -= g + g - g * g - 1; ) : sp > 1 - dt ? ( g = (sp - 1) / dt; u -= g * g + g + g + 1; );
    b += (y - u - y) * C[3];
  );
  a += (b - a) * C[5];
  q[18] += (q[19] - q[18]) * 0.08; g = q[18];
  u = s57_th(a * 0.6 - C[12] * q[22] * q[14]);
  q[11] += g * (u - q[11]); q[12] += g * (q[11] - q[12]); q[13] += g * (q[12] - q[13]); q[14] += g * (q[13] - q[14]);
  q[14] * q[6] * q[2];
);

// ---------- the sub-rate (every 16 samples): the voices' pitch and filters, the ducking, the autopan, the phaser ----------
function em_gk(fc) ( min(1 - exp(-6.283185307 * min(fc, srate * 0.42) / srate), 0.92); );
function em_tick() local(v, q, L, C, f, e, u, k, a) (
  // each layer's CUTOFF and ENV glide (two 15 ms stages on the cutoff, 15 ms on ENV): a turned knob never steps
  C = EMC; loop(3,
    !em_fok ? ( C[43] = C[44] = C[41]; C[20] = C[42]; );
    C[43] += (C[41] - C[43]) * em_fk; C[44] += (C[43] - C[44]) * em_fk; C[11] = exp(C[44]); C[20] += (C[42] - C[20]) * em_fk;
    C += 48; );
  em_fok = 1;
  // the pad layers
  v = 0; loop(EMVN,
    q = EMV + v * EMVS;
    q[0] ? (
      C = EMC; L = q + 8;
      L[0] ? (
        L[10] = min(q[5] * em_bend * C[18] * L[11] / srate, 0.45);
        L[9] = em_gk(C[11] * exp(0.693147 * (C[20] * L[1] * 6 + q[6] * 0.4 + C[19])));
        L[12] = 1 - max(L[9] - 0.6, 0) * 2.2;
      );
      C = EMC + 48; L = q + 32;
      L[0] ? (
        L[10] = min(q[5] * em_bend * C[18] * L[11] / srate, 0.45);
        L[9] = em_gk(C[11] * exp(0.693147 * (C[20] * L[1] * 6 + q[6] * 0.4 + C[19])));
        L[12] = 1 - max(L[9] - 0.6, 0) * 2.2;
      );
      !q[8] && !q[32] ? q[0] = 0;
    );
    v += 1; );
  // the lead voices: glide, vibrato (faded in), pitch, filter
  C = EMC + 96;
  em_vph += 16 * 5.2 / srate; em_vph >= 1 ? em_vph -= 1;
  em_vib = sin(6.283185307 * em_vph);
  v = 0; loop(EMLN,
    q = EML + v * EMLS;
    q[0] ? (
      q[7] += (q[8] - q[7]) * C[7];
      q[20] = min(q[20] + 16 / (0.45 * srate), 1);
      f = 440 * exp(0.057762265 * (q[7] + em_vib * q[20] * em_vibd - 69)) * em_bend * C[18] * q[21];
      q[16] = min(f / srate, 0.45); q[17] = min(f * C[10] / srate, 0.45);
      q[19] = em_gk(C[11] * exp(0.693147 * (C[20] * q[15] * 6 + (q[7] - 60) / 12 * 0.5 + C[19])));
      q[22] = 1 - max(q[19] - 0.6, 0) * 2.2;
    );
    v += 1; );
  // THE PULSE: the duck envelope (a raised-cosine attack, then the release curve)
  em_dt < em_da ? ( e = em_d0 + (em_dpk - em_d0) * (0.5 - 0.5 * cos($pi * em_dt / em_da)); ) : (
    u = (em_dt - em_da) / em_drel;
    e = u < 1 ? em_dpk * (1 - u ^ em_dsh) : 0;
  );
  em_de = e;
  // each layer's gain, and the sends': a ramp to it over the next 16 samples
  C = EMC; C[25] = (exp(-C[26] * 0.2763102 * e) - C[24]) * 0.0625;
  C = EMC + 48; C[25] = (exp(-C[26] * 0.2763102 * e) - C[24]) * 0.0625;
  C = EMC + 96; C[25] = (exp(-C[26] * 0.2763102 * e) - C[24]) * 0.0625;
  em_gdi = (exp(-em_kd * 0.2763102 * e) - em_gd) * 0.0625;
  em_gri = (exp(-em_kr * 0.2763102 * e) - em_gr) * 0.0625;
  // the last bar, for the display
  k = em_bp * 0.25; k = ((k - floor(k)) * 256) | 0;
  k != em_slot ? ( EMK[k] = 0; em_slot = k; );
  EMH[k] = e;
  // the autopan's bands: their LFOs, their pans as balance gains (ramped)
  em_apw > 0.0001 ? (
    em_ap0 += em_ar0 * 16 / srate; em_ap0 >= 1 ? em_ap0 -= 1;
    em_ap1 += em_ar1 * 16 / srate; em_ap1 >= 1 ? em_ap1 -= 1;
    em_ap2 += em_ar2 * 16 / srate; em_ap2 >= 1 ? em_ap2 -= 1;
    em_pp0 = em_dp0 * sin(6.283185307 * em_ap0); em_pp1 = em_dp1 * sin(6.283185307 * em_ap1 + 2.1); em_pp2 = em_dp2 * sin(6.283185307 * em_ap2 + 4.2);
    a = em_pp0; em_b0li = ((a > 0 ? cos(a * 1.5707963) : 1) - em_b0l) * 0.0625; em_b0ri = ((a < 0 ? cos(a * 1.5707963) : 1) - em_b0r) * 0.0625;
    a = em_pp1; em_b1li = ((a > 0 ? cos(a * 1.5707963) : 1) - em_b1l) * 0.0625; em_b1ri = ((a < 0 ? cos(a * 1.5707963) : 1) - em_b1r) * 0.0625;
    a = em_pp2; em_b2li = ((a > 0 ? cos(a * 1.5707963) : 1) - em_b2l) * 0.0625; em_b2ri = ((a < 0 ? cos(a * 1.5707963) : 1) - em_b2r) * 0.0625;
  );
  // the phaser's sweep (a triangle), its all-pass coefficients (ramped)
  em_phw > 0.0001 ? (
    em_php += em_phr * 16 / srate; em_php >= 1 ? em_php -= 1;
    u = 1 - 4 * abs(em_php - 0.5); a = em_php + 0.25; a >= 1 ? a -= 1; a = 1 - 4 * abs(a - 0.5);
    f = tan($pi * min(560 * exp(0.693147 * em_phd * 3 * u), srate * 0.45) / srate); em_pcl = (f - 1) / (f + 1);
    f = tan($pi * min(560 * exp(0.693147 * em_phd * 3 * a), srate * 0.45) / srate); em_pcr = (f - 1) / (f + 1);
    em_pali = (em_pcl - em_pa1) * 0.0625; em_pari = (em_pcr - em_pa2) * 0.0625;
  );
);

// ---------- the kick: a sine with an exponential pitch drop, a click, a little drive (after Deep16) ----------
function em_hit(strength) (
  em_d0 = em_de; em_dpk = strength; em_dt = 0;
  EMK[em_slot] = strength;
  strength > 0.9 ? ( em_kph = 0; em_kpe = 1; em_kae = 1; em_kce = 1; em_kon = 1; );
  em_kfl = 1;
);
function em_dly(t) ( t == 0 ? 0.25 : t == 1 ? 1 / 3 : t == 2 ? 0.5 : t == 3 ? 0.75 : t == 4 ? 1 : t == 5 ? 1.5 : 2; );

function em_update() local(C, i, b) (
  em_vol = 10 ^ (slider98 / 20);
  em_fate = slider97 / 50;
  em_vs = slider100 / 100;
  ins_output_setup(101);
  // the pad layers' targets
  i = 0; loop(2,
    C = EMC + i * 48; b = i * 20;
    C[30] = slider(5 + b) / 100; C[31] = slider(6 + b) / 100; C[32] = slider(7 + b) / 100; C[33] = slider(8 + b) / 100;
    C[34] = slider(10 + b) / 100 * 0.8; C[35] = (slider(11 + b) / 100) ^ 2 * 0.6;
    C[36] = slider(13 + b) / 100 * 3.8; C[40] = 1 + 1.3 * slider(13 + b) / 100;
    C[37] = slider(1 + b) >= 0.5 ? (slider(2 + b) / 100) ^ 2 : 0;
    C[38] = cos((slider(3 + b) / 100 + 1) * $pi * 0.25) * 1.4142; C[39] = sin((slider(3 + b) / 100 + 1) * $pi * 0.25) * 1.4142;
    C[7] = slider(9 + b) / srate;
    C[41] = log(slider(12 + b)); C[42] = slider(14 + b) / 100;     // CUTOFF (log Hz) and ENV: C[11] / C[20] glide to them
    C[14] = 1 / max(slider(15 + b) * srate, 1); C[15] = s57_kt(slider(16 + b) / 4.6, srate);
    C[16] = slider(17 + b) / 100; C[17] = s57_kt(slider(18 + b) / 4.6, srate);
    C[26] = slider(19 + b);
    i += 1; );
  // the lead layer
  C = EMC + 96;
  C[30] = slider45 >= 0.5; C[31] = slider46 >= 0.5; C[32] = slider50 / 100; C[33] = slider49 / 100;
  C[36] = slider52 / 100 * 3.8; C[40] = 1 + 1.2 * slider52 / 100;
  C[37] = slider41 >= 0.5 ? (slider42 / 100) ^ 2 : 0;
  C[38] = cos((slider43 / 100 + 1) * $pi * 0.25) * 1.4142; C[39] = sin((slider43 / 100 + 1) * $pi * 0.25) * 1.4142;
  C[10] = 2 ^ ((slider47 + slider48 / 100) / 12);
  C[41] = log(slider51); C[42] = slider53 / 100;
  C[9] = s57_kt(slider54 / 4.6, srate);
  C[14] = 1 / max(slider55 * srate, 1); C[15] = s57_kt(slider56 / 4.6, srate);
  C[16] = slider57 / 100; C[17] = s57_kt(slider58 / 4.6, srate);
  C[7] = slider59 > 0 ? 1 - exp(-16 / ((0.005 + 0.6 * (slider59 / 100) ^ 2) * srate)) : 1;
  C[26] = slider62;
  // the kick and the ducking
  em_kbase = 40 + 35 * slider66 / 100; em_kdrop = 120 + 160 * slider66 / 100;
  em_kadk = exp(-4.6 / (slider67 * 0.001 * srate)); em_kpdk = exp(-1 / (0.035 * srate)); em_kcdk = exp(-1 / (0.0025 * srate));
  em_klt = (slider65 / 100) ^ 2 * 0.9;
  em_da = 0.003 * srate; em_drel = slider68 * 0.001 * srate; em_dsh = 4 ^ ((slider69 - 50) / 50);
  em_kd = slider90; em_kr = slider96;
  // the effects
  em_cwt = slider70 > 0; em_cat = slider70 == 1 ? 1 : slider70 == 3 ? 0.5 : 0; em_cbt = slider70 == 2 ? 1 : slider70 == 3 ? 0.5 : 0;
  em_phwt = slider71 >= 0.5; em_phr = slider72; em_phd = slider73 / 100; em_phft = slider74 / 100 * 0.85;
  em_apwt = slider75 >= 0.5;
  em_dwt = slider85 >= 0.5; em_rwt = slider91 >= 0.5;
  em_dfbt = slider87 / 100; em_dtc = s57_k(slider88, srate);
  em_dmt = slider89 / 100; em_rmt = slider95 / 100;
  em_ogt = (slider107 / 100) ^ 2 * 1.6 * em_vol;
);
function em_reverb() local(i, sz) (
  em_l92 = slider92; em_l93 = slider93; em_l94 = slider94;
  sz = 0.5 + 1.1 * slider92 / 100;
  i = 0; loop(8, EMRP[i] = EMRL[i] * sz * srate / 1000; EMRG[i] = 10 ^ (-3 * EMRP[i] / (slider93 * srate)); i += 1; );
  em_rcg = 0.5 / (slider93 / 4) ^ 0.25;
  em_rkd = s57_k(14000 * (1200 / 14000) ^ (slider94 / 100), srate);
);
function em_xover() (
  em_bqd(EMXC, 0, em_x1); em_bqd(EMXC + 5, 1, em_x1);
  em_bqd(EMXC + 10, 0, em_x2); em_bqd(EMXC + 15, 1, em_x2); em_bqd(EMXC + 20, 2, em_x2);
);
function em_srinit() (
  em_sr = srate; em_sm = s57_kt(0.02, srate); em_fk = 1 - exp(-16 / (0.015 * srate)); em_dxi = 1 / (0.05 * srate); em_dx = 1; em_sf = s57_kt(0.03, srate);
  em_reverb(); em_x1 = slider76; em_x2 = slider77; em_xover(); ost_init(0);
);
em_update(); em_srinit(); em_fok = 0;
em_bend = 1; em_bp = 0; em_lastk = -1000000; em_dt = 1000000; em_de = 0; em_gd = em_gr = 1;
EMC[24] = EMC[72] = EMC[120] = 1;
em_b0l = em_b0r = em_b1l = em_b1r = em_b2l = em_b2r = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
em_update();

@block
prs_chk();
srate != em_sr ? em_srinit();
em_update();
(slider92 != em_l92 || slider93 != em_l93 || slider94 != em_l94) ? em_reverb();
em_panic ? ( em_all_off(); em_panic = 0; );
em_lmode != slider60 ? ( v_ = 0; loop(EMLN, q_ = EML + v_ * EMLS; q_[3] = 0; q_[0] ? q_[5] = 4; v_ += 1; ); em_lmode = slider60; );
em_bs = samplesblock / srate;

// FATE: breathing growth (slow)
ins_drift_block(min(em_fate, 2) * 0.5, samplesblock);
em_di = 0.05 * (0.5 + 0.5 * min(em_fate, 2)) * em_bs;
em_zd1 = em_dD1.drift_tick(em_di); em_zd2 = em_dD2.drift_tick(em_di * 0.9);
em_zw1 = em_dW1.drift_tick(em_di * 1.3); em_zw2 = em_dW2.drift_tick(em_di * 1.2);
em_zc1 = em_dC1.drift_tick(em_di * 0.8); em_zc2 = em_dC2.drift_tick(em_di * 0.7); em_zc3 = em_dC3.drift_tick(em_di * 0.75);
em_zp0 = em_dP0.drift_tick(em_di * 0.6); em_zp1 = em_dP1.drift_tick(em_di * 0.6); em_zp2 = em_dP2.drift_tick(em_di * 0.6);
// the layers' pitch and filter offsets (octave, detune, the wander)
EMC[18] = 2 ^ slider4 * 2 ^ ((slider20 + em_zd1 * em_fate * 6) / 1200) * ins_pitch;
EMC[66] = 2 ^ slider24 * 2 ^ ((slider40 + em_zd2 * em_fate * 6) / 1200) * ins_pitch;
EMC[114] = 2 ^ slider44 * ins_pitch;
EMC[19] = em_zc1 * em_fate * 0.35 + ins_cut * 0.5; EMC[67] = em_zc2 * em_fate * 0.35 + ins_cut * 0.5; EMC[115] = em_zc3 * em_fate * 0.15;
EMC[32] = min(max(slider7 / 100 + em_zw1 * em_fate * 0.08, 0.05), 0.95); EMC[80] = min(max(slider27 / 100 + em_zw2 * em_fate * 0.08, 0.05), 0.95);
em_vibd = slider61 / 100 + em_cc1 * 0.5;
// the autopan: the crossovers (glided), the rates (GLOBAL, the wander pulling them apart), the depths
em_x1 += (slider76 - em_x1) * min(em_bs * 12, 1); em_x2 += (slider77 - em_x2) * min(em_bs * 12, 1);
abs(em_x1 - em_lx1) > 0.05 || abs(em_x2 - em_lx2) > 0.5 ? ( em_xover(); em_lx1 = em_x1; em_lx2 = em_x2; );
em_ar0 = slider78 * slider84 * 2 ^ (em_zp0 * em_fate * 0.5); em_ar1 = slider80 * slider84 * 2 ^ (em_zp1 * em_fate * 0.5);
em_ar2 = slider82 * slider84 * 2 ^ (em_zp2 * em_fate * 0.5);
em_dpt0 = slider79 / 100; em_dpt1 = slider81 / 100; em_dpt2 = slider83 / 100;
em_dp0 += (em_dpt0 - em_dp0) * min(em_bs * 20, 1); em_dp1 += (em_dpt1 - em_dp1) * min(em_bs * 20, 1); em_dp2 += (em_dpt2 - em_dp2) * min(em_bs * 20, 1);
// the delay's time from the tempo (the line glides to it)
em_dtt = min(em_dly(slider86) * 60 / max(tempo, 20) * srate, 262000);
// a new time: the old tap crossfades to the new one (50 ms) - nothing sweeps, nothing clicks
em_dta <= 0 ? em_dta = em_dtb = em_dtt;
em_dx >= 1 && abs(em_dtt - em_dta) > 0.5 ? ( em_dtb = em_dtt; em_dx = 0; );
em_dfb = em_dfbt;
// the sends: cleared when they come back in after a rest
em_dwt && em_dcl ? ( memset(EMDL, 0, 262144); memset(EMDR, 0, 262144); em_dcl = 0; em_dlpl = em_dlpr = em_dhpl = em_dhpr = 0; );
em_rwt && em_rcl ? (
  i_ = 0; loop(8, memset(emr0.buf + i_ * 16384, 0, 16384); EMRD[i_] = 0; i_ += 1; ); memset(emra.buf, 0, 4096 * 4); em_rcl = 0; );

// ---------- MIDI into the queue ----------
em_qn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, slider99) ? (
    st_ = m1 & 0xF0;
    st_ == 0x90 && m3 > 0 ? (
      em_qn < 250 ? ( EMQ[em_qn * 4] = mofs; EMQ[em_qn * 4 + 1] = 1; EMQ[em_qn * 4 + 2] = m2; EMQ[em_qn * 4 + 3] = m3 / 127; em_qn += 1; );
    ) : st_ == 0x80 || (st_ == 0x90 && m3 == 0) ? (
      em_qn < 250 ? ( EMQ[em_qn * 4] = mofs; EMQ[em_qn * 4 + 1] = 0; EMQ[em_qn * 4 + 2] = m2; EMQ[em_qn * 4 + 3] = 0; em_qn += 1; );
    ) : st_ == 0xE0 ? ( em_bend = ins_bend(m2, m3, 2); ) :
    st_ == 0xB0 ? (
      m2 == 1 ? ( em_cc1 = m3 / 127; ) :
      m2 == 64 ? ( em_ped = m3 >= 64; !em_ped ? em_pedal_up(); ) :
      m2 == 120 || m2 == 123 ? ( em_all_off(); memset(EMHN, 0, 128); );
    );
  );
  midisend(mofs, m1, m2, m3);
);
em_qr = 0; em_sp = 0;

// ---------- THE PULSE: the host's beat, or the tempo on its own (stopped) ----------
em_kdiv = slider64 == 1 ? 0.5 : slider64 == 2 ? 2 : slider64 == 3 ? 0.5 : 1;
em_bpi = max(tempo, 20) / 60 / srate;
(play_state & 1) ? (
  em_bp = beat_position;
  k_ = floor(em_bp / em_kdiv + 2 * em_bpi / em_kdiv);
  k_ != em_lastk ? (
    // a grid line just crossed (or the loop jumped to one): it sounds now; landing mid-step, it waits
    (em_bp - k_ * em_kdiv) < (samplesblock + 2) * em_bpi && slider63 >= 0.5 ? em_hit(slider64 == 3 && (k_ & 1) ? 0.6 : 1);
    em_lastk = k_;
  );
) : (
  k_ = floor(em_bp / em_kdiv + 0.000000001); k_ != em_lastk ? em_lastk = k_;
);
em_knext = (em_lastk + 1) * em_kdiv;
em_kfl = max(em_kfl - em_bs * 6, 0);
em_nact = 0; v_ = 0; loop(EMVN, EMV[v_ * EMVS] ? em_nact += 1; v_ += 1; );
em_nled = 0; v_ = 0; loop(EMLN, EML[v_ * EMLS] ? em_nled += 1; v_ += 1; );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the queue ----------
while (em_qr < em_qn && (EMQ[em_qr * 4] <= em_sp || em_sp >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  k_ = em_qr * 4;
  EMQ[k_ + 1] ? ( EMHN[EMQ[k_ + 2]] = 1; em_on(EMQ[k_ + 2], EMQ[k_ + 3]); ) : ( EMHN[EMQ[k_ + 2]] = 0; em_off(EMQ[k_ + 2]); );
  em_qr += 1;
);
em_sp += 1;

// ---------- the beat: the kick's grid, the duck's clock ----------
em_bp += em_bpi;
em_bp >= em_knext ? (
  em_lastk += 1; em_knext += em_kdiv;
  slider63 >= 0.5 ? em_hit(slider64 == 3 && (em_lastk & 1) ? 0.6 : 1);
);
em_dt += 1;
em_sc -= 1; em_sc <= 0 ? ( em_sc = 16; em_tick(); );

// ---------- the controls, glided ----------
C_ = EMC;
C_[2] += (C_[30] - C_[2]) * em_sm; C_[3] += (C_[31] - C_[3]) * em_sm; C_[4] += (C_[32] - C_[4]) * em_sm; C_[5] += (C_[33] - C_[5]) * em_sm;
C_[9] += (C_[34] - C_[9]) * em_sm; C_[10] += (C_[35] - C_[10]) * em_sm; C_[12] += (C_[36] - C_[12]) * em_sm; C_[13] += (C_[40] - C_[13]) * em_sm;
C_[21] += (C_[37] - C_[21]) * em_sf; C_[22] += (C_[38] - C_[22]) * em_sm; C_[23] += (C_[39] - C_[23]) * em_sm; C_[24] += C_[25];
C_[6] += C_[7]; C_[6] >= 1 ? C_[6] -= 1; C_[8] = min(max(C_[4] + C_[5] * 0.45 * (1 - 4 * abs(C_[6] - 0.5)), 0.05), 0.95);
C_ = EMC + 48;
C_[2] += (C_[30] - C_[2]) * em_sm; C_[3] += (C_[31] - C_[3]) * em_sm; C_[4] += (C_[32] - C_[4]) * em_sm; C_[5] += (C_[33] - C_[5]) * em_sm;
C_[9] += (C_[34] - C_[9]) * em_sm; C_[10] += (C_[35] - C_[10]) * em_sm; C_[12] += (C_[36] - C_[12]) * em_sm; C_[13] += (C_[40] - C_[13]) * em_sm;
C_[21] += (C_[37] - C_[21]) * em_sf; C_[22] += (C_[38] - C_[22]) * em_sm; C_[23] += (C_[39] - C_[23]) * em_sm; C_[24] += C_[25];
C_[6] += C_[7]; C_[6] >= 1 ? C_[6] -= 1; C_[8] = min(max(C_[4] + C_[5] * 0.45 * (1 - 4 * abs(C_[6] - 0.5)), 0.05), 0.95);
C_ = EMC + 96;
C_[2] += (C_[30] - C_[2]) * em_sm; C_[3] += (C_[31] - C_[3]) * em_sm; C_[4] += (C_[32] - C_[4]) * em_sm; C_[5] += (C_[33] - C_[5]) * em_sm;
C_[12] += (C_[36] - C_[12]) * em_sm; C_[13] += (C_[40] - C_[13]) * em_sm;
C_[21] += (C_[37] - C_[21]) * em_sf; C_[22] += (C_[38] - C_[22]) * em_sm; C_[23] += (C_[39] - C_[23]) * em_sm; C_[24] += C_[25];
em_gd += em_gdi; em_gr += em_gri;

// ---------- the three layers ----------
a1_ = a2_ = a3_ = 0;
EMC[21] + EMC[69] > 0.00001 ? (
  q_ = EMV;
  loop(EMVN,
    q_[0] ? (
      q_[8] ? a1_ += em_pad(q_ + 8, EMC) * q_[2];
      q_[32] ? a2_ += em_pad(q_ + 32, EMC + 48) * q_[2];
    );
    q_ += EMVS;
  );
) : (
  // both pad layers off: their envelopes still run, so held notes come back where they would be
  q_ = EMV; loop(EMVN, q_[0] ? ( L_ = q_ + 8; L_[0] == 4 ? ( L_[1] -= L_[1] * EMC[17]; L_[1] < 0.00005 ? L_[0] = 0; ); L_ = q_ + 32; L_[0] == 4 ? ( L_[1] -= L_[1] * EMC[65]; L_[1] < 0.00005 ? L_[0] = 0; ); ); q_ += EMVS; );
);
q_ = EML; loop(EMLN, q_[0] ? a3_ += em_lead(q_, EMC + 96); q_ += EMLS; );
a1_ *= EMC[13] * EMC[21] * EMC[24]; a2_ *= EMC[61] * EMC[69] * EMC[72]; a3_ *= EMC[109] * EMC[117] * EMC[120] * 1.4;
em_l = a1_ * EMC[22] + a2_ * EMC[70] + a3_ * EMC[118];
em_r = a1_ * EMC[23] + a2_ * EMC[71] + a3_ * EMC[119];
em_m1 = max(em_m1 * 0.9995, abs(a1_)); em_m2 = max(em_m2 * 0.9995, abs(a2_)); em_m3 = max(em_m3 * 0.9995, abs(a3_));

// ---------- BBD CHORUS: two bucket-brigade taps (I and II), the right side swinging the other way ----------
EMCL[em_cw] = em_l; EMCR[em_cw] = em_r;
em_cw_ += (em_cwt - em_cw_) * em_sf; em_ca += (em_cat - em_ca) * em_sf; em_cb += (em_cbt - em_cb) * em_sf;
em_cw_ > 0.0001 ? (
  em_c1p += 0.513 / srate; em_c1p >= 1 ? em_c1p -= 1; em_c2p += 0.863 / srate; em_c2p >= 1 ? em_c2p -= 1;
  t1_ = 1 - 4 * abs(em_c1p - 0.5); t2_ = 1 - 4 * abs(em_c2p - 0.5);
  wl_ = wr_ = 0;
  em_ca > 0.001 ? (
    d_ = (3.5 + 1.85 * t1_) * 0.001 * srate; i_ = d_ | 0; f_ = d_ - i_; wl_ = (EMCL[(em_cw - i_) & 8191] * (1 - f_) + EMCL[(em_cw - i_ - 1) & 8191] * f_) * em_ca;
    d_ = (3.5 - 1.85 * t1_) * 0.001 * srate; i_ = d_ | 0; f_ = d_ - i_; wr_ = (EMCR[(em_cw - i_) & 8191] * (1 - f_) + EMCR[(em_cw - i_ - 1) & 8191] * f_) * em_ca;
  );
  em_cb > 0.001 ? (
    d_ = (4.2 - 1.9 * t2_) * 0.001 * srate; i_ = d_ | 0; f_ = d_ - i_; wl_ += (EMCL[(em_cw - i_) & 8191] * (1 - f_) + EMCL[(em_cw - i_ - 1) & 8191] * f_) * em_cb;
    d_ = (4.2 + 1.9 * t2_) * 0.001 * srate; i_ = d_ | 0; f_ = d_ - i_; wr_ += (EMCR[(em_cw - i_) & 8191] * (1 - f_) + EMCR[(em_cw - i_ - 1) & 8191] * f_) * em_cb;
  );
  // the bucket brigade's darkness, a touch of its saturation
  em_clp1 += (wl_ - em_clp1) * 0.42; em_clp2 += (em_clp1 - em_clp2) * 0.42;
  em_crp1 += (wr_ - em_crp1) * 0.42; em_crp2 += (em_crp1 - em_crp2) * 0.42;
  em_l = em_l * (1 - 0.3 * em_cw_) + s57_th(em_clp2 * 1.1) / 1.1 * 0.75 * em_cw_;
  em_r = em_r * (1 - 0.3 * em_cw_) + s57_th(em_crp2 * 1.1) / 1.1 * 0.75 * em_cw_;
);
em_cw = (em_cw + 1) & 8191;

// ---------- DYNATRON PHASER: six all-pass stages, fed back (COLOUR), half wet ----------
em_phw += (em_phwt - em_phw) * em_sf; em_phf += (em_phft - em_phf) * em_sm;
em_phw > 0.0001 ? (
  em_pa1 += em_pali; em_pa2 += em_pari;
  x_ = em_l + em_phf * em_pfl; a_ = em_pa1; p_ = EMAP;
  loop(6, y_ = a_ * x_ + p_[0] - a_ * p_[1]; p_[0] = x_; p_[1] = y_; x_ = y_; p_ += 2; );
  em_pfl = s57_th(x_);
  w_ = 0.5 * em_phw / (1 + 0.4 * abs(em_phf)); em_l += (x_ - em_l) * w_;
  x_ = em_r + em_phf * em_pfr; a_ = em_pa2;
  loop(6, y_ = a_ * x_ + p_[0] - a_ * p_[1]; p_[0] = x_; p_[1] = y_; x_ = y_; p_ += 2; );
  em_pfr = s57_th(x_);
  em_r += (x_ - em_r) * w_;
);

// ---------- MULTI-BAND AUTOPAN: three Linkwitz-Riley bands (summing flat), each panned on its own ----------
em_apw += (em_apwt - em_apw) * em_sf;
em_apw > 0.0001 ? (
  lo_ = emxa.em_bq(emxb.em_bq(em_l, EMXC), EMXC); rs_ = emxc.em_bq(emxd.em_bq(em_l, EMXC + 5), EMXC + 5);
  lo_ = emxe.em_bq(lo_, EMXC + 20);
  mi_ = emxf.em_bq(emxg.em_bq(rs_, EMXC + 10), EMXC + 10); hi_ = emxh.em_bq(emxi.em_bq(rs_, EMXC + 15), EMXC + 15);
  em_b0l += em_b0li; em_b1l += em_b1li; em_b2l += em_b2li; em_b0r += em_b0ri; em_b1r += em_b1ri; em_b2r += em_b2ri;
  x_ = lo_ * em_b0l + mi_ * em_b1l + hi_ * em_b2l;
  lo_ = emya.em_bq(emyb.em_bq(em_r, EMXC), EMXC); rs_ = emyc.em_bq(emyd.em_bq(em_r, EMXC + 5), EMXC + 5);
  lo_ = emye.em_bq(lo_, EMXC + 20);
  mi_ = emyf.em_bq(emyg.em_bq(rs_, EMXC + 10), EMXC + 10); hi_ = emyh.em_bq(emyi.em_bq(rs_, EMXC + 15), EMXC + 15);
  y_ = lo_ * em_b0r + mi_ * em_b1r + hi_ * em_b2r;
  em_l += (x_ - em_l) * em_apw; em_r += (y_ - em_r) * em_apw;
);

// ---------- the sends: DELAY (synced, ping-pong) and REVERB, each wet tail ducked by its own KEY ----------
em_dw += (em_dwt - em_dw) * em_sf; em_rw += (em_rwt - em_rw) * em_sf;
em_dm += (em_dmt * em_dwt - em_dm) * em_sm; em_rm += (em_rmt * em_rwt - em_rm) * em_sm;
em_dry = min(1, 2 - 2 * max(em_dm, em_rm));
ol_ = em_l * em_dry; or_ = em_r * em_dry;
em_dw > 0.0001 ? (
  d_ = em_dta; i_ = d_ | 0; f_ = d_ - i_;
  dl_ = EMDL[(em_dpw - i_) & 262143] * (1 - f_) + EMDL[(em_dpw - i_ - 1) & 262143] * f_;
  dr_ = EMDR[(em_dpw - i_) & 262143] * (1 - f_) + EMDR[(em_dpw - i_ - 1) & 262143] * f_;
  em_dx < 1 ? (
    em_dx = min(em_dx + em_dxi, 1); x_ = 0.5 - 0.5 * cos($pi * em_dx);
    d_ = em_dtb; i_ = d_ | 0; f_ = d_ - i_;
    dl_ += (EMDL[(em_dpw - i_) & 262143] * (1 - f_) + EMDL[(em_dpw - i_ - 1) & 262143] * f_ - dl_) * x_;
    dr_ += (EMDR[(em_dpw - i_) & 262143] * (1 - f_) + EMDR[(em_dpw - i_ - 1) & 262143] * f_ - dr_) * x_;
    em_dx >= 1 ? em_dta = em_dtb;
  );
  em_dlpl += (dl_ - em_dlpl) * em_dtc; em_dlpr += (dr_ - em_dlpr) * em_dtc;
  em_dhpl += (em_dlpl - em_dhpl) * 0.004; em_dhpr += (em_dlpr - em_dhpr) * 0.004;
  EMDL[em_dpw] = (em_l + em_r) * 0.5 * em_dw + s57_th((em_dlpr - em_dhpr) * em_dfb);
  EMDR[em_dpw] = s57_th((em_dlpl - em_dhpl) * em_dfb);
  em_dpw = (em_dpw + 1) & 262143;
  g_ = min(1, 2 * em_dm) * em_gd * em_dw;
  ol_ += dl_ * g_; or_ += dr_ * g_;
) : em_dcl = 1;
em_rw > 0.0001 ? (
  in_ = (em_l + em_r) * 0.5 * em_rw + 0.000000000000001;
  il_ = emrb.s57_ap(emra.s57_ap(in_, 141, 0.7), 211, 0.7);
  ir_ = emrd.s57_ap(emrc.s57_ap(in_, 173, 0.7), 257, 0.7);
  em_rmo += 0.31 / srate; em_rmo >= 1 ? em_rmo -= 1;
  EMRY[0] = emr0.s57_dlr(EMRP[0] + 6 * sin(6.283185307 * em_rmo)); EMRY[1] = emr1.s57_dlr(EMRP[1]);
  EMRY[2] = emr2.s57_dlr(EMRP[2] - 6 * sin(6.283185307 * em_rmo + 1)); EMRY[3] = emr3.s57_dlr(EMRP[3]);
  EMRY[4] = emr4.s57_dlr(EMRP[4]); EMRY[5] = emr5.s57_dlr(EMRP[5]);
  EMRY[6] = emr6.s57_dlr(EMRP[6]); EMRY[7] = emr7.s57_dlr(EMRP[7]);
  i_ = 0; loop(8, EMRD[i_] += (EMRY[i_] - EMRD[i_]) * em_rkd; EMRY[i_] = EMRD[i_] * EMRG[i_]; i_ += 1; );
  wl_ = EMRY[0] - EMRY[2] + EMRY[4] - EMRY[6]; wr_ = EMRY[1] - EMRY[3] + EMRY[5] - EMRY[7];
  ha_ = EMRY[0] + EMRY[1]; hb_ = EMRY[0] - EMRY[1]; hc_ = EMRY[2] + EMRY[3]; he_ = EMRY[2] - EMRY[3];
  hf_ = EMRY[4] + EMRY[5]; hg_ = EMRY[4] - EMRY[5]; hh_ = EMRY[6] + EMRY[7]; hj_ = EMRY[6] - EMRY[7];
  EMRY[0] = ha_ + hc_; EMRY[2] = ha_ - hc_; EMRY[1] = hb_ + he_; EMRY[3] = hb_ - he_;
  EMRY[4] = hf_ + hh_; EMRY[6] = hf_ - hh_; EMRY[5] = hg_ + hj_; EMRY[7] = hg_ - hj_;
  ha_ = EMRY[0]; EMRY[0] = (ha_ + EMRY[4]) * 0.35355339; EMRY[4] = (ha_ - EMRY[4]) * 0.35355339;
  ha_ = EMRY[1]; EMRY[1] = (ha_ + EMRY[5]) * 0.35355339; EMRY[5] = (ha_ - EMRY[5]) * 0.35355339;
  ha_ = EMRY[2]; EMRY[2] = (ha_ + EMRY[6]) * 0.35355339; EMRY[6] = (ha_ - EMRY[6]) * 0.35355339;
  ha_ = EMRY[3]; EMRY[3] = (ha_ + EMRY[7]) * 0.35355339; EMRY[7] = (ha_ - EMRY[7]) * 0.35355339;
  emr0.s57_dlw(EMRY[0] + il_); emr1.s57_dlw(EMRY[1] + ir_); emr2.s57_dlw(EMRY[2] + il_ * 0.6); emr3.s57_dlw(EMRY[3] - ir_ * 0.6);
  emr4.s57_dlw(EMRY[4]); emr5.s57_dlw(EMRY[5]); emr6.s57_dlw(EMRY[6] - il_ * 0.4); emr7.s57_dlw(EMRY[7] + ir_ * 0.4);
  g_ = min(1, 2 * em_rm) * em_gr * em_rw * em_rcg;
  ol_ += wl_ * g_; or_ += wr_ * g_;
) : em_rcl = 1;

// ---------- the kick: after the effects, straight to the output ----------
em_kl += (em_klt - em_kl) * em_sm;
em_kon ? (
  em_kph += (em_kbase + em_kdrop * em_kpe) / srate; em_kph >= 1 ? em_kph -= 1;
  em_kpe *= em_kpdk;
  kg_ = 1 + 1.5 * (0.35 + 0.65 * em_kpe);
  ks_ = s57_th(sin(6.283185307 * em_kph) * kg_) / s57_th(kg_);
  kn_ = rand(2) - 1; kc_ = (kn_ - em_kz) * em_kce * 0.28; em_kz = kn_; em_kce *= em_kcdk;
  em_kick = (ks_ * em_kae + kc_) * em_kl;
  em_kae *= em_kadk;
  em_kae < 0.00003 ? ( em_kon = 0; em_kick = 0; );
) : em_kick = 0;

// ---------- out ----------
em_og += (em_ogt - em_og) * em_sm;
ol_ = ol_ * em_og + em_kick * em_vol; or_ = or_ * em_og + em_kick * em_vol;
em_vo = max(em_vo * 0.9995, abs(ol_) + abs(or_));
ol_ = emoL.ost_band(ol_); or_ = emoR.ost_band(or_);
ost_out(ol_, or_);
spl0 = abs(ost_l) < 0.0000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.0000000001 ? 0 : ost_r;

@gfx 1200 850
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1200, 850);
s57_pal(0); s57_hv = 0;

// ---------- the card's colours: terracotta (or forest moss), soft gold and polished brass, deep bronze and cream ----------
function em_pal(f) (
  f < 0.5 ? (
    EM_FACE = 0xA8553A; EM_FACED = 0x8E4430; EM_PLT = 0xB3634A; EM_WELL = 0x7E3B28; EM_BARC = 0x4E2416; EM_KEYO = 0x6E3020;
    EM_KEYH = 0x84402C; EM_MOTIF = 0xC97A5C;
  ) : (
    EM_FACE = 0x46553A; EM_FACED = 0x39472F; EM_PLT = 0x506244; EM_WELL = 0x34412B; EM_BARC = 0x232C1C; EM_KEYO = 0x2E3A26;
    EM_KEYH = 0x3D4C33; EM_MOTIF = 0x62765A;
  );
  EM_GOLD = 0xD9B45E; EM_BRASS = 0xB8923E; EM_BRASSD = 0x7A5A1E; EM_CREAM = 0xF4E6CA; EM_CREAMD = 0xE2CFA8; EM_BRONZE = 0x3A2412;
  EM_AMB = 0xF4B648; EM_AMBL = 0xFFD68A; EM_HONEY = 0xEBCB8C; EM_HONEYD = 0xC0904A;
  EM_WIN = 0x24130A; EM_WINK = 0xFFCB6E; EM_WIND = 0x9C6C34; EM_WINF = 0x4A2A14;
);
function em_fonts() (
  s57_fonts();
  sc != em_calsc ? ( em_calsc = sc; em_f13 = ui_fitfont(13, 12 * sc); );
  gfx_setfont(13, "Arial", em_f13, 'b');
  gfx_setfont(12, "Georgia", 17 * sc, 'b'); gfx_setfont(14, "Georgia", 25 * sc, 'b'); gfx_setfont(15, "Georgia", 16 * sc, 'b');
);
em_pal(slider108); em_fonts();

// ---------- the vector motifs ----------
function em_star(cx, cy, r, col) local(i, a0, a1, am) (
  ui_col(col); i = 0;
  loop(5,
    a0 = -0.5 * $pi + i * 0.4 * $pi; a1 = a0 + 0.4 * $pi; am = a0 + 0.2 * $pi;
    gfx_triangle(cx * sc, cy * sc, (cx + cos(a0) * r) * sc, (cy + sin(a0) * r) * sc, (cx + cos(am) * r * 0.42) * sc, (cy + sin(am) * r * 0.42) * sc);
    gfx_triangle(cx * sc, cy * sc, (cx + cos(am) * r * 0.42) * sc, (cy + sin(am) * r * 0.42) * sc, (cx + cos(a1) * r) * sc, (cy + sin(a1) * r) * sc);
    i += 1; );
);
function em_venus(cx, cy, r, col, w) (
  ui_col(col); gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); gfx_circle(cx * sc, cy * sc, (r - w * 0.5) * sc, 0, 1);
  s57_ln(cx, cy + r, cx, cy + r * 2.1, w); s57_ln(cx - r * 0.55, cy + r * 1.55, cx + r * 0.55, cy + r * 1.55, w);
);
// a grain: a small leaf shape at (x, y) pointing at angle a
function em_grain(x, y, a, l, w) local(ca, sa, mx, my, tx, ty) (
  ca = cos(a); sa = sin(a); mx = x + ca * l * 0.5; my = y + sa * l * 0.5; tx = x + ca * l; ty = y + sa * l;
  gfx_triangle(x * sc, y * sc, (mx - sa * w) * sc, (my + ca * w) * sc, tx * sc, ty * sc);
  gfx_triangle(x * sc, y * sc, (mx + sa * w) * sc, (my - ca * w) * sc, tx * sc, ty * sc);
);
// an ear of wheat: the stem from (x, y) at angle a, the grains in pairs up it, the awns
function em_wheat(x, y, l, a, col) local(i, t, px, py, ca, sa) (
  ca = cos(a); sa = sin(a); ui_col(col);
  s57_ln(x, y, x + ca * l, y + sa * l, max(1, l * 0.025));
  i = 0; loop(6,
    t = 0.42 + i * 0.1; px = x + ca * l * t; py = y + sa * l * t;
    em_grain(px, py, a - 0.45, l * 0.16, l * 0.045); em_grain(px, py, a + 0.45, l * 0.16, l * 0.045);
    s57_ln(px + cos(a - 0.45) * l * 0.15, py + sin(a - 0.45) * l * 0.15, px + cos(a - 0.3) * l * 0.34, py + sin(a - 0.3) * l * 0.34, 0.8);
    s57_ln(px + cos(a + 0.45) * l * 0.15, py + sin(a + 0.45) * l * 0.15, px + cos(a + 0.3) * l * 0.34, py + sin(a + 0.3) * l * 0.34, 0.8);
    i += 1; );
  em_grain(x + ca * l, y + sa * l, a, l * 0.16, l * 0.045);
);
// a pomegranate in line-work: the fruit, its crown, a leaf
function em_pome(x, y, r, col) (
  ui_col(col); gfx_circle(x * sc, y * sc, r * sc, 0, 1); gfx_circle(x * sc, y * sc, (r - 0.8) * sc, 0, 1);
  s57_ln(x - r * 0.35, y - r * 0.92, x - r * 0.5, y - r * 1.45, 1); s57_ln(x, y - r, x, y - r * 1.5, 1); s57_ln(x + r * 0.35, y - r * 0.92, x + r * 0.5, y - r * 1.45, 1);
  s57_ln(x - r * 0.45, y - r * 0.15, x - r * 0.1, y + r * 0.45, 0.8); s57_ln(x + r * 0.2, y - r * 0.35, x + r * 0.45, y + r * 0.2, 0.8);
);
function em_leafline(x, y, l, a, col) local(ca, sa, mx, my, tx, ty, w) (
  ca = cos(a); sa = sin(a); w = l * 0.28; mx = x + ca * l * 0.5; my = y + sa * l * 0.5; tx = x + ca * l; ty = y + sa * l;
  ui_col(col); s57_ln(x, y, mx - sa * w, my + ca * w, 1); s57_ln(mx - sa * w, my + ca * w, tx, ty, 1);
  s57_ln(x, y, mx + sa * w, my - ca * w, 1); s57_ln(mx + sa * w, my - ca * w, tx, ty, 1); s57_ln(x, y, tx, ty, 0.8);
);

// ---------- the parts ----------
// a raised plate in the finish's colour, a brass hairline along its top
function em_plate(x, y, w, h) (
  ui_cola(0x000000, 0.22); s57_rr(x + 1, y + 3, w, h, 4);
  ui_col(EM_PLT); s57_rr(x, y, w, h, 4);
  ui_cola(EM_GOLD, 0.45); s57_r(x + 4, y, w - 8, 1);
  ui_cola(0x000000, 0.25); s57_r(x + 4, y + h - 1, w - 8, 1);
);
// a section's title band: deep bronze, the title in cream (serif), its line in soft gold
function em_bar(x, y, w, s, t) local(tw, th) (
  ui_col(EM_BARC); s57_rr(x, y, w, 24, 4); s57_r(x, y + 12, w, 12);
  ui_cola(EM_GOLD, 0.8); s57_r(x, y + 23, w, 1);
  gfx_setfont(12); ui_col(EM_CREAM); gfx_measurestr(s, tw, th); gfx_x = (x + 10) * sc; gfx_y = (y + 12) * sc - th * 0.5; gfx_drawstr(s);
  strlen(t) ? ( gfx_setfont(13); ui_col(EM_GOLD); gfx_x = (x + 20) * sc + tw; gfx_y = (y + 12) * sc - th * 0.5; gfx_drawstr(t); );
);
// a lit key: amber (gold) when lit, the finish's dark when not
function em_key(x, y, w, h, on, s) local(hov, hit) (
  hov = s57_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(EM_AMB, 0.22); s57_rr(x - 3, y - 3, w + 6, h + 6, 4); );
  ui_cola(0x000000, 0.3); s57_rr(x + 1, y + 2, w, h, 3);
  ui_col(EM_BRONZE); s57_rr(x, y, w, h, 3);
  ui_col(on ? (hov ? EM_AMBL : EM_AMB) : hov ? EM_KEYH : EM_KEYO); s57_rr(x + 1.3, y + 1.3, w - 2.6, h - 2.6, 2);
  on ? ( ui_cola(0xFFFFFF, 0.35); s57_r(x + 4, y + 2.5, w - 8, 1); );
  gfx_setfont(13); ui_col(on ? EM_BRONZE : EM_CREAM); s57_tc(x + w * 0.5, y + h * 0.5, s);
  hit;
);
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function em_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#em_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#em_mls, ">"); strcat(#em_mls, pk_pitem(list, i + 1, #em_mi)); strcat(#em_mls, " - ");
                      strcat(#em_mls, pk_pitem(list, min(s0 + grp, n), #em_mi)); strcat(#em_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#em_mls, "<");
    i == cur ? strcat(#em_mls, "!");
    strcat(#em_mls, pk_pitem(list, i + 1, #em_mi));
    i < n - 1 ? strcat(#em_mls, "|");
    i += 1; );
  #em_mls;
);
// a value box: the value in words and a small down-arrow; a click opens the list of every value (list: lo..hi,
// grp > 0 groups it in submenus of grp), the wheel steps it
function em_mbox(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = s57_hov(x, y, w, h);
  ui_cola(0x000000, 0.3); s57_rr(x + 1, y + 2, w, h, 3);
  ui_col(EM_BRONZE); s57_rr(x, y, w, h, 3);
  ui_col(hov ? EM_KEYH : EM_KEYO); s57_rr(x + 1.3, y + 1.3, w - 2.6, h - 2.6, 2);
  gfx_setfont(13); ui_col(EM_CREAM); s57_tc(x + (w - 11) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 13) * sc, (y + h * 0.5 - 2) * sc, (x + w - 6) * sc, (y + h * 0.5 - 2) * sc, (x + w - 9.5) * sc, (y + h * 0.5 + 2.5) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(em_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? s57_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( s57_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
// the warm resin knob: a value ring in brass round it, a honey skirt, a cream-honey cap, the brass index line (flat)
function em_cap(cx, cy, r, n, bip) local(a, ca, sa, i, t0, t1, n0, w) (
  w = r >= 24 ? 3 : 2.2;
  n0 = bip ? 0.5 : 0;
  i = 0; loop(27,
    t0 = i / 27; t1 = (i + 1) / 27;
    ui_cola((t1 > min(n, n0) + 0.0001 && t0 < max(n, n0) - 0.0001) ? EM_GOLD : EM_BRONZE, (t1 > min(n, n0) + 0.0001 && t0 < max(n, n0) - 0.0001) ? 1 : 0.55);
    a = -0.75 * $pi + t0 * 1.5 * $pi; t1 = -0.75 * $pi + t1 * 1.5 * $pi;
    s57_ln(cx + sin(a) * (r + 5), cy - cos(a) * (r + 5), cx + sin(t1) * (r + 5), cy - cos(t1) * (r + 5), w);
    i += 1; );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.28); gfx_circle((cx + 1.2) * sc, (cy + 2.4) * sc, r * sc, 1, 1);
  ui_col(EM_HONEYD); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(EM_HONEY); gfx_circle(cx * sc, cy * sc, (r - max(2, r * 0.12)) * sc, 1, 1);
  ui_col(EM_BRASSD); s57_ln(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * (r - 1.5), cy + sa * (r - 1.5), max(2.6, r * 0.14));
  ui_col(EM_GOLD); s57_ln(cx + ca * r * 0.2, cy + sa * r * 0.2, cx + ca * (r - 2.5), cy + sa * (r - 2.5), max(1, r * 0.05));
);
function em_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(EM_BRONZE); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 5 * sc, 3 * sc);
  ui_col(EM_AMBL); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2.5 * sc; gfx_drawstr(s);
);
// the knob: drag (SHIFT fine), double-click / Ctrl-click the default, the wheel; the value only while touched
function em_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  def = EMDEF[idx - 1]; did = 4000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - s57_lt < 0.35 && s57_lid == idx && !s57_mv) || (mouse_cap & 4) ? ( s57_set(idx, def); drag_id = -1; s57_lt = 0; ) : (
      drag_id = did; s57_ky = mouse_y; s57_ky0 = mouse_y; s57_mv = 0; s57_lt = time_precise(); s57_lid = idx;
      s57_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !s57_mv && abs(mouse_y - s57_ky0) > 3 * sc ? ( s57_mv = 1; s57_ky = mouse_y; );
  drag_id == did && s57_mv ? (
    s57_kn = min(max(s57_kn + (s57_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc * (r >= 24 ? 1.4 : 1)), 0), 1); s57_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ s57_kn : lo + s57_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s57_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    s57_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  em_cap(cx, cy, r, min(max(n, 0), 1), lo < 0 && hi > 0);
  (hov || drag_id == did) ? (
    sprintf(#em_vv, fmt, v); em_pill(cx, cy + r + 7, #em_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(11); ui_col(EM_CREAM); s57_tc(cx, cy + r + 17, label); );
  );
);
// a weighted fader (upright): a dark slot, brass ticks, a cream resin cap with its brass line
function em_fader(cx, y, h, idx, lo, hi, def, label, fmt) local(v, n, hov, did, py, i) (
  def = EMDEF[idx - 1]; did = 5000 + idx; v = slider(idx); n = (v - lo) / (hi - lo); py = y + h * (1 - n);
  hov = s57_hov(cx - 14, y - 10, 28, h + 20);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - s57_lt < 0.35 && s57_lid == idx && !s57_mv) || (mouse_cap & 4) ? ( s57_set(idx, def); drag_id = -1; s57_lt = 0; ) : (
      drag_id = did; s57_ky = mouse_y; s57_ky0 = mouse_y; s57_mv = 0; s57_lt = time_precise(); s57_lid = idx; s57_kn = n; );
  );
  drag_id == did && !s57_mv && abs(mouse_y - s57_ky0) > 2 * sc ? ( s57_mv = 1; s57_ky = mouse_y; );
  drag_id == did && s57_mv ? (
    s57_kn = min(max(s57_kn + (s57_ky - mouse_y) / (((mouse_cap & 8) ? 6 : 1) * h * sc), 0), 1); s57_ky = mouse_y;
    s57_set(idx, lo + s57_kn * (hi - lo));
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( s57_set(idx, min(max(v + mouse_wheel / 120 * (hi - lo) * 0.02, lo), hi)); mouse_wheel = 0; );
  v = slider(idx); n = (v - lo) / (hi - lo); py = y + h * (1 - n);
  i = 0; loop(11, ui_cola(EM_GOLD, i == 0 || i == 10 || i == 5 ? 0.8 : 0.45); s57_r(cx - (i == 0 || i == 10 || i == 5 ? 12 : 10), y + h * i / 10, i == 0 || i == 10 || i == 5 ? 6 : 4, 1); s57_r(cx + (i == 0 || i == 10 || i == 5 ? 6 : 6), y + h * i / 10, i == 0 || i == 10 || i == 5 ? 6 : 4, 1); i += 1; );
  ui_col(EM_BRONZE); s57_rr(cx - 3, y - 2, 6, h + 4, 2); ui_col(0x170C06); s57_r(cx - 1.5, y, 3, h);
  ui_cola(EM_AMB, 0.55); s57_r(cx - 1, py, 2, y + h - py);
  ui_cola(0x000000, 0.3); s57_rr(cx - 11 + 1, py - 7 + 2.5, 22, 14, 3);
  ui_col(EM_HONEYD); s57_rr(cx - 11, py - 7, 22, 14, 3); ui_col(EM_HONEY); s57_rr(cx - 9.5, py - 5.5, 19, 11, 2);
  ui_col(EM_BRASSD); s57_r(cx - 9.5, py - 1, 19, 2);
  (hov || drag_id == did) ? ( sprintf(#em_vv, fmt, v); em_pill(cx, y + h + 6, #em_vv); ) :
    strlen(label) ? ( gfx_setfont(11); ui_col(EM_CREAM); s57_tc(cx, y + h + 16, label); );
);

// ---------- the face ----------
ui_col(EM_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
// a fine double brass rule framing the card
ui_cola(EM_GOLD, 0.5); s57_r(6, 6, 1188, 1); s57_r(6, 843, 1188, 1); s57_r(6, 6, 1, 838); s57_r(1193, 6, 1, 838);
ui_cola(EM_GOLD, 0.25); s57_r(9, 9, 1182, 1); s57_r(9, 840, 1182, 1); s57_r(9, 9, 1, 832); s57_r(1190, 9, 1, 832);

// ---------- the header ----------
ui_col(EM_GOLD); s57_r(10, 52, 1180, 2);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
gk_ = pk_preset(20 * sc, 10 * sc, 400 * sc, 34 * sc, pr_cur, #em_pm);
gk_ > 0 ? ( gk_ == 13 ? (
  load_preset(1); gi_ = 1; loop(107, (gi_ == 63 || gi_ == 65 || (gi_ >= 97 && gi_ <= 106)) ? ( slider(gi_) = EMDEF[gi_ - 1]; ui_auto(gi_); ); gi_ += 1; ); pr_cur = 13;
) : prs_dirty = gk_; );
// the numeral in its crown of twelve stars, Venus either side
ui_col(EM_BARC); gfx_circle(600 * sc, 28 * sc, 17 * sc, 1, 1); ui_col(EM_GOLD); gfx_circle(600 * sc, 28 * sc, 17 * sc, 0, 1);
gfx_setfont(15); ui_col(EM_CREAM); s57_tc(600, 28, "III");
gi_ = 0; loop(12, ga_ = gi_ * $pi / 6; em_star(600 + cos(ga_) * 23, 28 + sin(ga_) * 23, 3.4, EM_GOLD); gi_ += 1; );
em_venus(530, 20, 7, EM_GOLD, 1.8); em_venus(670, 20, 7, EM_GOLD, 1.8);
em_wheat(470, 44, 30, -0.5 * $pi - 0.35, EM_BRASS); em_wheat(730, 44, 30, -0.5 * $pi + 0.35, EM_BRASS);
em_key(754, 16, 112, 22, slider108 < 0.5, "TERRACOTTA") ? s57_set(108, 0);
em_key(872, 16, 64, 22, slider108 >= 0.5, "MOSS") ? s57_set(108, 1);
gfx_setfont(13); ui_col(EM_CREAM); s57_t(956, 21, "MIDI"); pk_led(1002 * sc, 27 * sc, 4 * sc, ins_midi_lit(), EM_AMB);
sprintf(#gt_, "CH %s", slider99 == 0 ? "OMNI" : ""); slider99 > 0 ? sprintf(#gt_, "CH %d", slider99);
em_mbox(1016, 16, 88, 22, 99, 0, 16, #gt_, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", 0);
ui_size_picker(1126 * sc, 18 * sc);

// ---------- THE PULSE: the kick and the ducking ----------
em_plate(20, 62, 280, 238);
em_bar(20, 62, 280, "THE PULSE", "KICK  &  DUCK");
em_key(32, 96, 58, 24, slider63 >= 0.5, "RUN") ? s57_set(63, slider63 >= 0.5 ? 0 : 1);
pk_led(104 * sc, 108 * sc, 5 * sc, em_kfl > 0.05 && slider63 >= 0.5, EM_AMB);
gi_ = 0; loop(4, pk_pitem("1/4|1/8|1/2|1/4+", gi_ + 1, #gt_); em_key(122 + gi_ * 43, 96, 40, 24, slider64 == gi_, #gt_) ? s57_set(64, gi_); gi_ += 1; );
em_knob(62, 168, 18, 65, 0, 100, 0, 0, "KICK", "%.0f%%", 0);
em_knob(140, 168, 18, 66, 0, 100, 50, 0, "TONE", "%.0f%%", 0);
em_knob(218, 168, 18, 67, 100, 1500, 420, 1, "DECAY", "%.0f ms", 0);
ui_cola(EM_GOLD, 0.35); s57_r(32, 214, 256, 1);
em_knob(62, 254, 18, 68, 40, 1000, 300, 1, "RELEASE", "%.0f ms", 0);
em_knob(140, 254, 18, 69, 0, 100, 60, 0, "SHAPE", "%.0f%%", 0);
// the pump's shape: one hit and its swell, as the two knobs draw it
gx_ = 184; gy_ = 224; gw_ = 104; gh_ = 64;
ui_col(EM_WIN); s57_rr(gx_, gy_, gw_, gh_, 3); ui_cola(EM_GOLD, 0.6); gfx_rect(gx_ * sc, gy_ * sc, gw_ * sc, gh_ * sc, 0);
gsh_ = 4 ^ ((slider69 - 50) / 50); grl_ = slider68 / 1000;
ui_cola(EM_WINK, 0.12); s57_r(gx_ + 6, gy_ + 10, gw_ - 12, 1);
gi_ = 0; gpx_ = gx_ + 6; gpy_ = gy_ + 10;
loop(49, gt_ = gi_ / 48 * 0.75; gu_ = (gt_ - 0.006) / grl_; ge_ = gt_ < 0.006 ? 0.5 - 0.5 * cos($pi * gt_ / 0.006) : gu_ < 1 ? 1 - gu_ ^ gsh_ : 0;
  gnx_ = gx_ + 6 + (gw_ - 12) * gi_ / 48; gny_ = gy_ + 10 + ge_ * (gh_ - 22);
  gi_ > 0 ? ( ui_col(EM_WINK); s57_ln(gpx_, gpy_, gnx_, gny_, 1.4); ); gpx_ = gnx_; gpy_ = gny_; gi_ += 1; );
gfx_setfont(13); ui_col(EM_WIND); s57_t(gx_ + 6, gy_ + gh_ - 14, "0.75 S");

// ---------- THE HARVEST: FATE and the output ----------
em_plate(900, 62, 280, 238);
em_bar(900, 62, 280, "THE HARVEST", "FATE  &  OUT");
em_knob(962, 146, 30, 97, 0, 100, 50, 0, "FATE", "%.0f%%", 0);
gfx_setfont(13); ui_col(EM_CREAMD); s57_tc(962, 210, "BREATHING"); s57_tc(962, 224, "GROWTH");
em_knob(1046, 122, 16, 98, -24, 6, -6, 0, "VOLUME", "%+.1f dB", 0);
em_knob(1124, 122, 16, 107, 0, 100, 60, 0, "LEVEL", "%.0f%%", 0);
em_knob(1046, 194, 14, 100, 0, 100, 40, 0, "VELOCITY", "%.0f%%", 0);
em_knob(1124, 194, 14, 101, 0, 100, 0, 0, "SAT", "%.0f%%", 0);
ost_clipped ? pk_led(1146 * sc, 182 * sc, 3.5 * sc, 1, 0xFF4A22); ost_clipped = 0;
gmeter_ = max(gmeter_ * 0.85, em_vo);
gfx_setfont(13); ui_col(EM_CREAM); s57_t(914, 248, "OUT");
gi_ = 0; loop(16, gon_ = 20 * log10(max(gmeter_ * 0.5, 0.00001)) > -36 + gi_ * 2.4;
  ui_col(gon_ ? (gi_ >= 14 ? 0xE0402A : gi_ >= 11 ? EM_AMBL : EM_AMB) : EM_WELL); s57_r(950 + gi_ * 14, 246, 11, 14); gi_ += 1; );
gfx_setfont(13); ui_col(EM_CREAMD); sprintf(#gt_, "VOICES %d + %d", em_nact, em_nled); s57_t(914, 272, #gt_);

// ---------- the display: the field (the autopan's bands) and the pulse (the ducking over the last bar) ----------
gx_ = 312; gy_ = 62; gw_ = 576; gh_ = 238;
ui_cola(0x000000, 0.25); s57_rr(gx_ + 1, gy_ + 3, gw_, gh_, 6);
ui_col(EM_BRASS); s57_rr(gx_, gy_, gw_, gh_, 6); ui_col(EM_BRONZE); s57_rr(gx_ + 3, gy_ + 3, gw_ - 6, gh_ - 6, 4);
ui_col(EM_WIN); s57_rr(gx_ + 6, gy_ + 6, gw_ - 12, gh_ - 12, 3);
// the warm glow from within
gi_ = 0; loop(6, ui_cola(0xC06A20, 0.035); s57_rr(gx_ + 30 + gi_ * 18, gy_ + 24 + gi_ * 10, gw_ - 60 - gi_ * 36, gh_ - 48 - gi_ * 20, 20); gi_ += 1; );
// leaf line-work in the corners
em_leafline(gx_ + 12, gy_ + gh_ - 12, 16, -0.6, EM_WINF); em_leafline(gx_ + gw_ - 12, gy_ + gh_ - 12, 16, $pi + 0.6, EM_WINF);
ui_cola(EM_WIND, 0.5); s57_r(gx_ + 300, gy_ + 20, 1, gh_ - 40);
// (a) THE FIELD: frequency upright (20 Hz at the foot, 20 kHz at the top), the stereo field across
gax_ = gx_ + 66; gaw_ = 186; gay_ = gy_ + 40; gah_ = 180;
gfx_setfont(13); ui_col(EM_WINK); s57_t(gx_ + 18, gy_ + 14, "THE FIELD"); ui_col(EM_WIND); s57_t(gx_ + 104, gy_ + 14, "AUTOPAN");
s57_tc(gax_, gay_ - 8, "L"); s57_tc(gax_ + gaw_, gay_ - 8, "R");
ui_cola(EM_WIND, 0.45); s57_r(gax_ + gaw_ * 0.5, gay_, 1, gah_); s57_r(gax_, gay_, 1, gah_); s57_r(gax_ + gaw_, gay_, 1, gah_);
gx1_ = gay_ + gah_ - gah_ * log(slider76 / 20) / log(1000); gx2_ = gay_ + gah_ - gah_ * log(slider77 / 20) / log(1000);
// the three bands: their lanes shaded, their depth as a bar, their place now as a glowing marker
gi_ = 0; loop(3,
  gt_ = gi_ == 0 ? gx1_ : gi_ == 1 ? gx2_ : gay_; gb_ = gi_ == 0 ? gay_ + gah_ : gi_ == 1 ? gx1_ : gx2_;
  ui_cola(EM_WINK, gi_ == 1 ? 0.07 : 0.035); s57_r(gax_ + 1, gt_, gaw_ - 1, gb_ - gt_);
  gm_ = (gt_ + gb_) * 0.5; gd_ = gi_ == 0 ? slider79 : gi_ == 1 ? slider81 : slider83; gd_ *= slider75 >= 0.5 ? 0.01 : 0;
  ui_cola(EM_WINK, 0.3); s57_r(gax_ + gaw_ * (0.5 - gd_ * 0.5), gm_ - 1, gaw_ * gd_, 2);
  gp_ = slider75 >= 0.5 ? (gi_ == 0 ? em_pp0 : gi_ == 1 ? em_pp1 : em_pp2) : 0;
  gpx_ = gax_ + gaw_ * (0.5 + 0.5 * gp_);
  ui_cola(EM_AMB, 0.18); gfx_circle(gpx_ * sc, gm_ * sc, 11 * sc, 1, 1);
  ui_cola(EM_AMB, 0.35); gfx_circle(gpx_ * sc, gm_ * sc, 7 * sc, 1, 1);
  ui_col(EM_AMBL); gfx_circle(gpx_ * sc, gm_ * sc, 4 * sc, 1, 1);
  ui_col(EM_WINK); s57_r(gpx_ - 0.75, gt_ + 3, 1.5, gb_ - gt_ - 6);
  gfx_setfont(13); ui_col(EM_WIND); s57_t(gax_ + gaw_ + 8, gm_ - 6, gi_ == 0 ? "LOW" : gi_ == 1 ? "MID" : "HIGH");
  gi_ += 1; );
// the crossovers
ui_col(EM_WINK); s57_r(gax_ - 6, gx1_, gaw_ + 12, 1.5); s57_r(gax_ - 6, gx2_, gaw_ + 12, 1.5);
gfx_setfont(13);
sprintf(#gt_, "%.0f", slider76); gfx_measurestr(#gt_, gtw_, gth_); s57_t(gax_ - 10 - gtw_ / sc, gx1_ - 7, #gt_);
sprintf(#gt_, "%.1fK", slider77 / 1000); gfx_measurestr(#gt_, gtw_, gth_); s57_t(gax_ - 10 - gtw_ / sc, gx2_ - 7, #gt_);
ui_col(EM_WIND); s57_t(gx_ + 16, gay_ + gah_ - 10, "20"); s57_t(gx_ + 16, gay_ - 2, "20K");
// (b) THE PULSE: the last bar - the kick's hits, each layer's gain reduction, the beat now
gbx_ = gx_ + 348; gbw_ = 178; gby_ = gy_ + 40; gbh_ = 160;
gfx_setfont(13); ui_col(EM_WINK); s57_t(gx_ + 318, gy_ + 14, "THE PULSE"); ui_col(EM_WIND); s57_t(gx_ + 404, gy_ + 14, "DUCKING");
sprintf(#gt_, "%s %.0f BPM", (play_state & 1) ? "SYNC" : "FREE", tempo); gfx_measurestr(#gt_, gtw_, gth_); s57_t(gx_ + gw_ - 18 - gtw_ / sc, gy_ + 14, #gt_);
ui_cola(EM_WIND, 0.35); gi_ = 0; loop(5, s57_r(gbx_ + gbw_ * gi_ / 4, gby_, 1, gbh_); gi_ += 1; );
ui_cola(EM_WIND, 0.25); s57_r(gbx_, gby_ + gbh_ * 0.5, gbw_, 1); s57_r(gbx_, gby_ + gbh_, gbw_, 1);
ui_col(EM_WIND); s57_t(gbx_ - 30, gby_ - 6, "0"); s57_t(gbx_ - 34, gby_ + gbh_ * 0.5 - 6, "-12"); s57_t(gbx_ - 34, gby_ + gbh_ - 6, "-24");
gi_ = 0; loop(4, sprintf(#gt_, "%d", gi_ + 1); s57_t(gbx_ + gbw_ * gi_ / 4 + 4, gby_ + gbh_ + 6, #gt_); gi_ += 1; );
// the hits
gi_ = 0; loop(256, gk_ = EMK[gi_]; gk_ > 0 ? ( ui_cola(EM_AMB, 0.25 + 0.5 * gk_); s57_r(gbx_ + gbw_ * gi_ / 256 - 1, gby_, 2.5, gbh_ * gk_); ); gi_ += 1; );
// each layer's gain reduction (dB down from the top)
gc_ = 0; loop(3,
  gkey_ = gc_ == 0 ? slider19 * (slider1 >= 0.5) : gc_ == 1 ? slider39 * (slider21 >= 0.5) : slider62 * (slider41 >= 0.5);
  gkey_ > 0 && slider63 >= 0.5 ? (
    ui_col(gc_ == 0 ? EM_AMBL : gc_ == 1 ? EM_AMB : EM_CREAM);
    gi_ = 0; loop(256, gnx_ = gbx_ + gbw_ * gi_ / 256; gny_ = gby_ + min(gkey_ * 2.4 * EMH[gi_] / 24, 1) * gbh_ + gc_ * 1.2;
      gi_ > 0 && abs(gi_ - em_slot) > 1 ? s57_ln(gpx_, gpy_, gnx_, gny_, gc_ == 0 ? 2 : 1.4); gpx_ = gnx_; gpy_ = gny_; gi_ += 1; );
  );
  gc_ += 1; );
ui_col(EM_CREAM); s57_r(gbx_ + gbw_ * em_slot / 256, gby_ - 4, 1.5, gbh_ + 8);
// the legend
gfx_setfont(13);
ui_col(EM_AMBL); s57_r(gbx_ + gbw_ + 12, gby_ + 10, 14, 2); s57_t(gbx_ + gbw_ + 30, gby_ + 4, "I");
ui_col(EM_AMB); s57_r(gbx_ + gbw_ + 12, gby_ + 30, 14, 2); s57_t(gbx_ + gbw_ + 30, gby_ + 24, "II");
ui_col(EM_CREAM); s57_r(gbx_ + gbw_ + 12, gby_ + 50, 14, 2); s57_t(gbx_ + gbw_ + 30, gby_ + 44, "III");
slider63 < 0.5 ? ( ui_col(EM_WIND); s57_tc(gbx_ + gbw_ * 0.5, gby_ + gbh_ * 0.5 - 20, "THE KICK RESTS"); );

// ---------- the three layers ----------
// the left of a layer: ON, the LEVEL fader, KEY (large, its scale printed), PAN, OCTAVE
function em_layer(x, y, b, title, sub, kidx) local(i, a, v) (
  em_plate(x, y, 380, 332);
  em_bar(x, y, 380, title, sub);
  em_key(x + 312, y + 3, 60, 18, slider(b + 1) >= 0.5, "ON") ? s57_set(b + 1, slider(b + 1) >= 0.5 ? 0 : 1);
  em_fader(x + 24, y + 44, 240, b + 2, 0, 100, slider(b + 2), "LEVEL", "%.0f%%");
  // KEY: the duck's depth, 0 - 10
  gfx_setfont(13); ui_col(EM_CREAMD);
  i = 0; loop(6, a = -0.75 * $pi + i * 0.3 * $pi; sprintf(#gt_, "%d", i * 2); s57_tc(x + 96 + sin(a) * 45, y + 82 - cos(a) * 45, #gt_); i += 1; );
  em_knob(x + 96, y + 82, 28, kidx, 0, 10, 0, 0, "", "KEY %.1f", 0);
  gfx_setfont(12); ui_col(EM_CREAM); s57_tc(x + 96, y + 136, "KEY");
  v = slider(kidx); gfx_setfont(13); ui_col(EM_GOLD); s57_tc(x + 96, y + 154, v <= 0 ? "NO DUCK" : v >= 9 ? "DEEP PUMP" : v >= 5 ? "PUMPING" : "BREATHING");
  em_knob(x + 74, y + 206, 14, b + 3, -100, 100, 0, 0, "PAN", "%+.0f", 0);
  em_knob(x + 122, y + 206, 14, b + 4, -2, 2, 0, 0, "OCT", "%+.0f", 1);
);
// a pad layer (OSC 1 / OSC 2): the DCO, the filter, the envelope, and a picture of its wave
function em_padcol(x, y, b, title, kidx) local(i, gx, gy, gw, gh, p, w, yy, px, py) (
  em_layer(x, y, b - 1, title, "CLASSIC PAD", kidx);
  em_knob(x + 170, y + 54, 15, b + 4, 0, 100, 0, 0, "SAW", "%.0f%%", 0);
  em_knob(x + 228, y + 54, 15, b + 5, 0, 100, 0, 0, "PULSE", "%.0f%%", 0);
  em_knob(x + 286, y + 54, 15, b + 6, 5, 95, 50, 0, "PW", "%.0f%%", 0);
  em_knob(x + 344, y + 54, 15, b + 9, 0, 100, 0, 0, "SUB", "%.0f%%", 0);
  em_knob(x + 170, y + 122, 15, b + 7, 0, 100, 0, 0, "PWM", "%.0f%%", 0);
  em_knob(x + 228, y + 122, 15, b + 8, 0.05, 10, 0.5, 1, "RATE", "%.2f Hz", 0);
  em_knob(x + 286, y + 122, 15, b + 10, 0, 100, 0, 0, "NOISE", "%.0f%%", 0);
  em_knob(x + 344, y + 122, 15, b + 19, -50, 50, 0, 0, "DETUNE", "%+.1f ct", 0);
  em_knob(x + 170, y + 190, 15, b + 11, 20, 18000, 1500, 1, "CUTOFF", "%.0f Hz", 0);
  em_knob(x + 228, y + 190, 15, b + 12, 0, 100, 15, 0, "RESO", "%.0f%%", 0);
  em_knob(x + 286, y + 190, 15, b + 13, -100, 100, 20, 0, "ENV", "%+.0f%%", 0);
  em_knob(x + 170, y + 258, 15, b + 14, 0.001, 10, 0.6, 1, "ATT", "%.3f s", 0);
  em_knob(x + 228, y + 258, 15, b + 15, 0.01, 10, 1.5, 1, "DEC", "%.2f s", 0);
  em_knob(x + 286, y + 258, 15, b + 16, 0, 100, 80, 0, "SUS", "%.0f%%", 0);
  em_knob(x + 344, y + 258, 15, b + 17, 0.01, 15, 2.5, 1, "REL", "%.2f s", 0);
  // the wave: two cycles of the saw, pulse and sub as set
  gx = x + 319; gy = y + 170; gw = 50; gh = 40;
  ui_col(EM_WIN); s57_rr(gx, gy, gw, gh, 3); ui_cola(EM_GOLD, 0.5); gfx_rect(gx * sc, gy * sc, gw * sc, gh * sc, 0);
  i = 0; loop(41, p = i / 20; p -= p | 0; w = (slider(b + 6) / 100);
    yy = (2 * p - 1) * slider(b + 4) / 100 + (p < w ? 1 : -1) * slider(b + 5) / 100 + ((i / 20 * 0.5 - ((i / 20 * 0.5) | 0)) < 0.5 ? 1 : -1) * slider(b + 9) / 100 * 0.8;
    yy = min(max(yy / 1.6, -1), 1);
    i > 0 ? ( ui_col(EM_WINK); s57_ln(px, py, gx + 4 + i, gy + gh * 0.5 - yy * gh * 0.38, 1.2); ); px = gx + 4 + i; py = gy + gh * 0.5 - yy * gh * 0.38; i += 1; );
  gfx_setfont(13); ui_col(EM_CREAMD); s57_tc(gx + gw * 0.5, gy + gh + 10, "WAVE");
);
em_padcol(20, 308, 1, "OSC 1", 19);
em_padcol(410, 308, 21, "OSC 2", 39);
// the lead layer (OSC 3)
em_layer(800, 308, 40, "OSC 3", "SINGING LEAD", 62);
em_key(849, 564, 47, 22, slider45 >= 0.5, slider45 >= 0.5 ? "A PLS" : "A SAW") ? s57_set(45, slider45 >= 0.5 ? 0 : 1);
em_key(899, 564, 47, 22, slider46 >= 0.5, slider46 >= 0.5 ? "B PLS" : "B SAW") ? s57_set(46, slider46 >= 0.5 ? 0 : 1);
