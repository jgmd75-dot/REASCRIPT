  ng_knob(1124, ng_cy, 9, ng_i == 0 ? 149 : ng_i == 1 ? 151 : ng_i == 2 ? 153 : 170, 0, 100, 0, 0, "", "%.0f%%", 0);
  ng_knob(1158, ng_cy, 9, ng_i == 0 ? 150 : ng_i == 1 ? 152 : ng_i == 2 ? 154 : 171, 0, 100, 0, 0, "", "%.0f%%", 0);
  ng_i += 1;
);
ng_lfont = 10;

// ---------- LFO 1 - 8 ----------
ng_k_ = 0;
loop(8,
  ng_x = 20 + ng_k_ * 145.75; ng_b = 91 + ng_k_ * 6; ng_q = HL + ng_k_ * 16;
  ng_sect(ng_x, 606, 140, 132, ng_k_ & 1 ? SHC : SHB, "");
  sprintf(#ng_g, "LFO %d", ng_k_ + 1); ng_sub(ng_x + 9, 606, #ng_g);
  // its value now: a lantern that brightens and dims with it
  ng_v = 0.5 + 0.5 * ng_q[4];
  ui_col(INK); gfx_circle((ng_x + 126) * sc, 616 * sc, 7 * sc, 1, 1);
  ui_col(ui_mix(NIGHT, LANT, ng_v)); gfx_circle((ng_x + 126) * sc, 616 * sc, 5.5 * sc, 1, 1);
  ng_i = 0;
  loop(6, ng_gkey(ng_x + 6 + ng_i * 21.5, 632, 20, 18, floor(slider(ng_b) + 0.5) == ng_i, ng_i) ? ng_set(ng_b, ng_i); ng_i += 1; );
  ng_lfont = 16;
  slider(ng_b + 2) >= 0.5 ? (
    strcpy(#ng_vs, pk_pitem("8 bars|4 bars|2 bars|1 bar|1/2|1/2T|1/4|1/4T|1/8|1/8T|1/16|1/16T", floor(slider(ng_b + 3) + 0.5) + 1, #ng_k));
    ng_knob(ng_x + 24, 670, 11, ng_b + 3, 0, 11, 3, 0, "RATE", "", 1);
  ) : ng_knob(ng_x + 24, 670, 11, ng_b + 1, 0.01, 20, 0.15, 1, "RATE", "%.3f Hz", 0);
  ng_knob(ng_x + 66, 670, 11, ng_b + 4, -100, 100, 0, 0, "DEPTH", "%+.0f%%", 0);
  ng_lfont = 10;
  ng_toggle(ng_x + 90, 660, 44, 20, ng_b + 2, "SYNC");
  ng_field(ng_x + 6, 704, 128, 22, pk_pitem("PITCH|TUNING|WAVE|PW|CUTOFF|RESO|LENGTH|AMP|PAN|DELAY SEND|REVERB SEND|ARP GATE|PAD LEVEL|BASS CUTOFF|NEXT LFO RATE|OCTAVE", floor(slider(ng_b + 5) + 0.5) + 1, #ng_k)) ?
    ng_menu(ng_x + 6, 726, ng_b + 5, "Pitch (vibrato)|Tuning (osc 2 detune)|Wave|Pulse width|Cutoff|Resonance|Length (all four ADSR stages)|Amp (tremolo)|Pan|Delay send|Reverb send|Arp gate|Pad level|Bass cutoff|Next LFO's rate|Octave (stepped)", 16);
  ng_k_ += 1;
);

// ---------- the foot of the card: VOLUME, the name, SAT and the level ----------
ui_col(INK); ng_r(13, 744, 1174, 2);
ui_col(PANX); ng_r(13, 746, 1174, 41);
ng_knob(40, 766, 13, 6, -24, 6, -4, 0, "", "%+.1f dB", 0);
drag_id != 2006 && !(sqr(mouse_x - 40 * sc) + sqr(mouse_y - 766 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(LBL); ng_t(60, 758, "VOLUME"); );
// the name plate, between two lanterns
ui_col(INK); ng_rr(448, 750, 304, 33, 5); ui_col(SILV); ng_rr(450, 752, 300, 29, 4);
gfx_setfont(14); ui_col(INK); ng_tc(600, 767, "THE HERMIT"); ver_tag("v3", 9, 0, 0);
ng_lantern(424, 767, 1, hm_run); ng_lantern(776, 767, 1, hm_run);
// SAT (the output stage) and a level bar
ins_io(952, 747, 156, LBL);
ng_lv = min(max((20 * log10(max(hm_pk, 0.00001)) + 48) / 48, 0), 1); hm_pk *= 0.8;
ui_col(INK); ng_r(1060, 762, 112, 14); ui_col(NIGHT); ng_r(1061.5, 763.5, 109, 11);
ng_i = 0; loop(18, ng_on = ng_i / 18 < ng_lv; ui_col(ng_on ? (ng_i >= 16 ? 0xFF3A2A : ng_i >= 13 ? LANTL : SILV) : 0x3A3448); ng_r(1063 + ng_i * 6, 765, 4.6, 8); ng_i += 1; );
gfx_setfont(11); ui_col(LBL); ng_t(1060, 747, "LEVEL");

pk_end();
ui_end();

