function load_preset(p) local(n, i) (
  // PLAY (run, follow, transport), FATE, VOLUME and the output stage stay as they are
  i = 0; loop(173, i != 0 && i != 1 && i != 4 && i != 5 && (i < 155 || i >= 161) ? slider(i + 1) = HDEF[i]; i += 1; );
  n = hm_nums(hm_pstr(p), HTMP);
  i = 0; loop(floor(n / 2), HTMP[i * 2] >= 1 && HTMP[i * 2] <= 173 ? slider(HTMP[i * 2]) = HTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(173, ui_auto(i); i += 1; );
  pr_cur = p; hm_panic = 1;
);
function load_preset_au(p) local(n, i) (
  // PLAY (run, follow, transport), FATE, VOLUME and the output stage stay as they are
  i = 0; loop(173, i != 0 && i != 1 && i != 4 && i != 5 && (i < 155 || i >= 161) ? slider(i + 1) = HDEF[i]; i += 1; );
  n = hm_nums_au(hm_pstr_au(p), HTMP);
  i = 0; loop(floor(n / 2), HTMP[i * 2] >= 1 && HTMP[i * 2] <= 173 ? slider(HTMP[i * 2]) = HTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(173, ui_auto(i); i += 1; );
  pr_cur = p; hm_panic = 1;
);
function reset_all() local(i) (
  load_preset(1);
  i = 0; loop(173, slider(i + 1) = HDEF[i]; ui_auto(i + 1); i += 1; );
  slider174 = 1; ui_auto(174);
);

// ---------- rates ----------
function hm_lfo_beats(r) ( r == 0 ? 32 : r == 1 ? 16 : r == 2 ? 8 : r == 3 ? 4 : r == 4 ? 2 : r == 5 ? 4 / 3 : r == 6 ? 1 :
                           r == 7 ? 2 / 3 : r == 8 ? 0.5 : r == 9 ? 1 / 3 : r == 10 ? 0.25 : 1 / 6; );
function hm_dly_beats(r) ( r == 0 ? 2 : r == 1 ? 1.5 : r == 2 ? 1 : r == 3 ? 2 / 3 : r == 4 ? 0.75 : r == 5 ? 0.5 : r == 6 ? 1 / 3 : 0.25; );
function hm_rate_beats(r) ( r == 0 ? 1 : r == 1 ? 0.5 : r == 2 ? 1 / 3 : r == 3 ? 0.25 : r == 4 ? 1 / 6 : 0.125; );
function hm_lfov(sh, ph, hv, a, b) (
  sh == 0 ? sin(2 * $pi * ph) : sh == 1 ? 1 - 4 * abs(ph - 0.5) : sh == 2 ? 2 * ph - 1 :
  sh == 3 ? (ph < 0.5 ? 1 : -1) : sh == 4 ? hv : a + (b - a) * (0.5 - 0.5 * cos($pi * ph));
);
function hm_mod(a, n) ( a - floor(a / n) * n; );

// ---------- LENGTH: one setting for attack, decay, sustain and release together ----------
function hm_len(q, L) local(a, d, r) (
  L = min(max(L, 0), 1);
  a = 2 + 1998 * L ^ 2.4; d = 80 + 3920 * L ^ 1.5; r = 40 + 5960 * L ^ 1.7;
  q[7] = vo_coef(a * 0.6); q[8] = vo_coef(d); q[9] = 0.85 * L ^ 0.6; q[10] = vo_coef(r);
);

function hm_vpan(q, p) ( q[28] = p; q[15] = sqrt(0.5 * (1 - min(max(p, -1), 1))); q[16] = sqrt(0.5 * (1 + min(max(p, -1), 1))); );
// pitch and filter of one voice (at the control tick)
function hm_vset(q) local(p, fc, g, kk) (
  p = q[1] + q[19] + q[18] + hm_pmod + hm_wow;
  q[23] = min(exp((p - 69) * L12) * hm_440s, 0.45);
  q[24] = min(exp((p + hm_o2 + hm_det / 100 - 69) * L12) * hm_440s, 0.45);
  fc = hm_cut * 2 ^ (hm_cmod + fl_ev * 4 * q[6] + (p - 60) / 24);   // (half key tracking)
  g = tan(min(max(fc, 25), hm_fmax) * hm_pis); kk = 2 - 2 * hm_res;
  q[20] = 1 / (1 + g * (g + kk)); q[21] = g * q[20]; q[22] = g * q[21];
);
// ---------- the synth voices: allocate (steal the quietest releasing, else the oldest; its last value fades out) ----------
function hm_alloc() local(v, q, best, bs, sc) (
  best = 0; bs = -1000000000; v = 0;
  loop(HVN,
    q = HV + v * HVS;
    sc = !q[0] ? 1000000000 : q[5] == 5 ? -1 : q[5] == 4 ? 1000000 - q[6] * 1000 + q[17] * 0.001 : q[17];
    sc > bs ? ( bs = sc; best = v; );
    v += 1;
  );
  HV + best * HVS;
);
// start a note on voice q
function hm_start(q, note, part, vel, gate) local(sp) (
  q[0] ? q[25] += q[26];                                   // (an almost silent voice: its last value fades away)
  q[34] = 0;
  q[0] = 1; q[1] = note; q[2] = part; q[3] = vel; q[4] = gate; q[5] = 1; q[6] = 0; q[17] = 0;
  hm_len(q, part ? hm_plen : hm_slen);
  q[11] = rand(1); q[12] = rand(1); q[13] = q[14] = 0;
  q[18] = (rand(2) - 1) * hm_fate * 0.12;                   // FATE: every note lands a little differently in tune
  q[19] = part ? 0 : hm_oct;
  sp = part ? (rand(2) - 1) * 0.7 : hm_spr * (rand(2) - 1);
  hm_vpan(q, sp);
  q[27] = hm_pw;
  hm_vset(q);
);
// a new note: on a free voice at once; stealing a voice that still sounds, it fades out over about 4 ms first
// (stage 5) and the new note starts from its silence, so a steal never clicks
function hm_non(note, part, vel, gate) local(q) (
  q = hm_alloc();
  q[0] && q[6] * q[3] > 0.001 ? (
    q[30] = note; q[31] = part; q[32] = vel; q[33] = gate; q[34] = 1; q[5] = 5;
  ) : hm_start(q, note, part, vel, gate);
);
function hm_release_part(part) local(v, q) (
  v = 0; loop(HVN, q = HV + v * HVS; q[0] && q[2] == part && q[5] < 4 ? q[5] = 4; q[0] && q[5] == 5 && q[31] == part ? q[34] = 0; v += 1; );
);
// one oscillator's wave at phase ph, increment inc: w 0 triangle > 1 saw > 2 square > 3 pulse (pw), morphing between
function hm_wave(ph, inc, w, pw) local(t, a, b, i, f, sw) (
  w = min(max(w, 0), 3); i = floor(w); f = w - i; i == 3 ? ( i = 2; f = 1; );
  // only the two waves being morphed between are made (one when it sits on a wave)
  i == 0 ? (
    a = 1 - 4 * abs(ph - 0.5);
    f > 0.002 ? ( b = 2 * ph - 1 - vo_blep(ph, inc); a += (b - a) * f; );
  ) : (
    sw = 2 * ph - 1 - vo_blep(ph, inc);
    i == 1 && f < 0.002 ? a = sw : (
      t = ph + 0.5; t -= floor(t); b = sw - (2 * t - 1 - vo_blep(t, inc));           // square
      i == 1 ? a = sw + (b - sw) * f : (
        f < 0.002 ? a = b : ( t = ph + 1 - pw; t -= floor(t); a = b + ((sw - (2 * t - 1 - vo_blep(t, inc))) - b) * f; );
      );
    );
  );
  a;
);

// ---------- the BASS (the Bass 1X engine): one mono voice ----------
function hm_bon(note, vel, gate, legato) (
  hb_tgt = note; hb_vel = vel; hb_gate = gate;
  !legato || hb_glc >= 1 ? hb_cur = note;
  hb_fe.vo_adsr_gate(1, !legato); hb_ae.vo_adsr_gate(1, !legato);
  !legato && hb_ae.lv < 0.001 ? ( hb_o1.vo_reset(0); hb_sb.vo_reset(0); );   // (a fresh start from silence only: no phase jump)
  hb_on = 1;
);
function hm_boff() ( hb_fe.vo_adsr_gate(0, 0); hb_ae.vo_adsr_gate(0, 0); hb_gate = 0; );
// ---------- the DRUMS (the Deep 16 engine) ----------
function hm_kick(v) ( hd_kph = 0; hd_kpe = 1; hd_kae = v; hd_kce = v; hd_kon = 1; );
function hm_snare(v) ( hd_sph = 0; hd_spe = 1; hd_ste = v; hd_sne = v; hd_son = 1; );
function hm_hat(v, open) ( open ? ( hd_hoe = v; hd_hodk = hd_hodk0; ) : ( hd_hce = v; hd_hodk = hd_hchoke; ); hd_hon = 1; );
function hm_perc(v) ( hd_pph = 0; hd_ppe = 1; hd_pae = v; hd_pce = v; hd_pon = 1; );

// ---------- the reverb (eight lines, a Hadamard loop, damped) ----------
function hm_rl(base, lt, g) instance(z, dc) local(d) (
  d = base[(hm_rw - lt) & (MRVN - 1)];
  z += (d - z) * hm_rdt; dc += (z - dc) * hm_rhp;
  (z - dc) * g;
);
function hm_ap(base, n, x, k) instance(w) local(d, v) (
  d = base[(w - n) & (MAPN - 1)]; v = x + k * d; base[w] = v; w = (w + 1) & (MAPN - 1);
  d - k * v;
);

// TPT state-variable filter for the drums: set, band-pass, band-pass + air
function svf_set(f, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(f, srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf_bp(x) instance(a1, a2, a3, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3; ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; v1;
);
function svf_bphp(x) instance(a1, a2, a3, ic1, ic2, k) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3; ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  v1 + 0.7 * (x - k * v1 - v2);
);
// ---------- parameters ----------
function update() local(i, sp, b, k) (
  hm_tmp = tempo > 0 ? tempo : 120;
  hm_bl = (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);   // beats a bar
  hm_frun = slider1 >= 0.5; hm_follow = slider2 >= 0.5; hm_sw = slider3 / 100; hm_trn = floor(slider4 + 0.5);
  hm_fate = slider5 / 100; hm_volt = 10 ^ (slider6 / 20);
  // the sequence: slots until the first with 0 bars
  hm_ns = 0; b = 0; k = 0; i = 0;
  loop(8,
    k == 0 && floor(slider(13 + i * 3) + 0.5) > 0 ? (
      HSB[hm_ns] = b; HSR[hm_ns] = floor(slider(11 + i * 3) + 0.5); HST[hm_ns] = floor(slider(12 + i * 3) + 0.5);
      HSN[hm_ns] = floor(slider(13 + i * 3) + 0.5); b += HSN[hm_ns] * hm_bl; hm_ns += 1;
    ) : k = 1;
    i += 1;
  );
  hm_lb = b;                                                // the loop's length in beats
  // the voice
  hm_w1 = slider35; hm_w2 = slider36; hm_det0 = slider37; hm_o2 = (floor(slider38 + 0.5) - 1) * 12;
  hm_mix = slider39 / 100; hm_pw0 = slider40 / 100; hm_cut0 = slider41; hm_res0 = slider42 / 100 * 0.94;
  hm_fenv = slider43 / 100; hm_slen0 = slider44 / 100; hm_slev = sqr(slider45 / 100) * 0.42; hm_spr = slider46 / 100;
  hm_acc = slider47 / 100;
  hm_smode = floor(slider51 + 0.5); hm_apat = floor(slider52 + 0.5); hm_rd = hm_rate_beats(floor(slider53 + 0.5));
  hm_trip = floor(slider53 + 0.5) == 2 || floor(slider53 + 0.5) == 4;
  hm_aoct = floor(slider54 + 0.5); hm_gate0 = slider55 / 100; hm_reg = floor(slider56 + 0.5); hm_slen_n = floor(slider57 + 0.5);
  hm_plev0 = sqr(slider75 / 100) * 0.3; hm_preg = floor(slider76 + 0.5); hm_plen = slider77 / 100; hm_popen = slider78 >= 0.5;
  // the bass
  hb_fig = floor(slider81 + 0.5); hb_wave = slider82 >= 0.5; hb_ftype = slider83 >= 0.5 ? 1 : 0;
  hb_cut0 = slider84; hb_res = slider85 / 100; hb_env = slider86 / 100; hb_sub = slider87 / 100;
  hb_glc = slider88 > 0 ? vo_coef(slider88) : 1; hb_oct = (floor(slider89 + 0.5) - 1) * 12;
  hb_lev = sqr(slider90 / 100) * 0.9; hb_on_ = slider173 >= 0.5;
  hb_fe.vo_adsr_set(1, hb_fig == 0 ? 900 : 260, hb_fig == 0 ? 0.35 : 0, 120);
  hb_ae.vo_adsr_set(2, hb_fig == 0 ? 2000 : 500, hb_fig == 0 ? 0.85 : 0.6, hb_fig == 0 ? 300 : 70);
  // the drums
  hd_on_ = slider162 >= 0.5; hd_sty = floor(slider163 + 0.5); hm_perc_style(hd_sty);
  hd_lev = sqr(slider169 / 100) * 1.1; hd_dsd = slider170 / 100; hd_drs = slider171 / 100; hd_dec = 0.4 + 1.2 * slider172 / 100;
  hd_kadk = exp(-4.6 / (520 * hd_dec * 0.001 * srate)); hd_kpdk = exp(-1 / (0.045 * srate));
  hd_stdk = exp(-4.6 / (110 * hd_dec * 0.001 * srate)); hd_sndk = exp(-4.6 / (260 * hd_dec * 0.001 * srate)); hd_spdk = exp(-1 / (0.007 * srate));
  hd_hcdk = exp(-4.6 / (60 * hd_dec * 0.001 * srate)); hd_hodk0 = exp(-4.6 / (520 * hd_dec * 0.001 * srate)); hd_hchoke = exp(-1 / (0.001 * srate));
  hd_padk = exp(-4.6 / (hd_pd * hd_dec * 0.001 * srate)); hd_pcdk = exp(-1 / (0.0004 * srate));
  hd_kcdk = exp(-1 / (0.0025 * srate));
  hd_snF.svf_set(1600, 0.9); hd_hF.svf_set(7000, 1.1);
  hd_hi1 = 205.3 / srate; hd_hi2 = 304.4 / srate; hd_hi3 = 369.6 / srate; hd_hi4 = 522.7 / srate; hd_hi5 = 540 / srate; hd_hi6 = 800 / srate;
  // LFOs
  i = 0;
  loop(8,
    k = HL + i * 16; b = 91 + i * 6;
    k[5] = floor(slider(b) + 0.5); k[7] = slider(b + 2) >= 0.5; k[8] = hm_lfo_beats(floor(slider(b + 3) + 0.5));
    k[6] = k[7] ? hm_tmp / 60 / k[8] : slider(b + 1); k[9] = slider(b + 4) / 100; k[10] = floor(slider(b + 5) + 0.5);
    i += 1;
  );
  // FX
  hm_phr = slider139; hm_phd = slider140 / 100; hm_phm = slider141 / 100; hm_phf = slider155 / 100 * 0.9;
  hm_dlb = hm_dly_beats(floor(slider142 + 0.5)); hm_dfb = slider143 / 100 * 0.95; hm_dlv = slider145 / 100;
  hm_dtc = 1 - exp(-2 * $pi * min(900 * 2 ^ (slider144 / 100 * 4), srate * 0.45) / srate);
  hm_dlt = min(hm_dlb * 60 / hm_tmp * srate, MDM - 4);
  hm_rdec = slider146 / 100; hm_rlev = slider148 / 100;
  hm_rdt = 1 - exp(-2 * $pi * min(1200 * 2 ^ (slider147 / 100 * 3.6), srate * 0.45) / srate);
  hm_ssd0 = slider149 / 100; hm_ssr0 = slider150 / 100; hm_psd = slider151 / 100; hm_psr = slider152 / 100;
  hb_dsd = slider153 / 100; hb_drs = slider154 / 100;
  sp = srate / 1000 * (0.8 + 0.9 * hm_rdec);
  MRLT[0] = floor(37.1 * sp); MRLT[1] = floor(41.3 * sp); MRLT[2] = floor(47.9 * sp); MRLT[3] = floor(53.3 * sp);
  MRLT[4] = floor(59.7 * sp); MRLT[5] = floor(67.1 * sp); MRLT[6] = floor(73.9 * sp); MRLT[7] = floor(81.7 * sp);
  hm_rt60 = 0.7 + 9 * hm_rdec ^ 2;
  i = 0; loop(8, MRLT[i] = min(MRLT[i], MRVN - 4); MRG[i] = 10 ^ (-3 * MRLT[i] / (hm_rt60 * srate)); i += 1; );
  hm_rwg = 0.55 * (2 / hm_rt60) ^ 0.15;
  hm_pis = $pi / srate; hm_440s = 440 / srate; hm_fmax = srate * 0.45;
  ins_output_setup(156);   // output stage: CLIP, always on
);
MRLT = 33300; MRG = 33320; MAPL = 33340;

ins_drift_init();
hm_dw.drift_init(0.8 + rand(0.4));
fl_ok = 0; fl_k = 1 - exp(-1 / (0.015 * srate));
function hm_srinit() local(i) (
  hm_srt = srate; hm_sm = 1 - exp(-1 / (0.03 * srate)); ost_init(20000);
  MAPL[0] = min(floor(4.77 * srate / 1000), MAPN - 2); MAPL[1] = min(floor(3.59 * srate / 1000), MAPN - 2);
  MAPL[2] = min(floor(12.73 * srate / 1000), MAPN - 2); MAPL[3] = min(floor(9.31 * srate / 1000), MAPN - 2);
  hm_rhp = 1 - exp(-2 * $pi * 3 / srate);
  hm_res_c = exp(-1 / (0.003 * srate));                    // a finished voice's last value fades in 3 ms
  hm_stc = vo_coef(4);                                     // a stolen voice fades out in about 4 ms
  hm_lsk = 1 - exp(-8 / (0.003 * srate));                  // the LFOs' step glide (at the 8-sample tick)
  hm_pcdn = 1 / (0.012 * srate); hm_pcup = 1 / (0.02 * srate);
  hm_gsm = 1 - exp(-8 / (0.01 * srate));                   // part levels glide at the tick (10 ms)
  update();
);
hm_srinit();
hm_pcf = 0; hm_pcg = 1; hm_ct = 7; hm_run = 0; hm_fpos = 0; hm_ci = -1; hm_croot = -1; hm_ctype = -1;
hm_ga = hm_gs = hm_gb = -1000000000; hm_ac = 0; hm_wph = 0; hm_fph = 0; hm_wow = 0; hm_pmod = 0;
hm_spos = 0; hm_vol = hm_volt; hm_dts = -1; hm_wp = 0; hm_rw = 0; hm_cw = 0;
hm_cut = hm_cut0; hm_res = hm_res0; hm_pw = hm_pw0; hm_slen = hm_slen0; hm_cmod = 0; hm_det = hm_det0; hm_oct = 0;
hm_plev = hm_plev0; hm_ssd = hm_ssd0; hm_ssr = hm_ssr0; hm_gate = hm_gate0;
i_ = 0; loop(8, HL[i_ * 16] = rand(1); HL[i_ * 16 + 2] = rand(2) - 1; HL[i_ * 16 + 3] = rand(2) - 1; i_ += 1; );
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// ---------- the chord now: tones (sorted), root ----------
function hm_chord(slot) local(r, t, n, i) (
  r = HSR[slot] + hm_trn; t = HST[slot];
  hm_croot = HSR[slot]; hm_ctype = t; hm_cr_ = hm_mod(r, 12); hm_cn = HCN[t];
  hm_c0 = HCT[t * 4]; hm_c1 = HCT[t * 4 + 1]; hm_c2 = HCT[t * 4 + 2]; hm_c3 = HCT[t * 4 + 3];
  hm_nroot = hm_mod(HSR[(slot + 1) % max(hm_ns, 1)] + hm_trn, 12);   // the next chord's root (for approach notes)
);
function hm_tone(i) ( i == 0 ? hm_c0 : i == 1 ? hm_c1 : i == 2 ? hm_c2 : hm_c3; );
// the arp's note list: the chord over OCTAVES from REGISTER, sorted
function hm_arplist() local(n, o, j, k, t, base) (
  base = 12 * (hm_reg + 1) + hm_cr_; n = 0; o = 0;
  loop(hm_aoct, j = 0; loop(hm_cn, HAN[n] = base + hm_tone(j) + 12 * o; n += 1; j += 1; ); o += 1; );
  j = 1; loop(n - 1, k = j; while (k > 0 && HAN[k - 1] > HAN[k]) ( t = HAN[k]; HAN[k] = HAN[k - 1]; HAN[k - 1] = t; k -= 1; ); j += 1; );
  hm_an = n;
);
// a new chord: the pad changes, the arp starts again from the top
function hm_newchord(slot) local(i, base, nt) (
  hm_chord(slot); hm_arplist(); hm_ac = 0; hm_ci = slot;
  hb_on_ && hb_fig == 0 ? hm_bon(36 + hm_cr_ + hb_oct, 1, -1, hb_on);   // DRONE: the root, gliding to the next
  hm_release_part(1);
  hm_plev0 > 0.0001 ? (
    base = 12 * (hm_preg + 1) + hm_cr_;
    i = 0;
    loop(hm_cn,
      nt = base + hm_tone(i) + (hm_popen && (i & 1) ? 12 : 0);
      hm_non(nt, 1, 1, -1);
      i += 1;
    );
  );
);
// the synth's step: ARP or SEQ
function hm_synth_step(k) local(i, n, st, gate, vel, nt) (
  gate = floor(hm_rd * 60 / hm_tmp * srate * min(max(hm_gate, 0.05), 1));
  vel = 1 - hm_acc * 0.45 + hm_acc * 0.45 * ((k & 3) == 0);
  hm_smode == 1 && hm_an > 0 ? (
    hm_apat == 4 ? (
      i = 0; loop(hm_cn, hm_non(12 * (hm_reg + 1) + hm_cr_ + hm_tone(i), 0, vel * 0.7, gate); i += 1; );
    ) : (
      n = hm_an;
      hm_apat == 0 ? i = hm_mod(hm_ac, n) :
      hm_apat == 1 ? i = n - 1 - hm_mod(hm_ac, n) :
      hm_apat == 2 ? ( st = max(2 * n - 2, 1); i = hm_mod(hm_ac, st); i >= n ? i = st - i; ) :
      hm_apat == 3 ? i = floor(rand(n)) :
      ( i = (hm_ac & 1) ? 1 + hm_mod(floor(hm_ac / 2), max(n - 1, 1)) : 0; i = min(i, n - 1); );
      hm_non(HAN[i], 0, vel, gate);
      hm_ac += 1;
    );
  ) :
  hm_smode == 2 ? (
    st = floor(slider(58 + hm_mod(k, hm_slen_n)) + 0.5);
    hm_sstep = hm_mod(k, hm_slen_n);
    st > 0 ? (
      i = hm_mod(st - 1, 4); nt = 12 * (hm_reg + 1) + hm_cr_ + (st > 4 ? 12 : 0);
      nt += i < hm_cn ? hm_tone(i) : hm_tone(i - hm_cn) + 12;
      hm_non(nt, 0, vel, gate);
    );
  );
);
// the bass's step (eighths): PULSE, OSTINATO or STEPS; DRONE plays at each chord change
function hm_bass_step(k) local(base, nt, st, i, g) (
  base = 36 + hm_cr_ + hb_oct; hm_bstep = k;
  g = floor(0.5 * 60 / hm_tmp * srate * 0.62);
  hb_fig == 1 ? hm_bon(base, (k & 1) ? 0.7 : 1, g, 0) :
  hb_fig == 2 ? (
    // root, root, octave, root, fifth (or the chord's third / fifth), root, seventh (or octave), octave
    i = k & 7;
    nt = i == 2 || i == 7 ? base + 12 : i == 4 ? base + (hm_cn > 2 ? hm_tone(2) : 7) - (hm_tone(2) > 12 ? 12 : 0) :
         i == 6 ? base + (hm_cn > 3 && hm_c3 < 12 ? hm_c3 : 12) : base;
    hm_bon(nt, i == 0 ? 1 : 0.72, g, 0);
  ) :
  hb_fig == 3 ? (
    st = floor(slider(58 + hm_mod(k, hm_slen_n)) + 0.5);
    st > 0 ? (
      i = hm_mod(st - 1, 4); nt = base + (st > 4 ? 12 : 0);
      nt += i < hm_cn ? hm_tone(i) : hm_tone(i - hm_cn) + 12;
      hm_bon(nt, 0.85, g, 0);
    );
  );
);
// the drums' step (sixteenths): every lane whose bit is set
function hm_drum_step(k) local(v) (
  hm_dstep = k; v = (k & 3) == 0 ? 1 : (k & 1) ? 0.62 : 0.8;
  (slider164 | 0) & (1 << k) ? hm_kick(v);
  (slider165 | 0) & (1 << k) ? hm_snare(v);
  (slider166 | 0) & (1 << k) ? hm_hat(v * 0.75, 0);
  (slider167 | 0) & (1 << k) ? hm_hat(v * 0.85, 1);
  (slider168 | 0) & (1 << k) ? hm_perc(v);
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
!hm_pcf && !hm_panic ? update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset_au(k); prs_sl();
      prs_q ? ( k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
srate != hm_srt ? hm_srinit();
hm_panic && !hm_pcf ? ( hm_pcf = 1; hm_panic = 0; );
hm_pcf == 2 ? (
  memset(MRV, 0, 8 * MRVN); memset(MAP, 0, 4 * MAPN); memset(MDL, 0, 524288 * 2);
  memset(HV, 0, HVN * HVS); hb_on = 0; hd_kon = hd_son = hd_hon = hd_pon = 0;
  hm_r0.z = hm_r1.z = hm_r2.z = hm_r3.z = hm_r4.z = hm_r5.z = hm_r6.z = hm_r7.z = 0;
  hm_dfl = hm_dfr = 0; hm_ci = -1; hm_ga = hm_gs = hm_gb = hm_gd = -1000000000;
  hm_pcf = 3;
);
// TRANSPORT: while lit, REAPER's play (or record) presses START and its stop presses STOP; the keys still work by hand
hm_xp = play_state & 1;
slider174 >= 0.5 && hm_xp != hm_xpw ? ( slider1 = hm_xp; hm_frun = hm_xp; ui_auto(1); );
hm_xpw = hm_xp;
hm_pcf != 1 ? update();
// the clock: while START is lit - with FOLLOW, REAPER's position while it plays; without, our own from bar 1
hm_inc = hm_tmp / 60 / srate;
hm_tp = hm_follow && (play_state & 1);
hm_runt = hm_frun && (hm_follow ? (play_state & 1) : 1);   // START / STOP is the master switch; FOLLOW: only while REAPER plays
hm_runt && !hm_run ? ( hm_fpos = 0; hm_ga = hm_gs = hm_gb = hm_gd = -1000000000; hm_ci = -1; );
!hm_runt && hm_run ? ( hm_release_part(0); hm_release_part(1); hm_boff(); hm_ci = -1; );
!hb_on_ && hb_gate ? hm_boff();
hm_run = hm_runt;
hm_pos = hm_tp ? beat_position : hm_fpos;
// FATE: tape wow and tuning wander
ins_drift_block(hm_fate * 0.6, samplesblock);
hm_det = hm_det0 + ins_aux * 40;
hm_dts < 0 ? hm_dts = hm_dlt;
abs(hm_dfl) + abs(hm_dfr) < 0.0000000001 ? hm_dfl = hm_dfr = 0;
// synced LFOs follow the beat
hm_run ? ( i_ = 0; loop(8, q_ = HL + i_ * 16; q_[7] ? ( t_ = hm_pos / q_[8]; q_[0] = t_ - floor(t_); ); i_ += 1; ); );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the sequencer (every sample: chord changes, the synth's, the bass's and the drums' steps) ----------
hm_run && hm_lb > 0 ? (
  hm_pm = hm_mod(hm_pos, hm_lb);
  hm_k = 0; loop(hm_ns - 1, hm_pm >= HSB[hm_k + 1] ? hm_k += 1; );
  (hm_k != hm_ci || HSR[hm_k] != hm_croot || HST[hm_k] != hm_ctype) ? hm_newchord(hm_k);
  hm_bar = floor(hm_pm / hm_bl); hm_beat = floor(hm_mod(hm_pm, hm_bl));
  // the synth's grid (SWING delays the off-beat steps, straight rates only)
  hm_smode > 0 ? (
    hm_t = hm_pos / hm_rd; hm_kk = floor(hm_t); hm_f = hm_t - hm_kk;
    !hm_trip && (hm_kk & 1) && hm_f < hm_sw ? hm_kk -= 1;
    hm_kk != hm_gs ? ( hm_gs = hm_kk; hm_synth_step(hm_kk); );
  );
  // the bass's grid: eighths (SWING delays the off-beats)
  hb_on_ && hb_fig > 0 ? (
    hm_t = hm_pos / 0.5; hm_kk = floor(hm_t); hm_f = hm_t - hm_kk;
    (hm_kk & 1) && hm_f < hm_sw * 0.5 ? hm_kk -= 1;
    hm_kk != hm_gb ? ( hm_gb = hm_kk; hm_bass_step(hm_kk); );
  );
  // the drums' grid: sixteenths, a one-bar loop
  hd_on_ ? (
    hm_t = hm_pos / 0.25; hm_kk = floor(hm_t); hm_f = hm_t - hm_kk;
    (hm_kk & 1) && hm_f < hm_sw ? hm_kk -= 1;
    hm_kk != hm_gd ? ( hm_gd = hm_kk; hm_drum_step(hm_mod(hm_kk, 16)); );
  );
);
hm_pos += hm_inc; hm_fpos += hm_inc;

// the filters' CUTOFF, RESO and ENV glide per sample (two 15 ms stages on each cutoff, 15 ms on the rest), so a
// turned knob or automation sweeps smoothly, never in steps (starts on its targets)
!fl_ok ? ( fl_c1 = fl_c2 = log(hm_cut0); fl_rs = hm_res0; fl_ev = hm_fenv; fb_c1 = fb_c2 = log(hb_cut0); fb_rs = hb_res; fb_ev = hb_env; fl_ok = 1; );
fl_c1 += (log(hm_cut0) - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (hm_res0 - fl_rs) * fl_k; fl_ev += (hm_fenv - fl_ev) * fl_k;
fb_c1 += (log(hb_cut0) - fb_c1) * fl_k; fb_c2 += (fb_c1 - fb_c2) * fl_k; fb_rs += (hb_res - fb_rs) * fl_k; fb_ev += (hb_env - fb_ev) * fl_k;
// ---------- control tick (every 8 samples): LFOs, wow, the voices' pitch and filters ----------
hm_ct += 1;
hm_ct >= 8 ? (
  hm_ct = 0;
  memset(HM, 0, 16);
  hm_rm = 1; hm_k = 0;
  loop(8,
    q_ = HL + hm_k * 16;
    q_[0] += q_[6] * (q_[7] ? 1 : hm_rm) * 8 / srate;
    q_[0] >= 1 ? ( q_[0] -= floor(q_[0]); q_[1] = rand(2) - 1; q_[2] = q_[3]; q_[3] = rand(2) - 1; );
    hm_v = hm_lfov(q_[5], q_[0], q_[1], q_[2], q_[3]);
    q_[5] == 3 || q_[5] == 4 ? hm_v = q_[4] + (hm_v - q_[4]) * hm_lsk;   // SQUARE and S&H steps glide over about 3 ms
    q_[4] = hm_v;
    HM[q_[10]] += hm_v * q_[9];
    hm_rm = 2 ^ (2 * (q_[10] == 14 ? hm_v * q_[9] : 0));     // NEXT LFO RATE reaches only the next one
    hm_k += 1;
  );
  // tape wow (FATE): a slow wow and a faint flutter, plus the drift's wander
  hm_wph += 0.55 * 8 / srate; hm_wph -= floor(hm_wph); hm_fph += 6.3 * 8 / srate; hm_fph -= floor(hm_fph);
  hm_wow = hm_fate * (0.14 * sin(2 * $pi * hm_wph) + 0.025 * sin(2 * $pi * hm_fph)) + 12 * log(ins_pitch) / log(2);
  hm_pmod = HM[0] * 2;
  hm_det = hm_det0 + ins_aux * 40 + HM[1] * 50;
  hm_wm = HM[2] * 1.5;
  hm_pw = min(max(hm_pw0 + HM[3] * 0.2, 0.05), 0.5);
  hm_cmod = HM[4] * 4 + ins_cut;
  hm_cut = exp(fl_c2); hm_res = min(max(fl_rs + HM[5] * 0.5, 0), 0.95);
  hm_slen = hm_slen0 + HM[6] * 0.5;
  hm_amp = 1 - min(abs(HM[7]), 1) * (0.5 - 0.5 * sign(HM[7]) * 1);   // (an LFO on AMP: tremolo)
  hm_amp = HM[7] == 0 ? 1 : min(max(1 + HM[7], 0), 1);
  hm_panm = HM[8];
  hm_ssd = hm_ssd0 * min(max(1 + HM[9], 0), 2); hm_ssr = hm_ssr0 * min(max(1 + HM[10], 0), 2);
  hm_gate = hm_gate0 + HM[11] * 0.5;
  hm_plev += (hm_plev0 * min(max(1 + HM[12], 0), 2) - hm_plev) * hm_gsm;
  hb_cmod = HM[13] * 2;                                     // BASS CUTOFF: +/-2 octaves
  hm_oct = 12 * min(max(floor(HM[15] * 1.5 + 0.5), -1), 1);
  hm_w1n = hm_w1 + hm_wm; hm_w2n = hm_w2 + hm_wm;
  hm_v = 0; loop(HVN, q_ = HV + hm_v * HVS; q_[0] ? ( hm_vset(q_); hm_pp = min(max(q_[28] + hm_panm, -1), 1); q_[15] = sqrt(0.5 * (1 - hm_pp)); q_[16] = sqrt(0.5 * (1 + hm_pp)); ); hm_v += 1; );
  // the phaser's sweep (both sides a quarter-cycle apart): six first-order allpasses between 120 Hz and 4 kHz
  hm_phph += hm_phr * (1 + 0.1 * ins_fx) * 8 / srate; hm_phph -= floor(hm_phph);
  hm_phx = 0.5 - 0.5 * cos(2 * $pi * hm_phph); hm_phy = 0.5 - 0.5 * sin(2 * $pi * hm_phph);
  hm_t = tan($pi * min(180 * 2 ^ (hm_phx * hm_phd * 4.5), srate * 0.45) / srate); hm_pal = (hm_t - 1) / (hm_t + 1);
  hm_t = tan($pi * min(180 * 2 ^ (hm_phy * hm_phd * 4.5), srate * 0.45) / srate); hm_par = (hm_t - 1) / (hm_t + 1);
);

// ---------- the synth voices ----------
hm_sL = hm_sR = 0; hm_pL = hm_pR = 0;
hm_v = 0;
loop(HVN,
  q_ = HV + hm_v * HVS;
  q_[0] ? (
    // envelope
    q_[4] > 0 ? ( q_[4] -= 1; q_[4] <= 0 && q_[5] < 4 ? q_[5] = 4; );
    q_[5] == 1 ? ( q_[6] += (1.3 - q_[6]) * q_[7]; q_[6] >= 1 ? ( q_[6] = 1; q_[5] = 2; ); ) :
    q_[5] == 2 ? ( q_[6] += (q_[9] - q_[6]) * q_[8]; abs(q_[6] - q_[9]) < 0.001 ? q_[5] = 3; ) :
    q_[5] == 4 ? ( q_[6] -= q_[6] * q_[10]; q_[6] < 0.001 ? ( q_[0] = 0; q_[25] += q_[26]; q_[6] = 0; ); ) :
    q_[5] == 5 ? ( q_[6] -= q_[6] * hm_stc; q_[6] < 0.0005 ? ( q_[34] ? hm_start(q_, q_[30], q_[31], q_[32], q_[33]) : ( q_[0] = 0; q_[25] += q_[26]; q_[6] = 0; ); ); );
    // two oscillators, morphing waves
    q_[11] += q_[23]; q_[11] -= floor(q_[11]); q_[12] += q_[24]; q_[12] -= floor(q_[12]);
    hm_x = hm_mix < 0.001 ? hm_wave(q_[11], q_[23], hm_w1n, hm_pw) : hm_mix > 0.999 ? hm_wave(q_[12], q_[24], hm_w2n, hm_pw) :
           hm_wave(q_[11], q_[23], hm_w1n, hm_pw) * (1 - hm_mix) + hm_wave(q_[12], q_[24], hm_w2n, hm_pw) * hm_mix;
    // 12 dB low-pass (zero-delay SVF)
    hm_v3 = hm_x - q_[14]; hm_v1 = q_[20] * q_[13] + q_[21] * hm_v3; hm_v2 = q_[14] + q_[21] * q_[13] + q_[22] * hm_v3;
    q_[13] = 2 * hm_v1 - q_[13]; q_[14] = 2 * hm_v2 - q_[14];
    abs(q_[13]) + abs(q_[14]) > 40 ? q_[13] = q_[14] = 0;
    hm_y = hm_v2 * q_[6] * q_[3];
    q_[26] = hm_y;
    hm_y += q_[25]; q_[25] *= hm_res_c;
    q_[17] += 1;
    q_[2] ? ( hm_pL += hm_y * q_[15]; hm_pR += hm_y * q_[16]; ) : ( hm_sL += hm_y * q_[15]; hm_sR += hm_y * q_[16]; );
  ) : (
    q_[25] != 0 ? ( hm_y = q_[25]; q_[25] *= hm_res_c; abs(q_[25]) < 0.000001 ? q_[25] = 0; hm_sL += hm_y * 0.7; hm_sR += hm_y * 0.7; );
  );
  hm_v += 1;
);
hm_sL *= hm_slev * hm_amp; hm_sR *= hm_slev * hm_amp; hm_pL *= hm_plev; hm_pR *= hm_plev;

// ---------- the BASS: saw or pulse, sub an octave down, LADDER or ACID filter (the Bass 1X voice) ----------
hm_bx = 0;
hb_on ? (
  hb_cur += (hb_tgt - hb_cur) * hb_glc;
  hb_gate > 0 ? ( hb_gate -= 1; hb_gate <= 0 ? hm_boff(); );
  hb_inc = min(440 * exp((hb_cur + hm_wow - 69) * L12) / srate, 0.45);
  hm_y = hb_wave ? hb_o1.vo_pulse(hb_inc, 0.4) : hb_o1.vo_saw(hb_inc);
  hm_y += hb_sub * hb_sb.vo_sub(hb_inc, 2);
  hm_y *= 0.4;
  hb_fev = hb_fe.vo_adsr();
  hb_fc = min(max(exp(fb_c2 + ((fb_ev + (hb_vel - 0.7) * 0.6) * hb_fev * 6 + (hb_cur - 36) / 24 + hb_cmod + ins_cut) * 0.693147), 20), srate * 0.45);
  hm_y = hb_flt.vo_ladder(hm_y, hb_fc, fb_rs, hb_ftype);
  hm_y = vo_tanh(hm_y * 0.9) / 0.9;
  hb_aev = hb_ae.vo_adsr();
  hm_bx = hm_y * hb_aev * (0.7 + 0.3 * hb_vel) * hb_lev;
  hb_aev < 0.00002 && !hb_gate ? hb_on = 0;
);
// ---------- the DRUMS (the Deep 16 voices): kick, snare, hats, perc ----------
hm_dL = hm_dR = 0;
hd_kon ? (
  hd_kph += (45 + 140 * hd_kpe) / srate; hd_kph -= floor(hd_kph); hd_kpe *= hd_kpdk;
  hm_t = 1 + 2.4 * (0.35 + 0.65 * hd_kpe); hm_y = vo_tanh(sin(2 * $pi * hd_kph) * hm_t) / vo_tanh(hm_t);
  hd_knz = rand(2) - 1; hm_t = hd_knz - hd_kz1; hd_kz1 = hd_knz; hd_kce *= hd_kcdk;
  hm_y = hm_y * hd_kae + hm_t * hd_kce * 0.16;
  hm_dL += hm_y; hm_dR += hm_y;
  hd_kae *= hd_kadk; hd_kae < 0.00003 && hd_kce < 0.0001 ? hd_kon = 0;
);
hd_son ? (
  hd_sph += 170 * (1 + 1.4 * hd_spe) / srate; hd_sph -= floor(hd_sph); hd_spe *= hd_spdk;
  hm_y = sin(2 * $pi * hd_sph) * hd_ste * 0.42 + hd_snF.svf_bp(rand(2) - 1) * hd_sne * 1.8;
  hd_ste *= hd_stdk; hd_sne *= hd_sndk;
  hm_dL += hm_y * 0.55; hm_dR += hm_y * 0.55;
  hd_ste < 0.00003 && hd_sne < 0.00003 ? hd_son = 0;
);
hd_hon ? (
  hd_h1 += hd_hi1; hd_h1 -= floor(hd_h1); hd_h2 += hd_hi2; hd_h2 -= floor(hd_h2); hd_h3 += hd_hi3; hd_h3 -= floor(hd_h3);
  hd_h4 += hd_hi4; hd_h4 -= floor(hd_h4); hd_h5 += hd_hi5; hd_h5 -= floor(hd_h5); hd_h6 += hd_hi6; hd_h6 -= floor(hd_h6);
  hm_t = ((hd_h1 < 0.5) + (hd_h2 < 0.5) + (hd_h3 < 0.5) + (hd_h4 < 0.5) + (hd_h5 < 0.5) + (hd_h6 < 0.5)) * 0.333333 - 1;
  hm_y = hd_hF.svf_bphp(hm_t * 0.45 + (rand(2) - 1) * 0.55) * (hd_hce + hd_hoe) * 0.45;
  hd_hce *= hd_hcdk; hd_hoe *= hd_hodk;
  hm_dL += hm_y * 0.8; hm_dR += hm_y * 1.1;
  hd_hce < 0.00003 && hd_hoe < 0.00003 ? hd_hon = 0;
);
hd_pon ? (
  hd_pph += hd_pf * (1 + 0.6 * hd_ppe) / srate; hd_pph -= floor(hd_pph); hd_ppe *= hd_kpdk;
  hd_pnz = rand(2) - 1; hm_t = hd_pnz - hd_pz1; hd_pz1 = hd_pnz; hd_pce *= hd_pcdk;
  hm_y = (sin(2 * $pi * hd_pph) * hd_pae + hm_t * hd_pce * 0.3) * 0.5;
  hd_pae *= hd_padk;
  hm_dL += hm_y * 1.1; hm_dR += hm_y * 0.8;
  hd_pae < 0.00003 && hd_pce < 0.0001 ? hd_pon = 0;
);
// the drum bus: a touch of tape
hm_dL = vo_tanh(hm_dL * 1.3) / 1.3 * hd_lev; hm_dR = vo_tanh(hm_dR * 1.3) / 1.3 * hd_lev;

// ---------- PHASER on the synth and pad: six allpasses, swept slowly, with feedback ----------
hm_iL = hm_sL + hm_pL; hm_iR = hm_sR + hm_pR;
hm_phm > 0.001 ? (
  hm_x = hm_iL + hm_pfl * hm_phf;
  hm_y = hm_pal * hm_x + hm_a0; hm_a0 = hm_x - hm_pal * hm_y; hm_x = hm_y;
  hm_y = hm_pal * hm_x + hm_a1; hm_a1 = hm_x - hm_pal * hm_y; hm_x = hm_y;
  hm_y = hm_pal * hm_x + hm_a2; hm_a2 = hm_x - hm_pal * hm_y; hm_x = hm_y;
  hm_y = hm_pal * hm_x + hm_a3; hm_a3 = hm_x - hm_pal * hm_y; hm_x = hm_y;
  hm_y = hm_pal * hm_x + hm_a4; hm_a4 = hm_x - hm_pal * hm_y; hm_x = hm_y;
  hm_y = hm_pal * hm_x + hm_a5; hm_a5 = hm_x - hm_pal * hm_y; hm_pfl = vo_tanh(hm_y);
  hm_x = hm_iR + hm_pfr * hm_phf;
  hm_y = hm_par * hm_x + hm_b0; hm_b0 = hm_x - hm_par * hm_y; hm_x = hm_y;
  hm_y = hm_par * hm_x + hm_b1; hm_b1 = hm_x - hm_par * hm_y; hm_x = hm_y;
  hm_y = hm_par * hm_x + hm_b2; hm_b2 = hm_x - hm_par * hm_y; hm_x = hm_y;
  hm_y = hm_par * hm_x + hm_b3; hm_b3 = hm_x - hm_par * hm_y; hm_x = hm_y;
  hm_y = hm_par * hm_x + hm_b4; hm_b4 = hm_x - hm_par * hm_y; hm_x = hm_y;
  hm_y = hm_par * hm_x + hm_b5; hm_b5 = hm_x - hm_par * hm_y; hm_pfr = vo_tanh(hm_y);
  hm_iL += (hm_pfl - hm_iL) * hm_phm * 0.5; hm_iR += (hm_pfr - hm_iR) * hm_phm * 0.5;
);
hm_oL = hm_iL + hm_bx + hm_dL; hm_oR = hm_iR + hm_bx + hm_dR;

// ---------- sends ----------
hm_dx = (hm_sL + hm_sR) * 0.5 * hm_ssd + (hm_pL + hm_pR) * 0.5 * hm_psd + hm_bx * hb_dsd + (hm_dL + hm_dR) * 0.5 * hd_dsd;
hm_rx = (hm_sL + hm_sR) * 0.5 * hm_ssr + (hm_pL + hm_pR) * 0.5 * hm_psr + hm_bx * hb_drs + (hm_dL + hm_dR) * 0.5 * hd_drs;

// ---------- DELAY: a tape-style ping-pong - darker every pass, a little wow and flutter ----------
hm_dl1 = hm_dr1 = 0;
hm_dlv > 0.001 ? (
  hm_tw += 0.55 / srate; hm_tw -= floor(hm_tw); hm_tf2 += 4.3 / srate; hm_tf2 -= floor(hm_tf2);
  hm_dts += (hm_dlt * (1 + 0.004 * ins_fx + 0.0022 * sin(2 * $pi * hm_tw) + 0.0006 * sin(2 * $pi * hm_tf2)) - hm_dts) * 0.0002;
  hm_rp = hm_wp - hm_dts; hm_ri = floor(hm_rp); hm_rf = hm_rp - hm_ri;
  hm_dl1 = MDL[hm_ri & MDM] * (1 - hm_rf) + MDL[(hm_ri + 1) & MDM] * hm_rf;
  hm_dr1 = MDR[hm_ri & MDM] * (1 - hm_rf) + MDR[(hm_ri + 1) & MDM] * hm_rf;
  hm_dfl += (hm_dl1 - hm_dfl) * hm_dtc; hm_dfr += (hm_dr1 - hm_dfr) * hm_dtc;
  MDL[hm_wp] = hm_dx + vo_tanh(hm_dfr * hm_dfb);
  MDR[hm_wp] = vo_tanh(hm_dfl * hm_dfb);
  hm_oL += hm_dfl * hm_dlv; hm_oR += hm_dfr * hm_dlv;
) : ( MDL[hm_wp] = 0; MDR[hm_wp] = 0; );
hm_wp = (hm_wp + 1) & MDM;

// ---------- REVERB ----------
hm_x = hm_rx + (hm_dl1 + hm_dr1) * hm_dlv * 0.2;
hm_rlev > 0.001 ? (
  hm_x = hm_ap0.hm_ap(MAP, MAPL[0], hm_x, 0.6); hm_x = hm_ap1.hm_ap(MAP + MAPN, MAPL[1], hm_x, 0.6);
  hm_x = hm_ap2.hm_ap(MAP + 2 * MAPN, MAPL[2], hm_x, 0.6); hm_x = hm_ap3.hm_ap(MAP + 3 * MAPN, MAPL[3], hm_x, 0.6);
  hm_y0 = hm_r0.hm_rl(MRV,            MRLT[0], MRG[0]); hm_y1 = hm_r1.hm_rl(MRV + MRVN,     MRLT[1], MRG[1]);
  hm_y2 = hm_r2.hm_rl(MRV + 2 * MRVN, MRLT[2], MRG[2]); hm_y3 = hm_r3.hm_rl(MRV + 3 * MRVN, MRLT[3], MRG[3]);
  hm_y4 = hm_r4.hm_rl(MRV + 4 * MRVN, MRLT[4], MRG[4]); hm_y5 = hm_r5.hm_rl(MRV + 5 * MRVN, MRLT[5], MRG[5]);
  hm_y6 = hm_r6.hm_rl(MRV + 6 * MRVN, MRLT[6], MRG[6]); hm_y7 = hm_r7.hm_rl(MRV + 7 * MRVN, MRLT[7], MRG[7]);
  hm_a0 = hm_y0 + hm_y1; hm_a1 = hm_y0 - hm_y1; hm_a2 = hm_y2 + hm_y3; hm_a3 = hm_y2 - hm_y3;
  hm_a4 = hm_y4 + hm_y5; hm_a5 = hm_y4 - hm_y5; hm_a6 = hm_y6 + hm_y7; hm_a7 = hm_y6 - hm_y7;
  hm_b0 = hm_a0 + hm_a2; hm_b2 = hm_a0 - hm_a2; hm_b1 = hm_a1 + hm_a3; hm_b3 = hm_a1 - hm_a3;
  hm_b4 = hm_a4 + hm_a6; hm_b6 = hm_a4 - hm_a6; hm_b5 = hm_a5 + hm_a7; hm_b7 = hm_a5 - hm_a7;
  hm_ri = hm_rw & (MRVN - 1); hm_h = 0.35355339;
  MRV[hm_ri]            = (hm_b0 + hm_b4) * hm_h + hm_x;
  MRV[MRVN + hm_ri]     = (hm_b1 + hm_b5) * hm_h - hm_x;
  MRV[2 * MRVN + hm_ri] = (hm_b2 + hm_b6) * hm_h + hm_x;
  MRV[3 * MRVN + hm_ri] = (hm_b3 + hm_b7) * hm_h - hm_x;
  MRV[4 * MRVN + hm_ri] = (hm_b0 - hm_b4) * hm_h + hm_x;
  MRV[5 * MRVN + hm_ri] = (hm_b1 - hm_b5) * hm_h - hm_x;
  MRV[6 * MRVN + hm_ri] = (hm_b2 - hm_b6) * hm_h + hm_x;
  MRV[7 * MRVN + hm_ri] = (hm_b3 - hm_b7) * hm_h - hm_x;
  hm_oL += (hm_y0 - hm_y2 + hm_y4 - hm_y6) * 0.5 * hm_rlev * hm_rwg;
  hm_oR += (hm_y1 - hm_y3 + hm_y5 - hm_y7) * 0.5 * hm_rlev * hm_rwg;
);
hm_rw = (hm_rw + 1) & (MRVN - 1);

// DC block
hm_dcyl = hm_oL - hm_dcxl + 0.9996 * hm_dcyl; hm_dcxl = hm_oL; hm_oL = hm_dcyl;
hm_dcyr = hm_oR - hm_dcxr + 0.9996 * hm_dcyr; hm_dcxr = hm_oR; hm_oR = hm_dcyr;

// ---------- MASTER ----------
hm_pcf == 1 ? ( hm_pcg -= hm_pcdn; hm_pcg <= 0 ? ( hm_pcg = 0; hm_pcf = 2; ); ) :
hm_pcf == 3 ? ( hm_pcg += hm_pcup; hm_pcg >= 1 ? ( hm_pcg = 1; hm_pcf = 0; ); );
hm_oL *= hm_pcg * 1.6; hm_oR *= hm_pcg * 1.6;                 // (+4 dB: the mix sits about -21 dB RMS at the default VOLUME)
hm_vol += (hm_volt - hm_vol) * hm_sm;
hm_oL = ostL.ost_band(hm_oL * hm_vol); hm_oR = ostR.ost_band(hm_oR * hm_vol);
ost_out(hm_oL, hm_oR);
spl0 = ost_l; spl1 = ost_r;
hm_pk = max(hm_pk, max(abs(spl0), abs(spl1)));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 1200 800
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 13; ui_hw = 1;
ui_begin(1200, 800);

// ---------- the card's colours: night violet, old silver, lantern gold ----------
INK = 0x0C0B10; LBL = 0xE6E0D2; SILV = 0xBDB5A3; SILVH = 0xDAD3C3; SILVD = 0x8A8373;
PANEL = 0x24212E; PANX = 0x18161F; SHA = 0x2E2A3B; SHB = 0x2A2736; SHC = 0x322D41;
LANT = 0xF2B94B; LANTL = 0xFFE2A0; LANTD = 0xB8862E; NIGHT = 0x14121B;
KEYOFF = 0x3A3448; KEYHOV = 0x4C4560;

// fonts, calibrated once per scale (the house way: a reference word fills the same width everywhere)
sc != ng_calsc ? (
  ng_calsc = sc;
  ng_f10 = ui_fitfont(10, (13.5 * sc) * max(ui_tf, 1));       // knob labels
  ng_f11 = ui_fitfont(11, (12.5 * sc) * max(ui_tf, 1));       // key captions
  ng_f12 = ui_fitfont(12, (14.5 * sc) * max(ui_tf, 1));       // section titles
  ng_f13 = ui_fitfont(13, 17 * sc);         // big captions
  ng_f16 = ui_fitfont(16, (12 * sc) * max(ui_tf, 1));         // values, small print
);
gfx_setfont(10, "Trebuchet MS", ng_f10, 'b'); gfx_setfont(11, "Trebuchet MS", ng_f11, 'b');
gfx_setfont(12, "Trebuchet MS", ng_f12, 'b'); gfx_setfont(13, "Trebuchet MS", ng_f13, 'b');
gfx_setfont(16, "Trebuchet MS", ng_f16, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');   // the card's name
gfx_setfont(15, "Georgia", 23 * sc, 'b');   // the numeral

// ---------- drawing helpers (GUI thread only; base coordinates) ----------
function ng_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function ng_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function ng_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function ng_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function ng_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function ng_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function ng_ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  x1 *= sc; y1 *= sc; x2 *= sc; y2 *= sc; w *= sc * 0.5;
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function ng_frame(x, y, w, h, t) ( ng_r(x, y, w, t); ng_r(x, y + h - t, w, t); ng_r(x, y, t, h); ng_r(x + w - t, y, t, h); );
// a section: a recessed tray, a silver title band ruled in ink
function ng_sect(x, y, w, h, shade, title) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  ui_col(SILV); ng_r(x, y, w, 20);
  ui_cola(0xFFFFFF, 0.3); ng_r(x, y, w, 1);
  ui_col(INK); ng_r(x, y + 20, w, 1.5);
  strlen(title) ? ( gfx_setfont(12); ui_col(INK); ng_t(x + 9, y + 2, title); );
);
function ng_sub(x, y, s) ( gfx_setfont(12); ui_col(INK); ng_t(x, y + 2, s); );
function ng_div(x, y, h) ( ui_col(INK); ng_r(x, y, 1.5, h); );

// ---------- the Hermit's lantern: a six-sided lamp with a star inside; lit = 0..1 ----------
function ng_lantern(cx, cy, s, lit) local(i, a, r) (
  lit > 0.01 ? ( ui_cola(LANTL, 0.22 * lit); gfx_circle(cx * sc, cy * sc, 13 * s * sc, 1, 1); ui_cola(LANTL, 0.25 * lit); gfx_circle(cx * sc, cy * sc, 8.5 * s * sc, 1, 1); );
  ui_col(INK); ng_r(cx - 1.2 * s, cy - 10.5 * s, 2.4 * s, 3 * s);                       // the ring
  ui_col(INK); gfx_triangle((cx - 5 * s) * sc, (cy - 6 * s) * sc, (cx + 5 * s) * sc, (cy - 6 * s) * sc, (cx + 2 * s) * sc, (cy - 8.5 * s) * sc, (cx - 2 * s) * sc, (cy - 8.5 * s) * sc);
  ui_col(INK); ng_r(cx - 5.5 * s, cy - 6.5 * s, 11 * s, 13 * s);
  ui_col(ui_mix(NIGHT, LANT, 0.25 + 0.75 * lit)); ng_r(cx - 4 * s, cy - 5 * s, 8 * s, 10 * s);
  ui_col(INK); ng_r(cx - 0.6 * s, cy - 5 * s, 1.2 * s, 10 * s);
  // the star
  ui_col(ui_mix(LANTD, 0xFFFFFF, 0.6 * lit)); r = 2.6 * s; i = 0;
  loop(3, a = i * $pi / 3; ng_ln(cx - cos(a) * r, cy - sin(a) * r, cx + cos(a) * r, cy + sin(a) * r, 0.9 * s); i += 1; );
  ui_col(INK); ng_r(cx - 6 * s, cy + 6.5 * s, 12 * s, 2 * s);
);

// ---------- the HOUSE WHITE CAP knob ----------
function ng_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function ng_lcap(cx, cy, r, n, col, trk) local(rr, a, a0, ca, sa, w, i) (
  rr = r + 5.5 * sc; w = 3 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(trk); ng_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  n > 0.004 ? (
    ui_col(col); ng_arcw(cx, cy, rr, a0, a, w);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); gfx_circle(cx + ca * rr, cy + sa * rr, w * 0.5, 1, 1);
  );
  ui_cola(0x000000, 0.28); gfx_circle(cx + 1 * sc, cy + 2 * sc, r, 1, 1);
  ui_col(0x50565E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0xC9CED4); gfx_circle(cx, cy, r - 1.4 * sc, 1, 1);
  ui_col(0xE6E9EC); ng_arcw(cx, cy, r - 3 * sc, -0.66 * $pi, 0.06 * $pi, 1.4 * sc);
  ui_col(0x1A1E24); i = -1;
  ui_ssline(cx + ca * r * 0.3, cy + sa * r * 0.3, cx + ca * (r - 3 * sc), cy + sa * (r - 3 * sc), 2.4 * sc, 1);
);
// the value pill (shown only while the knob is touched)
function ng_pill(cx, y, s) local(tw, th) (
  gfx_setfont(16); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 3 * sc, 3 * sc);
  ui_col(LANTL); ui_rrect(cx * sc - tw * 0.5 - 5 * sc, y * sc + 1 * sc, tw + 10 * sc, th + 1 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 1.5 * sc; gfx_drawstr(s);
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps; fmt "" shows #ng_vs
function ng_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  // a click never moves the knob: the drag starts after 3 pixels; a double-click (two clicks without a drag in
  // between) or Ctrl-click sets the default
  pressed && hov && drag_id == 0 ? (
    (time_precise() - ng_lt < 0.35 && ng_lid == idx && !ng_mv) || (mouse_cap & 4) ? ( ng_set(idx, def); drag_id = -1; ng_lt = 0; ) : (
      drag_id = did; ng_ky = mouse_y; ng_ky0 = mouse_y; ng_mv = 0; ng_lt = time_precise(); ng_lid = idx;
      ng_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !ng_mv && abs(mouse_y - ng_ky0) > 3 * sc ? ( ng_mv = 1; ng_ky = mouse_y; );
  drag_id == did && ng_mv ? (
    ng_kn = min(max(ng_kn + (ng_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); ng_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ ng_kn : lo + ng_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? ng_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    ng_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  ng_lcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), ng_acc, ng_trk);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, (r - 1.5) * sc, 1, 1);
    strlen(fmt) ? sprintf(#ng_vv, fmt, v) : strcpy(#ng_vv, #ng_vs);
    ng_pill(cx, cy + r + 5, #ng_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(ng_lfont); ui_col(ng_ink); ng_tc(cx, cy + r + 13, label); );
  );
);
ng_acc = LANT; ng_trk = 0x16131D; ng_ink = LBL; ng_lfont = 10; ng_kfont = 11;

// ---------- keys that light up (lit = on); returns 1 when clicked ----------
function ng_key(x, y, w, h, on, s) local(hov, hit) (
  hov = ng_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(LANTL, 0.28); ng_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.3); ng_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); ng_rr(x, y, w, h, 3);
  ui_col(on ? LANT : hov ? KEYHOV : KEYOFF); ng_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.45); ng_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.10); ng_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(ng_kfont); ui_col(on ? INK : LBL); ng_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function ng_keys(x, y, w, h, gap, idx, n, labels) local(i) (
  i = 0;
  loop(n, ng_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == i, pk_pitem(labels, i + 1, #ng_k)) ? ng_set(idx, i); i += 1; );
);
function ng_toggle(x, y, w, h, idx, s) ( ng_key(x, y, w, h, slider(idx) >= 0.5, s) ? ng_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// wave glyphs: 0 sine 1 triangle 2 saw 3 square / pulse 4 S&H 5 smooth random
function ng_glyph(cx, cy, t, col) local(i, x0, y0, x1, y1, hh) (
  ui_col(col); hh = 5;
  t == 0 ? ( i = 0; loop(16, x0 = cx - 8 + i; x1 = x0 + 1;
             ng_ln(x0, cy - sin(i / 16 * 2 * $pi) * hh, x1, cy - sin((i + 1) / 16 * 2 * $pi) * hh, 1.6); i += 1; ); ) :
  t == 1 ? ( ng_ln(cx - 8, cy, cx - 4, cy - hh, 1.6); ng_ln(cx - 4, cy - hh, cx + 4, cy + hh, 1.6); ng_ln(cx + 4, cy + hh, cx + 8, cy, 1.6); ) :
  t == 2 ? ( ng_ln(cx - 8, cy + hh, cx + 6, cy - hh, 1.6); ng_ln(cx + 6, cy - hh, cx + 6, cy + hh, 1.6); ) :
  t == 3 ? ( ng_ln(cx - 8, cy + hh, cx - 8, cy - hh, 1.6); ng_ln(cx - 8, cy - hh, cx, cy - hh, 1.6); ng_ln(cx, cy - hh, cx, cy + hh, 1.6);
             ng_ln(cx, cy + hh, cx + 8, cy + hh, 1.6); ) :
  t == 4 ? ( ng_ln(cx - 8, cy + 2, cx - 3, cy + 2, 1.6); ng_ln(cx - 3, cy + 2, cx - 3, cy - hh, 1.6); ng_ln(cx - 3, cy - hh, cx + 2, cy - hh, 1.6);
             ng_ln(cx + 2, cy - hh, cx + 2, cy + hh, 1.6); ng_ln(cx + 2, cy + hh, cx + 8, cy + hh, 1.6); ) :
  ( x0 = cx - 8; y0 = cy + 1; i = 0;
    loop(16, x1 = cx - 8 + i + 1; y1 = cy + (sin((i + 1) * 0.55) * 0.6 + sin((i + 1) * 0.23 + 1) * 0.5) * hh;
             ng_ln(x0, y0, x1, y1, 1.6); x0 = x1; y0 = y1; i += 1; ); );
);
// a key showing a wave glyph
function ng_gkey(x, y, w, h, on, t) local(hit) (
  hit = ng_key(x, y, w, h, on, "");
  ng_glyph(x + w * 0.5, y + h * 0.5, t, on ? INK : LBL);
  hit;
);
// a field that shows a setting (a drop-down arrow); returns 1 when clicked
function ng_field(x, y, w, h, s) local(hov, hit) (
  hov = ng_hov(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_col(INK); ng_rr(x, y, w, h, 3);
  ui_col(hov ? SILVH : SILV); ng_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(11); ui_col(INK); ng_tc(x + (w - 9) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 11) * sc, (y + h * 0.5 - 2) * sc, (x + w - 5) * sc, (y + h * 0.5 - 2) * sc, (x + w - 8) * sc, (y + h * 0.5 + 2.5) * sc);
  hit;
);
// a drop-down menu from a "|" list for a stepped slider
function ng_menu(x, y, idx, list, n) local(i, k) (
  strcpy(#ng_m, ""); i = 0; k = floor(slider(idx) + 0.5);
  loop(n, i == k ? strcat(#ng_m, "!"); strcat(#ng_m, pk_pitem(list, i + 1, #ng_k)); i < n - 1 ? strcat(#ng_m, "|"); i += 1; );
  gfx_x = x * sc; gfx_y = y * sc; i = gfx_showmenu(#ng_m); i > 0 ? ng_set(idx, i - 1);
);
function ng_nname(n) local(o) (
  o = floor(n / 12) - 1;
  sprintf(#ng_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #ng_k), o);
  #ng_nn;
);


// ---------- more helpers ----------
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function ng_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#ng_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#ng_mls, ">"); strcat(#ng_mls, pk_pitem(list, i + 1, #ng_mi)); strcat(#ng_mls, " - ");
                      strcat(#ng_mls, pk_pitem(list, min(s0 + grp, n), #ng_mi)); strcat(#ng_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#ng_mls, "<");
    i == cur ? strcat(#ng_mls, "!");
    strcat(#ng_mls, pk_pitem(list, i + 1, #ng_mi));
    i < n - 1 ? strcat(#ng_mls, "|");
    i += 1; );
  #ng_mls;
);
// a value field (the house drop-down field): a click opens the list of every value (list: lo..hi, grp > 0 groups it
// in submenus of grp), the current one ticked; the wheel steps it
function ng_dfield(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = ng_hov(x, y, w, h);
  ng_field(x, y, w, h, s) ? (
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(ng_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? ng_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( ng_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
// a chord's name: root (with TRANSPOSE when tr) and type
function ng_cname(r, t) (
  strcpy(#ng_cn, pk_pitem(#hm_rn, hm_mod(r, 12) + 1, #ng_k));
  t > 0 ? strcat(#ng_cn, pk_pitem("x|m|7|m7|maj7|6|m6|sus2|sus4|7sus4|9|m9|add9|dim|m7b5|+", t + 1, #ng_k));
  #ng_cn;
);
// a lit dot (a small lantern light)
function ng_dot(cx, cy, r, lit) (
  lit ? ( ui_cola(LANTL, 0.3); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1); );
  ui_col(INK); gfx_circle(cx * sc, cy * sc, (r + 1.2) * sc, 1, 1);
  ui_col(lit ? LANT : 0x3A3448); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
);

// ---------- the card ----------
ui_col(SILV); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); ng_rr(4, 4, 1192, 792, 9);
ui_col(SILV); ng_rr(6.5, 6.5, 1187, 787, 7);
ui_col(INK); ng_r(11, 11, 1178, 778);
ui_col(PANEL); ng_r(13, 13, 1174, 774);
// a few stars over the mountain
ui_cola(LBL, 0.18); ng_k_ = 0;
loop(44, ng_sx = 20 + ((ng_k_ * 137) % 1160); ng_sy = 62 + ((ng_k_ * 271) % 680);
         gfx_circle(ng_sx * sc, ng_sy * sc, (ng_k_ % 3 == 0 ? 1.2 : 0.7) * sc, 1, 1); ng_k_ += 1; );
// header band
ui_col(PANX); ng_r(13, 13, 1174, 44);
ui_col(INK); ng_r(13, 57, 1174, 2);
// the numeral, in a silver cartouche, between two lanterns
ui_col(INK); ng_rr(562, 15, 76, 38, 6); ui_col(SILV); ng_rr(564, 17, 72, 34, 5);
ui_col(INK); ng_frame(567, 20, 66, 28, 1);
gfx_setfont(15); ui_col(INK); ng_tc(600, 34.5, "IX");
ng_lantern(536, 35, 1.15, hm_run); ng_lantern(664, 35, 1.15, hm_run);

// preset bar
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(22 * sc, 18 * sc, 372 * sc, 34 * sc, pr_cur, #hm_pm);
k_ > 0 ? ( k_ > hm_npre ? reset_all() : prs_dirty = k_; );
gfx_setfont(12); ui_col(LBL); ng_t(408, 19, "HANDS-FREE"); ui_cola(LBL, 0.75); ng_t(408, 35, "JAM SYNTH");
// the transport: START / STOP run it on its own; FOLLOW plays along with REAPER
ng_key(688, 21, 50, 28, slider1 >= 0.5, "START") ? ng_set(1, 1);
ng_key(742, 21, 46, 28, slider1 < 0.5, "STOP") ? ng_set(1, 0);
ng_toggle(792, 21, 62, 28, 2, "FOLLOW");
ng_toggle(858, 21, 82, 28, 174, "TRANSPORT");
// where it is: the chord, and the bar and beat (right-aligned; the chord's name gives way if they would meet)
ui_col(INK); ng_rr(946, 18, 158, 34, 4); ui_col(NIGHT); ng_rr(948, 20, 154, 30, 3);
hm_run && hm_ci >= 0 ? (
  ng_bs_ = floor((hm_pm - HSB[hm_ci]) / hm_bl) + 1;
  gfx_setfont(16); ui_col(LANTL);
  sprintf(#ng_g, "BAR %d / %d", ng_bs_, HSN[hm_ci]); gfx_measurestr(#ng_g, ng_bw_, ng_bh_);
  gfx_x = 1094 * sc - ng_bw_; gfx_y = 22 * sc; gfx_drawstr(#ng_g);
  sprintf(#ng_g, "BEAT %d", hm_beat + 1); gfx_measurestr(#ng_g, ng_tw_, ng_bh_);
  gfx_x = 1094 * sc - ng_tw_; gfx_y = 36 * sc; gfx_drawstr(#ng_g);
