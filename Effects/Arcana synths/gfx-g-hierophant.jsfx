      hg_rt > 1 ? ( ui_col(GOLDL); hg_k = 1; loop(hg_rt - 1, hg_a = hg_b0 + (hg_b1 - hg_b0) * hg_k / hg_rt; hg_ln(hg_cx + sin(hg_a) * hg_a0, hg_cy - cos(hg_a) * hg_a0, hg_cx + sin(hg_a) * (hg_a0 + 5), hg_cy - cos(hg_a) * (hg_a0 + 5), 1.2); hg_k += 1; ); );
      (hg_f & 2) ? ( ui_col(GOLDL); hg_a = (hg_b0 + hg_b1) * 0.5; hg_disc(hg_cx + sin(hg_a) * (hg_a1 - 4), hg_cy - cos(hg_a) * (hg_a1 - 4), 2); );
    );
    (hg_f & 4) ? ( ui_col(GOLD); hg_a = (hg_b0 + hg_b1) * 0.5; hg_disc(hg_cx + sin(hg_a) * (hg_a0 + 3.5), hg_cy - cos(hg_a) * (hg_a0 + 3.5), 2.2); ui_col(LEAD); hg_disc(hg_cx + sin(hg_a) * (hg_a0 + 3.5), hg_cy - cos(hg_a) * (hg_a0 + 3.5), 0.9); );
    hg_s += 1;
  );
  hg_l += 1;
);
// the leading: the rings, the panes, and the groups' tracery in gold (the bar's start the heaviest)
