  : l == 2 ? ( j == 0 ? ( hu6.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 384); !an ? ( hu7.hi_ufade(hi_fk1); hu8.hi_ufade(hi_fk1); ); ) : j == 1 ? ( hu7.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 448); !an ? ( hu6.hi_ufade(hi_fk1); hu8.hi_ufade(hi_fk1); ); ) : ( hu8.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 512); !an ? ( hu6.hi_ufade(hi_fk1); hu7.hi_ufade(hi_fk1); ); ); )
  : l == 3 ? ( j == 0 ? ( hu9.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 576); !an ? ( hu10.hi_ufade(hi_fk1); hu11.hi_ufade(hi_fk1); ); ) : j == 1 ? ( hu10.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 640); !an ? ( hu9.hi_ufade(hi_fk1); hu11.hi_ufade(hi_fk1); ); ) : ( hu11.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 704); !an ? ( hu9.hi_ufade(hi_fk1); hu10.hi_ufade(hi_fk1); ); ); )
  : l == 4 ? ( j == 0 ? ( hu12.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 768); !an ? ( hu13.hi_ufade(hi_fk1); hu14.hi_ufade(hi_fk1); ); ) : j == 1 ? ( hu13.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 832); !an ? ( hu12.hi_ufade(hi_fk1); hu14.hi_ufade(hi_fk1); ); ) : ( hu14.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 896); !an ? ( hu12.hi_ufade(hi_fk1); hu13.hi_ufade(hi_fk1); ); ); )
  : l == 5 ? ( j == 0 ? ( hu15.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 960); !an ? ( hu16.hi_ufade(hi_fk1); hu17.hi_ufade(hi_fk1); ); ) : j == 1 ? ( hu16.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 1024); !an ? ( hu15.hi_ufade(hi_fk1); hu17.hi_ufade(hi_fk1); ); ) : ( hu17.hi_ugo(k, v, tu, dm, lv, g, pn, HUKB + 1088); !an ? ( hu15.hi_ufade(hi_fk1); hu16.hi_ufade(hi_fk1); ); ); )
