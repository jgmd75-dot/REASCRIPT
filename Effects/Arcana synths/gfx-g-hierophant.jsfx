                         kl, kset, kmx, kmc, kw, kenv, xe, xec, xlc, xlp, xt, xn,
                         cl, ce, cec, vt, cr, crh, crc, crn, crq, amp, gl, gr, act, kbs, nfl, pfl, nt,
