);
// the hub: the meter, the grouping, the bar
ui_col(GOLDD); hg_disc(hg_cx, hg_cy, hg_r0 - 2); ui_col(GOLD); hg_disc(hg_cx, hg_cy, hg_r0 - 3.5);
ui_col(GLASS); hg_disc(hg_cx, hg_cy, hg_r0 - 5.5);
// the anchor's ring round the hub: its figure in cinnabar glass (bright on the group starts' accents), dim when it rests
