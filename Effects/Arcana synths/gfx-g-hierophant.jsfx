gfx_setfont(13); ui_col(PALE); hg_tc(hg_cx, hg_cy + 12, hg_grpstr());
gfx_setfont(11); ui_col(GOLD); sprintf(#hg_g, hg_run ? "BAR %d" : "AT REST", hg_bar + 1); hg_tc(hg_cx, hg_cy + 30, #hg_g);
hg_fill ? ( gfx_setfont(11); ui_col(JW[7]); hg_tc(hg_cx, hg_cy - 33, "FILL"); );
// hovering a pane: what it holds; a click lights or darkens it (an edit, kept with the project), a right-click (or a
// double-click) gives it back to the generator. CUSTOM meter: a click on the ring of numbers starts / ends a group there
hg_dx = mouse_x / sc - hg_cx; hg_dy = mouse_y / sc - hg_cy; hg_dd_ = sqrt(hg_dx * hg_dx + hg_dy * hg_dy);
hg_ang = atan2(hg_dx, -hg_dy); hg_ang < 0 ? hg_ang += 2 * $pi;
