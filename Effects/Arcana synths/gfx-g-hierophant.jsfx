) : (
// ======================== PATTERNS: the library, page by page - click a pattern to load it ========================
hg_sect(22, 72, 1156, 688, "THE LIBRARY · PATTERNS BY STYLE · ENDINGS · TIMELINES");
// the items: each group's heading, then its entries (a heading never ends a column); five columns of thirty rows a page
hg_nr = 30; hg_ncol = 5; hg_rh = 20.3; hg_y0 = 136;
hg_key(34, 102, 30, 24, 0, "<", JW[0]) ? hg_lpg = max(hg_lpg - 1, 0);
hg_key(68, 102, 30, 24, 0, ">", JW[0]) ? hg_lpg = min(hg_lpg + 1, hg_npg - 1);
gfx_setfont(13); ui_col(LBL); sprintf(#hg_g, "PAGE %d OF %d", hg_lpg + 1, max(hg_npg, 1)); hg_t(108, 106, #hg_g);
hg_key(220, 102, 124, 24, hi_pat == 0, "GENERATED", JW[2]) ? hg_set(143, 0);
gfx_setfont(11); ui_col(DIM);
hg_t(356, 101, "CLICK A PATTERN TO LOAD IT: IT TAKES ITS METER AND PLAYS EXACTLY AS WRITTEN AT THE NEUTRAL SETTINGS");
hg_t(356, 115, "(DENSITY 50, VARIATION 0, SPARSITY 0, GROOVE 0, SWING 0, FATE 0); TURN THEM UP TO LOOSEN IT. FILLS ARE ITS STYLE'S BREAKS.");
hg_hv = hg_hov(22, 130, 1156, 626); hg_hv && mouse_wheel != 0 ? ( hg_lpg = min(max(hg_lpg - sign(mouse_wheel), 0), hg_npg - 1); mouse_wheel = 0; );
hg_pgi = 0; hg_row = 0; hg_sty_ = -1; hg_i = 1;
while (hg_i <= hi_nent) (
  hg_e = HENT + (hg_i - 1) * 7;
  hg_hd = hg_e[0] == 2 ? hi_nsty + 1 : hg_e[0] == 1 ? hi_nsty : hg_e[1];
  hg_hd != hg_sty_ ? (
    // a heading: never on a column's last row
    (hg_row % hg_nr) == hg_nr - 1 ? hg_row += 1;
    hg_sty_ = hg_hd;
    hg_pgi = floor(hg_row / (hg_nr * hg_ncol));
    hg_pgi == hg_lpg ? (
      hg_c = floor((hg_row % (hg_nr * hg_ncol)) / hg_nr); hg_x = 34 + hg_c * 228; hg_y = hg_y0 + (hg_row % hg_nr) * hg_rh;
      ui_col(IND); hg_rr(hg_x, hg_y + 1, 220, hg_rh - 2, 2); ui_col(GOLD); hg_r(hg_x, hg_y + hg_rh - 2, 220, 1);
      gfx_setfont(12); ui_col(GOLDL); hg_t(hg_x + 8, hg_y + 2, pk_pitem(#hg_sty, hg_hd + 1, #hg_k));
    );
    hg_row += 1;
  ) : (
    hg_pgi = floor(hg_row / (hg_nr * hg_ncol));
    hg_pgi == hg_lpg ? (
      hg_c = floor((hg_row % (hg_nr * hg_ncol)) / hg_nr); hg_x = 34 + hg_c * 228; hg_y = hg_y0 + (hg_row % hg_nr) * hg_rh;
      hg_on = hi_pat == hg_i; hg_hv = hg_hov(hg_x, hg_y, 220, hg_rh);
      hg_on ? ( ui_col(CINN); hg_rr(hg_x, hg_y + 1, 220, hg_rh - 2, 3); ) : hg_hv ? ( ui_col(KEYHOV); hg_rr(hg_x, hg_y + 1, 220, hg_rh - 2, 3); );
      gfx_setfont(13); ui_col(hg_on ? 0xFFFFFF : LBL); hg_t(hg_x + 8, hg_y + 2.5, hg_ename(hg_i));
      gfx_setfont(11); ui_col(hg_on ? 0xFFFFFF : DIM);
      hg_e[0] < 2 && hg_e[5] > 0 ? hg_tr(hg_x + 214, hg_y + hg_rh * 0.5, hg_e[5] == 1 ? "TRIPLETS" : hg_e[5] == 2 ? "12/8" : "3/4");
      hg_hv && pressed && drag_id == 0 ? ( drag_id = -1; hg_pload(hg_i); );
    );
    hg_row += 1; hg_i += 1;
  );
);
hg_npg = ceil(hg_row / (hg_nr * hg_ncol));
);
// ======================== the foot of the card: FATE, VOLUME, LEVEL, the name plate, SAT, the level ========================
ui_col(INK); hg_r(13, 768, 1174, 2);
ui_col(IND); hg_r(13, 770, 1174, 67);
ui_col(GOLD); hg_r(13, 770, 1174, 1.5);
hg_knob(48, 803, 13, 75, 0, 100, 50, "", "%.0f%%", 0);
drag_id != 2075 && !(sqr(mouse_x - 48 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(GOLDL); hg_t(70, 788, "FATE"); gfx_setfont(11); ui_col(PALE); hg_t(70, 806, "CONGREGATION"); );
hg_knob(196, 803, 13, 76, -24, 6, -3, "", "%+.1f dB", 0);
drag_id != 2076 && !(sqr(mouse_x - 196 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(GOLDL); hg_t(218, 794, "VOLUME"); );
hg_knob(316, 803, 13, 77, 0, 100, 60, "", "%.0f%%", 0);
drag_id != 2077 && !(sqr(mouse_x - 316 * sc) + sqr(mouse_y - 803 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(GOLDL); hg_t(338, 794, "LEVEL"); );
// the name plate, between the Hierophant's crossed keys
ui_col(GOLDD); hg_rr(430, 781, 340, 44, 5); ui_col(GOLD); hg_rr(431.5, 782.5, 337, 41, 4.5);
ui_col(IVORY); hg_rr(434, 785, 332, 36, 4);
ui_col(CINN); hg_r(444, 816, 312, 1.4);
gfx_setfont(14); ui_col(LBL); hg_tc(600, 802, "THE HIEROPHANT"); ver_tag("v2", 16, 2.6, 0);
ui_col(GOLD); hg_keyart(400, 803, 1, -0.75); hg_keyart(400, 803, 1, -2.39); hg_keyart(800, 803, 1, -0.75); hg_keyart(800, 803, 1, -2.39);
ins_io(960, 785, 78, PALE);
hg_lv = min(max((20 * log10(max(hi_pk, 0.00001)) + 48) / 48, 0), 1);
ui_col(INK); hg_r(1060, 802, 112, 14); ui_col(GLASS); hg_r(1061.5, 803.5, 109, 11);
hg_i = 0; loop(18, hg_on = hg_i / 18 < hg_lv; ui_col(hg_on ? (hg_i >= 16 ? JW[0] : hg_i >= 13 ? GOLDL : GOLD) : 0x1E2E4A); hg_r(1063 + hg_i * 6, 805, 4.6, 8); hg_i += 1; );
gfx_setfont(11); ui_col(PALE); hg_t(1060, 786, "OUTPUT");

pk_end();
ui_end();
