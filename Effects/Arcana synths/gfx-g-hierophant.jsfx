hg_ring(hg_cx, hg_cy, hg_ro + 4);
hg_s = 0;
loop(hg_N,
  hg_a = hg_s * hg_pi2;
  MP[hg_s] == 0 ? (
    ui_col(GOLDD); hg_ln(hg_cx + sin(hg_a) * (hg_r0 - 4), hg_cy - cos(hg_a) * (hg_r0 - 4), hg_cx + sin(hg_a) * 251, hg_cy - cos(hg_a) * 251, hg_s == 0 ? 4 : 3);
    ui_col(hg_s == 0 ? GOLDL : GOLD); hg_ln(hg_cx + sin(hg_a) * (hg_r0 - 4), hg_cy - cos(hg_a) * (hg_r0 - 4), hg_cx + sin(hg_a) * 251, hg_cy - cos(hg_a) * 251, hg_s == 0 ? 2.2 : 1.4);
    ui_col(GOLDL); hg_disc(hg_cx + sin(hg_a) * 251, hg_cy - cos(hg_a) * 251, hg_s == 0 ? 4 : 3);
