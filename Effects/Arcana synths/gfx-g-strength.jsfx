// the wave it makes
ui_col(INK); sg_r(32, 712, 194, 40); ui_col(SCR); sg_r(33.5, 713.5, 191, 37);
sg_sh = min(max(SVP[sg_b + 1] * 0.01, -1), 1); sg_i = 0;
loop(97, sg_p = sg_i / 96 * 2; sg_p -= floor(sg_p);
  sg_sh > 0.001 ? ( sg_dk = 0.5 - 0.49 * sg_sh; sg_p = sg_p < sg_dk ? sg_p * 0.5 / sg_dk : 0.5 + (sg_p - sg_dk) * 0.5 / (1 - sg_dk); );
  sg_o = sin(2 * $pi * sg_p);
