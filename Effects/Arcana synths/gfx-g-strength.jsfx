desc:Strength [Arcana drum synth] (GFX)
//tags: instrument drum machine drum synth synthesised step sequencer pattern parameter locks fm ring mod arcana
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-voice (.jsfx-inc) in the same folder.
//
// STRENGTH (card VIII of the GFX Arcana series): the lion tamed by a gentle hand. A synthesised drum machine: every
// sound is built from oscillators, noise and a filter, nothing is sampled, so a kick can become a tom, a zap, a bass.
// TWELVE DRUM VOICES and ONE CHROMATIC VOICE (TONE), each a small synthesiser, each with its own step sequence.
//
// A VOICE
//   OSC 1     a phase-distortion oscillator: TUNE (the pitch, as a note), SHAPE (0 = a pure sine; turned right the
//             wave leans into a saw, left it squares off), LEVEL.
//   OSC 2     SINE, TRIANGLE, SAW or SQUARE: TUNE (semitones from OSC 1), LEVEL, FM (OSC 2 bends OSC 1's phase:
//             bells, metal, knocks), RING (OSC 1 x OSC 2: clangs and hats).
//   NOISE     LEVEL, LP / BP / HP and its COLOUR (the noise's own filter), DIRT (holds the noise for a few samples:
//             grit, then crackle).
//   PITCH ENV the sweep that makes a kick: AMOUNT (-48 .. +48 semitones, falling back to the tuned pitch), TIME.
//   FILTER    OFF, LP 12, LP 24, HP 12 or BP: CUTOFF, RESO, ENV (how far the filter's own envelope opens or closes
//             it), ENV TIME.
//   DRIVE     OFF, DRIVE (a warm soft clip) or CRUSH (fewer bits and a lower sample rate): AMOUNT.
//   AMP       ATTACK, HOLD, DECAY; ONE SHOT (the hit plays out) or GATE (it sustains while the key / step is held, then
//             decays); BURST (1 - 4 hits 11 ms apart: claps).
//   LFO       RATE, AMOUNT, to PITCH, CUTOFF, AMP or SHAPE.
//   OUTPUT    LEVEL, PAN, VELOCITY (how much the velocity counts), CHOKE (A, B, C: a voice silences the others in its
//             group - the closed hat cuts the open one), MUTE, SOLO.
//   A new hit on a sounding voice fades the old one out underneath it (no clicks).
// THE LION   gentle control: one knob over the whole kit, TAME .. WILD. Tamed, the attacks round off, the drive
//             eases out, the pitch sweeps and the noise soften, a soft top darkens every voice, the filters close a
//             little and the dynamics narrow; wild, drive comes in (and adds weight), the sweeps reach further, the
//             filters open and the dynamics widen. A step can lock its own LION too. It acts on each new hit.
// PATIENCE    a step can WAIT: it plays only on pass A of every B (1:2, 2:2, 1:4 .. 4:4, 1:8 .. 8:8), counted from the
//             start of the song (or of the run), so a fill or a variation comes round in its own time.
// BREATH      gentle dynamics for the sequenced hits: a slow swell and ebb over two bars and a light lift on the
//             beats (0 - 100 %; 25 % by default; at 100 % about +4 / -6 dB).
// THE SEQUENCER
//   Eight PATTERNS (A - H): a kit fills them as variations - A main, B the kit's variation, C more hats, D ghosts,
//   E half time, F breakdown, G fill, H build. Each voice has its own lane of up to 32 steps and its own LENGTH
//   (1 - 32, per pattern; SHIFT-click names to choose several lanes), RATE (1/8, 1/8T, 1/16, 1/16T, 1/32), SWING (each
//   voice can opt out: its SW light). Click a cell of the grid to set a step, drag to paint.
//   The STEP EDITOR below shows the chosen voice: draw each step's VELOCITY, GATE (for GATE voices: how long it holds,
//   10 - 400 % of a step), its PATIENCE (WAIT), and four LOCKS that change the sound on that step only: PITCH (+/- 24 semitones:
//   the TONE voice plays melodies this way), DECAY (x 1/4 .. x 4), CUTOFF (+/- 3 octaves) and LION. Right-click (or double-click)
//   a bar to clear it. CLEAR, COPY, PASTE and SHIFT < > work on the chosen voice's row.
//   RUN starts it (free-running at the project tempo); TRANSPORT (lit by default) runs it with REAPER's playback,
//   locked to the timeline.
// MIDI   C1 - B1 (36 - 47) play the twelve drum voices; every other note plays TONE chromatically (C3 = as tuned).
//        Channel select; CC120 / CC123 stop everything.
// FATE   the series' drift: each sequenced hit lands a touch early or late, and every hit is a little brighter or
//        darker and a fraction sharp or flat (the level is left to BREATH). 0 = machine-exact.
// VOLUME, LEVEL, SAT (the output soft clip is always on).
// GUI    click a voice's name to choose it (and hear it); its name opens the list of names. Knobs: drag (SHIFT = fine),
//        double-click = default, wheel.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc

slider1:0<0,1,1{Stop,Run}>-Run
slider2:1<0,1,1{Off,On}>-Transport (follows REAPER play state)
slider3:0<0,7,1{A,B,C,D,E,F,G,H}>-Pattern
slider4:16<1,32,1>-(unused, was the pattern length: each lane has its own)
slider5:2<0,4,1{1/8,1/8T,1/16,1/16T,1/32}>-Rate
slider6:0<0,75,1>-Swing (%)
slider7:0<0,16,1>-MIDI channel (0 = omni)
slider8:35<0,100,1>-Fate (%)
slider9:-4<-24,6,0.1>-Volume (dB)
slider10:60<0,100,0.1>-Level (%)
slider11:0<0,100,1>-Band sat (%)
slider12:30<0,100,1>-Bias (%)
slider13:120<40,400,1>-Sat low band (Hz)
slider14:6000<2000,16000,10>-Sat high band (Hz)
slider15:-0.3<-24,0,0.1>-Ceiling (dB)
slider16:0<-100,100,1>-The Lion (tame .. wild)
slider17:25<0,100,1>-Breath (%)
slider18:prs_sel=0<0,8,1{No preset,Init,Boom,Electro,Foundry,Pin Drop,Tin Garden,Glass Lion,Broken Clock}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-strength";
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
NV = 13; NP = 40; NS = 32; NF = 7; NPAT = 8;
SVP = 40000;                                   // voice parameters: 13 x 40
SVD = 41000; VDS = 64;                         // voice state: 13 x 64
SSQ = 100000;                                  // patterns: 8 x 13 x 32 steps x 7 fields (vel, gate, pitch, decay, cutoff, wait, lion)
SPLO = 70000; SPHI = 70100; SPDF = 70200; SPLG = 70300; SPST = 70400;   // parameter table
SKT = 71000;                                   // the kit parser's scratch
SCB = 72000;                                   // the panel's clipboard (one row; SCB + 400: SHIFT's scratch)
SPB = 80000;                                   // the panel's clipboard (a whole pattern)
SRL = 130000;                                  // each pattern's lane lengths (8 x 13; 0 = 16)
SEO = 73000; SEV = 73300; SEN = 73600; SET = 73900; SEL = 76000;        // the block's events (300; SEL 6 an event)
SHIT = 75000;                                  // when each voice last struck (for the panel)
memset(SVD, 0, NV * VDS); memset(SHIT, 0, 16);
L12 = log(2) / 12;

// ---------- the voice parameters: index, range, default, log, stepped, name (strings 1000 + i) ----------
function prm(i, lo, hi, def, lg, st, nm) ( SPLO[i] = lo; SPHI[i] = hi; SPDF[i] = def; SPLG[i] = lg; SPST[i] = st; strcpy(1000 + i, nm); );
prm(0, 12, 108, 48, 0, 0, "TUNE");        prm(1, -100, 100, 0, 0, 0, "SHAPE");    prm(2, 0, 100, 100, 0, 0, "OSC 1 LEVEL");
prm(3, 0, 3, 0, 0, 1, "OSC 2 WAVE");     prm(4, -24, 48, 0, 0, 0, "OSC 2 TUNE");  prm(5, 0, 100, 0, 0, 0, "OSC 2 LEVEL");
prm(6, 0, 100, 0, 0, 0, "FM");           prm(7, 0, 100, 0, 0, 0, "RING");         prm(8, 0, 100, 0, 0, 0, "NOISE");
prm(9, 0, 2, 2, 0, 1, "NOISE TYPE");     prm(10, 100, 18000, 6000, 1, 0, "COLOUR"); prm(11, 0, 100, 0, 0, 0, "DIRT");
prm(12, -48, 48, 0, 0, 0, "PITCH ENV");  prm(13, 1, 1000, 40, 1, 0, "PITCH TIME");
prm(14, 0, 4, 0, 0, 1, "FILTER");        prm(15, 20, 20000, 8000, 1, 0, "CUTOFF"); prm(16, 0, 100, 0, 0, 0, "RESO");
prm(17, -100, 100, 0, 0, 0, "FILTER ENV"); prm(18, 1, 2000, 100, 1, 0, "ENV TIME");
prm(19, 0, 2, 0, 0, 1, "DRIVE MODE");    prm(20, 0, 100, 0, 0, 0, "DRIVE");
prm(21, 0, 200, 0, 0, 0, "ATTACK");      prm(22, 0, 1000, 0, 0, 0, "HOLD");       prm(23, 5, 8000, 300, 1, 0, "DECAY");
prm(24, 0, 1, 0, 0, 1, "TRIGGER");       prm(25, 0, 3, 0, 0, 1, "BURST");
prm(26, 0.1, 40, 4, 1, 0, "LFO RATE");   prm(27, 0, 100, 0, 0, 0, "LFO AMOUNT");  prm(28, 0, 3, 0, 0, 1, "LFO TO");
prm(29, 0, 100, 60, 0, 0, "VELOCITY");   prm(30, -36, 6, 0, 0, 0, "LEVEL");       prm(31, -100, 100, 0, 0, 0, "PAN");
prm(32, 0, 3, 0, 0, 1, "CHOKE");         prm(33, 0, 1, 0, 0, 1, "MUTE");          prm(34, 0, 1, 0, 0, 1, "SOLO");
prm(35, 0, 1, 1, 0, 1, "SWING");         prm(36, 0, 31, 0, 0, 1, "NAME");         prm(37, 0, 1, 1, 0, 1, "OSC 2 SWEEP");
prm(38, 0, 1, 0, 0, 1, "-");             prm(39, 0, 1, 0, 0, 1, "-");

// the voice names (a voice's NAME picks one)
#st_names = "KICK|KICK 2|SUB KICK|SNARE|SNARE 2|CLAP|RIM|CLOSED HAT|OPEN HAT|PEDAL HAT|TOM LOW|TOM MID|TOM HIGH|COWBELL|CLAVE|SHAKER|CONGA|BONGO|CRASH|RIDE|ZAP|BLIP|PERC|METAL|BELL|NOISE|GLITCH|SNAP|BASS|TONE|LEAD|SUB";
function vp(v, i) ( SVP[v * NP + i]; );
function sq_ptr(p, v, s) ( SSQ + (((p * NV + v) * NS + s) * NF); );
function sq_ptr_au(p, v, s) ( SSQ + (((p * NV + v) * NS + s) * NF); );
function row_len(p, v) local(n) ( n = floor(SRL[p * NV + v] + 0.5); n < 1 ? 16 : min(n, NS); );

// ---------- number parser: every number in s (":" "," and spaces separate) into dst; returns the count ----------
function st_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function st_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);

// ---------- kits: each voice "NAME idx:val idx:val ..." over the defaults; "|" between the voices ----------
//  0 tune  1 shape  2 osc1 lvl  3 osc2 wave  4 osc2 tune  5 osc2 lvl  6 fm  7 ring  8 noise  9 noise type  10 colour
//  11 dirt  12 pitch env  13 pitch time  14 filter  15 cutoff  16 reso  17 filter env  18 env time  19 drive mode
//  20 drive  21 attack  22 hold  23 decay  24 trigger  25 burst  26 lfo rate  27 lfo amt  28 lfo to  29 velocity
//  30 level  31 pan  32 choke  35 swing  36 name  37 osc2 sweep
#st_km = "Init|Boom|Electro|Foundry|Pin Drop|Tin Garden|Glass Lion|Broken Clock";
st_nkit = 8;
function kit_str(k) (
  k == 2 ? (   // BOOM: long round kicks, soft snare, wide toms, a deep tone
  "0 0:31 12:30 13:60 23:1400 8:4 10:2500 9:1 20:15 19:1 29:50 30:-2|
   3 0:52 2:55 5:25 4:7 8:70 10:4200 9:2 12:9 13:18 14:1 15:7000 23:280 31:-5|
   5 2:0 8:100 9:1 10:1150 14:4 15:1200 16:25 25:3 23:420 30:-2 31:8|
   6 0:78 1:-55 2:70 3:0 4:19 5:35 8:25 9:2 10:5000 14:3 15:500 23:45 30:-6 31:-20|
   7 1:-100 0:90 2:0 3:3 4:7.4 5:0 7:85 8:55 9:2 10:9000 14:3 15:7500 16:15 23:55 32:1 30:-8 31:15|
   8 1:-100 0:90 2:0 3:3 4:7.4 5:0 7:85 8:55 9:2 10:9000 14:3 15:7000 16:15 23:600 32:1 30:-9 31:15|
   12 0:52 12:12 13:70 23:520 8:6 9:0 10:3000 30:-3 31:30|
   11 0:45 12:12 13:80 23:600 8:6 9:0 10:3000 30:-3 31:0|
   10 0:40 12:12 13:90 23:700 8:6 9:0 10:3000 30:-3 31:-30|
   13 0:79 1:-70 2:55 3:3 4:6.8 5:55 14:4 15:1600 16:45 23:220 30:-9 31:-10|
   21 0:86 12:-40 13:70 1:35 14:1 15:6000 23:150 30:-8 31:20|
   22 0:72 3:0 4:19 5:0 6:55 12:5 13:8 23:110 30:-7 31:-25|
   29 0:36 1:20 3:2 4:-12 5:35 14:2 15:180 16:20 17:55 18:220 24:1 21:2 23:260 30:-4 37:1"
  ) :
  k == 3 ? (   // ELECTRO: punchy, bright, a snappy snare, a square bass
  "0 0:35 12:42 13:28 23:420 8:15 9:1 10:4500 20:35 19:1 29:55|
   3 0:55 2:45 5:35 4:5 8:85 10:5500 9:2 12:14 13:12 14:3 15:350 23:200 20:25 19:1|
   5 2:0 8:100 9:1 10:1300 14:4 15:1400 16:30 25:3 23:320 31:-10|
   27 0:84 1:-80 2:60 8:60 9:2 10:7000 12:24 13:4 23:35 30:-6 31:12|
   7 1:-100 0:93 2:0 3:3 4:7.4 5:0 7:85 8:60 9:2 10:10000 14:3 15:8500 16:10 23:40 32:1 30:-7 31:20|
   8 1:-100 0:93 2:0 3:3 4:7.4 5:0 7:85 8:60 9:2 10:10000 14:3 15:8000 16:10 23:380 32:1 30:-8 31:20|
   12 0:55 12:18 13:35 23:230 1:15 30:-4 31:35|
   11 0:48 12:18 13:40 23:260 1:15 30:-4 31:0|
   10 0:43 12:18 13:45 23:300 1:15 30:-4 31:-35|
   14 0:91 1:-30 2:80 23:45 12:4 13:3 30:-8 31:-15|
   20 0:96 12:-48 13:45 1:60 14:1 15:9000 23:120 30:-9 31:-20|
   21 0:84 3:3 4:12 5:30 6:30 1:-90 23:70 30:-10 31:25|
   28 0:36 1:-90 3:3 4:0.12 5:60 14:2 15:260 16:55 17:65 18:150 24:1 21:1 23:180 30:-6 37:1"
  ) :
  k == 4 ? (   // FOUNDRY: ring-modulated, driven and crushed metal
  "0 0:33 12:36 13:45 23:500 8:20 9:0 10:900 20:60 19:1 29:45 30:-3|
   26 0:58 3:3 4:6 5:50 7:70 8:60 9:1 10:2400 11:40 19:2 20:45 23:260 14:4 15:1800 16:30|
   5 2:0 8:100 9:1 10:900 11:30 14:4 15:1000 16:40 25:3 23:380 19:2 20:30 31:-15|
   23 0:70 1:-100 3:3 4:11 5:60 7:90 23:140 14:3 15:1200 16:25 30:-8 31:20|
   7 1:-100 0:85 2:0 3:3 4:5.5 5:0 7:90 8:40 11:60 9:2 10:7000 14:3 15:6000 16:20 23:60 32:1 30:-8 19:2 20:35|
   9 1:-100 0:85 2:0 3:3 4:5.5 5:0 7:90 8:40 11:60 9:2 10:7000 14:3 15:6000 16:20 23:30 32:1 30:-10 19:2 20:35|
   24 0:76 3:0 4:15.2 5:0 6:80 23:900 30:-12 31:-30|
   23 0:60 1:-100 3:2 4:13 5:50 7:80 23:350 14:4 15:900 16:50 17:-40 18:300 30:-9 31:30|
   10 0:38 12:24 13:60 23:420 19:1 20:40 30:-4 31:-30|
   13 0:74 1:-80 2:55 3:3 4:7.2 5:55 14:4 15:1400 16:55 23:160 19:2 20:40 30:-9|
   25 2:0 8:100 9:2 10:3000 11:85 14:1 15:5000 17:-60 18:400 23:900 30:-14 26:8 27:40 28:2|
   26 0:96 3:3 4:31 5:70 7:70 23:60 19:2 20:70 30:-11 31:-25|
   28 0:31 1:70 3:2 4:-12 5:50 14:2 15:220 16:35 17:50 18:300 24:1 23:260 19:1 20:45 30:-6 37:1"
  ) :
  k == 5 ? (   // PIN DROP: minimal clicks, blips and short sines
  "0 0:36 12:24 13:18 23:260 29:40|
   27 0:88 2:40 8:50 9:1 10:3500 12:12 13:6 23:70 30:-6|
   21 0:96 12:-24 13:20 23:40 30:-10 31:-25|
   6 0:84 1:-40 2:70 23:25 30:-8 31:20|
   7 1:0 0:100 2:0 8:70 9:2 10:12000 14:3 15:9000 23:28 32:1 30:-11 31:30|
   8 1:0 0:100 2:0 8:70 9:2 10:12000 14:3 15:9000 23:260 32:1 30:-13 31:30|
   21 0:84 23:70 12:7 13:10 30:-8 31:30|
   21 0:79 23:80 12:7 13:10 30:-8 31:0|
   21 0:72 23:90 12:7 13:10 30:-8 31:-30|
   14 0:96 1:-60 2:70 23:30 30:-10 31:-10|
   15 2:0 8:80 9:1 10:6500 14:3 15:3000 21:12 23:90 30:-12 31:40 26:6 27:40 28:2|
   24 0:91 3:0 4:19 6:45 23:400 30:-13 31:-40|
   29 0:57 3:0 4:12 5:30 6:20 14:1 15:1800 17:40 18:120 24:1 21:2 23:300 30:-8"
  ) :
  k == 6 ? (   // TIN GARDEN: FM bells, mallets and hand percussion
  "0 0:38 12:20 13:35 23:380 8:6 9:1 10:1800|
   4 0:60 2:40 3:0 4:7 5:20 6:20 8:60 9:1 10:3000 14:4 15:2600 16:20 23:180|
   5 2:0 8:100 9:1 10:1600 14:4 15:1700 16:20 25:2 23:200 30:-4 31:15|
   14 0:93 1:-20 2:70 3:0 4:12 6:30 23:50 30:-6 31:-20|
   15 2:0 8:85 9:2 10:7000 14:4 15:7000 16:20 21:15 23:80 30:-10 31:25 26:7 27:30 28:2|
   15 2:0 8:85 9:2 10:5000 14:4 15:5000 16:20 21:30 23:240 30:-12 31:-25|
   17 0:66 3:0 4:12 6:25 12:5 13:12 23:200 30:-5 31:35|
   16 0:57 3:0 4:12 6:25 12:5 13:15 23:280 30:-4 31:10|
   16 0:50 3:0 4:12 6:25 12:5 13:15 23:320 30:-4 31:-35|
   24 0:84 3:0 4:15.8 6:55 23:1200 30:-12 31:-15|
   24 0:91 3:0 4:28 6:40 23:700 30:-12 31:20|
   22 0:79 3:0 4:19 6:70 23:160 30:-9 31:0|
   24 0:72 3:0 4:12 6:35 14:1 15:4000 17:30 18:300 24:1 21:3 23:900 30:-9"
  ) :
  k == 7 ? (   // GLASS LION: bright, airy, a filtered sub and wide hats
  "2 0:28 12:28 13:70 23:900 29:50|
   4 0:57 2:30 3:2 4:12 5:20 8:80 10:8000 9:2 14:3 15:900 16:20 23:240 31:-8|
   5 2:0 8:100 9:2 10:2500 14:4 15:2600 16:35 25:3 23:500 30:-3 31:12|
   27 0:100 2:30 8:90 9:2 10:14000 11:20 23:25 30:-9 31:-30|
   7 1:-100 0:96 2:0 3:3 4:9.3 5:0 7:85 8:70 9:2 10:14000 14:3 15:10000 16:20 23:45 32:1 30:-9 31:-25|
   8 1:-100 0:96 2:0 3:3 4:9.3 5:0 7:85 8:70 9:2 10:14000 14:3 15:9500 16:20 23:800 32:1 30:-10 31:25|
   24 0:95 3:0 4:7 6:25 23:1200 30:-14 31:40|
   24 0:88 3:0 4:19 6:30 23:1500 30:-13 31:-40|
   19 0:98 1:-100 3:3 4:13.3 5:0 7:75 8:50 9:2 10:12000 14:3 15:8000 23:1600 30:-14 31:40|
   20 0:91 12:-36 13:120 1:20 14:1 15:9000 16:30 23:200 30:-10|
   25 2:0 8:100 9:2 10:5000 14:4 15:3000 16:60 17:70 18:800 21:120 23:1200 30:-13 26:0.3 27:60 28:1|
   21 0:88 3:3 4:12 5:20 1:-60 23:60 30:-12 31:30|
   31 0:31 1:0 3:0 4:12 5:20 14:2 15:300 17:40 18:500 24:1 21:4 23:400 30:-4"
  ) :
  k == 8 ? (   // BROKEN CLOCK: glitches, crushed noise, ticks and a gritty bass
  "1 0:34 12:48 13:20 23:300 19:2 20:35 29:40|
   26 0:62 2:60 8:80 9:2 10:5000 11:70 19:2 20:55 23:150 14:1 15:6000|
   27 2:0 8:100 9:1 10:2000 11:90 25:2 23:160 19:2 20:60 31:-20|
   6 0:96 1:-100 2:60 23:12 19:2 20:80 30:-9 31:20|
   7 1:-100 0:100 2:0 3:3 4:3 7:90 8:30 11:80 9:2 10:9000 14:3 15:8000 23:30 32:1 30:-10 19:2 20:50 31:30|
   8 1:-100 0:100 2:0 3:3 4:3 7:90 8:30 11:80 9:2 10:9000 14:3 15:8000 23:300 32:1 30:-12 19:2 20:50 31:30|
   21 0:100 12:-48 13:8 23:30 19:2 20:85 30:-11 31:30|
   20 0:80 12:30 13:10 23:60 19:2 20:70 30:-9 31:0|
   20 0:72 12:-30 13:15 23:80 19:2 20:70 30:-9 31:-30|
   14 0:96 1:-100 2:60 23:20 26:13 27:80 28:0 30:-11 31:-15|
   25 2:0 8:100 9:0 10:900 11:100 23:600 19:2 20:80 14:4 15:1500 16:60 26:3 27:90 28:1 30:-12|
   26 0:84 3:3 4:7 5:60 6:70 7:50 23:90 19:2 20:75 30:-11|
