// ---------- DRONE / CHORD ----------
pk_inset(712 * sc, 188 * sc, 368 * sc, 112 * sc, SHC);
tg_key(720, 193, 58, 22, slider38 >= 0.5, "DRONE") ? tg_set(38, slider38 >= 0.5 ? 0 : 1);
tg_key(782, 193, 84, 22, slider91 >= 0.5, "TRANSPORT") ? tg_set(91, slider91 >= 0.5 ? 0 : 1);
tg_key(870, 193, 62, 22, slider42 >= 0.5, "FOLLOW") ? tg_set(42, slider42 >= 0.5 ? 0 : 1);
// VOICING: a drop-down (CLOSE, SPREAD, WIDE)
tg_dfield(938, 193, 74, 22, 41, 0, 2, pk_pitem("CLOSE|SPREAD|WIDE", floor(slider41 + 0.5) + 1, #tg_k), "Close|Spread|Wide", 0);
// the register: a drop-down
sprintf(#tg_g, "OCT %d", floor(slider43 + 0.5));
tg_dfield(1018, 193, 54, 22, 43, 1, 5, #tg_g, "Octave 1|Octave 2|Octave 3|Octave 4|Octave 5", 0);
// ROOT (with FOLLOW on, the key lit is the root the last note played chose)
tg_rt = slider42 >= 0.5 && slider38 >= 0.5 ? tw_droot : floor(slider39 + 0.5);
tg_i = 0;
loop(12,
  tg_key(720 + tg_i * 29.5, 220, 27, 22, tg_rt == tg_i, pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", tg_i + 1, #tg_k)) ? tg_set(39, tg_i);
  tg_i += 1;
);
// CHORD
tg_i = 0;
loop(10,
  tg_key(720 + (tg_i % 5) * 71, 247 + floor(tg_i / 5) * 26, 68, 22, floor(slider40 + 0.5) == tg_i,
         pk_pitem("5TH|SUS2|SUS4|MAJ|MIN|MAJ7|MIN7|ADD9|QUARTAL|OPEN", tg_i + 1, #tg_k)) ? tg_set(40, tg_i);
  tg_i += 1;
);

// ---------- LAYERS: BASS and PEDAL (with the card's emblem between them) ----------
tg_emblem(496, 431, 108, 106, 0);
k_ = 0;
loop(2,
  tg_x = k_ ? 618 : 20; tg_b = k_ ? 80 : 69; tg_q = k_ ? TLP : TLB;
  tg_sect(tg_x, 428, 462, 112, k_ ? SHA : SHB, k_ ? "PEDAL LAYER" : "BASS LAYER");
  ui_col(INK); gfx_circle((tg_x + (k_ ? 116 : 104)) * sc, 438 * sc, 6 * sc, 1, 1); ui_col(k_ ? PEDC : BASSC); gfx_circle((tg_x + (k_ ? 116 : 104)) * sc, 438 * sc, 4.6 * sc, 1, 1);
  // the note it sounds now
  slider(tg_b) >= 0.5 && tg_q[12] ? ( gfx_setfont(12); ui_col(INK); sprintf(#tg_g, "NOTE  %s", tg_nname(floor(tg_q[14] + 0.5))); tg_t(tg_x + 372, 431, #tg_g); );
  tg_key(tg_x + 8, 454, 42, 22, slider(tg_b) >= 0.5, "ON") ? tg_set(tg_b, slider(tg_b) >= 0.5 ? 0 : 1);
  gfx_setfont(11); ui_col(LBL); tg_t(tg_x + 56, 459, "OCT");
  tg_i = 0;
  loop(7,
    tg_key(tg_x + 84 + tg_i * 28, 454, 26, 22, floor(slider(tg_b + 1) + 0.5) == tg_i - 3, pk_pitem("-3|-2|-1|0|+1|+2|+3", tg_i + 1, #tg_k)) ? tg_set(tg_b + 1, tg_i - 3);
    tg_i += 1;
  );
  tg_keys(tg_x + 292, 454, 50, 22, 3, tg_b + 4, 3, "SAW|PULSE|CHOIR");
  tg_knob(tg_x + 34,  506, 14, tg_b + 2, -12, 12, 0, 0, "SEMI", "%+.0f st", 1);
  tg_knob(tg_x + 88,  506, 14, tg_b + 3, 0, 100, k_ ? 45 : 60, 0, "LEVEL", "%.0f%%", 0);
  tg_knob(tg_x + 142, 506, 14, tg_b + 5, 60, 12000, k_ ? 5000 : 800, 1, "TONE", "%.0f Hz", 0);
  tg_knob(tg_x + 196, 506, 14, tg_b + 8, 0, 100, k_ ? 60 : 30, 0, "MOTION", "%.0f%%", 0);
  tg_knob(tg_x + 250, 506, 14, tg_b + 9, 10, 10000, k_ ? 1500 : 1200, 1, "ATTACK", "%.0f ms", 0);
  tg_knob(tg_x + 304, 506, 14, tg_b + 10, 10, 10000, k_ ? 3000 : 2500, 1, "RELEASE", "%.0f ms", 0);
  gfx_setfont(11); ui_col(LBL); tg_tc(tg_x + 393, 488, "PLAYS");
  k_ ? (
    tg_keys(tg_x + 332, 499, 39, 22, 2.5, 44, 3, "ROOT|5TH|OCT");
  ) : (
    ui_col(INK); tg_rr(tg_x + 332, 499, 122, 22, 3); ui_col(0x8E8A82); tg_rr(tg_x + 333.5, 500.5, 119, 19, 2);
    gfx_setfont(11); ui_col(INK); tg_tc(tg_x + 393, 510, "LOWEST NOTE");
  );
  k_ += 1;
);

