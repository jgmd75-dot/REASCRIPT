k_ = 0;
loop(2,
  tg_x = k_ ? 903 : 720; tg_b = k_ ? 24 : 19;
  tg_i = 0;
  loop(5,
    tg_key(tg_x + tg_i * 25, 91, 23, 22, floor(slider(tg_b) + 0.5) == tg_i, "") ? tg_set(tg_b, tg_i);
    tg_glyph(tg_x + tg_i * 25 + 11.5, 102, tg_i, floor(slider(tg_b) + 0.5) == tg_i ? INK : LBL);
    tg_i += 1;
  );
  tg_key(tg_x + 128, 91, 40, 22, slider(tg_b + 2) >= 0.5, "SYNC") ? tg_set(tg_b + 2, slider(tg_b + 2) >= 0.5 ? 0 : 1);
  tg_cx = k_ ? 966 : 752;
  slider(tg_b + 2) >= 0.5 ? (
    strcpy(#tg_vs, pk_pitem("8 bars|4 bars|2 bars|1 bar|1/2|1/2T|1/4|1/4T|1/8|1/8T|1/16|1/16T", floor(slider(tg_b + 3) + 0.5) + 1, #tg_k));
    tg_knob(tg_cx, 145, 14, tg_b + 3, 0, 11, 3, 0, "RATE", "", 1);
  ) : tg_knob(tg_cx, 145, 14, tg_b + 1, 0.01, 20, 0.2, 1, "RATE", "%.2f Hz", 0);
  tg_knob(tg_cx + 68, 145, 14, tg_b + 4, 0, 100, 35, 0, "DEPTH", "%.0f%%", 0);
  k_ += 1;
);
