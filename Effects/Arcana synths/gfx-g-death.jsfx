desc:Death [Arcana synth] (GFX)
//tags: instrument synth poly formant vowel choir xy lfo arcana
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-voice (.jsfx-inc) in the same folder.
//
// DEATH (card XIII of the GFX Arcana series): not a literal death but transformation - the ending that clears the
// ground for what comes next. The pale rider carries a black banner with the white mystic rose, and behind him the sun
// rises between two towers across the river. A polysynth whose heart is a QUADRANT FORMANT FILTER: an XY pad
// with a formant set in each corner, the point flown around by two LFOs; a BASS and a PEDAL layer and a DRONE that
// plays a chosen chord by itself.
//   OSC 1 / 2  SAW, PULSE (PW) or CHOIR (a buzzy five-saw stack, SPREAD); OSC 2 PITCH and DETUNE; MIX, SUB (one
//              octave below OSC 1), NOISE
//   FORMANT    per voice: five parallel resonant band-passes (zero-delay state-variable, unity peak gain); the four
//              corners each hold a formant set (A, E, I, O, U, STONE dark, GLASS bright, STORM nasal, CHOIR), every
//              peak with its frequency, bandwidth and gain. The XY point morphs them bilinearly - frequencies and
//              bandwidths in log-frequency, gains in dB. RESONANCE scales every Q (0.5x - 4x), SHIFT moves all the
//              peaks (+/-12 st), DEPTH mixes the formants against the raw oscillators.
//              Per voice rather than on the sum: every note gets its own velocity and envelope offsets on the pad,
//              and chords stay clean (no intermodulation through one shared resonant bank). Cost: 40 band-passes at
//              8 voices, their coefficients worked out every 8 samples.
//   LFO X / Y  sine, triangle, saw, S&H, smooth random; RATE free or synced; DEPTH; PHASE between them.
//              PATH: FREE (the two LFOs as set), CIRCLE (Y follows X at the PHASE offset: circles and ellipses,
//              diamonds with the triangle), FIGURE-8 (Y at twice X; PHASE 90 draws the 8), SPIRAL (a circle that breathes in and out over
//              eight turns), WALK (a smooth random walk). Drag the pad to move the centre the LFOs orbit.
//   MOD        mod WHEEL and VELOCITY to X and Y; a formant ENVELOPE (attack / decay) to Y
//   LAYERS     BASS (low) and PEDAL (high): two mono drone voices beside the main voice. Each: ON, TRANSPOSE
//              (octave -3..+3 and semitone -12..+12), LEVEL, its own wave, TONE (12 dB low-pass), its own place on the
//              formant pad (X / Y, drag its dot; MOTION = how much of the LFOs' orbit it shares) and a slow ATTACK /
//              RELEASE swell. BASS sounds the lowest held (or drone) note, PEDAL the root - or its 5TH or OCTAVE -
//              transposed; both hold while notes are held, and always in DRONE mode.
//   DRONE      Death plays by itself: ROOT (C..B, OCTAVE), CHORD (5TH, SUS2, SUS4, MAJ, MIN, MAJ7, MIN7, ADD9,
//              QUARTAL, OPEN), VOICING (CLOSE, SPREAD, WIDE: a drop-down); the XY LFOs keep it moving. Played notes take over
//              while held (the drone swells out and back), or with FOLLOW the last note played becomes the root.
//              Chord changes glide the voices; the drone swells in and out (no clicks). DRONE loads off and presets
//              never switch it on. TRANSPORT (lit by default): REAPER's play / record switches DRONE on and its stop
//              switches it off; DRONE still works by hand. Off, DRONE ignores the transport.
//   AMP        ADSR, VELOCITY; POLY (8 voices) / MONO / LEGATO, GLIDE, BEND range
//   EFFECTS    DRIVE (a biased soft clip that wears into grit at the top), stereo ping-pong
//              DELAY (tempo divisions), a big eight-line REVERB (SIZE, TONE, MIX)
//   MASTER     FATE, VOLUME, SAT (the output soft clip is always on)
// FATE (the Arcana series drift, 0-100 %): the cards reshuffle a little - the LFO rates, the phase between them and
//   their depths wander, each corner's formant set slides a little in frequency, the pad centre drifts, the drone's
//   voicing turns over now and then (an inner tone moves an octave); the tuning wanders gently and each note lands
//   slightly differently in tune.
// MIDI: pitch bend (BEND range), CC1 mod wheel, CC64 sustain, CC120 / CC123 all notes off.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc

// ---------- OSCILLATORS ----------
slider1:2<0,2,1{Saw,Pulse,Choir}>-Osc 1 wave
slider2:0<0,2,1{Saw,Pulse,Choir}>-Osc 2 wave
slider3:0<-24,24,1>-Osc 2 pitch (st)
slider4:7<-50,50,0.1>-Osc 2 detune (cents)
slider5:40<0,100,1>-Osc mix (1 <> 2, %)
slider6:50<5,95,1>-Pulse width (%)
slider7:22<0,60,0.1>-Choir spread (cents)
slider8:20<0,100,1>-Sub (%)
slider9:4<0,100,1>-Noise (%)
// ---------- FORMANT ----------
slider10:0<0,8,1{A,E,I,O,U,Stone,Glass,Storm,Choir}>-Corner top left
slider11:3<0,8,1{A,E,I,O,U,Stone,Glass,Storm,Choir}>-Corner top right
slider12:2<0,8,1{A,E,I,O,U,Stone,Glass,Storm,Choir}>-Corner bottom left
slider13:4<0,8,1{A,E,I,O,U,Stone,Glass,Storm,Choir}>-Corner bottom right
slider14:50<0,100,0.1>-Pad X (%)
slider15:50<0,100,0.1>-Pad Y (%)
slider16:40<0,100,1>-Resonance (%)
slider17:90<0,100,1>-Formant depth (%)
slider18:0<-12,12,0.1>-Formant shift (st)
// ---------- LFO X / Y ----------
slider19:0<0,4,1{Sine,Triangle,Saw,S&H,Smooth}>-LFO X shape
slider20:0.2<0.01,20,0.01>-LFO X rate (Hz)
slider21:0<0,1,1{Free,Sync}>-LFO X sync
slider22:3<0,11,1{8 bars,4 bars,2 bars,1 bar,1/2,1/2T,1/4,1/4T,1/8,1/8T,1/16,1/16T}>-LFO X synced rate
slider23:35<0,100,1>-LFO X depth (%)
slider24:0<0,4,1{Sine,Triangle,Saw,S&H,Smooth}>-LFO Y shape
slider25:0.2<0.01,20,0.01>-LFO Y rate (Hz)
slider26:0<0,1,1{Free,Sync}>-LFO Y sync
slider27:3<0,11,1{8 bars,4 bars,2 bars,1 bar,1/2,1/2T,1/4,1/4T,1/8,1/8T,1/16,1/16T}>-LFO Y synced rate
slider28:35<0,100,1>-LFO Y depth (%)
slider29:90<0,360,1>-LFO phase (degrees)
slider30:1<0,4,1{Free,Circle,Figure-8,Spiral,Walk}>-Path
// ---------- MOD ----------
slider31:0<-100,100,1>-Wheel to X (%)
slider32:40<-100,100,1>-Wheel to Y (%)
slider33:0<-100,100,1>-Velocity to X (%)
slider34:15<-100,100,1>-Velocity to Y (%)
slider35:0<-100,100,1>-Envelope to Y (%)
slider36:10<1,5000,0.1>-Envelope attack (ms)
slider37:600<10,8000,1>-Envelope decay (ms)
// ---------- DRONE / CHORD ----------
slider38:0<0,1,1{Off,On}>-Drone
slider39:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Drone root
slider40:0<0,9,1{5th,Sus2,Sus4,Maj,Min,Maj7,Min7,Add9,Quartal,Open}>-Drone chord
slider41:1<0,2,1{Close,Spread,Wide}>-Drone voicing
slider42:0<0,1,1{Off,On}>-Drone follow
slider43:3<1,5,1>-Drone octave
slider44:0<0,2,1{Root,5th,Octave}>-Pedal note
// ---------- VOICE / AMP ----------
slider45:0<0,2,1{Poly,Mono,Legato}>-Voice mode
slider46:0<0,2000,1>-Glide (ms)
slider47:2<0,24,1>-Pitch bend range (st)
slider48:30<1,5000,0.1>-Amp attack (ms)
slider49:800<5,8000,1>-Amp decay (ms)
slider50:85<0,100,1>-Amp sustain (%)
slider51:600<5,10000,1>-Amp release (ms)
slider52:40<0,100,1>-Amp velocity (%)
// ---------- EFFECTS ----------
slider53:10<0,100,1>-Drive (%)
slider54:2<0,7,1{1/2,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16}>-Delay time
slider55:30<0,90,1>-Delay feedback (%)
slider56:12<0,100,1>-Delay mix (%)
slider57:60<0,100,1>-Reverb size (%)
slider58:55<0,100,1>-Reverb tone (%)
slider59:25<0,100,1>-Reverb mix (%)
// ---------- MASTER ----------
slider60:35<0,100,1>-Fate (%)
slider61:0<-24,6,0.1>-Volume (dB)
slider62:0<0,16,1>-MIDI channel (0 = omni)
slider63:0<0,100,1>-Band sat (%)
slider64:30<0,100,1>-Bias (%)
slider65:120<40,400,1>-Sat low band (Hz)
slider66:6000<2000,16000,10>-Sat high band (Hz)
slider67:-0.3<-24,0,0.1>-Ceiling (dB)
slider68:1<0,1,1{Off,Clip}>-(unused, was output stage)
// ---------- LAYERS: BASS and PEDAL ----------
slider69:0<0,1,1{Off,On}>-Bass layer
slider70:-2<-3,3,1>-Bass octave
slider71:0<-12,12,1>-Bass semitone
slider72:60<0,100,1>-Bass level (%)
slider73:0<0,2,1{Saw,Pulse,Choir}>-Bass wave
slider74:800<60,12000,1>-Bass tone (Hz)
slider75:80<0,100,0.1>-Bass pad X (%)
slider76:15<0,100,0.1>-Bass pad Y (%)
slider77:30<0,100,1>-Bass motion (%)
slider78:1200<10,10000,1>-Bass attack (ms)
slider79:2500<10,10000,1>-Bass release (ms)
slider80:0<0,1,1{Off,On}>-Pedal layer
slider81:2<-3,3,1>-Pedal octave
slider82:0<-12,12,1>-Pedal semitone
slider83:45<0,100,1>-Pedal level (%)
slider84:2<0,2,1{Saw,Pulse,Choir}>-Pedal wave
slider85:5000<60,12000,1>-Pedal tone (Hz)
slider86:50<0,100,0.1>-Pedal pad X (%)
slider87:85<0,100,0.1>-Pedal pad Y (%)
slider88:60<0,100,1>-Pedal motion (%)
slider89:1500<10,10000,1>-Pedal attack (ms)
slider90:3000<10,10000,1>-Pedal release (ms)
slider91:1<0,1,1{Off,On}>-Transport (follows REAPER play state)
slider92:prs_sel=0<0,14,1{No preset,Mystic Rose,Pedal Point,Pale Rider,Last Rites,Sunrise,Stone Throat,Monastery,Transformation,The River,Revelation,Bone Desert,Dark Choir,Reaper Bass,New Dawn}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-death";                                   // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();   // 20000 - 24095
TV   = 30000;                                              // 8 voices x 64 slots
THN  = 30600;                                              // mono held-note stack (128)
TQO  = 30800; TQT = 31100; TQN = 31400; TQV = 31700;       // note event queue (300 each)
TDEF = 32100;                                              // the Init values of sliders 1-68
TTMP = 32200;                                              // preset parser scratch (400)
TFS  = 32700;                                              // formant sets: 9 x 5 peaks x (Hz, bandwidth Hz, dB)
TCT  = 32900;                                              // the four corners: 5 peaks x (ln Hz, ln Q, dB)
TDN  = 33120; TDV = 33130;                                 // drone: target notes (8), their voices (8)
TLB  = 34200; TLP = 34250;                                 // layer parameter blocks (BASS, PEDAL; 50 each)
TGC  = 33100;                                              // shared formant coefficients (20) when no voice has its own point
TRLT = 33020; TRG = 33050;                                 // reverb: line lengths, gains
TAPL = 33070;                                              // reverb input allpasses: lengths
TGX  = 33200; TGY = 33300;                                 // GUI: the point's trail (64 each)
TGPX = 33400; TGPY = 33800;                                // GUI: the LFO path (400 each)
TRV  = 40000; TRVN = 16384;                                // reverb lines 8 x 16384  (40000 - 171071)
TAP  = 172000; TAPN = 4096;                                // 4 allpass rings x 4096 (172000 - 188383)
TDL  = 200000; TDR = 200000 + 524288; TDM = 524287;        // delay lines (2^19 each)
memset(TV, 0, 600); memset(TDV, -1, 8); memset(TLB, 0, 100);
tw_i = 0; loop(8, TV[tw_i * 64] = -1; tw_i += 1; );
memset(TRV, 0, 8 * TRVN); memset(TAP, 0, 4 * TAPN);
memset(TDL, 0, 524288 * 2);

// voice slots (p = TV + 64 * voice):
//   0 note (-1 free)  1 key held  2 age  3 held by pedal  4 pitch now (st)  5 pitch target  6 velocity 0..1
//   7 note detune (st)  8 amp stage (0 idle, 1 att, 2 dec / sus, 3 rel)  9 amp level  10 formant env stage  11 its level
//   35-54 its own formant coefficients (5 x a1, a2, a3, gain)  55 voice gain  56 / 57 pan gains L / R
//   58 needs its control values now  63 a drone voice  62 fresh (its namespace resets phases and band-passes)
//   (the phases and the band-pass states live in the voice's namespace, tw_v0 - tw_v7: see tw_vproc)

L12 = log(2) / 12; LN2 = log(2);

// ---------- formant sets: each peak Hz, bandwidth Hz, gain dB (vowels from the classic tenor tables) ----------
function tw_fset(s, f1, b1, g1, f2, b2, g2, f3, b3, g3, f4, b4, g4, f5, b5, g5) local(p) (
  p = TFS + s * 15;
  p[0] = f1; p[1] = b1; p[2] = g1;   p[3] = f2; p[4] = b2; p[5] = g2;   p[6] = f3; p[7] = b3; p[8] = g3;
  p[9] = f4; p[10] = b4; p[11] = g4; p[12] = f5; p[13] = b5; p[14] = g5;
);
tw_fset(0, 650, 80, 0,  1080, 90, -6,   2650, 120, -7,  2900, 130, -8,  3250, 140, -22);   // A
tw_fset(1, 400, 70, 0,  1700, 80, -14,  2600, 100, -12, 3200, 120, -14, 3580, 120, -20);   // E
tw_fset(2, 290, 40, 0,  1870, 90, -15,  2800, 100, -18, 3250, 120, -20, 3540, 120, -30);   // I
tw_fset(3, 400, 40, 0,  800,  80, -10,  2600, 100, -12, 2800, 120, -12, 3000, 120, -26);   // O
tw_fset(4, 350, 40, 0,  600,  60, -20,  2700, 100, -17, 2900, 120, -14, 3300, 120, -26);   // U
tw_fset(5, 220, 60, 0,  480,  80, -3,   850,  110, -9,  1500, 160, -18, 2400, 220, -26);   // STONE: dark, low, chesty
tw_fset(6, 1100, 110, -10, 2300, 90, -2, 3400, 100, 0,  5000, 140, -5,  7200, 200, -9);    // GLASS: bright, high
tw_fset(7, 270, 45, 0,  1000, 60, -4,   2100, 70, -7,   2900, 80, -9,   4200, 110, -15);   // STORM: narrow, nasal
tw_fset(8, 620, 70, 0,  1050, 80, -6,   2350, 110, -12, 2950, 100, -4,  3500, 130, -14);   // CHOIR: open, singer's ring

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#tw_def = "2 0 0 7 40 50 22 20 4 0 3 2 4 50 50 40 90 0 0 0.2 0 3 35 0 0.2 0 3 35 90 1 0 40 0 15 0 10 600 0 0 0 1 0 3 0 0 0 2 30 800 85 600 40 10 2 30 12 60 55 25 35 0 0 0 30 120 6000 -0.3 1 0 -2 0 60 0 800 80 15 30 1200 2500 0 2 0 45 2 5000 50 85 60 1500 3000";

function tw_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function tw_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
tw_nums(#tw_def, TDEF);

#tw_pm = "Mystic Rose|Pedal Point|Pale Rider|Last Rites|Sunrise|Stone Throat|Monastery|Transformation|The River|Revelation|Bone Desert|Dark Choir|Reaper Bass|New Dawn";
function tw_pstr(p) (
  p == 2  ? "1:2 2:0 3:12 5:30 16:45 80:1 81:2 44:1 83:40 84:2 86:30 87:90 88:70 69:1 70:-1 72:45 73:0 74:500 75:85 76:20 57:75 59:35 54:4 56:15" :
  p == 3  ? "38:1 39:0 40:0 41:0 43:2 1:0 2:0 3:-12 4:6 5:50 8:40 10:5 11:3 12:5 13:4 30:4 20:0.07 25:0.05 23:55 28:55 16:70 18:-2 69:1 70:-1 71:0 72:70 73:0 74:400 75:70 76:10 77:20 53:30 57:95 58:35 59:45" :
  p == 4  ? "1:2 2:2 3:-12 4:-5 7:30 5:45 10:7 11:0 12:7 13:3 30:2 20:0.35 23:50 28:40 16:70 35:40 36:80 37:1200 34:30 57:75 59:40 56:15 54:2" :
  p == 5  ? "1:1 2:0 3:12 5:35 6:30 10:6 11:2 12:1 13:6 18:5 30:3 20:0.6 23:70 28:70 16:60 54:5 55:45 56:22 57:80 58:85 59:40 51:1800 8:0 61:1.5" :
  p == 6  ? "45:2 46:90 1:0 2:1 3:-12 5:40 8:60 10:5 11:3 12:4 13:0 14:30 15:30 23:15 28:15 32:70 34:40 35:50 36:5 37:400 16:75 53:35 59:15 48:3 49:500 50:75 51:250 52:60 61:2" :
  p == 7  ? "38:1 39:9 40:9 41:0 43:3 1:2 2:2 3:12 4:-4 7:30 5:40 10:3 11:4 12:0 13:8 30:1 20:0.07 23:40 28:30 16:50 80:1 81:1 44:0 83:35 84:2 86:20 87:80 69:1 70:-1 72:50 74:600 48:900 51:4000 57:95 58:50 59:55" :
  p == 8  ? "38:1 39:5 40:8 41:2 43:3 1:2 2:2 3:7 4:12 7:45 5:50 10:0 11:2 12:4 13:1 30:0 20:0.3 25:0.2 29:0 23:80 28:80 16:50 57:90 59:55 54:1 56:20 55:40 48:600 49:3000 50:90 51:3000 69:1 80:1 44:2 83:35" :
  p == 9  ? "38:1 39:2 40:0 41:0 43:3 1:0 2:0 3:-12 4:9 5:50 8:40 9:15 10:5 11:7 12:4 13:8 30:3 20:0.08 23:80 28:80 16:85 57:100 58:40 59:50 48:2500 49:5000 50:100 51:6000 69:1 70:-2 80:1 81:2 44:1" :
  p == 10 ? "1:2 2:2 3:12 4:-6 7:28 5:35 10:4 11:0 12:3 13:8 15:20 35:60 36:2500 37:6000 20:0.12 23:30 28:30 16:45 57:85 58:70 59:45 48:900 49:4000 50:90 51:3500" :
  p == 11 ? "38:1 39:4 40:2 41:1 42:1 43:3 1:1 2:1 3:7 6:35 5:40 10:6 11:0 12:7 13:1 30:2 20:0.15 23:45 28:40 16:60 54:1 55:40 56:25 59:30 80:1 81:2 44:1 84:1 83:35 69:1 70:-2 73:0 72:55" :
  p == 12 ? "38:1 39:11 40:4 41:1 43:3 1:2 2:2 3:-12 7:26 5:40 8:30 10:3 11:4 12:5 13:8 18:-4 30:4 20:0.2 25:0.15 23:40 28:40 16:55 57:90 58:35 59:50 48:700 49:4000 50:95 51:4000 32:60 69:1 70:-2 72:50" :
  p == 13 ? "45:1 46:25 1:0 2:1 3:-12 5:35 6:35 8:80 10:5 11:0 12:4 13:3 14:20 15:40 23:10 28:10 35:70 36:2 37:250 34:40 16:65 53:55 48:1 49:600 50:70 51:180 52:60 56:0 59:10 69:1 70:-1 72:55 73:0 74:300 78:40 79:300 61:1" :
  p == 14 ? "38:1 39:7 40:7 41:1 42:1 43:3 1:2 2:0 3:12 4:5 5:30 16:60 21:1 22:2 26:1 27:2 23:40 28:40 57:80 59:45 54:0 55:45 56:18 48:400 49:3000 50:90 51:3000 80:1 81:2 44:0 83:40" :
  "";
);
function tw_pstr_au(p) (
  p == 2  ? "1:2 2:0 3:12 5:30 16:45 80:1 81:2 44:1 83:40 84:2 86:30 87:90 88:70 69:1 70:-1 72:45 73:0 74:500 75:85 76:20 57:75 59:35 54:4 56:15" :
  p == 3  ? "38:1 39:0 40:0 41:0 43:2 1:0 2:0 3:-12 4:6 5:50 8:40 10:5 11:3 12:5 13:4 30:4 20:0.07 25:0.05 23:55 28:55 16:70 18:-2 69:1 70:-1 71:0 72:70 73:0 74:400 75:70 76:10 77:20 53:30 57:95 58:35 59:45" :
  p == 4  ? "1:2 2:2 3:-12 4:-5 7:30 5:45 10:7 11:0 12:7 13:3 30:2 20:0.35 23:50 28:40 16:70 35:40 36:80 37:1200 34:30 57:75 59:40 56:15 54:2" :
  p == 5  ? "1:1 2:0 3:12 5:35 6:30 10:6 11:2 12:1 13:6 18:5 30:3 20:0.6 23:70 28:70 16:60 54:5 55:45 56:22 57:80 58:85 59:40 51:1800 8:0 61:1.5" :
  p == 6  ? "45:2 46:90 1:0 2:1 3:-12 5:40 8:60 10:5 11:3 12:4 13:0 14:30 15:30 23:15 28:15 32:70 34:40 35:50 36:5 37:400 16:75 53:35 59:15 48:3 49:500 50:75 51:250 52:60 61:2" :
  p == 7  ? "38:1 39:9 40:9 41:0 43:3 1:2 2:2 3:12 4:-4 7:30 5:40 10:3 11:4 12:0 13:8 30:1 20:0.07 23:40 28:30 16:50 80:1 81:1 44:0 83:35 84:2 86:20 87:80 69:1 70:-1 72:50 74:600 48:900 51:4000 57:95 58:50 59:55" :
  p == 8  ? "38:1 39:5 40:8 41:2 43:3 1:2 2:2 3:7 4:12 7:45 5:50 10:0 11:2 12:4 13:1 30:0 20:0.3 25:0.2 29:0 23:80 28:80 16:50 57:90 59:55 54:1 56:20 55:40 48:600 49:3000 50:90 51:3000 69:1 80:1 44:2 83:35" :
  p == 9  ? "38:1 39:2 40:0 41:0 43:3 1:0 2:0 3:-12 4:9 5:50 8:40 9:15 10:5 11:7 12:4 13:8 30:3 20:0.08 23:80 28:80 16:85 57:100 58:40 59:50 48:2500 49:5000 50:100 51:6000 69:1 70:-2 80:1 81:2 44:1" :
  p == 10 ? "1:2 2:2 3:12 4:-6 7:28 5:35 10:4 11:0 12:3 13:8 15:20 35:60 36:2500 37:6000 20:0.12 23:30 28:30 16:45 57:85 58:70 59:45 48:900 49:4000 50:90 51:3500" :
  p == 11 ? "38:1 39:4 40:2 41:1 42:1 43:3 1:1 2:1 3:7 6:35 5:40 10:6 11:0 12:7 13:1 30:2 20:0.15 23:45 28:40 16:60 54:1 55:40 56:25 59:30 80:1 81:2 44:1 84:1 83:35 69:1 70:-2 73:0 72:55" :
  p == 12 ? "38:1 39:11 40:4 41:1 43:3 1:2 2:2 3:-12 7:26 5:40 8:30 10:3 11:4 12:5 13:8 18:-4 30:4 20:0.2 25:0.15 23:40 28:40 16:55 57:90 58:35 59:50 48:700 49:4000 50:95 51:4000 32:60 69:1 70:-2 72:50" :
  p == 13 ? "45:1 46:25 1:0 2:1 3:-12 5:35 6:35 8:80 10:5 11:0 12:4 13:3 14:20 15:40 23:10 28:10 35:70 36:2 37:250 34:40 16:65 53:55 48:1 49:600 50:70 51:180 52:60 56:0 59:10 69:1 70:-1 72:55 73:0 74:300 78:40 79:300 61:1" :
  p == 14 ? "38:1 39:7 40:7 41:1 42:1 43:3 1:2 2:0 3:12 4:5 5:30 16:60 21:1 22:2 26:1 27:2 23:40 28:40 57:80 59:45 54:0 55:45 56:18 48:400 49:3000 50:90 51:3000 80:1 81:2 44:0 83:40" :
  "";
);
function load_preset(p) local(n, i) (
  // DRONE (on / off), TRANSPORT, FATE, the MIDI channel, SAT and the output stage stay (a preset never starts the drone;
  // the presets' own "38:1" is passed over - their ROOT, CHORD, VOICING and OCTAVE for it still load)
  i = 0; loop(90, i != 59 && i != 37 && (i < 61 || i > 67) ? slider(i + 1) = TDEF[i]; i += 1; );
  n = tw_nums(tw_pstr(p), TTMP);
  i = 0; loop(floor(n / 2), TTMP[i * 2] >= 1 && TTMP[i * 2] <= 90 && TTMP[i * 2] != 38 ? slider(TTMP[i * 2]) = TTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(90, ui_auto(i); i += 1; );
  pr_cur = p; tw_panic = 1;
);
function load_preset_au(p) local(n, i) (
  // DRONE (on / off), TRANSPORT, FATE, the MIDI channel, SAT and the output stage stay (a preset never starts the drone;
  // the presets' own "38:1" is passed over - their ROOT, CHORD, VOICING and OCTAVE for it still load)
  i = 0; loop(90, i != 59 && i != 37 && (i < 61 || i > 67) ? slider(i + 1) = TDEF[i]; i += 1; );
  n = tw_nums_au(tw_pstr_au(p), TTMP);
  i = 0; loop(floor(n / 2), TTMP[i * 2] >= 1 && TTMP[i * 2] <= 90 && TTMP[i * 2] != 38 ? slider(TTMP[i * 2]) = TTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(90, ui_auto(i); i += 1; );
  pr_cur = p; tw_panic = 1;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(90, slider(i + 1) = TDEF[i]; ui_auto(i + 1); i += 1; );
  slider91 = 1; ui_auto(91);
);

// ---------- voices ----------
function tw_vrel(p) ( p[1] = 0; p[3] = 0; p[8] > 0 ? p[8] = 3; );
function tw_vstart(p, n, v, retrig, from) local(i) (
  p[8] == 0 ? (
    // a fresh voice: random phases (chords and the choir saws never line up), clean filters
    p[62] = 1; p[9] = 0; p[11] = 0;
    p[4] = from;                                       // GLIDE comes in from the last note played
  );
  tw_gc >= 1 ? p[4] = n;
  p[0] = n; p[1] = 1; p[3] = 0; p[5] = n; p[6] = v / 127; p[63] = 0;
  retrig || p[8] == 0 || p[8] == 3 ? (
    p[7] = log(ins_note_detune()) / LN2 * 12;
    p[8] = 1; p[10] = 1;
  );
  p[55] = (1 - tw_avel + tw_avel * p[6]) * 0.62;
  i = ((p - TV) / 64) & 1 ? 0.22 : -0.22;                // the voices stand a little apart, left and right
  p[56] = 1 - max(i, 0); p[57] = 1 + min(i, 0);
  p[58] = 1;
);
function tw_alloc() local(i, p, best, ba) (
  best = -1;
  i = 0; loop(8, p = TV + i * 64; p[8] == 0 && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; );
  best < 0 ? ( i = 0; loop(8, p = TV + i * 64; !p[1] && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; ); );
  best < 0 ? ( i = 0; loop(8, p = TV + i * 64; best < 0 || p[2] < ba ? ( best = i; ba = p[2]; ); i += 1; ); );
  TV + best * 64;
);
function tw_poly_on(n, v) local(i, p, from) (
  i = 0; loop(8, p = TV + i * 64; p[0] == n && p[1] && !p[63] ? tw_vrel(p); i += 1; );
  from = tw_last >= 0 && tw_glide > 0 ? tw_last : n;
  p = tw_alloc(); tw_age += 1; p[2] = tw_age;
  tw_vstart(p, n, v, 1, from);
);
function tw_poly_off(n) local(i, p) (
  i = 0; loop(8, p = TV + i * 64; p[0] == n && p[1] && !p[63] ? ( tw_pedal ? p[3] = 1 : tw_vrel(p); ); i += 1; );
);
function tw_mono_on(n, v) local(i, f, held, p) (
  held = tw_hc > 0;
  f = -1; i = 0; loop(tw_hc, THN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(tw_hc - f - 1, THN[i] = THN[i + 1]; i += 1; ); tw_hc -= 1; );
  tw_hc < 127 ? ( THN[tw_hc] = n; tw_hc += 1; );
  p = TV; tw_age += 1; p[2] = tw_age;
  tw_vstart(p, n, v, !(held && tw_mode == 2), p[8] > 0 ? p[4] : (tw_last >= 0 && tw_glide > 0 ? tw_last : n));
);
function tw_mono_off(n) local(i, f, p) (
  f = -1; i = 0; loop(tw_hc, THN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(tw_hc - f - 1, THN[i] = THN[i + 1]; i += 1; ); tw_hc -= 1;
    p = TV;
    tw_hc > 0 ? ( p[0] = THN[tw_hc - 1]; p[5] = p[0]; tw_gc >= 1 ? p[4] = p[0]; )
              : ( tw_pedal ? p[3] = 1 : tw_vrel(p); );
  );
);
function tw_all_off() local(i, p) (
  i = 0; loop(8, p = TV + i * 64; p[1] ? tw_vrel(p); p[1] = 0; p[3] = 0; i += 1; );
  tw_hc = 0;
);
function tw_pedal_up() local(i, p) ( i = 0; loop(8, p = TV + i * 64; p[3] ? tw_vrel(p); i += 1; ); );
function tw_qpush(ofs, t, n, v) local(i) (
  tw_qc < 300 ? (
    i = tw_qc; while (i > 0 && TQO[i - 1] > ofs) ( TQO[i] = TQO[i - 1]; TQT[i] = TQT[i - 1]; TQN[i] = TQN[i - 1]; TQV[i] = TQV[i - 1]; i -= 1; );
    TQO[i] = ofs; TQT[i] = t; TQN[i] = n; TQV[i] = v; tw_qc += 1;
  );
);

// ---------- rates ----------
function tw_lfo_beats(r) ( r == 0 ? 32 : r == 1 ? 16 : r == 2 ? 8 : r == 3 ? 4 : r == 4 ? 2 : r == 5 ? 4 / 3 : r == 6 ? 1 :
                           r == 7 ? 2 / 3 : r == 8 ? 0.5 : r == 9 ? 1 / 3 : r == 10 ? 0.25 : 1 / 6; );
function tw_dly_beats(r) ( r == 0 ? 2 : r == 1 ? 1.5 : r == 2 ? 1 : r == 3 ? 2 / 3 : r == 4 ? 0.75 : r == 5 ? 0.5 : r == 6 ? 1 / 3 : 0.25; );

// LFO value: shape at phase ph; hv = held value (S&H), a / b the smooth-random end points
function tw_lfov(sh, ph, hv, a, b) (
  sh == 0 ? sin(2 * $pi * ph) : sh == 1 ? 1 - 4 * abs(ph - 0.5) : sh == 2 ? 2 * ph - 1 : sh == 3 ? hv :
  a + (b - a) * (0.5 - 0.5 * cos($pi * ph));
);

// one reverb line: read (its length glides to the target; m swims it a little), damp, scale.
// Lines that do not swim read at whole samples (cheaper); the two that swim interpolate.
function tw_rl(base, lt, g, m) instance(ln, z) local(rp, ri, rf, d) (
  ln += (lt - ln) * 0.0004;
  m != 0 ? (
    rp = tw_rw - ln - m; ri = floor(rp); rf = rp - ri;
    d = base[ri & (TRVN - 1)] * (1 - rf) + base[(ri + 1) & (TRVN - 1)] * rf;
  ) : d = base[(tw_rw - floor(ln + 0.5)) & (TRVN - 1)];
  z += (d - z) * tw_rdc;
  z * g;
);
// an input allpass (ring at base, length n)
function tw_ap(base, n, x) instance(w) local(d, v) (
  d = base[(w - n) & (TAPN - 1)]; v = x + 0.6 * d; base[w] = v; w = (w + 1) & (TAPN - 1);
  d - 0.6 * v;
);
function tw_rinit(lt) instance(ln, z) ( ln = lt; z = 0; );

// ---------- the corner tables (ln Hz, ln Q, dB) from the chosen sets, with FATE's slide per corner ----------
function tw_corners() local(c, s, k, p, q, d) (
  c = 0;
  loop(4,
    s = min(max(floor(slider(10 + c) + 0.5), 0), 8);
    d = c == 0 ? tw_fc0 : c == 1 ? tw_fc1 : c == 2 ? tw_fc2 : tw_fc3;
    p = TFS + s * 15; q = TCT + c * 15; k = 0;
    loop(5,
      q[0] = log(p[0]) + d; q[1] = log(p[0] / p[1]); q[2] = p[2];
      p += 3; q += 3; k += 1;
    );
    c += 1;
  );
);

// the formant coefficients of one voice at the point (x, y)
function tw_fcoef(q, x, y) local(w1, w2, w3, w4, c, lf, lq, gd, f, kk, g, a1) (
  x = min(max(x, 0), 1); y = min(max(y, 0), 1);
  w1 = (1 - x) * y; w2 = x * y; w3 = (1 - x) * (1 - y); w4 = x * (1 - y);
  c = TCT;
  loop(5,
    lf = w1 * c[0] + w2 * c[15] + w3 * c[30] + w4 * c[45];
    lq = w1 * c[1] + w2 * c[16] + w3 * c[31] + w4 * c[46];
    gd = w1 * c[2] + w2 * c[17] + w3 * c[32] + w4 * c[47];
    f = min(exp(lf + tw_lsh), tw_fmax);
    kk = 1 / max(exp(lq) * tw_rq, 0.4);
    g = tan(f * tw_pis);
    a1 = 1 / (1 + g * (g + kk));
    q[0] = a1; q[1] = g * a1; q[2] = g * g * a1; q[3] = exp(gd * 0.11512925) * kk;
    c += 3; q += 4;
  );
);

// one band-pass of the bank: zero-delay state-variable (q: its two states, c: a1 a2 a3 gain), unity peak gain
function tw_bp(q, c, x) local(v1, v3, s0) (
  s0 = q[0]; v3 = x - q[1]; v1 = c[0] * s0 + c[1] * v3;
  q[1] += 2 * (c[1] * s0 + c[2] * v3); q[0] = 2 * v1 - s0;
  v1 * c[3];
);


// ---------- one voice (its DSP state lives in its own namespace: fast); p = its slots in TV ----------
function tw_saw(ph, d) ( 2 * ph - 1 - vo_blep(ph, d); );
function tw_vproc(p) instance(a0, a1, a2, a3, a4, b0, b1, b2, b3, b4, sp, i1, i2,
                              s0, s1, s2, s3, s4, s5, s6, s7, s8, s9,
                              c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19,
                              ex, ey, fg)
                     local(e, b, v, q, o1, o2, su, x, xf, y, amp, t, d) (
  p[62] ? (
    // a fresh voice: random phases (chords and the choir saws never line up), clean band-passes
    p[62] = 0;
    a0 = rand(1); a1 = rand(1); a2 = rand(1); a3 = rand(1); a4 = rand(1);
    b0 = rand(1); b1 = rand(1); b2 = rand(1); b3 = rand(1); b4 = rand(1); sp = rand(1);
    s0 = s1 = s2 = s3 = s4 = s5 = s6 = s7 = s8 = s9 = 0;
    ex = ey = 0; fg = 1;
  );
  (tw_tick || p[58]) ? (
    p[58] = 0;
    p[4] += (p[5] - p[4]) * (p[63] ? tw_dgc : tw_gc);
    // formant envelope (attack / decay)
    e = p[11];
    p[10] == 1 ? ( e += (1.25 - e) * tw_ea; e >= 1 ? ( e = 1; p[10] = 2; ); ) :
    p[10] == 2 ? e -= e * tw_ed;
    p[11] = e;
    b = p[4] + p[7] + tw_pmod;
    i1 = min(exp((b - 69) * L12) * tw_440s, 0.45);
    i2 = min(i1 * tw_o2i, 0.45);
    tw_own ? (
      v = p[6] * 2 - 1;
      tw_fcoef(p + 35, tw_px + v * tw_vx * 0.5, tw_py + v * tw_vy * 0.5 + e * tw_ey * 0.6);
      q = p + 35;
    ) : q = TGC;
    c0 = q[0];   c1 = q[1];   c2 = q[2];   c3 = q[3];   c4 = q[4];   c5 = q[5];   c6 = q[6];   c7 = q[7];
    c8 = q[8];   c9 = q[9];   c10 = q[10]; c11 = q[11]; c12 = q[12]; c13 = q[13]; c14 = q[14]; c15 = q[15];
    c16 = q[16]; c17 = q[17]; c18 = q[18]; c19 = q[19];
    // level: the formants pass far more when a harmonic sits on a peak than when the peaks fall between them -
    // follow what goes in against what comes out and make up most of the difference (smoothly, ~40 ms)
    ey > 0.0000001 ? fg += (min(max(sqrt(ex / ey), 0.3), 12) ^ 0.8 - fg) * tw_lgc;
  );

  // ----- OSC 1 -----
  tw_w1 == 0 ? ( a0 += i1; a0 -= floor(a0); o1 = tw_saw(a0, i1); ) :
  tw_w1 == 1 ? (
    a0 += i1; a0 -= floor(a0); t = a0 + 1 - tw_pw; t -= floor(t);
    o1 = tw_saw(a0, i1) - tw_saw(t, i1);
  ) : (
    d = i1 * tw_cr0; a0 += d; a0 -= floor(a0); o1 = tw_saw(a0, d);
    d = i1 * tw_cr1; a1 += d; a1 -= floor(a1); o1 += tw_saw(a1, d);
    a2 += i1; a2 -= floor(a2); o1 += tw_saw(a2, i1);
    d = i1 * tw_cr3; a3 += d; a3 -= floor(a3); o1 += tw_saw(a3, d);
    d = i1 * tw_cr4; a4 += d; a4 -= floor(a4); o1 += tw_saw(a4, d);
    o1 *= 0.42;
  );
  // ----- OSC 2 -----
  tw_w2 == 0 ? ( b0 += i2; b0 -= floor(b0); o2 = tw_saw(b0, i2); ) :
  tw_w2 == 1 ? (
    b0 += i2; b0 -= floor(b0); t = b0 + 1 - tw_pw; t -= floor(t);
    o2 = tw_saw(b0, i2) - tw_saw(t, i2);
  ) : (
    d = i2 * tw_cr0; b0 += d; b0 -= floor(b0); o2 = tw_saw(b0, d);
    d = i2 * tw_cr1; b1 += d; b1 -= floor(b1); o2 += tw_saw(b1, d);
    b2 += i2; b2 -= floor(b2); o2 += tw_saw(b2, i2);
    d = i2 * tw_cr3; b3 += d; b3 -= floor(b3); o2 += tw_saw(b3, d);
    d = i2 * tw_cr4; b4 += d; b4 -= floor(b4); o2 += tw_saw(b4, d);
    o2 *= 0.42;
  );
  // sub (square, one octave below OSC 1) and noise
  tw_sub > 0 ? (
    d = i1 * 0.5; sp += d; sp -= floor(sp); t = sp + 0.5; t -= floor(t);
    su = tw_saw(sp, d) - tw_saw(t, d);
  ) : su = 0;
  x = o1 * tw_m1 + o2 * tw_m2 + su * tw_sub * 0.5 + (tw_noi > 0 ? (rand(2) - 1) * tw_noi : 0);

  // ----- the formant bank: five parallel zero-delay state-variable band-passes, unity peak gain -----
  xf = x;
  t = xf - s1; v = c0 * s0 + c1 * t; s1 += 2 * (c1 * s0 + c2 * t);    s0 = 2 * v - s0; y = v * c3;
  t = xf - s3; v = c4 * s2 + c5 * t; s3 += 2 * (c5 * s2 + c6 * t);    s2 = 2 * v - s2; y += v * c7;
  t = xf - s5; v = c8 * s4 + c9 * t; s5 += 2 * (c9 * s4 + c10 * t);   s4 = 2 * v - s4; y += v * c11;
  t = xf - s7; v = c12 * s6 + c13 * t; s7 += 2 * (c13 * s6 + c14 * t); s6 = 2 * v - s6; y += v * c15;
  t = xf - s9; v = c16 * s8 + c17 * t; s9 += 2 * (c17 * s8 + c18 * t); s8 = 2 * v - s8; y += v * c19;
  abs(s0) + abs(s2) > 60 ? s0 = s1 = s2 = s3 = s4 = s5 = s6 = s7 = s8 = s9 = 0;   // safety: never let a band run away
  ex += (xf * xf - ex) * tw_lgf; ey += (y * y - ey) * tw_lgf;
  y = x * (1 - tw_dep) + y * tw_dep * fg * tw_fcomp;

  // ----- amp envelope -----
  amp = p[9];
  p[63] ? (
    // a drone voice swells in, holds, and swells out
    p[8] == 1 ? ( amp += (1.3 - amp) * tw_daa; amp >= 1 ? ( amp = 1; p[8] = 2; ); ) :
    p[8] == 2 ? amp += (1 - amp) * tw_daa :
    ( amp -= amp * tw_dar; amp < 0.00002 ? ( amp = 0; p[8] = 0; p[10] = 0; p[0] = -1; p[62] = 1; p[63] = 0; ); );
  ) : (
    p[8] == 1 ? ( amp += (1.3 - amp) * tw_aa; amp >= 1 ? ( amp = 1; p[8] = 2; ); ) :
    p[8] == 2 ? amp += (tw_as - amp) * tw_ad :
    ( amp -= amp * tw_ar; amp < 0.00002 ? ( amp = 0; p[8] = 0; p[10] = 0; p[0] = -1; p[62] = 1; ); );
  );
  p[9] = amp;
  y * amp * p[55];
);


// ---------- LAYERS ----------
// parameter block q (from slider i0 on): 0 on, 1 transpose (st), 2 level, 3 wave, 4-6 tone a1 a2 a3, 7 x, 8 y,
//   9 motion, 10 attack, 11 release, 12 gate, 13 target note, 14 the note it sounds (for the panel), 15 / 16 its point
//   (for the panel), 20-39 its formant coefficients
function tw_lset(q, i0) local(g) (
  q[0] = slider(i0) >= 0.5; q[1] = 12 * floor(slider(i0 + 1) + 0.5) + floor(slider(i0 + 2) + 0.5);
  q[2] = sqr(slider(i0 + 3) / 100) * 0.9; q[3] = floor(slider(i0 + 4) + 0.5);
  g = tan($pi * min(slider(i0 + 5), srate * 0.45) / srate);
  q[4] = 1 / (1 + g * (g + 1.2)); q[5] = g * q[4]; q[6] = g * q[5];
  q[7] = slider(i0 + 6) / 100; q[8] = slider(i0 + 7) / 100; q[9] = slider(i0 + 8) / 100;
  q[10] = 1 - exp(-4.6 / (slider(i0 + 9) * 0.001 * srate)); q[11] = 1 - exp(-4.6 / (slider(i0 + 10) * 0.001 * srate));
);
// one layer: a mono voice with its own wave, tone, place on the pad and swell
function tw_lproc(q) instance(a0, a1, a2, a3, a4, nt, i1, env, z1, z2, s0, s1, s2, s3, s4, s5, s6, s7, s8, s9,
                              c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19,
                              ex, ey, fg, run)
                     local(x, y, t, d, v, g) (
  g = q[0] && q[12];
  !run && g ? (
    // waking from silence: start on the note (no glide from an old one), fresh phases and filters
    run = 1; nt = q[13]; env = 0; fg = 1; ex = ey = 0; z1 = z2 = 0;
    s0 = s1 = s2 = s3 = s4 = s5 = s6 = s7 = s8 = s9 = 0;
    a0 = rand(1); a1 = rand(1); a2 = rand(1); a3 = rand(1); a4 = rand(1);
  );
  run ? (
    tw_tick ? (
      nt += (q[13] - nt) * tw_lgl;                      // a new note: glide there (~120 ms), no click
      i1 = min(exp((nt + tw_pmod - 69) * L12) * tw_440s, 0.45);
      c0 = q[20];  c1 = q[21];  c2 = q[22];  c3 = q[23];  c4 = q[24];  c5 = q[25];  c6 = q[26];  c7 = q[27];
      c8 = q[28];  c9 = q[29];  c10 = q[30]; c11 = q[31]; c12 = q[32]; c13 = q[33]; c14 = q[34]; c15 = q[35];
      c16 = q[36]; c17 = q[37]; c18 = q[38]; c19 = q[39];
      ey > 0.0000001 ? fg += (min(max(sqrt(ex / ey), 0.3), 12) ^ 0.8 - fg) * tw_lgc;
      q[14] = nt;
    );
    env += ((g ? 1 : 0) - env) * (g ? q[10] : q[11]);
    q[3] == 0 ? ( a0 += i1; a0 -= floor(a0); x = tw_saw(a0, i1); ) :
    q[3] == 1 ? ( a0 += i1; a0 -= floor(a0); t = a0 + 1 - tw_pw; t -= floor(t); x = tw_saw(a0, i1) - tw_saw(t, i1); ) : (
      d = i1 * tw_cr0; a0 += d; a0 -= floor(a0); x = tw_saw(a0, d);
      d = i1 * tw_cr1; a1 += d; a1 -= floor(a1); x += tw_saw(a1, d);
      a2 += i1; a2 -= floor(a2); x += tw_saw(a2, i1);
      d = i1 * tw_cr3; a3 += d; a3 -= floor(a3); x += tw_saw(a3, d);
      d = i1 * tw_cr4; a4 += d; a4 -= floor(a4); x += tw_saw(a4, d);
      x *= 0.42;
    );
    // TONE: 12 dB low-pass
    t = x - z2; v = q[4] * z1 + q[5] * t; z2 += 2 * (q[5] * z1 + q[6] * t); z1 = 2 * v - z1;
    x = z2 * 0.5;
    // its own formants
    t = x - s1; v = c0 * s0 + c1 * t; s1 += 2 * (c1 * s0 + c2 * t);    s0 = 2 * v - s0; y = v * c3;
    t = x - s3; v = c4 * s2 + c5 * t; s3 += 2 * (c5 * s2 + c6 * t);    s2 = 2 * v - s2; y += v * c7;
    t = x - s5; v = c8 * s4 + c9 * t; s5 += 2 * (c9 * s4 + c10 * t);   s4 = 2 * v - s4; y += v * c11;
    t = x - s7; v = c12 * s6 + c13 * t; s7 += 2 * (c13 * s6 + c14 * t); s6 = 2 * v - s6; y += v * c15;
    t = x - s9; v = c16 * s8 + c17 * t; s9 += 2 * (c17 * s8 + c18 * t); s8 = 2 * v - s8; y += v * c19;
    abs(s0) + abs(s2) > 60 ? s0 = s1 = s2 = s3 = s4 = s5 = s6 = s7 = s8 = s9 = 0;
    ex += (x * x - ex) * tw_lgf; ey += (y * y - ey) * tw_lgf;
    y = x * (1 - tw_dep) + y * tw_dep * fg * tw_fcomp;
    !g && env < 0.00002 ? ( run = 0; env = 0; );
    y * env * q[2];
  ) : 0;
);

// ---------- DRONE: the chord's notes into TDN; returns how many ----------
function tw_ci(c, k) (                                  // interval k of chord c (-1: no more)
  c == 0 ? (k == 0 ? 0 : k == 1 ? 7 : k == 2 ? 12 : -1) :
  c == 1 ? (k == 0 ? 0 : k == 1 ? 2 : k == 2 ? 7 : -1) :
  c == 2 ? (k == 0 ? 0 : k == 1 ? 5 : k == 2 ? 7 : -1) :
  c == 3 ? (k == 0 ? 0 : k == 1 ? 4 : k == 2 ? 7 : -1) :
  c == 4 ? (k == 0 ? 0 : k == 1 ? 3 : k == 2 ? 7 : -1) :
  c == 5 ? (k == 0 ? 0 : k == 1 ? 4 : k == 2 ? 7 : k == 3 ? 11 : -1) :
  c == 6 ? (k == 0 ? 0 : k == 1 ? 3 : k == 2 ? 7 : k == 3 ? 10 : -1) :
  c == 7 ? (k == 0 ? 0 : k == 1 ? 4 : k == 2 ? 7 : k == 3 ? 14 : -1) :
  c == 8 ? (k == 0 ? 0 : k == 1 ? 5 : k == 2 ? 10 : k == 3 ? 15 : -1) :
           (k == 0 ? 0 : k == 1 ? 7 : k == 2 ? 12 : k == 3 ? 19 : -1);
);
function tw_dnotes(root) local(n, k, iv, lift) (
  n = 0; while ((iv = tw_ci(tw_dch, n)) >= 0 && n < 4) ( TDN[n] = iv; n += 1; );
  // VOICING: SPREAD lifts the second tone an octave; WIDE also the fourth (or, with three, the third)
  tw_dvc >= 1 ? TDN[1] += 12;
  tw_dvc == 2 ? ( n > 3 ? TDN[3] += 12 : TDN[2] += 12; );
  // FATE turns the voicing over now and then: the lowest inner tones go up an octave (the root stays at the bottom)
  lift = floor(max(tw_dinv, 0) * min(n - 1, 2) + 0.5); k = 1;
  loop(lift, TDN[k] += 12; k += 1; );
  k = 0; loop(n, TDN[k] += root; k += 1; );
  n;
);
// a voice for a drone tone: never voice 0 in MONO / LEGATO (that one is the played voice); free first, then the
// oldest released one, then the oldest that is not a drone voice
function tw_dalloc() local(i, p, best, ba, lo) (
  best = -1; lo = tw_mode ? 1 : 0;
  i = 7; loop(8 - lo, p = TV + i * 64; p[8] == 0 && best < 0 ? best = i; i -= 1; );
  best < 0 ? ( i = 7; loop(8 - lo, p = TV + i * 64; !p[1] && !p[3] && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i -= 1; ); );
  best < 0 ? ( i = 7; loop(8 - lo, p = TV + i * 64; !p[63] && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i -= 1; ); );
  best < 0 ? -1 : TV + best * 64;
);
// bring the drone voices to the chord (n notes in TDN): voices that stay glide, new ones swell in, the rest swell out
function tw_drone_set(n) local(k, p) (
  k = 0;
  loop(8,
    p = TDV[k];
    p >= 0 && !(p[63] && p[8] > 0 && p[8] != 3) ? ( p = -1; TDV[k] = -1; );     // stolen or gone
    k < n ? (
      p >= 0 ? ( p[5] = TDN[k]; p[0] = TDN[k]; ) : (
        p = tw_dalloc();
        p >= 0 ? (
          tw_age += 1; p[2] = tw_age;
          tw_vstart(p, TDN[k], 92, 1, TDN[k]);
          p[63] = 1; p[4] = TDN[k];
          p[55] = (1 - tw_avel + tw_avel * 0.72) * 0.62 * tw_dlg;
          TDV[k] = p;
        );
      );
    ) : (
      p >= 0 ? ( p[1] = 0; p[8] = 3; TDV[k] = -1; );
    );
    k += 1;
  );
);

// ---------- parameters ----------
function tw_c4(c) ( 1 - (1 - c) ^ 4; );
function tw_c8(ms) ( 1 - exp(-4.6 * 8 / (max(ms, 0.05) * 0.001 * srate)); );   // a one-pole step at the 8-sample tick
function update() local(r, sp) (
  tw_w1 = slider1; tw_w2 = slider2; tw_o2st = slider3 + slider4 / 100;
  r = slider5 / 100; tw_m1 = (1 - r) * 0.5; tw_m2 = r * 0.5;
  tw_pw = slider6 / 100; tw_spr = slider7;
  tw_sub = slider8 / 100 * 0.55; tw_noi = sqr(slider9 / 100) * 0.9;
  tw_res = slider16 / 100; tw_rq0 = 0.5 * 8 ^ tw_res;
  tw_dep = slider17 / 100; tw_shift = slider18;
  tw_xs = slider19; tw_xy = slider21; tw_xb = tw_lfo_beats(slider22); tw_xd = slider23 / 100;
  tw_ys = slider24; tw_yy = slider26; tw_yb = tw_lfo_beats(slider27); tw_yd = slider28 / 100;
  tw_phs = slider29 / 360; tw_path = slider30;
  tw_tmp = tempo > 0 ? tempo : 120;
  tw_xr0 = tw_xy ? tw_tmp / 60 / tw_xb : slider20;
  tw_yr0 = tw_yy ? tw_tmp / 60 / tw_yb : slider25;
  tw_wx = slider31 / 100; tw_wy = slider32 / 100; tw_vx = slider33 / 100; tw_vy = slider34 / 100;
  tw_ey = slider35 / 100; tw_ea = tw_c8(slider36); tw_ed = tw_c8(slider37);
  tw_dron = slider38 >= 0.5; tw_drt = floor(slider39 + 0.5); tw_dch = floor(slider40 + 0.5); tw_dvc = floor(slider41 + 0.5);
  tw_dfol = slider42 >= 0.5; tw_doct = floor(slider43 + 0.5); tw_pnt = floor(slider44 + 0.5);
  // drone voices: at least a 300 ms swell in and 800 ms out, whatever the AMP envelope says
  tw_daa = vo_coef(max(slider48, 300)); tw_dar = vo_coef(max(slider51, 800));
  tw_dgc = tw_c4(vo_coef(160));                        // drone voices glide to a new chord in ~160 ms
  // layers: parameter blocks for the two mono drone voices
  tw_lset(TLB, 69); tw_lset(TLP, 80);
  tw_mode = slider45; tw_glide = slider46; tw_gc = slider46 > 0 ? tw_c4(vo_coef(slider46)) : 1;
  tw_brng = slider47;
  tw_aa = vo_coef(slider48); tw_ad = vo_coef(slider49); tw_as = slider50 / 100; tw_ar = vo_coef(slider51);
  tw_avel = slider52 / 100;
  tw_drv = slider53 / 100; tw_dg = 1 + 14 * tw_drv * tw_drv; tw_db = 0.18 * tw_drv;
  tw_dn = 1 / (1 + 2.2 * tw_drv); tw_crum = max(tw_drv - 0.45, 0) / 0.55; tw_qs = 2 ^ (9 - 5 * tw_crum);
  tw_dlb = tw_dly_beats(slider54); tw_dfb = slider55 / 100; tw_dmx = slider56 / 100;
  tw_dlt = min(tw_dlb * 60 / tw_tmp * srate, TDM - 4);
  tw_rsz = slider57 / 100; tw_rtone = slider58 / 100; tw_rmx = slider59 / 100;
  tw_fate = slider60 / 100; tw_volt = 10 ^ (slider61 / 20); tw_chan = slider62;
  tw_fmax = srate * 0.45; tw_pis = $pi / srate; tw_440s = 440 / srate;
  // reverb: lengths (ms, mutually prime-ish), decay from SIZE, damping from TONE
  sp = srate / 1000 * (0.55 + 1.05 * tw_rsz);
  TRLT[0] = 37.1 * sp; TRLT[1] = 41.3 * sp; TRLT[2] = 47.9 * sp; TRLT[3] = 53.3 * sp;
  TRLT[4] = 59.7 * sp; TRLT[5] = 67.1 * sp; TRLT[6] = 73.9 * sp; TRLT[7] = 81.7 * sp;
  r = 0; loop(8, TRLT[r] = min(TRLT[r], TRVN - 40); r += 1; );
  tw_t60 = 1.2 + 10 * tw_rsz ^ 1.5;
  tw_rwg = 0.58 * (1.2 / tw_t60) ^ 0.19;            // longer rooms gather more: keep the wet level even
  r = 0; loop(8, TRG[r] = 10 ^ (-3 * TRLT[r] / (tw_t60 * srate)); r += 1; );
  tw_rdc = 1 - exp(-2 * $pi * min(1200 * 2 ^ (tw_rtone * 3.6), srate * 0.45) / srate);
  ins_output_setup(63);   // output stage: CLIP, always on
);

ins_drift_init();
tw_dXr.drift_init(0.8 + rand(0.5)); tw_dYr.drift_init(0.8 + rand(0.5)); tw_dPh.drift_init(0.8 + rand(0.5));
tw_dXd.drift_init(0.8 + rand(0.5)); tw_dYd.drift_init(0.8 + rand(0.5)); tw_dCx.drift_init(0.8 + rand(0.5));
tw_dCy.drift_init(0.8 + rand(0.5)); tw_dIv.drift_init(0.8 + rand(0.5));
tw_dF0.drift_init(0.8 + rand(0.5)); tw_dF1.drift_init(0.8 + rand(0.5)); tw_dF2.drift_init(0.8 + rand(0.5)); tw_dF3.drift_init(0.8 + rand(0.5));
tw_bend = 0; tw_mw = 0; tw_pedal = 0; tw_hc = 0; tw_age = 0; tw_last = -1; tw_qc = 0; tw_ct = 0;
tw_xph = 0; tw_yph = 0; tw_xcyc = 0; tw_xh = 0; tw_yh = 0; tw_xa = 0; tw_xb2 = rand(2) - 1; tw_ya = 0; tw_yb2 = rand(2) - 1;
tw_gx = 0.5; tw_gy = 0.5; tw_px = 0.5; tw_py = 0.5; tw_droot = -1; tw_dinv = 0; tw_dcnt = 0;
tw_vol = 1; tw_wp = 0; tw_rw = 0; tw_dts = -1;
tw_fc0 = tw_fc1 = tw_fc2 = tw_fc3 = 0; tw_lastmode = -1;
function tw_srinit() local(i) (
  tw_sr = srate; tw_sm = 1 - exp(-1 / (0.03 * srate)); ost_init(20000); tw_dts = -1;
  TAPL[0] = min(floor(4.77 * srate / 1000), TAPN - 2); TAPL[1] = min(floor(3.59 * srate / 1000), TAPN - 2);
  TAPL[2] = min(floor(12.73 * srate / 1000), TAPN - 2); TAPL[3] = min(floor(9.31 * srate / 1000), TAPN - 2);
  tw_ap0.w = tw_ap1.w = tw_ap2.w = tw_ap3.w = 0;
  update();
  tw_r0.tw_rinit(TRLT[0]); tw_r1.tw_rinit(TRLT[1]); tw_r2.tw_rinit(TRLT[2]); tw_r3.tw_rinit(TRLT[3]);
  tw_r4.tw_rinit(TRLT[4]); tw_r5.tw_rinit(TRLT[5]); tw_r6.tw_rinit(TRLT[6]); tw_r7.tw_rinit(TRLT[7]);
  tw_kc = 1 - exp(-8 / (0.005 * srate));               // the point's smoothing at the tick (5 ms)
  tw_lgl = 1 - exp(-8 / (0.04 * srate));               // the layers glide to a new note (~120 ms)
  tw_lgf = 1 - exp(-1 / (0.03 * srate));               // the formants' level follower (30 ms)
  tw_lgc = 1 - exp(-8 / (0.04 * srate));               // and its make-up gain's glide
);
tw_srinit();
tw_lastmode = tw_mode;                               // (so the first block does not queue an all-off over its own notes)
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );               // a new instance opens Large, on Init
tw_corners();
tw_vol = tw_volt;
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
srate != tw_sr ? tw_srinit();
tw_treq > 0 ? ( load_preset(tw_treq); tw_treq = 0; );     // a preset asked for from outside the panel (test hook)
// TRANSPORT: while lit, REAPER's play (or record) switches the DRONE on and its stop switches it off (it swells in and
// out as by hand); the DRONE key still works by hand
tw_xp = play_state & 1;
slider91 >= 0.5 && tw_xp != tw_xpw ? ( slider38 = tw_xp; ui_auto(38); );
tw_xpw = tw_xp;
update();

// MIDI in, sample-accurate through the queue (type 1 on, 0 off, 2 pedal up, 3 all off, 4 drone root)
tw_qc = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, tw_chan) ? (
    tw_st = m1 & 0xF0;
    tw_st == 0x90 || tw_st == 0x80 ? (
      tw_on = tw_st == 0x90 && m3 > 0;
      tw_dron && tw_dfol ? (
        tw_on ? tw_qpush(mofs, 4, m2, m3);              // FOLLOW: a played note moves the drone's root
      ) : tw_qpush(mofs, tw_on, m2, m3);
      tw_on ? ins_midi_hit();
    ) :
    tw_st == 0xE0 ? tw_bend = (((m3 * 128 + m2) - 8192) / 8192) * tw_brng :
    tw_st == 0xB0 ? (
      m2 == 1 ? tw_mw = m3 / 127 :
      m2 == 64 ? ( tw_pedal = m3 >= 64; !tw_pedal ? tw_qpush(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? tw_qpush(mofs, 3, 0, 0);
    );
  );
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( tw_qpush(0, 3, 0, 0); );
gfx_pst_prev = gfx_pst;
tw_mode != tw_lastmode ? ( tw_qpush(0, 3, 0, 0); tw_lastmode = tw_mode; );
tw_panic ? ( tw_all_off(); tw_panic = 0; );

// ---------- DRONE and LAYERS (block rate) ----------
// what is held (played voices only)
tw_nheld = 0; tw_plo = 1000; tw_i = 0;
loop(8, tw_p = TV + tw_i * 64; !tw_p[63] && tw_p[0] >= 0 && (tw_p[1] || tw_p[3]) ? ( tw_nheld += 1; tw_plo = min(tw_plo, tw_p[0]); ); tw_i += 1; );
// the drone sounds while it is on and nothing is played over it (with FOLLOW, played notes only move its root)
tw_dact = tw_dron && (tw_dfol || tw_nheld == 0);
tw_droot < 0 || !tw_dfol ? tw_droot = tw_drt;
tw_drn = 12 * (tw_doct + 1) + tw_droot;                  // the root note (octave 3: C3 = 48)
tw_dcnt = tw_dact ? tw_dnotes(tw_drn) : 0;
tw_dlg = sqrt(3 / max(tw_dcnt, 1)) * 0.9;                  // level-matched to playing a three-note chord
tw_drone_set(tw_dcnt);
// the layers sound the lowest note and the root of the drone, or of what is played
tw_dact ? ( tw_lsrc = tw_drn; tw_lroot = tw_drn; tw_lgate = 1; ) :
tw_nheld > 0 ? ( tw_lsrc = tw_plo; tw_lroot = tw_plo; tw_lgate = 1; ) : tw_lgate = 0;
TLB[12] = tw_lgate; TLP[12] = tw_lgate;
tw_lgate ? (
  TLB[13] = tw_lsrc + TLB[1];
  TLP[13] = tw_lroot + (tw_pnt == 1 ? 7 : tw_pnt == 2 ? 12 : 0) + TLP[1];
);
tw_eqi = 0; tw_spos = 0;

// FATE: the cards reshuffle a little
ins_drift_block(tw_fate * 0.6, samplesblock);
tw_dps = 12 * log(ins_pitch) / LN2;
tw_di = 0.09 * samplesblock / srate;
tw_xrm = 2 ^ (tw_dXr.drift_tick(tw_di) * tw_fate * 0.45);         // LFO rates up to about +/-35 %
tw_yrm = 2 ^ (tw_dYr.drift_tick(tw_di) * tw_fate * 0.45);
tw_dph = tw_dPh.drift_tick(tw_di) * tw_fate * 0.12;                // phase up to +/-43 degrees
tw_xdm = 1 + tw_dXd.drift_tick(tw_di) * tw_fate * 0.25;            // depths +/-25 %
tw_ydm = 1 + tw_dYd.drift_tick(tw_di) * tw_fate * 0.25;
tw_dcx = tw_dCx.drift_tick(tw_di * 0.7) * tw_fate * 0.08;          // the centre wanders +/-8 %
tw_dcy = tw_dCy.drift_tick(tw_di * 0.7) * tw_fate * 0.08;
tw_dinv = tw_dIv.drift_tick(tw_di * 0.35) * tw_fate * 2 - 0.25;    // the drone voicing turns over now and then
tw_fc0 = tw_dF0.drift_tick(tw_di * 0.6) * tw_fate * 0.07;          // each corner's set slides up to +/-7 %
tw_fc1 = tw_dF1.drift_tick(tw_di * 0.6) * tw_fate * 0.07;
tw_fc2 = tw_dF2.drift_tick(tw_di * 0.6) * tw_fate * 0.07;
tw_fc3 = tw_dF3.drift_tick(tw_di * 0.6) * tw_fate * 0.07;
tw_corners();
tw_lsh = tw_shift * L12;
tw_xr = tw_xr0 * (tw_xy ? 1 : tw_xrm); tw_yr = tw_yr0 * (tw_yy ? 1 : tw_yrm);
// synced LFOs follow the project's beat while it plays
play_state & 1 ? (
  tw_xy ? ( tw_t = beat_position / tw_xb; tw_xcyc = floor(tw_t); tw_xph = tw_t - tw_xcyc; );
  tw_yy && tw_path == 0 ? ( tw_t = beat_position / tw_yb; tw_yph = tw_t - floor(tw_t); );
);
tw_dts < 0 ? tw_dts = tw_dlt;
abs(tw_dfl) + abs(tw_dfr) < 0.0000000001 ? tw_dfl = tw_dfr = 0;
abs(tw_dcyl) + abs(tw_dcyr) < 0.0000000001 ? tw_dcyl = tw_dcyr = 0;
abs(tw_r0.z) + abs(tw_r1.z) + abs(tw_r2.z) + abs(tw_r3.z) + abs(tw_r4.z) + abs(tw_r5.z) + abs(tw_r6.z) + abs(tw_r7.z) < 0.0000000001 ? (
  tw_r0.z = tw_r1.z = tw_r2.z = tw_r3.z = tw_r4.z = tw_r5.z = tw_r6.z = tw_r7.z = 0;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
while (tw_eqi < tw_qc && (TQO[tw_eqi] <= tw_spos || tw_spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  tw_et = TQT[tw_eqi];
  tw_et == 1 ? ( tw_mode ? tw_mono_on(TQN[tw_eqi], TQV[tw_eqi]) : tw_poly_on(TQN[tw_eqi], TQV[tw_eqi]); tw_last = TQN[tw_eqi]; ) :
  tw_et == 0 ? ( tw_mode ? tw_mono_off(TQN[tw_eqi]) : tw_poly_off(TQN[tw_eqi]); ) :
  tw_et == 2 ? tw_pedal_up() : tw_et == 3 ? tw_all_off() : tw_droot = TQN[tw_eqi] % 12;
  tw_eqi += 1;
);
tw_spos += 1;

// ---------- control tick (every 8 samples): LFOs, the point, the layers' points ----------
tw_ct += 1;
tw_tick = tw_ct >= 8;
tw_tick ? (
  tw_ct = 0;
  // LFO X
  tw_xph += tw_xr * 8 / srate;
  tw_xph >= 1 ? ( tw_xph -= floor(tw_xph); tw_xcyc += 1; tw_xh = rand(2) - 1; tw_xa = tw_xb2; tw_xb2 = rand(2) - 1; );
  tw_path == 4 ? (
    // WALK: two smooth random walks at their own rates
    tw_yph += tw_yr * 8 / srate;
    tw_yph >= 1 ? ( tw_yph -= floor(tw_yph); tw_ya = tw_yb2; tw_yb2 = rand(2) - 1; );
    tw_lx = tw_lfov(4, tw_xph, 0, tw_xa, tw_xb2); tw_ly = tw_lfov(4, tw_yph, 0, tw_ya, tw_yb2);
  ) : (
    tw_lx = tw_lfov(tw_xs, tw_xph, tw_xh, tw_xa, tw_xb2);
    tw_path == 0 ? (
      tw_yph += tw_yr * 8 / srate; tw_ywr = tw_yph >= 1; tw_yph -= floor(tw_yph);
    ) : (
      // CIRCLE / SPIRAL: Y runs with X; FIGURE-8: at twice its rate (a 1:2 figure)
      tw_t = (tw_path == 2 ? 2 : 1) * (tw_xcyc + tw_xph); tw_t -= floor(tw_t);
      tw_ywr = tw_t < tw_yph; tw_yph = tw_t;
    );
    tw_ywr ? ( tw_yh = rand(2) - 1; tw_ya = tw_yb2; tw_yb2 = rand(2) - 1; );
    tw_t = tw_yph + tw_phs + tw_dph - (tw_path == 2 ? 0.25 : 0); tw_t -= floor(tw_t);   // FIGURE-8: 90 degrees draws the 8
    tw_ly = tw_lfov(tw_ys, tw_t, tw_yh, tw_ya, tw_yb2);
    tw_path == 3 ? (
      // SPIRAL: the radius breathes in and out over eight turns
      tw_t = (tw_xcyc + tw_xph) / 8; tw_t -= floor(tw_t);
      tw_t = 0.12 + 0.88 * (1 - abs(2 * tw_t - 1));
      tw_lx *= tw_t; tw_ly *= tw_t;
    );
  );
  tw_lfx = tw_lx; tw_lfy = tw_ly;                                  // (for the panel)
  // the point: the centre (dragged on the pad), the LFOs, the wheel, FATE
  tw_tx = slider14 / 100 + tw_dcx + tw_lx * tw_xd * tw_xdm * 0.5 + tw_mw * tw_wx * 0.5;
  tw_ty = slider15 / 100 + tw_dcy + tw_ly * tw_yd * tw_ydm * 0.5 + tw_mw * tw_wy * 0.5;
  tw_gx += (min(max(tw_tx, 0), 1) - tw_gx) * tw_kc;
  tw_gy += (min(max(tw_ty, 0), 1) - tw_gy) * tw_kc;
  tw_px = tw_gx; tw_py = tw_gy;
  tw_rq = tw_rq > 0 ? tw_rq + (tw_rq0 - tw_rq) * (1 - exp(-8 / (0.015 * srate))) : tw_rq0;   // RESONANCE glides (15 ms)
  tw_fcomp = 1.5;
  // the layers: their own place on the pad, plus MOTION's share of the LFOs' orbit
  tw_ox = tw_lx * tw_xd * tw_xdm * 0.5; tw_oy = tw_ly * tw_yd * tw_ydm * 0.5;
  TLB[0] ? ( TLB[15] = min(max(TLB[7] + tw_ox * TLB[9], 0), 1); TLB[16] = min(max(TLB[8] + tw_oy * TLB[9], 0), 1);
             tw_fcoef(TLB + 20, TLB[15], TLB[16]); );
  TLP[0] ? ( TLP[15] = min(max(TLP[7] + tw_ox * TLP[9], 0), 1); TLP[16] = min(max(TLP[8] + tw_oy * TLP[9], 0), 1);
             tw_fcoef(TLP + 20, TLP[15], TLP[16]); );
  // one shared set of coefficients unless velocity or the envelope give each voice its own point
  tw_own = tw_vx != 0 || tw_vy != 0 || tw_ey != 0;
  !tw_own ? tw_fcoef(TGC, tw_px, tw_py);
  tw_pmod = tw_bend + tw_dps;
  tw_o2i = 2 ^ (tw_o2st / 12);
  // the choir: five saws spread in cents
  tw_cr0 = 2 ^ (-tw_spr / 1200); tw_cr1 = 2 ^ (-tw_spr * 0.42 / 1200);
  tw_cr3 = 2 ^ (tw_spr * 0.39 / 1200); tw_cr4 = 2 ^ (tw_spr * 1.03 / 1200);
);

// ---------- the voices ----------
tw_L = tw_R = 0;
TV[8]       > 0 ? ( tw_y = tw_v0.tw_vproc(TV);       tw_L += tw_y * TV[56];       tw_R += tw_y * TV[57]; );
TV[64 + 8]  > 0 ? ( tw_y = tw_v1.tw_vproc(TV + 64);  tw_L += tw_y * TV[64 + 56];  tw_R += tw_y * TV[64 + 57]; );
TV[128 + 8] > 0 ? ( tw_y = tw_v2.tw_vproc(TV + 128); tw_L += tw_y * TV[128 + 56]; tw_R += tw_y * TV[128 + 57]; );
TV[192 + 8] > 0 ? ( tw_y = tw_v3.tw_vproc(TV + 192); tw_L += tw_y * TV[192 + 56]; tw_R += tw_y * TV[192 + 57]; );
TV[256 + 8] > 0 ? ( tw_y = tw_v4.tw_vproc(TV + 256); tw_L += tw_y * TV[256 + 56]; tw_R += tw_y * TV[256 + 57]; );
TV[320 + 8] > 0 ? ( tw_y = tw_v5.tw_vproc(TV + 320); tw_L += tw_y * TV[320 + 56]; tw_R += tw_y * TV[320 + 57]; );
TV[384 + 8] > 0 ? ( tw_y = tw_v6.tw_vproc(TV + 384); tw_L += tw_y * TV[384 + 56]; tw_R += tw_y * TV[384 + 57]; );
TV[448 + 8] > 0 ? ( tw_y = tw_v7.tw_vproc(TV + 448); tw_L += tw_y * TV[448 + 56]; tw_R += tw_y * TV[448 + 57]; );
// the layers (centred)
tw_y = tw_lb.tw_lproc(TLB) + tw_lp.tw_lproc(TLP); tw_L += tw_y; tw_R += tw_y;

// ---------- DRIVE: a biased soft clip, worn into grit at the top ----------
tw_drv > 0.001 ? (
  tw_L = (vo_tanh(tw_L * tw_dg + tw_db) - vo_tanh(tw_db)) * tw_dn;
  tw_R = (vo_tanh(tw_R * tw_dg + tw_db) - vo_tanh(tw_db)) * tw_dn;
  tw_crum > 0 ? (
    tw_L += (floor(tw_L * tw_qs + 0.5) / tw_qs - tw_L) * tw_crum * 0.6;
    tw_R += (floor(tw_R * tw_qs + 0.5) / tw_qs - tw_R) * tw_crum * 0.6;
  );
);

// ---------- DELAY: stereo ping-pong ----------
tw_dmx > 0.001 && (tw_dsil < tw_sr || abs(tw_L) + abs(tw_R) > 0.000001) ? (
  tw_dts += (tw_dlt * (1 + 0.004 * ins_fx) - tw_dts) * 0.0002;
  tw_rp = tw_wp - tw_dts; tw_ri = floor(tw_rp); tw_rf = tw_rp - tw_ri;
  tw_dl1 = TDL[tw_ri & TDM] * (1 - tw_rf) + TDL[(tw_ri + 1) & TDM] * tw_rf;
  tw_dr1 = TDR[tw_ri & TDM] * (1 - tw_rf) + TDR[(tw_ri + 1) & TDM] * tw_rf;
  tw_dfl += (tw_dl1 - tw_dfl) * 0.45; tw_dfr += (tw_dr1 - tw_dfr) * 0.45;
  TDL[tw_wp] = (tw_L + tw_R) * 0.5 + vo_tanh(tw_dfr * tw_dfb);
  TDR[tw_wp] = vo_tanh(tw_dfl * tw_dfb);
  tw_L += tw_dl1 * tw_dmx; tw_R += tw_dr1 * tw_dmx;
  abs(tw_L) + abs(tw_R) + abs(tw_dl1) + abs(tw_dr1) < 0.000001 ? tw_dsil += 1 : tw_dsil = 0;
) : ( TDL[tw_wp] = 0; TDR[tw_wp] = 0; );
tw_wp = (tw_wp + 1) & TDM;

// ---------- REVERB: eight lines, Hadamard feedback, damped ----------
tw_rmx > 0.001 && (tw_rsil < tw_sr || abs(tw_L) + abs(tw_R) > 0.000001) ? (
  // input diffusion (four allpasses)
  tw_x = (tw_L + tw_R) * 0.5;
  tw_x = tw_ap0.tw_ap(TAP, TAPL[0], tw_x); tw_x = tw_ap1.tw_ap(TAP + TAPN, TAPL[1], tw_x);
  tw_x = tw_ap2.tw_ap(TAP + 2 * TAPN, TAPL[2], tw_x); tw_x = tw_ap3.tw_ap(TAP + 3 * TAPN, TAPL[3], tw_x);
  // two lines swim a little against the metallic ring
  tw_tick ? ( tw_rmo += 0.37 * 8 / srate; tw_rmo -= floor(tw_rmo); tw_rm1 = sin(2 * $pi * tw_rmo) * 7 * srate / 48000; tw_rm2 = cos(2 * $pi * tw_rmo * 0.77) * 6 * srate / 48000; );
  tw_y0 = tw_r0.tw_rl(TRV,            TRLT[0], TRG[0], 0);
  tw_y1 = tw_r1.tw_rl(TRV + TRVN,     TRLT[1], TRG[1], tw_rm1);
  tw_y2 = tw_r2.tw_rl(TRV + 2 * TRVN, TRLT[2], TRG[2], 0);
  tw_y3 = tw_r3.tw_rl(TRV + 3 * TRVN, TRLT[3], TRG[3], 0);
  tw_y4 = tw_r4.tw_rl(TRV + 4 * TRVN, TRLT[4], TRG[4], 0);
  tw_y5 = tw_r5.tw_rl(TRV + 5 * TRVN, TRLT[5], TRG[5], 0);
  tw_y6 = tw_r6.tw_rl(TRV + 6 * TRVN, TRLT[6], TRG[6], tw_rm2);
  tw_y7 = tw_r7.tw_rl(TRV + 7 * TRVN, TRLT[7], TRG[7], 0);
  // 8-point Hadamard
  tw_a0 = tw_y0 + tw_y1; tw_a1 = tw_y0 - tw_y1; tw_a2 = tw_y2 + tw_y3; tw_a3 = tw_y2 - tw_y3;
  tw_a4 = tw_y4 + tw_y5; tw_a5 = tw_y4 - tw_y5; tw_a6 = tw_y6 + tw_y7; tw_a7 = tw_y6 - tw_y7;
  tw_b0 = tw_a0 + tw_a2; tw_b2 = tw_a0 - tw_a2; tw_b1 = tw_a1 + tw_a3; tw_b3 = tw_a1 - tw_a3;
  tw_b4 = tw_a4 + tw_a6; tw_b6 = tw_a4 - tw_a6; tw_b5 = tw_a5 + tw_a7; tw_b7 = tw_a5 - tw_a7;
  tw_h = 0.35355339;
  tw_ri = tw_rw & (TRVN - 1);
  TRV[tw_ri]            = (tw_b0 + tw_b4) * tw_h + tw_x;
  TRV[TRVN + tw_ri]     = (tw_b1 + tw_b5) * tw_h - tw_x;
  TRV[2 * TRVN + tw_ri] = (tw_b2 + tw_b6) * tw_h + tw_x;
  TRV[3 * TRVN + tw_ri] = (tw_b3 + tw_b7) * tw_h - tw_x;
  TRV[4 * TRVN + tw_ri] = (tw_b0 - tw_b4) * tw_h + tw_x;
  TRV[5 * TRVN + tw_ri] = (tw_b1 - tw_b5) * tw_h - tw_x;
  TRV[6 * TRVN + tw_ri] = (tw_b2 - tw_b6) * tw_h + tw_x;
  TRV[7 * TRVN + tw_ri] = (tw_b3 - tw_b7) * tw_h - tw_x;
  tw_wl = (tw_y0 - tw_y2 + tw_y4 - tw_y6) * 0.5;
  tw_wr = (tw_y1 - tw_y3 + tw_y5 - tw_y7) * 0.5;
  tw_L = tw_L * (1 - 0.3 * tw_rmx) + tw_wl * tw_rmx * tw_rwg;
  tw_R = tw_R * (1 - 0.3 * tw_rmx) + tw_wr * tw_rmx * tw_rwg;
  // a silent input and a tail fallen below -120 dB: rest the reverb until something comes in
  abs(tw_x) + abs(tw_wl) + abs(tw_wr) < 0.000001 ? tw_rsil += 1 : tw_rsil = 0;
);
tw_rw = (tw_rw + 1) & (TRVN - 1);

// DC block
tw_dcyl = tw_L - tw_dcxl + 0.9996 * tw_dcyl; tw_dcxl = tw_L; tw_L = tw_dcyl;
tw_dcyr = tw_R - tw_dcxr + 0.9996 * tw_dcyr; tw_dcxr = tw_R; tw_R = tw_dcyr;

// ---------- MASTER ----------
tw_vol += (tw_volt - tw_vol) * tw_sm;
tw_L = ostL.ost_band(tw_L * tw_vol); tw_R = ostR.ost_band(tw_R * tw_vol);
ost_out(tw_L, tw_R);
spl0 = ost_l; spl1 = ost_r;
tw_pk = max(tw_pk, max(abs(spl0), abs(spl1)));

@gfx 1100 600
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 5; ui_hw = 1;
ui_begin(1100, 600);

// ---------- the card's colours: deep black and charcoal, bone white, a pale gold sunrise, dusty rose ----------
INK = 0x111113; BONE = 0xEDE6D6; BONEH = 0xFBF7EE; LBL = 0xEFE9DB;
COAL = 0x2B2A2E; COALX = 0x1A1A1D; COALL = 0x3A383D;
SHA = 0x333236; SHB = 0x2F2E32; SHC = 0x37353A;
GOLD = 0xD8BF85; GOLDD = 0x9C8452; ROSE = 0xC75A6B; ROSEL = 0xE38D9B; RIVER = 0x7F9FB2;
KEYOFF = 0x222124; KEYHOV = 0x3A383E;
BASSC = 0x86AFC4; PEDC = 0xEAD08A;                     // the layers' colours on the pad: the river, the sun

// fonts, calibrated once per scale (the house way: a reference word fills the same width everywhere)
sc != tg_calsc ? (
  tg_calsc = sc;
  tg_f11 = ui_fitfont(11, 11.5 * sc);       // key captions, values, small print
  tg_f12 = ui_fitfont(12, 13 * sc);         // section titles, knob labels
  tg_f13 = ui_fitfont(13, 17 * sc);         // corner names
);
gfx_setfont(11, "Trebuchet MS", tg_f11, 'b');
gfx_setfont(12, "Trebuchet MS", tg_f12, 'b'); gfx_setfont(13, "Trebuchet MS", tg_f13, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');   // the card's name
gfx_setfont(15, "Georgia", 23 * sc, 'b');   // the numeral

// ---------- drawing helpers (GUI thread only; base coordinates) ----------
function tg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function tg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function tg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function tg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function tg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function tg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
// a bold ink line (a filled quad with round ends)
function tg_ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  x1 *= sc; y1 *= sc; x2 *= sc; y2 *= sc; w *= sc * 0.5;
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function tg_frame(x, y, w, h, t) ( tg_r(x, y, w, t); tg_r(x, y + h - t, w, t); tg_r(x, y, t, h); tg_r(x + w - t, y, t, h); );

// a section: a recessed tray in its own shade of charcoal, a pale gold title band ruled in ink
function tg_sect(x, y, w, h, shade, title) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  ui_col(GOLD); tg_r(x, y, w, 20);
  ui_cola(0xFFFFFF, 0.22); tg_r(x, y, w, 1);
  ui_col(INK); tg_r(x, y + 20, w, 1.5);
  strlen(title) ? ( gfx_setfont(12); ui_col(INK); tg_t(x + 9, y + 3, title); );
);
// a title placed over part of a band, with an ink tick between groups
function tg_sub(x, y, s) ( gfx_setfont(12); ui_col(INK); tg_t(x, y + 3, s); );
function tg_div(x, y, h) ( ui_col(INK); tg_r(x, y, 1.5, h); );

// ---------- the HOUSE WHITE CAP knob ----------
function tg_arcw(cx, cy, r, a1, a2, w) local(k) (       // a smooth thick arc: anti-aliased arcs every half pixel
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function tg_lcap(cx, cy, r, n, col, trk) local(rr, a, a0, ca, sa, w, i) (
  rr = r + 5.5 * sc; w = 3 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(trk); tg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  n > 0.004 ? (
    ui_col(col); tg_arcw(cx, cy, rr, a0, a, w);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); gfx_circle(cx + ca * rr, cy + sa * rr, w * 0.5, 1, 1);
  );
  ui_cola(0x000000, 0.28); gfx_circle(cx + 1 * sc, cy + 2 * sc, r, 1, 1);
  ui_col(0x50565E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0xC9CED4); gfx_circle(cx, cy, r - 1.4 * sc, 1, 1);
  ui_col(0xE6E9EC); tg_arcw(cx, cy, r - 3 * sc, -0.66 * $pi, 0.06 * $pi, 1.4 * sc);
  ui_col(0x1A1E24); i = -1;
  ui_ssline(cx + ca * r * 0.3, cy + sa * r * 0.3, cx + ca * (r - 3 * sc), cy + sa * (r - 3 * sc), 2.4 * sc, 1);
);
// the value pill (shown only while the knob is touched)
function tg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(11); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 3 * sc, 3 * sc);
  ui_col(BONEH); ui_rrect(cx * sc - tw * 0.5 - 5 * sc, y * sc + 1 * sc, tw + 10 * sc, th + 1 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 1.5 * sc; gfx_drawstr(s);
);
// a knob: drag, SHIFT = fine, double-click = default, wheel; stp > 0 rounds to steps; fmt "" shows #tg_vs
function tg_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - tg_lt < 0.35 && tg_lid == idx ? ( tg_set(idx, def); drag_id = -1; tg_lt = 0; ) : (
      drag_id = did; tg_ky = mouse_y; tg_lt = time_precise(); tg_lid = idx;
      tg_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    tg_kn = min(max(tg_kn + (tg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); tg_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ tg_kn : lo + tg_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? tg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    tg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  tg_lcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), tg_acc, tg_trk);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, (r - 1.5) * sc, 1, 1);
    strlen(fmt) ? sprintf(#tg_vv, fmt, v) : strcpy(#tg_vv, #tg_vs);
    tg_pill(cx, cy + r + 5, #tg_vv);
  ) : (
    gfx_setfont(12); ui_col(tg_ink); tg_tc(cx, cy + r + 13, label);
  );
);
tg_acc = ROSE; tg_trk = 0x18171A; tg_ink = LBL;

// ---------- keys that light up (lit = on); returns 1 when clicked ----------
function tg_key(x, y, w, h, on, s) local(hov, hit) (
  hov = tg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(ROSEL, 0.30); tg_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.3); tg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); tg_rr(x, y, w, h, 3);
  ui_col(on ? ROSE : hov ? KEYHOV : KEYOFF); tg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.38); tg_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.10); tg_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? INK : LBL); tg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
// a row of keys for a stepped slider
function tg_keys(x, y, w, h, gap, idx, n, labels) local(i) (
  i = 0;
  loop(n, tg_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == i, pk_pitem(labels, i + 1, #tg_k)) ? tg_set(idx, i); i += 1; );
);
// LFO shape glyphs: 0 sine 1 triangle 2 saw 3 S&H 4 smooth random
function tg_glyph(cx, cy, t, col) local(i, x0, y0, x1, y1, hh) (
  ui_col(col); hh = 5;
  t == 0 ? ( i = 0; loop(16, x0 = cx - 8 + i; x1 = x0 + 1;
             tg_ln(x0, cy - sin(i / 16 * 2 * $pi) * hh, x1, cy - sin((i + 1) / 16 * 2 * $pi) * hh, 1.6); i += 1; ); ) :
  t == 1 ? ( tg_ln(cx - 8, cy, cx - 4, cy - hh, 1.6); tg_ln(cx - 4, cy - hh, cx + 4, cy + hh, 1.6); tg_ln(cx + 4, cy + hh, cx + 8, cy, 1.6); ) :
  t == 2 ? ( tg_ln(cx - 8, cy + hh, cx + 6, cy - hh, 1.6); tg_ln(cx + 6, cy - hh, cx + 6, cy + hh, 1.6); ) :
  t == 3 ? ( tg_ln(cx - 8, cy + 2, cx - 3, cy + 2, 1.6); tg_ln(cx - 3, cy + 2, cx - 3, cy - hh, 1.6); tg_ln(cx - 3, cy - hh, cx + 2, cy - hh, 1.6);
             tg_ln(cx + 2, cy - hh, cx + 2, cy + hh, 1.6); tg_ln(cx + 2, cy + hh, cx + 8, cy + hh, 1.6); ) :
  ( x0 = cx - 8; y0 = cy + 1; i = 0;
    loop(16, x1 = cx - 8 + i + 1; y1 = cy + (sin((i + 1) * 0.55) * 0.6 + sin((i + 1) * 0.23 + 1) * 0.5) * hh;
             tg_ln(x0, y0, x1, y1, 1.6); x0 = x1; y0 = y1; i += 1; ); );
);
// a field that shows a setting; returns 1 when clicked
function tg_field(x, y, w, h, s) local(hov, hit) (
  hov = tg_hov(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_col(INK); tg_rr(x, y, w, h, 3);
  ui_col(hov ? BONEH : BONE); tg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(11); ui_col(INK); tg_tc(x + (w - 9) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 12) * sc, (y + h * 0.5 - 2) * sc, (x + w - 5) * sc, (y + h * 0.5 - 2) * sc, (x + w - 8.5) * sc, (y + h * 0.5 + 2.5) * sc);
  hit;
);
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function tg_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#tg_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#tg_mls, ">"); strcat(#tg_mls, pk_pitem(list, i + 1, #tg_mi)); strcat(#tg_mls, " - ");
                      strcat(#tg_mls, pk_pitem(list, min(s0 + grp, n), #tg_mi)); strcat(#tg_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#tg_mls, "<");
    i == cur ? strcat(#tg_mls, "!");
    strcat(#tg_mls, pk_pitem(list, i + 1, #tg_mi));
    i < n - 1 ? strcat(#tg_mls, "|");
    i += 1; );
  #tg_mls;
);
// a value field (the house drop-down field): a click opens the list of every value (list: lo..hi, grp > 0 groups it
// in submenus of grp), the current one ticked; the wheel steps it
function tg_dfield(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = tg_hov(x, y, w, h);
  tg_field(x, y, w, h, s) ? (
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(tg_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? tg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( tg_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
function tg_setname(k) ( k == 0 ? "A" : k == 1 ? "E" : k == 2 ? "I" : k == 3 ? "O" : k == 4 ? "U" : k == 5 ? "STONE" : k == 6 ? "GLASS" : k == 7 ? "STORM" : "CHOIR"; );
function tg_nname(n) local(o) (
  o = floor(n / 12) - 1;
  sprintf(#tg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #tg_k), o);
  #tg_nn;
);

// ---------- the mystic rose: five bone-white petals round a pale gold heart ----------
function tg_flower(cx, cy, r) local(k, a, px, py) (
  ui_col(INK); k = 0;
  loop(5, a = -0.5 * $pi + k * 0.4 * $pi; gfx_circle((cx + cos(a) * r * 0.52) * sc, (cy + sin(a) * r * 0.52) * sc, (r * 0.5 + 1.2) * sc, 1, 1); k += 1; );
  ui_col(BONEH); k = 0;
  loop(5, a = -0.5 * $pi + k * 0.4 * $pi; px = cx + cos(a) * r * 0.52; py = cy + sin(a) * r * 0.52;
          gfx_circle(px * sc, py * sc, r * 0.5 * sc, 1, 1); k += 1; );
  ui_col(INK); gfx_circle(cx * sc, cy * sc, (r * 0.34 + 1) * sc, 1, 1);
  ui_col(GOLD); gfx_circle(cx * sc, cy * sc, r * 0.34 * sc, 1, 1);
);
// a small tower on the horizon (a dark silhouette with a crenellated top)
function tg_turret(cx, by, w, h) local(k) (
  ui_col(INK); tg_r(cx - w * 0.5, by - h, w, h);
  k = 0; loop(3, tg_r(cx - w * 0.5 - 1 + k * (w + 2) * 0.5 - (k == 2 ? 3 : 0), by - h - 3, 3, 3.5); k += 1; );
  ui_col(GOLD); tg_r(cx - 1, by - h * 0.62, 2, 4);
);

// ---------- the emblem: the black banner with the white rose; the sun rising between two towers, the river ----------
function tg_emblem(x, y, w, h, fl) local(cx, hy, i, k, sx, sy, bw, bh, sr) (
  // the cartouche
  ui_cola(0x000000, 0.3); tg_rr(x + 1.5, y + 2.5, w, h, 6);
  ui_col(INK); tg_rr(x, y, w, h, 6);
  ui_col(BONE); tg_rr(x + 2, y + 2, w - 4, h - 4, 5);
  // the sky in flat bands: night above, paling to gold at the horizon
  hy = y + h * 0.66;
  k = 0; loop(6, ui_col(ui_mix(ui_mix(0x1B1A1E, 0x8C7458, k / 5), BONEH, fl * 0.4)); tg_r(x + 5, y + 5 + k * (hy - y - 5) / 6, w - 10, (hy - y - 5) / 6 + 0.5); k += 1; );
  // the sun, half risen between the two towers, with a few flat rays
  cx = x + w * 0.71; sr = w * 0.11;
  ui_col(GOLD); k = 0;
  loop(7, sx = $pi * (1 + k / 6); tg_ln(cx + cos(sx) * (sr + 3), hy + sin(sx) * (sr + 3), cx + cos(sx) * (sr + 8), hy + sin(sx) * (sr + 8), 1.6); k += 1; );
  ui_col(INK); gfx_circle(cx * sc, hy * sc, (sr + 1.2) * sc, 1, 1);
  ui_col(0xF0DCA6); gfx_circle(cx * sc, hy * sc, sr * sc, 1, 1);
  tg_turret(cx - sr - 7, hy, 8, 18); tg_turret(cx + sr + 7, hy, 8, 18);
  // the land and the river winding across it
  ui_col(0x2A2826); tg_r(x + 5, hy, w - 10, y + h - 5 - hy);
  ui_col(INK); tg_r(x + 5, hy - 0.5, w - 10, 1.5);
  ui_col(RIVER); i = 0;
  loop(8, sx = x + 6 + i * (w - 12) / 8; sy = hy + 13 + sin(i * 0.9) * 3.5;
          tg_ln(sx, sy, sx + (w - 12) / 8, hy + 13 + sin((i + 1) * 0.9) * 3.5, 2.6); i += 1; );
  ui_cola(BONEH, 0.5); tg_ln(cx - 8, hy + 5, cx + 8, hy + 5, 1); tg_ln(cx - 4, hy + 8, cx + 4, hy + 8, 1);
  ui_col(INK); tg_frame(x + 4, y + 4, w - 8, h - 8, 1.2);
  // the staff and the black banner (swallow-tailed), the white rose upon it
  sx = x + 15; bw = w * 0.29; bh = h * 0.38; sy = y + 13;
  ui_col(INK); tg_r(sx - 2, y + 8, 4, h - 16);
  ui_col(GOLD); tg_r(sx - 1, y + 9, 2, h - 18); gfx_circle(sx * sc, (y + 9) * sc, 2.8 * sc, 1, 1);
  ui_col(INK);
  gfx_triangle((sx + 1) * sc, sy * sc, (sx + 1 + bw) * sc, sy * sc, (sx + 1 + bw) * sc, (sy + bh) * sc, (sx + 1) * sc, (sy + bh) * sc);
  gfx_triangle((sx + 1) * sc, (sy + bh - 1) * sc, (sx + 1 + bw * 0.5) * sc, (sy + bh - 1) * sc, (sx + 1) * sc, (sy + bh + 10) * sc);
  gfx_triangle((sx + 1 + bw * 0.5) * sc, (sy + bh - 1) * sc, (sx + 1 + bw) * sc, (sy + bh - 1) * sc, (sx + 1 + bw) * sc, (sy + bh + 10) * sc);
  ui_cola(BONEH, 0.25); tg_r(sx + 3, sy + 2, bw - 4, 1);
  tg_flower(sx + 1 + bw * 0.5, sy + bh * 0.5, bw * 0.38);
);

// ---------- the LFO path the point will trace (from the settings, around the centre) ----------
function tg_shape(sh, ph) ( ph -= floor(ph); sh == 0 ? sin(2 * $pi * ph) : sh == 1 ? 1 - 4 * abs(ph - 0.5) : 2 * ph - 1; );
function tg_path() local(n, i, t, lx, ly, rad, cx0, cy0, xd, yd, sx, sy, ph, tt) (
  cx0 = slider14 / 100 + tw_dcx; cy0 = slider15 / 100 + tw_dcy;
  xd = slider23 / 100 * 0.5; yd = slider28 / 100 * 0.5; sx = floor(slider19 + 0.5); sy = floor(slider24 + 0.5); ph = slider29 / 360;
  tg_pn = 0; tg_pbox = 0;
  slider30 == 4 || (sx >= 3) || (sy >= 3 && slider30 == 0) || (sy >= 3) ? tg_pbox = 1 : (
    n = slider30 == 3 ? 320 : slider30 == 0 ? 360 : 120;
    tt = slider30 == 0 ? 3 / max(min(tw_xr, tw_yr), 0.0001) : 1;
    i = 0;
    loop(n + 1,
      t = i / n;
      slider30 == 0 ? (
        lx = tg_shape(sx, tw_xr * tt * t); ly = tg_shape(sy, tw_yr * tt * t + ph);
      ) : slider30 == 3 ? (
        lx = tg_shape(sx, 8 * t); ly = tg_shape(sy, 8 * t + ph); rad = 0.12 + 0.88 * (1 - abs(2 * t - 1));
        lx *= rad; ly *= rad;
      ) : (
        lx = tg_shape(sx, t); ly = tg_shape(sy, (slider30 == 2 ? 2 : 1) * t + ph - (slider30 == 2 ? 0.25 : 0));
      );
      TGPX[i] = min(max(cx0 + lx * xd, 0), 1); TGPY[i] = min(max(cy0 + ly * yd, 0), 1);
      i += 1;
    );
    tg_pn = n + 1;
  );
);

// ---------- the XY pad ----------
function tg_pad(x, y, w, h) local(i, k, px, py, qx, qy, a, ox, oy, mx, my, inpad, c, tx, ty, tw2, hit, q, lx, ly, col) (
  // a night sky paling towards dawn, in flat bands
  k = 0; loop(7, ui_col(ui_mix(0x18171B, 0x3E3439, k / 6)); tg_r(x, y + k * h / 7, w, h / 7 + 0.5); k += 1; );
  // quarter guides
  ui_cola(LBL, 0.16); tg_r(x + w * 0.5, y, 1, h); tg_r(x, y + h * 0.5, w, 1);
  ui_cola(LBL, 0.07); tg_r(x + w * 0.25, y, 1, h); tg_r(x + w * 0.75, y, 1, h); tg_r(x, y + h * 0.25, w, 1); tg_r(x, y + h * 0.75, w, 1);
  // the path
  tg_path();
  tg_pbox ? (
    ui_cola(GOLD, 0.75);
    ox = min(max(slider14 / 100 + tw_dcx - slider23 / 200, 0), 1); oy = min(max(slider15 / 100 + tw_dcy + slider28 / 200, 0), 1);
    qx = min(max(slider14 / 100 + tw_dcx + slider23 / 200, 0), 1); qy = min(max(slider15 / 100 + tw_dcy - slider28 / 200, 0), 1);
    i = 0; loop(24, a = i / 24;
      tg_r(x + (ox + (qx - ox) * a) * w, y + (1 - oy) * h, w * (qx - ox) / 48, 1.5); tg_r(x + (ox + (qx - ox) * a) * w, y + (1 - qy) * h - 1.5, w * (qx - ox) / 48, 1.5);
      tg_r(x + ox * w, y + (1 - oy + (oy - qy) * a) * h, 1.5, h * (oy - qy) / 48); tg_r(x + qx * w - 1.5, y + (1 - oy + (oy - qy) * a) * h, 1.5, h * (oy - qy) / 48);
      i += 2; );
  ) : tg_pn > 1 ? (
    ui_cola(GOLD, 0.85); i = 1;
    loop(tg_pn - 1, tg_ln(x + TGPX[i - 1] * w, y + (1 - TGPY[i - 1]) * h, x + TGPX[i] * w, y + (1 - TGPY[i]) * h, 1.6); i += 1; );
  );
  // the trail (the last half second or so)
  tg_tn < 40 ? tg_tn += 1;
  i = 39; loop(39, TGX[i] = TGX[i - 1]; TGY[i] = TGY[i - 1]; i -= 1; );
  TGX[0] = tw_px; TGY[0] = tw_py;
  i = tg_tn - 1;
  loop(tg_tn - 1,
    ui_cola(ROSEL, 0.75 * (1 - i / 40)); tg_ln(x + TGX[i] * w, y + (1 - TGY[i]) * h, x + TGX[i - 1] * w, y + (1 - TGY[i - 1]) * h, 3.2 * (1 - i / 50));
    i -= 1;
  );
  // the centre the LFOs orbit, joined to the point
  ox = x + slider14 / 100 * w; oy = y + (1 - slider15 / 100) * h;
  px = x + tw_px * w; py = y + (1 - tw_py) * h;
  ui_cola(LBL, 0.35); gfx_line(ox * sc, oy * sc, px * sc, py * sc, 1);
  ui_col(INK); gfx_circle(ox * sc, oy * sc, 6 * sc, 1, 1); ui_col(LBL); gfx_circle(ox * sc, oy * sc, 4.5 * sc, 1, 1); ui_col(INK); gfx_circle(ox * sc, oy * sc, 2 * sc, 1, 1);
  ui_cola(0x000000, 0.35); gfx_circle((px + 1) * sc, (py + 2) * sc, 9 * sc, 1, 1);
  ui_col(INK); gfx_circle(px * sc, py * sc, 9 * sc, 1, 1);
  ui_col(ROSE); gfx_circle(px * sc, py * sc, 7.2 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.55); gfx_circle((px - 2.2) * sc, (py - 2.4) * sc, 2.2 * sc, 1, 1);
  // the four corners: their formant sets (click to choose)
  hit = 0; c = 0;
  loop(4,
    k = floor(slider(10 + c) + 0.5);
    tw2 = k < 5 ? 32 : 66;
    tx = c == 0 || c == 2 ? x + 7 : x + w - 7 - tw2; ty = c < 2 ? y + 7 : y + h - 7 - 27;
    ui_cola(0x000000, 0.35); tg_rr(tx + 1, ty + 2, tw2, 27, 5);
    ui_col(INK); tg_rr(tx, ty, tw2, 27, 5);
    ui_col(tg_hov(tx, ty, tw2, 27) ? BONEH : BONE); tg_rr(tx + 1.5, ty + 1.5, tw2 - 3, 24, 4);
    gfx_setfont(k < 5 ? 13 : 11); ui_col(INK); tg_tc(tx + tw2 * 0.5, ty + 14, tg_setname(k));
    tg_hov(tx, ty, tw2, 27) && pressed && drag_id == 0 ? (
      drag_id = -1; hit = 1;
      strcpy(#tg_m, ""); i = 0;
      loop(9, i == k ? strcat(#tg_m, "!"); strcat(#tg_m, i < 5 ? tg_setname(i) : i == 5 ? "STONE (dark)" : i == 6 ? "GLASS (bright)" : i == 7 ? "STORM (nasal)" : "CHOIR");
              i < 8 ? strcat(#tg_m, "|"); i += 1; );
      gfx_x = tx * sc; gfx_y = (ty + 27) * sc; i = gfx_showmenu(#tg_m); i > 0 ? tg_set(10 + c, i - 1);
    );
    c += 1;
  );
  // the layers' points: a ring where they are anchored (drag it), the dot where they are now
  k = 0;
  loop(2,
    q = k ? TLP : TLB; i = k ? 86 : 75; col = k ? PEDC : BASSC;
    slider(k ? 80 : 69) >= 0.5 ? (
      ox = x + slider(i) / 100 * w; oy = y + (1 - slider(i + 1) / 100) * h;
      lx = x + q[15] * w; ly = y + (1 - q[16]) * h;
      ui_cola(col, 0.5); gfx_line(ox * sc, oy * sc, lx * sc, ly * sc, 1);
      ui_cola(BONEH, 0.6); gfx_circle(ox * sc, oy * sc, 6.5 * sc, 0, 1); gfx_circle(ox * sc, oy * sc, 4.5 * sc, 0, 1);
      ui_col(col); gfx_circle(ox * sc, oy * sc, 5.5 * sc, 0, 1);
      ui_col(INK); gfx_circle(lx * sc, ly * sc, 8.5 * sc, 1, 1); ui_col(col); gfx_circle(lx * sc, ly * sc, 7 * sc, 1, 1);
      gfx_setfont(11); ui_col(INK); tg_tc(lx, ly + 0.5, k ? "P" : "B");
      pressed && drag_id == 0 && sqr(mouse_x - ox * sc) + sqr(mouse_y - oy * sc) <= sqr(9 * sc) ? drag_id = 3002 + k;
      drag_id == 3002 + k ? (
        mx = min(max((mouse_x / sc - x) / w, 0), 1); my = min(max(1 - (mouse_y / sc - y) / h, 0), 1);
        slider(i) != mx * 100 ? tg_set(i, mx * 100); slider(i + 1) != my * 100 ? tg_set(i + 1, my * 100);
        sprintf(#tg_vv, "%s  X %.0f   Y %.0f", k ? "PEDAL" : "BASS", slider(i), slider(i + 1)); tg_pill(x + w * 0.5, y + h - 20, #tg_vv);
      );
    );
    k += 1;
  );
  // drag the centre (double-click: back to the middle)
  inpad = tg_hov(x, y, w, h);
  pressed && inpad && drag_id == 0 ? (
    time_precise() - tg_plt < 0.35 ? ( tg_set(14, 50); tg_set(15, 50); drag_id = -1; tg_plt = 0; ) : ( drag_id = 3001; tg_plt = time_precise(); );
  );
  drag_id == 3001 ? (
    mx = min(max((mouse_x / sc - x) / w, 0), 1); my = min(max(1 - (mouse_y / sc - y) / h, 0), 1);
    slider14 != mx * 100 ? tg_set(14, mx * 100); slider15 != my * 100 ? tg_set(15, my * 100);
  );
  ((inpad && drag_id != 3002 && drag_id != 3003) || drag_id == 3001) ? ( sprintf(#tg_vv, "X %.0f   Y %.0f", slider14, slider15); tg_pill(x + w * 0.5, y + h - 20, #tg_vv); );
  // the frame
  ui_col(INK); tg_frame(x - 2, y - 2, w + 4, h + 4, 2);
);

// ---------- the card ----------
// card stock with an ink frame, the field in charcoal
ui_col(BONE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); tg_rr(4, 4, 1092, 592, 9);
ui_col(BONE); tg_rr(6.5, 6.5, 1087, 587, 7);
ui_col(INK); tg_r(11, 11, 1078, 578);
ui_col(COAL); tg_r(13, 13, 1074, 574);
// header band
ui_col(COALX); tg_r(13, 13, 1074, 44);
ui_col(INK); tg_r(13, 57, 1074, 2);

// the numeral, in a bone cartouche at the top of the card
ui_col(INK); tg_rr(497, 15, 106, 38, 6); ui_col(BONE); tg_rr(499, 17, 102, 34, 5);
ui_col(INK); tg_frame(502, 20, 96, 28, 1);
gfx_setfont(15); ui_col(INK); tg_tc(550, 34.5, "XIII");
tg_flower(478, 35, 12); tg_flower(622, 35, 12);
ui_col(ROSE); gfx_circle(461 * sc, 35 * sc, 2.5 * sc, 1, 1); gfx_circle(639 * sc, 35 * sc, 2.5 * sc, 1, 1);

// preset bar
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(22 * sc, 18 * sc, 372 * sc, 34 * sc, pr_cur, #tw_pm);
k_ > 0 ? ( k_ > 14 ? reset_all() : prs_dirty = k_; );
gfx_setfont(12); ui_col(LBL); tg_t(650, 19, "QUADRANT FORMANT"); ui_cola(LBL, 0.75); tg_t(650, 35, "SYNTHESIZER");
// MIDI: activity LED and channel
pk_led(816 * sc, 35 * sc, 4.5 * sc, ins_midi_lit(), ROSEL);
gfx_setfont(11); ui_col(LBL); tg_tc(816, 22, "MIDI");
sprintf(#tg_g, slider62 < 0.5 ? "OMNI" : "CH %.0f", slider62);
tg_field(832, 23, 70, 24, #tg_g) ? (
  strcpy(#tg_m, ""); k_ = 0;
  loop(17, k_ == floor(slider62 + 0.5) ? strcat(#tg_m, "!"); k_ == 0 ? strcat(#tg_m, "Omni") : ( sprintf(#tg_k, "Channel %d", k_); strcat(#tg_m, #tg_k); ); k_ < 16 ? strcat(#tg_m, "|"); k_ += 1; );
  gfx_x = 832 * sc; gfx_y = 47 * sc; k_ = gfx_showmenu(#tg_m); k_ > 0 ? tg_set(62, k_ - 1);
);
tg_n = 0; k_ = 0; loop(8, TV[k_ * 64 + 8] > 0 ? tg_n += 1; k_ += 1; );
gfx_setfont(12); ui_col(LBL); sprintf(#tg_g, "VOICES %d/8", tg_n); tg_t(914, 27, #tg_g);
ui_size_picker(1018 * sc, 26 * sc);

// ---------- OSCILLATORS ----------
tg_sect(20, 66, 368, 112, SHA, "OSCILLATORS");
gfx_setfont(12); ui_col(LBL); tg_tc(37, 102, "1"); tg_tc(212, 102, "2");
tg_keys(47, 91, 48, 22, 4, 1, 3, "SAW|PULSE|CHOIR");
tg_keys(222, 91, 48, 22, 4, 2, 3, "SAW|PULSE|CHOIR");
tg_knob(48,  145, 14, 3, -24, 24, 0, 0, "PITCH", "%+.0f st", 1);
tg_knob(98,  145, 14, 4, -50, 50, 7, 0, "DETUNE", "%+.1f ct", 0);
tg_knob(148, 145, 14, 5, 0, 100, 40, 0, "MIX", "%.0f%%", 0);
tg_knob(198, 145, 14, 6, 5, 95, 50, 0, "PW", "%.0f%%", 0);
tg_knob(248, 145, 14, 7, 0, 60, 22, 0, "SPREAD", "%.1f ct", 0);
