drag_id != 2061 && !(sqr(mouse_x - 132 * sc) + sqr(mouse_y - 567 * sc) <= sqr(19 * sc)) ? ( gfx_setfont(12); ui_col(LBL); tg_t(152, 560, "VOLUME"); );
