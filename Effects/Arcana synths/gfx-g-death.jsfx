tg_i = 0; loop(18, tg_on = tg_i / 18 < tg_lv; ui_col(tg_on ? (tg_i >= 16 ? 0xFF3A2A : tg_i >= 13 ? ROSEL : GOLD) : 0x2A292D); tg_r(963 + tg_i * 6, 566, 4.6, 8); tg_i += 1; );
gfx_setfont(11); ui_col(LBL); tg_t(960, 548, "LEVEL");

