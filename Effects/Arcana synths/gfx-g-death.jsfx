tg_knob(348, 267, 14, 47, 0, 24, 2, 0, "BEND", "%.0f st", 1);

// ---------- MOD ----------
tg_sect(20, 310, 368, 110, SHC, "");
tg_sub(29, 310, "WHEEL"); tg_div(124, 310, 20); tg_sub(133, 310, "VELOCITY"); tg_div(228, 310, 20); tg_sub(237, 310, "ENVELOPE");
