tg_ea = log(1 + slider48); tg_ed = log(1 + slider49); tg_er = log(1 + slider51); tg_es = slider50 / 100;
tg_tt = tg_ea + tg_ed + tg_er + 2; tg_sx = 155 / tg_tt; tg_x = 219;
ui_col(GOLD);
tg_ln(tg_x, 233, tg_x + tg_ea * tg_sx, 215, 1.6); tg_x += tg_ea * tg_sx;
tg_ln(tg_x, 215, tg_x + tg_ed * tg_sx, 233 - 18 * tg_es, 1.6); tg_x += tg_ed * tg_sx;
tg_ln(tg_x, 233 - 18 * tg_es, tg_x + 2 * tg_sx, 233 - 18 * tg_es, 1.6); tg_x += 2 * tg_sx;
tg_ln(tg_x, 233 - 18 * tg_es, 375, 233, 1.6);
tg_knob(48,  267, 14, 48, 1, 5000, 30, 1, "ATT", "%.0f ms", 0);
tg_knob(98,  267, 14, 49, 5, 8000, 800, 1, "DEC", "%.0f ms", 0);
tg_knob(148, 267, 14, 50, 0, 100, 85, 0, "SUS", "%.0f%%", 0);
tg_knob(198, 267, 14, 51, 5, 10000, 600, 1, "REL", "%.0f ms", 0);
