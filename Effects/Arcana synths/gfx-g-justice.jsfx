desc:Justice [Arcana synth] (GFX)
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//tags: instrument synthesizer bass acid arcana
/*
  JUSTICE (card XI of the GFX Arcana series) - "AEGIS"
  A precise, symmetrical mono synth for doom and acid bass (and glassy leads / pads).
  Every control has a counterweight; the panel is split down the middle by the blade.

  ENGINE
  OSC A / OSC B   Saw / Square / Triangle / Sine each, phase-locked: both restart together on a fresh note.
  SUB             Rounded square one octave below OSC A (doom weight).
  GLIDE           Legato slide time (overlapping notes slide, 303-style; detached notes retrigger).
  BALANCE         Weighs OSC A against OSC B (equal power).
  MIRROR          Phase offset of OSC B against OSC A (0-180 deg). 180 on saws = octave-up hollowing.
  WEIGHT          "True Weight": A and B start detuned symmetrically (up to +/-25 ct) and converge
                  onto a locked unison over ~1 s - the longer a note is held, the purer it gets.
  WIDTH           Splits A hard left / B hard right (sub stays centre).
  LOW-PASS        24 dB ZDF filter: CUTOFF, RESO (saturating, self-oscillates at the top), ENV amount,
                  DECAY (filter envelope), ACCENT (velocity above 64 adds a fast cutoff/level/reso kick).
  EQUILIBRIUM     High-pass inversely linked to CUTOFF: at 0 it sits at 20 Hz; turned up, the high-pass
                  follows the low-pass upward at a fixed window, so opening one side tightens the other.
  DRIVE           Saturation after the filter, four modes (keys under the dial):
                  SOFT  - anti-aliased (ADAA) tanh, the original sound
                  HARD  - big pre-gain into an ADAA hard clipper with slight asymmetry (buzzsaw fuzz)
                  FOLD  - ADAA sine wavefolder: more drive = more folds (metallic, clangy)
                  CRUSH - partial rectifier, then sample-rate and bit reduction (broken-machine grit)
                  Mode changes fade over a few ms (no clicks); the mode is stored per preset.
  RETRIBUTION     Corrective compressor: the harder the key (velocity / aftertouch), the higher the
                  ratio - velocity spikes are punished, dynamics levelled. Also flattens velocity->level.
  CHAMBER / SIZE  Stone-hall reverb send; its wet tail self-balances L/R towards equilibrium.
  LFO 1 / LFO 2   Sine / Triangle / Step (fixed 8-step sequence), zero jitter, restart on each fresh
                  note. Targets: Pitch, Cutoff, Balance, Mirror, Width, Amp. Mod wheel adds LFO 1 depth.
  QUANTISE        Snaps both LFOs to quarter steps; pitch modulation snaps to 0 / 4th / 5th / octave.
  ENVELOPE        Verdict DAHDSR: DELAY, ATTACK (0 = 0.5 ms sword-drop), HOLD, DECAY, SUSTAIN, RELEASE.
  FATE            Scales tipping: slow, self-correcting wander of the L/R balance and the A/B weight -
                  the scales tip, overshoot slightly and settle back to centre.
  MONO            Mono maker: sums everything below 60 / 120 / 240 Hz to mono (24 dB high-pass on the side
                  signal). Click the lit key again for off. Stored per preset.
  OUTPUT          Level, then the Verdict clipper (ADAA hard clip, always on).

  MIDI: notes, velocity, pitch bend (range hidden param, default 2), mod wheel, aftertouch, CC120/123.
  GUI: drag knobs (Shift = fine), wheel, double-click or Ctrl-click resets, value shows on hover.
  Presets: PRESETS key or LCD opens the list, arrows step through. Panel fills the window.
*/

in_pin:none
out_pin:Left
out_pin:Right

slider1:0<0,3,1{Saw,Square,Triangle,Sine}>-Osc A Wave
slider2:0<0,3,1{Saw,Square,Triangle,Sine}>-Osc B Wave
slider3:0<-100,100,1>-Balance A/B
slider4:0<0,180,1>-Mirror (deg)
slider5:10<0,100,0.1>-True Weight
slider6:20<0,100,0.1>-Width
slider7:0<0,100,0.1>-Sub
slider8:38<0,100,0.1>-Cutoff
slider9:72<0,100,0.1>-Resonance
slider10:15<0,100,0.1>-Equilibrium
slider11:65<0,100,0.1>-Env Amount
slider12:35<0,100,0.1>-Filter Decay
slider13:70<0,100,0.1>-Accent
slider14:45<0,100,0.1>-Drive
slider15:0<0,100,0.1>-Delay
slider16:0<0,100,0.1>-Attack
slider17:0<0,100,0.1>-Hold
slider18:60<0,100,0.1>-Decay
slider19:80<0,100,0.1>-Sustain
slider20:25<0,100,0.1>-Release
slider21:35<0,100,0.1>-Glide
slider22:40<0,100,0.1>-LFO 1 Rate
slider23:0<0,2,1{Sine,Triangle,Step}>-LFO 1 Shape
slider24:0<0,100,0.1>-LFO 1 Depth
slider25:1<0,5,1{Pitch,Cutoff,Balance,Mirror,Width,Amp}>-LFO 1 Target
slider26:30<0,100,0.1>-LFO 2 Rate
slider27:0<0,2,1{Sine,Triangle,Step}>-LFO 2 Shape
slider28:0<0,100,0.1>-LFO 2 Depth
slider29:1<0,5,1{Pitch,Cutoff,Balance,Mirror,Width,Amp}>-LFO 2 Target
slider30:0<0,1,1{Off,On}>-Quantise
slider31:30<0,100,0.1>-Retribution
slider32:8<0,100,0.1>-Chamber
slider33:40<0,100,0.1>-Chamber Size
slider34:25<0,100,0.1>-Fate
slider35:0<-24,12,0.1>-Output (dB)
slider36:0<0,11,1>-Preset
slider37:2<0,12,1>-Bend Range
slider38:2<0,3,1{Off,60 Hz,120 Hz,240 Hz}>-Mono Maker
slider39:0<0,3,1{Soft,Hard,Fold,Crush}>-Drive Mode

options:gfx_hz=60

@init
ext_noinit = 1;
LN2 = log(2);
NPRE = 12;
DRV_H = 0.53; DRV_F = 0.67; DRV_C = 0.6;

// ---- memory map ----
NS   = 0;      // note stack (128)
EV   = 200;    // event buffer (4 x 256)
LSTP = 1900;   // LFO step table (8)
RMIN = 2300; RMAX = 2350; RDEF = 2400;
PRE  = 2500;   // presets, 35 values each
PREM = 3000;   // per-preset drive mode
PREMM = 3020;  // per-preset mono maker
RVB  = 4000;   // reverb buffers, 12 x 16384
RVS  = 16384;
freembuf(RVB + 12*RVS + 16);

LSTP[0]=1; LSTP[1]=-1; LSTP[2]=0.5; LSTP[3]=-0.5; LSTP[4]=0.75; LSTP[5]=-0.25; LSTP[6]=0; LSTP[7]=-0.75;

// ---- helpers ----
function clampv(x,a,b) ( x<a ? a : x>b ? b : x );
function th(x) local(x2) ( x = clampv(x,-3,3); x2 = x*x; x*(27+x2)/(27+9*x2) );
function tanh_e(x) local(e) ( x = clampv(x,-20,20); e = exp(2*x); (e-1)/(e+1) );
function lcosh(x) local(a) ( a = abs(x); a + log(1+exp(-2*a)) - 0.693147180559945 );

function adaa_t(x) instance(xp fp) local(f y) (
  f = lcosh(x);
  abs(x-xp) > 0.000001 ? ( y = (f-fp)/(x-xp); ) : ( y = tanh_e(0.5*(x+xp)); );
  xp = x; fp = f; y;
);
function adaa_f(u) instance(xp fp) local(f y) (
  f = -cos(1.5707963*u)/1.5707963;
  abs(u-xp) > 0.000001 ? ( y = (f-fp)/(u-xp); ) : ( y = sin(0.78539816*(u+xp)); );
  xp = u; fp = f; y;
);
function dcb(x) instance(x1 y1) ( y1 = x - x1 + dcr*y1; x1 = x; y1 );
function adaa_c(x) instance(xp fp) local(f y) (
  f = abs(x) <= 1 ? 0.5*x*x : abs(x) - 0.5;
  abs(x-xp) > 0.000001 ? ( y = (f-fp)/(x-xp); ) : ( y = clampv(0.5*(x+xp),-1,1); );
  xp = x; fp = f; y;
);

// ZDF state-variable stages
function svf_lp(x,a1,a2,a3) instance(ic1 ic2) local(v1 v2 v3) (
  v3 = x - ic2; v1 = a1*ic1 + a2*v3; v2 = ic2 + a2*ic1 + a3*v3;
  ic1 = 2*v1 - ic1; ic2 = 2*v2 - ic2; v2;
);
function svf_lps(x,a1,a2,a3) instance(ic1 ic2) local(v1 v2 v3) (
  v3 = x - ic2; v1 = a1*ic1 + a2*v3; v2 = ic2 + a2*ic1 + a3*v3;
  ic1 = 3*th((2*v1 - ic1)/3); ic2 = 2*v2 - ic2; v2;
);
function svf_hp(x,a1,a2,a3,k) instance(ic1 ic2) local(v1 v2 v3) (
  v3 = x - ic2; v1 = a1*ic1 + a2*v3; v2 = ic2 + a2*ic1 + a3*v3;
  ic1 = 2*v1 - ic1; ic2 = 2*v2 - ic2; x - k*v1 - v2;
);

function blep(t,dt) (
  t < dt ? (t /= dt; 2*t - t*t - 1) : t > 1-dt ? (t = (t-1)/dt; t*t + 2*t + 1) : 0;
);
function osc(w,ph,dt) local(y t) (
  w == 0 ? ( y = 2*ph - 1 - blep(ph,dt) ) :
  w == 1 ? ( y = (ph < 0.5 ? 1 : -1) + blep(ph,dt); t = ph + 0.5; t >= 1 ? t -= 1; y -= blep(t,dt) ) :
  w == 2 ? ( y = 1 - 4*abs(ph - 0.5) ) :
           ( y = sin(2*$pi*ph) );
  y;
);
function lfo_val(sh,ph) (
  sh == 0 ? sin(2*$pi*ph) : sh == 1 ? 1 - 4*abs(ph-0.5) : LSTP[floor(ph*8) & 7];
);

// reverb
function comb_init(b,l) instance(buf len p st) ( buf=b; len=l; p=0; st=0; memset(buf,0,RVS); );
function comb(x) instance(buf len p st) local(y) (
  y = buf[p]; st = y*(1-rv_damp) + st*rv_damp;
  buf[p] = x + st*rv_fb; p += 1; p >= len ? p = 0; y;
);
function ap_init(b,l) instance(buf len p) ( buf=b; len=l; p=0; memset(buf,0,RVS); );
function ap(x) instance(buf len p) local(y) (
  y = buf[p]; buf[p] = x + y*0.5; p += 1; p >= len ? p = 0; y - x;
);
function rv_init() local(s) (
  s = srate/44100*1.35;
  cL1.comb_init(RVB,         floor(1116*s)); cL2.comb_init(RVB+RVS,   floor(1188*s));
  cL3.comb_init(RVB+2*RVS,   floor(1277*s)); cL4.comb_init(RVB+3*RVS, floor(1356*s));
  cR1.comb_init(RVB+4*RVS,   floor(1139*s)); cR2.comb_init(RVB+5*RVS, floor(1211*s));
  cR3.comb_init(RVB+6*RVS,   floor(1300*s)); cR4.comb_init(RVB+7*RVS, floor(1379*s));
  aL1.ap_init(RVB+8*RVS,  floor(556*s));  aL2.ap_init(RVB+9*RVS,  floor(441*s));
  aR1.ap_init(RVB+10*RVS, floor(579*s));  aR2.ap_init(RVB+11*RVS, floor(464*s));
);

// ---- ranges / defaults ----
i = 1; loop(39, RMIN[i] = 0; RMAX[i] = 100; i += 1;);
RMAX[1]=3; RMAX[2]=3; RMIN[3]=-100; RMAX[4]=180; RMAX[23]=2; RMAX[27]=2; RMAX[25]=5; RMAX[29]=5;
RMAX[30]=1; RMAX[38]=3; RMAX[39]=3; RMIN[35]=-24; RMAX[35]=12; RMAX[36]=NPRE-1; RMAX[37]=12;

// ---- presets ----
// order: Awave Bwave bal mirror weight width sub | cut reso eq env fdec accent drive |
//        dly atk hold dec sus rel glide | l1rate l1shape l1depth l1dest l2rate l2shape l2depth |
//        l2dest quant retrib chamber size fate out
function ps(a,b,c,d,e,f,g) ( pp[0]=a; pp[1]=b; pp[2]=c; pp[3]=d; pp[4]=e; pp[5]=f; pp[6]=g; pp += 7; );
pp = PRE;
// 0 Verdict Acid
ps(0,0,0,0,10,20,0);     ps(38,72,15,65,35,70,45); ps(0,0,0,60,80,25,35);  ps(40,0,0,1,30,0,0);   ps(1,0,30,8,40,25,0);
// 1 Doom Gavel
ps(1,1,-20,90,30,30,70); ps(22,30,5,40,55,30,60);  ps(0,0,10,70,90,40,15); ps(15,0,10,1,8,0,0);   ps(1,0,40,10,60,30,0);
// 2 Scales of Equity
ps(3,2,0,90,60,90,0);    ps(70,15,20,10,60,0,0);   ps(0,45,0,80,85,80,0);  ps(18,0,15,4,9,0,10);  ps(1,0,20,45,85,40,-2);
// 3 Swift Blade
ps(1,0,10,45,15,40,0);   ps(55,35,30,55,22,40,15); ps(0,0,0,48,0,0,0);     ps(20,0,0,1,20,0,0);   ps(1,1,40,22,60,20,0);
// 4 Karmic Feedback
ps(0,3,-10,30,90,50,0);  ps(45,94,10,30,50,0,25);  ps(0,8,0,60,85,40,30);  ps(55,0,18,0,12,1,15); ps(1,0,25,35,70,30,-3);
// 5 Iron Statute
ps(1,0,0,180,0,10,50);   ps(30,55,10,55,45,50,75); ps(0,0,0,55,70,10,20);  ps(30,2,40,1,10,0,0);  ps(1,1,60,10,40,15,-1);
// 6 Blind Sentence
ps(0,1,0,60,20,40,20);   ps(35,65,10,45,30,55,35); ps(0,0,0,55,75,20,10);  ps(52,2,55,1,40,2,0);  ps(1,1,30,12,45,20,0);
// 7 Equal Weight
ps(0,0,0,180,40,100,30); ps(50,25,40,30,45,20,20); ps(0,5,0,65,80,35,20);  ps(25,1,20,4,14,0,25);  ps(2,0,25,20,55,50,0);
// 8 Gavel Drop
ps(3,3,0,0,0,0,90);      ps(30,10,0,30,40,0,40);   ps(0,0,0,72,0,45,40);   ps(20,0,0,0,10,0,0);   ps(1,0,50,5,40,15,0);
// 9 Foundry (FOLD)
ps(1,0,0,30,15,15,40);   ps(34,45,10,50,40,50,70); ps(0,0,0,62,75,25,20);  ps(30,0,0,1,30,0,0);   ps(1,0,40,6,40,20,0);
// 10 Broken Gavel (CRUSH)
ps(1,1,0,90,10,10,60);   ps(26,50,5,55,30,75,80);  ps(0,0,0,55,60,15,10);  ps(48,2,35,1,20,0,0);  ps(1,1,50,5,40,20,0);
// 11 Steel Writ (HARD)
ps(0,0,-10,60,20,30,30); ps(42,65,20,60,30,60,75); ps(0,0,0,58,70,20,25);  ps(40,0,0,1,30,0,0);   ps(1,0,45,10,45,25,0);

i = 1; loop(35, RDEF[i] = PRE[i-1]; i += 1;); RDEF[36] = 0; RDEF[37] = 2; RDEF[38] = 2; RDEF[39] = 0;
// drive mode (0 SOFT, 1 HARD, 2 FOLD, 3 CRUSH) and mono maker (0 off, 1 60 Hz, 2 120 Hz, 3 240 Hz) per preset
PREM[0]=0; PREM[1]=1; PREM[2]=0; PREM[3]=0; PREM[4]=2; PREM[5]=3; PREM[6]=1; PREM[7]=0; PREM[8]=0; PREM[9]=2; PREM[10]=3; PREM[11]=1;
PREMM[0]=2; PREMM[1]=2; PREMM[2]=0; PREMM[3]=0; PREMM[4]=0; PREMM[5]=2; PREMM[6]=1; PREMM[7]=2; PREMM[8]=2; PREMM[9]=2; PREMM[10]=2; PREMM[11]=2;

function pname(n) (
  n==0 ? "Verdict Acid" : n==1 ? "Doom Gavel" : n==2 ? "Scales of Equity" : n==3 ? "Swift Blade" :
  n==4 ? "Karmic Feedback" : n==5 ? "Iron Statute" : n==6 ? "Blind Sentence" : n==7 ? "Equal Weight" : n==8 ? "Gavel Drop" : n==9 ? "Foundry" : n==10 ? "Broken Gavel" : "Steel Writ";
);

function load_preset(n) local(i) (
  n = clampv(floor(n), 0, NPRE-1);
  i = 1; loop(35, slider(i) = PRE[n*35 + i-1]; sliderchange(2^(i-1)); i += 1;);
  slider39 = PREM[n]; sliderchange(2^38);
  slider38 = PREMM[n]; sliderchange(2^37);
  slider36 = n; sliderchange(2^35);
);

// ---- parameter derivation ----
function calc() local(t) (
  owA = slider1|0; owB = slider2|0;
  bal = slider3/100; mir = slider4; weight = slider5/100; wid = slider6/100; subl = slider7/100;
  lc_t = log(20) + slider8/100*log(900);
  reso = slider9/100; kres = 2 - 1.94*pow(reso,0.7);
  spanlog = LN2*(1 + 10*(1 - slider10/100));
  envamt = slider11/100;
  fcoef = exp(-4.6/((0.03*pow(100,slider12/100))*srate));
  acoefA = exp(-4.6/(0.2*srate));
  accent = slider13/100;
  t = slider14/100; dg_t = 1 + t*t*24; dnorm_t = 0.5/tanh_e(dg_t*0.5);
  drt_t = t; dm_t = slider39|0; crq = 2^(12 - 8*t);
  dly_n = sqr(slider15/100)*srate;
  ainc = 1/max(0.0005*srate, pow(slider16/100,3)*3*srate);
  hold_n = sqr(slider17/100)*2*srate;
  dcoef = exp(-6.9/(0.005*pow(1000,slider18/100)*srate));
  sus = slider19/100;
  rcoef = exp(-6.9/(0.002*pow(3000,slider20/100)*srate));
  t = sqr(slider21/100);
  gcoef = t > 0.0001 ? 1 - exp(-3/(t*srate)) : 1;
  l1inc = 0.02*pow(1000,slider22/100)/srate; l1sh = slider23|0; l1d = slider24/100; l1dst = slider25|0;
  l2inc = 0.02*pow(1000,slider26/100)/srate; l2sh = slider27|0; l2d = slider28/100; l2dst = slider29|0;
  quant = slider30 >= 0.5;
  retr = slider31/100;
  rmix = slider32/100; rv_fb = 0.70 + 0.27*slider33/100; rv_damp = 0.22;
  fate = slider34/100;
  outg_t = 10^(slider35/20);
  bendr = slider37;
  mm_on = slider38 >= 0.5;
  mm_on ? ( t = tan($pi*60*2^((slider38|0)-1)/srate); mm1 = 1/(1 + t*(t + 1.4142)); mm2 = t*mm1; mm3 = t*mm2; );
  cratio = 1 + retr*vn*19;
  velamp = (1-retr)*(0.35 + 0.65*vel) + retr*0.8;
);

// ---- voice / MIDI ----
function ns_remove(n) local(i j) (
  i = 0; j = 0;
  loop(ncnt, NS[i] != n ? (NS[j] = NS[i]; j += 1;); i += 1;);
  ncnt = j;
);
function note_on(n,v) local(leg) (
  ns_remove(n);
  leg = ncnt > 0 && stage > 0 && stage < 6;
  NS[ncnt] = n; ncnt += 1;
  vel = v/127; vn = max(vel, at);
  accv = accent*max(0, (v-64)/63);
  cratio = 1 + retr*vn*19;
  velamp = (1-retr)*(0.35 + 0.65*vel) + retr*0.8;
  ptgt = n;
  leg ? (
    accv > 0 ? acenv = 1;
  ) : (
    pcur = ptgt;
    env < 0.001 ? ( phA = 0; phB = 0; phS = 0; );
    fenv = 1; acenv = 1;
    dcur = weight*50;
    l1p = 0; l2p = 0;
    dcnt = dly_n;
    stage = dly_n >= 1 ? 1 : 2;
  );
);
function note_off(n) (
  ns_remove(n);
  ncnt == 0 ? ( stage > 0 ? stage = 6; ) : ( ptgt = NS[ncnt-1]; );
);
function handle(m1,m2,m3) local(st) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? note_on(m2,m3) :
  st == 0x80 || st == 0x90 ? note_off(m2) :
  st == 0xE0 ? ( bend = ((m3*128 + m2) - 8192)/8192*bendr; ) :
  st == 0xD0 ? ( at = m2/127; vn = max(vel,at); cratio = 1 + retr*vn*19; ) :
  st == 0xB0 ? ( m2 == 1 ? ( mw = m3/127; ) : (m2 == 120 || m2 == 123) ? ( ncnt = 0; stage > 0 ? stage = 6; ); );
);
function route(v,d,dst) local(q) (
  dst == 0 ? (
    q = v*12*d*d;
    quant ? ( q = abs(q) < 2.5 ? 0 : abs(q) < 6 ? 5*sign(q) : abs(q) < 9.5 ? 7*sign(q) : 12*sign(q); );
    mpit += q;
  ) : (
    quant ? ( v = floor(v*4 + 0.5)/4; );
    dst == 1 ? ( mcut += v*d*4; ) :
    dst == 2 ? ( mbal += v*d; ) :
    dst == 3 ? ( mmir += v*d*90; ) :
    dst == 4 ? ( mwid += v*d; ) :
               ( mamp += (0.5 - 0.5*v)*d; );
  );
);

// ---- state ----
rv_init();
stage = 0; env = 0; ncnt = 0; vf = 1; pending = -1; cg = 1; ce = 0;
vel = 0.8; vn = 0.8; at = 0; mw = 0; bend = 0;
calc();
bal_s = bal; wid_s = wid; rmix_s = rmix; mir_s = mir; sub_s = subl; lcs = lc_t; kres_s = kres; envamt_s = envamt; outg_s = outg_t; dg = dg_t; dnorm = dnorm_t;
pcur = ptgt = 48;
rbgL = rbgR = 1; rmL = rmR = 0.000000001;
ms3 = 1 - exp(-1/(0.003*srate)); ms10 = 1 - exp(-1/(0.010*srate)); ms30 = 1 - exp(-1/(0.030*srate));
dk = exp(-1/(0.9*srate));
dcr = exp(-2*$pi*4/srate); dvstep = 1/(0.003*srate); dvf = 1; dm = dm_t = slider39|0; drt = slider14/100;
t = tan($pi*120/srate); mm1 = 1/(1 + t*(t + 1.4142)); mm2 = t*mm1; mm3 = t*mm2; calc();
crel = exp(-1/(0.08*srate));
opkd = exp(-1/(0.25*srate));
vfstep = 1/(0.004*srate);
fz1 = fz2 = fpos1 = fvel1 = fpos2 = fvel2 = 0; ftp = ftw = 0;

// ================= GUI helpers =================
function colx(h,a) ( gfx_r = ((h>>16)&255)/255; gfx_g = ((h>>8)&255)/255; gfx_b = (h&255)/255; gfx_a = a; );
function X(x) ( ox + x*sc );
function Y(y) ( oy + y*sc );
function ctext(x,y,s) local(w h) ( gfx_measurestr(s,w,h); gfx_x = x - w*0.5; gfx_y = y - h*0.5; gfx_drawstr(s); );
function ltext(x,y,s) local(w h) ( gfx_measurestr(s,w,h); gfx_x = x; gfx_y = y - h*0.5; gfx_drawstr(s); );
function inrect(x,y,w,h) ( mouse_x >= X(x) && mouse_x < X(x+w) && mouse_y >= Y(y) && mouse_y < Y(y+h) );

function setv(i,v) (
  v = clampv(v, RMIN[i], RMAX[i]);
  slider(i) = v; slider_automate(2^(i-1));
);

function fmtt(t) ( t < 1 ? sprintf(#vs, "%d ms", t*1000 + 0.5) : sprintf(#vs, "%.2f s", t) );
function fmtv(i,v) local(f) (
  i == 3 ? sprintf(#vs, "A %d : B %d", (100-v)/2 + 0.5, (100+v)/2 + 0.5) :
  i == 4 ? sprintf(#vs, "%d deg", v + 0.5) :
  i == 5 ? sprintf(#vs, "%.1f ct", v*0.5) :
  i == 8 ? ( f = 20*pow(900, v/100); f >= 1000 ? sprintf(#vs, "%.2f kHz", f/1000) : sprintf(#vs, "%d Hz", f + 0.5) ) :
  i == 12 ? fmtt(0.03*pow(100, v/100)) :
  i == 15 ? fmtt(sqr(v/100)) :
  i == 16 ? fmtt(max(0.0005, pow(v/100,3)*3)) :
  i == 17 ? fmtt(sqr(v/100)*2) :
  i == 18 ? fmtt(0.005*pow(1000, v/100)) :
  i == 20 ? fmtt(0.002*pow(3000, v/100)) :
  i == 21 ? fmtt(sqr(v/100)) :
  i == 22 || i == 26 ? sprintf(#vs, "%.2f Hz", 0.02*pow(1000, v/100)) :
  i == 35 ? sprintf(#vs, "%+.1f dB", v) :
  sprintf(#vs, "%d%%", v + 0.5);
);

// knob pointer, supersampled like a filmstrip frame: drawn 4x larger off screen (image 60), scaled down in two
// filtered 2:1 steps (image 61, then the screen) - an evenly smoothed, round-ended bar at every angle
function ptr_ss(cx, cy, rc, av, col) local(S, h, m, px, py, nx, ny, k, ex, ey, sx, sy) (
  S = 4; h = ceil(rc + 3); m = 2*h*S;
  gfx_dest = 60; gfx_setimgdim(60, m, m); gfx_mode = 0;
  gfx_a = 1; gfx_a2 = 0; gfx_r = gfx_g = gfx_b = 0; gfx_rect(0, 0, m, m);
  colx(col, 1); gfx_a2 = 1;
  px = sin(av); py = -cos(av); nx = -py; ny = px; k = 1.4*sc*S;
  ex = m/2 + px*rc*0.3*S; ey = m/2 + py*rc*0.3*S; sx = m/2 + px*rc*0.86*S; sy = m/2 + py*rc*0.86*S;
  gfx_triangle(ex + nx*k, ey + ny*k, sx + nx*k, sy + ny*k, sx - nx*k, sy - ny*k, ex - nx*k, ey - ny*k);
  gfx_circle(sx, sy, k, 1, 0); gfx_circle(ex, ey, k, 1, 0);
  gfx_dest = 61; gfx_setimgdim(61, m/2, m/2); gfx_a2 = 0; gfx_a = 1; gfx_rect(0, 0, m, m); gfx_a2 = 1;
  gfx_x = 0; gfx_y = 0; gfx_blit(60, 0.5, 0);
  gfx_dest = -1; gfx_a = 1;
  gfx_x = cx - h; gfx_y = cy - h; gfx_blit(61, 0.5, 0);
);
function arcs(cx,cy,r,a,b) local(k) ( k = 0; loop(3, gfx_arc(cx,cy,r+k,a,b,1); k += 0.5*sc;); );

// cap: 0 satin white, 1 black (LPF), 2 yellow (HPF), 3 dark grey, 4 gold
function knob(i,x,y,big,cap,lab) local(r cx cy rr rc v mn mx t hov a0 a1 av sh px py ex ey k nx ny) (
  r = big ? 29 : 18; cx = X(x); cy = Y(y); rr = r*sc;
  mn = RMIN[i]; mx = RMAX[i]; v = slider(i);
  hov = sqr(mouse_x-cx) + sqr(mouse_y-cy) < sqr(rr + 6*sc);
  click && hov ? (
    (mouse_cap & 4) || (time_precise() - lastclk < 0.3 && lastk == i) ? (
      setv(i, RDEF[i]); drag = 0; lastk = -1;
    ) : (
      drag = i; dy0 = mouse_y; v0 = v; lastclk = time_precise(); lastk = i;
    );
  );
  hov && mouse_wheel != 0 && !wheeled ? (
    setv(i, v + sign(mouse_wheel)*(mx-mn)*((mouse_cap & 8) ? 0.002 : 0.01)); wheeled = 1;
  );
  drag == i && lmb ? ( sh = (mouse_cap & 8) ? 900 : 220; setv(i, v0 + (dy0 - mouse_y)/(sh*sc)*(mx-mn)); );
  v = slider(i); t = (v-mn)/(mx-mn);
  a0 = -2.356; a1 = 2.356; av = a0 + t*(a1-a0);
  // track + value arc
  colx(0x23272B, 1); arcs(cx, cy, rr + 4*sc, a0, a1);
  colx(0xEBC867, 0.95);
  mn < 0 ? ( av > 0 ? arcs(cx,cy,rr+4*sc,0,av) : av < 0 ? arcs(cx,cy,rr+4*sc,av,0); ) : t > 0.002 ? arcs(cx,cy,rr+4*sc,a0,av);
  big ? (
    colx(0xEFEADB, 0.55); gfx_line(cx, cy - rr - 8*sc, cx, cy - rr - 11*sc, 1);
    colx(0x6F767D, 1); gfx_circle(cx, cy, rr + 1.5*sc, 1, 1);
    colx(0xC9CDD1, 1); gfx_circle(cx, cy, rr, 1, 1);
    colx(0x8E959B, 1); gfx_circle(cx, cy, rr - 3*sc, 1, 1);
    rc = rr - 4*sc;
  ) : (
    colx(0x1E2125, 0.6); gfx_circle(cx + 1*sc, cy + 1.5*sc, rr, 1, 1);
    rc = rr;
  );
  cap == 1 ? colx(0x1D1F22, 1) : cap == 2 ? colx(0xE3C24A, 1) : cap == 3 ? colx(0x4A4F55, 1) : cap == 4 ? colx(0xC9A243, 1) : colx(0xDADBD6, 1);
  gfx_circle(cx, cy, rc, 1, 1);
  colx(0xFFFFFF, cap == 1 ? 0.18 : cap == 3 ? 0.25 : 0.45); gfx_arc(cx, cy, rc - 1*sc, -1.9, -0.7, 1);
  colx(0x000000, 0.25); gfx_arc(cx, cy, rc - 0.5*sc, 1.2, 2.4, 1);
  // pointer
  cap == 1 || cap == 3 ? colx(0xEFEADB, 1) : colx(0x2A2E33, 1);
  ptr_ss(cx, cy, rc, av, cap == 1 || cap == 3 ? 0xEFEADB : 0x2A2E33);
  // label / value
  gfx_setfont(1); colx(0xEFEADB, 0.92);
  (hov || drag == i) ? ( fmtv(i, v); colx(0xF2D27A, 1); ctext(cx, cy + rr + 15*sc, #vs); ) : ctext(cx, cy + rr + 15*sc, lab);
);

function keyb(x,y,w,h,lit) local(c) (
  c = click && inrect(x,y,w,h);
  lit ? (
    colx(0xEBC867, 0.22); gfx_rect(X(x-2), Y(y-2), (w+4)*sc, (h+4)*sc);
    colx(0xE6C15C, 1); gfx_rect(X(x), Y(y), w*sc, h*sc);
    colx(0xFFF3C8, 0.7); gfx_line(X(x), Y(y), X(x+w)-1, Y(y));
  ) : (
    colx(0x4A5057, 1); gfx_rect(X(x), Y(y), w*sc, h*sc);
    colx(0x5E656C, 1); gfx_line(X(x), Y(y), X(x+w)-1, Y(y));
    colx(0x26292E, 1); gfx_line(X(x), Y(y+h)-1, X(x+w)-1, Y(y+h)-1);
  );
  c;
);
function keyt(x,y,w,h,lit,lab) local(c) (
  c = keyb(x,y,w,h,lit);
  gfx_setfont(3); lit ? colx(0x22262A, 1) : colx(0xEFEADB, 0.85);
  ctext(X(x + w*0.5), Y(y + h*0.5), lab);
  c;
);
function pl(x1,y1,x2,y2) ( gfx_line(X(x1),Y(y1),X(x2),Y(y2),1); gfx_line(X(x1),Y(y1)+0.6,X(x2),Y(y2)+0.6,1); );
function keys(x,y,w,h,lit,s) local(c l r t b m i px py nx2 ny2 st) (
  c = keyb(x,y,w,h,lit);
  lit ? colx(0x22262A, 1) : colx(0xEFEADB, 0.85);
  l = x + w*0.25; r = x + w*0.75; t = y + h*0.28; b = y + h*0.72; m = (l+r)*0.5;
  s == 0 ? ( pl(l,b,r,t); pl(r,t,r,b); ) :
  s == 1 ? ( pl(l,b,l,t); pl(l,t,m,t); pl(m,t,m,b); pl(m,b,r,b); pl(r,b,r,t); ) :
  s == 2 ? ( pl(l,b,m,t); pl(m,t,r,b); ) :
  s == 3 ? ( i = 0; px = l; py = (t+b)*0.5;
             loop(16, i += 1; nx2 = l + (r-l)*i/16; ny2 = (t+b)*0.5 - (b-t)*0.5*sin(2*$pi*i/16); pl(px,py,nx2,ny2); px = nx2; py = ny2;); ) :
  ( st = (r-l)/4; pl(l,b,l,t); pl(l,t,l+st,t); pl(l+st,t,l+st,(t+b)*0.5); pl(l+st,(t+b)*0.5,l+2*st,(t+b)*0.5);
    pl(l+2*st,(t+b)*0.5,l+2*st,b); pl(l+2*st,b,l+3*st,b); pl(l+3*st,b,l+3*st,t+(b-t)*0.25); pl(l+3*st,t+(b-t)*0.25,r,t+(b-t)*0.25); );
  c;
);

function recess(x,y,w,h,shade,title) local(d x1 y1 x2 y2) (
  d = 6; x1 = X(x); y1 = Y(y); x2 = X(x+w); y2 = Y(y+h); d *= sc;
  colx(0x24282D, 1); gfx_triangle(x1,y1, x2,y1, x2-d,y1+d, x1+d,y1+d);
  colx(0x2A2E33, 1); gfx_triangle(x1,y1, x1+d,y1+d, x1+d,y2-d, x1,y2);
  colx(0x4A5158, 1); gfx_triangle(x1,y2, x1+d,y2-d, x2-d,y2-d, x2,y2);
  colx(0x434950, 1); gfx_triangle(x2,y1, x2,y2, x2-d,y2-d, x2-d,y1+d);
  shade == 0 ? colx(0x31363C, 1) : shade == 1 ? colx(0x353A40, 1) : colx(0x393E45, 1);
  gfx_rect(x1+d, y1+d, x2-x1-2*d, y2-y1-2*d);
  gfx_setfont(5); colx(0xEFEADB, 0.6); ltext(X(x+14), Y(y+17), title);
);

function draw_env(x,y,w,h,part) local(td ta th2 tdc tr tot px s u bx) (
  colx(0x1F2327, 1); gfx_rect(X(x),Y(y),w*sc,h*sc);
  colx(0xEFEADB, 0.12); gfx_line(X(x),Y(y+h-6),X(x+w)-1,Y(y+h-6));
  bx = y + h - 6; u = h - 14;
  colx(0xEBC867, 0.9);
  part == 0 ? (
    td = 0.15 + sqrt(sqr(slider15/100)); ta = 0.15 + sqrt(pow(slider16/100,3)*3); th2 = 0.15 + sqrt(sqr(slider17/100)*2);
    tot = td + ta + th2; s = (w-8)/tot; px = x + 4;
    pl(px, bx, px + td*s, bx); px += td*s;
    pl(px, bx, px + ta*s, bx - u); px += ta*s;
    pl(px, bx - u, x + w - 4, bx - u);
  ) : (
    tdc = 0.15 + sqrt(0.005*pow(1000,slider18/100)); tr = 0.15 + sqrt(0.002*pow(3000,slider20/100));
    tot = tdc + 0.6 + tr; s = (w-8)/tot; px = x + 4;
    pl(px, bx - u, px + tdc*s*0.35, bx - u*(sus + (1-sus)*0.35));
    pl(px + tdc*s*0.35, bx - u*(sus + (1-sus)*0.35), px + tdc*s, bx - u*sus); px += tdc*s;
    pl(px, bx - u*sus, px + 0.6*s, bx - u*sus); px += 0.6*s;
    pl(px, bx - u*sus, px + tr*s*0.35, bx - u*sus*0.35);
    pl(px + tr*s*0.35, bx - u*sus*0.35, x + w - 4, bx);
  );
);

function draw_scale() local(x y w h cx py L a ex ey lx ly rx ry pw ph gl gr k) (
  x = 398; y = 64; w = 164; h = 150;
  colx(0x1A1D21, 1); gfx_rect(X(x),Y(y),w*sc,h*sc);
  colx(0x000000, 0.5); gfx_line(X(x),Y(y),X(x+w),Y(y)); gfx_line(X(x),Y(y),X(x),Y(y+h));
  colx(0xEFEADB, 0.08); k = 0; loop(9, gfx_line(X(x+4),Y(y+20+k*20),X(x+w-4),Y(y+20+k*20)); k += 1;);
  cx = 480; py = y + 34; L = 50;
  a = disp_tilt*0.32;
  ex = cos(a)*L; ey = sin(a)*L;
  lx = cx - ex; ly = py - ey; rx = cx + ex; ry = py + ey;
  // post + base
  colx(0xC9CDD1, 1); pl(cx, py, cx, y + h - 22);
  pl(cx - 24, y + h - 22, cx + 24, y + h - 22); pl(cx - 14, y + h - 18, cx + 14, y + h - 18);
  // beam
  colx(0xEFEADB, 1); pl(lx, ly, rx, ry);
  colx(0xEBC867, 1); gfx_circle(X(cx), Y(py), 4*sc, 1, 1);
  // pans
  pw = 22; ph = 62;
  gl = min(1, sqrt(mL)*3); gr = min(1, sqrt(mR)*3);
  colx(0xEFEADB, 0.7);
  pl(lx, ly, lx - pw*0.8, ly + ph); pl(lx, ly, lx + pw*0.8, ly + ph);
  pl(rx, ry, rx - pw*0.8, ry + ph); pl(rx, ry, rx + pw*0.8, ry + ph);
  colx(0xEBC867, 0.15 + 0.7*gl); gfx_triangle(X(lx-pw),Y(ly+ph), X(lx+pw),Y(ly+ph), X(lx+pw*0.6),Y(ly+ph+9), X(lx-pw*0.6),Y(ly+ph+9));
  colx(0xEBC867, 0.15 + 0.7*gr); gfx_triangle(X(rx-pw),Y(ry+ph), X(rx+pw),Y(ry+ph), X(rx+pw*0.6),Y(ry+ph+9), X(rx-pw*0.6),Y(ry+ph+9));
  gfx_setfont(5); colx(0xEFEADB, 0.55);
  ctext(X(x+16), Y(y+h-10), "L"); ctext(X(x+w-16), Y(y+h-10), "R");
);

@slider

@block
calc();
// FATE: two self-correcting wanders (mean-reverting noise -> damped spring)
dtb = samplesblock/srate;
fsig = 0.4*fate/1.4142;
fz1 += -fz1*dtb/4 + fsig*sqrt(dtb)*(rand()+rand()+rand()+rand()-2)*1.732;
fz2 += -fz2*dtb/4 + fsig*sqrt(dtb)*(rand()+rand()+rand()+rand()-2)*1.732;
fw0 = 2*$pi*0.4;
fa = fw0*fw0*(fz1 - fpos1) - 2*0.35*fw0*fvel1; fvel1 += fa*dtb; fpos1 += fvel1*dtb;
fa = fw0*fw0*(fz2 - fpos2) - 2*0.35*fw0*fvel2; fvel2 += fa*dtb; fpos2 += fvel2*dtb;
fate == 0 ? ( fz1 *= 0.9; fz2 *= 0.9; );
ftp_d = (clampv(fpos1,-1,1)*0.5 - ftp)/max(1,samplesblock);
ftw_d = (clampv(fpos2,-1,1)*0.6 - ftw)/max(1,samplesblock);
// reverb equilibrium
ravg = 0.5*(rmL + rmR);
rbgL = clampv(sqrt(ravg/(rmL+0.000000000001)), 0.5, 2);
rbgR = clampv(sqrt(ravg/(rmR+0.000000000001)), 0.5, 2);
// MIDI -> event buffer (sample-accurate)
// anything the last block didn't reach (stamped at or past its end) is handled now, never dropped
while (evi < evn) ( handle(EV[evi*4+1], EV[evi*4+2], EV[evi*4+3]); evi += 1; );
evn = 0; evi = 0; spos = 0;
while (midirecv(mo, m1, m2, m3)) (
  evn < 256 ? ( EV[evn*4] = mo; EV[evn*4+1] = m1; EV[evn*4+2] = m2; EV[evn*4+3] = m3; evn += 1; )
            : handle(m1, m2, m3);                        // (a flood, e.g. a stop's note-offs: handle the rest at once)
  midisend(mo, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would)
pst = play_state == 1 || play_state == 5;
pst_prev && !pst ? ( ncnt = 0; stage > 0 && stage < 6 ? stage = 6; );
pst_prev = pst;

@sample
while (evi < evn && EV[evi*4] <= spos) ( handle(EV[evi*4+1], EV[evi*4+2], EV[evi*4+3]); evi += 1; );
spos += 1;

ftp += ftp_d; ftw += ftw_d;

// LFOs
l1p += l1inc; l1p >= 1 ? l1p -= 1;
l2p += l2inc; l2p >= 1 ? l2p -= 1;
mpit = mcut = mbal = mmir = mwid = mamp = 0;
route(lfo_val(l1sh,l1p), min(1, l1d + mw*(1-l1d)), l1dst);
route(lfo_val(l2sh,l2p), l2d, l2dst);
quant ? ( mpit_s = mpit; ) : ( mpit_s += (mpit - mpit_s)*ms3; );
mcut_s += (mcut - mcut_s)*ms3; mbal_s += (mbal - mbal_s)*ms3;
mmir_s += (mmir - mmir_s)*ms3; mwid_s += (mwid - mwid_s)*ms3; mamp_s += (mamp - mamp_s)*ms3;

// smoothing
bal_s += (bal - bal_s)*ms10; wid_s += (wid - wid_s)*ms10; mir_s += (mir - mir_s)*ms10;
sub_s += (subl - sub_s)*ms10; rmix_s += (rmix - rmix_s)*ms30; lcs += (lc_t - lcs)*ms10; kres_s += (kres - kres_s)*ms10; envamt_s += (envamt - envamt_s)*ms10; outg_s += (outg_t - outg_s)*ms30;
dg += (dg_t - dg)*ms10; drt += (drt_t - drt)*ms10; dnorm += (dnorm_t - dnorm)*ms10;

stage > 0 || env > 0 ? (
  // pitch
  pcur += (ptgt - pcur)*gcoef;
  fbase = 440*exp((pcur + bend + mpit_s - 69)*0.057762265);
  dcur *= dk;
  rA = exp(dcur*0.000288811);
  dtA = min(0.45, fbase/rA/srate); dtB = min(0.45, fbase*rA/srate); dtS = min(0.45, fbase*0.5/srate);
  phA += dtA; phA >= 1 ? phA -= 1;
  phB += dtB; phB >= 1 ? phB -= 1;
  phS += dtS; phS >= 1 ? phS -= 1;
  mof = (mir_s + mmir_s)/360; mof -= floor(mof);
  pb = phB + mof; pb >= 1 ? pb -= 1;
  oA = osc(owA, phA, dtA); oB = osc(owB, pb, dtB);
  sb = sub_s*th(3*sin(2*$pi*phS));
  b = clampv(bal_s + ftw + mbal_s, -1, 1); gA = sqrt(1-b); gB = sqrt(1+b);
  w = clampv(wid_s + mwid_s, 0, 1); sq1 = sqrt(1+w); sq2 = sqrt(1-w);
  xL = 0.42*(oA*gA*sq1 + oB*gB*sq2) + 0.55*sb;
  xR = 0.42*(oA*gA*sq2 + oB*gB*sq1) + 0.55*sb;

  // filter envelopes
  fenv *= fcoef; acenv *= acoefA;
  lcut = lcs + LN2*(envamt_s*7*fenv + accv*3*acenv + mcut_s);
  fc = clampv(exp(lcut), 20, 0.42*srate);
  g = tan($pi*fc/srate);
  k2 = max(0.04, kres_s - accv*acenv*0.5);
  c1 = 1/(1 + g*(g + 1.4142)); c2 = g*c1; c3 = g*c2;
  d1 = 1/(1 + g*(g + k2));     d2 = g*d1; d3 = g*d2;
  yL = fL1.svf_lp(xL, c1, c2, c3); yL = fL2.svf_lps(yL, d1, d2, d3);
  yR = fR1.svf_lp(xR, c1, c2, c3); yR = fR2.svf_lps(yR, d1, d2, d3);
  // equilibrium high-pass (follows the base cutoff, not the envelope)
  fh = clampv(exp(lcs + LN2*mcut_s - spanlog), 20, 0.4*srate);
  gh = tan($pi*fh/srate);
  h1 = 1/(1 + gh*(gh + 1.4142)); h2 = gh*h1; h3 = gh*h2;
  yL = hL.svf_hp(yL, h1, h2, h3, 1.4142); yR = hR.svf_hp(yR, h1, h2, h3, 1.4142);

  // drive (mode changes duck briefly)
  dm != dm_t ? ( dvf -= dvstep; dvf <= 0 ? ( dvf = 0; dm = dm_t; ); ) : ( dvf < 1 ? dvf = min(1, dvf + dvstep); );
  dm == 0 ? (
    yL = dL.adaa_t(yL*dg)*dnorm; yR = dR.adaa_t(yR*dg)*dnorm;
  ) : dm == 1 ? (
    u = 1 + drt*drt*80;
    yL = DRV_H*xhL.dcb(xcL.adaa_c(yL*u + 0.2*drt)); yR = DRV_H*xhR.dcb(xcR.adaa_c(yR*u + 0.2*drt));
  ) : dm == 2 ? (
    u = 1 + drt*14;
    yL = DRV_F*xfL.adaa_f(yL*u); yR = DRV_F*xfR.adaa_f(yR*u);
  ) : (
    u = 1 + drt*drt*20;
    rL = yL*u; rL = th(rL + 0.8*drt*abs(rL));
    rR = yR*u; rR = th(rR + 0.8*drt*abs(rR));
    crph += 1 - 0.94*drt;
    crph >= 1 ? ( crph -= 1; chL = floor(rL*crq + 0.5)/crq; chR = floor(rR*crq + 0.5)/crq; );
    yL = DRV_C*xrL.dcb(chL); yR = DRV_C*xrR.dcb(chR);
  );
  yL *= dvf; yR *= dvf;

  // verdict envelope
  stage == 1 ? ( env *= rcoef; dcnt -= 1; dcnt <= 0 ? stage = 2; ) :
  stage == 2 ? ( env += ainc; env >= 1 ? ( env = 1; stage = 3; hcnt = hold_n; ); ) :
  stage == 3 ? ( hcnt -= 1; hcnt <= 0 ? stage = 4; ) :
  stage == 4 ? ( env = sus + (env - sus)*dcoef; ) :
  stage == 6 ? ( env *= rcoef; env < 0.00002 ? ( env = 0; stage = 0; ); );
  a = env*velamp*(1 + 0.6*accv*acenv)*(1 - mamp_s);
  yL *= a; yR *= a;
) : (
  yL = yR = 0;
);

// retribution
pk = max(abs(yL), abs(yR));
ce = pk > ce ? ce + (pk - ce)*0.3 : ce*crel;
cg_t = ce > 0.35 ? (0.35*pow(ce/0.35, 1/cratio))/ce : 1;
cg += (cg_t - cg)*ms3;
yL *= cg; yR *= cg;

// preset change fade (no clicks)
pending >= 0 ? (
  vf -= vfstep;
  vf <= 0 ? ( vf = 0; load_preset(pending); calc(); pending = -1; );
) : ( vf < 1 ? vf = min(1, vf + vfstep); );
yL *= vf; yR *= vf;

// FATE: scales tipping L/R
yL *= sqrt(1 - ftp); yR *= sqrt(1 + ftp);

// chamber
rinL = yL*0.03; rinR = yR*0.03;
wL = cL1.comb(rinL) + cL2.comb(rinL) + cL3.comb(rinL) + cL4.comb(rinL);
wR = cR1.comb(rinR) + cR2.comb(rinR) + cR3.comb(rinR) + cR4.comb(rinR);
wL = aL2.ap(aL1.ap(wL)); wR = aR2.ap(aR1.ap(wR));
rmL += (wL*wL - rmL)*0.00005; rmR += (wR*wR - rmR)*0.00005;
oL = yL + wL*rbgL*rmix_s*2.2;
oR = yR + wR*rbgR*rmix_s*2.2;

// mono maker (high-passes the side signal)
mmix += (mm_on - mmix)*ms10;
mmix > 0.0001 ? (
  sd = (oL - oR)*0.5; md = (oL + oR)*0.5;
  sh = mmB.svf_hp(mmA.svf_hp(sd, mm1, mm2, mm3, 1.4142), mm1, mm2, mm3, 1.4142);
  sd += (sh - sd)*mmix; oL = md + sd; oR = md - sd;
);

// output + verdict clipper
spl0 = cpL.adaa_c(oL*outg_s);
spl1 = cpR.adaa_c(oR*outg_s);
mL += (spl0*spl0 - mL)*0.0005; mR += (spl1*spl1 - mR)*0.0005;
opk = max(opk*opkd, max(abs(spl0), abs(spl1)));

@gfx 960 556
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
sc = max(0.3, min(gfx_w/960, gfx_h/556));
ox = floor((gfx_w - 960*sc)*0.5); oy = floor((gfx_h - 556*sc)*0.5);
lmb = mouse_cap & 1; click = lmb && !plmb; wheeled = 0;
!lmb ? drag = 0;

gfx_setfont(1, "Arial", 14*sc, 'b');
gfx_setfont(2, "Arial", 26*sc, 'b');
gfx_setfont(3, "Arial", 12*sc, 'b');
gfx_setfont(4, "Arial", 18*sc, 'b');
gfx_setfont(5, "Arial", 13*sc, 'b');
gfx_setfont(6, "Arial", 12*sc);
gfx_setfont(7, "Arial", 34*sc, 'b');

// backdrop + plate
colx(0x2B3035, 1); gfx_rect(0, 0, gfx_w, gfx_h);
colx(0x3C4248, 1); gfx_rect(X(0), Y(0), 960*sc, 556*sc);
colx(0xFFFFFF, 0.025); k = 0; loop(139, gfx_line(X(0), Y(k*4), X(960)-1, Y(k*4)); k += 1;);
colx(0xEFEADB, 0.3); gfx_rect(X(6), Y(6), 948*sc, 1); gfx_rect(X(6), Y(549), 948*sc, 1);
gfx_rect(X(6), Y(6), 1, 544*sc); gfx_rect(X(953), Y(6), 1, 544*sc);
colx(0xEFEADB, 0.14); gfx_rect(X(10), Y(10), 940*sc, 1); gfx_rect(X(10), Y(545), 940*sc, 1);
gfx_rect(X(10), Y(10), 1, 536*sc); gfx_rect(X(949), Y(10), 1, 536*sc);

// header
gfx_setfont(4); colx(0xEFEADB, 0.9); ltext(X(24), Y(34), "GFX");
gfx_setfont(6); colx(0xEFEADB, 0.5); ltext(X(68), Y(35), "AEGIS  -  THE SCALES"); ver_tag_at("v2", 16, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1);
gfx_setfont(5); colx(0xEBC867, 0.9); ctext(X(480), Y(18), "XI");
gfx_setfont(2); colx(0xEFEADB, 1); ctext(X(480), Y(42), "J U S T I C E");

// preset bar  [PRESETS][<][>][LCD]
keyt(574, 22, 74, 26, 0, "PRESETS") ? ( open_menu = 1; );
keyt(652, 22, 28, 26, 0, "<") ? ( pending = (slider36 + NPRE - 1) % NPRE; pend_t = time_precise(); slider36 = pending; );
keyt(684, 22, 28, 26, 0, ">") ? ( pending = (slider36 + 1) % NPRE; pend_t = time_precise(); slider36 = pending; );
colx(0x15181B, 1); gfx_rect(X(718), Y(20), 222*sc, 30*sc);
colx(0x000000, 0.6); gfx_line(X(718), Y(20), X(940), Y(20)); gfx_line(X(718), Y(20), X(718), Y(50));
colx(0xF2D27A, 1); gfx_setfont(4); ctext(X(829), Y(35), pname(slider36));
click && inrect(718, 20, 222, 30) ? open_menu = 1;

// sections
recess(16, 62, 372, 98, 1, "");
recess(572, 62, 372, 98, 1, "");
recess(16, 166, 372, 134, 2, "");
gfx_setfont(5); colx(0xEFEADB, 0.6); gfx_measurestr("LOW-PASS", tw, th0); ltext(X(374) - tw, Y(183), "LOW-PASS");
recess(572, 166, 372, 134, 2, "HIGH-PASS  /  VERDICT");
recess(16, 306, 372, 114, 0, "");
gfx_setfont(5); colx(0xEFEADB, 0.6); gfx_measurestr("LFO 1", tw, th0); ltext(X(374) - tw, Y(323), "LFO 1");
recess(572, 306, 372, 114, 0, "LFO 2");
recess(16, 426, 372, 122, 1, "");
gfx_setfont(5); colx(0xEFEADB, 0.6); gfx_measurestr("ENVELOPE  -  ONSET", tw, th0); ltext(X(374) - tw, Y(443), "ENVELOPE  -  ONSET");
recess(572, 426, 372, 122, 1, "ENVELOPE  -  SENTENCE");
recess(394, 220, 172, 328, 0, "");

// the blade
colx(0xEBC867, 0.08); gfx_rect(X(477), Y(56), 6*sc, 492*sc);
colx(0xEBC867, 0.25); gfx_rect(X(479), Y(56), 2*sc, 492*sc);
colx(0xEBC867, 0.6); gfx_line(X(480), Y(56), X(480), Y(548));

// scale display
gt = clampv((bal_s + ftw + mbal_s)*0.6 + ftp*0.9 + 1.5*(sqrt(mR) - sqrt(mL))/(sqrt(mL) + sqrt(mR) + 0.0001)*min(1, (mL+mR)*40), -1, 1);
disp_tilt += (gt - disp_tilt)*0.15;
draw_scale();

// OSC A
gfx_setfont(7); colx(0xEBC867, 0.95); ctext(X(46), Y(111), "A");
knob(7, 104, 104, 0, 0, "SUB");
k = 0; loop(4, keys(150 + k*56, 94, 48, 34, slider1 == k, k) ? setv(1, k); k += 1;);
// OSC B
gfx_setfont(7); colx(0xEBC867, 0.95); ctext(X(604), Y(111), "B");
k = 0; loop(4, keys(636 + k*56, 94, 48, 34, slider2 == k, k) ? setv(2, k); k += 1;);
knob(21, 898, 104, 0, 0, "GLIDE");

// LOW-PASS
knob(8, 74, 222, 1, 1, "CUTOFF");
knob(9, 160, 222, 0, 0, "RESO");
knob(11, 222, 222, 0, 0, "ENV");
knob(12, 284, 222, 0, 0, "DECAY");
knob(13, 346, 222, 0, 0, "ACCENT");
// HIGH-PASS / VERDICT
knob(33, 608, 222, 0, 0, "SIZE");
knob(32, 676, 222, 0, 0, "CHAMBER");
knob(31, 746, 222, 0, 0, "RETRIB");
knob(14, 814, 222, 0, 0, "DRIVE");
gfx_setfont(6); colx(0xEFEADB, 0.6); ltext(X(592), Y(278), "MODE");
k = 0; loop(4,
  keyt(630 + k*49, 268, 46, 20, (slider39|0) == k, k == 0 ? "SOFT" : k == 1 ? "HARD" : k == 2 ? "FOLD" : "CRUSH") ? setv(39, k);
  k += 1;
);
knob(10, 886, 222, 1, 2, "EQUILIB");

// LFO 1
knob(22, 58, 366, 0, 0, "RATE");
knob(24, 120, 366, 0, 0, "DEPTH");
k = 0; loop(3, keys(168 + k*42, 320, 38, 24, slider23 == k, 10 + k + (k == 0 ? -7 : k == 1 ? -9 : 0)) ? setv(23, k); k += 1;);
k = 0; loop(6,
  keyt(170 + (k%3)*70, 352 + floor(k/3)*28, 66, 24, slider25 == k,
       k==0 ? "PITCH" : k==1 ? "CUTOFF" : k==2 ? "BALANCE" : k==3 ? "MIRROR" : k==4 ? "WIDTH" : "AMP") ? setv(25, k);
  k += 1;
);
// LFO 2
k = 0; loop(3, keys(668 + k*42, 320, 38, 24, slider27 == k, 10 + k + (k == 0 ? -7 : k == 1 ? -9 : 0)) ? setv(27, k); k += 1;);
k = 0; loop(6,
  keyt(586 + (k%3)*70, 352 + floor(k/3)*28, 66, 24, slider29 == k,
       k==0 ? "PITCH" : k==1 ? "CUTOFF" : k==2 ? "BALANCE" : k==3 ? "MIRROR" : k==4 ? "WIDTH" : "AMP") ? setv(29, k);
  k += 1;
);
knob(28, 840, 366, 0, 0, "DEPTH");
knob(26, 902, 366, 0, 0, "RATE");

// ENVELOPE
knob(15, 58, 488, 0, 0, "DELAY");
knob(16, 124, 488, 0, 0, "ATTACK");
knob(17, 190, 488, 0, 0, "HOLD");
draw_env(240, 452, 132, 80, 0);
draw_env(588, 452, 132, 80, 1);
knob(18, 770, 488, 0, 0, "DECAY");
knob(19, 836, 488, 0, 0, "SUSTAIN");
knob(20, 902, 488, 0, 0, "RELEASE");

// centre axis
// BALANCE: gold A / B glow with the effective weight (knob + FATE + LFO)
beff = clampv(bal_s + ftw + mbal_s, -1, 1);
wa = (1 - beff)*0.5; wb = (1 + beff)*0.5;
colx(0xEBC867, 0.14*wa); gfx_circle(X(431), Y(264), 14*sc, 1, 1);
colx(0xEBC867, 0.14*wb); gfx_circle(X(529), Y(264), 14*sc, 1, 1);
gfx_setfont(2);
colx(0xEBC867, 0.2 + 0.8*wa); ctext(X(431), Y(264), "A");
colx(0xEBC867, 0.2 + 0.8*wb); ctext(X(529), Y(264), "B");
knob(3, 480, 264, 1, 4, "");
knob(4, 436, 322, 0, 0, "MIRROR");
knob(5, 524, 322, 0, 0, "WEIGHT");
knob(6, 436, 388, 0, 0, "WIDTH");
knob(34, 524, 388, 0, 0, "FATE");
keyt(430, 432, 100, 22, slider30 >= 0.5, "QUANTISE") ? setv(30, slider30 >= 0.5 ? 0 : 1);
knob(35, 480, 500, 1, 3, "");
// loudspeaker: glows white with the output level
spt = min(1, opk*1.4);
spk += (spt - spk)*(spt > spk ? 0.6 : 0.15);
k = 0; loop(4, colx(0xFFFFFF, 0.13*spk*(1 - k*0.22)); gfx_circle(X(534), Y(500), (8 + k*5)*sc, 1, 1); k += 1;);
colx(0xFFFFFF, 0.2 + 0.8*spk);
gfx_rect(X(522), Y(495), 6*sc, 10*sc);
gfx_triangle(X(528), Y(495), X(536), Y(488), X(536), Y(512), X(528), Y(505));
k = 0; loop(3,
  colx(0xFFFFFF, clampv((spk - k*0.25)*2.5, 0.08, 1));
  arcs(X(537), Y(500), (5 + k*5)*sc, 0.75, 2.39);
  k += 1;
);
// mono maker keys (lit key clicked again = off)
gfx_setfont(6); colx(0xEFEADB, 0.6); ctext(X(422), Y(466), "MONO");
k = 1; loop(3,
  keyt(403, 455 + k*21, 38, 18, (slider38|0) == k, k == 1 ? "60" : k == 2 ? "120" : "240") ? setv(38, (slider38|0) == k ? 0 : k);
  k += 1;
);

wheeled ? mouse_wheel = 0;

// preset list
open_menu ? (
  open_menu = 0;
  strcpy(#menu, ""); k = 0;
  loop(NPRE, k > 0 ? strcat(#menu, "|"); k == slider36 ? strcat(#menu, "!"); strcat(#menu, pname(k)); k += 1;);
  gfx_x = X(718); gfx_y = Y(52);
  k = gfx_showmenu(#menu);
  k > 0 ? ( pending = k - 1; pend_t = time_precise(); slider36 = pending; );
);
// if audio isn't running, apply the preset from here
pending >= 0 && time_precise() - pend_t > 0.25 ? ( load_preset(pending); calc(); pending = -1; vf = 1; );

plmb = lmb;
