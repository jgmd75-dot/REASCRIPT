  ng_v > -13 ? ( ui_col(ng_live ? AMB : AMBD); ng_v >= 0 ? ng_r(ng_x + 5, 545 - ng_v * 4.6, 16, max(ng_v * 4.6, 2)) : ng_r(ng_x + 5, 546, 16, -ng_v * 4.6); );
  gfx_setfont(16); ui_col(ng_live ? AMBL : AMBD);
  ng_v <= -13 ? strcpy(#ng_g, "-") : sprintf(#ng_g, ng_v > 0 ? "+%d" : "%d", ng_v);
  ng_tc(ng_x + 13, 597, #ng_g);
