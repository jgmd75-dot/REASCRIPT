  ng_hv && pressed && drag_id == 0 ? ( (mouse_cap & 2) ? ( ng_set(19 + ng_i, -13); drag_id = -1; ) : ( drag_id = 3300 + ng_i; ng_fy = mouse_y; ng_fv = ng_v; ); );
  drag_id == 3300 + ng_i ? (
    ng_fv = min(max(ng_fv + (ng_fy - mouse_y) / (4 * sc), -13), 12); ng_fy = mouse_y;
    floor(ng_fv + 0.5) != slider(19 + ng_i) ? ng_set(19 + ng_i, floor(ng_fv + 0.5));
  );
  ng_hv && mouse_wheel != 0 && drag_id == 0 ? ( ng_set(19 + ng_i, min(max(ng_v + sign(mouse_wheel), -13), 12)); mouse_wheel = 0; );
  ng_i += 1;
);

