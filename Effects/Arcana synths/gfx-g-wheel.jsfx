desc:Wheel of Fortune [cybernetic synth] (GFX)
//tags: instrument synth arpeggiator sequencer cycle of fifths chaos ring modulation tube circuit arcana
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-voice (.jsfx-inc) in the same folder.
//
// THE WHEEL OF FORTUNE (card X of the GFX Arcana series): the wheel turns, and what rises must come round again.
// A cybernetic synth in the spirit of the 1950s electronic-circuit film scores and the first automatic sequencers:
// every voice is a pair of coupled vacuum-tube oscillators, driven until the circuit starts to fail, and a pattern
// that turns round the circle of fifths, one key at a time, until it comes home.
//   THE WHEEL  HOLD: the notes you hold (or LATCH) are played in turn - UP, DOWN, UP-DOWN, AS PLAYED or RANDOM.
//              SELF: a pattern of up to twelve steps (semitones from ROOT, or rests) plays by itself while START is
//              lit - with FOLLOW, while REAPER plays, locked to it; without, from the moment START is pressed. STEPS sets the loop's length, RATE its speed, GATE, SWING.
//              TRANSPORT (lit by default): REAPER's play / record presses START and its stop presses STOP; the keys
//              still work by hand. Off, START / STOP ignore the transport.
//              After every loop (or every 2, 4 or 8: REVOLUTION) the whole pattern turns a fifth (C G D A ...) or a
//              fourth (C F Bb Eb ...): CYCLE. The pattern stays in its register (it folds back an octave rather than
//              climbing away). After twelve turns it is home: RESOLUTION TURN keeps turning, RESOLVE comes to rest
//              (the pattern plays once more at home, then falls silent until it is started again), RESET re-arms the
//              circuit (it cools down: the drift, the sag and the failures clear, and it powers up with a chirp).
//              WILD CARD: now and then the wheel spins to a random key instead. FORTUNE: the further the wheel
//              is from home, the harder the circuit is pushed (with the WHEEL > CIRCUIT loop closed).
//   GENERATOR  two Van der Pol oscillators per voice - the classic model of a valve oscillator. NODE A PITCH,
//              NODE B DETUNE (semitones from A), COUPLING (each node pulls on the other: they lock, beat and drag
//              each other's pitch), MIX (A to B), SUB-SONIC PULSE (a slow throb in the supply) and its RATE.
//   CIRCUIT    OVERLOAD: component stress - from near-sine valves into buzzing relaxation tones; past about two
//              thirds (higher with RESONANCE and FORTUNE) the circuit starts to fail: bird chirps, pitched squeals,
//              bubbling ring-modulation and dying tails. THERMAL DRIFT: every note wanders on its own and warms up
//              into tune. TUBE BIAS: the rectified, asymmetric valve saturation (even harmonics). RING MIX and RATIO:
//              a ring modulator on a carrier at RATIO times the note. SAG: the supply droops under load. CHAOS RATE
//              and DEPTH: a Lorenz attractor - a chaotic LFO that never repeats - wobbling the ring carrier (and the
//              pitch, with CHAOS > PITCH closed).
//   FILTER     a resonant 12 dB valve low-pass: CUTOFF, RESONANCE, ENVELOPE amount.
//   AMP        ATTACK, DECAY, SUSTAIN, RELEASE, VELOCITY, LEVEL.
//   LOOPS      four knife switches close the feedback loops: ECHO > NODES (the echo is fed back into the
//              oscillators), CHAOS > PITCH, LOAD > SAG (the output level drags the supply down: runaway droop),
//              WHEEL > CIRCUIT (FORTUNE).
//   SPACE      an OIL-CAN echo (synced TIME, FEEDBACK, WARBLE, CHAOS FEEDBACK - the attractor wobbles its time and
//              feedback, LEVEL) and a valve-driven SPRING (DRIVER, DAMPING, DECAY, LEVEL).
//   FATE (the series' drift, 0-100 %, 50 % = the standard amount): the valves wander - the whole circuit's tuning,
//              the filter and the echo's warble drift slowly.
//   VOLUME and SAT (the output soft clip is always on).
// MIDI: notes (HOLD), CC64 sustain (holds the notes like LATCH), CC120 / CC123 all notes off.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc

slider1:0<0,1,1{Hold,Self}>-Mode
slider2:0<0,1,1{Off,On}>-Latch
slider3:0<0,1,1{Stop,Start}>-Run (self)
slider4:1<0,1,1{Off,On}>-Follow REAPER transport
slider5:9<0,11,1{C,C#,D,Eb,E,F,F#,G,Ab,A,Bb,B}>-Self root
slider6:3<1,6,1>-Self octave
slider7:0<0,16,1>-MIDI channel (0 = omni)
slider8:35<0,100,1>-Fate (%)
slider9:0<0,1,1{Fifths,Fourths}>-Cycle
slider10:0<0,3,1{1,2,4,8}>-Revolution (loops a turn)
slider11:0<0,2,1{Turn,Resolve,Reset}>-Resolution
slider12:8<1,12,1>-Steps
slider13:1<0,5,1{1/4,1/8,1/8T,1/16,1/16T,1/32}>-Rate
slider14:60<5,100,1>-Gate (%)
slider15:40<0,100,1>-Fortune (%)
slider16:0<0,1,1{Off,On}>-Wild card
slider17:0<0,4,1{Up,Down,Up-Down,As played,Random}>-Hold order
slider18:0<0,60,1>-Swing (%)
slider19:0<-13,12,1>-Step 1 (st, -13 = rest)
slider20:12<-13,12,1>-Step 2 (st, -13 = rest)
slider21:7<-13,12,1>-Step 3 (st, -13 = rest)
slider22:-13<-13,12,1>-Step 4 (st, -13 = rest)
slider23:3<-13,12,1>-Step 5 (st, -13 = rest)
slider24:10<-13,12,1>-Step 6 (st, -13 = rest)
slider25:7<-13,12,1>-Step 7 (st, -13 = rest)
slider26:5<-13,12,1>-Step 8 (st, -13 = rest)
slider27:0<-13,12,1>-Step 9 (st, -13 = rest)
slider28:7<-13,12,1>-Step 10 (st, -13 = rest)
slider29:12<-13,12,1>-Step 11 (st, -13 = rest)
slider30:-13<-13,12,1>-Step 12 (st, -13 = rest)
slider31:0<-24,24,1>-Node A pitch (st)
slider32:0.12<-12,12,0.01>-Node B detune (st)
slider33:35<0,100,1>-Coupling (%)
slider34:50<0,100,1>-Node mix (A to B, %)
slider35:15<0,100,1>-Sub-sonic pulse (%)
slider36:3<0.5,12,0.01>-Pulse rate (Hz)
slider37:30<0,100,1>-Overload (%)
slider38:30<0,100,1>-Thermal drift (%)
slider39:40<0,100,1>-Tube bias (%)
slider40:15<0,100,1>-Ring-mod mix (%)
slider41:2.5<0.25,8,0.01>-Ring carrier ratio
slider42:30<0,100,1>-Voltage sag (%)
slider43:0.7<0.02,40,0.001>-Chaos rate (Hz)
slider44:25<0,100,1>-Chaos depth (%)
slider45:1800<60,12000,1>-Cutoff (Hz)
slider46:45<0,100,1>-Resonance (%)
slider47:40<-100,100,1>-Filter envelope (%)
slider48:4<1,3000,0.1>-Attack (ms)
slider49:400<10,5000,1>-Decay (ms)
slider50:50<0,100,1>-Sustain (%)
slider51:600<10,8000,1>-Release (ms)
slider52:50<0,100,1>-Velocity (%)
slider53:70<0,100,1>-Level (%)
slider54:0<0,1,1{Open,Closed}>-Loop: echo to nodes
slider55:1<0,1,1{Open,Closed}>-Loop: chaos to pitch
slider56:1<0,1,1{Open,Closed}>-Loop: load to sag
slider57:1<0,1,1{Open,Closed}>-Loop: wheel to circuit
slider58:1<0,7,1{1/2,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16}>-Oil-can time
slider59:45<0,95,1>-Echo feedback (%)
slider60:30<0,100,1>-Chaos feedback (%)
slider61:40<0,100,1>-Oil-can warble (%)
slider62:35<0,100,1>-Echo level (%)
slider63:50<0,100,1>-Spring damping (%)
slider64:55<0,100,1>-Spring decay (%)
slider65:30<0,100,1>-Spring driver (%)
slider66:30<0,100,1>-Spring level (%)
slider67:-4<-24,6,0.1>-Volume (dB)
slider68:0<0,100,1>-Band sat (%)
slider69:30<0,100,1>-Bias (%)
slider70:120<40,400,1>-Sat low band (Hz)
slider71:6000<2000,16000,10>-Sat high band (Hz)
slider72:-0.3<-24,0,0.1>-Ceiling (dB)
slider73:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider74:1<0,1,1{Off,On}>-Start / Stop with the REAPER transport
slider75:prs_sel=0<0,12,1{No preset,Init,Krell Machine,Id Monster,Clockwork Sequencer,Tube Birds,Wheel of Fifths,Downward Spiral,Ring Constellation,Thermal Runaway,Power Up,Infrasonic Throb,Wild Card Arp}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-wheel";
ext_noinit = 1;
fl_ok = 0;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
WDEF = 30000; WTMP = 30200;                                // the Init values; preset parser scratch
WV   = 31000; WVN = 6; WVS = 64;                           // voices: 6 x 64 slots
WHN  = 31500;                                              // held notes: velocity by note number (128)
WHL  = 31700;                                              // held notes in the order they were played (32)
WAR  = 31750;                                              // the hold arpeggio's list (32)
WSC  = 31800; WSCN = 512;                                  // the scope's ring (for the panel)
WVIS = 32400;                                              // the wheel: the keys it has visited this revolution (12)
WSP  = 32500;                                              // the spring's allpasses: 2 sides x 8 states
WKD  = 32600;                                              // the keys down now (128)
MEL  = 40000; MER = 40000 + 262144; MEM = 262143;          // the oil-can echo (2^18 each)
MSL  = 600000; MSR = 600000 + 8192; MSM = 8191;            // the spring loops
memset(WV, 0, WVN * WVS); memset(WHN, 0, 128); memset(WSC, 0, WSCN); memset(WVIS, 0, 12); memset(WSP, 0, 64); memset(WKD, 0, 128);
memset(MEL, 0, 262144 * 2); memset(MSL, 0, 8192 * 2);
// voice slots (q = WV + v * WVS):
//   0 on  1 note  2 velocity gain  3 gate samples left (-1 = held)  4 stage (1 A 2 D 3 S 4 R 5 stolen)  5 level
//   6 / 7 node A (x, y)  8 / 9 node B (x, y)  10 / 11 filter state  12 ring phase  13 thermal (st)
//   14 / 15 / 16 / 17 thermal wander (a, b, phase, rate)  18 failure type  19 its phase 0..1  20 its step a tick
//   21 its size  22 its aim  23 tail droop (st)  24 age  25 residual  26 last output  27 / 28 / 29 waiting note
//   (note, velocity, gate)  30 waiting  31 / 32 node increments
//   33 / 34 / 41 filter coefficients  35 ring increment  36 mu  39 ring added  40 warm-up (st)

L12 = log(2) / 12;
// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#wf_def = "0 0 0 1 9 3 0 35 0 0 0 8 1 60 40 0 0 0 0 12 7 -13 3 10 7 5 0 7 12 -13 0 0.12 35 50 15 3 30 30 40 15 2.5 30 0.7 25 1800 45 40 4 400 50 600 50 70 0 1 1 1 1 45 30 40 35 50 55 30 30 -4 0 30 120 6000 -0.3 1";
function wf_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function wf_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
wf_nums(#wf_def, WDEF);
#wf_pm = "Init|Krell Machine|Id Monster|Clockwork Sequencer|Tube Birds|Wheel of Fifths|Downward Spiral|Ring Constellation|Thermal Runaway|Power Up|Infrasonic Throb|Wild Card Arp";
wf_npre = 12;
function wf_pstr(p) (
  p == 2  ? "12:8 19:0 20:-13 21:7 22:12 23:-13 24:10 25:7 26:-13 5:2 6:2 13:1 31:12 32:0.35 33:70 37:55 40:30 41:1.5 42:45 45:1400 46:60 47:30 48:40 49:900 50:60 51:1800 58:0 59:65 61:55 62:45 64:70 66:40 53:61" :
  p == 3  ? "12:8 19:0 20:-13 21:-13 22:1 23:0 24:-13 25:6 26:-13 5:4 6:1 13:0 31:0 32:-0.3 33:60 37:92 46:85 42:75 40:35 41:0.75 43:0.3 44:60 45:700 47:55 48:20 49:1500 50:70 51:3000 54:1 56:1 57:1 59:70 60:60 62:40 66:45 15:70" :
  p == 4  ? "12:12 19:0 20:7 21:12 22:7 23:3 24:7 25:10 26:7 27:0 28:7 29:12 30:12 5:0 6:3 9:1 13:3 14:45 31:0 32:12 33:15 34:30 37:8 39:20 40:0 42:10 45:3200 46:25 47:50 48:2 49:220 50:0 51:150 59:35 62:30 66:15 15:15 53:98" :
  p == 5  ? "12:8 19:0 20:12 21:-13 22:7 23:12 24:-13 25:5 26:10 5:9 6:5 13:3 14:30 33:45 37:76 46:72 43:3 44:60 40:20 41:3 45:3000 47:70 48:2 49:160 50:0 51:400 16:1 59:50 62:40 61:60 66:35 53:87" :
  p == 6  ? "12:4 19:0 20:4 21:7 22:12 5:0 6:3 13:3 14:70 31:0 32:0.05 33:50 37:12 39:15 40:0 45:2600 46:30 47:25 48:3 49:300 50:40 51:300 59:30 62:25 15:10 55:0 53:63" :
  p == 7  ? "12:8 19:12 20:10 21:7 22:3 23:0 24:-13 25:-2 26:-5 5:7 6:3 9:1 11:1 13:1 33:40 37:70 42:85 56:1 46:55 45:1600 48:10 49:700 50:30 51:2500 59:55 61:70 62:40 64:75 66:40 15:60 53:60" :
  p == 8  ? "12:8 19:0 20:-13 21:3 22:-13 23:7 24:10 25:-13 26:12 5:5 6:3 13:1 37:35 40:75 41:3.5 43:1.2 44:70 55:1 45:4000 46:35 47:20 48:3 49:600 50:30 51:1200 59:50 60:70 62:40 66:35 53:76" :
  p == 9  ? "12:8 19:0 20:3 21:7 22:3 23:12 24:7 25:3 26:-13 5:1 6:3 13:3 14:50 38:100 42:90 56:1 57:1 15:100 37:45 46:50 45:1800 47:40 48:3 49:350 50:20 51:500 16:1 59:45 60:50 62:35" :
  p == 10 ? "12:6 19:0 20:7 21:10 22:12 23:12 24:7 5:11 6:3 11:2 13:3 37:62 46:60 45:2000 47:60 48:2 49:250 50:20 51:350 59:40 62:35" :
  p == 11 ? "12:8 19:0 20:-13 21:-13 22:-13 23:-13 24:-13 25:-13 26:-13 5:9 6:2 13:0 14:100 31:0 32:12 33:85 35:80 36:1.5 37:40 42:60 45:900 46:50 47:10 48:600 49:3000 50:90 51:3000 40:20 41:0.5 59:40 62:30 64:80 66:50 53:87" :
  p == 12 ? "12:12 13:3 17:2 16:1 14:55 37:40 46:55 45:2400 47:45 48:2 49:300 50:30 51:600 15:50 59:45 62:35 66:25 53:67" :
  "";
);
function wf_pstr_au(p) (
  p == 2  ? "12:8 19:0 20:-13 21:7 22:12 23:-13 24:10 25:7 26:-13 5:2 6:2 13:1 31:12 32:0.35 33:70 37:55 40:30 41:1.5 42:45 45:1400 46:60 47:30 48:40 49:900 50:60 51:1800 58:0 59:65 61:55 62:45 64:70 66:40 53:61" :
  p == 3  ? "12:8 19:0 20:-13 21:-13 22:1 23:0 24:-13 25:6 26:-13 5:4 6:1 13:0 31:0 32:-0.3 33:60 37:92 46:85 42:75 40:35 41:0.75 43:0.3 44:60 45:700 47:55 48:20 49:1500 50:70 51:3000 54:1 56:1 57:1 59:70 60:60 62:40 66:45 15:70" :
  p == 4  ? "12:12 19:0 20:7 21:12 22:7 23:3 24:7 25:10 26:7 27:0 28:7 29:12 30:12 5:0 6:3 9:1 13:3 14:45 31:0 32:12 33:15 34:30 37:8 39:20 40:0 42:10 45:3200 46:25 47:50 48:2 49:220 50:0 51:150 59:35 62:30 66:15 15:15 53:98" :
  p == 5  ? "12:8 19:0 20:12 21:-13 22:7 23:12 24:-13 25:5 26:10 5:9 6:5 13:3 14:30 33:45 37:76 46:72 43:3 44:60 40:20 41:3 45:3000 47:70 48:2 49:160 50:0 51:400 16:1 59:50 62:40 61:60 66:35 53:87" :
  p == 6  ? "12:4 19:0 20:4 21:7 22:12 5:0 6:3 13:3 14:70 31:0 32:0.05 33:50 37:12 39:15 40:0 45:2600 46:30 47:25 48:3 49:300 50:40 51:300 59:30 62:25 15:10 55:0 53:63" :
  p == 7  ? "12:8 19:12 20:10 21:7 22:3 23:0 24:-13 25:-2 26:-5 5:7 6:3 9:1 11:1 13:1 33:40 37:70 42:85 56:1 46:55 45:1600 48:10 49:700 50:30 51:2500 59:55 61:70 62:40 64:75 66:40 15:60 53:60" :
  p == 8  ? "12:8 19:0 20:-13 21:3 22:-13 23:7 24:10 25:-13 26:12 5:5 6:3 13:1 37:35 40:75 41:3.5 43:1.2 44:70 55:1 45:4000 46:35 47:20 48:3 49:600 50:30 51:1200 59:50 60:70 62:40 66:35 53:76" :
  p == 9  ? "12:8 19:0 20:3 21:7 22:3 23:12 24:7 25:3 26:-13 5:1 6:3 13:3 14:50 38:100 42:90 56:1 57:1 15:100 37:45 46:50 45:1800 47:40 48:3 49:350 50:20 51:500 16:1 59:45 60:50 62:35" :
  p == 10 ? "12:6 19:0 20:7 21:10 22:12 23:12 24:7 5:11 6:3 11:2 13:3 37:62 46:60 45:2000 47:60 48:2 49:250 50:20 51:350 59:40 62:35" :
  p == 11 ? "12:8 19:0 20:-13 21:-13 22:-13 23:-13 24:-13 25:-13 26:-13 5:9 6:2 13:0 14:100 31:0 32:12 33:85 35:80 36:1.5 37:40 42:60 45:900 46:50 47:10 48:600 49:3000 50:90 51:3000 40:20 41:0.5 59:40 62:30 64:80 66:50 53:87" :
  p == 12 ? "12:12 13:3 17:2 16:1 14:55 37:40 46:55 45:2400 47:45 48:2 49:300 50:30 51:600 15:50 59:45 62:35 66:25 53:67" :
  "";
);
function load_preset(p) local(n, i) (
  // MODE, LATCH, RUN, FOLLOW, TRANSPORT, the MIDI channel, FATE, VOLUME and the output stage stay as they are
  i = 0; loop(73, (i >= 8 || i == 4 || i == 5) && i < 66 ? slider(i + 1) = WDEF[i]; i += 1; );
  n = wf_nums(wf_pstr(p), WTMP);
  i = 0; loop(floor(n / 2), WTMP[i * 2] >= 1 && WTMP[i * 2] <= 73 ? slider(WTMP[i * 2]) = WTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(73, ui_auto(i); i += 1; );
  pr_cur = p; wf_panic = 1;
);
function load_preset_au(p) local(n, i) (
  // MODE, LATCH, RUN, FOLLOW, TRANSPORT, the MIDI channel, FATE, VOLUME and the output stage stay as they are
  i = 0; loop(73, (i >= 8 || i == 4 || i == 5) && i < 66 ? slider(i + 1) = WDEF[i]; i += 1; );
  n = wf_nums_au(wf_pstr_au(p), WTMP);
  i = 0; loop(floor(n / 2), WTMP[i * 2] >= 1 && WTMP[i * 2] <= 73 ? slider(WTMP[i * 2]) = WTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(73, ui_auto(i); i += 1; );
  pr_cur = p; wf_panic = 1;
);
function reset_all() local(i) (
  load_preset(1);
  i = 0; loop(73, slider(i + 1) = WDEF[i]; ui_auto(i + 1); i += 1; );
  slider74 = 1; ui_auto(74);
);

// ---------- helpers ----------
function wf_mod(a, n) ( a - floor(a / n) * n; );
function wf_rate_beats(r) ( r == 0 ? 1 : r == 1 ? 0.5 : r == 2 ? 1 / 3 : r == 3 ? 0.25 : r == 4 ? 1 / 6 : 0.125; );
function wf_dly_beats(r) ( r == 0 ? 2 : r == 1 ? 1.5 : r == 2 ? 1 : r == 3 ? 2 / 3 : r == 4 ? 0.75 : r == 5 ? 0.5 : r == 6 ? 1 / 3 : 0.25; );
// a Van der Pol oscillator's period grows with its nonlinearity mu; this undoes it, so the notes stay in tune
function wf_vdp_comp(mu) ( 1 + 0.052 * mu * mu / (1 + 0.03 * mu * mu); );
// the wheel: the transposition for position p (0..11), folded into -5 .. +6 so the pattern keeps its register
function wf_turn(p) local(t) ( t = wf_mod(p * (wf_cyc ? 5 : 7), 12); t > 6 ? t - 12 : t; );

// ---------- the voices ----------
function wf_alloc() local(v, q, best, bs, sc) (
  best = 0; bs = -1000000000; v = 0;
  loop(WVN,
    q = WV + v * WVS;
    sc = !q[0] ? 1000000000 : q[4] == 5 ? -1 : q[4] == 4 ? 1000000 - q[5] * 1000 + q[24] * 0.001 : q[24];
    sc > bs ? ( bs = sc; best = v; );
    v += 1;
  );
  WV + best * WVS;
);
function wf_start(q, note, vel, gate) (
  q[0] ? q[25] += q[26];
  q[0] = 1; q[1] = note; q[2] = vel; q[3] = gate; q[4] = 1; q[5] = 0; q[24] = 0; q[30] = 0;
  // the nodes start on their cycle, at a random phase (close together: the coupling pulls them into step)
  wf_ph0 = rand(2 * $pi); q[6] = 2 * cos(wf_ph0); q[7] = -2 * sin(wf_ph0);
  wf_ph0 += rand(0.6) - 0.3; q[8] = 2 * cos(wf_ph0); q[9] = -2 * sin(wf_ph0); q[12] = rand(1);
  q[14] = rand(2) - 1; q[15] = rand(2) - 1; q[16] = rand(1); q[17] = 0.7 + rand(0.6);
  q[23] = 0; q[40] = -wf_therm * 0.3;                         // it warms up into tune
  q[18] = wf_chirp_up ? 1 : 0; q[19] = 0; q[20] = 8 / (0.12 * srate); q[21] = 1; q[22] = 1;   // a power-up chirp after RESET
  wf_chirp_up = 0;
);
// a new note: on a free voice at once; stealing one that still sounds, it fades over about 4 ms first
function wf_non(note, vel, gate) local(q) (
  q = wf_alloc();
  q[0] && q[5] * q[2] > 0.001 ? ( q[27] = note; q[28] = vel; q[29] = gate; q[30] = 1; q[4] = 5; )
                              : wf_start(q, note, vel, gate);
);
function wf_release_all() local(v, q) (
  v = 0; loop(WVN, q = WV + v * WVS; q[0] && q[4] < 4 ? q[4] = 4; q[4] == 5 ? q[30] = 0; v += 1; );
);
// a failure of the circuit: 1 CHIRP (a fast sweep of the filter, up or down), 2 SQUEAL (the filter howls at a
// high pitch), 3 BUBBLE (the ring modulator bubbles on the attractor), 4 DROP (the supply drops out for a moment)
function wf_fail(q, kind, size) (
  q[18] = kind; q[19] = 0; q[21] = size;
  kind == 1 ? ( q[20] = 8 / ((0.04 + rand(0.1)) * srate); q[22] = rand(1) < 0.65 ? 1 : -1; ) :
  kind == 2 ? ( q[20] = 8 / ((0.06 + rand(0.16)) * srate); q[22] = 1.5 + rand(1.6); ) :
  kind == 3 ? ( q[20] = 8 / ((0.1 + rand(0.25)) * srate); q[22] = 0; ) :
              ( q[20] = 8 / ((0.05 + rand(0.12)) * srate); q[22] = 0; );
);

// ---------- the spring: a dispersive allpass chain into a damped loop ----------
function wf_sap(i, x, k) local(y) ( y = k * x + WSP[i]; WSP[i] = x - k * y; y; );

// ---------- parameters ----------
function update() local(i) (
  wf_tmp = tempo > 0 ? tempo : 120;
  wf_mode = slider1 >= 0.5; wf_latch = slider2 >= 0.5; wf_frun = slider3 >= 0.5; wf_follow = slider4 >= 0.5;
  wf_root = floor(slider5 + 0.5); wf_oct = floor(slider6 + 0.5); wf_chan = floor(slider7 + 0.5); wf_fate = slider8 / 100;
  wf_cyc = slider9 >= 0.5; wf_rev = 2 ^ floor(slider10 + 0.5); wf_res = floor(slider11 + 0.5);
  wf_ns = floor(slider12 + 0.5); wf_rd = wf_rate_beats(floor(slider13 + 0.5));
  wf_trip = floor(slider13 + 0.5) == 2 || floor(slider13 + 0.5) == 4;
  wf_gate0 = slider14 / 100; wf_fort = slider15 / 100; wf_wild = slider16 >= 0.5; wf_hord = floor(slider17 + 0.5);
  wf_sw = slider18 / 100;
  wf_pa = slider31; wf_pb = slider32; wf_cpl0 = slider33 / 100; wf_nmix = slider34 / 100;
  wf_pul = slider35 / 100; wf_pulr = slider36;
  wf_ov0 = slider37 / 100; wf_therm = slider38 / 100; wf_bias = slider39 / 100 * 0.6;
  wf_rmix0 = slider40 / 100; wf_rrat = slider41; wf_sag = slider42 / 100; wf_crate = slider43; wf_cdep = slider44 / 100;
  wf_cut0 = slider45; wf_reso0 = slider46 / 100; wf_fenv = slider47 / 100;
  wf_ac = vo_coef(slider48 * 0.6); wf_dc = vo_coef(slider49); wf_sl = slider50 / 100; wf_rc = vo_coef(slider51);
  wf_velo = slider52 / 100; wf_lev = sqr(slider53 / 100) * 2.4;
  wf_k_echo = slider54 >= 0.5; wf_k_chaos = slider55 >= 0.5; wf_k_load = slider56 >= 0.5; wf_k_wheel = slider57 >= 0.5;
  wf_eb = wf_dly_beats(floor(slider58 + 0.5)); wf_efb0 = slider59 / 100; wf_ecf = slider60 / 100; wf_ewb = slider61 / 100;
  wf_elev = slider62 / 100;
  wf_et = min(wf_eb * 60 / wf_tmp * srate, MEM - 2000);
  wf_sdamp = 1 - exp(-2 * $pi * min(9000 * 2 ^ (-slider63 / 100 * 4.5), srate * 0.45) / srate);
  wf_sfb = 0.55 + 0.42 * (slider64 / 100) ^ 0.7; wf_sdrv = 1 + slider65 / 100 * 5; wf_slev = slider66 / 100;
  wf_volt = 10 ^ (slider67 / 20);
  ins_output_setup(68);   // output stage: CLIP, always on
);
ins_drift_init();
function wf_srinit() (
  wf_sr = srate; wf_sm = 1 - exp(-1 / (0.03 * srate)); ost_init(20000);
  wf_res_c = exp(-1 / (0.003 * srate)); wf_stc = vo_coef(4);
  wf_pcdn = 1 / (0.012 * srate); wf_pcup = 1 / (0.02 * srate);
  wf_sga = 1 - exp(-8 / (0.02 * srate)); wf_sgr = 1 - exp(-8 / (0.35 * srate));   // the supply: sags in 20 ms, recovers in 350 ms
  wf_warm = exp(-8 / (0.25 * srate));
  wf_ehp = 1 - exp(-2 * $pi * 120 / srate); wf_elp = 1 - exp(-2 * $pi * 2600 / srate);
  wf_sl1 = floor(0.0331 * srate); wf_sl2 = floor(0.0417 * srate);
  wf_shp = 1 - exp(-2 * $pi * 90 / srate);
  update();
);
wf_srinit();
wf_pcf = 0; wf_pcg = 1; wf_ct = 7; wf_run = 0; wf_fpos = 0; wf_gs = -1000000000; wf_lp = -1000000000; wf_wp = 0; wf_turns = 0;
wf_rest = 0; wf_vol = wf_volt; wf_ew = 0; wf_sw2 = 0; wf_sc = 0; wf_nh = 0; wf_nl = 0; wf_ac_ = 0; wf_pedal = 0;
wf_lx = 0.1; wf_ly = 0; wf_lz = 20; wf_S = 0; wf_pph = 0; wf_wph = 0; wf_wph2 = 0; wf_ets = -1; wf_chirp_up = 0;
wf_kmode = -1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// ---------- the step: the note for step k of loop n, through the wheel ----------
function wf_step(k) local(s, n, nt, i, j, t, gate, vel) (
  s = wf_mod(k, wf_ns); n = floor(k / wf_ns);
  // a new loop: the wheel turns (every REVOLUTION loops)
  n != wf_lp ? (
    wf_lp = n;
    wf_rest == 2 ? wf_rest = 1 :                                        // RESOLVE: the pass at home is done
    wf_rest == 0 && n > wf_n0 && wf_mod(n - wf_n0, wf_rev) == 0 ? (
      wf_wild && rand(1) < 0.25 ? wf_wp = wf_mod(wf_wp + 1 + floor(rand(11)), 12) : wf_wp = wf_mod(wf_wp + 1, 12);
      wf_turns += 1;
      WVIS[wf_wp] = 1;
      wf_wp == 0 ? (
        memset(WVIS, 0, 12); WVIS[0] = 1;
        wf_res == 1 ? wf_rest = 2 :                                     // RESOLVE: one more pass at home, then rest
        wf_res == 2 ? ( wf_chirp_up = 1; wf_S = 0; wf_cool = 1; );      // RESET: the circuit cools and re-arms
      );
    );
  );
  wf_sstep = s;
  wf_rest == 1 ? 0 : (
    t = wf_turn(wf_wp);
    gate = floor(wf_rd * 60 / wf_tmp * srate * wf_gate0);
    nt = -1; vel = 0.85;
    wf_mode ? (
      i = floor(slider(19 + s) + 0.5);
      i > -13 ? nt = 12 * (wf_oct + 1) + wf_root + i;
      s == 0 ? vel = 1;
    ) : (
      wf_an > 0 ? (
        n = wf_an;
        wf_hord == 0 ? j = wf_mod(wf_ac_, n) :
        wf_hord == 1 ? j = n - 1 - wf_mod(wf_ac_, n) :
        wf_hord == 2 ? ( i = max(2 * n - 2, 1); j = wf_mod(wf_ac_, i); j >= n ? j = i - j; ) :
        wf_hord == 3 ? j = wf_mod(wf_ac_, n) : j = floor(rand(n));
        nt = WAR[j]; vel = WHN[nt]; wf_ac_ += 1;
      );
    );
    nt >= 0 ? ( nt += t; nt = min(max(nt, 12), 115); wf_non(nt, 1 - wf_velo + wf_velo * vel, gate); wf_lastn = nt; );
  );
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
!wf_pcf && !wf_panic ? update();

@block
prs_chk();
srate != wf_sr ? wf_srinit();
wf_panic && !wf_pcf ? ( wf_pcf = 1; wf_panic = 0; );
wf_pcf == 2 ? (
  memset(MEL, 0, 262144 * 2); memset(MSL, 0, 8192 * 2); memset(WV, 0, WVN * WVS); memset(WSP, 0, 64);
  wf_el = wf_er = 0; wf_gs = -1000000000; wf_lp = -1000000000;
  wf_pcf = 3;
);
// TRANSPORT: while lit, REAPER's play (or record) presses START and its stop presses STOP; the keys still work by hand
wf_xp = play_state & 1;
slider74 >= 0.5 && wf_xp != wf_xpw ? ( slider3 = wf_xp; wf_frun = wf_xp; ui_auto(3); );
wf_xpw = wf_xp;
wf_pcf != 1 ? update();

// MIDI: held notes (HOLD), sustain, all notes off
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, wf_chan) ? (
    wf_st = m1 & 0xF0;
    wf_st == 0x90 && m3 > 0 ? (
      // with LATCH (or the pedal down), a new chord after every key was let go replaces the old one
      (wf_latch || wf_pedal) && wf_nh == 0 ? ( memset(WHN, 0, 128); wf_nl = 0; );
      WHN[m2] == 0 && wf_nl < 32 ? ( WHL[wf_nl] = m2; wf_nl += 1; );
      WHN[m2] = max(m3 / 127, 0.01); !WKD[m2] ? wf_nh += 1; WKD[m2] = 1; ins_midi_hit();
    ) :
    wf_st == 0x80 || (wf_st == 0x90 && m3 == 0) ? (
      WKD[m2] ? ( wf_nh = max(wf_nh - 1, 0); WKD[m2] = 0; );
      !wf_latch && !wf_pedal ? wf_drop = 1;
    ) :
    wf_st == 0xB0 ? (
      m2 == 64 ? ( wf_pedal = m3 >= 64; !wf_pedal ? wf_drop = 1; ) :
      m2 == 123 || m2 == 120 ? ( memset(WHN, 0, 128); memset(WKD, 0, 128); wf_nl = 0; wf_nh = 0; );
    );
  );
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( memset(WHN, 0, 128); memset(WKD, 0, 128); wf_nl = 0; wf_nh = 0; );
gfx_pst_prev = gfx_pst;
// LATCH switched off: the notes no longer down go
wf_latch_was && !wf_latch ? wf_drop = 1;
wf_latch_was = wf_latch;
// drop the notes that are no longer down (unless LATCH or the pedal holds them)
wf_drop && !wf_latch && !wf_pedal ? (
  i_ = 0; j_ = 0;
  loop(wf_nl, WKD[WHL[i_]] ? ( WHL[j_] = WHL[i_]; j_ += 1; ) : WHN[WHL[i_]] = 0; i_ += 1; );
  wf_nl = j_;
);
wf_drop = 0;
// the hold arpeggio's notes: sorted, or in the order played
wf_an = wf_nl;
i_ = 0; loop(wf_nl, WAR[i_] = WHL[i_]; i_ += 1; );
wf_hord != 3 ? (
  i_ = 1; loop(wf_an - 1, k_ = i_; while (k_ > 0 && WAR[k_ - 1] > WAR[k_]) ( t_ = WAR[k_]; WAR[k_] = WAR[k_ - 1]; WAR[k_ - 1] = t_; k_ -= 1; ); i_ += 1; );
);

// the clock: REAPER's position while it plays (FOLLOW); else our own - in SELF while START is lit, in HOLD while
// notes are held (it starts from the first note)
wf_inc = wf_tmp / 60 / srate;
wf_tp = wf_follow && (play_state & 1);
wf_runt = wf_mode ? wf_frun && (wf_follow ? (play_state & 1) : 1) : (wf_an > 0);
wf_runt && !wf_run ? (
  wf_fpos = 0; wf_gs = -1000000000; wf_lp = -1000000000; wf_wp = 0; wf_turns = 0; wf_rest = 0; wf_ac_ = 0;
  memset(WVIS, 0, 12); WVIS[0] = 1;
  wf_n0 = floor((wf_tp ? beat_position : 0) / (wf_rd * wf_ns));
);
!wf_runt && wf_run ? wf_release_all();
wf_run = wf_runt;
wf_pos = wf_tp ? beat_position : wf_fpos;
// the steps' grid changed (STEPS or RATE): keep the wheel where it is
wf_run && (wf_ns != wf_ns_was || wf_rd != wf_rd_was) ? ( wf_n0 = floor(wf_pos / (wf_rd * wf_ns)); wf_lp = wf_n0; );
wf_ns_was = wf_ns; wf_rd_was = wf_rd;

// FATE: the valves wander
ins_drift_block(wf_fate * 0.6, samplesblock);
wf_ets < 0 ? wf_ets = wf_et;
abs(wf_el) + abs(wf_er) < 0.0000000001 ? wf_el = wf_er = 0;
// the wheel's distance from home (0 .. 1) and what FORTUNE does with it
wf_hd = min(wf_wp, 12 - wf_wp) / 6;
wf_fw = wf_k_wheel ? wf_fort * wf_hd : 0;
wf_cool ? ( v_ = 0; loop(WVN, q_ = WV + v_ * WVS; q_[13] = 0; q_[18] = 0; v_ += 1; ); wf_cool = 0; );
// the panel's scope runs a little ahead: let it know the key
wf_key = wf_mod(wf_mode ? wf_root : (wf_an > 0 ? WAR[0] : wf_root), 12);

@serialize
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the wheel: the steps ----------
wf_run && wf_ns > 0 ? (
  wf_t = wf_pos / wf_rd; wf_kk = floor(wf_t); wf_f = wf_t - wf_kk;
  !wf_trip && (wf_kk & 1) && wf_f < wf_sw ? wf_kk -= 1;
  wf_kk != wf_gs ? ( wf_gs = wf_kk; wf_step(wf_kk); );
);
wf_pos += wf_inc; wf_fpos += wf_inc;

// ---------- control tick (every 8 samples): the attractor, the supply, the voices' pitch, filter and failures ----------
wf_ct += 1;
wf_ct >= 8 ? (
  wf_ct = 0;
  // the filter's CUTOFF (two 15 ms stages), RESO and ENV glide, so a turned knob or automation never steps
  fl_k = 1 - exp(-8 / (0.015 * srate));
  !fl_ok ? ( fl_c1 = fl_c2 = log(wf_cut0); fl_rs = wf_reso0; fl_ev = wf_fenv; fl_ok = 1; );
  fl_c1 += (log(wf_cut0) - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (wf_reso0 - fl_rs) * fl_k; fl_ev += (wf_fenv - fl_ev) * fl_k;
  // the Lorenz attractor (sigma 10, rho 28, beta 8/3): a chaotic LFO that never repeats
  wf_dt = min(wf_crate * 0.77 * 8 / srate, 0.01);
  wf_ldx = 10 * (wf_ly - wf_lx); wf_ldy = wf_lx * (28 - wf_lz) - wf_ly; wf_ldz = wf_lx * wf_ly - 8 / 3 * wf_lz;
  wf_lx += wf_ldx * wf_dt; wf_ly += wf_ldy * wf_dt; wf_lz += wf_ldz * wf_dt;
  wf_cx = wf_lx / 20; wf_cy = wf_ly / 27; wf_cz = (wf_lz - 25) / 20;
  // the sub-sonic pulse: a throb in the supply
  wf_pph += wf_pulr * 8 / srate; wf_pph -= floor(wf_pph);
  wf_pv = 0.5 - 0.5 * cos(2 * $pi * wf_pph);
  // the supply: sags under load (the output with LOAD > SAG closed, else the voices sounding), throbs with the pulse
  wf_load = wf_k_load ? min(wf_ld * 3, 1.5) : wf_nv / WVN;
  wf_S += (wf_load - wf_S) * (wf_load > wf_S ? wf_sga : wf_sgr);
  wf_vs = 1 - wf_sag * wf_S * 0.6 - wf_pul * wf_pv * 0.25;
  wf_ld *= 0.995;
  // the circuit's stress: OVERLOAD, more as the supply sags, and FORTUNE away from home
  wf_ov = min(wf_ov0 + wf_fw * 0.45 + wf_sag * wf_S * 0.1, 1.2);
  wf_mu = 0.08 + 3.6 * wf_ov ^ 1.6;
  wf_cpl = min(wf_cpl0 + wf_fw * 0.35, 1);
  wf_rmix = min(wf_rmix0 + wf_fw * 0.2, 1);
  wf_reso = min(fl_rs + wf_fw * 0.15, 0.995);
  // failures start past about two thirds (sooner with RESONANCE): their rate rises from there
  wf_fs = wf_ov + wf_reso0 * 0.25 - 0.66;
  wf_frate = wf_fs > 0 ? wf_fs * 14 * 8 / srate : 0;
  wf_drv = 1 + 5 * wf_ov ^ 1.4;
  wf_pchaos = wf_k_chaos ? wf_cx * wf_cdep * 1.2 : 0;                 // up to +/-1.2 semitones
  wf_cutb = exp(fl_c2 + (ins_cut + wf_fw * 1.6) * 0.693147);
  wf_comp = wf_vdp_comp(wf_mu);
  wf_nv = 0;
  wf_v = 0;
  loop(WVN,
    q_ = WV + wf_v * WVS;
    q_[0] ? (
      wf_nv += 1;
      // thermal drift: every note wanders on its own, and warms up into tune
      q_[16] += 0.35 * q_[17] * 8 / srate;
      q_[16] >= 1 ? ( q_[16] -= 1; q_[14] = q_[15]; q_[15] = rand(2) - 1; );
      q_[13] = (q_[14] + (q_[15] - q_[14]) * (0.5 - 0.5 * cos($pi * q_[16]))) * wf_therm * 0.4;
      q_[40] *= wf_warm;
      // a failure in progress
      wf_cm = 0; wf_ra = 0; wf_rs = 0; wf_dp = 0;
      q_[18] > 0 ? (
        q_[19] += q_[20]; wf_e = sin($pi * min(q_[19], 1));
        q_[18] == 1 ? ( wf_cm = q_[22] * 3.2 * q_[21] * sin($pi * 0.5 * min(q_[19], 1)) * (1 - min(q_[19], 1) * 0.3); wf_rs = 0.35 * wf_e; ) :
        q_[18] == 2 ? ( wf_cm = q_[22] * wf_e; wf_rs = 0.5 * wf_e * q_[21]; ) :
        q_[18] == 3 ? ( wf_ra = 0.8 * wf_e * q_[21]; ) :
                      ( wf_dp = 0.6 * wf_e * q_[21]; );
        q_[19] >= 1 ? q_[18] = 0;
      ) : (
        q_[4] < 4 && rand(1) < wf_frate ? wf_fail(q_, 1 + floor(rand(4)), 0.6 + rand(0.6) * min(wf_fs * 3 + 0.3, 1));
      );
      // the dying tail: past the threshold a released note's pitch dives as it fades
      q_[4] == 4 && wf_fs > -0.15 ? q_[23] += (wf_fs + 0.15) * 0.6 * 8 / srate * 12;
      // the pitch of the two nodes
      wf_p = q_[1] + wf_pa + q_[13] + q_[40] + wf_pchaos - q_[23] + 12 * log(ins_pitch * wf_vs) / log(2) - wf_dp * 3;
      wf_fa = 440 * exp((wf_p - 69) * L12); wf_fb = wf_fa * exp(wf_pb * L12);
      q_[31] = min(2 * $pi * wf_fa / (2 * srate) * wf_comp, 0.9);
      q_[32] = min(2 * $pi * wf_fb / (2 * srate) * wf_comp, 0.9);
      q_[36] = wf_mu * (1 + wf_dp);
      // the ring carrier: RATIO times the note, bubbling on the attractor (more in a BUBBLE)
      q_[35] = min(wf_fa * wf_rrat * 2 ^ (wf_cz * wf_cdep * 0.5 + wf_ra * wf_cy * 2) / srate, 0.45);
      q_[39] = wf_ra;
      // the valve low-pass: CUTOFF, the envelope, half key tracking, a CHIRP or SQUEAL
      wf_fc = wf_cutb * 2 ^ (fl_ev * 4 * q_[5] + (wf_p - 60) / 24 + wf_cm);
      wf_g = tan(min(max(wf_fc, 25), srate * 0.45) * $pi / srate);
      wf_kq = 2 - 2 * min(wf_reso + wf_rs, 0.995);
      q_[33] = 1 / (1 + wf_g * (wf_g + wf_kq)); q_[34] = wf_g * q_[33]; q_[41] = wf_g * q_[34];
      q_[24] += 8;
    );
    wf_v += 1;
  );
  // the oil-can's warble: a slow wow and a quick flutter, and the attractor (CHAOS FEEDBACK)
  wf_wph += 0.7 * 8 / srate; wf_wph -= floor(wf_wph); wf_wph2 += 5.3 * 8 / srate; wf_wph2 -= floor(wf_wph2);
  wf_wob = wf_ewb * (0.006 * sin(2 * $pi * wf_wph) + 0.0018 * sin(2 * $pi * wf_wph2)) + wf_ecf * 0.012 * wf_cy + 0.004 * ins_fx;
  wf_efb = min(wf_efb0 + wf_ecf * 0.18 * wf_cx + wf_fw * 0.12, 0.98);
);

// ---------- the voices: two coupled valve oscillators, ring modulation, valve saturation, the low-pass ----------
wf_oL = wf_oR = 0;
wf_fx = wf_k_echo ? (wf_el + wf_er) * 0.35 : 0;          // ECHO > NODES: the echo drives the oscillators
wf_v = 0;
loop(WVN,
  q_ = WV + wf_v * WVS;
  q_[0] ? (
    // envelope
    q_[3] > 0 ? ( q_[3] -= 1; q_[3] <= 0 && q_[4] < 4 ? q_[4] = 4; );
    q_[4] == 1 ? ( q_[5] += (1.3 - q_[5]) * wf_ac; q_[5] >= 1 ? ( q_[5] = 1; q_[4] = 2; ); ) :
    q_[4] == 2 ? ( q_[5] += (wf_sl - q_[5]) * wf_dc; abs(q_[5] - wf_sl) < 0.001 ? q_[4] = 3; ) :
    q_[4] == 4 ? ( q_[5] -= q_[5] * wf_rc; q_[5] < 0.001 ? ( q_[0] = 0; q_[25] += q_[26]; q_[5] = 0; ); ) :
    q_[4] == 5 ? ( q_[5] -= q_[5] * wf_stc; q_[5] < 0.0005 ? ( q_[30] ? wf_start(q_, q_[27], q_[28], q_[29]) : ( q_[0] = 0; q_[25] += q_[26]; q_[5] = 0; ); ); );
    // the two Van der Pol nodes, coupled, two steps a sample (2x)
    wf_mu_ = q_[36]; wf_a = q_[6]; wf_ya = q_[7]; wf_b = q_[8]; wf_yb = q_[9]; wf_wa = q_[31]; wf_wb = q_[32];
    wf_ya += wf_wa * (wf_mu_ * (1 - wf_a * wf_a) * wf_ya - wf_a + wf_cpl * (wf_yb - wf_ya) + wf_fx);
    wf_a += wf_wa * wf_ya;
    wf_yb += wf_wb * (wf_mu_ * (1 - wf_b * wf_b) * wf_yb - wf_b + wf_cpl * (wf_ya - wf_yb));
    wf_b += wf_wb * wf_yb;
    wf_s1 = wf_a * (1 - wf_nmix) + wf_b * wf_nmix;
    wf_ya += wf_wa * (wf_mu_ * (1 - wf_a * wf_a) * wf_ya - wf_a + wf_cpl * (wf_yb - wf_ya) + wf_fx);
    wf_a += wf_wa * wf_ya;
    wf_yb += wf_wb * (wf_mu_ * (1 - wf_b * wf_b) * wf_yb - wf_b + wf_cpl * (wf_ya - wf_yb));
    wf_b += wf_wb * wf_yb;
    // (a runaway node is caught)
    abs(wf_a) > 6 || abs(wf_ya) > 40 ? ( wf_a = 0.1; wf_ya = 0; );
    abs(wf_b) > 6 || abs(wf_yb) > 40 ? ( wf_b = -0.1; wf_yb = 0; );
    q_[6] = wf_a; q_[7] = wf_ya; q_[8] = wf_b; q_[9] = wf_yb;
    wf_x = (wf_s1 + wf_a * (1 - wf_nmix) + wf_b * wf_nmix) * 0.25;           // (the two steps averaged; about +/-1)
    // ring modulation
    q_[12] += q_[35]; q_[12] -= floor(q_[12]);
    wf_rm = min(wf_rmix + q_[39], 1);
    wf_x = wf_x * (1 - wf_rm) + wf_x * sin(2 * $pi * q_[12]) * wf_rm * 1.4;
    // the rectified valve: asymmetric saturation, driven harder by OVERLOAD, with less headroom as the supply sags
    wf_d = wf_drv / max(wf_vs, 0.4);
    wf_x = (vo_tanh((wf_x + wf_bias) * wf_d) - vo_tanh(wf_bias * wf_d)) / min(wf_d, 2.5);
    // the valve low-pass (zero-delay SVF, its loop softly limited so a howl stays a howl)
    wf_v3 = wf_x - q_[11]; wf_v1 = vo_tanh(q_[33] * q_[10] + q_[34] * wf_v3); wf_v2 = q_[11] + q_[34] * q_[10] + q_[41] * wf_v3;
    q_[10] = 2 * wf_v1 - q_[10]; q_[11] = 2 * wf_v2 - q_[11];
    abs(q_[10]) + abs(q_[11]) > 30 ? q_[10] = q_[11] = 0;
    wf_y = wf_v2 * q_[5] * q_[2];
    q_[26] = wf_y;
    wf_y += q_[25]; q_[25] *= wf_res_c;
    // the nodes sit a little apart in the stereo field
    wf_oL += wf_y * (0.55 + 0.25 * (wf_v & 1 ? -1 : 1) * (wf_nmix - 0.5)); wf_oR += wf_y * (0.55 - 0.25 * (wf_v & 1 ? -1 : 1) * (wf_nmix - 0.5));
  ) : (
    q_[25] != 0 ? ( wf_y = q_[25]; q_[25] *= wf_res_c; abs(q_[25]) < 0.000001 ? q_[25] = 0; wf_oL += wf_y * 0.6; wf_oR += wf_y * 0.6; );
  );
  wf_v += 1;
);
wf_oL *= wf_lev * (1 - wf_pul * wf_pv * 0.35); wf_oR *= wf_lev * (1 - wf_pul * wf_pv * 0.35);
wf_ld = max(wf_ld, abs(wf_oL) + abs(wf_oR));

// ---------- the OIL-CAN echo: dark, warbling, gritty, its time and feedback wobbled by the attractor ----------
wf_ets += (wf_et * (1 + wf_wob) - wf_ets) * 0.0004;
wf_rp = wf_ew - wf_ets; wf_ri = floor(wf_rp); wf_rf = wf_rp - wf_ri;
wf_d1 = MEL[wf_ri & MEM] * (1 - wf_rf) + MEL[(wf_ri + 1) & MEM] * wf_rf;
wf_d2 = MER[wf_ri & MEM] * (1 - wf_rf) + MER[(wf_ri + 1) & MEM] * wf_rf;
wf_el += (wf_d1 - wf_el) * wf_elp; wf_er += (wf_d2 - wf_er) * wf_elp;
wf_eh1 += (wf_el - wf_eh1) * wf_ehp; wf_eh2 += (wf_er - wf_eh2) * wf_ehp;
MEL[wf_ew] = (wf_oL + wf_oR) * 0.5 * (wf_elev > 0.001) + vo_tanh((wf_er - wf_eh2) * wf_efb * 1.1) * 0.95;
MER[wf_ew] = vo_tanh((wf_el - wf_eh1) * wf_efb * 1.1) * 0.95;
wf_ew = (wf_ew + 1) & MEM;
wf_oL += (wf_el - wf_eh1) * wf_elev; wf_oR += (wf_er - wf_eh2) * wf_elev;

// ---------- the SPRING: a valve driver into two tanks (a chirpy dispersive chain, a damped loop) ----------
wf_slev > 0.001 ? (
  wf_si = vo_tanh((wf_oL + wf_oR) * 0.5 * wf_sdrv) / sqrt(wf_sdrv);
  wf_s1 = MSL[(wf_sw2 - wf_sl1) & MSM]; wf_s2 = MSR[(wf_sw2 - wf_sl2) & MSM];
  wf_sz1 += (wf_s1 - wf_sz1) * wf_sdamp; wf_sz2 += (wf_s2 - wf_sz2) * wf_sdamp;
  wf_sh1 += (wf_sz1 - wf_sh1) * wf_shp; wf_sh2 += (wf_sz2 - wf_sh2) * wf_shp;
  wf_u1 = wf_si + (wf_sz2 - wf_sh2) * wf_sfb; wf_u2 = wf_si + (wf_sz1 - wf_sh1) * wf_sfb;
  wf_i = 0; loop(8, wf_u1 = wf_sap(wf_i, wf_u1, 0.62); wf_u2 = wf_sap(16 + wf_i, wf_u2, 0.6); wf_i += 1; );
  MSL[wf_sw2] = wf_u1; MSR[wf_sw2] = wf_u2;
  wf_oL += (wf_sz1 - wf_sh1) * wf_slev * 0.8; wf_oR += (wf_sz2 - wf_sh2) * wf_slev * 0.8;
) : ( MSL[wf_sw2] = 0; MSR[wf_sw2] = 0; );
wf_sw2 = (wf_sw2 + 1) & MSM;

// DC block
wf_dcyl = wf_oL - wf_dcxl + 0.9996 * wf_dcyl; wf_dcxl = wf_oL; wf_oL = wf_dcyl;
wf_dcyr = wf_oR - wf_dcxr + 0.9996 * wf_dcyr; wf_dcxr = wf_oR; wf_oR = wf_dcyr;

// ---------- MASTER ----------
wf_pcf == 1 ? ( wf_pcg -= wf_pcdn; wf_pcg <= 0 ? ( wf_pcg = 0; wf_pcf = 2; ); ) :
wf_pcf == 3 ? ( wf_pcg += wf_pcup; wf_pcg >= 1 ? ( wf_pcg = 1; wf_pcf = 0; ); );
wf_oL *= wf_pcg; wf_oR *= wf_pcg;
wf_vol += (wf_volt - wf_vol) * wf_sm;
wf_oL = ostL.ost_band(wf_oL * wf_vol); wf_oR = ostR.ost_band(wf_oR * wf_vol);
ost_out(wf_oL, wf_oR);
spl0 = ost_l; spl1 = ost_r;
wf_pk = max(wf_pk, max(abs(spl0), abs(spl1)));
// the scope (for the panel): every 4th sample
(wf_sc += 1) >= 4 ? ( wf_sc = 0; WSC[wf_scw] = spl0 + spl1; wf_scw = (wf_scw + 1) & (WSCN - 1); );

@gfx 1200 800
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 13; ui_hw = 1;
ui_begin(1200, 800);

// ---------- the card's colours: Series 57 - matte alabaster enamel, deep charcoal, signal orange, atomic yellow,
// and the amber of the CRT ----------
INK = 0x26262A; LBL = 0x26262A; FACE = 0xEAE5D8; FACEX = 0xDFD9CA; WELL = 0xE2DCCE; WELL2 = 0xDCD5C5;
BAND = 0x2B2B2F; BTXT = 0xF2EDE2; ORNG = 0xE8501E; ORNGL = 0xFF8A55; YELL = 0xF2C230; DIM = 0x77736A;
FLD = 0xF7F3EA; FLDH = 0xFFFFFF; KEYOFF = 0xE3DDCF; KEYHOV = 0xD5CEBE; CREAM = 0xF3EDDD;
CRT = 0x120A03; AMB = 0xFFB347; AMBL = 0xFFE0A8; AMBD = 0x8A5418;
SILV = FLD; SILVH = FLDH; SILVD = DIM; NIGHT = CRT; LANT = ORNG; LANTL = ORNGL; LANTD = 0xB43C14; PANEL = FACE; PANX = FACEX;

// fonts, calibrated once per scale (the house way: a reference word fills the same width everywhere)
sc != ng_calsc ? (
  ng_calsc = sc;
  ng_f10 = ui_fitfont(10, 13.5 * sc);       // knob labels
  ng_f11 = ui_fitfont(11, 12.5 * sc);       // key captions
  ng_f12 = ui_fitfont(12, 14.5 * sc);       // section titles
  ng_f13 = ui_fitfont(13, 17 * sc);         // big captions
  ng_f16 = ui_fitfont(16, 12 * sc);         // values, small print
);
gfx_setfont(10, "Trebuchet MS", ng_f10, 'b'); gfx_setfont(11, "Trebuchet MS", ng_f11, 'b');
gfx_setfont(12, "Trebuchet MS", ng_f12, 'b'); gfx_setfont(13, "Trebuchet MS", ng_f13, 'b');
gfx_setfont(16, "Trebuchet MS", ng_f16, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');   // the card's name
gfx_setfont(15, "Georgia", 23 * sc, 'b');   // the numeral

// ---------- drawing helpers (GUI thread only; base coordinates) ----------
function ng_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function ng_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function ng_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function ng_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function ng_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function ng_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function ng_ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  x1 *= sc; y1 *= sc; x2 *= sc; y2 *= sc; w *= sc * 0.5;
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function ng_frame(x, y, w, h, t) ( ng_r(x, y, w, t); ng_r(x, y + h - t, w, t); ng_r(x, y, t, h); ng_r(x + w - t, y, t, h); );
// a section: a recessed tray, a silver title band ruled in ink
function ng_sect(x, y, w, h, shade, title) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  ui_col(BAND); ng_r(x, y, w, 20);
  ui_col(YELL); ng_r(x, y, 4, 20);
  strlen(title) ? ( gfx_setfont(12); ui_col(BTXT); ng_t(x + 11, y + 2, title); );
);
function ng_sub(x, y, s) ( gfx_setfont(12); ui_col(BTXT); ng_t(x, y + 2, s); );
function ng_div(x, y, h) ( ui_cola(INK, 0.5); ng_r(x, y, 1, h); );

// ---------- the HOUSE WHITE CAP knob ----------
function ng_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function ng_lcap(cx, cy, r, n, col, trk) local(rr, a, a0, ca, sa, w, i) (
  rr = r + 5.5 * sc; w = 3 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(trk); ng_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  n > 0.004 ? (
    ui_col(col); ng_arcw(cx, cy, rr, a0, a, w);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); gfx_circle(cx + ca * rr, cy + sa * rr, w * 0.5, 1, 1);
  );
  ui_cola(0x000000, 0.22); gfx_circle(cx + 1.2 * sc, cy + 2.2 * sc, r, 1, 1);
  ui_col(0x4A4640); gfx_circle(cx, cy, r, 1, 1);                       // the moulded skirt
  ui_col(0xD9D1BE); gfx_circle(cx, cy, r - 1.2 * sc, 1, 1);
  ui_col(CREAM); gfx_circle(cx, cy, r - 2.6 * sc, 1, 1);                // the cream resin top
  ui_cola(0xFFFFFF, 0.55); ng_arcw(cx, cy, r - 4.2 * sc, -0.62 * $pi, -0.05 * $pi, 1.2 * sc);
  // the milled aluminium index line, edged in charcoal
  ui_col(0x3A3836); i = -1;
  ui_ssline(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * (r - 2.6 * sc), cy + sa * (r - 2.6 * sc), 3.2 * sc, 1);
  ui_col(0xC9CDD3); gfx_line(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * (r - 3 * sc), cy + sa * (r - 3 * sc), 1);
);
// the value pill (shown only while the knob is touched)
function ng_pill(cx, y, s) local(tw, th) (
  gfx_setfont(16); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 3 * sc, 3 * sc);
  ui_col(BAND); ui_rrect(cx * sc - tw * 0.5 - 5 * sc, y * sc + 1 * sc, tw + 10 * sc, th + 1 * sc, 2.5 * sc);
  ui_col(BTXT); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 1.5 * sc; gfx_drawstr(s);
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps; fmt "" shows #ng_vs
function ng_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  // a click never moves the knob: the drag starts after 3 pixels; a double-click (two clicks without a drag in
  // between) or Ctrl-click sets the default
  pressed && hov && drag_id == 0 ? (
    (time_precise() - ng_lt < 0.35 && ng_lid == idx && !ng_mv) || (mouse_cap & 4) ? ( ng_set(idx, def); drag_id = -1; ng_lt = 0; ) : (
      drag_id = did; ng_ky = mouse_y; ng_ky0 = mouse_y; ng_mv = 0; ng_lt = time_precise(); ng_lid = idx;
      ng_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !ng_mv && abs(mouse_y - ng_ky0) > 3 * sc ? ( ng_mv = 1; ng_ky = mouse_y; );
  drag_id == did && ng_mv ? (
    ng_kn = min(max(ng_kn + (ng_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); ng_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ ng_kn : lo + ng_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? ng_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    ng_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  ng_lcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), ng_acc, ng_trk);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, (r - 1.5) * sc, 1, 1);
    strlen(fmt) ? sprintf(#ng_vv, fmt, v) : strcpy(#ng_vv, #ng_vs);
    ng_pill(cx, cy + r + 5, #ng_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(ng_lfont); ui_col(ng_ink); ng_tc(cx, cy + r + 13, label); );
  );
);
ng_acc = ORNG; ng_trk = 0xC9C2B1; ng_ink = INK; ng_lfont = 10; ng_kfont = 11;

// ---------- keys that light up (lit = on); returns 1 when clicked ----------
function ng_key(x, y, w, h, on, s) local(hov, hit) (
  hov = ng_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(ORNGL, 0.35); ng_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.18); ng_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); ng_rr(x, y, w, h, 3);
  ui_col(on ? ORNG : hov ? KEYHOV : KEYOFF); ng_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.35); ng_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.6); ng_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(ng_kfont); ui_col(on ? 0xFFF6EC : INK); ng_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function ng_keys(x, y, w, h, gap, idx, n, labels) local(i) (
  i = 0;
  loop(n, ng_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == i, pk_pitem(labels, i + 1, #ng_k)) ? ng_set(idx, i); i += 1; );
);
function ng_toggle(x, y, w, h, idx, s) ( ng_key(x, y, w, h, slider(idx) >= 0.5, s) ? ng_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// wave glyphs: 0 sine 1 triangle 2 saw 3 square / pulse 4 S&H 5 smooth random
function ng_glyph(cx, cy, t, col) local(i, x0, y0, x1, y1, hh) (
  ui_col(col); hh = 5;
  t == 0 ? ( i = 0; loop(16, x0 = cx - 8 + i; x1 = x0 + 1;
             ng_ln(x0, cy - sin(i / 16 * 2 * $pi) * hh, x1, cy - sin((i + 1) / 16 * 2 * $pi) * hh, 1.6); i += 1; ); ) :
  t == 1 ? ( ng_ln(cx - 8, cy, cx - 4, cy - hh, 1.6); ng_ln(cx - 4, cy - hh, cx + 4, cy + hh, 1.6); ng_ln(cx + 4, cy + hh, cx + 8, cy, 1.6); ) :
  t == 2 ? ( ng_ln(cx - 8, cy + hh, cx + 6, cy - hh, 1.6); ng_ln(cx + 6, cy - hh, cx + 6, cy + hh, 1.6); ) :
  t == 3 ? ( ng_ln(cx - 8, cy + hh, cx - 8, cy - hh, 1.6); ng_ln(cx - 8, cy - hh, cx, cy - hh, 1.6); ng_ln(cx, cy - hh, cx, cy + hh, 1.6);
             ng_ln(cx, cy + hh, cx + 8, cy + hh, 1.6); ) :
  t == 4 ? ( ng_ln(cx - 8, cy + 2, cx - 3, cy + 2, 1.6); ng_ln(cx - 3, cy + 2, cx - 3, cy - hh, 1.6); ng_ln(cx - 3, cy - hh, cx + 2, cy - hh, 1.6);
             ng_ln(cx + 2, cy - hh, cx + 2, cy + hh, 1.6); ng_ln(cx + 2, cy + hh, cx + 8, cy + hh, 1.6); ) :
  ( x0 = cx - 8; y0 = cy + 1; i = 0;
    loop(16, x1 = cx - 8 + i + 1; y1 = cy + (sin((i + 1) * 0.55) * 0.6 + sin((i + 1) * 0.23 + 1) * 0.5) * hh;
             ng_ln(x0, y0, x1, y1, 1.6); x0 = x1; y0 = y1; i += 1; ); );
);
// a key showing a wave glyph
function ng_gkey(x, y, w, h, on, t) local(hit) (
  hit = ng_key(x, y, w, h, on, "");
  ng_glyph(x + w * 0.5, y + h * 0.5, t, on ? INK : LBL);
  hit;
);
// a field that shows a setting (a drop-down arrow); returns 1 when clicked
function ng_field(x, y, w, h, s) local(hov, hit) (
  hov = ng_hov(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_col(INK); ng_rr(x, y, w, h, 3);
  ui_col(hov ? FLDH : FLD); ng_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(11); ui_col(INK); ng_tc(x + (w - 9) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 11) * sc, (y + h * 0.5 - 2) * sc, (x + w - 5) * sc, (y + h * 0.5 - 2) * sc, (x + w - 8) * sc, (y + h * 0.5 + 2.5) * sc);
  hit;
);
// a drop-down menu from a "|" list for a stepped slider
function ng_menu(x, y, idx, list, n) local(i, k) (
  strcpy(#ng_m, ""); i = 0; k = floor(slider(idx) + 0.5);
  loop(n, i == k ? strcat(#ng_m, "!"); strcat(#ng_m, pk_pitem(list, i + 1, #ng_k)); i < n - 1 ? strcat(#ng_m, "|"); i += 1; );
  gfx_x = x * sc; gfx_y = y * sc; i = gfx_showmenu(#ng_m); i > 0 ? ng_set(idx, i - 1);
);
function ng_nname(n) local(o) (
  o = floor(n / 12) - 1;
  sprintf(#ng_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #ng_k), o);
  #ng_nn;
);


// ---------- more helpers ----------
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function ng_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#ng_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#ng_mls, ">"); strcat(#ng_mls, pk_pitem(list, i + 1, #ng_mi)); strcat(#ng_mls, " - ");
                      strcat(#ng_mls, pk_pitem(list, min(s0 + grp, n), #ng_mi)); strcat(#ng_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#ng_mls, "<");
    i == cur ? strcat(#ng_mls, "!");
    strcat(#ng_mls, pk_pitem(list, i + 1, #ng_mi));
    i < n - 1 ? strcat(#ng_mls, "|");
    i += 1; );
  #ng_mls;
);
// a value field (the house drop-down field): a click opens the list of every value (list: lo..hi, grp > 0 groups it
// in submenus of grp), the current one ticked; the wheel steps it
function ng_dfield(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = ng_hov(x, y, w, h);
  ng_field(x, y, w, h, s) ? (
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(ng_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? ng_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( ng_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
function ng_lbl(cx, y, s) ( gfx_setfont(16); ui_col(DIM); ng_tc(cx, y, s); );
function ng_lbll(x, y, s) ( gfx_setfont(16); ui_col(DIM); ng_t(x, y - 5, s); );
// a little wheel: a rim, six spokes turned by a, a hub
function ng_wheel(cx, cy, r, a, col) local(i, b) (
  ui_col(col); gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); gfx_circle(cx * sc, cy * sc, (r - 1) * sc, 0, 1);
  i = 0; loop(6, b = a + i * $pi / 3; ng_ln(cx, cy, cx + sin(b) * r, cy - cos(b) * r, 1.2); i += 1; );
  gfx_circle(cx * sc, cy * sc, r * 0.25 * sc, 1, 1);
);
// a knife switch: a charcoal base, two aluminium jaws, the blade pivoting from the left jaw into the right one
// (closed = the loop is made), an orange Bakelite handle. Returns 1 when clicked.
function ng_knife(x, y, closed, s) local(hov, hit, a, bx, by, ex, ey) (
  hov = ng_hov(x, y - 30, 84, 54); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.2); ng_rr(x + 2, y + 3, 84, 16, 3);
  ui_col(BAND); ng_rr(x, y, 84, 16, 3);
  ui_col(0x4A4A50); ng_r(x + 6, y + 6, 72, 3);
  // the jaws
  ui_col(0x9EA3AA); ng_r(x + 8, y - 6, 8, 12); ng_r(x + 66, y - 6, 4, 12); ng_r(x + 74, y - 6, 4, 12);
  ui_col(0xD5D8DD); ng_r(x + 9, y - 6, 2, 12); ng_r(x + 67, y - 6, 1.5, 12); ng_r(x + 75, y - 6, 1.5, 12);
  // the blade: closed lies in the jaws, open stands up at about 50 degrees
  a = closed ? 0 : 0.55; bx = x + 12; by = y - 1; ex = bx + cos(a) * 66; ey = by - sin(a) * 66;
  ui_col(0x8E949C); ng_ln(bx, by, ex, ey, 4); ui_col(0xE1E4E8); ng_ln(bx, by - 1, ex, ey - 1, 1.2);
  ui_col(0x3A3A3E); gfx_circle(bx * sc, by * sc, 3.2 * sc, 1, 1);
  // the handle
  ui_col(closed ? ORNG : 0xB8471E); gfx_circle((ex + cos(a) * 4) * sc, (ey - sin(a) * 4) * sc, 5.5 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.4); gfx_circle((ex + cos(a) * 4 - 1.5) * sc, (ey - sin(a) * 4 - 1.8) * sc, 1.8 * sc, 1, 1);
  hov ? ( ui_cola(ORNG, 0.15); ng_rr(x - 3, y - 30, 90, 54, 4); );
  gfx_setfont(16); ui_col(INK); ng_tc(x + 42, y + 26, pk_pitem(s, 1, #ng_k1)); ng_tc(x + 42, y + 38, pk_pitem(s, 2, #ng_k2));
  hit;
);
// the key names around the circle of fifths, C at the top
function ng_kname(pc) ( pk_pitem("C|Db|D|Eb|E|F|F#|G|Ab|A|Bb|B", wf_mod(pc, 12) + 1, #ng_k); );
function ng_fpos(pc) ( wf_mod(pc * 7, 12); );                   // a pitch class's place on the circle of fifths (0..11)

// ---------- the card ----------
ui_col(FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); ng_rr(4, 4, 1192, 792, 9);
ui_col(FACEX); ng_rr(6.5, 6.5, 1187, 787, 7);
ui_col(INK); ng_r(11, 11, 1178, 778);
ui_col(FACE); ng_r(13, 13, 1174, 774);
// the faceplate's charcoal grid
ui_cola(INK, 0.05); ng_i = 0; loop(49, ng_r(13 + ng_i * 24, 59, 1, 685); ng_i += 1; ); ng_i = 0; loop(29, ng_r(13, 59 + ng_i * 24, 1174, 1); ng_i += 1; );
// the header band
ui_col(FACEX); ng_r(13, 13, 1174, 44);
ui_col(INK); ng_r(13, 57, 1174, 2);
// the signal-orange wiring along the header: a trace with its solder points
ui_col(ORNG); ng_r(13, 60, 1174, 1.5); ng_i = 0; loop(12, gfx_circle((40 + ng_i * 100) * sc, 60.7 * sc, 2.2 * sc, 1, 1); ng_i += 1; );
// the numeral, in a cartouche, between two small wheels that turn with the big one
ui_col(INK); ng_rr(568, 15, 64, 38, 6); ui_col(FLD); ng_rr(570, 17, 60, 34, 5);
ui_col(INK); ng_frame(573, 20, 54, 28, 1);
gfx_setfont(15); ui_col(INK); ng_tc(600, 34.5, "X");
ng_rot += (wf_wp * $pi / 6 * (wf_cyc ? -1 : 1) - ng_rot) * 0.2;
ng_wheel(542, 35, 13, ng_rot, INK); ng_wheel(658, 35, 13, -ng_rot, INK);
// presets
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
wf_gk = pk_preset(22 * sc, 18 * sc, 372 * sc, 34 * sc, pr_cur, #wf_pm);
wf_gk > 0 ? ( wf_gk > wf_npre ? reset_all() : prs_dirty = wf_gk; );
gfx_setfont(12); ui_col(INK); ng_t(408, 19, "CYBERNETIC"); ui_col(DIM); ng_t(408, 35, "CIRCUIT SYNTH");
// MIDI: activity and channel
pk_led(712 * sc, 35 * sc, 4.5 * sc, ins_midi_lit(), ORNG);
gfx_setfont(11); ui_col(INK); ng_tc(712, 22, "MIDI");
sprintf(#ng_g, slider7 < 0.5 ? "OMNI" : "CH %.0f", slider7);
ng_field(728, 23, 72, 24, #ng_g) ? (
  strcpy(#ng_m, ""); wf_gk = 0;
  loop(17, wf_gk == floor(slider7 + 0.5) ? strcat(#ng_m, "!"); wf_gk == 0 ? strcat(#ng_m, "Omni") : ( sprintf(#ng_k, "Channel %d", wf_gk); strcat(#ng_m, #ng_k); ); wf_gk < 16 ? strcat(#ng_m, "|"); wf_gk += 1; );
  gfx_x = 728 * sc; gfx_y = 47 * sc; wf_gk = gfx_showmenu(#ng_m); wf_gk > 0 ? ng_set(7, wf_gk - 1);
);
// the stress lamp: lights while the circuit is failing
ng_fl = 0; ng_i = 0; loop(6, (WV + ng_i * WVS)[0] && (WV + ng_i * WVS)[18] > 0 ? ng_fl = 1; ng_i += 1; );
pk_led(830 * sc, 35 * sc, 4.5 * sc, ng_fl, 0xFF3A1A);
gfx_setfont(11); ui_col(INK); ng_tc(830, 22, "STRESS");
ui_size_picker(1118 * sc, 26 * sc);

// ======================== GENERATOR ========================
ng_sect(20, 70, 380, 186, WELL, "GENERATOR");
ng_knob(80, 124, 18, 31, -24, 24, 0, 0, "NODE A", "%+.0f st", 1);
ng_knob(210, 124, 18, 32, -12, 12, 0.12, 0, "NODE B", "%+.2f st", 0);
ng_knob(340, 124, 18, 33, 0, 100, 35, 0, "COUPLING", "%.0f%%", 0);
ng_knob(80, 208, 18, 34, 0, 100, 50, 0, "MIX A B", "%.0f%%", 0);
ng_knob(210, 208, 18, 35, 0, 100, 15, 0, "SUB PULSE", "%.0f%%", 0);
ng_knob(340, 208, 18, 36, 0.5, 12, 3, 1, "PULSE RATE", "%.2f Hz", 0);
// the two nodes, wired together
ui_col(ORNG); ng_ln(102, 124, 186, 124, 1.2); ng_ln(234, 124, 316, 124, 1.2);
gfx_circle(144 * sc, 124 * sc, 2.4 * sc, 1, 1); gfx_circle(275 * sc, 124 * sc, 2.4 * sc, 1, 1);

// ======================== CIRCUIT CORE ========================
ng_sect(20, 266, 380, 180, WELL2, "CIRCUIT CORE");
ng_knob(74, 352, 26, 37, 0, 100, 30, 0, "OVERLOAD", "%.0f%%", 0);
ng_knob(166, 318, 14, 38, 0, 100, 30, 0, "THERMAL", "%.0f%%", 0);
ng_knob(234, 318, 14, 39, 0, 100, 40, 0, "TUBE BIAS", "%.0f%%", 0);
ng_knob(302, 318, 14, 42, 0, 100, 30, 0, "SAG", "%.0f%%", 0);
ng_knob(166, 398, 14, 40, 0, 100, 15, 0, "RING MIX", "%.0f%%", 0);
ng_knob(234, 398, 14, 41, 0.25, 8, 2.5, 1, "RATIO", "x %.2f", 0);
ng_knob(302, 398, 14, 43, 0.02, 40, 0.7, 1, "CHAOS", "%.2f Hz", 0);
ng_knob(366, 398, 14, 44, 0, 100, 25, 0, "DEPTH", "%.0f%%", 0);
// the supply: a little bar that drops as it sags
ui_col(INK); ng_r(350, 296, 32, 54); ui_col(0x1C1A16); ng_r(351, 297, 30, 52);
ng_sv = min(max(wf_vs, 0), 1);
ui_col(ng_sv < 0.8 ? ORNG : YELL); ng_r(354, 300 + 46 * (1 - ng_sv), 24, 46 * ng_sv);
gfx_setfont(16); ui_col(DIM); ng_tc(366, 358, "SUPPLY");

// ======================== THE CRT: the wheel of fortune ========================
ui_cola(0x000000, 0.25); ng_rr(413, 72, 380, 380, 16);
ui_col(BAND); ng_rr(410, 68, 380, 380, 16);
ui_col(0x3E3E44); ng_rr(416, 74, 368, 368, 13);
ui_col(CRT); ng_rr(424, 82, 352, 352, 22);
ng_cx = 600; ng_cy = 258;
// the phosphor's glow (and a flicker while the circuit fails)
ng_fk = ng_fl ? 0.75 + rand(0.4) : 1;
ng_i = 0; loop(14, ui_cola(0x3A1E05, 0.05 * ng_fk); gfx_circle(ng_cx * sc, ng_cy * sc, (170 - ng_i * 9) * sc, 1, 1); ng_i += 1; );
// the graticule: rings and spokes
ui_cola(AMB, 0.10); gfx_circle(ng_cx * sc, ng_cy * sc, 140 * sc, 0, 1); gfx_circle(ng_cx * sc, ng_cy * sc, 95 * sc, 0, 1); gfx_circle(ng_cx * sc, ng_cy * sc, 50 * sc, 0, 1);
// the home key, the key now, the next one
ng_home = wf_key; ng_now = wf_mod(ng_home + wf_turn(wf_wp), 12); ng_next = wf_mod(ng_home + wf_turn(wf_wp + 1), 12);
// the wheel's spokes turn with the key
ng_ra = ng_fpos(ng_now) * $pi / 6; ng_d = ng_ra - ng_spk2; ng_d -= floor((ng_d + $pi) / (2 * $pi)) * 2 * $pi;
ng_spk2 += ng_d * 0.18;
ui_cola(AMB, 0.16 * ng_fk); ng_i = 0; loop(12, ng_b = ng_spk2 + ng_i * $pi / 6; ng_ln(ng_cx + sin(ng_b) * 52, ng_cy - cos(ng_b) * 52, ng_cx + sin(ng_b) * 138, ng_cy - cos(ng_b) * 138, 1); ng_i += 1; );
// the constellation: the keys this revolution has visited, joined in the order they came
ng_i = 1;
loop(11,
  WVIS[ng_i] && WVIS[ng_i - 1] ? (
    ng_a1 = ng_fpos(ng_home + wf_turn(ng_i - 1)) * $pi / 6; ng_a2 = ng_fpos(ng_home + wf_turn(ng_i)) * $pi / 6;
    ui_cola(AMB, 0.55 * ng_fk); ng_ln(ng_cx + sin(ng_a1) * 120, ng_cy - cos(ng_a1) * 120, ng_cx + sin(ng_a2) * 120, ng_cy - cos(ng_a2) * 120, 1.4);
  );
  ng_i += 1;
);
// the twelve keys
ng_i = 0;
loop(12,
  ng_pc = wf_mod(ng_i * 7, 12); ng_a = ng_i * $pi / 6; ng_px = ng_cx + sin(ng_a) * 120; ng_py = ng_cy - cos(ng_a) * 120;
  ng_vis = 0; ng_j = 0; loop(12, WVIS[ng_j] && wf_mod(ng_home + wf_turn(ng_j), 12) == ng_pc ? ng_vis = 1; ng_j += 1; );
  ng_pc == ng_now && wf_run ? (
    ui_cola(AMB, 0.18 * ng_fk); gfx_circle(ng_px * sc, ng_py * sc, 16 * sc, 1, 1); ui_cola(AMB, 0.3 * ng_fk); gfx_circle(ng_px * sc, ng_py * sc, 10 * sc, 1, 1);
    ui_col(AMBL); gfx_circle(ng_px * sc, ng_py * sc, 6 * sc, 1, 1);
  ) : (
    ui_cola(AMB, ng_vis ? 0.85 : 0.3); gfx_circle(ng_px * sc, ng_py * sc, (ng_vis ? 4.5 : 3) * sc, 1, 1);
  );
  ng_pc == ng_home ? ( ui_cola(AMB, 0.8); gfx_circle(ng_px * sc, ng_py * sc, 9 * sc, 0, 1); gfx_circle(ng_px * sc, ng_py * sc, 9.8 * sc, 0, 1); );
  gfx_setfont(12); ui_cola(ng_pc == ng_now && wf_run ? AMBL : AMB, ng_pc == ng_now || ng_pc == ng_home ? 1 : 0.55);
  ng_tc(ng_cx + sin(ng_a) * 148, ng_cy - cos(ng_a) * 148, ng_kname(ng_pc));
  ng_i += 1;
);
// the scope: the output drawn round a ring
ui_cola(AMB, 0.85 * ng_fk);
ng_i = 0; ng_ox = 0; ng_oy = 0;
loop(129,
  ng_v = WSC[(wf_scw - 256 + ng_i * 2) & (WSCN - 1)]; ng_a = ng_i / 128 * 2 * $pi;
  ng_r_ = 70 + min(max(ng_v * 30, -22), 22); ng_x = ng_cx + sin(ng_a) * ng_r_; ng_y = ng_cy - cos(ng_a) * ng_r_;
  ng_i > 0 ? ng_ln(ng_ox, ng_oy, ng_x, ng_y, 1.3);
  ng_ox = ng_x; ng_oy = ng_y; ng_i += 1;
);
// the key now, in the middle; the turn, and the next key
gfx_setfont(14); ui_col(wf_run ? AMBL : AMBD); ng_tc(ng_cx, ng_cy - 6, wf_run ? ng_kname(ng_now) : "-");
gfx_setfont(16); ui_cola(AMB, 0.85);
wf_rest == 1 ? strcpy(#ng_g, "AT REST") : sprintf(#ng_g, "TURN %d", wf_mod(wf_turns, 12) + (wf_turns > 0 && wf_wp == 0 ? 12 : 0));
ng_tc(ng_cx, ng_cy + 18, #ng_g);
gfx_setfont(16); ui_cola(AMB, 0.6); ng_tc(ng_cx, 426, wf_cyc ? "CYCLE OF FOURTHS" : "CYCLE OF FIFTHS");
ng_fl ? ( gfx_setfont(16); ui_cola(0xFF5A2A, 0.6 + rand(0.4)); ng_t(436, 92, "OVERLOAD"); );

// ======================== THE WHEEL ========================
ng_sect(800, 70, 380, 376, WELL, "THE WHEEL");
ng_kfont = 16;
ng_lbll(808, 98, "PLAY");
ng_keys(808, 106, 50, 22, 3, 1, 2, "HOLD|SELF");
ng_toggle(918, 106, 56, 22, 2, "LATCH");
// SELF's run: START / STOP, TRANSPORT (REAPER's play / stop presses them), FOLLOW (lock to REAPER's position)
ng_lbll(808, 138, "SELF RUN");
ng_key(808, 146, 54, 22, slider3 >= 0.5, "START") ? ng_set(3, 1);
ng_key(865, 146, 50, 22, slider3 < 0.5, "STOP") ? ng_set(3, 0);
ng_toggle(923, 146, 86, 22, 74, "TRANSPORT");
ng_toggle(1017, 146, 68, 22, 4, "FOLLOW");
ng_lbll(808, 178, "ROOT"); ng_lbll(872, 178, "OCTAVE"); ng_lbll(948, 178, "STEPS"); ng_lbll(1018, 178, "RATE"); ng_lbll(1096, 178, "HOLD ORDER");
ng_field(808, 186, 56, 22, pk_pitem("C|C#|D|Eb|E|F|F#|G|Ab|A|Bb|B", floor(slider5 + 0.5) + 1, #ng_k)) ? ng_menu(808, 208, 5, "C|C#|D|Eb|E|F|F#|G|Ab|A|Bb|B", 12);
sprintf(#ng_g, "OCT %d", floor(slider6 + 0.5)); ng_dfield(872, 186, 66, 22, 6, 1, 6, #ng_g, "Octave 1|Octave 2|Octave 3|Octave 4|Octave 5|Octave 6", 0);
sprintf(#ng_g, "%d", floor(slider12 + 0.5)); ng_dfield(948, 186, 60, 22, 12, 1, 12, #ng_g, "1 step|2 steps|3 steps|4 steps|5 steps|6 steps|7 steps|8 steps|9 steps|10 steps|11 steps|12 steps", 0);
ng_field(1018, 186, 70, 22, pk_pitem("1/4|1/8|1/8 T|1/16|1/16 T|1/32", floor(slider13 + 0.5) + 1, #ng_k)) ? ng_menu(1018, 208, 13, "1/4|1/8|1/8 triplet|1/16|1/16 triplet|1/32", 6);
ng_field(1096, 186, 76, 22, pk_pitem("UP|DOWN|UP-DOWN|AS PLAYED|RANDOM", floor(slider17 + 0.5) + 1, #ng_k)) ? ng_menu(1096, 208, 17, "Up|Down|Up-down|As played|Random", 5);
ng_lbll(808, 218, "CYCLE"); ng_lbll(966, 218, "LOOPS A TURN");
ng_keys(808, 226, 72, 22, 3, 9, 2, "FIFTHS|FOURTHS");
ng_keys(966, 226, 32, 22, 3, 10, 4, "1|2|4|8");
ng_lbll(808, 258, "RESOLUTION");
ng_keys(808, 266, 66, 22, 3, 11, 3, "TURN|RESOLVE|RESET");
ng_toggle(1022, 266, 90, 22, 16, "WILD CARD");
ng_kfont = 11;
ng_knob(836, 326, 16, 14, 5, 100, 60, 0, "GATE", "%.0f%%", 0);
ng_knob(900, 326, 16, 18, 0, 60, 0, 0, "SWING", "%.0f%%", 1);
ng_knob(984, 326, 24, 15, 0, 100, 40, 0, "FORTUNE", "%.0f%%", 0);
// how far from home the wheel is (FORTUNE works on this)
ng_lbll(1040, 304, "FROM HOME");
ui_col(INK); ng_r(1040, 312, 132, 14); ui_col(0x1C1A16); ng_r(1041, 313, 130, 12);
ng_i = 0; loop(6, ui_col(ng_i < wf_hd * 6 - 0.01 ? (ng_i >= 4 ? ORNG : YELL) : 0x3A3630); ng_r(1043 + ng_i * 21.4, 315, 19, 8); ng_i += 1; );
ng_lbll(1040, 348, "HOME"); gfx_setfont(16); ui_col(DIM); ng_t(1152, 343, "FAR");
// the readout: home, now, next, the turn
ui_col(INK); ng_rr(808, 376, 364, 60, 4); ui_col(CRT); ng_rr(810, 378, 360, 56, 3);
gfx_setfont(16); ui_cola(AMB, 0.7); ng_t(822, 384, "HOME"); ng_t(912, 384, "NOW"); ng_t(1002, 384, "NEXT"); ng_t(1092, 384, "TURN");
gfx_setfont(13); ui_col(AMBL);
ng_t(822, 402, ng_kname(ng_home)); ng_t(912, 402, wf_run ? ng_kname(ng_now) : "-"); ng_t(1002, 402, wf_run && wf_rest != 1 ? ng_kname(ng_next) : "-");
sprintf(#ng_g, "%d / 12", wf_wp == 0 && wf_turns > 0 ? 12 : wf_wp); ng_t(1092, 402, wf_rest == 1 ? "REST" : #ng_g);

// ======================== FILTER and AMP ========================
ng_sect(20, 456, 380, 160, WELL2, "FILTER  ·  AMP");
ng_lfont = 16;
ng_knob(56, 500, 13, 45, 60, 12000, 1800, 1, "CUTOFF", "%.0f Hz", 0);
ng_knob(128, 500, 13, 46, 0, 100, 45, 0, "RESO", "%.0f%%", 0);
ng_knob(200, 500, 13, 47, -100, 100, 40, 0, "ENV", "%+.0f%%", 0);
ng_knob(272, 500, 13, 52, 0, 100, 50, 0, "VELOCITY", "%.0f%%", 0);
ng_knob(344, 500, 13, 53, 0, 100, 70, 0, "LEVEL", "%.0f%%", 0);
