desc:Tower [Arcana synth] (GFX)
//tags: instrument synth polyphonic tape replay choir strings flutes organ wow flutter reverb storm arcana
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-voice (.jsfx-inc) in the same folder.
//
// THE TOWER (card XVI of the GFX Arcana series): the two-mile tape monolith. A tape-replay keyboard in the manner of
// a vintage tape-replay keyboard - every key plays its own strip of tape - but here each strip is a loop that runs up a tower a mile
// high, over a pulley at the top and back down: two miles of tape round. The weight of the hanging column drags and
// wows the playback, a weather system at the apex buffets the reels, and a lightning strike throws the capstan,
// slips the tape and drops the sound down a vast vertical shaft.
// The sounds are synthesised (no samples) and then aged as tape is.
//   SOURCES    four lit keys, each on or off, layer the frames of tape the keys play (any of one to four; the last
//              one lit cannot be put out), each with its own LEVEL: CHOIR (formant voices singing "aah": a glottal
//              source through four vowel formants that drift slowly), STRINGS (a bowed ensemble: three detuned
//              bows a key, a body resonance, the ensemble chorus), FLUTES (a breathy flute: a soft tone with its
//              breath riding the pitch) and ORGAN PIPES (a stopped 8' rank and an open 4' rank, a chiff of wind at
//              the speech of each pipe). Changes crossfade. Every strip evolves slowly - its brightness, its bows'
//              or singers' beating, its level - so a long note never stands still. 14 strips (keys) can hang at
//              once, 10 sounding (the oldest gives way).
//   GENERATION the tape copy the strips were printed on, 1 (the master) to 5 (a copy of a copy of a copy ...): high
//              loss, saturation, hiss, a little compression and a print-through ghost (a faint echo of what was
//              played 0.85 s ago) grow with every generation. TONE: a tilt, dark .. bright.
//   THE RIBBON LENGTH: how long each loop is, from a classic tape-replay keyboard's 8 s to 2 MILES (1408 s, 23.5 minutes round). A held
//              note never runs out: it plays its attack once, then goes round its loop - the recording on the strip
//              (its level, brightness, intonation, vibrato) comes round again each time, spliced with an
//              equal-power crossfade at the join, while its slow evolution and wear run on across the loops. A short
//              LENGTH is a short, audible tape loop; a long one the slow two-mile loop. The tape runs at 7.5 feet a
//              second (90 ips): an 8 s loop climbs 30 ft and comes back, the 2-mile loop turns at the apex, a mile
//              up. The LCD shows the loop in time and in feet / miles. RELEASE: a released key's strip is pulled
//              back (a short fade by default).
//   TRANSPORT  three big levers. CAPSTAN: the transport's speed, +/- 12 semitones (varispeed), glided like a motor.
//              GRAVITY: the weight of the hanging column - the higher up the tower a note's playhead, the more its
//              speed sags (the pitch slowly falls and wavers), the stretched tape flutters and thins. TENSION: how
//              tight the tape is - slack gives a slow, wide wow, taut a fast, fine flutter (the mod wheel adds
//              tension). WOBBLE: how much wow and flutter in all.
//   APEX WEATHER  WIND SHEAR (irregular gusts buffet the reels: speed and level, left and right apart),
//              TEMPERATURE (in deg C, 15 is temperate: cold drifts the pitch flat and stiffens the tape - duller,
//              more flutter; warm slackens it - more wow), PRESSURE (in hPa, 1013 is normal: as it drops the air
//              thins and darkens the sound) and STORM, which scales them all (50 % = as set, 100 % = twice).
//   LIGHTNING  the STRIKE key (or a chosen MIDI note, off by default) and SIZE: the capstan is thrown - the tape
//              slips, its speed collapses and lurches back - with a crack of structural distortion and thunder, and
//              the whole cascades into the SHAFT, a long vertical-shaft reverb whose tail darkens as it falls
//              (SIZE, DECAY, MIX are always there; a strike floods it whatever the MIX). Strike again while it
//              recovers: it is struck twice.
//   FATE       the series' drift (0 - 100 %, 50 % = the standard amount) - here tape fatigue: over minutes the tape
//              wears and recovers (more generation loss, flutter and stretch), every strip a little differently;
//              the tuning wanders a little.
//   VOLUME, LEVEL, VELOCITY (how much the touch matters), SAT (the output soft clip is always on).
// MIDI: the channel (OMNI or 1 - 16), notes, pitch bend (+/- 2), CC1 (adds TENSION), CC64 sustain, CC120 / CC123 all
// notes off; the strike note (that key no longer plays a strip).

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc

slider1:0<0,3,1{Choir,Strings,Flutes,Organ pipes}>-Source (older projects; the keys below take over)
slider2:8<8,1408,0.01>-Length (s)
slider3:0.15<0.03,3,0.001>-Release (s)
slider4:1.5<1,5,0.01>-Generation
slider5:0<-100,100,0.1>-Tone (dark .. bright, %)
slider6:0<-12,12,0.01>-Capstan (st)
slider7:30<0,100,0.1>-Gravity (%)
slider8:50<0,100,0.1>-Tension (slack .. taut, %)
slider9:30<0,100,0.1>-Wobble (%)
slider10:0<0,100,0.1>-Wind shear (%)
slider11:15<-20,40,0.1>-Temperature (C)
slider12:1013<940,1040,0.1>-Pressure (hPa)
slider13:50<0,100,0.1>-Storm (%)
slider14:60<0,100,0.1>-Strike size (%)
slider15:0<0,127,1>-Strike note (0 = off)
slider16:50<0,100,0.1>-Shaft size (%)
slider17:6<1,40,0.01>-Shaft decay (s)
slider18:18<0,100,0.1>-Shaft mix (%)
slider19:50<0,100,1>-Fate (%)
slider20:40<0,100,1>-Velocity (%)
slider21:0<0,16,1>-MIDI channel (0 = omni)
slider22:-6<-24,6,0.1>-Volume (dB)
slider23:60<0,100,0.1>-Level (%)
slider24:0<0,100,1>-Band sat (%)
slider25:30<0,100,1>-Bias (%)
slider26:120<40,400,1>-Sat low band (Hz)
slider27:6000<2000,16000,10>-Sat high band (Hz)
slider28:-0.3<-24,0,0.1>-Ceiling (dB)
slider29:1<0,1,1{Off,Clip}>-(unused, output stage)
slider30:0<0,1,1{Off,On}>-Choir on (all four off = the Source above)
slider31:0<0,1,1{Off,On}>-Strings on
slider32:0<0,1,1{Off,On}>-Flutes on
slider33:0<0,1,1{Off,On}>-Organ pipes on
slider34:100<0,100,0.1>-Choir level (%)
slider35:100<0,100,0.1>-Strings level (%)
slider36:100<0,100,0.1>-Flutes level (%)
slider37:100<0,100,0.1>-Organ pipes level (%)
slider38:prs_sel=0<0,12,1{No preset,Init,Two Mile Choir,Frozen Strings,The Apex,Barometric Flutes,Gale Force Organ,Long Descent,Struck Twice,Generation Five,Mile High Tapes,Thin Air,Collapse}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-tower";
ext_noinit = 1;

// ---------- memory ----------
TWV = 0; TWNV = 14; TWVS = 48;                           // the strips (voices)
// voice slots (q = TWV + v * TWVS):
//   0 on  1 level now  2 its step a sample  3 phase A  4 increment A  5 phase B  6 increment B  7 table level offset
//   8 note  9 low-pass coefficient  10 .. 13 the low-pass, one per source  14 breath  15 chiff  17 seconds played
//   18 attack (0..1)  19 run-out (1..0)  20 release (1..0)  21 released  22 key down  23 touch gain  24 cut short
//   25 age  26 .. 29 waver (a, b, phase, rate)  30 stretch phase  31 its rate  32 vibrato phase  33 its rate
//   34 .. 37 evolution (a, b, phase, rate)  16 phase C  38 increment C (the third singer / bow)
//   39 fatigue  40 height (0..1)  41 cents now  43 touch gain target  44 place round the loop (s)  45 the sag (glided)
//   46 place round the loop (0..1: up the tower to 0.5, back down to 1)
TWDEF = 1000; TWTMP = 1100;                              // the Init values; the preset parser's scratch (panel only)
TWN = 1300;                                              // per key: detune (cents), level, fatigue phase, its rate
TWQ = 2000; TWQN = 250;                                  // the event queue: offset, kind, note, velocity
TWHN = 3100;                                             // keys down
TWF = 3300;                                              // the band-passes' coefficients (4 each)
TWSIN = 3500;                                            // a sine, 1024 points (for the tables)
TWT = 8192; TWTL = 1025; TWTS = 16 * 1025;               // the wave tables: 4 sources x 16 levels (half octaves)
TWSH = 131072;                                           // the shaft: 8 lines of 65536
TWGH = 655360; TWGM = 262143;                            // the print-through ghost
TWCH = 917504;                                           // the ensemble chorus
TWPD = 925696;                                           // the shaft's pre-delay
TWAP = 958464;                                           // the shaft's two diffusers (4096 each)
TWSL = 970000;                                           // the shaft lines: length now, its target, gain, damping state, glide
TWE = 979900;                                            // the strike's envelopes (attack, decay) x 5
TG_SX = 980000; TG_SY = 980100;                          // (the panel's own: the strip as drawn)
memset(TWV, 0, TWNV * TWVS); memset(TWHN, 0, 128);

// ---------- each key's own strip: a little out of tune, a little louder or softer, its own fatigue ----------
function tw_hash(n) ( n = sin(n * 12.9898 + 4.1) * 43758.5453; n - floor(n); );
i_ = 0; loop(128,
  TWN[i_ * 4] = (tw_hash(i_ + 0.31) - 0.5) * 6;
  TWN[i_ * 4 + 1] = 2 ^ ((tw_hash(i_ + 7.7) - 0.5) * 0.22);
  TWN[i_ * 4 + 2] = tw_hash(i_ + 3.3);
  TWN[i_ * 4 + 3] = 1 / (70 + 150 * tw_hash(i_ + 9.1));
  i_ += 1; );

// ---------- the wave tables (one cycle of each source, 16 half-octave levels, never above 21 kHz) ----------
function tw_amp(s, k) (
  s == 0 ? k ^ -1.15 :
  s == 1 ? 1 / k * (1 + 0.35 * exp(-sqr((k - 4) / 2.5))) :
  s == 2 ? ( k == 1 ? 1 : k == 2 ? 0.3 : k == 3 ? 0.16 : k == 4 ? 0.07 : k == 5 ? 0.045 : k == 6 ? 0.022 : 0.1 / (k * k) ) :
  ( (k & 1) ? ( k == 1 ? 1 : k == 3 ? 0.42 : k == 5 ? 0.14 : k == 7 ? 0.06 : 0.4 / (k * k) ) :
              ( k == 2 ? 0.5 : k == 4 ? 0.2 : k == 6 ? 0.08 : k == 8 ? 0.04 : 0 ) );
);
function tw_tables() local(s, m, ft, hm, k, a, i, b, ph, pk, nrm) (
  i = 0; loop(1024, TWSIN[i] = sin(2 * $pi * i / 1024); i += 1; );
  s = 0;
  loop(4,
    m = 0;
    loop(16,
      b = TWT + s * TWTS + m * TWTL; memset(b, 0, TWTL);
      ft = 30 * 2 ^ ((m + 1) / 2); hm = min(64, max(1, floor(min(srate * 0.45, 21000) / ft)));
      k = 1;
      loop(hm,
        a = tw_amp(s, k);
        a > 0 ? (
          ph = s < 2 ? floor(1024 * (k * k * 0.37 + k * 0.11 - floor(k * k * 0.37 + k * 0.11))) : 0;
          i = 0; loop(1024, b[i] += a * TWSIN[(k * i + ph) & 1023]; i += 1; );
        );
        k += 1; );
      b[1024] = b[0];
      m += 1; );
    // one scale for all the levels of a source (its fullest table's peak)
    pk = 0; b = TWT + s * TWTS; i = 0; loop(1024, pk = max(pk, abs(b[i])); i += 1; );
    nrm = 1 / max(pk, 0.001);
    i = 0; loop(TWTS, b[i] *= nrm; i += 1; );
    s += 1; );
);

// ---------- the presets: the Init values and each preset's changes ----------
#tw_def = "0 8 0.15 1.5 0 0 30 50 30 0 15 1013 50 60 0 50 6 18 50 40 0 -6 60 0 30 120 6000 -0.3 1 0 0 0 0 100 100 100 100";
function tw_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
function tw_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
tw_nums(#tw_def, TWDEF);
#tw_pm = "Init|Two Mile Choir|Frozen Strings|The Apex|Barometric Flutes|Gale Force Organ|Long Descent|Struck Twice|Generation Five|Mile High Tapes|Thin Air|Collapse";
function tw_pstr(p) (
  p == 2  ? "1:0 2:1408 3:0.4 4:1.8 7:45 8:40 9:35 16:75 17:14 18:32 30:1 31:1 35:45 23:61.1" :
  p == 3  ? "1:1 2:60 4:2.2 5:-20 8:75 9:40 11:-15 12:1005 13:70 17:8 18:22 31:1 32:1 36:40 23:74.2" :
  p == 4  ? "1:0 2:600 7:55 10:55 11:-5 12:985 13:75 16:85 17:20 18:35 30:1 33:1 37:45 23:64.4" :
  p == 5  ? "1:2 2:30 5:10 8:35 9:45 10:20 12:955 13:65 18:25 32:1 33:1 37:55 23:63.8" :
  p == 6  ? "1:3 2:240 4:2 7:40 8:60 10:85 13:85 17:9 18:28 33:1 30:1 34:35 23:69.7" :
  p == 7  ? "1:1 2:1408 3:1.2 6:-2 7:90 8:25 9:50 16:90 17:28 18:40 31:1 30:1 34:55 23:58.6" :
  p == 8  ? "1:0 2:120 10:35 13:70 14:85 16:80 17:18 18:22 30:1 23:62.8" :
  p == 9  ? "1:1 2:8 4:5 5:-35 7:50 9:55 18:12 31:1 23:98.7" :
  p == 10 ? "1:1 2:704 4:2 7:40 18:20 30:1 31:1 32:1 34:50 36:45 23:66.8" :
  p == 11 ? "1:2 4:1.2 5:25 10:30 11:-12 12:942 13:80 16:95 17:24 18:38 32:1 23:84.3" :
  p == 12 ? "1:3 2:1408 4:3.5 6:-5 7:100 8:10 9:80 10:60 11:-8 12:975 13:85 14:100 17:30 18:45 30:1 31:1 32:1 33:1 34:70 35:70 36:55 37:70 23:87.5" :
  "";
);
function tw_pstr_au(p) (
  p == 2  ? "1:0 2:1408 3:0.4 4:1.8 7:45 8:40 9:35 16:75 17:14 18:32 30:1 31:1 35:45 23:61.1" :
  p == 3  ? "1:1 2:60 4:2.2 5:-20 8:75 9:40 11:-15 12:1005 13:70 17:8 18:22 31:1 32:1 36:40 23:74.2" :
  p == 4  ? "1:0 2:600 7:55 10:55 11:-5 12:985 13:75 16:85 17:20 18:35 30:1 33:1 37:45 23:64.4" :
  p == 5  ? "1:2 2:30 5:10 8:35 9:45 10:20 12:955 13:65 18:25 32:1 33:1 37:55 23:63.8" :
  p == 6  ? "1:3 2:240 4:2 7:40 8:60 10:85 13:85 17:9 18:28 33:1 30:1 34:35 23:69.7" :
  p == 7  ? "1:1 2:1408 3:1.2 6:-2 7:90 8:25 9:50 16:90 17:28 18:40 31:1 30:1 34:55 23:58.6" :
  p == 8  ? "1:0 2:120 10:35 13:70 14:85 16:80 17:18 18:22 30:1 23:62.8" :
  p == 9  ? "1:1 2:8 4:5 5:-35 7:50 9:55 18:12 31:1 23:98.7" :
  p == 10 ? "1:1 2:704 4:2 7:40 18:20 30:1 31:1 32:1 34:50 36:45 23:66.8" :
  p == 11 ? "1:2 4:1.2 5:25 10:30 11:-12 12:942 13:80 16:95 17:24 18:38 32:1 23:84.3" :
  p == 12 ? "1:3 2:1408 4:3.5 6:-5 7:100 8:10 9:80 10:60 11:-8 12:975 13:85 14:100 17:30 18:45 30:1 31:1 32:1 33:1 34:70 35:70 36:55 37:70 23:87.5" :
  "";
);
function load_preset(p) local(n, i) (
  // FATE, VOLUME, the MIDI channel, the strike note and the output stage stay as they are
  i = 0; loop(37, i != 14 && i != 18 && i != 20 && i != 21 && (i < 23 || i > 28) ? slider(i + 1) = TWDEF[i]; i += 1; );
  slider23 = TWDEF[22];
  n = tw_nums(tw_pstr(p), TWTMP);
  i = 0; loop(floor(n / 2), TWTMP[i * 2] >= 1 && TWTMP[i * 2] <= 37 ? slider(TWTMP[i * 2]) = TWTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(37, ui_auto(i); i += 1; );
  pr_cur = p;
);
function load_preset_au(p) local(n, i) (
  // FATE, VOLUME, the MIDI channel, the strike note and the output stage stay as they are
  i = 0; loop(37, i != 14 && i != 18 && i != 20 && i != 21 && (i < 23 || i > 28) ? slider(i + 1) = TWDEF[i]; i += 1; );
  slider23 = TWDEF[22];
  n = tw_nums_au(tw_pstr_au(p), TWTMP);
  i = 0; loop(floor(n / 2), TWTMP[i * 2] >= 1 && TWTMP[i * 2] <= 37 ? slider(TWTMP[i * 2]) = TWTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(37, ui_auto(i); i += 1; );
  pr_cur = p;
);
function reset_all() local(i) (
  load_preset(1);
  i = 0; loop(37, slider(i + 1) = TWDEF[i]; ui_auto(i + 1); i += 1; );
  pr_cur = 13;
);

// ---------- helpers ----------
// a smooth random walk in four slots of q (a, b, phase, rate): -1..1
function tw_wander(q, bs) local(ph) (
  ph = q[2] + q[3] * bs;
  ph >= 1 ? ( ph -= floor(ph); q[0] = q[1]; q[1] = rand(2) - 1; );
  q[2] = ph;
  q[0] + (q[1] - q[0]) * (0.5 - 0.5 * cos($pi * ph));
);
// a band-pass (zero-delay state variable), unity at its peak; coefficients in c[0..3]
function tw_bpset(c, f, bw) local(g, k) (
  g = tan($pi * min(f, srate * 0.45) / srate); k = min(bw / f, 1.8);
  c[0] = 1 / (1 + g * (g + k)); c[1] = g * c[0]; c[2] = g * c[1]; c[3] = k;
);
function tw_bp(x, c) instance(s1, s2) local(v1, v2, v3) (
  v3 = x - s2; v1 = c[0] * s1 + c[1] * v3; v2 = s2 + c[1] * s1 + c[2] * v3;
  s1 = v1 + v1 - s1; s2 = v2 + v2 - s2;
  v1 * c[3];
);
function tw_k(f) ( 1 - exp(-2 * $pi * min(f, srate * 0.45) / srate); );
// a delay line's read, d samples back from the write position w (linear between samples)
function tw_rd(b, w, d, m) local(p, i) ( p = w - d; i = floor(p); p -= i; b[i & m] + (b[(i + 1) & m] - b[i & m]) * p; );
// the height up the tower (0 .. 1, logarithmic in feet, 1 = the apex a mile up) after t seconds of tape from the foot
function tw_hgt(t) ( log(1 + t * 7.5 / 60) / log(1 + 5280 / 60); );
// is a source on? (all four keys off: the old single Source slider decides - older projects load as they were)
function tw_on(k) ( slider30 + slider31 + slider32 + slider33 < 0.5 ? floor(slider1 + 0.5) == k : slider(30 + k) >= 0.5; );
// the strip's recording: a smooth value noise along the loop (-0.5 .. 0.5), seed sd, knots ks seconds apart
function tw_vn(sd, x) local(i, f, a, b) (
  i = floor(x); f = x - i; a = tw_hash(sd + i * 1.618); b = tw_hash(sd + (i + 1) * 1.618);
  a + (b - a) * (0.5 - 0.5 * cos($pi * f)) - 0.5;
);
// ... spliced at the loop point: over the last X seconds the end of the loop crossfades (equal power - the two
// sides are unrelated) into its own start, so the loop comes round without a seam
function tw_rec(sd, p, l, ks, x) local(w) (
  p > l - x ? ( w = (p - l + x) / x * 0.5 * $pi; tw_vn(sd, p / ks) * cos(w) + tw_vn(sd, (p - l) / ks) * sin(w); ) : tw_vn(sd, p / ks);
);
// an attack-decay envelope as the difference of two decays (no step at the start): its peak is 1
function tw_bipk(ta, td) local(tp) ( tp = log(td / ta) * ta * td / (td - ta); 1 / (exp(-tp / td) - exp(-tp / ta)); );

// ---------- the strips ----------
// the touch: a gain from the velocity
function tw_vgain(vel, n) ( (1 - tw_vel + tw_vel * vel) * TWN[n * 4 + 1]; );
// a strip for this key: its own if it is still hanging, else a free one; ten sounding at most (the oldest gives way)
function tw_find(note) local(v, q, best, ns, old, oa, low, ll) (
  best = -1;
  v = 0; loop(TWNV, q = TWV + v * TWVS; best < 0 && q[0] && q[8] == note && !q[24] ? best = v; v += 1; );
  best < 0 ? (
    ns = 0; old = -1; oa = 1000000000000;
    v = 0; loop(TWNV, q = TWV + v * TWVS; q[0] && !q[24] ? ( ns += 1; q[25] + (q[21] ? -100000000 : 0) < oa ? ( oa = q[25] + (q[21] ? -100000000 : 0); old = v; ); ); v += 1; );
    ns >= 10 && old >= 0 ? ( q = TWV + old * TWVS; q[21] = 1; q[24] = 1; );
    v = 0; loop(TWNV, q = TWV + v * TWVS; best < 0 && !q[0] ? best = v; v += 1; );
    // (none free at all: the quietest)
    best < 0 ? ( ll = 10; v = 0; loop(TWNV, q = TWV + v * TWVS; q[1] < ll ? ( ll = q[1]; best = v; ); v += 1; ); );
  );
  best;
);
function tw_non(note, vel) local(v, q, p, m, fmax) (
  v = tw_find(note);
  q = TWV + v * TWVS;
  q[0] && q[8] == note ? (
    // the same key again before its strip ran back: it starts again near the top (the level carries on)
    p = min(max(q[1] / max(q[43], 0.0001), 0), 1);
    q[18] = 0.5 - sin(asin(1 - 2 * p) / 3); q[20] = 1;
    q[21] = 0; q[24] = 0;                                   // (the loop runs on where it is)
  ) : (
    memset(q, 0, TWVS);
    q[8] = note; q[3] = rand(1); q[5] = rand(1); q[16] = rand(1); q[19] = 1; q[20] = 1;
    q[29] = 0.15 + rand(0.25); q[37] = 0.06 + rand(0.12); q[26] = q[27] = rand(2) - 1; q[34] = q[35] = rand(2) - 1;
    q[28] = rand(1); q[36] = rand(1);
    q[31] = 3.5 + rand(3); q[33] = 4.8 + rand(0.8); q[30] = rand(1); q[32] = rand(1);
    // the table: band-limited for the highest the capstan and the bend can take it (+14 semitones)
    q[44] = 0; q[45] = 0;
    fmax = 440 * 2 ^ ((note - 55) / 12);
    m = min(max(ceil(2 * log(fmax / 30) / log(2) - 1), 0), 15);
    q[7] = m * TWTL;
    q[9] = 0.5; q[15] = 0.45;
    q[0] = 1;
  );
  q[22] = 1; q[43] = tw_vgain(vel, note); !q[23] ? q[23] = q[43];
  q[25] = tw_age; tw_age += 1;
  q[4] = q[6] = q[38] = 440 * 2 ^ ((note - 69) / 12) / srate;
  ins_midi_hit();
);
function tw_noff(note) local(v, q) (
  v = 0; loop(TWNV, q = TWV + v * TWVS; q[0] && q[8] == note && q[22] ? ( q[22] = 0; !tw_ped ? q[21] = 1; ); v += 1; );
);
function tw_all_off() local(v, q) ( v = 0; loop(TWNV, q = TWV + v * TWVS; q[0] ? ( q[22] = 0; q[21] = 1; ); v += 1; ); );

// a strip's block: where it has run to, its pitch (the sag, the waver, the stretch, the vibrato), its tone, its level
function tw_vblk(q) local(n, t, hn, fat, wear, w, ev, sf, vb, cents, f, inc, d, cut, att, as, body, am, tg, lp, ks, sx, sd, rl, rb, rp, rv, sag) (
  n = q[8]; t = q[17];
  // THE LOOP: the strip runs up the tower and back down, LENGTH round; the time played (wear, the settle) runs on
  !q[21] ? ( t += tw_bs * tw_sb; q[17] = t; q[44] += tw_bs * tw_sb; );
  lp = q[44]; lp >= tw_len ? ( lp -= floor(lp / tw_len) * tw_len; q[44] = lp; );
  q[46] = lp / tw_len;
  hn = tw_hgt(lp < tw_len * 0.5 ? lp : tw_len - lp); q[40] = hn;
  // the recording on the strip (its level, brightness, intonation, vibrato), the same every time round
  ks = min(max(tw_len / 5, 0.7), 4); sx = min(0.3, tw_len * 0.08); sd = n * 7.31;
  rl = tw_rec(sd, lp, tw_len, ks, sx); rb = tw_rec(sd + 101, lp, tw_len, ks, sx);
  rp = tw_rec(sd + 202, lp, tw_len, ks, sx); rv = tw_rec(sd + 303, lp, tw_len, ks, sx);
  // the strip's fatigue (FATE): over minutes, each strip its own way
  fat = tw_fate * 0.5 * (0.25 + 0.75 * (0.55 * tw_fg + 0.45 * (0.5 + 0.5 * sin(2 * $pi * (tw_ft * TWN[n * 4 + 3] + TWN[n * 4 + 2])))));
  q[39] = fat;
  wear = min(t / 1408, 1);
  w = tw_wander(q + 26, tw_bs);
  ev = tw_wander(q + 34, tw_bs);
  q[30] += q[31] * tw_bs; q[30] -= floor(q[30]); sf = sin(2 * $pi * q[30]);
  q[32] += q[33] * tw_bs; q[32] -= floor(q[32]); vb = sin(2 * $pi * q[32]);
  // GRAVITY: the speed sags the higher up the strip, it wavers, the stretched tape flutters
  sag = -tw_grav * (6 * min(t / 8, 1) + 40 * hn) - 10 * fat * min(t / 4, 1);
  q[45] += (sag - q[45]) * tw_k80;                               // (glided: a shorter LENGTH never jumps the pitch)
  cents = TWN[n * 4] + q[45] + rp * 6
        + w * tw_grav * (2 + 10 * hn)
        + sf * (tw_grav * hn * 7 + fat * 4) * (0.3 + tw_wob)
        + vb * tw_vibd * min(t / 0.9, 1) * (1 + 0.8 * rv);
  q[41] = cents;
  f = 440 * 2 ^ ((n - 69 + tw_bend + cents * 0.01) / 12);
  inc = f / srate;
  d = tw_det * (1 + 0.35 * ev);
  q[4] = inc * 2 ^ (d / 2400); q[6] = inc * 2 ^ (-d / 2400); q[38] = inc * 2 ^ (d * 0.15 * w / 2400);
  cut = tw_vcut * 2 ^ (0.35 * ev + 0.5 * rb - 1.2 * wear - 0.9 * fat);
  q[9] = tw_k(cut);
  q[14] = tw_brth * (1 + 0.3 * ev);
  q[15] *= tw_chkb; q[15] < 0.0005 ? q[15] = 0;                 // the organ's chiff: at the pipe's speech only
  // the level: the recording's attack and settle, the run-out at the strip's end, the release, the touch
  att = min(q[18] + tw_bs / (q[24] ? 0.003 : tw_att), 1); q[18] = att;
  as = att * att * (3 - 2 * att);
  body = (0.8 + 0.2 * exp(-t * 0.4)) * (1 + 0.05 * ev) * (1 + 0.14 * rl);
  q[21] ? ( q[20] *= (q[24] ? tw_rkf : tw_rk); );
  am = 1 - (tw_grav * hn * 0.12 + fat * 0.08) * (0.5 + 0.5 * sf);
  q[23] += (q[43] - q[23]) * tw_k20;
  tg = as * body * q[20] * q[23] * am;
  tg < 0.000001 ? tg = 0;
  q[2] = (tg - q[1]) / samplesblock;
  // gone: released (or run out) and silent
  tg == 0 && q[1] < 0.000001 && q[21] ? ( q[0] = 0; q[1] = 0; q[2] = 0; );
  tw_act += tg;
);

// ---------- LIGHTNING ----------
// (each envelope is the difference of two decays, raised together: no step; a strike while one still rings
//  raises it only as far as 1.6 - struck twice is stronger, never without limit)
function tw_bump(a, d, amt) local(k) ( k = min(amt, max(1.6 * amt - d[0], 0)); a[0] += k; d[0] += k; );
function tw_strike(v) (
  tw_slp = 1; tw_slt = 0.07 + 0.13 * tw_ssz;
  tw_stg = -(0.3 + 2.2 * tw_ssz) * (0.6 + 0.4 * v);
  tw_sv = max(tw_sv - 3 * tw_ssz, -6);                      // the lurch begins at once
  tw_bump(TWE, TWE + 1, tw_ssz);                            // the crack
  tw_bump(TWE + 2, TWE + 3, tw_ssz);                        // the rumble
  tw_bump(TWE + 4, TWE + 5, 1);                             // the structural distortion
  tw_bump(TWE + 6, TWE + 7, 1);                             // into the shaft
  tw_bump(TWE + 8, TWE + 9, 1);                             // the shaft takes over
  tw_flash = 1; tw_stt = 0; tw_snum += 1;
);

// ---------- parameters ----------
function tw_update() local(s, g, b) (
  tw_src = floor(slider1 + 0.5);
  tw_len = slider2;
  tw_rk = exp(-tw_bs * 4.6 / max(slider3, 0.01)); tw_rkf = exp(-tw_bs / 0.005);
  tw_gent = slider4; tw_tonet = slider5 / 100;
  tw_capt = slider6;
  tw_gravt = slider7 / 100; tw_tens = min(max(slider8 / 100 + tw_cc1, 0), 1); tw_wobt = slider9 / 100;
  tw_storm = slider13 / 50;
  tw_windt = slider10 / 100 * tw_storm;
  tw_cold = max(15 - slider11, 0) / 35 * tw_storm; tw_warm = max(slider11 - 15, 0) / 25 * tw_storm;
  tw_pdrop = min(max(1013 - slider12, 0) / 73 * tw_storm, 1.6);
  tw_ssz = slider14 / 100;
  tw_snote = floor(slider15 + 0.5);
  tw_shsz = slider16 / 100; tw_shdec = slider17; tw_shmix = slider18 / 100;
  tw_fate = slider19 / 50;
  tw_vel = slider20 / 100;
  tw_chan = floor(slider21 + 0.5);
  tw_volt = 10 ^ (slider22 / 20) * sqr(slider23 / 100) * 2.8;
  ins_output_setup(24);
);
function tw_shset() local(i, sz, l) (
  // the shaft's eight lines (ms), scaled by SIZE (never longer than the buffer)
  sz = 0.45 + 1.35 * tw_shszs;
  i = 0;
  loop(8,
    l = (i == 0 ? 61.3 : i == 1 ? 73.9 : i == 2 ? 89.1 : i == 3 ? 103.7 : i == 4 ? 121.3 : i == 5 ? 139.9 : i == 6 ? 157.1 : 181.7);
    TWSL[8 + i] = min(floor(l * sz * srate / 1000), 65000);
    i += 1; );
);
function tw_srinit() (
  tw_sr = srate; ost_init(0);
  tw_tables();
  tw_bs = samplesblock / srate;
  tw_update();
  tw_shszs = tw_shsz; tw_shset(); i_ = 0; loop(8, TWSL[i_] = TWSL[8 + i_]; TWSL[32 + i_] = 0; i_ += 1; ); tw_pdl = (0.03 + 0.07 * tw_shszs) * srate;
  memset(TWSH, 0, 8 * 65536); memset(TWGH, 0, TWGM + 1); memset(TWCH, 0, 8192); memset(TWPD, 0, 32768); memset(TWAP, 0, 8192);
  tw_fc = 1; tw_fs = 0; tw_wc = 1; tw_ws = 0; tw_c1c = 1; tw_c1s = 0; tw_c2c = 1; tw_c2s = 0;
  // the ensemble chorus' two rotations (0.62 Hz and 5.8 Hz)
  tw_c1cd = cos(2 * $pi * 0.62 / srate); tw_c1sd = sin(2 * $pi * 0.62 / srate); tw_c2cd = cos(2 * $pi * 5.8 / srate); tw_c2sd = sin(2 * $pi * 5.8 / srate);
  // the strike's envelopes: decays a sample (attack, decay)
  tw_e1ak = exp(-1 / (0.0015 * srate)); tw_e1dk = exp(-1 / (0.09 * srate)); tw_e1n = tw_bipk(0.0015, 0.09);
  tw_e2ak = exp(-1 / (0.06 * srate)); tw_e2dk = exp(-1 / (2.5 * srate)); tw_e2n = tw_bipk(0.06, 2.5);
  tw_e3ak = exp(-1 / (0.004 * srate)); tw_e4ak = exp(-1 / (0.02 * srate)); tw_e4dk = exp(-1 / (1.2 * srate)); tw_e4n = tw_bipk(0.02, 1.2);
  tw_e5ak = exp(-1 / (0.08 * srate));
);
ost_init(0); twoL.ost_ch_init(); twoR.ost_ch_init();
ins_drift_init();
tw_dW1.drift_init(0.9 + rand(0.3)); tw_dW2.drift_init(0.9 + rand(0.3)); tw_dW3.drift_init(0.9 + rand(0.3));
tw_dT.drift_init(0.8 + rand(0.4)); tw_dF.drift_init(0.8 + rand(0.4)); tw_dV.drift_init(0.8 + rand(0.4)); tw_dR.drift_init(0.8 + rand(0.4));
tw_srinit();
tw_sb = 1; tw_spd = 1; tw_capp = slider6; tw_capv = 0; tw_gen = slider4; tw_tone = slider5 / 100; tw_grav = slider7 / 100;
tw_wob = slider9 / 100; tw_shdecs = slider17; tw_g0 = tw_on(0) * sqr(slider34 / 100); tw_g1 = tw_on(1) * sqr(slider35 / 100); tw_g2 = tw_on(2) * sqr(slider36 / 100); tw_g3 = tw_on(3) * sqr(slider37 / 100);
tw_wl = tw_wr = 1; tw_shd = 1; tw_shw = 0; tw_oww = 1;

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
tw_update();

@block
prs_chk();
srate != tw_sr ? tw_srinit();
tw_bs = samplesblock / srate;
tw_update();
tw_chkb = exp(-tw_bs / 0.045); tw_k20 = 1 - exp(-tw_bs / 0.02); tw_k80 = 1 - exp(-tw_bs / 0.08); tw_k1 = 1 - exp(-tw_bs / 1.0);

// ---------- MIDI into the queue ----------
tw_qn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, tw_chan) ? (
    st_ = m1 & 0xF0;
    st_ == 0x90 && m3 > 0 ? (
      tw_snote > 0 && m2 == tw_snote ? tw_strike(m3 / 127) : (
        TWHN[m2] = 1;
        tw_qn < TWQN ? ( k_ = tw_qn * 4; TWQ[k_] = mofs; TWQ[k_ + 1] = 1; TWQ[k_ + 2] = m2; TWQ[k_ + 3] = m3 / 127; tw_qn += 1; );
      );
    ) : st_ == 0x80 || (st_ == 0x90 && m3 == 0) ? (
      !(tw_snote > 0 && m2 == tw_snote) ? (
        TWHN[m2] = 0;
        tw_qn < TWQN ? ( k_ = tw_qn * 4; TWQ[k_] = mofs; TWQ[k_ + 1] = 0; TWQ[k_ + 2] = m2; TWQ[k_ + 3] = 0; tw_qn += 1; );
      );
    ) : st_ == 0xE0 ? ( tw_bend = (((m3 * 128 + m2) - 8192) / 8192) * 2; ) :
    st_ == 0xB0 ? (
      m2 == 1 ? ( tw_cc1 = m3 / 127; ) :
      m2 == 64 ? ( tw_ped = m3 >= 64; !tw_ped ? ( v_ = 0; loop(TWNV, q_ = TWV + v_ * TWVS; q_[0] && !q_[22] ? q_[21] = 1; v_ += 1; ); ); ) :
      m2 == 120 || m2 == 123 ? ( tw_all_off(); memset(TWHN, 0, 128); );
    );
  );
  midisend(mofs, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( tw_all_off(); memset(TWHN, 0, 128); );
gfx_pst_prev = gfx_pst;
tw_qr = 0; tw_sp = 0;
// the STRIKE key (the panel's one-way hand-off: it only ever counts up)
tw_gsk != tw_gseen ? ( tw_gseen = tw_gsk; tw_strike(1); );

// ---------- the controls, glided ----------
tw_gen += (tw_gent + tw_fate * 0.5 * tw_fg - tw_gen) * tw_k80;
tw_tone += (tw_tonet - tw_tone) * tw_k80;
tw_grav += (tw_gravt - tw_grav) * tw_k80; tw_wob += (tw_wobt - tw_wob) * tw_k80;
tw_wind += (tw_windt - tw_wind) * tw_k80;
tw_shszs += (tw_shsz - tw_shszs) * (1 - exp(-tw_bs / 0.3));
tw_shdecs += (tw_shdec - tw_shdecs) * tw_k80;
// the sources: crossfade gains (a sample each, below), the strips' character from them
tw_t0 = tw_on(0) * sqr(slider34 / 100); tw_t1 = tw_on(1) * sqr(slider35 / 100); tw_t2 = tw_on(2) * sqr(slider36 / 100); tw_t3 = tw_on(3) * sqr(slider37 / 100);
tw_xf = abs(tw_g0 - tw_t0) + abs(tw_g1 - tw_t1) + abs(tw_g2 - tw_t2) + abs(tw_g3 - tw_t3) > 0.0001;
// (the sources layered: the strips' shared character is the sources' blend, by level)
tw_gs4 = max(tw_g0 + tw_g1 + tw_g2 + tw_g3, 0.0001);
tw_det = (9 * tw_g0 + 7 * tw_g1 + 1 * tw_g2 + 0.4 * tw_g3) / tw_gs4;
tw_vibd = (5 * tw_g0 + 8 * tw_g1 + 6 * tw_g2) / tw_gs4;
tw_att = (0.22 * tw_g0 + 0.15 * tw_g1 + 0.07 * tw_g2 + 0.035 * tw_g3) / tw_gs4 + 0.001;
tw_vcut = (5200 * tw_g0 + 6800 * tw_g1 + 4200 * tw_g2 + 8500 * tw_g3) / tw_gs4 + 100;
tw_brth = 0.2;
tw_chd += ((0.7 * tw_t0 + 0.9 * tw_t1 + 0.3 * tw_t2) / max(tw_t0 + tw_t1 + tw_t2 + tw_t3, 0.0001) - tw_chd) * tw_k80;

// ---------- FATE: tape fatigue (slow, minutes), and the tuning's wander ----------
ins_drift_block(min(tw_fate, 2) * 0.35, samplesblock);
tw_ft += tw_bs;
tw_fg = 0.5 + 0.5 * tw_dF.drift_tick(tw_bs * 0.012);
tw_fgl = tw_fate * 0.5 * tw_fg;

// ---------- LIGHTNING: the capstan thrown (a spring: the slip, then the lurch back) ----------
tw_stt += tw_bs;
tw_slp ? ( tw_slt -= tw_bs; tw_slt <= 0 ? tw_slp = 0; );
tw_slp ? ( tw_om = 2 * $pi * 7; tw_ze = 0.75; tw_tg = tw_stg; ) : ( tw_om = 2 * $pi * (0.6 + 0.5 * (1 - tw_ssz)); tw_ze = 0.5; tw_tg = 0; );
tw_sv += (-tw_om * tw_om * (tw_sx - tw_tg) - 2 * tw_ze * tw_om * tw_sv) * tw_bs; tw_sx += tw_sv * tw_bs;
abs(tw_sx) + abs(tw_sv) < 0.000001 && !tw_slp ? tw_sx = tw_sv = 0;
// its chatter while it slips
tw_chn += ((rand(2) - 1) - tw_chn) * 0.3;
tw_chat = tw_chn * min(abs(tw_sx), 1) * 0.12;
tw_flash *= exp(-tw_bs / 0.25);
// the distortion's decay follows SIZE; the shaft's flood lasts with its decay
tw_e3dk = exp(-1 / ((0.25 + 0.6 * tw_ssz) * srate)); tw_e3n = tw_bipk(0.004, 0.25 + 0.6 * tw_ssz);
tw_e5dd = 2 + 0.35 * tw_shdec; tw_e5dk = exp(-1 / (tw_e5dd * srate)); tw_e5n = tw_bipk(0.08, tw_e5dd);
tw_son = TWE[1] + TWE[3] + TWE[5] + TWE[7] + TWE[9] > 0.00001;
!tw_son ? memset(TWE, 0, 10);
tw_dzo = vo_tanh(0.35 * tw_ssz);

// ---------- THE APEX WEATHER ----------
// WIND SHEAR: turbulence and gusts
tw_wt1 = tw_dW1.drift_tick(tw_bs * 0.9); tw_wt2 = tw_dW2.drift_tick(tw_bs * 2.3); tw_wt3 = tw_dW3.drift_tick(tw_bs * 1.4);
tw_wind > 0.001 && !tw_gon && rand(1) < tw_bs * (0.15 + 0.6 * tw_wind) ? ( tw_gon = 1; tw_gtg = 0.4 + rand(0.6); tw_gdur = 0.5 + rand(2); );
tw_gon ? ( tw_gdur -= tw_bs; tw_gdur <= 0 ? tw_gon = 0; );
tw_gs += ((tw_gon ? tw_gtg : 0) - tw_gs) * (1 - exp(-tw_bs / (tw_gon ? 0.35 : 0.9)));
tw_wsw = tw_wind * (0.5 * (0.6 * tw_wt1 + 0.4 * tw_wt2) + 0.9 * tw_gs);
tw_wcn = tw_wsw * 14;
tw_wlt = 1 - tw_wind * (0.16 + 0.25 * tw_gs) * (0.5 + 0.5 * tw_wt3);
tw_wrt = 1 - tw_wind * (0.16 + 0.25 * tw_gs) * (0.5 - 0.5 * tw_wt3);
tw_wli = (tw_wlt - tw_wl) / samplesblock; tw_wri = (tw_wrt - tw_wr) / samplesblock;
// TEMPERATURE: cold drifts flat (slowly, as the tape stiffens), warm slackens
tw_tcn += (-tw_cold * 28 + tw_warm * 4 - tw_tcn) * (1 - exp(-tw_bs / 6));
tw_tdr = tw_dT.drift_tick(tw_bs * 0.15) * (tw_cold + tw_warm) * 6;

// ---------- the transport: CAPSTAN (a motor), wow and flutter (TENSION, WOBBLE), all into the speed ----------
tw_cmo = 2 * $pi * 0.9;
tw_capv += (tw_cmo * tw_cmo * (tw_capt - tw_capp) - 2 * tw_cmo * tw_capv) * tw_bs; tw_capp += tw_capv * tw_bs;
tw_gn = min(max((tw_gen - 1) / 4, 0), 1.3);
tw_tns = tw_tens;
tw_dwt = (tw_wob * (1 - 0.85 * tw_tns) * 22 + tw_grav * 4) * (1 + 1.2 * tw_warm) * (1 + 0.3 * tw_fgl);
tw_dft = (tw_wob * (0.2 + 0.8 * tw_tns) * 6 + tw_gn * 1.2) * (1 + 1.5 * tw_cold) * (1 + 0.4 * tw_fgl);
tw_dw += (tw_dwt - tw_dw) * tw_k80; tw_df += (tw_dft - tw_df) * tw_k80;
tw_wrt2 = 0.25 + 0.9 * tw_tns + 0.05 * tw_dR.drift_tick(tw_bs * 0.3); tw_frt = 4.5 + 9 * tw_tns;
tw_wcd = cos(2 * $pi * tw_wrt2 / srate); tw_wsd = sin(2 * $pi * tw_wrt2 / srate);
tw_fcd = cos(2 * $pi * tw_frt / srate); tw_fsd = sin(2 * $pi * tw_frt / srate);
g_ = 1 / sqrt(tw_wc * tw_wc + tw_ws * tw_ws); tw_wc *= g_; tw_ws *= g_;
g_ = 1 / sqrt(tw_fc * tw_fc + tw_fs * tw_fs); tw_fc *= g_; tw_fs *= g_;
g_ = 1 / sqrt(tw_c1c * tw_c1c + tw_c1s * tw_c1s); tw_c1c *= g_; tw_c1s *= g_;
g_ = 1 / sqrt(tw_c2c * tw_c2c + tw_c2s * tw_c2s); tw_c2c *= g_; tw_c2s *= g_;
tw_wdr = tw_dV.drift_tick(tw_bs * (0.4 + 0.8 * tw_tns)) * tw_dw * 0.6;
tw_wowv = tw_ws; tw_dwv = tw_dw;
tw_cents = tw_tcn + tw_tdr + tw_wcn + tw_wdr + (ins_pitch - 1) * 1731 + tw_chat * 1200 + tw_wind * tw_gs * tw_chn * 10;
tw_sbt = 2 ^ ((tw_capp + tw_sx * 12 + tw_cents * 0.01) / 12);
tw_sbi = (tw_sbt - tw_sb) / samplesblock;
// the tape's contact lost as it slips
tw_slpa = 1 - 0.55 * min(max(-tw_sx / 1.2, 0), 1);

// ---------- GENERATION: the copy's high loss, head bump, saturation, compression, hiss, the ghost; TONE ----------
tw_tk = tw_k(15000 * 2 ^ (-1.9 * tw_gn - 0.9 * tw_cold));
tw_hbk = tw_k(110); tw_bump = 0.08 + 0.35 * tw_gn;
tw_drv = 1 + 2.2 * tw_gn; tw_drvi = 1 / tw_drv;
tw_cmp = 1.6 * tw_gn; tw_cka = 1 - exp(-1 / (0.008 * srate)); tw_ckr = 1 - exp(-1 / (0.25 * srate));
tw_actg += (min(tw_act, 1) - tw_actg) * (1 - exp(-tw_bs / (tw_act > tw_actg ? 0.01 : 0.25)));
tw_actg < 0.000000001 ? tw_actg = 0;
tw_hiss = (0.00025 + 0.0035 * tw_gn ^ 1.5) * tw_actg; tw_hiss < 0.0000001 ? tw_hiss = 0;
tw_act = 0;
tw_ghd = floor(0.85 * srate); tw_ghl = 0.012 + 0.07 * tw_gn; tw_ghk = tw_k(3000);
tw_tlk = tw_k(900); tw_tg = 2 ^ (tw_tone * 1.4);
// PRESSURE: thin and dark as it drops
tw_phk = tw_k(18 * 2 ^ (3.4 * tw_pdrop)); tw_plk = tw_k(20000 * 2 ^ (-2.0 * tw_pdrop));
// the sources' own buses: the choir's formants (drifting between "aah" and "oh"), the strings' body
tw_vow = min(max(0.25 + 0.25 * tw_dV.drift_tick(0) + 0.15 * tw_fgl, 0), 1);
tw_bpset(TWF, 650 * (420 / 650) ^ tw_vow, 90); tw_bpset(TWF + 4, 1080 * (800 / 1080) ^ tw_vow, 110);
tw_bpset(TWF + 8, 2650 * (2550 / 2650) ^ tw_vow, 160); tw_bpset(TWF + 12, 3400 * (3300 / 3400) ^ tw_vow, 200);
tw_bpset(TWF + 16, 480, 300); tw_bpset(TWF + 20, 2300, 900);
tw_fhk = tw_k(140);

// ---------- THE SHAFT ----------
tw_shset();
// (the lengths glide sample by sample: a change of SIZE bends the tail, it never clicks)
i_ = 0; loop(8, TWSL[32 + i_] = (TWSL[8 + i_] - TWSL[i_]) * 0.04 / samplesblock; i_ += 1; );
tw_dext = 1 + 1.5 * tw_ssz * min(TWE[9] * tw_e5n, 1);
i_ = 0; loop(8, TWSL[16 + i_] = 10 ^ (-3 * TWSL[i_] / (tw_shdecs * tw_dext * srate)) * 0.35355339; i_ += 1; );
tw_shk = tw_k(6500 * 2 ^ (-0.6 * min(tw_shdec / 20, 1)));
tw_pdi = ((0.03 + 0.07 * tw_shszs) * srate - tw_pdl) * 0.04 / samplesblock;
tw_ap1 = floor(142 * srate / 48000); tw_ap2 = floor(379 * srate / 48000);
// (the wet level kept the same whatever SIZE and DECAY: a long shaft gathers energy)
tw_shl = 0; i_ = 0; loop(8, tw_shl += TWSL[i_]; i_ += 1; ); tw_shl = max(tw_shl / (8 * srate), 0.001);
tw_shn = 10 ^ (-(6.5 * log10(tw_shdecs / tw_shl) - 4) / 20);
tw_shdt = min(1, 2 - 2 * tw_shmix); tw_shwt = min(1, 2 * tw_shmix) * tw_shn;
tw_shdi = (tw_shdt - tw_shd) / samplesblock;

// ---------- the strips, block by block ----------
v_ = 0; loop(TWNV, q_ = TWV + v_ * TWVS; q_[0] ? tw_vblk(q_); v_ += 1; );
tw_nsound = 0; v_ = 0; loop(TWNV, q_ = TWV + v_ * TWVS; q_[0] && !q_[24] ? tw_nsound += 1; v_ += 1; );

// ---------- denormals ----------
abs(tw_t1s) + abs(tw_t2s) + abs(tw_hb) + abs(tw_tl) + abs(tw_ph) + abs(tw_pl1) + abs(tw_pl2) + abs(tw_ghs) + abs(tw_ce) < 0.000000000001 ? tw_t1s = tw_t2s = tw_hb = tw_tl = tw_ph = tw_pl1 = tw_pl2 = tw_ghs = tw_ce = 0;
abs(tw_hp2) + abs(tw_cn) + abs(tw_rn1) + abs(tw_rn2) < 0.000000000001 ? tw_hp2 = tw_cn = tw_rn1 = tw_rn2 = 0;
// the shaft sleeps when silent (and costs nothing)
tw_shpk < 0.0000000001 && tw_shin < 0.0000000001 && !tw_son ? ( tw_shq += 1; tw_shq == 4 ? ( memset(TWSH, 0, 8 * 65536); memset(TWPD, 0, 32768); memset(TWAP, 0, 8192); memset(TWSL + 24, 0, 8); ); ) : tw_shq = 0;
tw_shpk = 0; tw_shin = 0;
tw_pk *= exp(-tw_bs / 0.4);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the queue ----------
while (tw_qr < tw_qn && (TWQ[tw_qr * 4] <= tw_sp || tw_sp >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  k_ = tw_qr * 4;
  TWQ[k_ + 1] ? tw_non(TWQ[k_ + 2], TWQ[k_ + 3]) : tw_noff(TWQ[k_ + 2]);
  tw_qr += 1;
);
tw_sp += 1;

// ---------- the transport: the capstan's speed, wow and flutter ----------
tw_sb += tw_sbi;
c_ = tw_wc * tw_wcd - tw_ws * tw_wsd; tw_ws = tw_ws * tw_wcd + tw_wc * tw_wsd; tw_wc = c_;
c_ = tw_fc * tw_fcd - tw_fs * tw_fsd; tw_fs = tw_fs * tw_fcd + tw_fc * tw_fsd; tw_fc = c_;
tw_spd = tw_sb * (1 + (tw_ws * tw_dw + tw_fs * tw_df) * 0.000577623);
// the sources' crossfade
tw_xf ? (
  tw_g0 += (tw_t0 - tw_g0) * 0.0007; tw_g1 += (tw_t1 - tw_g1) * 0.0007; tw_g2 += (tw_t2 - tw_g2) * 0.0007; tw_g3 += (tw_t3 - tw_g3) * 0.0007;
  abs(tw_g0 - tw_t0) + abs(tw_g1 - tw_t1) + abs(tw_g2 - tw_t2) + abs(tw_g3 - tw_t3) < 0.0001 ? ( tw_g0 = tw_t0; tw_g1 = tw_t1; tw_g2 = tw_t2; tw_g3 = tw_t3; tw_xf = 0; );
);
tw_g01 = tw_g0 + tw_g1;

// ---------- the strips ----------
tw_b0 = tw_b1 = tw_b2 = tw_b3 = 0;
q_ = TWV;
loop(TWNV,
  q_[0] ? (
    e_ = q_[1] + q_[2]; q_[1] = e_;
    p_ = q_[3] + q_[4] * tw_spd; p_ >= 1 ? p_ -= 1; q_[3] = p_;
    x_ = p_ * 1024; i_ = x_ | 0; f_ = x_ - i_; o_ = q_[7] + i_;
    tw_g01 > 0.0005 ? (
      r_ = q_[5] + q_[6] * tw_spd; r_ >= 1 ? r_ -= 1; q_[5] = r_;
      x_ = r_ * 1024; j_ = x_ | 0; h_ = x_ - j_; o2_ = q_[7] + j_;
      r_ = q_[16] + q_[38] * tw_spd; r_ >= 1 ? r_ -= 1; q_[16] = r_;
      x_ = r_ * 1024; k_ = x_ | 0; u_ = x_ - k_; o3_ = q_[7] + k_;
      tw_g0 > 0.0005 ? (
        t_ = TWT + o_; a_ = t_[0] + (t_[1] - t_[0]) * f_; t_ = TWT + o2_; a_ += t_[0] + (t_[1] - t_[0]) * h_;
        t_ = TWT + o3_; a_ = (a_ + t_[0] + (t_[1] - t_[0]) * u_) * 0.75;
        q_[10] += (a_ - q_[10]) * q_[9]; tw_b0 += q_[10] * e_;
      );
      tw_g1 > 0.0005 ? (
        t_ = TWT + TWTS + o_; a_ = t_[0] + (t_[1] - t_[0]) * f_; t_ = TWT + TWTS + o2_; a_ += t_[0] + (t_[1] - t_[0]) * h_;
        t_ = TWT + TWTS + o3_; a_ = (a_ + t_[0] + (t_[1] - t_[0]) * u_) * 0.75;
        q_[11] += (a_ - q_[11]) * q_[9]; tw_b1 += q_[11] * e_;
      );
    );
    tw_g2 > 0.0005 ? (
      t_ = TWT + 2 * TWTS + o_; a_ = t_[0] + (t_[1] - t_[0]) * f_;
      a_ += (rand(2) - 1) * q_[14] * (0.55 + 0.45 * a_);
      q_[12] += (a_ - q_[12]) * q_[9]; tw_b2 += q_[12] * e_;
    );
    tw_g3 > 0.0005 ? (
      t_ = TWT + 3 * TWTS + o_; a_ = t_[0] + (t_[1] - t_[0]) * f_;
      q_[15] > 0.0005 ? a_ += (rand(2) - 1) * q_[15];
      q_[13] += (a_ - q_[13]) * q_[9]; tw_b3 += q_[13] * e_;
    );
  );
  q_ += TWVS;
);

// ---------- the sources' buses: the choir's formants, the strings' body, the flutes' air ----------
x_ = 0;
tw_g0 > 0.0005 ? ( b_ = tw_b0 * tw_g0; x_ += (b_ * 0.12 + twf0.tw_bp(b_, TWF) + twf1.tw_bp(b_, TWF + 4) * 0.75 + twf2.tw_bp(b_, TWF + 8) * 0.4 + twf3.tw_bp(b_, TWF + 12) * 0.25) * 2.1; );
tw_g1 > 0.0005 ? ( b_ = tw_b1 * tw_g1; x_ += (b_ * 0.45 + twf4.tw_bp(b_, TWF + 16) * 0.7 + twf5.tw_bp(b_, TWF + 20) * 0.35) * 0.71; );
tw_g2 > 0.0005 ? ( b_ = tw_b2 * tw_g2; tw_hp2 += (b_ - tw_hp2) * tw_fhk; x_ += (b_ - tw_hp2) * 0.74; );
tw_g3 > 0.0005 ? ( x_ += tw_b3 * tw_g3 * 0.55; );

// ---------- GENERATION: the copy ----------
tw_t1s += (x_ - tw_t1s) * tw_tk; tw_t2s += (tw_t1s - tw_t2s) * tw_tk; x_ = tw_t2s;
tw_hb += (x_ - tw_hb) * tw_hbk; x_ += tw_hb * tw_bump;
x_ = vo_tanh(x_ * tw_drv) * tw_drvi;
a_ = abs(x_); tw_ce += (a_ - tw_ce) * (a_ > tw_ce ? tw_cka : tw_ckr); x_ /= 1 + tw_cmp * tw_ce;
tw_hiss > 0 ? x_ += (rand(2) - 1) * tw_hiss;
// the print-through ghost (0.85 s on)
TWGH[tw_ghw] = x_; tw_ghw = (tw_ghw + 1) & TWGM;
tw_ghs += (TWGH[(tw_ghw - tw_ghd) & TWGM] - tw_ghs) * tw_ghk; x_ += tw_ghs * tw_ghl;
// TONE, PRESSURE
tw_tl += (x_ - tw_tl) * tw_tlk; x_ = tw_tl + (x_ - tw_tl) * tw_tg;
tw_ph += (x_ - tw_ph) * tw_phk; x_ -= tw_ph;
tw_pl1 += (x_ - tw_pl1) * tw_plk; tw_pl2 += (tw_pl1 - tw_pl2) * tw_plk; x_ = tw_pl2 * tw_slpa;

// ---------- the ensemble chorus (three taps turning a third apart): the strings', the choir's ----------
TWCH[tw_chw] = x_; tw_chw = (tw_chw + 1) & 8191;
tw_chd > 0.001 ? (
  c_ = tw_c1c * tw_c1cd - tw_c1s * tw_c1sd; tw_c1s = tw_c1s * tw_c1cd + tw_c1c * tw_c1sd; tw_c1c = c_;
  c_ = tw_c2c * tw_c2cd - tw_c2s * tw_c2sd; tw_c2s = tw_c2s * tw_c2cd + tw_c2c * tw_c2sd; tw_c2c = c_;
  m0_ = 0.0016 * tw_c1s + 0.00012 * tw_c2s;
  m1_ = 0.0016 * (-0.5 * tw_c1s + 0.8660254 * tw_c1c) + 0.00012 * (-0.5 * tw_c2s + 0.8660254 * tw_c2c);
  m2_ = 0.0016 * (-0.5 * tw_c1s - 0.8660254 * tw_c1c) + 0.00012 * (-0.5 * tw_c2s - 0.8660254 * tw_c2c);
  d_ = (0.0068 + m0_) * srate; i_ = d_ | 0; f_ = d_ - i_; a_ = TWCH[(tw_chw - 1 - i_) & 8191]; a_ += (TWCH[(tw_chw - 2 - i_) & 8191] - a_) * f_;
  d_ = (0.0068 + m1_) * srate; i_ = d_ | 0; f_ = d_ - i_; b_ = TWCH[(tw_chw - 1 - i_) & 8191]; b_ += (TWCH[(tw_chw - 2 - i_) & 8191] - b_) * f_;
  d_ = (0.0068 + m2_) * srate; i_ = d_ | 0; f_ = d_ - i_; c_ = TWCH[(tw_chw - 1 - i_) & 8191]; c_ += (TWCH[(tw_chw - 2 - i_) & 8191] - c_) * f_;
  l_ = x_ * (1 - 0.45 * tw_chd) + (0.62 * a_ + 0.38 * b_) * 0.8 * tw_chd;
  r_ = x_ * (1 - 0.45 * tw_chd) + (0.62 * c_ + 0.38 * b_) * 0.8 * tw_chd;
) : ( l_ = r_ = x_; );

// ---------- WIND SHEAR on the level, left and right ----------
tw_wl += tw_wli; tw_wr += tw_wri;
l_ *= tw_wl; r_ *= tw_wr;

// ---------- LIGHTNING: the structural distortion, the crack and the thunder ----------
tw_son ? (
  TWE[0] *= tw_e1ak; TWE[1] *= tw_e1dk; TWE[2] *= tw_e2ak; TWE[3] *= tw_e2dk;
  TWE[4] *= tw_e3ak; TWE[5] *= tw_e3dk; TWE[6] *= tw_e4ak; TWE[7] *= tw_e4dk; TWE[8] *= tw_e5ak; TWE[9] *= tw_e5dk;
  d_ = (TWE[5] - TWE[4]) * tw_e3n * tw_ssz;
  d_ > 0.0005 ? (
    k_ = 1 + 24 * d_;
    a_ = (vo_tanh(l_ * k_ + 0.35 * d_) - vo_tanh(0.35 * d_)) * (1 + 0.25 * sin(3 * l_ * k_));
    b_ = (vo_tanh(r_ * k_ + 0.35 * d_) - vo_tanh(0.35 * d_)) * (1 + 0.25 * sin(3 * r_ * k_));
    l_ += (a_ * 0.6 - l_) * min(d_ * 1.5, 1); r_ += (b_ * 0.6 - r_) * min(d_ * 1.5, 1);
  );
  n_ = rand(2) - 1;
  tw_cn += (n_ - tw_cn) * 0.3;
  tw_rn1 += (n_ - tw_rn1) * 0.009; tw_rn2 += (tw_rn1 - tw_rn2) * 0.009;
  y_ = tw_cn * (TWE[1] - TWE[0]) * tw_e1n * 0.55 + tw_rn2 * (TWE[3] - TWE[2]) * tw_e2n * 7;
  l_ += y_; r_ += y_;
  tw_sbo = (TWE[7] - TWE[6]) * tw_e4n * tw_ssz * 1.6;
  tw_swo = (TWE[9] - TWE[8]) * tw_e5n * tw_ssz;
) : ( tw_sbo = 0; tw_swo = 0; );

// ---------- THE SHAFT: a pre-delay, two diffusers, eight lines turned into each other, darkening as it falls ----------
in_ = (l_ + r_) * 0.5 * (1 + tw_sbo);
tw_shin = max(tw_shin, abs(in_));
tw_shd += tw_shdi;
tw_shw += (max(tw_shwt, min(tw_swo, 1.6) * 0.8 * tw_shn) - tw_shw) * 0.0005;
tw_shq < 4 || abs(in_) > 0.0000000001 ? (
  tw_shq >= 4 ? tw_shq = 0;
  tw_pdl += tw_pdi; TWPD[tw_pdw] = in_; x_ = tw_rd(TWPD, tw_pdw, tw_pdl, 32767); tw_pdw = (tw_pdw + 1) & 32767;
  a_ = TWAP[(tw_apw - tw_ap1) & 4095]; v_ = x_ - 0.6 * a_; TWAP[tw_apw] = v_; x_ = a_ + 0.6 * v_;
  a_ = TWAP[4096 + ((tw_apw - tw_ap2) & 4095)]; v_ = x_ - 0.6 * a_; TWAP[4096 + tw_apw] = v_; x_ = a_ + 0.6 * v_;
  tw_apw = (tw_apw + 1) & 4095;
  w_ = tw_shwp; g_ = TWSL;
  g_[0] += g_[32]; g_[1] += g_[33]; g_[2] += g_[34]; g_[3] += g_[35]; g_[4] += g_[36]; g_[5] += g_[37]; g_[6] += g_[38]; g_[7] += g_[39];
  s0_ = tw_rd(TWSH, w_, g_[0], 65535);          s1_ = tw_rd(TWSH + 65536, w_, g_[1], 65535);
  s2_ = tw_rd(TWSH + 131072, w_, g_[2], 65535); s3_ = tw_rd(TWSH + 196608, w_, g_[3], 65535);
  s4_ = tw_rd(TWSH + 262144, w_, g_[4], 65535); s5_ = tw_rd(TWSH + 327680, w_, g_[5], 65535);
  s6_ = tw_rd(TWSH + 393216, w_, g_[6], 65535); s7_ = tw_rd(TWSH + 458752, w_, g_[7], 65535);
  k_ = tw_shk; d_ = TWSL + 24;
  d_[0] += (s0_ - d_[0]) * k_; d_[1] += (s1_ - d_[1]) * k_; d_[2] += (s2_ - d_[2]) * k_; d_[3] += (s3_ - d_[3]) * k_;
  d_[4] += (s4_ - d_[4]) * k_; d_[5] += (s5_ - d_[5]) * k_; d_[6] += (s6_ - d_[6]) * k_; d_[7] += (s7_ - d_[7]) * k_;
  a0_ = d_[0] + d_[1]; a1_ = d_[0] - d_[1]; a2_ = d_[2] + d_[3]; a3_ = d_[2] - d_[3];
  a4_ = d_[4] + d_[5]; a5_ = d_[4] - d_[5]; a6_ = d_[6] + d_[7]; a7_ = d_[6] - d_[7];
  b0_ = a0_ + a2_; b1_ = a1_ + a3_; b2_ = a0_ - a2_; b3_ = a1_ - a3_; b4_ = a4_ + a6_; b5_ = a5_ + a7_; b6_ = a4_ - a6_; b7_ = a5_ - a7_;
  g_ = TWSL + 16;
  TWSH[w_] = (b0_ + b4_) * g_[0] + x_;            TWSH[65536 + w_] = (b1_ + b5_) * g_[1] - x_;
  TWSH[131072 + w_] = (b2_ + b6_) * g_[2] + x_;   TWSH[196608 + w_] = (b3_ + b7_) * g_[3] - x_;
  TWSH[262144 + w_] = (b0_ - b4_) * g_[4] + x_;   TWSH[327680 + w_] = (b1_ - b5_) * g_[5] - x_;
  TWSH[393216 + w_] = (b2_ - b6_) * g_[6] + x_;   TWSH[458752 + w_] = (b3_ - b7_) * g_[7] - x_;
  tw_shwp = (w_ + 1) & 65535;
  wl_ = (d_[0] + d_[2] + d_[4] + d_[6]) * 0.5; wr_ = (d_[1] + d_[3] + d_[5] + d_[7]) * 0.5;
  tw_shpk = max(tw_shpk, abs(wl_) + abs(wr_));
  l_ = l_ * tw_shd + wl_ * tw_shw; r_ = r_ * tw_shd + wr_ * tw_shw;
) : ( l_ *= tw_shd; r_ *= tw_shd; );

// ---------- out ----------
tw_vol += (tw_volt - tw_vol) * 0.0005;
l_ = twoL.ost_band(l_ * tw_vol); r_ = twoR.ost_band(r_ * tw_vol);
ost_out(l_, r_);
spl0 = abs(ost_l) < 0.0000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.0000000001 ? 0 : ost_r;
tw_pk = max(tw_pk, max(abs(spl0), abs(spl1)));

@gfx 560 980
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 5; ui_hw = 1;
ui_begin(560, 980);

// ---------- the card's colours: brushed steel, oxidised concrete, graphite, the cold phosphor of the tube ----------
TG_FACE = 0x878B8D; TG_FACEL = 0xA2A6A8; TG_FACED = 0x5F6365; TG_CONC = 0x707372; TG_CONCD = 0x5A5D5C; TG_WELL = 0x63676A;
TG_INK = 0x0E1011; TG_BAND = 0x24272A; TG_LBL = 0x0C0E0F; TG_LBLL = 0xE2E6E8; TG_LBLD = 0x9CA2A6;
TG_PH = 0x9DF1FF; TG_PHL = 0xE8FDFF; TG_PHD = 0x3D8592; TG_PHF = 0x16363C; TG_GLASS = 0x061214;
TG_KEYOFF = 0x2A2E32; TG_KEYHOV = 0x394045; TG_CAP = 0xB3B8BB; TG_CAPE = 0x7E8386; TG_FLASH = 0xF0EBFF;

// fonts, calibrated once per scale (a reference word fills the same width everywhere); large, for reading
sc != tg_calsc ? (
  tg_calsc = sc;
  tg_f11 = ui_fitfont(11, (13.5 * sc) * max(ui_tf, 1));       // key captions, the scale, small print
  tg_f12 = ui_fitfont(12, (15.5 * sc) * max(ui_tf, 1));       // section titles, the lever names
  tg_f13 = ui_fitfont(13, (14.5 * sc) * max(ui_tf, 1));       // knob labels, values
);
gfx_setfont(11, "Trebuchet MS", tg_f11, 'b'); gfx_setfont(12, "Trebuchet MS", tg_f12, 'b');
gfx_setfont(13, "Trebuchet MS", tg_f13, 'b');
gfx_setfont(14, "Trebuchet MS", 24 * sc, 'b');    // the card's name, the numeral
gfx_setfont(15, "Courier New", 21 * sc, 'b');     // the LCDs

// ---------- drawing helpers (base coordinates) ----------
function tg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function tg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function tg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function tg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function tg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function tg_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function tg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function tg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function tg_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function tg_ln(x1, y1, x2, y2, w) ( tg_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function tg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function tg_bolt(x, y) (
  ui_col(TG_FACED); gfx_circle(x * sc, y * sc, 3.6 * sc, 1, 1);
  ui_col(TG_FACEL); gfx_circle(x * sc, y * sc, 2.6 * sc, 1, 1);
  ui_col(TG_FACED); tg_r(x - 1.8, y - 0.4, 3.6, 0.9);
);
// a section: a recessed slab, a graphite band with its title
function tg_sect(x, y, w, h, title) (
  ui_col(TG_INK); tg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  ui_col(TG_WELL); tg_r(x, y, w, h);
  ui_cola(0xFFFFFF, 0.12); tg_r(x, y + h - 1, w, 1);
  ui_col(TG_BAND); tg_r(x, y, w, 23);
  ui_col(TG_FACEL); tg_r(x, y + 23, w, 1);
  strlen(title) ? ( gfx_setfont(12); ui_col(TG_LBLL); tg_t(x + 9, y + 3, title); );
);
// the knobs' and levers' value pill (shown only while touched)
function tg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(TG_INK); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 4 * sc, 3 * sc);
  ui_col(TG_PHF); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc + 1 * sc, tw + 12 * sc, th + 2 * sc, 2.5 * sc);
  ui_col(TG_PHL); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);
// a value's position (0..1) and back: lg 0 linear, 1 logarithmic, 2 the tower's scale (a loop's turn: half way up)
function tg_n(v, lo, hi, lg) ( lg == 2 ? (tw_hgt(v * 0.5) - tw_hgt(lo * 0.5)) / (tw_hgt(hi * 0.5) - tw_hgt(lo * 0.5)) : lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function tg_v(n, lo, hi, lg) local(h) (
  lg == 2 ? ( h = tw_hgt(lo * 0.5) + n * (tw_hgt(hi * 0.5) - tw_hgt(lo * 0.5)); 2 * (exp(h * log(1 + 5280 / 60)) - 1) * 60 / 7.5; ) :
  lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
);
// the mouse on a control: drag (SHIFT = fine), double-click (or Ctrl-click) = default, the wheel; returns the hover
function tg_mouse(idx, did, hov, lo, hi, def, lg, stp, px) local(v, n) (
  v = slider(idx);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - tg_lt < 0.35 && tg_lid == idx && !tg_mv) || (mouse_cap & 4) ? ( tg_set(idx, def); drag_id = -1; tg_lt = 0; ) : (
      drag_id = did; tg_ky = mouse_y; tg_ky0 = mouse_y; tg_mv = 0; tg_lt = time_precise(); tg_lid = idx;
      tg_kn = tg_n(v, lo, hi, lg);
    );
  );
  drag_id == did && !tg_mv && abs(mouse_y - tg_ky0) > 3 * sc ? ( tg_mv = 1; tg_ky = mouse_y; );
  drag_id == did && tg_mv ? (
    tg_kn = min(max(tg_kn + (tg_ky - mouse_y) / (((mouse_cap & 8) ? px * 6 : px) * sc), 0), 1); tg_ky = mouse_y;
    v = tg_v(tg_kn, lo, hi, lg);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? tg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = tg_n(v, lo, hi, lg);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = tg_v(n, lo, hi, lg);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    tg_set(idx, v); mouse_wheel = 0;
  );
  hov || drag_id == did;
);
// the knob: a smooth ring (lit from org to the value), a flat steel cap, an index line; the value on hover
function tg_knob(cx, cy, r, idx, lo, hi, def, lg, org, label, fmt, stp) local(v, n, n0, a, a0, ac, rr, w, on, dx, dy) (
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc;
  on = tg_mouse(idx, 2000 + idx, dx * dx + dy * dy <= sqr((r + 6) * sc), lo, hi, def, lg, stp, 220);
  v = slider(idx); n = min(max(tg_n(v, lo, hi, lg), 0), 1); n0 = min(max(tg_n(org, lo, hi, lg), 0), 1);
  rr = (r + 6) * sc; w = 3 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ac = a0 + n0 * 1.5 * $pi;
  ui_col(0x34383B); tg_arcw(cx * sc, cy * sc, rr, a0, 0.75 * $pi, 1.4 * sc);
  abs(a - ac) > 0.01 ? ( ui_col(TG_PH); tg_arcw(cx * sc, cy * sc, rr, min(a, ac), max(a, ac), w); );
  ui_col(TG_PH); gfx_circle(cx * sc + sin(a) * rr, cy * sc - cos(a) * rr, w * 0.6, 1, 1);
  ui_cola(0x000000, 0.3); gfx_circle(cx * sc + 1.5 * sc, cy * sc + 2.5 * sc, r * sc, 1, 1);
  ui_col(TG_INK); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(TG_CAPE); gfx_circle(cx * sc, cy * sc, (r - 1.4) * sc, 1, 1);
  ui_col(TG_CAP); gfx_circle(cx * sc, cy * sc, (r - 3.2) * sc, 1, 1);
  ui_col(TG_INK); tg_lnp(cx * sc + sin(a) * r * 0.22 * sc, cy * sc - cos(a) * r * 0.22 * sc, cx * sc + sin(a) * (r - 4) * sc, cy * sc - cos(a) * (r - 4) * sc, max(2.4 * sc, r * 0.11 * sc));
  on ? (
    ui_cola(0xFFFFFF, 0.16); gfx_circle(cx * sc, cy * sc, (r - 3.2) * sc, 1, 1);
    strlen(fmt) ? sprintf(#tg_vv, fmt, v) : strcpy(#tg_vv, #tg_vs);
    tg_pill(cx, cy + r + 7, #tg_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(13); ui_col(TG_LBL); tg_tc(cx, cy + r + 16, label); );
  );
);
// a big lever (a capstan throw): a slot, a scale, a heavy handle with its lit index; the value on hover
function tg_lever(cx, yt, yb, hw, idx, lo, hi, def, lg, org, label, fmt, stp) local(v, n, y, on, i, yy, n0, y0) (
  v = slider(idx); n = min(max(tg_n(v, lo, hi, lg), 0), 1); y = yb - n * (yb - yt);
  on = tg_mouse(idx, 3000 + idx, tg_hov(cx - hw * 0.5 - 4, yt - 18, hw + 8, yb - yt + 36), lo, hi, def, lg, stp, yb - yt);
  // the scale
  ui_cola(TG_INK, 0.75);
  i = 0; loop(11, yy = yb - i * (yb - yt) / 10; tg_r(cx - 17 - (i % 5 == 0 ? 6 : 0), yy - 0.6, i % 5 == 0 ? 10 : 5, 1.2); tg_r(cx + 12, yy - 0.6, i % 5 == 0 ? 10 : 5, 1.2); i += 1; );
  // the slot
  ui_col(TG_INK); tg_rr(cx - 6, yt - 6, 12, yb - yt + 12, 5);
  ui_col(0x040505); tg_rr(cx - 3.5, yt - 3.5, 7, yb - yt + 7, 3);
  // the lit run from the origin to the handle
  n0 = min(max(tg_n(org, lo, hi, lg), 0), 1); y0 = yb - n0 * (yb - yt);
  ui_cola(TG_PH, 0.8); tg_r(cx - 1.5, min(y, y0), 3, abs(y - y0));
  // the handle
  ui_cola(0x000000, 0.35); tg_rr(cx - hw * 0.5 + 2, y - 13, hw, 30, 4);
  ui_col(TG_INK); tg_rr(cx - hw * 0.5, y - 15, hw, 30, 4);
  ui_col(on ? 0xC6CBCE : TG_CAP); tg_rr(cx - hw * 0.5 + 1.5, y - 13.5, hw - 3, 27, 3);
  ui_col(TG_CAPE); i = 0; loop(3, tg_r(cx - hw * 0.5 + 5, y - 10 + i * 3.4, hw - 10, 1.3); tg_r(cx - hw * 0.5 + 5, y + 4 + i * 3.4, hw - 10, 1.3); i += 1; );
  ui_col(TG_INK); tg_r(cx - hw * 0.5 + 2, y - 1.6, hw - 4, 3.2);
  ui_col(TG_PH); tg_r(cx - hw * 0.5 + 3, y - 0.8, hw - 6, 1.6);
  on ? (
    strlen(fmt) ? sprintf(#tg_vv, fmt, v) : strcpy(#tg_vv, #tg_vs);
    tg_pill(cx, yb + 19, #tg_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(11); ui_col(TG_LBL); tg_tc(cx, yb + 28, label); );
  );
);
// a lit key: lit = on; returns 1 when clicked
function tg_key(x, y, w, h, on, s) local(hov, hit) (
  hov = tg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(TG_PH, 0.3); tg_rr(x - 3, y - 3, w + 6, h + 6, 5); );
  ui_cola(0x000000, 0.3); tg_rr(x + 1, y + 2, w, h, 3);
  ui_col(TG_INK); tg_rr(x, y, w, h, 3);
  ui_col(on ? TG_PH : hov ? TG_KEYHOV : TG_KEYOFF); tg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.55); tg_r(x + 4, y + 3, w - 8, 1.3); ) : ( ui_cola(0xFFFFFF, 0.1); tg_r(x + 4, y + 3, w - 8, 1); );
  strlen(s) ? ( gfx_setfont(12); ui_col(on ? TG_INK : TG_LBLL); tg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function tg_nn(n) ( sprintf(#tg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #tg_k), floor(n / 12) - 1); #tg_nn; );
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last; grp < 0: the first item stands alone, the rest grouped
// by -grp (aligned to the item numbers, so the first group is one short)
function tg_mlist(list, n, cur, grp) local(i, s0, op, g, e) (
  strcpy(#tg_mls, ""); i = 0;
  loop(n,
    g = abs(grp); s0 = g > 0 ? i - i % g : 0; e = min(s0 + g, n); grp < 0 && s0 == 0 ? s0 = 1;
    op = g > 0 && e - s0 > 1 && !(grp < 0 && i == 0);
    op && i == s0 ? ( strcat(#tg_mls, ">"); strcat(#tg_mls, pk_pitem(list, i + 1, #tg_mi)); strcat(#tg_mls, " - ");
                      strcat(#tg_mls, pk_pitem(list, e, #tg_mi)); strcat(#tg_mls, "|"); );
    op && i == e - 1 ? strcat(#tg_mls, "<");
    i == cur ? strcat(#tg_mls, "!");
    strcat(#tg_mls, pk_pitem(list, i + 1, #tg_mi));
    i < n - 1 ? strcat(#tg_mls, "|");
    i += 1; );
  #tg_mls;
);
// a value box: the value in words and a small down-arrow; a click opens the list of every value (list: lo..hi,
// grp > 0 groups it in submenus of grp), the wheel steps it
function tg_mbox(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = tg_hov(x, y, w, h);
  ui_col(TG_INK); tg_rr(x, y, w, h, 3); ui_col(hov ? 0x0F2A2F : TG_GLASS); tg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(13); ui_col(TG_PH); tg_tc(x + (w - 11) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 13) * sc, (y + h * 0.5 - 2) * sc, (x + w - 6) * sc, (y + h * 0.5 - 2) * sc, (x + w - 9.5) * sc, (y + h * 0.5 + 2.5) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(tg_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? tg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( tg_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
// a length in time and in tape (7.5 ft a second)
function tg_tstr(t, dst) ( t < 60 ? sprintf(dst, "%.1f S", t) : sprintf(dst, "%d:%02d MIN", floor(t / 60), floor(t - floor(t / 60) * 60)); dst; );
function tg_fstr(t, dst) local(ft) ( ft = t * 7.5; ft < 5280 * 0.5 ? sprintf(dst, "%.0f FT", ft) : sprintf(dst, "%.2f MILES", ft / 5280); dst; );
// the scope's height for u (0 .. 1: the foot .. the apex, a mile up)
function tg_y(u) ( TG_Y0 - u * (TG_Y0 - TG_Y1); );

// ======================== the faceplate: brushed steel on a concrete monolith ========================
ui_col(TG_CONCD); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(TG_INK); tg_rr(3, 3, 554, 974, 8);
ui_col(TG_FACE); tg_rr(5.5, 5.5, 549, 969, 6);
// the brushing: fine horizontal lines, sparingly
tg_i = 0; loop(118, tg_y_ = 56 + tg_i * 7.6 + (tg_i % 3) * 1.3; tg_x_ = 8 + ui_hash(tg_i * 1.7) * 270; tg_w_ = 90 + ui_hash(tg_i * 3.1) * 260;
  ui_cola(tg_i & 1 ? 0xFFFFFF : 0x000000, 0.05); tg_r(tg_x_, tg_y_, min(tg_w_, 550 - tg_x_), 1); tg_i += 1; );
// the formwork seams of the monolith
ui_cola(TG_INK, 0.35); tg_r(224, 52, 1, 588); tg_r(356, 52, 1, 588);
// the header: graphite, ruled in steel
ui_col(TG_BAND); tg_r(6, 6, 548, 42);
ui_col(TG_FACEL); tg_r(6, 48, 548, 1.5);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
tg_k_ = pk_preset(14 * sc, 13 * sc, 304 * sc, 28 * sc, pr_cur, #tw_pm);
tg_k_ > 0 ? ( tg_k_ > 12 ? reset_all() : prs_dirty = tg_k_; );
pk_led(340 * sc, 33 * sc, 4.5 * sc, ins_midi_lit(), TG_PH);
gfx_setfont(11); ui_col(TG_LBLD); tg_tc(340, 19, "MIDI");
sprintf(#tg_g, slider21 < 0.5 ? "OMNI" : "CH %.0f", slider21);
tg_mbox(356, 14, 74, 27, 21, 0, 16, #tg_g, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", 0);
ui_size_picker(480 * sc, 18 * sc);

// ======================== the apex: the numeral, the status tube ========================
ui_col(TG_INK); tg_rr(259, 55, 62, 32, 3); ui_col(TG_FACEL); tg_rr(261, 57, 58, 28, 2);
ui_cola(TG_INK, 0.4); tg_r(264, 81, 52, 1);
gfx_setfont(14); ui_col(TG_INK); tg_tc(290, 71.5, "XVI");
// the storm's strength, for the tube's flicker
tg_si = min(tw_wind + 0.35 * (tw_cold + tw_warm) + 0.5 * tw_pdrop + (slider13 / 100) * 0.15, 1.2);
tg_glow = min(max(0.55 + 0.08 * sin(time_precise() * 1.7) + (rand(1) - 0.5) * 0.8 * tg_si, 0.22) + 1.4 * tw_flash, 1.6);
// the socket and the glass envelope
ui_col(TG_INK); tg_rr(266, 133, 48, 13, 2); ui_col(TG_FACED); tg_r(268, 135, 44, 9);
ui_col(TG_INK); tg_i = 0; loop(4, tg_r(274 + tg_i * 10, 144, 2.5, 5); tg_i += 1; );
ui_cola(tw_flash > 0.25 ? TG_FLASH : TG_PH, min(0.1 * tg_glow, 1)); gfx_circle(290 * sc, 111 * sc, 30 * sc, 1, 1);
ui_col(TG_INK); tg_rr(268, 88, 44, 48, 20); tg_r(268, 112, 44, 24);
ui_col(0x0A1B1E); tg_rr(270, 90, 40, 44, 18); tg_r(270, 112, 40, 22);
// its glow, the electrodes
tg_gc_ = tw_flash > 0.25 ? TG_FLASH : TG_PH;
ui_cola(tg_gc_, min(0.14 * tg_glow, 1)); gfx_circle(290 * sc, 111 * sc, 18 * sc, 1, 1);
ui_cola(tg_gc_, min(0.24 * tg_glow, 1)); gfx_circle(290 * sc, 111 * sc, 13 * sc, 1, 1);
ui_cola(tg_gc_, min(0.5 * tg_glow, 1)); gfx_circle(290 * sc, 111 * sc, 8 * sc, 1, 1);
ui_cola(TG_PHL, min(0.95 * tg_glow, 1)); gfx_circle(290 * sc, 111 * sc, 4.2 * sc, 1, 1);
ui_cola(TG_PHD, 0.9); tg_r(289.4, 98, 1.2, 33); tg_i = 0; loop(4, tg_r(280, 100 + tg_i * 7.5, 20, 1); tg_i += 1; );
ui_cola(0xFFFFFF, 0.35); tg_r(274, 98, 1.5, 28);
ui_cola(0xC9D2D6, 0.5); gfx_arc(290 * sc, 107 * sc, 15 * sc, -1.1, 1.1, 1);

// ======================== THE RIBBON: the loop's LCD ========================
ui_col(TG_INK); tg_rr(14, 55, 236, 88, 4);
ui_col(TG_GLASS); tg_rr(17, 58, 230, 82, 3);
gfx_setfont(11); ui_col(TG_PHD); tg_t(26, 62, "THE LOOP");
gfx_setfont(15); ui_col(TG_PH); tg_t(26, 80, tg_tstr(slider2, #tg_g)); tg_t(26, 104, tg_fstr(slider2, #tg_g));
gfx_setfont(11); ui_col(TG_PHD); tg_t(26, 126, "ROUND  ·  7.5 FT/S");
// the strips hanging
tg_n_ = 0; tg_v_ = 0; loop(TWNV, tg_q_ = TWV + tg_v_ * TWVS; tg_q_[0] && !tg_q_[24] ? tg_n_ += 1; tg_v_ += 1; );
gfx_setfont(11); ui_col(TG_PHD); tg_tr(238, 69, "STRIPS");
tg_i = 0; loop(10, ui_col(tg_i < tg_n_ ? TG_PH : TG_PHF); tg_r(180 + (tg_i % 5) * 12, 104 + floor(tg_i / 5) * 12, 9, 9); tg_i += 1; );
sprintf(#tg_g, "%d", tg_n_); gfx_setfont(15); ui_col(TG_PH); tg_tr(238, 88, #tg_g);

// ======================== GENERATION ========================
tg_sect(330, 55, 218, 88, "GENERATION");
tg_knob(366, 102, 17, 4, 1, 5, 1.5, 0, 1, "COPY", "%.2f", 0);
tg_knob(512, 102, 17, 5, -100, 100, 0, 0, 0, "TONE", "%+.0f%%", 0);
// the copies: lit to the generation (fatigue's share glowing faintly beyond)
tg_i = 0; loop(5,
  tg_a_ = min(max(slider4 - tg_i, 0), 1); tg_b_ = min(max(tw_gen - tg_i, 0), 1);
  ui_col(TG_INK); tg_r(404 + tg_i * 15, 89, 12, 18);
  ui_col(TG_PHF); tg_r(405.5 + tg_i * 15, 90.5, 9, 15);
  tg_b_ > tg_a_ ? ( ui_cola(TG_PHD, 0.8); tg_r(405.5 + tg_i * 15, 90.5 + 15 * (1 - tg_b_), 9, 15 * tg_b_); );
  tg_a_ > 0 ? ( ui_col(TG_PH); tg_r(405.5 + tg_i * 15, 90.5 + 15 * (1 - tg_a_), 9, 15 * tg_a_); );
  sprintf(#tg_g, "%d", tg_i + 1); gfx_setfont(11); ui_col(TG_LBL); tg_tc(410.5 + tg_i * 15, 117, #tg_g);
  tg_i += 1; );
gfx_setfont(11); ui_col(TG_LBL); tg_tc(442, 134, "COPIES");

// ======================== TRANSPORT: the three throws ========================
tg_sect(12, 151, 208, 489, "TRANSPORT");
tg_lever(50, 200, 470, 52, 6, -12, 12, 0, 0, 0, "CAPSTAN", "%+.2f st", 0);
tg_lever(116, 200, 470, 52, 7, 0, 100, 30, 0, 0, "GRAVITY", "%.0f%%", 0);
tg_lever(182, 200, 470, 52, 8, 0, 100, 50, 0, 0, "TENSION", "%.0f%%", 0);
gfx_setfont(11); ui_col(TG_LBL);
tg_tc(50, 185, "+12"); tg_tc(50, 486, "-12");
tg_tc(116, 185, "HEAVY"); tg_tc(116, 486, "LIGHT");
tg_tc(182, 185, "TAUT"); tg_tc(182, 486, "SLACK");
ui_cola(TG_INK, 0.25); tg_r(22, 530, 188, 1);
tg_knob(66, 572, 20, 9, 0, 100, 30, 0, 0, "WOBBLE", "%.0f%%", 0);
tg_knob(166, 572, 20, 3, 0.03, 3, 0.15, 1, 0.03, "RELEASE", "%.2f s", 0);

// ======================== THE TOWER: the oscilloscope tube, a mile high, the loop up and down it ========================
TG_Y0 = 600; TG_Y1 = 196; tg_xs = 290;
ui_cola(0x000000, 0.35); tg_rr(231, 153, 124, 490, 20);
ui_col(TG_INK); tg_rr(228, 150, 124, 490, 20);
ui_col(TG_FACED); tg_rr(230.5, 152.5, 119, 485, 18);
ui_col(TG_INK); tg_rr(234, 156, 112, 478, 15);
ui_col(TG_GLASS); tg_rr(236, 158, 108, 474, 14);
// the graticule: the tower's heights (100 ft, 1000 ft, the apex at a mile)
tg_i = 0;
loop(3,
  tg_u_ = tg_i == 0 ? 1 : tg_i == 1 ? tw_hgt(1000 / 7.5) : tw_hgt(100 / 7.5);
  tg_yy_ = tg_y(tg_u_);
  ui_cola(TG_PH, 0.13); tg_r(238, tg_yy_, 104, 1);
  ui_cola(TG_PH, 0.6); tg_r(236, tg_yy_ - 0.5, 7, 1.5);
  gfx_setfont(11); ui_col(TG_PHD);
  tg_tl(241, tg_yy_ - 8, tg_i == 0 ? "1 MI" : tg_i == 1 ? "1000'" : "100'");
  tg_i += 1; );
// the loop's turn: a pulley half the LENGTH up (the 2-mile loop turns at the apex)
tg_yp = min(tg_y(tw_hgt(slider2 * 0.5)), TG_Y0 - 34);
// the tape: it bows with the wow, shivers with the flutter, sways in the wind and whips when struck
tg_tm = time_precise(); tg_fr += 1;
tg_wb = tw_wowv * min(tw_dwv / 10, 2.5) * 6;
tg_fl = min(tw_df, 14) * 0.3;
tg_sw = tw_wsw * 26;
tg_wh = min(tw_flash, 1) * 26;
tg_sn = tw_sx * 8;
function tg_bend(u, k) local(d) (
  d = tg_wb * sin($pi * u) + (ui_hash(k * 7.3 + tg_fr * 1.37) - 0.5) * tg_fl * (0.4 + u)
    + tg_sw * u ^ 1.6 + tw_wind * 3 * u * sin(9 * u - tg_tm * 3.1)
    + tg_wh * sin(16 * u - tw_stt * 40) * exp(-1.5 * u) + tg_sn * exp(-5 * u);
  min(max(d, -24), 24);
);
// both runs, 33 points each from the foot to the turn (TG_SX / TG_SY: up; +40: down)
tg_ut = (TG_Y0 - tg_yp) / (TG_Y0 - TG_Y1);
tg_i = 0;
loop(33,
  tg_u_ = tg_ut * tg_i / 32; tg_b_ = tg_bend(tg_u_, tg_i * 0.37);
  TG_SY[tg_i] = tg_y(tg_u_); TG_SX[tg_i] = tg_xs - 15 + tg_b_;
  TG_SY[40 + tg_i] = TG_SY[tg_i]; TG_SX[40 + tg_i] = tg_xs + 15 + tg_bend(tg_u_, tg_i * 0.37 + 50);
  tg_i += 1; );
tg_bt = (TG_SX[32] + TG_SX[72]) * 0.5; tg_bb = (TG_SX[0] + TG_SX[40]) * 0.5;
// the pulley at the turn, the capstan at the foot; the apex's own pulley, faint, when the loop turns lower
tg_yp > TG_Y1 + 4 ? ( ui_cola(TG_PHD, 0.5); gfx_circle(tg_xs * sc, TG_Y1 * sc, 15 * sc, 0, 1); gfx_circle(tg_xs * sc, TG_Y1 * sc, 2.5 * sc, 1, 1); );
ui_cola(TG_PHD, 0.95); gfx_circle(tg_bt * sc, tg_yp * sc, 12 * sc, 0, 1); gfx_circle(tg_bt * sc, tg_yp * sc, 3 * sc, 1, 1);
ui_cola(TG_PHD, 0.95); gfx_circle(tg_bb * sc, TG_Y0 * sc, 12 * sc, 0, 1); gfx_circle(tg_bb * sc, TG_Y0 * sc, 3 * sc, 1, 1);
gfx_circle((tg_bb + 22) * sc, (TG_Y0 + 14) * sc, 5 * sc, 0, 1);
// (a faint line from the turn to the LENGTH lever)
ui_cola(TG_PH, 0.4); tg_i = 0; loop(5, tg_r(tg_bt + 20 + tg_i * 6, tg_yp - 0.6, 3.5, 1.2); tg_i += 1; );
// the glow: three passes, each run in level-ended quads, the turns as arcs round the pulleys
tg_cc_ = tw_flash > 0.3 ? TG_FLASH : TG_PH;
tg_p_ = 0; loop(3,
  ui_cola(tg_p_ == 2 ? TG_PHL : tg_cc_, tg_p_ == 0 ? 0.12 : tg_p_ == 1 ? 0.3 : 1);
  tg_w_ = (tg_p_ == 0 ? 9 : tg_p_ == 1 ? 4.2 : 1.8) * 0.5;
  tg_k_ = 0; loop(2,
    tg_i = tg_k_ * 40; loop(32,
      gfx_triangle((TG_SX[tg_i] - tg_w_) * sc, TG_SY[tg_i] * sc, (TG_SX[tg_i] + tg_w_) * sc, TG_SY[tg_i] * sc,
                   (TG_SX[tg_i + 1] + tg_w_) * sc, TG_SY[tg_i + 1] * sc, (TG_SX[tg_i + 1] - tg_w_) * sc, TG_SY[tg_i + 1] * sc);
      tg_i += 1; );
    tg_k_ += 1; );
  tg_arcw(tg_bt * sc, tg_yp * sc, 15 * sc, -0.5 * $pi, 0.5 * $pi, tg_w_ * 2 * sc);
  tg_arcw(tg_bb * sc, TG_Y0 * sc, 15 * sc, 0.5 * $pi, 1.5 * $pi, tg_w_ * 2 * sc);
  tg_p_ += 1; );
// the strips playing: each goes up one run, over the turn and down the other, and round again
tg_ly_ = -100; tg_lu_ = -100; tg_v_ = 0;
loop(TWNV,
  tg_q_ = TWV + tg_v_ * TWVS;
  tg_q_[0] && !tg_q_[24] ? (
    tg_dn_ = tg_q_[46] >= 0.5;
    tg_f_ = tg_ut > 0 ? min(tg_q_[40] / tg_ut, 1) * 32 : 0; tg_k_ = min(floor(tg_f_), 31); tg_f_ -= tg_k_;
    tg_k_ += tg_dn_ * 40;
    tg_x_ = TG_SX[tg_k_] + (TG_SX[tg_k_ + 1] - TG_SX[tg_k_]) * tg_f_; tg_yy_ = TG_SY[tg_k_] + (TG_SY[tg_k_ + 1] - TG_SY[tg_k_]) * tg_f_;
    tg_a_ = min(tg_q_[1] * 2 + 0.3, 1);
    ui_cola(TG_PH, 0.3 * tg_a_); gfx_circle(tg_x_ * sc, tg_yy_ * sc, 8 * sc, 1, 1);
    ui_cola(TG_PHL, tg_a_); gfx_circle(tg_x_ * sc, tg_yy_ * sc, 3.4 * sc, 1, 1);
    // (its name beside its own run: left of the run going up, right of the run coming down)
    tg_dn_ ? ( abs(tg_yy_ - tg_ly_) > 13 ? ( gfx_setfont(11); ui_cola(TG_PH, tg_a_); tg_tl(min(TG_SX[72] + 12, 316), tg_yy_ - 8, tg_nn(tg_q_[8])); tg_ly_ = tg_yy_; ); ) :
             ( abs(tg_yy_ - tg_lu_) > 13 ? ( gfx_setfont(11); ui_cola(TG_PH, tg_a_); tg_tr(max(tg_x_ - 10, 268), tg_yy_, tg_nn(tg_q_[8])); tg_lu_ = tg_yy_; ); );
  );
  tg_v_ += 1; );
// the arrows of travel: up the left run, down the right
ui_cola(TG_PHD, 0.9);
tg_yy_ = TG_Y0 - 22; gfx_triangle((tg_xs - 31) * sc, (tg_yy_ - 5) * sc, (tg_xs - 35) * sc, (tg_yy_ + 2) * sc, (tg_xs - 27) * sc, (tg_yy_ + 2) * sc);
gfx_triangle((tg_xs + 31) * sc, (tg_yy_ + 2) * sc, (tg_xs + 35) * sc, (tg_yy_ - 5) * sc, (tg_xs + 27) * sc, (tg_yy_ - 5) * sc);
// lightning down the glass while it strikes
tw_flash > 0.15 ? (
  tg_x_ = 256 + ui_hash(tw_snum * 3.1) * 50; tg_yy_ = 162; ui_cola(TG_FLASH, min(tw_flash * 1.2, 1));
  tg_i = 0; loop(9, tg_x2_ = tg_x_ + (ui_hash(tw_snum * 1.3 + tg_i) - 0.5) * 30; tg_y2_ = tg_yy_ + 26 + ui_hash(tw_snum + tg_i * 2.2) * 22;
    tg_x2_ = min(max(tg_x2_, 244), 336); tg_y2_ = min(tg_y2_, 600);
    tg_ln(tg_x_, tg_yy_, tg_x2_, tg_y2_, 2.2); tg_x_ = tg_x2_; tg_yy_ = tg_y2_; tg_i += 1; );
);

// ======================== THE RIBBON's lever: LENGTH, its handle at the loop's turn ========================
tg_tstr(slider2, #tg_a); tg_fstr(slider2, #tg_b); sprintf(#tg_vs, "%s  ·  %s", #tg_a, #tg_b);
tg_lever(382, TG_Y1, min(tg_y(tw_hgt(4)), TG_Y0 - 34), 34, 2, 8, 1408, 8, 2, 8, "LENGTH", "", 0);

// ======================== THE APEX WEATHER ========================
tg_sect(412, 151, 136, 489, "WEATHER");
tg_knob(480, 210, 21, 10, 0, 100, 0, 0, 0, "WIND SHEAR", "%.0f%%", 0);
tg_knob(480, 296, 21, 11, -20, 40, 15, 0, 15, "TEMPERATURE", "%.1f °C", 0);
tg_knob(480, 382, 21, 12, 940, 1040, 1013, 0, 1013, "PRESSURE", "%.0f hPa", 0);
tg_knob(480, 468, 21, 13, 0, 100, 50, 0, 0, "STORM", "%.0f%%", 0);
// the weather's LCD
ui_col(TG_INK); tg_rr(421, 528, 118, 104, 4); ui_col(TG_GLASS); tg_rr(424, 531, 112, 98, 3);
gfx_setfont(11); ui_col(TG_PHD); tg_t(431, 535, "AT THE APEX");
gfx_setfont(13); ui_col(TG_PH);
sprintf(#tg_g, "%+.0f °C", slider11); tg_t(431, 552, #tg_g);
sprintf(#tg_g, "%.0f HPA", slider12); tg_t(431, 570, #tg_g);
sprintf(#tg_g, "WIND %.0f%%", min(tw_wind * 100, 200)); tg_t(431, 588, #tg_g);
tg_si2 = tw_wind + 0.3 * (tw_cold + tw_warm) + 0.4 * tw_pdrop;
ui_col(tw_flash > 0.1 ? TG_PHL : TG_PH);
tg_t(431, 607, tw_flash > 0.1 ? "STRIKE" : slider13 < 0.5 ? "BECALMED" : tg_si2 < 0.1 ? "CALM" : tg_si2 < 0.4 ? "UNSETTLED" : tg_si2 < 0.8 ? "STORM" : "TEMPEST");

// ======================== the sources: four frames of tape, layered, each with its level ========================
tg_sect(12, 648, 536, 112, "THE FRAMES");
tg_c_ = tw_on(0) + tw_on(1) + tw_on(2) + tw_on(3);
tg_i = 0;
loop(4,
  tg_x_ = 22 + tg_i * 131;
  tg_on_ = tw_on(tg_i);
  tg_key(tg_x_, 679, 124, 30, tg_on_, pk_pitem("CHOIR|STRINGS|FLUTES|ORGAN PIPES", tg_i + 1, #tg_k)) ? (
    // the first touch of the keys takes over from the old single Source; the last one lit stays lit
    slider30 + slider31 + slider32 + slider33 < 0.5 ? tg_set(30 + floor(slider1 + 0.5), 1);
    !(tg_on_ && tg_c_ <= 1) ? ( tg_set(30 + tg_i, tg_on_ ? 0 : 1); tg_set(1, tg_on_ ? slider1 : tg_i); );
  );
  tg_knob(tg_x_ + 30, 735, 10, 34 + tg_i, 0, 100, 100, 0, 0, "", "%.0f%%", 0);
  gfx_setfont(11); ui_col(tg_on_ ? TG_LBL : TG_LBLD); tg_tl(tg_x_ + 52, 735, "LEVEL");
  tg_i += 1; );

// ======================== LIGHTNING ========================
tg_sect(12, 768, 260, 134, "LIGHTNING");
tg_hit_ = tg_key(26, 802, 112, 88, tw_flash > 0.08 || (drag_id == -2), "");
tg_hit_ ? ( tw_gsk += 1; drag_id = -2; );
// the bolt on the key
ui_col(tw_flash > 0.08 ? TG_INK : TG_PH);
gfx_triangle(86 * sc, 809 * sc, 68 * sc, 843 * sc, 81 * sc, 843 * sc);
gfx_triangle(81 * sc, 837 * sc, 74 * sc, 871 * sc, 96 * sc, 833 * sc, 82 * sc, 833 * sc);
gfx_setfont(12); ui_col(tw_flash > 0.08 ? TG_INK : TG_LBLL); tg_tc(82, 880, "STRIKE");
tg_knob(210, 822, 18, 14, 0, 100, 60, 0, 0, "SIZE", "%.0f%%", 0);
// the MIDI note that strikes: a drop-down (Off, or a note by octave); the wheel steps it
slider15 < 0.5 ? strcpy(#tg_g, "NOTE OFF") : sprintf(#tg_g, "NOTE %s", tg_nn(floor(slider15 + 0.5)));
tg_mbox(160, 866, 100, 24, 15, 0, 127, #tg_g, "Off|C#-1 (1)|D-1 (2)|D#-1 (3)|E-1 (4)|F-1 (5)|F#-1 (6)|G-1 (7)|G#-1 (8)|A-1 (9)|A#-1 (10)|B-1 (11)|C0 (12)|C#0 (13)|D0 (14)|D#0 (15)|E0 (16)|F0 (17)|F#0 (18)|G0 (19)|G#0 (20)|A0 (21)|A#0 (22)|B0 (23)|C1 (24)|C#1 (25)|D1 (26)|D#1 (27)|E1 (28)|F1 (29)|F#1 (30)|G1 (31)|G#1 (32)|A1 (33)|A#1 (34)|B1 (35)|C2 (36)|C#2 (37)|D2 (38)|D#2 (39)|E2 (40)|F2 (41)|F#2 (42)|G2 (43)|G#2 (44)|A2 (45)|A#2 (46)|B2 (47)|C3 (48)|C#3 (49)|D3 (50)|D#3 (51)|E3 (52)|F3 (53)|F#3 (54)|G3 (55)|G#3 (56)|A3 (57)|A#3 (58)|B3 (59)|C4 (60)|C#4 (61)|D4 (62)|D#4 (63)|E4 (64)|F4 (65)|F#4 (66)|G4 (67)|G#4 (68)|A4 (69)|A#4 (70)|B4 (71)|C5 (72)|C#5 (73)|D5 (74)|D#5 (75)|E5 (76)|F5 (77)|F#5 (78)|G5 (79)|G#5 (80)|A5 (81)|A#5 (82)|B5 (83)|C6 (84)|C#6 (85)|D6 (86)|D#6 (87)|E6 (88)|F6 (89)|F#6 (90)|G6 (91)|G#6 (92)|A6 (93)|A#6 (94)|B6 (95)|C7 (96)|C#7 (97)|D7 (98)|D#7 (99)|E7 (100)|F7 (101)|F#7 (102)|G7 (103)|G#7 (104)|A7 (105)|A#7 (106)|B7 (107)|C8 (108)|C#8 (109)|D8 (110)|D#8 (111)|E8 (112)|F8 (113)|F#8 (114)|G8 (115)|G#8 (116)|A8 (117)|A#8 (118)|B8 (119)|C9 (120)|C#9 (121)|D9 (122)|D#9 (123)|E9 (124)|F9 (125)|F#9 (126)|G9 (127)", -12);

// ======================== THE SHAFT ========================
tg_sect(280, 768, 268, 134, "THE SHAFT");
tg_knob(328, 830, 21, 16, 0, 100, 50, 0, 0, "SIZE", "%.0f%%", 0);
tg_knob(414, 830, 21, 17, 1, 40, 6, 1, 1, "DECAY", "%.1f s", 0);
tg_knob(500, 830, 21, 18, 0, 100, 18, 0, 0, "MIX", "%.0f%%", 0);

// ======================== the plinth: FATE, VELOCITY, VOLUME; the title; LEVEL, SAT, the output ========================
ui_col(TG_INK); tg_r(6, 909, 548, 1.5);
ui_col(TG_CONC); tg_r(6, 910.5, 548, 62.5);
ui_cola(0x000000, 0.12); tg_r(6, 926, 548, 1); tg_r(6, 948, 548, 1);
tg_knob(42, 934, 11, 19, 0, 100, 50, 0, 0, "FATE", "%.0f%%", 0);
tg_knob(108, 934, 11, 20, 0, 100, 40, 0, 0, "VELOCITY", "%.0f%%", 0);
tg_knob(178, 934, 11, 22, -24, 6, -6, 0, -24, "VOLUME", "%+.1f dB", 0);
ui_col(TG_INK); tg_rr(208, 917, 144, 42, 3); ui_col(TG_FACEL); tg_rr(210, 919, 140, 38, 2);
tg_bolt(217, 926); tg_bolt(343, 926); tg_bolt(217, 950); tg_bolt(343, 950);
gfx_setfont(14); ui_col(TG_INK); tg_tc(280, 938.5, "THE TOWER"); ver_tag("v3", 16, -0.9, 0.95);
tg_knob(386, 934, 11, 23, 0, 100, 60, 0, 0, "LEVEL", "%.1f%%", 0);
ins_io(410, 919, 24, TG_LBL);
tg_lv_ = min(max((20 * log10(max(tw_pk, 0.00001)) + 48) / 48, 0), 1);
ui_col(TG_INK); tg_r(504, 918, 40, 40); ui_col(TG_GLASS); tg_r(505.5, 919.5, 37, 37);
tg_i = 0; loop(8, ui_col(tg_i / 8 < tg_lv_ ? (tg_i >= 7 && tw_pk > 0.89 ? 0xFF4A3A : tg_i >= 6 ? TG_PHL : TG_PH) : TG_PHF); tg_r(509 + tg_i * 4, 934, 3, 17); tg_i += 1; );
gfx_setfont(11); ui_col(TG_PHD); tg_tc(524, 926, "OUT");
tw_pk > 0.95 ? ( ui_col(0xFF4A3A); tg_r(509, 953, 31, 2); );                // at the clip

// the strike lights the whole monolith
tw_flash > 0.03 ? ( ui_cola(TG_FLASH, min(tw_flash * 0.16, 0.2)); gfx_rect(0, 0, gfx_w, gfx_h); );

pk_end();
ui_end();
