  dg_i += 1;
);
// the set point (a hazard-orange cross) and the point now (amber, glowing)
dg_sx = dg_px0 + 10 + slider48 / 100 * (dg_pw - 20); dg_sy = dg_ay + (1 - slider49 / 100) * dg_ah;
ui_col(HAZ); dg_r(dg_sx - 7, dg_sy - 0.75, 14, 1.5); dg_r(dg_sx - 0.75, dg_sy - 7, 1.5, 14); dg_ring(dg_sx, dg_sy, 5);
dg_ex_ = dg_px0 + 10 + dv_ex * (dg_pw - 20); dg_ey_ = dg_ay + (1 - dv_ey) * dg_ah;
ui_cola(AMB, 0.25); dg_disc(dg_ex_, dg_ey_, 9); ui_cola(AMB, 0.5); dg_disc(dg_ex_, dg_ey_, 5.5); ui_col(AMBL); dg_disc(dg_ex_, dg_ey_, 3);
// drag the point (SHIFT = fine); double-click: back to the middle
dg_hp = dg_hov(dg_px0, dg_py0, dg_pw, dg_pw);
pressed && dg_hp && drag_id == 0 ? (
  time_precise() - dg_xlt < 0.35 ? ( dg_set(48, 50); dg_set(49, 50); drag_id = -1; ) : ( drag_id = 9100; dg_xmx = mouse_x; dg_xmy = mouse_y; );
  dg_xlt = time_precise();
);
drag_id == 9100 ? (
