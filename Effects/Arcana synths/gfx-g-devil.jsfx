// ======================== VOICE MORPH: the XY pad, its LFO, the formants ========================
dg_sect(408, 376, 384, 228, "VOICE MORPH  ·  X VOWEL  ·  Y ORGAN TO SYNTH");
dg_px0 = 422; dg_py0 = 410; dg_pw = 180;
dg_ay = dg_py0 + 20; dg_ah = dg_pw - 52;                    // where the point can sit: clear of the captions above and below
