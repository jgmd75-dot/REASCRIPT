    dg_set(49, min(max(1 - (mouse_y / sc - dg_ay) / dg_ah, 0), 1) * 100);
  );
  dg_xmx = mouse_x; dg_xmy = mouse_y;
);
(dg_hp || drag_id == 9100) ? (
