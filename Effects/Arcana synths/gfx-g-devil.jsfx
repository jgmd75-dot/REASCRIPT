  sprintf(#dg_g, "%s %.0f%% %s  ·  %s %.0f%%", pk_pitem("U|O|AW|A|UH|ER|E", dg_i + 1, #dg_k), 100 - dg_f * 100, pk_pitem("O|AW|A|UH|ER|E|I", dg_i + 1, #dg_k2),
          slider49 >= 50 ? "SYNTH" : "ORGAN", slider49 >= 50 ? slider49 : 100 - slider49);
