// ======================== the display: phase interference, the waver's path, the voice morph ========================
ui_cola(0x000000, 0.4); dg_rr(411, 72, 384, 300, 12);
ui_col(INK); dg_rr(408, 68, 384, 300, 12);
ui_col(0x202226); dg_rr(411.5, 71.5, 377, 293, 10);
ui_col(SCR); dg_rr(417, 77, 366, 282, 7);
// the etched rings round the interference figure (decoration)
dg_cx = 526; dg_cy = 190;
ui_col(GRID); dg_ring(dg_cx, dg_cy, 80); dg_ring(dg_cx, dg_cy, 54); dg_l1(dg_cx - 86, dg_cy, dg_cx + 86, dg_cy); dg_l1(dg_cx, dg_cy - 86, dg_cx, dg_cy + 86);
ui_cola(CRM, 0.25); dg_star(dg_cx, dg_cy, 80, 5, 2, $pi);
// the sub against the mid (a Lissajous): their phase interference, beating with the detune and the waver
dg_w = dv_scw; dg_px = dg_py = 0.0001; dg_i = 0;
loop(700, dg_px = max(dg_px, abs(DVSX[(dg_w - 700 + dg_i) & DVSM])); dg_py = max(dg_py, abs(DVSY[(dg_w - 700 + dg_i) & DVSM])); dg_i += 1; );
dg_lpx = max(dg_px, dg_lpx * 0.95); dg_lpy = max(dg_py, dg_lpy * 0.95);
dg_on = dg_px > 0.0003 || dg_py > 0.0003;
dg_on ? (
  dg_i = 0;
  loop(350,
    dg_j = (dg_w - 700 + dg_i * 2) & DVSM;
    dg_x = dg_cx + DVSX[dg_j] / dg_lpx * 72; dg_y = dg_cy - DVSY[dg_j] / dg_lpy * 72;
    dg_i > 0 ? ( ui_cola(CRM, 0.35); dg_ln(dg_ox, dg_oy, dg_x, dg_y, 3); ui_cola(AMB, 0.85); dg_ln(dg_ox, dg_oy, dg_x, dg_y, 1); );
    dg_ox = dg_x; dg_oy = dg_y; dg_i += 1;
  );
) : slider1 < 0.5 ? ( gfx_setfont(11); ui_col(CRM); dg_tc(dg_cx, dg_cy + 40, "PLAY WAKES THE DRONES"); );
gfx_setfont(12); ui_col(CRM); dg_t(428, 84, "SUB"); dg_t(428, 102, "MID"); ui_col(AMBL); dg_t(466, 84, dg_nname(floor(dv_sn + 0.5)));
dg_t(466, 102, dg_nname(floor(dv_mn + 0.5)));
// FATE now: the three drifts
dg_i = 0;
loop(3,
  dg_v = dg_i == 0 ? min(abs(dv_tpull) / 0.9, 1) : dg_i == 1 ? min(sqrt(dv_px * dv_px + dv_py * dv_py) / 0.25, 1) : dv_heat * min(dv_fa, 1);
  gfx_setfont(11); ui_col(CRM); dg_tc(652 + dg_i * 48, 248, pk_pitem("TEMPT|POSSESS|HEAT", dg_i + 1, #dg_k));
  ui_col(GRID); dg_r(634 + dg_i * 48, 258, 36, 3); ui_col(dg_i == 2 ? HAZ : AMB); dg_r(634 + dg_i * 48, 258, 36 * dg_v, 3);
  dg_i += 1;
);
// the voice morph: the XY point's path (an inset)
dg_ix = 630; dg_iy = 86; dg_iw = 136;
ui_col(GRID); dg_r(dg_ix, dg_iy, dg_iw, 1); dg_r(dg_ix, dg_iy + dg_iw, dg_iw, 1); dg_r(dg_ix, dg_iy, 1, dg_iw); dg_r(dg_ix + dg_iw, dg_iy, 1, dg_iw + 1);
dg_i = 1; loop(6, ui_cola(GRID, 0.6); dg_r(dg_ix + dg_i * dg_iw / 7, dg_iy + 1, 1, dg_iw - 1); dg_i += 1; );
gfx_setfont(11); ui_col(CRM); dg_tc(dg_ix + dg_iw * 0.5, dg_iy + dg_iw + 10, "VOICE MORPH");
dg_i = 0;
loop(DVXHN - 1,
  dg_j = (dv_hw + dg_i) % DVXHN; dg_k = (dg_j + 1) % DVXHN;
  ui_cola(AMB, 0.08 + 0.6 * dg_i / DVXHN);
  dg_l1(dg_ix + DVXH[dg_j] * dg_iw, dg_iy + (1 - DVYH[dg_j]) * dg_iw, dg_ix + DVXH[dg_k] * dg_iw, dg_iy + (1 - DVYH[dg_k]) * dg_iw);
  dg_i += 1;
);
ui_cola(AMB, 0.3); dg_disc(dg_ix + dv_ex * dg_iw, dg_iy + (1 - dv_ey) * dg_iw, 6); ui_col(AMBL); dg_disc(dg_ix + dv_ex * dg_iw, dg_iy + (1 - dv_ey) * dg_iw, 2.6);
// the waver's path: the last 7.5 seconds of the mid drone's pitch, against its depth
dg_wx = 430; dg_wy = 292; dg_ww = 340; dg_wh = 54;
ui_col(GRID); dg_r(dg_wx, dg_wy + dg_wh * 0.5, dg_ww, 1); dg_r(dg_wx, dg_wy, dg_ww, 1); dg_r(dg_wx, dg_wy + dg_wh, dg_ww, 1);
dg_sc_ = max(max(slider40, 0.25) * 1.15, 0.3);
dg_i = 0;
loop(DVWHN - 1,
  dg_j = (dv_hw + dg_i) % DVWHN; dg_k = (dg_j + 1) % DVWHN;
  dg_y = dg_wy + dg_wh * 0.5 - min(max(DVWH[dg_j] / dg_sc_, -1), 1) * dg_wh * 0.5;
  dg_y2 = dg_wy + dg_wh * 0.5 - min(max(DVWH[dg_k] / dg_sc_, -1), 1) * dg_wh * 0.5;
  ui_cola(CRM, 0.3); dg_ln(dg_wx + dg_i / DVWHN * dg_ww, dg_y, dg_wx + (dg_i + 1) / DVWHN * dg_ww, dg_y2, 3);
  ui_col(AMB); dg_l1(dg_wx + dg_i / DVWHN * dg_ww, dg_y, dg_wx + (dg_i + 1) / DVWHN * dg_ww, dg_y2);
  dg_i += 1;
);
ui_col(AMBL); dg_disc(dg_wx + dg_ww, dg_y2, 2.5);
