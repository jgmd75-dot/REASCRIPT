ui_col(SCR); dg_r(dg_px0, dg_py0, dg_pw, dg_pw);
dg_i = 0; loop(8, ui_col(GRID); dg_r(dg_px0 + 10 + dg_i * (dg_pw - 20) / 7, dg_ay, 1, dg_ah); dg_i += 1; );
dg_i = 0; loop(5, ui_cola(GRID, dg_i == 0 || dg_i == 4 ? 1 : 0.7); dg_r(dg_px0 + 1, dg_ay + dg_i * dg_ah / 4, dg_pw - 2, 1); dg_i += 1; );
