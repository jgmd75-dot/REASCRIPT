in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-devil";                                   // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
DVDEF = 1000; DVTMP = 1200;                                // the Init values; the preset parser's scratch (panel only)
DVHN = 1500; DVHV = 1600;                                  // the keys held, in the order played, and their velocities
DVVW = 1700;                                               // the vowels: 8 x 8 (F1 - F4, B1 - B4, Hz)
DVRG = 1800;                                               // the organ registrations: 6 x 9 drawbars (0 - 8)
DVRW = 1900;                                               // the registration now: 9 drawbar amplitudes (normalised)
DVWH = 2000; DVWHN = 256;                                  // the waver's path (for the panel): 256 points
DVXH = 2300; DVYH = 2600; DVXHN = 256;                     // the XY point's path (for the panel)
DVSX = 4000; DVSY = 8200; DVSN = 4096; DVSM = 4095;        // the scope: the sub and the mid drone (every 2nd sample)
DVDL = 100000; DVDR = 362144; DVDN = 262144; DVDM = 262143;   // the tape delay's lines
DVPD = 640000; DVPDM = 16383;                              // the reverb's pre-delay
DVAP = 660000; DVAPN = 4096; DVAPM = 4095;                 // the reverb's four input all-passes
DVRV = 700000; DVRN = 16384; DVRM = 16383;                 // the reverb's eight lines
memset(DVHN, 0, 200); memset(DVWH, 0, 900); memset(DVSX, 0, 2 * 4200);
memset(DVDL, 0, 2 * DVDN); memset(DVPD, 0, 16384); memset(DVAP, 0, 4 * DVAPN); memset(DVRV, 0, 8 * DVRN);
TWOPI = 2 * $pi; TK = 16;                                  // the control tick: every 16 samples

// ---------- the vowels (Hz): F1 F2 F3 F4, B1 B2 B3 B4; X runs U - O - AW - A - UH - ER - E - I ----------
function dv_vw(i, a, b, c, d, e, f, g, h) local(q) ( q = DVVW + i * 8; q[0] = a; q[1] = b; q[2] = c; q[3] = d; q[4] = e; q[5] = f; q[6] = g; q[7] = h; );
dv_vw(0, 300,  870, 2240, 3300, 60,  90, 130, 200);        // U  (boot)
dv_vw(1, 450,  800, 2830, 3500, 70,  80, 140, 200);        // O  (hope)
dv_vw(2, 570,  840, 2410, 3400, 80,  90, 140, 200);        // AW (law: a dark, open throat)
dv_vw(3, 730, 1090, 2440, 3400, 90, 110, 150, 220);        // A  (father)
dv_vw(4, 640, 1190, 2390, 3400, 80, 100, 140, 210);        // UH (cut: the throat at rest)
dv_vw(5, 490, 1350, 1690, 3200, 80, 120, 130, 200);        // ER (bird: the growl, F2 and F3 drawn together)
dv_vw(6, 530, 1840, 2480, 3500, 60, 100, 140, 200);        // E  (bed)
dv_vw(7, 270, 2290, 3010, 3700, 60, 100, 150, 220);        // I  (beet)
// ---------- the organ registrations: drawbars 16', 5 1/3', 8', 4', 2 2/3', 2', 1 3/5', 1 1/3', 1' ----------
function dv_rg(i, a, b, c, d, e, f, g, h, k) local(q) ( q = DVRG + i * 9; q[0] = a; q[1] = b; q[2] = c; q[3] = d; q[4] = e; q[5] = f; q[6] = g; q[7] = h; q[8] = k; );
dv_rg(0, 8, 8, 8, 8, 8, 8, 8, 8, 8);                        // Full
dv_rg(1, 0, 0, 8, 4, 0, 0, 0, 0, 0);                        // Flutes
dv_rg(2, 8, 8, 8, 0, 0, 0, 0, 0, 0);                        // Gospel
dv_rg(3, 0, 0, 6, 8, 7, 6, 5, 4, 0);                        // Reed
dv_rg(4, 8, 0, 8, 0, 6, 0, 0, 0, 0);                        // Hollow
dv_rg(5, 0, 0, 6, 8, 0, 6, 0, 0, 8);                        // Bright

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#dv_def = "0 9 1 0 80 40 0 7 35 0.12 0 20 2 20 70 0 0 0 25 7 70 0 20 12 45 0.2 1 0 1 15 50 0 0 15 35 3 0.08 0 4 0.3 1 0 25 35 6 30 60 40 35 1 0.07 25 55 0 85 30 800 75 900 200 1500 40 1200 2500 35 15 65 0 0 20 35 1 0.15 70 45 70 1 110 0 30 60 1 1 450 6 45 40 30 45 1 75 65 55 50 -3 60 0 2 0 0 30 120 6000 -0.3 1 1";
function dv_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function dv_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
dv_nums(#dv_def, DVDEF);
#dv_pm = "Init|Brimstone Hymn|Chained Choir|Horned Organ|Sulphur Psalm|Furnace Breath|Inverted Chapel|Pandemonium|Obsidian Throne|Ninth Circle|Ashen Liturgy|Witching Hour";
dv_npre = 12;
function dv_pstr(p) (
  p == 2 ? "2:2 19:35 36:0 37:0.05 40:0.5 41:2 42:2 48:55 49:25 51:0.05 52:20 53:70 54:-3 56:300 59:2500 71:50 91:85 93:60 96:60" :
  p == 3 ? "20:3 37:0.12 40:0.25 41:0 48:15 49:80 50:2 51:0.11 52:40 53:85 54:-5 56:600 57:2000 58:85 59:3000 69:20 71:55 78:55 81:40 96:55.4" :
  p == 4 ? "15:55 20:12 31:30 40:0 42:0 43:50 48:30 49:0 50:0 55:50 56:5 59:250 64:6000 65:0 66:45 68:60 73:0.4 74:55 75:30 96:69.2" :
  p == 5 ? "8:18 10:0.07 11:2 12:40 13:1 20:6 33:35 34:40 36:1 38:1 39:4 40:1 78:7.3 79:1 81:55 86:55 88:60 96:62.9" :
  p == 6 ? "7:30 9:45 10:0.09 12:45 13:2 14:70 30:60 48:57 49:90 54:-7 61:3000 62:30 64:900 65:60 66:55 96:48.6" :
  p == 7 ? "20:24 25:60 31:40 36:2 38:1 39:2 40:2 41:2 42:4 48:85 49:15 53:40 70:45 86:55 89:50 91:90 92:40 96:60.4" :
  p == 8 ? "10:0.5 11:2 12:30 13:0 16:20 17:30 33:40 41:0 50:3 51:0.6 52:60 68:30 69:45 73:1.2 75:70 77:1 78:233 79:2 80:70 81:55 96:54.6" :
  p == 9 ? "2:4 5:90 6:0 9:20 20:7 23:40 36:4 37:0.03 40:0.7 48:0 49:70 54:-10 56:1200 59:4000 64:600 82:0 91:100 92:90 93:65 96:55.9" :
  p == 10 ? "15:50 20:11 32:40 36:4 38:1 39:5 40:3 44:85 48:100 49:100 51:0.03 52:15 53:90 68:35 73:0.05 74:90 91:100 92:20 93:70 96:71.2" :
  p == 11 ? "2:7 4:1 20:5 37:0.03 40:0.2 41:2 42:2 47:30 48:40 49:45 50:2 51:0.04 52:50 56:150 59:1800 93:65 96:57.8" :
  p == 12 ? "15:50 26:4 28:30 29:0 31:30 46:120 48:43 49:75 57:600 58:60 64:1800 65:50 70:40 85:4 86:60 88:50 96:78.9" :
  "";
);
function dv_pstr_au(p) (
  p == 2 ? "2:2 19:35 36:0 37:0.05 40:0.5 41:2 42:2 48:55 49:25 51:0.05 52:20 53:70 54:-3 56:300 59:2500 71:50 91:85 93:60 96:60" :
  p == 3 ? "20:3 37:0.12 40:0.25 41:0 48:15 49:80 50:2 51:0.11 52:40 53:85 54:-5 56:600 57:2000 58:85 59:3000 69:20 71:55 78:55 81:40 96:55.4" :
  p == 4 ? "15:55 20:12 31:30 40:0 42:0 43:50 48:30 49:0 50:0 55:50 56:5 59:250 64:6000 65:0 66:45 68:60 73:0.4 74:55 75:30 96:69.2" :
  p == 5 ? "8:18 10:0.07 11:2 12:40 13:1 20:6 33:35 34:40 36:1 38:1 39:4 40:1 78:7.3 79:1 81:55 86:55 88:60 96:62.9" :
  p == 6 ? "7:30 9:45 10:0.09 12:45 13:2 14:70 30:60 48:57 49:90 54:-7 61:3000 62:30 64:900 65:60 66:55 96:48.6" :
  p == 7 ? "20:24 25:60 31:40 36:2 38:1 39:2 40:2 41:2 42:4 48:85 49:15 53:40 70:45 86:55 89:50 91:90 92:40 96:60.4" :
  p == 8 ? "10:0.5 11:2 12:30 13:0 16:20 17:30 33:40 41:0 50:3 51:0.6 52:60 68:30 69:45 73:1.2 75:70 77:1 78:233 79:2 80:70 81:55 96:54.6" :
  p == 9 ? "2:4 5:90 6:0 9:20 20:7 23:40 36:4 37:0.03 40:0.7 48:0 49:70 54:-10 56:1200 59:4000 64:600 82:0 91:100 92:90 93:65 96:55.9" :
  p == 10 ? "15:50 20:11 32:40 36:4 38:1 39:5 40:3 44:85 48:100 49:100 51:0.03 52:15 53:90 68:35 73:0.05 74:90 91:100 92:20 93:70 96:71.2" :
  p == 11 ? "2:7 4:1 20:5 37:0.03 40:0.2 41:2 42:2 47:30 48:40 49:45 50:2 51:0.04 52:50 56:150 59:1800 93:65 96:57.8" :
  p == 12 ? "15:50 26:4 28:30 29:0 31:30 46:120 48:43 49:75 57:600 58:60 64:1800 65:50 70:40 85:4 86:60 88:50 96:78.9" :
  "";
);
function load_preset(p) local(n, i) (
  // PLAY, TRANSPORT, FATE, the MIDI channel, the bend range, the wheel and the output stage stay as they are
  // (a preset never starts the drones)
  i = 0; loop(106, (i < 93 || i == 94 || i == 95) && i != 0 ? slider(i + 1) = DVDEF[i]; i += 1; );
  n = dv_nums(dv_pstr(p), DVTMP);
  i = 0; loop(floor(n / 2), DVTMP[i * 2] >= 2 && DVTMP[i * 2] <= 105 ? slider(DVTMP[i * 2]) = DVTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(106, ui_auto(i); i += 1; );
  pr_cur = p; dv_panic = 1;
);
function load_preset_au(p) local(n, i) (
  // PLAY, TRANSPORT, FATE, the MIDI channel, the bend range, the wheel and the output stage stay as they are
  // (a preset never starts the drones)
  i = 0; loop(106, (i < 93 || i == 94 || i == 95) && i != 0 ? slider(i + 1) = DVDEF[i]; i += 1; );
  n = dv_nums_au(dv_pstr_au(p), DVTMP);
  i = 0; loop(floor(n / 2), DVTMP[i * 2] >= 2 && DVTMP[i * 2] <= 105 ? slider(DVTMP[i * 2]) = DVTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(106, ui_auto(i); i += 1; );
  pr_cur = p; dv_panic = 1;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(106, slider(i + 1) = DVDEF[i]; ui_auto(i + 1); i += 1; );
);

// ---------- small helpers ----------
function dv_wdiv(i) ( i == 0 ? 0.5 : i == 1 ? 1 : i == 2 ? 2 : i == 3 ? dv_bpb : i == 4 ? 2 * dv_bpb : i == 5 ? 4 * dv_bpb : i == 6 ? 8 * dv_bpb : 16 * dv_bpb; );
function dv_ddiv(i) ( i == 0 ? 0.25 : i == 1 ? 1 / 3 : i == 2 ? 0.5 : i == 3 ? 2 / 3 : i == 4 ? 0.75 : i == 5 ? 1 : i == 6 ? 1.5 :
                      i == 7 ? 2 : i == 8 ? 3 : dv_bpb; );
// the waver's shapes (p = 0 .. 1): CENTRE-UP-CENTRE, CENTRE-DOWN-CENTRE (0 .. +1 / -1 .. 0), UP/DOWN (a held trill with
// smooth turns), SINE, TRIANGLE (-1 .. +1)
function dv_wshape(p, s) local(q, g) (
  s == 0 ? 0.5 - 0.5 * cos(TWOPI * p) :
  s == 1 ? -0.5 + 0.5 * cos(TWOPI * p) :
  s == 2 ? ( g = p < 0.5 ? 1 : -1; q = p < 0.5 ? p : p - 0.5; g * (q < 0.12 ? -cos($pi * q / 0.12) : 1); ) :
  s == 3 ? sin(TWOPI * p) :
  ( p < 0.25 ? 4 * p : p < 0.75 ? 2 - 4 * p : 4 * p - 4 );
);
// a drone's LFO (at the tick): SINE, TRIANGLE, RANDOM (smooth: a new point each cycle, cosine-joined)
function dv_lfo(rate, shape) instance(ph, a, b) (
  ph += rate * TK / srate;
  ph >= 1 ? ( ph -= floor(ph); a = b; b = rand(2) - 1; );
  shape == 0 ? sin(TWOPI * ph) : shape == 1 ? ( ph < 0.25 ? 4 * ph : ph < 0.75 ? 2 - 4 * ph : 4 * ph - 4 ) :
  a + (b - a) * (0.5 - 0.5 * cos($pi * ph));
);
// a drawbar's band limit: full below 40 % of the rate, faded out by 45 %
function dv_bl(f) ( f < dv_f40 ? 1 : f < dv_f45 ? (dv_f45 - f) / (dv_f45 - dv_f40) : 0; );

// ---------- the four voices (each in its own namespace: dvv0, dvv1 organs; dvv2, dvv3 synths) ----------
function dv_vinit(t, s, p) instance(ty, st, lv, fe, fst, nt, pn, vel, vg, ph, inc, ck, f1, f2, f3, f4, f5, f6, f7, f8, l1, l2, la1, la2, la3, d1, d2, d3, d4, d5, d6, d7, d8, d9, so, gl, gr, age, gate, key, sus, wt) (
  ty = t; st = 0; lv = 0; fe = 0; fst = 0; nt = pn = 60; vel = 1; vg = 1; ph = rand(1); inc = 0.001; ck = 0;
  f1 = f2 = f3 = f4 = f5 = f6 = f7 = f8 = l1 = l2 = 0; la1 = 1; la2 = la3 = 0;
  d1 = d2 = d3 = d4 = d5 = d6 = d7 = d8 = d9 = 0; so = s; age = 0; gate = 0; key = -1; sus = 0; wt = 0;
  gl = cos((p + 1) * 0.25 * $pi); gr = sin((p + 1) * 0.25 * $pi);
);
function dv_vclr() instance(ty, st, lv, fe, fst, nt, pn, vel, vg, ph, inc, ck, f1, f2, f3, f4, f5, f6, f7, f8, l1, l2, la1, la2, la3, d1, d2, d3, d4, d5, d6, d7, d8, d9, so, gl, gr, age, gate, key, sus, wt) ( st = 0; lv = 0; fe = 0; fst = 0; f1 = f2 = f3 = f4 = f5 = f6 = f7 = f8 = l1 = l2 = 0; gate = 0; key = -1; sus = 0; ck = 0; );
// a note: legato (leg) glides to it without a new attack; otherwise the envelopes start again from where they are
function dv_vgo(n, v, leg) instance(ty, st, lv, fe, fst, nt, pn, vel, vg, ph, inc, ck, f1, f2, f3, f4, f5, f6, f7, f8, l1, l2, la1, la2, la3, d1, d2, d3, d4, d5, d6, d7, d8, d9, so, gl, gr, age, gate, key, sus, wt) (
  key = n; gate = 1; sus = 0; age = dv_age; dv_age += 1;
  leg && st > 0 && st < 3 ? nt = n : (
    nt = n; (dv_glms < 1 || st == 0) ? pn = n;
    vel = v; vg = 1 - dv_vsens + dv_vsens * v ^ 1.4;
    st = 1; fst = 1; ck = 1;
  );
);
function dv_vrel() instance(ty, st, lv, fe, fst, nt, pn, vel, vg, ph, inc, ck, f1, f2, f3, f4, f5, f6, f7, f8, l1, l2, la1, la2, la3, d1, d2, d3, d4, d5, d6, d7, d8, d9, so, gl, gr, age, gate, key, sus, wt) ( gate = 0; sus = 0; st > 0 && st < 3 ? st = 3; fst > 0 && fst < 3 ? fst = 3; );
// at the tick: glide, pitch, the drawbars' band limits, the FILTER envelope, the low-pass
function dv_vtk() instance(ty, st, lv, fe, fst, nt, pn, vel, vg, ph, inc, ck, f1, f2, f3, f4, f5, f6, f7, f8, l1, l2, la1, la2, la3, d1, d2, d3, d4, d5, d6, d7, d8, d9, so, gl, gr, age, gate, key, sus, wt) local(f, b, g, fc) (
  dv_glms >= 1 ? pn += (nt - pn) * dv_glk : pn = nt;
  f = 440 * 2 ^ ((pn + dv_bend + so - 69) / 12) * ins_pitch;
  inc = min(f, srate * 0.45) / srate;
  ty < 2 ? (
    b = f * 0.5;
    d1 = DVRW[0] * dv_bl(b); d3 = DVRW[1] * dv_bl(b * 3); d2 = DVRW[2] * dv_bl(b * 2); d4 = DVRW[3] * dv_bl(b * 4);
    d5 = DVRW[4] * dv_bl(b * 6); d6 = DVRW[5] * dv_bl(b * 8); d7 = DVRW[6] * dv_bl(b * 10); d8 = DVRW[7] * dv_bl(b * 12);
    d9 = DVRW[8] * dv_bl(b * 16);
  );
  fst == 1 ? ( fe += (1.3 - fe) * dv_fac; fe >= 1 ? ( fe = 1; fst = 2; ); ) :
  fst == 2 ? ( fe += (dv_fsu - fe) * dv_fdc; ) :
  fst == 3 ? ( fe -= fe * dv_frc; fe < 0.00001 ? ( fe = 0; fst = 0; ); );
  fc = min(max(dv_cutn * 2 ^ (dv_fevn * 6 * fe + (pn - 60) / 24 + ins_cut * 0.3), 30), dv_fmax);
  g = tan($pi * fc / srate); la1 = 1 / (1 + g * (g + 1.2)); la2 = g * la1; la3 = g * la2;
  wt = ty < 2 ? dv_wo : dv_ws;
  abs(f1) + abs(f2) + abs(f3) + abs(f4) + abs(f5) + abs(f6) + abs(f7) + abs(f8) + abs(l1) + abs(l2) < 0.000000000001 ?
    f1 = f2 = f3 = f4 = f5 = f6 = f7 = f8 = l1 = l2 = 0;
);
// a sample: the AMP envelope, the source (drawbars / saw / pulse), four formants in cascade, the low-pass
function dv_vrun() instance(ty, st, lv, fe, fst, nt, pn, vel, vg, ph, inc, ck, f1, f2, f3, f4, f5, f6, f7, f8, l1, l2, la1, la2, la3, d1, d2, d3, d4, d5, d6, d7, d8, d9, so, gl, gr, age, gate, key, sus, wt) local(y, t, a, c, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16, v1, v2, v3) (
  st == 1 ? ( lv += (1.3 - lv) * dv_aac; lv >= 1 ? ( lv = 1; st = 2; ); ) :
  st == 2 ? ( lv += (dv_asu - lv) * dv_adc; ) :
  ( lv -= lv * dv_arc; lv < 0.00002 ? ( lv = 0; st = 0; ); );
  ty < 2 ? (
    // the tonewheels: every drawbar a harmonic of the 16' (sin(k a) by the Chebyshev recurrence: one sin, one cos)
    ph += inc * 0.5; ph -= floor(ph); a = TWOPI * ph; s1 = sin(a); c = 2 * cos(a);
    s2 = c * s1; s3 = c * s2 - s1; s4 = c * s3 - s2; s5 = c * s4 - s3; s6 = c * s5 - s4; s7 = c * s6 - s5; s8 = c * s7 - s6;
    s9 = c * s8 - s7; s10 = c * s9 - s8; s11 = c * s10 - s9; s12 = c * s11 - s10; s13 = c * s12 - s11; s14 = c * s13 - s12;
    s15 = c * s14 - s13; s16 = c * s15 - s14;
    y = d1 * s1 + d2 * s2 + d3 * s3 + d4 * s4 + d5 * s6 + d6 * s8 + d7 * s10 + d8 * s12 + d9 * s16;
    ck > 0.0005 ? ( y += ck * dv_ckg * (rand(2) - 1); ck *= dv_ckd; );
  ) : ty == 2 ? (
    ph += inc; ph -= floor(ph); y = (2 * ph - 1 - vo_blep(ph, inc)) * 0.5;
  ) : (
    ph += inc; ph -= floor(ph); t = ph + 1 - dv_pw; t -= floor(t);
    y = (2 * ph - 1 - vo_blep(ph, inc) - (2 * t - 1 - vo_blep(t, inc))) * 0.5;
  );
  // the vocal tract: four resonances in cascade (each a peak over the throughput)
  t = y;
  v3 = t - f2; v1 = dv_q1a * f1 + dv_q1b * v3; v2 = f2 + dv_q1b * f1 + dv_q1c * v3; f1 = 2 * v1 - f1; f2 = 2 * v2 - f2; t += dv_q1g * v1;
  v3 = t - f4; v1 = dv_q2a * f3 + dv_q2b * v3; v2 = f4 + dv_q2b * f3 + dv_q2c * v3; f3 = 2 * v1 - f3; f4 = 2 * v2 - f4; t += dv_q2g * v1;
  v3 = t - f6; v1 = dv_q3a * f5 + dv_q3b * v3; v2 = f6 + dv_q3b * f5 + dv_q3c * v3; f5 = 2 * v1 - f5; f6 = 2 * v2 - f6; t += dv_q3g * v1;
  v3 = t - f8; v1 = dv_q4a * f7 + dv_q4b * v3; v2 = f8 + dv_q4b * f7 + dv_q4c * v3; f7 = 2 * v1 - f7; f8 = 2 * v2 - f8; t += dv_q4g * v1;
  y = y * dv_fdry + t * dv_fwet;
  // the low-pass (CUTOFF and the FILTER envelope)
  v3 = y - l2; v1 = la1 * l1 + la2 * v3; v2 = l2 + la2 * l1 + la3 * v3; l1 = 2 * v1 - l1; l2 = 2 * v2 - l2;
  v2 * lv * vg * wt;
);
// dispatch by number
function dv_von(i, n, v, leg) ( i == 0 ? dvv0.dv_vgo(n, v, leg) : i == 1 ? dvv1.dv_vgo(n, v, leg) : i == 2 ? dvv2.dv_vgo(n, v, leg) : dvv3.dv_vgo(n, v, leg); );
function dv_voff(i) ( i == 0 ? dvv0.dv_vrel() : i == 1 ? dvv1.dv_vrel() : i == 2 ? dvv2.dv_vrel() : dvv3.dv_vrel(); );
function dv_vgt(i) ( i == 0 ? dvv0.gate : i == 1 ? dvv1.gate : i == 2 ? dvv2.gate : dvv3.gate; );
function dv_vky(i) ( i == 0 ? dvv0.key : i == 1 ? dvv1.key : i == 2 ? dvv2.key : dvv3.key; );
function dv_vag(i) ( i == 0 ? dvv0.age : i == 1 ? dvv1.age : i == 2 ? dvv2.age : dvv3.age; );
function dv_vlv(i) ( i == 0 ? dvv0.lv : i == 1 ? dvv1.lv : i == 2 ? dvv2.lv : dvv3.lv; );
function dv_vsu(i) ( i == 0 ? dvv0.sus : i == 1 ? dvv1.sus : i == 2 ? dvv2.sus : dvv3.sus; );
function dv_vss(i) ( i == 0 ? dvv0.sus = 1 : i == 1 ? dvv1.sus = 1 : i == 2 ? dvv2.sus = 1 : dvv3.sus = 1; );
function dv_vst(i) ( i == 0 ? dvv0.st : i == 1 ? dvv1.st : i == 2 ? dvv2.st : dvv3.st; );
// the keys held, in the order played
function dv_hdel(n) local(i, j) ( i = 0; j = 0; loop(dv_nh, DVHN[i] != n ? ( DVHN[j] = DVHN[i]; DVHV[j] = DVHV[i]; j += 1; ); i += 1; ); dv_nh = j; );
function dv_hadd(n, v) ( dv_hdel(n); dv_nh < 64 ? ( DVHN[dv_nh] = n; DVHV[dv_nh] = v; dv_nh += 1; ); );
function dv_sounding(n) local(i, r) ( r = 0; i = 0; loop(4, dv_vgt(i) && dv_vky(i) == n ? r = 1; i += 1; ); r; );
// a key goes down
function dv_non(n, v) local(i, pick, b) (
  dv_hadd(n, v);
  dv_mode == 2 ? (
    b = dvv0.gate || dvv1.gate || dvv2.gate || dvv3.gate;   // LAYER: one note plays all four (legato while held)
    i = 0; loop(4, dv_von(i, n, v, b); i += 1; );
  ) : dv_mode == 0 ? (
    dv_von(dv_rr, n, v, 0); dv_rr = (dv_rr + 1) % 4;      // ROTATE: each note to the next voice in turn
  ) : (
    pick = -1; b = 10; i = 0;                              // LAST NOTE: a free voice (the quietest), else the oldest
    loop(4, !dv_vgt(i) && dv_vlv(i) < b ? ( b = dv_vlv(i); pick = i; ); i += 1; );
    pick < 0 ? ( b = 1000000000; i = 0; loop(4, dv_vag(i) < b ? ( b = dv_vag(i); pick = i; ); i += 1; ); );
    dv_von(pick, n, v, 0);
  );
);
// a key comes up
function dv_noff(n) local(i, k, m, j) (
  dv_hdel(n);
  dv_mode == 2 ? (
    dvv0.key == n ? (
      dv_nh > 0 ? ( i = 0; loop(4, dv_von(i, DVHN[dv_nh - 1], DVHV[dv_nh - 1], 1); i += 1; ); ) :
      dv_ped ? ( i = 0; loop(4, dv_vss(i); i += 1; ); ) : ( i = 0; loop(4, dv_voff(i); i += 1; ); );
    );
  ) : (
    i = 0;
    loop(4,
      dv_vgt(i) && dv_vky(i) == n ? (
        m = -1;
        dv_mode == 1 ? ( k = dv_nh - 1; while (k >= 0 && m < 0) ( !dv_sounding(DVHN[k]) ? m = k; k -= 1; ); );
        m >= 0 ? dv_von(i, DVHN[m], DVHV[m], 1) : dv_ped ? dv_vss(i) : dv_voff(i);
      );
      i += 1;
    );
  );
);
function dv_alloff() local(i) ( i = 0; loop(4, dv_voff(i); i += 1; ); dv_nh = 0; );

// ---------- parameters ----------
function dv_update() local(t, i, s, q) (
  dv_tmp = tempo > 0 ? tempo : 120;
  dv_bpb = (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  dv_play = slider1 >= 0.5; dv_pc = floor(slider2 + 0.5); dv_oct = floor(slider3 + 0.5); dv_fol = slider4 >= 0.5;
  // SUB and MID: osc / sub-octave / octave-up levels, detune, tone, LFO, drive, level, sends
  dv_sog = slider5 / 100; dv_ssg = slider6 / 100; dv_sug = slider7 / 100; dv_sdet = slider8; dv_stone = slider9 / 100;
  dv_slr = slider10; dv_sls = floor(slider11 + 0.5); dv_sld = slider12 / 100; dv_slt = floor(slider13 + 0.5);
  dv_sdrv = slider14 / 100; dv_slev = sqr(slider15 / 100);
  dv_ss1 = slider16 / 100; dv_ss2 = slider17 / 100; dv_ss3 = slider18 / 100; dv_ss4 = slider19 / 100;
  dv_ivl = floor(slider20 + 0.5);
  dv_mog = slider21 / 100; dv_msg = slider22 / 100; dv_mug = slider23 / 100; dv_mdet = slider24; dv_mtone = slider25 / 100;
  dv_mlr = slider26; dv_mls = floor(slider27 + 0.5); dv_mld = slider28 / 100; dv_mlt = floor(slider29 + 0.5);
  dv_mdrv = slider30 / 100; dv_mlev = sqr(slider31 / 100);
  dv_ms1 = slider32 / 100; dv_ms2 = slider33 / 100; dv_ms3 = slider34 / 100; dv_ms4 = slider35 / 100;
  // WAVER
  dv_wsh = floor(slider36 + 0.5); dv_wrate = slider37; dv_wsync = slider38 >= 0.5; dv_wdb = dv_wdiv(floor(slider39 + 0.5));
  dv_wdep = slider40;
  // VOICES
  dv_mode = floor(slider41 + 0.5);
  t = floor(slider42 + 0.5);
  t !== dv_reg ? (
    dv_reg = t; s = 0; i = 0;
    loop(9, q = DVRG[t * 9 + i]; DVRW[i] = q > 0 ? 10 ^ (-3 * (8 - q) / 20) : 0; s += sqr(DVRW[i]); i += 1; );
    s = 0.55 / sqrt(max(s, 0.01)); i = 0; loop(9, DVRW[i] *= s; i += 1; );
  );
  dv_ckg = 0.35 * slider43 / 100; dv_pw = 0.5 - 0.45 * slider44 / 100; dv_spr = slider45 / 100;
  dvv0.so = -0.5 * dv_spr; dvv1.so = 0.5 * dv_spr; dvv2.so = dv_spr; dvv3.so = -dv_spr;
  dv_glms = slider46; dv_glk = 1 - exp(-TK / (max(dv_glms, 1) * 0.001 * srate) * 2.3);
  dv_vsens = slider47 / 100;
  dv_xt = slider48 / 100; dv_yt = slider49 / 100;
  dv_xyl = floor(slider50 + 0.5); dv_xyr = slider51; dv_xysz = slider52 / 100;
  dv_freso = slider53 / 100; dv_fsh = slider54; dv_famt = slider55 / 100;
  dv_aac = vo_coef(max(slider56, 1) * 0.6); dv_adc = vo_coef(slider57); dv_asu = slider58 / 100; dv_arc = vo_coef(slider59);
  dv_fac = 1 - exp(-TK * 4.6 / (max(slider60, 1) * 0.0006 * srate)); dv_fdc = 1 - exp(-TK * 4.6 / (slider61 * 0.001 * srate));
  dv_fsu = slider62 / 100; dv_frc = 1 - exp(-TK * 4.6 / (slider63 * 0.001 * srate));
  dv_cut = slider64; dv_fenv = slider65 / 100;
  dv_vdrv = slider66 / 100; dv_vlev = sqr(slider67 / 100);
  dv_vs1 = slider68 / 100; dv_vs2 = slider69 / 100; dv_vs3 = slider70 / 100; dv_vs4 = slider71 / 100;
  // FX
  dv_phin = slider72 >= 0.5; dv_phr = slider73; dv_phd = slider74 / 100; dv_phfb = slider75 / 100; dv_phm = slider76 / 100;
  dv_rgin = slider77 >= 0.5; dv_rgf = slider78; dv_rgw = floor(slider79 + 0.5); dv_rgd = slider80 / 100; dv_rgm = slider81 / 100;
  dv_dlin = slider82 >= 0.5;
  t = slider83 >= 0.5 ? dv_ddiv(floor(slider85 + 0.5)) * 60 / dv_tmp : slider84 * 0.001;
  dv_dtt = min(max(t * srate, 16), DVDN - 0.01 * srate - 8);
  dv_dfb = slider86 / 100; dv_dtc = 1 - exp(-TWOPI * min(600 * 2 ^ (slider87 / 100 * 4.5), srate * 0.45) / srate);
  dv_dwow = slider88 / 100; dv_dmix = slider89 / 100;
  dv_rvin = slider90 >= 0.5; dv_rsz = slider91 / 100; dv_rdark = slider92 / 100; dv_rmix = slider93 / 100;
  dv_rdmp = 1 - exp(-TWOPI * min(6500 * 2 ^ (-3.3 * dv_rdark), srate * 0.45) / srate);
  dv_rdec = 1.5 + 16 * dv_rsz ^ 1.6;                          // RT60 (s): 1.5 - 17.5
  t = srate / 1000 * (0.7 + 1.15 * dv_rsz);
  DVTMP[180] = min(37.1 * t, DVRN - 40); DVTMP[181] = min(41.3 * t, DVRN - 40); DVTMP[182] = min(47.9 * t, DVRN - 40);
  DVTMP[183] = min(53.3 * t, DVRN - 40); DVTMP[184] = min(59.7 * t, DVRN - 40); DVTMP[185] = min(67.1 * t, DVRN - 40);
  DVTMP[186] = min(73.9 * t, DVRN - 40); DVTMP[187] = min(81.7 * t, DVRN - 40);
  // MASTER
  dv_fa = slider94 / 50;                                     // FATE: 1 = the standard amount
  dv_volt = 10 ^ (slider95 / 20) * sqr(slider96 / 100) * 3.5; dv_chan = floor(slider97 + 0.5); dv_brng = slider98;
  dv_mwt = slider99 >= 0.5;
  ins_output_setup(100);   // output stage: CLIP, always on
);
function dv_clear() (
  memset(DVDL, 0, 2 * DVDN); memset(DVPD, 0, 16384); memset(DVAP, 0, 4 * DVAPN); memset(DVRV, 0, 8 * DVRN);
  dvv0.dv_vclr(); dvv1.dv_vclr(); dvv2.dv_vclr(); dvv3.dv_vclr();
  dv_s1 = dv_s2 = dv_m1l = dv_m2l = dv_m1r = dv_m2r = 0;
  dvkS.clp_reset(); dvkML.clp_reset(); dvkMR.clp_reset(); dvk0.clp_reset(); dvk1.clp_reset(); dvk2.clp_reset(); dvk3.clp_reset();
  dvkRL.clp_reset(); dvkRR.clp_reset();
  dvfS.clp_pf_reset(); dvfML.clp_pf_reset(); dvfMR.clp_pf_reset(); dvf0.clp_pf_reset(); dvf1.clp_pf_reset(); dvf2.clp_pf_reset(); dvf3.clp_pf_reset();
  dv_pha1 = dv_pha2 = dv_pha3 = dv_pha4 = dv_pha5 = dv_pha6 = dv_phb1 = dv_phb2 = dv_phb3 = dv_phb4 = dv_phb5 = dv_phb6 = dv_phfl = dv_phfr = 0;
  dv_dfl = dv_dfr = dv_dhl = dv_dhr = 0; dv_rsil = 0;
  dr0.z = dr1.z = dr2.z = dr3.z = dr4.z = dr5.z = dr6.z = dr7.z = 0;
  dv_dcxl = dv_dcxr = dv_dcyl = dv_dcyr = 0; dv_rgdx = dv_rgdy = dv_rgdl = dv_rgdr = 0;
  dv_dg = 0; dv_sgn = dv_mgn = 0; dv_nh = 0; dv_ped = 0;
);
// the reverb's lines
function dv_rl(base, n, gn, m) instance(z) local(rp, ri, f, d) (
  m != 0 ? ( rp = dv_rw - n - m; ri = floor(rp); f = rp - ri; d = base[ri & DVRM]; d += (base[(ri + 1) & DVRM] - d) * f; ) :
           d = base[(dv_rw - n) & DVRM];
  z += (d - z) * dv_rdmp;
  z * gn;
);
function dv_ap(base, n, x, k) instance(wp) local(d, v) (
  d = base[(wp - n) & DVAPM]; v = x + k * d; abs(v) < 0.000000000001 ? v = 0; base[wp] = v; wp = (wp + 1) & DVAPM;
  d - k * v;
);
// the formants: from the XY point's X (the vowel), THROAT (a shift) and RESONANCE; shared by the four voices
function dv_fmt(x, sh, r) local(i, fr, q0, q1, j, f, bw, k, g, a, b, c, gb, w) (
  x = min(max(x, 0), 1) * 7; i = min(floor(x), 6); fr = x - i; q0 = DVVW + i * 8; q1 = q0 + 8;
  j = 0;
  loop(4,
    f = exp(log(q0[j]) * (1 - fr) + log(q1[j]) * fr) * 2 ^ (sh / 12); f = min(f, dv_fmax);
    bw = (q0[j + 4] * (1 - fr) + q1[j + 4] * fr) * (1.7 - 1.2 * r) * (0.75 + 0.25 * 2 ^ (sh / 12));
    k = min(bw / f, 1.4); g = tan($pi * f / srate); a = 1 / (1 + g * (g + k)); b = g * a; c = g * b;
    w = j == 0 ? 1 : j == 1 ? 0.85 : j == 2 ? 0.6 : 0.4;
    gb = (0.6 + 5 * r) * w * k;
    j == 0 ? ( dv_q1a = a; dv_q1b = b; dv_q1c = c; dv_q1g = gb; ) : j == 1 ? ( dv_q2a = a; dv_q2b = b; dv_q2c = c; dv_q2g = gb; ) :
    j == 2 ? ( dv_q3a = a; dv_q3b = b; dv_q3c = c; dv_q3g = gb; ) : ( dv_q4a = a; dv_q4b = b; dv_q4c = c; dv_q4g = gb; );
    j += 1;
  );
  // (the cascade's peaks lift the level: a measured make-up)
  dv_fcmp = 1 / (1.15 + 2.13 * r - 1.46 * r * r);
);

function dv_srinit() (
  dv_sr = srate; ost_init(20000);
  dv_sk = 1 - exp(-TK / (0.02 * srate));                   // controls glide: about 20 ms
  dv_ek = 1 - exp(-TK / (0.12 * srate));                   // the effects in / out: 120 ms
  dv_rgk = 1 - exp(-TK / (0.15 * srate));                  // the root and the interval glide: 150 ms
  dv_wvk = 1 - exp(-TK / (0.012 * srate));                 // the waver, smoothed a touch (no steps)
  dv_gak = 1 - exp(-TK / (0.6 * srate)); dv_grk = 1 - exp(-TK / (1.2 * srate));   // the drones: swell in, die away
  dv_ckd = exp(-1 / (0.0035 * srate));                     // the organ's key click: 3.5 ms
  dv_sm = 1 - exp(-1 / (0.03 * srate));
  dv_dsk = 1 - exp(-1 / (0.35 * srate));                   // the delay time glides like tape
  dv_pcdn = 1 / (0.012 * srate); dv_pcup = 1 / (0.02 * srate);   // preset change: 12 ms out, 20 ms in
  dv_f40 = 0.4 * srate; dv_f45 = 0.45 * srate; dv_fmax = 0.42 * srate;
  dv_dhk = 1 - exp(-TWOPI * 60 / srate);                   // the delay's feedback high-pass
  DVTMP[190] = min(floor(4.77 * srate / 1000), DVAPN - 2); DVTMP[191] = min(floor(3.59 * srate / 1000), DVAPN - 2);
  DVTMP[192] = min(floor(12.73 * srate / 1000), DVAPN - 2); DVTMP[193] = min(floor(9.31 * srate / 1000), DVAPN - 2);
  dv_pdn = floor(0.022 * srate);
  dv_sck = 1 - exp(-TWOPI * 350 / srate);
  dv_pkd = exp(-1 / (0.25 * srate));                       // (the output meter's fall)
  dv_update();
  dv_first = 1; dv_fx0 = -1;
);

ins_drift_init();
dvT1.drift_init(0.8 + rand(0.5)); dvT2.drift_init(0.8 + rand(0.5)); dvT3.drift_init(0.8 + rand(0.5));
dvP1.drift_init(0.8 + rand(0.5)); dvP2.drift_init(0.8 + rand(0.5));
dvF1.drift_init(0.8 + rand(0.5)); dvF2.drift_init(0.8 + rand(0.5));
dvRX.drift_init(1); dvRY.drift_init(1.17); dvDW.drift_init(1);
dvv0.dv_vinit(0, 0, -0.35); dvv1.dv_vinit(1, 0, 0.25); dvv2.dv_vinit(2, 0, 0.35); dvv3.dv_vinit(3, 0, -0.25);
// the house drive: the KNEE clipper (anti-aliased), the drive-tracking pre-filter and knee
clp_kt_on = 1;
dvkS.clp_set(2, 1, 1, 0); dvkML.clp_set(2, 1, 1, 0); dvkMR.clp_set(2, 1, 1, 0);
dvk0.clp_set(2, 1, 1, 0); dvk1.clp_set(2, 1, 1, 0); dvk2.clp_set(2, 1, 1, 0); dvk3.clp_set(2, 1, 1, 0);
dvkS.clp_kt_cfg(0.3, 0.65); dvkML.clp_kt_cfg(0.3, 0.65); dvkMR.clp_kt_cfg(0.3, 0.65);
dvk0.clp_kt_cfg(0.3, 0.65); dvk1.clp_kt_cfg(0.3, 0.65); dvk2.clp_kt_cfg(0.3, 0.65); dvk3.clp_kt_cfg(0.3, 0.65);
dvfS.clp_pf_cfg(40000, 9000, -1.5, 150); dvfML.clp_pf_cfg(40000, 9000, -1.5, 150); dvfMR.clp_pf_cfg(40000, 9000, -1.5, 150);
dvf0.clp_pf_cfg(40000, 9000, -1.5, 150); dvf1.clp_pf_cfg(40000, 9000, -1.5, 150);
dvf2.clp_pf_cfg(40000, 9000, -1.5, 150); dvf3.clp_pf_cfg(40000, 9000, -1.5, 150);
dvkRL.clp_set(1, 1, 1, 0); dvkRR.clp_set(1, 1, 1, 0);       // the ring's drive: the SOFT curve
dv_age = 0; dv_rr = 0; dv_nh = 0; dv_ped = 0; dv_ct = TK - 1; dv_pcf = 0; dv_pcg = 1; dv_bend = dv_bendt = 0; dv_mw = dv_mwv = 0;
dv_sdg = dv_mdg = dv_vdg = dv_sdgt = dv_mdgt = dv_vdgt = dv_sdm = dv_mdm = dv_vdm = 1; dv_reg = -1; dv_bp = 0; dv_tpw = 0; dv_wph = 0; dv_wvs = 0; dv_xph = 0; dv_rw = 0; dv_dw = 0; dv_pw_ = 0;
dv_sn = dv_snt = 33; dv_mn = 52; dv_dg = 0; dv_heat = 0.5; dv_hd = 0; dv_lo = -1; dv_dts = -1;
dv_php = 0; dv_rph = 0; dv_dwp = 0; dv_dwf = 0; dv_scw = 0; dv_scd = 0; dv_hw = 0; dv_ht = 0;
dv_srinit();
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
dv_vol = dv_volt;
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
!dv_pcf && !dv_panic ? dv_update();

@block
prs_chk();
srate != dv_sr ? dv_srinit();
// a preset change: the old sound fades out (12 ms), everything is cleared at the silent point, then it fades in (20 ms)
dv_panic && !dv_pcf ? ( dv_pcf = 1; dv_panic = 0; );
dv_pcf == 2 ? ( dv_clear(); dv_first = 1; dv_pcf = 3; );
// TRANSPORT: while lit, REAPER's play (or record) presses PLAY and its stop releases it (the drones swell in and die
// away as by hand); PLAY still works by hand
dv_xp = play_state & 1;
slider106 >= 0.5 && dv_xp != dv_xpw ? ( slider1 = dv_xp; dv_play = dv_xp; ui_auto(1); );
dv_xpw = dv_xp;
dv_pcf != 1 ? dv_update();

// ---------- MIDI ----------
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, dv_chan) ? (
    dv_st = m1 & 0xF0;
    dv_st == 0x90 && m3 > 0 ? ( ins_midi_hit(); dv_non(m2, m3 / 127); ) :
    dv_st == 0x80 || (dv_st == 0x90 && m3 == 0) ? dv_noff(m2) :
    dv_st == 0xE0 ? dv_bendt = ((m3 * 128 + m2) - 8192) / 8192 :
    dv_st == 0xB0 ? (
      m2 == 1 ? dv_mwv = m3 / 127 :
      m2 == 64 ? (
        dv_ped = m3 >= 64;
        !dv_ped ? ( i_ = 0; loop(4, dv_vsu(i_) && dv_vgt(i_) ? dv_voff(i_); i_ += 1; ); );
      ) :
      (m2 == 120 || m2 == 123) ? dv_alloff();
    );
  );
  midisend(mofs, m1, m2, m3);
);
// FOLLOW: the lowest key held sets the root's pitch class (it stays when the keys are let go)
dv_nh > 0 ? ( dv_lo = 128; i_ = 0; loop(dv_nh, dv_lo = min(dv_lo, DVHN[i_]); i_ += 1; ); ) : dv_lo = -1;
dv_rpc = dv_fol && dv_lo >= 0 ? dv_lo % 12 : dv_fol && dv_rpc0 >= 0 ? dv_rpc0 : dv_pc;
dv_fol && dv_lo >= 0 ? dv_rpc0 = dv_lo % 12 : !dv_fol ? dv_rpc0 = -1;
dv_snt = 12 * (dv_oct + 1) + dv_rpc;

// ---------- the clock: REAPER's position while it plays, its own at the project tempo while stopped ----------
dv_dbp = dv_tmp / 60 / srate;
dv_tp = play_state & 1;
dv_tp ? dv_bp = beat_position;
dv_tpw = dv_tp;

// ---------- FATE: TEMPTATION, POSSESSION, FURNACE ----------
ins_drift_block(slider94 / 200, samplesblock);
dv_bi = samplesblock / srate;
dv_tpull = dvT1.drift_tick(0.025 * dv_bi) * 0.45 * dv_fa;           // the mid drone pulls away from the root (semitones)
dv_tdm = 2 ^ (dvT2.drift_tick(0.02 * dv_bi) * 0.6 * dv_fa);          // ... and its waver deepens / settles
dv_trm = 2 ^ (dvT3.drift_tick(0.03 * dv_bi) * 0.4 * dv_fa);          // ... quickens / slows
dv_px = dvP1.drift_tick(0.04 * dv_bi) * 0.14 * dv_fa;                // the XY point wanders: slow changes of vowel
dv_py = dvP2.drift_tick(0.035 * dv_bi) * 0.1 * dv_fa;
dv_heat = 0.5 + 0.5 * dvF1.drift_tick(0.006 * dv_bi);               // the furnace: heat builds and cools over minutes
dv_hd = dv_heat * 0.22 * dv_fa;
dv_hl = 1 + 0.15 * dv_fa * (dv_heat - 0.5) * 2;

// ---------- the drives (the house standard): DRIVE (with FURNACE's heat) to +30 dB into the knee, glided ----------
dv_t = min(dv_sdrv + dv_hd, 1); dv_g = 10 ^ (1.5 * dv_t);
dv_sdgt += (dv_g - dv_sdgt) * (1 - exp(-samplesblock / (0.03 * srate))); dv_sdgi = (dv_sdgt - dv_sdg) / samplesblock;
dv_sdmi = (1 / min(dv_sdgt, 2.86) - dv_sdm) / samplesblock;   // (gain and make-up ramp sample by sample)
dvfS.clp_pf_block(dv_t, srate, samplesblock); dv_k = dvkS.clp_kt_block(dv_t, srate, samplesblock); dvkS.clp_knee(dv_k);
dv_t = min(dv_mdrv + dv_hd * 0.7, 1); dv_g = 10 ^ (1.5 * dv_t);
dv_mdgt += (dv_g - dv_mdgt) * (1 - exp(-samplesblock / (0.03 * srate))); dv_mdgi = (dv_mdgt - dv_mdg) / samplesblock;
dv_mdmi = (1 / min(dv_mdgt, 2.86) - dv_mdm) / samplesblock;   // (gain and make-up ramp sample by sample)
dvfML.clp_pf_block(dv_t, srate, samplesblock); dvfMR.clp_pf_block(dv_t, srate, samplesblock);
dv_k = dvkML.clp_kt_block(dv_t, srate, samplesblock); dvkML.clp_knee(dv_k); dvkMR.clp_knee(dv_k);
dv_t = min(dv_vdrv + dv_hd * 0.4, 1); dv_g = 10 ^ (1.5 * dv_t);
dv_vdgt += (dv_g - dv_vdgt) * (1 - exp(-samplesblock / (0.03 * srate))); dv_vdgi = (dv_vdgt - dv_vdg) / samplesblock;
dv_vdmi = (1 / min(dv_vdgt, 2.86) - dv_vdm) / samplesblock;   // (gain and make-up ramp sample by sample)
dvf0.clp_pf_block(dv_t, srate, samplesblock); dvf1.clp_pf_block(dv_t, srate, samplesblock);
dvf2.clp_pf_block(dv_t, srate, samplesblock); dvf3.clp_pf_block(dv_t, srate, samplesblock);
dv_k = dvk0.clp_kt_block(dv_t, srate, samplesblock); dvk0.clp_knee(dv_k); dvk1.clp_knee(dv_k); dvk2.clp_knee(dv_k); dvk3.clp_knee(dv_k);
dvkS.clp_tidy(); dvkML.clp_tidy(); dvkMR.clp_tidy(); dvk0.clp_tidy(); dvk1.clp_tidy(); dvk2.clp_tidy(); dvk3.clp_tidy();
dvkRL.clp_tidy(); dvkRR.clp_tidy();
// the reverb switched fully out: its lines are emptied, so switching it back in starts clean
dv_rvg > 0.0001 ? dv_ract = 1 : dv_ract ? ( memset(DVRV, 0, 8 * DVRN); memset(DVAP, 0, 4 * DVAPN); dr0.z = dr1.z = dr2.z = dr3.z = dr4.z = dr5.z = dr6.z = dr7.z = 0; dv_ract = 0; );
dv_dlg > 0.0001 ? dv_dact = 1 : dv_dact ? ( memset(DVDL, 0, 2 * DVDN); dv_dfl = dv_dfr = dv_dhl = dv_dhr = 0; dv_dact = 0; );
// (no denormals)
abs(dv_s1) + abs(dv_s2) + abs(dv_m1l) + abs(dv_m2l) + abs(dv_m1r) + abs(dv_m2r) < 0.000000000001 ? dv_s1 = dv_s2 = dv_m1l = dv_m2l = dv_m1r = dv_m2r = 0;
abs(dv_dfl) + abs(dv_dfr) + abs(dv_dhl) + abs(dv_dhr) < 0.000000000001 ? dv_dfl = dv_dfr = dv_dhl = dv_dhr = 0;
abs(dv_dcyl) + abs(dv_dcyr) < 0.000000000001 ? dv_dcyl = dv_dcyr = 0;
abs(ostL.lz1) + abs(ostL.lz2) + abs(ostL.hz1) + abs(ostL.hz2) + abs(ostL.dcy) < 0.000000000001 ? ostL.lz1 = ostL.lz2 = ostL.hz1 = ostL.hz2 = ostL.dcy = 0;
abs(ostR.lz1) + abs(ostR.lz2) + abs(ostR.hz1) + abs(ostR.hz2) + abs(ostR.dcy) < 0.000000000001 ? ostR.lz1 = ostR.lz2 = ostR.hz1 = ostR.hz2 = ostR.dcy = 0;
abs(dv_phfl) + abs(dv_phfr) + abs(dv_pha1) + abs(dv_pha6) + abs(dv_phb1) + abs(dv_phb6) < 0.000000000001 ? (
  dv_pha1 = dv_pha2 = dv_pha3 = dv_pha4 = dv_pha5 = dv_pha6 = dv_phb1 = dv_phb2 = dv_phb3 = dv_phb4 = dv_phb5 = dv_phb6 = dv_phfl = dv_phfr = 0; );
abs(dv_rgdl) + abs(dv_rgdr) < 0.000000000001 ? dv_rgdl = dv_rgdr = dv_rgdx = dv_rgdy = 0;
// (for the panel: the waver's and the XY point's paths, every 30 ms)
dv_ht += samplesblock;
dv_ht >= 0.03 * srate ? (
  dv_ht = 0; DVWH[dv_hw] = dv_wvs; DVXH[dv_hw] = dv_ex; DVYH[dv_hw] = dv_ey; dv_hw = (dv_hw + 1) % DVWHN;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the control tick (every 16 samples) ----------
dv_ct += 1;
dv_ct >= TK ? (
  dv_ct = 0;
  dv_bp += dv_dbp * TK;
  dv_first ? ( dv_sn = dv_snt; dv_mnt = dv_snt + 12 + dv_ivl; dv_mn = dv_mnt; dv_vol = dv_volt; dv_xs = dv_xt; dv_ys = dv_yt; dv_dts = dv_dtt; dv_first = 0; );
  dv_bend += (dv_bendt * dv_brng - dv_bend) * dv_sk; dv_mw += (dv_mwv - dv_mw) * dv_sk;
  // ----- the drones' gate (PLAY) and their pitches: the root glides, the mid sits its interval above (an octave up) -----
  dv_dg += (dv_play - dv_dg) * (dv_play ? dv_gak : dv_grk); !dv_play && dv_dg < 0.000001 ? dv_dg = 0;
  dv_sn += (dv_snt - dv_sn) * dv_rgk;
  dv_mnt = dv_snt + 12 + dv_ivl; dv_mn += (dv_mnt - dv_mn) * dv_rgk;
  // the WAVER: free (RATE, quickened or slowed by TEMPTATION) or on the song's grid
  dv_wsync ? ( dv_wph = dv_bp / dv_wdb; dv_wph -= floor(dv_wph); ) : ( dv_wph += dv_wrate * dv_trm * TK / srate; dv_wph -= floor(dv_wph); );
  dv_t = min(dv_wdep * dv_tdm + (dv_mwt ? 0 : dv_mw * 6), 12);
  dv_wv = dv_wshape(dv_wph, dv_wsh) * dv_t; dv_wvs += (dv_wv - dv_wvs) * dv_wvk;
  // SUB
  dv_lf = dvLS.dv_lfo(dv_slr, dv_sls) * dv_sld;
  dv_f = 440 * 2 ^ ((dv_sn + (dv_slt == 0 ? dv_lf * 0.5 : 0) - 69) / 12);
  dv_si1 = dv_f * 2 ^ (dv_sdet / 2400) / srate; dv_si2 = dv_f * 2 ^ (-dv_sdet / 2400) / srate;
  dv_si3 = dv_f * 0.5 / srate; dv_si4 = min(dv_f * 2, dv_f45) / srate;
  dv_fc = min(max(55 * 2 ^ (dv_stone * 7.5 + (dv_slt == 2 ? dv_lf * 2 : 0) + 0.6 * dv_fa * (dv_heat - 0.5)), 25), dv_fmax);
  dv_g = tan($pi * dv_fc / srate); dv_sa1 = 1 / (1 + dv_g * (dv_g + 1.1)); dv_sa2 = dv_g * dv_sa1; dv_sa3 = dv_g * dv_sa2;
  dv_t = dv_slev * dv_hl * (dv_slt == 1 ? 1 - dv_sld * 0.5 + dv_lf * 0.5 : 1) * dv_dg;
  dv_sgn += (dv_t - dv_sgn) * dv_sk;
  // MID: TEMPTATION pulls its pitch away from the root and back; the WAVER sweeps it
  dv_lf = dvLM.dv_lfo(dv_mlr, dv_mls) * dv_mld;
  dv_mpn = dv_mn + dv_tpull + dv_wvs + (dv_mlt == 0 ? dv_lf * 0.5 : 0);
  dv_f = 440 * 2 ^ ((dv_mpn - 69) / 12);
  dv_mi1 = min(dv_f * 2 ^ (dv_mdet / 2400), dv_f45) / srate; dv_mi2 = min(dv_f * 2 ^ (-dv_mdet / 2400), dv_f45) / srate;
  dv_mi3 = dv_f * 0.5 / srate; dv_mi4 = min(dv_f * 2, dv_f45) / srate;
  dv_fc = min(max(90 * 2 ^ (dv_mtone * 7.5 + (dv_mlt == 2 ? dv_lf * 2 : 0)), 25), dv_fmax);
  dv_g = tan($pi * dv_fc / srate); dv_ma1 = 1 / (1 + dv_g * (dv_g + 1.1)); dv_ma2 = dv_g * dv_ma1; dv_ma3 = dv_g * dv_ma2;
  dv_t = dv_mlev * (dv_mlt == 1 ? 1 - dv_mld * 0.5 + dv_lf * 0.5 : 1) * dv_dg;
  dv_mgn += (dv_t - dv_mgn) * dv_sk;
  // ----- the XY point: the pad, its LFO (orbit / figure-8 / random walk), POSSESSION's wander -----
  dv_xs += (dv_xt - dv_xs) * dv_sk; dv_ys += (dv_yt - dv_ys) * dv_sk;
  dv_t = min(dv_xysz * 0.5 + (dv_mwt ? dv_mw * 0.5 : 0), 0.5);
  dv_xsz += ((dv_xyl ? dv_t : 0) - dv_xsz) * dv_sk;
  dv_xph += dv_xyr * TK / srate; dv_xph -= floor(dv_xph);
  dv_xyl == 1 ? ( dv_lx = cos(TWOPI * dv_xph); dv_ly = sin(TWOPI * dv_xph); ) :
  dv_xyl == 2 ? ( dv_lx = sin(TWOPI * dv_xph); dv_ly = 0.6 * sin(2 * TWOPI * dv_xph); ) :
  dv_xyl == 3 ? ( dv_lx = dvRX.drift_tick(dv_xyr * TK / srate * 2); dv_ly = dvRY.drift_tick(dv_xyr * TK / srate * 2); );
  dv_ex = min(max(dv_xs + dv_lx * dv_xsz + dv_px, 0), 1); dv_ey = min(max(dv_ys + dv_ly * dv_xsz + dv_py, 0), 1);
  // Y: the organs (bottom) against the synths (top), equal power; in ROTATE / LAST NOTE neither falls below 35 %
  dv_t = dv_mode == 2 ? 0 : 0.35;
  dv_wo = (dv_t + (1 - dv_t) * cos(dv_ey * 0.5 * $pi)) * (dv_mode == 2 ? 0.75 : 1);
  dv_ws = (dv_t + (1 - dv_t) * sin(dv_ey * 0.5 * $pi)) * (dv_mode == 2 ? 0.75 : 1);
  (dv_ex !== dv_fx0 || dv_fsh !== dv_fsh0 || dv_freso !== dv_fr0) ? ( dv_fmt(dv_ex, dv_fsh, dv_freso); dv_fx0 = dv_ex; dv_fsh0 = dv_fsh; dv_fr0 = dv_freso; );
  dv_fan += (dv_famt - dv_fan) * dv_sk; dv_fdry = 1 - dv_fan; dv_fwet = dv_fan * dv_fcmp;
  dv_cutn += (dv_cut - dv_cutn) * dv_sk; dv_fevn += (dv_fenv - dv_fevn) * dv_sk;   // CUTOFF and ENV glide (never step)
  dvv0.st ? dvv0.dv_vtk(); dvv1.st ? dvv1.dv_vtk(); dvv2.st ? dvv2.dv_vtk(); dvv3.st ? dvv3.dv_vtk();
  dv_vgn += (dv_vlev - dv_vgn) * dv_sk;
  // ----- the sends and the effects' gains -----
  dv_g1 += (dv_ss1 - dv_g1) * dv_sk; dv_g2 += (dv_ss2 - dv_g2) * dv_sk; dv_g3 += (dv_ss3 - dv_g3) * dv_sk; dv_g4 += (dv_ss4 - dv_g4) * dv_sk;
  dv_h1 += (dv_ms1 - dv_h1) * dv_sk; dv_h2 += (dv_ms2 - dv_h2) * dv_sk; dv_h3 += (dv_ms3 - dv_h3) * dv_sk; dv_h4 += (dv_ms4 - dv_h4) * dv_sk;
  dv_e1 += (dv_vs1 - dv_e1) * dv_sk; dv_e2 += (dv_vs2 - dv_e2) * dv_sk; dv_e3 += (dv_vs3 - dv_e3) * dv_sk; dv_e4 += (dv_vs4 - dv_e4) * dv_sk;
  dv_phg += (dv_phin * dv_phm - dv_phg) * dv_ek; dv_phg < 0.00001 && !dv_phin ? dv_phg = 0;
  dv_rgg += (dv_rgin * dv_rgm - dv_rgg) * dv_ek; dv_rgg < 0.00001 && !dv_rgin ? dv_rgg = 0;
  dv_dlg += (dv_dlin - dv_dlg) * dv_ek; dv_dlg < 0.00001 && !dv_dlin ? dv_dlg = 0;
  dv_rvg += (dv_rvin - dv_rvg) * dv_ek; dv_rvg < 0.00001 && !dv_rvin ? dv_rvg = 0;
  dv_dmn += (dv_dmix - dv_dmn) * dv_sk; dv_dfn += (dv_dfb - dv_dfn) * dv_sk; dv_rmn += (dv_rmix - dv_rmn) * dv_sk;
  dv_phfn += (dv_phfb - dv_phfn) * dv_sk; dv_rgdn += (dv_rgd - dv_rgdn) * dv_sk;
  // PHASER: six all-passes a side, the sweep log-spaced from 160 Hz up DEPTH x 5.5 octaves; the right side 90 degrees on
  dv_php += dv_phr * TK / srate; dv_php -= floor(dv_php);
  dv_t = 1 + 5.5 * dv_phd;
  dv_f = min(160 * 2 ^ (dv_t * (0.5 + 0.5 * sin(TWOPI * dv_php))), dv_fmax); dv_g = tan($pi * dv_f / srate); dv_pca = (dv_g - 1) / (dv_g + 1);
  dv_f = min(160 * 2 ^ (dv_t * (0.5 + 0.5 * cos(TWOPI * dv_php))), dv_fmax); dv_g = tan($pi * dv_f / srate); dv_pcb = (dv_g - 1) / (dv_g + 1);
  // ADP MOD: the carrier glides (log)
  dv_rgfn = dv_rgfn > 0 ? dv_rgfn * (dv_rgf / dv_rgfn) ^ dv_sk : dv_rgf; dv_rinc = min(dv_rgfn, dv_f40) / srate;
  dv_rgdg = 1 + 9 * dv_rgdn * dv_rgdn;                     // into the soft curve: up to +20 dB, made up to an even level
  dv_rgdm = 1 / (1 + 0.55 * (dv_rgdg - 1) ^ 0.75);
  // DELAY: the tape's wow (a slow swing and a little flutter, with a wander)
  dv_dwp += 0.55 * TK / srate; dv_dwp -= floor(dv_dwp); dv_dwf += 5.3 * TK / srate; dv_dwf -= floor(dv_dwf);
  dv_t = dv_dwow * 0.004 * srate;
  dv_dwd = dvDW.drift_tick(0.4 * TK / srate);
  dv_dml = dv_t * (1 + 0.7 * sin(TWOPI * dv_dwp) + 0.08 * sin(TWOPI * dv_dwf) + 0.3 * dv_dwd);
  dv_dmr = dv_t * (1 + 0.7 * cos(TWOPI * dv_dwp) + 0.08 * cos(TWOPI * dv_dwf) + 0.3 * dv_dwd);
  // REVERB: the lines' lengths glide, their gains follow the decay, two of them swim
  dv_n0 += (DVTMP[180] - dv_n0) * dv_sk * 0.1; dv_n1 += (DVTMP[181] - dv_n1) * dv_sk * 0.1; dv_n2 += (DVTMP[182] - dv_n2) * dv_sk * 0.1;
  dv_n3 += (DVTMP[183] - dv_n3) * dv_sk * 0.1; dv_n4 += (DVTMP[184] - dv_n4) * dv_sk * 0.1; dv_n5 += (DVTMP[185] - dv_n5) * dv_sk * 0.1;
  dv_n6 += (DVTMP[186] - dv_n6) * dv_sk * 0.1; dv_n7 += (DVTMP[187] - dv_n7) * dv_sk * 0.1;
  dv_t = -3 / (dv_rdec * srate);
  dv_rg0 = 10 ^ (dv_t * dv_n0); dv_rg1 = 10 ^ (dv_t * dv_n1); dv_rg2 = 10 ^ (dv_t * dv_n2); dv_rg3 = 10 ^ (dv_t * dv_n3);
  dv_rg4 = 10 ^ (dv_t * dv_n4); dv_rg5 = 10 ^ (dv_t * dv_n5); dv_rg6 = 10 ^ (dv_t * dv_n6); dv_rg7 = 10 ^ (dv_t * dv_n7);
  dv_i1 = floor(dv_n1); dv_i3 = floor(dv_n3); dv_i5 = floor(dv_n5); dv_i7 = floor(dv_n7);
  dv_rp1 += 0.23 * TK / srate; dv_rp1 -= floor(dv_rp1);
  dv_rm0 = 1 + 0.0009 * srate * (1 + sin(TWOPI * dv_rp1)); dv_rm1 = 1 + 0.0009 * srate * (1 + cos(TWOPI * dv_rp1));
);

dv_sdg += dv_sdgi; dv_sdm += dv_sdmi; dv_mdg += dv_mdgi; dv_mdm += dv_mdmi; dv_vdg += dv_vdgi; dv_vdm += dv_vdmi;
// ---------- the drones ----------
dv_dg > 0 ? (
  // SUB: a detuned saw pair, a square an octave down, a saw an octave up; TONE (low-pass); DRIVE
  dv_p1 += dv_si1; dv_p1 -= floor(dv_p1); dv_p2 += dv_si2; dv_p2 -= floor(dv_p2);
  dv_y = (2 * dv_p1 - 1 - vo_blep(dv_p1, dv_si1) + 2 * dv_p2 - 1 - vo_blep(dv_p2, dv_si2)) * 0.5 * dv_sog;
  dv_p3 += dv_si3; dv_p3 -= floor(dv_p3); dv_t = dv_p3 + 0.5; dv_t -= floor(dv_t);
  dv_y += (2 * dv_p3 - 1 - vo_blep(dv_p3, dv_si3) - (2 * dv_t - 1 - vo_blep(dv_t, dv_si3))) * 0.5 * dv_ssg;
  dv_p4 += dv_si4; dv_p4 -= floor(dv_p4); dv_y += (2 * dv_p4 - 1 - vo_blep(dv_p4, dv_si4)) * 0.4 * dv_sug;
  dv_v3 = dv_y - dv_s2; dv_v1 = dv_sa1 * dv_s1 + dv_sa2 * dv_v3; dv_v2 = dv_s2 + dv_sa2 * dv_s1 + dv_sa3 * dv_v3;
  dv_s1 = 2 * dv_v1 - dv_s1; dv_s2 = 2 * dv_v2 - dv_s2;
  dv_sub = dvkS.clp_run(dvfS.clp_pf_run(dv_v2 * 0.7) * dv_sdg) * dv_sdm * dv_sgn;
  // MID: the detuned pair split left / right (the octaves in both); TONE; DRIVE
  dv_q1 += dv_mi1; dv_q1 -= floor(dv_q1); dv_q2 += dv_mi2; dv_q2 -= floor(dv_q2);
  dv_q3 += dv_mi3; dv_q3 -= floor(dv_q3); dv_t = dv_q3 + 0.5; dv_t -= floor(dv_t);
  dv_q4 += dv_mi4; dv_q4 -= floor(dv_q4);
  dv_c = (2 * dv_q3 - 1 - vo_blep(dv_q3, dv_mi3) - (2 * dv_t - 1 - vo_blep(dv_t, dv_mi3))) * 0.5 * dv_msg
       + (2 * dv_q4 - 1 - vo_blep(dv_q4, dv_mi4)) * 0.4 * dv_mug;
  dv_yl = (2 * dv_q1 - 1 - vo_blep(dv_q1, dv_mi1)) * 0.5 * dv_mog + dv_c;
  dv_yr = (2 * dv_q2 - 1 - vo_blep(dv_q2, dv_mi2)) * 0.5 * dv_mog + dv_c;
  dv_v3 = dv_yl - dv_m2l; dv_v1 = dv_ma1 * dv_m1l + dv_ma2 * dv_v3; dv_v2 = dv_m2l + dv_ma2 * dv_m1l + dv_ma3 * dv_v3;
  dv_m1l = 2 * dv_v1 - dv_m1l; dv_m2l = 2 * dv_v2 - dv_m2l; dv_yl = dv_v2;
  dv_v3 = dv_yr - dv_m2r; dv_v1 = dv_ma1 * dv_m1r + dv_ma2 * dv_v3; dv_v2 = dv_m2r + dv_ma2 * dv_m1r + dv_ma3 * dv_v3;
  dv_m1r = 2 * dv_v1 - dv_m1r; dv_m2r = 2 * dv_v2 - dv_m2r; dv_yr = dv_v2;
  dv_midl = dvkML.clp_run(dvfML.clp_pf_run(dv_yl * 0.7) * dv_mdg) * dv_mdm * dv_mgn;
  dv_midr = dvkMR.clp_run(dvfMR.clp_pf_run(dv_yr * 0.7) * dv_mdg) * dv_mdm * dv_mgn;
) : ( dv_sub = dv_midl = dv_midr = 0; );
// (the scope: every second sample)
dv_scd = !dv_scd;
dv_scx += (dv_sub - dv_scx) * dv_sck; dv_scy += (dv_midl + dv_midr - dv_scy) * dv_sck;   // (smoothed: the figure, not the edges)
dv_scd ? ( DVSX[dv_scw] = dv_scx; DVSY[dv_scw] = dv_scy; dv_scw = (dv_scw + 1) & DVSM; );

// ---------- the four voices: each through the formants, then its own DRIVE ----------
dv_vl = dv_vr = 0;
dvv0.st ? ( dv_y = dvk0.clp_run(dvf0.clp_pf_run(dvv0.dv_vrun()) * dv_vdg) * dv_vdm; dv_vl += dv_y * dvv0.gl; dv_vr += dv_y * dvv0.gr; );
dvv1.st ? ( dv_y = dvk1.clp_run(dvf1.clp_pf_run(dvv1.dv_vrun()) * dv_vdg) * dv_vdm; dv_vl += dv_y * dvv1.gl; dv_vr += dv_y * dvv1.gr; );
dvv2.st ? ( dv_y = dvk2.clp_run(dvf2.clp_pf_run(dvv2.dv_vrun()) * dv_vdg) * dv_vdm; dv_vl += dv_y * dvv2.gl; dv_vr += dv_y * dvv2.gr; );
dvv3.st ? ( dv_y = dvk3.clp_run(dvf3.clp_pf_run(dvv3.dv_vrun()) * dv_vdg) * dv_vdm; dv_vl += dv_y * dvv3.gl; dv_vr += dv_y * dvv3.gr; );
dv_vl *= dv_vgn; dv_vr *= dv_vgn;

// ---------- the dry mix and the four sends ----------
dv_L = dv_sub + dv_midl + dv_vl; dv_R = dv_sub + dv_midr + dv_vr;

// PHASER (its return is the all-pass chain alone: against the dry sound it notches)
dv_phg > 0 ? (
  dv_x = dv_sub * dv_g1 + dv_midl * dv_h1 + dv_vl * dv_e1 + dv_phfl * dv_phfn;
  dv_y = dv_pca * dv_x + dv_pha1; dv_pha1 = dv_x - dv_pca * dv_y; dv_x = dv_y;
  dv_y = dv_pca * dv_x + dv_pha2; dv_pha2 = dv_x - dv_pca * dv_y; dv_x = dv_y;
  dv_y = dv_pca * dv_x + dv_pha3; dv_pha3 = dv_x - dv_pca * dv_y; dv_x = dv_y;
  dv_y = dv_pca * dv_x + dv_pha4; dv_pha4 = dv_x - dv_pca * dv_y; dv_x = dv_y;
  dv_y = dv_pca * dv_x + dv_pha5; dv_pha5 = dv_x - dv_pca * dv_y; dv_x = dv_y;
  dv_y = dv_pca * dv_x + dv_pha6; dv_pha6 = dv_x - dv_pca * dv_y; dv_phfl = vo_tanh(dv_y);
  dv_x = dv_sub * dv_g1 + dv_midr * dv_h1 + dv_vr * dv_e1 + dv_phfr * dv_phfn;
  dv_y = dv_pcb * dv_x + dv_phb1; dv_phb1 = dv_x - dv_pcb * dv_y; dv_x = dv_y;
  dv_y = dv_pcb * dv_x + dv_phb2; dv_phb2 = dv_x - dv_pcb * dv_y; dv_x = dv_y;
  dv_y = dv_pcb * dv_x + dv_phb3; dv_phb3 = dv_x - dv_pcb * dv_y; dv_x = dv_y;
  dv_y = dv_pcb * dv_x + dv_phb4; dv_phb4 = dv_x - dv_pcb * dv_y; dv_x = dv_y;
  dv_y = dv_pcb * dv_x + dv_phb5; dv_phb5 = dv_x - dv_pcb * dv_y; dv_x = dv_y;
  dv_y = dv_pcb * dv_x + dv_phb6; dv_phb6 = dv_x - dv_pcb * dv_y; dv_phfr = vo_tanh(dv_y);
  dv_pol = dv_phfl * dv_phg * (1 - 0.5 * dv_phfn); dv_por = dv_phfr * dv_phg * (1 - 0.5 * dv_phfn);
) : dv_pol = dv_por = 0;

// ADP MOD: the ring modulator (sine / triangle / band-limited square and saw), then its DRIVE (the soft curve, anti-aliased)
dv_rgg > 0 ? (
  dv_rph += dv_rinc; dv_rph -= floor(dv_rph);
  dv_c = dv_rgw == 0 ? sin(TWOPI * dv_rph) : dv_rgw == 1 ? ( dv_rph < 0.5 ? 4 * dv_rph - 1 : 3 - 4 * dv_rph ) :
         dv_rgw == 2 ? ( dv_t = dv_rph + 0.5; dv_t -= floor(dv_t); 2 * dv_rph - 1 - vo_blep(dv_rph, dv_rinc) - (2 * dv_t - 1 - vo_blep(dv_t, dv_rinc)) ) :
         0.8 * (2 * dv_rph - 1 - vo_blep(dv_rph, dv_rinc));
  dv_x = (dv_sub * dv_g2 + dv_midl * dv_h2 + dv_vl * dv_e2) * dv_c;
  dv_y = (dv_sub * dv_g2 + dv_midr * dv_h2 + dv_vr * dv_e2) * dv_c;
  // (DC out of it: a square carrier on a lopsided wave leaves some)
  dv_rgdl = dv_x - dv_rgdx + 0.9995 * dv_rgdl; dv_rgdx = dv_x; dv_rgdr = dv_y - dv_rgdy + 0.9995 * dv_rgdr; dv_rgdy = dv_y;
  dv_rol = dvkRL.clp_run(dv_rgdl * dv_rgdg) * dv_rgdm * dv_rgg * 1.4; dv_ror = dvkRR.clp_run(dv_rgdr * dv_rgdg) * dv_rgdm * dv_rgg * 1.4;
) : dv_rol = dv_ror = 0;

// TAPE DELAY: the time glides, wow swings it; the feedback through TONE, a 60 Hz high-pass and the tape's soft limit
dv_dlg > 0 ? (
  dv_dts += (dv_dtt - dv_dts) * dv_dsk;
  dv_rp = dv_dw - dv_dts - dv_dml; dv_ri = floor(dv_rp); dv_rf = dv_rp - dv_ri;
  dv_a = DVDL[dv_ri & DVDM]; dv_el = dv_a + (DVDL[(dv_ri + 1) & DVDM] - dv_a) * dv_rf;
  dv_rp = dv_dw - dv_dts - dv_dmr; dv_ri = floor(dv_rp); dv_rf = dv_rp - dv_ri;
  dv_a = DVDR[dv_ri & DVDM]; dv_er = dv_a + (DVDR[(dv_ri + 1) & DVDM] - dv_a) * dv_rf;
  dv_dfl += (dv_el - dv_dfl) * dv_dtc; dv_dfr += (dv_er - dv_dfr) * dv_dtc;
  dv_dhl += (dv_dfl - dv_dhl) * dv_dhk; dv_dhr += (dv_dfr - dv_dhr) * dv_dhk;
  dv_x = (dv_sub * dv_g3 + dv_midl * dv_h3 + dv_vl * dv_e3 + dv_pol * 0.5 + dv_rol * 0.5) * dv_dlg;
  dv_y = (dv_sub * dv_g3 + dv_midr * dv_h3 + dv_vr * dv_e3 + dv_por * 0.5 + dv_ror * 0.5) * dv_dlg;
  dv_a = dv_x + vo_tanh(dv_dfn * (dv_dfl - dv_dhl) * 1.1) / 1.1; DVDL[dv_dw] = abs(dv_a) < 0.000000000001 ? 0 : dv_a;
  dv_a = dv_y + vo_tanh(dv_dfn * (dv_dfr - dv_dhr) * 1.1) / 1.1; DVDR[dv_dw] = abs(dv_a) < 0.000000000001 ? 0 : dv_a;
  dv_dw = (dv_dw + 1) & DVDM;
  dv_dol = (dv_dfl * 0.4 + dv_el * 0.6) * dv_dmn; dv_dor = (dv_dfr * 0.4 + dv_er * 0.6) * dv_dmn;
) : dv_dol = dv_dor = 0;

// REVERB: pre-delay, four diffusers, eight long lines (Hadamard), dark; the delay's echoes feed it a little
dv_x = (dv_sub * dv_g4 + (dv_midl + dv_midr) * 0.5 * dv_h4 + (dv_vl + dv_vr) * 0.5 * dv_e4 + (dv_dol + dv_dor) * 0.15 + (dv_pol + dv_por + dv_rol + dv_ror) * 0.25) * dv_rvg;
DVPD[dv_pw_] = dv_x; dv_x = DVPD[(dv_pw_ - dv_pdn) & DVPDM]; dv_pw_ = (dv_pw_ + 1) & DVPDM;
dv_rvg > 0 && (dv_rsil < srate || abs(dv_x) > 0.000001) ? (
  dv_x = da0.dv_ap(DVAP, DVTMP[190], dv_x, 0.62); dv_x = da1.dv_ap(DVAP + DVAPN, DVTMP[191], dv_x, 0.62);
  dv_x = da2.dv_ap(DVAP + 2 * DVAPN, DVTMP[192], dv_x, 0.62); dv_x = da3.dv_ap(DVAP + 3 * DVAPN, DVTMP[193], dv_x, 0.62);
  dv_y0 = dr0.dv_rl(DVRV,            dv_n0, dv_rg0, dv_rm0);
  dv_y1 = dr1.dv_rl(DVRV + DVRN,     dv_i1, dv_rg1, 0);
  dv_y2 = dr2.dv_rl(DVRV + 2 * DVRN, dv_n2, dv_rg2, dv_rm1);
  dv_y3 = dr3.dv_rl(DVRV + 3 * DVRN, dv_i3, dv_rg3, 0);
  dv_y4 = dr4.dv_rl(DVRV + 4 * DVRN, dv_n4, dv_rg4, 1);
  dv_y5 = dr5.dv_rl(DVRV + 5 * DVRN, dv_i5, dv_rg5, 0);
  dv_y6 = dr6.dv_rl(DVRV + 6 * DVRN, dv_n6, dv_rg6, 1);
  dv_y7 = dr7.dv_rl(DVRV + 7 * DVRN, dv_i7, dv_rg7, 0);
  dv_a0 = dv_y0 + dv_y1; dv_a1 = dv_y0 - dv_y1; dv_a2 = dv_y2 + dv_y3; dv_a3 = dv_y2 - dv_y3;
  dv_a4 = dv_y4 + dv_y5; dv_a5 = dv_y4 - dv_y5; dv_a6 = dv_y6 + dv_y7; dv_a7 = dv_y6 - dv_y7;
  dv_b0 = dv_a0 + dv_a2; dv_b2 = dv_a0 - dv_a2; dv_b1 = dv_a1 + dv_a3; dv_b3 = dv_a1 - dv_a3;
  dv_b4 = dv_a4 + dv_a6; dv_b6 = dv_a4 - dv_a6; dv_b5 = dv_a5 + dv_a7; dv_b7 = dv_a5 - dv_a7;
  dv_ri = dv_rw & DVRM; dv_x *= 0.6;
  DVRV[dv_ri]            = (dv_b0 + dv_b4) * 0.35355339 + dv_x;
  DVRV[DVRN + dv_ri]     = (dv_b1 + dv_b5) * 0.35355339 - dv_x;
  DVRV[2 * DVRN + dv_ri] = (dv_b2 + dv_b6) * 0.35355339 + dv_x;
  DVRV[3 * DVRN + dv_ri] = (dv_b3 + dv_b7) * 0.35355339 - dv_x;
  DVRV[4 * DVRN + dv_ri] = (dv_b0 - dv_b4) * 0.35355339 + dv_x;
  DVRV[5 * DVRN + dv_ri] = (dv_b1 - dv_b5) * 0.35355339 - dv_x;
  DVRV[6 * DVRN + dv_ri] = (dv_b2 - dv_b6) * 0.35355339 + dv_x;
  DVRV[7 * DVRN + dv_ri] = (dv_b3 - dv_b7) * 0.35355339 - dv_x;
  dv_wl = (dv_y0 - dv_y2 + dv_y4 - dv_y6) * 0.5; dv_wr = (dv_y1 - dv_y3 + dv_y5 - dv_y7) * 0.5;
  abs(dv_x) + abs(dv_wl) + abs(dv_wr) < 0.000001 ? dv_rsil += 1 : dv_rsil = 0;
  dv_rol_ = dv_wl * dv_rmn * dv_rvg; dv_ror_ = dv_wr * dv_rmn * dv_rvg;
) : dv_rol_ = dv_ror_ = 0;
dv_rw = (dv_rw + 1) & DVRM;

dv_L += dv_pol + dv_rol + dv_dol + dv_rol_; dv_R += dv_por + dv_ror + dv_dor + dv_ror_;

// DC block
dv_dcyl = dv_L - dv_dcxl + 0.9997 * dv_dcyl; dv_dcxl = dv_L; dv_L = dv_dcyl;
dv_dcyr = dv_R - dv_dcxr + 0.9997 * dv_dcyr; dv_dcxr = dv_R; dv_R = dv_dcyr;

// ---------- MASTER ----------
dv_pcf == 1 ? ( dv_pcg -= dv_pcdn; dv_pcg <= 0 ? ( dv_pcg = 0; dv_pcf = 2; ); ) :
dv_pcf == 3 ? ( dv_pcg += dv_pcup; dv_pcg >= 1 ? ( dv_pcg = 1; dv_pcf = 0; ); );
dv_vol += (dv_volt - dv_vol) * dv_sm;
dv_L *= dv_pcg * dv_vol; dv_R *= dv_pcg * dv_vol;
dv_L = ostL.ost_band(dv_L); dv_R = ostR.ost_band(dv_R);
ost_out(dv_L, dv_R);
spl0 = ost_l; spl1 = ost_r;
dv_pk = max(dv_pk * dv_pkd, max(abs(spl0), abs(spl1)));

@gfx 1200 850
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_thm = 5; ui_hw = 1;
ui_begin(1200, 850);

// ---------- the card's colours: matte black anodised aluminium, razor-thin crimson etching, hazard-orange markings,
// the crimson-amber vector display ----------
FACE = 0x141518; FACEL = 0x2B2D32; TRAY = 0x1A1B1F; BLK = 0x0C0C0E; INK = 0x040405; LBL = 0xD2D4D9; DIM = 0x83868D;
CRM = 0xB0142A; CRMD = 0x4E0912; CRML = 0xFF3D50; HAZ = 0xFF6A13; HAZD = 0x7A3108;
AMB = 0xFF8A3A; AMBL = 0xFFD0A0; SCR = 0x0A0405; SCRH = 0x1E0B0E; GRID = 0x3A0A12;
KNB = 0x2F3135; KNBT = 0x3B3E43; KNBN = 0x222428; KEYOFF = 0x26272B; KEYHOV = 0x36383D; KEYON = 0xD01A30; KEYT = 0xD2D4D9;

// fonts, calibrated once per scale (a reference word fills the same width everywhere); large, for reading
sc != dg_calsc ? (
  dg_calsc = sc;
  dg_f11 = ui_fitfont(11, 13 * sc);         // key captions, small print
  dg_f12 = ui_fitfont(12, 15.5 * sc);       // section titles
  dg_f13 = ui_fitfont(13, 14.5 * sc);       // knob labels, values, fields
);
gfx_setfont(11, "Trebuchet MS", dg_f11, 'b'); gfx_setfont(12, "Trebuchet MS", dg_f12, 'b');
gfx_setfont(13, "Trebuchet MS", dg_f13, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');    // the card's name
gfx_setfont(15, "Georgia", 19 * sc, 'b');    // the numeral

// ---------- drawing helpers (base coordinates) ----------
function dg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function dg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function dg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function dg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function dg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function dg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function dg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function dg_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function dg_ln(x1, y1, x2, y2, w) ( dg_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function dg_l1(x1, y1, x2, y2) ( gfx_line(x1 * sc, y1 * sc, x2 * sc, y2 * sc, 1); );
function dg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function dg_ring(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); );
function dg_disc(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
// a wireframe star polygon (n points, step k), etched: purely decorative
function dg_star(cx, cy, r, n, k, a0) local(i, a, b) (
  i = 0; loop(n, a = a0 + i / n * 2 * $pi; b = a0 + ((i + k) % n) / n * 2 * $pi;
    dg_l1(cx + sin(a) * r, cy - cos(a) * r, cx + sin(b) * r, cy - cos(b) * r); i += 1; );
);
// hazard stripes (orange and black, diagonal) in a box
function dg_haz(x, y, w, h) local(i, n, a) (
  ui_col(INK); dg_r(x, y, w, h);
  ui_col(HAZ); n = floor((w + h) / 8);
  i = 0; loop(n, a = x + i * 8;
    gfx_triangle(min(max(a, x), x + w) * sc, y * sc, min(max(a + 4, x), x + w) * sc, y * sc,
                 min(max(a + 4 - h, x), x + w) * sc, (y + h) * sc, min(max(a - h, x), x + w) * sc, (y + h) * sc); i += 1; );
);
// a section: an ink frame, the matte tray, a black title band ruled in crimson, a hazard-orange mark
function dg_sect(x, y, w, h, title) (
  ui_col(INK); dg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  ui_col(TRAY); dg_r(x, y, w, h);
  ui_cola(0xFFFFFF, 0.05); dg_r(x, y + h - 1, w, 1); dg_r(x + w - 1, y + 25, 1, h - 25);
  ui_col(BLK); dg_r(x, y, w, 24);
  ui_col(CRM); dg_r(x, y + 24, w, 1);
  ui_col(HAZ); dg_r(x + 8, y + 7, 3, 10);
  strlen(title) ? ( gfx_setfont(12); ui_col(LBL); dg_t(x + 17, y + 3, title); );
);
function dg_cap(x, y, s) ( gfx_setfont(11); ui_col(DIM); dg_t(x, y, s); );
// the value pill (shown only while a control is touched)
function dg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 4 * sc, 3 * sc);
  ui_col(HAZ); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc + 1 * sc, tw + 12 * sc, th + 2 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);

// ---------- the knobs: heavy flat cast metal (a notched skirt, a flat top, a hazard-orange index); the value arc in
// crimson. cap: 1 = the black cap (a low-pass: the house colour code) ----------
function dg_kcap(cx, cy, r, n, bip, cap) local(rr, a, a0, ca, sa, w, i, b) (
  rr = r + 5 * sc; w = 2.6 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(0x0B0B0D); dg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  ui_col(CRM);
  bip ? ( abs(n - 0.5) > 0.004 ? dg_arcw(cx, cy, rr, min(a, 0), max(a, 0), w); ) :
        ( n > 0.004 ? ( dg_arcw(cx, cy, rr, a0, a, w); gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); ); );
  ui_cola(0x000000, 0.45); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(INK); gfx_circle(cx, cy, r, 1, 1);
  ui_col(KNB); gfx_circle(cx, cy, r - 1.2 * sc, 1, 1);
  // the cast skirt's grip notches (they turn with the knob)
  ui_col(KNBN); i = 0;
  loop(16, b = a + (i + 0.5) / 16 * 2 * $pi;
    gfx_circle(cx + sin(b) * (r - 1.2 * sc), cy - cos(b) * (r - 1.2 * sc), max(1.1 * sc, r * 0.07), 1, 1); i += 1; );
  ui_col(INK); gfx_circle(cx, cy, r * 0.74, 1, 1);
  ui_col(cap == 1 ? 0x0E0E10 : KNBT); gfx_circle(cx, cy, r * 0.71, 1, 1);
  ui_col(HAZ); dg_lnp(cx + ca * r * 0.1, cy + sa * r * 0.1, cx + ca * r * 0.66, cy + sa * r * 0.66, max(2.2 * sc, r * 0.11));
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps
function dg_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp, cap) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - dg_lt < 0.35 && dg_lid == idx && !dg_mv) || (mouse_cap & 4) ? ( dg_set(idx, def); drag_id = -1; dg_lt = 0; ) : (
      drag_id = did; dg_ky = mouse_y; dg_ky0 = mouse_y; dg_mv = 0; dg_lt = time_precise(); dg_lid = idx;
      dg_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !dg_mv && abs(mouse_y - dg_ky0) > 3 * sc ? ( dg_mv = 1; dg_ky = mouse_y; );
  drag_id == did && dg_mv ? (
    dg_kn = min(max(dg_kn + (dg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); dg_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ dg_kn : lo + dg_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? dg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    dg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  dg_kcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), lo < 0 && hi > 0, cap);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.1); gfx_circle(cx * sc, cy * sc, r * 0.71 * sc, 1, 1);
    sprintf(#dg_vv, fmt, v);
    dg_pill(cx, cy + r + 6, #dg_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(strlen(label) > 6 ? 11 : 13); ui_col(LBL); dg_tc(cx, cy + r + 14, label); );
  );
);
// ---------- lit keys (crimson = on); returns 1 when clicked ----------
function dg_key(x, y, w, h, on, s) local(hov, hit) (
  hov = dg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(CRML, 0.3); dg_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.4); dg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); dg_rr(x, y, w, h, 3);
  ui_col(on ? KEYON : hov ? KEYHOV : KEYOFF); dg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.35); dg_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.07); dg_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? 0xFFFFFF : KEYT); dg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function dg_keys(x, y, w, h, gap, idx, lo, n, labels) local(i) (
  i = 0;
  loop(n, dg_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == lo + i, pk_pitem(labels, i + 1, #dg_k)) ? dg_set(idx, lo + i); i += 1; );
);
function dg_toggle(x, y, w, h, idx, s) ( dg_key(x, y, w, h, slider(idx) >= 0.5, s) ? dg_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// ---------- the drop-down box: the setting in amber; a click opens the list (the current one ticked), the wheel steps ----------
function dg_dd(x, y, w, h, idx, lo, n, list, s) local(hov, i, k) (
  hov = dg_hov(x, y, w, h);
  ui_cola(0x000000, 0.35); dg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); dg_rr(x, y, w, h, 3);
  ui_col(hov ? SCRH : SCR); dg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(13); ui_col(AMB); dg_tc(x + (w - 12) * 0.5, y + h * 0.5, s);
  ui_col(CRM); gfx_triangle((x + w - 15) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 7) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 11) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1; strcpy(#dg_m, ""); i = 0; k = floor(slider(idx) + 0.5) - lo;
    loop(n, i == k ? strcat(#dg_m, "!"); strcat(#dg_m, pk_pitem(list, i + 1, #dg_k)); i < n - 1 ? strcat(#dg_m, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#dg_m); i > 0 ? dg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    dg_set(idx, min(max(floor(slider(idx) + 0.5) - sign(mouse_wheel), lo), lo + n - 1)); mouse_wheel = 0;
  );
);
function dg_nname(n) ( sprintf(#dg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #dg_k), floor(n / 12) - 1); #dg_nn; );
DG_IVL = "UNISON|MIN 2ND|MAJ 2ND|MIN 3RD|MAJ 3RD|4TH|TRITONE|5TH|MIN 6TH|MAJ 6TH|MIN 7TH|MAJ 7TH|OCTAVE|MIN 9TH|MAJ 9TH|MIN 10TH|MAJ 10TH|11TH|AUG 11TH|12TH|MIN 13TH|MAJ 13TH|MIN 14TH|MAJ 14TH|2 OCTAVES";
// a drone's panel (the sub's and the mid's are the same apart from the first row); b = its first osc slider
function dg_drone(y, b, mid) (
  dg_cap(266, y + 30, "LFO"); dg_cap(334, y + 30, "LFO TO");
  dg_dd(258, y + 46, 70, 26, b + 6, 0, 3, "Sine|Triangle|Random", pk_pitem("SINE|TRI|RANDOM", floor(slider(b + 6) + 0.5) + 1, #dg_k2));
  dg_dd(332, y + 46, 62, 26, b + 8, 0, 3, "Pitch|Level|Tone", pk_pitem("PITCH|LEVEL|TONE", floor(slider(b + 8) + 0.5) + 1, #dg_k2));
  dg_knob(62, y + 108, 17, b, 0, 100, mid ? 70 : 80, 0, "OSC", "%.0f%%", 0, 0);
  dg_knob(122, y + 108, 17, b + 1, 0, 100, mid ? 0 : 40, 0, "SUB -1", "%.0f%%", 0, 0);
  dg_knob(182, y + 108, 17, b + 2, 0, 100, mid ? 20 : 0, 0, "OCT +1", "%.0f%%", 0, 0);
  dg_knob(242, y + 108, 17, b + 3, 0, 50, mid ? 12 : 7, 0, "DETUNE", "%.1f cents", 0, 0);
  dg_knob(302, y + 108, 17, b + 4, 0, 100, mid ? 45 : 35, 0, "TONE", "%.0f%%", 0, 1);
  dg_knob(362, y + 108, 17, b + 9, 0, 100, mid ? 15 : 20, 0, "DRIVE", "%.0f%%", 0, 0);
  dg_knob(58, y + 172, 14, b + 5, 0.02, 10, mid ? 0.2 : 0.12, 1, "RATE", "%.2f Hz", 0, 0);
  dg_knob(110, y + 172, 14, b + 7, 0, 100, 0, 0, "DEPTH", "%.0f%%", 0, 0);
  dg_knob(162, y + 172, 14, b + 10, 0, 100, mid ? 50 : 70, 0, "LEVEL", "%.0f%%", 0, 0);
  ui_cola(CRM, 0.5); dg_r(189, y + 154, 1, 46);
  dg_knob(216, y + 172, 14, b + 11, 0, 100, 0, 0, "PHASER", "SEND %.0f%%", 0, 0);
  dg_knob(268, y + 172, 14, b + 12, 0, 100, 0, 0, "RING", "SEND %.0f%%", 0, 0);
  dg_knob(320, y + 172, 14, b + 13, 0, 100, mid ? 15 : 0, 0, "DELAY", "SEND %.0f%%", 0, 0);
  dg_knob(372, y + 172, 14, b + 14, 0, 100, mid ? 35 : 25, 0, "REVERB", "SEND %.0f%%", 0, 0);
);

// ======================== the faceplate: matte black anodised aluminium ========================
ui_col(FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); dg_rr(4, 4, 1192, 842, 9);
ui_col(FACEL); dg_rr(6.5, 6.5, 1187, 837, 7);
ui_col(INK); dg_r(11, 11, 1178, 828);
ui_col(FACE); dg_r(13, 13, 1174, 824);
// the etching: razor-thin crimson geometry in the gutters (decoration only: arcs round the display, a lattice at the edges)
ui_cola(CRM, 0.35);
dg_i = 0; loop(9, dg_l1(13, 64 + dg_i * 0.5, 1187, 64 + dg_i * 0.5); dg_i += 8; );
dg_i = 0; loop(24, dg_a = -0.5 * $pi + dg_i / 23 * $pi; dg_l1(17, 470 + dg_i * 6, 19, 470 + dg_i * 6); dg_l1(1181, 470 + dg_i * 6, 1183, 470 + dg_i * 6); dg_i += 1; );
ui_cola(CRM, 0.28); dg_l1(17, 70, 17, 760); dg_l1(1183, 70, 1183, 760);
ui_cola(CRM, 0.22); dg_l1(13, 608, 1187, 608); dg_l1(13, 765, 1187, 765);
// the header: black, ruled in crimson
ui_col(BLK); dg_r(13, 13, 1174, 44);
ui_col(CRM); dg_r(13, 57, 1174, 1.5);
ui_col(HAZ); dg_r(13, 58.5, 60, 2); dg_r(1127, 58.5, 60, 2);
// the numeral on its etched seal
ui_cola(CRM, 0.7); dg_ring(600, 35, 26); dg_star(600, 35, 26, 5, 2, $pi);
ui_cola(CRM, 0.45); dg_i = 0;
loop(3, gfx_arc(600 * sc, 35 * sc, (31 + dg_i * 4) * sc, 0.55 * $pi, 0.95 * $pi, 1); gfx_arc(600 * sc, 35 * sc, (31 + dg_i * 4) * sc, -0.95 * $pi, -0.55 * $pi, 1);
  gfx_arc(600 * sc, 35 * sc, (31 + dg_i * 4) * sc, 0.05 * $pi, 0.45 * $pi, 1); gfx_arc(600 * sc, 35 * sc, (31 + dg_i * 4) * sc, -0.45 * $pi, -0.05 * $pi, 1); dg_i += 1; );
ui_col(INK); dg_disc(600, 35, 20.5); ui_col(CRM); dg_ring(600, 35, 19.5); ui_col(0x1E1F23); dg_disc(600, 35, 18);
ui_cola(CRML, 0.5); dg_ring(600, 35, 15.5);
gfx_setfont(15); ui_col(HAZ); dg_tc(600, 35.5, "XV");
// presets
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
dg_k_ = pk_preset(22 * sc, 18 * sc, 330 * sc, 34 * sc, pr_cur, #dv_pm);
dg_k_ > 0 ? ( dg_k_ > dv_npre ? reset_all() : prs_dirty = dg_k_; );
gfx_setfont(12); ui_col(CRML); dg_t(366, 18, "INFERNAL DRONE"); ui_col(LBL); dg_t(366, 35, "FORMANT VOICES · ADP MOD");
// MIDI: activity and channel
pk_led(668 * sc, 35 * sc, 4.5 * sc, ins_midi_lit(), CRML);
gfx_setfont(11); ui_col(LBL); dg_tc(668, 21, "MIDI");
sprintf(#dg_g, slider97 < 0.5 ? "OMNI" : "CH %.0f", slider97);
dg_dd(684, 22, 86, 26, 97, 0, 17, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", #dg_g);
// the state of things
ui_col(INK); dg_rr(782, 22, 324, 26, 3); ui_col(SCR); dg_rr(783.5, 23.5, 321, 23, 2);
gfx_setfont(11); ui_col(AMB);
dg_nk = dv_nh;
sprintf(#dg_g, "ROOT %s  ·  %s  ·  %d KEY%s HELD", dg_nname(floor(dv_sn + 0.5)), slider1 >= 0.5 ? "DRONES BURNING" : "DRONES AT REST", dg_nk, dg_nk == 1 ? "" : "S");
dg_tc(944, 35, #dg_g);
ui_size_picker(1118 * sc, 26 * sc);

// ======================== SUB DRONE ========================
dg_sect(22, 68, 376, 214, "SUB DRONE");
dg_toggle(228, 70, 88, 20, 106, "TRANSPORT");
dg_toggle(324, 70, 66, 20, 1, "PLAY");
dg_cap(34, 98, "ROOT"); dg_cap(118, 98, "OCTAVE");
dg_dd(34, 114, 76, 26, 2, 0, 12, "C|C#|D|D#|E|F|F#|G|G#|A|A#|B", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", floor(slider2 + 0.5) + 1, #dg_k2));
sprintf(#dg_g, "%d", floor(slider3 + 0.5));
dg_dd(116, 114, 62, 26, 3, 0, 4, "0 (C0 - B0)|1 (C1 - B1)|2 (C2 - B2)|3 (C3 - B3)", #dg_g);
dg_toggle(184, 114, 66, 26, 4, "FOLLOW");
