desc:GFX MSAT [multiband saturation]
//tags: multiband saturation transient shaper stereo width analogue 1970s mastering mix bus
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui, gfx-panel and gfx-dyn (.jsfx-inc) in the same folder.
//
// MSAT. A three-band analogue saturation unit in the spirit of a mid-70s British design, with a transient
// shaper and stereo width on every band (the sound is designed from scratch).
//
// CHAIN  IN -> 3-band crossover -> per band: transient shaper -> saturation (parallel MIX) -> width -> sum -> OUT
//
//   CROSSOVER  Linkwitz-Riley, 24 dB / octave. LOW / MID 50 Hz - 1 kHz (250 Hz), MID / HIGH 1 - 12 kHz (4 kHz). The low
//          band is phase-aligned to the upper split (an allpass), so the three bands sum flat: with every band at its
//          defaults and DRIVE at 0, the unit measures flat (within 0.05 dB). The upper split never sits below the lower.
//   TRANSIENTS  per band (linked stereo): ATTACK -15 .. +15 dB (lifts or softens the start of each hit) and SUSTAIN
//          -15 .. +15 dB (lifts or tucks the tail), level-independent, with envelope times tuned per band (the lows
//          slower, the highs faster).
//   SATURATION  per band: DRIVE 0 .. 24 dB into a smooth discrete-transistor curve - warm 2nd (a small bias) and 3rd
//          harmonics that grow as it is pushed, peaks softened, level-compensated (DRIVE changes the colour, not the
//          level): about 1.5 % THD at 6 dB on a -12 dBFS tone, 5 % at 12 dB, thick at 24 dB; MIX 0 - 100 % (parallel:
//          the saturated band against the clean band, in phase).
//   SOLO / MUTE  per band (S / M): with any band soloed only the soloed bands play; M takes a band out. 4 ms fades.
//   WIDTH  per band: 0 % = mono, 100 % = as it was, 200 % = wide (the side doubled, the level kept steady).
//   VFD / MATRIX  the panel's look: VFD (dark green, light green, black) or MATRIX (battleship grey, elephant's
//          breath print, mustard amber, as KRT81's MATRIX). The look only: the sound is the same.
//   DRIFT  (0 - 100 %, 50 % = standard, 0 = none): "heat / bias" - each band warms with what it is fed (rising over
//          a couple of seconds, cooling over about six): its bias leans further (more 2nd) and its drive edges up
//          (to +1.5 dB), and each band's bias wanders slowly on its own. The panel's HEAT lamps show it.
//   INPUT  -12 .. +12 dB, OUTPUT -12 .. +12 dB. The house output stage passes straight through (a mix tool: no clip).
//   PRESETS  12 (Init + 11) plus Reset all to defaults. A preset sets the crossovers and the three bands; INPUT,
//          OUTPUT, VFD / MATRIX and DRIFT are left alone (Reset all restores them too).

slider1:0<-12,12,0.1>-Input (dB)
slider2:250<50,1000,1>-Low / mid crossover (Hz)
slider3:4000<1000,12000,10>-Mid / high crossover (Hz)
slider4:0<-15,15,0.1>-Low attack (dB)
slider5:0<-15,15,0.1>-Low sustain (dB)
slider6:6<0,24,0.1>-Low drive (dB)
slider7:100<0,100,1>-Low mix (%)
slider8:100<0,200,1>-Low width (%)
slider9:0<-15,15,0.1>-Mid attack (dB)
slider10:0<-15,15,0.1>-Mid sustain (dB)
slider11:6<0,24,0.1>-Mid drive (dB)
slider12:100<0,100,1>-Mid mix (%)
slider13:100<0,200,1>-Mid width (%)
slider14:0<-15,15,0.1>-High attack (dB)
slider15:0<-15,15,0.1>-High sustain (dB)
slider16:6<0,24,0.1>-High drive (dB)
slider17:100<0,100,1>-High mix (%)
slider18:100<0,200,1>-High width (%)
slider19:0<0,1,1{VFD,Matrix}>-Look
slider20:0<-12,12,0.1>-Output (dB)
slider21:50<0,100,1>-Drift (%)
slider22:0<0,1,1{Off,On}>-Low solo
slider23:0<0,1,1{Off,On}>-Low mute
slider24:0<0,1,1{Off,On}>-Mid solo
slider25:0<0,1,1{Off,On}>-Mid mute
slider26:0<0,1,1{Off,On}>-High solo
slider27:0<0,1,1{Off,On}>-High mute

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc

@init
#ui_man = "gfx-msat";                        // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- helpers ----------
function mt_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );                          // denormal housekeeping
function mt_tc(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );          // a follower coefficient from a time
// RBJ biquad coefficients (t 0: low-pass, 1: high-pass, 2: allpass), transposed direct form II
function bq_set(t, f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  t == 0 ? ( b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; ) :
  t == 1 ? ( b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; ) :
           ( b0 = (1 - al) / n; b1 = -2 * cw / n; b2 = 1; );
  a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, s1, s2) local(y) (
  y = b0 * x + s1; s1 = b1 * x - a1 * y + s2; s2 = b2 * x - a2 * y;
  y;
);
function bq_tidy() instance(s1, s2) ( s1 = mt_tn(s1); s2 = mt_tn(s2); );

// ---------- the saturation: a smooth transistor curve (C1 cubic, peaks reach 1 at 1.5 and stay), biased ----------
function mt_sc(v) ( v >= 1.5 ? 1 : v <= -1.5 ? -1 : v * (1 - 0.148148148 * v * v); );

// ---------- one channel's crossover: x -> lo, mi, hi (instance outputs) ----------
function xo_run(x) instance(lo, mi, hi) local(r) (
  lo = this.l2.bq_run(this.l1.bq_run(x));                              // LR4 low-pass at f1
  r = this.h2.bq_run(this.h1.bq_run(x));                               // LR4 high-pass at f1
  mi = this.m2.bq_run(this.m1.bq_run(r));                              // LR4 low-pass at f2
  hi = this.u2.bq_run(this.u1.bq_run(r));                              // LR4 high-pass at f2
  lo = this.ap.bq_run(lo);                                             // the low band through f2's allpass: the bands sum flat
);
function xo_cfg() (
  this.l1.bq_set(0, mt_f1, 0.70710678); this.l2.bq_set(0, mt_f1, 0.70710678);
  this.h1.bq_set(1, mt_f1, 0.70710678); this.h2.bq_set(1, mt_f1, 0.70710678);
  this.m1.bq_set(0, mt_f2, 0.70710678); this.m2.bq_set(0, mt_f2, 0.70710678);
  this.u1.bq_set(1, mt_f2, 0.70710678); this.u2.bq_set(1, mt_f2, 0.70710678);
  this.ap.bq_set(2, mt_f2, 0.70710678);
);
function xo_tidy() (
  this.l1.bq_tidy(); this.l2.bq_tidy(); this.h1.bq_tidy(); this.h2.bq_tidy();
  this.m1.bq_tidy(); this.m2.bq_tidy(); this.u1.bq_tidy(); this.u2.bq_tidy(); this.ap.bq_tidy();
);

// ---------- one band: transient detector (linked), gain, saturation, width ----------
// per band constants: kAf / kAs = the attack detector's fast / slow attack, kAr its release; kSr / kSf = the sustain
// detector's long / short release (fast attack); kg = the gain's smoothing
function bd_times(af, as, ar, sl, sf) instance(kAf, kAs, kAr, kSl, kSf, kg, kH1, kH2) (
  kAf = mt_tc(af); kAs = mt_tc(as); kAr = mt_tc(ar); kSl = mt_tc(sl); kSf = mt_tc(sf); kg = mt_tc(1);
  kH1 = 1 - exp(-1 / (2 * srate)); kH2 = 1 - exp(-1 / (6 * srate));     // heat: warms over ~2 s, cools over ~6 s
);
// set per block: attack / sustain (dB), drive, mix, width targets, the bias
function bd_set(at, su, dr, mx, wd, bi) instance(tA, tS, tD, tM, tW, bias, heat) (
  tA = at; tS = su; tD = 1.0 * 10 ^ ((dr + 1.5 * heat * mt_dm) / 20); tM = mx; tW = wd;
  bias = bi + 0.10 * heat * mt_dm;
);
function bd_run(l, r) instance(kAf, kAs, kAr, kSl, kSf, kg, kH1, kH2, eA1, eA2, eS1, eS2, g, tA, tS, tD, tM, tW,
                               bdD, bdM, bdW, bias, rest, heat, oL, oR, gmon) local(a, eps, gt, u, sl, sr, mid, sid, wn) (
  // linked detector
  a = max(abs(l), abs(r));
  eA1 += (a > eA1 ? kAf : kAr) * (a - eA1);                            // fast attack
  eA2 += (eA1 > eA2 ? kAs : kAr) * (eA1 - eA2);                        // chases the fast one slowly: the gap is the transient
  eS1 += (a > eS1 ? kAf : kSl) * (a - eS1);                            // long release
  eS2 += (a > eS2 ? kAf : kSf) * (a - eS2);                            // short release: the gap is the tail
  eps = 0.0000001;
  gt = (tA != 0 ? tA * min(max((eA1 - eA2) / (eA1 + eps), 0) * 3, 1) : 0)
     + (tS != 0 ? tS * min(max((eS1 - eS2) / (eS1 + eps), 0) * 1.6, 1) : 0);
  g += (gt - g) * kg; gmon = g;
  u = abs(g) > 0.0005 ? exp(0.115129255 * g) : 1;
  l *= u; r *= u;
  // heat: a slow thermal follower of what the band is fed
  heat += (a > heat ? kH1 : kH2) * (min(a * 2, 1) - heat);
  // glides (the drive, mix and width ride smoothly)
  bdD += (tD - bdD) * mt_gs; bdM += (tM - bdM) * mt_gs; bdW += (tW - bdW) * mt_gs;
  // saturation (level-compensated), in parallel with the clean band
  bdM > 0.0005 ? (
    sl = (mt_sc(l * bdD + bias) - rest) / bdD; sr = (mt_sc(r * bdD + bias) - rest) / bdD;
    l += bdM * (sl - l); r += bdM * (sr - r);
  );
  // width: M/S, the level kept steady
  abs(bdW - 1) > 0.0005 ? (
    mid = 0.5 * (l + r); sid = 0.5 * (l - r); wn = min(sqrt(2 / (1 + bdW * bdW)), 1.4142);
    mid *= wn; sid *= bdW * wn; l = mid + sid; r = mid - sid;
  );
  oL = l; oR = r;
);
function bd_rest() instance(bias, rest) ( rest = mt_sc(bias); );
function bd_tidy() instance(eA1, eA2, eS1, eS2, g, heat) (
  eA1 = mt_tn(eA1); eA2 = mt_tn(eA2); eS1 = mt_tn(eS1); eS2 = mt_tn(eS2); g = mt_tn(g); heat = mt_tn(heat);
);

// ---------- presets ----------
#mt_pm = "Init|Gentle Warmth|Punchy Drums|Tame the Snap|Wide Air|Mono Lows|Vocal Presence|Bass Glue|Room Lift|Snappy Mix Bus|Thick and Hot|Clean Width";
function mt_b(base, at, su, dr, mx, wd) ( slider(base) = at; slider(base + 1) = su; slider(base + 2) = dr; slider(base + 3) = mx; slider(base + 4) = wd; );
function mt_x(f1, f2) ( slider2 = f1; slider3 = f2; );
function load_preset(p) local(i) (
  mt_x(250, 4000); mt_b(4, 0, 0, 6, 100, 100); mt_b(9, 0, 0, 6, 100, 100); mt_b(14, 0, 0, 6, 100, 100);   // Init
  p == 2  ? ( mt_b(4, 0, 0, 9, 70, 100); mt_b(9, 0, 0, 8, 60, 100); mt_b(14, 0, 0, 5, 50, 110); ) :      // Gentle Warmth
  p == 3  ? ( mt_x(150, 5000); mt_b(4, 6, -3, 10, 80, 90); mt_b(9, 5, -2, 8, 70, 100); mt_b(14, 4, 0, 6, 60, 110); ) :   // Punchy Drums
  p == 4  ? ( mt_x(200, 3500); mt_b(4, -3, 0, 6, 100, 100); mt_b(9, -6, 1, 6, 100, 100); mt_b(14, -8, 2, 4, 100, 100); ) :   // Tame the Snap
  p == 5  ? ( mt_x(300, 6000); mt_b(4, 0, 0, 4, 100, 90); mt_b(9, 0, 0, 5, 100, 115); mt_b(14, 0, 2, 7, 60, 150); ) :   // Wide Air
  p == 6  ? ( mt_x(150, 4000); mt_b(4, 0, 0, 8, 100, 0); mt_b(9, 0, 0, 6, 100, 100); mt_b(14, 0, 0, 6, 100, 115); ) :   // Mono Lows
  p == 7  ? ( mt_x(250, 3000); mt_b(4, 0, -2, 4, 100, 100); mt_b(9, 2, 0, 9, 60, 100); mt_b(14, 3, 1, 8, 50, 110); ) :   // Vocal Presence
  p == 8  ? ( mt_x(120, 2500); mt_b(4, -2, 3, 14, 70, 0); mt_b(9, 2, 0, 9, 60, 100); mt_b(14, 0, 0, 4, 100, 100); ) :   // Bass Glue
  p == 9  ? ( mt_x(250, 4000); mt_b(4, 0, 3, 6, 100, 100); mt_b(9, 0, 5, 6, 100, 120); mt_b(14, 0, 4, 5, 100, 130); ) :   // Room Lift
  p == 10 ? ( mt_x(180, 4500); mt_b(4, 4, -2, 9, 70, 100); mt_b(9, 3, -1, 8, 60, 105); mt_b(14, 3, 0, 7, 50, 115); ) :   // Snappy Mix Bus
  p == 11 ? ( mt_x(250, 4000); mt_b(4, 0, 2, 18, 100, 100); mt_b(9, 0, 2, 16, 100, 100); mt_b(14, 0, 0, 12, 80, 100); ) :   // Thick and Hot
  p == 12 ? ( mt_x(250, 4000); mt_b(4, 0, 0, 0, 0, 80); mt_b(9, 0, 0, 0, 0, 120); mt_b(14, 0, 0, 0, 0, 150); ) :   // Clean Width
  p == 13 ? ( slider1 = 0; slider19 = 0; slider20 = 0; slider21 = 50; slider22 = slider23 = slider24 = slider25 = slider26 = slider27 = 0; );                                  // Reset all to defaults
  i = 1; loop(27, ui_auto(i); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

// ---------- state ----------
function mt_srinit() (
  mt_sr = srate;
  bL.bd_times(3, 25, 140, 400, 90);                   // LOW: slower envelopes
  bM.bd_times(1, 12, 90, 250, 50);                    // MID
  bH.bd_times(0.3, 5, 50, 140, 25);                   // HIGH: faster
  mt_gs = 1 - exp(-1 / (0.02 * srate));               // drive / mix / width / levels: 20 ms
  mt_ks = 1 - exp(-1 / (0.004 * srate));              // SOLO / MUTE
  mt_xs = 1 - exp(-1 / (0.03 * srate));               // the crossover corners glide (30 ms)
  mt_mfall = exp(-1 / (0.35 * srate));
  ost_init(0);
);
mt_srinit();
in_init();
dL.drift_init(0.8 + rand(0.4)); dM.drift_init(0.8 + rand(0.4)); dH.drift_init(0.8 + rand(0.4));
drift_macro(50);
mt_snap = 1;

ui_thm = 5; ui_hw = 1;                                // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );                // new instances open in Medium, on Init
ui_dflt = 1;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@block
srate != mt_sr ? mt_srinit();
in_setup(slider1, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);                // the house output stage: straight through (a mix tool)
drift_macro(slider21);
mt_dm = dm_a;
// crossover corners: glided per block (the upper never below the lower)
mt_f1t = min(max(slider2, 50), 1000); mt_f2t = max(min(max(slider3, 1000), 12000), mt_f1t * 1.5);
mt_k = mt_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
mt_f1 = mt_snap ? mt_f1t : mt_f1 * (mt_f1t / mt_f1) ^ mt_k;
mt_f2 = mt_snap ? mt_f2t : mt_f2 * (mt_f2t / mt_f2) ^ mt_k;
abs(mt_f1 - mt_lf1) > 0.01 || abs(mt_f2 - mt_lf2) > 0.01 ? (
  xL.xo_cfg(); xR.xo_cfg();
  mt_lf1 = mt_f1; mt_lf2 = mt_f2;
);
// DRIFT: each band's bias wanders on its own path
mt_n = samplesblock / srate;
mt_vL = dL.drift_tick(0.05 * dm_s * mt_n); mt_vM = dM.drift_tick(0.06 * dm_s * mt_n); mt_vH = dH.drift_tick(0.07 * dm_s * mt_n);
bL.bd_set(slider4, slider5, slider6, slider7 / 100, slider8 / 100, 0.06 + 0.04 * mt_dm * mt_vL);
bM.bd_set(slider9, slider10, slider11, slider12 / 100, slider13 / 100, 0.06 + 0.04 * mt_dm * mt_vM);
bH.bd_set(slider14, slider15, slider16, slider17 / 100, slider18 / 100, 0.05 + 0.04 * mt_dm * mt_vH);
bL.bd_rest(); bM.bd_rest(); bH.bd_rest();
mt_outt = 10 ^ (min(max(slider20, -12), 12) / 20);
mt_snap ? (
  bL.bdD = bL.tD; bL.bdM = bL.tM; bL.bdW = bL.tW; bM.bdD = bM.tD; bM.bdM = bM.tM; bM.bdW = bM.tW; bH.bdD = bH.tD; bH.bdM = bH.tM; bH.bdW = bH.tW;
  mt_outs = mt_outt; mt_snap = 0;
);
// denormal housekeeping
xL.xo_tidy(); xR.xo_tidy(); bL.bd_tidy(); bM.bd_tidy(); bH.bd_tidy();
// the panel's mailboxes
mta_pi = max(mta_pi, mt_pi); mt_pi = 0; mta_po = max(mta_po, mt_po); mt_po = 0;
mta_l0 = max(mta_l0, mt_l0); mta_l1 = max(mta_l1, mt_l1); mta_m0 = max(mta_m0, mt_m0); mta_m1 = max(mta_m1, mt_m1);
mta_h0 = max(mta_h0, mt_h0); mta_h1 = max(mta_h1, mt_h1); mt_l0 = mt_l1 = mt_m0 = mt_m1 = mt_h0 = mt_h1 = 0;
// SOLO / MUTE: with any band soloed only the soloed bands play; MUTE takes a band out
mt_so = slider22 >= 0.5 || slider24 >= 0.5 || slider26 >= 0.5;
mt_tL = mt_so ? slider22 >= 0.5 : slider23 < 0.5; mt_tM = mt_so ? slider24 >= 0.5 : slider25 < 0.5; mt_tH = mt_so ? slider26 >= 0.5 : slider27 < 0.5;
mt_sinit ? 0 : ( mt_sL = mt_tL; mt_sM = mt_tM; mt_sH = mt_tH; mt_sinit = 1; );
mta_gL = bL.gmon; mta_gM = bM.gmon; mta_gH = bH.gmon;
mta_hL = bL.heat; mta_hM = bM.heat; mta_hH = bH.heat;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
in_process(spl0, spl1);
mt_xl = in_l; mt_xr = in_r;
mt_pi = max(mt_pi, max(abs(mt_xl), abs(mt_xr)));
// split
xL.xo_run(mt_xl); xR.xo_run(mt_xr);
// the three bands
bL.bd_run(xL.lo, xR.lo); bM.bd_run(xL.mi, xR.mi); bH.bd_run(xL.hi, xR.hi);
mt_sL += (mt_tL - mt_sL) * mt_ks; mt_sM += (mt_tM - mt_sM) * mt_ks; mt_sH += (mt_tH - mt_sH) * mt_ks;   // SOLO / MUTE: 10 ms fades
mt_yl = bL.oL * mt_sL + bM.oL * mt_sM + bH.oL * mt_sH; mt_yr = bL.oR * mt_sL + bM.oR * mt_sM + bH.oR * mt_sH;
mt_l0 = max(mt_l0, abs(bL.oL)); mt_l1 = max(mt_l1, abs(bL.oR)); mt_m0 = max(mt_m0, abs(bM.oL)); mt_m1 = max(mt_m1, abs(bM.oR));
mt_h0 = max(mt_h0, abs(bH.oL)); mt_h1 = max(mt_h1, abs(bH.oR));
// OUTPUT
mt_outs += (mt_outt - mt_outs) * mt_gs;
mt_yl *= mt_outs; mt_yr *= mt_outs;
mt_yl != mt_yl ? mt_yl = 0; mt_yr != mt_yr ? mt_yr = 0;
ost_out(mt_yl, mt_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
mt_po = max(mt_po, max(abs(spl0), abs(spl1)));

@gfx 1080 430
ui_begin(1080, 430);
// =====================================================================
// GUI - in the manner of KRT81: a heavy dark green faceplate with steel corner brackets and hex bolts, sharp-cornered
// black sections, black bakelite knobs with printed scales (INPUT, OUTPUT, each band's DRIVE), small capped knobs,
// a BAND LEVEL window (LOW / MID / HIGH, L / R ladders and each band's transient bar). Design space 1080 x 430.
// Knobs: drag (SHIFT = fine), wheel, double-click = default; the name shows the value while the knob is touched.
// =====================================================================
krv_mx = slider19 >= 0.5;                                 // the look: VFD (0) or MATRIX (1)
!krv_mx ? (                                               // VFD: dark green, light green, black
  KRP = 0x1E3A27;                                         // dark green faceplate
  KRF = 0x0E1410;                                         // the sections: green-black
  KRI = 0xCDEBCB;                                         // print: pale green
  KRA = 0x9EE6A0;                                         // light green: active, pointers
  KRW = 0x050806;                                         // meter window
  KRM = 0x4A524A;                                         // bracket steel
  KRC = 0x9EE6A0;                                         // small knob caps: light green
  KRPT = 0x0B2E16;                                        // their pointers: very dark green
  KRCN = 0x9EE6A0; KRGH = 0x0F1A12;                       // meter cells: lit / unlit
  KRAMB = 0xFFB347; KRRED = 0xE0442A;
  KRKT = 0x0D1A10;                                        // the caption on a lit key
) : (                                                     // MATRIX: battleship grey, elephant's breath, mustard amber
  KRP = 0x222528;
  KRF = ui_mix(KRP, 0x000000, 0.25);
  KRI = 0xC7BEB3;
  KRA = 0xD4A373;
  KRW = ui_mix(KRP, 0x000000, 0.45);
  KRM = 0x4A4E4A;
  KRC = 0xD4A373;
  KRPT = 0x17191B;
  KRCN = 0x1E5631; KRGH = 0x2C302E;                       // forest-green cells on olive drab
  KRAMB = 0xD4A373; KRRED = 0xBC3908;
  KRKT = 0x17191B;
);
KRH = ui_mix(KRP, 0x000000, 0.35);                        // header strip
KRI2 = ui_mix(KRI, KRF, 0.40);

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');            // title
gfx_setfont(10, "Trebuchet MS", 13 * sc, 'b');            // scale numbers
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');            // labels
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');            // key captions
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');            // small print
gfx_setfont(14, "Trebuchet MS", 15 * sc, 'b');            // knob names

function kr_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kr_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function kr_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_lbl(x, y, s) ( gfx_setfont(11); ui_col(KRI2); kr_txt(x, y, s); );
function kr_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a broad line in pixels (drawn here: no dependence on the system files' line routine)
function kr_thick(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, k) (
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l; ny = dx / l;
  k = -0.5 * w; loop(floor(w * 2.5) + 1, gfx_line(x1 + nx * k, y1 + ny * k, x2 + nx * k, y2 + ny * k, 1); k += 0.4; );
);
// a flat, sharp-cornered lit key; returns 1 when clicked
function kr_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = kr_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(0x050706); kr_r(x, y, w, h);
  on ? ui_col(KRA) : ui_col(hov ? ui_mix(KRF, 0xFFFFFF, 0.08) : ui_mix(KRF, KRP, 0.5)); kr_r(x + 1, y + 1, w - 2, h - 2);
  on ? ( ui_cola(KRA, 0.25); kr_r(x - 2, y - 2, w + 4, h + 4); ui_cola(0xFFFFFF, 0.3); kr_r(x + 1, y + 1, w - 2, 1); );
  on ? ui_col(KRKT) : ui_cola(KRI, 0.85);
  gfx_setfont(12); kr_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);
// a section: sharp-cornered face with a thin black frame and its name
function kr_sect(x, y, w, h, name) (
  ui_col(0x040605); kr_r(x, y, w, h); ui_col(KRF); kr_r(x + 1, y + 1, w - 2, h - 2);
  strlen(name) ? kr_lbl(x + 9, y + 6, name);
);
// printed scale round a knob: n numbers from the list ("a|b|c"), a tick at each (minor ticks between)
function kr_scale(cx, cy, r, n, nr, labels, minor) local(i, k, k0, len, c, a, ca, sa, m) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  minor > 0 ? (
    m = 0; ui_col(KRI2);
    loop((n - 1) * minor + 1,
      a = -0.75 * $pi + m / ((n - 1) * minor) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 6)) * sc, (cy + sa * (r + 6)) * sc, 1);
      m += 1;
    );
  );
  gfx_setfont(10);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#krv_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      ui_col(KRI);
      gfx_line((cx + ca * (r + 3)) * sc, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 8)) * sc, (cy + sa * (r + 8)) * sc, 1);
      gfx_line((cx + ca * (r + 3)) * sc + 1, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 8)) * sc + 1, (cy + sa * (r + 8)) * sc, 1);
      kr_ctxt(cx + ca * (r + nr), cy + sa * (r + nr), #krv_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
// the chunky bakelite knob (pixels): a fluted black skirt, a flat cap, a broad light green pointer
function kr_bake(cx, cy, r, a) local(i, t, ca, sa, k) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.55); gfx_circle(cx + 2.5 * sc, cy + 4.5 * sc, r * 1.02, 1, 1);
  ui_col(0x0A0B0A); gfx_circle(cx, cy, r + 1 * sc, 1, 1);
  ui_col(0x181A18); gfx_circle(cx, cy, r, 1, 1);
  i = 0;
  loop(16,
    t = i / 16 * 2 * $pi; k = 0.5 + 0.5 * cos(t + 0.8);
    ui_col(ui_mix(0x0C0E0C, 0x434A43, k * 0.8)); gfx_circle(cx + sin(t) * r * 0.86, cy - cos(t) * r * 0.86, r * 0.15, 1, 1);
    ui_col(0x0C0E0C); gfx_circle(cx + sin(t + 0.196) * r * 0.9, cy - cos(t + 0.196) * r * 0.9, r * 0.075, 1, 1);
    i += 1;
  );
  ui_col(0x080908); gfx_circle(cx, cy, r * 0.70 + 1 * sc, 1, 1);
  ui_col(0x202320); gfx_circle(cx, cy, r * 0.70, 1, 1);
  ui_cola(0xFFFFFF, 0.08); gfx_circle(cx, cy, r * 0.70, 0, 1);
  ui_col(0x060706); kr_thick(cx + ca * r * 0.18, cy + sa * r * 0.18, cx + ca * r * 0.98, cy + sa * r * 0.98, 4.2 * sc);
  ui_col(KRA); kr_thick(cx + ca * r * 0.22, cy + sa * r * 0.22, cx + ca * r * 0.95, cy + sa * r * 0.95, 2.5 * sc);
);
// the small knob (pixels): a light green cap on a dark skirt, a very dark green pointer
function kr_scap(cx, cy, r, a) local(ca, sa, k) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(0x101310); gfx_circle(cx, cy, r, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx, cy, r, 0, 1);
  k = r * 0.74;
  ui_col(KRC); gfx_circle(cx, cy, k, 1, 1);
  ui_col(ui_mix(KRC, 0x000000, 0.35)); gfx_circle(cx, cy, k, 0, 1);
  ui_col(KRPT); kr_thick(cx + ca * k * 0.2, cy + sa * k * 0.2, cx + ca * r * 0.94, cy + sa * r * 0.94, 2.6 * sc);
);
krv_small = 0; krv_lg = 0;
function kr_kn(v, lo, hi) ( krv_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function kr_kv(n, lo, hi) ( krv_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
// a knob: drag (shift = fine), double-click = default, wheel; returns 1 while touched
function kr_knob(cx, cy, r, idx, lo, hi, def) local(v, n, dx, dy, hov, did) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - krv_lt < 0.35 && krv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; krv_lt = 0; ) : (
      drag_id = did; krv_y = mouse_y; krv_lt = time_precise(); krv_lid = idx; krv_n = kr_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    krv_n = min(max(krv_n + (krv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : 240) * sc), 0), 1); krv_y = mouse_y;
    v = kr_kv(krv_n, lo, hi); slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(kr_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    slider(idx) = kr_kv(n, lo, hi); ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(kr_kn(v, lo, hi), 0), 1);
  krv_small ? kr_scap(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi) : kr_bake(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi);
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  hov || drag_id == did;
);
function kr_name(cx, cy, act, name, val) ( gfx_setfont(14); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy, act ? val : name); );
// a small knob with its tick ring and name (the value while touched)
function kr_small(cx, cy, r, idx, lo, hi, def, name, val) local(i, t, act) (
  ui_cola(KRI, 0.85); i = 0;
  loop(11, t = -0.75 * $pi + i / 10 * 1.5 * $pi;
    gfx_line((cx + sin(t) * (r + 4)) * sc, (cy - cos(t) * (r + 4)) * sc, (cx + sin(t) * (r + 8)) * sc, (cy - cos(t) * (r + 8)) * sc, 1); i += 1; );
  krv_small = 1; act = kr_knob(cx, cy, r, idx, lo, hi, def); krv_small = 0;
  gfx_setfont(11); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy + r + 16, act ? val : name);
);
// ladder cells
function kr_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? KRRED : zone == 1 ? KRAMB : KRCN;
  lit ? ( ui_cola(c, 0.16); kr_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); kr_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); kr_r(x, y, w, 1.5); )
      : ( ui_col(KRGH); kr_r(x, y, w, h); ui_cola(0x000000, 0.25); kr_r(x, y + h - 1, w, 1); );
);
function kr_hbar(x, y, w, h, v) local(n, i, sw, d) (
  n = 30; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; kr_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d, d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);
function kr_window(x, y, w, h) ( ui_col(0x040605); kr_r(x, y, w, h); ui_col(KRW); kr_r(x + 1, y + 1, w - 2, h - 2); );
// the heavy faceplate: corner brackets with hex bolts
function kr_bolt(cx, cy, r) local(i, t, k) (
  ui_cola(0x000000, 0.45); gfx_circle((cx + 1) * sc, (cy + 1.5) * sc, r * sc, 1, 1);
  ui_col(ui_mix(KRM, 0x000000, 0.45)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(ui_mix(KRM, 0xFFFFFF, 0.25)); gfx_circle(cx * sc, cy * sc, (r - 1) * sc, 1, 1);
  i = 0;
  loop(6,
    t = i / 6 * 2 * $pi + 0.26; k = 0.5 + 0.5 * cos(t + 0.52 + 0.8);
    ui_col(ui_mix(ui_mix(KRM, 0x000000, 0.35), ui_mix(KRM, 0xFFFFFF, 0.45), k));
    gfx_triangle(cx * sc, cy * sc, (cx + cos(t) * r * 0.8) * sc, (cy + sin(t) * r * 0.8) * sc, (cx + cos(t + 1.0472) * r * 0.8) * sc, (cy + sin(t + 1.0472) * r * 0.8) * sc);
    i += 1;
  );
  ui_col(ui_mix(KRM, 0xFFFFFF, 0.12)); gfx_circle(cx * sc, cy * sc, r * 0.48 * sc, 1, 1);
);
function kr_bracket(x, y, sx, sy) local(L, T, x0, y0) (
  L = 64; T = 18; x0 = sx > 0 ? x : x - L; y0 = sy > 0 ? y : y - T;
  ui_cola(0x000000, 0.35); kr_r(x0 + 1.5, y0 + 2, L, T); kr_r((sx > 0 ? x : x - T) + 1.5, (sy > 0 ? y : y - L) + 2, T, L);
  ui_col(ui_mix(KRM, 0x000000, 0.4)); kr_r(x0, y0, L, T); kr_r(sx > 0 ? x : x - T, sy > 0 ? y : y - L, T, L);
  ui_col(KRM); kr_r(x0 + 1, y0 + 1, L - 2, T - 2); kr_r((sx > 0 ? x : x - T) + 1, (sy > 0 ? y : y - L) + 1, T - 2, L - 2);
  ui_cola(0xFFFFFF, 0.22); kr_r(x0 + 1, y0 + 1, L - 2, 1); kr_r((sx > 0 ? x : x - T) + 1, (sy > 0 ? y : y - L) + 1, 1, L - 2);
  kr_bolt(x + sx * 10, y + sy * 9.5, 7); kr_bolt(x + sx * (L - 10), y + sy * 9, 4.5); kr_bolt(x + sx * 9, y + sy * (L - 10), 4.5);
);
function kr_hz(f) ( f >= 1000 ? sprintf(#krh, "%.1f kHz", f / 1000) : sprintf(#krh, "%d Hz", floor(f + 0.5)); #krh; );
function kr_db(v) ( sprintf(#krd, "%+.1f dB", v); #krd; );
function kr_pc(v) ( sprintf(#krp, "%d%%", floor(v + 0.5)); #krp; );

// =====================================================================
// Faceplate and header
// =====================================================================
ui_col(ui_mix(KRP, 0x000000, 0.35)); gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0xFFFFFF, 0.08); kr_r(0, 0, 1080, 1.5); kr_r(0, 0, 1.5, 430);
ui_cola(0x000000, 0.35); kr_r(0, 428.5, 1080, 1.5); kr_r(1078.5, 0, 1.5, 430);
ui_col(KRP); kr_r(12, 12, 1056, 406);
ui_cola(0x000000, 0.30); kr_r(12, 12, 1056, 1.5); kr_r(12, 12, 1.5, 406);
ui_cola(0xFFFFFF, 0.07); kr_r(12, 416.5, 1056, 1.5); kr_r(1066.5, 12, 1.5, 406);
ui_col(KRH); kr_r(13.5, 13.5, 1053, 50.5);
ui_col(KRA); kr_r(13.5, 64, 1053, 2);
ui_col(KRA); gfx_circle(45 * sc, 39 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(KRKT); ui_text(45 * sc, 33.5 * sc, "GFX");
gfx_setfont(6); ui_col(KRI); kr_txt(72, 24, "MSAT"); gfx_measurestr("MSAT", krv_tw, krv_th);
krv_tx = 72 + krv_tw / sc + 14;
gfx_setfont(11); ui_col(KRI2); kr_txt(krv_tx, 25, "3-BAND SATURATION"); kr_txt(krv_tx, 40, "TRANSIENTS · WIDTH");
pk_pextra = "Reset all to defaults";
k_ = pk_preset(470 * sc, 22 * sc, 300 * sc, 34 * sc, pr_cur, #mt_pm);
k_ > 0 ? load_preset(k_);
kr_key(796, 25, 56, 28, "VFD", krv_mx == 0) ? ( slider19 = 0; ui_auto(19); );
kr_key(856, 25, 66, 28, "MATRIX", krv_mx == 1) ? ( slider19 = 1; ui_auto(19); );
ui_size_picker(1000 * sc, 30 * sc);

// =====================================================================
// Upper row (y 72 .. 206): INPUT, BAND LEVEL, CROSSOVER, DRIFT, OUTPUT
// =====================================================================
kr_sect(22, 72, 112, 134, "INPUT");
kr_scale(78, 146, 26, 5, 20, "-12|-6|0|+6|+12", 2);
krv_a = kr_knob(78, 146, 26, 1, -12, 12, 0); kr_name(78, 192, krv_a, "INPUT", kr_db(slider1));

// ---------- BAND LEVEL ----------
kr_sect(140, 72, 472, 134, "");
kr_window(146, 78, 460, 122);
gfx_setfont(11); ui_col(KRI); kr_txt(154, 83, "BAND LEVEL"); ui_col(KRI2); kr_txt(240, 83, "L / R"); kr_rtxt(470, 90, "dBFS");
ui_col(KRI); kr_txt(492, 83, "TRANSIENT");
// the meters fall back at about 20 dB a second
function kr_fall(v, pk) ( pk = pk > 0.0000001 ? 20 * log10(pk) : -90; pk > v ? pk : max(v - 0.6, -90); );
krv_l0 = kr_fall(krv_l0, mta_l0); krv_l1 = kr_fall(krv_l1, mta_l1); krv_m0 = kr_fall(krv_m0, mta_m0);
krv_m1 = kr_fall(krv_m1, mta_m1); krv_h0 = kr_fall(krv_h0, mta_h0); krv_h1 = kr_fall(krv_h1, mta_h1);
mta_l0 = mta_l1 = mta_m0 = mta_m1 = mta_h0 = mta_h1 = 0;
function kr_tbar(x, y, g) local(n, w) (                   // a transient bar: -15 .. +15 dB about the centre
  ui_col(ui_mix(KRI, KRW, 0.8)); kr_r(x, y, 92, 14); ui_col(KRW); kr_r(x + 1, y + 1, 90, 12);
  n = min(max(g / 15, -1), 1); w = 42 * n;
  ui_col(n >= 0 ? (krv_mx ? 0x3E8C55 : KRA) : (krv_mx ? KRRED : KRAMB));
  abs(w) > 0.5 ? ( n >= 0 ? kr_r(x + 46, y + 4, w, 6) : kr_r(x + 46 + w, y + 4, -w, 6); );
  ui_col(KRI2); kr_r(x + 45.5, y + 2, 1, 10);
);
function kr_pair(y, nm, v0, v1, g) (
  gfx_setfont(11); ui_col(KRI); kr_rtxt(198, y + 10, nm);
  kr_hbar(204, y, 270, 9, v0); kr_hbar(204, y + 11, 270, 9, v1);
  kr_tbar(492, y + 3, g);
);
kr_pair(102, "LOW", krv_l0, krv_l1, mta_gL);
kr_pair(128, "MID", krv_m0, krv_m1, mta_gM);
kr_pair(154, "HIGH", krv_h0, krv_h1, mta_gH);
gfx_setfont(13); krv_i = 0;
loop(5,
  krv_d = krv_i == 0 ? -48 : krv_i == 1 ? -36 : krv_i == 2 ? -24 : krv_i == 3 ? -12 : 0;
  krv_xx = 204 + (krv_d + 48) / 48 * 270;
  ui_col(krv_d > -12.5 ? KRAMB : KRI2); kr_r(krv_xx - 0.5, 178, 1, 4);
  sprintf(#krv_tl, "%d", krv_d); kr_ctxt(krv_xx - (krv_i == 4 ? 4 : 0), 190, #krv_tl);
  krv_i += 1;
);
ui_col(KRI2); kr_ctxt(492, 190, "-15"); kr_ctxt(538, 190, "0"); kr_ctxt(582, 190, "+15");

// ---------- CROSSOVER ----------
kr_sect(618, 72, 200, 134, "CROSSOVER");
krv_lg = 1; kr_small(674, 140, 17, 2, 50, 1000, 250, "LOW / MID", kr_hz(slider2));
kr_small(762, 140, 17, 3, 1000, 12000, 4000, "MID / HIGH", kr_hz(slider3)); krv_lg = 0;
gfx_setfont(13); ui_col(KRI2); kr_ctxt(674, 192, kr_hz(slider2)); kr_ctxt(762, 192, kr_hz(max(slider3, slider2 * 1.5)));

// ---------- DRIFT ----------
kr_sect(824, 72, 116, 134, "DRIFT");
kr_small(882, 140, 17, 21, 0, 100, 50, "HEAT / BIAS", kr_pc(slider21));

// ---------- OUTPUT ----------
kr_sect(946, 72, 112, 134, "OUTPUT");
kr_scale(1002, 146, 26, 5, 20, "-12|-6|0|+6|+12", 2);
krv_a = kr_knob(1002, 146, 26, 20, -12, 12, 0); kr_name(1002, 192, krv_a, "TRIM", kr_db(slider20));

// =====================================================================
// Lower row (y 212 .. 408): LOW, MID, HIGH - DRIVE (bakelite), ATTACK / SUSTAIN, MIX / WIDTH, the HEAT lamp
// =====================================================================
function kr_band(x, base, title, ht, slsolo) local(w, a) (
  w = 341;
  kr_sect(x, 212, w, 196, title);
  // HEAT lamp
  ht = min(max(ht * mt_dm * 1.4, 0), 1);
  ui_cola(KRAMB, 0.08 + 0.3 * ht); gfx_circle((x + w - 20) * sc, 226 * sc, 10 * sc, 1, 1);
  ui_col(ui_mix(0x2A2316, KRAMB, ht)); gfx_circle((x + w - 20) * sc, 226 * sc, 6 * sc, 1, 1);
  gfx_setfont(13); ui_col(KRI2); kr_rtxt(x + w - 34, 226, "HEAT");
  kr_key(x + w - 150, 216, 28, 21, "S", slider(slsolo) >= 0.5) ? ( slider(slsolo) = slider(slsolo) >= 0.5 ? 0 : 1; ui_auto(slsolo); );
  kr_key(x + w - 118, 216, 28, 21, "M", slider(slsolo + 1) >= 0.5) ? ( slider(slsolo + 1) = slider(slsolo + 1) >= 0.5 ? 0 : 1; ui_auto(slsolo + 1); );
  // DRIVE
  kr_scale(x + 76, 306, 32, 5, 20, "0|6|12|18|24", 2);
  a = kr_knob(x + 76, 306, 32, base + 2, 0, 24, 6); kr_name(x + 76, 364, a, "DRIVE", kr_db(slider(base + 2)));
  // ATTACK / SUSTAIN, MIX / WIDTH
  kr_small(x + 190, 270, 16, base, -15, 15, 0, "ATTACK", kr_db(slider(base)));
  kr_small(x + 280, 270, 16, base + 1, -15, 15, 0, "SUSTAIN", kr_db(slider(base + 1)));
  kr_small(x + 190, 350, 16, base + 3, 0, 100, 100, "MIX", kr_pc(slider(base + 3)));
  kr_small(x + 280, 350, 16, base + 4, 0, 200, 100, "WIDTH", kr_pc(slider(base + 4)));
);
sprintf(#krb1, "LOW  ·  BELOW %s", kr_hz(slider2)); kr_band(22, 4, #krb1, mta_hL, 22);
strcpy(#krb2, "MID  ·  "); strcat(#krb2, kr_hz(slider2)); strcat(#krb2, " - "); strcat(#krb2, kr_hz(max(slider3, slider2 * 1.5))); kr_band(369, 9, #krb2, mta_hM, 24);
sprintf(#krb3, "HIGH  ·  ABOVE %s", kr_hz(max(slider3, slider2 * 1.5))); kr_band(716, 14, #krb3, mta_hH, 26);

// the corner brackets last (over the rim)
kr_bracket(0, 0, 1, 1); kr_bracket(1080, 0, -1, 1); kr_bracket(0, 430, 1, -1); kr_bracket(1080, 430, -1, -1);

pk_end();
ui_end();
