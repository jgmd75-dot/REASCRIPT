desc:GFX Bern 16 [summing mixer]
//tags: summing mixer broadcast console transformer drive mono channels
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// Sixteen mono channels into a stereo mix bus, in the spirit of the classic Swiss 16-channel broadcast consoles
// (personal use; the sound is designed from scratch): precise and quiet, with the tight discrete-transistor
// summing amp and the output transformer's warmth when you lean on it.
//
// SET-UP (REAPER): set the bus track to 16 channels and send each mono source to its own channel (1 - 16; in the
// send's audio routing pick a single channel) and turn off the sources' own master send. The mix leaves on 1/2.
//   CHANNELS  GAIN (-24 .. +24 dB), PAN (constant power: -3 dB in the centre), SOLO (solo-in-place: any number at
//             once, only the soloed channels are heard), MUTE (a muted channel stays muted when soloed),
//             a level meter (dBFS, after the gain) and a scribble strip: click it and type a name
//             (Enter keeps it, Escape cancels). The names are saved with the project.
//   DRIVE     level into the summing amp and the output transformer (level-matched: it changes the colour, not
//             the volume). The amp is an asymmetric soft curve (2nd and 3rd harmonics) with plenty of headroom, so
//             peaks are rounded gently rather than crushed; the transformer thickens the lows below ~100 Hz.
//   TONE      the console's response: a gentle tilt (DARK .. BRIGHT, up to 2 dB at each end).
//   COLOUR    the console response in or out: a 20 Hz high-pass, a little transformer weight at 45 Hz, the soft top
//             roll-off and the TONE tilt. Off = flat (the amp and transformer still work).
//   IRON      a whisper of input-transformer saturation on every channel.
//   MONO      folds the mix to mono (to check the balance).
//   VOLUME    master output (band SAT).
//   DRIFT     an uneven power supply: each channel's gain (up to +/-0.25 dB at 100 %) and the summing amp's bias
//             (each side its own) wander very slightly and independently.
//   METERS    master PEAK (segments, with a hold: click to clear) and RMS (the bar beside), in dBFS.
// PRESETS     set the master section; STEREO PAIRS and WIDE FAN set the pans, MONO CHECK only switches MONO.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<-24,24,0.1>-Ch 1 gain (dB)
slider2:0<-24,24,0.1>-Ch 2 gain (dB)
slider3:0<-24,24,0.1>-Ch 3 gain (dB)
slider4:0<-24,24,0.1>-Ch 4 gain (dB)
slider5:0<-24,24,0.1>-Ch 5 gain (dB)
slider6:0<-24,24,0.1>-Ch 6 gain (dB)
slider7:0<-24,24,0.1>-Ch 7 gain (dB)
slider8:0<-24,24,0.1>-Ch 8 gain (dB)
slider9:0<-24,24,0.1>-Ch 9 gain (dB)
slider10:0<-24,24,0.1>-Ch 10 gain (dB)
slider11:0<-24,24,0.1>-Ch 11 gain (dB)
slider12:0<-24,24,0.1>-Ch 12 gain (dB)
slider13:0<-24,24,0.1>-Ch 13 gain (dB)
slider14:0<-24,24,0.1>-Ch 14 gain (dB)
slider15:0<-24,24,0.1>-Ch 15 gain (dB)
slider16:0<-24,24,0.1>-Ch 16 gain (dB)
slider17:0<-100,100,1>-Ch 1 pan
slider18:0<-100,100,1>-Ch 2 pan
slider19:0<-100,100,1>-Ch 3 pan
slider20:0<-100,100,1>-Ch 4 pan
slider21:0<-100,100,1>-Ch 5 pan
slider22:0<-100,100,1>-Ch 6 pan
slider23:0<-100,100,1>-Ch 7 pan
slider24:0<-100,100,1>-Ch 8 pan
slider25:0<-100,100,1>-Ch 9 pan
slider26:0<-100,100,1>-Ch 10 pan
slider27:0<-100,100,1>-Ch 11 pan
slider28:0<-100,100,1>-Ch 12 pan
slider29:0<-100,100,1>-Ch 13 pan
slider30:0<-100,100,1>-Ch 14 pan
slider31:0<-100,100,1>-Ch 15 pan
slider32:0<-100,100,1>-Ch 16 pan
slider33:0<0,1,1{Off,On}>-Ch 1 mute
slider34:0<0,1,1{Off,On}>-Ch 2 mute
slider35:0<0,1,1{Off,On}>-Ch 3 mute
slider36:0<0,1,1{Off,On}>-Ch 4 mute
slider37:0<0,1,1{Off,On}>-Ch 5 mute
slider38:0<0,1,1{Off,On}>-Ch 6 mute
slider39:0<0,1,1{Off,On}>-Ch 7 mute
slider40:0<0,1,1{Off,On}>-Ch 8 mute
slider41:0<0,1,1{Off,On}>-Ch 9 mute
slider42:0<0,1,1{Off,On}>-Ch 10 mute
slider43:0<0,1,1{Off,On}>-Ch 11 mute
slider44:0<0,1,1{Off,On}>-Ch 12 mute
slider45:0<0,1,1{Off,On}>-Ch 13 mute
slider46:0<0,1,1{Off,On}>-Ch 14 mute
slider47:0<0,1,1{Off,On}>-Ch 15 mute
slider48:0<0,1,1{Off,On}>-Ch 16 mute
slider49:0<0,1,1{Off,On}>-Ch 1 solo
slider50:0<0,1,1{Off,On}>-Ch 2 solo
slider51:0<0,1,1{Off,On}>-Ch 3 solo
slider52:0<0,1,1{Off,On}>-Ch 4 solo
slider53:0<0,1,1{Off,On}>-Ch 5 solo
slider54:0<0,1,1{Off,On}>-Ch 6 solo
slider55:0<0,1,1{Off,On}>-Ch 7 solo
slider56:0<0,1,1{Off,On}>-Ch 8 solo
slider57:0<0,1,1{Off,On}>-Ch 9 solo
slider58:0<0,1,1{Off,On}>-Ch 10 solo
slider59:0<0,1,1{Off,On}>-Ch 11 solo
slider60:0<0,1,1{Off,On}>-Ch 12 solo
slider61:0<0,1,1{Off,On}>-Ch 13 solo
slider62:0<0,1,1{Off,On}>-Ch 14 solo
slider63:0<0,1,1{Off,On}>-Ch 15 solo
slider64:0<0,1,1{Off,On}>-Ch 16 solo
slider65:0<0,18,0.1>-Drive (dB)
slider66:0<-100,100,1>-Tone (dark / bright)
slider67:1<0,1,1{Off,On}>-Colour
slider68:0<0,1,1{Off,On}>-Channel iron
slider69:0<-24,12,0.1>-Volume (dB)
slider70:0<0,1,1{Off,On}>-Mono
slider71:20<0,100,1>-Drift (%)
slider72:0<0,100,1>-Band sat (%)
slider73:30<0,100,1>-Bias (%)
slider74:120<40,400,1>-Sat low band (Hz)
slider75:6000<2000,16000,10>-Sat high band (Hz)
slider76:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider77:1<0,1,1{Off,Clip}>-(unused, was output stage)

in_pin:ch 1
in_pin:ch 2
in_pin:ch 3
in_pin:ch 4
in_pin:ch 5
in_pin:ch 6
in_pin:ch 7
in_pin:ch 8
in_pin:ch 9
in_pin:ch 10
in_pin:ch 11
in_pin:ch 12
in_pin:ch 13
in_pin:ch 14
in_pin:ch 15
in_pin:ch 16
out_pin:mix L
out_pin:mix R

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0; gdc_x12 = gdc_y12 = 0; gdc_x13 = gdc_y13 = 0; gdc_x14 = gdc_y14 = 0; gdc_x15 = gdc_y15 = 0;
#ui_man = "gfx-bern-16";                                  // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
BZG  = alloc(16);   // channel gain, smoothed (audio)
BZGT = alloc(16);   // channel gain target: level, mute / solo, supply drift
BZPL = alloc(16); BZPR = alloc(16);      // pan gains, smoothed
BZQL = alloc(16); BZQR = alloc(16);      // pan gain targets
BZPK = alloc(16);   // channel peak since the panel last looked (audio writes, gfx reads and clears)
BZDV = alloc(16); BZDT = alloc(16); BZDW = alloc(16);   // supply drift per channel: value, target, time to the next target
GZH  = alloc(16);   // channel meter hold (gfx only)
ost_init(alloc(4096));

bz_den = 0.00000000000000000001;          // keeps filter states out of denormals

// ---------- the console response (COLOUR) ----------
// a gentle high-pass (-1.5 dB at 20 Hz), a little transformer weight at 45 Hz, the TONE tilt (shelves at 250 Hz / 4 kHz),
// a soft top
function bz_tone_set(t) (
  bzHPl.bq_set(1, 17, 0.62, 0);  bzHPr.bq_set(1, 17, 0.62, 0);
  bzBMl.bq_set(2, 45, 0.9, 0.5); bzBMr.bq_set(2, 45, 0.9, 0.5);
  bzLSl.bq_set(4, 250, 0.6, -2 * t); bzLSr.bq_set(4, 250, 0.6, -2 * t);
  bzHSl.bq_set(3, 4000, 0.6, 2 * t); bzHSr.bq_set(3, 4000, 0.6, 2 * t);
  bzTPl.bq_set(3, 13000, 0.5, -1.2); bzTPr.bq_set(3, 13000, 0.5, -1.2);          // the soft top: about -1 dB at 20 kHz
  bz_tset = t;
);

function update() local(i, any, a, heard) (
  any = 0; i = 0; loop(16, any |= slider(49 + i) > 0.5; i += 1; );
  bz_solo = any;
  bz_dra = slider71 / 100;
  i = 0;
  loop(16,
    // heard: not muted, and soloed if anything is; the supply drift rides on the gain
    heard = slider(33 + i) < 0.5 && (!any || slider(49 + i) > 0.5);
    BZGT[i] = heard ? 10 ^ ((slider(1 + i) + 0.25 * bz_dra * BZDV[i]) / 20) : 0;
    a = (slider(17 + i) + 100) / 200;
    BZQL[i] = cos(a * 0.5 * $pi); BZQR[i] = sin(a * 0.5 * $pi);   // constant power: -3 dB each side in the centre
    i += 1;
  );
  bz_dt = 10 ^ (slider65 / 20);                       // drive into the summing amp
  bz_ir = 1 + 1.6 * slider65 / 18;                    // transformer core drive
  bz_ct = slider67 > 0.5; bz_it = slider68 > 0.5; bz_mt = slider70 > 0.5;
  bz_vt = 10 ^ (slider69 / 20);
  // the summing amp's bias: 0.08 nominal, each side wandering with its own supply
  bz_bl = 0.08 + 0.05 * bz_dra * bz_svl; bz_br = 0.08 + 0.05 * bz_dra * bz_svr;
  bz_tbl = ost_tanh(bz_bl); bz_tbr = ost_tanh(bz_br);
  bz_nl = 1 / (1 - bz_tbl * bz_tbl); bz_nr = 1 / (1 - bz_tbr * bz_tbr);
  ins_output_straight(72);   // output stage: straight through
);

// ---------- presets ----------
// the master section: drive, tone, colour, iron, volume, mono, drift
function bz_master(dv, tn, cl, ir, vo, mo, dr) (
  slider65 = dv; slider66 = tn; slider67 = cl; slider68 = ir; slider69 = vo; slider70 = mo; slider71 = dr;
);
function load_preset(p) local(i) (
  p == 1 ? bz_master(0, 0, 1, 0, 0, 0, 20) :              // Init
  p == 2 ? bz_master(0, 0, 0, 0, 0, 0, 0) :               // Clean Bus (straight sum, no colour, no drift)
  p == 3 ? bz_master(6, -25, 1, 1, 0, 0, 25) :            // Warm Iron
  p == 4 ? bz_master(9, 15, 1, 1, -1, 0, 20) :            // Drum Bus Glue
  p == 5 ? bz_master(14, 0, 1, 1, -2, 0, 35) :            // Pushed Console
  p == 6 ? bz_master(4, -60, 1, 0, 0, 0, 20) :            // Dark Broadcast
  p == 7 ? bz_master(2, 45, 1, 0, 0, 0, 15) :             // Bright Lift
  p == 8 ? bz_master(7, -15, 1, 1, -0.5, 0, 85) :         // Tired Supply
  p == 9 ? ( i = 0; loop(16, slider(17 + i) = i % 2 ? 100 : -100; i += 1; ); ) :           // Stereo Pairs (1/2 ... 15/16)
  p == 10 ? ( i = 0; loop(16, slider(17 + i) = floor(-100 + i * 200 / 15 + 0.5); i += 1; ); ) :   // Wide Fan (1 left .. 16 right)
  p == 11 ? slider70 = 1 :                                // Mono Check
  p == 12 ? (                                             // Reset all to defaults
    i = 0; loop(16, slider(1 + i) = 0; slider(17 + i) = 0; slider(33 + i) = 0; slider(49 + i) = 0; i += 1; );
    bz_master(0, 0, 1, 0, 0, 0, 20);
    slider72 = 0; slider73 = 30; slider74 = 120; slider75 = 6000; slider76 = -0.3; slider77 = 1;
  );
  i = 1; loop(77, ui_auto(i); i += 1; );
);

// everything that depends on the sample rate (run again from @block if the rate changes: ext_noinit keeps @init
// from running then)
function bz_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function bz_srinit() (
  bz_sr = srate;
  bz_sm = 1 - exp(-1 / (0.02 * srate));               // 20 ms parameter smoothing
  bz_lpc = 1 - exp(-2 * $pi * 100 / srate);           // transformer split: the lows below ~100 Hz
  bz_rc = 1 - exp(-1 / (0.3 * srate));                // RMS meter: 300 ms
  bz_tone_set(bz_tt);                                 // the console response filters
  // their states start clean: old-rate states under new coefficients thump
  bzHPl.bz_bqclr(); bzHPr.bz_bqclr(); bzBMl.bz_bqclr(); bzBMr.bz_bqclr(); bzLSl.bz_bqclr();
  bzLSr.bz_bqclr(); bzHSl.bz_bqclr(); bzHSr.bz_bqclr(); bzTPl.bz_bqclr(); bzTPr.bz_bqclr();
  ost_init(0);                                     // the output stage again (resets it)
);
bz_dcc = 0.9993;                                      // DC blocker after the amp (~5 Hz)
bz_svl = 0; bz_svr = 0;
ostL.ost_ch_init(); ostR.ost_ch_init();
bz_tt = slider66 / 100; bz_srinit();
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                 // a new instance opens in Large, on Init
ui_dflt = 1;
update();
i = 0; loop(16, BZG[i] = BZGT[i]; BZPL[i] = BZQL[i]; BZPR[i] = BZQR[i]; i += 1; );
bz_ds = bz_dt; bz_cm = bz_ct; bz_im = bz_it; bz_mm = bz_mt; bz_vs = bz_vt;

@slider
update();

@block
srate != bz_sr ? ( bz_sr = srate; bz_srinit(); );
// DRIFT: an uneven supply - slow random walks, eased so they never step; every channel and each side of the amp its own
bz_k = 0;
loop(16,
  BZDW[bz_k] -= samplesblock;
  BZDW[bz_k] <= 0 ? ( BZDW[bz_k] = srate * (0.6 + rand(1.8)); BZDT[bz_k] = rand(2) - 1; );
  BZDV[bz_k] += (BZDT[bz_k] - BZDV[bz_k]) * min(1, samplesblock / (0.9 * srate));
  bz_k += 1;
);
bz_swl -= samplesblock; bz_swl <= 0 ? ( bz_swl = srate * (0.7 + rand(2)); bz_stl = rand(2) - 1; );
bz_swr -= samplesblock; bz_swr <= 0 ? ( bz_swr = srate * (0.7 + rand(2)); bz_str = rand(2) - 1; );
bz_svl += (bz_stl - bz_svl) * min(1, samplesblock / (1.1 * srate));
bz_svr += (bz_str - bz_svr) * min(1, samplesblock / (1.1 * srate));
update();                                             // knobs moved on the panel do not run @slider, so read them here
// TONE glides (no zipper): the shelves follow in small steps
bz_tt += (slider66 / 100 - bz_tt) * min(1, samplesblock / (0.04 * srate));
abs(bz_tt - bz_tset) > 0.0005 ? bz_tone_set(bz_tt);

@serialize
file_var(0, ui_sz);
gn = 0; loop(16, file_avail(0) != 0 ? file_string(0, UI_NM + gn); gn += 1; );   // channel names
file_avail(0) != 0 ? file_var(0, pr_cur);             // the preset in use

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
gdc_y12 = spl12 - gdc_x12 + gdc_r * gdc_y12; gdc_x12 = spl12; spl12 = gdc_y12;
gdc_y13 = spl13 - gdc_x13 + gdc_r * gdc_y13; gdc_x13 = spl13; spl13 = gdc_y13;
gdc_y14 = spl14 - gdc_x14 + gdc_r * gdc_y14; gdc_x14 = spl14; spl14 = gdc_y14;
gdc_y15 = spl15 - gdc_x15 + gdc_r * gdc_y15; gdc_x15 = spl15; spl15 = gdc_y15;
// ---------- channels: gain (+ supply drift, mute / solo), iron, meter, constant-power pan ----------
bz_l = 0; bz_r = 0; bz_k = 0;
bz_im += ((bz_it ? 1 : 0) - bz_im) * bz_sm;
loop(16,
  BZG[bz_k] += (BZGT[bz_k] - BZG[bz_k]) * bz_sm;
  BZPL[bz_k] += (BZQL[bz_k] - BZPL[bz_k]) * bz_sm; BZPR[bz_k] += (BZQR[bz_k] - BZPR[bz_k]) * bz_sm;
  bz_x = spl(bz_k) * BZG[bz_k];
  bz_im > 0.0001 ? (
    // input transformer: a cubic knee (headroom to about +9 dBFS) with a touch of 2nd harmonic
    bz_u = min(max(bz_x * 0.5, -1.5), 1.5);
    bz_x += bz_im * ((bz_u - 0.148148 * bz_u * bz_u * bz_u + 0.05 * bz_u * bz_u) * 2 - bz_x);
  );
  BZPK[bz_k] = max(BZPK[bz_k], abs(bz_x));
  bz_l += bz_x * BZPL[bz_k]; bz_r += bz_x * BZPR[bz_k];
  bz_k += 1;
);

// ---------- the summing amp and output transformer (DRIVE, level-matched) ----------
bz_ds += (bz_dt - bz_ds) * bz_sm;
bz_g = bz_ds * 0.2;                                   // the amp's headroom at DRIVE 0: a 0 dBFS peak loses only ~0.2 dB
bz_ul = bz_l * bz_g; bz_ur = bz_r * bz_g;
// transformer: the lows saturate on the core (level-neutral when quiet)
bz_lol += (bz_ul - bz_lol) * bz_lpc + bz_den; bz_lor += (bz_ur - bz_lor) * bz_lpc + bz_den;
bz_ul += ost_tanh(bz_lol * bz_ir) / bz_ir - bz_lol; bz_ur += ost_tanh(bz_lor * bz_ir) / bz_ir - bz_lor;
// discrete transistor stage: biased soft curve (even + odd), unity small-signal gain
bz_ul = (ost_tanh(bz_ul + bz_bl) - bz_tbl) * bz_nl; bz_ur = (ost_tanh(bz_ur + bz_br) - bz_tbr) * bz_nr;
bz_l = bz_ul / bz_g; bz_r = bz_ur / bz_g;
// the bias leaves DC: block it
bz_yl = bz_l - bz_xl + bz_dcc * bz_yl; bz_xl = bz_l; bz_l = bz_yl;
bz_yr = bz_r - bz_xr + bz_dcc * bz_yr; bz_xr = bz_r; bz_r = bz_yr;

// ---------- COLOUR (crossfaded in / out) ----------
bz_cm += ((bz_ct ? 1 : 0) - bz_cm) * bz_sm;
bz_cl = bzTPl.bq_run(bzHSl.bq_run(bzLSl.bq_run(bzBMl.bq_run(bzHPl.bq_run(bz_l)))));
bz_cr = bzTPr.bq_run(bzHSr.bq_run(bzLSr.bq_run(bzBMr.bq_run(bzHPr.bq_run(bz_r)))));
bz_l += (bz_cl - bz_l) * bz_cm; bz_r += (bz_cr - bz_r) * bz_cm;

// ---------- MONO, VOLUME, the house output stage ----------
bz_mm += ((bz_mt ? 1 : 0) - bz_mm) * bz_sm;
bz_m = 0.5 * (bz_l + bz_r);
bz_l += (bz_m - bz_l) * bz_mm; bz_r += (bz_m - bz_r) * bz_mm;
bz_vs += (bz_vt - bz_vs) * bz_sm;
bz_l = ostL.ost_band(bz_l) * bz_vs; bz_r = ostR.ost_band(bz_r) * bz_vs;
ost_out(bz_l, bz_r);
spl0 = ost_l; spl1 = ost_r;
bz_k = 2; loop(14, spl(bz_k) = 0; bz_k += 1; );
bz_pkl = max(bz_pkl, abs(spl0)); bz_pkr = max(bz_pkr, abs(spl1));
bz_rml += (spl0 * spl0 - bz_rml) * bz_rc; bz_rmr += (spl1 * spl1 - bz_rmr) * bz_rc;

@gfx 1200 460
ui_begin(1200, 460);

// ---------- palette ----------
PNL = 0xC3CCD2;  SHA = 0xBAC4CB; SHB = 0xC9D1D7;     // light blue-grey faceplate, channel groups in two shades
MST = 0xB3BDC5;  HDR = 0x262B30;                      // master tray, header strip
INK = 0x1F262C;  INK2 = 0x4E5860; WHT = 0xEEEFEA;     // print, secondary print, chiffon white
RED = 0xC8483A;  CPAN = 0x3D70CC; CDRV = 0xE07A2A; CTON = 0x33A052; CVOL = 0xE8E0CB; CDRF = 0x8A6BD8;
CSOL = 0xF2C21B; CMUT = 0xE0392B; CGRN = 0x46D86A; CAMB = 0xFFB030;
dy_ink = INK; dy_bg = PNL; dy_kst = 7; dy_ntick = 11;
rd_sqbg = 0x2A2424;

// panel keys: house lamp keys (gfx-ui); legends in font slot 15 (set once per scale change)
function gz_key(x, y, w, h, on, col, s) local(hit) (
  sc != gz_lsc ? ( gz_lsc = sc; gfx_setfont(15, "Trebuchet MS", 11 * sc, 'b'); );
  lk_well = 0x2A2722; lk_font = 15; lk_font2 = 15;
  hit = lk_fit(x, y, w, h, on, col, s);
  hit;
);
function gz_lbl(x, y, s, a) ( gfx_setfont(4); ui_cola(INK, a); ui_text(x * sc, y * sc, s); );
// a channel's LED meter: 12 segments, dBFS
function gz_cmeter(x, y, h, pk, hold) local(i, d, sh, yy, c, db, hd) (
  db = 20 * log10(max(pk, 0.0000001)); hd = 20 * log10(max(hold, 0.0000001));
  sh = h / 12;
  ui_col(0x101214); gfx_rect((x - 1) * sc, (y - 1) * sc, 12 * sc, (h + 1) * sc);
  i = 0;
  loop(12,
    d = i == 0 ? 0 : i == 1 ? -3 : i == 2 ? -6 : i == 3 ? -9 : i == 4 ? -12 : i == 5 ? -15 : i == 6 ? -18 :
        i == 7 ? -24 : i == 8 ? -30 : i == 9 ? -36 : i == 10 ? -42 : -48;
    yy = y + i * sh;
    c = d >= -3 ? 0xFF3A2A : d >= -9 ? CAMB : CGRN;
    ui_col(db >= d || (hd >= d && hd < d + 3) ? c : ui_mix(c, 0x000000, 0.8));
    gfx_rect(x * sc, (yy + 0.5) * sc, 10 * sc, (sh - 1.5) * sc);
    i += 1;
  );
);
// one master ladder: peak segments (2 dB, -54 .. 0 dBFS) with a hold, and the RMS bar beside it
function gz_mmeter(x, y, h, pk, hold, rms) local(i, n, sh, d, c, db, hd, rd, yy, rh) (
  n = 27; sh = h / n;
  db = 20 * log10(max(pk, 0.0000001)); hd = 20 * log10(max(hold, 0.0000001)); rd = 10 * log10(max(rms, 0.00000000001));
  ui_col(0x101214); gfx_rect((x - 2) * sc, (y - 2) * sc, 28 * sc, (h + 3) * sc);
  i = 0;
  loop(n,
    d = -2 * i;
    yy = y + i * sh;
    c = d >= -2 ? 0xFF3A2A : d >= -12 ? CAMB : CGRN;
    ui_col(db >= d || (hd >= d && hd < d + 2) ? c : ui_mix(c, 0x000000, 0.8));
    gfx_rect(x * sc, (yy + 0.5) * sc, 14 * sc, (sh - 1.2) * sc);
    i += 1;
  );
  // RMS: a continuous bar
  rh = min(max((rd + 54) / 54, 0), 1) * h;
  ui_col(0x22282C); gfx_rect((x + 17) * sc, y * sc, 7 * sc, h * sc);
  ui_col(0x8FD3E8); gfx_rect((x + 17) * sc, (y + h - rh) * sc, 7 * sc, rh * sc);
);

// ---------- chassis and header ----------
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
pk_chassis(8 * sc, 4 * sc, 1184 * sc, 450 * sc, PNL);
ui_col(HDR); ui_rrect(9 * sc, 5 * sc, 1182 * sc, 58 * sc, 5 * sc); gfx_rect(9 * sc, 40 * sc, 1182 * sc, 23 * sc);
gfx_gradrect(9 * sc, 5 * sc, 1182 * sc, 26 * sc, 1, 1, 1, 0.06, 0, 0, 0, 0, 0, 0, 0, -0.06 / (26 * sc));
ui_col(RED); gfx_rect(9 * sc, 63 * sc, 1182 * sc, 3 * sc);
ui_cola(0x000000, 0.25); gfx_rect(9 * sc, 66 * sc, 1182 * sc, 1 * sc);
rd_badge(40, 34, 15, WHT, HDR);
gfx_setfont(6, "Trebuchet MS", 26 * sc, 'b'); ui_col(WHT); gfx_x = 66 * sc; gfx_y = 18 * sc; gfx_drawstr("BERN 16");
gfx_setfont(6, "Trebuchet MS", 14 * sc, 'b'); ui_col(0xE8A09A); gfx_x = 196 * sc; gfx_y = 20 * sc; gfx_drawstr("BROADCAST SUMMING");
gfx_setfont(5); ui_cola(WHT, 0.65); gfx_x = 196 * sc; gfx_y = 38 * sc; gfx_drawstr("16 MONO CHANNELS  >  STEREO BUS");
pk_pextra = "Reset all to defaults";   // the house preset display: PRESETS, prev / next, LCD (click it for the list)
k_ = pk_preset(640 * sc, 16 * sc, 420 * sc, 36 * sc, pr_cur,
  "Init|Clean Bus|Warm Iron|Drum Bus Glue|Pushed Console|Dark Broadcast|Bright Lift|Tired Supply|Stereo Pairs|Wide Fan|Mono Check");
k_ > 0 ? ( load_preset(k_); pr_cur = k_ > 11 ? 0 : k_; );
ui_size_picker(1112 * sc, 25 * sc);

// ---------- channel strips ----------
gk = 0;
loop(16,
  cx = 48 + gk * 52;
  ui_col((gk >> 2) & 1 ? SHB : SHA); gfx_rect((cx - 26) * sc, 72 * sc, 52 * sc, 372 * sc);
  gk % 4 == 0 && gk ? ( ui_cola(INK, 0.25); gfx_rect((cx - 26) * sc, 76 * sc, 1 * sc, 364 * sc); );
  // number plate and the scribble strip (tape)
  ui_col(0x2A3035); gfx_rect((cx - 21) * sc, 78 * sc, 42 * sc, 20 * sc);
  gfx_setfont(6, "Trebuchet MS", 15 * sc, 'b'); ui_col(WHT); sprintf(#gn, "%d", gk + 1); ui_text(cx * sc, 80 * sc, #gn);
  ui_cola(0x000000, 0.18); gfx_rect((cx - 22) * sc, 103 * sc, 46 * sc, 16 * sc);
  ui_col(WHT); gfx_rect((cx - 23) * sc, 102 * sc, 46 * sc, 16 * sc);
  ui_namebox(cx, 103, 44, gk, "", INK);              // click to name the channel
  // GAIN and PAN
  sprintf(#gv, "%+.1f dB", slider(1 + gk)); dy_knob(cx, 150, 15, 1 + gk, -24, 24, 0, 0, RED, "GAIN", #gv);
  slider(17 + gk) == 0 ? strcpy(#gv, "C") : sprintf(#gv, "%s%.0f", slider(17 + gk) < 0 ? "L" : "R", abs(slider(17 + gk)));
  dy_knob(cx, 228, 12, 17 + gk, -100, 100, 0, 0, CPAN, "PAN", #gv);
  // meter (after the gain), held so it does not flicker between audio blocks
  GZH[gk] = max(BZPK[gk], GZH[gk] * 0.88); BZPK[gk] = 0;
  gz_cmeter(cx - 5, 272, 112, BZGT[gk] > 0 ? GZH[gk] : 0, BZGT[gk] > 0 ? GZH[gk] : 0);
  // SOLO / MUTE
  gz_key(cx - 23, 400, 22, 30, slider(49 + gk) > 0.5, LK_YEL, "S") ? ( slider(49 + gk) = slider(49 + gk) > 0.5 ? 0 : 1; ui_auto(49 + gk); );
  gz_key(cx + 1, 400, 22, 30, slider(33 + gk) > 0.5, LK_RED, "M") ? ( slider(33 + gk) = slider(33 + gk) > 0.5 ? 0 : 1; ui_auto(33 + gk); );
  gk += 1;
);

// ---------- master ----------
pk_inset(872 * sc, 78 * sc, 310 * sc, 360 * sc, MST);
gfx_setfont(6, "Trebuchet MS", 15 * sc, 'b'); ui_col(INK); gfx_x = 884 * sc; gfx_y = 84 * sc; gfx_drawstr("MASTER");
ui_col(RED); gfx_rect(884 * sc, 103 * sc, 166 * sc, 2 * sc);
sprintf(#gv, "+%.1f dB", slider65); dy_knob(916, 150, 22, 65, 0, 18, 0, 0, CDRV, "DRIVE", #gv);
slider66 == 0 ? strcpy(#gv, "FLAT") : sprintf(#gv, "%s %.0f", slider66 < 0 ? "DARK" : "BRIGHT", abs(slider66));
dy_knob(1012, 150, 22, 66, -100, 100, 0, 0, CTON, "TONE", #gv);
gz_lbl(968, 180, "DARK", 0.6); gz_lbl(1058, 180, "BRIGHT", 0.6);
// keys: COLOUR, IRON, MONO, and the SOLO light (flashes while anything is soloed)
gz_key(884, 212, 38, 24, slider67 > 0.5, LK_AMB, "") ? ( slider67 = slider67 > 0.5 ? 0 : 1; ui_auto(67); );
gz_key(932, 212, 38, 24, slider68 > 0.5, LK_YEL, "") ? ( slider68 = slider68 > 0.5 ? 0 : 1; ui_auto(68); );
gz_key(980, 212, 38, 24, slider70 > 0.5, LK_RED, "") ? ( slider70 = slider70 > 0.5 ? 0 : 1; ui_auto(70); );
gz_lbl(903, 240, "COLOUR", 0.9); gz_lbl(951, 240, "IRON", 0.9); gz_lbl(999, 240, "MONO", 0.9);
gfl = bz_solo && (time_precise() * 2.5) % 1 < 0.6;
rd_led(1040, 224, 6, gfl, 0xFFB030); gz_lbl(1040, 240, "SOLO", 0.9);
// VOLUME
sprintf(#gv, "%+.1f dB", slider69); dy_knob(964, 316, 32, 69, -24, 12, 0, 0, CVOL, "VOLUME", #gv);
// DRIFT (small cap) and the house IN / OUT pair (SAT)
dy_kst = 20; sprintf(#gv, "%.0f%%", slider71); dy_knob(898, 398, 12, 71, 0, 100, 20, 0, CDRF, "DRIFT", #gv); dy_kst = 7;
ins_io(952, 386, 72, INK);
// meters
gfx_setfont(4); ui_col(INK);
ui_text(1090 * sc, 84 * sc, "L"); ui_text(1150 * sc, 84 * sc, "R");
gx_ = 1068; ui_cola(INK, 0.7);
gi = 0; loop(7, gd_ = gi == 0 ? 0 : gi == 1 ? -6 : gi == 2 ? -12 : gi == 3 ? -18 : gi == 4 ? -24 : gi == 5 ? -36 : -54;
  sprintf(#gs, "%d", gd_); gy_ = 100 + (-gd_ / 54) * 286 * 26 / 27 + 4;
  ui_text(1120 * sc, (gy_ - 5) * sc, #gs); gi += 1; );
gz_pdl = max(bz_pkl, gz_pdl * 0.86); gz_pdr = max(bz_pkr, gz_pdr * 0.86); bz_pkl = bz_pkr = 0;
gz_hl = gz_pdl > gz_hl ? ( gz_htl = time_precise(); gz_pdl ) : time_precise() - gz_htl > 1.5 ? gz_hl * 0.97 : gz_hl;
gz_hr = gz_pdr > gz_hr ? ( gz_htr = time_precise(); gz_pdr ) : time_precise() - gz_htr > 1.5 ? gz_hr * 0.97 : gz_hr;
gz_mmeter(1080, 100, 286, gz_pdl, gz_hl, bz_rml);
gz_mmeter(1140, 100, 286, gz_pdr, gz_hr, bz_rmr);
pressed && drag_id == 0 && mouse_x >= 1076 * sc && mouse_x < 1170 * sc && mouse_y >= 96 * sc && mouse_y < 390 * sc ? (
  drag_id = -1; gz_hl = gz_hr = 0; );
gz_ml = 20 * log10(max(gz_hl, 0.00001)); gz_mr = 20 * log10(max(gz_hr, 0.00001));
gfx_setfont(5); ui_col(INK);
gz_ml < -90 ? strcpy(#gs, "-inf") : sprintf(#gs, "%.1f", gz_ml); ui_text(1092 * sc, 396 * sc, #gs);
gz_mr < -90 ? strcpy(#gs, "-inf") : sprintf(#gs, "%.1f", gz_mr); ui_text(1152 * sc, 396 * sc, #gs);
gz_lbl(1122, 416, "PEAK  /  RMS  dBFS", 0.75);

pk_end();
ui_end();
