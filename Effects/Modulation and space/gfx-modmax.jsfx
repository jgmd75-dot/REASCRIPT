desc:ModMax [modulation] (GFX)
//tags: chorus flanger phaser modulation bbd thru-zero jet tape opto stereo
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-lfo, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// MODMAX - one rack unit with three modulation engines, chosen with the CHORUS / FLANGER / PHASER keys.
// Each engine is the GFX Chorus, GFX Flanger and GFX Phaser, ported sample for sample (same sound at the same settings).
// Only the selected engine runs; a mode change crossfades the engines (equal power, 50 ms: the old engine's tail
// fades out under the new one). Every engine keeps its own settings: switching mode brings back that mode's last
// settings, and the presets set all three.
//
// The panel: the shared controls sit in the same places and are relabelled per mode; each mode's own extras show only
// in that mode (the keys and drop-downs under the display, the first knob of the lower row).
//   RATE    - the LFO speed in Hz (FREE), or a tempo division from the drop-down (SYNC: locked to the bar while the
//             project plays; FLOW: the tempo's rate, the phase runs on freely). Phaser TAPE + HAND: the hand speed.
//   DEPTH   - CHORUS: the sweep depth in ms. FLANGER: WIDTH, how far the sweep travels. PHASER: DEPTH.
//   CENTRE  - CHORUS: the delay the sweep centres on (ms). FLANGER: MANUAL, where the sweep sits. PHASER: CENTRE.
//   TONE / REGEN / FEEDBACK - CHORUS: the BBD tone (a low-pass). FLANGER: REGEN (+ ringing jet, - hollow).
//             PHASER: FEEDBACK (+ / -).
//   WIDTH / SPREAD - CHORUS: WIDTH, the right side's sweep against the left. FLANGER / PHASER: SPREAD, the right
//             LFO's phase offset (0 = mono sweep, 90 - 180 = wide stereo motion).
//   MIX     - dry / effect balance.
//   CHORUS extras: voice I (slow, gentle), II (faster), I+II (both sweeps), OFF (the chorus out: the input and
//             output stages stay active); the voice keys set RATE / DEPTH / CENTRE to the classic values. HISS: the
//             BBD noise.
//   FLANGER extras: type PEDAL (a dark BBD loop), RACK (a wide clean studio sweep), THRU-0 (two-tape through-zero);
//             SWEEP: LFO, MATRIX (the sweep stops and MANUAL places the comb by hand), ENVELOPE (the input drives
//             the sweep; SENS sets how far); LFO SHAPE: sine, triangle, square, random.
//   PHASER extras: voicing 90 (the script-logo pedal), OPTO (a lamp-and-cell sweep), TAPE (two-tape phasing);
//             LFO SHAPE; STAGES 2 - 12 (90 / OPTO); SCRIPT / BLOCK (90: feedback 0 / 40 %); MOTION (TAPE: the LFO,
//             a hand on the tape (random drift at the RATE), or both).
//   DRIFT   - per mode, each engine's own slow random wander (CHORUS: rate, depth, tone; FLANGER: rate, width,
//             manual; PHASER: rate, depth, centre). 50 % = standard, 100 % = twice, 0 = none.
//   LOW CUT - per mode, a high-pass on the effected signal only (20 = off): the bass stays dry and centred.
//   SAT     - per mode, the house band saturation (lows and highs; PHASER defaults to 20 % as before).
//   CLASSIC (header key) - the panel face: off, one graphite face lit in the mode's colour; on, each mode wears its
//             original unit's look (CHORUS teal enamel, FLANGER dove-grey rack, PHASER dark with voicing colours).
//   TRIM / GUARD - the input stage (shared). OUTPUT - the output level (shared). The output stage is straight
//             through (no clip), as the three mix tools were.
// Any key that changes an engine's structure (voice, type, sweep, shape, stages, motion) and a SYNC phase relock
// dip that engine's effect for ~25 ms while it switches: no clicks.

import gfx-drift.jsfx-inc
import gfx-lfo.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<0,2,1{Chorus,Flanger,Phaser}>-Mode
slider2:0<-24,12,0.1>-Output (dB)
slider3:0<-24,12,0.1>-Input trim (dB)
slider4:1<0,1,1{Off,On}>-Input guard
slider5:30<0,100,1>-Sat bias (%)
slider6:120<40,400,1>-Sat low band (Hz)
slider7:6000<2000,16000,10>-Sat high band (Hz)
slider8:0<0,3,1{I,II,I+II,Off}>-Chorus voice
slider9:0<0,2,1{Free,Sync,Flow}>-Chorus rate mode
slider10:0.513<0.05,12,0.001>-Chorus free rate (Hz)
slider11:3<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Chorus sync rate
slider12:1.85<0,3,0.01>-Chorus depth (ms)
slider13:3.5<1,8,0.01>-Chorus centre (ms)
slider14:100<0,100,1>-Chorus width (%)
slider15:60<0,100,1>-Chorus BBD tone (%)
slider16:0<0,100,1>-Chorus hiss (%)
slider17:50<0,100,1>-Chorus mix (%)
slider18:5<0,50,1>-Chorus rate drift (%)
slider19:10<0,50,1>-Chorus depth drift (%)
slider20:10<0,50,1>-Chorus tone drift (%)
slider21:0.25<0.02,2,0.01>-Chorus drift speed (Hz)
slider22:0<0,100,1>-Chorus band sat (%)
slider23:20<20,500,1>-Chorus wet low cut (Hz, 20 = off)
slider24:50<0,100,1>-Chorus drift (%)
slider25:0<0,2,1{Pedal,Rack,Thru-zero}>-Flanger type
slider26:1<0,3,1{Sine,Triangle,Square,Random}>-Flanger shape
slider27:0<0,2,1{Free,Sync,Flow}>-Flanger rate mode
slider28:0.25<0.02,10,0.01>-Flanger free rate (Hz)
slider29:2<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Flanger sync rate
slider30:40<0,100,1>-Flanger manual (%)
slider31:70<0,100,1>-Flanger width (%)
slider32:50<-95,95,1>-Flanger regen (%)
slider33:0<0,180,1>-Flanger spread (deg)
slider34:50<0,100,1>-Flanger mix (%)
slider35:0<0,2,1{LFO,Matrix,Envelope}>-Flanger sweep
slider36:50<0,100,1>-Flanger envelope sens (%)
slider37:5<0,50,1>-Flanger rate drift (%)
slider38:10<0,50,1>-Flanger width drift (%)
slider39:5<0,50,1>-Flanger manual drift (%)
slider40:0.25<0.02,2,0.01>-Flanger drift speed (Hz)
slider41:0<0,100,1>-Flanger band sat (%)
slider42:20<20,500,1>-Flanger wet low cut (Hz, 20 = off)
slider43:50<0,100,1>-Flanger drift (%)
slider44:0<0,2,1{90,Opto,Tape}>-Phaser voicing
slider45:1<0,4,1{2,4,6,8,12}>-Phaser stages
slider46:1<0,3,1{Sine,Triangle,Square,Random}>-Phaser shape
slider47:0<0,2,1{Free,Sync,Flow}>-Phaser rate mode
slider48:0.5<0.02,10,0.01>-Phaser free rate (Hz)
slider49:2<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Phaser sync rate
slider50:50<0,100,1>-Phaser centre (%)
slider51:70<0,100,1>-Phaser depth (%)
slider52:0<-95,95,1>-Phaser feedback (%)
slider53:0<0,180,1>-Phaser spread (deg)
slider54:50<0,100,1>-Phaser mix (%)
slider55:5<0,50,1>-Phaser rate drift (%)
slider56:10<0,50,1>-Phaser depth drift (%)
slider57:10<0,50,1>-Phaser centre drift (%)
slider58:0.25<0.02,2,0.01>-Phaser drift speed (Hz)
slider59:1<0,2,1{LFO,Drift,Both}>-Phaser tape motion
slider60:20<0,100,1>-Phaser band sat (%)
slider61:20<20,500,1>-Phaser wet low cut (Hz, 20 = off)
slider62:50<0,100,1>-Phaser drift (%)
slider63:prs_sel=0<0,13,1{No preset,Init,Chorus: Classic II,Chorus: Classic I+II,Chorus: Lush Wide,Chorus: Dark Bucket,Flanger: Jet Plane,Flanger: Negative Hollow,Flanger: Thru-Zero Tape,Flanger: Envelope Swoosh,Phaser: 90 Script,Phaser: Opto Stereo Swirl,Phaser: Opto Vibrato,Phaser: Hand Tape Phasing}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-modmax";                                  // the ? pop-up links to this manual

// ======================================== shared helpers ========================================
// clean below -3 dBFS, rounds off peaks above (FLANGER / PHASER: keeps high regen from running away)
function mm_sat(x) local(a) (
  a = abs(x);
  a < 0.7 ? x : sign(x) * (0.7 + 0.3 * lfo_tanh((a - 0.7) / 0.3));
);
// LOW CUT: a 12 dB/oct high-pass on the wet signal only (each engine its own coefficients)
function wlc(x, b0, a1, a2) instance(x1, x2, y1, y2) local(y) (
  y = b0 * (x - 2 * x1 + x2) - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
function wlc_set(f) local(w0, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; al = sin(w0) / (2 * 0.7071); n = 1 + al;
  wl_b0 = (1 + cos(w0)) * 0.5 / n; wl_a1 = -2 * cos(w0) / n; wl_a2 = (1 - al) / n;
);
function wlc_z() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
// SYNC: the phase lock to the project (the LFOs run as FLOW; the lock is done here so a jump can dip the effect)
function mm_lock(lenq) local(t) ( t = beat_position / lenq; t - floor(t); );
function mm_perr(t, p) local(e) ( e = t - p; e - floor(e + 0.5); );

// ======================================== memory ========================================
C_BL = 0; C_BR = 8192;                                 // chorus: two BBD lines (8192 each)
F_FBL = 16384; F_FBR = F_FBL + 32768;                  // flanger: the flange lines (with regen) ...
F_CBL = F_FBR + 32768; F_CBR = F_CBL + 32768;          // ... and the clean lines (the delayed dry path for THRU-0)
P_APX = F_CBR + 32768; P_APY = P_APX + 32;             // phaser: all-pass states (2 x 12 stages)
P_TBL = P_APX + 1024; P_TBR = P_TBL + 8192;            // phaser TAPE: the swept and the clean tape lines
P_CBL = P_TBR + 8192; P_CBR = P_CBL + 8192;
memset(0, 0, P_CBR + 8192);

// ======================================== CHORUS engine (GFX Chorus) ========================================
// fractional delay read, 4-point Hermite
function c_dread(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = c_wp - d;
  rp < 0 ? rp += 8192;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + 8192 - 1) & 8191];
  x0  = buf[i & 8191];
  x1  = buf[(i + 1) & 8191];
  x2  = buf[(i + 2) & 8191];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
// one BBD line: pre-filter, delay, gentle companding saturation, 2-pole post-filter; d2 >= 0: a second tap (I+II)
function c_bbd(x, buf, d, d2, c, hs) instance(pre, p1, p2) local(y) (
  pre += (x + hs - pre) * c;
  buf[c_wp] = pre;
  y = c_dread(buf, d);
  d2 >= 0 ? y = 0.5 * (y + c_dread(buf, d2));
  y = ost_tanh(y * 1.15) / 1.15;
  p1 += (y - p1) * c;
  p2 += (p1 - p2) * c;
  p2;
);
function c_bbdz() instance(pre, p1, p2) ( pre = p1 = p2 = 0; );
// the voice keys set RATE / DEPTH / CENTRE to the classic values
function chorus_mode(m) (
  slider8 = m;
  m == 0 ? ( slider9 = 0; slider10 = 0.513; slider12 = 1.85; slider13 = 3.5; ) :
  m == 1 ? ( slider9 = 0; slider10 = 0.863; slider12 = 1.85; slider13 = 3.5; ) :
  m == 2 ? ( slider9 = 0; slider10 = 0.513; slider12 = 1.85; slider13 = 3.5; );
  ui_auto(8); ui_auto(9); ui_auto(10); ui_auto(12); ui_auto(13);
);
function c_update() (
  c_wl_on = slider23 > 20.5; c_wl_on ? ( wlc_set(slider23); c_b0 = wl_b0; c_a1 = wl_a1; c_a2 = wl_a2; );
  c_voice = floor(slider8 + 0.5);
  c_two_t = c_voice == 2;
  c_rm = floor(slider9 + 0.5);
  c_frate = slider10;
  c_div = floor(slider11 + 0.5);
  c_dep_t = slider12;
  c_cen_t = slider13;
  c_wid_t = slider14 / 100;
  c_tone = slider15 / 100;
  c_hiss = (slider16 / 100) ^ 2 * 0.004;
  c_mix_t = slider17 / 100;
  drift_macro(slider24);
  c_rd = slider18 / 100 * dm_a;
  c_dd = min(slider19 / 100 * dm_a, 1);
  c_td = slider20 / 100 * dm_a;
  c_dspd = slider21 * dm_s;
  c_lfoA.lfo_setup(1, 0); c_lfoB.lfo_setup(1, 0);
);
function c_reset() (
  memset(C_BL, 0, 16384); c_wp = 0;
  c_bL.c_bbdz(); c_bR.c_bbdz(); c_WLL.wlc_z(); c_WLR.wlc_z(); c_WDL.wlc_z(); c_WDR.wlc_z();
  c_dep_s = c_dep_t; c_cen_s = c_cen_t; c_wid_s = c_wid_t; c_mix_s = c_mix_t;
);
function c_apply() ( c_two = c_two_t; );
function c_tick() local(dinc, vR, vD, vT, lv, de, dmsL, dmsR, fc, cf, lv2, d2L, d2R, wL, wR) (
  dinc = c_dspd / srate;
  vR = c_drR.drift_tick(dinc);
  vD = c_drD.drift_tick(dinc);
  vT = c_drT.drift_tick(dinc);
  c_dep_s += (c_dep_t - c_dep_s) * sm;
  c_cen_s += (c_cen_t - c_cen_s) * sm;
  c_wid_s += (c_wid_t - c_wid_s) * sm;
  c_mix_s += (c_mix_t - c_mix_s) * sm;
  lv = c_lfoA.lfo_tick(0, c_rd, vR);
  de = c_dep_s * (1 - c_dd * (0.5 + 0.5 * vD));
  dmsL = max(c_cen_s + de * lv, 0.3);
  dmsR = max(c_cen_s + de * lv * (1 - 2 * c_wid_s), 0.3);
  fc = 3000 * (16000 / 3000) ^ min(max(c_tone + c_td * 0.25 * vT, 0), 1);
  cf = 1 - exp(-2 * $pi * min(fc, srate * 0.45) / srate);
  c_two ? (
    lv2 = c_lfoB.lfo_tick(0, c_rd, vR);
    d2L = max(c_cen_s + 0.8 - de * lv2, 0.3) * msr;
    d2R = max(c_cen_s + 0.8 - de * lv2 * (1 - 2 * c_wid_s), 0.3) * msr;
  ) : ( d2L = d2R = -1; );
  wL = c_bL.c_bbd(inL, C_BL, dmsL * msr, d2L, cf, c_hiss * (rand(2) - 1));
  wR = c_bR.c_bbd(inR, C_BR, dmsR * msr, d2R, cf, c_hiss * (rand(2) - 1));
  c_wp = (c_wp + 1) & 8191;
  c_oL = c_wl_on ? inL + c_mix_s * (c_WLL.wlc(wL, c_b0, c_a1, c_a2) - c_WDL.wlc(inL, c_b0, c_a1, c_a2)) : (1 - c_mix_s) * inL + c_mix_s * wL;
  c_oR = c_wl_on ? inR + c_mix_s * (c_WLR.wlc(wR, c_b0, c_a1, c_a2) - c_WDR.wlc(inR, c_b0, c_a1, c_a2)) : (1 - c_mix_s) * inR + c_mix_s * wR;
  c_dispL = dmsL; c_dispR = dmsR; c_dispP = c_lfoA.p;
);

// ======================================== FLANGER engine (GFX Flanger) ========================================
function f_dread(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = f_wp - d;
  rp < 0 ? rp += 32768;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + 32768 - 1) & 32767];
  x0  = buf[i & 32767];
  x1  = buf[(i + 1) & 32767];
  x2  = buf[(i + 2) & 32767];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
// delay (ms) for a sweep position u (-1 .. 1) around the manual setting, per type
function f_del_ms(man, wid, u) local(lo, hi, c, d) (
  f_type == 2 ? (
    c = 0.25 + man * 4.75;                          // thru-zero: the dry path sits at c ms ...
    max(c * (1 + 1.25 * wid * u), 0.02);            // ... and the swept copy passes through it
  ) : (
    lo = f_type ? 0.15 : 0.3; hi = f_type ? 14 : 6;
    c = lo * (hi / lo) ^ man;                       // MANUAL: log between the type's limits
    d = c * 2 ^ (wid * u * (f_type ? 3.2 : 2.2));   // WIDTH: octaves of sweep either side
    min(max(d, lo * 0.5), hi * 1.3);
  );
);
function f_update() (
  f_wl_on = slider42 > 20.5; f_wl_on ? ( wlc_set(slider42); f_b0 = wl_b0; f_a1 = wl_a1; f_a2 = wl_a2; );
  f_type_t = floor(slider25 + 0.5);
  f_shape_t = floor(slider26 + 0.5);
  f_rm = floor(slider27 + 0.5);
  f_frate = slider28;
  f_div = floor(slider29 + 0.5);
  f_man_t = slider30 / 100;
  f_wid_t = slider31 / 100;
  f_fb_t = slider32 / 100;
  f_spr_t = slider33 / 360;
  f_mix_t = slider34 / 100;
  f_sweep_t = floor(slider35 + 0.5);
  f_sens = slider36 / 100;
  drift_macro(slider43);
  f_rd = slider37 / 100 * dm_a; f_wd = min(slider38 / 100 * dm_a, 1); f_md = slider39 / 100 * dm_a;
  f_dspd = slider40 * dm_s;
  f_lfoL.lfo_setup(f_shape, 0.2);
  f_lfoR.lfo_setup(f_shape, 0.2);
  f_lpc = 1 - exp(-2 * $pi * min(f_type == 0 ? 6500 : 15000, srate * 0.45) / srate);   // PEDAL: the BBD's darker loop
);
function f_reset() (
  memset(F_FBL, 0, 4 * 32768); f_wp = 0;
  f_fL = f_fR = f_lpL = f_lpR = f_env = 0;
  f_WLL.wlc_z(); f_WLR.wlc_z(); f_WDL.wlc_z(); f_WDR.wlc_z();
  f_man_s = f_man_t; f_wid_s = f_wid_t; f_fb_s = f_fb_t; f_mix_s = f_mix_t; f_spr_s = f_spr_t;
  f_dL_s = f_del_ms(f_man_t, 0, 0) * srate / 1000; f_dR_s = f_dL_s;
);
function f_apply() (
  f_type = f_type_t; f_shape = f_shape_t; f_sweep = f_sweep_t;
  f_lfoL.lfo_setup(f_shape, 0.2); f_lfoR.lfo_setup(f_shape, 0.2);
  f_lpc = 1 - exp(-2 * $pi * min(f_type == 0 ? 6500 : 15000, srate * 0.45) / srate);
);
function f_tick() local(dinc, vR, vW, vM, lvL, lvR, lv, uL, uR, mn, wi, dL, dR, wL, wR, xL, xR, dc, fbc) (
  dinc = f_dspd / srate;
  vR = f_drR.drift_tick(dinc); vW = f_drW.drift_tick(dinc); vM = f_drM.drift_tick(dinc);
  f_man_s += (f_man_t - f_man_s) * sm;
  f_wid_s += (f_wid_t - f_wid_s) * sm;
  f_fb_s  += (f_fb_t  - f_fb_s)  * sm;
  f_mix_s += (f_mix_t - f_mix_s) * sm;
  f_spr_s += (f_spr_t - f_spr_s) * sm;
  // the sweep: LFO, frozen (MATRIX) or the input's envelope (ENVELOPE)
  lvL = f_lfoL.lfo_tick(0, f_rd, vR);
  lvR = f_lfoR.lfo_tick(f_spr_s, f_rd, vR);
  lv = max(abs(inL), abs(inR));
  f_env += (lv - f_env) * (lv > f_env ? f_env_a : f_env_r);
  f_sweep == 1 ? ( uL = 0; uR = 0; ) :
  f_sweep == 2 ? ( uL = min(f_env * (1 + 12 * f_sens), 1) * 2 - 1; uR = uL; ) : ( uL = lvL; uR = lvR; );
  mn = min(max(f_man_s + f_md * 0.25 * vM, 0), 1);
  wi = f_wid_s * (1 - f_wd * (0.5 + 0.5 * vW));
  f_sweep == 1 ? wi = 0;
  f_dL_s += (f_del_ms(mn, wi, uL) * srate / 1000 - f_dL_s) * f_dsm;
  f_dR_s += (f_del_ms(mn, wi, uR) * srate / 1000 - f_dR_s) * f_dsm;
  dL = max(f_dL_s, 1); dR = max(f_dR_s, 1);
  // the flange lines: write input + regen, read the swept tap
  F_FBL[f_wp] = inL + f_fb_s * f_fL; F_FBR[f_wp] = inR + f_fb_s * f_fR;
  F_CBL[f_wp] = inL; F_CBR[f_wp] = inR;
  wL = f_dread(F_FBL, dL); wR = f_dread(F_FBR, dR);
  f_lpL += (wL - f_lpL) * f_lpc; f_lpR += (wR - f_lpR) * f_lpc;     // loop tone (PEDAL darker)
  f_type == 0 ? ( f_lpL += (rand(2) - 1) * 0.00002; f_lpR += (rand(2) - 1) * 0.00002; );   // the delay chips' faint hiss
  f_fL = mm_sat(f_lpL); f_fR = mm_sat(f_lpR);
  // dry path: straight, or delayed to the sweep's centre in THRU-0 so the copy can cross it
  f_type == 2 ? (
    dc = (0.25 + mn * 4.75) * srate / 1000;
    xL = f_dread(F_CBL, dc); xR = f_dread(F_CBR, dc);
  ) : ( xL = inL; xR = inR; );
  fbc = f_fb_s > 0 ? 1 / (1 + 1.2 * f_fb_s * f_fb_s) : 1 / (1 + 0.2 * f_fb_s * f_fb_s);   // level compensation for strong regen
  f_oL = f_wl_on ? xL + f_mix_s * (f_WLL.wlc(f_lpL * fbc, f_b0, f_a1, f_a2) - f_WDL.wlc(xL, f_b0, f_a1, f_a2)) : (1 - f_mix_s) * xL + f_mix_s * f_lpL * fbc;
  f_oR = f_wl_on ? xR + f_mix_s * (f_WLR.wlc(f_lpR * fbc, f_b0, f_a1, f_a2) - f_WDR.wlc(xR, f_b0, f_a1, f_a2)) : (1 - f_mix_s) * xR + f_mix_s * f_lpR * fbc;
  f_wp = (f_wp + 1) & 32767;
  f_dispMd = dL / srate * 1000; f_dispLv = lvL;
  f_dispDry = f_type == 2 ? (0.25 + mn * 4.75) : 0;
);

// ======================================== PHASER engine (GFX Phaser) ========================================
function p_ap_chain(x, base, n, a) local(i, y) (
  i = 0;
  loop(n,
    y = a * x + P_APX[base + i] - a * P_APY[base + i];
    P_APX[base + i] = x; P_APY[base + i] = y;
    x = y; i += 1;
  );
  x;
);
function p_dread(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = p_wp - d;
  rp < 0 ? rp += 8192;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + 8192 - 1) & 8191];
  x0  = buf[i & 8191];
  x1  = buf[(i + 1) & 8191];
  x2  = buf[(i + 2) & 8191];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
function p_update() (
  p_wl_on = slider61 > 20.5; p_wl_on ? ( wlc_set(slider61); p_b0 = wl_b0; p_a1 = wl_a1; p_a2 = wl_a2; );
  p_voice_t = floor(slider44 + 0.5);
  p_st = floor(slider45 + 0.5);
  p_nst_t = p_st == 0 ? 2 : p_st == 1 ? 4 : p_st == 2 ? 6 : p_st == 3 ? 8 : 12;
  p_shape_t = floor(slider46 + 0.5);
  p_rm = floor(slider47 + 0.5);
  p_frate = slider48;
  p_div = floor(slider49 + 0.5);
  p_cent_t = slider50 / 100;
  p_depth_t = slider51 / 100;
  p_fb_t = slider52 / 100;
  p_spr_t = slider53 / 360;
  p_mix_t = slider54 / 100;
  drift_macro(slider62);
  p_rd = slider55 / 100 * dm_a;
  p_dd = min(slider56 / 100 * dm_a, 1);
  p_cd = slider57 / 100 * dm_a;
  p_dspd = slider58 * dm_s;
  p_motion_t = floor(slider59 + 0.5);
  p_lfoL.lfo_setup(p_shape, 0.2);
  p_lfoR.lfo_setup(p_shape, 0.2);
);
function p_voicing() (
  p_voice == 1 ? ( p_fmin = 80;  p_fmax = 2000; p_oct = 3.5; )
               : ( p_fmin = 120; p_fmax = 2400; p_oct = 2.5; );
);
function p_reset() (
  memset(P_APX, 0, 64); memset(P_TBL, 0, 4 * 8192); p_wp = 0;
  p_optoL = 0.5; p_optoR = 0.5;
  p_fbL = p_fbR = p_tfbL = p_tfbR = p_lpL = p_lpR = 0;
  p_WLL.wlc_z(); p_WLR.wlc_z(); p_WDL.wlc_z(); p_WDR.wlc_z();
  p_cent_s = p_cent_t; p_depth_s = p_depth_t; p_fb_s = p_fb_t; p_mix_s = p_mix_t; p_spr_s = p_spr_t;
);
function p_apply() (
  p_nst != p_nst_t ? memset(P_APX, 0, 64);          // stages that join start from rest
  p_voice_t == 2 && p_voice != 2 ? ( p_tfbL = p_tfbR = 0; );   // into TAPE: its lines are already full (below)
  p_voice = p_voice_t; p_nst = p_nst_t; p_shape = p_shape_t; p_motion = p_motion_t;
  p_lfoL.lfo_setup(p_shape, 0.2); p_lfoR.lfo_setup(p_shape, 0.2);
  p_voicing();
);
function p_tick() local(dinc, vR, vD, vC, fbc, lvL, lvR, de, coct, hinc, hL, hR, mL, mR, c_ms, mdL, mdR, dL, dR,
                        uL, uR, fcc, fcL, fcR, tL, aL, tR, aR, yL, yR, oL, oR, sp) (
  dinc = p_dspd / srate;
  vR = p_drR.drift_tick(dinc);
  vD = p_drD.drift_tick(dinc);
  vC = p_drC.drift_tick(dinc);
  p_cent_s  += (p_cent_t  - p_cent_s)  * sm;
  p_depth_s += (p_depth_t - p_depth_s) * sm;
  p_fb_s    += (p_fb_t    - p_fb_s)    * sm;
  p_mix_s   += (p_mix_t   - p_mix_s)   * sm;
  p_spr_s   += (p_spr_t   - p_spr_s)   * sm;
  sp = p_spr_s;
  fbc = sqrt(1 - p_fb_s * p_fb_s);
  lvL = p_lfoL.lfo_tick(0, p_rd, vR);
  lvR = p_lfoR.lfo_tick(sp, p_rd, vR);
  de   = p_depth_s * (1 - p_dd * (0.5 + 0.5 * vD));
  coct = p_cd * vC * 1.5;
  p_voice == 2 ? (
    hinc = p_frate / srate;
    hL = p_dhL.drift_tick(hinc);
    hR = p_dhR.drift_tick(hinc);
    hR = hL + (hR - hL) * sp * 2;
    p_motion == 0 ? ( mL = lvL; mR = lvR; ) : (
      p_motion == 1 ? ( mL = hL; mR = hR; ) : ( mL = 0.5 * (lvL + hL); mR = 0.5 * (lvR + hR); );
    );
    c_ms = 0.6 + p_cent_s * 7.4;
    mdL = max(min(max(c_ms * 2 ^ (2 * de * mL + coct), 0.05), 10) * srate / 1000, 2);
    mdR = max(min(max(c_ms * 2 ^ (2 * de * mR + coct), 0.05), 10) * srate / 1000, 2);
    P_TBL[p_wp] = inL + p_fb_s * p_tfbL;
    P_TBR[p_wp] = inR + p_fb_s * p_tfbR;
    p_lpL += (p_dread(P_TBL, mdL) - p_lpL) * p_lpc;
    p_lpR += (p_dread(P_TBR, mdR) - p_lpR) * p_lpc;
    p_tfbL = mm_sat(p_lpL); p_tfbR = mm_sat(p_lpR);
    dL = p_dread(P_CBL, p_dryD); dR = p_dread(P_CBR, p_dryD);
    oL = p_wl_on ? dL + p_mix_s * (p_WLL.wlc(p_lpL * fbc, p_b0, p_a1, p_a2) - p_WDL.wlc(dL, p_b0, p_a1, p_a2)) : (1 - p_mix_s) * dL + p_mix_s * p_lpL * fbc;
    oR = p_wl_on ? dR + p_mix_s * (p_WLR.wlc(p_lpR * fbc, p_b0, p_a1, p_a2) - p_WDR.wlc(dR, p_b0, p_a1, p_a2)) : (1 - p_mix_s) * dR + p_mix_s * p_lpR * fbc;
    p_dispMd = mdL / srate * 1000;
  ) : (
    uL = 0.5 + 0.5 * lvL; uR = 0.5 + 0.5 * lvR;
    p_voice == 1 ? (
      p_optoL += (uL - p_optoL) * (uL > p_optoL ? p_a_fast : p_a_slow);
      p_optoR += (uR - p_optoR) * (uR > p_optoR ? p_a_fast : p_a_slow);
      uL = max(p_optoL, 0) ^ 0.8; uR = max(p_optoR, 0) ^ 0.8;
    ) : (
      uL = max(uL, 0) ^ 1.5; uR = max(uR, 0) ^ 1.5;
    );
    fcc = p_fmin * (p_fmax / p_fmin) ^ p_cent_s;
    fcL = min(max(fcc * 2 ^ (de * p_oct * (2 * uL - 1) + coct), 20), srate * 0.45);
    fcR = min(max(fcc * 2 ^ (de * p_oct * (2 * uR - 1) + coct), 20), srate * 0.45);
    tL = tan($pi * fcL / srate); aL = (tL - 1) / (tL + 1);
    tR = tan($pi * fcR / srate); aR = (tR - 1) / (tR + 1);
    yL = p_ap_chain(inL + p_fb_s * p_fbL, 0,  p_nst, aL);
    yR = p_ap_chain(inR + p_fb_s * p_fbR, 12, p_nst, aR);
    p_fbL = mm_sat(yL); p_fbR = mm_sat(yR);
    oL = p_wl_on ? inL + p_mix_s * (p_WLL.wlc(yL * fbc, p_b0, p_a1, p_a2) - p_WDL.wlc(inL, p_b0, p_a1, p_a2)) : (1 - p_mix_s) * inL + p_mix_s * yL * fbc;
    oR = p_wl_on ? inR + p_mix_s * (p_WLR.wlc(yR * fbc, p_b0, p_a1, p_a2) - p_WDR.wlc(inR, p_b0, p_a1, p_a2)) : (1 - p_mix_s) * inR + p_mix_s * yR * fbc;
    p_voice == 0 ? ( oL = mm_sat(oL); oR = mm_sat(oR); );
    p_dispFc = fcL; p_dispA = aL;
  );
  // the tape lines are fed in every voicing (90 / OPTO: the input only), so a change into TAPE finds them already
  // full of the current signal and the effect fades in with no gap or stale audio
  p_voice != 2 ? ( P_TBL[p_wp] = inL; P_TBR[p_wp] = inR; );
  P_CBL[p_wp] = inL; P_CBR[p_wp] = inR; p_wp = (p_wp + 1) & 8191;
  p_oL = oL; p_oR = oR;
  p_dispFb = p_fb_s; p_dispMix = p_mix_s; p_dispFbc = fbc; p_dispLv = lvL;
);

// ======================================== the unit ========================================
function update() (
  mm_mode = floor(slider1 + 0.5);
  out_t = 10 ^ (slider2 / 20);
  in_setup(slider3, slider4);
  c_update(); f_update(); p_update();
  mm_sat_t = mm_mode == 0 ? slider22 : mm_mode == 1 ? slider41 : slider60;
);

// ---------- presets (the core settings of all three engines; DRIFT, LOW CUT, SAT and the I/O stay as they are) ----------
// chorus: voice, rate mode, rate, sync div, depth, centre, width, tone, hiss, mix, rate / depth / tone drift
function ch_set(m, rm, fr, dv, dp, ce, wd, tn, hs, mx, r_, d_, t_) (
  slider8 = m; slider9 = rm; slider10 = fr; slider11 = dv; slider12 = dp; slider13 = ce;
  slider14 = wd; slider15 = tn; slider16 = hs; slider17 = mx; slider18 = r_; slider19 = d_; slider20 = t_;
);
// flanger: type, shape, rate mode, rate, sync div, manual, width, regen, spread, mix, sweep, sens
function fl_set(m, sh, sy, fr, dv, mn, wi, rg, sp, mx, sw, se) (
  slider25 = m; slider26 = sh; slider27 = sy; slider28 = fr; slider29 = dv; slider30 = mn; slider31 = wi;
  slider32 = rg; slider33 = sp; slider34 = mx; slider35 = sw; slider36 = se;
);
// phaser: voicing, stages, shape, rate mode, rate, sync div, centre, depth, feedback, spread, mix, rate / depth / centre drift, motion
function ph_set(v, st, sh, sy, fr, dv, ce, de, fb, sp, mx, r_, d_, c_, mo) (
  slider44 = v;  slider45 = st; slider46 = sh; slider47 = sy; slider48 = fr; slider49 = dv;
  slider50 = ce; slider51 = de; slider52 = fb; slider53 = sp; slider54 = mx;
  slider55 = r_; slider56 = d_; slider57 = c_; slider59 = mo;
);
function ch_def() ( ch_set(0, 0, 0.513, 3, 1.85, 3.5, 100, 60, 0, 50, 5, 10, 10); );
function fl_def() ( fl_set(0, 1, 0, 0.25, 2, 40, 70, 50, 0, 50, 0, 50); );
function ph_def() ( ph_set(0, 1, 1, 0, 0.5, 2, 50, 70, 0, 0, 50, 5, 10, 10, 1); );
MM_PRESETS = "Init|Chorus: Classic II|Chorus: Classic I+II|Chorus: Lush Wide|Chorus: Dark Bucket|Flanger: Jet Plane|Flanger: Negative Hollow|Flanger: Thru-Zero Tape|Flanger: Envelope Swoosh|Phaser: 90 Script|Phaser: Opto Stereo Swirl|Phaser: Opto Vibrato|Phaser: Hand Tape Phasing";
function load_preset(p) local(i) (
  p >= 1 && p <= 13 ? ( ch_def(); fl_def(); ph_def(); );
  p == 1  ? ( slider1 = 0; ) :                                                                        // Init
  p == 2  ? ( slider1 = 0; ch_set(1, 0, 0.863, 3, 1.85, 3.5, 100, 60,  0, 50,  5, 10, 10); ) :       // Classic II
  p == 3  ? ( slider1 = 0; ch_set(2, 0, 0.513, 3, 1.85, 3.5, 100, 60,  0, 50,  5, 10, 10); ) :       // Classic I+II
  p == 4  ? ( slider1 = 0; ch_set(1, 0, 0.6,   3, 2.5,  5.0, 100, 55,  0, 55, 10, 15, 10); ) :       // Lush Wide
  p == 5  ? ( slider1 = 0; ch_set(0, 0, 0.5,   3, 1.85, 3.5, 100, 20, 10, 50,  5, 10, 20); ) :       // Dark Bucket
  p == 6  ? ( slider1 = 1; fl_set(0, 1, 0, 0.1,  2, 35, 85,  85,  0, 50, 0, 50); ) :                 // Jet Plane
  p == 7  ? ( slider1 = 1; fl_set(0, 0, 0, 0.3,  2, 45, 60, -70,  0, 50, 0, 50); ) :                 // Negative Hollow
  p == 8  ? ( slider1 = 1; fl_set(2, 0, 0, 0.12, 2, 40, 80,   0,  0, 50, 0, 50); ) :                 // Thru-Zero Tape
  p == 9  ? ( slider1 = 1; fl_set(0, 1, 0, 0.25, 2, 20, 80,  60,  0, 50, 2, 70); ) :                 // Envelope Swoosh
  p == 10 ? ( slider1 = 2; ph_set(0, 1, 1, 0, 0.6,  2, 50, 80,  0,   0,  50, 5,  5,  5, 1); ) :      // 90 Script
  p == 11 ? ( slider1 = 2; ph_set(1, 4, 0, 0, 0.2,  2, 50, 85, 50, 180,  50, 8, 10, 10, 1); ) :      // Opto Stereo Swirl
  p == 12 ? ( slider1 = 2; ph_set(1, 1, 0, 0, 4.5,  2, 55, 50,  0,   0, 100, 5,  5,  0, 1); ) :      // Opto Vibrato
  p == 13 ? ( slider1 = 2; ph_set(2, 1, 0, 0, 0.15, 2, 30, 80,  0,  30,  50, 0, 15, 10, 1); );       // Hand Tape Phasing
  p == 14 ? (                                                                                         // Reset all to defaults
    slider1 = 0; slider2 = 0; slider3 = 0; slider4 = 1; slider5 = 30; slider6 = 120; slider7 = 6000;
    ch_def(); fl_def(); ph_def();
    slider21 = 0.25; slider22 = 0;  slider23 = 20; slider24 = 50;
    slider37 = 5; slider38 = 10; slider39 = 5; slider40 = 0.25; slider41 = 0; slider42 = 20; slider43 = 50;
    slider58 = 0.25; slider60 = 20; slider61 = 20; slider62 = 50;
  );
  p >= 1 && p <= 14 ? ( i = 1; loop(62, ui_auto(i); i += 1; ); );
);

// ---------- state ----------
sm  = 1 - exp(-1 / (0.03 * srate));
msr = srate / 1000;
xstep = 1 / (0.05 * srate);                 // mode crossfade: 50 ms
dstep = 1 / (0.012 * srate);                // structure dip: 12 ms down, 12 ms up
f_dsm = 1 - exp(-1 / (0.004 * srate));      // flanger delay-time smoothing (no zipper on MANUAL moves)
f_env_a = 1 - exp(-1 / (0.005 * srate)); f_env_r = 1 - exp(-1 / (0.18 * srate));
p_a_fast = 1 - exp(-1 / (0.008 * srate));
p_a_slow = 1 - exp(-1 / (0.12 * srate));
p_lpc = 1 - exp(-2 * $pi * min(12000, srate * 0.45) / srate);
p_dryD = 0.001 * srate;

c_lfoA.lfo_init(); c_lfoB.lfo_init();
c_drR.drift_init(0.8 + rand(0.5)); c_drD.drift_init(0.8 + rand(0.5)); c_drT.drift_init(0.8 + rand(0.5));
f_lfoL.lfo_init(); f_lfoR.lfo_init();
f_drR.drift_init(0.8 + rand(0.5)); f_drW.drift_init(0.8 + rand(0.5)); f_drM.drift_init(0.8 + rand(0.5));
p_lfoL.lfo_init(); p_lfoR.lfo_init();
p_drR.drift_init(0.8 + rand(0.5)); p_drD.drift_init(0.8 + rand(0.5)); p_drC.drift_init(0.8 + rand(0.5));
p_dhL.drift_init(0.8 + rand(0.5)); p_dhR.drift_init(0.8 + rand(0.5));

ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
!ui_dflt ? ui_thm = 5; !ui_dflt ? ui_hw = 1;   // defaults for new instances (saved projects keep their own)
pkL = 0; pkR = 0;

update();
c_apply(); f_apply(); p_apply();
c_reset(); f_reset(); p_reset();
c_x = c_on = mm_mode == 0 && c_voice != 3; f_x = f_on = mm_mode == 1; p_x = p_on = mm_mode == 2;
c_dk = f_dk = p_dk = 1; c_dq = 0; f_dq = 0; p_dq = 0;
c_rl = f_rl = p_rl = 0;
mm_sat_c = mm_sat_t;
ost_setup(mm_sat_c / 100, slider5 / 100, slider6, slider7, -0.3, 0);   // output stage: straight through
out_s = out_t;
ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
update();
blk_n = 0;
// SAT follows the mode (glides over a few blocks, so a mode change does not step the saturation)
mm_sat_c += (mm_sat_t - mm_sat_c) * min(samplesblock / (0.03 * srate), 1);
abs(mm_sat_t - mm_sat_c) < 0.01 ? mm_sat_c = mm_sat_t;
ost_setup(mm_sat_c / 100, slider5 / 100, slider6, slider7, -0.3, 0);   // output stage: straight through

// ---------- which engines run: the selected one (CHORUS OFF: none), plus any still fading out ----------
c_want = mm_mode == 0 && c_voice != 3; f_want = mm_mode == 1; p_want = mm_mode == 2;
c_want && !c_on ? ( c_apply(); c_reset(); c_on = 1; c_x = 0; c_dk = 1; c_dq = 0; c_rl = 0; );
f_want && !f_on ? ( f_apply(); f_reset(); f_on = 1; f_x = 0; f_dk = 1; f_dq = 0; f_rl = 0; );
p_want && !p_on ? ( p_apply(); p_reset(); p_on = 1; p_x = 0; p_dk = 1; p_dq = 0; p_rl = 0; );

// ---------- the LFOs (SYNC: the phase lock; a jump dips the engine instead of stepping the sweep) ----------
c_lfoA.lfo_block(c_rm ? 2 : 0, c_div, c_frate);
// I+II: the second sweep runs at II's speed relative to I (0.863 / 0.513). In SYNC it runs on freely at the
// scaled tempo rate (as in FLOW), since its phase can't lock to the bar at a non-musical ratio.
c_rm ? ( c_lfoB.lfo_block(2, c_div, 0); c_lfoB.inc *= 1.682; ) : c_lfoB.lfo_block(0, c_div, c_frate * 1.682);
c_rm == 1 && (play_state & 1) ? (
  c_tg = mm_lock(lfo_div_q(c_div));
  !c_on || abs(mm_perr(c_tg, c_lfoA.ph)) < 0.002 ? ( c_lfoA.ph = c_tg; c_rl = 0; ) : c_rl = 1;
) : c_rl = 0;
f_lfoL.lfo_block(f_rm ? 2 : 0, f_div, f_frate);
f_lfoR.lfo_block(f_rm ? 2 : 0, f_div, f_frate);
f_rm == 1 && (play_state & 1) ? (
  f_tg = mm_lock(lfo_div_q(f_div));
  !f_on || abs(mm_perr(f_tg, f_lfoL.ph)) < 0.002 ? ( f_lfoL.ph = f_lfoR.ph = f_tg; f_rl = 0; ) : f_rl = 1;
) : f_rl = 0;
p_lfoL.lfo_block(p_rm ? 2 : 0, p_div, p_frate);
p_lfoR.lfo_block(p_rm ? 2 : 0, p_div, p_frate);
p_rm == 1 && (play_state & 1) ? (
  p_tg = mm_lock(lfo_div_q(p_div));
  !p_on || abs(mm_perr(p_tg, p_lfoL.ph)) < 0.002 ? ( p_lfoL.ph = p_lfoR.ph = p_tg; p_rl = 0; ) : p_rl = 1;
) : p_rl = 0;

// ---------- structure changes: applied at once while an engine is idle, under a short dip while it runs ----------
c_pend = c_two_t != c_two || c_rl;
f_pend = f_type_t != f_type || f_shape_t != f_shape || f_sweep_t != f_sweep || f_rl;
p_pend = p_voice_t != p_voice || p_nst_t != p_nst || p_shape_t != p_shape || p_motion_t != p_motion || p_rl;
!c_on ? c_apply() : c_pend && c_dq == 0 ? c_dq = -1;
!f_on ? f_apply() : f_pend && f_dq == 0 ? f_dq = -1;
!p_on ? p_apply() : p_pend && p_dq == 0 ? p_dq = -1;
mm_fast = c_on + f_on + p_on == 1;

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_var(0, pr_cur);
file_var(0, mm_face);   // the panel face: 0 GRAPHITE, 1 CLASSIC
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// input stage: DC block, trim, guard
in_process(spl0, spl1);
inL = in_l; inR = in_r;
blk_n += 1;
oL = inL; oR = inR;

// ---------- CHORUS ----------
c_on ? (
  c_tick();
  c_g = 1;
  c_x < 1 || !c_want ? (
    c_want ? c_x = min(c_x + xstep, 1) : c_x = max(c_x - xstep, 0);
    c_g = sin(0.5 * $pi * c_x);
  );
  c_dq ? (
    c_dq < 0 ? ( c_dk -= dstep; c_dk <= 0 ? ( c_dk = 0; c_apply(); c_rl ? ( c_lfoA.ph = c_tg + c_lfoA.inc * blk_n; c_lfoA.ph -= floor(c_lfoA.ph); c_rl = 0; ); c_dq = 1; ); )
             : ( c_dk += dstep; c_dk >= 1 ? ( c_dk = 1; c_dq = 0; ); );
    c_g *= 0.5 - 0.5 * cos($pi * c_dk);
  );
  mm_fast && c_g == 1 ? ( oL = c_oL; oR = c_oR; ) : ( oL += c_g * (c_oL - inL); oR += c_g * (c_oR - inR); );
  !c_want && c_x <= 0 ? ( c_on = 0; mm_fast = c_on + f_on + p_on == 1; );
);
// ---------- FLANGER ----------
f_on ? (
  f_tick();
  f_g = 1;
  f_x < 1 || !f_want ? (
    f_want ? f_x = min(f_x + xstep, 1) : f_x = max(f_x - xstep, 0);
    f_g = sin(0.5 * $pi * f_x);
  );
  f_dq ? (
    f_dq < 0 ? ( f_dk -= dstep; f_dk <= 0 ? ( f_dk = 0; f_apply(); f_rl ? ( f_lfoL.ph = f_tg + f_lfoL.inc * blk_n; f_lfoL.ph -= floor(f_lfoL.ph); f_lfoR.ph = f_lfoL.ph; f_rl = 0; ); f_dq = 1; ); )
             : ( f_dk += dstep; f_dk >= 1 ? ( f_dk = 1; f_dq = 0; ); );
    f_g *= 0.5 - 0.5 * cos($pi * f_dk);
  );
  mm_fast && f_g == 1 ? ( oL = f_oL; oR = f_oR; ) : ( oL += f_g * (f_oL - inL); oR += f_g * (f_oR - inR); );
  !f_want && f_x <= 0 ? ( f_on = 0; mm_fast = c_on + f_on + p_on == 1; );
);
// ---------- PHASER ----------
p_on ? (
  p_tick();
  p_g = 1;
  p_x < 1 || !p_want ? (
    p_want ? p_x = min(p_x + xstep, 1) : p_x = max(p_x - xstep, 0);
    p_g = sin(0.5 * $pi * p_x);
  );
  p_dq ? (
    p_dq < 0 ? ( p_dk -= dstep; p_dk <= 0 ? ( p_dk = 0; p_apply(); p_rl ? ( p_lfoL.ph = p_tg + p_lfoL.inc * blk_n; p_lfoL.ph -= floor(p_lfoL.ph); p_lfoR.ph = p_lfoL.ph; p_rl = 0; ); p_dq = 1; ); )
             : ( p_dk += dstep; p_dk >= 1 ? ( p_dk = 1; p_dq = 0; ); );
    p_g *= 0.5 - 0.5 * cos($pi * p_dk);
  );
  mm_fast && p_g == 1 ? ( oL = p_oL; oR = p_oR; ) : ( oL += p_g * (p_oL - inL); oR += p_g * (p_oR - inR); );
  !p_want && p_x <= 0 ? ( p_on = 0; mm_fast = c_on + f_on + p_on == 1; );
);

// output stage: band saturation -> output gain (no clip: straight through)
out_s += (out_t - out_s) * sm;
oL = ostL.ost_band(oL) * out_s;
oR = ostR.ost_band(oR) * out_s;
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));

@gfx 1120 400
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1120, 400);
// ---------- two faces (the CLASSIC key in the header):
// GRAPHITE (default): one graphite rack face; the mode lights its own colour (CHORUS seafoam, FLANGER blue, PHASER orange).
// CLASSIC: each mode wears its original unit's look - CHORUS the teal enamel half-rack (cream print and caps),
// FLANGER the dove-grey 80s studio rack (blue print, silver caps, red LED readout), PHASER the dark stompbox-rack
// face with caps, keys and print in the voicing's colour (90 orange, OPTO yellow, TAPE blue).
WHT = 0xEEEFEA; YEL = 0xF2C83E; RED = 0xFF4A30;
CCH = 0x4FC1B5; CFL = 0x4A8FE8; CPH = 0xF07A2A;
mm_m = floor(slider1 + 0.5);
mm_cl = mm_face > 0.5;
!mm_cl ? (
  FACE = 0x2A2C30; INK = 0xE6E1D6; DIM = 0x8A867E;
  ACC = mm_m == 0 ? CCH : mm_m == 1 ? CFL : CPH;          // print, sections, LEDs
  KC = WHT; KST = 35; MXC = ACC; MXST = 36;                // main knob caps / style; MIX cap / style
  XC = ACC; XST = 36;                                      // the lower row's extra knob
  K1 = ACC; K2 = YEL; K3 = WHT; KS = CPH;                  // key colours: first row, second row, shape / rate rows, SCRIPT
  WIN = ui_mix(ACC, 0x000000, 0.86); LC = ui_mix(ACC, 0xFFFFFF, 0.25); SEGO = ui_mix(ACC, 0x000000, 0.9);
  IO1 = 0x3A3B40; IO2 = YEL; IOK = 35; OC = WHT; OST = 35; MNC = KC;
) : mm_m == 0 ? (
  FACE = 0x2C7C83; INK = 0xF1EBDD; DIM = 0xB9D6D4; ACC = 0xF1EBDD;
  KC = 0xF1EBDD; KST = 0; MXC = 0xF1EBDD; MXST = 0; XC = 0xFFC040; XST = 0;
  K1 = 0xF4F1E8; K2 = 0xFFC040; K3 = 0xF4F1E8; KS = CPH;
  WIN = 0x0F2A2C; LC = 0x7FF0E0; SEGO = 0x0F2A2C;
  IO1 = 0x1C4F55; IO2 = 0xFFC040; IOK = 20; OC = 0xF1EBDD; OST = 7; MXST = 7; MNC = KC;
) : mm_m == 1 ? (
  FACE = 0xC4C6C3; INK = 0x22262C; DIM = 0x5A6068; ACC = 0x2B5CA8;
  KC = 0xB9BDC2; KST = 7; MXC = 0x3A72C8; MXST = 7; XC = 0xF0A830; XST = 7;
  K1 = 0x4A8FE8; K2 = 0xF0A830; K3 = 0xF2F0E6; KS = CPH;
  WIN = 0x0C0607; LC = 0xFF2A1A; SEGO = 0x1C0604;
  IO1 = 0x2A2A2E; IO2 = 0xB9BDC2; IOK = 20; OC = 0xB9BDC2; OST = 7; MNC = 0x3A72C8;   // MANUAL: the blue hero knob
) : (
  FACE = 0x2A2C30; INK = 0xE6E1D6; DIM = 0x8A867E;
  ACC = p_voice == 1 ? 0xE8C040 : p_voice == 2 ? 0x3A9CFF : CPH;
  KC = ACC; KST = 0; MXC = ACC; MXST = 0; XC = ACC; XST = 0;
  K1 = ACC; K2 = ACC; K3 = ACC; KS = ACC;
  WIN = ui_mix(ACC, 0x000000, 0.84); LC = ui_mix(ACC, 0xFFFFFF, 0.1); SEGO = WIN;
  IO1 = 0x3A3B40; IO2 = YEL; IOK = 20; OC = ACC; OST = 0; MNC = KC;
);
dy_ink = INK; dy_bg = FACE;
function setv(idx, v) ( slider(idx) = v; ui_auto(idx); );
// panel keys: house lamp keys on the GRAPHITE face (gfx-ui; legends in font slot 15, set once per scale
// change); the CLASSIC faces keep their original square keys. oc = the CLASSIC key colour, lc = the lamp colour.
function mm_key(x, y, w, h, on, oc, lc, s) local(hit) (
  mm_cl ? ( hit = rd_sq(x, y, w, h, on, oc, s); ) : (
    sc != mm_lsc ? ( mm_lsc = sc; gfx_setfont(15, "Trebuchet MS", 9 * sc, 'b'); );
    lk_well = 0x141518; lk_font = 15; lk_font2 = 15;
    hit = lk_fit(x, y, w, h, on, lc, s);
    gfx_setfont(4);   // (the font the old keys left current)
  );
  hit;
);
function mm_sect(x, y, s) ( ui_col(ACC); gfx_rect(x * sc, (y + 2) * sc, 3 * sc, 9 * sc); rd_sub(x + 7, y, s, ACC, 1); );
// a row label under a row of keys
function mm_row(x, y, s) ( rd_lbl(x, y, s, DIM, 1); );
// the PHASER's response, drawn from the running engine (all-pass chain, or the tape comb)
function mm_rsp(x, y, w, h, lc) local(i, gf, w0, dw, er, ei, nr, ni, den, wr, wi, hr, hi, ar, ai, ph1, gr, gi, mag, mdb, qx, qy, px, py) (
  ui_cola(lc, 0.3);
  gf = 100; loop(3, qx = (x + log(gf / 20) / log(1000) * w) * sc; gfx_line(qx, y * sc, qx, (y + h) * sc); gf *= 10; );
  gfx_line(x * sc, (y + h * 12 / 42) * sc, (x + w) * sc, (y + h * 12 / 42) * sc);
  ui_col(lc);
  i = 0;
  loop(121,
    gf = 20 * 1000 ^ (i / 120); w0 = 2 * $pi * gf / srate;
    p_voice == 2 ? (
      dw = p_dispMd * srate / 1000; er = cos(w0 * dw); ei = -sin(w0 * dw);
      nr = 1 - p_dispFb * er; ni = -p_dispFb * ei; den = nr * nr + ni * ni;
      wr = (er * nr + ei * ni) / den; wi = (ei * nr - er * ni) / den;
      hr = (1 - p_dispMix) * cos(w0 * p_dryD) + p_dispMix * p_dispFbc * wr; hi = -(1 - p_dispMix) * sin(w0 * p_dryD) + p_dispMix * p_dispFbc * wi;
    ) : (
      ph1 = atan2(-sin(w0), p_dispA + cos(w0)) - atan2(-p_dispA * sin(w0), 1 + p_dispA * cos(w0));
      ar = cos(p_nst * ph1); ai = sin(p_nst * ph1);
      nr = 1 - p_dispFb * ar; ni = -p_dispFb * ai; den = nr * nr + ni * ni;
      gr = (ar * nr + ai * ni) / den; gi = (ai * nr - ar * ni) / den;
      hr = (1 - p_dispMix) + p_dispMix * p_dispFbc * gr; hi = p_dispMix * p_dispFbc * gi;
    );
    mag = sqrt(hr * hr + hi * hi); mdb = mag > 0.00001 ? 20 * log10(mag) : -100; mdb = min(max(mdb, -30), 12);
    qx = (x + i / 120 * w) * sc; qy = (y + (12 - mdb) / 42 * h) * sc;
    i > 0 ? ( gfx_line(px, py, qx, qy, 1); gfx_line(px, py + 1, qx, qy + 1, 1); );
    px = qx; py = qy; i += 1;
  );
);
// FLANGER: where the delay sits inside the type's travel (0 .. 1)
function mm_fpos() local(lo, hi) (
  f_type == 2 ? (
    f_dispDry > 0 ? 0.5 + 0.5 * (f_dispMd / f_dispDry - 1) / 1.25 : 0.5;
  ) : (
    lo = f_type ? 0.15 : 0.3; hi = f_type ? 14 : 6;
    log(max(f_dispMd, lo * 0.5) / (lo * 0.5)) / log(hi * 1.3 / (lo * 0.5));
  );
);

// ---------- chassis ----------
ui_col(0x0A0A0B); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(FACE); gfx_rect(0, 0, 1120 * sc, 400 * sc);
gfx_gradrect(0, 0, 1120 * sc, 200 * sc, 1, 1, 1, 0.04, 0, 0, 0, 0, 0, 0, 0, -0.04 / (200 * sc));
ui_cola(0x000000, 0.4); gfx_rect(0, 0, 1120 * sc, 2 * sc); gfx_rect(0, 398 * sc, 1120 * sc, 2 * sc);
mm_cl && mm_m == 0 ? ( ui_cola(INK, 0.5); gfx_rect(30 * sc, 66 * sc, 1060 * sc, 1 * sc); ) :
mm_cl && mm_m == 1 ? ( ui_col(ACC); gfx_rect(30 * sc, 64 * sc, 1060 * sc, 3 * sc); gfx_rect(30 * sc, 388 * sc, 1060 * sc, 1.5 * sc); ) :
( ui_col(ACC); gfx_rect(0, 66 * sc, 1120 * sc, 2 * sc); );
rd_screw(12, 384); rd_screw(1108, 384);
mm_cl && mm_m == 0 ? ( rd_screw(12, 16); rd_screw(1108, 16); );

// ---------- header: title, MODE keys, presets [PRESETS][◄][►][LCD], size ----------
rd_badge(40, 34, 15, INK, FACE);
rd_title(64, 18, "MODMAX", 26, INK); ver_tag("v2", 16, 0, 0);
rd_sub(66, 50, "CHORUS  ·  FLANGER  ·  PHASER", DIM, 1);
mm_key(212, 22, 96, 26, mm_cl, 0xF2F0E6, LK_ORA, "CLASSIC") ? mm_face = 1 - mm_cl;
mm_key(330, 20, 96, 30, mm_m == 0, CCH, LK_GRN, "CHORUS")  ? setv(1, 0);
mm_key(432, 20, 96, 30, mm_m == 1, CFL, LK_BLU, "FLANGER") ? setv(1, 1);
mm_key(534, 20, 96, 30, mm_m == 2, CPH, LK_ORA, "PHASER")  ? setv(1, 2);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(660 * sc, 16 * sc, 370 * sc, 38 * sc, pr_cur, MM_PRESETS);
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 13 ? 0 : k_; );
ui_size_picker(1046 * sc, 26 * sc);

// ---------- the window (per mode) ----------
ui_col(0x050505); ui_rrect(30 * sc, 84 * sc, 320 * sc, 120 * sc, 4 * sc);
ui_col(WIN); gfx_rect(34 * sc, 88 * sc, 312 * sc, 112 * sc);
gfx_gradrect(34 * sc, 88 * sc, 312 * sc, 50 * sc, 1, 1, 1, 0.05, 0, 0, 0, 0, 0, 0, 0, -0.05 / (50 * sc));
mm_m == 0 ? (
  // CHORUS: the two delay taps sweeping over 0 - 10 ms, and the LFO
  tx0 = 48; tw0 = 200; ty = 150;
  ui_cola(LC, 0.35); gfx_rect(tx0 * sc, ty * sc, tw0 * sc, 1 * sc);
  i = 0; loop(11, gfx_rect((tx0 + i / 10 * tw0) * sc, (ty - (i % 5 == 0 ? 5 : 2)) * sc, 1 * sc, (i % 5 == 0 ? 10 : 4) * sc); i += 1; );
  gfx_setfont(4); ui_cola(LC, 0.7);
  gfx_x = (tx0 - 2) * sc; gfx_y = (ty + 12) * sc; gfx_drawstr("0"); gfx_x = (tx0 + tw0 * 0.5 - 3) * sc; gfx_drawstr("5"); gfx_x = (tx0 + tw0 - 14) * sc; gfx_drawstr("10 ms");
  c_voice == 3 ? (
    gfx_setfont(2); ui_col(LC); ui_text((tx0 + tw0 * 0.5) * sc, (ty - 30) * sc, "CHORUS OFF");
  ) : (
    ui_col(LC); gfx_circle((tx0 + min(c_dispL / 10, 1) * tw0) * sc, (ty - 11) * sc, 4.5 * sc, 1, 1);
    ui_col(0xFF9A7A); gfx_circle((tx0 + min(c_dispR / 10, 1) * tw0) * sc, (ty + 11) * sc, 4.5 * sc, 1, 1);
    gfx_setfont(4); ui_col(LC); gfx_x = 42 * sc; gfx_y = 96 * sc; sprintf(#t1, "L %.2f ms", c_dispL); gfx_drawstr(#t1);
    ui_col(0xFF9A7A); gfx_x = 140 * sc; sprintf(#t2, "R %.2f ms", c_dispR); gfx_drawstr(#t2);
  );
  sx0 = 266; sw0 = 70; sy0 = 146; sa = 28;
  ui_cola(LC, 0.3); gfx_rect(sx0 * sc, sy0 * sc, sw0 * sc, 1 * sc);
  c_voice == 3 ? ui_cola(LC, 0.3) : ui_col(LC);
  i = 0; loop(41, pp = i / 40; qx = (sx0 + pp * sw0) * sc; qy = (sy0 - lfo_shape_d(pp, 1, 1, 1) * sa) * sc;
    i > 0 ? gfx_line(px, py, qx, qy, 1); px = qx; py = qy; i += 1; );
  c_voice != 3 ? ( ui_col(0xFF9A7A); gfx_circle((sx0 + c_dispP * sw0) * sc, (sy0 - lfo_shape_d(c_dispP, 1, 1, 1) * sa) * sc, 3 * sc, 1, 1); );
  gfx_setfont(4); ui_cola(LC, 0.7); gfx_x = sx0 * sc; gfx_y = 96 * sc; gfx_drawstr("LFO");
) : mm_m == 1 ? (
  // FLANGER: the delay readout and the sweep position
  f_dispMd < 10 ? sprintf(#fa_ms, "%.2f", f_dispMd) : sprintf(#fa_ms, "%.1f", f_dispMd);
  rd_seg(50, 98, 28, 46, 4, #fa_ms, LC, SEGO);
  rd_lbl(222, 130, "ms", LC, 0.9);
  rd_lbl(298, 104, f_type == 0 ? "PEDAL" : f_type == 1 ? "RACK" : "THRU-0", LC, 0.7);
  rd_lbl(298, 122, f_sweep == 1 ? "MATRIX" : f_sweep == 2 ? "ENV" : "LFO", LC, 0.7);
  fa_p = min(max(mm_fpos(), 0), 1);
  fa_k = 0; loop(14,
    fa_c = fa_k < 8 ? 0x3AE060 : fa_k < 11 ? 0xFFC020 : 0xFF3020;
    fa_on = fa_k <= floor(fa_p * 13.99);
    ui_col(fa_on ? fa_c : ui_mix(fa_c, 0x000000, 0.8)); gfx_rect((50 + fa_k * 20) * sc, 166 * sc, 15 * sc, 7 * sc);
    fa_k += 1; );
  rd_sub(50, 180, "SHORT", DIM, 1); rd_sub(292, 180, "LONG", DIM, 1);
) : (
  // PHASER: the response
  mm_rsp(44, 112, 292, 82, LC);
  gfx_setfont(4); ui_col(LC); gfx_x = 44 * sc; gfx_y = 94 * sc;
  p_voice == 2 ? sprintf(#inf, "TAPE  %.2f ms", p_dispMd) : sprintf(#inf, "%d STAGES  %.0f Hz", p_nst, p_dispFc);
  gfx_drawstr(#inf);
);

// ---------- the mode's keys, under the window ----------
mm_m == 0 ? (
  mm_key(30, 224, 74, 26, slider8 == 0, K1, LK_YEL, "I")    ? chorus_mode(0);
  mm_key(112, 224, 74, 26, slider8 == 1, K1, LK_YEL, "II")   ? chorus_mode(1);
  mm_key(194, 224, 74, 26, slider8 == 2, K1, LK_YEL, "I+II") ? chorus_mode(2);
  mm_key(276, 224, 74, 26, slider8 == 3, 0x8A9A9C, LK_RED, "OFF") ? setv(8, 3);
  mm_row(190, 256, "VOICE");
  mm_key(30, 286, 74, 26, slider9 == 0, K2, LK_BLU, "FREE") ? setv(9, 0);
  mm_key(112, 286, 74, 26, slider9 == 1, K2, LK_BLU, "SYNC") ? setv(9, 1);
  mm_key(194, 286, 74, 26, slider9 == 2, K2, LK_BLU, "FLOW") ? setv(9, 2);
  mm_row(148, 318, "RATE MODE");
) : mm_m == 1 ? (
  mm_key(30, 222, 100, 24, slider25 == 0, K1, LK_YEL, "PEDAL")  ? setv(25, 0);
  mm_key(140, 222, 100, 24, slider25 == 1, K1, LK_YEL, "RACK")   ? setv(25, 1);
  mm_key(250, 222, 100, 24, slider25 == 2, K1, LK_YEL, "THRU-0") ? setv(25, 2);
  mm_row(190, 250, "TYPE");
  mm_key(30, 266, 100, 24, slider35 == 0, K2, LK_YEL, "LFO")      ? setv(35, 0);
  mm_key(140, 266, 100, 24, slider35 == 1, K2, LK_YEL, "MATRIX")   ? setv(35, 1);
  mm_key(250, 266, 100, 24, slider35 == 2, K2, LK_YEL, "ENVELOPE") ? setv(35, 2);
  mm_row(190, 294, "SWEEP");
  mm_key(30, 310, 74, 24, slider26 == 0, K3, LK_WHT, "SIN") ? setv(26, 0);
  mm_key(112, 310, 74, 24, slider26 == 1, K3, LK_WHT, "TRI") ? setv(26, 1);
  mm_key(194, 310, 74, 24, slider26 == 2, K3, LK_WHT, "SQR") ? setv(26, 2);
  mm_key(276, 310, 74, 24, slider26 == 3, K3, LK_WHT, "RND") ? setv(26, 3);
  mm_row(190, 338, "LFO SHAPE");
  mm_key(30, 354, 74, 24, slider27 == 0, K3, LK_BLU, "FREE") ? setv(27, 0);
  mm_key(112, 354, 74, 24, slider27 == 1, K3, LK_BLU, "SYNC") ? setv(27, 1);
  mm_key(194, 354, 74, 24, slider27 == 2, K3, LK_BLU, "FLOW") ? setv(27, 2);
  rd_lbl(313, 360, "RATE MODE", DIM, 1);
) : (
  mm_key(30, 222, 100, 24, slider44 == 0, CPH, LK_YEL, "90")   ? setv(44, 0);
  mm_key(140, 222, 100, 24, slider44 == 1, YEL, LK_YEL, "OPTO") ? setv(44, 1);
  mm_key(250, 222, 100, 24, slider44 == 2, 0x3A9CFF, LK_YEL, "TAPE") ? setv(44, 2);
  mm_row(190, 250, "VOICING");
  mm_key(30, 266, 74, 24, slider46 == 0, K3, LK_WHT, "SIN") ? setv(46, 0);
  mm_key(112, 266, 74, 24, slider46 == 1, K3, LK_WHT, "TRI") ? setv(46, 1);
  mm_key(194, 266, 74, 24, slider46 == 2, K3, LK_WHT, "SQR") ? setv(46, 2);
  mm_key(276, 266, 74, 24, slider46 == 3, K3, LK_WHT, "RND") ? setv(46, 3);
  mm_row(190, 294, "LFO SHAPE");
  mm_key(30, 310, 74, 24, slider47 == 0, K3, LK_BLU, "FREE") ? setv(47, 0);
  mm_key(112, 310, 74, 24, slider47 == 1, K3, LK_BLU, "SYNC") ? setv(47, 1);
  mm_key(194, 310, 74, 24, slider47 == 2, K3, LK_BLU, "FLOW") ? setv(47, 2);
  slider44 == 0 ? ( mm_key(276, 310, 74, 24, slider52 != 0, KS, LK_YEL, slider52 == 0 ? "SCRIPT" : slider52 == 40 ? "BLOCK" : "CUSTOM") ? setv(52, slider52 == 0 ? 40 : 0); );
  mm_row(148, 338, "RATE MODE");
);

ui_cola(INK, 0.15); gfx_rect(370 * sc, 82 * sc, 1 * sc, 300 * sc); gfx_rect(900 * sc, 82 * sc, 1 * sc, 300 * sc);

// ---------- the main knobs: shared places, relabelled per mode ----------
mm_sect(388, 78, mm_m == 0 ? "CHORUS" : mm_m == 1 ? "FLANGE" : "PHASE");
dy_kst = KST;
iR = mm_m == 0 ? 9 : mm_m == 1 ? 27 : 47;     // rate mode slider
iF = mm_m == 0 ? 10 : mm_m == 1 ? 28 : 48;    // free rate
iD = mm_m == 0 ? 11 : mm_m == 1 ? 29 : 49;    // sync division
rd_led(434, 96, 4, mm_m == 0 ? c_lfoA.p > 0.5 : mm_m == 1 ? f_dispLv > 0 : p_dispLv > 0, ACC);
slider(iR) >= 0.5 && !(mm_m == 2 && p_voice == 2 && slider59 == 1) ? (
  dy_step = 16; dy_steps = "";
  dy_knob(434, 160, 34, iD, 0, 15, mm_m == 0 ? 3 : 2, 0, KC, "RATE", lfo_div_name(floor(slider(iD) + 0.5)));
) : (
  sprintf(#v, "%.2f Hz", slider(iF));
  dy_knob(434, 160, 34, iF, mm_m == 0 ? 0.05 : 0.02, mm_m == 0 ? 12 : 10, mm_m == 0 ? 0.513 : mm_m == 1 ? 0.25 : 0.5, 1, KC,
          mm_m == 2 && p_voice == 2 && slider59 == 1 ? "HAND SPEED" : "RATE", mm_m == 1 && f_sweep == 1 ? "stopped" : #v);
);
mm_m == 0 ? (
  sprintf(#v, "%.2f ms", slider12); dy_knob(536, 154, 25, 12, 0, 3, 1.85, 0, KC, "DEPTH", #v);
  sprintf(#v, "%.2f ms", slider13); dy_knob(626, 154, 25, 13, 1, 8, 3.5, 0, KC, "CENTRE", #v);
  sprintf(#v, "%.0f%%", slider15);  dy_knob(716, 154, 25, 15, 0, 100, 60, 0, KC, "TONE", #v);
  sprintf(#v, "%.0f%%", slider14);  dy_knob(806, 154, 25, 14, 0, 100, 100, 0, KC, "WIDTH", #v);
) : mm_m == 1 ? (
  sprintf(#v, "%.0f%%", slider31);  dy_knob(536, 154, 25, 31, 0, 100, 70, 0, KC, "WIDTH", f_sweep == 1 ? "n/a" : #v);
  sprintf(#v, "%.0f%%", slider30);  dy_knob(626, 154, 25, 30, 0, 100, 40, 0, MNC, "MANUAL", #v);
  sprintf(#v, "%+.0f%%", slider32); dy_knob(716, 154, 25, 32, -95, 95, 50, 0, KC, "REGEN", #v);
  sprintf(#v, "%.0f deg", slider33); dy_knob(806, 154, 25, 33, 0, 180, 0, 0, KC, "SPREAD", #v);
) : (
  sprintf(#v, "%.0f%%", slider51);  dy_knob(536, 154, 25, 51, 0, 100, 70, 0, KC, "DEPTH", #v);
  sprintf(#v, "%.0f%%", slider50);  dy_knob(626, 154, 25, 50, 0, 100, 50, 0, KC, "CENTRE", #v);
  sprintf(#v, "%+.0f%%", slider52); dy_knob(716, 154, 25, 52, -95, 95, 0, 0, KC, "FEEDBACK", #v);
  sprintf(#v, "%.0f deg", slider53); dy_knob(806, 154, 25, 53, 0, 180, 0, 0, KC, "SPREAD", #v);
);

// ---------- lower row: the mode's extra knob, DRIFT, IN / OUT ----------
ui_cola(INK, 0.15); gfx_rect(388 * sc, 244 * sc, 496 * sc, 1 * sc);
mm_m == 0 ? (
  mm_sect(388, 254, "BBD");
  dy_kst = XST; sprintf(#v, "%.0f%%", slider16); dy_knob(430, 318, 18, 16, 0, 100, 0, 0, XC, "HISS", #v);
) : mm_m == 1 ? (
  mm_sect(388, 254, "ENV");
  dy_kst = XST; sprintf(#v, "%.0f%%", slider36); dy_knob(430, 318, 18, 36, 0, 100, 50, 0, XC, "SENS", slider35 == 2 ? #v : "envelope sweep only");
) : p_voice == 2 ? (
  mm_sect(388, 254, "TAPE");
  dy_kst = XST; dy_step = 3; dy_steps = "LFO|HAND|BOTH";
  rd_stepclick(430, 318, 18, 59, 3); dy_knob(430, 318, 18, 59, 0, 2, 1, 0, XC, "MOTION", "");
) : (
  mm_sect(388, 254, "STAGES");
  dy_kst = XST; dy_step = 5; dy_steps = "2|4|6|8|12";
  rd_stepclick(430, 318, 18, 45, 5); dy_knob(430, 318, 18, 45, 0, 4, 1, 0, XC, "STAGES", "");
);
ui_cola(INK, 0.15); gfx_rect(490 * sc, 252 * sc, 1 * sc, 130 * sc); gfx_rect(590 * sc, 252 * sc, 1 * sc, 130 * sc);
mm_sect(506, 254, "DRIFT");
iDr = mm_m == 0 ? 24 : mm_m == 1 ? 43 : 62;
dy_kst = KST; sprintf(#v, "%.0f%%", slider(iDr)); dy_knob(540, 318, 18, iDr, 0, 100, 50, 0, KC, "DRIFT", #v);
mm_sect(606, 254, "IN / OUT");
rd_ioc1 = IO1; rd_ioc2 = IO2; rd_ioc3 = RED; rd_iok = IOK;
rd_io(640, 296, 3, 4, mm_m == 0 ? 22 : mm_m == 1 ? 41 : 60, 0);

// ---------- master ----------
mm_sect(918, 78, "MASTER");
iM = mm_m == 0 ? 17 : mm_m == 1 ? 34 : 54;
iL = mm_m == 0 ? 23 : mm_m == 1 ? 42 : 61;
dy_kst = MXST; sprintf(#v, "%.0f%%", slider(iM)); dy_knob(958, 150, 24, iM, 0, 100, 50, 0, MXC, "MIX", #v);
slider(iL) <= 20.5 ? strcpy(#v, "off") : sprintf(#v, "%.0f Hz", slider(iL));
dy_kst = 36; dy_knob(1050, 150, 18, iL, 20, 500, 20, 1, YEL, "LOW CUT", #v);    // a high-pass: the house yellow cap
dy_kst = OST; sprintf(#v, "%+.1f dB", slider2); dy_knob(958, 310, 24, 2, -24, 12, 0, 0, OC, "OUTPUT", #v);
ui_col(0x141518); gfx_rect(1018 * sc, 252 * sc, 54 * sc, 108 * sc);
mL.ui_ledm(1026 * sc, 258 * sc, 16 * sc, 96 * sc, pkL); mR.ui_ledm(1048 * sc, 258 * sc, 16 * sc, 96 * sc, pkR);
rd_lbl(1045, 366, "OUT", DIM, 1);
pkL *= 0.85; pkR *= 0.85;
dy_kst = 0;

pk_end();
ui_end();
