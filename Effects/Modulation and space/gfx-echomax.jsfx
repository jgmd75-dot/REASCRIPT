desc:Echomax [multi-mode delay] (GFX)
//tags: delay echo tape bucket brigade analog digital ping-pong bbd
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-lfo, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// Oct 2026: the best of the retired delays folded in (the panel keeps its look; the new keys sit beside DRIFT):
//   ECHO     (all types) latching: off closes the echo's input, the repeats already in it ring on (from Echo 34).
//   STRETCH  (all types) hold the key: the delay time glides out to twice as long (the repeats bend down in pitch),
//            let go and it glides back (from Echo 34's SQUASH).
//   TAPE     HEADS 1 - 4: four replay heads at a quarter, a half, three quarters and the full time, any of them in
//            (from DLY57). Every head that is in feeds back; head 4 alone is the classic single echo.
//   BUCKET   BBD NOISE: the chip's clock hiss in the repeats (from Echo 34 STUDIO).
//   DIGITAL  TAPS: an 8-tap pattern on the eighths of the time, alternating left / right, the last tap feeding back
//            (from DLY81's MULTI-TAP). LO-FI: a 12-bit, 8 kHz loop (from DLY81's compact unit). PITCH: a pitch shifter
//            in the loop, so each repeat climbs or falls (+12, +7, +5, -5, -7, -12 semitones; from DLY81's PITCH 12).

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-lfo.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<0,3,1{Tape,Bucket,Digital,Echorder}>-Echo type
slider2:1<0,1,1{Off,On}>-Sync to tempo
slider3:375<20,2000,1>-Time (ms)
slider4:10<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Time (sync)
slider5:40<0,110,1>-Feedback (%)
slider6:45<0,100,1>-Drive (%)
slider7:120<20,1000,1>-Lo cut (Hz)
slider8:6000<1000,20000,10>-Hi cut (Hz)
slider9:0<0,100,1>-Duck (%)
slider10:0<0,1,1{Off,On}>-Ping-pong
slider11:0<0,1,1{Off,On}>-Freeze
slider12:35<0,100,1>-Wow (%)
slider13:25<0,100,1>-Flutter (%)
slider14:0.3<0.05,2,0.01>-Drift speed (Hz)
slider15:35<0,100,1>-Mix (%)
slider16:100<0,100,1>-Width (%)
slider17:0<-24,12,0.1>-Output (dB)
slider18:0<0,100,1>-Band sat (%)
slider19:30<0,100,1>-Bias (%)
slider20:120<40,400,1>-Sat low band (Hz)
slider21:6000<2000,16000,10>-Sat high band (Hz)
slider22:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider23:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider24:0<-24,12,0.1>-Input trim (dB)
slider25:0<0,1,1{Off,On}>-Input guard
slider26:0<0,3,1{Off,-3 dB,-6 dB,-9 dB}>-Vintage EQ (500 Hz cut)
slider27:60<0,100,1>-Drift (%)
slider28:0<0,1,1{Off,On}>-Dual chip (Echorder: detuned clock, wider & wobblier)
slider29:8<1,15,1>-Tape heads (bits: 1 = head 1 .. 8 = head 4)
slider30:1<0,1,1{Off,On}>-Echo
slider31:0<0,1,1{Off,On}>-Stretch
slider32:0<0,6,1{0,+12,+7,+5,-5,-7,-12}>-Pitch per repeat (Digital)
slider33:0<0,1,1{Off,On}>-Taps (Digital)
slider34:0<0,1,1{Off,On}>-Lo-fi (Digital)
slider35:0<0,1,1{Off,On}>-BBD noise (Bucket)
slider36:prs_sel=0<0,21,1{No preset,Tape: Worn Tape Echo,Tape: Slapback Sat,Tape: Dub Siren,Bucket: Memory Lane,Bucket: Analog Crunch,Echorder: EC-444 Drive,Echorder: Slap & Crunch,Digital: Ducked Vocal,Digital: Crystal Triplet,Tape: Flutter Wash,Echorder: Self-Osc Synth,Echorder: Deep Dub Echo,Echorder: Modern Dub Wash,Echorder: Chaos Dub Grit,Echorder: Heavy Dub Bass,Tape: Multi-Head Rhythm,Tape: Four-Head Swell,Bucket: Hissy Mini Echo,Digital: Pattern Taps,Digital: Climbing Fourths,Digital: 12-Bit Lo-Fi}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-echomax";

dlen = ceil(4.2 * srate) + 8;
bufL = 100000; bufR = bufL + dlen;
memset(bufL, 0, dlen * 2);
wp = 0;
PSN = 16384; PSR = bufR + dlen + 64; memset(PSR, 0, 2 * PSN);   // two pitch-shifter rings (DIGITAL PITCH)
TG = 99000;                                                    // the 8-tap pattern's levels (DIGITAL TAPS)
TG[0] = 0.30; TG[1] = 0.50; TG[2] = 0.35; TG[3] = 0.65; TG[4] = 0.40; TG[5] = 0.75; TG[6] = 0.50; TG[7] = 1.00;

// a two-grain pitch shifter on its own ring (ratio = 2 ^ (semitones / 12)), as the 81 series delays
function ps_run(x, ratio, k) instance(w, ph) local(b, win, d1, d2, q, g1, g2, p, i, f, y) (
  b = PSR + k * PSN; win = min(floor(0.05 * srate), PSN - 8);
  b[w] = x;
  ph += (1 - ratio) / win; ph >= 1 ? ph -= 1; ph < 0 ? ph += 1;
  q = ph >= 0.5 ? ph - 0.5 : ph + 0.5;
  d1 = ph * win + 2; d2 = q * win + 2; g1 = sin(ph * $pi); g2 = sin(q * $pi);
  p = w - d1; p < 0 ? p += PSN; i = floor(p); f = p - i; y = (b[i] * (1 - f) + b[(i + 1) % PSN] * f) * g1 * g1;
  p = w - d2; p < 0 ? p += PSN; i = floor(p); f = p - i; y += (b[i] * (1 - f) + b[(i + 1) % PSN] * f) * g2 * g2;
  w += 1; w >= PSN ? w = 0;
  y;
);

function tanh_(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1) );

// Heavy JRC4558 Asymmetrical Saturation for EC-444 mode
function jrc4558_sat(x, drv) local(s) (
  s = x * drv;
  s > 0 ? ( s = s / (1 + s * 0.8); ) : ( s = -abs(s) / (1 + abs(s) * 1.6); );
  s / drv;
);

function rdl(buf, d) local(p, i, f, x0, x1, x2, x3) (
  p = wp - d; p < 0 ? p += dlen; i = floor(p); f = p - i;
  x0 = buf[(i - 1 + dlen) % dlen]; x1 = buf[i % dlen]; x2 = buf[(i + 1) % dlen]; x3 = buf[(i + 2) % dlen];
  (((0.5 * (x3 - x0) + 1.5 * (x1 - x2)) * f + (x0 - 2.5 * x1 + 2 * x2 - 0.5 * x3)) * f + 0.5 * (x2 - x0)) * f + x1;
);

// Distinct Model-Specific Feedback Processing
function loopproc(x) instance(hz, lz, lz2, bz, lq1, lq2) (
  hz += (x - hz) * lo_c; x -= hz;                           // Global Lo Cut
  lz += (x - lz) * hi_c; x = lz;                            // Global Hi Cut
  
  etype == 0 ? (                                            // 1. TAPE: Warm tape saturation + progressive HF roll-off
    lz2 += (x - lz2) * tape_c; x = lz2;
    x = tanh_(x * drv_g * 1.4) / (drv_g * 0.9);
  ) : etype == 1 ? (                                        // 2. BUCKET: Very dark 2-pole BBD filter + gritty VCA clipping
    lz2 += (x - lz2) * bbd_c; bz += (lz2 - bz) * bbd_c; x = bz;
    x = x / (1 + abs(x) * drv_g * 1.5 + 0.12 * x * x);
  ) : etype == 2 ? (                                        // 3. DIGITAL: Clean, uncoloured pass-through
    lofi ? (                                                // LO-FI: an 8 kHz, 12-bit loop
      lq1 += (x - lq1) * lf8_c; lq2 += (lq1 - lq2) * lf8_c; x = floor(lq2 * 2048 + 0.5) / 2048;
    );
    x = abs(x) > 1.5 ? tanh_(x / 1.5) * 1.5 : x;
  ) : (                                                     // 4. ECHORDER: Overdriven JRC4558 op-amp + MN3005 BBD LPF
    lz2 += (x - lz2) * ech_c; x = lz2;
    x = jrc4558_sat(x, drv_g * 1.8);
  );
  x;
);

function vt_bq(t, f, q, gdb) local(w, cw, al, A, a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); al = sin(w) / (2 * q);
  t == 0 ? (
    a0 = 1 + al; vtp[0] = (1 + cw) * 0.5 / a0; vtp[1] = -(1 + cw) / a0; vtp[2] = vtp[0];
  ) : t == 1 ? (
    a0 = 1 + al; vtp[0] = (1 - cw) * 0.5 / a0; vtp[1] = (1 - cw) / a0; vtp[2] = vtp[0];
  ) : (
    A = 10 ^ (gdb / 40); a0 = 1 + al / A;
    vtp[0] = (1 + al * A) / a0; vtp[1] = -2 * cw / a0; vtp[2] = (1 - al * A) / a0;
  );
  vtp[3] = -2 * cw / a0; vtp[4] = (1 - (t == 2 ? al / A : al)) / a0;
);

VTC = 30000;
function vt_set(m) (
  vt_on = m > 0;
  vtp = VTC;      vt_bq(0, 140, 0.7071, 0);
  vtp = VTC + 5;  vt_bq(2, 500, 0.9, -3 * m);
  vtp = VTC + 10; vt_bq(1, 5000, 0.7071, 0);
);

function vt_proc(x) instance(a1, a2, b1, b2, c1, c2) local(y) (
  y = VTC[0] * x + a1; a1 = VTC[1] * x - VTC[3] * y + a2; a2 = VTC[2] * x - VTC[4] * y; x = y;
  y = VTC[5] * x + b1; b1 = VTC[6] * x - VTC[8] * y + b2; b2 = VTC[7] * x - VTC[9] * y; x = y;
  y = VTC[10] * x + c1; c1 = VTC[11] * x - VTC[13] * y + c2; c2 = VTC[12] * x - VTC[14] * y;
  y;
);

function hover_txt(cx, cy, r, txt) (
  mouse_x >= (cx - r) * sc && mouse_x <= (cx + r) * sc &&
  mouse_y >= (cy - r) * sc && mouse_y <= (cy + r) * sc ? txt : "";
);

function update() local(q) (
  etype = slider1;
  sync = slider2;
  q = lfo_div_q(slider4);
  t_ms = sync ? q * 60000 / max(tempo, 20) : slider3;
  t_ms = min(max(t_ms, 1), 4000);
  fb = min(slider5 / 100, 1.15);
  drv_g = 1 + 4.5 * (slider6 / 100);
  lo_c = 1 - exp(-2 * $pi * slider7 / srate);
  hi_c = 1 - exp(-2 * $pi * min(slider8, srate * 0.45) / srate);
  tape_c = 1 - exp(-2 * $pi * 5500 / srate);  // Darker tape roll-off (~5.5 kHz)
  bbd_c  = 1 - exp(-2 * $pi * 2800 / srate);  // Steep dark BBD roll-off (~2.8 kHz)
  ech_c  = 1 - exp(-2 * $pi * 3200 / srate);  // EC-444 LPF (~3.2 kHz)
  duck = slider9 / 100;
  ping = slider10; frz = slider11;
  drift_macro(slider27);
  dual_chip = slider28;
  hmask = slider29 | 0; hmask < 1 || hmask > 15 ? hmask = 8;
  hn = (hmask & 1) + ((hmask >> 1) & 1) + ((hmask >> 2) & 1) + ((hmask >> 3) & 1);
  hn_o = 1 / sqrt(hn); hn_f = 1 / hn;
  echo_t = slider30 >= 0.5;
  str_t = slider31 >= 0.5 ? 2 : 1;
  q = slider32 | 0; pitch_r = 2 ^ ((q == 1 ? 12 : q == 2 ? 7 : q == 3 ? 5 : q == 4 ? -5 : q == 5 ? -7 : q == 6 ? -12 : 0) / 12);
  taps = slider33 >= 0.5; lofi = slider34 >= 0.5; bnoise = slider35 >= 0.5;
  lf8_c = 1 - exp(-2 * $pi * min(8000, 0.45 * srate) / srate);
  wow = slider12 / 100 * dm_a; flt = slider13 / 100 * dm_a; dspd = slider14 * dm_s;
  mix_t = slider15 / 100; wid = slider16 / 100;
  out_t = 10 ^ (slider17 / 20);
  t_glide = 1 - exp(-1 / ((etype == 0 ? 0.35 : etype == 1 ? 0.12 : etype == 3 ? 0.18 : 0.03) * srate));
  in_setup(slider24, slider25);
  slider26 != vt_m ? ( vt_m = slider26; vt_set(vt_m); );
  ost_setup(slider18 / 100, slider19 / 100, slider20, slider21, slider22, 0);   // output stage: straight through
);

// Preset Manager with Showcase Presets
function setp(m, sy, tm, dv, f, drp, lc, hc, dk, pp, w, flp, mx, drf) (
  slider1 = m; slider2 = sy; slider3 = tm; slider4 = dv; slider5 = f; slider6 = drp; slider7 = lc; slider8 = hc;
  slider9 = dk; slider10 = pp; slider12 = w; slider13 = flp; slider15 = mx; slider27 = drf; slider11 = 0;
  slider29 = 8; slider30 = 1; slider31 = 0; slider32 = 0; slider33 = 0; slider34 = 0; slider35 = 0;   // the new keys back to plain
);
function load_preset(p) (
  p == 1  ? setp(0, 1, 375, 10, 50, 50, 120, 6000, 0,  0, 45, 30, 40, 70) :  // 1. TAPE: Worn Tape Echo
  p == 2  ? setp(0, 0, 110, 10, 30, 60, 150, 5000, 0,  0, 25, 20, 35, 50) :  // 2. TAPE: Slapback Sat
  p == 3  ? setp(0, 1, 500, 6,  85, 75, 200, 3500, 0,  0, 60, 40, 45, 85) :  // 3. TAPE: Dub Siren
  p == 4  ? setp(1, 1, 375, 9,  55, 40, 100, 3000, 20, 1, 20, 15, 35, 40) :  // 4. BUCKET: Memory Lane
  p == 5  ? setp(1, 0, 180, 10, 65, 70, 120, 2500, 0,  0, 35, 25, 45, 60) :  // 5. BUCKET: Analog Crunch
  p == 6  ? setp(3, 0, 280, 10, 70, 80, 140, 3200, 0,  0, 25, 15, 45, 50) :  // 6. ECHORDER: EC-444 Drive
  p == 7  ? setp(3, 0, 85,  10, 80, 95, 180, 2800, 0,  0, 10, 10, 50, 30) :  // 7. ECHORDER: Slap & Crunch
  p == 8  ? setp(2, 1, 375, 6,  35, 0,  80, 16000, 50, 0, 0,  0,  30, 0)  :  // 8. DIGITAL: Ducked Vocal
  p == 9  ? setp(2, 1, 375, 11, 40, 0,  100, 18000, 0, 1, 0,  0,  35, 0)  :  // 9. DIGITAL: Crystal Triplet
  p == 10 ? setp(0, 0, 1200, 10, 75, 55, 250, 4000, 40, 0, 50, 30, 50, 75) :  // 10. TAPE: Flutter Wash
  p == 11 ? setp(3, 1, 375, 10, 102, 85, 150, 3000, 0, 0, 30, 20, 55, 60) :  // 11. ECHORDER: Self-Osc Synth
  p == 12 ? ( setp(3, 0, 380, 10, 55, 45, 140, 2200, 0, 0, 20, 15, 45, 50); slider28 = 0; ) :  // 12. ECHORDER: Deep Dub Echo
  p == 13 ? ( setp(3, 0, 300, 10, 65, 35, 140, 3200, 0, 0, 40, 10, 40, 35); slider28 = 1; ) :  // 13. ECHORDER: Modern Dub Wash
  p == 14 ? ( setp(3, 0, 220, 10, 85, 70, 160, 1800, 0, 0, 15, 30, 55, 75); slider28 = 0; ) :  // 14. ECHORDER: Chaos Dub Grit
  p == 15 ? ( setp(3, 0, 450, 10, 60, 50, 120, 2000, 0, 0, 45, 15, 50, 45); slider28 = 1; ) :  // 15. ECHORDER: Heavy Dub Bass
  p == 16 ? ( setp(0, 1, 500, 6, 55, 55, 120, 5000, 0, 0, 30, 20, 40, 60); slider29 = 13; ) :   // 16. TAPE: Multi-Head Rhythm
  p == 17 ? ( setp(0, 1, 750, 3, 92, 60, 160, 3800, 0, 0, 45, 25, 45, 70); slider29 = 15; ) :   // 17. TAPE: Four-Head Swell
  p == 18 ? ( setp(1, 0, 260, 10, 50, 55, 150, 3200, 0, 0, 25, 15, 40, 55); slider35 = 1; ) :   // 18. BUCKET: Hissy Mini Echo
  p == 19 ? ( setp(2, 1, 500, 6, 45, 0, 100, 16000, 20, 0, 0, 0, 35, 0); slider33 = 1; ) :       // 19. DIGITAL: Pattern Taps
  p == 20 ? ( setp(2, 1, 375, 9, 60, 0, 150, 12000, 0, 1, 0, 0, 35, 0); slider32 = 3; ) :        // 20. DIGITAL: Climbing Fourths
  p == 21 ? ( setp(2, 0, 240, 10, 55, 0, 200, 9000, 0, 0, 0, 0, 40, 0); slider34 = 1; ) :        // 21. DIGITAL: 12-Bit Lo-Fi
  p == 22 ? (                                                                // 22. Reset All Defaults
    setp(0, 1, 375, 10, 40, 45, 120, 6000, 0, 0, 35, 25, 35, 60);
    slider14 = 0.3; slider16 = 100; slider17 = 0;
    slider18 = 0; slider19 = 30; slider20 = 120; slider21 = 6000; slider22 = -0.3; slider23 = 1;
    slider24 = 0; slider25 = 0; slider26 = 0;
    slider28 = 0;
    slider_automate(268435455);
  );
  p >= 1 && p <= 21 ? slider_automate(24575);
  p >= 1 && p <= 22 ? ( q_ = 29; loop(7, ui_auto(q_); q_ += 1; ); );
  p >= 12 && p <= 15 ? slider_automate(134217728);   // slider28 (Dual Chip) touch for the new dub presets
);

drW.drift_init(0.8 + rand(0.5));
drF.drift_init(0.8 + rand(0.5));
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
sm  = 1 - exp(-1 / (0.03 * srate));
vuc = 1 - exp(-1 / (0.01 * srate));
dk_a = 1 - exp(-1 / (0.005 * srate)); dk_r = 1 - exp(-1 / (0.25 * srate));
pkL = 0; pkR = 0; vu_ms = 0; denv = 0; fph = 0; cph = 0; cph2 = 0;
vt_m = -1;
cur_preset = 1;
str_s = 1; str_c = 1 - exp(-1 / (0.4 * srate));          // STRETCH glide
egc = 1 / (0.01 * srate);                                 // ECHO key fade (10 ms)
!ui_dflt ? ui_thm = 0; !ui_dflt ? ui_hw = 1;
update();
t_s = t_ms * 0.001 * srate;
mix_s = mix_t; out_s = out_t; eg = echo_t;
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(21, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 21 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
update();
dinc = dspd * samplesblock / srate;
vW = drW.drift_tick(dinc); vF = drF.drift_tick(dinc * 3);

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_avail(0) != 0 ? file_var(0, pr_cur);    // the preset in use (older projects end before it)
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
inL = in_l; inR = in_r;
vu_ms += (0.5 * (inL * inL + inR * inR) - vu_ms) * vuc;
mix_s += (mix_t - mix_s) * sm;
out_s += (out_t - out_s) * sm;

str_s += (str_t - str_s) * str_c;                         // STRETCH: the time glides out to 2x and back
t_s += (t_ms * 0.001 * srate * str_s - t_s) * t_glide;
eg = echo_t ? min(eg + egc, 1) : max(eg - egc, 0);        // ECHO: the echo's input opens / closes
fph += (6.5 + 1.5 * vF) / srate; fph >= 1 ? fph -= 1;
cph += 0.6 / srate; cph >= 1 ? cph -= 1;
cph2 += 0.6 / srate * 1.37; cph2 >= 1 ? cph2 -= 1;   // second "chip" clock, deliberately un-synced to cph

// Model-specific Pitch & Clock Wobble Artifacts
mod = (wow * 0.0025 * vW + flt * 0.00022 * sin(2 * $pi * fph)) * srate;
etype == 1 ? mod += 0.0006 * srate * sin(2 * $pi * cph);                  // BBD clock chorus
etype == 3 ? mod += 0.0012 * srate * sin(2 * $pi * cph * 0.5);            // EC-444 clock drift

// Dual Chip (Echorder only): the R channel runs off its own slightly-mistuned clock, so with
// WIDTH pushed it drifts and beats against L instead of just sitting at a fixed stereo offset.
dc_on = etype == 3 && dual_chip;
wid_mul = dc_on ? 0.05 : (etype == 3 ? 0.015 : 0.03);
modR = mod + (dc_on ? 0.0022 * srate * sin(2 * $pi * cph2) : 0);

dL = min(max(t_s + mod, 3), dlen - 4);
dR = ping ? dL : min(max(t_s * (1 + wid_mul * wid) + modR, 3), dlen - 4);

etype == 0 && hmask != 8 ? (
  // TAPE HEADS: the heads that are in, at a quarter, a half, three quarters and the full time
  sL = sR = 0; k = 1;
  loop(4, hmask & (1 << (k - 1)) ? ( sL += rdl(bufL, max(dL * k * 0.25, 3)); sR += rdl(bufR, max(dR * k * 0.25, 3)); ); k += 1; );
  eL = sL * hn_o; eR = sR * hn_o; fsL = sL * hn_f; fsR = sR * hn_f;
) : etype == 2 && taps ? (
  // DIGITAL TAPS: eight taps on the eighths of the time, alternating left / right; the last one feeds back
  fsL = rdl(bufL, dL); fsR = rdl(bufR, dR);
  sL = sR = 0; k = 1;
  loop(8,
    a_ = rdl(bufL, max(dL * k * 0.125, 3)); b_ = rdl(bufR, max(dR * k * 0.125, 3));
    sL += TG[k - 1] * a_ * ((k & 1) ? 1 : 1 - 0.7 * wid); sR += TG[k - 1] * b_ * ((k & 1) ? 1 - 0.7 * wid : 1);
    k += 1;
  );
  eL = sL * 0.45; eR = sR * 0.45;
) : (
  eL = rdl(bufL, dL);
  eR = rdl(bufR, dR);
  fsL = eL; fsR = eR;
);

// EC-444 Background BBD Clock Hiss Artifact (and BUCKET's BBD NOISE)
etype == 3 || (etype == 1 && bnoise) ? (
  noise = (rand(2.0) - 1.0) * (etype == 1 ? 0.0006 : 0.0004 * (1 + slider6 / 50));
  eL += noise; eR += noise; fsL += noise; fsR += noise;
);

frz ? (
  fL = fsL; fR = fsR;
  bufL[wp] = ping ? fR : fL; bufR[wp] = ping ? fL : fR;
) : (
  fL = lpL.loopproc(fsL) * fb; fR = lpR.loopproc(fsR) * fb;
  etype == 2 && pitch_r != 1 ? ( fL = psL.ps_run(fL, pitch_r, 0); fR = psR.ps_run(fR, pitch_r, 1); );   // DIGITAL PITCH
  ping ? (
    bufL[wp] = 0.5 * (inL + inR) * eg + fR;
    bufR[wp] = fL;
  ) : (
    bufL[wp] = inL * eg + fL;
    bufR[wp] = inR * eg + fR;
  );
);
wp += 1; wp >= dlen ? wp = 0;

lvl = max(abs(inL), abs(inR));
denv += (lvl - denv) * (lvl > denv ? dk_a : dk_r);
dg = 1 - duck * min(denv * 4, 1);

vt_on ? ( eL = vtL.vt_proc(eL); eR = vtR.vt_proc(eR); );

em = 0.5 * (eL + eR); es = 0.5 * (eL - eR) * wid;
wL = (em + es) * dg; wR = (em - es) * dg;
dry_g = min(2 * (1 - mix_s), 1); wet_g = min(2 * mix_s, 1);
oL = inL * dry_g + wL * wet_g;
oR = inR * dry_g + wR * wet_g;

oL = ostL.ost_band(oL) * out_s;
oR = ostR.ost_band(oR) * out_s;
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 1060 300
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1060, 300);
// v1.0.1: bigger print (reported too small to read): small print and knob labels up, key legends 9 -> 11 px,
// all calibrated and set every frame (the fonts are no longer set only once per scale change)
sc != em_lsc ? ( em_lsc = sc; em_fs15 = ui_fitfont(15, 11 * sc); );
gfx_setfont(5, "Trebuchet MS", ui_fs5 * 1.15, 'b');
gfx_setfont(15, "Trebuchet MS", em_fs15, 'b');

FACE = 0x49796B; INK = 0xF3EBD3; BLU = 0xF3EBD3; DIM = 0xA2B5AC; RED = 0xFF3A22;
dy_ink = INK; dy_bg = FACE; dy_nov = 1;

function setv(idx, v) ( slider(idx) = v; ui_auto(idx); );
// panel keys: house lamp keys (gfx-ui); legends in font slot 15 (set at the top of every frame)
function em_key(x, y, w, h, on, col, s) local(hit) (
  lk_well = 0x141518; lk_font = 15; lk_font2 = 15;
  hit = lk_fit(x, y, w, h, on, col, s);
  gfx_setfont(4);   // (the font the old keys left current)
  hit;
);

ui_col(0x0A0A0B); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(FACE); gfx_rect(0, 0, 1060 * sc, 300 * sc);
ui_cola(0x000000, 0.35); gfx_rect(0, 0, 1060 * sc, 2 * sc); gfx_rect(0, 298 * sc, 1060 * sc, 2 * sc);
ui_col(BLU); gfx_rect(0, 62 * sc, 1060 * sc, 3 * sc);

// ---------- HEADER ----------
rd_badge(60, 34, 15, INK, FACE);
rd_title(84, 18, "ECHOMAX", 26, INK); ver_tag("v2", 16, 0, 0);
rd_sub(244, 30, "MULTI-MODE DELAY LINE", DIM, 1);
gfx_setfont(4, "Trebuchet MS", ui_fs4 * 1.25, 'b');      // the small print below the header: bigger (the subtitle keeps its size)

em_key(370, 20, 56, 24, slider1 == 0, LK_YEL, "TAPE")     ? setv(1, 0);
em_key(430, 20, 62, 24, slider1 == 1, LK_YEL, "BUCKET")   ? setv(1, 1);
em_key(496, 20, 62, 24, slider1 == 2, LK_YEL, "DIGITAL")  ? setv(1, 2);
em_key(562, 20, 76, 24, slider1 == 3, LK_YEL, "ECHORDER") ? setv(1, 3);

pk_pextra = "Reset Defaults"; pk_lcdstrip = 1;   // the LCD shows the name without its "Tape: " prefix   // the house preset display: PRESETS, prev / next, LCD (click it for the list)
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(646 * sc, 16 * sc, 276 * sc, 32 * sc, pr_cur, "Tape: Worn Tape Echo|Tape: Slapback Sat|Tape: Dub Siren|Bucket: Memory Lane|Bucket: Analog Crunch|Echorder: EC-444 Drive|Echorder: Slap & Crunch|Digital: Ducked Vocal|Digital: Crystal Triplet|Tape: Flutter Wash|Echorder: Self-Osc Synth|Echorder: Deep Dub Echo|Echorder: Modern Dub Wash|Echorder: Chaos Dub Grit|Echorder: Heavy Dub Bass|Tape: Multi-Head Rhythm|Tape: Four-Head Swell|Bucket: Hissy Mini Echo|Digital: Pattern Taps|Digital: Climbing Fourths|Digital: 12-Bit Lo-Fi");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 21 ? 0 : k_; );
ui_size_picker(930 * sc, 22 * sc);

// ---------- READOUT + REPEAT LADDER ----------
ui_col(0x0B0B0C); rd_rr(44 * sc, 78 * sc, 290 * sc, 112 * sc, 5 * sc);
ui_col(0x1A0705); gfx_rect(50 * sc, 84 * sc, 278 * sc, 100 * sc);
sprintf(#dms, "%d", floor(t_ms + 0.5)); rd_seg(64, 94, 22, 40, 4, #dms, RED, 0x3A0C08);
gfx_setfont(4); ui_col(RED); gfx_x = 192 * sc; gfx_y = 120 * sc; gfx_drawstr("ms");
gfx_x = 220 * sc; gfx_y = 96 * sc; gfx_drawstr(slider2 ? lfo_div_name(slider4) : "FREE");
gfx_x = 220 * sc; gfx_y = 110 * sc; gfx_drawstr(slider30 < 0.5 ? "ECHO OFF" : slider31 >= 0.5 ? "STRETCH" : slider11 ? "FROZEN" : slider5 > 100 ? "RUNAWAY" : slider10 ? "PING-PONG" : "");

fbd = slider11 ? 1 : min(slider5 / 100, 1.1); lv = 1; em_k = 0;
loop(16,
  lv *= max(fbd, 0.0001) * (slider1 == 2 ? 1 : 0.9);
  ui_col(0x2A0A08); gfx_rect((60 + em_k * 16.5) * sc, (slider10 && (em_k & 1) ? 168 : 152) * sc, 12 * sc, 10 * sc);
  gy_ = slider10 && (em_k & 1) ? 169 : 153; ga_ = min(sqrt(lv) * 1.5, 1);
  ui_cola(RED, 0.25 * ga_); gfx_rect((58 + em_k * 16.5) * sc, (gy_ - 3) * sc, 16 * sc, 14 * sc);
  ui_cola(RED, ga_); gfx_rect((61 + em_k * 16.5) * sc, gy_ * sc, 10 * sc, 8 * sc);
  em_k += 1; );

// ---------- SWITCHES & VINTAGE EQ ----------
em_key(44, 204, 56, 22, slider2, LK_BLU, "SYNC")    ? setv(2, 1 - slider2);
em_key(106, 204, 56, 22, slider10, LK_RED, "PING")  ? setv(10, 1 - slider10);
em_key(168, 204, 60, 22, slider11, LK_YEL, "FREEZE") ? setv(11, 1 - slider11);
em_key(232, 204, 72, 22, slider28, LK_YEL, "DUAL CHIP") ? setv(28, 1 - slider28);
em_k = 0; loop(4, em_key(44 + em_k * 42, 248, 38, 20, slider26 == em_k, LK_WHT, em_k == 0 ? "OFF" : em_k == 1 ? "-3dB" : em_k == 2 ? "-6dB" : "-9dB") ? setv(26, em_k); em_k += 1; );
rd_lbl(272, 242, "VINTAGE EQ", INK, 0.9); rd_lbl(272, 256, "500 Hz CUT", DIM, 1); rd_lbl(272, 270, "HP 140 / LP 5k", DIM, 1);

// ---------- DELAY KNOBS ----------
dy_kst = 7;
rd_sub(360, 74, "DELAY", BLU, 1);

sprintf(#v, "%.0f ms", slider3);
slider2 ? ( dy_step = 16; dy_steps = ""; dy_knob(402, 132, 28, 4, 0, 15, 10, 0, 0xC4C6C3, "TIME", hover_txt(402, 132, 28, lfo_div_name(slider4))); )
        : ( dy_knob(402, 132, 28, 3, 20, 2000, 375, 1, 0xC4C6C3, "TIME", hover_txt(402, 132, 28, #v)); );

sprintf(#v, "%.0f%%", slider5);
dy_knob(490, 132, 22, 5, 0, 110, 40, 0, 0xC4C6C3, "FEEDBACK", hover_txt(490, 132, 22, #v));

slider1 == 2 ? strcpy(#v, "clean") : sprintf(#v, "%.0f%%", slider6);
dy_knob(566, 132, 20, 6, 0, 100, 30, 0, 0xC4C6C3, "DRIVE", hover_txt(566, 132, 20, slider1 == 2 ? "clean" : #v));

sprintf(#v, "%.0f Hz", slider7); dy_kf = 1;
dy_kf = 1; dy_knob(636, 132, 17, 7, 20, 1000, 120, 1, 0x2A2D33, "LO CUT", hover_txt(636, 132, 17, #v));

sprintf(#v, "%.0f Hz", slider8); dy_kf = 2;
dy_knob(702, 132, 17, 8, 1000, 20000, 6000, 1, 0x2A2D33, "HI CUT", hover_txt(702, 132, 17, #v));

sprintf(#v, "%.0f%%", slider9);
dy_knob(772, 132, 20, 9, 0, 100, 0, 0, 0xC4C6C3, "DUCK", hover_txt(772, 132, 20, #v));

ui_cola(INK, 0.2); gfx_rect(360 * sc, 200 * sc, 450 * sc, 1 * sc);
rd_sub(360, 206, "DRIFT", BLU, 1);

sprintf(#v, "%.0f%%", slider27);
dy_knob(392, 246, 16, 27, 0, 100, 50, 0, 0x6A7484, "DRIFT", hover_txt(392, 246, 16, #v));

// ---------- ECHO / STRETCH and the type's own keys (beside DRIFT) ----------
em_key(430, 214, 60, 22, slider30 >= 0.5, LK_AMB, "ECHO") ? setv(30, slider30 >= 0.5 ? 0 : 1);
em_key(496, 214, 76, 22, slider31 >= 0.5, LK_YEL, "STRETCH") ? st_hold = 1;   // momentary: held = stretched
!(mouse_cap & 1) ? st_hold = 0;
(st_hold ? 1 : 0) != (slider31 >= 0.5) ? setv(31, st_hold ? 1 : 0);
slider1 == 0 ? (
  em_h = 0; loop(4,                                                 // own counter: the audio thread uses k
    sprintf(#hk, "%d", em_h + 1);
    em_key(430 + em_h * 36, 246, 32, 22, (hmask & (1 << em_h)) != 0, LK_YEL, #hk) ? (
      q_ = hmask ~ (1 << em_h); q_ > 0 ? setv(29, q_);                 // at least one head stays in
    );
    em_h += 1; );
  rd_lbl(500, 274, "PLAYBACK HEADS", DIM, 1);
) : slider1 == 1 ? (
  em_key(430, 246, 90, 22, slider35 >= 0.5, LK_YEL, "BBD NOISE") ? setv(35, slider35 >= 0.5 ? 0 : 1);
  rd_lbl(500, 274, "CLOCK HISS", DIM, 1);
) : slider1 == 2 ? (
  em_key(430, 246, 44, 22, slider33 >= 0.5, LK_YEL, "TAPS") ? setv(33, slider33 >= 0.5 ? 0 : 1);
  em_key(478, 246, 46, 22, slider34 >= 0.5, LK_YEL, "LO-FI") ? setv(34, slider34 >= 0.5 ? 0 : 1);
  q_ = slider32 | 0;
  q_ == 0 ? strcpy(#pk, "PITCH") : sprintf(#pk, "%+d", q_ == 1 ? 12 : q_ == 2 ? 7 : q_ == 3 ? 5 : q_ == 4 ? -5 : q_ == 5 ? -7 : -12);
  em_key(528, 246, 46, 22, q_ > 0, LK_YEL, #pk) ? setv(32, q_ >= 6 ? 0 : q_ + 1);   // click cycles 0, +12, +7, +5, -5, -7, -12
  rd_lbl(500, 274, "TAPS  LO-FI  PITCH / REPEAT", DIM, 1);
);

ui_cola(INK, 0.15); gfx_rect(580 * sc, 212 * sc, 1 * sc, 74 * sc);
rd_sub(590, 206, "IN / OUT", BLU, 1);
rd_ioc1 = 0x2A2D33; rd_ioc2 = 0xD8B040; rd_ioc3 = 0xC8321E;
rd_io(594, 220, 24, 25, 18, 23);

// ---------- MASTER ----------
ui_cola(INK, 0.15); gfx_rect(830 * sc, 78 * sc, 1 * sc, 208 * sc);
rd_sub(848, 74, "MASTER", BLU, 1);

sprintf(#v, "%.0f%%", slider15);
dy_knob(878, 126, 20, 15, 0, 100, 35, 0, 0xF3EBD3, "MIX", hover_txt(878, 126, 20, #v));

sprintf(#v, "%.0f%%", slider16);
dy_knob(960, 126, 17, 16, 0, 100, 100, 0, 0x6A7484, "WIDTH", hover_txt(960, 126, 17, #v));

sprintf(#v, "%+.1f dB", slider17);
dy_knob(878, 220, 20, 17, -24, 12, 0, 0, 0xC4C6C3, "OUTPUT", hover_txt(878, 220, 20, #v));

mL.ui_ledm(946 * sc, 190 * sc, 9 * sc, 60 * sc, pkL); mR.ui_ledm(960 * sc, 190 * sc, 9 * sc, 60 * sc, pkR);
pkL *= 0.85; pkR *= 0.85;
rd_lbl(960, 256, "OUT", DIM, 1);

pk_end();
ui_end();

