  ui_cola(0xFFFFFF, 0.08); gfx_rect(floor((x + r) * sc), floor(y * sc) + 1, floor((w - 2 * r) * sc), 1);
);
function gw_louvres(x, y, w, h) local(k, yy) (
  ui_col(0x120C08); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  yy = y + 3;
