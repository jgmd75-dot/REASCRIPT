    ui_cola(0x000000, 0.45); gfx_rect((x + 2) * sc, (yy + 7) * sc, (w - 4) * sc, 1.2 * sc);
    yy += 12; );
  ui_cola(0x000000, 0.55); gfx_rect(x * sc, y * sc, w * sc, 2 * sc); gfx_rect(x * sc, y * sc, 2 * sc, h * sc);
);

