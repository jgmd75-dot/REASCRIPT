desc:Oontecho [trance gate] (GFX)
// gfx-oontecho - rhythmic trance-gate multi-effect: step gate, resonant filter, tempo delay, space
//tags: trance gate sequencer filter delay reverb rhythmic multi-effect pump sidechain
//author: JGWizrad / Garden FX (GFX)
//
// In the spirit of the classic rhythmic trance-gate multi-effects of the 2000s.
//
// Signal flow: INPUT (trim + guard) -> GATE -> FILTER -> DELAY -> SPACE -> MIX (dry / wet) -> OUTPUT stage.
//
// GATE     a tempo-synced step sequencer: 8, 12, 16, 24 or 32 steps at 1/4, 1/8, 1/8 T, 1/16, 1/16 T or 1/32.
//          Each step has a LEVEL (0 - 100 %, drawn as a bar) and an ACCENT flag.
//          DEPTH   how far the pattern moves the volume (0 = the volume is left alone)
//          GLIDE   smooths the steps from a fast, click-free edge (0 %) to a soft, pumping swell (100 %)
//          ACCENT  accented steps are louder (up to +6 dB) and open the filter (up to 1.5 octaves)
//          SWING   delays every second step (0 - 50 %)
//          PAN     the same pattern moves the sound across the stereo field: odd steps one way, even steps
//                  the other, as far as the step's level (- / + flips the sides)
//          FILTER  the same pattern moves the cutoff: up to 5 octaves above (+) or below (-) CUTOFF at full level
//          The gate follows the project: it locks to the timeline while REAPER plays (so it is in time from the
//          moment the transport starts) and runs on freely at the project tempo while it is stopped.
// FILTER   state-variable (zero-delay feedback) filter: OFF / LP / BP / HP, CUTOFF, RESO, plus an internal
//          tempo-synced sine LFO (LFO = depth in octaves, RATE = 4 bars .. 1/32). Mode changes crossfade.
// DELAY    tempo-synced stereo delay: TIME (4 bars .. 1/32, dotted and triplet), independent L and R
//          multipliers (x0.5, x0.75, x1, x1.5, x2), FEEDBACK, DAMP (high-cut in the feedback loop), MIX (level of
//          the echoes on top of the gated sound), PING (cross-feedback ping-pong).
// SPACE    an eight-line feedback-delay-network wash: SIZE, DECAY (0.4 - 10 s), MIX (level on top).
// MASTER   MIX (dry / wet), OUTPUT, and the house IN / OUT strip: TRIM (click it for GUARD), SAT.
// DRIFT    never rhythmic - the timing stays locked to the grid. The filter cutoff wanders slowly, and the delay's
//          colour (its damping and a little of its feedback) breathes with it. 0 - 100 %.
//
// GUI: draw the step levels by clicking and dragging across the bars (right-drag erases); click (or drag along)
//      the accent row to set accents. STEPS and DIV keys pick the pattern length and step size; the arrows rotate
//      the pattern; RND makes a random pattern; FILL sets every step to full. Knobs: drag (Shift = fine),
//      double-click = reset; the value shows while hovering. PRESETS / the LCD open the preset list.
//
// Requires gfx-drift, gfx-input, gfx-lfo, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc)
// in the same folder.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-lfo.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:2<0,4,1{8,12,16,24,32}>-Steps
slider2:3<0,5,1{1/4,1/8,1/8 T,1/16,1/16 T,1/32}>-Division
slider3:100<0,100,1>-Gate depth (%)
slider4:15<0,100,1>-Glide (%)
slider5:50<0,100,1>-Accent (%)
slider6:0<0,50,1>-Swing (%)
slider7:0<-100,100,1>-Pan depth (%)
slider8:0<-5,5,0.01>-Filter sequence depth (oct)
slider9:0<0,3,1{Off,LP,BP,HP}>-Filter type
slider10:2000<20,20000,1>-Cutoff (Hz)
slider11:20<0,100,1>-Resonance (%)
slider12:0<-4,4,0.01>-LFO depth (oct)
slider13:2<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-LFO rate
slider14:10<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Delay time
slider15:2<0,4,1{x0.5,x0.75,x1,x1.5,x2}>-Delay L multiplier
slider16:2<0,4,1{x0.5,x0.75,x1,x1.5,x2}>-Delay R multiplier
slider17:35<0,95,1>-Delay feedback (%)
slider18:6000<1000,20000,1>-Delay damping (Hz)
slider19:0<0,100,1>-Delay mix (%)
slider20:0<0,1,1{Off,On}>-Ping-pong
slider21:50<0,100,1>-Space size (%)
slider22:50<0,100,1>-Space decay (%)
slider23:0<0,100,1>-Space mix (%)
slider24:100<0,100,1>-Mix (%)
slider25:0<-24,12,0.1>-Output (dB)
slider26:25<0,100,1>-Drift (%)
slider27:0<-24,12,0.1>-Input trim (dB)
slider28:0<0,1,1{Off,On}>-Input guard
slider29:0<0,100,1>-Band sat (%)
slider30:1<0,1,1{Off,Clip}>-(unused, was output stage)
// steps: level 0 - 100 (+ 128 when accented)
slider31:100<0,228,1>-Step 1
slider32:100<0,228,1>-Step 2
slider33:100<0,228,1>-Step 3
slider34:100<0,228,1>-Step 4
slider35:100<0,228,1>-Step 5
slider36:100<0,228,1>-Step 6
slider37:100<0,228,1>-Step 7
slider38:100<0,228,1>-Step 8
slider39:100<0,228,1>-Step 9
slider40:100<0,228,1>-Step 10
slider41:100<0,228,1>-Step 11
slider42:100<0,228,1>-Step 12
slider43:100<0,228,1>-Step 13
slider44:100<0,228,1>-Step 14
slider45:100<0,228,1>-Step 15
slider46:100<0,228,1>-Step 16
slider47:100<0,228,1>-Step 17
slider48:100<0,228,1>-Step 18
slider49:100<0,228,1>-Step 19
slider50:100<0,228,1>-Step 20
slider51:100<0,228,1>-Step 21
slider52:100<0,228,1>-Step 22
slider53:100<0,228,1>-Step 23
slider54:100<0,228,1>-Step 24
slider55:100<0,228,1>-Step 25
slider56:100<0,228,1>-Step 26
slider57:100<0,228,1>-Step 27
slider58:100<0,228,1>-Step 28
slider59:100<0,228,1>-Step 29
slider60:100<0,228,1>-Step 30
slider61:100<0,228,1>-Step 31
slider62:100<0,228,1>-Step 32
slider63:prs_sel=0<0,12,1{No preset,Init,Classic 16ths,Euphoric Gate,Sidechain Pump,Half-Time Chop,Filter Sequence,Dub Delay Gate,Ambient Wash,Triplet Trance,Ping-Pong Pan,32nd Stutter,LFO Sweep Gate}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-oontecho";

// =====================================================================
// Memory
// =====================================================================
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
ost_init(alloc(4096));
oa_DLN = ceil(4.2 * srate) + 8;                  // delay: 4 s at any tempo
oa_bufL = alloc(oa_DLN); oa_bufR = alloc(oa_DLN);
oa_RLN = ceil(0.135 * srate) + 8;                // space: eight lines of up to 135 ms
oa_RBUF = alloc(oa_RLN * 8);
oa_ALN = ceil(0.012 * srate) + 8;                // space: four input diffusers
oa_ABUF = alloc(oa_ALN * 4);
oa_RB = alloc(8); oa_RG = alloc(8); oa_RS = alloc(8); oa_RY = alloc(8);
og_tmp = alloc(32);                              // GUI: pattern rotate scratch

// line lengths (ms at SIZE 0.65 x) - mutually prime-ish
oa_RB[0] = 29.7; oa_RB[1] = 37.1; oa_RB[2] = 41.1; oa_RB[3] = 43.7;
oa_RB[4] = 53.3; oa_RB[5] = 59.9; oa_RB[6] = 67.7; oa_RB[7] = 73.1;

// =====================================================================
// Helpers
// =====================================================================
function oa_nsteps(i) ( i = floor(i + 0.5); i == 0 ? 8 : i == 1 ? 12 : i == 2 ? 16 : i == 3 ? 24 : 32; );
// step length in beats: 1/4 1/8 1/8T 1/16 1/16T 1/32
function oa_divb(i) ( i = floor(i + 0.5); i == 0 ? 1 : i == 1 ? 0.5 : i == 2 ? 1/3 : i == 3 ? 0.25 : i == 4 ? 1/6 : 0.125; );
function oa_mult(i) ( i = floor(i + 0.5); i == 0 ? 0.5 : i == 1 ? 0.75 : i == 2 ? 1 : i == 3 ? 1.5 : 2; );
// soft clip for the feedback loop: unity small-signal, never past +/-1.5
function oa_soft(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
// Hermite read from a circular buffer, d samples behind the write point
function oa_rdl(buf, d) local(p, i, f, x0, x1, x2, x3, n) (
  n = oa_DLN; p = oa_wp - d; p < 0 ? p += n; i = floor(p); f = p - i;
  x0 = buf[(i - 1 + n) % n]; x1 = buf[i % n]; x2 = buf[(i + 1) % n]; x3 = buf[(i + 2) % n];
  (((0.5 * (x3 - x0) + 1.5 * (x1 - x2)) * f + (x0 - 2.5 * x1 + 2 * x2 - 0.5 * x3)) * f + 0.5 * (x2 - x0)) * f + x1;
);
// Schroeder allpass for the space input diffusers
function oa_ap(x) instance(buf, n, p, g) local(d, w) (
  d = buf[p]; w = x + g * d; buf[p] = w; p += 1; p >= n ? p = 0;
  d - g * w;
);
// read the current step's targets
function oa_rd(i) local(v, a, lv) (
  v = slider(31 + i); a = v > 127.5; lv = min(max((v - 128 * a) / 100, 0), 1);
  oa_tl = lv; oa_ta = a;
  oa_tg = (1 - oa_dep + oa_dep * lv) * (a ? oa_accg : 1);
  oa_tp = oa_pan * lv * ((i & 1) ? 1 : -1);
);

// =====================================================================
// Presets - the pattern as one hex digit per step (0 = silent .. F = full) and an accent string (1 = accent);
// shorter strings repeat to fill all 32 steps.
// =====================================================================
function oa_pat(lv, ac) local(i, c, d, n, m) (
  n = strlen(lv); m = strlen(ac); i = 0;
  loop(32,
    c = str_getchar(lv, i % n); d = c >= 65 ? c - 55 : c - 48; d = min(max(d, 0), 15);
    slider(31 + i) = floor(d / 15 * 100 + 0.5) + (str_getchar(ac, i % m) == 49 ? 128 : 0);
    i += 1;
  );
);
function oa_pg(st, dv, dp, gl, ac, sw, pn, fs) (
  slider1 = st; slider2 = dv; slider3 = dp; slider4 = gl; slider5 = ac; slider6 = sw; slider7 = pn; slider8 = fs;
);
function oa_pf(ty, ct, rs, ld, lr) ( slider9 = ty; slider10 = ct; slider11 = rs; slider12 = ld; slider13 = lr; );
function oa_pd(tm, ml, mr, fb, dm, mx, pp) ( slider14 = tm; slider15 = ml; slider16 = mr; slider17 = fb; slider18 = dm; slider19 = mx; slider20 = pp; );
function oa_ps(sz, dc, mx) ( slider21 = sz; slider22 = dc; slider23 = mx; );
// presets set the sound (sliders 1 - 24 and the pattern); OUTPUT, DRIFT and the IN / OUT strip are left alone
function load_preset(p) local(i) (
  oa_pg(2, 3, 100, 15, 50, 0, 0, 0); oa_pf(0, 2000, 20, 0, 2); oa_pd(10, 2, 2, 35, 6000, 0, 0); oa_ps(50, 50, 0); slider24 = 100;
  p == 1 ? (          // Init: every step full - a blank canvas to draw on
    oa_pat("F", "0");
  ) : p == 2 ? (      // Classic 16ths: the 3-3-2 trance chop, dotted-eighth echoes
    oa_pg(2, 3, 100, 10, 45, 0, 0, 0); oa_pd(10, 2, 2, 30, 7000, 22, 0); oa_ps(40, 35, 12);
    oa_pat("FF0FF0F0FF0FF0F0", "1001001010010010");
  ) : p == 3 ? (      // Euphoric Gate: accented 16ths through a resonant low-pass that the pattern opens
    oa_pg(2, 3, 100, 12, 60, 0, 0, 2.5); oa_pf(1, 900, 45, 0, 2); oa_pd(10, 2, 3, 40, 6500, 25, 0); oa_ps(55, 50, 22);
    oa_pat("FC0FA0F8C0FA0FCF", "1000000010000000");
  ) : p == 4 ? (      // Sidechain Pump: ducked on every beat, swelling back up
    oa_pg(2, 3, 100, 55, 0, 0, 0, 0);
    oa_pat("05AF", "0");
  ) : p == 5 ? (      // Half-Time Chop: long eighth-note hits across two bars, a quarter echo behind them
    oa_pg(2, 1, 100, 20, 40, 0, 0, 0); oa_pf(1, 6000, 10, 0, 2); oa_pd(6, 2, 2, 30, 5000, 18, 0); oa_ps(45, 40, 10);
    oa_pat("FF00F0A0FF00F00C", "1000000010000000");
  ) : p == 6 ? (      // Filter Sequence: the volume stays, the pattern plays the cutoff of a resonant low-pass
    oa_pg(2, 3, 0, 25, 60, 0, 0, 4.5); oa_pf(1, 160, 70, 0, 2); oa_pd(10, 2, 2, 35, 5000, 20, 0); oa_ps(50, 45, 15);
    oa_pat("F38C2F6A0FB47E19", "1000100010001000");
  ) : p == 7 ? (      // Dub Delay Gate: sparse thin hits feeding a dark ping-pong echo
    oa_pg(2, 1, 100, 10, 40, 0, 0, 0); oa_pf(3, 260, 25, 0, 2); oa_pd(7, 2, 1, 65, 2400, 45, 1); oa_ps(55, 45, 18);
    oa_pat("F000F0000F00F000", "1000000000001000");
  ) : p == 8 ? (      // Ambient Wash: slow gliding quarter gate into a long, dark space
    oa_pg(0, 0, 70, 90, 20, 0, 30, 0); oa_pf(1, 2500, 15, 1.5, 1); oa_pd(6, 2, 3, 55, 4000, 35, 0); oa_ps(90, 85, 55);
    oa_pat("FA6CF84B", "10000000");
  ) : p == 9 ? (      // Triplet Trance: one bar of 1/16 triplets, rolling across the stereo field
    oa_pg(3, 4, 100, 12, 50, 0, 60, 0); oa_pd(8, 2, 3, 35, 6000, 20, 0); oa_ps(45, 40, 12);
    oa_pat("FA0FA0F70FA0FA0F70FA0FC0", "100000100000100000100000");
  ) : p == 10 ? (     // Ping-Pong Pan: 16ths that fly left and right, echoes bouncing behind them
    oa_pg(2, 3, 60, 15, 40, 0, 100, 0); oa_pd(9, 2, 3, 40, 7000, 22, 1); oa_ps(40, 35, 10);
    oa_pat("FFAFFAFFAFFAFFAF", "1000100010001000");
  ) : p == 11 ? (     // 32nd Stutter: a bar of 1/32 chops that roll into the next downbeat
    oa_pg(4, 5, 100, 5, 55, 0, 0, 0); oa_pd(12, 2, 2, 25, 8000, 12, 0);
    oa_pat("F0F0F0F0FF0FF0FFF0F0F0F0F0F0FFFF", "10000000100000001000000010001010");
  ) : p == 12 ? (     // LFO Sweep Gate: a band-pass swept over two bars by the LFO
    oa_pg(2, 3, 100, 15, 50, 10, 0, 0); oa_pf(2, 700, 55, 3, 1); oa_pd(10, 2, 2, 35, 6000, 25, 0); oa_ps(50, 50, 20);
    oa_pat("F0F0FF0FF0F0FF0F", "1000000010000000");
  );
  i = 1; loop(24, ui_auto(i); i += 1; );
  i = 31; loop(32, ui_auto(i); i += 1; );
);

// =====================================================================
// State
// =====================================================================
in_init();
ostL.ost_ch_init(); ostR.ost_ch_init();
oa_dF.drift_init(0.8 + rand(0.5));
oa_dD.drift_init(0.8 + rand(0.5));
oa_dB.drift_init(0.8 + rand(0.5));
oa_vF = oa_vD = oa_vB = 0;
oa_b = 0; oa_lastg = -999999; oa_step = 0; oa_wp = 0; oa_rw = 0;
oa_g1 = oa_g2 = 1; oa_l1 = oa_l2 = 1; oa_a1s = oa_a2s = 0; oa_p1 = oa_p2 = 0;
oa_wo = 1; oa_wl = oa_wb = oa_wh = 0;
oa_lfph = 0; oa_rc = 1; oa_rsn = 0; oa_dn = 0.000000000000001;
oa_sm = 1 - exp(-1 / (0.03 * srate));
oa_fc = 1 - exp(-1 / (0.012 * srate));
oa_tgl = 1 - exp(-1 / (0.12 * srate));
oa_pkL = oa_pkR = 0;
apL.buf = oa_ABUF;              apL.n = floor(0.0047 * srate); apL.p = 0; apL.g = 0.6;
apL2.buf = oa_ABUF + oa_ALN;    apL2.n = floor(0.0079 * srate); apL2.p = 0; apL2.g = 0.55;
apR.buf = oa_ABUF + oa_ALN * 2; apR.n = floor(0.0053 * srate); apR.p = 0; apR.g = 0.6;
apR2.buf = oa_ABUF + oa_ALN * 3; apR2.n = floor(0.0071 * srate); apR2.p = 0; apR2.g = 0.55;

// GUI colours (the 'oontz' night faceplate)
OG_INK = 0xEEEFEA; OG_DIM = 0xA6A2D0; OG_COR = 0xFF6F5E; OG_CYA = 0x46E3F0; OG_AMB = 0xFFC247;
og_pi = -1; og_rd = 0; og_pcap = 0;

ui_thm = 4; ui_hw = 1;          // fixed faceplate, hardware keycaps
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );   // new instances open in Large, on Init
ui_dflt = 1;

function oa_update() local(i, t60, ln) (
  oa_nst = oa_nsteps(slider1);
  oa_dv = oa_divb(slider2);
  oa_dep = slider3 / 100;
  oa_sw = slider6 / 100;
  oa_a1 = oa_dv * (1 + oa_sw);
  oa_accg = 10 ^ (slider5 * 0.06 / 20);
  oa_acco = slider5 / 100 * 1.5;
  oa_pan = slider7 / 100;
  oa_fsq = slider8;
  oa_ftype = floor(slider9 + 0.5);
  oa_cut = slider10; oa_res = slider11 / 100;
  oa_k = 2 * (1 - 0.97 * oa_res);
  oa_comp = 1 - 0.35 * oa_res;
  oa_ldep = slider12;
  oa_lq = lfo_div_q(floor(slider13 + 0.5));
  oa_tmp = max(tempo, 20);
  oa_binc = oa_tmp / (60 * srate);
  // GLIDE: two cascaded one-poles, from a 0.7 ms edge up to half a step
  oa_gc = 1 - exp(-1 / ((0.0007 + (slider4 / 100) ^ 2 * 0.5 * oa_dv * 60 / oa_tmp) * 0.5 * srate));
  // delay
  i = lfo_div_q(floor(slider14 + 0.5)) * 60 / oa_tmp;
  oa_dtL = min(i * oa_mult(slider15), 4) * srate;
  oa_dtR = min(i * oa_mult(slider16), 4) * srate;
  oa_fb = slider17 / 100;
  oa_dmp = slider18;
  oa_dmx = slider19 / 100;
  oa_ping = slider20 > 0.5;
  oa_hc = 1 - exp(-2 * $pi * 70 / srate);
  // space
  oa_szt = (0.35 + 1.3 * slider21 / 100) * srate / 1000;
  t60 = 0.4 + (slider22 / 100) ^ 2 * 9.6;
  i = 0; loop(8, ln = oa_RB[i] * oa_szt; oa_RG[i] = exp(-6.9078 * ln / (t60 * srate)); i += 1; );
  oa_rdc = 1 - exp(-2 * $pi * (9000 - 4500 * slider22 / 100) / srate);
  oa_smx = slider23 / 100;
  oa_mix = slider24 / 100;
  oa_out = 10 ^ (slider25 / 20);
  drift_macro(slider26);
  in_setup(slider27, slider28);
  ost_setup(slider29 / 100, 0.3, 120, 6000, -0.3, 0);   // output stage: straight through
);
oa_update();
oa_szs = oa_szt; oa_dtLs = oa_dtL; oa_dtRs = oa_dtR; oa_mixs = oa_mix; oa_outs = oa_out; oa_dmxs = oa_dmx; oa_smxs = oa_smx;
oa_lc = log(oa_cut);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
oa_update();

@block
prs_chk();
oa_update();
// follow the transport; when stopped, run on at the project tempo
oa_play = play_state & 1;
oa_play ? oa_b = beat_position;
oa_lastg > -999999 ? oa_rd(oa_step);            // a step drawn while it plays is heard at once
// DRIFT: slow wander of the filter cutoff and the delay's colour (never the timing)
oa_i = 0.12 * dm_s * samplesblock / srate;
oa_vF = oa_dF.drift_tick(oa_i); oa_vD = oa_dD.drift_tick(oa_i * 1.3); oa_vB = oa_dB.drift_tick(oa_i * 0.8);
oa_drf = oa_vF * 0.3 * dm_a;                      // octaves
oa_dmpd = min(oa_dmp * 2 ^ (oa_vD * 0.45 * dm_a), srate * 0.45);
oa_dc = 1 - exp(-2 * $pi * oa_dmpd / srate);
oa_fbd = min(max(oa_fb + oa_vB * 0.05 * dm_a, 0), 0.95);
// keep the space's modulator on its circle
oa_i = 1 / sqrt(oa_rc * oa_rc + oa_rsn * oa_rsn); oa_rc *= oa_i; oa_rsn *= oa_i;
oa_rcw = cos(2 * $pi * 0.37 / srate); oa_rsw = sin(2 * $pi * 0.37 / srate);
oa_lfinc = oa_binc / max(oa_lq, 0.0001);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
oa_dl = in_l; oa_dr = in_r;

// ===================== GATE =====================
oa_bp = oa_b; oa_b += oa_binc;
oa_pf = floor(oa_bp / (2 * oa_dv)); oa_pp = oa_bp - oa_pf * 2 * oa_dv;
oa_g = oa_pf * 2 + (oa_pp >= oa_a1);
oa_g != oa_lastg ? ( oa_lastg = oa_g; oa_step = oa_g - floor(oa_g / oa_nst) * oa_nst; oa_rd(oa_step); );
oa_g1 += (oa_tg - oa_g1) * oa_gc; oa_g2 += (oa_g1 - oa_g2) * oa_gc;
oa_l1 += (oa_tl - oa_l1) * oa_gc; oa_l2 += (oa_l1 - oa_l2) * oa_gc;
oa_a1s += (oa_ta - oa_a1s) * oa_gc; oa_a2s += (oa_a1s - oa_a2s) * oa_gc;
oa_p1 += (oa_tp - oa_p1) * oa_gc; oa_p2 += (oa_p1 - oa_p2) * oa_gc;
oa_xl = oa_dl * oa_g2 * (oa_p2 > 0 ? 1 - oa_p2 : 1);
oa_xr = oa_dr * oa_g2 * (oa_p2 < 0 ? 1 + oa_p2 : 1);

// ===================== FILTER =====================
oa_wo += ((oa_ftype == 0) - oa_wo) * oa_fc; oa_wl += ((oa_ftype == 1) - oa_wl) * oa_fc;
oa_wb += ((oa_ftype == 2) - oa_wb) * oa_fc; oa_wh += ((oa_ftype == 3) - oa_wh) * oa_fc;
oa_lc += (log(oa_cut) - oa_lc) * oa_sm;
oa_ldep != 0 ? (
  oa_play ? oa_lfph = oa_bp / max(oa_lq, 0.0001) : oa_lfph += oa_lfinc;
  oa_lfph -= floor(oa_lfph);
  oa_lf = sin(2 * $pi * oa_lfph);
) : oa_lf = 0;
oa_wo < 0.99999 ? (
  oa_oct = oa_fsq * oa_l2 + oa_acco * oa_a2s + oa_ldep * oa_lf + oa_drf;
  oa_fq = min(max(exp(oa_lc + oa_oct * 0.6931472), 16), srate * 0.45);
  oa_fg = tan($pi * oa_fq / srate);
  oa_fa1 = 1 / (1 + oa_fg * (oa_fg + oa_k)); oa_fa2 = oa_fg * oa_fa1; oa_fa3 = oa_fg * oa_fa2;
  oa_v3 = oa_xl - oa_c2L; oa_v1 = oa_fa1 * oa_c1L + oa_fa2 * oa_v3; oa_v2 = oa_c2L + oa_fa2 * oa_c1L + oa_fa3 * oa_v3;
  oa_c1L = min(max(2 * oa_v1 - oa_c1L, -8), 8); oa_c2L = min(max(2 * oa_v2 - oa_c2L, -8), 8);
  oa_yl = oa_xl * oa_wo + (oa_v2 * oa_wl + (oa_xl - oa_k * oa_v1 - oa_v2) * oa_wh) * oa_comp + oa_k * oa_v1 * oa_wb;
  oa_v3 = oa_xr - oa_c2R; oa_v1 = oa_fa1 * oa_c1R + oa_fa2 * oa_v3; oa_v2 = oa_c2R + oa_fa2 * oa_c1R + oa_fa3 * oa_v3;
  oa_c1R = min(max(2 * oa_v1 - oa_c1R, -8), 8); oa_c2R = min(max(2 * oa_v2 - oa_c2R, -8), 8);
  oa_yr = oa_xr * oa_wo + (oa_v2 * oa_wl + (oa_xr - oa_k * oa_v1 - oa_v2) * oa_wh) * oa_comp + oa_k * oa_v1 * oa_wb;
  oa_c1L != oa_c1L || oa_c2L != oa_c2L || oa_c1R != oa_c1R || oa_c2R != oa_c2R ? ( oa_c1L = oa_c2L = oa_c1R = oa_c2R = 0; );
) : (
  oa_yl = oa_xl; oa_yr = oa_xr; oa_c1L = oa_c2L = oa_c1R = oa_c2R = 0;
);

// ===================== DELAY =====================
oa_dtLs += (oa_dtL - oa_dtLs) * oa_tgl; oa_dtRs += (oa_dtR - oa_dtRs) * oa_tgl;
oa_el = oa_rdl(oa_bufL, min(max(oa_dtLs, 2), oa_DLN - 4));
oa_er = oa_rdl(oa_bufR, min(max(oa_dtRs, 2), oa_DLN - 4));
oa_dlL += (oa_el - oa_dlL) * oa_dc; oa_dhL += (oa_dlL - oa_dhL) * oa_hc;
oa_dlR += (oa_er - oa_dlR) * oa_dc; oa_dhR += (oa_dlR - oa_dhR) * oa_hc;
oa_fl = oa_soft((oa_dlL - oa_dhL) * oa_fbd); oa_fr = oa_soft((oa_dlR - oa_dhR) * oa_fbd);
oa_ping ? (
  oa_bufL[oa_wp] = 0.5 * (oa_yl + oa_yr) + oa_fr + oa_dn;
  oa_bufR[oa_wp] = oa_fl + oa_dn;
) : (
  oa_bufL[oa_wp] = oa_yl + oa_fl + oa_dn;
  oa_bufR[oa_wp] = oa_yr + oa_fr + oa_dn;
);
oa_wp += 1; oa_wp >= oa_DLN ? oa_wp = 0;
oa_dmxs += (oa_dmx - oa_dmxs) * oa_sm;
oa_sl = oa_yl + oa_el * oa_dmxs; oa_sr = oa_yr + oa_er * oa_dmxs;

// ===================== SPACE =====================
oa_dn = -oa_dn;
oa_szs += (oa_szt - oa_szs) * oa_sm * 0.1;
oa_t = oa_rc * oa_rcw - oa_rsn * oa_rsw; oa_rsn = oa_rsn * oa_rcw + oa_rc * oa_rsw; oa_rc = oa_t;
oa_il = apL2.oa_ap(apL.oa_ap(oa_sl)); oa_ir = apR2.oa_ap(apR.oa_ap(oa_sr));
oa_rsum = 0; oa_ri = 0;
loop(8,
  oa_ln = oa_RB[oa_ri] * oa_szs + (oa_ri == 0 ? oa_rsn : oa_ri == 5 ? oa_rc : 0) * 0.0006 * srate;
  oa_rp = oa_rw - oa_ln; oa_rp < 0 ? oa_rp += oa_RLN;
  oa_r0 = floor(oa_rp); oa_rf = oa_rp - oa_r0; oa_r1 = oa_r0 + 1; oa_r1 >= oa_RLN ? oa_r1 = 0;
  oa_rbp = oa_RBUF + oa_ri * oa_RLN;
  oa_RY[oa_ri] = oa_rbp[oa_r0] + (oa_rbp[oa_r1] - oa_rbp[oa_r0]) * oa_rf;
  oa_rsum += oa_RY[oa_ri];
  oa_ri += 1;
);
oa_rsum *= 0.25;
oa_ri = 0;
loop(8,
  oa_RS[oa_ri] += (oa_RY[oa_ri] - oa_rsum - oa_RS[oa_ri]) * oa_rdc;
  (oa_RBUF + oa_ri * oa_RLN)[oa_rw] = ((oa_ri & 1) ? oa_ir : oa_il) * 0.5 + oa_RG[oa_ri] * oa_RS[oa_ri] + oa_dn;
  oa_ri += 1;
);
oa_rw += 1; oa_rw >= oa_RLN ? oa_rw = 0;
oa_rl = (oa_RY[0] - oa_RY[2] + oa_RY[4] - oa_RY[6]) * 0.5;
oa_rr = (oa_RY[1] - oa_RY[3] + oa_RY[5] - oa_RY[7]) * 0.5;
oa_smxs += (oa_smx - oa_smxs) * oa_sm;
oa_wtl = oa_sl + oa_rl * oa_smxs; oa_wtr = oa_sr + oa_rr * oa_smxs;

// ===================== MIX + OUTPUT =====================
oa_mixs += (oa_mix - oa_mixs) * oa_sm; oa_outs += (oa_out - oa_outs) * oa_sm;
oa_ol = oa_dl + (oa_wtl - oa_dl) * oa_mixs; oa_or = oa_dr + (oa_wtr - oa_dr) * oa_mixs;
oa_ol != oa_ol ? oa_ol = 0; oa_or != oa_or ? oa_or = 0;
oa_ol = ostL.ost_band(oa_ol) * oa_outs; oa_or = ostR.ost_band(oa_or) * oa_outs;
ost_out(oa_ol, oa_or);
spl0 = ost_l; spl1 = ost_r;
oa_pkL = max(oa_pkL, abs(spl0)); oa_pkR = max(oa_pkR, abs(spl1));

@gfx 1200 500
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
// =====================================================================
// GUI - 1200 x 500 at M: a night-indigo faceplate with hot coral, cyan and amber light.
// The step grid across the top, the GATE knobs beside it, FILTER / DELAY / SPACE / MASTER underneath.
// =====================================================================
ui_begin(1200, 500);
gfx_setfont(4, "Trebuchet MS", ui_fs4 * 1.14, 'b');
gfx_setfont(5, "Trebuchet MS", ui_fs5 * 1.08, 'b');
og_mx = mouse_x / sc; og_my = mouse_y / sc;
og_rpress = (mouse_cap & 2) && !(og_pcap & 2) && !ui_help_open;

function og_R(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function og_TL(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function og_TC(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function og_TR(rx, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = rx * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function og_in(x, y, w, h) ( og_mx >= x && og_mx < x + w && og_my >= y && og_my < y + h; );
function og_set(idx, v) ( slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); ); );
function og_lev(i) local(v) ( v = slider(31 + i); (v - 128 * (v > 127.5)) / 100; );
function og_acc(i) ( slider(31 + i) > 127.5; );
function og_put(i, lv, a) ( og_set(31 + i, floor(min(max(lv, 0), 1) * 100 + 0.5) + (a ? 128 : 0)); );

// recessed section with its title in coral
function og_sect(x, y, w, h, shade, title) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  strlen(title) ? ( gfx_setfont(2); ui_col(OG_COR); og_TL(x + 12, y + 7, title); );
);
// knob with a coral value ring (bipolar rings grow from the top)
function og_knob(cx, cy, r, idx, lo, hi, def, lg, bip, label, val) local(n, i, a0, a1) (
  dy_ink = OG_INK; dy_ntick = 0; dy_kst = 1;
  dy_knob(cx, cy, r, idx, lo, hi, def, lg, 0x9DA2A8, label, val);
  n = lg ? log(slider(idx) / lo) / log(hi / lo) : (slider(idx) - lo) / (hi - lo); n = min(max(n, 0), 1);
  ui_col(0x0A0920); i = 0; ui_ssarc(cx * sc, cy * sc, (r + 5) * sc + (0 + (floor(3) - 1) * 0.5), -0.75 * $pi, 0.75 * $pi, ((floor(3) - 1) * 1 + 1));
  a1 = (-0.75 + 1.5 * n) * $pi; a0 = bip ? 0 : -0.75 * $pi;
  ui_col(OG_COR); i = 0; ui_ssarc(cx * sc, cy * sc, (r + 5) * sc + (0 + (floor(3) - 1) * 0.5), min(a0, a1), max(a0, a1), ((floor(3) - 1) * 1 + 1));
  ui_cola(OG_COR, 0.25); gfx_circle((cx + sin(a1) * (r + 6)) * sc, (cy - cos(a1) * (r + 6)) * sc, 3.5 * sc, 1, 1);
  ui_col(0xFFFFFF); gfx_circle((cx + sin(a1) * (r + 6)) * sc, (cy - cos(a1) * (r + 6)) * sc, 1.6 * sc, 1, 1);
);
// a stepped knob: drags through n positions
function og_sknob(cx, cy, r, idx, n, def, label, val) (
  og_knob(cx, cy, r, idx, 0, n - 1, def, 0, 0, label, val);
  og_set(idx, min(max(floor(slider(idx) + 0.5), 0), n - 1));
);
// a lit key (caption on the key)
function og_key(x, y, w, h, on, col, s) ( rd_sqbg = 0x0E0C2A; rd_sqdark = 1; rd_sq(x, y, w, h, on, col, s); );
function og_screen(x, y, w, h) (
  ui_col(0x05050F); ui_rrect(x * sc, y * sc, w * sc, h * sc, 4 * sc);
  ui_col(0x0A0A1E); ui_rrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc, 3 * sc);
  ui_cola(0xFFFFFF, 0.05); gfx_line((x + 4) * sc, (y + 3) * sc, (x + w - 5) * sc, (y + 3) * sc);
);
function og_mname(i) ( i = floor(i + 0.5); i == 0 ? "x0.5" : i == 1 ? "x0.75" : i == 2 ? "x1" : i == 3 ? "x1.5" : "x2"; );
function og_dname(i) ( i = floor(i + 0.5); i == 0 ? "1/4" : i == 1 ? "1/8" : i == 2 ? "1/8 T" : i == 3 ? "1/16" : i == 4 ? "1/16 T" : "1/32"; );

// =====================================================================
// faceplate
// =====================================================================
ui_col(0x07061A); gfx_rect(0, 0, gfx_w, gfx_h);
gfx_gradrect(0, 0, 1200 * sc, 500 * sc, 0.125, 0.114, 0.318, 1, 0, 0, 0, 0, -0.04 / (500 * sc), -0.036 / (500 * sc), -0.09 / (500 * sc), 0);
// header strip
gfx_gradrect(0, 0, 1200 * sc, 58 * sc, 0.075, 0.067, 0.200, 1, 0, 0, 0, 0, -0.02 / (58 * sc), -0.02 / (58 * sc), -0.05 / (58 * sc), 0);
ui_col(OG_COR); og_R(0, 58, 1200, 2);
ui_cola(OG_COR, 0.25); og_R(0, 60, 1200, 2);
ui_cola(0x000000, 0.4); og_R(0, 498, 1200, 2);

// =====================================================================
// GATE: the step grid
// =====================================================================
og_sect(16, 70, 822, 218, 0x100E30, "");
og_nst = oa_nsteps(slider1);
gfx_setfont(4); ui_col(OG_DIM); og_TL(28, 82, "STEPS");
og_i = 0;
loop(5,
  og_n = oa_nsteps(og_i);
  sprintf(#og_s, "%d", og_n);
  og_key(80 + og_i * 40, 76, 36, 26, floor(slider1 + 0.5) == og_i, OG_COR, #og_s) ? og_set(1, og_i);
  og_i += 1;
);
gfx_setfont(4); ui_col(OG_DIM); og_TL(290, 82, "DIV");
og_i = 0;
loop(6,
  og_key(322 + og_i * 52, 76, 48, 26, floor(slider2 + 0.5) == og_i, OG_COR, og_dname(og_i)) ? og_set(2, og_i);
  og_i += 1;
);
// tools: rotate, random, fill
og_key(650, 76, 34, 26, 0, OG_CYA, "<") ? (
  og_i = 0; loop(og_nst, og_tmp[og_i] = slider(31 + og_i); og_i += 1; );
  og_i = 0; loop(og_nst, og_set(31 + og_i, og_tmp[(og_i + 1) % og_nst]); og_i += 1; );
);
og_key(688, 76, 34, 26, 0, OG_CYA, ">") ? (
  og_i = 0; loop(og_nst, og_tmp[og_i] = slider(31 + og_i); og_i += 1; );
  og_i = 0; loop(og_nst, og_set(31 + og_i, og_tmp[(og_i + og_nst - 1) % og_nst]); og_i += 1; );
);
og_key(728, 76, 48, 26, 0, OG_CYA, "RND") ? (
  og_i = 0;
  loop(32,
    og_rv = rand(1);
    og_l = og_i % 4 == 0 ? 1 : og_rv < 0.38 ? 0 : og_rv < 0.55 ? 0.5 : og_rv < 0.7 ? 0.75 : 1;
    og_put(og_i, og_l, og_l > 0.7 && rand(1) < 0.25);
    og_i += 1;
  );
);
og_key(780, 76, 48, 26, 0, OG_CYA, "FILL") ? ( og_i = 0; loop(32, og_put(og_i, 1, 0); og_i += 1; ); );

// the grid
og_gx = 28; og_gw = 798; og_by = 114; og_bh = 136; og_ay = 258; og_ah = 22;
og_pt = og_gw / og_nst; og_bw = og_pt - (og_nst > 16 ? 3 : 5);
og_spb = floor(1 / oa_divb(slider2) + 0.5); og_grp = og_spb == 1 ? 4 : og_spb;
// level guides
ui_cola(OG_DIM, 0.10); og_i = 1; loop(3, og_R(og_gx, og_by + og_bh * og_i / 4, og_gw - 4, 1); og_i += 1; );
og_hov = -1;
og_i = 0;
loop(og_nst,
  og_x = og_gx + og_i * og_pt;
  og_l = og_lev(og_i); og_a = og_acc(og_i);
  // track (beats alternate in shade)
  floor(og_i / og_grp) % 2 ? ui_col(0x1E1B4E) : ui_col(0x18163F); og_R(og_x, og_by, og_bw, og_bh);
  ui_cola(OG_DIM, 0.10); og_i == 0 || og_i % og_grp == 0 ? og_R(og_x, og_by, 2, og_bh);
  // the level bar
  og_h = og_l * og_bh;
  og_h > 0.5 ? (
    ui_col(og_a ? 0xFF8A5C : OG_COR); og_R(og_x, og_by + og_bh - og_h, og_bw, og_h);
    gfx_gradrect(og_x * sc, (og_by + og_bh - og_h) * sc, og_bw * sc, og_h * sc, 0.55, 0.05, 0.25, 0, 0, 0, 0, 0, 0, 0, 0, 0.45 / max(og_h * sc, 1));
    ui_cola(0xFFFFFF, 0.35); og_R(og_x, og_by + og_bh - og_h, og_bw, 2);
    og_a ? ( ui_col(OG_AMB); og_R(og_x, og_by + og_bh - og_h, og_bw, 4); );
  );
  // accent cell
  og_a ? (
    ui_cola(OG_AMB, 0.25); og_R(og_x - 1, og_ay - 1, og_bw + 2, og_ah + 2);
    ui_col(OG_AMB); og_R(og_x + 1, og_ay + 1, og_bw - 2, og_ah - 2);
    ui_col(0x2A1A05); gfx_circle((og_x + og_bw * 0.5) * sc, (og_ay + og_ah * 0.5) * sc, 3.5 * sc, 1, 1);
  ) : (
    ui_col(0x0C0A26); og_R(og_x, og_ay, og_bw, og_ah);
    ui_cola(OG_AMB, 0.35); gfx_rect(og_x * sc, og_ay * sc, og_bw * sc, og_ah * sc, 0);
  );
  // the playhead
  og_i == oa_step ? (
    ui_cola(OG_CYA, 0.16); og_R(og_x, og_by, og_bw, og_bh);
    ui_col(OG_CYA); og_k = 0; loop(2, gfx_rect((og_x - 2) * sc - og_k, (og_by - 2) * sc - og_k, (og_bw + 4) * sc + 2 * og_k, (og_bh + 4) * sc + 2 * og_k, 0); og_k += 1; );
    og_R(og_x, og_ay + og_ah + 3, og_bw, 3);
  );
  og_in(og_x, og_by - 4, og_pt, og_bh + 8) ? og_hov = og_i;
  og_i += 1;
);
// drawing: left-drag sets levels (painting across steps), right-drag erases
og_ingrid = og_in(og_gx, og_by - 6, og_gw, og_bh + 12);
pressed && drag_id == 0 && og_ingrid ? ( drag_id = 7001; og_pi = -1; );
og_rpress && og_ingrid ? ( og_rd = 1; og_pi = -1; );
!(mouse_cap & 2) ? og_rd = 0;
(drag_id == 7001 && mdown) || og_rd ? (
  og_si = min(max(floor((og_mx - og_gx) / og_pt), 0), og_nst - 1);
  og_l = og_rd ? 0 : min(max((og_by + og_bh - og_my) / og_bh, 0), 1);
  og_pi >= 0 && og_pi != og_si ? (
    og_d = og_si > og_pi ? 1 : -1; og_k = og_pi + og_d;
    while (og_k != og_si) (
      og_put(og_k, og_pl + (og_l - og_pl) * (og_k - og_pi) / (og_si - og_pi), og_acc(og_k));
      og_k += og_d;
    );
  );
  og_put(og_si, og_l, og_acc(og_si));
  og_pi = og_si; og_pl = og_l; og_hov = og_si;
);
// accent row: click toggles, drag paints the same state
og_inacc = og_in(og_gx, og_ay - 2, og_gw, og_ah + 4);
pressed && drag_id == 0 && og_inacc ? (
  og_si = min(max(floor((og_mx - og_gx) / og_pt), 0), og_nst - 1);
  og_ap = !og_acc(og_si); drag_id = 7002;
);
drag_id == 7002 && mdown ? (
  og_si = min(max(floor((og_mx - og_gx) / og_pt), 0), og_nst - 1);
  og_put(og_si, og_lev(og_si), og_ap);
);
// the level of the step under the mouse
og_hov >= 0 ? (
  og_x = og_gx + og_hov * og_pt; og_l = og_lev(og_hov);
  sprintf(#og_s, "%d", floor(og_l * 100 + 0.5));
  gfx_setfont(4); ui_col(OG_INK);
  og_TC(og_x + og_bw * 0.5, min(og_by + og_bh - og_l * og_bh + 6, og_by + og_bh - 18), #og_s);
);

// =====================================================================
// GATE knobs
// =====================================================================
og_sect(850, 70, 334, 218, 0x131138, "GATE");
gfx_setfont(4); ui_col(OG_DIM); og_TR(1172, 77, "PATTERN MODULATION");
sprintf(#og_v, "%d%%", floor(slider3 + 0.5)); og_knob(906, 132, 24, 3, 0, 100, 100, 0, 0, "DEPTH", #og_v);
sprintf(#og_v, "%d%%", floor(slider4 + 0.5)); og_knob(1018, 132, 24, 4, 0, 100, 15, 0, 0, "GLIDE", #og_v);
sprintf(#og_v, "+%.1f dB", slider5 * 0.06); og_knob(1130, 132, 24, 5, 0, 100, 50, 0, 0, "ACCENT", #og_v);
sprintf(#og_v, "%d%%", floor(slider6 + 0.5)); og_knob(906, 230, 24, 6, 0, 50, 0, 0, 0, "SWING", #og_v);
sprintf(#og_v, "%+d%%", floor(slider7 + 0.5)); og_knob(1018, 230, 24, 7, -100, 100, 0, 0, 1, "PAN", #og_v);
sprintf(#og_v, "%+.1f oct", slider8); og_knob(1130, 230, 24, 8, -5, 5, 0, 0, 1, "FILTER", #og_v);

// =====================================================================
// FILTER
// =====================================================================
og_sect(16, 300, 314, 186, 0x15133C, "FILTER");
og_i = 0;
loop(4,
  og_key(112 + og_i * 52, 306, 48, 26, floor(slider9 + 0.5) == og_i, OG_COR, og_i == 0 ? "OFF" : og_i == 1 ? "LP" : og_i == 2 ? "BP" : "HP") ? og_set(9, og_i);
  og_i += 1;
);
og_fhp = floor(slider9 + 0.5) == 3;
slider10 >= 1000 ? sprintf(#og_v, "%.2f kHz", slider10 / 1000) : sprintf(#og_v, "%d Hz", floor(slider10 + 0.5));
dy_kf = og_fhp ? 1 : 2;                          // HP = the yellow filter cap, otherwise the black one
og_knob(62, 406, 24, 10, 20, 20000, 2000, 1, 0, "CUTOFF", #og_v);
sprintf(#og_v, "%d%%", floor(slider11 + 0.5)); og_knob(140, 406, 21, 11, 0, 100, 20, 0, 0, "RESO", #og_v);
sprintf(#og_v, "%+.2f oct", slider12); og_knob(212, 406, 21, 12, -4, 4, 0, 0, 1, "LFO", #og_v);
og_sknob(282, 406, 21, 13, 16, 2, "RATE", lfo_div_name(floor(slider13 + 0.5)));

// =====================================================================
// DELAY
// =====================================================================
og_sect(342, 300, 376, 186, 0x131139, "DELAY");
og_screen(420, 305, 216, 28);
og_ms = lfo_div_q(floor(slider14 + 0.5)) * 60000 / max(tempo, 20);
sprintf(#og_s, "%s   L %s   R %s", lfo_div_name(floor(slider14 + 0.5)), og_mname(slider15), og_mname(slider16));
gfx_setfont(4); ui_col(OG_CYA); og_TL(430, 311, #og_s);
og_key(646, 306, 62, 26, slider20 > 0.5, OG_COR, "PING") ? og_set(20, slider20 < 0.5);
og_sknob(382, 406, 22, 14, 16, 10, "TIME", lfo_div_name(floor(slider14 + 0.5)));
sprintf(#og_v, "%d ms", floor(min(og_ms * oa_mult(slider15), 4000) + 0.5)); og_sknob(442, 406, 18, 15, 5, 2, "L", #og_v);
sprintf(#og_v2, "%d ms", floor(min(og_ms * oa_mult(slider16), 4000) + 0.5)); og_sknob(498, 406, 18, 16, 5, 2, "R", #og_v2);
sprintf(#og_v, "%d%%", floor(slider17 + 0.5)); og_knob(560, 406, 21, 17, 0, 95, 35, 0, 0, "FDBK", #og_v);
sprintf(#og_v, "%.1f kHz", slider18 / 1000); dy_kf = 2; og_knob(622, 406, 21, 18, 1000, 20000, 6000, 1, 0, "DAMP", #og_v);
sprintf(#og_v, "%d%%", floor(slider19 + 0.5)); og_knob(680, 406, 21, 19, 0, 100, 0, 0, 0, "MIX", #og_v);

// =====================================================================
// SPACE
// =====================================================================
og_sect(730, 300, 188, 186, 0x16143E, "SPACE");
og_screen(808, 305, 100, 28);
sprintf(#og_s, "%.1f s", 0.4 + (slider22 / 100) ^ 2 * 9.6);
gfx_setfont(4); ui_col(OG_CYA); og_TR(898, 311, #og_s);
sprintf(#og_v, "%d%%", floor(slider21 + 0.5)); og_knob(766, 406, 21, 21, 0, 100, 50, 0, 0, "SIZE", #og_v);
sprintf(#og_v, "%d%%", floor(slider22 + 0.5)); og_knob(825, 406, 21, 22, 0, 100, 50, 0, 0, "DECAY", #og_v);
sprintf(#og_v, "%d%%", floor(slider23 + 0.5)); og_knob(884, 406, 21, 23, 0, 100, 0, 0, 0, "MIX", #og_v);

// =====================================================================
// MASTER
// =====================================================================
og_sect(930, 300, 254, 186, 0x121035, "MASTER");
dy_ink = OG_INK; dy_ntick = 11;
rd_io(934, 336, 27, 28, 29, 30);
sprintf(#og_v, "%d%%", floor(slider24 + 0.5)); og_knob(976, 436, 20, 24, 0, 100, 100, 0, 0, "MIX", #og_v);
sprintf(#og_v, "%+.1f dB", slider25); og_knob(1062, 436, 20, 25, -24, 12, 0, 0, 1, "OUTPUT", #og_v);
ogmL.ui_ledm(1146 * sc, 312 * sc, 12 * sc, 150 * sc, oa_pkL);
ogmR.ui_ledm(1162 * sc, 312 * sc, 12 * sc, 150 * sc, oa_pkR);
oa_pkL *= 0.85; oa_pkR *= 0.85;
gfx_setfont(4); ui_col(OG_DIM); og_TC(1160, 466, "OUT");

// =====================================================================
// header (drawn last so the pop-up values of its knob sit on top)
// =====================================================================
ui_cola(0x000000, 0.35); gfx_circle(35 * sc, 31 * sc, 18 * sc, 1, 1);
ui_col(OG_COR); gfx_circle(34 * sc, 29 * sc, 18 * sc, 1, 1);
gfx_setfont(4); ui_col(0x140F30); og_TC(34, 22, "GFX");
gfx_setfont(6, "Trebuchet MS", 31 * sc, 'b');
ui_cola(OG_COR, 0.35); og_TL(63, 6, "OONTECHO");
ui_col(OG_INK); og_TL(62, 5, "OONTECHO"); ver_tag("v2", 16, 0, 0);
gfx_setfont(4); ui_col(OG_DIM); og_TL(64, 40, "GATE  /  FILTER  /  DELAY  /  SPACE");
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
og_k = pk_preset(318 * sc, 12 * sc, 440 * sc, 34 * sc, pr_cur,
  "Init|Classic 16ths|Euphoric Gate|Sidechain Pump|Half-Time Chop|Filter Sequence|Dub Delay Gate|Ambient Wash|Triplet Trance|Ping-Pong Pan|32nd Stutter|LFO Sweep Gate");
og_k > 0 ? ( prs_dirty = og_k; pr_cur = og_k; );
// tempo / sync display
og_screen(776, 12, 168, 34);
sprintf(#og_s, "%.1f BPM", tempo); gfx_setfont(2); ui_col(OG_INK); og_TL(788, 21, #og_s);
og_play = play_state & 1;
rd_led(896, 29, 4, og_play, OG_CYA);
gfx_setfont(4); ui_col(og_play ? OG_CYA : OG_DIM); og_TL(906, 22, og_play ? "SYNC" : "FREE");
// DRIFT (small cap)
gfx_setfont(4); ui_col(OG_DIM); og_TR(1022, 22, "DRIFT");
dy_ink = OG_INK; dy_ntick = 11; dy_kst = 20;
sprintf(#og_v, "%d%%", floor(slider26 + 0.5)); dy_knob(1050, 29, 15, 26, 0, 100, 25, 0, 0x8A7BE0, "", #og_v);
ui_size_picker(1116 * sc, 20 * sc);

og_pcap = mouse_cap;
pk_end();
ui_end();
