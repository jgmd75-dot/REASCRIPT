desc:Raum81 [chorus] (GFX)
//tags: chorus spatial stereo widener bbd ensemble modulation space
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// RAUM81. A four-button stereo space processor in the spirit of the classic late-70s Japanese studio rack
// "spatial" choruses, dressed as Eastern European studio gear (third of the family with Meter81 and Tuner81).
// It is not a chorus you hear wobble: the image opens out and the sound gets a little bigger and smoother,
// and it folds back to mono cleanly.
//
// SIGNAL FLOW
//   input -> INPUT trim (with a red overload LED, -3 dBFS) -> the dry path, untouched, straight to the output matrix
//   input -> MONO: L + R summed to mono for the wet path (as on the hardware) / STEREO: L feeds line A, R feeds line B
//   -> two bucket-brigade delay lines (about 3.2 ms each), each with a 2-pole anti-alias low-pass (9.5 kHz) before
//      the delay, a very gentle saturation in the line and a 4-pole reconstruction low-pass (9 kHz) after it.
//      No compander (the original was very quiet), so there is no pumping and no compander breathing.
//   -> one LFO, a smoothed triangle (rounded at the turns, as on the hardware), sweeps line A; line B gets the
//      inverted copy, so the two delays always move in opposite directions.
//   -> the output matrix:  L = dry L + w * (A - k * B)     R = dry R + w * (B - k * A)
//      Each line goes back to its own side and, polarity-inverted, to the other side. With k close to 1 the wet
//      signal is almost all "side": in the mono sum (L + R) the two wet lines nearly cancel and what is left is the
//      dry signal, so there is no comb filtering when the mix is folded to mono. At low frequencies A and B are
//      nearly identical, so A - B cancels there as well: the bass stays dry and centred.
//      k = 0.9 x WIDTH (100 % = the hardware's matrix); WIDTH 0 = no cross-feed (each side its own chorus line).
//      The wet part of each side then passes a 2-pole 110 Hz low cut, so each side's low end stays dry and steady.
//   -> MIX (100 % = the hardware's fixed blend, 0 = dry) -> level trim -> OUTPUT -> the house output stage
//      (band SAT, soft clip always on). MONO SUM (the SUM key) folds the output to mono to check the collapse.
//
// THE FOUR BUTTONS (each a fixed rate / depth pairing, 1 subtlest ... 4 strongest; approximations of the hardware):
//   1  0.25 Hz  +/-0.35 ms      2  0.25 Hz  +/-0.65 ms      3  0.25 Hz  +/-1.00 ms      4  0.50 Hz  +/-1.35 ms
//   (the wet level also rises from 1 to 4: about -6, -4.7, -3.6 and -2.5 dB under the dry). Two buttons at once give the combination modes, as when two
//   buttons are held in on the hardware: the rate is the average of the two, the depth a little more than either
//   (1+4 is the deepest-sounding of the gentle settings). All changes glide (no zipper, no pitch jump).
//   Click = that button alone (click the lit button again = all out = OFF, dry). SHIFT- or CTRL-click, or the COMBI
//   key, adds / removes a second button. OFF releases all buttons.
//
// DRIFT (0 - 100 %, 50 % = standard): BBD clock wander. Each delay line's clock wanders slowly on its own (the delay
//   times move apart by up to about +/-2.5 % at 50 %), the LFO rate wanders (+/-4 %), and a touch of BBD hiss
//   (about -103 dBFS at 50 %, -97 dBFS at 100 %, filtered like the real thing) rides on the wet signal. 0 % = perfectly steady and silent.
//
// MODE (the two lit keys in the header) sets the look, the label language and the chorus voicing together:
//   VFD    - the Japanese rack: charcoal slate, cold turquoise glow, English labels, and Raum81's chorus exactly as it
//            always was (3.2 ms lines, 9.5 / 9 kHz filters, the rounded triangle, the 110 Hz wet low cut).
//   MATRIX - the European ensemble line: battleship grey, mustard amber, German labels, and a darker, longer line
//            (4.6 ms, 7.8 / 7.2 kHz filters, a little more line saturation), a sine sweep with a faint 5.7 Hz shimmer
//            on top (as on the European string-ensemble choruses) and a 140 Hz wet low cut. Level-matched to VFD.
//   Switching fades the chorus wet out, changes the voicing at the silent point and fades it back (the dry and the
//   MICROSHIFT carry on). The mode is the old THEME slider, so old projects keep their look.
//
// MICROSHIFT (before the chorus: input -> MICROSHIFT -> chorus). A stereo micro-pitch doubler.
//   The input is summed to mono and feeds two independent shifters, LEFT and RIGHT. Each has PITCH (-50 ... +50 cents,
//   a quarter-tone each way, 0.1 cent steps; shift-drag for very fine moves) and DELAY (0 - 50 ms), on one concentric
//   knob per side (the inner cap is PITCH, the outer ring DELAY). Each side's voice goes to its own side, added to the
//   untouched stereo dry. MIX (in SPACE) is the master wet / dry for both the MICROSHIFT and the chorus.
//   The shifter: two read heads on a delay line, one playing at a time and gliding at the shifted speed; when it runs
//   out of room the other head takes over one "grain" away, with a short crossfade (every 0.3 - 30 s, depending on the
//   shift). At 0 cents there is no crossfade at all: a clean delay.
//   ADAPT: a pitch tracker (YIN on a decimated ~8 kHz copy, 75 Hz - 1 kHz) follows a monophonic input; while it holds
//     a pitch, the grain is a whole number of periods (about 20 ms) and the takeover point is fine-aligned on the
//     full-rate signal, so the two heads are in phase in the crossfade: no comb filtering on vocals or solo lines.
//     On chords, noise or silence it falls back to the fixed 20 ms grain with an equal-power crossfade. The green
//     TRACK LED shows when it holds a pitch.
//   DELAY moves duck that side's voice (a few ms down, the jump at the silent point, back up), so moving it never
//     choruses.  COLOR: a subtle analogue line stage on the doubled voices (soft, slightly asymmetric, 13 kHz top).
//   WIDE / NARROW: the voices' stereo spread (NORMAL = each voice on its own side; WIDE adds side, NARROW pulls them
//     towards the centre).  The ON key fades the section in / out (OFF = Raum81 exactly as before).
//   No lookahead: nothing is reported to REAPER as latency (the dry is never delayed).
//   The display shows both sides' PITCH / DELAY, the tracker, and the output's phase correlation (+1 mono ... -1).
//
// GUI: click a key; drag a knob (shift = fine, double-click = default); click the LCD for the preset list.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:2<0,10,1{Off,1,2,3,4,1+2,1+3,1+4,2+3,2+4,3+4}>-Mode (buttons)
slider2:0<-24,12,0.1>-Input trim (dB)
slider3:100<0,100,1>-Mix (%)
slider4:100<0,100,1>-Width (%)
slider5:0<0,1,1{Mono,Stereo}>-Wet input
slider6:50<0,100,1>-Drift (%)
slider7:0<-24,12,0.1>-Output (dB)
slider8:0<0,1,1{Off,On}>-Mono sum check
slider9:1<1,2,1{VFD,Matrix}>-Mode
slider10:0<0,100,1>-Band sat (%)
slider11:30<0,100,1>-Bias (%)
slider12:120<40,400,1>-Sat low band (Hz)
slider13:6000<2000,16000,10>-Sat high band (Hz)
slider14:-0.3<-24,0,0.1>-Ceiling (dB)
slider15:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider16:0<0,1,1{ENG,DE}>-(unused, was label language)
slider17:0<0,1,1{Off,On}>-Microshift
slider18:8<-50,50,0.1>-Microshift left pitch (cents)
slider19:11<0,50,0.1>-Microshift left delay (ms)
slider20:-8<-50,50,0.1>-Microshift right pitch (cents)
slider21:17<0,50,0.1>-Microshift right delay (ms)
slider22:1<0,1,1{Off,On}>-Microshift adaptive tracking
slider23:0<0,1,1{Off,On}>-Microshift color
slider24:0<0,2,1{Normal,Wide,Narrow}>-Microshift spread
slider25:prs_sel=0<0,17,1{No preset,Init,Vocal Air,Keys Wide,Bass Safe,Guitar Double,1+4 Deep,Strings Bloom,Pad Halo,Backing Vocals,Drum Room,Mono Check,Vocal Doubler,Wide Guitar,Subtle Thickener,Quarter-Tone Detune,Doubled Ensemble,Slap Double}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-raum81";                                // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
// the two lines (A, B) and the house output stage are allocated in rz_srinit() below (their size follows the rate)
rz_den = 0.000000000000000001;                          // keeps the filter states clear of denormals

// ---------- the buttons: mode index <-> button bits (1, 2, 4, 8) ----------
function rz_bits(m) (
  m = m | 0;
  m == 0 ? 0 : m <= 4 ? 2 ^ (m - 1) : m == 5 ? 3 : m == 6 ? 5 : m == 7 ? 9 : m == 8 ? 6 : m == 9 ? 10 : 12;
);
function rz_idx(b) (
  b == 1 ? 1 : b == 2 ? 2 : b == 4 ? 3 : b == 8 ? 4 : b == 3 ? 5 : b == 5 ? 6 : b == 9 ? 7 :
  b == 6 ? 8 : b == 10 ? 9 : b == 12 ? 10 : 0;
);
// one button's settings (i = 0..3): rate Hz, depth ms (+/-), wet level
function rz_brate(i) ( i == 3 ? 0.5 : 0.25 );
function rz_bdep(i)  ( i == 0 ? 0.35 : i == 1 ? 0.65 : i == 2 ? 1.00 : 1.35 );
function rz_bwet(i)  ( i == 0 ? 0.50 : i == 1 ? 0.58 : i == 2 ? 0.66 : 0.75 );
// the mode's targets: rz_rt (Hz), rz_dt (ms), rz_wt (wet, 0 = off)
function rz_modeset(m) local(b, i, n, a, c) (
  b = rz_bits(m); n = 0; a = -1; c = -1;
  i = 0; loop(4, b & (2 ^ i) ? ( n += 1; a < 0 ? (a = i) : (c = i); ); i += 1; );
  n == 0 ? ( rz_wt = 0; ) :
  n == 1 ? ( rz_rt = rz_brate(a); rz_dt = rz_bdep(a); rz_wt = rz_bwet(a); ) : (
    rz_rt = 0.5 * (rz_brate(a) + rz_brate(c));
    rz_dt = 1.1 * sqrt(sqr(rz_bdep(a)) + sqr(rz_bdep(c)));
    rz_wt = max(rz_bwet(a), rz_bwet(c)) + 0.02;
  );
  rz_on = n > 0;
);

// ---------- filters ----------
// biquad low-pass coefficients (Audio EQ Cookbook) into this namespace
function rz_lpset(f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
// anti-alias (before the bucket brigade): 2-pole Butterworth, 9.5 kHz; reconstruction: 4-pole Butterworth, 9 kHz,
// in two sections (set in rz_srinit() below)
// the wet's low cut: 2-pole high-pass, 110 Hz, so the low end of each side stays dry, steady and centred
function rz_hpset(f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * f / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function rz_hp(x) instance(z1, z2) local(y) (
  y = rzH.b0 * x + z1; z1 = rzH.b1 * x - rzH.a1 * y + z2; z2 = rzH.b2 * x - rzH.a2 * y; y;
);

// fractional delay read, 4-point Hermite (d in samples)
function rz_rd(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = rz_wp - d; rp < 0 ? rp += rz_bsz;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + rz_bsz - 1) & rz_mask];
  x0  = buf[i & rz_mask];
  x1  = buf[(i + 1) & rz_mask];
  x2  = buf[(i + 2) & rz_mask];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
// one bucket-brigade line: anti-alias low-pass, delay, very mild saturation, reconstruction low-pass
function rz_line(x, buf, d) instance(p1, p2, q1, q2, r1, r2) local(y, v) (
  x += rz_den;
  y = rzP.b0 * x + p1; p1 = rzP.b1 * x - rzP.a1 * y + p2; p2 = rzP.b2 * x - rzP.a2 * y;
  buf[rz_wp] = y;
  v = rz_rd(buf, d);
  v = ost_tanh(v * rz_sk) * rz_ski;                     // VFD 0.7: under 0.3 dB of squash at -6 dBFS (MATRIX 0.95)
  y = rzQ.b0 * v + q1; q1 = rzQ.b1 * v - rzQ.a1 * y + q2; q2 = rzQ.b2 * v - rzQ.a2 * y;
  v = rzR.b0 * y + r1; r1 = rzR.b1 * y - rzR.a1 * v + r2; r2 = rzR.b2 * y - rzR.a2 * v;
  v;
);

// ---------- the two chorus voicings (MODE): 0 = VFD (the Japanese rack, Raum81 as it always was), 1 = MATRIX ----------
// (the European ensemble line). Set at init and, on a mode change, at the silent point of the wet fade.
function rz_voice(v) (
  v == 0 ? (
    rz_cen = 3.2; rz_sk = 0.7; rz_ski = 1.4285714; rz_shp = 0; rz_fdp = 0; rz_vtr = 1;
    rzP.rz_lpset(9500, 0.7071); rzQ.rz_lpset(9000, 0.5412); rzR.rz_lpset(9000, 1.3066);
    rzH.rz_hpset(110, 0.7071);
  ) : (
    rz_cen = 4.6; rz_sk = 0.95; rz_ski = 1 / 0.95; rz_shp = 1; rz_fdp = 0.045; rz_vtr = 1.06;
    rzP.rz_lpset(7800, 0.7071); rzQ.rz_lpset(7200, 0.5412); rzR.rz_lpset(7200, 1.3066);
    rzH.rz_hpset(140, 0.7071);
  );
);

// ---------- MICROSHIFT ----------
// the tracker's feed filter (two of these in series, 1.8 kHz) before the decimation
function ms_bq(x) instance(z1, z2) local(y) (
  y = pdK.b0 * x + z1; z1 = pdK.b1 * x - pdK.a1 * y + z2; z2 = pdK.b2 * x - pdK.a2 * y; y;
);
// fractional read of the shifter's (mono) line, 4-point Hermite (d in samples, at least 2)
function ms_rd(d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = ms_wp - d; rp < 0 ? rp += ms_bsz;
  i = floor(rp); f = rp - i;
  xm1 = ms_buf[(i + ms_bsz - 1) & ms_mask];
  x0  = ms_buf[i & ms_mask];
  x1  = ms_buf[(i + 1) & ms_mask];
  x2  = ms_buf[(i + 2) & ms_mask];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
// the takeover alignment (ADAPT, while a pitch is held): the new head's distance from the old one, j (whole samples),
// searched in jlo ... jhi for the best match of the last ms_L samples (squared difference); sg = +1 when the new
// head sits further back (pitch up), -1 when it sits nearer the input (pitch down)
function ms_align(d, jlo, jhi, sg) local(p, q, j, s, e, best, jb, m) (
  p = floor(ms_wp - d); best = 10 ^ 30; jb = jlo; j = jlo;
  loop(max(jhi - jlo + 1, 1),
    q = p - sg * j; s = 0; m = 0;
    loop(ms_ln, e = ms_buf[(p - m) & ms_mask] - ms_buf[(q - m) & ms_mask]; s += e * e; m += ms_st; );
    s < best ? ( best = s; jb = j; );
    j += 1;
  );
  jb;
);
// the period detector (YIN, cumulative-mean-normalised difference) on the latest decimated block; sets ms_T (the
// period in full-rate samples) and ms_lkt (1 = a clear single pitch is there)
function ms_yin() local(n, i, j, t, s, e, p, q, cum, bt, tf, a, b, c, d, en, go) (
  n = ms_W + ms_tmax;
  i = 0; j = (pd_wi - n) & 1023;
  loop(n, pd_x[i] = pd_buf[j]; j = (j + 1) & 1023; i += 1; );
  en = 0; p = pd_x; loop(ms_W, en += p[0] * p[0]; p += 1; );
  cum = 0; t = 1;
  loop(ms_tmax,
    s = 0; p = pd_x; q = pd_x + t;
    loop(ms_W, e = p[0] - q[0]; s += e * e; p += 1; q += 1; );
    cum += s;
    pd_d[t] = cum > 0 ? s * t / cum : 1;
    t += 1;
  );
  // the first dip under 0.12, followed down to its floor; else the deepest point
  bt = 0; t = ms_tmin; go = 1;
  while (go && t < ms_tmax) (
    pd_d[t] < 0.12 ? (
      while (t + 1 < ms_tmax && pd_d[t + 1] < pd_d[t]) ( t += 1; );
      bt = t; go = 0;
    );
    t += 1;
  );
  bt == 0 ? ( d = 2; t = ms_tmin; loop(ms_tmax - ms_tmin, pd_d[t] < d ? ( d = pd_d[t]; bt = t; ); t += 1; ); );
  tf = bt;
  bt > ms_tmin && bt < ms_tmax - 1 ? (
    a = pd_d[bt - 1]; b = pd_d[bt]; c = pd_d[bt + 1]; d = a - 2 * b + c;
    d > 0 ? ( tf = bt + 0.5 * (a - c) / d; );
  );
  en > ms_W * 0.00001 && pd_d[bt] < 0.2 ? (               // above -50 dBFS and clearly periodic
    tf *= ms_dec;
    abs(tf - ms_T) < 0.04 * ms_T ? ( ms_T += (tf - ms_T) * 0.5; ) : ( ms_T = tf; );
    ms_lkt = 1;
  ) : ( ms_lkt = 0; );
);
// one side's DELAY (ms): a change starts the duck (held 40 ms after the last move)
function ms_dly(v) instance(dt, hold) local(t) (
  t = min(max(v, 0), 50) * srate / 1000;
  t != dt ? ( dt = t; hold = floor(0.04 * srate); );
);
// one side's shifter: returns its voice. ct = the PITCH target (cents), dc / dt = the DELAY (samples) now / target,
// g = the DELAY duck, dA / dB = the two heads' places behind the DELAY point, act = the one playing (0 = A),
// fp = the takeover crossfade (0 ... 1, 1 = none running), fl = its law (1 = in phase: linear, 0 = equal power)
function ms_side() instance(c, ct, dA, dB, act, fp, fs, fl, dc, dt, g, hold) local(rr, dh, j, j0, jl, jh, y, p, wn, wo, base, mv) (
  c += (ct - c) * rz_smk;
  rr = 1 - exp(c * 0.000577622650466621);               // the heads' movement per sample (pitch up: towards the input)
  dA = min(max(dA + rr, 0), ms_omax); dB = min(max(dB + rr, 0), ms_omax);
  // DELAY: duck while it moves, jump at the silent point, come back
  hold > 0 ? hold -= 1;
  mv = hold > 0 || dc != dt;
  g += ((!mv) - g) * (mv ? ms_kdn : ms_kup);
  mv && g < 0.0005 ? ( dc = dt; );
  base = 3 + dc;
  dh = act ? dB : dA;
  // the takeover: the playing head is about to run out of room, so the other one starts a grain away
  fp >= 1 && rr != 0 && (rr < 0 ? dh <= ms_X * -rr + 1 : dh >= ms_J) ? (
    j0 = floor(ms_J + 0.5);
    ms_ref ? (
      jl = j0 - ms_R; jh = j0 + ms_R;
      rr > 0 ? ( jh = min(jh, floor(dh)); );
      j = ms_align(base + dh, max(jl, 1), jh, rr < 0 ? 1 : -1);
    ) : ( j = rr > 0 ? min(j0, floor(dh)) : j0; );
    act ? ( dA = dh + (rr < 0 ? j : -j); ) : ( dB = dh + (rr < 0 ? j : -j); );
    act = !act; fp = 0; fs = 1 / ms_X; fl = ms_lk;
  );
  fp < 1 ? (
    fp = min(fp + fs, 1); p = fp;
    wn = fl * (0.5 - 0.5 * cos($pi * p)) + (1 - fl) * sin(0.5 * $pi * p);
    wo = fl * (0.5 + 0.5 * cos($pi * p)) + (1 - fl) * cos(0.5 * $pi * p);
    y = wn * ms_rd(base + (act ? dB : dA)) + wo * ms_rd(base + (act ? dA : dB));
  ) : ( y = ms_rd(base + (act ? dB : dA)); );
  y * g;
);
// COLOR: a soft, slightly asymmetric line stage (unity small-signal gain), its 13 kHz top and a DC blocker
function ms_col(x) instance(lp, hx, hy) local(y) (
  y = (ost_tanh(1.5 * (x + 0.1)) - ms_cb0) * ms_cbn;
  lp += (y - lp) * ms_clp;
  hy = lp - hx + 0.9995 * hy; hx = lp;
  hy;
);

// ---------- settings ----------
function update() (
  rz_modeset(slider1);
  in_setup(slider2, 0);
  rz_mxt = slider3 / 100;
  rz_kt = 0.9 * slider4 / 100;
  rz_st = slider5 > 0.5;
  drift_macro(slider6);
  rz_ot = 10 ^ (slider7 / 20);
  rz_sumt = slider8 > 0.5;
  rz_hs = slider6 / 100 * 0.00007;                      // BBD hiss (uniform noise, filtered: about -103 dBFS rms at 50 %)
  ost_setup(slider10 / 100, slider11 / 100, slider12, slider13, slider14, 1);   // output stage: CLIP, always on
  rz_vmt = slider9 >= 1.5;                              // MODE: 0 = VFD, 1 = MATRIX (the voicing follows at the fade)
  // MICROSHIFT
  ms_ont = slider17 > 0.5;
  msL.ct = min(max(slider18, -50), 50); msL.ms_dly(slider19);
  msR.ct = min(max(slider20, -50), 50); msR.ms_dly(slider21);
  ms_trk = ms_ont && slider22 > 0.5;
  ms_cbt = slider23 > 0.5;
  ms_kst = slider24 < 0.5 ? 1 : slider24 < 1.5 ? 1.7 : 0.4;   // NORMAL / WIDE / NARROW
);

// ---------- presets (a preset sets the mode; the output stage is left alone) ----------
function rz_set(m, tr, mx, wd, st, dr, ou, sm) (
  slider1 = m; slider2 = tr; slider3 = mx; slider4 = wd; slider5 = st; slider6 = dr; slider7 = ou; slider8 = sm;
  slider_automate(255);                                 // sliders 1-8
);
// the mode (1 = VFD, 2 = MATRIX) and the MICROSHIFT: on, left pitch / delay, right pitch / delay, adapt, color, spread
function rz_ms(md, on, lp, ld, rp, rd, ad, co, sp) (
  slider9 = md; slider17 = on; slider18 = lp; slider19 = ld; slider20 = rp; slider21 = rd;
  slider22 = ad; slider23 = co; slider24 = sp;
  slider_automate(256 + 16711680);                      // slider 9 and sliders 17-24
);
function load_preset(p) (
  p == 1  ? rz_set( 2, 0, 100, 100, 0, 50, 0, 0) :     // Init: button 2
  p == 2  ? rz_set( 1, 0, 100, 100, 0, 40, 0, 0) :     // Vocal Air
  p == 3  ? rz_set( 3, 0, 100, 100, 1, 50, 0, 0) :     // Keys Wide (stereo in: the keyboard's own image stays)
  p == 4  ? rz_set( 1, 0,  70, 100, 0, 30, 0, 0) :     // Bass Safe
  p == 5  ? rz_set( 4, 0, 100, 100, 0, 60, 0, 0) :     // Guitar Double
  p == 6  ? rz_set( 7, 0, 100, 100, 0, 50, 0, 0) :     // 1+4 Deep
  p == 7  ? rz_set(10, 0, 100, 100, 1, 70, 0, 0) :     // Strings Bloom
  p == 8  ? rz_set( 9, 0, 100, 100, 1, 60, 0, 0) :     // Pad Halo (2+4)
  p == 9  ? rz_set( 6, 0,  80,  85, 0, 45, 0, 0) :     // Backing Vocals (1+3)
  p == 10 ? rz_set( 5, 0,  60,  60, 0, 35, 0, 0) :     // Drum Room (1+2, gentle)
  p == 11 ? rz_set( 2, 0, 100, 100, 0, 50, 0, 1) :     // Mono Check: Init with the output summed to mono
  // the MICROSHIFT presets (the chorus part first, then the mode and the doubler)
  p == 12 ? ( rz_set( 0, 0, 100, 100, 0, 50, 0, 0); rz_ms(1, 1,   7, 10,  -7, 15, 1, 0, 0); ) :   // Vocal Doubler
  p == 13 ? ( rz_set( 0, 0, 100, 100, 0, 50, 0, 0); rz_ms(2, 1,  11, 19, -11, 27, 1, 1, 1); ) :   // Wide Guitar
  p == 14 ? ( rz_set( 1, 0,  70, 100, 0, 40, 0, 0); rz_ms(1, 1,   4,  5,  -4,  8, 1, 0, 2); ) :   // Subtle Thickener
  p == 15 ? ( rz_set( 0, 0,  60, 100, 0, 50, 0, 0); rz_ms(2, 1,  50,  2, -50,  4, 1, 0, 0); ) :   // Quarter-Tone Detune
  p == 16 ? ( rz_set( 2, 0, 100, 100, 0, 50, 0, 0); rz_ms(2, 1,   8, 12,  -8, 18, 1, 1, 0); ) :   // Doubled Ensemble
  p == 17 ? ( rz_set( 0, 0, 100, 100, 0, 50, 0, 0); rz_ms(1, 1, -14, 36,  14, 47, 1, 1, 1); ) :   // Slap Double
  p == 18 ? (                                           // Reset all to defaults
    rz_set(2, 0, 100, 100, 0, 50, 0, 0);
    rz_ms(1, 0, 8, 11, -8, 17, 1, 0, 0);
    slider10 = 0; slider11 = 30; slider12 = 120; slider13 = 6000; slider14 = -0.3; slider15 = 1; slider16 = 0;
    slider_automate(16777215);
  );
  // the original presets are the VFD chorus with the MICROSHIFT off (its settings are left where they are)
  p >= 1 && p <= 11 ? ( slider9 = 1; slider17 = 0; slider_automate(256 + 65536); );
);

// ---------- state ----------
// everything that depends on the sample rate (run again from @block if the rate changes: ext_noinit keeps @init
// from running then)
function rz_srinit() (
  rz_sr = srate;
  rz_bsz = srate > 100000 ? 8192 : 4096; rz_mask = rz_bsz - 1;
  nextmem = 0;
  rz_bufA = alloc(rz_bsz);                              // line A
  rz_bufB = alloc(rz_bsz);                              // line B
  ost_init(alloc(4096));                                // the house output stage
  rz_wp = 0;
  rz_voice(rz_vm);                                      // the chorus voicing's filters, line and sweep
  // MICROSHIFT: the mono line (50 ms DELAY + a 50 ms head range + the alignment window), the tracker's buffers
  ms_bsz = 2 ^ ceil(log(0.13 * srate + 64) / log(2)); ms_mask = ms_bsz - 1;
  ms_buf = alloc(ms_bsz); ms_wp = 0;
  pd_buf = alloc(1024); pd_x = alloc(512); pd_d = alloc(256); pd_wi = 0; pd_n = 0; ms_dcn = 0;
  ms_dec = max(1, floor(srate / 8000 + 0.5));           // decimate to about 8 kHz for the tracker
  ms_fd = srate / ms_dec;
  ms_W = floor(ms_fd * 0.0125 + 0.5);                   // 12.5 ms analysis window
  ms_tmax = min(floor(ms_fd / 75), 250);                // 75 Hz ...
  ms_tmin = max(2, floor(ms_fd / 1000));                // ... 1 kHz
  ms_hop = floor(ms_fd * 0.02 + 0.5);                   // a new estimate every 20 ms
  pdK.rz_lpset(1800, 0.7071);
  ms_Jn = 0.02 * srate;                                 // the fixed grain, 20 ms
  ms_omax = 0.05 * srate;                               // the heads' range behind the DELAY point
  ms_T = 0.005 * srate; ms_J = ms_Jn; ms_X = 0.03 * srate; ms_ref = 0; ms_lk = 0; ms_R = 2; ms_ln = 64; ms_st = 1;
  ms_kdn = 1 - exp(-1 / (0.003 * srate));               // the DELAY duck: down in a few ms ...
  ms_kup = 1 - exp(-1 / (0.025 * srate));               // ... back in about 60 ms
  ms_clp = 1 - exp(-2 * $pi * 13000 / srate);           // COLOR's top end
  ms_cb0 = ost_tanh(0.15); ms_cbn = 1 / (1.5 * (1 - ms_cb0 * ms_cb0));
  ms_kc = 1 - exp(-1 / (0.3 * srate));                  // the correlation readout's averaging
  rz_smf = 1 - exp(-1 / (0.006 * srate));               // the mode change's wet fade
  in_init();
  rz_msr = srate / 1000;
  rz_sms = 1 - exp(-1 / (0.35 * srate));                // rate / depth glide on a button change
  rz_smw = 1 - exp(-1 / (0.12 * srate));                // wet fade (OFF / ON)
  rz_smk = 1 - exp(-1 / (0.03 * srate));                // the knobs
  rz_smd = 1 - exp(-1 / (0.5 * srate));                 // clock drift smoothing
);
rz_vm = slider9 >= 1.5; rz_vmt = rz_vm; rz_mf = 1;      // the voicing in use (VFD: lines resting at 3.2 ms, MATRIX 4.6)
rz_srinit(); ostL.ost_ch_init(); ostR.ost_ch_init();
rz_hpc = 0;
rz_ph = rand(1);
drA.drift_init(0.8 + rand(1) * 0.5); drB.drift_init(0.8 + rand(1) * 0.5); drR.drift_init(0.8 + rand(1) * 0.5);
rz_ipk = 0; rz_opkL = 0; rz_opkR = 0;
update();
rz_r = rz_rt; rz_d = rz_dt; rz_w = rz_wt; rz_mx = rz_mxt; rz_k = rz_kt; rz_o = rz_ot; rz_sum = rz_sumt; rz_stm = rz_st;
rz_cA = 0; rz_cB = 0; rz_dvA = 0; rz_dvB = 0; rz_rv = 0; rz_fph = 0; rz_fv = 0;
ms_on = ms_ont; ms_cb = ms_cbt; ms_ks = ms_kst; ms_lock = 0; ms_lkt = 0;
msL.c = msL.ct; msL.dc = msL.dt; msL.hold = 0; msL.g = 1; msL.fp = 1; msL.act = 0; msL.dA = 0; msL.dB = 0;
msR.c = msR.ct; msR.dc = msR.dt; msR.hold = 0; msR.g = 1; msR.fp = 1; msR.act = 0; msR.dA = 0; msR.dB = 0;
ms_cxy = 0; ms_cxx = 0; ms_cyy = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 17 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(17, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
srate != rz_sr ? rz_srinit();
update();                                               // knobs moved on the panel do not run @slider
// DRIFT: BBD clock wander (each line its own clock) and LFO rate wander, eased per sample below
rz_di = 0.2 * dm_s * samplesblock / srate;
rz_dvA = 0.025 * dm_a * drA.drift_tick(rz_di);
rz_dvB = 0.025 * dm_a * drB.drift_tick(rz_di);
rz_rv  = 0.04  * dm_a * drR.drift_tick(rz_di);
// MICROSHIFT: the pitch tracker (ADAPT) and the grain it sets
ms_trk && pd_n >= ms_hop ? ( pd_n = 0; ms_yin(); );
!ms_trk ? ms_lkt = 0;
ms_lock += (ms_lkt - ms_lock) * min(1, samplesblock / (0.06 * srate));
ms_lock > 0.5 ? (                                       // a pitch is held: the grain is a whole number of periods
  ms_J = max(1, floor(ms_Jn / ms_T + 0.5)) * ms_T;
  ms_ref = 1; ms_lk = 1;
  ms_R = min(max(floor(0.3 * ms_T), 2), floor(0.0006 * srate) + 2);
  ms_st = max(1, floor(srate / 24000));
  ms_ln = floor(min(max(1.5 * ms_T, 0.006 * srate), 0.01 * srate) / ms_st);
  ms_X = max(0.012 * srate, 2 * ms_T);
) : (                                                   // chords, noise, silence: the fixed grain
  ms_J = ms_Jn; ms_ref = 0; ms_lk = 0; ms_X = 0.03 * srate;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input ----------
in_process(spl0, spl1);
rz_l = in_l; rz_r0 = in_r;
rz_ipk = max(rz_ipk, max(abs(rz_l), abs(rz_r0)));

// ---------- glides ----------
rz_r  += (rz_rt - rz_r) * rz_sms;
rz_d  += (rz_dt - rz_d) * rz_sms;
rz_w  += (rz_wt - rz_w) * rz_smw;
rz_mx += (rz_mxt - rz_mx) * rz_smk;
rz_k  += (rz_kt - rz_k) * rz_smk;
rz_o  += (rz_ot - rz_o) * rz_smk;
rz_sum += (rz_sumt - rz_sum) * rz_smw;
rz_stm += (rz_st - rz_stm) * rz_smw;
rz_cA += (rz_dvA - rz_cA) * rz_smd;
rz_cB += (rz_dvB - rz_cB) * rz_smd;

// ---------- MICROSHIFT: mono in, two shifted voices out, added to the stereo dry ----------
ms_on += (ms_ont - ms_on) * rz_smw;
ms_in = 0.5 * (rz_l + rz_r0);
ms_buf[ms_wp] = ms_in;
ms_trk ? (                                              // the tracker's feed: 1.8 kHz low-pass, decimated to ~8 kHz
  ms_y = pdA.ms_bq(ms_in + rz_den); ms_y = pdB.ms_bq(ms_y);
  (ms_dcn += 1) >= ms_dec ? ( ms_dcn = 0; pd_buf[pd_wi] = ms_y; pd_wi = (pd_wi + 1) & 1023; pd_n += 1; );
);
ms_ont || ms_on > 0.00002 ? (
  ms_a = msL.ms_side();
  ms_b = msR.ms_side();
  ms_cb += (ms_cbt - ms_cb) * rz_smk;
  ms_cb > 0.0001 ? ( ms_a += (cL.ms_col(ms_a) - ms_a) * ms_cb; ms_b += (cR.ms_col(ms_b) - ms_b) * ms_cb; );
  ms_ks += (ms_kst - ms_ks) * rz_smk;                   // WIDE / NARROW: the voices' side, power-balanced
  ms_m = 0.5 * (ms_a + ms_b); ms_s = 0.5 * (ms_a - ms_b) * ms_ks;
  ms_gg = ms_on * rz_mx * 0.8;                          // MIX 100 % = dry with each voice 2 dB under it
  ms_cm = 1 / sqrt(1 + 0.9 * ms_gg * ms_gg);            // the voice's added power taken back (level-matched)
  ms_g = ms_gg * ms_cm * sqrt(2 / (1 + ms_ks * ms_ks)); // WIDE / NARROW level-matched to NORMAL
  rz_l  = rz_l  * ms_cm + ms_g * (ms_m + ms_s);
  rz_r0 = rz_r0 * ms_cm + ms_g * (ms_m - ms_s);
);
ms_wp = (ms_wp + 1) & ms_mask;

// ---------- MODE: the chorus wet fades out, the voicing changes at the silent point, it fades back ----------
rz_mf += ((rz_vm == rz_vmt) - rz_mf) * rz_smf;
rz_vm != rz_vmt && rz_mf < 0.002 ? ( rz_vm = rz_vmt; rz_voice(rz_vm); );

// ---------- the LFO: VFD a smoothed triangle (rounded turns), MATRIX a sine with a faint 5.7 Hz shimmer; ----------
// ---------- line B gets the inverted copy ----------
rz_ph += rz_r * (1 + rz_rv) / srate; rz_ph >= 1 ? rz_ph -= 1;
rz_shp == 0 ? (
  rz_t = rz_ph < 0.5 ? 4 * rz_ph - 1 : 3 - 4 * rz_ph;
  rz_lv = rz_t * (1.5 - 0.5 * rz_t * rz_t);
  rz_fv = 0;
) : (
  rz_lv = -cos(2 * $pi * rz_ph);
  rz_fph += 5.7 / srate; rz_fph >= 1 ? rz_fph -= 1;
  rz_fv = rz_fdp * sin(2 * $pi * rz_fph);
);

// ---------- the two bucket-brigade lines ----------
rz_m = 0.5 * (rz_l + rz_r0);
rz_xa = rz_m + (rz_l - rz_m) * rz_stm;                  // MONO: both lines get L + R; STEREO: A <- L, B <- R
rz_xb = rz_m + (rz_r0 - rz_m) * rz_stm;
rz_hs > 0 ? ( rz_xa += rz_hs * (rand(2) - 1); rz_xb += rz_hs * (rand(2) - 1); );
rz_dA = max((rz_cen * (1 + rz_cA) + rz_d * rz_lv + rz_fv) * rz_msr, 2);
rz_dB = max((rz_cen * (1 + rz_cB) - rz_d * rz_lv - rz_fv) * rz_msr, 2);
rz_a = lnA.rz_line(rz_xa, rz_bufA, rz_dA);
rz_b = lnB.rz_line(rz_xb, rz_bufB, rz_dB);
rz_wp = (rz_wp + 1) & rz_mask;

// ---------- the output matrix ----------
rz_g0 = rz_w * rz_mx;
rz_cmp = 1 / sqrt(sqrt(1 + 2 * rz_g0 * rz_g0));         // half the wet's added power taken back (stereo up a touch, mono down a touch)
rz_g = rz_g0 * rz_mf * rz_vtr;                          // the mode fade and the voicing's level match
rz_ol = (rz_l  + rz_g * hwL.rz_hp(rz_a - rz_k * rz_b)) * rz_cmp;
rz_or = (rz_r0 + rz_g * hwR.rz_hp(rz_b - rz_k * rz_a)) * rz_cmp;
// MONO SUM check
rz_mm = 0.5 * (rz_ol + rz_or);
rz_ol += (rz_mm - rz_ol) * rz_sum; rz_or += (rz_mm - rz_or) * rz_sum;

// ---------- output stage: band saturation -> OUTPUT -> clipper ----------
rz_ol = ostL.ost_band(rz_ol) * rz_o;
rz_or = ostR.ost_band(rz_or) * rz_o;
ost_out(rz_ol, rz_or);
spl0 = ost_l; spl1 = ost_r;
rz_opkL = max(rz_opkL, abs(spl0)); rz_opkR = max(rz_opkR, abs(spl1));
// the phase correlation readout (the display): averaged products of the output
ms_cxy += (spl0 * spl1 - ms_cxy) * ms_kc + rz_den;
ms_cxx += (spl0 * spl0 - ms_cxx) * ms_kc + rz_den;
ms_cyy += (spl1 * spl1 - ms_cyy) * ms_kc + rz_den;

@gfx 760 420
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(760, 420);

// =====================================================================
// Theme colours (the family palette: Meter81 / Tuner81)
// =====================================================================
rq_th = slider9 >= 1.5 ? 2 : 1;                         // MODE: VFD (1) or MATRIX (2); the retired ENAMEL (0) is left below
rq_th == 0 ? (                                          // ENAMEL: light industrial laboratory
  RQF  = 0xD6D2C4;                                      // bone-grey baked enamel (the section faces)
  RQP  = ui_mix(RQF, 0x000000, 0.10);                   // the panel around them, a shade deeper
  RQH  = ui_mix(RQF, 0x000000, 0.20);                   // header strip
  RQS  = ui_mix(RQF, 0xFFFFFF, 0.08);                   // the button field, a shade lighter
  RQI  = 0x1C1C1C;                                      // deep charcoal print
  RQI2 = 0x4A4842;
  RQA  = 0xFF7900;                                      // safety orange (rules, readout)
  RQL  = 0xFFA126;                                      // the keys' lamp: warm amber behind a milky cap
  RQG  = 0x141414;                                      // readout glass
  RQD  = 0xFF8C00;                                      // readout glow
  RQRED = 0xE0281A;
) : rq_th == 1 ? (                                      // VFD: cold gas-discharge
  RQF  = 0x0F1112;
  RQP  = 0x181A1B;                                      // charcoal slate
  RQH  = ui_mix(RQP, 0x000000, 0.35);
  RQS  = ui_mix(RQP, 0x000000, 0.22);
  RQI  = 0x4EE1DC;                                      // cold turquoise glow
  RQI2 = ui_mix(0x4EE1DC, RQP, 0.45);
  RQA  = 0xFF8C00;                                      // neon amber
  RQL  = 0x4EE1DC;
  RQG  = 0x070808;
  RQD  = 0x4EE1DC;
  RQRED = 0xFF3A2A;
) : (                                                   // MATRIX: military LED matrix
  RQP  = 0x222528;                                      // battleship grey
  RQF  = ui_mix(RQP, 0x000000, 0.25);
  RQH  = ui_mix(RQP, 0x000000, 0.30);
  RQS  = ui_mix(RQP, 0x000000, 0.40);
  RQI  = 0xC7BEB3;                                      // print: elephant's breath
  RQI2 = ui_mix(0xC7BEB3, RQP, 0.4);
  RQA  = 0xD4A373;                                      // mustard amber
  RQL  = 0xD4A373;
  RQG  = 0x0E0F10;
  RQD  = 0xD4A373;
  RQRED = 0xBC3908;
);
RQGRN = 0x1E5631; RQOLV = 0x2C302E;                     // forest-green status blocks, olive-drab unlit cells
rq_de = 0;                                              // English labels in both modes

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');          // title
gfx_setfont(11, "Trebuchet MS", 12 * sc, 'b');          // labels
gfx_setfont(12, "Trebuchet MS", 12.5 * sc, 'b');        // key captions
gfx_setfont(13, "Courier New", 15 * sc, 'b');           // readout
gfx_setfont(15, "Trebuchet MS", 34 * sc, 'b');          // the big button numerals

function rq_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function rq_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function rq_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rq_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rq_lbl(x, y, s) ( gfx_setfont(11); ui_col(RQI2); rq_txt(x, y, s); );
function rq_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );

// a flat, sharp-cornered lit key in the theme's manner (as on Meter81); returns 1 when clicked
function rq_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = rq_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  rq_th == 0 ? (
    ui_col(RQI); rq_r(x, y, w, h);
    on ? ui_col(RQA) : ui_col(hov ? 0xEDEAE0 : ui_mix(RQF, 0xFFFFFF, 0.35)); rq_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(0xFFFFFF, 0.25); rq_r(x + 1, y + 1, w - 2, 1); );
    ui_col(RQI);
  ) : rq_th == 1 ? (
    ui_col(on ? RQI : ui_mix(RQI, RQP, 0.7)); rq_r(x, y, w, h);
    ui_col(0x0A0B0C); rq_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(RQI, 0.22); rq_r(x + 1, y + 1, w - 2, h - 2); ui_cola(RQI, 0.12); rq_r(x - 2, y - 2, w + 4, h + 4); )
       : hov ? ( ui_cola(RQI, 0.08); rq_r(x + 1, y + 1, w - 2, h - 2); );
    on ? ui_col(ui_mix(RQI, 0xFFFFFF, 0.35)) : ui_cola(RQI, 0.55);
  ) : (
    ui_col(0x0B0C0D); rq_r(x, y, w, h);
    on ? ui_col(RQA) : ui_col(hov ? ui_mix(RQOLV, 0xFFFFFF, 0.06) : RQOLV); rq_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(RQA, 0.25); rq_r(x - 2, y - 2, w + 4, h + 4); ui_cola(0xFFFFFF, 0.3); rq_r(x + 1, y + 1, w - 2, 1); );
    on ? ui_col(0x17191B) : ui_cola(RQI, 0.85);
  );
  gfx_setfont(12); rq_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);

// a section: sharp-cornered face with a thin frame and its name
function rq_sect(x, y, w, h, col, name) (
  rq_th == 0 ? ( ui_col(ui_mix(col, 0x000000, 0.45)); rq_r(x, y, w, h); ui_col(col); rq_r(x + 1, y + 1, w - 2, h - 2); )
             : ( ui_col(rq_th == 1 ? ui_mix(RQI, RQP, 0.78) : 0x0B0C0D); rq_r(x, y, w, h); ui_col(col); rq_r(x + 1, y + 1, w - 2, h - 2); );
  rq_lbl(x + 9, y + 6, name);
);

// the round panel LED (ENAMEL / VFD) or a square block (MATRIX)
function rq_led(x, y, on, col) (
  rq_th == 2 ? (
    ui_col(0x0B0C0D); rq_r(x - 6, y - 4, 12, 8);
    ui_col(on ? col : ui_mix(col, RQOLV, 0.8)); rq_r(x - 5, y - 3, 10, 6);
    on ? ( ui_cola(col, 0.25); rq_r(x - 8, y - 6, 16, 12); ui_cola(0xFFFFFF, 0.3); rq_r(x - 5, y - 3, 10, 1); );
  ) : rd_led(x, y, 3.2, on, col);
);

// ---------- the four big square lit push-buttons ----------
function rq_big(x, y, w, h, s, on) local(hov, dn, k, c, i) (
  hov = rq_hov(x, y, w, h);
  dn = on ? 2 : 0;                                      // a latched key sits a little lower
  // the well
  ui_cola(0x000000, rq_th == 0 ? 0.28 : 0.5); rq_r(x + 1, y + 3, w, h);
  ui_col(0x0A0A0B); rq_r(x - 2, y - 2, w + 4, h + 4);
  rq_th == 0 ? (                                        // ENAMEL: milky cap, amber lamp behind it
    on ? (
      ui_cola(RQL, 0.30); rq_r(x - 5, y - 5, w + 10, h + 10);
      ui_col(ui_mix(RQL, 0xFFF4DC, 0.35)); rq_r(x, y + dn, w, h - dn);
      i = 0; loop(8, ui_cola(0xFFFFFF, 0.05); gfx_circle((x + w * 0.5) * sc, (y + dn + (h - dn) * 0.5) * sc, (w * 0.46 - i * 3) * sc, 1, 1); i += 1; );
      gfx_gradrect(x * sc, (y + dn) * sc, w * sc, (h - dn) * 0.35 * sc, 1, 1, 1, 0.25, 0, 0, 0, 0, 0, 0, 0, -0.25 / ((h - dn) * 0.35 * sc));
      ui_col(0x3A1E00);
    ) : (
      ui_col(0xC9C4B5); rq_r(x, y, w, h);
      ui_col(hov ? 0xF3F0E6 : 0xEAE6DA); rq_r(x + 1, y + 1, w - 2, h - 5);
      ui_cola(0xFFFFFF, 0.5); rq_r(x + 1, y + 1, w - 2, 1);
      ui_col(0x34322D);
    );
  ) : rq_th == 1 ? (                                    // VFD: smoked glass, turquoise glow
    on ? (
      ui_cola(RQL, 0.10); rq_r(x - 4, y - 4, w + 8, h + 8);
      ui_col(ui_mix(RQL, 0x000000, 0.72)); rq_r(x, y + dn, w, h - dn);
      i = 0; loop(8, ui_cola(RQL, 0.045); gfx_circle((x + w * 0.5) * sc, (y + dn + (h - dn) * 0.5) * sc, (w * 0.48 - i * 3) * sc, 1, 1); i += 1; );
      ui_col(RQL); gfx_rect(x * sc, (y + dn) * sc, w * sc, h * sc - dn * sc, 0);
      ui_col(ui_mix(RQL, 0xFFFFFF, 0.55));
    ) : (
      ui_col(ui_mix(RQL, RQP, 0.82)); rq_r(x, y, w, h);
      ui_col(hov ? 0x1A1E1F : 0x121516); rq_r(x + 1, y + 1, w - 2, h - 2);
      ui_cola(0xFFFFFF, 0.05); rq_r(x + 1, y + 1, w - 2, (h - 2) * 0.45);
      ui_col(ui_mix(RQL, 0x121516, 0.78));
    );
  ) : (                                                 // MATRIX: chunky block key, deep side walls
    k = on ? 2 : 5;
    ui_col(on ? ui_mix(RQL, 0x000000, 0.45) : 0x1A1C1B); rq_r(x, y, w, h);          // front wall
    on ? ( ui_cola(RQL, 0.22); rq_r(x - 5, y - 5, w + 10, h + 10); );
    ui_col(on ? RQL : (hov ? ui_mix(RQOLV, 0xFFFFFF, 0.07) : RQOLV)); rq_r(x + 2, y + 2 + dn, w - 4, h - k - 2 - dn);
    ui_cola(0xFFFFFF, on ? 0.35 : 0.1); rq_r(x + 2, y + 2 + dn, w - 4, 1);
    ui_cola(0x000000, 0.25); rq_r(x + 2, y + h - k - 1, w - 4, 1);
    ui_col(on ? 0x17191B : ui_mix(RQI, RQOLV, 0.35));
  );
  gfx_setfont(15); rq_ctxt(x + w * 0.5, y + h * 0.5 + dn * 0.5 - (rq_th == 2 ? 1.5 : 0), s);
  rq_th == 1 && on ? ( ui_cola(RQL, 0.25); gfx_setfont(15); rq_ctxt(x + w * 0.5 + 0.6, y + h * 0.5 + dn * 0.5 + 0.6, s); );
  hov ? ( ui_cola(0xFFFFFF, 0.06); rq_r(x, y, w, h); );
  hov && pressed && drag_id == 0 ? ( drag_id = -1; 1; ) : 0;
);

// ---------- knobs (81 series: flat caps, smooth anti-aliased rings; no stepped or banded shading) ----------
// the cap (pixels): kind 0 = main (ENAMEL: a flat machined-silver face on a dark skirt; VFD / MATRIX: flat dark
// bakelite with a white line), kind 1 = small (a flat coloured cap on a dark skirt)
function rq_cap(cx, cy, r, a, kind, col) local(ca, sa, k, i, pc, p0, p1) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, rq_th == 0 ? 0.28 : 0.5); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(kind == 0 && rq_th == 0 ? 0x2A2B2E : 0x141416); gfx_circle(cx, cy, r, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx, cy, r, 0, 1);
  k = r * (kind == 0 ? 0.78 : 0.74);
  pc = kind == 1 ? col : rq_th == 0 ? 0xC4C8CD : 0x2B2825;
  ui_col(pc); gfx_circle(cx, cy, k, 1, 1);
  ui_col(ui_mix(pc, 0x000000, 0.35)); gfx_circle(cx, cy, k, 0, 1);
  pc = (kind == 0 && rq_th == 0) || (kind == 1 && (col & 255) + ((col >> 8) & 255) + ((col >> 16) & 255) > 380) ? 0x141416 : 0xF2EEE4;
  p0 = k * 0.2; p1 = kind == 0 && rq_th == 0 ? k * 0.94 : r * 0.94;
  ui_col(pc); i = -1;
  ui_ssline(cx + ca * p0, cy + sa * p0, cx + ca * p1, cy + sa * p1, 2.6 * sc, 1);
);
// the house laboratory knob (as Platte81 EAST / Drive81 BERLIN): a thin smooth track, an anti-aliased value arc,
// a flat satin cap with one soft highlight on its upper-left edge, a thin dark rim and a dark pointer (pixels)
function rq_arcw(cx, cy, r, a1, a2, w) local(k) (       // a smooth thick arc: anti-aliased arcs every half pixel
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function rq_lcap(cx, cy, r, n, col) local(rr, a, a0, ca, sa, w, i) (
  rr = r + 6 * sc; w = 3 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(rq_th == 0 ? ui_mix(RQF, 0x000000, 0.30) : ui_mix(RQF, 0xFFFFFF, 0.16)); rq_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.3 * sc);
  n > 0.004 ? (
    ui_col(col); rq_arcw(cx, cy, rr, a0, a, w);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); gfx_circle(cx + ca * rr, cy + sa * rr, w * 0.5, 1, 1);
  );
  ui_cola(0x000000, 0.25); gfx_circle(cx + 1 * sc, cy + 2 * sc, r, 1, 1);
  ui_col(0x50565E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0xB3B9C0); gfx_circle(cx, cy, r - 1.5 * sc, 1, 1);
  ui_col(0xD9DDE1); rq_arcw(cx, cy, r - 3 * sc, -0.66 * $pi, 0.06 * $pi, 1.4 * sc);
  ui_col(0x1A1E24); i = -1;
  ui_ssline(cx + ca * r * 0.3, cy + sa * r * 0.3, cx + ca * (r - 3 * sc), cy + sa * (r - 3 * sc), 2.4 * sc, 1);
);
// a knob: drag (shift = fine), double-click = default, wheel. Main knobs (kind 0) are the laboratory knob above,
// small ones (kind 1) a flat coloured cap with a printed tick ring. Its name below, replaced by the value while touched; returns 1 then.
function rq_kn(cx, cy, r, idx, lo, hi, def, kind, col, name, val) local(v, n, dx, dy, hov, did, i, t, rr) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - rq_klt < 0.35 && rq_klid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; rq_klt = 0; ) : (
      drag_id = did; rq_ky = mouse_y; rq_klt = time_precise(); rq_klid = idx; rq_kv = (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    rq_kv = min(max(rq_kv + (rq_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); rq_ky = mouse_y;
    v = lo + rq_kv * (hi - lo);
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max((v - lo) / (hi - lo) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    slider(idx) = lo + n * (hi - lo); ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  kind == 0 ? rq_lcap(cx * sc, cy * sc, r * sc, n, col) : (
    ui_cola(RQI, 0.85); i = 0;
    loop(11, t = -0.75 * $pi + i / 10 * 1.5 * $pi;
      gfx_line((cx + sin(t) * (r + 4)) * sc, (cy - cos(t) * (r + 4)) * sc, (cx + sin(t) * (r + 8)) * sc, (cy - cos(t) * (r + 8)) * sc, 1); i += 1; );
    rq_cap(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi, kind, col);
  );
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  rq_ka = hov || drag_id == did;
  gfx_setfont(11); ui_col(rq_ka ? (rq_th == 0 ? 0xB24A00 : RQA) : RQI); rq_ctxt(cx, cy + r + (kind == 0 ? 20 : 15), rq_ka ? val : name);
  rq_ka;
);

// the MICROSHIFT's concentric dual knob: the inner cap is PITCH (ip: -50 ... +50 cents, bipolar, its arc in the gap
// round the cap), the outer ring DELAY (id: 0 - 50 ms, its arc outside). Drag the cap or the ring (shift = very fine),
// double-click = default, wheel. Its names below, replaced by the touched part's value; returns 1 while touched.
function rq_dk(cx, cy, ri, ro, ip, id, dp, dd) local(dx, dy, rr, hi, ho, t, v, n, a, a0, ca, sa, i, w, rg, act) (
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; rr = sqrt(dx * dx + dy * dy) / sc;
  hi = rr <= ri + 1; ho = !hi && rr <= ro + 9;
  pressed && (hi || ho) && drag_id == 0 ? (
    t = hi ? ip : id;
    time_precise() - rq_klt < 0.35 && rq_klid == t ? ( slider(t) = hi ? dp : dd; ui_auto(t); drag_id = -1; rq_klt = 0; ) : (
      drag_id = 1700 + t; rq_ky = mouse_y; rq_klt = time_precise(); rq_klid = t;
      rq_kv = hi ? (slider(ip) + 50) / 100 : slider(id) / 50;
    );
  );
  drag_id == 1700 + ip || drag_id == 1700 + id ? (
    t = drag_id - 1700;
    rq_kv = min(max(rq_kv + (rq_ky - mouse_y) / (((mouse_cap & 8) ? 2400 : 260) * sc), 0), 1); rq_ky = mouse_y;
    v = t == ip ? rq_kv * 100 - 50 : rq_kv * 50;
    slider(t) != v ? ( slider(t) = v; ui_auto(t); );
  );
  (hi || ho) && mouse_wheel != 0 && drag_id == 0 ? (
    t = hi ? ip : id;
    v = slider(t) + mouse_wheel / 120 * (hi ? ((mouse_cap & 8) ? 0.1 : 1) : ((mouse_cap & 8) ? 0.1 : 0.5));
    slider(t) = hi ? min(max(v, -50), 50) : min(max(v, 0), 50); ui_auto(t); mouse_wheel = 0;
  );
  a0 = -0.75 * $pi;
  // DELAY: the track and its arc outside the ring
  n = min(max(slider(id) / 50, 0), 1); a = a0 + n * 1.5 * $pi; rg = (ro + 6) * sc; w = 3 * sc;
  ui_col(ui_mix(RQF, 0xFFFFFF, 0.16)); rq_arcw(cx * sc, cy * sc, rg, a0, 0.75 * $pi, 1.3 * sc);
  n > 0.004 ? (
    ui_col(RQA); rq_arcw(cx * sc, cy * sc, rg, a0, a, w);
    gfx_circle(cx * sc + sin(a0) * rg, cy * sc - cos(a0) * rg, w * 0.5, 1, 1); gfx_circle(cx * sc + sin(a) * rg, cy * sc - cos(a) * rg, w * 0.5, 1, 1);
  );
  // the ring: a flat dark skirt with a light pointer line
  ui_cola(0x000000, 0.3); gfx_circle((cx + 1) * sc, (cy + 2) * sc, ro * sc, 1, 1);
  ui_col(0x0E0F10); gfx_circle(cx * sc, cy * sc, ro * sc, 1, 1);
  ui_col(rq_th == 1 ? 0x2A2F31 : 0x34383B); gfx_circle(cx * sc, cy * sc, (ro - 1.5) * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.10); rq_arcw(cx * sc, cy * sc, (ro - 2.5) * sc, -0.66 * $pi, 0.06 * $pi, 1.2 * sc);
  ca = sin(a); sa = -cos(a); ui_col(0xF2EEE4); i = -2;
  ui_ssline(cx * sc + ca * (ri + 5.5) * sc, cy * sc + sa * (ri + 5.5) * sc, cx * sc + ca * (ro - 1) * sc, cy * sc + sa * (ro - 1) * sc, 3.4 * sc, 1);
  // the gap round the cap, with PITCH's bipolar arc from the top (0 cents)
  ui_col(0x0A0B0C); gfx_circle(cx * sc, cy * sc, (ri + 5) * sc, 1, 1);
  ui_cola(RQI, 0.30); gfx_line(cx * sc, (cy - ri - 5) * sc, cx * sc, (cy - ri - 1) * sc, 1);
  n = min(max(slider(ip) / 100, -0.5), 0.5); a = n * 1.5 * $pi;
  abs(n) > 0.0005 ? ( ui_col(RQI); rq_arcw(cx * sc, cy * sc, (ri + 2.6) * sc, min(a, 0), max(a, 0), 2.6 * sc); );
  // the cap: the house satin cap and its dark pointer
  ca = sin(a); sa = -cos(a);
  ui_col(0x50565E); gfx_circle(cx * sc, cy * sc, ri * sc, 1, 1);
  ui_col(0xB3B9C0); gfx_circle(cx * sc, cy * sc, (ri - 1.5) * sc, 1, 1);
  ui_col(0xD9DDE1); rq_arcw(cx * sc, cy * sc, (ri - 3) * sc, -0.66 * $pi, 0.06 * $pi, 1.4 * sc);
  ui_col(0x1A1E24); i = -1;
  ui_ssline(cx * sc + ca * ri * 0.25 * sc, cy * sc + sa * ri * 0.25 * sc, cx * sc + ca * (ri - 3) * sc, cy * sc + sa * (ri - 3) * sc, 2.4 * sc, 1);
  // hover / touch
  act = drag_id == 1700 + ip ? 1 : drag_id == 1700 + id ? 2 : drag_id == 0 ? (hi ? 1 : ho ? 2 : 0) : 0;
  act == 1 ? ( ui_cola(0xFFFFFF, 0.08); gfx_circle(cx * sc, cy * sc, ri * sc, 1, 1); );
  act == 2 ? ( ui_cola(0xFFFFFF, 0.06); rq_arcw(cx * sc, cy * sc, (ro + ri + 5) * 0.5 * sc, -$pi, $pi, (ro - ri - 5) * sc); );
  gfx_setfont(11);
  act == 1 ? ( sprintf(#rqv, "%+.1f ct", slider(ip)); ui_col(RQA); ) :
  act == 2 ? ( sprintf(#rqv, "%.1f ms", slider(id)); ui_col(RQA); ) :
  ( strcpy(#rqv, rq_de ? "TONHÖHE / ZEIT" : "PITCH / DELAY"); ui_col(RQI); );
  rq_ctxt(cx, cy + ro + 20, #rqv);
  act > 0;
);

// =====================================================================
// Panel and header (the family layout)
// =====================================================================
ui_col(RQP); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(RQH); rq_r(0, 0, 760, 54);
ui_col(rq_th == 0 ? RQI : RQA); rq_r(0, 54, 760, 2);
ui_col(rq_th == 2 ? RQA : RQI); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(rq_th == 0 ? RQF : 0x111213); ui_text(31 * sc, 21.5 * sc, "GFX");
gfx_setfont(6); ui_col(RQI); rq_txt(58, 12, "RAUM81"); ver_tag("v3", 16, 0.05, 0);
// MODE: the two lit keys (look, labels and chorus voicing together)
rq_key(196, 16, 46, 24, "VFD", rq_th == 1) ? ( slider9 = 1; ui_auto(9); );
rq_key(246, 16, 62, 24, "MATRIX", rq_th == 2) ? ( slider9 = 2; ui_auto(9); );
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(320 * sc, 10 * sc, 346 * sc, 34 * sc, pr_cur,
  "Init|Vocal Air|Keys Wide|Bass Safe|Guitar Double|1+4 Deep|Strings Bloom|Pad Halo|Backing Vocals|Drum Room|Mono Check|Vocal Doubler|Wide Guitar|Subtle Thickener|Quarter-Tone Detune|Doubled Ensemble|Slap Double");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 17 ? 1 : k_; );
ui_size_picker(694 * sc, 18 * sc);

dy_ink = RQI; dy_bg = RQF; dy_ntick = 11;

// =====================================================================
// INPUT section: INPUT trim (overload LED), DRIFT, MONO / STEREO
// =====================================================================
rq_sect(10, 64, 142, 144, RQF, rq_de ? "EINGANG" : "INPUT");
sprintf(#rqv, "%+.1f dB", slider2); rq_kn(46, 114, 17, 2, -24, 12, 0, 1, 0x9DA2A8, rq_de ? "EINGANG" : "INPUT", #rqv);
rq_ipk_ = rz_ipk; rz_ipk = 0;
rq_ipk_ > 0.7079 ? rq_ovt = time_precise();
rq_led(71, 89, time_precise() - rq_ovt < 0.3, RQRED);
sprintf(#rqv, "%.0f%%", slider6); rq_kn(116, 114, 14, 6, 0, 100, 50, 1, rq_th == 0 ? 0x6F8794 : RQI2, "DRIFT", #rqv);
rq_lbl(20, 171, rq_de ? "EFFEKTEINGANG" : "WET IN");
rq_key(20, 184, 60, 18, "MONO", slider5 < 0.5) ? ( slider5 = 0; ui_auto(5); );
rq_key(84, 184, 60, 18, "STEREO", slider5 >= 0.5) ? ( slider5 = 1; ui_auto(5); );

// =====================================================================
// MODE section: the four buttons, COMBI / OFF and the readout
// =====================================================================
rq_sect(160, 64, 314, 144, RQS, rq_de ? "MODUS" : "MODE");
gfx_setfont(11); ui_col(RQI2); rq_rtxt(464, 12 + 64 - 6 + 6, rq_de ? "1 DEZENT  >  4 STARK" : "1 SUBTLE  >  4 STRONG");
rq_bits = rz_bits(slider1);
rq_i = 0;
loop(4,
  rq_bx = 176 + rq_i * 74;
  rq_on = rq_bits & (2 ^ rq_i);
  // status block / lamp above each key
  rq_th == 2 ? ( ui_col(0x0B0C0D); rq_r(rq_bx + 19, 160, 24, 6); ui_col(rq_on ? 0x3FA45F : RQGRN); rq_r(rq_bx + 20, 161, 22, 4);
                 rq_on ? ( ui_cola(0x3FA45F, 0.3); rq_r(rq_bx + 17, 158, 28, 10); ); )
             : ( ui_col(rq_on ? RQL : ui_mix(RQL, RQS, 0.75)); rq_r(rq_bx + 20, 161, 22, 3);
                 rq_on ? ( ui_cola(RQL, 0.3); rq_r(rq_bx + 18, 159, 26, 7); ); );
  sprintf(#rqn, "%d", rq_i + 1);
  rq_big(rq_bx, 90, 62, 62, #rqn, rq_on) ? (
    rq_b = 2 ^ rq_i;
    (mouse_cap & 8) || (mouse_cap & 4) || rq_combi ? (
      rq_bits & rq_b ? ( rq_bits -= rq_b; ) :                           // take this one out
      rq_bits == 0 || rq_bits == 1 || rq_bits == 2 || rq_bits == 4 || rq_bits == 8 ? ( rq_bits |= rq_b; ) :
      ( rq_bits = rq_b | ((rq_bits & rq_last) ? rq_last : 0); );         // two in already: keep the one pressed last
    ) : (
      rq_bits = rq_bits == rq_b ? 0 : rq_b;
    );
    rq_last = rq_b;
    slider1 = rz_idx(rq_bits); ui_auto(1);
  );
  rq_i += 1;
);
rq_key(176, 172, 58, 28, rq_de ? "KOMBI" : "COMBI", rq_combi) ? rq_combi = !rq_combi;
rq_key(240, 172, 46, 28, rq_de ? "AUS" : "OFF", slider1 < 0.5) ? ( slider1 = 0; ui_auto(1); );
// the readout: mode, rate, depth and the two lines' sweep (A and B move in opposite directions)
rq_dx = 296; rq_dy = 170; rq_dw = 166; rq_dh = 32;
ui_col(rq_th == 1 ? 0x2E3235 : 0x0B0C0D); rq_r(rq_dx, rq_dy, rq_dw, rq_dh);
ui_col(RQG); rq_r(rq_dx + 1, rq_dy + 1, rq_dw - 2, rq_dh - 2);
gfx_setfont(13);
slider1 < 0.5 ? strcpy(#rqm, rq_de ? "AUS" : "OFF") : (
  rq_bits = rz_bits(slider1); strcpy(#rqm, "");
  rq_i = 0; loop(4, rq_bits & (2 ^ rq_i) ? ( strlen(#rqm) ? strcat(#rqm, "+"); sprintf(#rqn, "%d", rq_i + 1); strcat(#rqm, #rqn); ); rq_i += 1; );
);
ui_col(RQD); rq_txt(rq_dx + 7, rq_dy + 2, #rqm);
slider1 >= 0.5 ? ( sprintf(#rqv, "%.2fHz %.2fms", rz_rt, rz_dt); ui_cola(RQD, 0.85); rq_rtxt(rq_dx + rq_dw - 7, rq_dy + 10, #rqv); );
// sweep: a track with marks A (above) and B (below)
rq_tx = rq_dx + 8; rq_tw = rq_dw - 16; rq_ty = rq_dy + 24;
ui_cola(RQD, 0.35); rq_r(rq_tx, rq_ty, rq_tw, 1);
rq_i = 0; loop(9, rq_r(rq_tx + rq_i * rq_tw / 8, rq_ty - 2, 1, 5); rq_i += 1; );
rq_sw = slider1 >= 0.5 ? rz_lv * min(rz_d / 1.5, 1) : 0;
ui_col(RQD); rq_r(rq_tx + rq_tw * (0.5 + 0.5 * rq_sw) - 2, rq_ty - 5, 4, 4);
ui_cola(RQD, 0.7); rq_r(rq_tx + rq_tw * (0.5 - 0.5 * rq_sw) - 2, rq_ty + 2, 4, 4);

// =====================================================================
// SPACE section: MIX and WIDTH
// =====================================================================
rq_sect(482, 64, 130, 144, RQF, rq_de ? "RAUM" : "SPACE");
sprintf(#rqv, "%.0f%%", slider3); rq_kn(516, 112, 20, 3, 0, 100, 100, 0, RQA, rq_de ? "ANTEIL" : "MIX", #rqv);
sprintf(#rqv, "%.0f%%", slider4); rq_kn(580, 112, 20, 4, 0, 100, 100, 0, RQA, rq_de ? "BREITE" : "WIDTH", #rqv);
gfx_setfont(11); ui_col(RQI2);
rq_ctxt(547, 182, "L = D + A - kB"); rq_ctxt(547, 197, "R = D + B - kA");

// =====================================================================
// OUTPUT section: OUTPUT, SAT, MONO SUM
// =====================================================================
rq_sect(620, 64, 130, 144, RQF, rq_de ? "AUSGANG" : "OUTPUT");
sprintf(#rqv, "%+.1f dB", slider7); rq_kn(656, 108, 13, 7, -24, 12, 0, 1, 0x9DA2A8, rq_de ? "AUSGANG" : "OUTPUT", #rqv);
sprintf(#rqv, "%.0f%%", slider10); rq_kn(656, 168, 11, 10, 0, 100, 0, 1, 0xD8B040, rq_de ? "SÄTT." : "SAT", #rqv);
rq_key(688, 120, 54, 22, rq_de ? "SUMME" : "SUM", slider8 >= 0.5) ? ( slider8 = slider8 >= 0.5 ? 0 : 1; ui_auto(8); );
gfx_setfont(11); ui_col(RQI2); rq_ctxt(715, 154, "MONO");
dy_kst = 7; dy_nov = 0;

// =====================================================================
// MICROSHIFT section: ON / ADAPT (TRACK LED), the two concentric knobs, the display, WIDE / NARROW / COLOR
// =====================================================================
rq_sect(10, 216, 740, 158, RQS, rq_de ? "MIKROVERSTIMMUNG" : "MICROSHIFT");
gfx_setfont(11); ui_col(RQI2); rq_rtxt(740, 228, rq_de ? "VOR DEM CHORUS  -  ANTEIL REGELT BEIDE" : "BEFORE THE CHORUS  -  MIX SETS BOTH");
rq_key(20, 246, 84, 26, rq_de ? "EIN" : "ON", slider17 >= 0.5) ? ( slider17 = slider17 >= 0.5 ? 0 : 1; ui_auto(17); );
rq_key(20, 282, 84, 26, rq_de ? "ADAPTIV" : "ADAPT", slider22 >= 0.5) ? ( slider22 = slider22 >= 0.5 ? 0 : 1; ui_auto(22); );
rq_lk = slider17 >= 0.5 && slider22 >= 0.5 && ms_lock > 0.5;
rq_led(32, 330, rq_lk, rq_th == 2 ? 0x3FA45F : RQI);
rq_lbl(44, 324, rq_de ? "SPUR" : "TRACK");
gfx_setfont(12); ui_col(RQI);
rq_ctxt(175, 248, rq_de ? "LINKS" : "LEFT"); rq_ctxt(585, 248, rq_de ? "RECHTS" : "RIGHT");
rq_dk(175, 304, 18, 33, 18, 19, 8, 11);
rq_dk(585, 304, 18, 33, 20, 21, -8, 17);
rq_key(650, 246, 90, 26, rq_de ? "BREIT" : "WIDE", slider24 >= 0.5 && slider24 < 1.5) ? ( slider24 = slider24 >= 0.5 && slider24 < 1.5 ? 0 : 1; ui_auto(24); );
rq_key(650, 282, 90, 26, rq_de ? "SCHMAL" : "NARROW", slider24 >= 1.5) ? ( slider24 = slider24 >= 1.5 ? 0 : 2; ui_auto(24); );
rq_key(650, 318, 90, 26, rq_de ? "FARBE" : "COLOR", slider23 >= 0.5) ? ( slider23 = slider23 >= 0.5 ? 0 : 1; ui_auto(23); );
// the display: both sides' PITCH / DELAY, the tracker and the output's phase correlation
rq_dx = 236; rq_dy = 242; rq_dw = 288; rq_dh = 116;
ui_col(rq_th == 1 ? 0x2E3235 : 0x0B0C0D); rq_r(rq_dx, rq_dy, rq_dw, rq_dh);
ui_col(RQG); rq_r(rq_dx + 1, rq_dy + 1, rq_dw - 2, rq_dh - 2);
rq_on = slider17 >= 0.5;
gfx_setfont(13);
rq_i = 0;
loop(2,
  sprintf(#rqv, "%s %+5.1f ct  %4.1f ms", rq_i ? "R" : "L", slider(18 + 2 * rq_i), slider(19 + 2 * rq_i));
  rq_on ? ui_col(RQD) : ui_cola(RQD, 0.4); rq_txt(rq_dx + 10, rq_dy + 8 + rq_i * 22, #rqv);
  // a small bipolar pitch bar per side
  rq_bx = rq_dx + rq_dw - 52; rq_by = rq_dy + 16 + rq_i * 22;
  ui_cola(RQD, 0.35); rq_r(rq_bx, rq_by, 42, 1); rq_r(rq_bx + 21, rq_by - 4, 1, 9);
  rq_v = min(max(slider(18 + 2 * rq_i) / 50, -1), 1) * 20;
  rq_on ? ui_col(RQD) : ui_cola(RQD, 0.4); rq_r(rq_bx + 21 + min(rq_v, 0), rq_by - 2, max(abs(rq_v), 1), 5);
  rq_i += 1;
);
// the tracker
gfx_setfont(11);
!rq_on ? strcpy(#rqv, rq_de ? "MIKROVERSTIMMUNG AUS" : "MICROSHIFT OFF") :
slider22 < 0.5 ? strcpy(#rqv, rq_de ? "FESTES FENSTER 20 ms" : "FIXED GRAIN 20 ms") :
rq_lk ? sprintf(#rqv, rq_de ? "SPUR  %.0f Hz" : "TRACK  %.0f Hz", srate / max(ms_T, 1)) :
strcpy(#rqv, rq_de ? "SUCHT ...  FESTES FENSTER" : "SEARCHING ...  FIXED GRAIN");
ui_cola(RQD, rq_on ? 0.85 : 0.4); rq_txt(rq_dx + 10, rq_dy + 56, #rqv);
// the phase correlation: -1 ... +1 with its value
rq_c = ms_cxx > 0.0000001 && ms_cyy > 0.0000001 ? min(max(ms_cxy / sqrt(ms_cxx * ms_cyy), -1), 1) : 0;
rq_lbl(rq_dx + 10, rq_dy + 82, rq_de ? "KORR." : "CORR");
rq_tx = rq_dx + 62; rq_tw = rq_dw - 124; rq_ty = rq_dy + 92;
ui_cola(RQD, 0.35); rq_r(rq_tx, rq_ty, rq_tw, 1);
rq_i = 0; loop(9, rq_r(rq_tx + rq_i * rq_tw / 8, rq_ty - (rq_i == 4 ? 5 : 2), 1, rq_i == 4 ? 11 : 5); rq_i += 1; );
ui_col(rq_c < 0 ? RQRED : RQD);
rq_r(rq_tx + rq_tw * 0.5 + min(rq_c, 0) * rq_tw * 0.5, rq_ty - 3, max(abs(rq_c) * rq_tw * 0.5, 1), 7);
gfx_setfont(11); ui_cola(RQD, 0.7); rq_txt(rq_tx - 2, rq_ty + 7, "-1"); rq_rtxt(rq_tx + rq_tw + 4, rq_ty + 13, "+1");
gfx_setfont(13); ui_col(rq_c < 0 ? RQRED : RQD); sprintf(#rqv, "%+.2f", rq_c); rq_rtxt(rq_dx + rq_dw - 8, rq_ty, #rqv);
// =====================================================================
// bottom strip: the plate
// =====================================================================
gfx_setfont(11); ui_col(RQI2);
rq_txt(14, 394, rq_de ? "SHIFT-KLICK ODER KOMBI: ZWEI TASTEN" : "SHIFT-CLICK OR COMBI: TWO BUTTONS");
rq_rtxt(748, 400, rq_de ? "BBD STEREO-RAUMEFFEKT + MIKROVERSTIMMUNG  TYP 81" : "BBD STEREO SPACE EFFECT + MICROSHIFT  TYPE 81");
ui_col(rq_th == 0 ? ui_mix(RQI, RQP, 0.6) : ui_mix(RQI, RQP, 0.75)); rq_r(10, 382, 740, 1);

pk_end();
ui_end();
