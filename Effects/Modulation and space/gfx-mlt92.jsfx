desc:MLT92 [multi-effects] (GFX)
//tags: multi-effects quad chorus flanger delay echo reverb hall room plate gated 16-bit 20-bit home-studio series92
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel and gfx-s92 (.jsfx-inc) in the same folder.
//
// MLT92 (Series 92: high-end home recording from the 90s): the home-studio multi-effects rack - the "quad" box of the
// decade - with two models on one switch: two generations of the same box.
//   input -> TRIM / GUARD -> (ANALOG: the valve input stage) -> the dry path and the send:
//   the send -> (ANALOG: a 13 kHz anti-alias filter and the 16-bit A/D) -> a fixed chain of three blocks, each with
//   its own IN / OUT keys and LEVEL:
//     CHORUS  CHORUS or FLANGE (keys). RATE (0.05 - 5 Hz), DEPTH. The chorused signal feeds the delay.
//     DELAY   TIME (20 - 1500 ms, on the LCD), FEEDBACK (0 - 95 %): repeats of the chorused signal, a little darker
//             each time round the loop. Its echoes feed the reverb with the chorused signal.
//     REVERB  the program keys: HALL (a large, smooth hall: an 8-line modulated feedback network), ROOM (the same
//             network on short lines: a small, dense room), PLATE (a modulated figure-of-eight plate tank) and GATED
//             (a dense burst read by 64 taps per side with a hard close: SIZE becomes LENGTH, DECAY the slope).
//             SIZE scales the space (and its pre-delay), DECAY is the RT60 (0.2 - 10 s), DAMPING the HF loss.
//   -> the return (the three blocks' effect signals, each at its LEVEL) -> (ANALOG: the 16-bit D/A and a 13.5 kHz
//   reconstruction filter) -> MIX (a send law: the dry stays full up to 50 %, the return is full from 50 %; at 50 %
//   the output is the whole chain, dry plus effects; 100 % on a send) -> (ANALOG: the output transformer) -> OUTPUT
//   -> the house output stage (band SAT, CLIP always on).
//   ANALOG:  the early-90s 16-bit box through warm analogue I/O: a valve input stage (gentle, lopsided: even
//            harmonics) and an output transformer (the lows thicken a little); the effects run band-limited to about
//            13 kHz with a gentle 16-bit grain (the tanks and the delay loop re-quantised every pass, 12 dB of
//            headroom); lusher modulation: a two-voice sine chorus, deeper, a richer flange, the reverb lines swim
//            more; the delay's repeats darken faster; a sparser, grainier reverb build-up.
//   DIGITAL: the late-90s 20-bit studio box: full bandwidth, clean I/O, denser reverbs (twice the diffusion and
//            more in-loop all-pass density), a one-voice triangle chorus, steadier modulation, a 20-bit dithered
//            return.
// The reverb return is level matched across the programs, SIZE and DECAY, the chorus across CHORUS and FLANGE, and
// the two models are matched to each other at the defaults.
// DRIFT (0-100 %, 50 % = the standard amount): ANALOG - the warm-up and mains wander of the analogue circuit: the
// valve's bias and the I/O gain drift slowly (the channels never quite match), the chorus LFO and the reverb lines
// wander; DIGITAL - the clocks are steady: only a trace of decay wander.
// Changing the model fades the whole sound out and back in; changing the reverb program or the chorus type fades
// that block out, clears it and fades it back in; the IN / OUT keys glide; a new delay TIME crossfades to the new tap.
// No latency.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s92.jsfx-inc

slider1:0<-24,12,0.1>-Input trim (dB)
slider2:1<0,1,1{Off,On}>-Input guard
slider3:1<0,1,1{Out,In}>-Chorus in
slider4:0<0,1,1{Chorus,Flange}>-Chorus type
slider5:0.7<0.05,5,0.01>-Chorus rate (Hz)
slider6:45<0,100,1>-Chorus depth (%)
slider7:50<0,100,1>-Chorus level (%)
slider8:1<0,1,1{Out,In}>-Delay in
slider9:360<20,1500,1>-Delay time (ms)
slider10:30<0,95,1>-Delay feedback (%)
slider11:25<0,100,1>-Delay level (%)
slider12:1<0,1,1{Out,In}>-Reverb in
slider13:0<0,3,1{Hall,Room,Plate,Gated}>-Reverb program
slider14:50<0,100,1>-Reverb size (%)
slider15:2<0.2,10,0.01>-Reverb decay (s)
slider16:40<0,100,1>-Reverb damping (%)
slider17:35<0,100,1>-Reverb level (%)
slider18:50<0,100,1>-Mix (%)
slider19:0<-24,12,0.1>-Output (dB)
slider20:0<0,1,1{Analog,Digital}>-Model
slider21:50<0,100,1>-Drift (%)
slider22:0<0,100,1>-Band sat (%)
slider23:30<0,100,1>-Bias (output stage, %)
slider24:120<40,400,1>-Sat low band (Hz)
slider25:6000<2000,16000,10>-Sat high band (Hz)
slider26:-0.3<-24,0,0.1>-Ceiling (dB)
slider27:1<0,1,1{Off,Clip}>-(unused, output stage)
slider28:prs_sel=0<0,12,1{No preset,Init,Vocal Hall,Chorus Gtr,Slap Room,Jet Flange,Snare Plate,Gated Drums,Ambient Pad,Dotted Echo,Ballad Plate,Drum Room,Gated Snare}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-mlt92";
ext_noinit = 1;

// ---------- memory (sized for 192 kHz; every read is clamped to its line) ----------
s92_mem = 0;
p9_ostm = s92_alloc(4096);
p9_DSZ = 524288; p9_DMK = p9_DSZ - 1; p9_DLB = s92_alloc(2 * p9_DSZ);     // the delay (L, R): 1.5 s at 192 kHz
p9_CSZ = 8192; p9_CMK = p9_CSZ - 1; p9_CB = s92_alloc(2 * p9_CSZ);        // the chorus / flanger lines (L, R)
p9_PSZ = 32768; p9_PMK = p9_PSZ - 1; p9_PB = s92_alloc(2 * p9_PSZ);      // the reverb's pre-delay (L, R)
p9_TK0 = s92_mem;                                       // everything that rings in the reverb (cleared on a change)
p9_TSZ = 131072; p9_TM = p9_TSZ - 1; p9_TB = s92_alloc(2 * p9_TSZ);      // the GATED tap line
p9_BSZ = 32768; p9_BM = p9_BSZ - 1; p9_LB = s92_alloc(8 * p9_BSZ);       // the 8 HALL / ROOM lines
p9_ASZ = 4096; p9_AM = p9_ASZ - 1; p9_AB = s92_alloc(8 * p9_ASZ);        // the all-pass in each line
p9_DB = s92_alloc(8 * p9_ASZ);                          // the input diffusers (4 per side)
// the plate (Dattorro's lengths at 29761 Hz, scaled to the rate and SIZE)
p9_FAC = 192000 / 29761 * 1.65;
p9i1.s92_dlinit(ceil(142 * p9_FAC) + 64); p9i2.s92_dlinit(ceil(107 * p9_FAC) + 64);
p9i3.s92_dlinit(ceil(379 * p9_FAC) + 64); p9i4.s92_dlinit(ceil(277 * p9_FAC) + 64);
p9tA1.s92_dlinit(ceil(700 * p9_FAC) + 64); p9tD1.s92_dlinit(ceil(4453 * p9_FAC) + 64);
p9tA2.s92_dlinit(ceil(1800 * p9_FAC) + 64); p9tD2.s92_dlinit(ceil(3720 * p9_FAC) + 64);
p9tA3.s92_dlinit(ceil(936 * p9_FAC) + 64); p9tD3.s92_dlinit(ceil(4217 * p9_FAC) + 64);
p9tA4.s92_dlinit(ceil(2656 * p9_FAC) + 64); p9tD4.s92_dlinit(ceil(3163 * p9_FAC) + 64);
p9_LPS = s92_alloc(8); p9_O = s92_alloc(8);
p9_TK1 = s92_mem;
// tables
p9_LN = s92_alloc(16); p9_APL = s92_alloc(16); p9_DBL = s92_alloc(24);
p9_DLC = s92_alloc(8); p9_DLD = s92_alloc(8); p9_GN = s92_alloc(8); p9_DLN = s92_alloc(8); p9_APN = s92_alloc(8);
p9_DV = s92_alloc(8); p9_DR = s92_alloc(32); p9_ISG = s92_alloc(8); p9_LFP = s92_alloc(8); p9_LFR = s92_alloc(8);
p9_GJL = s92_alloc(64); p9_GJR = s92_alloc(64); p9_GTL = s92_alloc(64); p9_GTR = s92_alloc(64);
p9_GGL = s92_alloc(64); p9_GGR = s92_alloc(64);
p9_WGT = s92_alloc(8);                                   // the reverb return's level (ANALOG 0-3, DIGITAL 4-7)
p9_CN = s92_alloc(4);                                    // the chorus' level (ANALOG chorus, flange, DIGITAL ...)

function p9_hash(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453; v - floor(v); );
// the return's level across DECAY (a longer tail is louder on steady sound): measured exponents below / above 2 s
function p9_dcomp(T, lo, hi) ( (2 / T) ^ (T < 2 ? lo : hi); );
// ... and across SIZE (a bigger space is quieter): measured slopes (dB per unit of SIZE) below / above 50 %
function p9_szc(z, lo, hi) ( 10 ^ ((z < 0.5 ? lo : hi) * (z - 0.5) / 20); );
function p9_tables() local(i) (
  i = 0;
  loop(8,
    // HALL and ROOM lines (ms at SIZE 50 %), mutually prime-ish
    p9_LN[i] = i == 0 ? 31.3 : i == 1 ? 37.9 : i == 2 ? 43.1 : i == 3 ? 47.7 : i == 4 ? 53.9 : i == 5 ? 61.3 : i == 6 ? 67.1 : 73.7;
    p9_LN[8 + i] = i == 0 ? 9.1 : i == 1 ? 11.3 : i == 2 ? 13.7 : i == 3 ? 15.1 : i == 4 ? 17.9 : i == 5 ? 19.7 : i == 6 ? 22.3 : 25.1;
    // the all-pass in each line (ms)
    p9_APL[i] = i == 0 ? 3.1 : i == 1 ? 3.7 : i == 2 ? 4.3 : i == 3 ? 4.9 : i == 4 ? 2.3 : i == 5 ? 2.9 : i == 6 ? 5.3 : 5.9;
    p9_APL[8 + i] = i == 0 ? 1.3 : i == 1 ? 1.7 : i == 2 ? 1.9 : i == 3 ? 2.3 : i == 4 ? 1.1 : i == 5 ? 1.5 : i == 6 ? 2.1 : 2.5;
    // the input diffusers (ms): HALL, ROOM, GATED; 0-3 the left side, 4-7 the right
    p9_DBL[i] = i == 0 ? 1.7 : i == 1 ? 2.9 : i == 2 ? 4.3 : i == 3 ? 6.1 : i == 4 ? 1.9 : i == 5 ? 3.1 : i == 6 ? 4.7 : 6.7;
    p9_DBL[8 + i] = i == 0 ? 0.9 : i == 1 ? 1.4 : i == 2 ? 2.1 : i == 3 ? 3.1 : i == 4 ? 1.0 : i == 5 ? 1.5 : i == 6 ? 2.3 : 3.4;
    p9_DBL[16 + i] = i == 0 ? 1.8 : i == 1 ? 2.74 : i == 2 ? 4.69 : i == 3 ? 6.9 : i == 4 ? 2.06 : i == 5 ? 3.09 : i == 6 ? 5.07 : 7.47;
    p9_ISG[i] = (i == 2 || i == 3 || i == 5 || i == 6) ? -1 : 1;
    p9_LFR[i] = 0.29 + 0.093 * i; p9_LFP[i] = p9_hash(i + 41);
    i += 1;
  );
  i = 0;
  loop(64,
    p9_GJL[i] = (i + 0.5 + 0.84 * (p9_hash(i + 101) - 0.5)) / 64;
    p9_GJR[i] = (i + 0.5 + 0.84 * (p9_hash(i + 211) - 0.5)) / 64;
    i += 1;
  );
  // the reverb return per program (measured on pink noise at the defaults: wet = dry at LEVEL 100 %)
  p9_WGT[0] = 1.270; p9_WGT[1] = 0.623; p9_WGT[2] = 1.851; p9_WGT[3] = 1.093;
  p9_WGT[4] = 1.243; p9_WGT[5] = 0.635; p9_WGT[6] = 1.799; p9_WGT[7] = 1.122;
  // the chorus per model and type (measured the same way)
  p9_CN[0] = 1.006; p9_CN[1] = 0.674; p9_CN[2] = 1.022; p9_CN[3] = 0.710;
);
p9_tables();

// ---------- the stages ----------
// ANALOG: the valve input stage (lopsided, unity small-signal gain; bias b from DRIFT, set in @block)
function p9_vset(bb) instance(b, b0, n) (
  b = bb; b0 = s92_th(0.45 * b); n = 0.0002 / (s92_th(0.45 * (b + 0.0001)) - s92_th(0.45 * (b - 0.0001)));
);
function p9_vin(u) instance(b, b0, n) ( (s92_th(0.45 * (u + b)) - b0) * n; );
// ANALOG: the output transformer (the lows thicken a little)
function p9_xout(u) instance(lp) ( lp += (u - lp) * p9_kx; (u - lp) + s92_th(lp * 1.4) / 1.4; );
// ANALOG: the 16-bit word with 12 dB of headroom: rounding at the converters, magnitude truncation in the loops
function p9_qr(v) ( floor(v * 8192 + 0.5) * 0.0001220703125; );
function p9_qt(v) ( v >= 0 ? floor(v * 8192) * 0.0001220703125 : -floor(-v * 8192) * 0.0001220703125; );
// the chorus LFO: ANALOG a sine, DIGITAL a triangle (-1 .. 1)
function p9_lfo(ph) ( ph -= floor(ph); p9_mod ? (ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph) : sin(2 * $pi * ph); );
// a cubic read from a chorus line (b = its buffer), d samples back
function p9_crd(b, d) local(p, i, f, xm, x0, x1, x2, c1, c2, c3) (
  p = p9_cw - d; i = floor(p); f = p - i;
  xm = b[(i - 1) & p9_CMK]; x0 = b[i & p9_CMK]; x1 = b[(i + 1) & p9_CMK]; x2 = b[(i + 2) & p9_CMK];
  c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);
// the input diffusers (all-passes on the shared write index): n of the four on one side
function p9_diff(x, k0, n, g) local(j, b, d, y) (
  j = 0;
  loop(n,
    b = p9_DB + (k0 + j) * p9_ASZ;
    d = b[(p9_aw - p9_DLN[k0 + j]) & p9_AM];
    y = d - g * x; b[p9_aw] = x + g * y; x = y;
    j += 1;
  );
  x;
);
// a modulated all-pass (cubic read) for the plate
function p9_apm(x, d, g) instance(buf, len, w) local(v, y) ( v = this.s92_dlr3(d); y = v - g * x; this.s92_dlw(x + g * y); y; );
// the GATED envelope (f = 0 .. 1 across the window): a flat burst, DECAY's slope across it, a hard close
function p9_env(f, L, T) local(e) (
  e = min(1, f / 0.02) * 10 ^ (-3 * f * L / T);
  f > 0.975 ? e *= (1 - f) / 0.025;
  e;
);
function p9_ggain() local(i, e, sl, sr) (
  sl = 0; sr = 0;
  i = 0;
  loop(64,
    e = p9_env(p9_GJL[i], p9_glc, p9_gd); p9_GGL[i] = e * (p9_hash(i + 300) < 0.5 ? -1 : 1); sl += e * e;
    e = p9_env(p9_GJR[i], p9_glc, p9_gd); p9_GGR[i] = e * (p9_hash(i + 500) < 0.5 ? -1 : 1); sr += e * e;
    i += 1;
  );
  sl = 1 / sqrt(max(sl, 0.0001)); sr = 1 / sqrt(max(sr, 0.0001));
  i = 0; loop(64, p9_GGL[i] *= sl; p9_GGR[i] *= sr; i += 1; );
);
function p9_gpos() local(i, L) (
  L = p9_glt;
  i = 0;
  loop(64,
    p9_GTL[i] = min(max(floor(p9_GJL[i] * L + 0.5), 1), p9_TSZ - 2); p9_GTR[i] = min(max(floor(p9_GJR[i] * L + 0.5), 1), p9_TSZ - 2);
    i += 1;
  );
  p9_gset = 1;
);
// clear the reverb (the tank, its states, the pre-delay)
function p9_clear() (
  memset(p9_TK0, 0, p9_TK1 - p9_TK0);
  memset(p9_PB, 0, 2 * p9_PSZ);
  p9_pfL = p9_pfR = p9_dmA = p9_dmB = p9_bw = 0;
  p9_glc = -1; p9_dsnap = 1; p9_gls = p9_glt; p9_gset = 0;
);
// clear everything (a change of model)
function p9_allclr() (
  p9_clear();
  memset(p9_DLB, 0, 2 * p9_DSZ); memset(p9_CB, 0, 2 * p9_CSZ);
  p9_elL = p9_elR = p9_cfL = p9_cfR = 0;
  p9aL1.s92_bqclr(); p9aL2.s92_bqclr(); p9aR1.s92_bqclr(); p9aR2.s92_bqclr(); p9rL.s92_bqclr(); p9rR.s92_bqclr();
  p9vxL.lp = p9vxR.lp = 0;
  p9_dcxl = p9_dcyl = p9_dcxr = p9_dcyr = 0; p9_ocxl = p9_ocyl = p9_ocxr = p9_ocyr = 0;
);

// ---------- the reverb at control rate (every 32 samples): the glides, the lines, the loss, the taps, the level ----------
function p9_ctl() local(i, d, sz, T, k, fc, L, g, b, an) (
  p9_ts += (p9_tt - p9_ts) * p9_tk; p9_szs += (p9_szt - p9_szs) * p9_tk; p9_dps += (p9_dpt - p9_dps) * p9_tk;
  T = p9_ts * (1 + p9_ddv);
  p9_prg <= 1 ? (
    // HALL / ROOM: 8 modulated lines, an all-pass in each
    sz = (0.45 + 1.1 * p9_szs) * 0.001 * srate;
    b = p9_prg * 8;
    i = 0;
    loop(8,
      p9_LFP[i] += p9_LFR[i] * (1 + p9_lfw) * 32 / srate; p9_LFP[i] >= 1 ? p9_LFP[i] -= 1;
      d = p9_LN[b + i] * sz + p9_mdp * sin(2 * $pi * p9_LFP[i]) + p9_mdr * p9_DV[i];
      d = min(max(d, 8), p9_BSZ - 4);
      p9_dsnap ? ( p9_DLC[i] = d; p9_DLD[i] = 0; ) : p9_DLD[i] = (d - p9_DLC[i]) / 32;   // (ramped per sample)
      an = p9_APN[i] = min(max(floor(p9_APL[b + i] * 0.001 * srate), 1), p9_ASZ - 2);
      p9_GN[i] = 10 ^ (-3 * (d + an) / (T * srate));
      p9_DLN[i] = min(max(floor(p9_DBL[b + i] * (0.6 + 0.8 * p9_szs) * 0.001 * srate), 1), p9_ASZ - 2);
      i += 1;
    );
    p9_dsnap = 0;
    fc = 16000 * 0.09 ^ p9_dps; p9_kd = s92_k(fc, srate);
    p9_wgs = p9_prg == 0 ? p9_WGT[p9_mod * 4] * p9_dcomp(p9_ts, 0.73, 0.5) * p9_szc(p9_szs, 6.62, 4.76) :
                           p9_WGT[p9_mod * 4 + 1] * p9_dcomp(p9_ts, 0.57, 0.49) * p9_szc(p9_szs, 3.48, 4.9);
  ) : p9_prg == 2 ? (
    // PLATE
    k = srate / 29761 * (0.55 + 0.75 * p9_szs);
    p9_pk = k; p9_pki = srate / 29761 * (0.7 + 0.6 * p9_szs);
    g = 10 ^ (-3 * 5397 * k / (T * srate));               // four decay stages per trip round the figure of eight
    p9_pg = min(g, 0.985); p9_dd2 = min(max(p9_pg + 0.15, 0.25), 0.5);
    fc = 16000 * 0.1 ^ p9_dps; p9_pkd = s92_k(fc, srate);
    p9_kbw = s92_k(p9_mod ? 18000 : 11000, srate);
    p9_exc = (p9_mod ? 9 : 15) * srate / 29761;
    p9_lfi = 0.8 * (1 + p9_lfw) / srate;
    p9_wgs = p9_WGT[p9_mod * 4 + 2] * p9_dcomp(p9_ts, 0.13, 0.34) * p9_szc(p9_szs, 2.54, 1.2);
  ) : (
    // GATED: the window's length glides per sample (the taps slide, no steps); the gains follow it here
    L = min(0.08 * 8 ^ p9_szt * srate, p9_TSZ - 4);
    L != p9_glt ? ( p9_glt = L; p9_gset = 0; );
    p9_gls <= 0 ? p9_gls = L;
    p9_gd = p9_ts;                                     // (no drift here: the gains are only recomputed when it moves)
    (abs(p9_gls / srate - p9_glc) > 0.00002 || abs(p9_gd - p9_gdc) > 0.0005) ? ( p9_glc = p9_gls / srate; p9_gdc = p9_gd; p9_ggain(); );
    !p9_gset && abs(p9_gls - p9_glt) < 0.5 ? p9_gpos();
    i = 0; loop(8, p9_DLN[i] = min(max(floor(p9_DBL[16 + i] * 0.001 * srate), 1), p9_ASZ - 2); i += 1; );
    fc = 16000 * 0.09 ^ p9_dps; p9_kd = s92_k(fc, srate);
    p9_wgs = p9_WGT[p9_mod * 4 + 3];
  );
  // the program's pre-delay (scaled by SIZE)
  p9_pret = (p9_prg == 0 ? 22 : p9_prg == 1 ? 5 : p9_prg == 2 ? 9 : 1) * (0.5 + p9_szs) * 0.001 * srate;
);

// ---------- settings ----------
function p9_update() (
  in_setup(slider1, slider2 >= 0.5);
  p9_tcon = slider3 >= 0.5; p9_tcty = slider4 >= 0.5;
  p9_tcr = min(max(slider5, 0.05), 5); p9_tcd = min(max(slider6, 0), 100) / 100;
  p9_tlc = p9_tcon * min(max(slider7, 0), 100) / 100;
  p9_tdon = slider8 >= 0.5;
  p9_tdt = floor(min(max(slider9, 20), 1500) * 0.001 * srate + 0.5);
  p9_tfb = min(max(slider10, 0), 95) / 100;
  p9_tld = p9_tdon * min(max(slider11, 0), 100) / 100;
  p9_tron = slider12 >= 0.5;
  p9_tprg = min(max(floor(slider13 + 0.5), 0), 3);
  p9_szt = min(max(slider14, 0), 100) / 100;
  p9_tt = min(max(slider15, 0.2), 10);
  p9_dpt = min(max(slider16, 0), 100) / 100;
  p9_tlr = p9_tron * min(max(slider17, 0), 100) / 100;
  p9_tmix = slider18 / 100; p9_tog = 10 ^ (slider19 / 20);
  p9_tmo = slider20 >= 0.5;
  drift_macro(slider21);
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, slider26, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
);
// the per-model constants (set at the silent point of a model change)
function p9_modset() (
  p9_mdp = (p9_mod ? 0.00012 : 0.00032) * srate;         // the reverb lines' modulation (samples)
  p9_ndf = p9_mod ? 4 : 2; p9_dfg = p9_mod ? 0.7 : 0.6;  // the diffusion: DIGITAL denser
  p9_apg = p9_mod ? 0.6 : 0.42;                          // the in-loop all-pass
  p9_kdl = s92_k(p9_mod ? 12000 : 6500, srate);          // the delay loop's top
);
function p9_srinit() (
  p9_sr = srate;
  p9_tk = 1 - exp(-32 / (0.12 * srate));                // the size / decay / damp glide
  p9_gk = 1 - exp(-1 / (0.12 * srate));                 // the gate window's glide (per sample)
  p9_sm = 1 - exp(-1 / (0.02 * srate));
  p9_fd = 1 / (0.01 * srate);
  p9_xk = 1 / (0.03 * srate);                           // the delay's tap crossfade
  p9_kx = s92_k(110, srate);
  p9aL1.s92_bqset(0, 13000, 0, 0.5412, srate); p9aL2.s92_bqset(0, 13000, 0, 1.3066, srate);   // ANALOG: 4-pole anti-alias
  p9aR1.s92_bqset(0, 13000, 0, 0.5412, srate); p9aR2.s92_bqset(0, 13000, 0, 1.3066, srate);
  p9rL.s92_bqset(0, 13500, 0, 0.7071, srate); p9rR.s92_bqset(0, 13500, 0, 0.7071, srate);     // ANALOG: reconstruction
  p9_dcc = 1 - 2 * $pi * 4 / srate;
  p9_modset();
  ost_init(p9_ostm);
);

p9_TRA = 1.057; p9_TRD = 1;                                    // the models' overall trims
in_init();
p9_update();
p9_mod = p9_tmo; p9_prg = p9_tprg; p9_cty = p9_tcty;
p9_srinit();
p9_dfD.drift_init(0.8 + rand(0.4)); p9_dfC.drift_init(0.8 + rand(0.4)); p9_dfB.drift_init(0.8 + rand(0.4));
p9_dbL.drift_init(0.8 + rand(0.4)); p9_dbR.drift_init(0.8 + rand(0.4)); p9_dgL.drift_init(0.8 + rand(0.4)); p9_dgR.drift_init(0.8 + rand(0.4));
p9_sbL = rand(2) - 1; p9_sbR = rand(2) - 1; p9_sgL = rand(2) - 1; p9_sgR = rand(2) - 1;
i_ = 0; loop(8, p9_DR[i_ * 4] = rand(2) - 1; p9_DR[i_ * 4 + 1] = rand(2) - 1; p9_DR[i_ * 4 + 2] = rand(1); p9_DR[i_ * 4 + 3] = 0.7 + rand(0.6); i_ += 1; );
p9vL.p9_vset(0.12); p9vR.p9_vset(0.12); p9_gvL = p9_gvR = 1;
p9L.ost_ch_init(); p9R.ost_ch_init();
p9_allclr();
p9_ts = p9_tt; p9_szs = p9_szt; p9_dps = p9_dpt; p9_ddv = 0; p9_lfw = 0; p9_mdr = 0; p9_cdr = 1;
p9_ctl(); p9_cc = 0; p9_pre = p9_pret;
p9_wg = p9_wgs; p9_mix = p9_tmix; p9_og = p9_tog;
p9_lc = p9_tlc; p9_ld = p9_tld; p9_lr = p9_tlr; p9_cr = p9_tcr; p9_cd = p9_tcd; p9_fb = p9_tfb;
p9_dha = p9_dhb = p9_tdt; p9_xf = 0; p9_xs = 0;
p9_fade = 1; p9_fst = 0; p9_ssf = 1; p9_chold = 0; p9_rfade = 1; p9_rsf = 1; p9_rst = 0; p9_cfade = 1; p9_cst = 0; p9_ridle = 0; p9_rdirty = 0;
p9_hold = 0; p9_pw = 0; p9_tw = 0; p9_aw = 0; p9_w = 0; p9_dw = 0; p9_cw = 0; p9_cph = 0; p9_ph = 0; p9_dn = 0.000000000000000001;

// ---------- presets ----------
function p9_fx(con, cty, crt, cdp, clv, don, dtm, dfb, dlv) (
  slider3 = con; slider4 = cty; slider5 = crt; slider6 = cdp; slider7 = clv; slider8 = don; slider9 = dtm; slider10 = dfb; slider11 = dlv;
);
function p9_rv(ron, prg, sz, dc, dp, rlv, mx, ou, mo) (
  slider12 = ron; slider13 = prg; slider14 = sz; slider15 = dc; slider16 = dp; slider17 = rlv; slider18 = mx; slider19 = ou; slider20 = mo;
  slider_automate(1048572);                             // sliders 3-20 (TRIM, GUARD, DRIFT and the output stage stay)
);
#p9_pm = "Init|Vocal Hall|Chorus Gtr|Slap Room|Jet Flange|Snare Plate|Gated Drums|Ambient Pad|Dotted Echo|Ballad Plate|Drum Room|Gated Snare";
#p9_pl = "INIT|VOCAL HALL|CHORUS GTR|SLAP ROOM|JET FLANGE|SNARE PLATE|GATED DRUMS|AMBIENT PAD|DOTTED ECHO|BALLAD PLATE|DRUM ROOM|GATED SNARE";
function load_preset(p) (
  //                     on ty  rate dep  lvl  on time  fb  lvl          on pg  sz   dc  dp  lvl  mx    ou mo
  p == 1  ? ( p9_fx(1, 0, 0.7,  45,  50, 1,  360, 30, 25); p9_rv(1, 0, 50, 2.0, 40, 35, 50,    0, 0); ) :   // Init
  p == 2  ? ( p9_fx(0, 0, 0.7,  45,  50, 1,  280, 15, 12); p9_rv(1, 0, 62, 2.4, 45, 40, 50,  1.3, 0); ) :   // Vocal Hall
  p == 3  ? ( p9_fx(1, 0, 0.9,  60,  80, 1,  420, 25, 20); p9_rv(1, 1, 45, 1.2, 40, 28, 50, -1.4, 0); ) :   // Chorus Gtr
  p == 4  ? ( p9_fx(0, 0, 0.7,  45,  50, 1,  110, 10, 35); p9_rv(1, 1, 35, 0.8, 50, 25, 50,  1.7, 0); ) :   // Slap Room
  p == 5  ? ( p9_fx(1, 1, 0.25, 85, 100, 0,  360, 30, 25); p9_rv(1, 1, 40, 1.0, 40, 15, 50, -2.0, 0); ) :   // Jet Flange
  p == 6  ? ( p9_fx(0, 0, 0.7,  45,  50, 0,  360, 30, 25); p9_rv(1, 2, 40, 1.4, 30, 45, 50,  1.2, 0); ) :   // Snare Plate
  p == 7  ? ( p9_fx(0, 0, 0.7,  45,  50, 0,  360, 30, 25); p9_rv(1, 3, 45, 2.0, 40, 50, 50,  0.9, 0); ) :   // Gated Drums
  p == 8  ? ( p9_fx(1, 0, 0.4,  70,  60, 1,  620, 55, 30); p9_rv(1, 0, 90, 6.0, 35, 55, 55, -1.9, 1); ) :   // Ambient Pad
  p == 9  ? ( p9_fx(0, 0, 0.7,  45,  50, 1,  375, 40, 40); p9_rv(1, 0, 50, 1.8, 40, 25, 50,  1.3, 1); ) :   // Dotted Echo
  p == 10 ? ( p9_fx(1, 0, 0.5,  35,  30, 1,  500, 20, 15); p9_rv(1, 2, 70, 3.0, 40, 45, 50,  0.8, 1); ) :   // Ballad Plate
  p == 11 ? ( p9_fx(0, 0, 0.7,  45,  50, 0,  360, 30, 25); p9_rv(1, 1, 30, 0.7, 35, 40, 50,  1.5, 1); ) :   // Drum Room
  p == 12 ? ( p9_fx(0, 0, 0.7,  45,  50, 0,  360, 30, 25); p9_rv(1, 3, 60, 1.0, 30, 60, 50,  1.0, 1); ) :   // Gated Snare
  p == 13 ? (                                                                                             // Reset all to defaults
    p9_fx(1, 0, 0.7, 45, 50, 1, 360, 30, 25); p9_rv(1, 0, 50, 2.0, 40, 35, 50, 0, 0);
    slider1 = 0; slider2 = 1; slider21 = 50; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000; slider26 = -0.3; slider27 = 1;
    slider_automate(134217727);
  );
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
p9_update();

@block
prs_chk();
srate != p9_sr ? ( p9_srinit(); p9_allclr(); p9_ctl(); p9_cc = 0; p9_pre = p9_pret; p9_dha = p9_dhb = p9_tdt; p9_xs = 0; p9_xf = 0; );
p9_update();                                            // knobs moved on the panel do not run @slider
// DRIFT: ANALOG - the valve's bias and the I/O gain wander, the chorus LFO and the reverb lines swim; DIGITAL - a trace
p9_di = 0.15 * dm_s * samplesblock / srate;
p9_an_ = p9_mod ? 0 : 1;
p9vL.p9_vset(0.12 + p9_an_ * dm_a * (0.03 * p9_dbL.drift_tick(p9_di) + 0.01 * p9_sbL));
p9vR.p9_vset(0.12 + p9_an_ * dm_a * (0.03 * p9_dbR.drift_tick(p9_di) + 0.01 * p9_sbR));
p9_gvL = 1 + p9_an_ * dm_a * (0.015 * p9_dgL.drift_tick(p9_di) + 0.005 * p9_sgL);
p9_gvR = 1 + p9_an_ * dm_a * (0.015 * p9_dgR.drift_tick(p9_di) + 0.005 * p9_sgR);
p9_cdr = 1 + p9_an_ * 0.04 * dm_a * p9_dfC.drift_tick(p9_di);
p9_ddv = (p9_mod ? 0.002 : 0.006) * dm_a * p9_dfD.drift_tick(p9_di);
p9_lfw = p9_an_ * 0.05 * dm_a * p9_dfB.drift_tick(p9_di);
p9_mdr = p9_an_ * 0.0002 * srate * dm_a;
i_ = 0;
loop(8,
  p9_p_ = p9_DR + i_ * 4; p9_p_[2] += p9_di * p9_p_[3];
  p9_p_[2] >= 1 ? ( p9_p_[2] -= 1; p9_p_[0] = p9_p_[1]; p9_p_[1] = rand(2) - 1; );
  p9_DV[i_] = p9_p_[0] + (p9_p_[1] - p9_p_[0]) * (0.5 - 0.5 * cos($pi * p9_p_[2]));
  i_ += 1;
);
p9a_vi = max(p9a_vi, p9_viL); p9a_vo = max(p9a_vo, p9_vL);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- glides ----------
p9_mix += (p9_tmix - p9_mix) * p9_sm; p9_og += (p9_tog - p9_og) * p9_sm; p9_wg += (p9_wgs - p9_wg) * p9_sm;
p9_lc += (p9_tlc - p9_lc) * p9_sm; p9_ld += (p9_tld - p9_ld) * p9_sm; p9_lr += (p9_tlr - p9_lr) * p9_sm;
p9_cr += (p9_tcr - p9_cr) * p9_sm; p9_cd += (p9_tcd - p9_cd) * p9_sm; p9_fb += (p9_tfb - p9_fb) * p9_sm;
p9_pre += (p9_pret - p9_pre) * 0.0004;

// a change of model: fade everything out, swap and clear at the silent point, wait, fade in
p9_tmo != p9_mod && p9_fst == 0 ? p9_fst = 1;
p9_fst == 1 ? ( p9_fade -= p9_fd; p9_fade <= 0 ? (
  p9_fade = 0; p9_mod = p9_tmo; p9_modset();
  p9_prg = p9_tprg; p9_rst = 0; p9_rfade = 1; p9_cty = p9_tcty; p9_cst = 0; p9_cfade = 1;
  p9_allclr(); p9_ctl(); p9_gls = p9_glt; p9_ctl(); p9_cc = 32; p9_wg = p9_wgs; p9_pre = p9_pret; p9_rsf = 0;
  p9_hold = 64; p9_fst = 2; ); ) :
p9_fst == 2 ? ( p9_hold -= 1; p9_hold <= 0 ? p9_fst = 3; ) :
p9_fst == 3 ? ( p9_fade += p9_fd; p9_fade >= 1 ? ( p9_fade = 1; p9_fst = 0; ); );
// a change of reverb program: fade the reverb out, swap and clear the tank, wait, fade in
p9_tprg != p9_prg && p9_rst == 0 && p9_fst == 0 ? p9_rst = 1;
p9_rst == 1 ? ( p9_rfade -= p9_fd; p9_rfade <= 0 ? (
  p9_rfade = 0; p9_prg = p9_tprg; p9_clear(); p9_ctl(); p9_gls = p9_glt; p9_ctl(); p9_cc = 32; p9_wg = p9_wgs; p9_pre = p9_pret;
  p9_rhold = 64; p9_rst = 2; ); ) :
p9_rst == 2 ? ( p9_rhold -= 1; p9_rhold <= 0 ? p9_rst = 3; ) :
p9_rst == 3 ? ( p9_rfade += p9_fd; p9_rfade >= 1 ? ( p9_rfade = 1; p9_rst = 0; ); );
// a change of chorus type: fade the block out, swap, wait while the line refreshes, fade in
p9_tcty != p9_cty && p9_cst == 0 && p9_fst == 0 ? p9_cst = 1;
p9_cst == 1 ? ( p9_cfade -= p9_fd; p9_cfade <= 0 ? (
  p9_cfade = 0; p9_cty = p9_tcty; p9_chold = floor(0.02 * srate); p9_cst = 2; ); ) :
p9_cst == 2 ? ( p9_chold -= 1; p9_chold <= 0 ? p9_cst = 3; ) :
p9_cst == 3 ? ( p9_cfade += p9_fd; p9_cfade >= 1 ? ( p9_cfade = 1; p9_cst = 0; ); );
// the reverb rests (and is cleared) while it is OUT and silent
p9_tlr <= 0 && p9_lr < 0.00001 ? ( p9_ridle = 1; p9_rdirty = 1; ) : (
  p9_ridle = 0;
  p9_rdirty ? ( p9_clear(); p9_ctl(); p9_gls = p9_glt; p9_ctl(); p9_cc = 32; p9_wg = p9_wgs; p9_pre = p9_pret; p9_rsf = 0; p9_rdirty = 0; );
);
!p9_ridle ? ( (p9_cc -= 1) <= 0 ? ( p9_cc = 32; p9_ctl(); ); );
p9_dn = -p9_dn;

// ---------- input: TRIM, GUARD; ANALOG: the valve input stage, the anti-alias filter, the 16-bit A/D ----------
in_process(spl0, spl1);
p9_xl = in_l; p9_xr = in_r;
p9_viL = max(p9_viL * 0.9995, abs(p9_xl) + abs(p9_xr));
!p9_mod ? (
  p9_xl = p9vL.p9_vin(p9_xl * p9_gvL); p9_xr = p9vR.p9_vin(p9_xr * p9_gvR);
  p9_sl = p9_qr(p9aL2.s92_bq(p9aL1.s92_bq(p9_xl))); p9_sr_ = p9_qr(p9aR2.s92_bq(p9aR1.s92_bq(p9_xr)));
) : ( p9_sl = p9_xl; p9_sr_ = p9_xr; );
// the send into the effects fades with a change of model, and comes back in more slowly: the cleared lines refill
// from a ramp
p9_fst == 1 || p9_fst == 2 ? p9_ssf = min(p9_ssf, p9_fade) : p9_ssf = min(p9_ssf + p9_fd * 0.35, 1);
p9_sl *= p9_ssf; p9_sr_ *= p9_ssf;

// ---------- CHORUS: CHORUS (ANALOG two sine voices, DIGITAL one triangle) or FLANGE ----------
p9_cph += p9_cr * p9_cdr / srate; p9_cph >= 1 ? p9_cph -= 1;
p9_CBR = p9_CB + p9_CSZ;
p9_cl = p9_cr_ = 0;
p9_tlc <= 0 && p9_lc < 0.00001 ? (
  // the block rests while it is OUT and silent: its line keeps running
  p9_CB[p9_cw] = p9_sl; p9_CBR[p9_cw] = p9_sr_;
) : !p9_cty ? (
  p9_cbs = 0.0075 * srate; p9_cdep = p9_cd * (p9_mod ? 0.0042 : 0.0052) * srate;
  p9_CB[p9_cw] = p9_sl; p9_CBR[p9_cw] = p9_sr_;
  p9_l0 = p9_lfo(p9_cph); p9_l1 = p9_lfo(p9_cph + 0.25);   // (the voices at +0.5 and +0.75 are these inverted)
  p9_cl = p9_crd(p9_CB, p9_cbs + p9_cdep * p9_l0);
  p9_cr_ = p9_crd(p9_CBR, p9_cbs + p9_cdep * p9_l1);
  !p9_mod ? (
    p9_cl = (p9_cl + p9_crd(p9_CB, p9_cbs * 1.37 - p9_cdep * p9_l0)) * 0.7071;
    p9_cr_ = (p9_cr_ + p9_crd(p9_CBR, p9_cbs * 1.37 - p9_cdep * p9_l1)) * 0.7071;
  );
  p9_cnv = p9_CN[p9_mod * 2];
) : (
  p9_cbs = 0.0004 * srate; p9_cdep = p9_cd * 0.0045 * srate;
  p9_cl = p9_crd(p9_CB, p9_cbs + p9_cdep * (0.5 + 0.5 * p9_lfo(p9_cph)));
  p9_cr_ = p9_crd(p9_CBR, p9_cbs + p9_cdep * (0.5 + 0.5 * p9_lfo(p9_cph + 0.25)));
  p9_cfb = p9_mod ? 0.5 : 0.62;
  p9_CB[p9_cw] = p9_sl + p9_cfb * s92_th(p9_cl); p9_CBR[p9_cw] = p9_sr_ + p9_cfb * s92_th(p9_cr_);
  !p9_mod ? ( p9_CB[p9_cw] = p9_qt(p9_CB[p9_cw]); p9_CBR[p9_cw] = p9_qt(p9_CBR[p9_cw]); );
  p9_cnv = p9_CN[p9_mod * 2 + 1];
);
p9_cw = (p9_cw + 1) & p9_CMK;
p9_cg = p9_lc * p9_cfade * p9_cnv;
p9_cl *= p9_cg; p9_cr_ *= p9_cg;
p9_s1l = p9_sl + p9_cl; p9_s1r = p9_sr_ + p9_cr_;

// ---------- DELAY: TIME (a new time crossfades to its tap), FEEDBACK (darker each pass) ----------
p9_xs == 0 && p9_tdt != p9_dha ? ( p9_dhb = p9_tdt; p9_xs = 1; p9_xf = 0; );
p9_xs ? ( p9_xf += p9_xk; p9_xf >= 1 ? ( p9_xf = 0; p9_xs = 0; p9_dha = p9_dhb; ); );
p9_i0 = (p9_dw - p9_dha) & p9_DMK; p9_i1 = (p9_dw - p9_dhb) & p9_DMK;
p9_el = p9_DLB[p9_i0] + (p9_DLB[p9_i1] - p9_DLB[p9_i0]) * p9_xf;
p9_er = p9_DLB[p9_DSZ + p9_i0] + (p9_DLB[p9_DSZ + p9_i1] - p9_DLB[p9_DSZ + p9_i0]) * p9_xf;
p9_elL += (p9_el - p9_elL) * p9_kdl; p9_elR += (p9_er - p9_elR) * p9_kdl;
p9_wl_ = p9_s1l + p9_fb * p9_elL; p9_wr_ = p9_s1r + p9_fb * p9_elR;
p9_wl_ = 2 * s92_th(0.5 * p9_wl_); p9_wr_ = 2 * s92_th(0.5 * p9_wr_);
!p9_mod ? ( p9_wl_ = p9_qt(p9_wl_); p9_wr_ = p9_qt(p9_wr_); );
p9_DLB[p9_dw] = p9_wl_; p9_DLB[p9_DSZ + p9_dw] = p9_wr_;
p9_dw = (p9_dw + 1) & p9_DMK;
p9_el *= p9_ld; p9_er *= p9_ld;
p9_s2l = p9_s1l + p9_el; p9_s2r = p9_s1r + p9_er;

// ---------- REVERB ----------
p9_rl = p9_rr = 0;
!p9_ridle ? (
  // PRE-DELAY (gliding, linear interpolation)
  p9_PB[p9_pw] = p9_s2l; p9_PB[p9_PSZ + p9_pw] = p9_s2r;
  p9_rp = p9_pw - p9_pre; p9_rp < 0 ? p9_rp += p9_PSZ;
  p9_ri = floor(p9_rp); p9_rf = p9_rp - p9_ri; p9_j0 = p9_ri & p9_PMK; p9_j1 = (p9_ri + 1) & p9_PMK;
  p9_sa = p9_PB[p9_j0] + (p9_PB[p9_j1] - p9_PB[p9_j0]) * p9_rf;
  p9_sb = p9_PB[p9_PSZ + p9_j0] + (p9_PB[p9_PSZ + p9_j1] - p9_PB[p9_PSZ + p9_j0]) * p9_rf;
  p9_pw = (p9_pw + 1) & p9_PMK;
  // the send into the tank fades with the return, and comes back in more slowly: a fresh tank fills from a ramp
  p9_rst == 1 || p9_rst == 2 || p9_fst == 1 || p9_fst == 2 ? p9_rsf = min(p9_rsf, min(p9_rfade, p9_fade)) : p9_rsf = min(p9_rsf + p9_fd * 0.35, 1);
  p9_sa *= p9_rsf; p9_sb *= p9_rsf;
  p9_prg <= 1 ? (
    // ================= HALL / ROOM: diffusers into 8 modulated lines with an all-pass in each =================
    p9_dfa = p9_diff(p9_sa, 0, p9_ndf, p9_dfg); p9_dfb = p9_diff(p9_sb, 4, p9_ndf, p9_dfg);
    i_ = 0;
    loop(8,
      p9_d = (p9_DLC[i_] += p9_DLD[i_]);
      p9_bb = p9_LB + i_ * p9_BSZ; p9_n = p9_w - floor(p9_d);
      p9_v = p9_bb[p9_n & p9_BM]; p9_v += (p9_bb[(p9_n - 1) & p9_BM] - p9_v) * (p9_d - floor(p9_d));
      p9_LPS[i_] += (p9_v - p9_LPS[i_]) * p9_kd;
      p9_O[i_] = p9_LPS[i_] * p9_GN[i_];
      i_ += 1;
    );
    p9_rl = p9_O[0] - p9_O[2] + p9_O[4] - p9_O[6] + 0.6 * (p9_O[1] - p9_O[5]);
    p9_rr = p9_O[1] - p9_O[3] + p9_O[5] - p9_O[7] + 0.6 * (p9_O[2] - p9_O[6]);
    // 8 x 8 Hadamard (scaled: lossless)
    p9_a = p9_O[0] + p9_O[1]; p9_b = p9_O[0] - p9_O[1]; p9_c = p9_O[2] + p9_O[3]; p9_e = p9_O[2] - p9_O[3];
    p9_f = p9_O[4] + p9_O[5]; p9_g = p9_O[4] - p9_O[5]; p9_h = p9_O[6] + p9_O[7]; p9_j = p9_O[6] - p9_O[7];
    p9_O[0] = p9_a + p9_c; p9_O[2] = p9_a - p9_c; p9_O[1] = p9_b + p9_e; p9_O[3] = p9_b - p9_e;
    p9_O[4] = p9_f + p9_h; p9_O[6] = p9_f - p9_h; p9_O[5] = p9_g + p9_j; p9_O[7] = p9_g - p9_j;
    p9_a = p9_O[0]; p9_O[0] = (p9_a + p9_O[4]) * 0.35355339; p9_O[4] = (p9_a - p9_O[4]) * 0.35355339;
    p9_a = p9_O[1]; p9_O[1] = (p9_a + p9_O[5]) * 0.35355339; p9_O[5] = (p9_a - p9_O[5]) * 0.35355339;
    p9_a = p9_O[2]; p9_O[2] = (p9_a + p9_O[6]) * 0.35355339; p9_O[6] = (p9_a - p9_O[6]) * 0.35355339;
    p9_a = p9_O[3]; p9_O[3] = (p9_a + p9_O[7]) * 0.35355339; p9_O[7] = (p9_a - p9_O[7]) * 0.35355339;
    // the all-pass in each line, the word length (ANALOG), back into the line
    i_ = 0;
    loop(8,
      p9_u = p9_O[i_] + p9_ISG[i_] * (i_ & 1 ? p9_dfb : p9_dfa);
      p9_bb = p9_AB + i_ * p9_ASZ;
      p9_v = p9_bb[(p9_aw - p9_APN[i_]) & p9_AM];
      p9_g = i_ & 1 ? -p9_apg : p9_apg;
      p9_y = p9_v - p9_g * p9_u; p9_bb[p9_aw] = p9_u + p9_g * p9_y;
      !p9_mod ? p9_y = p9_qt(p9_y);
      p9_bb = p9_LB + i_ * p9_BSZ; p9_bb[p9_w] = min(max(p9_y, -4), 4);
      i_ += 1;
    );
    p9_w = (p9_w + 1) & p9_BM;
    p9_rl *= 0.25; p9_rr *= 0.25;
  ) : p9_prg == 2 ? (
    // ================= PLATE =================
    p9_bw += ((p9_sa + p9_sb) * 0.5 + p9_dn - p9_bw) * p9_kbw;
    p9_u = p9i1.s92_ap(p9_bw, 142 * p9_pki, 0.75); p9_u = p9i2.s92_ap(p9_u, 107 * p9_pki, 0.75);
    p9_u = p9i3.s92_ap(p9_u, 379 * p9_pki, 0.625); p9_u = p9i4.s92_ap(p9_u, 277 * p9_pki, 0.625);
    p9_ph += p9_lfi; p9_ph >= 1 ? p9_ph -= 1;
    p9_mA = p9_exc * sin(2 * $pi * p9_ph); p9_mB = p9_exc * cos(2 * $pi * p9_ph);
    p9_a = p9tA1.p9_apm(p9_u + p9_pg * p9_pfR, 672 * p9_pk + p9_mA, -0.7);
    p9tD1.s92_dlw(p9_a); p9_a = p9tD1.s92_dlr(4453 * p9_pk);
    p9_dmA += (p9_a - p9_dmA) * p9_pkd;
    p9_a = p9tA2.s92_ap(p9_dmA * p9_pg, 1800 * p9_pk, p9_dd2);
    !p9_mod ? p9_a = p9_qt(p9_a);
    p9tD2.s92_dlw(p9_a);
    p9_b = p9tA3.p9_apm(p9_u + p9_pg * p9_pfL, 908 * p9_pk + p9_mB, -0.7);
    p9tD3.s92_dlw(p9_b); p9_b = p9tD3.s92_dlr(4217 * p9_pk);
    p9_dmB += (p9_b - p9_dmB) * p9_pkd;
    p9_b = p9tA4.s92_ap(p9_dmB * p9_pg, 2656 * p9_pk, p9_dd2);
    !p9_mod ? p9_b = p9_qt(p9_b);
    p9tD4.s92_dlw(p9_b);
    p9_pfL = p9tD2.s92_dlr(3720 * p9_pk); p9_pfR = p9tD4.s92_dlr(3163 * p9_pk);
    p9_rl = p9tD3.s92_dlr(266 * p9_pk) + p9tD3.s92_dlr(2974 * p9_pk) - p9tA4.s92_dlr(1913 * p9_pk) + p9tD4.s92_dlr(1996 * p9_pk)
          - p9tD1.s92_dlr(1990 * p9_pk) - p9tA2.s92_dlr(187 * p9_pk) - p9tD2.s92_dlr(1066 * p9_pk);
    p9_rr = p9tD1.s92_dlr(353 * p9_pk) + p9tD1.s92_dlr(3627 * p9_pk) - p9tA2.s92_dlr(1228 * p9_pk) + p9tD2.s92_dlr(2673 * p9_pk)
          - p9tD3.s92_dlr(2111 * p9_pk) - p9tA4.s92_dlr(335 * p9_pk) - p9tD4.s92_dlr(121 * p9_pk);
    p9_rl *= 0.3; p9_rr *= 0.3;
  ) : (
    // ================= GATED: a dense diffused copy read by 64 shaped taps per side =================
    p9_dfa = p9_diff(p9_sa, 0, 4, p9_mod ? 0.68 : 0.6); p9_dfb = p9_diff(p9_sb, 4, 4, p9_mod ? 0.68 : 0.6);
    p9_LPS[0] += (p9_dfa - p9_LPS[0]) * p9_kd; p9_LPS[1] += (p9_dfb - p9_LPS[1]) * p9_kd;
    p9_TB[p9_tw] = p9_mod ? p9_LPS[0] : p9_qt(p9_LPS[0]); p9_TB[p9_TSZ + p9_tw] = p9_mod ? p9_LPS[1] : p9_qt(p9_LPS[1]);
    i_ = 0;
    p9_gset ? (
      loop(64,
        p9_rl += p9_GGL[i_] * p9_TB[(p9_tw - p9_GTL[i_]) & p9_TM];
        p9_rr += p9_GGR[i_] * p9_TB[p9_TSZ + ((p9_tw - p9_GTR[i_]) & p9_TM)];
        i_ += 1;
      );
    ) : (
      // the window is moving: every tap slides (fractional reads)
      p9_gls += (p9_glt - p9_gls) * p9_gk; abs(p9_gls - p9_glt) < 0.5 ? p9_gls = p9_glt;
      loop(64,
        p9_p = p9_tw - p9_GJL[i_] * p9_gls; p9_n = floor(p9_p); p9_fr = p9_p - p9_n;
        p9_v = p9_TB[p9_n & p9_TM]; p9_rl += p9_GGL[i_] * (p9_v + (p9_TB[(p9_n + 1) & p9_TM] - p9_v) * p9_fr);
        p9_p = p9_tw - p9_GJR[i_] * p9_gls; p9_n = floor(p9_p); p9_fr = p9_p - p9_n;
        p9_v = p9_TB[p9_TSZ + (p9_n & p9_TM)];
        p9_rr += p9_GGR[i_] * (p9_v + (p9_TB[p9_TSZ + ((p9_n + 1) & p9_TM)] - p9_v) * p9_fr);
        i_ += 1;
      );
    );
    p9_tw = (p9_tw + 1) & p9_TM;
  );
  p9_aw = (p9_aw + 1) & p9_AM;
  // a DC blocker, the level, the fade
  p9_dcyl = p9_rl - p9_dcxl + p9_dcc * p9_dcyl; p9_dcxl = p9_rl;
  p9_dcyr = p9_rr - p9_dcxr + p9_dcc * p9_dcyr; p9_dcxr = p9_rr;
  p9_rg = p9_wg * p9_rfade * p9_lr;
  p9_rl = p9_dcyl * p9_rg; p9_rr = p9_dcyr * p9_rg;
);

// ---------- the return: ANALOG the 16-bit D/A and the reconstruction filter; DIGITAL 20 bits, dithered ----------
p9_ql = p9_cl + p9_el + p9_rl; p9_qr_ = p9_cr_ + p9_er + p9_rr;
!p9_mod ? (
  p9_ql = p9rL.s92_bq(p9_qr(p9_ql)); p9_qr_ = p9rR.s92_bq(p9_qr(p9_qr_));
) : (
  p9_ql = floor(p9_ql * 524288 + rand(1) - rand(1) + 0.5) / 524288; p9_qr_ = floor(p9_qr_ * 524288 + rand(1) - rand(1) + 0.5) / 524288;
);

// ---------- MIX (a send law), ANALOG the output transformer, the fade, OUTPUT and the house output stage ----------
p9_mgd = min(1, 2 - 2 * p9_mix); p9_mgw = min(1, 2 * p9_mix);
p9_yl = p9_xl * p9_mgd + p9_ql * p9_mgw; p9_yr = p9_xr * p9_mgd + p9_qr_ * p9_mgw;
!p9_mod ? (
  p9_yl = p9vxL.p9_xout(p9_yl); p9_yr = p9vxR.p9_xout(p9_yr);
  p9_ocyl = p9_yl - p9_ocxl + p9_dcc * p9_ocyl; p9_ocxl = p9_yl; p9_yl = p9_ocyl * p9_TRA;
  p9_ocyr = p9_yr - p9_ocxr + p9_dcc * p9_ocyr; p9_ocxr = p9_yr; p9_yr = p9_ocyr * p9_TRA;
) : ( p9_yl *= p9_TRD; p9_yr *= p9_TRD; );
p9_yl *= p9_fade; p9_yr *= p9_fade;
p9_vL = max(p9_vL * 0.9995, abs(p9_yl) + abs(p9_yr));
p9_yl = p9L.ost_band(p9_yl) * p9_og; p9_yr = p9R.ost_band(p9_yr) * p9_og;
ost_out(p9_yl, p9_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;

@gfx 960 366
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_begin(960, 366);
s92_pal(slider20);
s92_fonts();
s92_face(960, 366);
p9g_dg = slider20 >= 0.5;
p9g_pg = min(max(floor(slider13 + 0.5), 0), 3);

// ---------- the header ----------
k_ = s92_header(960, "MLT92", "SERIES 92", "MULTI-EFFECTS PROCESSOR", #p9_pm, 20); vtg_f = gfx_getfont(); gfx_setfont(13); gfx_measurestr("SERIES 92", vtg_w, vtg_h); ver_tag_at("v3", 16, s92_sx * sc + vtg_w + 6 * sc, 15 * sc + 0.8 * vtg_h, 11 * sc, 0xEDEFF1); gfx_setfont(vtg_f + 1);
k_ > 0 ? prs_dirty = (k_);

// ---------- PROGRAM: the program LCD, the LED ladders, the trim, GUARD ----------
s92_mod(20, 62, 176, 292, "PROGRAM");
p9g_n = pr_cur >= 1 && pr_cur <= 12 ? pr_cur : 1;
sprintf(#p9g_s, "%02d", p9g_n);
s92_lcd(30, 94, 156, 28, #p9g_s);
pk_pitem(#p9_pl, p9g_n, #p9g_t);
gfx_setfont(15); gfx_measurestr(#p9g_t, p9g_tw, p9g_th);
p9g_tw > 118 * sc ? gfx_setfont(15, "Arial", 15 * sc * 118 * sc / p9g_tw, 'b');
gfx_measurestr(#p9g_t, p9g_tw, p9g_th);
ui_col(S92_LCDT); gfx_x = 36 * sc; gfx_y = floor(108 * sc - p9g_th * 0.5); gfx_drawstr(#p9g_t);
p9mI.s92_edge(30, 134, 156, 46, p9a_vi * 2.83, "IN");
p9mO.s92_edge(30, 186, 156, 46, p9a_vo * 2.83, "OUT");
p9a_vi *= 0.6; p9a_vo *= 0.6;
s92_off = 0; s92_knob(66, 290, 18, 1, -24, 12, 0, 0, "TRIM", "%+.1f dB", 0);
s92_smallc(150, 262, "GUARD");
s92_key(122, 274, 56, 24, slider2 >= 0.5, slider2 >= 0.5 ? "ON" : "OFF") ? s92_set(2, slider2 >= 0.5 ? 0 : 1);
in_grd > 0.5 ? pk_led(150 * sc, 312 * sc, 3.5 * sc, 1, S92_RED); in_grd = 0;

// ---------- CHORUS ----------
s92_mod(208, 62, 148, 292, "CHORUS");
s92_onoff(276, 64, 3);
s92_key(218, 94, 60, 24, slider4 < 0.5, "CHORUS") ? s92_set(4, 0);
s92_key(286, 94, 60, 24, slider4 >= 0.5, "FLANGE") ? s92_set(4, 1);
s92_knob(246, 172, 19, 5, 0.05, 5, 0.7, 1, "RATE", "%.2f Hz", 0);
s92_knob(318, 172, 19, 6, 0, 100, 45, 0, "DEPTH", "%.0f%%", 0);
s92_knob(282, 270, 22, 7, 0, 100, 50, 0, "LEVEL", "%.0f%%", 0);
s92_smallc(282, 338, slider4 >= 0.5 ? (p9g_dg ? "REGEN 50 %" : "REGEN 62 %") : (p9g_dg ? "1 VOICE  ·  TRIANGLE" : "2 VOICES  ·  SINE"));

// ---------- DELAY ----------
s92_mod(368, 62, 148, 292, "DELAY");
s92_onoff(436, 64, 8);
sprintf(#p9g_d, "%d MS", floor(slider9 + 0.5));
s92_lcd(380, 94, 124, 26, #p9g_d);
s92_knob(406, 172, 19, 9, 20, 1500, 360, 1, "TIME", "%.0f ms", 0);
s92_knob(478, 172, 19, 10, 0, 95, 30, 0, "FEEDBACK", "%.0f%%", 0);
s92_knob(442, 270, 22, 11, 0, 100, 25, 0, "LEVEL", "%.0f%%", 0);
s92_smallc(442, 338, p9g_dg ? "CLEAN REPEATS" : "DARKER REPEATS");

// ---------- REVERB: the program LCD and keys, SIZE, DECAY, DAMPING, LEVEL ----------
s92_mod(528, 62, 236, 292, "REVERB");
s92_onoff(684, 64, 12);
p9g_pg == 3 ? sprintf(#p9g_r, "GATED  %d MS", floor(80 * 8 ^ (slider14 / 100) + 0.5)) :
              sprintf(#p9g_r, "%s  %.1f S", p9g_pg == 0 ? "HALL" : p9g_pg == 1 ? "ROOM" : "PLATE", slider15);
s92_lcd(540, 94, 212, 26, #p9g_r);
gi_ = 0; loop(4, pk_pitem("HALL|ROOM|PLATE|GATED", gi_ + 1, #gt_);
  s92_key(538 + gi_ * 55, 130, 51, 24, p9g_pg == gi_, #gt_) ? s92_set(13, gi_); gi_ += 1; );
p9g_pg == 3 ? ( sprintf(#s92_vs, "%.0f ms", 80 * 8 ^ (slider14 / 100)); s92_knob(576, 190, 19, 14, 0, 100, 50, 0, "LENGTH", "", 0); ) :
              s92_knob(576, 190, 19, 14, 0, 100, 50, 0, "SIZE", "%.0f%%", 0);
s92_knob(646, 190, 19, 15, 0.2, 10, 2, 1, p9g_pg == 3 ? "SLOPE" : "DECAY", "%.2f s", 0);
s92_kc = S92_C_LPF; s92_knob(716, 190, 19, 16, 0, 100, 40, 0, "DAMPING", "%.0f%%", 0); s92_kc = 0;
s92_knob(646, 270, 22, 17, 0, 100, 35, 0, "LEVEL", "%.0f%%", 0);
s92_smallc(576, 262, p9g_dg ? "20-BIT" : "16-BIT");
s92_smallc(576, 280, p9g_dg ? "FULL BAND" : "13 KHZ");
s92_smallc(716, 262, p9g_dg ? "DENSE" : "VALVE I/O");
s92_smallc(716, 280, p9g_dg ? "CLEAN I/O" : "TRANSFORMER");
s92_smallc(646, 338, p9g_pg == 3 ? "SIZE SETS THE LENGTH" : "PRE-DELAY FOLLOWS SIZE");

// ---------- OUTPUT: DRIFT, SAT; MIX and OUTPUT on faders ----------
s92_mod(776, 62, 164, 292, "OUTPUT");
s92_knob(810, 122, 18, 21, 0, 100, 50, 0, "DRIFT", "%.0f%%", 0);
s92_knob(810, 222, 12, 22, 0, 100, 0, 0, "SAT", "%.0f%%", 0);
ost_clipped ? pk_led(830 * sc, 208 * sc, 3.5 * sc, 1, S92_RED); ost_clipped = 0;
s92_fc = S92_F_BLUE; s92_fader(866, 106, 130, 18, 0, 100, 50, 0, "MIX", "%.0f%%", 0);
s92_fc = 0; s92_fader(912, 106, 130, 19, -24, 12, 0, 0, "OUTPUT", "%+.1f dB", 0);
s92_smallc(858, 300, "MIX: A SEND LAW");
s92_smallc(858, 318, "DRY FULL TO 50 %");

pk_end();
ui_end();
