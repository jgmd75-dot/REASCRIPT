desc:Platte81 [plate reverb] (GFX)
//tags: reverb plate stereo studio broadcast vintage spring space
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:2.2<0.4,5,0.01>-Damping: decay time (s)
slider2:10<0,250,1>-Pre-delay (ms)
slider3:100<20,600,1>-Low cut (Hz)
slider4:16000<2000,20000,10>-High cut (VFD, Hz)
slider5:20<0,100,1>-Drive (%)
slider6:30<0,100,1>-Mix (%)
slider7:100<0,150,1>-Width (%)
slider8:50<0,100,1>-Drift (%)
slider9:1<0,1,1{Off,On}>-Mono in (VFD)
slider10:0<0,1,1{West,East}>-(unused, was Version)
slider11:0<0,100,1>-Spring (VFD, %)
slider12:0<-24,12,0.1>-Output (dB)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider18:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider19:0<0,1,1{ENG,DE}>-(unused, was label language)
slider20:50<0,100,1>-Tension (Matrix, %)
slider21:0<-6,6,0.1>-High (Matrix, dB)
slider22:1<0,1,1{Mono,Stereo}>-Pickups (Matrix)
slider23:0<0,1,1{Ulm,Copenhagen}>-Matrix plate
slider24:1<0,1,1{VFD,Matrix}>-Mode
slider25:prs_sel=0<0,23,1{No preset,Init,Vocal Plate,Snare Plate,Short Plate,Long Wash,Drum Bus,Plate Send,Dark Vocal,Crunch Snare,Dark Wash,Broadcast Hall,Spring Hybrid,Steel Vocal,Steel Snare,Long Plate,Short Bright,Mono 1957,Dark Plate,Tight Steel,Slack Plate,Driven Plate,Damper Closed,Damper Open}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=4194304

@init
#ui_man = "gfx-platte81";
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function pl_p2(n) local(p) ( p = 1; while (p < n) ( p *= 2; ); p; );

function px_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function px_k(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
function px_kt(t, fs) ( 1 - exp(-1 / (max(t, 0.00001) * fs)); );
function px_bqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(ga, w, cs, sn, al, a0, sa) (
  ga = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * max(q, 0.05));
  t == 1 ? ( a0 = 1 + al; b0 = (1 + cs) / 2 / a0; b1 = -(1 + cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) : (
    sa = 2 * sqrt(ga) * al; a0 = (ga + 1) - (ga - 1) * cs + sa;
    b0 = ga * ((ga + 1) + (ga - 1) * cs + sa) / a0; b1 = -2 * ga * ((ga - 1) + (ga + 1) * cs) / a0; b2 = ga * ((ga + 1) + (ga - 1) * cs - sa) / a0;
    a1 = 2 * ((ga - 1) - (ga + 1) * cs) / a0; a2 = ((ga + 1) - (ga - 1) * cs - sa) / a0;
  );
);
function px_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
function px_bqz() instance(z1, z2) ( z1 = 0; z2 = 0; );
function px_dlinit(n) instance(buf, len, w) ( buf = alloc(n); len = n; w = 0; );
function px_dlz() instance(buf, len, w) ( memset(buf, 0, len); w = 0; );
function px_dlw(x) instance(buf, len, w) ( w += 1; w >= len ? w = 0; buf[w] = x; );
function px_dlr(d) instance(buf, len, w) local(p, i, f, a, b) (
  d = min(max(d, 0), len - 2); p = w - d; p < 0 ? p += len; i = floor(p); f = p - i;
  a = buf[i]; i += 1; i >= len ? i = 0; b = buf[i];
  a + (b - a) * f;
);
function px_ap(x, d, g) instance(buf, len, w) local(v, y) (
  v = this.px_dlr(d); y = v - g * x; this.px_dlw(x + g * y); y;
);
PZ_F3 = 0.5 + 4 / 3 * log(4) - 3; PZ_LG2 = log(2);
function pz_thF(u) ( abs(u) < 3 ? u * u * 0.055555556 + 1.3333333333 * log(1 + u * u * 0.3333333333) : abs(u) + PZ_F3; );
function pz_th(u) instance(u1, f1) local(f, d) (
  f = pz_thF(u); d = u - u1;
  d = abs(d) > 0.00001 ? (f - f1) / d : px_th(0.5 * (u + u1));
  u1 = u; f1 = f;
  d;
);
function pz_lc(z) ( z = abs(z); z + log(1 + exp(-2 * z)) - PZ_LG2; );
function pz_tanh(u) instance(u1, f1) local(f, d) (
  f = pz_lc(u); pz_snap ? ( u1 = u; f1 = f; );
  d = u - u1;
  d = abs(d) > 0.00001 ? (f - f1) / d : ost_tanh(0.5 * (u + u1));
  u1 = u; f1 = f;
  d;
);
function px_mem() local(r) (
  r = srate / 29761 * 1.2;
  pxpd.px_dlinit(ceil(0.26 * srate) + 64);
  pxi1.px_dlinit(ceil(142 * r) + 8); pxi2.px_dlinit(ceil(107 * r) + 8); pxi3.px_dlinit(ceil(379 * r) + 8); pxi4.px_dlinit(ceil(277 * r) + 8);
  pxm1.px_dlinit(ceil((672 + 24) * r) + 8); pxt1.px_dlinit(ceil(4453 * r) + 8); pxa1.px_dlinit(ceil(1800 * r) + 8); pxt2.px_dlinit(ceil(3720 * r) + 8);
  pxm2.px_dlinit(ceil((908 + 24) * r) + 8); pxt3.px_dlinit(ceil(4217 * r) + 8); pxa2.px_dlinit(ceil(2656 * r) + 8); pxt4.px_dlinit(ceil(3163 * r) + 8);
);
function px_clr() (
  pxpd.px_dlz(); pzM.u1 = pzM.f1 = 0; pzsM.x1 = pzsM.x2 = pzsM.y1 = pzsM.y2 = 0;
  pxi1.px_dlz(); pxi2.px_dlz(); pxi3.px_dlz(); pxi4.px_dlz();
  pxm1.px_dlz(); pxt1.px_dlz(); pxa1.px_dlz(); pxt2.px_dlz(); pxm2.px_dlz(); pxt3.px_dlz(); pxa2.px_dlz(); pxt4.px_dlz();
  pxlc.px_bqz(); pxld.px_bqz(); pxhs.px_bqz(); pxht.px_bqz();
  px_bw = 0; px_lA = 0; px_lB = 0; px_bL = 0; px_bR = 0;
);
function pl_mem() (
  nextmem = 0;
  pl_bsz = pl_p2(0.16 * srate);  pl_bm = pl_bsz - 1;
  pl_asz = pl_p2(0.02 * srate);  pl_am = pl_asz - 1;
  pl_psz = pl_p2(0.26 * srate);  pl_pm = pl_psz - 1;
  pl_ssz = pl_p2(0.06 * srate);  pl_sm = pl_ssz - 1;
  pl_lb = alloc(16 * pl_bsz);
  pl_ab = alloc(16 * pl_asz);
  pl_ab2 = alloc(16 * pl_asz);
  pl_db = alloc(12 * pl_asz);
  pl_pb = alloc(2 * pl_psz);
  pl_sb = alloc(2 * pl_ssz);
  pl_tank0 = pl_lb; pl_tank1 = nextmem;
  pl_len = alloc(16);  pl_apl = alloc(16);  pl_g = alloc(16);  pl_kl = alloc(16); pl_ja = alloc(16); pl_jb = alloc(16);
  pl_c = alloc(16);  pl_tpl = alloc(16); pl_tpr = alloc(16); pl_sgl = alloc(16); pl_sgr = alloc(16); pl_is = alloc(16);
  pl_o = alloc(16);  pl_dv = alloc(16); pl_dr = alloc(64); pl_dln = alloc(12); pl_dgn = alloc(12);  pl_sn = alloc(2);
  pl_sgk = alloc(2); pl_ap2n = alloc(16); pl_g2 = alloc(16);
  pl_st0 = nextmem;
  pl_lo = alloc(16); pl_y = alloc(16); pl_d1x = alloc(16); pl_d1y = alloc(16); pl_d2x = alloc(16); pl_d2y = alloc(16);
  pl_dc = alloc(32); pl_sst = alloc(64); pl_slp = alloc(2);
  pl_st1 = nextmem;
  ost_init(alloc(4096));
  px_mem();
);
pl_mem();

pl_lsc = 1.6;
pl_tsp = 70;
pl_dsc = 0.35;
pl_ag2 = 0.5;
pl_dn = 0.000000000000001;

function pl_lines(v) local(i, s, ms, ap, f) (
  s = v ? 1.22 : 1;
  i = 0;
  loop(16,
    ms = i == 0 ? 17.3 : i == 1 ? 19.9 : i == 2 ? 22.7 : i == 3 ? 24.1 : i == 4 ? 26.9 : i == 5 ? 29.3 : i == 6 ? 31.7 : i == 7 ? 33.1 :
         i == 8 ? 35.9 : i == 9 ? 38.3 : i == 10 ? 40.1 : i == 11 ? 43.7 : i == 12 ? 46.1 : i == 13 ? 49.3 : i == 14 ? 52.7 : 56.9;
    ap = i == 0 ? 3.1 : i == 1 ? 4.3 : i == 2 ? 5.3 : i == 3 ? 6.1 : i == 4 ? 2.7 : i == 5 ? 3.7 : i == 6 ? 4.9 : i == 7 ? 5.7 :
         i == 8 ? 2.3 : i == 9 ? 3.3 : i == 10 ? 4.1 : i == 11 ? 5.9 : i == 12 ? 6.7 : i == 13 ? 2.9 : i == 14 ? 3.9 : 4.7;
    pl_len[i] = floor(ms * s * pl_lsc * 0.001 * srate) | 1;
    pl_apl[i] = floor(ap * s * 0.001 * srate) | 1;
    pl_g[i] = (i & 1 ? -1 : 1) * (v ? 0.66 : 0.62);
    ap = 7.3 + 5.8 * (i * 0.7548777 + 0.31 - floor(i * 0.7548777 + 0.31));
    pl_ap2n[i] = floor(ap * s * 0.001 * srate) | 1;
    pl_g2[i] = (i & 2 ? -1 : 1) * pl_ag2;
    f = i * 0.6180339 + 0.13 - floor(i * 0.6180339 + 0.13); pl_tpl[i] = max(floor((0.3 + pl_tsp * f * f) * 0.001 * srate), 1);
    f = i * 0.3819661 + 0.71 - floor(i * 0.3819661 + 0.71); pl_tpr[i] = max(floor((0.3 + pl_tsp * f * f) * 0.001 * srate), 1);
    pl_sgl[i] = (i == 1 || i == 2 || i == 6 || i == 9 || i == 11 || i == 12 || i == 13 || i == 15) ? -1 : 1;
    pl_sgr[i] = (i == 0 || i == 3 || i == 4 || i == 6 || i == 10 || i == 11 || i == 13 || i == 14) ? -1 : 1;
    pl_is[i] = (i == 2 || i == 3 || i == 6 || i == 7 || i == 9 || i == 12 || i == 13 || i == 14) ? -1 : 1;
    i += 1;
  );
  i = 0;
  loop(12,
    ms = i == 0 ? 0.31 : i == 1 ? 0.53 : i == 2 ? 0.89 : i == 3 ? 1.37 : i == 4 ? 2.11 : i == 5 ? 3.23 :
         i == 6 ? 0.37 : i == 7 ? 0.61 : i == 8 ? 0.97 : i == 9 ? 1.53 : i == 10 ? 2.33 : 3.61;
    pl_dln[i] = floor(ms * pl_dsc * 0.001 * srate) | 1;
    pl_dgn[i] = 0.7;
    i += 1;
  );
  pl_sn[0] = floor(0.0331 * srate); pl_sn[1] = floor(0.0397 * srate);
  v ? (
    pl_c0 = -0.55;
    pl_hipad = 1.4;
    pl_thf = 1.6;
    pl_lomul = 1.0;
    pl_cal = 1.04;
  ) : (
    pl_c0 = -0.42;
    pl_hipad = 2.2;
    pl_thf = 3.0;
    pl_lomul = 1.1;
    pl_cal = 1.0;
  );
);
function pl_lclr() instance(lo, y, d1x, d1y, d2x, d2y) ( lo = y = d1x = d1y = d2x = d2y = 0; );
function pl_dspclr() instance(x1, y1) ( x1 = y1 = 0; );
function pl_clear() (
  memset(pl_tank0, 0, pl_tank1 - pl_tank0);
  memset(pl_st0, 0, pl_st1 - pl_st0);
  plL0.pl_lclr(); plL1.pl_lclr(); plL2.pl_lclr(); plL3.pl_lclr(); plL4.pl_lclr(); plL5.pl_lclr(); plL6.pl_lclr(); plL7.pl_lclr();
  plL8.pl_lclr(); plL9.pl_lclr(); plL10.pl_lclr(); plL11.pl_lclr(); plL12.pl_lclr(); plL13.pl_lclr(); plL14.pl_lclr(); plL15.pl_lclr();
  pdA0.pl_dspclr(); pdA1.pl_dspclr(); pdA2.pl_dspclr(); pdA3.pl_dspclr(); pdA4.pl_dspclr(); pdA5.pl_dspclr();
  pdB0.pl_dspclr(); pdB1.pl_dspclr(); pdB2.pl_dspclr(); pdB3.pl_dspclr(); pdB4.pl_dspclr(); pdB5.pl_dspclr();
);
function pl_bqz() instance(x1, x2, y1, y2) ( x1 = 0; x2 = 0; y1 = 0; y2 = 0; );
function pl_rclr() (
  drvA.pl_bqz(); drvB.pl_bqz(); eqL.pl_bqz(); eqR.pl_bqz(); lcL.pl_bqz(); lcR.pl_bqz(); hcL.pl_bqz(); hcR.pl_bqz();
  pl_elL = 0; pl_elR = 0; pl_shp = 0; pl_shq = 0; saA.lp = 0; saB.lp = 0;
);

function pl_dinit(p) ( p[0] = rand(2) - 1; p[1] = rand(2) - 1; p[2] = rand(1); p[3] = 0.7 + rand(1) * 0.6; );
function pl_dtick(p, inc) (
  p[2] += inc * p[3];
  p[2] >= 1 ? ( p[2] -= 1; p[0] = p[1]; p[1] = rand(2) - 1; );
  p[0] + (p[1] - p[0]) * (0.5 - 0.5 * cos($pi * p[2]));
);

function pl_satw(u) ( ost_tanh(u * 0.6) * 1.6666667 );
pl_eb = ost_tanh(0.75 * 0.22); pl_en = 1 / (0.75 * (1 - pl_eb * pl_eb));
function pl_sate(u) instance(lp, u1, f1) local(f, d) (
  lp += (u - lp) * pl_xc;
  u += 0.4 * (ost_tanh(lp * 1.3) * 0.7692308 - lp);
  u = 0.75 * (u + 0.22); f = pz_lc(u); pz_snap ? ( u1 = u; f1 = f; );
  d = u - u1;
  d = abs(d) > 0.00001 ? (f - f1) / d : ost_tanh(0.5 * (u + u1));
  u1 = u; f1 = f;
  (d - pl_eb) * pl_en;
);

function pl_dap(x) instance(b, ln, g) local(y) (
  y = b[(pl_dw - ln) & pl_am] - g * x; b[pl_dw] = x + g * y; y;
);
function pl_diff(x, k0) (
  k0 ? pfB5.pl_dap(pfB4.pl_dap(pfB3.pl_dap(pfB2.pl_dap(pfB1.pl_dap(pfB0.pl_dap(x))))))
     : pfA5.pl_dap(pfA4.pl_dap(pfA3.pl_dap(pfA2.pl_dap(pfA1.pl_dap(pfA0.pl_dap(x))))));
);
function pl_dsp(x) instance(x1, y1) local(y) ( y = -0.5 * x + x1 + 0.5 * y1; x1 = x; y1 = y; y; );
function pl_disp(x, k0) (
  k0 ? pdB5.pl_dsp(pdB4.pl_dsp(pdB3.pl_dsp(pdB2.pl_dsp(pdB1.pl_dsp(pdB0.pl_dsp(x))))))
     : pdA5.pl_dsp(pdA4.pl_dsp(pdA3.pl_dsp(pdA2.pl_dsp(pdA1.pl_dsp(pdA0.pl_dsp(x))))));
);

function pl_chirp(y, k) local(j, yy, p) (
  j = 0;
  loop(16,
    p = pl_sst + k * 32 + j * 2;
    yy = 0.7 * y + p[0] - 0.7 * p[1]; p[0] = y; p[1] = yy; y = yy;
    j += 1;
  );
  y;
);
function pl_springs(x0, x1) local(b0, b1, s0, s1) (
  b0 = pl_sb; b1 = pl_sb + pl_ssz;
  s0 = b0[(pl_sw - pl_sn[0]) & pl_sm]; s1 = b1[(pl_sw - pl_sn[1]) & pl_sm];
  pl_slp[0] += (s0 - pl_slp[0]) * pl_slc; pl_slp[1] += (s1 - pl_slp[1]) * pl_slc;
  b0[pl_sw] = min(max(x0 + pl_sgk[0] * pl_chirp(pl_slp[1], 0) + pl_dn, -4), 4);
  b1[pl_sw] = min(max(x1 + pl_sgk[1] * pl_chirp(pl_slp[0], 1) + pl_dn, -4), 4);
  pl_s0 = s0; pl_s1 = s1;
);

function pl_line() instance(bb, len, tpl, tpr, sgl, sgr, lo, y, kl, ja, jb, o) local(v) (
  v = bb[(pl_w - len) & pl_bm];
  pl_tl += sgl * bb[(pl_w - tpl) & pl_bm];
  pl_tr += sgr * bb[(pl_w - tpr) & pl_bm];
  lo += (v - lo) * pl_clo;
  v += kl * lo;
  y += (v - y) * pl_chi;
  o = jb * (v + ja * (v - y));
);
function pl_ap(odd) instance(o, is, a1, a2, apl, ap2n, g, g2, c, d1x, d1y, d2x, d2y, bb) local(u, v, yy) (
  u = o * 0.25 + is * (odd ? pl_db_ : pl_da);
  v = a1[(pl_aw - apl) & pl_am];
  yy = v - g * u; a1[pl_aw] = u + g * yy;
  v = a2[(pl_aw - ap2n) & pl_am];
  u = v - g2 * yy; a2[pl_aw] = yy + g2 * u; yy = u;
  u = c * yy + d1x - c * d1y; d1x = yy; d1y = u;
  v = c * u + d2x - c * d2y; d2x = u; d2y = v;
  bb[pl_w] = min(max(v + pl_dn, -4), 4);
);
function pl_lsync(i) instance(bb, a1, a2, len, tpl, tpr, sgl, sgr, kl, ja, jb, is, apl, ap2n, g, g2, c) (
  bb = pl_lb + i * pl_bsz; a1 = pl_ab + i * pl_asz; a2 = pl_ab2 + i * pl_asz;
  len = pl_len[i]; tpl = pl_tpl[i]; tpr = pl_tpr[i]; sgl = pl_sgl[i]; sgr = pl_sgr[i];
  kl = pl_kl[i]; ja = pl_ja[i]; jb = pl_jb[i]; is = pl_is[i]; apl = pl_apl[i]; ap2n = pl_ap2n[i]; g = pl_g[i]; g2 = pl_g2[i]; c = pl_c[i];
);
function pl_dsync(i) instance(b, ln, g) ( b = pl_db + i * pl_asz; ln = pl_dln[i]; g = pl_dgn[i]; );
function pl_sync() (
  plL0.pl_lsync(0); plL1.pl_lsync(1); plL2.pl_lsync(2); plL3.pl_lsync(3); plL4.pl_lsync(4); plL5.pl_lsync(5);
  plL6.pl_lsync(6); plL7.pl_lsync(7); plL8.pl_lsync(8); plL9.pl_lsync(9); plL10.pl_lsync(10); plL11.pl_lsync(11);
  plL12.pl_lsync(12); plL13.pl_lsync(13); plL14.pl_lsync(14); plL15.pl_lsync(15);
  pfA0.pl_dsync(0); pfA1.pl_dsync(1); pfA2.pl_dsync(2); pfA3.pl_dsync(3); pfA4.pl_dsync(4); pfA5.pl_dsync(5);
  pfB0.pl_dsync(6); pfB1.pl_dsync(7); pfB2.pl_dsync(8); pfB3.pl_dsync(9); pfB4.pl_dsync(10); pfB5.pl_dsync(11);
);

pl_cdr = 0.035; pl_spg = 1.3;
function pl_ctl() local(i, T, Tl, Th, Ts, L, gl, gm, gh) (
  pl_ts += (pl_tt - pl_ts) * pl_tk;
  T = pl_ts * pl_cal * (1 + pl_ddv);
  Tl = T * pl_lomul;
  Th = 1 / (1 / (T * pl_hipad) + 1 / pl_thf);
  i = 0;
  loop(16,
    L = (pl_len[i] + pl_apl[i] + pl_ap2n[i]) * -6.9077553 / srate;
    gl = exp(L / Tl); gm = exp(L / T); gh = exp(L / Th);
    pl_kl[i] = gl / gm - 1;
    pl_ja[i] = gh / gm - 1; pl_jb[i] = gm;
    pl_c[i] = pl_c0 + pl_cdr * pl_dv[i];
    i += 1;
  );
  Ts = min(T, 3.2) * 0.85;
  pl_sgk[0] = exp(-6.9077553 * pl_sn[1] / (Ts * srate));
  pl_sgk[1] = exp(-6.9077553 * pl_sn[0] / (Ts * srate));
  pl_wg = (pl_ver ? 1.72 : 1.26) * (2.2 / pl_ts) ^ 0.12;
  pl_sync();
);

px_cal = 0.70;
function px_update() (
  slider23 = 0; px_tfc = 0;
  px_drv = slider5 / 100;
  px_ster = slider22 >= 0.5;
  px_szt = (0.85 + 0.3 * (1 - slider20 / 100)) * srate / 29761;
);
function px_plate() local(lp) (
  px_rt = px_rts * (px_fc ? 0.9 : 1);
  lp = (672 + 4453 + 1800 + 3720) * px_sz / srate;
  px_dec = 10 ^ (-1.5 * lp / px_rt);
  px_kd = px_k((px_fc ? 5000 : 8000) * 2 ^ (slider20 / 100 * 1.4 - 0.7), srate);
  px_kb = px_k(px_fc ? 9000 : 13000, srate);
  px_lf != px_l3 ? ( px_l3 = px_lf; pxlc.px_bqset(1, px_lf, 0, 0.7, srate); pxld.px_bqset(1, px_lf, 0, 0.7, srate); );
  px_hg != px_l21 ? ( px_l21 = px_hg; pxhs.px_bqset(5, 6000, px_hg, 0.7, srate); pxht.px_bqset(5, 6000, px_hg, 0.7, srate); );
  px_og2 = 0.7 * (max(px_rt, 0.4) / 2) ^ 0.1 * (px_fc ? 1.1 : 1) * px_cal;
);

function update() (
  pl_tt = min(max(slider1, 0.4), 5);
  pl_pret = min(max(slider2, 0), 250) * 0.001 * srate;
  slider3 != pl_lcl ? ( pl_lcl = slider3; lcL.bq_set(1, slider3, 0.7071, 0); lcR.bq_set(1, slider3, 0.7071, 0); );
  pl_hcf != pl_hcl ? ( pl_hcl = pl_hcf; hcL.bq_set(0, pl_hcf, 0.7071, 0); hcR.bq_set(0, pl_hcf, 0.7071, 0); );
  pl_hcon = slider4 < 19950;
  pl_dg = 10 ^ (slider5 / 100 * 24 / 20);
  pl_mxt = slider6 / 100;
  pl_wdt = slider7 / 100;
  drift_macro(slider8);
  pl_stt = slider9 >= 0.5 ? 0 : 1;
  pl_vtar = 0;
  pl_spt = slider11 / 100;
  pl_ot = 10 ^ (slider12 / 20);
  ost_setup(slider13 / 100, slider14 / 100, slider15, slider16, slider17, 0);
  pl_mdt = slider24 >= 0.5;
  px_update();
);

function pl_set(v, d, pd, lc, hc, dr, mx, wd, dft, mono, spr) (
  slider10 = v; slider1 = d; slider2 = pd; slider3 = lc; slider4 = hc; slider5 = dr; slider6 = mx; slider7 = wd;
  slider8 = dft; slider9 = mono; slider11 = spr;
  slider20 = 50; slider21 = 0; slider22 = 1; slider24 = 0;
  slider_automate(2047 + 524288 + 1048576 + 2097152 + 8388608);
);
function px_set(d, pd, tn, lc, hi, dr, pk, wd, mx) (
  slider24 = 1; slider1 = d; slider2 = pd; slider20 = tn; slider3 = lc; slider21 = hi; slider5 = dr; slider22 = pk;
  slider7 = wd; slider6 = mx; slider8 = 50; slider4 = 16000; slider9 = 1; slider11 = 0;
  slider_automate(1535 + 524288 + 1048576 + 2097152 + 8388608);
);
function load_preset(p) (
  p == 1  ? pl_set(0, 2.2,  10, 100, 16000, 20,  30, 100, 50, 1,  0) :
  p == 2  ? pl_set(0, 2.6,  40, 150, 12000, 25,  25, 100, 40, 1,  0) :
  p == 3  ? pl_set(0, 1.4,   5, 200, 14000, 40,  25, 100, 50, 1,  0) :
  p == 4  ? pl_set(0, 0.8,   0, 180, 16000, 20,  20, 100, 40, 1,  0) :
  p == 5  ? pl_set(0, 5.0,  60, 120, 10000, 15,  35, 120, 60, 0,  0) :
  p == 6  ? pl_set(0, 1.0,   0, 250,  9000, 50,  12, 110, 40, 0,  0) :
  p == 7  ? pl_set(0, 2.4,  20, 110, 16000, 20, 100, 100, 50, 1,  0) :
  p == 8  ? pl_set(0, 2.4,  30, 140,  7500, 35,  25, 100, 50, 1,  0) :
  p == 9  ? pl_set(0, 1.2,   0, 220,  7000, 60,  25, 100, 50, 1,  0) :
  p == 10 ? pl_set(0, 4.5,  20, 100,  6000, 70,  35, 110, 80, 1,  0) :
  p == 11 ? pl_set(0, 3.2,  45, 160, 10000, 30,  30, 120, 50, 0,  0) :
  p == 12 ? pl_set(0, 2.0,  10, 200,  7500, 45,  30, 100, 60, 1, 55) :
  p == 13 ? px_set(1.96,  60, 55, 180,   1, 15, 1,  80, 31) :
  p == 14 ? px_set(1.60,   0, 70, 150,   2, 30, 1,  90, 36) :
  p == 15 ? px_set(4.04,  30, 45, 100,   0, 15, 1, 100, 36) :
  p == 16 ? px_set(1.17,  10, 80, 200,   3, 15, 1,  70, 31) :
  p == 17 ? px_set(2.18,  25, 50, 150,   0, 25, 0,  80, 36) :
  p == 18 ? px_set(2.41,  20, 25, 100,  -4, 20, 1,  80, 36) :
  p == 19 ? px_set(1.77,  15, 95, 160,   1, 15, 1,  80, 31) :
  p == 20 ? px_set(2.67,  25,  5,  80,  -2, 20, 1,  80, 36) :
  p == 21 ? px_set(1.96,  10, 60, 140,   0, 80, 1,  80, 36) :
  p == 22 ? px_set(0.70,   0, 60, 200,   0, 15, 1,  70, 36) :
  p == 23 ? px_set(5.00,  40, 50, 120,   0, 15, 1, 100, 31) :
  p == 24 ? (
