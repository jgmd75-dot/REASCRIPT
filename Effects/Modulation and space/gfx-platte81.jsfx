    slider12 = 0; slider13 = 0; slider14 = 30; slider15 = 120; slider16 = 6000; slider17 = -0.3; slider18 = 1; slider23 = 0; slider24 = 1;
    slider_automate(16777215);
  );
);

function pl_srinit() local(i) (
  pl_sr = srate;
  pl_xc = 1 - exp(-2 * $pi * 140 / srate);
  pl_clo = 1 - exp(-2 * $pi * 300 / srate);
  pl_chi = 1 - exp(-2 * $pi * 2500 / srate);
  pl_slc = 1 - exp(-2 * $pi * 4200 / srate);
  pl_tk = 1 - exp(-32 / (0.12 * srate));
  pl_shc = 1 - exp(-2 * $pi * 200 / srate);
