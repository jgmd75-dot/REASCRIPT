desc:VC81 [vocoder] (GFX)
//tags: vocoder modulation space robot voice formant filter-bank talkbox synth carrier side-chain midi
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// VC81. Two half-rack vocoders bolted side by side by a central mounting bracket (the 81 family):
//   LEFT  - KR-81 LABOR-VOCODER, in the spirit of the Soviet 24-band laboratory vocoders: a dense bank of steep
//           band-pass filters, op-amp saturation on every carrier band, full-wave rectifier followers.
//   RIGHT - SV-81 BROADCAST VOCODER SYSTEM, in the spirit of the Japanese studio broadcast vocoders: clean
//           Butterworth band-passes, smooth followers, a voiced / unvoiced detector that fills the consonants
//           with noise, and the built-in synth carrier's controls.
// ROUTING (parallel): the same modulator and carrier feed both units; KR / SV BALANCE blends them when both are
//   on (with only one unit on, it plays at full level whatever the BALANCE); each unit has its own lit ON key
//   (10 ms fades). Both units off = the dry modulator passes.
//
// I/O  inputs 1/2 = MODULATOR (a voice, drums ...; summed to mono for the analysis), inputs 3/4 = CARRIER
//      (side-chain: route a synth, pad, guitar ... into channels 3/4). Stereo out.
//      CARRIER keys (bracket): EXT = the side-chain on 3/4; SYNTH = the internal carrier played by MIDI
//      (8-voice poly: SAW / PULSE / SUPER (three detuned saws), a breath of noise, LEVEL, TUNE, OCTAVE, GLIDE on
//      the SV-81 face; GLIDE slides each voice from its last pitch); HOLD latches the chord (a drone) until the
//      next chord is played.
//      No MIDI notes with SYNTH, or nothing on 3/4 with EXT = no carrier = no vocoder output (the SV-81 display
//      says so). MIDI is passed through. Pitch bend +/-2 semitones; CC120 / CC123 release all notes.
//
// KR-81 (24 bands, 100 Hz - 8 kHz on a log grid, plus a TOP band: a 4-pole high-pass from 9.5 kHz)
//   Each band: two identical resonant band-pass sections (4th order) on the modulator and on the carrier.
//   BAND WIDTH  the bands' Q: 0 % = very narrow (Q 10, ringing, metallic), 100 % = wide (Q 2.6, smeared);
//               50 % = the bands just meet. Level compensated.
//   SHIFT       formant shift: the carrier bank's centres x 2^SHIFT against the modulator bank (+/-1 octave).
//               Bands pushed above 0.4 x the sample rate (or under 40 Hz) fade out.
//   DRIVE       op-amp soft clipping of every carrier band before its VCA (the gritty 'labour' sound).
//   HF BOOST    intelligibility emphasis on the modulator's top bands (a shelf from about 3 kHz, 0 .. +12 dB).
//   DIRECT      the unprocessed modulator added to KR-81's output (0 .. 100 %).
//   Followers: full-wave rectifier, 0.8 ms attack, release 15 .. 60 ms by band (longer in the bass), then a
//   ripple smoother. KR-81 also hears the V/UV noise, at a lighter level.
// SV-81 (16 or 24 bands, 100 Hz - 8 kHz, plus a TOP band from 9.5 kHz)
//   Each band: a 4th-order Butterworth band-pass (two stagger-tuned sections) exactly one band-spacing wide,
//   shared by the modulator and carrier banks. Followers: rectifier, 2 ms attack, release REL FAST 30 ms /
//   REL SLOW 160 ms, then a second smoothing pole (no ripple, no zipper).
//   V/UV SENS   the voiced / unvoiced detector: the energy above 3.5 kHz against the energy under 800 Hz, and the
//               zero-crossing rate. Unvoiced (s, t, f, sh) = both high: noise (following the carrier's level)
//               is injected into the carrier of the bands above 2.5 kHz, shaped by the modulator. 0 = off.
//   TILT        a high shelf on SV-81's bands (about 2.5 kHz, +/-12 dB; the lows move a little the other way, so the
//               loudness stays roughly the same).
//   LEVEL / TUNE / OCTAVE / GLIDE and the SAW / PULSE / SUPER keys: the internal synth carrier (shared by both
//   units, heard when the bracket's SYNTH key is lit).
// MODE keys (header): VFD / MATRIX set both units' faces, voices and the label language at once.
//   VFD    - the Japanese voicing: charcoal faces with VFD glow (KR-81 amber, SV-81 turquoise), clean outputs,
//            English labels.
//   MATRIX - the European voicing: battleship-grey faces with LED-matrix ladders and mustard keys, German labels;
//            each unit gets an output transformer (low-frequency core saturation, a gentle biased curve: even
//            harmonics).
//   The switch is a 10 ms crossfade into / out of the transformers: no click. The two modes are level-matched
//   (pink noise at -21 dBFS on the modulator and the carrier: within 0.25 dB; a hot synth carrier drives the
//   transformers harder, so there MATRIX can read up to about 0.7 dB louder or 0.4 dB quieter).
// The stereo image: the bands alternate a little left / right above about 300 Hz (KR-81 a narrow spread, SV-81
//   wider; the bass stays in the middle), and every other band is polarity-inverted so that neighbouring bands
//   sum without a phase hole. The carrier is processed in mono (EXT 3/4 summed), which keeps the cost down:
//   about 13 % of one core at 48 kHz (24 + 16 bands), 15 % with 24 + 24 bands and all 8 synth voices.
// BRACKET   CARRIER keys, KR / SV BALANCE, MIX (dry modulator <-> vocoder), DRIFT, OUTPUT, band SAT and the house
//           output stage (soft clip, always on).
// DRIFT (0 - 100 %, 50 % = standard): filter-bank tolerance. Every KR-81 filter sits a little off its nominal
//   centre (the modulator and carrier banks each with their own tolerance, about +/-1.2 % at 50 %) and wanders
//   slowly (+/-0.8 %); the followers' release times breathe (+/-10 %). SV-81 is nearly steady (about a seventh
//   of that). 0 % = a perfect, matched bank.
// GUI: drag a knob (SHIFT = fine, double-click = default, wheel); values show while a knob is touched; click a key;
//      click the LCD (or PRESETS) for the preset list. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:1<0,1,1{Off,On}>-KR-81 on
slider2:0<0,1,1{VFD,Matrix}>-Mode
slider3:50<0,100,1>-KR-81 band width (%)
slider4:0<-1,1,0.01>-KR-81 formant shift (oct)
slider5:25<0,100,1>-KR-81 drive (%)
slider6:4<0,12,0.1>-KR-81 HF boost (dB)
slider7:0<0,100,1>-KR-81 direct (%)
slider8:1<0,1,1{Off,On}>-SV-81 on
slider9:2<0,2,1>-(unused, was SV-81 style)
slider10:0<0,1,1{16,24}>-SV-81 bands
slider11:0<0,1,1{Fast,Slow}>-SV-81 release
slider12:50<0,100,1>-SV-81 V/UV sensitivity (%)
slider13:0<-12,12,0.1>-SV-81 tilt (dB)
slider14:0<-24,6,0.1>-Synth carrier level (dB)
slider15:0<-12,12,0.01>-Synth carrier tune (st)
slider16:0<-2,2,1>-Synth carrier octave
slider17:0<0,1000,1>-Synth carrier glide (ms)
slider18:0<0,2,1{Saw,Pulse,Super}>-Synth carrier wave
slider19:0<0,1,1{Ext 3/4,Synth}>-Carrier source
slider20:0<0,1,1{Off,On}>-Carrier hold
slider21:50<0,100,1>-KR / SV balance (%)
slider22:100<0,100,1>-Mix (%)
slider23:50<0,100,1>-Drift (%)
slider24:0<-24,12,0.1>-Output (dB)
slider25:0<0,100,1>-Band sat (%)
slider26:30<0,100,1>-Bias (%)
slider27:120<40,400,1>-Sat low band (Hz)
slider28:6000<2000,16000,10>-Sat high band (Hz)
slider29:-0.3<-24,0,0.1>-Ceiling (dB)
slider30:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider31:0<0,16,1>-MIDI channel (0 = omni)
slider32:0<0,1,1{ENG,DE}>-(unused, was label language)
slider33:prs_sel=0<0,12,1{No preset,Init,Robot Voice,Choir Pad (Synth),Talking Strings,Labor Grit,Broadcast Clear,Whisper Noise,Formant Up,Formant Down,Space Station,Drum Vocoder,Synth Solo}>-Preset

in_pin:Modulator L
in_pin:Modulator R
in_pin:Carrier L
in_pin:Carrier R
out_pin:left output
out_pin:right output

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0;
#ui_man = "gfx-vc81";                             // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
vc_KF = alloc(32);                                      // KR-81 band centres (Hz)
vc_SF = alloc(32);                                      // SV-81 band centres (Hz)
vc_KMB = alloc(32); vc_SMB = alloc(32);                   // band activity mailboxes (audio raises, panel reads + clears)
vc_VO  = alloc(8 * 16);                                  // synth voices, 16 slots each:
                                                        //   0 note (-1 free) 1 gate 2 env 3 inc now 4 inc target
                                                        //   5-7 phases 8 age 9 velocity gain 10 key down
vc_MQ  = alloc(256 * 4);                                 // MIDI event queue: offset, type, data 1, data 2
vg_LK = alloc(32); vg_LS = alloc(32);                   // panel: smoothed ladder levels
vc_ostm = alloc(4096); ost_init(vc_ostm);

vc_i = 0; loop(24, vc_KF[vc_i] = 100 * 80 ^ (vc_i / 23); vc_i += 1; );
vc_i = 0; loop(8, vc_VO[vc_i * 16] = -1; vc_i += 1; );

// ---------- filter helpers ----------
// constant 0 dB peak band-pass (b1 = 0, b2 = -b0): results in vc_c0, vc_a1, vc_a2
function vc_bp(f, q) local(w0, al, n) (
  w0 = 2 * $pi * min(max(f, 10), 0.46 * srate) / srate; al = sin(w0) / (2 * q); n = 1 + al;
  vc_c0 = al / n; vc_a1 = -2 * cos(w0) / n; vc_a2 = (1 - al) / n;
);
// 2-pole high-pass: results in vc_h0 .. vc_h4 (b0 b1 b2 a1 a2)
function vc_hp(f, q) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, 0.46 * srate) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al;
  vc_h0 = (1 + cw) * 0.5 / n; vc_h1 = -(1 + cw) / n; vc_h2 = vc_h0; vc_h3 = -2 * cw / n; vc_h4 = (1 - al) / n;
);
// 4th-order Butterworth band-pass of quality qbp as two stagger-tuned constant-peak sections:
// centres f x vc_ska and f x vc_skb, Qs vc_sqa / vc_sqb, vc_sg = the gain that brings the centre back to 0 dB
function vc_bwset(qbp) local(a, wr, wi, dr, di, m, xr, xi, r1, i1, r2, i2, w1, w2, h1, h2) (
  a = sqrt(0.5);
  wr = -a / (2 * qbp); wi = a / (2 * qbp);
  dr = wr * wr - wi * wi - 1; di = 2 * wr * wi;
  m = sqrt(dr * dr + di * di);
  xr = sqrt(max((m + dr) * 0.5, 0)); xi = sqrt(max((m - dr) * 0.5, 0)); di < 0 ? xi = -xi;
  r1 = wr + xr; i1 = wi + xi; r2 = wr - xr; i2 = wi - xi;
  w1 = sqrt(r1 * r1 + i1 * i1); w2 = sqrt(r2 * r2 + i2 * i2);
  vc_ska = w1; vc_sqa = w1 / max(-2 * r1, 0.000001);
  vc_skb = w2; vc_sqb = w2 / max(-2 * r2, 0.000001);
  h1 = (w1 / vc_sqa) / sqrt(sqr(w1 * w1 - 1) + sqr(w1 / vc_sqa));
  h2 = (w2 / vc_sqb) / sqrt(sqr(w2 * w2 - 1) + sqr(w2 / vc_sqb));
  vc_sg = 1 / max(h1 * h2, 0.0001);
);
function vc_svtab(n) local(i) (
  i = 0; loop(n, vc_SF[i] = 100 * 80 ^ (i / (n - 1)); i += 1; );
  vc_bwset(1 / (80 ^ (0.5 / (n - 1)) - 80 ^ (-0.5 / (n - 1))));   // one band-spacing wide
);

// ---------- KR-81: one band (modulator and carrier banks, rectifier follower, op-amp clip, VCA) ----------
function kr_band(m, c) instance(mc0, ma1, ma2, ms1, ms2, ms3, ms4, cc0, ca1, ca2, cs1, cs2, cs3, cs4,
                                e1, e2, ea, er, es, gl, gr, nw) local(y, u, v, t) (
  t = mc0 * m; y = t + ms1; ms1 = ms2 - ma1 * y; ms2 = -t - ma2 * y;    // c0*x once per section (measured faster in the JIT)
  t = mc0 * y; u = t + ms3; ms3 = ms4 - ma1 * u; ms4 = -t - ma2 * u;
  u = abs(u);
  e1 += (u - e1) * (u > e1 ? ea : er);
  e2 += (e1 - e2) * es;
  c += nw * vc_nz;
  t = cc0 * c; y = t + cs1; cs1 = cs2 - ca1 * y; cs2 = -t - ca2 * y;
  t = cc0 * y; u = t + cs3; cs3 = cs4 - ca1 * u; cs4 = -t - ca2 * u;
  v = min(max(u * vc_kdg, -1.5), 1.5);                 // op-amp soft clip: unity at first, flat at 1.0
  v = (v - 0.148148 * v * v * v) * e2;
  vc_kl += v * gl; vc_kr += v * gr;
);
// per block: drift, coefficients, follower times, gains, denormal housekeeping, the panel's mailbox
function kr_blk(b) instance(mc0, ma1, ma2, ms1, ms2, ms3, ms4, cc0, ca1, ca2, cs1, cs2, cs3, cs4,
                            e1, e2, ea, er, es, gl, gr, nw, ti, tm, tc, wa, wb, wp, wr) local(f, fm, fc, w, g, fd, pn, hf) (
  !ti ? ( ti = 1; tm = rand(2) - 1; tc = rand(2) - 1; wa = rand(2) - 1; wb = rand(2) - 1; wp = rand(1); wr = 0.7 + rand(0.6); );
  vc_rst ? ( ms1 = ms2 = ms3 = ms4 = cs1 = cs2 = cs3 = cs4 = e1 = e2 = 0; );
  wp += vc_dinc * wr; wp >= 1 ? ( wp -= 1; wa = wb; wb = rand(2) - 1; );
  w = wa + (wb - wa) * (0.5 - 0.5 * cos($pi * wp));
  f = vc_KF[b];
  fm = f * (1 + vc_kdr * (0.6 * tm + 0.4 * w));
  vc_bp(fm, vc_kq); mc0 = vc_c0; ma1 = vc_a1; ma2 = vc_a2;
  fc = f * vc_ksm * (1 + vc_kdr * (0.6 * tc - 0.4 * w));
  fd = fc > 0.4 * srate ? max(1 - (fc - 0.4 * srate) / (0.05 * srate), 0) : fc < 40 ? max((fc - 25) / 15, 0) : 1;
  vc_bp(min(max(fc, 25), 0.45 * srate), vc_kq); cc0 = vc_c0; ca1 = vc_a1; ca2 = vc_a2;
  ea = vc_kea;
  er = 1 - exp(-1 / ((10 + 25 * sqrt(250 / f)) * 0.001 * srate * (1 + 5 * vc_kdr * w)));
  es = 1 - exp(-2 * $pi * min(max(f * 0.25, 25), 70) / srate);
  hf = 10 ^ (vc_khf * f * f / (f * f + 9000000) / 20);
  g = vc_kcal * vc_kmk * vc_kqn * min(max((f / 1000) ^ 0.25, 0.5), 1.8) * hf * fd;
  pn = (b & 1 ? -vc_kwd : vc_kwd) * min(max((f - 120) / 700, 0), 1);   // the bass stays in the middle
  b & 1 ? g = -g;                                       // every other band inverted: neighbours sum without a phase hole
  gl = g * (1 + pn); gr = g * (1 - pn);
  nw = f > 2500 ? vc_knw * min((f - 2500) / 3000, 1) : 0;
  abs(ms1) < 0.000000000001 ? ms1 = 0; abs(ms2) < 0.000000000001 ? ms2 = 0;
  abs(ms3) < 0.000000000001 ? ms3 = 0; abs(ms4) < 0.000000000001 ? ms4 = 0;
  abs(cs1) < 0.000000000001 ? cs1 = 0; abs(cs2) < 0.000000000001 ? cs2 = 0;
  abs(cs3) < 0.000000000001 ? cs3 = 0; abs(cs4) < 0.000000000001 ? cs4 = 0;
  e1 < 0.000000000001 ? e1 = 0; e2 < 0.000000000001 ? e2 = 0;
  vc_KMB[b] = max(vc_KMB[b], e2 * hf);
);

// ---------- SV-81: one band (Butterworth pair shared by both banks, smooth follower, VCA) ----------
function sv_band(m, c) instance(ka0, ka1, ka2, kb0, kb1, kb2, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                                e1, e2, ea, er, es, gl, gr, nw) local(y, u, t) (
  t = ka0 * m; y = t + ms1; ms1 = ms2 - ka1 * y; ms2 = -t - ka2 * y;    // c0*x once per section, as KR-81
  t = kb0 * y; u = t + ms3; ms3 = ms4 - kb1 * u; ms4 = -t - kb2 * u;
  u = abs(u);
  e1 += (u - e1) * (u > e1 ? ea : er);
  e2 += (e1 - e2) * es;
  c += nw * vc_nz;
  t = ka0 * c; y = t + cs1; cs1 = cs2 - ka1 * y; cs2 = -t - ka2 * y;
  t = kb0 * y; u = t + cs3; cs3 = cs4 - kb1 * u; cs4 = -t - kb2 * u;
  u *= e2;
  vc_sl += u * gl; vc_sr += u * gr;
);
function sv_blk(b) instance(ka0, ka1, ka2, kb0, kb1, kb2, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                            e1, e2, ea, er, es, gl, gr, nw, ti, tm, wa, wb, wp, wr) local(f, w, g, pn, tl) (
  !ti ? ( ti = 1; tm = rand(2) - 1; wa = rand(2) - 1; wb = rand(2) - 1; wp = rand(1); wr = 0.7 + rand(0.6); );
  wp += vc_dinc * wr; wp >= 1 ? ( wp -= 1; wa = wb; wb = rand(2) - 1; );
  w = wa + (wb - wa) * (0.5 - 0.5 * cos($pi * wp));
  vc_sclr || vc_rst ? ( ms1 = ms2 = ms3 = ms4 = cs1 = cs2 = cs3 = cs4 = e1 = e2 = 0; );
  b < vc_svn ? (
    f = vc_SF[b] * (1 + vc_sdr * (0.6 * tm + 0.4 * w));
    vc_bp(f * vc_ska, vc_sqa); ka0 = vc_c0; ka1 = vc_a1; ka2 = vc_a2;
    vc_bp(f * vc_skb, vc_sqb); kb0 = vc_c0; kb1 = vc_a1; kb2 = vc_a2;
    ea = vc_sea;
    er = 1 - exp(-1 / (max(vc_srel, 9000 / f) * 0.001 * srate));
    es = vc_ses;
    tl = 10 ^ (vc_stl * (f * f / (f * f + 6250000) - 0.3) / 20);   // the shelf, loudness roughly kept
    g = vc_scal * vc_srg * vc_sg * vc_sg * vc_sqn * min(max((f / 1000) ^ 0.25, 0.5), 1.8) * tl;
    pn = (b & 1 ? -vc_swd : vc_swd) * min(max((f - 120) / 700, 0), 1);
    b & 1 ? g = -g;
    gl = g * (1 + pn); gr = g * (1 - pn);
    nw = f > 2500 ? vc_snw * min((f - 2500) / 3000, 1) : 0;
    abs(ms1) < 0.000000000001 ? ms1 = 0; abs(ms2) < 0.000000000001 ? ms2 = 0;
    abs(ms3) < 0.000000000001 ? ms3 = 0; abs(ms4) < 0.000000000001 ? ms4 = 0;
    abs(cs1) < 0.000000000001 ? cs1 = 0; abs(cs2) < 0.000000000001 ? cs2 = 0;
    abs(cs3) < 0.000000000001 ? cs3 = 0; abs(cs4) < 0.000000000001 ? cs4 = 0;
    e1 < 0.000000000001 ? e1 = 0; e2 < 0.000000000001 ? e2 = 0;
    vc_SMB[b] = max(vc_SMB[b], e2 * vc_sg * tl);
  ) : ( gl = gr = 0; );
);

// ---------- the TOP band of either unit: a 4-pole Butterworth high-pass on both banks ----------
function tp_band(m, c) instance(p0, p1, p2, p3, p4, q0, q1, q2, q3, q4, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                                e1, e2, ea, er, es, nw) local(y, u) (
  y = p0 * m + ms1; ms1 = p1 * m - p3 * y + ms2; ms2 = p2 * m - p4 * y;
  u = q0 * y + ms3; ms3 = q1 * y - q3 * u + ms4; ms4 = q2 * y - q4 * u;
  u = abs(u);
  e1 += (u - e1) * (u > e1 ? ea : er);
  e2 += (e1 - e2) * es;
  c += nw * vc_nz;
  y = p0 * c + cs1; cs1 = p1 * c - p3 * y + cs2; cs2 = p2 * c - p4 * y;
  u = q0 * y + cs3; cs3 = q1 * y - q3 * u + cs4; cs4 = q2 * y - q4 * u;
  u * e2;
);
function tp_blk(f, rel, nwt) instance(p0, p1, p2, p3, p4, q0, q1, q2, q3, q4, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                                      e1, e2, ea, er, es, nw) (
  vc_hp(f, 0.5412); p0 = vc_h0; p1 = vc_h1; p2 = vc_h2; p3 = vc_h3; p4 = vc_h4;
  vc_hp(f, 1.3066); q0 = vc_h0; q1 = vc_h1; q2 = vc_h2; q3 = vc_h3; q4 = vc_h4;
  ea = 1 - exp(-1 / (0.001 * srate)); er = 1 - exp(-1 / (rel * 0.001 * srate)); es = 1 - exp(-2 * $pi * 70 / srate);
  nw = nwt;
  abs(ms1) < 0.000000000001 ? ms1 = 0; abs(ms2) < 0.000000000001 ? ms2 = 0;
  abs(ms3) < 0.000000000001 ? ms3 = 0; abs(ms4) < 0.000000000001 ? ms4 = 0;
  abs(cs1) < 0.000000000001 ? cs1 = 0; abs(cs2) < 0.000000000001 ? cs2 = 0;
  abs(cs3) < 0.000000000001 ? cs3 = 0; abs(cs4) < 0.000000000001 ? cs4 = 0;
  e1 < 0.000000000001 ? e1 = 0; e2 < 0.000000000001 ? e2 = 0;
);
function tp_clr() instance(ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4, e1, e2) ( ms1 = ms2 = ms3 = ms4 = cs1 = cs2 = cs3 = cs4 = e1 = e2 = 0; );

// ---------- MATRIX output transformer: low-frequency core saturation, then a gentle biased curve ----------
function vc_rt(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function vc_xfm(x, k, d, tb, sn) instance(lo) local(t) (
  lo += (x - lo) * vc_xlc;
  t = x + lo / sqrt(1 + sqr(k * lo)) - lo;
  (vc_rt(d * (t + 0.08)) - tb) * sn;                    // a biased curve, unity small-signal gain, no static offset
);
// its constants for drive d (bias 0.08): results in vc_xtb, vc_xsn
function vc_xset(d) local(t) ( t = vc_rt(d * 0.08); vc_xtb = t; t = (vc_rt(d * 0.08 + 0.0001) - t) / 0.0001; vc_xsn = 1 / (t * d); );

// ---------- the synth carrier ----------
function vc_blep(t, dt) ( t < dt ? ( t /= dt; 2 * t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + 2 * t + 1; ) : 0; );
function vc_all_off() local(p) ( p = vc_VO; loop(8, p[1] = 0; p[10] = 0; p += 16; ); vc_nheld = 0; );
function vc_non(n, v) local(p, q, i, best, lo) (
  vc_hold && vc_nheld == 0 ? ( p = vc_VO; loop(8, p[1] = 0; p += 16; ); );   // HOLD: a new chord replaces the old
  vc_nheld += 1;
  q = -1; p = vc_VO;                                     // the same note still sounding: play it again
  loop(8, p[0] == n ? q = p; p += 16; );
  q < 0 ? ( p = vc_VO; loop(8, q < 0 && p[0] < 0 ? q = p; p += 16; ); );   // a free voice
  q < 0 ? ( lo = 2; p = vc_VO; loop(8, !p[1] && p[2] < lo ? ( lo = p[2]; q = p; ); p += 16; ); );   // the quietest released
  q < 0 ? ( best = 1000000000; p = vc_VO; loop(8, p[8] < best ? ( best = p[8]; q = p; ); p += 16; ); );   // the oldest
  q[0] < 0 ? ( q[2] = 0; q[5] = rand(1); q[6] = rand(1); q[7] = rand(1); );
  q[4] = 440 * 2 ^ ((n - 69) / 12) / srate;
  q[3] = vc_glon ? ( q[3] > 0 ? q[3] : vc_linc > 0 ? vc_linc : q[4] ) : q[4];   // GLIDE: from the voice's last pitch
  q[0] = n; q[1] = 1; q[10] = 1; q[9] = 0.55 + 0.45 * v / 127;
  vc_age += 1; q[8] = vc_age;
  vc_linc = q[4]; vc_vact = 1; vc_mhit += 1;
);
function vc_noff(n) local(p) (
  vc_nheld = max(vc_nheld - 1, 0);
  p = vc_VO; loop(8, p[0] == n && p[10] ? ( p[10] = 0; !vc_hold ? p[1] = 0; ); p += 16; );
);

// ---------- settings ----------
function vc_update() local(w, sv) (
  // a project saved before the MODE switch: slider2 / slider9 were the two units' own TOKYO / BERLIN keys. The mode
  // takes the style of the unit that is heard most (the one on; with both on, SV-81 from BALANCE 50 % up).
  slider9 < 1.5 ? (
    slider2 = (slider8 >= 0.5 && (slider1 < 0.5 || slider21 >= 50)) ? (slider9 >= 0.5) : (slider2 >= 0.5);
    slider9 = 2;
  );
  // KR-81
  vc_kon = slider1 >= 0.5; vc_kbt = slider2 >= 0.5;    // MODE: MATRIX = the European voicing
  w = min(max(slider3, 0), 100) / 100;
  vc_kqt = 10 * 0.26 ^ w;                               // the band's overall Q
  vc_ksht = 2 ^ min(max(slider4, -1), 1);
  vc_kdgt = 0.45 + 7.5 * (min(max(slider5, 0), 100) / 100) ^ 1.6;
  vc_khft = min(max(slider6, 0), 12);
  vc_kdit = min(max(slider7, 0), 100) / 100;
  // SV-81
  vc_von = slider8 >= 0.5; vc_vbt = vc_kbt;
  vc_svt = slider10 >= 0.5 ? 24 : 16;
  vc_srel = slider11 >= 0.5 ? 160 : 30;
  vc_srg = slider11 >= 0.5 ? 0.75 : 1;                  // SLOW holds the envelopes higher: level kept
  vc_ses = 1 - exp(-2 * $pi * (slider11 >= 0.5 ? 12 : 40) / srate);
  sv = min(max(slider12, 0), 100) / 100;
  vc_uvon = sv > 0.004;
  vc_uvr = 10 ^ (1.2 - 2.4 * sv);                       // high / low energy ratio threshold
  vc_uvz = 0.24 - 0.16 * sv;                            // zero-crossing rate threshold (per sample)
  vc_uvg = 10 ^ ((-50 - 20 * sv) / 10);                 // the high band must be above this (power)
  vc_stlt = min(max(slider13, -12), 12);
  // synth carrier
  vc_levt = 0.36 * 10 ^ (min(max(slider14, -24), 6) / 20);
  vc_tun = 2 ^ ((min(max(slider15, -12), 12) + 12 * floor(min(max(slider16, -2), 2) + 0.5)) / 12);
  vc_glon = slider17 >= 0.5;
  vc_glc = vc_glon ? 1 - exp(-1 / (slider17 * 0.001 * srate)) : 1;
  vc_wav = slider18 | 0;
  vc_src = slider19 >= 0.5;
  vc_hn = slider20 >= 0.5;
  vc_mch = slider31 | 0;
  // the bracket
  vc_balt = min(max(slider21, 0), 100) / 100;
  vc_mixt = min(max(slider22, 0), 100) / 100;
  drift_macro(slider23);
  vc_ogt = 10 ^ (slider24 / 20);
  ost_setup(slider25 / 100, slider26 / 100, slider27, slider28, slider29, 1);   // output stage: CLIP, always on
);

// ---------- presets ----------
function vc_setK(on, md, wd, sh, dr, hf, di) (           // (md: the MODE, 0 VFD / 1 MATRIX)
  slider1 = on; slider2 = md; slider3 = wd; slider4 = sh; slider5 = dr; slider6 = hf; slider7 = di;
);
function vc_setS(on, bn, rl, uv, tl) (
  slider8 = on; slider9 = 2; slider10 = bn; slider11 = rl; slider12 = uv; slider13 = tl;
);
function vc_setC(lv, tu, oc, gl, wv, src, hd) (
  slider14 = lv; slider15 = tu; slider16 = oc; slider17 = gl; slider18 = wv; slider19 = src; slider20 = hd;
);
function vc_setM(bal, mix, dr) (
  slider21 = bal; slider22 = mix; slider23 = dr;
  slider_automate(8388607);                             // sliders 1-23 (the output section stays)
);
function load_preset(p) (
  p == 1  ? ( vc_setK(1, 0, 50,  0,    25,  4,  0); vc_setS(1, 0, 0, 50,  0); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM( 50, 100,  50); ) : // Init
  p == 2  ? ( vc_setK(1, 1, 72,  0,    40,  6,  0); vc_setS(1, 0, 0, 40,  2); vc_setC(  0, 0, -1,   0, 1, 1, 0); vc_setM( 35, 100,  25); ) : // Robot Voice
  p == 3  ? ( vc_setK(1, 0, 38,  0,    10,  3,  0); vc_setS(1, 1, 1, 45, -2); vc_setC( -2, 0,  0,  60, 2, 1, 0); vc_setM( 70, 100,  45); ) : // Choir Pad (Synth)
  p == 4  ? ( vc_setK(1, 0, 35,  0,    15,  4,  0); vc_setS(1, 1, 1, 40,  1); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM( 60, 100,  40); ) : // Talking Strings
  p == 5  ? ( vc_setK(1, 1, 76,  0,    85,  8,  0); vc_setS(0, 0, 0, 50,  0); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM(  0, 100,  70); ) : // Labor Grit
  p == 6  ? ( vc_setK(0, 0, 50,  0,    25,  4,  0); vc_setS(1, 1, 0, 60,  2); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM(100, 100,  20); ) : // Broadcast Clear
  p == 7  ? ( vc_setK(1, 0, 30,  0,    10, 10,  0); vc_setS(1, 1, 0, 95,  6); vc_setC( -6, 0,  0,   0, 2, 1, 0); vc_setM( 65, 100,  40); ) : // Whisper Noise
  p == 8  ? ( vc_setK(1, 1, 50,  0.5,  20,  4,  0); vc_setS(1, 0, 0, 50,  0); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM( 15, 100,  50); ) : // Formant Up
  p == 9  ? ( vc_setK(1, 1, 45, -0.6,  30,  3,  0); vc_setS(1, 0, 0, 50,  0); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM( 15, 100,  50); ) : // Formant Down
  p == 10 ? ( vc_setK(1, 0, 60,  0.25, 20,  6,  0); vc_setS(1, 1, 1, 55,  3); vc_setC(  0, 0,  1, 250, 2, 1, 1); vc_setM( 50,  85, 100); ) : // Space Station
  p == 11 ? ( vc_setK(1, 1, 20,  0,    45,  2,  0); vc_setS(1, 0, 0, 20,  0); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM( 45, 100,  30); ) : // Drum Vocoder
  p == 12 ? ( vc_setK(1, 0, 55,  0,    30,  6, 10); vc_setS(1, 1, 0, 55,  2); vc_setC(  0, 0,  0,  60, 0, 1, 0); vc_setM( 50, 100,  40); ) : // Synth Solo
  p == 13 ? (                                           // Reset all to defaults
    vc_setK(1, 0, 50, 0, 25, 4, 0); vc_setS(1, 0, 0, 50, 0); vc_setC(0, 0, 0, 0, 0, 0, 0); vc_setM(50, 100, 50);
    slider24 = 0; slider25 = 0; slider26 = 30; slider27 = 120; slider28 = 6000; slider29 = -0.3; slider30 = 1;
    slider_automate(1073741823);                        // sliders 1-30
  );
);

// ---------- state ----------
// everything that depends on the sample rate (run again from @block if the rate changes)
function vc_srinit() (
  vc_fs = srate;
  vc_sm  = 1 - exp(-1 / (0.02 * srate));                // knob glides (per sample)
  vc_swc = 1 - exp(-1 / (0.01 * srate));                // ON / source / style fades
  vc_kea = 1 - exp(-1 / (0.0008 * srate));              // KR-81 attack
  vc_sea = 1 - exp(-1 / (0.002 * srate));               // SV-81 attack
  vc_xlc = 1 - exp(-2 * $pi * 120 / srate);             // transformer low band
  vc_atk = 1 - exp(-1 / (0.003 * srate));               // synth envelope
  vc_rel = 1 - exp(-1 / (0.09 * srate));
  vc_cea = 1 - exp(-1 / (0.005 * srate)); vc_cer = 1 - exp(-1 / (0.06 * srate));   // carrier level follower
  // V/UV detector
  vc_hp(3500, 0.7071); vc_u0 = vc_h0; vc_u1 = vc_h1; vc_u2 = vc_h2; vc_u3 = vc_h3; vc_u4 = vc_h4;
  vc_ulc = 1 - exp(-2 * $pi * 800 / srate);             // low band (one pole)
  vc_uhc = 1 - exp(-2 * $pi * 100 / srate);             // rumble out of the zero-crossing count
  vc_uec = 1 - exp(-1 / (0.008 * srate));               // energy integrators
  vc_uzc = 1 - exp(-1 / (0.006 * srate));               // zero-crossing rate
  vc_uua = 1 - exp(-1 / (0.0015 * srate)); vc_uur = 1 - exp(-1 / (0.025 * srate));
  vc_svn = 0;                                           // rebuild the SV-81 bank
  vc_xset(0.55); vc_kxt = vc_xtb; vc_kxs = vc_xsn; vc_xset(0.35); vc_sxt = vc_xtb; vc_sxs = vc_xsn;
);
vc_srinit();
vc_update();
vc_kq = vc_kqt * 0.6436; vc_ksm = vc_ksht; vc_kdg = vc_kdgt; vc_khf = vc_khft; vc_stl = vc_stlt;
vc_kdi = vc_kdit; vc_bal = vc_balt; vc_mix = vc_mixt; vc_og = vc_ogt; vc_lev = vc_levt; vc_pm = vc_tun;
vc_kw = vc_kon; vc_vw = vc_von; vc_srw = vc_src; vc_kbw = vc_kbt; vc_vbw = vc_vbt; vc_sxf = 1;
vc_bend = 1; vc_nheld = 0; vc_hold = 0; vc_age = 0; vc_linc = 0;
vc_kcal = 11.5; vc_scal = 7.2;                                   // output calibration of the two units
vc_kwd = 0.25; vc_swd = 0.4;                           // band spread (left / right alternation)
kxL.lo = kxR.lo = sxL.lo = sxR.lo = 0;
vcoL.ost_ch_init(); vcoR.ost_ch_init();
vca_uv = 0; vca_cpk = 0; vca_kpk = 0; vca_mpk = 0;
vc_rst = 1;                                             // the first block clears every band's state
vc_cen = vc_uv = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
vc_update();

@block
prs_chk();
srate != vc_fs ? vc_srinit();
vc_update();                                            // knobs moved on the panel do not run @slider
// block-rate glides for everything that sets coefficients
vc_bk = 1 - exp(-samplesblock / (0.03 * srate));
vc_kq  += (vc_kqt * 0.6436 - vc_kq) * vc_bk;
vc_ksm += (vc_ksht - vc_ksm) * vc_bk;
vc_kdg += (vc_kdgt - vc_kdg) * vc_bk;
vc_khf += (vc_khft - vc_khf) * vc_bk;
vc_stl += (vc_stlt - vc_stl) * vc_bk;
vc_kqn = vc_kq / (5.1 * 0.6436);                        // narrower bands pass less: level compensation
vc_kmk = 1 / vc_kdg ^ 0.75;                             // drive make-up
// DRIFT: filter-bank tolerance
vc_dinc = 0.25 * dm_s * samplesblock / srate;
vc_kdr = 0.02 * dm_a; vc_sdr = 0.003 * dm_a;
// the V/UV noise weights (SV-81 full, KR-81 lighter)
vc_snw = vc_uvon ? 0.3 : 0; vc_knw = vc_uvon ? 0.18 : 0;
// the SV-81 band count: fade out, rebuild, fade back in
vc_sclr = 0;
vc_svn != vc_svt && (vc_sxf < 0.001 || vc_svn == 0) ? ( vc_svn = vc_svt; vc_svtab(vc_svn); vc_sclr = 1; );
vc_sqn = vc_svn == 24 ? 3.41 / 5.24 : 1;                // 24 narrower bands: level compensation
// the bands
kr00.kr_blk(0);  kr01.kr_blk(1);  kr02.kr_blk(2);  kr03.kr_blk(3);  kr04.kr_blk(4);  kr05.kr_blk(5);
kr06.kr_blk(6);  kr07.kr_blk(7);  kr08.kr_blk(8);  kr09.kr_blk(9);  kr10.kr_blk(10); kr11.kr_blk(11);
kr12.kr_blk(12); kr13.kr_blk(13); kr14.kr_blk(14); kr15.kr_blk(15); kr16.kr_blk(16); kr17.kr_blk(17);
kr18.kr_blk(18); kr19.kr_blk(19); kr20.kr_blk(20); kr21.kr_blk(21); kr22.kr_blk(22); kr23.kr_blk(23);
krtp.tp_blk(9500, 18, vc_knw);
vc_KMB[24] = max(vc_KMB[24], krtp.e2 * 10 ^ (vc_khf / 20));
vc_kTg = vc_kcal * vc_kmk * 0.35 * 10 ^ (vc_khf / 20);     // the TOP band's gain
sv00.sv_blk(0);  sv01.sv_blk(1);  sv02.sv_blk(2);  sv03.sv_blk(3);  sv04.sv_blk(4);  sv05.sv_blk(5);
sv06.sv_blk(6);  sv07.sv_blk(7);  sv08.sv_blk(8);  sv09.sv_blk(9);  sv10.sv_blk(10); sv11.sv_blk(11);
sv12.sv_blk(12); sv13.sv_blk(13); sv14.sv_blk(14); sv15.sv_blk(15); sv16.sv_blk(16); sv17.sv_blk(17);
sv18.sv_blk(18); sv19.sv_blk(19); sv20.sv_blk(20); sv21.sv_blk(21); sv22.sv_blk(22); sv23.sv_blk(23);
svtp.tp_blk(9500, max(vc_srel * 0.6, 18), vc_snw);
vc_sclr || vc_rst ? svtp.tp_clr();
vc_rst ? ( krtp.tp_clr(); vc_rst = 0; );
vc_SMB[vc_svn] = max(vc_SMB[vc_svn], svtp.e2 * 10 ^ (vc_stl / 20));
vc_sTg = vc_scal * 2.2 * 10 ^ (vc_stl / 20);
// denormal housekeeping
abs(vc_uz1) < 0.000000000001 ? vc_uz1 = 0; abs(vc_uz2) < 0.000000000001 ? vc_uz2 = 0;
vc_ueh < 0.0000000000000001 ? vc_ueh = 0; vc_uel < 0.0000000000000001 ? vc_uel = 0;
abs(vc_ulp) < 0.000000000001 ? vc_ulp = 0; abs(vc_uzl) < 0.000000000001 ? vc_uzl = 0;
vc_uv < 0.000001 ? vc_uv = 0; vc_cen < 0.000000000001 ? vc_cen = 0;
abs(kxL.lo) < 0.000000000001 ? kxL.lo = 0; abs(kxR.lo) < 0.000000000001 ? kxR.lo = 0;
abs(sxL.lo) < 0.000000000001 ? sxL.lo = 0; abs(sxR.lo) < 0.000000000001 ? sxR.lo = 0;

// the panel's DRIVE lamp: how hard the carrier bands push the op-amps
vca_kpk = max(vca_kpk, vc_kon * vc_cen * vc_kdg * 0.8);

// ---------- MIDI: notes into the queue (sample-accurate), everything passed on ----------
vc_qn = 0;
while (midirecv(vc_mo, vc_m1, vc_m2, vc_m3)) (
  vc_st = vc_m1 & 0xF0;
  (vc_mch == 0 || (vc_m1 & 0x0F) + 1 == vc_mch) && vc_qn < 256 ? (
    vc_ty = vc_st == 0x90 ? (vc_m3 > 0 ? 1 : 0) : vc_st == 0x80 ? 0 :
            vc_st == 0xB0 && (vc_m2 == 120 || vc_m2 == 123) ? 2 : vc_st == 0xE0 ? 3 : -1;
    vc_ty >= 0 ? ( vc_MQ[vc_qn * 4] = vc_mo; vc_MQ[vc_qn * 4 + 1] = vc_ty; vc_MQ[vc_qn * 4 + 2] = vc_m2; vc_MQ[vc_qn * 4 + 3] = vc_m3; vc_qn += 1; );
  );
  midisend(vc_mo, vc_m1, vc_m2, vc_m3);
);
vc_qr = 0; vc_spos = 0;
// HOLD switched off: let go of the notes whose keys are up
vc_hold && !vc_hn ? ( vc_p = vc_VO; loop(8, vc_p[1] && !vc_p[10] ? vc_p[1] = 0; vc_p += 16; ); );
vc_hold = vc_hn;
// voices still sounding
vc_nv = 0; vc_p = vc_VO; loop(8, vc_p[0] >= 0 ? vc_nv += 1; vc_p += 16; );
vc_vact = vc_nv > 0;
vca_nv = vc_nv;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
vc_ml = spl0; vc_mr = spl1;
// ---------- MIDI events due now ----------
while (vc_qr < vc_qn && (vc_MQ[vc_qr * 4] <= vc_spos || vc_spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  vc_ty = vc_MQ[vc_qr * 4 + 1];
  vc_ty == 1 ? vc_non(vc_MQ[vc_qr * 4 + 2], vc_MQ[vc_qr * 4 + 3]) :
  vc_ty == 0 ? vc_noff(vc_MQ[vc_qr * 4 + 2]) :
  vc_ty == 2 ? vc_all_off() :
  vc_bend = 2 ^ ((((vc_MQ[vc_qr * 4 + 3] * 128 + vc_MQ[vc_qr * 4 + 2]) - 8192) / 8192) * 2 / 12);
  vc_qr += 1;
);
vc_spos += 1;
// ---------- glides ----------
vc_kdi += (vc_kdit - vc_kdi) * vc_sm;
vc_bal += (vc_balt - vc_bal) * vc_sm;
vc_mix += (vc_mixt - vc_mix) * vc_sm;
vc_og  += (vc_ogt - vc_og) * vc_sm;
vc_lev += (vc_levt - vc_lev) * vc_sm;
vc_pm  += (vc_tun * vc_bend - vc_pm) * vc_sm;
vc_kw  += (vc_kon - vc_kw) * vc_swc;
vc_vw  += (vc_von - vc_vw) * vc_swc;
vc_srw += (vc_src - vc_srw) * vc_swc;
vc_kbw += (vc_kbt - vc_kbw) * vc_swc;
vc_vbw += (vc_vbt - vc_vbw) * vc_swc;
vc_sxf += ((vc_svn == vc_svt) - vc_sxf) * vc_swc;

// ---------- the modulator (mono analysis) ----------
vc_m = 0.5 * (vc_ml + vc_mr);
vca_mpk = max(vca_mpk, abs(vc_m));

// ---------- the carrier ----------
vc_syn = 0;
vc_vact && vc_srw > 0.0001 ? (
  vc_ve = 0; vc_p = vc_VO;
  loop(8,
    vc_p[0] >= 0 ? (
      vc_p[2] += (vc_p[1] - vc_p[2]) * (vc_p[1] ? vc_atk : vc_rel);
      vc_p[3] += (vc_p[4] - vc_p[3]) * vc_glc;
      vc_dt = min(vc_p[3] * vc_pm, 0.45);
      vc_ph = vc_p[5] + vc_dt; vc_ph -= floor(vc_ph); vc_p[5] = vc_ph;
      vc_o = 2 * vc_ph - 1 - vc_blep(vc_ph, vc_dt);
      vc_wav == 1 ? (                                   // PULSE (35 %): the difference of two saws
        vc_q = vc_ph + 0.65; vc_q -= floor(vc_q);
        vc_o = 0.62 * (vc_o - (2 * vc_q - 1 - vc_blep(vc_q, vc_dt)));
      ) : vc_wav == 2 ? (                               // SUPER: three saws, +/-12 cents
        vc_d2 = vc_dt * 1.006956; vc_q = vc_p[6] + vc_d2; vc_q -= floor(vc_q); vc_p[6] = vc_q;
        vc_o += 0.75 * (2 * vc_q - 1 - vc_blep(vc_q, vc_d2));
        vc_d2 = vc_dt * 0.993092; vc_q = vc_p[7] + vc_d2; vc_q -= floor(vc_q); vc_p[7] = vc_q;
        vc_o += 0.75 * (2 * vc_q - 1 - vc_blep(vc_q, vc_d2));
        vc_o *= 0.5;
      );
      vc_syn += vc_o * vc_p[2] * vc_p[9];
      vc_ve += vc_p[2];
      !vc_p[1] && vc_p[2] < 0.00002 ? ( vc_p[0] = -1; vc_p[2] = 0; );
    );
    vc_p += 16;
  );
  vc_syn = (vc_syn + 0.05 * vc_ve * (rand(2) - 1)) * vc_lev;   // with a breath of noise
);
vc_c = 0.5 * (spl2 + spl3);
vc_srw > 0.9999 ? vc_c = vc_syn : vc_srw > 0.0001 ? vc_c += (vc_syn - vc_c) * vc_srw;
vc_ca = abs(vc_c);
vc_cen += (vc_ca - vc_cen) * (vc_ca > vc_cen ? vc_cea : vc_cer);
vca_cpk = max(vca_cpk, vc_ca);

// ---------- the V/UV detector ----------
vc_uh = vc_u0 * vc_m + vc_uz1; vc_uz1 = vc_u1 * vc_m - vc_u3 * vc_uh + vc_uz2; vc_uz2 = vc_u2 * vc_m - vc_u4 * vc_uh;
vc_ulp += (vc_m - vc_ulp) * vc_ulc;
vc_ueh += (vc_uh * vc_uh - vc_ueh) * vc_uec;
vc_uel += (vc_ulp * vc_ulp - vc_uel) * vc_uec;
vc_uzl += (vc_m - vc_uzl) * vc_uhc;
vc_us = vc_m - vc_uzl >= 0;
vc_uzr += ((vc_us != vc_uzs) - vc_uzr) * vc_uzc; vc_uzs = vc_us;
vc_ut = vc_uvon && vc_ueh > vc_uvr * vc_uel && vc_uzr > vc_uvz && vc_ueh > vc_uvg;
vc_uv += (vc_ut - vc_uv) * (vc_ut > vc_uv ? vc_uua : vc_uur);
vca_uv = max(vca_uv, vc_uv);
vc_nz = vc_uv > 0.0001 ? (rand(2) - 1) * vc_uv * vc_cen * 0.7 : 0;

// ---------- KR-81 ----------
vc_kl = vc_kr = 0;
vc_kw > 0.00001 ? (
  kr00.kr_band(vc_m, vc_c); kr01.kr_band(vc_m, vc_c); kr02.kr_band(vc_m, vc_c); kr03.kr_band(vc_m, vc_c);
  kr04.kr_band(vc_m, vc_c); kr05.kr_band(vc_m, vc_c); kr06.kr_band(vc_m, vc_c); kr07.kr_band(vc_m, vc_c);
  kr08.kr_band(vc_m, vc_c); kr09.kr_band(vc_m, vc_c); kr10.kr_band(vc_m, vc_c); kr11.kr_band(vc_m, vc_c);
  kr12.kr_band(vc_m, vc_c); kr13.kr_band(vc_m, vc_c); kr14.kr_band(vc_m, vc_c); kr15.kr_band(vc_m, vc_c);
  kr16.kr_band(vc_m, vc_c); kr17.kr_band(vc_m, vc_c); kr18.kr_band(vc_m, vc_c); kr19.kr_band(vc_m, vc_c);
  kr20.kr_band(vc_m, vc_c); kr21.kr_band(vc_m, vc_c); kr22.kr_band(vc_m, vc_c); kr23.kr_band(vc_m, vc_c);
  vc_v = krtp.tp_band(vc_m, vc_c) * vc_kTg; vc_kl += vc_v; vc_kr += vc_v;
  vc_kbw > 0.0001 ? (
    vc_kl += (kxL.vc_xfm(vc_kl, 1.6, 0.55, vc_kxt, vc_kxs) - vc_kl) * vc_kbw;
    vc_kr += (kxR.vc_xfm(vc_kr, 1.6, 0.55, vc_kxt, vc_kxs) - vc_kr) * vc_kbw;
  );
  vc_kl += vc_ml * vc_kdi; vc_kr += vc_mr * vc_kdi;
);

// ---------- SV-81 ----------
vc_sl = vc_sr = 0;
vc_vw > 0.00001 ? (
  sv00.sv_band(vc_m, vc_c); sv01.sv_band(vc_m, vc_c); sv02.sv_band(vc_m, vc_c); sv03.sv_band(vc_m, vc_c);
  sv04.sv_band(vc_m, vc_c); sv05.sv_band(vc_m, vc_c); sv06.sv_band(vc_m, vc_c); sv07.sv_band(vc_m, vc_c);
  sv08.sv_band(vc_m, vc_c); sv09.sv_band(vc_m, vc_c); sv10.sv_band(vc_m, vc_c); sv11.sv_band(vc_m, vc_c);
  sv12.sv_band(vc_m, vc_c); sv13.sv_band(vc_m, vc_c); sv14.sv_band(vc_m, vc_c); sv15.sv_band(vc_m, vc_c);
  vc_svn == 24 ? (
    sv16.sv_band(vc_m, vc_c); sv17.sv_band(vc_m, vc_c); sv18.sv_band(vc_m, vc_c); sv19.sv_band(vc_m, vc_c);
    sv20.sv_band(vc_m, vc_c); sv21.sv_band(vc_m, vc_c); sv22.sv_band(vc_m, vc_c); sv23.sv_band(vc_m, vc_c);
  );
  vc_v = svtp.tp_band(vc_m, vc_c) * vc_sTg; vc_sl += vc_v; vc_sr += vc_v;
  vc_sl *= vc_sxf; vc_sr *= vc_sxf;
  vc_vbw > 0.0001 ? (
    vc_sl += (sxL.vc_xfm(vc_sl, 1.0, 0.35, vc_sxt, vc_sxs) - vc_sl) * vc_vbw;
    vc_sr += (sxR.vc_xfm(vc_sr, 1.0, 0.35, vc_sxt, vc_sxs) - vc_sr) * vc_vbw;
  );
);

// ---------- BALANCE, MIX, OUTPUT and the house output stage ----------
vc_wk = vc_kw * (1 - vc_bal * vc_vw); vc_ws = vc_vw * (1 - (1 - vc_bal) * vc_kw);   // one unit on: it takes it all
vc_wn = 1 / max(vc_wk + vc_ws, 0.5);
vc_a = max(vc_kw, vc_vw) * vc_mix;
vc_ol = vc_ml + ((vc_wk * vc_kl + vc_ws * vc_sl) * vc_wn - vc_ml) * vc_a;
vc_or = vc_mr + ((vc_wk * vc_kr + vc_ws * vc_sr) * vc_wn - vc_mr) * vc_a;
vc_ol = vcoL.ost_band(vc_ol) * vc_og;
vc_or = vcoR.ost_band(vc_or) * vc_og;
ost_out(vc_ol, vc_or);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;      // nothing below -400 dB reaches the host
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;

@gfx 1000 340
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1000, 340);

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');          // title
gfx_setfont(10, "Trebuchet MS", 12.5 * sc, 'b');        // scale numbers
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');          // labels
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');          // key captions
gfx_setfont(14, "Trebuchet MS", 14 * sc, 'b');          // knob names
gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');          // model numbers
gfx_setfont(16, "Trebuchet MS", 12 * sc, 'b');          // display print

function vg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function vg_fr(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc, 0); );
function vg_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function vg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function vg_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function vg_ltxt(lx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = lx * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function vg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// the MODE (slider2) sets the faces, the voices and the labels: VFD English, MATRIX German
vg_md = slider2 >= 0.5;
vg_de = 0;   // English labels in both modes
// DE prints decimal commas
function vg_dec(s) local(i) ( vg_de ? ( i = 0; loop(strlen(s), str_getchar(s, i) == '.' ? str_setchar(s, i, ','); i += 1; ); ); s; );

// =====================================================================
// The unit faces: u = 0 KR-81 / 1 SV-81, b = MATRIX (vg_u = 0 with vg_b = 1 is the bracket's cream enamel keys)
// =====================================================================
function vg_style(u, b) (
  vg_u = u; vg_b = b;
  b ? (                                                 // MATRIX: battleship grey, black linework, mustard lamps
    vg_u = 1;
    vqF = 0x222528; vqS = ui_mix(vqF, 0x000000, 0.28);
    vqI = 0xC7BEB3; vqI2 = ui_mix(0xC7BEB3, vqF, 0.38); vqA = 0xD4A373; vqL = 0x0B0C0D; vqHI = 0xD4A373;
    vqD = 0xD4A373; vqW = 0x0E0F10; vqG = 0x2C302E; vqLW = 2;
  ) : (                                                 // VFD: charcoal slate, VFD glow (KR-81 amber, SV-81 turquoise)
    vqF = 0x181A1B; vqS = 0x131516;
    vqI = 0xD5DCDE; vqI2 = 0x7D888C; vqA = u == 0 ? 0xFF8C00 : 0x4EE1DC; vqL = 0x2E3235; vqHI = vqA;
    vqD = vqA; vqW = 0x070808; vqG = ui_mix(vqA, 0x070808, 0.92); vqLW = 1;
  );
);

// a section on the face: MATRIX a sharp face with its frame, VFD a shallow recess
function vg_sect(x, y, w, h) (
  vg_b ? (
    ui_col(vqL); vg_r(x, y, w, h);
    ui_col(vqS); vg_r(x + vqLW, y + vqLW, w - 2 * vqLW, h - 2 * vqLW);
  ) : (
    pk_inset((x + 3) * sc, (y + 3) * sc, (w - 6) * sc, (h - 6) * sc, vqS);
  );
);

// a lit key; returns 1 when clicked. MATRIX: mustard block keys (the bracket: cream enamel, orange when lit);
// VFD: rubberised keys that light up in the display colour
function vg_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = vg_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  vg_b ? (
    vg_u == 0 ? (
      ui_col(vqL); vg_r(x, y, w, h);
      on ? ui_col(vqA) : ui_col(hov ? 0xF1EEE5 : ui_mix(vqF, 0xFFFFFF, 0.35)); vg_r(x + 2, y + 2, w - 4, h - 4);
      on ? ( ui_cola(0xFFFFFF, 0.28); vg_r(x + 2, y + 2, w - 4, 1); );
      ui_col(vqI);
    ) : (
      on ? ( ui_cola(vqA, 0.22); vg_r(x - 3, y - 3, w + 6, h + 6); );
      ui_col(0x0B0C0D); vg_r(x, y, w, h);
      on ? ui_col(vqA) : ui_col(hov ? 0x353A37 : 0x2C302E); vg_r(x + 1.5, y + 1.5, w - 3, h - 4);
      ui_cola(0xFFFFFF, on ? 0.3 : 0.08); vg_r(x + 1.5, y + 1.5, w - 3, 1);
      on ? ui_col(0x17191B) : ui_col(vqI);
    );
  ) : (
    ui_cola(0x000000, 0.55); rd_rr((x + 0.5) * sc, (y + 2) * sc, w * sc, h * sc, 5 * sc);
    on ? ( ui_cola(vqA, 0.18); rd_rr((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 7 * sc); );
    ui_col(0x0A0B0C); rd_rr(x * sc, y * sc, w * sc, h * sc, 5 * sc);
    on ? ui_col(ui_mix(vqA, 0x000000, 0.12)) : ui_col(hov ? 0x34383B : 0x2A2D30);
    rd_rr((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, 4 * sc);
    on ? ui_col(0x0B0C0D) : ui_col(0xB4BDC0);
  );
  gfx_setfont(12); vg_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);

// a status lamp (x, y = centre)
function vg_lamp(x, y, r, on, col) (
  vg_b && vg_u == 0 ? (
    ui_col(0x141414); gfx_circle(x * sc, y * sc, (r + 2.5) * sc, 1, 1);
    ui_col(0x8A867A); gfx_circle(x * sc, y * sc, (r + 1) * sc, 1, 1);
    rd_lamp(x, y, r, on, col);
  ) : (
    on > 0.05 ? ( ui_cola(col, 0.25 * on); gfx_circle(x * sc, y * sc, (r + 4) * sc, 1, 1); );
    ui_col(0x050606); gfx_circle(x * sc, y * sc, (r + 1.2) * sc, 1, 1);
    ui_col(ui_mix(ui_mix(col, 0x000000, 0.8), col, min(max(on, 0), 1))); gfx_circle(x * sc, y * sc, r * sc, 1, 1);
    on > 0.5 ? ( ui_cola(0xFFFFFF, 0.6); gfx_circle((x - r * 0.3) * sc, (y - r * 0.3) * sc, r * 0.3 * sc, 1, 1); );
  );
);

// a display window: MATRIX black glass in a black bezel, VFD smoked VFD glass
function vg_glass(x, y, w, h) (
  vg_b ? (
    ui_col(vqL); vg_r(x - 2, y - 2, w + 4, h + 4);
    ui_col(vqW); vg_r(x, y, w, h);
    ui_cola(0xFFFFFF, 0.05); vg_r(x, y, w, h * 0.4);
  ) : (
    ui_col(0x2E3235); vg_r(x - 1, y - 1, w + 2, h + 2);
    ui_col(vqW); vg_r(x, y, w, h);
    ui_cola(vqA, 0.035); vg_r(x, y, w, h);
    ui_cola(0xFFFFFF, 0.04); vg_r(x, y, w, 1);
  );
);

// the band activity ladders: n thin bars of nseg segments, levels 0..1 in arr. MATRIX: green / mustard / rust
// LED blocks; VFD: VFD segments with their ghosts.
function vg_ladder(x, y, w, h, n, arr, nseg, on) local(i, j, bw, bx, q, sh, sy, p, lit, c, gp) (
  bw = w / n; sh = h / nseg; gp = bw > 9 ? 3 : 2;
  i = 0;
  loop(n,
    bx = x + i * bw; q = on ? arr[i] : 0;
    j = 0;
    loop(nseg,
      p = (j + 0.5) / nseg; lit = q >= p; sy = y + h - (j + 1) * sh;
      vg_b ? (
        c = vg_u == 0 ? ( p >= 0.9 ? 0xFF3A2A : p >= 0.72 ? 0xFFB030 : 0x46D86A ) : ( p >= 0.9 ? 0xBC3908 : p >= 0.72 ? 0xD4A373 : 0x2E7A48 );
        lit ? (
          ui_cola(c, 0.18); vg_r(bx + gp * 0.5 - 0.8, sy - 0.3, bw - gp + 1.6, sh + 0.2);
          ui_col(c); vg_r(bx + gp * 0.5, sy + 0.5, bw - gp, sh - 1.4);
          ui_cola(0xFFFFFF, 0.25); vg_r(bx + gp * 0.5, sy + 0.5, bw - gp, 1);
        ) : ( ui_col(ui_mix(c, 0x000000, 0.8)); vg_r(bx + gp * 0.5, sy + 0.5, bw - gp, sh - 1.4); );
      ) : (
        c = p >= 0.9 ? (vg_u == 0 ? 0xFF4A2A : 0xFF8C00) : vqD;
        lit ? (
          ui_cola(c, 0.2); vg_r(bx + gp * 0.5 - 1, sy - 0.2, bw - gp + 2, sh);
          ui_col(c); vg_r(bx + gp * 0.5, sy + 0.5, bw - gp, sh - 1.4);
        ) : ( ui_col(ui_mix(c, 0x070808, 0.9)); vg_r(bx + gp * 0.5, sy + 0.5, bw - gp, sh - 1.4); );
      );
      j += 1;
    );
    i += 1;
  );
);

// ---------- knobs ----------
// kind: 0 linear, 1 stepped (st = the step), 2 square law (GLIDE)
function vg_v2n(kind, v, lo, hi) ( kind == 2 ? sqrt(max(v - lo, 0) / (hi - lo)) : (v - lo) / (hi - lo); );
function vg_n2v(kind, n, lo, hi) ( n = min(max(n, 0), 1); kind == 2 ? lo + (hi - lo) * n * n : lo + (hi - lo) * n; );
// a printed tick and its number at n (0..1) round a knob
function vg_tick(cx, cy, r, n, s, big) local(a, ca, sa) (
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  vg_b ? (                                              // (VFD: the knob's own value ring takes the place of the ticks)
    ui_col(vqI2);
    gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + (big ? 8 : 6))) * sc, (cy + sa * (r + (big ? 8 : 6))) * sc, 1);
    big ? gfx_line((cx + ca * (r + 4)) * sc + 1, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 8)) * sc + 1, (cy + sa * (r + 8)) * sc, 1);
  );
  strlen(s) ? ( gfx_setfont(10); ui_col(vqI); vg_ctxt(cx + ca * (r + 14), cy + sa * (r + 13), s); );
);
// numbers from a list "a|b|c", evenly spread
function vg_scale(cx, cy, r, labels) local(i, k, k0, len, c, n) (
  len = strlen(labels); n = 1; k = 0; loop(len, str_getchar(labels, k) == 124 ? n += 1; k += 1; );
  k0 = 0; i = 0; k = 0;
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? ( strcpy_substr(#vg_sl, labels, k0, k - k0); vg_tick(cx, cy, r, i / max(n - 1, 1), #vg_sl, 1); i += 1; k0 = k + 1; );
    k += 1;
  );
);
function vg_ticks(cx, cy, r) local(i) ( i = 0; loop(11, vg_tick(cx, cy, r, i / 10, "", i == 0 || i == 5 || i == 10); i += 1; ); );
// a smooth thick arc (pixels): anti-aliased arcs every half pixel
function vg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
// a straight pointer line, w pixels wide (pixel coordinates)
function vg_ptr(cx, cy, a, r1, r2, w) local(ca, sa, k) (
  ca = sin(a); sa = -cos(a); k = -w * 0.5;
  loop(max(1, floor(w * 2) + 1), gfx_line(cx + ca * r1 - sa * k, cy + sa * r1 + ca * k, cx + ca * r2 - sa * k, cy + sa * r2 + ca * k, 1); k += 0.5; );
);
// VFD knob: a smooth black rubber body with one soft highlight, a thin track with the value arc glowing in the
// display colour
function vg_tcap(cx, cy, r, n) local(rr, a, a0) (
  a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; rr = r + 5 * sc;
  ui_col(0x2A2E30); vg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  n > 0.004 ? (
    ui_col(ui_mix(vqA, vqS, 0.78)); vg_arcw(cx, cy, rr, a0, a, 5 * sc);
    ui_col(vqA); vg_arcw(cx, cy, rr, a0, a, 2.2 * sc);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, 1.1 * sc, 1, 1); gfx_circle(cx + sin(a) * rr, cy - cos(a) * rr, 1.1 * sc, 1, 1);
  );
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 3 * sc, r, 1, 1);
  ui_col(0x090A0B); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0x1B1E20); gfx_circle(cx, cy, r - 1.5 * sc, 1, 1);
  ui_col(0x34383B); vg_arcw(cx, cy, r - 2.5 * sc, -0.66 * $pi, 0.06 * $pi, 1.2 * sc);
  ui_col(ui_mix(vqA, 0xFFFFFF, 0.35)); vg_ptr(cx, cy, a, r * 0.3, r - 4 * sc, 2 * sc);
);
// MATRIX knob: a plain dark skirt, a flat satin-silver face with one soft highlight on its edge, a black pointer
function vg_bcap(cx, cy, r, a) (
  ui_cola(0x000000, 0.35); gfx_circle(cx + 1.5 * sc, cy + 3 * sc, r, 1, 1);
  ui_col(0x1A1B1E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0x5B6168); gfx_circle(cx, cy, r * 0.8, 1, 1);
  ui_col(0xB7BCC2); gfx_circle(cx, cy, r * 0.8 - 1.2 * sc, 1, 1);
  ui_col(0xDCDFE3); vg_arcw(cx, cy, r * 0.8 - 2.6 * sc, -0.66 * $pi, 0.06 * $pi, 1.3 * sc);
  ui_col(0x141416); vg_ptr(cx, cy, a, r * 0.2, r * 0.95, 2 * sc);
);
// a knob: cap 0 = the unit's main knob (VFD rubber / MATRIX cast aluminium), otherwise a small house knob with that
// cap colour. Its name below; the value replaces it while touched.
function vg_knob(cx, cy, r, idx, kind, lo, hi, def, st, cap, name, val) local(v, n, dx, dy, hov, did, ns, a) (
  did = 1900 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  ns = kind == 1 ? floor((hi - lo) / st + 0.5) : 0;
  pressed && hov && drag_id == 0 ? (
    time_precise() - vg_lt < 0.35 && vg_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; vg_lt = 0; ) : (
      drag_id = did; vg_my = mouse_y; vg_lt = time_precise(); vg_lid = idx; vg_n = vg_v2n(kind, v, lo, hi);
    );
  );
  drag_id == did ? (
    vg_n = min(max(vg_n + (vg_my - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); vg_my = mouse_y;
    v = kind == 1 ? lo + floor(vg_n * ns + 0.5) * st : vg_n2v(kind, vg_n, lo, hi);
    kind != 1 ? v = floor(v / st + 0.5) * st;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    kind == 1 ? ( v = min(max(v + sign(mouse_wheel) * st, lo), hi); ) : (
      n = min(max(vg_v2n(kind, v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
      v = floor(vg_n2v(kind, n, lo, hi) / st + 0.5) * st;
    );
    slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = vg_v2n(kind, v, lo, hi); a = -0.75 * $pi + n * 1.5 * $pi;
  cap == 0 ? (
    vg_b ? vg_bcap(cx * sc, cy * sc, r * sc, a) : vg_tcap(cx * sc, cy * sc, r * sc, n);
  ) : dy_fcap(cx * sc, cy * sc, r * sc, a, cap);
  vg_act = hov || drag_id == did;
  vg_act ? ( ui_cola(0xFFFFFF, 0.08); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1); );
  gfx_setfont(cap == 0 ? 14 : 11);
  ui_col(vg_act ? vqHI : vqI);
  vg_ctxt(cx, cy + r + (cap == 0 ? 18 : 14), vg_act ? val : name);
);

// =====================================================================
// A half-rack unit: case, corner screws, model plate, the voicing in print and the ON key
// =====================================================================
function vg_unit(x, y, w, h, model, s1, s2, oidx) local(tw, th) (
  ui_cola(0x000000, 0.45); vg_r(x + 2, y + 4, w, h);
  ui_col(vg_b ? vqL : 0x050606); vg_r(x, y, w, h);
  ui_col(vqF); vg_r(x + vqLW, y + vqLW, w - 2 * vqLW, h - 2 * vqLW);
  !vg_b ? ( ui_cola(0xFFFFFF, 0.06); vg_r(x + 1, y + 1, w - 2, 1); gfx_gradrect((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, 40 * sc, 1, 1, 1, 0.03, 0, 0, 0, 0, 0, 0, 0, -0.03 / (40 * sc)); );
  rd_screw(x + 11, y + 11); rd_screw(x + w - 11, y + 11); rd_screw(x + 11, y + h - 11); rd_screw(x + w - 11, y + h - 11);
  // model plate
  gfx_setfont(15); ui_col(vqI); vg_txt(x + 24, y + 8, model);
  gfx_measurestr(model, tw, th);
  vg_b ? ( ui_col(vqA); vg_r(x + 24, y + 40, tw / sc, 3); ) : ( ui_col(vqA); vg_r(x + 24, y + 41, tw / sc, 2); ui_cola(vqA, 0.25); vg_r(x + 24, y + 40, tw / sc, 4); );
  gfx_setfont(11); ui_col(vqI2); vg_txt(x + 32 + tw / sc, y + 11, s1); vg_txt(x + 32 + tw / sc, y + 26, s2);
  // the voicing (set by the MODE) and ON
  gfx_setfont(11); ui_col(vqI2); vg_rtxt(x + w - 66, y + 16, "OUTPUT"); vg_rtxt(x + w - 66, y + 31, vg_b ? "TRANSFORMER" : "CLEAN");
  vg_key(x + w - 56, y + 10, 42, 26, vg_de ? "EIN" : "ON", slider(oidx) >= 0.5) ? ( slider(oidx) = slider(oidx) >= 0.5 ? 0 : 1; ui_auto(oidx); );
);

// =====================================================================
// Panel and header
// =====================================================================
vqH = 0x2A2D30; vqHW = 0xEEEFEA;
ui_col(0x1D1F21); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(vqH); vg_r(0, 0, 1000, 54);
ui_cola(0xFFFFFF, 0.06); vg_r(0, 0, 1000, 1);
ui_col(0x111213); vg_r(0, 54, 1000, 2);
ui_col(vqHW); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(vqH); ui_text(31 * sc, 21.5 * sc, "GFX");
gfx_setfont(6); ui_col(vqHW); vg_txt(58, 12, "VC81"); ver_tag("v2", 13, 0, 0);
gfx_setfont(11); ui_col(0xA99999); vg_txt(252, 14, vg_de ? "DOPPEL-HALBRACK" : "DUAL HALF-RACK"); vg_txt(252, 29, vg_de ? "VOCODER-SYSTEM" : "VOCODER SYSTEM");
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
vg_k = pk_preset(388 * sc, 10 * sc, 380 * sc, 34 * sc, pr_cur,
  "Init|Robot Voice|Choir Pad (Synth)|Talking Strings|Labor Grit|Broadcast Clear|Whisper Noise|Formant Up|Formant Down|Space Station|Drum Vocoder|Synth Solo");
vg_k > 0 ? ( prs_dirty = vg_k; pr_cur = vg_k > 12 ? 1 : vg_k; );
// MODE: the two lit model keys (VFD = the Japanese voicing, MATRIX = the European one), in the mode's own keys
vg_style(1, vg_md);
vg_key(780, 14, 54, 26, "VFD", !vg_md) ? ( slider2 = 0; ui_auto(2); );
vg_key(840, 14, 76, 26, "MATRIX", vg_md) ? ( slider2 = 1; ui_auto(2); );
ui_size_picker(932 * sc, 18 * sc);

// ---------- meter smoothing (frame-rate independent) ----------
vg_now = time_precise();
vg_dt = vg_t0 > 0 ? min(max(vg_now - vg_t0, 0), 0.25) : 1; vg_t0 = vg_now;
vg_i = 0;
loop(25,
  vg_q = (20 * log10(max(vc_KMB[vg_i] * 4, 0.000001)) + 48) / 48; vc_KMB[vg_i] = 0;
  vg_LK[vg_i] = max(vg_q, vg_LK[vg_i] - 1.6 * vg_dt);
  vg_q = (20 * log10(max(vc_SMB[vg_i] * 4, 0.000001)) + 48) / 48; vc_SMB[vg_i] = 0;
  vg_LS[vg_i] = max(vg_q, vg_LS[vg_i] - (slider11 >= 0.5 ? 0.8 : 1.6) * vg_dt);
  vg_i += 1;
);
vg_uv = max(vca_uv, vg_uv - 6 * vg_dt); vca_uv = 0;
vg_kp = max(vca_kpk, vg_kp * (1 - min(4 * vg_dt, 1))); vca_kpk = 0;
vg_cp = max(vca_cpk, vg_cp * (1 - min(3 * vg_dt, 1))); vca_cpk = 0;
vc_mhit != vg_mh ? ( vg_mh = vc_mhit; vg_mt = vg_now; );

// =====================================================================
// LEFT UNIT: KR-81 labour vocoder (x 8..440)
// =====================================================================
vg_style(0, vg_md);
vg_x = 8;
vg_unit(vg_x, 60, 432, 272, "KR-81", vg_de ? "LABOR-VOCODER" : "LAB VOCODER", vg_de ? "24 KANÄLE" : "24 CHANNELS", 1);
vg_on = slider1 >= 0.5;
// ---------- the band ladders ----------
vg_sect(vg_x + 12, 108, 408, 96);
vg_glass(vg_x + 20, 115, 392, 82);
vg_ladder(vg_x + 28, 121, 325, 52, 25, vg_LK, 11, vg_on);
gfx_setfont(10); ui_col(vg_b ? ui_mix(vqD, vqW, 0.3) : vqI2);
vg_i = 0;
loop(8,
  vg_f = vg_i == 0 ? 0 : vg_i == 1 ? 5.0 : vg_i == 2 ? 8.4 : vg_i == 3 ? 12.1 : vg_i == 4 ? 15.8 : vg_i == 5 ? 19.4 : vg_i == 6 ? 22.6 : 24.4;
  vg_ctxt(vg_x + 28 + (vg_f + 0.5) * 13, 185, vg_i == 0 ? "100" : vg_i == 1 ? "250" : vg_i == 2 ? "500" : vg_i == 3 ? "1k" : vg_i == 4 ? "2k" : vg_i == 5 ? "4k" : vg_i == 6 ? "8k" : "HF");
  vg_i += 1;
);
// lamps: V/UV noise and DRIVE (the op-amps clipping)
vg_lamp(vg_x + 372, 135, 4.5, vg_on * min(vg_uv * 2, 1), vqD);
gfx_setfont(16); ui_col(vg_b ? vqD : vqI2); vg_ltxt(vg_x + 382, 135, "UV");
vg_lamp(vg_x + 372, 165, 4.5, vg_on * min(max((vg_kp - 1) * 1.5, 0), 1), 0xFF3A2A);
gfx_setfont(16); ui_col(vg_b ? vqD : vqI2); vg_ltxt(vg_x + 382, 165, vg_de ? "SÄTT" : "SAT");

// ---------- the knob row ----------
vg_sect(vg_x + 12, 210, 408, 104);
vg_cy = 256; vg_kr = 23;
sprintf(#vgv, "%.0f %%  Q %.1f", slider3, 10 * 0.26 ^ (slider3 / 100)); vg_dec(#vgv);
vg_scale(vg_x + 58, vg_cy, vg_kr, "0||5||10");
vg_knob(vg_x + 58, vg_cy, vg_kr, 3, 0, 0, 100, 50, 1, 0, vg_de ? "BREITE" : "WIDTH", #vgv);
sprintf(#vgv, vg_de ? "%+.2f Okt." : "%+.2f oct", slider4); vg_dec(#vgv);
vg_scale(vg_x + 136, vg_cy, vg_kr, "-1||0||+1");
vg_knob(vg_x + 136, vg_cy, vg_kr, 4, 0, -1, 1, 0, 0.01, 0, vg_de ? "FORMANT" : "SHIFT", #vgv);
sprintf(#vgv, "%.0f %%", slider5);
vg_scale(vg_x + 214, vg_cy, vg_kr, "0||5||10");
vg_knob(vg_x + 214, vg_cy, vg_kr, 5, 0, 0, 100, 25, 1, 0, vg_de ? "ANTRIEB" : "DRIVE", #vgv);
sprintf(#vgv, "+%.1f dB", slider6); vg_dec(#vgv);
vg_scale(vg_x + 292, vg_cy, vg_kr, "0||6||12");
vg_knob(vg_x + 292, vg_cy, vg_kr, 6, 0, 0, 12, 4, 0.1, 0, vg_de ? "HÖHEN" : "HF BOOST", #vgv);
sprintf(#vgv, "%.0f %%", slider7);
vg_scale(vg_x + 370, vg_cy, vg_kr, "0||5||10");
vg_knob(vg_x + 370, vg_cy, vg_kr, 7, 0, 0, 100, 0, 1, 0, vg_de ? "DIREKT" : "DIRECT", #vgv);

// =====================================================================
// RIGHT UNIT: SV-81 broadcast vocoder system (x 560..992)
// =====================================================================
vg_style(1, vg_md);
vg_x = 560;
vg_unit(vg_x, 60, 432, 272, "SV-81", vg_de ? "RUNDFUNK-" : "BROADCAST", "VOCODER", 8);
vg_on = slider8 >= 0.5;
// ---------- the display: ladders, lamps and the carrier line ----------
vg_sect(vg_x + 12, 108, 240, 96);
vg_glass(vg_x + 20, 115, 224, 82);
vg_nb = (slider10 >= 0.5 ? 24 : 16) + 1;
vg_ladder(vg_x + 26, 121, 170, 46, vg_nb, vg_LS, 10, vg_on);
vg_lamp(vg_x + 222, 128, 4.5, vg_on * min(vg_uv * 2, 1), vg_b ? 0xD4A373 : vqD);
gfx_setfont(16); ui_col(vg_b ? vqD : vqI2); vg_ctxt(vg_x + 222, 142, "V/UV");
vg_mlit = vg_now - vg_mt < 0.15 || (slider19 >= 0.5 && vca_nv > 0);
vg_lamp(vg_x + 222, 159, 4.5, vg_mlit, vg_b ? 0xD4A373 : vqD);
gfx_setfont(16); ui_col(vg_b ? vqD : vqI2); vg_ctxt(vg_x + 222, 173, "MIDI");
// the carrier line: what feeds the vocoders, or why nothing comes out
gfx_setfont(16);
vg_cl = vg_cp > 0.0003;
slider19 >= 0.5 ? (
  vca_nv > 0 ? ( vg_de ? sprintf(#vgc, slider20 >= 0.5 ? "SYNTH  HALTEN  %d STIMME%s" : "SYNTH  %d STIMME%s", vca_nv, vca_nv == 1 ? "" : "N")
                      : sprintf(#vgc, slider20 >= 0.5 ? "SYNTH  HOLD  %d VOICE%s" : "SYNTH  %d VOICE%s", vca_nv, vca_nv == 1 ? "" : "S"); )
             : strcpy(#vgc, vg_de ? "KEIN TRÄGER: MIDI SPIELEN" : "NO CARRIER: PLAY MIDI");
) : (
  vg_cl ? strcpy(#vgc, vg_de ? "TRÄGER  EXT 3/4" : "CARRIER  EXT 3/4") : strcpy(#vgc, vg_de ? "KEIN TRÄGER AUF 3/4" : "NO CARRIER ON 3/4");
);
vg_ok = slider19 >= 0.5 ? vca_nv > 0 : vg_cl;
ui_col(vg_ok ? vqD : 0xFF6A3A); vg_ltxt(vg_x + 28, 186, #vgc);

// ---------- keys: release, bands, synth wave ----------
vg_sect(vg_x + 258, 108, 162, 96);
vg_key(vg_x + 267, 115, 70, 22, vg_de ? "KURZ" : "REL FAST", slider11 < 0.5) ? ( slider11 = 0; ui_auto(11); );
vg_key(vg_x + 341, 115, 70, 22, vg_de ? "LANG" : "REL SLOW", slider11 >= 0.5) ? ( slider11 = 1; ui_auto(11); );
vg_key(vg_x + 267, 142, 70, 22, vg_de ? "16 KAN." : "16 BANDS", slider10 < 0.5) ? ( slider10 = 0; ui_auto(10); );
vg_key(vg_x + 341, 142, 70, 22, vg_de ? "24 KAN." : "24 BANDS", slider10 >= 0.5) ? ( slider10 = 1; ui_auto(10); );
vg_key(vg_x + 267, 169, 45, 22, vg_de ? "SÄGE" : "SAW", (slider18 | 0) == 0) ? ( slider18 = 0; ui_auto(18); );
vg_key(vg_x + 316, 169, 46, 22, vg_de ? "PULS" : "PULSE", (slider18 | 0) == 1) ? ( slider18 = 1; ui_auto(18); );
vg_key(vg_x + 366, 169, 45, 22, "SUPER", (slider18 | 0) == 2) ? ( slider18 = 2; ui_auto(18); );

// ---------- the knob rows: analysis, synth carrier ----------
vg_sect(vg_x + 12, 210, 126, 104);
vg_sect(vg_x + 144, 210, 276, 104);
vg_cy = 256; vg_kr = 20;
sprintf(#vgv, "%.0f %%", slider12);
vg_ticks(vg_x + 46, vg_cy, vg_kr); vg_tick(vg_x + 46, vg_cy, vg_kr, 0.5, "5", 1);
vg_knob(vg_x + 46, vg_cy, vg_kr, 12, 0, 0, 100, 50, 1, 0, "V/UV", #vgv);
sprintf(#vgv, "%+.1f dB", slider13); vg_dec(#vgv);
vg_ticks(vg_x + 106, vg_cy, vg_kr); vg_tick(vg_x + 106, vg_cy, vg_kr, 0.5, "0", 1);
vg_knob(vg_x + 106, vg_cy, vg_kr, 13, 0, -12, 12, 0, 0.1, 0, vg_de ? "NEIGUNG" : "TILT", #vgv);
sprintf(#vgv, "%+.1f dB", slider14); vg_dec(#vgv);
vg_ticks(vg_x + 178, vg_cy, vg_kr);
vg_knob(vg_x + 178, vg_cy, vg_kr, 14, 0, -24, 6, 0, 0.1, 0, vg_de ? "PEGEL" : "LEVEL", #vgv);
sprintf(#vgv, vg_de ? "%+.2f HT" : "%+.2f st", slider15); vg_dec(#vgv);
vg_ticks(vg_x + 246, vg_cy, vg_kr); vg_tick(vg_x + 246, vg_cy, vg_kr, 0.5, "0", 1);
vg_knob(vg_x + 246, vg_cy, vg_kr, 15, 0, -12, 12, 0, 0.01, 0, vg_de ? "STIMMEN" : "TUNE", #vgv);
sprintf(#vgv, vg_de ? "%+d Okt." : "%+d oct", slider16);
vg_i = 0; loop(5, vg_tick(vg_x + 314, vg_cy, vg_kr, vg_i / 4, vg_i == 2 ? "0" : "", 1); vg_i += 1; );
vg_knob(vg_x + 314, vg_cy, vg_kr, 16, 1, -2, 2, 0, 1, 0, vg_de ? "OKTAVE" : "OCTAVE", #vgv);
slider17 < 0.5 ? strcpy(#vgv, vg_de ? "AUS" : "OFF") : sprintf(#vgv, "%.0f ms", slider17);
vg_ticks(vg_x + 382, vg_cy, vg_kr);
vg_knob(vg_x + 382, vg_cy, vg_kr, 17, 2, 0, 1000, 0, 1, 0, vg_de ? "GLEITEN" : "GLIDE", #vgv);

// =====================================================================
// The central mounting bracket: CARRIER, BALANCE, MIX, DRIFT, OUTPUT, band SAT (x 428..572)
// =====================================================================
vqF = 0x9DA2A8; vqI = 0x1C1C1C; vqI2 = 0x3A3D40; vqHI = 0x8A2E00; vqA = 0xFF7900; vqL = 0x1C1C1C; vg_b = 1; vg_u = 0;
ui_cola(0x000000, 0.5); vg_r(430, 62, 144, 274);
rd_brushed(428, 58, 144, 276, 0x9AA0A6);
ui_cola(0x000000, 0.45); vg_fr(428, 58, 144, 276);
ui_cola(0xFFFFFF, 0.35); vg_r(429, 59, 142, 1);
ui_cola(0x000000, 0.25); vg_r(440, 66, 1, 262); vg_r(560, 66, 1, 262);
rd_screw(434, 72); rd_screw(566, 72); rd_screw(434, 320); rd_screw(566, 320);
gfx_setfont(11); ui_col(0x1C1C1C); vg_ctxt(500, 72, vg_de ? "TRÄGER" : "CARRIER");
vg_key(446, 82, 52, 24, "EXT", slider19 < 0.5) ? ( slider19 = 0; ui_auto(19); );
vg_key(502, 82, 52, 24, "SYNTH", slider19 >= 0.5) ? ( slider19 = 1; ui_auto(19); );
vg_key(446, 110, 108, 22, vg_de ? "HALTEN" : "HOLD", slider20 >= 0.5) ? ( slider20 = slider20 >= 0.5 ? 0 : 1; ui_auto(20); );
ui_cola(0x000000, 0.3); vg_r(446, 142, 108, 1); ui_cola(0xFFFFFF, 0.3); vg_r(446, 143, 108, 1);
sprintf(#vgv, "KR %.0f / SV %.0f", 100 - slider21, slider21);
vg_ticks(472, 168, 13); vg_knob(472, 168, 13, 21, 0, 0, 100, 50, 1, 0xC7BEB3, "KR / SV", #vgv);
sprintf(#vgv, "%.0f %%", slider22);
vg_ticks(528, 168, 13); vg_knob(528, 168, 13, 22, 0, 0, 100, 100, 1, 0xC7BEB3, vg_de ? "MISCH." : "MIX", #vgv);
sprintf(#vgv, "%.0f %%", slider23);
vg_ticks(472, 226, 13); vg_knob(472, 226, 13, 23, 0, 0, 100, 50, 1, 0x6F8794, "DRIFT", #vgv);
sprintf(#vgv, "%+.1f dB", slider24);
vg_ticks(528, 226, 13); vg_knob(528, 226, 13, 24, 0, -24, 12, 0, 0.1, 0x9DA2A8, vg_de ? "AUSG." : "OUTPUT", #vgv);
sprintf(#vgv, "%.0f %%", slider25);
vg_ticks(500, 284, 12); vg_knob(500, 284, 12, 25, 0, 0, 100, 0, 1, 0xD8B040, vg_de ? "SÄTT." : "SAT", #vgv);

pk_end();
ui_end();
