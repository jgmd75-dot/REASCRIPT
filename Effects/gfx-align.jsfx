desc:GFX ALIGN [phase / time align]
//tags: align alignment phase polarity time delay correlation multi-mic DI utility
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-input, gfx-output, gfx-ui, gfx-panel and gfx-dyn (.jsfx-inc) in the same folder.
//
// ALIGN. Lines up two recordings of the same sound: bass DI against the amp mic, kick in against kick out, snare top
// against bottom, overheads against close mics. Put ALIGN on the track to move; send the REFERENCE track to its
// channels 3 / 4 (a send or the track's own channels). Channels 1 / 2 are moved and come out on 1 / 2 (linked
// stereo); the reference is only listened to (it never reaches the output, except in SUM CHECK).
// No drift (a measuring tool: nothing should wander).
//
//   AUTO     arms the analysis: from the next signal on both inputs it listens for about a third of a second, finds
//            the time offset (within RANGE) and polarity that line the two up best (a cross-correlation by FFT), and
//            sets SHIFT and Ø. MATCH shows how alike the two are (100 % = identical bar the offset); below 30 % the
//            result is shown but not applied.
//   RANGE    the furthest AUTO looks: 5, 10 or 20 ms (about 1.7, 3.4 or 6.9 m of air).
//   SHIFT    -20 .. +20 ms in samples' steps: + delays this track; - moves it earlier (ALIGN then reports that much
//            latency, so REAPER delays everything else to match). Shown in ms, samples and cm of air. A change glides
//            between the old and new delay (a 20 ms crossfade): no click.
//   Ø        polarity, faded through zero.
//   ROTATE   0 .. 170 degrees of phase rotation AT a chosen frequency (40 - 400 Hz): a first-order all-pass that turns
//            the phase of the lows without moving the timing - for the last bit of low end that won't line up.
//   CORRELATION  live, between this track (as moved) and the reference: FULL (the whole band) and LOW (below 200 Hz).
//            +1 = in phase, 0 = unrelated, -1 = out of phase.
//   SUM CHECK  listen only: the output becomes this track plus the reference (as moved), so you hear them together.
//            The key and a banner flash while it is on - never print with it.
//   OUTPUT   -12 .. +12 dB. The house output stage passes straight through (a utility: no clip).
//   PRESETS  Init, 5 / 10 / 20 ms search starting points and Reset all to defaults (they don't touch SHIFT or Ø).

slider1:0<-20,20,0.01>-Shift (ms)
slider2:0<0,1,1{Normal,Inverted}>-Polarity
slider3:0<0,170,1>-Rotate (degrees)
slider4:100<40,400,1>-Rotate at (Hz)
slider5:1<0,2,1{5 ms,10 ms,20 ms}>-Range
slider6:0<0,1,1{Off,On}>-Sum check
slider7:0<-12,12,0.1>-Output (dB)

in_pin:left input
in_pin:right input
in_pin:reference left
in_pin:reference right
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc

@init
#ui_man = "gfx-align";                                // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory: FFT buffers on 65536 boundaries, delay lines after ----------
AL_FA = 65536;                                        // 32768 complex points (the reference)
AL_FB = 131072;                                       // 32768 complex points (this track)
AL_N = 32768; AL_CAP = 16384;                         // FFT size; samples captured (zero-padded to N: no wrap)
AL_DLN = 8192;                                        // delay lines (up to 20 ms at 384 kHz)
AL_BDL = 196608; AL_BDR = AL_BDL + AL_DLN; AL_BRL = AL_BDR + AL_DLN; AL_BRR = AL_BRL + AL_DLN;
memset(AL_BDL, 0, 4 * AL_DLN);

function al_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function al_op(f) ( 1 - exp(-2 * $pi * f / srate); );

// first-order all-pass (instance): coefficient from the corner
function ap_run(x) instance(x1, y1) local(y) ( y = al_apc * x + x1 - al_apc * y1; x1 = x; y1 = y; y; );

// read a delay line at d samples back (d integer, 0 .. AL_DLN - 1)
function al_rd(base, d) ( base[(al_wp - d + AL_DLN) % AL_DLN]; );

// ---------- AUTO: capture, then the cross-correlation by FFT ----------
function al_analyse() local(i, re1, im1, re2, im2, pk, pv, k, mx, ea, eb, a, b, c, off) (
  // energies (the match)
  ea = eb = 0; i = 0; loop(AL_CAP, ea += sqr(AL_FA[2 * i]); eb += sqr(AL_FB[2 * i]); i += 1; );
  fft(AL_FA, AL_N); fft(AL_FB, AL_N);
  // C = A * conj(B), into A (both buffers share the FFT's ordering)
  i = 0;
  loop(AL_N,
    re1 = AL_FA[2 * i]; im1 = AL_FA[2 * i + 1]; re2 = AL_FB[2 * i]; im2 = AL_FB[2 * i + 1];
    AL_FA[2 * i] = re1 * re2 + im1 * im2; AL_FA[2 * i + 1] = im1 * re2 - re1 * im2;
    i += 1;
  );
  ifft(AL_FA, AL_N);
  // the peak within RANGE: c[k] = sum ref[n + k] * this[n]; k > 0: the reference lags, so this track is delayed by k
  mx = floor(al_rng * 0.001 * srate);
  pk = 0; pv = 0; k = -mx;
  loop(2 * mx + 1,
    i = k >= 0 ? k : AL_N + k;
    abs(AL_FA[2 * i]) > abs(pv) ? ( pv = AL_FA[2 * i]; pk = k; );
    k += 1;
  );
  // sub-sample refinement (parabola), shown only: the shift is applied in whole samples
  i = pk >= 0 ? pk : AL_N + pk;
  a = AL_FA[2 * ((i - 1 + AL_N) % AL_N)]; b = AL_FA[2 * i]; c = AL_FA[2 * ((i + 1) % AL_N)];
  off = (a - 2 * b + c) != 0 ? 0.5 * (a - c) / (a - 2 * b + c) : 0;
  al_res_k = pk; al_res_f = pk + min(max(off, -0.5), 0.5);
  al_res_pol = pv < 0;
  al_res_m = abs(pv) / AL_N / sqrt(max(ea * eb, 0.0000000001));   // (the IFFT is unscaled: / N)
  al_res_ok = al_res_m >= 0.3;
  al_res_ok ? (
    slider1 = floor(pk / srate * 100000 + 0.5) / 100; slider2 = al_res_pol;
    slider_automate(1); slider_automate(2);
  );
  al_state = 3;                                      // done: the result is shown
);

// ---------- presets ----------
#al_pm = "Init|Close Mics (5 ms)|Room / DI (10 ms)|Far Mics (20 ms)";
function load_preset(p) (
  p == 1 ? ( slider3 = 0; slider4 = 100; slider5 = 1; ) :
  p == 2 ? ( slider5 = 0; ) :
  p == 3 ? ( slider5 = 1; ) :
  p == 4 ? ( slider5 = 2; ) :
  p == 5 ? ( slider1 = 0; slider2 = 0; slider3 = 0; slider4 = 100; slider5 = 1; slider6 = 0; slider7 = 0; );
  slider_automate(127);
  pr_cur = p == 5 ? 1 : p;
);

// ---------- state ----------
function al_srinit() (
  al_sr = srate;
  al_csm = 1 - exp(-1 / (0.3 * srate));               // correlation: 300 ms
  al_klo = al_op(200);
  al_gs = 1 - exp(-1 / (0.015 * srate));
  al_xs = 1 / (0.02 * srate);                         // the shift crossfade: 20 ms
  ost_init(0);
);
al_srinit();
in_init();
al_wp = 0; al_dA = al_dB = 0; al_lA = al_lB = 0; al_xf = 0; al_first = 1;
al_state = 0;                                         // 0 idle, 1 armed (waiting), 2 capturing, 3 result
al_pols = slider2 >= 0.5 ? -1 : 1; al_outs = 1; al_sums = 0;

ui_thm = 5; ui_hw = 1;                                // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );                // new instances open in Medium, on Init
ui_dflt = 1;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@block
srate != al_sr ? al_srinit();
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);                // the house output stage: straight through (a utility)
al_rng = slider5 < 0.5 ? 5 : slider5 < 1.5 ? 10 : 20;
// SHIFT: whole samples; a negative shift is reported as latency (REAPER moves everything else)
al_sh = min(max(slider1, -20), 20) * 0.001 * srate; al_sh = al_sh >= 0 ? floor(al_sh + 0.5) : -floor(-al_sh + 0.5);
al_D = max(al_sh, 0); al_L = max(-al_sh, 0);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = al_L;
// a change starts a crossfade from the old taps to the new ones
al_xf <= 0 && (al_D != al_dB || al_L != al_lB) ? ( al_dA = al_dB; al_lA = al_lB; al_dB = al_D; al_lB = al_L; al_xf = al_first ? 1 : 0.000001; );
al_first = 0;
// ROTATE: the corner of the first-order all-pass that turns the phase by the angle at the frequency
al_ang = min(max(slider3, 0), 170);
al_ang > 0.5 ? (
  al_fc = min(max(slider4, 40), 400) / tan(al_ang * $pi / 360);
  al_t = tan($pi * min(al_fc, 0.45 * srate) / srate); al_apc = (al_t - 1) / (al_t + 1);
);
al_rot_t = al_ang > 0.5;
al_polt = slider2 >= 0.5 ? -1 : 1;
al_sum_t = slider6 >= 0.5;
al_outt = 10 ^ (min(max(slider7, -12), 12) / 20);
// AUTO: the capture is complete -> analyse (once)
al_state == 2 && al_ci >= AL_CAP ? al_analyse();
// denormal housekeeping
apL.x1 = al_tn(apL.x1); apL.y1 = al_tn(apL.y1); apR.x1 = al_tn(apR.x1); apR.y1 = al_tn(apR.y1);
al_cab = al_tn(al_cab); al_caa = al_tn(al_caa); al_cbb = al_tn(al_cbb);
al_lab = al_tn(al_lab); al_laa = al_tn(al_laa); al_lbb = al_tn(al_lbb);
// the panel's mailboxes
ala_pi = max(ala_pi, al_pi); al_pi = 0; ala_pr = max(ala_pr, al_pr); al_pr = 0; ala_po = max(ala_po, al_po); al_po = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0; spl2 != spl2 ? spl2 = 0; spl3 != spl3 ? spl3 = 0;
in_process(spl0, spl1);
al_xl = in_l; al_xr = in_r; al_rl = spl2; al_rr = spl3;
al_pi = max(al_pi, max(abs(al_xl), abs(al_xr))); al_pr = max(al_pr, max(abs(al_rl), abs(al_rr)));
// AUTO capture: armed -> waits for signal on both inputs -> records this track and the reference (mono sums)
al_state == 1 && max(abs(al_xl), abs(al_xr)) > 0.003 && max(abs(al_rl), abs(al_rr)) > 0.003 ? (
  al_state = 2; al_ci = 0; memset(AL_FA, 0, 2 * AL_N); memset(AL_FB, 0, 2 * AL_N);
);
al_state == 2 && al_ci < AL_CAP ? (
  AL_FA[2 * al_ci] = 0.5 * (al_rl + al_rr); AL_FB[2 * al_ci] = 0.5 * (al_xl + al_xr); al_ci += 1;
);
// delay lines (this track and the reference)
AL_BDL[al_wp] = al_xl; AL_BDR[al_wp] = al_xr; AL_BRL[al_wp] = al_rl; AL_BRR[al_wp] = al_rr;
al_xf > 0 ? (
  al_e = al_xf * al_xf * (3 - 2 * al_xf);
  al_yl = al_rd(AL_BDL, al_dA) + al_e * (al_rd(AL_BDL, al_dB) - al_rd(AL_BDL, al_dA));
  al_yr = al_rd(AL_BDR, al_dA) + al_e * (al_rd(AL_BDR, al_dB) - al_rd(AL_BDR, al_dA));
  al_ql = al_rd(AL_BRL, al_lA) + al_e * (al_rd(AL_BRL, al_lB) - al_rd(AL_BRL, al_lA));
  al_qr = al_rd(AL_BRR, al_lA) + al_e * (al_rd(AL_BRR, al_lB) - al_rd(AL_BRR, al_lA));
  al_xf += al_xs; al_xf >= 1 ? al_xf = 0;
) : (
  al_yl = al_rd(AL_BDL, al_dB); al_yr = al_rd(AL_BDR, al_dB); al_ql = al_rd(AL_BRL, al_lB); al_qr = al_rd(AL_BRR, al_lB);
);
al_wp = (al_wp + 1) % AL_DLN;
// polarity (faded through zero), ROTATE (faded in / out)
al_pols += (al_polt - al_pols) * al_gs;
al_yl *= al_pols; al_yr *= al_pols;
al_rots += (al_rot_t - al_rots) * al_gs;
al_rots > 0.0005 ? ( al_yl += al_rots * (apL.ap_run(al_yl) - al_yl); al_yr += al_rots * (apR.ap_run(al_yr) - al_yr); );
// correlation against the reference (as moved): full band and below 200 Hz
al_a = 0.5 * (al_yl + al_yr); al_b = 0.5 * (al_ql + al_qr);
al_cab += (al_a * al_b - al_cab) * al_csm; al_caa += (al_a * al_a - al_caa) * al_csm; al_cbb += (al_b * al_b - al_cbb) * al_csm;
al_fla += al_klo * (al_a - al_fla); al_flb += al_klo * (al_b - al_flb);
al_lab += (al_fla * al_flb - al_lab) * al_csm; al_laa += (al_fla * al_fla - al_laa) * al_csm; al_lbb += (al_flb * al_flb - al_lbb) * al_csm;
// SUM CHECK (faded), OUTPUT
al_sums += (al_sum_t - al_sums) * al_gs;
al_sums > 0.0005 ? ( al_yl += al_sums * al_ql; al_yr += al_sums * al_qr; );
al_outs += (al_outt - al_outs) * al_gs;
al_yl *= al_outs; al_yr *= al_outs;
ost_out(al_yl, al_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
spl2 = spl3 = 0;
al_po = max(al_po, max(abs(spl0), abs(spl1)));

@gfx 960 388
ui_begin(960, 388);
// =====================================================================
// GUI - black panel with hazard-yellow accents (design space 960 x 388; S / M / L).
// AUTO | TIME | PHASE | CORRELATION + OUTPUT; the IN / REF / OUT meter strip below.
// Knobs: drag (SHIFT = fine), wheel, double-click = default; the label shows the value while the knob is touched.
// =====================================================================
sc != ag_lsc ? (
  ag_lsc = sc;
  gfx_setfont(11, "Trebuchet MS", 18 * sc, 'b');     // section titles
  gfx_setfont(12, "Trebuchet MS", 14 * sc, 'b');     // knob labels / values
  gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');     // small print
  gfx_setfont(14, "Trebuchet MS", 13 * sc, 'b');     // keys
  gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');     // the unit's name
  gfx_setfont(16, "Courier New", 22 * sc, 'b');      // the read-outs
);
AG_FACE = 0x0C0C0D; AG_PLATE = 0x161617; AG_EDGE = 0x3A3A2A; AG_INK = 0xF2F0E8; AG_DIM = 0x9C988A; AG_YEL = 0xFFD21F;
AG_TRAY = 0x080809; AG_RED = 0xFF5A3A;

function ag_rr(x, y, w, h, r) local(x1, y1, x2, y2, rr) (
  x1 = floor(x * sc + 0.5); y1 = floor(y * sc + 0.5); x2 = floor((x + w) * sc + 0.5); y2 = floor((y + h) * sc + 0.5);
  rr = min(floor(r * sc + 0.5), floor((min(x2 - x1, y2 - y1)) * 0.5));
  gfx_a < 1 ? ui_rrs(x1, y1, x2 - x1, y2 - y1, rr) : (
    gfx_rect(x1 + rr, y1, x2 - x1 - 2 * rr, y2 - y1);
    gfx_rect(x1, y1 + rr, rr + 1, y2 - y1 - 2 * rr); gfx_rect(x2 - rr - 1, y1 + rr, rr + 1, y2 - y1 - 2 * rr);
    gfx_circle(x1 + rr, y1 + rr, rr, 1, 1); gfx_circle(x2 - rr - 1, y1 + rr, rr, 1, 1);
    gfx_circle(x1 + rr, y2 - rr - 1, rr, 1, 1); gfx_circle(x2 - rr - 1, y2 - rr - 1, rr, 1, 1);
  );
);
function ag_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function ag_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function ag_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function ag_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function ag_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function ag_key(x, y, w, h, on, col, s) local(hov, hit) (
  hov = ag_in(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.4); ag_rr(x + 1, y + 2, w, h, 4);
  on ? ( ui_cola(col, 0.22); ag_rr(x - 3, y - 3, w + 6, h + 6, 6); );
  ui_col(on ? col : 0x202022); ag_rr(x, y, w, h, 4);
  !on ? ( ui_col(ui_mix(col, 0x202022, 0.75)); ag_rr(x, y, w, max(2, 2 / sc), 1); );
  hov ? ( ui_cola(0xFFFFFF, 0.1); ag_rr(x, y, w, h, 4); );
  gfx_setfont(14); ui_col(on ? 0x111111 : ui_mix(col, AG_INK, 0.45));
  ui_keytext((x + w * 0.5) * sc, (y + h * 0.5) * sc, s);
  hit;
);
function ag_sec(x0, w, title) (
  ui_cola(0x000000, 0.5); ag_rr(x0 + 1, 74, w, 226, 8);
  ui_col(AG_EDGE); ag_rr(x0, 72, w, 226, 8);
  ui_col(AG_PLATE); ag_rr(x0 + 1.5, 73.5, w - 3, 223, 7);
  ui_col(AG_YEL); ag_r(x0 + 18, 84, 4, 22);
  gfx_setfont(11); ui_col(AG_INK); ag_tl(x0 + 30, 85, title);
  dy_bg = AG_PLATE; dy_ink = AG_INK;
);
// the pointer in black, drawn over the cap's light one (yellow caps)
function ag_ptr(cx, cy, r, idx, lo, hi, lg) local(n, a, ca, sa, x1, y1, x2, y2, k) (
  n = lg ? log(slider(idx) / lo) / log(hi / lo) : (slider(idx) - lo) / (hi - lo); n = min(max(n, 0), 1);
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(0x141414);   // (drawn here, not with ui_ssline: works with any version of the system files)
  x1 = (cx + ca * r * 0.3) * sc; y1 = (cy + sa * r * 0.3) * sc; x2 = (cx + ca * (r - 3)) * sc; y2 = (cy + sa * (r - 3)) * sc;
  k = -1.2; loop(7, gfx_line(x1 - sa * k * sc, y1 + ca * k * sc, x2 - sa * k * sc, y2 + ca * k * sc, 1); k += 0.4; );
);
function ag_knob(cx, cy, r, idx, lo, hi, def, lg, lbl, val) (
  dy_kst = 36; dy_knob(cx, cy, r, idx, lo, hi, def, lg, AG_YEL, "", ""); ag_ptr(cx, cy, r, idx, lo, hi, lg);
  gfx_setfont(12); ui_col(dy_act ? AG_YEL : AG_INK); ag_tc(cx, cy + r + 22, dy_act ? val : lbl);
);
function ag_inset(x, y, w, h) ( pk_inset(x * sc, y * sc, w * sc, h * sc, AG_TRAY); );
// a centred correlation bar (-1 .. +1)
function ag_corr(x, y, w, v, lbl) local(n) (
  ag_inset(x, y, w, 14);
  n = min(max(v, -1), 1);
  ui_col(n >= 0 ? AG_YEL : AG_RED);
  abs(n) > 0.005 ? ( n >= 0 ? ag_r(x + w * 0.5, y + 4, (w * 0.5 - 4) * n, 6) : ag_r(x + w * 0.5 + (w * 0.5 - 4) * n, y + 4, -(w * 0.5 - 4) * n, 6); );
  ui_col(AG_DIM); ag_r(x + w * 0.5 - 0.5, y - 3, 1, 20);
  gfx_setfont(13); ui_col(AG_DIM); ag_tl(x, y - 18, lbl); sprintf(#agc, "%+.2f", v); ui_col(AG_INK); ag_tr(x + w, y - 18, #agc);
);

// =====================================================================
// Draw
// =====================================================================
ui_col(AG_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
// hazard stripes along the header's foot
ag_i = 0; loop(48, ui_col(ag_i % 2 ? 0x111111 : 0x3A3410); gfx_triangle((ag_i * 20) * sc, 60 * sc, (ag_i * 20 + 10) * sc, 60 * sc, (ag_i * 20 + 4) * sc, 64 * sc, (ag_i * 20 - 6) * sc, 64 * sc); ag_i += 1; );
ui_col(AG_YEL); ag_r(0, 58, 960, 1.5);

// ---------- header ----------
ui_col(AG_YEL); gfx_circle(48 * sc, 30 * sc, 16 * sc, 1, 1);
gfx_setfont(13); ui_col(AG_FACE); ui_keytext(48 * sc, 30 * sc, "GFX");
gfx_setfont(15); ui_col(AG_INK); ag_tl(76, 13, "ALIGN"); gfx_measurestr("ALIGN", ag_tw, ag_th);
ag_x = 88 + ag_tw / sc;
ui_col(AG_YEL); ag_r(ag_x, 20, 8, 8); ui_col(0x000000); ag_r(ag_x + 11, 20, 8, 8);
gfx_setfont(13); ui_col(AG_DIM); ag_tl(ag_x, 33, "PHASE / TIME ALIGN  ·  REFERENCE ON 3/4");
pk_pextra = "Reset all to defaults";
ag_k = pk_preset(452 * sc, 14 * sc, 390 * sc, 30 * sc, pr_cur, #al_pm);
ag_k > 0 ? load_preset(ag_k);
ui_size_picker(864 * sc, 20 * sc);

// ---------- AUTO ----------
ag_sec(24, 228, "AUTO");
ag_key(42, 118, 192, 40, al_state == 1 || al_state == 2, AG_YEL, al_state == 1 ? "WAITING FOR SIGNAL" : al_state == 2 ? "LISTENING..." : "AUTO ALIGN") ? (
  al_state == 1 || al_state == 2 ? al_state = 0 : ( al_state = 1; al_ci = 0; );
);
gfx_setfont(13); ui_col(AG_DIM); ag_tl(42, 172, "RANGE");
ag_k = floor(slider5 + 0.5);
ag_key(42, 188, 58, 26, ag_k == 0, AG_YEL, "5 ms") ? ( slider5 = 0; ui_auto(5); );
ag_key(109, 188, 58, 26, ag_k == 1, AG_YEL, "10 ms") ? ( slider5 = 1; ui_auto(5); );
ag_key(176, 188, 58, 26, ag_k == 2, AG_YEL, "20 ms") ? ( slider5 = 2; ui_auto(5); );
ag_inset(42, 228, 192, 56);
gfx_setfont(13);
al_state == 3 ? (
  sprintf(#agr, "%+.2f samples  %s", al_res_f, al_res_pol ? "Ø" : ""); ui_col(al_res_ok ? AG_YEL : AG_RED); ag_tl(52, 236, #agr);
  sprintf(#agr, "MATCH %d%%%s", floor(100 * min(al_res_m, 1) + 0.5), al_res_ok ? "  ·  APPLIED" : "  ·  TOO LOW"); ui_col(AG_INK); ag_tl(52, 258, #agr);
) : (
  ui_col(AG_DIM); ag_tl(52, 236, ala_pr < 0.0005 ? "NO REFERENCE ON 3/4" : "PRESS AUTO, THEN PLAY"); ag_tl(52, 258, "BOTH SOURCES TOGETHER");
);

// ---------- TIME ----------
ag_sec(264, 236, "TIME");
sprintf(#agv, "%+.2f ms", slider1); ag_knob(332, 196, 40, 1, -20, 20, 0, 0, "SHIFT", #agv);
ag_inset(390, 132, 96, 116);
gfx_setfont(16); ui_col(AG_YEL); sprintf(#agv, "%+.2f", slider1); ag_tr(476, 142, #agv);
gfx_setfont(13); ui_col(AG_DIM); ag_tr(476, 166, "ms");
ag_s = slider1 * 0.001 * srate; ag_s = ag_s >= 0 ? floor(ag_s + 0.5) : -floor(-ag_s + 0.5);
ui_col(AG_INK); sprintf(#agv, "%+d smp", ag_s); ag_tr(476, 190, #agv);
sprintf(#agv, "%+.1f cm", slider1 * 34.3); ag_tr(476, 212, #agv);
ui_col(AG_DIM); ag_tr(476, 230, ag_s < 0 ? "AS LATENCY" : ag_s > 0 ? "DELAYED" : "");
ag_key(390, 256, 96, 26, 0, AG_YEL, "ZERO") ? ( slider1 = 0; ui_auto(1); );

// ---------- PHASE ----------
ag_sec(512, 200, "PHASE");
ag_key(530, 118, 164, 30, slider2 >= 0.5, AG_YEL, "Ø  POLARITY") ? ( slider2 = slider2 >= 0.5 ? 0 : 1; ui_auto(2); );
sprintf(#agv, "%d°", floor(slider3 + 0.5)); ag_knob(566, 214, 28, 3, 0, 170, 0, 0, "ROTATE", #agv);
sprintf(#agv, "%d Hz", floor(slider4 + 0.5)); ag_knob(660, 214, 24, 4, 40, 400, 100, 1, "AT", #agv);

// ---------- CORRELATION + OUTPUT ----------
ag_sec(724, 212, "CORRELATION");
ag_ccf = al_caa > 0.0000000001 && al_cbb > 0.0000000001 ? al_cab / sqrt(al_caa * al_cbb) : 0;
ag_ccl = al_laa > 0.0000000001 && al_lbb > 0.0000000001 ? al_lab / sqrt(al_laa * al_lbb) : 0;
ag_corr(742, 140, 176, ag_ccf, "FULL");
ag_corr(742, 186, 176, ag_ccl, "LOW < 200 Hz");
ag_fl = slider6 >= 0.5 && (time_precise() * 2) % 2 < 1.3;
ag_key(742, 216, 92, 30, slider6 >= 0.5, ag_fl ? AG_RED : 0xB06A50, "SUM CHECK") ? ( slider6 = slider6 >= 0.5 ? 0 : 1; ui_auto(6); );
sprintf(#agv, "%+.1f dB", slider7); dy_kst = 36; dy_knob(888, 232, 20, 7, -12, 12, 0, 0, AG_YEL, "", ""); ag_ptr(888, 232, 20, 7, -12, 12, 0);
gfx_setfont(13); ui_col(dy_act ? AG_YEL : AG_INK); ag_tc(888, 266, dy_act ? #agv : "OUTPUT");

// ---------- meter strip ----------
ag_inset(24, 310, 912, 66);
ag_pi = ala_pi; ala_pi = 0; ag_pr = ala_pr; ala_pr = 0; ag_po = ala_po; ala_po = 0;
agmI.ui_ledm(80 * sc, 320 * sc, 700 * sc, 8 * sc, ag_pi);
agmR.ui_ledm(80 * sc, 338 * sc, 700 * sc, 8 * sc, ag_pr);
agmO.ui_ledm(80 * sc, 356 * sc, 700 * sc, 8 * sc, ag_po);
gfx_setfont(13); ui_col(AG_DIM); ag_tr(66, 317, "IN"); ag_tr(66, 335, "REF"); ag_tr(66, 353, "OUT");
slider6 >= 0.5 ? ( ui_col(ag_fl ? AG_RED : 0x6A2A1C); ag_rr(800, 322, 124, 40, 4); gfx_setfont(14); ui_col(0x111111); ui_keytext(862 * sc, 342 * sc, "SUM CHECK ON"); ) :
                 ( ui_col(AG_INK); ag_tl(800, 326, "NO DRIFT"); ui_col(AG_DIM); ag_tl(800, 346, "NO CLIP"); );

pk_end();
ui_end();
