desc:GFX G High Priestess [Arcana synth]
//tags: instrument synth polyphonic pad drone formant delay echo lfo arcana
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-s57 (.jsfx-inc) in the same folder.
//
// THE HIGH PRIESTESS (card II of the GFX Arcana series): she sits between the two pillars of the temple, BOAZ the
// dark and JACHIN the light, before a veil of pomegranates, the crescent moon at her feet and the scroll of hidden
// knowledge in her lap. A polyphonic synth (8 voices) of two oscillators per voice, a veiled filter that turns into
// a voice, a lunar LFO, and a descending echo that writes every note into a growing drone - the Scroll.
//   BOAZ       the dark pillar: SHAPE morphs a saw into a square, SUB blends in the octave below (and, past half
//              way, the octave below that), WEIGHT darkens and drives the pillar (a low-pass tilt into a soft
//              saturation), OCTAVE.
//   JACHIN     the light pillar: a sine and three GLASS partials (bell ratios 2.76, 5.40, 8.93) struck at every
//              note, slowly beating as they fade (in two or three seconds; quicker on the echoes). GLASS, OCTAVE (+1 by default), DETUNE (cents).
//   CROSS      the pillars joined: left of centre BOAZ frequency-modulates JACHIN, right of centre JACHIN
//              ring-modulates BOAZ. BALANCE: BOAZ .. both .. JACHIN.
//   THE VEIL   a 4-pole ladder low-pass: CUTOFF, RESONANCE, ENV (bipolar: the filter's own attack-decay envelope,
//              which follows the amp's ATTACK and DECAY). VEIL draws the veil: the top is softly absorbed (the
//              cutoff pulled down) while three vowel formants open beneath and are mixed in; VOWEL moves them
//              through the dark vowels U - O - A.
//   LUNAR LFO  ultra slow (RATE 0.002 - 0.5 Hz): one cycle is one lunation, and the LFO follows the moon's
//              light from new to full and back to new. SHAPE: a narrow curve, dark most of the month (left),
//              through the plain cosine (middle), to a broad full-moon plateau (right). Three depths, each from
//              the knob's value at the new moon: to CUTOFF (+/- 4 octaves), to VEIL, to PITCH (cents).
//   ENVELOPE   ATTACK, DECAY, SUSTAIN, RELEASE, VELOCITY (how much the touch matters).
//   THE DESCENDING DELAY  every note played is echoed by re-sounding it through the voices (a MIDI echo), so the
//              echoes can fall in pitch cleanly. FLUTTER: the first few repeats come fast and scattered, slightly
//              out of tune and thrown about the stereo field, before the descent begins. TIME: the first spacing.
//              DECEL: each spacing is longer than the last (x 1 + DECEL), so the echoes slow down. SPEED: how fast
//              the echoes fall (semitones per second; each repeat starts where the last one ended). DESCENT: how far
//              they fall in all (semitones). REPEATS: how many before the note settles. FEEDBACK: each repeat's
//              level. MIX: the lead (dry) against the echoes. Echoes give way to played notes.
//   THE SCROLL when a note's echoes end, its last pitch (to the nearest semitone) settles into the Scroll - a
//              bank of twelve soft, slowly evolving additive voices that hold the harmonic residue of all that was
//              played (when it is full, the oldest fades out). SCROLL: its level. DECRYPT: from bright and
//              legible to dark and hidden (a low-pass). HALO: a soft diffusion on the echoes and the Scroll.
//              DRONE (lit blue): the Scroll sounds and is written; off, it falls silent and nothing is written.
//              HOLD: the Scroll is frozen as it is (nothing new is written). CLEAR: the Scroll fades away
//              (notes still echoing at that moment are not written either).
//              The lunar LFO touches the Scroll (its brightness and breath).
//   FATE       the series' drift (0 - 100 %, 50 % = the standard amount) - here a tidal wander: the two pillars'
//              tuning drift apart and together, the veil (cutoff and vowel) breathes, and the echoes' timing is
//              never quite even.
//   VOLUME, LEVEL, SAT (the output soft clip is always on). POLY / MONO / LEGATO and GLIDE.
// MIDI: notes, pitch bend (+/- 2), CC1 (adds to VEIL), CC64 sustain, CC120 / CC123 all notes off (the Scroll fades away too).

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-s57.jsfx-inc

slider1:30<0,100,0.1>-Boaz shape (saw .. square, %)
slider2:30<0,100,0.1>-Boaz sub (%)
slider3:35<0,100,0.1>-Boaz weight (%)
slider4:0<-2,2,1>-Boaz octave
slider5:40<0,100,0.1>-Jachin glass (%)
slider6:1<-2,2,1>-Jachin octave
slider7:7<-50,50,0.1>-Jachin detune (cents)
slider8:0<-100,100,0.1>-Cross (Boaz FM .. Jachin ring)
slider9:45<0,100,0.1>-Pillar balance (Boaz .. Jachin, %)
slider10:2400<20,18000,1>-Cutoff (Hz)
slider11:25<0,100,0.1>-Resonance (%)
slider12:30<-100,100,0.1>-Filter env (%)
slider13:20<0,100,0.1>-Veil (%)
slider14:30<0,100,0.1>-Vowel (U .. O .. A, %)
slider15:0.05<0.002,0.5,0.0001>-Lunar rate (Hz)
slider16:50<0,100,0.1>-Lunar shape (new .. full, %)
slider17:20<-100,100,0.1>-Lunar to cutoff (%)
slider18:15<-100,100,0.1>-Lunar to veil (%)
slider19:0<-50,50,0.1>-Lunar to pitch (cents)
slider20:0.008<0.001,10,0.0001>-Attack (s)
slider21:0.9<0.01,10,0.001>-Decay (s)
slider22:65<0,100,0.1>-Sustain (%)
slider23:1.4<0.01,15,0.001>-Release (s)
slider24:0.32<0.04,2,0.001>-Echo time (s)
slider25:30<0,100,0.1>-Flutter (%)
slider26:3<0,12,0.01>-Pitch speed (st per s)
slider27:12<0,24,1>-Descent (st)
slider28:25<0,100,0.1>-Decel (%)
slider29:6<1,16,1>-Repeats
slider30:70<0,100,0.1>-Feedback (%)
slider31:45<0,100,0.1>-Delay mix (%)
slider32:45<0,100,0.1>-Scroll level (%)
slider33:45<0,100,0.1>-Decryption (%)
slider34:1<0,1,1{Off,On}>-Drone
slider35:0<0,1,1{Off,On}>-Hold
slider36:30<0,100,0.1>-Halo (%)
slider37:50<0,100,1>-Fate (%)
slider38:-6<-24,6,0.1>-Volume (dB)
slider39:0<0,2,1{Poly,Mono,Legato}>-Voice mode
slider40:0<0,100,1>-Glide (%)
slider41:0<0,16,1>-MIDI channel (0 = omni)
slider42:60<0,100,1>-Velocity (%)
slider43:0<0,100,1>-Band sat (%)
slider44:30<0,100,1>-Bias (%)
slider45:120<40,400,1>-Sat low band (Hz)
slider46:6000<2000,16000,10>-Sat high band (Hz)
slider47:-0.3<-24,0,0.1>-Ceiling (dB)
slider48:1<0,1,1{Off,Clip}>-(unused, output stage)
slider49:60<0,100,0.1>-Level (%)

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-high-priestess";
ext_noinit = 1;
s57_mem = 0;

// ---------- memory ----------
HPVN = 16; HPVS = 64; HPV = s57_alloc(HPVN * HPVS);     // the voices (8 played + the echoes)
// voice slots (q = HPV + v * HPVS):
//   0 on  1 note  2 velocity 0..1  3 key down  4 stage (1 A, 2 D/S, 4 R)  5 level  6 pitch now (st)  7 pitch target
//   8 echo voice  9 echo gate (samples left)  10 echo fall (st / s, <= 0)  11 age  12 pan L  13 pan R
//   14 Boaz phase  15 sub phase  16 Jachin phase  17 .. 19 glass phases  20 glass strike  21 weight state
//   22 .. 25 ladder  26 ladder g  27 its target  35 filter envelope
//   37 Boaz increment  38 Jachin increment  39 beat offset  40 .. 42 glass weights  43 gain  46 echo's own note
//   44 glass decay  45 resonance scale  47 glass ramp  48 echo floor (st)  49 echo level
HPCN = 32; HPCS = 16; HPC = s57_alloc(HPCN * HPCS);     // the echo chains (one per note played)
// chain slots: 0 on  1 note  2 velocity  3 next fire (abs. samples)  4 descending repeats fired  5 flutter repeats
//   left  6 spacing (s)  7 next start offset (st)  8 next level  9 settle time (abs.)  10 settle offset  11 age
//   12 cleared (echoes on, but it will not be written)
HPSN = 16; HPSS = 24; HPS = s57_alloc(HPSN * HPSS);     // the Scroll's slots
// scroll slots: 0 state (0 free, 1 alive, 2 fading)  1 pitch  2 inc A  3 inc B  4 phase A  5 phase B  6 level
//   7 target  8 pan L  9 pan R  10 blend  11 age  13 table A  14 table B  15 blend phase  16 its rate
//   17 detune phase  18 its rate
HPQ = s57_alloc(256 * 10);                              // the event queue: offset, type, pitch, vel, fall, gate, pan, floor, note, level
HPHN = s57_alloc(128);                                  // keys down (mono / legato)
HPF = s57_alloc(16);                                    // the formants' coefficients
HPTN = 2048; HPT = s57_alloc(3 * (HPTN + 1));           // the Scroll's wave tables: warm, hollow, pure
HPDS = s57_alloc(128);                                  // the display's copy of the lunar curve
HPDEF = s57_alloc(64); HPTMP = s57_alloc(128);
// the halo: two diffusers and four lines
hpa0.s57_dlinit(2048); hpa1.s57_dlinit(2048);
hpd0.s57_dlinit(8192); hpd1.s57_dlinit(8192); hpd2.s57_dlinit(8192); hpd3.s57_dlinit(8192);

// the Scroll's tables (partials 1 .. 8, band-limited by choosing the pure table above 2.4 kHz)
function hp_tables() local(i, k, ph, a, b) (
  i = 0;
  loop(HPTN + 1,
    ph = 2 * $pi * i / HPTN; a = 0; b = 0; k = 1;
    loop(8,
      a += sin(ph * k) * (k == 1 ? 1 : k == 2 ? 0.5 : k == 3 ? 0.3 : k == 4 ? 0.18 : k == 5 ? 0.11 : k == 6 ? 0.07 : k == 7 ? 0.045 : 0.03);
      b += sin(ph * k) * (k == 1 ? 1 : k == 2 ? 0.08 : k == 3 ? 0.42 : k == 4 ? 0.05 : k == 5 ? 0.24 : k == 6 ? 0.03 : k == 7 ? 0.12 : 0.02);
      k += 1; );
    HPT[i] = a * 0.62; HPT[HPTN + 1 + i] = b * 0.66; HPT[2 * (HPTN + 1) + i] = sin(ph);
    i += 1; );
);
hp_tables();

ost_init(0); hpoL.ost_ch_init(); hpoR.ost_ch_init();
// FATE: the tidal wander (Boaz's tuning, Jachin's tuning, the cutoff, the vowel)
hp_dB.drift_init(0.8 + rand(0.4)); hp_dJ.drift_init(0.8 + rand(0.4)); hp_dC.drift_init(0.7 + rand(0.4)); hp_dV.drift_init(0.6 + rand(0.4));

// ---------- the presets: the Init values and each preset's changes ----------
#hp_def = "30 30 35 0 40 1 7 0 45 2400 25 30 20 30 0.05 50 20 15 0 0.008 0.9 65 1.4 0.32 30 3 12 25 6 70 45 45 45 1 0 30 50 -6 0 0 0 60 0 30 120 6000 -0.3 1 60";
function hp_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
hp_nums(#hp_def, HPDEF);
#hp_pm = "Init|Veil of Isis|Tora Scroll|Pomegranate|Crescent Water|Boaz Shadow|Jachin Light|Silver Lunation|Temple Drone|Descending Choir|The Unspoken|Mystery School";
function hp_pstr(p) (
  p == 2  ? "5:25 9:55 10:1500 13:55 14:40 15:0.03 18:35 20:1.2 21:2 22:80 23:4 24:0.6 25:20 26:1.5 29:5 31:40 32:50 36:50 49:45.0" :
  p == 3  ? "5:50 9:60 20:0.005 21:0.6 22:40 23:1.2 24:0.45 25:45 26:2.5 28:40 29:8 30:75 32:70 33:30 49:65.4" :
  p == 4  ? "1:60 2:40 3:50 5:20 9:30 10:900 11:45 12:60 13:10 21:0.45 22:20 23:0.6 24:0.22 25:55 26:4 49:92.4" :
  p == 5  ? "5:75 7:12 8:-30 9:80 10:6000 11:15 13:15 14:70 15:0.08 17:30 20:0.002 21:1.5 22:30 23:2.5 24:0.38 25:35 26:2 27:7 36:45 49:51.7" :
  p == 6  ? "1:20 2:70 3:70 4:-1 5:10 9:10 10:700 11:35 12:45 13:35 14:0 24:0.5 26:1 27:5 29:4 30:60 32:50 33:70 49:80.5" :
  p == 7  ? "5:90 7:4 9:92 10:9000 11:10 12:10 13:5 20:0.001 21:2.4 22:25 23:3 24:0.28 25:50 26:5 33:25 36:55 49:55.0" :
  p == 8  ? "9:50 10:1400 11:40 13:30 14:50 15:0.15 16:80 17:60 18:50 19:12 20:0.3 22:70 23:2.5 32:40 49:54.1" :
  p == 9  ? "2:50 3:45 13:40 14:20 15:0.02 20:0.6 21:2 22:75 23:3 24:0.25 26:6 29:3 31:35 32:85 33:55 36:45 49:52.8" :
  p == 10 ? "1:70 2:20 9:40 10:2600 11:20 13:85 14:55 18:30 20:0.15 22:75 23:2 24:0.42 25:25 26:2 28:35 29:7 30:75 31:60 36:40 49:54.1" :
  p == 11 ? "2:40 3:60 9:35 10:500 11:30 12:20 13:60 14:10 20:0.8 22:85 23:5 24:0.9 25:0 26:0.6 27:5 28:15 29:4 30:60 31:35 32:40 33:75 36:60 49:61.7" :
  p == 12 ? "1:45 5:55 7:18 8:55 10:3200 11:50 12:50 13:25 14:85 21:0.5 22:35 23:1 24:0.18 25:70 26:8 27:19 28:30 29:9 30:72 31:55 49:68.5" :
  "";
);
function load_preset(p) local(n, i) (
  // FATE, VOLUME, the voice mode, the MIDI channel and the output stage stay as they are
  i = 0; loop(36, slider(i + 1) = HPDEF[i]; i += 1; );
  slider40 = HPDEF[39]; slider42 = HPDEF[41]; slider49 = HPDEF[48];
  n = hp_nums(hp_pstr(p), HPTMP);
  i = 0; loop(floor(n / 2), HPTMP[i * 2] >= 1 && HPTMP[i * 2] <= 49 ? slider(HPTMP[i * 2]) = HPTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(49, ui_auto(i); i += 1; );
  pr_cur = p; hp_panic = 1;
);

// ---------- the lunar curve: the moon's light through one lunation (ph 0 new, 0.5 full), shaped ----------
function hp_lun(ph, s) local(i, e) (
  i = 0.5 - 0.5 * cos(2 * $pi * ph);
  s < 0.5 ? ( e = 1 + 7 * (1 - 2 * s); i ^ e; ) : ( e = 1 + 7 * (2 * s - 1); 1 - (1 - i) ^ e; );
);
// the vowels (U, O, A): the formants' frequencies and levels, interpolated (v 0..1)
function hp_vow(v, k) local(t, a, b) (
  v < 0.5 ? ( t = v * 2;
    a = k == 0 ? 300 : k == 1 ? 870 : 2240; b = k == 0 ? 430 : k == 1 ? 820 : 2500;
  ) : ( t = v * 2 - 1;
    a = k == 0 ? 430 : k == 1 ? 820 : 2500; b = k == 0 ? 730 : k == 1 ? 1090 : 2440;
  );
  a * (b / a) ^ t;
);
function hp_vlev(v, k) ( k == 0 ? 1 : k == 1 ? 0.42 + 0.2 * v : 0.12 + 0.12 * v; );
// the formants' band-passes (TPT state variable), coefficients for formant k at f Hz, bandwidth bw
function hp_fset(k, f, bw) local(g, kk, a1) (
  g = tan($pi * min(f, srate * 0.45) / srate); kk = min(bw / f, 1.5);
  a1 = 1 / (1 + g * (g + kk));
  HPF[k * 4] = a1; HPF[k * 4 + 1] = g * a1; HPF[k * 4 + 2] = g * g * a1; HPF[k * 4 + 3] = kk;
);
// the three formants on one bus (TPT band-passes, 0 dB at their peaks, at their vowel's levels)
function hp_form(x) instance(c1, c2, d1, d2, e1, e2) local(v1, v2, v3, f) (
  v3 = x - c2; v1 = HPF[0] * c1 + HPF[1] * v3; v2 = c2 + HPF[1] * c1 + HPF[2] * v3; c1 = v1 + v1 - c1; c2 = v2 + v2 - c2; f = v1 * HPF[3] * hp_fl0;
  v3 = x - d2; v1 = HPF[4] * d1 + HPF[5] * v3; v2 = d2 + HPF[5] * d1 + HPF[6] * v3; d1 = v1 + v1 - d1; d2 = v2 + v2 - d2; f += v1 * HPF[7] * hp_fl1;
  v3 = x - e2; v1 = HPF[8] * e1 + HPF[9] * v3; v2 = e2 + HPF[9] * e1 + HPF[10] * v3; e1 = v1 + v1 - e1; e2 = v2 + v2 - e2; f += v1 * HPF[11] * hp_fl2;
  f;
);

// ---------- voices ----------
function hp_reset(q) ( memset(q + 14, 0, 36); q[14] = rand(1); q[16] = rand(1); q[39] = rand(1); );
// a voice for a played note: a free one, else an echo (the quietest), else the oldest played note
function hp_get_lead() local(v, q, best, bl, nl, old, ba) (
  best = -1; nl = 0; old = -1; ba = 1000000000000;
  v = 0; loop(HPVN, q = HPV + v * HPVS; q[0] && !q[8] ? ( nl += 1; q[11] < ba ? ( ba = q[11]; old = v; ); ); v += 1; );
  nl >= 8 ? best = old : (
    v = 0; loop(HPVN, q = HPV + v * HPVS; best < 0 && !q[0] ? best = v; v += 1; );
    best < 0 ? ( bl = 10; v = 0; loop(HPVN, q = HPV + v * HPVS; q[8] && q[5] < bl ? ( bl = q[5]; best = v; ); v += 1; ); );
    best < 0 ? best = old;
  );
  best;
);
// a voice for an echo: a free one (not voice 0 in MONO / LEGATO) while fewer than HPEC echoes sound, else the quietest echo
function hp_get_echo() local(v, q, best, bl, ne, v0) (
  best = -1; ne = 0; v0 = slider39 >= 1 ? 1 : 0;
  v = v0; loop(HPVN - v0, q = HPV + v * HPVS; q[0] && q[8] ? ne += 1; v += 1; );
  ne < HPEC ? ( v = v0; loop(HPVN - v0, q = HPV + v * HPVS; best < 0 && !q[0] ? best = v; v += 1; ); );
  best < 0 ? ( bl = 10; v = v0; loop(HPVN - v0, q = HPV + v * HPVS; q[0] && q[8] && q[5] < bl ? ( bl = q[5]; best = v; ); v += 1; ); );
  best;
);
// a voice's ladder coefficient: the glided cutoff, the envelope, key tracking (every 16 samples, at its start, per block)
function hp_vf(q) local(fc) (
  fc = exp(hp_fc2 + (q[35] * hp_fev * 6 + (q[6] + hp_lpc - 60) / 12 * 0.4) * 0.693147);
  q[27] = min(1 - exp(-2 * $pi * min(fc, srate * 0.42) / srate), 0.92);
  q[45] = 1 - max(q[27] - 0.6, 0) * 2.2;                 // resonance eased near the top (no ringing at Nyquist)
);
// a voice's pitch, filter and levels for a block (and at its start)
function hp_prep(q) local(lp, f, fj, fc, w, b) (
  lp = q[6] + hp_lpc;
  f = 440 * 2 ^ ((lp - 69) / 12) * hp_bend;
  q[37] = min(f * hp_bo / srate, 0.45);
  fj = f * hp_jo; q[38] = min(fj / srate, 0.45);
  b = hp_bph + q[39];
  q[40] = fj * 2.76 < 0.45 * srate ? hp_gls * 0.55 * (1 + 0.45 * sin(2 * $pi * b * 0.37)) : 0;
  q[41] = fj * 5.40 < 0.45 * srate ? hp_gls * 0.34 * (1 + 0.5 * sin(2 * $pi * (b * 0.61 + 0.3))) : 0;
  q[42] = fj * 8.93 < 0.45 * srate ? hp_gls * 0.2 * (1 + 0.55 * sin(2 * $pi * (b * 0.89 + 0.6))) : 0;
  hp_vf(q);
  q[43] = (1 - hp_vs + hp_vs * q[2]) * q[49];
);
function hp_pan(q, p) local(a) ( p = min(max(p, -1), 1); a = (p + 1) * $pi * 0.25; q[12] = cos(a) * 1.4142; q[13] = sin(a) * 1.4142; );
function hp_on_lead(note, vel) local(v, q, legato) (
  legato = slider39 == 2 && hp_mono_held;
  v = slider39 >= 1 ? 0 : hp_get_lead();
  q = HPV + v * HPVS;
  // stealing an echo: it becomes a played note (from where it is: nothing jumps)
  q[8] && q[0] ? ( q[8] = 0; legato = 0; );
  q[7] = note;
  !legato ? (
    q[6] = slider40 > 0 && hp_lastp > 0 ? (slider39 >= 1 && q[0] ? q[6] : hp_lastp) : note;
    !q[0] ? hp_reset(q);
    q[0] = 1; q[4] = 1; q[20] = 1; q[47] = q[5] > 0.01 ? q[47] : 0;
    q[8] = 0; q[49] = 1; q[44] = hp_gdk;
    hp_pan(q, slider39 >= 1 ? 0 : (v & 1 ? 1 : -1) * (0.08 + 0.04 * (v & 7)));
  );
  hp_lastp = note;
  q[1] = note; q[2] = vel; q[3] = 1; q[11] = hp_age; hp_age += 1;
  hp_prep(q);
  ins_midi_hit();
);
function hp_on_echo(pitch, vel, fall, gate, pan, flo, note, lvl) local(v, q) (
  v = hp_get_echo();
  v >= 0 ? (
    q = HPV + v * HPVS;
    !q[0] ? hp_reset(q);
    q[0] = 1; q[4] = 1; q[20] = 1; q[47] = q[5] > 0.01 ? q[47] : 0;
    q[1] = -1; q[2] = vel; q[3] = 0; q[6] = q[7] = pitch; q[8] = 1; q[9] = gate; q[10] = fall; q[48] = flo; q[46] = note;
    q[49] = lvl; q[44] = hp_gde; q[11] = hp_age; hp_age += 1;
    hp_pan(q, pan);
    hp_prep(q);
  );
);
function hp_off(note) local(v, q, k, b) (
  slider39 >= 1 ? (
    // MONO / LEGATO: back to the highest key still held (gliding), else release
    q = HPV; b = -1; k = 0; loop(128, HPHN[k] && k != note ? b = k; k += 1; );
    q[0] && !q[8] && q[1] == note ? (
      b >= 0 ? ( q[1] = b; q[7] = b; hp_lastp = b; ) : ( q[3] = 0; !hp_ped ? q[4] = 4; );
    );
  ) : (
    v = 0; loop(HPVN, q = HPV + v * HPVS; q[0] && !q[8] && q[1] == note && q[3] ? ( q[3] = 0; !hp_ped ? q[4] = 4; ); v += 1; );
  );
);
function hp_all_off() local(v, q) ( v = 0; loop(HPVN, q = HPV + v * HPVS; q[3] = 0; q[0] ? q[4] = 4; v += 1; ); );

// ---------- the Scroll ----------
function hp_scroll_add(pitch, vel) local(i, s, n, old, oa, best, bl) (
  slider34 >= 0.5 && slider35 < 0.5 ? (
    best = -1;
    // the same pitch already written: it is renewed (a little stronger), not written twice
    i = 0; loop(HPSN, s = HPS + i * HPSS; s[0] == 1 && s[1] == pitch ? ( best = i; s[7] = min(s[7] * 1.2, 0.42); s[11] = hp_sage; hp_sage += 1; ); i += 1; );
    best < 0 ? (
      n = 0; old = -1; oa = 1000000000000;
      i = 0; loop(HPSN, s = HPS + i * HPSS; s[0] == 1 ? ( n += 1; s[11] < oa ? ( oa = s[11]; old = i; ); ); i += 1; );
      n >= 12 ? ( s = HPS + old * HPSS; s[0] = 2; s[7] = 0; );
      i = 0; loop(HPSN, s = HPS + i * HPSS; best < 0 && s[0] == 0 ? best = i; i += 1; );
      // none free: the quietest of the fading ones is written over (its phase runs on: nothing clicks)
      best < 0 ? ( bl = 10; i = 0; loop(HPSN, s = HPS + i * HPSS; s[0] == 2 && s[6] < bl ? ( bl = s[6]; best = i; ); i += 1; ); );
      s = HPS + best * HPSS;
      s[0] = 1; s[1] = pitch; s[7] = 0.28 * (0.6 + 0.4 * vel); s[11] = hp_sage; hp_sage += 1;
      s[6] < 0.00001 ? ( s[4] = rand(1); s[5] = rand(1); );
      i = (rand(2) - 1) * 0.7; s[8] = cos((i + 1) * $pi * 0.25) * 1.4142; s[9] = sin((i + 1) * $pi * 0.25) * 1.4142;
      s[15] = rand(1); s[16] = 0.02 + rand(0.05); s[17] = rand(1); s[18] = 0.03 + rand(0.06);
    );
  );
);
function hp_scroll_clear() local(i, s) ( i = 0; loop(HPSN, s = HPS + i * HPSS; s[0] == 1 ? ( s[0] = 2; s[7] = 0; ); i += 1; ); );

// ---------- the echo chains ----------
// a new chain, at the absolute time t (samples)
function hp_chain(note, vel, t) local(i, c, best, ba, nf) (
  best = -1; ba = 1000000000000;
  i = 0; loop(HPCN, c = HPC + i * HPCS; best < 0 && !c[0] ? best = i; i += 1; );
  // none free: the oldest settles now
  best < 0 ? ( i = 0; loop(HPCN, c = HPC + i * HPCS; c[11] < ba ? ( ba = c[11]; best = i; ); i += 1; );
               c = HPC + best * HPCS; !c[12] ? hp_scroll_add(c[1] + c[10], c[2]); );
  c = HPC + best * HPCS;
  nf = floor(slider25 / 100 * 4 + 0.5);
  c[0] = 1; c[1] = note; c[2] = vel; c[4] = 0; c[5] = nf; c[6] = slider24; c[7] = 0; c[8] = 0.8; c[9] = 0; c[10] = 0;
  c[11] = hp_cage; hp_cage += 1; c[12] = 0;
  c[3] = t + (nf > 0 ? slider24 * (0.08 + 0.22 * rand(1)) : slider24) * srate;
);
// fire chain c's next repeat (queued at offset o in this block)
function hp_fire(c, o) local(pitch, fall, gate, pan, flo, lvl, sp, k, fl, last) (
  fl = slider25 / 100; flo = c[1] - slider27;
  c[5] > 0 ? (
    // FLUTTER: fast, scattered, a little out of tune, thrown about
    pitch = c[1] + c[7] + (rand(2) - 1) * fl * 0.45; fall = 0; pan = (rand(2) - 1) * 0.9 * fl;
    lvl = c[8]; c[8] *= 0.86;
    c[5] -= 1;
    sp = c[5] > 0 ? slider24 * (0.08 + 0.22 * rand(1)) : slider24;
    gate = max(min(sp * 0.9, 0.5), 0.03);
    last = 0;
  ) : (
    // the descent: each repeat starts where the last one ended and falls on
    k = c[4];
    pitch = max(c[1] + c[7], flo); fall = -slider26; pan = (k & 1 ? 1 : -1) * min(0.3 + 0.07 * k, 0.75);
    lvl = c[8] * hp_fb; c[8] = lvl;
    sp = c[6];
    gate = min(max(max(sp * 0.6, slider20 * 1.1), 0.04), 2);
    c[7] = max(c[7] - slider26 * sp, -slider27);
    c[6] = sp * (1 + slider28 / 100) * (1 + hp_fate * 0.06 * (rand(2) - 1));
    c[4] = k + 1;
    last = c[4] >= slider29;
    last ? ( c[9] = c[3] + gate * srate; c[10] = floor(max(pitch - slider26 * gate, flo) - c[1] + 0.5); );
  );
  hp_qn < 250 && slider31 > 0.2 ? (
    k = hp_qn * 10;
    HPQ[k] = o; HPQ[k + 1] = 2; HPQ[k + 2] = pitch; HPQ[k + 3] = c[2]; HPQ[k + 4] = fall; HPQ[k + 5] = floor(gate * srate);
    HPQ[k + 6] = pan; HPQ[k + 7] = flo; HPQ[k + 8] = c[1]; HPQ[k + 9] = lvl * (0.7 + 0.3 * c[2]);
    hp_qn += 1;
  );
  c[3] += sp * srate;
);

function hp_update() local(f) (
  hp_vol = 10 ^ (slider38 / 20);
  hp_fate = slider37 / 50;
  hp_vs = slider42 / 100;
  hp_fb = slider30 / 100;
  HPEC = 6;
  ins_output_setup(43);
);
function hp_srinit() local(i) (
  hp_srt = srate; hp_sm = s57_kt(0.02, srate); hp_fk = s57_kt(0.015, srate); hp_fok = 0; hp_sk = s57_kt(1.1, srate);
  ost_init(0);
);
hp_update(); hp_srinit();
hp_bend = 1; hp_snorm = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// ---------- the card's colours: the alabaster of Series 57, signal orange, the pale blue of the moon ----------
function hp_pal() (
  HP_MOON = 0x8FB8DE; HP_MOOND = 0x3E5F80; HP_BOAZ = 0x1E1D22; HP_BOAZL = 0x3C3B43; HP_JACH = 0xFBF9F3;
  HP_VCLOTH = 0xD6CCB6; HP_POM = 0xB9876E; HP_LEAF = 0x9CA88E;
  HP_OLED = 0x0C121B; HP_OINK = 0xD6E6F6; HP_ODIM = 0x6E86A2;
);

@slider
hp_update();

@block
srate != hp_srt ? hp_srinit();      // (hp_srt: hp_sr is the Scroll's right channel)
hp_update();
hp_panic ? ( hp_all_off(); memset(HPC, 0, HPCN * HPCS); hp_scroll_clear(); hp_panic = 0; );
hp_lmode != slider39 ? ( hp_all_off(); hp_lmode = slider39; );
hp_clr ? ( hp_scroll_clear(); i_ = 0; loop(HPCN, HPC[i_ * HPCS + 12] = 1; i_ += 1; ); hp_clr = 0; hp_clrt = 1.2; );
hp_clrt = max(hp_clrt - samplesblock / srate, 0);
hp_bs = samplesblock / srate;

// FATE: the tides (slow)
hp_di = 0.07 * (0.5 + 0.5 * min(hp_fate, 2)) * hp_bs;
hp_zb = hp_dB.drift_tick(hp_di); hp_zj = hp_dJ.drift_tick(hp_di * 0.9); hp_zc = hp_dC.drift_tick(hp_di * 0.8); hp_zv = hp_dV.drift_tick(hp_di * 0.6);

// THE LUNAR LFO: one cycle a lunation, following the moon's light
hp_lph += slider15 * hp_bs; hp_lph >= 1 ? hp_lph -= floor(hp_lph);
hp_lfo = hp_lun(hp_lph, slider16 / 100);
hp_lpc = hp_lfo * slider19 / 100;                                        // to pitch (semitones)

// the pillars
hp_bo = 2 ^ slider4 * 2 ^ (hp_zb * hp_fate * 7 / 1200);
hp_jo = 2 ^ slider6 * 2 ^ ((slider7 + hp_zj * hp_fate * 7) / 1200);
hp_gls = slider5 / 100; hp_gls *= hp_gls;
hp_bph += hp_bs;
hp_mpt = slider1 / 100;
hp_s = slider2 / 100; hp_w1t = min(hp_s * 2, 1) * 0.75; hp_w2t = max(hp_s * 2 - 1, 0) * 0.7;
hp_w = slider3 / 100; hp_wkt = s57_k(16000 * 2 ^ (-5.2 * hp_w), srate); hp_wdt = 1 + 2.5 * hp_w; hp_wnt = (1 + 0.35 * hp_w) / (1 + 1.2 * hp_w);
hp_fmt = max(-slider8 / 100, 0) * 2.4; hp_rgt = max(slider8 / 100, 0);
hp_b = slider9 / 100; hp_gbt = min(1, 2 - 2 * hp_b) * 0.8; hp_gjt = min(1, 2 * hp_b) * 0.85;
// THE VEIL: the ladder (cutoff, lunar, drift, the veil's pull), the formants
hp_veil = min(max(slider13 / 100 + hp_lfo * slider18 / 100 + hp_cc1 * 0.6, 0), 1);
hp_cut = slider10;
hp_coct = hp_lfo * slider17 / 100 * 4 + hp_zc * hp_fate * 0.3 - hp_veil * 2.2;
hp_env = slider12 / 100;
hp_flt = log(hp_cut) + hp_coct * 0.693147;              // the cutoff in log Hz: hp_fc2 glides to it per sample
!hp_fok ? ( hp_fc1 = hp_fc2 = hp_flt; hp_fev = hp_env; hp_fok = 1; );
hp_rkt = slider11 / 100 * 3.9; hp_rct = 1 + 1.3 * slider11 / 100;
hp_vw = min(max(slider14 / 100 + hp_zv * hp_fate * 0.07, 0), 1);
hp_fset(0, hp_vow(hp_vw, 0), 80); hp_fset(1, hp_vow(hp_vw, 1), 95); hp_fset(2, hp_vow(hp_vw, 2), 130);
hp_fl0 = hp_vlev(hp_vw, 0); hp_fl1 = hp_vlev(hp_vw, 1); hp_fl2 = hp_vlev(hp_vw, 2);
// the envelope
hp_ainc = 1 / max(slider20 * srate, 1);
hp_dk = s57_kt(slider21 / 4.6, srate); hp_rk = s57_kt(slider23 / 4.6, srate);
hp_sus = slider22 / 100;
hp_gdk = exp(-1 / (0.7 * srate)); hp_gde = exp(-1 / (0.3 * srate));
// the mix: lead, echoes, the Scroll (its level falls as it fills), the halo, the output
hp_dryt = min(1, 2 - 2 * slider31 / 100); hp_ewt = min(1, 2 * slider31 / 100);
hp_sal = 0; i_ = 0; loop(HPSN, s_ = HPS + i_ * HPSS; s_[0] == 1 ? hp_sal += 1; i_ += 1; );
hp_snorm += (1 / sqrt(max(hp_sal, 1)) - hp_snorm) * min(hp_bs * 2, 1);
hp_sct = (slider32 / 100) ^ 2 * 4 * (slider34 >= 0.5) * hp_snorm * (0.8 + 0.2 * hp_lfo);
hp_dct = min(1 - exp(-2 * $pi * min(14000 * (180 / 14000) ^ (slider33 / 100) * 2 ^ ((hp_lfo - 0.5) * 0.9), srate * 0.4) / srate), 0.99);
hp_hwt = slider36 / 100 * 0.9;
hp_ogt = (slider49 / 100) ^ 2 * 1.9 * hp_vol;
hp_hg = 0.86;
hp_hk = s57_k(5200, srate);

// ---------- MIDI into the queue ----------
hp_qn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, slider41) ? (
    st_ = m1 & 0xF0;
    st_ == 0x90 && m3 > 0 ? (
      HPHN[m2] = 1; hp_mono_held = 0; i_ = 0; loop(128, HPHN[i_] && i_ != m2 ? hp_mono_held = 1; i_ += 1; );
      hp_qn < 250 ? ( k_ = hp_qn * 10; HPQ[k_] = mofs; HPQ[k_ + 1] = 1; HPQ[k_ + 2] = m2; HPQ[k_ + 3] = m3 / 127; hp_qn += 1; );
      hp_chain(m2, m3 / 127, hp_t + mofs);
    ) : st_ == 0x80 || (st_ == 0x90 && m3 == 0) ? (
      HPHN[m2] = 0;
      hp_qn < 250 ? ( k_ = hp_qn * 10; HPQ[k_] = mofs; HPQ[k_ + 1] = 0; HPQ[k_ + 2] = m2; HPQ[k_ + 3] = 0; hp_qn += 1; );
    ) : st_ == 0xE0 ? ( hp_bend = ins_bend(m2, m3, 2); ) :
    st_ == 0xB0 ? (
      m2 == 1 ? ( hp_cc1 = m3 / 127; ) :
      m2 == 64 ? ( hp_ped = m3 >= 64; !hp_ped ? ( v_ = 0; loop(HPVN, q_ = HPV + v_ * HPVS; q_[0] && !q_[8] && !q_[3] && q_[4] < 4 ? q_[4] = 4; v_ += 1; ); ); ) :
      m2 == 120 || m2 == 123 ? ( hp_all_off(); memset(HPHN, 0, 128); memset(HPC, 0, HPCN * HPCS); hp_scroll_clear(); );   // (the Scroll fades away too)
    );
  );
  midisend(mofs, m1, m2, m3);
);
// ---------- the echo chains: their repeats in this block, and the notes that settle into the Scroll ----------
i_ = 0; loop(HPCN,
  c_ = HPC + i_ * HPCS;
  c_[0] ? (
    while (c_[9] == 0 && c_[3] < hp_t + samplesblock) ( hp_fire(c_, max(c_[3] - hp_t, 0)); );
    c_[9] > 0 && c_[9] < hp_t + samplesblock ? ( !c_[12] ? hp_scroll_add(c_[1] + c_[10], c_[2]); c_[0] = 0; );
  );
  i_ += 1; );
// sort the queue by offset
i_ = 1; loop(hp_qn - 1, k_ = i_;
  while (k_ > 0 && HPQ[(k_ - 1) * 10] > HPQ[k_ * 10]) ( j_ = 0; loop(10, t_ = HPQ[k_ * 10 + j_]; HPQ[k_ * 10 + j_] = HPQ[(k_ - 1) * 10 + j_]; HPQ[(k_ - 1) * 10 + j_] = t_; j_ += 1; ); k_ -= 1; );
  i_ += 1; );
hp_qr = 0; hp_sp = 0;
// ---------- per block: the voices' pitch (glide, the echoes' fall), filters and levels ----------
hp_glk = slider40 > 0 ? 1 - exp(-samplesblock / ((0.005 + 0.6 * (slider40 / 100) ^ 2) * srate)) : 1;
hp_nact = 0; hp_nech = 0;
v_ = 0; loop(HPVN,
  q_ = HPV + v_ * HPVS;
  q_[0] ? (
    q_[8] ? ( hp_nech += 1; q_[6] = max(q_[6] + q_[10] * hp_bs, q_[48]); ) : ( hp_nact += 1; q_[6] += (q_[7] - q_[6]) * hp_glk; );
    hp_prep(q_);
  );
  v_ += 1; );
// the Scroll's slots: their slow drift, their pitch; the faded ones are freed
i_ = 0; loop(HPSN,
  s_ = HPS + i_ * HPSS;
  s_[0] ? (
    s_[0] == 2 && s_[6] < 0.00001 ? ( s_[0] = 0; s_[6] = 0; ) : (
      s_[15] += s_[16] * hp_bs; s_[15] -= floor(s_[15]); s_[17] += s_[18] * hp_bs; s_[17] -= floor(s_[17]);
      s_[10] = 0.45 + 0.35 * sin(2 * $pi * s_[15]);
      f_ = 440 * 2 ^ ((s_[1] - 69) / 12);
      s_[2] = f_ / srate; s_[3] = f_ * 2 ^ ((5 + 4 * hp_fate) * sin(2 * $pi * s_[17]) / 1200) / srate;
      s_[13] = f_ > 2400 ? 2 * (HPTN + 1) : 0; s_[14] = f_ > 2400 ? 2 * (HPTN + 1) : HPTN + 1;
      s_[13] += HPT; s_[14] += HPT;
    );
  );
  i_ += 1; );
hp_t += samplesblock;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
// ---------- the queue ----------
while (hp_qr < hp_qn && (HPQ[hp_qr * 10] <= hp_sp || hp_sp >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  k_ = hp_qr * 10; t_ = HPQ[k_ + 1];
  t_ == 1 ? hp_on_lead(HPQ[k_ + 2], HPQ[k_ + 3]) : t_ == 0 ? hp_off(HPQ[k_ + 2]) :
    hp_on_echo(HPQ[k_ + 2], HPQ[k_ + 3], HPQ[k_ + 4], HPQ[k_ + 5], HPQ[k_ + 6], HPQ[k_ + 7], HPQ[k_ + 8], HPQ[k_ + 9]);
  hp_qr += 1;
);
hp_sp += 1;

// ---------- the controls, glided ----------
// the ladder's cutoff (two 15 ms stages) and ENV glide, and the voices follow their filter envelopes every 16 samples
hp_fc1 += (hp_flt - hp_fc1) * hp_fk; hp_fc2 += (hp_fc1 - hp_fc2) * hp_fk; hp_fev += (hp_env - hp_fev) * hp_fk;
hp_ftk -= 1; hp_ftk < 0 ? hp_ftk = 15;
hp_mph += (hp_mpt - hp_mph) * hp_sm; hp_w1 += (hp_w1t - hp_w1) * hp_sm; hp_w2 += (hp_w2t - hp_w2) * hp_sm;
hp_wk += (hp_wkt - hp_wk) * hp_sm; hp_wd += (hp_wdt - hp_wd) * hp_sm; hp_wn += (hp_wnt - hp_wn) * hp_sm;
hp_fmi += (hp_fmt - hp_fmi) * hp_sm; hp_rng += (hp_rgt - hp_rng) * hp_sm;
hp_gb += (hp_gbt - hp_gb) * hp_sm; hp_gj += (hp_gjt - hp_gj) * hp_sm;
hp_fv += (hp_veil - hp_fv) * hp_sm; hp_rk4 += (hp_rkt - hp_rk4) * hp_sm; hp_rc += (hp_rct - hp_rc) * hp_sm;
hp_dry += (hp_dryt - hp_dry) * hp_sm; hp_ew += (hp_ewt - hp_ew) * hp_sm; hp_scg += (hp_sct - hp_scg) * hp_sm;
hp_dc += (hp_dct - hp_dc) * hp_sm; hp_hw += (hp_hwt - hp_hw) * hp_sm; hp_og += (hp_ogt - hp_og) * hp_sm;

// ---------- the voices ----------
hp_ll = hp_lr = hp_el = hp_er = 0; hp_fll = hp_flr = hp_fel = hp_fer = 0;
q_ = HPV;
loop(HPVN,
  q_[0] ? (
    // the envelope (a straight attack, exponential decay and release); the filter's own attack-decay
    st_ = q_[4];
    st_ == 1 ? ( q_[5] += hp_ainc; q_[5] >= 1 ? ( q_[5] = 1; q_[4] = 2; ); q_[35] = q_[5]; ) :
    st_ == 2 ? ( q_[5] += (hp_sus - q_[5]) * hp_dk; q_[35] -= q_[35] * hp_dk; ) :
    ( q_[5] -= q_[5] * hp_rk; q_[35] -= q_[35] * hp_dk; q_[5] * (q_[43] + 0.02) < 0.0002 ? ( q_[0] = 0; q_[5] = 0; ); );
    q_[8] ? ( q_[9] -= 1; q_[9] <= 0 && st_ < 4 ? q_[4] = 4; );
    // BOAZ: a band-limited saw, morphing into a square (the saw less a saw half a cycle on), the subs below
    dt_ = q_[37];
    p_ = q_[14] + dt_; p_ >= 1 ? p_ -= 1; q_[14] = p_;
    b_ = p_ + p_ - 1;
    p_ < dt_ ? ( x_ = p_ / dt_; b_ -= x_ + x_ - x_ * x_ - 1; ) : p_ > 1 - dt_ ? ( x_ = (p_ - 1) / dt_; b_ -= x_ * x_ + x_ + x_ + 1; );
    hp_mph > 0.001 ? (
      p_ += 0.5; p_ >= 1 ? p_ -= 1;
      y_ = p_ + p_ - 1;
      p_ < dt_ ? ( x_ = p_ / dt_; y_ -= x_ + x_ - x_ * x_ - 1; ) : p_ > 1 - dt_ ? ( x_ = (p_ - 1) / dt_; y_ -= x_ * x_ + x_ + x_ + 1; );
      b_ -= hp_mph * y_;
    );
    s_ = q_[15] + dt_ * 0.25; s_ >= 1 ? s_ -= 1; q_[15] = s_;
    hp_w1 > 0.001 ? b_ += hp_w1 * sin(12.566370614 * s_) + hp_w2 * sin(6.283185307 * s_);
    // WEIGHT: tilted down and driven
    q_[21] += (b_ - q_[21]) * hp_wk;
    b_ = s57_th(q_[21] * hp_wd) * hp_wn;
    // JACHIN: the sine (Boaz may modulate it), the glass struck and fading to a shimmer
    pj_ = q_[16] + q_[38]; pj_ >= 1 ? pj_ -= 1; q_[16] = pj_;
    j_ = sin(6.283185307 * pj_ + hp_fmi * b_);
    q_[20] *= q_[44]; q_[47] += (1 - q_[47]) * 0.02;
    hp_gls > 0.0001 && q_[20] > 0.004 ? (
      g_ = q_[17] + q_[38] * 2.76; q_[17] = g_ -= g_ | 0;
      x_ = q_[18] + q_[38] * 5.4; q_[18] = x_ -= x_ | 0;
      y_ = q_[19] + q_[38] * 8.93; q_[19] = y_ -= y_ | 0;
      j_ += q_[20] * q_[47] * (sin(6.283185307 * g_) * q_[40] + sin(6.283185307 * x_) * q_[41] + sin(6.283185307 * y_) * q_[42]);
    );
    // CROSS: Jachin rings Boaz
    hp_rng > 0.001 ? b_ *= 1 - hp_rng + hp_rng * 1.5 * j_;
    x_ = b_ * hp_gb + j_ * hp_gj;
    // THE VEIL: the ladder
    hp_ftk == 0 ? hp_vf(q_);
    q_[26] += (q_[27] - q_[26]) * 0.06; g_ = q_[26];
    u_ = s57_th(x_ * 0.75 - hp_rk4 * q_[45] * q_[25]);
    q_[22] += g_ * (u_ - q_[22]); q_[23] += g_ * (q_[22] - q_[23]); q_[24] += g_ * (q_[23] - q_[24]); q_[25] += g_ * (q_[24] - q_[25]);
    y_ = q_[25] * hp_rc;
    // ... and the vowel beneath it: the pillars, through the envelope, sent to the formants (run once per bus, below)
    a_ = q_[5] * q_[43];
    hp_fv > 0.0005 ? (
      x_ *= a_ * hp_fv * 2.2; y_ *= a_ * (1 - 0.55 * hp_fv);
      q_[8] ? ( hp_el += y_ * q_[12]; hp_er += y_ * q_[13]; hp_fel += x_ * q_[12]; hp_fer += x_ * q_[13]; )
            : ( hp_ll += y_ * q_[12]; hp_lr += y_ * q_[13]; hp_fll += x_ * q_[12]; hp_flr += x_ * q_[13]; );
    ) : (
      y_ *= a_;
      q_[8] ? ( hp_el += y_ * q_[12]; hp_er += y_ * q_[13]; ) : ( hp_ll += y_ * q_[12]; hp_lr += y_ * q_[13]; );
    );
  );
  q_ += HPVS;
);

// the vowel formants, once per bus (the lead's pair and the echoes' pair)
hp_fv > 0.0005 ? (
  hp_ll += hpfL.hp_form(hp_fll); hp_lr += hpfR.hp_form(hp_flr);
  hp_el += hpfE.hp_form(hp_fel); hp_er += hpfF.hp_form(hp_fer);
);

// ---------- the Scroll ----------
hp_sl = hp_sr = 0;
s_ = HPS;
loop(HPSN,
  s_[0] ? (
    s_[6] += (s_[7] - s_[6]) * hp_sk;
    a_ = s_[4] + s_[2]; a_ >= 1 ? a_ -= 1; s_[4] = a_;
    b_ = s_[5] + s_[3]; b_ >= 1 ? b_ -= 1; s_[5] = b_;
    x_ = a_ * 2048; i_ = x_ | 0; t_ = s_[13] + i_; y_ = t_[0] + (t_[1] - t_[0]) * (x_ - i_);
    x_ = b_ * 2048; i_ = x_ | 0; t_ = s_[14] + i_; y_ += (t_[0] + (t_[1] - t_[0]) * (x_ - i_)) * s_[10];
    y_ *= s_[6];
    hp_sl += y_ * s_[8]; hp_sr += y_ * s_[9];
  );
  s_ += HPSS;
);
// DECRYPTION: two poles down, from bright to hidden
hp_d1l += (hp_sl - hp_d1l) * hp_dc; hp_d2l += (hp_d1l - hp_d2l) * hp_dc;
hp_d1r += (hp_sr - hp_d1r) * hp_dc; hp_d2r += (hp_d1r - hp_d2r) * hp_dc;
hp_sl = hp_d2l * hp_scg; hp_sr = hp_d2r * hp_scg;
hp_el *= hp_ew; hp_er *= hp_ew;

// ---------- the halo: two diffusers into four lines ----------
hp_hin = (hp_el + hp_er) * 0.5 + (hp_sl + hp_sr) * 0.35 + (hp_ll + hp_lr) * 0.06 * hp_dry + 0.000000000000001;
hp_hin = hpa1.s57_ap(hpa0.s57_ap(hp_hin, 0.0071 * srate, 0.6), 0.0113 * srate, 0.6);
h0_ = hpd0.s57_dlr(0.0313 * srate); h1_ = hpd1.s57_dlr(0.0379 * srate); h2_ = hpd2.s57_dlr(0.0437 * srate); h3_ = hpd3.s57_dlr(0.0531 * srate);
hp_h0 += (h0_ - hp_h0) * hp_hk; hp_h1 += (h1_ - hp_h1) * hp_hk; hp_h2 += (h2_ - hp_h2) * hp_hk; hp_h3 += (h3_ - hp_h3) * hp_hk;
a_ = hp_h0 + hp_h1; b_ = hp_h0 - hp_h1; c_ = hp_h2 + hp_h3; d_ = hp_h2 - hp_h3;
hpd0.s57_dlw((a_ + c_) * 0.5 * hp_hg + hp_hin); hpd1.s57_dlw((b_ + d_) * 0.5 * hp_hg - hp_hin);
hpd2.s57_dlw((a_ - c_) * 0.5 * hp_hg + hp_hin * 0.7); hpd3.s57_dlw((b_ - d_) * 0.5 * hp_hg - hp_hin * 0.7);

// ---------- out ----------
hp_l = (hp_ll * hp_dry + hp_el + hp_sl + (h0_ + h2_ * 0.6) * hp_hw * 0.55) * hp_og;
hp_r = (hp_lr * hp_dry + hp_er + hp_sr + (h1_ + h3_ * 0.6) * hp_hw * 0.55) * hp_og;
hp_vo = max(hp_vo * 0.9995, abs(hp_l) + abs(hp_r));
hp_l = hpoL.ost_band(hp_l); hp_r = hpoR.ost_band(hp_r);
ost_out(hp_l, hp_r);
spl0 = abs(ost_l) < 0.0000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.0000000001 ? 0 : ost_r;

@gfx 1200 800
ui_begin(1200, 800);
s57_pal(0); hp_pal(); s57_hv = 0;
s57_fonts();
s57_face(1200, 800);

// ---------- helpers ----------
// a lit key, lit in signal orange or (blue = 1) the pale blue of the moon
function hp_key(x, y, w, h, on, s, blue) local(k, t, r) (
  k = S57_KEYC; t = S57_KEYT;
  blue ? ( S57_KEYC = HP_MOON; S57_KEYT = 0x15202C; );
  r = s57_key(x, y, w, h, on, s);
  S57_KEYC = k; S57_KEYT = t;
  r;
);
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function hp_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#hp_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#hp_mls, ">"); strcat(#hp_mls, pk_pitem(list, i + 1, #hp_mi)); strcat(#hp_mls, " - ");
                      strcat(#hp_mls, pk_pitem(list, min(s0 + grp, n), #hp_mi)); strcat(#hp_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#hp_mls, "<");
    i == cur ? strcat(#hp_mls, "!");
    strcat(#hp_mls, pk_pitem(list, i + 1, #hp_mi));
    i < n - 1 ? strcat(#hp_mls, "|");
    i += 1; );
  #hp_mls;
);
// a value box: the value in words and a small down-arrow; a click opens the list of every value (list: lo..hi,
// grp > 0 groups it in submenus of grp), the wheel steps it
function hp_mbox(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = s57_hov(x, y, w, h);
  ui_cola(0x000000, 0.14); s57_rr(x + 1, y + 2, w, h, 2);
  ui_col(S57_INK); s57_rr(x, y, w, h, 2);
  ui_col(hov ? S57_KEYH : S57_PLATE); s57_rr(x + 1.2, y + 1.2, w - 2.4, h - 2.4, 1.5);
  gfx_setfont(13); ui_col(S57_INK); s57_tc(x + (w - 11) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 13) * sc, (y + h * 0.5 - 2) * sc, (x + w - 6) * sc, (y + h * 0.5 - 2) * sc, (x + w - 9.5) * sc, (y + h * 0.5 + 2.5) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(hp_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? s57_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( s57_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
// a section's title band: charcoal, cream capitals, a hairline of moon blue beneath
function hp_bar(x, y, w, s, t) (
  ui_col(S57_INK); s57_r(x, y, w, 22); ui_cola(HP_MOON, 0.8); s57_r(x, y + 21, w, 1);
  gfx_setfont(12); ui_col(0xF3EFE5); s57_t(x + 10, y + 3, s); gfx_measurestr(s, tw_, th_);
  strlen(t) ? ( gfx_setfont(13); ui_col(0xB9C9D9); s57_t(x + 20 + tw_ / sc, y + 6, t); );
);
// a crescent: the disc of radius r less a disc of radius r2 set off by (ox, oy); drawn row by row
function hp_crescent(cx, cy, r, r2, ox, oy, col) local(y, hw, dy, hw2, a, b) (
  ui_col(col);
  y = -r; loop(floor(r * 4) + 1,
    hw = sqrt(max(r * r - y * y, 0)); dy = y - oy;
    abs(dy) < r2 ? (
      hw2 = sqrt(r2 * r2 - dy * dy);
      a = ox - hw2; b = ox + hw2;
      a > -hw ? s57_r(cx - hw, cy + y, min(a, hw) + hw, 0.6);
      b < hw ? s57_r(cx + max(b, -hw), cy + y, hw - max(b, -hw), 0.6);
    ) : s57_r(cx - hw, cy + y, hw * 2, 0.6);
    y += 0.5; );
);
// the moon in its phase (ph 0 new .. 0.5 full .. 1 new): the lit part row by row
function hp_luna(cx, cy, r, ph, lit, dark) local(y, hw, t) (
  ui_col(dark); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(lit);
  y = -r; loop(floor(r * 4) + 1,
    hw = sqrt(max(r * r - y * y, 0)); t = hw * cos(2 * $pi * ph);
    ph < 0.5 ? s57_r(cx + t, cy + y, hw - t, 0.6) : s57_r(cx - hw, cy + y, hw - t, 0.6);
    y += 0.5; );
  ui_cola(lit, 0.5); gfx_circle(cx * sc, cy * sc, r * sc, 0, 1);
);
// a pillar: plinth, base mouldings, a fluted shaft, the capital with its lotus; dark (BOAZ) or light (JACHIN)
function hp_pillar(cx, dark, letter) local(w, body, line, ink, i, y0, y1, a, x) (
  w = 44; y0 = 128; y1 = 748;
  body = dark ? HP_BOAZ : HP_JACH; line = dark ? HP_BOAZL : 0xB8B2A6; ink = dark ? 0xF3EFE5 : S57_INK;
  // a soft shadow on the enamel
  ui_cola(0x000000, 0.10); s57_r(cx - w * 0.5 + 4, y0, w, y1 - y0 + 44);
  // the plinth and the base mouldings
  ui_col(S57_INK); s57_r(cx - 34, 770, 68, 26); ui_col(body); s57_r(cx - 33, 771, 66, 24);
  ui_col(S57_INK); s57_rr(cx - 30, 758, 60, 13, 5); ui_col(body); s57_rr(cx - 29, 759, 58, 11, 4);
  ui_col(S57_INK); s57_rr(cx - 26, 748, 52, 11, 4); ui_col(body); s57_rr(cx - 25, 749, 50, 9, 3);
  // the shaft, its flutes
  ui_col(S57_INK); s57_r(cx - w * 0.5 - 1, y0, w + 2, y1 - y0);
  ui_col(body); s57_r(cx - w * 0.5, y0, w, y1 - y0);
  i = 0; loop(5, x = cx - w * 0.5 + 6 + i * 8; ui_col(line); s57_r(x, y0 + 8, 1.2, y1 - y0 - 16);
    ui_cola(dark ? 0x000000 : 0xFFFFFF, dark ? 0.35 : 0.9); s57_r(x + 1.2, y0 + 8, 1, y1 - y0 - 16); i += 1; );
  // the neck bands and the capital (a bell of petals), the lotus bud on top
  ui_col(S57_INK); s57_r(cx - 26, y0 - 8, 52, 8); ui_col(body); s57_r(cx - 25, y0 - 7, 50, 6);
  ui_col(S57_INK); s57_r(cx - 28, y0 - 14, 56, 6); ui_col(body); s57_r(cx - 27, y0 - 13, 54, 4);
  ui_col(S57_INK); gfx_triangle((cx - 30) * sc, (y0 - 14) * sc, (cx + 30) * sc, (y0 - 14) * sc, (cx + 36) * sc, (y0 - 44) * sc, (cx - 36) * sc, (y0 - 44) * sc);
  ui_col(body); gfx_triangle((cx - 28.5) * sc, (y0 - 15) * sc, (cx + 28.5) * sc, (y0 - 15) * sc, (cx + 34.5) * sc, (y0 - 43) * sc, (cx - 34.5) * sc, (y0 - 43) * sc);
  i = 0; loop(7, a = -3 + i; ui_col(line); s57_ln(cx + a * 4, y0 - 16, cx + a * 9.5, y0 - 42, 1.2); i += 1; );
  ui_col(S57_INK); s57_r(cx - 38, y0 - 50, 76, 7); ui_col(body); s57_r(cx - 37, y0 - 49, 74, 5);
  // the lotus: a round bud between two petals
  ui_col(S57_INK); gfx_circle(cx * sc, (y0 - 62) * sc, 13 * sc, 1, 1); ui_col(body); gfx_circle(cx * sc, (y0 - 62) * sc, 11.8 * sc, 1, 1);
  ui_col(line); s57_ln(cx, y0 - 72, cx, y0 - 52, 1.1); s57_ln(cx - 6, y0 - 70, cx - 3, y0 - 52, 1); s57_ln(cx + 6, y0 - 70, cx + 3, y0 - 52, 1);
  ui_col(S57_INK); gfx_triangle((cx - 13) * sc, (y0 - 52) * sc, (cx - 22) * sc, (y0 - 66) * sc, (cx - 7) * sc, (y0 - 55) * sc);
  gfx_triangle((cx + 13) * sc, (y0 - 52) * sc, (cx + 22) * sc, (y0 - 66) * sc, (cx + 7) * sc, (y0 - 55) * sc);
  // the letter, in a cartouche
  ui_col(dark ? HP_BOAZ : HP_JACH); s57_rr(cx - 15, 420, 30, 40, 3);
  ui_col(ink); s57_rr(cx - 15, 420, 30, 40, 3); ui_col(body); s57_rr(cx - 13.5, 421.5, 27, 37, 2);
  gfx_setfont(14); ui_col(ink); s57_tc(cx, 441, letter);
);
// a pomegranate (with its crown) and a palm leaf, for the veil
function hp_pomegranate(x, y, r) (
  ui_col(HP_POM); gfx_circle(x * sc, y * sc, r * sc, 1, 1);
  gfx_triangle((x - r * 0.45) * sc, (y - r * 0.8) * sc, (x + r * 0.45) * sc, (y - r * 0.8) * sc, x * sc, (y - r * 1.55) * sc);
  gfx_triangle((x - r * 0.6) * sc, (y - r * 0.7) * sc, (x - r * 0.05) * sc, (y - r * 0.8) * sc, (x - r * 0.65) * sc, (y - r * 1.4) * sc);
  gfx_triangle((x + r * 0.6) * sc, (y - r * 0.7) * sc, (x + r * 0.05) * sc, (y - r * 0.8) * sc, (x + r * 0.65) * sc, (y - r * 1.4) * sc);
);
function hp_palm(x, y, l) local(i, a) (
  ui_col(HP_LEAF); s57_ln(x, y + l * 0.5, x, y - l * 0.5, 1);
  i = 0; loop(4, a = l * (0.32 - i * 0.18); s57_ln(x, y + a, x - l * 0.32, y + a - l * 0.24, 0.9); s57_ln(x, y + a, x + l * 0.32, y + a - l * 0.24, 0.9); i += 1; );
);

// ---------- the header ----------
ui_col(S57_INK); s57_r(0, 52, 1200, 2);
pk_pextra = "Reset all to defaults";
gk_ = pk_preset(20 * sc, 10 * sc, 420 * sc, 34 * sc, pr_cur, #hp_pm);
gk_ > 0 ? ( gk_ == 13 ? ( load_preset(1); gi_ = 37; loop(13, slider(gi_) = HPDEF[gi_ - 1]; ui_auto(gi_); gi_ += 1; ); pr_cur = 13; ) : load_preset(gk_); );
hp_crescent(540, 28, 11, 9.5, 5, 0, S57_INK); hp_crescent(660, 28, 11, 9.5, -5, 0, S57_INK);
ui_col(S57_INK); s57_rr(570, 10, 60, 36, 3); ui_col(S57_PLATE); s57_rr(572, 12, 56, 32, 2);
ui_col(HP_MOON); s57_r(576, 40, 48, 2);
gfx_setfont(14); ui_col(S57_INK); s57_tc(600, 27, "II");
gfx_setfont(13); ui_col(S57_DIM); s57_t(694, 16, "THE TWO"); s57_t(694, 30, "PILLARS");
gfx_setfont(13); ui_col(S57_INK); s57_t(800, 22, "MIDI"); pk_led(842 * sc, 28 * sc, 4 * sc, ins_midi_lit(), S57_ORNG);
m_ = 0; loop(3, s57_key(860 + m_ * 70, 16, 66, 22, slider39 == m_, m_ == 0 ? "POLY" : m_ == 1 ? "MONO" : "LEGATO") ? s57_set(39, m_); m_ += 1; );
s57_knob(1090, 28, 12, 40, 0, 100, 0, 0, "", "GLIDE %.0f%%", 0);
ui_size_picker(1126 * sc, 18 * sc);

// ---------- the pillars ----------
hp_pillar(40, 1, "B");
hp_pillar(1160, 0, "J");

// ---------- the veil behind the display: pomegranates and palm leaves ----------
ui_cola(HP_VCLOTH, 0.35); s57_r(352, 58, 496, 290);
ui_cola(HP_VCLOTH, 0.6); s57_r(352, 58, 496, 2);
gfx_a = 1;
gj_ = 0; loop(8,
  gi_ = 0; loop(13,
    gxx_ = 364 + gi_ * 40 + (gj_ & 1) * 20; gyy_ = 76 + gj_ * 36;
    gxx_ < 846 ? ( gfx_a = 0.3; ((gi_ + gj_) & 1) ? hp_pomegranate(gxx_, gyy_ + 3, 5) : hp_palm(gxx_, gyy_, 18); );
    gi_ += 1; );
  gj_ += 1; );
gfx_a = 1;
// the veil's fringe
gi_ = 0; loop(62, ui_cola(HP_VCLOTH, 0.55); gfx_circle((355 + gi_ * 8) * sc, 348 * sc, 2.2 * sc, 1, 1); gi_ += 1; );

// ---------- BOAZ ----------
s57_plate(84, 62, 256, 278);
hp_bar(84, 62, 256, "BOAZ", "THE DARK PILLAR");
s57_ks = 1.6; s57_knob(160, 170, 44, 1, 0, 100, 30, 0, "SHAPE", "%.0f%%", 0); s57_ks = 1;
gfx_setfont(13); ui_col(S57_DIM); s57_tc(118, 236, "SAW"); s57_tc(204, 236, "SQUARE");
s57_knob(282, 130, 20, 2, 0, 100, 30, 0, "SUB", "%.0f%%", 0);
s57_knob(282, 226, 20, 3, 0, 100, 35, 0, "WEIGHT", "%.0f%%", 0);
s57_knob(160, 296, 14, 4, -2, 2, 0, 0, "", "%+.0f OCT", 1);
gfx_setfont(13); ui_col(S57_INK); s57_t(182, 290, "OCTAVE");
sprintf(#t_, "%+d", slider4); ui_col(S57_DIM); s57_t(124, 290, #t_);

// ---------- JACHIN ----------
s57_plate(860, 62, 256, 278);
hp_bar(860, 62, 256, "JACHIN", "THE LIGHT PILLAR");
s57_ks = 1.6; s57_knob(1040, 170, 44, 5, 0, 100, 40, 0, "GLASS", "%.0f%%", 0); s57_ks = 1;
gfx_setfont(13); ui_col(S57_DIM); s57_tc(998, 236, "SINE"); s57_tc(1084, 236, "BELL");
s57_knob(918, 130, 20, 7, -50, 50, 7, 0, "DETUNE", "%+.1f ct", 0);
s57_knob(918, 226, 20, 6, -2, 2, 1, 0, "OCTAVE", "%+.0f OCT", 1);
sprintf(#t_, "%+d", slider6); gfx_setfont(13); ui_col(S57_DIM); s57_tc(882, 226, #t_);
// the glass struck: a small bell glyph that rings with the glass
ui_col(S57_INK); gfx_circle(1040 * sc, 300 * sc, 10 * sc, 0, 1);
gi_ = 0; loop(3, ui_cola(HP_MOOND, 0.25 + 0.75 * slider5 / 100 * (gi_ < 1 + slider5 / 40)); gfx_circle(1040 * sc, 300 * sc, (13 + gi_ * 4) * sc, 0, 1); gi_ += 1; );
gfx_setfont(13); ui_col(S57_DIM); s57_t(1068, 294, "STRUCK");

// ---------- the joining of the pillars: CROSS, BALANCE ----------
s57_plate(380, 300, 440, 40);
gfx_setfont(12); ui_col(S57_INK); s57_t(392, 313, "CROSS"); s57_t(612, 313, "BALANCE");
s57_knob(520, 320, 13, 8, -100, 100, 0, 0, "", "%+.0f", 0);
gfx_setfont(13); ui_col(S57_DIM); s57_t(450, 315, "B FM J"); s57_t(540, 315, "J RING B");
ui_cola(S57_INK, 0.3); s57_r(600, 306, 1, 28);
s57_knob(742, 320, 13, 9, 0, 100, 45, 0, "", "%.0f%%", 0);
gfx_setfont(13); ui_col(S57_DIM); s57_t(688, 315, "BOAZ"); s57_t(762, 315, "JACHIN");

// ---------- the display: an arched window, the Veil, the Moon, the descent, the Scroll ----------
x0_ = 380; y0_ = 66; w_ = 440; h_ = 226; ar_ = 28;
// the arch's frame (charcoal), then the dark glass, column by column
gi_ = 0; loop(111, gxx_ = gi_ * 4; gu_ = (gxx_ - w_ * 0.5) / (w_ * 0.5 + 6); gt_ = y0_ - 4 + ar_ * (1 - sqrt(max(1 - gu_ * gu_, 0)));
  ui_col(S57_INK); s57_r(x0_ - 4 + gxx_ * (w_ + 8) / w_, gt_, 4.4, y0_ + h_ + 4 - gt_); gi_ += 1; );
gi_ = 0; loop(111, gxx_ = gi_ * 4; gu_ = (gxx_ + 2 - w_ * 0.5) / (w_ * 0.5); gt_ = y0_ + ar_ * (1 - sqrt(max(1 - gu_ * gu_, 0)));
  ui_col(HP_OLED); s57_r(x0_ + gxx_, gt_, min(4.4, w_ - gxx_), y0_ + h_ - gt_); gi_ += 1; );
ui_cola(HP_MOON, 0.5); gi_ = 0; px_ = x0_; py_ = y0_ + ar_;
loop(45, gxx_ = gi_ * 10; gu_ = (gxx_ - w_ * 0.5) / (w_ * 0.5); gt_ = y0_ + ar_ * (1 - sqrt(max(1 - gu_ * gu_, 0)));
  gi_ > 0 ? s57_ln(px_, py_ + 3, x0_ + gxx_, gt_ + 3, 0.8); px_ = x0_ + gxx_; py_ = gt_; gi_ += 1; );
// (a) the Veil: the ladder's response (and the formants beneath, as the veil is drawn)
fx_ = x0_ + 18; fw_ = 214; fy_ = y0_ + 44; fh_ = 84;
gfx_setfont(13); ui_col(HP_ODIM); s57_t(fx_, y0_ + 26, "THE VEIL");
ui_cola(HP_OINK, 0.08); gi_ = 0; loop(4, s57_r(fx_ + fw_ * (gi_ + 1) * 0.2 - fw_ * 0.1 * 0, fy_, 1, fh_); gi_ += 1; );
ui_cola(HP_OINK, 0.10); s57_r(fx_, fy_ + fh_ * 0.4, fw_, 1);
fc_ = min(slider10 * 2 ^ (hp_coct), 20000); rs_ = slider11 / 100 * 3.9; vv_ = hp_veil;
gi_ = 0; loop(109,
  gf_ = 20 * 1000 ^ (gi_ / 108);
  xr_ = gf_ / fc_; m_ = 1 / sqr(1 + xr_ * xr_); ga_ = -4 * atan(xr_);
  re_ = 1 + rs_ * m_ * cos(ga_); im_ = rs_ * m_ * sin(ga_);
  hl_ = m_ / sqrt(re_ * re_ + im_ * im_) * (1 + 1.3 * slider11 / 100);
  hf_ = 0; gk_ = 0; loop(3, f0_ = hp_vow(hp_vw, gk_); bw_ = gk_ == 0 ? 80 : gk_ == 1 ? 95 : 130; qq_ = f0_ / bw_;
    hf_ += hp_vlev(hp_vw, gk_) / sqrt(1 + qq_ * qq_ * sqr(gf_ / f0_ - f0_ / gf_)); gk_ += 1; );
  hm_ = hl_ * (1 - 0.55 * vv_) + hf_ * vv_ * 1.4;
  db_ = 20 * log10(max(hm_, 0.0001)); db2_ = 20 * log10(max(hf_ * vv_ * 1.4, 0.0001));
  nx_ = fx_ + fw_ * gi_ / 108; ny_ = fy_ + fh_ * 0.4 - min(max(db_, -36), 18) / 54 * fh_ * 0.6 * 1.65; ny_ = min(ny_, fy_ + fh_);
  n2_ = fy_ + fh_ * 0.4 - min(max(db2_, -36), 18) / 54 * fh_ * 0.6 * 1.65; n2_ = min(n2_, fy_ + fh_);
  vv_ > 0.02 ? ( ui_cola(HP_MOON, 0.18 + 0.3 * vv_); s57_r(nx_, n2_, 2, fy_ + fh_ - n2_); );
  gi_ > 0 ? ( ui_cola(HP_OINK, 0.95); s57_ln(px_, py_, nx_, ny_, 1.4); );
  px_ = nx_; py_ = ny_; gi_ += 1; );
