gfx_setfont(12); ui_col(S57_INK); s57_t(32, 578, "MANIFESTATION MACROS");
gi_ = 0; loop(4,
  x_ = 32 + gi_ * 288; gy_ = 600;
  sprintf(#t_, "MAP %d", gi_ + 1);
  s57_key(x_, gy_, 52, 22, mg_map == gi_ + 1, #t_) ? ( mg_map = mg_map == gi_ + 1 ? 0 : gi_ + 1; mg_inv = 0; );
  // the strip (drag along it)
  sx_ = x_ + 60; sw_ = 200;
  ui_col(S57_INK); s57_rr(sx_, gy_ - 2, sw_, 26, 3); ui_col(0x1A1214); s57_rr(sx_ + 2, gy_, sw_ - 4, 22, 2);
  ui_col(S57_ORNG); s57_rr(sx_ + 2, gy_, (sw_ - 4) * slider(30 + gi_) / 100, 22, 2);
  ui_cola(0xFFFFFF, 0.08); s57_r(sx_ + 2, gy_, sw_ - 4, 6);
  s57_hov(sx_, gy_ - 2, sw_, 26) && pressed && drag_id == 0 ? drag_id = 9200 + gi_;
  drag_id == 9200 + gi_ ? ( mouse_cap & 1 ? s57_set(30 + gi_, min(max((mouse_x / sc - sx_ - 2) / (sw_ - 4), 0), 1) * 100) : drag_id = 0; );
  s57_hov(sx_, gy_ - 2, sw_, 26) && mouse_dbl ? s57_set(30 + gi_, 0);
  pk_pitem(#mg_dn, slider(34 + gi_) + 1, #t_); gfx_setfont(13); ui_col(S57_DIM); sprintf(#t2_, "> %s", #t_); s57_t(sx_, gy_ + 28, #t2_);
  gi_ += 1; );

