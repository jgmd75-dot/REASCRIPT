sprintf(#t_, "LEN %d", slider60); mg_mbox(716, 542, 62, 20, 60, 1, 16, #t_, "1 step|2 steps|3 steps|4 steps|5 steps|6 steps|7 steps|8 steps|9 steps|10 steps|11 steps|12 steps|13 steps|14 steps|15 steps|16 steps", 0);
mg_k(800, 552, 9, 43, 10, 100, 60, 0, "", "GATE %.0f%%", 0, 0);

// ---------- the manifestation macros ----------
