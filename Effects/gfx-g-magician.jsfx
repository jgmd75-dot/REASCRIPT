slider74:30<0,100,1>-Bias (%)
slider75:120<40,400,1>-Sat low band (Hz)
slider76:6000<2000,16000,10>-Sat high band (Hz)
slider77:-0.3<-24,0,0.1>-Ceiling (dB)
slider78:1<0,1,1{Off,Clip}>-(unused, output stage)
slider79:58<0,100,0.1>-Level (%)
slider80:1<0,1,1{Run,Follow}>-Arp clock
slider81:prs_sel=0<0,12,1{No preset,Init,Pure Sine Lead,Glass Bells,Gong Field,Breath of Spirit,Intuitive Pad,Fire Pluck,Chaos Engine,Orbiting Organ,Infinity Arp,Manifest Strings,Earth Growl}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-magician";
ext_noinit = 1;
s57_mem = 0;

// ---------- memory ----------
MGV = s57_alloc(8 * 112); MGVN = 8; MGVS = 112;          // the voices
// voice slots (q = MGV + v * MGVS):
//   0 on  1 note  2 velocity 0..1  3 key down  4 stage (1 A 2 D 3 S 4 R)  5 level  6 freq  7 target freq
//   8 .. 15 the partials' phases  16 self-mod memory  17 noise band state 1  18 state 2  19 ladder s1  20 s2  21 s3
//   22 s4  23 svf ic1  24 svf ic2  25 snap transient  26 per-note detune  27 fate offset  28 pan  29 age
//   32 .. 44 the modulated destinations (per voice, 1 .. 12)  45 attack rate  46 decay rate  47 sustain  48 release rate
//   per block: 51 the pitch multiplier  56 .. 63 the partials' ratios  64 .. 71 their weights  72 the normaliser
//   73 noise (c)  74 its bandwidth  75 its frequency  76 chaos  77 ladder g  78 resonance  79 depth  80 high-pass on
//   81 the high-pass's g  84 its k  85 the amp's gain
//   86 87 the amp's declick smoother (two poles)  88 a stolen voice's waiting note + 1  89 its velocity  90 the steal
//   fade (0 .. 1)  91 its key let go while waiting  92 its glide start  93 fading out
//   94 .. 98 the filters' smoothed ladder g, resonance, depth, high-pass g and k (glide per sample to 77 78 79 81 84)
//   99 the ladder g's glide, first stage
MGD = s57_alloc(16); MGM = s57_alloc(16);               // the destinations' base values (0..1) and the global mod
MGDEF = s57_alloc(96); MGTMP = s57_alloc(256);
MGR_L = s57_alloc(16); MGR_A = s57_alloc(16); MGR_T = s57_alloc(16);   // the ring for the arp: level, accent, tie
MGQ = s57_alloc(1024);                                  // the note queue (from MIDI or the arp): offset, on, note, vel
MGHN = s57_alloc(128);                                  // keys down (for the mono / legato note stack)
MGSC = s57_alloc(512);                                  // the display's copy of the source's cycle
MGARP = s57_alloc(4096);
arp_init(MGARP);
// the cosmos (reverb): 8 lines, the shimmer's two taps
mgc0.s57_dlinit(32768); mgc1.s57_dlinit(32768); mgc2.s57_dlinit(32768); mgc3.s57_dlinit(32768);
mgc4.s57_dlinit(32768); mgc5.s57_dlinit(32768); mgc6.s57_dlinit(32768); mgc7.s57_dlinit(32768);
mgca.s57_dlinit(4096); mgcb.s57_dlinit(4096); mgcc.s57_dlinit(4096); mgcd.s57_dlinit(4096);
mgsh.s57_dlinit(16384);
MGCL = s57_alloc(8); MGCD = s57_alloc(8); MGCG = s57_alloc(8); MGCY = s57_alloc(8); MGCP = s57_alloc(8);
MGCL[0] = 37.1; MGCL[1] = 43.9; MGCL[2] = 51.3; MGCL[3] = 59.7; MGCL[4] = 67.1; MGCL[5] = 75.9; MGCL[6] = 83.3; MGCL[7] = 97.7;
// EARTHLY's oversampler
mg_HB = s57_alloc(64); s57_hbdesign(mg_HB, 63, 8);
mguL.s57_upinit(63, mg_HB, 64); mguR.s57_upinit(63, mg_HB, 64); mgdL.s57_dninit(63, mg_HB, 64); mgdR.s57_dninit(63, mg_HB, 64);
// the inharmonic partial ratios (bars, bells, gongs) the harmonics morph into
MGIR = s57_alloc(8);
MGIR[0] = 1; MGIR[1] = 2.32; MGIR[2] = 3.86; MGIR[3] = 5.53; MGIR[4] = 7.41; MGIR[5] = 9.14; MGIR[6] = 11.1; MGIR[7] = 13.6;

ost_init(0); mgoL.ost_ch_init(); mgoR.ost_ch_init();
ins_drift_init();
mg_dfM.drift_init(0.5 + rand(0.3)); mg_dfC.drift_init(0.4 + rand(0.3)); mg_dfF.drift_init(0.3 + rand(0.3));

// ---------- the presets: the Init values and each preset's changes ----------
#mg_def = "20 60 8 0 0 38 25 50 20 75 45 60 100 50 50 1 5 12 2 5 20 0 0 0 0 0 0 0.4 0 0 0 0 0 1 5 10 11 0 0 3 0 2 60 1 0 1 1 2 0 1 0 1 1 0 1 2 0 1 3 16 60 4 25 25 0 0 100 35 -6 0 0 0 0 30 120 6000 -0.3 1 58";
function mg_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
function mg_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
mg_nums(#mg_def, MGDEF);
#mg_pm = "Init|Pure Sine Lead|Glass Bells|Gong Field|Breath of Spirit|Intuitive Pad|Fire Pluck|Chaos Engine|Orbiting Organ|Infinity Arp|Manifest Strings|Earth Growl";
function mg_pstr(p) (
  p == 2  ? "1:0 2:80 3:0 6:52 10:85 11:55 12:40 16:1 17:4 18:2 28:5.5 64:18 65:0 68:30 79:55.7" :
  p == 3  ? "1:58 2:45 3:4 6:60 7:15 10:95 11:30 12:70 17:2 18:-10 19:3 20:5 21:18 62:6 63:45 64:35 79:77" :
  p == 4  ? "1:64 2:20 3:22 4:-1 6:44 7:40 10:92 11:80 17:1 18:15 28:0.08 19:2 20:3 21:25 62:12 63:55 64:45 65:15 79:60.2" :
  p == 5  ? "1:72 2:60 3:6 6:40 7:20 10:10 11:90 16:1 17:1 18:20 28:0.15 19:2 20:5 21:30 62:9 63:30 64:40 79:50.2" :
  p == 6  ? "1:28 2:35 3:6 6:36 7:30 10:15 11:88 16:1 17:5 18:16 28:0.12 19:6 20:1 21:20 62:8 63:40 64:38 79:49.6" :
  p == 7  ? "1:30 2:30 3:12 6:30 7:45 9:35 10:100 11:12 12:80 19:2 20:5 21:45 64:18 79:84.6" :
  p == 8  ? "1:48 2:15 3:70 6:42 7:55 9:60 10:80 11:50 16:1 17:3 18:30 28:2.5 29:4 19:6 20:1 21:30 65:35 67:60 64:22 79:74.6" :
  p == 9  ? "1:22 2:10 3:2 6:62 7:10 10:90 11:52 16:1 17:4 18:3 28:6.5 19:1 20:2 21:20 64:25 65:8 79:79" :
  p == 10 ? "1:34 2:40 3:6 6:34 7:45 10:95 11:20 12:70 38:1 40:3 41:2 42:2 43:55 19:2 20:5 21:35 64:28 63:30 79:92.6" :
  p == 11 ? "1:40 2:45 3:4 4:0 6:46 7:20 10:25 11:80 16:1 17:4 18:2 28:5 19:1 20:2 21:12 62:5 63:20 64:32 79:55.7" :
  p == 12 ? "1:36 2:15 3:30 4:-1 6:28 7:60 9:70 10:85 11:40 12:70 19:2 20:5 21:40 65:55 66:-30 67:80 64:12 79:70.8" :
  "";
);
function mg_pstr_au(p) (
  p == 2  ? "1:0 2:80 3:0 6:52 10:85 11:55 12:40 16:1 17:4 18:2 28:5.5 64:18 65:0 68:30 79:55.7" :
  p == 3  ? "1:58 2:45 3:4 6:60 7:15 10:95 11:30 12:70 17:2 18:-10 19:3 20:5 21:18 62:6 63:45 64:35 79:77" :
  p == 4  ? "1:64 2:20 3:22 4:-1 6:44 7:40 10:92 11:80 17:1 18:15 28:0.08 19:2 20:3 21:25 62:12 63:55 64:45 65:15 79:60.2" :
  p == 5  ? "1:72 2:60 3:6 6:40 7:20 10:10 11:90 16:1 17:1 18:20 28:0.15 19:2 20:5 21:30 62:9 63:30 64:40 79:50.2" :
  p == 6  ? "1:28 2:35 3:6 6:36 7:30 10:15 11:88 16:1 17:5 18:16 28:0.12 19:6 20:1 21:20 62:8 63:40 64:38 79:49.6" :
  p == 7  ? "1:30 2:30 3:12 6:30 7:45 9:35 10:100 11:12 12:80 19:2 20:5 21:45 64:18 79:84.6" :
  p == 8  ? "1:48 2:15 3:70 6:42 7:55 9:60 10:80 11:50 16:1 17:3 18:30 28:2.5 29:4 19:6 20:1 21:30 65:35 67:60 64:22 79:74.6" :
  p == 9  ? "1:22 2:10 3:2 6:62 7:10 10:90 11:52 16:1 17:4 18:3 28:6.5 19:1 20:2 21:20 64:25 65:8 79:79" :
  p == 10 ? "1:34 2:40 3:6 6:34 7:45 10:95 11:20 12:70 38:1 40:3 41:2 42:2 43:55 19:2 20:5 21:35 64:28 63:30 79:92.6" :
  p == 11 ? "1:40 2:45 3:4 4:0 6:46 7:20 10:25 11:80 16:1 17:4 18:2 28:5 19:1 20:2 21:12 62:5 63:20 64:32 79:55.7" :
  p == 12 ? "1:36 2:15 3:30 4:-1 6:28 7:60 9:70 10:85 11:40 12:70 19:2 20:5 21:40 65:55 66:-30 67:80 64:12 79:70.8" :
  "";
);
function load_preset(p) local(n, i) (
  // the MIDI channel, FATE, VOLUME, the voice mode and the output stage stay as they are
  i = 0; loop(67, slider(i + 1) = MGDEF[i]; i += 1; );
  slider71 = MGDEF[70]; slider79 = MGDEF[78];
  n = mg_nums(mg_pstr(p), MGTMP);
  i = 0; loop(floor(n / 2), MGTMP[i * 2] >= 1 && MGTMP[i * 2] <= 79 ? slider(MGTMP[i * 2]) = MGTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(79, ui_auto(i); i += 1; );
  pr_cur = p; mg_panic = 1;
);
function load_preset_au(p) local(n, i) (
  // the MIDI channel, FATE, VOLUME, the voice mode and the output stage stay as they are
  i = 0; loop(67, slider(i + 1) = MGDEF[i]; i += 1; );
  slider71 = MGDEF[70]; slider79 = MGDEF[78];
  n = mg_nums_au(mg_pstr_au(p), MGTMP);
  i = 0; loop(floor(n / 2), MGTMP[i * 2] >= 1 && MGTMP[i * 2] <= 79 ? slider(MGTMP[i * 2]) = MGTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(79, ui_auto(i); i += 1; );
  pr_cur = p; mg_panic = 1;
);

L12 = log(2) / 12;
// ---------- the source: one cycle (for the display), and the per-sample voice ----------
// the shape at MANIFESTATION m: the sine's partners come in (a), bend from harmonic to inharmonic (b), noise (c)
function mg_shape(m) ( mg_a = min(max(m * 3, 0), 1); mg_b = min(max(m * 3 - 1, 0), 1); mg_c = min(max(m * 3 - 2, 0), 1); );
function mg_weight(k, pur) ( k == 0 ? 1 : mg_a * (k + 1) ^ -(0.4 + 1.8 * pur) * (1 + 0.6 * (1 - pur) * ((k & 1) == 0)); );
function mg_ratio(k) ( (k + 1) + (MGIR[k] - (k + 1)) * mg_b; );
// the panel's own copies: @gfx runs in its own thread, alongside @sample, so it must never write anything the audio uses
function mg_gshape(m) ( mg_ga = min(max(m * 3, 0), 1); mg_gb = min(max(m * 3 - 1, 0), 1); mg_gc = min(max(m * 3 - 2, 0), 1); );
function mg_gweight(k, pur) ( k == 0 ? 1 : mg_ga * (k + 1) ^ -(0.4 + 1.8 * pur) * (1 + 0.6 * (1 - pur) * ((k & 1) == 0)); );
function mg_gratio(k) ( (k + 1) + (MGIR[k] - (k + 1)) * mg_gb; );

// the destinations (1 .. 12): base values from the knobs, 0..1
function mg_bases() (
  MGD[1] = slider1 / 100; MGD[2] = slider2 / 100; MGD[3] = slider3 / 100; MGD[4] = 0.5;
  MGD[5] = slider6 / 100; MGD[6] = slider7 / 100; MGD[7] = slider9 / 100; MGD[8] = slider10 / 100; MGD[9] = slider11 / 100;
  MGD[10] = slider64 / 100; MGD[11] = slider65 / 100; MGD[12] = slider79 / 100;
);
// a source's value for voice q (bipolar sources -1..1; unipolar 0..1)
function mg_src(s, q) (
  s == 1 ? mg_orb : s == 2 ? q[5] : s == 3 ? q[2] : s == 4 ? slider14 / 100 * 2 - 1 : s == 5 ? slider15 / 100 * 2 - 1 : s == 6 ? mg_fts : 0;
);
// the per-voice destinations: base + the routings (scaled by GROUNDING) + the macro strips
function mg_mod(q) local(d, i, s, dd) (
  d = 1; loop(12, q[31 + d] = MGD[d] + MGM[d]; d += 1; );
  i = 0; loop(4,
    s = slider(16 + i * 3); dd = slider(17 + i * 3);
    s > 0 && dd > 0 ? q[31 + dd] += mg_src(s, q) * slider(18 + i * 3) / 100 * mg_gnd;
    i += 1; );
  d = 1; loop(12, q[31 + d] = min(max(q[31 + d], 0), 1); d += 1; );
);

// ---------- voices ----------
function mg_free() local(v, q, best, bl) (
  best = -1; bl = 10; v = 0;
  loop(MGVN, q = MGV + v * MGVS; !q[0] ? ( best = v; bl = -1; ) : bl >= 0 && !q[3] && q[5] < bl ? ( bl = q[5]; best = v; ); v += 1; );
  best < 0 ? ( bl = 10; v = 0; loop(MGVN, q = MGV + v * MGVS; q[29] > -bl ? ( bl = -q[29]; best = v; ); v += 1; ); );
  best;
);
function mg_env_set(q) local(w, s, vs, a) (
  // AIR: WILL (attack: 2 s .. 0.5 ms; a hard touch snaps quicker), SPIRIT (decay, sustain, release)
  w = q[39]; s = q[40]; vs = slider12 / 100;
  a = 0.0005 + 2.2 * (1 - w) ^ 2.6;
  a *= 1 - 0.6 * vs * q[2];
  q[45] = 1 / max(a * srate, 1);
  q[46] = s57_kt(0.04 + 5.5 * s * s, srate);
  q[47] = s < 0.5 ? s * 0.5 : 0.25 + (s - 0.5) * 1.4;
  q[48] = s57_kt(0.03 + 4.5 * s * s, srate);
);
// the source and the filters of voice q, for a block (called per block, and at the note-on)
function mg_prep(q) local(f, ws, k, w, kt, inn, lpf, hpf, gh, kh) (
    q[51] = mg_oct * mg_bend * ins_pitch * q[26] * 2 ^ ((q[35] - 0.5) * 2);
    f = q[6] * q[51];
    mg_shape(q[32]); ws = 0; k = 0;
    loop(8, q[56 + k] = k == 0 ? 1 : mg_ratio(k); w = mg_weight(k, q[33]);
      f * q[56 + k] > 0.45 * srate ? w = 0; q[64 + k] = w; ws += w; k += 1; );
    q[72] = 1 / max(ws, 1) ^ 0.75;
    q[73] = mg_c; q[74] = 0.02 + mg_c * mg_c * 1.6;
    q[75] = min(2 * sin($pi * min(f * (1 + mg_c * 3), srate * 0.4) / srate), 1.4);
    q[76] = q[34];
    kt = (f / 261.6) ^ mg_kt; inn = q[36];
    lpf = inn < 0.5 ? 30 * 600 ^ (inn * 2) * kt * 2 ^ ins_cut : 22000;
    hpf = inn > 0.5 ? 15 * 400 ^ ((inn - 0.5) * 2) * kt * 2 ^ ins_cut : 10;
    q[77] = min(1 - exp(-2 * $pi * min(lpf, srate * 0.42) / srate), 0.92);
    q[78] = q[37]; q[79] = q[38];
    q[80] = hpf > 12;
    gh = tan($pi * min(hpf, srate * 0.45) / srate); kh = 2 - 1.9 * q[37];
    q[81] = gh; q[84] = kh;
    q[85] = (1 - slider12 / 100 + slider12 / 100 * q[2]) * q[43] * q[43] * 0.9;
);
function mg_go(q, v, note, vel, f0, legato, fresh) (
  q[7] = 440 * 2 ^ ((note - 69) / 12);
  !legato ? q[6] = f0;
  q[1] = note; q[2] = vel; q[3] = 1;
  !legato ? (
    q[0] = 1; q[4] = 1;
    q[26] = ins_note_detune();
    q[28] = (v & 1 ? 1 : -1) * (0.12 + 0.06 * (v >> 1));
    // a strike: the transient's size grows with WILL and the touch
    q[25] = max(slider10 / 100 - 0.6, 0) * 2.5 * (0.4 + 0.6 * vel);
    mg_mod(q); mg_env_set(q);
    mg_prep(q);
    // from silence: the filters start empty and already at their settings
    fresh ? ( memset(q + 16, 0, 9); q[86] = q[87] = 0; q[94] = q[99] = q[77]; q[95] = q[78]; q[96] = q[79]; q[97] = q[81]; q[98] = q[84]; );
  );
);
function mg_on(note, vel) local(v, q, f, f0, legato) (
  legato = slider70 == 2 && mg_mono_held;
  v = slider70 >= 1 ? 0 : mg_free();
  q = MGV + v * MGVS;
  f = 440 * 2 ^ ((note - 69) / 12);
  // GLIDE: every new note slides from the last one played
  f0 = slider71 > 0 && mg_lastf > 0 ? (slider70 >= 1 && q[0] ? q[6] : mg_lastf) : f;
  mg_lastf = f;
  q[29] = mg_age; mg_age += 1;
  slider70 < 1 && q[0] && q[87] > 0.001 ? (
    // a sounding voice is stolen: it fades out over 3 ms, then the new note starts from silence
    q[88] = note + 1; q[89] = vel; q[92] = f0; q[91] = 0; q[1] = note; q[3] = 1;
    !q[93] ? ( q[93] = 1; q[90] = 0; );
  ) : mg_go(q, v, note, vel, f0, legato, !q[0]);
  ins_midi_hit();
);
function mg_off(note) local(v, q, k, b) (
  slider70 >= 1 ? (
    // MONO / LEGATO: back to the highest key still held, gliding; else release
    q = MGV; b = -1; k = 0; loop(128, MGHN[k] && k != note ? b = k; k += 1; );
    q[0] && q[1] == note ? (
      b >= 0 && slider38 < 0.5 ? ( q[1] = b; q[7] = 440 * 2 ^ ((b - 69) / 12); mg_lastf = q[7]; ) : ( q[3] = 0; !mg_sus ? q[4] = 4; );
    );
  ) : (
    v = 0; loop(MGVN, q = MGV + v * MGVS; q[0] && q[1] == note && q[3] ? ( q[3] = 0; q[88] ? q[91] = 1 : !mg_sus ? q[4] = 4; ); v += 1; );
  );
);
function mg_all_off() local(v, q) ( v = 0; loop(MGVN, q = MGV + v * MGVS; q[3] = 0; q[88] = 0; q[0] ? q[4] = 4; v += 1; ); );

// EARTHLY: a valve curve with a sine fold blended in
function mg_dist(x) local(u) ( u = x * mg_k; (s57_th(u + 0.2) - s57_th(0.2)) * 0.7 + sin(u * 0.9) * 0.3 * mg_ed; );
function mg_update() (
  mg_bases();
  mg_gnd = slider13 / 100;
  mg_oct = 2 ^ slider4 * 2 ^ (slider5 / 12);
  mg_kt = slider8 / 100;
  mg_vol = 10 ^ (slider69 / 20);
  mg_fate = slider68 / 100;
  ost_setup(slider73 / 100, slider74 / 100, slider75, slider76, slider77, 1);
);
function mg_cosmos() local(i, sz) (
  mg_l61 = slider61; mg_l62 = slider62; mg_l63 = slider63;
  sz = 0.5 + 1.0 * slider61 / 100;
  i = 0; loop(8, MGCP[i] = MGCL[i] * sz * srate / 1000; MGCG[i] = 10 ^ (-3 * MGCP[i] / (slider62 * srate)); i += 1; );
  mg_cg = 0.55 / (slider62 / 4) ^ 0.25;
  mg_shi = slider63 / 100;
);
function mg_srinit() (
  mg_sr = srate; mg_sm = s57_kt(0.02, srate); mg_kd = s57_k(7000, srate);
  // the declick: the amp's two-pole smoother (about a 1.3 ms rise), the stolen voice's 3 ms fade, EARTHLY's DC blocker
  mg_dck = s57_kt(0.0004, srate); mg_fk = s57_kt(0.008, srate); mg_gh13 = tan($pi * 13 / srate); mg_kfi = 1 / (0.003 * srate); mg_dcr = 1 - 2 * $pi * 10 / srate;
  mg_cosmos(); ost_init(0);
);
mg_update(); mg_srinit();

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// ---------- the card's palette: the crimson robe, the green of the leaves, gold for the tools ----------
function mg_pal() (
  S57_FACE = 0x140D0E; S57_FACEX = 0x2C1D1D; S57_WELL = 0x1A1517; S57_PLATE = 0x2A1518;
  S57_INK = 0xEADFC8; S57_DIM = 0x9E8C74; S57_GRID = 0xC9A24A; S57_GRA = 0.035;
  S57_ORNG = 0xC0222E; S57_ORNGL = 0xD43C48; S57_KEYC = 0xA81C28; S57_KEYT = 0xF6ECD8; S57_IDX = 0xA81C28; S57_NDL = 0xC0222E;
  S57_CREAM = 0xE6DAC0; S57_AMB = 0xD8A63E; S57_AMBW = 0xC9A24A; S57_AMBD = 0x24502C; S57_KEYH = 0x24382A;
  MG_GOLD = 0xC9A24A; MG_LEAF = 0x3F7A45; MG_LEAFD = 0x23492B; MG_ROSE = 0xA81C2A; MG_ROSED = 0x5E0D17; MG_STEEL = 0xD6D0C2;
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
mg_update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset_au(k); prs_sl();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
srate != mg_sr ? mg_srinit();
mg_update();
(slider61 != mg_l61 || slider62 != mg_l62 || slider63 != mg_l63) ? mg_cosmos();
mg_panic ? ( mg_all_off(); arp_flush(); mg_panic = 0; );
// FATE: the instrument drift (tuning, filter), the source's shape, and the matrix source
ins_drift_block(mg_fate, samplesblock);
mg_di = 0.12 * (0.5 + mg_fate) * samplesblock / srate;
mg_fm = mg_fate * 0.06 * mg_dfM.drift_tick(mg_di);
mg_fts = mg_dfF.drift_tick(mg_di * 0.7);
// ORBIT: the LFO (block rate is fine for its speeds); the macro strips; the global modulations
mg_op += slider28 * samplesblock / srate; mg_op >= 1 ? ( mg_op -= floor(mg_op); mg_osh = rand(2) - 1; );
mg_orb = slider29 == 0 ? sin(2 * $pi * mg_op) : slider29 == 1 ? 1 - 4 * abs(mg_op - 0.5) : slider29 == 2 ? 2 * mg_op - 1 : slider29 == 3 ? (mg_op < 0.5 ? 1 : -1) : mg_osh;
memset(MGM, 0, 16);
i_ = 0; loop(4, d_ = slider(34 + i_); d_ > 0 ? MGM[d_] += slider(30 + i_) / 100 * (1 - MGD[d_]); i_ += 1; );
MGM[1] += mg_fm;
// the global destinations (COSMOS, EARTH): their own routings with the global sources (and the loudest voice's breath)
mg_gC = MGD[10] + MGM[10]; mg_gE = MGD[11] + MGM[11];
i_ = 0; loop(4,
  s_ = slider(16 + i_ * 3); d_ = slider(17 + i_ * 3); dp_ = slider(18 + i_ * 3) / 100 * mg_gnd;
  v_ = s_ == 1 ? mg_orb : s_ == 2 ? mg_benv : s_ == 3 ? mg_bvel : s_ == 4 ? slider14 / 100 * 2 - 1 : s_ == 5 ? slider15 / 100 * 2 - 1 : s_ == 6 ? mg_fts : 0;
  d_ == 10 ? mg_gC += v_ * dp_; d_ == 11 ? mg_gE += v_ * dp_;
  i_ += 1; );
mg_gC = min(max(mg_gC, 0), 1); mg_gE = min(max(mg_gE, 0), 1);
// the ring for the arp
i_ = 0; loop(16, st_ = slider(44 + i_); MGR_L[i_] = st_ == 1 || st_ == 2 ? 1 : 0; MGR_A[i_] = st_ == 2; MGR_T[i_] = st_ == 3; i_ += 1; );
arp_pattern(MGR_L, MGR_A, MGR_T);
mg_rb = slider40 == 0 ? 1 : slider40 == 1 ? 0.5 : slider40 == 2 ? 1 / 3 : slider40 == 3 ? 0.25 : slider40 == 4 ? 1 / 6 : 0.125;
arp_params(slider41, mg_rb, slider42, slider43 / 100, 0, slider60, slider39 >= 0.5, 1, 0, 0, 0, 100, 25);

// ---------- MIDI: into the arp, or straight into the queue ----------
mg_qn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, slider72) ? (
    st_ = m1 & 0xF0;
    st_ == 0x90 && m3 > 0 ? (
      MGHN[m2] = 1; mg_mono_held = 0; i_ = 0; loop(128, MGHN[i_] && i_ != m2 ? mg_mono_held = 1; i_ += 1; );
      slider38 >= 0.5 ? arp_key(m2, m3, 0, 1) : mg_qn < 250 ? ( MGQ[mg_qn * 4] = mofs; MGQ[mg_qn * 4 + 1] = 1; MGQ[mg_qn * 4 + 2] = m2; MGQ[mg_qn * 4 + 3] = m3 / 127; mg_qn += 1; );
    ) : st_ == 0x80 || (st_ == 0x90 && m3 == 0) ? (
      MGHN[m2] = 0;
      slider38 >= 0.5 ? arp_key(m2, 0, 0, 0) : mg_qn < 250 ? ( MGQ[mg_qn * 4] = mofs; MGQ[mg_qn * 4 + 1] = 0; MGQ[mg_qn * 4 + 2] = m2; MGQ[mg_qn * 4 + 3] = 0; mg_qn += 1; );
    ) : st_ == 0xE0 ? ( mg_bend = ins_bend(m2, m3, 2); ) :
    st_ == 0xB0 ? (
      m2 == 1 ? ( slider15 = m3 / 127 * 100; ) :
      m2 == 64 ? ( mg_sus = m3 >= 64; !mg_sus ? ( v_ = 0; loop(MGVN, q_ = MGV + v_ * MGVS; q_[0] && !q_[3] && q_[4] < 4 ? q_[4] = 4; v_ += 1; ); ); ) :
      m2 == 120 || m2 == 123 ? ( mg_all_off(); memset(MGHN, 0, 128); arp_flush(); );
    );
  );
  midisend(mofs, m1, m2, m3);
);
!mg_bend ? mg_bend = 1;
// the arp's notes for this block
slider38 >= 0.5 ? (
  // FOLLOW: locked to REAPER's bars while it plays (free from the first key when stopped); RUN: always its own clock
  // from the first key, at the project tempo, whatever REAPER does
  arp_block(slider80 >= 0.5 ? play_state & 1 : 0, beat_position, tempo, samplesblock);
  i_ = 0; loop(arp_outn,
    mg_qn < 250 ? ( MGQ[mg_qn * 4] = arp_out_ofs[i_]; MGQ[mg_qn * 4 + 1] = arp_out_on[i_]; MGQ[mg_qn * 4 + 2] = arp_out_note[i_]; MGQ[mg_qn * 4 + 3] = arp_out_vel[i_] / 127; mg_qn += 1; );
    i_ += 1; );
) : ( mg_arpw ? ( arp_flush(); mg_all_off(); ); );
mg_arpw = slider38 >= 0.5;
// sort the queue by offset (MIDI and the arp may interleave)
i_ = 1; loop(mg_qn - 1, k_ = i_;
  while (k_ > 0 && MGQ[(k_ - 1) * 4] > MGQ[k_ * 4]) ( j_ = 0; loop(4, t_ = MGQ[k_ * 4 + j_]; MGQ[k_ * 4 + j_] = MGQ[(k_ - 1) * 4 + j_]; MGQ[(k_ - 1) * 4 + j_] = t_; j_ += 1; ); k_ -= 1; );
  i_ += 1; );
mg_qr = 0; mg_sp = 0;
// per-block voice control: the destinations, the envelope rates (SPIRIT moves live), the filters' cutoffs
mg_benv = 0; mg_bvel = 0; mg_nact = 0;
v_ = 0; loop(MGVN,
  q_ = MGV + v_ * MGVS;
  q_[0] ? (
    mg_nact += 1;
    mg_mod(q_);
    q_[46] = s57_kt(0.04 + 5.5 * q_[40] * q_[40], srate);
    q_[47] = q_[40] < 0.5 ? q_[40] * 0.5 : 0.25 + (q_[40] - 0.5) * 1.4;
    q_[48] = s57_kt(0.03 + 4.5 * q_[40] * q_[40], srate);
    q_[5] > mg_benv ? ( mg_benv = q_[5]; mg_bvel = q_[2]; );
    mg_prep(q_);
  );
  v_ += 1; );
mg_glk = slider71 > 0 ? s57_kt(0.005 + 0.6 * (slider71 / 100) ^ 2, srate) : 1;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- the queue ----------
while (mg_qr < mg_qn && (MGQ[mg_qr * 4] <= mg_sp || mg_sp >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  MGQ[mg_qr * 4 + 1] ? mg_on(MGQ[mg_qr * 4 + 2], MGQ[mg_qr * 4 + 3]) : mg_off(MGQ[mg_qr * 4 + 2]);
  mg_qr += 1;
);
mg_sp += 1;

// ---------- the voices ----------
mg_l = mg_r = 0;
v_ = 0;
loop(MGVN,
  q_ = MGV + v_ * MGVS;
  q_[0] ? (
    // AIR: the envelope (a straight attack, an exponential decay and release; the transient decays fast)
    q_[4] == 1 ? ( q_[5] += q_[45]; q_[5] >= 1 ? ( q_[5] = 1; q_[4] = 2; ); ) :
    q_[4] == 2 ? ( q_[5] += (q_[47] - q_[5]) * q_[46]; abs(q_[5] - q_[47]) < 0.0005 ? q_[4] = 3; ) :
    q_[4] == 3 ? ( q_[5] = q_[47]; ) :
    ( q_[5] -= q_[5] * q_[48]; q_[5] < 0.00005 && q_[87] < 0.0002 && !q_[93] ? ( q_[0] = 0; q_[5] = 0; ); );
    q_[25] *= 0.9985;
    // a stolen voice: its fade done, the waiting note starts from silence (or the voice ends, if all notes went off)
    q_[93] ? ( q_[90] += mg_kfi; q_[90] >= 1 ? ( q_[93] = 0; q_[90] = 0; q_[5] = 0; q_[25] = 0; q_[86] = 0; q_[87] = 0;
      q_[88] ? ( mg_go(q_, v_, q_[88] - 1, q_[89], q_[92], 0, 1); q_[88] = 0; q_[91] ? ( q_[3] = 0; !mg_sus ? q_[4] = 4; ); ) : q_[0] = 0;
    ); );
    // FIRE: the partials (their ratios and weights set per block), CHAOS feeding the output back into the phases
    q_[6] += (q_[7] - q_[6]) * mg_glk;
    inc_ = q_[6] * q_[51] / srate;
    ch_ = q_[76]; fbk_ = q_[16] * ch_ * ch_ * 1.6;
    y_ = 0; k_ = 0; p_ = q_ + 8;
    loop(8,
      w_ = q_[64 + k_];
      w_ > 0.0001 ? ( p_[0] += inc_ * q_[56 + k_]; p_[0] -= floor(p_[0]); y_ += sin(6.283185307 * p_[0] + fbk_ * (k_ + 1) * 0.35) * w_; );
      p_ += 1; k_ += 1; );
    y_ *= q_[72];
    // into noise: a band of noise round the note, opening into pure noise
    c_ = q_[73];
    c_ > 0 ? (
      n_ = rand(2) - 1;
      q_[17] += q_[75] * q_[18]; hp_ = n_ - q_[17] - q_[74] * q_[18]; q_[18] += q_[75] * hp_;
      y_ = y_ * (1 - c_) + (q_[18] * (0.5 + 1.5 * (1 - c_)) + n_ * c_ * c_ * 0.35) * c_;
    );
    // CHAOS also overloads the source
    ch_ > 0.02 ? y_ = s57_th(y_ * (1 + 4 * ch_)) / (1 + 1.5 * ch_);
    q_[16] = y_;
    // WATER: the ladder (DEPTH drives it) and the high-pass
    // (the cutoffs, resonance and depth glide per sample (8 ms; the ladder's cutoff in two stages) to the block's values:
    // no steps when they are modulated or a knob is turned)
    q_[99] += (q_[77] - q_[99]) * mg_fk; q_[94] += (q_[99] - q_[94]) * mg_fk; q_[95] += (q_[78] - q_[95]) * mg_fk; q_[96] += (q_[79] - q_[96]) * mg_fk;
    q_[97] += (q_[81] - q_[97]) * mg_fk; q_[98] += (q_[84] - q_[98]) * mg_fk;
    rs_ = q_[95]; dp_ = q_[96]; g_ = q_[94];
    // (with the cutoff near the top, the one-sample feedback would ring at Nyquist: held below that)
    // (the level then kept as it was: the passband's gain follows the full feedback)
    kf_ = rs_ * 3.9; ku_ = g_ > 0.8 ? ( kc_ = (2 - g_) / g_; kc_ *= kc_; min(kf_, 0.85 * kc_ * kc_); ) : kf_;
    u_ = s57_th(y_ * (1 + 3 * dp_) - ku_ * q_[22]);
    q_[19] += g_ * (u_ - q_[19]); q_[20] += g_ * (q_[19] - q_[20]); q_[21] += g_ * (q_[20] - q_[21]); q_[22] += g_ * (q_[21] - q_[22]);
    y_ = q_[22] * (1 + 0.4 * kf_) / (1 + 1.2 * dp_);
    ku_ < kf_ ? y_ *= (1 + ku_) / (1 + kf_);
    q_[80] || q_[97] > mg_gh13 ? (
      gh_ = q_[97]; ha_ = 1 / (1 + gh_ * (gh_ + q_[98])); hb_ = gh_ * ha_;
      v3_ = y_ - q_[24]; v1_ = ha_ * q_[23] + hb_ * v3_; v2_ = q_[24] + hb_ * q_[23] + gh_ * hb_ * v3_;
      q_[23] = 2 * v1_ - q_[23]; q_[24] = 2 * v2_ - q_[24];
      y_ = y_ - q_[98] * v1_ - v2_;
    ) : ( q_[23] = 0; q_[24] = 0; );
    // the amp: the envelope, the touch, LEVEL (routable), the strike's transient - smoothed (two poles, ~1.3 ms), so
    // no note starts, restrikes or changes its touch with a step; a stolen voice fades out (smoothstep) first
    g_ = (q_[5] + q_[25] * (1 - q_[5] * 0.5)) * q_[85];
    q_[86] += (g_ - q_[86]) * mg_dck; q_[87] += (q_[86] - q_[87]) * mg_dck;
    y_ *= q_[93] ? q_[87] * (1 - q_[90] * q_[90] * (3 - 2 * q_[90])) : q_[87];
    mg_l += y_ * (1 - q_[28]); mg_r += y_ * (1 + q_[28]);
  );
  v_ += 1;
);

// ---------- EARTHLY: valve and fold, oversampled 2x ----------
mg_gEs += (mg_gE - mg_gEs) * mg_sm; mg_gCs += (mg_gC - mg_gCs) * mg_sm; mg_vols += (mg_vol - mg_vols) * mg_sm;
mg_ed = mg_gEs;
mg_ed > 0.001 ? (
  mg_k = 1 + 12 * mg_ed * mg_ed;
  mguL.s57_up(mg_l); mguR.s57_up(mg_r);
  mg_dl = mgdL.s57_dn(mg_dist(mguL.o0), mg_dist(mguL.o1)) / (1 + mg_ed * 2.2);
  mg_dr = mgdR.s57_dn(mg_dist(mguR.o0), mg_dist(mguR.o1)) / (1 + mg_ed * 2.2);
  mg_tk = s57_k(1500 * 2 ^ ((slider66 + 100) / 200 * 4), srate);
  mg_tl += (mg_dl - mg_tl) * mg_tk; mg_tr += (mg_dr - mg_tr) * mg_tk;
  // the valve's bias leaves a DC step that follows the notes: blocked (10 Hz)
  mg_hl = mg_tl - mg_xl + mg_dcr * mg_hl; mg_xl = mg_tl; mg_hr = mg_tr - mg_xr + mg_dcr * mg_hr; mg_xr = mg_tr;
  mg_em += (slider67 / 100 - mg_em) * mg_sm;
  mg_l += (mg_hl - mg_l) * mg_em; mg_r += (mg_hr - mg_r) * mg_em;
);

// ---------- COSMIC: a wide reverb with an octave shimmer fed back ----------
mg_in = (mg_l + mg_r) * 0.5;
// the shimmer: two taps sweeping through a short line at double speed, crossfaded (an octave up)
mgsh.s57_dlw(mg_in + mg_shf);
mg_sph += 1 / (0.08 * srate); mg_sph >= 1 ? mg_sph -= 1;
mg_t1 = mg_sph; mg_t2 = mg_sph + 0.5; mg_t2 >= 1 ? mg_t2 -= 1;
mg_sv = mgsh.s57_dlr(2 + mg_t1 * 0.08 * srate) * sin($pi * mg_t1) + mgsh.s57_dlr(2 + mg_t2 * 0.08 * srate) * sin($pi * mg_t2);
mg_ci = mg_in + mg_sv * mg_shi * 0.6;
mg_il = mgcb.s57_ap(mgca.s57_ap(mg_ci, 141, 0.7), 211, 0.7);
mg_ir = mgcd.s57_ap(mgcc.s57_ap(mg_ci, 173, 0.7), 257, 0.7);
mg_cm += 0.33 / srate; mg_cm >= 1 ? mg_cm -= 1;
MGCY[0] = mgc0.s57_dlr(MGCP[0] + 6 * sin(2 * $pi * mg_cm)); MGCY[1] = mgc1.s57_dlr(MGCP[1]);
MGCY[2] = mgc2.s57_dlr(MGCP[2] - 6 * sin(2 * $pi * mg_cm + 1)); MGCY[3] = mgc3.s57_dlr(MGCP[3]);
MGCY[4] = mgc4.s57_dlr(MGCP[4] + 5 * cos(2 * $pi * mg_cm)); MGCY[5] = mgc5.s57_dlr(MGCP[5]);
MGCY[6] = mgc6.s57_dlr(MGCP[6]); MGCY[7] = mgc7.s57_dlr(MGCP[7] - 5 * cos(2 * $pi * mg_cm));
i_ = 0; loop(8, MGCD[i_] += (MGCY[i_] - MGCD[i_]) * mg_kd; MGCY[i_] = MGCD[i_] * MGCG[i_]; i_ += 1; );
mg_wl = MGCY[0] - MGCY[2] + MGCY[4] - MGCY[6]; mg_wr = MGCY[1] - MGCY[3] + MGCY[5] - MGCY[7];
mh_a = MGCY[0] + MGCY[1]; mh_b = MGCY[0] - MGCY[1]; mh_c = MGCY[2] + MGCY[3]; mh_e = MGCY[2] - MGCY[3];
mh_f = MGCY[4] + MGCY[5]; mh_g = MGCY[4] - MGCY[5]; mh_h = MGCY[6] + MGCY[7]; mh_j = MGCY[6] - MGCY[7];
MGCY[0] = mh_a + mh_c; MGCY[2] = mh_a - mh_c; MGCY[1] = mh_b + mh_e; MGCY[3] = mh_b - mh_e;
MGCY[4] = mh_f + mh_h; MGCY[6] = mh_f - mh_h; MGCY[5] = mh_g + mh_j; MGCY[7] = mh_g - mh_j;
mh_a = MGCY[0]; MGCY[0] = (mh_a + MGCY[4]) * 0.35355339; MGCY[4] = (mh_a - MGCY[4]) * 0.35355339;
mh_a = MGCY[1]; MGCY[1] = (mh_a + MGCY[5]) * 0.35355339; MGCY[5] = (mh_a - MGCY[5]) * 0.35355339;
mh_a = MGCY[2]; MGCY[2] = (mh_a + MGCY[6]) * 0.35355339; MGCY[6] = (mh_a - MGCY[6]) * 0.35355339;
mh_a = MGCY[3]; MGCY[3] = (mh_a + MGCY[7]) * 0.35355339; MGCY[7] = (mh_a - MGCY[7]) * 0.35355339;
mgc0.s57_dlw(MGCY[0] + mg_il); mgc1.s57_dlw(MGCY[1] + mg_ir); mgc2.s57_dlw(MGCY[2] + mg_il * 0.6); mgc3.s57_dlw(MGCY[3] - mg_ir * 0.6);
mgc4.s57_dlw(MGCY[4]); mgc5.s57_dlw(MGCY[5]); mgc6.s57_dlw(MGCY[6] - mg_il * 0.4); mgc7.s57_dlw(MGCY[7] + mg_ir * 0.4);
mg_shf = s57_th((mg_wl + mg_wr) * 0.5 * mg_shi * 0.3 * min(1, 1.2 / slider62));   // fed from the tail (held below runaway)
mg_wl *= mg_cg; mg_wr *= mg_cg;
mg_gd = min(1, 2 - 2 * mg_gCs); mg_gw = min(1, 2 * mg_gCs);
mg_l = mg_l * mg_gd + mg_wl * mg_gw; mg_r = mg_r * mg_gd + mg_wr * mg_gw;

// ---------- out ----------
mg_l *= mg_vols; mg_r *= mg_vols;
mg_vo = max(mg_vo * 0.9995, abs(mg_l) + abs(mg_r));
mg_l = mgoL.ost_band(mg_l); mg_r = mgoR.ost_band(mg_r);
ost_out(mg_l, mg_r);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 1200 800
ui_begin(1200, 800);
s57_pal(0); mg_pal(); s57_hv = 1;
s57_fonts();
s57_face(1200, 800);
#mg_dn = "-|MANIFEST|PURITY|CHAOS|PITCH|INTUIT|RESONANCE|DEPTH|WILL|SPIRIT|COSMOS|EARTH|VOLUME";
#mg_sn = "OFF|ORBIT|BREATH|VELOCITY|PAD X|PAD Y|FATE";

// a plate in the card's colours: a fine gold rule along the top in place of the enamel's white
function mg_plate(x, y, w, h) (
  ui_cola(0x000000, 0.35); s57_rr(x + 1, y + 3, w, h, 3);
  ui_col(S57_PLATE); s57_rr(x, y, w, h, 3);
  ui_cola(MG_GOLD, 0.35); s57_r(x + 3, y, w - 6, 1);
  ui_cola(0x000000, 0.4); s57_r(x + 3, y + h - 1, w - 6, 1);
);
// a leaf: base (x, y), pointing at angle a
function mg_leaf(x, y, a, l, w, col) local(ca, sa, mx, my, tx, ty) (
  ca = cos(a); sa = sin(a); mx = x + ca * l * 0.45; my = y + sa * l * 0.45; tx = x + ca * l; ty = y + sa * l;
  ui_col(col);
  gfx_triangle(x * sc, y * sc, (mx - sa * w) * sc, (my + ca * w) * sc, tx * sc, ty * sc);
  gfx_triangle(x * sc, y * sc, (mx + sa * w) * sc, (my - ca * w) * sc, tx * sc, ty * sc);
  ui_col(MG_LEAFD); s57_ln(x, y, x + ca * l * 0.85, y + sa * l * 0.85, 0.8);
);
// a red rose, seen from above
function mg_rose(cx, cy, r) local(i, a) (
  ui_col(MG_ROSED); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  i = 0; loop(5, a = i * 2 * $pi / 5 - 0.5 * $pi; ui_col(MG_ROSE); gfx_circle((cx + cos(a) * r * 0.42) * sc, (cy + sin(a) * r * 0.42) * sc, r * 0.56 * sc, 1, 1); i += 1; );
  i = 0; loop(5, a = i * 2 * $pi / 5 - 0.5 * $pi + $pi / 5; ui_col(MG_ROSED); s57_ln(cx + cos(a) * r * 0.45, cy + sin(a) * r * 0.45, cx + cos(a) * r * 0.98, cy + sin(a) * r * 0.98, 1); i += 1; );
  ui_col(MG_ROSED); gfx_circle(cx * sc, cy * sc, r * 0.56 * sc, 1, 1);
  ui_col(0xC8303C); gfx_circle((cx - r * 0.06) * sc, (cy - r * 0.06) * sc, r * 0.42 * sc, 1, 1);
  ui_col(MG_ROSED); gfx_circle((cx + r * 0.04) * sc, (cy + r * 0.03) * sc, r * 0.22 * sc, 1, 1);
  ui_col(0xC8303C); gfx_circle((cx + r * 0.0) * sc, (cy - r * 0.02) * sc, r * 0.1 * sc, 1, 1);
);
// a rose on its sprig of leaves
function mg_sprig(cx, cy, r, a) (
  mg_leaf(cx, cy, a - 0.55, r * 3.2, r * 0.8, MG_LEAF); mg_leaf(cx, cy, a + 0.55, r * 2.8, r * 0.7, MG_LEAF);
  mg_rose(cx, cy, r);
);

// ---------- helpers ----------
// a knob that can be INVOKEd (routed) or MAPped (to a macro strip); dst = its destination number (0 = none)
function mg_k(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp, dst) local(dx, dy, hov, i, slot, routed) (
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  dst > 0 && (mg_inv || mg_map > 0) ? (
    ui_cola(S57_ORNG, hov ? 0.35 : 0.14); gfx_circle(cx * sc, cy * sc, (r + 10) * sc, 1, 1);
    hov && pressed && drag_id == 0 ? (
      drag_id = -1;
      mg_map > 0 ? ( s57_set(33 + mg_map, dst); mg_map = 0; ) : mg_isrc > 0 ? (
        slot = -1; i = 0; loop(4, slider(16 + i * 3) == mg_isrc && slider(17 + i * 3) == dst ? slot = i; i += 1; );
        slot < 0 ? ( i = 0; loop(4, slot < 0 && slider(16 + i * 3) == 0 ? slot = i; i += 1; ); );
        slot < 0 ? ( slot = mg_rot; mg_rot = (mg_rot + 1) % 4; );
        s57_set(16 + slot * 3, mg_isrc); s57_set(17 + slot * 3, dst); s57_set(18 + slot * 3, 0);
        mg_aslot = slot;
      );
    );
  );
  s57_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp);
  // routed: a small orange mark at the knob's foot (one per routing)
  routed = 0; i = 0; loop(4, slider(16 + i * 3) > 0 && slider(17 + i * 3) == dst && dst > 0 ? routed += 1; i += 1; );
  i = 0; loop(4, slider(34 + i) == dst && dst > 0 ? routed += 1; i += 1; );
  routed ? ( ui_col(S57_ORNG); i = 0; loop(routed, gfx_circle((cx + r * 0.75 + i * 6) * sc, (cy - r * 0.85) * sc, 2.2 * sc, 1, 1); i += 1; ); );
);
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function mg_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#mg_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#mg_mls, ">"); strcat(#mg_mls, pk_pitem(list, i + 1, #mg_mi)); strcat(#mg_mls, " - ");
                      strcat(#mg_mls, pk_pitem(list, min(s0 + grp, n), #mg_mi)); strcat(#mg_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#mg_mls, "<");
    i == cur ? strcat(#mg_mls, "!");
    strcat(#mg_mls, pk_pitem(list, i + 1, #mg_mi));
    i < n - 1 ? strcat(#mg_mls, "|");
    i += 1; );
  #mg_mls;
);
// a value box: the value in words and a small down-arrow; a click opens the list of every value (list: lo..hi,
// grp > 0 groups it in submenus of grp), the wheel steps it
function mg_mbox(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = s57_hov(x, y, w, h);
  ui_cola(0x000000, 0.14); s57_rr(x + 1, y + 2, w, h, 2);
  ui_col(S57_INK); s57_rr(x, y, w, h, 2);
  ui_col(hov ? S57_KEYH : S57_PLATE); s57_rr(x + 1.2, y + 1.2, w - 2.4, h - 2.4, 1.5);
  gfx_setfont(13); ui_col(S57_INK); s57_tc(x + (w - 11) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 13) * sc, (y + h * 0.5 - 2) * sc, (x + w - 6) * sc, (y + h * 0.5 - 2) * sc, (x + w - 9.5) * sc, (y + h * 0.5 + 2.5) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(mg_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? s57_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( s57_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
// a section title bar in the card style: charcoal band, cream capitals
function mg_bar(x, y, w, s, t) (
  ui_col(0x5E0D17); s57_r(x, y, w, 22); ui_cola(MG_GOLD, 0.5); s57_r(x, y + 21, w, 1);
  gfx_setfont(12); ui_col(0xF3E8D2); s57_t(x + 10, y + 3, s); gfx_measurestr(s, tw_, th_);
  strlen(t) ? ( gfx_setfont(13); ui_col(0xC9A27A); s57_t(x + 20 + tw_ / sc, y + 6, t); );
);
// the infinity glyph
function mg_inf(cx, cy, s, col) local(i, t, x1, y1, x2, y2) (
  ui_col(col); i = 0; x1 = cx; y1 = cy;
  loop(41, t = i / 40 * 2 * $pi; x2 = cx + s * sin(t) / (1 + sqr(cos(t))); y2 = cy + s * sin(t) * cos(t) / (1 + sqr(cos(t)));
    i > 0 ? s57_ln(x1, y1, x2, y2, 1.8); x1 = x2; y1 = y2; i += 1; );
);

// ---------- the header ----------
ui_col(MG_GOLD); s57_r(0, 52, 1200, 2);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
gk_ = pk_preset(20 * sc, 10 * sc, 420 * sc, 34 * sc, pr_cur, #mg_pm);
gk_ > 0 ? ( gk_ == 13 ? ( load_preset(1); gi_ = 68; loop(11, slider(gi_) = MGDEF[gi_ - 1]; ui_auto(gi_); gi_ += 1; ); pr_cur = 13; ) : prs_dirty = gk_; );
mg_inf(536, 28, 22, MG_GOLD); mg_inf(664, 28, 22, MG_GOLD);
ui_col(MG_GOLD); s57_rr(570, 10, 60, 36, 3); ui_col(S57_PLATE); s57_rr(572, 12, 56, 32, 2);
gfx_setfont(14); ui_col(S57_INK); s57_tc(600, 28, "I");
gfx_setfont(13); ui_col(S57_DIM); s57_t(700, 16, "ELEMENTAL"); s57_t(700, 30, "SYNTHESIS");
gfx_setfont(13); ui_col(S57_INK); s57_t(800, 22, "MIDI"); pk_led(842 * sc, 28 * sc, 4 * sc, ins_midi_lit(), S57_ORNG);
m_ = 0; loop(3, s57_key(860 + m_ * 70, 16, 66, 22, slider70 == m_, m_ == 0 ? "POLY" : m_ == 1 ? "MONO" : "LEGATO") ? s57_set(70, m_); m_ += 1; );
mg_k(1090, 28, 12, 71, 0, 100, 0, 0, "", "GLIDE %.0f%%", 0, 0);
ui_size_picker(1126 * sc, 18 * sc);

// ---------- FIRE ----------
mg_plate(20, 64, 340, 250);
mg_bar(20, 64, 340, "FIRE", "THE SOURCE");
s57_ks = 2.2; mg_k(112, 186, 50, 1, 0, 100, 20, 0, "MANIFEST", "%.0f%%", 0, 1); s57_ks = 1;
gfx_setfont(13); ui_col(S57_DIM);
s57_tc(50, 250, "SINE"); s57_tc(46, 118, "ADDITIVE"); s57_tc(178, 118, "COMPLEX"); s57_tc(178, 250, "NOISE");
mg_k(250, 140, 20, 2, 0, 100, 60, 0, "PURITY", "%.0f%%", 0, 2);
mg_k(250, 236, 20, 3, 0, 100, 8, 0, "CHAOS", "%.0f%%", 0, 3);
mg_k(322, 140, 14, 4, -2, 2, 0, 0, "OCTAVE", "%+.0f", 1, 0);
mg_k(322, 236, 14, 5, -12, 12, 0, 0, "TUNE", "%+.2f st", 0, 4);

// ---------- WATER ----------
mg_plate(840, 64, 340, 250);
mg_bar(840, 64, 340, "WATER", "THE FLOW");
s57_ks = 2.2; mg_k(930, 186, 50, 6, 0, 100, 38, 0, "INTUIT", "%.0f%%", 0, 5); s57_ks = 1;
gfx_setfont(13); ui_col(S57_DIM); s57_tc(868, 250, "DARK"); s57_tc(930, 112, "OPEN"); s57_tc(994, 250, "THIN");
// the FLOW pad: across RESONANCE, up KEY TRACKING
px_ = 1030; py_ = 96; pw_ = 130; ph_ = 130;
ui_col(S57_INK); s57_rr(px_ - 3, py_ - 3, pw_ + 6, ph_ + 6, 3); ui_col(S57_WELL); s57_r(px_, py_, pw_, ph_);
ui_cola(S57_INK, 0.12); gi_ = 1; loop(3, s57_r(px_ + gi_ * pw_ / 4, py_, 1, ph_); s57_r(px_, py_ + gi_ * ph_ / 4, pw_, 1); gi_ += 1; );
s57_hov(px_, py_, pw_, ph_) && pressed && drag_id == 0 ? drag_id = 9101;
drag_id == 9101 ? ( mouse_cap & 1 ? (
  s57_set(7, min(max((mouse_x / sc - px_) / pw_, 0), 1) * 100); s57_set(8, min(max(1 - (mouse_y / sc - py_) / ph_, 0), 1) * 100); ) : drag_id = 0; );
ui_col(S57_ORNG); gfx_circle((px_ + pw_ * slider7 / 100) * sc, (py_ + ph_ * (1 - slider8 / 100)) * sc, 6 * sc, 1, 1);
ui_col(S57_CREAM); gfx_circle((px_ + pw_ * slider7 / 100) * sc, (py_ + ph_ * (1 - slider8 / 100)) * sc, 2.5 * sc, 1, 1);
gfx_setfont(13); ui_col(S57_DIM); s57_t(px_, py_ + ph_ + 6, "RESONANCE >"); s57_t(px_ + pw_ + 2, py_, "K"); s57_t(px_ + pw_ + 2, py_ + 12, "E"); s57_t(px_ + pw_ + 2, py_ + 24, "Y");
gfx_setfont(13); ui_col(S57_INK); sprintf(#t_, "FLOW  %.0f / %.0f", slider7, slider8); s57_t(px_, py_ + ph_ + 20, #t_);
mg_k(1090, 286, 14, 9, 0, 100, 20, 0, "", "DEPTH %.0f%%", 0, 7); gfx_setfont(13); ui_col(S57_INK); s57_t(1110, 280, "DEPTH");

// ---------- AIR ----------
s57_well(20, 324, 340, 236);
mg_bar(20, 324, 340, "AIR", "THE BREATH");
s57_ks = 2.2; mg_k(112, 440, 50, 11, 0, 100, 45, 0, "SPIRIT", "%.0f%%", 0, 9); s57_ks = 1;
gfx_setfont(13); ui_col(S57_DIM); s57_tc(52, 506, "PLUCK"); s57_tc(112, 372, "ORGAN"); s57_tc(176, 506, "PAD");
mg_k(244, 410, 24, 10, 0, 100, 75, 0, "WILL", "%.0f%%", 0, 8);
mg_k(322, 410, 14, 12, 0, 100, 60, 0, "VELOCITY", "%.0f%%", 0, 0);
mg_k(284, 506, 18, 79, 0, 100, 58, 0, "LEVEL", "%.0f%%", 0, 12);

// ---------- EARTH ----------
s57_well(840, 324, 340, 236);
mg_bar(840, 324, 340, "EARTH", "THE MATRIX");
s57_ks = 2.2; mg_k(920, 408, 36, 13, 0, 100, 100, 0, "GROUND", "%.0f%%", 0, 0); s57_ks = 1;
// INVOKE, the sources
s57_key(852, 482, 136, 24, mg_inv, "INVOKE") ? ( mg_inv = !mg_inv; mg_map = 0; mg_inv && mg_isrc == 0 ? mg_isrc = 1; );
m_ = 0; loop(6, pk_pitem("OFF|ORBIT|BREATH|VEL|PAD X|PAD Y|FATE", m_ + 2, #t_); s57_key(852 + m_ * 54, 516, 50, 20, mg_inv && mg_isrc == m_ + 1, #t_) ? ( mg_isrc = m_ + 1; mg_inv = 1; ); m_ += 1; );
// the PAD: a performance controller - or, while INVOKE is lit, the active routing's depth (up +, down -)
px_ = 1030; py_ = 344; pw_ = 136; ph_ = 130;
ui_col(S57_INK); s57_rr(px_ - 3, py_ - 3, pw_ + 6, ph_ + 6, 3); ui_col(mg_inv ? 0x3A1418 : S57_WELL); s57_r(px_, py_, pw_, ph_);
ui_cola(mg_inv ? S57_ORNG : S57_INK, 0.15); gi_ = 1; loop(3, s57_r(px_ + gi_ * pw_ / 4, py_, 1, ph_); s57_r(px_, py_ + gi_ * ph_ / 4, pw_, 1); gi_ += 1; );
s57_hov(px_, py_, pw_, ph_) && pressed && drag_id == 0 ? drag_id = 9102;
drag_id == 9102 ? ( mouse_cap & 1 ? (
  mx_ = min(max((mouse_x / sc - px_) / pw_, 0), 1); my_ = min(max(1 - (mouse_y / sc - py_) / ph_, 0), 1);
  mg_inv && mg_aslot >= 0 ? ( s57_set(18 + mg_aslot * 3, floor((my_ * 2 - 1) * 100 + 0.5)); ) : ( s57_set(14, mx_ * 100); s57_set(15, my_ * 100); );
  ) : drag_id = 0; );
mg_inv && mg_aslot >= 0 ? (
  gd_ = slider(18 + mg_aslot * 3); yy_ = py_ + ph_ * (0.5 - gd_ / 200);
  ui_col(S57_ORNG); s57_r(px_ + 4, yy_ - 1, pw_ - 8, 2);
  gfx_setfont(13); ui_col(S57_ORNGL); sprintf(#t_, "DEPTH %+.0f%%", gd_); s57_tc(px_ + pw_ * 0.5, py_ + 14, #t_);
) : (
  ui_col(S57_ORNG); gfx_circle((px_ + pw_ * slider14 / 100) * sc, (py_ + ph_ * (1 - slider15 / 100)) * sc, 6 * sc, 1, 1);
  ui_col(S57_CREAM); gfx_circle((px_ + pw_ * slider14 / 100) * sc, (py_ + ph_ * (1 - slider15 / 100)) * sc, 2.5 * sc, 1, 1);
);
gfx_setfont(13); ui_col(S57_DIM); s57_t(px_, py_ + ph_ + 6, mg_inv ? "DRAG: THE DEPTH" : "THE PAD:  X  /  Y");

// ---------- the altar: the display in its ouroboros, the infinity ring ----------
cx_ = 600; cy_ = 312;
// the ring's sixteen steps (click: OFF > ON > ACCENT > TIE > OFF)
gi_ = 0; loop(16,
  a0_ = -0.5 * $pi + gi_ * 2 * $pi / 16 + 0.03; a1_ = a0_ + 2 * $pi / 16 - 0.06;
  gst_ = slider(44 + gi_); live_ = gi_ < slider60;
  cur_ = slider38 >= 0.5 && arp_step == gi_;
  col_ = !live_ ? S57_FACEX : gst_ == 0 ? S57_PLATE : gst_ == 1 ? S57_ORNGL : gst_ == 2 ? S57_ORNG : S57_AMBW;
  ui_col(cur_ ? 0xFFF3C0 : col_);
  gj_ = 0; loop(6, b0_ = a0_ + (a1_ - a0_) * gj_ / 6; b1_ = a0_ + (a1_ - a0_) * (gj_ + 1) / 6;
    gfx_triangle((cx_ + cos(b0_) * 190) * sc, (cy_ + sin(b0_) * 190) * sc, (cx_ + cos(b1_) * 190) * sc, (cy_ + sin(b1_) * 190) * sc,
                 (cx_ + cos(b1_) * 214) * sc, (cy_ + sin(b1_) * 214) * sc, (cx_ + cos(b0_) * 214) * sc, (cy_ + sin(b0_) * 214) * sc);
    gj_ += 1; );
  ui_cola(S57_INK, 0.6); s57_ln(cx_ + cos(a0_) * 188, cy_ + sin(a0_) * 188, cx_ + cos(a0_) * 216, cy_ + sin(a0_) * 216, 1);
  gst_ == 3 && live_ ? ( ui_col(S57_INK); a_ = (a0_ + a1_) * 0.5; s57_ln(cx_ + cos(a0_ + 0.04) * 202, cy_ + sin(a0_ + 0.04) * 202, cx_ + cos(a1_ - 0.04) * 202, cy_ + sin(a1_ - 0.04) * 202, 1.6); );
  gst_ == 2 && live_ ? ( ui_col(S57_INK); a_ = (a0_ + a1_) * 0.5; gfx_circle((cx_ + cos(a_) * 202) * sc, (cy_ + sin(a_) * 202) * sc, 2.5 * sc, 1, 1); );
  gi_ += 1; );
// the ring's clicks
dx_ = mouse_x / sc - cx_; dy_ = mouse_y / sc - cy_; rr_ = sqrt(dx_ * dx_ + dy_ * dy_);
rr_ >= 186 && rr_ <= 218 && pressed && drag_id == 0 ? (
  drag_id = -1;
  a_ = atan2(dy_, dx_) + 0.5 * $pi; a_ < 0 ? a_ += 2 * $pi; gi_ = floor(a_ / (2 * $pi / 16)) % 16;
  s57_set(44 + gi_, (slider(44 + gi_) + 1) % 4);
);
// the display's gold rim
ui_col(MG_GOLD); gfx_circle(cx_ * sc, cy_ * sc, 160 * sc, 1, 1);
// the OLED window
ui_col(0x070405); gfx_circle(cx_ * sc, cy_ * sc, 156 * sc, 1, 1);
ol_ = 0xF2E6CC;
mg_inv ? (
  // the MANIFESTATION MATRIX: the sources on the left, the routings to the right
  gfx_setfont(13); ui_col(ol_); s57_tc(cx_, cy_ - 118, "MANIFESTATION MATRIX");
  gi_ = 0; loop(4,
    gs_ = slider(16 + gi_ * 3); gd_ = slider(17 + gi_ * 3); gdp_ = slider(18 + gi_ * 3);
    gy_ = cy_ - 70 + gi_ * 44;
    ui_cola(ol_, gi_ == mg_aslot ? 0.18 : 0.06); s57_rr(cx_ - 128, gy_ - 16, 256, 32, 4);
    s57_hov(cx_ - 128, gy_ - 16, 210, 32) && pressed && drag_id == 0 ? ( drag_id = -1; mg_aslot = gi_; );
    gfx_setfont(13); ui_col(gs_ > 0 ? ol_ : 0x5E5048);
    pk_pitem(#mg_sn, gs_ + 1, #t_); s57_t(cx_ - 118, gy_ - 6, #t_);
    pk_pitem(#mg_dn, gd_ + 1, #t2_); s57_t(cx_ - 30, gy_ - 6, #t2_);
    gs_ > 0 && gd_ > 0 ? ( sprintf(#t3_, "%+.0f", gdp_); s57_t(cx_ + 52, gy_ - 6, #t3_);
      ui_col(S57_ORNG); s57_ln(cx_ - 52, gy_, cx_ - 36, gy_, 1.6);
      ui_col(0x5E5048); s57_t(cx_ + 102, gy_ - 6, "X");
      s57_hov(cx_ + 96, gy_ - 12, 22, 24) && pressed && drag_id == 0 ? ( drag_id = -1; s57_set(16 + gi_ * 3, 0); s57_set(17 + gi_ * 3, 0); s57_set(18 + gi_ * 3, 0); ); );
    gi_ += 1; );
  gfx_setfont(13); ui_col(0xA8927A);
  s57_tc(cx_, cy_ + 110, "PICK A SOURCE, TOUCH A KNOB,"); s57_tc(cx_, cy_ + 124, "DRAG THE PAD FOR THE DEPTH");
) : mg_map > 0 ? (
  gfx_setfont(11); ui_col(ol_); sprintf(#t_, "MACRO %d", mg_map); s57_tc(cx_, cy_ - 16, #t_);
  gfx_setfont(13); ui_col(0xA8927A); s57_tc(cx_, cy_ + 10, "TOUCH A KNOB TO MAP IT");
) : (
  // the manifestation visualiser: the source's shape at this moment, through the filter's colour
  mg_gshape(slider1 / 100);
  gfx_setfont(13); ui_col(0xA8927A); s57_tc(cx_, cy_ - 118, "MANIFESTATION");
  x0_ = cx_ - 130; px_ = x0_; py_ = cy_;
  gi_ = 0; loop(261,
    gt_ = gi_ / 260 * 2;                                     // two cycles of the fundamental
    gy_ = 0; ws_ = 0; gk_ = 0; loop(8, gw_ = mg_gweight(gk_, slider2 / 100); r2_ = gk_ == 0 ? 1 : mg_gratio(gk_); gy_ += sin(2 * $pi * gt_ * r2_) * gw_; ws_ += gw_; gk_ += 1; );
    gy_ /= max(ws_, 1) ^ 0.75;
    gy_ = gy_ * (1 - mg_gc) + (rand(2) - 1) * mg_gc * 0.8;
    gy_ = slider3 > 2 ? s57_th(gy_ * (1 + 4 * slider3 / 100)) / (1 + 1.5 * slider3 / 100) : gy_;
    nx_ = x0_ + gi_; ny_ = cy_ - gy_ * 70;
    gi_ > 0 ? ( ui_cola(ol_, 0.9); gfx_line(px_ * sc, py_ * sc, nx_ * sc, ny_ * sc, 1); ui_cola(ol_, 0.25); gfx_line(px_ * sc, (py_ + 1) * sc, nx_ * sc, (ny_ + 1) * sc, 1); );
    px_ = nx_; py_ = ny_; gi_ += 1; );
  ui_cola(ol_, 0.12); s57_r(cx_ - 130, cy_, 260, 1);
  gfx_setfont(13); ui_col(0xA8927A);
  sprintf(#t_, "VOICES %d   FATE %.0f%%", mg_nact, slider68); s57_tc(cx_, cy_ + 112, #t_);
  slider38 >= 0.5 ? ( ui_col(S57_ORNGL); s57_tc(cx_, cy_ + 126, "THE RING PLAYS"); );
);
ui_cola(0xFFFFFF, 0.05); gfx_circle((cx_ - 50) * sc, (cy_ - 60) * sc, 70 * sc, 1, 1);

