desc:GFX Series 57 panel parts (include)
//author: JGWizrad / Garden FX (GFX)
//
// The look of Series 57 - mid-century modernist hi-fi: a matte alabaster enamel faceplate, deep charcoal grid
// lines and print, signal-orange markers, cream resin (Bakelite) knobs with a thin orange index line, industrial
// bat-handle toggles, edgewise meters in amber-lit windows, recessed wells and raised plates. Swiss-style geometric
// capitals throughout.
//
// Usage (after gfx-ui and gfx-panel):
//   import gfx-s57.jsfx-inc
//   @gfx     ui_begin(W, H); s57_fonts(); ... s57_face(W, H) ... s57_knob(...) ... pk_end(); ui_end();
// Coordinates are in base pixels (they are scaled by sc inside).
//   s57_knob(cx, cy, r, idx, lo, hi, def, log, label, fmt, step)   drag, SHIFT fine, double-click / Ctrl-click default,
//                                                                 wheel; the value shows only while touched
//   s57_toggle(cx, cy, idx, up_label, down_label)                  a bat-handle toggle: up = 0, down = 1
//   s57_key(x, y, w, h, on, s)                                     a lit key (signal orange); returns 1 when clicked
//   s57_inkey(x, y, idx)                                           the house IN / OUT button (grey square, amber LED)
//   inst.s57_edge(x, y, w, h, level, label)                        an edgewise VU meter (level: linear RMS-ish, 1 = 0 VU)
//   s57_valve(cx, cy, s, glow)                                     a valve, its heater glowing 0..1
//   s57_well(x, y, w, h) / s57_plate(x, y, w, h)                   a recessed well / a raised plate
//   s57_title(x, y, s) / s57_cap(cx, y, s) / s57_small(x, y, s)    section title / centred caption / small print

@init
// ---------- the two faces ----------
// ULM (0): German modernist hi-fi - matte alabaster enamel, a charcoal grid, signal orange.
// COPENHAGEN (1): Danish modern - pale grey-birch enamel, sage plates, oatmeal wool in the wells, flat teak cheeks,
// a deep teal accent, mustard keys, teak index lines. (No wood grain: the teak is a flat enamel colour.)
// Every colour below is reassigned by s57_pal(face); the drawing functions only ever use these names.
function s57_pal(f) (
  s57_fc = f >= 0.5;
  !s57_fc ? (
    S57_FACE = 0xECE7DA; S57_FACEX = 0xE2DCCD; S57_WELL = 0xDDD6C6; S57_PLATE = 0xF3EFE5;
    S57_INK = 0x24242A; S57_DIM = 0x7A766C; S57_GRID = 0x24242A; S57_GRA = 0.045;
    S57_ORNG = 0xE8501E; S57_ORNGL = 0xFF8A55; S57_KEYC = 0xE8501E; S57_KEYT = 0xFFF7EE; S57_IDX = 0xE8501E; S57_NDL = 0xE8501E;
    S57_CREAM = 0xF3EDDD; S57_AMB = 0xFFB347; S57_AMBW = 0xF7D9A0; S57_AMBD = 0x6B4310; S57_KEYH = 0xE6E0D2;
  ) : (
    S57_FACE = 0xDCD9D0; S57_FACEX = 0xD2CFC5; S57_WELL = 0xCFC6B3; S57_PLATE = 0xC9D0BE;
    S57_INK = 0x253230; S57_DIM = 0x67706A; S57_GRID = 0x253230; S57_GRA = 0.022;
    S57_ORNG = 0x2C6E68; S57_ORNGL = 0xFF9A60; S57_KEYC = 0xD9A13B; S57_KEYT = 0x253230; S57_IDX = 0x8A4F2C; S57_NDL = 0x9E3A24;
    S57_CREAM = 0xF2EEE2; S57_AMB = 0xFFC877; S57_AMBW = 0xF4EDD9; S57_AMBD = 0x6E5C40; S57_KEYH = 0xD6DCCB;
  );
  S57_TEAK = 0x8A5532;
  S57_KRIM = 0x57524A; S57_KSKT = 0xD8D0BC; S57_KSHN = 0.5;   // the knob cap's rim, skirt, sheen (a unit may override)
);
s57_pal(0);
// lamp keys (opt-in): a unit sets s57_lamp = 1 to draw its keys as the house lamp keys (gfx-ui lk_fit); s57_lcol is
// the next key's lamp colour (cleared after each key; 0 = amber). Units that leave s57_lamp at 0 keep the flat keys.
s57_lamp = 0; s57_lcol = 0;

// (the drawing functions live in @init, as in the other GFX includes; they are called from @gfx)
// ---------- type: geometric capitals ----------
function s57_fonts() (
  sc != s57_calsc ? (
    s57_calsc = sc;
    s57_f1 = ui_fitfont(11, 14 * sc);        // captions (the knobs' labels)
    s57_f2 = ui_fitfont(12, 14 * sc);        // section titles
    s57_f3 = ui_fitfont(13, 10.5 * sc);      // small print, values
  );
  gfx_setfont(11, "Arial", s57_f1, 'b'); gfx_setfont(12, "Arial", s57_f2, 'b'); gfx_setfont(13, "Arial", s57_f3, 'b');
  gfx_setfont(14, "Arial", 26 * sc, 'b'); gfx_setfont(15, "Arial", 15 * sc, 'b');
  s57_lamp ? gfx_setfont(10, "Arial", 10 * sc, 'b');   // lamp-key legends (slot 10)
);
function s57_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function s57_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function s57_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function s57_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function s57_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function s57_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function s57_ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  x1 *= sc; y1 *= sc; x2 *= sc; y2 *= sc; w *= sc * 0.5;
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : l < 8 ? gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny)
    : ui_ssline(x1, y1, x2, y2, 2 * w, 0);   // (lines 8 px and longer supersampled: even at every angle)
);
function s57_title(x, y, s) ( gfx_setfont(12); ui_col(S57_INK); s57_t(x, y, s); );
function s57_cap(cx, y, s) ( gfx_setfont(11); ui_col(S57_INK); s57_tc(cx, y, s); );
function s57_small(x, y, s) ( gfx_setfont(13); ui_col(S57_DIM); s57_t(x, y, s); );

// ---------- the faceplate, wells and plates ----------
// the alabaster enamel with its fine charcoal grid
function s57_face(w, h) local(i) (
  ui_col(S57_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
  ui_cola(S57_GRID, S57_GRA);
  i = 0; loop(floor(w / 20) + 1, s57_r(i * 20, 0, 1, h); i += 1; );
  i = 0; loop(floor(h / 20) + 1, s57_r(0, i * 20, w, 1); i += 1; );
);
// a recessed matte well: the floor a shade darker, sloped walls in shadow above and light below
function s57_well(x, y, w, h) local(i) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, S57_WELL);
  s57_fc ? (                                             // COPENHAGEN: a fine oatmeal wool weave on the floor
    ui_cola(0x5A4A30, 0.07); i = 2; loop(floor((h - 4) / 3), s57_r(x + 3, y + i, w - 6, 0.8); i += 3; );
    ui_cola(0xFFFFFF, 0.10); i = 3; loop(floor((w - 6) / 3), s57_r(x + i, y + 3, 0.8, h - 6); i += 3; );
  );
);
// COPENHAGEN: flat teak cheeks at both ends of the panel (draw them last, over everything)
function s57_cheeks(w, h) (
  s57_fc ? (
    ui_col(S57_TEAK); s57_r(0, 0, 12, h); s57_r(w - 12, 0, 12, h);
    ui_cola(0x000000, 0.25); s57_r(11, 0, 1, h); s57_r(w - 12, 0, 1, h);
    ui_cola(0xFFFFFF, 0.10); s57_r(0, 0, 1, h); s57_r(w - 1, 0, 1, h);
  );
);

// a raised plate: lighter, a crisp highlight on top, a soft shadow below
function s57_plate(x, y, w, h) (
  ui_cola(0x000000, 0.10); s57_rr(x + 1, y + 3, w, h, 3);
  ui_cola(0x000000, 0.06); s57_rr(x, y + 1.5, w, h, 3);
  ui_col(S57_PLATE); s57_rr(x, y, w, h, 3);
  ui_cola(0xFFFFFF, 0.8); s57_r(x + 3, y, w - 6, 1);
  ui_cola(S57_INK, 0.18); s57_r(x + 3, y + h - 1, w - 6, 1);
);

// ---------- the Bakelite knob ----------
// a ring of charcoal ticks printed on the plate, a cream resin cap with a moulded skirt, a thin signal-orange index line
// the heavy knob (s57_hv = 1): a knurled black skirt, a broad cap, a bold pointer
function s57_cap_heavy(cx, cy, r, n) local(a, ca, sa, i, t, l) (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 10 : 8;
    ui_cola(S57_INK, 0.8); s57_ln(cx + sin(t) * (r + 4), cy - cos(t) * (r + 4), cx + sin(t) * (r + l), cy - cos(t) * (r + l), 2);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.45); gfx_circle((cx + 1.5) * sc, (cy + 3) * sc, r * sc, 1, 1);
  ui_col(0x0E0B0B); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  i = 0; loop(24, t = i * 2 * $pi / 24; ui_col(0x2A2424); s57_ln(cx + cos(t) * r * 0.8, cy + sin(t) * r * 0.8, cx + cos(t) * (r - 0.8), cy + sin(t) * (r - 0.8), max(1.2, r * 0.07)); i += 1; );
  ui_col(0x1A1515); gfx_circle(cx * sc, cy * sc, r * 0.76 * sc, 1, 1);
  ui_col(S57_CREAM); gfx_circle(cx * sc, cy * sc, r * 0.68 * sc, 1, 1);
  ui_cola(0x000000, 0.12); gfx_circle((cx + r * 0.06) * sc, (cy + r * 0.08) * sc, r * 0.6 * sc, 1, 1);
  ui_col(S57_CREAM); gfx_circle((cx - r * 0.04) * sc, (cy - r * 0.04) * sc, r * 0.58 * sc, 1, 1);
  ui_col(S57_IDX); s57_ln(cx + ca * r * 0.1, cy + sa * r * 0.1, cx + ca * (r - 1), cy + sa * (r - 1), max(3, r * 0.13));
);
function s57_cap_draw(cx, cy, r, n) local(a, ca, sa, i, t) (
  s57_hv ? s57_cap_heavy(cx, cy, r, n) : (
  // ticks: 11, the ends and the middle longer
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi;
    ui_cola(S57_INK, 0.75);
    s57_ln(cx + sin(t) * (r + 4), cy - cos(t) * (r + 4), cx + sin(t) * (r + (i == 0 || i == 5 || i == 10 ? 9 : 7)), cy - cos(t) * (r + (i == 0 || i == 5 || i == 10 ? 9 : 7)), 1.1);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.20); gfx_circle((cx + 1.3) * sc, (cy + 2.4) * sc, r * sc, 1, 1);
  ui_col(S57_KRIM); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(S57_KSKT); gfx_circle(cx * sc, cy * sc, (r - 1.2) * sc, 1, 1);
  ui_col(S57_CREAM); gfx_circle(cx * sc, cy * sc, (r - 3) * sc, 1, 1);
  // a soft sheen on the resin, top left
  ui_cola(0xFFFFFF, S57_KSHN); gfx_circle((cx - r * 0.28) * sc, (cy - r * 0.3) * sc, r * 0.32 * sc, 1, 1);
  ui_col(S57_CREAM); gfx_circle((cx - r * 0.2) * sc, (cy - r * 0.2) * sc, r * 0.3 * sc, 1, 1);
  // the index line
  ui_col(S57_IDX); s57_ln(cx + ca * r * 0.15, cy + sa * r * 0.15, cx + ca * (r - 2.5), cy + sa * (r - 2.5), 2);
  );
);
// the value pill, shown only while the knob is touched
function s57_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(S57_INK); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 4 * sc, 2 * sc);
  ui_col(S57_PLATE); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);
function s57_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 4000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  // a click never moves the knob: the drag starts after 3 pixels; a double-click (two clicks with no drag
  // between) or Ctrl-click sets the default
  pressed && hov && drag_id == 0 ? (
    (time_precise() - s57_lt < 0.35 && s57_lid == idx && !s57_mv) || (mouse_cap & 4) ? ( s57_set(idx, def); drag_id = -1; s57_lt = 0; ) : (
      drag_id = did; s57_ky = mouse_y; s57_ky0 = mouse_y; s57_mv = 0; s57_lt = time_precise(); s57_lid = idx;
      s57_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !s57_mv && abs(mouse_y - s57_ky0) > 3 * sc ? ( s57_mv = 1; s57_ky = mouse_y; );
  drag_id == did && s57_mv ? (
    s57_kn = min(max(s57_kn + (s57_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc * (s57_ks > 0 ? s57_ks : 1)), 0), 1); s57_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ s57_kn : lo + s57_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s57_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    s57_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  s57_cap_draw(cx, cy, r, min(max(n, 0), 1));
  (hov || drag_id == did) ? (
    strlen(fmt) ? sprintf(#s57_vv, fmt, v) : strcpy(#s57_vv, #s57_vs);
    s57_pill(cx, cy + r + 8, #s57_vv);
  ) : (
    strlen(label) ? s57_cap(cx, cy + r + 18, label);
  );
);

// ---------- the bat-handle toggle: a chrome nut, the lever up (0) or down (1) ----------
function s57_toggle(cx, cy, idx, up, dn) local(hov, on, ty, ty2, th2) (
  hov = s57_hov(cx - 22, cy - 26, 44, 52); on = slider(idx) >= 0.5;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; s57_set(idx, on ? 0 : 1); on = !on; );
  ui_col(S57_INK); gfx_circle(cx * sc, cy * sc, 9 * sc, 1, 1);
  ui_col(0xB9BEC5); gfx_circle(cx * sc, cy * sc, 7.5 * sc, 1, 1);
  ui_col(0x8D939B); gfx_circle(cx * sc, cy * sc, 5 * sc, 1, 1);
  ty = on ? 1 : -1;
  ui_cola(0x000000, 0.25); s57_ln(cx + 1.5, cy + 1.5, cx + 2.5, cy + ty * 19 + 1.5, 4.6);
  ui_col(0x7E848C); s57_ln(cx, cy, cx, cy + ty * 19, 4.6);
  ui_col(0xE4E7EB); s57_ln(cx - 0.8, cy, cx - 0.8, cy + ty * 18, 1.4);
  ui_col(0xC9CDD3); gfx_circle(cx * sc, (cy + ty * 19) * sc, 3.4 * sc, 1, 1);
  hov ? ( ui_cola(S57_ORNG, 0.12); gfx_circle(cx * sc, cy * sc, 24 * sc, 1, 1); );
  gfx_setfont(13); ui_col(on ? S57_DIM : S57_INK); s57_tc(cx, cy - 32, up);
  ui_col(on ? S57_INK : S57_DIM); s57_tc(cx, cy + 32, dn);
  gfx_measurestr(on ? dn : up, ty2, th2); ui_col(S57_ORNG); gfx_circle(cx * sc - ty2 * 0.5 - 7 * sc, (cy + ty * 32) * sc, 2.2 * sc, 1, 1);
);

// ---------- a lit key ----------
function s57_key(x, y, w, h, on, s) local(hov, hit) (
  s57_lamp ? (
    lk_well = 0x2A2722; lk_font = lk_font2 = 10;
    hit = lk_fit(x, y, w, h, on, s57_lcol ? s57_lcol : LK_AMB, s);
  ) : (
  hov = s57_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.14); s57_rr(x + 1, y + 2, w, h, 2);
  ui_col(S57_INK); s57_rr(x, y, w, h, 2);
  ui_col(on ? S57_KEYC : hov ? S57_KEYH : S57_PLATE); s57_rr(x + 1.2, y + 1.2, w - 2.4, h - 2.4, 1.5);
  gfx_setfont(13); ui_col(on ? S57_KEYT : S57_INK); s57_tc(x + w * 0.5, y + h * 0.5, s);
  );
  s57_lcol = 0;
  hit;
);
// ---------- the house IN / OUT button: a small square grey button, its amber LED beside it ----------
function s57_inkey(x, y, idx) local(hov, hit, dn) (
  s57_lamp ? (
    // lamp mode: an amber IN lamp key (24 x 18, centred on the old button's height) in place of the button and LED
    lk_well = 0x2A2722; lk_font = lk_font2 = 10;
    hit = lk_fit(x, y - 2, 24, 18, slider(idx) >= 0.5, LK_AMB, "IN");
    hit ? s57_set(idx, slider(idx) >= 0.5 ? 0 : 1);
  ) : (
  hov = s57_hov(x, y, 14, 14); hit = hov && pressed && drag_id == 0; hit ? ( drag_id = -1; s57_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
  dn = hov && mdown;
  ui_cola(0x000000, 0.35); s57_r(x + 1, y + 2, 14, 14);
  ui_col(0x0E0E10); s57_r(x, y, 14, 14);
  ui_col(dn ? 0x7E8187 : hov ? 0xA8ABB0 : 0x9A9DA2); s57_r(x + 1, y + 1, 12, 12);
  ui_cola(0xFFFFFF, dn ? 0.1 : 0.35); s57_r(x + 1, y + 1, 12, 1);
  pk_led((x + 22) * sc, (y + 7) * sc, 3.6 * sc, slider(idx) >= 0.5, 0xFFB030);
  );
  hit;
);

// ---------- an edgewise meter: a horizontal scale in an amber-lit window, the needle moving across it ----------
// lvl: 1 = 0 VU. The needle has its own mass and damping (time based), as on the real meters.
function s57_edge(x, y, w, h, lvl, label) instance(pos, vel, lt) local(dt, tgt, i, d, px, wx, ww) (
  dt = min(max(time_precise() - lt, 0.001), 0.05); lt = time_precise();
  d = 20 * log10(max(lvl, 0.00001));
  tgt = min(max((d + 20) / 23, -0.04), 1.04);                     // -20 VU .. +3 VU across the window
  vel += (150 * (tgt - pos) - 17 * vel) * dt; pos += vel * dt; pos = min(max(pos, -0.05), 1.05);
  // the bezel: charcoal, the window recessed
  ui_cola(0x000000, 0.18); s57_rr(x + 1, y + 2, w, h, 3);
  ui_col(S57_INK); s57_rr(x, y, w, h, 3);
  wx = x + 6; ww = w - 12;
  // the window, lit warm from behind (brightest in the middle)
  ui_col(S57_AMBD); s57_r(wx, y + 5, ww, h - 10);
  i = 0; loop(10, ui_cola(S57_AMBW, 0.13); s57_r(wx + ww * 0.03 * i, y + 5 + i * 0.5, ww * (1 - 0.06 * i), h - 10 - i); i += 1; );
  // the scale: charcoal ticks, red from 0 VU; the numbers
  i = 0;
  loop(8,
    d = i == 0 ? -20 : i == 1 ? -10 : i == 2 ? -7 : i == 3 ? -5 : i == 4 ? -3 : i == 5 ? 0 : i == 6 ? 1 : 3;
    px = wx + 24 + (ww - 48) * (d + 20) / 23;
    ui_col(d > 0 ? 0xC2321A : S57_INK); s57_r(px, y + 8, 1.2, d == 0 || d == -20 || d == 3 ? 7 : 4);
    gfx_setfont(13); ui_col(d > 0 ? 0xC2321A : S57_INK);
    d == -20 || d == -10 || d == -5 || d == 0 || d == 3 ? ( sprintf(#s57_e, d > 0 ? "+%d" : "%d", d); s57_tc(px, y + 25, #s57_e); );
    i += 1;
  );
  ui_cola(S57_INK, 0.7); s57_r(wx + 24, y + 8, (ww - 48) * 20 / 23, 1); ui_col(0xC2321A); s57_r(wx + 24 + (ww - 48) * 20 / 23, y + 8, (ww - 48) * 3 / 23, 1);
  // the needle
  px = wx + 24 + (ww - 48) * pos;
  ui_col(S57_NDL); s57_r(px - 0.8, y + 6, 1.8, h - 12);
  ui_cola(0x000000, 0.25); s57_r(px + 1, y + 6, 1, h - 12);
  // the label under the scale, and the glass
  gfx_setfont(13); ui_col(S57_INK); s57_tc(wx + ww * 0.5, y + h - 13, label);
  ui_cola(0xFFFFFF, 0.08); s57_r(wx, y + 5, ww, (h - 10) * 0.4);
);

// ---------- an edgewise gain-reduction meter: the needle rests at 0 on the right and swings left as it limits ----------
// gr: gain reduction in dB (positive). Scale 0 .. 20 dB, spread so the first few dB read clearly.
function s57_grpos(g) ( 1 - log(1 + max(g, 0)) / log(21); );
function s57_gredge(x, y, w, h, gr, label) instance(pos, vel, lt) local(dt, tgt, i, d, px, wx, ww) (
  dt = min(max(time_precise() - lt, 0.001), 0.05); lt = time_precise();
  tgt = s57_grpos(gr);
  vel += (150 * (tgt - pos) - 17 * vel) * dt; pos += vel * dt; pos = min(max(pos, -0.02), 1.02);
  ui_cola(0x000000, 0.18); s57_rr(x + 1, y + 2, w, h, 3);
  ui_col(S57_INK); s57_rr(x, y, w, h, 3);
  wx = x + 6; ww = w - 12;
  ui_col(S57_AMBD); s57_r(wx, y + 5, ww, h - 10);
  i = 0; loop(10, ui_cola(S57_AMBW, 0.13); s57_r(wx + ww * 0.03 * i, y + 5 + i * 0.5, ww * (1 - 0.06 * i), h - 10 - i); i += 1; );
  i = 0;
  loop(8,
    d = i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 10 : i == 6 ? 14 : 20;
    px = wx + 24 + (ww - 48) * s57_grpos(d);
    ui_col(S57_INK); s57_r(px, y + 8, 1.2, d == 0 || d == 10 || d == 20 ? 7 : 4);
    gfx_setfont(13);
    d == 0 || d == 2 || d == 4 || d == 6 || d == 10 || d == 20 ? ( sprintf(#s57_e, d == 0 ? "0" : "-%d", d); s57_tc(px, y + 25, #s57_e); );
    i += 1;
  );
  ui_cola(S57_INK, 0.7); s57_r(wx + 24, y + 8, ww - 48, 1);
  px = wx + 24 + (ww - 48) * pos;
  ui_col(S57_NDL); s57_r(px - 0.8, y + 6, 1.8, h - 12);
  ui_cola(0x000000, 0.25); s57_r(px + 1, y + 6, 1, h - 12);
  gfx_setfont(13); ui_col(S57_INK); s57_tc(wx + ww * 0.5, y + h - 13, label);
  ui_cola(0xFFFFFF, 0.08); s57_r(wx, y + 5, ww, (h - 10) * 0.4);
);
// the house swap-order key: one key with a momentary LED; returns 1 when clicked
function s57_orderkey(x, y, w, h, s) instance(t) local(hit) (
  s57_lamp && !s57_lcol ? s57_lcol = LK_BLU_LT;
  hit = s57_key(x, y, w, h, 0, s); hit ? t = time_precise();
  pk_led((x + w + 9) * sc, (y + h * 0.5) * sc, 3.5 * sc, time_precise() - t < 0.25, S57_KEYC);
  hit;
);

// ---------- a valve: the glass, the plates inside, the heater glowing ----------
function s57_valve(cx, cy, s, glow) local(i) (
  // the socket and pins
  ui_col(S57_INK); s57_rr(cx - 15 * s, cy + 28 * s, 30 * s, 8 * s, 2 * s);
  ui_col(0x9EA3AA); i = 0; loop(5, s57_r(cx - 11 * s + i * 5.5 * s, cy + 36 * s, 1.5 * s, 5 * s); i += 1; );
  // the glow, behind the glass
  glow > 0.01 ? ( ui_cola(S57_ORNGL, 0.10 + 0.25 * glow); gfx_circle(cx * sc, (cy + 6 * s) * sc, (18 + 10 * glow) * s * sc, 1, 1);
                  ui_cola(S57_AMB, 0.2 + 0.4 * glow); gfx_circle(cx * sc, (cy + 6 * s) * sc, 10 * s * sc, 1, 1); );
  // the glass envelope: a rounded top, straight sides
  ui_cola(S57_INK, 0.85); gfx_circle(cx * sc, (cy - 18 * s) * sc, 14 * s * sc, 0, 1);
  s57_r(cx - 14 * s, cy - 18 * s, 1.2, 46 * s); s57_r(cx + 14 * s - 1.2, cy - 18 * s, 1.2, 46 * s);
  ui_cola(0xFFFFFF, 0.35); s57_r(cx - 10 * s, cy - 22 * s, 1.5, 36 * s);
  // the plates and the heater
  ui_col(0x55575C); s57_r(cx - 8 * s, cy - 10 * s, 5 * s, 30 * s); s57_r(cx + 3 * s, cy - 10 * s, 5 * s, 30 * s);
  ui_col(ui_mix(0x5A3A20, S57_ORNGL, glow)); s57_r(cx - 1.2 * s, cy - 8 * s, 2.4 * s, 26 * s);
  ui_cola(S57_INK, 0.8); s57_r(cx - 13 * s, cy - 14 * s, 26 * s, 1.2); s57_r(cx - 13 * s, cy + 22 * s, 26 * s, 1.2);
  // the getter flash at the top
  ui_cola(0x4A4A50, 0.5); gfx_circle(cx * sc, (cy - 24 * s) * sc, 6 * s * sc, 1, 1);
);

// the face keys, in the header: ULM / COPENHAGEN
function s57_facekeys(x, y, idx) (
  s57_lamp ? s57_lcol = LK_ORA; s57_key(x, y, 40, 22, slider(idx) < 0.5, "ULM") ? s57_set(idx, 0);
  s57_lamp ? s57_lcol = LK_ORA; s57_key(x + 44, y, 100, 22, slider(idx) >= 0.5, "COPENHAGEN") ? s57_set(idx, 1);
);

// ---------- the header (W = 960 panels): the badge, the name, two lines of small print, the presets, the face keys,
// the size picker. Returns the preset picked (0 = none): k = s57_header(...); k > 0 ? load_preset(k);
function s57_header(w, name, l1, l2, pm, fidx) local(k) (
  ui_col(S57_INK); s57_r(0, 52, w, 2);
  ui_col(S57_ORNG); s57_r(24, 14, 26, 26);
  gfx_setfont(15); ui_col(s57_fc ? 0xF2EEE2 : 0xFFF7EE); s57_tc(37, 27, "57");
  // the name: its capitals level with the top of the badge (Arial's caps sit about a fifth of the size below the top)
  gfx_setfont(14); gfx_measurestr(name, k, s57_hh);
  k > 124 * sc ? ( gfx_setfont(14, "Arial", 26 * sc * 124 * sc / k, 'b'); gfx_measurestr(name, k, s57_hh); );
  ui_col(S57_INK); gfx_x = 60 * sc; gfx_y = 14 * sc - s57_hh * 0.2; gfx_drawstr(name);
  // the two lines of small print after it, set smaller if they would run under the presets (at small sizes)
  s57_sx = 60 + k / sc + 14;
  gfx_setfont(13); gfx_measurestr(strlen(l1) > strlen(l2) ? l1 : l2, k, s57_hh);
  k > (292 - s57_sx) * sc ? gfx_setfont(13, "Arial", s57_f3 * (292 - s57_sx) * sc / k, 'b');
  ui_col(S57_DIM); s57_t(s57_sx, 16, l1); s57_t(s57_sx, 30, l2);
  pk_pextra = "Reset all to defaults";
  k = pk_preset(300 * sc, 10 * sc, (w - 560 - (s57_hdros ? 76 : 0)) * sc, 34 * sc, pr_cur, pm);   // (s57_hdros: room for an OS key)
  s57_facekeys(w - 236, 16, fidx);
  ui_size_picker((w - 74) * sc, 18 * sc);
  k;
);
// the signal path, printed along the foot: n stations evenly spaced, their labels in #s57_p0 .. (set by the caller)
function s57_path(w, y, n) local(i, x) (
  ui_col(S57_ORNG); s57_r(24, y, w - 48, 1.5);
  i = 0; loop(n, x = 24 + i * (w - 48) / (n - 1); gfx_circle(x * sc, (y + 0.7) * sc, 2.6 * sc, 1, 1); i += 1; );
);

// =====================================================================================================================
// DSP helpers shared by the Series 57 units (all in @init, called from @init / @block / @sample)
// =====================================================================================================================
// memory: the unit sets s57_mem (the first free slot) before its first s57_alloc
function s57_alloc(n) local(p) ( p = s57_mem; s57_mem += n; memset(p, 0, n); p; );
// tanh (Pade 3/2), exactly 1 with zero slope at +/-3
function s57_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
// a one-pole smoothing / low-pass coefficient for f Hz at the rate fs
function s57_k(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
// a time constant (seconds) as a one-pole coefficient at the rate fs
function s57_kt(t, fs) ( 1 - exp(-1 / (max(t, 0.00001) * fs)); );
// RBJ biquads. t: 0 low-pass, 1 high-pass, 2 band-pass (0 dB peak), 3 peak, 4 low shelf, 5 high shelf, 6 all-pass
function s57_bqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(A, w, cs, sn, al, a0, sa) (
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * max(q, 0.05));
  t == 0 ? ( a0 = 1 + al; b0 = (1 - cs) / 2 / a0; b1 = (1 - cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 1 ? ( a0 = 1 + al; b0 = (1 + cs) / 2 / a0; b1 = -(1 + cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 2 ? ( a0 = 1 + al; b0 = al / a0; b1 = 0; b2 = -al / a0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 3 ? ( a0 = 1 + al / A; b0 = (1 + al * A) / a0; b1 = -2 * cs / a0; b2 = (1 - al * A) / a0; a1 = -2 * cs / a0; a2 = (1 - al / A) / a0; ) :
  t == 4 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) + (A - 1) * cs + sa;
             b0 = A * ((A + 1) - (A - 1) * cs + sa) / a0; b1 = 2 * A * ((A - 1) - (A + 1) * cs) / a0; b2 = A * ((A + 1) - (A - 1) * cs - sa) / a0;
             a1 = -2 * ((A - 1) + (A + 1) * cs) / a0; a2 = ((A + 1) + (A - 1) * cs - sa) / a0; ) :
  t == 5 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) - (A - 1) * cs + sa;
             b0 = A * ((A + 1) + (A - 1) * cs + sa) / a0; b1 = -2 * A * ((A - 1) + (A + 1) * cs) / a0; b2 = A * ((A + 1) + (A - 1) * cs - sa) / a0;
             a1 = 2 * ((A - 1) - (A + 1) * cs) / a0; a2 = ((A + 1) - (A - 1) * cs - sa) / a0; ) :
  ( a0 = 1 + al; b0 = (1 - al) / a0; b1 = -2 * cs / a0; b2 = 1; a1 = b1; a2 = b0; );
);
function s57_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
function s57_bqclr() instance(z1, z2) ( z1 = z2 = 0; );
// a one-pole low-pass (k from s57_k)
function s57_lp1(x, k) instance(s) ( s += (x - s) * k; s; );
// a delay line: n samples of memory; write then read d samples back (fractional, linear) - instance per line
function s57_dlinit(n) instance(buf, len, w) ( buf = s57_alloc(n); len = n; w = 0; );
function s57_dlw(x) instance(buf, len, w) ( w += 1; w >= len ? w = 0; buf[w] = x; );
function s57_dlr(d) instance(buf, len, w) local(p, i, f, a, b) (
  d = min(max(d, 0), len - 2); p = w - d; p < 0 ? p += len; i = floor(p); f = p - i;
  a = buf[i]; i += 1; i >= len ? i = 0; b = buf[i];
  a + (b - a) * f;
);
// a cubic (Hermite) read, for modulated lines
function s57_dlr3(d) instance(buf, len, w) local(p, i, f, xm, x0, x1, x2, c1, c2, c3) (
  d = min(max(d, 1), len - 3); p = w - d; p < 0 ? p += len; i = floor(p); f = p - i;
  xm = buf[i - 1 < 0 ? len - 1 : i - 1]; x0 = buf[i]; x1 = buf[(i + 1) % len]; x2 = buf[(i + 2) % len];
  c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);
// a Schroeder all-pass on a delay line (g, d samples)
function s57_ap(x, d, g) instance(buf, len, w) local(v, y) (
  v = this.s57_dlr(d); y = v - g * x; this.s57_dlw(x + g * y); y;
);
// ---------- oversampling: linear-phase half-bands (Kaiser windowed, polyphase), as in Drive57 ----------
function s57_bi0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= sqr(x / (2 * k)); s += t; k += 1; ); s; );
function s57_hbdesign(h, n, beta) local(c, t, k, w, x, se, i0) (
  c = (n - 1) / 2; i0 = s57_bi0(beta); t = 0;
  loop(n, k = t - c; x = 2 * t / (n - 1) - 1; w = s57_bi0(beta * sqrt(max(0, 1 - x * x))) / i0;
          h[t] = k == 0 ? 0.5 : sin($pi * k / 2) / ($pi * k) * w; t += 1; );
  se = 0; t = 0; loop((n + 1) / 2, se += h[2 * t]; t += 1; );
  t = 0; loop((n + 1) / 2, h[2 * t] *= 0.5 / se; t += 1; );
);
function s57_upinit(n, h, sz) instance(buf, sz2, w, hu, np, mm, dd) local(j) (
  buf = s57_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; dd = ((n - 1) / 2 - 1) / 2;
  hu = s57_alloc(np); j = 0; loop(np, hu[j] = 2 * h[2 * j]; j += 1; );
);
function s57_up(x) instance(buf, sz2, w, hu, np, mm, dd, o0, o1) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x; buf[w + sz2] = x;
  p = buf + w + sz2; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-j] + p[j + 1 - mm]); j += 1; );
  o0 = s; o1 = p[-dd];
);
function s57_dninit(n, h, sz) instance(buf, sz2, w, hu, np, mm, cc) local(j) (
  buf = s57_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; cc = (n - 1) / 2;
  hu = s57_alloc(np); j = 0; loop(np, hu[j] = h[2 * j]; j += 1; );
);
function s57_dn(x0, x1) instance(buf, sz2, w, hu, np, mm, cc) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x0; buf[w + sz2] = x0;
  w += 1; w >= sz2 ? w = 0; buf[w] = x1; buf[w + sz2] = x1;
  p = buf + w + sz2 - 1; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-2 * j] + p[2 * (j + 1 - mm)]); j += 1; );
  s + 0.5 * p[-cc];
);
// pink-ish noise (Paul Kellet's economy filter on white), about -12 dBFS RMS
function s57_pink() instance(p0, p1, p2) local(w) (
  w = rand(2) - 1; p0 = 0.99765 * p0 + w * 0.099046; p1 = 0.963 * p1 + w * 0.2965164; p2 = 0.57 * p2 + w * 1.0526913;
  (p0 + p1 + p2 + w * 0.1848) * 0.12;
);

// =====================================================================================================================
// Meters for the measuring units (Meter57, Master57)
// =====================================================================================================================
// the needle's place (0 .. 1) on each scale. mode: 0 VU (-20 .. +3, the classic voltage-law scale),
// 1 PPM (DIN: -50 .. +5 dB, the bottom 20 dB compressed), 2 PPM (Nordic: -36 .. +9 dB, linear), 3 PEAK (-60 .. 0 dBFS)
function s57_scpos(mode, d) (
  mode == 0 ? ( (10 ^ (max(d, -40) / 20) - 0.1) / (1.41254 - 0.1) ) :
  mode == 1 ? ( d < -30 ? 0.2 * (max(d, -60) + 50) / 20 : 0.2 + 0.8 * (d + 30) / 35 ) :
  mode == 2 ? ( (d + 36) / 45 ) :
              ( d < -30 ? 0.25 * (max(d, -70) + 60) / 30 : 0.25 + 0.75 * (d + 30) / 30 );
);
// an arc meter: an amber window, the scale on an arc, the needle from a pivot below the window
//   db: the reading on the scale (relative to the reference for VU / PPM, dBFS for PEAK); hold: a drag pointer (or -999)
function s57_arcm(x, y, w, h, db, hold, mode, label, ch) local(px, py, R, a, i, d, t, n, lo, hi, red, p, s, c, x1, y1, x2, y2)
(
  // the case and the window
  ui_cola(0x000000, 0.18); s57_rr(x + 1, y + 3, w, h, 6);
  ui_col(S57_INK); s57_rr(x, y, w, h, 6);
  ui_col(S57_AMBD); s57_rr(x + 7, y + 7, w - 14, h - 14, 3);
  i = 0; loop(12, ui_cola(S57_AMBW, 0.11); s57_rr(x + 7 + i * w * 0.025, y + 7 + i * 1.6, w - 14 - i * w * 0.05, h - 14 - i * 3.2, 3); i += 1; );
  px = x + w * 0.5; py = y + h - 12; R = h - 58;
  // the scale arc (-48 .. +48 degrees)
  n = mode == 0 ? 11 : mode == 1 ? 12 : 9;
  red = mode == 0 ? 0 : mode == 1 ? 0 : mode == 2 ? 0 : -6;
  i = 0;
  loop(n,
    d = mode == 0 ? (i == 0 ? -20 : i == 1 ? -10 : i == 2 ? -7 : i == 3 ? -5 : i == 4 ? -3 : i == 5 ? -2 : i == 6 ? -1 : i == 7 ? 0 : i == 8 ? 1 : i == 9 ? 2 : 3) :
        mode == 1 ? (i == 0 ? -50 : i == 1 ? -40 : i == 2 ? -30 : i == 3 ? -25 : i == 4 ? -20 : i == 5 ? -15 : i == 6 ? -10 : i == 7 ? -5 : i == 8 ? -3 : i == 9 ? 0 : i == 10 ? 3 : 5) :
        mode == 2 ? (i == 0 ? -36 : i == 1 ? -30 : i == 2 ? -24 : i == 3 ? -18 : i == 4 ? -12 : i == 5 ? -6 : i == 6 ? 0 : i == 7 ? 6 : 9) :
                    (i == 0 ? -60 : i == 1 ? -40 : i == 2 ? -30 : i == 3 ? -24 : i == 4 ? -18 : i == 5 ? -12 : i == 6 ? -6 : i == 7 ? -3 : 0);
    p = min(max(s57_scpos(mode, d), 0), 1); a = (-48 + 96 * p) * $pi / 180; s = sin(a); c = cos(a);
    ui_col(d > red ? 0xC2321A : S57_INK);
    s57_ln(px + s * R, py - c * R, px + s * (R - 10), py - c * (R - 10), 1.4);
    gfx_setfont(13);
    (mode != 0 || d == -20 || d == -10 || d == -5 || d == -3 || d == 0 || d == 3 || d == -7) && (mode != 1 || d != -25 && d != -15 && d != -3) && (mode != 3 || d != -40) ? (
      sprintf(#s57_e, d > 0 ? "+%d" : "%d", d); s57_tc(px + s * (R + 12), py - c * (R + 12), #s57_e); );
    i += 1;
  );
  // the arc line, charcoal and red
  i = 0; loop(48, t = i / 48; p = s57_scpos(mode, red); a = (-48 + 96 * t) * $pi / 180;
    ui_col(t > p ? 0xC2321A : S57_INK); s57_ln(px + sin(a) * R, py - cos(a) * R, px + sin(a + 2 * $pi / 180) * R, py - cos(a + 2 * $pi / 180) * R, t > p ? 2.6 : 1.2); i += 1; );
  // the hold pointer
  hold > -900 ? ( p = min(max(s57_scpos(mode, hold), -0.02), 1.03); a = (-48 + 96 * p) * $pi / 180;
    ui_col(S57_ORNG); s57_ln(px + sin(a) * (R - 26), py - cos(a) * (R - 26), px + sin(a) * (R - 2), py - cos(a) * (R - 2), 1.6); );
  // the label
  gfx_setfont(11); ui_col(S57_INK); s57_tc(px, y + h - 52, label);
  gfx_setfont(13); ui_col(S57_DIM); s57_tc(px, y + h - 36, ch);
  // the needle
  p = min(max(s57_scpos(mode, db), -0.03), 1.04); a = (-48 + 96 * p) * $pi / 180;
  x1 = px + sin(a) * (R * 0.2); y1 = py - cos(a) * (R * 0.2); x2 = px + sin(a) * (R + 2); y2 = py - cos(a) * (R + 2);
  ui_cola(0x000000, 0.22); s57_ln(x1 + 2, y1 + 2, x2 + 2, y2 + 2, 2);
  ui_col(S57_NDL); s57_ln(x1, y1, x2, y2, 1.8);
  // the pivot cover (a charcoal band across the bottom of the window) and the glass
  ui_col(S57_INK); s57_r(x + 7, y + h - 18, w - 14, 11);
  ui_cola(0xFFFFFF, 0.07); s57_rr(x + 7, y + 7, w - 14, (h - 14) * 0.38, 3);
);
// a nixie read-out: n characters of s glowing orange in a smoked tube row
function s57_nixie(x, y, w, h, s, lit) local(n, i, cw) (
  n = strlen(s); cw = w / max(n, 1);
  ui_col(0x16120F); s57_rr(x, y, w, h, 3);
  i = 0; loop(n,
    ui_cola(0xFFFFFF, 0.05); s57_rr(x + i * cw + 2, y + 2, cw - 4, h - 4, cw * 0.4);
    i += 1; );
  gfx_setfont(14); gfx_measurestr(s, n, i);
  lit ? ( ui_cola(0xFF7A2A, 0.35); gfx_x = floor((x + w * 0.5) * sc - n * 0.5) + 1; gfx_y = floor((y + h * 0.5) * sc - i * 0.5) + 1; gfx_drawstr(s); );
  ui_col(lit ? 0xFF9A4A : 0x4A3426); gfx_x = floor((x + w * 0.5) * sc - n * 0.5); gfx_y = floor((y + h * 0.5) * sc - i * 0.5); gfx_drawstr(s);
);
