desc:GFX Benthick 3B [bus processor]
//tags: bus processor saturation transformer transistor compressor limiter width mastering
//author: JGWizrad / Garden FX (GFX)
//
// BYPASS: lit = bypassed - the output crossfades (15 ms) to the untouched input, kept in time with the latency,
//   so it never clicks the way REAPER's own on / off can.
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate,
// gfx-instrument, gfx-os and gfx-bypass (.jsfx-inc) in the same folder.
//
// A solid-state iron and transistor bus processor: tight low-end weight, fast transient clamping and
// dense glue, without woolly tube artefacts. 3B lays the stages out as columns, left to right in signal
// order, with the big TILT knob straddling the line between COMP 1 and COMP 2:
//   1 FRONT END  - IRON: an asymmetric transformer core that works hardest on the lows (even harmonics,
//                  weight, a little magnetic hysteresis), or CLASS-A: a symmetric discrete transistor
//                  clip (odd harmonics, a dense edge focused in the upper mids). DRIVE pushes either;
//                  small signals pass at unity. M/S drives the Sides harder (S DRIVE) for natural width.
//                  A 5 Hz DC blocker and a gain clamp sit straight after the core.
//                  SC HPF keeps the lows out of both compressors' detectors (no sub-bass pumping).
//   2 COMP 1     - the slow window: a slow attack lets the early transients through untouched. HYST is a
//                  dual-threshold gate on the detector: once over THRESH the release holds back until the
//                  level falls HYST dB below it, so it never chatters round the threshold.
//     TILT       - a seesaw around 700 Hz, after COMP 1: it shapes what COMP 2 hears and what you hear.
//   3 COMP 2     - the fast FET grabber: microsecond attack, 4 / 8 / 12 / 20:1 or ALL (every ratio key in:
//                  hard, aggressive, a little grit). MAKEUP sets its level.
//     BALANCE    - the summing node: left = COMP 1 (its untouched transients, after TILT), right = COMP 2
//                  (the clamped signal) - the same signal through two paths, so it sums phase-coherently.
//   4 BUS COMP   - console-style VCA glue that pulls COMP 1 and COMP 2 together: 2 / 4 / 10:1, stepped
//                  ATTACK (0.1 - 30 ms) and RELEASE (0.1 - 1.2 s or AUTO: quick after a transient, slow when
//                  it has been working a while), THRESH, MAKEUP. Its detector shares the SC HPF.
//   5 WIDTH      - M/S width; S SAT drives the Sides into a second discrete saturation stage.
//     MIX        - wet / dry, OUTPUT. (3B has no IN / OUT strip: input trim, guard and band sat stay at their
//                  defaults.)
//   LINK       - lit (the default): the three compressors each hear both sides and turn them down together, so
//                the image stays put. Dark: dual mono - each side has its own detector and gain, so a loud hit on
//                one side leaves the other alone. One key for all three; a change crossfades over 10 ms.
// Every stage has an IN key. No drift: Benthick 3 is clean and repeatable.
// ANTI-ALIASING (the house drive standard): IRON's upper core, CLASS-A, COMP 2's colour and S SAT are read with
//   first-order ADAA, its half-sample lag made up (see bt_th), so small signals still pass at unity, phase-true with
//   the dry for MIX (IRON's low core only sees the band below 160 Hz: nothing of it folds back, so it is read plain).
//   The curves are smooth (no knee to track); there is no pre-filter (the front end's colour - IRON's lows, CLASS-A's
//   upper mids - is what is being driven).
// OS (header, left of PRESETS): the FRONT END's oversampling, 1x (as before, the default), 2x, 4x - each click steps
//   on. The FRONT END is the drive; COMP 2's grit and S SAT are light touches and stay at the base rate (ADAA). The dry
//   for MIX is delayed to match. A change dips the output for 5 ms, swaps, comes back. Latency 0 / 31 / 37 samples
//   (reported).

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc

slider1:4<0,18,0.1>-Drive (dB)
slider2:0<0,1,1{Iron,Class-A}>-Front end
slider3:0<0,1,1{Off,On}>-M/S drive
slider4:4<0,12,0.1>-Side drive (dB)
slider5:90<30,300,1>-Sidechain HPF (Hz)
slider6:-18<-40,0,0.1>-Comp 1 threshold (dB)
slider7:2<1,10,0.1>-Comp 1 ratio
slider8:40<10,80,1>-Comp 1 attack (ms)
slider9:300<50,1000,1>-Comp 1 release (ms)
slider10:3<0,12,0.1>-Comp 1 hysteresis (dB)
slider11:0<-6,6,0.1>-Tilt (dB)
slider12:-14<-40,0,0.1>-Comp 2 threshold (dB)
slider13:0<0,4,1{4:1,8:1,12:1,20:1,All}>-Comp 2 ratio
slider14:400<20,800,1>-Comp 2 attack (us)
slider15:300<50,1100,1>-Comp 2 release (ms)
slider16:2<0,24,0.1>-Comp 2 makeup (dB)
slider17:60<0,100,1>-Balance (Comp 1 <-> Comp 2, %)
slider18:-18<-30,0,0.1>-Bus comp threshold (dB)
slider19:0<0,2,1{2:1,4:1,10:1}>-Bus comp ratio
slider20:4<0,5,1{0.1 ms,0.3 ms,1 ms,3 ms,10 ms,30 ms}>-Bus comp attack
slider21:100<0,200,1>-Width (%)
slider22:0<0,100,1>-Side sat (%)
slider23:100<0,100,1>-Mix (%)
slider24:0<-24,12,0.1>-Output (dB)
slider25:0<-24,12,0.1>-Input trim (dB)
slider26:1<0,1,1{Off,On}>-Input guard
slider27:0<0,100,1>-Band sat (%)
slider28:30<0,100,1>-Bias (%)
slider29:120<40,400,1>-Sat low band (Hz)
slider30:6000<2000,16000,10>-Sat high band (Hz)
slider31:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider32:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider33:1<0,1,1{Out,In}>-Front end in
slider34:1<0,1,1{Out,In}>-Comp 1 in
slider35:1<0,1,1{Out,In}>-Comp 2 in
slider36:1<0,1,1{Out,In}>-Bus comp in
slider37:4<0,4,1{0.1 s,0.3 s,0.6 s,1.2 s,Auto}>-Bus comp release
slider38:5<0,18,0.1>-Bus comp makeup (dB)
slider39:1<0,1,1{Off,On}>-Link
slider40:0<0,2,1{1x,2x,4x}>-Oversampling
slider41:0<0,1,1{Off,On}>-Bypass

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;                                       // keep the state across transport start / stop (no reset mid-signal)
#ui_man = "gfx-benthick-3b";

// ---------- anti-aliasing (the house drive standard) ----------
// First-order ADAA: a curve f is read over the step from the previous argument u1 to u as (F(u) - F(u1)) / (u - u1),
// F its antiderivative (f at the midpoint when the two are within 1e-5). That reading sits half a sample late, so half
// the step, times the slope the signal sees, is added back: the small-signal slope (1), eased by the swing e (its
// smoothed RMS x sqrt 2, a sine's peak: a swing e through tanh keeps a gain of about 1 / sqrt(1 + e^2)). Small signals
// pass exactly (no droop, no lag), the driven fundamental keeps its level and the folded-back products are ADAA's.
function bt_lc(u) local(a) ( a = abs(u); a + log(1 + exp(-2 * a)) - 0.69314718056; );   // ln cosh u (0 at rest)
function bt_lag(d, u) instance(ms, es) (
  ms += (u * u - ms) * bt_er; es += (ms - es) * bt_es;
  0.5 * d / sqrt(1 + 2 * es);
);
// tanh(u), anti-aliased (instance: the previous argument and its antiderivative)
function bt_th(u) instance(u1, f1) local(f, d, y) (
  f = bt_lc(u); d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : ost_tanh(0.5 * (u + u1));
  u1 = u; f1 = f;
  y + this.bt_lag(d, u);
);
// CLASS-A's curve e / (1 + |e|^2.5)^0.4 has no closed antiderivative: a table (1024 points to |e| = 8, read
// linearly, its integral exact for that reading) and, beyond, the series 1 - 0.4 e^-2.5 + 0.28 e^-5 and its integral
bt_tn = 1024; bt_tu = 8; bt_tdx = bt_tu / bt_tn; bt_ti = 1 / bt_tdx; bt_tf = 60000; bt_tg = bt_tf + bt_tn + 2;
function bt_cbuild() local(i, v) (
  i = 0; loop(bt_tn + 2, v = i * bt_tdx; bt_tf[i] = v / (1 + v ^ 2.5) ^ 0.4; i += 1; );
  bt_tg[0] = 0; i = 0; loop(bt_tn + 1, bt_tg[i + 1] = bt_tg[i] + 0.5 * bt_tdx * (bt_tf[i] + bt_tf[i + 1]); i += 1; );
  bt_tgu = bt_tg[bt_tn] - bt_tu - 0.2666666667 * bt_tu ^ (-1.5) + 0.07 * bt_tu ^ (-4);
);
function bt_cf(e) local(v, p, i) (
  v = abs(e);
  v < bt_tu ? ( p = v * bt_ti; i = p | 0; v = bt_tf[i] + (p - i) * (bt_tf[i + 1] - bt_tf[i]); ) : v = 1 / (1 + v ^ (-2.5)) ^ 0.4;
  e < 0 ? -v : v;
);
function bt_cg(e) local(v, p, i, t) (
  v = abs(e);
  v < bt_tu ? ( p = v * bt_ti; i = p | 0; t = p - i; bt_tg[i] + bt_tdx * t * (bt_tf[i] + 0.5 * t * (bt_tf[i + 1] - bt_tf[i])); )
            : bt_tgu + v + 0.2666666667 * v ^ (-1.5) - 0.07 * v ^ (-4);
);
// the same for CLASS-A, whose firmer knee keeps more gain: its own secant, f(e) / e
function bt_lagc(d, u) instance(ms, es) local(e) (
  ms += (u * u - ms) * bt_er; es += (ms - es) * bt_es; e = sqrt(2 * es);
  e > 0.000001 ? 0.5 * d * bt_cf(e) / e : 0.5 * d;
);
function bt_ca(u) instance(u1, f1) local(f, d, y) (
  f = bt_cg(u); d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : bt_cf(0.5 * (u + u1));
  u1 = u; f1 = f;
  y + this.bt_lagc(d, u);
);
bt_cbuild();
bt_er = 1 - exp(-1 / (0.01 * srate)); bt_es = 1 - exp(-1 / (0.003 * srate));

// ---------- 1 FRONT END ----------
// IRON: the lows (below ~160 Hz) are driven harder into an asymmetric core (even harmonics, weight);
// a touch of the field's rate of change is added before the core, so it lags rising and falling
// signals differently (a small hysteresis loop). The rest of the band sees a gentler, symmetric core.
function fe_iron(x, g) instance(lo, um, ah) local(hi, u, d, yl, yh) (
  lo += (x - lo) * ir_lpc;
  hi = x - lo;
  u = lo * g * 1.6;
  d = u - um; um = u;
  u += ir_hy * d;
  yl = (ost_tanh(u + ir_b) - ir_tb) / (ir_sl * g * 1.6);          // (the band below 160 Hz: read plain, nothing folds back)
  yh = ah.bt_th(hi * g * 0.45) / (g * 0.45);
  yl + yh;
);
// CLASS-A: symmetric, firmer knee than tanh (odd harmonics, a dense edge); the upper mids are lifted
// into the clip and put back after it, so small signals stay flat and the harmonics land up there.
function fe_classa(x, g) instance(pz1, pz2, px1, px2, dz1, dz2, dx1, dx2, ac) local(e, y) (
  e = ca_b0 * x + ca_b1 * px1 + ca_b2 * px2 - ca_a1 * pz1 - ca_a2 * pz2;
  px2 = px1; px1 = x; pz2 = pz1; pz1 = e;
  y = ac.bt_ca(e * g) / g;
  e = cd_b0 * y + cd_b1 * dx1 + cd_b2 * dx2 - cd_a1 * dz1 - cd_a2 * dz2;
  dx2 = dx1; dx1 = y; dz2 = dz1; dz1 = e;
  e;
);
// the DC safeguard straight after the core: 1-pole high-pass at 5 Hz, then a gain clamp
function fe_dc(x) instance(xm, ym) local(y) (
  y = x - xm + dc_c * ym; xm = x; ym = y;
  min(max(y, -4), 4);
);
// a peaking biquad's coefficients (the CLASS-A pre / de-emphasis)
function pk_coefs(f, q, gdb, fs) local(w0, cw, al, A, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); al = sin(w0) / (2 * q); A = 10 ^ (gdb / 40);
  n = 1 + al / A; pk_b0 = (1 + al * A) / n; pk_b1 = -2 * cw / n; pk_b2 = (1 - al * A) / n; pk_a1 = pk_b1; pk_a2 = (1 - al / A) / n;
);

// the FRONT END's rate-dependent coefficients, at its running rate (srate x the OS factor)
function fe_rate() local(fs) (
  fs = srate * os_f;
  ir_lpc = 1 - exp(-2 * $pi * 160 / fs);
  pk_coefs(2800, 0.8, 4, fs);  ca_b0 = pk_b0; ca_b1 = pk_b1; ca_b2 = pk_b2; ca_a1 = pk_a1; ca_a2 = pk_a2;
  pk_coefs(2800, 0.8, -4, fs); cd_b0 = pk_b0; cd_b1 = pk_b1; cd_b2 = pk_b2; cd_a1 = pk_a1; cd_a2 = pk_a2;
  fe_er = 1 - exp(-1 / (0.01 * fs)); fe_es = 1 - exp(-1 / (0.003 * fs));   // the ADAA lag's followers in the FRONT END
);
os_design(); os_base = 0; os_f = os_tf = os_f2n(slider40); os_gsetup();
OSD = 70000;                                          // the dry's delay for MIX at 2x / 4x (64 per side)
fe_rate();
ir_b = 0.28; ir_tb = ost_tanh(ir_b); ir_sl = 1 - ir_tb * ir_tb;
dc_c = 1 - 2 * $pi * 5 / srate;
tl_c = 1 - exp(-2 * $pi * 700 / srate);
sm = 1 - exp(-1 / (0.03 * srate));
lk_c = 1 - exp(-1 / (0.01 * srate));   // LINK crossfade
c1_da = dy_ms(1); c1_dr = dy_ms(30);
b3_fr = dy_ms(100); b3_sa = dy_ms(500); b3_sr = dy_ms(1200);   // AUTO release: fast and slow halves

function update() local(r) (
  fe_on = slider33; c1_on = slider34; c2_on = slider35; li_on = slider36;
  lk_t = slider39 >= 0.5;
  drv_t = 10 ^ (slider1 / 20);
  topo_t = slider2;
  ms_on = slider3;
  sdrv_t = ms_on ? 10 ^ (slider4 / 20) : 1;
  ir_hy = 0.06 * srate * os_f / 1000 * (0.4 + 0.6 * slider1 / 18);
  os_tf = os_f2n(slider40);
  slider5 != sc_last ? ( sc_last = slider5;
    h3L.bq_set(1, slider5, 0.707, 0); h3R.bq_set(1, slider5, 0.707, 0);
    h1L.bq_set(1, slider5, 0.707, 0); h1R.bq_set(1, slider5, 0.707, 0);
    h2L.bq_set(1, slider5, 0.707, 0); h2R.bq_set(1, slider5, 0.707, 0); );
  c1_th = slider6; c1_ra = slider7; c1_at = dy_ms(slider8); c1_rl = dy_ms(slider9); c1_hy = slider10;
  tgl_t = 10 ^ (-slider11 / 40); tgh_t = 10 ^ (slider11 / 40);
  c2_th = slider12;
  r = floor(slider13 + 0.5); c2_all = r == 4;
  c2_ra = r == 0 ? 4 : r == 1 ? 8 : r == 2 ? 12 : 20;
  c2_kn = c2_all ? 0 : r == 0 ? 6 : r == 1 ? 4 : 2;
  c2_at = 1 - exp(-1 / (max(slider14, 1) * (c2_all ? 0.7 : 1) * 0.000001 * srate));
  c2_rl = dy_ms(slider15 * (c2_all ? 0.6 : 1));
  c2_mk_t = 10 ^ (slider16 / 20);
  c2_col = c2_all ? 0.45 : 0.2;
  pu_t = 1 - slider17 / 100;   // the share of the COMP 1 path
  r = floor(slider19 + 0.5); b3_ra = r == 0 ? 2 : r == 1 ? 4 : 10;
  r = floor(slider20 + 0.5); b3_at = dy_ms(r == 0 ? 0.1 : r == 1 ? 0.3 : r == 2 ? 1 : r == 3 ? 3 : r == 4 ? 10 : 30);
  r = floor(slider37 + 0.5); b3_auto = r == 4; b3_rl = dy_ms(r == 0 ? 100 : r == 1 ? 300 : r == 2 ? 600 : 1200);
  b3_th = slider18; b3_mk_t = 10 ^ (slider38 / 20);
  wid_t = slider21 / 100;
  ss_k = 1 + 11 * slider22 / 100; ss_on = slider22 > 0;
  mix_t = slider23 / 100;
  out_t = 10 ^ (slider24 / 20);
  in_setup(slider25, slider26);
  ost_setup(slider27 / 100, slider28 / 100, slider29, slider30, slider31, 0);   // output stage: straight through
  pdc_delay = os_base + os_lat(os_f);                                          // (ost_setup clears it)
);

// ---------- presets ----------
// drive, front end, M/S, side drive, SC HPF | C1 thresh, ratio, attack, release, hyst | tilt |
// C2 thresh, ratio key, attack, release, makeup | balance | bus thresh, ratio key, attack step | width, side sat, mix |
// bus release step, bus makeup
function setp(dv, fe, ms, sd, hp, t1, r1, a1, l1, hy, ti, t2, r2, a2, l2, mk, pu, ld, lc, lr, wd, ss, mx, br, bm) (
  slider1 = dv; slider2 = fe; slider3 = ms; slider4 = sd; slider5 = hp;
  slider6 = t1; slider7 = r1; slider8 = a1; slider9 = l1; slider10 = hy; slider11 = ti;
  slider12 = t2; slider13 = r2; slider14 = a2; slider15 = l2; slider16 = mk; slider17 = pu;
  slider18 = ld; slider19 = lc; slider20 = lr; slider21 = wd; slider22 = ss; slider23 = mx;
  slider37 = br; slider38 = bm;
);
PRESET_N = 10;
function pname(p) (
  p == 1 ? "Bus Glue" :
  p == 2 ? "Iron Low End" :
  p == 3 ? "Drum Smash" :
  p == 4 ? "Vocal Forward" :
  p == 5 ? "Wide Master" :
  p == 6 ? "Parallel Crush" :
  p == 7 ? "Mix Bus Polish" :
  p == 8 ? "Bass DI Weight" :
  p == 9 ? "Room Mic Grit" :
  p == 10 ? "Gentle Master" :
  p == 11 ? "Reset all to defaults" : "-";
);
function load_preset(p) (
  p == 1  ? setp(4, 0, 0, 4, 90, -18, 2, 40, 300, 3, 0, -14, 0, 400, 300, 2, 60, -18, 0, 4, 100, 0, 100, 4, 5) :
  p == 2  ? setp(8, 0, 0, 0, 120, -20, 2.5, 50, 400, 4, -1.5, -16, 0, 600, 400, 3, 50, -20, 0, 4, 100, 0, 100, 4, 7) :
  p == 3  ? setp(6, 1, 0, 0, 80, -22, 3, 30, 200, 2, 2, -24, 4, 20, 100, 8, 65, -22, 1, 2, 110, 10, 100, 1, 10.8) :
  p == 4  ? setp(3, 1, 0, 0, 150, -20, 2, 25, 250, 3, 1.5, -18, 1, 300, 200, 4, 70, -20, 0, 3, 100, 0, 100, 2, 8.5) :
  p == 5  ? setp(3, 0, 1, 6, 100, -16, 1.5, 50, 500, 4, 0.5, -10, 0, 800, 600, 1, 50, -16, 0, 5, 130, 25, 100, 4, 3.2) :
  p == 6  ? setp(10, 1, 0, 0, 90, -24, 4, 30, 200, 2, 0, -30, 4, 20, 80, 12, 80, -22, 2, 0, 100, 0, 60, 0, 9) :
  p == 7  ? setp(2, 0, 1, 3, 70, -14, 1.5, 40, 400, 3, 0.5, -8, 0, 600, 500, 1, 40, -15, 0, 4, 115, 15, 100, 4, 2.7) :
  p == 8  ? setp(10, 0, 0, 0, 60, -20, 3, 40, 300, 3, -2, -18, 1, 200, 150, 4, 70, -20, 1, 3, 100, 0, 100, 2, 7.4) :
  p == 9  ? setp(12, 1, 1, 6, 150, -26, 4, 15, 150, 1, 3, -30, 4, 20, 60, 10, 75, -24, 2, 0, 140, 40, 70, 1, 11.5) :
  p == 10 ? setp(1, 0, 0, 0, 50, -12, 1.3, 50, 600, 4, 0, -6, 0, 800, 800, 0, 30, -12, 0, 5, 105, 0, 100, 4, 1.3);
  p >= 1 && p <= 10 ? ( slider33 = 1; slider34 = 1; slider35 = 1; slider36 = 1; slider_automate(8388607 + 2 ^ 32 + 2 ^ 33 + 2 ^ 34 + 2 ^ 35 + 2 ^ 36 + 2 ^ 37); );   // sliders 1-23, 33-38
  p == 11 ? (                                   // Reset all to defaults
    setp(4, 0, 0, 4, 90, -18, 2, 40, 300, 3, 0, -14, 0, 400, 300, 2, 60, -18, 0, 4, 100, 0, 100, 4, 5);
    slider24 = 0; slider25 = 0; slider26 = 1; slider27 = 0; slider28 = 30; slider29 = 120; slider30 = 6000;
    slider31 = -0.3; slider32 = 1; slider33 = 1; slider34 = 1; slider35 = 1; slider36 = 1; slider39 = 1;
    slider_automate(2 ^ 39 - 1);
  );
);   // (@block picks the new values up with update())

// ---------- state ----------
ost_init(40000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
!ui_dflt ? ui_thm = 9; !ui_dflt ? ui_hw = 1;    // default for new instances: saved projects keep their own
pr_cur = 1;
sc_last = -1;
update();
drv_s = drv_t; topo_s = topo_t; sdrv_s = sdrv_t; tgl_s = tgl_t; tgh_s = tgh_t; c2_mk = c2_mk_t; pu_s = pu_t;
b3_mk = b3_mk_t; wid_s = wid_t; mix_s = mix_t; out_s = out_t; lk_s = lk_t;
g1 = 0; g2 = 0; g3 = 0; g3s = 0; e1 = 0; c1_eng = 0;
gr1_d = 0; gr2_d = 0; gr3_d = 0; pkI_d = 0; pkL_d = 0; pkR_d = 0;
ui_dflt = 1;

// ---------- dual mono (LINK off): one detector and gain per side, the same law as the linked one ----------
function c1_side(s) instance(e, g, eng) local(l, t) (
  e += (s - e) * (s > e ? c1_da : c1_dr);
  l = 20 * log10(max(e, 0.0000001));
  l > c1_th ? eng = 1 : l < c1_th - c1_hy ? eng = 0;
  t = dy_curve(l - c1_th, 6) * (1 - 1 / c1_ra);
  g += (t - g) * (t > g ? c1_at : (eng ? c1_rl * 0.2 : c1_rl));
);
function c2_side(s) instance(g) local(l, t) (
  l = 20 * log10(max(s, 0.0000001));
  t = dy_curve(l - c2_th, c2_kn) * (1 - 1 / c2_ra);
  g += (t - g) * (t > g ? c2_at : c2_rl);
);
function b3_side(s) instance(g, gs, ge) local(l, t) (
  l = 20 * log10(max(s, 0.0000001));
  t = dy_curve(l - b3_th, 4) * (1 - 1 / b3_ra);
  b3_auto ? (
    g += (t - g) * (t > g ? b3_at : b3_fr);
    gs += (g - gs) * (g > gs ? b3_sa : b3_sr);
    ge = max(g, gs);
  ) : (
    g += (t - g) * (t > g ? b3_at : b3_rl);
    ge = g;
  );
);
by_setup(41);                                           // BYPASS (gfx-bypass)

@slider
update();

@block
update();

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_var(0, pr_cur);

@sample
by_in();                                                // BYPASS: the untouched input
// OS: a change of factor dips the output and swaps at the silent point
os_gate();
os_chg ? ( fe_rate(); update(); feUA.os_clr(); feUB.os_clr(); feDA.os_clr(); feDB.os_clr(); memset(OSD, 0, 128);
           feIA.lo = feIB.lo = feIA.um = feIB.um = 0; );
// input stage: DC block, trim, guard
in_process(spl0, spl1);
xL = in_l; xR = in_r;
pkI_d = max(pkI_d, max(abs(xL), abs(xR)));

yL = xL; yR = xR;   // the dry, for MIX
os_f > 1 ? (        // (delayed to match the oversampled FRONT END)
  osd_w = (osd_w + 1) & 63; OSD[osd_w] = xL; OSD[64 + osd_w] = xR;
  osd_r = (osd_w - os_lat(os_f)) & 63; yL = OSD[osd_r]; yR = OSD[64 + osd_r];
);

drv_s += (drv_t - drv_s) * sm; topo_s += (topo_t - topo_s) * sm; sdrv_s += (sdrv_t - sdrv_s) * sm;
tgl_s += (tgl_t - tgl_s) * sm; tgh_s += (tgh_t - tgh_s) * sm;
c2_mk += (c2_mk_t - c2_mk) * sm; pu_s += (pu_t - pu_s) * sm; b3_mk += (b3_mk_t - b3_mk) * sm;
wid_s += (wid_t - wid_s) * sm; mix_s += (mix_t - mix_s) * sm; out_s += (out_t - out_s) * sm;
lk_s += (lk_t - lk_s) * lk_c; lk_s > 0.9999 && lk_t ? lk_s = 1; lk_s < 0.0001 && !lk_t ? lk_s = 0;
lk_u = 1 - lk_s;   // the dual-mono share (0 = linked, as v2.0)

// ---------- 1 FRONT END ----------
os_f > 1 ? (
  // 2x / 4x: up, the core at the high rate, down (the filters keep running with the FRONT END out: the latency stays)
  fe_on && ms_on ? ( fa = (xL + xR) * 0.5; fb = (xL - xR) * 0.5; ) : ( fa = xL; fb = xR; );
  feUA.os_up(fa); feUB.os_up(fb);
  gb = drv_s * sdrv_s;
  fe_bs = bt_er; fe_bt = bt_es; bt_er = fe_er; bt_es = fe_es;
  fe_i = 0;
  loop(os_f,
    fa = feUA.os_s(fe_i); fb = feUB.os_s(fe_i);
    fe_on ? (
      topo_s < 0.999 ? ( ia = feIA.fe_iron(fa, drv_s); ib = feIB.fe_iron(fb, gb); );
      topo_s > 0.001 ? ( ca = feCA.fe_classa(fa, drv_s); cb = feCB.fe_classa(fb, gb); );
      fa = topo_s < 0.001 ? ia : topo_s > 0.999 ? ca : ia + (ca - ia) * topo_s;
      fb = topo_s < 0.001 ? ib : topo_s > 0.999 ? cb : ib + (cb - ib) * topo_s;
    );
    fe_i == 0 ? ( fe_p0 = fa; fe_q0 = fb; ) : fe_i == 1 ? ( fe_p1 = fa; fe_q1 = fb; ) :
    fe_i == 2 ? ( fe_p2 = fa; fe_q2 = fb; ) : ( fe_p3 = fa; fe_q3 = fb; );
    fe_i += 1;
  );
  bt_er = fe_bs; bt_es = fe_bt;
  fa = feDA.os_dn(fe_p0, fe_p1, fe_p2, fe_p3); fb = feDB.os_dn(fe_q0, fe_q1, fe_q2, fe_q3);
  fe_on ? (
    ms_on ? ( xL = fa + fb; xR = fa - fb; ) : ( xL = fa; xR = fb; );
    xL = dcL.fe_dc(xL); xR = dcR.fe_dc(xR);
  ) : ( xL = fa; xR = fb; );
) : fe_on ? (
  ms_on ? ( fa = (xL + xR) * 0.5; fb = (xL - xR) * 0.5; ) : ( fa = xL; fb = xR; );
  gb = drv_s * sdrv_s;
  // IRON <-> CLASS-A: both run while the key's crossfade is moving, so the switch never clicks
  topo_s < 0.999 ? ( ia = feIA.fe_iron(fa, drv_s); ib = feIB.fe_iron(fb, gb); );
  topo_s > 0.001 ? ( ca = feCA.fe_classa(fa, drv_s); cb = feCB.fe_classa(fb, gb); );
  fa = topo_s < 0.001 ? ia : topo_s > 0.999 ? ca : ia + (ca - ia) * topo_s;
  fb = topo_s < 0.001 ? ib : topo_s > 0.999 ? cb : ib + (cb - ib) * topo_s;
  ms_on ? ( xL = fa + fb; xR = fa - fb; ) : ( xL = fa; xR = fb; );
  xL = dcL.fe_dc(xL); xR = dcR.fe_dc(xR);
);

// ---------- 2 COMP 1: the slow window, with the hysteresis gate on its detector ----------
d1a = abs(h1L.bq_run(xL)); d1b = abs(h1R.bq_run(xR));
s1 = max(d1a, d1b);
c1_on ? (
  e1 += (s1 - e1) * (s1 > e1 ? c1_da : c1_dr);
  l1 = 20 * log10(max(e1, 0.0000001));
  l1 > c1_th ? c1_eng = 1 : l1 < c1_th - c1_hy ? c1_eng = 0;
  t1 = dy_curve(l1 - c1_th, 6) * (1 - 1 / c1_ra);
  g1 += (t1 - g1) * (t1 > g1 ? c1_at : (c1_eng ? c1_rl * 0.2 : c1_rl));
  lk_u > 0 ? (
    c1a.c1_side(d1a); c1b.c1_side(d1b);
    lka = g1 + (c1a.g - g1) * lk_u; lkb = g1 + (c1b.g - g1) * lk_u;
    xL *= 10 ^ (-lka / 20); xR *= 10 ^ (-lkb / 20);
    gr1_d = max(gr1_d, max(lka, lkb));
  ) : (
    c1a.e = c1b.e = e1; c1a.g = c1b.g = g1; c1a.eng = c1b.eng = c1_eng;   // dual mono starts where linked is
    k1 = 10 ^ (-g1 / 20); xL *= k1; xR *= k1;
    gr1_d = max(gr1_d, g1);
  );
) : ( g1 = 0; e1 = 0; c1_eng = 0; c1a.e = c1b.e = c1a.g = c1b.g = c1a.eng = c1b.eng = 0; );

// ---------- TILT: a seesaw round 700 Hz ----------
tlL += (xL - tlL) * tl_c; tlR += (xR - tlR) * tl_c;
xL = tlL * tgl_s + (xL - tlL) * tgh_s;
xR = tlR * tgl_s + (xR - tlR) * tgh_s;

// ---------- 3 COMP 2: the fast FET grabber, then BALANCE sums it with the untouched COMP 1 path ----------
d2a = abs(h2L.bq_run(xL)); d2b = abs(h2R.bq_run(xR));
s2 = max(d2a, d2b);
c2_on ? (
  l2 = 20 * log10(max(s2, 0.0000001));
  t2 = dy_curve(l2 - c2_th, c2_kn) * (1 - 1 / c2_ra);
  g2 += (t2 - g2) * (t2 > g2 ? c2_at : c2_rl);
  lk_u > 0 ? (
    c2a.c2_side(d2a); c2b.c2_side(d2b);
    lka = g2 + (c2a.g - g2) * lk_u; lkb = g2 + (c2b.g - g2) * lk_u;
    cL = xL * 10 ^ (-lka / 20) * c2_mk; cR = xR * 10 ^ (-lkb / 20) * c2_mk;
    cL += min(lka / 20, 1) * c2_col * (c2aL.bt_th(cL) - cL); cR += min(lkb / 20, 1) * c2_col * (c2aR.bt_th(cR) - cR);
    gr2_d = max(gr2_d, max(lka, lkb));
  ) : (
    c2a.g = c2b.g = g2;
    k2 = 10 ^ (-g2 / 20) * c2_mk;
    cL = xL * k2; cR = xR * k2;
    // the gain cell's own colour: a little odd-order rounding as it works
    fc = min(g2 / 20, 1) * c2_col;
    cL += fc * (c2aL.bt_th(cL) - cL); cR += fc * (c2aR.bt_th(cR) - cR);
    gr2_d = max(gr2_d, g2);
  );
  xL = cL + (xL - cL) * pu_s;
  xR = cR + (xR - cR) * pu_s;
  // the fast gain cell can leave a little DC on lopsided waveforms: block it
  xL = dc2L.fe_dc(xL); xR = dc2R.fe_dc(xR);
) : ( g2 = 0; c2a.g = c2b.g = 0; );

// ---------- 4 BUS COMP: VCA glue over the summed COMP 1 / COMP 2 signal ----------
d3a = abs(h3L.bq_run(xL)); d3b = abs(h3R.bq_run(xR));
s3 = max(d3a, d3b);
li_on ? (
  l3 = 20 * log10(max(s3, 0.0000001));
  t3 = dy_curve(l3 - b3_th, 4) * (1 - 1 / b3_ra);
  b3_auto ? (
    // AUTO: a fast release after a transient, a slow one once it has been working a while
    g3 += (t3 - g3) * (t3 > g3 ? b3_at : b3_fr);
    g3s += (g3 - g3s) * (g3 > g3s ? b3_sa : b3_sr);
    g3e = max(g3, g3s);
  ) : (
    g3 += (t3 - g3) * (t3 > g3 ? b3_at : b3_rl);
    g3e = g3;
  );
  lk_u > 0 ? (
    b3a.b3_side(d3a); b3b.b3_side(d3b);
    lka = g3e + (b3a.ge - g3e) * lk_u; lkb = g3e + (b3b.ge - g3e) * lk_u;
    xL *= 10 ^ (-lka / 20) * b3_mk; xR *= 10 ^ (-lkb / 20) * b3_mk;
    gr3_d = max(gr3_d, max(lka, lkb));
  ) : (
    b3a.g = b3b.g = g3; b3a.gs = b3b.gs = g3s; b3a.ge = b3b.ge = g3e;
    k3 = 10 ^ (-g3e / 20) * b3_mk; xL *= k3; xR *= k3;
    gr3_d = max(gr3_d, g3e);
  );
) : ( g3 = 0; g3s = 0; b3a.g = b3b.g = b3a.gs = b3b.gs = 0; );
dL = xL; dR = xR;

// ---------- 5 WIDTH: M/S, the Sides into a second discrete stage ----------
wm = (dL + dR) * 0.5; ws = (dL - dR) * 0.5 * wid_s;
ss_on ? ws = ssa.bt_th(ws * ss_k) / ss_k;
dL = wm + ws; dR = wm - ws;

// MIX against the (delayed) dry, OUTPUT
oL = (yL + (dL - yL) * mix_s) * out_s;
oR = (yR + (dR - yR) * mix_s) * out_s;
oL = ostL.ost_band(oL); oR = ostR.ost_band(oR);
ost_out(oL, oR);
spl0 = ost_l * os_g;
spl1 = ost_r * os_g;
by_out();                                               // BYPASS: the crossfade to the untouched input
pkL_d = max(pkL_d, abs(spl0)); pkR_d = max(pkR_d, abs(spl1));

@gfx 1180 570
ui_begin(1180, 570);

FACE = 0x123A40; FACE2 = 0x0E2F34; INK = 0xE4EEEE; DIM = 0x8DB0B2;
COP = 0xD07A40; TEAL = 0x46C2BA; SAND = 0xD9CBA8; KEYC = 0x6A8C90;
dy_ink = INK; dy_bg = FACE; dy_kst = 7;
sc != bt_lsc ? ( bt_lsc = sc; gfx_setfont(15, "Trebuchet MS", 12 * sc, 'b'); );   // lamp key legends
// panel keys: house lamp keys (gfx-ui); the header's preset keys keep their own
function bt_key(x, y, w, h, on, col, s) ( lk_well = 0x081C20; lk_font = 15; lk_font2 = 15; lk_fit(x, y, w, h, on, col, s); );
function setv(idx, v) ( slider(idx) = v; ui_auto(idx); );   // @block runs update()
function bt_title(x, y, s, a) ( gfx_setfont(6, "Trebuchet MS", 13 * sc, 'b'); ui_cola(COP, a); gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
// a stage's IN key: lit amber while the stage is in
function bt_in(x, y, idx) ( bt_key(x, y, 40, 22, slider(idx) > 0.5, LK_AMB, "IN") ? setv(idx, slider(idx) > 0.5 ? 0 : 1); );
// a vertical gain-reduction meter, 1 - 20 dB, lit downwards
function bt_gr(x, y, gr) local(i, d, c, yy) (
  ui_col(0x061416); gfx_rect((x - 3) * sc, (y - 3) * sc, 22 * sc, 84 * sc);
  i = 0;
  loop(10,
    d = i == 0 ? 1 : i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 8 : i == 6 ? 10 : i == 7 ? 12 : i == 8 ? 15 : 20;
    yy = y + i * 8;
    c = d <= 4 ? 0x4AE08A : d <= 10 ? 0xF0B040 : 0xF0503A;
    ui_col(gr >= d ? c : ui_mix(c, 0x000000, 0.8)); gfx_rect(x * sc, yy * sc, 16 * sc, 6 * sc);
    i += 1;
  );
  rd_lbl(x + 8, y + 86, "GR", INK, 0.8);
);
// a horizontal gain-reduction meter, 1 - 20 dB, lit left to right
function bt_grh(x, y, gr) local(i, d, c, xx) (
  rd_lbl(x - 14, y + 1, "GR", INK, 0.8);
  ui_col(0x061416); gfx_rect((x - 3) * sc, (y - 3) * sc, 175 * sc, 16 * sc);
  i = 0;
  loop(10,
    d = i == 0 ? 1 : i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 8 : i == 6 ? 10 : i == 7 ? 12 : i == 8 ? 15 : 20;
    xx = x + i * 17;
    c = d <= 4 ? 0x4AE08A : d <= 10 ? 0xF0B040 : 0xF0503A;
    ui_col(gr >= d ? c : ui_mix(c, 0x000000, 0.8)); gfx_rect(xx * sc, y * sc, 14 * sc, 10 * sc);
    sprintf(#bt_gl, "%d", d); rd_lbl(xx + 7, y + 16, #bt_gl, INK, 0.55);
    i += 1;
  );
);
// a section panel: a slightly darker inset with its title
function bt_sect(x, y, w, h, title, on) (
  ui_col(FACE2); rd_rr(x * sc, y * sc, w * sc, h * sc, 6 * sc);
  ui_cola(0xFFFFFF, 0.07); gfx_line((x + 6) * sc, y * sc, (x + w - 6) * sc, y * sc);
  bt_title(x + 12, y + 8, title, on ? 1 : 0.45);
);
// grey the controls of a stage that is switched out
function bt_dim(x, y, w, h) ( ui_cola(FACE2, 0.55); gfx_rect(x * sc, y * sc, w * sc, h * sc); );

ui_col(0x050C0D); gfx_rect(0, 0, gfx_w, gfx_h);
rd_plate(26, 0, 1128, 570, FACE, 0);
rd_rack(0, 0, 1180, 570, 0x26383B);
ui_col(COP); gfx_rect(26 * sc, 66 * sc, 1128 * sc, 2 * sc);

// ---------- header: badge, title, PRESETS, prev / next, the LCD (click either for every preset), size ----------
rd_badge(60, 32, 15, COP, FACE);
rd_title(84, 14, "BENTHICK 3B", 26, INK);
rd_sub(282, 30, "IRON  ·  TRANSISTOR  ·  BUS PROCESSOR", DIM, 1);
pm_ = rd_sq(676, 20, 78, 30, 0, KEYC, "PRESETS");
rd_sq(760, 20, 30, 30, 0, KEYC, "") ? ( pr_cur = pr_cur <= 1 ? PRESET_N : pr_cur - 1; load_preset(pr_cur); );
rd_sq(794, 20, 30, 30, 0, KEYC, "") ? ( pr_cur = pr_cur >= PRESET_N ? 1 : pr_cur + 1; load_preset(pr_cur); );
// the arrows as shapes (fonts without the ◄ ► glyphs showed a box)
ui_col(ui_mix(KEYC, 0xDDDDDD, 0.35));
ui_sstri(771 * sc, 35 * sc, 779 * sc, 31 * sc, 779 * sc, 39 * sc); ui_sstri(813 * sc, 35 * sc, 805 * sc, 31 * sc, 805 * sc, 39 * sc);
pk_lcd(832 * sc, 12 * sc, 232 * sc, 46 * sc, 0);
ui_col(pk_lcdc);
strcpy(#plcd, pr_cur >= 1 && pr_cur <= PRESET_N ? pname(pr_cur) : "Custom");
pk_lcdfont(9, 27 * sc); gfx_measurestr(#plcd, ltw_, lth_); pk_fitstr(#plcd, 844 * sc, 35 * sc - lth_ * 0.5, 27 * sc, 212 * sc);
pm_ || (pressed && drag_id == 0 && mouse_x >= 832 * sc && mouse_x < 1064 * sc && mouse_y >= 12 * sc && mouse_y < 58 * sc) ? (
  drag_id = -1;
  strcpy(#pmenu, ""); k_ = 1;
  loop(11, k_ == pr_cur ? strcat(#pmenu, "!"); strcat(#pmenu, pname(k_)); k_ < 11 ? strcat(#pmenu, "|"); k_ += 1; );
  gfx_x = 676 * sc; gfx_y = 58 * sc;
  k_ = gfx_showmenu(#pmenu);
  k_ > 0 ? ( load_preset(k_); pr_cur = k_ <= PRESET_N ? k_ : 0; );
);
os_key(636, 24, 40, INK, 12);
by_key(520, 24, 41, 12);                              // BYPASS, left of OS
ui_size_picker(1080 * sc, 26 * sc);

// ---------- the columns, in signal order ----------
CY = 76; CH = 482;

// 1 FRONT END
bt_sect(40, CY, 210, CH, "1  FRONT END", fe_on);
bt_in(198, CY + 6, 33);
bt_key(54, 120, 88, 30, topo_t < 0.5, LK_YEL, "IRON") ? setv(2, 0);
bt_key(148, 120, 88, 30, topo_t > 0.5, LK_YEL, "CLASS-A") ? setv(2, 1);
rd_lbl(145, 162, topo_t < 0.5 ? "ASYMMETRIC CORE  ·  WEIGHT" : "SYMMETRIC CLIP  ·  EDGE", DIM, 0.9);
sprintf(#v, "+%.1f dB", slider1); dy_knob(145, 238, 32, 1, 0, 18, 4, 0, COP, "DRIVE", #v);
ui_cola(INK, 0.15); gfx_rect(56 * sc, 318 * sc, 178 * sc, 1 * sc);
bt_key(54, 336, 88, 30, ms_on, TEAL, "M/S") ? setv(3, ms_on ? 0 : 1);
rd_lbl(98, 378, ms_on ? "SIDES DRIVEN" : "L / R", DIM, 0.9);
sprintf(#v, "+%.1f dB", slider4); dy_knob(196, 352, 22, 4, 0, 12, 4, 0, TEAL, "S DRIVE", #v);
!ms_on ? ( ui_cola(FACE2, 0.6); gfx_circle(196 * sc, 352 * sc, 28 * sc, 1, 1); );
!fe_on ? bt_dim(48, CY + 34, 194, CH - 40);

// 2 COMP 1
bt_sect(258, CY, 210, CH, "2  COMP 1", c1_on);
rd_sub(272, CY + 28, "SLOW WINDOW", DIM, 1);
bt_in(416, CY + 6, 34);
sprintf(#v, "%.0f Hz", slider5); dy_kf = 1; dy_knob(302, 368, 22, 5, 30, 300, 90, 1, 0, "SC HPF", #v);
sprintf(#v, "%.1f dB", slider6); dy_knob(302, 168, 22, 6, -40, 0, -18, 0, TEAL, "THRESH", #v);
sprintf(#v, "%.1f:1", slider7); dy_knob(386, 168, 22, 7, 1, 10, 2, 1, TEAL, "RATIO", #v);
sprintf(#v, "%.0f ms", slider8); dy_knob(302, 268, 22, 8, 10, 80, 40, 0, SAND, "ATTACK", #v);
sprintf(#v, "%.0f ms", slider9); dy_knob(386, 268, 22, 9, 50, 1000, 300, 1, SAND, "RELEASE", #v);
sprintf(#v, "%.1f dB", slider10); dy_knob(386, 368, 22, 10, 0, 12, 3, 0, SAND, "HYST", #v);
bt_grh(284, 470, d1_gr);
!c1_on ? bt_dim(266, CY + 50, 194, CH - 56);

// 3 COMP 2
bt_sect(484, CY, 210, CH, "3  COMP 2", c2_on);
rd_sub(498, CY + 28, "FET", DIM, 1);
bt_in(642, CY + 6, 35);
c2r = floor(slider13 + 0.5);
bt_key(498, 124, 44, 30, c2r == 0, TEAL, "4") ? setv(13, 0);
bt_key(545, 124, 44, 30, c2r == 1, TEAL, "8") ? setv(13, 1);
bt_key(592, 124, 44, 30, c2r == 2, TEAL, "12") ? setv(13, 2);
bt_key(639, 124, 44, 30, c2r == 3, TEAL, "20") ? setv(13, 3);
bt_key(498, 160, 185, 30, c2r == 4, COP, "ALL") ? setv(13, c2r == 4 ? 0 : 4);
sprintf(#v, "%.1f dB", slider12); dy_knob(566, 368, 22, 12, -40, 0, -14, 0, TEAL, "THRESH", #v);
sprintf(#v, "%.0f us", slider14); dy_knob(566, 268, 22, 14, 20, 800, 400, 1, SAND, "ATTACK", #v);
sprintf(#v, "%.0f ms", slider15); dy_knob(650, 268, 22, 15, 50, 1100, 300, 1, SAND, "RELEASE", #v);
sprintf(#v, "+%.1f dB", slider16); dy_knob(650, 368, 22, 16, 0, 24, 2, 0, TEAL, "MAKEUP", #v);
bt_grh(510, 470, d2_gr);
!c2_on ? bt_dim(492, CY + 50, 194, CH - 56);

// TILT: the big knurled knob on the line between COMP 1 and COMP 2 (where it sits in the signal)
ui_cola(0x000000, 0.35); gfx_circle(477 * sc, 302 * sc, 51 * sc, 1, 1);
ui_col(FACE); gfx_circle(476 * sc, 300 * sc, 50 * sc, 1, 1);
ui_cola(COP, 0.6); gfx_circle(476 * sc, 300 * sc, 50 * sc, 0, 1);
dy_kst = 1; dy_ntick = 13;
sprintf(#v, "%+.1f dB", slider11); dy_knob(476, 300, 36, 11, -6, 6, 0, 0, COP, "", "");
dy_kst = 7; dy_ntick = 11;
// its name on a small dark plate under the ring (the value shows there while the knob is touched)
ui_col(0x000000); rd_rr(439 * sc, 359 * sc, 76 * sc, 28 * sc, 5 * sc);
ui_col(0x071A1D); rd_rr(440 * sc, 360 * sc, 74 * sc, 26 * sc, 4 * sc);
gfx_setfont(6, "Trebuchet MS", (dy_act ? 13 : 17) * sc, 'b'); ui_col(dy_act ? COP : INK);
ui_text(476 * sc, (dy_act ? 366 : 363) * sc, dy_act ? #v : "TILT");

// 4 SUM + BUS COMP
bt_sect(702, CY, 210, CH, "SUM", c2_on);
sprintf(#v, "%.0f / %.0f", 100 - slider17, slider17); dy_knob(807, 168, 28, 17, 0, 100, 60, 0, COP, "BALANCE", #v);
gfx_setfont(6, "Trebuchet MS", 15 * sc, 'b'); ui_col(INK); ui_text(760 * sc, 186 * sc, "1"); ui_text(854 * sc, 186 * sc, "2");
!c2_on ? bt_dim(710, CY + 30, 194, 150);
ui_cola(INK, 0.15); gfx_rect(716 * sc, 250 * sc, 182 * sc, 1 * sc);
bt_title(714, 262, "4  BUS COMP", li_on ? 1 : 0.45);
bt_in(860, 258, 36);
sprintf(#v, "%.1f dB", slider18); dy_knob(762, 450, 22, 18, -30, 0, -18, 0, TEAL, "THRESH", #v);
sprintf(#v, "+%.1f dB", slider38); dy_knob(852, 450, 22, 38, 0, 18, 5, 0, TEAL, "MAKEUP", #v);
dy_step = 6; dy_steps = ".1|.3|1|3|10|30"; dy_knob(762, 366, 22, 20, 0, 5, 4, 0, SAND, "ATTACK", "ms");
dy_step = 5; dy_steps = ".1|.3|.6|1.2|A"; dy_knob(852, 366, 22, 37, 0, 4, 4, 0, SAND, "RELEASE", floor(slider37 + 0.5) == 4 ? "AUTO" : "s");
b3r = floor(slider19 + 0.5);
bt_key(716, 290, 58, 26, b3r == 0, TEAL, "2") ? setv(19, 0);
bt_key(778, 290, 58, 26, b3r == 1, TEAL, "4") ? setv(19, 1);
bt_key(840, 290, 58, 26, b3r == 2, TEAL, "10") ? setv(19, 2);
bt_grh(730, 518, d3_gr);
!li_on ? bt_dim(710, 288, 194, CH - 216);

// 5 WIDTH / MIX / OUTPUT + meters
bt_sect(920, CY, 220, CH, "5  OUTPUT", 1);
bt_key(1066, CY + 6, 60, 22, slider39 >= 0.5, TEAL, "LINK") ? setv(39, slider39 >= 0.5 ? 0 : 1);
sprintf(#v, "%.0f%%", slider21); dy_knob(980, 168, 24, 21, 0, 200, 100, 0, TEAL, "WIDTH", #v);
sprintf(#v, "%.0f%%", slider22); dy_knob(1080, 168, 24, 22, 0, 100, 0, 0, COP, "S SAT", #v);
sprintf(#v, "%.0f%%", slider23); dy_knob(980, 278, 24, 23, 0, 100, 100, 0, SAND, "MIX", #v);
sprintf(#v, "%+.1f dB", slider24); dy_knob(1080, 278, 28, 24, -24, 12, 0, 0, 0x2A3436, "OUTPUT", #v);
pk_lcd(934 * sc, 352 * sc, 192 * sc, 64 * sc, 0);
pk_lcdfont(9, 11 * sc); ui_col(pk_lcdc);
sprintf(#gl, "COMP 1  %4.1f dB", d1_gr); gfx_x = 946 * sc; gfx_y = 358 * sc; gfx_drawstr(#gl);
sprintf(#gl, "COMP 2  %4.1f dB", d2_gr); gfx_x = 946 * sc; gfx_y = 376 * sc; gfx_drawstr(#gl);
sprintf(#gl, "BUS     %4.1f dB", d3_gr); gfx_x = 946 * sc; gfx_y = 394 * sc; gfx_drawstr(#gl);
ui_col(0x061416); gfx_rect(934 * sc, 428 * sc, 192 * sc, 110 * sc);
mI.ui_ledm(948 * sc, 434 * sc, 26 * sc, 86 * sc, pkI_d);
mL.ui_ledm(1048 * sc, 434 * sc, 26 * sc, 86 * sc, pkL_d); mR.ui_ledm(1086 * sc, 434 * sc, 26 * sc, 86 * sc, pkR_d);
rd_lbl(961, 524, "IN", INK, 0.8); rd_lbl(1080, 524, "OUT", INK, 0.8);
pkI_d *= 0.85; pkL_d *= 0.85; pkR_d *= 0.85;

// the meters fall back smoothly between redraws
d1_gr = max(gr1_d, d1_gr * 0.85); d2_gr = max(gr2_d, d2_gr * 0.85); d3_gr = max(gr3_d, d3_gr * 0.85);
gr1_d = 0; gr2_d = 0; gr3_d = 0;

pk_end();
ui_end();
