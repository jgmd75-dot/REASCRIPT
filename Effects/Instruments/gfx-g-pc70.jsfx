function ms2c(ms) ( exp(-1/(max(ms, 0.1)*0.001*srate)); );
function dset(b, f, pe, pt, td, ta, na, nd_, nf, hp, lv) local(g, k) (
  b[42] = f; b[43] = pe; b[44] = ms2c(pt); b[45] = ms2c(td); b[8] = ta; b[46] = na; b[47] = ms2c(nd_); b[48] = hp;
  g = tan($pi*min(nf, srate*0.45)/srate); k = hp ? 1.4 : 0.9;
  b[20] = k; b[50] = 1/(1 + g*(g + k)); b[51] = g*b[50]; b[52] = g*b[51];
  b[38] = 1; b[39] = 1; b[40] = 1; b[62] *= lv;
);
function drum_setup(b, n) (
  n == 35 || n == 36 ? dset(b, 50, 2.2, 35, 320, 1, 0.08, 15, 3000, 0, 1.1) :
  n == 37 ? dset(b, 420, 0.3, 5, 40, 0.6, 0.4, 30, 2500, 0, 0.7) :
  n == 38 ? dset(b, 190, 0.5, 15, 110, 0.5, 0.75, 170, 3500, 1, 0.9) :
  n == 40 ? dset(b, 210, 0.5, 12, 90, 0.4, 0.85, 150, 5000, 1, 0.9) :
  n == 39 ? dset(b, 0, 0, 1, 1, 0, 1, 160, 1200, 0, 1) :
  n == 42 ? dset(b, 0, 0, 1, 1, 0, 0.6, 45, 8000, 1, 0.6) :
  n == 44 ? dset(b, 0, 0, 1, 1, 0, 0.55, 65, 7500, 1, 0.5) :
  n == 46 ? dset(b, 0, 0, 1, 1, 0, 0.55, 380, 7500, 1, 0.55) :
  n == 41 || n == 43 || n == 45 || n == 47 || n == 48 || n == 50 ?
    dset(b, n == 41 ? 80 : n == 43 ? 95 : n == 45 ? 110 : n == 47 ? 135 : n == 48 ? 155 : 180, 0.5, 60, 350, 1, 0.08, 40, 2000, 0, 0.9) :
  n == 49 || n == 57 || n == 52 ? dset(b, 0, 0, 1, 1, 0, 0.5, 1300, 5500, 1, 0.55) :
  n == 55 ? dset(b, 0, 0, 1, 1, 0, 0.5, 600, 6500, 1, 0.5) :
  n == 51 || n == 59 ? dset(b, 3100, 0, 1, 900, 0.12, 0.3, 1100, 7000, 1, 0.55) :
  n == 53 ? dset(b, 2300, 0, 1, 700, 0.5, 0.15, 600, 6000, 1, 0.55) :
  n == 54 ? dset(b, 0, 0, 1, 1, 0, 0.5, 160, 9000, 1, 0.5) :
  n == 56 ? dset(b, 560, 0, 1, 250, 0.6, 0.1, 80, 800, 0, 0.6) :
  n >= 60 && n <= 64 ? dset(b, n == 60 ? 300 : n == 61 ? 220 : n == 62 ? 200 : n == 63 ? 170 : 140, 0.3, 20, 180, 1, 0.1, 30, 2000, 0, 0.8) :
  n == 69 || n == 70 ? dset(b, 0, 0, 1, 1, 0, 0.45, 70, 7000, 1, 0.45) :
  n == 75 ? dset(b, 2500, 0, 1, 60, 0.8, 0, 1, 1000, 0, 0.6) :
  n == 76 || n == 77 ? dset(b, n == 76 ? 1700 : 1300, 0, 1, 70, 0.8, 0.05, 20, 2000, 0, 0.6) :
  dset(b, 600, 0.2, 10, 80, 0.4, 0.4, 60, 3000, 0, 0.5);
);


// one GM voice or drum on its own block (pb = the voice block + 100): set up at the key
// the GM voices' amp and filter envelopes, from the patch and the EDIT knobs (at note-on and while a note plays)
function p_env(pb, q) (
  pb[28] = 1/max(1, max(q[6]*atk_k + max(0, atk_k - 1)*150, 1)*0.001*srate); pb[29] = 1 - exp(-4.6/(max(q[7]*dec_k, 1)*0.001*srate));
  pb[30] = min(max(q[8] + sus_o, 0), 1); pb[31] = 1 - exp(-4.6/(max(q[9]*rel_k, 1)*0.001*srate));
  pb[5] = 1/max(1, max(q[6]*fatk_k + max(0, fatk_k - 1)*150, 1)*0.001*srate); pb[6] = 1 - exp(-4.6/(max(q[7]*fdec_k, 1)*0.001*srate));
  pb[7] = min(max(q[8] + fsus_o, 0), 1); pb[9] = 1 - exp(-4.6/(max(q[9]*frel_k, 1)*0.001*srate));
);
function p_on(v, b, n, vg) local(pb, q, at, de, re, f, len, j, lp, k) (
  pb = b + 100;
  memset(pb, 0, 64);
  pb[3] = n; pb[37] = (rand(2) - 1)*drift*3;            // drift: a tiny tuning scatter per note
  eng == 7 ? (
    n == 42 || n == 44 ? ( k = 0; loop(NV, VB[k*VS + F_ACT] && VB[k*VS + 103] == 46 ? ( VB[k*VS + F_ACT] = 0; VB[k*VS + 100] = 0; ); k += 1; ); );   // hats choke the open hat
    pb[49] = -1; pb[62] = vg*vg*1.6; pb[0] = 2; pb[1] = 1;
    drum_setup(pb, n);
  ) : (
    q = PG + gprog*16;
    pb[49] = q[0]; pb[10] = n;
    p_env(pb, q);                                       // the filter envelope starts as the patch's amp shape
    pb[55] = q[10] > 0 ? 2^(q[10]/1200) : 0; pb[56] = q[11]; pb[57] = q[12]; pb[58] = q[13];
    pb[59] = q[4]; pb[60] = q[5];
    pb[61] = min(max(q[2]*2^(fl_fo + fl_to), 30), srate*0.45);
    pb[20] = 2*(1 - min(max(q[3] + fl_rs*(0.95 - q[3]), 0), 0.95));
    pb[62] = vg*10^(q[15]/20)*0.5; pb[63] = q[14];
    pb[54] = q[12]; pb[53] = q[0] == 4 ? exp(-1/(max(q[13], 5)*0.001*srate)) : 1; pb[16] = q[12];
    pb[0] = 1; pb[1] = 0; pb[24] = 0; pb[22] = rand(1); pb[4] = 1; pb[2] = 0;
    q[0] == 5 ? (                                       // pluck: fill the line with a noise burst
      f = 440*2^((n + q[1] - 69)/12);
      len = min(max(floor(srate/f), 2), 4090); pb[26] = len; pb[25] = 0;
      lp = 0; j = 0; loop(len, lp += (rand(2) - 1 - lp)*min(1, q[2]/8000 + 0.2); KSB[v*KSL + j] = lp*2; j += 1; );
    );
  );
);
// the output filter's coefficients and the analogue voices' resonance, from the glided FILTER / RESONANCE
function fl_gf() (
  gf_g = tan($pi * min(18000 * 2 ^ fl_fo, srate * 0.45) / srate); gf_k = 2 - 1.9 * fl_rs;
  gf_a1 = 1 / (1 + gf_g * (gf_g + gf_k)); gf_a2 = gf_g * gf_a1; gf_a3 = gf_g * gf_a2;
  va_res = fres + fl_rs * (1.02 - fres);
);
// control rate (every 32 samples): pitch, vibrato, mod wheel, filter
function p_ctl(pb) local(q, vib, st, f, oct, g, k) (
  q = PG + gprog*16;
  p_env(pb, q);
  pb[22] += 5.5*32/srate; pb[22] -= floor(pb[22]);
  vib = sin(2*$pi*pb[22]);
  st = pb[10] + q[1] + (vib*(pb[63] + modw*50) + pb[37])/100;
  f = 440*2^((st - 69)/12)*tune*pdrift;
  pb[11] = min(f/srate, 0.45);
  pb[12] = pb[55] > 0 ? min(pb[11]*pb[55], 0.45) : 0;
  oct = (pb[59]*fl_fa + max(0, fl_fa - 1)*1.5)*(pb[2] - 1) + pb[60]*(pb[10] - 60)/12 + ins_cut;
  f = min(max(pb[61]*2^oct, 30), srate*0.45);
  g = tan($pi*f/srate); k = pb[20];
  pb[50] = 1/(1 + g*(g + k)); pb[51] = g*pb[50]; pb[52] = g*pb[51];
);
// one sample
function p_run(v, pb, held) local(t, y, ph, s, p2, nz, v1, v2, v3, k, a1, a2, a3, i0, i1, o) (
  y = 0;
  pb[49] < 0 ? (
    // drum
    pb[38] *= pb[44]; pb[39] *= pb[45]; pb[40] *= pb[47];
    pb[42] > 0 ? ( pb[13] += pb[42]*(1 + pb[43]*pb[38])/srate; pb[13] -= floor(pb[13]); y = sin(2*$pi*pb[13])*pb[39]*pb[8]; );
    pb[46] > 0 ? (
      nz = rand(2) - 1;
      k = pb[20]; a1 = pb[50]; a2 = pb[51]; a3 = pb[52];
      v3 = nz - pb[18]; v1 = a1*pb[17] + a2*v3; v2 = pb[18] + a2*pb[17] + a3*v3; pb[17] = 2*v1 - pb[17]; pb[18] = 2*v2 - pb[18];
      y += (pb[48] ? nz - k*v1 - v2 : k*v1)*pb[40]*pb[46];
    );
    pb[39] < 0.0001 && pb[40] < 0.0001 ? pb[0] = 0;
    y *= pb[62]*0.9;
  ) : (
    !held && pb[0] > 0 && pb[0] < 3 ? ( pb[0] = 3; pb[4] = 3; );
    pb[4] == 1 ? ( pb[2] += pb[5]; pb[2] >= 1 ? ( pb[2] = 1; pb[4] = 2; ); ) :
    pb[4] == 2 ? ( pb[2] += (pb[7] - pb[2])*pb[6]; ) :
    ( pb[2] += (0 - pb[2])*pb[9]; );
    pb[0] == 1 ? ( pb[1] += pb[28]; pb[1] >= 1 ? ( pb[1] = 1; pb[0] = 2; ); ) :
    pb[0] == 2 ? ( pb[1] += (pb[30] - pb[1])*pb[29]; ) :
    ( pb[1] += (0 - pb[1])*pb[31]; pb[1] < 0.0001 ? pb[0] = 0; );
    (pb[24] -= 1) <= 0 ? ( pb[24] = 32; p_ctl(pb); );
    t = pb[49];
    pb[13] += pb[11]; pb[13] -= floor(pb[13]); ph = pb[13];
    t == 0 ? ( y = sin(2*$pi*ph); pb[57] > 0 ? ( pb[27] += (rand(2) - 1 - pb[27])*0.3; y += pb[57]*pb[27]*2; ); ) :
    t == 1 ? ( y = 1 - 4*abs(ph - 0.5); pb[12] > 0 ? ( pb[14] += pb[12]; pb[14] -= floor(pb[14]); y = (y + 1 - 4*abs(pb[14] - 0.5))*0.6; ); ) :
    t == 2 || t == 8 ? (
      y = 2*ph - 1 - vo_blep(ph, pb[11]);
      pb[12] > 0 ? ( pb[14] += pb[12]; pb[14] -= floor(pb[14]); y = (y + 2*pb[14] - 1 - vo_blep(pb[14], pb[12]))*0.6; );
    ) :
    t == 3 ? (
      p2 = ph + 1 - pb[56]; p2 -= floor(p2);
      y = (2*ph - 1 - vo_blep(ph, pb[11])) - (2*p2 - 1 - vo_blep(p2, pb[11]));
      pb[12] > 0 ? ( pb[14] += pb[12]; pb[14] -= floor(pb[14]); p2 = pb[14] + 1 - pb[56]; p2 -= floor(p2);
                    y = (y + (2*pb[14] - 1 - vo_blep(pb[14], pb[12])) - (2*p2 - 1 - vo_blep(p2, pb[12])))*0.6; );
    ) :
    t == 4 ? (
      pb[15] += pb[11]*pb[56]; pb[15] -= floor(pb[15]);
      pb[16] = pb[16]*pb[53] + pb[54]*0.15*(1 - pb[53]);       // the index falls towards 15 % of its start
      y = sin(2*$pi*ph + pb[16]*sin(2*$pi*pb[15]));
    ) :
    t == 5 ? (
      o = KSB + v*KSL; i0 = pb[25]; i1 = i0 + 1; i1 >= pb[26] ? i1 = 0;
      y = o[i0]; o[i0] = (o[i0] + o[i1])*0.5*pb[58]; pb[25] = i1;
    ) :
    t == 6 ? ( y = rand(2) - 1; ) :
    t == 7 ? ( y = (sin(2*$pi*ph) + pb[56]*sin(4*$pi*ph) + pb[57]*sin(6*$pi*ph) + 0.35*sin(8*$pi*ph))*0.5; );
    // 12 dB state-variable low-pass
    a1 = pb[50]; a2 = pb[51]; a3 = pb[52];
    v3 = y - pb[18]; v1 = a1*pb[17] + a2*v3; v2 = pb[18] + a2*pb[17] + a3*v3; pb[17] = 2*v1 - pb[17]; pb[18] = 2*v2 - pb[18];
    y = v2*pb[1]*pb[62];
  );
  y;
);

function note_on(n, vel) local(v, b, f0, vg, h, Tn, j, k, L, x, rr, ratio, amp, dk, w, was, hd, Bc) (
  f0 = 440 * 2 ^ ((n - 69) / 12) * tune;
  vg = (1 - sens) + sens * (vel / 127) ^ 1.3;
  h = vel / 127;
  mono && eng == 0 ? (
    v = 0;                                   // mono: always voice 0, glide from the last note
    b = VB;
    b[F_DCF] = 1; !b[F_ACT] ? ( b[F_PY] = 0; b[F_PY2] = 0; b[F_DCO] = 0; ); b[F_ATK] = 1;
    mono_n >= 0 && b[F_ACT] && b[F_AE] > 0.01 ? ( b[F_F0] = f0; b[F_G] = 1; b[F_N] = n; b[F_VEL] = vg; mono_n = n; ) : (
      was = b[F_ACT];                        // still ringing: rise from where it is
      b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0; mono_f = f0;
      b[F_DT] = 1; b[F_VT] = 0; !was ? ( b[F_AE] = 0; b[F_FE] = 0; );
      b[F_AST] = 0; b[F_FST] = 0; mono_n = n;
    );
  ) : (
  // re-strike the same key on the same voice, else a free / old one
  v = -1; k = 0; loop(NV, VB[k * VS + F_N] == n && VB[k * VS + F_ACT] ? v = k; k += 1; );
  v < 0 ? v = vfree();
  b = VB + v * VS;
  age += 1; b[F_AGE] = age;
  was = b[F_ACT];                                          // re-struck / reused while still sounding?
  b[F_DCF] = 1; !was ? ( b[F_PY] = 0; b[F_PY2] = 0; b[F_DCO] = 0; );
  b[F_ATK] = eng == 0 && ks_lvl == 0 && bl_lvl == 0 ? 1 : 0;   // struck / plucked sounds get a short fade-in
  b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0;
  b[F_DT] = ins_note_detune();                              // each note slightly out (GFX drift)
  b[F_E1] = (rand(2) - 1) * drift * 0.35;                   // ... and slightly brighter / darker
  b[F_AST] = 0; b[F_FST] = 0; b[F_VT] = 0; !was ? b[F_FE] = 0;
  eng >= 6 ? (
    // the GM voices and the drum kit (the PC70 engine)
    p_on(v, b, n, vg);
    b[F_ATK] = eng == 7 ? 1 : 0;
  ) : eng == 0 ? (
    // a sounding voice keeps its oscillators and rises from where it is; a fresh one starts clean
    !was ? ( b[F_P1] = rand(1); b[F_P2] = rand(1); b[F_P3] = rand(1); b[F_AE] = 0; b[F_O1] = 0; b[F_O2] = 0; b[F_O3] = 0; );
    // attack / extra layers
    Tn = 2 ^ (-(n - 72) / 24) * dec_k;
    k = 0; loop(4, b[F_MA + k] = 0; k += 1; );
    bl_lvl > 0 && !nd ? (
      bell_set(b, f0, vg, h, bR0, vg * bl_lvl * bA0,              bD0 * Tn, 0);
      bell_set(b, f0, vg, h, bR1, vg * bl_lvl * bA1 * (0.5 + h), bD1 * Tn, 1);
      bell_set(b, f0, vg, h, bR2, vg * bl_lvl * bA2 * (0.4 + h), bD2 * Tn, 2);
      bell_set(b, f0, vg, h, bR3, vg * bl_lvl * bA3 * (0.3 + h), bD3 * Tn, 3);
    );
    ks_lvl > 0 ? ks_setup(v, b, f0, vg * ks_lvl, h, ks_T * 2 ^ (-(n - 60) / 24) * dec_k, ks_br, ks_pick);
    b[F_CLK] = chf * vg;
    b[F_PE] = pe_amt;
  ) : eng == 4 ? (
    // synthetic piano: stretched partials, two strings each (a quick prompt string and a slower, detuned
    // after-ring one); velocity sets the hammer: brightness, loudness, knock and how fast the top fades
    Tn = 7 * pn_T * 2 ^ (-(n - 40) / 17) * dec_k;
    hd = min(max(pn_hard * (0.15 + 1.15 * h ^ 1.2) + (tone - 0.5) * 0.5, 0.05), 1.15);
    vg = (1 - min(sens * 1.3, 1)) + min(sens * 1.3, 1) * h * h;     // a wider dynamic range than the synths
    Bc = 0.00025 * 2 ^ ((n - 60) / 20);
    k = 0;
    loop(8,
      j = k + 1;
      ratio = j * sqrt(1 + Bc * j * j);
      amp = vg * j ^ -0.85 * hd ^ ((j - 1) * 0.75) * (0.35 + 0.65 * abs(sin($pi * j * 0.13)) );
      dk = Tn / (1 + 0.45 * (j - 1) * (0.6 + 0.8 * h));
      pn_set(b, k * 2,     f0 * ratio,                                   amp * 0.72, dk * 0.42);
      pn_set(b, k * 2 + 1, f0 * ratio * 2 ^ ((0.9 + 0.5 * k) * pn_uni / 1200), amp * 0.38, dk * 1.5);
      k += 1;
    );
    b[F_CLK] = pn_knock * (0.05 + 0.3 * h * h) * vg;       // the hammer's knock
    b[F_HN] = 0; b[F_HL] = 0; b[F_AE] = 1;
  ) : eng == 5 ? (
    // drawbar organ: 16' 8' 5 1/3' 4' + a little 2 2/3' and 2', third-harmonic percussion on fresh chords
    k = 0;
    loop(9,
      ratio = k == 0 ? 0.5 : k == 1 ? 1 : k == 2 ? 1.5 : k == 3 ? 2 : k == 4 ? 3 : k == 5 ? 4 : k == 6 ? 5 : k == 7 ? 6 : 8;
      amp = k == 0 ? 0.8 : k == 1 ? 0.8 : k == 2 ? 0.8 : k == 3 ? 0.45 : k == 4 ? 0.25 : k == 5 ? 0.2 : 0.06;
      pn_set(b, k, f0 * ratio, amp * vg * 0.5, 0);
      k += 1;
    );
    pn_set(b, 9, f0 * 3, org_perc * (nact == 0 ? 1 : 0.3) * vg * 0.6, 0.35);
    b[F_CLK] = 0.15 * vg;                                 // key click
    b[F_AE] = 1; b[F_HN] = 0; b[F_HL] = 0;
  ) :
  eng == 1 ? (
    // FM e-piano: carriers C1 (body) and C3 (tine), modulators M2 (ratio 1) and M4 (ratio 14)
    !was ? ( b[F_O1] = 0; b[F_O2] = 0; b[F_O3] = 0; b[F_O4] = 0; );
    Tn = 4.5 * 2 ^ (-(n - 48) / 20);
    b[F_E1] = vg; b[F_E2] = 0.9 + 1.6 * h; b[F_E3] = vg * 0.55; b[F_E4] = 0.6 + 2.2 * h * h;
    b[F_MD] = tc(Tn * dec_k); b[F_MD + 1] = tc(Tn * 0.35 * dec_k); b[F_MD + 2] = tc(Tn * 0.4 * dec_k); b[F_MD + 3] = tc(0.09 + 0.05 * (1 - h));
    b[F_AE] = 1;
  ) : eng == 2 ? (
    // clav: a bright pluck, pickup near the string's end
    ks_setup(v, b, f0, vg, h, 4 * 2 ^ (-(n - 48) / 24) * dec_k, 0.4, 1);
    b[F_AE] = 1;
  ) : (
    // glockenspiel bar: 4 inharmonic partials
    Tn = 3.2 * 2 ^ (-(n - 72) / 24) * dec_k;
    k = 0;
    loop(4,
      ratio = k == 0 ? 1 : k == 1 ? 2.756 : k == 2 ? 5.404 : 8.933;
      amp = vg * (k == 0 ? 1 : k == 1 ? 0.22 + 0.25 * h : k == 2 ? 0.08 + 0.15 * h : 0.04 + 0.08 * h);
      dk = Tn * (k == 0 ? 1 : k == 1 ? 0.35 : k == 2 ? 0.14 : 0.07);
      bell_set(b, f0, vg, h, ratio, amp, dk, k);
      k += 1;
    );
    b[F_CLK] = vg * (0.1 + 0.15 * h);                      // mallet click (soft)
    b[F_AE] = 1;
  );
  );
);
function note_off(n) local(v, b) (
  v = 0; loop(NV, b = VB + v * VS; b[F_N] == n && b[F_G] ? ( b[F_G] = 0; b[F_S] = pedal; ); v += 1; );
  mono && n == mono_n ? mono_n = -1;
);
function pedal_set(on) local(v) ( pedal = on; !on ? ( v = 0; loop(NV, VB[v * VS + F_S] = 0; v += 1; ); ); );
function all_off() local(v) ( v = 0; loop(NV, VB[v * VS + F_G] = 0; VB[v * VS + F_S] = 0; v += 1; ); pedal = 0; );
function kill_all() ( memset(VB, 0, NV * VS); memset(KSB, 0, NV * KSL); pedal = 0; mono_n = -1; );

// ---------- reverb (GFX Space engine) ----------
rv_a = 96000;                                 // small arrays: 8 per field
rlw = rv_a; rlz = rv_a + 10; rlph = rv_a + 20; rlrt = rv_a + 30; rllen = rv_a + 40; rlga = rv_a + 50; rlgb = rv_a + 60;
rapw = rv_a + 70; rapl = rv_a + 80; rbl = rv_a + 90; rtmp = rv_a + 100; rmix = rv_a + 110;
memset(rv_a, 0, 120);
rbl[0] = 31.7; rbl[1] = 37.1; rbl[2] = 41.3; rbl[3] = 47.9; rbl[4] = 53.3; rbl[5] = 61.1; rbl[6] = 70.7; rbl[7] = 79.3;
rapl[0] = 142; rapl[1] = 107; rapl[2] = 379; rapl[3] = 277;
i = 0; loop(8, rlrt[i] = 0.31 + 0.11 * i; rlph[i] = rand(1); i += 1; );
RBLK = ceil(0.16 * srate) + 16;
rpre_b = 100000; rpre_len = ceil(0.16 * srate) + 8;
rap_b = rpre_b + rpre_len;                    // 4 diffusers, rings of 4096
rln_b = rap_b + 4 * 4096;                     // 8 lines
memset(rpre_b, 0, rln_b + 8 * RBLK - rpre_b);
rpre_w = 0; rv_on = 0;
bt_pos = 0; nd_last = -1;
function rv_update() local(i, sz, L, gl, gh, a, t60) (
  rtyp = floor(slider14 + 0.5);
  sz = rtyp == 0 ? 0.42 : rtyp == 1 ? 1 : 0.55;
  rdiff = rtyp == 2 ? 0.95 : 0.75;
  rpre = slider15 * 0.001 * srate;
  t60 = slider16 * 1.11;
  rmod = rtyp == 2 ? 0.0004 : 0.0008;
  i = 0;
  loop(8,
    L = min(rbl[i] * sz * 0.001 * srate, RBLK - 64);
    rllen[i] = L;
    gl = 10 ^ (-3 * L / (t60 * srate));
    gh = 10 ^ (-3 * L / (t60 * (1 - 0.9 * slider17 / 100) * srate * (rtyp == 2 ? 1.4 : 1)));
    a = (gl - gh) / (gl + gh); rlga[i] = a; rlgb[i] = gl * (1 - a);
    i += 1;
  );
  rv_wet = slider18 / 100;
  rv_on = rv_wet > 0.001;
);

// ---------- MOD RACK (the GFX Mod Rack inside): chorus, tremolo, vibe, delay in parallel on the voices ----------
// each module adds only its change ("delta") to the dry signal; L / C / R pick left, mono centre, right
mrCHN = 16384; mrDLN = floor(srate*2.2) + 8;
mrChA = MR; mrChB = MR + mrCHN; mrChC = MR + 2*mrCHN;
mrDlA = MR + 3*mrCHN; mrDlB = mrDlA + mrDLN; mrDlC = mrDlB + mrDLN;
mrVsC = mrDlC + mrDLN; mrVsT = mrVsC + 48; mrVsV = mrVsT + 48; mrPre = mrVsV + 48; mrDls = mrPre + 4; mrRg = mrDls + 8; mrVbF = mrRg + 24;
memset(MR, 0, mrVbF + 4 - MR);
mrVsT[0] = mrVsT[16] = mrVsT[32] = 1;
mrVbF[0] = 60; mrVbF[1] = 180; mrVbF[2] = 480; mrVbF[3] = 1300;
mrCw = 1 - exp(-1/(0.15*srate)); mrCs = 1 - exp(-1/(3*srate)); mrCd = 1 - exp(-1/(0.8*srate)); mrCdr = 1 - exp(-1/(3*srate));
function mr_opc(fc) ( 1 - exp(-2*$pi*min(fc, srate*0.45)/srate); );
function mr_tanh(v) ( v = max(-20, min(20, v)); 1 - 2/(exp(2*v) + 1); );
mrVbLp = mr_opc(160); mrVbAt = 1 - exp(-1/(0.008*srate));
mrDlLc = mr_opc(3500); mrDlHc = mr_opc(70); mrDlTs = 1 - exp(-1/(0.25*srate)); mrDlT = 350;
function mr_div(i, md) (
  (i == 0 ? 4*mrBar : i == 1 ? 2*mrBar : i == 2 ? mrBar : i == 3 ? 2 : i == 4 ? 1 : i == 5 ? 0.5 : i == 6 ? 0.25 : 0.125)*(md == 2 ? 1.5 : md == 3 ? 2/3 : 1);
);
function mr_hread(buf, n, pos) local(i, f, xm1, x0, x1, x2, c1, c2, c3) (
  pos < 0 ? pos += n; pos >= n ? pos -= n;
  i = floor(pos); f = pos - i;
  xm1 = buf[(i - 1 + n) % n]; x0 = buf[i]; x1 = buf[(i + 1) % n]; x2 = buf[(i + 2) % n];
  c1 = 0.5*(x1 - xm1); c2 = xm1 - 2.5*x0 + 2*x1 - 0.5*x2; c3 = 0.5*(x2 - xm1) + 1.5*(x0 - x1);
  ((c3*f + c2)*f + c1)*f + x0;
);
function mr_rgen(q, period, coef) ( q[0] -= 1; q[0] <= 0 ? ( q[0] = period*srate; q[1] = rand(2) - 1; ); q[2] += coef*(q[1] - q[2]); q[2]; );
function mr_ch(buf, phoff, vs) local(lf, dms, y) (
  lf = sin(2*$pi*(mrChPh + phoff));
  dms = mrChBase + mrChDep*lf + mrWarb;
  y = mr_hread(buf, mrCHN, mrChW - max(1, dms)*srate*0.001);
  mrClkOn ? ( vs[0] += mrClkInc; vs[0] >= 1 ? ( vs[0] -= 1; vs[1] = y; ); y = vs[1]; );
  vs[2] += mrChPc*(y - vs[2]); vs[3] += mrChPc*(vs[2] - vs[3]);
  vs[3];
);
function mr_tr(phoff, vs) local(sv, sh, g) (
  sv = sin(2*$pi*(mrTrPh + phoff));
  sh = mrTrK > 1.01 ? mr_tanh(mrTrK*sv)/mrTrTk : sv;
  g = 1 - mrTrDep*(0.5 - 0.5*sh);
  vs[0] += mrTrLag*(g - vs[0]); vs[0];
);
function mr_vb(x, phoff, vs) local(q, pw, lf, c, rr, oc, k, y, f, t, a1, xi) (
  q = mrVbPh + phoff; q -= floor(q);
  pw = q < mrVbSk ? 0.5*q/mrVbSk : 0.5 + 0.5*(q - mrVbSk)/(1 - mrVbSk);
  lf = 0.5 - 0.5*cos(2*$pi*pw);
  c = lf > vs[8] ? mrVbAt : mrVbRl; vs[8] += c*(lf - vs[8]); rr = vs[8];
  oc = mrVbOct*rr; y = x; k = 0;
  loop(4, f = min(srate*0.45, mrVbF[k]*2^oc); t = tan($pi*f/srate); a1 = (t - 1)/(t + 1);
    xi = y; y = a1*xi + vs[k*2] - a1*vs[k*2 + 1]; vs[k*2] = xi; vs[k*2 + 1] = y; k += 1; );
  vs[9] += mrVbLp*(x - vs[9]);
  mrVbWet*(0.5*(y - x) + mrVbTh*(2*rr - 1)*vs[9]);
);
function mr_loop(y, q) local(v) ( q[0] += mrDlLc*(y - q[0]); q[1] += mrDlHc*(q[0] - q[1]); v = q[0] - q[1]; mr_tanh(v*mrFbE*1.15)/1.15; );
// the controls (each block)
function mr_update() local(fclk) (
  mrChLo = slider23 > 0.5; mrChCo = slider24 > 0.5; mrChRo = slider25 > 0.5;
  mrTrLo = slider31 > 0.5; mrTrCo = slider32 > 0.5; mrTrRo = slider33 > 0.5;
  mrVbLo = slider39 > 0.5; mrVbCo = slider40 > 0.5; mrVbRo = slider41 > 0.5;
  mrDlLo = slider48 > 0.5; mrDlCo = slider49 > 0.5; mrDlRo = slider50 > 0.5;
  mrChBase = 7; mrChDep = slider20/100*3;
  fclk = 40000; mrClkOn = fclk < srate*0.98; mrClkInc = fclk/srate;
  mrChPc = mr_opc(min(14000, fclk*0.42)); mrChMix = slider21/100;
  mrTrK = 1; mrTrTk = mr_tanh(mrTrK); mrTrDep = slider29/100;
  mrTrLag = 1 - exp(-1/(6*0.001*srate));
  mrVbSk = 0.5; mrVbRl = 1 - exp(-1/(0.04*srate));
  mrVbTh = 0; mrVbOct = 3*slider37/100; mrVbWet = min(1, 2*slider37/100);
  mrFbE = 0.95*slider45/95; mrDlMix = slider46/100;
);
// tempo (each block)
function mr_block() (
  mrBar = ts_denom > 0 ? ts_num*4/ts_denom : 4;
  mrPlay = play_state & 1; mrBpos = beat_position; mrBpInc = tempo/(60*srate);
  mrChSy = slider26 > 0.5; mrChQn = mr_div(slider27, slider26);
  mrTrSy = slider34 > 0.5; mrTrQn = mr_div(slider35, slider34);
  mrVbSy = slider42 > 0.5; mrVbQn = mr_div(slider43, slider42);
  mrDlTgt = slider51 > 0.5 && tempo > 0 ? min(1500, mr_div(slider52, slider51)*60000/tempo) : slider44;
  mrOn = mrChMix > 0 || mrTrDep > 0 || mrVbWet > 0 || mrDlMix > 0;
);
// one sample: in mrL / mrR, out mrL / mrR
function mr_run() local(xl, xr, m, dl, dr, y, sp, kc, ws, wc, dsm, ya, yb, yc) (
  xl = mrL; xr = mrR; m = 0.5*(xl + xr); dl = dr = 0;
  mrBpos += mrBpInc;
  mrChSy ? mrChPh = (mrPlay ? mrBpos/mrChQn : mrChPh + mrBpInc/mrChQn) : mrChPh += slider19*(1 + 0.2*drift*mr_rgen(mrRg, 2.5, mrCdr))/srate;
  mrTrSy ? mrTrPh = (mrPlay ? mrBpos/mrTrQn : mrTrPh + mrBpInc/mrTrQn) : mrTrPh += slider28*(1 + 0.2*drift*mr_rgen(mrRg + 3, 2.5, mrCdr))/srate;
  mrVbSy ? mrVbPh = (mrPlay ? mrBpos/mrVbQn : mrVbPh + mrBpInc/mrVbQn) : mrVbPh += slider36*(1 + 0.2*drift*mr_rgen(mrRg + 6, 2.5, mrCdr))/srate;
  mrChPh -= floor(mrChPh); mrTrPh -= floor(mrTrPh); mrVbPh -= floor(mrVbPh);
  // chorus
  mrPre[0] += mrChPc*(xl - mrPre[0]); mrPre[1] += mrChPc*(xr - mrPre[1]); mrPre[2] += mrChPc*(m - mrPre[2]);
  mrChA[mrChW] = mrPre[0]; mrChB[mrChW] = mrPre[1]; mrChC[mrChW] = mrPre[2];
  mrChMix > 0 ? (
    sp = mrChCo && (mrChLo || mrChRo); kc = (mrChLo || mrChRo) ? 0.707 : 1;
    mrChLo ? dl += mrChMix*mr_ch(mrChA, 0, mrVsC);
    mrChRo ? dr += mrChMix*mr_ch(mrChB, sp ? 2/3 : 0.25, mrVsC + 16);
    mrChCo ? ( y = mrChMix*kc*mr_ch(mrChC, sp ? 1/3 : 0, mrVsC + 32); dl += y; dr += y; );
  );
  // tremolo
  mrTrDep > 0 ? (
    sp = mrTrCo && (mrTrLo || mrTrRo); ws = mrTrCo ? 0.5 : 1; wc = (mrTrLo || mrTrRo) ? 0.5 : 1;
    mrTrLo ? dl += ws*xl*(mr_tr(0, mrVsT) - 1);
    mrTrRo ? dr += ws*xr*(mr_tr(sp ? 2/3 : 0, mrVsT + 16) - 1);
    mrTrCo ? ( y = wc*m*(mr_tr(sp ? 1/3 : 0, mrVsT + 32) - 1); dl += y; dr += y; );
  );
  // vibe
  mrVbWet > 0 ? (
    sp = mrVbCo && (mrVbLo || mrVbRo); kc = (mrVbLo || mrVbRo) ? 0.707 : 1;
    mrVbLo ? dl += mr_vb(xl, 0, mrVsV);
    mrVbRo ? dr += mr_vb(xr, sp ? 2/3 : 0, mrVsV + 16);
    mrVbCo ? ( y = kc*mr_vb(m, sp ? 1/3 : 0, mrVsV + 32); dl += y; dr += y; );
  );
  // delay
  mrDlT += mrDlTs*(mrDlTgt - mrDlT);
  dsm = max(2, min(mrDLN*0.55, mrDlT*srate*0.001));
  sp = mrDlCo && (mrDlLo || mrDlRo); kc = (mrDlLo || mrDlRo) ? 0.707 : 1;
  mrDlLo && mrDlMix > 0 ? ( ya = mr_hread(mrDlA, mrDLN, mrDlW - dsm*(sp ? 0.75 : 1)); mrDlA[mrDlW] = xl + mr_loop(ya, mrDls); dl += mrDlMix*ya; ) : mrDlA[mrDlW] = 0;
  mrDlRo && mrDlMix > 0 ? ( yb = mr_hread(mrDlB, mrDLN, mrDlW - dsm*(sp ? 1.25 : 1)); mrDlB[mrDlW] = xr + mr_loop(yb, mrDls + 2); dr += mrDlMix*yb; ) : mrDlB[mrDlW] = 0;
  mrDlCo && mrDlMix > 0 ? ( yc = mr_hread(mrDlC, mrDLN, mrDlW - dsm); mrDlC[mrDlW] = m + mr_loop(yc, mrDls + 4); y = mrDlMix*kc*yc; dl += y; dr += y; ) : mrDlC[mrDlW] = 0;
  mrChW += 1; mrChW >= mrCHN ? mrChW = 0;
  mrDlW += 1; mrDlW >= mrDLN ? mrDlW = 0;
  mrL = xl + dl; mrR = xr + dr;
);

