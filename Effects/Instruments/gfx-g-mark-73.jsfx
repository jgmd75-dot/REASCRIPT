  wl_scale_col = 0xC9B98A;  wl_label_col = 0xC9B98A;
  wl_dial_out(0x14130E, 0xD6C79C);
  wl_knob(wl_cx, 378, 24, 71, -12, 12, 0.5, 0, 0x3E3A2E, "OUTPUT", 0, -1, 3);
  wl_knob(wl_cx - 32, 456, 14, 19, 0, 100, 1, 0, 0x8A4A2A, "SAT", 1, -1, 0);
  wl_knob(wl_cx + 32, 456, 14, 72, 0, 100, 1, 0, 0x3E3A2E, "DRIFT", 1, -1, 0);
  wl_ckey(wl_cx - 38, 502, 76, 22, wl_order, 0xB4C460, "ORDER") ? ( slider(41) = wl_order ? 0 : 1;  wl_param_touched(41); );
  gfx_setfont(14);  wl_col(0xC9B98A, 1);  wl_text_c(wl_px(wl_cx), wl_py(534), wl_order ? "COMP > EQ" : "EQ > COMP");
  // FX PRE / POST: the strip sits before the instrument's FX (PRE) or after them (POST)
  wl_ckey(wl_cx - 38, 546, 76, 22, 1, 0xD8A84A, wl_fxpost ? "FX POST" : "FX PRE") ? ( slider(89) = wl_fxpost ? 0 : 1;  wl_param_touched(89); );
  wl_screw(wl_cx, 586);
);
function wl_font_ok(wl_name, wl_flags) local(wl_w0, wl_h0, wl_w1, wl_h1) (
  gfx_setfont(15, "GFX-no-such-font", 20, wl_flags);  gfx_measurestr("WIDELOAD 0123", wl_w0, wl_h0);
  gfx_setfont(15, wl_name, 20, wl_flags);                gfx_measurestr("WIDELOAD 0123", wl_w1, wl_h1);
  abs(wl_w1 - wl_w0) > 0.5;
);
function wl_pick_fonts() (
  wl_font_ok("Cooper Black", 0)     ? ( strcpy(#wl_fc, "Cooper Black");     wl_fc_fl = 0; ) :
  wl_font_ok("Cooper Std Black", 0) ? ( strcpy(#wl_fc, "Cooper Std Black"); wl_fc_fl = 0; ) :
  wl_font_ok("Arial Black", 0)      ? ( strcpy(#wl_fc, "Arial Black");      wl_fc_fl = 0; ) :
                                   ( strcpy(#wl_fc, "Verdana");          wl_fc_fl = 'b'; );
  wl_fonts_picked = 1;
);

ui_thm = 5; ui_hw = 0;
ui_begin(1100, 690);

// ---------- the faceplate: a Wideload rack - dark rails, each section its own unit plate ----------
// finishes (from Wideload): 1 olive, 2 brown ink, 3 yellowed paper, 4 slate, 5 charcoal, 6 gunmetal
mg_rack = 0x1C1916; mg_ink = 0xD9CBA3; mg_dim = 0xC9B98A; mg_acc = 0xD8A84A; mg_cream = 0xE6D9B2; mg_grey = 0x9A968A;
mg_red = 0x3B3A2C;                                          // the plate under the current section (greying, key ink)
dy_ink = mg_ink; dy_nov = 1; rd_sqbg = 0x14130E; dy_kst = 7;

// fonts: Wideload's Cooper Black lettering (with its fallbacks); values in Verdana
!mg_fonts ? (
  mg_fontok("Cooper Black") ? ( strcpy(#mgf, "Cooper Black"); mg_ff = 0; ) :
  mg_fontok("Cooper Std Black") ? ( strcpy(#mgf, "Cooper Std Black"); mg_ff = 0; ) :
  mg_fontok("Arial Black") ? ( strcpy(#mgf, "Arial Black"); mg_ff = 0; ) : ( strcpy(#mgf, "Verdana"); mg_ff = 'b'; );
  mg_fonts = 1;
);
gfx_setfont(10, #mgf, 16 * sc, mg_ff);                  // unit names
