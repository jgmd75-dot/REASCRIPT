// ---------- header ----------
ui_col(0x000000); mg_r(0, 62, 1100, 3);
ui_col(mg_acc); mg_r(0, 61, 1100, 1);
rd_badge(32, 30, 17, 0xD9CBA3, mg_rack);
gfx_setfont(16); ui_col(0xD9CBA3); mg_t(60, 13, "MARK 73");
gfx_setfont(14); ui_col(0xC9B98A); mg_t(228, 13, "TINE ELECTRIC PIANO"); mg_t(228, 32, "STAGE  •  SUITCASE");
ui_hw = 1;                                                  // the preset bar's keys are 80s micro keys
mg_k = pk_preset(402 * sc, 13 * sc, 384 * sc, 34 * sc, pr_cur, #mk_pm);
ui_hw = 0;
mg_k > 0 ? prs_dirty = mg_k;
// MIDI lamp on a light inset, so it can be seen on the dark header
ui_col(0x4A4936); mg_r(800, 12, 24, 20); ui_cola(0x000000, 0.4); mg_r(800, 12, 24, 2);
rd_led(812, 22, 4.5, ins_midi_lit(), 0x3ADF6A);
gfx_setfont(11); ui_col(0xC9B98A); mg_ct(812, 46, "MIDI");
// MIDI channel: an LED push-button (LED lit = OMNI), the channel printed under it; click for the list
mg_mo = slider25 < 0.5;
pk_ledbtn(852 * sc, 8 * sc, 44 * sc, 28 * sc, mg_mo, 0xFFB030) ? (
  strcpy(#mgm, ""); mg_n = 0;
  loop(17, mg_n == floor(slider25 + 0.5) ? strcat(#mgm, "!"); mg_n == 0 ? strcat(#mgm, "Omni") : ( sprintf(#mgk, "Channel %d", mg_n); strcat(#mgm, #mgk); ); mg_n < 16 ? strcat(#mgm, "|"); mg_n += 1; );
  gfx_x = 852 * sc; gfx_y = 50 * sc; mg_n = gfx_showmenu(#mgm); mg_n > 0 ? mg_set(25, mg_n - 1);
);
sprintf(#mgl, mg_mo ? "OMNI" : "CH %.0f", slider25);
gfx_setfont(11); ui_col(0xC9B98A); mg_ct(874, 46, #mgl);
ui_hw = 1; ui_size_picker(1030 * sc, 21 * sc); ui_hw = 0;
// EDIT: opens the Wideload page (and closes it again); its LED is lit while the page is open
ui_hw = 1; ui_button(918 * sc, 12 * sc, 76 * sc, 30 * sc, "EDIT", mk_edit, 1) ? mk_edit = !mk_edit; ui_hw = 0;

!mk_edit ? (
// ---------- row 1: TINES, PICKUP, AMP ----------
// - and + printed at the lower left and lower right of a dial
// a vertical fader: slot with a printed scale, a dark cap with a white line; drag, Shift = fine, wheel,
// double-click resets; the value replaces the label while touched

mg_tyo = 32;
mg_y = 82; mg_h = 190; mg_ky = mg_y + 100;
mg_unit(14, mg_y, 1072, mg_h, 1);
mg_sect(14, mg_y, 330, mg_h, 1, "HAMMER & TINES");
mg_kn(56,  mg_ky, 21, 3, 0, 100, 50, 0, mg_cream, "EDGE", "%.0f%%");
mg_kn(135, mg_ky, 21, 26, 0, 50, 36, 0, mg_acc, "BELL", "%.0f%%");
mg_kn(214, mg_ky, 21, 1, 0, 100, 50, 0, mg_cream, "DECAY", "%.0f%%");
mg_kn(293, mg_ky, 21, 2, 0, 100, 40, 0, mg_cream, "RELEASE", "%.0f%%");

mg_sect(358, mg_y, 420, mg_h, 1, "PICKUP");
mg_ring(414, mg_ky, 38); mg_kn(414, mg_ky, 24, 4, 0, 100, 50, 0, mg_acc, "VOICING", "%.0f%%");
mg_ring(504, mg_ky, 38); mg_kn(504, mg_ky, 24, 5, 0, 100, 50, 0, mg_cream, "GAP", "%.0f%%");
// the pickup window: flux across the pole, where the tine rests, how far the last note is swinging
mg_wx = 562; mg_wy = mg_y + 20; mg_ww = 200; mg_wh = 150;
ui_col(0x0A0A0B); mg_r(mg_wx - 2, mg_wy - 2, mg_ww + 4, mg_wh + 4);
ui_col(0x0E0D0A); mg_r(mg_wx, mg_wy, mg_ww, mg_wh);
mg_zs = mg_ww / 5.2;                                       // pixels per pole width
mg_cx = mg_wx + mg_ww * 0.5;
mg_base = mg_wy + mg_wh - 22;
ui_cola(mg_dim, 0.15); mg_r(mg_wx + 4, mg_base, mg_ww - 8, 1);
mg_i = 1; loop(9, mg_r(mg_wx + mg_i * mg_ww / 10, mg_wy + 4, 1, mg_wh - 26); mg_i += 1; );
// the pole piece
ui_col(0x6F747A); mg_r(mg_cx - 9, mg_base + 4, 18, 14);
ui_col(0xA9AEB4); mg_r(mg_cx - 9, mg_base + 4, 18, 3);
// swing band of the last note (live), the rest position
mg_off = mg_goff = (mk_goff > 0 ? mk_goff : mk_off0);
mg_sw = min(mk_ga, 2.5);
mg_x0 = mg_cx + (mg_off - mg_sw) * mg_zs; mg_x1 = mg_cx + (mg_off + mg_sw) * mg_zs;
mg_sw > 0.002 ? ( ui_cola(mg_acc, 0.18); mg_r(max(mg_x0, mg_wx), mg_wy + 4, min(mg_x1, mg_wx + mg_ww) - max(mg_x0, mg_wx), mg_wh - 26); );
// the flux curve
ui_col(mg_cream); mg_lx = 0; mg_ly = 0; mg_i = 0;
loop(97,
  mg_z = (mg_i / 96 - 0.5) * 5.2;
  mg_px = mg_cx + mg_z * mg_zs; mg_py = mg_base - (1 / (1 + mg_z * mg_z)) * (mg_wh - 36);
  mg_i > 0 ? ( gfx_line(mg_lx * sc, mg_ly * sc, mg_px * sc, mg_py * sc, 1); gfx_line(mg_lx * sc, (mg_ly + 0.7) * sc, mg_px * sc, (mg_py + 0.7) * sc, 1); );
  mg_lx = mg_px; mg_ly = mg_py; mg_i += 1;
);
mg_px = mg_cx + mg_off * mg_zs; mg_py = mg_base - (1 / (1 + mg_off * mg_off)) * (mg_wh - 36);
ui_col(mg_acc); mg_r(mg_px - 0.75, mg_wy + 4, 1.5, mg_wh - 26);
gfx_circle(mg_px * sc, mg_py * sc, 4 * sc, 1, 1);
gfx_setfont(5); ui_cola(mg_dim, 0.9); mg_t(mg_wx + 6, mg_wy + 5, "FLUX");
sprintf(#mgs, mg_sw > 0.002 ? "SWING %.2f" : "AT REST", mg_sw); mg_rt(mg_wx + mg_ww - 6, mg_wy + 11, #mgs);
mg_t(mg_cx + 14, mg_base + 5, "POLE");

mg_sect(792, mg_y, 294, mg_h, 1, "");
gfx_setfont(17, #mgf, 14 * sc, mg_ff); cs_font = 17;
cs_key(812, mg_y + 22, 118, 30, slider15 < 0.5, 0xF08A24, "STAGE", 0) ? mg_set(15, 0);
cs_key(946, mg_y + 22, 118, 30, slider15 >= 0.5, 0x52C873, "SUITCASE", 0) ? mg_set(15, 1);
mg_kn(871,  mg_y + 100, 22, 6, -12, 12, 0, 0, mg_cream, "TREBLE", "%+.1f dB");
mg_kn(1005, mg_y + 100, 22, 14, 0, 100, 0, 0, mg_acc, "OVERDRIVE", "%.0f%%");

// ---------- row 2: MODULATION, PLAYING, TUNING, MASTER ----------
mg_y = 288; mg_h = 194; mg_ky = mg_y + 102;
mg_unit(14, mg_y, 1072, mg_h, 4);
mg_sect(14, mg_y, 280, mg_h, 4, "MODULATION");
mg_lv = mk_mod != 0 ? mk_pc1 : 0;
slider7 < -0.5 ? sprintf(#mgv, "PAN %.0f%%", -slider7) : slider7 > 0.5 ? sprintf(#mgv, "TREM %.0f%%", slider7) : strcpy(#mgv, "OFF");
dy_knob(84, mg_ky, 27, 7, -100, 100, 0, 0, mg_acc, "MODULATION", #mgv);
gfx_setfont(5); ui_cola(mg_dim, 0.95); mg_ct(44, mg_ky + 28, "PAN"); mg_ct(126, mg_ky + 28, "TREM");
// the halfway mark: a clear tick at 12 o'clock (left = more pan, right = more tremolo)
ui_col(mg_ink); mg_r(84 - 2, mg_ky - 27 - 15, 4, 12);
mg_kn(222, mg_ky, 21, 8, 0.1, 12, 4.5, 1, mg_cream, "RATE", "%.2f Hz");
rd_led(246, mg_y + 32, 5, 0, 0xFF5A3A);
mk_mod != 0 ? ( ui_cola(0xFF5A3A, 0.25 + 0.6 * mg_lv); gfx_circle(246 * sc, (mg_y + 32) * sc, 9 * sc, 1, 1); ui_cola(0xFF5A3A, 0.4 + 0.6 * mg_lv); gfx_circle(246 * sc, (mg_y + 32) * sc, 5 * sc, 1, 1); );

mg_sect(308, mg_y, 270, mg_h, 4, "PERFORMANCE");
mg_kn(353, mg_ky, 22, 9, 0, 100, 70, 0, mg_cream, "VELOCITY", "%.0f%%");
mg_kn(443, mg_ky, 22, 10, 0, 100, 30, 0, mg_cream, "WIDTH", "%.0f%%");
dy_kst = 7; sprintf(#mgv, "%.0f", floor(slider11 + 0.5)); dy_knob(533, mg_ky, 22, 11, 4, 32, 16, 0, mg_grey, "POLYPHONY", #mgv);
slider11 != floor(slider11 + 0.5) ? slider11 = floor(slider11 + 0.5);

// small trim knobs (the console cap knob: silver skirt, coloured cap, a ring of dots)
mg_sect(592, mg_y, 150, mg_h, 4, "TUNING");
mg_trim(628, mg_ky, 12, -50, 50, 0, "FINE", "%+.1f ct");
mg_trim(704, mg_ky, 13, 0, 10, 0, "RANDOM", "%.1f ct");

mg_nright = 1046; mg_sect(756, mg_y, 330, mg_h, 4, "MASTER");
mg_small(852, mg_y + 60, 15, 19, 0, 100, 0, 0xD8B040, "SAT", "%.0f%%");
mg_small(806, mg_y + 124, 15, 17, 0, 100, 15, mg_grey, "DRIFT", "%.0f%%");
mg_small(898, mg_y + 124, 15, 16, 0, 100, 30, mg_grey, "MECH", "%.0f%%");
mg_fader(982, mg_y + 62, 98, 18, -24, 6, 0, "", "%+.1f dB");
mgL.ui_ledm(1018 * sc, (mg_y + 60) * sc, 10 * sc, 102 * sc, mk_pk_disp); mgR.ui_ledm(1032 * sc, (mg_y + 60) * sc, 10 * sc, 102 * sc, mk_pk_disp);
mk_pk_disp *= 0.85;

// ---------- row 3: FX (CHORUS, VIBE, DELAY, SPACE) ----------
// band-colour knobs, one colour per job: RATE / TIME blue, DEPTH green, FEEDBACK red, MIX / AMOUNT brown;
// each unit's ON is a lamp key in its own colour, and a rate LED in the same colour shows the speed
mg_cb = 0x3E6E9E; mg_cg = 0x3F8A5A; mg_cr = 0xB5443A; mg_cn = 0x8A5A3A;
// the rate LED: a 5 px LED in a black ring, brightness b (0..1)
lk_font = 17; lk_font2 = 17; gfx_setfont(17, #mgf, 14 * sc, mg_ff);
ck_font = 12;
mg_y = 498; mg_h = 170; mg_ky = mg_y + 104; mg_tyo = 32;
mg_unit(14, mg_y, 1072, mg_h, 3);
mg_sect(14, mg_y, 250, mg_h, 3, "CHORUS");
lk_key(202, mg_y + 19, 58, 26, slider27 >= 0.5, LK_YEL, "ON") ? mg_set(27, slider27 >= 0.5 ? 0 : 1);
mg_fxkn(80,  mg_ky, 28, 0.05, 8, 0.6, 1, mg_cb, "RATE", "%.2f Hz");
mg_fxkn(190, mg_ky, 29, 0, 100, 50, 0, mg_cg, "DEPTH", "%.0f%%");
mg_rled(116, mg_ky - 24, slider27 >= 0.5 ? 0.5 - 0.5 * cos(2 * $pi * mf_cph) : 0, 0xF2C230);
mg_sect(278, mg_y, 250, mg_h, 3, "VIBE");
lk_key(466, mg_y + 19, 58, 26, slider30 >= 0.5, LK_BLU, "ON") ? mg_set(30, slider30 >= 0.5 ? 0 : 1);
mg_fxkn(344, mg_ky, 31, 0.1, 10, 1.2, 1, mg_cb, "RATE", "%.2f Hz");
mg_fxkn(454, mg_ky, 32, 0, 100, 50, 0, mg_cg, "DEPTH", "%.0f%%");
mg_rled(380, mg_ky - 24, slider30 >= 0.5 ? 0.5 - 0.5 * cos(2 * $pi * mf_vph) : 0, 0x5C9AEC);
mg_sect(542, mg_y, 310, mg_h, 3, "DELAY");
lk_key(790, mg_y + 19, 58, 26, slider33 >= 0.5, LK_GRN, "ON") ? mg_set(33, slider33 >= 0.5 ? 0 : 1);
// SYNC: lit while the time follows the tempo; a click opens the list of divisions
mg_ds = floor(slider37 + 0.5);
lk_key(706, mg_y + 19, 72, 26, mg_ds > 0, LK_ORA, "SYNC") ? (
  sprintf(#mgm, "%sFree (ms)|%s1/4|%s1/8 dotted|%s1/8|%s1/4 triplet", mg_ds == 0 ? "!" : "", mg_ds == 1 ? "!" : "", mg_ds == 2 ? "!" : "", mg_ds == 3 ? "!" : "", mg_ds == 4 ? "!" : "");
  gfx_x = 706 * sc; gfx_y = (mg_y + 49) * sc; mg_n = gfx_showmenu(#mgm); mg_n > 0 ? mg_set(37, mg_n - 1);
);
mg_dq = mg_ds == 1 ? 1 : mg_ds == 2 ? 0.75 : mg_ds == 3 ? 0.5 : 2 / 3;
mg_dms = mg_ds > 0 && tempo > 0 ? min(1500, mg_dq * 60000 / tempo) : slider34;
mg_ds > 0 ? ( sprintf(#mgv, "%.0f ms", mg_dms); dy_kst = 36; dy_knob(604, mg_ky, 20, 34, 20, 1500, 375, 1, mg_cb,
                mg_ds == 1 ? "1/4" : mg_ds == 2 ? "1/8 DOT" : mg_ds == 3 ? "1/8" : "1/4 TRIP", #mgv); dy_kst = 7; ) :
  mg_fxkn(604, mg_ky, 34, 20, 1500, 375, 1, mg_cb, "TIME", "%.0f ms");
mg_fxkn(698, mg_ky, 35, 0, 95, 35, 0, mg_cr, "FEEDBACK", "%.0f%%");
mg_fxkn(792, mg_ky, 36, 0, 100, 25, 0, mg_cn, "MIX", "%.0f%%");
// the time LED flashes once per repeat
mg_dph = time_precise() * 1000 / max(mg_dms, 20); mg_dph -= floor(mg_dph);
mg_rled(640, mg_ky - 24, slider33 >= 0.5 ? max(0, 1 - mg_dph * 4) : 0, 0x52C873);
mg_sect(866, mg_y, 220, mg_h, 3, "SPACE");
lk_key(990, mg_y + 19, 58, 26, slider38 >= 0.5, LK_RED, "ON") ? mg_set(38, slider38 >= 0.5 ? 0 : 1);
mg_st = floor(slider39 + 0.5);
ck_key(882, mg_y + 64, 82, 26, mg_st == 0, "ROOM") ? mg_set(39, 0);
ck_key(882, mg_y + 96, 82, 26, mg_st == 1, "PLATE") ? mg_set(39, 1);
ck_key(882, mg_y + 128, 82, 26, mg_st == 2, "GATED") ? mg_set(39, 2);
mg_fxkn(1016, mg_ky, 40, 0, 100, 25, 0, mg_cn, "AMOUNT", "%.0f%%");
);

// ---------- the EDIT page: the Wideload rack ----------
mk_edit ? (
// =====================================================================
// GUI — grimy underground-comix rack (inked outlines, hatching, newsprint and head-shop colours), 150 px slots. Double-wide modules
// take two slots; a single-wide model in a double slot leaves a blank plate.
// House style skew: satin knob caps in the house colour code, 34-series lamp
// keys, rivets; each module borrows its reference's character.
// =====================================================================

// cross-head screw

// knob pointer: one filled bar, constant width at any angle

// ---------- house lamp keys (34-series), ported from gfx-ui lk_key / lk_fit ----------
wl_lk_well = 0x141518;
wl_LK_AMB = 0xF2A41E;  wl_LK_YEL = 0xF2C230;  wl_LK_BLU_LT = 0x5C9AEC;  wl_LK_WHT = 0xE9E2CC;  wl_LK_RED = 0xD8332E;  wl_LK_VIO = 0xA47BE0;

// ---------- comix drawing helpers (Wideload look: grimy underground-comix ink) ----------
// Inked outline: a rounded rectangle th px thick (pixel coordinates)
// 45-degree hatching in a vertical strip and a horizontal strip (pixel coordinates)
// hatching across a disc

// Comix dial: soft shadow below-right, flat cap, inked outline, pointer bar.
// Style from globals set by each module: k_ink (outline), k_ptr (pointer),
// k_hatch / k_shine (1 = hatched cap with a faint shine, as on the main D dials),
// scale_col / label_col. Set klog = 1 before a call for a log-taper knob.
// fmt: 0 dB, 1 %, 3 Hz, 4 Q, >=1000 enum (hover strings at fmt-1000).
// sb >= 0: printed labels from string slots; sb < 0: numeric; nl = label count.

// Comix key: greyed out when off; lit in its colour with a soft glow when on. Returns 1 on click.

// Name plate set into the panel: a recess with its shadow on the top / left inside
// edge and the panel's light catching the bottom / right lip; engraved lettering.

// Module panel: flat colour, hatched right + bottom edges, wobbly inked outline

// A / B rocker (illuminated, as a mains rocker): click a half to pick that unit.
// The chosen half is pressed in with the lamp glowing behind its legend; the other
// half stands proud. Model names either side, the chosen one bright.

// small paper tag (band names on the EQ)
// band tags take the house band colour: LF brown, LMF blue, HMF green, HF red
wl_B_LF = 0x8A5A3A;  wl_B_LMF = 0x3E6E9E;  wl_B_HMF = 0x3F8A5A;  wl_B_HF = 0xB5443A;

// a lamp with a glow when lit

// blank filler plate (a single-wide model in a double slot)

// LED meter column, -48..+3 dB (olive / mustard / rust)

// the two dial styles shared across modules

// ---------- AR-70 (single-wide, PRE A) — D: grubby olive, rust, stained cream ----------

// ---------- SX-6 (single-wide, PRE B) — smoky charcoal, oxblood gain, mustard VHD ----------

// Slot widths: the EQs get the extra room (four bands of controls), the compressors less.
wl_EQ_W = 350;  wl_CMP_W = 262;

// ---------- VX-4 (double-wide, EQ A) — B: head-shop ink, cream linework, mustard ----------

// ---------- MT-7 (double-wide, EQ B) — dusty slate, cream ink; boost left, CPS / KCS centre, atten right ----------

// gain-reduction needle meter, 0..20 dB (shared by both compressors), centred on cx

// ---------- GB-2 (double-wide, COMP A) — A colours: yellowed paper, oxblood, brown-black ink ----------

// ---------- VM-67 (double-wide, COMP B) — stained gunmetal, cream-faced meter, rust input ----------

// ---------- OUTPUT (single-wide) — D; house output stage SAT + CLIP lamp ----------

// ---------- fonts: Cooper Black (70s comix lettering) with fallbacks ----------

// ---------- frame setup ----------
wl_sc = sc;
wl_ox = 50 * wl_sc;
wl_oy = 50 * wl_sc;                              // under the Mark 73 header
wl_lmb = mouse_cap & 1;
wl_click = wl_lmb && !wl_last_lmb;

!wl_fonts_picked ? wl_pick_fonts();
gfx_setfont(10, #wl_fc, wl_ps(18), wl_fc_fl);
gfx_setfont(11, #wl_fc, wl_ps(12), wl_fc_fl);
gfx_setfont(12, "Verdana", wl_ps(12), 'b');
gfx_setfont(13, #wl_fc, wl_ps(19), wl_fc_fl);
gfx_setfont(14, #wl_fc, wl_ps(11), wl_fc_fl);
gfx_setfont(6, #wl_fc, wl_ps(12), wl_fc_fl);
gfx_setfont(8, "Courier New", wl_ps(17), 'b');

wl_inL_m  = max(wl_inL_d,  wl_inL_m * 0.85);   wl_inL_d = 0;   wl_inR_m  = max(wl_inR_d,  wl_inR_m * 0.85);   wl_inR_d = 0;
wl_outL_m = max(wl_outL_d, wl_outL_m * 0.85);  wl_outL_d = 0;  wl_outR_m = max(wl_outR_d, wl_outR_m * 0.85);  wl_outR_d = 0;
wl_gr_m   = max(wl_gr_d, wl_gr_m * 0.8);       wl_gr_d = 0;
wl_arpk_m = max(wl_arpk_d, wl_arpk_m * 0.9);   wl_arpk_d = 0;
ost_clipped ? ( wl_clip_hold = 8;  ost_clipped = 0; ) : wl_clip_hold > 0 ? ( wl_clip_hold -= 1; );   // CLIP lamp hold

// ---------- rack ----------
wl_col(0x000000, 0.45);  gfx_rect(wl_px(22), wl_py(22), wl_ps(956), wl_ps(596), 1);
wl_col(0x100E0C, 1);     gfx_rect(wl_px(24), wl_py(24), wl_ps(952), wl_ps(592), 1);
wl_col(0x2E2B22, 1);  gfx_rect(wl_px(24), wl_py(30), wl_ps(952), wl_ps(4), 1);  gfx_rect(wl_px(24), wl_py(606), wl_ps(952), wl_ps(4), 1);   // rails

// slots: PRE 35 | EQ (350) and COMP (262) in either order, 191..809 | OUT 815
wl_pre_model >= 0.5 ? wl_draw_sx(35) : wl_draw_ar(35);
// EQ and COMP units are all double-wide, so ORDER swaps the two blocks.
wl_order ? ( wl_comp_model >= 0.5 ? wl_draw_vm(191) : wl_draw_gb(191);  wl_eq_model >= 0.5 ? wl_draw_mt(197 + wl_CMP_W) : wl_draw_vx(197 + wl_CMP_W); )
      : ( wl_eq_model >= 0.5 ? wl_draw_mt(191) : wl_draw_vx(191);  wl_comp_model >= 0.5 ? wl_draw_vm(197 + wl_EQ_W) : wl_draw_gb(197 + wl_EQ_W); );
wl_draw_out(815);

// ---------- end of frame ----------
!wl_lmb ? wl_drag_idx = 0;
wl_last_lmb = wl_lmb;
wl_gui_dirty ? ( wl_prm_dirty = 1;  wl_gui_dirty = 0; );   // rebuilt in @block, never on the GUI thread
);

mg_tyo = 20;
dy_kst = 7; dy_nov = 0;
pk_end();
ui_end();
