gfx_setfont(14, #mgf, 13 * sc, mg_ff);                  // header subtitle
gfx_setfont(16, #mgf, 30 * sc, mg_ff);                  // panel title
gfx_setfont(5, #mgf, 13.5 * sc, mg_ff);                 // knob names (dy_knob)
gfx_setfont(4, "Verdana", 12.5 * sc, 'b');              // knob values

// cross-head panel screw (Wideload's)
// a unit's finish: plate colour, outline ink, hatching colour / strength, print colour
// a unit plate (one per row): soft shadow down-right, flat finish, hatched right and bottom edges,
// inked outline, a screw in each corner
// a section inside the unit: an inked divider on its left (except the first) and its name engraved in a
// recessed plate
// a lit key (caption on the key)

// the rack: dark frame and rails behind the units
ui_col(0x0B0B0C); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(mg_rack); mg_r(0, 0, 1100, 690);
ui_col(0x100E0C); mg_r(6, 66, 1088, 618);
