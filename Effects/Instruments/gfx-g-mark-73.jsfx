function wl_gr_meter(wl_cx, wl_fr, wl_face, wl_ink, wl_ndl) local(wl_mx0, wl_mx, wl_my, wl_mr, wl_j, wl_b, wl_a) (
  wl_mx0 = wl_cx - 107;
  wl_col(0x000000, 0.35);  gfx_rect(wl_px(wl_mx0 + 3), wl_py(91), wl_ps(214), wl_ps(108), 1);
  wl_col(wl_fr, 1);    gfx_rect(wl_px(wl_mx0), wl_py(88), wl_ps(214), wl_ps(108), 1);
  wl_col(wl_face, 1);  gfx_rect(wl_px(wl_mx0 + 6), wl_py(94), wl_ps(202), wl_ps(96), 1);
  wl_mx = wl_px(wl_cx);  wl_my = wl_py(232);  wl_mr = wl_ps(118);
  gfx_setfont(14);  wl_j = 0;
  loop(6,
    wl_b = -0.62 + wl_j * 0.248;
    wl_col(wl_ink, 1);
    gfx_line(wl_mx + sin(wl_b) * (wl_mr - wl_ps(8)), wl_my - cos(wl_b) * (wl_mr - wl_ps(8)), wl_mx + sin(wl_b) * (wl_mr - wl_ps(2)), wl_my - cos(wl_b) * (wl_mr - wl_ps(2)), 1);
    sprintf(#wl_sl, "%d", wl_j * 4);  wl_text_c(wl_mx + sin(wl_b) * (wl_mr - wl_ps(18)), wl_my - cos(wl_b) * (wl_mr - wl_ps(18)), #wl_sl);
    wl_j += 1;
  );
  wl_text_c(wl_mx, wl_py(166), "dB  COMPRESSION");
  wl_a = -0.62 + 1.24 * min(1, wl_gr_m / 20);
  wl_col(wl_ndl, 1);
  wl_pointer(wl_mx, wl_my, sin(wl_a), cos(wl_a), wl_ps(64), wl_mr - wl_ps(2), wl_ps(0.8));
  wl_col(wl_fr, 1);  gfx_rect(wl_px(wl_mx0), wl_py(190), wl_ps(214), wl_ps(6), 1);
);
