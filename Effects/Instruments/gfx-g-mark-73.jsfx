mk_ga = mk_na; mk_goff = mk_noff;
mk_lpinc = mk_rate * (1 + 0.04 * ins_fx) / srate;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (mk_qi < mk_qc && (MKQO[mk_qi] <= mk_spos || mk_spos >= samplesblock - 1)) (
  mk_qt = MKQT[mk_qi];
  mk_qt == 1 ? ( mk_note_on(MKQN[mk_qi], MKQV[mk_qi]); mf_ghold = mf_ghl; ) :
  mk_qt == 0 ? mk_note_off(MKQN[mk_qi]) :
  mk_qt == 2 ? ( mk_pedal = MKQV[mk_qi] >= 64; !mk_pedal ? mk_pedal_up(); ) :
