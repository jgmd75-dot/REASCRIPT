slider89:wl_fxpost=1<0,1,1{FX PRE,FX POST}>-Wideload position
slider90:prs_sel=0<0,14,1{No preset,Init,Stage Mark,Bright Stage,Mellow Ballad,Suitcase Tremolo,Auto Pan Wide,Bark & Bite,Bell Tines,Soft Felt,Drive Amp,Gospel Bark,Lo-Fi Upright,Dyno Bright,Dark Ballad}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-mark-73";
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();   // 20000 - 24095
MKV = 30000; MKVS = 138; MKNV = 36;                         // 36 voice slots x 138 (32 playable + 4 for stolen fades)
MKHL = 35000; MKHR = 35100;                                 // half-band decimator rings (64 each)
MKDEF = 35200;                                              // the Init values of sliders 1-18
MKTMP = 35300;                                              // preset parser scratch (400)
MKQO = 36000; MKQT = 36300; MKQN = 36600; MKQV = 36900;     // MIDI event queue (256 each)
// FX: chorus lines, vibe states, space lines, ping-pong delay lines
MFCA = 40000; MFCB = 44100; MFCN = 4096;                    // chorus (4096 each)
MFVA = 48200; MFVB = 48240;                                 // vibe stage states (lamp, coefficients)
MFR = 50000; MFRN = 8192; MFRM = MFRN - 1;                  // space: 4 lines x 8192
MFDA = 90000; MFDB = 420000; MFDN = 330000;                 // delay: up to 1.6 s at 192 kHz
memset(MFCA, 0, 2 * 4100); memset(MFVA, 0, 80); memset(MFR, 0, 4 * MFRN);
memset(MKV, 0, MKVS * MKNV); memset(MKHL, 0, 64); memset(MKHR, 0, 64);

// voice slots (p = MKV + 137 * v):
//   0 on   1 note   2 age   3 key held   4 held by the pedal   5 dampers down   6 velocity 0..1   7 hammer samples left
//   8 hammer position   9 hammer velocity   10 T / hammer mass   11 felt K   12 felt exponent p   13 felt loss
//   14 gain L   15 gain R   16 cos(w) of the fundamental   17 pickup offset (rest position across the pole)   18 output norm
//   19 flux at the last 2x step   20 tine modes in use   21 / 22 tonebar y1 / y2   23 / 24 tonebar a1 / a2
//   25 coupling into the tonebar   26 coupling into the tine   27 tonebar angle   28 tonebar r   29 thump gain
//   30 tonebar r (sustain)   31 stolen (fast fade)   32 own pickup out (for the sympathetic rail)
//   33 sympathetic gain   34 strike displacement (last)   35 angle of the fundamental (now)   36 release T60 scale (register)
//   37 1 / sin(w) of the fundamental   38 offset (drift-free)   39 cos(w / 2) of the fundamental
//   40 + 10 k   tine mode k (0..4): y1, y2, a1, a2, force gain, tip weight, half-step h1, h2, angle, r
//   90 + k      mode shape at the strike point      95 + k   r while the dampers are up
//   100 clink: last high-mode tip position   101 clink gain
//   102 + 8 j   horizontal polarisation of mode j (0 = fundamental, 1 = bell): y1, y2, a1, a2, force gain, h1, h2, angle
//   118 horizontal pickup offset   119 circle term 1 / (2 x tine radius)
//   120 modes still computed (the clink and then the bell stop being computed once they have died away)
//   121 samples since the strike   122 when the bell has died (samples)   123 full-speed swing
//   124 the bell's linear path gain   125 cos(w) of the tonebar
//   126 bell pulse: samples done   127 its length   128 its height
//   129 output norm without the pickup slope   130 / 131 / 132 targets of 18 / 124 / 101 (GAP / VOICING moves)
//   133 the key's rest offset / the VOICING offset   134 rest flux (last)   135 bell path base   136 clink base
//   137 clink low-pass state (softens the hammer tick)

function mk_hash(n, k) local(v) ( v = sin(n * 12.9898 + k * 78.233 + 0.5) * 43758.5453; v - floor(v); );

// ---------- the flux curve of the pickup and its slope ----------
// a magnetic-monopole / cylindrical-magnet field: B = d / (rho^2 + d^2 + a^2)^1.5 for the tip at lateral offset rho
// and distance d (a = the pole's radius, which rounds the peak; the tails are heavier than a Gaussian's)
function mk_flux(x, y, d) local(s) ( s = 1 / (x * x + y * y + d * d + mk_a2); d * s * sqrt(s); );
function mk_slope(x) local(c) ( c = mk_d0 * mk_d0 + mk_a2; abs(3 * mk_d0 * x * (x * x + c) ^ -2.5); );               // |d flux / dx|
function mk_curv(x) local(c) ( c = mk_d0 * mk_d0 + mk_a2; 3 * mk_d0 * (x * x + c) ^ -3.5 * (4 * x * x - c); );       // d2 flux / dx2 (the octave)
// clamped-free beam mode shape k (0..4) at xi along the tine (0 = clamp)
function mk_phi(k, xi) local(b, sg, z, ch, sh) (
  b = k == 0 ? 1.8751 : k == 1 ? 4.6941 : k == 2 ? 7.8548 : k == 3 ? 10.9955 : 14.1372;
  ch = 0.5 * (exp(b) + exp(-b)); sh = 0.5 * (exp(b) - exp(-b));
  sg = (ch + cos(b)) / (sh + sin(b)); z = b * xi;
  ch = 0.5 * (exp(z) + exp(-z)); sh = 0.5 * (exp(z) - exp(-z));
  ch - cos(z) - sg * (sh - sin(z));
);
// measured fundamental decay (T60, s) against the key, from the Q of a 1974 stage piano (tau = Q / (pi f0))
function mk_t60(n) local(i, x0, x1) (
  n = min(max(n, 28), 108);
  i = n < 40 ? 0 : n < 52 ? 1 : n < 58 ? 2 : n < 64 ? 3 : n < 76 ? 4 : n < 88 ? 5 : n < 100 ? 6 : 7;
  x0 = i == 0 ? 28 : i == 1 ? 40 : i == 2 ? 52 : i == 3 ? 58 : i == 4 ? 64 : i == 5 ? 76 : i == 6 ? 88 : 100;
  x1 = i == 0 ? 40 : i == 1 ? 52 : i == 2 ? 58 : i == 3 ? 64 : i == 4 ? 76 : i == 5 ? 88 : i == 6 ? 100 : 108;
  exp(log(i == 0 ? 40 : i == 1 ? 27 : i == 2 ? 11 : i == 3 ? 9 : i == 4 ? 10.5 : i == 5 ? 7.6 : i == 6 ? 3.1 : 1.4) * (x1 - n) / (x1 - x0)
    + log(i == 0 ? 27 : i == 1 ? 11 : i == 2 ? 9 : i == 3 ? 10.5 : i == 4 ? 7.6 : i == 5 ? 3.1 : i == 6 ? 1.4 : 0.9) * (n - x0) / (x1 - x0));
);

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#mk_def = "50 40 50 50 50 0 0 4.5 70 30 16 0 0 0 0 30 15 0";
function mk_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
mk_nums(#mk_def, MKDEF);
#mk_fxd = "0 0.6 50 0 1.2 50 0 375 35 25 0 0 0 25";             // FX sliders 27-40 at Init (all off)
mk_nums(#mk_fxd, MKDEF + 20);

#mk_pm = "Init|Stage Mark|Bright Stage|Mellow Ballad|Suitcase Tremolo|Auto Pan Wide|Bark & Bite|Bell Tines|Soft Felt|Drive Amp|Gospel Bark|Lo-Fi Upright|Dyno Bright|Dark Ballad";
function mk_pstr(p) (
  p == 2  ? "1:60 3:40 4:42 5:55 9:72 10:25 26:36 38:1 39:0 40:18" :
  p == 3  ? "1:50 3:65 4:52 5:45 6:4 9:78 10:35 14:6 26:36 27:1 28:0.5 29:40" :
  p == 4  ? "1:70 2:55 3:22 4:18 5:62 6:-3 9:62 10:30 16:20 26:36 18:-1.7 27:1 28:0.4 29:45 38:1 39:1 40:30" :
  p == 5  ? "1:66 3:35 4:30 5:56 7:55 8:4.8 15:1 10:20 26:36 38:1 39:0 40:20" :
  p == 6  ? "1:66 3:35 4:32 5:56 6:1 7:-85 8:3.2 15:1 10:0 26:36" :
  p == 7  ? "1:50 2:35 3:60 4:58 5:30 9:90 14:22 6:1 26:36 30:1 31:0.9 32:40 18:1.8" :
  p == 8  ? "1:60 3:72 4:30 5:55 6:4 9:72 10:45 26:36 18:-1.1 27:1 28:0.7 29:55 38:1 39:1 40:28" :
  p == 9  ? "1:66 2:55 3:8 4:24 5:65 6:-5 9:55 16:18 26:45 18:-1.5" :
  p == 10 ? "1:55 3:50 4:48 5:42 9:82 14:65 15:1 7:30 8:5.6 26:36 18:-4 33:1 34:320 35:30 36:18" :
  p == 11 ? "1:60 3:58 4:56 5:32 9:88 14:30 15:1 7:20 8:6.2 6:2 26:36 18:-1.9 38:1 39:0 40:22" :
  p == 12 ? "1:40 2:30 3:30 4:35 6:-7 7:22 8:6.8 15:1 13:4 17:70 10:10 16:40 26:36" :
  p == 13 ? "1:55 3:60 4:90 5:52 6:2 9:78 10:35 26:36 18:2.9 27:1 28:0.8 29:50 33:1 37:2 35:28 36:15 38:1 39:1 40:22" :
  p == 14 ? "1:60 2:58 3:22 4:6 5:74 6:-4 9:66 10:28 15:1 16:20 26:27 18:-7.4" :
  "";
);
function load_preset(p) local(n, i) (
  i = 0; loop(18, slider(i + 1) = MKDEF[i]; i += 1; );
  slider26 = 36;
  i = 0; loop(14, slider(27 + i) = MKDEF[20 + i]; i += 1; );
  n = mk_nums(mk_pstr(p), MKTMP);
  i = 0; loop(floor(n / 2), (MKTMP[i * 2] >= 1 && MKTMP[i * 2] <= 18) || (MKTMP[i * 2] >= 26 && MKTMP[i * 2] <= 40) ? slider(MKTMP[i * 2]) = MKTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(18, ui_auto(i); i += 1; ); i = 26; loop(15, ui_auto(i); i += 1; );
  pr_cur = p;
);

// ---------- the velocity curve: key velocity -> hammer speed (0..1) ----------
// (0 % = every note at one fixed hammer speed, 25 % = a light curve, 100 % = a long hammer throw: the widest
// soft-to-slammed range, and a little more swing at the top)
function mk_vcurve(vel) local(x, b) (
  x = min(max(vel / 127, 0.01), 1);
  b = min(mk_vsens * 4, 1);
  0.7 * (1 - b) + b * x ^ (0.45 + 2.15 * mk_vsens ^ 1.3);
);

// ---------- voice coefficients for the current pitch (drift) and damper state ----------
// the tine's fundamental loses energy faster while it swings wide (air drag and clamp friction rise steeply
// with amplitude): a hard note's over-swing settles within tens of milliseconds into its singing sustain
// ... and while it swings wide it is stretched a little sharp: a hard hit settles a few cents down within ~30 ms
function mk_drag(p) local(q, a, e, r, h) (
  q = p + 40;
  a = abs(q[5]) * sqrt(max(q[0] * q[0] + q[1] * q[1] - 2 * p[16] * q[0] * q[1], 0)) * p[37];
  e = max(a - mk_dk, 0);
  r = q[9] * exp(-mk_db * e * e);
  q[2] = 2 * r * (e > 0 ? cos(p[35] * (1 + min(mk_kp * e * e, 0.00115))) : p[16]); q[3] = r * r;
  h = q[5] / (2 * sqrt(r) * p[39]); q[6] = h; q[7] = h * r;
  // the tonebar shares the extra loss, so the coupled pair stays balanced and the pitch never follows the swing
  r = p[28] * exp(-mk_db * e * e); p[23] = 2 * r * p[125]; p[24] = r * r;
  a;
);
function mk_coefs(p, pitch) local(k, q, w, r, h) (
  k = 0; q = p + 40;
  loop(p[20],
    w = q[8] * pitch; r = q[9];
    q[2] = 2 * r * cos(w); q[3] = r * r;
    h = q[5] / (2 * sqrt(r) * cos(0.5 * w)); q[6] = h; q[7] = h * r;
    k == 0 ? ( p[16] = cos(w); p[37] = 1 / sin(w); p[39] = cos(0.5 * w); p[35] = w; );
    q += 10; k += 1;
  );
  w = p[27] * pitch; p[125] = cos(w);
  mk_drag(p);
  // the horizontal polarisations share their vertical partner's damping
  k = 0; q = p + 102;
  loop(min(p[20], 2),
    w = q[7] * pitch; r = p[49 + 10 * k];
    q[2] = 2 * r * cos(w); q[3] = r * r;
    h = p[45 + 10 * k] / (2 * sqrt(r) * cos(0.5 * w)); q[5] = h; q[6] = h * r;
    q += 8; k += 1;
  );
);

function mk_r(t60) ( exp(-6.9078 / (max(t60, 0.002) * srate)); );

// ---------- note on: the hammer flies at a (re)built tine ----------
function mk_strike(p, n, vel, fresh) local(tr, kt, u, xi, mh, h1, h2, h3, h4, h5, f, w, i, q, ph, pt, R, T, A, off, tc, pe, cmax, v0, xr, s0, g, mu, dt, cHz, Tb, J, ef, dh, fb) (
  tr = min(max((n - 21) / 87, 0), 1);              // 0 = A0 .. 1 = C8
  kt = (n - 60) / 12;                               // octaves from middle C
  u = min(max((n - 29) / 74, 0), 1);                // 0 = the lowest F .. 1 = the top: tine length / tuning-spring weight
  xi = 0.18 - 0.08 * tr;                            // strike point (fraction of the length): nearer the base in the treble
  h1 = mk_hash(n, 1); h2 = mk_hash(n, 2); h3 = mk_hash(n, 3); h4 = mk_hash(n, 4); h5 = mk_hash(n, 5);
  v0 = mk_vcurve(vel);
  p[6] = vel / 127;
  fresh ? (
    // ----- the tine: pitch (with the key's own tuning error), modes, decays -----
    f = 440 * 2 ^ ((n - 69 + (h1 - 0.5) * 0.003 + (rand(2) - 1) * (mk_rnd + mk_drift * 1.5) / 100) / 12) * mk_fine;   // key +/-0.15 ct, RANDOM, DRIFT a quarter of the house amount
    p[1] = n;
    p[20] = 0;
    T = mk_dec * mk_t60(n) * (0.88 + 0.24 * h2);                       // fundamental T60 (s), measured curve
    T = min(max(T, 0.35), 45);
    i = 0; q = p + 40;
    loop(5,
      // measured on a real low F: 7.11 x and 20.25 x (the tuning spring lifts them off the bare beam's 6.27 / 17.55);
      // shorter treble tines with a relatively heavier spring push them a little higher still
      R = i == 0 ? 1 : i == 1 ? 7.11 * (1 + 0.09 * u) * (1 + (h3 - 0.5) * 0.02) : i == 2 ? 20.25 * (1 + 0.11 * u) * (1 + (h4 - 0.5) * 0.02) :
          i == 3 ? 40.0 * (1 + 0.12 * u) * (1 + (h5 - 0.5) * 0.02) : 66.0 * (1 + 0.12 * u);
      w = 2 * $pi * f * R / srate;
      w < 0.78 * $pi && f * R < 17000 ? (
        // decay of this mode: the fundamental sings, the bell (mode 2) rings, modes 3-5 are the hammer clink
        ph = i == 0 ? T : (i == 1 ? 1.15 : i == 2 ? 0.30 : i == 3 ? 0.07 : 0.04) * 2 ^ (-kt / 1.5) * (0.8 + 0.4 * mk_hash(n, 10 + i)) * sqrt(mk_dec);
        ph = min(ph, T);
        q[8] = w; q[9] = mk_r(ph); p[95 + i] = q[9]; i == 1 ? mk_r_t60b = ph;
        // mode shape at the strike point (clamped-free cantilever struck near the clamp), key-to-key spread
        p[90 + i] = mk_phi(i, xi) * (i ? 0.85 + 0.3 * mk_hash(n, 20 + i) : 1);
        q[4] = p[90 + i] * sin(w) / (2 * $pi * f * R * srate);                // force (one sample) -> modal displacement
        i == 1 ? q[4] = 0;                                                    // (the bell is set ringing directly, below)
        // how much of each mode the tip shows (the tuning spring and the taper): the treble partials are weaker
        pt = i == 0 ? 1 : i == 1 ? 1 : (i == 2 ? 0.2 : i == 3 ? 0.11 : 0.07) * (1 - 0.5 * u) * mk_tclk;
        q[5] = (i % 2 ? -2 : 2) * pt;                                   // (scaled by the pickup gain below)
        q[0] = q[1] = 0;
        p[20] += 1;
      );
      q += 10; i += 1;
    );
    // ----- the hammer: neoprene / felt contact -----
    // Hunt-Crossley contact F = k x^2.8 (1 + mu dx/dt); an 11 g hammer (velocity 127 = full speed, ~4 m/s) against
    // the tine's modal mass (a quarter of a tine of ~8 g in the bass, ~1 g at the top); the tip is stiffer in the treble
    tc = (0.8 - 0.35 * mk_hard) * 2 ^ (-kt / 1.8) * 0.001;               // contact time (s) at full speed
    tc = min(max(tc, 0.00035), 0.009);
    pe = 2.8;
    mh = min(max(5.5 * 2 ^ ((n - 40) / 24), 3), 30);                     // hammer mass / tine modal mass
    J = 1.402 - 0.091 * (pe - 2);
    cmax = tc / (2 * J);
    p[12] = pe; p[11] = (pe + 1) * mh / (2 * cmax ^ (pe + 1)); p[10] = 1 / (mh * srate);
    p[13] = 0.18 + 0.25 * (1 - mk_hard);                                 // felt loss (Hunt-Crossley mu)
    p[29] = mk_mech * 0.055 * tc / mh;                                   // hammer thump (from the contact force)
    // ----- the pickup: swing at full speed in pole widths, rest offset, output norm -----
    A = (2.3 - 1.55 * tr) * (0.92 + 0.16 * h4) * (0.79 + 0.3 * mk_vsens);
    p[133] = 1 + (h5 - 0.5) * 0.12 + (tr - 0.5) * 0.15;
    off = mk_offs * p[133];
    p[38] = off; p[17] = off;
    p[118] = (mk_hash(n, 40) - 0.5) * 0.03;                               // the tine sits a hair off the pole sideways too
    p[119] = 1 / (2 * (9 - 4 * tr));                                      // the tip moves on a circle about the clamp
    xr = 2 * p[90] * 2 * mh * 0.85 / (2 * $pi * f);                       // tip swing of the fundamental at full speed
    g = A / xr;
    q = p + 40; loop(p[20], q[5] *= g; q += 10; );
    p[123] = A;
    // output norm: the level of the fundamental and the octave at a medium swing, so VOICING changes the colour, not the level
    xr = 0.45 * A;
    p[129] = 0.31 * 0.45 * (1 - 0.22 * tr) * (0.94 + 0.12 * h3) / ($pi * f / srate);
    p[129] *= (n & 1) ? -1 : 1;                                           // the pickups alternate polarity key to key (hum-cancelling)
    p[18] = p[130] = p[129] / sqrt(sqr(mk_slope(off) * xr) + sqr(mk_curv(off) * xr * xr * 0.5));
    p[19] = p[134] = mk_flux(off, p[118], mk_d0);
    // ----- the horizontal polarisation of the fundamental and the bell: a weaker, slightly detuned twin, so the tip
    // traces a slowly precessing ellipse in front of the pole (the timbre turns over without any pitch change)
    ef = (0.08 + 0.17 * mk_hash(n, 41)) * mk_thor;                         // how much of the blow goes sideways
    dh = (0.01 + 0.05 * mk_hash(n, 42)) * (mk_hash(n, 43) > 0.5 ? 1 : -1);  // detune (Hz): a very slow precession, no chorus
    i = 0; q = p + 102;
    loop(min(p[20], 2),
      q[0] = q[1] = 0;
      q[7] = p[48 + 10 * i] + 2 * $pi * dh * (i ? 3 : 1) / srate;
      q[4] = p[44 + 10 * i] * ef;
      q += 8; i += 1;
    );
    // ----- the tonebar: a heavy resonator a fraction of a hertz off the tine, lightly coupled -----
    mu = 5;
    // designed from the beat it should give: a slow rate (0.3 - 1 Hz, slower in the bass) and a gentle 1 - 2 dB swell on
    // the fundamental, kept small enough that the two coupled modes never read as a pitch wobble (< ~0.35 cent)
    dt = 0.3 + (0.25 + 0.45 * tr) * h2;                                  // beat rate (Hz)
    cHz = 10 ^ ((0.12 + 0.18 * h3) / 20); cHz = (cHz - 1) / (cHz + 1);   // tonebar share of the tine motion (b / a): faint
    cHz = min(cHz, 0.08 / 1731 * f / dt);
    cHz = 0.5 * tan(2 * atan(sqrt(cHz)));                                 // coupling / detune ratio
    dt /= sqrt(1 + 4 * cHz * cHz);                                        // detune (Hz)
    cHz *= dt;                                                            // coupling (Hz)
    h1 < 0.5 ? dt = -dt;
    g = 2 * sqrt(mu) * cHz / f;
    // the coupling spring stiffens both: pre-tune them so the tine sounds at f and the bar at f + dt
    w = 2 * $pi * f / srate;
    p[48] = w / sqrt(1 + g);
    w = sqrt(sqr(2 * $pi * (f + dt) / srate) - g * w * w / mu);
    p[27] = w; Tb = T; p[30] = p[28] = mk_r(Tb);
    p[25] = g * (2 * $pi * f / srate) * sin(w) / mu * mk_tcpl;
    p[26] = g * (2 * $pi * f / srate) * sin(2 * $pi * f / srate) * mk_tcpl;
    p[21] = p[22] = 0;
    p[36] = 1 + 1.2 * (1 - tr);                                           // bass dampers are slower
    p[33] = mk_symk * 2 * $pi * f / srate / max(abs(p[45]), 0.000001);
    p[32] = 0; p[34] = 0;
    p[122] = srate * min(2 * mk_r_t60b, 6);
    p[20] > 1 ? (
      // the bell reaches the output mostly through the pickup's straight (linear) response, only a third of it
      // through the curve, so the fundamental's swing does not ring-modulate it into sidebands
      p[135] = -p[55] * 0.65;
      p[124] = p[131] = max(mk_slope(off), 0.35 * mk_slope(0.53)) * p[135] * p[18];
      p[55] *= 0.35;
    );
    p[136] = mk_ckg * (0.3 + 2 * mk_mech) * min(max(2 ^ (1.8 * kt), 0.25), 6);
    p[100] = 0; p[101] = p[132] = p[136] * p[18] * max(mk_slope(off), 0.35 * mk_slope(0.53));   // the clink layer (hammer tick)
  ) : (
    // the same key struck again while it rings: the dampers come up, the hammer meets the moving tine
    i = 0; q = p + 40; loop(p[20], q[9] = p[95 + i]; q += 10; i += 1; );
    p[28] = p[30];
  );
  // the hammer starts at the tine's strike point, flying at v0
  s0 = 0; i = 0; q = p + 40; loop(p[20], s0 += p[90 + i] * q[0]; q += 10; i += 1; );
  p[8] = s0; p[9] = v0 * 1; p[34] = s0;
  p[7] = floor(0.03 * srate);
  p[120] = p[20]; p[121] = 0;
  // the bell: rung by the blow with a gentle velocity curve (about 11 dB from velocity 40 to 127) and only a light
  // dependence on HARDNESS, at a level set by BELL
  p[20] > 1 ? (
    q = p + 50;
    // rung by a short raised-cosine push (not an instant jump, so its onset has no click): 1.2 - 0.6 ms with
    // HARDNESS, at most 1.2 bell periods; the push height is set so the ring reaches the same level
    w = max(2, floor(min((1.2 - 0.6 * mk_hard) * 0.001 * srate, 1.2 * 2 * $pi / q[8])));
    s0 = 0; dt = 0; i = 0; loop(w, cHz = 1 - cos(2 * $pi * (i + 0.5) / w); s0 += cHz * cos(q[8] * i); dt += cHz * sin(q[8] * i); i += 1; );
    v0 = mk_bk * mk_bell * (1 + 0.3 * u) * (0.8 + 0.4 * mk_hash(n, 30)) * p[123] * (vel / 127) ^ 1.45 * 2 ^ ((mk_hard - 0.5) * 0.8);
    v0 /= max(abs(p[55]) / 0.35, 0.0000001);                              // tip swing -> modal displacement
    // the higher the bell partial (upper keys), the more it is turned down - more steeply the higher BELL is set
    fb = q[8] * srate / (2 * $pi); fb > 1200 ? v0 *= (1200 / fb) ^ (slider26 / 50);
    p[126] = 0; p[127] = w; p[128] = v0 * sin(q[8]) / max(sqrt(s0 * s0 + dt * dt), 0.000001) * (mk_hash(n, 31) > 0.5 ? 1 : -1);
  );
  p[0] = 1; p[3] = 1; p[4] = 0; p[5] = 0; p[31] = 0;
  mk_coefs(p, mk_ptch);
);

// GAP / VOICING moved while the voice sounds: its output norm and the bell / clink path gains follow the
// (smoothed) pickup geometry exactly as a new note would get them, so the level glides instead of jumping
function mk_norm(p) local(off, xr, sl, m) (
  off = mk_offs * p[133]; xr = 0.45 * p[123];
  sl = mk_slope(off);
  p[130] = p[129] / max(sqrt(sqr(sl * xr) + sqr(mk_curv(off) * xr * xr * 0.5)), 0.000000000001);
  m = max(sl, 0.35 * mk_slope(0.53));
  p[131] = m * p[135] * p[130]; p[132] = m * p[136] * p[130];
);

function mk_pan(p, n) local(pan) (
  pan = min(max((n - 64) / 30, -1), 1) * mk_width;
  p[14] = sqrt(0.5 * (1 - pan)); p[15] = sqrt(0.5 * (1 + pan));
);

function mk_alloc() local(i, p, best, ba, nact) (
  // a free slot; within POLYPHONY else the oldest note is faded out (released ones first) and a spare slot used
  nact = 0; i = 0; loop(MKNV, p = MKV + i * MKVS; p[0] && !p[31] ? nact += 1; i += 1; );
  nact >= mk_poly ? (
    best = -1; i = 0;
    loop(MKNV, p = MKV + i * MKVS; p[0] && !p[31] && (best < 0 || p[2] - p[5] * 1000000 < ba) ? ( best = i; ba = p[2] - p[5] * 1000000; ); i += 1; );
    best >= 0 ? ( p = MKV + best * MKVS; p[31] = 1; p[5] = 1; p[3] = 0; p[4] = 0; );
  );
  best = -1; i = 0; loop(MKNV, p = MKV + i * MKVS; best < 0 && !p[0] ? best = i; i += 1; );
  best < 0 ? ( i = 0; loop(MKNV, p = MKV + i * MKVS; p[31] && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; ); );
  best < 0 ? best = 0;
  MKV + best * MKVS;
);

function mk_release(p) local(q, i) (
  p[5] = 1; p[3] = 0; p[4] = 0;
  // the damper felt touches the tine: a soft tick into the tine modes
  q = p + 40; i = 0;
  loop(min(p[20], 2), q[0] -= q[4] * mk_mech * 0.005 * 3 * srate * (q[0] - q[1] > 0 ? 1 : -1) * p[6] * (i ? 0.3 : 1); q += 10; i += 1; );   // a soft felt 'thup'
  mk_kn = max(mk_kn, mk_mech * 0.0045 * (0.4 + 0.6 * p[6]));
);

function mk_note_on(n, vel) local(i, p, found) (
  found = -1; i = 0;
  loop(MKNV, p = MKV + i * MKVS; p[0] && p[1] == n && !p[31] ? found = i; i += 1; );
  found >= 0 ? (
    p = MKV + found * MKVS; mk_age += 1; p[2] = mk_age; mk_strike(p, n, vel, 0);
  ) : (
    p = mk_alloc(); memset(p, 0, MKVS); mk_age += 1; p[2] = mk_age;
    mk_strike(p, n, vel, 1); mk_pan(p, n);
  );
);
function mk_note_off(n) local(i, p) (
  i = 0;
  loop(MKNV, p = MKV + i * MKVS;
    p[0] && p[1] == n && p[3] && !p[31] ? ( mk_pedal ? ( p[3] = 0; p[4] = 1; ) : mk_release(p); );
    i += 1; );
);
function mk_pedal_up() local(i, p) (
  i = 0; loop(MKNV, p = MKV + i * MKVS; p[0] && p[4] ? mk_release(p); i += 1; );
);
// all notes off: every voice fades out fast (25 ms, as a stolen voice) instead of stopping dead
function mk_all_off() local(i, p) ( i = 0; loop(MKNV, p = MKV + i * MKVS; p[0] ? ( p[31] = 1; p[5] = 1; p[3] = 0; p[4] = 0; ); i += 1; ); mk_pedal = 0; );

// half-band decimator (39 taps, equiripple, > 63 dB stop band): ring[(w - j) & 63], newest 2x sample at j = 0
function mk_hb(b, w) (
  0.5003175242 * b[(w - 19) & 63]
  + 0.3165830275 * (b[(w - 18) & 63] + b[(w - 20) & 63])
  - 0.1004920620 * (b[(w - 16) & 63] + b[(w - 22) & 63])
  + 0.0546158895 * (b[(w - 14) & 63] + b[(w - 24) & 63])
  - 0.0335169601 * (b[(w - 12) & 63] + b[(w - 26) & 63])
  + 0.0211574377 * (b[(w - 10) & 63] + b[(w - 28) & 63])
  - 0.0131712778 * (b[(w - 8) & 63] + b[(w - 30) & 63])
  + 0.0078701971 * (b[(w - 6) & 63] + b[(w - 32) & 63])
  - 0.0043811777 * (b[(w - 4) & 63] + b[(w - 34) & 63])
  + 0.0021893628 * (b[(w - 2) & 63] + b[(w - 36) & 63])
  - 0.0010131992 * (b[(w - 0) & 63] + b[(w - 38) & 63]);
);

// ---------- FX (after GFX Mod Rack, simplified as in Harbour Keys) ----------
function mf_read(buf, n, pos) local(ii, fr, xm1, x0, x1, x2, c1, c2, c3) (
  pos < 0 ? pos += n; pos >= n ? pos -= n;
  ii = floor(pos); fr = pos - ii;
  xm1 = buf[(ii - 1 + n) % n]; x0 = buf[ii]; x1 = buf[(ii + 1) % n]; x2 = buf[(ii + 2) % n];
  c1 = 0.5 * (x1 - xm1); c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * fr + c2) * fr + c1) * fr + x0;
);
// vibe: a lamp-driven 4-stage photocell all-pass; vs[0..7] states, [8] lamp, [9..12] stage coefficients
function mf_vibe(x, phoff, vs, tick) local(ph, lf, k, y, f, t, a1, xi) (
  tick ? (
    ph = mf_vph + phoff; ph -= floor(ph); lf = 0.5 - 0.5 * cos(2 * $pi * ph);
    vs[8] += (lf > vs[8] ? mf_vat : mf_vrl) * (lf - vs[8]);
    k = 0; loop(4,
      f = min(srate * 0.45, (k == 0 ? 60 : k == 1 ? 180 : k == 2 ? 480 : 1300) * 2 ^ (mf_vocs * vs[8]));
      t = tan($pi * f / srate); vs[9 + k] = (t - 1) / (t + 1); k += 1; );
  );
  y = x; k = 0;
  loop(4, a1 = vs[9 + k]; xi = y; y = a1 * xi + vs[k * 2] - a1 * vs[k * 2 + 1]; vs[k * 2] = xi; vs[k * 2 + 1] = y; k += 1; );
  0.5 * (y - x);
);
function mf_dloop(y, st) (
  st[0] += mf_dlc * (y - st[0]); st[1] += mf_dhc * (st[0] - st[1]);
  vo_tanh((st[0] - st[1]) * mf_dfbs * 1.15) / 1.15;
);

// SPACE: the tank for type ty (the feedback gain mf_rgt is glided in @sample)
function mf_sparams(ty) (
  mf_sk = ty == 1 ? 0.6 : ty == 2 ? 0.85 : 1;
  mf_st60 = ty == 1 ? 1.4 + 2.6 * mf_sam : ty == 2 ? 2.4 : 0.5 + 0.8 * mf_sam;
  mf_slv = ty == 1 ? 0.8 : ty == 2 ? 1.4 : 1;
  mf_rgt = 10 ^ (-3 * 0.015 * mf_sk / mf_st60);
  mf_l0 = floor(0.0073 * srate * mf_sk); mf_l1 = floor(0.0119 * srate * mf_sk); mf_l2 = floor(0.0171 * srate * mf_sk); mf_l3 = floor(0.0217 * srate * mf_sk);
  mf_slp = 1 - exp(-2 * $pi * (ty == 1 ? 10000 : ty == 2 ? 8000 : 6500) / srate);
);

// ---------- parameters ----------
function update() (
  mk_dec = 2 ^ ((slider1 - 50) / 50 * 1.5);                // 0.35x .. 2.8x
  mk_relt = 0.03 * 2 ^ (slider2 / 100 * 5.5);              // damper T60: 30 ms .. 1.4 s
  mk_hard = slider3 / 100;
  mk_off0 = 0.015 + 1.185 * (1 - slider4 / 100) ^ 1.45;      // tine rest across the pole: far off-axis (dark) .. inline (dyno; glided)
  mk_bell = (slider26 / 100) ^ 1.5;                       // 100 % = the old 50 %
  // TAME strength from the settings that push the top end (0 for soft, mellow settings)
  mk_tk2 = (0.9 * max(slider3 / 100 - 0.35, 0) / 0.65 + 0.7 * max(slider26 / 100 - 0.7, 0) / 0.3 + 0.9 * max(slider4 / 100 - 0.55, 0) / 0.45) * mk_ttam;
  mk_d0t = 2 ^ ((slider5 / 100 - 0.5) * 1.4);              // GAP: the pole's distance from the tine tip (1 = standard; glided in @sample)
  mk_a2 = 0.12;                                              // (pole radius)^2: the magnet tip's own size
  mk_treb = slider6;
  mk_mod = slider7 / 100; mk_rate = slider8;
  mk_vsens = slider9 / 100; mk_width = slider10 / 100;
  mk_poly = floor(slider11 + 0.5);
  mk_fine = 2 ^ (slider12 / 1200); mk_rnd = slider13;
  mk_od = slider14 / 100; mk_amp = slider15 >= 0.5;
  mk_mech = slider16 / 100;
  mk_drift = slider17 / 100;
  mk_volt = 10 ^ (slider18 / 20);
  mk_chan = slider25;
  mk_dk = 0.75; mk_db = 14 / srate;                          // drag: knee (pole widths) and strength
  mk_ckg = 20;                                               // clink layer level
  mk_kp = 0;                                                 // (no amplitude-dependent pitch: the pitch never follows the dynamics)
  mk_bk = 0.07;                                              // bell level
  ins_output_setup(19);   // output stage: CLIP, always on
  // FX
  mf_chon = slider27 >= 0.5; mf_chr = slider28; mf_chd = slider29 / 100 * 4;
  mf_vbon = slider30 >= 0.5; mf_vbr = slider31; mf_voct = 3 * slider32 / 100; mf_vwet = min(1, 2 * slider32 / 100);
  mf_dlon = slider33 >= 0.5; mf_dfb = 0.95 * slider35 / 95; mf_dmix = slider36 / 100; mf_dsync = floor(slider37 + 0.5);
  mf_spon = slider38 >= 0.5; mf_sty = floor(slider39 + 0.5); mf_sam = slider40 / 100;
  mf_stya < 0 ? mf_stya = mf_sty;
  mf_sparams(mf_stya);                                        // (a new SPACE type is switched in @sample, under a short fade)
);

function mk_srinit() (
  mk_sr = srate;
  mk_sm = 1 - exp(-1 / (0.03 * srate));
  ost_init(20000);
  mk_tq.bq_set(5, 150, 1.2, 0);                             // hammer thump body (key bed)
  mk_tc.bq_set(1, 2500, 0.7, 0);                            // hammer click
  mk_tc2.bq_set(0, 5000, 0.7, 0);                           // (its top rounded off, so it never ticks)
  mk_cklp = 1 - exp(-2 * $pi * 7000 / srate);               // clink low-pass
  mk_knd = exp(-1 / (0.012 * srate));
  mk_tsl.bq_set(0, 2800, 0.7071, 0); mk_tsr.bq_set(0, 2800, 0.7071, 0); mk_tsl2.bq_set(0, 2800, 0.7071, 0); mk_tsr2.bq_set(0, 2800, 0.7071, 0);   // TAME split (LR4)
  mk_thl.bq_set(1, 2800, 0.7071, 0); mk_thr.bq_set(1, 2800, 0.7071, 0); mk_thl2.bq_set(1, 2800, 0.7071, 0); mk_thr2.bq_set(1, 2800, 0.7071, 0);
  mk_tat = 1 - exp(-1 / (0.001 * srate)); mk_trl = 1 - exp(-1 / (0.08 * srate));
  mk_tth = 0.007;
  mf_cpc = 1 - exp(-2 * $pi * 9000 / srate);
  mf_vat = 1 - exp(-8 / (0.008 * srate)); mf_vrl = 1 - exp(-8 / (0.04 * srate));     // vibe lamp (per 8 samples)
  mf_dlc = 1 - exp(-2 * $pi * 3500 / srate); mf_dhc = 1 - exp(-2 * $pi * 70 / srate);
  mf_dihc = 1 - exp(-2 * $pi * 300 / srate);                 // delay input high-pass
  mf_dts = 1 - exp(-1 / (0.25 * srate)); mf_gsm = 1 - exp(-1 / (0.02 * srate));
  mf_ghl = floor(0.3 * srate); mf_grl = 1 - exp(-1 / (0.025 * srate));
  memset(MFDA, 0, MFDN); memset(MFDB, 0, MFDN); mf_dw = 0;
  // (a new rate: the voices' tine / tonebar / hammer coefficients were built for the old one, and a key struck again
  // re-uses its ringing voice, so every voice and line is cleared: the next notes are built fresh at the new rate)
  memset(MKV, 0, MKVS * MKNV); memset(MKHL, 0, 64); memset(MKHR, 0, 64); memset(MFCA, 0, 2 * 4100); memset(MFR, 0, 4 * MFRN); memset(MFVA, 0, 80);
  mk_kq.bq_set(5, 320, 0.9, 0);                             // key-off knock: a dull felt bump, not a click
  mk_bh = 1 - exp(-1 / (0.014 * srate)); mk_bc = 1 - exp(-1 / (0.045 * srate));   // bulb: heats ~14 ms, cools ~45 ms
  mk_tset = -1;
  // de-zipper: GAP / VOICING 30 ms, the norm follows within 2 ms, TAME / modulation 20 ms, TREBLE / OVERDRIVE 30 ms per 32-sample tick
  mk_gk = 1 - exp(-1 / (0.015 * srate)); mk_nk = 1 - exp(-1 / (0.002 * srate)); mk_gk2 = 1 - exp(-1 / (0.02 * srate));
  mk_k32 = 1 - exp(-32 / (0.03 * srate)); mf_gsm2 = 1 - exp(-1 / (0.05 * srate));
  mk_swdn = 1 / (0.012 * srate); mk_swup = 1 / (0.02 * srate);  // the brief fades for switches (12 ms out, 20 ms in)
);

function mk_tcoil() local(f) (
  // the pickup coil and its cable: a gentle resonant low-pass (drifts a little)
  f = 6800 * 2 ^ (ins_tone * 0.35);
  mk_cl.bq_set(0, f, 0.85, 0); mk_cr.bq_set(0, f, 0.85, 0);
);
function mk_tamp() (
  mk_amp ? (
    // SUITCASE (a) its preamp tone stack: bass and treble shelving with a mid scoop
    mk_a1l.bq_set(4, 110, 0.7, 3.5); mk_a1r.bq_set(4, 110, 0.7, 3.5);
    mk_a2l.bq_set(2, 650, 0.8, -5); mk_a2r.bq_set(2, 650, 0.8, -5);
    mk_a3l.bq_set(3, 3200, 0.7, 4); mk_a3r.bq_set(3, 3200, 0.7, 4);
    // (c) the 4 x 12 open-back cabinet: low resonance, cone mid bump, roll-off from ~5 kHz, low cut
    mk_c1l.bq_set(2, 100, 1.6, 3.5); mk_c1r.bq_set(2, 100, 1.6, 3.5);
    mk_c2l.bq_set(2, 1800, 1.0, 3); mk_c2r.bq_set(2, 1800, 1.0, 3);
    mk_c3l.bq_set(0, 5000, 0.8, 0); mk_c3r.bq_set(0, 5000, 0.8, 0);
    mk_c4l.bq_set(1, 55, 0.8, 0); mk_c4r.bq_set(1, 55, 0.8, 0);
    mk_pre = 1.25; mk_bias = -0.3; mk_cg = 10 ^ (2 / 20);
  ) : (
    // STAGE (a) a flatter stage-amp input
    mk_a1l.bq_set(4, 120, 0.7, 1.5); mk_a1r.bq_set(4, 120, 0.7, 1.5);
    mk_a2l.bq_set(2, 900, 0.8, -1); mk_a2r.bq_set(2, 900, 0.8, -1);
    mk_a3l.bq_set(3, 3200, 0.7, 0); mk_a3r.bq_set(3, 3200, 0.7, 0);
    // (c) direct / DI-like: a gentle top roll-off around 10 kHz
    mk_c1l.bq_set(2, 100, 1.6, 0); mk_c1r.bq_set(2, 100, 1.6, 0);
    mk_c2l.bq_set(2, 1800, 1.0, 0); mk_c2r.bq_set(2, 1800, 1.0, 0);
    mk_c3l.bq_set(0, 10000, 0.6, 0); mk_c3r.bq_set(0, 10000, 0.6, 0);
    mk_c4l.bq_set(1, 30, 0.7, 0); mk_c4r.bq_set(1, 30, 0.7, 0);
    mk_pre = 0.85; mk_bias = -0.2; mk_cg = 1;
  );
  mk_bt = vo_tanh(mk_bias);
);
function mk_ttreb() ( mk_tbl.bq_set(3, 3000, 0.7, mk_trs); mk_tbr.bq_set(3, 3000, 0.7, mk_trs); );   // (the glided TREBLE)
function mk_drv() (
  // (b) the valves / transistors: tanh(x g + b) - tanh(b), the bias makes the drive add even harmonics (the glided OVERDRIVE)
  mk_dg = mk_pre * (1 + 30 * mk_ods * mk_ods);
  mk_dn = mk_cg / (mk_dg ^ 0.75 * mk_pre ^ 0.25 * (1 - mk_bt * mk_bt));   // drive adds some gain, like a real amp
);
function mk_tone() (
  mk_tcoil(); mk_tamp(); mk_trs = mk_treb; mk_ttreb(); mk_ods = mk_od; mk_drv(); mk_dgs = mk_dg; mk_dns = mk_dn;
);

ins_drift_init();
mk_tcpl = 1; mk_tclk = 1; mk_thor = 1; mk_ttam = 1;                     // test hooks: tonebar coupling, clink modes, horizontal (1 = as designed)
mk_symk = 0.00012;                                         // sympathetic coupling between undamped tines
mk_pedal = 0; mk_age = 0; mk_kn = 0; mk_hw = 0; mk_lph = 0; mk_rail = 0; mk_pk_disp = 0;
mk_dcxl = mk_dcyl = mk_dcxr = mk_dcyr = 0; mk_ptch = 1; mk_bu1 = mk_bu2 = 0.5; mk_adn = 0.000000000000000001;
mf_stya = -1; mk_swr = mk_swg = 1; mf_dkr = mf_skr = 1; mf_dstop = mf_sstop = 1; mf_vmk = 1;
mk_srinit();
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                     // a new instance opens Large, on Init
update();
mk_d0 = mk_d0a = mk_d0t; mk_offs = mk_offa = mk_off0; mk_cutf = 1; mk_drs = mk_drift;
mk_tone();
mk_vol = mk_volt;
ui_dflt = 1;

// ---------- the EDIT page: the Wideload strip (names prefixed wl_; tables at WLB) ----------
WLB = 2000000;

// ---------- tables ----------
wl_mod_on = WLB + 0;  wl_mod_tgt = WLB + 4;          // [3] 0 PRE, 1 EQ, 2 COMP
wl_lff_tab = WLB + 10; wl_lff_tab[0]=30; wl_lff_tab[1]=50; wl_lff_tab[2]=70; wl_lff_tab[3]=90;
wl_hff_tab = WLB + 20; wl_hff_tab[0]=8000; wl_hff_tab[1]=12000; wl_hff_tab[2]=16000; wl_hff_tab[3]=20000;
wl_hpf_tab = WLB + 30; wl_hpf_tab[0]=0; wl_hpf_tab[1]=30; wl_hpf_tab[2]=40; wl_hpf_tab[3]=50;
wl_atk_tab = WLB + 40; wl_atk_tab[0]=0.1; wl_atk_tab[1]=0.3; wl_atk_tab[2]=1; wl_atk_tab[3]=3; wl_atk_tab[4]=10; wl_atk_tab[5]=30;
wl_rel_tab = WLB + 50; wl_rel_tab[0]=100; wl_rel_tab[1]=300; wl_rel_tab[2]=600; wl_rel_tab[3]=1200;
wl_rt_tab = WLB + 60; wl_rt_tab[0]=1.5; wl_rt_tab[1]=2; wl_rt_tab[2]=4; wl_rt_tab[3]=10;
wl_kn_tab = WLB + 70; wl_kn_tab[0]=12; wl_kn_tab[1]=9; wl_kn_tab[2]=6; wl_kn_tab[3]=3;      // knee widens as ratio drops (TUNE)
wl_lfb_tab = WLB + 90; wl_lfb_tab[0]=20; wl_lfb_tab[1]=30; wl_lfb_tab[2]=60; wl_lfb_tab[3]=100;
wl_hfb_tab = WLB + 95; wl_hfb_tab[0]=3000; wl_hfb_tab[1]=4000; wl_hfb_tab[2]=5000; wl_hfb_tab[3]=8000; wl_hfb_tab[4]=10000; wl_hfb_tab[5]=12000; wl_hfb_tab[6]=16000;
wl_haf_tab = WLB + 105; wl_haf_tab[0]=5000; wl_haf_tab[1]=10000; wl_haf_tab[2]=20000;
wl_tca_tab = WLB + 110; wl_tca_tab[0]=0.2; wl_tca_tab[1]=0.2; wl_tca_tab[2]=0.4; wl_tca_tab[3]=0.4; wl_tca_tab[4]=0.4; wl_tca_tab[5]=0.2;    // VM-67 attack (ms)
wl_tcr_tab = WLB + 120; wl_tcr_tab[0]=300; wl_tcr_tab[1]=800; wl_tcr_tab[2]=2000; wl_tcr_tab[3]=5000; wl_tcr_tab[4]=2000; wl_tcr_tab[5]=300; // release (ms); TC 5 / 6 auto
wl_sch_tab = WLB + 80; wl_sch_tab[0]=0; wl_sch_tab[1]=30; wl_sch_tab[2]=60; wl_sch_tab[3]=105; wl_sch_tab[4]=125; wl_sch_tab[5]=185;

// ---------- strings: hover tags and printed scales ----------
strcpy(100,"30 Hz"); strcpy(101,"50 Hz"); strcpy(102,"70 Hz"); strcpy(103,"90 Hz");
strcpy(110,"8 kHz"); strcpy(111,"12 kHz"); strcpy(112,"16 kHz"); strcpy(113,"20 kHz");
strcpy(120,"OFF"); strcpy(121,"30 Hz"); strcpy(122,"40 Hz"); strcpy(123,"50 Hz");
strcpy(130,"0.1 ms"); strcpy(131,"0.3 ms"); strcpy(132,"1 ms"); strcpy(133,"3 ms"); strcpy(134,"10 ms"); strcpy(135,"30 ms");
strcpy(140,"0.1 s"); strcpy(141,"0.3 s"); strcpy(142,"0.6 s"); strcpy(143,"1.2 s"); strcpy(144,"AUTO");
strcpy(150,"1.5:1"); strcpy(151,"2:1"); strcpy(152,"4:1"); strcpy(153,"10:1");
strcpy(160,"OFF"); strcpy(161,"30 Hz"); strcpy(162,"60 Hz"); strcpy(163,"105 Hz"); strcpy(164,"125 Hz"); strcpy(165,"185 Hz");
strcpy(200,"30"); strcpy(201,"50"); strcpy(202,"70"); strcpy(203,"90");
strcpy(210,"8"); strcpy(211,"12"); strcpy(212,"16"); strcpy(213,"20");
strcpy(220,"OFF"); strcpy(221,"30"); strcpy(222,"40"); strcpy(223,"50");
strcpy(230,".1"); strcpy(231,".3"); strcpy(232,"1"); strcpy(233,"3"); strcpy(234,"10"); strcpy(235,"30");
strcpy(240,".1"); strcpy(241,".3"); strcpy(242,".6"); strcpy(243,"1.2"); strcpy(244,"A");
strcpy(250,"1.5"); strcpy(251,"2"); strcpy(252,"4"); strcpy(253,"10");
strcpy(260,"OFF"); strcpy(261,"30"); strcpy(262,"60"); strcpy(263,"105"); strcpy(264,"125"); strcpy(265,"185");
strcpy(270,"100"); strcpy(271,"330"); strcpy(272,"1.1k");
strcpy(280,"600"); strcpy(281,"2.3k"); strcpy(282,"9k");
strcpy(300,"20 Hz"); strcpy(301,"30 Hz"); strcpy(302,"60 Hz"); strcpy(303,"100 Hz");
strcpy(310,"20"); strcpy(311,"30"); strcpy(312,"60"); strcpy(313,"100");
strcpy(320,"3 kHz"); strcpy(321,"4 kHz"); strcpy(322,"5 kHz"); strcpy(323,"8 kHz"); strcpy(324,"10 kHz"); strcpy(325,"12 kHz"); strcpy(326,"16 kHz");
strcpy(330,"3"); strcpy(331,"4"); strcpy(332,"5"); strcpy(333,"8"); strcpy(334,"10"); strcpy(335,"12"); strcpy(336,"16");
strcpy(340,"5 kHz"); strcpy(341,"10 kHz"); strcpy(342,"20 kHz");
strcpy(345,"5"); strcpy(346,"10"); strcpy(347,"20");
strcpy(350,"TC 1  0.3 s"); strcpy(351,"TC 2  0.8 s"); strcpy(352,"TC 3  2 s"); strcpy(353,"TC 4  5 s"); strcpy(354,"TC 5  AUTO 2-10 s"); strcpy(355,"TC 6  AUTO 0.3-10 s");
strcpy(370,"SHARP"); strcpy(371,"BROAD");
strcpy(360,"1"); strcpy(361,"2"); strcpy(362,"3"); strcpy(363,"4"); strcpy(364,"5"); strcpy(365,"6");

// ---------- tuning constants (TUNE) ----------
wl_AR_K     = 0.22;   // AR-70 discrete stage headroom
wl_AR_BIAS  = 0.10;   // asymmetry -> 2nd harmonic when driven
wl_AR_IRON  = 70;     // input-transformer LF saturation band
wl_FOCUS_Q  = 2.5;    // FOCUS narrows Q by this factor ...
wl_FOCUS_G  = 15 / 9; // ... and stretches the gain range from +-9 to +-15 dB
wl_SX_K     = 0.12;   // SX-6 stage headroom at VHD 0 (cleaner than the AR-70)
wl_SX_BIAS  = 0.15;   // asymmetry of the 2nd-harmonic path
wl_MT_K     = 0.15;   // MT-7 tube make-up stage
wl_MT_BIAS  = 0.12;
wl_VM_BIAS  = 0.14;   // VM-67 tube asymmetry

wl_first_run = 1;
wl_fade_g = 1;

// =====================================================================
// DSP building blocks
// =====================================================================
function wl_db2g(wl_d) ( exp(wl_d * 0.11512925464970228); );
function wl_g2db(wl_x) ( 8.685889638065035 * log(max(wl_x, 0.000000001)); );
function wl_tg(wl_f) ( tan($pi * min(wl_f, srate * 0.45) / srate); );

// one-pole TPT low-pass (high-pass = x - lp)
function wl_op_set(wl_fc) instance(wl_G) local(wl_w) ( wl_w = wl_tg(wl_fc);  wl_G = wl_w / (1 + wl_w); );
function wl_op_lp(wl_x) instance(wl_G, wl_s) local(wl_v, wl_y) ( wl_v = (wl_x - wl_s) * wl_G;  wl_y = wl_v + wl_s;  wl_s = wl_y + wl_v;  wl_y; );

// Cytomic SVF with output mix: y = m0 x + m1 v1 + m2 v2 (all shapes from one core)
function wl_f2_core(wl_g_, wl_k_) instance(wl_g, wl_k, wl_a1, wl_a2, wl_a3) (
  wl_g = wl_g_;  wl_k = wl_k_;  wl_a1 = 1 / (1 + wl_g * (wl_g + wl_k));  wl_a2 = wl_g * wl_a1;  wl_a3 = wl_g * wl_a2;
);
function wl_ls_set(wl_f, wl_q, wl_db) instance(wl_g, wl_k, wl_a1, wl_a2, wl_a3, wl_m0, wl_m1, wl_m2) local(wl_A) (
  wl_A = exp(wl_db * 0.05756462732485115);
  this.wl_f2_core(wl_tg(wl_f) / sqrt(wl_A), 1 / wl_q);  wl_m0 = 1;  wl_m1 = wl_k * (wl_A - 1);  wl_m2 = wl_A * wl_A - 1;
);
function wl_hs_set(wl_f, wl_q, wl_db) instance(wl_g, wl_k, wl_a1, wl_a2, wl_a3, wl_m0, wl_m1, wl_m2) local(wl_A) (
  wl_A = exp(wl_db * 0.05756462732485115);
  this.wl_f2_core(wl_tg(wl_f) * sqrt(wl_A), 1 / wl_q);  wl_m0 = wl_A * wl_A;  wl_m1 = wl_k * (1 - wl_A) * wl_A;  wl_m2 = 1 - wl_A * wl_A;
);
function wl_pk_set(wl_f, wl_q, wl_db) instance(wl_g, wl_k, wl_a1, wl_a2, wl_a3, wl_m0, wl_m1, wl_m2) local(wl_A) (
  wl_A = exp(wl_db * 0.05756462732485115);
  this.wl_f2_core(wl_tg(wl_f), 1 / (wl_q * wl_A));  wl_m0 = 1;  wl_m1 = wl_k * (wl_A * wl_A - 1);  wl_m2 = 0;
);
function wl_hp_set(wl_f, wl_q) instance(wl_g, wl_k, wl_a1, wl_a2, wl_a3, wl_m0, wl_m1, wl_m2) (
  this.wl_f2_core(wl_tg(wl_f), 1 / wl_q);  wl_m0 = 1;  wl_m1 = -wl_k;  wl_m2 = -1;
);
function wl_f2_tick(wl_x) instance(wl_a1, wl_a2, wl_a3, wl_m0, wl_m1, wl_m2, wl_ic1, wl_ic2) local(wl_v1, wl_v2, wl_v3) (
  wl_v3 = wl_x - wl_ic2;  wl_v1 = wl_a1 * wl_ic1 + wl_a2 * wl_v3;  wl_v2 = wl_ic2 + wl_a2 * wl_ic1 + wl_a3 * wl_v3;
  wl_ic1 = 2 * wl_v1 - wl_ic1;  wl_ic2 = 2 * wl_v2 - wl_ic2;
  wl_m0 * wl_x + wl_m1 * wl_v1 + wl_m2 * wl_v2;
);

// house clipper: first-order ADAA soft saturator, f(x) = x / (1 + |x|)
function wl_sat_f(wl_x) ( wl_x / (1 + abs(wl_x)); );
function wl_sat_ad(wl_x) ( abs(wl_x) - log(1 + abs(wl_x)); );
// The ADAA reading sits half a sample late (a gentle top-end roll-off: -5 dB at 15 kHz
// per stage); half the plain curve's step is added back, as in the house output stage.
function wl_adaa(wl_x) instance(wl_xp, wl_Fp, wl_yp) local(wl_F, wl_yc, wl_d, wl_y) (     // (names differ by more than case: JSFX ignores case)
  wl_F = wl_sat_ad(wl_x);  wl_yc = wl_sat_f(wl_x);  wl_d = wl_x - wl_xp;
  abs(wl_d) < 0.00001 ? ( wl_y = wl_sat_f(0.5 * (wl_x + wl_xp)); ) : ( wl_y = (wl_F - wl_Fp) / wl_d; );
  wl_y += 0.5 * (wl_yc - wl_yp);
  wl_xp = wl_x;  wl_Fp = wl_F;  wl_yp = wl_yc;  wl_y;
);

// =====================================================================
// PRE — AR-70: discrete, transformer in and out
// =====================================================================
// INPUT LEVEL is real gain in 6 dB steps; OUTPUT trims after the stage, so the
// stage can be driven while the level sent on stays put (as on the original).
// Character: iron tightening on the lows, a soft forward top (+0.8 dB air),
// asymmetric colour that grows with level. DRIFT: supply sag + rail wander.
function wl_ar_tick(wl_x) instance(wl_ironlp, wl_ironsat, wl_stage, wl_dc, wl_air) local(wl_y, wl_lf, wl_s) (
  wl_y = wl_x * wl_ar_g;
  wl_lf = wl_ironlp.wl_op_lp(wl_y);
  wl_y  = (wl_y - wl_lf) + wl_ironsat.wl_adaa(wl_lf * wl_ar_ik) / wl_ar_ik;
  wl_s  = wl_y * wl_ar_kd;
  abs(wl_s) > wl_ar_pk ? ( wl_ar_pk = abs(wl_s); );
  wl_y = (wl_stage.wl_adaa(wl_s + wl_AR_BIAS) - wl_ar_bias_f) * wl_ar_nd;
  wl_y = wl_y - wl_dc.wl_op_lp(wl_y);
  wl_y = wl_y + 0.096 * (wl_y - wl_air.wl_op_lp(wl_y));            // ~+0.8 dB above ~9 kHz (TUNE)
  wl_y * wl_ar_post;
);

// =====================================================================
// EQ — VX-4: LF / HF stepped shelves, LMF / HMF bells with FOCUS,
// Bands at 0 dB are skipped. (No HPF or TRIM on this VX-4.)
// =====================================================================
function wl_vx_tick(wl_x) instance(wl_lf, wl_lm, wl_hm, wl_hf) local(wl_y) (
  wl_y = wl_x;
  wl_lf_on  ? ( wl_y = wl_lf.wl_f2_tick(wl_y); );
  wl_lmf_on ? ( wl_y = wl_lm.wl_f2_tick(wl_y); );
  wl_hmf_on ? ( wl_y = wl_hm.wl_f2_tick(wl_y); );
  wl_hf_on  ? ( wl_y = wl_hf.wl_f2_tick(wl_y); );
  wl_y;
);

// =====================================================================
// COMP — GB-2: VCA bus compressor, "dominant" stereo sidechain
// =====================================================================
// The louder of L/R (peak, full wave) drives one gain computer for both sides.
// The knee widens as the ratio drops. AUTO release: fast on transients, slow on
// sustained reduction. DRIFT: VCA threshold wander.
function wl_gb_run() local(wl_sl, wl_sr, wl_lvl, wl_ldb, wl_over, wl_hk, wl_gt, wl_c, wl_gg) (
  wl_sl = wl_aL;  wl_sr = wl_aR;
  wl_gb_hpf > 0 ? ( wl_sl = wl_scL.wl_f2_tick(wl_sl);  wl_sr = wl_scR.wl_f2_tick(wl_sr); );
  wl_lvl = max(abs(wl_sl), abs(wl_sr));
  wl_ldb = wl_lvl > 0.000001 ? 8.685889638065035 * log(wl_lvl) : -120;
  wl_over = wl_ldb - wl_gb_thr_d;
  wl_hk = wl_gb_knee * 0.5;
  wl_over <= -wl_hk ? ( wl_gt = 0; ) :
  wl_over >=  wl_hk ? ( wl_gt = wl_over * wl_gb_slope; ) :
                ( wl_gt = wl_gb_slope * sqr(wl_over + wl_hk) / (2 * wl_gb_knee); );
  wl_gt > wl_gb_gr ? ( wl_c = wl_gb_ac; ) : (
    wl_gb_rel == 4 ? ( wl_c = (wl_gb_gr - wl_gt) > 3 ? wl_gb_rc_fast : wl_gb_rc_slow; ) : ( wl_c = wl_gb_rc; );
  );
  wl_gb_gr += (wl_gt - wl_gb_gr) * wl_c;
  wl_gg = wl_db2g(wl_gb_mk - wl_gb_gr);
  wl_aL *= wl_gg;  wl_aR *= wl_gg;
  wl_gb_gr > wl_gb_gr_pk ? ( wl_gb_gr_pk = wl_gb_gr; );
);

// =====================================================================
// PRE B — SX-6: solid-state, VHD-style harmonics
// =====================================================================
// GAIN is continuous. VHD drives the stage harder and blends its colour from
// 2nd harmonic (low settings) to 3rd (high settings); level is held constant.
// HPF: 75 Hz, 12 dB/oct. No DRIFT (solid state).
function wl_sx_tick(wl_x) instance(wl_hp, wl_st2, wl_st3, wl_dc) local(wl_y, wl_s, wl_e2, wl_e3) (
  wl_y = wl_x * wl_sx_g;
  wl_sx_hpf ? ( wl_y = wl_hp.wl_f2_tick(wl_y); );
  wl_s = wl_y * wl_sx_kd;
  abs(wl_s) > wl_ar_pk ? ( wl_ar_pk = abs(wl_s); );
  wl_e2 = (wl_st2.wl_adaa(wl_s + wl_SX_BIAS) - wl_sx_bf) * wl_sx_n2;
  wl_e3 = wl_st3.wl_adaa(wl_s);
  wl_y = (wl_e2 + (wl_e3 - wl_e2) * wl_sx_mix) / wl_sx_kd;
  wl_y = wl_y - wl_dc.wl_op_lp(wl_y);
  wl_y * wl_sx_post;
);

// =====================================================================
// EQ B — MT-7: passive program EQ with tube make-up
// =====================================================================
// LF BOOST and ATTEN at one CPS: the atten shelf sits higher than the boost,
// so using both gives the classic bump with a dip above it. HF BOOST is a bell
// (BANDWIDTH sharp -> broad), HF ATTEN a shelf at 5 / 10 / 20 kHz.
// Controls at 0 are skipped; the tube stage always adds a little colour.
function wl_mt_tick(wl_x) instance(wl_lb, wl_la, wl_hb, wl_ha, wl_tube, wl_dc) local(wl_y) (
  wl_y = wl_x;
  wl_mt_lb_on ? ( wl_y = wl_lb.wl_f2_tick(wl_y); );
  wl_mt_la_on ? ( wl_y = wl_la.wl_f2_tick(wl_y); );
  wl_mt_hb_on ? ( wl_y = wl_hb.wl_f2_tick(wl_y); );
  wl_mt_ha_on ? ( wl_y = wl_ha.wl_f2_tick(wl_y); );
  wl_y = (wl_tube.wl_adaa(wl_y * wl_MT_K + wl_MT_BIAS) - wl_mt_bf) * wl_mt_nd;
  wl_y - wl_dc.wl_op_lp(wl_y);
);

// =====================================================================
// COMP B — VM-67: vari-mu tube compressor, linked stereo
// =====================================================================
// INPUT drives the tube (more gain = more colour), THRESHOLD sets where it
// starts. The ratio grows with the depth of compression (soft, program
// dependent). TIME CONSTANT: 6 positions; TC 5 and 6 release fast after
// transients and slow on sustained reduction. DRIFT: tube bias wander.
function wl_vm_run() local(wl_lvl, wl_ldb, wl_over, wl_o, wl_gt, wl_c, wl_gg) (
  wl_aL *= wl_vm_ig;  wl_aR *= wl_vm_ig;
  wl_lvl = max(abs(wl_aL), abs(wl_aR));
  wl_ldb = wl_lvl > 0.000001 ? 8.685889638065035 * log(wl_lvl) : -120;
  wl_over = wl_ldb - wl_vm_thr_d;
  wl_o = wl_over > 40 ? wl_over : 5 * log(1 + exp(wl_over / 5));     // soft knee
  wl_gt = wl_o * (1 - 1 / (1.5 + 0.2 * wl_o));                    // ratio climbs from 1.5:1 with depth
  wl_gt > wl_vm_gr ? ( wl_c = wl_vm_ac; ) : (
    wl_vm_auto ? ( wl_c = (wl_vm_gr - wl_gt) > 2 ? wl_vm_rc : wl_vm_rc_slow; ) : ( wl_c = wl_vm_rc; );
  );
  wl_vm_gr += (wl_gt - wl_vm_gr) * wl_c;
  wl_gg = wl_db2g(-wl_vm_gr) * wl_vm_kd;
  wl_aL = (wl_vtL.wl_adaa(wl_aL * wl_gg + wl_VM_BIAS) - wl_vm_bf) * wl_vm_nd;
  wl_aR = (wl_vtR.wl_adaa(wl_aR * wl_gg + wl_VM_BIAS) - wl_vm_bf) * wl_vm_nd;
  wl_aL = (wl_aL - wl_vdL.wl_op_lp(wl_aL)) * wl_vm_og;
  wl_aR = (wl_aR - wl_vdR.wl_op_lp(wl_aR)) * wl_vm_og;
  wl_vm_gr > wl_gb_gr_pk ? ( wl_gb_gr_pk = wl_vm_gr; );
);

// =====================================================================
// Pipeline
// =====================================================================
function wl_run_module(wl_m) local(wl_w, wl_dl, wl_dr) (
  wl_w = wl_mod_on[wl_m];
  wl_w > 0 ? (
    wl_dl = wl_aL;  wl_dr = wl_aR;
    wl_m == 0 ? ( wl_mdl_act & 1 ? ( wl_aL = wl_sxL.wl_sx_tick(wl_aL);  wl_aR = wl_sxR.wl_sx_tick(wl_aR); ) : ( wl_aL = wl_arL.wl_ar_tick(wl_aL);  wl_aR = wl_arR.wl_ar_tick(wl_aR); ); ) :
    wl_m == 1 ? ( wl_mdl_act & 2 ? ( wl_aL = wl_mtL.wl_mt_tick(wl_aL);  wl_aR = wl_mtR.wl_mt_tick(wl_aR); ) : ( wl_aL = wl_vxL.wl_vx_tick(wl_aL);  wl_aR = wl_vxR.wl_vx_tick(wl_aR); ); ) :
             ( wl_mdl_act & 4 ? wl_vm_run() : wl_gb_run(); );
    wl_w < 1 ? ( wl_aL = wl_dl + (wl_aL - wl_dl) * wl_w;  wl_aR = wl_dr + (wl_aR - wl_dr) * wl_w; );
  );
);

function wl_update_params() local(wl_i, wl_f, wl_q, wl_g) (
  wl_ord_new = wl_order;
  wl_route_new = wl_fxpost >= 0.5;
  wl_mdl_new = (wl_pre_model >= 0.5) + 2 * (wl_eq_model >= 0.5) + 4 * (wl_comp_model >= 0.5);   // bit per slot: 0 = A, 1 = B
  wl_mod_tgt[0] = wl_pre_on;  wl_mod_tgt[1] = wl_eq_on;  wl_mod_tgt[2] = wl_comp_on;

  // --- AR-70 ---
  wl_ar_g      = wl_db2g(wl_ar_gain);
  wl_ar_post   = wl_db2g(wl_ar_out);
  wl_ar_ik     = 0.12 + 0.012 * max(wl_ar_gain, 0);          // TUNE iron depth vs level
  wl_ar_bias_f = wl_sat_f(wl_AR_BIAS);
  wl_arL.wl_ironlp.wl_op_set(wl_AR_IRON);  wl_arR.wl_ironlp.wl_op_set(wl_AR_IRON);
  wl_arL.wl_dc.wl_op_set(8);            wl_arR.wl_dc.wl_op_set(8);
  wl_arL.wl_air.wl_op_set(9000);        wl_arR.wl_air.wl_op_set(9000);

  // --- VX-4 ---
  wl_lf_on  = wl_lf_g  != 0;  wl_hf_on  = wl_hf_g  != 0;
  wl_lmf_on = wl_lmf_g != 0;  wl_hmf_on = wl_hmf_g != 0;
  wl_vxL.wl_lf.wl_ls_set(wl_lff_tab[wl_lf_f], 0.71, wl_lf_g);   wl_vxR.wl_lf.wl_ls_set(wl_lff_tab[wl_lf_f], 0.71, wl_lf_g);
  wl_vxL.wl_hf.wl_hs_set(wl_hff_tab[wl_hf_f], 0.71, wl_hf_g);   wl_vxR.wl_hf.wl_hs_set(wl_hff_tab[wl_hf_f], 0.71, wl_hf_g);
  wl_q = wl_lmf_q * (wl_lmf_fc ? wl_FOCUS_Q : 1);  wl_g = wl_lmf_g * (wl_lmf_fc ? wl_FOCUS_G : 1);
  wl_vxL.wl_lm.wl_pk_set(wl_lmf_f, wl_q, wl_g);  wl_vxR.wl_lm.wl_pk_set(wl_lmf_f, wl_q, wl_g);
  wl_q = wl_hmf_q * (wl_hmf_fc ? wl_FOCUS_Q : 1);  wl_g = wl_hmf_g * (wl_hmf_fc ? wl_FOCUS_G : 1);
  wl_vxL.wl_hm.wl_pk_set(wl_hmf_f, wl_q, wl_g);  wl_vxR.wl_hm.wl_pk_set(wl_hmf_f, wl_q, wl_g);

  // --- GB-2 ---
  wl_gb_slope   = 1 - 1 / wl_rt_tab[wl_gb_ratio];
  wl_gb_knee    = wl_kn_tab[wl_gb_ratio];
  wl_gb_ac      = 1 - exp(-1000 / (wl_atk_tab[wl_gb_atk] * srate));
  wl_gb_rc      = 1 - exp(-1000 / (wl_rel_tab[min(3, wl_gb_rel)] * srate));
  wl_gb_rc_fast = 1 - exp(-1000 / (100 * srate));
  wl_gb_rc_slow = 1 - exp(-1000 / (1200 * srate));
  wl_f = wl_sch_tab[wl_gb_hpf];
  wl_gb_hpf > 0 ? ( wl_scL.wl_hp_set(wl_f, 0.71);  wl_scR.wl_hp_set(wl_f, 0.71); );

  // --- SX-6 ---
  wl_sx_g    = wl_db2g(wl_sx_gain);
  wl_sx_post = wl_db2g(wl_sx_out);
  wl_sx_kd   = wl_SX_K * (1 + 2.5 * wl_sx_vhd / 100);
  wl_sx_mix  = wl_sx_vhd / 100;
  wl_sx_bf   = wl_sat_f(wl_SX_BIAS);
  wl_sx_n2   = sqr(1 + wl_SX_BIAS);
  wl_sxL.wl_hp.wl_hp_set(75, 0.71);  wl_sxR.wl_hp.wl_hp_set(75, 0.71);
  wl_sxL.wl_dc.wl_op_set(8);         wl_sxR.wl_dc.wl_op_set(8);

  // --- MT-7 ---
  wl_mt_lb_on = wl_mt_lfb > 0;  wl_mt_la_on = wl_mt_lfa > 0;  wl_mt_hb_on = wl_mt_hfb > 0;  wl_mt_ha_on = wl_mt_hfa > 0;
  wl_f = wl_lfb_tab[wl_mt_lff];
  wl_mtL.wl_lb.wl_ls_set(wl_f, 0.55, wl_mt_lfb * 1.35);         wl_mtR.wl_lb.wl_ls_set(wl_f, 0.55, wl_mt_lfb * 1.35);         // up to +13.5 dB
  wl_mtL.wl_la.wl_ls_set(wl_f * 2.2, 0.5, -wl_mt_lfa * 1.75);   wl_mtR.wl_la.wl_ls_set(wl_f * 2.2, 0.5, -wl_mt_lfa * 1.75);   // up to -17.5 dB, higher corner
  wl_q = 2.5 * pow(0.16, (wl_mt_bw - 1) / 9);          // BANDWIDTH 1 = Q 2.5 (sharp) .. 10 = Q 0.4 (broad)
  wl_mtL.wl_hb.wl_pk_set(wl_hfb_tab[wl_mt_hff], wl_q, wl_mt_hfb * 1.6);  wl_mtR.wl_hb.wl_pk_set(wl_hfb_tab[wl_mt_hff], wl_q, wl_mt_hfb * 1.6);  // up to +16 dB
  wl_mtL.wl_ha.wl_hs_set(wl_haf_tab[wl_mt_haf], 0.6, -wl_mt_hfa * 1.6);  wl_mtR.wl_ha.wl_hs_set(wl_haf_tab[wl_mt_haf], 0.6, -wl_mt_hfa * 1.6);
  wl_mt_bf = wl_sat_f(wl_MT_BIAS);
  wl_mt_nd = sqr(1 + wl_MT_BIAS) / wl_MT_K;
  wl_mtL.wl_dc.wl_op_set(8);  wl_mtR.wl_dc.wl_op_set(8);

  // --- VM-67 ---
  wl_vm_ig  = wl_db2g(wl_vm_in);
  wl_vm_og  = wl_db2g(wl_vm_out);
  wl_vm_thr_db = -4 - 3 * wl_vm_thr;                     // THRESHOLD 0 = -4 dBFS .. 10 = -34 dBFS
  wl_vm_kd  = 0.14 + 0.008 * wl_vm_in;                   // more INPUT = more tube colour
  wl_vm_bf  = wl_sat_f(wl_VM_BIAS);
  wl_vm_nd  = sqr(1 + wl_VM_BIAS) / wl_vm_kd;
  wl_vm_ac  = 1 - exp(-1000 / (wl_tca_tab[wl_vm_tc] * srate));
  wl_vm_rc  = 1 - exp(-1000 / (wl_tcr_tab[wl_vm_tc] * srate));
  wl_vm_rc_slow = 1 - exp(-1000 / (10000 * srate));
  wl_vm_auto = wl_vm_tc >= 4;
  wl_vdL.wl_op_set(8);  wl_vdR.wl_op_set(8);

  // --- OUTPUT / DRIFT ---
  wl_out_t  = wl_db2g(wl_out_db);
  wl_out_sm = 1 - exp(-1 / (0.02 * srate));
  wl_drift_amt = wl_drift / 100;
  wl_sag_a = 1 - exp(-1000 / (30 * srate));
  wl_sag_r = 1 - exp(-1000 / (400 * srate));
  wl_ramp_step = 1 / (0.010 * srate);
  wl_fade_step = 1 / (0.004 * srate);

  wl_first_run ? (
    wl_i = 0;  loop(3, wl_mod_on[wl_i] = wl_mod_tgt[wl_i];  wl_i += 1; );
    wl_ord_act = wl_ord_new;  wl_mdl_act = wl_mdl_new;  wl_route_act = wl_route_new;  wl_out_s = wl_out_t;
    wl_first_run = 0;
  );
);
// the Wideload strip on (aL, aR): called from @sample where it sits (before or after the FX)
function wl_proc() (
wl_inpkL = max(wl_inpkL, abs(wl_aL));  wl_inpkR = max(wl_inpkR, abs(wl_aR));

// AR-70 DRIFT: sag on loud material + rail wander shrink the stage's headroom
wl_lvl = max(abs(wl_aL), abs(wl_aR));
wl_sag_env += (wl_lvl - wl_sag_env) * (wl_lvl > wl_sag_env ? wl_sag_a : wl_sag_r);
wl_sg = min(wl_sag_env, 1);
wl_ar_kd = wl_AR_K * (1 + wl_drift_amt * (0.12 * wl_dw + 0.6 * wl_sg));
wl_ar_nd = sqr(1 + wl_AR_BIAS) / wl_ar_kd;

wl_i = 0;
loop(3,
  wl_t = wl_mod_tgt[wl_i];  wl_v = wl_mod_on[wl_i];
  wl_v != wl_t ? ( wl_mod_on[wl_i] = wl_t > wl_v ? min(wl_t, wl_v + wl_ramp_step) : max(wl_t, wl_v - wl_ramp_step); );
  wl_i += 1;
);

wl_ord_dirty ? (
  wl_fade_g = max(0, wl_fade_g - wl_fade_step);
  wl_fade_g == 0 ? ( wl_ord_act = wl_ord_new;  wl_mdl_act = wl_mdl_new;  wl_route_act = wl_route_new;  wl_ord_dirty = 0; );
) : wl_fade_g < 1 ? ( wl_fade_g = min(1, wl_fade_g + wl_fade_step); );

wl_run_module(0);
wl_ord_act ? ( wl_run_module(2); wl_run_module(1); ) : ( wl_run_module(1); wl_run_module(2); );

wl_out_s += (wl_out_t - wl_out_s) * wl_out_sm;
wl_aL *= wl_out_s * wl_fade_g;
wl_aR *= wl_out_s * wl_fade_g;
wl_outpkL = max(wl_outpkL, abs(wl_aL));  wl_outpkR = max(wl_outpkR, abs(wl_aR));
);
wl_update_params();

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();
wl_update_params();

@block
prs_chk();
srate != mk_sr ? mk_srinit();
mk_treq > 0 && mk_treq != mk_tql ? ( mk_pre_dirty = mk_treq; mk_tql = mk_treq; );     // test hook
mk_pre_dirty > 0 ? ( load_preset(mk_pre_dirty); mk_pre_dirty = 0; );     // panel preset, loaded here
update();
// the Wideload strip (EDIT page)
// GUI edits arrive as a flag; parameters are only ever rebuilt on the audio thread
wl_prm_dirty ? ( wl_prm_dirty = 0;  wl_update_params(); );
wl_ord_dirty = wl_ord_new != wl_ord_act || wl_mdl_new != wl_mdl_act || wl_route_new != wl_route_act;   // ORDER or an A/B change: dip, swap, return
// DRIFT: slow rail wander (smoothed random walk)
wl_dw_t += samplesblock / srate;
wl_dw_t > 0.7 ? ( wl_dw_t = 0;  wl_dw_target = rand(2) - 1; );
wl_dw += (wl_dw_target - wl_dw) * (1 - exp(-samplesblock / (srate * 1.5)));
wl_gb_thr_d = wl_gb_thr + wl_drift_amt * 0.6 * wl_dw;             // GB-2: VCA threshold wander
wl_vm_thr_d = wl_vm_thr_db + wl_drift_amt * 0.8 * wl_dw;          // VM-67: tube bias wander
// meter hand-offs
wl_inL_d  = max(wl_inL_d,  wl_inpkL);   wl_inpkL = 0;   wl_inR_d  = max(wl_inR_d,  wl_inpkR);   wl_inpkR = 0;
wl_outL_d = max(wl_outL_d, wl_outpkL);  wl_outpkL = 0;  wl_outR_d = max(wl_outR_d, wl_outpkR);  wl_outpkR = 0;
wl_gr_d   = max(wl_gr_d, wl_gb_gr_pk);  wl_gb_gr_pk = 0;
wl_arpk_d = max(wl_arpk_d, wl_ar_pk);   wl_ar_pk = 0;
// MIDI is queued with its offset and played at the right sample in @sample (sample-accurate timing)
mk_qc = 0; mk_qi = 0; mk_spos = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, mk_chan) && mk_qc < 256 ? (
    mk_st = m1 & 0xF0;
    mk_qt = mk_st == 0x90 && m3 > 0 ? 1 : (mk_st == 0x80 || mk_st == 0x90) ? 0 :
            mk_st == 0xB0 && m2 == 64 ? 2 : mk_st == 0xB0 && (m2 == 123 || m2 == 120) ? 3 : -1;
    mk_qt >= 0 ? ( MKQO[mk_qc] = mofs; MKQT[mk_qc] = mk_qt; MKQN[mk_qc] = m2; MKQV[mk_qc] = m3; mk_qc += 1; );
    mk_qt == 1 ? ins_midi_hit();
  );
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( mk_qc < 256 ? ( MKQO[mk_qc] = 0; MKQT[mk_qc] = 3; MKQN[mk_qc] = 0; MKQV[mk_qc] = 0; mk_qc += 1; ); );
gfx_pst_prev = gfx_pst;
mk_drs += (mk_drift - mk_drs) * (1 - exp(-samplesblock / (0.3 * srate)));   // (the DRIFT amount glides: its offsets never jump)
ins_drift_block(mk_drs, samplesblock);
mk_ptch = ins_pitch ^ 0.2;                                 // the harp's tuning wanders only gently (+/-1 ct at 25 %)
mk_tset < 0 ? (
  // (first block / new sample rate: everything set at once, nothing to glide from)
  mk_tone(); mk_tset = 1; mk_ta = mk_amp; mk_tn = ins_tone; mk_swp = 0; mk_swr = mk_swg = 1;
  mk_drs = mk_drift; mk_d0 = mk_d0a = mk_d0t; mk_offs = mk_offa = mk_off0; mk_tk2s = mk_tk2; mk_tmx = mk_tk2 > 0.001; mk_mods = mk_mod;
  mf_chds = mf_chd; mf_vocs = mf_voct; mf_dfbs = mf_dfb; mf_rg = mf_rgt; mf_dt = mf_dtgl = mf_dtg = slider34;
) : (
  abs(mk_tn - ins_tone) > 0.01 ? ( mk_tcoil(); mk_tn = ins_tone; );
  mk_ta != mk_amp ? mk_swp = 1;                              // STAGE / SUITCASE: switched in @sample under a brief fade
);
// GAP / VOICING: glided per sample; while they move, the sounding voices re-normalise (on the 32-sample tick)
abs(mk_d0t - mk_d0) < 0.0000001 && abs(mk_d0t - mk_d0a) < 0.0000001 ? mk_d0 = mk_d0a = mk_d0t;
abs(mk_off0 - mk_offs) < 0.0000001 && abs(mk_off0 - mk_offa) < 0.0000001 ? mk_offs = mk_offa = mk_off0;
mk_d0 != mk_d0t || mk_offs != mk_off0 ? mk_gtl = floor(0.05 * srate) : mk_gtl = max(mk_gtl - samplesblock, 0);
mk_gmov = mk_gtl > 0;
mk_cutf = 1 + ins_cut * 0.05;

// per-voice: dampers (the felt lands over ~12 ms), pitch drift, freeing spent voices
mk_ramp = 1 - exp(-samplesblock / (0.012 * srate));
mk_nage = -1; mk_na = 0; mk_noff = mk_off0;
mk_i = 0;
loop(MKNV,
  mk_p = MKV + mk_i * MKVS;
  mk_p[0] ? (
    mk_p[5] ? (
      mk_q = mk_p + 40; mk_k = 0;
      loop(mk_p[20],
        mk_rt = mk_r((mk_p[31] ? 0.025 : mk_relt * mk_p[36]) * (mk_k ? 0.5 : 1));
        mk_q[9] < mk_rt ? mk_rt = mk_q[9];
        mk_q[9] += (mk_rt - mk_q[9]) * (mk_p[31] ? 1 : mk_ramp);
        mk_q += 10; mk_k += 1;
      );
      mk_rt = mk_r(mk_p[31] ? 0.025 : mk_relt * mk_p[36] * 2.5); mk_rt < mk_p[28] ? mk_p[28] += (mk_rt - mk_p[28]) * mk_ramp;
    );
    // stop computing the clink modes after 0.35 s and the bell once it has died away (zeroed so they restart clean)
    mk_p[121] += samplesblock;
    mk_n = mk_p[121] > mk_p[122] ? 1 : mk_p[121] > 0.35 * srate ? min(mk_p[20], 2) : mk_p[20];
    mk_n < mk_p[120] ? (
      mk_k = mk_n; loop(mk_p[120] - mk_n, mk_p[40 + 10 * mk_k] = mk_p[41 + 10 * mk_k] = 0; mk_k < 2 ? mk_p[102 + 8 * mk_k] = mk_p[103 + 8 * mk_k] = 0; mk_k += 1; );
      mk_p[120] = mk_n;
    );
    mk_p[38] = mk_offs * mk_p[133];                          // (follows VOICING)
    mk_p[17] = mk_p[38] * mk_cutf;                           // the pickup alignment breathes (DRIFT)
    mk_p[134] = mk_flux(mk_p[17], mk_p[118], mk_d0);         // rest flux now (for the GAP / VOICING glide)
    mk_gmov ? mk_norm(mk_p);
    mk_coefs(mk_p, mk_ptch);
    // level estimate: tip swing + tonebar
    mk_e = abs(mk_p[40] * mk_p[45]) + abs(mk_p[41] * mk_p[45]) + abs(mk_p[21] * mk_p[45]) + abs(mk_p[50] * mk_p[55]);
    mk_p[7] <= 0 && (mk_p[5] ? mk_e < 0.00003 : mk_e < 0.000003) ? mk_p[0] = 0;
    mk_p[2] >= mk_nage ? (
      mk_nage = mk_p[2];
      mk_q = mk_p + 40;
      mk_na = abs(mk_q[5]) * sqrt(max(mk_q[0] * mk_q[0] + mk_q[1] * mk_q[1] - 2 * mk_p[16] * mk_q[0] * mk_q[1], 0)) * mk_p[37];
      mk_noff = mk_p[17];
    );
  );
  mk_i += 1;
);
mf_dq = mf_dsync == 1 ? 1 : mf_dsync == 2 ? 0.75 : mf_dsync == 3 ? 0.5 : 2 / 3;
mf_dtg = mf_dsync > 0 && tempo > 0 ? min(1500, mf_dq * 60000 / tempo) : slider34;
// DELAY: a jump of the time (sync change, preset) is made under a brief fade of the echoes; a knob drag glides
abs(mf_dtg - mf_dtgl) > 0.2 * max(mf_dtgl, 1) ? mf_djp = 1; mf_dtgl = mf_dtg;
// a delay / space that has stopped is cleared when it starts again (no stale tail coming back)
(mf_dg > 0.0001 || mf_dlon) ? (
  mf_dlon && mf_dstop ? ( memset(MFDA, 0, MFDN); memset(MFDB, 0, MFDN); memset(MFVA + 30, 0, 8); mf_din = 0; mf_dh1 = mf_dh2 = 0; mf_dstop = 0; mf_dt = mf_dtg; mf_djp = 0; mf_dkr = 1; );
) : ( mf_dstop = 1; mf_dt = mf_dtg; mf_djp = 0; mf_dkr = 1; );
(mf_sg > 0.0001 || mf_spon) ? (
  mf_spon && mf_sstop ? ( memset(MFR, 0, 4 * MFRN); mf_z0 = mf_z1 = mf_z2 = mf_z3 = 0; mf_sstop = 0; mf_ssw = 0; mf_skr = 1;
    mf_stya != mf_sty ? ( mf_stya = mf_sty; mf_sparams(mf_stya); ); mf_rg = mf_rgt; );
  mf_stya != mf_sty ? mf_ssw = 1;                            // SPACE type: switched in @sample under a brief fade
) : ( mf_sstop = 1; mf_ssw = 0; mf_skr = 1; mf_stya != mf_sty ? ( mf_stya = mf_sty; mf_sparams(mf_stya); ); mf_rg = mf_rgt; );
mf_dlen = floor(min(1.6 * srate, MFDN - 8));
mk_ga = mk_na; mk_goff = mk_noff;                          // for the panel's pickup window
mk_lpinc = mk_rate * (1 + 0.04 * ins_fx) / srate;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
while (mk_qi < mk_qc && (MKQO[mk_qi] <= mk_spos || mk_spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  mk_qt = MKQT[mk_qi];
  mk_qt == 1 ? ( mk_note_on(MKQN[mk_qi], MKQV[mk_qi]); mf_ghold = mf_ghl; ) :
  mk_qt == 0 ? mk_note_off(MKQN[mk_qi]) :
  mk_qt == 2 ? ( mk_pedal = MKQV[mk_qi] >= 64; !mk_pedal ? mk_pedal_up(); ) :
  mk_all_off();
  mk_qi += 1;
);
mk_spos += 1;
mk_L0 = mk_L1 = mk_R0 = mk_R1 = 0; mk_th = 0; mk_rsum = 0;
mk_T = 1 / srate;
mk_tk += 1; mk_tick = mk_tk >= 32; mk_tick ? mk_tk = 0;
// GAP / VOICING glide (2 x 15 ms)
// (two cascaded one-poles: the glide starts and ends with zero speed, so the tine's voltage never switches on abruptly)
mk_gmov ? ( mk_d0a += (mk_d0t - mk_d0a) * mk_gk; mk_d0 += (mk_d0a - mk_d0) * mk_gk; mk_offa += (mk_off0 - mk_offa) * mk_gk; mk_offs += (mk_offa - mk_offs) * mk_gk; );
mk_p = MKV;
loop(MKNV,
  mk_p[0] ? (
    mk_tick ? mk_drag(mk_p);
    mk_gmov ? (
      mk_tick ? mk_norm(mk_p);
      mk_p[18] += (mk_p[130] - mk_p[18]) * mk_nk; mk_p[124] += (mk_p[131] - mk_p[124]) * mk_nk; mk_p[101] += (mk_p[132] - mk_p[101]) * mk_nk;
    );
    // ----- the hammer (only while it is near the tine) -----
    mk_F = 0;
    mk_p[7] > 0 ? (
      mk_xs = 0; mk_q = mk_p + 40; mk_k = 0;
      loop(mk_p[20], mk_xs += mk_p[90 + mk_k] * mk_q[0]; mk_q += 10; mk_k += 1; );
      mk_c = mk_p[8] - mk_xs;
      mk_c > 0 ? (
        mk_cd = mk_p[9] - (mk_xs - mk_p[34]) * srate;
        mk_F = mk_p[11] * mk_c ^ mk_p[12] * (1 + mk_p[13] * mk_cd);
        mk_F < 0 ? mk_F = 0;
      );
      mk_p[34] = mk_xs;
      mk_p[9] -= mk_F * mk_p[10];
      mk_p[8] += mk_p[9] * mk_T;
      mk_p[7] -= 1;
      mk_th += mk_F * mk_p[29];
    );
    // ----- tonebar and tine fundamental, coupled -----
    mk_q = mk_p + 40;
    mk_cp = mk_q[0] - mk_p[21];
    mk_y = mk_p[23] * mk_p[21] - mk_p[24] * mk_p[22] + mk_p[25] * mk_cp;
    mk_p[22] = mk_p[21]; mk_p[21] = mk_y;
    mk_y = mk_q[2] * mk_q[0] - mk_q[3] * mk_q[1] + mk_q[4] * mk_F - mk_p[26] * mk_cp + (mk_p[5] ? 0 : mk_p[33] * (mk_rail - mk_p[32]));
    mk_xm = mk_q[6] * mk_y + mk_q[7] * mk_q[0];
    mk_q[1] = mk_q[0]; mk_q[0] = mk_y;
    mk_xt = mk_q[5] * mk_y;
    // ----- the higher tine modes: 1 = the bell, 2 - 4 = the clink -----
    mk_xh = 0; mk_k = 0;
    mk_bf = 0;
    mk_p[126] < mk_p[127] ? ( mk_bf = mk_p[128] * (1 - cos(2 * $pi * (mk_p[126] + 0.5) / mk_p[127])); mk_p[126] += 1; );
    loop(mk_p[120] - 1,
      mk_q += 10; mk_k += 1;
      mk_y = mk_q[2] * mk_q[0] - mk_q[3] * mk_q[1] + mk_q[4] * mk_F + (mk_k == 1 ? mk_bf : 0);
      mk_xm += mk_q[6] * mk_y + mk_q[7] * mk_q[0];
      mk_q[1] = mk_q[0]; mk_q[0] = mk_y;
      mk_xt += mk_q[5] * mk_y;
      mk_k > 1 ? mk_xh += mk_q[5] * mk_y;
    );
    // the clink: the short bright high modes also heard directly (the hammer tick), velocity-shaped by the contact
    mk_p[120] > 2 ? ( mk_ck = (mk_xh - mk_p[100]) * mk_p[101] * 0.5; mk_p[100] = mk_xh; ) : mk_ck = 0;
    mk_p[137] += (mk_ck - mk_p[137]) * mk_cklp; mk_ck = mk_p[137];   // (rounded off above ~7 kHz: no click)
    // ----- the horizontal polarisations (fundamental, bell) -----
    mk_q = mk_p + 102;
    mk_y = mk_q[2] * mk_q[0] - mk_q[3] * mk_q[1] + mk_q[4] * mk_F;
    mk_ym = mk_q[5] * mk_y + mk_q[6] * mk_q[0]; mk_q[1] = mk_q[0]; mk_q[0] = mk_y; mk_yt = mk_p[45] * mk_y;
    mk_p[120] > 1 ? (
      mk_q += 8;
      mk_y = mk_q[2] * mk_q[0] - mk_q[3] * mk_q[1] + mk_q[4] * mk_F + mk_bf * 0.15 * mk_thor;
      mk_ym += mk_q[5] * mk_y + mk_q[6] * mk_q[0]; mk_q[1] = mk_q[0]; mk_q[0] = mk_y; mk_yt += mk_p[55] * mk_y;
    );
    // ----- the pickup at 2x: the 2D tip position against the pole (on its circle about the clamp), flux, d/dt -----
    mk_ox = mk_gmov ? mk_offs * mk_p[133] * mk_cutf : mk_p[17]; mk_oy = mk_p[118]; mk_ic = mk_p[119]; mk_nr = mk_p[18];
    mk_x = mk_xm + mk_ox; mk_yy = mk_ym + mk_oy; mk_dz = mk_d0 - (mk_xm * mk_xm + mk_ym * mk_ym) * mk_ic;
    mk_s = 1 / (mk_x * mk_x + mk_yy * mk_yy + mk_dz * mk_dz + mk_a2); mk_flm = mk_dz * mk_s * sqrt(mk_s);
    mk_x = mk_xt + mk_ox; mk_yy = mk_yt + mk_oy; mk_dz = mk_d0 - (mk_xt * mk_xt + mk_yt * mk_yt) * mk_ic;
    mk_s = 1 / (mk_x * mk_x + mk_yy * mk_yy + mk_dz * mk_dz + mk_a2); mk_fl = mk_dz * mk_s * sqrt(mk_s);
    mk_o0 = (mk_flm - mk_p[19]) * mk_nr; mk_o1 = (mk_fl - mk_flm) * mk_nr;
    mk_gmov ? (
      // while the geometry glides, the flux at the tine's rest moves too: that step is not the tine's voltage
      mk_s = 1 / (mk_ox * mk_ox + mk_oy * mk_oy + mk_d0 * mk_d0 + mk_a2); mk_fr = mk_d0 * mk_s * sqrt(mk_s);
      mk_o0 -= (mk_fr - mk_p[134]) * mk_nr; mk_p[134] = mk_fr;
    );
    mk_p[19] = mk_fl;
    mk_p[32] = mk_o1; mk_rsum += mk_o1;
    mk_p[120] > 1 ? mk_ck += 0.5 * (mk_p[50] - mk_p[51]) * mk_p[124];
    mk_o0 += mk_ck; mk_o1 += mk_ck;
    mk_L0 += mk_o0 * mk_p[14]; mk_L1 += mk_o1 * mk_p[14];
    mk_R0 += mk_o0 * mk_p[15]; mk_R1 += mk_o1 * mk_p[15];
  );
  mk_p += MKVS;
);
mk_rail = mk_rsum;

// ---------- decimate the 2x pickup signal ----------
MKHL[mk_hw] = mk_L0; MKHR[mk_hw] = mk_R0; mk_hw = (mk_hw + 1) & 63;
MKHL[mk_hw] = mk_L1; MKHR[mk_hw] = mk_R1;
mk_l = mk_hb(MKHL, mk_hw); mk_r_ = mk_hb(MKHR, mk_hw);
mk_hw = (mk_hw + 1) & 63;

// ---------- mechanism: hammer thump and click, key-off knock (centred) ----------
mk_kn > 0.0000001 ? ( mk_kx = (rand(2) - 1) * mk_kn; mk_kn *= mk_knd; ) : ( mk_kx = 0; mk_kn = 0; );
mk_mx = mk_tq.bq_run(mk_th + mk_kx * 0.3) + mk_tc2.bq_run(mk_tc.bq_run(mk_th)) * 0.2 + mk_kq.bq_run(mk_kx);
mk_l += mk_mx; mk_r_ += mk_mx;

// ---------- pickup coil load ----------
mk_adn = -mk_adn;                                            // a tiny alternating offset keeps the filters out of denormals
mk_l = mk_cl.bq_run(mk_l + mk_adn); mk_r_ = mk_cr.bq_run(mk_r_ + mk_adn);
mk_tiv > 0 ? ( mk_tic = (mk_tic + 1) % 16384; mk_tic == 0 ? ( mk_l += mk_tiv; mk_r_ += mk_tiv; ); );   // test hook: an impulse into the amp
mk_tsv > 0 ? ( mk_tsp += 261.63 / srate; mk_tsp -= floor(mk_tsp); mk_l += mk_tsv * sin(2 * $pi * mk_tsp); mk_r_ += mk_tsv * sin(2 * $pi * mk_tsp); );   // test hook: a sine into the amp

// ---------- TAME: a dynamic control of the top end (above ~2.8 kHz only) ----------
// the band above the split is followed by an envelope; as it rises past a threshold the band is turned down and
// softly bias-saturated, so hard, bright, bell-heavy or dyno-voiced playing rounds off instead of clanging.
// Its strength follows HARDNESS, BELL and VOICING (zero for soft, mellow settings); velocity drives the envelope.
// (its strength glides, and the split is cross-faded in and out over 20 ms as it engages / disengages)
mk_tk2s += (mk_tk2 - mk_tk2s) * mk_gk2;
mk_tmx += ((mk_tk2 > 0.001) - mk_tmx) * mk_gk2; mk_tmx > 0.99999 ? mk_tmx = 1 : mk_tmx < 0.00001 ? mk_tmx = 0;
mk_tmx > 0 ? (
  // Linkwitz-Riley 4th-order split: the top band holds nothing of the fundamentals, so its gain cannot move them
  mk_lo1 = mk_tsl2.bq_run(mk_tsl.bq_run(mk_l)); mk_lo2 = mk_tsr2.bq_run(mk_tsr.bq_run(mk_r_));
  mk_hi1 = mk_thl2.bq_run(mk_thl.bq_run(mk_l)); mk_hi2 = mk_thr2.bq_run(mk_thr.bq_run(mk_r_));
  mk_e = max(abs(mk_hi1), abs(mk_hi2));
  mk_ten += (mk_e - mk_ten) * (mk_e > mk_ten ? mk_tat : mk_trl);
  mk_g = 1 / (1 + 0.5 * mk_tk2s * max(mk_ten - mk_tth, 0) / mk_tth); mk_g = max(mk_g, 0.35);
  // (a gain on the top band only: no saturation, so no intermodulation reaches the low range and the pitch never
  // follows the dynamics; with the gain at 1 the two bands sum back to the input, phase-shifted only)
  mk_tmx < 1 ? (
    mk_l += mk_tmx * (mk_lo1 + mk_g * mk_hi1 - mk_l); mk_r_ += mk_tmx * (mk_lo2 + mk_g * mk_hi2 - mk_r_);
  ) : (
    mk_l = mk_lo1 + mk_g * mk_hi1; mk_r_ = mk_lo2 + mk_g * mk_hi2;
  );
  mk_tgr = mk_g;
) : ( mk_tgr = 1; );

// ---------- AMP (a) tone stack before the gain stage ----------
mk_l = mk_a1l.bq_run(mk_l); mk_r_ = mk_a1r.bq_run(mk_r_);
mk_l = mk_a2l.bq_run(mk_l); mk_r_ = mk_a2r.bq_run(mk_r_);
mk_l = mk_a3l.bq_run(mk_l); mk_r_ = mk_a3r.bq_run(mk_r_);
// ---------- AMP (b) asymmetric waveshaping with bias (OVERDRIVE drives it) ----------
// (OVERDRIVE and TREBLE glide on the 32-sample tick, the drive gains are interpolated between ticks)
mk_tick ? (
  mk_ods != mk_od ? ( mk_ods += (mk_od - mk_ods) * mk_k32; abs(mk_od - mk_ods) < 0.00005 ? mk_ods = mk_od; mk_drv(); );
  mk_trs != mk_treb ? ( mk_trs += (mk_treb - mk_trs) * mk_k32; abs(mk_treb - mk_trs) < 0.002 ? mk_trs = mk_treb; mk_ttreb(); );
);
mk_dgs += (mk_dg - mk_dgs) * mk_nk; mk_dns += (mk_dn - mk_dns) * mk_nk;
mk_l = (vo_tanh(mk_dgs * mk_l + mk_bias) - mk_bt) * mk_dns;
mk_r_ = (vo_tanh(mk_dgs * mk_r_ + mk_bias) - mk_bt) * mk_dns;

// ---------- MODULATION: right = tremolo, left = stereo auto-pan, through bulbs and photocells ----------
// the LFO lights an incandescent bulb (the filament heats faster than it cools), its light sets a photocell's
// conductance: a smooth, slightly rounded swell rather than a clean sine VCA
mk_lph += mk_lpinc; mk_lph >= 1 ? mk_lph -= 1;
mk_ls = 0.5 + 0.5 * sin(2 * $pi * mk_lph);
mk_bu1 += (mk_ls - mk_bu1) * (mk_ls > mk_bu1 ? mk_bh : mk_bc);
mk_bu2 += ((1 - mk_ls) - mk_bu2) * ((1 - mk_ls) > mk_bu2 ? mk_bh : mk_bc);
mk_pc1 = (mk_bu1 * mk_bu1) ^ 0.7; mk_pc2 = (mk_bu2 * mk_bu2) ^ 0.7;      // light ~ T^2, photocell law ~ light^0.7
mk_mods != mk_mod ? ( mk_mods += (mk_mod - mk_mods) * mk_gk2; abs(mk_mod - mk_mods) < 0.000001 ? mk_mods = mk_mod; );   // (glides through 0 between pan and trem)
mk_mods > 0 ? ( mk_g = 1 - mk_mods * mk_pc1; mk_l *= mk_g; mk_r_ *= mk_g; ) :
mk_mods < 0 ? ( mk_g = -mk_mods; mk_l *= (1 - mk_g * mk_pc1) * (1 + 0.3 * mk_g); mk_r_ *= (1 - mk_g * mk_pc2) * (1 + 0.3 * mk_g); );

// ---------- AMP (c) speaker / cabinet ----------
mk_l = mk_c1l.bq_run(mk_l); mk_r_ = mk_c1r.bq_run(mk_r_);
mk_l = mk_c2l.bq_run(mk_l); mk_r_ = mk_c2r.bq_run(mk_r_);
mk_l = mk_c3l.bq_run(mk_l); mk_r_ = mk_c3r.bq_run(mk_r_);
mk_l = mk_c4l.bq_run(mk_l); mk_r_ = mk_c4r.bq_run(mk_r_);
// ---------- TREBLE ----------
mk_l = mk_tbl.bq_run(mk_l); mk_r_ = mk_tbr.bq_run(mk_r_);
// STAGE <-> SUITCASE: the amp is faded out (12 ms), switched, and faded back in (20 ms); the FX tails ring on
(mk_swp || mk_swr < 1) ? (
  mk_swp ? (
    mk_swr -= mk_swdn;
    mk_swr <= 0 ? ( mk_swr = 0; mk_tamp(); mk_drv(); mk_dgs = mk_dg; mk_dns = mk_dn; mk_ta = mk_amp; mk_swp = 0; );
  ) : mk_swr = min(1, mk_swr + mk_swup);
  mk_swg = 0.5 - 0.5 * cos($pi * mk_swr);
  mk_l *= mk_swg; mk_r_ *= mk_swg;
);

// the Wideload strip, PRE: before the FX
wl_route_act == 0 ? ( wl_aL = mk_l; wl_aR = mk_r_; wl_proc(); mk_l = wl_aL; mk_r_ = wl_aR; );

// ---------- FX: CHORUS, VIBE, DELAY, SPACE (each fades in and out, and is skipped while off) ----------
mf_cg += ((mf_chon * 1) - mf_cg) * mf_gsm; mf_vg += (mf_vbon * mf_vwet - mf_vg) * mf_gsm;
mf_dg += (mf_dlon * mf_dmix - mf_dg) * mf_gsm; mf_sg += (mf_spon * mf_sam - mf_sg) * mf_gsm;
mf_chds += (mf_chd - mf_chds) * mf_gsm2; mf_vocs += (mf_voct - mf_vocs) * mf_gsm2;   // (depths glide: no jumps of the delay taps)
mf_cpl += mf_cpc * (mk_l - mf_cpl); mf_cpr += mf_cpc * (mk_r_ - mf_cpr);
MFCA[mf_cw] = mf_cpl; MFCB[mf_cw] = mf_cpr;
mf_cg > 0.0001 ? (
  mf_cph += mf_chr / srate; mf_cph -= floor(mf_cph);
  mf_wl = mf_read(MFCA, MFCN, mf_cw - (8 + mf_chds * sin(2 * $pi * mf_cph)) * srate * 0.001);
  mf_wr = mf_read(MFCB, MFCN, mf_cw - (8 + mf_chds * sin(2 * $pi * (mf_cph + 0.25))) * srate * 0.001);
  mk_l += mf_cg * (0.6 * mf_wl - 0.15 * mk_l); mk_r_ += mf_cg * (0.6 * mf_wr - 0.15 * mk_r_);
);
mf_cw = (mf_cw + 1) & (MFCN - 1);
mf_vg > 0.0001 ? (
  mf_vt += 1; mf_vtk = mf_vt >= 8; mf_vtk ? mf_vt = 0;
  mf_vph += mf_vbr / srate; mf_vph -= floor(mf_vph);
  mk_l += mf_vg * mf_vibe(mk_l, 0, MFVA, mf_vtk); mk_r_ += mf_vg * mf_vibe(mk_r_, 0.25, MFVB, mf_vtk);
);
mf_vmk += ((mf_vbon ? 1.122 : 1) - mf_vmk) * mf_gsm; mk_l *= mf_vmk; mk_r_ *= mf_vmk;   // VIBE: +1 dB to make up its loss
(mf_dg > 0.0001 || mf_dlon) ? (
  // a jump of the time: the echoes (and what they feed back) fade out over 12 ms, the taps move, then fade back in
  mf_djp ? (
    mf_dkr -= mk_swdn; mf_dkr <= 0 ? ( mf_dkr = 0; mf_dt = mf_dtg; mf_djp = 0; );
  ) : (
    mf_dkr < 1 ? mf_dkr = min(1, mf_dkr + mk_swup);
    mf_dt += mf_dts * (mf_dtg - mf_dt);
  );
  mf_dsm = max(2, min(mf_dlen - 4, mf_dt * srate * 0.001));
  mf_ya = mf_read(MFDA, mf_dlen, mf_dw - mf_dsm); mf_yb = mf_read(MFDB, mf_dlen, mf_dw - mf_dsm);
  mf_dkr < 1 ? ( mf_dkg = 0.5 - 0.5 * cos($pi * mf_dkr); mf_ya *= mf_dkg; mf_yb *= mf_dkg; );
  mf_din += (mf_dlon - mf_din) * mf_gsm; mf_dfbs += (mf_dfb - mf_dfbs) * mf_gsm;   // (input fade, feedback glide)
  // the input is high-passed (~300 Hz, 12 dB/oct) so the echoes carry the tone, not the attack's thump
  mf_dix = 0.5 * (mk_l + mk_r_); mf_dh1 += (mf_dix - mf_dh1) * mf_dihc; mf_dix -= mf_dh1; mf_dh2 += (mf_dix - mf_dh2) * mf_dihc; mf_dix -= mf_dh2;
  MFDA[mf_dw] = mf_din * mf_dix + mf_dloop(mf_yb, MFVA + 30);   // in on the left, then across: ping-pong
  MFDB[mf_dw] = mf_dloop(mf_ya, MFVA + 34);
  mk_l += mf_dg * mf_ya; mk_r_ += mf_dg * mf_yb;
  mf_dw += 1; mf_dw >= mf_dlen ? mf_dw = 0;
);
(mf_sg > 0.0001 || mf_spon) ? (
  // a new type: the tank fades out (12 ms), is cleared and re-sized, and fades back in (20 ms)
  mf_ssw ? (
    mf_skr -= mk_swdn;
    mf_skr <= 0 ? ( mf_skr = 0; mf_stya = mf_sty; mf_sparams(mf_stya); mf_rg = mf_rgt; memset(MFR, 0, 4 * MFRN); mf_z0 = mf_z1 = mf_z2 = mf_z3 = 0; mf_ssw = 0; );
  ) : mf_skr < 1 ? mf_skr = min(1, mf_skr + mk_swup);
  mf_skg = mf_skr < 1 ? 0.5 - 0.5 * cos($pi * mf_skr) : 1;
  mf_rg += (mf_rgt - mf_rg) * mf_gsm;
  mf_q0 = MFR[(mf_rw - mf_l0) & MFRM]; mf_q1 = MFR[MFRN + ((mf_rw - mf_l1) & MFRM)];
  mf_q2 = MFR[2 * MFRN + ((mf_rw - mf_l2) & MFRM)]; mf_q3 = MFR[3 * MFRN + ((mf_rw - mf_l3) & MFRM)];
  mf_z0 += (mf_q0 - mf_z0) * mf_slp; mf_z1 += (mf_q1 - mf_z1) * mf_slp; mf_z2 += (mf_q2 - mf_z2) * mf_slp; mf_z3 += (mf_q3 - mf_z3) * mf_slp;
  mf_qin = 0.5 * (mk_l + mk_r_) * mf_sg * 0.45;
  MFR[mf_rw]             = mf_qin + 0.5 * mf_rg * (mf_z0 + mf_z1 + mf_z2 + mf_z3);
  MFR[MFRN + mf_rw]      = mf_qin + 0.5 * mf_rg * (mf_z0 - mf_z1 + mf_z2 - mf_z3);
  MFR[2 * MFRN + mf_rw]  = mf_qin + 0.5 * mf_rg * (mf_z0 + mf_z1 - mf_z2 - mf_z3);
  MFR[3 * MFRN + mf_rw]  = mf_qin + 0.5 * mf_rg * (mf_z0 - mf_z1 - mf_z2 + mf_z3);
  mf_ghold -= 1; mf_gt = mf_ghold > 0; mf_gs += (mf_gt - mf_gs) * (mf_gt ? 0.01 : mf_grl);
  mf_gm = (mf_stya == 2 ? mf_gs : 1) * mf_slv * mf_skg;
  mk_l += mf_sg * (mf_z0 - mf_z2) * 0.7 * mf_gm; mk_r_ += mf_sg * (mf_z1 - mf_z3) * 0.7 * mf_gm;
  mf_rw = (mf_rw + 1) & MFRM;
);

// the Wideload strip, POST: after the FX
wl_route_act == 1 ? ( wl_aL = mk_l; wl_aR = mk_r_; wl_proc(); mk_l = wl_aL; mk_r_ = wl_aR; );

// ---------- master ----------
mk_vol += (mk_volt - mk_vol) * mk_sm;
mk_l *= mk_vol; mk_r_ *= mk_vol;
mk_dcyl = mk_l - mk_dcxl + 0.9995 * mk_dcyl; mk_dcxl = mk_l; mk_l = mk_dcyl;
mk_dcyr = mk_r_ - mk_dcxr + 0.9995 * mk_dcyr; mk_dcxr = mk_r_; mk_r_ = mk_dcyr;
// the bus: a soft knee above -6 dBFS that never passes -1 dBFS
mk_e = abs(mk_l); mk_e > 0.5 ? mk_l = sign(mk_l) * (0.5 + 0.39 * vo_tanh((mk_e - 0.5) * 2.564));
mk_e = abs(mk_r_); mk_e > 0.5 ? mk_r_ = sign(mk_r_) * (0.5 + 0.39 * vo_tanh((mk_e - 0.5) * 2.564));
mk_l = ostL.ost_band(mk_l); mk_r_ = ostR.ost_band(mk_r_);
ost_out(mk_l, mk_r_);
spl0 = ost_l; spl1 = ost_r;
mk_pk_disp = max(mk_pk_disp, max(abs(spl0), abs(spl1)));

@gfx 1100 690
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
// (functions first: EEL2 does not allow a function inside a block)
function mg_fontok(name) local(w0, h0, w1, h1) (
  gfx_setfont(15, "GFX-no-such-font", 20, 0); gfx_measurestr("WIDELOAD 0123", w0, h0);
  gfx_setfont(15, name, 20, 0);               gfx_measurestr("WIDELOAD 0123", w1, h1);
  abs(w1 - w0) > 0.5;
);
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function mg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function mg_ct(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function mg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function mg_screw(x, y) local(sx, sy, sr) (
  sx = x * sc; sy = y * sc; sr = 6 * sc;
  ui_cola(0x000000, 0.3); gfx_circle(sx + 1 * sc, sy + 1.5 * sc, sr, 1, 1);
  ui_col(0x8E887A); gfx_circle(sx, sy, sr, 1, 1);
  ui_col(0xC9C0A8); gfx_arc(sx, sy, sr - 1 * sc, -1.9, -0.3, 1);
  ui_col(0x2E2B24); gfx_line(sx - sr * 0.55, sy, sx + sr * 0.55, sy, 1); gfx_line(sx, sy - sr * 0.55, sx, sy + sr * 0.55, 1);
);
function mg_fin(f) (
  f == 1 ? ( mg_pc = 0x3B3A2C; mg_pi = 0x14130E; mg_hc = 0x14130E; mg_ha = 1;    mg_tc = 0xC9B98A; mg_np = 0x4A4936; ) :
  f == 2 ? ( mg_pc = 0x2B2420; mg_pi = 0xD9CBA3; mg_hc = 0xD9CBA3; mg_ha = 0.35; mg_tc = 0xD9CBA3; mg_np = 0x3A302A; ) :
  f == 3 ? ( mg_pc = 0xD6C79C; mg_pi = 0x2A2018; mg_hc = 0x2A2018; mg_ha = 0.8;  mg_tc = 0x2A2018; mg_np = 0xE6D9B2; ) :
  f == 4 ? ( mg_pc = 0x3A4246; mg_pi = 0xD9CBA3; mg_hc = 0xD9CBA3; mg_ha = 0.3;  mg_tc = 0xD9CBA3; mg_np = 0x485256; ) :
  f == 5 ? ( mg_pc = 0x2E302C; mg_pi = 0x0E0F0D; mg_hc = 0x0E0F0D; mg_ha = 1;    mg_tc = 0xD6CDB0; mg_np = 0x3E413B; ) :
           ( mg_pc = 0x45443C; mg_pi = 0x14130E; mg_hc = 0xD6C79C; mg_ha = 0.22; mg_tc = 0xD6C79C; mg_np = 0x55544A; );
  mg_red = mg_pc; dy_ink = mg_tc; mg_dim = mg_tc; dy_bg = mg_pc;
);
function mg_unit(x, y, w, h, f) local(sx, sy, sw, sh, i, k) (
  mg_fin(f); mg_ux = x;
  sx = x * sc; sy = y * sc; sw = w * sc; sh = h * sc;
  i = 1; loop(4, ui_cola(0x000000, 0.13); ui_rrs(sx + (1 + i) * sc, sy + (1 + i * 1.5) * sc, sw + i * sc, sh + i * sc, (8 + i) * sc); i += 1; );
  ui_col(mg_pc); ui_rrs(sx, sy, sw, sh, 8 * sc);
  ui_cola(mg_hc, mg_ha);
  k = sy + 10 * sc + 11 * sc; while (k <= sy + sh - 12 * sc) ( gfx_line(sx + sw - 12 * sc, k, sx + sw - 1 * sc, k - 11 * sc, 1); k += 4 * sc; );
  k = sx + 10 * sc; while (k <= sx + sw - 23 * sc) ( gfx_line(k, sy + sh - 1 * sc, k + 11 * sc, sy + sh - 12 * sc, 1); k += 4 * sc; );
  ui_col(mg_pi); k = 0; loop(max(1, floor(2 * sc + 0.5)), gfx_roundrect(sx + k, sy + k, sw - 2 * k, sh - 2 * k, max(1, 8 * sc - k), 1); k += 1; );
  mg_screw(x + 12, y + 12); mg_screw(x + w - 24, y + 12); mg_screw(x + 12, y + h - 12); mg_screw(x + w - 24, y + h - 12);
);
function mg_sect(x, y, w, h, f, title) local(tw, th, nx, ny, nw, nh) (
  x > mg_ux + 4 ? (
    ui_cola(mg_pi, 0.85); mg_r(x - 8, y + 10, 2, h - 26);
    ui_cola(f == 3 ? 0xFFFFFF : mg_tc, f == 3 ? 0.45 : 0.18); mg_r(x - 6, y + 10, 1, h - 26);
  );
  strlen(title) ? (
  gfx_setfont(10); gfx_measurestr(title, tw, th);
  nw = tw + 22 * sc; nh = th + 6 * sc; nx = (x + (x > mg_ux + 4 ? 10 : 30)) * sc; ny = (y + mg_tyo) * sc - nh * 0.5;
  mg_nright > 0 ? ( nx = mg_nright * sc - nw; mg_nright = 0; );    // a name plate set flush right
  ui_cola(0xFFFFFF, 0.14); ui_rrs(nx - 2 * sc, ny - 2 * sc, nw + 4 * sc, nh + 4 * sc, 3 * sc);
  ui_cola(0x000000, 0.55); ui_rrs(nx - 2 * sc, ny - 2 * sc, nw + 2.5 * sc, nh + 2.5 * sc, 3 * sc);
  ui_col(ui_mix(mg_np, 0x000000, 0.2)); ui_rrs(nx, ny, nw, nh, 2 * sc);
  ui_cola(0x000000, 0.32); gfx_rect(nx + 1 * sc, ny, nw - 2 * sc, 3 * sc); gfx_rect(nx, ny + 1 * sc, 2.5 * sc, nh - 2 * sc);
  f != 3 ? ( ui_cola(0x000000, 0.45); gfx_x = nx + 11 * sc - 1 * sc; gfx_y = ny + (nh - th) * 0.5 - 1 * sc; gfx_drawstr(title); );
  ui_col(f == 3 ? 0x4A2A16 : mg_tc); gfx_x = nx + 11 * sc; gfx_y = ny + (nh - th) * 0.5; gfx_drawstr(title);
  );
);
function mg_key(x, y, w, h, on, s) local(hit) (
  hit = rd_sq(x, y, w, h, on, mg_acc, "");
  gfx_setfont(12); ui_col(on ? 0x1A0A08 : ui_mix(0xEEEFEA, mg_red, 0.25)); mg_ct(x + w * 0.5, y + h * 0.5 + 0.5, s);
  hit;
);
function mg_kn(cx, cy, r, idx, lo, hi, def, lg, cap, label, fmt) (
  sprintf(#mgv, fmt, slider(idx));
  dy_knob(cx, cy, r, idx, lo, hi, def, lg, cap, label, #mgv);
);
function mg_small(cx, cy, r, idx, lo, hi, def, cap, label, fmt) (
  sprintf(#mgv, fmt, slider(idx));
  dy_kst = 20; dy_knob(cx, cy, r, idx, lo, hi, def, 0, cap, label, #mgv); dy_kst = 7;
);
function mg_ring(cx, cy, rr) (
  ui_col(mg_tc);
  mg_r(cx - rr * 0.78 - 5, cy + rr * 0.78 - 1, 10, 2.4);
  mg_r(cx + rr * 0.78 - 5, cy + rr * 0.78 - 1, 10, 2.4); mg_r(cx + rr * 0.78 - 1.2, cy + rr * 0.78 - 4.8, 2.4, 10);
);
function mg_fader(cx, y, h, idx, lo, hi, def, label, fmt) local(v, n, hov, did, py, i) (
  did = 1700 + idx; v = slider(idx); n = (v - lo) / (hi - lo);
  hov = mg_hov(cx - 14, y - 10, 28, h + 20);
  pressed && hov && drag_id == 0 ? (
    time_precise() - mg_flt < 0.35 && mg_fli == idx ? ( mg_set(idx, def); drag_id = -1; mg_flt = 0; ) : (
      drag_id = did; mg_fy = mouse_y; mg_fn = n; mg_flt = time_precise(); mg_fli = idx; );
  );
  drag_id == did ? (
    mg_fn = min(max(mg_fn + (mg_fy - mouse_y) / (((mouse_cap & 8) ? 6 : 1) * h * sc), 0), 1); mg_fy = mouse_y;
    v = lo + mg_fn * (hi - lo); v != slider(idx) ? mg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( mg_set(idx, min(max(v + mouse_wheel / 120 * (hi - lo) * ((mouse_cap & 8) ? 0.005 : 0.025), lo), hi)); mouse_wheel = 0; );
  v = slider(idx); n = (v - lo) / (hi - lo); py = y + h * (1 - n);
  i = 0; loop(11, ui_cola(mg_tc, i == 0 || i == 10 || (lo < 0 && abs(lo + (hi - lo) * (1 - i / 10)) < 0.01) ? 0.9 : 0.5);
    mg_r(cx - 13, y + h * i / 10, 6, 1); mg_r(cx + 7, y + h * i / 10, 6, 1); i += 1; );
  ui_col(0x0A0908); mg_r(cx - 2.5, y - 2, 5, h + 4); ui_cola(0xFFFFFF, 0.12); mg_r(cx + 2.5, y - 2, 1, h + 4);
  i = 1; loop(3, ui_cola(0x000000, 0.13); ui_rrs((cx - 10 + i) * sc, (py - 8 + i * 1.5) * sc, (20 + i) * sc, (16 + i) * sc, 3 * sc); i += 1; );
  ui_col(0x14130E); ui_rrs((cx - 10) * sc, (py - 8) * sc, 20 * sc, 16 * sc, 3 * sc);
  ui_col(0x3E3A2E); ui_rrs((cx - 9) * sc, (py - 7) * sc, 18 * sc, 14 * sc, 2 * sc);
  ui_cola(0xFFFFFF, 0.18); mg_r(cx - 8, py - 6, 16, 1);
  ui_col(0xF4F2EE); mg_r(cx - 8, py - 0.75, 16, 1.5);
  gfx_setfont(5); ui_col(mg_tc);
  hov || drag_id == did ? ( sprintf(#mgv, fmt, v); gfx_setfont(4); mg_ct(cx, y + h + 18, #mgv); ) : mg_ct(cx, y + h + 18, label);
);
function mg_trim(cx, cy, idx, lo, hi, def, label, fmt) local(n, ci) (
  sprintf(#mgv, fmt, slider(idx));
  dy_ntick = 0; dy_kst = 20; dy_knob(cx, cy, 14, idx, lo, hi, def, 0, 0x5A6670, label, #mgv); dy_kst = 7; dy_ntick = 11;
  n = (slider(idx) - lo) / (hi - lo); ci = C_INK; C_INK = mg_tc;
  ui_knob_cap(cx * sc, cy * sc, 14 * sc, -0.75 * $pi + n * 1.5 * $pi, dy_act, 0x5A6670);
  C_INK = ci;
);
function mg_fxkn(cx, cy, idx, lo, hi, def, lg, cap, label, fmt) (
  sprintf(#mgv, fmt, slider(idx));
  dy_kst = 36; dy_knob(cx, cy, 20, idx, lo, hi, def, lg, cap, label, #mgv); dy_kst = 7;
);
function mg_rled(x, y, b, c) (
  ui_col(0x0A0908); gfx_circle(x * sc, y * sc, 7 * sc, 1, 1);
  ui_col(ui_mix(c, 0x000000, 0.75 - 0.75 * b)); gfx_circle(x * sc, y * sc, 5 * sc, 1, 1);
  b > 0.05 ? ( ui_cola(c, 0.3 * b); gfx_circle(x * sc, y * sc, 10 * sc, 1, 1);
               ui_cola(0xFFFFFF, 0.6 * b); gfx_circle((x - 1.5) * sc, (y - 1.5) * sc, 1.4 * sc, 1, 1); );
);

// ---------- Wideload page drawing (wl_) ----------
function wl_gdb(wl_x) ( 8.685889638065035 * log(max(wl_x, 0.000000001)); );   // GUI copy of g2db (audio and GUI threads must not share functions)
function wl_col(wl_h, wl_a) (
  gfx_r = floor(wl_h / 65536) / 255;  gfx_g = (floor(wl_h / 256) % 256) / 255;  gfx_b = (wl_h % 256) / 255;  gfx_a = wl_a;
);
function wl_shade(wl_h, wl_f) local(wl_r, wl_g, wl_b) (
  wl_r = min(255, floor(floor(wl_h / 65536) * wl_f));  wl_g = min(255, floor((floor(wl_h / 256) % 256) * wl_f));
  wl_b = min(255, floor((wl_h % 256) * wl_f));  wl_r * 65536 + wl_g * 256 + wl_b;
);
function wl_px(wl_v) ( wl_ox + wl_v * wl_sc; );
function wl_py(wl_v) ( wl_oy + wl_v * wl_sc; );
function wl_ps(wl_v) ( wl_v * wl_sc; );
function wl_text_c(wl_x, wl_y, wl_str) local(wl_w, wl_h) (
  gfx_measurestr(wl_str, wl_w, wl_h);  gfx_x = wl_x - wl_w * 0.5;  gfx_y = wl_y - wl_h * 0.5;  gfx_drawstr(wl_str);
);
function wl_param_touched(wl_idx) ( ui_auto(wl_idx); wl_gui_dirty = 1; );
function wl_inr(wl_X, wl_Y, wl_W, wl_H) ( mouse_x >= wl_X && mouse_x <= wl_X + wl_W && mouse_y >= wl_Y && mouse_y <= wl_Y + wl_H; );
function wl_screw(wl_x, wl_y) local(wl_X, wl_Y, wl_R) (
  wl_X = wl_px(wl_x);  wl_Y = wl_py(wl_y);  wl_R = wl_ps(7);
  wl_col(0x000000, 0.3);  gfx_circle(wl_X + wl_ps(1), wl_Y + wl_ps(1.5), wl_R, 1, 1);
  wl_col(0x8E887A, 1);    gfx_circle(wl_X, wl_Y, wl_R, 1, 1);
  wl_col(0xC9C0A8, 1);    gfx_arc(wl_X, wl_Y, wl_R - wl_ps(1), -1.9, -0.3, 1);
  wl_col(0x2E2B24, 1);
  gfx_line(wl_X - wl_R * 0.55, wl_Y, wl_X + wl_R * 0.55, wl_Y, 1);  gfx_line(wl_X, wl_Y - wl_R * 0.55, wl_X, wl_Y + wl_R * 0.55, 1);
);
function wl_pointer(wl_x, wl_y, wl_sa, wl_ca, wl_r0, wl_r1, wl_hw) local(wl_ax, wl_ay, wl_bx, wl_by, wl_dx, wl_dy) (
  wl_ax = wl_x + wl_sa * wl_r0;  wl_ay = wl_y - wl_ca * wl_r0;  wl_bx = wl_x + wl_sa * wl_r1;  wl_by = wl_y - wl_ca * wl_r1;  wl_dx = wl_ca * wl_hw;  wl_dy = wl_sa * wl_hw;
  gfx_triangle(wl_ax + wl_dx, wl_ay + wl_dy, wl_bx + wl_dx, wl_by + wl_dy, wl_bx - wl_dx, wl_by - wl_dy, wl_ax - wl_dx, wl_ay - wl_dy);
  gfx_line(wl_ax + wl_dx, wl_ay + wl_dy, wl_bx + wl_dx, wl_by + wl_dy, 1);  gfx_line(wl_ax - wl_dx, wl_ay - wl_dy, wl_bx - wl_dx, wl_by - wl_dy, 1);
);
function wl_ui_mix(wl_c1, wl_c2, wl_t) (
  floor(floor(wl_c1 / 65536) * (1 - wl_t) + floor(wl_c2 / 65536) * wl_t) * 65536 +
  floor((floor(wl_c1 / 256) % 256) * (1 - wl_t) + (floor(wl_c2 / 256) % 256) * wl_t) * 256 +
  floor((wl_c1 % 256) * (1 - wl_t) + (wl_c2 % 256) * wl_t);
);
function wl_ui_rrs(wl_x, wl_y, wl_w, wl_h, wl_r) local(wl_i, wl_d, wl_ins) (
  wl_x = floor(wl_x + 0.5); wl_y = floor(wl_y + 0.5); wl_w = floor(wl_w + 0.5); wl_h = floor(wl_h + 0.5);
  wl_r = min(floor(wl_r + 0.5), floor(min(wl_w, wl_h) * 0.5));
  wl_i = 0;
  loop(wl_r,
    wl_d = wl_r - wl_i - 0.5; wl_ins = floor(wl_r - sqrt(max(wl_r * wl_r - wl_d * wl_d, 0)) + 0.5);
    gfx_rect(wl_x + wl_ins, wl_y + wl_i, wl_w - 2 * wl_ins, 1);  gfx_rect(wl_x + wl_ins, wl_y + wl_h - 1 - wl_i, wl_w - 2 * wl_ins, 1);
    wl_i += 1;
  );
  gfx_rect(wl_x, wl_y + wl_r, wl_w, wl_h - 2 * wl_r);
);
function wl_lk_rr(wl_x, wl_y, wl_w, wl_h, wl_r) ( wl_ui_rrs(wl_px(wl_x), wl_py(wl_y), wl_ps(wl_w), wl_ps(wl_h), wl_ps(wl_r)); );
function wl_ui_keytext(wl_cx, wl_cy, wl_str) local(wl_w, wl_h) (
  gfx_measurestr(wl_str, wl_w, wl_h); gfx_x = floor(wl_cx - wl_w * 0.5 + 0.5); gfx_y = floor(wl_cy - wl_h * 0.58 + 0.5); gfx_drawstr(wl_str);
);
function wl_lk_key(wl_x, wl_y, wl_w, wl_h, wl_on, wl_c, wl_str) local(wl_hov, wl_hit, wl_k, wl_lens, wl_dn, wl_i, wl_t, wl_dx, wl_dy) (
  wl_hov = mouse_x >= wl_px(wl_x) && mouse_x < wl_px(wl_x + wl_w) && mouse_y >= wl_py(wl_y) && mouse_y < wl_py(wl_y + wl_h);
  wl_hit = wl_click && wl_hov;
  wl_dn = wl_hov && wl_lmb ? 1 : 0;
  wl_k = min(wl_w / 54, wl_h / 40);
  wl_lens = wl_shade(wl_ui_mix(wl_c, 0xCFC9BC, 0.5), 0.76);
  wl_on ? wl_lens = wl_c;
  wl_on ? (
    wl_col(wl_c, 0.10); wl_lk_rr(wl_x - 9 * wl_k, wl_y - 9 * wl_k, wl_w + 18 * wl_k, wl_h + 18 * wl_k, 10 * wl_k);
    wl_col(wl_c, 0.18); wl_lk_rr(wl_x - 6 * wl_k, wl_y - 6 * wl_k, wl_w + 12 * wl_k, wl_h + 12 * wl_k, 8 * wl_k);
  );
  wl_col(wl_lk_well, 1);           wl_lk_rr(wl_x - 4 * wl_k, wl_y - 4 * wl_k, wl_w + 8 * wl_k, wl_h + 8 * wl_k, 5 * wl_k);
  wl_col(wl_shade(wl_lens, 0.55), 1); wl_lk_rr(wl_x, wl_y + 1 / wl_sc, wl_w, wl_h, 4 * wl_k);
  wl_y += (wl_dn - 1) / wl_sc;
  wl_on ? (
    wl_col(wl_lens, 1); wl_lk_rr(wl_x, wl_y, wl_w, wl_h - 1 / wl_sc, 4 * wl_k);
    wl_i = 1;
    loop(4,
      wl_t = 0.07 * wl_i * (1 + 0.6 * max(1 - wl_k, 0));
      wl_dx = (wl_i == 1 ? 3 : wl_i == 2 ? 6 : wl_i == 3 ? 10 : 14) * wl_k;
      wl_dy = (wl_i == 1 ? 2 : wl_i == 2 ? 4 : wl_i == 3 ? 7 : 9) * wl_k;
      wl_col(wl_ui_mix(wl_c, 0xFFFFFF, wl_t), 1); wl_lk_rr(wl_x + wl_dx, wl_y + wl_dy, wl_w - 2 * wl_dx, wl_h - 1 / wl_sc - 2 * wl_dy, 4 * wl_k);
      wl_i += 1;
    );
  ) : (
    wl_col(wl_shade(wl_lens, 0.62), 1); wl_lk_rr(wl_x, wl_y, wl_w, wl_h - 1 / wl_sc, 4 * wl_k);
    wl_col(wl_shade(wl_lens, 0.78), 1); wl_lk_rr(wl_x + 2 * wl_k, wl_y + 2 * wl_k, wl_w - 4 * wl_k, wl_h - 5 * wl_k, 4 * wl_k);
    wl_col(wl_shade(wl_lens, 0.92), 1); wl_lk_rr(wl_x + 5 * wl_k, wl_y + 4 * wl_k, wl_w - 10 * wl_k, wl_h - 10 * wl_k, 4 * wl_k);
    wl_col(wl_lens, 1);              wl_lk_rr(wl_x + 9 * wl_k, wl_y + 7 * wl_k, wl_w - 18 * wl_k, wl_h - 17 * wl_k, 4 * wl_k);
  );
  wl_col(0xFFFFFF, wl_on ? 0.45 : 0.22);  gfx_rect(wl_px(wl_x + 4 * wl_k), wl_py(wl_y), wl_ps(wl_w - 8 * wl_k), max(1, wl_ps(1.5)));
  wl_hov && !wl_dn ? ( wl_col(0xFFFFFF, 0.07); wl_lk_rr(wl_x, wl_y, wl_w, wl_h - 1 / wl_sc, 4 * wl_k); );
  gfx_setfont(11);  wl_col(wl_shade(wl_c, wl_on ? 0.30 : 0.17), 1);
  wl_ui_keytext(wl_px(wl_x + wl_w * 0.5), wl_py(wl_y + wl_h * 0.5), wl_str);
  wl_hit;
);
function wl_lk_fit(wl_x, wl_y, wl_w, wl_h, wl_on, wl_c, wl_str) local(wl_k) (
  wl_k = min(wl_w / 62, wl_h / 48);
  wl_lk_key(wl_x + 4 * wl_k, wl_y + 4 * wl_k, wl_w - 8 * wl_k, wl_h - 8 * wl_k, wl_on, wl_c, wl_str);
);
function wl_rr_line(wl_xa, wl_ya, wl_wa, wl_ha, wl_r, wl_th) local(wl_k) (
  wl_k = 0;
  loop(max(1, floor(wl_th + 0.5)),
    gfx_roundrect(wl_xa + wl_k, wl_ya + wl_k, wl_wa - 2 * wl_k, wl_ha - 2 * wl_k, max(1, wl_r - wl_k), 1);
    wl_k += 1;
  );
);
function wl_hatch_v(wl_xa, wl_ya, wl_wd, wl_ht) local(wl_y) (
  wl_y = wl_ya + wl_wd;
  while (wl_y <= wl_ya + wl_ht) ( gfx_line(wl_xa, wl_y, wl_xa + wl_wd, wl_y - wl_wd, 1);  wl_y += wl_ps(4); );
);
function wl_hatch_h(wl_xa, wl_ya, wl_wd, wl_ht) local(wl_x) (
  wl_x = wl_xa;
  while (wl_x <= wl_xa + wl_wd - wl_ht) ( gfx_line(wl_x, wl_ya + wl_ht, wl_x + wl_ht, wl_ya, 1);  wl_x += wl_ps(4); );
);
function wl_hatch_disc(wl_x, wl_y, wl_rr) local(wl_d, wl_l) (
  wl_d = -wl_rr + wl_ps(2);
  while (wl_d < wl_rr) (
    wl_l = sqrt(max(0, wl_rr * wl_rr - wl_d * wl_d));
    gfx_line(wl_x + wl_d * 0.7071 + wl_l * 0.7071, wl_y + wl_d * 0.7071 - wl_l * 0.7071, wl_x + wl_d * 0.7071 - wl_l * 0.7071, wl_y + wl_d * 0.7071 + wl_l * 0.7071, 1);
    wl_d += wl_ps(4);
  );
);
function wl_knob(wl_cx, wl_cy, wl_r, wl_idx, wl_vmin, wl_vmax, wl_step, wl_def, wl_cap, wl_lbl, wl_fmt, wl_sb, wl_nl)
  local(wl_x, wl_y, wl_rr, wl_v, wl_t, wl_hov, wl_now, wl_a0, wl_a1, wl_tv, wl_b, wl_j, wl_n, wl_w, wl_h, wl_ty, wl_lr, wl_fr, wl_lg, wl_hw)
(
  wl_lg = wl_klog;  wl_klog = 0;
  wl_x = wl_px(wl_cx);  wl_y = wl_py(wl_cy);  wl_rr = wl_ps(wl_r);
  wl_hov = sqr(mouse_x - wl_x) + sqr(mouse_y - wl_y) <= sqr(wl_rr * 1.25);
  wl_v = slider(wl_idx);
  wl_t = wl_lg ? log(wl_v / wl_vmin) / log(wl_vmax / wl_vmin) : (wl_v - wl_vmin) / (wl_vmax - wl_vmin);
  wl_click && wl_hov ? (
    wl_now = time_precise();
    (mouse_cap & 4) || (wl_last_click_idx == wl_idx && wl_now - wl_last_click_t < 0.3) ? (
      slider(wl_idx) = wl_def;  wl_param_touched(wl_idx);  wl_drag_idx = 0;
    ) : ( wl_drag_idx = wl_idx;  wl_drag_y = mouse_y;  wl_drag_t = wl_t; );
    wl_last_click_idx = wl_idx;  wl_last_click_t = wl_now;
  );
  wl_drag_idx == wl_idx ? (
    wl_t = max(0, min(1, wl_drag_t + (wl_drag_y - mouse_y) / wl_ps(220)));
    wl_v = wl_lg ? wl_vmin * exp(wl_t * log(wl_vmax / wl_vmin)) : wl_vmin + wl_t * (wl_vmax - wl_vmin);
    wl_step > 0 ? ( wl_v = wl_vmin + floor((wl_v - wl_vmin) / wl_step + 0.5) * wl_step; );
    wl_v = max(wl_vmin, min(wl_vmax, wl_v));
    wl_v != slider(wl_idx) ? ( slider(wl_idx) = wl_v;  wl_param_touched(wl_idx); );
  );
  wl_v = slider(wl_idx);
  wl_t = wl_lg ? log(wl_v / wl_vmin) / log(wl_vmax / wl_vmin) : (wl_v - wl_vmin) / (wl_vmax - wl_vmin);
  wl_a0 = -0.75 * $pi;  wl_a1 = 0.75 * $pi;  wl_tv = wl_a0 + wl_t * (wl_a1 - wl_a0);

  // scale dots and printed labels
  wl_col(wl_scale_col, 0.9);
  wl_n = wl_step > 0 ? floor((wl_vmax - wl_vmin) / wl_step + 0.5) : 10;
  wl_n > 24 ? wl_n = 10;
  wl_j = 0;
  loop(wl_n + 1,
    wl_b = wl_a0 + (wl_j / wl_n) * (wl_a1 - wl_a0);
    gfx_circle(wl_x + sin(wl_b) * (wl_rr + wl_ps(6)), wl_y - cos(wl_b) * (wl_rr + wl_ps(6)), wl_ps(1.3), 1, 1);
    wl_j += 1;
  );
  gfx_setfont(14);  wl_lr = wl_rr + wl_ps(17);  wl_j = 0;
  loop(wl_nl,
    wl_fr = wl_nl > 1 ? wl_j / (wl_nl - 1) : 0.5;
    wl_b = wl_a0 + wl_fr * (wl_a1 - wl_a0);
    wl_sb >= 0 ? ( wl_text_c(wl_x + sin(wl_b) * wl_lr, wl_y - cos(wl_b) * wl_lr, wl_sb + wl_j); ) : (
      sprintf(#wl_sl, "%d", floor(wl_vmin + wl_fr * (wl_vmax - wl_vmin) + 0.5));
      wl_text_c(wl_x + sin(wl_b) * wl_lr, wl_y - cos(wl_b) * wl_lr, #wl_sl);
    );
    wl_j += 1;
  );
  // dial
  wl_col(0x000000, 0.28);  gfx_circle(wl_x + wl_ps(2.5), wl_y + wl_ps(3), wl_rr, 1, 1);      // subtle shadow below and right
  wl_col(wl_cap, 1);          gfx_circle(wl_x, wl_y, wl_rr, 1, 1);
  wl_k_hatch ? ( wl_col(wl_k_ink, 0.3);  wl_hatch_disc(wl_x, wl_y, wl_rr); );
  wl_k_shine ? ( wl_col(wl_label_col, 0.45);  gfx_circle(wl_x - wl_rr * 0.34, wl_y - wl_rr * 0.38, wl_rr * 0.13, 1, 1);
                                     gfx_circle(wl_x - wl_rr * 0.24, wl_y - wl_rr * 0.46, wl_rr * 0.09, 1, 1); );
  wl_col(wl_k_ink, 1);  wl_j = 0;
  loop(3, gfx_circle(wl_x, wl_y, wl_rr - wl_j * wl_ps(0.8), 0, 1);  wl_j += 1; );
  wl_hw = wl_ps(wl_r > 30 ? 2.1 : 1.6);
  wl_col(wl_k_ptr, 1);
  wl_pointer(wl_x, wl_y, sin(wl_tv), cos(wl_tv), wl_rr * 0.12, wl_rr * 0.84, wl_hw);
  gfx_circle(wl_x + sin(wl_tv) * wl_rr * 0.84, wl_y - cos(wl_tv) * wl_rr * 0.84, wl_hw, 1, 1);
  // label
  gfx_setfont(6);  wl_col(wl_label_col, 1);  wl_text_c(wl_x, wl_y + wl_rr + wl_ps(25), wl_lbl);
  // value on hover only (house rule)
  wl_hov || wl_drag_idx == wl_idx ? (
    wl_fmt == 0 ? sprintf(#wl_kv, "%+.1f dB", wl_v) :
    wl_fmt == 1 ? sprintf(#wl_kv, "%d%%", wl_v) :
    wl_fmt == 2 ? sprintf(#wl_kv, "%.1f", wl_v) :
    wl_fmt == 3 ? ( wl_v < 1000 ? sprintf(#wl_kv, "%d Hz", wl_v) : sprintf(#wl_kv, "%.2f kHz", wl_v / 1000); ) :
    wl_fmt == 4 ? sprintf(#wl_kv, "Q %.2f", wl_v) :
               sprintf(#wl_kv, "%s", wl_fmt - 1000 + floor((wl_v - wl_vmin) / wl_step + 0.5));
    gfx_setfont(12);  gfx_measurestr(#wl_kv, wl_w, wl_h);
    wl_ty = wl_y - wl_lr - wl_ps(12) - wl_h;
    wl_col(0x14130E, 0.95);  gfx_rect(wl_x - wl_w * 0.5 - wl_ps(6), wl_ty - wl_ps(3), wl_w + wl_ps(12), wl_h + wl_ps(6), 1);
    wl_col(0xD6C79C, 1);     wl_text_c(wl_x, wl_ty + wl_h * 0.5, #wl_kv);
  );
);
function wl_ckey(wl_x, wl_y, wl_w, wl_h, wl_on, wl_c, wl_str) local(wl_xa, wl_ya, wl_wa, wl_ha, wl_hov, wl_dn, wl_lum) (
  wl_xa = wl_px(wl_x);  wl_ya = wl_py(wl_y);  wl_wa = wl_ps(wl_w);  wl_ha = wl_ps(wl_h);
  wl_hov = mouse_x >= wl_xa && mouse_x <= wl_xa + wl_wa && mouse_y >= wl_ya && mouse_y <= wl_ya + wl_ha;
  wl_dn = wl_hov && wl_lmb ? wl_ps(1) : 0;
  wl_on ? (
    wl_col(wl_c, 0.10);  wl_ui_rrs(wl_xa - wl_ps(10), wl_ya - wl_ps(10), wl_wa + wl_ps(20), wl_ha + wl_ps(20), wl_ps(9));
    wl_col(wl_c, 0.18);  wl_ui_rrs(wl_xa - wl_ps(6),  wl_ya - wl_ps(6),  wl_wa + wl_ps(12), wl_ha + wl_ps(12), wl_ps(7));
    wl_col(wl_c, 0.30);  wl_ui_rrs(wl_xa - wl_ps(3),  wl_ya - wl_ps(3),  wl_wa + wl_ps(6),  wl_ha + wl_ps(6),  wl_ps(5));
  );
  wl_col(0x000000, 0.35);  wl_ui_rrs(wl_xa + wl_ps(2.5), wl_ya + wl_ps(3), wl_wa, wl_ha, wl_ps(4));
  wl_on ? wl_col(wl_c, 1) : wl_col(0x6E6A5E, 1);
  wl_ui_rrs(wl_xa + wl_dn, wl_ya + wl_dn, wl_wa, wl_ha, wl_ps(4));
  wl_on ? ( wl_col(0xFFFFFF, 0.25);  gfx_rect(wl_xa + wl_dn + wl_ps(4), wl_ya + wl_dn + wl_ps(3), wl_wa - wl_ps(8), wl_ps(2), 1); );
  wl_col(0x14130E, 1);  wl_rr_line(wl_xa + wl_dn, wl_ya + wl_dn, wl_wa, wl_ha, wl_ps(4), wl_ps(1.6));
  gfx_setfont(11);
  wl_lum = 0.3 * floor(wl_c / 65536) + 0.59 * (floor(wl_c / 256) % 256) + 0.11 * (wl_c % 256);
  wl_on ? ( wl_lum > 110 ? wl_col(0x14130E, 1) : wl_col(0xEFE3C0, 1); ) : wl_col(0x2E2B24, 1);
  wl_text_c(wl_xa + wl_wa * 0.5 + wl_dn, wl_ya + wl_ha * 0.5 + wl_dn, wl_str);
  wl_click && wl_hov;
);
function wl_name_plate(wl_cx, wl_y, wl_str, wl_pc, wl_tc) local(wl_w, wl_h, wl_xa, wl_ya, wl_wa, wl_ha, wl_fc) (
  gfx_setfont(13);  gfx_measurestr(wl_str, wl_w, wl_h);
  wl_wa = wl_w + wl_ps(26);  wl_ha = wl_h + wl_ps(8);  wl_xa = wl_px(wl_cx) - wl_wa * 0.5;  wl_ya = wl_py(wl_y) - wl_ha * 0.5;
  wl_fc = wl_shade(wl_pc, 0.8);
  wl_col(0xFFFFFF, 0.14);  wl_ui_rrs(wl_xa - wl_ps(2), wl_ya - wl_ps(2), wl_wa + wl_ps(4), wl_ha + wl_ps(4), wl_ps(3));   // lip, lit bottom / right
  wl_col(0x000000, 0.55);  wl_ui_rrs(wl_xa - wl_ps(2), wl_ya - wl_ps(2), wl_wa + wl_ps(2.5), wl_ha + wl_ps(2.5), wl_ps(3));
  wl_col(wl_fc, 1);           wl_ui_rrs(wl_xa, wl_ya, wl_wa, wl_ha, wl_ps(2));
  wl_col(0x000000, 0.32);  gfx_rect(wl_xa + wl_ps(1), wl_ya, wl_wa - wl_ps(2), wl_ps(3), 1);  gfx_rect(wl_xa, wl_ya + wl_ps(1), wl_ps(2.5), wl_ha - wl_ps(2), 1);
  wl_col(0x000000, 0.45);  wl_text_c(wl_px(wl_cx) - wl_ps(1), wl_py(wl_y) - wl_ps(1), wl_str);                        // engraved: dark upper edge
  wl_col(wl_tc, 1);           wl_text_c(wl_px(wl_cx), wl_py(wl_y), wl_str);
);
function wl_cplate(wl_x0, wl_w, wl_c, wl_ink, wl_hc, wl_ha, wl_th, wl_seed) local(wl_xa, wl_ya, wl_wa, wl_hh) (
  wl_xa = wl_px(wl_x0);  wl_ya = wl_py(40);  wl_wa = wl_ps(wl_w);  wl_hh = wl_ps(560);
  wl_col(0x000000, 0.45);  wl_ui_rrs(wl_xa + wl_ps(3), wl_ya + wl_ps(3), wl_wa, wl_hh, wl_ps(8));
  wl_col(wl_c, 1);            wl_ui_rrs(wl_xa, wl_ya, wl_wa, wl_hh, wl_ps(8));
  wl_col(wl_hc, wl_ha);
  wl_hatch_v(wl_xa + wl_wa - wl_ps(12), wl_ya + wl_ps(10), wl_ps(11), wl_hh - wl_ps(22));
  wl_hatch_h(wl_xa + wl_ps(10), wl_ya + wl_hh - wl_ps(12), wl_wa - wl_ps(22), wl_ps(11));
  wl_col(wl_ink, 1);  wl_rr_line(wl_xa, wl_ya, wl_wa, wl_hh, wl_ps(8), wl_ps(wl_th * 0.8));
);
function wl_rocker(wl_cx, wl_y, wl_idx, wl_la, wl_lb, wl_lc) local(wl_xa, wl_ya, wl_wa, wl_ha, wl_sel, wl_hl, wl_hr, wl_fx, wl_fy, wl_fw, wl_fh, wl_hw, wl_k, wl_w, wl_h, wl_px0, wl_rx0) (
  wl_wa = wl_ps(58);  wl_ha = wl_ps(32);  wl_xa = wl_px(wl_cx) - wl_wa * 0.5;  wl_ya = wl_py(wl_y);
  wl_hl = wl_inr(wl_xa, wl_ya, wl_wa * 0.5, wl_ha);  wl_hr = wl_inr(wl_xa + wl_wa * 0.5, wl_ya, wl_wa * 0.5, wl_ha);
  wl_sel = slider(wl_idx) >= 0.5;
  wl_click && wl_hl && wl_sel ? ( slider(wl_idx) = 0;  wl_param_touched(wl_idx);  wl_sel = 0; );
  wl_click && wl_hr && !wl_sel ? ( slider(wl_idx) = 1;  wl_param_touched(wl_idx);  wl_sel = 1; );
  // lit lens glow
  wl_col(0xFF3A1E, 0.08);  wl_ui_rrs(wl_xa - wl_ps(8), wl_ya - wl_ps(8), wl_wa + wl_ps(16), wl_ha + wl_ps(16), wl_ps(10));
  wl_col(0xFF3A1E, 0.14);  wl_ui_rrs(wl_xa - wl_ps(4), wl_ya - wl_ps(4), wl_wa + wl_ps(8), wl_ha + wl_ps(8), wl_ps(7));
  // black bezel
  wl_col(0x000000, 0.4);   wl_ui_rrs(wl_xa + wl_ps(2.5), wl_ya + wl_ps(3), wl_wa, wl_ha, wl_ps(4));
  wl_col(0x16140F, 1);     wl_ui_rrs(wl_xa, wl_ya, wl_wa, wl_ha, wl_ps(4));
  wl_col(0x45413A, 1);     gfx_rect(wl_xa + wl_ps(4), wl_ya + wl_ps(1), wl_wa - wl_ps(8), max(1, wl_ps(1)), 1);
  wl_fx = wl_xa + wl_ps(5);  wl_fy = wl_ya + wl_ps(5);  wl_fw = wl_wa - wl_ps(10);  wl_fh = wl_ha - wl_ps(10);  wl_hw = wl_fw * 0.5;
  wl_px0 = wl_sel ? wl_fx + wl_hw : wl_fx;  wl_rx0 = wl_sel ? wl_fx : wl_fx + wl_hw;          // pressed half, raised half
  // raised half: brighter, light catching its top edge
  wl_col(0xC42A1E, 1);  gfx_rect(wl_rx0, wl_fy, wl_hw, wl_fh, 1);
  wl_col(0xF06048, 1);  gfx_rect(wl_rx0, wl_fy, wl_hw, max(1, wl_ps(2)), 1);
  wl_col(0x7A140E, 1);  gfx_rect(wl_rx0, wl_fy + wl_fh - max(1, wl_ps(2)), wl_hw, max(1, wl_ps(2)), 1);
  // pressed half: sunk, shadow from the raised half at the pivot, lamp hot spot
  wl_col(0xA81E14, 1);  gfx_rect(wl_px0, wl_fy, wl_hw, wl_fh, 1);
  wl_col(0x000000, 0.35);  gfx_rect(wl_px0, wl_fy, wl_hw, max(1, wl_ps(2)), 1);
  wl_col(0x000000, 0.45);  gfx_rect(wl_sel ? wl_px0 : wl_px0 + wl_hw - wl_ps(3), wl_fy, wl_ps(3), wl_fh, 1);
  wl_k = 0;
  loop(3,
    wl_col(wl_k == 0 ? 0xFF7A3A : wl_k == 1 ? 0xFFA45A : 0xFFD890, 0.35);
    gfx_circle(wl_px0 + wl_hw * 0.5, wl_fy + wl_fh * 0.5, min(wl_hw, wl_fh) * (0.40 - wl_k * 0.11), 1, 1);
    wl_k += 1;
  );
  // legends
  gfx_setfont(11);
  wl_col(0xFFF0E0, wl_sel ? 0.55 : 1);  wl_text_c(wl_fx + wl_hw * 0.5, wl_fy + wl_fh * 0.5, "A");
  wl_col(0xFFF0E0, wl_sel ? 1 : 0.55);  wl_text_c(wl_fx + wl_hw * 1.5, wl_fy + wl_fh * 0.5, "B");
  // model names
  gfx_setfont(14);
  gfx_measurestr(wl_la, wl_w, wl_h);  wl_col(wl_lc, wl_sel ? 0.45 : 1);  gfx_x = wl_xa - wl_ps(7) - wl_w;  gfx_y = wl_ya + wl_ha * 0.5 - wl_h * 0.5;  gfx_drawstr(wl_la);
  wl_col(wl_lc, wl_sel ? 1 : 0.45);   gfx_x = wl_xa + wl_wa + wl_ps(7);    gfx_drawstr(wl_lb);
);
function wl_plaque(wl_cx, wl_y, wl_str, wl_bc) local(wl_w, wl_h) (
  gfx_setfont(14);  gfx_measurestr(wl_str, wl_w, wl_h);
  wl_col(0x000000, 0.35);  wl_ui_rrs(wl_px(wl_cx) - wl_w * 0.5 - wl_ps(6) + wl_ps(2), wl_py(wl_y) + wl_ps(2), wl_w + wl_ps(12), wl_h + wl_ps(3), wl_ps(2));
  wl_col(wl_bc, 1);           wl_ui_rrs(wl_px(wl_cx) - wl_w * 0.5 - wl_ps(6), wl_py(wl_y), wl_w + wl_ps(12), wl_h + wl_ps(3), wl_ps(2));
  wl_col(0xF2E6C4, 1);     wl_text_c(wl_px(wl_cx), wl_py(wl_y) + wl_h * 0.5 + wl_ps(1.5), wl_str);
);
function wl_glamp(wl_x, wl_y, wl_r, wl_on, wl_c) (
  wl_on ? ( wl_col(wl_c, 0.25);  gfx_circle(wl_px(wl_x), wl_py(wl_y), wl_ps(wl_r * 2), 1, 1);  wl_col(wl_c, 0.4);  gfx_circle(wl_px(wl_x), wl_py(wl_y), wl_ps(wl_r * 1.45), 1, 1); );
  wl_col(0x14130E, 1);  gfx_circle(wl_px(wl_x), wl_py(wl_y), wl_ps(wl_r + 2), 1, 1);
  wl_on ? wl_col(wl_c, 1) : wl_col(0x4A4838, 1);
  gfx_circle(wl_px(wl_x), wl_py(wl_y), wl_ps(wl_r), 1, 1);
);
function wl_blank(wl_x0) ( wl_cplate(wl_x0, 150, 0x3B3A2C, 0x14130E, 0x14130E, 1, 2.6, wl_x0);  wl_screw(wl_x0 + 75, 56);  wl_screw(wl_x0 + 75, 584); );
function wl_ledcol(wl_x, wl_y0, wl_h, wl_db) local(wl_n, wl_sh, wl_j, wl_d, wl_yy) (
  wl_n = 34;  wl_sh = wl_h / wl_n;
  wl_col(0x14130E, 1);  gfx_rect(wl_px(wl_x - 2), wl_py(wl_y0 - 2), wl_ps(16), wl_ps(wl_h + 4), 1);
  wl_j = 0;
  loop(wl_n,
    wl_d = -48 + (wl_j + 1) * 1.5;  wl_yy = wl_y0 + wl_h - (wl_j + 1) * wl_sh;
    wl_d > 0 ? wl_col(0xC8642E, wl_db >= wl_d - 1.5 ? 1 : 0.14) :
    wl_d > -6 ? wl_col(0xD8A84A, wl_db >= wl_d - 1.5 ? 1 : 0.14) :
             wl_col(0x9AAA52, wl_db >= wl_d - 1.5 ? 1 : 0.14);
    gfx_rect(wl_px(wl_x), wl_py(wl_yy) + 1, wl_ps(12), wl_ps(wl_sh) - 1, 1);
    wl_j += 1;
  );
);
