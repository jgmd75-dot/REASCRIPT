wl_tcr_tab = WLB + 120; wl_tcr_tab[0]=300; wl_tcr_tab[1]=800; wl_tcr_tab[2]=2000; wl_tcr_tab[3]=5000; wl_tcr_tab[4]=2000; wl_tcr_tab[5]=300;
wl_sch_tab = WLB + 80; wl_sch_tab[0]=0; wl_sch_tab[1]=30; wl_sch_tab[2]=60; wl_sch_tab[3]=105; wl_sch_tab[4]=125; wl_sch_tab[5]=185;

