  wl_ckey(wl_cx - 29, 492, 58, 28, wl_pre_on, 0xE0802E, "IN") ? ( slider(45) = wl_pre_on ? 0 : 1;  wl_param_touched(45); );
  wl_rocker(wl_cx, 532, 42, "AR-70", "SX-6", 0xC9B98A);
