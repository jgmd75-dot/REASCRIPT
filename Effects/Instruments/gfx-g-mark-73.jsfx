mk_l = mk_a1l.bq_run(mk_l); mk_r_ = mk_a1r.bq_run(mk_r_);
mk_l = mk_a2l.bq_run(mk_l); mk_r_ = mk_a2r.bq_run(mk_r_);
mk_l = mk_a3l.bq_run(mk_l); mk_r_ = mk_a3r.bq_run(mk_r_);
