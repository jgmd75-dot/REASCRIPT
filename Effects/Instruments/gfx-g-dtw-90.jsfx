lk_menu(220, 330, 92, 24, 17, "LP 24|LP 12|BP|HP 24", 4, LK_ORG);
klog = 1;  kn(72, 420, 28, 18, 20, 20000, 900, C_EMB, 0xFFFFFF, "CUTOFF", 2, 1);
kn(152, 426, 22, 19, 0, 1, 0.25, C_EMB, 0xFFFFFF, "RESO", 1, 1);
kzero = 1;  kn(222, 431, 17, 20, -1, 1, 0.5, C_CAPW, 0x262B45, "ENV", 12, 0);
kn(282, 431, 17, 21, 0, 1, 0.5, C_CAPW, 0x262B45, "KEY", 1, 0);

// ---------- PATTERN ----------
section(344, 316, 840, 196, C_SEC2, "PATTERN");
C_CAPW = 0xF4EBB8;   // pastel lemon centres on this section's plain caps (JG: a shade per section)
lk_key(452, 330, 60, 24, pt_on >= 0.5, LK_AMB, "ON") ? ( slider(46) = pt_on >= 0.5 ? 0 : 1;  param_touched(46); );
gfx_setfont(6);  col(C_INK2, 1);  text_l(px(536), py(342), "RATE");
lk_menu(590, 330, 70, 24, 47, "1/4|1/8|1/8T|1/16|1/16T|1/32", 6, LK_YEL);
gfx_setfont(6);  col(C_INK2, 1);  text_l(px(688), py(342), "LENGTH");
lk_key(754, 330, 52, 24, 1, LK_YEL, sprintf(#pl, "%d", pt_len)) ? (
  strcpy(#plm, "");  g_j = 1;
  loop(16, g_j == floor(pt_len + 0.5) ? strcat(#plm, "!");  sprintf(#plt, "%d steps", g_j);  strcat(#plm, #plt);  g_j < 16 ? strcat(#plm, "|");  g_j += 1; );
  gfx_x = px(754);  gfx_y = py(352);  g_j = gfx_showmenu(#plm);
  g_j > 0 ? ( slider(48) = g_j;  param_touched(48); );
);
// the grid (centred under the band): STEP keys, ACC keys under them, a running lamp and the step number; groups of four
gfx_setfont(6);  col(C_INK2, 1);  text_l(px(362), py(397), "STEP");  text_l(px(362), py(431), "ACC");
g_sb = floor(pt_steps + 0.5);  g_ab = floor(pt_acc + 0.5);
g_j = 0;
loop(16,
  g_x = 412 + g_j * 36 + floor(g_j / 4) * 12;
  g_in = g_j < pt_len;
  g_on = (g_sb >> g_j) & 1;  g_ac = (g_ab >> g_j) & 1;
  lk_key(g_x, 383, 30, 28, g_on, g_in ? LK_ORG : 0x9A928A, "") ? ( slider(51) = g_sb ~ (1 << g_j);  param_touched(51); );
  lk_key(g_x + 3, 421, 24, 20, g_ac, g_in ? LK_RED : 0x9A928A, "") ? ( slider(52) = g_ab ~ (1 << g_j);  param_touched(52); );
  g_lit = pt_on >= 0.5 && pt_step_disp == g_j;
  col(shade(C_PANEL, 0.5), 1);  gfx_circle(px(g_x + 15), py(455), ps(4), 1, 1);
  col(g_lit ? 0xFFD040 : 0x2A241E, 1);  gfx_circle(px(g_x + 15), py(455), ps(3), 1, 1);
  g_lit ? ( col(0xFFD040, 0.3);  gfx_circle(px(g_x + 15), py(455), ps(6), 1, 1); );
  gfx_setfont(5);  col(g_in ? C_INK2 : C_DIM, 1);  sprintf(#sn, "%d", g_j + 1);  text_c(px(g_x + 15), py(471), #sn);
  g_j += 1;
);
divider(1040, 364, 498);
kn(1080, 420, 16, 49, 5, 100, 40, C_CAPW, 0x262B45, "GATE", 4, 0);
kn(1144, 420, 16, 50, 0, 75, 0, C_CAPW, 0x262B45, "SWING", 4, 0);

// ---------- EFFECTS: one plate, no title (JG), three parts: CHORUS | DELAY | SPACE with its 500 Hz CUT ----------
section(16, 528, 1168, 136, C_SEC1, "");
C_CAPW = 0xC9E6EE;   // pastel aqua centres on this section's plain caps (JG: a shade per section)
divider(196, 540, 652);  divider(656, 540, 652);
sub_title(32, 554, "CHORUS");
kn(106, 606, 20, 31, 0, 1, 0.3, C_TEAL, 0xFFFFFF, "MIX", 1, 1);
sub_title(212, 554, "DELAY");
lk_key(518, 542, 58, 24, dl_sync >= 0.5, LK_YEL, "SYNC") ? ( slider(32) = dl_sync >= 0.5 ? 0 : 1;  param_touched(32); );
lk_key(584, 542, 58, 24, dl_pp >= 0.5, LK_YEL, "PING") ? ( slider(37) = dl_pp >= 0.5 ? 0 : 1;  param_touched(37); );
dl_sync >= 0.5 ? ( kstep = 1;  kn(256, 610, 16, 34, 0, 13, 8, 0xC4EBBE, 0x262B45, "TIME", 16, 0); )
               : ( klog = 1;  kn(256, 610, 16, 33, 10, 2000, 350, 0xC4EBBE, 0x262B45, "TIME", 3, 0); );
kn(326, 610, 16, 35, 0, 0.95, 0.35, 0xC4EBBE, 0x262B45, "FDBK", 1, 0);
kn(396, 610, 16, 36, 0, 1, 0.15, 0xC4EBBE, 0x262B45, "MIX", 1, 0);
klog = 1;  kn(476, 610, 16, 6, 20, 2000, 120, 0xF2D04A, 0x262B45, "HPF", 2, 0);      // HPF yellow, LPF black (house)
klog = 1;  kn(546, 610, 16, 7, 1000, 20000, 5000, 0x232327, 0xFFFFFF, "LPF", 2, 0);
sub_title(672, 554, "SPACE");
#spn = sp_size < 0.25 ? "ROOM" : sp_size < 0.5 ? "CHAMBER" : sp_size < 0.8 ? "HALL" : "CATHEDRAL";
gfx_setfont(5);  col(C_INK2, 1);  text_l(px(740), py(554), #spn);
kn(704, 611, 15, 38, 0, 1, 0.5, C_CAPW, 0x262B45, "SIZE", 1, 0);
klog = 1;  kn(768, 611, 15, 39, 0.2, 12, 1.8, C_CAPW, 0x262B45, "DECAY", 17, 0);
kn(832, 611, 15, 40, 0, 1, 0.5, C_CAPW, 0x262B45, "DAMP", 1, 0);
kn(896, 611, 15, 41, 0, 1, 0.15, C_TEAL, 0xFFFFFF, "MIX", 1, 0);
// the 500 Hz trick (Space's vintage wet EQ): OFF / -3 / -6 / -9 dB at 500 Hz, with HP 140 Hz and LP 5 kHz, on the reverb
sub_title(950, 554, "500 Hz CUT");
g_j = 0;
loop(4,
  lk_key(950 + g_j * 56, 597, 48, 26, floor(sp_cut + 0.5) == g_j, LK_AMB, g_j == 0 ? "OFF" : g_j == 1 ? "-3" : g_j == 2 ? "-6" : "-9") ? ( slider(8) = g_j;  param_touched(8); );
  g_j += 1;
);
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1060), py(645), "WITH HP 140 Hz  /  LP 5 kHz");

// ---------- the bottom row (LFO | DRIVE | FFAT | MASTER), drawn 152 lower than its design numbers ----------
oy += 152 * sc;
// ---------- LFO ----------
section(16, 528, 300, 180, C_SEC3, "LFO");
C_CAPW = 0xCDB6F2;   // pastel lilac centres on this section's plain caps (JG: a shade per section)
g_t = lfo_shape < 0.5 ? 0.5 + 0.5 * sin(2 * $pi * lfo_disp) : 1 - abs(2 * lfo_disp - 1);
col(0x000000, 0.4);  gfx_circle(px(70), py(554), ps(5.5), 1, 1);
col(LK_AMB, 0.2 + 0.8 * g_t);  gfx_circle(px(70), py(554), ps(4.5), 1, 1);
col(LK_AMB, 0.25 * g_t);  gfx_circle(px(70), py(554), ps(8), 1, 1);
lk_menu(140, 542, 76, 24, 53, "SINE|TRI|SAW|SQUARE|S&H", 5, LK_YEL);
lk_key(236, 542, 60, 24, lfo_sync >= 0.5, LK_YEL, "SYNC") ? ( slider(54) = lfo_sync >= 0.5 ? 0 : 1;  param_touched(54); );
lfo_sync >= 0.5 ? ( kstep = 1;  kn(62, 624, 22, 56, 0, 13, 5, C_TEAL, 0xFFFFFF, "RATE", 20, 1); )
                : ( klog = 1;  kn(62, 624, 22, 55, 0.02, 20, 0.5, C_TEAL, 0xFFFFFF, "RATE", 10, 1); );
kn(138, 629, 17, 57, 0, 3, 0, C_CAPW, 0x262B45, "CUTOFF", 9, 0);
kn(204, 629, 17, 58, 0, 50, 0, C_CAPW, 0x262B45, "DETUNE", 19, 0);
kn(270, 629, 17, 59, 0, 1, 0, C_CAPW, 0x262B45, "PAN", 1, 0);

// ---------- DRIVE (FFAT's): the IN key switches it in and out ----------
section(332, 528, 320, 180, C_SEC1, "DRIVE");
C_CAPW = 0xF8D2B4;   // pastel apricot centres on this section's plain caps (JG: a shade per section)
lk_key(478, 542, 64, 24, drv_on >= 0.5, LK_AMB, "IN") ? ( slider(60) = drv_on >= 0.5 ? 0 : 1;  param_touched(60); );   // IN (house: amber)
lk_menu(556, 542, 80, 24, 61, "TUBE|FUZZ|RECT|CRUSH", 4, LK_ORG);
kdim = drv_on < 0.5;  kn(436, 624, 22, 62, 0, 10, 3, C_EMB, 0xFFFFFF, "DRIVE", 0, 1);
kdim = drv_on < 0.5;  kn(556, 629, 17, 64, 0, 100, 100, C_CAPW, 0x262B45, "MIX", 4, 0);

// ---------- FFAT: the one-knob squash (FFAT's) ----------
section(668, 528, 168, 180, C_SEC3, "FFAT");
kn(752, 624, 22, 9, 0, 10, 0, C_TEAL, 0xFFFFFF, "FFAT", 0, 1);

// ---------- MASTER ----------
section(852, 528, 332, 180, C_SEC2, "MASTER");
C_CAPW = 0xF2D0DA;   // pastel rose centres on this section's plain caps (JG: a shade per section)
u_db = out_m > 0.000001 ? 8.685889638065035 * log(out_m) : -120;
u_now = time_precise();
u_db >= pk_db || u_now - pk_t > 1.5 ? (
  u_db >= pk_db ? ( pk_db = u_db;  pk_t = u_now; ) : pk_db = max(u_db, pk_db - 20 * (u_now - pk_last));
);
pk_last = u_now;
pk_db > -48 ? sprintf(#pk, "%.1f dB", min(pk_db, 0)) : strcpy(#pk, "-inf");
sprintf(#ms, "VOICES %d/16  PEAK %s", voices_disp, #pk);
lcd(868, 566, 250, 28, 7, #ms);
clip_d ? ( clip_t = u_now;  clip_d = 0; );
u_on = u_now - clip_t < 0.4;
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1150), py(554), "CLIP");
col(u_on ? 0xFF4A30 : 0x5A2620, 1);  gfx_circle(px(1124), py(554), ps(4), 1, 1);
u_on ? ( col(0xFF4A30, 0.3);  gfx_circle(px(1124), py(554), ps(7), 1, 1); );
col(0x141210, 1);  u_rect(1140, 566, 20, 110);
g_j = 0;
loop(24,
  u_d = -48 + (g_j + 1) * 2;
  col(u_d > -1 ? 0xE0503A : u_d > -6 ? 0xF2A41E : 0x5FC4C0, u_db >= u_d - 2 ? 1 : 0.14);
  u_rect(1143, 673 - (g_j + 1) * 104 / 24 + 1, 14, 104 / 24 - 1.2);
  g_j += 1;
);
pk_db > -48 ? (
  u_y = 673 - (min(pk_db, 0) + 48) / 48 * 104;
  col(0xFFFFFF, 0.95);  u_rect(1142, u_y - 1, 16, 2);
);
click && mouse_x >= px(1140) && mouse_x < px(1160) && mouse_y >= py(566) && mouse_y < py(676) ? pk_db = -120;   // clear the peak
gfx_setfont(6);  col(C_INK, 1);  text_c(px(1150), py(690), "OUT");
kn(886, 648, 15, 42, -12, 12, 0, C_CAPW, 0x262B45, "LOW", 7, 0);
kn(938, 648, 15, 43, -12, 12, 0, C_CAPW, 0x262B45, "HIGH", 7, 0);
kn(990, 648, 15, 30, 0, 1, 0.5, C_CAPW, 0x262B45, "VELO", 1, 0);
kn(1042, 648, 15, 45, 0, 100, 50, C_CAPW, 0x262B45, "DRIFT", 4, 0);
kn(1094, 648, 15, 44, -24, 6, 0, C_TEAL, 0xFFFFFF, "VOL", 7, 0);

oy -= 152 * sc;

// ---------- OS key (house): left of the S / M / L / ? picker; cycles 1x -> 2x -> 4x ----------
os_key(ox / sc + 1090, oy / sc + 18, 63, C_HSUB, 12) ? gui_dirty = 1;

// ---------- S / M / L / ? (size picker and credits), house layout: four 13 x 18 keys on a 14 pitch ----------
g_j = 0;
loop(4,
  g_x = 1126 + g_j * 14;  g_on = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(0x050302, 1);  u_rect(g_x, 20, 13, 18);
  col(g_on ? C_LCDTX : shade(C_HEAD, 1.6), 1);  u_rect(g_x + 1, 21, 11, 16);
  gfx_setfont(5);  col(g_on ? C_LCDBG : C_HSUB, 1);  text_c(px(g_x + 6.5), py(29), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(20) && mouse_y < py(38) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
// the card: credits, website, manual, then MAINS / EQUATOR PROXIMITY; a click outside it closes it
strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
g_cw = max(g_tw + ps(40), ps(440));  g_ch = ps(320);  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
sz_help && h_click && !sz_new && (mouse_x < g_cx || mouse_x >= g_cx + g_cw || mouse_y < g_cy || mouse_y >= g_cy + g_ch) ? ( sz_help = 0;  h_click = 0; );
sz_new ? h_click = 0;
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(0xE0603A, 1);      gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x3A3C42, 1);    gfx_rect(g_cx + ps(20), g_cy + ps(100), g_cw - ps(40), max(1, ps(1)), 1);
  pwr_panel(g_cx + ps(30), g_cy + ps(118), sc, 14, h_click, h_wheel);
  gfx_setfont(5);  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(292);  gfx_drawstr("Click outside to close.");
);

// ---------- end of frame ----------
!lmb ? drag_idx = 0;
mouse_wheel = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // parameters rebuilt in @block, never on the GUI thread
