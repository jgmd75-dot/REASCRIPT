desc:EA77 [synth] (GFX)
//tags: instrument synth drone soundscape noise radio cinematic
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-output, gfx-uimin, gfx-glow (.jsfx-inc) in the same folder.
//
// EA77 - an atmospheric soundscape generator in the spirit of analogue shortwave radio sweeps, interstellar static
// and otherworldly electromagnetic hums. Every sound is synthesised.
//
// SIGNAL FLOW
//   CARRIER (per key, 8 voices, plus the drone): two sine waves, SINE SPREAD apart (the first at the key's pitch),
//   swept up and down by two slow loops (SWEEP RATE, SWEEP DEPTH). COUNTER-ROTATE lit: the loops turn against each
//   other - one sine rises while the other falls, and they circle the stereo field in opposite directions; dark:
//   locked, both move together. While RUN is lit and no key is held, the drone sounds at the last key played.
//   RECEIVER: a shortwave band from 1 to 30 MHz. SW TUNE moves through it (drag the dial window for a fine
//   vernier): stations come and go as heterodyne whistles - steady carriers, morse, data chatter and garbled voices -
//   over band static. SW BANDWIDTH opens the receiver's filter: narrow = thin and close, wide = more stations,
//   more hiss. A strong station pushes the static down (the receiver's AGC).
//   HUM: mains hum at HUM FREQ (40 - 70 Hz; 50 and 60 marked), BUZZ adds the harmonics of an old transformer.
//   POPS: a crackle-and-pop generator - single clicks, crackle bursts and low thumps, each placed somewhere in the
//   stereo field; POP DENSITY sets how often (0 = none). Some of them are sent into the delay (the click matrix).
//   BLEEPS (EFFECTS page): short computer bleeps (soft squares) and boops (sines) in little phrases of 1 - 5 notes
//   from a five-note scale round BLEEP PITCH; DENSITY (phrases a second), LEVEL. They go hard into the LCR delay.
//   FADE LFOs: the carrier, the receiver and the hum each have their own slow LFO (FADE = how far it dips, FADE
//   RATE), so each can drift out of view and back on its own; the pops have one on their density (LFO DEPTH, RATE).
//   EFFECTS page:
//   FLANGER (title lamp = in / out): RATE, DEPTH, FEEDBACK (+/-, "0" marked), MIX; left and right a quarter turn apart.
//   LCR DELAY (title lamp = in / out), in the spirit of THE STAR's three channels: LEFT, CENTRE and RIGHT lines,
//   each its own SEND, TIME (a note value at REAPER's tempo with SYNC lit, or ms; the readout under it) and REPEATS;
//   TONE is the filter in all three loops (dark and narrow to bright and open). A time change glides.
//   CARRIER + RECEIVER + HUM + POPS (each with its own LEVEL and fade) -> FLANGER -> + LCR DELAY -> output stage
//   (CLIP, ceiling -0.3 dBFS) -> LEVEL
// RUN (lit; never on by itself): the soundscape runs on its own. Dark, it sounds only while keys are held.
//
// DRIFT (0 - 100 %, 50 % = standard): RF fading (every station swells and fades on its own) and a slow wander of
//   the receiver's tuning; power-line frequency drift on the hum (+/-0.4 %); random static bursts; thermal noise
//   (the static and hum breathe a little).
// GUI: S / M / L / ? (credits, manual link); drag knobs (Shift = fine), wheel, double-click or Ctrl-click = default;
//   drag the tuning dial sideways (or wheel over it) to tune finely.
// MIDI: 8 voices, click-free stealing (a 3 ms fade), sustain pedal, pitch bend +/-2 st, all-notes-off (CC 120 / 123);
//   released when the transport stops. MIDI passes through.
// Latency: 0 samples.
//
// GUI header art: a desert horizon with a row of white radio dishes (the title's corner plain); the preset bar
//   sits in the row under it, beside the page keys.
// PRESETS: Default, Deep Space Carrier Wave, Shortwave Static Sweep, Electromagnetic Hum, Deep Drone Void, Pulsar
//   Transmission, Stellar Static, Machine Breathing, Cosmic Background, Atmospheric Anomaly, Radio Astronomy (tuned
//   to 1.42 - the hydrogen line's 1420 MHz, scaled), Quiet Signal - level-matched; a preset never starts or stops RUN.
// GUI pages: SOURCES and EFFECTS (the keys under the title); the four FADE lamps show the LFOs on both pages.
// STATUS: v1.0 - in the Lab (Oct 2026).
//   Renamed from VEA77.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-uimin.jsfx-inc
import gfx-glow.jsfx-inc

out_pin:left output
out_pin:right output

slider1:sw_tune=14<1,30,0.001>-SW tune (MHz)
slider2:sw_bw=30<0,100,1>-SW bandwidth (%)
slider3:spread=7<-24,24,0.1>-Sine spread (st)
slider4:hum_f=50<40,70,0.1>-Hum frequency (Hz)
slider5:pops=15<0,100,1>-Pop density (%)
slider6:dl_tl=7<0,12,1{1/32,1/16T,1/16,1/8T,1/16D,1/8,1/4T,1/8D,1/4,1/2T,1/4D,1/2,1 bar}>-Delay L time (sync)
slider7:vol=0<-18,6,0.1>-Output level (dB)
slider8:drift=50<0,100,1>-Drift (%)
slider9:run=0<0,1,1{Stop,Run}>-Run
slider10:sw_dir=1<0,1,1{Locked,Counter-rotating}>-Sweep direction
slider11:rad_lv=50<0,100,1>-Receiver level (%)
slider12:sin_lv=60<0,100,1>-Carrier level (%)
slider13:hum_lv=30<0,100,1>-Hum level (%)
slider14:sw_rate=0.08<0.01,2,0.001:log>-Sweep rate (Hz)
slider15:sw_dep=2<0,12,0.1>-Sweep depth (st)
slider16:buzz=40<0,100,1>-Buzz (%)
slider17:dl_sync=1<0,1,1{Free,Sync}>-Delay time mode
slider18:dl_ml=375<20,2000,1:log>-Delay L time (ms)
slider19:dl_fl=35<0,95,1>-Delay L repeats (%)
slider20:dl_sl=30<0,100,1>-Delay L send (%)
slider21:dl_tone=50<0,100,1>-Delay tone (%)
slider22:dl_tc=8<0,12,1{1/32,1/16T,1/16,1/8T,1/16D,1/8,1/4T,1/8D,1/4,1/2T,1/4D,1/2,1 bar}>-Delay C time (sync)
slider23:dl_mc=500<20,2000,1:log>-Delay C time (ms)
slider24:dl_fc=45<0,95,1>-Delay C repeats (%)
slider25:dl_sc=20<0,100,1>-Delay C send (%)
slider26:dl_tr=10<0,12,1{1/32,1/16T,1/16,1/8T,1/16D,1/8,1/4T,1/8D,1/4,1/2T,1/4D,1/2,1 bar}>-Delay R time (sync)
slider27:dl_mr=750<20,2000,1:log>-Delay R time (ms)
slider28:dl_fr=40<0,95,1>-Delay R repeats (%)
slider29:dl_sr=30<0,100,1>-Delay R send (%)
slider30:fl_rate=0.15<0.02,5,0.001:log>-Flanger rate (Hz)
slider31:fl_dep=50<0,100,1>-Flanger depth (%)
slider32:fl_fb=40<-95,95,1>-Flanger feedback (%)
slider33:fl_mix=50<0,100,1>-Flanger mix (%)
slider34:fl_on=0<0,1,1{Out,In}>-Flanger
slider35:lc_rate=0.05<0.01,2,0.001:log>-Carrier fade rate (Hz)
slider36:lc_dep=0<0,100,1>-Carrier fade depth (%)
slider37:lr_rate=0.03<0.01,2,0.001:log>-Receiver fade rate (Hz)
slider38:lr_dep=0<0,100,1>-Receiver fade depth (%)
slider39:lh_rate=0.07<0.01,2,0.001:log>-Hum fade rate (Hz)
slider40:lh_dep=0<0,100,1>-Hum fade depth (%)
slider41:lp_rate=0.1<0.01,2,0.001:log>-Pop LFO rate (Hz)
slider42:lp_dep=0<0,100,1>-Pop LFO depth (%)
slider43:dl_on=1<0,1,1{Out,In}>-Delay
slider44:bl_den=0<0,100,1>-Bleep density (%)
slider45:bl_pitch=1200<200,4000,1:log>-Bleep pitch (Hz)
slider46:bl_lv=50<0,100,1>-Bleep level (%)
slider47:prs_sel=0<0,12,1{No preset,Default,Deep Space Carrier Wave,Shortwave Static Sweep,Electromagnetic Hum,Deep Drone Void,Pulsar Transmission,Stellar Static,Machine Breathing,Cosmic Background,Atmospheric Anomaly,Radio Astronomy,Quiet Signal}>-Preset

@init
#ui_man = "gfx-g-ea77";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

// ---------- memory map ----------
NV = 8;  VS = 32;  VOX = 0;              // voice records (NV keys + the drone at index NV)
MQ = 4096;  MQMAX = 1000;
VD = 1000;                               // voice lamps (audio -> GUI)
STN = 1100;  SS = 24;                    // 5 station oscillators: STN + i * SS
DL0 = 1048576;  DLN = 524288;            // the LCR delay's three lines (L, C, R): DL0 + k * DLN (up to 2.7 s at 192 kHz)
FLB = 10000;  FLN = 4096;                // the flanger's two lines (L, R)
F_ON = 0;  F_NOTE = 1;  F_VEL = 2;  F_AGE = 3;  F_GATE = 4;  F_SUS = 5;
F_ENV = 6;  F_AST = 7;  F_FADE = 8;  F_STEAL = 9;  F_PEND = 10;  F_PVEL = 11;
F_PA = 12;  F_PB = 13;  F_IA = 14;  F_IB = 15;  F_GAIN = 16;  F_NDT = 17;  F_OFS = 18;
// station fields
S_SLOT = 0;  S_AMP = 1;  S_TGT = 2;  S_PH = 3;  S_PH2 = 4;  S_TYPE = 5;  S_FREQ = 6;
S_FD = 7;  S_FT = 8;  S_FTM = 9;                       // fading: value, target, timer
S_KEY = 10;  S_KT = 11;  S_KE = 12;                    // morse / data keying: state, timer, keying envelope
S_B1 = 13;  S_B2 = 14;  S_B3 = 15;  S_B4 = 16;        // voice-like: two formant band-passes (state)
S_F1 = 17;  S_F2 = 18;  S_SYL = 19;  S_SYT = 20;  S_NZ = 21;   // formants, syllable level, timer, noise state
memset(VOX, 0, (NV + 1) * VS);  memset(STN, 0, 5 * SS);  memset(DL0, 0, 3 * DLN);  memset(FLB, 0, 2 * FLN);
k = 0;  loop(5, STN[k * SS + S_SLOT] = -100;  k += 1; );

// ---------- helpers ----------
function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
// one LCR delay line k: read at d samples (between samples), the repeats through the TONE filter and a soft top
DZ = 1300;                               // the lines' filter states: DZ + k * 2
function dl_line(k, d, x, fb) local(b, p, i, f, j, e, z) (
  b = DL0 + k * DLN;  z = DZ + k * 2;
  p = dl_w - d;  p < 0 ? p += DLN;  i = floor(p);  f = p - i;  j = i + 1;  j >= DLN ? j = 0;
  e = b[i] + (b[j] - b[i]) * f;
  z[0] += (e - z[0]) * dlp_c;  z[1] += (z[0] - z[1]) * dhp_c;  e = z[0] - z[1];
  b[dl_w] = ts((x + e * fb) * 1.1) / 1.1;
  e;
);
function hsh(k, salt) local(v) ( v = sin(k * 12.9898 + salt * 78.233) * 43758.5453;  v - floor(v); );

// ---------- voices ----------
function v_inc(b) local(n) (
  n = b[F_NOTE] + bend + b[F_NDT];
  b[F_IA] = min(0.45, 440 * 2 ^ ((n - 69 + sw_dp * lfo_a) / 12) / srate);
  b[F_IB] = min(0.45, 440 * 2 ^ ((n - 69 + spr_s + sw_dp * lfo_b) / 12) / srate);
);
function v_start(b, note, vel) (
  b[F_ON] = 1;  b[F_NOTE] = note;  b[F_VEL] = vel;  b[F_GATE] = 1;  b[F_SUS] = 0;  b[F_AST] = 1;
  age_n += 1;  b[F_AGE] = age_n;  b[F_FADE] = 1;  b[F_STEAL] = 0;
  b[F_GAIN] = 0.6 + 0.4 * vel / 127;
  b[F_NDT] = (rand(2) - 1) * 0.06 * dm_a;
  b[F_ENV] < 0.0005 ? ( b[F_PA] = rand(1);  b[F_PB] = rand(1); );
  v_inc(b);
);
function v_alloc(note, vel) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? b[F_ENV] : 2 + b[F_AGE];
    b[F_ON] && b[F_NOTE] == note && !b[F_STEAL] ? q = -2;
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  b = VOX + best * VS;
  b[F_ON] && b[F_ENV] > 0.0005 && b[F_NOTE] != note ? ( b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel; ) : v_start(b, note, vel);
);
function v_release(note) local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_NOTE] == note ? ( sustain ? ( b[F_SUS] = 1; ) : ( b[F_AST] = 2; );  b[F_GATE] = 0; );
    b[F_STEAL] && b[F_PEND] == note ? b[F_PEND] = -1;
    v += 1; );
);
function v_all_off() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_ON] ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_AST] = 2; );  v += 1; ); );
function v_pedal_up() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_SUS] ? ( b[F_SUS] = 0;  b[F_AST] = 2; );  v += 1; ); );
function midi_event(i) local(mst, d1, d2, c) (
  mst = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  mst == 0x90 && d2 > 0 ? ( v_alloc(d1, d2);  last_note = d1; ) :
  (mst == 0x80 || (mst == 0x90 && d2 == 0)) ? v_release(d1) :
  mst == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  mst == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);
// one voice, one sample: two sines, each panned on its loop
function v_run(b) local(a, g, pa, pb, sa, sb) (
  b[F_AST] == 1 ? b[F_ENV] = min(1, b[F_ENV] + at_inc) : (
    b[F_ENV] *= rl_c;  b[F_ENV] < 0.00005 && !b[F_STEAL] ? ( b[F_ENV] = 0;  b[F_ON] = 0; ); );
  g = b[F_ENV] * b[F_ENV] * b[F_GAIN] * b[F_FADE];
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? ( b[F_FADE] = 0;  b[F_STEAL] = 0;  b[F_ENV] = 0;
      b[F_PEND] >= 0 ? v_start(b, b[F_PEND], b[F_PVEL]) : b[F_ON] = 0; );
  );
  pa = b[F_PA] + b[F_IA];  pa >= 1 ? pa -= 1;  b[F_PA] = pa;
  pb = b[F_PB] + b[F_IB];  pb >= 1 ? pb -= 1;  b[F_PB] = pb;
  sa = sin(2 * $pi * pa) * g;  sb = sin(2 * $pi * pb) * g;
  cxL += sa * pan_al + sb * pan_bl;  cxR += sa * pan_ar + sb * pan_br;
);

// ---------- the receiver: stations on a hashed grid (one slot = 0.25 MHz) ----------
// TWEAK: how many slots hold a station, and how far a whistle rises per MHz off tune
ST_P = 0.55;  WH_K = 35000;
// a station oscillator for slot s (index s mod 5): (re)assign when the slot changes
function st_assign(b, s) (
  b[S_SLOT] = s;
  b[S_TYPE] = hsh(s, 1) < ST_P ? 1 + floor(hsh(s, 3) * 4) : 0;    // 0 none, 1 carrier, 2 morse, 3 data, 4 voice
  b[S_KEY] = 0;  b[S_KT] = 0;  b[S_SYT] = 0;
);
// per control tick: the station's level and pitch from the tuning
function st_tick(b, tn) local(s, c, o, pw, a) (
  s = b[S_SLOT];
  b[S_TYPE] > 0 ? (
    c = (s + 0.2 + 0.6 * hsh(s, 2)) * 0.25;  o = abs(tn - c);
    pw = 0.03 + 0.12 * bw_s;
    a = o < pw ? (1 - o / pw) : 0;  a *= a * (0.35 + 0.65 * hsh(s, 4)) * 1.8;
    // RF fading (DRIFT): each station its own slow swell and fade
    b[S_FTM] -= CR / srate * dm_s;  b[S_FTM] <= 0 ? ( b[S_FT] = rand(1);  b[S_FTM] = 1.5 + rand(4); );
    b[S_FD] += (b[S_FT] - b[S_FD]) * fd_c;
    a *= 1 - min(0.95, 0.55 * dm_a) * b[S_FD];
    b[S_TGT] = a;
    b[S_FREQ] = o * WH_K + (b[S_TYPE] == 2 ? 520 : b[S_TYPE] == 3 ? 380 : 0);
    // keying: morse (dits and dahs at about 14 wpm) and data (45 baud, two tones)
    b[S_KT] -= CR / srate;
    b[S_TYPE] == 2 && b[S_KT] <= 0 ? (
      b[S_KEY] ? ( b[S_KEY] = 0;  b[S_KT] = rand(1) < 0.2 ? 0.26 : 0.086; )
               : ( b[S_KEY] = 1;  b[S_KT] = rand(1) < 0.35 ? 0.26 : 0.086; );
    );
    b[S_TYPE] == 3 && b[S_KT] <= 0 ? ( b[S_KEY] = rand(1) < 0.5;  b[S_KT] = 0.022; );
    // voice-like: syllables (a level and two formants that move)
    b[S_TYPE] == 4 ? (
      b[S_SYT] -= CR / srate;
      b[S_SYT] <= 0 ? ( b[S_SYT] = 0.08 + (rand(1) * 0.25);  b[S_SYL] = rand(1) < 0.18 ? 0 : 0.4 + (rand(1) * 0.6);
        b[S_F1] = 300 + rand(600);  b[S_F2] = 900 + rand(1600); );
    );
  ) : b[S_TGT] = 0;
);
function st_run(b) local(a, f, y, t, g, d1, d2, x) (
  b[S_AMP] += (b[S_TGT] - b[S_AMP]) * am_c;
  a = b[S_AMP];  y = 0;
  a > 0.00005 ? (
    t = b[S_TYPE];
    t == 3 ? f = b[S_FREQ] + (b[S_KEY] ? 170 : 0) : f = b[S_FREQ];
    b[S_PH] += min(0.45, f / srate);  b[S_PH] -= floor(b[S_PH]);
    t == 1 ? y = sin(2 * $pi * b[S_PH]) :
    t == 2 ? ( b[S_KE] += ((b[S_KEY] ? 1 : 0) - b[S_KE]) * key_c;  y = sin(2 * $pi * b[S_PH]) * b[S_KE]; ) :
    t == 3 ? y = sin(2 * $pi * b[S_PH]) * 0.8 :
    (
      // a garbled voice: noise through two moving formants, chopped into syllables, a faint carrier under it
      b[S_KE] += (b[S_SYL] - b[S_KE]) * syl_c;
      x = rand(2) - 1;  b[S_NZ] += (x - b[S_NZ]) * 0.5;
      g = tan($pi * min(b[S_F1], 0.4 * srate) / srate);  d1 = b[S_B1];  d2 = b[S_B2];
      d1 += g * (b[S_NZ] - d2 - d1 * 0.35);  d2 += g * d1;  b[S_B1] = d1;  b[S_B2] = d2;
      g = tan($pi * min(b[S_F2], 0.4 * srate) / srate);  y = d1;  d1 = b[S_B3];  d2 = b[S_B4];
      d1 += g * (b[S_NZ] - d2 - d1 * 0.3);  d2 += g * d1;  b[S_B3] = d1;  b[S_B4] = d2;
      y = (y * 1.4 + d1 * 0.9) * b[S_KE] + sin(2 * $pi * b[S_PH]) * 0.15;
    );
    y *= a;
  );
  y;
);

bend = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  last_note = 36;  lp_ph = 0;  hum_ph = 0;  sc_e = 0;
tn_s = sw_tune;  bw_s = sw_bw / 100;  rx_dk = 1;  spr_s = spread;  sw_dp = sw_dep;
rf.drift_init(0.7 + (rand(1) * 0.3));  pl.drift_init(0.5 + (rand(1) * 0.3));  th.drift_init(1.1 + (rand(1) * 0.4));
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();

function update_params() (
  drift_macro(drift);
  at_inc = 1 / max(1, 0.35 * srate);  rl_c = exp(-6.9 / max(1, 1.8 * srate));        // TWEAK: the carrier's swell and fade
  fade_step = 1 / (0.003 * srate);
  sm_c = 1 - exp(-1 / (0.03 * srate));  sw_c = 1 - exp(-1 / (0.012 * srate));                                                // levels glide over 30 ms
  tn_c = 1 - exp(-1 / (0.06 * srate));                                                // the tuning glides over 60 ms
  am_c = 1 - exp(-1 / (0.008 * srate));  key_c = 1 - exp(-1 / (0.004 * srate));  syl_c = 1 - exp(-1 / (0.02 * srate));
  fd_c = 1 - exp(-CR * dm_s / (1.5 * srate));
  se_a = 1 / max(1, 0.6 * srate);  se_r = exp(-6.9 / max(1, 2.5 * srate));          // the soundscape's swell and fade (RUN / keys)
  sin_t = sin_lv / 100 * 0.16;  rad_t = rad_lv / 100 * 0.9;  hum_t = hum_lv / 100 * 0.32;
  out_t = 10 ^ (vol / 20);
  bz_t = buzz / 100;
  // ECHO: the feedback filter (TONE: low-pass 700 Hz - 9.8 kHz, high-pass 120 - 360 Hz), feedback, mix
  dt = dl_tone / 100;
  dlp_c = 1 - exp(-2 * $pi * 700 * 14 ^ dt / srate);  dhp_c = 1 - exp(-2 * $pi * 120 * 3 ^ dt / srate);
  dfb_t0 = dl_fl / 100 * 0.95;  dfb_t1 = dl_fc / 100 * 0.95;  dfb_t2 = dl_fr / 100 * 0.95;   // REPEATS
  dsn_t0 = dl_sl / 100;  dsn_t1 = dl_sc / 100;  dsn_t2 = dl_sr / 100;                          // SENDS
  dtm_c = 1 - exp(-1 / (0.15 * srate));                                              // a time change glides over 150 ms
  // FLANGER: 0.6 - 7 ms swept by its LFO (L and R a quarter turn apart), feedback, mix
  ffb_t = fl_fb / 100 * 0.92;  fmx_t = fl_mix / 100;  fdp_t = fl_dep / 100;
  // POPS: events per second (0 - 40, curved so the low end is fine-grained)
  pop_rate = (pops / 100) ^ 2 * 40;
  bl_rate = (bl_den / 100) ^ 2 * 6;                                   // BLEEPS: phrases a second (0 - 6)
  bl_t = bl_lv / 100 * 0.35;
);
update_params();
sin_g = sin_t;  bl_g = bl_t;  rad_g = rad_t;  hum_g = hum_t;  out_g = out_t;  bz_s = bz_t;  dl_w = 0;  dtm_s0 = -1;  fl_w = 0;  fl_ph = 0;
dfb0 = dfb_t0;  dfb1 = dfb_t1;  dfb2 = dfb_t2;  dsn0 = dsn_t0;  dsn1 = dsn_t1;  dsn2 = dsn_t2;  ffb_g = ffb_t;  fmx_g = fmx_t;  fdp_g = fdp_t;
fl_x = fl_on >= 0.5;  dl_x = dl_on >= 0.5;  lfc_ph = 0;  lfr_ph = 0;  lfh_ph = 0;  lfp_ph = 0;
// a tempo division (the delay's TIME enum) in beats
function div_beats(d) ( d = floor(d + 0.5);
  d == 0 ? 0.125 : d == 1 ? 1 / 6 : d == 2 ? 0.25 : d == 3 ? 1 / 3 : d == 4 ? 0.375 : d == 5 ? 0.5 : d == 6 ? 2 / 3 : d == 7 ? 0.75 :
  d == 8 ? 1 : d == 9 ? 4 / 3 : d == 10 ? 1.5 : d == 11 ? 2 : 4; );

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function param_touched_au(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 14); pv(2, 30); pv(3, 7); pv(4, 50); pv(5, 15); pv(7, 0); pv(8, 50); pv(10, 1); pv(11, 50); pv(12, 60);
  pv(13, 30); pv(14, 0.08); pv(15, 2); pv(16, 40); pv(17, 1); pv(18, 375); pv(19, 35); pv(20, 30); pv(21, 50);
  pv(6, 7); pv(22, 8); pv(23, 500); pv(24, 45); pv(25, 20); pv(26, 10); pv(27, 750); pv(28, 40); pv(29, 30);
  pv(30, 0.15); pv(31, 50); pv(32, 40); pv(33, 50); pv(34, 0); pv(35, 0.05); pv(36, 0); pv(37, 0.03); pv(38, 0);
  pv(39, 0.07); pv(40, 0); pv(41, 0.1); pv(42, 0); pv(43, 1); pv(44, 0); pv(45, 1200); pv(46, 50);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? ( // DEEP SPACE CARRIER WAVE
    pv(1, 21.6); pv(3, 12); pv(5, 5); pv(7, 0.6); pv(11, 15); pv(12, 80); pv(13, 0); pv(14, 0.03); pv(15, 4); pv(19, 50); pv(20, 25); pv(21, 35); pv(24, 50); pv(25, 15); pv(28, 50); pv(29, 25); pv(30, 0.05); pv(31, 60); pv(32, 50); pv(33, 40); pv(34, 1); pv(35, 0.04); pv(36, 40); pv(44, 25); pv(45, 1500);
  );
  p == 3 ? ( // SHORTWAVE STATIC SWEEP
    pv(1, 9.5); pv(2, 70); pv(5, 25); pv(7, 5.3); pv(8, 90); pv(11, 85); pv(12, 15); pv(13, 10); pv(20, 15); pv(25, 20); pv(29, 15);
  );
  p == 4 ? ( // ELECTROMAGNETIC HUM
    pv(2, 15); pv(3, 0.5); pv(4, 60); pv(5, 30); pv(7, -4.3); pv(11, 20); pv(12, 25); pv(13, 80); pv(15, 0.3); pv(16, 75); pv(30, 0.08); pv(31, 40); pv(32, -60); pv(33, 35); pv(34, 1); pv(39, 0.1); pv(40, 30); pv(41, 0.2); pv(42, 60);
  );
  p == 5 ? ( // DEEP DRONE VOID
    pv(2, 10); pv(3, -12); pv(4, 42); pv(5, 0); pv(6, 11); pv(7, -2); pv(11, 10); pv(12, 70); pv(13, 15); pv(14, 0.02); pv(15, 1); pv(16, 10); pv(19, 70); pv(20, 35); pv(21, 25); pv(22, 12); pv(24, 70); pv(25, 30); pv(26, 9); pv(28, 70); pv(29, 35); pv(30, 0.03); pv(31, 80); pv(32, 70); pv(33, 45); pv(34, 1);
  );
  p == 6 ? ( // PULSAR TRANSMISSION
    pv(1, 1.6); pv(3, 24); pv(5, 70); pv(6, 4); pv(7, 1.4); pv(11, 25); pv(12, 60); pv(15, 0); pv(19, 40); pv(20, 30); pv(21, 70); pv(25, 0); pv(26, 5); pv(28, 40); pv(29, 30); pv(35, 1.5); pv(36, 100); pv(41, 1.5); pv(42, 100); pv(44, 40); pv(45, 900);
  );
  p == 7 ? ( // STELLAR STATIC
    pv(1, 27.5); pv(2, 100); pv(3, 19); pv(5, 45); pv(7, -0); pv(11, 70); pv(12, 20); pv(19, 55); pv(20, 20); pv(21, 80); pv(24, 55); pv(25, 20); pv(28, 55); pv(29, 20); pv(30, 0.2); pv(31, 30); pv(32, 30); pv(33, 30); pv(34, 1); pv(41, 0.07); pv(42, 50);
  );
  p == 8 ? ( // MACHINE BREATHING
    pv(3, 5); pv(5, 10); pv(7, -2.9); pv(11, 15); pv(12, 40); pv(13, 60); pv(16, 50); pv(20, 10); pv(25, 10); pv(29, 10); pv(30, 0.25); pv(31, 50); pv(32, 60); pv(33, 50); pv(34, 1); pv(35, 0.25); pv(36, 70); pv(37, 0.13); pv(38, 60); pv(39, 0.25); pv(40, 80);
  );
  p == 9 ? ( // COSMIC BACKGROUND
    pv(1, 3.2); pv(2, 85); pv(3, 7); pv(5, 20); pv(7, 5.8); pv(11, 55); pv(12, 30); pv(13, 0); pv(14, 0.05); pv(15, 3); pv(19, 65); pv(20, 30); pv(21, 40); pv(24, 65); pv(25, 25); pv(28, 65); pv(29, 30); pv(30, 0.04); pv(33, 30); pv(34, 1); pv(37, 0.05); pv(38, 30); pv(42, 40); pv(44, 20); pv(45, 2600);
  );
  p == 10 ? ( // ATMOSPHERIC ANOMALY
    pv(1, 13.7); pv(2, 50); pv(3, -5); pv(5, 35); pv(7, 0.8); pv(11, 40); pv(12, 55); pv(14, 0.3); pv(15, 9); pv(17, 0); pv(18, 333); pv(19, 60); pv(23, 777); pv(24, 60); pv(27, 555); pv(28, 60); pv(30, 0.4); pv(31, 90); pv(32, -80); pv(33, 50); pv(34, 1); pv(35, 0.11); pv(36, 60); pv(37, 0.07); pv(38, 70); pv(39, 0.2); pv(40, 50); pv(44, 30); pv(45, 2200);
  );
  p == 11 ? ( // RADIO ASTRONOMY
    pv(1, 1.42); pv(2, 40); pv(3, 12); pv(4, 60); pv(5, 10); pv(7, 3.2); pv(11, 60); pv(12, 35); pv(13, 20); pv(15, 0.5); pv(16, 20); pv(19, 45); pv(20, 20); pv(24, 45); pv(25, 20); pv(28, 45); pv(29, 20); pv(37, 0.05); pv(38, 40); pv(44, 35); pv(45, 1200);
  );
  p == 12 ? ( // QUIET SIGNAL
    pv(2, 10); pv(3, 7); pv(5, 5); pv(7, 5.3); pv(11, 60); pv(12, 50); pv(13, 15); pv(14, 0.04); pv(15, 1); pv(16, 10); pv(19, 40); pv(20, 25); pv(21, 30); pv(24, 40); pv(25, 15); pv(28, 40); pv(29, 25); pv(35, 0.03); pv(36, 50); pv(44, 15); pv(45, 700); pv(46, 40);
  );
  i = 1;  loop(46, i != 9 ? param_touched_au(i);  i += 1; );
  tjump_dirty = 1;
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? v_all_off();  tp_was = tp_now;
prm_dirty ? ( prm_dirty = 0;  update_params(); );
tjump_dirty ? ( tjump_dirty = 0;  jmp_st = 1; );
bt = samplesblock / srate;
// DRIFT: the receiver wanders (+/-20 kHz), the mains drifts (+/-0.4 %), the static and hum breathe (thermal)
rf_w = rf.drift_tick(0.12 * bt * dm_s) * 0.02 * dm_a;
pl_w = pl.drift_tick(0.1 * bt * dm_s) * 0.004 * dm_a;
th_w = th.drift_tick(0.3 * bt * dm_s) * 0.3 * dm_a;
// random static bursts (DRIFT): now and then the band crashes for a moment
bst_t -= bt;  bst_t <= 0 ? ( bst_t = (2 + rand(10)) / max(0.2, dm_a);  bst_n = dm_a > 0.01 ? 0.05 + (rand(1) * 0.4) : 0;  bst_lv = 1 + (rand(1) * 1.2) * dm_a; );
bst_n > 0 ? bst_n -= bt;
bst_tg = bst_n > 0 ? bst_lv : 1;
// any key down (or RUN): the soundscape runs
held_any = 0;  vb = VOX;  loop(NV, (vb[F_ON] && (vb[F_GATE] || vb[F_SUS])) ? held_any = 1;  vb += VS; );
scape_on = run >= 0.5 || held_any;
// the drone: while RUN is lit and no key is held, a carrier at the last key
dr = VOX + NV * VS;
run >= 0.5 && !held_any ? (
  !dr[F_ON] || !dr[F_GATE] || dr[F_NOTE] != last_note ? (
    dr[F_ON] && dr[F_GATE] && dr[F_NOTE] != last_note ? ( dr[F_STEAL] = 1;  dr[F_PEND] = last_note;  dr[F_PVEL] = 100; )
                                                     : !dr[F_STEAL] ? v_start(dr, last_note, 100);
  );
) : ( dr[F_ON] && dr[F_GATE] ? ( dr[F_GATE] = 0;  dr[F_AST] = 2; ); );
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
outpk_d = max(outpk_d, outpk);  outpk = 0;  sm_d = max(sm_d * 0.9, smv);
k = 0;  loop(NV + 1, VD[k] = VOX[k * VS + F_ON] ? VOX[k * VS + F_ENV] : 0;  k += 1; );
tn_d = tn_s;
// LCR DELAY: each line's time (a note value at the tempo, or ms), in samples
bsec = 60 / max(tempo, 20);  dmax = DLN / srate - 0.01;
dtm_t0 = max(0.01, min(dmax, dl_sync >= 0.5 ? div_beats(dl_tl) * bsec : dl_ml / 1000)) * srate;
dtm_t1 = max(0.01, min(dmax, dl_sync >= 0.5 ? div_beats(dl_tc) * bsec : dl_mc / 1000)) * srate;
dtm_t2 = max(0.01, min(dmax, dl_sync >= 0.5 ? div_beats(dl_tr) * bsec : dl_mr / 1000)) * srate;
dtm_s0 < 0 ? ( dtm_s0 = dtm_t0;  dtm_s1 = dtm_t1;  dtm_s2 = dtm_t2; );
// the fade LFOs (one per generator) and the pop LFO: level = 1 - DEPTH x (0 .. 1 .. 0), starting at full
lfc_ph += lc_rate * bt;  lfc_ph -= floor(lfc_ph);  lfr_ph += lr_rate * bt;  lfr_ph -= floor(lfr_ph);
lfh_ph += lh_rate * bt;  lfh_ph -= floor(lfh_ph);  lfp_ph += lp_rate * bt;  lfp_ph -= floor(lfp_ph);
fdc = 1 - lc_dep / 100 * (0.5 - 0.5 * cos(2 * $pi * lfc_ph));  fdr = 1 - lr_dep / 100 * (0.5 - 0.5 * cos(2 * $pi * lfr_ph));
fdh = 1 - lh_dep / 100 * (0.5 - 0.5 * cos(2 * $pi * lfh_ph));  fdp = 1 - lp_dep / 100 * (0.5 - 0.5 * cos(2 * $pi * lfp_ph));
fdc_d = fdc;  fdr_d = fdr;  fdh_d = fdh;  fdp_d = fdp;
pop_now = pop_rate * fdp;
pop_d = max(pop_d * 0.8, pop_flash);  pop_flash = 0;  bl_d = max(bl_d * 0.8, bl_flash);  bl_flash = 0;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

// ---------- control tick ----------
cr_n <= 0 ? (
  cr_n = CR;
  spr_s += (spread - spr_s) * 0.05;  sw_dp += (sw_dep - sw_dp) * 0.05;  bw_s += (sw_bw / 100 - bw_s) * 0.05;
  // the two sweep loops: COUNTER-ROTATE turns the second against the first
  lp_ph += sw_rate * CR / srate;  lp_ph -= floor(lp_ph);
  lfo_a = sin(2 * $pi * lp_ph);  cs = cos(2 * $pi * lp_ph);
  dir_s += ((sw_dir >= 0.5 ? -1 : 1) - dir_s) * 0.02;                  // the switch glides
  lfo_b = lfo_a * dir_s;
  pan_al = sqrt(0.5 - 0.4 * cs);  pan_ar = sqrt(0.5 + 0.4 * cs);
  pan_bl = sqrt(0.5 - 0.4 * cs * dir_s);  pan_br = sqrt(0.5 + 0.4 * cs * dir_s);
  vb = VOX;  loop(NV + 1, vb[F_ON] ? v_inc(vb);  vb += VS; );
  // the receiver: five station slots around the tuning
  tk = tn_s + rf_w;  sk = floor(tk * 4);
  k = 0;
  loop(5,
    sl = sk - 2 + k;  sb = STN + (((sl % 5) + 5) % 5) * SS;
    sb[S_SLOT] != sl ? st_assign(sb, sl);
    st_tick(sb, tk);
    k += 1;
  );
  // the receiver's audio filter (BANDWIDTH): low-pass 2.4 - 7 kHz, the static's band-pass
  rx_g = tan($pi * (2200 + 3300 * bw_s) / srate);  rx_k = 1.2;     // TWEAK: the receiver's top (2.2 - 5.5 kHz)
  sf_g = tan($pi * (1100 + 1900 * bw_s) / srate);  sf_k = 1 / (0.6 + 2.4 * bw_s) ;
);
cr_n -= 1;

tn_s += (sw_tune - tn_s) * tn_c;
rx_dk += ((jmp_st || abs(sw_tune - tn_s) > 1 ? 0 : 1) - rx_dk) * sw_c;    // a long jump: the receiver ducks while it travels
jmp_st && rx_dk < 0.01 ? ( tn_s = sw_tune;  jmp_st = 0; );               // a preset: duck, retune at once, come back
sin_g += (sin_t * fdc - sin_g) * sm_c;  rad_g += (rad_t * fdr - rad_g) * sm_c;  hum_g += (hum_t * fdh - hum_g) * sm_c;  out_g += (out_t - out_g) * sm_c;
bz_s += (bz_t - bz_s) * sm_c;  bst_s += (bst_tg - bst_s) * 0.002;
sc_e = scape_on ? min(1, sc_e + se_a) : sc_e * se_r;

// ---------- CARRIER ----------
cxL = 0;  cxR = 0;  vb = VOX;
loop(NV + 1, vb[F_ON] ? v_run(vb);  vb += VS; );
yl = cxL * sin_g;  yr = cxR * sin_g;

// ---------- RECEIVER ----------
sc_e > 0.00002 || st_live ? (
  stv = 0;  st_live = 0;  k = 0;
  loop(5, sb = STN + k * SS;  stv += st_run(sb);  st_live += sb[S_AMP];  k += 1; );
  st_live = st_live > 0.0001;
  // static: two noise sources (a little stereo), pinkish, through the band-pass; a strong station pushes it down
  n1 = rand(2) - 1;  n2 = rand(2) - 1;  pk1 += (n1 - pk1) * 0.2;  pk2 += (n2 - pk2) * 0.2;
  sbl += sf_g * (pk1 - sbl2 - sbl * sf_k);  sbl2 += sf_g * sbl;
  sbr += sf_g * (pk2 - sbr2 - sbr * sf_k);  sbr2 += sf_g * sbr;
  agc = 1 / (1 + 3 * abs(stv));
  sst = 0.24 * (1 + th_w * 0.6) * bst_s * agc * (0.75 + 0.25 * bw_s);   // TWEAK: the static (kept below the stations)
  rl = stv + sbl * sst;  rr = stv + sbr * sst;
  // the receiver's audio filter (2-pole low-pass), then a little speaker grit
  r1l += rx_g * (rl - r2l - r1l * rx_k);  r2l += rx_g * r1l;
  r1r += rx_g * (rr - r2r - r1r * rx_k);  r2r += rx_g * r1r;
  rl = ts(r2l * 1.6) / 1.6;  rr = ts(r2r * 1.6) / 1.6;
  smv = max(smv * 0.9995, abs(stv) * 2 + abs(sbl * sst) * 0.4);
  rg = rad_g * sc_e * rx_dk;
  yl += rl * rg;  yr += rr * rg;
) : smv *= 0.9995;

// ---------- POPS: clicks, crackle bursts, low thumps; some go into the echo ----------
pxl = 0;  pxr = 0;  pel = 0;  per = 0;
sc_e > 0.00002 && pop_rate > 0 ? (
  rand(1) < pop_now / srate ? (
    pk_r = rand(1);  pk_pan = rand(1);  pk_s = rand(1) < 0.4;  pop_flash = 1;
    pk_r < 0.6 ? ( ck_a = (0.04 + (rand(1) * 0.3)) * (rand(1) < 0.5 ? 1 : -1);  ck_c = 1 - exp(-2 * $pi * (2000 + rand(6000)) / srate);  ck_n = floor((0.0003 + (rand(1) * 0.0008)) * srate);  ck_pan = pk_pan;  ck_s = pk_s; ) :
    pk_r < 0.85 ? ( cb_n = floor((0.02 + (rand(1) * 0.13)) * srate);  cb_pan = pk_pan;  cb_s = pk_s; ) :
    ( th_f = 70 + rand(230);  th_e = 0.15 + (rand(1) * 0.35);  th_dc = exp(-1 / ((0.02 + (rand(1) * 0.04)) * srate));  th_ph = 0;  th_pan = pk_pan;  th_s = pk_s; );
  );
  // a crackle burst: tiny clicks at about 400 a second
  cb_n > 0 ? ( cb_n -= 1;  rand(1) < 400 / srate ? ( ck_a = (0.02 + (rand(1) * 0.1)) * (rand(1) < 0.5 ? 1 : -1);  ck_c = 1 - exp(-2 * $pi * (3000 + rand(5000)) / srate);
    ck_n = floor((0.0002 + (rand(1) * 0.0004)) * srate);  ck_pan = min(1, max(0, cb_pan + (rand(1) * 0.3) - 0.15));  ck_s = cb_s; ); );
  // a click: a short burst of filtered noise
  ck_n > 0 ? ( ck_n -= 1;  ck_z += (ck_a * (0.6 + (rand(1) * 0.8)) - ck_z) * ck_c;  ck_n == 0 ? ck_a = 0; ) : ck_z *= 0.7;
  pv = ck_z;  pg = ck_pan;
  pxl += pv * sqrt(1 - pg);  pxr += pv * sqrt(pg);
  ck_s ? ( pel += pv * sqrt(1 - pg);  per += pv * sqrt(pg); );
  // a thump: a decaying low sine
  th_e > 0.0003 ? (
    th_ph += th_f / srate;  th_ph -= floor(th_ph);  pv = sin(2 * $pi * th_ph) * th_e;  th_e *= th_dc;
    pxl += pv * sqrt(1 - th_pan);  pxr += pv * sqrt(th_pan);
    th_s ? ( pel += pv * sqrt(1 - th_pan);  per += pv * sqrt(th_pan); );
  );
  pxl *= sc_e;  pxr *= sc_e;  pel *= sc_e;  per *= sc_e;
);

yl += pxl * 0.8;  yr += pxr * 0.8;                                      // the pops, dry

// ---------- HUM ----------
sc_e > 0.00002 ? (
  hum_ph += hum_f * (1 + pl_w) / srate;  hum_ph -= floor(hum_ph);
  hx = sin(2 * $pi * hum_ph);
  hy = hx * 0.75 + sin(4 * $pi * hum_ph) * 0.3;                          // a clean hum: the fundamental and its 2nd
  hz = ts(hx * 5) * 0.45 + (abs(hx) - 0.637) * 0.9;                       // BUZZ: rectified, clipped iron
  hm = hy + (hz - hy) * bz_s;
  hl1 += (hm - hl1) * 0.25;  hl2 += (hl1 - hl2) * 0.25;                  // tame the very top
  hm = hl2 * hum_g * sc_e * (1 + th_w * 0.3);
  yl += hm;  yr += hm;
);

// ---------- BLEEPS: short computer bleeps and boops in little phrases (1 - 5 notes), sent hard into the delay ----------
bl_g += (bl_t - bl_g) * sm_c;  blx = 0;  bly = 0;  ble = 0;
sc_e > 0.00002 && (bl_rate > 0 || bl_n > 0 || bl_e > 0.0001) ? (
  bl_n <= 0 && bl_rate > 0 && rand(1) < bl_rate / srate ? (
    bl_n = 1 + floor(rand(5));  bl_k = 0;  bl_pan = 0.15 + (rand(1) * 0.7);  bl_sq = rand(1) < 0.45;     // a phrase: square bleeps or sine boops
    bl_step = floor((0.05 + (rand(1) * 0.1)) * srate);  bl_lenf = 0.4 + (rand(1) * 0.5);
  );
  // each note: a pitch from a five-note scale around BLEEP PITCH (two octaves), a quick attack, a short decay
  bl_n > 0 ? (
    bl_k <= 0 ? (
      bl_n -= 1;  bl_k = bl_step;  bl_iv = floor(rand(10));
      bl_f = bl_pitch * 2 ^ (((bl_iv % 5 == 0 ? 0 : bl_iv % 5 == 1 ? 2 : bl_iv % 5 == 2 ? 4 : bl_iv % 5 == 3 ? 7 : 9) + 12 * floor(bl_iv / 5) - 6) / 12);
      bl_e = max(bl_e, 0.0001);  bl_a = 1;  bl_dc = exp(-1 / (bl_step * bl_lenf * 0.45));  bl_flash = 1;
    );
    bl_k -= 1;
  );
  bl_a ? ( bl_e += (1 - bl_e) * 0.02;  bl_e > 0.97 ? bl_a = 0; ) : bl_e *= bl_dc;
  bl_ph += min(0.45, bl_f / srate);  bl_ph -= floor(bl_ph);
  blv = bl_sq ? ts(sin(2 * $pi * bl_ph) * 3) * 0.6 : sin(2 * $pi * bl_ph);
  blv *= bl_e * bl_g * sc_e;
  blx = blv * sqrt(1 - bl_pan);  bly = blv * sqrt(bl_pan);  ble = blv;
  yl += blx;  yr += bly;
);

// ---------- FLANGER (title lamp: in / out, crossfaded) ----------
fl_x += ((fl_on >= 0.5) - fl_x) * sw_c;
ffb_g += (ffb_t - ffb_g) * sm_c;  fmx_g += (fmx_t - fmx_g) * sm_c;  fdp_g += (fdp_t - fdp_g) * sm_c;
fl_x > 0.0001 ? (
  fl_ph += fl_rate / srate;  fl_ph -= floor(fl_ph);
  fda = (0.6 + 6.4 * fdp_g * (0.5 - 0.5 * cos(2 * $pi * fl_ph))) * 0.001 * srate;
  fdb = (0.6 + 6.4 * fdp_g * (0.5 - 0.5 * sin(2 * $pi * fl_ph))) * 0.001 * srate;
  rp = fl_w - fda;  rp < 0 ? rp += FLN;  ri = floor(rp);  rf = rp - ri;  rj = ri + 1;  rj >= FLN ? rj = 0;
  fo_l = FLB[ri] + (FLB[rj] - FLB[ri]) * rf;
  rp = fl_w - fdb;  rp < 0 ? rp += FLN;  ri = floor(rp);  rf = rp - ri;  rj = ri + 1;  rj >= FLN ? rj = 0;
  fo_r = FLB[FLN + ri] + (FLB[FLN + rj] - FLB[FLN + ri]) * rf;
  FLB[fl_w] = ts(yl + fo_l * ffb_g);  FLB[FLN + fl_w] = ts(yr + fo_r * ffb_g);
  fl_w += 1;  fl_w >= FLN ? fl_w = 0;
  yl += (fo_l * fmx_g) * fl_x;  yr += (fo_r * fmx_g) * fl_x;
) : (
  // out: keep the line fed with the dry sound (no stale audio when it comes back in)
  FLB[fl_w] = yl;  FLB[FLN + fl_w] = yr;  fl_w += 1;  fl_w >= FLN ? fl_w = 0;
);

// ---------- LCR DELAY: three lines (LEFT, CENTRE, RIGHT), each its own SEND, TIME and REPEATS; pops in the
// click matrix go in too. Title lamp: in / out (the sends fade; the repeats already in the air die away) ----------
dl_x += ((dl_on >= 0.5) - dl_x) * sw_c;
dfb0 += (dfb_t0 - dfb0) * sm_c;  dfb1 += (dfb_t1 - dfb1) * sm_c;  dfb2 += (dfb_t2 - dfb2) * sm_c;
dsn0 += (dsn_t0 * dl_x - dsn0) * sm_c;  dsn1 += (dsn_t1 * dl_x - dsn1) * sm_c;  dsn2 += (dsn_t2 * dl_x - dsn2) * sm_c;
dtm_s0 += (dtm_t0 - dtm_s0) * dtm_c;  dtm_s1 += (dtm_t1 - dtm_s1) * dtm_c;  dtm_s2 += (dtm_t2 - dtm_s2) * dtm_c;
dsn0 + dsn1 + dsn2 > 0.0005 || dl_tail > 0.00001 ? (
  din = (yl + yr) * 0.5 + (pel + per) * 0.4 + ble * 1.2;            // the pops in the click matrix and the bleeps go in harder
  d0 = dl_line(0, dtm_s0, din * dsn0, dfb0);  d1 = dl_line(1, dtm_s1, din * dsn1, dfb1);  d2 = dl_line(2, dtm_s2, din * dsn2, dfb2);
  dl_w += 1;  dl_w >= DLN ? dl_w = 0;
  yl += d0 + d1 * 0.707;  yr += d2 + d1 * 0.707;
  dl_tail = max(abs(d0), max(abs(d1), abs(d2))) * 0.002 + dl_tail * 0.998;
) : (
  // idle: keep the lines moving, silent (no stale echoes when the sends open again)
  DL0[dl_w] = 0;  DL0[DLN + dl_w] = 0;  DL0[2 * DLN + dl_w] = 0;  dl_w += 1;  dl_w >= DLN ? dl_w = 0;
);

yl *= out_g;  yr *= out_g;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, ui_pg);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@gfx 1200 850
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
// =====================================================================
// GUI - EA77: a vintage cream and beige faceplate, black bezels silk-screened in yellow and orange, a faux
// mechanical tuning dial, pointer knobs, red and amber warning lamps.
// =====================================================================
C_FACE = 0xE2D7BC;  C_SEC1 = 0xD8CCAE;  C_SEC2 = 0xDDD2B6;  C_SEC3 = 0xD3C6A7;
C_INK = 0x1E1C18;  C_INK2 = 0x5A5246;  C_ORG = 0xE07A1E;  C_YEL = 0xF2C230;  C_BEZ = 0x1A1917;
C_LCDBG = 0x161007;  C_LCDTX = 0xFFB347;
LK_YEL = 0xF2C230;  LK_AMB = 0xF2A41E;  LK_RED = 0xF0503A;  lk_well = 0x2A2722;

function col(h, a) ( gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a; );
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));  b = min(255, floor((h % 256) * f));
  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 + floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_r(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rivet(x, y) ( col(0x8C8370, 1);  gfx_circle(px(x), py(y), ps(4), 1, 1);  col(0xF4EEDC, 1);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.4), 1, 1); );
// age: faint stains and wear on the cream, painted once into image 121 (again on resize)
function wx_rnd() ( wx_s = (wx_s * 16807) % 2147483647;  wx_s / 2147483647; );
function wx_build() local(i, x, y, r) (
  gfx_setimgdim(121, ceil(ps(1200)), ceil(ps(850)));  gfx_dest = 121;
  col(C_FACE, 1);  gfx_rect(0, 0, ps(1200), ps(850), 1);
  wx_s = 9277;  i = 0;
  loop(380, x = wx_rnd() * 1200;  y = wx_rnd() * 850;  r = 2 + wx_rnd() * 24;  x < 460 && y < 80 ? y += 90;     // the title's corner stays clear
    col(wx_rnd() < 0.7 ? 0x6A5530 : 0xFFFFFF, 0.012 + 0.016 * wx_rnd());  gfx_circle(ps(x), ps(y), ps(r), 1, 1);  i += 1; );
  gfx_dest = -1;  wx_sc = sc;
);
// ---------- the header art: a horizon - sandy ground, a blue sky with clouds, a row of white radio dishes ----------
// (in the spirit of a desert radio-telescope array; painted once into image 122, again on resize; the title's
// corner stays plain)
function hz_tri(x1, y1, x2, y2, x3, y3) ( gfx_triangle(ps(x1), ps(y1), ps(x2), ps(y2), ps(x3), ps(y3)); );
// an ellipse (centre, radii a / b, turned by t) filled as a fan
function hz_ell(cx, cy, a, b, t) local(i, a0, a1, x0, y0, x1, y1, ct, st) (
  ct = cos(t);  st = sin(t);  i = 0;
  loop(28, a0 = i / 28 * 2 * $pi;  a1 = (i + 1) / 28 * 2 * $pi;
    x0 = cos(a0) * a;  y0 = sin(a0) * b;  x1 = cos(a1) * a;  y1 = sin(a1) * b;
    hz_tri(cx, cy, cx + x0 * ct - y0 * st, cy + x0 * st + y0 * ct, cx + x1 * ct - y1 * st, cy + x1 * st + y1 * ct);  i += 1; );
);
// one dish standing on the ground at gy: s = size (the dish's radius), facing up and to the left
function hz_dish(x, gy, s) local(cx, cy, t, hw) (
  hw = s * 0.32;  cy = gy - s * 1.15;  cx = x;  t = -0.62;
  // the mount: two legs, the yoke
  col(0xD8D6CE, 1);  hz_tri(x - hw, gy, x - hw * 0.25, cy + s * 0.15, x - hw * 0.05, gy);  hz_tri(x + hw, gy, x + hw * 0.25, cy + s * 0.15, x + hw * 0.05, gy);
  col(0xEDEBE4, 1);  gfx_rect(ps(x - hw * 0.35), ps(cy + s * 0.05), max(1, ps(hw * 0.7)), max(1, ps(s * 0.35)), 1);
  col(0x6E6A60, 0.5);  gfx_rect(ps(x - hw - 1), ps(gy - 1), ps(hw * 2 + 2), max(1, ps(1.2)), 1);
  // the dish: the back (grey), the face (white, a soft shade towards the lower rim)
  col(0xB9B8B2, 1);  hz_ell(cx + s * 0.06, cy + s * 0.05, s, s * 0.42, t);
  col(0xF6F6F2, 1);  hz_ell(cx, cy, s * 0.96, s * 0.38, t);
  col(0xDCDBD4, 1);  hz_ell(cx + s * 0.08, cy + s * 0.05, s * 0.62, s * 0.2, t);
  // the feed: three struts to the receiver at the focus
  col(0x9A988F, 1);  t = cy - s * 0.62;
  gfx_line(ps(cx - s * 0.55), ps(cy + s * 0.3), ps(cx - s * 0.18), ps(t), 1);  gfx_line(ps(cx + s * 0.5), ps(cy - s * 0.32), ps(cx - s * 0.18), ps(t), 1);
  gfx_line(ps(cx), ps(cy), ps(cx - s * 0.18), ps(t), 1);
  col(0xF0EEE8, 1);  gfx_rect(ps(cx - s * 0.23), ps(t - s * 0.06), max(1, ps(s * 0.1)), max(1, ps(s * 0.12)), 1);
);
function hz_build() local(i, x, y, r, g, k, s, gy) (
  gfx_setimgdim(122, ceil(ps(1200)), ceil(ps(72)));  gfx_dest = 122;
  // the sky: deep blue at the top, pale at the horizon
  i = 0;  loop(52, col(ui_mix(0x3E6DB0, 0xC6D8EA, (i / 51) ^ 1.4), 1);  gfx_rect(0, ps(i), ps(1200), max(1, ps(1)) + 1, 1);  i += 1; );
  // clouds: soft white heaps on flat, grey-shaded bases
  // (made first, then drawn from the highest base down, so a lower cloud's cut never bites a higher one)
  CLD = 20000;  wx_s = 4711;
  // TWEAK: the clouds (x, flat base, size) - none behind the big dish
  CLD[0] = 449;  CLD[1] = 29.5;  CLD[2] = 6.8;
  CLD[3] = 506;  CLD[4] = 32.8;  CLD[5] = 7.5;
  CLD[6] = 949;  CLD[7] = 34.6;  CLD[8] = 7.8;
  CLD[9] = 967;  CLD[10] = 34.5;  CLD[11] = 6.1;
  CLD[12] = 1041;  CLD[13] = 29.4;  CLD[14] = 4.9;
  CLD[15] = 1066;  CLD[16] = 32.4;  CLD[17] = 4.8;
  k = 0;  loop(5, i = 0;  loop(5 - k, CLD[i * 3 + 1] > CLD[i * 3 + 4] ? ( g = CLD[i * 3];  CLD[i * 3] = CLD[i * 3 + 3];  CLD[i * 3 + 3] = g;
    g = CLD[i * 3 + 1];  CLD[i * 3 + 1] = CLD[i * 3 + 4];  CLD[i * 3 + 4] = g;  g = CLD[i * 3 + 2];  CLD[i * 3 + 2] = CLD[i * 3 + 5];  CLD[i * 3 + 5] = g; );  i += 1; );  k += 1; );
  k = 0;
  loop(6, x = CLD[k * 3];  y = CLD[k * 3 + 1];  r = CLD[k * 3 + 2];     // y = the cloud's flat base
    i = 0;  loop(7, g = (wx_rnd() - 0.5) * r * 3.2;
      col(0xFFFFFF, 0.55);  gfx_circle(ps(x + g), ps(y - r * 0.45 - wx_rnd() * 3), ps(r * (0.55 + wx_rnd() * 0.5)), 1, 1);  i += 1; );
    // cut the heap off flat: repaint the sky under the base, then a soft grey underside just above it
    i = 0;  loop(9, col(ui_mix(0x3E6DB0, 0xC6D8EA, ((y + i) / 51) ^ 1.4), 1);  gfx_rect(ps(x - r * 2.6), ps(y + i), ps(r * 5.2), max(1, ps(1)) + 1, 1);  i += 1; );
    col(0x9AA8B8, 0.30);  gfx_rect(ps(x - r * 1.9), ps(y - 1.5), ps(r * 3.8), ps(1.5), 1);
    col(0x9AA8B8, 0.18);  gfx_rect(ps(x - r * 1.6), ps(y - 3), ps(r * 3.2), ps(1.5), 1);
    k += 1; );
  // distant hills, blue-grey
  col(0x7D8CA0, 1);  x = 0;  loop(120, y = 50 - 3.5 * (0.5 + 0.5 * sin(x * 0.011)) - 2.5 * (0.5 + 0.5 * sin(x * 0.037 + 1.3));
    gfx_rect(ps(x), ps(y), ps(10) + 1, ps(54 - y) + 1, 1);  x += 10; );
  // the ground: dry, sandy grass, darker towards us, streaked
  i = 52;  loop(20, col(ui_mix(0xD2B47A, 0x9C7A44, ((i - 52) / 19) ^ 0.9), 1);  gfx_rect(0, ps(i), ps(1200), max(1, ps(1)) + 1, 1);  i += 1; );
  wx_s = 1997;  loop(900, x = wx_rnd() * 1200;  y = 53 + wx_rnd() * 19;  col(wx_rnd() < 0.5 ? 0x7A5A2C : 0xE8D3A0, 0.25 + 0.25 * wx_rnd());
    gfx_line(ps(x), ps(y), ps(x + wx_rnd() * 2 - 1), ps(y - 1 - (y - 52) * 0.12 * wx_rnd()), 1); );
  // the fence along the horizon
  col(0x5A4A30, 0.55);  gfx_line(ps(330), ps(55), ps(1200), ps(55), 1);
  x = 340;  loop(44, gfx_line(ps(x), ps(53), ps(x), ps(57), 1);  x += 20; );
  // the array: the big dish near, the rest receding to the right, a few far ones on the left
  hz_dish(470, 54.8, 6);  hz_dish(510, 54.8, 7);  hz_dish(556, 55, 8);
  hz_dish(640, 60, 30);
  k = 0;  x = 740;  s = 19;  gy = 57;
  loop(11, hz_dish(x, gy, s);  x += 18 + s * 1.7;  s *= 0.86;  gy -= 0.25;  k += 1; );
  // the title's corner stays plain cream, the picture behind a solid divider (black, an orange line, as the rule)
  col(C_FACE, 1);  gfx_rect(0, 0, ps(383), ps(72), 1);
  col(C_BEZ, 1);  gfx_rect(ps(383), 0, ps(3) + 1, ps(72), 1);  col(C_ORG, 1);  gfx_rect(ps(386), 0, max(1, ps(1)), ps(72), 1);
  gfx_dest = -1;  hz_sc = sc;
);
// a section: a recessed beige panel with a black silk-screened title bezel
function section(x, y, w, h, c, title) (
  col(0x000000, 0.18);  u_rect(x + 2, y + 3, w, h);
  col(c, 1);  u_rect(x, y, w, h);
  col(shade(c, 0.82), 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h);
  col(0xFFFFFF, 0.35);  u_rect(x, y, w - 2, 1);
  col(C_BEZ, 1);  u_rect(x, y, w, 34);
  col(C_ORG, 1);  u_rect(x, y + 34, w, 3);
  gfx_setfont(4);  col(C_YEL, 1);  text_l(px(x + 16), py(y + 18), title);
);
// drop shadows (light from the top left: soft, down and to the right) and vignette edging
function shd_r(x, y, w, h) local(i) ( i = 0;  loop(4, col(0x000000, 0.13);  u_rect(x + 2 + i * 1.3, y + 3 + i * 1.6, w + i * 0.6, h + i * 0.6);  i += 1; ); );
function shd_c(cx, cy, r) local(i) ( i = 0;  loop(4, col(0x000000, 0.13);  gfx_circle(px(cx + 2 + i * 1.2), py(cy + 3 + i * 1.5), ps(r + i * 0.6), 1, 1);  i += 1; ); );
function vig_c(cx, cy, r, a) local(i) ( i = 0;  loop(7, col(0x000000, a * (1 - i / 7));  gfx_circle(px(cx), py(cy), ps(r - i * 0.8), 0, 1);  gfx_circle(px(cx + 0.4), py(cy + 0.4), ps(r - i * 0.8 - 0.4), 0, 1);  i += 1; ); );
// a section with a TITLE LAMP: the lamp (and the title) switch the section in / out (slider idx)
function section_l(x, y, w, h, c, title, on, idx) local(hov) (
  section(x, y, w, h, c, "");
  col(0x050505, 1);  gfx_circle(px(x + 26), py(y + 17), ps(10), 1, 1);
  col(on ? 0xFFF4D8 : 0x55575C, 1);  gfx_circle(px(x + 26), py(y + 17), ps(8), 1, 1);
  col(on ? 0xF2A41E : 0x2A2C30, 1);  gfx_circle(px(x + 26), py(y + 17), ps(5), 1, 1);
  on ? ( col(0xF2A41E, 0.28);  gfx_circle(px(x + 26), py(y + 17), ps(15), 1, 1); );
  gfx_setfont(4);  col(on ? C_YEL : 0x9A8A5A, 1);  text_l(px(x + 46), py(y + 18), title);
  hov = mouse_x >= px(x + 10) && mouse_x < px(x + 200) && mouse_y >= py(y) && mouse_y < py(y + 34);
  click && hov && !drag_idx ? ( slider(idx) = on ? 0 : 1;  param_touched(idx); );
);
// a light recessed READOUT box (a value read at a glance), dark text
function rbox(x, y, w, h, str) ( col(0x4A4636, 1);  u_rect(x - 1, y - 1, w + 2, h + 2);  col(0xF2ECD8, 1);  u_rect(x, y, w, h);
  col(0x000000, 0.15);  u_rect(x, y, w, 2);  u_rect(x, y, 2, h);  gfx_setfont(2);  col(0x1C1A14, 1);  text_c(px(x + w * 0.5), py(y + h * 0.5), str); );
// a status LED: lit by lv (0 - 1), a black ring, a highlight and a halo
function sled(x, y, r, c, lv) ( col(0x0A0A0A, 1);  gfx_circle(px(x), py(y), ps(r + 2), 1, 1);  col(ui_mix(shade(c, 0.3), c, min(1, lv)), 1);  gfx_circle(px(x), py(y), ps(r), 1, 1);
  lv > 0.05 ? ( col(c, 0.25 * min(1, lv));  gfx_circle(px(x), py(y), ps(r * 2.2), 1, 1);  col(0xFFFFFF, 0.6 * min(1, lv));  gfx_circle(px(x - r * 0.3), py(y - r * 0.3), ps(r * 0.35), 1, 1); ); );
// a KEY + LED: a small square key, its own LED beside it (lit green when on)
function kled(x, y, w, h, on, str) local(hov, hit) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);  hit = click && hov && !drag_idx;
  shd_r(x - 2, y - 2, w + 4, h + 4);  col(0x101010, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(on ? 0xF2C230 : 0xC9A85A, 1);  u_rect(x, y, w, h);  col(0xFFFFFF, 0.3);  u_rect(x, y, w, 2);  col(0x000000, 0.12);  u_rect(x, y + h - 4, w, 4);  u_rect(x + w - 3, y, 3, h);
  hov ? ( col(0xFFFFFF, 0.08);  u_rect(x, y, w, h); );
  gfx_setfont(2);  col(0x3A2A08, 1);  text_c(px(x + w * 0.5), py(y + h * 0.5), str);
  sled(x + w + 16, y + h * 0.5, 5, 0x7CE05A, on);
  hit;
);
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function divname(v) ( v = floor(v + 0.5);  strcpy(#kv, v == 0 ? "1/32" : v == 1 ? "1/16 T" : v == 2 ? "1/16" : v == 3 ? "1/8 T" : v == 4 ? "1/16 D" :
  v == 5 ? "1/8" : v == 6 ? "1/4 T" : v == 7 ? "1/8 D" : v == 8 ? "1/4" : v == 9 ? "1/2 T" : v == 10 ? "1/4 D" : v == 11 ? "1/2" : "1 bar"); #kv; );
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v) :
  fmt == 2 ? sprintf(#kv, "%.1f Hz", v) :
  fmt == 3 ? sprintf(#kv, "%+.1f st", v) :
  fmt == 4 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 5 ? sprintf(#kv, "%.3f MHz", v) :
  fmt == 6 ? sprintf(#kv, "%.1f st", v) :
  fmt == 7 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 8 ? sprintf(#kv, "%d ms", v) :
  fmt == 9 ? divname(v) :
  sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
// a pointer knob: a black fluted skirt, a black cap with a white line; orange and black scale on the cream
function kn(cx, cy, r, idx, vmin, vmax, def, lbl, fmt) local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lgt, fin, stp, kc)
(
  lgt = klog;  klog = 0;  fin = kfine;  kfine = 0;  stp = kstep;  kstep = 0;  kc = kcap;  kcap = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.2);
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? ( slider(idx) = def;  param_touched(idx);  drag_idx = 0; )
                                                                           : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    stp ? v = max(vmin, min(vmax, floor(v + 0.5) + sign(mouse_wheel))) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 220)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    v = stp ? floor(v + 0.5) : fin ? floor(v * 1000 + 0.5) / 1000 : floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  j = 0;
  loop(21,
    b = a0 + j / 20 * (a1 - a0);  col(j % 5 == 0 ? C_INK : C_ORG, j % 5 == 0 ? 0.9 : 0.85);
    gfx_line(x + sin(b) * (rr + ps(6)), y - cos(b) * (rr + ps(6)), x + sin(b) * (rr + ps(j % 5 == 0 ? 14 : 10)), y - cos(b) * (rr + ps(j % 5 == 0 ? 14 : 10)), 1);
    j += 1;
  );
  shd_c(cx, cy, r);
  kc ? (
    // COLOURED CAP: a light metal ring round a flat coloured cap
    col(0xB8BCC4, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x6E7278, 1);  gfx_circle(x, y, rr, 0, 1);  col(0xFFFFFF, 0.25);  gfx_arc(x, y, rr - ps(1.5), -1.7, -0.3, 1);
    col(kc, 1);  gfx_circle(x, y, rr * 0.84, 1, 1);  vig_c(cx, cy, r * 0.84, 0.16);
  ) : (
    col(0x1A1918, 1);  gfx_circle(x, y, rr, 1, 1);
    j = 0;  loop(36, b = j / 36 * 2 * $pi;  col(0x3E3B36, 1);  gfx_line(x + sin(b) * rr * 0.86, y - cos(b) * rr * 0.86, x + sin(b) * rr * 0.98, y - cos(b) * rr * 0.98, 1);  j += 1; );
    col(0x262422, 1);  gfx_circle(x, y, rr * 0.8, 1, 1);  vig_c(cx, cy, r, 0.16);
  );
  col(0xFFFFFF, 0.10);  gfx_arc(x, y, rr * 0.74, -1.8, -0.1, 1);
  col(0xF4EEDC, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.92, ps(r > 30 ? 2.6 : 1.8));
  gfx_setfont(6);  col(C_INK, 1);  text_c(x, y + rr + ps(26), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(22), fmtv(v, fmt));
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r, d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);  i += 1; );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) ( gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str); );
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? ( col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);  col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k); );
  shd_r(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k);
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4, t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;  dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);  i += 1; );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lcd_box(x, y, w, h) ( col(0x2A2722, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(0x050402, 1);  u_rect(x, y, w, h);  col(C_LCDBG, 1);  u_rect(x + 3, y + 3, w - 6, h - 6); );
function lcd(x, y, w, h, fnt, str) local(tw, th, gy) (
  lcd_box(x, y, w, h);
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);
// a vertical LED meter (-48 .. 0 dB) with its name below
function vmeter(x, y, h, lv, name) local(db, j, d, n) (
  db = lv > 0.000001 ? 8.685889638065035 * log(lv) : -120;  n = 20;
  shd_r(x, y, 22, h);
  col(0x14120F, 1);  u_rect(x, y, 22, h);
  j = 0;
  loop(n, d = -48 + (j + 1) * 48 / n;
    col(d > -1 ? 0xFF4A30 : d > -10 ? 0xFFB347 : 0x9FD05A, db >= d - 2.4 ? 1 : 0.12);
    u_rect(x + 3, y + h - 3 - (j + 1) * (h - 6) / n + 1, 16, (h - 6) / n - 1.5);  j += 1; );
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(x + 11), py(y + h + 14), name);
);
// a round warning lamp in a black bezel, with its name beside it
function lamp(x, y, c, lv, name) (
  col(C_BEZ, 1);  gfx_circle(px(x), py(y), ps(10), 1, 1);
  col(shade(c, 0.35), 1);  gfx_circle(px(x), py(y), ps(7), 1, 1);
  col(c, min(1, lv));  gfx_circle(px(x), py(y), ps(7), 1, 1);
  lv > 0.05 ? ( col(c, 0.25 * min(1, lv));  gfx_circle(px(x), py(y), ps(13), 1, 1);  col(0xFFFFFF, 0.5 * min(1, lv));  gfx_circle(px(x - 2), py(y - 2), ps(2.2), 1, 1); );
  gfx_setfont(5);  col(C_INK, 1);  text_l(px(x + 18), py(y), name);
);
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1, c = k < len ? str_getchar(menu, k) : 124;  c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );  k += 1; );
  dst;
);
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xD8D0BC, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xD8D0BC, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xD8D0BC, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1B1C, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  i < n ? strcat(#pb_m, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
// the defaults (RUN is left as it is: a preset never starts or stops the generator)
// PRESETS (level-matched with OUTPUT LEVEL; RUN is never touched)
PRESET_MENU = "Default|Deep Space Carrier Wave|Shortwave Static Sweep|Electromagnetic Hum|Deep Drone Void|Pulsar Transmission|Stellar Static|Machine Breathing|Cosmic Background|Atmospheric Anomaly|Radio Astronomy|Quiet Signal";

// ---------- the tuning dial: a backlit glass window, MHz scale, the broadcast bands marked, a red needle ----------
function dial(x, y, w, h) local(i, f, dx, hov, bx, bn) (
  shd_r(x - 6, y - 6, w + 12, h + 12);
  col(C_BEZ, 1);  u_rect(x - 6, y - 6, w + 12, h + 12);
  col(0x3A2A12, 1);  u_rect(x, y, w, h);
  col(0xFFB347, 0.10);  u_rect(x + 4, y + 4, w - 8, h - 8);
  col(0xFFD27A, 0.06);  u_rect(x + 4, y + 4, w - 8, (h - 8) * 0.45);
  // the scale: 1 - 30 MHz
  i = 1;
  loop(30,
    dx = x + 64 + (i - 1) / 29 * (w - 100);
    col(0xFFD9A0, i % 5 == 0 || i == 1 ? 0.95 : 0.55);  u_rect(dx - 0.75, y + 40, 1.5, i % 5 == 0 || i == 1 ? 18 : 10);
    i % 5 == 0 || i == 1 ? ( gfx_setfont(10);  col(0xFFE2B0, 1);  text_c(px(dx), py(y + 26), sprintf(#dn, "%d", i)); );
    i += 1;
  );
  gfx_setfont(5);  col(0xFFD9A0, 0.8);  text_l(px(x + 14), py(y + 26), "MHz");
  // the broadcast bands (metres)
  i = 0;
  loop(9,
    f = i == 0 ? 5.95 : i == 1 ? 7.2 : i == 2 ? 9.5 : i == 3 ? 11.8 : i == 4 ? 13.7 : i == 5 ? 15.3 : i == 6 ? 17.7 : i == 7 ? 21.6 : 25.8;
    bn = i == 0 ? "49" : i == 1 ? "41" : i == 2 ? "31" : i == 3 ? "25" : i == 4 ? "22" : i == 5 ? "19" : i == 6 ? "16" : i == 7 ? "13" : "11";
    bx = x + 64 + (f - 1) / 29 * (w - 100);
    col(C_ORG, 0.9);  u_rect(bx - 6, y + 66, 12, 4);
    gfx_setfont(5);  col(0xFFC070, 0.9);  text_c(px(bx), py(y + 84), bn);
    i += 1;
  );
  gfx_setfont(5);  col(0xFFC070, 0.75);  text_l(px(x + 14), py(y + 84), "m");
  // the readout
  gfx_setfont(8);  col(0xFFC070, 1);  text_r(px(x + w - 14), py(y + h - 20), sprintf(#dn, "%.3f MHz", sw_tune));
  // the needle (drawn at the tuning the receiver hears, glide and drift included)
  dx = x + 64 + (max(1, min(30, tn_d)) - 1) / 29 * (w - 100);
  col(0x000000, 0.3);  u_rect(dx - 0.5, y + 6, 3, h - 12);
  col(0xE8321E, 1);  u_rect(dx - 1.5, y + 6, 3, h - 12);
  // glass reflection
  col(0xFFFFFF, 0.06);  u_rect(x + 4, y + 4, w - 8, 10);
  // the vernier: drag sideways (Shift = finer), wheel = 10 kHz steps
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  click && hov && !drag_idx ? ( drag_idx = 101;  dv_x = mouse_x;  dv_v = sw_tune; );
  drag_idx == 101 ? (
    f = max(1, min(30, dv_v + (mouse_x - dv_x) / sc * ((mouse_cap & 8) ? 0.0005 : 0.004)));
    f = floor(f * 1000 + 0.5) / 1000;
    f != sw_tune ? ( slider(1) = f;  param_touched(1); );
  );
  hov && mouse_wheel != 0 && !drag_idx ? ( slider(1) = max(1, min(30, floor((sw_tune + sign(mouse_wheel) * ((mouse_cap & 8) ? 0.002 : 0.01)) * 1000 + 0.5) / 1000));  param_touched(1);  mouse_wheel = 0; );
);
// the S-meter: an analogue needle, S1 - S9 and +20, +40
function smeter(x, y, w, h, lv) local(a, cx, cy, r, i, b, db) (
  shd_r(x - 5, y - 5, w + 10, h + 10);
  vg_spill(px(x - 5), py(y - 5), ps(w + 10), ps(h + 10), 1);                      // the lamp's spill
  col(C_BEZ, 1);  u_rect(x - 5, y - 5, w + 10, h + 10);
  vg_glow(px(x), py(y), ps(w), ps(h), 1);                                          // the backlit face (gfx-glow)
  cx = x + w * 0.5;  cy = y + h + 30;  r = h + 6;
  i = 0;
  loop(11, b = -0.6 + i / 10 * 1.2;
    col(i > 8 ? 0xC82A18 : C_INK, 1);
    gfx_line(px(cx + sin(b) * (r - 14)), py(cy - cos(b) * (r - 14)), px(cx + sin(b) * (r - 4)), py(cy - cos(b) * (r - 4)), 1);
    i += 1; );
  gfx_setfont(10);  col(C_INK, 1);
  text_c(px(cx + sin(-0.6) * (r - 26)), py(cy - cos(-0.6) * (r - 26)), "1");  text_c(px(cx + sin(-0.12) * (r - 26)), py(cy - cos(-0.12) * (r - 26)), "5");
  text_c(px(cx + sin(0.36) * (r - 26)), py(cy - cos(0.36) * (r - 26)), "9");  col(0xC82A18, 1);  text_c(px(cx + sin(0.6) * (r - 26)), py(cy - cos(0.6) * (r - 26)), "+40");
  gfx_setfont(5);  col(C_INK2, 1);  text_l(px(x + 8), py(y + h - 12), "S");  text_r(px(x + w - 8), py(y + h - 12), "SIGNAL");
  db = lv > 0.00001 ? 20 * log10(lv) : -100;
  sm_n += (max(0, min(1, (db + 48) / 50)) - sm_n) * 0.25;
  a = -0.6 + sm_n * 1.2;
  col(0xC82A18, 1);  gfx_line(px(cx + sin(a) * 42), py(cy - cos(a) * 42), px(cx + sin(a) * (r - 6)), py(cy - cos(a) * (r - 6)), 1);
  gfx_line(px(cx + sin(a) * 42) + 1, py(cy - cos(a) * 42), px(cx + sin(a) * (r - 6)) + 1, py(cy - cos(a) * (r - 6)), 1);
);
// the counter-rotation scope: two dots circling (one per sine), against each other when COUNTER-ROTATE is lit
function scope(cx, cy, r) local(a, b) (
  shd_c(cx, cy, r + 6);
  col(C_BEZ, 1);  gfx_circle(px(cx), py(cy), ps(r + 6), 1, 1);
  col(0x0E1208, 1);  gfx_circle(px(cx), py(cy), ps(r), 1, 1);
  col(0x9FD05A, 0.25);  gfx_circle(px(cx), py(cy), ps(r * 0.7), 0, 1);  gfx_line(px(cx - r), py(cy), px(cx + r), py(cy), 1);  gfx_line(px(cx), py(cy - r), px(cx), py(cy + r), 1);
  a = 2 * $pi * lp_ph;  b = sw_dir >= 0.5 ? -a : a;
  col(0xFFB347, 1);  gfx_circle(px(cx + sin(a) * r * 0.7), py(cy - cos(a) * r * 0.7), ps(5), 1, 1);
  col(0x9FD05A, 1);  gfx_circle(px(cx + sin(b + $pi) * r * 0.7), py(cy - cos(b + $pi) * r * 0.7), ps(5), 1, 1);
);

// ---------- frame ----------
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1200 * g_ret), gfx_h / (850 * g_ret))), 0.5);
ui_tf = sc < (gfx_ext_retina > 1 ? gfx_ext_retina : 1) ? min(sqrt((gfx_ext_retina > 1 ? gfx_ext_retina : 1) / sc), 1.15) : 1;   // text shrinks half as fast as the panel below M (JG, 30 Oct 2026; at most 15 % bigger)
ox = (gfx_w - 1200 * sc) * 0.5;  oy = (gfx_h - 850 * sc) * 0.5;
lmb = mouse_cap & 1;  click = lmb && !last_lmb;  klog = 0;  kfine = 0;  kstep = 0;  kcap = 0;
gfx_setfont(1, "Trebuchet MS", ps(34), 'b');
gfx_setfont(2, "Trebuchet MS", (ps(14)) * max(ui_tf, 1), 'b');
gfx_setfont(3, "Trebuchet MS", (ps(14)) * max(ui_tf, 1), 'b');
gfx_setfont(4, "Trebuchet MS", ps(17), 'b');
gfx_setfont(5, "Trebuchet MS", (ps(12.5)) * max(ui_tf, 1), 'b');
gfx_setfont(6, "Trebuchet MS", (ps(15)) * max(ui_tf, 1), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');
gfx_setfont(10, "Trebuchet MS", (ps(13)) * max(ui_tf, 1), 'b');
out_m = max(outpk_d, out_m * 0.85);  outpk_d = 0;

// ---------- faceplate ----------
col(0x111213, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
wx_sc != sc ? wx_build();
gfx_a = 1;  gfx_x = px(0);  gfx_y = py(0);  gfx_blit(121, 1, 0);
hz_sc != sc ? hz_build();
gfx_a = 1;  gfx_x = px(0);  gfx_y = py(0);  gfx_blit(122, 1, 0);
col(0x000000, 0.25);  u_rect(0, 846, 1200, 4);  u_rect(1196, 0, 4, 850);
rivet(14, 14);  rivet(1186, 14);  rivet(14, 836);  rivet(1186, 836);
gfx_setfont(1);  col(C_INK, 1);  text_l(px(40), py(36), "EA77"); ver_tag("v3", 16, 0, 0);
gfx_setfont(10);  col(C_ORG, 1);  text_l(px(176), py(28), "SHORTWAVE RECEIVER");  text_l(px(176), py(46), "CARRIER  ·  HUM");
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(700, 85, 34, 274, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k; );
col(C_BEZ, 1);  u_rect(16, 72, 1168, 3);  col(C_ORG, 1);  u_rect(16, 75, 1168, 1);

// ---------- the pages ----------
lk_key(24, 88, 150, 28, ui_pg == 0, LK_YEL, "SOURCES") ? ui_pg = 0;
lk_key(194, 88, 150, 28, ui_pg == 1, LK_YEL, "EFFECTS") ? ui_pg = 1;
// the fade LFOs' lamps (shown on both pages, beside the tabs)
gfx_setfont(5);  col(C_INK2, 1);  text_r(px(560), py(102), "FADE");
sled(580, 102, 5, 0x9FD05A, fdc_d);  sled(602, 102, 5, 0xFFB347, fdr_d);  sled(624, 102, 5, 0xF2C230, fdh_d);  sled(646, 102, 5, 0xFF6A40, fdp_d);

ui_pg == 0 ? (
// ================= SOURCES =================
// ---------- RECEIVER ----------
section(24, 130, 760, 356, C_SEC1, "RECEIVER");
dial(44, 184, 720, 120);
kfine = 1;  kn(120, 404, 40, 1, 1, 30, 14, "SW TUNE", 5);
kn(270, 404, 28, 2, 0, 100, 30, "BANDWIDTH", 1);
kn(400, 404, 28, 11, 0, 100, 50, "LEVEL", 1);
kn(540, 404, 26, 38, 0, 100, 0, "FADE", 1);
klog = 1;  kn(680, 404, 26, 37, 0.01, 2, 0.03, "FADE RATE", 7);
sled(610, 372, 5, 0xFFB347, fdr_d);

// ---------- OUTPUT ----------
section(800, 130, 376, 356, C_SEC3, "OUTPUT");
lk_key(820, 174, 86, 34, run >= 0.5, LK_AMB, "RUN") ? ( slider(9) = run >= 0.5 ? 0 : 1;  param_touched(9); );   // never on by itself
lamp(940, 180, 0xFFB347, sm_d * 3, "SIGNAL");
lamp(940, 208, 0xFF3A22, out_m > 0.89 ? 1 : 0, "OVERLOAD");
smeter(826, 240, 230, 86, sm_d);
kn(870, 414, 28, 7, -18, 6, 0, "LEVEL", 4);
kn(990, 414, 20, 8, 0, 100, 50, "DRIFT", 1);
vmeter(1086, 180, 240, out_m, "OUT");
g_j = 0;
loop(9,
  g_v = VD[g_j];
  col(C_BEZ, 1);  gfx_circle(px(1140), py(190 + g_j * 26), ps(7), 1, 1);
  col(g_j == 8 ? 0xFFB347 : 0x9FD05A, 0.12 + 0.88 * min(1, g_v));  gfx_circle(px(1140), py(190 + g_j * 26), ps(5), 1, 1);
  g_j += 1;
);
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1140), py(434), "KEYS");

// ---------- CARRIER ----------
section(24, 502, 496, 320, C_SEC2, "CARRIER");
lk_key(316, 506, 188, 26, sw_dir >= 0.5, LK_YEL, "COUNTER-ROTATE") ? ( slider(10) = sw_dir >= 0.5 ? 0 : 1;  param_touched(10); );
scope(92, 660, 54);
kn(216, 624, 28, 3, -24, 24, 7, "SINE SPREAD", 3);
klog = 1;  kn(336, 624, 28, 14, 0.01, 2, 0.08, "SWEEP RATE", 7);
kn(456, 624, 28, 15, 0, 12, 2, "SWEEP DEPTH", 6);
kn(216, 752, 24, 12, 0, 100, 60, "LEVEL", 1);
kn(336, 752, 24, 36, 0, 100, 0, "FADE", 1);
klog = 1;  kn(456, 752, 24, 35, 0.01, 2, 0.05, "FADE RATE", 7);
sled(396, 724, 5, 0x9FD05A, fdc_d);

// ---------- HUM ----------
section(536, 502, 300, 320, C_SEC1, "HUM");
kn(610, 624, 26, 4, 40, 70, 50, "FREQ", 2);
kn(760, 624, 26, 13, 0, 100, 30, "LEVEL", 1);
gfx_setfont(10);  col(C_ORG, 1);
g_a = -0.75 * $pi + (50 - 40) / 30 * 1.5 * $pi;  text_c(px(610 + sin(g_a) * 52), py(624 - cos(g_a) * 52), "50");
g_a = -0.75 * $pi + (60 - 40) / 30 * 1.5 * $pi;  text_c(px(610 + sin(g_a) * 52), py(624 - cos(g_a) * 52), "60");
kn(586, 752, 22, 16, 0, 100, 40, "BUZZ", 1);
kn(686, 752, 22, 40, 0, 100, 0, "FADE", 1);
klog = 1;  kn(786, 752, 22, 39, 0.01, 2, 0.07, "FADE RATE", 7);
sled(736, 724, 5, 0xF2C230, fdh_d);

// ---------- POPS ----------
section(852, 502, 324, 320, C_SEC3, "POPS");
kn(950, 624, 30, 5, 0, 100, 15, "POP DENSITY", 1);
lamp(1070, 624, 0xFF3A22, pop_d, "POP");
kn(950, 752, 24, 42, 0, 100, 0, "LFO DEPTH", 1);
klog = 1;  kn(1090, 752, 24, 41, 0.01, 2, 0.1, "LFO RATE", 7);
sled(1020, 724, 5, 0xFF6A40, fdp_d);
) : (
// ================= EFFECTS =================
// ---------- LCR DELAY ----------
section_l(24, 130, 1152, 340, C_SEC1, "LCR DELAY", dl_on >= 0.5, 43);
kled(1040, 135, 64, 24, dl_sync >= 0.5, "SYNC") ? ( slider(17) = dl_sync >= 0.5 ? 0 : 1;  param_touched(17); );
g_j = 0;
loop(3,
  g_x = 44 + g_j * 316;  g_cx = g_x + 150;
  // a recessed sub-panel per line: LEFT, CENTRE, RIGHT
  col(0x000000, 0.10);  u_rect(g_x, 186, 300, 264);  col(shade(C_SEC1, 1.04), 1);  u_rect(g_x + 2, 188, 298, 262);
  col(0x000000, 0.12);  u_rect(g_x, 186, 300, 2);  u_rect(g_x, 186, 2, 264);
  gfx_setfont(4);  col(C_INK, 1);  text_c(px(g_cx), py(212), g_j == 0 ? "LEFT" : g_j == 1 ? "CENTRE" : "RIGHT");
  g_c = g_j == 0 ? 0x2D628B : g_j == 1 ? 0x1E1C18 : 0x8B342D;
  g_i = g_j == 0 ? 20 : g_j == 1 ? 25 : 29;          // SEND
  kcap = g_c;  kn(g_cx - 100, 310, 26, g_i, 0, 100, g_j == 1 ? 20 : 30, "SEND", 1);
  g_i = g_j == 0 ? 6 : g_j == 1 ? 22 : 26;           // TIME (sync)
  g_m = g_j == 0 ? 18 : g_j == 1 ? 23 : 27;          // TIME (ms)
  dl_sync >= 0.5 ? ( kcap = g_c;  kstep = 1;  kn(g_cx, 300, 34, g_i, 0, 12, g_j == 0 ? 7 : g_j == 1 ? 8 : 10, "TIME", 9);  rbox(g_cx - 50, 384, 100, 28, divname(slider(g_i))); )
                 : ( kcap = g_c;  klog = 1;  kn(g_cx, 300, 34, g_m, 20, 2000, g_j == 0 ? 375 : g_j == 1 ? 500 : 750, "TIME", 8);  rbox(g_cx - 50, 384, 100, 28, sprintf(#rb, "%d ms", slider(g_m))); );
  g_i = g_j == 0 ? 19 : g_j == 1 ? 24 : 28;          // REPEATS
  kcap = g_c;  kn(g_cx + 100, 310, 26, g_i, 0, 95, g_j == 1 ? 45 : g_j == 0 ? 35 : 40, "REPEATS", 1);
  g_j += 1;
);
kn(1090, 310, 30, 21, 0, 100, 50, "TONE", 1);
dl_on < 0.5 ? ( col(C_SEC1, 0.5);  u_rect(24, 166, 1152, 304); );

// ---------- FLANGER ----------
section_l(24, 486, 464, 336, C_SEC2, "FLANGER", fl_on >= 0.5, 34);
klog = 1;  kcap = 0x2D628B;  kn(90, 650, 26, 30, 0.02, 5, 0.15, "RATE", 7);
kcap = 0x2D628B;  kn(200, 650, 26, 31, 0, 100, 50, "DEPTH", 1);
kcap = 0x8B342D;  kn(310, 650, 26, 32, -95, 95, 40, "FEEDBACK", 1);
kcap = 0x1E1C18;  kn(420, 650, 26, 33, 0, 100, 50, "MIX", 1);
gfx_setfont(10);  col(C_ORG, 1);  text_c(px(310), py(650 - 26 - 22), "0");
fl_on < 0.5 ? ( col(C_SEC2, 0.5);  u_rect(24, 522, 464, 300); );

// ---------- BLEEPS ----------
section(504, 486, 336, 336, C_SEC1, "BLEEPS");
kn(584, 650, 28, 44, 0, 100, 0, "DENSITY", 1);
klog = 1;  kn(692, 650, 28, 45, 200, 4000, 1200, "PITCH", 2);
kn(790, 650, 24, 46, 0, 100, 50, "LEVEL", 1);
lamp(640, 760, 0x6AD8FF, bl_d, "BLEEP");

// ---------- OUTPUT ----------
section(856, 486, 320, 336, C_SEC3, "OUTPUT");
lk_key(876, 532, 86, 34, run >= 0.5, LK_AMB, "RUN") ? ( slider(9) = run >= 0.5 ? 0 : 1;  param_touched(9); );
lamp(994, 540, 0xFFB347, sm_d * 3, "SIGNAL");
lamp(994, 568, 0xFF3A22, out_m > 0.89 ? 1 : 0, "OVERLOAD");
kn(920, 690, 30, 7, -18, 6, 0, "LEVEL", 4);
kn(1034, 690, 20, 8, 0, 100, 50, "DRIFT", 1);
vmeter(1126, 540, 240, out_m, "OUT");
);

// ---------- S / M / L / ? ----------
g_j = 0;
loop(4,
  g_x = 1102 + g_j * 14;  g_on = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(C_BEZ, 1);  u_rect(g_x, 27, 13, 18);
  col(g_on ? C_ORG : 0x8C8370, 1);  u_rect(g_x + 1, 28, 11, 16);
  gfx_setfont(5);  col(g_on ? 0x1A1917 : 0xF4EEDC, 1);  text_c(px(g_x + 6.5), py(36), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(27) && mouse_y < py(45) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
sz_help && click && !sz_new ? sz_help = 0;
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
  gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
  g_cw = max(g_tw + ps(40), ps(380));  g_ch = ps(130);  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(0xE0603A, 1);    gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(102);  gfx_drawstr("Click anywhere to close.");
);
!lmb ? drag_idx = 0;
mouse_wheel = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );
