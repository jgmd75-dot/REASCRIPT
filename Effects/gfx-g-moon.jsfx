in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-moon";                                    // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();   // 20000 - 24095
MQO  = 30000; MQT = 30300; MQN = 30600; MQV = 30900;       // MIDI event queue (300 each)
MHN  = 31200;                                              // held-note stack (128)
MDEF = 31400;                                              // the Init values of sliders 1-129
MTMP = 31600;                                              // preset parser scratch (400)
MOP  = 32100;                                              // the four oscillators: 24 slots each (see below)
MLF  = 32300;                                              // the four LFOs: 24 slots each
MMF  = 32420; MMT = 32430; MMO = 32440; MMC = 32450;       // LFO sums per oscillator: fine, tune, octave, cutoff
MMA  = 32460; MMP = 32470; MMX = 32480;                    // amp (a product), PW, and the pairs' MIX
MRLT = 32500; MRG = 32520; MAPL = 32540;                   // reverb: line lengths, gains, input allpass lengths
MRV  = 40000; MRVN = 16384;                                // reverb lines 8 x 16384 (40000 - 171071)
MAP  = 172000; MAPN = 4096;                                // 4 input allpass rings x 4096 (172000 - 188383)
MPD  = 190000; MPU = 198200; MPN = 8192;                   // octave down / octave up shifters (8192 each)
MCH  = 206400; MCHN = 4096;                                // chorus line
MDL  = 220000; MDR = 220000 + 524288; MDM = 524287;        // delay lines (2^19 each)
memset(MOP, 0, 96); memset(MLF, 0, 96);
memset(MRV, 0, 8 * MRVN); memset(MAP, 0, 4 * MAPN); memset(MPD, 0, MPN); memset(MPU, 0, MPN);
memset(MCH, 0, MCHN); memset(MDL, 0, 524288 * 2);

// oscillator slots (q = MOP + 24 * i; i = 0 drone 1, 1 drone 2, 2 lead 1, 3 lead 2):
//   0 wave  1 tune + fine (st)  2 pw  3 cutoff Hz  4 resonance  5 / 6 pan gains L / R  7 to tremolo
//   8 / 9 / 10 chorus / delay / reverb send  11 glided pitch (st)  12 FATE's beating (st)  13 phase increment
//   14 pw now  15 / 16 / 17 filter a1 a2 a3  18 gain target (level, mix, LFO amp)  19 / 20 / 21 sends now (FX LFO)
//   22 / 23 DRIVE: gain into the soft clip, its level compensation (22 = 1: no drive)
// LFO slots (q = MLF + 24 * k): 0 shape  1 rate Hz  2 sync  3 beats  4 depth  5 destination  6 target
//   8 phase  9 held (S&H)  10 / 11 smooth-random end points  12 value now (for the panel)

L12 = log(2) / 12; LN2 = log(2);

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#mn_def = "0 2 2 0 2 0 -4 50 3 7 5 35 50 70 900 20 1400 25 0 3000 1 12 0 50 0 19 3 50 40 60 3000 10 3000 10 1 400 1500 70 2500 40 20 300 2 0 0.07 0 3 40 3 2 1 0.13 0 3 30 6 2 5 0.05 0 3 25 0 6 0 0.2 0 3 0 5 5 0 0.05 30 7 0 20 10 50 0 30 10 50 0 20 35 60 1 20 30 60 0 3 0 8 60 1 0.4 50 60 1 40 45 30 2 0 60 20 55 35 0.6 70 0 70 0 70 35 -3 0 0 30 120 6000 -0.3 1 40 0 0 1";

function mn_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
mn_nums(#mn_def, MDEF);

#mn_pm = "Init|Moonrise|Tidal Siren|Night Swim|Dark Water|Lunar Choir|Wolf Hour|Crescent Pulse|Rain on the Lake|Silver Light|Dream Latch|Eclipse|Low Tide|Howl";
function mn_pstr(p) (
  p == 2  ? "5:2 9:2 10:12 11:-6 13:40 15:500 17:800 16:30 18:20 20:6000 45:0.03 48:55 105:1 108:60 107:70 114:75 116:55 110:30" :
  p == 3  ? "9:0 10:12 11:0 13:55 17:2500 42:6000 65:3 66:0.06 69:60 70:2 71:1 105:2 108:25 107:75 114:80" :
  p == 4  ? "92:2 93:4.5 96:90 80:1 88:1 97:1 99:75 100:80 21:2 25:2 26:7 27:6 31:1800 33:2200 35:0 105:3 108:40 107:55 116:65" :
  p == 5  ? "3:1 5:2 9:2 10:-12 13:45 15:350 17:500 16:35 18:30 105:0 108:70 107:80 109:30 110:25 116:60 45:0.04 48:50 79:70 83:70" :
  p == 6  ? "5:1 9:1 10:7 11:8 13:50 15:2500 17:3000 21:0 25:0 26:12 105:4 108:55 107:75 109:70 114:80 52:0.09 55:35 56:6 57:2" :
  p == 7  ? "21:2 25:2 26:0 27:-8 31:1400 33:1400 32:35 36:900 39:5000 58:5 59:0.12 62:25 63:1 64:5 42:1200 105:2 108:35 107:80 14:50" :
  p == 8  ? "5:3 9:3 8:20 12:70 10:0 11:9 65:1 66:0.4 69:60 70:5 71:2 92:2 94:1 95:8 96:80 76:1 80:1 105:3 108:30 107:50 101:5 104:40" :
  p == 9  ? "105:3 108:12 107:65 110:20 114:80 101:2 102:55 104:40 21:0 25:1 26:12 36:5 37:900 38:0 39:3000 86:60 90:60" :
  p == 10 ? "105:4 108:80 107:85 109:85 15:4000 17:5000 16:10 18:10 5:0 9:1 10:19 112:80 114:72" :
  p == 11 ? "105:2 108:45 107:85 110:50 111:0.3 114:72 116:50 20:5000" :
  p == 12 ? "105:0 108:50 106:4 113:45 107:70 5:3 9:2 10:-5 11:0 15:600 17:700 16:55 18:50 58:4 59:0.3 62:40 63:3 64:2" :
  p == 13 ? "3:1 5:0 9:0 10:7 11:4 13:50 14:85 52:0.03 55:80 56:6 57:2 105:1 108:70 107:90 116:80 79:30 83:30" :
  p == 14 ? "1:0 105:2 106:1 108:30 110:60 111:0.25 21:0 25:0 26:7 58:0 59:0.2 62:15 63:1 64:5 42:2500 36:1500 39:8000" :
  "";
);
function load_preset(p) local(n, i) (
  // the DRONE's START / STOP (a preset never starts or stops it; Howl's own "1:0" is passed over), TRANSPORT, FATE,
  // the MIDI channel and the output stage stay as they are
  i = 0; loop(129, ((i != 116 && i < 118) || i >= 125) && i != 0 ? slider(i + 1) = MDEF[i]; i += 1; );
  n = mn_nums(mn_pstr(p), MTMP);
  i = 0; loop(floor(n / 2), MTMP[i * 2] >= 2 && MTMP[i * 2] <= 129 ? slider(MTMP[i * 2]) = MTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(129, ui_auto(i); i += 1; );
  pr_cur = p; mn_panic = 1;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(129, slider(i + 1) = MDEF[i]; ui_auto(i + 1); i += 1; );
  slider130 = 1; ui_auto(130);
);

// ---------- rates ----------
function mn_lfo_beats(r) ( r == 0 ? 32 : r == 1 ? 16 : r == 2 ? 8 : r == 3 ? 4 : r == 4 ? 2 : r == 5 ? 4 / 3 : r == 6 ? 1 :
                           r == 7 ? 2 / 3 : r == 8 ? 0.5 : r == 9 ? 1 / 3 : r == 10 ? 0.25 : 1 / 6; );
function mn_dly_beats(r) ( r == 0 ? 2 : r == 1 ? 1.5 : r == 2 ? 1 : r == 3 ? 2 / 3 : r == 4 ? 0.75 : r == 5 ? 0.5 : r == 6 ? 1 / 3 : 0.25; );
// LFO value: shape at phase ph; hv = held value (S&H), a / b the smooth-random end points
function mn_lfov(sh, ph, hv, a, b) (
  sh == 0 ? sin(2 * $pi * ph) : sh == 1 ? 1 - 4 * abs(ph - 0.5) : sh == 2 ? 2 * ph - 1 :
  sh == 3 ? (ph < 0.5 ? 1 : -1) : sh == 4 ? hv : a + (b - a) * (0.5 - 0.5 * cos($pi * ph));
);
// which oscillators a TARGET reaches (bits: 1 drone 1, 2 drone 2, 4 lead 1, 8 lead 2)
function mn_tmask(t) ( t == 0 ? 1 : t == 1 ? 2 : t == 2 ? 3 : t == 3 ? 4 : t == 4 ? 8 : t == 5 ? 12 : 15; );

// ---------- the LEAD pair: mono, last-note priority; MONO retriggers, LEGATO glides on ----------
function mn_on(n, v) local(i, f) (
  f = -1; i = 0; loop(mn_hc, MHN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(mn_hc - f - 1, MHN[i] = MHN[i + 1]; i += 1; ); mn_hc -= 1; );
  mn_hc < 127 ? ( MHN[mn_hc] = n; mn_hc += 1; );
  mn_fnote = n; mn_fvel = v / 127; mn_held = 1; mn_pheld = 0;
  // a new phrase (nothing sounding) or MONO: a fresh attack (from the level it is at); LEGATO over a held note: no new
  // attack, it glides on
  mn_fst == 0 || mn_fst == 3 || !mn_legato ? ( mn_fst = 1; mn_fvg = 1 - mn_avel + mn_avel * mn_fvel; );
  mn_fst <= 1 && mn_fl < 0.001 ? mn_fsnap = 1;
  mn_dfol ? mn_droot = n % 12;
);
function mn_off(n) local(i, f) (
  f = -1; i = 0; loop(mn_hc, MHN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(mn_hc - f - 1, MHN[i] = MHN[i + 1]; i += 1; ); mn_hc -= 1;
    mn_hc > 0 ? mn_fnote = MHN[mn_hc - 1] : ( mn_held = 0; mn_pedal ? mn_pheld = 1 : mn_fst > 0 ? mn_fst = 3; );
  );
);
function mn_all_off() ( mn_hc = 0; mn_held = 0; mn_pheld = 0; mn_fst > 0 ? mn_fst = 3; );
function mn_pedal_up() ( mn_pheld && !mn_held ? ( mn_pheld = 0; mn_fst > 0 ? mn_fst = 3; ); );
function mn_qpush(ofs, t, n, v) local(i) (
  mn_qc < 300 ? (
    i = mn_qc; while (i > 0 && MQO[i - 1] > ofs) ( MQO[i] = MQO[i - 1]; MQT[i] = MQT[i - 1]; MQN[i] = MQN[i - 1]; MQV[i] = MQV[i - 1]; i -= 1; );
    MQO[i] = ofs; MQT[i] = t; MQN[i] = n; MQV[i] = v; mn_qc += 1;
  );
);

// ---------- one oscillator: wave, its 12 dB low-pass, its smoothed gain (state in its own namespace) ----------
function mn_osc(q) instance(ph, s1, s2, ag) local(inc, x, t, v1, v2, v3) (
  inc = q[13]; ph += inc; ph -= floor(ph);
  x = q[0] == 0 ? sin(2 * $pi * ph) :
      q[0] == 1 ? 1 - 4 * abs(ph - 0.5) :
      q[0] == 2 ? 2 * ph - 1 - vo_blep(ph, inc) : (
        t = ph + 1 - q[14]; t -= floor(t);
        (2 * ph - 1 - vo_blep(ph, inc)) - (2 * t - 1 - vo_blep(t, inc));
      );
  // DRIVE (before the filter)
  q[22] > 1.001 ? x = vo_tanh(x * q[22]) * q[23];
  // zero-delay state-variable low-pass
  v3 = x - s2; v1 = q[15] * s1 + q[16] * v3; v2 = s2 + q[16] * s1 + q[17] * v3;
  s1 = 2 * v1 - s1; s2 = 2 * v2 - s2;
  abs(s1) + abs(s2) > 40 ? s1 = s2 = 0;                   // safety: never let a filter run away
  ag += (q[18] - ag) * mn_agc;                             // (the gain glides: square LFOs on AMP or MIX never click)
  v2 * ag;
);
function mn_ofresh() instance(ph, s1, s2, ag) ( ph = rand(1); s1 = s2 = 0; ag = 0; );

// ---------- a pitch shifter (two crossfaded grains): ratio < 1 down, > 1 up ----------
function mn_shift(buf, x, ratio, win) instance(w, ph) local(d1, d2, r1, r2, i1, i2, f1, f2, g1, y) (
  buf[w] = x;
  ph += (1 - ratio) / win; ph -= floor(ph);
  d1 = 2 + ph * win; d2 = ph + 0.5; d2 -= floor(d2); d2 = 2 + d2 * win;
  r1 = w - d1; i1 = floor(r1); f1 = r1 - i1; r2 = w - d2; i2 = floor(r2); f2 = r2 - i2;
  g1 = 0.5 - 0.5 * cos(2 * $pi * ph);
  y = (buf[i1 & (MPN - 1)] * (1 - f1) + buf[(i1 + 1) & (MPN - 1)] * f1) * g1
    + (buf[i2 & (MPN - 1)] * (1 - f2) + buf[(i2 + 1) & (MPN - 1)] * f2) * (1 - g1);
  w = (w + 1) & (MPN - 1);
  y;
);

// ---------- reverb parts ----------
// one line: read (its length glides to the target; m swims it), damp, scale
// The lines that swim read through a 4-point Hermite interpolator: nearly flat to the top of the trail's band, so
// it keeps its top end and a latched pad holds its level.
function mn_rl(base, lt, g, m) instance(ln, z, ap, dc) local(rp, ri, f, xm, x0, x1, x2, c1, c2, c3, d) (
  ln += (lt - ln) * 0.0004;
  m != 0 ? (
    rp = mn_rw - ln - m; ri = floor(rp); f = rp - ri;
    xm = base[(ri - 1) & (MRVN - 1)]; x0 = base[ri & (MRVN - 1)]; x1 = base[(ri + 1) & (MRVN - 1)]; x2 = base[(ri + 2) & (MRVN - 1)];
    c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
    d = ((c3 * f + c2) * f + c1) * f + x0;
  ) : d = base[(mn_rw - floor(ln + 0.5)) & (MRVN - 1)];
  z += (d - z) * mn_rdc;
  dc += (z - dc) * mn_rhp;                                 // (a 3 Hz DC block: nothing builds up unheard in the loop)
  (z - dc) * g;
);
function mn_ap(base, n, x, k) instance(w) local(d, v) (
  d = base[(w - n) & (MAPN - 1)]; v = x + k * d; base[w] = v; w = (w + 1) & (MAPN - 1);
  d - k * v;
);
function mn_rinit(lt) instance(ln, z, ap, dc) ( ln = lt; z = 0; ap = 0; dc = 0; );
// the trail's modulation wave (in delay; its slope is the pitch): 0 sine, 1 warp, 2 sink, 3 square (stepped pitch), 4 random
function mn_rwave(wv, ph) (
  wv == 0 ? sin(2 * $pi * ph) :
  wv == 1 ? ( ph < 0.3 ? 1 - 2 * ph / 0.3 : -1 + 2 * (ph - 0.3) / 0.7 ) :
  wv == 2 ? ( ph < 0.3 ? -1 + 2 * ph / 0.3 : 1 - 2 * (ph - 0.3) / 0.7 ) :
  1 - 4 * abs(ph - 0.5);
);

// ---------- parameters ----------
function mn_c8(ms) ( 1 - exp(-4.6 * 8 / (max(ms, 0.05) * 0.001 * srate)); );   // a one-pole step at the 8-sample tick
function mn_oset(i, wv, tn, fn, pw, cut, res, sb, pan) local(q) (
  q = MOP + i * 24;
  q[5] = 1 - max(pan, 0); q[6] = 1 + min(pan, 0);
  q[0] = floor(slider(wv) + 0.5); q[1] = slider(tn) + slider(fn) / 100; q[2] = slider(pw) / 100;
  q[3] = slider(cut); q[4] = min(slider(res) / 100, 1) * 0.95;
  q[7] = slider(sb) >= 0.5; q[8] = slider(sb + 1) / 100; q[9] = slider(sb + 2) / 100; q[10] = slider(sb + 3) / 100;
);
function mn_lset(k) local(q, b) (
  q = MLF + k * 24; b = 44 + 7 * k;
  q[0] = floor(slider(b) + 0.5); q[2] = slider(b + 2) >= 0.5; q[3] = mn_lfo_beats(floor(slider(b + 3) + 0.5));
  q[1] = q[2] ? mn_tmp / 60 / q[3] : slider(b + 1);
  q[4] = slider(b + 4) / 100; q[5] = floor(slider(b + 5) + 0.5); q[6] = floor(slider(b + 6) + 0.5);
);
function mn_dtab(i) ( i == 0 ? 0 : i == 1 ? -1.0 : i == 2 ? -2.8 : i == 3 ? -2.3 : -2.5; );
function mn_dtrim(d) local(f, i) ( f = d / 25; i = min(floor(f), 3); f -= i; 10 ^ ((mn_dtab(i) * (1 - f) + mn_dtab(i + 1) * f) / 20); );
function update() local(i, sp, rain) (
  mn_tmp = tempo > 0 ? tempo : 120;
  mn_don = slider1 >= 0.5; mn_drt = floor(slider2 + 0.5); mn_doct = floor(slider3 + 0.5); mn_dfol = slider4 >= 0.5;
  mn_oset(0, 5, 6, 7, 8, 15, 16, 76, -0.3);
  mn_oset(1, 9, 10, 11, 12, slider19 >= 0.5 ? 15 : 17, slider19 >= 0.5 ? 16 : 18, 80, 0.3);
  mn_oset(2, 21, 22, 23, 24, 31, 32, 84, -0.18);
  mn_oset(3, 25, 26, 27, 28, slider35 >= 0.5 ? 31 : 33, slider35 >= 0.5 ? 32 : 34, 88, 0.18);
  mn_dmix = slider13 / 100; mn_dlev = sqr(slider14 / 100) * 0.55; mn_dsw = vo_coef(slider20);
  mn_fmix = slider29 / 100; mn_flev = sqr(slider30 / 100) * 0.55;
  mn_aa = vo_coef(slider36); mn_ad = vo_coef(slider37); mn_as = slider38 / 100; mn_ar = vo_coef(slider39);
  mn_avel = slider40 / 100; mn_fenv = slider41 / 100;
  mn_gc = slider42 > 0 ? mn_c8(slider42) : 1;
  mn_dgc = mn_c8(max(slider42, slider20 * 0.25));           // the drone glides to a new root at least as slowly as it swells
  mn_brng = slider43;
  i = 0; loop(4, mn_lset(i); i += 1; );
  mn_xs = floor(slider72 + 0.5); mn_xr0 = slider73; mn_xd = slider74 / 100; mn_xt = floor(slider75 + 0.5);
  mn_ts = floor(slider92 + 0.5); mn_tsy = slider94 >= 0.5; mn_tb = mn_lfo_beats(floor(slider95 + 0.5));
  mn_tr0 = mn_tsy ? mn_tmp / 60 / mn_tb : slider93; mn_td = slider96 / 100;
  mn_cm = floor(slider97 + 0.5); mn_cr0 = slider98; mn_cd = slider99 / 100; mn_cl = slider100 / 100;
  mn_dlb = mn_dly_beats(floor(slider101 + 0.5)); mn_dfb = slider102 / 100 * 0.95; mn_dlv = slider104 / 100;
  mn_dtc = 1 - exp(-2 * $pi * min(900 * 2 ^ (slider103 / 100 * 4), srate * 0.45) / srate);
  mn_dlt = min(mn_dlb * 60 / mn_tmp * srate, MDM - 4);
  mn_rmode = floor(slider105 + 0.5); mn_rwv = floor(slider106 + 0.5);
  mn_rdec = slider107 / 100; mn_rx = slider108 / 100; mn_rflt = slider109 / 100; mn_rmd = slider110 / 100;
  mn_rmr = slider111; mn_rwid = slider112 / 50; mn_rlo = slider113 / 100; mn_rlev = slider114 / 100;
  mn_rsus = slider115 >= 0.5;
  mn_duck = slider126 / 100; mn_legato = slider129 >= 0.5;
  // DRIVE: up to +24 dB into the soft clip; a measured trim keeps the level even at any setting
  MOP[22] = MOP[24 + 22] = 10 ^ (slider127 / 100 * 24 / 20); MOP[23] = MOP[24 + 23] = mn_dtrim(slider127);
  MOP[48 + 22] = MOP[72 + 22] = 10 ^ (slider128 / 100 * 24 / 20); MOP[48 + 23] = MOP[72 + 23] = mn_dtrim(slider128);
  mn_dry = slider116 / 100; mn_fate = slider117 / 100; mn_volt = 10 ^ (slider118 / 20); mn_chan = slider119;
  mn_pis = $pi / srate; mn_440s = 440 / srate; mn_fmax = srate * 0.45;
  // reverb: lengths (ms, mutually prime-ish) grow with DECAY; RAIN spaces them out so the taps are heard
  rain = mn_rmode == 3;
  sp = srate / 1000 * (0.75 + 0.85 * mn_rdec) * (rain ? 1.9 : 1);
  MRLT[0] = 37.1 * sp; MRLT[1] = 41.3 * sp; MRLT[2] = 47.9 * sp; MRLT[3] = 53.3 * sp;
  MRLT[4] = 59.7 * sp; MRLT[5] = 67.1 * sp; MRLT[6] = 73.9 * sp; MRLT[7] = 81.7 * sp;
  i = 0; loop(8, MRLT[i] = min(MRLT[i], MRVN - 600); i += 1; );
  mn_rt60t = 0.8 + 28 * mn_rdec ^ 2;
  mn_rfc = 1400 * 2 ^ (mn_rflt * 3.6) * (mn_rmode == 0 ? 0.6 : mn_rmode == 4 ? 1.5 : 1);
  mn_rdt = 1 - exp(-2 * $pi * min(mn_rfc, srate * 0.45) / srate);
  mn_rdif = rain ? 0.7 * mn_rx : 0.62;                       // input diffusion
  mn_rain = rain;                                            // RAIN: three stages of pair rotations by X x 45 degrees, then
  mn_rcs = cos(mn_rx * 0.25 * $pi); mn_rsn = sin(mn_rx * 0.25 * $pi);   // each line into the next: lossless for every X
  mn_rinx = rain ? 0.45 + 0.55 * mn_rx : 1;                    // (less input: the plain loop rings up a steady tone)
  mn_rrise = 0.1 * 2 ^ (mn_rx * 5.3);                        // RISE: 0.1 .. 4 s
  mn_rsc = 1 - exp(-1 / (mn_rrise * srate));
  // LO-FI: hold the trail for 1 .. 16 samples (with a low-pass first, so the steps do not alias)
  mn_rhn = 1 + floor(mn_rlo * mn_rlo * 15);
  mn_rlc = 1 - exp(-2 * $pi * min(srate * 0.45 / mn_rhn, srate * 0.45) / srate);
  ins_output_setup(120);   // output stage: CLIP, always on
);

ins_drift_init();
mn_dl0.drift_init(0.8 + rand(0.5)); mn_dl1.drift_init(0.8 + rand(0.5)); mn_dl2.drift_init(0.8 + rand(0.5)); mn_dl3.drift_init(0.8 + rand(0.5));
mn_dd0.drift_init(0.8 + rand(0.5)); mn_dd1.drift_init(0.8 + rand(0.5)); mn_dd2.drift_init(0.8 + rand(0.5)); mn_dd3.drift_init(0.8 + rand(0.5));
mn_dp0.drift_init(0.8 + rand(0.5)); mn_dp1.drift_init(0.8 + rand(0.5)); mn_dp2.drift_init(0.8 + rand(0.5)); mn_dp3.drift_init(0.8 + rand(0.5));
mn_db0.drift_init(0.8 + rand(0.5)); mn_db1.drift_init(0.8 + rand(0.5)); mn_db2.drift_init(0.8 + rand(0.5)); mn_db3.drift_init(0.8 + rand(0.5));
mn_dfx.drift_init(0.8 + rand(0.5)); mn_dtr.drift_init(0.8 + rand(0.5)); mn_dch.drift_init(0.8 + rand(0.5));
mn_pcf = 0; mn_pcg = 1; mn_bend = 0; mn_mw = 0; mn_pedal = 0; mn_hc = 0; mn_held = 0; mn_pheld = 0; mn_qc = 0; mn_ct = 7;
mn_fst = 0; mn_fl = 0; mn_fvg = 1; mn_fnote = 60; mn_fvel = 0.8; mn_fsnap = 1; mn_dg = 0; mn_droot = -1; mn_first = 1;
mn_xph = 0; mn_xv = 0; mn_tph = 0; mn_tg = 1; mn_cph = 0; mn_cph2 = 0.25; mn_vol = 1; mn_wp = 0; mn_rw = 0; mn_dts = -1;
mn_rt60 = 0.8 + 28 * 0.36; mn_frz = 0; mn_rin = 1; mn_rmph = 0; mn_rmv0 = mn_rmv1 = mn_rmv2 = mn_rmv3 = 0; mn_rmt = 0;
mn_ref = mn_res = 0; mn_rhc = 0; mn_rprev = 0; mn_lph0 = mn_lph1 = mn_lph2 = mn_lph3 = 0;
i_ = 0; loop(4, MLF[i_ * 24 + 8] = rand(1); MLF[i_ * 24 + 10] = rand(2) - 1; MLF[i_ * 24 + 11] = rand(2) - 1; i_ += 1; );
mn_o0.mn_ofresh(); mn_o1.mn_ofresh(); mn_o2.mn_ofresh(); mn_o3.mn_ofresh();
function mn_srinit() (
  mn_sr = srate; mn_sm = 1 - exp(-1 / (0.03 * srate)); ost_init(20000); mn_dts = -1;
  MAPL[0] = min(floor(4.77 * srate / 1000), MAPN - 2); MAPL[1] = min(floor(3.59 * srate / 1000), MAPN - 2);
  MAPL[2] = min(floor(12.73 * srate / 1000), MAPN - 2); MAPL[3] = min(floor(9.31 * srate / 1000), MAPN - 2);
  mn_ap0.w = mn_ap1.w = mn_ap2.w = mn_ap3.w = 0;
  update();
  mn_r0.mn_rinit(MRLT[0]); mn_r1.mn_rinit(MRLT[1]); mn_r2.mn_rinit(MRLT[2]); mn_r3.mn_rinit(MRLT[3]);
  mn_r4.mn_rinit(MRLT[4]); mn_r5.mn_rinit(MRLT[5]); mn_r6.mn_rinit(MRLT[6]); mn_r7.mn_rinit(MRLT[7]);
  mn_agc = 1 - exp(-1 / (0.004 * srate));               // oscillator gains glide (4 ms)
  mn_tgc = 1 - exp(-1 / (0.004 * srate));               // tremolo: a hard square still has 4 ms edges
  mn_pcdn = 1 / (0.012 * srate); mn_pcup = 1 / (0.02 * srate);   // preset change: 12 ms out, 20 ms in
  mn_sgc = 1 - exp(-8 / (0.02 * srate));                // sends glide at the tick (20 ms)
  mn_rmc = 1 - exp(-8 / (0.04 * srate));                // the trail's mod wave is rounded (40 ms)
  mn_rfa = 1 - exp(-1 / (0.002 * srate)); mn_rfr = 1 - exp(-1 / (0.25 * srate));   // RISE: level followers
  mn_sca = 1 - exp(-1 / (0.01 * srate)); mn_scr = 1 - exp(-1 / (0.35 * srate));   // the duck: 10 ms in, 350 ms out
  mn_frzc = 1 - exp(-1 / (0.05 * srate));               // DREAM latch: in / out over 50 ms
  mn_fec = 1 - exp(-1 / (0.4 * srate));
  mn_rhp = 1 - exp(-2 * $pi * 3 / srate);
  mn_shp = 1 - exp(-2 * $pi * 40 / srate);               // the shimmer feed's own DC / rumble block                 // (the trail's level, for the latch's hold)
  mn_pdw = floor(0.07 * srate); mn_puw = floor(0.05 * srate);   // shifter grains (70 / 50 ms)
  mn_pdw = min(mn_pdw, MPN - 8); mn_puw = min(mn_puw, MPN - 8);
);
mn_srinit();
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );               // a new instance opens Large, on Init
mn_vol = mn_volt;
ui_dflt = 1;

@slider
!mn_pcf && !mn_panic ? update();                    // (during a preset change the old settings hold until it is silent)

@block
srate != mn_sr ? mn_srinit();
// TRANSPORT: while lit, REAPER's play (or record) presses the drone's START and its stop presses STOP (it swells in
// and fades away over SWELL as by hand); the keys still work by hand
mn_xp = play_state & 1;
slider130 >= 0.5 && mn_xp != mn_xpw ? ( slider1 = mn_xp; mn_don = mn_xp; ui_auto(1); );
mn_xpw = mn_xp;
// a preset change: the old sound fades out (12 ms), the new settings apply at the silent point (the effects and
// filters start clean, the pitches land straight on their notes) and it all fades back in (20 ms): no click
mn_panic && !mn_pcf ? ( mn_pcf = 1; mn_panic = 0; );
mn_pcf == 2 ? (
  memset(MRV, 0, 8 * MRVN); memset(MAP, 0, 4 * MAPN); memset(MPD, 0, MPN); memset(MPU, 0, MPN);
  memset(MCH, 0, MCHN); memset(MDL, 0, 524288 * 2);
  mn_r0.z = mn_r1.z = mn_r2.z = mn_r3.z = mn_r4.z = mn_r5.z = mn_r6.z = mn_r7.z = 0;
  mn_r0.dc = mn_r1.dc = mn_r2.dc = mn_r3.dc = mn_r4.dc = mn_r5.dc = mn_r6.dc = mn_r7.dc = 0;
  mn_dfl = mn_dfr = 0; mn_frz = 0; mn_flat = 0; mn_fe = 0; mn_ref = mn_res = 0; mn_rprev = 0; mn_shd = 0;
  mn_o0.s1 = mn_o0.s2 = mn_o1.s1 = mn_o1.s2 = mn_o2.s1 = mn_o2.s2 = mn_o3.s1 = mn_o3.s2 = 0;
  mn_all_off(); mn_fl = 0; mn_fst = 0; mn_first = 1;
  mn_pcf = 3;                                             // fading back in
);
mn_pcf != 1 ? update();

// MIDI in, sample-accurate through the queue (type 1 on, 0 off, 2 pedal up, 3 all off)
mn_qc = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, mn_chan) ? (
    mn_st = m1 & 0xF0;
    mn_st == 0x90 || mn_st == 0x80 ? (
      mn_on_ = mn_st == 0x90 && m3 > 0;
      mn_qpush(mofs, mn_on_, m2, m3);
      mn_on_ ? ins_midi_hit();
    ) :
    mn_st == 0xE0 ? mn_bend = (((m3 * 128 + m2) - 8192) / 8192) * mn_brng :
    mn_st == 0xB0 ? (
      m2 == 1 ? mn_mw = m3 / 127 :
      m2 == 64 ? ( mn_pedal = m3 >= 64; !mn_pedal ? mn_qpush(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? mn_qpush(mofs, 3, 0, 0);
    );
  );
);
mn_eqi = 0; mn_spos = 0;

// the drone's note
mn_droot < 0 || !mn_dfol ? mn_droot = mn_drt;
mn_dnote = 12 * (mn_doct + 1) + mn_droot;

// FATE: the tides, and the oscillators beating
ins_drift_block(mn_fate * 0.6, samplesblock);
mn_dps = 12 * log(ins_pitch) / LN2;
mn_di = 0.09 * samplesblock / srate;
mn_lr0 = 2 ^ (mn_dl0.drift_tick(mn_di) * mn_fate * 0.5); mn_lr1 = 2 ^ (mn_dl1.drift_tick(mn_di) * mn_fate * 0.5);   // rates up to about +/-40 %
mn_lr2 = 2 ^ (mn_dl2.drift_tick(mn_di) * mn_fate * 0.5); mn_lr3 = 2 ^ (mn_dl3.drift_tick(mn_di) * mn_fate * 0.5);
mn_ld0 = 1 + mn_dd0.drift_tick(mn_di) * mn_fate * 0.3; mn_ld1 = 1 + mn_dd1.drift_tick(mn_di) * mn_fate * 0.3;    // depths +/-30 %
mn_ld2 = 1 + mn_dd2.drift_tick(mn_di) * mn_fate * 0.3; mn_ld3 = 1 + mn_dd3.drift_tick(mn_di) * mn_fate * 0.3;
mn_lp0 = mn_dp0.drift_tick(mn_di * 0.6) * mn_fate * 0.15; mn_lp1 = mn_dp1.drift_tick(mn_di * 0.6) * mn_fate * 0.15;   // phases +/-54 degrees
mn_lp2 = mn_dp2.drift_tick(mn_di * 0.6) * mn_fate * 0.15; mn_lp3 = mn_dp3.drift_tick(mn_di * 0.6) * mn_fate * 0.15;
MOP[12]      = mn_db0.drift_tick(mn_di * 1.3) * mn_fate * 0.16;   // each oscillator's own wander: +/-8 cents at 50 %
MOP[24 + 12] = mn_db1.drift_tick(mn_di * 1.3) * mn_fate * 0.16;
MOP[48 + 12] = mn_db2.drift_tick(mn_di * 1.3) * mn_fate * 0.16;
MOP[72 + 12] = mn_db3.drift_tick(mn_di * 1.3) * mn_fate * 0.16;
mn_xr = mn_xr0 * 2 ^ (mn_dfx.drift_tick(mn_di) * mn_fate * 0.5);
mn_tr = mn_tr0 * (mn_tsy ? 1 : 2 ^ (mn_dtr.drift_tick(mn_di) * mn_fate * 0.3));
mn_cr = mn_cr0 * 2 ^ (mn_dch.drift_tick(mn_di) * mn_fate * 0.4);
// synced LFOs and the synced tremolo follow the project's beat while it plays
play_state & 1 ? (
  i_ = 0; loop(4, q_ = MLF + i_ * 24; q_[2] ? ( t_ = beat_position / q_[3]; q_[8] = t_ - floor(t_); ); i_ += 1; );
  mn_tsy ? ( t_ = beat_position / mn_tb; mn_tph = t_ - floor(t_); );
);
// the reverb's decay: SUSTAIN grows it to its longest; DREAM latches (the trail holds, nothing more comes in)
mn_frzt = mn_rsus && mn_rmode == 2;
mn_rt60 += ((mn_rsus && !mn_frzt ? 60 : mn_rt60t) - mn_rt60) * (1 - exp(-samplesblock / (1.2 * srate)));
i_ = 0; loop(8, MRG[i_] = 10 ^ (-3 * MRLT[i_] / (mn_rt60 * srate)); i_ += 1; );
mn_rwg = 0.5 * (2 / mn_rt60) ^ 0.15;                     // longer trails gather more: keep the wet level even
mn_dts < 0 ? mn_dts = mn_dlt;
abs(mn_dfl) + abs(mn_dfr) < 0.0000000001 ? mn_dfl = mn_dfr = 0;
abs(mn_dcyl) + abs(mn_dcyr) < 0.0000000001 ? mn_dcyl = mn_dcyr = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
while (mn_eqi < mn_qc && (MQO[mn_eqi] <= mn_spos || mn_spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  mn_et = MQT[mn_eqi];
  mn_et == 1 ? mn_on(MQN[mn_eqi], MQV[mn_eqi]) : mn_et == 0 ? mn_off(MQN[mn_eqi]) : mn_et == 2 ? mn_pedal_up() : mn_all_off();
  mn_eqi += 1;
);
mn_spos += 1;

// ---------- control tick (every 8 samples): LFOs, pitches, filters, gains, sends ----------
mn_ct += 1;
mn_ct >= 8 ? (
  mn_ct = 0;
  memset(MMF, 0, 70); MMA[0] = MMA[1] = MMA[2] = MMA[3] = 1;
  // ----- the four LFOs -----
  mn_k = 0;
  loop(4,
    mn_q = MLF + mn_k * 24;
    mn_lr = mn_k == 0 ? mn_lr0 : mn_k == 1 ? mn_lr1 : mn_k == 2 ? mn_lr2 : mn_lr3;
    mn_q[8] += mn_q[1] * (mn_q[2] ? 1 : mn_lr) * 8 / srate;
    mn_q[8] >= 1 ? ( mn_q[8] -= floor(mn_q[8]); mn_q[9] = rand(2) - 1; mn_q[10] = mn_q[11]; mn_q[11] = rand(2) - 1; );
    mn_t = mn_q[8] + (mn_k == 0 ? mn_lp0 : mn_k == 1 ? mn_lp1 : mn_k == 2 ? mn_lp2 : mn_lp3); mn_t -= floor(mn_t);
    mn_v = mn_lfov(mn_q[0], mn_q[0] >= 4 ? mn_q[8] : mn_t, mn_q[9], mn_q[10], mn_q[11]);
    mn_q[12] = mn_v;
    mn_d = mn_q[4] * (mn_k == 0 ? mn_ld0 * (1 + mn_mw) : mn_k == 1 ? mn_ld1 : mn_k == 2 ? mn_ld2 : mn_ld3);
    mn_d > 0.0001 ? (
      mn_m = mn_tmask(mn_q[6]); mn_ds = mn_q[5];
      mn_ds == 6 ? (
        mn_m & 3  ? ( MMX[0] += mn_v * mn_d * 0.5; );
        mn_m & 12 ? ( MMX[1] += mn_v * mn_d * 0.5; );
      ) : (
        mn_i = 0;
        loop(4,
          mn_m & (1 << mn_i) ? (
            mn_ds == 0 ? ( MMF[mn_i] += mn_v * mn_d * 0.5; ) :
            mn_ds == 1 ? ( MMT[mn_i] += mn_v * mn_d * 12; ) :
            mn_ds == 2 ? ( MMO[mn_i] += 12 * min(max(floor(mn_v * mn_d * 2 + 0.5), -2), 2); ) :
            mn_ds == 3 ? ( MMC[mn_i] += mn_v * mn_d * 4; ) :
            mn_ds == 4 ? ( MMA[mn_i] *= 1 - min(mn_d, 1) * (0.5 - 0.5 * mn_v); ) :
            ( MMP[mn_i] += mn_v * mn_d * 0.45; );
          );
          mn_i += 1;
        );
      );
    );
    mn_k += 1;
  );
  // ----- the FX LFO -----
  mn_xph += mn_xr * 8 / srate;
  mn_xph >= 1 ? ( mn_xph -= floor(mn_xph); mn_xh = rand(2) - 1; mn_xa = mn_xb; mn_xb = rand(2) - 1; );
  mn_xv = mn_lfov(mn_xs, mn_xph, mn_xh, mn_xa, mn_xb);
  // ----- the lead pair's envelope drives its filters too -----
  mn_snap = mn_first;
  mn_fsnap ? ( MOP[48 + 11] = mn_fnote + MOP[48 + 1] + MMO[2]; MOP[72 + 11] = mn_fnote + MOP[72 + 1] + MMO[3]; mn_fsnap = 0; );
  // ----- each oscillator: pitch (glided), increment, PW, filter, gain, sends -----
  mn_i = 0;
  loop(4,
    mn_q = MOP + mn_i * 24;
    mn_tg_ = (mn_i < 2 ? mn_dnote : mn_fnote) + mn_q[1] + MMO[mn_i];
    mn_snap ? ( mn_q[11] = mn_tg_; ) : ( mn_q[11] += (mn_tg_ - mn_q[11]) * (mn_i < 2 ? mn_dgc : mn_gc); );
    mn_p = mn_q[11] + MMT[mn_i] + MMF[mn_i] + mn_q[12] + mn_dps + (mn_i >= 2 ? mn_bend : 0);
    mn_q[13] = min(exp((mn_p - 69) * L12) * mn_440s, 0.45);
    mn_q[14] = min(max(mn_q[2] + MMP[mn_i], 0.05), 0.95);
    mn_fc = mn_q[3] * 2 ^ (MMC[mn_i] + (mn_i >= 2 ? mn_fenv * 4 * mn_fl : 0));
    mn_g = tan(min(max(mn_fc, 20), mn_fmax) * mn_pis); mn_kk = 2 - 2 * mn_q[4];
    mn_q[15] = 1 / (1 + mn_g * (mn_g + mn_kk)); mn_q[16] = mn_g * mn_q[15]; mn_q[17] = mn_g * mn_q[16];
    // pair level and MIX (equal power), the LFO's AMP; a resonant filter is turned down a little
    mn_mx = min(max((mn_i < 2 ? mn_dmix : mn_fmix) + MMX[mn_i >= 2], 0), 1);
    mn_q[18] = (mn_i < 2 ? mn_dlev : mn_flev) * ((mn_i & 1) ? sin(mn_mx * 0.5 * $pi) : cos(mn_mx * 0.5 * $pi)) * MMA[mn_i]
               * (1 - 0.35 * mn_q[4]);
    // sends, moved by the FX LFO (odd and even oscillators in opposite directions)
    mn_s = (mn_i & 1) ? -mn_xv * mn_xd : mn_xv * mn_xd;
    mn_q[19] += (mn_q[8]  * ((mn_xt & 2) ? max(1 + mn_s, 0) : 1) - mn_q[19]) * mn_sgc;
    mn_q[20] += (mn_q[9]  * ((mn_xt & 4) ? max(1 + mn_s, 0) : 1) - mn_q[20]) * mn_sgc;
    mn_q[21] += (mn_q[10] * ((mn_xt & 1) ? max(1 + mn_s, 0) : 1) - mn_q[21]) * mn_sgc;
    mn_i += 1;
  );
  mn_first = 0;
  // ----- the trail's modulation -----
  mn_rmph += mn_rmr * 8 / srate;
  mn_rmph >= 1 ? ( mn_rmph -= floor(mn_rmph); mn_rr0 = rand(2) - 1; mn_rr1 = rand(2) - 1; mn_rr2 = rand(2) - 1; mn_rr3 = rand(2) - 1; );
  mn_rmdep = (mn_rmd * 9 + (mn_rmode == 2 ? mn_rx * 7 : 0)) * srate / 48000;   // samples (DREAM adds its vibrato)
  mn_rwv == 4 ? (
    mn_rmv0 += (mn_rr0 - mn_rmv0) * mn_rmc * 0.5; mn_rmv1 += (mn_rr1 - mn_rmv1) * mn_rmc * 0.5;
    mn_rmv2 += (mn_rr2 - mn_rmv2) * mn_rmc * 0.5; mn_rmv3 += (mn_rr3 - mn_rmv3) * mn_rmc * 0.5;
  ) : (
    mn_t = mn_rmph;          mn_rmv0 += (mn_rwave(mn_rwv, mn_t) - mn_rmv0) * mn_rmc;
    mn_t = mn_rmph + 0.25; mn_t -= floor(mn_t); mn_rmv1 += (mn_rwave(mn_rwv, mn_t) - mn_rmv1) * mn_rmc;
    mn_t = mn_rmph + 0.5;  mn_t -= floor(mn_t); mn_rmv2 += (mn_rwave(mn_rwv, mn_t) - mn_rmv2) * mn_rmc;
    mn_t = mn_rmph + 0.75; mn_t -= floor(mn_t); mn_rmv3 += (mn_rwave(mn_rwv, mn_t) - mn_rmv3) * mn_rmc;
  );
);

// ---------- envelopes ----------
mn_dg += ((mn_don ? 1 : 0) - mn_dg) * mn_dsw;              // the drone swells in and out
mn_fst == 1 ? ( mn_fl += (1.3 - mn_fl) * mn_aa; mn_fl >= 1 ? ( mn_fl = 1; mn_fst = 2; ); ) :
mn_fst == 2 ? ( mn_fl += (mn_as - mn_fl) * mn_ad; ) :
mn_fst == 3 ? ( mn_fl -= mn_fl * mn_ar; mn_fl < 0.00002 ? ( mn_fl = 0; mn_fst = 0; ); );

// ---------- tremolo ----------
mn_tph += mn_tr / srate; mn_tph -= floor(mn_tph);
mn_tv = mn_ts == 0 ? sin(2 * $pi * mn_tph) : mn_ts == 1 ? 1 - 4 * abs(mn_tph - 0.5) : (mn_tph < 0.5 ? 1 : -1);
mn_tg += (1 - mn_td * (0.5 - 0.5 * mn_tv) - mn_tg) * mn_tgc;

// ---------- the four oscillators ----------
mn_L = mn_R = 0; mn_ci = mn_di_ = mn_ri = 0;
// the LEAD pair first: its level is the duck's key
mn_ky = 0;
mn_fst > 0 ? (
  mn_e = mn_fl * mn_fvg;
  mn_y = mn_o2.mn_osc(MOP + 48) * mn_e; mn_ky += mn_y;
  MOP[48 + 7] ? mn_y *= mn_tg;
  mn_L += mn_y * MOP[48 + 5]; mn_R += mn_y * MOP[48 + 6];
  mn_ci += mn_y * MOP[48 + 19]; mn_di_ += mn_y * MOP[48 + 20]; mn_ri += mn_y * MOP[48 + 21];
  mn_y = mn_o3.mn_osc(MOP + 72) * mn_e; mn_ky += mn_y;
  MOP[72 + 7] ? mn_y *= mn_tg;
  mn_L += mn_y * MOP[72 + 5]; mn_R += mn_y * MOP[72 + 6];
  mn_ci += mn_y * MOP[72 + 19]; mn_di_ += mn_y * MOP[72 + 20]; mn_ri += mn_y * MOP[72 + 21];
) : ( mn_o2.ag = mn_o3.ag = 0; );
// the DUCK: a sidechain compressor on the drone, keyed by the lead (up to 12 dB at full DRONE DUCK, from about
// -42 dBFS of lead upwards, full by -12 dBFS)
mn_t = abs(mn_ky); mn_sce += (mn_t - mn_sce) * (mn_t > mn_sce ? mn_sca : mn_scr);
mn_dkg = mn_duck > 0.001 ? 10 ^ (-mn_duck * 12 * min(max((20 * log10(max(mn_sce, 0.0000001)) + 42) / 30, 0), 1) / 20) : 1;
// the DRONE pair
mn_dg > 0.00001 ? (
  mn_y = mn_o0.mn_osc(MOP) * mn_dg * mn_dkg;
  MOP[7] ? mn_y *= mn_tg;
  mn_L += mn_y * MOP[5]; mn_R += mn_y * MOP[6];
  mn_ci += mn_y * MOP[19]; mn_di_ += mn_y * MOP[20]; mn_ri += mn_y * MOP[21];
  mn_y = mn_o1.mn_osc(MOP + 24) * mn_dg * mn_dkg;
  MOP[24 + 7] ? mn_y *= mn_tg;
  mn_L += mn_y * MOP[24 + 5]; mn_R += mn_y * MOP[24 + 6];
  mn_ci += mn_y * MOP[24 + 19]; mn_di_ += mn_y * MOP[24 + 20]; mn_ri += mn_y * MOP[24 + 21];
) : ( mn_o0.ag = mn_o1.ag = 0; );
mn_oL = mn_L * mn_dry; mn_oR = mn_R * mn_dry;

// ---------- CHORUS: two taps on one line, L / R ----------
MCH[mn_cw] = mn_ci;
mn_cl > 0.001 && (mn_csil < mn_sr || abs(mn_ci) > 0.000001) ? (
  mn_cph += mn_cr / srate; mn_cph -= floor(mn_cph);
  mn_cm == 2 ? ( mn_cph2 += mn_cr * 1.37 / srate; mn_cph2 -= floor(mn_cph2); ) : ( mn_cph2 = mn_cph + (mn_cm == 1 ? 0.5 : 0.08); mn_cph2 -= floor(mn_cph2); );
  mn_cdl = (9 + 6 * mn_cd * (1 + sin(2 * $pi * mn_cph))) * srate * 0.001;
  mn_cdr = (11 + 6 * mn_cd * (1 + sin(2 * $pi * mn_cph2))) * srate * 0.001;
  mn_t = mn_cw - mn_cdl; mn_ti = floor(mn_t); mn_tf = mn_t - mn_ti;
  mn_yl = MCH[mn_ti & (MCHN - 1)] * (1 - mn_tf) + MCH[(mn_ti + 1) & (MCHN - 1)] * mn_tf;
  mn_t = mn_cw - mn_cdr; mn_ti = floor(mn_t); mn_tf = mn_t - mn_ti;
  mn_yr = MCH[mn_ti & (MCHN - 1)] * (1 - mn_tf) + MCH[(mn_ti + 1) & (MCHN - 1)] * mn_tf;
  mn_oL += mn_yl * mn_cl * 1.2; mn_oR += mn_yr * mn_cl * 1.2;
  mn_cdisp = sin(2 * $pi * mn_cph); mn_cdisp2 = sin(2 * $pi * mn_cph2);   // (for the panel)
  abs(mn_ci) + abs(mn_yl) + abs(mn_yr) < 0.000001 ? mn_csil += 1 : mn_csil = 0;
);
mn_cw = (mn_cw + 1) & (MCHN - 1);

// ---------- DELAY: stereo ping-pong ----------
mn_dl1 = mn_dr1 = 0;
mn_dlv > 0.001 && (mn_dsil < mn_sr || abs(mn_di_) > 0.000001) ? (
  mn_dts += (mn_dlt * (1 + 0.004 * ins_fx) - mn_dts) * 0.0002;
  mn_rp = mn_wp - mn_dts; mn_ri_ = floor(mn_rp); mn_rf = mn_rp - mn_ri_;
  mn_dl1 = MDL[mn_ri_ & MDM] * (1 - mn_rf) + MDL[(mn_ri_ + 1) & MDM] * mn_rf;
  mn_dr1 = MDR[mn_ri_ & MDM] * (1 - mn_rf) + MDR[(mn_ri_ + 1) & MDM] * mn_rf;
  mn_dfl += (mn_dl1 - mn_dfl) * mn_dtc; mn_dfr += (mn_dr1 - mn_dfr) * mn_dtc;
  MDL[mn_wp] = mn_di_ + vo_tanh(mn_dfr * mn_dfb);
  MDR[mn_wp] = vo_tanh(mn_dfl * mn_dfb);
  mn_oL += mn_dl1 * mn_dlv; mn_oR += mn_dr1 * mn_dlv;
  abs(mn_di_) + abs(mn_dl1) + abs(mn_dr1) < 0.000001 ? mn_dsil += 1 : mn_dsil = 0;
) : ( MDL[mn_wp] = 0; MDR[mn_wp] = 0; );
mn_wp = (mn_wp + 1) & MDM;

// ---------- TIDE: the ambient reverb ----------
mn_frz += (mn_frzt - mn_frz) * mn_frzc;
mn_x = mn_ri + (mn_dl1 + mn_dr1) * mn_dlv * 0.25;          // (a little of the echoes into the trail)
mn_rlev > 0.001 && (mn_rsil < mn_sr || abs(mn_x) > 0.000001 || mn_frzt) ? (
  // RISE: the trail swells in after each new sound
  mn_rmode == 1 ? (
    mn_t = abs(mn_x); mn_ref += (mn_t - mn_ref) * (mn_t > mn_ref ? mn_rfa : mn_rfr);
    mn_res += (mn_ref - mn_res) * (mn_ref > mn_res ? mn_rsc : mn_rfr);
    mn_x *= mn_ref > 0.000001 ? min(mn_res / mn_ref, 1) : 1;
  );
  // DARK: a lower octave fed into the trail
  mn_rmode == 0 ? mn_x += mn_pd.mn_shift(MPD, mn_x, 0.5, mn_pdw) * mn_rx * 1.3;
  // LIGHT: an octave-up shimmer of the trail fed back in
  mn_rmode == 4 ? (
    mn_t = mn_pu.mn_shift(MPU, mn_rprev, 2, mn_puw); mn_shd += (mn_t - mn_shd) * mn_shp;
    mn_x += vo_tanh((mn_t - mn_shd) * mn_rx * 0.55 * 1.4) / 1.4;
  );
  // DREAM latched: nothing more comes in
  mn_x *= 1 - mn_frz;
  mn_x = mn_ap0.mn_ap(MAP, MAPL[0], mn_x, mn_rdif); mn_x = mn_ap1.mn_ap(MAP + MAPN, MAPL[1], mn_x, mn_rdif);
  mn_x = mn_ap2.mn_ap(MAP + 2 * MAPN, MAPL[2], mn_x, mn_rdif); mn_x = mn_ap3.mn_ap(MAP + 3 * MAPN, MAPL[3], mn_x, mn_rdif);
  mn_rdc = mn_rdt + (1 - mn_rdt) * mn_frz;                 // (latched: no damping, the pad holds its colour)
  mn_g = 1 - mn_frz; mn_mdep = mn_rmdep;
  // latched: the loop's gain is nudged (+/-0.2 % at most) to hold the level the pad was caught at
  mn_frz > 0.98 ? ( !mn_flat ? ( mn_flat = 1; mn_fe0 = mn_fe; ); ) : mn_flat = 0;
  mn_fg = mn_frz * (mn_flat && mn_fe0 > 0.0000000001 ? min(max(1 + 0.004 * (mn_fe0 - mn_fe) / mn_fe0, 0.998), 1.002) : 1);
  mn_y0 = mn_r0.mn_rl(MRV,            MRLT[0], MRG[0] * mn_g + mn_fg, mn_rmv0 * mn_mdep);
  mn_y1 = mn_r1.mn_rl(MRV + MRVN,     MRLT[1], MRG[1] * mn_g + mn_fg, 0);
  mn_y2 = mn_r2.mn_rl(MRV + 2 * MRVN, MRLT[2], MRG[2] * mn_g + mn_fg, mn_rmv1 * mn_mdep);
  mn_y3 = mn_r3.mn_rl(MRV + 3 * MRVN, MRLT[3], MRG[3] * mn_g + mn_fg, 0);
  mn_y4 = mn_r4.mn_rl(MRV + 4 * MRVN, MRLT[4], MRG[4] * mn_g + mn_fg, mn_rmv2 * mn_mdep);
  mn_y5 = mn_r5.mn_rl(MRV + 5 * MRVN, MRLT[5], MRG[5] * mn_g + mn_fg, 0);
  mn_y6 = mn_r6.mn_rl(MRV + 6 * MRVN, MRLT[6], MRG[6] * mn_g + mn_fg, mn_rmv3 * mn_mdep);
  mn_y7 = mn_r7.mn_rl(MRV + 7 * MRVN, MRLT[7], MRG[7] * mn_g + mn_fg, 0);
  mn_fe += (mn_y0 * mn_y0 + mn_y1 * mn_y1 + mn_y2 * mn_y2 + mn_y3 * mn_y3 + mn_y4 * mn_y4 + mn_y5 * mn_y5
            + mn_y6 * mn_y6 + mn_y7 * mn_y7 - mn_fe) * mn_fec;
  mn_ri_ = mn_rw & (MRVN - 1);
  mn_rain ? (
    // RAIN: X sets the rotation angle (0 = no mixing: echo taps; 45 degrees = a full diffusing mix)
    mn_x *= mn_rinx; mn_c = mn_rcs; mn_s = mn_rsn;
    mn_a0 = mn_c * mn_y0 + mn_s * mn_y1; mn_a1 = mn_c * mn_y1 - mn_s * mn_y0; mn_a2 = mn_c * mn_y2 + mn_s * mn_y3; mn_a3 = mn_c * mn_y3 - mn_s * mn_y2;
    mn_a4 = mn_c * mn_y4 + mn_s * mn_y5; mn_a5 = mn_c * mn_y5 - mn_s * mn_y4; mn_a6 = mn_c * mn_y6 + mn_s * mn_y7; mn_a7 = mn_c * mn_y7 - mn_s * mn_y6;
    mn_b0 = mn_c * mn_a0 + mn_s * mn_a2; mn_b2 = mn_c * mn_a2 - mn_s * mn_a0; mn_b1 = mn_c * mn_a1 + mn_s * mn_a3; mn_b3 = mn_c * mn_a3 - mn_s * mn_a1;
    mn_b4 = mn_c * mn_a4 + mn_s * mn_a6; mn_b6 = mn_c * mn_a6 - mn_s * mn_a4; mn_b5 = mn_c * mn_a5 + mn_s * mn_a7; mn_b7 = mn_c * mn_a7 - mn_s * mn_a5;
    mn_a0 = mn_c * mn_b0 + mn_s * mn_b4; mn_a4 = mn_c * mn_b4 - mn_s * mn_b0; mn_a1 = mn_c * mn_b1 + mn_s * mn_b5; mn_a5 = mn_c * mn_b5 - mn_s * mn_b1;
    mn_a2 = mn_c * mn_b2 + mn_s * mn_b6; mn_a6 = mn_c * mn_b6 - mn_s * mn_b2; mn_a3 = mn_c * mn_b3 + mn_s * mn_b7; mn_a7 = mn_c * mn_b7 - mn_s * mn_b3;
    MRV[mn_ri_]            = mn_a7 + mn_x;
    MRV[MRVN + mn_ri_]     = mn_a0 - mn_x;
    MRV[2 * MRVN + mn_ri_] = mn_a1 + mn_x;
    MRV[3 * MRVN + mn_ri_] = mn_a2 - mn_x;
    MRV[4 * MRVN + mn_ri_] = mn_a3 + mn_x;
    MRV[5 * MRVN + mn_ri_] = mn_a4 - mn_x;
    MRV[6 * MRVN + mn_ri_] = mn_a5 + mn_x;
    MRV[7 * MRVN + mn_ri_] = mn_a6 - mn_x;
  ) : (
    // 8-point Hadamard
    mn_a0 = mn_y0 + mn_y1; mn_a1 = mn_y0 - mn_y1; mn_a2 = mn_y2 + mn_y3; mn_a3 = mn_y2 - mn_y3;
    mn_a4 = mn_y4 + mn_y5; mn_a5 = mn_y4 - mn_y5; mn_a6 = mn_y6 + mn_y7; mn_a7 = mn_y6 - mn_y7;
    mn_b0 = mn_a0 + mn_a2; mn_b2 = mn_a0 - mn_a2; mn_b1 = mn_a1 + mn_a3; mn_b3 = mn_a1 - mn_a3;
    mn_b4 = mn_a4 + mn_a6; mn_b6 = mn_a4 - mn_a6; mn_b5 = mn_a5 + mn_a7; mn_b7 = mn_a5 - mn_a7;
    mn_h = 0.35355339;
    MRV[mn_ri_]            = (mn_b0 + mn_b4) * mn_h + mn_x;
    MRV[MRVN + mn_ri_]     = (mn_b1 + mn_b5) * mn_h - mn_x;
    MRV[2 * MRVN + mn_ri_] = (mn_b2 + mn_b6) * mn_h + mn_x;
    MRV[3 * MRVN + mn_ri_] = (mn_b3 + mn_b7) * mn_h - mn_x;
    MRV[4 * MRVN + mn_ri_] = (mn_b0 - mn_b4) * mn_h + mn_x;
    MRV[5 * MRVN + mn_ri_] = (mn_b1 - mn_b5) * mn_h - mn_x;
    MRV[6 * MRVN + mn_ri_] = (mn_b2 - mn_b6) * mn_h + mn_x;
    MRV[7 * MRVN + mn_ri_] = (mn_b3 - mn_b7) * mn_h - mn_x;
  );
  mn_wl = (mn_y0 - mn_y2 + mn_y4 - mn_y6) * 0.5;
  mn_wr = (mn_y1 - mn_y3 + mn_y5 - mn_y7) * 0.5;
  mn_rprev = (mn_wl + mn_wr) * 0.5;
  // WIDTH (50 % = as it comes), then LO-FI
  mn_t = (mn_wl + mn_wr) * 0.5; mn_s = (mn_wl - mn_wr) * 0.5 * mn_rwid; mn_wl = mn_t + mn_s; mn_wr = mn_t - mn_s;
  mn_rhn > 1 ? (
    mn_rzl += (mn_wl - mn_rzl) * mn_rlc; mn_rzr += (mn_wr - mn_rzr) * mn_rlc;
    mn_rhc -= 1; mn_rhc <= 0 ? ( mn_rhc = mn_rhn; mn_rhl = mn_rzl; mn_rhr = mn_rzr; );
    mn_wl = mn_rhl; mn_wr = mn_rhr;
  );
  mn_oL += mn_wl * mn_rlev * mn_rwg; mn_oR += mn_wr * mn_rlev * mn_rwg;
  mn_rdisp = max(mn_rdisp, abs(mn_wl) + abs(mn_wr));      // (for the panel)
  abs(mn_x) + abs(mn_wl) + abs(mn_wr) < 0.000001 ? mn_rsil += 1 : mn_rsil = 0;
);
mn_rw = (mn_rw + 1) & (MRVN - 1);

// DC block
mn_dcyl = mn_oL - mn_dcxl + 0.9996 * mn_dcyl; mn_dcxl = mn_oL; mn_oL = mn_dcyl;
mn_dcyr = mn_oR - mn_dcxr + 0.9996 * mn_dcyr; mn_dcxr = mn_oR; mn_oR = mn_dcyr;

// ---------- MASTER ----------
mn_pcf == 1 ? ( mn_pcg -= mn_pcdn; mn_pcg <= 0 ? ( mn_pcg = 0; mn_pcf = 2; ); ) :
mn_pcf == 3 ? ( mn_pcg += mn_pcup; mn_pcg >= 1 ? ( mn_pcg = 1; mn_pcf = 0; ); );
mn_oL *= mn_pcg; mn_oR *= mn_pcg;
mn_vol += (mn_volt - mn_vol) * mn_sm;
mn_oL = ostL.ost_band(mn_oL * mn_vol); mn_oR = ostR.ost_band(mn_oR * mn_vol);
ost_out(mn_oL, mn_oR);
spl0 = ost_l; spl1 = ost_r;
mn_pk = max(mn_pk, max(abs(spl0), abs(spl1)));

@gfx 1100 670
ui_thm = 13; ui_hw = 1;
ui_begin(1100, 670);

// ---------- the card's colours: midnight blue, silver, the pale moon ----------
INK = 0x070C1A; LBL = 0xDCE3EE; SILV = 0xB9C3D3; SILVH = 0xD9E0EA; SILVD = 0x8B96A8;
PANEL = 0x111D40; PANX = 0x0A1430; SHA = 0x172752; SHB = 0x15234C; SHC = 0x192B57;
MOONC = 0xF1E7BE; MOONL = 0xFFF6D6; MOOND = 0xC9BE93; NIGHT = 0x0B1533;
KEYOFF = 0x1D2C5A; KEYHOV = 0x2B3F78;
DRC = 0x8FB8FF; FRC = 0xF0B8E0;                          // the drone / lead pairs' tags

// fonts, calibrated once per scale (the house way: a reference word fills the same width everywhere)
sc != ng_calsc ? (
  ng_calsc = sc;
  ng_f10 = ui_fitfont(10, 13.5 * sc);       // knob labels
  ng_f11 = ui_fitfont(11, 12.5 * sc);       // key captions
  ng_f12 = ui_fitfont(12, 14.5 * sc);       // section titles
  ng_f13 = ui_fitfont(13, 17 * sc);         // big captions
  ng_f16 = ui_fitfont(16, 12 * sc);         // values, small print
);
gfx_setfont(10, "Trebuchet MS", ng_f10, 'b'); gfx_setfont(11, "Trebuchet MS", ng_f11, 'b');
gfx_setfont(12, "Trebuchet MS", ng_f12, 'b'); gfx_setfont(13, "Trebuchet MS", ng_f13, 'b');
gfx_setfont(16, "Trebuchet MS", ng_f16, 'b');
gfx_setfont(14, "Georgia", 27 * sc, 'b');   // the card's name
gfx_setfont(15, "Georgia", 23 * sc, 'b');   // the numeral

// ---------- drawing helpers (GUI thread only; base coordinates) ----------
function ng_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function ng_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function ng_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function ng_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function ng_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function ng_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function ng_ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  x1 *= sc; y1 *= sc; x2 *= sc; y2 *= sc; w *= sc * 0.5;
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function ng_frame(x, y, w, h, t) ( ng_r(x, y, w, t); ng_r(x, y + h - t, w, t); ng_r(x, y, t, h); ng_r(x + w - t, y, t, h); );
// a section: a recessed tray, a silver title band ruled in ink
function ng_sect(x, y, w, h, shade, title) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  ui_col(SILV); ng_r(x, y, w, 20);
  ui_cola(0xFFFFFF, 0.3); ng_r(x, y, w, 1);
  ui_col(INK); ng_r(x, y + 20, w, 1.5);
  strlen(title) ? ( gfx_setfont(12); ui_col(INK); ng_t(x + 9, y + 2, title); );
);
function ng_sub(x, y, s) ( gfx_setfont(12); ui_col(INK); ng_t(x, y + 2, s); );
function ng_div(x, y, h) ( ui_col(INK); ng_r(x, y, 1.5, h); );

// ---------- a moon: a pale disc with a few seas; ph < 0 shades it into a crescent (0..1 how much) ----------
function ng_moon(cx, cy, r, ph, bg) (
  ui_cola(MOONL, 0.18); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1);
  ui_col(MOONC); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(MOOND);
  gfx_circle((cx - r * 0.3) * sc, (cy - r * 0.2) * sc, r * 0.22 * sc, 1, 1);
  gfx_circle((cx + r * 0.25) * sc, (cy + r * 0.3) * sc, r * 0.16 * sc, 1, 1);
  gfx_circle((cx + r * 0.32) * sc, (cy - r * 0.35) * sc, r * 0.1 * sc, 1, 1);
  ph > 0 ? ( ui_col(bg); gfx_circle((cx + r * (1.15 - ph * 0.7)) * sc, (cy - r * 0.12) * sc, r * 0.95 * sc, 1, 1); );
);

// ---------- the HOUSE WHITE CAP knob ----------
function ng_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function ng_lcap(cx, cy, r, n, col, trk) local(rr, a, a0, ca, sa, w, i) (
  rr = r + 5.5 * sc; w = 3 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(trk); ng_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
  n > 0.004 ? (
    ui_col(col); ng_arcw(cx, cy, rr, a0, a, w);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); gfx_circle(cx + ca * rr, cy + sa * rr, w * 0.5, 1, 1);
  );
  ui_cola(0x000000, 0.28); gfx_circle(cx + 1 * sc, cy + 2 * sc, r, 1, 1);
  ui_col(0x50565E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0xC9CED4); gfx_circle(cx, cy, r - 1.4 * sc, 1, 1);
  ui_col(0xE6E9EC); ng_arcw(cx, cy, r - 3 * sc, -0.66 * $pi, 0.06 * $pi, 1.4 * sc);
  ui_col(0x1A1E24); i = -1;
  ui_ssline(cx + ca * r * 0.3, cy + sa * r * 0.3, cx + ca * (r - 3 * sc), cy + sa * (r - 3 * sc), 2.4 * sc, 1);
);
// the value pill (shown only while the knob is touched)
function ng_pill(cx, y, s) local(tw, th) (
  gfx_setfont(16); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 3 * sc, 3 * sc);
  ui_col(MOONL); ui_rrect(cx * sc - tw * 0.5 - 5 * sc, y * sc + 1 * sc, tw + 10 * sc, th + 1 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 1.5 * sc; gfx_drawstr(s);
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps; fmt "" shows #ng_vs
function ng_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - ng_lt < 0.35 && ng_lid == idx) || (mouse_cap & 4) ? ( ng_set(idx, def); drag_id = -1; ng_lt = 0; ) : (
      drag_id = did; ng_ky = mouse_y; ng_lt = time_precise(); ng_lid = idx;
      ng_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    ng_kn = min(max(ng_kn + (ng_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); ng_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ ng_kn : lo + ng_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? ng_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    ng_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  ng_lcap(cx * sc, cy * sc, r * sc, min(max(n, 0), 1), ng_acc, ng_trk);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, (r - 1.5) * sc, 1, 1);
    strlen(fmt) ? sprintf(#ng_vv, fmt, v) : strcpy(#ng_vv, #ng_vs);
    ng_pill(cx, cy + r + 5, #ng_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(ng_lfont); ui_col(ng_ink); ng_tc(cx, cy + r + 13, label); );
  );
);
ng_acc = MOONC; ng_trk = 0x0A1532; ng_ink = LBL; ng_lfont = 10; ng_kfont = 11;

// ---------- keys that light up (lit = on); returns 1 when clicked ----------
function ng_key(x, y, w, h, on, s) local(hov, hit) (
  hov = ng_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(MOONL, 0.28); ng_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.3); ng_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); ng_rr(x, y, w, h, 3);
  ui_col(on ? MOONC : hov ? KEYHOV : KEYOFF); ng_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.45); ng_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.10); ng_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(ng_kfont); ui_col(on ? INK : LBL); ng_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function ng_keys(x, y, w, h, gap, idx, n, labels) local(i) (
  i = 0;
  loop(n, ng_key(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == i, pk_pitem(labels, i + 1, #ng_k)) ? ng_set(idx, i); i += 1; );
);
function ng_toggle(x, y, w, h, idx, s) ( ng_key(x, y, w, h, slider(idx) >= 0.5, s) ? ng_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// wave glyphs: 0 sine 1 triangle 2 saw 3 square / pulse 4 S&H 5 smooth random
function ng_glyph(cx, cy, t, col) local(i, x0, y0, x1, y1, hh) (
  ui_col(col); hh = 5;
  t == 0 ? ( i = 0; loop(16, x0 = cx - 8 + i; x1 = x0 + 1;
             ng_ln(x0, cy - sin(i / 16 * 2 * $pi) * hh, x1, cy - sin((i + 1) / 16 * 2 * $pi) * hh, 1.6); i += 1; ); ) :
  t == 1 ? ( ng_ln(cx - 8, cy, cx - 4, cy - hh, 1.6); ng_ln(cx - 4, cy - hh, cx + 4, cy + hh, 1.6); ng_ln(cx + 4, cy + hh, cx + 8, cy, 1.6); ) :
  t == 2 ? ( ng_ln(cx - 8, cy + hh, cx + 6, cy - hh, 1.6); ng_ln(cx + 6, cy - hh, cx + 6, cy + hh, 1.6); ) :
  t == 3 ? ( ng_ln(cx - 8, cy + hh, cx - 8, cy - hh, 1.6); ng_ln(cx - 8, cy - hh, cx, cy - hh, 1.6); ng_ln(cx, cy - hh, cx, cy + hh, 1.6);
             ng_ln(cx, cy + hh, cx + 8, cy + hh, 1.6); ) :
  t == 4 ? ( ng_ln(cx - 8, cy + 2, cx - 3, cy + 2, 1.6); ng_ln(cx - 3, cy + 2, cx - 3, cy - hh, 1.6); ng_ln(cx - 3, cy - hh, cx + 2, cy - hh, 1.6);
             ng_ln(cx + 2, cy - hh, cx + 2, cy + hh, 1.6); ng_ln(cx + 2, cy + hh, cx + 8, cy + hh, 1.6); ) :
  ( x0 = cx - 8; y0 = cy + 1; i = 0;
    loop(16, x1 = cx - 8 + i + 1; y1 = cy + (sin((i + 1) * 0.55) * 0.6 + sin((i + 1) * 0.23 + 1) * 0.5) * hh;
             ng_ln(x0, y0, x1, y1, 1.6); x0 = x1; y0 = y1; i += 1; ); );
);
// a key showing a wave glyph
function ng_gkey(x, y, w, h, on, t) local(hit) (
  hit = ng_key(x, y, w, h, on, "");
  ng_glyph(x + w * 0.5, y + h * 0.5, t, on ? INK : LBL);
  hit;
);
// a field that shows a setting (a drop-down arrow); returns 1 when clicked
function ng_field(x, y, w, h, s) local(hov, hit) (
  hov = ng_hov(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_col(INK); ng_rr(x, y, w, h, 3);
  ui_col(hov ? SILVH : SILV); ng_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(11); ui_col(INK); ng_tc(x + (w - 9) * 0.5, y + h * 0.5, s);
  gfx_triangle((x + w - 11) * sc, (y + h * 0.5 - 2) * sc, (x + w - 5) * sc, (y + h * 0.5 - 2) * sc, (x + w - 8) * sc, (y + h * 0.5 + 2.5) * sc);
  hit;
);
// a drop-down menu from a "|" list for a stepped slider
function ng_menu(x, y, idx, list, n) local(i, k) (
  strcpy(#ng_m, ""); i = 0; k = floor(slider(idx) + 0.5);
  loop(n, i == k ? strcat(#ng_m, "!"); strcat(#ng_m, pk_pitem(list, i + 1, #ng_k)); i < n - 1 ? strcat(#ng_m, "|"); i += 1; );
  gfx_x = x * sc; gfx_y = y * sc; i = gfx_showmenu(#ng_m); i > 0 ? ng_set(idx, i - 1);
);
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function ng_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#ng_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#ng_mls, ">"); strcat(#ng_mls, pk_pitem(list, i + 1, #ng_mi)); strcat(#ng_mls, " - ");
                      strcat(#ng_mls, pk_pitem(list, min(s0 + grp, n), #ng_mi)); strcat(#ng_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#ng_mls, "<");
    i == cur ? strcat(#ng_mls, "!");
    strcat(#ng_mls, pk_pitem(list, i + 1, #ng_mi));
    i < n - 1 ? strcat(#ng_mls, "|");
    i += 1; );
  #ng_mls;
);
// a value field (the house drop-down field): a click opens the list of every value (list: lo..hi, grp > 0 groups it
// in submenus of grp), the current one ticked; the wheel steps it
function ng_dfield(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = ng_hov(x, y, w, h);
  ng_field(x, y, w, h, s) ? (
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(ng_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? ng_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( ng_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
function ng_nname(n) local(o) (
  o = floor(n / 12) - 1;
  sprintf(#ng_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #ng_k), o);
  #ng_nn;
);

// ---------- one oscillator row: wave keys (2 x 2), TUNE, FINE, PW, CUTOFF, RESO ----------
function ng_orow(x, cy, num, b, cut, res, tag, linked) local(i, w) (
  gfx_setfont(13); ui_col(tag); ng_tc(x + 10, cy, num);
  w = floor(slider(b) + 0.5); i = 0;
  loop(4, ng_gkey(x + 20 + (i & 1) * 26, cy - 21 + (i >> 1) * 23, 24, 20, w == i, i) ? ng_set(b, i); i += 1; );
  ng_knob(x + 98, cy, 13, b + 1, -24, 24, 0, 0, "TUNE", "%+.0f st", 1);
  ng_knob(x + 143, cy, 13, b + 2, -50, 50, 0, 0, "FINE", "%+.1f ct", 0);
  ng_knob(x + 188, cy, 13, b + 3, 5, 95, 50, 0, "PW", "%.0f%%", 0);
  linked ? (
    // LINK: this filter follows the first one's (drawn as a dimmed pair of caps)
    ui_cola(LBL, 0.35); gfx_circle((x + 238) * sc, cy * sc, 13 * sc, 0, 1); gfx_circle((x + 298) * sc, cy * sc, 13 * sc, 0, 1);
    gfx_setfont(16); ui_cola(LBL, 0.7); ng_tc(x + 268, cy, "LINKED"); ui_cola(LBL, 1);
  ) : (
    ng_knob(x + 238, cy, 13, cut, 20, 20000, 1000, 1, "CUTOFF", "%.0f Hz", 0);
    ng_knob(x + 298, cy, 13, res, 0, 100, 20, 0, "RESO", "%.0f%%", 0);
  );
);

// ---------- the card ----------
ui_col(SILV); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); ng_rr(4, 4, 1092, 662, 9);
ui_col(SILV); ng_rr(6.5, 6.5, 1087, 657, 7);
ui_col(INK); ng_r(11, 11, 1078, 648);
ui_col(PANEL); ng_r(13, 13, 1074, 644);
// a few stars in the field
ui_cola(LBL, 0.22); ng_k_ = 0;
