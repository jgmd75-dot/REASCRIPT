desc:GFX Mistral [channel strip]
//author: JGWizrad / Garden FX (GFX)
//
// Mistral — modular broadcast channel strip in an oak cabinet.
// Inspired by 1970s German broadcast cassette modules (Sitral family:
// V276 preamp, W295b presence EQ, U273 compressor, U277 limiter).
// Model numbers / brand names live in these comments only — never on the panel.
//
// Signal: 4 reorderable modules (PRE / EQ / COMP / LIMIT) -> OUTPUT (supply module)
// Latency: 0 samples. All dynamics are feed-forward, no look-ahead.
// DRIFT = supply voltage wander + sag (PRE headroom, COMP threshold, rail droop).
// LIMIT is never drifted — its ceiling stays exact.
//
// STATUS: Stable v2.0 (from the Lab, Oct 2026). v0.3. Values marked TUNE are first guesses.
// TODO: house preset bar [PRESETS][◄][►][LCD], S/M/L keys.

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

// ---------- slot order (hidden; 0=PRE 1=EQ 2=COMP 3=LIMIT) ----------
// house output stage: CLIP always on (character unit)
import gfx-output.jsfx-inc
import gfx-glow.jsfx-inc

slider1:ord1=0<0,3,1>-Slot 1 Module
slider2:ord2=1<0,3,1>-Slot 2 Module
slider3:ord3=2<0,3,1>-Slot 3 Module
slider4:ord4=3<0,3,1>-Slot 4 Module

// ---------- PRE (amplifier) ----------
slider5:pre_on=1<0,1,1{Off,On}>-PRE In
slider6:pre_hpf=0<0,3,1{Off,40 Hz,80 Hz,120 Hz}>-PRE HPF
slider7:pre_gain=0<-12,15,3>-PRE Gain (dB)
slider8:pre_dv=0<0,10,2>-PRE Output dV (dB)

// ---------- EQ (presence equaliser) ----------
slider9:eq_on=1<0,1,1{Off,On}>-EQ In
slider10:eq_hf=0<-15,15,3>-EQ High Shelf (dB)
slider11:eq_lf=0<-15,15,3>-EQ Low Shelf (dB)
slider12:eq_pf=1<0,5,1{0.7 kHz,1.0 kHz,1.5 kHz,2.3 kHz,3.5 kHz,5.6 kHz}>-EQ Presence Freq
slider13:eq_pg=0<-8,8,2>-EQ Presence Gain (dB)

// ---------- COMP ----------
slider14:comp_on=0<0,1,1{Off,On}>-COMP In
slider15:comp_thr=-10<-30,0,2.5>-COMP Threshold (dB)
slider16:comp_deg=3<0,9,1{Limit 3,Limit 2,Limit 1,Off,1.5:1,2:1,3:1,4:1,6:1,10:1}>-COMP Limit / Compress
slider17:comp_rec=1<0,4,1{0.3 s,0.8 s,2 s,5 s,Prog}>-COMP Recovery
slider18:comp_sc=1<0,3,1{Off,60 Hz,120 Hz,200 Hz}>-COMP SC HPF
slider19:comp_mk=0<0,20,0.5>-COMP Makeup (dB)

// ---------- LIMIT ----------
slider20:lim_on=0<0,1,1{Off,On}>-LIMIT In
slider21:lim_ceil=-0.3<-12,0,0.1>-LIMIT Ceiling (dB)
slider22:lim_rel=2<0,5,1{10 ms,25 ms,50 ms,100 ms,200 ms,500 ms}>-LIMIT Release

// ---------- OUTPUT ----------
slider23:out_trim=0<-12,12,0.5>-Output (dB)
slider24:drift=0<0,100,1>-Drift (%)
slider25:prs_sel=0<0,12,1{No preset,Init,Vocal: Presence,Vocal: Radio Voice,Vocal: Announcer,Drums: Bus Glue,Drums: Snare Crack,Bass: Weight,Guitar: Acoustic,Keys: Piano Sheen,Colour: Hot Line,Bus: Broadcast Wall,Bus: Gentle Master}>-Preset

@init
ext_noinit = 1;          // don't re-run @init on transport start (no state clicks)
pr_cur = 1;              // preset shown on the LCD (saved with the project)
gfx_ext_retina = 1;      // hi-dpi aware; @gfx scales to fit anyway

// ---------- memory map ----------
ord_act  = 0;   // [4] order currently running in @sample
ord_new  = 4;   // [4] order requested by sliders / GUI
mod_on   = 8;   // [4] smoothed in/out amount per module (0..1)
mod_tgt  = 12;  // [4] in/out target per module
used_tab = 16;  // [4] scratch for order validation
pf_tab   = 20;  // [6] presence frequencies
rt_tab   = 26;  // [7] compress ratios (index 1..6)
rel_tab  = 34;  // [6] limiter release (ms)
rec_tab  = 40;  // [4] comp recovery (ms)

pf_tab[0] = 700;  pf_tab[1] = 1000; pf_tab[2] = 1500;
pf_tab[3] = 2300; pf_tab[4] = 3500; pf_tab[5] = 5600;
rt_tab[1] = 1.5; rt_tab[2] = 2; rt_tab[3] = 3; rt_tab[4] = 4; rt_tab[5] = 6; rt_tab[6] = 10;
rel_tab[0] = 10; rel_tab[1] = 25; rel_tab[2] = 50; rel_tab[3] = 100; rel_tab[4] = 200; rel_tab[5] = 500;
rec_tab[0] = 300; rec_tab[1] = 800; rec_tab[2] = 2000; rec_tab[3] = 5000;

// ---------- tuning constants (TUNE) ----------
LS_FC    = 120;    // low shelf RC corner
HS_FC    = 9000;   // high shelf RC corner
PRES_Q   = 0.9;    // presence (inductor) bell Q
IRON_FC  = 90;     // band where transformer core flux saturates first
PRE_K    = 0.2;    // stage headroom: smaller = cleaner at 0 dB gain
PRE_BIAS = 0.12;   // stage asymmetry -> 2nd-harmonic bite when driven

// ---------- printed scales (string slots) ----------
strcpy(200,"OFF"); strcpy(201,"40"); strcpy(202,"80"); strcpy(203,"120");
strcpy(210,"-12"); strcpy(211,"-9"); strcpy(212,"-6"); strcpy(213,"-3"); strcpy(214,"0");
strcpy(215,"3");   strcpy(216,"6");  strcpy(217,"9");  strcpy(218,"12"); strcpy(219,"15");
strcpy(220,"0"); strcpy(221,"2"); strcpy(222,"4"); strcpy(223,"6"); strcpy(224,"8"); strcpy(225,"10");
strcpy(230,"15"); strcpy(231,"12"); strcpy(232,"9"); strcpy(233,"6"); strcpy(234,"3"); strcpy(235,"0");
strcpy(236,"3");  strcpy(237,"6");  strcpy(238,"9"); strcpy(239,"12"); strcpy(240,"15");
strcpy(250,"0.7"); strcpy(251,"1.0"); strcpy(252,"1.5"); strcpy(253,"2.3"); strcpy(254,"3.5"); strcpy(255,"5.6");
strcpy(260,"8"); strcpy(261,"6"); strcpy(262,"4"); strcpy(263,"2"); strcpy(264,"0");
strcpy(265,"2"); strcpy(266,"4"); strcpy(267,"6"); strcpy(268,"8");
strcpy(270,"30"); strcpy(271,"25"); strcpy(272,"20"); strcpy(273,"15"); strcpy(274,"10"); strcpy(275,"5"); strcpy(276,"0");
strcpy(280,"L3"); strcpy(281,"L2"); strcpy(282,"L1"); strcpy(283,"OFF"); strcpy(284,"1.5");
strcpy(285,"2");  strcpy(286,"3");  strcpy(287,"4");  strcpy(288,"6");   strcpy(289,"10");
strcpy(290,"0.3"); strcpy(291,"0.8"); strcpy(292,"2"); strcpy(293,"5"); strcpy(294,"P");
strcpy(300,"OFF"); strcpy(301,"60"); strcpy(302,"120"); strcpy(303,"200");
strcpy(310,"0"); strcpy(311,"5"); strcpy(312,"10"); strcpy(313,"15"); strcpy(314,"20");
strcpy(320,"12"); strcpy(321,"9"); strcpy(322,"6"); strcpy(323,"3"); strcpy(324,"0");
strcpy(330,"10"); strcpy(331,"25"); strcpy(332,"50"); strcpy(333,"100"); strcpy(334,"200"); strcpy(335,"500");
strcpy(340,"-12"); strcpy(341,"-6"); strcpy(342,"0"); strcpy(343,"6"); strcpy(344,"12");
strcpy(350,"0"); strcpy(351,"25"); strcpy(352,"50"); strcpy(353,"75"); strcpy(354,"100");
strcpy(360,"0"); strcpy(361,"5"); strcpy(362,"10"); strcpy(363,"15"); strcpy(364,"20");

// ---------- hover-tag text for stepped selectors ----------
strcpy(140,"OFF"); strcpy(141,"40 Hz"); strcpy(142,"80 Hz"); strcpy(143,"120 Hz");
strcpy(150,"0.7 kHz"); strcpy(151,"1.0 kHz"); strcpy(152,"1.5 kHz");
strcpy(153,"2.3 kHz"); strcpy(154,"3.5 kHz"); strcpy(155,"5.6 kHz");
strcpy(160,"LIMIT 3"); strcpy(161,"LIMIT 2"); strcpy(162,"LIMIT 1"); strcpy(163,"OFF"); strcpy(164,"1.5:1");
strcpy(165,"2:1"); strcpy(166,"3:1"); strcpy(167,"4:1"); strcpy(168,"6:1"); strcpy(169,"10:1");
strcpy(170,"0.3 s"); strcpy(171,"0.8 s"); strcpy(172,"2 s"); strcpy(173,"5 s"); strcpy(174,"PROGRAM");
strcpy(180,"OFF"); strcpy(181,"60 Hz"); strcpy(182,"120 Hz"); strcpy(183,"200 Hz");
strcpy(190,"10 ms"); strcpy(191,"25 ms"); strcpy(192,"50 ms"); strcpy(193,"100 ms"); strcpy(194,"200 ms"); strcpy(195,"500 ms");

first_run = 1;
fade_g = 1;
lim_g = 1; lim_g_min = 1;
comp_gr = 0;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();

// =====================================================================
// DSP building blocks
// =====================================================================
function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );

// One-pole TPT low-pass (RC network). High-pass = x - lp.
function op_set(fc) instance(G) local(w) (
  w = tan($pi * min(fc, srate * 0.45) / srate);
  G = w / (1 + w);
);
function op_lp(x) instance(G, s) local(v, y) (
  v = (x - s) * G;  y = v + s;  s = y + v;  y;
);

// Simper/Cytomic TPT state-variable filter: lp / bp / hp outputs.
// Prewarped and modulation-safe; bp peak = Q, so k*bp is unity-peak.
function svf_set(fc, q) instance(g, k, a1, a2, a3) (
  g  = tan($pi * min(fc, srate * 0.45) / srate);
  k  = 1 / q;
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf_tick(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3  = x - ic2;
  v1  = a1 * ic1 + a2 * v3;
  v2  = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;
  ic2 = 2 * v2 - ic2;
  lp = v2;  bp = v1;  hp = x - k * v1 - v2;
);

// House clipper: first-order ADAA soft saturator, f(x) = x / (1 + |x|).
// F(x) = |x| - ln(1 + |x|) is its antiderivative. Unity small-signal gain.
function sat_f(x) ( x / (1 + abs(x)); );
function sat_ad(x) ( abs(x) - log(1 + abs(x)); );
// The ADAA reading sits half a sample late (a top-end roll-off: -5 dB at 15 kHz per
// stage); half the plain curve's step is added back, as in the house output stage.
// (yc / yp, not f / fp: JSFX names ignore case, so fp would be Fp.)
function adaa(x) instance(xp, Fp, yp) local(F, yc, d, y) (
  F = sat_ad(x);  yc = sat_f(x);
  d = x - xp;
  abs(d) < 0.00001 ? ( y = sat_f(0.5 * (x + xp)); ) : ( y = (F - Fp) / d; );
  y += 0.5 * (yc - yp);
  xp = x;  Fp = F;  yp = yc;
  y;
);

// =====================================================================
// MODULE 0 — PRE (V276-style amplifier + input iron)
// =====================================================================
// GAIN below 0 dB is a clean trim, 0 is neutral, up to +15 adds colour
// (gain above 0 is compensated, so GAIN changes tone, not level).
// dV is the clean output make-up (0..+10 dB), as on the hardware.
function pre_tick(x) instance(lc, ironlp, ironsat, stage, dc) local(y, lf) (
  y = x * pre_g;
  pre_hpf > 0 ? ( lc.svf_tick(y); y = lc.hp; );
  // Iron: core flux rises as frequency falls, so LF content saturates first.
  lf = ironlp.op_lp(y);
  y  = (y - lf) + ironsat.adaa(lf * pre_ik) / pre_ik;
  // Discrete stage: biased soft clip -> 2nd-harmonic bite as gain rises.
  // pre_kd / pre_nd follow DRIFT (supply wander + sag shrink the headroom).
  y = (stage.adaa(y * pre_kd + PRE_BIAS) - pre_bias_f) * pre_nd;
  y = y - dc.op_lp(y);           // DC blocker for the asymmetric stage
  y * pre_post;
);

// =====================================================================
// MODULE 1 — EQ (W295b-style presence EQ, parallel structure)
// =====================================================================
//   y = x + (Gl-1)*LP1(x) + (Gh-1)*HP1(x) + (Gp-1)*k*BP(x)
// First-order RC shelves give the very gentle slopes; the parallel sum
// lets bands interact like the passive original.
// NOTE: cuts are not mirror images of boosts (as on the hardware) — check by ear.
function eq_tick(x) instance(lo, hi, mid) local(l, h) (
  l = lo.op_lp(x);
  h = x - hi.op_lp(x);
  mid.svf_tick(x);
  x + eq_lg1 * l + eq_hg1 * h + eq_pg1 * mid.k * mid.bp;
);

// =====================================================================
// MODULE 2 — COMP (U273-style feed-forward, stereo-linked)
// =====================================================================
// One dial runs LIMIT 3..1 <- OFF -> compress 1.5:1..10:1, as on the original.
function comp_tick() local(sl, sr, lvl, ldb, over, hk, gt, c, gg) (
  comp_sc_on ? (
    scL.svf_tick(aL); scR.svf_tick(aR);
    sl = scL.hp; sr = scR.hp;
  ) : ( sl = aL; sr = aR; );
  lvl = max(abs(sl), abs(sr));
  ldb = lvl > 0.000001 ? 8.685889638065035 * log(lvl) : -120;
  over = ldb - comp_thr_d;       // threshold wanders with the supply (DRIFT)
  hk = comp_knee * 0.5;
  over <= -hk ? ( gt = 0; ) :
  over >=  hk ? ( gt = over * comp_slope; ) :
                ( gt = comp_slope * sqr(over + hk) / (2 * comp_knee); );
  gt > comp_gr ? ( c = comp_ac; ) : (
    // PROG: transients (far above target) recover fast, sustained GR slowly
    comp_rec == 4 ? ( c = (comp_gr - gt) > 3 ? comp_rc_fast : comp_rc_slow; )
                  : ( c = comp_rc; );
  );
  comp_gr += (gt - comp_gr) * c;
  gg = db2g(comp_mk - comp_gr);
  aL *= gg;  aR *= gg;
  comp_gr > comp_gr_pk ? ( comp_gr_pk = comp_gr; );
);

// =====================================================================
// MODULE 3 — LIMIT (U277-style, zero latency)
// =====================================================================
// Instant-attack gain computer: |out| can never exceed the ceiling
// (sample-peak brickwall). No look-ahead — the price of 0 latency.
function lim_tick() local(pk, tg) (
  pk = max(abs(aL), abs(aR));
  tg = pk > lim_cg ? lim_cg / pk : 1;
  tg < lim_g ? ( lim_g = tg; ) : ( lim_g += (tg - lim_g) * lim_rc; );
  aL *= lim_g;  aR *= lim_g;
  lim_g < lim_g_min ? ( lim_g_min = lim_g; );
);

// =====================================================================
// Pipeline: run one module on (aL, aR) with click-free in/out crossfade
// =====================================================================
function run_module(m) local(w, dl, dr) (
  w = mod_on[m];
  w > 0 ? (                      // fully out = skipped entirely (saves CPU)
    dl = aL;  dr = aR;
    m == 0 ? ( aL = preL.pre_tick(aL); aR = preR.pre_tick(aR); ) :
    m == 1 ? ( aL = eqL.eq_tick(aL);   aR = eqR.eq_tick(aR);   ) :
    m == 2 ? ( comp_tick(); ) :
             ( lim_tick(); );
    w < 1 ? ( aL = dl + (aL - dl) * w;  aR = dr + (aR - dr) * w; );
  );
);

// =====================================================================
// Parameter update (called from @slider and after GUI edits)
// =====================================================================
function update_params() local(i, v, f) (
  // --- slot order: always rebuild a valid permutation of 0..3 ---
  ord_new[0] = ord1; ord_new[1] = ord2; ord_new[2] = ord3; ord_new[3] = ord4;
  memset(used_tab, 0, 4);
  i = 0;
  loop(4,
    v = max(0, min(3, floor(ord_new[i] + 0.5)));
    used_tab[v] ? ( ord_new[i] = -1; ) : ( used_tab[v] = 1; ord_new[i] = v; );
    i += 1;
  );
  i = 0;
  loop(4,
    ord_new[i] < 0 ? (
      v = 0;
      while (used_tab[v]) ( v += 1; );
      used_tab[v] = 1;  ord_new[i] = v;
    );
    i += 1;
  );
  // PRE is always first and LIMIT always last; only EQ and COMP swap.
  i = 0;  f = 0;  v = 0;
  loop(4, ord_new[i] == 1 ? (f = i); ord_new[i] == 2 ? (v = i); i += 1; );
  ord_new[0] = 0;  ord_new[3] = 3;
  ord_new[1] = v < f ? 2 : 1;  ord_new[2] = v < f ? 1 : 2;
  ord1 = ord_new[0]; ord2 = ord_new[1]; ord3 = ord_new[2]; ord4 = ord_new[3];

  mod_tgt[0] = pre_on; mod_tgt[1] = eq_on; mod_tgt[2] = comp_on; mod_tgt[3] = lim_on;

  // --- PRE ---
  pre_g      = db2g(pre_gain);
  pre_post   = db2g(pre_dv) / max(pre_g, 1);
  pre_ik     = 0.15 + 0.05 * max(pre_gain, 0);      // TUNE iron depth vs gain
  pre_bias_f = sat_f(PRE_BIAS);
  f = pre_hpf == 1 ? 40 : pre_hpf == 2 ? 80 : 120;
  preL.lc.svf_set(f, 0.707);      preR.lc.svf_set(f, 0.707);
  preL.ironlp.op_set(IRON_FC);    preR.ironlp.op_set(IRON_FC);
  preL.dc.op_set(8);              preR.dc.op_set(8);

  // --- EQ ---
  eq_lg1 = db2g(eq_lf) - 1;
  eq_hg1 = db2g(eq_hf) - 1;
  eq_pg1 = db2g(eq_pg) - 1;
  eqL.lo.op_set(LS_FC);  eqR.lo.op_set(LS_FC);
  eqL.hi.op_set(HS_FC);  eqR.hi.op_set(HS_FC);
  f = pf_tab[max(0, min(5, floor(eq_pf + 0.5)))];
  eqL.mid.svf_set(f, PRES_Q);  eqR.mid.svf_set(f, PRES_Q);

  // --- COMP ---  (TUNE knees, attacks, recovery)
  i = floor(comp_deg + 0.5) - 3;                           // -3..-1 limit, 0 off, 1..6 compress
  i < 0 ? (
    comp_slope = 0.95;                                       // limiting
    comp_knee  = i == -1 ? 9 : i == -2 ? 6 : 3;
    f = 1;                                                   // attack ms
  ) : i > 0 ? (
    comp_slope = 1 - 1 / rt_tab[min(6, i)];
    comp_knee  = 6;
    f = 8;
  ) : (
    comp_slope = 0;  comp_knee = 6;  f = 8;                  // OFF
  );
  comp_ac      = 1 - exp(-1000 / (f * srate));
  comp_rc      = 1 - exp(-1000 / (rec_tab[min(3, comp_rec)] * srate));
  comp_rc_fast = 1 - exp(-1000 / (250 * srate));
  comp_rc_slow = 1 - exp(-1000 / (2500 * srate));
  comp_sc_on   = comp_sc > 0;
  f = comp_sc == 1 ? 60 : comp_sc == 2 ? 120 : 200;
  scL.svf_set(f, 0.707);  scR.svf_set(f, 0.707);

  // --- LIMIT / OUTPUT ---
  lim_cg = db2g(lim_ceil);
  lim_rc = 1 - exp(-1000 / (rel_tab[max(0, min(5, lim_rel))] * srate));
  out_g  = db2g(out_trim);

  // DRIFT = supply voltage wander + sag (see @block / @sample)
  drift_amt = drift / 100;
  sag_a = 1 - exp(-1000 / (30 * srate));    // sag sets in over ~30 ms   (TUNE)
  sag_r = 1 - exp(-1000 / (400 * srate));   // supply recovers over ~400 ms

  ramp_step = 1 / (0.010 * srate);   // 10 ms module in/out
  fade_step = 1 / (0.004 * srate);   // 4 ms dip when the order changes

  first_run ? (
    i = 0; loop(4, mod_on[i] = mod_tgt[i]; ord_act[i] = ord_new[i]; i += 1; );
    first_run = 0;
  );
);

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function mp_a(od, pon, hpf, g, dv, eon, hf, lf, pf, pg) (
  ord1 = 0;  ord2 = od ? 2 : 1;  ord3 = od ? 1 : 2;  ord4 = 3;
  pre_on = pon;  pre_hpf = hpf;  pre_gain = g;  pre_dv = dv;
  eq_on = eon;  eq_hf = hf;  eq_lf = lf;  eq_pf = pf;  eq_pg = pg;
);
function mp_b(con, thr, deg, rec, sc, mk, lon, ceil, lrel, ot) (
  comp_on = con;  comp_thr = thr;  comp_deg = deg;  comp_rec = rec;  comp_sc = sc;  comp_mk = mk;
  lim_on = lon;  lim_ceil = ceil;  lim_rel = lrel;  out_trim = ot;
  slider_automate(8388607);                    // sliders 1-23
  gui_dirty = 1;
);
function load_preset(p) (
  p == 1  ? ( mp_a(0, 1, 0, 0, 0, 1, 0, 0, 1, 0);  mp_b(0, -10, 3, 1, 1, 0, 0, -0.3, 2, 0); ) :   // Init
  p == 2  ? ( mp_a(0, 1, 2, 3, 2, 1, 3, -3, 4, 4);  mp_b(1, -15, 6, 1, 2, 3, 1, -1, 3, -5); ) :   // Vocal: Presence
  p == 3  ? ( mp_a(0, 1, 3, 6, 4, 1, 3, -3, 3, 4);  mp_b(1, -20, 7, 0, 2, 6, 1, -1, 2, -6); ) :   // Vocal: Radio Voice
  p == 4  ? ( mp_a(1, 1, 3, 9, 6, 1, -15, -15, 2, 8);  mp_b(1, -20, 2, 0, 3, 8, 1, -3, 2, -10.5); ) :   // Vocal: Announcer
  p == 5  ? ( mp_a(0, 1, 0, 3, 4, 1, 3, 3, 5, 2);  mp_b(1, -12.5, 5, 4, 1, 2, 0, -0.3, 2, -7); ) :   // Drums: Bus Glue
  p == 6  ? ( mp_a(1, 1, 1, 3, 4, 1, 3, 3, 3, 4);  mp_b(1, -15, 8, 0, 2, 4, 0, -0.3, 2, -9); ) :   // Drums: Snare Crack
  p == 7  ? ( mp_a(0, 1, 1, 6, 6, 1, 0, 6, 0, 2);  mp_b(1, -15, 7, 1, 0, 4, 0, -0.3, 2, -8.5); ) :   // Bass: Weight
  p == 8  ? ( mp_a(0, 1, 2, 3, 2, 1, 3, -3, 5, 2);  mp_b(1, -12.5, 5, 0, 2, 2, 0, -0.3, 2, -4); ) :   // Guitar: Acoustic
  p == 9  ? ( mp_a(0, 1, 1, 0, 2, 1, 6, 0, 1, -2);  mp_b(1, -10, 4, 2, 1, 1, 0, -0.3, 2, -3); ) :   // Keys: Piano Sheen
  p == 10 ? ( mp_a(0, 1, 0, 12, 8, 1, -3, 0, 1, 0);  mp_b(0, -10, 3, 1, 1, 0, 1, -0.3, 2, -8); ) :   // Colour: Hot Line
  p == 11 ? ( mp_a(0, 1, 1, 0, 2, 1, 3, 3, 4, 2);  mp_b(1, -17.5, 1, 4, 2, 6, 1, -1, 1, -7.5); ) :   // Bus: Broadcast Wall
  p == 12 ? ( mp_a(0, 1, 0, 0, 0, 1, 3, 0, 5, 0);  mp_b(1, -7.5, 4, 4, 2, 1, 1, -0.3, 4, -1); ) :   // Bus: Gentle Master
  p == 13  ? ( mp_a(0, 1, 0, 0, 0, 1, 0, 0, 1, 0);  mp_b(0, -10, 3, 1, 1, 0, 0, -0.3, 2, 0);   // Reset all to defaults
              drift = 0;  slider_automate(16777215); );
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);   // output stage: CLIP, always on

@block
prs_chk();
// GUI edits arrive as a flag; parameters are only ever rebuilt on the audio thread
prm_dirty ? ( prm_dirty = 0;  update_params(); );
// A new order is applied at the bottom of a short fade (see @sample),
// so reordering live never clicks.
ord_dirty = ord_new[0] != ord_act[0] || ord_new[1] != ord_act[1] ||
            ord_new[2] != ord_act[2] || ord_new[3] != ord_act[3];

// DRIFT, part 1 — supply voltage wander: a slow smoothed random walk (-1..1)
dw_t += samplesblock / srate;
dw_t > 0.7 ? ( dw_t = 0;  dw_target = rand(2) - 1; );
dw += (dw_target - dw) * (1 - exp(-samplesblock / (srate * 1.5)));
comp_thr_d = comp_thr + drift_amt * 0.6 * dw;      // ±0.6 dB at 100 %  (TUNE)
volt_g     = 1 + drift_amt * 0.012 * dw;           // ±0.1 dB rail wander

// meter hand-off: hold the max until @gfx collects it
comp_gr_disp = max(comp_gr_disp, comp_gr_pk);  comp_gr_pk = 0;
lim_gr_disp  = max(lim_gr_disp, -g2db(lim_g_min)); lim_g_min = 1;
out_pk_disp  = max(out_pk_disp, out_pk);       out_pk = 0;

@sample
aL = spl0;  aR = spl1;

// DRIFT, part 2 — sag: loud programme pulls the rails down, so the PRE
// stage loses headroom (more colour) and the whole strip droops slightly.
lvl = max(abs(aL), abs(aR));
sag_env += (lvl - sag_env) * (lvl > sag_env ? sag_a : sag_r);
sg = min(sag_env, 1);
pre_kd = PRE_K * (1 + drift_amt * (0.12 * dw + 0.6 * sg));
pre_nd = sqr(1 + PRE_BIAS) / pre_kd;               // keeps small-signal gain at unity
sup_g  = volt_g * (1 - drift_amt * 0.04 * sg);     // up to ~-0.35 dB droop

// module in/out ramps
i = 0;
loop(4,
  t = mod_tgt[i];  v = mod_on[i];
  v != t ? ( mod_on[i] = t > v ? min(t, v + ramp_step) : max(t, v - ramp_step); );
  i += 1;
);

// order change: fade out, swap at silence, fade back in
ord_dirty ? (
  fade_g = max(0, fade_g - fade_step);
  fade_g == 0 ? (
    ord_act[0] = ord_new[0]; ord_act[1] = ord_new[1];
    ord_act[2] = ord_new[2]; ord_act[3] = ord_new[3];
    ord_dirty = 0;
  );
) : fade_g < 1 ? ( fade_g = min(1, fade_g + fade_step); );

// the dynamic pipeline
run_module(ord_act[0]);
run_module(ord_act[1]);
run_module(ord_act[2]);
run_module(ord_act[3]);

aL = ostL.ost_band(aL) * out_g * fade_g * sup_g;
aR = ostR.ost_band(aR) * out_g * fade_g * sup_g;
ost_out(aL, aR);  aL = ost_l;  aR = ost_r;           // house clipper, -0.3 dBFS ceiling
out_pk = max(out_pk, max(abs(aL), abs(aR)));
spl0 = aL;  spl1 = aR;

@serialize
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@gfx 1000 724
function gdb(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );   // GUI copy of g2db (audio and GUI threads must not share functions)
// =====================================================================
// GUI — oak cabinet, black backplane, pale grey-beige module plates,
// black fluted pointer knobs with printed scales. Blue is used only for
// status LEDs, label tags, hover tags and highlights. Base 1000 x 680.
// =====================================================================
// ---------- fonts: Bahnschrift (DIN 1451) display + condensed labels, with fallbacks ----------
// A font that isn't installed silently becomes the system default, so each candidate is measured against
// a name that can't exist: if the widths match, it isn't installed and the next one is tried.
function font_ok(name, flags) local(w0, h0, w1, h1) (
  gfx_setfont(9, "GFX-no-such-font", 20, flags);  gfx_measurestr("MISTRAL kHz 0123", w0, h0);
  gfx_setfont(9, name, 20, flags);                gfx_measurestr("MISTRAL kHz 0123", w1, h1);
  abs(w1 - w0) > 0.5;
);
function pick_fonts() (
  font_ok("Bahnschrift", 'b')    ? ( strcpy(#fd, "Bahnschrift");    fd_fl = 'b'; ) :
  font_ok("Futura", 'b')         ? ( strcpy(#fd, "Futura");         fd_fl = 'b'; ) :
  font_ok("Century Gothic", 'b') ? ( strcpy(#fd, "Century Gothic"); fd_fl = 'b'; ) :
                                   ( strcpy(#fd, "Verdana");        fd_fl = 'b'; );
  font_ok("Bahnschrift SemiBold SemiConden", 0) ? ( strcpy(#fl, "Bahnschrift SemiBold SemiConden"); fl_fl = 0; ) :
  font_ok("Bahnschrift SemiCondensed", 'b')     ? ( strcpy(#fl, "Bahnschrift SemiCondensed");       fl_fl = 'b'; ) :
  font_ok("Bahnschrift", 'b')                   ? ( strcpy(#fl, "Bahnschrift");                     fl_fl = 'b'; ) :
  font_ok("Futura", 'b')                        ? ( strcpy(#fl, "Futura");                          fl_fl = 'b'; ) :
                                                  ( strcpy(#fl, "Verdana");                         fl_fl = 'b'; );
  fonts_picked = 1;
);
// Letter-spaced text (Bauhaus-style tracking for the titles), centred on cx, cy
function text_spaced(cx, cy, str, tr) local(n, i, c, w, h, tot, x) (
  n = strlen(str);  tot = 0;  i = 0;
  loop(n, c = str_getchar(str, i); gfx_measurechar(c, w, h); tot += w; i += 1; );
  tot += tr * (n - 1);
  x = cx - tot * 0.5;  i = 0;
  loop(n,
    c = str_getchar(str, i);  gfx_measurechar(c, w, h);
    gfx_x = x;  gfx_y = cy - h * 0.5;  gfx_drawchar(c);
    x += w + tr;  i += 1;
  );
);

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;
  gfx_g = (floor(h / 256) % 256) / 255;
  gfx_b = (h % 256) / 255;
  gfx_a = a;
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );

function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);
  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;
  gfx_drawstr(str);
);

function param_touched(idx) ( slider_automate(2 ^ (idx - 1)); gui_dirty = 1; );

// Knurled thumbscrew (replaces corner rivets, as on the modules)
function thumbscrew(x, y) local(X, Y, R, j, b) (
  X = px(x);  Y = py(y);  R = ps(8);
  col(0x000000, 0.3);  gfx_circle(X + ps(1), Y + ps(1.5), R, 1, 1);
  col(0xA89C80, 1);    gfx_circle(X, Y, R, 1, 1);
  col(0x6E6450, 1);    j = 0;
  loop(16, b = j * $pi / 8;
    gfx_line(X + sin(b) * R * 0.75, Y - cos(b) * R * 0.75, X + sin(b) * R, Y - cos(b) * R, 1); j += 1; );
  col(0xC9BFA6, 1);    gfx_circle(X, Y, R * 0.55, 1, 1);
  col(0x4A4234, 1);    gfx_line(X - R * 0.45, Y, X + R * 0.45, Y, 1);
);

// Status lamp in a chrome bezel: light blue when lit
function status_led(x, y, on) local(X, Y) (
  X = px(x);  Y = py(y);
  col(0x8C8C86, 1);  gfx_circle(X, Y, ps(7), 1, 1);
  col(0xD8D8D2, 1);  gfx_circle(X, Y, ps(7), 0, 1);
  on ? (
    col(0x8FB8DE, 0.35); gfx_circle(X, Y, ps(11), 1, 1);
    col(0x8FB8DE, 1);    gfx_circle(X, Y, ps(4.5), 1, 1);
    col(0xFFFFFF, 0.6);  gfx_circle(X - ps(1.2), Y - ps(1.2), ps(1.5), 1, 1);
  ) : (
    col(0x2C4466, 1);    gfx_circle(X, Y, ps(4.5), 1, 1);
  );
);

// Knob pointer as one filled bar (constant width at any angle), with
// anti-aliased long edges. Replaces stacked offset lines, which stair-step
// and change thickness on diagonals.
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;
  bx = x + sa * r1;  by = y - ca * r1;
  dx = ca * hw;      dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);
  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);

// Black fluted pointer knob with a printed scale.
// Drag up/down, Ctrl-click or double-click = default, value tag on hover only.
// ins = coloured centre insert (house colour code) or -1.
// fmt: 0 dB, 1 %, >=1000 enum (hover-tag string slot base = fmt-1000)
// sb / nl = printed scale: first string slot and number of labels (spread evenly)
function knob(cx, cy, r, idx, vmin, vmax, step, def, ins, lbl, fmt, sb, nl)
  local(x, y, rr, v, t, hov, dx, dy, now, a0, a1, tv, b, j, n, w, h, ty, lr, ca, sa)
(
  x = px(cx);  y = py(cy);  rr = ps(r);
  dx = mouse_x - x;  dy = mouse_y - y;
  hov = dx * dx + dy * dy <= sqr(rr * 1.2);

  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : (
      drag_idx = idx;  drag_y = mouse_y;  drag_v = slider(idx);
    );
    last_click_idx = idx;  last_click_t = now;
  );
  drag_idx == idx ? (
    v = drag_v + (drag_y - mouse_y) * (vmax - vmin) / ps(220);
    step > 0 ? ( v = vmin + floor((v - vmin) / step + 0.5) * step; );
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );

  v = slider(idx);
  t = (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;
  tv = a0 + t * (a1 - a0);

  // printed scale: short ticks at every step, long ticks + numbers at labels
  col(0x2B2B2B, 1);
  n = step > 0 ? floor((vmax - vmin) / step + 0.5) : 0;
  n > 0 && n <= 24 ? (
    j = 0;
    loop(n + 1,
      b = a0 + (j / n) * (a1 - a0);
      gfx_line(x + sin(b) * (rr + ps(4)), y - cos(b) * (rr + ps(4)),
               x + sin(b) * (rr + ps(7)), y - cos(b) * (rr + ps(7)), 1);
      j += 1;
    );
  );
  gfx_setfont(5);
  lr = rr + ps(19);
  j = 0;
  loop(nl,
    b = a0 + (nl > 1 ? j / (nl - 1) : 0.5) * (a1 - a0);
    gfx_line(x + sin(b) * (rr + ps(4)), y - cos(b) * (rr + ps(4)),
             x + sin(b) * (rr + ps(10)), y - cos(b) * (rr + ps(10)), 1);
    text_c(x + sin(b) * lr, y - cos(b) * lr, sb + j);
    j += 1;
  );

  // knob: shadow, skirt, fluted cap, soft edge highlight
  col(0x000000, 0.28);  gfx_circle(x + ps(2), y + ps(3), rr, 1, 1);
  col(0x262626, 1);     gfx_circle(x, y, rr, 1, 1);
  col(0x121212, 1);     gfx_circle(x, y, rr * 0.8, 1, 1);
  col(0x3E3E3E, 1);     j = 0;
  loop(12,
    b = tv + j * $pi / 6;
    gfx_line(x + sin(b) * rr * 0.82, y - cos(b) * rr * 0.82,
             x + sin(b) * rr * 0.97, y - cos(b) * rr * 0.97, 1);
    j += 1;
  );
  col(0xFFFFFF, 0.14);  gfx_arc(x, y, rr * 0.77, -1.9, -0.3, 1);

  // cream pointer bar
  sa = sin(tv);  ca = cos(tv);
  col(0xEDE6D3, 1);
  pointer(x, y, sa, ca, rr * 0.25, rr * 1.02, ps(1.6));
  ins >= 0 ? ( col(ins, 1); gfx_circle(x, y, rr * 0.2, 1, 1); );

  // label
  gfx_setfont(6);  col(0x2B2B2B, 1);
  text_c(x, y + rr + ps(28), lbl);

  // value tag, only while hovering / dragging (house rule)
  hov || drag_idx == idx ? (
    fmt == 0 ? sprintf(#kv, "%+.1f dB", v) :
    fmt == 1 ? sprintf(#kv, "%d%%", v) :
               sprintf(#kv, "%s", fmt - 1000 + floor((v - vmin) / max(step, 1) + 0.5));
    gfx_setfont(3);  gfx_measurestr(#kv, w, h);
    ty = y - lr - ps(12) - h;
    col(0x1B365D, 0.95);  gfx_rect(x - w * 0.5 - ps(6), ty - ps(3), w + ps(12), h + ps(6), 1);
    col(0xF0EDE6, 1);     text_c(x, ty + h * 0.5, #kv);
  );
);

function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));
  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));
  r * 65536 + g * 256 + b;
);

// ---------- house lamp keys (34-series), ported from gfx-ui lk_key / lk_fit ----------
// Coloured lens in a dark well; off = darker milky lens with vignette and dark legend,
// lit = feathered glow and spill onto the panel. Adapted to this panel's px/py/ps layout.
LK_AMB = 0xF2A41E;  lk_well = 0x141518;
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov;
  dn = hov && lmb ? 1 : 0;                                  // the cap sinks a pixel while held
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lk_fit(x, y, w, h, on, c, str) local(k) (
  k = min(w / 62, h / 48);
  lk_key(x + 4 * k, y + 4 * k, w - 8 * k, h - 8 * k, on, c, str);
);

// Lit key: milky dark lens with an L-shaped bottom + right shade when off (oblong keys have no casing), glow when lit.
function litkey(x, y, w, h, on, lbl, c) local(X, Y, W, H, e) (
  X = px(x);  Y = py(y);  W = ps(w);  H = ps(h);  e = min(W, H) * 0.14;
  on ? ( col(c, 0.28); gfx_rect(X - ps(6), Y - ps(6), W + ps(12), H + ps(12), 1); );
  col(0x111214, 1);  gfx_rect(X - ps(3), Y - ps(3), W + ps(6), H + ps(6), 1);
  on ? col(c, 1) : col(shade(c, 0.42), 1);
  gfx_rect(X, Y, W, H, 1);
  on ? (
    col(0xFFFFFF, 0.22);  gfx_rect(X + ps(3), Y + ps(3), W - ps(6), H * 0.32, 1);
  ) : (
    col(0xFFFFFF, 0.07);  gfx_rect(X + ps(2), Y + ps(2), W - ps(4), H - ps(4), 1);
    col(0x000000, 0.25);  gfx_rect(X, Y + H - e, W, e, 1);  gfx_rect(X + W - e, Y, e, H - e, 1);   // no casing: shade bottom + right
  );
  gfx_setfont(2);
  on ? col(0x1A1A1A, 1) : col(0x0E0E0E, 0.85);
  text_c(X + W * 0.5, Y + H * 0.5, lbl);
  click && mouse_x >= X && mouse_x <= X + W && mouse_y >= Y && mouse_y <= Y + H;
);

// Lamp key in any colour. Returns 1 on click.
function colkey(x, y, w, h, on, lbl, c_on, c_off, c_glow) local(X, Y, W, H) (
  X = px(x);  Y = py(y);  W = ps(w);  H = ps(h);
  on ? ( col(c_glow, 0.3); gfx_rect(X - ps(5), Y - ps(5), W + ps(10), H + ps(10), 1); );
  col(0x1A1A1A, 1);  gfx_rect(X - ps(2), Y - ps(2), W + ps(4), H + ps(4), 1);
  on ? col(c_on, 1) : col(c_off, 1);
  gfx_rect(X, Y, W, H, 1);
  on ? ( col(0xFFFFFF, 0.35); gfx_rect(X + ps(3), Y + ps(2), W - ps(6), ps(3), 1); );
  gfx_setfont(2);
  on ? col(0x3A2410, 1) : col(0x2A2016, 1);
  text_c(X + W * 0.5, Y + H * 0.5, lbl);
  click && mouse_x >= X && mouse_x <= X + W && mouse_y >= Y && mouse_y <= Y + H;
);
// IN keys are always amber (house rule)
function lampkey(x, y, w, h, on, lbl) ( lk_fit(x - 3, y - 4, w + 6, h + 8, on, LK_AMB, lbl); );   // house 34-series lamp key

// Small moving-coil GR meter (0..20 dB), cream face, red zone from 10 dB
function grmeter(x, y, w, h, gr) local(X, Y, W, H, cx0, cy0, R, a, j, b) (
  X = px(x);  Y = py(y);  W = ps(w);  H = ps(h);
  vg_spill(X - ps(3), Y - ps(3), W + ps(6), H + ps(6), 1);                // backlit (gfx-glow)
  col(0x1A1A1A, 1);  gfx_rect(X - ps(3), Y - ps(3), W + ps(6), H + ps(6), 1);
  vg_glow(X, Y, W, H, 1);
  cx0 = X + W * 0.5;  cy0 = Y + H + ps(14);  R = H + ps(6);
  // scale
  j = 0;
  loop(5,
    b = -0.75 + j * 0.375;
    j >= 2 ? col(0xB5443A, 1) : col(0x2B2B2B, 1);
    gfx_line(cx0 + sin(b) * (R - ps(8)), cy0 - cos(b) * (R - ps(8)),
             cx0 + sin(b) * (R - ps(2)), cy0 - cos(b) * (R - ps(2)), 1);
    gfx_setfont(5);
    text_c(cx0 + sin(b) * (R - ps(16)), cy0 - cos(b) * (R - ps(16)), 360 + j);
    j += 1;
  );
  col(0xB5443A, 1);  j = 0;
  loop(2, gfx_arc(cx0, cy0, R - ps(2) - j, 0, 0.75, 1); j += 1; );
  gfx_setfont(5);  col(0x2B2B2B, 1);
  text_c(cx0, Y + H - ps(9), "GR dB");
  // needle (pivot hidden below the window)
  a = -0.75 + 1.5 * min(1, max(0, gr / 20));
  col(0x1A1A1A, 1);
  gfx_line(cx0 + sin(a) * (ps(18)), cy0 - cos(a) * (ps(18)),
           cx0 + sin(a) * (R - ps(1)), cy0 - cos(a) * (R - ps(1)), 1);
  gfx_line(cx0 + sin(a) * (ps(18)) + 1, cy0 - cos(a) * (ps(18)),
           cx0 + sin(a) * (R - ps(1)) + 1, cy0 - cos(a) * (R - ps(1)), 1);
  // window rim covers the pivot end
  col(0x1A1A1A, 1);  gfx_rect(X - ps(3), Y + H, W + ps(6), ps(3), 1);
);

// ORDER key: swap EQ and COMP (PRE and LIMIT never move).
function swap_order() local(t) (
  t = ord2;  ord2 = ord3;  ord3 = t;
  slider_automate(2 | 4);
  gui_dirty = 1;
);

// Module plate: pale grey-beige, slight edge highlight + shadow
function plate(x0, w) (
  col(0x000000, 0.35);  gfx_rect(px(x0 + 2), py(42), ps(w), ps(600), 1);
  col(0xCFCBC0, 1);     gfx_rect(px(x0), py(40), ps(w), ps(600), 1);
  j = 0;
  // darker bottom and right edges (L shape, no doubled corner) for depth
  loop(6,
    col(0x000000, 0.2 * (6 - j) / 6);
    gfx_rect(px(x0 + w - 1.5 - (j + 1)), py(40), ps(1), ps(594), 1);
    gfx_rect(px(x0), py(640 - (j + 1)), ps(w), ps(1), 1);
    j += 1;
  );
  col(0xE4E0D6, 1);     gfx_rect(px(x0), py(40), ps(w), ps(1.5), 1);
                        gfx_rect(px(x0), py(40), ps(1.5), ps(600), 1);
  col(0x9E9A90, 1);     gfx_rect(px(x0 + w) - ps(1.5), py(40), ps(1.5), ps(600), 1);
);

// Dark blue label tag (like the black type-label strips on the originals)
function tag(cx, y, w, str) (
  col(0x1B365D, 1);  gfx_rect(px(cx - w * 0.5), py(y), ps(w), ps(22), 1);
  gfx_setfont(2);  col(0xF0EDE6, 1);  text_c(px(cx), py(y + 11), str);
);

function draw_module(m, slot) local(x0, cx, on, in_idx) (
  x0 = 40 + slot * 182;   cx = x0 + 88;
  on = mod_tgt[m];
  in_idx = m == 0 ? 5 : m == 1 ? 9 : m == 2 ? 14 : 20;

  plate(x0, 176);

  thumbscrew(cx, 56);

  status_led(cx, 86, on);

  // controls (panel order follows the originals)
  m == 0 ? (
    j = 1;
    loop(3,
      lk_fit(cx - 77 + (j - 1) * 52, 124, 50, 34, pre_hpf == j, 0xF2C230, 200 + j) ? (
        slider(6) = pre_hpf == j ? 0 : j;  param_touched(6);
      );
      j += 1;
    );
    gfx_setfont(6);  col(0x2B2B2B, 1);  text_c(px(cx), py(182), "HPF  Hz");
    knob(cx, 280, 26, 7, -12, 15, 3, 0, -1,       "GAIN  dB", 0,    210, 10);
    knob(cx, 410, 18, 8,   0, 10, 2, 0, -1,       "OUTPUT dV", 0,   220, 6);
    tag(cx, 524, 140, "AMPLIFIER");
  ) : m == 1 ? (
    knob(cx, 152, 20, 10, -15, 15, 3, 0, 0xB5443A, "HIGH  - dB +",  0,    230, 11);
    knob(cx, 254, 20, 11, -15, 15, 3, 0, 0x7A5536, "LOW  - dB +",   0,    230, 11);
    knob(cx, 356, 20, 12,   0,  5, 1, 1, 0x3E6E9E, "PRESENCE  kHz", 1150, 250, 6);
    knob(cx, 458, 20, 13,  -8,  8, 2, 0, 0x3E6E9E, "PRESENCE  dB",  0,    260, 9);
    tag(cx, 524, 140, "EQUALISER");
  ) : m == 2 ? (
    grmeter(x0 + 28, 110, 120, 52, comp_m);
    knob(cx,      238, 24, 16,  0,  9, 1,   3,  -1,       "LIMIT / COMPRESS", 1160, 280, 10);
    knob(cx - 44, 352, 15, 15, -30, 0, 2.5, -10, -1,      "THRESH",   0,    270, 7);
    knob(cx + 44, 352, 15, 17,  0,  4, 1,   1,  -1,       "RECOVERY", 1170, 290, 5);
    knob(cx - 44, 456, 14, 18,  0,  3, 1,   1,  0xE2B93B, "SC HPF",   1180, 300, 4);
    knob(cx + 44, 456, 14, 19,  0, 20, 0.5, 0,  -1,       "MAKEUP",   0,    310, 5);
    tag(cx, 524, 140, "COMPRESSOR");
  ) : (
    grmeter(x0 + 28, 110, 120, 52, lim_m);
    knob(cx, 262, 26, 21, -12, 0, 0.1, -0.3, -1, "CEILING  - dB", 0,    320, 5);
    knob(cx, 400, 20, 22,   0, 5, 1,   2,    -1, "RELEASE  ms",   1190, 330, 6);
    tag(cx, 524, 140, "LIMITER");
  );

  // switched-off module is slightly greyed (house rule)
  !on ? ( col(0xCFCBC0, 0.5);  gfx_rect(px(x0), py(100), ps(176), ps(420), 1); );

  lampkey(cx - 30, 558, 60, 24, on, "IN") ? (
    slider(in_idx) = on ? 0 : 1;  param_touched(in_idx);
  );
  thumbscrew(cx, 618);
);

// ---------- house preset bar (ported from gfx-panel pk_preset): [PRESETS][<][>][LCD] ----------
// PRESETS, or a click on the LCD, opens the list; the arrows step through it. menu = "Name 1|...|Name n".
// The list ends with "Reset all to defaults" (returns n + 1). Returns the preset to load, 0 for none.
// Keys are this unit's lamp keys (PB_KEY lens, PB_INK arrows); the LCD is the house amber one.
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, tw, th, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_fit(x, y, 100, h, 0, PB_KEY, "PRESETS") ? open = 1;
  lk_fit(x + 102, y, 46, h, 0, PB_KEY, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_fit(x + 150, y, 46, h, 0, PB_KEY, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(PB_INK, 1);  pb_tri(x + 125, y + h * 0.5 - 0.5, 5, -1);  pb_tri(x + 173, y + h * 0.5 - 0.5, 5, 1);
  // the LCD: black bezel, dark amber glass, the patch name only
  lx = x + 206;
  col(0x000000, 0.3);  gfx_rect(px(lx + 2), py(y + 5), ps(lw), ps(h - 6), 1);
  col(0x050505, 1);    gfx_rect(px(lx), py(y + 3), ps(lw), ps(h - 6), 1);
  gfx_gradrect(px(lx + 3), py(y + 6), ps(lw - 6), ps(h - 12), 0.17, 0.10, 0.02, 1, 0, 0, 0, 0, -0.06 / ps(h), -0.04 / ps(h), -0.01 / ps(h), 0);
  col(0xFFFFFF, 0.06); gfx_line(px(lx + 4), py(y + 7), px(lx + lw - 5), py(y + 7), 1);
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  gfx_setfont(8);  col(0xE8A33A, 1);  gfx_measurestr(#pb_nm, tw, th);
  gfx_x = px(lx + 10);  gfx_y = py(y + h * 0.5) - th * 0.5;  gfx_drawstr(#pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- presets (OUTPUT evens the loudness; DRIFT is left alone) ----------
PRESET_MENU = "Init|Vocal: Presence|Vocal: Radio Voice|Vocal: Announcer|Drums: Bus Glue|Drums: Snare Crack|Bass: Weight|Guitar: Acoustic|Keys: Piano Sheen|Colour: Hot Line|Bus: Broadcast Wall|Bus: Gentle Master";
PB_KEY = 0x5C9AEC;  PB_INK = 0x14263C;

// ---------- frame setup ----------
sc = min(gfx_w / 1000, gfx_h / 724);
ox = (gfx_w - 1000 * sc) * 0.5;
oy = (gfx_h - 724 * sc) * 0.5 + 44 * sc;        // y 0 = the old top edge; the preset bar sits above it, on the oak

lmb = mouse_cap & 1;
click = lmb && !last_lmb;

!fonts_picked ? pick_fonts();
gfx_setfont(1, #fd, ps(25), fd_fl);
gfx_setfont(2, #fl, ps(13), fl_fl);
gfx_setfont(3, #fl, ps(13), fl_fl);
gfx_setfont(4, #fd, ps(17), fd_fl);
gfx_setfont(5, #fl, ps(12), fl_fl);
gfx_setfont(6, #fl, ps(15), fl_fl);
gfx_setfont(8, "Courier New", ps(17), 'b');

// meter ballistics (collect @block maxima)
comp_m = max(comp_gr_disp, comp_m * 0.8);  comp_gr_disp = 0;
lim_m  = max(lim_gr_disp,  lim_m * 0.8);   lim_gr_disp = 0;
out_m  = max(out_pk_disp,  out_m * 0.85);  out_pk_disp = 0;

// ---------- oak cabinet (fills the whole window) ----------
col(0xC08A45, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(0xA8742F, 0.35);
j = 0;
loop(43,
  gy = py(-47 + j * 17 + 5 * sin(j * 1.7));
  gfx_line(0, gy, gfx_w, gy + ps(2 * sin(j * 0.9)), 1);
  j += 1;
);
col(0xD9A866, 0.25);
j = 0;
loop(14,
  gx = px(3 + j * 1.6);  gfx_line(gx, 0, gx, gfx_h, 1);
  gx = px(997 - j * 1.6); gfx_line(gx, 0, gx, gfx_h, 1);
  j += 1;
);

// black backplane
col(0x000000, 0.4);  gfx_rect(px(24), py(24), ps(952), ps(632), 1);
col(0x141414, 1);    gfx_rect(px(26), py(26), ps(948), ps(628), 1);

// ---------- the four modules, drawn in the requested order ----------
slot = 0;
loop(4, draw_module(ord_new[slot], slot); slot += 1; );

// ---------- OUTPUT / supply module ----------
mx = 772;  mcx = mx + 95;
plate(mx, 190);
thumbscrew(mx + 30, 56);  thumbscrew(mx + 160, 56);
gfx_setfont(1);  col(0x1B365D, 1);  text_spaced(px(mcx), py(96), "MISTRAL", ps(5));
gfx_setfont(5);  col(0x2B2B2B, 1);  text_c(px(mcx), py(120), "GFX");

// supply lamp (light blue) — dips with sag when DRIFT is up
lamp = 0.55 + 0.45 * (1 - drift_amt * min(sag_env, 1) * 0.8);
col(0x8C8C86, 1);      gfx_circle(px(mcx), py(162), ps(16), 1, 1);
col(0xD8D8D2, 1);      gfx_circle(px(mcx), py(162), ps(16), 0, 1);
col(0x8FB8DE, 0.3 * lamp); gfx_circle(px(mcx), py(162), ps(22), 1, 1);
col(0x8FB8DE, lamp);   gfx_circle(px(mcx), py(162), ps(11), 1, 1);
col(0xFFFFFF, 0.5);    gfx_circle(px(mcx) - ps(3), py(162) - ps(3), ps(3), 1, 1);
gfx_setfont(5);  col(0x2B2B2B, 1);  text_c(px(mcx), py(190), "SUPPLY");

// vent slots
col(0x141414, 1);
j = 0;
loop(11, gfx_rect(px(mx + 30 + j * 12), py(204), ps(6), ps(28), 1); j += 1; );

// output peak LED bar (-42..0 dB, 3 dB per segment)
pk_db = gdb(out_m);
j = 0;
loop(14,
  segdb = -42 + (j + 1) * 3;
  lit = pk_db >= segdb - 3;
  j >= 13 ? col(0xC8402F, lit ? 1 : 0.25) :
  j >= 11 ? col(0xF2A33A, lit ? 1 : 0.25) :
            col(0x8FB8DE, lit ? 1 : 0.25);
  gfx_rect(px(mx + 18 + j * 11), py(244), ps(9), ps(10), 1);
  j += 1;
);
gfx_setfont(5);  col(0x2B2B2B, 1);  text_c(px(mcx), py(266), "PEAK");

// ORDER key: lit blue while COMP runs before EQ
lk_fit(mcx - 48, 278, 96, 32, ord2 == 2, 0x5C9AEC, "ORDER") ? swap_order();

knob(mcx, 368, 26, 23, -12,  12, 0.5, 0, -1, "LEVEL  dB", 0, 340, 5);
knob(mcx, 476, 18, 24,   0, 100, 1,   0, -1, "DRIFT  %",  1, 350, 5);
tag(mcx, 559, 150, "OUTPUT");
thumbscrew(mx + 30, 618);  thumbscrew(mx + 160, 618);

// ---------- preset bar, on the oak above the rack ----------
col(0x000000, 0.22);  gfx_rect(px(232), py(-38), ps(536), ps(36), 1);
col(0x5A3A18, 0.5);   gfx_rect(px(232), py(-4), ps(536), ps(1), 1);
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(240, -36, 32, 320, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > 12 ? 1 : pb_k; );

// ---------- chrome handles on the cabinet sides ----------
hx = 6;
loop(2,
  col(0x000000, 0.3);  gfx_rect(px(hx + 2), py(122), ps(12), ps(440), 1);
  col(0x9A9A96, 1);    gfx_rect(px(hx - 2), py(114), ps(16), ps(14), 1);
                       gfx_rect(px(hx - 2), py(552), ps(16), ps(14), 1);
  col(0xC8C8C4, 1);    gfx_rect(px(hx), py(120), ps(12), ps(440), 1);
  col(0xF2F2EE, 1);    gfx_rect(px(hx + 2), py(120), ps(3), ps(440), 1);
  col(0x7A7A76, 1);    gfx_rect(px(hx + 10), py(120), ps(2), ps(440), 1);
  hx = 982;
);

// ---------- end of frame ----------
!lmb ? drag_idx = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // rebuilt in @block, never on the GUI thread
