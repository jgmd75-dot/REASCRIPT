ui_knob(366 * sc, (rn_yc + 78) * sc, 6, -10, 15, 0, 0, "GAIN", "%+.1f dB");
ui_knob(442 * sc, (rn_yc + 78) * sc, 19, 0, 100, 100, 0, "MIX", "%.0f%%");
rn_fonts();
