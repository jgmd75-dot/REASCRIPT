ui_section(0); C_INK = INKP;
pk_ledbtn(28 * sc, (rn_yr + 16) * sc, 40 * sc, 30 * sc, slider1 == 0, LEDC) ? ( slider1 = 0; ui_auto(1); );
pk_ledbtn(76 * sc, (rn_yr + 16) * sc, 40 * sc, 30 * sc, slider1 == 1, LEDC) ? ( slider1 = 1; ui_auto(1); );
slider1 == 0 ? (
  pk_ledbtn(140 * sc, (rn_yr + 16) * sc, 40 * sc, 30 * sc, slider7, LEDC) ? ( slider7 = 1 - slider7; ui_auto(7); );
) : (
  pk_ledbtn(140 * sc, (rn_yr + 16) * sc, 40 * sc, 30 * sc, slider8, LEDC) ? ( slider8 = 1 - slider8; ui_auto(8); );
);
gfx_setfont(11); ui_col(INKP);
ui_text(48 * sc, (rn_yr + 52) * sc, "COMP"); ui_text(96 * sc, (rn_yr + 52) * sc, "LEVEL");
ui_text(160 * sc, (rn_yr + 52) * sc, slider1 == 0 ? "GENTLE" : "LOG RELEASE");
