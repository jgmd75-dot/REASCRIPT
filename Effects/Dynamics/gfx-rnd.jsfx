gfx_setfont(11); ui_cola(INKP, 0.75); gfx_x = 128 * sc; gfx_y = 31 * sc; gfx_drawstr("HALF-RACK DUO"); vt_mark(); ver_tag_put();
ui_size_picker(250 * sc, 26 * sc);
rn_fonts();
gfx_setfont(11); ui_col(INKP); gfx_x = 336 * sc; gfx_y = 26 * sc; gfx_drawstr("GR");
gi = 0;
loop(10,
  gv_ = gi == 0 ? 1 : gi == 1 ? 2 : gi == 2 ? 3 : gi == 3 ? 4 : gi == 4 ? 6 : gi == 5 ? 8 : gi == 6 ? 10 : gi == 7 ? 12 : gi == 8 ? 15 : 20;
  gx_ = (372 + gi * 24) * sc;
  pk_led(gx_, 30 * sc, 4.5 * sc, mgr >= gv_, LEDC);
  sprintf(#gv, "%d", gv_); ui_cola(INKP, 0.8); ui_text(gx_, 40 * sc, #gv);
  gi += 1;
);
mgr = max(grd, mgr * 0.85); grd = 0;
pk_line(18 * sc, 62 * sc, 622 * sc, 62 * sc, INKP, 0.35);

pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );
k_ = pk_preset(28 * sc, 72 * sc, 450 * sc, 28 * sc, pr_cur,
  "Clear Vocal|Gentle Mix Bus|Drum Smack|Even Bass|Acoustic Strum|Tame The Boom|Parallel Crush|Vocal Leveller|Bass Leveller|Warm Bus|Lows Only Level|Thick Drums");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 12 ? 0 : k_; );
