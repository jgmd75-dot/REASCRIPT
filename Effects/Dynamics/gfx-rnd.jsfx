sprintf(#v, "%+.1f dB", slider27); dy_knob(328, rn_ye + 44, 12, 27, -15, 15, 0, 0, 0x3A78C0, "LO MID", #v);
sprintf(#v, "%.0f Hz", slider28);  dy_knob(328, rn_ye + 106, 11, 28, 80, 2000, 400, 1, 0x3A78C0, "FREQ", #v);
sprintf(#v, "%+.1f dB", slider29); dy_knob(408, rn_ye + 44, 12, 29, -15, 15, 0, 0, 0x3C9A6C, "HI MID", #v);
slider30 >= 1000 ? sprintf(#v, "%.2f kHz", slider30 / 1000) : sprintf(#v, "%.0f Hz", slider30);
dy_knob(408, rn_ye + 106, 11, 30, 400, 8000, 2500, 1, 0x3C9A6C, "FREQ", #v);
sprintf(#v, "%+.1f dB", slider31); dy_knob(488, rn_ye + 44, 12, 31, -15, 15, 0, 0, 0xC0423B, "HIGH", #v);
sprintf(#v, "%.1f kHz", slider32 / 1000); dy_knob(488, rn_ye + 106, 11, 32, 1500, 20000, 8000, 1, 0xC0423B, "FREQ", #v);
