desc:RND [transparent/character comp] (GFX)
//tags: compressor levelling amplifier vca opto eq
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate, gfx-instrument and gfx-clip

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-clip.jsfx-inc

slider1:0<0,1,1{Comp,Level}>-Mode
slider2:0<-40,20,0.1>-Threshold (dBu)
slider3:3<1,25,0.01>-Ratio
slider4:10<0.2,200,0.01>-Attack (ms)
slider5:0.3<0.05,5,0.001>-Release (s)
slider6:0<-10,15,0.1>-Gain (dB)
slider7:0<0,1,1{Off,On}>-Gentle (Comp)
slider8:1<0,1,1{Linear,Exponential}>-Release curve (Level)
slider9:0<-24,12,0.1>-Input trim (dB)
slider10:1<0,1,1{Off,On}>-Input guard
slider11:25<0,100,1>-Drift amount (%)
slider12:0.25<0.02,2,0.01>-Drift speed (Hz)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider18:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider19:100<0,100,1>-Mix (%)
slider20:50<0,100,1>-Drift (%)
slider21:0<0,1,1{Bypassed,Active}>-EQ
slider22:1<0,1,1{EQ first,Comp first}>-Order
slider23:20<20,1000,1>-EQ: Lo cut (Hz, 20 = none)
slider24:0<-15,15,0.1>-EQ: LF (dB)
slider25:100<20,500,1>-EQ: LF freq (Hz)
slider26:1<0,1,1{Bell,Shelf}>-EQ: LF shape
slider27:0<-15,15,0.1>-EQ: LMF (dB)
slider28:400<80,2000,1>-EQ: LMF freq (Hz)
slider29:0<-15,15,0.1>-EQ: HMF (dB)
slider30:2500<400,8000,1>-EQ: HMF freq (Hz)
slider31:0<-15,15,0.1>-EQ: HF (dB)
slider32:8000<1500,20000,10>-EQ: HF freq (Hz)
slider33:1<0,1,1{Bell,Shelf}>-EQ: HF shape
slider34:20000<2000,20000,10>-EQ: Hi cut (Hz, 20000 = none)
slider35:0<0,2,1{Off,HPF,Split}>-Side-chain mode
slider36:100<20,2000,1>-Side-chain freq (Hz)
slider37:prs_sel=0<0,12,1{No preset,Clear Vocal,Gentle Mix Bus,Drum Smack,Even Bass,Acoustic Strum,Tame The Boom,Parallel Crush,Vocal Leveller,Bass Leveller,Warm Bus,Lows Only Level,Thick Drums}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-rnd";
ext_noinit = 1;

function tc(ms) ( 1 - exp(-1 / (max(ms, 0.02) * 0.001 * srate)); );

function curve(lv, t, r, k) local(o) (
  o = lv - t;
  o <= -k * 0.5 ? 0 : o >= k * 0.5 ? o * (1 - 1 / r) : (1 - 1 / r) * (o + k * 0.5) ^ 2 / (2 * k);
);

rv_kn = 0.9494; rv_d0 = 0.07; rv_dk = 4.0136; rv_b0 = 0.2965; rv_bk = -0.2545; rv_w0 = 0.70; rv_w1 = 1.0;
function rv_sat_blk(dd, bb, n, snap) instance(dv, bv, nrm, idv, ibv, inr) local(s0, nr) (
  s0 = (this.clp_crv(bb + 0.0001) - this.clp_crv(bb - 0.0001)) / 0.0002;
  nr = 10 ^ (rv_mk / 20) / (dd * max(s0, 0.05));
  snap ? ( dv = dd; bv = bb; nrm = nr; idv = ibv = inr = 0; ) : (
    idv = (dd - dv) / n; ibv = (bb - bv) / n; inr = (nr - nrm) / n;
  );
);
function rv_sat(u) instance(dv, bv, rest, nrm, idv, ibv, inr) (
  dv += idv; bv += ibv; nrm += inr;
  rest = this.clp_crv(bv - 0.5 * ibv);
  (this.clp_run(dv * u + bv) - rest) * nrm;
);
rv_c1 = -0.4255; rv_c2 = 0.101; rv_c0 = 1 - 2 * rv_c1 - 2 * rv_c2;
function rv_fir(x) instance(z1, z2, z3, z4) local(y) (
  y = rv_c0 * z2 + rv_c1 * (z1 + z3) + rv_c2 * (x + z4);
  z4 = z3; z3 = z2; z2 = z1; z1 = x;
  y;
);
function rv_firclr() instance(z1, z2, z3, z4) ( z1 = z2 = z3 = z4 = 0; );

function eq_set(f, ge, q, typ) instance(a1, a2, a3, m0, m1, m2) local(ag, g, k) (
  g = tan($pi * min(f, srate * 0.45) / srate);
  ag = 10 ^ (ge / 40);
  typ == 0 ? ( k = 1 / (q * ag); m0 = 1; m1 = k * (ag * ag - 1); m2 = 0; ) :
  typ == 1 ? ( g /= sqrt(ag); k = 1 / q; m0 = 1; m1 = k * (ag - 1); m2 = ag * ag - 1; ) :
  typ == 2 ? ( g *= sqrt(ag); k = 1 / q; m0 = ag * ag; m1 = k * (1 - ag) * ag; m2 = 1 - ag * ag; ) :
  typ == 3 ? ( k = 1 / q; m0 = 1; m1 = -k; m2 = -1; ) :
             ( k = 1 / q; m0 = 0; m1 = 0;  m2 = 1; );
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function eq_run(x, c1, c2, c3, n0, n1, n2) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;
  v1 = c1 * ic1 + c2 * v3;
  v2 = ic2 + c2 * ic1 + c3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  n0 * x + n1 * v1 + n2 * v2;
);
function eq_clr() instance(ic1, ic2) ( ic1 = 0; ic2 = 0; );
function eq_bq(g) local(p) ( p = 2; sqrt(p) / (p - 1) * (0.75 + 0.5 * min(abs(g) / 16, 1)); );

function eq_targets() (
  eq_t0 = slider24 * eq_m0; eq_t1 = slider27; eq_t2 = slider29; eq_t3 = slider31 * eq_m3;
  eq_tf0 = slider25; eq_tf1 = slider28; eq_tf2 = slider30; eq_tf3 = slider32;
  eq_thp = slider23 > 20.5 ? slider23 : 20; eq_tlp = min(slider34, srate * 0.45);
);
function eq_coefs() (
  eq_c0.eq_set(eq_f0, eq_g0, eq_sh0 ? 0.7071 : eq_bq(eq_g0), eq_sh0 ? 1 : 0);
  eq_c1.eq_set(eq_f1, eq_g1, eq_bq(eq_g1), 0);
  eq_c2.eq_set(eq_f2, eq_g2, eq_bq(eq_g2), 0);
  eq_c3.eq_set(eq_f3, eq_g3, eq_sh3 ? 0.7071 : eq_bq(eq_g3), eq_sh3 ? 2 : 0);
  eq_ch.eq_set(eq_hp, 0, 0.7071, 3);
  eq_cl.eq_set(eq_lp, 0, 0.7071, 4);
);
function gl2(t) instance(a, b) ( a += (t - a) * eq_k1; b += (a - b) * eq_k1; b; );
function gl2set(t) instance(a, b) ( a = b = t; );
function gl2d(t) instance(a, b) ( abs(t - a) + abs(t - b); );
function eq_snap() (
  eq_targets();
  eG0.gl2set(eq_t0); eG1.gl2set(eq_t1); eG2.gl2set(eq_t2); eG3.gl2set(eq_t3);
  eF0.gl2set(log(eq_tf0)); eF1.gl2set(log(eq_tf1)); eF2.gl2set(log(eq_tf2)); eF3.gl2set(log(eq_tf3));
  eHP.gl2set(log(eq_thp)); eLP.gl2set(log(eq_tlp));
  eq_g0 = eq_t0; eq_g1 = eq_t1; eq_g2 = eq_t2; eq_g3 = eq_t3;
  eq_f0 = eq_tf0; eq_f1 = eq_tf1; eq_f2 = eq_tf2; eq_f3 = eq_tf3; eq_hp = eq_thp; eq_lp = eq_tlp;
  eq_coefs();
);
function eq_glide() local(d) (
  eq_g0 = eG0.gl2(eq_t0); eq_g1 = eG1.gl2(eq_t1); eq_g2 = eG2.gl2(eq_t2); eq_g3 = eG3.gl2(eq_t3);
  eq_f0 = exp(eF0.gl2(log(eq_tf0))); eq_f1 = exp(eF1.gl2(log(eq_tf1))); eq_f2 = exp(eF2.gl2(log(eq_tf2))); eq_f3 = exp(eF3.gl2(log(eq_tf3)));
  eq_hp = exp(eHP.gl2(log(eq_thp))); eq_lp = exp(eLP.gl2(log(eq_tlp)));
  eq_m0 == 0 && eG0.gl2d(0) < 0.002 ? ( eq_sh0 = slider26; eq_m0 = 1; eG0.gl2set(0); eq_g0 = 0; );
  eq_m3 == 0 && eG3.gl2d(0) < 0.002 ? ( eq_sh3 = slider33; eq_m3 = 1; eG3.gl2set(0); eq_g3 = 0; );
  eq_targets();
  d = eG0.gl2d(eq_t0) + eG1.gl2d(eq_t1) + eG2.gl2d(eq_t2) + eG3.gl2d(eq_t3) +
      eF0.gl2d(log(eq_tf0)) + eF1.gl2d(log(eq_tf1)) + eF2.gl2d(log(eq_tf2)) + eF3.gl2d(log(eq_tf3)) +
      eHP.gl2d(log(eq_thp)) + eLP.gl2d(log(eq_tlp));
  eq_mv = d > 0.0002 || eq_m0 == 0 || eq_m3 == 0;
  !eq_mv ? eq_snap();
  eq_coefs();
);
function eq_proc(x) instance(h, l, b0, b1, b2, b3) local(y, z) (
  y = this.h.eq_run(x, eq_ch.a1, eq_ch.a2, eq_ch.a3, eq_ch.m0, eq_ch.m1, eq_ch.m2);
  y = x + (y - x) * eq_whs;
  z = this.l.eq_run(y, eq_cl.a1, eq_cl.a2, eq_cl.a3, eq_cl.m0, eq_cl.m1, eq_cl.m2);
  y = y + (z - y) * eq_wls;
  y = this.b0.eq_run(y, eq_c0.a1, eq_c0.a2, eq_c0.a3, eq_c0.m0, eq_c0.m1, eq_c0.m2);
  y = this.b1.eq_run(y, eq_c1.a1, eq_c1.a2, eq_c1.a3, eq_c1.m0, eq_c1.m1, eq_c1.m2);
  y = this.b2.eq_run(y, eq_c2.a1, eq_c2.a2, eq_c2.a3, eq_c2.m0, eq_c2.m1, eq_c2.m2);
  this.b3.eq_run(y, eq_c3.a1, eq_c3.a2, eq_c3.a3, eq_c3.m0, eq_c3.m1, eq_c3.m2);
);
function eq_reset() instance(h, l, b0, b1, b2, b3) (
  this.h.eq_clr(); this.l.eq_clr(); this.b0.eq_clr(); this.b1.eq_clr(); this.b2.eq_clr(); this.b3.eq_clr();
);

function sc_coefs() (
  sc_h.bq_set(1, sc_f, 0.70710678, 0);
  sc_lp.bq_set(0, sc_f, 0.70710678, 0); sc_hp.bq_set(1, sc_f, 0.70710678, 0);
);
function sc_runf(x, c0, c1, c2, d1, d2) instance(x1, x2, y1, y2) local(y) (
  y = c0 * x + c1 * x1 + c2 * x2 - d1 * y1 - d2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function sc_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function sc_proc(x) instance(h, l1, l2, u1, u2) (
  sc_wh > 0 ? sc_hpo = this.h.sc_runf(x, sc_h.b0, sc_h.b1, sc_h.b2, sc_h.a1, sc_h.a2) : sc_hpo = x;
  sc_ws > 0 ? (
    sc_lo = this.l2.sc_runf(this.l1.sc_runf(x, sc_lp.b0, sc_lp.b1, sc_lp.b2, sc_lp.a1, sc_lp.a2), sc_lp.b0, sc_lp.b1, sc_lp.b2, sc_lp.a1, sc_lp.a2);
    sc_hi = this.u2.sc_runf(this.u1.sc_runf(x, sc_hp.b0, sc_hp.b1, sc_hp.b2, sc_hp.a1, sc_hp.a2), sc_hp.b0, sc_hp.b1, sc_hp.b2, sc_hp.a1, sc_hp.a2);
  ) : ( sc_lo = x; sc_hi = 0; );
);
function sc_reset() instance(h, l1, l2, u1, u2) (
  this.h.sc_clr(); this.l1.sc_clr(); this.l2.sc_clr(); this.u1.sc_clr(); this.u2.sc_clr();
);

function update() (
  mode = slider1;
  thr = slider2 - 18;
  ratio = slider3;
  att_ms = slider4; rel_ms = slider5 * 1000;
  gain_t = 10 ^ (slider6 / 20);
  mix_t = slider19 / 100;
  snice = slider7; logrel = slider8;
  drift_macro(slider20);
  drift = slider11 / 100 * dm_a; dspd = slider12 * dm_s;
  in_setup(slider9, slider10);
  ins_output_straight(13);
  slider26 != eq_sh0 ? eq_m0 = 0;
  slider33 != eq_sh3 ? eq_m3 = 0;
  eq_targets(); eq_mv = 1;
  sc_tf = slider36; sc_mvf = 1;
);

function pset(md, th, ra, at, re, ga, gn, lr, mx) (
  slider1 = md; slider2 = th; slider3 = ra; slider4 = at; slider5 = re; slider6 = ga; slider7 = gn; slider8 = lr; slider19 = mx;
);
function peq(eon, ord, lc, lg, lof, ls, mg, mf, hg, hm_f, tg, tf, ts, hc) (
  slider21 = eon; slider22 = ord; slider23 = lc; slider24 = lg; slider25 = lof; slider26 = ls; slider27 = mg; slider28 = mf;
  slider29 = hg; slider30 = hm_f; slider31 = tg; slider32 = tf; slider33 = ts; slider34 = hc;
);
function psc(m, f) ( slider35 = m; slider36 = f; );
function load_preset(p) local(k) (
  p == 1 ? ( pset(0, -6, 3, 10, 0.30, 3.2, 0, 1, 100); peq(1, 1, 80, 0, 100, 1, -2, 300, 2, 3500, 2.5, 10000, 1, 20000); psc(1, 90); ) :
  p == 2 ? ( pset(0, -4, 2, 30, 0.40, 0.3, 1, 1, 100); peq(0, 1, 20, 0, 100, 1, 0, 400, 0, 2500, 0, 8000, 1, 20000); psc(1, 120); ) :
  p == 3 ? ( pset(0, -12, 6, 2, 0.12, 7.9, 0, 1, 60);  peq(1, 1, 20, 2, 70, 0, -3, 400, 2, 4000, 2, 9000, 1, 20000); psc(0, 100); ) :
  p == 4 ? ( pset(0, -8, 4, 20, 0.25, 5.4, 0, 1, 100); peq(1, 0, 35, 2, 80, 1, -2, 300, 1.5, 900, 0, 8000, 1, 20000); psc(0, 100); ) :
  p == 5 ? ( pset(0, -6, 3, 15, 0.30, 4.4, 1, 1, 100); peq(1, 1, 90, 0, 100, 1, -3, 250, 0, 2500, 2, 11000, 1, 20000); psc(1, 100); ) :
  p == 6 ? ( pset(0, -10, 5, 15, 0.20, 0.6, 0, 1, 100); peq(0, 1, 20, 0, 100, 1, 0, 400, 0, 2500, 0, 8000, 1, 20000); psc(2, 150); ) :
  p == 7 ? ( pset(0, -20, 20, 1, 0.10, 13.3, 0, 1, 35);  peq(0, 1, 20, 0, 100, 1, 0, 400, 0, 2500, 0, 8000, 1, 20000); psc(1, 80); ) :
  p == 8 ? ( pset(1, -8, 3, 10, 0.40, 4.9, 0, 1, 100); peq(1, 1, 80, 0, 100, 1, -1.5, 350, 1.5, 3000, 3, 12000, 1, 20000); psc(1, 100); ) :
  p == 9 ? ( pset(1, -8, 4, 20, 0.50, 5.5, 0, 1, 100); peq(1, 0, 30, 2.5, 70, 1, -2, 250, 0, 2500, -1.5, 6000, 1, 20000); psc(0, 100); ) :
  p == 10 ? ( pset(1, -4, 2, 30, 0.80, 1.3, 0, 1, 100); peq(1, 0, 25, 1, 60, 1, 0, 400, 0, 2500, 1, 10000, 1, 20000); psc(1, 120); ) :
  p == 11 ? ( pset(1, -10, 4, 15, 0.40, 0.7, 0, 1, 100); peq(0, 1, 20, 0, 100, 1, 0, 400, 0, 2500, 0, 8000, 1, 20000); psc(2, 120); ) :
  p == 12 ? ( pset(1, -14, 6, 5, 0.25, 7.4, 0, 0, 70);  peq(1, 1, 20, 1.5, 90, 1, -2, 500, 0, 2500, 2, 8000, 1, 20000); psc(1, 70); );
  p == 13 ? (
    pset(0, 0, 3, 10, 0.3, 0, 0, 1, 100); peq(0, 1, 20, 0, 100, 1, 0, 400, 0, 2500, 0, 8000, 1, 20000); psc(0, 100);
    slider9 = 0; slider10 = 1; slider11 = 25; slider12 = 0.25; slider13 = 0; slider14 = 30; slider15 = 120; slider16 = 6000;
    slider17 = -0.3; slider18 = 1; slider20 = 50;
  );
  k = 1; loop(36, ui_auto(k); k += 1; );
);

crms = tc(8);
dA.drift_init(0.8 + rand(1) * 0.5); dR.drift_init(0.8 + rand(1) * 0.5);
dSL.drift_init(0.8 + rand(1) * 0.5); dSR.drift_init(0.8 + rand(1) * 0.5); dG.drift_init(0.8 + rand(1) * 0.5);
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
sm = tc(30);
xstep = 1 / (0.02 * srate);
dstep = 1 / (0.008 * srate);
eq_k1 = 1 - exp(-1 / (0.01 * srate));
eL = 0; eR = 0; grC = 0; grV = 0; g1 = 0; g2 = 0; g3 = 0; grpk = 0; hold = 0; tsm = 0; grd = 0;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;
stL.clp_set(2, 1, rv_kn, 0); stR.clp_set(2, 1, rv_kn, 0);
stL.clp_knee(rv_w0); stR.clp_knee(rv_w0);
rv_kt.clp_kt_cfg(rv_w0, rv_w1);
pfL.clp_pf_cfg(40000, 18000, -1, 100); pfR.clp_pf_cfg(40000, 18000, -1, 100);
p0L.clp_pf_cfg(40000, 18000, -1, 100); p0R.clp_pf_cfg(40000, 18000, -1, 100);
rv_on = 0; rv_wu = 1000; rv_drv = 0; grVs = 0; rv_gs = tc(20);
!ui_dflt ? ui_thm = 5; !ui_dflt ? ui_hw = 1;
!ui_dflt ? ui_kstyle = 0;
AMBL = 0xFFB030;
eq_sh0 = slider26; eq_sh3 = slider33; eq_m0 = 1; eq_m3 = 1;
update();
eq_snap(); eq_mv = 0; eq_on = 0; eq_w = slider21; eq_ord = slider22; dip = 1;
eq_whp = slider23 > 20.5; eq_wlp = slider34 < 19995; eq_whs = eq_whp; eq_wls = eq_wlp; dips = 1;
sc_f = slider36; scF.gl2set(log(sc_f)); sc_coefs(); sc_on = 0;
sc_wh = slider35 == 1; sc_ws = slider35 == 2;
mw = slider1;
thr_s = thr; gain_s = gain_t; mix_s = mix_t;
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(37, i != 37 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
update();
dinc = dspd * samplesblock / srate;
vA = dA.drift_tick(dinc); vR = dR.drift_tick(dinc);
vSL = dSL.drift_tick(dinc); vSR = dSR.drift_tick(dinc); vG = dG.drift_tick(dinc);
att_d = att_ms * 2 ^ (0.7 * drift * vA);
rel_d = rel_ms * 2 ^ (0.7 * drift * vR);
catt = tc(att_d); crel = tc(rel_d);
r3 = ratio ^ (1 / 3);
ca1 = tc(att_d * 0.25); cr1 = tc(rel_d * 0.5);
ca2 = tc(att_d);        cr2 = tc(rel_d);
ca3 = tc(att_d * 4);    cr3 = tc(rel_d * 2.5);
knee_la = 10 * (1 + 0.4 * drift * vG);
mem_la = 2 * (1 + 0.5 * drift * vG);
kdL = 1 + 0.5 * drift * vSL; kdR = 1 + 0.5 * drift * vSR;
bdL = 0.12 * drift * vSL;    bdR = 0.12 * drift * vSR;
lin_rate = 20 / max(rel_ms * 0.001, 0.05) / srate;
la_att = tc(att_ms * 1.5); la_ons = tc(3); la_hold = tc(1500);
la_r1 = tc(rel_ms * 0.25);

rv_want = slider1 == 1 || mw > 0;
rv_was = rv_on;
rv_want && !rv_on ? (
  stL.clp_reset(); stR.clp_reset(); pfL.clp_pf_reset(); pfR.clp_pf_reset(); p0L.clp_pf_reset(); p0R.clp_pf_reset();
  rv_kt.kti = 0; aL1 = aR1 = hL1 = hR1 = 0; fwL.rv_firclr(); fwR.rv_firclr(); fdL.rv_firclr(); fdR.rv_firclr(); lpL = lpR = 0;
  grVs = grV; rv_drv = min(grV / 20, 1);
);
rv_on = rv_want;
rv_on ? (
  rv_dt = min(grVs / 20, 1);
  rv_drv += (rv_dt - rv_drv) * (1 - exp(-samplesblock / (0.03 * srate)));
  pfL.clp_pf_block(rv_dt, srate, samplesblock); pfR.clp_pf_block(rv_dt, srate, samplesblock);
  p0L.clp_pf_block(0, srate, samplesblock); p0R.clp_pf_block(0, srate, samplesblock);
  rv_w = rv_kt.clp_kt_block(rv_dt, srate, samplesblock);
  stL.clp_knee(rv_w); stR.clp_knee(rv_w);
  rv_dd = rv_d0 * (1 + rv_dk * rv_drv); rv_bb = rv_b0 + rv_bk * rv_drv; rv_mk = 0.05 + 0.4 * rv_drv;
  stL.rv_sat_blk(rv_dd * kdL, rv_bb + bdL, samplesblock, !rv_was); stR.rv_sat_blk(rv_dd * kdR, rv_bb + bdR, samplesblock, !rv_was);
  stL.clp_tidy(); stR.clp_tidy();
);

eq_want = slider21 == 1 || eq_w > 0;
eq_want && !eq_on ? ( eqL.eq_reset(); eqR.eq_reset(); eq_sh0 = slider26; eq_sh3 = slider33; eq_m0 = eq_m3 = 1; eq_snap(); eq_mv = 0;
                      eq_whp = slider23 > 20.5; eq_wlp = slider34 < 19995; );
eq_on = eq_want;

sc_want = slider35 > 0 || sc_wh > 0 || sc_ws > 0;
sc_want && !sc_on ? ( scL.sc_reset(); scR.sc_reset(); sc_f = slider36; scF.gl2set(log(sc_f)); sc_coefs(); sc_mvf = 0; );
sc_on = sc_want;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
in_process(spl0, spl1);
xL = in_l; xR = in_r;

rv_wu = rv_on ? rv_wu + 1 : 0;
mw = slider1 ? ( rv_wu > 96 ? min(mw + xstep, 1) : mw ) : max(mw - xstep, 0);
sc_wh = slider35 == 1 && sc_on ? min(sc_wh + xstep, 1) : max(sc_wh - xstep, 0);
sc_ws = slider35 == 2 && sc_on ? min(sc_ws + xstep, 1) : max(sc_ws - xstep, 0);
mws = mw * mw * (3 - 2 * mw);
sc_whs = sc_wh * sc_wh * (3 - 2 * sc_wh); sc_wss = sc_ws * sc_ws * (3 - 2 * sc_ws); sc_wo = max(1 - sc_whs - sc_wss, 0);
eq_w = slider21 && eq_on ? min(eq_w + xstep, 1) : max(eq_w - xstep, 0);
dip = slider22 != eq_ord && eq_w > 0 ? max(dip - dstep, 0) : min(dip + dstep, 1);
(dip <= 0 || eq_w <= 0) && slider22 != eq_ord ? eq_ord = slider22;
dips = dip * dip * (3 - 2 * dip); eq_ws = eq_w * eq_w * (3 - 2 * eq_w);

eq_on ? (
  eq_whp = slider23 > 20.5 ? min(eq_whp + xstep, 1) : max(eq_whp - xstep, 0);
  eq_wlp = slider34 < 19995 ? min(eq_wlp + xstep, 1) : max(eq_wlp - xstep, 0);
  eq_whs = eq_whp * eq_whp * (3 - 2 * eq_whp); eq_wls = eq_wlp * eq_wlp * (3 - 2 * eq_wlp);
  eq_mv ? eq_glide();
  !eq_ord ? ( xL += (eqL.eq_proc(xL) - xL) * eq_ws; xR += (eqR.eq_proc(xR) - xR) * eq_ws; );
);

sc_on ? (
  sc_mvf ? ( sc_f = exp(scF.gl2(log(sc_tf))); scF.gl2d(log(sc_tf)) < 0.0002 ? ( sc_f = sc_tf; scF.gl2set(log(sc_tf)); sc_mvf = 0; ); sc_coefs(); );
  scL.sc_proc(xL); dL = sc_wo * xL + sc_whs * sc_hpo + sc_wss * sc_lo; aL = xL + (sc_lo - xL) * sc_wss; hL = sc_hi * sc_wss;
  scR.sc_proc(xR); dR = sc_wo * xR + sc_whs * sc_hpo + sc_wss * sc_lo; aR = xR + (sc_lo - xR) * sc_wss; hR = sc_hi * sc_wss;
) : ( dL = aL = xL; dR = aR = xR; hL = hR = 0; );

eL += (dL * dL - eL) * crms; eR += (dR * dR - eR) * crms;
lv = 10 * log10(max(max(eL, eR), 0.000000000001)) + 3;
thr_s += (thr - thr_s) * sm;

snice ? (
  t1 = curve(lv, thr_s + 6, r3, 4);           t1 > g1 ? g1 += (t1 - g1) * ca1 : g1 += (t1 - g1) * cr1;
  t2 = curve(lv - g1, thr_s, r3, 6);          t2 > g2 ? g2 += (t2 - g2) * ca2 : g2 += (t2 - g2) * cr2;
  t3 = curve(lv - g1 - g2, thr_s - 4, r3, 8); t3 > g3 ? g3 += (t3 - g3) * ca3 : g3 += (t3 - g3) * cr3;
  grC = g1 + g2 + g3;
) : (
  tgt = curve(lv, thr_s, ratio, ratio > 4 ? 3 : 6);
  tgt > grC ? grC += (tgt - grC) * catt : grC += (tgt - grC) * crel;
  g1 = grC; g2 = 0; g3 = 0;
);
tgv = curve(lv, thr_s, ratio, knee_la);
tsm += (tgv - tsm) * la_ons;
hold += (grV - hold) * la_hold;
tsm > grV ? ( grV += (tsm - grV) * la_att; grpk = grV; ) : (
  logrel ? (
    grV += (tsm - grV) * (grV > grpk * 0.6 ? la_r1 : tc(rel_ms * (1 + mem_la * min(hold / 6, 1))));
  ) : (
    grV = max(grV - lin_rate * (1 + mem_la * 0.5 * min(hold / 6, 1)) ^ -1, tsm);
  );
);

gc = 10 ^ (-grC / 20);
wcL = aL * gc + hL; wcR = aR * gc + hR;
dcL = aL + hL;      dcR = aR + hR;
rv_on ? (
  gv = 10 ^ (-grV / 20);
  wvL = stL.rv_sat(pfL.clp_pf_run(aL * gv)) + 0.5 * (hL + hL1);
  wvR = stR.rv_sat(pfR.clp_pf_run(aR * gv)) + 0.5 * (hR + hR1);
  dvL = p0L.clp_pf_run(0.5 * (aL + aL1)) + 0.5 * (hL + hL1);
  dvR = p0R.clp_pf_run(0.5 * (aR + aR1)) + 0.5 * (hR + hR1);
  aL1 = aL; aR1 = aR; hL1 = hL; hR1 = hR;
  wvL = fwL.rv_fir(wvL); wvR = fwR.rv_fir(wvR); dvL = fdL.rv_fir(dvL); dvR = fdR.rv_fir(dvR);
  lpc = 1 - exp(-2 * $pi * max(20000 * 2 ^ (-grV / 12), 6000) / srate);
  lpL += (wvL - lpL) * lpc; lpR += (wvR - lpR) * lpc; wvL = lpL; wvR = lpR;
  yL = wcL + (wvL - wcL) * mws; yR = wcR + (wvR - wcR) * mws;
  dxL = dcL + (dvL - dcL) * mws; dxR = dcR + (dvR - dcR) * mws;
) : ( yL = wcL; yR = wcR; dxL = dcL; dxR = dcR; );
grVs += (grV - grVs) * rv_gs;
grd = max(grd, mw < 0.5 ? grC : grV);

gain_s += (gain_t - gain_s) * sm;
mix_s += (mix_t - mix_s) * sm;
oL = dxL + (yL * gain_s - dxL) * mix_s; oR = dxR + (yR * gain_s - dxR) * mix_s;
eq_on && eq_ord ? ( oL += (eqL.eq_proc(oL) - oL) * eq_ws; oR += (eqR.eq_proc(oR) - oR) * eq_ws; );
oL *= dips; oR *= dips;
oL = ostL.ost_band(oL); oR = ostR.ost_band(oR);
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;

@gfx 640 514
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
function ver_tag_hold(s, slot, dy) local(th) (
  th = gfx_texth; strcpy(#vt_s, s); vt_slot = slot; vt_xr = gfx_x; vt_yb = gfx_y + (0.8 + dy) * th;
  vt_fs = 0.5 * th; vt_gap = 0.3 * th; vt_r = gfx_r; vt_g = gfx_g; vt_b = gfx_b; vt_a = gfx_a;
);
function vt_mark() ( vt_xr = max(vt_xr, gfx_x); );
function ver_tag_put() local(r, g, b, a) (
  r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; gfx_r = vt_r; gfx_g = vt_g; gfx_b = vt_b; gfx_a = vt_a;
  ver_tag_at(#vt_s, vt_slot, vt_xr + vt_gap, vt_yb, vt_fs, -1);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a;
);
ui_begin(640, 514);

function rn_fonts() (
  gfx_setfont(11, "Trebuchet MS", ui_fs4, 'b');
  gfx_setfont(12, "Trebuchet MS", 26 * sc, 'b');
  gfx_setfont(13, "Trebuchet MS", ui_fs5, 'b');
);
function rn_title(cx, y, s) ( gfx_setfont(13); ui_cola(INKP, 0.7); ui_text(cx * sc, y * sc, s); );
function rn_key(x, y, w, lit, s) local(hit) (
  hit = pk_ledbtn(x * sc, y * sc, w * sc, 28 * sc, lit, LEDC);
  gfx_setfont(11); ui_col(INKP); ui_text((x + w * 0.5) * sc, (y + 35) * sc, s);
  hit;
);

PNL = slider1 ? 0xD3A52E : 0xE8E4D9;
INKP = slider1 ? 0x2A2210 : 0x2B2A28;
LEDC = slider1 ? 0x3ADF6A : 0xFF3A2A;
