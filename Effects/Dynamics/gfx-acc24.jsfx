desc:ACC24 [compressor] (GFX)
//tags: compressor dynamics limiter bus vocal auto
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-thick, gfx-glow, gfx-bypass (.jsfx-inc) in the same folder.
//
// ACC24 (Lab) - an auto compressor with a peak limiter, in the spirit of the mid-1980s British rackmount auto-compressors:
// program-dependent attack and dual-slope release (one AUTO key), manual times when you want them, and a fast peak limiter
// after the make-up gain to catch stray transients. A transparent workhorse for the mix bus and vocals.
// The Lab Hybrid adds CHARACTER (JG, 28 Oct 2026: "PUNCH / GLUE dial"): one dial that changes how the compressor
// listens and moves, from PUNCH (transients through, quick recovery) to GLUE (slow, round, holds a mix together).
//
// SIGNAL FLOW
//   in > detector (RMS with a little peak, linked stereo) > the compressor's gain cell (THRESHOLD, RATIO, soft knee,
//   ATTACK, RELEASE) > MAKE-UP GAIN > peak limiter (LIMIT) > output transformer (clean until it is driven hard) > LEVEL.
//   AUTO ATTACK: the harder the signal overshoots, the faster it is caught (about 12 ms for a gentle push, under 1 ms for
//   a sudden jump). AUTO RELEASE: dual slope - short peaks recover fast (80 ms slope), sustained compression lets go
//   slowly (0.8 s slope, charged over about a second), so the bus breathes without pumping.
//   The limiter has no look-ahead (zero latency): an instant-attack peak catcher with a 60 ms release.
//   A mix tool: no output clipper; the transformer only colours when it is pushed hard.
//   MIX: parallel compression - the dry input against the compressed, made-up and limited path (before the
//   transformer and LEVEL).
//   BYPASS (the house key): crossfades (15 ms) to the untouched input (no latency to match).
// CHARACTER (-100 PUNCH .. 0 .. +100 GLUE; 0 = the Stable ACC24 exactly; glides 30 ms):
//   PUNCH   the attack slows (up to x 4: AUTO 3 .. 48 ms, so the front of each hit gets through), the release
//           quickens (to x 0.45: the gain is back before the next hit), the knee hardens (6 -> 2 dB) and the
//           detector hears only the body (pure RMS, no peak) - drums and plucks keep their snap.
//   GLUE    the knee widens (6 -> 16 dB: the compressor eases in long before THRESHOLD), the detector averages over
//           longer (8 -> 40 ms, no peak) and ignores the deep lows (a 90 Hz high-pass in its key, so the bass
//           doesn't pump the mix), the attack eases (x 1.6), the release lengthens (x 2.2) and AUTO's slow slope
//           charges sooner (x 0.4): small, steady gain moves that hold a bus or a mix together.
// THRESHOLD and LIMIT are in dBu (0 dBu = -18 dBFS, the house calibration).
//
// THICK: the house THICK circuit (gfx-thick): dense low-mid weight (a dynamic 280 Hz bell that lifts
//   decaying notes), iron saturation below 500 Hz (2nd and 3rd harmonics, alias-free, no latency) and a rounded
//   transient front; level-matched, a 15 ms fade in and out. Here: after the make-up gain, before the limiter; the detector also forgives fast peaks (a 25 ms RMS window, less
//   peak) and the release holds the body 35 % longer.
// DRIFT (the Grey rack DRIFT key: lit = 33 %, dark = 5 %; 50 % = the standard amount below): the VCA and the
//   analogue around it.
//   thermal     the gain cell warms under sustained compression: its gain creeps (+/- 0.12 dB) and the release
//               slows a little; it cools when the compression stops
//   VCA         slow random wander of the cell's offset (+/- 0.1 dB) and of the threshold (+/- 0.3 dB)
//   summing     the timing and knee parts sit a little off nominal and wander (+/- 8 % times, +/- 10 % knee)
//   0 % = none, 100 % = twice the standard amount, a little faster.
//
// GUI: house dark grey rack faceplate, elephant's breath outlines and title; COMPRESSOR, CHARACTER (the dial and the
//   THICK) on the top 1U unit, LIMITER and OUTPUT (with the DRIFT key) on the 1U unit below it; BYPASS and S / M / L / ? in the header; drag knobs
//   (Shift = fine), mouse wheel, double-click or Ctrl-click = default.
// PRESETS: Init, Vocal Glue, Drum Bus Control, Gentle Master Bus, Acoustic Levelling, Bass Anchor, Heavy Squash, Broadcast Voice, Dynamic Limiter, Drum Crunch, Piano Glue, Subtle Mix Polish
//   (the Stable set, CHARACTER at 0), Drum Bus Punch, Mix Bus Glue.
//   Level-matched to the input on programme (MAKE-UP and LEVEL), except Init.
// Latency: 0 samples.
//
// TWEAK points are marked TWEAK.
// STATUS: Lab (experimental, may change), Hybrid rework of the Stable ACC24. v1.0 (deployed 28 Oct 2026: CHARACTER,
//   one AUTO key, DRIFT key, BYPASS, two 1U units on a 1080-wide panel).

import gfx-drift.jsfx-inc
import gfx-thick.jsfx-inc
import gfx-glow.jsfx-inc
import gfx-bypass.jsfx-inc

slider1:c_in=1<0,1,1{Out,In}>-Compressor in
slider2:thr=0<-20,20,0.1>-Threshold (dBu)
slider3:ratio=2<1,21,0.01>-Ratio (21 = infinity)
slider4:a_auto=1<0,1,1{Manual,Auto}>-Auto (attack and release)
slider5:atk=10<0.5,50,0.01>-Attack (ms)
slider6:r_auto=1<0,1,1{Manual,Auto}>-(unused, was Release mode: AUTO now sets both)
slider7:rel=300<50,5000,1>-Release (ms)
slider8:l_thr=10<-10,15,0.1>-Limit (dBu)
slider9:link=0<0,1,1{Off,On}>-(unused, was Limit link: removed, JG 28 Oct 2026)
slider10:mk=0<0,20,0.1>-Make-up gain (dB)
slider11:out_lvl=0<-18,6,0.1>-Level (dB)
slider12:drift=33<0,100,1>-Drift (%)
slider13:vu_mode=0<0,1,1{Output,Gain reduction}>-VU meter
slider14:thick=0<0,1,1{Off,On}>-Thick
slider15:mix=100<0,100,1>-Mix (%)
slider16:chr=0<-100,100,1>-Character (-100 punch .. +100 glue)
slider17:byp=0<0,1,1{Off,On}>-Bypass
slider18:prs_sel=0<0,14,1{No preset,Init,Vocal Glue,Drum Bus Control,Gentle Master Bus,Acoustic Levelling,Bass Anchor,Heavy Squash,Broadcast Voice,Dynamic Limiter,Drum Crunch,Piano Glue,Subtle Mix Polish,Drum Bus Punch,Mix Bus Glue}>-Preset

@init
#ui_man = "gfx-acc24";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
gfx_ext_retina = 1;
CR = 16;                                  // control rate: every 16 samples

// ---------- tuning (TWEAK) ----------
KNEE = 6;          // dB, soft knee width
PK_MIX = 0.3;      // how much the peak level counts in the detector (0 = pure RMS)
A_SLOW = 12;       // ms: AUTO attack for a gentle overshoot ...
A_FAST = 0.8;      // ms: ... and for a sudden jump of A_JUMP dB
A_JUMP = 6;
R_FAST = 0.08;     // s: AUTO release, the fast slope (short peaks)
R_SLOW = 0.8;      // s: AUTO release, the slow slope (sustained compression)
C_SLOW = 1.0;      // s: how fast the slow slope charges
L_REL = 0.06;      // s: the limiter's release
// CHARACTER (TWEAK): how far each part moves at full PUNCH (P_) / full GLUE (G_)
P_ATK = 3;         // attack x (1 + 3) = x 4 ...
P_AMIN = 12;       // ms: ... and never faster than this (AUTO's sudden-jump catch included)
P_REL = 0.6;       // release x (1 - 0.6)
P_THR = 3;         // dB: the threshold sits lower, so the body is held down at least as hard as at 0 ...
P_LIFT = 3;        // dB: ... while a hit's front lifts the gain back towards unity (fully at this much transient)
P_KNEE = 0.65;     // knee x (1 - 0.65): 6 -> 2.1 dB
G_ATK = 0.6;       // attack x 1.6
G_REL = 1.2;       // release x 2.2
G_CHG = 0.6;       // AUTO's slow slope charges x (1 - 0.6)
G_KNEE = 1.6;      // knee x 2.6: 6 -> 15.6 dB
G_RMS = 0.04;      // s: the detector's window at full GLUE
G_HPF = 90;        // Hz: the detector's high-pass at full GLUE
G_THR = 3;         // dB: the threshold sits lower (the high-passed key reads quieter)

XO_K = 0.18;       // output transformer core (gentle)

// ---------- drift sources ----------
DVC.drift_init(0.7 + rand(1) * 0.4);          // VCA offset
DTH.drift_init(0.6 + rand(1) * 0.4);          // threshold
DTM.drift_init(0.5 + rand(1) * 0.4);          // timing parts
DKN.drift_init(0.5 + rand(1) * 0.4);          // knee
tol_t = rand(2) - 1;  tol_k = rand(2) - 1;   // this unit's tolerances

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(g) ( 8.685889638065035 * log(max(g, 0.0000000001)); );
// transformer: the core saturates the low end only when pushed (level-dependent, soft)
function xfmr(x, k) instance(lp) local(e) (
  lp += (x - lp) * 0.004;
  e = lp * k;  x - lp + lp / sqrt(1 + e * e);
);

function update_params() (
  drift_macro(drift);
  t_in = c_in >= 0.5;
  slope = ratio >= 20.5 ? 1 : 1 - 1 / ratio;               // 0 (1:1) .. 1 (infinity)
  t_mk = mk;  t_out = out_lvl;
  auto_a = a_auto >= 0.5;  auto_r = auto_a;            // one AUTO key for both (JG, 28 Oct 2026)
  lim_t = l_thr;                                          // dBu
);

sm_c = 1 - exp(-CR / (0.03 * srate));
sw_c = 1 - exp(-1 / (0.012 * srate));
rms_c = 1 - exp(-1 / (0.008 * srate));      // detector: 8 ms mean square ...
rms_c2 = 1 - exp(-1 / (0.025 * srate));     // ... THICK: 25 ms
rms_c3 = 1 - exp(-1 / (G_RMS * srate));     // ... GLUE: 40 ms
dhp_c = 1 - exp(-2 * $pi * G_HPF / srate);  // GLUE: the key's high-pass (one-pole low-pass taken away)
tf_a = 1 - exp(-1 / (0.0005 * srate));  tf_r = 1 - exp(-1 / (0.012 * srate));   // PUNCH: a fast envelope ...
ts_a = 1 - exp(-1 / (0.006 * srate));  ts_r = 1 - exp(-1 / (0.3 * srate));     // ... against a slow one
te_f = 0;  te_s = 0;  ch_lift = 0;
s_ch = chr / 100;  ch_p = max(0, -s_ch);  ch_g = max(0, s_ch);  dlp_l = 0;  dlp_r = 0;
by_setup(17);
thk_init();  thk_lift = 3;  thk_drv = 1.5;  thk_asym = 0.12;  thk_tr = 1.2;  thk_trim = 0;   // TWEAK: ACC24's THICK
pk_r = exp(-1 / (0.02 * srate));            // detector: peak fall 20 ms
lr_c = 1 - exp(-1 / (L_REL * srate));
update_params();
s_mk = t_mk;  s_out = t_out;  s_thr = thr;  s_slope = slope;  s_lim = lim_t;
mk_g = db2g(s_mk);  out_g = db2g(s_out);  mk_i = 0;  og_i = 0;
m_in = t_in;
mix_c = 1 - exp(-1 / (0.03 * srate));  mix_s = mix / 100;
ms = 0;  pk = 0;  gf = 0;  gs = 0;  gr = 0;  cg = 1;  cgi = 0;  lg = 1;  heat = 0;
cr_n = 0;

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function param_touched_au(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 1); pv(2, 0); pv(3, 2); pv(4, 1); pv(5, 10); pv(6, 1); pv(7, 300); pv(8, 10); pv(9, 0);
  pv(10, 0); pv(11, 0); pv(12, 33); pv(13, 0); pv(14, 0); pv(15, 100); pv(16, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? ( pv(2, -8); pv(3, 3); pv(8, 12); pv(10, 12.0); );   // Vocal Glue
  p == 3 ? ( pv(2, -6); pv(3, 4); pv(4, 0); pv(8, 13); pv(10, 9.5); pv(14, 1); );   // Drum Bus Control
  p == 4 ? ( pv(2, -4); pv(3, 1.5); pv(8, 14); pv(10, 4.5); );   // Gentle Master Bus
  p == 5 ? ( pv(2, -10); pv(3, 2.5); pv(8, 12); pv(10, 12.5); );   // Acoustic Levelling
  p == 6 ? ( pv(2, -8); pv(3, 5); pv(4, 0); pv(5, 20); pv(6, 0); pv(7, 400); pv(8, 13); pv(10, 11.5); pv(14, 1); );   // Bass Anchor
  p == 7 ? ( pv(2, -16); pv(3, 10); pv(4, 0); pv(5, 0.5); pv(6, 0); pv(7, 100); pv(8, 6); pv(10, 20); pv(11, 2.5); pv(15, 50); );   // Heavy Squash
  p == 8 ? ( pv(2, -12); pv(3, 6); pv(8, 6); pv(10, 20); pv(11, 4.5); pv(14, 1); );   // Broadcast Voice
  p == 9 ? ( pv(2, 4); pv(3, 21); pv(4, 0); pv(5, 0.5); pv(8, 6); pv(10, 20); pv(11, 3.0); );   // Dynamic Limiter
  p == 10 ? ( pv(2, -18); pv(3, 8); pv(4, 0); pv(5, 1); pv(6, 0); pv(7, 80); pv(8, 4); pv(10, 20); pv(11, 2.5); pv(14, 1); pv(15, 45); );   // Drum Crunch
  p == 11 ? ( pv(2, -6); pv(4, 0); pv(5, 30); pv(8, 14); pv(10, 6.5); );   // Piano Glue
  p == 12 ? ( pv(2, -2); pv(3, 1.5); pv(8, 15); pv(10, 3.0); pv(14, 1); );   // Subtle Mix Polish
  p == 13 ? ( pv(2, -12); pv(3, 4); pv(8, 15); pv(10, 11.6); pv(14, 1); pv(16, -70); );   // Drum Bus Punch
  p == 14 ? ( pv(2, -8); pv(3, 2); pv(8, 14); pv(10, 5.6); pv(16, 80); );   // Mix Bus Glue
  i = 1;  loop(16, param_touched_au(i);  i += 1; );
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
gui_dirty ? ( gui_dirty = 0;  update_params(); );
bdt = samplesblock / srate;
vca_off = 0.1 * dm_a * DVC.drift_tick(0.03 * dm_s * bdt) + 0.12 * dm_a * heat;
thr_dr = 0.3 * dm_a * DTH.drift_tick(0.025 * dm_s * bdt);
tm_dr = 1 + dm_a * (0.05 * tol_t + 0.04 * DTM.drift_tick(0.02 * dm_s * bdt));
kn_dr = 1 + dm_a * (0.06 * tol_k + 0.05 * DKN.drift_tick(0.02 * dm_s * bdt));
heat += ((min(1, -gr / 10)) - heat) * (1 - exp(-bdt / 20));             // warms over ~20 s of heavy GR
// display hand-offs
gr_disp = min(gr_disp, grmin);  grmin = 0;
vu_acc_d = vu_acc;  vu_n_d = vu_n;  vu_acc = 0;  vu_n = 0;
vu_disp = vu_n_d > 0 ? vu_acc_d / vu_n_d : 0;
in_disp = in_n > 0 ? in_acc / in_n : 0;  in_acc = 0;  in_n = 0;
over_disp = max(over_disp, over);  over = 0;
inpk_disp = max(inpk_disp, inpk);  inpk = 0;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- control rate: glides, the gain computer, the time constants ----------
cr_n <= 0 ? (
  cr_n = CR;
  s_mk += (t_mk - s_mk) * sm_c;  s_out += (t_out - s_out) * sm_c;
  s_thr += (thr - s_thr) * sm_c;  s_slope += (slope - s_slope) * sm_c;  s_lim += (lim_t - s_lim) * sm_c;
  s_ch += (chr / 100 - s_ch) * sm_c;  ch_p = max(0, -s_ch);  ch_g = max(0, s_ch);       // CHARACTER
  ch_a = (1 + P_ATK * ch_p) * (1 + G_ATK * ch_g);  ch_r = (1 - P_REL * ch_p) * (1 + G_REL * ch_g);
  mk_i = (db2g(s_mk + vca_off) - mk_g) / CR;  og_i = (db2g(s_out) - out_g) / CR;
  // the detector: RMS with a little of the peak, in dBu
  pkm = PK_MIX * (1 - 0.7 * thk_m) * (1 - max(ch_p, ch_g));     // THICK: the detector forgives fast peaks ... (CHARACTER: none)
  lv = g2db(sqrt(ms) * (1 - pkm) + pk * 0.7071 * pkm) + 18;
  tkr = 1 + 0.35 * thk_m;                                         // ... and holds the body a little longer
  ov = lv - (s_thr + thr_dr - P_THR * ch_p - G_THR * ch_g);
  kw = KNEE * kn_dr * (1 - P_KNEE * ch_p + G_KNEE * ch_g);
  tgr = ov <= -kw * 0.5 ? 0 : ov < kw * 0.5 ? -s_slope * sqr(ov + kw * 0.5) / (2 * kw) : -s_slope * ov;   // dB, <= 0
  // attack: AUTO = faster the harder it overshoots; manual = ATTACK
  a_ms = auto_a ? A_SLOW + (A_FAST - A_SLOW) * min(1, max(0, (gf - tgr) / A_JUMP)) : atk;
  ac = 1 - exp(-CR / (max(a_ms * ch_a, P_AMIN * ch_p) * 0.001 * tm_dr * srate));
  auto_r ? (
    // dual slope: the fast slope catches and lets go quickly; the slow slope charges only under sustained
    // compression and holds the gain down while it discharges
    gf += (tgr - gf) * (tgr < gf ? ac : 1 - exp(-CR / (R_FAST * ch_r * tm_dr * tkr * (1 + 0.3 * heat * dm_a) * srate)));
    gs += (gf - gs) * (gf < gs ? 1 - exp(-CR / (C_SLOW * (1 - G_CHG * ch_g) * srate)) : 1 - exp(-CR / (R_SLOW * ch_r * tm_dr * tkr * (1 + 0.3 * heat * dm_a) * srate)));
    gr = min(gf, gs);
  ) : (
    gf += (tgr - gf) * (tgr < gf ? ac : 1 - exp(-CR / (rel * ch_r * 0.001 * tm_dr * tkr * (1 + 0.3 * heat * dm_a) * srate)));
    gs = gf;  gr = gf;
  );
  grmin = min(grmin, gr);
  // PUNCH: the front of a hit (the fast envelope above the slow one) lifts the gain reduction while it lasts
  ch_lift = ch_p * min(1, max(0, (g2db(te_f) - g2db(te_s) - 1) / P_LIFT));
  cgi = (db2g(gr * (1 - ch_lift)) - cg) / CR;
  lim_g = db2g(s_lim - 18);                                   // the limiter's ceiling, linear
);
cr_n -= 1;
cg += cgi;  mk_g += mk_i;  out_g += og_i;
m_in += (t_in - m_in) * sw_c;  mix_s += (mix / 100 - mix_s) * mix_c;

by_in();
xl = spl0;  xr = spl1;
inpk = max(inpk, max(abs(xl), abs(xr)));
in_acc += (xl * xl + xr * xr) * 0.5;  in_n += 1;

// ---------- detector (linked stereo) ----------
// GLUE: the key loses its deep lows and averages over longer (at CHARACTER <= 0 exactly the Stable detector)
dlp_l += (xl - dlp_l) * dhp_c;  dlp_r += (xr - dlp_r) * dhp_c;
dk_l = xl - dlp_l * ch_g;  dk_r = xr - dlp_r * ch_g;
rc = rms_c + (rms_c2 - rms_c) * thk_m;  rc += (rms_c3 - rc) * ch_g;
ms += (max(dk_l * dk_l, dk_r * dk_r) - ms) * rc;
pv = max(abs(xl), abs(xr));
pk = pv > pk ? pv : pk * pk_r;
te_f += (pv - te_f) * (pv > te_f ? tf_a : tf_r);  te_s += (pv - te_s) * (pv > te_s ? ts_a : ts_r);

// ---------- the compressor's gain cell and make-up ----------
yl = xl * cg * mk_g;  yr = xr * cg * mk_g;
thk_proc(yl, yr, thick >= 0.5);  yl = thk_l;  yr = thk_r;    // THICK, after the make-up, before the limiter

// ---------- the peak limiter: instant attack, 60 ms release ----------
pv = max(abs(yl), abs(yr));
lt_ = pv * lg > lim_g ? lim_g / pv : lg + (1 - lg) * lr_c;    // the gain it needs now, or recover
lg = min(1, lt_);
yl *= lg;  yr *= lg;
lg < 0.94 ? over = 1;                                          // over half a dB of limiting: the OVER lamp
yl = xl + (yl - xl) * mix_s;  yr = xr + (yr - xr) * mix_s;    // MIX: parallel compression (dry + the compressed, limited path)

// ---------- output transformer, IN, LEVEL ----------
yl = XOL.xfmr(yl, XO_K);  yr = XOR.xfmr(yr, XO_K);
yl = xl + (yl - xl) * m_in;  yr = xr + (yr - xr) * m_in;
yl *= out_g;  yr *= out_g;
vu_acc += (yl * yl + yr * yr) * 0.5;  vu_n += 1;
spl0 = yl;  spl1 = yr;
by_out();

@gfx 1080 464
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
// =====================================================================
// GUI - two 1U units stacked (Lab, JG 28 Oct 2026), design units 1080 x 440:
//   unit 1 (0 - 228): header band 0 - 64 (title, preset bar, BYPASS, S / M / L / ?), COMPRESSOR 16 - 872, CHARACTER
//   888 - 1064 (outlines y 76 - 218; drawn with oy 12 lower); a black rack gap 228 - 236;
//   unit 2 (236 - 464): band 236 - 284, LIMITER 16 - 312, OUTPUT 328 - 1064 (outlines y 296 - 454; drawn 24 lower).
//   Each top bar ends in a green rule (3 px) with a green tab beside the unit's name (the DUPLEX accents).
// =====================================================================
C_FACE = 0x2B2D2F;  C_HEAD = 0x1D1E20;  C_INK = 0xF1F0EB;  C_INK2 = 0xB9B8B2;  C_LINE = 0xC7BEB3;
C_YEL = 0xF2C230;  C_LCDBG = 0x0B0D0E;  C_LCDTX = 0xF2C26A;  C_CREAM = 0xF1E6C4;
LK_AMB = 0xF2A41E;  lk_well = 0x050505;
C_GRN = 0x2E7A4C;  C_GRNL = 0x6FBF8E;      // the green accents (from OB Q's DUPLEX face, JG 28 Oct 2026)
C_LBLU = 0x3A9CFF;  C_LORG = 0xFF8A1E;     // level meters: blue below -10, orange at +5
VUS = 20000;                              // GUI memory: the faceplate grain, the VU needle

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rivet(x, y) (
  col(0x55585C, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.35);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
  col(0x000000, 0.6);  gfx_line(px(x) - ps(2), py(y), px(x) + ps(2), py(y), 1);
);
// an outlined section: the title (and lamps) sit in gaps in the top line
// one rounded corner of an outline, anti-aliased, in device pixels: (cx, cy) the arc's centre, ra the outer radius,
// th the line width, sx / sy which way the corner faces (-1 = left / top, 1 = right / bottom)
function ocorner(cx, cy, ra, th, sx, sy) local(i, j, d, c) (
  j = 0;
  loop(ra,
    i = 0;
    loop(ra,
      d = sqrt(sqr(i + 0.5) + sqr(j + 0.5));
      c = max(0, min(1, min(ra - d + 0.5, d - (ra - th) + 0.5)));
      c > 0 ? ( gfx_a = 0.85 * c;  gfx_rect(sx < 0 ? cx - i - 1 : cx + i, sy < 0 ? cy - j - 1 : cy + j, 1, 1, 1); );
      i += 1;
    );
    j += 1;
  );
);
// an outlined section: whole device pixels throughout so the lines and the corners meet exactly; the title
// (and lamps, gx0 - gx1) sit in gaps in the top line
function box(x, y, w, h, title, gx0, gx1) local(tw, th, L, R, T, B, ra, lw, g0, g1) (
  gfx_setfont(4);  gfx_measurestr(title, tw, th);
  L = floor(px(x) + 0.5);  R = floor(px(x + w) + 0.5);  T = floor(py(y) + 0.5);  B = floor(py(y + h) + 0.5);
  ra = floor(ps(7) + 0.5);  lw = max(1, floor(ps(1.5) + 0.5));
  g0 = floor(px(x + w * 0.5) - tw * 0.5 - ps(8) + 0.5);  g1 = floor(px(x + w * 0.5) + tw * 0.5 + ps(8) + 0.5);
  col(C_LINE, 0.85);
  gfx_rect(L + ra, T, g0 - (L + ra), lw, 1);
  gx0 > 0 ? ( gfx_rect(g1, T, floor(px(gx0) + 0.5) - g1, lw, 1);  gfx_rect(floor(px(gx1) + 0.5), T, R - ra - floor(px(gx1) + 0.5), lw, 1); )
          : gfx_rect(g1, T, R - ra - g1, lw, 1);
  gfx_rect(L + ra, B - lw, R - L - 2 * ra, lw, 1);
  gfx_rect(L, T + ra, lw, B - T - 2 * ra, 1);  gfx_rect(R - lw, T + ra, lw, B - T - 2 * ra, 1);
  ocorner(L + ra, T + ra, ra, lw, -1, -1);  ocorner(R - ra, T + ra, ra, lw, 1, -1);
  ocorner(L + ra, B - ra, ra, lw, -1, 1);   ocorner(R - ra, B - ra, ra, lw, 1, 1);
  col(C_INK, 1);  text_c(px(x + w * 0.5), T + lw * 0.5, title);
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%+.1f dBu", v) :
  fmt == 2 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 3 ? ( v >= 20.5 ? strcpy(#kv, "INF : 1") : sprintf(#kv, "%.1f : 1", v); ) :
  fmt == 4 ? sprintf(#kv, v < 10 ? "%.1f ms" : "%d ms", v) :
  fmt == 5 ? ( v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 7 ? sprintf(#kv, "%d %%", v) :
  fmt == 8 ? ( v < -0.5 ? sprintf(#kv, "PUNCH %d", -v) : v > 0.5 ? sprintf(#kv, "GLUE %d", v) : strcpy(#kv, "CENTRE"); ) :
             sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(0x000000, 0.92);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
// a filled quad with soft edges (the pointer stripe)
function quad(ax, ay, bx, by, hw) local(dx, dy, l) (
  l = sqrt(sqr(bx - ax) + sqr(by - ay));  dx = -(by - ay) / l * hw;  dy = (bx - ax) / l * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
);
// a scale mark: a short white tick at t (0 - 1) and, if str is set, its number
function smark(cx, cy, r, t, str) local(a, sa, ca) (
  a = -0.75 * $pi + t * 1.5 * $pi;  sa = sin(a);  ca = cos(a);
  col(C_INK, 0.9);  gfx_line(px(cx + sa * (r + 4)), py(cy - ca * (r + 4)), px(cx + sa * (r + 8)), py(cy - ca * (r + 8)), 1);
  strlen(str) ? ( gfx_setfont(5);  col(C_INK, 1);  text_c(px(cx + sa * (r + 17)), py(cy - ca * (r + 16)), str); );
);
function lt(v, vmin, vmax) ( log(v / vmin) / log(vmax / vmin); );       // where v sits on a log knob
// Pointer knob: a black knurled skirt, a black cap, a yellow stripe the full radius. klog = 1 before a call: the
// travel is logarithmic. The label sits on the row's common line (klab_y), coloured kcol (white, or yellow for the
// key filters).
function kn(cx, cy, r, idx, vmin, vmax, def, lbl, fmt) local(x, y, rr, v, t, hov, now, a, j, lg, b)
(
  lg = klog;  klog = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? lt(v, vmin, vmax) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
    v = lg ? vmin * (vmax / vmin) ^ t : vmin + t * (vmax - vmin);
    v = v >= 100 ? floor(v + 0.5) : floor(v * 100 + 0.5) / 100;
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 220)));
    v = lg ? vmin * (vmax / vmin) ^ t : vmin + t * (vmax - vmin);
    v = v >= 100 ? floor(v + 0.5) : lg ? floor(v * 100 + 0.5) / 100 : floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? lt(v, vmin, vmax) : (v - vmin) / (vmax - vmin);
  a = -0.75 * $pi + t * 1.5 * $pi;
  col(0x000000, 0.5);  gfx_circle(x + ps(1.5), y + ps(2.5), rr, 1, 1);                     // shadow
  col(0x0A0A0A, 1);  gfx_circle(x, y, rr, 1, 1);                                          // skirt
  col(0x2A2A2A, 1);  j = 0;                                                               // knurl
  loop(36, b = j / 36 * 2 * $pi;  gfx_line(x + sin(b) * rr * 0.84, y - cos(b) * rr * 0.84, x + sin(b) * (rr - 1), y - cos(b) * (rr - 1), 1);  j += 1; );
  col(0x1D1D1E, 1);  gfx_circle(x, y, rr * 0.78, 1, 1);                                   // cap
  col(0xFFFFFF, 0.10);  gfx_arc(x, y, rr * 0.72, -1.6, -0.3, 1);                          // one soft highlight
  col(0x3A3A3C, 1);  gfx_circle(x, y, rr, 0, 1);
  col(C_YEL, 1);  quad(x + sin(a) * rr * 0.18, y - cos(a) * rr * 0.18, x + sin(a) * rr * 0.97, y - cos(a) * rr * 0.97, ps(r >= 24 ? 1.7 : 1.4));
  gfx_setfont(6);  col(kcol ? kcol : C_INK, 1);  kcol = 0;
  text_c(x, py(klab_y), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(18), fmtv(v, fmt));
);
// ---------- keys ----------
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
// house lamp key (IN, and the preset bar)
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
// square white push-button with an amber LED (the selector keys): pressed in and lit when on
function wk_key(x, y, w, h, on, str) local(hov, hit, b, dn) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  b = 1.6;  dn = on ? 0 : 1.6;
  col(0x000000, 0.5);  u_rect(x + 1, y + 2, w, h);
  col(0x050505, 1);  u_rect(x, y, w, h);
  col(on ? 0xEDEAE0 : 0xBDBAB0, 1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn);
  on ? ( col(0xFFFFFF, 0.6);  u_rect(x + b, y + b, w - 2 * b, 1);  col(0x000000, 0.15);  u_rect(x + b, y + h - b - 2, w - 2 * b, 2); )
     : ( col(0x000000, 0.3);  u_rect(x + b, y + b + dn, w - 2 * b, 1.5); );
  hov ? ( col(0xFFFFFF, 0.1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn); );
  on ? ( col(0xFFB030, 0.35);  gfx_circle(px(x + 10), py(y + h * 0.5 + dn * 0.5), ps(5), 1, 1); );
  col(on ? 0xFFB030 : 0x6B5A3C, 1);  gfx_circle(px(x + 10), py(y + h * 0.5 + dn * 0.5), ps(2.8), 1, 1);
  gfx_setfont(2);  col(on ? 0x22201C : 0x4E4A44, 1);
  ui_keytext(px(x + w * 0.5 + 6), py(y + h * 0.5 + dn * 0.5), str);
  hit;
);
// a small plain square grey push-button (THICK, DRIFT); its red LED sits to its right and its name is printed on
// the faceplate under the pair. (x, y) = the button's top left; returns 1 when the button is clicked
function sq_key(x, y, on, lbl) local(hov, hit, s, b, dn) (
  s = 22;  b = 2;  dn = on ? 1.5 : 0;
  hov = mouse_x >= px(x) && mouse_x < px(x + s) && mouse_y >= py(y) && mouse_y < py(y + s);
  hit = click && hov && !drag_idx;
  col(0x000000, 0.5);  u_rect(x + 1, y + 2, s, s);
  col(0x050505, 1);  u_rect(x, y, s, s);                                       // the well
  col(on ? 0x8A8C90 : 0x9C9EA2, 1);  u_rect(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);   // the grey cap
  !on ? ( col(0xFFFFFF, 0.28);  u_rect(x + b, y + b, s - 2 * b, 1);
          col(0x000000, 0.28);  u_rect(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( col(0x000000, 0.35);  u_rect(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( col(0xFFFFFF, 0.08);  u_rect(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  // the LED, to the right
  col(0x000000, 1);  gfx_circle(px(x + s + 12), py(y + s * 0.5), ps(5.2), 1, 1);
  col(on ? 0xFF2A1A : 0x4A1410, 1);  gfx_circle(px(x + s + 12), py(y + s * 0.5), ps(3.8), 1, 1);
  on ? ( col(0xFF3A2A, 0.3);  gfx_circle(px(x + s + 12), py(y + s * 0.5), ps(8), 1, 1);
         col(0xFFFFFF, 0.55);  gfx_circle(px(x + s + 11), py(y + s * 0.5 - 1), ps(1.2), 1, 1); );
  // the label, printed on the faceplate
  gfx_setfont(7);  col(C_INK, 1);  text_c(px(x + (s + 17) * 0.5), py(y + s + 12), lbl);
  hit;
);
// a round LED lamp
function lamp(x, y, c, on) local(k) (
  k = lamp_k > 0 ? lamp_k : 1;  lamp_k = 0;                 // lamp_k before a call: size (1 = standard)
  col(0x000000, 1);  gfx_circle(px(x), py(y), ps(6 * k), 1, 1);
  col(on ? c : shade(c, 0.28), 1);  gfx_circle(px(x), py(y), ps(4.6 * k), 1, 1);
  on ? ( col(c, 0.28);  gfx_circle(px(x), py(y), ps(9 * k), 1, 1);  col(0xFFFFFF, 0.55);  gfx_circle(px(x - 1.5 * k), py(y - 1.5 * k), ps(1.4 * k), 1, 1); );
);
// ---------- LED ladders ----------
// one LED: a small rounded block, lit or dim
function led(x, y, w, h, c, on) (
  col(0x000000, 1);  u_rect(x - 1, y - 1, w + 2, h + 2);
  col(on ? c : shade(c, 0.22), 1);  u_rect(x, y, w, h);
  on ? ( col(0xFFFFFF, 0.3);  u_rect(x + 1, y + 1, w - 2, 1); );
);
// level ladder, house: -42 .. +3 dBFS in 3 dB steps (16 LEDs), green / yellow from -6 / red from 0;
// a held peak LED (1.2 s, then 0.6 dB a frame); slot = which hold (in GUI memory)
function ladder(x, y, v, slot) local(j, d, c, pk) (
  now_t = time_precise();
  v > VUS[slot] ? ( VUS[slot] = v;  VUS[slot + 1] = now_t; ) :
    now_t - VUS[slot + 1] > 1.2 ? VUS[slot] = max(v, VUS[slot] - 0.6);
  pk = VUS[slot];
  j = 0;
  loop(16,
    d = -42 + j * 3;  c = d >= 0 ? 0xFF3A2A : d >= -6 ? 0xFFC81E : 0x3CE05A;
    led(x + j * 11, y, 8, 12, c, v >= d || (pk >= d && pk < d + 3));
    j += 1;
  );
);

function vu(x, y, w, h, val, grm, lbl, slot) local(cx, cyp, R, j, d, t, a, xx, yy, n, lin, sp, ti, to, tl, nl)
(
  vg_spill(px(x - 3), py(y - 3), ps(w + 6), ps(h + 6), 1);              // backlit (gfx-glow)
  col(0x2A2F2B, 1);  u_rect(x - 3, y - 3, w + 6, h + 6);
  vg_glow(px(x), py(y), ps(w), ps(h), 1);
  cx = x + w * 0.5;
  h < 80 ? ( cyp = y + h + 90;  R = h + 78;  sp = 0.42;  ti = R - 17;  to = R - 9;  tl = R + 1;  nl = R - 11; )   // short face: flat arc, numbers above the ticks
         : ( cyp = y + h + 34;  R = h + 14;  sp = 0.78;  ti = R - 10;  to = R;  tl = R - 20;  nl = R - 2; );
  // scale: angle from -sp to +sp rad
  j = 0;
  loop(grm ? 5 : 10,
    grm ? ( d = j == 0 ? 0 : j == 1 ? 3 : j == 2 ? 6 : j == 3 ? 10 : 20;  t = 1 - sqrt(d / 20); ) :
          ( d = j == 0 ? -20 : j == 1 ? -10 : j == 2 ? -7 : j == 3 ? -5 : j == 4 ? -3 : j == 5 ? -1 : j == 6 ? 0 : j == 7 ? 1 : j == 8 ? 2 : 3;
            lin = 10 ^ (d / 20);  t = (lin - 0.1) / (1.4125 - 0.1); );
    a = -sp + t * 2 * sp;
    col(!grm && d > 0 ? 0xC0302A : 0x1E1E1A, 1);
    gfx_line(px(cx + sin(a) * ti), py(cyp - cos(a) * ti), px(cx + sin(a) * to), py(cyp - cos(a) * to), 1);
    gfx_setfont(5);
    grm ? sprintf(#vl, "%d", d) : sprintf(#vl, d > 0 ? "+%d" : "%d", d);
    (grm || j == 0 || j == 1 || (j == 3 && h >= 80) || j == 6 || j == 9) ? text_c(px(cx + sin(a) * tl), py(cyp - cos(a) * tl), #vl);
    j += 1;
  );
  !grm ? ( col(0xC0302A, 1);  n = 0;                                   // the red arc above 0 VU
    loop(20, t = (1 + n / 20 * 0.4125 - 0.1) / 1.3125;  a = -sp + t * 2 * sp;  gfx_rect(px(cx + sin(a) * R) - 1, py(cyp - cos(a) * R) - 1, ps(2), ps(2), 1);  n += 1; ); );
  gfx_setfont(6);  col(0x1E1E1A, 1);  text_c(px(cx), py(y + h - 14), lbl);
  // the needle (spring ballistics, ~300 ms)
  grm ? t = 1 - sqrt(min(20, max(0, -val)) / 20) :
        ( lin = 10 ^ (max(-30, min(4, val)) / 20);  t = max(-0.04, min(1.04, (lin - 0.1) / 1.3125)); );
  VUS[slot * 2 + 1] += ((t - VUS[slot * 2]) * 0.24 - VUS[slot * 2 + 1] * 0.5);
  VUS[slot * 2] += VUS[slot * 2 + 1];
  a = -sp + max(-0.06, min(1.06, VUS[slot * 2])) * 2 * sp;
  gfx_x = 0;  col(0x111111, 1);
  xx = cx + sin(a) * nl;  yy = cyp - cos(a) * nl;
  n = (cyp - (y + h - 4)) / cos(a);                                   // the needle starts where it leaves the face's foot
  gfx_line(px(cx + sin(a) * n), py(cyp - cos(a) * n), px(xx), py(yy), 1);
  col(0x2A2F2B, 1);  u_rect(x, y + h - 4, w, 4);
);


PRESET_MENU = "Init|Vocal Glue|Drum Bus Control|Gentle Master Bus|Acoustic Levelling|Bass Anchor|Heavy Squash|Broadcast Voice|Dynamic Limiter|Drum Crunch|Piano Glue|Subtle Mix Polish|Drum Bus Punch|Mix Bus Glue";
// ---------- house preset bar: [PRESETS][<][>][LCD] ----------
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function lcd(x, y, w, h, str) local(tw, th, gy) (
  col(0x2A2B2D, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x000000, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  gfx_setfont(8);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xD8DCD2, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xD8DCD2, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xD8DCD2, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1A1A, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- frame setup ----------
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1080 * g_ret), gfx_h / (464 * g_ret))), 0.5);
ui_tf = sc < (gfx_ext_retina > 1 ? gfx_ext_retina : 1) ? min(sqrt((gfx_ext_retina > 1 ? gfx_ext_retina : 1) / sc), 1.15) : 1;   // text shrinks half as fast as the panel below M (JG, 30 Oct 2026; at most 15 % bigger)
ox = (gfx_w - 1080 * sc) * 0.5;
oy = (gfx_h - 464 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
kcol = 0;  klog = 0;

// fonts: half way between the Stable sizes and the 28 Oct width-fitted ones (JG: first "small again", then "much
// too large"): knob labels 15, keys 14, section titles 16.5, scale figures 12.5, small print 12
gfx_setfont(1, "Trebuchet MS", ps(30), 'b');
gfx_setfont(10, "Trebuchet MS", (ps(13)) * max(ui_tf, 1), 'b');
gfx_setfont(2, "Trebuchet MS", (ps(14)) * max(ui_tf, 1), 'b');
gfx_setfont(3, "Trebuchet MS", (ps(14)) * max(ui_tf, 1), 'b');
gfx_setfont(4, "Trebuchet MS", (ps(16.5)) * max(ui_tf, 1), 'b');
gfx_setfont(5, "Trebuchet MS", (ps(12.5)) * max(ui_tf, 1), 'b');
gfx_setfont(6, "Trebuchet MS", (ps(15)) * max(ui_tf, 1), 'b');
gfx_setfont(7, "Trebuchet MS", (ps(12)) * max(ui_tf, 1), 'b');
gfx_setfont(8, "Courier New", ps(19.7), 'b');

// ---------- the faceplates: two 1U units stacked (JG, 28 Oct 2026) ----------
// unit 1 (0 - 216): ACC24 header band, COMPRESSOR, CHARACTER; unit 2 (224 - 440): its own band, LIMITER, OUTPUT
col(0x050505, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(C_FACE, 1);  u_rect(0, 0, 1080, 228);  u_rect(0, 236, 1080, 228);
!grain_ok ? (
  g_j = 0;  loop(1600, VUS[100 + g_j * 3] = rand(1080);  VUS[101 + g_j * 3] = rand(464);  VUS[102 + g_j * 3] = rand(1) < 0.5;  g_j += 1; );
  grain_ok = 1;
);
g_j = 0;
loop(1600,
  g_y = VUS[101 + g_j * 3];
  (g_y > 64 && g_y < 228) || g_y > 284 ? (
    col(VUS[102 + g_j * 3] ? 0xFFFFFF : 0x000000, VUS[102 + g_j * 3] ? 0.035 : 0.25);
    gfx_rect(px(VUS[100 + g_j * 3]), py(g_y), max(1, ps(1)), max(1, ps(1)), 1);
  );
  g_j += 1;
);
g_u = 0;
loop(2,
  g_t = g_u * 236;  g_hb = g_u ? 48 : 64;            // tall bands: room round the green rules (JG)
  col(C_HEAD, 1);  u_rect(0, g_t, 1080, g_hb);
  col(C_GRN, 1);  u_rect(0, g_t + g_hb - 3, 1080, 3);                 // the green rule under each top bar
  col(0x0B0C0D, 1);  u_rect(0, g_t + g_hb, 1080, 1);
  col(C_GRN, 1);  u_rect(16, g_t + 12, 4, g_hb - 27);   // a green tab beside each unit's name
  col(0xFFFFFF, 0.06);  u_rect(0, g_t, 1080, 1);                       // light from above on each unit's top edge
  col(0x000000, 0.55);  u_rect(0, g_t + 225, 1080, 3);  u_rect(1077, g_t, 3, 228);
  rivet(9, g_t + 9);  rivet(1071, g_t + 9);  rivet(9, g_t + 219);  rivet(1071, g_t + 219);
  g_u += 1;
);
gfx_setfont(1);  col(C_LINE, 1);  text_l(px(28), py(25), "ACC24"); ver_tag("v3", 16, 0, 0);
gfx_setfont(10);  col(C_GRNL, 1);  text_l(px(30), py(45), "AUTO COMPRESSOR");
gfx_setfont(4);  col(C_LINE, 1);  text_l(px(28), py(258), "ACC24");
gfx_setfont(10);  col(C_GRNL, 1);  text_l(px(92), py(259), "PEAK LIMITER / OUTPUT");
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(300, 14, 34, 250, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > 14 ? 1 : pb_k; );
by_key3(880 + ox / sc, 17 + oy / sc, 17, 16);                  // the house BYPASS key (by_key takes design units from 0, 0)

// ---------- COMPRESSOR ----------
oy += 12 * sc;                                               // unit 1's sections sit 12 lower (taller top bar)
box(16, 64, 856, 142, "COMPRESSOR", 0, 0);
klab_y = 176;
smark(76, 126, 28, 0, "-20");  smark(76, 126, 28, 0.25, "-10");  smark(76, 126, 28, 0.5, "0");  smark(76, 126, 28, 0.75, "+10");
smark(76, 126, 28, 1, "+20");
kn(76, 126, 28, 2, -20, 20, 0, "THRESHOLD", 1);
smark(182, 126, 22, 0, "1");  smark(182, 126, 22, lt(2, 1, 21), "2");  smark(182, 126, 22, lt(4, 1, 21), "4");
smark(182, 126, 22, lt(10, 1, 21), "10");  smark(182, 126, 22, 1, "INF");
klog = 1;  kn(182, 126, 22, 3, 1, 21, 2, "RATIO", 3);
smark(278, 126, 20, 0, ".5");  smark(278, 126, 20, 0.5, "5");  smark(278, 126, 20, 1, "50");
smark(278, 126, 20, 0.25, "");  smark(278, 126, 20, 0.75, "");
klog = 1;  kn(278, 126, 20, 5, 0.5, 50, 10, "ATTACK", 4);
smark(366, 126, 20, 0, ".05");  smark(366, 126, 20, 0.5, ".5");  smark(366, 126, 20, 1, "5");
smark(366, 126, 20, 0.25, "");  smark(366, 126, 20, 0.75, "");
klog = 1;  kn(366, 126, 20, 7, 50, 5000, 300, "RELEASE", 5);
smark(460, 126, 22, 0, "0");  smark(460, 126, 22, 0.25, "5");  smark(460, 126, 22, 0.5, "10");  smark(460, 126, 22, 0.75, "15");
smark(460, 126, 22, 1, "20");
kn(460, 126, 22, 10, 0, 20, 0, "MAKE-UP", 2);
gfx_setfont(7);  col(C_INK2, 1);
text_c(px(76), py(192), "dBu");  text_c(px(278), py(192), "ms");  text_c(px(366), py(192), "s");  text_c(px(460), py(192), "dB");
// AUTO (one key for both): ATTACK and RELEASE are greyed while AUTO runs the times
a_auto >= 0.5 ? ( col(C_FACE, 0.6);  gfx_circle(px(278), py(126), ps(21), 1, 1);  gfx_circle(px(366), py(126), ps(21), 1, 1); );
wk_key(540, 88, 76, 30, a_auto >= 0.5, "AUTO") ? ( slider(4) = a_auto >= 0.5 ? 0 : 1;  param_touched(4); );
// the input meter: eight round LEDs, dB about 0 VU (= -18 dBFS), VU-like ballistics
g_iv = in_disp > 0 ? 10 * log10(in_disp) + 18 : -60;
i_s = g_iv > i_s ? i_s + (g_iv - i_s) * 0.5 : i_s + (g_iv - i_s) * 0.12;
gfx_setfont(7);
g_j = 0;
loop(8,
  g_d = -20 + g_j * 5;  g_c = g_d < -10 ? C_LBLU : g_d < 0 ? 0x3CE05A : g_d == 0 ? 0xFFC81E : g_d == 5 ? C_LORG : 0xFF3A2A;
  g_d > 0 ? sprintf(#ml, "+%d", g_d) : sprintf(#ml, "%d", g_d);
  col(C_INK, 1);  text_c(px(660 + g_j * 26), py(104), #ml);
  lamp_k = 1.35;  lamp(660 + g_j * 26, 124, g_c, i_s >= g_d - 0.01);
  g_j += 1;
);
gfx_setfont(7);  col(C_INK2, 1);  text_c(px(751), py(146), "INPUT LEVEL  dB");
c_in < 0.5 ? ( col(C_FACE, 0.55);  u_rect(24, 76, 840, 124); );
lk_key(542, 150, 72, 30, c_in >= 0.5, LK_AMB, "IN") ? ( slider(1) = c_in >= 0.5 ? 0 : 1;  param_touched(1); );

// ---------- CHARACTER ----------
box(888, 64, 176, 142, "CHARACTER", 0, 0);
klab_y = 176;
smark(948, 126, 28, 0, "");  smark(948, 126, 28, 0.25, "");  smark(948, 126, 28, 0.5, "0");  smark(948, 126, 28, 0.75, "");
smark(948, 126, 28, 1, "");
gfx_setfont(5);  col(C_INK, 1);  text_c(px(916), py(169), "PUNCH");  text_c(px(980), py(169), "GLUE");   // set lower: room under the dial (JG)
kn(948, 126, 28, 16, -100, 100, 0, "", 8);
sq_key(1012, 112, thick >= 0.5, "THICK") ? ( slider(14) = thick >= 0.5 ? 0 : 1;  param_touched(14); );

// ---------- LIMITER ----------
oy += 12 * sc;                                               // unit 2's sections: 24 lower in all
box(16, 272, 296, 158, "LIMITER", 0, 0);
klab_y = 392;
smark(100, 336, 28, 0, "-10");  smark(100, 336, 28, 0.4, "0");  smark(100, 336, 28, 0.8, "+10");  smark(100, 336, 28, 1, "+15");
kn(100, 336, 28, 8, -10, 15, 10, "LIMIT", 1);
gfx_setfont(7);  col(C_INK2, 1);  text_c(px(100), py(408), "dBu");
over_disp ? ( over_t = time_precise();  over_disp = 0; );
lamp(206, 336, 0xFF3A2A, time_precise() - over_t < 0.25);
gfx_setfont(7);  col(C_INK, 1);  text_l(px(218), py(336), "OVER");

// ---------- OUTPUT ----------
box(328, 272, 736, 158, "OUTPUT", 0, 0);
// the meter: a row of eight round LEDs, OUTPUT LEVEL (dB about 0 VU = -18 dBFS) or GAIN REDUCTION;
// VU-like ballistics (about 300 ms), the GR reading falls back at the same pace
g_gr = gr_disp;  gr_disp = 0;
g_vu = vu_disp > 0 ? 10 * log10(vu_disp) + 18 : -60;
g_m = vu_mode >= 0.5 ? (c_in >= 0.5 ? -g_gr : 0) : g_vu;
m_s = g_m > m_s ? m_s + (g_m - m_s) * 0.5 : m_s + (g_m - m_s) * 0.12;
gfx_setfont(7);
g_j = 0;
loop(8,
  vu_mode >= 0.5 ? ( g_d = g_j == 0 ? 1 : g_j == 1 ? 2 : g_j == 2 ? 3 : g_j == 3 ? 4 : g_j == 4 ? 6 : g_j == 5 ? 8 : g_j == 6 ? 10 : 15;
                     g_c = g_j < 3 ? 0x3CE05A : g_j < 5 ? 0xFFC81E : 0xFF3A2A;  sprintf(#ml, "%d", g_d); )
                 : ( g_d = -20 + g_j * 5;  g_c = g_d < -10 ? C_LBLU : g_d < 0 ? 0x3CE05A : g_d == 0 ? 0xFFC81E : g_d == 5 ? C_LORG : 0xFF3A2A;
                     g_d > 0 ? sprintf(#ml, "+%d", g_d) : sprintf(#ml, "%d", g_d); );
  col(C_INK, 1);  text_c(px(372 + g_j * 26), py(300), #ml);
  lamp_k = 1.35;  lamp(372 + g_j * 26, 320, g_c, m_s >= g_d - 0.01);
  g_j += 1;
);
gfx_setfont(7);  col(C_INK2, 1);  text_c(px(463), py(342), vu_mode >= 0.5 ? "GAIN REDUCTION  dB" : "OUTPUT LEVEL  dB");
wk_key(372, 360, 80, 26, vu_mode < 0.5, "OUT") ? ( slider(13) = 0;  param_touched(13); );
wk_key(460, 360, 80, 26, vu_mode >= 0.5, "GR") ? ( slider(13) = 1;  param_touched(13); );
sq_key(606, 340, drift >= 19, "DRIFT") ? ( slider(12) = drift >= 19 ? 5 : 33;  param_touched(12); );
klab_y = 392;
smark(780, 336, 28, 0, "DRY");  smark(780, 336, 28, 0.5, "50");  smark(780, 336, 28, 1, "WET");
kn(780, 336, 28, 15, 0, 100, 100, "MIX", 7);
smark(950, 336, 28, 0, "-18");  smark(950, 336, 28, 0.75, "0");  smark(950, 336, 28, 1, "+6");  smark(950, 336, 28, 0.375, "-9");
kn(950, 336, 28, 11, -18, 6, 0, "LEVEL", 2);

oy -= 24 * sc;
// ---------- S / M / L / ? (size picker and credits) ----------
g_j = 0;
loop(4,
  g_x = 998 + g_j * 14;  g_on = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(0x000000, 1);  u_rect(g_x, 23, 13, 18);
  col(g_on ? C_LCDTX : 0x2E2F32, 1);  u_rect(g_x + 1, 24, 11, 16);
  gfx_setfont(7);  col(g_on ? C_LCDBG : 0xC9C1A6, 1);  text_c(px(g_x + 6.5), py(32), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(23) && mouse_y < py(41) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
sz_help && click && !sz_new ? sz_help = 0;
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
  gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
  g_cw = max(g_tw + ps(40), ps(380));  g_ch = ps(130);
  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(0xE0603A, 1);    gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(102);  gfx_drawstr("Click anywhere to close.");
);

!lmb ? drag_idx = 0;
mouse_wheel = 0;
last_lmb = lmb;
