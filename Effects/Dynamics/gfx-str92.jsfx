desc:STR92 [vocal strip] (GFX)
//tags: vocal channel strip preamp opto fet de-esser eq tape saturation flanger slapback reverb ducking
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-clip, gfx-ui, gfx-panel, gfx-dyn and gfx-s92 (.jsfx-inc) in the same folder.
//
// STR92 (Series 92): the first of the GFX vocal strips (STR57, STR74, STR81 to follow: the same core chain, each
// series with its own flanger, slap and space). A vocal channel strip with two models in one unit. The MODEL keys (SMOKE / STORM, in the header) set
// the voicing of every stage and the faceplate together; a change ducks the output (12 ms), swaps at the silent point
// and fades back in. At Init the two models are level matched.
//   SMOKE - late-90s neo-soul: dark, warm, mid-forward and intimate; a thick valve pre-amp, an opto that leans in,
//           low-mid warmth, a soft upper-mid scoop and a rolled-off top, tape, a small dark room. The voice sits
//           inside the band.
//   STORM - mid-80s power ballad: bright, forward, big and live; a cleaner pre-amp, a lighter opto, presence and an
//           air shelf, valve / console colour, a big bright hall with a long pre-delay.
// The chain, in order:
//   PREAMP     transformer + valve: DRIVE (level matched: more DRIVE, more colour). The low band saturates first
//              (the transformer), then a biased soft-knee valve stage (house drive standard: anti-aliased clipper,
//              drive-tracking pre-filter and knee). TRIM and GUARD (the house input stage) sit here too.
//   LOW END    the house trick: a high-pass (20 - 80 Hz, 20 = off), then a low shelf at 150 Hz pulling 0 to -3 dB.
//   EQ         a four-band parametric (after LOW END): LF (shelf or bell, 30 - 450 Hz, +/-15 dB), LMF (bell,
//              120 Hz - 2 kHz, gain, Q), HMF (bell, 600 Hz - 8 kHz, gain, Q), HF (shelf or bell, 1.5 - 16 kHz).
//              The model voices its curves: SMOKE gentle and broad, console-ish, with a softer HF shelf (sweet, never
//              harsh); STORM proportional Q (narrower the harder it is pushed), firmer shelves, a crisper HF / air
//              shelf. A SHELF / BELL change glides the band out and back in. The ORDER key puts the EQ before or after
//              the dynamics (OPTO, DE-ESS, FET); the panel modules swap places.
//   OPTO       slow optical levelling (always before the FET): PEAK REDUCTION and GAIN; program dependent, with a
//              smooth two-stage release (fast for the first part, slow after long passages). SMOKE leans on it more.
//   DE-ESS     split band: only the sibilant band is turned down, by no more than RANGE: the cut starts at FREQ
//              (4 - 10 kHz; an 8th-order split at 1.2 x FREQ, so the presence below about 0.8 x FREQ is left alone;
//              the split's all-pass stays in the path when DE-ESS is out, so switching it never combs)
//              and is full an octave above. It listens for sibilance, not brightness: THRESH sets how loud the band
//              must be, and it only cuts while the band stands out from the rest of the signal (within 6 dB of the
//              whole: full cut from 2 dB), so steady bright material - a full mix, cymbals, reverb - is left alone
//              while "s" sounds get the full RANGE. Stereo linked. LISTEN plays the band; the lamp lights while it
//              works.
//   FET        a fast peak catcher (always last of the dynamics): AMOUNT (into a fixed threshold), RATIO 4 / 8 / 12 /
//              20, ATTACK, RELEASE; the FET's gentle colour (mostly 2nd harmonic) grows with the gain it takes away.
//   SATURATION SMOKE: tape (soft compression, a slight low bump, a gentle top roll-off). STORM: valve / console
//              (biased soft knee, a little low-mid weight). 0 = out.
//   FLANGER    (its own IN key; the GFX Flanger's engine) slow and subtle by default: RATE, DEPTH, FEEDBACK (+/-),
//              MIX, STEREO. SMOKE runs its PEDAL mode (the darker bucket-brigade loop), STORM its RACK mode (clean).
//   SLAPBACK   (its own IN key; the MLT92 delay) 60 - 180 ms (110 ms) or synced (1/32 - 1/8 T), TONE darkens it,
//              FEEDBACK, MIX. Flanger and slapback can run together in either model.
//   SPACE      (the MLT92 reverb) one reverb voiced per model: SMOKE its ROOM program, small and dark; STORM its HALL
//              program, big and bright, with a long pre-delay and tail. SIZE, DECAY, PRE-DELAY and TONE are read per
//              model (the LCD and the values shown follow it), MIX (100 % = the return as loud as the voice), and
//              DUCK: the space pulls back while the voice sings (up to 15 dB) and blooms in the gaps.
//   OUTPUT     OUTPUT level, then the house output stage with CLIP always on (a character unit, as CH57 / CH92).
// DRIFT (0 - 100 %, 50 % = standard, 0 = none): the pre-amp's and the saturation's heat wander (an uneven supply,
//   the two sides never quite match), the flanger's sweep rate, width and centre wander (its own drift), and the slap
//   time wanders slowly (tape, +/-1.5 %).
// Mono or stereo tracks; the dynamics are stereo linked. Every IN key, the model, the order and the presets change
// without clicks. No latency (0 samples).
// PRESETS (12 + Reset all to defaults) cover both models; TRIM, GUARD and DRIFT stay when a preset loads. Init is flat:
// every dial at 0 (HIGH-PASS off) and every section out (new instances open on it).

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-clip.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-s92.jsfx-inc

slider1:0<0,1,1{Smoke,Storm}>-Model
slider2:0<0,1,1{EQ after dynamics,EQ before dynamics}>-Order
slider3:0<-24,12,0.1>-Input trim (dB)
slider4:1<0,1,1{Off,On}>-Input guard
slider5:0<0,1,1{Out,In}>-Preamp in
slider6:0<0,100,1>-Drive (%)
slider7:20<20,80,1>-High-pass (Hz, 20 = off)
slider8:0<-3,0,0.1>-Low shelf 150 Hz (dB)
slider9:240<120,2000,1>-EQ LMF freq (Hz)
slider10:0<-15,15,0.1>-EQ LMF gain (dB)
slider11:0.8<0.4,4,0.01>-EQ LMF Q
slider12:0<0,1,1{Out,In}>-Opto in
slider13:0<0,100,1>-Opto peak reduction (%)
slider14:0<-10,10,0.1>-Opto gain (dB)
slider15:0<0,1,1{Out,In}>-De-ess in
slider16:4500<4000,10000,10>-De-ess freq (Hz)
slider17:0<-50,0,0.1>-De-ess threshold (dB)
slider18:0<0,12,0.1>-De-ess range (dB)
slider19:0<0,1,1{Off,On}>-De-ess listen
slider20:0<0,1,1{Out,In}>-FET in
slider21:0<0,24,0.1>-FET amount (dB)
slider22:0<0,3,1{4,8,12,20}>-FET ratio
slider23:250<20,800,1>-FET attack (us)
slider24:120<50,1100,1>-FET release (ms)
slider25:0<0,1,1{Out,In}>-EQ in
slider26:0<-15,15,0.1>-EQ LF gain (dB)
slider27:100<30,450,1>-EQ LF freq (Hz)
slider28:0<0,1,1{Shelf,Bell}>-EQ LF shape
slider29:0<0,100,1>-Saturation (%)
slider30:0<0,1,1{Out,In}>-Flanger in
slider31:0.15<0.02,3,0.01>-Flanger rate (Hz)
slider32:0<0,100,1>-Flanger depth (%)
slider33:0<-90,90,1>-Flanger feedback (%)
slider34:0<0,100,1>-Flanger mix (%)
slider35:1<0,1,1{Off,On}>-Flanger stereo
slider36:0<0,1,1{Out,In}>-Slapback in
slider37:110<60,180,1>-Slap time (ms)
slider38:0<0,4,1{Free,1/32,1/16 T,1/16,1/8 T}>-Slap sync
slider39:0<0,100,1>-Slap tone (%)
slider40:0<0,50,1>-Slap feedback (%)
slider41:0<0,100,1>-Slap mix (%)
slider42:0<0,1,1{Out,In}>-Space in
slider43:0<0,100,1>-Space size (%)
slider44:0<0,100,1>-Space decay (%)
slider45:0<0,100,1>-Space pre-delay (%)
slider46:0<0,100,1>-Space tone (%)
slider47:0<0,100,1>-Space mix (%)
slider48:0<0,100,1>-Space duck (%)
slider49:50<0,100,1>-Drift (%)
slider50:0<-12,12,0.1>-Output (dB)
slider51:0<-15,15,0.1>-EQ HMF gain (dB)
slider52:2800<600,8000,1>-EQ HMF freq (Hz)
slider53:0.8<0.4,4,0.01>-EQ HMF Q
slider54:0<-15,15,0.1>-EQ HF gain (dB)
slider55:7000<1500,16000,10>-EQ HF freq (Hz)
slider56:0<0,1,1{Shelf,Bell}>-EQ HF shape
slider57:prs_sel=0<0,12,1{No preset,Init,Smoke Intimate Lead,Smoke Velvet Flange,Smoke Stacked Harmonies,Smoke Late-Night Tape,Smoke Whisper Close,Storm Power Ballad,Storm Slapback Lead,Storm Arena Chorus,Storm Midnight Verse,Twilight Hybrid,Storm Clean Lead}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-str92";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;                   // house drive standard: ADAA, pre-filter, knee tracking (character)

// ================= memory =================
function vx_alloc(n) local(p) ( p = vx_mem; vx_mem += n; memset(p, 0, n); p; );
function vx_p2(n) local(m) ( m = 16; while (m < n) ( m *= 2; ); m; );
function vx_db(d) ( exp(0.11512925465 * d); );
function vx_kt(t) ( 1 - exp(-1 / (max(t, 0.000001) * srate)); );           // a time constant (s) as a one-pole coefficient
function vx_kf(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * srate) / srate); );   // a one-pole low-pass coefficient for f Hz

// a per-block glide that snaps when close (instance: v)
function gl(t) instance(v) ( v += (t - v) * vx_gb; abs(t - v) < 0.0001 * max(abs(t), 0.01) ? v = t; v; );
function gl_set(t) instance(v) ( v = t; );

// ================= PREAMP: transformer (lows first) + valve (a biased gfx-clip KNEE clipper) =================
// one side: x in, kk = the drive into the valve; the curve's rest value and slope are taken out (unity small-signal
// gain); the anti-aliased reading's half-sample lag is made up, so it mixes with the dry signal without a comb
function pre_run(x, kk) instance(lo, c1) local(u, y, c) (
  lo += (x - lo) * pre_lc;
  x += pre_xa * (lo / sqrt(1 + sqr(pre_xd * lo)) - lo);    // the core: the lows saturate first
  u = this.pf.clp_pf_run(x) * kk + pre_b;
  y = this.k.clp_run(u); c = this.k.clp_crv(u);
  y += 0.5 * (c - c1); c1 = c;
  (y - pre_cb) / (kk * pre_sl);
);
// SATURATION, one side: SMOKE tape (a SOFT clipper, symmetric), STORM valve / console (a biased KNEE clipper)
function sat_run(x, kk) instance(c1) local(u, y, c) (
  u = this.pf.clp_pf_run(x) * kk + sat_b;
  y = this.k.clp_run(u); c = this.k.clp_crv(u);
  y += 0.5 * (c - c1); c1 = c;
  (y - sat_cb) / (kk * sat_sl);
);

// ================= DE-ESS: an 8th-order Linkwitz-Riley split (instance: one side) =================
// the band above the split (two cascaded 4th-order Butterworth high-passes) and the split's own 4th-order all-pass
// (its low + high sum): out = all-pass(x) + g x band, so the response is exactly 1 + g w^8 / (1 + w^8) - flat below
// the split, the full cut above it, the same phase on both sides, no comb anywhere
function dsx_ap(f, q) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al;
  b0 = (1 - al) / n; b1 = -2 * cw / n; b2 = 1; a1 = b1; a2 = b0;
);
function dsx_set(fc) (
  this.h1.bq_set(1, fc, 0.5411961, 0); this.h2.bq_set(1, fc, 1.3065630, 0);
  this.h3.bq_set(1, fc, 0.5411961, 0); this.h4.bq_set(1, fc, 1.3065630, 0);
  this.p1.dsx_ap(fc, 0.5411961); this.p2.dsx_ap(fc, 1.3065630);
);
// one sample: returns the all-passed signal; the band is left in .hi
function dsx_run(x) instance(hi) (
  hi = this.h4.bq_run(this.h3.bq_run(this.h2.bq_run(this.h1.bq_run(x))));
  this.p2.bq_run(this.p1.bq_run(x));
);
// the all-pass alone (DE-ESS out: the path keeps the same phase, so switching never combs)
function dsx_apr(x) ( this.p2.bq_run(this.p1.bq_run(x)); );

// =====================================================================================================================
// SERIES 92 MOD + SPACE (prefix t9_): the parts that make this strip the Series 92 one. The core chain above (vx_) is
// shared by the vocal-strip family; each series brings its own flanger / slap / space here.
// =====================================================================================================================
// ---------- FLANGER: ported from gfx-flanger.jsfx (GFX Flanger) ----------
// Its PEDAL mode for SMOKE (the bucket-brigade pedal: 0.3 - 6 ms, a darker loop with the chips' faint hiss) and its
// RACK mode for STORM (the clean studio rack: 0.15 - 14 ms). Its triangle LFO, Hermite reads, the loop's soft limiter,
// the regen level compensation and the mix law, its rate / width / manual drift. RATE = its free rate, DEPTH = WIDTH,
// FEEDBACK = REGEN, MIX = MIX, STEREO = SPREAD 90 deg (off: 0). MANUAL is fixed per model (SMOKE 40 %, STORM 45 %).
function t9f_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function t9f_sat(x) local(a) ( a = abs(x); a < 0.7 ? x : sign(x) * (0.7 + 0.3 * t9f_tanh((a - 0.7) / 0.3)); );
function t9f_rd(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = t9f_wp - d; rp < 0 ? rp += T9F_N;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + T9F_N - 1) & T9F_M]; x0 = buf[i & T9F_M]; x1 = buf[(i + 1) & T9F_M]; x2 = buf[(i + 2) & T9F_M];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f + 0.5 * (x1 - xm1)) * f + x0);
);
// (its del_ms, with the MANUAL point c computed once per sample for both sides: the same numbers)
function t9f_del(c, wid, u) local(lo, hi, d) (
  lo = t9f_mode ? 0.15 : 0.3; hi = t9f_mode ? 14 : 6;
  d = c * 2 ^ (wid * u * (t9f_mode ? 3.2 : 2.2));
  min(max(d, lo * 0.5), hi * 1.3);
);
function t9f_man_ms(man) local(lo, hi) ( lo = t9f_mode ? 0.15 : 0.3; hi = t9f_mode ? 14 : 6; lo * (hi / lo) ^ man; );
function t9f_tri(p) ( p < 0.25 ? 4 * p : p < 0.75 ? 2 - 4 * p : 4 * p - 4; );
function t9f_set() (
  t9f_on = slider30 >= 0.5;
  t9f_mode = eng;                                          // SMOKE PEDAL, STORM RACK
  t9f_rate = min(max(slider31, 0.02), 3);
  t9f_man_t = eng ? 0.45 : 0.40; t9f_wid_t = slider32 / 100; t9f_fb_t = slider33 / 100; t9f_mix_t = slider34 / 100;
  t9f_spr = slider35 >= 0.5 ? 0.25 : 0;
  t9f_rdr = 0.05 * dm_a; t9f_wdr = min(0.10 * dm_a, 1); t9f_mdr = 0.05 * dm_a; t9f_dspd = 0.25 * dm_s;   // its drift (5 / 10 / 5 %)
  t9f_lpc = 1 - exp(-2 * $pi * min(t9f_mode == 0 ? 6500 : 15000, srate * 0.45) / srate);
);
function t9f_init() (
  t9f_sm = 1 - exp(-1 / (0.03 * srate)); t9f_dsm = 1 - exp(-1 / (0.004 * srate));
  t9f_set(); t9f_man = t9f_man_t; t9f_wid = t9f_wid_t; t9f_fbs = t9f_fb_t; t9f_mix = t9f_mix_t;
  t9f_dl = t9f_dr = t9f_man_ms(t9f_man) * srate / 1000;
);
function t9f_run() local(vr, vw, vm, ul, ur, pr, mn, wi, wl, wr, fbc, m, st) (
  st = t9f_w <= 0.000001;                                  // (the strip's) starting from rest: no sweep-in from a stale delay
  t9f_w += (t9f_on - t9f_w) * xs_c;
  T9F_L[t9f_wp] = vx_l + t9f_fbs * t9f_w * t9f_fl; T9F_R[t9f_wp] = vx_r + t9f_fbs * t9f_w * t9f_fr;   // (regen fades with IN)
  t9f_w > 0.000001 || t9f_on ? (
    vr = t9f_dR.drift_tick(t9f_dspd / srate); vw = t9f_dW.drift_tick(t9f_dspd / srate); vm = t9f_dM.drift_tick(t9f_dspd / srate);
    t9f_man += (t9f_man_t - t9f_man) * t9f_sm; t9f_wid += (t9f_wid_t - t9f_wid) * t9f_sm;
    t9f_fbs += (t9f_fb_t - t9f_fbs) * t9f_sm; t9f_mix += (t9f_mix_t - t9f_mix) * t9f_sm;
    t9f_ph += t9f_rate * (1 + t9f_rdr * vr) / srate; t9f_ph -= floor(t9f_ph);
    ul = t9f_tri(t9f_ph); pr = t9f_ph + t9f_spr; pr -= floor(pr); ur = t9f_tri(pr);
    mn = min(max(t9f_man + t9f_mdr * 0.25 * vm, 0), 1);
    wi = t9f_wid * (1 - t9f_wdr * (0.5 + 0.5 * vw));
    mn = t9f_man_ms(mn);
    t9f_dl += (t9f_del(mn, wi, ul) * srate / 1000 - t9f_dl) * (st ? 1 : t9f_dsm);
    t9f_dr += (t9f_del(mn, wi, ur) * srate / 1000 - t9f_dr) * (st ? 1 : t9f_dsm);
    wl = t9f_rd(T9F_L, max(t9f_dl, 1)); wr = t9f_rd(T9F_R, max(t9f_dr, 1));
    st ? ( t9f_lpl = wl; t9f_lpr = wr; );
    t9f_lpl += (wl - t9f_lpl) * t9f_lpc; t9f_lpr += (wr - t9f_lpr) * t9f_lpc;
    t9f_mode == 0 ? ( t9f_lpl += (rand(2) - 1) * 0.00002; t9f_lpr += (rand(2) - 1) * 0.00002; );
    t9f_fl = t9f_sat(t9f_lpl); t9f_fr = t9f_sat(t9f_lpr);
    fbc = t9f_fbs > 0 ? 1 / (1 + 1.2 * t9f_fbs * t9f_fbs) : 1 / (1 + 0.2 * t9f_fbs * t9f_fbs);
    m = t9f_mix * t9f_w;
    vx_l = (1 - m) * vx_l + m * t9f_lpl * fbc; vx_r = (1 - m) * vx_r + m * t9f_lpr * fbc;
    // (the strip's own) the mix law's level loss made up, so the IN key and MIX leave the loudness alone
    m = 1 / sqrt(sqr(1 - m) + sqr(m * fbc)); vx_l *= m; vx_r *= m;
  ) : ( t9f_fl = t9f_fr = 0; );
  t9f_wp = (t9f_wp + 1) & T9F_M;
);

// ---------- SLAPBACK: the DELAY block of gfx-mlt92.jsfx (GFX MLT92, Series 92) ----------
// A new TIME crossfades to its tap (30 ms); the loop is soft-limited and a little darker each pass (SMOKE: its ANALOG
// loop, 6.5 kHz, 16-bit word; STORM: its DIGITAL loop, 12 kHz). Added here: DRIFT wanders the tap slowly (+/-1.5 %,
// tape), TONE darkens the return (two one-poles, 1.5 - 7.4 kHz) with a 180 Hz low cut, the IN key fades the feed so
// the repeats ring out.
function t9_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );   // s92_th
function t9_qt(v) ( v >= 0 ? floor(v * 8192) * 0.0001220703125 : -floor(-v * 8192) * 0.0001220703125; );   // the 16-bit word
function t9d_rd(b, d) local(p, i, f, x0) (
  p = t9d_w - d + T9D_N; i = floor(p); f = p - i; x0 = b[i & T9D_M]; x0 + (b[(i + 1) & T9D_M] - x0) * f;
);
function t9d_set() local(k, ms) (
  t9d_on = slider36 >= 0.5;
  k = slider38 | 0;
  ms = k == 0 ? slider37 : (60000 / max(tempo, 20)) * (k == 1 ? 0.125 : k == 2 ? 1 / 6 : k == 3 ? 0.25 : 1 / 3);
  t9d_ms = min(max(ms, 40), 250);
  t9d_tdt = floor(t9d_ms * 0.001 * srate + 0.5);
  t9d_wv_t = t9d_ms * 0.001 * srate * 0.015 * dm_a * dr_sl.v;
  t9d_fb_t = slider40 / 100; t9d_lv_t = slider41 / 100;
  t9d_lc = vx_kf(1500 * 2 ^ (2.3 * slider39 / 100)); t9d_hc = vx_kf(180);
  t9d_kdl = vx_kf(eng ? 12000 : 6500);
);
function t9d_init() (
  t9d_xk = 1 / (0.03 * srate); t9d_sm = 1 - exp(-1 / (0.02 * srate)); t9d_wk = vx_kt(0.08);
  t9d_set(); t9d_dha = t9d_dhb = t9d_tdt; t9d_xs = 0; t9d_xf = 0; t9d_fb = t9d_fb_t; t9d_lv = t9d_lv_t;
);
function t9d_run() local(el, er, wl, wr) (
  t9d_fw += (t9d_on - t9d_fw) * xs_c;
  !t9d_idle ? (
    t9d_fb += (t9d_fb_t - t9d_fb) * t9d_sm; t9d_lv += (t9d_lv_t - t9d_lv) * t9d_sm; t9d_wv += (t9d_wv_t - t9d_wv) * t9d_wk;
    t9d_xs == 0 && t9d_tdt != t9d_dha ? ( t9d_dhb = t9d_tdt; t9d_xs = 1; t9d_xf = 0; );
    t9d_xs ? ( t9d_xf += t9d_xk; t9d_xf >= 1 ? ( t9d_xf = 0; t9d_xs = 0; t9d_dha = t9d_dhb; ); );
    el = t9d_rd(T9D_L, t9d_dha + t9d_wv); el += (t9d_rd(T9D_L, t9d_dhb + t9d_wv) - el) * t9d_xf;
    er = t9d_rd(T9D_R, t9d_dha + t9d_wv); er += (t9d_rd(T9D_R, t9d_dhb + t9d_wv) - er) * t9d_xf;
    t9d_ell += (el - t9d_ell) * t9d_kdl; t9d_elr += (er - t9d_elr) * t9d_kdl;
    wl = vx_l * t9d_fw + t9d_fb * t9d_ell; wr = vx_r * t9d_fw + t9d_fb * t9d_elr;
    wl = 2 * t9_th(0.5 * wl); wr = 2 * t9_th(0.5 * wr);
    !eng ? ( wl = t9_qt(wl); wr = t9_qt(wr); );
    T9D_L[t9d_w] = wl; T9D_R[t9d_w] = wr;
    t9d_w = (t9d_w + 1) & T9D_M;
    // TONE on the return
    t9d_s1 += (el - t9d_s1) * t9d_lc; t9d_s2 += (t9d_s1 - t9d_s2) * t9d_lc; t9d_h1 += (t9d_s2 - t9d_h1) * t9d_hc; el = t9d_s2 - t9d_h1;
    t9d_s3 += (er - t9d_s3) * t9d_lc; t9d_s4 += (t9d_s3 - t9d_s4) * t9d_lc; t9d_h2 += (t9d_s4 - t9d_h2) * t9d_hc; er = t9d_s4 - t9d_h2;
    vx_l += el * t9d_lv; vx_r += er * t9d_lv;
    t9d_pk = max(t9d_pk, abs(el) + abs(er));
  );
);
function t9d_clear() ( memset(T9D_L, 0, T9D_N); memset(T9D_R, 0, T9D_N); t9d_ell = t9d_elr = t9d_s1 = t9d_s2 = t9d_s3 = t9d_s4 = t9d_h1 = t9d_h2 = 0; );

// ---------- SPACE: the HALL / ROOM engine of gfx-mlt92.jsfx (GFX MLT92, Series 92) ----------
// Input diffusers into 8 modulated lines with an all-pass in each, an 8 x 8 Hadamard, a damping low-pass per line,
// its control-rate update (every 32 samples), its level calibration across SIZE and DECAY (the return equals the dry
// at 100 % on pink noise). SMOKE runs its ROOM program with its ANALOG constants (lusher line modulation, sparser
// diffusion, the 16-bit word in the loop); STORM runs its HALL program with its DIGITAL constants (denser, cleaner).
// SIZE, DECAY, TONE (damping) and PRE-DELAY are mapped per model; DUCK (on the return) belongs to the strip.
function t9r_hash(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453; v - floor(v); );
function t9r_dcomp(T, lo, hi) ( (2 / T) ^ (T < 2 ? lo : hi); );
function t9r_szc(z, lo, hi) ( 10 ^ ((z < 0.5 ? lo : hi) * (z - 0.5) / 20); );
function t9r_tables() local(i) (
  i = 0;
  loop(8,
    T9R_LN[i] = i == 0 ? 31.3 : i == 1 ? 37.9 : i == 2 ? 43.1 : i == 3 ? 47.7 : i == 4 ? 53.9 : i == 5 ? 61.3 : i == 6 ? 67.1 : 73.7;
    T9R_LN[8 + i] = i == 0 ? 9.1 : i == 1 ? 11.3 : i == 2 ? 13.7 : i == 3 ? 15.1 : i == 4 ? 17.9 : i == 5 ? 19.7 : i == 6 ? 22.3 : 25.1;
    T9R_APL[i] = i == 0 ? 3.1 : i == 1 ? 3.7 : i == 2 ? 4.3 : i == 3 ? 4.9 : i == 4 ? 2.3 : i == 5 ? 2.9 : i == 6 ? 5.3 : 5.9;
    T9R_APL[8 + i] = i == 0 ? 1.3 : i == 1 ? 1.7 : i == 2 ? 1.9 : i == 3 ? 2.3 : i == 4 ? 1.1 : i == 5 ? 1.5 : i == 6 ? 2.1 : 2.5;
    T9R_DBL[i] = i == 0 ? 1.7 : i == 1 ? 2.9 : i == 2 ? 4.3 : i == 3 ? 6.1 : i == 4 ? 1.9 : i == 5 ? 3.1 : i == 6 ? 4.7 : 6.7;
    T9R_DBL[8 + i] = i == 0 ? 0.9 : i == 1 ? 1.4 : i == 2 ? 2.1 : i == 3 ? 3.1 : i == 4 ? 1.0 : i == 5 ? 1.5 : i == 6 ? 2.3 : 3.4;
    T9R_ISG[i] = (i == 2 || i == 3 || i == 5 || i == 6) ? -1 : 1;
    T9R_LFR[i] = 0.29 + 0.093 * i; T9R_LFP[i] = t9r_hash(i + 41);
    i += 1;
  );
);
function t9r_diff(x, k0, n, g) local(j, b, d, y) (
  j = 0;
  loop(n,
    b = T9R_DB + (k0 + j) * T9R_ASZ;
    d = b[(t9r_aw - T9R_DLN[k0 + j]) & T9R_AM];
    y = d - g * x; b[t9r_aw] = x + g * y; x = y;
    j += 1;
  );
  x;
);
// the per-model constants (its ANALOG / DIGITAL sets), set at the silent point of a model change
function t9r_modset() (
  t9r_prg = eng ? 0 : 1;                                   // STORM HALL, SMOKE ROOM
  t9r_mdp = (eng ? 0.00012 : 0.00032) * srate;
  t9r_ndf = eng ? 4 : 2; t9r_dfg = eng ? 0.7 : 0.6; t9r_apg = eng ? 0.6 : 0.42;
  t9r_wgt = eng ? 1.243 : 0.623;                           // its measured returns: HALL DIGITAL, ROOM ANALOG
);
function t9r_clear() (
  memset(T9R_LB, 0, 8 * T9R_BSZ); memset(T9R_AB, 0, 8 * T9R_ASZ); memset(T9R_DB, 0, 8 * T9R_ASZ); memset(T9R_PB, 0, 2 * T9R_PSZ);
  memset(T9R_LPS, 0, 8); memset(T9R_O, 0, 8); t9r_dsnap = 1; t9r_rsf = 0;
);
// the control-rate update: the glides, the lines, the loss, the level
function t9r_ctl() local(i, d, sz, T, b, an, fc) (
  t9r_ts += (t9r_tt - t9r_ts) * t9r_tk; t9r_szs += (t9r_szt - t9r_szs) * t9r_tk; t9r_dps += (t9r_dpt - t9r_dps) * t9r_tk;
  T = t9r_ts;
  sz = (0.45 + 1.1 * t9r_szs) * 0.001 * srate;
  b = t9r_prg * 8;
  i = 0;
  loop(8,
    T9R_LFP[i] += T9R_LFR[i] * 32 / srate; T9R_LFP[i] >= 1 ? T9R_LFP[i] -= 1;
    d = T9R_LN[b + i] * sz + t9r_mdp * sin(2 * $pi * T9R_LFP[i]);
    d = min(max(d, 8), T9R_BSZ - 4);
    t9r_dsnap ? ( T9R_DLC[i] = d; T9R_DLD[i] = 0; ) : T9R_DLD[i] = (d - T9R_DLC[i]) / 32;
    an = T9R_APN[i] = min(max(floor(T9R_APL[b + i] * 0.001 * srate), 1), T9R_ASZ - 2);
    T9R_GN[i] = 10 ^ (-3 * (d + an) / (T * srate));
    T9R_DLN[i] = min(max(floor(T9R_DBL[b + i] * (0.6 + 0.8 * t9r_szs) * 0.001 * srate), 1), T9R_ASZ - 2);
    i += 1;
  );
  t9r_dsnap = 0;
  fc = 16000 * 0.09 ^ t9r_dps; t9r_kd = vx_kf(fc); t9r_fc = fc;
  t9r_wgs = t9r_prg == 0 ? t9r_wgt * t9r_dcomp(t9r_ts, 0.73, 0.5) * t9r_szc(t9r_szs, 6.62, 4.76)
                         : t9r_wgt * t9r_dcomp(t9r_ts, 0.57, 0.49) * t9r_szc(t9r_szs, 3.48, 4.9);
);
// the knobs, per model (per block)
function t9r_set() local(sz, dc, pd, tn) (
  t9r_on = slider42 >= 0.5;
  sz = slider43 / 100; dc = slider44 / 100; pd = slider45 / 100; tn = slider46 / 100;
  t9r_szt = sz;
  !eng ? (
    t9r_tt = 0.25 * (1.8 / 0.25) ^ dc;                    // ROOM: 0.25 - 1.8 s
    t9r_pms = 0.040 * pd;                                  // 0 - 40 ms
    t9r_dpt = 0.75 - 0.4 * tn;                             // damping 2.6 - 6.4 kHz
  ) : (
    t9r_tt = 1.4 * (6.5 / 1.4) ^ dc;                      // HALL: 1.4 - 6.5 s
    t9r_pms = 0.010 + 0.210 * pd;                          // 10 - 220 ms
    t9r_dpt = 0.5 - 0.45 * tn;                             // 4.8 - 14 kHz
  );
  t9r_pret = t9r_pms * srate;
  t9r_mx_t = slider47 / 100;
  t9r_dk = slider48 / 100 * 15;                            // DUCK: up to 15 dB (the strip's)
);
function t9r_init() (
  t9r_tk = 1 - exp(-32 / (0.12 * srate)); t9r_sm = 1 - exp(-1 / (0.02 * srate)); t9r_fd = 1 / (0.01 * srate);
  t9r_modset(); t9r_set(); t9r_clear(); t9r_rsf = 1;
  t9r_ts = t9r_tt; t9r_szs = t9r_szt; t9r_dps = t9r_dpt; t9r_ctl(); t9r_cc = 0; t9r_pre = t9r_pret; t9r_wg = t9r_wgs; t9r_mx = t9r_mx_t;
);
function t9r_run() local(sa, sb, rp, ri, rf, j0, j1, dfa, dfb, d, bb, n, v, a, b, c, e, f, g, h, jj, u, y, rl, rr, o0, o1, o2, o3, o4, o5, o6, o7) (
  t9r_fw += (t9r_on - t9r_fw) * xs_c;
  !t9r_idle ? (
    (t9r_cc -= 1) <= 0 ? ( t9r_cc = 32; t9r_ctl(); );
    t9r_pre += (t9r_pret - t9r_pre) * 0.0004;
    t9r_wg += (t9r_wgs - t9r_wg) * t9r_sm; t9r_mx += (t9r_mx_t - t9r_mx) * t9r_sm;
    // PRE-DELAY (gliding, linear interpolation)
    T9R_PB[t9r_pw] = vx_l * t9r_fw; T9R_PB[T9R_PSZ + t9r_pw] = vx_r * t9r_fw;
    rp = t9r_pw - t9r_pre; rp < 0 ? rp += T9R_PSZ;
    ri = floor(rp); rf = rp - ri; j0 = ri & T9R_PM; j1 = (ri + 1) & T9R_PM;
    sa = T9R_PB[j0] + (T9R_PB[j1] - T9R_PB[j0]) * rf;
    sb = T9R_PB[T9R_PSZ + j0] + (T9R_PB[T9R_PSZ + j1] - T9R_PB[T9R_PSZ + j0]) * rf;
    t9r_pw = (t9r_pw + 1) & T9R_PM;
    t9r_rsf = min(t9r_rsf + t9r_fd * 0.35, 1);             // a fresh tank fills from a ramp
    sa *= t9r_rsf; sb *= t9r_rsf;
    dfa = t9r_diff(sa, 0, t9r_ndf, t9r_dfg); dfb = t9r_diff(sb, 4, t9r_ndf, t9r_dfg);
    // the 8 lines (unrolled): a linear read at the ramped length, the damping low-pass, the decay gain
    d = (T9R_DLC[0] += T9R_DLD[0]); f = floor(d); bb = T9R_LB + 0 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[0] += (v - T9R_LPS[0]) * t9r_kd; o0 = T9R_LPS[0] * T9R_GN[0];
    d = (T9R_DLC[1] += T9R_DLD[1]); f = floor(d); bb = T9R_LB + 1 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[1] += (v - T9R_LPS[1]) * t9r_kd; o1 = T9R_LPS[1] * T9R_GN[1];
    d = (T9R_DLC[2] += T9R_DLD[2]); f = floor(d); bb = T9R_LB + 2 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[2] += (v - T9R_LPS[2]) * t9r_kd; o2 = T9R_LPS[2] * T9R_GN[2];
    d = (T9R_DLC[3] += T9R_DLD[3]); f = floor(d); bb = T9R_LB + 3 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[3] += (v - T9R_LPS[3]) * t9r_kd; o3 = T9R_LPS[3] * T9R_GN[3];
    d = (T9R_DLC[4] += T9R_DLD[4]); f = floor(d); bb = T9R_LB + 4 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[4] += (v - T9R_LPS[4]) * t9r_kd; o4 = T9R_LPS[4] * T9R_GN[4];
    d = (T9R_DLC[5] += T9R_DLD[5]); f = floor(d); bb = T9R_LB + 5 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[5] += (v - T9R_LPS[5]) * t9r_kd; o5 = T9R_LPS[5] * T9R_GN[5];
    d = (T9R_DLC[6] += T9R_DLD[6]); f = floor(d); bb = T9R_LB + 6 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[6] += (v - T9R_LPS[6]) * t9r_kd; o6 = T9R_LPS[6] * T9R_GN[6];
    d = (T9R_DLC[7] += T9R_DLD[7]); f = floor(d); bb = T9R_LB + 7 * T9R_BSZ; n = t9r_w - f; v = bb[n & T9R_BM]; v += (bb[(n - 1) & T9R_BM] - v) * (d - f);
    T9R_LPS[7] += (v - T9R_LPS[7]) * t9r_kd; o7 = T9R_LPS[7] * T9R_GN[7];
    rl = o0 - o2 + o4 - o6 + 0.6 * (o1 - o5);
    rr = o1 - o3 + o5 - o7 + 0.6 * (o2 - o6);
    // 8 x 8 Hadamard (scaled: lossless)
    a = o0 + o1; b = o0 - o1; c = o2 + o3; e = o2 - o3; f = o4 + o5; g = o4 - o5; h = o6 + o7; jj = o6 - o7;
    o0 = a + c; o2 = a - c; o1 = b + e; o3 = b - e; o4 = f + h; o6 = f - h; o5 = g + jj; o7 = g - jj;
    a = o0; o0 = (a + o4) * 0.35355339; o4 = (a - o4) * 0.35355339; a = o1; o1 = (a + o5) * 0.35355339; o5 = (a - o5) * 0.35355339;
    a = o2; o2 = (a + o6) * 0.35355339; o6 = (a - o6) * 0.35355339; a = o3; o3 = (a + o7) * 0.35355339; o7 = (a - o7) * 0.35355339;
    // the all-pass in each line, the word length (SMOKE: its ANALOG 16-bit loop), back into the line
    u = o0 + dfa + vx_dn; bb = T9R_AB + 0 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[0]) & T9R_AM]; y = v - t9r_apg * u; bb[t9r_aw] = u + t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 0 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    u = o1 + dfb + vx_dn; bb = T9R_AB + 1 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[1]) & T9R_AM]; y = v - -t9r_apg * u; bb[t9r_aw] = u + -t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 1 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    u = o2 - dfa + vx_dn; bb = T9R_AB + 2 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[2]) & T9R_AM]; y = v - t9r_apg * u; bb[t9r_aw] = u + t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 2 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    u = o3 - dfb + vx_dn; bb = T9R_AB + 3 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[3]) & T9R_AM]; y = v - -t9r_apg * u; bb[t9r_aw] = u + -t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 3 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    u = o4 + dfa + vx_dn; bb = T9R_AB + 4 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[4]) & T9R_AM]; y = v - t9r_apg * u; bb[t9r_aw] = u + t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 4 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    u = o5 - dfb + vx_dn; bb = T9R_AB + 5 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[5]) & T9R_AM]; y = v - -t9r_apg * u; bb[t9r_aw] = u + -t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 5 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    u = o6 - dfa + vx_dn; bb = T9R_AB + 6 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[6]) & T9R_AM]; y = v - t9r_apg * u; bb[t9r_aw] = u + t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 6 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    u = o7 + dfb + vx_dn; bb = T9R_AB + 7 * T9R_ASZ; v = bb[(t9r_aw - T9R_APN[7]) & T9R_AM]; y = v - -t9r_apg * u; bb[t9r_aw] = u + -t9r_apg * y;
    !eng ? y = t9_qt(y); bb = T9R_LB + 7 * T9R_BSZ; bb[t9r_w] = min(max(y, -4), 4);
    t9r_w = (t9r_w + 1) & T9R_BM; t9r_aw = (t9r_aw + 1) & T9R_AM;
    rl *= 0.25; rr *= 0.25;
    // the return: its level calibration, the strip's MIX and DUCK
    du_g += (du_t - du_g) * du_gc;
    g = t9r_wg * t9r_mx * du_g;
    vx_l += rl * g; vx_r += rr * g;
    t9r_pk = max(t9r_pk, abs(rl) + abs(rr));
  );
);

// ================= sample-rate setup: memory, coefficients =================
function vx_srinit() (
  vx_sr = srate; vx_mem = 1024;
  // the Series 92 mod + space (t9_)
  T9F_N = vx_p2(0.02 * srate); T9F_M = T9F_N - 1; T9F_L = vx_alloc(T9F_N); T9F_R = vx_alloc(T9F_N); t9f_wp = 0;
  T9D_N = vx_p2(0.3 * srate); T9D_M = T9D_N - 1; T9D_L = vx_alloc(T9D_N); T9D_R = vx_alloc(T9D_N); t9d_w = 0;
  T9R_BSZ = 32768; T9R_BM = T9R_BSZ - 1; T9R_LB = vx_alloc(8 * T9R_BSZ);
  T9R_ASZ = 4096; T9R_AM = T9R_ASZ - 1; T9R_AB = vx_alloc(8 * T9R_ASZ); T9R_DB = vx_alloc(8 * T9R_ASZ);
  T9R_PSZ = vx_p2(0.24 * srate); T9R_PM = T9R_PSZ - 1; T9R_PB = vx_alloc(2 * T9R_PSZ);
  T9R_LN = vx_alloc(16); T9R_APL = vx_alloc(16); T9R_DBL = vx_alloc(16); T9R_ISG = vx_alloc(8); T9R_LFR = vx_alloc(8); T9R_LFP = vx_alloc(8);
  T9R_DLC = vx_alloc(8); T9R_DLD = vx_alloc(8); T9R_GN = vx_alloc(8); T9R_DLN = vx_alloc(8); T9R_APN = vx_alloc(8); T9R_LPS = vx_alloc(8); T9R_O = vx_alloc(8);
  t9r_w = t9r_aw = t9r_pw = 0;
  t9r_tables();
  pre_lc = vx_kf(110);
  xs_c = vx_kt(0.01);                                      // IN keys: 10 ms cross-fades
  sm_c = vx_kt(0.02);                                      // knob glides (per sample)
  dkr = 1 / (0.012 * srate);                               // MODEL / ORDER: 12 ms out, 12 ms in
  ms_c = vx_kt(0.003);                                     // FET colour: the running mean square
  op_dc = vx_kt(0.005);                                    // opto detector: RMS over 5 ms
  ds_at = vx_kt(0.0003); ds_rl = vx_kt(0.06);              // de-ess detector: 0.3 ms / 60 ms
  ds_rc = vx_kt(0.003);                                    // de-ess: the band against the whole, 3 ms
  du_at = vx_kt(0.012); du_rl = vx_kt(0.35);               // DUCK: the voice's envelope, 12 ms / 350 ms
  du_gc = vx_kt(0.006);
  vx_gb = 1;                                               // (the knob glides: set per block in @block - samplesblock is 0 in @init)
  ost_init(0);
  t9f_init(); t9d_init(); t9r_init();
);

// ================= voicing (per block, from the current model eng) =================
// the pre-amp's and the saturation's make-up (dB) across DRIVE / AMOUNT 0, 25, 50, 75, 100 %: measured on the vocal
// test signal, so turning them up adds colour rather than loudness
function vx_tab(d, a, b, c, e, f) local(p, i, t) (
  p = min(max(d, 0), 1) * 4; i = min(floor(p), 3); t = p - i;
  i == 0 ? a + (b - a) * t : i == 1 ? b + (c - b) * t : i == 2 ? c + (e - c) * t : e + (f - e) * t;
);
// the opto's and the FET's make-up (dB): fitted on the vocal test signal so PEAK REDUCTION and AMOUNT change the
// amount of levelling far more than the loudness
function op_mkup(pr) ( eng ? pr * (-3.215 + pr * (16.977 - 4.483 * pr)) : pr * (-3.677 + pr * (27.191 - 8.781 * pr)); );
function fet_mkup(a, rt) local(d) (
  d = a / 24;
  rt == 0 ? vx_tab(d, 0.08, 1.67, 3.43, 6.61, 10.65) : rt == 1 ? vx_tab(d, 0.09, 1.97, 3.95, 7.59, 12.2) :
  rt == 2 ? vx_tab(d, 0.09, 2.01, 3.93, 7.7, 12.53) : vx_tab(d, 0.1, 2.03, 3.86, 7.71, 12.72);
);

// change detector (instance l)
function chg(v) instance(l) ( v != l ? ( l = v; 1; ) : 0; );
// a band's SHELF / BELL key: the band glides out (20 ms), changes shape at 0 dB (where both shapes are flat), glides back
function eqk(want) instance(ty, k) ( want != ty ? ( k = max(k - eq_kr, 0); k <= 0 ? ty = want; ) : k = min(k + eq_kr, 1); k; );
// the four bands (per block): SMOKE broad and gentle (console-ish, a softer HF shelf: its boost eased, its corner
// rounded); STORM proportional Q (the bells narrow as they are pushed) and firmer shelves (a crisper top)
function vx_eq() local(lg, lf, lk, mg, mf, mq, hg, hf, hq, fg, ff, fk, q, g) (
  eq_kr = samplesblock / (0.02 * srate);
  lk = eLF.eqk(slider28 >= 0.5); fk = eHF.eqk(slider56 >= 0.5);
  lg = gd_lg.gl(slider26) * lk; lf = gd_lf.gl(slider27);
  mg = gd_mg.gl(slider10); mf = gd_mf.gl(slider9); mq = gd_mq.gl(slider11);
  hg = gd_hg.gl(slider51); hf = gd_hf.gl(slider52); hq = gd_hq.gl(slider53);
  fg = gd_fg.gl(slider54) * fk; ff = gd_ff.gl(slider55);
  vc_e1.chg(lg * 1.3 + lf * 0.0173 + eLF.ty * 7 + eng * 101) ? (
    q = eLF.ty ? ( !eng ? 0.6 : 0.6 + abs(lg) / 15 * 0.9 ) : ( !eng ? 0.55 : 0.9 );
    LP_.e1.bq_set(eLF.ty ? 2 : 4, lf, q, lg); RP_.e1.bq_set(eLF.ty ? 2 : 4, lf, q, lg);
  );
  vc_e2.chg(mg * 1.3 + mf * 0.0173 + mq * 7.1 + eng * 101) ? (
    q = !eng ? mq * 0.7 : mq * (0.6 + abs(mg) / 15 * 1.2);
    LP_.e2.bq_set(2, mf, q, mg); RP_.e2.bq_set(2, mf, q, mg);
  );
  vc_e3.chg(hg * 1.3 + hf * 0.0173 + hq * 7.1 + eng * 101) ? (
    q = !eng ? hq * 0.7 : hq * (0.6 + abs(hg) / 15 * 1.2);
    LP_.e3.bq_set(2, hf, q, hg); RP_.e3.bq_set(2, hf, q, hg);
  );
  vc_e4.chg(fg * 1.3 + ff * 0.0173 + eHF.ty * 7 + eng * 101) ? (
    eHF.ty ? ( q = !eng ? 0.6 : 0.6 + abs(fg) / 15 * 0.9; LP_.e4.bq_set(2, ff, q, fg); RP_.e4.bq_set(2, ff, q, fg); )
           : ( !eng ? ( q = 0.5; g = fg > 0 ? 0.85 * fg : fg; ) : ( q = 1.0; g = fg; );
               LP_.e4.bq_set(3, ff, q, g); RP_.e4.bq_set(3, ff, q, g); );
  );
);

function vx_voice() local(d, w, s, f, q, g, sz, dc, t6, k, i, L, pd) (
  // ---------- PREAMP ----------
  d = gd_pre.gl(slider6 / 100);
  pre_on_t = slider5 >= 0.5;
  !eng ? (
    pre_k = vx_db(-6 + 20 * d); pre_b = 0.15; pre_xa = 0.9 * d; pre_xd = 1.5 + 4 * d;
    PL.k.clp_set(2, 1, 1.3, 0); PR.k.clp_set(2, 1, 1.3, 0);
  ) : (
    pre_k = vx_db(-8 + 16 * d); pre_b = 0.05; pre_xa = 0.35 * d; pre_xd = 1 + 2 * d;
    PL.k.clp_set(2, 1.1, 1.1, 0); PR.k.clp_set(2, 1.1, 1.1, 0);
  );
  PL.pf.clp_pf_block(d, srate, samplesblock); PR.pf.clp_pf_block(d, srate, samplesblock);
  w = pkt.clp_kt_block(d, srate, samplesblock); PL.k.clp_knee(w); PR.k.clp_knee(w);
  pre_mk_t = vx_db(!eng ? vx_tab(d, 0.02, 0.16, 0.65, 1.27, 1.8) : vx_tab(d, 0.01, 0.1, 0.26, 0.56, 1.16));
  pre_cb = PL.k.clp_crv(pre_b);
  pre_sl = pre_b <= PL.k.cp - w ? 1 : 1 - (pre_b - PL.k.cp + w) / (2 * w);
  PL.k.clp_tidy(); PR.k.clp_tidy();
  // the pre-amp's own colour, with DRIVE: SMOKE a little low-mid weight, STORM a touch of presence
  g = gd_pre.v;
  vc_pre.chg(g + 2 * eng) ? (
    !eng ? ( LP_.pe.bq_set(2, 220, 0.7, 1.2 * g); RP_.pe.bq_set(2, 220, 0.7, 1.2 * g); )
         : ( LP_.pe.bq_set(2, 3000, 0.7, 0.6 * g); RP_.pe.bq_set(2, 3000, 0.7, 0.6 * g); );
  );
  // ---------- LOW END ----------
  f = gd_hp.gl(slider7);
  vc_hp.chg(f) ? ( LP_.hp.bq_set(1, f, 0.70710678, 0); RP_.hp.bq_set(1, f, 0.70710678, 0); );
  g = gd_ls.gl(slider8);
  vc_ls.chg(g) ? ( LP_.ls.bq_set(4, 150, 0.70710678, g); RP_.ls.bq_set(4, 150, 0.70710678, g); );
  // ---------- OPTO ----------
  s = gd_op.gl(slider13 / 100);
  !eng ? (
    op_thr = -4 - 36 * s; op_sl = 1 - 1 / 3.5; op_kn = 12;
    op_at = vx_kt(0.010); op_rf = vx_kt(0.08); op_as = vx_kt(0.4); op_rs = vx_kt(2.5); op_sw = 0.65;
  ) : (
    op_thr = -4 - 30 * s; op_sl = 1 - 1 / 2.5; op_kn = 8;
    op_at = vx_kt(0.008); op_rf = vx_kt(0.06); op_as = vx_kt(0.5); op_rs = vx_kt(1.5); op_sw = 0.5;
  );
  op_mk_t = vx_db(op_mkup(s) + slider14);
  op_lin = 10 ^ ((op_thr - 0.5 * op_kn - 3) / 10);              // the detector's mean square at the knee's foot
  // ---------- DE-ESS ----------
  f = gd_df.gl(slider16);
  vc_df.chg(f) ? ( LP_.ds.dsx_set(1.2 * f); RP_.ds.dsx_set(1.2 * f); );
  ds_thr = slider17; ds_rng = slider18; ds_lin = 10 ^ ((ds_thr - 3) / 20);
  // ---------- FET ----------
  k = gd_fa.gl(slider21);
  fet_rt = slider22 | 0;
  fet_sl = fet_rt == 0 ? 0.75 : fet_rt == 1 ? 0.875 : fet_rt == 2 ? 0.9167 : 0.95;
  fet_thr = -6 - k; fet_lin = 10 ^ ((fet_thr - 1.5) / 20);
  fet_ac = vx_kt(min(max(slider23, 20), 800) * 0.000001);
  fet_rc = vx_kt(min(max(slider24, 50), 1100) * 0.001);
  fet_mk_t = vx_db(fet_mkup(k, fet_rt));
  // ---------- EQ: four bands, voiced by the model ----------
  vx_eq();
  // ---------- SATURATION ----------
  s = gd_sa.gl(slider29 / 100);
  sat_on_t = slider29 > 0.05;
  !eng ? (
    sat_k = vx_db(-8 + 22 * s); sat_b = 0;
    SL.k.clp_set(1, 1, 1, 0); SR.k.clp_set(1, 1, 1, 0);
  ) : (
    sat_k = vx_db(-8 + 18 * s); sat_b = 0.08;
    SL.k.clp_set(2, 1, 1.25, 0); SR.k.clp_set(2, 1, 1.25, 0);
  );
  SL.pf.clp_pf_block(s, srate, samplesblock); SR.pf.clp_pf_block(s, srate, samplesblock);
  w = skt.clp_kt_block(s, srate, samplesblock); SL.k.clp_knee(w); SR.k.clp_knee(w);
  sat_mk_t = vx_db(!eng ? vx_tab(s, 0, 0.32, 0.78, 1.42, 2.33) : vx_tab(s, 0, 0.07, 0.24, 0.63, 1.31));
  sat_cb = SL.k.clp_crv(sat_b);
  sat_sl = eng ? ( sat_b <= 1 - w ? 1 : 1 - (sat_b - 1 + w) / (2 * w) ) : 1;
  SL.k.clp_tidy(); SR.k.clp_tidy();
  vc_sat.chg(s + 2 * eng) ? (
    !eng ? ( LP_.s1.bq_set(2, 90, 0.9, 1.5 * s); RP_.s1.bq_set(2, 90, 0.9, 1.5 * s);
             LP_.s2.bq_set(3, 9000, 0.6, -2.5 * s); RP_.s2.bq_set(3, 9000, 0.6, -2.5 * s); )
         : ( LP_.s1.bq_set(2, 180, 0.8, 1.0 * s); RP_.s1.bq_set(2, 180, 0.8, 1.0 * s);
             LP_.s2.bq_set(3, 9000, 0.6, 0); RP_.s2.bq_set(3, 9000, 0.6, 0); );
  );
  // ---------- the Series 92 mod + space ----------
  t9f_set(); t9d_set(); t9r_set();
  // ---------- OUTPUT ----------
  out_t = vx_db(slider50) * (eng ? STORM_TRIM : 1);
);
// the model's fixed parts, set at the silent point of a swap
function vx_model() (
  !eng ? (
    PL.pf.clp_pf_cfg(22000, 7500, -1.0, 80);  PR.pf.clp_pf_cfg(22000, 7500, -1.0, 80);  pkt.clp_kt_cfg(0.55, 1.0);
    SL.pf.clp_pf_cfg(22000, 9000, -1.5, 90);  SR.pf.clp_pf_cfg(22000, 9000, -1.5, 90);  skt.clp_kt_cfg(0.6, 1.0);
  ) : (
    PL.pf.clp_pf_cfg(22000, 12000, -2.0, 120); PR.pf.clp_pf_cfg(22000, 12000, -2.0, 120); pkt.clp_kt_cfg(0.5, 0.9);
    SL.pf.clp_pf_cfg(22000, 11000, -1.5, 100); SR.pf.clp_pf_cfg(22000, 11000, -1.5, 100); skt.clp_kt_cfg(0.5, 0.9);
  );
  pkt.kti = 0; skt.kti = 0;
  t9r_modset(); t9r_clear(); t9f_set();
  vc_pre.l = vc_sat.l = vc_e1.l = vc_e2.l = vc_e3.l = vc_e4.l = vc_hp.l = vc_ls.l = vc_df.l = -12345;   // (so a first value of 0 is set too)
);

// ================= the stages (one sample, both sides: in vx_l / vx_r) =================

function st_lowcut() (
  vx_l = LP_.hp.bq_run(vx_l); vx_r = RP_.hp.bq_run(vx_r);
  vx_l = LP_.ls.bq_run(vx_l); vx_r = RP_.ls.bq_run(vx_r);
);
function st_eq() local(a, b) (
  eq_w += (eq_on_t - eq_w) * xs_c;
  eq_w > 0.000001 || eq_on_t ? (
    a = LP_.e4.bq_run(LP_.e3.bq_run(LP_.e2.bq_run(LP_.e1.bq_run(vx_l)))); b = RP_.e4.bq_run(RP_.e3.bq_run(RP_.e2.bq_run(RP_.e1.bq_run(vx_r))));
    vx_l += (a - vx_l) * eq_w; vx_r += (b - vx_r) * eq_w;
  );
);
function st_dyn() local(sc, lv, t, e, g, a, b, gl_, gr_, y1, y2) (
  // ---- OPTO (stereo linked) ----
  op_w += (op_on_t - op_w) * xs_c;
  op_w > 0.000001 || op_on_t ? (
    sc = max(abs(vx_l), abs(vx_r));
    op_ms += (sc * sc - op_ms) * op_dc;
    // below the knee nothing is taken (the same result without the logarithm)
    t = op_ms <= op_lin ? 0 : -op_sl * dy_curve(10 * log10(op_ms + 0.0000000001) + 3 - op_thr, op_kn);
    op_ef += (t - op_ef) * (t < op_ef ? op_at : op_rf);
    op_es += (t - op_es) * (t < op_es ? op_as : op_rs);
    e = min(op_ef, op_es * op_sw);
    op_mk += (op_mk_t - op_mk) * sm_c;
    g = (e < -0.0000001 ? vx_db(e) : 1) * op_mk;
    vx_l *= 1 + (g - 1) * op_w; vx_r *= 1 + (g - 1) * op_w;
    op_grm = min(op_grm, e * op_w);
  ) : ( op_ef = op_es = op_ms = 0; );
  // ---- DE-ESS (split band, stereo linked) ----
  ds_w += (ds_on_t - ds_w) * xs_c; ds_lw += (ds_lis_t - ds_lw) * xs_c;
  ds_w > 0.000001 || ds_on_t ? (
    ds_pa = LP_.ds.dsx_run(vx_l); ds_pb = RP_.ds.dsx_run(vx_r); a = LP_.ds.hi; b = RP_.ds.hi;
    sc = max(abs(a), abs(b));
    ds_env += (sc - ds_env) * (sc > ds_env ? ds_at : ds_rl);
    // the band's power against the whole signal's (both sides): only sibilance stands out like this
    ds_mh += (a * a + b * b - ds_mh) * ds_rc; ds_mf += (vx_l * vx_l + vx_r * vx_r - ds_mf) * ds_rc;
    t = ds_env <= ds_lin || ds_mh <= 0.25118864 * ds_mf ? 0 :
        min(ds_rng, dy_curve(20 * log10(ds_env + 0.000000001) - ds_thr, 6) * 0.75) * min((10 * log10(ds_mh / ds_mf) + 6) * 0.25, 1);
    ds_gr += (t - ds_gr) * 0.5;
    g = ds_gr > 0.0000001 ? vx_db(-ds_gr) - 1 : 0;
    y1 = ds_pa + a * g; y2 = ds_pb + b * g;
    y1 += (a - y1) * ds_lw; y2 += (b - y2) * ds_lw;           // LISTEN: the detector's band
    vx_l = ds_pa + (y1 - ds_pa) * ds_w; vx_r = ds_pb + (y2 - ds_pb) * ds_w;
    ds_grm = max(ds_grm, ds_gr * ds_w);
  ) : ( vx_l = LP_.ds.dsx_apr(vx_l); vx_r = RP_.ds.dsx_apr(vx_r); ds_env = ds_gr = ds_mh = ds_mf = 0; );
  // ---- FET (stereo linked), its colour grows with the gain it takes away ----
  fet_w += (fet_on_t - fet_w) * xs_c;
  fet_w > 0.000001 || fet_on_t ? (
    sc = max(abs(vx_l), abs(vx_r));
    t = sc <= fet_lin ? 0 : -fet_sl * dy_curve(20 * log10(sc + 0.000001) - fet_thr, 3);
    fet_e += (t - fet_e) * (t < fet_e ? fet_ac : fet_rc);
    fet_mk += (fet_mk_t - fet_mk) * sm_c;
    g = fet_e < -0.0000001 ? vx_db(fet_e) : 1;
    gl_ = 1 - g; gl_ *= gl_ * 0.35;
    y1 = vx_l * g; y2 = vx_r * g;
    a = min(y1 * y1, 4); b = min(y2 * y2, 4);
    fet_m1 += (a - fet_m1) * ms_c; fet_m2 += (b - fet_m2) * ms_c;
    y1 = (y1 + gl_ * (a - fet_m1)) * fet_mk; y2 = (y2 + gl_ * (b - fet_m2)) * fet_mk;
    vx_l += (y1 - vx_l) * fet_w; vx_r += (y2 - vx_r) * fet_w;
    fet_grm = min(fet_grm, fet_e * fet_w);
  ) : ( fet_e = fet_m1 = fet_m2 = 0; );
);

// ================= presets =================
// the whole unit apart from TRIM, GUARD and DRIFT
function vx_dflt() (
  slider1 = 0; slider2 = 0; slider5 = 1; slider6 = 30; slider7 = 60; slider8 = -2; slider9 = 240; slider10 = 2.5; slider11 = 0.8;
  slider12 = 1; slider13 = 35; slider14 = 0; slider15 = 1; slider16 = 4500; slider17 = -28; slider18 = 6; slider19 = 0;
  slider20 = 1; slider21 = 6; slider22 = 0; slider23 = 250; slider24 = 120; slider25 = 1; slider26 = 0; slider27 = 100; slider28 = 0;
  slider29 = 25; slider30 = 0; slider31 = 0.15; slider32 = 35; slider33 = 20; slider34 = 40; slider35 = 1;
  slider36 = 0; slider37 = 110; slider38 = 0; slider39 = 35; slider40 = 12; slider41 = 25;
  slider42 = 1; slider43 = 50; slider44 = 50; slider45 = 40; slider46 = 50; slider47 = 20; slider48 = 40; slider50 = 0;
  slider51 = -2; slider52 = 2800; slider53 = 0.8; slider54 = -4; slider55 = 7000; slider56 = 0;
);
// Init (and Reset): flat - every dial at 0 (HIGH-PASS off) and every section out; the frequencies, Qs and times stay
function vx_flat() (
  slider5 = 0; slider6 = 0; slider7 = 20; slider8 = 0; slider10 = 0; slider12 = 0; slider13 = 0; slider15 = 0; slider17 = 0; slider18 = 0;
  slider20 = 0; slider21 = 0; slider25 = 0; slider29 = 0; slider32 = 0; slider33 = 0; slider34 = 0; slider39 = 0; slider40 = 0; slider41 = 0;
  slider42 = 0; slider43 = 0; slider44 = 0; slider45 = 0; slider46 = 0; slider47 = 0; slider48 = 0; slider51 = 0; slider54 = 0;
);
// short setters: front end (model, drive, hpf, shelf), dynamics (opto pr, opto gain, de-ess freq, thr, range, fet amount,
// ratio, attack, release), EQ (order; LF gain, freq, bell; LMF gain, freq, Q; HMF gain, freq, Q; HF gain, freq, bell),
// saturation, flanger, slapback, space (+ output)
function p_fe(m, dr, hp, ls) ( slider1 = m; slider6 = dr; slider7 = hp; slider8 = ls; );
function p_dy(pr, og, df, dt, dg, fa, fr, fat, frl) ( slider13 = pr; slider14 = og; slider16 = df; slider17 = dt; slider18 = dg; slider21 = fa; slider22 = fr; slider23 = fat; slider24 = frl; );
function p_eq(od, lg, lf, lb, mg, mf, mq, hg, hf, hq, fg, ff, fb) (
  slider2 = od; slider26 = lg; slider27 = lf; slider28 = lb; slider10 = mg; slider9 = mf; slider11 = mq;
  slider51 = hg; slider52 = hf; slider53 = hq; slider54 = fg; slider55 = ff; slider56 = fb;
);
function p_sat(s) ( slider29 = s; );
function p_fl(on, rt, dp, fb, mx, st) ( slider30 = on; slider31 = rt; slider32 = dp; slider33 = fb; slider34 = mx; slider35 = st; );
function p_sl(on, t, sy, tn, fb, mx) ( slider36 = on; slider37 = t; slider38 = sy; slider39 = tn; slider40 = fb; slider41 = mx; );
function p_sp(on, sz, dc, pd, tn, mx, dk, ou) ( slider42 = on; slider43 = sz; slider44 = dc; slider45 = pd; slider46 = tn; slider47 = mx; slider48 = dk; slider50 = ou; );
#vx_pm = "Init|Smoke Intimate Lead|Smoke Velvet Flange|Smoke Stacked Harmonies|Smoke Late-Night Tape|Smoke Whisper Close|Storm Power Ballad|Storm Slapback Lead|Storm Arena Chorus|Storm Midnight Verse|Twilight Hybrid|Storm Clean Lead";
function load_preset(p) local(k) (
  vx_dflt();
  (p == 1 || p == 13) ? vx_flat();
  p == 2  ? ( p_fe(0, 40, 70, -2); p_dy(45, 0, 4760, -30, 6, 6, 0, 300, 140); p_eq(0, 1.5, 110, 0, -2.5, 380, 1.6, -2, 2800, 0.7, -3.5, 7500, 0); p_sat(30);
              p_sp(1, 35, 45, 30, 40, 18, 50, 2.48); ) :
  p == 3  ? ( p_fe(0, 35, 60, -2); p_dy(40, 0, 4550, -28, 6, 5, 0, 250, 120); p_eq(0, 0, 100, 0, 2, 250, 0.8, -1.5, 3000, 0.8, -4, 7000, 0); p_sat(30);
              p_fl(1, 0.12, 40, 35, 45, 1); p_sp(1, 45, 50, 40, 45, 18, 40, 1.35); ) :
  p == 4  ? ( p_fe(0, 25, 80, -3); p_dy(55, 0, 4900, -32, 8, 8, 1, 300, 160); p_eq(0, -2, 150, 0, -3, 320, 1.2, -2.5, 2500, 0.8, -5, 6500, 0); p_sat(20);
              p_fl(1, 0.08, 25, 15, 25, 1); p_sp(1, 60, 60, 50, 40, 24, 30, 3.77); ) :
  p == 5  ? ( p_fe(0, 60, 60, -1.5); p_dy(50, 0, 4340, -28, 6, 7, 0, 400, 200); p_eq(0, 2, 90, 0, 3, 220, 0.8, -3, 2800, 0.7, -6, 6000, 0); p_sat(70);
              p_sp(1, 30, 40, 20, 25, 16, 50, -2.36); ) :
  p == 6  ? ( p_fe(0, 20, 80, -3); p_dy(30, 0, 5250, -34, 9, 4, 0, 200, 100); p_eq(0, -1, 150, 0, -3, 300, 1, -1.5, 3500, 0.8, -2, 8000, 0); p_sat(15);
              p_sp(1, 25, 35, 15, 35, 12, 60, 4.31); ) :
  p == 7  ? ( p_fe(1, 30, 70, -2); p_dy(30, 0, 4760, -26, 6, 8, 0, 200, 120); p_eq(0, 1.5, 170, 1, -2, 450, 1.4, 3.5, 3800, 1, 4, 11000, 0); p_sat(25);
              p_sp(1, 65, 60, 55, 60, 24, 50, 0.81); ) :
  p == 8  ? ( p_fe(1, 40, 60, -2); p_dy(25, 0, 4900, -26, 6, 10, 1, 150, 100); p_eq(0, 0, 120, 0, -1.5, 400, 1.4, 4, 3500, 1.2, 3, 10000, 0); p_sat(30);
              p_sl(1, 110, 0, 35, 12, 30); p_sp(1, 40, 35, 30, 55, 14, 40, 0.92); ) :
  p == 9  ? ( p_fe(1, 45, 70, -2.5); p_dy(35, 0, 5040, -24, 7, 12, 2, 120, 90); p_eq(0, 2, 180, 1, -2, 500, 1.2, 5, 4000, 0.9, 5, 11000, 0); p_sat(40);
              p_sl(1, 140, 0, 45, 18, 22); p_sp(1, 90, 80, 75, 70, 30, 60, -0.22); ) :
  p == 10 ? ( p_fe(1, 25, 60, -2); p_dy(30, 0, 4760, -28, 6, 6, 0, 250, 150); p_eq(1, 1.5, 170, 1, -2, 350, 1.4, 2, 3800, 1, 3, 11000, 0); p_sat(20);
              p_sp(1, 75, 70, 80, 55, 26, 55, 1.64); ) :
  p == 11 ? ( p_fe(1, 35, 70, -2); p_dy(40, 0, 4760, -28, 6, 7, 0, 250, 130); p_eq(0, 1, 120, 0, 1.5, 250, 0.9, 2.5, 3500, 1, 2, 10000, 0); p_sat(30);
              p_fl(1, 0.1, 30, 25, 35, 1); p_sl(1, 0, 3, 30, 10, 20); p_sp(1, 55, 55, 50, 50, 20, 50, 0.77); ) :
  p == 12 ? ( p_fe(1, 15, 60, -1.5); p_dy(25, 0, 4760, -26, 5, 5, 0, 300, 120); p_eq(0, 0, 100, 0, 0, 400, 1, 2, 3800, 1, 3, 12000, 0); p_sat(10);
              p_sp(1, 50, 45, 50, 60, 10, 40, 0.92); );
  p == 13 ? ( slider3 = 0; slider4 = 1; slider49 = 50; );
  k = 1; loop(56, (p == 13 || (k != 3 && k != 4 && k != 49)) ? ui_auto(k); k += 1; );
  pr_cur = p > 12 ? 1 : p;
);

// ================= start =================
STORM_TRIM = 1.105;                                       // STORM level matched to SMOKE at Init (vocal test signal)
eng = slider1 >= 0.5; ord = slider2 >= 0.5;
vx_srinit();
in_init();
PL.k.clp_set(2, 1, 1.3, 0); PR.k.clp_set(2, 1, 1.3, 0); SL.k.clp_set(1, 1, 1, 0); SR.k.clp_set(1, 1, 1, 0);
PL.pf.clp_pf_reset(); PR.pf.clp_pf_reset(); SL.pf.clp_pf_reset(); SR.pf.clp_pf_reset();
ostL.ost_ch_init(); ostR.ost_ch_init();
dr_hA.drift_init(0.8 + rand(0.4)); dr_hB.drift_init(0.8 + rand(0.4)); dr_sA.drift_init(0.8 + rand(0.4)); dr_sB.drift_init(0.8 + rand(0.4));
dr_sl.drift_init(0.8 + rand(0.4));
sup_a = rand(2) - 1; sup_b = rand(2) - 1;                    // the two sides never quite match
vx_model();
gd_pre.gl_set(slider6 / 100); gd_hp.gl_set(slider7); gd_ls.gl_set(slider8);
gd_lg.gl_set(slider26); gd_lf.gl_set(slider27); gd_mg.gl_set(slider10); gd_mf.gl_set(slider9); gd_mq.gl_set(slider11);
gd_hg.gl_set(slider51); gd_hf.gl_set(slider52); gd_hq.gl_set(slider53); gd_fg.gl_set(slider54); gd_ff.gl_set(slider55);
eLF.ty = slider28 >= 0.5; eLF.k = 1; eHF.ty = slider56 >= 0.5; eHF.k = 1;
gd_op.gl_set(slider13 / 100); gd_df.gl_set(slider16); gd_fa.gl_set(slider21);
gd_sa.gl_set(slider29 / 100);
gd_sz.gl_set(slider43 / 100); gd_dc.gl_set(slider44 / 100); gd_pd.gl_set(slider45 / 100); gd_st.gl_set(slider46 / 100);
drift_macro(slider49);
vx_voice();
op_mk = op_mk_t; fet_mk = fet_mk_t; out_g = out_t;
pre_kl = pre_kr = pre_sl_ = pre_sr_ = pre_k; pre_mk = pre_mk_t; sat_mk = sat_mk_t; sat_kl = sat_kr = sat_sl_ = sat_sr_ = sat_k;
t9f_dR.drift_init(0.8 + rand(0.5)); t9f_dW.drift_init(0.8 + rand(0.5)); t9f_dM.drift_init(0.8 + rand(0.5));
t9f_init(); t9d_init(); t9r_init();
pre_w = pre_on_t; op_w = slider12 >= 0.5; ds_w = slider15 >= 0.5; fet_w = slider20 >= 0.5; eq_w = slider25 >= 0.5;
sat_w = sat_on_t; t9f_w = t9f_on; t9d_fw = t9d_on; t9r_fw = t9r_on;
dk = 1; dst = 0; du_g = 1; vx_dn = 0.000000000000000001;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
0;

@block
prs_chk();
srate != vx_sr ? ( vx_srinit(); in_init(); vx_model(); );
in_setup(slider3, slider4 >= 0.5);
drift_macro(slider49);
// DRIFT: the heat (pre-amp, saturation) and the slap time here; the flanger's rate / width / centre in t9f_run
vx_di = dm_s * samplesblock / srate;
dr_hA.drift_tick(0.15 * vx_di); dr_hB.drift_tick(0.11 * vx_di); dr_sA.drift_tick(0.13 * vx_di); dr_sB.drift_tick(0.09 * vx_di);
dr_sl.drift_tick(0.25 * vx_di);
// a MODEL or ORDER change: duck, swap at the silent point, fade back in (the voicing is rebuilt in the gap)
dst == 0 && ((slider1 >= 0.5) != eng || (slider2 >= 0.5) != ord) ? dst = 1;
dst == 2 ? ( vx_model(); dst = 3; );
op_on_t = slider12 >= 0.5; ds_on_t = slider15 >= 0.5; ds_lis_t = slider19 >= 0.5; fet_on_t = slider20 >= 0.5; eq_on_t = slider25 >= 0.5;
vx_gb = 1 - exp(-max(samplesblock, 1) / (0.03 * srate));   // the knob glides (30 ms), from this block's length
vx_voice();
// per side: the heat's wander (DRIFT) on the pre-amp and the saturation
pre_kl = pre_k * (1 + dm_a * (0.05 * dr_hA.v + 0.015 * sup_a)); pre_kr = pre_k * (1 + dm_a * (0.05 * dr_hB.v + 0.015 * sup_b));
sat_kl = sat_k * (1 + dm_a * (0.05 * dr_sA.v + 0.015 * sup_b)); sat_kr = sat_k * (1 + dm_a * (0.05 * dr_sB.v + 0.015 * sup_a));
// the duck's target from the voice's envelope (per block)
du_lv = 20 * log10(du_env + 0.0000001);
du_t = vx_db(-t9r_dk * min(max((du_lv + 42) / 18, 0), 1));
// meters (mailboxes: raised here, read and cleared on the panel)
mb_op = min(mb_op, op_grm); mb_fet = min(mb_fet, fet_grm); mb_ds = max(mb_ds, ds_grm); mb_du = min(mb_du, 20 * log10(du_g + 0.000001) * t9r_fw);
op_grm = 0; fet_grm = 0; ds_grm = 0;
// housekeeping (denormals)
abs(op_ms) < 0.000000000001 ? op_ms = 0; abs(ds_env) < 0.000000000001 ? ds_env = 0; abs(du_env) < 0.000000000001 ? du_env = 0;
abs(fet_m1) < 0.000000000001 ? fet_m1 = 0; abs(fet_m2) < 0.000000000001 ? fet_m2 = 0;
// FX lines idle: once the feed is off and the tail has died away, stop running them
t9d_idle = !t9d_on && t9d_fw < 0.000001 && t9d_pk < 0.000001; t9d_pk = 0;
t9r_idle = !t9r_on && t9r_fw < 0.000001 && t9r_pk < 0.0000001; t9r_pk = 0;
t9d_idle && !t9d_clr ? ( t9d_clear(); t9d_clr = 1; ); !t9d_idle ? t9d_clr = 0;
t9r_idle && !t9r_clr ? ( t9r_clear(); t9r_clr = 1; ); !t9r_idle ? t9r_clr = 0;
ost_setup(0, 0, 120, 6000, -0.3, 1);                  // the house output stage: CLIP always on (a character unit), no band SAT
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;        // no latency

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
vx_dn = -vx_dn;
vx_l = in_l + vx_dn; vx_r = in_r + vx_dn;
pk_in = max(pk_in, max(abs(in_l), abs(in_r)));

// ---------- PREAMP ----------
pre_w += (pre_on_t - pre_w) * xs_c;
pre_w > 0.000001 || pre_on_t ? (
  pre_sl_ += (pre_kl - pre_sl_) * sm_c; pre_sr_ += (pre_kr - pre_sr_) * sm_c;     // the drive glides per sample
  pre_mk += (pre_mk_t - pre_mk) * sm_c;
  pr_a = PL.pre_run(LP_.pe.bq_run(vx_l), pre_sl_) * pre_mk; pr_b = PR.pre_run(RP_.pe.bq_run(vx_r), pre_sr_) * pre_mk;
  vx_l += (pr_a - vx_l) * pre_w; vx_r += (pr_b - vx_r) * pre_w;
);
// ---------- LOW END, CUT ----------
st_lowcut();
// ---------- EQ / DYNAMICS in the chosen order ----------
ord ? ( st_eq(); st_dyn(); ) : ( st_dyn(); st_eq(); );
// ---------- SATURATION ----------
sat_w += (sat_on_t - sat_w) * xs_c;
sat_w > 0.000001 || sat_on_t ? (
  sat_sl_ += (sat_kl - sat_sl_) * sm_c; sat_sr_ += (sat_kr - sat_sr_) * sm_c;
  sat_mk += (sat_mk_t - sat_mk) * sm_c;
  pr_a = SL.sat_run(LP_.s2.bq_run(LP_.s1.bq_run(vx_l)), sat_sl_) * sat_mk; pr_b = SR.sat_run(RP_.s2.bq_run(RP_.s1.bq_run(vx_r)), sat_sr_) * sat_mk;
  vx_l += (pr_a - vx_l) * sat_w; vx_r += (pr_b - vx_r) * sat_w;
);
// the voice's envelope for DUCK (before the effects)
du_x = max(abs(vx_l), abs(vx_r));
du_env += (du_x - du_env) * (du_x > du_env ? du_at : du_rl);

// ---------- the Series 92 mod + space: FLANGER, SLAPBACK (added; rings out when switched out), SPACE (DUCK on its return) ----------
t9f_run();
t9d_run();
t9r_run();

// ---------- MODEL / ORDER change: duck, swap at the silent point, fade back in ----------
dst == 1 ? ( dk -= dkr; dk <= 0 ? ( dk = 0; eng = slider1 >= 0.5; ord = slider2 >= 0.5; dst = 2; ); ) :
dst == 3 ? ( dk += dkr; dk >= 1 ? ( dk = 1; dst = 0; ); );
dst ? ( dkg = dk * dk * (3 - 2 * dk); vx_l *= dkg; vx_r *= dkg; );

// ---------- OUTPUT: level, the house output stage (CLIP always on) ----------
out_g += (out_t - out_g) * sm_c;
vx_l = ostL.ost_band(vx_l * out_g); vx_r = ostR.ost_band(vx_r * out_g);
ost_out(vx_l, vx_r);
spl0 = ost_l; spl1 = ost_r;
pk_out = max(pk_out, max(abs(spl0), abs(spl1)));

@gfx 1200 600
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1200, 600);

// =====================================================================================================================
// the faceplate: Series 92 (gfx-s92 parts: the black rack chassis with ears, the 92 badge, graphite sections with silver
// rules, soft-touch knobs with the house colour code, rubber keys with an LED strip, LCD readouts, LED ladders).
// The model tints it: SMOKE a smoky plum graphite with amber lamps; STORM a storm-indigo graphite with violet lamps.
// The modules run left to right in signal order: the top row, then the bottom row.
// =====================================================================================================================
function g9_pal(m) (
  s92_pal(0);
  !m ? (
    S92_PANEL = 0x2B2629; S92_PANELD = 0x211D20; S92_PANELL = 0x363035;
    S92_LAMP = 0xFFA43A; S92_LAMPD = 0x2E1D0A; S92_LCDT = 0xFFB65A; S92_LCDB = 0x2A1B0B;
  ) : (
    S92_PANEL = 0x26273F; S92_PANELD = 0x1C1C31; S92_PANELL = 0x30314C;
    S92_LAMP = 0xB884FF; S92_LAMPD = 0x22123A; S92_LCDT = 0xCDA8FF; S92_LCDB = 0x1D1233;
  );
);
// a drop-down in a black housing: the current item in the LCD colour, an arrow; a click opens the list
function g9_drop(x, y, w, h, idx, menu) local(hov, i, n, cur) (
  hov = s92_hov(x, y, w, h); n = pk_pcount(menu); cur = slider(idx) | 0;
  ui_col(0x050506); s92_rr(x, y, w, h, 3);
  ui_col(hov ? 0x2A2C30 : S92_LCDB); s92_r(x + 2, y + 2, w - 4, h - 4);
  gfx_setfont(13); ui_col(S92_LCDT); pk_pitem(menu, cur + 1, #g9_di); s92_t(x + 9, y + h * 0.5 - 6.5, #g9_di);
  ui_col(S92_LAMP); gfx_triangle((x + w - 18) * sc, (y + h * 0.5 - 3) * sc, (x + w - 8) * sc, (y + h * 0.5 - 3) * sc, (x + w - 13) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#g9_dm, ""); i = 1;
    loop(n, i == cur + 1 ? strcat(#g9_dm, "!"); strcat(#g9_dm, pk_pitem(menu, i, #g9_dt)); i < n ? strcat(#g9_dm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#g9_dm); i > 0 ? s92_set(idx, i - 1);
  );
);
function g9_hz(dst, f) ( f >= 1000 ? sprintf(dst, "%.2f kHz", f / 1000) : sprintf(dst, "%.0f Hz", f); );
function g9_key(x, y, w, h, idx, s) ( s92_key(x, y, w, h, slider(idx) >= 0.5, s) ? s92_set(idx, slider(idx) >= 0.5 ? 0 : 1); );

// ---------- the modules (x, y = the section's top left) ----------
function m_pre(x, y) (
  s92_mod(x, y, 140, 276, "PREAMP"); s92_onoff(x + 62, y + 2, 5);
  s92_knob(x + 70, y + 86, 28, 6, 0, 100, 30, 0, "DRIVE", "%.0f%%", 0);
  s92_knob(x + 36, y + 184, 15, 3, -24, 12, 0, 0, "TRIM", "%+.1f dB", 0);
  g9_key(x + 66, y + 170, 62, 24, 4, "GUARD");
  pk_led((x + 97) * sc, (y + 210) * sc, 3.5 * sc, slider4 >= 0.5 && g_grd > 0.5, S92_RED);
  s92_smallc(x + 70, y + 256, g9_m ? "CLEAN VALVE" : "WARM VALVE");
);
function m_low(x, y) (
  s92_mod(x, y, 104, 276, "LOW END");
  slider7 <= 20.5 ? strcpy(#s92_vs, "OFF") : sprintf(#s92_vs, "%.0f Hz", slider7);
  s92_kc = S92_C_HPF; s92_knob(x + 52, y + 78, 20, 7, 20, 80, 60, 0, "HIGH-PASS", "", 0);
  s92_kc = S92_C_LF; s92_knob(x + 52, y + 172, 20, 8, -3, 0, -2, 0, "SHELF", "%.1f dB", 0); s92_kc = 0;
  s92_smallc(x + 52, y + 256, "150 Hz SHELF");
);
function m_opto(x, y) (
  s92_mod(x, y, 150, 276, "OPTO"); s92_onoff(x + 72, y + 2, 12);
  s92_knob(x + 75, y + 76, 25, 13, 0, 100, 35, 0, "PEAK REDUCTION", "%.0f%%", 0);
  s92_knob(x + 75, y + 160, 15, 14, -10, 10, 0, 0, "GAIN", "%+.1f dB", 0);
  g9mO.s92_gredge(x + 8, y + 222, 134, 44, slider12 >= 0.5 ? -g_op : 0, "GR");
);
function m_dess(x, y) (
  s92_mod(x, y, 160, 276, "DE-ESS"); s92_onoff(x + 82, y + 2, 15);
  pk_led((x + 72) * sc, (y + 11) * sc, 3.5 * sc, slider15 >= 0.5 && g_ds > 1, S92_LAMP);
  g9_hz(#s92_vs, slider16); s92_kc = S92_C_HF; s92_knob(x + 42, y + 78, 19, 16, 4000, 10000, 4500, 1, "FREQ", "", 0); s92_kc = 0;
  s92_knob(x + 118, y + 78, 19, 17, -50, 0, -28, 0, "THRESH", "%.1f dB", 0);
  s92_knob(x + 42, y + 170, 16, 18, 0, 12, 6, 0, "RANGE", "%.1f dB", 0);
  g9_key(x + 86, y + 158, 62, 24, 19, "LISTEN");
  sprintf(#g9_v, "-%.1f dB", g_ds); s92_smallc(x + 117, y + 214, slider15 >= 0.5 ? #g9_v : "OUT");
);
function m_fet(x, y) local(i) (
  s92_mod(x, y, 186, 276, "FET"); s92_onoff(x + 108, y + 2, 20);
  s92_knob(x + 48, y + 76, 24, 21, 0, 24, 6, 0, "AMOUNT", "%.1f dB", 0);
  i = 0; loop(4,
    s92_key(x + 98 + (i % 2) * 42, y + 38 + floor(i / 2) * 30, 38, 24, (slider22 | 0) == i, i == 0 ? "4" : i == 1 ? "8" : i == 2 ? "12" : "20") ? s92_set(22, i);
    i += 1; );
  s92_cap(x + 137, y + 110, "RATIO");
  s92_knob(x + 50, y + 160, 15, 23, 20, 800, 250, 1, "ATTACK", "%.0f us", 0);
  s92_knob(x + 134, y + 160, 15, 24, 50, 1100, 120, 1, "RELEASE", "%.0f ms", 0);
  g9mF.s92_gredge(x + 8, y + 222, 170, 44, slider20 >= 0.5 ? -g_fet : 0, "GR");
);
// the EQ: four columns (LF, LMF, HMF, HF), each GAIN, FREQ and Q (LF / HF: their SHELF / BELL keys), in the band's colour
function g9_eqcol(cx, y, nm, cap, ig, iff, flo, fhi, fdf, iq, ik, gdf) (
  gfx_setfont(12); ui_col(cap == S92_C_LPF ? S92_INK : ui_mix(cap, 0xFFFFFF, 0.35)); s92_tc(cx, y + 36, nm);
  s92_kc = cap; s92_knob(cx, y + 76, 18, ig, -15, 15, gdf, 0, "GAIN", "%+.1f dB", 0);
  g9_hz(#s92_vs, slider(iff)); s92_kc = cap; s92_knob(cx, y + 156, 16, iff, flo, fhi, fdf, 1, "FREQ", "", 0);
  iq > 0 ? ( s92_kc = cap; s92_knob(cx, y + 234, 12, iq, 0.4, 4, 0.8, 1, "Q", "%.2f", 0); ) : (
    s92_key(cx - 41, y + 222, 40, 22, slider(ik) < 0.5, "SHELF") ? s92_set(ik, 0);
    s92_key(cx + 1, y + 222, 40, 22, slider(ik) >= 0.5, "BELL") ? s92_set(ik, 1);
  );
  s92_kc = 0;
);
function m_eq(x, y) (
  s92_mod(x, y, 376, 276, "EQ"); s92_onoff(x + 296, y + 2, 25);
  gfx_setfont(13); ui_col(S92_DIM); s92_t(x + 40, y + 6, g9_m ? "PROPORTIONAL Q  ·  CRISP TOP" : "BROAD  ·  CONSOLE  ·  SWEET TOP");
  ui_cola(S92_RULE, 0.25); s92_r(x + 96, y + 32, 1, 234); s92_r(x + 188, y + 32, 1, 234); s92_r(x + 280, y + 32, 1, 234);
  g9_eqcol(x + 50, y, "LF", S92_C_LF, 26, 27, 30, 450, 100, 0, 28, 0);
  g9_eqcol(x + 142, y, "LMF", S92_C_LMF, 10, 9, 120, 2000, 240, 11, 0, 2.5);
  g9_eqcol(x + 234, y, "HMF", S92_C_HMF, 51, 52, 600, 8000, 2800, 53, 0, -2);
  g9_eqcol(x + 326, y, "HF", S92_C_HF, 54, 55, 1500, 16000, 7000, 0, 56, -4);
);
function m_sat(x, y) (
  s92_mod(x, y, 136, 242, "SATURATION");
  s92_knob(x + 68, y + 104, 28, 29, 0, 100, 25, 0, "AMOUNT", "%.0f%%", 0);
  s92_smallc(x + 68, y + 180, g9_m ? "VALVE · CONSOLE" : "TAPE");
  s92_smallc(x + 68, y + 198, slider29 > 0.05 ? "" : "OUT");
);
function m_flng(x, y) (
  s92_mod(x, y, 262, 242, "FLANGER"); s92_onoff(x + 184, y + 2, 30);
  sprintf(#g9_v, "%s  %.2f MS", g9_m ? "RACK" : "PEDAL", t9f_dl / srate * 1000); s92_lcd(x + 12, y + 34, 238, 24, #g9_v);
  s92_knob(x + 38, y + 112, 18, 31, 0.02, 3, 0.15, 1, "RATE", "%.2f Hz", 0);
  s92_knob(x + 100, y + 112, 18, 32, 0, 100, 35, 0, "DEPTH", "%.0f%%", 0);
  s92_knob(x + 164, y + 112, 18, 33, -90, 90, 20, 0, "FEEDBACK", "%+.0f%%", 0);
  s92_knob(x + 226, y + 112, 18, 34, 0, 100, 40, 0, "MIX", "%.0f%%", 0);
  g9_key(x + 18, y + 182, 76, 24, 35, "STEREO");
  s92_smallc(x + 178, y + 194, "SLOW · SUBTLE SWEEP");
);
function m_slap(x, y) (
  s92_mod(x, y, 252, 242, "SLAPBACK"); s92_onoff(x + 174, y + 2, 36);
  slider38 >= 0.5 ? sprintf(#g9_v, "SYNC  %.0f MS", t9d_ms) : sprintf(#g9_v, "%.0f MS", t9d_ms); s92_lcd(x + 12, y + 34, 228, 24, #g9_v);
  sprintf(#s92_vs, "%.0f ms", slider37);
  s92_off = slider38 >= 0.5; s92_knob(x + 38, y + 112, 18, 37, 60, 180, 110, 0, "TIME", "", 0); s92_off = 0;
  s92_kc = S92_C_LPF; s92_knob(x + 98, y + 112, 18, 39, 0, 100, 35, 0, "TONE", "%.0f%%", 0); s92_kc = 0;
  s92_knob(x + 160, y + 112, 18, 40, 0, 50, 12, 0, "FEEDBACK", "%.0f%%", 0);
  s92_knob(x + 220, y + 112, 18, 41, 0, 100, 25, 0, "MIX", "%.0f%%", 0);
  s92_cap(x + 40, y + 194, "SYNC");
  g9_drop(x + 74, y + 181, 112, 26, 38, "FREE|1/32|1/16 T|1/16|1/8 T");
);
function m_space(x, y) (
  s92_mod(x, y, 318, 242, "SPACE"); s92_onoff(x + 240, y + 2, 42);
  t9r_tt >= 1 ? sprintf(#g9_v, "%s  %.1f S  ·  %.0f MS", g9_m ? "HALL" : "ROOM", t9r_tt, t9r_pms * 1000)
              : sprintf(#g9_v, "%s  %.2f S  ·  %.0f MS", g9_m ? "HALL" : "ROOM", t9r_tt, t9r_pms * 1000);
  s92_lcd(x + 12, y + 34, 294, 24, #g9_v);
  sprintf(#s92_vs, "%.0f%%", slider43); s92_knob(x + 40, y + 112, 18, 43, 0, 100, 50, 0, "SIZE", "", 0);
  t9r_tt >= 1 ? sprintf(#s92_vs, "%.1f s", t9r_tt) : sprintf(#s92_vs, "%.0f ms", t9r_tt * 1000);
  s92_knob(x + 104, y + 112, 18, 44, 0, 100, 50, 0, "DECAY", "", 0);
  sprintf(#s92_vs, "%.0f ms", t9r_pms * 1000); s92_knob(x + 176, y + 112, 18, 45, 0, 100, 40, 0, "PRE-DELAY", "", 0);
  g9_hz(#s92_vs, 16000 * 0.09 ^ t9r_dpt); s92_kc = S92_C_LPF; s92_knob(x + 250, y + 112, 18, 46, 0, 100, 50, 0, "TONE", "", 0); s92_kc = 0;
  s92_knob(x + 40, y + 192, 18, 47, 0, 100, 20, 0, "MIX", "%.0f%%", 0);
  sprintf(#s92_vs, "%.0f%%  (%.1f dB)", slider48, slider48 * 0.15); s92_knob(x + 104, y + 192, 18, 48, 0, 100, 40, 0, "DUCK", "", 0);
  g9mD.s92_gredge(x + 140, y + 166, 166, 44, slider42 >= 0.5 ? -g_du : 0, "DUCK");
  s92_smallc(x + 223, y + 226, g9_m ? "BIG BRIGHT HALL" : "SMALL DARK ROOM");
);
function m_out(x, y) (
  s92_mod(x, y, 156, 242, "OUTPUT");
  s92_knob(x + 42, y + 70, 18, 49, 0, 100, 50, 0, "DRIFT", "%.0f%%", 0);
  s92_knob(x + 114, y + 70, 20, 50, -12, 12, 0, 0, "OUTPUT", "%+.1f dB", 0);
  g9mI.s92_edge(x + 8, y + 118, 140, 44, g_pi * 2.83, "IN");
  g9mU.s92_edge(x + 8, y + 168, 140, 44, g_po * 2.83, "OUT");
  pk_led((x + 22) * sc, (y + 226) * sc, 3.5 * sc, g_clp, S92_RED);
  s92_smallc(x + 86, y + 226, "CLIP · ALWAYS ON");
);

// ---------- the frame ----------
g9_m = slider1 >= 0.5;
g9_pal(g9_m);
s92_fonts();
s92_face(1200, 600);
// the panel's mailboxes, read and cleared here
g_op = min(mb_op, g_op * 0.8); mb_op = 0;
g_fet = min(mb_fet, g_fet * 0.8); mb_fet = 0;
g_ds = max(mb_ds, g_ds * 0.8); mb_ds = 0;
g_du = min(mb_du, g_du * 0.85); mb_du = 0;
g_pi = max(pk_in, g_pi * 0.8); pk_in = 0;
g_po = max(pk_out, g_po * 0.8); pk_out = 0;
g_clp = ost_clipped; ost_clipped = 0;
g_grd = in_grd; in_grd = 0;

// ---------- the header: the 92 badge, the name, the small print, presets, ORDER, the MODEL keys, the size picker ----------
ui_col(0x2A2C2F); s92_rr(24, 13, 32, 28, 3);
ui_col(S92_SILVER); s92_rr(25, 14, 30, 26, 2.5);
gfx_setfont(15); ui_col(0x111213); s92_tc(40, 27, "92");
gfx_setfont(14); ui_col(0xEDEFF1); gfx_measurestr("STR92", g9_tw, g9_th); gfx_x = 66 * sc; gfx_y = 13 * sc - g9_th * 0.17; gfx_drawstr("STR92");
g9_sx = 66 + g9_tw / sc + 14;
gfx_setfont(13); ui_col(0x9AA0A6); s92_t(g9_sx, 15, "SERIES 92"); s92_t(g9_sx, 29, g9_m ? "VOCAL STRIP · STORM" : "VOCAL STRIP · SMOKE"); ver_tag_at("v2", 16, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1);
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
gk_ = pk_preset(300 * sc, 10 * sc, 384 * sc, 34 * sc, pr_cur, #vx_pm);
gk_ > 0 ? prs_dirty = gk_;
g9ok.s92_orderkey(700, 15, 162, 24, slider2 >= 0.5 ? "EQ > DYNAMICS" : "DYNAMICS > EQ") ? s92_set(2, slider2 >= 0.5 ? 0 : 1);
s92_key(948, 15, 72, 24, !g9_m, "SMOKE") ? s92_set(1, 0);
s92_key(1024, 15, 72, 24, g9_m, "STORM") ? s92_set(1, 1);
ui_size_picker(1116 * sc, 18 * sc);

// ---------- the top row: PREAMP, LOW END, then the EQ and the dynamics in the chosen order ----------
g9_o = slider2 >= 0.5;
m_pre(20, 62);
m_low(168, 62);
m_eq(g9_o ? 280 : 800, 62);
m_opto(g9_o ? 664 : 280, 62);
m_dess(g9_o ? 822 : 438, 62);
m_fet(g9_o ? 990 : 606, 62);
// ---------- the bottom row: SATURATION, FLANGER, SLAPBACK, SPACE, OUTPUT ----------
m_sat(20, 346);
m_flng(164, 346);
m_slap(434, 346);
m_space(694, 346);
m_out(1020, 346);

pk_end();
ui_end();
