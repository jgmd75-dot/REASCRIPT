  mg_i = 0; loop(166, ui_cola(0xFFFFFF, mg_i % 2 ? 0.012 : 0.022); mg_R(8, 6 + mg_i * 2, 884, 0.5); mg_i += 1; );   // fine anodised grain
  rd_screw(14, 14); rd_screw(886, 14); rd_screw(14, 326); rd_screw(886, 326);
  mg_header(FV, mg_ink, "MU-2   STEREO VARI-MU");
  ui_col(0xFFB040); mg_R(16, 58, 868, 2);

  mg_plate(16, 66, 274, 162, 0x22303A, 0x0A1013, 1, 0.08); mg_plate(610, 66, 274, 162, 0x22303A, 0x0A1013, 1, 0.08);
  mg_plate(16, 236, 274, 92, 0x1A252B, 0x0A1013, 1, 0.08); mg_plate(610, 236, 274, 92, 0x1A252B, 0x0A1013, 1, 0.08);
  FM = 0x172126;
