  mg_num(206, 148, 58, 0.75, "-10", 12); mg_num(206, 148, 58, 1, "0", 12);
  mg_knob(206, 148, 36, 10, -40, 0, -12, 0, 0, 1, 0);
  mg_lbl(206, 202, "THRESHOLD", 15); mg_act ? mg_val(206, 222, mg_db(slider10));
  mg_ticks(714, 148, 34, 11, 5);
  mg_num(714, 148, 56, 0, "0.1", 12); mg_num(714, 148, 56, 0.404, "1", 12); mg_num(714, 148, 56, 0.807, "10", 12); mg_num(714, 148, 56, 1, "30", 12);
  mg_knob(714, 148, 34, 11, 0.1, 30, 10, 1, 0, 1, 0);
  mg_lbl(714, 202, "ATTACK", 15); slider11 < 1 ? sprintf(#mg_v, "%.2f ms", slider11) : sprintf(#mg_v, "%.1f ms", slider11);
  mg_act ? mg_val(714, 222, #mg_v);
  mg_ticks(834, 148, 34, 11, 5);
  mg_num(834, 148, 56, 0, ".05", 12); mg_num(834, 148, 56, 0.339, ".2", 12); mg_num(834, 148, 46, 0.732, "1", 12); mg_num(834, 148, 56, 1, "3 s", 12);
  mg_knob(834, 148, 34, 12, 50, 3000, 300, 1, 0, 1, 0);
  mg_lbl(834, 202, "RELEASE", 15); slider12 >= 1000 ? sprintf(#mg_v, "%.2f s", slider12 / 1000) : sprintf(#mg_v, "%.0f ms", slider12);
  mg_act ? mg_val(834, 222, slider13 > 0.5 ? "AUTO" : #mg_v);

  // lower row: SC HPF x2, MODE | LINK, IRON, MIX, METER | AUTO, DRIFT, OUTPUT
  mg_i = 0; loop(2,
    mg_x = 44 + mg_i * 72; mg_ix = 14 + mg_i;
    mg_ticks(mg_x, 274, 17, 5, 1);
    mg_knob(mg_x, 274, 17, mg_ix, 0, 4, 0, 0, 5, 20, 0xF2C21B);
    mg_lbl(mg_x, 296, mg_ms ? (mg_i ? "HPF S" : "HPF M") : (mg_i ? "HPF R" : "HPF L"), 13);
    mg_hv = slider(mg_ix); mg_act ? mg_val(mg_x, 214, mg_hv < 0.5 ? "OFF" : mg_hv < 1.5 ? "60 Hz" : mg_hv < 2.5 ? "90 Hz" : mg_hv < 3.5 ? "150 Hz" : "250 Hz");
    mg_i += 1; );
  mg_lbl(80, 314, "SIDE-CHAIN", 11);
  mg_key(180, 242, 92, 22, slider16 == 0, LK_RED, "STEREO", 12) ? ( slider16 = 0; ui_auto(16); );
