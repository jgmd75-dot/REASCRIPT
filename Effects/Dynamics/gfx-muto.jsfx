  mg_t = mg_ms ? "SIDE" : mg_lkd ? "LINKED" : "RIGHT";
  slider23 > 0.5 ? ( mg_s = "LEFT"; mg_t = "RIGHT"; );
  mgA.mg_meter(305, 77, 144, 130, slider23 > 0.5 ? mu_vuA : -mu_grA, 1, mg_s);
  mgB.mg_meter(451, 77, 144, 130, slider23 > 0.5 ? mu_vuB : -mu_grB, 1, mg_t);

  // INPUT, THRESHOLD | ATTACK, RELEASE
  mg_ticks(86, 148, 34, 13, 3);
  mg_num(86, 148, 56, 0, "-12", 12); mg_num(86, 148, 56, 1 / 3, "0", 12); mg_num(86, 148, 56, 2 / 3, "+12", 12); mg_num(86, 148, 56, 1, "+24", 12);
  mg_knob(86, 148, 34, 9, -12, 24, 0, 0, 0, 1, 0);
  mg_lbl(86, 202, "INPUT", 15); mg_act ? mg_val(86, 222, mg_db(slider9));
