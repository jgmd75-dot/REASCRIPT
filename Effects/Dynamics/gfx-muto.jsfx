  mg_key(180, 290, 92, 22, slider16 == 2, LK_RED, "M-S", 12) ? ( slider16 = 2; ui_auto(16); );
  mg_lbl(226, 314, "MODE", 11);
  mg_ticks(370, 266, 20, 11, 5);
  mg_knob(370, 266, 20, 17, 0, 100, 100, 0, 0, 1, 0);
  mg_lbl(370, 298, "LINK", 13); mg_act ? mg_val(370, 214, slider16 == 1 ? "DUAL MONO" : mg_pc(slider17));
  mg_ticks(450, 266, 20, 11, 5);
  mg_knob(450, 266, 20, 18, 0, 100, 30, 0, 0, 1, 0);
