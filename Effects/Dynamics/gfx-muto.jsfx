  mg_tog(82, 274, 7, "LINK", "DUAL", "STEREO", LK_RED);
  mg_tog(220, 274, 23, "GR", "OUT", "METER", LK_WHT);
  mg_ticks(405, 270, 22, 11, 5);
  mg_knob(405, 270, 22, 8, 0, 100, 100, 0, 0, 0, 0);
  mg_lbl(405, 304, "MIX", 14); mg_act ? mg_val(405, 214, mg_pc(slider8));
  mg_knob(495, 270, 15, 21, 0, 100, 50, 0, 0, 20, 0x9DA2A8);
  mg_lbl(495, 304, "DRIFT", 14); mg_act ? mg_val(495, 214, mg_pc(slider21));
  mg_tog(714, 274, 5, "NORMAL", "HOLD", "RECOVERY MODE", LK_BLU);
  mg_lbl(834, 248, "POWER", 11);
  rd_lamp(834, 286, 13, 0.85 + 0.1 * sin(time_precise() * 0.7), 0xFF6A1A);
) : (
  // =====================================================================
  // MU-2 MODERN: deep anodised faceplate, machined aluminium knobs, precise legends, warm-lit meters
  // =====================================================================
  FV = 0x1E2A31; mg_ink = 0xDDE3E6; mg_sh = 0x000000; mg_shd = 0; mg_fnt = 1; mg_acc = 0xFFB040; mg_kbg = 0x101416; mg_kink = 0xCBD2D6;
  ui_col(0x0C1114); mg_RR(3, 3, 894, 334, 6);
  ui_col(FV); mg_RR(4, 4, 892, 332, 5);
