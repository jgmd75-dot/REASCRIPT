  mg_num(206, 148, 58, 0.75, "10", 12); mg_num(206, 148, 58, 1, "0", 12);
  mg_knob(206, 148, 36, 3, -40, 0, -10, 0, 0, 0, 0);
  mg_lbl(206, 202, "THRESHOLD", 15); mg_act ? mg_val(206, 222, mg_db(slider3));

