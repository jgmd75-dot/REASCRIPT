function bx_key(x, y, w, h, idx, col, s) (
  lk_key(x, y, w, h, slider(idx) >= 0.5, col, s) ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
);
function bx_hs(x, y, w, idx, lo, hi, def, lbl, fmt) local(v, n, hov, act, cx, tw, th) (
  v = slider(idx); n = (v - lo) / (hi - lo);
  hov = bx_in(x - 8, y - 14, w + 16, 28);
  pressed && hov && drag_id == 0 ? (
    time_precise() - lastclick_t < 0.35 && lastclick_id == idx ? (
      slider(idx) = def; ui_auto(idx); drag_id = -1; lastclick_t = 0;
    ) : (
      drag_id = idx; drag_x = mouse_x; drag_n = n; lastclick_t = time_precise(); lastclick_id = idx;
    );
  );
