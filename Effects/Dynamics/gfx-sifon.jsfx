desc:Sifon [bus compressor] (GFX)
//tags: compressor bus master mastering limiter brickwall mid side transformer
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-input, gfx-ui, gfx-panel, gfx-os and gfx-bypass (.jsfx-inc) in the same folder.

slider1:thr_db=-18<-40,0,0.1>-Threshold (dB)
slider2:ratio_i=1<0,5,1{1.5 to 1,2 to 1,3 to 1,4 to 1,6 to 1,8 to 1}>-Ratio
slider3:att_ms=10<0.1,75,0.1>-Attack (ms)
slider4:rel_ms=300<50,2500,1>-Release (ms)
slider5:rel_auto=0<0,1,1{Off,On}>-Auto release
slider6:mkup_db=0<0,20,0.1>-Make-up (dB)
slider7:blend_pc=100<0,100,1>-Blend (%)
slider8:topo=0<0,1,1{Feed-forward,Feedback}>-Detector
slider9:schpf=0<0,4,1{Off,60 Hz,100 Hz,150 Hz,250 Hz}>-SC HPF
slider10:msmode=0<0,1,1{L/R,M/S}>-Stereo mode
slider11:lnk=1<0,1,1{Off,On}>-Link
slider12:comp_in=1<0,1,1{Out,In}>-Compressor
slider13:lim_ceil=-1<-12,0,0.1>-Limiter ceiling (dB)
slider14:lim_rel=0<0,1,1{Fast,Slow}>-Limiter release
slider15:brick=0<0,1,1{Zero latency,Brickwall}>-Limiter type
slider16:lim_in=0<0,1,1{Out,In}>-Limiter
slider17:trim_db=0<-24,12,0.1>-Input trim (dB)
slider18:guard=0<0,1,1{Off,On}>-Guard
slider19:colour=0<0,3,1{Off,High,Low,Both}>-Colour
slider20:texture=30<0,100,1>-Low texture (%)
slider21:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider22:width_pc=100<0,200,1>-Width (%)
slider23:depth_pc=0<-100,100,1>-Depth (%)
slider24:sidehpf=0<0,3,1{Off,80 Hz,120 Hz,200 Hz}>-Side HPF
slider25:csolo=0<0,1,1{Off,On}>-Colour solo
slider26:lo_wid=100<0,200,1>-Low colour width (%)
slider27:hi_wid=100<0,200,1>-High colour width (%)
slider28:byp=0<0,1,1{Off,On}>-Bypass
slider29:rmsdet=0<0,1,1{Peak,RMS}>-Detector level
slider31:dip22=0<0,1,1{Off,On}>-Dip 220 Hz
slider32:dip3=0<0,1,1{Off,On}>-Dip 3 kHz
slider33:tex_hi=30<0,100,1>-High texture (%)
slider34:prs_sel=0<0,11,1{No preset,Init,Mix Bus Glue,Gentle Master,Drum Bus Smash,M/S Tighten,Warm Low Master,High Sheen Mix,Wide and Open,Vocal Bus Smooth,Loud and Safe,Parallel Crush}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-os.jsfx-inc
import gfx-bypass.jsfx-inc

@init
#ui_man = "gfx-sifon";
ext_noinit = 1;

DLINE = 100000;
GHIST = 102048;
DQV = 103072; DQI = 104096;
TPK = 105120;
TPH = 105300;
RMASK = 1023;
DRY = 106000;
XCH = 110000;

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(g) ( log(max(g, 0.000000001)) * 8.685889638065035; );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );

function svf_hp2(x) instance(s1, s2) local(hp, v1, v2, bp) (
  hp = (x - (sh_gw + 1.4142135623730951) * s1 - s2) * sh_h;
  v1 = sh_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = sh_gw * bp; s2 = s2 + 2 * v2;
  hp;
);
function svf_hp(x) instance(s1, s2) local(hp, v1, v2, bp) (
  hp = (x - (sc_gw + 1.4142135623730951) * s1 - s2) * sc_h;
  v1 = sc_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = sc_gw * bp; s2 = s2 + 2 * v2;
  hp;
);

function gcurve(o, sl, kw) (
  o <= -0.5 * kw ? 0 : o >= 0.5 * kw ? o * sl : sl * sqr(o + 0.5 * kw) / (2 * kw);
);

function tp_design() local(p, k, t, w, x, s) (
  p = 0;
  loop(7,
    s = 0; k = 0;
    loop(16,
      t = (k - 7) - (p + 1) * 0.125;
      x = t / 8.5; w = abs(x) < 1 ? 0.42 + 0.5 * cos($pi * x) + 0.08 * cos(2 * $pi * x) : 0;
      TPK[p * 16 + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
      s += TPK[p * 16 + k]; k += 1;
    );
    k = 0; loop(16, TPK[p * 16 + k] /= s; k += 1; );
    p += 1;
  );
);
function tp_peak(ch, x) local(h, b, p, m, y, a, c, e, d, q, pv) (
  h = TPH + ch * 32 + (tp_w & 15);
  h[0] = x; h[16] = x;
  h = TPH + ch * 32 + ((tp_w + 1) & 15);
  pv = h[7]; m = abs(pv); a = c = e = 0; p = 0;
  loop(8,
    p < 7 ? (
      b = TPK + p * 16;
      y = b[0] * h[0] + b[1] * h[1] + b[2] * h[2] + b[3] * h[3] + b[4] * h[4] + b[5] * h[5] + b[6] * h[6] + b[7] * h[7]
        + b[8] * h[8] + b[9] * h[9] + b[10] * h[10] + b[11] * h[11] + b[12] * h[12] + b[13] * h[13] + b[14] * h[14]
        + b[15] * h[15];
    ) : y = h[8];
    abs(y) > m ? ( m = abs(y); a = pv; c = y; e = 0; q = 1; ) : q ? ( e = y; q = 0; );
    pv = y; p += 1;
  );
  c != 0 && e != 0 ? (
    c < 0 ? ( a = -a; c = -c; e = -e; );
    d = 2 * c - a - e;
    d > 0.000000001 ? (
      b = max(min(0.5 * (e - a) / d, 0.5), -0.5);
      m = max(m, c + 0.5 * (e - a) * b - 0.5 * d * b * b);
    );
  );
  m;
);

function op_lp(x, gg) instance(s) local(v, y) ( v = (x - s) * gg; y = v + s; s = y + v; y; );
function bq_set(t, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w, cw, al, a, sa, n) (
  w = 2 * $pi * min(f, 0.45 * bq_fs) / bq_fs; cw = cos(w); al = sin(w) / (2 * q); a = 10 ^ (gdb / 40);
  t == 0 ? ( n = 1 + al; b0 = (1 + cw) / 2 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  t == 1 ? ( n = 1 + al / a; b0 = (1 + al * a) / n; b1 = -2 * cw / n; b2 = (1 - al * a) / n; a1 = b1; a2 = (1 - al / a) / n; ) :
  t == 2 ? ( sa = 2 * sqrt(a) * al; n = (a + 1) + (a - 1) * cw + sa;
    b0 = a * ((a + 1) - (a - 1) * cw + sa) / n; b1 = 2 * a * ((a - 1) - (a + 1) * cw) / n; b2 = a * ((a + 1) - (a - 1) * cw - sa) / n;
    a1 = -2 * ((a - 1) + (a + 1) * cw) / n; a2 = ((a + 1) + (a - 1) * cw - sa) / n; ) :
  t == 4 ? ( n = 1 + al; b0 = al / n; b1 = 0; b2 = -b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  ( sa = 2 * sqrt(a) * al; n = (a + 1) - (a - 1) * cw + sa;
    b0 = a * ((a + 1) + (a - 1) * cw + sa) / n; b1 = -2 * a * ((a - 1) + (a + 1) * cw) / n; b2 = a * ((a + 1) + (a - 1) * cw - sa) / n;
    a1 = 2 * ((a - 1) - (a + 1) * cw) / n; a2 = ((a + 1) - (a - 1) * cw - sa) / n; );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function sat3(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function sat3d(b) ( (sat3(b + 0.0001) - sat3(b - 0.0001)) * 5000; );
function sdiff(x, k, b, d) ( (sat3(k * x + b) - sat3(b)) / (k * d) - x; );
function hfund(h, x) instance(cxy, cxx) (
  cxy += (h * x - cxy) * cg_cr; cxx += (x * x - cxx) * cg_cr;
  h - x * (cxx > 0.000000000001 ? cxy / cxx : 1);
);
function th(v) local(e) ( e = exp(2 * max(min(v, 20), -20)); (e - 1) / (e + 1); );
function hsat(x, g, b, tb, c) ( (th(g * x + b) - tb) * c; );
function hs_coefs() local(g) (
  g_hl = db2g(18 * tex_s); g_hh = db2g(18 * txh_s);
  tb_hi = th(0.3); c_hi = 0.25 / (th(g_hh * 0.125 + 0.3) - th(0.3 - g_hh * 0.125));
  tb_lo = th(0.4); c_lo = 0.25 / (th(g_hl * 0.125 + 0.4) - th(0.4 - g_hl * 0.125));
  t2 = max(0, 2 * tex_s - 1); t2h = max(0, 2 * txh_s - 1); tex_q = tex_s; txh_q = txh_s;
  bq_fs = srate;
  eqL.h2.bq_set(3, 15000, 0.707, 3 * t2h); eqL.l1.bq_set(2, 120, 0.707, 2.3 * t2);
  eqR.h2.bq_set(3, 15000, 0.707, 3 * t2h); eqR.l1.bq_set(2, 120, 0.707, 2.3 * t2);
  gd3_q = -6 * d3_s; gd22_q = -9 * d22_s;
  bq_fs = srate * os_f;
  chL.hd.bq_set(1, 3000, 0.6, gd3_q); chL.ld.bq_set(1, 220, 2.5, gd22_q);
  chR.hd.bq_set(1, 3000, 0.6, gd3_q); chR.ld.bq_set(1, 220, 2.5, gd22_q);
);
function dyn_init() (
  bq_fs = srate; dd_a.bq_set(4, 220, 2.5, 0); dd_b.bq_set(4, 3000, 0.6, 0);
  c_dpw = coef(0.02); c_dat = coef(0.005); c_drl = coef(0.12);
);
function dyn_run(m) local(p22, p3) (
  p22 = dd_a.bq_run(m); p3 = dd_b.bq_run(m);
  dp_f += (m * m - dp_f) * c_dpw; dp_a += (p22 * p22 - dp_a) * c_dpw; dp_b += (p3 * p3 - dp_b) * c_dpw;
  (dd_n += 1) >= 16 ? (
    dd_n = 0;
    dp_f > 0.0000000001 ? (
      dx_a = min(6, max(0, 0.5 * (10 * log10(dp_a / dp_f + 0.000000000001) + 10)));
      dx_b = min(6, max(0, 0.5 * (10 * log10(dp_b / dp_f + 0.000000000001) + 9)));
    ) : ( dx_a = dx_b = 0; );
    dx_a *= d22_s * w_blue; dx_b *= d3_s * w_red;
    dg_a += (dx_a - dg_a) * (dx_a > dg_a ? 16 * c_dat : 16 * c_drl);
    dg_b += (dx_b - dg_b) * (dx_b > dg_b ? 16 * c_dat : 16 * c_drl);
    bq_fs = srate;
    dqL.a.bq_set(1, 220, 2.5, -dg_a); dqR.a.bq_set(1, 220, 2.5, -dg_a);
    dqL.b.bq_set(1, 3000, 0.6, -dg_b); dqR.b.bq_set(1, 3000, 0.6, -dg_b);
    dyn_disp = max(dg_a, dg_b);
  );
);
function hs_tone(x) instance(h2, l1, l3) local(y) (
  y = x + w_red * (this.h2.bq_run(x) - x);
  y += t2 * (this.l3.bq_run(y) - y) * w_blue;
  y + w_blue * (this.l1.bq_run(y) - y);
);
function colour_run(u) instance(ip, rp, bp, ep, hc, lc, ic, sp, hd, ld) local(lo, hi, bl, di, dr, dd, y, band, ev, eb) (
  lo = this.ip.op_lp(u, cg_iron);
  hi = u - this.rp.op_lp(u, cg_red);
  bl = this.bp.op_lp(u, cg_blue);
  di = this.ic.hfund(sdiff(lo, k_iron, 0.12, sd_i) + lo, lo);
  dd = a_lo * this.ld.bq_run(this.lc.hfund(hsat(bl, g_hl, 0.4, tb_lo, c_lo), bl));
  ev = this.hc.hfund(hsat(hi, g_hh, 0.3, tb_hi, c_hi), hi);
  dr = a_hi * this.hd.bq_run(ev - this.ep.op_lp(ev, cg_red));
  this.dlo = w_blue * dd; this.dhi = w_red * dr;
  y = u + di + w_red * sh_hi * (u - this.sp.op_lp(u, cg_sh)) + w_blue * sh_lo * bl;
  band = max(1 - w_red - w_blue, 0) * (lo + di) + w_red * hi + w_blue * bl;
  y + so_s * (band - y);
);
function cw_add() local(m, d) (
  m = 0.5 * (chL.dlo + chR.dlo); d = 0.5 * (chL.dlo - chR.dlo);
  cwa = m * lwm_g + d * lws_g; cwb = m * lwm_g - d * lws_g;
  m = 0.5 * (chL.dhi + chR.dhi); d = 0.5 * (chL.dhi - chR.dhi);
  cwa += m * hwm_g + d * hws_g; cwb += m * hwm_g - d * hws_g;
);
function colour_coefs(f) local(g) (
  g = tan($pi * 150 / (srate * f)); cg_iron = g / (1 + g);
  g = tan($pi * 3000 * 2 ^ (-1.6 * txh_s) / (srate * f)); cg_red = g / (1 + g); tex_r = txh_s;
  g = tan($pi * 300 / (srate * f)); cg_blue = g / (1 + g);
  cg_cr = 1 - exp(-1 / (0.03 * srate * f));
  g = tan($pi * 4730 / (srate * f)); cg_sh = g / (1 + g);
);

function set_rate() local(g) (
  la_n = ceil(0.0015 * srate);
  la_w = la_n + 1;
  la_d = la_n + 7;
  c_sw = coef(0.015); c_rms = coef(0.015); c_kn = coef(0.03); c_lk = coef(0.01);
  dip_c = 1 / (0.005 * srate);
  c_vu = coef(0.3);
  sc_tw = tan($pi * 10 / srate);
  dc_c = 1 - 2 * $pi * 5 / srate;
  g = tan($pi * 1500 / srate); dp_g = g / (1 + g);
  zl_att = coef(0.0001);
);

function bx_params() (
  rat_t = ratio_i == 0 ? 1.5 : ratio_i == 1 ? 2 : ratio_i == 2 ? 3 : ratio_i == 3 ? 4 : ratio_i == 4 ? 6 : 8;
  sc_f = schpf == 1 ? 60 : schpf == 2 ? 100 : schpf == 3 ? 150 : schpf == 4 ? 250 : 10;
  sc_tt = tan($pi * sc_f / srate);
  c_att = coef(att_ms * 0.001);
  c_rel = coef(rel_ms * 0.001);
  c_af = coef(0.08); c_as = coef(2.0); c_aa = coef(0.4);
  ceil_t = db2g(lim_ceil);
  lr_t = lim_rel ? 0.35 : 0.06;
  in_setup(trim_db, guard);
  os_tf = os_f2n(os_sl);
  sidehpf ? sh_tw = tan($pi * (sidehpf == 1 ? 80 : sidehpf == 2 ? 120 : 200) / srate);
);

function clear_lim() (
  memset(DLINE, 0, 2048); memset(GHIST, 0, 1024);
  dq_h = dq_t = 0; g_sum = 0; g_rl = 1;
  wp = 0; tn = 0;
  memset(TPH, 0, 64); tp_w = 0;
  k = 0; loop(1024, GHIST[k] = 1; k += 1; ); g_sum = la_n;
  zl_env = 0;
);

in_init();
sd_e = sat3d(0.4); sd_i = sat3d(0.12); sd_r = sat3d(0.05); sd_b = sat3d(0.35);
hs_ah = 1; hs_al = 1;
bq_fs = srate; eqL.l3.bq_set(0, 30, 0.707, 0); eqR.l3.bq_set(0, 30, 0.707, 0);
os_design();
os_f = os_tf = os_f2n(os_sl); d22_s = dip22; d3_s = dip3; tex_s = texture * 0.01; txh_s = tex_hi * 0.01; hs_coefs(); dyn_init();
colour_coefs(os_f);
tp_design();
set_rate();
clear_lim();

ms_on = msmode; brk_on = brick;
dip_g = 1; dip_hold = 0; rs_f = 1; rs_c = 1 / (0.015 * srate); dw = 0; memset(DRY, 0, 2048);
os_base = brk_on ? la_d : 0;
os_gsetup();

env_fa = env_fb = env_sa = env_sb = 0;
fb_ga = fb_gb = 0; fbs_a = fbs_b = 0;
env_ffa = env_ffb = 0;
rq_a = rq_b = rq_fa = rq_fb = 0; rms_s = rmsdet;
yfa = yfb = 0;
thr_s = thr_db; rat_s = 2; mk_s = db2g(mkup_db); bl_s = blend_pc / 100;
top_s = topo; lk_s = lnk; cin_s = comp_in; lin_s = lim_in; ceil_s = db2g(lim_ceil);
sc_gw = sc_tw; sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
lr_s = 0.06;
w_red = colour & 1; w_blue = (colour & 2) > 0; tex_s = texture * 0.01; txh_s = tex_hi * 0.01;
d22_s = dip22; d3_s = dip3; dg_a = dg_b = 0;
lw_s = lo_wid * 0.01; hw_s = hi_wid * 0.01;
wid_s = width_pc * 0.01; dep_s = depth_pc * 0.01; shp_s = sidehpf > 0;
sh_gw = sh_tw = tan($pi * 80 / srate); sh_h = 1 / (1 + sh_gw * (sh_gw + 1.4142135623730951));

#bx_pmn = "Init|Mix Bus Glue|Gentle Master|Drum Bus Smash|M/S Tighten|Warm Low Master|High Sheen Mix|Wide and Open|Vocal Bus Smooth|Loud and Safe|Parallel Crush";
function load_preset(p) local(i) (
  thr_db = -18; ratio_i = 1; att_ms = 10; rel_ms = 300; rel_auto = 0; mkup_db = 0; blend_pc = 100; topo = 0; rmsdet = 0;
  schpf = 0; msmode = 0; lnk = 1; comp_in = 1; lim_ceil = -1; lim_rel = 0; brick = 0; lim_in = 0;
  colour = 0; texture = 30; dip22 = 0; dip3 = 0; lo_wid = 100; hi_wid = 100; width_pc = 100; depth_pc = 0; sidehpf = 0;
  p == 2 ? ( thr_db = -24; ratio_i = 0; att_ms = 30; rel_auto = 1; mkup_db = 2; topo = 1; schpf = 2; ) :
  p == 3 ? ( thr_db = -20; ratio_i = 0; att_ms = 30; rel_ms = 600; mkup_db = 1.5; schpf = 1; lim_in = 1; brick = 1; texture = 20; ) :
  p == 4 ? ( thr_db = -30; ratio_i = 3; att_ms = 3; rel_ms = 120; mkup_db = 6; blend_pc = 50; colour = 1; texture = 60; dip3 = 1; ) :
  p == 5 ? ( msmode = 1; lnk = 0; thr_db = -22; att_ms = 15; rel_auto = 1; mkup_db = 2; sidehpf = 2; width_pc = 110; ) :
  p == 6 ? ( thr_db = -22; att_ms = 20; rel_auto = 1; mkup_db = 2; colour = 2; texture = 45; dip22 = 1; lim_in = 1; brick = 1; ) :
  p == 7 ? ( thr_db = -24; ratio_i = 0; att_ms = 30; rel_auto = 1; mkup_db = 1.5; colour = 1; texture = 50; depth_pc = 30; ) :
  p == 8 ? ( thr_db = -20; ratio_i = 0; rel_auto = 1; mkup_db = 1; width_pc = 130; depth_pc = 40; sidehpf = 2; ) :
  p == 9 ? ( topo = 1; thr_db = -26; ratio_i = 2; att_ms = 8; rel_ms = 200; mkup_db = 4; colour = 1; texture = 25; dip3 = 1; ) :
  p == 10 ? ( thr_db = -26; ratio_i = 3; att_ms = 10; rel_auto = 1; mkup_db = 5; lim_in = 1; brick = 1; lim_ceil = -0.3;
              colour = 2; texture = 40; dip22 = 1; schpf = 2; ) :
  p == 11 ? ( thr_db = -40; ratio_i = 5; att_ms = 1; rel_ms = 80; mkup_db = 12; blend_pc = 35; );
  tex_hi = texture;
  i = 1; loop(27, i != 17 && i != 18 && i != 21 && i != 25 ? ui_auto(i); i += 1; );
  ui_auto(29); ui_auto(31); ui_auto(32); ui_auto(33);
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(34, i != 34 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function lat_snap() (
  os_tf != os_f ? ( os_f = os_tf; os_g = 1; os_hold = 0; colour_coefs(os_f); hs_coefs(); );
  brk_on != brick ? ( brk_on = brick; clear_lim(); os_base = brk_on ? la_d : 0; );
  ms_on = msmode; dip_g = 1; dip_hold = 0;
  pdc_delay = os_base + os_lat(os_f); rs_req = 1;
);
lt_fresh = 1;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@slider
prs_chk();
bx_params();
lt_fresh ? lat_snap();

@block
prs_chk();
bx_params();
lt_fresh ? ( lat_snap(); lt_fresh = 0; );
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
xn = min(num_ch, 64) - 2;
pdc_bot_ch = 0; pdc_top_ch = 2 + max(xn, 0);
c_lra = coef(lr_s);

@sample
rs_req ? (
  rs_req = 0; rs_f = 0; rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay;
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  chL.ip.s = chL.rp.s = chL.bp.s = chL.ep.s = chR.ip.s = chR.rp.s = chR.bp.s = chR.ep.s = 0;
  chL.hc.cxy = chL.hc.cxx = chL.lc.cxy = chL.lc.cxx = chR.hc.cxy = chR.hc.cxx = chR.lc.cxy = chR.lc.cxx = 0;
  chL.ic.cxy = chL.ic.cxx = chR.ic.cxy = chR.ic.cxx = 0; chL.sp.s = chR.sp.s = 0;
  chL.hd.z1 = chL.hd.z2 = chL.ld.z1 = chL.ld.z2 = chR.hd.z1 = chR.hd.z2 = chR.ld.z1 = chR.ld.z2 = 0;
  memset(DLINE, 0, 2048); memset(DRY, 0, 2048);
  memset(XCH, 0, 62 * 1024);
);
rw_l = spl0; rw_r = spl1;
(ms_on != msmode || brk_on != brick) ? (
  dip_g = max(dip_g - dip_c, 0);
  dip_g == 0 ? (
    ms_on = msmode;
    brk_on != brick ? (
      brk_on = brick; clear_lim();
      os_base = brk_on ? la_d : 0; pdc_delay = os_base + os_lat(os_f);
      dip_hold = pdc_delay + 8 + 2 * samplesblock;
    );
  );
) : dip_hold > 0 ? dip_hold -= 1 : dip_g < 1 ? dip_g = min(dip_g + dip_c, 1);

thr_s += (thr_db - thr_s) * c_kn;
rat_s += (rat_t - rat_s) * c_kn;
mk_s += (db2g(mkup_db) - mk_s) * c_kn;
bl_s += (blend_pc * 0.01 - bl_s) * c_kn;
top_s += (topo - top_s) * c_sw;
rms_s += (rmsdet - rms_s) * c_sw; rmsdet < 0.5 && rms_s < 0.000001 ? rms_s = 0;
lk_s += (lnk - lk_s) * c_lk;
cin_s += (comp_in - cin_s) * c_sw;
lin_s += (lim_in - lin_s) * c_sw;
ceil_s += (ceil_t - ceil_s) * c_kn;
lr_s += (lr_t - lr_s) * c_kn;
sc_gw += (sc_tt - sc_gw) * c_kn;
sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
so_s += (csolo - so_s) * c_sw;
lw_s += (lo_wid * 0.01 - lw_s) * c_kn; hw_s += (hi_wid * 0.01 - hw_s) * c_kn;
lwm_g = min(1, 2 - lw_s); lws_g = min(1, lw_s); hwm_g = min(1, 2 - hw_s); hws_g = min(1, hw_s);
w_red += ((colour & 1) - w_red) * c_kn; w_blue += (((colour & 2) > 0) - w_blue) * c_kn;
tex_s += (texture * 0.01 - tex_s) * c_kn; txh_s += (tex_hi * 0.01 - txh_s) * c_kn;
abs(txh_s - tex_r) > 0.0005 ? ( tex_r = txh_s; tx_g = tan($pi * 3000 * 2 ^ (-1.6 * txh_s) / (srate * os_f)); cg_red = tx_g / (1 + tx_g); );
k_iron = db2g(-17 + 27 * tex_s);
a_hi = hs_ah; a_lo = hs_al;
sh_hi = db2g(3.1 * txh_s) - 1; sh_lo = db2g(2.5 * min(tex_s, 0.5)) - 1;
d22_s += (dip22 - d22_s) * c_sw; d3_s += (dip3 - d3_s) * c_sw;
abs(d22_s - dip22) < 0.0001 ? d22_s = dip22; abs(d3_s - dip3) < 0.0001 ? d3_s = dip3;
abs(tex_s - tex_q) > 0.002 || (tex_s != tex_q && tex_s == texture * 0.01) ||
  abs(txh_s - txh_q) > 0.002 || (txh_s != txh_q && txh_s == tex_hi * 0.01) ||
  abs(-6 * d3_s - gd3_q) > 0.03 || abs(-9 * d22_s - gd22_q) > 0.03 ? hs_coefs();
wid_s += (width_pc * 0.01 - wid_s) * c_kn; dep_s += (depth_pc * 0.01 - dep_s) * c_kn;
shp_s += ((sidehpf > 0) - shp_s) * c_sw;
sh_gw += (sh_tw - sh_gw) * c_kn; sh_h = 1 / (1 + sh_gw * (sh_gw + 1.4142135623730951));
os_gate();
os_chg ? (
  colour_coefs(os_f); hs_coefs();
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  chL.ip.s = chL.rp.s = chL.bp.s = chL.ep.s = chR.ip.s = chR.rp.s = chR.bp.s = chR.ep.s = 0;
  chL.hc.cxy = chL.hc.cxx = chL.lc.cxy = chL.lc.cxx = chR.hc.cxy = chR.hc.cxx = chR.lc.cxy = chR.lc.cxx = 0;
  chL.ic.cxy = chL.ic.cxx = chR.ic.cxy = chR.ic.cxx = 0; chL.sp.s = chR.sp.s = 0;
  chL.hd.z1 = chL.hd.z2 = chL.ld.z1 = chL.ld.z2 = chR.hd.z1 = chR.hd.z2 = chR.ld.z1 = chR.ld.z2 = 0;
  os_hold += 2 * samplesblock;
);

in_process(spl0, spl1);
xl = in_l; xr = in_r;
vms_l += (xl * xl - vms_l) * c_vu; vms_r += (xr * xr - vms_r) * c_vu;
vu_l_disp = vms_l; vu_r_disp = vms_r;

ms_on ? ( xa = 0.5 * (xl + xr); xb = 0.5 * (xl - xr); ) : ( xa = xl; xb = xr; );

sl_ff = 1 - 1 / rat_s; sl_fb = rat_s - 1;
ha = hpa.svf_hp(xa); hb = hpb.svf_hp(xb); da = abs(ha); db = abs(hb);
rq_a += (ha * ha - rq_a) * c_rms; rq_b += (hb * hb - rq_b) * c_rms;
rms_s > 0 ? ( da += (sqrt(2 * rq_a) - da) * rms_s; db += (sqrt(2 * rq_b) - db) * rms_s; );
dm = max(da, db); da += (dm - da) * lk_s; db += (dm - db) * lk_s;
tga = gcurve(g2db(da) - thr_s, sl_ff, 6); tgb = gcurve(g2db(db) - thr_s, sl_ff, 6);
hfa = fha.svf_hp(yfa); hfb = fhb.svf_hp(yfb); fa = abs(hfa); fb = abs(hfb);
rq_fa += (hfa * hfa - rq_fa) * c_rms; rq_fb += (hfb * hfb - rq_fb) * c_rms;
rms_s > 0 ? ( fa += (sqrt(2 * rq_fa) - fa) * rms_s; fb += (sqrt(2 * rq_fb) - fb) * rms_s; );
fm = max(fa, fb); fa += (fm - fa) * lk_s; fb += (fm - fb) * lk_s;
tfa = gcurve(g2db(fa) - thr_s, sl_fb, 10); tfb = gcurve(g2db(fb) - thr_s, sl_fb, 10);

rel_auto ? (
  env_ffa += (tga - env_ffa) * (tga > env_ffa ? c_att : c_af);
  env_ffb += (tgb - env_ffb) * (tgb > env_ffb ? c_att : c_af);
  env_sa += (tga - env_sa) * (tga > env_sa ? c_aa : c_as);
  env_sb += (tgb - env_sb) * (tgb > env_sb ? c_aa : c_as);
  gra = max(env_ffa, env_sa); grb = max(env_ffb, env_sb);
  fb_ga += (tfa - fb_ga) * (tfa > fb_ga ? c_att : c_af);
  fb_gb += (tfb - fb_gb) * (tfb > fb_gb ? c_att : c_af);
  fbs_a += (tfa - fbs_a) * (tfa > fbs_a ? c_aa : c_as);
  fbs_b += (tfb - fbs_b) * (tfb > fbs_b ? c_aa : c_as);
  gfa = max(fb_ga, fbs_a); gfb = max(fb_gb, fbs_b);
) : (
  env_ffa = max(env_ffa, env_sa); env_ffb = max(env_ffb, env_sb);
  fb_ga = max(fb_ga, fbs_a); fb_gb = max(fb_gb, fbs_b);
  env_ffa += (tga - env_ffa) * (tga > env_ffa ? c_att : c_rel);
  env_ffb += (tgb - env_ffb) * (tgb > env_ffb ? c_att : c_rel);
  gra = env_ffa; grb = env_ffb;
  fb_ga += (tfa - fb_ga) * (tfa > fb_ga ? c_att : c_rel);
  fb_gb += (tfb - fb_gb) * (tfb > fb_gb ? c_att : c_rel);
  gfa = fb_ga; gfb = fb_gb;
  env_sa = env_sb = fbs_a = fbs_b = 0;
);
yfa = xa * db2g(-gfa); yfb = xb * db2g(-gfb);

gr_a = gra + (gfa - gra) * top_s; gr_b = grb + (gfb - grb) * top_s;
ga = db2g(-gr_a); gb = db2g(-gr_b);
grc_disp = max(grc_disp, max(gr_a, gr_b) * cin_s);

wa = xa * (1 + bl_s * (ga * mk_s - 1)); wb = xb * (1 + bl_s * (gb * mk_s - 1));
ms_on ? ( cl = wa + wb; cr = wa - wb; ) : ( cl = wa; cr = wb; );
cl = xl + (cl - xl) * cin_s; cr = xr + (cr - xr) * cin_s;

ul.os_up(cl); ur.os_up(cr);
a0 = chL.colour_run(ul.s0); b0 = chR.colour_run(ur.s0); cw_add(); a0 += cwa; b0 += cwb;
os_f == 1 ? (
  cl = a0; cr = b0;
) : (
  a1 = chL.colour_run(ul.s1); b1 = chR.colour_run(ur.s1); cw_add(); a1 += cwa; b1 += cwb;
  os_f == 2 ? (
    cl = dl_.os_dn(a0, a1, 0, 0); cr = dr_.os_dn(b0, b1, 0, 0);
  ) : (
    a2 = chL.colour_run(ul.s2); b2 = chR.colour_run(ur.s2); cw_add(); a2 += cwa; b2 += cwb;
    a3 = chL.colour_run(ul.s3); b3 = chR.colour_run(ur.s3); cw_add(); a3 += cwa; b3 += cwb;
    cl = dl_.os_dn(a0, a1, a2, a3); cr = dr_.os_dn(b0, b1, b2, b3);
  );
);
dcv = cl - dcx_l + dc_c * dcy_l; dcx_l = cl; dcy_l = dcv; cl = dcv;
dcv = cr - dcx_r + dc_c * dcy_r; dcx_r = cr; dcy_r = dcv; cr = dcv;
cl = eqL.hs_tone(cl); cr = eqR.hs_tone(cr);
d22_s * w_blue + d3_s * w_red > 0.0001 ? (
  dyn_run(0.5 * (cl + cr));
  cl = dqL.b.bq_run(dqL.a.bq_run(cl)); cr = dqR.b.bq_run(dqR.a.bq_run(cr));
) : ( dg_a = dg_b = 0; dqL.a.z1 = dqL.a.z2 = dqL.b.z1 = dqL.b.z2 = dqR.a.z1 = dqR.a.z2 = dqR.b.z1 = dqR.b.z2 = 0; dd_n = 16; );

sm = 0.5 * (cl + cr); ss = 0.5 * (cl - cr);
ss += (shp.svf_hp2(ss) - ss) * shp_s;
ss += (ss - dpf.op_lp(ss, dp_g)) * (db2g(4 * dep_s) - 1);
ss *= wid_s;
cl = sm + ss; cr = sm - ss;

brk_on ? (
  pk = max(tp_peak(0, cl), tp_peak(1, cr)); tp_w += 1;
  gq = pk > ceil_s ? ceil_s / pk : 1;
  while (dq_t > dq_h && DQV[(dq_t - 1) & RMASK] >= gq) ( dq_t -= 1; );
  DQV[dq_t & RMASK] = gq; DQI[dq_t & RMASK] = tn; dq_t += 1;
  while (DQI[dq_h & RMASK] <= tn - la_w) ( dq_h += 1; );
  gmin = DQV[dq_h & RMASK];
  g_rl = gmin < g_rl ? gmin : g_rl + (gmin - g_rl) * c_lra;
  g_sum += g_rl - GHIST[(wp - la_n) & RMASK]; GHIST[wp & RMASK] = g_rl;
  lg = g_sum / la_n;
  DLINE[wp & RMASK] = cl; DLINE[1024 + (wp & RMASK)] = cr;
  dl = DLINE[(wp - la_d) & RMASK]; dr = DLINE[1024 + ((wp - la_d) & RMASK)];
  wp += 1; tn += 1;
  (wp & 65535) == 0 ? ( g_sum = 0; k = 0; loop(la_n, g_sum += GHIST[(wp - 1 - k) & RMASK]; k += 1; ); );
  lg = min(lg, 1);
  ol = dl * (1 + lin_s * (lg - 1)); orr = dr * (1 + lin_s * (lg - 1));
  lin_s > 0.999 ? ( ol = max(min(ol, ceil_s), -ceil_s); orr = max(min(orr, ceil_s), -ceil_s); );
) : (
  pk = max(abs(cl), abs(cr));
  zo = g2db(pk) - g2db(ceil_s);
  zt = gcurve(zo, 1, 2);
  zl_env = zt > zl_env ? zt : zl_env + (zt - zl_env) * c_lra;
  lg = db2g(-zl_env);
  ol = cl * (1 + lin_s * (lg - 1)); orr = cr * (1 + lin_s * (lg - 1));
);
lgr_disp = max(lgr_disp, -g2db(lg) * lin_s);

dip_s = min(dip_g, os_g); dip_s *= dip_s * (3 - 2 * dip_s);
spl0 = ol * dip_s; spl1 = orr * dip_s;
DRY[dw] = rw_l; DRY[1024 + dw] = rw_r;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
  rs_s = rs_f * rs_f * (3 - 2 * rs_f); rs_xs = rs_x * rs_x * (3 - 2 * rs_x);
  rs_dl = rw_l + (DRY[(dw - pdc_delay) & RMASK] - rw_l) * rs_xs;
  rs_dr = rw_r + (DRY[1024 + ((dw - pdc_delay) & RMASK)] - rw_r) * rs_xs;
  spl0 = rs_dl + (spl0 - rs_dl) * rs_s; spl1 = rs_dr + (spl1 - rs_dr) * rs_s;
);
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? (
  rs_dl = DRY[(dw - pdc_delay) & RMASK]; rs_dr = DRY[1024 + ((dw - pdc_delay) & RMASK)];
  spl0 += (rs_dl - spl0) * by_s; spl1 += (rs_dr - spl1) * by_s;
);
xn > 0 ? (
  xs = rs_f < 1 ? rs_xs : 1; k = 0;
  loop(xn,
    XCH[k * 1024 + dw] = spl(k + 2);
    spl(k + 2) = (spl(k + 2) + (XCH[k * 1024 + ((dw - pdc_delay) & RMASK)] - spl(k + 2)) * xs) * dip_s;
    k += 1;
  );
);
dw = (dw + 1) & RMASK;
mo_l_d = max(mo_l_d, abs(spl0)); mo_r_d = max(mo_r_d, abs(spl1));
lat_disp = pdc_delay;

@gfx 1080 500
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1080, 500);
BG = 0x26282B; HDR = 0x1D1F22; PL = 0x33363A; PLD = 0x2B2E31; INK = 0xEDE6D2; DIM = 0xA9A391;
BDEEP = 0x2D5E96; BLITE = 0x8DBBEA;
sc != bx_lsc ? (
  bx_lsc = sc;
  bx_f2 = ui_fitfont(2, 14 * sc);
  gfx_setfont(10, "Trebuchet MS", 30 * sc, 'b');
  gfx_setfont(11, "Trebuchet MS", 15 * sc, 'b');
  gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');
  gfx_setfont(14, "Trebuchet MS", 14 * sc, 'b');
  gfx_setfont(15, "Trebuchet MS", 18 * sc, 'b');
);
gfx_setfont(2, "Trebuchet MS", bx_f2, 'b'); gfx_setfont(3, "Trebuchet MS", bx_f2, 'b');
C_INK = INK; lk_font = 14; lk_font2 = 14; lk_well = 0x111214;

function bx_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function bx_rr(x, y, w, h, r) ( ui_rrs(x * sc, y * sc, w * sc, h * sc, r * sc); );
function bx_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function bx_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function bx_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function bx_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function bx_shadow(x, y, w, h, r) local(j) (
  j = 0; loop(4, ui_cola(0x000000, 0.13); bx_rr(x + 2 + j * 1.3, y + 3 + j * 1.7, w + j * 0.4, h + j * 0.4, r + j); j += 1; );
);
function bx_plate(x, y, w, h) (
  bx_shadow(x, y, w, h, 6);
  ui_col(0x16171A); bx_rr(x, y, w, h, 6);
  ui_col(0x4A4E53); bx_rr(x, y, w - 1, h - 1, 6);
  ui_col(PL); bx_rr(x + 1, y + 1, w - 2.5, h - 2.5, 5);
  gfx_gradrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, h * 0.4 * sc, 1, 1, 1, 0.05, 0, 0, 0, 0, 0, 0, 0, -0.05 / (h * 0.4 * sc));
);
function bx_head(x, w, title) local(tw, th) (
  ui_col(PLD); bx_r(x + 1, 81, w - 2, 32);
  ui_cola(BLITE, 0.55); bx_r(x + 1, 113, w - 2, 1);
  gfx_setfont(11); gfx_measurestr(title, tw, th);
  ui_col(0x1B3C61); bx_rr(x + 11, 85, tw / sc + 22, 24, 4);
  ui_col(BDEEP); bx_rr(x + 12, 86, tw / sc + 20, 22, 3);
  ui_col(INK); gfx_x = (x + 22) * sc; gfx_y = 97 * sc - th * 0.5; gfx_drawstr(title);
);
function bx_div(x) ( ui_col(0x1E2023); bx_r(x, 82, 1, 268); ui_cola(0xFFFFFF, 0.07); bx_r(x + 1, 82, 1, 268); );
function bx_box(x, y, w, h, name, menu, v) local(hov, sel, n, i, tw, th) (
  hov = bx_in(x, y, w, h);
  gfx_setfont(13); ui_col(DIM); bx_tc(x + w * 0.5, y - 17, name);
  ui_col(0x0E0F11); bx_rr(x - 1, y - 1, w + 2, h + 2, 4);
  ui_col(0x17191C); bx_rr(x, y, w, h, 3);
  ui_cola(0x000000, 0.5); bx_r(x + 1, y + 1, w - 2, 2);
  hov ? ( ui_cola(0xFFFFFF, 0.06); bx_rr(x, y, w, h, 3); );
  pk_pitem(menu, v + 1, #bx_di);
  gfx_setfont(14); ui_col(BLITE); gfx_measurestr(#bx_di, tw, th);
  gfx_x = (x + (w - 14) * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5) * sc - th * 0.5; gfx_drawstr(#bx_di);
  ui_col(DIM); ui_sstri((x + w - 17) * sc, (y + h * 0.5 - 3) * sc, (x + w - 7) * sc, (y + h * 0.5 - 3) * sc, (x + w - 12) * sc, (y + h * 0.5 + 3) * sc);
  sel = -1;
  pressed && hov && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#bx_dm, ""); n = pk_pcount(menu); i = 1;
    loop(n, i == v + 1 ? strcat(#bx_dm, "!"); strcat(#bx_dm, pk_pitem(menu, i, #bx_dt)); i < n ? strcat(#bx_dm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#bx_dm); i > 0 ? sel = i - 1;
  );
  sel;
);
function bx_kn(cx, cy, r, idx, lo, hi, def, lg, cap, lbl, fmt) (
  ui_kdesk = cap; ui_kdesk_r = r; ui_kdesk_p = 0;
  ui_knob(cx * sc, cy * sc, idx, lo, hi, def, lg, lbl, fmt);
  ui_kdesk = 0; ui_kdesk_r = 0;
);
function bx_wkn(cx, cy, r, idx) local(a, k) (
  ui_kdesk_d = 4; ui_kdesk_x = 1; bx_kn(cx, cy, r, idx, 0, 200, 100, 0, BLITE, "WIDTH", "%.0f %%");
  gfx_setfont(13); ui_col(BLITE); k = 0;
  loop(3, a = -0.75 * $pi + k * 0.75 * $pi;
