    drag_n = min(max(drag_n + (mouse_x - drag_x) / (w * sc * ((mouse_cap & 8) ? 5 : 1)), 0), 1); drag_x = mouse_x;
    v = floor(lo + drag_n * (hi - lo) + 0.5); slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    v = min(max(v + sign(mouse_wheel) * max(1, (mouse_cap & 8) ? 1 : 3), lo), hi); slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = (v - lo) / (hi - lo); act = hov || drag_id == idx;
  ui_col(0x0E0F11); bx_rr(x - 1, y - 4, w + 2, 8, 3);
  ui_col(0x17191C); bx_rr(x, y - 3, w, 6, 2);
