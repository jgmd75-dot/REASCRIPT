desc:SUP34 [channel strip] (GFX)
//tags: channel strip preamp harmonic drive filters compressor gate expander 4-band eq sidechain key
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui, gfx-panel, gfx-dyn and gfx-clip (.jsfx-inc) in the same folder.
//
// SUP34. A modern British console channel strip, in the spirit of a 1U "greatest hits" unit, laid out as two stacked
// half-rack panels (the sound is designed from scratch). Linked stereo: one set of controls, one detector.
//
//   PREAMP  GAIN -20 .. +20 dB (clean and wide). DRV: a variable harmonic drive stage after it - its knob turns from
//           2ND (a lopsided, valve-like curve) to 3RD (a symmetric, harder, transistor-like edge); the hotter the level
//           into it, the more it colours. Not level-compensated: GAIN is the gain. ø flips the polarity (glided).
//   FILTERS HPF 16 .. 350 Hz, 18 dB/oct (OFF at the bottom); LPF 22 .. 3 kHz, 12 dB/oct (OFF at the top).
//   COMP    a VCA compressor: RATIO 1:1 .. INF, THRESHOLD -40 .. 0 dBFS, RELEASE 0.1 .. 4 s; attack 10 ms, FAST 1 ms.
//           PEAK: a peak detector and a hard knee (otherwise RMS and a 10 dB soft knee).
//   GATE / EXP  RANGE 0 .. 40 dB (0 = no effect), THRESHOLD -60 .. 0 dBFS (with 4 dB of hysteresis: it opens at the
//           threshold and closes 4 dB below), RELEASE 0.1 .. 4 s, HOLD 0 .. 4 s; attack 1 ms, FAST 0.1 ms. EXP: a 1:2
//           downward expander instead of a gate (down to RANGE).
//   EQ      four bands, two circuits. LF shelf 30 .. 450 Hz, LMF 200 Hz .. 2.5 kHz, HMF 600 Hz .. 7 kHz (Q 0.5 .. 2.5),
//           HF shelf 1.5 .. 16 kHz; every gain -15 .. +15 dB (black gain caps in E; pink in G, cream on MATRIX). E: constant Q, plain shelves; its keys turn the LF and HF
//           into bells. G: the mids' Q tightens as they are pushed, the shelves dip before they lift (and vice versa);
//           its keys divide the LMF's frequency by 3 and multiply the HMF's by 3. Every change glides (60 ms); a shelf
//           / bell change fades the band out and back in: no click.
//   ROUTING DYN PRE EQ (the dynamics before the EQ; otherwise after it), FLT ► SC and EQ ► SC (the filters / the EQ
//           move into the dynamics sidechain: they shape what the detector hears, not the sound), EXT KEY (the
//           dynamics listen to inputs 3 / 4). A change runs the new routing alongside the old one for 40 ms, then
//           crossfades into it over 25 ms: no click.
//   OUTPUT  TRIM -20 .. +20 dB. The house output stage passes straight through (a channel strip: no clip). METER IN /
//           OUT, with the compressor's gain reduction and the gate's light.
//   DRIFT   (0 - 100 %, 50 % = standard, 0 = none): the DRV stage's bias wanders (its asymmetry breathes), and the
//           compressor VCA's control voltage wanders (its threshold, by a few tenths of a dB).
//   VFD / MATRIX  the panel's look (VFD charcoal and dusky pink; MATRIX battleship grey and warm cream). The look only.
//   PRESETS 12 (Init + 11) plus Reset all to defaults. A preset sets everything after the GAIN; GAIN, OUTPUT, the
//           meter, DRIFT and the look are left alone (Reset all restores them too).

slider1:0<-20,20,0.1>-Gain (dB)
slider2:0<0,1,1{Off,On}>-DRV
slider3:5<0,10,0.1>-DRV harmonics (2nd .. 3rd)
slider4:0<0,1,1{Normal,Inverted}>-Polarity
slider5:15<15,350,1>-HPF (Hz, 15 = off)
slider6:22<3,22,0.1>-LPF (kHz, 22 = off)
slider7:1<0,1,1{Out,In}>-Comp in
slider8:3<1,21,0.1>-Ratio (21 = inf)
slider9:-20<-40,0,0.1>-Comp threshold (dBFS)
slider10:0.3<0.1,4,0.01>-Comp release (s)
slider11:0<0,1,1{Off,On}>-Comp fast attack
slider12:0<0,1,1{Off,On}>-Comp peak
slider13:0<0,1,1{Out,In}>-Gate in
slider14:20<0,40,0.1>-Gate range (dB)
slider15:-40<-60,0,0.1>-Gate threshold (dBFS)
slider16:0.25<0.1,4,0.01>-Gate release (s)
slider17:0<0,4,0.01>-Gate hold (s)
slider18:0<0,1,1{Off,On}>-Gate fast attack
slider19:0<0,1,1{Gate,Expander}>-Gate mode
slider20:1<0,1,1{Out,In}>-EQ in
slider21:1<0,1,1{E,G}>-EQ circuit
slider22:0<-15,15,0.1>-LF gain (dB)
slider23:100<30,450,1>-LF freq (Hz)
slider24:0<-15,15,0.1>-LMF gain (dB)
slider25:800<200,2500,1>-LMF freq (Hz)
slider26:1<0.5,2.5,0.01>-LMF Q
slider27:0<-15,15,0.1>-HMF gain (dB)
slider28:3000<600,7000,1>-HMF freq (Hz)
slider29:1<0.5,2.5,0.01>-HMF Q
slider30:0<-15,15,0.1>-HF gain (dB)
slider31:8<1.5,16,0.1>-HF freq (kHz)
slider32:0<0,1,1{Off,On}>-Key A (E: LF bell, G: LMF /3)
slider33:0<0,1,1{Off,On}>-Key B (G: HMF x3, E: HF bell)
slider34:0<0,1,1{Off,On}>-Dynamics pre EQ
slider35:0<0,1,1{Off,On}>-Filters to sidechain
slider36:0<0,1,1{Off,On}>-EQ to sidechain
slider37:0<0,1,1{Off,On}>-External key (in 3/4)
slider38:0<-20,20,0.1>-Output trim (dB)
slider39:1<0,1,1{In,Out}>-Meter
slider40:50<0,100,1>-Drift (%)
slider41:0<0,1,1{VFD,Matrix}>-Look
slider42:prs_sel=0<0,12,1{No preset,Init,Vocal Polish,Pushed Vocal,Kick,Snare,Gated Toms,Bass DI,Acoustic Guitar,Electric Guitar,Drum Bus Punch,Piano,Overheads}>-Preset

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-clip.jsfx-inc

@init
#ui_man = "gfx-sup34";                                // the ? pop-up links to this manual
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 0; clp_kt_on = 0;             // gfx-clip: ADAA clippers only (the DRV stage)

function sp_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function sp_op(f) ( 1 - exp(-2 * $pi * min(f, 0.49 * srate) / srate); );
function sp_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function sp_sm(g) ( g * g * (3 - 2 * g); );

// ---------- biquad coefficients (o[0..2] = b0..b2, o[3..4] = a1, a2; normalised) ----------
HPC = 100; LPC = 105; B0C = 110; B1C = 115; B2C = 120; B3C = 125;
function sp_w(f) ( 2 * $pi * min(max(f, 5), 0.45 * srate) / srate; );
function sp_lsh(o, f, gdb, q) local(A, w, cw, al, s, a0) (
  A = 10 ^ (gdb / 40); w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(A) * al;
  a0 = (A + 1) + (A - 1) * cw + s;
  o[0] = A * ((A + 1) - (A - 1) * cw + s) / a0; o[1] = 2 * A * ((A - 1) - (A + 1) * cw) / a0; o[2] = A * ((A + 1) - (A - 1) * cw - s) / a0;
  o[3] = -2 * ((A - 1) + (A + 1) * cw) / a0; o[4] = ((A + 1) + (A - 1) * cw - s) / a0;
);
function sp_hsh(o, f, gdb, q) local(A, w, cw, al, s, a0) (
  A = 10 ^ (gdb / 40); w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(A) * al;
  a0 = (A + 1) - (A - 1) * cw + s;
  o[0] = A * ((A + 1) + (A - 1) * cw + s) / a0; o[1] = -2 * A * ((A - 1) + (A + 1) * cw) / a0; o[2] = A * ((A + 1) + (A - 1) * cw - s) / a0;
  o[3] = 2 * ((A - 1) - (A + 1) * cw) / a0; o[4] = ((A + 1) - (A - 1) * cw - s) / a0;
);
function sp_pk(o, f, gdb, q) local(A, w, cw, al, n) (
  A = 10 ^ (gdb / 40); w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al / A;
  o[0] = (1 + al * A) / n; o[1] = -2 * cw / n; o[2] = (1 - al * A) / n; o[3] = -2 * cw / n; o[4] = (1 - al / A) / n;
);
function sp_hp2(o, f, q) local(w, cw, al, n) (
  w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function sp_lp2(o, f, q) local(w, cw, al, n) (
  w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function sp_bq(x, o) instance(s1, s2) local(y) ( y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y; );
function sp_bqz() instance(s1, s2) ( s1 = s2 = 0; );
function sp_bqt() instance(s1, s2) ( s1 = sp_tn(s1); s2 = sp_tn(s2); );

// ---------- the glides (every 32 samples: 60 ms) ----------
// a band whose type (shelf / bell) is changing glides its gain to 0, swaps, then glides back
function sp_upd(k) local(m, g0, g3, q1, q2) (
  g0 = sp_y0 != sp_y0t ? 0 : sp_g0t; g3 = sp_y3 != sp_y3t ? 0 : sp_g3t;
  m = abs(sp_f0_ - sp_f0t) + abs(sp_g0_ - g0) + abs(sp_f1_ - sp_f1t) + abs(sp_g1_ - sp_g1t) + abs(sp_q1_ - sp_q1t)
    + abs(sp_f2_ - sp_f2t) + abs(sp_g2_ - sp_g2t) + abs(sp_q2_ - sp_q2t) + abs(sp_f3_ - sp_f3t) + abs(sp_g3_ - g3)
    + abs(sp_qs_ - sp_qst) + abs(sp_vq_ - sp_vqt) + abs(sp_hf_ - sp_hft) + abs(sp_lf_ - sp_lft);
  m > 0.0001 || k >= 1 || sp_y0 != sp_y0t || sp_y3 != sp_y3t ? (
    sp_f0_ *= (sp_f0t / sp_f0_) ^ k; sp_f1_ *= (sp_f1t / sp_f1_) ^ k; sp_f2_ *= (sp_f2t / sp_f2_) ^ k; sp_f3_ *= (sp_f3t / sp_f3_) ^ k;
    sp_q1_ *= (sp_q1t / sp_q1_) ^ k; sp_q2_ *= (sp_q2t / sp_q2_) ^ k; sp_hf_ *= (sp_hft / sp_hf_) ^ k; sp_lf_ *= (sp_lft / sp_lf_) ^ k;
    sp_g0_ += (g0 - sp_g0_) * k; sp_g1_ += (sp_g1t - sp_g1_) * k; sp_g2_ += (sp_g2t - sp_g2_) * k; sp_g3_ += (g3 - sp_g3_) * k;
    sp_qs_ += (sp_qst - sp_qs_) * k; sp_vq_ += (sp_vqt - sp_vq_) * k;
    sp_y0 != sp_y0t && abs(sp_g0_) < 0.03 ? ( sp_y0 = sp_y0t; sp_g0_ = 0; );
    sp_y3 != sp_y3t && abs(sp_g3_) < 0.03 ? ( sp_y3 = sp_y3t; sp_g3_ = 0; );
    // G: the mids' Q tightens with the gain (sp_vq_ = 1 in G, 0 in E)
    q1 = sp_q1_ * (1 + sp_vq_ * (abs(sp_g1_) / 15 - 0.5)); q2 = sp_q2_ * (1 + sp_vq_ * (abs(sp_g2_) / 15 - 0.5));
    sp_y0 ? sp_pk(B0C, sp_f0_, sp_g0_, 0.8) : sp_lsh(B0C, sp_f0_, sp_g0_, sp_qs_);
    sp_pk(B1C, sp_f1_, sp_g1_, q1); sp_pk(B2C, sp_f2_, sp_g2_, q2);
    sp_y3 ? sp_pk(B3C, sp_f3_, sp_g3_, 0.8) : sp_hsh(B3C, sp_f3_, sp_g3_, sp_qs_);
    sp_hp2(HPC, sp_hf_, 1); sp_h1 = sp_op(sp_hf_);                     // HPF: 1st order + Q 1 (3rd-order Butterworth)
    sp_lp2(LPC, sp_lf_, 0.70710678);                                   // LPF: 12 dB/oct
  );
);

// =====================================================================
// FILTERS, EQ, DYNAMICS - each instance holds both channels' state; they read and write sp_a / sp_b
// =====================================================================
function fl_run() instance(pa, pb) local(ya, yb) (
  sp_eH > 0 ? (
    ya = sp_a - pa; pa += sp_h1 * (sp_a - pa); yb = sp_b - pb; pb += sp_h1 * (sp_b - pb);
    ya = this.ha.sp_bq(ya, HPC); yb = this.hb.sp_bq(yb, HPC);
    sp_a += sp_eH * (ya - sp_a); sp_b += sp_eH * (yb - sp_b);
  );
  sp_eL > 0 ? (
    ya = this.la.sp_bq(sp_a, LPC); yb = this.lb.sp_bq(sp_b, LPC);
    sp_a += sp_eL * (ya - sp_a); sp_b += sp_eL * (yb - sp_b);
  );
);
function fl_reset() instance(pa, pb) ( pa = pb = 0; this.ha.sp_bqz(); this.hb.sp_bqz(); this.la.sp_bqz(); this.lb.sp_bqz(); );
function fl_tidy() instance(pa, pb) ( pa = sp_tn(pa); pb = sp_tn(pb); this.ha.sp_bqt(); this.hb.sp_bqt(); this.la.sp_bqt(); this.lb.sp_bqt(); );
function eq_run() local(ya, yb) (
  ya = this.a3.sp_bq(this.a2.sp_bq(this.a1.sp_bq(this.a0.sp_bq(sp_a, B0C), B1C), B2C), B3C);
  yb = this.b3.sp_bq(this.b2.sp_bq(this.b1.sp_bq(this.b0.sp_bq(sp_b, B0C), B1C), B2C), B3C);
  sp_a += sp_eE * (ya - sp_a); sp_b += sp_eE * (yb - sp_b);
);
function eq_reset() ( this.a0.sp_bqz(); this.a1.sp_bqz(); this.a2.sp_bqz(); this.a3.sp_bqz(); this.b0.sp_bqz(); this.b1.sp_bqz(); this.b2.sp_bqz(); this.b3.sp_bqz(); );
function eq_tidy() ( this.a0.sp_bqt(); this.a1.sp_bqt(); this.a2.sp_bqt(); this.a3.sp_bqt(); this.b0.sp_bqt(); this.b1.sp_bqt(); this.b2.sp_bqt(); this.b3.sp_bqt(); );

// ---- DYNAMICS: the compressor and the gate / expander, from one sidechain (sp_sa / sp_sb), on the audio (sp_a / sp_b) ----
function dy_run() instance(ms, pk, gdb, gt, gk, op, hc, grm, gtm) local(x2, lv, ov, t, a, lg, cl, tg) (
  // COMPRESSOR
  sp_gC > 0 ? (
    cp_peak ? ( a = max(abs(sp_sa), abs(sp_sb)); pk = a > pk ? a : pk * cp_kpk; lv = 20 * log10(max(pk, 0.0000001)); )
            : ( x2 = 0.5 * (sp_sa * sp_sa + sp_sb * sp_sb); ms += cp_krms * (x2 - ms); lv = 10 * log10(max(ms, 0.00000000001)) + 3.0103; );
    ov = lv - cp_th;
    cp_peak ? ( t = ov > 0 ? ov * cp_sl : 0; ) : ( t = ov <= -5 ? 0 : ov >= 5 ? ov * cp_sl : cp_sl * sqr(ov + 5) / 20; );
    t = -t;
    gdb += (t < gdb ? cp_ka : cp_kr) * (t - gdb);
    grm = min(grm, gdb);
  ) : gdb = 0;
  // GATE / EXPANDER (hysteresis 4 dB, hold)
  sp_gG > 0 ? (
    a = max(abs(sp_sa), abs(sp_sb)); gk = a > gk ? a : gk * gt_kpk;
    lg = 20 * log10(max(gk, 0.0000001));
    gt_exp ? ( tg = lg >= gt_th ? 0 : max(lg - gt_th, -gt_rg); ) : (
      lg >= gt_th ? ( op = 1; hc = gt_hold; ) : lg < gt_th - 4 ? ( hc > 0 ? hc -= 1 : op = 0; );
      tg = op ? 0 : -gt_rg;
    );
    gt += (tg > gt ? gt_ka : gt_kr) * (tg - gt);
    gtm = min(gtm, gt);
  ) : gt = 0;
  cl = exp(0.115129255 * (gdb * sp_eC + gt * sp_eG));
  sp_a *= cl; sp_b *= cl;
);
function dy_reset() instance(ms, pk, gdb, gt, gk, op, hc) ( ms = pk = gdb = gk = 0; gt = 0; op = 1; hc = 0; );
function dy_tidy() instance(ms, pk, gk) ( ms = sp_tn(ms); pk = sp_tn(pk); gk = sp_tn(gk); );

// ---------- one chain set: the routing r (1 DYN PRE EQ, 2 FLT > SC, 4 EQ > SC, 8 EXT KEY) ----------
function set_run(xl, xr, kl, kr, r) local(dp, fs, es, ek) (
  dp = r & 1; fs = r & 2; es = r & 4; ek = r & 8;
  sp_a = xl; sp_b = xr;
  !fs ? this.fa.fl_run();                                          // the filters, in the audio
  !dp && !es ? this.ea.eq_run();                                   // the EQ before the dynamics
  sp_ta = sp_a; sp_tb = sp_b;
  ek ? ( sp_a = kl; sp_b = kr; );                                  // the sidechain: the key, or the audio here
  fs ? this.fs.fl_run();
  es ? this.es.eq_run();
  sp_sa = sp_a; sp_sb = sp_b; sp_a = sp_ta; sp_b = sp_tb;
  this.dy.dy_run();
  dp && !es ? this.ea.eq_run();                                    // the EQ after the dynamics
);
function set_reset() ( this.fa.fl_reset(); this.fs.fl_reset(); this.ea.eq_reset(); this.es.eq_reset(); this.dy.dy_reset(); );
function set_tidy() ( this.fa.fl_tidy(); this.fs.fl_tidy(); this.ea.eq_tidy(); this.es.eq_tidy(); this.dy.dy_tidy(); );

// ---- PREAMP: the DRV stage (2nd: lopsided; 3rd: symmetric), unity small-signal ----
function vh_run() instance(r2, r3) local(ua, ub, a2, b2, a3, b3) (
  ua = sp_a * 0.9; ub = sp_b * 0.9;
  a2 = this.c2a.clp_run(ua + vh_b2) - r2; b2 = this.c2b.clp_run(ub + vh_b2) - r2;
  a3 = this.c3a.clp_run(ua + vh_b3) - r3; b3 = this.c3b.clp_run(ub + vh_b3) - r3;
  sp_vpk = max(sp_vpk, max(abs(ua), abs(ub)));
  sp_a = (a2 + vh_h * (a3 - a2)) * 1.1111111; sp_b = (b2 + vh_h * (b3 - b2)) * 1.1111111;
);
function vh_cfg() instance(r2, r3) (
  this.c2a.clp_set(1, 1, 0.7, 0); this.c2b.clp_set(1, 1, 0.7, 0);
  this.c3a.clp_set(1, 0.75, 0.75, 0); this.c3b.clp_set(1, 0.75, 0.75, 0);
  r2 = this.c2a.clp_crv(vh_b2); r3 = this.c3a.clp_crv(vh_b3);
);
function vh_prime() (
  this.c2a.x1 = this.c2b.x1 = vh_b2; this.c2a.ad1 = this.c2b.ad1 = this.c2a.clp_ad(vh_b2);
  this.c3a.x1 = this.c3b.x1 = vh_b3; this.c3a.ad1 = this.c3b.ad1 = this.c3a.clp_ad(vh_b3);
);
function vh_tidy() ( this.c2a.clp_tidy(); this.c2b.clp_tidy(); this.c3a.clp_tidy(); this.c3b.clp_tidy(); );

// ---------- presets ----------
#sp_pm = "Init|Vocal Polish|Pushed Vocal|Kick|Snare|Gated Toms|Bass DI|Acoustic Guitar|Electric Guitar|Drum Bus Punch|Piano|Overheads";
function sp_dyn(ci, ra, th, re, fa, pk, gi, rg, gth, grl, gh, gf, ge) (
  slider7 = ci; slider8 = ra; slider9 = th; slider10 = re; slider11 = fa; slider12 = pk;
  slider13 = gi; slider14 = rg; slider15 = gth; slider16 = grl; slider17 = gh; slider18 = gf; slider19 = ge;
);
function sp_eqs(ei, ec, lg, lf, mg, mf, mq, hg, hf, hq, fg, ff, ka, kb) (
  slider20 = ei; slider21 = ec; slider22 = lg; slider23 = lf; slider24 = mg; slider25 = mf; slider26 = mq;
  slider27 = hg; slider28 = hf; slider29 = hq; slider30 = fg; slider31 = ff; slider32 = ka; slider33 = kb;
);
function sp_pre(vo, vh, pol, hp, lp, dp, fs, es, ek) (
  slider2 = vo; slider3 = vh; slider4 = pol; slider5 = hp; slider6 = lp; slider34 = dp; slider35 = fs; slider36 = es; slider37 = ek;
);
function load_preset(p) local(i) (
  //                   vhd  h   pol hpf  lpf   dyn< flt eq  key
  p == 1  ? ( sp_pre(0, 5, 0, 15,  22,  0, 0, 0, 0);
              sp_dyn(1, 3, -20, 0.3, 0, 0,    0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 1, 0, 100, 0, 800, 1, 0, 3000, 1, 0, 8, 0, 0); ) :                  // Init
  p == 2  ? ( sp_pre(0, 5, 0, 80,  22,  0, 0, 0, 0);
              sp_dyn(1, 3, -24, 0.25, 0, 0,   0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 0, -2, 150, -2, 350, 1.2, 2, 3500, 1, 3, 10, 0, 0); ) :            // Vocal Polish
  p == 3  ? ( sp_pre(1, 3, 0, 100, 18,  0, 0, 0, 0);
              sp_dyn(1, 4, -26, 0.2, 1, 0,    0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 1, -2, 120, -3, 400, 1.5, 3, 3000, 1.2, 4, 12, 0, 0); ) :          // Pushed Vocal
  p == 4  ? ( sp_pre(0, 5, 0, 30,  12,  1, 0, 0, 0);
              sp_dyn(1, 4, -18, 0.15, 0, 1,   1, 25, -35, 0.15, 0.05, 1, 0);
              sp_eqs(1, 0, 5, 60, -6, 350, 1.5, 4, 3500, 1.5, 2, 10, 1, 0); ) :            // Kick
  p == 5  ? ( sp_pre(1, 6, 0, 80,  22,  1, 0, 0, 0);
              sp_dyn(1, 5, -20, 0.12, 1, 1,   1, 18, -32, 0.2, 0.05, 1, 0);
              sp_eqs(1, 1, 3, 180, -4, 500, 1, 4, 2500, 1, 4, 10, 0, 0); ) :               // Snare
  p == 6  ? ( sp_pre(0, 5, 0, 50,  14,  1, 0, 0, 0);
              sp_dyn(1, 3, -20, 0.3, 0, 0,    1, 30, -30, 0.4, 0.15, 0, 0);
              sp_eqs(1, 1, 3, 100, -6, 450, 1.5, 3, 3500, 1.2, 2, 8, 0, 0); ) :            // Gated Toms
  p == 7  ? ( sp_pre(1, 2, 0, 30,  10,  0, 0, 0, 0);
              sp_dyn(1, 4, -22, 0.3, 0, 0,    0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 1, 3, 80, -3, 250, 1, 3, 1000, 1.2, -2, 6, 0, 0); ) :               // Bass DI
  p == 8  ? ( sp_pre(0, 5, 0, 80,  22,  0, 0, 0, 0);
              sp_dyn(1, 2.5, -22, 0.4, 0, 0,  0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 0, -2, 200, -3, 300, 1, 2, 5000, 0.8, 3, 12, 0, 0); ) :            // Acoustic Guitar
  p == 9  ? ( sp_pre(1, 7, 0, 90,  9,   0, 0, 0, 0);
              sp_dyn(1, 3, -18, 0.3, 0, 0,    0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 1, -2, 100, 3, 800, 1.2, 2, 2500, 1, -2, 8, 0, 0); ) :              // Electric Guitar
  p == 10 ? ( sp_pre(0, 5, 0, 15,  22,  0, 1, 0, 0);
              sp_dyn(1, 4, -16, 0.1, 0, 1,    0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 0, 3, 60, -2, 400, 0.8, 2, 4000, 0.8, 3, 12, 0, 0); ) :            // Drum Bus Punch
  p == 11 ? ( sp_pre(0, 5, 0, 40,  22,  0, 0, 0, 0);
              sp_dyn(1, 2, -18, 0.5, 0, 0,    0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 1, 1, 100, -2, 300, 1, 1.5, 2500, 0.8, 2, 12, 0, 0); ) :           // Piano
  p == 12 ? ( sp_pre(0, 5, 0, 150, 22,  0, 0, 0, 0);
              sp_dyn(1, 2, -20, 0.3, 0, 0,    0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 0, 0, 100, -2, 500, 1, -2, 3000, 1.5, 3, 12, 0, 0); ) :            // Overheads
  p == 13 ? ( sp_pre(0, 5, 0, 15, 22, 0, 0, 0, 0); sp_dyn(1, 3, -20, 0.3, 0, 0, 0, 20, -40, 0.25, 0, 0, 0);
              sp_eqs(1, 1, 0, 100, 0, 800, 1, 0, 3000, 1, 0, 8, 0, 0);
              slider1 = 0; slider38 = 0; slider39 = 1; slider40 = 50; slider41 = 0; );            // Reset all to defaults
  i = 1; loop(41, ui_auto(i); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

// ---------- state ----------
function sp_srinit() (
  sp_sr = srate;
  cp_krms = sp_tc(10); cp_kpk = exp(-1 / (0.005 * srate));
  gt_kpk = exp(-1 / (0.01 * srate));
  sp_fst = 1 / (0.01 * srate);                        // IN keys and the polarity: 10 ms
  sp_xst = 1 / (0.025 * srate);                       // the routing crossfade: 25 ms
  sp_hst = 1 / (0.03 * srate);                        // the filters in / out: 30 ms
  sp_gsm = 1 - exp(-1 / (0.015 * srate));
  sp_gk = 1 - exp(-32 / (0.06 * srate));              // the EQ / filter glides: 60 ms
  ost_init(0);
);
sp_srinit();
in_init();
dV.drift_init(0.8 + rand(0.4)); dC.drift_init(0.8 + rand(0.4));
drift_macro(50);
sA.set_reset(); sB.set_reset();
sp_y0 = sp_y0t = 0; sp_y3 = sp_y3t = 0;
sp_cur = 0; sp_rCur = sp_rNew = 0; sp_xf = 0;
sp_snap = 1;

ui_thm = 5; ui_hw = 1;                                // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );                // new instances open in Medium, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@block
prs_chk();
srate != sp_sr ? sp_srinit();
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);                // the house output stage: straight through (a channel strip)
drift_macro(slider40);
// the routing: a change starts the crossfade into the other set (warmed up first); one more change waits for it
sp_rt = (slider34 >= 0.5) + 2 * (slider35 >= 0.5) + 4 * (slider36 >= 0.5) + 8 * (slider37 >= 0.5);
sp_xf <= 0 && sp_rt != sp_rCur ? (
  sp_snap ? sp_rCur = sp_rt : (
    sp_rNew = sp_rt; sp_xf = 0.000001; sp_wu = floor(0.04 * srate);
    sp_cur ? sA.set_reset() : sB.set_reset();
  );
);
sp_tV = slider2 >= 0.5; sp_tK = slider7 >= 0.5; sp_tG = slider13 >= 0.5; sp_tE = slider20 >= 0.5;
sp_tP = slider4 >= 0.5 ? -1 : 1;
// DRIFT: the DRV bias, the VCA's control voltage
sp_n = samplesblock / srate;
sp_vv = dV.drift_tick(0.05 * dm_s * sp_n); sp_vc = dC.drift_tick(0.05 * dm_s * sp_n);
// PREAMP
sp_gnt = 10 ^ (min(max(slider1, -20), 20) / 20);
sp_kgl = sp_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
vh_h += (min(max(slider3, 0), 10) / 10 - vh_h) * sp_kgl;
vh_b2 = 0.2 + 0.05 * dm_a * sp_vv; vh_b3 = 0.01 + 0.02 * dm_a * sp_vv;
// FILTERS: the targets (OFF: held, then faded out)
sp_tH = slider5 > 15.5; sp_tL = slider6 < 21.95;
sp_tH ? sp_hft = min(max(slider5, 16), 350);
sp_tL ? sp_lft = min(max(slider6, 3), 22) * 1000;
// EQ: the targets
sp_G = slider21 >= 0.5; sp_kA = slider32 >= 0.5; sp_kB = slider33 >= 0.5;
sp_y0t = !sp_G && sp_kA; sp_y3t = !sp_G && sp_kB;                             // E: the LF / HF bells
sp_f0t = min(max(slider23, 30), 450); sp_g0t = min(max(slider22, -15), 15);
sp_f1t = min(max(slider25, 200), 2500) / (sp_G && sp_kA ? 3 : 1); sp_g1t = min(max(slider24, -15), 15); sp_q1t = min(max(slider26, 0.5), 2.5);
sp_f2t = min(max(slider28, 600), 7000) * (sp_G && sp_kB ? 3 : 1); sp_g2t = min(max(slider27, -15), 15); sp_q2t = min(max(slider29, 0.5), 2.5);
sp_f3t = min(max(slider31, 1.5), 16) * 1000; sp_g3t = min(max(slider30, -15), 15);
sp_qst = sp_G ? 1.15 : 0.707; sp_vqt = sp_G;                                  // G: the shelves dip / lift; the mids' Q tightens
sp_snap ? (
  !sp_tH ? sp_hft = 16; !sp_tL ? sp_lft = 22000;
  sp_y0 = sp_y0t; sp_y3 = sp_y3t;
  sp_f0_ = sp_f0t; sp_g0_ = sp_g0t; sp_f1_ = sp_f1t; sp_g1_ = sp_g1t; sp_q1_ = sp_q1t; sp_f2_ = sp_f2t; sp_g2_ = sp_g2t; sp_q2_ = sp_q2t;
  sp_f3_ = sp_f3t; sp_g3_ = sp_g3t; sp_qs_ = sp_qst; sp_vq_ = sp_vqt; sp_hf_ = sp_hft; sp_lf_ = sp_lft;
  sp_upd(1);
  sp_gV = sp_tV; sp_gC = sp_tK; sp_gG = sp_tG; sp_gE = sp_tE; sp_gH = sp_tH; sp_gL = sp_tL; sp_pol = sp_tP;
  sp_gns = sp_gnt;
);
// DYNAMICS
cp_th = min(max(slider9, -40), 0) + 0.4 * dm_a * sp_vc;                     // the VCA's control voltage wanders a little
sp_r = min(max(slider8, 1), 21); cp_sl = sp_r >= 20.95 ? 1 : 1 - 1 / sp_r;
cp_ka = sp_tc(slider11 >= 0.5 ? 1 : 10); cp_kr = sp_tc(1000 * min(max(slider10, 0.1), 4));
cp_peak = slider12 >= 0.5;
gt_rg = min(max(slider14, 0), 40); gt_th = min(max(slider15, -60), 0);
gt_kr = sp_tc(1000 * min(max(slider16, 0.1), 4)); gt_hold = floor(min(max(slider17, 0), 4) * srate);
gt_ka = sp_tc(slider18 >= 0.5 ? 0.1 : 1); gt_exp = slider19 >= 0.5;
sp_outt = 10 ^ (min(max(slider38, -20), 20) / 20);
sp_snap ? sp_outs = sp_outt;
// the DRV stage's set-up
vh.vh_cfg(); sp_snap ? vh.vh_prime();
sp_snap = 0;
sA.set_tidy(); sB.set_tidy(); vh.vh_tidy();
// the panel's mailboxes
spa_il = max(spa_il, sp_il); spa_ir = max(spa_ir, sp_ir); spa_ol = max(spa_ol, sp_ol); spa_or = max(spa_or, sp_or); spa_v = max(spa_v, sp_vpk);
sp_il = sp_ir = sp_ol = sp_or = sp_vpk = 0;
spa_gr = min(spa_gr, sp_cur ? sB.dy.grm : sA.dy.grm); sA.dy.grm = sB.dy.grm = 0;
spa_gt = min(spa_gt, sp_cur ? sB.dy.gtm : sA.dy.gtm); sA.dy.gtm = sB.dy.gtm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0; spl2 != spl2 ? spl2 = 0; spl3 != spl3 ? spl3 = 0;
in_process(spl0, spl1);
sp_xl = in_l; sp_xr = in_r;
abs(sp_xl) < 0.000000000000001 ? sp_xl = 0; abs(sp_xr) < 0.000000000000001 ? sp_xr = 0;
// keys and fades
sp_gV != sp_tV ? ( sp_gV == 0 ? vh.vh_prime(); sp_gV = sp_tV ? min(sp_gV + sp_fst, 1) : max(sp_gV - sp_fst, 0); );
sp_gC != sp_tK ? ( sp_gC == 0 ? ( sA.dy.dy_reset(); sB.dy.dy_reset(); ); sp_gC = sp_tK ? min(sp_gC + sp_fst, 1) : max(sp_gC - sp_fst, 0); );
sp_gG != sp_tG ? ( sp_gG == 0 ? ( sA.dy.gt = sB.dy.gt = 0; sA.dy.op = sB.dy.op = 1; ); sp_gG = sp_tG ? min(sp_gG + sp_fst, 1) : max(sp_gG - sp_fst, 0); );
sp_gE != sp_tE ? ( sp_gE == 0 ? ( sA.ea.eq_reset(); sB.ea.eq_reset(); sA.es.eq_reset(); sB.es.eq_reset(); ); sp_gE = sp_tE ? min(sp_gE + sp_fst, 1) : max(sp_gE - sp_fst, 0); );
sp_gH != sp_tH ? ( sp_gH = sp_tH ? min(sp_gH + sp_hst, 1) : max(sp_gH - sp_hst, 0); );
sp_gL != sp_tL ? ( sp_gL = sp_tL ? min(sp_gL + sp_hst, 1) : max(sp_gL - sp_hst, 0); );
sp_pol != sp_tP ? ( sp_pol = sp_tP > sp_pol ? min(sp_pol + 2 * sp_fst, 1) : max(sp_pol - 2 * sp_fst, -1); );
sp_eV = sp_sm(sp_gV); sp_eC = sp_sm(sp_gC); sp_eG = sp_sm(sp_gG); sp_eE = sp_sm(sp_gE); sp_eH = sp_sm(sp_gH); sp_eL = sp_sm(sp_gL);
sp_xf > 0 ? ( sp_wu > 0 ? sp_wu -= 1 : ( sp_xf += sp_xst; sp_xf >= 1 ? ( sp_xf = 0; sp_cur = 1 - sp_cur; sp_rCur = sp_rNew; ); ); );
sp_ex = sp_sm(sp_xf);
(sp_cnt += 1) >= 32 ? ( sp_cnt = 0; sp_upd(sp_gk); );
sp_gns += (sp_gnt - sp_gns) * sp_gsm;
sp_outs += (sp_outt - sp_outs) * sp_gsm;
// PREAMP: GAIN, DRV, polarity
sp_a = sp_xl * sp_gns * sp_pol; sp_b = sp_xr * sp_gns * sp_pol;
sp_gV > 0 ? ( sp_ta = sp_a; sp_tb = sp_b; vh.vh_run(); sp_a = sp_ta + sp_eV * (sp_a - sp_ta); sp_b = sp_tb + sp_eV * (sp_b - sp_tb); );
sp_xl = sp_a; sp_xr = sp_b;
sp_il = max(sp_il, abs(sp_xl)); sp_ir = max(sp_ir, abs(sp_xr));
// FILTERS, EQ, DYNAMICS (the chain set, in its routing)
sp_cur ? sB.set_run(sp_xl, sp_xr, spl2, spl3, sp_rCur) : sA.set_run(sp_xl, sp_xr, spl2, spl3, sp_rCur);
sp_yl = sp_a; sp_yr = sp_b;
sp_xf > 0 ? (
  sp_cur ? sA.set_run(sp_xl, sp_xr, spl2, spl3, sp_rNew) : sB.set_run(sp_xl, sp_xr, spl2, spl3, sp_rNew);
  sp_yl += sp_ex * (sp_a - sp_yl); sp_yr += sp_ex * (sp_b - sp_yr);
);
// OUTPUT
sp_yl *= sp_outs; sp_yr *= sp_outs;
sp_yl != sp_yl ? sp_yl = 0; sp_yr != sp_yr ? sp_yr = 0;
ost_out(sp_yl, sp_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
sp_ol = max(sp_ol, abs(spl0)); sp_or = max(sp_or, abs(spl1));


@gfx 1080 560
ui_begin(1080, 560);
// =====================================================================
// GUI - in the 34 series manner (KRT81), as two stacked half-rack panels: the upper one PREAMP, FILTERS, COMPRESSOR,
// GATE / EXP; the lower one the EQ, ROUTING, OUTPUT and the meters. Two looks: VFD (charcoal and dusky pink) and MATRIX
// (battleship grey, elephant's breath print, warm cream). Design space 1080 x 560. Knobs: drag (SHIFT = fine), wheel,
// double-click = default; the name shows the value while the knob is touched.
// =====================================================================
krv_mx = 0;                                  // one look (VFD); slider41 kept so old projects load
!krv_mx ? (                                               // VFD: charcoal and pink
  KRP = 0x2E2F31; KRF = 0x202123; KRI = 0xF0DDE3; KRA = 0xC9839A; KRW = 0x121314; KRM = 0x55575A;
  KRC = 0xC9839A; KRPT = 0x2A0E18; KRCN = 0xC9839A; KRGH = 0x33282C; KRAMB = 0xFFD24A; KRRED = 0xFF3B1F; KRKT = 0x2A0716;
) : (                                                     // MATRIX: battleship grey, elephant's breath, white
  KRP = 0x222528; KRF = ui_mix(0x222528, 0x000000, 0.25); KRI = 0xC7BEB3; KRA = 0xF1E5CF; KRW = ui_mix(0x222528, 0x000000, 0.45);
  KRM = 0x4A4E4A; KRC = 0xF1E5CF; KRPT = 0x17191B; KRCN = 0x1E5631; KRGH = 0x2C302E; KRAMB = 0xD4A373; KRRED = 0xBC3908; KRKT = 0x17191B;
);
KRH = ui_mix(KRP, 0x000000, 0.35); KRI2 = ui_mix(KRI, KRF, 0.35);
KCLO = 0x8B5A3C; KCLM = 0x3C6CC8; KCHM = 0x3E8E4E; KCHI = 0xC8402E;   // the EQ caps (the house colour code)

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');
gfx_setfont(10, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(14, "Trebuchet MS", 15 * sc, 'b');

function kr_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kr_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function kr_ctxt(cx, cy, s) local(tw, th) ( tw = ui_symw(s); th = ui_symh; gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; ui_symstr(s); );
function kr_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_lbl(x, y, s) ( gfx_setfont(11); ui_col(KRI2); kr_txt(x, y, s); );
function kr_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function kr_thick(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, k) (       // (drawn here: works with any system files)
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l; ny = dx / l;
  k = -0.5 * w; loop(floor(w * 2.5) + 1, gfx_line(x1 + nx * k, y1 + ny * k, x2 + nx * k, y2 + ny * k, 1); k += 0.4; );
);
function kr_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = kr_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(0x050505); kr_r(x, y, w, h);
  on ? ui_col(KRA) : ui_col(hov ? ui_mix(KRP, 0xFFFFFF, 0.14) : ui_mix(KRP, 0xFFFFFF, 0.07)); kr_r(x + 1, y + 1, w - 2, h - 2);
  on ? ( ui_cola(KRA, 0.25); kr_r(x - 2, y - 2, w + 4, h + 4); ui_cola(0xFFFFFF, 0.3); kr_r(x + 1, y + 1, w - 2, 1); );
  on ? ui_col(KRKT) : ui_col(KRI);
  gfx_setfont(12); kr_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);
function kr_dim(x, y, w, h, lbl) ( ui_col(0x050505); kr_r(x, y, w, h); ui_col(ui_mix(KRF, KRP, 0.3)); kr_r(x + 1, y + 1, w - 2, h - 2);
  ui_col(ui_mix(KRI, KRF, 0.75)); gfx_setfont(12); kr_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl); 0; );
function kr_sect(x, y, w, h, name) (
  ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRF); kr_r(x + 1, y + 1, w - 2, h - 2);
  strlen(name) ? kr_lbl(x + 9, y + 6, name);
);
function kr_scale(cx, cy, r, n, nr, labels, minor) local(i, k, k0, len, c, a, ca, sa, m) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  minor > 0 ? (
    m = 0; ui_col(KRI2);
    loop((n - 1) * minor + 1,
      a = -0.75 * $pi + m / ((n - 1) * minor) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 6)) * sc, (cy + sa * (r + 6)) * sc, 1);
      m += 1;
    );
  );
  gfx_setfont(10);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#krv_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      ui_col(KRI);
      gfx_line((cx + ca * (r + 3)) * sc, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 7)) * sc, (cy + sa * (r + 7)) * sc, 1);
      strlen(#krv_sl) ? kr_ctxt(cx + ca * (r + nr), cy + sa * (r + nr), #krv_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
function kr_bake(cx, cy, r, a) local(i, t, ca, sa, k) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.55); gfx_circle(cx + 2.5 * sc, cy + 4.5 * sc, r * 1.02, 1, 1);
  ui_col(0x0A0A0A); gfx_circle(cx, cy, r + 1 * sc, 1, 1);
  ui_col(0x191817); gfx_circle(cx, cy, r, 1, 1);
  i = 0;
  loop(16,
    t = i / 16 * 2 * $pi; k = 0.5 + 0.5 * cos(t + 0.8);
    ui_col(ui_mix(0x0D0C0B, 0x48443F, k * 0.8)); gfx_circle(cx + sin(t) * r * 0.86, cy - cos(t) * r * 0.86, r * 0.15, 1, 1);
    ui_col(0x0D0C0B); gfx_circle(cx + sin(t + 0.196) * r * 0.9, cy - cos(t + 0.196) * r * 0.9, r * 0.075, 1, 1);
    i += 1;
  );
  ui_col(0x090808); gfx_circle(cx, cy, r * 0.70 + 1 * sc, 1, 1);
  ui_col(krv_bc ? krv_bc : 0x22201E); gfx_circle(cx, cy, r * 0.70, 1, 1);
  ui_cola(0xFFFFFF, 0.08); gfx_circle(cx, cy, r * 0.70, 0, 1);
  ui_col(0x060606); kr_thick(cx + ca * r * 0.18, cy + sa * r * 0.18, cx + ca * r * 0.98, cy + sa * r * 0.98, 4.2 * sc);
  ui_col(krv_bc ? ( (krv_bc & 255) + ((krv_bc >> 8) & 255) + ((krv_bc >> 16) & 255) > 500 ? 0x17191B : 0xF4F0E6 ) : KRA); kr_thick(cx + ca * r * 0.22, cy + sa * r * 0.22, cx + ca * r * 0.95, cy + sa * r * 0.95, 2.5 * sc);
);
function kr_scap(cx, cy, r, a, cap) local(ca, sa, k, pc) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(0x121212); gfx_circle(cx, cy, r, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx, cy, r, 0, 1);
  k = r * 0.74;
  ui_col(cap); gfx_circle(cx, cy, k, 1, 1);
  ui_col(ui_mix(cap, 0x000000, 0.35)); gfx_circle(cx, cy, k, 0, 1);
  pc = (cap & 255) + ((cap >> 8) & 255) + ((cap >> 16) & 255) > 380 ? KRPT : 0xF4F0E6;
  ui_col(pc); kr_thick(cx + ca * k * 0.2, cy + sa * k * 0.2, cx + ca * r * 0.94, cy + sa * r * 0.94, 2.6 * sc);
);
krv_small = 0; krv_lg = 0; krv_step = 0; krv_cap = 0;
function kr_kn(v, lo, hi) ( krv_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function kr_kv(n, lo, hi) ( krv_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function kr_knob(cx, cy, r, idx, lo, hi, def) local(v, n, dx, dy, hov, did) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - krv_lt < 0.35 && krv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; krv_lt = 0; ) : (
      drag_id = did; krv_y = mouse_y; krv_lt = time_precise(); krv_lid = idx; krv_n = kr_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    krv_n = min(max(krv_n + (krv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : (krv_step ? 160 : 240)) * sc), 0), 1); krv_y = mouse_y;
    v = kr_kv(krv_n, lo, hi); krv_step ? v = floor(v + 0.5);
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    krv_step ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(kr_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
      slider(idx) = kr_kv(n, lo, hi);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(kr_kn(v, lo, hi), 0), 1);
  krv_small ? kr_scap(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi, krv_cap ? krv_cap : KRC) : kr_bake(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi);
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  hov || drag_id == did;
);
function kr_name(cx, cy, act, name, val) ( gfx_setfont(14); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy, act ? val : name); );
// a small knob with a tick ring (or n step ticks) and its name; the value while touched
function kr_small(cx, cy, r, idx, lo, hi, def, nt, name, val) local(i, t, act) (
  ui_cola(KRI, 0.85); i = 0;
  loop(nt, t = -0.75 * $pi + i / (nt - 1) * 1.5 * $pi;
    gfx_line((cx + sin(t) * (r + 4)) * sc, (cy - cos(t) * (r + 4)) * sc, (cx + sin(t) * (r + 8)) * sc, (cy - cos(t) * (r + 8)) * sc, 1); i += 1; );
  krv_small = 1; act = kr_knob(cx, cy, r, idx, lo, hi, def); krv_small = 0;
  strlen(name) ? ( gfx_setfont(11); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy + r + 15, act ? val : name); );
  act;
);
function kr_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? KRRED : zone == 1 ? KRAMB : KRCN;
  lit ? ( ui_cola(c, 0.16); kr_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); kr_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); kr_r(x, y, w, 1.5); )
      : ( ui_col(KRGH); kr_r(x, y, w, h); ui_cola(0x000000, 0.25); kr_r(x, y + h - 1, w, 1); );
);
function kr_hbar(x, y, w, h, v) local(n, i, sw, d) (
  n = 32; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; kr_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d, d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);
function kr_grbar(x, y, w, h, gr) local(n, i, sw, d) (                     // gain reduction: 0 .. -24 dB, from the left
  n = 24; sw = w / n; i = 0;
  loop(n, d = -(i + 0.5); kr_cell(x + i * sw + 0.5, y, sw - 2, h, gr <= d, 1); i += 1; );
);
function kr_window(x, y, w, h) ( ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRW); kr_r(x + 1, y + 1, w - 2, h - 2); );
function kr_vbar(x, y, w, h, v) local(n, i, sh, d) (
  n = 24; sh = h / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; kr_cell(x, y + h - (i + 1) * sh + 1, w, sh - 2, v >= d, d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);
function kr_vgr(x, y, w, h, gr) local(n, i, sh, d) (
  n = 20; sh = h / n; i = 0;
  loop(n, d = -(i + 0.5); kr_cell(x, y + i * sh + 1, w, sh - 2, gr <= d, 1); i += 1; );
);
function kr_db(v) ( sprintf(#krd, "%+.1f dB", v); #krd; );
function kr_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
function kr_hz(f) ( f >= 1000 ? sprintf(#krh, "%.2g kHz", f / 1000) : sprintf(#krh, "%d Hz", floor(f + 0.5)); #krh; );
function kr_lamp(cx, cy, c, on) (
  on ? ( ui_cola(c, 0.25); gfx_circle(cx * sc, cy * sc, 8 * sc, 1, 1); ui_col(c); ) : ui_col(ui_mix(KRF, 0x000000, 0.3));
  gfx_circle(cx * sc, cy * sc, 5 * sc, 1, 1); ui_cola(0xFFFFFF, on ? 0.35 : 0.08); gfx_circle((cx - 1.5) * sc, (cy - 1.5) * sc, 1.6 * sc, 1, 1);
);
// one half-rack panel at y0 (height 268), its top strip
function kr_panel(y0) (
  ui_col(KRP); kr_r(12, y0, 1056, 268);
  ui_cola(0xFFFFFF, 0.07); kr_r(12, y0, 1056, 1.5); kr_r(12, y0, 1.5, 268);
  ui_cola(0x000000, 0.35); kr_r(12, y0 + 266.5, 1056, 1.5); kr_r(1066.5, y0, 1.5, 268);
  ui_col(KRH); kr_r(13.5, y0 + 1.5, 1053, 42);
  ui_col(KRA); kr_r(13.5, y0 + 43.5, 1053, 2);
);
function kr_sec(x, y, w, h, name) ( kr_sect(x, y, w, h, name); );

// =====================================================================
// The rack: two half-rack panels
// =====================================================================
ui_col(ui_mix(KRP, 0x000000, 0.55)); gfx_rect(0, 0, gfx_w, gfx_h);
kr_panel(8); kr_panel(284);

// ---------- upper panel: header ----------
ui_col(KRA); gfx_circle(40 * sc, 30 * sc, 14 * sc, 1, 1);
gfx_setfont(4); ui_col(KRKT); ui_text(40 * sc, 24.5 * sc, "GFX");
gfx_setfont(6); ui_col(KRI); kr_txt(64, 15, "SUP34"); gfx_measurestr("SUP34", krv_tw, krv_th);
krv_tx = 64 + krv_tw / sc + 14;
gfx_setfont(11); ui_col(KRI2); kr_txt(krv_tx, 15, "CHANNEL STRIP"); kr_txt(krv_tx, 30, "1 / 2  INPUT · DYNAMICS");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(340 * sc, 13 * sc, 290 * sc, 32 * sc, pr_cur, #sp_pm);
k_ > 0 ? prs_dirty = k_;
ui_size_picker(1000 * sc, 20 * sc);

krv_sy = 60; krv_h = 206; krv_k = 178;                     // the upper sections and their knob row

// PREAMP: GAIN, DRV (key and knob), polarity
kr_sec(22, krv_sy, 230, krv_h, "PREAMP");
kr_key(140, 68, 52, 24, "DRV", slider2 >= 0.5) ? kr_tog(2);
kr_key(198, 68, 46, 24, "ø", slider4 >= 0.5) ? kr_tog(4);
kr_scale(84, krv_k, 32, 5, 17, "-20|-10|0|+10|+20", 2);
krv_a = kr_knob(84, krv_k, 32, 1, -20, 20, 0); kr_name(84, krv_k + 60, krv_a, "GAIN", kr_db(slider1));
krv_v = 20 * log10(max(spa_v, 0.000001)); spa_v = 0; krv_vl = krv_v > krv_vl ? krv_v : krv_vl - 0.4;
kr_lamp(132, 80, krv_vl > -3 ? KRRED : krv_vl > -12 ? KRAMB : 0x3BD16F, slider2 >= 0.5);
gfx_setfont(10); ui_col(KRI2); kr_rtxt(170, krv_k + 26, "2ND"); kr_txt(212, krv_k + 20, "3RD");
sprintf(#krv, "%.1f", slider3); kr_small(194, krv_k - 6, 18, 3, 0, 10, 5, 11, "DRV", #krv);

// FILTERS: HPF, LPF
kr_sec(258, krv_sy, 150, krv_h, "FILTERS");
krv_lg = 1;
slider5 <= 15.5 ? strcpy(#krv, "OFF") : sprintf(#krv, "%d Hz", floor(slider5 + 0.5));
kr_small(333, 124, 18, 5, 15, 350, 15, 11, "HPF", #krv);
slider6 >= 21.95 ? strcpy(#krv2, "OFF") : sprintf(#krv2, "%.1f kHz", slider6);
kr_small(333, 208, 18, 6, 3, 22, 22, 11, "LPF", #krv2);
krv_lg = 0;
gfx_setfont(13); ui_col(KRA); kr_rtxt(400, 105, #krv); kr_rtxt(400, 190, #krv2);

// COMPRESSOR
kr_sec(414, krv_sy, 330, krv_h, "COMPRESSOR");
kr_key(566, 68, 60, 24, "PEAK", slider12 >= 0.5) ? kr_tog(12);
kr_key(630, 68, 58, 24, "FAST", slider11 >= 0.5) ? kr_tog(11);
kr_key(692, 68, 44, 24, "IN", slider7 >= 0.5) ? kr_tog(7);
kr_scale(484, krv_k, 32, 5, 17, "-40|-30|-20|-10|0", 2);
krv_a = kr_knob(484, krv_k, 32, 9, -40, 0, -20); sprintf(#krv, "%.1f dBFS", slider9); kr_name(484, krv_k + 60, krv_a, "THRESHOLD", #krv);
slider8 >= 20.95 ? strcpy(#krr, "INF : 1") : sprintf(#krr, "%.1f : 1", slider8);
kr_small(600, krv_k - 6, 19, 8, 1, 21, 3, 11, "RATIO", #krr);
krv_lg = 1; sprintf(#krv, "%.2f s", slider10); kr_small(682, krv_k - 6, 19, 10, 0.1, 4, 0.3, 11, "RELEASE", #krv); krv_lg = 0;

// GATE / EXP
kr_sec(750, krv_sy, 308, krv_h, "GATE / EXP");
krv_g = spa_gt; spa_gt = 0;
kr_lamp(842, 80, krv_g > -1 ? 0x3BD16F : KRRED, slider13 >= 0.5);
kr_key(860, 68, 52, 24, "EXP", slider19 >= 0.5) ? kr_tog(19);
kr_key(916, 68, 58, 24, "FAST", slider18 >= 0.5) ? kr_tog(18);
kr_key(1006, 68, 44, 24, "IN", slider13 >= 0.5) ? kr_tog(13);
kr_scale(816, krv_k, 32, 4, 17, "-60|-40|-20|0", 1);
krv_a = kr_knob(816, krv_k, 32, 15, -60, 0, -40); sprintf(#krv, "%.1f dBFS", slider15); kr_name(816, krv_k + 60, krv_a, "THRESHOLD", #krv);
sprintf(#krv, "%.1f dB", slider14); kr_small(904, krv_k - 6, 17, 14, 0, 40, 20, 9, "RANGE", #krv);
krv_lg = 1; sprintf(#krv, "%.2f s", slider16); kr_small(964, krv_k - 6, 17, 16, 0.1, 4, 0.25, 11, "RELEASE", #krv); krv_lg = 0;
sprintf(#krv, "%.2f s", slider17); kr_small(1024, krv_k - 6, 17, 17, 0, 4, 0, 9, "HOLD", #krv);

// ---------- lower panel: header ----------
ui_col(KRA); gfx_circle(40 * sc, 306 * sc, 14 * sc, 1, 1);
gfx_setfont(4); ui_col(KRKT); ui_text(40 * sc, 300.5 * sc, "GFX");
gfx_setfont(14); ui_col(KRI); kr_txt(64, 293, "SUP34");
gfx_setfont(11); ui_col(KRI2); kr_txt(64, 310, "2 / 2  EQ · ROUTING · OUTPUT");
gfx_setfont(11); ui_col(KRI2); kr_rtxt(392, 306, "EQ CIRCUIT");
kr_key(400, 292, 44, 26, "E", slider21 < 0.5) ? ( slider21 = 0; ui_auto(21); );
kr_key(448, 292, 44, 26, "G", slider21 >= 0.5) ? ( slider21 = 1; ui_auto(21); );
kr_key(512, 292, 66, 26, "EQ IN", slider20 >= 0.5) ? kr_tog(20);
gfx_setfont(11); ui_col(KRI2); kr_rtxt(892, 306, "METER");
kr_key(900, 292, 50, 26, "IN", slider39 < 0.5) ? ( slider39 = 0; ui_auto(39); );
kr_key(954, 292, 58, 26, "OUT", slider39 >= 0.5) ? ( slider39 = 1; ui_auto(39); );

krv_sy = 336; krv_h = 206;
// EQ: LF, LMF, HMF, HF
kr_sec(22, krv_sy, 660, krv_h, "");
krv_ec = slider21 >= 0.5;
krv_i = 0;
loop(4,
  krv_cx = 22 + 82 + krv_i * 165;
  krv_i > 0 ? ( ui_col(ui_mix(KRF, KRP, 0.6)); kr_r(krv_cx - 83, krv_sy + 8, 1, krv_h - 16); );
  krv_c = krv_i == 0 ? KCLO : krv_i == 1 ? KCLM : krv_i == 2 ? KCHM : KCHI;
  gfx_setfont(11); ui_col(KRI); kr_txt(krv_cx - 72, krv_sy + 9, krv_i == 0 ? "LF" : krv_i == 1 ? "LMF" : krv_i == 2 ? "HMF" : "HF");
  ui_col(krv_c); kr_r(krv_cx - 72, krv_sy + 26, 30, 3);
  // the band's key: E: LF / HF BELL; G: LMF / 3, HMF x 3
  krv_i == 0 ? ( !krv_ec ? ( kr_key(krv_cx + 16, krv_sy + 8, 58, 22, "BELL", slider32 >= 0.5) ? kr_tog(32); ) : kr_dim(krv_cx + 16, krv_sy + 8, 58, 22, "BELL"); );
  krv_i == 1 ? ( krv_ec ? ( kr_key(krv_cx + 16, krv_sy + 8, 58, 22, "÷ 3", slider32 >= 0.5) ? kr_tog(32); ) : kr_dim(krv_cx + 16, krv_sy + 8, 58, 22, "÷ 3"); );
  krv_i == 2 ? ( krv_ec ? ( kr_key(krv_cx + 16, krv_sy + 8, 58, 22, "× 3", slider33 >= 0.5) ? kr_tog(33); ) : kr_dim(krv_cx + 16, krv_sy + 8, 58, 22, "× 3"); );
  krv_i == 3 ? ( !krv_ec ? ( kr_key(krv_cx + 16, krv_sy + 8, 58, 22, "BELL", slider33 >= 0.5) ? kr_tog(33); ) : kr_dim(krv_cx + 16, krv_sy + 8, 58, 22, "BELL"); );
  // FREQ (and Q on the mids)
  krv_cap = krv_c; krv_lg = 1;
  krv_fi = krv_i == 0 ? 23 : krv_i == 1 ? 25 : krv_i == 2 ? 28 : 31;
  krv_f = slider(krv_fi) * (krv_i == 3 ? 1000 : 1) * (krv_ec && krv_i == 1 && slider32 >= 0.5 ? 1 / 3 : 1) * (krv_ec && krv_i == 2 && slider33 >= 0.5 ? 3 : 1);
  kr_hz(krv_f);
  krv_fx = krv_i == 0 || krv_i == 3 ? krv_cx : krv_cx - 36;
  krv_i == 0 ? kr_small(krv_fx, krv_sy + 66, 18, 23, 30, 450, 100, 11, #krh, #krh) :
  krv_i == 1 ? kr_small(krv_fx, krv_sy + 66, 18, 25, 200, 2500, 800, 11, #krh, #krh) :
  krv_i == 2 ? kr_small(krv_fx, krv_sy + 66, 18, 28, 600, 7000, 3000, 11, #krh, #krh) :
               kr_small(krv_fx, krv_sy + 66, 18, 31, 1.5, 16, 8, 11, #krh, #krh);
  krv_i == 1 || krv_i == 2 ? ( sprintf(#krq, "Q %.2f", slider(krv_i == 1 ? 26 : 29)); kr_small(krv_cx + 36, krv_sy + 66, 18, krv_i == 1 ? 26 : 29, 0.5, 2.5, 1, 9, #krq, #krq); );
  krv_lg = 0; krv_cap = 0;
  // GAIN
  krv_gi = krv_i == 0 ? 22 : krv_i == 1 ? 24 : krv_i == 2 ? 27 : 30;
  kr_scale(krv_cx, krv_sy + 150, 26, 3, 14, "-15|0|+15", 5);
  krv_bc = krv_ec ? ( krv_mx ? 0xF1E5CF : 0xB8607C ) : 0;   // G: pink gain caps (MATRIX: cream); E: black
  krv_a = kr_knob(krv_cx, krv_sy + 150, 26, krv_gi, -15, 15, 0); krv_bc = 0; kr_name(krv_cx, krv_sy + 196, krv_a, "GAIN", kr_db(slider(krv_gi)));
  krv_i += 1;
);

// ROUTING
kr_sec(688, krv_sy, 150, krv_h, "ROUTING");
kr_key(698, krv_sy + 32, 130, 30, "DYN PRE EQ", slider34 >= 0.5) ? kr_tog(34);
kr_key(698, krv_sy + 72, 130, 30, "FLT ► SC", slider35 >= 0.5) ? kr_tog(35);
kr_key(698, krv_sy + 112, 130, 30, "EQ ► SC", slider36 >= 0.5) ? kr_tog(36);
kr_key(698, krv_sy + 152, 130, 30, "EXT KEY", slider37 >= 0.5) ? kr_tog(37);
gfx_setfont(10); ui_col(KRI2); kr_ctxt(763, krv_sy + 194, "KEY = INPUTS 3 / 4");

// OUTPUT
kr_sec(844, krv_sy, 120, krv_h, "OUTPUT");
kr_scale(904, krv_sy + 92, 30, 5, 16, "-20|-10|0|+10|+20", 2);
krv_a = kr_knob(904, krv_sy + 92, 30, 38, -20, 20, 0); kr_name(904, krv_sy + 148, krv_a, "TRIM", kr_db(slider38));
sprintf(#krv, "%d%%", floor(slider40 + 0.5)); kr_small(934, krv_sy + 178, 13, 40, 0, 100, 50, 11, "", #krv);
gfx_setfont(11); ui_col(KRI2); kr_txt(854, krv_sy + 172, "DRIFT");

// METERS: IN or OUT (L / R) and the compressor's GR
kr_sec(970, krv_sy, 88, krv_h, "");
kr_window(976, krv_sy + 8, 76, 168);
function kr_fall(v, pk) ( pk = pk > 0.0000001 ? 20 * log10(pk) : -90; pk > v ? pk : max(v - 0.6, -90); );
slider39 >= 0.5 ? ( krv_ml = kr_fall(krv_ml, spa_ol); krv_mr = kr_fall(krv_mr, spa_or); ) : ( krv_ml = kr_fall(krv_ml, spa_il); krv_mr = kr_fall(krv_mr, spa_ir); );
spa_il = spa_ir = spa_ol = spa_or = 0;
krv_gr = spa_gr < krv_gr ? spa_gr : min(krv_gr + 0.5, 0); spa_gr = 0;
kr_vbar(984, krv_sy + 14, 14, 156, krv_ml); kr_vbar(1001, krv_sy + 14, 14, 156, krv_mr);
kr_vgr(1024, krv_sy + 14, 14, 156, krv_gr);
gfx_setfont(10); ui_col(KRI); kr_ctxt(999, krv_sy + 186, slider39 >= 0.5 ? "OUT" : "IN"); kr_ctxt(1031, krv_sy + 186, "GR");
sprintf(#krv, "%.1f", krv_gr); gfx_setfont(13); ui_col(KRAMB); kr_ctxt(1031, krv_sy + 199, #krv);

pk_end();
ui_end();
