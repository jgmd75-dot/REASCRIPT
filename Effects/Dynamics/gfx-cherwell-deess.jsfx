desc:CW De-Esser [de-esser] (GFX)
//tags: de-esser dynamic-eq harshness vocal
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-bypass (.jsfx-inc) in the same folder.

import gfx-bypass.jsfx-inc

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

slider1:ds_f=6600<2000,16000,1>-Freq (Hz)
slider2:ds_q=1<0.3,4,0.01>-Width (Q)
slider3:ds_thr=-30<-60,0,0.1>-Threshold (dB)
slider4:ds_rng=10<0,24,0.1>-Range (dB)
slider5:ds_rel=80<20,500,1>-Release (ms)
slider6:ds_split=1<0,1,1{Wide,Split}>-Mode
slider7:ds_shape=0<0,1,1{Band,High}>-Shape
slider8:ds_relm=1<0,1,1{Absolute,Relative}>-Threshold mode
slider9:ds_lsn=0<0,1,1{Off,On}>-Listen
slider10:out_db=0<-12,12,0.1>-Output (dB)
slider11:byp=0<0,1,1{Off,On}>-Bypass
slider12:ds_en=1<0,1,1{Off,On}>-Sibilance in
slider13:hs_en=0<0,1,1{Off,On}>-Harshness in
slider14:hs_f=3300<1100,8800,1>-Harshness freq (Hz)
slider15:hs_q=1.4<0.5,4,0.01>-Harshness width (Q)
slider16:hs_thr=-18<-60,0,0.1>-Harshness threshold (dB)
slider17:hs_rng=6<0,18,0.1>-Harshness range (dB)
slider18:hs_rel=150<40,800,1>-Harshness release (ms)
slider19:hs_lsn=0<0,1,1{Off,On}>-Harshness listen
slider20:prs_sel=0<0,18,1{No preset,Init,Vocal: Female,Vocal: Male,Vocal: Gentle,Vocal: Hard S,Vocal: Wide (whole),Voice-over: Close Mic,Air: Tame the Top,Cymbals: Smooth,Guitar: Pick Click,Mix Bus: Harshness,Absolute: Classic,Vocal: Ess + Harsh,Vocal: Shouty Rock,Voice-over: Edgy Mic,Guitar: Fizz Tamer,Strings: Bow Bite,Mix Bus: Harsh Peaks}>-Preset

@init
#ui_man = "gfx-cherwell-deess";
ext_noinit = 1;
pr_cur = 1;
gfx_ext_retina = 1;
first_run = 1;
by_setup(11);

function db2g(d) ( exp(d * 0.11512925464970228); );
function tg(f) ( tan($pi * min(f, srate * 0.45) / srate); );

function svf_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tg(fc);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf_tick(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;
  lp = v2;  bp = v1;  hp = x - k * v1 - v2;
);
function svf_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function cut_set(db) local(A) (
  A = exp(db * 0.05756462732485115);
  ds_shape < 0.5 ? (
    cg = tg(ds_f);  ck = 1 / (ds_q * A);  cm0 = 1;  cm1 = ck * (A * A - 1);  cm2 = 0;
  ) : (
    cg = tg(ds_f) * sqrt(A);  ck = 1.41421356;  cm0 = A * A;  cm1 = ck * (1 - A) * A;  cm2 = 1 - A * A;
  );
  ca1 = 1 / (1 + cg * (cg + ck));  ca2 = cg * ca1;  ca3 = cg * ca2;
);
function cut_tick(x) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = ca1 * ic1 + ca2 * v3;  v2 = ic2 + ca2 * ic1 + ca3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;
  cm0 * x + cm1 * v1 + cm2 * v2;
);
function hcut_set(db) local(A) (
  A = exp(db * 0.05756462732485115);
  hcg = tg(hs_f);  hck = 1 / (hs_q * A);  hcm1 = hck * (A * A - 1);
  hca1 = 1 / (1 + hcg * (hcg + hck));  hca2 = hcg * hca1;  hca3 = hcg * hca2;
);
function hcut_tick(x) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = hca1 * ic1 + hca2 * v3;  v2 = ic2 + hca2 * ic1 + hca3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;
  x + hcm1 * v1;
);

function update_params() (
  ds_shape < 0.5 ? ( dtL.svf_set(ds_f, ds_q);  dtR.svf_set(ds_f, ds_q); )
                 : ( dtL.svf_set(ds_f, 0.7071);  dtR.svf_set(ds_f, 0.7071); );
  htL.svf_set(hs_f, hs_q);  htR.svf_set(hs_f, hs_q);
  b_att = 1 - exp(-1000 / (0.5 * srate));
  b_rel = 1 - exp(-1000 / (ds_rel * srate));
  h_att = 1 - exp(-1000 / (3 * srate));
  h_rel = 1 - exp(-1000 / (hs_rel * srate));
  f_att = 1 - exp(-1000 / (5 * srate));
  f_rel = 1 - exp(-1000 / (60 * srate));
  thr_eff  = ds_relm ? ds_thr * 0.5 : ds_thr;
  hthr_eff = ds_relm ? hs_thr * 0.5 : hs_thr;
  out_t = db2g(out_db);
  sm = 1 - exp(-1 / (0.02 * srate));
  ramp_step = 1 / (0.010 * srate);
  cut_last = 999;  hcut_last = 999;
  first_run ? ( out_s = out_t;  en_s = ds_en;  hen_s = hs_en;  lsn_s = ds_lsn;  hlsn_s = hs_lsn;  first_run = 0; );
);

function pr_s(f, q, thr, rng, rel, split, shape, relm) (
  slider(1) = f;  slider(2) = q;  slider(3) = thr;  slider(4) = rng;  slider(5) = rel;
  slider(6) = split;  slider(7) = shape;  slider(8) = relm;  slider(9) = 0;  slider(10) = 0;  slider(12) = 1;
);
function pr_h(on, f, q, thr, rng, rel) (
  slider(13) = on;  slider(14) = f;  slider(15) = q;  slider(16) = thr;  slider(17) = rng;  slider(18) = rel;  slider(19) = 0;
);
function load_preset(p) (
  p == 1  ? ( pr_s(6600, 1, -30, 10, 80, 1, 0, 1);    pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 2  ? ( pr_s(7700, 1.2, -28, 8, 70, 1, 0, 1);   pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 3  ? ( pr_s(5500, 1, -28, 8, 80, 1, 0, 1);     pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 4  ? ( pr_s(6600, 0.8, -22, 5, 100, 1, 0, 1);  pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 5  ? ( pr_s(5500, 1.6, -34, 14, 60, 1, 0, 1);  pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 6  ? ( pr_s(6600, 1, -26, 6, 80, 0, 0, 1);     pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 7  ? ( pr_s(5500, 1, -32, 10, 60, 1, 0, 1);    pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 8  ? ( pr_s(9900, 1, -26, 6, 120, 1, 1, 1);    pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 9  ? ( pr_s(8800, 0.7, -24, 6, 150, 1, 1, 1);  pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 10 ? ( pr_s(3300, 2, -30, 6, 40, 1, 0, 1);     pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 11 ? ( pr_s(4400, 1.2, -20, 3, 120, 1, 0, 1);  pr_h(0, 3300, 1.4, -18, 6, 150); ) :
  p == 12 ? ( pr_s(6600, 1, -30, 10, 80, 1, 0, 0);    pr_h(0, 3300, 1.4, -48, 6, 150); ) :
  p == 13 ? ( pr_s(6600, 1, -30, 8, 70, 1, 0, 1);     pr_h(1, 3300, 1.4, -18, 5, 150); ) :
  p == 14 ? ( pr_s(5500, 1, -28, 8, 80, 1, 0, 1);     pr_h(1, 2200, 1.2, -22, 7, 120); ) :
  p == 15 ? ( pr_s(6600, 1, -30, 8, 70, 1, 0, 1);     pr_h(1, 4400, 1.6, -20, 6, 120); ) :
  p == 16 ? ( pr_s(7700, 1, -26, 4, 100, 1, 1, 1);    pr_h(1, 3300, 1, -20, 6, 180); ) :
  p == 17 ? ( pr_s(8800, 1, -26, 3, 120, 1, 1, 1);    pr_h(1, 2200, 1.2, -18, 5, 200); ) :
  p == 18 ? ( pr_s(6600, 1, -20, 2, 100, 1, 0, 1);    pr_h(1, 3300, 0.8, -14, 3, 250); ) :
  p == 19 ? ( pr_s(6600, 1, -30, 10, 80, 1, 0, 1);    pr_h(0, 3300, 1.4, -18, 6, 150); ) : 0;
  slider_automate(2 ^ 10 - 1 + 2 ^ 19 - 2 ^ 11);
  gui_dirty = 1;
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(20, i != 20 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
prm_dirty ? ( prm_dirty = 0;  update_params(); );
gr_d   = max(gr_d, gr_pk);     gr_pk = 0;
grh_d  = max(grh_d, grh_pk);   grh_pk = 0;
outpk_disp = max(outpk_disp, outpk);  outpk = 0;

@sample
by_in();
out_s += (out_t - out_s) * sm;
en_s != ds_en ? ( en_s = ds_en > en_s ? min(1, en_s + ramp_step) : max(0, en_s - ramp_step); );
hen_s != hs_en ? ( hen_s = hs_en > hen_s ? min(1, hen_s + ramp_step) : max(0, hen_s - ramp_step); );
lsn_s != ds_lsn ? ( lsn_s = ds_lsn > lsn_s ? min(1, lsn_s + ramp_step) : max(0, lsn_s - ramp_step); );
hlsn_s != hs_lsn ? ( hlsn_s = hs_lsn > hlsn_s ? min(1, hlsn_s + ramp_step) : max(0, hlsn_s - ramp_step); );
xL = spl0;  xR = spl1;

fl = max(abs(xL), abs(xR));
fenv += (fl - fenv) * (fl > fenv ? f_att : f_rel);
fdb = fenv > 0.000001 ? 8.685889638065035 * log(fenv) : -120;

dtL.svf_tick(xL);  dtR.svf_tick(xR);
ds_shape < 0.5 ? ( bl = dtL.k * dtL.bp;  br = dtR.k * dtR.bp; ) : ( bl = dtL.hp;  br = dtR.hp; );
lv = max(abs(bl), abs(br));
benv += (lv - benv) * (lv > benv ? b_att : b_rel);
bdb = benv > 0.000001 ? 8.685889638065035 * log(benv) : -120;
over = ds_relm ? (bdb - fdb) - thr_eff : bdb - thr_eff;
over <= -3 ? ( grt = 0; ) : over >= 3 ? ( grt = over * 0.75; ) : ( grt = 0.75 * sqr(over + 3) / 12; );
fenv < 0.00003 ? grt = 0;
grt = min(ds_rng, grt) * en_s;
gr += (grt - gr) * (grt > gr ? b_att : b_rel);
gr > gr_pk ? gr_pk = gr;

h_run = hen_s > 0 || grh > 0.0001 || hlsn_s > 0;
h_run ? (
  h_idle ? ( htL.svf_clr();  htR.svf_clr();  hcL.svf_clr();  hcR.svf_clr();  henv = 0;  h_idle = 0; );
  htL.svf_tick(xL);  htR.svf_tick(xR);
  hbl = htL.k * htL.bp;  hbr = htR.k * htR.bp;
  hv = max(abs(hbl), abs(hbr));
  henv += (hv - henv) * (hv > henv ? h_att : h_rel);
  hdb = henv > 0.000001 ? 8.685889638065035 * log(henv) : -120;
  hover = ds_relm ? (hdb - fdb) - hthr_eff : hdb - hthr_eff;
  hover <= -3 ? ( grht = 0; ) : hover >= 3 ? ( grht = hover * 0.6667; ) : ( grht = 0.6667 * sqr(hover + 3) / 12; );
  fenv < 0.00003 ? grht = 0;
  grht = min(hs_rng, grht) * hen_s;
  grh += (grht - grh) * (grht > grh ? h_att : h_rel);
  grh < 0.0001 && grht == 0 ? grh = 0;
  grh > grh_pk ? grh_pk = grh;
  abs(grh - hcut_last) > 0.02 ? ( hcut_set(-grh);  hcut_last = grh; );
  yL = hcL.hcut_tick(xL);  yR = hcR.hcut_tick(xR);
) : (
  h_idle = 1;  hbl = hbr = 0;  grh = 0;  yL = xL;  yR = xR;
);

ds_split ? (
  abs(gr - cut_last) > 0.02 ? ( cut_set(-gr);  cut_last = gr; );
  yL = csL.cut_tick(yL);  yR = csR.cut_tick(yR);
) : (
  g = db2g(-gr);  yL *= g;  yR *= g;
);
lw = max(lsn_s, hlsn_s);
lw > 0 ? (
  yL = yL * (1 - lw) + bl * lsn_s + hbl * hlsn_s;
  yR = yR * (1 - lw) + br * lsn_s + hbr * hlsn_s;
);
yL *= out_s;  yR *= out_s;

outpk = max(outpk, max(abs(yL), abs(yR)));
spl0 = yL;  spl1 = yR;
by_out();

@serialize
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@gfx 1000 500
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function gdb(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function param_touched(idx) ( slider_automate(2 ^ (idx - 1)); gui_dirty = 1; );
function rivet(x, y) (
  col(0x8A9098, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xF2F4F6, 0.6); gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);

function kn(cx, cy, r, idx, vmin, vmax, def, cap, lbl, fmt)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, w, h, ty, lg, fn)
(
  lg = klog;  klog = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = slider(idx);
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t;  drag_sh = mouse_cap & 8; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && whl != 0 && !drag_idx ? (
    t = max(0, min(1, t + whl / 120 * (mouse_cap & 8 ? 0.005 : 0.03)));
    v = lg ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    lg ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    whl = 0;
  );
  drag_idx == idx ? (
    (mouse_cap & 8) != drag_sh ? ( drag_sh = mouse_cap & 8;  drag_y = mouse_y;  drag_t = t; );
    fn = drag_sh ? 5 : 1;
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / (ps(220) * fn)));
    v = lg ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    lg ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = slider(idx);
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  col(0xE4F0EF, 0.75);  j = 0;
  loop(5,
    b = a0 + j / 4 * (a1 - a0);
    gfx_circle((x + sin(b) * (rr + ps(4) + rr + ps(8)) * 0.5), (y - cos(b) * (rr + ps(4) + rr + ps(8)) * 0.5), max(((rr + ps(8)) - (rr + ps(4))) * 0.25, 1), 1, 1);
    j += 1;
  );
  col(0x000000, 0.3);   gfx_circle(x + ps(2), y + ps(3), rr, 1, 1);
  col(0x24272C, 1);     gfx_circle(x, y, rr, 1, 1);
  j = 0;
  loop(40,
    b = tv + j * $pi / 20;
    col(j % 2 ? 0x34383E : 0x4C5158, 1);
    gfx_line(x + sin(b) * rr * 0.62, y - cos(b) * rr * 0.62, x + sin(b) * rr * 0.95, y - cos(b) * rr * 0.95, 1);
    j += 1;
  );
  col(0x1A1C20, 1);     gfx_circle(x, y, rr, 0, 1);
  col(0x1A1C20, 1);     gfx_circle(x, y, rr * 0.6, 1, 1);
  col(cap, 0.82);       gfx_circle(x, y, rr * 0.54, 1, 1);
  col(0xEAF6C2, 0.5);   gfx_arc(x, y, rr * 0.46, -1.9, -0.3, 1);
  col(shade(cap, 0.6), 0.8);  gfx_circle(x, y, rr * 0.54, 0, 1);
  b = ps(r > 20 ? 1.5 : 1.2);
  col(0xCDEB7A, 0.12);  gfx_circle(x + sin(tv) * rr * 0.78, y - cos(tv) * rr * 0.78, max(rr * 0.2, b * 2.6), 1, 1);
  col(0xCDEB7A, 0.25);  gfx_circle(x + sin(tv) * rr * 0.78, y - cos(tv) * rr * 0.78, max(rr * 0.15, b * 2), 1, 1);
  col(0xDDF59A, 1);     gfx_circle(x + sin(tv) * rr * 0.78, y - cos(tv) * rr * 0.78, max(rr * 0.1, b * 1.4), 1, 1);
  gfx_setfont(6);  col(0xE4F0EF, 1);  text_c(x, y + rr + ps(22), lbl);
  hov || drag_idx == idx ? (
    fmt == 2 ? sprintf(#kv, "%.1f dB", v) :
    fmt == 3 ? ( v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
    fmt == 4 ? sprintf(#kv, "Q %.2f", v) :
               ( v < 10 ? sprintf(#kv, "%.1f ms", v) : sprintf(#kv, "%d ms", v); );
    gfx_setfont(3);  gfx_measurestr(#kv, w, h);
    ty = y - rr - ps(12) - h;
    col(0x0E3A40, 0.95);  gfx_rect(x - w * 0.5 - ps(6), ty - ps(3), w + ps(12), h + ps(6), 1);
    col(0xE4F0EF, 1);     text_c(x, ty + h * 0.5, #kv);
  );
);

LK_AMB = 0xF2A41E;  LK_SAGE = 0xA0AF84;  LK_YEL = 0xF2C230;  LK_SKY = 0x7FB8E6;  lk_well = 0x141518;
C_ESS = 0x8EC6F0;  C_HSH = 0xEC7A6E;
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lk_fit(x, y, w, h, on, c, str) local(k) (
  k = min(w / 62, h / 48);
  lk_key(x + 4 * k, y + 4 * k, w - 8 * k, h - 8 * k, on, c, str);
);

function title_lamp(cx, cy, on) local(x, y, hov) (
  x = px(cx);  y = py(cy);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(ps(15));
  col(0x000000, 0.25);  gfx_circle(x + ps(1.5), y + ps(2), ps(10), 1, 1);
  on ? ( col(0xF2A41E, 0.12);  gfx_circle(x, y, ps(17), 1, 1);  col(0xF2A41E, 0.22);  gfx_circle(x, y, ps(13), 1, 1); );
  col(0xE9E2CC, 1);  gfx_circle(x, y, ps(10), 1, 1);
  col(0x8A8270, 1);  gfx_circle(x, y, ps(10), 0, 1);
  col(on ? 0xF2A41E : 0x5A4A32, 1);  gfx_circle(x, y, ps(6.5), 1, 1);
  on ? ( col(0xFFE0A0, 1);  gfx_circle(x - ps(1.5), y - ps(1.5), ps(2.5), 1, 1); )
     : ( col(0x000000, 0.35);  gfx_circle(x, y, ps(6.5), 0, 1); );
  hov ? ( col(0xFFFFFF, 0.10);  gfx_circle(x, y, ps(10), 1, 1); );
  click && hov;
);

function vslider(x, y0, h, idx, vmin, vmax, def, lbl) local(vx, vy0, vh, v, t, cy, hov, now, j, d, yy, w, th) (
  vx = px(x);  vy0 = py(y0);  vh = ps(h);
  v = slider(idx);  t = (v - vmin) / (vmax - vmin);  cy = vy0 + vh * (1 - t);
  hov = abs(mouse_x - vx) < ps(16) && abs(mouse_y - cy) < ps(15);
  click && hov ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : (
      drag_idx = idx;  drag_y = mouse_y;  drag_v = v;
    );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && whl != 0 && !drag_idx ? (
    v = floor(max(vmin, min(vmax, v + whl / 120 * (vmax - vmin) * (mouse_cap & 8 ? 0.005 : 0.03))) * 10 + 0.5) / 10;
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    whl = 0;
  );
  drag_idx == idx ? (
    v = drag_v + (drag_y - mouse_y) * (vmax - vmin) / (vh * (mouse_cap & 8 ? 5 : 1));
    v = floor(max(vmin, min(vmax, v)) * 10 + 0.5) / 10;
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = slider(idx);  t = (v - vmin) / (vmax - vmin);  cy = vy0 + vh * (1 - t);

  gfx_setfont(5);  j = 0;
  loop(floor((vmax - vmin) / 3 + 0.5) + 1,
    d = vmax - j * 3;
    yy = vy0 + vh * (1 - (d - vmin) / (vmax - vmin));
    col(0xE4F0EF, 0.75);  gfx_line(vx - ps(14), yy, vx - ps(9), yy, 1);  gfx_line(vx + ps(9), yy, vx + ps(14), yy, 1);
    d > 0 ? sprintf(#sl, "+%d", d) : sprintf(#sl, "%d", d);  col(0xE4F0EF, 1);  text_c(vx - ps(28), yy, #sl);
    j += 1;
  );
  col(0x08363C, 1);  gfx_rect(vx - ps(4), vy0 - ps(4), ps(8), vh + ps(8), 1);
  col(0x061E22, 1);  gfx_rect(vx - ps(2), vy0 - ps(2), ps(4), vh + ps(4), 1);
  col(0x4E959E, 1);  gfx_rect(vx - ps(4), vy0 + vh + ps(3), ps(8), ps(1), 1);
  col(0x000000, 0.35);  gfx_rect(vx - ps(13), cy - ps(12), ps(28), ps(27), 1);
  col(0x24272C, 1);     gfx_rect(vx - ps(15), cy - ps(14), ps(30), ps(28), 1);
  col(0x4C5158, 1);     j = 0;
  loop(6, gfx_line(vx - ps(12), cy - ps(11) + j * ps(4.4), vx + ps(12), cy - ps(11) + j * ps(4.4), 1); j += 1; );
  col(0x5A5F67, 1);     gfx_rect(vx - ps(15), cy - ps(14), ps(30), ps(1), 1);
  col(0xCDEB7A, 0.12);  gfx_rect(vx - ps(15), cy - ps(3.5), ps(30), ps(7), 1);
  col(0xCDEB7A, 0.25);  gfx_rect(vx - ps(15), cy - ps(2), ps(30), ps(4), 1);
  col(0xDDF59A, 1);     gfx_rect(vx - ps(15), cy - ps(1), ps(30), ps(2), 1);
  gfx_setfont(6);  col(0xE4F0EF, 1);  text_c(vx - ps(6), vy0 + vh + ps(24), lbl);
  hov || drag_idx == idx ? (
    sprintf(#kv, "%+.1f dB", v);
    gfx_setfont(3);  gfx_measurestr(#kv, w, th);
    col(0x0E3A40, 0.95);  gfx_rect(vx - ps(22) - w - ps(12), cy - th * 0.5 - ps(3), w + ps(12), th + ps(6), 1);
    col(0xE4F0EF, 1);     text_c(vx - ps(22) - w * 0.5 - ps(6), cy, #kv);
  );
);

function vmeter(x, y0, h, db, lbl) local(n, sh, j, d, yy) (
  n = 34;  sh = h / n;
  col(0x11151B, 1);  gfx_rect(px(x - 3), py(y0 - 3), ps(22), ps(h + 6), 1);
  j = 0;
  loop(n,
    d = -48 + (j + 1) * 1.5;
    yy = y0 + h - (j + 1) * sh;
    d > 0 ? col(0xE0503A, db >= d - 1.5 ? 1 : 0.15) :
    d > -6 ? col(0xE8C060, db >= d - 1.5 ? 1 : 0.15) :
             col(0xA0AF84, db >= d - 1.5 ? 1 : 0.15);
    gfx_rect(px(x), py(yy) + 1, ps(16), ps(sh) - 1, 1);
    j += 1;
  );
  gfx_setfont(6);  col(0xE4F0EF, 1);  text_c(px(x + 8), py(y0 + h + 24), lbl);
);

function grrow(x, y, w, gr, rmax) local(n, sw, j, d, c) (
  n = 32;  sw = w / n;
  col(0x11151B, 1);  gfx_rect(px(x - 3), py(y - 3), ps(w + 6), ps(18), 1);
  j = 0;
  loop(n,
    d = (j + 1) * 0.75;
    c = d <= 6 ? 0x3CE05A : d <= 12 ? 0xFFC81E : 0xFF3A2A;
    col(c, gr >= d - 0.375 ? 1 : d <= rmax + 0.01 ? 0.22 : 0.08);
    gfx_rect(px(x + j * sw) + 1, py(y), ps(sw) - 1, ps(12), 1);
    j += 1;
  );
  gfx_setfont(5);  col(0xE4F0EF, 0.85);
  j = 0;
  loop(5,
    sprintf(#sl, "%d", j * 6);  text_c(px(x + w * j / 4), py(y + 25), #sl);
    j += 1;
  );
  text_c(px(x - 24), py(y + 6), "GR");
);

function cut_mag(f, db) local(w, w2, A, nr, ni, dr, di, sa) (
  w = f / ds_f;  w2 = w * w;  A = exp(db * 0.05756462732485115);
  ds_shape < 0.5 ? (
    nr = 1 - w2;  ni = w * A / ds_q;  dr = 1 - w2;  di = w / (A * ds_q);
  ) : (
    sa = sqrt(A) * 1.41421356;
    nr = A * (1 - A * w2);  ni = A * sa * w;  dr = A - w2;  di = sa * w;
  );
  10 * log10((nr * nr + ni * ni) / max(dr * dr + di * di, 0.0000000001));
);
function hcut_mag(f, db) local(w, w2, A, nr, ni, dr, di) (
  w = f / hs_f;  w2 = w * w;  A = exp(db * 0.05756462732485115);
  nr = 1 - w2;  ni = w * A / hs_q;  dr = 1 - w2;  di = w / (A * hs_q);
  10 * log10((nr * nr + ni * ni) / max(dr * dr + di * di, 0.0000000001));
);

function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, tw, th, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_fit(x, y, 100, h, 0, PB_KEY, "PRESETS") ? open = 1;
  lk_fit(x + 102, y, 46, h, 0, PB_KEY, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_fit(x + 150, y, 46, h, 0, PB_KEY, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(PB_INK, 1);  pb_tri(x + 125, y + h * 0.5 - 0.5, 5, -1);  pb_tri(x + 173, y + h * 0.5 - 0.5, 5, 1);
  lx = x + 206;
  col(0x000000, 0.3);  gfx_rect(px(lx + 2), py(y + 5), ps(lw), ps(h - 6), 1);
  col(0x050505, 1);    gfx_rect(px(lx), py(y + 3), ps(lw), ps(h - 6), 1);
  gfx_gradrect(px(lx + 3), py(y + 6), ps(lw - 6), ps(h - 12), 0.17, 0.10, 0.02, 1, 0, 0, 0, 0, -0.06 / ps(h), -0.04 / ps(h), -0.01 / ps(h), 0);
  col(0xFFFFFF, 0.06); gfx_line(px(lx + 4), py(y + 7), px(lx + lw - 5), py(y + 7), 1);
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  gfx_setfont(8);  col(0xE8A33A, 1);  gfx_measurestr(#pb_nm, tw, th);
  gfx_x = px(lx + 10);  gfx_y = py(y + h * 0.5) - th * 0.5;  gfx_drawstr(#pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

PRESET_MENU = "Init|Vocal: Female|Vocal: Male|Vocal: Gentle|Vocal: Hard S|Vocal: Wide (whole)|Voice-over: Close Mic|Air: Tame the Top|Cymbals: Smooth|Guitar: Pick Click|Mix Bus: Harshness|Absolute: Classic|Vocal: Ess + Harsh|Vocal: Shouty Rock|Voice-over: Edgy Mic|Guitar: Fizz Tamer|Strings: Bow Bite|Mix Bus: Harsh Peaks";
PB_KEY = 0xA0AF84;  PB_INK = 0x0E3A40;

sc = min(gfx_w / 1000, gfx_h / 500);
ox = (gfx_w - 1000 * sc) * 0.5;
oy = (gfx_h - 500 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
whl = mouse_wheel;  mouse_wheel = 0;

function fit_font(idx, size) local(fs, w, h, target) (
  target = 5.28 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, "Trebuchet MS", fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);
sc != ff_sc ? (
  ff_sc = sc;
  fit_font(1, ps(28));
  fit_font(2, ps(16));
  fit_font(3, ps(14));
  fit_font(4, ps(18));
  fit_font(5, ps(13));
  fit_font(6, ps(16));
);
gfx_setfont(8, "Courier New", ps(17), 'b');

gr_m  = max(gr_d,  gr_m * 0.85);        gr_d = 0;
grh_m = max(grh_d, grh_m * 0.85);       grh_d = 0;
out_m = max(outpk_disp, out_m * 0.85);  outpk_disp = 0;

col(0x15616D, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
j = 0;
loop(12,
  col(j % 3 == 0 ? 0xFFFFFF : 0x0E4A53, 0.10);
  gy = py(1 + j * 4);  gfx_line(px(0), gy, px(1000), gy, 1);
  j += 1;
);
col(0x3F8590, 1);  gfx_rect(px(0), py(0), ps(1000), ps(1.5), 1);
col(0x426A5A, 1);  gfx_rect(px(0), py(46), ps(1000), ps(5), 1);
col(0x000000, 0.18); gfx_rect(px(0), py(494), ps(1000), ps(6), 1);
col(0x000000, 0.12); gfx_rect(px(995), py(0), ps(5), ps(494), 1);
rivet(12, 18);  rivet(988, 18);  rivet(12, 482);  rivet(988, 482);
gfx_setfont(1);  col(0xA0AF84, 1);  gfx_x = px(40);  gfx_y = py(9);   gfx_drawstr("CHERWELL");
gfx_setfont(4);  col(0xE4F0EF, 1);  gfx_x += ps(12);  gfx_y = py(16);  gfx_drawstr("DE-ESSER"); ver_tag_at("v3", 16, gfx_x + 0.45 * gfx_texth, gfx_y + 0.8 * gfx_texth, gfx_texth, -1);
gfx_setfont(4);  col(0xA0AF84, 1);  gfx_x = px(930); gfx_y = py(16);  gfx_drawstr("GFX");
by_keywh(ox / sc + 818, oy / sc + 9, 90, 28, 11, 12) ? gui_dirty = 1;

prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );
pb_k = preset_bar(306, 8, 30, 290, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > 18 ? 1 : pb_k; );

dx0 = 40;  dy0 = 76;  dw = 250;  dh = 300;
col(0x0F525C, 1);  gfx_rect(px(dx0 - 10), py(dy0 - 10), ps(dw + 20), ps(dh + 20), 1);
col(0x08363C, 1);  gfx_rect(px(dx0 - 10), py(dy0 - 10), ps(dw + 20), ps(2), 1);
                   gfx_rect(px(dx0 - 10), py(dy0 - 8),  ps(2), ps(dh + 18), 1);
col(0x4E959E, 1);  gfx_rect(px(dx0 - 8),  py(dy0 + dh + 8), ps(dw + 18), ps(2), 1);
                   gfx_rect(px(dx0 + dw + 8), py(dy0 - 8), ps(2), ps(dh + 16), 1);
col(0xA0AF84, 1);  gfx_rect(px(dx0 - 4), py(dy0 - 4), ps(dw + 8), ps(dh + 8), 1);
col(0x0B2F35, 1);  gfx_rect(px(dx0), py(dy0), ps(dw), ps(dh), 1);
z0 = dy0 + 40;  zs = 56 / 6;
col(0x1F4C52, 1);
gf = 1000;  loop(5, gx = px(dx0 + dw * log(gf / 500) / log(40));  gfx_line(gx, py(dy0), gx, py(dy0 + dh), 1);  gf = gf == 1000 ? 2000 : gf == 2000 ? 5000 : gf * 2; );
j = 1;  loop(4, gfx_line(px(dx0), py(z0 + j * 56), px(dx0 + dw), py(z0 + j * 56), 1);  j += 1; );
col(0x3E6E72, 1);  gfx_line(px(dx0), py(z0), px(dx0 + dw), py(z0), 1);
gfx_setfont(5);  col(0x8FB0A8, 1);
text_c(px(dx0 + dw * log(2) / log(40)), py(dy0 + dh - 12), "1k");
text_c(px(dx0 + dw * log(4) / log(40)), py(dy0 + dh - 12), "2k");
text_c(px(dx0 + dw * log(10) / log(40)), py(dy0 + dh - 12), "5k");
text_c(px(dx0 + dw * log(20) / log(40)), py(dy0 + dh - 12), "10k");
j = 1;  loop(4, sprintf(#sl, "-%d", j * 6);  gfx_x = px(dx0 + 6);  gfx_y = py(z0 + j * 56 - 16);  gfx_drawstr(#sl);  j += 1; );
nc = floor(ps(dw));  j = 0;
loop(nc,
  gf = 500 * 40 ^ (j / nc);
  gx = px(dx0) + j;
  ds_en ? (
    gm = ds_split ? cut_mag(gf, -ds_rng) : -ds_rng;
    col(C_ESS, 0.28);  gfx_line(gx, py(z0), gx, py(z0 - max(-26, gm) * zs), 1);
  );
  hs_en ? (
    gm = hcut_mag(gf, -hs_rng);
    col(C_HSH, 0.30);  gfx_line(gx, py(z0), gx, py(z0 - max(-26, gm) * zs), 1);
  );
  j += 1;
);
col(0xE4F0EF, 1);  j = 0;
loop(121,
  gf = 500 * 40 ^ (j / 120);
  gm = (ds_split ? cut_mag(gf, -gr_m) : -gr_m) + (grh_m > 0.01 ? hcut_mag(gf, -grh_m) : 0);
  gx = px(dx0 + dw * j / 120);  gy = py(z0 - max(-26, gm) * zs);
  j == 0 ? ( gfx_x = gx;  gfx_y = gy; ) : gfx_lineto(gx, gy, 1);
  j += 1;
);
gx = px(dx0 + dw * log(ds_f / 500) / log(40));
col(C_ESS, ds_en ? 0.8 : 0.3);  gfx_line(gx, py(dy0 + 4), gx, py(dy0 + dh - 26), 1);
gx = px(dx0 + dw * log(hs_f / 500) / log(40));
col(C_HSH, hs_en ? 0.8 : 0.3);  gfx_line(gx, py(dy0 + 4), gx, py(dy0 + dh - 26), 1);
gfx_setfont(5);  col(0xE4F0EF, 1);  text_c(px(dx0 + dw * 0.5), py(dy0 + dh + 24), ds_split ? "SPLIT  -  BAND CUT" : "WIDE  -  WHOLE SIGNAL");
ds_lsn || hs_lsn ? ( col(0xF2C230, 1);  gfx_x = px(dx0 + dw - 58);  gfx_y = py(dy0 + 8);  gfx_drawstr("LISTEN"); );

lk_fit(85, 422, 160, 48, ds_relm, LK_SKY, "RELATIVE") ? ( slider(8) = ds_relm ? 0 : 1;  param_touched(8); );

function plate(x, y, w, h) (
  col(0x0F525C, 1);  gfx_rect(px(x), py(y), ps(w), ps(h), 1);
  col(0x08363C, 1);  gfx_rect(px(x), py(y), ps(w), ps(2), 1);  gfx_rect(px(x), py(y), ps(2), ps(h), 1);
  col(0x4E959E, 1);  gfx_rect(px(x), py(y + h - 2), ps(w), ps(2), 1);  gfx_rect(px(x + w - 2), py(y), ps(2), ps(h), 1);
);
function sec_title(x, y, str, c) local(tw, th) (
  gfx_setfont(4);  col(0xE4F0EF, 1);  gfx_measurestr(str, tw, th);
  gfx_x = px(x);  gfx_y = py(y + 20) - th * 0.5;  gfx_drawstr(str);
  col(c, 1);  gfx_rect(px(x), py(y + 32), tw, ps(3), 1);
);
qx = 320;  qw = 510;

qy = 60;  qh = 210;
plate(qx, qy, qw, qh);
sec_title(qx + 46, qy + 4, "SIBILANCE", C_ESS);
lk_fit(qx + 238, qy + 6, 84, 44, ds_split, LK_SAGE, "SPLIT") ? ( slider(6) = ds_split ? 0 : 1;  param_touched(6); );
lk_fit(qx + 326, qy + 6, 84, 44, ds_shape, LK_SAGE, "HIGH") ? ( slider(7) = ds_shape ? 0 : 1;  param_touched(7); );
lk_fit(qx + 414, qy + 6, 84, 44, ds_lsn, LK_YEL, "LISTEN") ? ( slider(9) = ds_lsn ? 0 : 1;  param_touched(9); );
klog = 1;  kn(qx + 52, qy + 96, 24, 1, 2000, 16000, 6600, C_ESS, "FREQ", 3);
ds_shape < 0.5 ? (
  klog = 1;  kn(qx + 148, qy + 96, 18, 2, 0.3, 4, 1, C_ESS, "WIDTH", 4);
) : (
  gfx_setfont(5);  col(0xE4F0EF, 0.45);  text_c(px(qx + 148), py(qy + 96), "HIGH");
);
kn(qx + 255, qy + 96, 30, 3, -60, 0, -30, C_ESS, "THRESH", 2);
kn(qx + 362, qy + 96, 24, 4, 0, 24, 10, C_ESS, "RANGE", 2);
klog = 1;  kn(qx + 458, qy + 96, 18, 5, 20, 500, 80, C_ESS, "RELEASE", 5);
grrow(qx + 80, qy + 172, 390, gr_m, ds_rng);
!ds_en ? ( col(0x15616D, 0.5);  gfx_rect(px(qx), py(qy), ps(qw), ps(qh), 1); );
title_lamp(qx + 24, qy + 24, ds_en) ? ( slider(12) = ds_en ? 0 : 1;  param_touched(12); );

qy = 278;  qh = 210;
plate(qx, qy, qw, qh);
sec_title(qx + 46, qy + 4, "HARSHNESS", C_HSH);
lk_fit(qx + 414, qy + 6, 84, 44, hs_lsn, LK_YEL, "LISTEN") ? ( slider(19) = hs_lsn ? 0 : 1;  param_touched(19); );
klog = 1;  kn(qx + 52, qy + 96, 24, 14, 1100, 8800, 3300, C_HSH, "FREQ", 3);
klog = 1;  kn(qx + 148, qy + 96, 18, 15, 0.5, 4, 1.4, C_HSH, "WIDTH", 4);
kn(qx + 255, qy + 96, 30, 16, -60, 0, -18, C_HSH, "THRESH", 2);
kn(qx + 362, qy + 96, 24, 17, 0, 18, 6, C_HSH, "RANGE", 2);
klog = 1;  kn(qx + 458, qy + 96, 18, 18, 40, 800, 150, C_HSH, "RELEASE", 5);
grrow(qx + 80, qy + 172, 390, grh_m, hs_rng);
!hs_en ? ( col(0x15616D, 0.5);  gfx_rect(px(qx), py(qy), ps(qw), ps(qh), 1); );
title_lamp(qx + 24, qy + 24, hs_en) ? ( slider(13) = hs_en ? 0 : 1;  param_touched(13); );

vslider(886, 76, 300, 10, -12, 12, 0, "OUTPUT");
vmeter(934, 76, 300, gdb(out_m), "OUT");

!lmb ? drag_idx = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );
