desc:SEN20 [band-split gate] (GFX)
//tags: gate dynamics noise-gate drums sidechain multiband
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-thick, gfx-bands (.jsfx-inc) in the same folder.

import gfx-thick.jsfx-inc
import gfx-bands.jsfx-inc

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

slider1:g_in=1<0,1,1{Out,In}>-Gate in
slider2:thr=-20<-50,20,0.1>-Low threshold (dBu)
slider3:rng=-40<-70,0,0.1>-Low range (dB)
slider4:atk=0.1<0.01,10,0.01>-Low attack (ms)
slider5:hold=50<10,4000,1>-Low hold (ms)
slider6:rel=300<50,5000,1>-Low release (ms)
slider7:khp=20<20,8000,1>-Key HPF (Hz, 20 = off)
slider8:klp=20000<250,20000,1>-Key LPF (Hz, 20000 = off)
slider9:k_lsn=0<0,1,1{Off,On}>-Key listen
slider10:k_ext=0<0,1,1{Internal,External}>-Key source
slider11:look=0<0,1,1{Off,1 ms}>-Look-ahead
slider12:out_lvl=0<-12,12,0.1>-Level (dB)
slider13:thick=0<0,1,1{Off,On}>-Thick
slider14:bands=0<0,1,1{2 bands,3 bands}>-Bands
slider15:x1=150<40,1000,1>-Split low / mid (Hz)
slider16:x2=3000<800,12000,1>-Split mid / high (Hz)
slider17:kown=0<0,1,1{Shared,Own band}>-Band key
slider18:lnk=0<0,3,1{Off,Low opens Mid,Low opens Mid and High,Mid opens High}>-Link
slider19:m_thr=-20<-50,20,0.1>-Mid threshold (dBu)
slider20:m_rng=-40<-70,0,0.1>-Mid range (dB)
slider21:m_atk=0.1<0.01,10,0.01>-Mid attack (ms)
slider22:m_hold=50<10,4000,1>-Mid hold (ms)
slider23:m_rel=300<50,5000,1>-Mid release (ms)
slider24:h_thr=-20<-50,20,0.1>-High threshold (dBu)
slider25:h_rng=-40<-70,0,0.1>-High range (dB)
slider26:h_atk=0.1<0.01,10,0.01>-High attack (ms)
slider27:h_hold=50<10,4000,1>-High hold (ms)
slider28:h_rel=300<50,5000,1>-High release (ms)
slider29:b0_on=1<0,1,1{Off,On}>-Low band gate
slider30:b1_on=1<0,1,1{Off,On}>-Mid band gate
slider31:b2_on=1<0,1,1{Off,On}>-High band gate
slider32:solo=0<0,3,1{Off,Low,Mid,High}>-Solo
slider33:prs_sel=0<0,10,1{No preset,Init,Snare Tight Top,Kick Lows Breathe,Tom Ring Low,Guitar Chunk,Breath Remover,Parallel Gate,Slow Ambient,Hat Bleed Out,Drum Bus Bands}>-Preset

@init
#ui_man = "gfx-sen20";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
gfx_ext_retina = 1;
CR = 16;

LA_L = 0;  LA_R = 8192;  LSZ = 8192;
VUS = 20000;
la_pos = 0;

HYST = 3;
DET_FALL = 0.005;

function db2g(d) ( exp(d * 0.11512925464970228); );
function svf_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(fc, srate * 0.45) / srate);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf_hp(x) instance(g, k, a1, a2, a3, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;  x - k * v1 - v2;
);
function svf_lp(x) instance(g, k, a1, a2, a3, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;  v2;
);
function band_set(base) instance(thr_o, thr_c, hold_n, up, dn, flr, duck, adp) (
  flr = min(slider(base + 1), -0.01);
  up = -flr / max(1, slider(base + 2) * 0.001 * srate);
  dn = -flr / max(1, slider(base + 4) * 0.001 * srate);
  hold_n = floor(slider(base + 3) * 0.001 * srate);
  thr_o = slider(base) - 18;  thr_c = thr_o - HYST;
  duck = 0;  adp = 1;
);
function band_gain(gdb) instance(tk) local(g) (
  g = gdb <= -69.9 ? 0 : db2g(gdb);
  tk += (g - tk) * (g > tk ? 1 : tk_rs);
  g + (tk - g) * thk_m;
);

function update_params() (
  t_in = g_in >= 0.5;  t_lsn = k_lsn >= 0.5;  ext_on = k_ext >= 0.5;
  t_hpf = log(max(khp, 20));  t_lpf = log(min(klp, 20000));
  bl.band_set(2);  bm.band_set(19);  bh.band_set(24);
  three = bands >= 0.5;
  t_x1 = log(max(x1, 40));  t_x2 = log(max(x2, x1 * 2));
  t_on0 = b0_on >= 0.5;  t_on1 = b1_on >= 0.5;  t_on2 = b2_on >= 0.5;
  t_w0 = solo < 0.5 || solo == 1;
  t_w2 = solo < 0.5 || solo == 3 || (solo == 2 && !three);
  t_w1 = solo < 0.5 || solo == 2 || (solo == 3 && !three);
  t_f1 = three && (lnk == 1 || lnk == 2);
  t_f2 = three ? (lnk == 2 ? 1 : lnk == 3 ? 2 : 0) : (lnk == 1 || lnk == 2 ? 1 : 0);
  t_out = out_lvl;
  la_want = look >= 0.5;
);

sm_c = 1 - exp(-CR / (0.03 * srate));
sw_c = 1 - exp(-1 / (0.012 * srate));
det_r = exp(-1 / (DET_FALL * srate));
det_r2 = exp(-1 / (0.014 * srate));
tk_rs = 1 - exp(-1 / (0.025 * srate));
thk_init();  thk_lift = 4;  thk_drv = 1.7;  thk_asym = 0.16;  thk_tr = 1.5;  thk_trim = 0;
dkr = 1 / (0.005 * srate);
la_n = floor(0.001 * srate + 0.5);
update_params();
s_hpf = t_hpf;  s_lpf = t_lpf;  out_s = db2g(t_out);
m_in = t_in;  m_lsn = t_lsn;  b3_s = three;
on0_s = t_on0;  on1_s = t_on1;  on2_s = t_on2;  w0_s = t_w0;  w1_s = t_w1;  w2_s = t_w2;
s_x1 = t_x1;  s_x2 = t_x2;  bs_coef(exp(s_x1), exp(s_x2));
la_cur = la_want;  la_st = 0;  dk = 1;
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = la_cur ? la_n : 0;
HPL.svf_set(exp(s_hpf), 0.7071);  HPR.svf_set(exp(s_hpf), 0.7071);
LPL.svf_set(exp(s_lpf), 0.7071);  LPR.svf_set(exp(s_lpf), 0.7071);
bl.gdb = bl.flr;  bm.gdb = bm.flr;  bh.gdb = bh.flr;
kenv = 0;  e0 = 0;  e1 = 0;  e2 = 0;
cr_n = 0;
rs_f = 1;

function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function param_touched_au(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function pband(base, th, rg, at, ho, re) ( pv(base, th);  pv(base + 1, rg);  pv(base + 2, at);  pv(base + 3, ho);  pv(base + 4, re); );
function p_init() (
  pv(1, 1);  pband(2, -20, -40, 0.1, 50, 300);  pband(19, -20, -40, 0.1, 50, 300);  pband(24, -20, -40, 0.1, 50, 300);
  pv(7, 20);  pv(8, 20000);  pv(9, 0);  pv(10, 0);  pv(11, 0);  pv(12, 0);  pv(13, 0);
  pv(14, 0);  pv(15, 150);  pv(16, 3000);  pv(17, 0);  pv(18, 0);  pv(29, 1);  pv(30, 1);  pv(31, 1);  pv(32, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? ( pv(15, 350);  pv(7, 180);  pv(8, 8000);  pv(11, 1);
             pband(2, -8, -20, 0.1, 80, 400);  pband(24, -6, -50, 0.05, 25, 90); );
  p == 3 ? ( pv(15, 120);  pv(8, 150);  pv(11, 1);
             pband(2, -10, -40, 0.5, 80, 400);  pband(24, -8, -60, 0.05, 20, 60); );
  p == 4 ? ( pv(14, 1);  pv(15, 150);  pv(16, 3000);  pv(17, 1);  pv(18, 2);  pv(7, 60);  pv(11, 1);  pv(13, 1);
             pband(2, -14, -30, 0.2, 150, 800);  pband(19, -14, -36, 0.2, 90, 400);  pband(24, -14, -50, 0.1, 40, 150); );
  p == 5 ? ( pv(15, 250);  pv(7, 100);  pv(8, 6000);
             pband(2, -26, -60, 0.5, 20, 80);  pband(24, -26, -60, 0.5, 30, 120); );
  p == 6 ? ( pv(15, 1500);  pv(7, 150);  pv(8, 5000);
             pband(2, -34, -6, 2, 80, 250);  pband(24, -34, -15, 2, 80, 250); );
  p == 7 ? ( pv(15, 200);  pv(7, 120);  pv(8, 12000);  pv(13, 1);
             pband(2, -12, -6, 0.01, 25, 120);  pband(24, -12, -14, 0.01, 15, 50); );
  p == 8 ? ( pv(15, 400);  pv(13, 1);
             pband(2, -30, -24, 10, 500, 2500);  pband(24, -30, -30, 10, 500, 2500); );
  p == 9 ? ( pv(15, 3000);  pv(7, 150);  pv(11, 1);
             pband(2, -24, -12, 0.1, 60, 300);  pband(24, -8, -60, 0.05, 20, 60); );
  p == 10 ? ( pv(14, 1);  pv(15, 150);  pv(16, 4000);  pv(17, 1);
              pband(2, -30, -9, 0.5, 60, 250);  pband(19, -32, -6, 0.3, 50, 200);  pband(24, -34, -9, 0.1, 30, 120); );
  i = 1;  loop(32, param_touched_au(i);  i += 1; );
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(33, i != 33 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? (
  spL.bs_clear();  spR.bs_clear();  skL.bs_clear();  skR.bs_clear();
  memset(LA_L, 0, LSZ);  memset(LA_R, 0, LSZ);
  rs_f = 0;  rs_c = 1 / (0.015 * srate);
);
rs_last = rs_now;
gui_dirty ? ( gui_dirty = 0;  update_params(); );
gr0_d = min(gr0_d, g0min);  g0min = 0;
gr1_d = min(gr1_d, g1min);  g1min = 0;
gr2_d = min(gr2_d, g2min);  g2min = 0;
inpk_disp = max(inpk_disp, inpk);  inpk = 0;
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
gn0_disp = bl.gdb;  gn1_disp = bm.gdb;  gn2_disp = bh.gdb;
x2_disp = exp(t_x2);

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
rw_l = spl0;  rw_r = spl1;
cr_n <= 0 ? (
  cr_n = CR;
  abs(t_hpf - s_hpf) > 0.0001 ? ( s_hpf += (t_hpf - s_hpf) * sm_c;  HPL.svf_set(exp(s_hpf), 0.7071);  HPR.svf_set(exp(s_hpf), 0.7071); );
  abs(t_lpf - s_lpf) > 0.0001 ? ( s_lpf += (t_lpf - s_lpf) * sm_c;  LPL.svf_set(exp(s_lpf), 0.7071);  LPR.svf_set(exp(s_lpf), 0.7071); );
  abs(t_x1 - s_x1) > 0.0001 || abs(t_x2 - s_x2) > 0.0001 ? (
    s_x1 += (t_x1 - s_x1) * sm_c;  s_x2 += (t_x2 - s_x2) * sm_c;  bs_coef(exp(s_x1), exp(s_x2));
  );
  oi = (db2g(t_out) - out_s) * sm_c / CR;
);
cr_n -= 1;
out_s += oi;
m_in += (t_in - m_in) * sw_c;  m_lsn += (t_lsn - m_lsn) * sw_c;
b3_s += (three - b3_s) * sw_c;
on0_s += (t_on0 - on0_s) * sw_c;  on1_s += (t_on1 - on1_s) * sw_c;  on2_s += (t_on2 - on2_s) * sw_c;
w0_s += (t_w0 - w0_s) * sw_c;  w1_s += (t_w1 - w1_s) * sw_c;  w2_s += (t_w2 - w2_s) * sw_c;

xl = spl0;  xr = spl1;
inpk = max(inpk, max(abs(xl), abs(xr)));

kl = ext_on ? spl2 : xl;  kr = ext_on ? spl3 : xr;
kl = LPL.svf_lp(HPL.svf_hp(kl));  kr = LPR.svf_lp(HPR.svf_hp(kr));
dfall = det_r + (det_r2 - det_r) * thk_m;
kown >= 0.5 ? (
  skL.bs_split(kl);  skR.bs_split(kr);
  v0 = max(abs(skL.lo), abs(skR.lo));
  three ? ( v1 = max(abs(skL.mi), abs(skR.mi));  v2 = max(abs(skL.hi), abs(skR.hi)); )
        : ( v2 = max(abs(skL.mi + skL.hi), abs(skR.mi + skR.hi));  v1 = v2; );
  e0 = v0 > e0 ? v0 : e0 * dfall;  e1 = v1 > e1 ? v1 : e1 * dfall;  e2 = v2 > e2 ? v2 : e2 * dfall;
  k0 = e0 > 0.0000001 ? 8.685889638065035 * log(e0) : -140;
  k1 = e1 > 0.0000001 ? 8.685889638065035 * log(e1) : -140;
  k2 = e2 > 0.0000001 ? 8.685889638065035 * log(e2) : -140;
) : (
  kv = max(abs(kl), abs(kr));
  kenv = kv > kenv ? kv : kenv * dfall;
  k0 = kenv > 0.0000001 ? 8.685889638065035 * log(kenv) : -140;  k1 = k0;  k2 = k0;
);

bl.bg_gate(k0);
t_f1 ? bm.bg_follow(bl.opn) : bm.bg_gate(k1);
t_f2 == 1 ? bh.bg_follow(bl.opn) : t_f2 == 2 ? bh.bg_follow(bm.opn) : bh.bg_gate(k2);
g0 = cl.band_gain(bl.gdb);  g1 = cm.band_gain(bm.gdb);  g2 = ch.band_gain(bh.gdb);
g0 = 1 + (g0 - 1) * on0_s;  g1 = 1 + (g1 - 1) * on1_s;  g2 = 1 + (g2 - 1) * on2_s;
g1 = g2 + (g1 - g2) * b3_s;
g0min = min(g0min, bl.gdb * t_on0);  g1min = min(g1min, bm.gdb * t_on1);  g2min = min(g2min, bh.gdb * t_on2);

LA_L[la_pos] = xl;  LA_R[la_pos] = xr;
la_cur ? (
  rp = la_pos - la_n;  rp < 0 ? rp += LSZ;
  dl = LA_L[rp];  dr = LA_R[rp];
) : ( dl = xl;  dr = xr; );
la_pos += 1;  la_pos >= LSZ ? la_pos = 0;
la_st == 0 && la_want != la_cur ? la_st = 1;
la_st == 1 ? ( dk -= dkr;  dk <= 0 ? ( dk = 0;  la_cur = la_want;  pdc_delay = la_cur ? la_n : 0;  la_st = 2; ); ) :
la_st == 2 ? ( dk += dkr;  dk >= 1 ? ( dk = 1;  la_st = 0; ); );

spL.bs_split(dl);  spR.bs_split(dr);
yl = spL.lo * g0 * w0_s + spL.mi * g1 * w1_s + spL.hi * g2 * w2_s;
yr = spR.lo * g0 * w0_s + spR.mi * g1 * w1_s + spR.hi * g2 * w2_s;
thk_proc(yl, yr, thick >= 0.5);  yl = thk_l;  yr = thk_r;
m_lsn > 0.00001 ? ( yl += (kl - yl) * m_lsn;  yr += (kr - yr) * m_lsn; );
yl = dl + (yl - dl) * m_in;  yr = dr + (yr - dr) * m_in;
la_st ? ( g_ = dk * dk * (3 - 2 * dk);  yl *= g_;  yr *= g_; );
yl *= out_s;  yr *= out_s;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1);  rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  spl0 = rw_l + (spl0 - rw_l) * rs_s;  spl1 = rw_r + (spl1 - rw_r) * rs_s;
);

@gfx 1080 640
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
C_FACE = 0x2B2D2F;  C_HEAD = 0x1D1E20;  C_INK = 0xF1F0EB;  C_INK2 = 0xB9B8B2;  C_LINE = 0xC7BEB3;
C_CYN = 0x1E8C9C;  C_CYNL = 0x7FD3DE;
C_YEL = 0xF2C230;  C_LCDBG = 0x0B0D0E;  C_LCDTX = 0xF2C26A;
LK_AMB = 0xF2A41E;  lk_well = 0x050505;
VUS = 20000;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rivet(x, y) (
  col(0x55585C, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.35);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
  col(0x000000, 0.6);  gfx_line(px(x) - ps(2), py(y), px(x) + ps(2), py(y), 1);
);
function ocorner(cx, cy, ra, th, sx, sy) local(i, j, d, c) (
  j = 0;
  loop(ra,
    i = 0;
    loop(ra,
      d = sqrt(sqr(i + 0.5) + sqr(j + 0.5));
      c = max(0, min(1, min(ra - d + 0.5, d - (ra - th) + 0.5)));
      c > 0 ? ( gfx_a = 0.85 * c;  gfx_rect(sx < 0 ? cx - i - 1 : cx + i, sy < 0 ? cy - j - 1 : cy + j, 1, 1, 1); );
      i += 1;
    );
    j += 1;
  );
);
function box(x, y, w, h, title, gx0, gx1) local(tw, th, bxl, bxr, bxt, bxb, ra, lw, g0, g1) (
  gfx_setfont(4);  gfx_measurestr(title, tw, th);
  bxl = floor(px(x) + 0.5);  bxr = floor(px(x + w) + 0.5);  bxt = floor(py(y) + 0.5);  bxb = floor(py(y + h) + 0.5);
  ra = floor(ps(7) + 0.5);  lw = max(1, floor(ps(1.5) + 0.5));
  g0 = floor(px(x + w * 0.5) - tw * 0.5 - ps(8) + 0.5);  g1 = floor(px(x + w * 0.5) + tw * 0.5 + ps(8) + 0.5);
  col(C_LINE, 0.85);
  gfx_rect(bxl + ra, bxt, g0 - (bxl + ra), lw, 1);
  gx0 > 0 ? ( gfx_rect(g1, bxt, floor(px(gx0) + 0.5) - g1, lw, 1);  gfx_rect(floor(px(gx1) + 0.5), bxt, bxr - ra - floor(px(gx1) + 0.5), lw, 1); )
          : gfx_rect(g1, bxt, bxr - ra - g1, lw, 1);
  gfx_rect(bxl + ra, bxb - lw, bxr - bxl - 2 * ra, lw, 1);
  gfx_rect(bxl, bxt + ra, lw, bxb - bxt - 2 * ra, 1);  gfx_rect(bxr - lw, bxt + ra, lw, bxb - bxt - 2 * ra, 1);
  ocorner(bxl + ra, bxt + ra, ra, lw, -1, -1);  ocorner(bxr - ra, bxt + ra, ra, lw, 1, -1);
  ocorner(bxl + ra, bxb - ra, ra, lw, -1, 1);   ocorner(bxr - ra, bxb - ra, ra, lw, 1, 1);
  col(C_INK, 1);  text_c(px(x + w * 0.5), bxt + lw * 0.5, title);
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%+.1f dBu", v) :
  fmt == 2 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 3 ? sprintf(#kv, v < 1 ? "%.2f ms" : "%.1f ms", v) :
  fmt == 4 ? ( v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 5 ? ( v <= 20.5 ? strcpy(#kv, "OFF") : v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
  fmt == 6 ? ( v >= 19999.5 ? strcpy(#kv, "OFF") : v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.1f kHz", v / 1000); ) :
  fmt == 7 ? sprintf(#kv, "%d %%", v) :
             sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(0x000000, 0.92);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
function quad(ax, ay, bx, by, hw) local(dx, dy, l) (
  l = sqrt(sqr(bx - ax) + sqr(by - ay));  dx = -(by - ay) / l * hw;  dy = (bx - ax) / l * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
);
function smark(cx, cy, r, t, str) local(a, sa, ca) (
  a = -0.75 * $pi + t * 1.5 * $pi;  sa = sin(a);  ca = cos(a);
  col(C_INK, 0.9);  gfx_circle(px(cx + sa * (r + 6)), py(cy - ca * (r + 6)), max(ps(1.3), 1), 1, 1);
  strlen(str) ? ( gfx_setfont(5);  col(C_INK, 1);  text_c(px(cx + sa * (r + 17)), py(cy - ca * (r + 16)), str); );
);
function lt(v, vmin, vmax) ( log(v / vmin) / log(vmax / vmin); );
function kn(cx, cy, r, idx, vmin, vmax, def, lbl, fmt) local(x, y, rr, v, t, hov, now, a, j, lg, b)
(
  lg = klog;  klog = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? lt(v, vmin, vmax) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
    v = lg ? vmin * (vmax / vmin) ^ t : vmin + t * (vmax - vmin);
    v = v >= 100 ? floor(v + 0.5) : floor(v * 100 + 0.5) / 100;
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 220)));
    v = lg ? vmin * (vmax / vmin) ^ t : vmin + t * (vmax - vmin);
    v = v >= 100 ? floor(v + 0.5) : lg ? floor(v * 100 + 0.5) / 100 : floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? lt(v, vmin, vmax) : (v - vmin) / (vmax - vmin);
  a = -0.75 * $pi + t * 1.5 * $pi;
  col(0x000000, 0.5);  gfx_circle(x + ps(1.5), y + ps(2.5), rr, 1, 1);
  col(0x0A0A0A, 1);  gfx_circle(x, y, rr, 1, 1);
  col(0x2A2A2A, 1);  j = 0;
  loop(36, b = j / 36 * 2 * $pi;  gfx_line(x + sin(b) * rr * 0.84, y - cos(b) * rr * 0.84, x + sin(b) * (rr - 1), y - cos(b) * (rr - 1), 1);  j += 1; );
  col(0x1D1D1E, 1);  gfx_circle(x, y, rr * 0.78, 1, 1);
  col(0xFFFFFF, 0.10);  gfx_arc(x, y, rr * 0.72, -1.6, -0.3, 1);
  col(0x3A3A3C, 1);  gfx_circle(x, y, rr, 0, 1);
  col(C_YEL, 1);  gfx_circle(x + sin(a) * rr * 0.48, y - cos(a) * rr * 0.48, rr * 0.15, 1, 1);
  gfx_setfont(6);  col(kcol ? kcol : C_INK, 1);  kcol = 0;
  text_c(x, py(klab_y), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(18), fmtv(v, fmt));
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(lk_fnt ? lk_fnt : 2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function wk_key(x, y, w, h, on, str) local(hov, hit, b, dn) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  b = 1.6;  dn = on ? 0 : 1.6;
  col(0x000000, 0.5);  u_rect(x + 1, y + 2, w, h);
  col(0x050505, 1);  u_rect(x, y, w, h);
  col(on ? 0xEDEAE0 : 0xBDBAB0, 1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn);
  on ? ( col(0xFFFFFF, 0.6);  u_rect(x + b, y + b, w - 2 * b, 1);  col(0x000000, 0.15);  u_rect(x + b, y + h - b - 2, w - 2 * b, 2); )
     : ( col(0x000000, 0.3);  u_rect(x + b, y + b + dn, w - 2 * b, 1.5); );
  hov ? ( col(0xFFFFFF, 0.1);  u_rect(x + b, y + b + dn, w - 2 * b, h - 2 * b - dn); );
  on ? ( col(0xFFB030, 0.35);  gfx_circle(px(x + 10), py(y + h * 0.5 + dn * 0.5), ps(5), 1, 1); );
  col(on ? 0xFFB030 : 0x6B5A3C, 1);  gfx_circle(px(x + 10), py(y + h * 0.5 + dn * 0.5), ps(2.8), 1, 1);
  gfx_setfont(2);  col(on ? 0x22201C : 0x4E4A44, 1);
  ui_keytext(px(x + w * 0.5 + 6), py(y + h * 0.5 + dn * 0.5), str);
  hit;
);
function sq_key(x, y, on, lbl) local(hov, hit, s, b, dn) (
  s = 22;  b = 2;  dn = on ? 1.5 : 0;
  hov = mouse_x >= px(x) && mouse_x < px(x + s) && mouse_y >= py(y) && mouse_y < py(y + s);
  hit = click && hov && !drag_idx;
  col(0x000000, 0.5);  u_rect(x + 1, y + 2, s, s);
  col(0x050505, 1);  u_rect(x, y, s, s);
  col(on ? 0x8A8C90 : 0x9C9EA2, 1);  u_rect(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( col(0xFFFFFF, 0.28);  u_rect(x + b, y + b, s - 2 * b, 1);
          col(0x000000, 0.28);  u_rect(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( col(0x000000, 0.35);  u_rect(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( col(0xFFFFFF, 0.08);  u_rect(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  col(0x000000, 1);  gfx_circle(px(x + s + 12), py(y + s * 0.5), ps(5.2), 1, 1);
  col(on ? 0xFF2A1A : 0x4A1410, 1);  gfx_circle(px(x + s + 12), py(y + s * 0.5), ps(3.8), 1, 1);
  on ? ( col(0xFF3A2A, 0.3);  gfx_circle(px(x + s + 12), py(y + s * 0.5), ps(8), 1, 1);
         col(0xFFFFFF, 0.55);  gfx_circle(px(x + s + 11), py(y + s * 0.5 - 1), ps(1.2), 1, 1); );
  gfx_setfont(7);  col(C_INK, 1);  text_c(px(x + (s + 17) * 0.5), py(y + s + 12), lbl);
  hit;
);
function lamp(x, y, c, on) (
  col(0x000000, 1);  gfx_circle(px(x), py(y), ps(6), 1, 1);
  col(on ? c : shade(c, 0.28), 1);  gfx_circle(px(x), py(y), ps(4.6), 1, 1);
  on ? ( col(c, 0.28);  gfx_circle(px(x), py(y), ps(9), 1, 1);  col(0xFFFFFF, 0.55);  gfx_circle(px(x - 1.5), py(y - 1.5), ps(1.4), 1, 1); );
);
function led(x, y, w, h, c, on) (
  col(0x000000, 1);  u_rect(x - 1, y - 1, w + 2, h + 2);
  col(on ? c : shade(c, 0.22), 1);  u_rect(x, y, w, h);
  on ? ( col(0xFFFFFF, 0.3);  u_rect(x + 1, y + 1, w - 2, 1); );
);
function ladder(x, y, v, slot) local(j, d, c, pk) (
  now_t = time_precise();
  v > VUS[slot] ? ( VUS[slot] = v;  VUS[slot + 1] = now_t; ) :
    now_t - VUS[slot + 1] > 1.2 ? VUS[slot] = max(v, VUS[slot] - 0.6);
  pk = VUS[slot];
  j = 0;
  loop(16,
    d = -42 + j * 3;  c = d >= 0 ? 0xFF3A2A : d >= -6 ? 0xFFC81E : 0x3CE05A;
    led(x + j * 11, y, 8, 12, c, v >= d || (pk >= d && pk < d + 3));
    j += 1;
  );
);

PRESET_MENU = "Init|Snare Tight Top|Kick Lows Breathe|Tom Ring Low|Guitar Chunk|Breath Remover|Parallel Gate|Slow Ambient|Hat Bleed Out|Drum Bus Bands";
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function lcd(x, y, w, h, str) local(tw, th, gy) (
  col(0x2A2B2D, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x000000, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  gfx_setfont(8);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xD8DCD2, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xD8DCD2, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xD8DCD2, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1A1A, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

C_LOW = 0xB8814E;  C_MID = 0x78B86A;  C_HIGH = 0xE0664C;
function readout(cx, y, w, str) (
  col(0x000000, 1);  u_rect(cx - w * 0.5 - 1.5, y - 1.5, w + 3, 23);
  col(C_LINE, 1);  u_rect(cx - w * 0.5, y, w, 20);
  col(0x000000, 0.2);  u_rect(cx - w * 0.5, y, w, 1.5);  u_rect(cx - w * 0.5, y + 1.5, 1.5, 18.5);
  gfx_setfont(5);  col(0x1D1E20, 1);  text_c(px(cx), py(y + 10.5), str);
);
function hz_str(f) ( f < 1000 ? sprintf(#hz, "%d Hz", f) : sprintf(#hz, "%.1f kHz", f / 1000);  #hz; );
function gr_ladder(x, y, gr, lit) local(j, d) (
  gfx_setfont(5);  col(C_INK, 1);  text_l(px(x - 28), py(y + 6), "GR");
  j = 0;
  loop(21,
    d = j < 6 ? (j + 1) * 1 + (j > 3 ? j - 3 : 0) : j < 14 ? 10 + (j - 6) * 2.5 : 30 + (j - 14) * (40 / 6);
    led(x + j * 17.4, y, 13, 12, j < 7 ? 0x3CE05A : j < 14 ? 0xFFC81E : 0xFF3A2A, lit && -gr >= d - 0.01);
    gfx_setfont(7);  col(C_INK2, 1);
    j == 0 ? text_c(px(x + 6.5), py(y + 26), "1");
    j == 6 ? text_c(px(x + 6.5 + 6 * 17.4), py(y + 26), "10");
    j == 10 ? text_c(px(x + 6.5 + 10 * 17.4), py(y + 26), "20");
    j == 14 ? text_c(px(x + 6.5 + 14 * 17.4), py(y + 26), "30");
    j == 17 ? text_c(px(x + 6.5 + 17 * 17.4), py(y + 26), "50");
    j == 20 ? text_c(px(x + 6.5 + 20 * 17.4), py(y + 26), "70");
    j += 1;
  );
);

g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1080 * g_ret), gfx_h / (640 * g_ret))), 0.5);
ox = (gfx_w - 1080 * sc) * 0.5;
oy = (gfx_h - 640 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
kcol = 0;  klog = 0;
!pk_ok ? ( VUS[0] = -100;  VUS[2] = -100;  pk_ok = 1; );

gfx_setfont(1, "Trebuchet MS", ps(30), 'b');
gfx_setfont(10, "Trebuchet MS", ps(13), 'b');
gfx_setfont(2, "Trebuchet MS", ps(14), 'b');
gfx_setfont(3, "Trebuchet MS", ps(14), 'b');
gfx_setfont(4, "Trebuchet MS", ps(16.5), 'b');
gfx_setfont(5, "Trebuchet MS", ps(12.5), 'b');
gfx_setfont(6, "Trebuchet MS", ps(15), 'b');
gfx_setfont(7, "Trebuchet MS", ps(12), 'b');
gfx_setfont(8, "Courier New", ps(19.7), 'b');
gfx_setfont(11, "Trebuchet MS", ps(19), 'b');
g_three = bands >= 0.5;

col(0x080808, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(C_FACE, 1);  u_rect(0, 0, 1080, 640);
!grain_ok ? (
  g_j = 0;  loop(1400, VUS[100 + g_j * 3] = rand(1080);  VUS[101 + g_j * 3] = 58 + rand(582);  VUS[102 + g_j * 3] = rand(1) < 0.5;  g_j += 1; );
  grain_ok = 1;
);
g_j = 0;
loop(1400,
  col(VUS[102 + g_j * 3] ? 0xFFFFFF : 0x000000, VUS[102 + g_j * 3] ? 0.035 : 0.25);
