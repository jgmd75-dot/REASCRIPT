desc:KBH77 [channel strip] (GFX)
//tags: channel strip broadcast compressor expander gate limiter presence eq filter
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel and gfx-dyn (.jsfx-inc) in the same folder.
//
// KBH77: a 1970s / early-80s Danish broadcast module frame, the slim 40 mm cassettes side by side: an 18 dB/oct
// filter cassette, a presence-equaliser cassette, a compressor / expander with hold and gate, and a safety limiter
// with a full-wave logarithmic clipping circuit. Dynamics, linked stereo by default, no latency.
//
// LOOK / MODE (the VFD / MATRIX keys in the header; the house KRT81 panel style)
//   VFD    - the later transformerless cassettes ("direct output"): clean.
//   MATRIX - the earlier transformer-coupled cassettes: a little iron on the low end (mostly 3rd harmonic, some 2nd,
//            level-dependent, nothing audible below about -24 dBFS of bass). Switching glides the iron in / out (20 ms).
//
// SIGNAL FLOW (per channel)
//   input -> FILTER (HPF / LPF) -> PRESENCE EQ and DYNAMICS in the ORDER chosen (EQ > DYN or DYN > EQ)
//   -> MATRIX iron -> OUTPUT LEVEL -> LIMITER (linked) -> BYPASS crossfade. Latency 0 samples.
// Levels: 0 dBu = -18 dBFS.
//
// FILTER (18 dB/oct, 3rd-order Butterworth: one first-order section + one Q 1 state-variable section)
//   HPF: OFF, 40, 60, 80, 113, 160, 226, 320, 452, 640 Hz.   LPF: 1, 1.4, 2, 2.8, 4, 5.6, 8, 11.2, 16 kHz, OFF.
//   Steps glide (50 ms, in log frequency); OFF glides the corner out of the band, then the section is switched out.
// PRESENCE EQ
//   LF: +/-12 dB in 3 dB steps, low shelf round 60 Hz.  HF: +/-12 dB in 3 dB steps, high shelf round 10 kHz.
//   PRESENCE: +/-10 dB in 2 dB steps, a broad bell (Q 0.7) at 0.7, 1, 1.4, 2.8, 4 or 5.6 kHz.
//   All gains glide (30 ms). At 0 dB each band is flat.
// DYNAMICS (one log-domain detector; the gain law is the cassette's "constant output at reference level")
//   COMP: below the knee the signal gets the full GAIN (0 .. +20 dB); from there up to REF it is compressed at RATIO,
//         so the output at REF is always REF whatever GAIN and RATIO are; above REF it keeps compressing at RATIO.
//         GAIN 0 = a plain compressor with its threshold at REF. Soft knees (4 dB). Ratios 1.3, 1.5, 2, 3, 5, 10, 20:1.
//   EXP:  below REF the signal is expanded at 1:1.25 .. 1:1.9 (the same RATIO knob), down to GAIN (= max ATT, 0 .. 20
//         dB); above REF it passes at unity.
//   REF: -8 .. +15 dBu. ATTACK (per 20 dB): 0.1, 0.3, 1, 3, 10, 30, 100 ms.
//   RECOVERY (per 20 dB, a straight line in dB, as the original's curves): AUTO, 0.1, 0.3, 1, 3, 6 s, after a 20 ms
//         recovery delay (no ripple on low notes). AUTO: the dual time constant, 200 ms upon 15 s, with a 50 ms
//         delay: a short peak recovers in 200 ms; the longer the loud passage, the more of the slow 15 s part.
//   HOLD (-10 .. -50 dB, OFF fully clockwise): when the programme drops further than this below the level the
//         detector is holding (a pause), recovery stops, so GAIN does not pump the noise floor up in the gaps.
//   IN: the dynamics section in / out (20 ms glide).
// GATE (on the dynamics input): threshold 0 .. -50 dBu (OFF fully anticlockwise), 1:2 below it, down to ATTEN (0 .. 20
//   dB); opens in about 1 ms, closes at SLOW 500 / MED 100 / FAST 20 ms per 20 dB.
// LIMITER (linked, after OUTPUT LEVEL): steady-state threshold 0 .. +15 dBu, attack 1.5 ms (90 %), dual recovery 200 ms
//   upon 15 s; peaks shorter than 1.5 ms go to the full-wave logarithmic clipping circuit (anti-aliased), clean up to
//   about +1 dB over the threshold and never more than +3 dB over it. PRE-EMPH: the detector sees a 50 us
//   pre-emphasised signal (broadcast). IN: in / out (20 ms crossfade).
// LINK: one detector on the louder channel for the dynamics and gate (the limiter is always linked).
// DRIFT (0 - 100 %, 50 % = standard): the limiter's heated oven. Each instance starts cold and warms over about 45 s of
//   running audio: while cold the log converters read high (REF about 1.5 dB lower, the limiter about 1 dB lower, a
//   little L / R mismatch) and recovery is sluggish (up to 20 % slower); warm, the thermostat cycles the oven every
//   20 - 40 s (+/-0.15 dB) with a slow wander (+/-0.2 dB) on each side. The OVEN lamp blinks while it warms, then
//   shows the heater. 0 % = steady and exact (the lamp still warms; the sound does not move).
//   (The warm-up counts processed audio from the moment the instance loads: render after the lamp settles, or set
//   DRIFT 0 %, for a render whose first bars match the rest.)
// METER: the 16-step gain meter (+8 .. -20 dB, L / R): gain up from 0 in amber, reduction down from 0.
// GUI: drag a knob (shift = fine, double-click = default, wheel); click a key; click the LCD for the preset list.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc

slider1:0<0,9,1{OFF,40 Hz,60 Hz,80 Hz,113 Hz,160 Hz,226 Hz,320 Hz,452 Hz,640 Hz}>-HPF
slider2:9<0,9,1{1 kHz,1.4 kHz,2 kHz,2.8 kHz,4 kHz,5.6 kHz,8 kHz,11.2 kHz,16 kHz,OFF}>-LPF
slider3:0<-12,12,3>-LF (dB)
slider4:0<-10,10,2>-Presence (dB)
slider5:3<0,5,1{0.7 kHz,1 kHz,1.4 kHz,2.8 kHz,4 kHz,5.6 kHz}>-Presence freq
slider6:0<-12,12,3>-HF (dB)
slider7:0<0,1,1{Comp,Exp}>-Comp / Exp
slider8:6<-8,15,0.1>-Ref level (dBu)
slider9:0<0,20,0.1>-Gain / Att (dB)
slider10:2<0,6,1{1.3,1.5,2,3,5,10,20}>-Ratio
slider11:3<0,6,1{0.1 ms,0.3 ms,1 ms,3 ms,10 ms,30 ms,100 ms}>-Attack
slider12:0<0,5,1{Auto,0.1 s,0.3 s,1 s,3 s,6 s}>-Recovery
slider13:60<10,60,0.1>-Hold level (dB, 55+ = off)
slider14:-55<-55,0,0.1>-Gate level (dBu, below -50.5 = off)
slider15:12<0,20,0.1>-Gate atten (dB)
slider16:1<0,2,1{Slow,Med,Fast}>-Gate time
slider17:0<0,1,1{Out,In}>-Limiter
slider18:10<0,15,0.1>-Limiter level (dBu)
slider19:0<0,1,1{Off,On}>-Pre-emphasis
slider20:0<-12,12,0.1>-Output level (dB)
slider21:50<0,100,1>-Drift (%)
slider22:1<0,1,1{Off,On}>-Link
slider23:0<0,1,1{EQ first,DYN first}>-Order
slider24:0<0,1,1{Off,On}>-Bypass
slider25:2<1,2,1{VFD,Matrix}>-Look
slider26:0<0,1,1{Out,In}>-Dynamics
slider27:prs_sel=0<0,13,1{No preset,Init,Vocal Ride,Broadcast Voice,Dialogue Clean,Drum Bus,Bass Even,Acoustic Guitar,Mix Bus Glue,Upward Lift,Radio Limiter,Expander Clean-up,Noisy Track Gate,Tape Transfer}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
gdc_r = 1 - 2 * $pi / srate;                            // input DC blocker, 1 Hz (first order)
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
#ui_man = "gfx-kbh77";                                 // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
kb_C   = alloc(16);                                     // SVF coefficients: HPF section +0, LPF section +4
kb_THP = alloc(10); kb_TLP = alloc(10); kb_TPF = alloc(10);
kb_TRA = alloc(10); kb_TEX = alloc(10); kb_TAT = alloc(10); kb_TRC = alloc(10);
kb_PR  = alloc(24 * 20);                                // preset rows
function kb_fill(p, a, b, c, d, e, f, g, h, i, j) ( p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; );
kb_fill(kb_THP, 0, 40, 60, 80, 113, 160, 226, 320, 452, 640);
kb_fill(kb_TLP, 1000, 1400, 2000, 2800, 4000, 5600, 8000, 11200, 16000, 0);
kb_fill(kb_TPF, 700, 1000, 1400, 2800, 4000, 5600, 0, 0, 0, 0);
kb_fill(kb_TRA, 1.3, 1.5, 2, 3, 5, 10, 20, 0, 0, 0);
kb_fill(kb_TEX, 1.25, 1.35, 1.45, 1.55, 1.65, 1.75, 1.9, 0, 0, 0);
kb_fill(kb_TAT, 0.1, 0.3, 1, 3, 10, 30, 100, 0, 0, 0);
kb_fill(kb_TRC, 0, 0.1, 0.3, 1, 3, 6, 0, 0, 0, 0);
ost_init(0);

// ---------- the TPT state-variable filter (as KRT81): returns the low-pass, the high-pass in kb_hp ----------
function kb_svf(v0, c) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = v0 - ic2;
  v1 = c[0] * ic1 + c[1] * v3;
  v2 = ic2 + c[1] * ic1 + c[2] * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  kb_hp = v0 - c[3] * v1 - v2;
  v2;
);
function kb_cset(c, f, k) local(g) (
  g = tan($pi * min(max(f, 5), 0.45 * srate) / srate);
  c[0] = 1 / (1 + g * (g + k)); c[1] = g * c[0]; c[2] = g * c[1]; c[3] = k;
);

// ---------- one channel: the filter cassette (3rd-order Butterworth HPF / LPF) ----------
function kb_filt(x) instance(h1, l1, sh, sl) local(v, lp) (
  kb_hpon ? (
    v = (x - h1) * kb_hG; lp = v + h1; h1 = lp + v; x -= lp;
    sh.kb_svf(x, kb_C); x = kb_hp;
  );
  kb_lpon ? (
    v = (x - l1) * kb_lG; lp = v + l1; l1 = lp + v;
    x = sl.kb_svf(lp, kb_C + 4);
  );
  x;
);
function kb_fzero(which) instance(h1, l1, sh, sl) (
  which == 0 ? ( h1 = sh.ic1 = sh.ic2 = 0; ) : ( l1 = sl.ic1 = sl.ic2 = 0; );
);
function kb_ftidy() instance(h1, l1, sh, sl) (
  abs(h1) < 0.0000000001 ? h1 = 0; abs(l1) < 0.0000000001 ? l1 = 0;
  abs(sh.ic1) < 0.0000000001 ? sh.ic1 = 0; abs(sh.ic2) < 0.0000000001 ? sh.ic2 = 0;
  abs(sl.ic1) < 0.0000000001 ? sl.ic1 = 0; abs(sl.ic2) < 0.0000000001 ? sl.ic2 = 0;
);

// ---------- one channel: the presence cassette ----------
function kb_eqset() instance(lf, pr, hf) (
  lf.bq_set(4, 110, 0.7, kb_glf);                       // low shelf (bq type 4), about the set gain at 60 Hz
  pr.bq_set(2, kb_fpr, 0.7, kb_gpr);                    // bell
  hf.bq_set(3, min(5500, 0.4 * srate), 0.7, kb_ghf);    // high shelf (bq type 3), about the set gain at 10 kHz
);
function kb_eq(x) instance(lf, pr, hf) (
  kb_glf != 0 ? x = lf.bq_run(x); kb_gpr != 0 ? x = pr.bq_run(x); kb_ghf != 0 ? x = hf.bq_run(x);
  x;
);
function kb_eqtidy() instance(lf, pr, hf) (
  abs(lf.y1) < 0.0000000001 || kb_glf == 0 ? lf.x1 = lf.x2 = lf.y1 = lf.y2 = 0;
  abs(pr.y1) < 0.0000000001 || kb_gpr == 0 ? pr.x1 = pr.x2 = pr.y1 = pr.y2 = 0;
  abs(hf.y1) < 0.0000000001 || kb_ghf == 0 ? hf.x1 = hf.x2 = hf.y1 = hf.y2 = 0;
);

// ---------- soft corners of the gain law (4 dB knees) ----------
function kb_smin(g, c) ( g < c - 2 ? g : g > c + 2 ? c : g - sqr(g - c + 2) * 0.125; );
function kb_smax0(x) ( x > 2 ? x : x < -2 ? 0 : sqr(x + 2) * 0.125; );

// ---------- the dynamics detector and gain computer (one per channel, or one for both when linked) ----------
// a = rectified input (full wave). Returns the gain in dB (dynamics + gate); kb_hl = HOLD active, kb_gg = gate gain.
function kb_dyn(a) instance(L, Ls, hc, ms, Lg, hg, gg, gz, pk, pc) local(lv, st, hold, Le, Ld, x, g, tg) (
  ms += (a * a - ms) * kb_cms;
  // full-wave peak rectifier: holds each peak 10 ms, then falls fast (2 ms): the log detectors see the envelope
  a >= pk ? ( pk = a; pc = kb_h10; ) : pc > 0 ? pc -= 1 : pk *= kb_pkd;
  lv = 8.68588963807 * log(max(pk, 0.000001));           // -120 dB floor
  // ---- the main detector: log domain, attack one-pole, recovery a straight line in dB after the recovery delay
  st = 4.34294482 * log(max(ms, 0.000000000001));
  hold = kb_hon && st < L - kb_hlv;
  lv > L ? ( L += (lv - L) * kb_ca; hc = kb_hd; ) :
    hc > 0 ? hc -= 1 : !hold ? L = max(L - kb_rs, lv);
  kb_auto ? (                                            // AUTO: the slow 15 s part charges from the fast one
    L > Ls ? Ls += (L - Ls) * kb_cs : !hold ? Ls = max(Ls - kb_rss, L);
    Le = max(L, Ls);
  ) : ( Ls = L; Le = L; );
  Ld = Le + 18 + kb_ovc;                                 // dBu, with the oven's converter offset
  kb_mode ? (                                            // EXP: below REF at 1:E, down to ATT
    x = (kb_ref - Ld) * kb_e1;
    g = kb_C9 < 0.05 ? 0 : -max(kb_smin(kb_smax0(x), kb_C9), 0);
  ) : (                                                  // COMP: constant output at REF, GAIN below the knee
    g = kb_smin(-(Ld - kb_ref) * kb_q, kb_C9);
  );
  g *= kb_cx;                                            // IN / OUT glide
  // ---- the gate: its own fast detector, 1:2 below the threshold, down to ATTEN
  lv > Lg ? ( Lg += (lv - Lg) * kb_gca; hg = kb_h20; ) : hg > 0 ? hg -= 1 : Lg = max(Lg - kb_grs, lv);
  tg = kb_gon ? max(min(Lg + 18 - kb_gthr, 0), -kb_gatt) : 0;
  tg > gg ? gg += (tg - gg) * kb_gop : gg = max(gg - kb_gcl, tg);
  // ---- a light smoothing of the total (heavier for 30 ms after a stepped control moved: no clicks)
  gz += (g + gg - gz) * kb_zc;
  kb_hl = hold; kb_gg = gg;
  gz;
);
function kb_dzero() instance(L, Ls, hc, ms, Lg, hg, gg, gz, pk, pc) ( L = Ls = Lg = -120; hc = hg = ms = gg = gz = pk = pc = 0; );

// ---------- MATRIX: the transformer's iron on the low end ----------
function kb_iron(x) instance(lp, dx, dy) local(s, d) (
  lp += (x - lp) * kb_ilp;
  s = (ost_tanh(0.6 * (lp + 0.08)) - kb_itb) * kb_inm;   // unity slope at rest, no static DC
  d = s - lp;
  dy = d - dx + kb_dcd * dy; dx = d;                      // DC blocker on the added part only
  x + kb_ir * dy;
);

// ---------- settings that depend on the sample rate ----------
function kb_srinit() (
  kb_sr  = srate;
  kb_cms = 1 - exp(-1 / (0.010 * srate));                // HOLD's short-term level: 10 ms
  kb_h20 = floor(0.020 * srate);                        // the 20 ms recovery delay
  kb_h10 = floor(0.010 * srate); kb_pkd = exp(-1 / (0.002 * srate));   // the peak rectifier
  kb_cs  = 1 - exp(-1 / (1.5 * srate));                 // AUTO: the slow part charges over 1.5 s
  kb_gca = 1 - exp(-1 / (0.0002 * srate));               // gate detector: fast
  kb_grs = 20 / (0.05 * srate);                         // gate detector: falls 20 dB in 50 ms
  kb_gop = 1 - exp(-1 / (0.00043 * srate));              // gate opens in about 1 ms
  kb_la  = 1 - exp(-1 / (0.00065 * srate));              // limiter attack: 90 % in 1.5 ms
  kb_lrs = 20 / (0.2 * srate); kb_lrss = 20 / (15 * srate);
  kb_ilp = 1 - exp(-2 * $pi * 150 / srate);              // iron: the band below about 150 Hz
  kb_dcd = 1 - 2 * $pi * 5 / srate;
  kb_pfp = min(20000, 0.45 * srate);                    // 50 us pre-emphasis: zero at 3183 Hz, pole at 20 kHz
  kb_pec = 1 - exp(-2 * $pi * kb_pfp / srate); kb_pek = kb_pfp / 3183 - 1;
  kb_psm = 1 - exp(-1 / (0.02 * srate));
  kb_xf  = 1 / (0.02 * srate);                          // 20 ms crossfades
  kb_zf  = 1 - exp(-1 / (0.0002 * srate)); kb_zs = 1 - exp(-1 / (0.005 * srate));
  ost_init(0);
);
kb_srinit();
kb_itb = ost_tanh(0.6 * 0.08); kb_inm = 1 / (0.6 * (1 - kb_itb * kb_itb));

function kb_update() (
  kb_ths  = min(max(slider1 | 0, 0), 9);
  kb_tls  = min(max(slider2 | 0, 0), 9);
  kb_tlf  = min(max(slider3, -12), 12);
  kb_tpr  = min(max(slider4, -10), 10);
  kb_fpr  = kb_TPF[min(max(slider5 | 0, 0), 5)];
  kb_thf  = min(max(slider6, -12), 12);
  kb_mode = slider7 >= 0.5;
  kb_ref  = min(max(slider8, -8), 15);
  kb_C9   = min(max(slider9, 0), 20);
  kb_ri   = min(max(slider10 | 0, 0), 6);
  kb_q    = 1 - 1 / kb_TRA[kb_ri]; kb_e1 = kb_TEX[kb_ri] - 1;
  kb_att  = kb_TAT[min(max(slider11 | 0, 0), 6)];
  kb_rci  = min(max(slider12 | 0, 0), 5); kb_auto = kb_rci == 0;
  kb_hon  = slider13 < 55; kb_hlv = slider13;
  kb_gon  = slider14 > -50.5; kb_gthr = slider14; kb_gatt = min(max(slider15, 0), 20);
  kb_gtm  = slider16 < 0.5 ? 0.5 : slider16 < 1.5 ? 0.1 : 0.02;
  kb_tlx  = slider17 >= 0.5; kb_lthr = min(max(slider18, 0), 15);
  kb_pe   = slider19 >= 0.5;
  kb_tog  = 10 ^ (min(max(slider20, -12), 12) / 20);
  drift_macro(slider21);
  kb_link = slider22 >= 0.5;
  kb_ord  = slider23 >= 0.5;
  kb_tbyp = slider24 >= 0.5;
  kb_tir  = slider25 >= 1.5;
  kb_tcx  = slider26 >= 0.5;
  // a stepped control or the mode moved: smooth the gain heavier for 30 ms
  kb_sig  = kb_mode + 2 * kb_ri + 16 * kb_rci + 128 * kb_gon + 256 * kb_hon;
  kb_sig != kb_sig0 ? ( kb_sig0 = kb_sig; kb_zt = floor(0.03 * srate); );
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;        // no latency
);

// ---------- presets: three rows of 8 values per preset ----------
// row 0: HPF, LPF, LF, PRESENCE, P.FREQ, HF, COMP/EXP, REF
// row 1: GAIN, RATIO, ATTACK, RECOVERY, HOLD, GATE LEVEL, GATE ATTEN, GATE TIME
// row 2: LIM IN, LIM LEVEL, PRE-EMPH, OUT, ORDER, DYN IN
function kb_row(p, r, a, b, c, d, e, f, g, h) local(m) (
  m = kb_PR + p * 24 + r * 8; m[0] = a; m[1] = b; m[2] = c; m[3] = d; m[4] = e; m[5] = f; m[6] = g; m[7] = h;
);
//                 HPF LPF  LF  PRS PF  HF  C/E REF
kb_row(1,  0,  0,  9,   0,   0, 3,   0, 0,  6);           // Init
kb_row(1,  1,  0,  2,   3,   0, 60, -55, 12, 1);
kb_row(1,  2,  0, 10,   0,   0, 0,   0, 0,  0);
kb_row(2,  0,  3,  9,   0,   2, 3,   3, 0,  4);           // Vocal Ride
kb_row(2,  1,  6,  3,   3,   0, 30, -55, 12, 1);
kb_row(2,  2,  1, 12,   0,   0, 0,   1, 0,  0);
kb_row(3,  0,  4,  9,  -3,   4, 4,   0, 0,  6);           // Broadcast Voice
kb_row(3,  1, 10,  4,   2,   0, 20, -40, 12, 1);
kb_row(3,  2,  1,  8,   1,   0, 0,   1, 0,  0);
kb_row(4,  0,  4,  7,   0,   2, 3,   0, 0,  6);           // Dialogue Clean
kb_row(4,  1,  4,  2,   4,   3, 25, -35, 15, 1);
kb_row(4,  2,  1, 10,   0,   0, 0,   1, 0,  0);
kb_row(5,  0,  1,  9,   3,   0, 3,   3, 0,  2);           // Drum Bus
kb_row(5,  1,  4,  3,   5,   2, 60, -55, 12, 1);
kb_row(5,  2,  1, 12,   0,   0, 1,   1, 0,  0);
kb_row(6,  0,  1,  9,   3,  -2, 1,   0, 0,  4);           // Bass Even
kb_row(6,  1,  8,  4,   4,   0, 20, -55, 12, 1);
kb_row(6,  2,  1, 10,   0,   0, 0,   1, 0,  0);
kb_row(7,  0,  3,  9,  -3,   2, 5,   3, 0,  4);           // Acoustic Guitar
kb_row(7,  1,  4,  2,   4,   2, 60, -55, 12, 1);
kb_row(7,  2,  0, 10,   0,   0, 0,   1, 0,  0);
kb_row(8,  0,  0,  9,   0,   0, 3,   0, 0,  8);           // Mix Bus Glue
kb_row(8,  1,  2,  1,   5,   0, 60, -55, 12, 1);
kb_row(8,  2,  1, 14,   0,   0, 1,   1, 0,  0);
kb_row(9,  0,  0,  9,   0,   0, 3,   0, 0,  6);           // Upward Lift
kb_row(9,  1, 12,  2,   3,   0, 20, -55, 12, 1);
kb_row(9,  2,  1, 12,   0,   0, 0,   1, 0,  0);
kb_row(10, 0,  2,  9,   0,   2, 3,   0, 0,  4);           // Radio Limiter
kb_row(10, 1,  8,  5,   2,   0, 20, -55, 12, 1);
kb_row(10, 2,  1,  6,   1,   0, 0,   1, 0,  0);
kb_row(11, 0,  0,  9,   0,   0, 3,   0, 1, -2);           // Expander Clean-up
kb_row(11, 1, 12,  3,   2,   2, 60, -55, 12, 1);
kb_row(11, 2,  0, 10,   0,   0, 0,   1, 0,  0);
kb_row(12, 0,  2,  9,   0,   0, 3,   0, 0,  6);           // Noisy Track Gate
kb_row(12, 1,  0,  2,   3,   0, 60, -30, 20, 2);
kb_row(12, 2,  0, 10,   0,   0, 0,   0, 0,  0);
kb_row(13, 0,  0,  7,   3,   0, 3,  -3, 0,  8);           // Tape Transfer
kb_row(13, 1,  2,  2,   4,   0, 60, -55, 12, 1);
kb_row(13, 2,  1, 14,   0,   0, 0,   1, 0,  0);
function kb_lp(p) local(m) (
  p >= 1 && p <= 13 ? (
    m = kb_PR + p * 24;
    slider1 = m[0]; slider2 = m[1]; slider3 = m[2]; slider4 = m[3]; slider5 = m[4]; slider6 = m[5];
    slider7 = m[6]; slider8 = m[7]; slider9 = m[8]; slider10 = m[9]; slider11 = m[10]; slider12 = m[11];
    slider13 = m[12]; slider14 = m[13]; slider15 = m[14]; slider16 = m[15];
    slider17 = m[16]; slider18 = m[17]; slider19 = m[18]; slider20 = m[19]; slider23 = m[20]; slider26 = m[21];
    slider_automate(1048575 + 4194304 + 33554432);        // sliders 1-20, 23, 26
  );
);
function load_preset(p) (
  p <= 13 ? kb_lp(p) : (                                  // 14: Reset all to defaults (MATRIX, linked, DRIFT 50 %)
    kb_lp(1); slider21 = 50; slider22 = 1; slider24 = 0; slider25 = 2;
    slider_automate(1048576 + 2097152 + 8388608 + 16777216);
  );
);

// ---------- state ----------
dWL.drift_init(0.8 + rand(1) * 0.4); dWR.drift_init(0.8 + rand(1) * 0.4);
kb_mm  = rand(2) - 1;                                   // the oven's fixed L / R converter mismatch
kb_hph = rand(1); kb_hper = 22 + rand(16);              // thermostat cycle: phase, period (s)
kb_heat = 0;                                            // 0 cold .. 1 warm (counts processed audio)
kb_update();
kb_sig0 = kb_sig; kb_zt = 0;
kb_flh = kb_ths ? log(kb_THP[kb_ths]) : log(5); kb_fll = kb_tls < 9 ? log(kb_TLP[kb_tls]) : log(min(30000, 0.45 * srate));
kb_hpon = kb_ths > 0; kb_lpon = kb_tls < 9;
kb_glf = kb_tlf; kb_gpr = kb_tpr; kb_ghf = kb_thf;
kb_og = kb_tog; kb_cx = kb_tcx; kb_lx = kb_tlx; kb_ir = kb_tir; kb_bx = kb_tbyp;
fL.kb_fzero(0); fL.kb_fzero(1); fR.kb_fzero(0); fR.kb_fzero(1);
dL.kb_dzero(); dR.kb_dzero();
kb_Ll = kb_Lls = -120; kb_lh = 0; kb_pel = kb_per = 0;
lmL.ost_acz(); lmR.ost_acz();
kbm_g0 = kbm_g1 = 0; kbm_lim = kbm_hold = kbm_gate = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
// the @slider work, also run after a preset swap in @block (PRESET parameter)
function prs_sl() (
kb_update();
);
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  // PRESET parameter: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
srate != kb_sr ? kb_srinit();
kb_update();                                            // knobs moved on the panel do not run @slider
kb_bdt = samplesblock / srate;
// ---- the oven (DRIFT): warms over about 45 s of running audio, then the thermostat cycles
kb_heat = min(kb_heat + kb_bdt / 45, 1);
kb_cold = sqr(1 - kb_heat);
kb_hph += kb_bdt / kb_hper;
kb_hph >= 1 ? ( kb_hph -= 1; kb_hper = 22 + rand(16); );
kb_tri = 1 - 4 * abs(kb_hph - 0.5);                     // -1 .. 1: the oven's temperature ripple
kb_hton = kb_hph < 0.5;                                 // the heater: on while the temperature rises
kb_wL = dWL.drift_tick(0.05 * dm_s * kb_bdt); kb_wR = dWR.drift_tick(0.05 * dm_s * kb_bdt);
kb_ovw = 1 - kb_cold;                                   // the thermostat and wander come in as it warms
kb_ovL = dm_a * (kb_cold * (1.5 + 0.5 * kb_mm) + kb_ovw * (0.15 * kb_tri + 0.2 * kb_wL));
kb_ovR = dm_a * (kb_cold * (1.5 - 0.5 * kb_mm) + kb_ovw * (0.15 * kb_tri + 0.2 * kb_wR));
kb_ovLim = dm_a * (kb_cold * 1.0 + kb_ovw * 0.1 * kb_tri);
kb_ovT = 1 + min(0.2 * kb_cold * dm_a, 0.4);            // cold: sluggish recovery
// ---- dynamics times (per 20 dB)
kb_ca  = 1 - exp(-1 / (kb_att * 0.001 / 2.3 * srate));
kb_auto ? (
  kb_rs = 20 / (0.2 * kb_ovT * srate); kb_rss = 20 / (15 * kb_ovT * srate); kb_hd = floor(0.05 * srate);
) : (
  kb_rs = 20 / (kb_TRC[kb_rci] * kb_ovT * srate); kb_rss = kb_rs; kb_hd = kb_h20;
);
kb_gcl = 20 / (kb_gtm * srate);
kb_lT  = kb_lthr - 18 - kb_ovLim;                       // the limiter threshold (dBFS), the clip ceiling +3 dB over it
kb_lc  = 10 ^ ((kb_lT + 3) / 20);
kb_lrsT = kb_lrs / kb_ovT; kb_lrssT = kb_lrss / kb_ovT;
kb_zc = kb_zt > 0 ? kb_zs : kb_zf; kb_zt = max(kb_zt - samplesblock, 0);
// ---- the filter cassette: glide in log frequency (50 ms); OFF slides out of the band, then switches out
kb_k = 1 - exp(-kb_bdt / 0.05);
kb_fmax = log(min(30000, 0.45 * srate)); kb_fmin = log(5);
kb_th = kb_ths ? log(kb_THP[kb_ths]) : kb_fmin;
kb_tl = kb_tls < 9 ? log(kb_TLP[kb_tls]) : kb_fmax;
kb_ths && !kb_hpon ? ( kb_hpon = 1; kb_flh = kb_fmin; fL.kb_fzero(0); fR.kb_fzero(0); );
kb_tls < 9 && !kb_lpon ? ( kb_lpon = 1; kb_fll = kb_fmax; fL.kb_fzero(1); fR.kb_fzero(1); );
kb_flh += (kb_th - kb_flh) * kb_k; kb_fll += (kb_tl - kb_fll) * kb_k;
!kb_ths && kb_flh < kb_fmin + 0.02 ? kb_hpon = 0;
kb_tls == 9 && kb_fll > kb_fmax - 0.02 ? kb_lpon = 0;
kb_t = tan($pi * min(exp(kb_flh), 0.45 * srate) / srate); kb_hG = kb_t / (1 + kb_t);
kb_cset(kb_C, exp(kb_flh), 1);
kb_t = tan($pi * min(exp(kb_fll), 0.45 * srate) / srate); kb_lG = kb_t / (1 + kb_t);
kb_cset(kb_C + 4, exp(kb_fll), 1);
// ---- the presence cassette: gains glide (30 ms)
kb_k = 1 - exp(-kb_bdt / 0.03);
kb_glf += (kb_tlf - kb_glf) * kb_k; kb_gpr += (kb_tpr - kb_gpr) * kb_k; kb_ghf += (kb_thf - kb_ghf) * kb_k;
abs(kb_glf - kb_tlf) < 0.001 ? kb_glf = kb_tlf; abs(kb_gpr - kb_tpr) < 0.001 ? kb_gpr = kb_tpr;
abs(kb_ghf - kb_thf) < 0.001 ? kb_ghf = kb_thf;
eL.kb_eqset(); eR.kb_eqset();
// ---- denormal housekeeping
fL.kb_ftidy(); fR.kb_ftidy(); eL.kb_eqtidy(); eR.kb_eqtidy();
abs(iL.dy) < 0.0000000001 ? iL.dx = iL.dy = 0; abs(iR.dy) < 0.0000000001 ? iR.dx = iR.dy = 0;
abs(iL.lp) < 0.0000000001 ? iL.lp = 0; abs(iR.lp) < 0.0000000001 ? iR.lp = 0;
abs(kb_pel) < 0.0000000001 ? kb_pel = 0; abs(kb_per) < 0.0000000001 ? kb_per = 0;
// ---- the meters (the panel only draws): gain per channel, LEDs held 80 ms
kbm_g0 = kb_mg0; kbm_g1 = kb_mg1;
kbm_lim  = kb_flim  ? 0.08 : max(kbm_lim  - kb_bdt, 0);
kbm_hold = kb_fhold ? 0.08 : max(kbm_hold - kb_bdt, 0);
kbm_gate = kb_fgate ? 0.08 : max(kbm_gate - kb_bdt, 0);
kb_flim = kb_fhold = kb_fgate = 0; ost_clipped = 0;

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- input DC blocker, 1 Hz: no offset reaches the nonlinear stages ----------
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
kb_il = spl0; kb_ir0 = spl1;
// ---------- glides ----------
kb_og += (kb_tog - kb_og) * kb_psm;
kb_cx = kb_tcx ? min(kb_cx + kb_xf, 1) : max(kb_cx - kb_xf, 0);
kb_lx = kb_tlx ? min(kb_lx + kb_xf, 1) : max(kb_lx - kb_xf, 0);
kb_ir = kb_tir ? min(kb_ir + kb_xf, 1) : max(kb_ir - kb_xf, 0);
// ---------- FILTER ----------
kb_l = fL.kb_filt(kb_il); kb_r = fR.kb_filt(kb_ir0);
// ---------- EQ before the dynamics ----------
!kb_ord ? ( kb_l = eL.kb_eq(kb_l); kb_r = eR.kb_eq(kb_r); );
// ---------- DYNAMICS (+ gate) ----------
kb_link ? (
  kb_ovc = 0.5 * (kb_ovL + kb_ovR);
  kb_gl = kb_gr = dL.kb_dyn(max(abs(kb_l), abs(kb_r)));
  kb_hl ? kb_fhold = 1; kb_gg < -1 ? kb_fgate = 1;
) : (
  kb_ovc = kb_ovL; kb_gl = dL.kb_dyn(abs(kb_l)); kb_hl ? kb_fhold = 1; kb_gg < -1 ? kb_fgate = 1;
  kb_ovc = kb_ovR; kb_gr = dR.kb_dyn(abs(kb_r)); kb_hl ? kb_fhold = 1; kb_gg < -1 ? kb_fgate = 1;
);
kb_l *= exp(kb_gl * 0.115129255); kb_r *= exp(kb_gr * 0.115129255);
kb_mg0 = kb_gl; kb_mg1 = kb_gr;
// ---------- EQ after the dynamics ----------
kb_ord ? ( kb_l = eL.kb_eq(kb_l); kb_r = eR.kb_eq(kb_r); );
// ---------- MATRIX iron ----------
kb_ir > 0 ? ( kb_l = iL.kb_iron(kb_l); kb_r = iR.kb_iron(kb_r); );
// ---------- OUTPUT LEVEL ----------
kb_l *= kb_og; kb_r *= kb_og;
// ---------- LIMITER (linked): steady-state detector + the logarithmic clipping circuit ----------
kb_lx > 0 ? (
  kb_pel += (kb_l - kb_pel) * kb_pec; kb_per += (kb_r - kb_per) * kb_pec;   // 50 us pre-emphasis for the detector
  kb_a = kb_pe ? max(abs(kb_l + kb_pek * (kb_l - kb_pel)), abs(kb_r + kb_pek * (kb_r - kb_per))) : max(abs(kb_l), abs(kb_r));
  kb_a >= kb_lpk ? ( kb_lpk = kb_a; kb_lpc = kb_h10; ) : kb_lpc > 0 ? kb_lpc -= 1 : kb_lpk *= kb_pkd;
  kb_lv = 8.68588963807 * log(max(kb_lpk, 0.000001));
  kb_lv > kb_Ll ? ( kb_Ll += (kb_lv - kb_Ll) * kb_la; kb_lh = kb_h20; ) :
    kb_lh > 0 ? kb_lh -= 1 : kb_Ll = max(kb_Ll - kb_lrsT, kb_lv);
  kb_Ll > kb_Lls ? kb_Lls += (kb_Ll - kb_Lls) * kb_cs : kb_Lls = max(kb_Lls - kb_lrssT, kb_Ll);
  kb_lgr = min(kb_lT - max(kb_Ll, kb_Lls), 0);
  kb_lgr < -0.5 ? kb_flim = 1;
  kb_t = exp(kb_lgr * 0.115129255);
  kb_yl = lmL.ost_acl(kb_l * kb_t, kb_lc); kb_yr = lmR.ost_acl(kb_r * kb_t, kb_lc);
  ost_clipped ? kb_flim = 1;
  kb_t = kb_lx * kb_lx * (3 - 2 * kb_lx);
  kb_l += (kb_yl - kb_l) * kb_t; kb_r += (kb_yr - kb_r) * kb_t;
) : ( kb_Ll = kb_Lls = -120; kb_lpk = kb_lpc = 0; lmL.ost_acx(kb_l); lmR.ost_acx(kb_r); );
// ---------- BYPASS: crossfade to the input ----------
kb_bx = kb_tbyp ? min(kb_bx + kb_xf, 1) : max(kb_bx - kb_xf, 0);
kb_bx > 0 ? (
  kb_t = kb_bx * kb_bx * (3 - 2 * kb_bx);
  spl0 = kb_l + (kb_il - kb_l) * kb_t;
  spl1 = kb_r + (kb_ir0 - kb_r) * kb_t;
) : ( spl0 = kb_l; spl1 = kb_r; );
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );   // PRESET parameter duck: the swap ducks 5 ms, loads at silence (at the top of a block) and comes back over 30 ms

@gfx 1080 432
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1080, 432);

// =====================================================================
// Theme colours: the KRT81 family (VFD / MATRIX)
// =====================================================================
kbv_th = slider25 >= 1.5 ? 2 : 1;
kbv_th == 1 ? (                                         // VFD: cold gas-discharge
  KBF  = 0x0F1112;
  KBP  = 0x181A1B;                                      // charcoal slate
  KBH  = ui_mix(KBP, 0x000000, 0.35);
  KBS  = ui_mix(KBP, 0x000000, 0.22);
  KBI  = 0x4EE1DC;                                      // cold turquoise
  KBI2 = ui_mix(0x4EE1DC, KBP, 0.45);
  KBA  = 0xFF8C00;                                      // neon amber
  KBL  = 0xFF8C00;
  KBW  = 0x070808;
  KBK  = 0x4EE1DC;
  KBM  = 0x3C4044;
) : (                                                   // MATRIX: military LED matrix
  KBP  = 0x222528;                                      // battleship grey
  KBF  = ui_mix(KBP, 0x000000, 0.25);
  KBH  = ui_mix(KBP, 0x000000, 0.30);
  KBS  = ui_mix(KBP, 0x000000, 0.40);
  KBI  = 0xC7BEB3;                                      // print: elephant's breath
  KBI2 = ui_mix(0xC7BEB3, KBP, 0.4);
  KBA  = 0xD4A373;                                      // mustard amber
  KBL  = 0xBC3908;
  KBW  = ui_mix(KBP, 0x000000, 0.45);
  KBK  = 0xD4A373;
  KBM  = 0x4A4E4A;
);
KBGRN = 0x1E5631; KBOLV = 0x2C302E; KBGH = 0x0D0E0F;

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');          // title
gfx_setfont(10, "Trebuchet MS", 14 * sc, 'b');          // scale numbers
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');          // labels
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');          // small scale numbers
gfx_setfont(14, "Trebuchet MS", 15 * sc, 'b');          // knob names
gfx_setfont(15, "Trebuchet MS", 14 * sc, 'b');          // BYPASS (lamp key legend)
gfx_setfont(16, "Trebuchet MS", 12 * sc, 'b');          // lamp key legends
gfx_setfont(12, "Trebuchet MS", 10.5 * sc, 'b');        // cream key legends (COMP section: IN / COMP / EXP)

function kb_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kb_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function kb_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kb_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kb_lbl(x, y, s) ( gfx_setfont(11); ui_col(KBI2); kb_txt(x, y, s); );
function kb_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );

// panel keys: house lamp keys (gfx-ui). kb_kc = the key's lamp colour (set before the call; cleared after;
// none = amber); returns 1 when clicked
function kb_key(x, y, w, h, lbl, on) local(c) (
  c = kb_kc ? kb_kc : LK_AMB; kb_kc = 0;
  lk_well = 0x0A0A0B; lk_font = 15; lk_font2 = 16;
  lk_fit(x, y, w, h, on, c, lbl);
);
// cream selector keys (gfx-ui ck_key): the COMP section's IN, COMP and EXP; same footprint as kb_key
function kb_ck(x, y, w, h, lbl, on) ( ck_font = 12; ck_key(x, y, w, h, on, lbl); );
// a cassette that's switched off: greyed slightly (its IN key is redrawn on top)
function kb_off(x, y, w, h) ( ui_cola(KBF, 0.5); kb_r(x + 1, y + 1, w - 2, h - 2); );

// a cassette: sharp-cornered face with a thin frame and its name
function kb_sect(x, y, w, h, col, name) (
  ui_col(kbv_th == 1 ? ui_mix(KBI, KBP, 0.78) : 0x0B0C0D); kb_r(x, y, w, h); ui_col(col); kb_r(x + 1, y + 1, w - 2, h - 2);
  strlen(name) ? kb_lbl(x + 9, y + 6, name);
);
// a cassette's lamp (panel LED)
function kb_lamp(x, y, on, col) ( pk_led(x * sc, y * sc, 4.6 * sc, on, col); );

// the big BYPASS key (a house lamp key, red): lit = bypassed
function kb_big(x, y, w, h, s, on) (
  lk_well = 0x0A0A0B; lk_font = 15; lk_font2 = 16;
  lk_fit(x, y, w, h, on, LK_RED, s);
);

// printed scale round a main knob: n numbers from the list ("a|b|c"), a tick at each (and minor ticks between)
function kb_scale(cx, cy, r, n, nr, labels, minor) local(i, k, k0, len, c, a, ca, sa, m) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  minor > 0 ? (
    m = 0; ui_col(KBI2);
    loop((n - 1) * minor + 1,
      a = -0.75 * $pi + m / ((n - 1) * minor) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 6)) * sc, (cy + sa * (r + 6)) * sc, 1);
      m += 1;
    );
  );
  gfx_setfont(13);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#kbv_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      ui_col(KBI);
      gfx_line((cx + ca * (r + 3)) * sc, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 8)) * sc, (cy + sa * (r + 8)) * sc, 1);
      gfx_line((cx + ca * (r + 3)) * sc + 1, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 8)) * sc + 1, (cy + sa * (r + 8)) * sc, 1);
      kb_ctxt(cx + ca * (r + nr), cy + sa * (r + nr), #kbv_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);

// a pointer line of width w (pixels), round ends: drawn here so the panel does not depend on the gfx-ui version
function kb_ssline(x1, y1, x2, y2, w) local(k, dx, dy, l, nx, ny) (
  k = max(w, 0.6) * 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001);
  nx = -dy / l * k; ny = dx / l * k;
  gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
  gfx_circle(x1, y1, k, 1, 1); gfx_circle(x2, y2, k, 1, 1);
);
// the chunky bakelite main knob (as KRT81): fluted skirt, flat cap, broad pointer (pixels)
function kb_bake(cx, cy, r, a) local(i, t, ca, sa, k) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.55); gfx_circle(cx + 2.5 * sc, cy + 4.5 * sc, r * 1.02, 1, 1);
  ui_col(0x0C0B0A); gfx_circle(cx, cy, r + 1 * sc, 1, 1);
  ui_col(0x1B1916); gfx_circle(cx, cy, r, 1, 1);
  i = 0;
  loop(16,
    t = i / 16 * 2 * $pi;
    k = 0.5 + 0.5 * cos(t + 0.8);
    ui_col(ui_mix(0x0E0D0B, 0x4A453D, k * 0.8)); gfx_circle(cx + sin(t) * r * 0.86, cy - cos(t) * r * 0.86, r * 0.15, 1, 1);
    ui_col(0x0E0D0B); gfx_circle(cx + sin(t + 0.196) * r * 0.9, cy - cos(t + 0.196) * r * 0.9, r * 0.075, 1, 1);
    i += 1;
  );
  ui_col(0x0A0908); gfx_circle(cx, cy, r * 0.70 + 1 * sc, 1, 1);
  ui_col(0x24211D); gfx_circle(cx, cy, r * 0.70, 1, 1);
  ui_cola(0xFFFFFF, 0.08); gfx_circle(cx, cy, r * 0.70, 0, 1);
  ui_col(0x080706);
  kb_ssline(cx + ca * r * 0.18, cy + sa * r * 0.18, cx + ca * r * 0.98, cy + sa * r * 0.98, 4.2 * sc);
  ui_col(KBK);
  kb_ssline(cx + ca * r * 0.22, cy + sa * r * 0.22, cx + ca * r * 0.95, cy + sa * r * 0.95, 2.5 * sc);
);
// the small knob's cap (pixels): a flat coloured cap on a plain dark skirt, contrasting pointer
function kb_scap(cx, cy, r, a, cap) local(ca, sa, k, pc) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(0x141416); gfx_circle(cx, cy, r, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx, cy, r, 0, 1);
  k = r * 0.74;
  ui_col(cap); gfx_circle(cx, cy, k, 1, 1);
  ui_col(ui_mix(cap, 0x000000, 0.35)); gfx_circle(cx, cy, k, 0, 1);
  pc = (cap & 255) + ((cap >> 8) & 255) + ((cap >> 16) & 255) > 380 ? 0x141416 : 0xF4F0E6;
  ui_col(pc);
  kb_ssline(cx + ca * k * 0.2, cy + sa * k * 0.2, cx + ca * r * 0.94, cy + sa * r * 0.94, 2.6 * sc);
);
kbv_kc = -1;                                            // -1: bakelite main knob; else a small cap of that colour
kbv_stp = 0;                                            // > 0: a stepped knob (its step, in the slider's units)
// a knob: drag (shift = fine), double-click = default, wheel; returns 1 while touched
function kb_knob(cx, cy, r, idx, lo, hi, def) local(v, n, dx, dy, hov, did) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - kbv_lt < 0.35 && kbv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; kbv_lt = 0; ) : (
      drag_id = did; kbv_my = mouse_y; kbv_lt = time_precise(); kbv_lid = idx;
      kbv_n = (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    kbv_n = min(max(kbv_n + (kbv_my - mouse_y) / (((mouse_cap & 8) ? 1200 : 240) * sc), 0), 1); kbv_my = mouse_y;
    v = lo + kbv_n * (hi - lo);
    kbv_stp > 0 ? v = lo + floor((v - lo) / kbv_stp + 0.5) * kbv_stp;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    kbv_stp > 0 ? v = min(max(v + (mouse_wheel > 0 ? kbv_stp : -kbv_stp), lo), hi)
                : v = lo + min(max((v - lo) / (hi - lo) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1) * (hi - lo);
    slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  kbv_kc < 0 ? kb_bake(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi) : kb_scap(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi, kbv_kc);
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  hov || drag_id == did;
);
// a main knob's name under it; the value replaces the name while the knob is touched
function kb_name(cx, cy, act, name, val) ( gfx_setfont(14); ui_col(act ? KBA : KBI); kb_ctxt(cx, cy, act ? val : name); );
// a small house knob: nt ticks (one per step on a stepped knob), a coloured cap
function kb_small(cx, cy, r, idx, lo, hi, def, cap, nt, name, val) local(i, t, act) (
  ui_cola(KBI, 0.85); i = 0;
  loop(nt, t = -0.75 * $pi + i / (nt - 1) * 1.5 * $pi;
    gfx_circle((cx + sin(t) * (r + 4 + r + 9) * 0.5) * sc, (cy - cos(t) * (r + 4 + r + 9) * 0.5) * sc, min(max(((r + 9) - (r + 4)) * 0.3, 1), 1.8) * sc, 1, 1); i += 1; );
  kbv_kc = cap; act = kb_knob(cx, cy, r, idx, lo, hi, def); kbv_kc = -1;
  gfx_setfont(11); ui_col(act ? KBA : KBI);
  kb_ctxt(cx, cy + r + 16, act ? val : name);
);

// ---------- the gain meter's cells (zone: 0 reduction, 1 gain, 2 deep reduction) ----------
function kb_cell(x, y, w, h, lit, zone) local(c) (
  kbv_th == 1 ? (
    c = zone == 1 ? KBA : zone == 2 ? 0xFF5A3C : KBI;
    lit ? ( ui_cola(c, 0.22); kb_r(x - 1.5, y - 0.5, w + 3, h + 1); ui_col(c); kb_r(x, y, w, h);
            ui_cola(0xFFFFFF, 0.25); kb_r(x, y + 1, w, 1); )
        : ( ui_col(KBGH); kb_r(x, y, w, h); ui_cola(c, 0.05); kb_r(x, y, w, h); );
  ) : (
    c = zone == 2 ? 0xBC3908 : zone == 1 ? 0xD4A373 : KBGRN;
    lit ? ( ui_cola(c, 0.16); kb_r(x - 1, y - 0.5, w + 2, h + 1); ui_col(c); kb_r(x, y, w, h);
            ui_cola(0xFFFFFF, 0.22); kb_r(x, y, w, 1.5); ui_cola(0x000000, 0.18); kb_r(x, y + h - 1.5, w, 1.5); )
        : ( ui_col(KBOLV); kb_r(x, y, w, h); ui_cola(0x000000, 0.25); kb_r(x, y + h - 1, w, 1); );
  );
);
// the 16-step column: +8 .. -20 dB in 1.75 dB cells, lit from 0 dB towards the gain
function kb_gbar(x, y, w, h, g) local(i, sh, top, bot) (
  sh = h / 16; i = 0;
  loop(16,
    top = 8 - i * 1.75; bot = top - 1.75;
    kb_cell(x, y + i * sh + 0.5, w, sh - 2.5,
      bot >= -0.01 ? g > bot + 0.5 : top <= 0.01 ? g < top - 0.5 : 0,
      bot >= -0.01 ? 1 : bot < -12 ? 2 : 0);
    i += 1;
  );
);
// a recessed meter window
function kb_window(x, y, w, h) ( ui_col(kbv_th == 1 ? 0x2E3235 : 0x0B0C0D); kb_r(x, y, w, h); ui_col(KBW); kb_r(x + 1, y + 1, w - 2, h - 2); );

// ---------- the corner rivets (house style: no corner brackets) ----------
function kb_rivet(cx, cy) local(c) (
  c = ui_mix(KBM, 0xFFFFFF, 0.25);
  ui_cola(0x000000, 0.45); gfx_circle((cx + 0.8) * sc, (cy + 1.2) * sc, 3.6 * sc, 1, 1);
  ui_col(ui_mix(c, 0x000000, 0.35)); gfx_circle(cx * sc, cy * sc, 3.6 * sc, 1, 1);
  ui_col(c); gfx_circle(cx * sc, cy * sc, 3 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.35); gfx_circle((cx - 0.9) * sc, (cy - 0.9) * sc, 1.1 * sc, 1, 1);
);

// =====================================================================
// Faceplate and header
// =====================================================================
ui_col(ui_mix(KBP, 0x000000, 0.35)); gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0xFFFFFF, 0.08); kb_r(0, 0, 1080, 1.5); kb_r(0, 0, 1.5, 432);
ui_cola(0x000000, 0.35); kb_r(0, 430.5, 1080, 1.5); kb_r(1078.5, 0, 1.5, 432);
ui_col(KBP); kb_r(12, 12, 1056, 408);
ui_cola(0x000000, 0.30); kb_r(12, 12, 1056, 1.5); kb_r(12, 12, 1.5, 408);
ui_cola(0xFFFFFF, 0.07); kb_r(12, 418.5, 1056, 1.5); kb_r(1066.5, 12, 1.5, 408);
ui_col(KBH); kb_r(13.5, 13.5, 1053, 50.5);
ui_col(KBA); kb_r(13.5, 64, 1053, 2);
ui_col(kbv_th == 2 ? KBA : KBI); gfx_circle(45 * sc, 39 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(0x111213); ui_text(45 * sc, 33.5 * sc, "GFX");
gfx_setfont(6); ui_col(KBI); kb_txt(72, 24, "KBH77"); ver_tag("v3", 9, 7.7, 0);
gfx_setfont(11); ui_col(KBI2); kb_txt(172, 25, "BROADCAST CHANNEL"); kb_txt(172, 40, "FILTER · PRESENCE · DYNAMICS");
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(392 * sc, 22 * sc, 300 * sc, 34 * sc, pr_cur,
  "Init|Vocal Ride|Broadcast Voice|Dialogue Clean|Drum Bus|Bass Even|Acoustic Guitar|Mix Bus Glue|Upward Lift|Radio Limiter|Expander Clean-up|Noisy Track Gate|Tape Transfer");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 13 ? 1 : k_; );
// the LOOK keys: VFD / MATRIX
kb_kc = LK_ORA; kb_key(704, 25, 56, 28, "VFD",    kbv_th == 1) ? ( slider25 = 1; ui_auto(25); );
kb_kc = LK_ORA; kb_key(764, 25, 62, 28, "MATRIX", kbv_th == 2) ? ( slider25 = 2; ui_auto(25); );
// LINK and ORDER (the EQ and dynamics cassettes swap places)
kb_kc = LK_RED; kb_key(846, 25, 56, 28, "LINK", slider22 >= 0.5) ? ( slider22 = slider22 >= 0.5 ? 0 : 1; ui_auto(22); );
kb_kc = LK_BLU; kb_key(908, 25, 86, 28, slider23 >= 0.5 ? "DYN ► EQ" : "EQ ► DYN", 0) ? ( slider23 = slider23 >= 0.5 ? 0 : 1; ui_auto(23); );
ui_size_picker(1004 * sc, 30 * sc);

// =====================================================================
// The cassettes (y 74 .. 410): FILTER | PRESENCE | COMPRESSOR | GAIN | GATE | LIMITER | OUTPUT
// =====================================================================
kbv_y = 74; kbv_h = 336;

// ---------- FILTER (x 22, w 96) ----------
kb_sect(22, kbv_y, 96, kbv_h, KBF, "FILTER");
kbv_s = slider1 | 0; kbv_s == 0 ? strcpy(#kbv_v, "OFF") : sprintf(#kbv_v, "%d Hz", kb_THP[kbv_s]);
kbv_stp = 1; kb_small(70, 150, 20, 1, 0, 9, 0, 0xE8C21E, 10, "HPF", #kbv_v);
kbv_s = slider2 | 0; kbv_s == 9 ? strcpy(#kbv_v, "OFF") : sprintf(#kbv_v, "%.1f kHz", kb_TLP[kbv_s] / 1000);
kb_small(70, 250, 20, 2, 0, 9, 9, 0x1A1A1A, 10, "LPF", #kbv_v); kbv_stp = 0;
gfx_setfont(13); ui_col(KBI2); kb_ctxt(70, 340, "18 dB/OCT");

// ---------- PRESENCE EQ ----------
function kb_draw_eq(x) (
  kb_sect(x, kbv_y, 150, kbv_h, KBF, "PRESENCE");
  kbv_stp = 3;
  sprintf(#kbv_v, "%+d dB", slider3); kb_small(x + 40, 140, 18, 3, -12, 12, 0, 0x7A4A2A, 9, "LF", #kbv_v);
  sprintf(#kbv_v, "%+d dB", slider6); kb_small(x + 110, 140, 18, 6, -12, 12, 0, 0xB8322A, 9, "HF", #kbv_v);
  kbv_stp = 2;
  sprintf(#kbv_v, "%+d dB", slider4); kb_small(x + 75, 245, 24, 4, -10, 10, 0, 0x3E7D4A, 11, "PRESENCE", #kbv_v);
  kbv_stp = 1;
  sprintf(#kbv_v, "%.1f kHz", kb_TPF[slider5 | 0] / 1000); kb_small(x + 75, 345, 16, 5, 0, 5, 3, 0x3E7D4A, 6, "FREQ", #kbv_v);
  kbv_stp = 0;
);
// ---------- COMPRESSOR / EXPANDER ----------
function kb_draw_dyn(x) local(a, ex) (
  ex = slider7 >= 0.5;
  kb_sect(x, kbv_y, 250, kbv_h, KBF, ex ? "EXP" : "COMP");
  kb_ck(x + 104, 92, 38, 26, "IN", slider26 >= 0.5) ? ( slider26 = slider26 >= 0.5 ? 0 : 1; ui_auto(26); );
  kb_ck(x + 146, 92, 52, 26, "COMP", !ex) ? ( slider7 = 0; ui_auto(7); );
  kb_ck(x + 202, 92, 42, 26, "EXP", ex) ? ( slider7 = 1; ui_auto(7); );
  // GAIN / ATT
  kb_scale(x + 65, 182, 30, 6, 18, "0|4|8|12|16|20", 1);
  a = kb_knob(x + 65, 182, 30, 9, 0, 20, 0);
  sprintf(#kbv_v, ex ? "-%.1f dB" : "+%.1f dB", slider9); kb_name(x + 65, 230, a, ex ? "ATT" : "GAIN", #kbv_v);
  // RATIO (stepped)
  kb_scale(x + 185, 182, 30, 7, 19, ex ? "1.25|1.35|1.45|1.55|1.65|1.75|1.9" : "1.3|1.5|2|3|5|10|20", 0);
  kbv_stp = 1; a = kb_knob(x + 185, 182, 30, 10, 0, 6, 2); kbv_stp = 0;
  ex ? sprintf(#kbv_v, "1:%.2f", kb_TEX[slider10 | 0]) : sprintf(#kbv_v, "%g:1", kb_TRA[slider10 | 0]);
  kb_name(x + 185, 230, a, "RATIO", #kbv_v);
  // REF, ATTACK, RECOVERY
  sprintf(#kbv_v, "%+.1f dBu", slider8); kb_small(x + 45, 294, 16, 8, -8, 15, 6, 0xC7BEB3, 11, "REF", #kbv_v);
  kbv_stp = 1;
  kbv_t = kb_TAT[slider11 | 0]; kbv_t < 1 ? sprintf(#kbv_v, "%.1f ms", kbv_t) : sprintf(#kbv_v, "%d ms", kbv_t);
  kb_small(x + 125, 294, 16, 11, 0, 6, 3, 0x9DA2A8, 7, "ATTACK", #kbv_v);
  (slider12 | 0) == 0 ? strcpy(#kbv_v, "AUTO") : sprintf(#kbv_v, "%g s", kb_TRC[slider12 | 0]);
  kb_small(x + 205, 294, 16, 12, 0, 5, 0, 0x9DA2A8, 6, "RECOVERY", #kbv_v);
  kbv_stp = 0;
  // HOLD and the lamps
  slider13 >= 55 ? strcpy(#kbv_v, "OFF") : sprintf(#kbv_v, "-%.0f dB", slider13);
  kb_small(x + 45, 370, 14, 13, 10, 60, 60, 0x9DA2A8, 6, "HOLD", #kbv_v);
  kb_lamp(x + 140, 366, kbm_hold > 0, KBA); gfx_setfont(13); ui_col(KBI2); kb_ctxt(x + 140, 384, "HOLD");
  kb_lamp(x + 205, 366, (slider12 | 0) == 0, 0x46D86A); ui_col(KBI2); kb_ctxt(x + 205, 384, "AUTO");
  slider26 < 0.5 ? ( kb_off(x, kbv_y, 250, kbv_h); kb_ck(x + 104, 92, 38, 26, "IN", 0) ? ( slider26 = 1; ui_auto(26); ); );
);
slider23 >= 0.5 ? ( kb_draw_dyn(124); kb_draw_eq(380); ) : ( kb_draw_eq(124); kb_draw_dyn(280); );

// ---------- GAIN meter (x 536, w 96) ----------
kb_sect(536, kbv_y, 96, kbv_h, KBF, "GAIN");
kb_window(546, 98, 76, 280);
kbv_mt = 106; kbv_mh = 256;
kb_gbar(578, kbv_mt, 14, kbv_mh, kbm_g0); kb_gbar(598, kbv_mt, 14, kbv_mh, kbm_g1);
gfx_setfont(13); kbv_i = 0;
loop(8,
  kbv_d = 8 - kbv_i * 4;
  kbv_yy = kbv_mt + (8 - kbv_d) / 28 * kbv_mh;
  ui_col(kbv_d == 0 ? KBA : KBI2); sprintf(#kbv_tl, kbv_d > 0 ? "+%d" : "%d", kbv_d); kb_rtxt(572, kbv_yy, #kbv_tl);
  kbv_i += 1;
);
ui_col(KBI2); kb_ctxt(585, 370, "L"); kb_ctxt(605, 370, "R"); kb_ctxt(584, 392, "dB");

// ---------- GATE (x 638, w 130) ----------
kb_sect(638, kbv_y, 130, kbv_h, KBF, "GATE");
kb_lamp(750, 86, kbm_gate > 0, 0x46D86A);
slider14 <= -50.5 ? strcpy(#kbv_v, "OFF") : sprintf(#kbv_v, "%.0f dBu", slider14);
kb_small(703, 152, 22, 14, -55, 0, -55, 0xD8D2C4, 11, "LEVEL", #kbv_v);
sprintf(#kbv_v, "-%.0f dB", slider15); kb_small(703, 252, 18, 15, 0, 20, 12, 0x9DA2A8, 11, "ATTEN", #kbv_v);
gfx_setfont(13); ui_col(KBI2); kb_ctxt(703, 316, "RECOVERY");
kb_kc = LK_BLU; kb_key(644, 330, 40, 26, "S", (slider16 | 0) == 0) ? ( slider16 = 0; ui_auto(16); );
kb_kc = LK_BLU; kb_key(686, 330, 38, 26, "M",    (slider16 | 0) == 1) ? ( slider16 = 1; ui_auto(16); );
kb_kc = LK_BLU; kb_key(726, 330, 38, 26, "F", (slider16 | 0) == 2) ? ( slider16 = 2; ui_auto(16); );

// ---------- LIMITER (x 774, w 110) ----------
kb_sect(774, kbv_y, 110, kbv_h, KBF, "LIMITER");
kb_lamp(866, 86, kbm_lim > 0, 0xFF3A2A);
kb_kc = LK_AMB; kb_key(784, 102, 44, 24, "IN", slider17 >= 0.5) ? ( slider17 = slider17 >= 0.5 ? 0 : 1; ui_auto(17); );
kb_scale(829, 192, 26, 6, 17, "0|3|6|9|12|15", 1);
kbv_a = kb_knob(829, 192, 26, 18, 0, 15, 10);
sprintf(#kbv_v, "+%.1f dBu", slider18); kb_name(829, 236, kbv_a, "LEVEL", #kbv_v);
kb_kc = LK_YEL; kb_key(784, 268, 90, 26, "PRE-EMPH", slider19 >= 0.5) ? ( slider19 = slider19 >= 0.5 ? 0 : 1; ui_auto(19); );
gfx_setfont(13); ui_col(KBI2); kb_ctxt(829, 306, "50 µs");
kb_ctxt(829, 352, "LOG CLIP"); kb_ctxt(829, 368, "1.5 ms");
slider17 < 0.5 ? ( kb_off(774, kbv_y, 110, kbv_h); kb_kc = LK_AMB; kb_key(784, 102, 44, 24, "IN", 0) ? ( slider17 = 1; ui_auto(17); ); );

// ---------- OUTPUT (x 890, w 168) ----------
kb_sect(890, kbv_y, 168, kbv_h, KBF, "OUTPUT");
kb_scale(952, 170, 28, 5, 19, "-12|-6|0|+6|+12", 2);
kbv_a = kb_knob(952, 170, 28, 20, -12, 12, 0);
sprintf(#kbv_v, "%+.1f dB", slider20); kb_name(952, 216, kbv_a, "LEVEL", #kbv_v);
sprintf(#kbv_v, "%.0f%%", slider21); kb_small(940, 280, 16, 21, 0, 100, 50, 0x9DA2A8, 11, "DRIFT", #kbv_v);
kbv_on = kb_heat < 1 ? floor(time_precise() * 5) % 2 == 0 : kb_hton;
kb_lamp(1012, 274, kbv_on, KBA); gfx_setfont(13); ui_col(KBI2); kb_ctxt(1012, 296, kb_heat < 1 ? "WARMING" : "OVEN");
kb_big(904, 336, 140, 54, "BYPASS", slider24 >= 0.5) ? ( slider24 = slider24 >= 0.5 ? 0 : 1; ui_auto(24); );

// corner rivets last: they sit on the rim
kb_rivet(6.5, 6.5); kb_rivet(1073.5, 6.5); kb_rivet(6.5, 425.5); kb_rivet(1073.5, 425.5);

pk_end();
ui_end();
