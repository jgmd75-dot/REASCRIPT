desc:DUK34 [tempo-synced ducking compressor] (GFX)
//tags: ducker ducking sidechain compressor pump pumping tempo sync volume shaper voice-over midi
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-input, gfx-output, gfx-drift, gfx-ui and gfx-panel (.jsfx-inc) in the same folder.
//
// DUK34. A ducking compressor whose ATTACK, HOLD and RELEASE can be set in note values, locked to the project tempo,
// so the duck recovers exactly on the beat (the sound is designed from scratch). Three ways to trigger it:
//   SIDECHAIN  the key on inputs 3 / 4 (a kick, a voice): THRESHOLD, RATIO (soft 6 dB knee), SC HPF. The deeper the
//              key goes over the threshold, the deeper the duck, never more than DEPTH.
//   MIDI       a MIDI note (any note, any channel): the velocity sets the depth (127 = DEPTH), and the duck stays down
//              while the note is held, then HOLD and RELEASE.
//   GRID       the tempo grid itself, no routing: a duck on every 1/1, 1/2, 1/4, 1/8 or 1/16 (OFF-BEAT moves it half a
//              step). Worked out from the beat position, so it never drifts: ATTACK starts before the step so the gain
//              is fully down exactly on it. Runs at the project tempo while stopped.
//   SYNC       on: ATTACK (FAST, 1/128 .. 1/16), HOLD (0, 1/64 .. 1/4) and RELEASE (1/32 .. 2 bars) in note values,
//              with FEEL straight, dotted (x 1.5) or triplet (x 2/3); off: in ms (0 - 100, 0 - 1000, 10 - 4000).
//              RELEASE is the time from full depth back to 0 dB, whatever the depth.
//   DEPTH      0 - 40 dB. CURVE: the release's shape - LINEAR (in dB), FAST (most of the way back at once, then a
//              tail), SLOW (stays down, then snaps back: the hard pump), S-CURVE (eases out and in).
//   FOCUS      what is ducked: FULL, LOWS (below XOVER, 40 - 400 Hz, Linkwitz-Riley 24 dB/oct; the highs untouched),
//              MID or SIDE. LOOKAHEAD 0 - 10 ms (SIDECHAIN and MIDI: the audio is delayed and reported as latency, so
//              the duck is already down when the hit arrives). MIX (parallel), OUTPUT -12 .. +12 dB.
//   The house output stage passes straight through (a mix tool: no clip). Every change glides; IN fades (10 ms).
//   DRIFT      (0 - 100 %, 50 % = standard): the VCA's control voltage wanders - the depth by a few tenths of a dB.
//              The timing never drifts.
//   (one look since Oct 2026: charcoal and pale green; the old VFD / MATRIX look switch is kept only as a hidden parameter)
//   PRESETS    12 (Init + 11) plus Reset all to defaults. A preset sets everything but OUTPUT, DRIFT and the look.

slider1:1<0,1,1{Out,In}>-In
slider2:0<0,2,1{Sidechain,MIDI,Grid}>-Trigger
slider3:2<0,4,1{1/1,1/2,1/4,1/8,1/16}>-Grid
slider4:0<0,1,1{On beat,Off beat}>-Grid offset
slider5:-24<-60,0,0.1>-Threshold (dBFS)
slider6:4<1.5,20,0.1>-Ratio
slider7:12<0,40,0.1>-Depth (dB)
slider8:1<0,1,1{Off (ms),On (notes)}>-Sync
slider9:0<0,2,1{Straight,Dotted,Triplet}>-Feel
slider10:0<0,4,1{Fast,1/128,1/64,1/32,1/16}>-Attack (synced)
slider11:0<0,5,1{0,1/64,1/32,1/16,1/8,1/4}>-Hold (synced)
slider12:2<0,6,1{1/32,1/16,1/8,1/4,1/2,1/1,2/1}>-Release (synced)
slider13:1<0,100,0.1>-Attack (ms)
slider14:0<0,1000,1>-Hold (ms)
slider15:250<10,4000,1>-Release (ms)
slider16:0<0,3,1{Linear,Fast,Slow,S-curve}>-Curve
slider17:0<0,10,0.1>-Lookahead (ms)
slider18:0<0,3,1{Full,Lows,Mid,Side}>-Focus
slider19:150<40,400,1>-Crossover (Hz)
slider20:0<0,4,1{Off,60 Hz,100 Hz,150 Hz,250 Hz}>-SC HPF
slider21:100<0,100,1>-Mix (%)
slider22:0<-12,12,0.1>-Output (dB)
slider23:50<0,100,1>-Drift (%)
slider24:0<0,1,1{VFD,Matrix}>-Look
slider25:prs_sel=0<0,12,1{No preset,Init,Kick Ducks Bass,Classic Pump,Half-Time Pump,Triplet Pump,Sixteenth Chop,Off-Beat Breath,MIDI Pump,Side Pump,Gentle Glue Pump,Voice-Over Duck,Podcast Music Bed}>-Preset

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-drift.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc

@init
#ui_man = "gfx-duk34";                                // the ? pop-up links to this manual
ext_noinit = 1;

function dk_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function dk_sm(g) ( g * g * (3 - 2 * g); );
// note values (in quarter-note beats) for the synced times
function dk_attn(i) ( i == 0 ? 0 : i == 1 ? 4 / 128 : i == 2 ? 4 / 64 : i == 3 ? 4 / 32 : 4 / 16; );
function dk_hldn(i) ( i == 0 ? 0 : i == 1 ? 4 / 64 : i == 2 ? 4 / 32 : i == 3 ? 4 / 16 : i == 4 ? 4 / 8 : 1; );
function dk_reln(i) ( i == 0 ? 4 / 32 : i == 1 ? 4 / 16 : i == 2 ? 4 / 8 : i == 3 ? 1 : i == 4 ? 2 : i == 5 ? 4 : 8; );
function dk_grid(i) ( i == 0 ? 4 : i == 1 ? 2 : i == 2 ? 1 : i == 3 ? 0.5 : 0.25; );
function dk_hpf(i) ( i == 1 ? 60 : i == 2 ? 100 : i == 3 ? 150 : 250; );
// the release's shape: x = how far through the release (0 .. 1) -> how much of the duck is left (1 .. 0)
function dk_shape(x, c) ( x = min(max(x, 0), 1);
  c == 0 ? 1 - x : c == 1 ? (1 - x) * (1 - x) * (1 - x) : c == 2 ? 1 - x * x * x : 1 - x * x * (3 - 2 * x); );

// biquads: coefficients at o (b0 b1 b2 a1 a2)
function dk_lp(o, f, q) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function dk_hp(o, f, q) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function dk_bq(x, o) instance(s1, s2) local(y) ( y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y; );
CLP = 100; CHP = 110; CSC = 120;                      // crossover low / high (Butterworth, run twice = LR4), SC high-pass

// memory: the lookahead delay (L / R) and the panel's gain trace
DLL = 1000; DLR = 4000; DLN = 2900;                   // up to 10 ms at 192 kHz (+ room)
TRC = 8000; TRN = 192;                                // the trace: one column per 1/96 of two beats
MQ = 9000;                                            // MIDI queue: offset, type (1 on / 0 off), velocity (3 x 128)

// ---------- presets ----------
#dk_pm = "Init|Kick Ducks Bass|Classic Pump|Half-Time Pump|Triplet Pump|Sixteenth Chop|Off-Beat Breath|MIDI Pump|Side Pump|Gentle Glue Pump|Voice-Over Duck|Podcast Music Bed";
//                trg grid off  thr  rat  dep  sync feel att hld rel  ams  hms  rms  crv  la  foc  xo  sch  mix
function dk_set(tg, gd, of, th, ra, dp, sy, fe, at, hd, rl, am, hm, rm, cv, la, fo, xo, sh, mx) (
  slider1 = 1; slider2 = tg; slider3 = gd; slider4 = of; slider5 = th; slider6 = ra; slider7 = dp; slider8 = sy; slider9 = fe;
  slider10 = at; slider11 = hd; slider12 = rl; slider13 = am; slider14 = hm; slider15 = rm; slider16 = cv; slider17 = la;
  slider18 = fo; slider19 = xo; slider20 = sh; slider21 = mx;
);
function load_preset(p) local(i) (
  p == 1  ? dk_set(0, 2, 0, -24, 4,  12, 1, 0, 0, 0, 2, 1,  0,   250,  0, 0, 0, 150, 0, 100) :   // Init
  p == 2  ? dk_set(0, 2, 0, -30, 10, 9,  1, 0, 0, 0, 2, 1,  0,   250,  1, 2, 1, 150, 1, 100) :   // Kick Ducks Bass
  p == 3  ? dk_set(2, 2, 0, -24, 4,  18, 1, 0, 0, 0, 3, 1,  0,   250,  3, 0, 0, 150, 0, 100) :   // Classic Pump
  p == 4  ? dk_set(2, 1, 0, -24, 4,  15, 1, 0, 0, 0, 4, 1,  0,   250,  3, 0, 0, 150, 0, 100) :   // Half-Time Pump
  p == 5  ? dk_set(2, 3, 0, -24, 4,  12, 1, 2, 0, 0, 2, 1,  0,   250,  0, 0, 0, 150, 0, 100) :   // Triplet Pump
  p == 6  ? dk_set(2, 4, 0, -24, 4,  24, 1, 0, 0, 0, 0, 1,  0,   250,  2, 0, 0, 150, 0, 100) :   // Sixteenth Chop
  p == 7  ? dk_set(2, 2, 1, -24, 4,  6,  1, 0, 2, 0, 2, 1,  0,   250,  3, 0, 0, 150, 0, 100) :   // Off-Beat Breath
  p == 8  ? dk_set(1, 2, 0, -24, 4,  15, 1, 1, 0, 0, 2, 1,  0,   250,  3, 0, 0, 150, 0, 100) :   // MIDI Pump
  p == 9  ? dk_set(0, 2, 0, -30, 6,  8,  1, 0, 0, 0, 3, 1,  0,   250,  0, 0, 3, 150, 1, 100) :   // Side Pump
  p == 10 ? dk_set(0, 2, 0, -24, 2,  4,  1, 0, 1, 0, 3, 1,  0,   250,  0, 0, 0, 150, 0, 100) :   // Gentle Glue Pump
  p == 11 ? dk_set(0, 2, 0, -40, 2,  10, 0, 0, 0, 0, 2, 20, 300, 800,  0, 5, 0, 150, 3, 100) :   // Voice-Over Duck
  p == 12 ? dk_set(0, 2, 0, -42, 3,  15, 0, 0, 0, 0, 2, 40, 600, 1500, 3, 5, 0, 150, 3, 100) :   // Podcast Music Bed
  p == 13 ? ( dk_set(0, 2, 0, -24, 4, 12, 1, 0, 0, 0, 2, 1, 0, 250, 0, 0, 0, 150, 0, 100); slider22 = 0; slider23 = 50; slider24 = 0; );
  i = 1; loop(24, ui_auto(i); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

// ---------- state ----------
function dk_srinit() (
  dk_sr = srate;
  dk_kd = 1 - exp(-1 / (0.001 * srate));              // the detector: 1 ms
  dk_kg = 1 - exp(-1 / (0.0003 * srate));             // the final gain: 0.3 ms (no clicks, however fast)
  dk_fst = 1 / (0.01 * srate);                        // IN: 10 ms
  dk_gsm = 1 - exp(-1 / (0.02 * srate));              // knob glides
  dk_xoi = -1; dk_sci = -1;
  memset(DLL, 0, DLN); memset(DLR, 0, DLN); dk_dw = 0;
  ost_init(0);
);
dk_srinit();
in_init();
dV.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
dk_snap = 1; dk_cur = 0; dk_ph = 1; dk_hc = 0; dk_r0 = 0; dk_free = 0; dk_nh = 0; dk_vel = 1;
memset(TRC, 0, TRN);

ui_thm = 5; ui_hw = 1;                                // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );                // new instances open in Medium, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@block
prs_chk();
srate != dk_sr ? dk_srinit();
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);                // the house output stage: straight through (a mix tool)
drift_macro(slider23);
dk_vv = dV.drift_tick(0.05 * dm_s * samplesblock / srate);
dk_tI = slider1 >= 0.5;
dk_trg = floor(min(max(slider2, 0), 2) + 0.5);
dk_tmp = max(tempo, 20);
dk_spb = 60 / dk_tmp * srate;                         // samples per beat
dk_fl = slider9 < 0.5 ? 1 : slider9 < 1.5 ? 1.5 : 2 / 3;
slider8 >= 0.5 ? (
  dk_A = dk_attn(floor(slider10 + 0.5)) * dk_fl * dk_spb; floor(slider10 + 0.5) == 0 ? dk_A = 0.0005 * srate;
  dk_H = dk_hldn(floor(slider11 + 0.5)) * dk_fl * dk_spb;
  dk_R = dk_reln(floor(slider12 + 0.5)) * dk_fl * dk_spb;
) : (
  dk_A = max(slider13, 0.5) * 0.001 * srate; dk_H = slider14 * 0.001 * srate; dk_R = max(slider15, 10) * 0.001 * srate;
);
dk_A = max(dk_A, 1); dk_R = max(dk_R, 1);
dk_cv = floor(min(max(slider16, 0), 3) + 0.5);
dk_Dt = min(max(slider7, 0), 40) * (1 + 0.015 * dm_a * dk_vv);   // the control voltage wanders a little
dk_th = slider5; dk_sl = 1 - 1 / max(slider6, 1);
dk_foc = floor(min(max(slider18, 0), 3) + 0.5);
xoi = floor(slider19 + 0.5); xoi != dk_xoi ? ( dk_xoi = xoi; dk_lp(CLP, xoi, 0.70710678); dk_hp(CHP, xoi, 0.70710678); );
sci = floor(min(max(slider20, 0), 4) + 0.5); sci != dk_sci ? ( dk_sci = sci; sci > 0 ? dk_hp(CSC, dk_hpf(sci), 0.70710678); );
dk_la = dk_trg == 2 ? 0 : floor(min(max(slider17, 0), 10) * 0.001 * srate + 0.5);
dk_la = min(dk_la, DLN - 4);
pdc_delay = dk_la; pdc_bot_ch = 0; pdc_top_ch = 2;
dk_mxt = min(max(slider21, 0), 100) / 100;
dk_ott = 10 ^ (min(max(slider22, -12), 12) / 20);
// the beat clock: the transport's position, or (stopped) a free clock at the project tempo
dk_bps = dk_tmp / 60 / srate;
(play_state & 1) ? dk_bp0 = beat_position : ( dk_bp0 = dk_free; );
dk_free = (play_state & 1) ? beat_position + samplesblock * dk_bps : dk_free + samplesblock * dk_bps;
dk_S = dk_grid(floor(min(max(slider3, 0), 4) + 0.5)); dk_off = slider4 >= 0.5 ? dk_S * 0.5 : 0;
dk_P = dk_S * dk_spb;
dk_snap ? ( dk_gI = dk_tI; dk_D = dk_Dt; dk_mxs = dk_mxt; dk_ots = dk_ott; );
dk_snap = 0;
// MIDI: notes into the queue (in MIDI mode), everything passes through
dk_qn = 0; dk_qr = 0;
while (midirecv(mofs, m1, m2, m3)) (
  midisend(mofs, m1, m2, m3);
  st = m1 & 0xF0;
  dk_trg == 1 && (st == 0x90 || st == 0x80) && dk_qn < 128 ? (
    MQ[dk_qn * 3] = mofs; MQ[dk_qn * 3 + 1] = st == 0x90 && m3 > 0; MQ[dk_qn * 3 + 2] = m3 / 127; dk_qn += 1;
  );
  st == 0xB0 && (m2 == 123 || m2 == 120) ? dk_nh = 0;
);
dk_n = 0;
// the panel's mailboxes
dka_gr = min(dka_gr, dk_grm); dk_grm = 0;
dka_ol = max(dka_ol, dk_ol); dka_or = max(dka_or, dk_or); dk_ol = dk_or = 0;
dka_kl = max(dka_kl, dk_kl); dk_kl = 0;
dk_cur = dk_tn(dk_cur); dk_g = dk_tn(dk_g); dk_ms = dk_tn(dk_ms);

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0; spl2 != spl2 ? spl2 = 0; spl3 != spl3 ? spl3 = 0;
in_process(spl0, spl1);
dk_xl = in_l; dk_xr = in_r;
dk_gI != dk_tI ? ( dk_gI = dk_tI ? min(dk_gI + dk_fst, 1) : max(dk_gI - dk_fst, 0); );
dk_D += (dk_Dt - dk_D) * dk_gsm; dk_mxs += (dk_mxt - dk_mxs) * dk_gsm; dk_ots += (dk_ott - dk_ots) * dk_gsm;
dk_bp = dk_bp0 + dk_n * dk_bps;

dk_trg == 2 ? (
  // ---------- GRID: the gain as a function of where we are in the step (never drifts) ----------
  dk_t = (dk_bp - dk_off) / dk_S; dk_t = (dk_t - floor(dk_t)) * dk_P;          // samples since the step
  dk_e = dk_t < dk_H ? 1 : dk_shape((dk_t - dk_H) / dk_R, dk_cv);
  dk_t >= dk_P - dk_A ? dk_e = max(dk_e, (dk_t - (dk_P - dk_A)) / dk_A);      // the attack, ahead of the step
  dk_tgt = -dk_D * dk_e; dk_cur = dk_tgt;
) : (
  // ---------- SIDECHAIN / MIDI: a target, then attack - hold - release ----------
  dk_trg == 0 ? (
    dk_ka = spl2; dk_kb = spl3;
    dk_sci > 0 ? ( dk_ka = sca.dk_bq(dk_ka, CSC); dk_kb = scb.dk_bq(dk_kb, CSC); );
    dk_lv = max(abs(dk_ka), abs(dk_kb));
    dk_ms += (dk_lv > dk_ms ? 1 : dk_kd) * (dk_lv - dk_ms);                     // instant up, 1 ms down
    dk_kl = max(dk_kl, dk_lv);
    dk_ov = 20 * log10(max(dk_ms, 0.0000001)) - dk_th;
    dk_ov = dk_ov <= -3 ? 0 : dk_ov >= 3 ? dk_ov : sqr(dk_ov + 3) / 12;           // a 6 dB soft knee
    dk_tgt = -min(dk_ov * dk_sl, dk_D);
  ) : (
    while (dk_qr < dk_qn && MQ[dk_qr * 3] <= dk_n) (
      MQ[dk_qr * 3 + 1] ? ( dk_nh += 1; dk_vel = MQ[dk_qr * 3 + 2]; ) : dk_nh = max(dk_nh - 1, 0);
      dk_qr += 1;
    );
    dk_tgt = dk_nh > 0 ? -dk_D * dk_vel : 0;
    dk_kl = max(dk_kl, dk_nh > 0 ? dk_vel : 0);
  );
  dk_tgt < dk_cur - 0.001 ? (                                                    // deeper: attack (and re-arm the hold)
    dk_cur = max(dk_cur - max(dk_D, 6) / dk_A, dk_tgt); dk_ph = 0; dk_hc = dk_H; dk_r0 = dk_cur;
  ) : dk_hc > 0 ? (                                                              // hold
    dk_hc -= 1; dk_r0 = dk_cur; dk_ph = 0;
  ) : (                                                                          // release: from any depth to 0 dB in RELEASE
    dk_ph = min(dk_ph + 1 / dk_R, 1);
    dk_rv = dk_r0 * dk_shape(dk_ph, dk_cv);
    dk_rv < dk_tgt ? dk_cur = dk_rv : ( dk_cur = dk_tgt; dk_r0 = dk_cur; dk_ph = 0; );   // (still keyed: sit at the target)
  );
);
dk_n += 1;
dk_g += dk_kg * (dk_cur * dk_gI - dk_g);
dk_grm = min(dk_grm, dk_g);
// the panel's trace: the gain against two beats
dk_col = floor((dk_bp - 2 * floor(dk_bp / 2)) / 2 * TRN); dk_col = min(max(dk_col, 0), TRN - 1);
dk_col != dk_lcol ? ( TRC[dk_col] = dk_g; dk_lcol = dk_col; ) : TRC[dk_col] = min(TRC[dk_col], dk_g);

// the lookahead delay (the duck runs ahead of the audio by LOOKAHEAD)
DLL[dk_dw] = dk_xl; DLR[dk_dw] = dk_xr;
dk_rd = dk_dw - dk_la; dk_rd < 0 ? dk_rd += DLN;
dk_al = DLL[dk_rd]; dk_ar = DLR[dk_rd];
dk_dw += 1; dk_dw >= DLN ? dk_dw = 0;

// the VCA on the chosen focus
dk_lg = exp(0.115129255 * dk_g);
// the crossover runs all the time (warm when switched): LR4 lows and highs
dk_lo_l = ll2.dk_bq(ll1.dk_bq(dk_al, CLP), CLP); dk_hi_l = hl2.dk_bq(hl1.dk_bq(dk_al, CHP), CHP);
dk_lo_r = lr2.dk_bq(lr1.dk_bq(dk_ar, CLP), CLP); dk_hi_r = hr2.dk_bq(hr1.dk_bq(dk_ar, CHP), CHP);
dk_foc == 0 ? ( dk_yl = dk_al * dk_lg; dk_yr = dk_ar * dk_lg; ) :
dk_foc == 1 ? ( dk_al = dk_lo_l + dk_hi_l; dk_ar = dk_lo_r + dk_hi_r;                  // (LR4: lows + highs sum flat)
                dk_yl = dk_hi_l + dk_lg * dk_lo_l; dk_yr = dk_hi_r + dk_lg * dk_lo_r; ) :
( dk_m = 0.5 * (dk_al + dk_ar); dk_sd = 0.5 * (dk_al - dk_ar);
  dk_foc == 2 ? dk_m *= dk_lg : dk_sd *= dk_lg;
  dk_yl = dk_m + dk_sd; dk_yr = dk_m - dk_sd; );
dk_yl = dk_al + dk_mxs * (dk_yl - dk_al); dk_yr = dk_ar + dk_mxs * (dk_yr - dk_ar);
dk_yl *= dk_ots; dk_yr *= dk_ots;
dk_yl != dk_yl ? dk_yl = 0; dk_yr != dk_yr ? dk_yr = 0;
ost_out(dk_yl, dk_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
dk_ol = max(dk_ol, abs(spl0)); dk_or = max(dk_or, abs(spl1));

@gfx 1080 430
// version tag (JG, 29 Oct 2026): v1 = Legacy, v2 = Stable, v3 = the next graduation; a small dim tag just after the
// panel title. ver_tag_at draws it at x with its baseline at yb, fs px high, in col (or the current colour if col < 0),
// at 55 %; ver_tag puts it after text just drawn (dx, dy: extra offset in that text's heights). Font, colour and
// gfx_x / gfx_y are left as they were.
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
function ver_tag(s, slot, dx, dy) local(th) (
  th = gfx_texth;
  ver_tag_at(s, slot, gfx_x + (0.3 + dx) * th, gfx_y + (0.8 + dy) * th, 0.5 * th, -1);
);
ui_begin(1080, 430);
// =====================================================================
// GUI - in the 34 series manner: sharp-cornered sections, black bakelite knobs with printed scales (the synced ones
// click between note values), rivets in the corners, and a trace of the gain against two beats. One look:
// charcoal and pale green. Design space 1080 x 430.
// =====================================================================
dv_mx = 0;                                                // one look (VFD); slider24 kept so old projects load
!dv_mx ? (                                                // VFD: charcoal and pale green
  KRP = 0x2E2F31; KRF = 0x202123; KRI = 0xE4EEDB; KRA = 0xCDEBCB; KRW = 0x121314; KRM = 0x55575A;
  KRC = 0xCDEBCB; KRPT = 0x14200A; KRCN = 0x7FD04B; KRGH = 0x262B22; KRAMB = 0xFFD24A; KRRED = 0xFF3B1F; KRKT = 0x14200A;
) : (                                                     // MATRIX: battleship grey and pale green
  KRP = 0x222528; KRF = ui_mix(0x222528, 0x000000, 0.25); KRI = 0xC7CCC2; KRA = 0xCDEBCB; KRW = ui_mix(0x222528, 0x000000, 0.45);
  KRM = 0x4A4E4A; KRC = 0xCDEBCB; KRPT = 0x17191B; KRCN = 0x1E5631; KRGH = 0x2C302E; KRAMB = 0xD4A373; KRRED = 0xBC3908; KRKT = 0x17191B;
);
KRH = ui_mix(KRP, 0x000000, 0.35); KRI2 = ui_mix(KRI, KRF, 0.35);

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');
gfx_setfont(10, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(14, "Trebuchet MS", 15 * sc, 'b');
gfx_setfont(15, "Trebuchet MS", 12 * sc, 'b');     // lamp key legends

function kr_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kr_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function kr_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_lbl(x, y, s) ( gfx_setfont(11); ui_col(KRI2); kr_txt(x, y, s); );
function kr_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function kr_thick(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, k) (       // (drawn here: works with any system files)
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l; ny = dx / l;
  k = -0.5 * w; loop(floor(w * 2.5) + 1, gfx_line(x1 + nx * k, y1 + ny * k, x2 + nx * k, y2 + ny * k, 1); k += 0.4; );
);
// panel keys: house lamp keys (gfx-ui). kr_kc = the key's lamp colour (set before the call; cleared after;
// none = the face's accent colour)
function kr_key(x, y, w, h, lbl, on) local(c) (
  c = kr_kc ? kr_kc : KRA; kr_kc = 0;
  lk_well = 0x0A0A0B; lk_font = 15; lk_font2 = 15;
  lk_fit(x, y, w, h, on, c, lbl);
);
// a section that's switched off: greyed slightly (its IN key is redrawn on top)
function kr_off(x, y, w, h) ( ui_cola(KRF, 0.5); kr_r(x + 1, y + 1, w - 2, h - 2); );
// a key that isn't live: an unlit lamp key, dimmed
function kr_dim(x, y, w, h, lbl) local(c) (
  c = kr_kc ? kr_kc : KRA; kr_kc = 0;
  lk_well = 0x0A0A0B; lk_font = 15; lk_font2 = 15; lk_inert = 1;
  lk_fit(x, y, w, h, 0, c, lbl);
  ui_cola(KRF, 0.55); kr_r(x, y, w, h); 0;
);
function kr_sect(x, y, w, h, name) (
  ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRF); kr_r(x + 1, y + 1, w - 2, h - 2);
  strlen(name) ? kr_lbl(x + 9, y + 6, name);
);
function kr_scale(cx, cy, r, n, nr, labels, minor) local(i, k, k0, len, c, a, ca, sa, m) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  minor > 0 ? (
    m = 0; ui_col(KRI2);
    loop((n - 1) * minor + 1,
      a = -0.75 * $pi + m / ((n - 1) * minor) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 6)) * sc, (cy + sa * (r + 6)) * sc, 1);
      m += 1;
    );
  );
  gfx_setfont(10);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#krv_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      ui_col(KRI);
      gfx_line((cx + ca * (r + 3)) * sc, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 7)) * sc, (cy + sa * (r + 7)) * sc, 1);
      strlen(#krv_sl) ? kr_ctxt(cx + ca * (r + nr), cy + sa * (r + nr), #krv_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
function kr_bake(cx, cy, r, a) local(i, t, ca, sa, k) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.55); gfx_circle(cx + 2.5 * sc, cy + 4.5 * sc, r * 1.02, 1, 1);
  ui_col(0x0A0A0A); gfx_circle(cx, cy, r + 1 * sc, 1, 1);
  ui_col(0x191817); gfx_circle(cx, cy, r, 1, 1);
  i = 0;
  loop(16,
    t = i / 16 * 2 * $pi; k = 0.5 + 0.5 * cos(t + 0.8);
    ui_col(ui_mix(0x0D0C0B, 0x48443F, k * 0.8)); gfx_circle(cx + sin(t) * r * 0.86, cy - cos(t) * r * 0.86, r * 0.15, 1, 1);
    ui_col(0x0D0C0B); gfx_circle(cx + sin(t + 0.196) * r * 0.9, cy - cos(t + 0.196) * r * 0.9, r * 0.075, 1, 1);
    i += 1;
  );
  ui_col(0x090808); gfx_circle(cx, cy, r * 0.70 + 1 * sc, 1, 1);
  ui_col(0x22201E); gfx_circle(cx, cy, r * 0.70, 1, 1);
  ui_cola(0xFFFFFF, 0.08); gfx_circle(cx, cy, r * 0.70, 0, 1);
  ui_col(0x060606); kr_thick(cx + ca * r * 0.18, cy + sa * r * 0.18, cx + ca * r * 0.98, cy + sa * r * 0.98, 4.2 * sc);
  ui_col(KRA); kr_thick(cx + ca * r * 0.22, cy + sa * r * 0.22, cx + ca * r * 0.95, cy + sa * r * 0.95, 2.5 * sc);
);
function kr_scap(cx, cy, r, a, cap) local(ca, sa, k, pc) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(0x121212); gfx_circle(cx, cy, r, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx, cy, r, 0, 1);
  k = r * 0.74;
  ui_col(cap); gfx_circle(cx, cy, k, 1, 1);
  ui_col(ui_mix(cap, 0x000000, 0.35)); gfx_circle(cx, cy, k, 0, 1);
  pc = (cap & 255) + ((cap >> 8) & 255) + ((cap >> 16) & 255) > 380 ? KRPT : 0xF4F0E6;
  ui_col(pc); kr_thick(cx + ca * k * 0.2, cy + sa * k * 0.2, cx + ca * r * 0.94, cy + sa * r * 0.94, 2.6 * sc);
);
krv_small = 0; krv_lg = 0; krv_step = 0; krv_cap = 0;
function kr_kn(v, lo, hi) ( krv_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function kr_kv(n, lo, hi) ( krv_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function kr_knob(cx, cy, r, idx, lo, hi, def) local(v, n, dx, dy, hov, did) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - krv_lt < 0.35 && krv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; krv_lt = 0; ) : (
      drag_id = did; krv_y = mouse_y; krv_lt = time_precise(); krv_lid = idx; krv_n = kr_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    krv_n = min(max(krv_n + (krv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : (krv_step ? 160 : 240)) * sc), 0), 1); krv_y = mouse_y;
    v = kr_kv(krv_n, lo, hi); krv_step ? v = floor(v + 0.5);
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    krv_step ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(kr_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
      slider(idx) = kr_kv(n, lo, hi);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(kr_kn(v, lo, hi), 0), 1);
  krv_small ? kr_scap(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi, krv_cap ? krv_cap : KRC) : kr_bake(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi);
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  hov || drag_id == did;
);
function kr_name(cx, cy, act, name, val) ( gfx_setfont(14); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy, act ? val : name); );
// a small knob with a tick ring (or n step ticks) and its name; the value while touched
function kr_small(cx, cy, r, idx, lo, hi, def, nt, name, val) local(i, t, act) (
  ui_cola(KRI, 0.85); i = 0;
  loop(nt, t = -0.75 * $pi + i / (nt - 1) * 1.5 * $pi;
    gfx_circle((cx + sin(t) * (r + 4 + r + 8) * 0.5) * sc, (cy - cos(t) * (r + 4 + r + 8) * 0.5) * sc, min(max(((r + 8) - (r + 4)) * 0.3, 1), 1.8) * sc, 1, 1); i += 1; );
  krv_small = 1; act = kr_knob(cx, cy, r, idx, lo, hi, def); krv_small = 0;
  strlen(name) ? ( gfx_setfont(11); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy + r + 15, act ? val : name); );
  act;
);
function kr_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? KRRED : zone == 1 ? KRAMB : KRCN;
  lit ? ( ui_cola(c, 0.16); kr_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); kr_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); kr_r(x, y, w, 1.5); )
      : ( ui_col(KRGH); kr_r(x, y, w, h); ui_cola(0x000000, 0.25); kr_r(x, y + h - 1, w, 1); );
);
function kr_hbar(x, y, w, h, v) local(n, i, sw, d) (
  n = 32; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; kr_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d, d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);
function kr_grbar(x, y, w, h, gr) local(n, i, sw, d) (                     // gain reduction: 0 .. -24 dB, from the left
  n = 24; sw = w / n; i = 0;
  loop(n, d = -(i + 0.5); kr_cell(x + i * sw + 0.5, y, sw - 2, h, gr <= d, 1); i += 1; );
);
function kr_window(x, y, w, h) ( ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRW); kr_r(x + 1, y + 1, w - 2, h - 2); );
function kr_db(v) ( sprintf(#krd, "%+.1f dB", v); #krd; );
function kr_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
function kr_fall(v, pk) ( pk = pk > 0.0000001 ? 20 * log10(pk) : -90; pk > v ? pk : max(v - 0.6, -90); );

function dv_rivet(cx, cy) local(c) (
  c = ui_mix(KRM, 0xFFFFFF, 0.25);
  ui_cola(0x000000, 0.45); gfx_circle((cx + 0.8) * sc, (cy + 1.2) * sc, 3.6 * sc, 1, 1);
  ui_col(ui_mix(c, 0x000000, 0.35)); gfx_circle(cx * sc, cy * sc, 3.6 * sc, 1, 1);
  ui_col(c); gfx_circle(cx * sc, cy * sc, 3 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.35); gfx_circle((cx - 0.9) * sc, (cy - 0.9) * sc, 1.1 * sc, 1, 1);
);
function dv_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function dv_ms(n) ( n < 1 ? sprintf(#dvm, "%.2f ms", n) : n < 100 ? sprintf(#dvm, "%.1f ms", n) : n < 1000 ? sprintf(#dvm, "%d ms", floor(n + 0.5)) : sprintf(#dvm, "%.2f s", n / 1000); #dvm; );
function dv_note(k, i) (                                  // a synced setting's name: k 0 attack, 1 hold, 2 release
  k == 0 ? ( i == 0 ? "FAST" : i == 1 ? "1/128" : i == 2 ? "1/64" : i == 3 ? "1/32" : "1/16" ) :
  k == 1 ? ( i == 0 ? "0" : i == 1 ? "1/64" : i == 2 ? "1/32" : i == 3 ? "1/16" : i == 4 ? "1/8" : "1/4" ) :
           ( i == 0 ? "1/32" : i == 1 ? "1/16" : i == 2 ? "1/8" : i == 3 ? "1/4" : i == 4 ? "1/2" : i == 5 ? "1 BAR" : "2 BARS" );
);
function dv_feel() ( slider9 < 0.5 ? "" : slider9 < 1.5 ? " DOT" : " TRIP"; );

// =====================================================================
// Faceplate and header
// =====================================================================
ui_col(ui_mix(KRP, 0x000000, 0.35)); gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0xFFFFFF, 0.08); kr_r(0, 0, 1080, 1.5); kr_r(0, 0, 1.5, 430);
ui_cola(0x000000, 0.35); kr_r(0, 428.5, 1080, 1.5); kr_r(1078.5, 0, 1.5, 430);
ui_col(KRP); kr_r(12, 12, 1056, 406);
ui_cola(0x000000, 0.30); kr_r(12, 12, 1056, 1.5); kr_r(12, 12, 1.5, 406);
ui_cola(0xFFFFFF, 0.07); kr_r(12, 416.5, 1056, 1.5); kr_r(1066.5, 12, 1.5, 406);
dv_rivet(6.5, 6.5); dv_rivet(1073.5, 6.5); dv_rivet(6.5, 423.5); dv_rivet(1073.5, 423.5);
ui_col(KRH); kr_r(13.5, 13.5, 1053, 50.5);
ui_col(KRA); kr_r(13.5, 64, 1053, 2);
ui_col(KRA); gfx_circle(45 * sc, 39 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(KRKT); ui_text(45 * sc, 33.5 * sc, "GFX");
gfx_setfont(6); ui_col(KRI); kr_txt(72, 24, "DUK34"); gfx_measurestr("DUK34", dv_tw, dv_th); ver_tag("v3", 16, 5.7, 0);
dv_tx = 72 + dv_tw / sc + 14;
gfx_setfont(11); ui_col(KRI2); kr_txt(dv_tx, 25, "TEMPO-SYNCED"); kr_txt(dv_tx, 40, "DUCKING COMPRESSOR");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(366 * sc, 22 * sc, 280 * sc, 34 * sc, pr_cur, #dk_pm);
k_ > 0 ? prs_dirty = k_;
ui_size_picker(1000 * sc, 30 * sc);

// =====================================================================
// TRIGGER
// =====================================================================
dv_tg = floor(min(max(slider2, 0), 2) + 0.5);
kr_sect(22, 72, 236, 338, "TRIGGER");
kr_kc = LK_YEL; kr_key(32, 98, 86, 28, "SIDECHAIN", dv_tg == 0) ? dv_set(2, 0);
kr_kc = LK_YEL; kr_key(124, 98, 60, 28, "MIDI", dv_tg == 1) ? dv_set(2, 1);
kr_kc = LK_YEL; kr_key(190, 98, 60, 28, "GRID", dv_tg == 2) ? dv_set(2, 2);
dv_tg == 0 ? (
  kr_scale(84, 196, 30, 4, 17, "-60|-40|-20|0", 2);
  dv_a = kr_knob(84, 196, 30, 5, -60, 0, -24); sprintf(#dvv, "%.1f dBFS", slider5); kr_name(84, 254, dv_a, "THRESHOLD", #dvv);
  kr_scale(196, 196, 30, 4, 17, "1.5|5|10|20", 2);
  dv_a = kr_knob(196, 196, 30, 6, 1.5, 20, 4); sprintf(#dvv, "%.1f : 1", slider6); kr_name(196, 254, dv_a, "RATIO", #dvv);
  krv_step = 1;
  kr_scale(84, 320, 22, 5, 15, "OFF|60|100|150|250", 0);
  dv_a = kr_knob(84, 320, 22, 20, 0, 4, 0); slider20 < 0.5 ? strcpy(#dvv, "OFF") : sprintf(#dvv, "%d Hz", dk_hpf(floor(slider20 + 0.5)));
  kr_name(84, 366, dv_a, "SC HPF", #dvv);
  krv_step = 0;
  // the key's level
  dv_kv = kr_fall(dv_kv, dka_kl); dka_kl = 0;
  gfx_setfont(10); ui_col(KRI2); kr_ctxt(196, 296, "KEY LEVEL");
  kr_window(150, 306, 92, 18); dv_i = 0;
  loop(10, dv_d = -48 + (dv_i + 0.5) / 10 * 48; kr_cell(154 + dv_i * 8.6, 310, 7, 10, dv_kv >= dv_d, dv_d >= slider5 ? 1 : 0); dv_i += 1; );
  gfx_setfont(10); ui_col(KRI2); kr_ctxt(196, 340, "KEY = INPUTS 3 / 4");
) : dv_tg == 1 ? (
  dv_kv = dka_kl; dka_kl = 0; dv_kh += ((dv_kv > dv_kh ? 1 : 0.15) * (dv_kv - dv_kh));
  ui_col(0x050505); gfx_circle(140 * sc, 200 * sc, 22 * sc, 1, 1);
  ui_col(ui_mix(KRGH, KRA, min(dv_kh * 1.2, 1))); gfx_circle(140 * sc, 200 * sc, 19 * sc, 1, 1);
  dv_kh > 0.05 ? ( ui_cola(KRA, 0.2 * dv_kh); gfx_circle(140 * sc, 200 * sc, 28 * sc, 1, 1); );
  gfx_setfont(11); ui_col(KRI); kr_ctxt(140, 244, "NOTE");
  gfx_setfont(10); ui_col(KRI2);
  kr_ctxt(140, 286, "ANY NOTE, ANY CHANNEL"); kr_ctxt(140, 304, "VELOCITY SETS THE DEPTH"); kr_ctxt(140, 322, "A HELD NOTE HOLDS IT DOWN");
  kr_ctxt(140, 350, "THE MIDI PASSES THROUGH");
) : (
  dv_gi = floor(min(max(slider3, 0), 4) + 0.5);
  gfx_setfont(10); ui_col(KRI2); kr_ctxt(140, 148, "A DUCK ON EVERY");
  dv_i = 0; loop(5, kr_kc = LK_WHT; kr_key(32 + dv_i * 45, 160, 41, 28, dv_i == 0 ? "1/1" : dv_i == 1 ? "1/2" : dv_i == 2 ? "1/4" : dv_i == 3 ? "1/8" : "1/16", dv_gi == dv_i) ? dv_set(3, dv_i); dv_i += 1; );
  kr_kc = LK_RED; kr_key(84, 206, 112, 28, "OFF-BEAT", slider4 >= 0.5) ? kr_tog(4);
  // the beat lamps: which step we are on, in the bar
  dv_bp = dk_bp0; dv_st = floor((dv_bp - (slider4 >= 0.5 ? dk_S * 0.5 : 0)) / dk_S); dv_ns = min(4 / dk_S, 16);
  dv_i = 0; loop(dv_ns, dv_w = 192 / dv_ns;
    kr_cell(42 + dv_i * dv_w, 262, max(dv_w - 3, 3), 10, (dv_st % dv_ns + dv_ns) % dv_ns == dv_i, 0); dv_i += 1; );
  gfx_setfont(10); ui_col(KRI2);
  kr_ctxt(140, 296, "LOCKED TO THE BEAT: NO DRIFT"); kr_ctxt(140, 314, "THE ATTACK STARTS EARLY,"); kr_ctxt(140, 330, "SO IT IS DOWN ON THE STEP");
  kr_ctxt(140, 356, (play_state & 1) ? "FOLLOWING THE TRANSPORT" : "STOPPED: FREE AT THE PROJECT TEMPO");
);

// =====================================================================
// SHAPE: sync, feel, attack / hold / release, depth, curve
// =====================================================================
dv_sy = slider8 >= 0.5;
kr_sect(264, 72, 404, 338, "SHAPE");
kr_kc = LK_BLU; kr_key(274, 98, 74, 28, "SYNC", dv_sy) ? kr_tog(8);
dv_sy ? (
  kr_kc = LK_ORA; kr_key(360, 98, 92, 28, "STRAIGHT", slider9 < 0.5) ? dv_set(9, 0);
  kr_kc = LK_ORA; kr_key(458, 98, 92, 28, "DOTTED", slider9 >= 0.5 && slider9 < 1.5) ? dv_set(9, 1);
  kr_kc = LK_ORA; kr_key(556, 98, 102, 28, "TRIPLET", slider9 >= 1.5) ? dv_set(9, 2);
) : ( kr_kc = LK_ORA; kr_dim(360, 98, 92, 28, "STRAIGHT"); kr_kc = LK_ORA; kr_dim(458, 98, 92, 28, "DOTTED"); kr_kc = LK_ORA; kr_dim(556, 98, 102, 28, "TRIPLET"); );
dv_ky = 196;
dv_sy ? (
  krv_step = 1;
  kr_scale(318, dv_ky, 26, 5, 16, "F|128|64|32|16", 0);
  dv_a = kr_knob(318, dv_ky, 26, 10, 0, 4, 0); sprintf(#dvv, "%s%s", dv_note(0, floor(slider10 + 0.5)), dv_feel()); kr_name(318, dv_ky + 52, dv_a, "ATTACK", #dvv);
  kr_scale(408, dv_ky, 26, 6, 16, "0|64|32|16|8|4", 0);
  dv_a = kr_knob(408, dv_ky, 26, 11, 0, 5, 0); sprintf(#dvv, "%s%s", dv_note(1, floor(slider11 + 0.5)), dv_feel()); kr_name(408, dv_ky + 52, dv_a, "HOLD", #dvv);
  kr_scale(498, dv_ky, 26, 7, 16, "32|16|8|4|2|1|2B", 0);
  dv_a = kr_knob(498, dv_ky, 26, 12, 0, 6, 2); sprintf(#dvv, "%s%s", dv_note(2, floor(slider12 + 0.5)), dv_feel()); kr_name(498, dv_ky + 52, dv_a, "RELEASE", #dvv);
  krv_step = 0;
) : (
  kr_scale(318, dv_ky, 26, 5, 16, "0|25|50|75|100", 0);
  dv_a = kr_knob(318, dv_ky, 26, 13, 0, 100, 1); kr_name(318, dv_ky + 52, dv_a, "ATTACK", dv_ms(max(slider13, 0.5)));
  kr_scale(408, dv_ky, 26, 5, 16, "0|.25|.5|.75|1s", 0);
  dv_a = kr_knob(408, dv_ky, 26, 14, 0, 1000, 0); kr_name(408, dv_ky + 52, dv_a, "HOLD", dv_ms(slider14));
  krv_lg = 1;
  kr_scale(498, dv_ky, 26, 4, 16, "10|100|1s|4s", 0);
  dv_a = kr_knob(498, dv_ky, 26, 15, 10, 4000, 250); kr_name(498, dv_ky + 52, dv_a, "RELEASE", dv_ms(slider15));
  krv_lg = 0;
);
// the actual times, always
gfx_setfont(10); ui_col(KRA);
kr_ctxt(318, dv_ky + 70, dv_ms(dk_A / srate * 1000)); kr_ctxt(408, dv_ky + 70, dv_ms(dk_H / srate * 1000)); kr_ctxt(498, dv_ky + 70, dv_ms(dk_R / srate * 1000));
kr_scale(606, dv_ky + 4, 36, 5, 19, "0|10|20|30|40", 2);
dv_a = kr_knob(606, dv_ky + 4, 36, 7, 0, 40, 12); sprintf(#dvv, "-%.1f dB", slider7); kr_name(606, dv_ky + 66, dv_a, "DEPTH", #dvv);
gfx_setfont(11); ui_col(KRI2); kr_txt(276, 316, "CURVE");
dv_cv = floor(min(max(slider16, 0), 3) + 0.5);
dv_i = 0;
loop(4,
  dv_x = 276 + dv_i * 97;
  kr_kc = LK_YEL; kr_key(dv_x, 336, 90, 28, dv_i == 0 ? "LINEAR" : dv_i == 1 ? "FAST" : dv_i == 2 ? "SLOW" : "S-CURVE", dv_cv == dv_i) ? dv_set(16, dv_i);
  // a little picture of each release shape
  ui_col(dv_cv == dv_i ? KRA : KRI2); dv_k = 0;
  loop(24, dv_x1 = dv_x + 8 + dv_k / 24 * 74; dv_x2 = dv_x + 8 + (dv_k + 1) / 24 * 74;
    gfx_line(dv_x1 * sc, (384 + 14 * dk_shape(dv_k / 24, dv_i)) * sc, dv_x2 * sc, (384 + 14 * dk_shape((dv_k + 1) / 24, dv_i)) * sc, 1);
    dv_k += 1; );
  dv_i += 1;
);

// =====================================================================
// THE TRACE: the gain against two beats
// =====================================================================
kr_sect(674, 72, 210, 338, "GAIN  /  2 BEATS");
kr_window(684, 96, 190, 206);
dv_tx0 = 688; dv_tw0 = 182; dv_ty0 = 104; dv_th0 = 186;
dv_sc = max(slider7, 6);
ui_cola(KRI, 0.08); dv_i = 1; loop(7, kr_r(dv_tx0 + dv_i / 8 * dv_tw0, dv_ty0, 1, dv_th0); dv_i += 1; );     // 1/16s
ui_cola(KRI, 0.25); kr_r(dv_tx0 + dv_tw0 * 0.5, dv_ty0, 1, dv_th0);                                         // the beat
ui_cola(KRI, 0.12); kr_r(dv_tx0, dv_ty0, dv_tw0, 1); kr_r(dv_tx0, dv_ty0 + dv_th0 * slider7 / dv_sc, dv_tw0, 1);
ui_col(KRA); dv_i = 0;
loop(TRN - 1,
  dv_y1 = dv_ty0 + min(-TRC[dv_i] / dv_sc, 1) * dv_th0; dv_y2 = dv_ty0 + min(-TRC[dv_i + 1] / dv_sc, 1) * dv_th0;
  dv_x1 = dv_tx0 + dv_i / TRN * dv_tw0; dv_x2 = dv_tx0 + (dv_i + 1) / TRN * dv_tw0;
  gfx_line(dv_x1 * sc, dv_y1 * sc, dv_x2 * sc, dv_y2 * sc, 1); gfx_line(dv_x1 * sc, (dv_y1 + 1) * sc, dv_x2 * sc, (dv_y2 + 1) * sc, 1);
  dv_i += 1;
);
dv_pc = dk_lcol / TRN; ui_cola(KRA, 0.35); kr_r(dv_tx0 + dv_pc * dv_tw0, dv_ty0, 1.5, dv_th0);              // the playhead
gfx_setfont(10); ui_col(KRI2); kr_rtxt(dv_tx0 + dv_tw0 - 3, dv_ty0 + 8, "0 dB"); sprintf(#dvv, "-%d", floor(slider7 + 0.5)); kr_rtxt(dv_tx0 + dv_tw0 - 3, dv_ty0 + dv_th0 * slider7 / dv_sc - 8, #dvv);
dv_gr = dka_gr; dka_gr = 0; dv_gn += ((dv_gr < dv_gn ? 0.6 : 0.25) * (dv_gr - dv_gn));
sprintf(#dvv, "%.1f dB", dv_gn); gfx_setfont(14); ui_col(KRA); kr_ctxt(779, 324, #dvv);
gfx_setfont(10); ui_col(KRI2); sprintf(#dvv, "%.1f BPM  -  1 BEAT %s", dk_tmp, dv_ms(60000 / dk_tmp)); kr_ctxt(779, 346, #dvv);
dk_la > 0 ? ( sprintf(#dvv, "LOOKAHEAD %s (LATENCY)", dv_ms(dk_la / srate * 1000)); kr_ctxt(779, 366, #dvv); );
kr_kc = LK_AMB; kr_key(728, 378, 102, 24, "IN", slider1 >= 0.5) ? kr_tog(1);

// the ducker switched off: trigger, shape and gain greyed slightly, IN redrawn on top
slider1 < 0.5 ? ( kr_off(22, 72, 236, 338); kr_off(264, 72, 404, 338); kr_off(674, 72, 210, 338);
  kr_kc = LK_AMB; kr_key(728, 378, 102, 24, "IN", 0) ? kr_tog(1); );

// =====================================================================
// OUTPUT: focus, crossover, lookahead, mix, output, drift, meters
// =====================================================================
kr_sect(890, 72, 168, 338, "FOCUS  /  OUTPUT");
dv_fo = floor(min(max(slider18, 0), 3) + 0.5);
kr_kc = LK_RED; kr_key(900, 96, 72, 26, "FULL", dv_fo == 0) ? dv_set(18, 0);
kr_kc = LK_RED; kr_key(978, 96, 72, 26, "LOWS", dv_fo == 1) ? dv_set(18, 1);
kr_kc = LK_RED; kr_key(900, 126, 72, 26, "MID", dv_fo == 2) ? dv_set(18, 2);
kr_kc = LK_RED; kr_key(978, 126, 72, 26, "SIDE", dv_fo == 3) ? dv_set(18, 3);
krv_lg = 1; sprintf(#dvv, "%d Hz", floor(slider19 + 0.5));
kr_small(934, 186, 14, 19, 40, 400, 150, 11, "XOVER", #dvv); krv_lg = 0;
dv_fo != 1 ? ( ui_cola(KRP, 0.6); kr_r(912, 164, 46, 54); );
sprintf(#dvv, "%.1f ms", slider17); kr_small(1014, 186, 14, 17, 0, 10, 0, 11, "AHEAD", #dvv);
dv_tg == 2 ? ( ui_cola(KRP, 0.6); kr_r(992, 164, 46, 54); );
sprintf(#dvv, "%d%%", floor(slider21 + 0.5)); kr_small(934, 262, 14, 21, 0, 100, 100, 11, "MIX", #dvv);
sprintf(#dvv, "%+.1f dB", slider22); kr_small(1014, 262, 14, 22, -12, 12, 0, 11, "OUTPUT", #dvv);
sprintf(#dvv, "%d%%", floor(slider23 + 0.5)); kr_small(974, 324, 12, 23, 0, 100, 50, 11, "DRIFT", #dvv);
dv_ml = kr_fall(dv_ml, dka_ol); dv_mr = kr_fall(dv_mr, dka_or); dka_ol = dka_or = 0;
kr_window(898, 368, 152, 36);
kr_hbar(904, 373, 142, 11, dv_ml); kr_hbar(904, 388, 142, 11, dv_mr);

