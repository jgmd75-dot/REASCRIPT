ui_cola(AMBF, 1); jg_r(jg_X0, jg_cy(log(1000) / log(2)), jg_X1 - jg_X0, 1); jg_r(jg_X0, jg_cy(log(100) / log(2)), jg_X1 - jg_X0, 1);
jg_r(jg_X0, jg_cy(log(10000) / log(2)), jg_X1 - jg_X0, 1);
