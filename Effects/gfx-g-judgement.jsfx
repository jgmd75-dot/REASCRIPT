jg_i = 1; loop(7, ui_cola(AMBF, 0.8); jg_r(jg_X0 + jg_i * (jg_X1 - jg_X0) / 8, 88, 1, 336); jg_i += 1; );
ui_cola(AMBF, 1); jg_r(416, 256, 368, 1);
// what the settings make of a note (the predicted curves, dim): the embouchure, the filter envelope (C4, velocity 100)
jg_W = ju_scW; jg_A = slider28; jg_etm = slider29 / 1000; jg_P = 2 ^ (-slider30 / 50);
jg_ps = max(abs(jg_A), 0.5) * 1.18;                        // the pitch scale (semitones at the band's edge)
jg_pyc = 172; jg_phh = 70;                                   // the pitch band: the target line, half-height
jg_CY0 = 420; jg_CY1 = 266;                                // the cutoff band: 4 .. 14.3 octaves (16 Hz .. 20 kHz)
function jg_cy(o) ( jg_CY0 + (min(max(o, 4), 14.3) - 4) / 10.3 * (jg_CY1 - jg_CY0); );
function jg_py(s) ( jg_pyc - min(max(s / jg_ps, -1.1), 1.1) * jg_phh; );
ui_cola(AMBD, 0.7); jg_r(jg_X0, jg_pyc, jg_X1 - jg_X0, 1);
jg_i = 0; jg_fe = 0; jg_fs = 1;
jg_fa = 1 - exp(-1.466 * jg_W / 256 / max(slider18 * 0.001, 0.0005)); jg_fd = 1 - exp(-4.6 * jg_W / 256 / max(slider19 * 0.001, 0.0005));
loop(257,
  jg_tt = jg_i / 256 * jg_W; jg_x = jg_X0 + jg_i / 256 * (jg_X1 - jg_X0);
  jg_u = 1 - jg_tt / max(jg_etm, 0.001); jg_s = jg_u > 0 ? jg_A * jg_u ^ jg_P : 0;
  jg_y = jg_py(jg_s);
  jg_i > 0 ? ( ui_cola(AMBD, 0.75); jg_ln(jg_ox, jg_oy, jg_x, jg_y, 1.2); );
  jg_o = ju_cott + 0.5 * (jg_A > 0 ? jg_s : jg_s) / 12 + slider14 / 100 * 6 * jg_fe;
  jg_y2 = jg_cy(jg_o);
  jg_i > 0 ? ( ui_cola(AMBD, 0.6); jg_ln(jg_ox2, jg_oy2, jg_x, jg_y2, 1.2); );
  jg_fs == 1 ? ( jg_fe += (1.3 - jg_fe) * jg_fa; jg_fe >= 1 ? ( jg_fe = 1; jg_fs = 2; ); ) : jg_fe += (slider20 / 100 - jg_fe) * jg_fd;
  jg_ox = jg_x; jg_oy = jg_y; jg_ox2 = jg_x; jg_oy2 = jg_y2; jg_i += 1;
);
// the newest note, as it happened (bright): the pitch landing, the cutoff converging; its targets dashed
ju_sck > 1 && ju_scv >= 0 ? (
  jg_y = jg_cy(ju_sctg); jg_i = 0; loop(27, ui_cola(AMBL, 0.55); jg_r(jg_X0 + jg_i * 12, jg_y, 6, 1.2); jg_i += 1; );
  jg_i = 0;
  loop(ju_sck,
    jg_x = jg_X0 + jg_i / 256 * (jg_X1 - jg_X0) * ju_scD / max(ju_scDn, 1);
    jg_x = min(jg_x, jg_X1);
    jg_y = jg_py(JUTP[jg_i]); jg_y2 = jg_cy(JUTC[jg_i]);
    jg_i > 0 ? (
      ui_cola(AMB, 0.3); jg_ln(jg_ox, jg_oy, jg_x, jg_y, 4); jg_ln(jg_ox2, jg_oy2, jg_x, jg_y2, 4);
      ui_col(AMBL); jg_ln(jg_ox, jg_oy, jg_x, jg_y, 1.6); ui_col(AMB); jg_ln(jg_ox2, jg_oy2, jg_x, jg_y2, 1.6);
    );
    jg_ox = jg_x; jg_oy = jg_y; jg_ox2 = jg_x; jg_oy2 = jg_y2; jg_i += 1;
  );
  ui_col(AMBL); jg_disc(jg_ox, jg_oy, 3); jg_disc(jg_ox2, jg_oy2, 3);
);
