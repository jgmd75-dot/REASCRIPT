in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-judgement";                               // the ? pop-up links to this manual
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;                  // the house drive: ADAA, the pre-filter, the knee tracking (a character stage)

// ---------- memory ----------
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
JUDEF = 1000; JUTMP = 1200;                                // the Init values; the preset parser's scratch (panel only)
JUTP = 2000; JUTC = 2300; JUTA = 2600;                     // the scope's trace: pitch offset (st), cutoff (octaves), amp
JUHN = 3000;                                               // UNISON: the keys held, in order (with their velocities at JUHN + 200)
JUFL = 10000; JUFR = 14096; JUFM = 4095;                   // the flanger's lines
JUCL = 20000; JUCR = 28192; JUCM = 8191;                   // the chorus's lines
JUAPB = 40000; JUAPM = 2047;                                // the delay's four diffusers (2048 each)
JUDL = 100000; JUDR = 362144; JUDM = 262143;               // the delay's lines (2^18 each)
memset(JUFL, 0, 2 * 4096); memset(JUCL, 0, 2 * 8192); memset(JUAPB, 0, 4 * 2048); memset(JUDL, 0, 2 * 262144);
memset(JUTP, 0, 900);
TWOPI = 2 * $pi; JUK = 1 / 16;

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#ju_def = "0 0 50 80 0 0 6 70 0 0 6 900 15 55 50 1 40 60 600 45 300 15 800 85 220 0 50 1 60 -40 50 35 5.2 0 0.6 0 0.35 1 0 0 12 0 0 0 0 0 0 30 1 0 4 0 1 50 2 0 50 -3 60 0 30 120 6000 -0.3 1 0 35 50 0 0 0.25 60 40 50 0 0.5 50 40 0 0 360 5 35 45 30 25 22";
function ju_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
ju_nums(#ju_def, JUDEF);
#ju_pm = "Init|Brass Stab|Section Swell|Section Pad|Solo Lead Brass|Fanfare|Horn Section Big Lip|Bright Pop Brass|Soft Horn Pad|Trombone Growl|Arena Brass|Muted Trumpets";
ju_npre = 12;
function ju_pstr(p) (
  p == 2 ? "12:620 13:12 14:70 18:25 19:380 20:32 21:160 22:3 23:450 24:70 25:130 28:1 29:40 30:-50 31:60 32:30 17:55 75:1 76:0.6 77:45 78:30 59:68.3" :
  p == 3 ? "12:480 14:60 18:1300 19:2500 20:70 21:900 22:850 23:1500 24:95 25:900 28:0.5 29:300 30:30 31:30 32:45 41:8 35:1.2 48:40 75:1 78:35 79:1 80:1 82:6 83:30 85:35 86:45 87:16 59:62" :
  p == 4 ? "16:0 12:700 13:20 14:40 18:600 19:2200 20:60 21:1500 22:380 23:2000 24:92 25:1300 28:0.3 29:160 32:58 10:25 11:4 44:20 48:45 38:0 37:0.12 75:1 76:0.35 77:60 78:45 59:54.5" :
  p == 5 ? "50:1 51:4 52:70 53:1 28:1.5 29:80 30:-30 31:40 32:40 12:900 13:22 14:55 18:35 19:900 20:55 22:8 24:90 25:260 49:0 41:16 35:0.7 66:1 67:30 68:55 79:1 80:1 82:3 83:38 84:40 85:25 86:20 87:20 48:15 59:63.1" :
  p == 6 ? "28:2 29:95 30:-20 31:70 32:45 12:750 13:15 14:68 18:40 19:700 20:45 22:6 23:900 24:85 25:300 17:60 75:1 78:30 79:1 81:280 83:25 85:20 86:40 87:15 59:61.7" :
  p == 7 ? "28:-2 29:140 30:-10 31:60 32:50 6:-12 8:55 12:560 13:18 14:62 18:90 19:900 20:48 22:40 23:1000 24:88 25:350 10:20 11:10 75:1 78:35 59:63.8" :
  p == 8 ? "12:1400 13:26 14:75 18:12 19:320 20:48 21:200 22:4 23:600 24:80 25:180 28:0.6 29:30 30:-60 32:38 6:12 8:35 75:1 76:0.7 77:55 78:40 66:1 67:22 68:60 59:71.6" :
  p == 9 ? "16:0 12:430 13:8 14:32 18:220 19:1500 20:55 21:700 22:180 23:1400 24:90 25:650 28:0.3 29:150 30:10 31:40 32:20 9:0 10:30 11:12 8:55 75:1 76:0.3 77:40 78:30 59:57.3" :
  p == 10 ? "2:-12 6:-12 7:9 12:520 13:28 14:60 18:60 19:800 20:40 22:12 24:85 28:1.2 29:70 32:35 38:1 37:17 46:14 49:0 66:1 67:55 68:40 69:-2 59:71.4" :
  p == 11 ? "12:820 13:20 14:65 18:45 19:900 20:50 22:10 23:1200 24:88 25:500 28:1 29:60 32:62 70:1 71:0.12 72:55 73:45 74:40 75:1 78:35 79:1 80:1 82:5 83:35 85:30 86:50 87:20 44:25 48:40 59:68.3" :
  p == 12 ? "1:1 5:1 3:32 16:0 12:1700 13:32 14:45 18:8 19:250 20:45 22:4 23:500 24:75 25:140 28:0.8 29:25 30:-60 32:25 43:0 47:20 38:0 37:0.4 66:1 67:40 68:45 11:10 59:53.1" :
  "";
);
function load_preset(p) local(n, i) (
  // FATE, the MIDI channel, the bend range and the output stage stay as they are
  i = 0; loop(87, ((i < 54 || i > 56) && (i < 59 || i > 64)) ? slider(i + 1) = JUDEF[i]; i += 1; );
  n = ju_nums(ju_pstr(p), JUTMP);
  i = 0; loop(floor(n / 2), JUTMP[i * 2] >= 1 && JUTMP[i * 2] <= 87 ? slider(JUTMP[i * 2]) = JUTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(87, ui_auto(i); i += 1; );
  pr_cur = p; ju_panic = 1;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and everything else back too
  load_preset(1);
  i = 0; loop(87, slider(i + 1) = JUDEF[i]; ui_auto(i + 1); i += 1; );
);

// ---------- small helpers ----------
function ju_h(k) local(t) ( t = sin(k * 12.9898 + 78.233) * 43758.5453; (t - floor(t)) * 2 - 1; );   // a hash, -1 .. 1
// an LFO's value at phase p (p may run past 1: the next cycle): 0 sine, 1 triangle, 2 square (rounded), 3 saw down,
// 4 random (a new value each cycle; c = the cycle count)
function ju_lfo(p, s, c) local(k, f) (
  k = floor(p); f = p - k;
  s == 0 ? sin(TWOPI * f) : s == 1 ? 1 - 4 * abs(f - 0.5) : s == 2 ? vo_tanh(3 * sin(TWOPI * f)) * 1.0037 :
  s == 3 ? 1 - 2 * f : ju_h(c + k + 0.5);
);
// a sync division's length in quarter notes (1 .. 13; 0 = free)
function ju_divq(i) local(bq) (
  bq = ts_denom > 0 ? ts_num * 4 / ts_denom : 4;
  i == 1 ? 2 * bq : i == 2 ? bq : i == 3 ? 2 : i == 4 ? 4 / 3 : i == 5 ? 1.5 : i == 6 ? 1 : i == 7 ? 2 / 3 :
  i == 8 ? 0.75 : i == 9 ? 0.5 : i == 10 ? 1 / 3 : i == 11 ? 0.25 : i == 12 ? 1 / 6 : 0.125;
);
// a square from phase q (dt: its increment), band-limited
function ju_sq(q, dt) local(r) ( r = q + 0.5; r -= floor(r); (2 * q - vo_blep(q, dt)) - (2 * r - vo_blep(r, dt)); );
// the envelope coefficients (per 16-sample tick): the attack aims at 1.3 and reaches 1 in ms; decay / release settle in ms
function ju_ca(ms) ( 1 - exp(-16 * 1.466 / (max(ms, 0.5) * 0.001 * srate)); );
function ju_cd(ms) ( 1 - exp(-16 * 4.6 / (max(ms, 0.5) * 0.001 * srate)); );

// ---------- a voice card (each voice in its own namespace) ----------
// st: 0 free, 2 sounding, 4 fading out (stolen: the new note waits 4 ms). wt: samples until its gate opens (the note's
// place in the block). hk: its key is held. fst / ast: the filter / amp envelope's stage (0 idle, 1 attack, 2 decay /
// sustain, 3 release); fe / ae their levels. gp: the glided pitch (semitones), et: time since the gate (s), emb: the
// embouchure's offset now (semitones).
function ju_init(i) instance(vi, st, nt, vel, hk, age, wt, pn, pv, fd, p1, p2, p3, i1, i2, is, pw, s1, s2, s3, s4, ic1, ic2, fe, fst, ae, ast, ag, dag, gG, gH, gG4, a1, a2, a3, et, etm, ea, emb, gp, gk, lt, bl, uf, nb, oc, q1, q2, m0, m1, m2, fu, h1, h2, h3, h4, dph, drt, pb, gl, gr, vg, vf, vo) (
  vi = i; st = 0; nt = 60; vel = 0; hk = 0; age = 0; wt = 0; pn = 60; pv = 0; fd = 1;
  p1 = p2 = p3 = 0; q1 = q2 = 0.5; m0 = m1 = m2 = fu = 0; i1 = i2 = is = 0.001; pw = 0.5; s1 = s2 = s3 = s4 = 0; ic1 = ic2 = 0;
  fe = 0; fst = 0; ae = 0; ast = 0; ag = 0; dag = 0; gG = 0.5; gH = 0.5; gG4 = 0.06; a1 = 1; a2 = a3 = 0;
  et = 1000; etm = 0.05; ea = 0; emb = 0; gp = 60; gk = 1; lt = 0; bl = 0; uf = 0; nb = 0; oc = 10;
  h1 = ju_h(i * 3.7 + 1); h2 = ju_h(i * 5.3 + 2); h3 = ju_h(i * 7.1 + 3); h4 = ju_h(i * 9.1 + 5);
  dph = (ju_h(i * 4.3 + 6) + 1) * 0.5; drt = 0.03 + 0.04 * (ju_h(i * 2.9 + 4) * 0.5 + 0.5);
  pb = ((i % 2) ? 1 : -1) * (0.25 + 0.25 * (3 - floor(i / 2))); gl = gr = 0.7071; vg = 1; vf = 1; vo = 0;
);
// a note for this card: its pitch, its velocity's effects, its embouchure (each player a little different)
function ju_prep(n, v, fresh) instance(vi, st, nt, vel, hk, age, wt, pn, pv, fd, p1, p2, p3, i1, i2, is, pw, s1, s2, s3, s4, ic1, ic2, fe, fst, ae, ast, ag, dag, gG, gH, gG4, a1, a2, a3, et, etm, ea, emb, gp, gk, lt, bl, uf, nb, oc, q1, q2, m0, m1, m2, fu, h1, h2, h3, h4, dph, drt, pb, gl, gr, vg, vf, vo) local(t) (
  fresh ? (
    p1 = rand(1); p2 = rand(1); p3 = rand(1); q1 = p1 + 1 - pw; q1 -= floor(q1); q2 = p2 + 1 - pw; q2 -= floor(q2);
    m0 = m1 = m2 = fu = 0; s1 = s2 = s3 = s4 = 0; ic1 = ic2 = 0;
    fe = ae = 0; fst = ast = 0; ag = dag = 0; et = 1000; emb = 0; lt = 0;
    gp = ju_gon ? ju_lastn : n;
  ) : (
    !ju_gon ? gp = n;
    ju_mode == 0 ? lt = 0;
  );
  st = 2; nt = n; vel = v;
  vg = 1 - ju_vl * (1 - v * v); vf = 1 - 0.5 * ju_vb * (1 - v); vo = ju_vb * (v - 1) * 1.5;
  t = sin(TWOPI * dph);
  ea = ju_eamt * (1 - ju_evs * (1 - v)) * (1 + 0.25 * ju_fa * (0.7 * h1 + 0.3 * t));
  etm = max(ju_etim * (1 + 0.35 * ju_fa * (0.7 * h2 + 0.3 * t)), 0.001);
  gk = ju_glide > 0.0005 ? 1 - exp(-16 * 3 / (ju_glide * (1 + 0.3 * ju_fa * h2) * srate)) : 1;
  bl = ju_det * 6 * (rand(2) - 1);
);
// the gate opens: both envelopes from where they are (a retrigger never clicks), the embouchure from its start
function ju_gate() instance(vi, st, nt, vel, hk, age, wt, pn, pv, fd, p1, p2, p3, i1, i2, is, pw, s1, s2, s3, s4, ic1, ic2, fe, fst, ae, ast, ag, dag, gG, gH, gG4, a1, a2, a3, et, etm, ea, emb, gp, gk, lt, bl, uf, nb, oc, q1, q2, m0, m1, m2, fu, h1, h2, h3, h4, dph, drt, pb, gl, gr, vg, vf, vo) (
  fst = 1; ast = 1; et = 0;
  ju_scv = vi; ju_sck = 0; ju_scc = 0; ju_scD = ju_scDn; ju_scn = nt; ju_scea = ea;
  ju_sctg = ju_coct + ju_kt * (nt - 60) / 12 + ju_fenv * ju_fsl * vf + vo;
);
// UNISON, a joined note: the stack moves to it (gliding when GLIDE is up), re-tongued at half the embouchure
function ju_leg(n, v) instance(vi, st, nt, vel, hk, age, wt, pn, pv, fd, p1, p2, p3, i1, i2, is, pw, s1, s2, s3, s4, ic1, ic2, fe, fst, ae, ast, ag, dag, gG, gH, gG4, a1, a2, a3, et, etm, ea, emb, gp, gk, lt, bl, uf, nb, oc, q1, q2, m0, m1, m2, fu, h1, h2, h3, h4, dph, drt, pb, gl, gr, vg, vf, vo) (
  nt = n; ju_glide <= 0.0005 ? gp = n;
  ea = 0.5 * ju_eamt * (1 - ju_evs * (1 - v)) * (1 + 0.25 * ju_fa * h1); et = 0;
  vi == 0 ? ( ju_scv = 0; ju_sck = 0; ju_scc = 0; ju_scD = ju_scDn; ju_scn = n; ju_scea = ea; );
);
// POLY: a note for this card - free, the same key again, or stolen (faded out first)
function ju_on(n, v, w) instance(vi, st, nt, vel, hk, age, wt, pn, pv, fd, p1, p2, p3, i1, i2, is, pw, s1, s2, s3, s4, ic1, ic2, fe, fst, ae, ast, ag, dag, gG, gH, gG4, a1, a2, a3, et, etm, ea, emb, gp, gk, lt, bl, uf, nb, oc, q1, q2, m0, m1, m2, fu, h1, h2, h3, h4, dph, drt, pb, gl, gr, vg, vf, vo) (
  st == 0 ? ( this.ju_prep(n, v, 1); wt = max(w, 1); ) :
  st == 2 && nt == n ? ( this.ju_prep(n, v, 0); wt = max(w, 1); ) :
  ( st = 4; fd = 1; pn = n; pv = v; );
  hk = 1; age = ju_age; ju_age += 1;
);
function ju_key() instance(st, nt, pn) ( st == 4 ? pn : nt; );
// the control tick (every 16 samples): LFOs (with each note's fade-in), embouchure, glide, pitch, envelopes,
// cutoff, pan; free when silent; the scope's trace
function ju_tk() instance(vi, st, nt, vel, hk, age, wt, pn, pv, fd, p1, p2, p3, i1, i2, is, pw, s1, s2, s3, s4, ic1, ic2, fe, fst, ae, ast, ag, dag, gG, gH, gG4, a1, a2, a3, et, etm, ea, emb, gp, gk, lt, bl, uf, nb, oc, q1, q2, m0, m1, m2, fu, h1, h2, h3, h4, dph, drt, pb, gl, gr, vg, vf, vo) local(lf1, lf2, v1, v2, u, c, semi, f, oct, fc, g, t, pn_, a) (
  lt += ju_tks; et += ju_tks;
  lf1 = ju_dl1 > 0.005 ? min(max(lt / ju_dl1 * 2 - 1, 0), 1) : 1;
  lf2 = ju_dl2 > 0.005 ? min(max(lt / ju_dl2 * 2 - 1, 0), 1) : 1;
  v1 = ju_l1v * lf1; v2 = ju_l2v * lf2;
  // the embouchure: AMOUNT off the pitch, landing over TIME on its CURVE
  u = 1 - et / etm; emb = u > 0 ? ea * u ^ ju_ecp : 0;
  gp += (nt - gp) * gk;
  bl *= ju_blk; dph += drt * ju_tks; dph -= floor(dph);
  t = sin(TWOPI * dph);
  // cents: DETUNE (the card's own place, its slow wander, the landing), UNISON's fan, FATE's player, the LFOs
  c = ju_det * (6 * h4 + 2.5 * cos(TWOPI * dph * 2 + h3)) + bl + uf * (4 + 18 * ju_det) + ju_fa * 2.5 * (0.6 * h3 + 0.4 * t) + ju_dp1 * v1 + ju_dp2 * v2;
  semi = gp + emb + ju_bnd + c * 0.01;
  f = 440 * 2 ^ ((semi - 69) / 12) * ins_pitch * ju_isr;
  i1 = min(f * ju_r1, 0.45); i2 = min(f * ju_r2, 0.45); is = i1 * 0.25;
  pw = min(max(ju_pw + ju_dw1 * v1 + ju_dw2 * v2, 0.05), 0.95);
  // the filter not in use (after a slope change) starts again from rest
  ju_pm == 0 ? ( s1 = s2 = s3 = s4 = 0; ); ju_pm == 1 ? ( ic1 = ic2 = 0; );
  // the gate let go (and the pedal up): both envelopes release
  !hk && !ju_ped ? ( fst == 1 || fst == 2 ? fst = 3; ast == 1 || ast == 2 ? ast = 3; );
  fst == 1 ? ( fe += (1.3 - fe) * ju_fac; fe >= 1 ? ( fe = 1; fst = 2; ); ) :
  fst == 2 ? fe += (ju_fsl - fe) * ju_fdc :
  fst == 3 ? ( fe -= fe * ju_frc; fe < 0.00001 ? ( fe = 0; fst = 0; ); );
  ast == 1 ? ( ae += (1.3 - ae) * ju_aac; ae >= 1 ? ( ae = 1; ast = 2; ); ) :
  ast == 2 ? ae += (ju_asl - ae) * ju_adc :
  ast == 3 ? ( ae -= ae * ju_arc; ae < 0.00001 ? ( ae = 0; ast = 0; ); );
  a = ae + (fe - ae) * ju_lk;
  dag = (a * vg - ag) * JUK;
  // breath: with the amp, and a puff while the embouchure lands
  nb = ju_brt * a * (1 + 2.5 * max(u, 0));
  // the cutoff (octaves)
  oct = ju_coct + ju_kt * (gp + emb - 60) / 12 + ju_fenv * fe * vf + vo + ju_dc1 * v1 + ju_dc2 * v2 + ins_cut * 0.25;
  oc = oct;
  fc = min(max(2 ^ oct, 16), ju_fmax); g = tan($pi * fc * ju_isr);
  gG = g / (1 + g); gH = 1 - gG; gG4 = gG * gG; gG4 *= gG4;
  a1 = 1 / (1 + g * (g + ju_kq)); a2 = g * a1; a3 = g * a2;
  // the pan: the card's place, and its own stereo drift
  pn_ = pb * ju_spr;
  ju_dn1 != 0 ? pn_ += ju_dn1 * ju_lfo(ju_p1 + vi * 0.125, ju_s1, ju_c1) * lf1;
  ju_dn2 != 0 ? pn_ += ju_dn2 * ju_lfo(ju_p2 + vi * 0.125, ju_s2, ju_c2 + 17) * lf2;
  pn_ = min(max(pn_, -1), 1); gl = cos((pn_ + 1) * 0.25 * $pi); gr = sin((pn_ + 1) * 0.25 * $pi);
  // the scope follows the newest note
  vi == ju_scv && ju_sck < 256 && wt <= 0 ? (
    ju_scc -= 1; ju_scc <= 0 ? ( ju_scc = ju_scD; JUTP[ju_sck] = emb + gp - nt; JUTC[ju_sck] = oct; JUTA[ju_sck] = a; ju_sck += 1; );
  );
  st == 2 && wt <= 0 && (ju_lk >= 1 ? fst == 0 : ju_lk <= 0 ? ast == 0 : fst == 0 && ast == 0) && ag < 0.00002 ? st = 0;
);
// a jump of height h, d samples before this sample (0 .. 1): its 4-point B-spline residual (the smoothed step less
// the step) into the four samples round it - m2, m1: two and one before; m0: this one; fu: the next
function ju_bl(d, h) instance(m0, m1, m2, fu) local(y, e) (
  e = d * d; m2 += h * e * e * 0.041666667;
  y = d - 1; e = y * y; m1 += h * (0.5 + (4 * y - 2 * e * y - 0.75 * e * e) * 0.16666667);
  e = d * d; m0 -= h * (0.5 + (-4 * d + 2 * e * d - 0.75 * e * e) * 0.16666667);
  y = 1 - d; e = y * y; fu -= h * e * e * 0.041666667;
);
// one sample of the card: oscillators, breath, the filter, the VCA
function ju_run() instance(vi, st, nt, vel, hk, age, wt, pn, pv, fd, p1, p2, p3, i1, i2, is, pw, s1, s2, s3, s4, ic1, ic2, fe, fst, ae, ast, ag, dag, gG, gH, gG4, a1, a2, a3, et, etm, ea, emb, gp, gk, lt, bl, uf, nb, oc, q1, q2, m0, m1, m2, fu, h1, h2, h3, h4, dph, drt, pb, gl, gr, vg, vf, vo) local(q, x, y, ys, b1, b2, b3, b4, u) (
  wt > 0 ? ( wt -= 1; wt <= 0 ? this.ju_gate(); );
  // OSC 1, OSC 2: a saw, morphing to a pulse (the saw less a shifted saw). Every jump is band-limited by a 4-point
  // BLEP (an integrated cubic B-spline, two samples either side of the jump): the oscillators run two samples behind
  // (m2 is heard), so a jump's correction also reaches the two samples before it
  m2 = m1; m1 = m0; m0 = fu; fu = 0;
  p1 += i1; p1 >= 1 ? ( p1 -= 1; this.ju_bl(p1 / i1, -2 * ju_lv1); );
  q = p1 + 1 - pw; q -= floor(q); q < q1 - 0.5 ? this.ju_bl(q / i1, 2 * ju_wm1 * ju_lv1); q1 = q;
  p2 += i2; p2 >= 1 ? ( p2 -= 1; this.ju_bl(p2 / i2, -2 * ju_lv2); );
  q = p2 + 1 - pw; q -= floor(q); q < q2 - 0.5 ? this.ju_bl(q / i2, 2 * ju_wm2 * ju_lv2); q2 = q;
  m0 += (2 * p1 - 1 - ju_wm1 * (2 * q1 - 1)) * ju_lv1 + (2 * p2 - 1 - ju_wm2 * (2 * q2 - 1)) * ju_lv2;
  x = m2;
  // SUB: two octaves down (p3), one octave down (twice its phase), crossfaded
  ju_lvs > 0 ? (
    p3 += is; p3 >= 1 ? p3 -= 1;
    ju_sm < 1 ? ( q = 2 * p3; q -= floor(q); x += ju_sq(q, 2 * is) * ju_lvs * (1 - ju_sm); );
    ju_sm > 0 ? x += ju_sq(p3, is) * ju_lvs * ju_sm;
  );
  nb > 0 ? x += (rand(2) - 1) * nb;
  x *= 0.55;
  // the filter: 12 dB state-variable and / or the 24 dB ladder (solved, its feedback soft-saturated)
  ju_pm < 1 ? (
    u = vo_tanh(x) - ic2; b1 = a1 * ic1 + a2 * u; b2 = ic2 + a2 * ic1 + a3 * u;
    ic1 = 2 * b1 - ic1; ic2 = 2 * b2 - ic2; ys = b2;
  ) : ys = 0;
  ju_pm > 0 ? (
    b1 = gH * s1; b2 = gH * s2; b3 = gH * s3; b4 = gH * s4;
    y = (gG4 * x + ((b1 * gG + b2) * gG + b3) * gG + b4) / (1 + ju_kl * gG4);
    u = vo_tanh(x - ju_kl * y);
    y = gG * u + b1; s1 = 2 * y - s1;
    y = gG * y + b2; s2 = 2 * y - s2;
    y = gG * y + b3; s3 = 2 * y - s3;
    y = gG * y + b4; s4 = 2 * y - s4;
    y *= ju_kmk;
    ys += (y - ys) * ju_pm;
  );
  ag += dag; ys *= ag;
  st == 4 ? (
    fd -= ju_fdk;
    fd <= 0 ? ( this.ju_prep(pn, pv, 1); wt = 0; this.ju_gate(); ys = 0; ) : ys *= fd * fd * (3 - 2 * fd);
  );
  ys;
);

// ---------- the voice cards: dispatch by number ----------
function ju_vst(i) ( i == 0 ? jv0.st : i == 1 ? jv1.st : i == 2 ? jv2.st : i == 3 ? jv3.st : i == 4 ? jv4.st : i == 5 ? jv5.st : i == 6 ? jv6.st : jv7.st; );
function ju_vag(i) ( i == 0 ? jv0.ag : i == 1 ? jv1.ag : i == 2 ? jv2.ag : i == 3 ? jv3.ag : i == 4 ? jv4.ag : i == 5 ? jv5.ag : i == 6 ? jv6.ag : jv7.ag; );
function ju_vage(i) ( i == 0 ? jv0.age : i == 1 ? jv1.age : i == 2 ? jv2.age : i == 3 ? jv3.age : i == 4 ? jv4.age : i == 5 ? jv5.age : i == 6 ? jv6.age : jv7.age; );
function ju_vhk(i) ( i == 0 ? jv0.hk : i == 1 ? jv1.hk : i == 2 ? jv2.hk : i == 3 ? jv3.hk : i == 4 ? jv4.hk : i == 5 ? jv5.hk : i == 6 ? jv6.hk : jv7.hk; );
function ju_vk(i) ( i == 0 ? jv0.ju_key() : i == 1 ? jv1.ju_key() : i == 2 ? jv2.ju_key() : i == 3 ? jv3.ju_key() : i == 4 ? jv4.ju_key() : i == 5 ? jv5.ju_key() : i == 6 ? jv6.ju_key() : jv7.ju_key(); );
function ju_von(i, n, v, w) ( i == 0 ? jv0.ju_on(n, v, w) : i == 1 ? jv1.ju_on(n, v, w) : i == 2 ? jv2.ju_on(n, v, w) : i == 3 ? jv3.ju_on(n, v, w) : i == 4 ? jv4.ju_on(n, v, w) : i == 5 ? jv5.ju_on(n, v, w) : i == 6 ? jv6.ju_on(n, v, w) : jv7.ju_on(n, v, w); );
function ju_voff(i) ( i == 0 ? jv0.hk = 0 : i == 1 ? jv1.hk = 0 : i == 2 ? jv2.hk = 0 : i == 3 ? jv3.hk = 0 : i == 4 ? jv4.hk = 0 : i == 5 ? jv5.hk = 0 : i == 6 ? jv6.hk = 0 : jv7.hk = 0; );
function ju_vprep(i, n, v, f) ( i == 0 ? jv0.ju_prep(n, v, f) : i == 1 ? jv1.ju_prep(n, v, f) : i == 2 ? jv2.ju_prep(n, v, f) : i == 3 ? jv3.ju_prep(n, v, f) : i == 4 ? jv4.ju_prep(n, v, f) : i == 5 ? jv5.ju_prep(n, v, f) : i == 6 ? jv6.ju_prep(n, v, f) : jv7.ju_prep(n, v, f); );
function ju_vleg(i, n, v) ( i == 0 ? jv0.ju_leg(n, v) : i == 1 ? jv1.ju_leg(n, v) : i == 2 ? jv2.ju_leg(n, v) : i == 3 ? jv3.ju_leg(n, v) : i == 4 ? jv4.ju_leg(n, v) : i == 5 ? jv5.ju_leg(n, v) : i == 6 ? jv6.ju_leg(n, v) : jv7.ju_leg(n, v); );
function ju_vfan(i, u, p) ( i == 0 ? ( jv0.uf = u; jv0.pb = p; ) : i == 1 ? ( jv1.uf = u; jv1.pb = p; ) : i == 2 ? ( jv2.uf = u; jv2.pb = p; ) : i == 3 ? ( jv3.uf = u; jv3.pb = p; ) : i == 4 ? ( jv4.uf = u; jv4.pb = p; ) : i == 5 ? ( jv5.uf = u; jv5.pb = p; ) : i == 6 ? ( jv6.uf = u; jv6.pb = p; ) : ( jv7.uf = u; jv7.pb = p; ); );
function ju_vwt(i, w) ( i == 0 ? ( jv0.wt = max(w, 1); jv0.hk = 1; jv0.age = ju_age; ) : i == 1 ? ( jv1.wt = max(w, 1); jv1.hk = 1; jv1.age = ju_age; ) : i == 2 ? ( jv2.wt = max(w, 1); jv2.hk = 1; jv2.age = ju_age; ) : i == 3 ? ( jv3.wt = max(w, 1); jv3.hk = 1; jv3.age = ju_age; ) : i == 4 ? ( jv4.wt = max(w, 1); jv4.hk = 1; jv4.age = ju_age; ) : i == 5 ? ( jv5.wt = max(w, 1); jv5.hk = 1; jv5.age = ju_age; ) : i == 6 ? ( jv6.wt = max(w, 1); jv6.hk = 1; jv6.age = ju_age; ) : ( jv7.wt = max(w, 1); jv7.hk = 1; jv7.age = ju_age; ); );
// POLY: the same key's card, else a free one, else the quietest released one, else the oldest
function ju_play(n, v, w) local(i, pick, best) (
  pick = -1; i = 0; loop(8, pick < 0 && ju_vst(i) == 2 && ju_vk(i) == n ? pick = i; i += 1; );
  pick < 0 ? ( i = 0; loop(8, pick < 0 && ju_vst(i) == 0 ? pick = i; i += 1; ); );
  pick < 0 ? ( best = 1000000; i = 0; loop(8, ju_vst(i) == 2 && !ju_vhk(i) && ju_vag(i) < best ? ( best = ju_vag(i); pick = i; ); i += 1; ); );
  pick < 0 ? ( best = 1000000000000; i = 0; loop(8, ju_vst(i) != 4 && ju_vage(i) < best ? ( best = ju_vage(i); pick = i; ); i += 1; ); );
  pick < 0 ? pick = 0;
  ju_von(pick, n, v, w);
);
function ju_release(n) local(i) ( i = 0; loop(8, ju_vst(i) && ju_vk(i) == n ? ju_voff(i); i += 1; ); );
// UNISON: the stack's cards, their fan in pitch (cents) and across the field
function ju_ufan() local(i, t) (
  i = 0;
  loop(8,
    t = ju_mode && i < ju_stk ? (ju_stk > 1 ? i / (ju_stk - 1) * 2 - 1 : 0) : 0;
    ju_vfan(i, t, ju_mode && i < ju_stk ? t : ((i % 2) ? 1 : -1) * (0.25 + 0.25 * (3 - floor(i / 2))));
    i += 1;
  );
);
function ju_uon(n, v, w) local(i) (
  i = 0;
  loop(ju_stk,
    ju_nk > 0 && ju_vst(i) == 2 && ju_vhk(i) ? ju_vleg(i, n, v) : (
      ju_vprep(i, n, v, ju_vst(i) == 0);
      ju_vwt(i, w);
    );
    i += 1;
  );
);

// ---------- the delay's diffusers ----------
function ju_ap(base, n, x, k) instance(wp) local(d, v) (
  d = base[(wp - n) & JUAPM]; v = x + k * d; abs(v) < 0.000000000001 ? v = 0; base[wp] = v; wp = (wp + 1) & JUAPM;
  d - k * v;
);

// ---------- parameters ----------
function ju_update() local(t, i) (
  ju_isr = 1 / srate;
  ju_wt1 = slider1 >= 0.5; ju_co1 = floor(slider2 + 0.5); ju_pwt = slider3 / 100; ju_lv1t = slider4 / 100;
  ju_wt2 = slider5 >= 0.5; ju_co2 = floor(slider6 + 0.5) + slider7 / 100; ju_lv2t = slider8 / 100;
  ju_smt = slider9 >= 0.5; ju_lvst = slider10 / 100 * 0.9; ju_brt = slider11 / 100 * 0.6;
  ju_cott = log(min(max(slider12, 20), 20000)) / log(2); ju_res = slider13 / 100;
  ju_fenvt = slider14 / 100 * 6; ju_kt = slider15 / 100; ju_pmt = slider16 >= 0.5; ju_vb = slider17 / 100;
  ju_fac = ju_ca(slider18); ju_fdc = ju_cd(slider19); ju_fsl = slider20 / 100; ju_frc = ju_cd(slider21);
  ju_aac = ju_ca(slider22); ju_adc = ju_cd(slider23); ju_asl = slider24 / 100; ju_arc = ju_cd(slider25);
  ju_lkt = slider26 >= 0.5; ju_vl = slider27 / 100;
  ju_eamt = slider28; ju_etim = slider29 / 1000; ju_ecp = 2 ^ (-slider30 / 50); ju_evs = slider31 / 100;
  ju_dett = slider32 / 100;
  ju_r1h = slider33; ju_s1 = floor(slider34 + 0.5); ju_dl1 = slider35; ju_sy1 = floor(slider36 + 0.5);
  ju_r2h = slider37; ju_s2 = floor(slider38 + 0.5); ju_dl2 = slider39; ju_sy2 = floor(slider40 + 0.5);
  ju_dp1t = slider41; ju_dc1t = slider42 / 100 * 3; ju_dw1t = slider43 / 100 * 0.45; ju_dn1t = slider44 / 100;
  ju_dp2t = slider45; ju_dc2t = slider46 / 100 * 3; ju_dw2t = slider47 / 100 * 0.45; ju_dn2t = slider48 / 100;
  ju_wht = floor(slider49 + 0.5);
  ju_modet = slider50 >= 0.5; ju_stkt = min(max(floor(slider51 + 0.5), 2), 8);
  ju_glide = slider52 / 1000; ju_gleg = slider53 >= 0.5; ju_sprt = slider54 / 100; ju_brng = slider55;
  ju_chan = floor(slider56 + 0.5); ju_fa = slider57 / 50;
  ju_vsc = (ju_mode ? 1.5 / sqrt(ju_stk) : 1) * 0.72;
  ju_volt = 10 ^ (slider58 / 20) * sqr(slider59 / 100) * 1.5;
  ins_output_setup(60);   // output stage: CLIP, always on
  // DRIVE
  ju_din = slider66 >= 0.5; ju_ddrv = slider67 / 100; ju_dgain = 10 ^ (ju_ddrv * 30 / 20);
  ju_dtc = 1 - exp(-TWOPI * min(2200 * 2 ^ (slider68 / 100 * 3), srate * 0.45) / srate);
  // the make-up (measured on chords): the level holds as DRIVE rises
  ju_dmkt = 10 ^ ((slider69 - 15.3 * vo_tanh(ju_ddrv * 30 / 15)) / 20);
  // FLANGER, CHORUS
  ju_fin = slider70 >= 0.5; ju_finc = slider71 / srate; ju_fdpt = slider72 / 100 * 0.0065 * srate; ju_ffbt = slider73 / 100;
  ju_fmixt = slider74 / 100;
  ju_cin = slider75 >= 0.5; ju_crt = slider76; ju_cdpt = slider77 / 100; ju_cmixt = slider78 / 100;
  // DELAY
  ju_lin = slider79 >= 0.5; ju_lsy = slider80 >= 0.5; t = floor(slider82 + 0.5);
  t = t == 0 ? 0.25 : t == 1 ? 1 / 3 : t == 2 ? 0.5 : t == 3 ? 0.75 : t == 4 ? 2 / 3 : t == 5 ? 1 : t == 6 ? 1.5 : t == 7 ? 2 : t == 8 ? 3 :
      (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  ju_ltt = min(max((ju_lsy ? t * 60 / (tempo > 0 ? tempo : 120) : slider81 * 0.001) * srate, 8), JUDM - srate * 0.02);
  ju_lfbt = slider83 / 100; ju_ltc = 1 - exp(-TWOPI * min(900 * 2 ^ (slider84 / 100 * 4), srate * 0.45) / srate);
  ju_lwow = slider85 / 100; ju_ldift = slider86 / 100 * 0.62; ju_lmixt = slider87 / 100;
  // the scope's window: the embouchure and the filter's attack and decay, 0.25 - 2.5 s, over 256 points
  t = min(max(max(2.5 * ju_etim, (slider18 + 0.6 * slider19) * 0.001) + 0.1, 0.25), 2.5);
  ju_scW = t; ju_scDn = max(ceil(t * srate / 16 / 256), 1);
);

function ju_clear() (
  jv0.ju_init(0);
  jv1.ju_init(1);
  jv2.ju_init(2);
  jv3.ju_init(3);
  jv4.ju_init(4);
  jv5.ju_init(5);
  jv6.ju_init(6);
  jv7.ju_init(7);
  memset(JUFL, 0, 2 * 4096); memset(JUCL, 0, 2 * 8192); memset(JUAPB, 0, 4 * 2048); memset(JUDL, 0, 2 * 262144);
  ju_lf1 = ju_lf2 = ju_lh1 = ju_lh2 = 0; ju_cbl = ju_cbr = 0; ju_ffl = ju_ffr = 0;
  ju_dcxl = ju_dcxr = ju_dcyl = ju_dcyr = 0; ju_dtl = ju_dtr = 0;
  ju_dfL.clp_pf_reset(); ju_dfR.clp_pf_reset(); ju_dcL.clp_reset(); ju_dcR.clp_reset();
  ju_nh = 0; ju_age = 0; ju_lastn = -1;
  ju_mode = ju_modet; ju_stk = ju_stkt; ju_ufan();
);
function ju_srinit() (
  ju_sr = srate; ost_init(0);
  ju_tks = 16 / srate;
  ju_sk = 1 - exp(-16 / (0.02 * srate));                   // the controls: 20 ms
  ju_ok = 1 - exp(-16 / (0.012 * srate));                  // the link's crossfade: 12 ms
  ju_ps = 1 - exp(-1 / (0.012 * srate)); ju_ps2 = 1 - exp(-1 / (0.02 * srate));   // per sample: 12 ms, 20 ms
  ju_blk = exp(-16 / (0.33 * srate));                      // the landing detune settles over a third of a second
  ju_fdk = 1 / (0.004 * srate);                            // a stolen card fades out in 4 ms
  ju_sm_ = 1 - exp(-1 / (0.03 * srate));
  ju_fmax = min(20000, 0.45 * srate);
  ju_cbase = 0.011 * srate; ju_cdep = 0.0055 * srate; ju_cbk = 1 - exp(-TWOPI * 7500 / srate);
  ju_lsk = 1 - exp(-1 / (0.15 * srate));                   // the tape's speed glides to a new time
  ju_lhk = 1 - exp(-TWOPI * 90 / srate);
  ju_pcdn = 1 / (0.012 * srate); ju_pcup = 1 / (0.02 * srate);   // preset change: 12 ms out, 20 ms in
  JUTMP[190] = min(floor(4.3 * srate / 1000), JUAPM - 2); JUTMP[191] = min(floor(7.7 * srate / 1000), JUAPM - 2);
  JUTMP[192] = min(floor(5.1 * srate / 1000), JUAPM - 2); JUTMP[193] = min(floor(8.9 * srate / 1000), JUAPM - 2);
  ju_lrof = 0.0007 * srate;
  ju_dfL.clp_pf_cfg(40000, 9000, -1.5, 150); ju_dfR.clp_pf_cfg(40000, 9000, -1.5, 150);
  ju_dkt.clp_kt_cfg(0.5, 1.0);
  ju_update();
  ju_first = 1;
);

ins_drift_init();
jv0.ju_init(0);
jv1.ju_init(1);
jv2.ju_init(2);
jv3.ju_init(3);
jv4.ju_init(4);
jv5.ju_init(5);
jv6.ju_init(6);
jv7.ju_init(7);
ju_age = 0; ju_ct = 15; ju_pcf = 0; ju_pcg = 1; ju_ped = 0; ju_bnd = ju_bndt = 0; ju_nh = 0; ju_lastn = -1; ju_whl = ju_whlt = 0;
ju_p1 = 0; ju_p2 = 0.37; ju_c1 = 0; ju_c2 = 0; ju_l1v = ju_l2v = 0; ju_scv = -1; ju_sck = 0; ju_scD = 1;
ju_fph = 0; ju_fw = 0; ju_cw = 0; ju_dw = 0; ju_cc = 1; ju_cs = 0; ju_drg = ju_flg = ju_chg = ju_lg = 0; ju_lts = -1;
ju_wp1 = 0; ju_wp2 = 0; ju_wow = ju_wowi = 0;
ju_srinit();
ju_mode = ju_modet; ju_stk = ju_stkt; ju_ufan();
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
!ju_pcf && !ju_panic ? ju_update();

@block
srate != ju_sr ? ju_srinit();
// a preset change (or a new voice mode / stack): the sound fades out (12 ms), all is cleared at the silent point,
// then it fades in (20 ms)
(ju_modet != ju_mode || (ju_stkt != ju_stk && ju_mode)) && !ju_pcf ? ju_panic = 1;
ju_panic && !ju_pcf ? ( ju_pcf = 1; ju_panic = 0; );
ju_pcf == 2 ? ( ju_update(); ju_clear(); ju_first = 1; ju_pcf = 3; );
ju_pcf != 1 ? ju_update();

// ---------- MIDI ----------
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, ju_chan) && ju_pcf == 0 ? (
    ju_st = m1 & 0xF0;
    ju_st == 0x90 && m3 > 0 ? (
      ins_midi_hit();
      ju_v = m3 / 127;
      ju_gon = ju_glide > 0.0005 && ju_lastn >= 0 && (!ju_gleg || ju_nh > 0);
      ju_nk = ju_nh;
      // the keys held (UNISON plays the newest)
      i_ = 0; j_ = 0; loop(ju_nh, JUHN[i_] != m2 ? ( JUHN[j_] = JUHN[i_]; JUHN[j_ + 200] = JUHN[i_ + 200]; j_ += 1; ); i_ += 1; ); ju_nh = j_;
      ju_nh < 64 ? ( JUHN[ju_nh] = m2; JUHN[ju_nh + 200] = ju_v; ju_nh += 1; );
      ju_mode ? ju_uon(m2, ju_v, mofs) : ju_play(m2, ju_v, mofs);
      ju_lastn = m2;
    ) : ju_st == 0x80 || (ju_st == 0x90 && m3 == 0) ? (
      i_ = 0; j_ = 0; ju_w_ = ju_nh > 0 && JUHN[ju_nh - 1] == m2;
      loop(ju_nh, JUHN[i_] != m2 ? ( JUHN[j_] = JUHN[i_]; JUHN[j_ + 200] = JUHN[i_ + 200]; j_ += 1; ); i_ += 1; ); ju_nh = j_;
      ju_mode ? (
        // UNISON: back to the newest key still held (joined), else the stack is let go
        ju_nh > 0 ? ( ju_w_ ? ( ju_gon = ju_glide > 0.0005; ju_nk = 1; i_ = 0; loop(ju_stk, ju_vleg(i_, JUHN[ju_nh - 1], JUHN[ju_nh + 199]); i_ += 1; ); ju_lastn = JUHN[ju_nh - 1]; ); ) :
        ( i_ = 0; loop(ju_stk, ju_voff(i_); i_ += 1; ); );
      ) : ju_release(m2);
    ) : ju_st == 0xE0 ? (
      ju_bndt = (((m3 * 128 + m2) - 8192) / 8192) * ju_brng;
    ) : ju_st == 0xB0 ? (
      m2 == 64 ? ju_ped = m3 >= 64 :
      m2 == 1 ? ju_whlt = m3 / 127 :
      m2 == 120 || m2 == 123 ? ( ju_nh = 0; i_ = 0; loop(8, ju_voff(i_); i_ += 1; ); );
    );
  );
  midisend(mofs, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( ju_nh = 0; i_ = 0; loop(8, ju_voff(i_); i_ += 1; ); );
gfx_pst_prev = gfx_pst;

// ---------- FATE: the whole instrument wanders a little ----------
ins_drift_block(ju_fa * 0.12, samplesblock);

// ---------- the LFOs: free, or locked to the timeline while REAPER plays ----------
ju_sy1 ? ( ju_t = ju_divq(ju_sy1); ju_inc1 = (tempo > 0 ? tempo : 120) / 60 / ju_t * ju_tks;
           play_state & 1 ? ( ju_t = beat_position / ju_t; ju_c1 = floor(ju_t); ju_p1 = ju_t - ju_c1; ); ) : ju_inc1 = ju_r1h * ju_tks;
ju_sy2 ? ( ju_t = ju_divq(ju_sy2); ju_inc2 = (tempo > 0 ? tempo : 120) / 60 / ju_t * ju_tks;
           play_state & 1 ? ( ju_t = beat_position / ju_t; ju_c2 = floor(ju_t); ju_p2 = ju_t - ju_c2; ); ) : ju_inc2 = ju_r2h * ju_tks;

// ---------- DRIVE: the pre-filter, the knee, the transformer's lean ----------
ju_dfL.clp_pf_block(ju_ddrv, srate, samplesblock); ju_dfR.clp_pf_block(ju_ddrv, srate, samplesblock);
ju_t = ju_dkt.clp_kt_block(ju_ddrv, srate, samplesblock);
ju_dcL.clp_set(2, 1, 1.2, 0); ju_dcR.clp_set(2, 1, 1.2, 0); ju_dcL.clp_knee(ju_t); ju_dcR.clp_knee(ju_t);
ju_dbias = 0.1 * ju_ddrv; ju_drest = ju_dcL.clp_crv(ju_dbias);
ju_dcL.clp_tidy(); ju_dcR.clp_tidy();
// the drive fully out: its states rest, so it comes back in from nothing
ju_drg == 0 ? ( ju_dtl = ju_dtr = 0; ju_dfL.clp_pf_reset(); ju_dfR.clp_pf_reset(); ju_dcL.clp_reset(); ju_dcR.clp_reset(); );
abs(ju_dtl) + abs(ju_dtr) < 0.0000000001 ? ju_dtl = ju_dtr = 0;
// the flanger, chorus and delay switched fully out are emptied, so they come back clean
ju_t = TWOPI * ju_crt / srate; ju_ccw = cos(ju_t); ju_csw = sin(ju_t);
ju_t = sqrt(ju_cc * ju_cc + ju_cs * ju_cs); ju_cc /= ju_t; ju_cs /= ju_t;
ju_lg > 0.0001 ? ju_lact = 1 : ju_lact ? ( memset(JUDL, 0, 2 * 262144); memset(JUAPB, 0, 4 * 2048); ju_lf1 = ju_lf2 = ju_lh1 = ju_lh2 = 0; ju_lact = 0; );
abs(ju_lf1) + abs(ju_lf2) < 0.0000000001 ? ju_lf1 = ju_lf2 = 0;
abs(ju_lh1) + abs(ju_lh2) < 0.0000000001 ? ju_lh1 = ju_lh2 = 0;
abs(ju_cbl) + abs(ju_cbr) < 0.0000000001 ? ju_cbl = ju_cbr = 0;
abs(ju_dcyl) + abs(ju_dcyr) < 0.0000000001 ? ju_dcyl = ju_dcyr = 0;
ju_lts < 0 ? ju_lts = ju_ltt;
ju_nact = 0; i_ = 0; loop(8, ju_vst(i_) ? ju_nact += 1; i_ += 1; );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, jg_emode);

@sample
// ---------- the control tick (every 16 samples) ----------
ju_ct += 1;
ju_ct >= 16 ? (
  ju_ct = 0;
  ju_first ? (
    ju_coct = ju_cott; ju_det = ju_dett; ju_lk = ju_lkt; ju_pm = ju_pmt; ju_wm1 = ju_wt1; ju_wm2 = ju_wt2; ju_sm = ju_smt;
    ju_lv1 = ju_lv1t; ju_lv2 = ju_lv2t; ju_lvs = ju_lvst; ju_pw = ju_pwt; ju_fenv = ju_fenvt; ju_spr = ju_sprt;
    ju_vol = ju_volt; ju_bnd = ju_bndt; ju_dmk = ju_dmkt; ju_fdp = ju_fdpt; ju_ffb = ju_ffbt; ju_fmix = ju_fmixt;
    ju_cdp = ju_cdpt; ju_cmix = ju_cmixt; ju_lfb = ju_lfbt; ju_lmix = ju_lmixt; ju_ldif = ju_ldift;
    ju_first = 0;
  );
  // the controls glide; the switches crossfade (and land exactly)
  ju_coct += (ju_cott - ju_coct) * ju_sk; ju_det += (ju_dett - ju_det) * ju_sk; ju_fenv += (ju_fenvt - ju_fenv) * ju_sk;
  ju_pw += (ju_pwt - ju_pw) * ju_sk; ju_spr += (ju_sprt - ju_spr) * ju_sk; ju_bnd += (ju_bndt - ju_bnd) * ju_sk;
  ju_whl += (ju_whlt - ju_whl) * ju_sk;
  ju_lk += (ju_lkt - ju_lk) * ju_ok; abs(ju_lk - ju_lkt) < 0.001 ? ju_lk = ju_lkt;
  // (the crossfades that run in the audio itself glide per sample, below; here they land exactly)
  abs(ju_pm - ju_pmt) < 0.0002 ? ju_pm = ju_pmt; abs(ju_wm1 - ju_wt1) < 0.0002 ? ju_wm1 = ju_wt1;
  abs(ju_wm2 - ju_wt2) < 0.0002 ? ju_wm2 = ju_wt2; abs(ju_sm - ju_smt) < 0.0002 ? ju_sm = ju_smt;
  ju_drg < 0.0002 && !ju_din ? ju_drg = 0; ju_flg < 0.0002 && !ju_fin ? ju_flg = 0;
  ju_chg < 0.0002 && !ju_cin ? ju_chg = 0; ju_lg < 0.0002 && !ju_lin ? ju_lg = 0;
  // the resonance: the ladder's loop gain (with its bass make-up), the state-variable's damping
  ju_r1 = 2 ^ ((ju_co1 - ju_det * 0.012) / 12); ju_r2 = 2 ^ ((ju_co2 + ju_det * 0.035) / 12);
  ju_kl = ju_res * 4.1; ju_kmk = 1 + 0.42 * ju_kl; ju_kq = 1.45 * (1 - ju_res) + 0.06;
  // the LFOs; the wheel brings in the LFO(s) it is set to
  ju_p1 += ju_inc1; ju_p1 >= 1 ? ( ju_p1 -= floor(ju_p1); ju_c1 += 1; );
  ju_p2 += ju_inc2; ju_p2 >= 1 ? ( ju_p2 -= floor(ju_p2); ju_c2 += 1; );
  ju_l1v = ju_lfo(ju_p1, ju_s1, ju_c1); ju_l2v = ju_lfo(ju_p2, ju_s2, ju_c2 + 17);
  ju_t = ju_wht == 1 || ju_wht == 3 ? ju_whl : 1;
  ju_dp1 = ju_dp1t * ju_t; ju_dc1 = ju_dc1t * ju_t; ju_dw1 = ju_dw1t * ju_t; ju_dn1 = ju_dn1t * ju_t;
  ju_t = ju_wht >= 2 ? ju_whl : 1;
  ju_dp2 = ju_dp2t * ju_t; ju_dc2 = ju_dc2t * ju_t; ju_dw2 = ju_dw2t * ju_t; ju_dn2 = ju_dn2t * ju_t;
  // the voice cards
  jv0.st ? jv0.ju_tk();
  jv1.st ? jv1.ju_tk();
  jv2.st ? jv2.ju_tk();
  jv3.st ? jv3.ju_tk();
  jv4.st ? jv4.ju_tk();
  jv5.st ? jv5.ju_tk();
  jv6.st ? jv6.ju_tk();
  jv7.st ? jv7.ju_tk();
  // FX: IN / OUT glide; their settings glide
  ju_fdp += (ju_fdpt - ju_fdp) * ju_sk; ju_cdp += (ju_cdpt - ju_cdp) * ju_sk; ju_ldif += (ju_ldift - ju_ldif) * ju_sk;
  // the tape's wow (0.55 Hz) and flutter (6.3 Hz): its read point, ramped over the tick
  ju_wp1 += 0.55 * ju_tks; ju_wp1 -= floor(ju_wp1); ju_wp2 += 6.3 * ju_tks; ju_wp2 -= floor(ju_wp2);
  ju_t = ju_lwow * srate * (0.0028 * (1 + sin(TWOPI * ju_wp1)) + 0.00018 * (1 + sin(TWOPI * ju_wp2)));
  ju_wowi = (ju_t - ju_wow) * JUK;
);

// ---------- per sample: the crossfades and gains in the audio path glide smoothly (12 ms / 20 ms) ----------
ju_pm += (ju_pmt - ju_pm) * ju_ps; ju_wm1 += (ju_wt1 - ju_wm1) * ju_ps; ju_wm2 += (ju_wt2 - ju_wm2) * ju_ps; ju_sm += (ju_smt - ju_sm) * ju_ps;
ju_lv1 += (ju_lv1t - ju_lv1) * ju_ps2; ju_lv2 += (ju_lv2t - ju_lv2) * ju_ps2; ju_lvs += (ju_lvst - ju_lvs) * ju_ps2;
ju_drg += (ju_din - ju_drg) * ju_ps2; ju_dmk += (ju_dmkt - ju_dmk) * ju_ps2;
ju_flg += (ju_fin - ju_flg) * ju_ps2; ju_ffb += (ju_ffbt - ju_ffb) * ju_ps2; ju_fmix += (ju_fmixt - ju_fmix) * ju_ps2;
ju_chg += (ju_cin - ju_chg) * ju_ps2; ju_cmix += (ju_cmixt - ju_cmix) * ju_ps2;
ju_lg += (ju_lin - ju_lg) * ju_ps2; ju_lfb += (ju_lfbt - ju_lfb) * ju_ps2; ju_lmix += (ju_lmixt - ju_lmix) * ju_ps2;

// ---------- the eight voice cards ----------
ju_ol = ju_or = 0;
jv0.st ? ( ju_y = jv0.ju_run(); ju_ol += ju_y * jv0.gl; ju_or += ju_y * jv0.gr; );
jv1.st ? ( ju_y = jv1.ju_run(); ju_ol += ju_y * jv1.gl; ju_or += ju_y * jv1.gr; );
jv2.st ? ( ju_y = jv2.ju_run(); ju_ol += ju_y * jv2.gl; ju_or += ju_y * jv2.gr; );
jv3.st ? ( ju_y = jv3.ju_run(); ju_ol += ju_y * jv3.gl; ju_or += ju_y * jv3.gr; );
jv4.st ? ( ju_y = jv4.ju_run(); ju_ol += ju_y * jv4.gl; ju_or += ju_y * jv4.gr; );
jv5.st ? ( ju_y = jv5.ju_run(); ju_ol += ju_y * jv5.gl; ju_or += ju_y * jv5.gr; );
jv6.st ? ( ju_y = jv6.ju_run(); ju_ol += ju_y * jv6.gl; ju_or += ju_y * jv6.gr; );
jv7.st ? ( ju_y = jv7.ju_run(); ju_ol += ju_y * jv7.gl; ju_or += ju_y * jv7.gr; );
ju_ol *= ju_vsc; ju_or *= ju_vsc;

// ---------- DRIVE ----------
ju_drg > 0 ? (
  ju_x = ju_dcL.clp_run(ju_dfL.clp_pf_run(ju_ol) * ju_dgain + ju_dbias) - ju_drest; ju_dtl += (ju_x - ju_dtl) * ju_dtc;
  ju_x = ju_dcR.clp_run(ju_dfR.clp_pf_run(ju_or) * ju_dgain + ju_dbias) - ju_drest; ju_dtr += (ju_x - ju_dtr) * ju_dtc;
  ju_ol += (ju_dtl * ju_dmk - ju_ol) * ju_drg; ju_or += (ju_dtr * ju_dmk - ju_or) * ju_drg;
);

// ---------- FLANGER: a swept short delay with feedback, the right side a quarter-cycle on ----------
!(ju_flg > 0) ? ( JUFL[ju_fw] = ju_ol; JUFR[ju_fw] = ju_or; ) : (
  ju_fph += ju_finc; ju_fph >= 1 ? ju_fph -= 1;
  ju_t = ju_fph + 0.25; ju_t -= floor(ju_t);
  ju_d = 0.0003 * srate + ju_fdp * abs(2 * ju_fph - 1);
  ju_rp = ju_fw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUFL[ju_ri & JUFM]; ju_wl = ju_a + (JUFL[(ju_ri + 1) & JUFM] - ju_a) * ju_rf;
  ju_d = 0.0003 * srate + ju_fdp * abs(2 * ju_t - 1);
  ju_rp = ju_fw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUFR[ju_ri & JUFM]; ju_wr = ju_a + (JUFR[(ju_ri + 1) & JUFM] - ju_a) * ju_rf;
  ju_a = ju_ol + ju_ffb * ju_flg * ju_wl; JUFL[ju_fw] = abs(ju_a) < 0.000000000001 ? 0 : ju_a;
  ju_a = ju_or + ju_ffb * ju_flg * ju_wr; JUFR[ju_fw] = abs(ju_a) < 0.000000000001 ? 0 : ju_a;
  ju_t = ju_fmix * ju_flg * 0.5;
  ju_ol += (ju_wl - ju_ol) * ju_t; ju_or += (ju_wr - ju_or) * ju_t;
);
ju_fw = (ju_fw + 1) & JUFM;

// ---------- CHORUS: three dark voices a side, 120 degrees apart (the right side turned 60 degrees on) ----------
JUCL[ju_cw] = ju_ol; JUCR[ju_cw] = ju_or;
ju_chg > 0 ? (
  ju_t = ju_cc * ju_ccw - ju_cs * ju_csw; ju_cs = ju_cs * ju_ccw + ju_cc * ju_csw; ju_cc = ju_t;
  ju_q1 = ju_cs * -0.5 + ju_cc * 0.8660254; ju_q2 = ju_cs * -0.5 - ju_cc * 0.8660254;
  ju_d = ju_cbase + ju_cdep * ju_cdp * (1 + ju_cs);
  ju_rp = ju_cw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUCL[ju_ri & JUCM]; ju_wl = ju_a + (JUCL[(ju_ri + 1) & JUCM] - ju_a) * ju_rf;
  ju_d = ju_cbase * 1.21 + ju_cdep * ju_cdp * (1 + ju_q1);
  ju_rp = ju_cw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUCL[ju_ri & JUCM]; ju_wl += ju_a + (JUCL[(ju_ri + 1) & JUCM] - ju_a) * ju_rf;
  ju_d = ju_cbase * 1.43 + ju_cdep * ju_cdp * (1 + ju_q2);
  ju_rp = ju_cw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUCL[ju_ri & JUCM]; ju_wl += ju_a + (JUCL[(ju_ri + 1) & JUCM] - ju_a) * ju_rf;
  ju_d = ju_cbase * 1.1 + ju_cdep * ju_cdp * (1 - ju_cs);
  ju_rp = ju_cw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUCR[ju_ri & JUCM]; ju_wr = ju_a + (JUCR[(ju_ri + 1) & JUCM] - ju_a) * ju_rf;
  ju_d = ju_cbase * 1.32 + ju_cdep * ju_cdp * (1 - ju_q1);
  ju_rp = ju_cw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUCR[ju_ri & JUCM]; ju_wr += ju_a + (JUCR[(ju_ri + 1) & JUCM] - ju_a) * ju_rf;
  ju_d = ju_cbase * 1.52 + ju_cdep * ju_cdp * (1 - ju_q2);
  ju_rp = ju_cw - ju_d; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri; ju_a = JUCR[ju_ri & JUCM]; ju_wr += ju_a + (JUCR[(ju_ri + 1) & JUCM] - ju_a) * ju_rf;
  ju_cbl += (ju_wl - ju_cbl) * ju_cbk; ju_cbr += (ju_wr - ju_cbr) * ju_cbk;
  ju_t = ju_cmix * ju_chg;
  ju_ol += (ju_cbl * 0.4 - ju_ol * 0.3) * ju_t; ju_or += (ju_cbr * 0.4 - ju_or * 0.3) * ju_t;
);
ju_cw = (ju_cw + 1) & JUCM;

// ---------- DELAY: tape - the speed glides, wow and flutter, the repeats darkened, diffused and saturated ----------
ju_lg > 0 ? (
  ju_lts += (ju_ltt - ju_lts) * ju_lsk; ju_wow += ju_wowi;
  ju_rp = ju_dw - ju_lts - ju_wow; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri;
  ju_a = JUDL[ju_ri & JUDM]; ju_el = ju_a + (JUDL[(ju_ri + 1) & JUDM] - ju_a) * ju_rf;
  ju_rp -= ju_lrof; ju_ri = floor(ju_rp); ju_rf = ju_rp - ju_ri;
  ju_a = JUDR[ju_ri & JUDM]; ju_er = ju_a + (JUDR[(ju_ri + 1) & JUDM] - ju_a) * ju_rf;
  ju_lf1 += (ju_el - ju_lf1) * ju_ltc; ju_lf2 += (ju_er - ju_lf2) * ju_ltc;
  ju_lh1 += (ju_lf1 - ju_lh1) * ju_lhk; ju_lh2 += (ju_lf2 - ju_lh2) * ju_lhk;
  ju_el = ju_lf1 - ju_lh1; ju_er = ju_lf2 - ju_lh2;
  ju_x = jd0.ju_ap(JUAPB, JUTMP[190], ju_el, ju_ldif); ju_x = jd1.ju_ap(JUAPB + 2048, JUTMP[191], ju_x, ju_ldif);
  ju_a = vo_tanh(ju_ol * ju_lg + ju_lfb * ju_x); JUDL[ju_dw] = abs(ju_a) < 0.000000000001 ? 0 : ju_a;
  ju_x = jd2.ju_ap(JUAPB + 4096, JUTMP[192], ju_er, ju_ldif); ju_x = jd3.ju_ap(JUAPB + 6144, JUTMP[193], ju_x, ju_ldif);
  ju_a = vo_tanh(ju_or * ju_lg + ju_lfb * ju_x); JUDR[ju_dw] = abs(ju_a) < 0.000000000001 ? 0 : ju_a;
  ju_t = ju_lmix * ju_lg; ju_ol += ju_el * ju_t; ju_or += ju_er * ju_t;
);
ju_dw = (ju_dw + 1) & JUDM;

// DC block
ju_dcyl = ju_ol - ju_dcxl + 0.9997 * ju_dcyl; ju_dcxl = ju_ol; ju_ol = ju_dcyl;
ju_dcyr = ju_or - ju_dcxr + 0.9997 * ju_dcyr; ju_dcxr = ju_or; ju_or = ju_dcyr;

// ---------- MASTER ----------
ju_pcf == 1 ? ( ju_pcg -= ju_pcdn; ju_pcg <= 0 ? ( ju_pcg = 0; ju_pcf = 2; ); ) :
ju_pcf == 3 ? ( ju_pcg += ju_pcup; ju_pcg >= 1 ? ( ju_pcg = 1; ju_pcf = 0; ); );
ju_vol += (ju_volt - ju_vol) * ju_sm_;
ju_ol *= ju_pcg * ju_vol; ju_or *= ju_pcg * ju_vol;
ju_ol = ostL.ost_band(ju_ol); ju_or = ostR.ost_band(ju_or);
ost_out(ju_ol, ju_or);
spl0 = ost_l; spl1 = ost_r;
ju_pk = max(ju_pk, max(abs(spl0), abs(spl1)));

@gfx 1200 850
ui_thm = 5; ui_hw = 1;
ui_begin(1200, 850);

// ---------- the card's colours: heavy polished raw brass, deep black engraving, the amber vector scope ----------
FACE = 0xC9A23C; FACEL = 0xE4C46A; FACED = 0x9A7826; TRAY = 0xBD9634; ETCH = 0x2A1F08; INK = 0x0D0B07;
BAND = 0x17140E; RULE = 0xE8C65A; LBL = 0x1A140A; CHL = 0xF2D88C; HAZ = 0xEDBB1C;
KSK = 0x2A251D; KSKL = 0x4E4535; KCAP = 0x3A342A; PTR = 0xF5DA8A;
KEYOFF = 0x29241B; KEYHOV = 0x3F3829; KEYT = 0xEBD28E;
AMB = 0xFFB220; AMBL = 0xFFDC90; AMBD = 0xB27008; AMBF = 0x3E2705; SCR = 0x0F0A03; SCRH = 0x23190A;

// fonts, calibrated once per scale (a reference word fills the same width everywhere); large, for reading
sc != jg_calsc ? (
  jg_calsc = sc;
  jg_f11 = ui_fitfont(11, 13 * sc);         // key captions, small print
  jg_f12 = ui_fitfont(12, 15.5 * sc);       // section titles
  jg_f13 = ui_fitfont(13, 14.5 * sc);       // knob labels, values, fields
);
gfx_setfont(11, "Arial", jg_f11, 'b'); gfx_setfont(12, "Arial", jg_f12, 'b');
gfx_setfont(13, "Arial", jg_f13, 'b');
gfx_setfont(14, "Arial Black", 27 * sc);       // the card's name
gfx_setfont(15, "Arial Black", 17 * sc);       // the numeral

// ---------- drawing helpers (base coordinates) ----------
function jg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function jg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function jg_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function jg_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function jg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(x * sc - tw + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function jg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function jg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function jg_lnp(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  w *= 0.5; dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : (
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
    gfx_circle(x1, y1, w, 1, 1); gfx_circle(x2, y2, w, 1, 1);
  );
);
function jg_ln(x1, y1, x2, y2, w) ( jg_lnp(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc); );
function jg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function jg_ring(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); );
function jg_disc(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
// sparse brushing lines over a box: flat means, no textures
function jg_brush(x, y, w, h, n, seed) local(i, yy, x0, l) (
  i = 0;
  loop(n,
    yy = y + 1 + ui_hash(seed + i * 3.1) * (h - 2); x0 = x + ui_hash(seed + i * 7.7) * w * 0.7;
    l = min(w * (0.15 + 0.6 * ui_hash(seed + i * 1.3)), x + w - x0);
    ui_cola(i & 1 ? 0xFFF4C8 : ETCH, i & 1 ? 0.26 : 0.07); jg_r(x0, yy, l, 1);
    i += 1;
  );
);
// a precision alignment crosshair, engraved
function jg_cross(cx, cy, r) (
  ui_cola(ETCH, 0.8); jg_r(cx - r, cy - 0.5, 2 * r, 1); jg_r(cx - 0.5, cy - r, 1, 2 * r); jg_ring(cx, cy, r * 0.55);
);
// black hazard stripes over a band (the ends capped in ink)
function jg_haz(x, y, w, h) local(i, n, a) (
  ui_col(INK); jg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  ui_col(HAZ); jg_r(x, y, w, h);
  ui_col(INK); n = floor((w - h * 1.7) / (h * 1.4)) + 1; a = x + (w - h * 1.7 - (n - 1) * h * 1.4) * 0.5;
  loop(n, gfx_triangle(a * sc, (y + h) * sc, (a + h * 0.7) * sc, (y + h) * sc, (a + h * 1.7) * sc, y * sc, (a + h) * sc, y * sc); a += h * 1.4; );
);
// a section: an ink frame, the brushed brass tray, a black title band ruled in bright brass
function jg_sect(x, y, w, h, title) (
  ui_col(INK); jg_r(x - 1.5, y - 1.5, w + 3, h + 3);
  ui_col(TRAY); jg_r(x, y, w, h);
  jg_brush(x, y + 25, w, h - 25, floor(w * h / 1500), x * 0.37 + y * 0.11);
  ui_cola(0xFFF4C8, 0.35); jg_r(x, y + h - 1, w, 1); jg_r(x + w - 1, y + 25, 1, h - 25);
  ui_col(BAND); jg_r(x, y, w, 24);
  ui_col(RULE); jg_r(x, y + 24, w, 1.5);
  strlen(title) ? ( gfx_setfont(12); ui_col(CHL); jg_t(x + 10, y + 4, title); );
);
function jg_cap(x, y, s) ( gfx_setfont(11); ui_col(LBL); jg_t(x, y, s); );
// the value pill (shown only while a control is touched)
function jg_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 7 * sc, y * sc, tw + 14 * sc, th + 4 * sc, 3 * sc);
  ui_col(AMB); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, y * sc + 1 * sc, tw + 12 * sc, th + 2 * sc, 2.5 * sc);
  ui_col(INK); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);

// ---------- the knobs: heavy cast-metal pointer knobs ----------
// engraved telemetry ticks round the knob, the value arc in black, a cast skirt with grip notches, a flat cap and a
// strong pointer. big = the DETUNE knob (numbered 0 - 10). cap: 1 = a black cap (the low-pass)
function jg_kcap(cx, cy, r, n, bip, big, cap) local(rr, a, a0, ca, sa, w, i, b, t, nt) (
  rr = r + (big ? 7 : 5) * sc; w = (big ? 3.4 : 2.6) * sc; a0 = -0.75 * $pi;
  nt = big ? 21 : 11; i = 0;
  loop(nt, t = a0 + i / (nt - 1) * 1.5 * $pi; ui_cola(ETCH, 0.85);
    b = (big ? (i % 2 == 0 ? 9 : 5) : (i % 5 == 0 ? 6 : 3.5)) * sc;
    jg_lnp(cx + sin(t) * (rr + 3 * sc), cy - cos(t) * (rr + 3 * sc), cx + sin(t) * (rr + 3 * sc + b), cy - cos(t) * (rr + 3 * sc + b), 1.1 * sc);
    big && i % 2 == 0 ? ( gfx_setfont(11); ui_col(ETCH); sprintf(#jg_kn, "%d", i / 2);
      jg_tc((cx + sin(t) * (rr + 22 * sc)) / sc, (cy - cos(t) * (rr + 22 * sc)) / sc, #jg_kn); );
    i += 1; );
  ui_cola(INK, 0.3); jg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.1 * sc);
  ui_col(INK);
  bip ? ( abs(n - 0.5) > 0.004 ? jg_arcw(cx, cy, rr, min(a0 + n * 1.5 * $pi, 0), max(a0 + n * 1.5 * $pi, 0), w); ) :
        ( n > 0.004 ? ( jg_arcw(cx, cy, rr, a0, a0 + n * 1.5 * $pi, w); gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); ); );
  a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.32); gfx_circle(cx + 1.6 * sc, cy + 2.8 * sc, r, 1, 1);
  ui_col(INK); gfx_circle(cx, cy, r, 1, 1);
  ui_col(KSK); gfx_circle(cx, cy, r - 1.2 * sc, 1, 1);
  i = 0; loop(big ? 36 : 20, b = a + i / (big ? 36 : 20) * 2 * $pi; ui_col(KSKL);
    jg_lnp(cx + sin(b) * r * 0.82, cy - cos(b) * r * 0.82, cx + sin(b) * (r - 1.8 * sc), cy - cos(b) * (r - 1.8 * sc), (big ? 1.6 : 1.1) * sc); i += 1; );
  ui_col(INK); gfx_circle(cx, cy, r * 0.74, 1, 1);
  ui_col(cap == 1 ? 0x101010 : KCAP); gfx_circle(cx, cy, r * 0.71, 1, 1);
  ui_cola(0xFFFFFF, cap == 1 ? 0.1 : 0.16); gfx_arc(cx, cy, r * 0.69, -1.1, 0.3, 1);
  ui_col(INK); jg_lnp(cx + ca * r * 0.05, cy + sa * r * 0.05, cx + ca * r * 0.98, cy + sa * r * 0.98, max(4.2 * sc, r * 0.2));
  ui_col(PTR); jg_lnp(cx + ca * r * 0.1, cy + sa * r * 0.1, cx + ca * r * 0.93, cy + sa * r * 0.93, max(2.4 * sc, r * 0.11));
);
// a knob: drag, SHIFT = fine, double-click (or Ctrl-click) = default, wheel; stp > 0 rounds to steps
function jg_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp, big, cap) local(v, n, dx, dy, hov, did) (
  did = 2000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - jg_lt < 0.35 && jg_lid == idx && !jg_mv) || (mouse_cap & 4) ? ( jg_set(idx, def); drag_id = -1; jg_lt = 0; ) : (
      drag_id = did; jg_ky = mouse_y; jg_ky0 = mouse_y; jg_mv = 0; jg_lt = time_precise(); jg_lid = idx;
      jg_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !jg_mv && abs(mouse_y - jg_ky0) > 3 * sc ? ( jg_mv = 1; jg_ky = mouse_y; );
  drag_id == did && jg_mv ? (
    jg_kn = min(max(jg_kn + (jg_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); jg_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ jg_kn : lo + jg_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) !== v ? jg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    jg_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1);
  jg_kcap(cx * sc, cy * sc, r * sc, n, lo < 0 && hi > 0, big, cap);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.1); gfx_circle(cx * sc, cy * sc, r * 0.7 * sc, 1, 1);
    sprintf(#jg_vv, fmt, v);
    jg_pill(cx, cy + r + (big ? 10 : 7), #jg_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(strlen(label) > 7 ? 11 : 13); ui_col(LBL); jg_tc(cx, cy + r + 14, label); );
  );
);
// a knob with its value pill held to the right of a small knob (the matrix), no label below
function jg_hovk(cx, cy, r) ( sqr(mouse_x - cx * sc) + sqr(mouse_y - cy * sc) <= sqr((r + 6) * sc); );

// ---------- lit keys (amber = on); returns 1 when clicked ----------
function jg_key(x, y, w, h, on, s) local(hov, hit) (
  hov = jg_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(AMBL, 0.42); jg_rr(x - 2.5, y - 2.5, w + 5, h + 5, 4); );
  ui_cola(0x000000, 0.32); jg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); jg_rr(x, y, w, h, 3);
  ui_col(on ? AMB : hov ? KEYHOV : KEYOFF); jg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  on ? ( ui_cola(0xFFFFFF, 0.45); jg_r(x + 3.5, y + 2.5, w - 7, 1.2); ) : ( ui_cola(0xFFFFFF, 0.1); jg_r(x + 3.5, y + 2.5, w - 7, 1); );
  strlen(s) ? ( gfx_setfont(11); ui_col(on ? INK : KEYT); jg_tc(x + w * 0.5, y + h * 0.5, s); );
  hit;
);
function jg_toggle(x, y, w, h, idx, s) ( jg_key(x, y, w, h, slider(idx) >= 0.5, s) ? jg_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// ---------- the drop-down box: the setting in amber; a click opens the list (the current one ticked), the wheel steps ----------
function jg_dd(x, y, w, h, idx, lo, n, list, s) local(hov, i, k) (
  hov = jg_hov(x, y, w, h);
  ui_cola(0x000000, 0.28); jg_rr(x + 1, y + 2, w, h, 3);
  ui_col(INK); jg_rr(x, y, w, h, 3);
  ui_col(hov ? SCRH : SCR); jg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 2);
  gfx_setfont(13); ui_col(AMB); jg_tc(x + (w - 12) * 0.5, y + h * 0.5, s);
  ui_col(AMBD); gfx_triangle((x + w - 15) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 7) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 11) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1; strcpy(#jg_m, ""); i = 0; k = floor(slider(idx) + 0.5) - lo;
    loop(n, i == k ? strcat(#jg_m, "!"); strcat(#jg_m, pk_pitem(list, i + 1, #jg_k)); i < n - 1 ? strcat(#jg_m, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#jg_m); i > 0 ? jg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    jg_set(idx, min(max(floor(slider(idx) + 0.5) - sign(mouse_wheel), lo), lo + n - 1)); mouse_wheel = 0;
  );
);
// ---------- the rugged fader (upright): a black slot with an amber fill, engraved scale, a cast cap with an amber index ----------
function jg_fader(x, y, len, idx, lo, hi, def, lg, fmt, label) local(v, n, hov, did, py, i, t) (
  did = 3000 + idx; v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1);
  hov = jg_hov(x - 16, y - 10, 32, len + 20);
  i = 0; loop(11, t = i / 10;
    ui_cola(ETCH, i == 0 || i == 10 || i == 5 ? 0.85 : 0.45);
    jg_r(x - 16, y + len - t * len, i % 5 == 0 ? 7 : 4, 1); jg_r(x + 16 - (i % 5 == 0 ? 7 : 4), y + len - t * len, i % 5 == 0 ? 7 : 4, 1);
    i += 1; );
  ui_col(INK); jg_rr(x - 4, y - 3, 8, len + 6, 3);
  ui_col(AMBD); jg_r(x - 1.5, y + len - n * len, 3, n * len);
  py = y + len - n * len;
  ui_cola(0x000000, 0.32); jg_rr(x - 14 + 1, py - 8 + 2.5, 28, 16, 2);
  ui_col(INK); jg_rr(x - 14, py - 8, 28, 16, 2);
  ui_col(hov || drag_id == did ? KSKL : KSK); jg_rr(x - 12.5, py - 6.5, 25, 13, 1.5);
  ui_cola(0xFFFFFF, 0.12); jg_r(x - 11, py - 5.5, 22, 1);
  ui_col(AMB); jg_r(x - 10, py - 1, 20, 2);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - jg_lt < 0.35 && jg_lid == idx) || (mouse_cap & 4) ? ( jg_set(idx, def); drag_id = -1; jg_lt = 0; ) :
    ( drag_id = did; jg_fy0 = mouse_y; jg_fn = n; jg_lt = time_precise(); jg_lid = idx; );
  );
  drag_id == did ? (
    t = jg_fy0 - mouse_y; jg_fy0 = mouse_y;
    jg_fn = min(max(jg_fn + t / (len * sc) * ((mouse_cap & 8) ? 0.15 : 1), 0), 1);
    v = lg ? lo * (hi / lo) ^ jg_fn : lo + jg_fn * (hi - lo); v = floor(v + 0.5);
    slider(idx) !== v ? jg_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    jg_set(idx, floor((lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo)) + 0.5)); mouse_wheel = 0;
  );
  (hov || drag_id == did) ? ( sprintf(#jg_vv, fmt, slider(idx)); jg_pill(x, y + len + 7, #jg_vv); ) :
    ( gfx_setfont(13); ui_col(LBL); jg_tc(x, y + len + 17, label); );
);
function jg_ms(ms) ( ms >= 1000 ? sprintf(#jg_ms, "%.2f s", ms / 1000) : sprintf(#jg_ms, "%.0f ms", ms); #jg_ms; );
function jg_nname(n) ( sprintf(#jg_nn, "%s%d", pk_pitem("C|C#|D|D#|E|F|F#|G|G#|A|A#|B", (n % 12) + 1, #jg_k), floor(n / 12) - 1); #jg_nn; );
// the embouchure's interval, named: "A MAJOR 2ND ABOVE", "A MINOR 3RD BELOW +20 CENTS", "35 CENTS ABOVE"
function jg_iname(s) local(a, r, c) (
  a = abs(s); r = floor(a + 0.5); c = floor((a - r) * 100 + 0.5);
  a < 0.005 ? strcpy(#jg_in, "NONE: EVERY NOTE ON PITCH") : r == 0 ? sprintf(#jg_in, "%d CENTS %s", c, s > 0 ? "ABOVE" : "BELOW") : (
    sprintf(#jg_in, "%s %s", r == 8 || r == 11 ? "AN" : "A",
      pk_pitem("MINOR 2ND|MAJOR 2ND|MINOR 3RD|MAJOR 3RD|PERFECT 4TH|TRITONE|PERFECT 5TH|MINOR 6TH|MAJOR 6TH|MINOR 7TH|MAJOR 7TH|OCTAVE", r, #jg_k));
    r == 12 ? strcpy(#jg_in, "AN OCTAVE");
    strcat(#jg_in, s > 0 ? " ABOVE" : " BELOW");
    c != 0 ? ( sprintf(#jg_k2, " %+d C", c); strcat(#jg_in, #jg_k2); );
  );
  #jg_in;
);

// ======================== the faceplate: heavy polished brass ========================
ui_col(FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(INK); jg_rr(4, 4, 1192, 842, 9);
ui_col(FACEL); jg_rr(6.5, 6.5, 1187, 837, 7);
ui_col(INK); jg_r(11, 11, 1178, 828);
ui_col(FACE); jg_r(13, 13, 1174, 824);
jg_brush(13, 59, 1174, 708, 260, 20.2);
// engraved telemetry: construction lines and alignment crosshairs in the gutters
ui_cola(ETCH, 0.4); jg_r(13, 445, 1174, 1); jg_r(13, 631, 1174, 1); jg_r(600, 59, 1, 13);
