// gfx-headsmooth.jsfx-inc - the shared faceplates of GFX Head, GFX Smooth and GFX Headsmoother
// (JGWizrad / Garden FX). Requires gfx-ui, gfx-panel and gfx-instrument imported first.
//
// Coordinates are unscaled (multiplied by sc inside); T = the top of the unit.
//   hs_head_face(T, i_drive, i_trim, i_voice, level, on)       green tape unit, HS_HH tall
//   hs_smooth_face(T, i_comp, i_out, i_att, i_rel, i_lim, i_blend, gr_db, level, on)
//                                                              blue compressor unit, HS_SH tall
//   hs_fold(T, i_in)    the oxblood INPUT / DRIFT / OUTPUT panel, HS_FH tall. Slider layout from i_in:
//                       trim, guard, drift amount, drift speed, then the six output-stage sliders.
// level = linear peak (the meters fall back on their own); on = 0 dims the unit.
// The top-right of each unit (x 590 - 760, T + 8 - T + 32) is left free for the caller's keys.

@init

HS_HH = 186; HS_SH = 234; HS_FH = 128;
HS_GRN = 0x1F4A35; HS_CRM = 0xEDE3C8; HS_BLU = 0x1F3C74; HS_SLV = 0xC9CED6; HS_SLVD = 0x8C939E;
HS_INK = 0xEEF1F6; HS_NAV = 0x14284F; HS_OXB = 0x5A2430; HS_OXS = 0x4C1E28;
HS_AMB = 0xFFB030; HS_RED = 0xFF3A2A; HS_LEDG = 0x3ADF6A;

// brushed-silver name plate screwed to the panel: GFX roundel, name, subtitle
function hs_badge(x, y, name, sub, ink) local(bx, by, bw, bh, i, tw, th, sw) (
  gfx_setfont(6, "Trebuchet MS", (16 * sc) * max(ui_tf, 1), 'b'); gfx_measurestr(name, tw, th);
  gfx_setfont(4); gfx_measurestr(sub, sw, th);
  bx = x * sc; by = y * sc; bw = 40 * sc + tw + sw + 14 * sc; bh = 24 * sc;
  ui_keyshadow(bx, by, bw, bh, 3 * sc);
  ui_col(HS_SLVD); ui_rrs(bx, by, bw, bh, 3 * sc);
  gfx_gradrect(bx + 1, by + 1, bw - 2, bh - 2, 0.86, 0.88, 0.91, 1, 0, 0, 0, 0, -0.2 / bh, -0.2 / bh, -0.18 / bh, 0);
  i = 0; loop(floor(bh / (2 * sc)) - 1, ui_cola(0xFFFFFF, 0.10 + 0.05 * (i % 3));
    gfx_line(bx + 2, by + (2 + i * 2) * sc, bx + bw - 3, by + (2 + i * 2) * sc); i += 1; );
  ui_col(ink); gfx_circle(bx + 13 * sc, by + 12 * sc, 9 * sc, 1, 1);
  gfx_setfont(7, "Trebuchet MS", (7 * sc) * max(ui_tf, 1), 'b'); ui_col(HS_SLV); ui_text(bx + 13 * sc, by + 8.5 * sc, "GFX");
  gfx_setfont(6, "Trebuchet MS", (16 * sc) * max(ui_tf, 1), 'b'); ui_col(ink); gfx_x = bx + 28 * sc; gfx_y = by + 4 * sc; gfx_drawstr(name);
  gfx_setfont(4); ui_cola(ink, 0.75); gfx_x += 7 * sc; gfx_y = by + 9 * sc; gfx_drawstr(sub);
  hs_bend = (bx + bw) / sc;                        // the plate's right edge (unscaled)
);

function hs_unit(T, h, col) (
  pk_chassis(8 * sc, T * sc, 764 * sc, h * sc, col);
  pk_screw(22 * sc, (T + 14) * sc); pk_screw(758 * sc, (T + 14) * sc);
  pk_screw(22 * sc, (T + h - 14) * sc); pk_screw(758 * sc, (T + h - 14) * sc);
);

// horizontal LED level meter: n LEDs centred on cx
function hs_leds(cx, y, lvl, ink) local(i, th, db) (
  db = 20 * log10(max(lvl, 0.00001));
  i = 0;
  loop(10,
    th = i == 0 ? -30 : i == 1 ? -24 : i == 2 ? -18 : i == 3 ? -12 : i == 4 ? -9 : i == 5 ? -6 :
         i == 6 ? -4 : i == 7 ? -2 : i == 8 ? -1 : -0.1;
    pk_led((cx - 54 + i * 12) * sc, y * sc, 3.8 * sc, db >= th, i < 7 ? HS_LEDG : i < 9 ? HS_AMB : HS_RED);
    i += 1;
  );
  gfx_setfont(4); ui_cola(ink, 0.8); ui_text(cx * sc, (y + 10) * sc, "LEVEL");
);

// ---------- HEAD: DRIVE | VOICE | TRIM | LEVEL ----------
function hs_head_face(T, i_drive, i_trim, i_voice, lvl, on) (
  ui_theme(12);
  hs_unit(T, HS_HH, HS_GRN);
  gfx_gradrect(10 * sc, (T + 2) * sc, 760 * sc, (HS_HH - 4) * sc, 1, 1, 0.9, 0.05, 0, 0, 0, -0.05 / (760 * sc), 0, 0, 0, 0);
  hs_badge(40, T + 8, "HEAD", "TAPE SATURATOR", HS_GRN);
  pk_ink = HS_CRM; pk_bg = HS_GRN; pk_nut = 0; pk_kstyle = 0; pk_rsc = 0.72;    // rotary selectors sized to the knobs
  pk_bigknob(150 * sc, (T + 100) * sc, 28 * sc, i_drive, 0, 10, 0, 11, 0, 1, "DRIVE", "%.1f");
  pk_rotsel(301.5 * sc, (T + 112) * sc, i_voice, "NORMAL", "MEDIUM", "BRIGHT");
  gfx_setfont(6, "Trebuchet MS", (15 * sc) * max(ui_tf, 1), 'b'); ui_col(HS_CRM); ui_text(301.5 * sc, (T + 158) * sc, "VOICE");
  
  // TRIM shifted left from 486 * sc to 420 * sc
  pk_bigknob(453 * sc, (T + 100) * sc, 28 * sc, i_trim, -24, 6, 0, 11, -24, 0, "TRIM", "%+.1f dB");
  
  sprintf(#dv, "%.0f%%", slider19); dy_knob(575, T + 74, 13, 19, 0, 100, 0, 0, 0xD8B040, "BOOST", #dv);
  
  // (Pinline removed from here)
  
  hs_lvh = max(lvl, hs_lvh * 0.8);
  hs_leds(676, T + 108, hs_lvh, HS_CRM);
  !on ? ( ui_cola(0x000000, 0.35); gfx_rect(10 * sc, (T + 40) * sc, 760 * sc, (HS_HH - 46) * sc); );
);

// ---------- SMOOTH: COMPRESS + BLEND | GR meter, ATTACK / LIMIT / RELEASE | OUTPUT + LEVEL ----------
function hs_smooth_face(T, i_comp, i_out, i_att, i_rel, i_lim, i_blend, grdb, lvl, on)
  local(mx, my, mw, mh, mcx, mcy, mr, i, v, a) (
  ui_theme(1);
  hs_unit(T, HS_SH, HS_BLU);
  gfx_gradrect(10 * sc, (T + 2) * sc, 760 * sc, (HS_SH - 4) * sc, 0.6, 0.75, 1, 0.07, 0, 0, 0, -0.07 / (760 * sc), 0, 0, 0, 0);
  hs_badge(40, T + 8, "SMOOTH", "OPTICAL COMPRESSOR", HS_NAV);
  pk_ink = HS_INK; pk_bg = HS_BLU; pk_nut = 1; pk_kstyle = 0; pk_rsc = 0.72;
  pk_bigknob(120 * sc, (T + 100) * sc, 28 * sc, i_comp, 0, 10, 0, 11, 0, 1, "COMPRESS", "%.1f");
  ui_section(2); C_INK = HS_INK;
  ui_knob(214 * sc, (T + 176) * sc, i_blend, 0, 100, 100, 0, "BLEND", "%.0f%%");
  // gain-reduction meter
  mx = 265 * sc; my = (T + 56) * sc; mw = 250 * sc; mh = 58 * sc;
  ui_col(0x0A0F1C); ui_rrect(mx - 3 * sc, my - 3 * sc, mw + 6 * sc, mh + 6 * sc, 6 * sc);
  gfx_gradrect(mx, my, mw, mh, 0.93, 0.90, 0.80, 1, 0, 0, 0, 0, -0.18 / mh, -0.18 / mh, -0.16 / mh, 0);
  mcx = mx + mw * 0.5; mr = 98 * sc; mcy = my + mh + 60 * sc;
  gfx_setfont(4);
  i = 0;
  loop(8,
    v = i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 10 : i == 6 ? 15 : 20;
    a = 0.55 - v / 20 * 1.1;
    ui_col(v >= 10 ? 0xB0302A : HS_NAV);
    gfx_line(mcx + sin(a) * (mr - 7 * sc), mcy - cos(a) * (mr - 7 * sc), mcx + sin(a) * mr, mcy - cos(a) * mr, 1);
    sprintf(#hs_mv, "%d", v); ui_text(mcx + sin(a) * (mr + 8 * sc), mcy - cos(a) * (mr + 8 * sc) - 5 * sc, #hs_mv);
    i += 1;
  );
  ui_col(HS_NAV); i = 0; ui_ssarc(mcx, mcy, mr - (0 + (floor(2) - 1) * 0.5), -0.55, 0.55, ((floor(2) - 1) * 1 + 1));
  ui_cola(HS_NAV, 0.75); ui_text(mcx, my + mh - 16 * sc, "GAIN REDUCTION  dB");
  hs_mgr += (min(grdb, 20) - hs_mgr) * 0.45;
  a = 0.55 - hs_mgr / 20 * 1.1;
  ui_cola(0x000000, 0.25); gfx_line(mcx + sin(a) * 72 * sc + 2 * sc, mcy - cos(a) * 72 * sc, mcx + sin(a) * (mr - 2 * sc) + 2 * sc, mcy - cos(a) * (mr - 2 * sc), 1);
  ui_col(0x16181C); gfx_line(mcx + sin(a) * 72 * sc, mcy - cos(a) * 72 * sc, mcx + sin(a) * (mr - 2 * sc), mcy - cos(a) * (mr - 2 * sc), 1);
  gfx_gradrect(mx, my, mw, 8 * sc, 0, 0, 0, 0.25, 0, 0, 0, 0, 0, 0, 0, -0.25 / (8 * sc));
  // ATTACK / LIMIT / RELEASE
  pk_rotsel(320 * sc, (T + 172) * sc, i_att, "SLOW", "MEDIUM", "FAST");
  pk_rotsel(460 * sc, (T + 172) * sc, i_rel, "SLOW", "MEDIUM", "FAST");
  gfx_setfont(6, "Trebuchet MS", (13 * sc) * max(ui_tf, 1), 'b'); ui_col(HS_INK);
  ui_text(320 * sc, (T + 194) * sc, "ATTACK"); ui_text(460 * sc, (T + 194) * sc, "RELEASE");
  pk_ledbtn(376 * sc, (T + 158) * sc, 28 * sc, 26 * sc, slider(i_lim), HS_RED) ? ( slider(i_lim) = 1 - slider(i_lim); slider_automate(2 ^ (i_lim - 1)); );
  gfx_setfont(4); ui_col(HS_INK); ui_text(390 * sc, (T + 190) * sc, "LIMIT");
  // OUTPUT + LEVEL
  pk_bigknob(660 * sc, (T + 100) * sc, 28 * sc, i_out, -12, 24, 0, 13, -12, 0, "OUTPUT", "%+.1f dB");
  hs_lvs = max(lvl, hs_lvs * 0.8);
  hs_leds(660, T + 184, hs_lvs, HS_INK);
  !on ? ( ui_cola(0x000000, 0.35); gfx_rect(10 * sc, (T + 40) * sc, 760 * sc, (HS_SH - 46) * sc); );
);

// ---------- the shared INPUT / DRIFT / OUTPUT stage on its own oxblood panel ----------
function hs_fold(T, i_in) (
  ui_theme(6);
  hs_unit(T, HS_FH, HS_OXB);
  pk_inset(40 * sc, (T + 14) * sc, 130 * sc, 100 * sc, HS_OXS); pk_box(40 * sc, (T + 14) * sc, 130 * sc, 100 * sc, HS_CRM, "INPUT");
  ui_section(3); C_INK = HS_CRM;
  knob_push = i_in + 1;                            // the GUARD LED button toggles the input guard
  ui_knob(84 * sc, (T + 64) * sc, i_in, -24, 12, 0, 0, "TRIM", "%.1f dB");
  ui_guard_tag(124 * sc, (T + 36) * sc, slider(i_in + 1), in_grd);
  knob_push = 0;
  pk_inset(180 * sc, (T + 14) * sc, 140 * sc, 100 * sc, HS_OXS); pk_box(180 * sc, (T + 14) * sc, 140 * sc, 100 * sc, HS_CRM, "DRIFT");
  ui_section(1); C_INK = HS_CRM;
  ui_knob(222 * sc, (T + 64) * sc, i_in + 2, 0, 100, 25, 0, "AMOUNT", "%.0f%%");
  ui_knob(280 * sc, (T + 64) * sc, i_in + 3, 0.02, 2, 0.25, 1, "SPEED", "%.2f Hz");
  ins_output_tray(330, T + 14, i_in + 4, HS_OXS, HS_CRM, HS_AMB);
);
