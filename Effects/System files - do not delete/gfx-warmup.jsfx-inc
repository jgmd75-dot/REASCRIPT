// by JGWizrad / Garden FX (GFX)

@init
function nw_ts(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );

function nw_setup(ms, tone_hz, drive, bias) (
  nw_st = 1 / (max(ms, 5) * 0.001 * srate);
  nw_pa = min(1 / max(ms, 5), 0.5);
  nw_lc = 1 - exp(-2 * $pi * min(tone_hz, srate * 0.45) / srate);
  nw_hc = 1 - exp(-2 * $pi * 40 / srate);
  nw_drv = drive; nw_bias = bias;
);
nw_setup(40, 2500, 1.2, 0.25);

function nw_start(b) ( b[0] = 0; b[2] = 1; );

function nw_run(b, x) local(p, e, lp, g, bb, y, d) (
  b[2] ? (
    p = b[0];
    e = p >= 1 ? 0 : p < nw_pa ? 0.5 - 0.5 * cos($pi * p / nw_pa) : 0.5 + 0.5 * cos($pi * (p - nw_pa) / (1 - nw_pa));
    lp = b[1] += (x - b[1]) * nw_lc;
    y = x + (lp - x) * e * 0.6;
    g = 1 + nw_drv * e; bb = nw_bias * e;
    d = ((nw_ts(g * y + bb) - nw_ts(bb)) / g - y) * e;
    b[3] += (d - b[3]) * nw_hc; y += d - b[3];
    p += nw_st; b[0] = p;
    p >= 1 && abs(b[3]) < 0.00001 ? ( b[2] = 0; b[1] = b[3] = 0; );
    y;
  ) : x;
);

function nw_side(fp, dp, x, e) local(lp, g, bb, y, d) (
  lp = fp[0] += (x - fp[0]) * nw_lc;
  y = x + (lp - x) * e * 0.6;
  g = 1 + nw_drv * e; bb = nw_bias * e;
  d = ((nw_ts(g * y + bb) - nw_ts(bb)) / g - y) * e;
  dp[0] += (d - dp[0]) * nw_hc;
  y + d - dp[0];
);
function nw_run2(b, l, r) local(p, e) (
  b[2] ? (
    p = b[0];
    e = p >= 1 ? 0 : p < nw_pa ? 0.5 - 0.5 * cos($pi * p / nw_pa) : 0.5 + 0.5 * cos($pi * (p - nw_pa) / (1 - nw_pa));
    nw_l = nw_side(b + 1, b + 3, l, e);
    nw_r = nw_side(b + 4, b + 5, r, e);
    p += nw_st; b[0] = p;
    p >= 1 && abs(b[3]) < 0.00001 && abs(b[5]) < 0.00001 ? ( b[2] = 0; b[1] = b[3] = b[4] = b[5] = 0; );
  ) : ( nw_l = l; nw_r = r; );
);
