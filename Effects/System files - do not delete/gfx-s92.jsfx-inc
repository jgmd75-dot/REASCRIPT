desc:GFX Series 92 panel parts (include)
//author: JGWizrad / Garden FX (GFX)
//
// The look of Series 92 - high-end home recording from the 90s: the rack outboard and desks of a serious home studio
// of the time. Black / graphite rack panels with rack ears and a brushed-silver trim line, sections set apart by fine
// silver rules, soft-touch black knobs with coloured caps (the house colour code), small rubber keys with an LED
// strip, LED ladder meters and backlit LCD readouts, clean white print.
//
// Every unit has two models (s92_pal(model)), the era's two halves of the home studio:
//   ANALOG  - the boutique outboard: valve, opto and transformer colour. The panel lamps (LEDs, LCDs) glow amber.
//   DIGITAL - the first affordable 16 / 20-bit converters and DSP boxes: clean, precise, a little glassy. The lamps
//             glow green.
//
// Usage (after gfx-ui and gfx-panel):
//   import gfx-s92.jsfx-inc
//   @gfx     ui_begin(W, H); s92_pal(model); s92_fonts(); s92_face(W, H); ... pk_end(); ui_end();
// Coordinates are in base pixels (they are scaled by sc inside).
//   s92_mod(x, y, w, h, title)                                    a section: graphite panel, a title strip, a silver rule
//   s92_knob(cx, cy, r, idx, lo, hi, def, log, label, fmt, step)   drag, SHIFT fine, double-click / Ctrl-click default,
//                                                                 wheel; the value shows only while touched
//   s92_kc = S92_C_LF ... before a knob, 0 after              the house colour code on its cap
//   s92_key(x, y, w, h, on, s)                                     a rubber key with an LED strip; 1 on a click
//                                                                 (s92_lc = a code colour for its LED, 0 = the lamp)
//   s92_onoff(x, y, idx)                                           a section's IN key pair (ON / OFF)
//   s92_fader(x, y, travel, idx, ...)                              a short desk fader (s92_fc = its cap colour)
//   inst.s92_edge(x, y, w, h, level, label)                        an LED ladder meter (level: linear, 1 = 0 VU)
//   inst.s92_gredge(x, y, w, h, gr_db, label)                      an LED gain-reduction ladder
//   s92_lcd(x, y, w, h, s)                                         a backlit LCD readout
//   s92_title / s92_cap / s92_small / s92_smallc                   print

@init
// ---------- colours: the panel is fixed, the lamps follow the model ----------
function s92_pal(m) (
  s92_m = m >= 0.5;
  S92_FACE = 0x0F1011;                                  // the chassis behind the panels
  S92_SILVER = 0xB8BDC2; S92_CHAR = 0x0B0C0D;
  S92_LDIM = 0x8B9096;                                   // print inside the black housings (ladders, displays)
  !s92_m ? (
    S92_PANEL = 0x26282B; S92_PANELD = 0x1D1F21; S92_PANELL = 0x303337;   // ANALOG: graphite sections, white print
    S92_INK = 0xE6E8EA; S92_DIM = 0x8B9096; S92_RULE = S92_SILVER; S92_LITE = 0;
  ) : (
    S92_PANEL = 0xC8CBCF; S92_PANELD = 0xB4B8BD; S92_PANELL = 0xD5D8DB;   // DIGITAL: light grey sections, charcoal print
    S92_INK = 0x1C1F22; S92_DIM = 0x5E646B; S92_RULE = 0x6E747A; S92_LITE = 1;
  );
  S92_C_LF = 0x7A4A2A; S92_C_LMF = 0x2F5FA8; S92_C_HMF = 0x2F7D46; S92_C_HF = 0xC0302A; S92_C_HPF = 0xE0B52A; S92_C_LPF = 0x1C1C1E;
  !s92_m ? (
    S92_LAMP = 0xFFA43A; S92_LAMPD = 0x2E1D0A; S92_LCDT = 0xFFB65A; S92_LCDB = 0x2A1B0B;      // ANALOG: amber
  ) : (
    S92_LAMP = 0x8CF06A; S92_LAMPD = 0x14240F; S92_LCDT = 0xA6F27E; S92_LCDB = 0x15230F;      // DIGITAL: green
  );
  S92_RED = 0xFF3A2A; S92_YEL = 0xFFC83A; S92_GRN = 0x5BE05A;
  S92_F_GREY = 0x9A9EA3; S92_F_BLUE = 0x2F63B8; S92_F_YELLOW = 0xE8C22E; S92_F_RED = 0xC23A30;
);
s92_pal(0);

// ---------- type ----------
function s92_fonts() (
  sc != s92_calsc ? (
    s92_calsc = sc;
    s92_f1 = ui_fitarial(11, 13 * sc);        // captions (the knobs' labels)
    s92_f2 = ui_fitarial(12, 12.5 * sc);      // section titles
    s92_f3 = ui_fitarial(13, 10 * sc);        // small print, values
  );
  gfx_setfont(11, "Arial", s92_f1, 'b'); gfx_setfont(12, "Arial", s92_f2, 'b'); gfx_setfont(13, "Arial", s92_f3, 'b');
  gfx_setfont(14, "Arial", 26 * sc, 'b'); gfx_setfont(15, "Arial", 15 * sc, 'b');
);
function s92_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function s92_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function s92_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function s92_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function s92_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function s92_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function s92_ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  x1 *= sc; y1 *= sc; x2 *= sc; y2 *= sc; w *= sc * 0.5;
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : l < 8 ? gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny)
    : ui_ssline(x1, y1, x2, y2, 2 * w, 0);   // (lines 8 px and longer supersampled: even at every angle)
);
function s92_title(x, y, s) ( gfx_setfont(12); ui_col(S92_INK); s92_t(x, y, s); );
function s92_cap(cx, y, s) ( gfx_setfont(11); ui_col(S92_INK); s92_tc(cx, y, s); );
function s92_small(x, y, s) ( gfx_setfont(13); ui_col(S92_DIM); s92_t(x, y, s); );
function s92_smallc(cx, y, s) ( gfx_setfont(13); ui_col(S92_DIM); s92_tc(cx, y, s); );

// ---------- the chassis: black, rack ears with their slots, a brushed-silver trim line under the header ----------
function s92_face(w, h) local(i) (
  ui_col(S92_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
  // the rack ears: a slightly lighter strip each side, two slots each
  ui_col(0x1A1B1D); s92_r(0, 0, 12, h); s92_r(w - 12, 0, 12, h);
  ui_cola(0xFFFFFF, 0.06); s92_r(11, 0, 1, h); s92_r(w - 12, 0, 1, h);
  i = 0; loop(2, ui_col(0x050505); s92_rr(3, 16 + i * (h - 48), 6, 16, 3); s92_rr(w - 9, 16 + i * (h - 48), 6, 16, 3); i += 1; );
  // the trim line under the header
  ui_col(0x8E9399); s92_r(12, 53, w - 24, 1.5); ui_cola(0xFFFFFF, 0.25); s92_r(12, 53, w - 24, 0.5);
);
// a section: a graphite panel, a title strip, a fine silver rule under the title
function s92_mod(x, y, w, h, title) (
  ui_cola(0x000000, 0.6); s92_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(S92_PANEL); s92_r(x, y, w, h);
  ui_cola(0xFFFFFF, S92_LITE ? 0.35 : 0.05); s92_r(x, y, w, 1);
  ui_col(S92_PANELD); s92_r(x, y, w, 22);
  ui_cola(S92_RULE, 0.55); s92_r(x + 8, y + 22, w - 16, 1);
  strlen(title) ? ( gfx_setfont(12); ui_col(S92_INK); s92_t(x + 10, y + 5, title); );
);
function s92_plate(x, y, w, h) (
  ui_cola(0x000000, 0.6); s92_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(S92_PANEL); s92_r(x, y, w, h);
  ui_cola(0xFFFFFF, S92_LITE ? 0.35 : 0.05); s92_r(x, y, w, 1);
);

// ---------- the soft-touch knob: printed ticks, a black rubber body, a coloured cap, a white index ----------
function s92_cap_draw(cx, cy, r, n) local(a, ca, sa, i, t, l, k) (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 9 : 7;
    ui_cola(S92_INK, 0.7); s92_ln(cx + sin(t) * (r + 4), cy - cos(t) * (r + 4), cx + sin(t) * (r + l), cy - cos(t) * (r + l), i == 0 || i == 5 || i == 10 ? 1.6 : 1.1);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.55); gfx_circle((cx + 1.4) * sc, (cy + 2.6) * sc, r * sc, 1, 1);
  ui_col(0x141516); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  // the rubber skirt's grip lines
  i = 0; loop(24, t = i * 2 * $pi / 24; ui_col(0x26282A); s92_ln(cx + cos(t) * r * 0.86, cy + sin(t) * r * 0.86, cx + cos(t) * (r - 0.5), cy + sin(t) * (r - 0.5), max(1, r * 0.05)); i += 1; );
  // the cap (grey unless the colour code is set; s92_kd = a unit's own cap colour for uncoded knobs, 0 = grey)
  k = s92_kc ? s92_kc : s92_kd ? s92_kd : 0x55595E;
  ui_col(ui_mix(k, 0x000000, 0.35)); gfx_circle(cx * sc, cy * sc, r * 0.72 * sc, 1, 1);
  ui_col(k); gfx_circle((cx - r * 0.02) * sc, (cy - r * 0.03) * sc, r * 0.66 * sc, 1, 1);
  !s92_flat ? (     // s92_flat = 1: a flat cap, no reflection (STR92, MLT92: JG, 30 Oct 2026)
    ui_cola(0xFFFFFF, 0.16); gfx_circle((cx - r * 0.18) * sc, (cy - r * 0.2) * sc, r * 0.26 * sc, 1, 1);
    ui_col(k); gfx_circle((cx - r * 0.1) * sc, (cy - r * 0.12) * sc, r * 0.26 * sc, 1, 1);
  );
  // the index: white from the centre to the rim (black on the yellow cap and on a pastel s92_kd cap)
  ui_col(k == S92_C_HPF || (!s92_kc && s92_kd) ? 0x101214 : 0xF4F5F6);
  s92_ln(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * r * 0.92, cy + sa * r * 0.92, max(2.4, r * 0.12));
);
function s92_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(S92_LCDB); gfx_rect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 4 * sc);
  ui_col(S92_LCDT); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);
// s92_off = 1 greys the caption (a control the model leaves out of the path)
function s92_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 4000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - s92_lt < 0.35 && s92_lid == idx && !s92_mv) || (mouse_cap & 4) ? ( s92_set(idx, def); drag_id = -1; s92_lt = 0; ) : (
      drag_id = did; s92_ky = mouse_y; s92_ky0 = mouse_y; s92_mv = 0; s92_lt = time_precise(); s92_lid = idx;
      s92_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !s92_mv && abs(mouse_y - s92_ky0) > 3 * sc ? ( s92_mv = 1; s92_ky = mouse_y; );
  drag_id == did && s92_mv ? (
    s92_kn = min(max(s92_kn + (s92_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); s92_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ s92_kn : lo + s92_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s92_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    s92_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  s92_cap_draw(cx, cy, r, min(max(n, 0), 1));
  (hov || drag_id == did) ? (
    strlen(fmt) ? sprintf(#s92_vv, fmt, v) : strcpy(#s92_vv, #s92_vs);
    s92_pill(cx, cy + r + 8, #s92_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(11); ui_col(s92_off ? S92_DIM : S92_INK); s92_tc(cx, cy + r + 18, label); );
  );
);

// ---------- the rubber key: dark grey rubber, its legend in white, a lit LED strip along the top when on ----------
function s92_key(x, y, w, h, on, s) local(hov, hit, lc) (
  hov = s92_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  lc = s92_lc ? s92_lc : S92_LAMP;
  ui_cola(0x000000, 0.5); s92_rr(x + 1, y + 2, w, h, 3);
  ui_col(0x0A0B0C); s92_rr(x, y, w, h, 3);
  ui_col(hov ? 0x4A4E53 : 0x3A3D41); s92_rr(x + 1, y + 1, w - 2, h - 2, 2.5);
  ui_cola(0xFFFFFF, 0.08); s92_r(x + 3, y + 1.5, w - 6, 1);
  // the LED strip
  ui_col(on ? lc : ui_mix(lc, 0x000000, 0.78)); s92_r(x + 5, y + 3.5, w - 10, 2.5);
  on ? ( ui_cola(lc, 0.18); s92_r(x + 3, y + 1.5, w - 6, 6.5); );
  gfx_setfont(13); ui_col(on ? 0xFFFFFF : 0xB8BCC0); s92_tc(x + w * 0.5, y + h * 0.5 + 2, s);
  hit;
);
// a lit key for a section's swap-order: flashes when pressed; returns 1 on a click
function s92_orderkey(x, y, w, h, s) instance(t) local(hit) (
  hit = s92_key(x, y, w, h, time_precise() - t < 0.25, s); hit ? t = time_precise(); hit;
);
// a section's IN / OUT as a key pair (slider idx: 1 = in)
function s92_onoff(x, y, idx) local(on) (
  on = slider(idx) >= 0.5;
  s92_key(x, y, 34, 18, on, "IN") ? s92_set(idx, 1);
  s92_key(x + 38, y, 34, 18, !on, "OUT") ? s92_set(idx, 0);
);

// ---------- the desk fader: a short fader in a black slot, a cap (s92_fc: grey unless set) ----------
function s92_fader(x, y, h, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, hov, did, cy, i, k, ty) (
  did = 6000 + idx; v = slider(idx);
  n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1);
  cy = y + h * (1 - n);
  hov = s92_hov(x - 18, y - 10, 36, h + 20);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - s92_lt < 0.35 && s92_lid == idx && !s92_mv) || (mouse_cap & 4) ? ( s92_set(idx, def); drag_id = -1; s92_lt = 0; ) : (
      drag_id = did; s92_ky = mouse_y; s92_ky0 = mouse_y; s92_mv = 0; s92_lt = time_precise(); s92_lid = idx; s92_kn = n;
      abs(mouse_y / sc - cy) > 9 ? ( s92_kn = min(max(1 - (mouse_y / sc - y) / h, 0), 1); s92_mv = 1;
        v = lg ? lo * (hi / lo) ^ s92_kn : lo + s92_kn * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp; s92_set(idx, v); );
    );
  );
  drag_id == did && !s92_mv && abs(mouse_y - s92_ky0) > 3 * sc ? ( s92_mv = 1; s92_ky = mouse_y; );
  drag_id == did && s92_mv ? (
    s92_kn = min(max(s92_kn + (s92_ky - mouse_y) / ((mouse_cap & 8) ? h * 6 * sc : h * sc), 0), 1); s92_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ s92_kn : lo + s92_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s92_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    s92_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1); cy = y + h * (1 - n);
  i = 0; loop(11, ty = y + h * i / 10; ui_cola(S92_INK, 0.6);
    s92_r(x - 16 - (i == 0 || i == 5 || i == 10 ? 4 : 0), ty - 0.5, i == 0 || i == 5 || i == 10 ? 8 : 4, 1);
    s92_r(x + 12, ty - 0.5, i == 0 || i == 5 || i == 10 ? 8 : 4, 1); i += 1; );
  ui_col(0x050506); s92_r(x - 2.5, y - 4, 5, h + 8);
  ui_cola(0xFFFFFF, 0.1); s92_r(x + 2.5, y - 4, 1, h + 8);
  k = s92_fc ? s92_fc : S92_F_GREY;
  ui_cola(0x000000, 0.5); s92_r(x - 12 + 1.5, cy - 9 + 3, 24, 18);
  ui_col(ui_mix(k, 0x000000, 0.4)); s92_r(x - 12, cy - 9, 24, 18);
  ui_col(k); s92_r(x - 11, cy - 8, 22, 15);
  i = 0; loop(3, ui_cola(0x000000, 0.18); s92_r(x - 10, cy - 6 + i * 3, 20, 1); ui_cola(0xFFFFFF, 0.22); s92_r(x - 10, cy - 5 + i * 3, 20, 1); i += 1; );
  ui_col(k == S92_F_YELLOW ? 0x1A1A1A : 0xF6F4EE); s92_r(x - 11, cy + 2, 22, 1.6);
  (hov || drag_id == did) ? (
    strlen(fmt) ? sprintf(#s92_vv, fmt, v) : strcpy(#s92_vv, #s92_vs);
    s92_pill(x, y + h + 12, #s92_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(11); ui_col(s92_off ? S92_DIM : S92_INK); s92_tc(x, y + h + 22, label); );
  );
);

// ---------- a backlit LCD readout (the model's colour) ----------
function s92_lcd(x, y, w, h, s) local(tw, th) (
  ui_col(0x050506); s92_rr(x - 2, y - 2, w + 4, h + 4, 3);
  ui_col(S92_LCDB); s92_r(x, y, w, h);
  ui_cola(S92_LCDT, 0.05); s92_r(x, y, w, h * 0.45);
  gfx_setfont(15); gfx_measurestr(s, tw, th);
  ui_col(S92_LCDT); gfx_x = floor((x + w - 6) * sc - tw); gfx_y = floor((y + h * 0.5) * sc - th * 0.5); gfx_drawstr(s);
);

// ---------- LED ladder meters ----------
// a horizontal ladder of 20 LEDs: -30 .. +6 (VU-relative: 1 = 0 VU), green, then yellow from -3, red from +3; a peak
// hold LED; the scale printed under it, the label on the left
function s92_edge(x, y, w, h, lvl, label) instance(pk, ht, lt, hd) local(i, d, on, c, n, lx, lw, segw, t, db) (
  t = time_precise(); lt == 0 ? ( lt = t; pk = -100; hd = -100; );
  db = 20 * log10(max(lvl, 0.00001));
  pk = max(db, pk - 12 * (t - lt)); lt = t;
  db > hd || t - ht > 1.5 ? ( hd = db; ht = t; );
  ui_col(0x050506); s92_rr(x, y, w, h, 3);
  gfx_setfont(13); ui_col(S92_LDIM); s92_t(x + 6, y + h * 0.5 - 12, label);
  lx = x + 34; lw = w - 40; n = 20; segw = lw / n;
  i = 0; loop(n,
    d = -30 + i * 36 / (n - 1);
    on = pk >= d;
    c = d >= 3 ? S92_RED : d >= -3 ? S92_YEL : S92_GRN;
    ui_col(on ? c : ui_mix(c, 0x000000, 0.82)); s92_r(lx + i * segw + 1, y + 6, segw - 2, h - 22);
    on ? ( ui_cola(c, 0.15); s92_r(lx + i * segw, y + 4, segw, h - 18); );
    (abs(hd - d) < 36 / (n - 1) * 0.5) ? ( ui_col(c); s92_r(lx + i * segw + 1, y + 6, segw - 2, h - 22); );
    i += 1; );
  gfx_setfont(13); ui_col(S92_LDIM);
  i = 0; loop(5, d = i == 0 ? -30 : i == 1 ? -20 : i == 2 ? -10 : i == 3 ? 0 : 6;
    sprintf(#s92_e, d > 0 ? "+%d" : "%d", d); s92_tc(lx + (d + 30) / 36 * (lw - segw) + segw * 0.5, y + h - 8, #s92_e); i += 1; );
);
// a gain-reduction ladder: 0 .. -20 dB, lit from the right in the lamp colour
function s92_grpos(g) ( 1 - log(1 + max(g, 0)) / log(21); );
function s92_gredge(x, y, w, h, gr, label) instance(sm) local(i, d, on, n, lx, lw, segw) (
  sm += (gr - sm) * 0.35;
  ui_col(0x050506); s92_rr(x, y, w, h, 3);
  gfx_setfont(13); ui_col(S92_LDIM); s92_t(x + 6, y + h * 0.5 - 12, label);
  lx = x + 34; lw = w - 40; n = 20; segw = lw / n;
  i = 0; loop(n,
    d = 20 * (n - 1 - i) / (n - 1);                     // the left LED is -20 dB, the right one 0
    on = sm >= d && d > 0.4;
    ui_col(on ? S92_LAMP : ui_mix(S92_LAMP, 0x000000, 0.82)); s92_r(lx + i * segw + 1, y + 6, segw - 2, h - 22);
    on ? ( ui_cola(S92_LAMP, 0.15); s92_r(lx + i * segw, y + 4, segw, h - 18); );
    i += 1; );
  gfx_setfont(13); ui_col(S92_LDIM);
  i = 0; loop(5, d = i == 0 ? 20 : i == 1 ? 15 : i == 2 ? 10 : i == 3 ? 5 : 0;
    sprintf(#s92_e, d == 0 ? "0" : "-%d", d); s92_tc(lx + (1 - d / 20) * (lw - segw) + segw * 0.5, y + h - 8, #s92_e); i += 1; );
);

// ---------- the model keys, in the header: ANALOG / DIGITAL ----------
function s92_modelkeys(x, y, idx) (
  s92_key(x, y, 70, 24, slider(idx) < 0.5, "ANALOG") ? s92_set(idx, 0);
  s92_key(x + 74, y, 70, 24, slider(idx) >= 0.5, "DIGITAL") ? s92_set(idx, 1);
);
// ---------- the header (on the black): the 92 badge, the name, two lines of small print, the presets, the model keys,
// the size picker. Returns the preset picked (0 = none).
function s92_header(w, name, l1, l2, pm, midx) local(k) (
  ui_col(0x2A2C2F); s92_rr(18, 13, 32, 28, 3);
  ui_col(S92_SILVER); s92_rr(19, 14, 30, 26, 2.5);
  gfx_setfont(15); ui_col(0x111213); s92_tc(34, 27, "92");
  gfx_setfont(14); gfx_measurestr(name, k, s92_hh);
  k > 124 * sc ? ( gfx_setfont(14, "Arial", 26 * sc * 124 * sc / k, 'b'); gfx_measurestr(name, k, s92_hh); );
  ui_col(0xEDEFF1); gfx_x = 60 * sc; gfx_y = 13 * sc - s92_hh * 0.17; gfx_drawstr(name);
  s92_sx = 60 + k / sc + 14;
  gfx_setfont(13); gfx_measurestr(strlen(l1) > strlen(l2) ? l1 : l2, k, s92_hh);
  k > (292 - s92_sx) * sc ? gfx_setfont(13, "Arial", s92_f3 * (292 - s92_sx) * sc / k, 'b');
  ui_col(0x9AA0A6); s92_t(s92_sx, 15, l1); s92_t(s92_sx, 29, l2);
  pk_pextra = "Reset all to defaults";
  k = pk_preset(300 * sc, 10 * sc, (w - 572) * sc, 34 * sc, pr_cur, pm);
  s92_modelkeys(w - 248, 15, midx);
  ui_size_picker((w - 84) * sc, 18 * sc);
  k;
);

// =====================================================================================================================
// DSP helpers shared by the Series 92 units (all in @init, called from @init / @block / @sample)
// =====================================================================================================================
// memory: the unit sets s92_mem (the first free slot) before its first s92_alloc
function s92_alloc(n) local(p) ( p = s92_mem; s92_mem += n; memset(p, 0, n); p; );
// tanh (Pade 3/2), exactly 1 with zero slope at +/-3
function s92_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
// a one-pole smoothing / low-pass coefficient for f Hz at the rate fs
function s92_k(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
// a time constant (seconds) as a one-pole coefficient at the rate fs
function s92_kt(t, fs) ( 1 - exp(-1 / (max(t, 0.00001) * fs)); );
// RBJ biquads. t: 0 low-pass, 1 high-pass, 2 band-pass (0 dB peak), 3 peak, 4 low shelf, 5 high shelf, 6 all-pass
function s92_bqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(A, w, cs, sn, al, a0, sa) (
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * max(q, 0.05));
  t == 0 ? ( a0 = 1 + al; b0 = (1 - cs) / 2 / a0; b1 = (1 - cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 1 ? ( a0 = 1 + al; b0 = (1 + cs) / 2 / a0; b1 = -(1 + cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 2 ? ( a0 = 1 + al; b0 = al / a0; b1 = 0; b2 = -al / a0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 3 ? ( a0 = 1 + al / A; b0 = (1 + al * A) / a0; b1 = -2 * cs / a0; b2 = (1 - al * A) / a0; a1 = -2 * cs / a0; a2 = (1 - al / A) / a0; ) :
  t == 4 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) + (A - 1) * cs + sa;
             b0 = A * ((A + 1) - (A - 1) * cs + sa) / a0; b1 = 2 * A * ((A - 1) - (A + 1) * cs) / a0; b2 = A * ((A + 1) - (A - 1) * cs - sa) / a0;
             a1 = -2 * ((A - 1) + (A + 1) * cs) / a0; a2 = ((A + 1) + (A - 1) * cs - sa) / a0; ) :
  t == 5 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) - (A - 1) * cs + sa;
             b0 = A * ((A + 1) + (A - 1) * cs + sa) / a0; b1 = -2 * A * ((A - 1) + (A + 1) * cs) / a0; b2 = A * ((A + 1) + (A - 1) * cs - sa) / a0;
             a1 = 2 * ((A - 1) - (A + 1) * cs) / a0; a2 = ((A + 1) - (A - 1) * cs - sa) / a0; ) :
  ( a0 = 1 + al; b0 = (1 - al) / a0; b1 = -2 * cs / a0; b2 = 1; a1 = b1; a2 = b0; );
);
function s92_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
function s92_bqclr() instance(z1, z2) ( z1 = z2 = 0; );
// a one-pole low-pass (k from s92_k)
function s92_lp1(x, k) instance(s) ( s += (x - s) * k; s; );
// a delay line: n samples of memory; write then read d samples back (fractional, linear) - instance per line
function s92_dlinit(n) instance(buf, len, w) ( buf = s92_alloc(n); len = n; w = 0; );
function s92_dlw(x) instance(buf, len, w) ( w += 1; w >= len ? w = 0; buf[w] = x; );
function s92_dlr(d) instance(buf, len, w) local(p, i, f, a, b) (
  d = min(max(d, 0), len - 2); p = w - d; p < 0 ? p += len; i = floor(p); f = p - i;
  a = buf[i]; i += 1; i >= len ? i = 0; b = buf[i];
  a + (b - a) * f;
);
// a cubic (Hermite) read, for modulated lines
function s92_dlr3(d) instance(buf, len, w) local(p, i, f, xm, x0, x1, x2, c1, c2, c3) (
  d = min(max(d, 1), len - 3); p = w - d; p < 0 ? p += len; i = floor(p); f = p - i;
  xm = buf[i - 1 < 0 ? len - 1 : i - 1]; x0 = buf[i]; x1 = buf[(i + 1) % len]; x2 = buf[(i + 2) % len];
  c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);
// a Schroeder all-pass on a delay line (g, d samples)
function s92_ap(x, d, g) instance(buf, len, w) local(v, y) (
  v = this.s92_dlr(d); y = v - g * x; this.s92_dlw(x + g * y); y;
);
// ---------- oversampling: linear-phase half-bands (Kaiser windowed, polyphase), as in Drive57 and Drive74 ----------
function s92_bi0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= sqr(x / (2 * k)); s += t; k += 1; ); s; );
function s92_hbdesign(h, n, beta) local(c, t, k, w, x, se, i0) (
  c = (n - 1) / 2; i0 = s92_bi0(beta); t = 0;
  loop(n, k = t - c; x = 2 * t / (n - 1) - 1; w = s92_bi0(beta * sqrt(max(0, 1 - x * x))) / i0;
          h[t] = k == 0 ? 0.5 : sin($pi * k / 2) / ($pi * k) * w; t += 1; );
  se = 0; t = 0; loop((n + 1) / 2, se += h[2 * t]; t += 1; );
  t = 0; loop((n + 1) / 2, h[2 * t] *= 0.5 / se; t += 1; );
);
function s92_upinit(n, h, sz) instance(buf, sz2, w, hu, np, mm, dd) local(j) (
  buf = s92_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; dd = ((n - 1) / 2 - 1) / 2;
  hu = s92_alloc(np); j = 0; loop(np, hu[j] = 2 * h[2 * j]; j += 1; );
);
function s92_up(x) instance(buf, sz2, w, hu, np, mm, dd, o0, o1) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x; buf[w + sz2] = x;
  p = buf + w + sz2; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-j] + p[j + 1 - mm]); j += 1; );
  o0 = s; o1 = p[-dd];
);
function s92_dninit(n, h, sz) instance(buf, sz2, w, hu, np, mm, cc) local(j) (
  buf = s92_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; cc = (n - 1) / 2;
  hu = s92_alloc(np); j = 0; loop(np, hu[j] = h[2 * j]; j += 1; );
);
function s92_dn(x0, x1) instance(buf, sz2, w, hu, np, mm, cc) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x0; buf[w + sz2] = x0;
  w += 1; w >= sz2 ? w = 0; buf[w] = x1; buf[w + sz2] = x1;
  p = buf + w + sz2 - 1; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-2 * j] + p[2 * (j + 1 - mm)]); j += 1; );
  s + 0.5 * p[-cc];
);
// pink-ish noise (Paul Kellet's economy filter on white), about -12 dBFS RMS
function s92_pink() instance(p0, p1, p2) local(w) (
  w = rand(2) - 1; p0 = 0.99765 * p0 + w * 0.099046; p1 = 0.963 * p1 + w * 0.2965164; p2 = 0.57 * p2 + w * 1.0526913;
  (p0 + p1 + p2 + w * 0.1848) * 0.12;
);

// =====================================================================================================================
// Meters for the measuring units (Meter92, Master92)
// =====================================================================================================================
