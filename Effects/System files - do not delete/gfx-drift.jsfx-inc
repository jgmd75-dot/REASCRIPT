desc:GFX Drift engine (include)
//author: JGWizrad / Garden FX (GFX)
//
// Smoothed random motion: cosine-interpolated random points, never cycles.
//
// Usage in a plugin:
//   import gfx-drift.jsfx-inc
//   @init    myDrift.drift_init(0.8 + rand(0.5));   // rate multiplier, varies each source
//   @sample  v = myDrift.drift_tick(speed_hz / srate);   // returns -1..1
//
// Give each drifting parameter its own instance so they wander independently.

@init

function drift_init(r) instance(a, b, ph, rm, v) (
  a = rand(2) - 1; b = rand(2) - 1; ph = rand(1); rm = r; v = a;
);

function drift_tick(inc) instance(a, b, ph, rm, v) (
  ph += inc * rm;
  ph >= 1 ? ( ph -= 1; a = b; b = rand(2) - 1; );
  v = a + (b - a) * (0.5 - 0.5 * cos($pi * ph));
);

// ---------- the DRIFT dial ----------
// One dial per plug-in, 0 - 100 %. 50 % = the plug-in's standard amount of drift (what its own drift settings give),
// 100 % = twice that, 0 = none. The wander speeds up with the amount at half the rate: 0.5x at 0 %, 1x at 50 %, 1.5x at 100 %.
//   drift_macro(pct)  sets dm_a (amount scale, 0 - 2) and dm_s (speed scale, 0.5 - 1.5)
dm_a = 1; dm_s = 1;
function drift_macro(pct) ( dm_a = max(pct, 0) / 50; dm_s = 0.5 + 0.5 * dm_a; );
