desc:GFX Drift engine (include)
//author: JGWizrad / Garden FX (GFX)

@init

function drift_init(r) instance(a, b, ph, rm, v) (
  a = rand(2) - 1; b = rand(2) - 1; ph = rand(1); rm = r; v = a;
);

function drift_tick(inc) instance(a, b, ph, rm, v) (
  ph += inc * rm;
  ph >= 1 ? ( ph -= 1; a = b; b = rand(2) - 1; );
  v = a + (b - a) * (0.5 - 0.5 * cos($pi * ph));
);

dm_a = 1; dm_s = 1;
function drift_macro(pct) ( dm_a = max(pct, 0) / 50; dm_s = 0.5 + 0.5 * dm_a; );

function drift_mm_init() ( dmm_sg = rand(2) - 1; dmm_sk = rand(2) - 1; dmm_kl = dmm_kr = dmm_ol = dmm_or = 1; dmm_gl = dmm_gr = 1; );
function drift_mm_ser() (
  file_avail(0) != 0 ? ( file_var(0, dmm_sg); file_var(0, dmm_sk); );
);
function drift_mm(gdb, kdb) local(g, k) (
  g = 0.5 * gdb * dmm_sg * dm_a;  k = 0.5 * kdb * dmm_sk * dm_a;
  dmm_glt = exp(g * 0.11512925464970228);  dmm_grt = exp(-g * 0.11512925464970228);
  dmm_klt = exp(k * 0.11512925464970228);  dmm_krt = exp(-k * 0.11512925464970228);
);
function drift_mm_glide(k) (
  dmm_gl += (dmm_glt - dmm_gl) * k;  dmm_gr += (dmm_grt - dmm_gr) * k;
  dmm_kl += (dmm_klt - dmm_kl) * k;  dmm_kr += (dmm_krt - dmm_kr) * k;
  dmm_ol = dmm_gl / dmm_kl;  dmm_or = dmm_gr / dmm_kr;
);
