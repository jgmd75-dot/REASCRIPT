desc:GFX Autopan [auto-pan]
//tags: pan autopan tremolo lfo modulation
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-lfo, gfx-input, gfx-output and gfx-ui (.jsfx-inc) in the same folder.
//
// PAN  - moves the sound across the stereo field
// TREM - both sides move together (tremolo)
// Sync locks the LFO to the project timeline; Flow keeps tempo but runs freely through loops.
// DRIFT: rate, depth and centre wander slowly and randomly. The DRIFT dial scales the three drift amounts
// (50% = the settings below, 100% = twice, 0 = none) and speeds the wander up with them.
// TRIM sets the input level; click it (or its LED, upper right) to switch the input GUARD.

import gfx-drift.jsfx-inc
import gfx-lfo.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc

slider1:0<0,1,1{Pan,Trem}>-Mode
slider2:0<0,3,1{Sine,Triangle,Square,Random}>-Shape
slider3:60<0,100,1>-Smooth (%)
slider4:0<0,2,1{Free,Sync,Flow}>-Rate mode
slider5:0.12<0.05,20,0.01>-Free rate (Hz)
slider6:6<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Sync rate
slider7:0<0,360,1>-Phase offset (deg)
slider8:30<0,100,1>-Depth (%)
slider9:0<-100,100,1>-Centre (%)
slider10:5<0,50,1>-Rate drift (%)
slider11:10<0,50,1>-Depth drift (%)
slider12:0<0,50,1>-Centre drift (%)
slider13:0.25<0.02,2,0.01>-Drift speed (Hz)
slider14:0<0,1,1{Mono sum,Stereo}>-Input
slider15:0<-24,12,0.1>-Output (dB)
slider16:100<0,100,1>-Mix (%)
slider17:0<0,100,1>-Band sat (%)
slider18:30<0,100,1>-Bias (%)
slider19:120<40,400,1>-Sat low band (Hz)
slider20:6000<2000,16000,10>-Sat high band (Hz)
slider21:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider22:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider23:0<-24,12,0.1>-Input trim (dB)
slider24:1<0,1,1{Off,On}>-Input guard
slider25:50<0,100,1>-Drift (%)
slider26:prs_sel=0<0,9,1{No preset,Init,Gentle Sway,Classic Auto-Pan,Hard Ping-Pong,Wandering,Slow Swirl,Amp Trem,Choppy Trem,Warble Trem}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-autopan";                                  // the ? pop-up links to this manual

function update() (
  mode = slider1;
  shape = slider2;
  smooth = slider3 / 100;
  syncmode = slider4;
  frate = slider5;
  div = floor(slider6 + 0.5);
  phoff = slider7 / 360;
  depth_t = slider8 / 100;
  cent_t = slider9 / 100;
  drift_macro(slider25);
  rd = slider10 / 100 * dm_a;
  dd = min(slider11 / 100 * dm_a, 1);
  cd = slider12 / 100 * dm_a;
  dspd = slider13 * dm_s;
  inmode = slider14;
  out_t = 10 ^ (slider15 / 20);
  mix_t = slider16 / 100;
  in_setup(slider23, slider24);
  ost_setup(slider17 / 100, slider18 / 100, slider19, slider20, slider21, 0);   // output stage: straight through
  lfo1.lfo_setup(shape, smooth);
);

// ---------- presets (leave Phase, Input, Output, Mix, Drift speed alone) ----------
function setp(m, s, sm_, sy, fr, dv, dp, ct, r_, d_, c_) (
  slider1 = m; slider2 = s; slider3 = sm_; slider4 = sy; slider5 = fr; slider6 = dv;
  slider8 = dp; slider9 = ct; slider10 = r_; slider11 = d_; slider12 = c_;
);
function load_preset(p) (
  p == 1 ? setp(0, 0, 60, 0, 0.12, 6, 30, 0,  5, 10, 0 ) :   // Init (the defaults)
  p == 2 ? setp(0, 0, 30, 1, 1,   2,  50, 0, 10, 15, 5 ) :   // Gentle Sway
  p == 3 ? setp(0, 0, 30, 1, 1,   6, 100, 0,  3,  5, 0 ) :   // Classic Auto-Pan
  p == 4 ? setp(0, 2, 10, 1, 1,   9, 100, 0,  0,  0, 0 ) :   // Hard Ping-Pong
  p == 5 ? setp(0, 3, 100, 1, 1,  1,  70, 0, 20, 20, 15) :   // Wandering
  p == 6 ? setp(0, 0, 30, 0, 0.8, 6,  60, 0, 25, 15, 5 ) :   // Slow Swirl
  p == 7 ? setp(1, 0, 30, 0, 5,   6,  60, 0,  3,  5, 0 ) :   // Amp Trem
  p == 8 ? setp(1, 2, 15, 1, 1,  12, 100, 0,  0,  0, 0 ) :   // Choppy Trem
  p == 9 ? setp(1, 1, 30, 1, 1,  11,  50, 0, 15, 10, 0 );    // Warble Trem
  p >= 1 && p <= 9 ? slider_automate(4031);   // sliders 1-6, 8-12
  p == 10 ? (                                   // Reset all to defaults
    slider1 = 0; slider2 = 0; slider3 = 60; slider4 = 0; slider5 = 0.12; slider6 = 6;
    slider7 = 0; slider8 = 30; slider9 = 0; slider10 = 5; slider11 = 10; slider12 = 0;
    slider13 = 0.25; slider14 = 0; slider15 = 0; slider16 = 100;
    slider17 = 0; slider18 = 30; slider19 = 120; slider20 = 6000; slider21 = -0.3; slider22 = 1;
    slider23 = 0; slider24 = 1; slider25 = 50;
    slider_automate(33554431);
  );
);

// ---------- state ----------
hist = 0; hidx = 0;            // random-shape scope history (100 slots)
memset(hist, 0, 100);

sm  = 1 - exp(-1 / (0.03 * srate));
sm2 = 1 - exp(-1 / (0.001 * srate));

drR.drift_init(0.8 + rand(0.5));
drD.drift_init(0.8 + rand(0.5));
drC.drift_init(0.8 + rand(0.5));

lfo1.lfo_init();
gL = 1; gR = 1;
pkL = 0; pkR = 0;

ost_init(1000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
vuc = 1 - exp(-1 / (0.01 * srate)); vu_ms = 0;
vu_sine = 10 * log10(2);   // +3.01 dB: RMS -> sine peak, so a sine peaking at the ref level reads 0 VU
ui_thm = 5; ui_hw = 1;                            // house keycaps for the preset bar and the size picker (one look)
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );            // new instances open in Medium, on Init
ui_dflt = 1;   // applies once: @init re-runs (playback start, device reset) must not undo the saved size / preset
update();
depth_s = depth_t; cent_s = cent_t; mix_s = mix_t; out_s = out_t;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
update();
lfo1.lfo_block(syncmode, div, frate);

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_avail(0) != 0 ? (                           // the preset in use (older projects end before it)
  file_var(0, pr_cur); pr_ver = 2;
  file_avail(0) != 0 ? file_var(0, pr_ver) : pr_cur >= 1 ? pr_cur += 1;   // saved before INIT became preset 1
) : pr_cur = 0;
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// input stage: DC block, trim, guard
in_process(spl0, spl1);
inL = in_l; inR = in_r;
vu_ms += (0.5 * (inL * inL + inR * inR) - vu_ms) * vuc;

// drift
dinc = dspd / srate;
vR = drR.drift_tick(dinc);
vD = drD.drift_tick(dinc);
vC = drC.drift_tick(dinc);

// smoothing
depth_s += (depth_t - depth_s) * sm;
cent_s  += (cent_t  - cent_s)  * sm;
mix_s   += (mix_t   - mix_s)   * sm;
out_s   += (out_t   - out_s)   * sm;

// LFO (shared GFX LFO: free mode drifts the rate, sync mode wobbles the phase)
lv = lfo1.lfo_tick(phoff, rd, vR);
p = lfo1.p;

// effective depth / centre with drift
de = depth_s * (1 - dd * (0.5 + 0.5 * vD));
ce = cent_s + cd * vC;

mode == 1 ? (
  // tremolo
  g = 1 - de * (0.5 - 0.5 * lv);
  srcL = inL; srcR = inR; gtL = g; gtR = g;
) : (
  pos = min(max(ce + de * lv, -1), 1);
  inmode == 0 ? (
    // true pan, equal power, unity at centre
    srcL = 0.5 * (inL + inR); srcR = srcL;
    ang = (pos + 1) * 0.25 * $pi;
    gtL = 1.41421356 * cos(ang); gtR = 1.41421356 * sin(ang);
  ) : (
    // balance, keeps stereo image
    srcL = inL; srcR = inR;
    gtL = pos > 0 ? cos(pos * 0.5 * $pi) : 1;
    gtR = pos < 0 ? cos(-pos * 0.5 * $pi) : 1;
  );
);

gL += (gtL - gL) * sm2;
gR += (gtR - gR) * sm2;

// output stage: band saturation -> output gain (no clip: straight through)
oL = ostL.ost_band(inL * (1 - mix_s) + srcL * gL * mix_s) * in_comp * out_s;
oR = ostR.ost_band(inR * (1 - mix_s) + srcR * gR * mix_s) * in_comp * out_s;
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;

pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));

// for display
dispPos = pos; dispG = g; dispPh = p; dispMod = lv; dispCe = ce; dispDe = de;

@gfx 960 388
ui_thm = 5; ui_hw = 1;   // one look: older projects reload their saved theme / HW flag (kept in @serialize, no longer drawn)
ui_begin(960, 388);
// =====================================================================
// GUI - navy panel, coral / aqua / lilac accents (design space 960 x 388; S / M / L).
// MODE | LFO (display, shape, rate mode) | MOVEMENT | OUTPUT; the DRIFT + IN / OUT meter strip below.
// Knobs: drag (SHIFT = fine), wheel, double-click = default; the label shows the value while the knob is touched.
// TRIM: click the knob (or its LED, upper right) for the input GUARD.
// =====================================================================
// v1.0.1: bigger print (reported too small to read), calibrated like the house fonts and set every frame
// (the fonts were set only once per scale change)
sc != ap_lsc ? (
  ap_lsc = sc;
  ap_f11 = ui_fitfont(11, 18 * sc);     // section titles
  ap_f12 = ui_fitfont(12, 15 * sc);     // big knob label / DRIFT
  ap_f13 = ui_fitfont(13, 13.5 * sc);   // small print, small knob labels
  ap_f14 = ui_fitfont(14, 14 * sc);     // keys
  ap_f15 = ui_fitfont(15, 27 * sc);     // the unit's name
  ap_f9  = ui_fitfont(9, 16 * sc);      // the big MODE keys
  ap_f10 = ui_fitfont(10, 12 * sc);     // the display's print
);
gfx_setfont(11, "Trebuchet MS", ap_f11, 'b');  gfx_setfont(12, "Trebuchet MS", ap_f12, 'b');
gfx_setfont(13, "Trebuchet MS", ap_f13, 'b');  gfx_setfont(14, "Trebuchet MS", ap_f14, 'b');
gfx_setfont(15, "Trebuchet MS", ap_f15, 'b');  gfx_setfont(9, "Trebuchet MS", ap_f9, 'b');
gfx_setfont(10, "Trebuchet MS", ap_f10, 'b');
AP_FACE = 0x101624; AP_PLATE = 0x182033; AP_EDGE = 0x2E3A55; AP_INK = 0xEEF0F4; AP_DIM = 0x939CB0;
AP_ACC = 0xFF7A5C; AP_AQU = 0x5CC8E0; AP_LIL = 0xB8A0F0; AP_TRAY = 0x0A0E18; AP_KEY = 0x222A3E; AP_CAP = 0xC9CED8;

function ap_rr(x, y, w, h, r) local(x1, y1, x2, y2, rr) (
  x1 = floor(x * sc + 0.5); y1 = floor(y * sc + 0.5); x2 = floor((x + w) * sc + 0.5); y2 = floor((y + h) * sc + 0.5);
  rr = min(floor(r * sc + 0.5), floor((min(x2 - x1, y2 - y1)) * 0.5));
  gfx_a < 1 ? ui_rrs(x1, y1, x2 - x1, y2 - y1, rr) : (
    gfx_rect(x1 + rr, y1, x2 - x1 - 2 * rr, y2 - y1);
    gfx_rect(x1, y1 + rr, rr + 1, y2 - y1 - 2 * rr); gfx_rect(x2 - rr - 1, y1 + rr, rr + 1, y2 - y1 - 2 * rr);
    gfx_circle(x1 + rr, y1 + rr, rr, 1, 1); gfx_circle(x2 - rr - 1, y1 + rr, rr, 1, 1);
    gfx_circle(x1 + rr, y2 - rr - 1, rr, 1, 1); gfx_circle(x2 - rr - 1, y2 - rr - 1, rr, 1, 1);
  );
);
function ap_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function ap_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function ap_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function ap_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function ap_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a flat key; ap_kfont picks its caption font (reset to 14 after each key); ap_dis = 1: dimmed and inert (reset after)
ap_kfont = 14; ap_dis = 0;
function ap_key(x, y, w, h, on, col, s) local(hov, hit, a) (
  a = ap_dis ? 0.35 : 1;
  hov = !ap_dis && ap_in(x, y, w, h); hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.4 * a); ap_rr(x + 1, y + 2, w, h, 4);
  on ? ( ui_cola(col, 0.22 * a); ap_rr(x - 3, y - 3, w + 6, h + 6, 6); );
  ui_cola(on ? (ap_dis ? ui_mix(col, AP_KEY, 0.6) : col) : AP_KEY, 1); ap_rr(x, y, w, h, 4);
  !on ? ( ui_cola(ui_mix(col, AP_KEY, 0.7), a); ap_r(x + 3, y, w - 6, 2); );
  hov ? ( ui_cola(0xFFFFFF, 0.1); ap_rr(x, y, w, h, 4); );
  gfx_setfont(ap_kfont); ui_cola(on ? 0x14161C : ui_mix(col, AP_INK, 0.45), on ? 1 : a);
  ui_keytext((x + w * 0.5) * sc, (y + h * 0.5) * sc, s);
  gfx_a = 1; ap_kfont = 14; ap_dis = 0;
  hit;
);
function ap_sec(x0, w, title) (
  ui_cola(0x000000, 0.47); ap_rr(x0 + 1, 74, w, 226, 8);
  ui_col(AP_EDGE); ap_rr(x0, 72, w, 226, 8);
  ui_col(AP_PLATE); ap_rr(x0 + 1.5, 73.5, w - 3, 223, 7);
  ui_col(AP_ACC); ap_r(x0 + 18, 84, 4, 22);
  gfx_setfont(11); ui_col(AP_INK); ap_tl(x0 + 30, 85, title);
  dy_bg = 0x3C4967; dy_ink = AP_INK;   // (dy_bg: the knob track is drawn 30 % darker: 0x2A3348)
);
function ap_inset(x, y, w, h) ( pk_inset(x * sc, y * sc, w * sc, h * sc, AP_TRAY); );
function ap_rivet(x, y) (
  ui_cola(0x000000, 0.4); gfx_circle((x + 0.5) * sc, (y + 1) * sc, 3 * sc, 1, 1);
  ui_col(0x3A4660); gfx_circle(x * sc, y * sc, 3 * sc, 1, 1);
  ui_col(0x56627E); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 1.2 * sc, 1, 1);
);
// the knob's normalised position (0 .. 1)
function ap_n(idx, lo, hi, lg) local(n) (
  n = lg ? log(slider(idx) / lo) / log(hi / lo) : (slider(idx) - lo) / (hi - lo); min(max(n, 0), 1);
);
// the value arc in col (over dy_ccap's own, which follows the cap) and a dark pointer (over the cap's light one)
function ap_ptr(cx, cy, r, idx, lo, hi, lg, col) local(n, a, a0, ca, sa, x1, y1, x2, y2, k, rr) (
  n = ap_n(idx, lo, hi, lg); a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  n > 0.004 ? (
    rr = (r + 6) * sc; ui_col(col); dy_arcw(cx * sc, cy * sc, rr, a0, a, 3 * sc);
    gfx_circle(cx * sc + sin(a0) * rr, cy * sc - cos(a0) * rr, 1.5 * sc, 1, 1); gfx_circle(cx * sc + ca * rr, cy * sc + sa * rr, 1.5 * sc, 1, 1);
  );
  ui_col(0x181C26);
  x1 = (cx + ca * r * 0.3) * sc; y1 = (cy + sa * r * 0.3) * sc; x2 = (cx + ca * (r - 3)) * sc; y2 = (cy + sa * (r - 3)) * sc;
  k = -1.2; loop(7, gfx_line(x1 - sa * k * sc, y1 + ca * k * sc, x2 - sa * k * sc, y2 + ca * k * sc, 1); k += 0.4; );
);
// a knob: cap colour, arc colour; the label (or, while touched, the value) under it (big: 14 px, 22 below; small: 12 px, 14 below)
function ap_knob(cx, cy, r, idx, lo, hi, def, lg, cap, col, lbl, val, big) (
  dy_kst = 36; dy_knob(cx, cy, r, idx, lo, hi, def, lg, cap, "", ""); ap_ptr(cx, cy, r, idx, lo, hi, lg, col);
  gfx_setfont(big ? 12 : 13); ui_col(dy_act ? col : AP_INK); ap_tc(cx, cy + r + (big ? 18 : 14), dy_act ? val : lbl);
);
function ap_shname(i) ( i == 0 ? "SINE" : i == 1 ? "TRI" : i == 2 ? "SQR" : "RND"; );

// =====================================================================
// Draw
// =====================================================================
ui_col(AP_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(AP_ACC); ap_r(0, 58, 960, 1.5);
ap_rivet(8, 8); ap_rivet(952, 8); ap_rivet(8, 380); ap_rivet(952, 380);

// ---------- header ----------
ui_col(AP_ACC); gfx_circle(48 * sc, 30 * sc, 16 * sc, 1, 1);
gfx_setfont(13); ui_col(AP_FACE); ui_keytext(48 * sc, 30 * sc, "GFX");
gfx_setfont(15); ui_col(AP_INK); ap_tl(76, 12, "AUTOPAN"); gfx_measurestr("AUTOPAN", ap_tw, ap_th);
ap_x = 88 + ap_tw / sc;
ui_col(AP_ACC); ap_r(ap_x, 20, 8, 8); ui_col(AP_AQU); ap_r(ap_x + 11, 20, 8, 8);
gfx_setfont(13); ui_col(AP_DIM); ap_tl(ap_x, 33, "STEREO AUTO-PAN  ·  TREMOLO");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(452 * sc, 14 * sc, 390 * sc, 30 * sc, pr_cur, "Init|Gentle Sway|Classic Auto-Pan|Hard Ping-Pong|Wandering|Slow Swirl|Amp Trem|Choppy Trem|Warble Trem");
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 9 ? 0 : k_; );
ui_size_picker(864 * sc, 20 * sc);

// ---------- MODE ----------
ap_sec(24, 170, "MODE");
ap_kfont = 9; ap_key(42, 112, 134, 40, slider1 == 0, AP_ACC, "PAN")  ? ( slider1 = 0; ui_auto(1); );
ap_kfont = 9; ap_key(42, 160, 134, 40, slider1 == 1, AP_ACC, "TREM") ? ( slider1 = 1; ui_auto(1); );
gfx_setfont(13); ui_cola(AP_DIM, slider1 == 0 ? 1 : 0.4); ap_tl(42, 222, "INPUT"); gfx_a = 1;
ap_dis = slider1 != 0; ap_key(42,  240, 64, 28, slider14 == 0, AP_AQU, "MONO")   ? ( slider14 = 0; ui_auto(14); );
ap_dis = slider1 != 0; ap_key(112, 240, 64, 28, slider14 == 1, AP_AQU, "STEREO") ? ( slider14 = 1; ui_auto(14); );

// ---------- LFO: the display (pan field / trem gain + the LFO), shape, rate mode ----------
ap_sec(204, 330, "LFO");
ap_inset(222, 108, 294, 92);
lx = 238 * sc; lw = 144 * sc; my = 152 * sc;
ui_col(0x3A4660);
slider1 == 0 ? (
  gfx_line(lx, my, lx + lw, my);
  gfx_line(lx, my - 6 * sc, lx, my + 6 * sc);
  gfx_line(lx + lw * 0.5, my - 4 * sc, lx + lw * 0.5, my + 4 * sc);
  gfx_line(lx + lw, my - 6 * sc, lx + lw, my + 6 * sc);
  gfx_setfont(13); ui_col(AP_DIM);
  ap_tl(226, 145, "L"); ap_tl(388, 145, "R");
  x1 = lx + (max(dispCe - dispDe, -1) + 1) * 0.5 * lw;
  x2 = lx + (min(dispCe + dispDe,  1) + 1) * 0.5 * lw;
  ui_cola(AP_ACC, 0.31); gfx_rect(x1, my - 3 * sc, max(x2 - x1, 1), 6 * sc); gfx_a = 1;
  ui_col(AP_ACC); gfx_circle(lx + (dispPos + 1) * 0.5 * lw, my, 6 * sc, 1, 1);
  gfx_setfont(10); ui_col(AP_DIM); ap_tl(230, 114, "PAN FIELD");
) : (
  gfx_rect(lx, my - 6 * sc, lw, 12 * sc);
  ui_col(AP_ACC); gfx_rect(lx, my - 6 * sc, lw * min(max(dispG, 0), 1), 12 * sc);
  gfx_setfont(10); ui_col(AP_DIM); ap_tl(230, 114, "TREM GAIN");
);
sx0 = 392 * sc; sw0 = 112 * sc; sa = 26 * sc;
ui_col(0x2A3348); gfx_line(sx0, my, sx0 + sw0, my);
slider2 < 3 ? (
  ui_col(AP_AQU);
  i = 0;
  loop(65,
    pp = i / 64;
    qx = sx0 + pp * sw0; qy = my - lfo_shape_d(pp, slider2, lfo1.k, lfo1.tk) * sa;
    i > 0 ? ( gfx_line(px, py, qx, qy, 1); gfx_line(px, py + 0.8 * sc, qx, qy + 0.8 * sc, 1); );
    px = qx; py = qy; i += 1;
  );
  ui_col(AP_ACC); mx = sx0 + dispPh * sw0;
  gfx_line(mx, my - 30 * sc, mx, my + 30 * sc);
  gfx_circle(mx, my - dispMod * sa, 3 * sc, 1, 1);
) : (
  hist[hidx] = dispMod; hidx = (hidx + 1) % 100;
  ui_col(AP_AQU);
  i = 0;
  loop(100,
    j = (hidx + i) % 100;
    qx = sx0 + i / 99 * sw0; qy = my - hist[j] * sa;
    i > 0 ? ( gfx_line(px, py, qx, qy, 1); gfx_line(px, py + 0.8 * sc, qx, qy + 0.8 * sc, 1); );
    px = qx; py = qy; i += 1;
  );
);
slider4 ? strcpy(#ap_rt, lfo_div_name(floor(slider6 + 0.5))) : sprintf(#ap_rt, "%.2f Hz", slider5);
sprintf(#ap_ro, "%s  %s", ap_shname(floor(slider2 + 0.5)), #ap_rt);
gfx_setfont(10); ui_col(AP_DIM); ap_tr(510, 114, #ap_ro);
ap_key(222, 214, 69, 28, slider2 == 0, AP_AQU, "SINE") ? ( slider2 = 0; ui_auto(2); );
ap_key(297, 214, 69, 28, slider2 == 1, AP_AQU, "TRI")  ? ( slider2 = 1; ui_auto(2); );
ap_key(372, 214, 69, 28, slider2 == 2, AP_AQU, "SQR")  ? ( slider2 = 2; ui_auto(2); );
ap_key(447, 214, 69, 28, slider2 == 3, AP_AQU, "RND")  ? ( slider2 = 3; ui_auto(2); );
ap_key(222, 254, 94, 28, slider4 == 0, AP_LIL, "FREE") ? ( slider4 = 0; ui_auto(4); );
ap_key(322, 254, 94, 28, slider4 == 1, AP_LIL, "SYNC") ? ( slider4 = 1; ui_auto(4); );
ap_key(422, 254, 94, 28, slider4 == 2, AP_LIL, "FLOW") ? ( slider4 = 2; ui_auto(4); );

// ---------- MOVEMENT ----------
ap_sec(544, 250, "MOVEMENT");
slider4 ? (
  // SYNC / FLOW: the divisions, in whole steps (the wheel moves one step)
  mouse_wheel != 0 && drag_id == 0 && sqr(mouse_x - 608 * sc) + sqr(mouse_y - 178 * sc) <= sqr(41 * sc) ? (
    slider6 = min(max(floor(slider6 + 0.5) + sign(mouse_wheel), 0), 15); ui_auto(6); mouse_wheel = 0;
  );
  ap_knob(608, 178, 36, 6, 0, 15, 6, 0, AP_CAP, AP_ACC, "RATE", lfo_div_name(floor(slider6 + 0.5)), 1);
  slider6 != floor(slider6 + 0.5) ? ( slider6 = floor(slider6 + 0.5); ui_auto(6); );   // whole steps, as knob_step = 1 did
) : (
  sprintf(#apv, "%.2f Hz", slider5); ap_knob(608, 178, 36, 5, 0.05, 20, 0.12, 1, AP_CAP, AP_ACC, "RATE", #apv, 1);
);
sprintf(#apv, "%.0f%%", slider8);  ap_knob(700, 140, 20, 8, 0, 100, 30, 0, AP_CAP, AP_ACC, "DEPTH", #apv, 0);
sprintf(#apv, "%+.0f%%", slider9); ap_knob(760, 140, 20, 9, -100, 100, 0, 0, AP_CAP, AP_ACC, "CENTRE", #apv, 0);
sprintf(#apv, "%.0f°", slider7);   ap_knob(700, 232, 20, 7, 0, 360, 0, 0, AP_CAP, AP_ACC, "PHASE", #apv, 0);
sprintf(#apv, "%.0f%%", slider3);  ap_knob(760, 232, 20, 3, 0, 100, 60, 0, AP_CAP, AP_ACC, "SMOOTH", #apv, 0);

// ---------- OUTPUT ----------
ap_sec(804, 132, "OUTPUT");
sprintf(#apv, "%.0f%%", slider16);    ap_knob(840, 140, 18, 16, 0, 100, 100, 0, AP_CAP, AP_ACC, "MIX", #apv, 0);
sprintf(#apv, "%+.1f dB", slider15);  ap_knob(900, 140, 18, 15, -24, 12, 0, 0, AP_CAP, AP_ACC, "LEVEL", #apv, 0);
// TRIM, its GUARD LED at the upper right (click the knob, or the LED, to switch it)
ap_gd = (25.5 + 2.6 + 2.6 * 1.618) * 0.7071;
pressed && drag_id == 0 && sqr(mouse_x - (840 + ap_gd) * sc) + sqr(mouse_y - (232 - ap_gd) * sc) <= sqr(6 * sc) ? (
  slider24 = 1 - slider24; ui_auto(24); drag_id = -1;
);
sprintf(#apv, "%+.1f dB", slider23);  ap_knob(840, 232, 18, 23, -24, 12, 0, 0, 0x606674, AP_ACC, "TRIM", #apv, 0);
ui_guardclick(1600 + 23, 24, 840, 232, 25.5);
sprintf(#apv, "%.0f%%", slider17);    ap_knob(900, 232, 18, 17, 0, 100, 0, 0, 0xD8B040, AP_ACC, "SAT", #apv, 0);

// ---------- strip: DRIFT ----------
ap_inset(24, 310, 376, 66);
dy_bg = 0x3C4967;
dy_kst = 36; dy_knob(62, 343, 18, 25, 0, 100, 50, 0, AP_CAP, "", ""); ap_ptr(62, 343, 18, 25, 0, 100, 0, AP_AQU);
sprintf(#apv, "DRIFT  %.0f%%", slider25);
gfx_setfont(12); ui_col(dy_act ? AP_AQU : AP_INK); ap_tl(92, 328, dy_act ? #apv : "DRIFT");
gfx_setfont(13); ui_col(AP_DIM); ap_tl(92, 350, "RATE · DEPTH · CENTRE WANDER");

// ---------- strip: IN / OUT meters ----------
ap_inset(412, 310, 524, 66);
apmI.ui_ledm(470 * sc, 326 * sc, 464 * sc, 9 * sc, in_pk);
apmO.ui_ledm(470 * sc, 348 * sc, 464 * sc, 9 * sc, max(pkL, pkR));
in_pk *= 0.85; pkL *= 0.85; pkR *= 0.85;
gfx_setfont(13); ui_col(AP_DIM); ap_tr(456, 324, "IN"); ap_tr(456, 346, "OUT");

pk_end();
ui_end();
