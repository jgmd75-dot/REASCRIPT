slider104:45<0,100,1>-II tone (%)
slider105:25<0,100,1>-III tone (%)
slider106:prs_sel=0<0,14,1{No preset,Init (The Journey),Phase Walk,Organ Canon,Additive,Pulse Field,Mirror Steps,Desert Organ,Three Paths,Wanderer's Reeds,Cliff Edge,Open Road,Little Dog,Free Fall,Endless Beginning}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-fool";                                  // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();   // 20000 - 24095
FO_HELD = 25000; FO_SET = 25200; FO_SETV = 25400; FO_SRT = 25600; FO_SRTV = 25800;   // held keys, note set, its velocities, sorted copy
FO_DEF = 26000;                                            // the Init values of sliders 1-105 (62-68 unused)
FO_TMP = 26200;                                            // preset parser scratch (400)
FO_PREV = 26600; FO_CUR = 26620;                           // the pattern before STEP OFF (13 values), swap scratch
FO_AS = 26700;                                             // arp state, 16 per path
FO_AP = 26760;                                             // per-path voice values for the audio loop, 16 per path
FO_FJ = 26900; FO_FP = 26904; FO_FCUT = 26908; FO_FN = 26912; FO_FRT = 26916;   // FATE: timing, chance, cutoff, pan, LFO rate
FO_LS = 28400;                                             // LFO state, 16 per path
FO_V = 27000;                                              // 18 voices x 32 slots (6 per path)
FO_QO = 27600; FO_QA = 27730; FO_QN = 27860; FO_QV = 27990; FO_QG = 28120;   // note event queue (128 each)
FO_RLEN = 28300; FO_RIDX = 28310; FO_RZ = 28320; FO_RAL = 28330; FO_RAI = 28340; // reverb lengths / indices / states
FO_CFST = 29000;                                             // CF-1 state (64), MD-6 state (64 from 29100)
FO_MDST = 29100;
// the long buffers follow the sample rate: fo_srinit() lays them out again when it changes
//   110000 -   MD-6 delay lines (2 x 2^n, about 5 s each), then the CF-1 lines, then the plate
memset(25000, 0, 4300);
memset(FO_V, 0, 18 * 32);

// voice slots (p = FO_V + 32 * voice):
//   0 stage (0 idle, 1 attack, 2 decay, 3 release)  1 level  2 gate samples left  3 phase  4 inc  5 wave  6 path
//   7-9 filter coefficients  10 / 11 filter states  12 k  13 bell modulator phase  14 string delay  15 its write index
//   16 its last output  17 its feedback  18 coefficient countdown  19 gain  20 decay coef  21 release coef
//   22 attack step  23 note  24 key tracking  25 age  26 filter envelope (octaves)

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#fo_def = "1 0 4 6 1 0 80 0 100 2 6000 10 5000 70 -35 35 1 2 4 7 2 0 60 0 100 0 3500 15 600 55 35 45 1 1 1 8 1 -1 90 0 100 1 1800 10 5000 60 0 25 0 1 0 0 0 0 6 45 40 2.6 30 35 0 0 0 0 0 0 0 0 0.7 2 1 0 0 0 0 0.31 3 1 0 1 4 0 0.13 1 1 0 5 0 0 1 0 25 45 50 0 1 1 60 35 15 1 40 50 45 25";
function fo_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function fo_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
fo_nums(#fo_def, FO_DEF);

#fo_pm = "Init (The Journey)|Phase Walk|Organ Canon|Additive|Pulse Field|Mirror Steps|Desert Organ|Three Paths|Wanderer's Reeds|Cliff Edge|Open Road|Little Dog|Free Fall|Endless Beginning";
function fo_pstr(p) (
  p == 2  ? "3:7 4:12 15:-45 18:0 19:7 20:13 21:1 22:0 23:80 26:2 29:5000 30:65 31:45 104:50 33:0 55:5 57:30" :
  p == 3  ? "3:4 4:8 5:2 16:60 19:1 20:3 21:1 22:-1 30:40 33:0 56:70 57:60 58:3.2 61:2" :
  p == 4  ? "4:4 19:4 20:5 34:0 35:4 36:6 37:2 39:60 42:0 43:2500 45:400 105:40 61:2.5" :
  p == 5  ? "2:5 3:4 4:7 5:1 7:35 10:2 13:300 14:55 18:5 19:4 20:8 21:1 22:1 23:30 26:0 29:300 30:45 34:5 35:4 36:9 37:1 38:-1 39:40 42:1 45:300 46:55 61:1" :
  p == 6  ? "3:7 5:2 18:1 19:7 20:8 21:2 22:0 26:2 29:5000 34:2 35:4 36:6 61:-0.5" :
  p == 7  ? "3:4 4:6 8:20 11:2500 19:5 20:5 24:20 35:1 36:4 52:3 70:0 72:45 86:30" :
  p == 8  ? "3:7 4:7 19:7 20:8 23:50 26:1 104:30 34:2 35:7 36:9 37:2 39:50 42:0 43:2000 45:500 105:60 61:2" :
  p == 9  ? "3:5 10:0 11:4500 103:85 19:4 20:5 26:0 104:75 70:1 72:60 74:4 79:-50 61:2.5" :
  p == 10 ? "3:7 4:6 10:1 11:1400 12:60 103:50 20:7 27:2500 28:40 36:5 43:500 44:55 45:800 52:2 56:50 60:50 61:1.5" :
  p == 11 ? "3:1 4:4 7:95 19:0 20:3 23:95 26:2 29:5000 35:0 36:2 58:4.5 59:50 84:1 86:40 87:0 88:3 61:-0.5" :
  p == 12 ? "2:3 3:7 4:7 9:75 10:0 13:150 103:70 18:3 19:7 20:5 25:70 34:3 35:4 41:80 60:55 70:5 72:60 73:4 74:2 61:4" :
  p == 13 ? "2:3 3:9 4:11 9:75 12:40 18:3 19:7 20:13 22:2 25:70 28:40 34:3 35:4 36:7 38:-2 41:80 56:65 57:45 59:45 60:85 70:7 72:70 73:4 74:1 77:8 79:60 80:4 81:1 61:3" :
  p == 14 ? "3:1 4:3 19:2 20:5 26:2 29:5000 35:0 36:7 45:5000 55:7 56:80 57:55 58:5 59:60 60:45 77:0 79:50 80:5 81:5 61:-1.5" :
  "";
);
function fo_pstr_au(p) (
  p == 2  ? "3:7 4:12 15:-45 18:0 19:7 20:13 21:1 22:0 23:80 26:2 29:5000 30:65 31:45 104:50 33:0 55:5 57:30" :
  p == 3  ? "3:4 4:8 5:2 16:60 19:1 20:3 21:1 22:-1 30:40 33:0 56:70 57:60 58:3.2 61:2" :
  p == 4  ? "4:4 19:4 20:5 34:0 35:4 36:6 37:2 39:60 42:0 43:2500 45:400 105:40 61:2.5" :
  p == 5  ? "2:5 3:4 4:7 5:1 7:35 10:2 13:300 14:55 18:5 19:4 20:8 21:1 22:1 23:30 26:0 29:300 30:45 34:5 35:4 36:9 37:1 38:-1 39:40 42:1 45:300 46:55 61:1" :
  p == 6  ? "3:7 5:2 18:1 19:7 20:8 21:2 22:0 26:2 29:5000 34:2 35:4 36:6 61:-0.5" :
  p == 7  ? "3:4 4:6 8:20 11:2500 19:5 20:5 24:20 35:1 36:4 52:3 70:0 72:45 86:30" :
  p == 8  ? "3:7 4:7 19:7 20:8 23:50 26:1 104:30 34:2 35:7 36:9 37:2 39:50 42:0 43:2000 45:500 105:60 61:2" :
  p == 9  ? "3:5 10:0 11:4500 103:85 19:4 20:5 26:0 104:75 70:1 72:60 74:4 79:-50 61:2.5" :
  p == 10 ? "3:7 4:6 10:1 11:1400 12:60 103:50 20:7 27:2500 28:40 36:5 43:500 44:55 45:800 52:2 56:50 60:50 61:1.5" :
  p == 11 ? "3:1 4:4 7:95 19:0 20:3 23:95 26:2 29:5000 35:0 36:2 58:4.5 59:50 84:1 86:40 87:0 88:3 61:-0.5" :
  p == 12 ? "2:3 3:7 4:7 9:75 10:0 13:150 103:70 18:3 19:7 20:5 25:70 34:3 35:4 41:80 60:55 70:5 72:60 73:4 74:2 61:4" :
  p == 13 ? "2:3 3:9 4:11 9:75 12:40 18:3 19:7 20:13 22:2 25:70 28:40 34:3 35:4 36:7 38:-2 41:80 56:65 57:45 59:45 60:85 70:7 72:70 73:4 74:1 77:8 79:60 80:4 81:1 61:3" :
  p == 14 ? "3:1 4:3 19:2 20:5 26:2 29:5000 35:0 36:7 45:5000 55:7 56:80 57:55 58:5 59:60 60:45 77:0 79:50 80:5 81:5 61:-1.5" :
  "";
);
function load_preset(p) local(n, i) (
  i = 0; loop(105, i < 61 || i > 67 ? slider(i + 1) = FO_DEF[i]; i += 1; );
  n = fo_nums(fo_pstr(p), FO_TMP);
  i = 0; loop(floor(n / 2), FO_TMP[i * 2] >= 1 && FO_TMP[i * 2] <= 105 && (FO_TMP[i * 2] <= 61 || FO_TMP[i * 2] >= 69) ? slider(FO_TMP[i * 2]) = FO_TMP[i * 2 + 1]; i += 1; );
  i = 1; loop(105, i <= 61 || i >= 69 ? ui_auto(i); i += 1; );
  pr_cur = p;
);
function load_preset_au(p) local(n, i) (
  i = 0; loop(105, i < 61 || i > 67 ? slider(i + 1) = FO_DEF[i]; i += 1; );
  n = fo_nums_au(fo_pstr_au(p), FO_TMP);
  i = 0; loop(floor(n / 2), FO_TMP[i * 2] >= 1 && FO_TMP[i * 2] <= 105 && (FO_TMP[i * 2] <= 61 || FO_TMP[i * 2] >= 69) ? slider(FO_TMP[i * 2]) = FO_TMP[i * 2 + 1]; i += 1; );
  i = 1; loop(105, i <= 61 || i >= 69 ? ui_auto(i); i += 1; );
  pr_cur = p;
);
function reset_all() local(i) (                            // "Reset all to defaults": Init, and SAT / output stage / MIDI channel back too
  load_preset(1);
  i = 0; loop(105, slider(i + 1) = FO_DEF[i]; ui_auto(i + 1); i += 1; );
);

// ---------- STEP OFF: a seeded, repeatable deal of MODE / LENGTH / OFFSET / PROB for the three paths ----------
function fo_rng() ( fo_rs = fo_rs * 16807; fo_rs -= 2147483647 * floor(fo_rs / 2147483647); fo_rs / 2147483647; );
function fo_lens(i) (
  i == 0 ? 3 : i == 1 ? 4 : i == 2 ? 5 : i == 3 ? 6 : i == 4 ? 7 : i == 5 ? 8 : i == 6 ? 9 : i == 7 ? 10 :
  i == 8 ? 11 : i == 9 ? 12 : i == 10 ? 13 : 16;
);
function fo_snap(dst) local(a, b) (
  a = 0; loop(3, b = 1 + 16 * a;
    dst[a * 4] = slider(b + 1); dst[a * 4 + 1] = slider(b + 3); dst[a * 4 + 2] = slider(b + 5); dst[a * 4 + 3] = slider(b + 8);
    a += 1; );
  dst[12] = slider54;
);
function fo_apply(src) local(a, b) (
  a = 0; loop(3, b = 1 + 16 * a;
    slider(b + 1) = src[a * 4]; slider(b + 3) = src[a * 4 + 1]; slider(b + 5) = src[a * 4 + 2]; slider(b + 8) = src[a * 4 + 3];
    ui_auto(b + 1); ui_auto(b + 3); ui_auto(b + 5); ui_auto(b + 8);
    a += 1; );
  slider54 = src[12]; ui_auto(54);
);
function fo_deal(seed) local(a, b, r, m, ln, l0, l1, k) (
  fo_rs = 1 + seed * 7919 + 104729; fo_rng(); fo_rng(); fo_rng();
  l0 = l1 = -1;
  a = 0;
  loop(3,
    b = 1 + 16 * a;
    r = fo_rng();
    m = r < 0.2 ? 0 : r < 0.35 ? 1 : r < 0.55 ? 2 : r < 0.8 ? 3 : r < 0.93 ? 4 : 5;
    k = 0; ln = fo_lens(floor(fo_rng() * 12));
    while (k < 12 && (ln == l0 || ln == l1)) ( ln = fo_lens(floor(fo_rng() * 12)); k += 1; );
    a == 0 ? l0 = ln : l1 = ln;
    slider(b + 1) = m;
    slider(b + 3) = ln;
    slider(b + 5) = a == 0 ? floor(fo_rng() * 3) - 1 : a == 1 ? floor(fo_rng() * 3) : -floor(fo_rng() * 3);
    r = fo_rng(); slider(b + 8) = 100 - 5 * floor(r * r * 8.99);
    ui_auto(b + 1); ui_auto(b + 3); ui_auto(b + 5); ui_auto(b + 8);
    a += 1;
  );
  slider54 = seed; ui_auto(54);
);
// seed < 0: a fresh seed
function fo_stepoff(seed) (
  fo_snap(FO_PREV); fo_hasprev = 1;
  seed < 0 ? seed = floor(rand(10000)) % 10000;
  fo_deal(seed);
);
function fo_return() local(i) (
  fo_hasprev ? (
    fo_snap(FO_CUR); fo_apply(FO_PREV);
    i = 0; loop(13, FO_PREV[i] = FO_CUR[i]; i += 1; );
  );
);

// ---------- note set (held keys, latch) ----------
function fo_key(n, v, on) local(i, f) (
  on ? (
    fo_latch && fo_pn == 0 ? fo_sn = 0;                // first key of a new latched chord replaces the old one
    fo_sn == 0 ? fo_fresh = 1;                         // a new chord
    f = 0; i = 0; loop(fo_pn, FO_HELD[i] == n ? f = 1; i += 1; );
    !f && fo_pn < 127 ? ( FO_HELD[fo_pn] = n; fo_pn += 1; );
    f = 0; i = 0; loop(fo_sn, FO_SET[i] == n ? ( f = 1; FO_SETV[i] = v; ); i += 1; );
    !f && fo_sn < 127 ? ( FO_SET[fo_sn] = n; FO_SETV[fo_sn] = v; fo_sn += 1; );
  ) : (
    i = 0; f = -1; loop(fo_pn, FO_HELD[i] == n ? f = i; i += 1; );
    f >= 0 ? ( i = f; loop(fo_pn - f - 1, FO_HELD[i] = FO_HELD[i + 1]; i += 1; ); fo_pn -= 1; );
    !fo_latch ? (
      i = 0; f = -1; loop(fo_sn, FO_SET[i] == n ? f = i; i += 1; );
      f >= 0 ? ( i = f; loop(fo_sn - f - 1, FO_SET[i] = FO_SET[i + 1]; FO_SETV[i] = FO_SETV[i + 1]; i += 1; ); fo_sn -= 1; );
    );
  );
);
// sorted copy of the set (as played for mode 4)
function fo_build(md) local(i, j, n, v) (
  i = 0; loop(fo_sn, FO_SRT[i] = FO_SET[i]; FO_SRTV[i] = FO_SETV[i]; i += 1; );
  md != 4 ? (
    i = 1;
    loop(max(fo_sn - 1, 0),
      n = FO_SRT[i]; v = FO_SRTV[i]; j = i - 1;
      while (j >= 0 && FO_SRT[j] > n) ( FO_SRT[j + 1] = FO_SRT[j]; FO_SRTV[j + 1] = FO_SRTV[j]; j -= 1; );
      FO_SRT[j + 1] = n; FO_SRTV[j + 1] = v;
      i += 1;
    );
  );
);

// ---------- timing ----------
function fo_rb(r) (
  r == 0 ? 2 : r == 1 ? 1 : r == 2 ? 1.5 : r == 3 ? 2 / 3 : r == 4 ? 0.5 : r == 5 ? 0.75 : r == 6 ? 1 / 3 :
  r == 7 ? 0.25 : r == 8 ? 0.375 : r == 9 ? 1 / 6 : 0.125;
);
function fo_rname(r) (
  r == 0 ? "1/2" : r == 1 ? "1/4" : r == 2 ? "1/4." : r == 3 ? "1/4T" : r == 4 ? "1/8" : r == 5 ? "1/8." : r == 6 ? "1/8T" :
  r == 7 ? "1/16" : r == 8 ? "1/16." : r == 9 ? "1/16T" : "1/32";
);
function fo_odd(k) ( k - 2 * floor(k / 2); );
// start of step k (in beats) on a grid of L-beat steps, every second step pushed later by the swing
function fo_sbt(k, L, sw) ( floor(k / 2) * 2 * L + (fo_odd(k) ? L * (1 + sw) : 0); );
function fo_hash(x) ( x = sin(x * 12.9898 + 78.233) * 43758.5453; x - floor(x); );
// RANDOM mode: a fixed shuffled walk for this seed and path (no note twice in a row), so it repeats every LENGTH steps
function fo_rnd(a, pos, nn) local(i, v, pv) (
  pv = -1; i = 0;
  loop(pos + 1,
    v = floor(fo_hash(fo_seed * 0.913 + a * 31.7 + i * 2.71 + 3.1) * nn);
    v == pv && nn > 1 ? v = (v + 1 + floor(fo_hash(fo_seed * 0.37 + a * 5.1 + i * 7.7 + 0.9) * (nn - 1))) % nn;
    pv = v; i += 1;
  );
  pv;
);
// FATE micro-timing of the next step (beats)
function fo_jit(a) ( (FO_FJ[a] * 0.0045 + (rand(2) - 1) * 0.0012 * dm_a) * fo_tempo / 60; );

// ---------- scale ----------
function fo_mask(s) ( s == 1 ? 2741 : s == 2 ? 1453 : s == 3 ? 1709 : 661; );
function fo_note(n, off) local(d, m, k) (
  n += 12 * off + fo_tr;
  fo_scale > 0 ? (
    m = fo_mask(fo_scale); d = n - fo_root; d -= 12 * floor(d / 12); k = 0;
    while (k < 12 && !((m >> d) & 1)) ( d -= 1; n -= 1; d < 0 ? d += 12; k += 1; );
  );
  while (n > 127) ( n -= 12; );
  while (n < 0) ( n += 12; );
  n;
);

// ---------- events ----------
function fo_push(ofs, a, n, v, g) local(i) (
  fo_qc < 128 ? (
    i = fo_qc; while (i > 0 && FO_QO[i - 1] > ofs) ( FO_QO[i] = FO_QO[i - 1]; FO_QA[i] = FO_QA[i - 1]; FO_QN[i] = FO_QN[i - 1];
      FO_QV[i] = FO_QV[i - 1]; FO_QG[i] = FO_QG[i - 1]; i -= 1; );
    FO_QO[i] = ofs; FO_QA[i] = a; FO_QN[i] = n; FO_QV[i] = v; FO_QG[i] = g; fo_qc += 1;
  );
);
// one pattern step of path a: step index k, sample offset ofs, step length gl (samples)
function fo_fire(a, k, ofs, gl) local(b, s, len, pos, n, nn, oct, p, i, note, v, md, c, off) (
  b = 1 + a * 16; s = FO_AS + a * 16;
  len = slider(b + 3); pos = k - s[1]; pos -= len * floor(pos / len);
  s[6] = pos; s[9] += 1;
  rand(1) < slider(b + 8) / 100 - FO_FP[a] ? (
    md = slider(b + 1); fo_build(md);
    n = fo_sn; oct = slider(b + 4); nn = n * oct; off = slider(b + 5);
    gl = max(gl * slider(b + 6) / 100, 0.004 * srate);
    md == 5 ? (
      i = 0;
      loop(min(n, 6),
        note = fo_note(FO_SRT[i] + 12 * (pos % oct), off);
        fo_push(ofs, a, note, FO_SRTV[i] * (pos == 0 ? 1.1 : 1), gl);
        i += 1;
      );
    ) : (
      p = md == 0 || md == 4 ? pos % nn :
          md == 1 ? nn - 1 - pos % nn :
          md == 2 ? ( nn < 2 ? 0 : ( c = pos % (2 * nn - 2); c < nn ? c : 2 * nn - 2 - c; ); ) :
          fo_rnd(a, pos, nn);
      p = min(max(p, 0), nn - 1);
      note = fo_note(FO_SRT[p % n] + 12 * floor(p / n), off);
      fo_push(ofs, a, note, FO_SRTV[p % n] * (pos == 0 ? 1.1 : 1), gl);
    );
    s[7] += 1;
  );
);
// path a for this block: fire every step whose (FATE-shifted) time falls before t1
function fo_arp(a, t0, t1, bps) local(b, s, L, sw, k, t, ln, guard) (
  b = 1 + a * 16; s = FO_AS + a * 16;
  L = fo_rb(slider(b + 2)); sw = slider(b + 7) / 100;
  (s[8] || L != s[3] || sw != s[4]) ? (
    k = 2 * floor(t0 / (2 * L));
    while (fo_sbt(k, L, sw) < t0 - 0.0000001) ( k += 1; );
    s[0] = k; s[3] = L; s[4] = sw; s[2] = fo_jit(a);
    s[8] == 2 ? s[1] = k;                              // a new chord: the pattern starts on this step
    s[8] = 0;
  );
  !fo_sync ? s[1] = 0;                                 // FREE: the pattern is locked to the song position
  slider(b) >= 0.5 && fo_sn > 0 ? (
    guard = 0;
    while (guard < 64 && fo_sbt(s[0], L, sw) + s[2] < t1) (
      k = s[0]; t = fo_sbt(k, L, sw) + s[2];
      ln = fo_odd(k) ? L * (1 - sw) : L * (1 + sw);
      fo_fire(a, k, min(max(floor((t - t0) / bps), 0), fo_ns - 1), ln / bps);
      s[0] = k + 1; s[2] = fo_jit(a);
      guard += 1;
    );
  ) : (
    s[8] = s[8] == 2 ? 2 : 1;                          // idle: pick the grid up again when it plays
  );
);

// ---------- voices: SQUARE / TRI in the spirit of the transistor combo organs, ORGAN a drawbar additive organ ----------
function fo_wgain(w) ( w == 0 ? 0.62 : w == 1 ? 0.8 : 0.78; );
function fo_vstart(a, note, vel, gl) local(i, p, best, ba, vi, f, dec, w) (
  best = -1; ba = 0;
  i = 0; loop(6, p = FO_V + (a * 6 + i) * 32; p[0] == 0 && (best < 0 || p[25] < ba) ? ( best = i; ba = p[25]; ); i += 1; );
  best < 0 ? ( i = 0; loop(6, p = FO_V + (a * 6 + i) * 32; best < 0 || p[25] < ba ? ( best = i; ba = p[25]; ); i += 1; ); );
  vi = a * 6 + best; p = FO_V + vi * 32;
  w = FO_AP[a * 16]; dec = FO_AP[a * 16 + 1];
  f = 440 * 2 ^ ((note - 69) / 12) * ins_note_detune();
  p[0] == 0 ? ( p[10] = 0; p[11] = 0; p[1] = 0; p[3] = rand(1); );
  p[4] = min(f / srate, 0.45); p[5] = w; p[6] = a; p[23] = note;
  p[24] = 2 ^ ((note - 60) / 24);
  p[26] = w == 2 ? 0.3 : 1.0;                         // a little filter envelope (organ: hardly any)
  p[22] = 1 / ((w == 2 ? 0.0015 : 0.0025) * srate);   // fast attack
  p[20] = dec >= 4.9 ? 1 : exp(-6.9 / (dec * srate)); // DECAY fully up = HOLD: the note sustains for its gate
  p[21] = exp(-6.9 / ((dec >= 4.9 ? (w == 2 ? 0.03 : 0.045) : 0.015 + min(dec * 0.3, 0.3)) * srate));
  p[19] = (0.35 + 0.65 * min(vel, 127) / 127) * fo_wgain(w);
  p[2] = max(floor(gl), 1);
  p[18] = 0;
  fo_age += 1; p[25] = fo_age;
  // organ: key click (a few ms of contact noise), slight percussion on the 2 2/3', the upper drawbars band-limited
  p[13] = w == 2 ? 0.22 : 0; p[14] = w == 2 ? 0.3 : 0; p[15] = 0;
  p[16] = 3 * f < fo_nyq; p[17] = 4 * f < fo_nyq;
  p[0] = 1;
);

// =====================================================================
// THE JOURNEY: three units from the house pedals and plate
//   CF-1  the chorus / flanger pedal of the GFX Ten Rack (an insert on the dry paths: the organ's own shimmer)
//   MD-6  the Ten Rack's modulated delay (fed by the paths' SENDs), with tempo sync added: the tape-echo canon
//   PLATE the WEST plate of the GFX Platte81 with its 'Vocal Plate' settings (fed by the SENDs and the echoes)
// =====================================================================
function fo_p2(n) local(p) ( p = 1; while (p < n) ( p *= 2; ); p; );
function fo_opc(fc) ( 1 - exp(-2 * $pi * min(fc, srate * 0.45) / srate); );   // one-pole coefficient
function fo_sat(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function fo_tri(p) local(t) ( p -= floor(p); t = 4 * abs(p - 0.5) - 1; t * (1.5 - 0.5 * t * t); );
// 4-point Hermite read d samples behind the write head wp of a line of n samples
function fo_rd(buf, d, wp, n) local(rp, i, f, im, i1, i2, xm1, x0, x1, x2) (
  rp = wp - d; rp < 0 ? rp += n;
  i = floor(rp); f = rp - i;
  im = i - 1; im < 0 ? im += n;
  i1 = i + 1; i1 >= n ? i1 -= n;
  i2 = i1 + 1; i2 >= n ? i2 -= n;
  xm1 = buf[im]; x0 = buf[i]; x1 = buf[i1]; x2 = buf[i2];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f + 0.5 * (x1 - xm1)) * f) + x0;
);
// biquad (as the house dynamics include): 0 LP, 1 HP
function fo_bqs(type, f, q) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); n = 1 + al;
  type == 0 ? ( b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; ) : ( b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; );
  a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function fo_bqr(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function fo_db(r) ( r == 0 ? 0.25 : r == 1 ? 1 / 3 : r == 2 ? 0.5 : r == 3 ? 0.75 : r == 4 ? 2 / 3 : r == 5 ? 1 : r == 6 ? 1.5 : r == 7 ? 2 : r == 8 ? 3 : 4; );
function fo_dname(r) ( r == 0 ? "1/16" : r == 1 ? "1/8T" : r == 2 ? "1/8" : r == 3 ? "1/8." : r == 4 ? "1/4T" : r == 5 ? "1/4" : r == 6 ? "1/4." : r == 7 ? "1/2" : r == 8 ? "1/2." : "1 BAR"; );

// ---------- CF-1 (knobs 0..1: morph, rate, depth, manual, regen). P[0..7] targets, P[8..15] smoothed ----------
function fo_cftgt() local(P, a, bb, c, d, e, m, cc, fc, cm) (
  P = FO_CFST;
  a = slider91 / 100; bb = slider92 / 100; c = slider93 / 100; d = slider94 / 100; e = slider95 / 100;
  cm = 1 + 0.03 * dm_a * FO_FRT[0];               // FATE: the bucket-brigade clock wanders a touch
  m = a;
  P[0] = 0.1 * 100 ^ bb;                          // rate 0.1 .. 10 Hz
  cc = 3 * 4 ^ d; fc = 0.4 * 10 ^ d;              // MANUAL: chorus 3 .. 12 ms, flanger 0.4 .. 4 ms
  P[1] = cc ^ (1 - m) * fc ^ m * cm;
  P[2] = c * 2.2 * min(1, cc / 4);
  P[3] = c * 1.7;
  P[4] = 0.92 * e * (0.3 + 0.7 * m);
  P[5] = m;
  P[6] = 0.5 * (1 - m) + 0.18 * m;
  P[7] = 1 - 0.4 * P[4];
  P[40] = fo_opc(7500 + 4500 * m);
);
function fo_cf(xl, xr) local(P, ph, lf, lr, m, cen, dl, dr, wl, wr, c, fb, g) (
  P = FO_CFST;
  P[8]  += fo_cfs * (P[0] - P[8]);  P[9]  += fo_cfs * (P[1] - P[9]);  P[10] += fo_cfs * (P[2] - P[10]); P[11] += fo_cfs * (P[3] - P[11]);
  P[12] += fo_cfs * (P[4] - P[12]); P[13] += fo_cfs * (P[5] - P[13]); P[14] += fo_cfs * (P[6] - P[14]); P[15] += fo_cfs * (P[7] - P[15]);
  ph = P[16] + P[8] / srate; ph -= floor(ph); P[16] = ph;
  lf = fo_tri(ph); lr = fo_tri(ph + P[14]);
  m = P[13]; cen = P[9];
  dl = (1 - m) * (cen + P[10] * lf) + m * cen * 2 ^ (P[11] * lf);
  dr = (1 - m) * (cen + P[10] * lr) + m * cen * 2 ^ (P[11] * lr);
  wl = fo_rd(FO_CFL, max(3, min(fo_cfn - 8, dl * fo_msr)), fo_cfw, fo_cfn);
  wr = fo_rd(FO_CFR, max(3, min(fo_cfn - 8, dr * fo_msr)), fo_cfw, fo_cfn);
  c = P[40];
  P[17] += c * (wl - P[17]); P[18] += c * (P[17] - P[18]); wl = P[18];     // BBD reconstruction filter
  P[19] += c * (wr - P[19]); P[20] += c * (P[19] - P[20]); wr = P[20];
  fb = P[12];
  P[21] += c * (xl + fb * fo_sat(wl) - P[21]); FO_CFL[fo_cfw] = P[21] + fo_dn;
  P[22] += c * (xr + fb * fo_sat(wr) - P[22]); FO_CFR[fo_cfw] = P[22] + fo_dn;
  fo_cfw += 1; fo_cfw >= fo_cfn ? fo_cfw = 0;
  g = P[15];
  fo_yl = 0.5 * (xl + g * wl) * (1.5 - 0.4 * m); fo_yr = 0.5 * (xr + g * wr) * (1.5 - 0.4 * m);
);

// asleep: only the moving parts tick on (smoothers, LFO phase, write position), so it wakes exactly in step
function fo_cf_idle() local(P, ph) (
  P = FO_CFST;
  P[8]  += fo_cfs * (P[0] - P[8]);  P[9]  += fo_cfs * (P[1] - P[9]);  P[10] += fo_cfs * (P[2] - P[10]); P[11] += fo_cfs * (P[3] - P[11]);
  P[12] += fo_cfs * (P[4] - P[12]); P[13] += fo_cfs * (P[5] - P[13]); P[14] += fo_cfs * (P[6] - P[14]); P[15] += fo_cfs * (P[7] - P[15]);
  ph = P[16] + P[8] / srate; ph -= floor(ph); P[16] = ph;
  fo_cfw += 1; fo_cfw >= fo_cfn ? fo_cfw = 0;
);

// ---------- MD-6 (knobs: time, feedback, mod rate, mod depth, level) with tempo sync ----------
function fo_mdtgt() local(P, t, bt) (
  P = FO_MDST;
  slider97 >= 0.5 ? (
    bt = fo_db(slider55);
    t = bt * 60 / fo_tempo * srate;
    while (t > fo_mdn - 16 && bt > 0.25) ( bt *= 0.5; t = bt * 60 / fo_tempo * srate; );   // too long for the tape: half the time
  ) : t = 20 * 100 ^ (slider98 / 100) * fo_msr;      // free: 20 ms .. 2 s
  P[0] = max(3, min(fo_mdn - 16, t));
  P[1] = 0.95 * slider56 / 100;
  P[2] = 0.05 * 160 ^ (slider99 / 100) * (1 + 0.2 * dm_a * FO_FRT[1]);
  P[3] = 9 * sqr(slider100 / 100);
  P[4] = slider57 / 100;
  P[40] = fo_opc(4200 * (1 + 0.1 * dm_a * FO_FRT[2])); P[41] = fo_opc(60);
);
function fo_md(xl, xr) local(P, ph, dm, dl, dr, yl, yr, fb, fl, fr) (
  P = FO_MDST;
  P[9]  += fo_cfs * (P[1] - P[9]);  P[10] += fo_cfs * (P[2] - P[10]);
  P[11] += fo_cfs * (P[3] - P[11]); P[12] += fo_cfs * (P[4] - P[12]);
  P[16] += fo_glc * (P[0] - P[16]);                                         // time glide: tape-like bend
  ph = P[17] + P[10] / srate; ph -= floor(ph); P[17] = ph;
  dm = P[11] * fo_msr;
  // the wow is centred on the set time (so a synced echo stays on the beat)
  dl = max(3, min(fo_mdn - 8, P[16] + dm * sin(2 * $pi * ph)));
  dr = max(3, min(fo_mdn - 8, P[16] + dm * sin(2 * $pi * (ph + 0.25))));
  yl = fo_rd(FO_MDL, dl, fo_mdw, fo_mdn); yr = fo_rd(FO_MDR, dr, fo_mdw, fo_mdn);
  P[18] += P[40] * (yl - P[18]); P[19] += P[41] * (P[18] - P[19]); fl = P[18] - P[19];
  P[20] += P[40] * (yr - P[20]); P[21] += P[41] * (P[20] - P[21]); fr = P[20] - P[21];
  fb = P[9];
  FO_MDL[fo_mdw] = xl + fo_sat(fb * fl * 1.1) / 1.1 + fo_dn;
  FO_MDR[fo_mdw] = xr + fo_sat(fb * fr * 1.1) / 1.1 + fo_dn;
  fo_mdw += 1; fo_mdw >= fo_mdn ? fo_mdw = 0;
  fo_yl = P[12] * fl; fo_yr = P[12] * fr;                                   // the echoes only (the dry stays with the paths)
);

function fo_md_idle() local(P, ph) (
  P = FO_MDST;
  P[9]  += fo_cfs * (P[1] - P[9]);  P[10] += fo_cfs * (P[2] - P[10]);
  P[11] += fo_cfs * (P[3] - P[11]); P[12] += fo_cfs * (P[4] - P[12]);
  P[16] += fo_glc * (P[0] - P[16]);
  ph = P[17] + P[10] / srate; ph -= floor(ph); P[17] = ph;
  fo_mdw += 1; fo_mdw >= fo_mdn ? fo_mdw = 0;
);

// ---------- PLATE (the Platte81's WEST plate) ----------
function fp_alloc(n) local(p) ( p = fp_next; fp_next += n; memset(p, 0, n); p; );
function fp_mem(base) (
  fp_next = base;
  fp_bsz = fo_p2(0.16 * srate);  fp_bm = fp_bsz - 1;
  fp_asz = fo_p2(0.02 * srate);  fp_am = fp_asz - 1;
  fp_psz = fo_p2(0.26 * srate);  fp_pm = fp_psz - 1;
  fp_lb = fp_alloc(16 * fp_bsz); fp_ab = fp_alloc(16 * fp_asz); fp_ab2 = fp_alloc(16 * fp_asz);
  fp_dbf = fp_alloc(12 * fp_asz); fp_pb = fp_alloc(2 * fp_psz);
  fp_len = fp_alloc(16); fp_apl = fp_alloc(16); fp_g = fp_alloc(16); fp_kl = fp_alloc(16); fp_ja = fp_alloc(16); fp_jb = fp_alloc(16);
  fp_c = fp_alloc(16); fp_tpl = fp_alloc(16); fp_tpr = fp_alloc(16); fp_sgl = fp_alloc(16); fp_sgr = fp_alloc(16); fp_is = fp_alloc(16);
  fp_o = fp_alloc(16); fp_dv = fp_alloc(16); fp_dr = fp_alloc(64); fp_dln = fp_alloc(12); fp_dgn = fp_alloc(12);
  fp_ap2n = fp_alloc(16); fp_g2 = fp_alloc(16);
  fp_lo = fp_alloc(16); fp_y = fp_alloc(16); fp_d1x = fp_alloc(16); fp_d1y = fp_alloc(16); fp_d2x = fp_alloc(16); fp_d2y = fp_alloc(16);
  fp_dc = fp_alloc(32);
);
function fp_lines() local(i, ms, ap, f) (
  i = 0;
  loop(16,
    ms = i == 0 ? 17.3 : i == 1 ? 19.9 : i == 2 ? 22.7 : i == 3 ? 24.1 : i == 4 ? 26.9 : i == 5 ? 29.3 : i == 6 ? 31.7 : i == 7 ? 33.1 :
         i == 8 ? 35.9 : i == 9 ? 38.3 : i == 10 ? 40.1 : i == 11 ? 43.7 : i == 12 ? 46.1 : i == 13 ? 49.3 : i == 14 ? 52.7 : 56.9;
    ap = i == 0 ? 3.1 : i == 1 ? 4.3 : i == 2 ? 5.3 : i == 3 ? 6.1 : i == 4 ? 2.7 : i == 5 ? 3.7 : i == 6 ? 4.9 : i == 7 ? 5.7 :
         i == 8 ? 2.3 : i == 9 ? 3.3 : i == 10 ? 4.1 : i == 11 ? 5.9 : i == 12 ? 6.7 : i == 13 ? 2.9 : i == 14 ? 3.9 : 4.7;
    fp_len[i] = floor(ms * 1.6 * 0.001 * srate) | 1;
    fp_apl[i] = floor(ap * 0.001 * srate) | 1;
    fp_g[i] = (i & 1 ? -1 : 1) * 0.62;
    ap = 7.3 + 5.8 * (i * 0.7548777 + 0.31 - floor(i * 0.7548777 + 0.31));
    fp_ap2n[i] = floor(ap * 0.001 * srate) | 1;
    fp_g2[i] = (i & 2 ? -1 : 1) * 0.5;
    f = i * 0.6180339 + 0.13 - floor(i * 0.6180339 + 0.13); fp_tpl[i] = max(floor((0.3 + 70 * f * f) * 0.001 * srate), 1);
    f = i * 0.3819661 + 0.71 - floor(i * 0.3819661 + 0.71); fp_tpr[i] = max(floor((0.3 + 70 * f * f) * 0.001 * srate), 1);
    fp_sgl[i] = (i == 1 || i == 2 || i == 6 || i == 9 || i == 11 || i == 12 || i == 13 || i == 15) ? -1 : 1;
    fp_sgr[i] = (i == 0 || i == 3 || i == 4 || i == 6 || i == 10 || i == 11 || i == 13 || i == 14) ? -1 : 1;
    fp_is[i] = (i == 2 || i == 3 || i == 6 || i == 7 || i == 9 || i == 12 || i == 13 || i == 14) ? -1 : 1;
    i += 1;
  );
  i = 0;
  loop(12,
    ms = i == 0 ? 0.31 : i == 1 ? 0.53 : i == 2 ? 0.89 : i == 3 ? 1.37 : i == 4 ? 2.11 : i == 5 ? 3.23 :
         i == 6 ? 0.37 : i == 7 ? 0.61 : i == 8 ? 0.97 : i == 9 ? 1.53 : i == 10 ? 2.33 : 3.61;
    fp_dln[i] = floor(ms * 0.35 * 0.001 * srate) | 1;
    fp_dgn[i] = 0.7;
    i += 1;
  );
  fp_c0 = -0.42; fp_hipad = 2.2; fp_thf = 3.0; fp_lomul = 1.1;
);
function fp_dinit(p) ( p[0] = rand(2) - 1; p[1] = rand(2) - 1; p[2] = rand(1); p[3] = 0.7 + rand(0.6); );
function fp_dtick(p, inc) (
  p[2] += inc * p[3];
  p[2] >= 1 ? ( p[2] -= 1; p[0] = p[1]; p[1] = rand(2) - 1; );
  p[0] + (p[1] - p[0]) * (0.5 - 0.5 * cos($pi * p[2]));
);
function fp_satw(u) ( ost_tanh(u * 0.6) * 1.6666667 );
function fp_diff(x, k0) local(j, b, d, g, y) (
  j = 0;
  loop(6,
    b = fp_dbf + (k0 + j) * fp_asz; g = fp_dgn[k0 + j];
    d = b[(fp_dw - fp_dln[k0 + j]) & fp_am];
    y = d - g * x; b[fp_dw] = x + g * y; x = y;
    j += 1;
  );
  x;
);
function fp_disp(x, k0) local(j, p, y) (
  j = 0;
  loop(6,
    p = fp_dc + k0 + j * 2;
    y = -0.5 * x + p[0] + 0.5 * p[1]; p[0] = x; p[1] = y; x = y;
    j += 1;
  );
  x;
);
// control rate (every 32 samples): DECAY -> the loss filters of the 16 lines
function fp_ctl() local(i, T, Tl, Th, L, gl, gm, gh) (
  fp_ts += (fp_tt - fp_ts) * fp_tk;
  T = fp_ts * (1 + fp_ddv);
  Tl = T * fp_lomul;
  Th = 1 / (1 / (T * fp_hipad) + 1 / fp_thf);
  i = 0;
  loop(16,
    L = (fp_len[i] + fp_apl[i] + fp_ap2n[i]) * -6.9077553 / srate;
    gl = exp(L / Tl); gm = exp(L / T); gh = exp(L / Th);
    fp_kl[i] = gl / gm - 1;
    fp_ja[i] = gh / gm - 1; fp_jb[i] = gm;
    fp_c[i] = fp_c0 + 0.035 * fp_dv[i];
    i += 1;
  );
  fp_wg = 1.26 * (2.2 / fp_ts) ^ 0.12;
);
// the Vocal Plate's settings: low cut 150 Hz, high cut 12 kHz, drive 25 %, width 100 %, mono in (DECAY, PRE-DELAY, MIX on the panel)
function fp_srinit() local(i) (
  fp_lines();
  fp_clo = 1 - exp(-2 * $pi * 300 / srate); fp_chi = 1 - exp(-2 * $pi * 2500 / srate);
  fp_tk = 1 - exp(-32 / (0.12 * srate));
  fpdA.fo_bqs(1, 55, 0.6);
  fplL.fo_bqs(1, 150, 0.7071); fplR.fo_bqs(1, 150, 0.7071);
  fphL.fo_bqs(0, 12000, 0.7071); fphR.fo_bqs(0, 12000, 0.7071);
  fp_dg = 10 ^ (0.25 * 24 / 20);
  i = 0; loop(16, fp_dinit(fp_dr + i * 4); i += 1; );
  fp_w = 0; fp_aw = 0; fp_dw = 0; fp_pw = 0; fp_cc = 0;
  fp_ts = fp_tt = 2.6; fp_ddv = 0; fp_ctl();
  fp_pre = 0.04 * srate;
);
function fp_idle() (
  (fp_cc -= 1) <= 0 ? ( fp_cc = 32; fp_ctl(); );
  fp_pre += (fp_pret - fp_pre) * 0.0004;
  fp_pw = (fp_pw + 1) & fp_pm; fp_dw = (fp_dw + 1) & fp_am;
  fp_w = (fp_w + 1) & fp_bm; fp_aw = (fp_aw + 1) & fp_am;
);
// the plate on (xl, xr) -> fp_wl, fp_wr (wet only)
function fp_run(xl, xr) local(i, bb, v, u, y, cf, m, xa, xb, rp, ri, rf, i0, i1, da, db) (
  (fp_cc -= 1) <= 0 ? ( fp_cc = 32; fp_ctl(); );
  fp_pre += (fp_pret - fp_pre) * 0.0004;
  m = 0.5 * (xl + xr);                                   // mono in: one driver, fed L + R
  xa = fpdA.fo_bqr(fp_satw(m * fp_dg) / fp_dg);
  fp_pb[fp_pw] = xa;
  rp = fp_pw - fp_pre; rp < 0 ? rp += fp_psz;
  ri = floor(rp); rf = rp - ri; i0 = ri & fp_pm; i1 = (ri + 1) & fp_pm;
  xa = fp_pb[i0] + (fp_pb[i1] - fp_pb[i0]) * rf; xb = xa;
  fp_pw = (fp_pw + 1) & fp_pm;
  da = fp_diff(fp_disp(xa, 0), 0) * 0.5;
  db = fp_diff(fp_disp(xb, 16), 6) * 0.5;
  fp_dw = (fp_dw + 1) & fp_am;
  fp_tl = 0; fp_tr = 0;
  i = 0;
  loop(16,
    bb = fp_lb + i * fp_bsz;
    v = bb[(fp_w - fp_len[i]) & fp_bm];
    fp_tl += fp_sgl[i] * bb[(fp_w - fp_tpl[i]) & fp_bm];
    fp_tr += fp_sgr[i] * bb[(fp_w - fp_tpr[i]) & fp_bm];
    fp_lo[i] += (v - fp_lo[i]) * fp_clo;
    v += fp_kl[i] * fp_lo[i];
    fp_y[i] += (v - fp_y[i]) * fp_chi;
    fp_o[i] = fp_jb[i] * (v + fp_ja[i] * (v - fp_y[i]));
    i += 1;
  );
  // 16 x 16 Hadamard (four butterfly stages)
  i = 0; loop(8, u = fp_o[2 * i]; v = fp_o[2 * i + 1]; fp_o[2 * i] = u + v; fp_o[2 * i + 1] = u - v; i += 1; );
  i = 0; loop(16, (i & 2) == 0 ? ( u = fp_o[i]; v = fp_o[i + 2]; fp_o[i] = u + v; fp_o[i + 2] = u - v; ); i += 1; );
  i = 0; loop(16, (i & 4) == 0 ? ( u = fp_o[i]; v = fp_o[i + 4]; fp_o[i] = u + v; fp_o[i + 4] = u - v; ); i += 1; );
  i = 0; loop(8, u = fp_o[i]; v = fp_o[i + 8]; fp_o[i] = u + v; fp_o[i + 8] = u - v; i += 1; );
  i = 0;
  loop(16,
    u = fp_o[i] * 0.25 + fp_is[i] * (i & 1 ? db : da);
    bb = fp_ab + i * fp_asz;
    v = bb[(fp_aw - fp_apl[i]) & fp_am];
    y = v - fp_g[i] * u; bb[fp_aw] = u + fp_g[i] * y;
    bb = fp_ab2 + i * fp_asz;
    v = bb[(fp_aw - fp_ap2n[i]) & fp_am];
    u = v - fp_g2[i] * y; bb[fp_aw] = y + fp_g2[i] * u; y = u;
    cf = fp_c[i];
    u = cf * y + fp_d1x[i] - cf * fp_d1y[i]; fp_d1x[i] = y; fp_d1y[i] = u;
    v = cf * u + fp_d2x[i] - cf * fp_d2y[i]; fp_d2x[i] = u; fp_d2y[i] = v;
    bb = fp_lb + i * fp_bsz; bb[fp_w] = min(max(v + fo_dn, -4), 4);
    i += 1;
  );
  fp_w = (fp_w + 1) & fp_bm;
  fp_aw = (fp_aw + 1) & fp_am;
  fp_wl = fplL.fo_bqr(fp_tl * 0.25 * fp_wg); fp_wr = fplR.fo_bqr(fp_tr * 0.25 * fp_wg);
  fp_wl = fphL.fo_bqr(fp_wl); fp_wr = fphR.fo_bqr(fp_wr);
);

// ---------- the three LFOs (one per path) ----------
// state per path (FO_LS + 16 a): 0 phase (cycles, running total)  1 cycle index  2 S&H value  3 output (slewed)
//   4 / 5 smooth-random points  6 sync origin (beats)  7 output for the panel  8 phase step per sample
//   10 / 11 the CUTOFF's glide (log Hz, two stages)  12 the RESO's glide
function fo_lb(r) ( r == 0 ? 16 : r == 1 ? 8 : r == 2 ? 4 : r == 3 ? 3 : r == 4 ? 2 : r == 5 ? 1 : r == 6 ? 2 / 3 : r == 7 ? 0.5 : r == 8 ? 1 / 3 : 0.25; );
function fo_lname(r) ( r == 0 ? "4 BARS" : r == 1 ? "2 BARS" : r == 2 ? "1 BAR" : r == 3 ? "3/4" : r == 4 ? "1/2" : r == 5 ? "1/4" : r == 6 ? "1/4T" : r == 7 ? "1/8" : r == 8 ? "1/8T" : "1/16"; );
// once a block: the phase step, and (synced, playing) the phase locked to the project's beat
function fo_lfob(a) local(b, ls, pp, org) (
  b = 69 + 7 * a; ls = FO_LS + 16 * a;
  slider(b + 2) >= 0.5 ? (
    pp = fo_lb(slider(b + 1)); ls[8] = fo_bps / pp;
    org = slider(b + 6) >= 0.5 ? ls[6] : 0;
    fo_play ? ls[0] = (fo_t0 - org) / pp;
  ) : (
    ls[8] = slider(b) * 2 ^ (FO_FRT[a] * 0.12) / srate;          // FATE: free rates wander a little
  );
);
// a new chord with RETRIG on: the LFO starts again from the top
function fo_lfort(a) local(ls) (
  ls = FO_LS + 16 * a;
  slider(69 + 7 * a + 6) >= 0.5 ? ( ls[6] = fo_t0; ls[0] = 0; ls[1] = -1; );
);
// the control tick (every 16 samples): advance the LFOs, apply them to the paths
function fo_ctl(adv) local(a, b, lb, ls, s, c, ph, raw, v, d, dest, cut, res, dec, lg, pan, sd, th) (
  a = 0;
  loop(3,
    b = 1 + 16 * a; lb = 69 + 7 * a; ls = FO_LS + 16 * a; s = FO_AP + 16 * a;
    ls[0] += ls[8] * adv;
    c = floor(ls[0]);
    c != ls[1] ? ( ls[1] = c; ls[2] = rand(2) - 1; ls[4] = ls[5]; ls[5] = rand(2) - 1; );
    ph = ls[0] - c;
    d = slider(lb + 4);
    raw = d == 0 ? sin(2 * $pi * ph) : d == 1 ? 1 - 4 * abs(ph - 0.5) : d == 2 ? 2 * ph - 1 : d == 3 ? (ph < 0.5 ? 1 : -1) :
          d == 4 ? ls[2] : ls[4] + (ls[5] - ls[4]) * (0.5 - 0.5 * cos($pi * ph));
    ls[3] += (raw - ls[3]) * (d == 4 ? fo_lsS : fo_lsF);          // steps are slewed: no clicks
    v = ls[3]; ls[7] = v;
    d = slider(lb + 3) / 100; dest = slider(lb + 5);
    // CUTOFF (two 15 ms stages) and RESO glide at the tick, so a turned knob or automation never steps
    !fo_fok ? ( ls[10] = ls[11] = log(s[4]); ls[12] = s[5]; ) : adv > 0 ? (
      ls[10] += (log(s[4]) - ls[10]) * fo_fk; ls[11] += (ls[10] - ls[11]) * fo_fk; ls[12] += (s[5] - ls[12]) * fo_fk; );
    cut = exp(ls[11]); res = ls[12]; dec = s[6]; lg = 1; pan = s[8]; sd = s[9];
    dest == 0 ? cut *= 2 ^ (d * v * 3) :                              // +/-3 octaves
    dest == 1 ? res += d * v * 0.6 :
    dest == 2 ? dec *= 2 ^ (d * v * 2.5) :                            // read by each note as it starts
    dest == 3 ? lg = max(0, 1 - abs(d) * (1 - (d < 0 ? -v : v)) * 0.5) :   // dips from the set level, never above it
    dest == 4 ? pan += d * v :
    sd += d * v * 0.5;
    s[1] = min(max(dec, 0.01), 8);
    s[2] = cut;
    s[3] = 2 - 1.9 * min(max(res, 0), 0.98);
    pan = min(max(pan, -1), 1); th = (pan + 1) * $pi / 4; lg *= s[7]; sd = min(max(sd, 0), 1);
    a == 0 ? ( fo_tl0 = cos(th) * 1.41421356 * lg; fo_tr0 = sin(th) * 1.41421356 * lg; fo_ts0 = sd; ) :
    a == 1 ? ( fo_tl1 = cos(th) * 1.41421356 * lg; fo_tr1 = sin(th) * 1.41421356 * lg; fo_ts1 = sd; ) :
             ( fo_tl2 = cos(th) * 1.41421356 * lg; fo_tr2 = sin(th) * 1.41421356 * lg; fo_ts2 = sd; );
    a += 1;
  );
  fo_fok = 1;
);

// ---------- parameters (every block) ----------
function fo_params() local(a, b, s, t) (
  fo_l2 = slider49 >= 0.5;
  fo_latch && !fo_l2 ? fo_relatch = 1;
  fo_latch = fo_l2;
  fo_sync = slider50 >= 0.5; fo_tr = slider51; fo_scale = slider52; fo_root = slider53; fo_seed = slider54;
  drift_macro(slider60);
  fo_chan = slider62;
  ins_output_setup(63);   // output stage: CLIP, always on
  fo_volt = 10 ^ (slider61 / 20) * fo_trim;
  fo_cfon = slider90 >= 0.5; fo_mdon = slider96 >= 0.5; fo_plon = slider101 >= 0.5;
  fo_cftgt(); fo_mdtgt();
  fp_tt = min(max(slider58, 0.4), 5); fp_pret = min(max(slider102, 0), 250) * 0.001 * srate;
  fo_plmx = sqr(slider59 / 100) * 1.2;
  a = 0;
  loop(3,
    b = 1 + 16 * a; s = FO_AP + 16 * a;
    // the base values; the LFO tick (fo_ctl) turns them into the values the voices and the mix use
    s[0] = slider(b + 9);
    s[4] = slider(b + 10) * 2 ^ FO_FCUT[a];
    s[5] = slider(b + 11) / 100;
    s[6] = slider(b + 12) / 1000;
    s[7] = sqr(slider(b + 13) / 100);
    s[8] = slider(b + 14) / 100 + FO_FN[a];
    s[9] = slider(b + 15) / 100;
    // the voice: SQUARE pulse width, TRI fold, ORGAN drawbars (8' always; TONE pulls out 4', 2 2/3', 2')
    t = slider(103 + a) / 100;
    s[13] = 0.5 - 0.42 * t;
    s[14] = t;
    s[10] = 0.02 + 0.78 * min(1, t * 3); s[11] = 0.015 + 0.6 * min(1, max(0, t * 3 - 1)); s[12] = 0.02 + 0.55 * min(1, max(0, t * 3 - 2));
    s[15] = 1 / (0.55 * (1 + s[10] + s[11] + s[12]));
    a += 1;
  );
);
// FATE: each path's timing, chance, cutoff and pan wander on their own
function fo_fate(ns) local(inc) (
  inc = 0.22 * ns / srate * dm_s;
  FO_FJ[0] = fz0j.drift_tick(inc) * dm_a; FO_FJ[1] = fz1j.drift_tick(inc) * dm_a; FO_FJ[2] = fz2j.drift_tick(inc) * dm_a;
  FO_FP[0] = (fz0p.drift_tick(inc) + 1) * 0.06 * dm_a; FO_FP[1] = (fz1p.drift_tick(inc) + 1) * 0.06 * dm_a;
  FO_FP[2] = (fz2p.drift_tick(inc) + 1) * 0.06 * dm_a;
  FO_FCUT[0] = fz0c.drift_tick(inc) * 0.35 * dm_a; FO_FCUT[1] = fz1c.drift_tick(inc) * 0.35 * dm_a; FO_FCUT[2] = fz2c.drift_tick(inc) * 0.35 * dm_a;
  FO_FRT[0] = fz0r.drift_tick(inc) * dm_a; FO_FRT[1] = fz1r.drift_tick(inc) * dm_a; FO_FRT[2] = fz2r.drift_tick(inc) * dm_a;
  FO_FN[0] = fz0n.drift_tick(inc) * 0.2 * dm_a; FO_FN[1] = fz1n.drift_tick(inc) * 0.2 * dm_a; FO_FN[2] = fz2n.drift_tick(inc) * 0.2 * dm_a;
);
fz0j.drift_init(0.8 + rand(0.5)); fz1j.drift_init(0.8 + rand(0.5)); fz2j.drift_init(0.8 + rand(0.5));
fz0p.drift_init(0.8 + rand(0.5)); fz1p.drift_init(0.8 + rand(0.5)); fz2p.drift_init(0.8 + rand(0.5));
fz0c.drift_init(0.8 + rand(0.5)); fz1c.drift_init(0.8 + rand(0.5)); fz2c.drift_init(0.8 + rand(0.5));
fz0r.drift_init(0.8 + rand(0.5)); fz1r.drift_init(0.8 + rand(0.5)); fz2r.drift_init(0.8 + rand(0.5));
fzpl.drift_init(0.8 + rand(0.5));
fz0n.drift_init(0.8 + rand(0.5)); fz1n.drift_init(0.8 + rand(0.5)); fz2n.drift_init(0.8 + rand(0.5));
ins_drift_init();

function fo_srinit() (
  fo_sr = srate; fo_sm = 1 - exp(-1 / (0.02 * srate)); fo_nyq = 0.45 * srate;
  fo_sm3 = 1 - exp(-1 / (0.003 * srate));                     // path gains (fast enough for a level LFO)
  fo_lsF = 1 - exp(-16 / (0.0015 * srate)); fo_lsS = 1 - exp(-16 / (0.008 * srate)); fo_fk = 1 - exp(-16 / (0.015 * srate));
  ost_init(20000);
  fo_msr = srate / 1000;
  fo_cfs = 1 - exp(-1 / (0.03 * srate)); fo_glc = 1 - exp(-1 / (0.18 * srate)); fo_fxg = 1 - exp(-1 / (0.012 * srate));
  fo_pdc = exp(-1 / (0.18 * srate)); fo_ckc = exp(-1 / (0.0025 * srate));       // organ percussion, key click
  // the long lines: MD-6 (about 5 s each), CF-1 (about 60 ms each), then the plate
  fo_mdn = fo_p2(4.5 * srate); FO_MDL = 110000; FO_MDR = FO_MDL + fo_mdn; memset(FO_MDL, 0, 2 * fo_mdn); fo_mdw = 0;
  fo_cfn = fo_p2(0.06 * srate); FO_CFL = FO_MDR + fo_mdn; FO_CFR = FO_CFL + fo_cfn; memset(FO_CFL, 0, 2 * fo_cfn); fo_cfw = 0;
  memset(FO_CFST, 0, 64); memset(FO_MDST, 0, 64);
  fp_mem(FO_CFR + fo_cfn + 64); fp_srinit();
  fo_fxsnap = 1; fo_cfg = fo_mdg = fo_plg = 0;
  fo_dcxl = fo_dcyl = fo_dcxr = fo_dcyr = 0;
);
fo_dn = 0.000000000000001;                               // anti-denormal whisper in the feedback loops (-300 dB)
fo_srinit();
fo_trim = 0.68;
fo_tempo = 120; fo_pn = 0; fo_sn = 0; fo_qc = 0; fo_age = 0; fo_fb = 0; fo_was = 0; fo_expect = -1;
fo_latch = 0; fo_fresh = 0; fo_relatch = 0; fo_panic = 0;
fo_ai = 0; loop(3, FO_AS[fo_ai * 16 + 8] = 1; FO_AS[fo_ai * 16 + 6] = -1; fo_ai += 1; );
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; ui_thm = 0; ui_hw = 1; );     // a new instance opens Large, on Init
memset(FO_LS, 0, 48); fo_fok = 0; fo_ai = 0; loop(3, FO_LS[fo_ai * 16 + 1] = -1; fo_ai += 1; );
fo_params(); fo_ctl(0); fo_ctc = 16;
fo_vol = fo_volt;
fo_gl0 = fo_tl0; fo_gr0 = fo_tr0; fo_gs0 = fo_ts0; fo_gl1 = fo_tl1; fo_gr1 = fo_tr1; fo_gs1 = fo_ts1;
fo_gl2 = fo_tl2; fo_gr2 = fo_tr2; fo_gs2 = fo_ts2;
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
fo_params(); fo_ctl(0);

@block
prs_chk();
srate != fo_sr ? fo_srinit();
fo_preq > 0 ? ( load_preset(fo_preq); fo_preq = 0; );        // test hooks: a preset, STEP OFF (1) / RETURN (2)
fo_req == 1 ? ( fo_stepoff(fo_reqseed > 0 ? fo_reqseed : -1); fo_req = 0; ) : fo_req == 2 ? ( fo_return(); fo_req = 0; );
fo_tempo = tempo > 1 ? tempo : 120;
fo_params();

while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, fo_chan) ? (
    fo_st = m1 & 0xF0;
    fo_st == 0x90 || fo_st == 0x80 ? (
      fo_key(m2, m3, fo_st == 0x90 && m3 > 0);
      fo_st == 0x90 && m3 > 0 ? ins_midi_hit();
    ) :
    fo_st == 0xB0 && (m2 == 123 || m2 == 120) ? fo_panic = 1;
  );
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( fo_panic = 1; );
gfx_pst_prev = gfx_pst;
fo_relatch ? (                                     // HOLD released: keep only the keys still down
  fo_relatch = 0;
  fo_sn = 0; fo_ai = 0; loop(fo_pn, FO_SET[fo_sn] = FO_HELD[fo_ai]; FO_SETV[fo_sn] = 100; fo_sn += 1; fo_ai += 1; );
);
fo_panic ? (
  fo_panic = 0; fo_sn = 0; fo_pn = 0;
  fo_ai = 0; loop(18, fo_p = FO_V + fo_ai * 32; fo_p[0] > 0 ? ( fo_p[0] = 3; fo_p[21] = exp(-6.9 / (0.01 * srate)); ); fo_ai += 1; );
);

// the clock: the project's beat when playing, free-running from the first key when stopped
fo_ns = samplesblock;
fo_bps = fo_tempo / 60 / srate;
fo_play = play_state & 1;
fo_play ? (
  fo_t0 = beat_position;
  (!fo_was || abs(fo_t0 - fo_expect) > 0.05) ? ( FO_AS[8] = max(FO_AS[8], 1); FO_AS[24] = max(FO_AS[24], 1); FO_AS[40] = max(FO_AS[40], 1); );
) : (
  fo_was ? ( fo_fb = 0; FO_AS[8] = max(FO_AS[8], 1); FO_AS[24] = max(FO_AS[24], 1); FO_AS[40] = max(FO_AS[40], 1); );
  fo_t0 = fo_fb;
);
fo_fresh ? (
  fo_fresh = 0;
  !fo_play ? ( fo_fb = 0; fo_t0 = 0; );
  FO_AS[8] = FO_AS[24] = FO_AS[40] = 2;
  fo_lfort(0); fo_lfort(1); fo_lfort(2);
);
fo_t1 = fo_t0 + fo_bps * fo_ns;
fo_was = fo_play; fo_expect = fo_t1;
fo_fate(fo_ns);
fo_lfob(0); fo_lfob(1); fo_lfob(2); fo_ctl(0); fo_ctc = 16;
fo_qc = 0;
fo_arp(0, fo_t0, fo_t1, fo_bps); fo_arp(1, fo_t0, fo_t1, fo_bps); fo_arp(2, fo_t0, fo_t1, fo_bps);
!fo_play ? ( fo_sn > 0 ? fo_fb = fo_t1 : fo_fb = 0; );
fo_sn == 0 ? ( FO_AS[6] = FO_AS[22] = FO_AS[38] = -1; );
fo_eqi = 0; fo_spos = 0;

ins_drift_block(slider60 / 100 * 0.4, fo_ns);
fo_pm = ins_pitch;
fo_fxsnap ? ( fo_fxsnap = 0; memcpy(FO_CFST + 8, FO_CFST, 8); memcpy(FO_MDST + 8, FO_MDST, 8); FO_MDST[16] = FO_MDST[0]; );
// DRIFT (FATE) on the plate: tension wander - decay and every line's dispersion
fp_di = 0.12 * dm_s * fo_ns / srate;
fp_ddv = 0.045 * dm_a * fzpl.drift_tick(fp_di);
fo_ai = 0; loop(16, fp_dv[fo_ai] = dm_a * fp_dtick(fp_dr + fo_ai * 4, fp_di); fo_ai += 1; );
abs(fo_dcyl) + abs(fo_dcyr) < 0.0000000001 ? fo_dcyl = fo_dcyr = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, fo_hasprev);
file_mem(0, FO_PREV, 13);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
while (fo_eqi < fo_qc && (FO_QO[fo_eqi] <= fo_spos || fo_spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  fo_vstart(FO_QA[fo_eqi], FO_QN[fo_eqi], FO_QV[fo_eqi], FO_QG[fo_eqi]);
  fo_eqi += 1;
);
fo_spos += 1;

fo_ctc -= 1; fo_ctc <= 0 ? ( fo_ctl(16); fo_ctc = 16; );

// ---------- the eighteen voices into three path buses ----------
fo_b0 = fo_b1 = fo_b2 = 0;
fo_i = 0; fo_p = FO_V;
loop(18,
  fo_p[0] ? (
    fo_e = fo_p[1];
    fo_p[0] == 1 ? ( fo_e += fo_p[22]; fo_e >= 1 ? ( fo_e = 1; fo_p[0] = 2; ); ) :
    fo_p[0] == 2 ? fo_e *= fo_p[20] : fo_e *= fo_p[21];
    fo_p[2] -= 1;
    fo_p[2] <= 0 && fo_p[0] < 3 ? fo_p[0] = 3;
    fo_e < 0.00003 && fo_p[0] >= 2 ? ( fo_e = 0; fo_p[0] = 0; );
    fo_p[1] = fo_e;
    fo_w = fo_p[5];
    fo_inc = fo_p[4] * fo_pm;
    fo_ph = fo_p[3] + fo_inc; fo_ph -= floor(fo_ph); fo_p[3] = fo_ph;
    fo_vap = FO_AP + fo_p[6] * 16;
    fo_w == 0 ? (
      // combo-organ square: TONE narrows the pulse (thin, reedy) - band-limited
      fo_q2 = fo_ph + 1 - fo_vap[13]; fo_q2 -= floor(fo_q2);
      fo_y = 0.5 * ((2 * fo_ph - 1 - vo_blep(fo_ph, fo_inc)) - (2 * fo_q2 - 1 - vo_blep(fo_q2, fo_inc)));
    ) : fo_w == 1 ? (
      // transistor triangle: TONE folds in a buzzy edge
      fo_y = 1 - 4 * abs(fo_ph - 0.5);
      fo_y += fo_vap[14] * (vo_tanh(fo_y * 3.5) - fo_y);
    ) : (
      // drawbars 8' 4' 2 2/3' 2' from one sine / cosine pair (Chebyshev), a whisper of leakage, click, percussion
      fo_s1 = sin(2 * $pi * fo_ph); fo_c1 = cos(2 * $pi * fo_ph);
      fo_s2 = 2 * fo_s1 * fo_c1; fo_c2 = 1 - 2 * fo_s1 * fo_s1;
      fo_s3 = fo_s1 * (3 - 4 * fo_s1 * fo_s1); fo_s4 = 2 * fo_s2 * fo_c2;
      fo_p[14] *= fo_pdc;
      fo_y = (fo_s1 + fo_vap[10] * fo_s2 + (fo_vap[11] + fo_p[14]) * fo_s3 * fo_p[16] + fo_vap[12] * fo_s4 * fo_p[17]) * fo_vap[15];
      fo_p[13] > 0.0005 ? ( fo_n = rand(2) - 1; fo_y += fo_p[13] * (fo_n - fo_p[15]); fo_p[15] = fo_n; fo_p[13] *= fo_ckc; );
    );
    // 12 dB low-pass, its coefficients refreshed every 16 samples (cutoff x key track x a little envelope)
    fo_p[18] -= 1;
    fo_p[18] <= 0 ? (
      fo_p[18] = 16;
      fo_a = fo_p[6] * 16;
      fo_fc = min(max(FO_AP[fo_a + 2] * fo_p[24] * 2 ^ (fo_p[26] * fo_e), 30), fo_nyq);
      fo_g = tan($pi * fo_fc / srate); fo_k = FO_AP[fo_a + 3];
      fo_p[7] = 1 / (1 + fo_g * (fo_g + fo_k)); fo_p[8] = fo_g * fo_p[7]; fo_p[9] = fo_g * fo_p[8];
    );
    fo_v3 = fo_y - fo_p[11]; fo_v1 = fo_p[7] * fo_p[10] + fo_p[8] * fo_v3; fo_v2 = fo_p[11] + fo_p[8] * fo_p[10] + fo_p[9] * fo_v3;
    fo_p[10] = 2 * fo_v1 - fo_p[10]; fo_p[11] = 2 * fo_v2 - fo_p[11];
    fo_y = vo_tanh(fo_v2) * fo_e * fo_p[19];
    fo_p[6] == 0 ? fo_b0 += fo_y : fo_p[6] == 1 ? fo_b1 += fo_y : fo_b2 += fo_y;
  );
  fo_p += 32; fo_i += 1;
);

// ---------- level, pan, send ----------
fo_gl0 += (fo_tl0 - fo_gl0) * fo_sm3; fo_gr0 += (fo_tr0 - fo_gr0) * fo_sm3; fo_gs0 += (fo_ts0 - fo_gs0) * fo_sm3;
fo_gl1 += (fo_tl1 - fo_gl1) * fo_sm3; fo_gr1 += (fo_tr1 - fo_gr1) * fo_sm3; fo_gs1 += (fo_ts1 - fo_gs1) * fo_sm3;
fo_gl2 += (fo_tl2 - fo_gl2) * fo_sm3; fo_gr2 += (fo_tr2 - fo_gr2) * fo_sm3; fo_gs2 += (fo_ts2 - fo_gs2) * fo_sm3;
fo_oL = fo_b0 * fo_gl0 + fo_b1 * fo_gl1 + fo_b2 * fo_gl2;
fo_oR = fo_b0 * fo_gr0 + fo_b1 * fo_gr1 + fo_b2 * fo_gr2;
fo_snL = fo_b0 * fo_gl0 * fo_gs0 + fo_b1 * fo_gl1 * fo_gs1 + fo_b2 * fo_gl2 * fo_gs2;     // the SENDs, panned with their paths
fo_snR = fo_b0 * fo_gr0 * fo_gs0 + fo_b1 * fo_gr1 * fo_gs1 + fo_b2 * fo_gr2 * fo_gs2;
fo_dn = -fo_dn;

// ---------- THE JOURNEY ----------
// Each effect sleeps once its input and its output have both stayed below -140 dB for longer than it can ring (its
// whole line), and wakes on the first sample of input: silence costs almost nothing.
// CF-1 on the dry paths (ON key crossfades in / out)
fo_cfg += fo_fxg * (fo_cfon - fo_cfg);
fo_cfg > 0.0001 ? (
  fo_zi = abs(fo_oL) + abs(fo_oR) > 0.0000001;
  fo_zi || fo_cfz < fo_cfn ? (
    fo_cf(fo_oL, fo_oR);
    fo_zi || abs(fo_yl) + abs(fo_yr) > 0.0000001 ? fo_cfz = 0 : fo_cfz += 1;
    fo_oL += fo_cfg * (fo_yl - fo_oL); fo_oR += fo_cfg * (fo_yr - fo_oR);
  ) : ( fo_cf_idle(); fo_oL *= 1 - fo_cfg; fo_oR *= 1 - fo_cfg; );
);
// MD-6 on the sends: the echoes
fo_mdg += fo_fxg * (fo_mdon - fo_mdg);
fo_el = fo_er = 0;
fo_mdg > 0.0001 ? (
  fo_zi = abs(fo_snL) + abs(fo_snR) > 0.0000001;
  fo_zi || fo_mdz < fo_mdn ? (
    fo_md(fo_snL, fo_snR); fo_el = fo_yl * fo_mdg; fo_er = fo_yr * fo_mdg;
    fo_zi || abs(fo_yl) + abs(fo_yr) > 0.0000001 ? fo_mdz = 0 : fo_mdz += 1;
  ) : fo_md_idle();
);
// the plate on the sends and the echoes
fo_plg += fo_fxg * (fo_plon - fo_plg);
fo_rl = fo_rr = 0;
fo_plg > 0.0001 ? (
  fo_pil = fo_snL + 0.6 * fo_el; fo_pir = fo_snR + 0.6 * fo_er;
  fo_zi = abs(fo_pil) + abs(fo_pir) > 0.0000001;
  fo_zi || fo_plz < fp_psz + 2 * fp_bsz ? (
    fp_run(fo_pil, fo_pir); fo_rl = fp_wl * fo_plmx * fo_plg; fo_rr = fp_wr * fo_plmx * fo_plg;
    fo_zi || abs(fp_wl) + abs(fp_wr) > 0.0000001 ? fo_plz = 0 : fo_plz += 1;
  ) : fp_idle();
);
fo_oL += fo_el + fo_rl;
fo_oR += fo_er + fo_rr;

// ---------- output ----------
fo_vol += (fo_volt - fo_vol) * fo_sm;
fo_oL *= fo_vol; fo_oR *= fo_vol;
fo_dcyl = fo_oL - fo_dcxl + 0.9995 * fo_dcyl; fo_dcxl = fo_oL;
fo_dcyr = fo_oR - fo_dcxr + 0.9995 * fo_dcyr; fo_dcxr = fo_oR;
fo_oL = ostL.ost_band(fo_dcyl); fo_oR = ostR.ost_band(fo_dcyr);
ost_out(fo_oL, fo_oR);
spl0 = ost_l;
spl1 = ost_r;
fo_pkl = max(fo_pkl, abs(spl0)); fo_pkr = max(fo_pkr, abs(spl1));

@gfx 1100 760
ui_thm = 0; ui_hw = 1;
ui_begin(1100, 760);

// ---------- palette: flat card colours ----------
INK = 0x221C26; CARD = 0xF4E8CB; KEYF = 0xFFF8E6; SAND = 0xE9D49F; OCHRE = 0xD48A1E; TURQ = 0x1E9F9C;
MAG = 0xC42F68; LAPIS = 0x2B4B93; SUN = 0xF2B52E; SKY1 = 0x2AAFB4; SKY2 = 0x67C9C6; SKY3 = 0xB4E3D8;
P1BG = 0xCDEAE3; P2BG = 0xF4D5DF; P3BG = 0xF2DFB4; FXBG = 0xD7DEEF; FATEBG = 0xE6D9F0;
CAPW = 0xEEEFEA;

gfx_setfont(10, "Trebuchet MS", 12 * sc, 'b');        // knob labels, captions
gfx_setfont(11, "Trebuchet MS", 11.5 * sc, 'b');        // key captions
gfx_setfont(12, "Trebuchet MS", 15 * sc, 'b');          // section titles
gfx_setfont(13, "Georgia", 30 * sc, 'b');               // the card title
gfx_setfont(14, "Georgia", 28 * sc, 'b');               // the numeral
gfx_setfont(15, "Georgia", 20 * sc, 'b');               // path numerals
gfx_setfont(16, "Trebuchet MS", 22 * sc, 'b');          // STEP OFF

// ---------- drawing helpers (GUI thread only) ----------
function fg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function fg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function fg_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function fg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.5 + 0.5); gfx_drawstr(s); );
function fg_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a thick anti-aliased line (unscaled coordinates, width in base pixels)
function fg_th(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, k) (
  dx = x2 - x1; dy = y2 - y1; l = sqrt(dx * dx + dy * dy); l < 0.001 ? l = 1;
  nx = -dy / l; ny = dx / l; k = -w * 0.5;
  loop(max(1, floor(w * sc * 2) + 1),
    gfx_line((x1 + nx * k) * sc, (y1 + ny * k) * sc, (x2 + nx * k) * sc, (y2 + ny * k) * sc, 1);
    k += 0.5 / sc;
  );
);
function fg_disc(cx, cy, r) ( gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
function fg_ring(cx, cy, r, w) local(k) ( k = -w * 0.5; loop(max(1, floor(w * sc * 2) + 1), gfx_circle(cx * sc, cy * sc, r * sc + k * sc, 0, 1); k += 0.5 / sc; ); );
function fg_tri(x1, y1, x2, y2, x3, y3) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc); );
function fg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
// a flat colour field with an ink outline and a soft drop shadow
function fg_field(x, y, w, h, col) (
  ui_cola(0x000000, 0.13); fg_rr(x + 2, y + 3, w, h, 8);
  ui_col(INK); fg_rr(x, y, w, h, 8);
  ui_col(col); fg_rr(x + 2, y + 2, w - 4, h - 4, 6);
);
// a printed section heading on a coloured band
function fg_band(x, y, w, h, col, s) (
  ui_col(col); fg_rr(x + 2, y + 2, w - 4, h - 2, 6); fg_r(x + 2, y + h - 6, w - 4, 6);
  ui_col(INK); fg_r(x + 2, y + h, w - 4, 2);
  gfx_setfont(12); ui_col(ui_ink(col)); fg_ctxt(x + w * 0.5, y + h * 0.5 + 1, s);
);
// a lit key: cream face when off, the colour (glowing) when on; returns 1 when clicked
function fg_key(x, y, w, h, s, on, col) local(hov, hit) (
  hov = fg_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  on ? ( ui_cola(col, 0.28); fg_rr(x - 3, y - 3, w + 6, h + 6, 6); );
  ui_cola(0x000000, 0.2); fg_rr(x + 1, y + 2, w, h, 4);
  ui_col(INK); fg_rr(x, y, w, h, 4);
  on ? (
    ui_col(col); fg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 3);
    ui_cola(0xFFFFFF, 0.35); fg_r(x + 4, y + 2.5, w - 8, 1.2);
  ) : (
    ui_col(hov ? 0xFFFFFF : KEYF); fg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 3);
    ui_cola(0x000000, 0.08); fg_r(x + 3, y + h - 4, w - 6, 2);
  );
  mdown && hov && drag_id == -1 ? ( ui_cola(0x000000, 0.12); fg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 3); );
  gfx_setfont(11); ui_col(on ? ui_ink(col) : INK); fg_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, s);
  hit;
);
// the value pill shown while a knob is hovered or turned
function fg_pill(cx, cy, s) local(tw, th) (
  gfx_setfont(10); gfx_measurestr(s, tw, th);
  ui_col(INK); ui_rrect(cx * sc - tw * 0.5 - 6 * sc, cy * sc - th * 0.5 - 2 * sc, tw + 12 * sc, th + 4 * sc, 4 * sc);
  ui_col(0xFFF6DC); fg_ctxt(cx, cy, s);
);
// HOUSE WHITE CAP: a thin smooth track, an anti-aliased value arc in the accent colour, a flat satin cap with one
// soft highlight on its upper-left edge, a thin dark rim and a dark pointer line (pixel coordinates)
function fg_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);
function fg_cap(cx, cy, r, n, col) local(rr, a, a0, ca, sa, w, i) (
  rr = r + 6 * sc; w = 3 * sc; a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_col(fg_trk); fg_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.3 * sc);
  fg_bip ? (
    // bipolar: the arc grows from the top centre
    abs(n - 0.5) > 0.004 ? (
      ui_col(col); fg_arcw(cx, cy, rr, min(a, 0), max(a, 0), w);
      gfx_circle(cx, cy - rr, w * 0.5, 1, 1); gfx_circle(cx + ca * rr, cy + sa * rr, w * 0.5, 1, 1);
    );
  ) : n > 0.004 ? (
    ui_col(col); fg_arcw(cx, cy, rr, a0, a, w);
    gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, w * 0.5, 1, 1); gfx_circle(cx + ca * rr, cy + sa * rr, w * 0.5, 1, 1);
  );
  ui_cola(0x000000, 0.25); gfx_circle(cx + 1 * sc, cy + 2 * sc, r, 1, 1);
  ui_col(0x50565E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0xC9CDD2); gfx_circle(cx, cy, r - 1.5 * sc, 1, 1);
  ui_col(0xEDEFF1); fg_arcw(cx, cy, r - 3 * sc, -0.66 * $pi, 0.06 * $pi, 1.4 * sc);
  ui_col(0x1A1E24); i = -1;
  ui_ssline(cx + ca * r * 0.3, cy + sa * r * 0.3, cx + ca * (r - 3 * sc), cy + sa * (r - 3 * sc), 2.4 * sc, 1);
);
// a knob: drag (SHIFT = fine), double-click = default, wheel. st > 0 rounds to steps of st; lg = log scale.
// The label sits under it; while hovered the label gives way to the value.
function fg_knob(cx, cy, r, idx, lo, hi, def, lg, st, col, label, val) local(v, n, dx, dy, hov, did) (
  did = 3000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 7) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - fg_lt < 0.35 && fg_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; fg_lt = 0; ) : (
      drag_id = did; fg_my = mouse_y; fg_lt = time_precise(); fg_lid = idx;
      fg_n = lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    fg_n = min(max(fg_n + (fg_my - mouse_y) / (((mouse_cap & 8) ? 1200 : 200) * sc), 0), 1); fg_my = mouse_y;
    v = lg ? lo * (hi / lo) ^ fg_n : lo + fg_n * (hi - lo);
    st > 0 ? v = floor(v / st + 0.5) * st;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    st > 0 && (hi - lo) / st <= 40 ? v += (mouse_wheel > 0 ? st : -st) : (
      n = lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo);
      n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
      v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
      st > 0 ? v = floor(v / st + 0.5) * st;
    );
    slider(idx) = min(max(v, lo), hi); ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  n = min(max(n, 0), 1);
  fg_cap(cx * sc, cy * sc, r * sc, n, col);
  (hov || drag_id == did) ? ( ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, (r - 1.5) * sc, 1, 1); );
  (hov || drag_id == did) ? fg_pill(cx, cy + r + 14, val) : ( gfx_setfont(10); ui_col(INK); fg_ctxt(cx, cy + r + 14, label); );
  fg_bip = 0;
);
function fg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
// a drop-down list for a stepped slider: the items lo..hi from a "|" list, the current one ticked; grp > 0 groups every
// grp items in a submenu named after its first and last
function fg_mlist(list, n, cur, grp) local(i, s0, op) (
  strcpy(#fg_mls, ""); i = 0;
  loop(n,
    s0 = grp > 0 ? i - i % grp : 0; op = grp > 0 && n - s0 > 1;
    op && i == s0 ? ( strcat(#fg_mls, ">"); strcat(#fg_mls, pk_pitem(list, i + 1, #fg_mi)); strcat(#fg_mls, " - ");
                      strcat(#fg_mls, pk_pitem(list, min(s0 + grp, n), #fg_mi)); strcat(#fg_mls, "|"); );
    op && i == min(s0 + grp, n) - 1 ? strcat(#fg_mls, "<");
    i == cur ? strcat(#fg_mls, "!");
    strcat(#fg_mls, pk_pitem(list, i + 1, #fg_mi));
    i < n - 1 ? strcat(#fg_mls, "|");
    i += 1; );
  #fg_mls;
);
// a value box: the value in words and a small down-arrow; a click opens the list of every value, the wheel steps it
function fg_mbox(x, y, w, h, idx, lo, hi, s, list, grp) local(hov, i) (
  hov = fg_hov(x, y, w, h);
  ui_col(INK); fg_rr(x, y, w, h, 4); ui_col(hov ? 0xFFFFFF : KEYF); fg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 3);
  gfx_setfont(11); ui_col(INK); fg_ctxt(x + (w - 10) * 0.5, y + h * 0.5, s);
  fg_tri(x + w - 13, y + h * 0.5 - 2, x + w - 6, y + h * 0.5 - 2, x + w - 9.5, y + h * 0.5 + 2.5);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(fg_mlist(list, hi - lo + 1, floor(slider(idx) + 0.5) - lo, grp));
    i > 0 ? fg_set(idx, lo + i - 1);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( fg_set(idx, min(max(floor(slider(idx) + 0.5) + sign(mouse_wheel), lo), hi)); mouse_wheel = 0; );
);
function fg_pc(n) ( n = n % 12;
  n == 0 ? "C" : n == 1 ? "C#" : n == 2 ? "D" : n == 3 ? "D#" : n == 4 ? "E" : n == 5 ? "F" :
  n == 6 ? "F#" : n == 7 ? "G" : n == 8 ? "G#" : n == 9 ? "A" : n == 10 ? "A#" : "B"; );

// ---------- the emblem: a wanderer's bundle on a stick at a cliff edge, under the sun ----------
function fg_emblem(x, y, w, h) local(wx, wy, ww, wh, i, a, sx, sy, cx, cy) (
  ui_col(INK); fg_rr(x, y, w, h, 10);
  ui_col(KEYF); fg_rr(x + 2, y + 2, w - 4, h - 4, 8);
  wx = x + 9; wy = y + 9; ww = w - 18; wh = h - 18;
  ui_col(INK); fg_r(wx - 2, wy - 2, ww + 4, wh + 4);
  // sky in flat bands
  ui_col(SKY1); fg_r(wx, wy, ww, wh * 0.24);
  ui_col(SKY2); fg_r(wx, wy + wh * 0.24, ww, wh * 0.2);
  ui_col(SKY3); fg_r(wx, wy + wh * 0.44, ww, wh * 0.2);
  ui_col(0xF3EBC9); fg_r(wx, wy + wh * 0.64, ww, wh * 0.36);
  // the sun with its rays
  cx = wx + ww * 0.74; cy = wy + wh * 0.25;
  ui_col(INK);
  i = 0; loop(12, a = i * $pi / 6 + 0.13; fg_th(cx + cos(a) * 21, cy + sin(a) * 21, cx + cos(a) * (i % 2 ? 28 : 33), cy + sin(a) * (i % 2 ? 28 : 33), 2.2); i += 1; );
  fg_disc(cx, cy, 17.5); ui_col(SUN); fg_disc(cx, cy, 15.5);
  ui_col(0xF8D36A); fg_disc(cx - 4, cy - 4, 6);
  // a long cloud
  ui_col(INK); fg_rr(wx + 8, wy + wh * 0.09 - 1, 58, 14, 7); ui_col(KEYF); fg_rr(wx + 9.5, wy + wh * 0.09 + 0.5, 55, 11, 5.5);
  ui_col(INK); fg_rr(wx + 22, wy + wh * 0.28 - 1, 40, 12, 6); ui_col(KEYF); fg_rr(wx + 23.5, wy + wh * 0.28 + 0.5, 37, 9, 4.5);
  // far mountains across the valley
  ui_col(0x8E9BC9); fg_tri(wx + ww * 0.42, wy + wh * 0.66, wx + ww * 0.62, wy + wh * 0.50, wx + ww * 0.82, wy + wh * 0.66);
  ui_col(0x7181BA); fg_tri(wx + ww * 0.66, wy + wh * 0.66, wx + ww * 0.84, wy + wh * 0.46, wx + ww, wy + wh * 0.62);
  ui_col(0x7181BA); fg_r(wx + ww * 0.9, wy + wh * 0.62, ww * 0.1, wh * 0.04);
  ui_col(INK); fg_th(wx + ww * 0.42, wy + wh * 0.66, wx + ww * 0.62, wy + wh * 0.50, 1.6); fg_th(wx + ww * 0.62, wy + wh * 0.50, wx + ww * 0.71, wy + wh * 0.58, 1.6);
  fg_th(wx + ww * 0.71, wy + wh * 0.58, wx + ww * 0.84, wy + wh * 0.46, 1.6); fg_th(wx + ww * 0.84, wy + wh * 0.46, wx + ww, wy + wh * 0.62, 1.6);
  // the abyss: lapis water far below, with cream wave marks
  ui_col(LAPIS); fg_r(wx + ww * 0.42, wy + wh * 0.66, ww * 0.58, wh * 0.34);
  ui_col(0xAFC0EA);
  i = 0; loop(4, sx = wx + ww * 0.6 + (i % 2) * 22; sy = wy + wh * 0.76 + i * 9;
    fg_th(sx, sy, sx + 8, sy - 3, 1.6); fg_th(sx + 8, sy - 3, sx + 16, sy, 1.6); i += 1; );
  ui_col(INK); fg_th(wx + ww * 0.42, wy + wh * 0.66, wx + ww, wy + wh * 0.66, 1.6);
  // the cliff: ochre rock rising to the edge, a sheer face dropping into the abyss
  ui_col(OCHRE);
  fg_quad(wx, wy + wh * 0.62, wx + ww * 0.30, wy + wh * 0.58, wx + ww * 0.52, wy + wh * 0.60, wx, wy + wh);
  fg_quad(wx + ww * 0.52, wy + wh * 0.60, wx + ww * 0.56, wy + wh, wx, wy + wh, wx, wy + wh);
  ui_col(0xB66E12); fg_quad(wx + ww * 0.47, wy + wh * 0.62, wx + ww * 0.52, wy + wh * 0.60, wx + ww * 0.56, wy + wh, wx + ww * 0.45, wy + wh);
  ui_col(INK);
  fg_th(wx, wy + wh * 0.62, wx + ww * 0.30, wy + wh * 0.58, 2.4);
  fg_th(wx + ww * 0.30, wy + wh * 0.58, wx + ww * 0.52, wy + wh * 0.60, 2.4);
  fg_th(wx + ww * 0.52, wy + wh * 0.60, wx + ww * 0.56, wy + wh, 2.4);
  // strata
  ui_cola(INK, 0.55);
  fg_th(wx + 6, wy + wh * 0.75, wx + ww * 0.36, wy + wh * 0.73, 1.4);
  fg_th(wx + 18, wy + wh * 0.86, wx + ww * 0.44, wy + wh * 0.84, 1.4);
  fg_th(wx + ww * 0.12, wy + wh * 0.95, wx + ww * 0.32, wy + wh * 0.94, 1.4);
  // footprints walking to the edge
  ui_col(INK);
  i = 0; loop(4, sx = wx + 10 + i * 14; sy = wy + wh * 0.635 - i * 1.2 + (i % 2) * 3; fg_rr(sx, sy, 5, 3, 1.5); i += 1; );
  // a white rose at the edge
  cx = wx + ww * 0.13; cy = wy + wh * 0.555;
  ui_col(INK); fg_th(cx, cy + 4, cx + 1, cy + 11, 1.4);
  fg_disc(cx, cy, 5.2); ui_col(0xFFFFFF); fg_disc(cx, cy, 3.8); ui_col(MAG); fg_disc(cx, cy, 1.4);
  // the stick, leaning out over the edge, the bundle hanging from its end
  sx = wx + ww * 0.24; sy = wy + wh * 0.585; cx = wx + ww * 0.66; cy = wy + wh * 0.30;
  ui_col(INK); fg_th(sx, sy, cx, cy, 4.2); ui_col(0x9A5A1E); fg_th(sx, sy, cx, cy, 2);
  ui_col(INK); fg_th(cx - 2, cy + 1, cx - 2, cy + 9, 1.6);
  ui_col(INK); fg_disc(cx - 1, cy + 22, 15.5);
  fg_tri(cx - 9, cy + 13, cx - 2, cy + 6, cx + 6, cy + 13);
  ui_col(MAG); fg_disc(cx - 1, cy + 22, 13.5);
  fg_tri(cx - 6.5, cy + 12.5, cx - 2, cy + 8.5, cx + 3.5, cy + 12.5);
  ui_col(0xF7C7D8); fg_disc(cx - 6, cy + 18, 2); fg_disc(cx + 4, cy + 24, 2); fg_disc(cx - 3, cy + 29, 2); fg_disc(cx + 5, cy + 15, 1.6);
  ui_col(INK); fg_th(cx - 8, cy + 11.5, cx + 5, cy + 11.5, 2.2);
);

// an LFO shape drawn on its key (centre cx, cy; base pixels)
function fg_glyph(cx, cy, sh, col) local(i, x0, y0, x1, y1, t, n) (
  ui_col(col); n = 16; i = 0;
  loop(n + 1,
    t = i / n;
    y1 = sh == 0 ? -sin(2 * $pi * t) : sh == 1 ? -(1 - 4 * abs(t - 0.5)) : sh == 2 ? -(2 * t - 1) : sh == 3 ? (t < 0.5 ? -1 : 1) :
         sh == 4 ? (t < 0.25 ? 0.2 : t < 0.5 ? -0.9 : t < 0.75 ? 0.6 : -0.3) : -(0.55 * sin(2 * $pi * t * 1.3 + 0.6) + 0.35 * sin(2 * $pi * t * 2.7));
    x1 = cx - 8 + 16 * t; y1 = cy + y1 * 5;
    i > 0 ? (
      (sh == 3 || sh == 4) && abs(y1 - y0) > 1 ? ( fg_th(x0, y0, x1, y0, 1.6); fg_th(x1, y0, x1, y1, 1.6); ) : fg_th(x0, y0, x1, y1, 1.6);
    );
    x0 = x1; y0 = y1; i += 1;
  );
);

// ---------- one path (I, II, III): pattern and voice ----------
function fg_path(a, x, y, w, h, bg, ac) local(b, s, i, sx, sy, len, pos, lit, md, cx, kx, gx, on, nm, lb, lv) (
  b = 1 + 16 * a; s = FO_AS + 16 * a;
  fg_field(x, y, w, h, bg);
  fg_trk = ui_mix(bg, 0x000000, 0.28);
  on = slider(b) >= 0.5;
  // heading: the path's numeral, its ON key, rate / length
  ui_col(ac); fg_rr(x + 2, y + 2, w - 4, 32, 6); fg_r(x + 2, y + 26, w - 4, 8);
  ui_col(INK); fg_r(x + 2, y + 34, w - 4, 2);
  fg_key(x + 10, y + 7, 44, 22, "ON", on, 0xFFF3B0) ? fg_set(b, on ? 0 : 1);
  gfx_setfont(15); ui_col(ui_ink(ac)); fg_ctxt(x + 80, y + 18, a == 0 ? "I" : a == 1 ? "II" : "III");
  gfx_setfont(12); sprintf(#fgh, "%s  %d STEPS", fo_rname(slider(b + 2)), slider(b + 3));
  gfx_measurestr(#fgh, fg_tw, fg_tht); gfx_x = (x + w - 10) * sc - fg_tw; gfx_y = (y + 18) * sc - fg_tht * 0.5; gfx_drawstr(#fgh);
  // the path: a winding line of stones, one per step of the pattern, the current one lit
  len = slider(b + 3); pos = s[6];
  lit = fo_sn > 0 && on && pos >= 0;
  ui_cola(INK, 0.45);
  i = 0; loop(15, sx = x + 16 + i * (w - 32) / 15; sy = y + 54 + 5 * sin(i * 0.9 + a * 1.7);
    gx = x + 16 + (i + 1) * (w - 32) / 15; fg_th(sx, sy, gx, y + 54 + 5 * sin((i + 1) * 0.9 + a * 1.7), 1.2); i += 1; );
  i = 0; loop(16,
    sx = x + 16 + i * (w - 32) / 15; sy = y + 54 + 5 * sin(i * 0.9 + a * 1.7);
    i < len ? (
      lit && i == pos ? ( ui_cola(ac, 0.35); fg_disc(sx, sy, 10); ui_col(INK); fg_disc(sx, sy, 7.5); ui_col(ac); fg_disc(sx, sy, 6); ) :
      ( ui_col(INK); fg_disc(sx, sy, 5.5); ui_col(i == 0 ? ui_mix(ac, 0xFFFFFF, 0.55) : KEYF); fg_disc(sx, sy, 4); );
    ) : ( ui_cola(INK, 0.35); fg_disc(sx, sy, 2); );
    i += 1;
  );
  // MODE keys
  md = slider(b + 1); kx = (w - 20) / 6;
  i = 0; loop(6,
    fg_key(x + 10 + i * kx + 1, y + 74, kx - 2, 22, i == 0 ? "UP" : i == 1 ? "DN" : i == 2 ? "U/D" : i == 3 ? "RND" : i == 4 ? "ORD" : "CHD", md == i, ac) ? fg_set(b + 1, i);
    i += 1; );
  // pattern knobs
  cx = x + w * 0.5;
  sprintf(#fgv, "%s", fo_rname(slider(b + 2)));          fg_knob(cx - 84, y + 134, 15, b + 2, 0, 10, FO_DEF[b + 1], 0, 1, ac, "RATE", #fgv);
  sprintf(#fgv, "%d steps", slider(b + 3));             fg_knob(cx - 28, y + 134, 15, b + 3, 2, 16, FO_DEF[b + 2], 0, 1, ac, "LENGTH", #fgv);
  sprintf(#fgv, "%d oct", slider(b + 4));               fg_knob(cx + 28, y + 134, 15, b + 4, 1, 4, FO_DEF[b + 3], 0, 1, ac, "RANGE", #fgv);
  sprintf(#fgv, "%+d oct", slider(b + 5));              fg_knob(cx + 84, y + 134, 15, b + 5, -2, 2, FO_DEF[b + 4], 0, 1, ac, "OFFSET", #fgv);
  sprintf(#fgv, "%d%%", slider(b + 6));                 fg_knob(cx - 60, y + 196, 15, b + 6, 10, 100, FO_DEF[b + 5], 0, 1, ac, "GATE", #fgv);
  sprintf(#fgv, "%d%%", slider(b + 7));                 fg_knob(cx, y + 196, 15, b + 7, 0, 75, FO_DEF[b + 6], 0, 1, ac, "SWING", #fgv);
  sprintf(#fgv, "%d%%", slider(b + 8));                 fg_knob(cx + 60, y + 196, 15, b + 8, 0, 100, FO_DEF[b + 7], 0, 1, ac, "PROB", #fgv);
  // the voice: SQUARE / TRI / ORGAN, filter, decay, tone, level, pan, send
  ui_cola(INK, 0.3); fg_r(x + 12, y + 240, w - 24, 1.5);
  kx = (w - 20) / 3;
  i = 0; loop(3,
    fg_key(x + 10 + i * kx + 1, y + 252, kx - 2, 24, i == 0 ? "SQUARE" : i == 1 ? "TRI" : "ORGAN", slider(b + 9) == i, ac) ? fg_set(b + 9, i);
    i += 1; );
  sprintf(#fgv, slider(b + 10) >= 1000 ? "%.1f kHz" : "%.0f Hz", slider(b + 10) >= 1000 ? slider(b + 10) / 1000 : slider(b + 10));
  fg_knob(cx - 84, y + 316, 15, b + 10, 80, 16000, FO_DEF[b + 9], 1, 1, ac, "CUTOFF", #fgv);
  sprintf(#fgv, "%d%%", slider(b + 11));                fg_knob(cx - 28, y + 316, 15, b + 11, 0, 100, FO_DEF[b + 10], 0, 1, ac, "RESO", #fgv);
  slider(b + 12) >= 4900 ? strcpy(#fgv, "HOLD") :
  sprintf(#fgv, slider(b + 12) >= 1000 ? "%.2f s" : "%.0f ms", slider(b + 12) >= 1000 ? slider(b + 12) / 1000 : slider(b + 12));
  fg_knob(cx + 28, y + 316, 15, b + 12, 20, 5000, FO_DEF[b + 11], 1, 1, ac, "DECAY", #fgv);
  sprintf(#fgv, "%d%%", slider(103 + a));
  fg_knob(cx + 84, y + 316, 15, 103 + a, 0, 100, FO_DEF[102 + a], 0, 1, ac, slider(b + 9) == 0 ? "WIDTH" : slider(b + 9) == 1 ? "EDGE" : "BARS", #fgv);
  sprintf(#fgv, "%d%%", slider(b + 13));                fg_knob(cx - 60, y + 378, 15, b + 13, 0, 100, FO_DEF[b + 12], 0, 1, ac, "LEVEL", #fgv);
  slider(b + 14) == 0 ? strcpy(#fgv, "C") : sprintf(#fgv, slider(b + 14) < 0 ? "L%d" : "R%d", abs(slider(b + 14)));
  fg_bip = 1; fg_knob(cx, y + 378, 15, b + 14, -100, 100, FO_DEF[b + 13], 0, 1, ac, "PAN", #fgv);
  sprintf(#fgv, "%d%%", slider(b + 15));                fg_knob(cx + 60, y + 378, 15, b + 15, 0, 100, FO_DEF[b + 14], 0, 1, ac, "SEND", #fgv);
  // the LFO: shape, destination, rate (synced or free), depth, SYNC and RETRIG
  lb = 69 + 7 * a;
  ui_col(ui_mix(bg, 0x000000, 0.06)); fg_rr(x + 8, y + 424, w - 16, h - 432, 6);
  ui_cola(INK, 0.3); fg_r(x + 12, y + 422, w - 24, 1.5);
  gfx_setfont(12); ui_col(INK); fg_txt(x + 14, y + 439, "LFO");
  lv = FO_LS[a * 16 + 7] * (slider(lb + 3) != 0);
  ui_col(INK); fg_disc(x + 54, y + 447, 5); ui_col(ui_mix(KEYF, ac, 0.5 + 0.5 * lv)); fg_disc(x + 54, y + 447, 3.6);
  kx = (w - 76) / 6;
  i = 0; loop(6,
    gx = x + 64 + i * kx + 1;
    fg_key(gx, y + 435, kx - 2, 24, "", slider(lb + 4) == i, ac) ? fg_set(lb + 4, i);
    fg_glyph(gx + (kx - 2) * 0.5, y + 447, i, slider(lb + 4) == i ? ui_ink(ac) : INK);
    i += 1; );
  kx = (w - 24) / 6;
  i = 0; loop(6,
    fg_key(x + 12 + i * kx + 1, y + 471, kx - 2, 24, i == 0 ? "CUT" : i == 1 ? "RES" : i == 2 ? "DEC" : i == 3 ? "LVL" : i == 4 ? "PAN" : "SND", slider(lb + 5) == i, ac) ? fg_set(lb + 5, i);
    i += 1; );
  slider(lb + 2) >= 0.5 ? (
    sprintf(#fgv, "%s", fo_lname(slider(lb + 1)));   fg_knob(x + 42, y + 538, 15, lb + 1, 0, 9, FO_DEF[lb], 0, 1, ac, "RATE", #fgv);
  ) : (
    sprintf(#fgv, slider(lb) < 1 ? "%.2f Hz" : "%.1f Hz", slider(lb)); fg_knob(x + 42, y + 538, 15, lb, 0.02, 20, FO_DEF[lb - 1], 1, 0.01, ac, "RATE", #fgv);
  );
  sprintf(#fgv, "%+d%%", slider(lb + 3));              fg_bip = 1; fg_knob(x + 102, y + 538, 15, lb + 3, -100, 100, 0, 0, 1, ac, "DEPTH", #fgv);
  fg_key(x + 136, y + 512, w - 148, 26, "SYNC", slider(lb + 2) >= 0.5, ac) ? fg_set(lb + 2, slider(lb + 2) >= 0.5 ? 0 : 1);
  fg_key(x + 136, y + 546, w - 148, 26, "RETRIG", slider(lb + 6) >= 0.5, ac) ? fg_set(lb + 6, slider(lb + 6) >= 0.5 ? 0 : 1);
);

// =====================================================================
// the card
// =====================================================================
ui_col(0x16121A); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(CARD); fg_rr(3, 3, 1094, 754, 14);
ui_col(INK); fg_rr(9, 9, 1082, 742, 10);
ui_col(CARD); fg_rr(11.5, 11.5, 1077, 737, 8);
ui_cola(INK, 0.5); fg_rr(15, 15, 1070, 730, 7); ui_col(CARD); fg_rr(16, 16, 1068, 728, 6);

// ---------- header: badge, presets, the numeral, the held chord, MIDI, size ----------
ui_col(INK); fg_disc(42, 39, 17); ui_col(CARD); fg_disc(42, 39, 15);
gfx_setfont(4); ui_col(INK); fg_ctxt(42, 39, "GFX");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
fg_k = pk_preset(70 * sc, 23 * sc, 400 * sc, 32 * sc, pr_cur, #fo_pm);
fg_k > 0 ? ( fg_k > 14 ? reset_all() : prs_dirty = fg_k; );
// the numeral in its cartouche
ui_col(INK); fg_rr(512, 19, 76, 40, 20); ui_col(SUN); fg_rr(514.5, 21.5, 71, 35, 17.5);
ui_col(INK); fg_th(492, 39, 508, 39, 2); fg_th(592, 39, 608, 39, 2); fg_disc(488, 39, 2.5); fg_disc(612, 39, 2.5);
gfx_setfont(14); ui_col(INK); fg_ctxt(550, 40, "0");
// the held chord
pk_lcd(632 * sc, 23 * sc, 300 * sc, 32 * sc, 0);
pk_lcdfont(9, 13 * sc); ui_col(pk_lcdc);
fo_sn == 0 ? strcpy(#fgl, slider49 >= 0.5 ? "HOLD - PLAY A CHORD" : "PLAY A CHORD") : (
  strcpy(#fgl, slider49 >= 0.5 ? "HOLD " : "");
  fg_i = 0; loop(min(fo_sn, 6), sprintf(#fgn, "%s%d ", fg_pc(FO_SET[fg_i]), floor(FO_SET[fg_i] / 12) - 1); strcat(#fgl, #fgn); fg_i += 1; );
  fo_sn > 6 ? strcat(#fgl, "+");
);
pk_fitstr(#fgl, 642 * sc, 31 * sc, 13 * sc, 280 * sc);
pk_led(952 * sc, 33 * sc, 3.5 * sc, ins_midi_lit(), 0x3ADF6A);
gfx_setfont(4); ui_col(INK); fg_ctxt(952, 47, "MIDI");
ui_size_picker(1016 * sc, 30 * sc);

// ---------- the emblem column: the card picture, STEP OFF, RETURN, SEED, HOLD, KEY SYNC ----------
fg_emblem(24, 66, 184, 340);
fg_flash = time_precise() - fg_sot < 0.25;
ui_cola(MAG, fg_flash ? 0.5 : 0.25); fg_rr(20, 414, 192, 60, 10);
ui_cola(0x000000, 0.22); fg_rr(25, 420, 184, 52, 7);
ui_col(INK); fg_rr(24, 418, 184, 52, 7);
fg_hv = fg_hov(24, 418, 184, 52);
ui_col(fg_flash ? 0xFF5C93 : fg_hv ? 0xD93A77 : MAG); fg_rr(26.5, 420.5, 179, 47, 5);
ui_cola(0xFFFFFF, 0.35); fg_r(32, 422.5, 168, 1.5);
gfx_setfont(16); ui_col(0xFFF6DC); fg_ctxt(116, 444, "STEP OFF");
fg_hv && pressed && drag_id == 0 ? ( drag_id = -1; fo_stepoff(-1); fg_sot = time_precise(); );

fg_key(24, 482, 76, 34, "RETURN", 0, SUN) ? fo_return();
!fo_hasprev ? ( ui_cola(CARD, 0.55); fg_rr(24, 482, 76, 34, 4); );
pk_lcd(106 * sc, 482 * sc, 102 * sc, 34 * sc, 0);
pk_lcdfont(9, 9.5 * sc); ui_col(pk_lcdc); fg_txt(114, 485, "SEED");
pk_lcdfont(9, 17 * sc); sprintf(#fgl, "%04d", slider54); fg_txt(114, 496, #fgl);
ui_cola(pk_lcdc, 0.8); fg_tri(190, 496, 198, 496, 194, 501);
// the SEED: the wheel deals seed by seed; a click lists a random seed, the seeds either side and jumps by the hundred
fg_hov(106, 482, 102, 34) ? (
  mouse_wheel != 0 ? ( fo_stepoff(min(max(slider54 + (mouse_wheel > 0 ? 1 : -1), 0), 9999)); mouse_wheel = 0; fg_sot = time_precise(); );
  pressed && drag_id == 0 ? (
    drag_id = -1; fg_s0 = max(slider54 - 5, 0); fg_s1 = min(slider54 + 5, 9999);
    strcpy(#fgm, "Step off (a random seed)"); fg_i = fg_s0;
    loop(fg_s1 - fg_s0 + 1, strcat(#fgm, fg_i == slider54 ? "|!" : "|"); sprintf(#fgn, "Seed %04d", fg_i); strcat(#fgm, #fgn); fg_i += 1; );
    fg_i = 0;
    loop(100,
      fg_i % 10 == 0 ? ( sprintf(#fgn, "|>Seeds %04d - %04d", fg_i * 100, fg_i * 100 + 999); strcat(#fgm, #fgn); );
      sprintf(#fgn, fg_i % 10 == 9 ? "|<%04d" : "|%04d", fg_i * 100); strcat(#fgm, #fgn); fg_i += 1; );
    gfx_x = 106 * sc; gfx_y = 516 * sc; fg_i = gfx_showmenu(#fgm);
    fg_i == 1 ? fo_stepoff(-1) : fg_i > 1 && fg_i <= 2 + fg_s1 - fg_s0 ? fo_stepoff(fg_s0 + fg_i - 2) : fg_i > 0 ? fo_stepoff((fg_i - 3 - fg_s1 + fg_s0) * 100);
    fg_i > 0 ? fg_sot = time_precise();
  );
);
fg_key(24, 530, 89, 34, "HOLD", slider49 >= 0.5, SUN) ? fg_set(49, slider49 >= 0.5 ? 0 : 1);
fg_key(119, 530, 89, 34, slider50 >= 0.5 ? "KEY SYNC" : "FREE", slider50 >= 0.5, SKY2) ? fg_set(50, slider50 >= 0.5 ? 0 : 1);
// the full circle: after how many beats the three paths line up again (the LCM of their pattern lengths in time)
fg_cyc = 1; fg_i = 0;
loop(3,
  fg_b = 1 + 16 * fg_i;
  slider(fg_b) >= 0.5 ? (
    fg_u = floor(fo_rb(slider(fg_b + 2)) * 24 + 0.5) * slider(fg_b + 3);
    slider(fg_b + 7) > 0 && slider(fg_b + 3) % 2 ? fg_u *= 2;          // swing pairs: an odd length needs two rounds
    fg_ga = fg_cyc; fg_gb = fg_u; while (fg_gb > 0) ( fg_gt = fg_ga % fg_gb; fg_ga = fg_gb; fg_gb = fg_gt; );
    fg_cyc = fg_cyc / fg_ga * fg_u;
  );
  fg_i += 1;
);
fg_cyc /= 24;
sprintf(#fgl, fg_cyc == floor(fg_cyc) ? "FULL CIRCLE %.0f BEATS" : "FULL CIRCLE %.1f BEATS", fg_cyc);
gfx_setfont(10); ui_cola(INK, 0.85); fg_ctxt(116, 600, #fgl);

// ---------- the three paths ----------
fg_path(0, 218, 66, 222, 594, P1BG, TURQ);
fg_path(1, 446, 66, 222, 594, P2BG, MAG);
fg_path(2, 674, 66, 222, 594, P3BG, OCHRE);

// ---------- THE JOURNEY: CF-1 chorus / flanger, MD-6 echo, the vocal plate ----------
function fg_unit(y, on, idx, s) (
  fg_key(914, y, 40, 24, "ON", on, LAPIS) ? fg_set(idx, on ? 0 : 1);
  gfx_setfont(12); ui_col(INK); fg_txt(962, y + 4, s);
);
fg_field(904, 66, 176, 482, FXBG);
fg_band(904, 66, 176, 30, LAPIS, "THE JOURNEY");
fg_trk = ui_mix(FXBG, 0x000000, 0.28);
// CF-1
fg_unit(106, slider90 >= 0.5, 90, "CF-1 CHORUS");
sprintf(#fgv, slider91 < 1 ? "CHORUS" : slider91 > 99 ? "FLANGER" : "%d%%", slider91); fg_knob(936, 164, 14, 91, 0, 100, 0, 0, 0, LAPIS, "MORPH", #fgv);
sprintf(#fgv, slider92 < 50 ? "%.2f Hz" : "%.1f Hz", 0.1 * 100 ^ (slider92 / 100)); fg_knob(992, 164, 14, 92, 0, 100, 25, 0, 0, LAPIS, "RATE", #fgv);
sprintf(#fgv, "%d%%", slider93);              fg_knob(1048, 164, 14, 93, 0, 100, 45, 0, 0, LAPIS, "DEPTH", #fgv);
fg_cm = slider91 / 100; sprintf(#fgv, "%.2f ms", (3 * 4 ^ (slider94 / 100)) ^ (1 - fg_cm) * (0.4 * 10 ^ (slider94 / 100)) ^ fg_cm);
fg_knob(956, 224, 14, 94, 0, 100, 50, 0, 0, LAPIS, "MANUAL", #fgv);
sprintf(#fgv, "%d%%", slider95);              fg_knob(1028, 224, 14, 95, 0, 100, 0, 0, 0, LAPIS, "REGEN", #fgv);
ui_cola(INK, 0.3); fg_r(916, 266, 152, 1.5);
// MD-6
fg_unit(276, slider96 >= 0.5, 96, "MD-6 ECHO");
slider97 >= 0.5 ? (
  sprintf(#fgv, "%s", fo_dname(slider55));    fg_knob(936, 336, 14, 55, 0, 9, 6, 0, 1, LAPIS, "TIME", #fgv);
) : (
  fg_t = 20 * 100 ^ (slider98 / 100); sprintf(#fgv, fg_t < 1000 ? "%.0f ms" : "%.2f s", fg_t < 1000 ? fg_t : fg_t / 1000);
  fg_knob(936, 336, 14, 98, 0, 100, 60, 0, 0, LAPIS, "TIME", #fgv);
);
sprintf(#fgv, "%d%%", slider56);              fg_knob(992, 336, 14, 56, 0, 100, 45, 0, 0, LAPIS, "FDBK", #fgv);
sprintf(#fgv, "%d%%", slider57);              fg_knob(1048, 336, 14, 57, 0, 100, 40, 0, 0, LAPIS, "LEVEL", #fgv);
sprintf(#fgv, slider99 < 60 ? "%.2f Hz" : "%.1f Hz", 0.05 * 160 ^ (slider99 / 100)); fg_knob(936, 396, 14, 99, 0, 100, 35, 0, 0, LAPIS, "WOW", #fgv);
sprintf(#fgv, "%.2f ms", 9 * sqr(slider100 / 100)); fg_knob(992, 396, 14, 100, 0, 100, 15, 0, 0, LAPIS, "DEPTH", #fgv);
fg_key(1024, 384, 48, 24, "SYNC", slider97 >= 0.5, LAPIS) ? fg_set(97, slider97 >= 0.5 ? 0 : 1);
ui_cola(INK, 0.3); fg_r(916, 438, 152, 1.5);
// the vocal plate
fg_unit(448, slider101 >= 0.5, 101, "VOCAL PLATE");
sprintf(#fgv, "%.2f s", slider58);            fg_knob(936, 506, 14, 58, 0.4, 5, 2.6, 1, 0.01, LAPIS, "DECAY", #fgv);
sprintf(#fgv, "%d ms", slider102);            fg_knob(992, 506, 14, 102, 0, 250, 40, 0, 1, LAPIS, "PRE", #fgv);
sprintf(#fgv, "%d%%", slider59);              fg_knob(1048, 506, 14, 59, 0, 100, 30, 0, 1, LAPIS, "MIX", #fgv);

// ---------- FATE and VOLUME, the output meter ----------
fg_field(904, 556, 176, 104, FATEBG);
fg_band(904, 556, 176, 28, 0x6A3E8E, "FATE");
fg_trk = ui_mix(FATEBG, 0x000000, 0.28);
sprintf(#fgv, "%d%%", slider60);              fg_knob(936, 614, 15, 60, 0, 100, 35, 0, 1, 0x8A4FB8, "FATE", #fgv);
sprintf(#fgv, "%+.1f dB", slider61);          fg_knob(998, 614, 15, 61, -24, 6, 0, 0, 0.1, 0x8A4FB8, "VOLUME", #fgv);
fg_mL = max(fo_pkl, fg_mL * 0.86); fg_mR = max(fo_pkr, fg_mR * 0.86); fo_pkl = 0; fo_pkr = 0;
fg_i = 0;
loop(2,
  fg_v = fg_i == 0 ? fg_mL : fg_mR;
  fg_db = 20 * log10(max(fg_v, 0.00001)); fg_f = min(max((fg_db + 48) / 48, 0), 1);
  ui_col(INK); fg_r(1040 + fg_i * 16, 592, 11, 60);
  ui_col(0xFFF6DC); fg_r(1041.5 + fg_i * 16, 593.5, 8, 57);
  ui_col(fg_db > -1 ? 0xE0402A : fg_db > -6 ? SUN : TURQ); fg_r(1041.5 + fg_i * 16, 593.5 + 57 * (1 - fg_f), 8, 57 * fg_f);
  fg_i += 1;
);
ui_cola(INK, 0.5); fg_i = 0; loop(5, fg_r(1035, 593.5 + 57 * fg_i * 12 / 48, 3, 1); fg_i += 1; );

// ---------- the bottom strip: key, scale, channel, SAT, OUT ----------
fg_field(24, 670, 1056, 40, SAND);
fg_trk = ui_mix(CARD, 0x000000, 0.28);
sprintf(#fgv, "%+d st", slider51);            fg_bip = 1; fg_knob(50, 690, 12, 51, -12, 12, 0, 0, 1, OCHRE, "", #fgv);
gfx_setfont(10); ui_col(INK); fg_txt(70, 683, "TRANSPOSE");
fg_txt(156, 683, "SCALE");
fg_i = 0; loop(5,
  fg_key(204 + fg_i * 52, 677, 48, 26, fg_i == 0 ? "OFF" : fg_i == 1 ? "MAJ" : fg_i == 2 ? "MIN" : fg_i == 3 ? "DOR" : "PENT", slider52 == fg_i, OCHRE) ? fg_set(52, fg_i);
  fg_i += 1; );
sprintf(#fgv, "%s", fg_pc(slider53));         fg_knob(486, 690, 12, 53, 0, 11, 0, 0, 1, OCHRE, "", #fgv);
gfx_setfont(10); ui_col(INK); fg_txt(506, 683, "ROOT");
gfx_setfont(12); ui_col(INK); fg_txt(548, 681, fg_pc(slider53));
// MIDI channel
slider62 < 0.5 ? strcpy(#fgl, "MIDI OMNI") : sprintf(#fgl, "MIDI CH %d", slider62);
fg_mbox(720, 677, 100, 26, 62, 0, 16, #fgl, "Omni|Channel 1|Channel 2|Channel 3|Channel 4|Channel 5|Channel 6|Channel 7|Channel 8|Channel 9|Channel 10|Channel 11|Channel 12|Channel 13|Channel 14|Channel 15|Channel 16", 0);
// SAT
sprintf(#fgv, "%d%%", slider63);              fg_knob(1010, 690, 12, 63, 0, 100, 0, 0, 1, 0xD8B040, "", #fgv);
gfx_setfont(10); ui_col(INK); fg_txt(1030, 683, "SAT");

// ---------- the title ----------
ui_col(INK); fg_th(250, 730, 446, 730, 2); fg_th(654, 730, 850, 730, 2);
fg_disc(244, 730, 3); fg_disc(856, 730, 3);
gfx_setfont(13); ui_col(INK); fg_ctxt(550, 730, "THE FOOL");

pk_end();
ui_end();
