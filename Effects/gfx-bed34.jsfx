  kr_thick((dv_cx + dv_r * 0.55) * sc, (dv_cy - dv_r * 0.38) * sc, (dv_cx + dv_r * 0.82) * sc, (dv_cy - dv_r * 0.34) * sc, 1.6 * sc);
  kr_thick((dv_cx - dv_r * 0.36) * sc, (dv_cy + dv_r * 0.25) * sc, (dv_cx - dv_r * 0.7) * sc, (dv_cy + dv_r * 0.45) * sc, 1.6 * sc);
);
