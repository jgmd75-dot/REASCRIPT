  dv_tk(680, 150, 4, 0, 10, 5, KCLI, "BASS", dv_n(slider4));
  kr_kc = LK_WHT; kr_key(212, 268, 92, 24, "MID BOOST", slider14 >= 0.5) ? kr_tog(14);
  ui_col(ui_mix(KRF, KRP, 0.6)); kr_r(210, 212, 538, 1);
  // row 2: the PARAMETRIC EQ (yellow), PRESENCE and REVERB (red)
