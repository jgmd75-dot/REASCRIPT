  kr_kc = LK_RED; kr_key(214, 192, 112, 28, "NORMAL", slider21 < 0.5) ? ( slider21 = 0; ui_auto(21); );
  KRA = dv_ka; KRKT = dv_kk;
  dv_tk(378, 190, 3, 0, 10, 5, 0xEDEDE8, "VOLUME", dv_n(slider3));
