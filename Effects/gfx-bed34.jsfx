  krv_lg = 1; sprintf(#dvq, "Q %.2f", slider16); dv_tk(450, 280, 16, 0.5, 4, 1, KCYE, "Q", #dvq);
  sprintf(#dvf, slider17 >= 1000 ? "%.1f kHz" : "%d Hz", slider17 >= 1000 ? slider17 / 1000 : floor(slider17 + 0.5)); dv_tk(520, 280, 17, 100, 2000, 500, KCYE, "FREQUENCY", #dvf); krv_lg = 0;
  gfx_setfont(10); ui_col(KRI2); kr_ctxt(450, 336, "PARAMETRIC EQ"); ui_col(KCYE); kr_r(360, 328, 30, 1); kr_r(510, 328, 30, 1);
  dv_tk(610, 280, 18, 0, 10, 0, KCRE, "PRESENCE", dv_n(slider18));
