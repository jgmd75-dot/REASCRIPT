  dv_a = kr_knob(300, 212, 34, 3, 0, 10, 5); kr_name(300, 274, dv_a, "DRIVE", slider3 < 0.05 ? "OFF" : dv_n(slider3));
  kr_scale(479, 212, 34, 3, 18, "0|5|10", 4);
