desc:GFX G RS70 [drum machine]
//tags: instrument drum machine rhythm digital 707 sequencer lo-fi
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-thick, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate
// (.jsfx-inc) in the same folder.
//
// RS70 - the RS series' digital machine, in the spirit of the mid-80s rhythm composer whose drums lived in 8-bit chips.
// No samples: every sound is synthesised when the plug-in loads ("baked") at a 25 kHz sample clock, stored 8-bit
// (companded; the cymbals 6-bit, as on the original) and played back through a vintage output filter.
//
// VOICES (thirteen channels, each with its LEVEL): BASS (two kicks: 1 round, 2 short and punchy), SNARE (1 fat, 2 tight
// and bright), LOW / MID / HI TOM, RIM, COWBELL, CLAP, TAMBOURINE, CLOSED HAT, OPEN HAT (CH cuts off a ringing OH),
// CRASH, RIDE.
//   ACCENT: how far apart accents and plain hits are (plain hits sit back, accents jump out; 50 % = about 6 dB).  PITCH: the sample clock, +/- 12 semitones (every voice together).
//   TONE: the output filter (dark .. open).
//
// SEQUENCER: 16 patterns of 16 steps per channel (off / hit / accent), LAST STEP per pattern, SWING. It never starts
//   running by itself: press RUN. While REAPER plays, it locks to the timeline (bar 1 = step 1); while REAPER is
//   stopped, RUN free-runs at the project tempo. A new pattern takes over at the end of the bar.
// MIDI: notes play the voices too (GM drum map: 35 / 36 BD, 38 / 40 SD, 41 LT, 45 MT, 48 HT, 37 RS, 56 CB, 39 CP,
//   54 TB, 42 CH, 46 OH, 49 CR, 51 RD); velocity above 100 = accent. MIDI passes through.
//
// FOLLOW: the sequencer starts and stops with REAPER's transport (off by default: it never starts by itself).
// PATTERNS: a bank of 15 patterns; a new instance starts with them in patterns 1 - 15 (PATTERN > Load a pattern from
//   the bank brings any of them back). PATTERN also clears or copies the pattern.
// EDIT (layer B): a TUNE (+/- 12 semitones) and an amp envelope - ATTACK, DECAY, SUSTAIN, RELEASE - for every
//   instrument. SUSTAIN holds for the gate (one step from the sequencer, the held note from MIDI); SUSTAIN 100 % with
//   RELEASE at NATURAL (the default) leaves the sound as it is. Presets reset layer B to its defaults.
//
// SIGNAL FLOW: the voices > the output filter (TONE) > the FX strip, in this order: PHASER > DRIVE > COMP > DELAY (each
//   with its IN key) > THICK > LEVEL > the house output stage (CLIP, -0.3 dBFS).
//
// DRIFT (0 - 100 %, 50 % = standard): an old digital machine.
//   pitch      the sample clock wanders slowly (+/- 10 cents), each voice sits a little off (+/- 5 cents), and each
//              hit lands a touch sharp or flat (+/- 3 cents)
//   filter     the output filter's cutoff wanders (+/- 0.3 octave)
//   humanise   each sequenced hit lands a little early or late (+/- 3 ms); MIDI notes are left as played
//   0 % = none (machine-tight), 100 % = twice the standard amount, a little faster.
//
// PAD ORDER AND COLOURS: the voices are laid out BD, SN, RIM, CLAP, HH, OH, HT, MT, LT, RD, CR (then the percussion)
//   on the panel, the grid and the EDIT page, colour-coded by family (kick brown, snare / rim red, clap orange,
//   hats yellow, toms green, cymbals blue, percussion violet; darker = lower). The MIDI notes are unchanged.
// GUI: in the dress of Wingspan (graphite plates, cream print, knurled caps, amber lit keys), the step grid on an
//   LCD-style screen. Click a step to cycle off > hit > accent; drag to paint the same value along a row. Click a
//   track name to hear it. Values show while a knob is touched.
// PRESETS (12): kits - sounds, swing, pitch, tone and FX, level-matched to Init on a groove; they never change the
//   patterns. (Patterns: see PATTERNS above.)
// Latency: 0 samples (the sequencer looks 6 ms ahead so humanised hits can land early).
//
// TWEAK points are marked TWEAK.
// STATUS: Stable v2.0 (from the Lab, Oct 2026). v0.7 (wider ACCENT; complete: sound engine, sequencer, FX strip, faceplate, presets; the house
//   3D lamp keys, as the 34 series).

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-thick.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:ac_lvl=50<0,100,1>-Accent (%)
slider2:lv_bd=80<0,100,1>-Bass level (%)
slider3:lv_sd=70<0,100,1>-Snare level (%)
slider4:lv_lt=65<0,100,1>-Low tom level (%)
slider5:lv_mt=65<0,100,1>-Mid tom level (%)
slider6:lv_ht=65<0,100,1>-Hi tom level (%)
slider7:lv_rs=60<0,100,1>-Rim level (%)
slider8:lv_cb=55<0,100,1>-Cowbell level (%)
slider9:lv_cp=65<0,100,1>-Clap level (%)
slider10:lv_tb=55<0,100,1>-Tambourine level (%)
slider11:lv_ch=60<0,100,1>-Closed hat level (%)
slider12:lv_oh=60<0,100,1>-Open hat level (%)
slider13:lv_cr=50<0,100,1>-Crash level (%)
slider14:lv_rd=50<0,100,1>-Ride level (%)
slider15:bd_type=0<0,1,1{1,2}>-Bass drum
slider16:sd_type=0<0,1,1{1,2}>-Snare drum
slider17:swing=0<0,100,1>-Swing (%)
slider18:m_lvl=0<-18,6,0.1>-Level (dB)
slider19:drift=50<0,100,1>-Drift (%)
slider20:thick=0<0,1,1{Off,On}>-Thick
slider21:ph_in=0<0,1,1{Out,In}>-Phaser in
slider22:ph_rate=0.4<0.05,5,0.01>-Phaser rate (Hz)
slider23:ph_dep=60<0,100,1>-Phaser depth (%)
slider24:ph_fb=40<0,90,1>-Phaser feedback (%)
slider25:ph_col=50<0,100,1>-Phaser colour (%)
slider26:dr_in=0<0,1,1{Out,In}>-Drive in
slider27:dr_amt=40<0,100,1>-Drive amount (%)
slider28:dr_tone=50<0,100,1>-Drive tone (%)
slider29:cm_in=0<0,1,1{Out,In}>-Comp in
slider30:cm_thr=-12<-40,0,0.1>-Comp threshold (dB)
slider31:cm_rat=4<1,20,0.1>-Comp ratio
slider32:cm_env=0<0,1,1{Fast,Slow}>-Comp envelope
slider33:cm_mk=0<0,20,0.1>-Comp make-up (dB)
slider34:dl_in=0<0,1,1{Out,In}>-Delay in
slider35:dl_sync=1<0,1,1{Free,Sync}>-Delay sync
slider36:dl_ms=300<20,1500,1>-Delay time (ms)
slider37:dl_div=3<0,6,1{1/32,1/16,1/16 dotted,1/8,1/8 dotted,1/4,1/4 dotted}>-Delay note
slider38:dl_fb=35<0,90,1>-Delay feedback (%)
slider39:dl_damp=40<0,100,1>-Delay damp (%)
slider40:dl_mix=25<0,100,1>-Delay mix (%)
slider41:pitch=0<-12,12,0.1>-Pitch (st)
slider42:tone=70<0,100,1>-Tone (%)
slider43:follow=0<0,1,1{Off,On}>-Follow transport
slider44:0<-12,12,0.1>-Bass tune (st)
slider45:0<0,200,1>-Bass attack (ms)
slider46:4000<5,4000,1>-Bass decay (ms)
slider47:100<0,100,1>-Bass sustain (%)
slider48:5000<5,5000,1>-Bass release (ms, 5000 = natural)
slider49:0<-12,12,0.1>-Snare tune (st)
slider50:0<0,200,1>-Snare attack (ms)
slider51:4000<5,4000,1>-Snare decay (ms)
slider52:100<0,100,1>-Snare sustain (%)
slider53:5000<5,5000,1>-Snare release (ms, 5000 = natural)
slider54:0<-12,12,0.1>-Low tom tune (st)
slider55:0<0,200,1>-Low tom attack (ms)
slider56:4000<5,4000,1>-Low tom decay (ms)
slider57:100<0,100,1>-Low tom sustain (%)
slider58:5000<5,5000,1>-Low tom release (ms, 5000 = natural)
slider59:0<-12,12,0.1>-Mid tom tune (st)
slider60:0<0,200,1>-Mid tom attack (ms)
slider61:4000<5,4000,1>-Mid tom decay (ms)
slider62:100<0,100,1>-Mid tom sustain (%)
slider63:5000<5,5000,1>-Mid tom release (ms, 5000 = natural)
slider64:0<-12,12,0.1>-Hi tom tune (st)
slider65:0<0,200,1>-Hi tom attack (ms)
slider66:4000<5,4000,1>-Hi tom decay (ms)
slider67:100<0,100,1>-Hi tom sustain (%)
slider68:5000<5,5000,1>-Hi tom release (ms, 5000 = natural)
slider69:0<-12,12,0.1>-Rim tune (st)
slider70:0<0,200,1>-Rim attack (ms)
slider71:4000<5,4000,1>-Rim decay (ms)
slider72:100<0,100,1>-Rim sustain (%)
slider73:5000<5,5000,1>-Rim release (ms, 5000 = natural)
slider74:0<-12,12,0.1>-Cowbell tune (st)
slider75:0<0,200,1>-Cowbell attack (ms)
slider76:4000<5,4000,1>-Cowbell decay (ms)
slider77:100<0,100,1>-Cowbell sustain (%)
slider78:5000<5,5000,1>-Cowbell release (ms, 5000 = natural)
slider79:0<-12,12,0.1>-Clap tune (st)
slider80:0<0,200,1>-Clap attack (ms)
slider81:4000<5,4000,1>-Clap decay (ms)
slider82:100<0,100,1>-Clap sustain (%)
slider83:5000<5,5000,1>-Clap release (ms, 5000 = natural)
slider84:0<-12,12,0.1>-Tambourine tune (st)
slider85:0<0,200,1>-Tambourine attack (ms)
slider86:4000<5,4000,1>-Tambourine decay (ms)
slider87:100<0,100,1>-Tambourine sustain (%)
slider88:5000<5,5000,1>-Tambourine release (ms, 5000 = natural)
slider89:0<-12,12,0.1>-Closed hat tune (st)
slider90:0<0,200,1>-Closed hat attack (ms)
slider91:4000<5,4000,1>-Closed hat decay (ms)
slider92:100<0,100,1>-Closed hat sustain (%)
slider93:5000<5,5000,1>-Closed hat release (ms, 5000 = natural)
slider94:0<-12,12,0.1>-Open hat tune (st)
slider95:0<0,200,1>-Open hat attack (ms)
slider96:4000<5,4000,1>-Open hat decay (ms)
slider97:100<0,100,1>-Open hat sustain (%)
slider98:5000<5,5000,1>-Open hat release (ms, 5000 = natural)
slider99:0<-12,12,0.1>-Crash tune (st)
slider100:0<0,200,1>-Crash attack (ms)
slider101:4000<5,4000,1>-Crash decay (ms)
slider102:100<0,100,1>-Crash sustain (%)
slider103:5000<5,5000,1>-Crash release (ms, 5000 = natural)
slider104:0<-12,12,0.1>-Ride tune (st)
slider105:0<0,200,1>-Ride attack (ms)
