desc:C2ME Mini [channel strip] (GFX Lab)
//tags: channel strip console eq compressor limiter transformer broadcast stereo width mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider36:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:os_sl=0<0,2,1{1x,2x,4x}>-Oversampling
slider3:trim=0<-20,20,0.1>-Trim (dB)
slider4:phase=0<0,1,1{Normal,Reversed}>-Phase
slider5:hpf=20<20,400,1>-HPF (Hz, 20 = off)
slider6:lpf=20000<2500,20000,10>-LPF (Hz, 20000 = off)
slider7:eq_in=1<0,1,1{Out,In}>-EQ in
slider8:hf_g=0<-15,15,0.1>-HF gain (dB)
slider9:hf_f=8000<2700,16000,10>-HF frequency (Hz)
slider10:hf_bell=0<0,1,1{Shelf,Bell}>-HF shape
slider11:hmf_g=0<-15,15,0.1>-HMF gain (dB)
slider12:hmf_f=2500<1100,6800,10>-HMF frequency (Hz)
slider13:lmf_g=0<-15,15,0.1>-LMF gain (dB)
slider14:lmf_f=700<180,2400,1>-LMF frequency (Hz)
slider15:lf_g=0<-15,15,0.1>-LF gain (dB)
slider16:lf_f=100<47,470,1>-LF frequency (Hz)
slider17:lf_bell=0<0,1,1{Shelf,Bell}>-LF shape
slider18:c_in=1<0,1,1{Off,On}>-Comp in
slider19:c_thr=0<-20,10,0.1>-Comp threshold (dBu)
slider20:c_rat=3<1.5,5,0.1>-Ratio
slider21:c_rec=0.4<0.1,4,0.01>-Comp recovery (s)
slider22:c_gain=2<0,20,0.1>-Gain (dB)
slider23:c_fast=0<0,1,1{Slow,Fast}>-Attack
slider24:c_auto=0<0,1,1{Off,On}>-Auto recovery
slider25:l_in=1<0,1,1{Off,On}>-Limiter in
slider26:l_thr=12<-4,16,0.1>-Limit threshold (dBu)
slider27:l_rec=0<0,2,1{75 ms,5 s,Auto}>-Limit recovery
slider28:iron=1<0,1,1{Off,On}>-Iron
slider29:drift=3<0,10,0.1>-Drift
slider30:mix=100<0,100,1>-Dynamics mix (%)
slider31:order=0<0,1,1{EQ first,DYN first}>-Order
slider32:width=100<0,200,0.1>-Width (%)
slider33:out_db=0<-24,12,0.1>-Output (dB)
slider34:sat=0<0,100,1>-Saturation (%)
slider35:prs_sel=0<0,9,1{No preset,Init,Vocal Channel,Broadcast Voice,Drum Bus,Bass DI,Acoustic Guitar,Mix Bus Glue,Room Squash,Desk Colour Only}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(68719476735, v); );
function psw_allg(v) ( slider_show(68719476735, v); );
#ui_man = "gfx-lab-c2me-mini";
ext_noinit = 1;
ext_gr_meter = 0;
CR = 16;

function ce_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function db2g(d) ( exp(d * 0.11512925464970228); );
function cms(ms) ( 1 - exp(-1 / max(1, ms * 0.001 * ce_R)); );
function bcms(ms) ( 1 - exp(-1 / max(1, ms * 0.001 * srate)); );
function ts(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

function ch_cfg() instance(cin, thr, sl, ac, rcr, aut, mk, lin, lthr, lmode) (
  cin = c_in >= 0.5;
  thr = min(max(c_thr, -20), 10) - 18;
  sl = 1 - 1 / min(max(c_rat, 1.5), 5);
  rcr = min(max(c_rec, 0.1), 4);
  mk = db2g(min(max(c_gain, 0), 20));
  ac = c_fast >= 0.5 ? cms(1) : cms(10);
  aut = c_auto >= 0.5;
  lin = l_in >= 0.5;
  lthr = db2g(min(max(l_thr, -4), 16) - 18);
  lmode = l_rec | 0;
);
function ch_blk(rs) instance(rcr, rc, rcf, rcs, acs, lmode, lr, lrf, lrs, lsa) (
  rc = cms(rcr * 350 * rs);
  rcf = cms(120 * rs); rcs = cms(1800 * rs); acs = cms(300);
  lr = lmode == 1 ? cms(5000) : cms(75);
  lrf = cms(75); lrs = cms(2000); lsa = cms(30);
);
function ch_det(x) instance(ms) ( ms += (x * x - ms) * det_c; ms = ce_tn(ms); 10 * log10(ms + 0.0000000001) + 3; );
function ch_gain(lv) instance(cin, thr, sl, ac, rc, rcf, rcs, acs, aut, e, ef, es) local(o, t) (
  cin ? (
    o = lv - thr;
    t = o <= -3 ? 0 : o < 3 ? -sl * (o + 3) * (o + 3) / 12 : -sl * o;
    aut ? (
      ef += (t - ef) * (t < ef ? ac : rcf);
      es += (t - es) * (t < es ? acs : rcs);
      e = min(ef, es);
    ) : (
      e += (t - e) * (t < e ? ac : rc); ef = e; es = e;
    );
  ) : ( e += (0 - e) * off_c; ef = e; es = e; );
  e;
);
function ch_vca(x) instance(e, cin, sw) local(k, y) (
  sw += (cin - sw) * xs_c;
  k = 0.55 * bloom_k * (1 + 0.07 * min(-e, 20));
  y = (ts(x * k + 0.08) - ts(0.08)) / (k * 0.9943);
  x + (y - x) * sw;
);
function ch_lim(x) instance(lin, lthr, lmode, lg, lf, ls, lr, lrf, lrs, lsa) local(t) (
  t = lin && abs(x) > lthr ? lthr / abs(x) : 1;
  lmode == 2 ? (
    lf = t < lf ? t : lf + (1 - lf) * lrf;
    ls = t < ls ? ls + (t - ls) * lsa : ls + (1 - ls) * lrs;
    lg = min(lf, ls);
  ) : (
    lg = t < lg ? t : lg + (1 - lg) * lr; lf = lg; ls = lg;
  );
  lg;
);
function ch_clr() instance(ms, e, ef, es, lg, lf, ls) ( ms = e = ef = es = 0; lg = lf = ls = 1; );

XF_K = 1.6; XF_W = 1.04; OP_K = 0.42; OP_B = 0.06;
function in_xfmr(x) instance(lo, ik) local(s) (
  lo += (x - lo) * xf_c; lo = ce_tn(lo);
  s = ts(lo * ik) / ik * XF_W;
  x + s - lo;
);
function in_opamp(x, k) ( (ts(x * k + OP_B) - ts(OP_B)) / (k * op_d); );

function svf_c(fc) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(fc, 0.45 * srate) / ce_R); k = 1.41421356;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf_t(x) instance(a1, a2, a3, k, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  ic1 = ce_tn(ic1); ic2 = ce_tn(ic2);
  lp = v2; bp = v1; hp = x - k * v1 - v2;
);
PQ_Q0 = 0.55; PQ_PER_DB = 0.09; SHELF_Q = 0.6;
function pq(db) ( PQ_Q0 * (1 + PQ_PER_DB * abs(db)); );
function eq_c(kind, fc, db, q) instance(a1, a2, a3, m0, m1, m2) local(a, g, k) (
  a = 10 ^ (db / 40);
  g = tan($pi * min(fc, 0.45 * srate) / ce_R);
  kind == 0 ? ( k = 1 / (q * a); m0 = 1; m1 = k * (a * a - 1); m2 = 0; ) :
  kind == 1 ? ( g /= sqrt(a); k = 1 / q; m0 = 1; m1 = k * (a - 1); m2 = a * a - 1; ) :
              ( g *= sqrt(a); k = 1 / q; m0 = a * a; m1 = k * (1 - a) * a; m2 = 1 - a * a; );
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function eq_t(x) instance(a1, a2, a3, m0, m1, m2, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  ic1 = ce_tn(ic1); ic2 = ce_tn(ic2);
  m0 * x + m1 * v1 + m2 * v2;
);
function f_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function out_xfmr(x) instance(h) ( h += (x - h) * ho_c; h = ce_tn(h); x + (h - x) * 0.35; );
function walk(dt) instance(v, tg, tm) (
  tm -= dt; tm <= 0 ? ( tg = rand(2) - 1; tm = 2 + rand(5); );
  v += (tg - v) * min(1, dt / 2.5);
  v;
);

function dyn_block() local(dl, dr2, vl, vr, ql, qr, gl, gr) (
  dl = zl; dr2 = zr;
  vl = CA.ch_det(dl); vr = CB.ch_det(dr2);
  vl = max(vl, vr); vr = vl;
  CA.ch_gain(vl); CB.ch_gain(vr);
  ql = dl * db2g(CA.e); qr = dr2 * db2g(CB.e);
  ql = CA.ch_vca(ql); qr = CB.ch_vca(qr);
  CA.mks += (CA.mk - CA.mks) * sm; CB.mks += (CB.mk - CB.mks) * sm;
  ql *= CA.mks; qr *= CB.mks;
  gl = CA.ch_lim(ql); gr = CB.ch_lim(qr);
  gl = min(gl, gr); gr = gl;
  ql *= gl; qr *= gr;
  mix_s += (mix_t - mix_s) * sm;
  zl = dl + (ql - dl) * mix_s; zr = dr2 + (qr - dr2) * mix_s;
  emA = min(emA, CA.e); glA = min(glA, gl);
);
function eq_block() (
  hp_s += (hpf_on - hp_s) * xs_c; lp_s += (lpf_on - lp_s) * xs_c;
  fl = zl; fr = zr;
  HPL.svf_t(fl); HPR.svf_t(fr);
  hp_s >= 0.99999 ? ( fl = HPL.hp; fr = HPR.hp; ) : hp_s > 0.00001 ? ( fl += (HPL.hp - fl) * hp_s; fr += (HPR.hp - fr) * hp_s; );
  LPL.svf_t(fl); LPR.svf_t(fr);
  lp_s >= 0.99999 ? ( fl = LPL.lp; fr = LPR.lp; ) : lp_s > 0.00001 ? ( fl += (LPL.lp - fl) * lp_s; fr += (LPR.lp - fr) * lp_s; );
  zl = fl; zr = fr;
  el = zl; er = zr;
  el = HMFL.eq_t(HFL.eq_t(el)); er = HMFR.eq_t(HFR.eq_t(er));
  el = LFL.eq_t(LMFL.eq_t(el)); er = LFR.eq_t(LMFR.eq_t(er));
  zl += (el - zl) * eqin_s; zr += (er - zr) * eqin_s;
);
function ce_ph(xl, xr) local(yl, yr) (
  yl = xl * trim_s * pol_s; yr = xr * trim_s * pol_s;
  xw_s > 0.00001 ? ( yl += (XFL.in_xfmr(yl) - yl) * xw_s; yr += (XFR.in_xfmr(yr) - yr) * xw_s; );
  yl = in_opamp(yl, opa_k); yr = in_opamp(yr, opa_k);
  zl = yl; zr = yr;
  ord_use ? ( dyn_block(); eq_block(); ) : ( eq_block(); dyn_block(); );
  ce_pl = zl * dkq; ce_pr = zr * dkq;
);

function ce_coef() local(hs, ls, hg, lg) (
  HPL.svf_c(exp(s_hpf)); HPR.svf_c(exp(s_hpf));
  LPL.svf_c(exp(s_lpf)); LPR.svf_c(exp(s_lpf));
  hs = hf_k; ls = lf_k; hg = s_hfg * hf_w; lg = s_lfg * lf_w;
  HFL.eq_c(hs, exp(s_hff), hg, hs ? SHELF_Q : pq(hg)); HFR.eq_c(hs, exp(s_hff), hg, hs ? SHELF_Q : pq(hg));
  HMFL.eq_c(0, exp(s_hmff), s_hmfg, pq(s_hmfg)); HMFR.eq_c(0, exp(s_hmff), s_hmfg, pq(s_hmfg));
  LMFL.eq_c(0, exp(s_lmff), s_lmfg, pq(s_lmfg)); LMFR.eq_c(0, exp(s_lmff), s_lmfg, pq(s_lmfg));
  LFL.eq_c(ls, exp(s_lff), lg, ls ? SHELF_Q : pq(lg)); LFR.eq_c(ls, exp(s_lff), lg, ls ? SHELF_Q : pq(lg));
);
function control_tick() local(hs, ls) (
  s_hpf += (t_hpf - s_hpf) * sm_c; s_lpf += (t_lpf - s_lpf) * sm_c;
  s_hfg += (t_hfg - s_hfg) * sm_c; s_hff += (t_hff - s_hff) * sm_c;
  s_hmfg += (t_hmfg - s_hmfg) * sm_c; s_hmff += (t_hmff - s_hmff) * sm_c;
  s_lmfg += (t_lmfg - s_lmfg) * sm_c; s_lmff += (t_lmff - s_lmff) * sm_c;
  s_lfg += (t_lfg - s_lfg) * sm_c; s_lff += (t_lff - s_lff) * sm_c;
  hs = hf_bell >= 0.5 ? 0 : 2; ls = lf_bell >= 0.5 ? 0 : 1;
  hs != hf_k ? ( hf_w = max(0, hf_w - dk_c); hf_w <= 0 ? hf_k = hs; ) : hf_w = min(1, hf_w + dk_c);
  ls != lf_k ? ( lf_w = max(0, lf_w - dk_c); lf_w <= 0 ? lf_k = ls; ) : lf_w = min(1, lf_w + dk_c);
  ce_coef();
);

function ce_rate() (
  ce_R = srate * os_f;
  det_c = cms(5); off_c = cms(20); sm = cms(20); xs_c = cms(10);
  xf_c = 1 - exp(-2 * $pi * 150 / ce_R);
);
function ce_params() (
  ce_rate();
  CA.ch_cfg(); CB.ch_cfg();
  mix_t = min(max(mix, 0), 100) / 100;
  dkr = 1 / (0.006 * srate);
  t_trim = db2g(min(max(trim, -20), 20)); t_pol = phase >= 0.5 ? -1 : 1;
  t_hpf = log(min(max(hpf, 20), 400)); t_lpf = log(min(max(lpf, 2500), 20000));
  hpf_on = hpf > 20.5; lpf_on = lpf < 19990;
  t_eqin = eq_in >= 0.5;
  t_hfg = hf_g; t_hff = log(min(max(hf_f, 2700), 16000)); t_hmfg = hmf_g; t_hmff = log(min(max(hmf_f, 1100), 6800));
  t_lmfg = lmf_g; t_lmff = log(min(max(lmf_f, 180), 2400)); t_lfg = lf_g; t_lff = log(min(max(lf_f, 47), 470));
  t_xw = iron >= 0.5; dr = min(max(drift, 0), 10) / 10;
  b_xs = bcms(10);
  ho_c = 1 - exp(-2 * $pi * min(16000, srate * 0.45) / srate);
  sm_c = 1 - exp(-CR / (0.03 * srate));
  dk_c = CR / (0.005 * srate);
  t_wid = min(max(width, 0), 200) / 100; wd_c = bcms(20);
  ce_outt = db2g(min(max(out_db, -24), 12));
  ce_satt = min(max(sat, 0), 100) / 100;
  CA.ch_blk(rel_s); CB.ch_blk(rel_s);
  os_tf = os_f2n(os_sl);
);
function ce_snapv() (
  trim_s = t_trim; pol_s = t_pol; s_hpf = t_hpf; s_lpf = t_lpf; eqin_s = t_eqin;
  s_hfg = t_hfg; s_hff = t_hff; s_hmfg = t_hmfg; s_hmff = t_hmff;
  s_lmfg = t_lmfg; s_lmff = t_lmff; s_lfg = t_lfg; s_lff = t_lff; xw_s = t_xw;
  CA.mks = CA.mk; CB.mks = CB.mk; CA.sw = CA.cin; CB.sw = CB.cin;
  mix_s = mix_t; ord_cur = order >= 0.5; ord_st = 0; dk = 1; wid_s = t_wid;
  hp_s = hpf_on; lp_s = lpf_on; hf_k = hf_bell >= 0.5 ? 0 : 2; lf_k = lf_bell >= 0.5 ? 0 : 1; hf_w = lf_w = 1;
  ce_outs = ce_outt; ce_sats = ce_satt;
  ce_coef();
);
function ce_osclr() (
  CA.ch_clr(); CB.ch_clr(); XFL.lo = XFR.lo = 0;
  HPL.f_clr(); HPR.f_clr(); LPL.f_clr(); LPR.f_clr();
  HFL.f_clr(); HFR.f_clr(); HMFL.f_clr(); HMFR.f_clr(); LMFL.f_clr(); LMFR.f_clr(); LFL.f_clr(); LFR.f_clr();
);
function ce_reset() (
  OSU.os_clr(); OSD.os_clr(); OSUB.os_clr(); OSDB.os_clr();
  ce_osclr(); OXL.h = OXR.h = 0; OSTL.ost_ch_init(); OSTR.ost_ch_init();
  memset(BY_BUF, 0, 2 * BY_N);
  ce_rsf = 0;
);

os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
rel_s = 1; bloom_k = 1; dkq = 1;
XFL.ik = XFR.ik = XF_K; opa_k = OP_K; sup_g = 1;
op_d = (ts(OP_B + 0.0001) - ts(OP_B - 0.0001)) / 0.0002;
CA.lg = CA.lf = CA.ls = 1; CB.lg = CB.lf = CB.ls = 1;
ce_params();
ce_snapv();
ost_init(0); OSTL.ost_ch_init(); OSTR.ost_ch_init();
ost_setup(ce_sats, 0, 200, 4000, -0.3, 0);
os_gsetup();
ce_reset(); ce_rsf = 1;
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.12; pwr_wu_loss = 0.3; pwr_wu_drv = 0.7; pwr_wu_lp = 13000; pwr_wu_wob = 0.1; pwr_bloom = 0;
ce_snap = 1; ce_blkn = 0;
pdc_delay = os_lat(os_f);
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
emA = 0; glA = 1; ce_gc_d = ce_gl_d = 0; ce_lm_d = 0;

function set_dyn(cin, cthr, rat, rec, gain, fast, aut, lin, lthr, lrec) (
  c_in = cin; c_thr = cthr; c_rat = rat; c_rec = rec; c_gain = gain; c_fast = fast; c_auto = aut;
  l_in = lin; l_thr = lthr; l_rec = lrec;
);
function set_eq(trm, ph, hp, lp, ei, hg, hf, hb, hmg, hmf, lmg, lmf, lg, lff, lb) (
  trim = trm; phase = ph; hpf = hp; lpf = lp; eq_in = ei;
  hf_g = hg; hf_f = hf; hf_bell = hb; hmf_g = hmg; hmf_f = hmf; lmf_g = lmg; lmf_f = lmf; lf_g = lg; lf_f = lff; lf_bell = lb;
);
function set_m(irn, dft, mxp, ord) ( iron = irn; drift = dft; mix = mxp; order = ord; width = 100; out_db = 0; sat = 0; );
function load_preset(p) (
  p == 2 ? ( set_dyn(1, -4, 3, 0.6, 5, 0, 1, 1, 10, 2); set_eq(0, 0, 80, 20000, 1, 3, 10000, 0, 2, 3600, -2, 400, -1.5, 150, 0); set_m(1, 3, 100, 0); ) :
  p == 3 ? ( set_dyn(1, -10, 5, 1, 9, 1, 1, 1, 6, 2); set_eq(0, 0, 100, 16000, 1, 2, 8000, 0, 3, 3000, -3, 300, 0, 100, 0); set_m(1, 2, 100, 1); ) :
  p == 4 ? ( set_dyn(1, -6, 4, 0.2, 6, 1, 0, 1, 10, 0); set_eq(0, 0, 30, 20000, 1, 3, 12000, 0, -2, 2500, -3, 450, 3, 70, 0); set_m(1, 4, 70, 0); ) :
  p == 5 ? ( set_dyn(1, -6, 4, 0.3, 6, 1, 0, 1, 8, 0); set_eq(0, 0, 35, 8000, 1, 0, 8000, 0, 3, 1200, -3, 300, 3, 80, 0); set_m(1, 3, 100, 1); ) :
  p == 6 ? ( set_dyn(1, -6, 2.5, 0.3, 4, 0, 0, 1, 12, 0); set_eq(0, 0, 100, 20000, 1, 3, 12000, 0, -2, 2500, -2, 450, -3, 180, 0); set_m(1, 3, 100, 0); ) :
  p == 7 ? ( set_dyn(1, 2, 1.5, 0.4, 1.5, 0, 1, 1, 14, 2); set_eq(0, 0, 20, 20000, 1, 1.5, 14000, 0, 0, 2500, -1, 300, 1, 60, 0); set_m(1, 3, 100, 1); ) :
  p == 8 ? ( set_dyn(1, -18, 5, 0.1, 16, 1, 0, 1, 4, 0); set_eq(0, 0, 60, 12000, 1, -2, 6000, 0, 3, 2200, 0, 700, 2, 100, 0); set_m(1, 6, 50, 0); ) :
  p == 9 ? ( set_dyn(0, 0, 3, 0.4, 0, 0, 0, 0, 16, 0); set_eq(6, 0, 20, 20000, 0, 0, 8000, 0, 0, 2500, 0, 700, 0, 100, 0); set_m(1, 6, 100, 0); ) :
           ( set_dyn(1, 0, 3, 0.4, 2, 0, 0, 1, 12, 0); set_eq(0, 0, 20, 20000, 1, 0, 8000, 0, 0, 2500, 0, 700, 0, 100, 0); set_m(1, 3, 100, 0); );
  slider_automate(17179869180);
  pr_cur = p > 9 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(34, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 9 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
ce_params();
os_snap(os_sl);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && ce_blkn < 40 ? ce_snap = 1;
pwr_ser();

@block
prs_chk();
ce_blkn < 40 ? ce_blkn += 1;
bdt = samplesblock / srate;
w_sup = SUP.walk(bdt); w_il = WIL.walk(bdt); w_ir = WIR.walk(bdt); bw1 = BL1.walk(bdt); bw2 = BL2.walk(bdt);
ce_params();
opa_k = OP_K * (1 + 0.25 * dr * w_sup);
sup_g = db2g(0.08 * dr * w_sup);
XFL.ik = XF_K * (1 + 0.3 * dr * w_il); XFR.ik = XF_K * (1 + 0.3 * dr * w_ir);
bloom_k = 1 + 0.35 * dr * bw1;
rel_s = 1 + 0.2 * dr * bw2;
CA.ch_blk(rel_s); CB.ch_blk(rel_s);
pwr_block(byp < 0.5);
ce_now = time_precise();
ce_tp > 0 && ce_now - ce_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > ce_gpp && play_position - ce_gpp < 4 * ce_gpd + 0.05) ? ce_reset();
ce_tp = ce_now; ce_gpp = play_position; ce_gpd = samplesblock / srate;
ce_snap ? ( ce_snap = 0; ce_snapv(); );
ce_sats += (ce_satt - ce_sats) * (1 - exp(-samplesblock / (0.03 * srate)));
ost_setup(ce_sats, 0, 200, 4000, -0.3, 0);
pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
ce_gc_d = max(ce_gc_d, -emA);
ce_gl_d = max(ce_gl_d, -20 * log10(max(glA, 0.00001)));
ce_lm_d = max(ce_lm_d, glA < 0.999);
ext_gr_meter = min(20 * log10(max(1 - mix_s + mix_s * db2g(emA) * glA, 0.00001)), 0);
emA = 0; glA = 1;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(os_sl);

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
cr_n <= 0 ? ( control_tick(); cr_n = CR; );
cr_n -= 1;
trim_s += (t_trim - trim_s) * b_xs; pol_s += (t_pol - pol_s) * b_xs;
eqin_s += (t_eqin - eqin_s) * b_xs; xw_s += (t_xw - xw_s) * b_xs;
ce_outs += (ce_outt - ce_outs) * b_xs;
ord_st == 0 && (order >= 0.5) != ord_cur ? ord_st = 1;
ord_use = ord_cur;
ord_st == 1 ? ( dk -= dkr; dk <= 0 ? ( dk = 0; ord_cur = order >= 0.5; ord_st = 2; ); ) :
ord_st == 2 ? ( dk += dkr; dk >= 1 ? ( dk = 1; ord_st = 0; ); );
dkq = ord_st ? dk * dk * (3 - 2 * dk) : 1;
x = spl0; xb = spl1;
pwr_in(x, xb); x = pwr_l; xb = pwr_r;
os_gate();
os_chg ? ( ce_params(); ce_coef(); ce_osclr(); );
OSU.os_up(x); OSUB.os_up(xb);
os_f == 1 ? (
  ce_ph(OSU.s0, OSUB.s0); y = ce_pl; yb = ce_pr;
) : os_f == 2 ? (
  ce_ph(OSU.s0, OSUB.s0); a0 = ce_pl; b0 = ce_pr;
  ce_ph(OSU.s1, OSUB.s1); a1 = ce_pl; b1 = ce_pr;
  y = OSD.os_dn(a0, a1, 0, 0); yb = OSDB.os_dn(b0, b1, 0, 0);
) : (
  ce_ph(OSU.s0, OSUB.s0); a0 = ce_pl; b0 = ce_pr;
  ce_ph(OSU.s1, OSUB.s1); a1 = ce_pl; b1 = ce_pr;
  ce_ph(OSU.s2, OSUB.s2); a2 = ce_pl; b2 = ce_pr;
  ce_ph(OSU.s3, OSUB.s3); a3 = ce_pl; b3 = ce_pr;
  y = OSD.os_dn(a0, a1, a2, a3); yb = OSDB.os_dn(b0, b1, b2, b3);
);
pwr_out(y, yb); y = pwr_l; yb = pwr_r;
xw_s > 0.00001 ? ( tl = OXL.out_xfmr(y); tr = OXR.out_xfmr(yb); y += (tl - y) * xw_s; yb += (tr - yb) * xw_s; );
y *= sup_g; yb *= sup_g;
wid_s += (t_wid - wid_s) * wd_c;
abs(wid_s - t_wid) < 0.000001 ? wid_s = t_wid;
wid_s != 1 ? (
  wd_m = (y + yb) * 0.5; wd_sd = (y - yb) * 0.5 * wid_s;
  y = wd_m + wd_sd; yb = wd_m - wd_sd;
);
y *= ce_outs; yb *= ce_outs;
tl = OSTL.ost_band(y); tr = OSTR.ost_band(yb);
ce_sats > 0 ? ( y = tl; yb = tr; );
ost_out(y, yb);
oa = ost_l; ob = ost_r;
os_q = os_g * os_g * (3 - 2 * os_g); oa *= os_q; ob *= os_q;
oa != oa ? oa = 0; ob != ob ? ob = 0;
ce_rsf < 1 ? (
  ce_rsf = min(ce_rsf + 1 / (0.015 * srate), 1); ce_rq = ce_rsf * ce_rsf * (3 - 2 * ce_rsf);
  pdc_delay > 0 ? ( ce_rdl = BY_BUF[(by_w - pdc_delay) & (BY_N - 1)]; ce_rdr = BY_BUF[BY_N + ((by_w - pdc_delay) & (BY_N - 1))]; )
                : ( ce_rdl = spl0; ce_rdr = spl1; );
  oa = ce_rdl + (oa - ce_rdl) * ce_rq; ob = ce_rdr + (ob - ce_rdr) * ce_rq;
);
spl0 = max(-4, min(4, oa));
spl1 = max(-4, min(4, ob));
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x46524A; mk_plate = 0x2E3631; mk_band = 0x232925; mk_acc = 0xE8782A; mk_ink = 0xEDEFE8; mk_ink2 = 0xC7BEB3;
mk_val = 0xFFC27E; mk_scale = 0xD8DCD4; mk_fig = 0xA9B2AA;
mk_sub = ui_mix(mk_face, 0x000000, 0.55); mk_sub2 = ui_mix(mk_face, 0x000000, 0.62);
mk_ft = ui_mix(mk_face, 0xFFFFFF, 0.22); mk_fb = ui_mix(mk_face, 0x000000, 0.22);
ui_vu_dim = byp >= 0.5;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 18 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
  mg_f3 = ui_fitarial(3, 14 * sc);
  mg_f16 = ui_fitarial(16, 18 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(3, "Arial", mg_f3, 'b');
gfx_setfont(16, "Arial", mg_f16, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_plate(x, y, w, h, title) (
  mg_rshadow(x, y, w, h, 0);
  ui_col(ui_mix(mk_face, 0x000000, 0.45)); mg_r(x, y, w, h);
  ui_col(mk_plate); mg_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.07); mg_r(x + 1, y + 1, w - 2, 1); mg_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, 0.22); mg_r(x + 1, y + h - 3, w - 2, 2); mg_r(x + w - 3, y + 1, 2, h - 2);
  ui_col(mk_band); mg_r(x + 1, y + 1, w - 2, 32);
  ui_cola(mk_acc, 0.55); mg_r(x + 1, y + 33, w - 2, 1);
  gfx_setfont(12); ui_col(mk_ink); mg_ltxt(x + 16, y + 17, title);
);
function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_dots(x, y, rs, big) local(i, t) (
  i = 0; loop(5, t = -0.75 * $pi + i * 0.375 * $pi; ui_col(mk_scale);
    (i == 0 || i == 4) ? mg_disc(x + sin(t) * rs, y - cos(t) * rs, big + 0.4); i += 1; );
);
function mg_mcs(x, y, rs) local(i, t) (
  gfx_setfont(11); ui_col(mk_scale); i = 0;
  loop(5, t = -0.75 * $pi + i * 0.375 * $pi;
    i == 0 || i == 2 || i == 4 ? mg_ctxt(x + sin(t) * rs, y - cos(t) * rs, i == 0 ? "M" : i == 2 ? "C" : "S") : 0;
    i += 1; );
);
function mg_desk(x, y, r, a, act, cap) local(KX, KY, KR, i) (
  KX = x * sc; KY = y * sc; KR = r * sc;
  ui_col(0x8A8C86); gfx_circle(KX, KY, KR, 1, 1);
  ui_col(0x5E605B); gfx_circle(KX, KY, KR, 0, 1);
  i = 0; loop(4, ui_cola(0x000000, 0.10 * (1 - i / 4)); gfx_circle(KX, KY, KR - i * sc, 0, 1); i += 1; );
  ui_col(act ? 0xC8C7C0 : 0xBDBCB5); gfx_circle(KX, KY, KR * 0.76, 1, 1);
  ui_cola(0x000000, 0.18); gfx_circle(KX, KY, KR * 0.76, 0, 1);
  ui_col(cap); gfx_circle(KX, KY, KR * 0.6, 1, 1);
  ui_col(ui_mix(cap, 0x000000, 0.3)); gfx_circle(KX, KY, KR * 0.6, 0, 1);
  ui_cola(0xFFFFFF, 0.28); ui_ssarc(KX, KY, KR * 0.53, -1.7, -0.2, max(1, 1.1 * sc));
  ui_col(mg_lum(cap) > 0.55 ? 0x1E1F1E : 0xF4F2EA); ui_kdot(KX, KY, a, KR * 0.6);
);
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi, lg);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(mg_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    slider(idx) = mg_n2v(n, lo, hi, lg);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  sty == 1 ? mg_mcs(cx, cy, r + 10) : mg_dots(cx, cy, r + 8, r < 20 ? 1.5 : 1.9);
  mg_cshadow(cx, cy, r);
  mg_desk(cx, cy, r, a, act, col);
  act;
);
function mg_figs(cx, cy, rs, lo, hi) (
  gfx_setfont(11); ui_col(mk_fig);
  mg_ctxt(cx - 0.7071 * rs, cy + 0.7071 * rs + 13, lo); mg_ctxt(cx + 0.7071 * rs, cy + 0.7071 * rs + 13, hi);
);
function mg_lkey(x, y, on, lc, grey) local(hov, s, b, dn, hit) (
  s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(grey ? (on ? 0x8A8C90 : 0x9C9EA2) : (on ? 0x16171A : 0x24262A)); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, grey ? 0.28 : 0.14); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, grey ? 0.35 : 0.5); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.10); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  mg_hov = hov;
  hit;
);
function mg_bkey(x, y, on, lc, name) local(w, h, hov, hit, dn, lx, ly) (
  w = 46; h = 30; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  mg_rshadow(x, y, w, h, 3);
  ui_col(0x050506); mg_rr(x - 2, y - 2, w + 4, h + 4, 4);
  ui_col(0x0C0D0E); mg_rr(x, y + dn, w, h - dn, 3);
  ui_col(hov ? 0x2E3034 : 0x26282B); mg_rr(x + 1, y + 1 + dn, w - 2, h * 0.6 - 1, 2.5);
  ui_cola(0xFFFFFF, 0.16); mg_r(x + 3, y + 1.5 + dn, w - 6, 1);
  ui_col(0x16171A); mg_r(x + 1, y + h * 0.6 + dn, w - 2, h * 0.4 - 2 - dn);
  ui_cola(0xFFFFFF, 0.10); mg_r(x + 2, y + h * 0.6 + dn, w - 4, 1);
