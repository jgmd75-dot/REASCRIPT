  y;
);
function allp(base, len, x) instance(i) local(b, y) (
  b = base[i];
  y = b - x;
  base[i] = x + b * 0.5 + DEN;
  i += 1; i >= len ? i = 0;
  y;
);

function srow(rw, str) local(i, c) (
  i = 0; loop(16, c = str_getchar(str, i); SEQ[rw * 16 + i] = c == 'X' ? 2 : c == 'x' ? 1 : 0; i += 1; );
);
function groove(g) (
  g == 0 ? ( srow(3, "x.x.x.x.x.x.x.x."); srow(4, "..X...X...X...X."); srow(5, "................"); ) :
  g == 1 ? ( srow(3, "xxx.xxx.xxx.xxx."); srow(4, "...X.......X...."); srow(5, "......x.......x."); ) :
  g == 2 ? ( srow(3, "x.xxx.xxx.xxx.xx"); srow(4, "..X.......X....."); srow(5, "...x......x....."); ) :
  g == 3 ? ( srow(3, "x.x.x.x.x.x.x.xx"); srow(4, "..X.......X....."); srow(5, "...x..x....x..x."); ) :
  g == 4 ? ( srow(3, "x.x.x.x.x.x.x.x."); srow(4, "..X...X...X...X."); srow(5, "................"); ) :
  g == 5 ? ( srow(3, "....x.......x..."); srow(4, "..X.......X....."); srow(5, ".x....x..x....x."); ) :
  g == 6 ? ( srow(3, "x...x...x...x..."); srow(4, "..X...X...X...X."); srow(5, "................"); ) :
           ( srow(3, "................"); srow(4, "................"); srow(5, "................"); );
  g == 0 ? ( srow(0, "X...X...X...X..."); srow(1, "................"); srow(2, "....X.......X..."); ) :
  g == 1 ? ( srow(0, "X...X...X...X..x"); srow(1, "..........x....."); srow(2, "....X.......X..."); ) :
  g == 2 ? ( srow(0, "X...X...X..xX..."); srow(1, "....x..x....x..."); srow(2, "....X.......X..x"); ) :
  g == 3 ? ( srow(0, "X..x..x...X....."); srow(1, "....X.......X..."); srow(2, "................"); ) :
  g == 4 ? ( srow(0, "X...X...X...X..."); srow(1, "....X.......X.x."); srow(2, "....X.......X..."); ) :
  g == 5 ? ( srow(0, "X.....x...X....."); srow(1, "........X......."); srow(2, "....x.......x..."); ) :
  g == 6 ? ( srow(0, "X...X...X...X..."); srow(1, "..x...x...x...x."); srow(2, "....X..x....X..."); ) :
           ( srow(0, "................"); srow(1, "................"); srow(2, "................"); );
);

function kk(a, b, c, d, e, f, g) ( slider1 = a; slider2 = b; slider3 = c; slider4 = d; slider5 = e * 100; slider6 = f; slider7 = g; );
function ks(a, b, c, d, e, f, g, h) ( slider8 = a; slider9 = b; slider10 = c; slider11 = d; slider12 = e; slider13 = f; slider14 = g; slider15 = h;
  slider58 = a; slider59 = e; slider60 = c; slider61 = g; );
function kc(on, t, rt, a, rl, mk) ( slider16 = on; slider17 = t; slider18 = rt; slider19 = a; slider20 = rl; slider21 = mk; );
function ke(on, lf, lg, mf, mq, mg, hq, hg) ( slider22 = on; slider23 = lf; slider24 = lg; slider25 = mf; slider26 = mq; slider27 = mg; slider28 = hq; slider29 = hg; );
function kt(on, d, ty, mx) ( slider30 = on; slider31 = d; slider32 = ty; slider33 = mx; );
function krv(sz, dm, dc, lc, wt) ( slider35 = sz * 100; slider36 = dm; slider37 = dc * 100; slider38 = lc; slider39 = wt; );
function kh(tn, tone, cd, od, nz, hl, rp, rd, rl) (
  slider45 = tn; slider46 = tone; slider47 = cd; slider48 = od; slider49 = nz; slider50 = hl; slider51 = rp; slider52 = rd; slider53 = rl;
  slider62 = tn; slider63 = tone; slider64 = hl;
