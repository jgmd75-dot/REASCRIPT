) : ( t_dxL = t_dxR = t_dyL = t_dyR = 0; );

pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;

r_m += (r_on_t - r_m) * dp_sw;
r_fb += (r_fb_t - r_fb) * dp_gl; r_damp += (r_damp_t - r_damp) * dp_gl; r_hpc += (r_hpc_t - r_hpc) * dp_gl;
r_wet += (r_wet_t - r_wet) * dp_gl;
r_sct != r_sc ? ( r_dkt = 0; r_dk < 0.0005 ? ( r_sc = r_sct; rv_len(); memset(CMB, 0, 8 * CMS); memset(APB, 0, 4 * APS); r_dkt = 1; ); );
r_dk += (r_dkt - r_dk) * dp_dkc;
r_m > 0.00001 ? (
  rin = (oL + oR) * 0.015;
