desc:Deep 16 Mini [house drum machine] (GFX Lab)
//tags: instrument drum machine synth kick snare clap deep house sequencer mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-drift, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider57:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:48<30,120,0.1>-Kick base pitch (Hz)
slider2:180<0,600,1>-Kick pitch drop depth (Hz)
slider3:35<2,200,0.1>-Kick pitch decay (ms)
slider4:420<50,2000,1>-Kick amp decay (ms)
slider5:35<0,100,1>-Kick click level (%)
slider6:25<0,100,1>-Kick sub tone drive (%)
slider7:0<-24,6,0.1>-Kick level (dB)
slider8:185<100,400,0.1>-Snare tone pitch (Hz)
slider9:80<10,500,1>-Snare / clap tone decay (ms)
slider10:2200<500,10000,1>-Snare noise cutoff (Hz)
slider11:1.2<0.5,8,0.01>-Snare / clap noise resonance (Q)
slider12:210<20,800,1>-Snare noise decay (ms)
slider13:12<0,30,0.1>-Snare / clap stereo micro-delay / width (ms)
slider14:-3<-24,6,0.1>-Snare level (dB)
slider15:40<0,100,1>-Snare / clap tone / noise mix (% tone)
slider16:1<0,1,1{Off,On}>-Comp on
slider17:-14<-40,0,0.1>-Comp threshold (dB)
slider18:4<1,20,0.1>-Comp ratio (x:1)
slider19:8<0.1,100,0.1>-Comp attack (ms)
slider20:120<10,1000,1>-Comp release (ms)
slider21:0.3<-12,24,0.1>-Comp makeup gain (dB)
slider22:1<0,1,1{Off,On}>-EQ on
slider23:80<30,300,1>-EQ low shelf freq (Hz)
slider24:2<-15,15,0.1>-EQ low shelf gain (dB)
slider25:500<150,5000,1>-EQ mid bell freq (Hz)
slider26:1<0.3,6,0.01>-EQ mid bell Q
slider27:-2<-15,15,0.1>-EQ mid bell gain (dB)
slider28:10000<2000,16000,10>-EQ high shelf freq (Hz)
slider29:2<-15,15,0.1>-EQ high shelf gain (dB)
slider30:1<0,1,1{Off,On}>-Saturation on
slider31:6<0,24,0.1>-Saturation drive (dB)
slider32:0<0,2,1{Tape,Tube,Soft-Clip}>-Saturation type
slider33:50<0,100,1>-Saturation dry / wet (%)
slider35:35<0,100,1>-Reverb room size (%)
slider36:5000<1000,12000,10>-Reverb damping cutoff (Hz)
slider37:45<0,100,1>-Reverb decay (%)
slider38:250<50,1000,1>-Reverb low-cut (Hz)
slider39:-18<-60,0,0.1>-Reverb level (dB, -60 = off)
slider40:0<-24,12,0.1>-Volume (dB)
slider41:0<0,16,1>-MIDI channel (0 = omni)
slider42:0<0,1,1{Off,On}>-Follow transport
slider43:0<0,75,1>-Swing (%)
slider45:0<-12,12,0.1>-Closed hat tune (st)
slider46:9000<3000,16000,10>-Closed hat tone (Hz)
slider47:45<10,300,1>-Closed hat decay (ms)
slider48:380<50,2000,1>-Open hat decay (ms)
slider49:35<0,100,1>-Hat noise, both hats (% noise vs metal)
slider50:-9<-30,6,0.1>-Closed hat level (dB)
slider51:1700<600,3500,1>-Rim pitch (Hz)
slider52:25<5,120,1>-Rim decay (ms)
slider53:-8<-30,6,0.1>-Rim level (dB)
slider54:50<0,100,1>-Drift (%)
slider55:100<0,200,1>-Width (%)
slider58:185<100,400,0.1>-Clap tone pitch (Hz)
slider59:210<20,800,1>-Clap noise decay (ms)
slider60:2200<500,10000,1>-Clap noise cutoff (Hz)
slider61:-3<-24,6,0.1>-Clap level (dB)
slider62:0<-12,12,0.1>-Open hat tune (st)
slider63:9000<3000,16000,10>-Open hat tone (Hz)
slider64:-9<-30,6,0.1>-Open hat level (dB)
slider56:prs_sel=0<0,8,1{No preset,Deep Classic,Dusty Warehouse,Tight Tech,Lo-Fi Dub,Big Room Clap,Soulful Warm,Minimal Click,Init (dry)}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4494794944413695, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider61, v); slider_show(slider62, v); slider_show(slider63, v); slider_show(slider64, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4494794944413695, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider61, v); slider_show(slider62, v); slider_show(slider63, v); slider_show(slider64, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-deep-16-mini";
ext_noinit = 1;

SEQ = 1000;
MQO = 2000; MQN = 2300; MQV = 2600;
SDL = 10000;  SDS = 8192;
CMB = 20000;  CMS = 8192;
APB = 90000;  APS = 4096;
memset(SDL, 0, SDS); memset(CMB, 0, 8 * CMS); memset(APB, 0, 4 * APS);
DEN = 0.00000000000000000001;

function dbg(db) ( 10 ^ (db / 20); );
function coef(ms) ( exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );
function dcoef(ms) ( coef(ms / 4.6); );
function tanh_(x) ( x = min(max(x, -12), 12); x = exp(2 * x); (x - 1) / (x + 1); );

function bq_set(kind, f, q, gdb) instance(b0, b1, b2, a1, a2) local(A, w, cw, sw, al, a0, sA) (
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); sw = sin(w);
  kind == 1 ? (
    al = sw / (2 * q);
    a0 = 1 + al / A;
    b0 = (1 + al * A) / a0; b1 = -2 * cw / a0; b2 = (1 - al * A) / a0;
    a1 = -2 * cw / a0; a2 = (1 - al / A) / a0;
  ) : (
    al = sw / 2 * sqrt(2); sA = 2 * sqrt(A) * al;
    kind == 0 ? (
      a0 = (A + 1) + (A - 1) * cw + sA;
      b0 = A * ((A + 1) - (A - 1) * cw + sA) / a0; b1 = 2 * A * ((A - 1) - (A + 1) * cw) / a0;
      b2 = A * ((A + 1) - (A - 1) * cw - sA) / a0;
      a1 = -2 * ((A - 1) + (A + 1) * cw) / a0; a2 = ((A + 1) + (A - 1) * cw - sA) / a0;
    ) : (
      a0 = (A + 1) - (A - 1) * cw + sA;
      b0 = A * ((A + 1) + (A - 1) * cw + sA) / a0; b1 = -2 * A * ((A - 1) + (A + 1) * cw) / a0;
      b2 = A * ((A + 1) + (A - 1) * cw - sA) / a0;
      a1 = 2 * ((A - 1) - (A + 1) * cw) / a0; a2 = ((A + 1) - (A - 1) * cw - sA) / a0;
    );
  );
);
function bq_copy(src*) instance(b0, b1, b2, a1, a2) ( b0 = src.b0; b1 = src.b1; b2 = src.b2; a1 = src.a1; a2 = src.a2; );
function bq_run(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1;
  z1 = b1 * x - a1 * y + z2 + DEN;
  z2 = b2 * x - a2 * y - DEN;
  y;
);

function svf_set(f, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(f, srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf_bpx(x) instance(a1, a2, a3, ic1, ic2, k, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1 + DEN; ic2 = 2 * v2 - ic2 - DEN;
  hp = x - k * v1 - v2;
  v1;
);

function dp_srinit() (
  dp_sr = srate; dp_pis = $pi / srate; dp_isr = 1 / srate;
  dp_pn = max(floor(0.001 * srate), 1); dp_pg = 1 / dp_pn;
  dp_rn = max(floor(0.00012 * srate), 1); dp_rg = 1 / dp_rn;
  dp_pc = 1 - exp(-1 / (0.0001 * srate));
  dp_kd = 0.5 ^ (1 / dp_pn);
  dp_scc = 1 - exp(-1 / (0.0002 * srate));
  dp_hc = exp(-2 * $pi * 1000 / srate);
  dp_chk = coef(2.9);
  dp_acr = 1 - exp(-1 / (0.05 * srate));
  dp_ta = 1 - exp(-1 / (0.004 * srate));
);
function dp_e(x) ( x > 1.2 ? x = 1.2; x * (2 - x * x * (0.33333333 - x * x * 0.016666667)); );
function dp_snc(f) local(x) ( x = min(f * dp_pis * dp_pn, 2.5); x / sin(x + 0.0000001) + 0.0000001; );
function dp_acc(vel) local(ak) (
  ak = min(max(vel - 0.8, 0) * 5, 1);
  dp_seq ? ak * dp_alv : ( ak > 0 ? ( ak *= dp_ab; dp_ab = max(dp_ab - 0.04 * ak, 0.6); ); ak; );
);
function dp_sF(v) ( v = abs(v); v >= 1.5 ? v - 0.5625 : v * v * (0.5 - v * v * 0.037037037); );
function dp_sat(x) instance(x1) local(y, m) (
  abs(x) <= 1.5 && abs(x1) <= 1.5 ? y = (x + x1) * (0.5 - (x * x + x1 * x1) * 0.037037037) :
  abs(x - x1) > 0.00001 ? y = (dp_sF(x) - dp_sF(x1)) / (x - x1) :
  ( m = 0.5 * (x + x1); y = m >= 1.5 ? 1 : m <= -1.5 ? -1 : m - m * m * m * 0.148148148; );
  x1 = x;
  y;
);
function dp_sqb(p, d, ni) local(t) (
  p < 0.5 ? (
    p < d ? ( t = p * ni; t + t - t * t; ) : p > 0.5 - d ? ( t = (p - 0.5) * ni; 1 - t * t - t - t - 1; ) : 1;
  ) : (
    p < 0.5 + d ? ( t = (p - 0.5) * ni; t * t - t - t; ) : p > 1 - d ? ( t = (p - 1) * ni; t * t + t + t; ) : -1;
  );
);

function dp_spread(st, sd, dv, ak, vel) (
  dp_tf = 1 + dm_a * (0.006 * st - 0.005 * dp_wrm + 0.002 * dv + 0.0007 * (rand(2) - 1));
  dp_df = (1 + dm_a * (0.05 * sd + 0.02 * (rand(2) - 1))) * (1 + 0.025 * ak);
  dp_am = vel * (1 + dm_a * 0.02 * (rand(2) - 1));
);
function kick_trig(vel) local(ak, p) (
  ak = dp_acc(vel); dp_spread(0.31, 0.2, dvk.v, ak, vel);
  kq_tf = dp_tf;
  kq_r = dcoef(slider4 * (0.6 + 0.4 * vel) * dp_df);
  kq_st = (0.85 + 0.2 * vel) * (1 + 0.35 * ak);
  kq_sc = coef(slider3 * (1 + 0.3 * ak));
  kq_dg = slider6 * 0.042 * (1 + 0.3 * ak);
  kq_gn = dp_km * exp(0.0013816 * slider6) * (1 + 0.045 * ak);
  kq_gi = 1 / (1.63 + kq_dg * 0.35);
  p = dp_snc((slider1 + 0.7 * slider2 * kq_st) * kq_tf) * 1.386;
  kq_cl = (slider5 * 0.01) * 2.6 * (1 + 0.3 * ak) / p;
  p *= dp_am; kq_pn > 0 ? kq_pa = max(kq_pa, p) : kq_pa = p; kq_pn = dp_pn;
  kq_on = 1;
);
dp_km = 1.087;
function snare_trig(vel) local(ak, j) (
  ak = dp_acc(vel); dp_spread(-0.62, 0.7, dvs.v, ak, vel);
  sq_tf = dp_tf; sq_r1 = dcoef(slider9 * dp_df); sq_r2 = dcoef(slider9 * 0.75 * dp_df);
  sq_st = 1.4 * (0.8 + 0.25 * vel) * (1 + 0.3 * ak); sq_sc = coef(7 * (1 + 0.3 * ak));
  j = dp_am * dp_snc(slider8 * (1 + 0.7 * sq_st) * sq_tf);
  sq_pn > 0 ? sq_pa = max(sq_pa, j) : sq_pa = j; sq_pn = dp_pn;
  sq_cl = 0.3 * (1 + ak);
  s_nc = dcoef(slider12 * dp_df * (1 + 0.06 * ak));
  s_nb = 0.1 * ak + 0.2 * (vel - 0.72);
  s_ng = dp_tn / (1 + s_nb);
  s_be = max(s_be, dp_am); s_bc = s_nc;
  s_on = 1;
);
function clap_trig(vel) local(ak, j) (
  ak = dp_acc(vel); dp_spread(-0.62, 0.7, dvs.v, ak, vel);
  cq_tf = dp_tf; cq_r1 = dcoef(slider9 * dp_df); cq_r2 = dcoef(slider9 * 0.75 * dp_df);
  cq_st = 1.4 * (0.8 + 0.25 * vel) * (1 + 0.3 * ak); cq_sc = coef(7 * (1 + 0.3 * ak));
  j = dp_am * 0.25 * dp_snc(slider58 * (1 + 0.7 * cq_st) * cq_tf);
  cq_pn > 0 ? cq_pa = max(cq_pa, j) : cq_pa = j; cq_pn = dp_pn;
  cl_nc = dcoef(slider59 * dp_df * (1 + 0.06 * ak));
  cl_nb = 0.1 * ak + 0.2 * (vel - 0.72);
  cl_ng = dp_tn / (1 + cl_nb);
  cl_clap = 1; cl_t = 0;
  j = 0.0004 * dm_a * srate;
  cl_b2 = floor(0.0102 * srate + j * (rand(2) - 1)); cl_b3 = floor(0.0211 * srate + j * (rand(2) - 1));
  cl_b4 = floor(0.0313 * srate + j * (rand(2) - 1));
  cl_ba = dp_am; cl_be = max(cl_be, cl_ba); cl_bc = coef(3.5 / (1 + 0.3 * ak)); cl_tv = dp_am * 0.9 * dp_tc / (1 + 0.3 * cl_nb);
  cl_on = 1;
);
function hb_set(t) instance(d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  d1 = 205.3 * t * (1 + 0.0021 * dm_a); d2 = 304.4 * t * (1 - 0.0034 * dm_a); d3 = 369.6 * t * (1 + 0.0015 * dm_a);
  d4 = 522.7 * t * (1 - 0.0011 * dm_a); d5 = 540 * t * (1 + 0.0029 * dm_a);   d6 = 800 * t * (1 - 0.0024 * dm_a);
  n1 = 1 / d1; n2 = 1 / d2; n3 = 1 / d3; n4 = 1 / d4; n5 = 1 / d5; n6 = 1 / d6;
);
function hb_run() instance(p1, p2, p3, p4, p5, p6, d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  p1 += d1; p1 >= 1 ? p1 -= 1; p2 += d2; p2 >= 1 ? p2 -= 1; p3 += d3; p3 >= 1 ? p3 -= 1;
  p4 += d4; p4 >= 1 ? p4 -= 1; p5 += d5; p5 >= 1 ? p5 -= 1; p6 += d6; p6 >= 1 ? p6 -= 1;
  (dp_sqb(p1, d1, n1) + dp_sqb(p2, d2, n2) + dp_sqb(p3, d3, n3) + dp_sqb(p4, d4, n4)
      + dp_sqb(p5, d5, n5) + dp_sqb(p6, d6, n6)) * 0.16666667;
);
function hat_trig(vel, open) local(ak, t) (
  ak = dp_acc(vel); dp_spread(0.47, -0.6, dvh.v, ak, vel);
  t = 2 ^ ((open ? slider62 : slider45) / 12) * dp_tf * dp_isr;
  open ? hbo.hb_set(t) : hbc.hb_set(t);
  t = 0.6 + 0.15 * vel + 0.12 * ak;
  open ? ( h_oe = max(h_oe, dp_am / (0.3 + t)); h_odk = dcoef(slider48 * dp_df); h_hmo = t; ho_on = 1; ) :
         ( h_ce = max(h_ce, dp_am / (0.3 + t)); h_cdq = dcoef(slider47 * dp_df); h_hmc = t; h_odk = min(h_odk, dp_chk); h_on = 1; );
);
function rim_trig(vel) local(ak, p) (
  ak = dp_acc(vel); dp_spread(0.66, -0.8, dvr.v, ak, vel);
  rm_tf = dp_tf; rm_r1 = dcoef(slider52 * dp_df); rm_r2 = dcoef(slider52 * 0.8 * dp_df);
  rm_st = 0.03 + 0.05 * ak; rm_sc = coef(3);
  rm_cl = 2 * (1 + 0.25 * ak);
  p = slider51 * rm_tf * 0.00062832;
  p = dp_am * sqrt(sqrt(1 + p * p));
  rm_pn > 0 ? rm_pa = max(rm_pa, p) : rm_pa = p; rm_pn = dp_rn;
  rim_on = 1;
);

LTM = 3000;
memset(LTM, 0, 8);

function update() (
  k_base = slider1; k_drop = slider2; k_lvl_t = dbg(slider7);
  s_f = slider8;
  s_lvl_t = dbg(slider14); s_tmix_t = slider15 / 100;
  s_dly_t = min(max(slider13, 0) * 0.001 * srate, SDS - 2);
  sn_ft = slider10; sn_qt = slider11;
  c_on_t = slider16 >= 0.5; c_thr_t = slider17; c_slope_t = 1 - 1 / max(slider18, 1);
  c_att = coef(slider19); c_rel = coef(slider20); c_mk_t = dbg(slider21);
  q_on_t = slider22 >= 0.5;
  e_t1 = slider23; e_t2 = slider24; e_t3 = slider25; e_t4 = slider26; e_t5 = slider27; e_t6 = slider28; e_t7 = slider29;
  t_on_t = slider30 >= 0.5; t_g_t = dbg(slider31); t_ty = max(0, min(2, slider32 | 0)); t_mix_t = slider33 / 100;
  r_on_t = slider39 > -59.9;
  r_sct = (0.35 + 0.65 * (slider35 * 0.01)) * srate / 44100;
  r_fb_t = 0.7 + 0.28 * (slider37 * 0.01);
  r_damp_t = exp(-2 * $pi * slider36 / srate);
  r_hpc_t = exp(-2 * $pi * slider38 / srate);
  r_wet_t = dbg(slider39);
  m_vol_t = dbg(slider40);
  chan = slider41;
  sq_swing = slider43 / 100 * 0.5;
  h_ft = slider46;
  h_nz_t = slider49 / 100; h_lvl_t = dbg(slider50);
  r_lvl_t = dbg(slider53);
  cl_f = slider58; cl_ft = slider60; cl_lvl_t = dbg(slider61);
  ho_ft = slider63; ho_lvl_t = dbg(slider64);
  w_t = slider55 / 100;
);

function rv_len() (
  rc0 = floor(1116 * r_sc); rc1 = floor(1188 * r_sc); rc2 = floor(1277 * r_sc); rc3 = floor(1356 * r_sc);
  rc4 = floor((1116 + 23) * r_sc); rc5 = floor((1188 + 23) * r_sc); rc6 = floor((1277 + 23) * r_sc); rc7 = floor((1356 + 23) * r_sc);
  ra0 = floor(556 * srate / 44100); ra1 = floor(441 * srate / 44100);
  ra2 = floor((556 + 23) * srate / 44100); ra3 = floor((441 + 23) * srate / 44100);
  c0.i = c1.i = c2.i = c3.i = c4.i = c5.i = c6.i = c7.i = 0;
  ap0.i = ap1.i = ap2.i = ap3.i = 0;
);

function dp_filt() (
  eqLS_L.bq_set(0, e_s1, 0.707, e_s2); eqLS_R.bq_copy(eqLS_L);
  eqPK_L.bq_set(1, e_s3, e_s4, e_s5); eqPK_R.bq_copy(eqPK_L);
  eqHS_L.bq_set(2, e_s6, 0.707, e_s7); eqHS_R.bq_copy(eqHS_L);
);
function dp_ctl() local(d) (
  d = abs(e_t1 - e_s1) + abs(e_t2 - e_s2) + abs(e_t3 - e_s3) + abs(e_t4 - e_s4) + abs(e_t5 - e_s5) + abs(e_t6 - e_s6) + abs(e_t7 - e_s7);
  d > 0.001 ? (
    e_s1 += (e_t1 - e_s1) * dp_cg; e_s2 += (e_t2 - e_s2) * dp_cg; e_s3 += (e_t3 - e_s3) * dp_cg; e_s4 += (e_t4 - e_s4) * dp_cg;
    e_s5 += (e_t5 - e_s5) * dp_cg; e_s6 += (e_t6 - e_s6) * dp_cg; e_s7 += (e_t7 - e_s7) * dp_cg;
    dp_filt();
  );
  abs(sn_ft - sn_fs) + abs(sn_qt - sn_qs) > 0.01 ? (
    sn_fs += (sn_ft - sn_fs) * dp_cg; sn_qs += (sn_qt - sn_qs) * dp_cg; snF.svf_set(sn_fs, sn_qs);
  );
  abs(cl_ft - cl_fs) + abs(sn_qs - cl_qs) > 0.01 ? ( cl_fs += (cl_ft - cl_fs) * dp_cg; cl_qs = sn_qs; clF.svf_set(cl_fs, cl_qs); );
  abs(h_ft - h_fs) > 0.1 ? ( h_fs += (h_ft - h_fs) * dp_cg; hF.svf_set(h_fs, 1.1); );
  abs(ho_ft - ho_fs) > 0.1 ? ( ho_fs += (ho_ft - ho_fs) * dp_cg; hoF.svf_set(ho_fs, 1.1); );
);
function dp_snap() (
  k_lvl = k_lvl_t; s_lvl = s_lvl_t; s_tmix = s_tmix_t; sd_s = s_dly_t;
  sn_fs = sn_ft; sn_qs = sn_qt; snF.svf_set(sn_fs, sn_qs);
  cl_fs = cl_ft; cl_qs = sn_qt; clF.svf_set(cl_fs, cl_qs);
  h_fs = h_ft; hF.svf_set(h_fs, 1.1);
  ho_fs = ho_ft; hoF.svf_set(ho_fs, 1.1);
  c_m = c_on_t; c_thr = c_thr_t; c_slope = c_slope_t; c_mk = c_mk_t;
  q_m = q_on_t;
  e_s1 = e_t1; e_s2 = e_t2; e_s3 = e_t3; e_s4 = e_t4; e_s5 = e_t5; e_s6 = e_t6; e_s7 = e_t7; dp_filt();
