  rl = c0.comb(CMB, rc0, rx) + c1.comb(CMB + CMS, rc1, rx) + c2.comb(CMB + 2 * CMS, rc2, rx) + c3.comb(CMB + 3 * CMS, rc3, rx);
  rr = c4.comb(CMB + 4 * CMS, rc4, rx) + c5.comb(CMB + 5 * CMS, rc5, rx) + c6.comb(CMB + 6 * CMS, rc6, rx) + c7.comb(CMB + 7 * CMS, rc7, rx);
