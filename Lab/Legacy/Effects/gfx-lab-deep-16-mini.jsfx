  r_sc = r_sct; rv_len(); r_dk = r_dkt = 1;
  m_vol = m_vol_t; h_nz = h_nz_t; h_lvl = h_lvl_t; r_lvl = r_lvl_t; w_s = w_t; cl_lvl = cl_lvl_t; ho_lvl = ho_lvl_t;
);

function comb(base, len, x) instance(i, f) local(y) (
  y = base[i];
