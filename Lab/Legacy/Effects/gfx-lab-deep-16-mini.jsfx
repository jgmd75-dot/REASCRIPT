function load_kit(p) local(i) (
  p == 0 ? kh(0, 9000, 45, 380, 35, -9, 1700, 25, -8) :
  p == 1 ? kh(-2, 7000, 60, 520, 55, -10, 1400, 35, -9) :
  p == 2 ? kh(1, 11000, 30, 260, 25, -9, 2000, 18, -8) :
  p == 3 ? kh(-3, 5500, 70, 650, 65, -11, 1200, 40, -9) :
  p == 4 ? kh(0, 9500, 40, 420, 30, -9, 1800, 22, -8) :
  p == 5 ? kh(-1, 8000, 55, 480, 45, -10, 1600, 30, -8) :
  p == 6 ? kh(2, 12500, 25, 220, 20, -10, 2300, 15, -8) :
           kh(0, 9000, 45, 380, 35, -9, 1700, 25, -8);
  p == 0 ? ( kk(48, 180, 35, 420, 0.35, 25, 0);  ks(185, 80, 2200, 1.2, 210, 12, -3, 40);  kc(1, -14, 4, 8, 120, 0.3);
             ke(1, 80, 2, 500, 1, -2, 10000, 2);  kt(1, 6, 0, 50);  krv(0.35, 5000, 0.45, 250, -18); ) :
  p == 1 ? ( kk(45, 140, 45, 520, 0.2, 40, 0);   ks(170, 110, 1600, 0.9, 260, 15, -4, 30); kc(1, -16, 3, 15, 180, 0.6);
             ke(1, 70, 3, 350, 0.8, -3, 8000, -2); kt(1, 10, 1, 60); krv(0.5, 3500, 0.55, 300, -16); ) :
  p == 2 ? ( kk(52, 240, 22, 300, 0.5, 15, 0);   ks(200, 60, 3200, 1.6, 150, 8, -3, 45);   kc(1, -12, 6, 3, 80, -1.2);
             ke(1, 90, 1, 800, 1.2, -3, 11000, 3); kt(1, 4, 2, 40);  krv(0.2, 7000, 0.3, 350, -22); ) :
  p == 3 ? ( kk(42, 120, 60, 800, 0.15, 55, 0);  ks(160, 140, 1200, 0.8, 320, 18, -5, 25); kc(1, -18, 2.5, 20, 250, -2.4);
             ke(1, 60, 4, 300, 0.7, -2, 7000, -4); kt(1, 14, 0, 70); krv(0.6, 2600, 0.6, 200, -14); ) :
  p == 4 ? ( kk(50, 200, 30, 380, 0.3, 20, 0);   ks(190, 50, 2600, 1.1, 280, 22, -2, 15);  kc(1, -14, 4, 6, 140, -1.2);
             ke(1, 85, 2, 1200, 1, 2, 12000, 3); kt(1, 5, 0, 40);  krv(0.55, 6000, 0.55, 300, -14); ) :
  p == 5 ? ( kk(46, 160, 40, 600, 0.25, 30, 0);  ks(180, 90, 1900, 1, 230, 10, -4, 35);    kc(1, -15, 3, 10, 150, 1.3);
             ke(1, 75, 2.5, 450, 0.9, -1.5, 9000, 1); kt(1, 7, 1, 45); krv(0.4, 4200, 0.5, 260, -18); ) :
  p == 6 ? ( kk(55, 300, 18, 260, 0.6, 10, 0);   ks(220, 45, 4200, 2, 120, 5, -3, 50);     kc(1, -10, 8, 1, 60, -2.2);
             ke(1, 100, 0, 1500, 1.4, -2, 12000, 4); kt(1, 3, 2, 30); krv(0.15, 8000, 0.25, 400, -26); ) :
           ( kk(48, 180, 35, 420, 0.35, 25, -2);  ks(185, 80, 2200, 1.2, 210, 12, -5, 40);  kc(0, -14, 4, 8, 120, 3);
             ke(0, 80, 0, 500, 1, 0, 10000, 0);  kt(0, 6, 0, 50);  krv(0.35, 5000, 0.45, 250, -60); );
  i = 1; loop(39, i != 34 ? slider_automate(2 ^ (i - 1)); i += 1; );
  i = 45; loop(9, slider_automate(2 ^ (i - 1)); i += 1; );
  i = 58; loop(6, slider_automate(2 ^ (i - 1)); i += 1; ); slider_automate(slider64);
  cur_kit = p; update();
);
function load_preset(p) (
  load_kit(p - 1);
  p == 1 ? groove(0) : p == 2 ? groove(1) : p == 3 ? groove(2) : p == 4 ? groove(5) :
  p == 5 ? groove(4) : p == 6 ? groove(6) : p == 7 ? groove(3) : 0;
);

!init_done ? ( groove(0); cur_kit = 0; init_done = 1; );
kq_on = 0; kq_pn = kq_pa = kq_ps = kq_sw = kq_u = kq_v = kq_cy = kq_ch = 0; kq_c.x1 = 0;
s_on = 0; sq_pn = sq_pa = sq_ps = sq_sw = sq_u1 = sq_v1 = sq_u2 = sq_v2 = sq_cy = sq_ch = 0; s_be = s_te = s_tt = 0; s_clap = 0;
cl_on = 0; cq_pn = cq_pa = cq_ps = cq_sw = cq_u1 = cq_v1 = cq_u2 = cq_v2 = 0; cl_be = cl_te = cl_tt = 0; cl_clap = 0;
h_on = ho_on = 0; h_ce = h_oe = 0; h_odk = 0; h_cdq = 0;
rim_on = 0; rm_pn = rm_pa = rm_ps = rm_sw = rm_u1 = rm_v1 = rm_u2 = rm_v2 = rm_cy = rm_ch = 0;
dp_tk = 1; dp_tb = 1.02; dp_tn = 0.995; dp_tc = 1; dp_th = 1.035; dp_tr = 1.14;
dp_srinit();
dp_gl = 1 - exp(-1 / (0.03 * srate)); dp_sw = 1 - exp(-1 / (0.012 * srate)); dp_cg = 1 - exp(-32 / (0.03 * srate));
dp_dkc = 1 - exp(-1 / (0.006 * srate));
dp_ab = 1; dp_alv = 1; dp_seq = 0;
!dp_wi ? ( dp_wi = 1; dp_wrm = 1; dvk.drift_init(0.8 + rand(1) * 0.5); dvs.drift_init(0.8 + rand(1) * 0.5); dvh.drift_init(0.8 + rand(1) * 0.5); dvr.drift_init(0.8 + rand(1) * 0.5); );
drift_macro(slider54); dp_dm = slider54;
function dp_block() local(t) (
  srate !== dp_sr ? dp_srinit();
  slider54 !== dp_dm ? ( dp_dm = slider54; drift_macro(slider54); );
  dm_a > 0 ? (
    dp_wrm *= exp(-samplesblock / (90 * srate)); t = samplesblock * 0.05 * dm_s / srate;
    dvk.drift_tick(t); dvs.drift_tick(t); dvh.drift_tick(t); dvr.drift_tick(t);
  );
);
c_env = 0; c_gr = 0; sdw = 0; r_hl = 0; t_dxL = t_dxR = t_dyL = t_dyR = 0;
lastkey = -1; cur_step = -1; run = 0; fr_beat = 0; dp_ck = 0;
function gap_clear() (
  kq_on = 0; kq_pn = kq_pa = kq_ps = kq_sw = kq_u = kq_v = kq_cy = kq_ch = 0; kq_c.x1 = 0;
  s_on = 0; sq_pn = sq_pa = sq_ps = sq_sw = sq_u1 = sq_v1 = sq_u2 = sq_v2 = sq_cy = sq_ch = 0; s_be = s_te = s_tt = 0; s_clap = 0;
  cl_on = 0; cq_pn = cq_pa = cq_ps = cq_sw = cq_u1 = cq_v1 = cq_u2 = cq_v2 = 0; cl_be = cl_te = cl_tt = 0; cl_clap = 0;
  h_on = ho_on = 0; h_ce = h_oe = 0;
  rim_on = 0; rm_pn = rm_pa = rm_ps = rm_sw = rm_u1 = rm_v1 = rm_u2 = rm_v2 = rm_cy = rm_ch = 0;
  snF.ic1 = snF.ic2 = hF.ic1 = hF.ic2 = clF.ic1 = clF.ic2 = hoF.ic1 = hoF.ic2 = 0; memset(SDL, 0, SDS);
  c_gr = 0; t_dxL = t_dxR = t_dyL = t_dyR = 0; r_hl = 0;
  eqLS_L.z1 = eqLS_L.z2 = eqPK_L.z1 = eqPK_L.z2 = eqHS_L.z1 = eqHS_L.z2 = 0;
  eqLS_R.z1 = eqLS_R.z2 = eqPK_R.z1 = eqPK_R.z2 = eqHS_R.z1 = eqHS_R.z2 = 0;
  memset(CMB, 0, 8 * CMS); memset(APB, 0, 4 * APS);
  c0.f = c1.f = c2.f = c3.f = c4.f = c5.f = c6.f = c7.f = 0;
);
update();
dp_snap();
ost_init(0);
ost_setup(0, 0, 200, 4000, -0.3, 1);
pwr_init(); pwr_hum_db = -85; pwr_sag = 0.1; pwr_wu_loss = 0.3; pwr_wu_drv = 0.6; pwr_wu_lp = 14000; pwr_wu_wob = 0.1; pwr_bloom = 0;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; dv_sel = 0; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(55, h += slider(i) * (1 + i * 0.7071); i += 1; ); i = 58; loop(7, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, rr) ( h = prs_hash(); rr = h == prs_h0; prs_h0 = h; rr; );
function prs_chk() local(k) (
  kit_dirty > 0 ? (
    k = kit_dirty; kit_dirty = 0; load_kit(k - 1);
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  );
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; k = k > 8 ? 1 : k; load_preset(k);
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0; kit_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, SEQ, 96);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
prs_chk();
grv_dirty > 0 ? ( groove(grv_dirty - 1); grv_dirty = 0; );
update();
dp_block();
pwr_block(1);
evn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  (m1 & 0xF0) == 0x90 && m3 > 0 && (chan == 0 || (m1 & 0x0F) + 1 == chan) && evn < 256 ? (
    MQO[evn] = mofs; MQN[evn] = m2; MQV[evn] = m3 / 127; evn += 1; dm_mt = time_precise();
  );
  midisend(mofs, m1, m2, m3);
);
evi = 0; spos = 0;
run_t = slider42 >= 0.5 ? (play_state & 1) : run_rq_d;
run_t != run ? ( run = run_t; lastkey = -1; fr_beat = 0; );
fol = slider42 >= 0.5;
bp0 = beat_position; bps = tempo / 60 / srate;
!run ? ( lastkey = -1; cur_step = -1; );
aud_dirty > 0 ? (
  aud_dirty == 1 ? kick_trig(0.9) : aud_dirty == 2 ? snare_trig(0.9) : aud_dirty == 3 ? clap_trig(0.9) :
  aud_dirty == 4 ? hat_trig(0.9, 0) : aud_dirty == 5 ? hat_trig(0.9, 1) : rim_trig(0.9);
  LTM[aud_dirty - 1] = 1;
  aud_dirty = 0;
);
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@sample
while (evi < evn && (MQO[evi] <= spos || spos >= samplesblock - 1)) (
  MQN[evi] == 36 ? ( kick_trig(MQV[evi]); LTM[0] = 1; ) :
  MQN[evi] == 38 ? ( snare_trig(MQV[evi]); LTM[1] = 1; ) :
  MQN[evi] == 40 || MQN[evi] == 39 ? ( clap_trig(MQV[evi]); LTM[2] = 1; ) :
  MQN[evi] == 42 || MQN[evi] == 44 ? ( hat_trig(MQV[evi], 0); LTM[3] = 1; ) :
  MQN[evi] == 46 ? ( hat_trig(MQV[evi], 1); LTM[4] = 1; ) :
  MQN[evi] == 37 ? ( rim_trig(MQV[evi]); LTM[5] = 1; );
  evi += 1;
);
run ? (
  sbeat = fol ? bp0 + spos * bps : fr_beat;
  !fol ? fr_beat += bps;
  sbeat >= 0 ? (
    sbar = floor(sbeat / 4); sfs = (sbeat - sbar * 4) * 4;
    sst = floor(sfs); sfr = sfs - sst;
    s_eff = (sst & 1) && sfr < sq_swing ? sst - 1 : sst;
    skey = sbar * 32 + s_eff;
    skey != lastkey ? (
      lastkey = skey; cur_step = s_eff;
      dp_n = (SEQ[s_eff] == 2) + (SEQ[16 + s_eff] == 2) + (SEQ[32 + s_eff] == 2) + (SEQ[48 + s_eff] == 2) + (SEQ[64 + s_eff] == 2) + (SEQ[80 + s_eff] == 2);
      dp_alv = dp_ab * (1 - 0.03 * max(dp_n - 1, 0)); dp_seq = 1;
      SEQ[s_eff] ? ( kick_trig(SEQ[s_eff] == 2 ? 1 : 0.72); LTM[0] = 1; );
      SEQ[16 + s_eff] ? ( snare_trig(SEQ[16 + s_eff] == 2 ? 1 : 0.72); LTM[1] = 1; );
      SEQ[32 + s_eff] ? ( clap_trig(SEQ[32 + s_eff] == 2 ? 1 : 0.72); LTM[2] = 1; );
      SEQ[48 + s_eff] ? ( hat_trig(SEQ[48 + s_eff] == 2 ? 1 : 0.6, 0); LTM[3] = 1; );
      SEQ[64 + s_eff] ? ( hat_trig(SEQ[64 + s_eff] == 2 ? 1 : 0.7, 1); LTM[4] = 1; );
      SEQ[80 + s_eff] ? ( rim_trig(SEQ[80 + s_eff] == 2 ? 1 : 0.7); LTM[5] = 1; );
      dp_seq = 0; dp_ab = max(dp_ab - 0.04 * dp_n, 0.6);
    );
  );
);
spos += 1;

dp_ck += 1; dp_ck >= 32 ? ( dp_ck = 0; dp_ctl(); );
k_lvl += (k_lvl_t - k_lvl) * dp_gl; s_lvl += (s_lvl_t - s_lvl) * dp_gl; s_tmix += (s_tmix_t - s_tmix) * dp_gl;
h_lvl += (h_lvl_t - h_lvl) * dp_gl; ho_lvl += (ho_lvl_t - ho_lvl) * dp_gl; cl_lvl += (cl_lvl_t - cl_lvl) * dp_gl; h_nz += (h_nz_t - h_nz) * dp_gl; r_lvl += (r_lvl_t - r_lvl) * dp_gl;
sd_s += (s_dly_t - sd_s) * dp_gl;

dp_ab < 1 ? dp_ab += (1 - dp_ab) * dp_acr;

kick = 0;
kq_on ? (
  kq_pn > 0 ? ( kq_pn -= 1; kqx = kq_pa; kq_sw += (kq_st - kq_sw) * dp_scc; kqr = kq_r * dp_kd; ) :
              ( kqx = 0; kq_sw *= kq_sc; kq_sw < 0.000001 ? kq_sw = 0; kqr = kq_r; );
  kq_ps += (kqx - kq_ps) * dp_pc;
  kq_cy = dp_hc * (kq_cy + kqx - kq_ch); kq_ch = kqx;
  kqx = dp_e((k_base + k_drop * kq_sw) * kq_tf * dp_pis);
  kq_u = kqr * (kq_u - kqx * kq_v) + kq_ps * dp_pg; kq_v = kqr * (kq_v + kqx * kq_u);
  kg = 1.63 + kq_dg * (0.35 + 0.65 * kq_sw);
  kick = kq_c.dp_sat(kq_v * kg * 0.5) * kq_gn * (kq_gi + 1 / kg);
  kick = (kick + kq_cy * kq_cl) * k_lvl * dp_tk;
  kq_pn == 0 && abs(kq_u) + abs(kq_v) + abs(kq_ps) + abs(kq_cy) < 0.000001 ? (
    kq_on = 0; kq_u = kq_v = kq_ps = kq_sw = kq_cy = kq_ch = 0; kq_c.x1 = 0; kick = 0; );
);

snL = 0; snR = 0; snN = 0;
s_on ? (
  sq_pn > 0 ? ( sq_pn -= 1; sx = sq_pa; sq_sw += (sq_st - sq_sw) * dp_scc; ) : ( sx = 0; sq_sw *= sq_sc; sq_sw < 0.000001 ? sq_sw = 0; );
  sq_ps += (sx - sq_ps) * dp_pc;
  sx = (1 + sq_sw) * sq_tf * s_f * dp_pis; se1 = dp_e(sx); se2 = dp_e(sx * 1.78);
  sx = sq_ps * dp_pg;
  sq_u1 = sq_r1 * (sq_u1 - se1 * sq_v1) + sx; sq_v1 = sq_r1 * (sq_v1 + se1 * sq_u1);
  sq_u2 = sq_r2 * (sq_u2 - se2 * sq_v2) + sx; sq_v2 = sq_r2 * (sq_v2 + se2 * sq_u2);
  sq_cy = dp_hc * (sq_cy + sq_ps - sq_ch); sq_ch = sq_ps;
  stone = (sq_v1 + 0.5 * sq_v2) * dp_tb + sq_cy * sq_cl;
  snN = (snF.svf_bpx(rand(2) - 1) + s_nb * snF.hp) * s_be * s_ng * 2.2;
  s_be *= s_bc;
  stone *= s_tmix * 1.4; snN *= (1 - s_tmix * 0.6);
  snL = (stone + snN) * s_lvl;
  sq_pn == 0 && s_be < 0.00003 && abs(sq_u1) + abs(sq_v1) + abs(sq_u2) + abs(sq_v2) + abs(sq_ps) + abs(sq_cy) < 0.000001 ? (
    s_on = 0; s_be = 0; sq_u1 = sq_v1 = sq_u2 = sq_v2 = sq_ps = sq_sw = sq_cy = sq_ch = 0; snL = snN = 0; );
);
cpL = 0; cpN = 0;
cl_on ? (
  cq_pn > 0 ? ( cq_pn -= 1; cl_x = cq_pa; cq_sw += (cq_st - cq_sw) * dp_scc; ) : ( cl_x = 0; cq_sw *= cq_sc; cq_sw < 0.000001 ? cq_sw = 0; );
  cq_ps += (cl_x - cq_ps) * dp_pc;
  cl_x = (1 + cq_sw) * cq_tf * cl_f * dp_pis; cl_e1 = dp_e(cl_x); cl_e2 = dp_e(cl_x * 1.78);
  cl_x = cq_ps * dp_pg;
  cq_u1 = cq_r1 * (cq_u1 - cl_e1 * cq_v1) + cl_x; cq_v1 = cq_r1 * (cq_v1 + cl_e1 * cq_u1);
  cq_u2 = cq_r2 * (cq_u2 - cl_e2 * cq_v2) + cl_x; cq_v2 = cq_r2 * (cq_v2 + cl_e2 * cq_u2);
  cl_tn = (cq_v1 + 0.5 * cq_v2) * dp_tb;
  cl_clap ? (
    cl_t += 1;
    cl_t == cl_b2 || cl_t == cl_b3 ? cl_be = cl_ba * 0.85 : cl_t == cl_b4 ? ( cl_be = cl_ba; cl_tt = max(cl_tt, cl_tv); cl_clap = 0; );
  );
  cl_te += (cl_tt - cl_te) * dp_ta; cl_tt *= cl_nc;
  cpN = (clF.svf_bpx(rand(2) - 1) + cl_nb * clF.hp) * (cl_be * cl_ng + cl_te) * 2.2;
  cl_be *= cl_bc;
  cl_tn *= s_tmix * 1.4; cpN *= (1 - s_tmix * 0.6);
  cpL = (cl_tn + cpN) * cl_lvl;
  !cl_clap && cq_pn == 0 && cl_be < 0.00003 && cl_te < 0.00003 && cl_tt < 0.00003 && abs(cq_u1) + abs(cq_v1) + abs(cq_u2) + abs(cq_v2) + abs(cq_ps) < 0.000001 ? (
    cl_on = 0; cl_be = cl_te = cl_tt = 0; cq_u1 = cq_v1 = cq_u2 = cq_v2 = cq_ps = cq_sw = 0; cpL = cpN = 0; );
);
sdn = snN * s_lvl + cpN * cl_lvl;
SDL[sdw] = sdn;
sdr = sdw - sd_s; sdr < 0 ? sdr += SDS;
sdi = floor(sdr); sdf = sdr - sdi; sdj = sdi + 1; sdj >= SDS ? sdj = 0;
snL += cpL;
snR = snL - sdn + SDL[sdi] + (SDL[sdj] - SDL[sdi]) * sdf;
sdw += 1; sdw >= SDS ? sdw = 0;

hat = 0;
h_on ? (
  hx = hbc.hb_run() * (1 - h_nz) + (rand(2) - 1) * h_nz;
  hb = hF.svf_bpx(hx);
  hat = (hb + h_hmc * hF.hp) * h_ce * h_lvl * 1.6 * dp_th;
  h_ce *= h_cdq;
  h_ce < 0.00003 ? ( h_on = 0; h_ce = 0; hat = 0; );
);
ho_on ? (
  hx = hbo.hb_run() * (1 - h_nz) + (rand(2) - 1) * h_nz;
  hb = hoF.svf_bpx(hx);
  hat += (hb + h_hmo * hoF.hp) * h_oe * ho_lvl * 1.6 * dp_th;
  h_oe *= h_odk;
  h_oe < 0.00003 ? ( ho_on = 0; h_oe = 0; );
);
rim = 0;
rim_on ? (
  rm_pn > 0 ? ( rm_pn -= 1; rx = rm_pa; rm_sw += (rm_st - rm_sw) * dp_scc; ) : ( rx = 0; rm_sw *= rm_sc; rm_sw < 0.000001 ? rm_sw = 0; );
  rm_ps += (rx - rm_ps) * dp_pc;
  rx = (1 + rm_sw) * rm_tf * slider51 * dp_pis; re1 = dp_e(rx); re2 = dp_e(rx * 0.27);
  rx = rm_ps * dp_rg;
  rm_u1 = rm_r1 * (rm_u1 - re1 * rm_v1) + rx; rm_v1 = rm_r1 * (rm_v1 + re1 * rm_u1);
  rm_u2 = rm_r2 * (rm_u2 - re2 * rm_v2) + rx; rm_v2 = rm_r2 * (rm_v2 + re2 * rm_u2);
  rm_cy = dp_hc * (rm_cy + rm_ps - rm_ch); rm_ch = rm_ps;
  rim = (rm_v1 * 0.7 + rm_v2 * 0.5 + rm_cy * rm_cl) * r_lvl * dp_tr;
  rm_pn == 0 && abs(rm_u1) + abs(rm_v1) + abs(rm_u2) + abs(rm_v2) + abs(rm_ps) + abs(rm_cy) < 0.000001 ? (
    rim_on = 0; rm_u1 = rm_v1 = rm_u2 = rm_v2 = rm_ps = rm_sw = rm_cy = rm_ch = 0; rim = 0; );
);
oL = (kick + snL + hat * 0.89 + rim * 1.05) * 0.5; oR = (kick + snR + hat * 1.05 + rim * 0.89) * 0.5;

pwr_in(oL, oR); oL = pwr_l; oR = pwr_r;

c_m += (c_on_t - c_m) * dp_sw;
c_thr += (c_thr_t - c_thr) * dp_gl; c_slope += (c_slope_t - c_slope) * dp_gl; c_mk += (c_mk_t - c_mk) * dp_gl;
c_m > 0.00001 ? (
  c_in = 20 * log10(max(abs(oL), abs(oR)) + DEN);
  c_tgt = min(0, (c_thr - c_in) * c_slope);
  c_gr = c_tgt < c_gr ? c_tgt + (c_gr - c_tgt) * c_att : c_tgt + (c_gr - c_tgt) * c_rel;
  c_g = 1 + (10 ^ (c_gr * 0.05) * c_mk - 1) * c_m;
  oL *= c_g; oR *= c_g;
) : c_gr = 0;

q_m += (q_on_t - q_m) * dp_sw;
q_m > 0.00001 ? (
  eL = eqHS_L.bq_run(eqPK_L.bq_run(eqLS_L.bq_run(oL)));
  eR = eqHS_R.bq_run(eqPK_R.bq_run(eqLS_R.bq_run(oR)));
  oL += (eL - oL) * q_m; oR += (eR - oR) * q_m;
  q_ac = 1;
) : q_ac ? (
  q_ac = 0;
  eqLS_L.z1 = eqLS_L.z2 = eqPK_L.z1 = eqPK_L.z2 = eqHS_L.z1 = eqHS_L.z2 = 0;
  eqLS_R.z1 = eqLS_R.z2 = eqPK_R.z1 = eqPK_R.z2 = eqHS_R.z1 = eqHS_R.z2 = 0;
);

t_m += (t_on_t - t_m) * dp_sw;
t_g += (t_g_t - t_g) * dp_gl; t_mix += (t_mix_t - t_mix) * dp_gl;
tw0 += ((t_ty == 0) - tw0) * dp_sw; tw1 += ((t_ty == 1) - tw1) * dp_sw; tw2 += ((t_ty == 2) - tw2) * dp_sw;
t_m > 0.00001 ? (
  tl = oL * t_g; tr = oR * t_g; sl = sr = 0;
