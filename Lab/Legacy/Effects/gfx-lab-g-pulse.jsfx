    qpn == 0 && qne == 0 && abs(qu1) + abs(qv1) + abs(qu2) + abs(qv2) + abs(qps) + abs(qtl) < 0.000001 ? (
      qa = 0; qu1 = qv1 = qu2 = qv2 = qps = qsw = qch = qcy = qcf = qtl = 0; qkc.x1 = 0; qhp.f_clear();
    );
  );
