  catc = 1 - exp(-1 / (max(slider10, 0.05) * 0.001 * srate)); crlc = 1 - exp(-1 / (slider11 * 0.001 * srate));
  cmk = 10 ^ (slider12 / 20); cmix_t = slider13 / 100;
