  ) : c == 2 ? (
    u = x * gd * cg * 1.2;
    emp += (u - emp) * dr_k2500; u += 0.9 * (u - emp);
    y = this.a.dr_ahc(u + 0.5 * cb);
  ) : c == 3 ? (
    u = x * gd3 * cg;
    u = dr_th(u + 0.1 + cb) - dr_th(0.1 + cb); h1 += (u - h1) * dr_k20; u -= h1; l1 += (u - l1) * dr_k14k;
    u = l1 * gd3 * 1.6;
    u = dr_th(u - 0.08 - 0.5 * cb) - dr_th(-0.08 - 0.5 * cb); h2 += (u - h2) * dr_k20; u -= h2; l2 += (u - l2) * dr_k10k;
    u = l2 * gd3 * 1.6;
    y = this.a.dr_ath(u + 0.12 + cb) - dr_th(0.12 + cb);
  ) : c == 4 ? (
    u = x * gd * cg * 0.9;
    y = this.a.dr_akn(u, 0.55 - cb, 0.6 + cb); y += 0.05 * y * y;
  ) : c == 5 ? (
    u = x * gd * cg * 1.4;
    emp += (u - emp) * dr_k3k2; u += 2 * (u - emp);
    y = this.a.dr_asc(u + 0.3 * cb) - 0.3 * cb;
    lp += (y - lp) * dr_k3k2; y = lp + (y - lp) * 0.333333333;
  ) : c == 6 ? (
    u = x * gd * cg * 0.8;
    lo += (u - lo) * dr_k700; v = this.b.dr_arc(u - lo);
    h1 += (v - h1) * dr_k150; v -= h1;
    y = (this.a.dr_ath(0.9 * (u + dr_rx * v) + 0.05) - dr_th(0.05)) * 1.111111111;
  ) : (
    u = x * gd * cg * 1.1;
    tt = 1 / (1 + 1.5 * env); b = 0.3 * (1 - tt) + cb;
    y = tt * (this.a.dr_ath(u / tt + b) - dr_th(b));
