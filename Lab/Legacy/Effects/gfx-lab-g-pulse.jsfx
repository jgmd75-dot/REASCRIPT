);
function achoke() instance(qmc) ( qmc = min(qmc, an_chk); );

DMK = 9700;
DLG = 9560; DLW = 9570; DLGT = 9580; DLWT = 9590;
function dr_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function dr_Fth(z) local(a) ( a = abs(z); a < 3 ? z * z * 0.05555555555555556 + 1.3333333 * log(1 + z * z * 0.3333333333333333) : a - 0.6516075; );
function dr_ath(z) instance(z1, ad1, cv1) local(ad, cv, w) (
  ad = dr_Fth(z); cv = dr_th(z); w = z - z1;
  w = abs(w) > 0.00001 ? (ad - ad1) / w : dr_th(0.5 * (z + z1));
  z1 = z; ad1 = ad; w += 0.5 * (cv - cv1); cv1 = cv; w;
);
function dr_ge(v) ( v >= 0 ? dr_th(v) : dr_th(0.55 * v) / 0.55; );
function dr_Fge(v) ( v >= 0 ? dr_Fth(v) : dr_Fth(0.55 * v) / 0.3025; );
function dr_age(v) instance(z1, ad1, cv1) local(ad, cv, w) (
  ad = dr_Fge(v); cv = dr_ge(v); w = v - z1;
  w = abs(w) > 0.00001 ? (ad - ad1) / w : dr_ge(0.5 * (v + z1));
  z1 = v; ad1 = ad; w += 0.5 * (cv - cv1); cv1 = cv; w;
);
function dr_hc(u) ( min(max(u, -0.92), 1); );
function dr_Fhc(u) ( u > 1 ? u - 0.5 : u < -0.92 ? -0.92 * u - 0.4232 : 0.5 * u * u; );
function dr_ahc(u) instance(z1, ad1, cv1) local(ad, cv, w) (
  ad = dr_Fhc(u); cv = dr_hc(u); w = u - z1;
  w = abs(w) > 0.00001 ? (ad - ad1) / w : dr_hc(0.5 * (u + z1));
  z1 = u; ad1 = ad; w += 0.5 * (cv - cv1); cv1 = cv; w;
);
function dr_sc(u) ( min(max(u, -1), 1); );
function dr_Fsc(u) ( abs(u) <= 1 ? 0.5 * u * u : abs(u) - 0.5; );
function dr_asc(u) instance(z1, ad1, cv1) local(ad, cv, w) (
  ad = dr_Fsc(u); cv = dr_sc(u); w = u - z1;
  w = abs(w) > 0.00001 ? (ad - ad1) / w : dr_sc(0.5 * (u + z1));
  z1 = u; ad1 = ad; w += 0.5 * (cv - cv1); cv1 = cv; w;
);
function dr_kn(u, kp, kn) local(a, k) ( k = u > 0 ? kp : kn; a = abs(u); a < k ? u : sign(u) * (k + (1 - k) * dr_th((a - k) / (1 - k))); );
function dr_Fkn(u, kp, kn) local(a, k) (
  k = u > 0 ? kp : kn; a = abs(u);
  a < k ? 0.5 * u * u : k * a - 0.5 * k * k + sqr(1 - k) * dr_Fth((a - k) / (1 - k));
);
function dr_akn(u, kp, kn) instance(z1, ad1, cv1) local(ad, cv, w) (
  ad = dr_Fkn(u, kp, kn); cv = dr_kn(u, kp, kn); w = u - z1;
  w = abs(w) > 0.00001 ? (ad - ad1) / w : dr_kn(0.5 * (u + z1), kp, kn);
  z1 = u; ad1 = ad; w += 0.5 * (cv - cv1); cv1 = cv; w;
);
function dr_arc(v) instance(z1, ad1) local(ad, w) (
  ad = 0.5 * v * abs(v); w = v - z1;
  w = abs(w) > 0.00001 ? (ad - ad1) / w : abs(0.5 * (v + z1));
  z1 = v; ad1 = ad; w;
);
function dr_cir(c, x, cb, cg, gd, gd3) instance(lo, lp, env, emp, h1, h2, h3, l1, l2, l3, dc1, dc2) local(u, y, tt, b, v) (
  c == 0 ? (
    u = x * gd * cg * 0.6;
    lo += (u - lo) * dr_k120;
    y = u - lo + (dr_th(1.4 * (lo + 0.06 + cb)) - dr_th(1.4 * (0.06 + cb))) * 0.714285714;
    y = 1.6 * this.a.dr_ath(y * 0.625);
  ) : c == 1 ? (
    u = x * gd * cg; lp += (u - lp) * dr_k14k; u = lp;
    env += (abs(u) - env) * (abs(u) > env ? dr_ka5 : dr_kr120);
    tt = 1 / (1 + 0.25 * env); b = 0.18 + cb + 0.05 * min(env, 2);
