!ui_dflt ? ui_thm = 5; !ui_dflt ? ui_hw = 1; !ui_dflt ? ui_kstyle = 0;
PNL = 0x26272B; INKL = 0xE8E6E0; ACC = 0xE0603A; REDL = 0xFF3A2A; AMBL = 0xFFB030; GRNL = 0x3ADF6A;
SH1 = 0x202125; SH2 = 0x1D1E22; SH3 = 0x1A1B1F;
function vcol(v) ( v == 0 ? 0xE0603A : v == 1 ? 0xE8B23A : v == 2 ? 0xD8D25A : v == 3 ? 0x6FCB7A :
                   v == 4 ? 0x4FB8B0 : v == 5 ? 0x4A9AD8 : v == 6 ? 0x8E7AE0 : 0xD070B8; );
function sx(s) ( (184 + s * 20 + (s >= 16 ? 6 : 0)) * sc; );
function ry(v) ( (106 + v * 30) * sc; );
function pgroup(x, y, w, h, title, shade) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  pk_box(x * sc, y * sc, w * sc, h * sc, ACC, title);
  C_INK = INKL;
);
update();
vol_s = vol_t; cmix_s = cmix_t; last_s4 = slider4;
ui_dflt = 1;

@slider
update();

@block
srate != pu_sr ? ( pu_sr = srate; pu_srinit(); );
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.15, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
update();
dr_any > 0 ? dr_hold = 2 * srate : dr_hold > 0 ? (
  dr_hold -= samplesblock;
  dr_hold <= 0 ? ( drA.md_clr(); drB.md_clr(); pb_i = 0; loop(8, DLG[pb_i] = 1; DLW[pb_i] = 0; pb_i += 1; ); );
);
dr_hold <= 0 ? ( drA.md_snap(); drB.md_snap(); );
dr_cbL = dm_a * (0.03 * dr_dbL.v + 0.012 * dr_sbL); dr_cbR = dm_a * (0.03 * dr_dbR.v + 0.012 * dr_sbR);
dr_cgL = 1 + dm_a * (0.03 * dr_dgL.v + 0.01 * dr_sgL); dr_cgR = 1 + dm_a * (0.03 * dr_dgR.v + 0.01 * dr_sgR);
evn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  (m1 & 0xF0) == 0x90 && m3 > 0 && (chan == 0 || (m1 & 0x0F) + 1 == chan) && evn < 512 && NMAP[m2] >= 0 ? (
    EVQ[evn * 2] = mofs; EVQ[evn * 2 + 1] = NMAP[m2] + 8 * m3; evn += 1;
  );
  midisend(mofs, m1, m2, m3);
);
evi = 0; spos = 0;
slider4 != last_s4 ? ( last_s4 = slider4; seq_play ? qslot_dirty = slider4 - 1 : load_slot(slider4 - 1); );
seq_play = (play_state & 1) && seq_on;
bp0 = beat_position; bps = tempo / 60 / srate;
!seq_play ? (
  lastg = -1; pb_i = 0; loop(8, CUR[pb_i] = -1; pb_i += 1; );
  qslot_dirty >= 0 ? ( load_slot(qslot_dirty); qslot_dirty = -1; );
);
aud_dirty > 0 ? ( v_trig(aud_dirty - 1, 0.9); aud_dirty = 0; );
dm_a > 0 ? (
  an_wrm *= exp(-samplesblock / (90 * srate)); pb_i = samplesblock * 0.05 * dm_s / srate;
  v0.qdr.drift_tick(pb_i); v1.qdr.drift_tick(pb_i); v2.qdr.drift_tick(pb_i); v3.qdr.drift_tick(pb_i);
  v4.qdr.drift_tick(pb_i); v5.qdr.drift_tick(pb_i); v6.qdr.drift_tick(pb_i); v7.qdr.drift_tick(pb_i); an_hdr.drift_tick(pb_i);
  dr_dbL.drift_tick(pb_i); dr_dbR.drift_tick(pb_i); dr_dgL.drift_tick(pb_i); dr_dgR.drift_tick(pb_i);
);
load_dirty ? ( load_dirty = 0; load_file(); );
slot_dirty > 0 ? ( load_slot(slot_dirty - 1); slot_dirty = 0; slider_automate(slider4); );

@serialize
file_var(0, ui_sz);
file_var(0, pat_init);
file_var(0, cur_slot);
file_var(0, modified);
file_mem(0, PAT, 272);
file_mem(0, SLOTS, 8 * SLN);

@sample
while (evi < evn && (EVQ[evi * 2] <= spos || spos >= samplesblock - 1)) (
  e2 = EVQ[evi * 2 + 1]; v_trig(e2 % 8, floor(e2 / 8) / 127); ins_midi_hit();
  evi += 1;
);

seq_play ? (
  sbeat = bp0 + spos * bps;
  sbeat >= 0 ? (
