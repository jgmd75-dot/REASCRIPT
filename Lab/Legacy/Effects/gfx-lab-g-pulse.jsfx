in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-g-pulse";

NV = 8;
PAT = 1000; LEN = 1256; MUTE = 1264;
CUR = 1280;
CLIP = 1400; SLOTS = 2000; SLN = 264;
MR = 5000; MA = 5030;
KB = 6000;
NMAP = 7000;
EVQ = 7200;
NOFF = 9300;
VLT = 9320;

function mset(s, r0, r1, r2, r3, r4, r5, a0, a1, a2, a3, a4, a5) (
  MR[s * 6] = r0; MR[s * 6 + 1] = r1; MR[s * 6 + 2] = r2; MR[s * 6 + 3] = r3; MR[s * 6 + 4] = r4; MR[s * 6 + 5] = r5;
  MA[s * 6] = a0; MA[s * 6 + 1] = a1; MA[s * 6 + 2] = a2; MA[s * 6 + 3] = a3; MA[s * 6 + 4] = a4; MA[s * 6 + 5] = a5;
);
mset(0, 1, 1.594, 2.136, 2.296, 2.653, 2.918,  1, 0.65, 0.5, 0.42, 0.32, 0.25);
mset(1, 1, 1.652, 2.338, 3.211, 4.282, 5.394,  1, 0.95, 0.85, 0.75, 0.65, 0.55);
mset(2, 1, 2.756, 5.404, 8.933, 13.34, 18.64,  1, 0.45, 0.22, 0.11, 0.05, 0.025);
mset(3, 1, 1.37, 2.08, 2.91, 3.62, 4.43,       1, 0.8, 0.6, 0.45, 0.3, 0.2);

gi = 0; loop(128, NMAP[gi] = -1; gi += 1; );
NMAP[35] = NMAP[36] = 0; NMAP[38] = 1; NMAP[40] = 2; NMAP[22] = NMAP[42] = NMAP[44] = 3; NMAP[26] = NMAP[46] = 4;
NMAP[48] = NMAP[50] = NMAP[45] = NMAP[47] = NMAP[43] = NMAP[58] = NMAP[41] = NMAP[39] = 5;
NMAP[37] = 6; gi = 27; loop(8, NMAP[gi] = 6; gi += 1; );
NMAP[49] = NMAP[55] = NMAP[57] = NMAP[52] = NMAP[51] = NMAP[59] = NMAP[53] = 7;
function out_note(v) ( v == 0 ? 36 : v == 1 ? 38 : v == 2 ? 40 : v == 3 ? 42 : v == 4 ? 46 : v == 5 ? 45 : v == 6 ? 27 : 49; );
function vname(v) ( v == 0 ? "KICK" : v == 1 ? "SNARE" : v == 2 ? "CLAP" : v == 3 ? "CL HAT" : v == 4 ? "OP HAT" : v == 5 ? "TOM" : v == 6 ? "PERC" : "CYMBAL"; );
function cname(m) ( m == 0 ? "ANALOG" : m == 1 ? "FM" : m == 2 ? "PHYSICAL" : "DIGITAL"; );

function f_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(max(fc, 20), srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function f_run(x) instance(g, k, a1, a2, a3, ic1, ic2, bp, lp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  bp = v1; lp = v2; hp = x - k * v1 - v2;
  bp;
);
function f_out(t) instance(bp, lp, hp) ( t == 0 ? lp : t == 1 ? bp : hp; );
function f_clear() instance(ic1, ic2) ( ic1 = 0; ic2 = 0; );
function dcoef(t) ( exp(-6.9 / (max(t, 0.0005) * srate)); );
function sq(p) ( p - floor(p) < 0.5 ? 1 : -1; );

function recipe(m, k) (
  rf = 100; rpd = 0; rpt = 0.03; rom = 0; ror = 1; rix = 0; rit = 0.05; rol = 0; rod = 0.2;
  rnl = 0; rnt = 1; rnf = 1000; rnq = 0.7; rnd = 0.1; rnb = 0;
  rml = 0; rmd = 0.1; rkl = 0; rks = 0; rkf = 100; rkd = 0.3; rkdm = 0.5; rkw = 0;
  rcl = 0; rvt = 0; rvf = 1000; rvq = 0.7; rcr = 0; rtr = 1;
  k == 0 ? (
    m == 0 ? ( rf = 52; rpd = 3; rpt = 0.035; rol = 1; rod = 0.45; rcl = 0.35; ) :
    m == 1 ? ( rf = 50; rpd = 2; rpt = 0.04; rom = 1; ror = 1; rix = 4; rit = 0.02; rol = 1; rod = 0.5; rcl = 0.15; ) :
    m == 2 ? ( rf = 50; rpd = 0.6; rpt = 0.05; rol = 0.6; rod = 0.3; rkl = 0.8; rks = 0; rkf = 50; rkd = 0.55; rkdm = 1.2; rcl = 0.2; ) :
             ( rf = 50; rpd = 4; rpt = 0.03; rom = 2; rix = 0.9; rit = 0.05; rol = 1; rod = 0.4; rcr = 1; );
  ) : k == 1 ? (
    m == 0 ? ( rf = 185; ror = 1.78; rom = 4; rpd = 0.3; rpt = 0.02; rol = 0.6; rod = 0.12;
               rnl = 0.8; rnt = 1; rnf = 5000; rnq = 0.6; rnd = 0.2; rcl = 0.2; ) :
    m == 1 ? ( rf = 200; rom = 1; ror = 1.47; rix = 3; rit = 0.03; rol = 0.6; rod = 0.1;
               rnl = 0.7; rnt = 1; rnf = 3500; rnq = 0.8; rnd = 0.18; ) :
    m == 2 ? ( rkl = 0.9; rks = 0; rkf = 190; rkd = 0.22; rkdm = 0.6; rkw = 1.2; rnl = 0.35; rnt = 1; rnf = 4500; rnq = 0.6; rnd = 0.16; rcl = 0.35; ) :
             ( rf = 210; rom = 2; rix = 0.7; rit = 0.04; rol = 0.5; rod = 0.1;
               rnl = 0.8; rnt = 1; rnf = 4000; rnq = 0.7; rnd = 0.2; rcr = 1; );
  ) : k == 2 ? (
    m == 0 ? ( rnl = 1; rnt = 1; rnf = 1100; rnq = 1.4; rnd = 0.18; rnb = 1; ) :
    m == 1 ? ( rnl = 1; rnt = 1; rnf = 1300; rnq = 1; rnd = 0.16; rnb = 1;
               rf = 900; rom = 1; ror = 2.3; rix = 5; rit = 0.01; rol = 0.3; rod = 0.02; ) :
    m == 2 ? ( rkl = 0.6; rks = 3; rkf = 850; rkd = 0.05; rkdm = 0.3; rnl = 0.9; rnt = 1; rnf = 1400; rnq = 1.1; rnd = 0.17; rnb = 1; ) :
             ( rnl = 1; rnt = 1; rnf = 1500; rnq = 1; rnd = 0.15; rnb = 1; rcr = 1; );
  ) : (k == 3 || k == 4) ? (
    m == 0 ? ( rml = 1; rmd = 0.045; rnl = 0.15; rnt = 2; rnf = 9000; rnd = 0.03; rvt = 1; rvf = 7000; ) :
    m == 1 ? ( rf = 4300; rom = 1; ror = 1.4727; rix = 14; rit = 0.5; rol = 0.6; rod = 0.045;
               rnl = 0.5; rnt = 2; rnf = 8000; rnd = 0.04; rvt = 1; rvf = 6500; ) :
    m == 2 ? ( rkl = 0.4; rks = 1; rkf = 4200; rkd = 0.05; rkdm = 0.15; rnl = 0.8; rnt = 1; rnf = 9000; rnq = 0.9; rnd = 0.05;
               rcl = 0.15; rvt = 1; rvf = 6500; ) :
             ( rnl = 0.8; rnt = 2; rnf = 8000; rnd = 0.045; rml = 0.4; rmd = 0.04; rcr = 1; rvt = 1; rvf = 5500; );
    k == 4 ? ( rmd *= 8; rod *= 8; rkd *= 8; rnd *= 8; );
  ) : k == 5 ? (
    m == 0 ? ( rf = 120; rpd = 0.6; rpt = 0.08; rol = 1; rod = 0.35; rnl = 0.1; rnt = 0; rnf = 2000; rnd = 0.05; rcl = 0.15; ) :
    m == 1 ? ( rf = 115; rpd = 0.4; rpt = 0.08; rom = 1; ror = 1.5; rix = 2; rit = 0.05; rol = 1; rod = 0.35; ) :
    m == 2 ? ( rkl = 1; rks = 0; rkf = 110; rkd = 0.45; rkdm = 0.8; rcl = 0.1; ) :
             ( rf = 125; rpd = 0.8; rpt = 0.06; rom = 2; rix = 0.6; rit = 0.1; rol = 1; rod = 0.3; rcr = 1; );
  ) : k == 6 ? (
    m == 0 ? ( rf = 540; rom = 3; ror = 1.48; rol = 0.7; rod = 0.25; rvt = 2; rvf = 800; rvq = 1.5; ) :
    m == 1 ? ( rf = 620; rom = 1; ror = 3.5; rix = 2.5; rit = 0.15; rol = 1; rod = 0.3; ) :
    m == 2 ? ( rkl = 1; rks = 2; rkf = 800; rkd = 0.2; rkdm = 0.5; rcl = 0.2; ) :
             ( rf = 700; rom = 2; rix = 0.8; rit = 0.08; rol = 0.8; rod = 0.15; rcr = 1; rvt = 2; rvf = 1000; rvq = 1; );
  ) : (
    m == 0 ? ( rml = 1; rmd = 1.2; rnl = 0.3; rnt = 2; rnf = 9000; rnd = 0.9; rvt = 2; rvf = 8000; rvq = 0.7; ) :
    m == 1 ? ( rf = 3100; rom = 1; ror = 2.4311; rix = 12; rit = 1.5; rol = 0.6; rod = 1.2;
               rnl = 0.45; rnt = 2; rnf = 7500; rnd = 1; rvt = 1; rvf = 4000; ) :
    m == 2 ? ( rkl = 0.6; rks = 1; rkf = 1150; rkd = 1.6; rkdm = 0.05; rnl = 0.5; rnt = 2; rnf = 7000; rnd = 1.1; rcl = 0.2; rvt = 1; rvf = 2500; ) :
             ( rnl = 0.7; rnt = 2; rnf = 7000; rnd = 1.1; rml = 0.6; rmd = 0.9; rcr = 1; rvt = 1; rvf = 3500; );
  );
  rtr = TRIM[m * 8 + k];
);
TRIM = 9400;

SPT = 9440; SPD = 9450; MDT = 9460;
SPT[0] = 0.31; SPT[1] = -0.62; SPT[2] = 0.18; SPT[3] = 0.47; SPT[4] = -0.36; SPT[5] = -0.85; SPT[6] = 0.66; SPT[7] = -0.29;
SPD[0] = -0.4; SPD[1] = 0.7; SPD[2] = 0.2; SPD[3] = -0.6; SPD[4] = 0.5; SPD[5] = 0.3; SPD[6] = -0.8; SPD[7] = 0.45;
MDT[0] = 0.0021; MDT[1] = -0.0034; MDT[2] = 0.0015; MDT[3] = -0.0011; MDT[4] = 0.0029; MDT[5] = -0.0024;
function sqb(p, d, ni) local(t) (
  p < 0.5 ? (
    p < d ? ( t = p * ni; t + t - t * t; ) : p > 0.5 - d ? ( t = (p - 0.5) * ni; 1 - t * t - t - t - 1; ) : 1;
  ) : (
    p < 0.5 + d ? ( t = (p - 0.5) * ni; t * t - t - t; ) : p > 1 - d ? ( t = (p - 1) * ni; t * t + t + t; ) : -1;
  );
);
function mclu_set(tm, a) instance(d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  d1 = 205.3 * tm * (1 + a * MDT[0]) / srate; d2 = 304.4 * tm * (1 + a * MDT[1]) / srate; d3 = 369.6 * tm * (1 + a * MDT[2]) / srate;
  d4 = 522.7 * tm * (1 + a * MDT[3]) / srate; d5 = 540 * tm * (1 + a * MDT[4]) / srate;   d6 = 800 * tm * (1 + a * MDT[5]) / srate;
  n1 = 1 / d1; n2 = 1 / d2; n3 = 1 / d3; n4 = 1 / d4; n5 = 1 / d5; n6 = 1 / d6;
);
function mclu_run() instance(p1, p2, p3, p4, p5, p6, d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  p1 += d1; p1 >= 1 ? p1 -= 1; p2 += d2; p2 >= 1 ? p2 -= 1; p3 += d3; p3 >= 1 ? p3 -= 1;
  p4 += d4; p4 >= 1 ? p4 -= 1; p5 += d5; p5 >= 1 ? p5 -= 1; p6 += d6; p6 >= 1 ? p6 -= 1;
  (sqb(p1, d1, n1) + sqb(p2, d2, n2) + sqb(p3, d3, n3) + sqb(p4, d4, n4) + sqb(p5, d5, n5) + sqb(p6, d6, n6)) * 0.16666667;
);
function asoft(x) instance(x1) local(y) (
  abs(x) <= 1.5 && abs(x1) <= 1.5 ? y = (x + x1) * (0.5 - (x * x + x1 * x1) * 0.037037037) :
  abs(x - x1) > 0.00001 ? y = (this.clp_ad(x) - this.clp_ad(x1)) / (x - x1) : y = this.clp_crv(0.5 * (x + x1));
  x1 = x;
  y;
);
function atrig(k, vel, tm, dm, tn, sn, lv) instance(qk, qhk, qhx, qhy, qa, qu1, qv1, qu2, qv2, qr1, qr2, qw1, qw2, qe1, qe2, qf2, qm2,
                                              qpn, qpa, qps, qpc, qpg, qsw, qsd, qsc, qscc, qch, qcy, qhc, qcl, qtl, qtc,
                                              qdg, qdt, qne, qnc, qnl, qnt, qnf, qme, qmc, qme2, qmc2, qhp, qb1, qb2, qmcl,
                                              qbt, qb2t, qb3t, qb4t, qbe, qba, qbc, qbv, qtt, qte, qta, qog, qogt, qdr, qkc, qcf, qcc)
                                     local(a, ak, tf, df, am, f1, f2, pd, pt, d1, d2, cl, nl, nf, nq, nd, w, t) (
  a = dm_a; ak = an_acc;
  tf = tm * (1 + a * (0.006 * SPT[k] - 0.005 * an_wrm + 0.002 * qdr.v + 0.0007 * (rand(2) - 1)));
  df = dm * (1 + a * (0.05 * SPD[k] + 0.02 * (rand(2) - 1))) * (1 + 0.04 * ak);
  am = vel * (1 + a * 0.02 * (rand(2) - 1));
  qk = k;
  k == 3 || k == 4 ? (
    qme = max(qme, am * (1 + 0.05 * ak)); qmc = dcoef((k == 3 ? 0.045 : 0.36) * df);
    qhk = tan($pi * min(7000 * 2 ^ (tn - 0.5) * tm, 0.45 * srate) / srate); qhk /= 1 + qhk;
  ) : k == 7 ? (
    qmcl.mclu_set(tf, a);
    qme = max(qme, am * (1 + 0.05 * ak)); qmc = dcoef(1.2 * df);
    qme2 = max(qme2, am); qmc2 = dcoef(0.35 * df);
    qb1.f_set(3400 * tf, 1.2); qb2.f_set(7500 * tf, 1);
    qhk = tan($pi * min(2000 * 2 ^ ((tn - 0.5) * 2) * tm, 0.45 * srate) / srate); qhk /= 1 + qhk;
  ) : k == 2 ? (
    t = 0.0004 * a * srate;
    qbt = 0; qb2t = floor(0.0105 * srate + t * (rand(2) - 1)); qb3t = floor(0.0212 * srate + t * (rand(2) - 1));
    qb4t = floor(0.0315 * srate + t * (rand(2) - 1));
    qba = am * (1 + 0.03 * ak); qbe = qba; qbc = dcoef(0.0065 / (1 + 0.3 * ak));
    qbv = am * 0.9; qnc = dcoef(0.18 * df); qta = 1 - exp(-1 / (0.004 * srate));
    qb1.f_set(1100 * 2 ^ ((tn - 0.5) * 1.5) * tm, 1.4);
  ) : (
    nl = 0; nf = 1000; nq = 0.7; nd = 0.1; f2 = 0; d2 = 0.1; qm2 = 0; qnt = 1; qdg = 1; t = 1;
    k == 0 ? ( f1 = 52;  pd = 3;   pt = 0.035; d1 = 0.45; cl = 0.35; qdg = 0.7; ) :
    k == 5 ? ( f1 = 120; pd = 0.6; pt = 0.08;  d1 = 0.35; cl = 0.15; qdg = 0.7; nl = 0.1; qnt = 0; nf = 2000; nd = 0.05; ) :
    k == 1 ? ( f1 = 185; f2 = 329.3; qm2 = 0.67 * (0.4 + 1.2 * tn); pd = 0.3; pt = 0.02; d1 = 0.12; d2 = 0.1; cl = 0.2;
               qdg = 0.5; t = 0.36; nl = 0.8; nf = 5000; nq = 0.6; nd = 0.2; ) :
             ( f1 = 540; f2 = 800; qm2 = 1; pd = 0; pt = 0.01; d1 = 0.25; d2 = 0.2; cl = 0; qdg = 1.6; t = 0.35;
               qhp.f_set(800 * 2 ^ (tn - 0.5) * tm, 1.5); );
    pd *= (0.3 + 1.4 * sn) * (1 + 0.4 * ak); cl *= 2 * sn * (1 + (k == 0 ? 0.5 : 1) * ak);
    w = $pi / srate;
    qw1 = min(f1 * tf * w, 1.2); qe1 = 2 * sin(qw1); qr1 = dcoef(d1 * df);
    qf2 = f2 > 0; qw2 = min(f2 * tf * w, 1.2); qe2 = 2 * sin(qw2); qr2 = dcoef(d2 * df);
    qsd = pd; qsc = dcoef(pt * dm * (1 + 0.3 * ak)); qscc = 1 - exp(-1 / (0.0002 * srate));
    qpn = max(floor(0.001 * srate), 1); qpg = 1 / qpn; qpa = am * (1 + 0.03 * ak); qpc = 1 - exp(-1 / (0.0001 * srate));
    qhc = exp(-2 * $pi * 1000 / srate); qcl = cl * 3;
