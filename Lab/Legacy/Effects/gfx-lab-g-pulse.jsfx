  i == 4 ? v4.vtrig(4, vel) : i == 5 ? v5.vtrig(5, vel) : i == 6 ? v6.vtrig(6, vel) : v7.vtrig(7, vel);
);

function v_clr() instance(act, oe, ne, me, kmx, ce, kenv, xe, clp, crh, nfl, pfl,
