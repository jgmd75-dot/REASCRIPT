);
function dr_clr() instance(lo, lp, env, emp, h1, h2, h3, l1, l2, l3, dc1, dc2) (
  lo = lp = env = emp = h1 = h2 = h3 = l1 = l2 = l3 = dc1 = dc2 = 0; this.a.z1 = this.a.ad1 = this.a.cv1 = 0;
  this.b.z1 = this.b.ad1 = 0;
);
function dr_mix(i, l, r) (
  DLG[i] += (DLGT[i] - DLG[i]) * sm; DLW[i] += (DLWT[i] - DLW[i]) * sm;
  oL += l * DLG[i]; oR += r * DLG[i]; wL += l * DLW[i]; wR += r * DLW[i];
);
function dr_k(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * srate) / srate); );
function dr_srinit() (
  dr_k120 = dr_k(120); dr_k14k = dr_k(14000); dr_k10k = dr_k(10000); dr_k16k = dr_k(16000); dr_k2500 = dr_k(2500);
  dr_k20 = dr_k(20); dr_k1k = dr_k(1000); dr_dcr = 1 - 2 * $pi * 5 / srate;
  dr_ka5 = 1 - exp(-1 / (0.005 * srate)); dr_kr120 = 1 - exp(-1 / (0.12 * srate));
  dr_k3k2 = dr_k(3183); dr_k700 = dr_k(700); dr_k150 = dr_k(150); dr_rx = 0.6;
  dr_ka1 = 1 - exp(-1 / (0.001 * srate)); dr_kr90 = 1 - exp(-1 / (0.09 * srate));
  dr_fc = 1 - exp(-1 / (0.015 * srate));
  dr_dkc = 1 / max(floor(0.006 * srate), 1);
  dr_xc = 1 - exp(-2 * $pi * 660 / srate);
);
function dr_mk(c, dbv) local(i, f) (
  f = min(max(dbv, 0), 30) / 3; i = min(floor(f), 9); f -= i;
  DMK[c * 11 + i] + (DMK[c * 11 + i + 1] - DMK[c * 11 + i]) * f;
);

function md_set(on, c, dbv, tone, mix, band) instance(cn, gdt, gd3t, mt, glt, ght, mxt, ont, blt, bht) local(t) (
  ont = on; blt = band == 1 ? 0 : 1; bht = band == 2 ? 0 : 1;
  cn = c; gdt = 10 ^ (dbv / 20); gd3t = gdt ^ (1 / 3); mt = dr_mk(c, dbv); mxt = mix / 100;
  t = (tone - 50) / 50; glt = 10 ^ (-0.3 * t); ght = 10 ^ (0.3 * t);
);
function md_snap() instance(c, cn, gd, gdt, gd3, gd3t, m, mt, gl, glt, gh, ght, mx, mxt, on, ont, dk, bl, blt, bh, bht) (
  bl = blt; bh = bht; c = cn; gd = gdt; gd3 = gd3t; m = mt; gl = glt; gh = ght; mx = mxt; on = ont; dk = 1;
);
function md_clr() instance(tlL, tlR, x1L, x2L, x1R, x2R) ( this.chL.dr_clr(); this.chR.dr_clr(); tlL = tlR = x1L = x2L = x1R = x2R = 0; );
function md_run(l, r) instance(c, cn, gd, gdt, gd3, gd3t, m, mt, gl, glt, gh, ght, mx, mxt, on, ont, dk, tlL, tlR, yl, yr,
                               bl, blt, bh, bht, x1L, x2L, x1R, x2R) local(w, og, iL, iR) (
  on += (ont - on) * dr_fc;
  on < 0.00001 && !ont ? ( on = 0; yl = l; yr = r; ) : (
    gd += (gdt - gd) * sm; gd3 += (gd3t - gd3) * sm; m += (mt - m) * sm; gl += (glt - gl) * sm; gh += (ght - gh) * sm;
    mx += (mxt - mx) * sm;
    cn != c ? ( dk -= dr_dkc; dk <= 0 ? ( dk = 0; c = cn; this.md_clr(); ); ) : dk < 1 ? dk = min(dk + dr_dkc, 1);
    og = m * dk * dk;
