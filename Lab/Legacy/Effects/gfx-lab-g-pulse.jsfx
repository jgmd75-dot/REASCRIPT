    x1R += (r - x1R) * dr_xc; x2R += (x1R - x2R) * dr_xc; iR = x2R * bl + (r - x2R) * bh;
    w = this.chL.dr_cir(c, iL, dr_cbL, dr_cgL, gd, gd3); tlL += (w - tlL) * dr_k1k; w = (tlL * gl + (w - tlL) * gh) * og + l - iL;
    yl = l + ((l + (w - l) * mx) - l) * on;
    w = this.chR.dr_cir(c, iR, dr_cbR, dr_cgR, gd, gd3); tlR += (w - tlR) * dr_k1k; w = (tlR * gl + (w - tlR) * gh) * og + r - iR;
    yr = r + ((r + (w - r) * mx) - r) * on;
  );
);

function vtrig(k, vel) instance(f0, pd, pe, pec, om, orr, ix, ie, iec, ol, oe, oec, pc, pm,
                               nl, ne, nec, nb, nbt, nbv, nbc, nbi, ml, me, mec, mt,
                               kl, kset, kmx, kmc, kw, kenv, kfc, xe, xec, xlc, xlp, ximp, xt, xn,
                               cl, ce, cec, vt, cr, crh, crc, crn, crq, amp, gl, gr, act, kbs, nfl, pfl, nt,
                               mp1, mp2, mp3, mp4, mp5, mp6, of, ofn, clp, clc)
                     local(b, tm, dm, tn, sn, i, f, t, r, mm) (
  b = 22 + k * 6;
  tm = 2 ^ (slider(b) / 12); dm = slider(b + 1) / 100; tn = slider(b + 2) / 100; sn = slider(b + 3) / 100;
  mm = (slider(b + 4) / 100);
  t = (slider(b + 5) / 100 + 1) * $pi * 0.25; gl = cos(t) * 1.4142; gr = sin(t) * 1.4142;
  model == 0 ? this.atrig(k, vel, tm, dm, tn, sn, mm * mm) : (
  recipe(model, k);
  model == 1 ? rix *= 0.25 + 1.5 * tn : model == 3 ? rix = min(rix * (0.4 + 1.2 * tn), 0.97) : 0;
  rnf *= 2 ^ ((tn - 0.5) * 1.5); rvf *= 2 ^ ((tn - 0.5) * (model == 0 ? 1 : 0.5));
  rpd *= 0.3 + 1.4 * sn; rcl *= 2 * sn;
  f0 = rf * tm; pd = rpd; pe = 1; pec = dcoef(rpt * dm);
  om = rom; orr = ror; ix = rix * (model == 1 ? 1 + sn : 1); ie = 1; iec = dcoef(rit * dm);
  ol = rol; oe = rol > 0; oec = dcoef(rod * dm); pc = 0; pm = 0;
  nl = rnl; ne = rnl > 0 || rkw > 0; nec = dcoef(rnd * dm); nb = rnb; nbt = 0; nbv = 1; nbc = dcoef(0.006); nbi = floor(0.011 * srate);
  nt = rnt; nfl.f_set(rnf * tm, rnq); nfl.f_clear();
  ml = rml; me = rml > 0; mec = dcoef(rmd * dm); mt = tm;
  mp1 = 0; mp2 = 0.17; mp3 = 0.41; mp4 = 0.63; mp5 = 0.29; mp6 = 0.83;
  cl = rcl; ce = rcl > 0; cec = dcoef(0.004);
  clc = k == 0 ? 1 - exp(-2 * $pi * 2500 / srate) : 1; clp = 0;
  of = 0; ofn = k == 0 && rom == 2 ? max(floor(0.0005 * srate), 1) : 0;
  vt = rvt; pfl.f_set(rvf * tm, rvq);
  cr = rcr; crc = 0; crn = max(1, floor(srate / (11000 + 29000 * tn))); crq = 128;
  kl = rkl; kset = rks; kw = rkw; kenv = 0;
  kbs = KB + k * 64; kmx = 0;
  rkl > 0 ? (
    i = 0;
    loop(6,
      f = rkf * tm * MR[kset * 6 + i];
      t = rkd * dm / (1 + rkdm * (1.6 - tn) * (MR[kset * 6 + i] - 1));
      r = f < srate * 0.45 ? exp(-6.9 / (max(t, 0.002) * srate)) : 0;
      kbs[i] = 2 * r * cos(2 * $pi * min(f, srate * 0.45) / srate); kbs[6 + i] = r * r;
      kbs[12 + i] = r > 0 ? MA[kset * 6 + i] * (1 - r * r) * 6 : 0;
      kbs[18 + i] = 0; kbs[24 + i] = 0;
      kmx = max(kmx, r);
      i += 1;
    );
    kmc = kmx; kmx = 1;
    xt = 0; xn = max(floor((0.006 - 0.0052 * sn) * srate), 2);
    xe = 1; xec = dcoef(0.012 - 0.01 * sn); xlc = 1 - exp(-2 * $pi * (1500 + 10000 * sn) / srate); xlp = 0; ximp = 0;
  ) : ( kmx = 0; xe = 0; );
  amp = mm * mm * vel * rtr;
  act = 1;
  );
);
function vrun() instance(f0, pd, pe, pec, om, orr, ix, ie, iec, ol, oe, oec, pc, pm,
                         nl, ne, nec, nb, nbt, nbv, nbc, nbi, ml, me, mec, mt,
                         kl, kset, kmx, kmc, kw, kenv, kfc, xe, xec, xlc, xlp, ximp, xt, xn,
                         cl, ce, cec, vt, cr, crh, crc, crn, crq, amp, gl, gr, act, kbs, nfl, pfl, nt,
                         mp1, mp2, mp3, mp4, mp5, mp6, p2, qa, of, ofn, clp, clc)
                local(y, ya, f, nz, w, d, x, i, a, env) (
  ya = qa ? this.arun() : 0;
  act ? (
    y = 0; nz = rand(2) - 1;
    oe > 0.0001 ? (
      f = f0 * (1 + pd * pe); pe *= pec;
      om == 0 ? ( pc += f / srate; pc -= floor(pc); x = sin(2 * $pi * pc); ) :
      om == 1 ? ( pc += f / srate; pc -= floor(pc); pm += f * orr / srate; pm -= floor(pm);
                  x = sin(2 * $pi * pc + ix * ie * sin(2 * $pi * pm)); ie *= iec; ) :
      om == 2 ? ( pc += f / srate; pc -= floor(pc); w = ix * ie; d = 0.5 * (1 - w); ie *= iec;
                  x = sin(2 * $pi * (pc < d ? pc * 0.5 / d : 0.5 + (pc - d) * 0.5 / (1 - d))); ) :
      om == 3 ? ( pc += f / srate; pc -= floor(pc); p2 += f * orr / srate; p2 -= floor(p2); x = 0.5 * (sq(pc) + sq(p2)); ) :
                ( pc += f / srate; pc -= floor(pc); p2 += f * orr / srate; p2 -= floor(p2);
                  x = 0.6 * sin(2 * $pi * pc) + 0.4 * sin(2 * $pi * p2); );
      of < ofn ? ( x *= 0.5 - 0.5 * cos($pi * of / ofn); of += 1; );
      y += x * ol * oe; oe *= oec;
    ) : oe = 0;
    ne > 0.0001 || kenv > 0.0001 ? (
      nb && nbt < 3 * nbi ? ( (nbt % nbi) == 0 ? nbv = 1; env = nbv; nbv *= nbc; nbt += 1; ) : ( env = ne; ne *= nec; );
      a = nl * env + kw * kenv;
      nfl.f_run(nz * a); y += nfl.f_out(nt);
    ) : ne = 0;
    me > 0.0001 ? (
      mp1 += 205.3 * mt / srate; mp2 += 304.4 * mt / srate; mp3 += 369.6 * mt / srate;
      mp4 += 522.7 * mt / srate; mp5 += 540 * mt / srate;   mp6 += 800 * mt / srate;
      x = (sq(mp1) + sq(mp2) + sq(mp3) + sq(mp4) + sq(mp5) + sq(mp6)) / 6;
      y += x * ml * me; me *= mec;
    ) : me = 0;
    kmx > 0.0001 ? (
      kset == 3 ? ( x = nz * (nb && nbt < 3 * nbi ? nbv : xe * 0.3); xe *= xec; ) :
                  ( xlp += (nz * xe - xlp) * xlc; x = xlp * 0.15 + (xt < xn ? sin($pi * xt / xn) * 2 / xn * 48000 / srate * 8 : 0); xt += 1; xe *= xec; );
      a = 0; i = 0;
      loop(6,
        w = kbs[i] * kbs[18 + i] - kbs[6 + i] * kbs[24 + i] + kbs[12 + i] * x;
        kbs[24 + i] = kbs[18 + i]; kbs[18 + i] = w;
        a += w; i += 1;
