desc:Autopan Mini [auto-pan] (GFX Lab)
//tags: pan autopan tremolo lfo modulation stereo mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-input, gfx-lab-drift, gfx-lab-lfo, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider22:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Pan,Trem}>-Mode
slider2:0<0,3,1{Sine,Triangle,Square,Random}>-Shape
slider3:60<0,100,1>-Smooth (%)
slider4:0<0,2,1{Free,Sync,Flow}>-Clock
slider5:0.12<0.01,20,0.001>-Free rate (Hz)
slider6:6<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Sync rate
slider7:0<0,360,1>-Phase (deg)
slider8:30<0,100,1>-Depth (%)
slider9:0<-100,100,1>-Centre (%)
slider10:5<0,50,1>-Rate wander (%)
slider11:10<0,50,1>-Depth wander (%)
slider12:0<0,50,1>-Centre wander (%)
slider13:0.25<0.01,2,0.001>-Wander speed (Hz)
slider14:0<0,1,1{Mono sum,Stereo}>-Input
slider15:0<-24,12,0.1>-Output (dB)
slider16:100<0,100,1>-Mix (%)
slider17:0<0,100,1>-Sat (%)
slider18:50<0,100,1>-Drift (%)
slider19:0<0,1,1{Off,On}>-Bypass
slider20:0<0,2,1{1x,2x,4x}>-Oversampling
slider21:prs_sel=0<0,9,1{No preset,Init,Gentle Sway,Classic Auto-Pan,Hard Ping-Pong,Wandering,Slow Swirl,Amp Trem,Choppy Trem,Warble Trem}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-lfo.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4194303, v); );
function psw_allg(v) ( slider_show(4194303, v); );
#ui_man = "gfx-lab-autopan-mini";
ext_noinit = 1;

HIST = 200000;
FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function ap_band(fs) local(w0, cw, alp, q0) (
  w0 = 2 * $pi * min(120, fs * 0.45) / fs; cw = cos(w0); alp = sin(w0) / (2 * 0.70710678); q0 = 1 + alp;
  ost_lb0 = (1 - cw) * 0.5 / q0; ost_lb1 = (1 - cw) / q0; ost_lb2 = ost_lb0;
  ost_la1 = -2 * cw / q0; ost_la2 = (1 - alp) / q0;
  w0 = 2 * $pi * min(6000, fs * 0.45) / fs; cw = cos(w0); alp = sin(w0) / (2 * 0.70710678); q0 = 1 + alp;
  ost_hb0 = (1 + cw) * 0.5 / q0; ost_hb1 = -(1 + cw) / q0; ost_hb2 = ost_hb0;
  ost_ha1 = -2 * cw / q0; ost_ha2 = (1 - alp) / q0;
  ost_envc = 1 - exp(-1 / (0.15 * fs));
);

function ap_setup() (
  ap_mode = slider1 >= 0.5;
  ap_shape = slider2 | 0;
  ap_smooth = slider3 / 100;
  ap_clk = slider4 | 0;
  ap_frate = min(max(slider5, 0.01), 20);
  ap_div = floor(slider6 + 0.5);
  ap_phoff = slider7 / 360;
  ap_dep_t = slider8 / 100;
  ap_cen_t = slider9 / 100;
  drift_macro(slider18);
  ap_rd = slider10 / 100 * dm_a;
  ap_dd = min(slider11 / 100 * dm_a, 1);
  ap_cd = slider12 / 100 * dm_a;
  ap_dspd = min(max(slider13, 0.01), 2) * dm_s;
  ap_mono_t = slider14 < 0.5;
  ap_out_t = 10 ^ (slider15 / 20);
  ap_mix_t = slider16 / 100;
  ap_sat = slider17 / 100;
  ap_fzt = 0.33 * min(max((slider17 - 50) / 50, 0), 1);
  in_setup(0, 1);
  ost_setup(ap_sat, 0.3, 120, 6000, -0.3, 0);
  ap_band(srate * os_f);
  lfo1.lfo_setup(ap_shape, ap_smooth);
  pdc_delay = os_lat(os_f);
);

function ap_rates() (
  ap_band(srate * os_f);
  fz_coefs(srate * os_f);
);
function ap_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  osbL.ost_ch_init(); osbR.ost_ch_init();
  fz_clr();
);

function setp(m, s, sm_, sy, fr, dv, dp, ct, r_, d_, c_) (
  slider1 = m; slider2 = s; slider3 = sm_; slider4 = sy; slider5 = fr; slider6 = dv;
  slider8 = dp; slider9 = ct; slider10 = r_; slider11 = d_; slider12 = c_;
);
function load_preset(p) (
  p == 1 ? (
    setp(0, 0, 60, 0, 0.12, 6, 30, 0, 5, 10, 0);
    slider7 = 0; slider13 = 0.25; slider14 = 0; slider15 = 0; slider16 = 100; slider17 = 0; slider18 = 50;
  ) :
  p == 2 ? setp(0, 0, 30, 1, 1,   2,  50, 0, 10, 15, 5 ) :
  p == 3 ? setp(0, 0, 30, 1, 1,   6, 100, 0,  3,  5, 0 ) :
  p == 4 ? setp(0, 2, 10, 1, 1,   9, 100, 0,  0,  0, 0 ) :
  p == 5 ? setp(0, 3, 100, 1, 1,  1,  70, 0, 20, 20, 15) :
  p == 6 ? setp(0, 0, 30, 0, 0.8, 6,  60, 0, 25, 15, 5 ) :
  p == 7 ? setp(1, 0, 30, 0, 5,   6,  60, 0,  3,  5, 0 ) :
  p == 8 ? setp(1, 2, 15, 1, 1,  12, 100, 0,  0,  0, 0 ) :
  p == 9 ? setp(1, 1, 30, 1, 1,  11,  50, 0, 15, 10, 0 );
  slider_automate(262143);
);

function ap_srinit() (
  ap_sr = srate;
  ap_sm = 1 - exp(-1 / (0.03 * srate));
  ap_sm2 = 1 - exp(-1 / (0.001 * srate));
  ap_xs = 1 - exp(-1 / (0.005 * srate));
  ap_jk = exp(-1 / (0.012 * srate));
  ap_fis = 1 / (0.01 * srate);
  ap_vuc = 1 - exp(-1 / (0.01 * srate));
  ap_setup(); ap_rates(); ap_clear();
);

os_design();
os_f = os_tf = os_f2n(slider20); os_base = 0;
ost_init(0);
osbL.ost_ch_init(); osbR.ost_ch_init();
in_init();
drR.drift_init(0.8 + rand(1) * 0.5);
drD.drift_init(0.8 + rand(1) * 0.5);
drC.drift_init(0.8 + rand(1) * 0.5);
lfo1.lfo_init();
ap_srinit();
ap_dep_s = ap_dep_t; ap_cen_s = ap_cen_t; ap_mix_s = ap_mix_t; ap_out_s = ap_out_t;
ap_xm = ap_mode; ap_ms = ap_mono_t;
ap_gmL = ap_gmR = ap_gsL = ap_gsR = ap_gt = 1;
fz_s = ap_fzt; fz_o = fz_s;
ap_fi = 1; ap_jo = 0; ap_lv = 0;
memset(HIST, 0, 128);
os_gsetup();
pdc_delay = os_lat(os_f);
pwr_init(); pwr_wu_loss = 0.3; pwr_wu_drv = 0.5; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;
by_setup(19);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(20, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); ap_setup(); prs_h0 = prs_hash();
      prs_q ? ( k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
ap_setup();
os_snap(slider(20));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != ap_sr ? ap_srinit();
ap_now = time_precise();
ap_tp > 0 && ap_now - ap_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > ap_gpp && play_position - ap_gpp < 4 * ap_gpd + 0.05) ? ( ap_clear(); ap_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
ap_tp = ap_now; ap_gpp = play_position; ap_gpd = samplesblock / srate;
pwr_block(slider19 < 0.5);
os_tf = os_f2n(slider20);
ap_setup();
lfo1.lfo_block(ap_clk, ap_div, ap_frate);
ap_sig = ap_shape * 100000 + ap_clk * 10000 + (ap_clk ? ap_div * 100 : 0) + (ap_clk == 1 ? (play_state & 1) : 0);
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
ap_vu_d = max(ap_vu_d, sqrt(ap_msq / max(samplesblock, 1))); ap_msq = 0;
ap_pk_d = max(ap_pk_d, ap_pkm); ap_pkm = 0;
os_snapb(slider(20));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
ap_iL = in_l; ap_iR = in_r;

ap_dinc = ap_dspd / srate;
ap_vR = drR.drift_tick(ap_dinc);
ap_vD = drD.drift_tick(ap_dinc);
ap_vC = drC.drift_tick(ap_dinc);

ap_dep_s += (ap_dep_t - ap_dep_s) * ap_sm;
ap_cen_s += (ap_cen_t - ap_cen_s) * ap_sm;
ap_mix_s += (ap_mix_t - ap_mix_s) * ap_sm;
ap_out_s += (ap_out_t - ap_out_s) * ap_sm;
ap_xm += (ap_mode - ap_xm) * ap_xs;
ap_ms += (ap_mono_t - ap_ms) * ap_xs;
fz_s += (ap_fzt - fz_s) * ap_sm; fz_s < 0.000001 && ap_fzt == 0 ? fz_s = 0; fz_o = fz_s;

ap_raw = lfo1.lfo_tick(ap_phoff, ap_rd, ap_vR);
ap_sig != ap_lsig ? ( ap_lsig = ap_sig; ap_jo += ap_lv - ap_raw; );
ap_jo *= ap_jk;
ap_lv = ap_raw + ap_jo;

ap_de = ap_dep_s * (1 - ap_dd * (0.5 + 0.5 * ap_vD));
ap_ce = ap_cen_s + ap_cd * ap_vC;

ap_g = 1 - ap_de * (0.5 - 0.5 * ap_lv);
ap_pos = min(max(ap_ce + ap_de * ap_lv, -1), 1);
ap_ang = (ap_pos + 1) * 0.25 * $pi;
ap_tmL = 1.41421356 * cos(ap_ang); ap_tmR = 1.41421356 * sin(ap_ang);
ap_tsL = ap_pos > 0 ? cos(ap_pos * 0.5 * $pi) : 1;
ap_tsR = ap_pos < 0 ? cos(-ap_pos * 0.5 * $pi) : 1;
ap_gmL += (ap_tmL - ap_gmL) * ap_sm2; ap_gmR += (ap_tmR - ap_gmR) * ap_sm2;
ap_gsL += (ap_tsL - ap_gsL) * ap_sm2; ap_gsR += (ap_tsR - ap_gsR) * ap_sm2;
ap_gt += (ap_g - ap_gt) * ap_sm2;

ap_m = 0.5 * (ap_iL + ap_iR);
ap_pL = ap_ms * ap_m * ap_gmL + (1 - ap_ms) * ap_iL * ap_gsL;
ap_pR = ap_ms * ap_m * ap_gmR + (1 - ap_ms) * ap_iR * ap_gsR;
ap_wL = ap_xm * ap_iL * ap_gt + (1 - ap_xm) * ap_pL;
ap_wR = ap_xm * ap_iR * ap_gt + (1 - ap_xm) * ap_pR;
ap_l = ap_iL * (1 - ap_mix_s) + ap_wL * ap_mix_s;
ap_r = ap_iR * (1 - ap_mix_s) + ap_wR * ap_mix_s;

pwr_in(ap_l, ap_r); ap_l = pwr_l; ap_r = pwr_r;
os_gate();
os_chg ? ( ap_rates(); ap_clear(); os_hold += 2 * samplesblock; );
ap_on = ap_sat > 0 || fz_o > 0;
ap_on || os_f > 1 ? (
  uxL.os_up(ap_l); uxR.os_up(ap_r);
  fz_l = osbL.ost_band(uxL.s0); fz_r = osbR.ost_band(uxR.s0); fz_o > 0.0001 ? fz_run(); ap_a0 = fz_l; ap_b0 = fz_r;
  os_f == 1 ? ( ap_l = ap_a0; ap_r = ap_b0; ) : (
    fz_l = osbL.ost_band(uxL.s1); fz_r = osbR.ost_band(uxR.s1); fz_o > 0.0001 ? fz_run(); ap_a1 = fz_l; ap_b1 = fz_r;
    os_f == 2 ? ( ap_l = dnL.os_dn(ap_a0, ap_a1, 0, 0); ap_r = dnR.os_dn(ap_b0, ap_b1, 0, 0); ) : (
      fz_l = osbL.ost_band(uxL.s2); fz_r = osbR.ost_band(uxR.s2); fz_o > 0.0001 ? fz_run(); ap_a2 = fz_l; ap_b2 = fz_r;
      fz_l = osbL.ost_band(uxL.s3); fz_r = osbR.ost_band(uxR.s3); fz_o > 0.0001 ? fz_run(); ap_a3 = fz_l; ap_b3 = fz_r;
      ap_l = dnL.os_dn(ap_a0, ap_a1, ap_a2, ap_a3); ap_r = dnR.os_dn(ap_b0, ap_b1, ap_b2, ap_b3);
    );
  );
) : (
  ap_l = osbL.ost_band(ap_l); ap_r = osbR.ost_band(ap_r);
);
ap_l *= in_comp * ap_out_s; ap_r *= in_comp * ap_out_s;
pwr_out(ap_l, ap_r); ap_l = pwr_l; ap_r = pwr_r;
ap_og = os_g * os_g * (3 - 2 * os_g);
ap_og < 1 ? ( ap_l *= ap_og; ap_r *= ap_og; );
ap_l != ap_l ? ap_l = 0; ap_r != ap_r ? ap_r = 0;
ap_fi < 1 ? (
  ap_fi = min(ap_fi + ap_fis, 1); ap_z = ap_fi * ap_fi * (3 - 2 * ap_fi);
  ap_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; ap_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  ap_l = ap_a + (ap_l - ap_a) * ap_z; ap_r = ap_b + (ap_r - ap_b) * ap_z;
);
ost_out(ap_l, ap_r);
spl0 = ost_l; spl1 = ost_r;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
by_out();
ap_msq += 0.5 * (spl0 * spl0 + spl1 * spl1);
ap_pkm = max(ap_pkm, max(abs(spl0), abs(spl1)));
ap_pos_d = ap_pos; ap_g_d = ap_gt; ap_ce_d = ap_ce; ap_de_d = ap_de; ap_ph_d = lfo1.p; ap_lv_d = ap_lv;

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x182033; mk_band = 0x0A0E18; mk_ink = 0xFAF2FA; mk_tab = 0xFE7A5C; mk_tink = 0x24201C;
mk_sub = 0x21293D; mk_hot = 0xFFD86A; mk_red = 0xFFD86A;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.3);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
