desc:HILO 26 [channel strip] (GFX Lab)
//tags: channel strip hybrid analogue digital preamp converter eq dynamic eq gate compressor spectrum
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power, gfx-lab-sidebar

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-24,12,0.1>-Trim (dB)
slider3:1<0,1,1{Off,On}>-Guard
slider4:22<11,550,1>-HPF (Hz)
slider5:22000<2200,22000,10>-LPF (Hz)
slider6:0<0,1,1{A,D}>-Front end
slider7:6<-12,30,0.1>-Gain (dB)
slider8:1<0,2,1{Clean 24-bit,Late 18-bit,Early 16-bit}>-Era
slider9:0<0,1,1{A,D}>-EQ voicing
slider10:110<22,880,1>-LF freq (Hz)
slider11:0<-15,15,0.1>-LF gain (dB)
slider12:0<0,1,1{Shelf,Peak}>-LF shape
slider13:440<110,3300,1>-LMF freq (Hz)
slider14:0<-15,15,0.1>-LMF gain (dB)
slider15:1<0.4,8,0.01>-LMF Q
slider16:0<0,1,1{Off,On}>-LMF dyn
slider17:2200<660,9900,1>-HMF freq (Hz)
slider18:0<-15,15,0.1>-HMF gain (dB)
slider19:1<0.4,8,0.01>-HMF Q
slider20:0<0,1,1{Off,On}>-HMF dyn
slider21:9900<2200,20000,10>-HF freq (Hz)
slider22:0<-15,15,0.1>-HF gain (dB)
slider23:0<0,1,1{Shelf,Peak}>-HF shape
slider24:1<0,1,1{Off,On}>-EQ in
slider25:1<0,1,1{Off,On}>-Cramp
slider26:0<0,1,1{A,D}>-Gate voicing
slider27:-45<-80,0,0.1>-Gate threshold (dB)
slider28:20<0,80,0.1>-Gate range (dB)
slider29:200<20,2000,1>-Gate release (ms)
slider30:1<0,1,1{Off,On}>-Spill
slider31:990<330,3300,1>-Spill tone (Hz)
slider32:0<0,1,1{Off,On}>-Gate in
slider33:0<0,1,1{A,D}>-Comp voicing
slider34:-12<-40,0,0.1>-Comp threshold (dB)
slider35:3<1,20,0.01>-Comp ratio
slider36:5<0.1,50,0.01>-Comp attack (ms)
slider37:200<20,2000,1>-Comp release (ms)
slider38:0<0,24,0.1>-Comp make-up (dB)
slider39:100<0,100,1>-Comp mix (%)
slider40:0<0,3,1{Off,110 Hz,220 Hz,330 Hz}>-Comp SC HPF
slider41:0<0,1,1{Off,On}>-Comp in
slider42:0<-24,12,0.1>-Level (dB)
slider43:50<0,100,1>-Drift (%)
slider44:1<0,2,1{1x,2x,4x}>-Oversampling
slider45:prs_sel=0<0,12,1{No preset,Init,Lead Vocal,Kick Room,Snare Spill,Toms Spill,Slap Bass,Bass DI,Acoustic,Glass Keys,Overheads,Sampler Crunch,Hot Preamp}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sidebar.jsfx-inc

@init
#ui_man = "gfx-lab-hilo-26";
ext_noinit = 1;

HA_SPI = 100000; HA_SPO = 104096; HA_SPN = 4096;
HA_HIS = 110000; HA_HN = 256;
HG_FFT = 131072;
HG_SMI = 140000; HG_SMO = 140400;

function ha_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function ha_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function ha_db(d) ( exp(d * 0.11512925464970228); );
function ha_lg(x) ( 8.685889638065035 * log(max(x, 0.0000000001)); );

function ha_ss(u) local(q) ( q = u * u; u / sqrt(sqrt(1 + q * q)) + 0.025 * q / (1 + q); );
function ha_fra(x) ( x = ha_rl * ha_ss(x * ha_g / ha_rl); x + this.sb_run(x); );
function ha_frd(x) local(q) (
  x *= ha_ag;
  q = x * 0.7071 * x * 0.7071;
  x = ha_rl * x / sqrt(1 + q * q);
  x += this.sb_run(x);
  q = x * x; q *= q; q *= q; q *= q;
  x / sqrt(sqrt(sqrt(sqrt(1 + q))));
);
function ha_match(g) local(i, a, y, s, s2) (
  s = s2 = 0; i = 0;
  loop(32, a = 0.12589 * sin((i + 0.5) / 32 * 2 * $pi); y = ha_ss(a * g); s += y; s2 += y * y; i += 1; );
  s2 = s2 / 32 - sqr(s / 32);
  0.0890215 / sqrt(max(s2, 0.0000000001));
);

function ha_svfc(f) local(g) (
  g = tan($pi * min(f, srate * 0.47) / srate);
  ha_c1 = 1 / (1 + g * (g + 1.4142135623730951)); ha_c2 = g * ha_c1; ha_c3 = g * ha_c2;
);
function ha_svf(x, a1, a2, a3) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; ha_bpo = v1; v2;
);
function ha_svfclr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function ha_svftidy() instance(ic1, ic2) ( ic1 = ha_tn(ic1); ic2 = ha_tn(ic2); );
function ha_bqc(t, f, q, gdb) local(ag, w, cw, sw, al, sA, a0) (
  ag = exp(gdb * 0.05756462732485115); w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); sw = sin(w);
  t == 3 ? (
    al = sw / (2 * q); a0 = 1 + al;
    ha_b0 = (1 - cw) * 0.5 / a0; ha_b1 = (1 - cw) / a0; ha_b2 = ha_b0; ha_a1 = -2 * cw / a0; ha_a2 = (1 - al) / a0;
  ) : t == 2 ? (
    al = sw / (2 * q); a0 = 1 + al / ag;
    ha_b0 = (1 + al * ag) / a0; ha_b1 = -2 * cw / a0; ha_b2 = (1 - al * ag) / a0; ha_a1 = ha_b1; ha_a2 = (1 - al / ag) / a0;
  ) : (
    al = sw * 0.7071067811865476; sA = 2 * sqrt(ag) * al;
    t == 0 ? (
      a0 = (ag + 1) + (ag - 1) * cw + sA;
      ha_b0 = ag * ((ag + 1) - (ag - 1) * cw + sA) / a0; ha_b1 = 2 * ag * ((ag - 1) - (ag + 1) * cw) / a0;
      ha_b2 = ag * ((ag + 1) - (ag - 1) * cw - sA) / a0; ha_a1 = -2 * ((ag - 1) + (ag + 1) * cw) / a0;
      ha_a2 = ((ag + 1) + (ag - 1) * cw - sA) / a0;
    ) : (
      a0 = (ag + 1) - (ag - 1) * cw + sA;
      ha_b0 = ag * ((ag + 1) + (ag - 1) * cw + sA) / a0; ha_b1 = -2 * ag * ((ag - 1) + (ag + 1) * cw) / a0;
      ha_b2 = ag * ((ag + 1) + (ag - 1) * cw - sA) / a0; ha_a1 = 2 * ((ag - 1) - (ag + 1) * cw) / a0;
      ha_a2 = ((ag + 1) - (ag - 1) * cw - sA) / a0;
    );
  );
);
function ha_bqset() instance(b0, b1, b2, a1, a2) ( b0 = ha_b0; b1 = ha_b1; b2 = ha_b2; a1 = ha_a1; a2 = ha_a2; );
function ha_bq(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
function ha_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function ha_bqtidy() instance(x1, x2, y1, y2) ( x1 = ha_tn(x1); x2 = ha_tn(x2); y1 = ha_tn(y1); y2 = ha_tn(y2); );

function ha_fstep(f) ( 110 * 2 ^ (floor(log(f / 110) / log(2) * 12 + 0.5) / 12); );
function ha_vstep(v) ( floor(v * 2 + 0.5) / 2; );
function ha_qstep(q) ( 2 ^ (floor(log(q) / log(2) * 3 + 0.5) / 3); );

function ha_band(snap, ft, gt, qt, pt, sh, t0, dy) instance(f, g, q, pk, dk, fc, gc, qc, tc) local(k, ge, qe, t, nw, fe, x, c) (
  k = snap ? 1 : ha_c16;
  f += (ft - f) * k; g += (gt - g) * k; q += (qt - q) * k;
  snap ? ( pk = pt; dk = 1; ) : sh && pt != pk ? ( dk = max(dk - ha_dks, 0); dk == 0 ? pk = pt; ) : dk = min(dk + ha_dks, 1);
  ge = g * dk * dk * (3 - 2 * dk) * dy;
  t = sh ? ( pk ? 2 : t0 ) : 2;
  qe = sh && !pk ? 0.7071 : q * (1 - ha_em + ha_em * (0.55 + 0.45 * min(abs(ge), 15) / 15));
  fe = exp(f);
  t == 2 && ha_cre > 0 ? ( x = $pi * fe / 48000; c = atan(x) / x; fe *= 1 + ha_cre * (c - 1); qe *= 1 + ha_cre * (c * (1 + x * x) - 1); );
  nw = snap || abs(fe - fc) > 0.0001 * fe || abs(ge - gc) > 0.0005 || abs(qe - qc) > 0.0005 || t != tc;
  nw ? ( fc = fe; gc = ge; qc = qe; tc = t; ha_bqc(t, fe, qe, ge); );
  nw;
);
function ha_dcoef(f) instance(c1, c2, c3) ( ha_svfc(f); c1 = ha_c1; c2 = ha_c2; c3 = ha_c3; );
function ha_damt(on) instance(fe, se, a, m) local(d) (
  d = ha_lg(fe) - ha_lg(se);
  a = fe > 0.0003 ? min(max((d - 2) / 8, 0), 1) : 0;
  m += ((on ? 1 : 0) - m) * ha_c16s;
  1 - m * (1 - a);
);

function ha_coefs(snap) local(k, ks) (
  k = snap ? 1 : ha_c16; ks = snap ? 1 : ha_c16s;
  ha_hf += (ha_hft - ha_hf) * k; ha_lf += (ha_lft - ha_lf) * k; ha_tf += (ha_tft - ha_tf) * k; ha_sf += (ha_sft - ha_sf) * k;
  snap || abs(ha_hf - ha_hfc) > 0.0001 ? ( ha_hfc = ha_hf; ha_svfc(exp(ha_hf)); ha_h1 = ha_c1; ha_h2 = ha_c2; ha_h3 = ha_c3; );
  snap || abs(ha_lf - ha_lfc) > 0.0001 ? ( ha_lfc = ha_lf; ha_svfc(exp(ha_lf)); ha_l1 = ha_c1; ha_l2 = ha_c2; ha_l3 = ha_c3; );
  snap || abs(ha_tf - ha_tfc) > 0.0001 ? ( ha_tfc = ha_tf; ha_svfc(exp(ha_tf)); ha_s1 = ha_c1; ha_s2 = ha_c2; ha_s3 = ha_c3; );
  snap || abs(ha_sf - ha_sfc) > 0.0001 ? ( ha_sfc = ha_sf; ha_svfc(exp(ha_sf)); ha_k1 = ha_c1; ha_k2 = ha_c2; ha_k3 = ha_c3; );
  ha_eq += (ha_eqt - ha_eq) * k;
  ha_em += (ha_emt - ha_em) * ks; ha_cre += ((1 - ha_emt) * ha_crt - ha_cre) * ks;
  ha_dy2 = haD2.ha_damt(ha_d2t); ha_dy3 = haD3.ha_damt(ha_d3t);
  haB1.ha_band(snap, ha_f1t, ha_g1t * ha_eq, 0.9, ha_p1t, 1, 0, 1) ? ( e1L.ha_bqset(); e1R.ha_bqset(); );
  haB2.ha_band(snap, ha_f2t, ha_g2t * ha_eq, ha_q2t, 0, 0, 0, ha_dy2) ? ( e2L.ha_bqset(); e2R.ha_bqset(); );
  haB3.ha_band(snap, ha_f3t, ha_g3t * ha_eq, ha_q3t, 0, 0, 0, ha_dy3) ? ( e3L.ha_bqset(); e3R.ha_bqset(); );
  haB4.ha_band(snap, ha_f4t, ha_g4t * ha_eq, 0.9, ha_p4t, 1, 1, 1) ? ( e4L.ha_bqset(); e4R.ha_bqset(); );
  dt2.ha_dcoef(exp(haB2.f)); dt3.ha_dcoef(exp(haB3.f));
);
function ha_fixed() (
  ha_bqc(3, 20000, 0.52, 0); aE1L.ha_bqset(); aE1R.ha_bqset();
  ha_bqc(3, 20000, 0.75, 0); aE2L.ha_bqset(); aE2R.ha_bqset();
  ha_bqc(3, 20000, 2.2, 0); aE3L.ha_bqset(); aE3R.ha_bqset();
  ha_bqc(1, 15000, 0.7, -2); dEL.ha_bqset(); dER.ha_bqset();
  ha_bqc(3, 21000, 0.7071, 0); aLL.ha_bqset(); aLR.ha_bqset();
);
function ha_clrA() ( uaL.os_clr(); uaR.os_clr(); shL.sb_clr(); shR.sb_clr(); );
function ha_clrD() ( udL.os_clr(); udR.os_clr(); sdL.sb_clr(); sdR.sb_clr(); );
function ha_clrE1() ( aLL.ha_bqclr(); aLR.ha_bqclr(); );
function ha_clrE2() ( aE1L.ha_bqclr(); aE1R.ha_bqclr(); aE2L.ha_bqclr(); aE2R.ha_bqclr(); aE3L.ha_bqclr(); aE3R.ha_bqclr(); dEL.ha_bqclr(); dER.ha_bqclr(); );
function ha_clear() ( uxL.os_clr(); uxR.os_clr(); ha_clrA(); ha_clrD(); sb_rate(srate * os_f); );
function ha_reset() (
  ha_clear(); ha_clrE1(); ha_clrE2(); memset(BY_BUF, 0, 2 * BY_N);
  hpL.ha_svfclr(); hpR.ha_svfclr(); lpL.ha_svfclr(); lpR.ha_svfclr(); spL.ha_svfclr(); spR.ha_svfclr(); scL.ha_svfclr(); scR.ha_svfclr();
  dt2.ha_svfclr(); dt3.ha_svfclr();
  e1L.ha_bqclr(); e1R.ha_bqclr(); e2L.ha_bqclr(); e2R.ha_bqclr(); e3L.ha_bqclr(); e3R.ha_bqclr(); e4L.ha_bqclr(); e4R.ha_bqclr();
  ha_dxl = ha_dyl = ha_dxr = ha_dyr = 0; ha_env = 0;
  ha_ge = 0; ha_gg = 0; ha_go = 0; ha_ce = 0; ha_grs = 0;
  haD2.fe = haD2.se = haD3.fe = haD3.se = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  ha_fi = 0;
);

#ha_pm = "Init|Lead Vocal|Kick Room|Snare Spill|Toms Spill|Slap Bass|Bass DI|Acoustic|Glass Keys|Overheads|Sampler Crunch|Hot Preamp";
function ha_pa(fm, gn, er, hp, lp, em, f1, g1, p1, f2) (
  slider6 = fm; slider7 = gn; slider8 = er; slider4 = hp; slider5 = lp; slider9 = em; slider10 = f1; slider11 = g1; slider12 = p1; slider13 = f2;
);
function ha_pb(g2, q2, d2, f3, g3, q3, d3, f4, g4, p4) (
  slider14 = g2; slider15 = q2; slider16 = d2; slider17 = f3; slider18 = g3; slider19 = q3; slider20 = d3; slider21 = f4; slider22 = g4; slider23 = p4;
);
function ha_pc(cr, gm, gt, gr, gl, sp, tn, gi, cm, ct) (
  slider25 = cr; slider26 = gm; slider27 = gt; slider28 = gr; slider29 = gl; slider30 = sp; slider31 = tn; slider32 = gi; slider33 = cm; slider34 = ct;
);
function ha_pd(cq, ca, cl, mx, sh, ci, lv) (
  slider35 = cq; slider36 = ca; slider37 = cl; slider39 = mx; slider40 = sh; slider41 = ci; slider42 = lv;
);
function load_preset(p) local(i) (
  slider2 = 0; slider3 = 1; slider24 = 1;
  p == 1 || p == 13 ? ( ha_pa(0,  6, 1,  22, 22000, 0,  110,  0, 0,  440); ha_pb( 0, 1,   0,  2200,  0, 1,   0,  9900,  0, 0); ha_pc(1, 0, -45, 20, 200, 1,  990, 0, 0, -12); ha_pd(3,  5,   200, 100, 0, 0,  0); ) :
  p == 2  ? ( ha_pa(1,  9, 1,  88, 22000, 0,  110,  0, 0,  330); ha_pb(-2, 1.2, 0,  3300, -4, 1.6, 1, 11000,  3, 0); ha_pc(1, 0, -50,  6, 300, 1, 1320, 1, 1, -20); ha_pd(3,  4,   200, 100, 1, 1,  0); ) :
  p == 3  ? ( ha_pa(0,  8, 1,  33, 11000, 0,   66,  5, 1,  330); ha_pb(-6, 1.6, 0,  3300,  4, 1.4, 0,  9900,  0, 0); ha_pc(1, 0, -30, 18, 180, 1,  660, 1, 0, -14); ha_pd(4, 20,   120, 100, 0, 1,  0); ) :
  p == 4  ? ( ha_pa(0,  8, 1,  88, 22000, 0,  220,  3, 1,  550); ha_pb(-3, 1.4, 0,  5500,  4, 1.2, 0, 11000,  2, 0); ha_pc(1, 0, -28, 15, 150, 1,  990, 1, 1, -16); ha_pd(4,  3,   150,  70, 1, 1,  0); ) :
  p == 5  ? ( ha_pa(0,  8, 1,  55, 16000, 0,  110,  4, 1,  440); ha_pb(-5, 1.2, 0,  4400,  3, 1.2, 0,  9900,  0, 0); ha_pc(1, 0, -34, 20, 400, 1,  770, 1, 0, -14); ha_pd(3, 10,   300, 100, 0, 1,  0); ) :
  p == 6  ? ( ha_pa(1, 12, 1,  33, 22000, 1,   88,  3, 0,  550); ha_pb(-3, 1.4, 0,  2200,  5, 1.4, 0,  9900,  2, 0); ha_pc(1, 1, -60, 20, 120, 0,  990, 0, 1, -20); ha_pd(6,  1,   120, 100, 0, 1,  0); ) :
  p == 7  ? ( ha_pa(0, 12, 1,  33,  8800, 0,   88,  3, 0,  660); ha_pb( 2, 1,   0,  2200,  2, 1,   0,  9900,  0, 0); ha_pc(1, 0, -60, 20, 200, 1,  990, 0, 0, -18); ha_pd(4, 15,   200, 100, 0, 1,  0); ) :
  p == 8  ? ( ha_pa(0,  6, 1, 110, 22000, 0,  220, -2, 1,  330); ha_pb(-3, 1,   1,  4400,  2, 0.7, 0, 13000,  4, 0); ha_pc(1, 0, -60, 20, 200, 1,  990, 0, 0, -16); ha_pd(2.5, 12, 300, 100, 1, 1,  0); ) :
  p == 9  ? ( ha_pa(1,  6, 1,  55, 22000, 1,  110,  0, 0,  440); ha_pb(-2, 1,   0,  4400,  2, 0.7, 0, 13000,  4, 0); ha_pc(1, 1, -60, 20, 200, 0,  990, 0, 1, -16); ha_pd(3,  5,   250, 100, 0, 1,  0); ) :
  p == 10 ? ( ha_pa(0,  4, 1, 110, 22000, 0,  220, -2, 0,  440); ha_pb(-1, 0.8, 0,  3300, -2, 1.5, 1, 13000,  3, 0); ha_pc(1, 0, -60, 20, 200, 1,  990, 0, 0, -10); ha_pd(2, 20,   400,  60, 2, 1,  0); ) :
  p == 11 ? ( ha_pa(1,  0, 2,  44, 22000, 1,  110,  3, 0,  880); ha_pb( 2, 1,   0,  3300,  3, 1.4, 0,  9900, -3, 0); ha_pc(1, 1, -60, 20, 100, 0,  990, 0, 1, -18); ha_pd(8,  0.3,  80, 100, 0, 1,  2); ) :
  p == 12 ? ( ha_pa(0, 26, 1,  33, 22000, 0,  110,  2, 0,  550); ha_pb(-2, 1,   0,  2200,  2, 1,   0,  9900,  0, 0); ha_pc(1, 0, -60, 20, 200, 1,  990, 0, 0, -12); ha_pd(3,  5,   200, 100, 0, 0, -3); );
  slider38 = floor(0.5 * (1 - 1 / slider35) * max(0, -12 - slider34) * 2 + 0.5) / 2;
  p == 13 ? slider43 = 50;
  i = 2; loop(41, ui_auto(i); i += 1; ); ui_auto(43);
  pr_cur = p == 13 ? 1 : p;
);

function ha_srinit() (
  ha_sr = srate;
  c_kn = ha_tc(30);
  ha_vuc = ha_tc(300);
  ha_c16 = 1 - exp(-16 / (0.03 * srate));
  ha_c16s = 1 - exp(-16 / (0.015 * srate));
  ha_dks = 16 / (0.006 * srate);
  ha_dcc = 1 - 2 * $pi * 5 / srate;
  c_sw = ha_tc(15);
  ha_xs = 1 / (0.015 * srate);
  ha_ea = ha_tc(4); ha_er = ha_tc(80);
  ha_dfa = ha_tc(5); ha_dfr = ha_tc(100); ha_dsl = ha_tc(1500);
  ha_rnd = ha_tc(25);
  ha_fis = 1 / (0.01 * srate);
  ha_hsn = floor(0.02 * srate);
  ha_fixed();
  ost_init(0);
  ha_clear();
  ha_cc = 0;
);
os_design();
os_f = os_tf = os_f2n(slider44); os_base = 0;
ha_srinit();
os_gsetup();
in_init();
dSup.drift_init(0.8 + rand(1) * 0.4); dVc.drift_init(0.6 + rand(1) * 0.4); dGt.drift_init(0.7 + rand(1) * 0.4);
drift_mm_init();
drift_macro(50);
pwr_init(); pwr_hum_db = -84; pwr_sag = 0.15; pwr_wu_loss = 0.4; pwr_wu_drv = 0.8; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;
ha_sd = 22222;
ha_snap = 1; ha_fi = 1; ha_rl = 1;
ha_fa = slider6 < 0.5; ha_e0 = slider8 < 0.5; ha_e1 = slider8 >= 0.5 && slider8 < 1.5; ha_e2 = slider8 >= 1.5;
ha_gm = slider26 < 0.5; ha_cm = slider33 < 0.5;
pdc_delay = os_lat(os_f);
by_setup(1);
