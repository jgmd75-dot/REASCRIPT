desc:MAG78 Mini [tape saturation] (GFX Lab)
//tags: saturation tape analogue mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-thick, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider25:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:in_db=0<-24,24,0.1>-Input gain (dB)
slider2:model=0<0,9,1{Valve,Punch,Tight,Fat,Master,Warm,Crisp,Smooth,Pristine,Push}>-Tape model
slider3:speed=1<0,3,1{Low,15 ips,30 ips,HD}>-Reel speed
slider4:sat_amt=67<0,100,1>-Saturation (%)
slider5:sat_mode=1<0,2,1{Tube,Tape,Both}>-Saturation mode
slider6:colour=0<0,2,1{Natural,Vintage,Modern}>-Tape colour
slider7:lo_mode=0<0,2,1{Thump,Weight,Bloom}>-Lows mode
slider8:lo_amt=0<-10,10,0.1>-Lows amount (dB)
slider9:hi_mode=0<0,2,1{Edge,Presence,Sheen}>-Highs mode
slider10:hi_amt=0<-10,10,0.1>-Highs amount (dB)
slider11:link=0<0,1,1{Off,On}>-Lows / highs link
slider12:lo_in=1<0,1,1{Off,On}>-Lows in
slider13:hi_in=1<0,1,1{Off,On}>-Highs in
slider14:wow=5<0,100,1>-Wow (%)
slider15:flutter=10<0,100,1>-Flutter (%)
slider16:swap=0<0,1,1{Saturation first,Colour first}>-Order
slider17:mix=100<0,100,1>-Mix (%)
slider18:out_db=0<-24,24,0.1>-Output level (dB)
slider19:drift=50<0,100,1>-Drift (%)
slider20:byp=0<0,1,1{Off,On}>-Bypass
slider21:thick=0<0,1,1{Off,On}>-THICK
slider22:zs=0<-100,100,1>-Band balance (comp - exp, %)
slider23:os_sel=1<0,2,1{1x,2x,4x}>-Oversampling
slider24:prs_sel=0<0,12,1{No preset,Default,Master Bus Glue,Hot 2-Inch Punch,Cassette Lo-Fi,Vocal Warmth,Drum Bus Crunch,High-Speed Mastering Sheen,Bass Fatness,Subtle Tape Sheen,Saturated Parallel,Vintage Slap,Lo-Fi Warmth}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(33554431, v); );
function psw_allg(v) ( slider_show(33554431, v); );
#ui_man = "gfx-lab-mag78-mini";
ext_noinit = 1;

MT = 200;
MW = 16;
DRY = 2000; DRYN = 1024;
WWL = 5000; WWR = 8000; WWN = 2048;
D0 = max(8, floor(0.00145 * srate + 0.5) - 31);

os_design(); os_base = D0; os_f = os_tf = os_f2n(os_sel);

function mg_bq(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs;  cw = cos(w0);  sw = sin(w0);  al = sw / (2 * q);  amp = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al;  b0 = (1 - cw) * 0.5 / n;  b1 = (1 - cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al;  b0 = (1 + cw) * 0.5 / n;  b1 = -(1 + cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / amp;  b0 = (1 + al * amp) / n;  b1 = -2 * cw / n;  b2 = (1 - al * amp) / n;  a1 = b1;  a2 = (1 - al / amp) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n;  b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n;  a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;  a2 = ((amp + 1) - (amp - 1) * cw - sa) / n; ) :
  ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n;  b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n;  a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;  a2 = ((amp + 1) + (amp - 1) * cw - sa) / n; );
);
function mg_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;  x2 = x1;  x1 = x;  y2 = y1;  y1 = y;  y;
);
function mg_tidy() instance(x1, x2, y1, y2) ( abs(y1) + abs(y2) < 0.000000000001 ? x1 = x2 = y1 = y2 = 0; );
function mg_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function tp_s(u) ( u / sqrt(1 + u * u); );
function tp_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function tp_core(h, b, r, wk) instance(u1, f1, p, env, ok) local(u, f, m, a, w, d) (
  !ok ? ( u1 = b;  f1 = sqrt(1 + b * b);  ok = 1; );
  u = h + b;  f = sqrt(1 + u * u);
  m = abs(u - u1) > 0.00001 ? (f - f1) / (u - u1) : tp_s(0.5 * (u + u1));
  u1 = u;  f1 = f;
  m -= tp_s(b);
  a = abs(m);  env = a > env ? env + (a - env) * tp_ka : env * tp_kr;
  w = wk * env * env;
  w > 0.000001 ? ( d = m - p;  p = m - w * tp_tanh(d / w); ) : p = m;
  m + r * (p - m);
);
function tp_reset() instance(u1, f1, p, env, ok) ( u1 = 0; f1 = 1; p = 0; env = 0; ok = 0; );

function md(i, drv, r, wk, asy, emp, bf, bg, bq, mf, mg, hf, hq, hs, lf) local(p) (
  p = MT + i * MW;
  p[0] = drv; p[1] = r; p[2] = wk; p[3] = asy; p[4] = emp; p[5] = bf; p[6] = bg; p[7] = bq;
  p[8] = mf; p[9] = mg; p[10] = hf; p[11] = hq; p[12] = hs; p[13] = lf;
);
md(0, 1.3, 0.60, 0.50, 0.10, 5.0, 60, 2.5, 1.0, 400,  1.0, 14000, 0.62, -2.0, 25);
md(1, 1.2, 0.50, 0.40, 0.06, 4.0, 70, 2.5, 1.2, 1500, 0.8, 19000, 0.75, -0.5, 30);
md(2, 1.0, 0.40, 0.30, 0.03, 3.0, 55, 2.0, 1.4, 1000, 0.0, 21000, 0.80,  0.0, 22);
md(3, 1.25, 0.55, 0.45, 0.07, 4.5, 50, 3.5, 1.0, 250,  0.8, 17000, 0.70, -1.0, 20);
md(4, 0.85, 0.35, 0.30, 0.02, 3.0, 45, 3.0, 1.2, 1000, 0.0, 23000, 0.75,  0.3, 18);
md(5, 1.15, 0.50, 0.40, 0.05, 4.0, 65, 2.5, 1.0, 700,  0.5, 17500, 0.70, -0.8, 25);
md(6, 1.1, 0.45, 0.35, 0.05, 3.5, 75, 2.0, 1.3, 2000, 0.7, 20000, 0.80,  0.5, 24);
md(7, 0.95, 0.40, 0.30, 0.03, 3.0, 60, 2.0, 1.5, 1000, 0.0, 21000, 0.75,  0.0, 20);
md(8, 0.8, 0.30, 0.25, 0.02, 2.5, 55, 1.5, 1.6, 1000, 0.0, 23000, 0.72,  0.2, 18);
md(9, 1.45, 0.55, 0.45, 0.08, 4.5, 80, 2.5, 1.1, 1200, 1.5, 18000, 0.90,  0.8, 30);

TRM = 600;
TRM[0] = 1.66; TRM[1] = 0.79; TRM[2] = 0.62; TRM[3] = 0.50;
TRM[4] = 1.41; TRM[5] = 0.70; TRM[6] = 0.65; TRM[7] = 0.52;
TRM[8] = 1.29; TRM[9] = 0.70; TRM[10] = 0.69; TRM[11] = 0.57;
TRM[12] = 1.44; TRM[13] = 0.47; TRM[14] = 0.26; TRM[15] = 0.52;
TRM[16] = 1.13; TRM[17] = 0.49; TRM[18] = 0.38; TRM[19] = 0.57;
TRM[20] = 1.40; TRM[21] = 0.65; TRM[22] = 0.56; TRM[23] = 0.53;
TRM[24] = 1.21; TRM[25] = 0.56; TRM[26] = 0.54; TRM[27] = 0.52;
TRM[28] = 1.24; TRM[29] = 0.67; TRM[30] = 0.65; TRM[31] = 0.57;
TRM[32] = 1.08; TRM[33] = 0.63; TRM[34] = 0.63; TRM[35] = 0.57;
TRM[36] = 1.45; TRM[37] = 0.50; TRM[38] = 0.44; TRM[39] = 0.47;

TG = 400; GV = 450;
function tp_targets(m, s) local(p) (
  p = MT + m * MW;
  memcpy(TG, p, 14);
  TG[30] = TRM[m * 4 + s];
  s == 0 ? (
    TG[0] *= 1.3; TG[2] *= 1.3; TG[4] += 4; TG[5] *= 0.6; TG[6] *= 0.7; TG[10] = TG[10] * 0.55; TG[11] = 0.6;
    TG[12] -= 2; TG[13] *= 0.8;
  ) : s == 2 ? (
    TG[0] *= 0.9; TG[1] *= 0.85; TG[4] -= 1; TG[5] *= 1.7; TG[7] *= 0.8; TG[10] *= 1.25; TG[13] *= 1.25;
  ) : s == 3 ? (
    TG[0] *= 0.3; TG[1] *= 0.2; TG[2] *= 0.3; TG[3] *= 0.3; TG[4] = 0; TG[6] = 0; TG[9] *= 0.3;
    TG[10] = 22000; TG[11] = 0.7071; TG[12] = 0; TG[13] = 10;
  );
);
function tp_cal(d, b) local(i, s, u, sb) (
  s = 0; i = 0; sb = tp_s(b);
  loop(32, u = d * 0.17783 * sin(2 * $pi * (i + 0.5) / 32);  s += sqr(tp_s(u + b) - sb);  i += 1; );
  sqrt(s / 32) / (d * 0.17783 * 0.70711);
);

function tp_coefs() local(fso, dr, cal) (
  fso = os_f * srate;
  dr = GV[0] * exp(0.4 * 0.11512925 * drD * dm_a);
  mt_d = dr;
  mt_b = GV[3] * (1 + 0.6 * drA * dm_a);
  cal = tp_cal(dr, mt_b);
  mt_comp = exp(GV[30] * 0.11512925) / (dr * cal);
  mg_r = GV[1];  mg_wk = GV[2];
  cL.EM.mg_bq(3, 3000, 0.6, GV[4], fso);  cR.EM.mg_bq(3, 3000, 0.6, GV[4], fso);
  cL.DM.mg_bq(3, 3000, 0.6, -GV[4], fso); cR.DM.mg_bq(3, 3000, 0.6, -GV[4], fso);
  BPL.mg_bq(2, GV[5], GV[7], GV[6], srate);           BPR.mg_bq(2, GV[5], GV[7], GV[6], srate);
  DPL.mg_bq(2, GV[5] * 2.3, 1.2, -0.45 * GV[6], srate); DPR.mg_bq(2, GV[5] * 2.3, 1.2, -0.45 * GV[6], srate);
  MCL.mg_bq(2, GV[8], 0.8, GV[9], srate);             MCR.mg_bq(2, GV[8], 0.8, GV[9], srate);
  GLL.mg_bq(0, GV[10] * (1 + 0.03 * drT * dm_a), GV[11], 0, srate);  GLR.mg_bq(0, GV[10] * (1 + 0.03 * drT * dm_a), GV[11], 0, srate);
  HSL.mg_bq(3, 10000, 0.7, GV[12], srate);            HSR.mg_bq(3, 10000, 0.7, GV[12], srate);
  LCL.mg_bq(1, GV[13], 0.6, 0, srate);                LCR.mg_bq(1, GV[13], 0.6, 0, srate);
);

function st_f(u, kp, kn) ( u >= 0 ? u / (1 + kp * u) : u / (1 - kn * u); );
function st_ad(u, kp, kn) ( u >= 0 ? u / kp - log(1 + kp * u) / (kp * kp) : -u / kn - log(1 - kn * u) / (kn * kn); );
function st_run(u, kp, kn) instance(u1, f1, ok) local(f, y) (
  !ok ? ( f1 = st_ad(u1, kp, kn); ok = 1; );
  f = st_ad(u, kp, kn);
  y = abs(u - u1) > 0.00001 ? (f - f1) / (u - u1) : st_f(0.5 * (u + u1), kp, kn);
  u1 = u;  f1 = f;  y;
);
function st_skip(u) instance(u1, ok) ( u1 = u; ok = 0; 0; );
function st_clr() instance(u1, f1, ok) ( u1 = 0; f1 = 0; ok = 0; );
ST_KP = 0.25; ST_KN = 1.2; ST_B = 0;
SP_K = 0.85;
function st_cal(md, g) local(i, s, u, v, sb) (
  s = 0; i = 0; sb = st_f(ST_B, ST_KP, ST_KN);
  loop(32,
    u = g * 0.17783 * sin(2 * $pi * (i + 0.5) / 32);
    v = md == 1 ? st_f(u, SP_K, SP_K) : st_f(u + ST_B, ST_KP, ST_KN) - sb;
    md == 2 ? v = st_f(v * 0.8, SP_K, SP_K) / 0.8;
    s += v * v;  i += 1;
  );
  sqrt(s / 32) / (g * 0.17783 * 0.70711);
);

function col_targets(c) (
  c == 1 ? ( TG[14] = 1.8; TG[15] = -1.0; TG[16] = -2.5; ) :
  c == 2 ? ( TG[14] = -1.2; TG[15] = 1.2; TG[16] = 2.0; ) :
           ( TG[14] = 0; TG[15] = 0; TG[16] = 0; );
);
function eq_targets() local(a, b) (
  a = lo_amt * (lo_in > 0.5);  b = hi_amt * (hi_in > 0.5);
  lo_mode == 0 ? ( TG[17] = 110; TG[18] = a;       TG[19] = 0.7; TG[20] = 320; TG[21] = -0.3 * a;  TG[22] = 1.2; ) :
  lo_mode == 1 ? ( TG[17] = 80;  TG[18] = 0.3 * a; TG[19] = 0.7; TG[20] = 220; TG[21] = 0.8 * a;   TG[22] = 0.6; ) :
                 ( TG[17] = 55;  TG[18] = a;       TG[19] = 1.0; TG[20] = 180; TG[21] = -0.35 * a; TG[22] = 0.9; );
  hi_mode == 0 ? ( TG[23] = 9000;  TG[24] = 0.4 * b; TG[25] = 0.7; TG[26] = 4500;  TG[27] = 0.7 * b; TG[28] = 0.9; ) :
  hi_mode == 1 ? ( TG[23] = 10000; TG[24] = -0.2 * b; TG[25] = 0.7; TG[26] = 2800; TG[27] = b;       TG[28] = 1.3; ) :
                 ( TG[23] = 12000; TG[24] = b;       TG[25] = 0.8; TG[26] = 16000; TG[27] = 0.3 * b; TG[28] = 0.8; );
);
NGV = 31;

function sat_coefs() local(a, g) (
  a = 0.45 * GV[29];
  g = 10 ^ ((-6 + 30 * a) / 20);
  mt_sg = g;
  mt_sw = min(1, a * 5);
  mt_c0 = 1 / (g * st_cal(0, g));  mt_c1 = 1 / (g * st_cal(1, g));  mt_c2 = 1 / (g * st_cal(2, g));
);
function eq_coefs() local(fso) (
  fso = os_f * srate;
  cL.CA.mg_bq(2, 250, 0.7, GV[14], fso);   cR.CA.mg_bq(2, 250, 0.7, GV[14], fso);
  cL.CB.mg_bq(2, 3000, 0.8, GV[15], fso);  cR.CB.mg_bq(2, 3000, 0.8, GV[15], fso);
  cL.CS.mg_bq(3, 9000, 0.7, GV[16], fso);  cR.CS.mg_bq(3, 9000, 0.7, GV[16], fso);
  L1L.mg_bq(4, GV[17], GV[19], GV[18], srate);  L1R.mg_bq(4, GV[17], GV[19], GV[18], srate);
  L2L.mg_bq(2, GV[20], GV[22], GV[21], srate);  L2R.mg_bq(2, GV[20], GV[22], GV[21], srate);
  H1L.mg_bq(3, GV[23], GV[25], GV[24], srate);  H1R.mg_bq(3, GV[23], GV[25], GV[24], srate);
  H2L.mg_bq(2, GV[26], GV[28], GV[27], srate);  H2R.mg_bq(2, GV[26], GV[28], GV[27], srate);
);

function sat_run(x) instance(STU, STP, SB1, SB2) local(t, p, b, y) (
  t = w_tu > 0.0001 ? STU.st_run(x * mg_sg + ST_B, ST_KP, ST_KN) - mg_sb : STU.st_skip(x * mg_sg + ST_B);
  p = w_tp > 0.0001 ? STP.st_run(x * mg_sg, SP_K, SP_K) : STP.st_skip(x * mg_sg);
  w_bo > 0.0001 ? (
    b = SB2.st_run(0.8 * (SB1.st_run(x * mg_sg + ST_B, ST_KP, ST_KN) - mg_sb), SP_K, SP_K) / 0.8;
  ) : ( SB1.st_skip(x * mg_sg + ST_B); b = 0; SB2.st_skip(0.8 * (st_f(x * mg_sg + ST_B, ST_KP, ST_KN) - mg_sb)); );
  y = w_tu * t * mg_c0 + w_tp * p * mg_c1 + w_bo * b * mg_c2;
  x + mg_sw * (y - x);
);
function sat_clr() instance(STU, STP, SB1, SB2) ( STU.st_clr(); STP.st_clr(); SB1.st_clr(); SB2.st_clr(); );
function col_run(x) instance(CA, CB, CS) ( CS.mg_run(CB.mg_run(CA.mg_run(x))); );
function ch2x(x) instance(EM, DM) (
  x = o_swap ? this.sat_run(this.col_run(x)) : this.col_run(this.sat_run(x));
  DM.mg_run(this.tp_core(EM.mg_run(x * o_duck) * mg_d, mg_b, mg_r, mg_wk));
);
function ch_clr() instance(EM, DM, CA, CB, CS) (
  EM.mg_clr(); DM.mg_clr(); CA.mg_clr(); CB.mg_clr(); CS.mg_clr(); this.sat_clr(); this.tp_reset();
);

function hm(b, n, pos, d) local(i, f, xm, x0, x1, x2, c1, c2, c3) (
  i = floor(d);  f = d - i;
  xm = b[(pos - i + 1 + n) % n];  x0 = b[(pos - i + n) % n];  x1 = b[(pos - i - 1 + n) % n];  x2 = b[(pos - i - 2 + n) % n];
  c1 = 0.5 * (x1 - xm);  c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2;  c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);

ZSG = 11000;
function zs_split(x) instance(ZA, ZB, ZC) local(lf, r1, lm, r2, hm) (
  lf = ZA.mg_run(x);  r1 = x - lf;  lm = ZB.mg_run(r1);  r2 = r1 - lm;  hm = ZC.mg_run(r2);
  zs_b0 = lf;  zs_b1 = lm;  zs_b2 = hm;  zs_b3 = r2 - hm;
);
function zs_coefs() (
  ZL.ZA.mg_bq(0, 150, 0.7071, 0, srate);  ZR.ZA.mg_bq(0, 150, 0.7071, 0, srate);
  ZL.ZB.mg_bq(0, 1000, 0.7071, 0, srate); ZR.ZB.mg_bq(0, 1000, 0.7071, 0, srate);
  ZL.ZC.mg_bq(0, 5000, 0.7071, 0, srate); ZR.ZC.mg_bq(0, 5000, 0.7071, 0, srate);
);
zs_coefs();
function zs_ctrl(k) local(b, lv, p0, p1, p2, p3, c, t, g) (
  b = 0;
  loop(4,
    lv = 4.342944819 * log(ZSE[b] + 0.000000000001);
    ZSA[b] += (lv - ZSA[b]) * zs_ka;
    ZSP[b] = lv > -60 ? max(0, lv - ZSA[b]) : 0;
    b += 1;
  );
  p0 = ZSP[0]; p1 = ZSP[1]; p2 = ZSP[2]; p3 = ZSP[3];
  c = 0.6 * k;
  ZST[0] = c * (p1 + p3);  ZST[1] = c * (p0 + p2);  ZST[2] = c * (p1 + p3);  ZST[3] = c * (p0 + p2);
  b = 0;
  loop(4,
    t = max(-6, min(6, ZST[b]));
    g = ZSG[b];  g += (t - g) * (abs(t) > abs(g) ? zs_kat : zs_krl);  ZSG[b] = g;
    ZSD[b] = (exp(g * 0.11512925) - ZSL[b]) / CRATE;
    b += 1;
  );
);
ZSE = 11010; ZSA = 11020; ZSP = 11030; ZST = 11040; ZSD = 11050; ZSL = 11060;

fz_C = 11100;
function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_tiny(v) ( abs(v) < 0.000000000001 ? 0 : v; );
function fz_run(x) instance(qA, qB, qC, qD, fhi, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = qA.fz_bm(x, fz_C);
  ha = abs(h); fhi += (ha - fhi) * (ha > fhi ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fhi, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fhi;
  e = qD.fz_bm(qC.fz_bm(qB.fz_bm(e, fz_C + 5), fz_C + 10), fz_C + 15);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_dn() instance(fhi, fp, fe) ( fhi = fz_tiny(fhi); fp = fz_tiny(fp); fe = fz_tiny(fe); );
function fz_clr() instance(qA, qB, qC, qD, fhi, fp, fe) ( qA.fz_bmz(); qB.fz_bmz(); qC.fz_bmz(); qD.fz_bmz(); fhi = fp = fe = 0; );
function fz_coef() local(fso) (
  fso = os_f * srate;
  fz_bqc(fz_C, 4, 3500, 0, 0.7071, fso); fz_bqc(fz_C + 5, 4, 5500, 0, 0.7071, fso);
  fz_bqc(fz_C + 10, 0, 8000, 4, 0.7, fso); fz_bqc(fz_C + 15, 2, 12000, -6, 0.7, fso);
  fz_a = 1 - exp(-1 / (0.003 * fso)); fz_r = 1 - exp(-1 / (0.12 * fso)); fz_w = 1 - exp(-1 / (0.06 * fso));
);
fz_o = fz_t = 0;

function rate_set() (
  tp_ka = 1 - exp(-1 / (0.0005 * os_f * srate));
  tp_kr = exp(-1 / (0.08 * os_f * srate));
  fz_coef();
);
rate_set();
CRATE = 32;
kgl = 1 - exp(-CRATE / (0.03 * srate));
ksm = 1 - exp(-1 / (0.03 * srate));
ksw = 1 - exp(-1 / (0.015 * srate));
kdk = 1 / (0.005 * srate);
dcc = 1 - 2 * $pi * 5 / srate;
cL.tp_reset(); cR.tp_reset();
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
DR1.drift_init(0.7 + rand(1) * 0.4); DR2.drift_init(0.8 + rand(1) * 0.4); DR3.drift_init(0.9 + rand(1) * 0.4);
DR4.drift_init(0.8 + rand(1) * 0.4); WW1.drift_init(1); FL1.drift_init(1);
drD = drA = drT = drW = 0;
tp_targets(model, speed); col_targets(colour); eq_targets(); TG[29] = sat_amt / 100;
memcpy(GV, TG, NGV);
drift_macro(drift); tp_coefs(); eq_coefs(); sat_coefs();
mg_d = mt_d; mg_b = mt_b; mg_comp = mt_comp; dd = db_ = dc_ = 0;
mg_sg = mt_sg; mg_sw = mt_sw; mg_c0 = mt_c0; mg_c1 = mt_c1; mg_c2 = mt_c2; dsg = dsw = dc0 = dc1 = dc2 = 0;
mg_sb = st_f(ST_B, ST_KP, ST_KN);
w_tu = sat_mode == 0; w_tp = sat_mode == 1; w_bo = sat_mode == 2;
o_swap = swap; o_duck = 1;
g_in = 10 ^ (in_db / 20); g_out = 10 ^ (out_db / 20); g_mix = mix / 100;
g_wow = wow / 100; g_fl = flutter / 100;
ph1 = ph2 = ph3 = ph4 = ph5 = 0;
g_dma = dm_a;
g_rpm = speed == 0 ? 0.6 : speed == 2 ? 4.4 : 2.2;  g_hd = speed < 3;
dpos = 0; memset(DRY, 0, DRYN * 2);
wpos = 0; memset(WWL, 0, WWN); memset(WWR, 0, WWN);
o_lo = lo_amt; o_hi = hi_amt;
thk_init(); thk_lift = 3; thk_drv = 1.5; thk_asym = 0.12; thk_tr = 1.0; thk_trim = 0;
zs_ka = 1 - exp(-CRATE / (1.5 * srate));  zs_kat = 1 - exp(-CRATE / (0.005 * srate));  zs_krl = 1 - exp(-CRATE / (0.1 * srate));
zs_ke = 1 - exp(-1 / (0.02 * srate));
memset(ZSG, 0, 70); i = 0; loop(4, ZSL[i] = 1; ZSA[i] = -60; i += 1; );
zs_on = 0; g_zs = zs / 100;
function params() (
  link > 0.5 ? ( hi_amt != o_hi ? lo_amt = hi_amt : hi_amt = lo_amt; );
  o_lo = lo_amt; o_hi = hi_amt;
  tp_targets(model, speed); col_targets(colour); eq_targets(); TG[29] = sat_amt / 100;
  drift_macro(drift);
);
cc = 0;
os_gsetup();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = D0 + os_lat(os_f);
by_setup(20);
pwr_init();  pwr_wu_loss = 1.2;  pwr_wu_drv = 2.5;  pwr_wu_lp = 6000;  pwr_bloom = 0.25;  pwr_sag = 0.2;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
rs_f = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function pv(i, v) ( slider(i) = v; );
function sl_list() local(i) ( i = 1;  loop(22, i != 20 ? slider_automate(2 ^ (i - 1));  i += 1; ); );
function p_init() (
  pv(1, 0); pv(2, 0); pv(3, 1); pv(4, 67); pv(5, 1); pv(6, 0); pv(7, 0); pv(8, 0); pv(9, 0); pv(10, 0); pv(11, 0);
  pv(12, 1); pv(13, 1); pv(14, 5); pv(15, 10); pv(16, 0); pv(17, 100); pv(18, 0); pv(19, 50); pv(21, 0); pv(22, 0);
);
function load_preset(p) (
  p_init();
  p == 2 ? ( pv(2, 7);  pv(3, 2);  pv(4, 44);  pv(8, 1);  pv(9, 2);  pv(10, 1);  pv(14, 0);  pv(15, 3);  pv(18, 0.9);  pv(22, -25); );
  p == 3 ? ( pv(1, 6);  pv(2, 1);  pv(4, 100);  pv(5, 2);  pv(6, 1);  pv(8, 2);  pv(10, 1);  pv(14, 3);  pv(15, 8);  pv(18, 3.7);  pv(21, 1);  pv(22, -30); );
  p == 4 ? ( pv(1, 4);  pv(3, 0);  pv(4, 100);  pv(6, 1);  pv(7, 1);  pv(8, 2);  pv(9, 1);  pv(10, -3);  pv(14, 35);  pv(15, 40);  pv(18, 0.7);  pv(19, 80); );
  p == 5 ? ( pv(2, 5);  pv(4, 78);  pv(5, 0);  pv(7, 1);  pv(8, 1.5);  pv(9, 1);  pv(10, 1.5);  pv(14, 0);  pv(15, 5);  pv(18, 0.3);  pv(22, -20); );
  p == 6 ? ( pv(1, 8);  pv(2, 9);  pv(4, 100);  pv(5, 2);  pv(6, 2);  pv(8, 2.5);  pv(10, 2);  pv(18, 1.9);  pv(21, 1);  pv(22, 30); );
  p == 7 ? ( pv(2, 4);  pv(3, 2);  pv(4, 33);  pv(6, 2);  pv(7, 2);  pv(8, 1);  pv(9, 2);  pv(10, 1.5);  pv(14, 0);  pv(15, 2);  pv(18, 0.3);  pv(22, -15); );
  p == 8 ? ( pv(1, 3);  pv(2, 3);  pv(4, 100);  pv(5, 0);  pv(6, 1);  pv(7, 2);  pv(8, 3);  pv(18, 0.6);  pv(21, 1); );
  p == 9 ? ( pv(2, 8);  pv(3, 2);  pv(4, 27);  pv(9, 2);  pv(10, 1);  pv(14, 0);  pv(15, 3);  pv(18, -0.3); );
  p == 10 ? ( pv(1, 10);  pv(2, 2);  pv(4, 100);  pv(5, 2);  pv(6, 1);  pv(8, 1.5);  pv(17, 45);  pv(18, 1.9);  pv(21, 1); );
  p == 11 ? ( pv(1, 4);  pv(2, 6);  pv(4, 100);  pv(5, 0);  pv(6, 1);  pv(7, 1);  pv(8, 1);  pv(9, 1);  pv(10, 2);  pv(14, 12);  pv(15, 15);  pv(16, 1);  pv(18, 0.6); );
  p == 12 ? ( pv(1, 2);  pv(3, 0);  pv(4, 89);  pv(5, 0);  pv(6, 1);  pv(7, 1);  pv(8, 3);  pv(10, -4);  pv(14, 20);  pv(15, 25);  pv(18, -0.6);  pv(21, 1); );
  o_lo = lo_amt; o_hi = hi_amt;
  sl_list();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(23, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function clr_all() (
  cL.ch_clr(); cR.ch_clr();
  UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr();
  fzL.fz_clr(); fzR.fz_clr();
  BPL.mg_clr(); BPR.mg_clr(); DPL.mg_clr(); DPR.mg_clr(); MCL.mg_clr(); MCR.mg_clr();
  GLL.mg_clr(); GLR.mg_clr(); HSL.mg_clr(); HSR.mg_clr(); LCL.mg_clr(); LCR.mg_clr();
  L1L.mg_clr(); L1R.mg_clr(); L2L.mg_clr(); L2R.mg_clr(); H1L.mg_clr(); H1R.mg_clr(); H2L.mg_clr(); H2R.mg_clr();
  ZL.ZA.mg_clr(); ZL.ZB.mg_clr(); ZL.ZC.mg_clr(); ZR.ZA.mg_clr(); ZR.ZB.mg_clr(); ZR.ZC.mg_clr();
  memset(DRY, 0, DRYN * 2); memset(WWL, 0, WWN); memset(WWR, 0, WWN);
  dxl = dyl = dxr = dyr = 0;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
params();
os_snap(slider(23));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; rs_c = 1 / (0.015 * srate); clr_all(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
params();
os_tf = os_f2n(os_sel);
ost_setup(0, 0, 100, 8000, -0.3, 1);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = D0 + os_lat(os_f);
pwr_block(byp < 0.5);
t_in = 10 ^ (in_db / 20); t_out = 10 ^ (out_db / 20); t_mix = mix / 100;
t_tu = sat_mode == 0; t_tp = sat_mode == 1; t_bo = sat_mode == 2;
spf = speed == 0 ? 2 : speed == 2 ? 0.7 : 1;
t_wow = wow / 100;  t_fl = flutter / 100 * spf;
rpm = speed == 0 ? 0.6 : speed == 2 ? 4.4 : 2.2;
fz_p = min(max((in_db + 0.24 * (sat_amt - 67)) / 12, 0), 1);
fz_t = 0.33 * fz_p * fz_p * (3 - 2 * fz_p) * (speed < 3);
cL.EM.mg_tidy(); cR.EM.mg_tidy(); cL.DM.mg_tidy(); cR.DM.mg_tidy();
fzL.fz_dn(); fzR.fz_dn();
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(slider(23));

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
by_in();
os_gate();
os_chg ? ( rate_set(); tp_coefs(); eq_coefs(); cL.ch_clr(); cR.ch_clr(); UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr(); fzL.fz_clr(); fzR.fz_clr(); );
(cc -= 1) <= 0 ? (
  cc = CRATE;
  i = 0; mv = 0; smv = abs(TG[29] - GV[29]) > 0;
  loop(NGV, d = TG[i] - GV[i]; abs(d) > 0.0000001 * (abs(TG[i]) + 1) ? ( GV[i] += d * kgl; mv = 1; ) : GV[i] = TG[i]; i += 1; );
  dspd = 0.05 * dm_s * CRATE / srate;
  drD = DR1.drift_tick(dspd);  drA = DR2.drift_tick(dspd * 0.7);  drT = DR3.drift_tick(dspd * 1.3);
  drW = DR4.drift_tick(dspd * 4);
  tp_coefs();
  mv ? eq_coefs();
  g_zs = zs / 100;
  zs_run = abs(g_zs) > 0.001 || abs(ZSG[0]) + abs(ZSG[1]) + abs(ZSG[2]) + abs(ZSG[3]) > 0.001;
  zs_run ? zs_ctrl(g_zs) : ( memset(ZSG, 0, 4); i = 0; loop(4, ZSD[i] = 0; ZSL[i] = 1; ZSA[i] = -60; ZSE[i] = 0; i += 1; ); );
  ri = 1 / CRATE;  dd = (mt_d - mg_d) * ri;  db_ = (mt_b - mg_b) * ri;  dc_ = (mt_comp - mg_comp) * ri;
  smv || !sc_ok ? ( sat_coefs(); sc_ok = 1; );
  dsg = (mt_sg - mg_sg) * ri;  dsw = (mt_sw - mg_sw) * ri;
  dc0 = (mt_c0 - mg_c0) * ri;  dc1 = (mt_c1 - mg_c1) * ri;  dc2 = (mt_c2 - mg_c2) * ri;
);
mg_d += dd;  mg_b += db_;  mg_comp += dc_;
mg_sg += dsg;  mg_sw += dsw;  mg_c0 += dc0;  mg_c1 += dc1;  mg_c2 += dc2;
g_in += (t_in - g_in) * ksm;  g_out += (t_out - g_out) * ksm;  g_mix += (t_mix - g_mix) * ksm;
w_tu += (t_tu - w_tu) * ksw;  w_tp += (t_tp - w_tp) * ksw;  w_bo += (t_bo - w_bo) * ksw;
g_wow += (t_wow - g_wow) * ksm * 0.2;  g_rpm += (rpm - g_rpm) * ksm * 0.2;  g_dma += (dm_a - g_dma) * ksm * 0.2;  g_hd += ((speed < 3) - g_hd) * ksm * 0.2;  g_fl += (t_fl - g_fl) * ksm * 0.2;
fz_o += (fz_t - fz_o) * ksm;
swap != o_swap ? ( o_duck -= kdk; o_duck <= 0 ? ( o_duck = 0; o_swap = swap; ); ) : o_duck < 1 ? o_duck = min(1, o_duck + kdk);

pwr_in(spl0, spl1);  xl = pwr_l;  xr = pwr_r;
DRY[dpos * 2] = xl;  DRY[dpos * 2 + 1] = xr;
rp = (dpos + DRYN - os_lat(os_f)) % DRYN;  ml = DRY[rp * 2];  mr = DRY[rp * 2 + 1];
dpos = (dpos + 1) % DRYN;

UL.os_up(xl * g_in);  UR.os_up(xr * g_in);
fz_on = fz_o > 0.0001;
p0l = cL.ch2x(UL.s0);  p0r = cR.ch2x(UR.s0);
fz_on ? ( p0l += fzL.fz_run(p0l);  p0r += fzR.fz_run(p0r); );
os_f > 1 ? (
  p1l = cL.ch2x(UL.s1);  p1r = cR.ch2x(UR.s1);
  fz_on ? ( p1l += fzL.fz_run(p1l);  p1r += fzR.fz_run(p1r); );
  os_f > 2 ? (
    p2l = cL.ch2x(UL.s2);  p2r = cR.ch2x(UR.s2);
    p3l = cL.ch2x(UL.s3);  p3r = cR.ch2x(UR.s3);
    fz_on ? ( p2l += fzL.fz_run(p2l);  p2r += fzR.fz_run(p2r);  p3l += fzL.fz_run(p3l);  p3r += fzR.fz_run(p3r); );
  );
);
wl = DNL.os_dn(p0l, p1l, p2l, p3l) * mg_comp / g_in;
wr = DNR.os_dn(p0r, p1r, p2r, p3r) * mg_comp / g_in;
wl = ml + (wl - ml) * g_mix;  wr = mr + (wr - mr) * g_mix;
wl = LCL.mg_run(HSL.mg_run(GLL.mg_run(MCL.mg_run(DPL.mg_run(BPL.mg_run(wl))))));
wr = LCR.mg_run(HSR.mg_run(GLR.mg_run(MCR.mg_run(DPR.mg_run(BPR.mg_run(wr))))));
dyl = wl - dxl + dcc * dyl;  dxl = wl;  wl = dyl;
dyr = wr - dxr + dcc * dyr;  dxr = wr;  wr = dyr;
thk_proc(wl, wr, thick >= 0.5);  wl = thk_l;  wr = thk_r;
zs_run ? (
  !zs_on ? ( ZL.ZA.mg_clr(); ZL.ZB.mg_clr(); ZL.ZC.mg_clr(); ZR.ZA.mg_clr(); ZR.ZB.mg_clr(); ZR.ZC.mg_clr(); zs_on = 1; );
  ZL.zs_split(wl);  l0 = zs_b0; l1 = zs_b1; l2 = zs_b2; l3 = zs_b3;
  ZR.zs_split(wr);
  ZSE[0] += (max(l0 * l0, zs_b0 * zs_b0) - ZSE[0]) * zs_ke;  ZSE[1] += (max(l1 * l1, zs_b1 * zs_b1) - ZSE[1]) * zs_ke;
  ZSE[2] += (max(l2 * l2, zs_b2 * zs_b2) - ZSE[2]) * zs_ke;  ZSE[3] += (max(l3 * l3, zs_b3 * zs_b3) - ZSE[3]) * zs_ke;
  ZSL[0] += ZSD[0];  ZSL[1] += ZSD[1];  ZSL[2] += ZSD[2];  ZSL[3] += ZSD[3];
  wl = l0 * ZSL[0] + l1 * ZSL[1] + l2 * ZSL[2] + l3 * ZSL[3];
  wr = zs_b0 * ZSL[0] + zs_b1 * ZSL[1] + zs_b2 * ZSL[2] + zs_b3 * ZSL[3];
) : zs_on = 0;
wl = H2L.mg_run(H1L.mg_run(L2L.mg_run(L1L.mg_run(wl))));
wr = H2R.mg_run(H1R.mg_run(L2R.mg_run(L1R.mg_run(wr))));
ti = 1 / srate;
ph1 += 0.45 * ti; ph2 += 0.8 * ti; ph3 += 6.5 * ti; ph4 += 11 * ti; ph5 += g_rpm * ti;
ph1 -= floor(ph1); ph2 -= floor(ph2); ph3 -= floor(ph3); ph4 -= floor(ph4); ph5 -= floor(ph5);
(cc == CRATE) ? ( wow_rnd = WW1.drift_tick(0.6 * CRATE * ti); flu_rnd = FL1.drift_tick(9 * CRATE * ti); );
wdel = g_wow * 0.0035 * srate * (0.5 * sin(2 * $pi * ph1) / (2 * $pi * 0.45) + 0.35 * sin(2 * $pi * ph2) / (2 * $pi * 0.8) + 0.15 * wow_rnd / (2 * $pi * 0.6))
     + g_fl * 0.0012 * srate * (0.6 * sin(2 * $pi * ph3) / (2 * $pi * 6.5) + 0.3 * sin(2 * $pi * ph4) / (2 * $pi * 11) + 0.1 * flu_rnd / (2 * $pi * 9))
     + g_dma * srate * (0.00015 * g_hd * sin(2 * $pi * ph5) / (2 * $pi * g_rpm));
wd = D0 + max(-D0 + 2, min(D0 - 2, wdel));
WWL[wpos] = wl;  WWR[wpos] = wr;
wl = hm(WWL, WWN, wpos, wd);  wr = hm(WWR, WWN, wpos, wd);
wpos = (wpos + 1) % WWN;
os_g < 1 ? ( wl *= os_g; wr *= os_g; );
pwr_out(wl, wr);  wl = pwr_l;  wr = pwr_r;
ost_out(wl * g_out, wr * g_out);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); spl0 *= rs_f * rs_f * (3 - 2 * rs_f); spl1 *= rs_f * rs_f * (3 - 2 * rs_f); );
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
