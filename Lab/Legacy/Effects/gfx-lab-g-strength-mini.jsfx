  mg_mu ? ( ui_cola(0xFFD0B0, 0.35); mg_r(124, mg_y + 2.5, 16, 1.5); );
  gfx_setfont(6); ui_col(mg_mu ? 0x2A0E08 : 0xE4E2CC); mg_ctxt(132, mg_y + mg_ph / 2 - 0.5, "M");
  mg_mh && pressed && drag_id == 0 ? ( drag_id = -1; SVP[mg_v * NP + 33] = mg_mu ? 0 : 1; );
