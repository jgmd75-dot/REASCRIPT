pwr_init();  pwr_hum_db = -78;  pwr_sag = 0.1;  pwr_wu_loss = 0.2;  pwr_wu_drv = 0.3;  pwr_wu_lp = 12000;  pwr_wu_wob = 0.05;  pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
st_volt = 10 ^ (slider9 / 20) * sqr(slider10 / 100) * 2.5;
