    ) :
    mst == 0x80 || (mst == 0x90 && m3 == 0) ? (
      m2 >= 36 && m2 <= 47 ? ev_add(mofs, m2 - 36, 0, 0, 0, 1, 0, 0, 1);
    ) :
    mst == 0xB0 && (m2 == 120 || m2 == 123) ? ev_add(mofs, -1, 2, 0, 0, 1, 0, 0, 1);
  );
  midisend(mofs, m1, m2, m3);
);
panic_d ? ( panic_d = 0; ev_add(0, -1, 2, 0, 0, 1, 0, 0, 1); );

