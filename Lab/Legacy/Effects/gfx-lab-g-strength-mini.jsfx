file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (ei < ne && (SEO[ei] <= spos || spos >= samplesblock - 1)) (
  ev_v = SEV[ei]; ev_t = SET[ei];
  ev_t == 1 ? v_trig(ev_v, SEN[ei], SEL[ei * 6], SEL[ei * 6 + 1], SEL[ei * 6 + 2], SEL[ei * 6 + 3], SEL[ei * 6 + 4]) :
  ev_t == 0 || ev_t == 3 ? v_off(ev_v) :
  ev_t == 2 ? ( vi = 0; loop(NV, SVD[vi * VDS + 8] = 5; SVD[vi * VDS + 31] = 0; SVD[vi * VDS + 38] = 0; vi += 1; ); );
  ei += 1;
);
spos += 1;
st_audoff > 0 ? ( st_audoff -= 1; st_audoff == 0 ? v_off(st_audv); );

oL = oR = 0;
vi = 0; d = SVD; p = SVP;
loop(NV,
  d[0] ? (
    (d[43] -= 1) <= 0 ? ( d[43] = CR; v_ctl(vi, d); );
    d[3] += d[4]; d[5] += d[6]; d[20] += d[21];
    i2 = d[5]; ph = d[2] + i2; ph -= floor(ph); d[2] = ph;
    w2 = p[3];
