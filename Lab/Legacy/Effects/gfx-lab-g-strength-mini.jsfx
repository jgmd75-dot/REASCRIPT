function rate_beats(r) ( r == 0 ? 0.5 : r == 1 ? 1 / 3 : r == 2 ? 0.25 : r == 3 ? 1 / 6 : 0.125; );
sq_was = 0; sq_fb = 0; sq_exp = -1; sq_step = -1; ne = 0;
function wait_b(c) ( c < 0.5 ? 1 : c < 2.5 ? 2 : c < 6.5 ? 4 : 8; );
function wait_a(c) ( c < 0.5 ? 1 : c < 2.5 ? c : c < 6.5 ? c - 2 : c - 6; );
