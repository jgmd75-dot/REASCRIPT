        fi_pos == 0 && fi_bar > 0 && fi_bar % fi_n == 0 && fi_cr >= 0 ? ( fi_v = fi_cr; fi_vel = 105; );
        fi_v >= 0 && SVP[fi_v * NP + 33] < 0.5 && (!sq_solo || SVP[fi_v * NP + 34] >= 0.5) ? (
