prs_ok = 0; prs_dirty = 0;

function gap_clear() local(i) (
  i = 0; loop(NV, memset(SVD + i * VDS, 0, VDS); SVD[i * VDS + 49] = -1; i += 1; );
  sq_was = 0; sq_step = -1; st_audoff = 0;
