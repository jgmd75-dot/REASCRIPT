sq_on = slider1 >= 0.5 || (slider2 >= 0.5 && sq_play);
sq_bps = tempo / 60 / srate;
sq_on ? (
  sq_play ? ( sq_t0 = beat_position; ) : ( !sq_was || sq_wasplay ? sq_fb = 0; sq_t0 = sq_fb; );
  sq_t1 = sq_t0 + sq_bps * samplesblock;
  sq_L = rate_beats(floor(slider5 + 0.5));
  !sq_was || abs(sq_t0 - sq_exp) > 0.05 ? (
    vi = 0; loop(NV, SVD[vi * VDS + 49] = -1; vi += 1; );
    !sq_was ? ( sq_off = 0; sq_lastc = -1; ) : (
      kn_ = floor(sq_t0 / sq_L); kn_ * sq_L < sq_t0 ? kn_ += 1;
      sq_off = sq_lastc + 1 - kn_;
