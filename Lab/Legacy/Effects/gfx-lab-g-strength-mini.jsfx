  sq_fate = slider8 * 0.01;
  sq_solo = 0; vi = 0; loop(NV, SVP[vi * NP + 34] >= 0.5 ? sq_solo = 1; vi += 1; );
  fi_n = floor(slider18 + 0.5); fi_n = fi_n == 1 ? 2 : fi_n == 2 ? 4 : fi_n == 3 ? 8 : 0; fi_len = fi_n == 2 ? 4 : 8;
  fi_sn = fi_th = fi_tm = fi_tl = fi_cr = -1; vi = 0;
  loop(NV, n_ = floor(SVP[vi * NP + 36] + 0.5);
    (n_ == 3 || n_ == 4) && fi_sn < 0 ? fi_sn = vi; n_ == 12 && fi_th < 0 ? fi_th = vi; n_ == 11 && fi_tm < 0 ? fi_tm = vi;
    n_ == 10 && fi_tl < 0 ? fi_tl = vi; n_ == 18 && fi_cr < 0 ? fi_cr = vi; vi += 1; );
  fi_sn < 0 ? ( vi = 0; loop(NV, n_ = floor(SVP[vi * NP + 36] + 0.5); (n_ == 5 || n_ == 6) && fi_sn < 0 ? fi_sn = vi; vi += 1; ); );
  fi_th < 0 ? fi_th = fi_tm >= 0 ? fi_tm : fi_tl; fi_tl < 0 ? fi_tl = fi_tm >= 0 ? fi_tm : fi_th;
