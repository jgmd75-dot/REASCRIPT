      ui_col(mg_vel >= 120 ? ui_mix(mg_fc, 0xFFFFFF, 0.35) : mg_vel >= 90 ? mg_fc : ui_mix(mg_fc, 0x1E2318, 0.4));
      mg_rr(mg_x + 1.5, mg_y + 2.5, mg_pw - 6, mg_ph - 6.5, 2);
