  gfx_setfont(6); ui_col(mg_lit ? mk_gld : mg_mu ? ui_mix(mk_ink, 0x262C1E, 0.55) : mk_ink); mg_ltxt(36, mg_y + mg_ph / 2 - 0.5, pk_pitem(#st_names, mg_n + 1, #mg_nm));
  mg_hv && pressed && drag_id == 0 ? ( drag_id = -1; st_aud_d = mg_v + 1; );
  mg_rl = floor(SRL[mg_pat * NV + mg_v] + 0.5); mg_rl = mg_rl < 1 ? 16 : min(mg_rl, 16);
