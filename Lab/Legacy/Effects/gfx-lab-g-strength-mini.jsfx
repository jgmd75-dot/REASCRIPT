  st_aud_d = 0;
);
ei = 0; spos = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, st_sel);
file_var(0, st_lane);
file_mem(0, SVP, NV * NP);
file_mem(0, SSQ, NPAT * NV * NS * NF);
file_mem(0, SRL, NPAT * NV);
