st_dck = exp(-2 * $pi * 5 / srate);
st_volt = 10 ^ (slider9 / 20) * sqr(slider10 / 100) * 2.5;
ne = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, slider7) ? (
    mst = m1 & 0xF0;
    mst == 0x90 && m3 > 0 ? (
