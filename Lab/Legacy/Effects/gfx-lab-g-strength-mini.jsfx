  d = SVD + v * VDS; p = SVP + v * NP;
  p[32] >= 0.5 ? (
    i = 0; loop(NV, i != v && abs(SVP[i * NP + 32] - p[32]) < 0.5 && SVD[i * VDS] ? ( SVD[i * VDS + 8] = 5; SVD[i * VDS + 31] = 0; ); i += 1; );
  );
