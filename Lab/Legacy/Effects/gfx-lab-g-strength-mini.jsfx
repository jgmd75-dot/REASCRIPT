desc:Strength Mini [Arcana drum synth] (GFX Lab)
//tags: instrument drum machine drum synth synthesised step sequencer pattern parameter locks fm ring mod arcana mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-voice, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider20:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Stop,Run}>-Run
slider2:1<0,1,1{Off,On}>-Transport (follows REAPER play state)
slider3:0<0,7,1{A,B,C,D,E,F,G,H}>-Pattern
slider5:2<0,4,1{1/8,1/8T,1/16,1/16T,1/32}>-Rate
slider6:0<0,75,1>-Swing (%)
slider7:0<0,16,1>-MIDI channel (0 = omni)
slider8:35<0,100,1>-Fate (%)
slider9:-4<-24,6,0.1>-Volume (dB)
slider10:60<0,100,0.1>-Level (%)
slider11:0<0,100,1>-Band sat (%)
slider12:30<0,100,1>-Bias (%)
slider13:120<40,400,1>-Sat low band (Hz)
slider14:6000<2000,16000,10>-Sat high band (Hz)
slider15:-0.3<-24,0,0.1>-Ceiling (dB)
slider16:0<-100,100,1>-The Lion (tame .. wild)
slider17:25<0,100,1>-Breath (%)
slider18:0<0,3,1{Off,Every 2 bars,Every 4 bars,Every 8 bars}>-Fill
slider19:prs_sel=0<0,8,1{No preset,Init,Boom,Electro,Foundry,Pin Drop,Tin Garden,Glass Lion,Broken Clock}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(1048575, v); );
function psw_allg(v) ( slider_show(1048575, v); );
#ui_man = "gfx-lab-g-strength-mini";
ui_thm = 5; ui_hw = 1;
ext_noinit = 1;

ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
NV = 13; NP = 40; NS = 32; NF = 7; NPAT = 8;
SVP = 40000;
SVD = 41000; VDS = 64;
SSQ = 100000;
SPLO = 70000; SPHI = 70100; SPDF = 70200; SPLG = 70300; SPST = 70400;
SKT = 71000;
SCB = 72000;
SPB = 80000;
SRL = 130000;
SEO = 73000; SEV = 73300; SEN = 73600; SET = 73900; SEL = 76000;
SHIT = 75000;
memset(SVD, 0, NV * VDS); memset(SHIT, 0, 16);
L12 = log(2) / 12;

function prm(i, lo, hi, def, lg, st, nm) ( SPLO[i] = lo; SPHI[i] = hi; SPDF[i] = def; SPLG[i] = lg; SPST[i] = st; strcpy(1000 + i, nm); );
prm(0, 12, 108, 48, 0, 0, "TUNE");        prm(1, -100, 100, 0, 0, 0, "SHAPE");    prm(2, 0, 100, 100, 0, 0, "OSC 1 LEVEL");
prm(3, 0, 3, 0, 0, 1, "OSC 2 WAVE");     prm(4, -24, 48, 0, 0, 0, "OSC 2 TUNE");  prm(5, 0, 100, 0, 0, 0, "OSC 2 LEVEL");
prm(6, 0, 100, 0, 0, 0, "FM");           prm(7, 0, 100, 0, 0, 0, "RING");         prm(8, 0, 100, 0, 0, 0, "NOISE");
prm(9, 0, 2, 2, 0, 1, "NOISE TYPE");     prm(10, 100, 18000, 6000, 1, 0, "COLOUR"); prm(11, 0, 100, 0, 0, 0, "DIRT");
prm(12, -48, 48, 0, 0, 0, "PITCH ENV");  prm(13, 1, 1000, 40, 1, 0, "PITCH TIME");
prm(14, 0, 4, 0, 0, 1, "FILTER");        prm(15, 20, 20000, 8000, 1, 0, "CUTOFF"); prm(16, 0, 100, 0, 0, 0, "RESO");
prm(17, -100, 100, 0, 0, 0, "FILTER ENV"); prm(18, 1, 2000, 100, 1, 0, "ENV TIME");
prm(19, 0, 2, 0, 0, 1, "DRIVE MODE");    prm(20, 0, 100, 0, 0, 0, "DRIVE");
prm(21, 0, 200, 0, 0, 0, "ATTACK");      prm(22, 0, 1000, 0, 0, 0, "HOLD");       prm(23, 5, 8000, 300, 1, 0, "DECAY");
prm(24, 0, 1, 0, 0, 1, "TRIGGER");       prm(25, 0, 3, 0, 0, 1, "BURST");
prm(26, 0.1, 40, 4, 1, 0, "LFO RATE");   prm(27, 0, 100, 0, 0, 0, "LFO AMOUNT");  prm(28, 0, 3, 0, 0, 1, "LFO TO");
prm(29, 0, 100, 60, 0, 0, "VELOCITY");   prm(30, -36, 6, 0, 0, 0, "LEVEL");       prm(31, -100, 100, 0, 0, 0, "PAN");
prm(32, 0, 3, 0, 0, 1, "CHOKE");         prm(33, 0, 1, 0, 0, 1, "MUTE");          prm(34, 0, 1, 0, 0, 1, "SOLO");
prm(35, 0, 1, 1, 0, 1, "SWING");         prm(36, 0, 31, 0, 0, 1, "NAME");         prm(37, 0, 1, 1, 0, 1, "OSC 2 SWEEP");
prm(38, 0, 1, 0, 0, 1, "-");             prm(39, 0, 1, 0, 0, 1, "-");

#st_names = "KICK|KICK 2|SUB KICK|SNARE|SNARE 2|CLAP|RIM|CLOSED HAT|OPEN HAT|PEDAL HAT|TOM LOW|TOM MID|TOM HIGH|COWBELL|CLAVE|SHAKER|CONGA|BONGO|CRASH|RIDE|ZAP|BLIP|PERC|METAL|BELL|NOISE|GLITCH|SNAP|BASS|TONE|LEAD|SUB";
function vp(v, i) ( SVP[v * NP + i]; );
function sq_ptr(p, v, s) ( SSQ + (((p * NV + v) * NS + s) * NF); );
function sq_ptr_au(p, v, s) ( SSQ + (((p * NV + v) * NS + s) * NF); );
function row_len(p, v) local(n) ( n = floor(SRL[p * NV + v] + 0.5); n < 1 ? 16 : min(n, NS); );

function st_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
function st_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);

