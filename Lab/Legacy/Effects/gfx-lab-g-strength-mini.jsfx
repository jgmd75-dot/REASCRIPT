    mg_s == mg_cur ? ( ui_cola(0xFFFFFF, 0.16); mg_rr(mg_x, mg_y + 1, mg_pw - 3, mg_ph - 3.5, 2); );
    mg_mu ? ( ui_cola(0x15180F, 0.5); mg_rr(mg_x, mg_y + 1, mg_pw - 3, mg_ph - 3.5, 2); );
