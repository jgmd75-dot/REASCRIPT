prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) != 0 ? file_var(0, ui_edit);
tl_skip = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
au_tlink();
au_params();
os_fresh ? ( mlp_t != mlp_on ? ( mlp_on = mlp_t; mlp_clr(); mlp_on ? ( mlp_build(); mlp_xf = 0; ); ); os_base = mlp_on ? mlp_lat : 0; );
os_snap(slider(50));
os_tf == os_f && mlp_t == mlp_on && os_g >= 1 && mlp_gg >= 1 ? ( os_base = mlp_on ? mlp_lat : 0; pdc_delay = os_base + os_lat(os_f); );

@block
prs_chk();
au_tlink();
ax_dst == 0 && au_want() ? ( ax_pre = 0; ax_dst = 1; );
ax_dst == 3 ? ( au_engage(); ax_dst = 2; );
au_params();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_bot_ch = 0; pdc_top_ch = 2;
vu_d = max(vu_d, sqrt(bm_ms / max(samplesblock, 1))); bm_ms = 0;
os_snapb(slider(50));
os_tf == os_f && mlp_t == mlp_on && os_g >= 1 && mlp_gg >= 1 ? ( os_base = mlp_on ? mlp_lat : 0; pdc_delay = os_base + os_lat(os_f); );

@sample
by_in();
rs_req ? ( rs_req = 0; au_clear(); rs_f = 0; rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay; );
rw_l = spl0; rw_r = spl1;
os_gate(); mlp_gate();
os_chg ? ( memset(tlp, 0, 8); memset(cbd, 0, 1024); au_rate(); o0.au_osclr(); o1.au_osclr(); o2.au_osclr(); o3.au_osclr(); fz_clr(); fz_coefs(srate * os_f); memset(osd, 0, 128); );
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
spl0 != spl0 ? spl0 = 0;
spl1 != spl1 ? spl1 = 0;
inG += (inT - inG)*gl_c; outG += (outT - outG)*gl_c; mixW += (mixT - mixW)*gl_c;
fz_o += (fz_t - fz_o)*gl_c; fz_t == 0 && fz_o < 0.000001 ? fz_o = 0;
inL = spl0*inG; inR = spl1*inG;
mlp_on ? ( mlp_run(inL, inR); inL = mlp_l; inR = mlp_r; );
lk_s += ((slider49 >= 0.5) - lk_s)*lk_c; lk_s > 0.9999 && slider49 >= 0.5 ? lk_s = 1; lk_s < 0.0001 && slider49 < 0.5 ? lk_s = 0;
lk_u = 1 - lk_s;

outL = 0; outR = 0;
split(inL, 0); aL1 = xb1; aL2 = xb2; aL3 = xb3; aL4 = xb4; dryL = xdry;
split(inR, 9); aR1 = xb1; aR2 = xb2; aR3 = xb3; aR4 = xb4; dryR = xdry;
os_f > 1 ? (
  osd_w = (osd_w + 1) & 127; osd[osd_w] = dryL; osd[128 + osd_w] = dryR;
  osd_r = (osd_w - os_lat(os_f)) & 127; dryL = osd[osd_r]; dryR = osd[128 + osd_r];
);

cbw = (cbw + 1) & 127; cbr = os_f > 1 ? (cbw - os_lat(os_f)) & 127 : cbw;
b = 0;
loop(4,
  p = bp + b*40;
  yl = b == 0 ? aL1 : b == 1 ? aL2 : b == 2 ? aL3 : aL4;
  yr = b == 0 ? aR1 : b == 1 ? aR2 : b == 2 ? aR3 : aR4;
  cbd[b * 256 + cbw] = yl; cbd[b * 256 + 128 + cbw] = yr;
  cl_l = cbd[b * 256 + cbr]; cl_r = cbd[b * 256 + 128 + cbr];

  p[0] == 2 ? (
    p[24] += (max(abs(yl), abs(yr)) > sqrt(p[24]) ? p[13] : p[14])*(yl*yl + yr*yr - p[24]);
    lk_u > 0 ? (
      p[33] += (abs(yl) > sqrt(p[33]) ? p[13] : p[14])*(2*yl*yl - p[33]);
      p[34] += (abs(yr) > sqrt(p[34]) ? p[13] : p[14])*(2*yr*yr - p[34]);
    ) : ( p[33] = p[34] = p[24]; );
    (p[25] -= 1) <= 0 ? (
      p[25] = 16;
      ed = p[24] > 0.00000001 ? 10*log10(p[24]) : -160;
      lk_u > 0 ? (
        eg = p[1]*max(0, min(1, (ed + 30)/(12*PHI)));
        ed = p[33] > 0.00000001 ? 10*log10(p[33]) : -160; egl = eg + (p[1]*max(0, min(1, (ed + 30)/(12*PHI))) - eg)*lk_u;
        ed = p[34] > 0.00000001 ? 10*log10(p[34]) : -160; egr = eg + (p[1]*max(0, min(1, (ed + 30)/(12*PHI))) - eg)*lk_u;
        eqset2(b, 2, egl, egr);
      ) : (
      eqset(b, 2, p[1]*max(0, min(1, (ed + 30)/(12*PHI))));
      );
    );
  );
  yl = bq(bq(yl, eqA + b*18), eqB + b*18);
  yr = bq(bq(yr, eqA + b*18 + 9), eqB + b*18 + 9);

  os_f > 1 ? (
    b == 0 ? o0.au_os(yl, yr, p[2], p[3], 1, 0) : b == 1 ? o1.au_os(yl, yr, p[2], p[3], 1, 0) :
    b == 2 ? o2.au_os(yl, yr, p[2], p[3], 1, 0) : o3.au_os(yl, yr, p[2], p[3], 1, fz_o > 0);
    yl = au_yl; yr = au_yr;
    p[2] == 1 && p[3] > 1.0001 ? (
      tlp[2 * b] += p[9] * (yl - tlp[2 * b]); yl = tlp[2 * b];
      tlp[2 * b + 1] += p[9] * (yr - tlp[2 * b + 1]); yr = tlp[2 * b + 1];
    ) : ( tlp[2 * b] = yl; tlp[2 * b + 1] = yr; );
  ) : (
