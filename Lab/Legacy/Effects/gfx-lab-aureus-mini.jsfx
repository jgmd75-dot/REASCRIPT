inG = inT; outG = outT; mixW = mixT; fz_o = fz_t;
b = 0; loop(4, bp[b*40 + 8] = bp[b*40 + 6]; bp[b*40 + 39] = bp[b*40 + 7]; b += 1; );
rs_f = 1; rs_c = 1 / (0.015 * srate);

#au_pmn = "Init|Golden Glue|Tape Polish|Opto Smooth|Air Lift|Iron Low End|VCA Punch|Dynamic Tame";
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function au_thash() local(i, h) ( h = 0; i = 3; loop(57, (i != 10 && i != 12 && i != 14 && i != 20 && i != 22 && i != 24 && i != 30 && i != 32 && i != 34 && i != 40 && i != 42 && i != 44 && i != 52 && i != 53) ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function au_tlink() local(k, b, n, w, v, h, m) (
  h = au_thash();
  k = 0;
  loop(3,
    n = 0; b = 0;
    loop(4, v = floor(slider(10 + 10 * b + 2 * k) + 0.5); v != tl_v[4 * k + b] ? ( n += 1; w = b; ); b += 1; );
    typ_lk >= 0.5 && tl_ok && !tl_skip && h == tl_h && n == 1 ? (
      v = floor(slider(10 + 10 * w + 2 * k) + 0.5); m = 0; b = 0;
      loop(4, b != w && floor(slider(10 + 10 * b + 2 * k) + 0.5) != v ? ( slider(10 + 10 * b + 2 * k) = v; m += 2 ^ (9 + 10 * b + 2 * k); ); b += 1; );
      m > 0 ? slider_automate(m);
    );
    b = 0; loop(4, tl_v[4 * k + b] = floor(slider(10 + 10 * b + 2 * k) + 0.5); b += 1; );
    k += 1;
  );
  tl_h = h; tl_ok = 1; tl_skip = 0;
);
tl_v = alloc(12); tl_ok = 0; tl_skip = 0;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(59, i != 52 && i != 53 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
