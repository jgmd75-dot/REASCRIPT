desc:VC81 [vocoder] (GFX Lab)
//tags: vocoder robot voice talkbox formant synth carrier midi
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

slider36:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:1<0,1,1{Off,On}>-KR-81 on
slider2:0<0,1,1{Off,On}>-Output iron
slider3:50<0,100,1>-KR-81 band width (%)
slider4:0<-1,1,0.01>-KR-81 formant shift (oct)
slider5:25<0,100,1>-KR-81 drive (%)
slider6:4<0,12,0.1>-KR-81 HF boost (dB)
slider7:0<0,100,1>-KR-81 direct (%)
slider8:1<0,1,1{Off,On}>-SV-81 on
slider9:2<0,2,1>-(unused, was SV-81 style)
slider10:0<0,1,1{16,24}>-SV-81 bands
slider11:0<0,1,1{Fast,Slow}>-SV-81 release
slider12:50<0,100,1>-SV-81 V/UV sensitivity (%)
slider13:0<-12,12,0.1>-SV-81 tilt (dB)
slider14:0<-24,6,0.1>-Synth carrier level (dB)
slider15:0<-12,12,0.01>-Synth carrier tune (st)
slider16:0<-2,2,1>-Synth carrier octave
slider17:0<0,1000,1>-Synth carrier glide (ms)
slider18:0<0,2,1{Saw,Pulse,Super}>-Synth carrier wave
slider19:0<0,1,1{Ext 3/4,Synth}>-Carrier source
slider20:0<0,1,1{Off,On}>-Carrier hold
slider21:50<0,100,1>-KR / SV balance (%)
slider22:100<0,100,1>-Mix (%)
slider23:50<0,100,1>-Drift (%)
slider24:0<-24,12,0.1>-Output (dB)
slider25:0<0,100,1>-Band sat (%)
slider26:30<0,100,1>-Bias (%)
slider27:120<40,400,1>-Sat low band (Hz)
slider28:6000<2000,16000,10>-Sat high band (Hz)
slider29:-0.3<-24,0,0.1>-Ceiling (dB)
slider30:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider31:0<0,16,1>-MIDI channel (0 = omni)
slider32:0<0,1,1{ENG,DE}>-(unused, was label language)
slider34:byp_on=0<0,1,1{Off,On}>-Bypass
slider35:prs_sel=0<0,12,1{No preset,Init,Robot Voice,Choir Pad (Synth),Talking Strings,Labor Grit,Broadcast Clear,Whisper Noise,Formant Up,Formant Down,Space Station,Drum Vocoder,Synth Solo}>-Preset

in_pin:Modulator L
in_pin:Modulator R
in_pin:Carrier L
in_pin:Carrier R
out_pin:left output
out_pin:right output

@init
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0;
#ui_man = "gfx-lab-vc81";
function psw_all(v) ( slider_show(68719476735, v); );
function psw_allg(v) ( slider_show(68719476735, v); );
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
vc_KF = alloc(32);
vc_SF = alloc(32);
vc_KMB = alloc(32); vc_SMB = alloc(32);
vc_VO  = alloc(8 * 16);
vc_MQ  = alloc(256 * 4);
vg_LK = alloc(32); vg_LS = alloc(32);
vc_ostm = alloc(4096); ost_init(vc_ostm);

vc_i = 0; loop(24, vc_KF[vc_i] = 100 * 80 ^ (vc_i / 23); vc_i += 1; );
vc_i = 0; loop(8, vc_VO[vc_i * 16] = -1; vc_i += 1; );

function vc_bp(f, q) local(w0, al, n) (
  w0 = 2 * $pi * min(max(f, 10), 0.46 * srate) / srate; al = sin(w0) / (2 * q); n = 1 + al;
  vc_c0 = al / n; vc_a1 = -2 * cos(w0) / n; vc_a2 = (1 - al) / n;
);
function vc_hp(f, q) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, 0.46 * srate) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al;
  vc_h0 = (1 + cw) * 0.5 / n; vc_h1 = -(1 + cw) / n; vc_h2 = vc_h0; vc_h3 = -2 * cw / n; vc_h4 = (1 - al) / n;
);
function vc_bwset(qbp) local(a, wr, wi, dr, di, m, xr, xi, r1, i1, r2, i2, w1, w2, h1, h2) (
  a = sqrt(0.5);
  wr = -a / (2 * qbp); wi = a / (2 * qbp);
  dr = wr * wr - wi * wi - 1; di = 2 * wr * wi;
  m = sqrt(dr * dr + di * di);
  xr = sqrt(max((m + dr) * 0.5, 0)); xi = sqrt(max((m - dr) * 0.5, 0)); di < 0 ? xi = -xi;
  r1 = wr + xr; i1 = wi + xi; r2 = wr - xr; i2 = wi - xi;
  w1 = sqrt(r1 * r1 + i1 * i1); w2 = sqrt(r2 * r2 + i2 * i2);
  vc_ska = w1; vc_sqa = w1 / max(-2 * r1, 0.000001);
  vc_skb = w2; vc_sqb = w2 / max(-2 * r2, 0.000001);
  h1 = (w1 / vc_sqa) / sqrt(sqr(w1 * w1 - 1) + sqr(w1 / vc_sqa));
  h2 = (w2 / vc_sqb) / sqrt(sqr(w2 * w2 - 1) + sqr(w2 / vc_sqb));
  vc_sg = 1 / max(h1 * h2, 0.0001);
);
function vc_svtab(n) local(i) (
  i = 0; loop(n, vc_SF[i] = 100 * 80 ^ (i / (n - 1)); i += 1; );
  vc_bwset(1 / (80 ^ (0.5 / (n - 1)) - 80 ^ (-0.5 / (n - 1))));
);

function kr_band(m, c) instance(mc0, ma1, ma2, ms1, ms2, ms3, ms4, cc0, ca1, ca2, cs1, cs2, cs3, cs4,
                                e1, e2, ea, er, es, gl, gr, nw) local(y, u, v, t) (
  t = mc0 * m; y = t + ms1; ms1 = ms2 - ma1 * y; ms2 = -t - ma2 * y;
  t = mc0 * y; u = t + ms3; ms3 = ms4 - ma1 * u; ms4 = -t - ma2 * u;
  u = abs(u);
  e1 += (u - e1) * (u > e1 ? ea : er);
  e2 += (e1 - e2) * es;
  c += nw * vc_nz;
  t = cc0 * c; y = t + cs1; cs1 = cs2 - ca1 * y; cs2 = -t - ca2 * y;
  t = cc0 * y; u = t + cs3; cs3 = cs4 - ca1 * u; cs4 = -t - ca2 * u;
  v = min(max(u * vc_kdg, -1.5), 1.5);
  v = (v - 0.148148 * v * v * v) * e2;
  vc_kl += v * gl; vc_kr += v * gr;
);
function kr_blk(b) instance(mc0, ma1, ma2, ms1, ms2, ms3, ms4, cc0, ca1, ca2, cs1, cs2, cs3, cs4,
                            e1, e2, ea, er, es, gl, gr, nw, ti, tm, tc, wa, wb, wp, wr) local(f, fm, fc, w, g, fd, pn, hf) (
  !ti ? ( ti = 1; tm = rand(2) - 1; tc = rand(2) - 1; wa = rand(2) - 1; wb = rand(2) - 1; wp = rand(1); wr = 0.7 + rand(1) * 0.6; );
  vc_rst ? ( ms1 = ms2 = ms3 = ms4 = cs1 = cs2 = cs3 = cs4 = e1 = e2 = 0; );
  wp += vc_dinc * wr; wp >= 1 ? ( wp -= 1; wa = wb; wb = rand(2) - 1; );
  w = wa + (wb - wa) * (0.5 - 0.5 * cos($pi * wp));
  f = vc_KF[b];
  fm = f * (1 + vc_kdr * (0.6 * tm + 0.4 * w));
  vc_bp(fm, vc_kq); mc0 = vc_c0; ma1 = vc_a1; ma2 = vc_a2;
  fc = f * vc_ksm * (1 + vc_kdr * (0.6 * tc - 0.4 * w));
  fd = fc > 0.4 * srate ? max(1 - (fc - 0.4 * srate) / (0.05 * srate), 0) : fc < 40 ? max((fc - 25) / 15, 0) : 1;
  vc_bp(min(max(fc, 25), 0.45 * srate), vc_kq); cc0 = vc_c0; ca1 = vc_a1; ca2 = vc_a2;
  ea = vc_kea;
  er = 1 - exp(-1 / ((10 + 25 * sqrt(250 / f)) * 0.001 * srate * (1 + 5 * vc_kdr * w)));
  es = 1 - exp(-2 * $pi * min(max(f * 0.25, 25), 70) / srate);
  hf = 10 ^ (vc_khf * f * f / (f * f + 9000000) / 20);
  g = vc_kcal * vc_kmk * vc_kqn * min(max((f / 1000) ^ 0.25, 0.5), 1.8) * hf * fd;
  pn = (b & 1 ? -vc_kwd : vc_kwd) * min(max((f - 120) / 700, 0), 1);
  b & 1 ? g = -g;
  gl = g * (1 + pn); gr = g * (1 - pn);
  nw = f > 2500 ? vc_knw * min((f - 2500) / 3000, 1) : 0;
  abs(ms1) < 0.000000000001 ? ms1 = 0; abs(ms2) < 0.000000000001 ? ms2 = 0;
  abs(ms3) < 0.000000000001 ? ms3 = 0; abs(ms4) < 0.000000000001 ? ms4 = 0;
  abs(cs1) < 0.000000000001 ? cs1 = 0; abs(cs2) < 0.000000000001 ? cs2 = 0;
  abs(cs3) < 0.000000000001 ? cs3 = 0; abs(cs4) < 0.000000000001 ? cs4 = 0;
  e1 < 0.000000000001 ? e1 = 0; e2 < 0.000000000001 ? e2 = 0;
  vc_KMB[b] = max(vc_KMB[b], e2 * hf);
);

function sv_band(m, c) instance(ka0, ka1, ka2, kb0, kb1, kb2, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                                e1, e2, ea, er, es, gl, gr, nw) local(y, u, t) (
  t = ka0 * m; y = t + ms1; ms1 = ms2 - ka1 * y; ms2 = -t - ka2 * y;
  t = kb0 * y; u = t + ms3; ms3 = ms4 - kb1 * u; ms4 = -t - kb2 * u;
  u = abs(u);
  e1 += (u - e1) * (u > e1 ? ea : er);
  e2 += (e1 - e2) * es;
  c += nw * vc_nz;
  t = ka0 * c; y = t + cs1; cs1 = cs2 - ka1 * y; cs2 = -t - ka2 * y;
  t = kb0 * y; u = t + cs3; cs3 = cs4 - kb1 * u; cs4 = -t - kb2 * u;
  u *= e2;
  vc_sl += u * gl; vc_sr += u * gr;
);
function sv_blk(b) instance(ka0, ka1, ka2, kb0, kb1, kb2, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                            e1, e2, ea, er, es, gl, gr, nw, ti, tm, wa, wb, wp, wr) local(f, w, g, pn, tl) (
  !ti ? ( ti = 1; tm = rand(2) - 1; wa = rand(2) - 1; wb = rand(2) - 1; wp = rand(1); wr = 0.7 + rand(1) * 0.6; );
  wp += vc_dinc * wr; wp >= 1 ? ( wp -= 1; wa = wb; wb = rand(2) - 1; );
  w = wa + (wb - wa) * (0.5 - 0.5 * cos($pi * wp));
  vc_sclr || vc_rst ? ( ms1 = ms2 = ms3 = ms4 = cs1 = cs2 = cs3 = cs4 = e1 = e2 = 0; );
  b < vc_svn ? (
    f = vc_SF[b] * (1 + vc_sdr * (0.6 * tm + 0.4 * w));
    vc_bp(f * vc_ska, vc_sqa); ka0 = vc_c0; ka1 = vc_a1; ka2 = vc_a2;
    vc_bp(f * vc_skb, vc_sqb); kb0 = vc_c0; kb1 = vc_a1; kb2 = vc_a2;
    ea = vc_sea;
    er = 1 - exp(-1 / (max(vc_srel, 9000 / f) * 0.001 * srate));
    es = vc_ses;
    tl = 10 ^ (vc_stl * (f * f / (f * f + 6250000) - 0.3) / 20);
    g = vc_scal * vc_srg * vc_sg * vc_sg * vc_sqn * min(max((f / 1000) ^ 0.25, 0.5), 1.8) * tl;
    pn = (b & 1 ? -vc_swd : vc_swd) * min(max((f - 120) / 700, 0), 1);
    b & 1 ? g = -g;
    gl = g * (1 + pn); gr = g * (1 - pn);
    nw = f > 2500 ? vc_snw * min((f - 2500) / 3000, 1) : 0;
    abs(ms1) < 0.000000000001 ? ms1 = 0; abs(ms2) < 0.000000000001 ? ms2 = 0;
    abs(ms3) < 0.000000000001 ? ms3 = 0; abs(ms4) < 0.000000000001 ? ms4 = 0;
    abs(cs1) < 0.000000000001 ? cs1 = 0; abs(cs2) < 0.000000000001 ? cs2 = 0;
    abs(cs3) < 0.000000000001 ? cs3 = 0; abs(cs4) < 0.000000000001 ? cs4 = 0;
    e1 < 0.000000000001 ? e1 = 0; e2 < 0.000000000001 ? e2 = 0;
    vc_SMB[b] = max(vc_SMB[b], e2 * vc_sg * tl);
  ) : ( gl = gr = 0; );
);

function tp_band(m, c) instance(p0, p1, p2, p3, p4, q0, q1, q2, q3, q4, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                                e1, e2, ea, er, es, nw) local(y, u) (
  y = p0 * m + ms1; ms1 = p1 * m - p3 * y + ms2; ms2 = p2 * m - p4 * y;
  u = q0 * y + ms3; ms3 = q1 * y - q3 * u + ms4; ms4 = q2 * y - q4 * u;
  u = abs(u);
  e1 += (u - e1) * (u > e1 ? ea : er);
  e2 += (e1 - e2) * es;
  c += nw * vc_nz;
  y = p0 * c + cs1; cs1 = p1 * c - p3 * y + cs2; cs2 = p2 * c - p4 * y;
  u = q0 * y + cs3; cs3 = q1 * y - q3 * u + cs4; cs4 = q2 * y - q4 * u;
  u * e2;
);
function tp_blk(f, rel, nwt) instance(p0, p1, p2, p3, p4, q0, q1, q2, q3, q4, ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4,
                                      e1, e2, ea, er, es, nw) (
  vc_hp(f, 0.5412); p0 = vc_h0; p1 = vc_h1; p2 = vc_h2; p3 = vc_h3; p4 = vc_h4;
  vc_hp(f, 1.3066); q0 = vc_h0; q1 = vc_h1; q2 = vc_h2; q3 = vc_h3; q4 = vc_h4;
  ea = 1 - exp(-1 / (0.001 * srate)); er = 1 - exp(-1 / (rel * 0.001 * srate)); es = 1 - exp(-2 * $pi * 70 / srate);
  nw = nwt;
  abs(ms1) < 0.000000000001 ? ms1 = 0; abs(ms2) < 0.000000000001 ? ms2 = 0;
  abs(ms3) < 0.000000000001 ? ms3 = 0; abs(ms4) < 0.000000000001 ? ms4 = 0;
  abs(cs1) < 0.000000000001 ? cs1 = 0; abs(cs2) < 0.000000000001 ? cs2 = 0;
  abs(cs3) < 0.000000000001 ? cs3 = 0; abs(cs4) < 0.000000000001 ? cs4 = 0;
  e1 < 0.000000000001 ? e1 = 0; e2 < 0.000000000001 ? e2 = 0;
);
function tp_clr() instance(ms1, ms2, ms3, ms4, cs1, cs2, cs3, cs4, e1, e2) ( ms1 = ms2 = ms3 = ms4 = cs1 = cs2 = cs3 = cs4 = e1 = e2 = 0; );

function vc_rt(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function vc_xfm(x, k, d, tb, sn) instance(lo) local(t) (
  lo += (x - lo) * vc_xlc;
  t = x + lo / sqrt(1 + sqr(k * lo)) - lo;
  (vc_rt(d * (t + 0.08)) - tb) * sn;
);
function vc_xset(d) local(t) ( t = vc_rt(d * 0.08); vc_xtb = t; t = (vc_rt(d * 0.08 + 0.0001) - t) / 0.0001; vc_xsn = 1 / (t * d); );

function vc_blep(t, dt) ( t < dt ? ( t /= dt; 2 * t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + 2 * t + 1; ) : 0; );
function vc_all_off() local(p) ( p = vc_VO; loop(8, p[1] = 0; p[10] = 0; p += 16; ); vc_nheld = 0; );
function vc_non(n, v) local(p, q, i, best, lo) (
  vc_hold && vc_nheld == 0 ? ( p = vc_VO; loop(8, p[1] = 0; p += 16; ); );
  vc_nheld += 1;
  q = -1; p = vc_VO;
  loop(8, p[0] == n ? q = p; p += 16; );
  q < 0 ? ( p = vc_VO; loop(8, q < 0 && p[0] < 0 ? q = p; p += 16; ); );
  q < 0 ? ( lo = 2; p = vc_VO; loop(8, !p[1] && p[2] < lo ? ( lo = p[2]; q = p; ); p += 16; ); );
  q < 0 ? ( best = 1000000000; p = vc_VO; loop(8, p[8] < best ? ( best = p[8]; q = p; ); p += 16; ); );
  q[0] < 0 ? ( q[2] = 0; q[5] = rand(1); q[6] = rand(1); q[7] = rand(1); );
  q[4] = 440 * 2 ^ ((n - 69) / 12) / srate;
  q[3] = vc_glon ? ( q[3] > 0 ? q[3] : vc_linc > 0 ? vc_linc : q[4] ) : q[4];
  q[0] = n; q[1] = 1; q[10] = 1; q[9] = 0.55 + 0.45 * v / 127;
  vc_age += 1; q[8] = vc_age;
  vc_linc = q[4]; vc_vact = 1; vc_mhit += 1;
);
function vc_noff(n) local(p) (
  vc_nheld = max(vc_nheld - 1, 0);
  p = vc_VO; loop(8, p[0] == n && p[10] ? ( p[10] = 0; !vc_hold ? p[1] = 0; ); p += 16; );
);

function vc_update() local(w, sv) (
  slider9 < 1.5 ? (
    slider2 = (slider8 >= 0.5 && (slider1 < 0.5 || slider21 >= 50)) ? (slider9 >= 0.5) : (slider2 >= 0.5);
    slider9 = 2;
  );
  vc_kon = slider1 >= 0.5; vc_kbt = slider2 >= 0.5;
  w = min(max(slider3, 0), 100) / 100;
  vc_kqt = 10 * 0.26 ^ w;
  vc_ksht = 2 ^ min(max(slider4, -1), 1);
  vc_kdgt = 0.45 + 7.5 * (min(max(slider5, 0), 100) / 100) ^ 1.6;
  vc_khft = min(max(slider6, 0), 12);
  vc_kdit = min(max(slider7, 0), 100) / 100;
  vc_von = slider8 >= 0.5; vc_vbt = vc_kbt;
  vc_svt = slider10 >= 0.5 ? 24 : 16;
  vc_srel = slider11 >= 0.5 ? 160 : 30;
  vc_srg = slider11 >= 0.5 ? 0.75 : 1;
  vc_ses = 1 - exp(-2 * $pi * (slider11 >= 0.5 ? 12 : 40) / srate);
  sv = min(max(slider12, 0), 100) / 100;
  vc_uvon = sv > 0.004;
  vc_uvr = 10 ^ (1.2 - 2.4 * sv);
  vc_uvz = 0.24 - 0.16 * sv;
  vc_uvg = 10 ^ ((-50 - 20 * sv) / 10);
  vc_stlt = min(max(slider13, -12), 12);
  vc_levt = 0.36 * 10 ^ (min(max(slider14, -24), 6) / 20);
  vc_tun = 2 ^ ((min(max(slider15, -12), 12) + 12 * floor(min(max(slider16, -2), 2) + 0.5)) / 12);
  vc_glon = slider17 >= 0.5;
  vc_glc = vc_glon ? 1 - exp(-1 / (slider17 * 0.001 * srate)) : 1;
  vc_wav = slider18 | 0;
  vc_src = slider19 >= 0.5;
  vc_hn = slider20 >= 0.5;
  vc_mch = slider31 | 0;
  vc_balt = min(max(slider21, 0), 100) / 100;
  vc_mixt = min(max(slider22, 0), 100) / 100;
  drift_macro(slider23);
  vc_ogt = 10 ^ (slider24 / 20);
  ost_setup(slider25 / 100, slider26 / 100, slider27, slider28, slider29, 1);
);

function vc_setK(on, md, wd, sh, dr, hf, di) (
  slider1 = on; slider2 = md; slider3 = wd; slider4 = sh; slider5 = dr; slider6 = hf; slider7 = di;
);
function vc_setS(on, bn, rl, uv, tl) (
  slider8 = on; slider9 = 2; slider10 = bn; slider11 = rl; slider12 = uv; slider13 = tl;
);
function vc_setC(lv, tu, oc, gl, wv, src, hd) (
  slider14 = lv; slider15 = tu; slider16 = oc; slider17 = gl; slider18 = wv; slider19 = src; slider20 = hd;
);
function vc_setM(bal, mix, dr) (
  slider21 = bal; slider22 = mix; slider23 = dr;
  slider_automate(8388607);
);
function load_preset(p) (
  p == 1  ? ( vc_setK(1, 0, 50,  0,    25,  4,  0); vc_setS(1, 0, 0, 50,  0); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM( 50, 100,  50); ) :
  p == 2  ? ( vc_setK(1, 1, 72,  0,    40,  6,  0); vc_setS(1, 0, 0, 40,  2); vc_setC(  0, 0, -1,   0, 1, 1, 0); vc_setM( 35, 100,  25); ) :
  p == 3  ? ( vc_setK(1, 0, 38,  0,    10,  3,  0); vc_setS(1, 1, 1, 45, -2); vc_setC( -2, 0,  0,  60, 2, 1, 0); vc_setM( 70, 100,  45); ) :
  p == 4  ? ( vc_setK(1, 0, 35,  0,    15,  4,  0); vc_setS(1, 1, 1, 40,  1); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM( 60, 100,  40); ) :
  p == 5  ? ( vc_setK(1, 1, 76,  0,    85,  8,  0); vc_setS(0, 0, 0, 50,  0); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM(  0, 100,  70); ) :
  p == 6  ? ( vc_setK(0, 0, 50,  0,    25,  4,  0); vc_setS(1, 1, 0, 60,  2); vc_setC(  0, 0,  0,   0, 0, 0, 0); vc_setM(100, 100,  20); ) :
