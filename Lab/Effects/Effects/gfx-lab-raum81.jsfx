function rq_dial(cx, cy, r, idx, lo, hi, def, lg, sty, col, lbl) local(n, ext, fs, ly) (
  rq_cap = idx == 3 ? 0xF4CDA2 : idx == 18 || idx == 20 ? 0xA9DDE0 : idx == 19 || idx == 21 ? 0xC9B9E4 : idx == 4 ? 0xF2B9B0 : 0xD6E2B4;
  ext = sty == 0 ? 11 : sty == 2 ? 13 : 9;
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + ext), 0, 200);
  sty == 0 ? v5_dial_arc(cx, cy, r, n) : sty == 1 ? ( v5_bptr = col; rq_cream(cx, cy, r, n); rq_ends(cx, cy, r + ext + 2, 1.8); rq_zero ? ( rq_fa(10); ui_col(0x9A9C98); v5_t(cx, cy - r - 8, "0"); ); ) : ( v5_led = col; rq_ring(cx, cy, r, n); );
  fs = r >= 30 ? 16 : 14; ly = cy + r + ext + 6 + fs * 0.55;
