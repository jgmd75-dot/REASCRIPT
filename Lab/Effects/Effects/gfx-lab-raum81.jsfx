desc:Raum81 [chorus] (GFX Lab)
//tags: chorus thickener detune doubler stereo widener bbd ensemble
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

slider27:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:2<0,10,1{Off,1,2,3,4,1+2,1+3,1+4,2+3,2+4,3+4}>-Mode (buttons)
slider2:0<-24,12,0.1>-Input trim (dB)
slider3:100<0,100,1>-Mix (%)
slider4:100<0,100,1>-Width (%)
slider5:0<0,1,1{Mono,Stereo}>-Wet input
slider6:50<0,100,1>-Drift (%)
slider7:0<-24,12,0.1>-Output (dB)
slider8:0<0,1,1{Off,On}>-Mono sum check
slider9:1<1,2,1>-Voice (1 = I, 2 = II)
slider10:0<0,100,1>-Band sat (%)
slider11:30<0,100,1>-Bias (%)
slider12:120<40,400,1>-Sat low band (Hz)
slider13:6000<2000,16000,10>-Sat high band (Hz)
slider14:-0.3<-24,0,0.1>-Ceiling (dB)
slider15:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider16:0<0,1,1{ENG,DE}>-(unused, was label language)
slider17:0<0,1,1{Off,On}>-Microshift
slider18:8<-50,50,0.1>-Microshift left pitch (cents)
slider19:11<0,50,0.1>-Microshift left delay (ms)
slider20:-8<-50,50,0.1>-Microshift right pitch (cents)
slider21:17<0,50,0.1>-Microshift right delay (ms)
slider22:1<0,1,1{Off,On}>-Microshift adaptive tracking
slider23:0<0,1,1{Off,On}>-Microshift color
slider24:0<0,2,1{Normal,Wide,Narrow}>-Microshift spread
slider25:byp_on=0<0,1,1{Off,On}>-Bypass
slider26:prs_sel=0<0,17,1{No preset,Init,Vocal Air,Keys Wide,Bass Safe,Guitar Double,1+4 Deep,Strings Bloom,Pad Halo,Backing Vocals,Drum Room,Mono Check,Vocal Doubler,Wide Guitar,Subtle Thickener,Quarter-Tone Detune,Doubled Ensemble,Slap Double}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-raum81";
function psw_all(v) ( slider_show(134217727, v); );
function psw_allg(v) ( slider_show(134217727, v); );
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
rz_den = 0.000000000000000001;

function rz_bits(m) (
  m = m | 0;
  m == 0 ? 0 : m <= 4 ? 2 ^ (m - 1) : m == 5 ? 3 : m == 6 ? 5 : m == 7 ? 9 : m == 8 ? 6 : m == 9 ? 10 : 12;
);
function rz_idx(b) (
  b == 1 ? 1 : b == 2 ? 2 : b == 4 ? 3 : b == 8 ? 4 : b == 3 ? 5 : b == 5 ? 6 : b == 9 ? 7 :
  b == 6 ? 8 : b == 10 ? 9 : b == 12 ? 10 : 0;
);
function rz_brate(i) ( i == 3 ? 0.5 : 0.25 );
function rz_bdep(i)  ( i == 0 ? 0.35 : i == 1 ? 0.65 : i == 2 ? 1.00 : 1.35 );
function rz_bwet(i)  ( i == 0 ? 0.50 : i == 1 ? 0.58 : i == 2 ? 0.66 : 0.75 );
function rz_modeset(m) local(b, i, n, a, c) (
  b = rz_bits(m); n = 0; a = -1; c = -1;
  i = 0; loop(4, b & (2 ^ i) ? ( n += 1; a < 0 ? (a = i) : (c = i); ); i += 1; );
  n == 0 ? ( rz_wt = 0; ) :
  n == 1 ? ( rz_rt = rz_brate(a); rz_dt = rz_bdep(a); rz_wt = rz_bwet(a); ) : (
    rz_rt = 0.5 * (rz_brate(a) + rz_brate(c));
    rz_dt = 1.1 * sqrt(sqr(rz_bdep(a)) + sqr(rz_bdep(c)));
    rz_wt = max(rz_bwet(a), rz_bwet(c)) + 0.02;
  );
  rz_on = n > 0;
);

function rz_lpset(f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function rz_hpset(f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * f / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function rz_hp(x) instance(z1, z2) local(y) (
  y = rzH.b0 * x + z1; z1 = rzH.b1 * x - rzH.a1 * y + z2; z2 = rzH.b2 * x - rzH.a2 * y; y;
);

function rz_rd(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = rz_wp - d; rp < 0 ? rp += rz_bsz;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + rz_bsz - 1) & rz_mask];
  x0  = buf[i & rz_mask];
  x1  = buf[(i + 1) & rz_mask];
  x2  = buf[(i + 2) & rz_mask];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
function rz_line(x, buf, d) instance(p1, p2, q1, q2, r1, r2) local(y, v) (
  x += rz_den;
  y = rzP.b0 * x + p1; p1 = rzP.b1 * x - rzP.a1 * y + p2; p2 = rzP.b2 * x - rzP.a2 * y;
  buf[rz_wp] = y;
  v = rz_rd(buf, d);
  v = ost_tanh(v * rz_sk) * rz_ski;
  y = rzQ.b0 * v + q1; q1 = rzQ.b1 * v - rzQ.a1 * y + q2; q2 = rzQ.b2 * v - rzQ.a2 * y;
  v = rzR.b0 * y + r1; r1 = rzR.b1 * y - rzR.a1 * v + r2; r2 = rzR.b2 * y - rzR.a2 * v;
  v;
);

function rz_voice(v) (
  v == 0 ? (
    rz_cen = 3.2; rz_sk = 0.7; rz_ski = 1.4285714; rz_shp = 0; rz_fdp = 0; rz_vtr = 1;
    rzP.rz_lpset(9500, 0.7071); rzQ.rz_lpset(9000, 0.5412); rzR.rz_lpset(9000, 1.3066);
    rzH.rz_hpset(110, 0.7071);
  ) : (
    rz_cen = 4.6; rz_sk = 0.95; rz_ski = 1 / 0.95; rz_shp = 1; rz_fdp = 0.045; rz_vtr = 1.06;
    rzP.rz_lpset(7800, 0.7071); rzQ.rz_lpset(7200, 0.5412); rzR.rz_lpset(7200, 1.3066);
    rzH.rz_hpset(140, 0.7071);
  );
);

function ms_bq(x) instance(z1, z2) local(y) (
  y = pdK.b0 * x + z1; z1 = pdK.b1 * x - pdK.a1 * y + z2; z2 = pdK.b2 * x - pdK.a2 * y; y;
);
function ms_rd(d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = ms_wp - d; rp < 0 ? rp += ms_bsz;
  i = floor(rp); f = rp - i;
  xm1 = ms_buf[(i + ms_bsz - 1) & ms_mask];
  x0  = ms_buf[i & ms_mask];
  x1  = ms_buf[(i + 1) & ms_mask];
  x2  = ms_buf[(i + 2) & ms_mask];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
function ms_align(d, jlo, jhi, sg) local(p, q, j, s, e, best, jb, m) (
  p = floor(ms_wp - d); best = 10 ^ 30; jb = jlo; j = jlo;
  loop(max(jhi - jlo + 1, 1),
    q = p - sg * j; s = 0; m = 0;
    loop(ms_ln, e = ms_buf[(p - m) & ms_mask] - ms_buf[(q - m) & ms_mask]; s += e * e; m += ms_st; );
    s < best ? ( best = s; jb = j; );
    j += 1;
  );
  jb;
);
function ms_yin() local(n, i, j, t, s, e, p, q, cum, bt, tf, a, b, c, d, en, go) (
  n = ms_W + ms_tmax;
  i = 0; j = (pd_wi - n) & 1023;
  loop(n, pd_x[i] = pd_buf[j]; j = (j + 1) & 1023; i += 1; );
  en = 0; p = pd_x; loop(ms_W, en += p[0] * p[0]; p += 1; );
  cum = 0; t = 1;
  loop(ms_tmax,
    s = 0; p = pd_x; q = pd_x + t;
    loop(ms_W, e = p[0] - q[0]; s += e * e; p += 1; q += 1; );
    cum += s;
    pd_d[t] = cum > 0 ? s * t / cum : 1;
    t += 1;
  );
  bt = 0; t = ms_tmin; go = 1;
  while (go && t < ms_tmax) (
    pd_d[t] < 0.12 ? (
      while (t + 1 < ms_tmax && pd_d[t + 1] < pd_d[t]) ( t += 1; );
      bt = t; go = 0;
    );
    t += 1;
  );
  bt == 0 ? ( d = 2; t = ms_tmin; loop(ms_tmax - ms_tmin, pd_d[t] < d ? ( d = pd_d[t]; bt = t; ); t += 1; ); );
  tf = bt;
  bt > ms_tmin && bt < ms_tmax - 1 ? (
    a = pd_d[bt - 1]; b = pd_d[bt]; c = pd_d[bt + 1]; d = a - 2 * b + c;
    d > 0 ? ( tf = bt + 0.5 * (a - c) / d; );
  );
  en > ms_W * 0.00001 && pd_d[bt] < 0.2 ? (
    tf *= ms_dec;
    abs(tf - ms_T) < 0.04 * ms_T ? ( ms_T += (tf - ms_T) * 0.5; ) : ( ms_T = tf; );
    ms_lkt = 1;
  ) : ( ms_lkt = 0; );
);
function ms_dly(v) instance(dt, hold) local(t) (
  t = min(max(v, 0), 50) * srate / 1000;
  t != dt ? ( dt = t; hold = floor(0.04 * srate); );
);
function ms_side() instance(c, ct, dA, dB, act, fp, fs, fl, dc, dt, g, hold) local(rr, dh, j, j0, jl, jh, y, p, wn, wo, base, mv) (
  c += (ct - c) * rz_smk;
  rr = 1 - exp(c * 0.000577622650466621);
  dA = min(max(dA + rr, 0), ms_omax); dB = min(max(dB + rr, 0), ms_omax);
  hold > 0 ? hold -= 1;
  mv = hold > 0 || dc != dt;
  g += ((!mv) - g) * (mv ? ms_kdn : ms_kup);
  mv && g < 0.0005 ? ( dc = dt; );
  base = 3 + dc;
  dh = act ? dB : dA;
  fp >= 1 && rr != 0 && (rr < 0 ? dh <= ms_X * -rr + 1 : dh >= ms_J) ? (
    j0 = floor(ms_J + 0.5);
    ms_ref ? (
      jl = j0 - ms_R; jh = j0 + ms_R;
      rr > 0 ? ( jh = min(jh, floor(dh)); );
      j = ms_align(base + dh, max(jl, 1), jh, rr < 0 ? 1 : -1);
    ) : ( j = rr > 0 ? min(j0, floor(dh)) : j0; );
    act ? ( dA = dh + (rr < 0 ? j : -j); ) : ( dB = dh + (rr < 0 ? j : -j); );
    act = !act; fp = 0; fs = 1 / ms_X; fl = ms_lk;
  );
  fp < 1 ? (
    fp = min(fp + fs, 1); p = fp;
    wn = fl * (0.5 - 0.5 * cos($pi * p)) + (1 - fl) * sin(0.5 * $pi * p);
    wo = fl * (0.5 + 0.5 * cos($pi * p)) + (1 - fl) * cos(0.5 * $pi * p);
    y = wn * ms_rd(base + (act ? dB : dA)) + wo * ms_rd(base + (act ? dA : dB));
  ) : ( y = ms_rd(base + (act ? dB : dA)); );
  y * g;
);
function ms_col(x) instance(lp, hx, hy) local(y) (
  y = (ost_tanh(1.5 * (x + 0.1)) - ms_cb0) * ms_cbn;
  lp += (y - lp) * ms_clp;
  hy = lp - hx + 0.9995 * hy; hx = lp;
  hy;
);

function update() (
  rz_modeset(slider1);
  in_setup(slider2, 0);
  rz_mxt = slider3 / 100;
  rz_kt = 0.9 * slider4 / 100;
  rz_st = slider5 > 0.5;
  drift_macro(slider6);
  rz_ot = 10 ^ (slider7 / 20);
  rz_sumt = slider8 > 0.5;
  rz_hs = slider6 / 100 * 0.00007;
  ost_setup(slider10 / 100, slider11 / 100, slider12, slider13, slider14, 1);
  rz_vmt = slider9 >= 1.5;
  ms_ont = slider17 > 0.5;
  msL.ct = min(max(slider18, -50), 50); msL.ms_dly(slider19);
  msR.ct = min(max(slider20, -50), 50); msR.ms_dly(slider21);
  ms_trk = ms_ont && slider22 > 0.5;
  ms_cbt = slider23 > 0.5;
  ms_kst = slider24 < 0.5 ? 1 : slider24 < 1.5 ? 1.7 : 0.4;
);

function rz_set(m, tr, mx, wd, st, dr, ou, sm) (
  slider1 = m; slider2 = tr; slider3 = mx; slider4 = wd; slider5 = st; slider6 = dr; slider7 = ou; slider8 = sm;
  slider_automate(255);
);
function rz_ms(md, on, lp, ld, rp, rd, ad, co, sp) (
  slider9 = md; slider17 = on; slider18 = lp; slider19 = ld; slider20 = rp; slider21 = rd;
  slider22 = ad; slider23 = co; slider24 = sp;
  slider_automate(256 + 16711680);
);
function load_preset(p) (
  p == 1  ? rz_set( 2, 0, 100, 100, 0, 50, 0, 0) :
  p == 2  ? rz_set( 1, 0, 100, 100, 0, 40, 0, 0) :
  p == 3  ? rz_set( 3, 0, 100, 100, 1, 50, 0, 0) :
  p == 4  ? rz_set( 1, 0,  70, 100, 0, 30, 0, 0) :
  p == 5  ? rz_set( 4, 0, 100, 100, 0, 60, 0, 0) :
  p == 6  ? rz_set( 7, 0, 100, 100, 0, 50, 0, 0) :
  p == 7  ? rz_set(10, 0, 100, 100, 1, 70, 0, 0) :
  p == 8  ? rz_set( 9, 0, 100, 100, 1, 60, 0, 0) :
  p == 9  ? rz_set( 6, 0,  80,  85, 0, 45, 0, 0) :
  p == 10 ? rz_set( 5, 0,  60,  60, 0, 35, 0, 0) :
  p == 11 ? rz_set( 2, 0, 100, 100, 0, 50, 0, 1) :
  p == 12 ? ( rz_set( 0, 0, 100, 100, 0, 50, 0, 0); rz_ms(1, 1,   7, 10,  -7, 15, 1, 0, 0); ) :
  p == 13 ? ( rz_set( 0, 0, 100, 100, 0, 50, 0, 0); rz_ms(2, 1,  11, 19, -11, 27, 1, 1, 1); ) :
  p == 14 ? ( rz_set( 1, 0,  70, 100, 0, 40, 0, 0); rz_ms(1, 1,   4,  5,  -4,  8, 1, 0, 2); ) :
  p == 15 ? ( rz_set( 0, 0,  60, 100, 0, 50, 0, 0); rz_ms(2, 1,  50,  2, -50,  4, 1, 0, 0); ) :
  p == 16 ? ( rz_set( 2, 0, 100, 100, 0, 50, 0, 0); rz_ms(2, 1,   8, 12,  -8, 18, 1, 1, 0); ) :
  p == 17 ? ( rz_set( 0, 0, 100, 100, 0, 50, 0, 0); rz_ms(1, 1, -14, 36,  14, 47, 1, 1, 1); ) :
  p == 18 ? (
    rz_set(2, 0, 100, 100, 0, 50, 0, 0);
    rz_ms(1, 0, 8, 11, -8, 17, 1, 0, 0);
    slider10 = 0; slider11 = 30; slider12 = 120; slider13 = 6000; slider14 = -0.3; slider15 = 1; slider16 = 0;
    slider_automate(16777215);
  );
  p >= 1 && p <= 11 ? ( slider9 = 1; slider17 = 0; slider_automate(256 + 65536); );
);

function rz_srinit() (
  rz_sr = srate;
  rz_bsz = srate > 100000 ? 8192 : 4096; rz_mask = rz_bsz - 1;
  nextmem = 0;
  rz_bufA = alloc(rz_bsz);
  rz_bufB = alloc(rz_bsz);
  ost_init(alloc(4096));
  rz_wp = 0;
  rz_voice(rz_vm);
  ms_bsz = 2 ^ ceil(log(0.13 * srate + 64) / log(2)); ms_mask = ms_bsz - 1;
  ms_buf = alloc(ms_bsz); ms_wp = 0;
  pd_buf = alloc(1024); pd_x = alloc(512); pd_d = alloc(256); pd_wi = 0; pd_n = 0; ms_dcn = 0;
  ms_dec = max(1, floor(srate / 8000 + 0.5));
  ms_fd = srate / ms_dec;
  ms_W = floor(ms_fd * 0.0125 + 0.5);
  ms_tmax = min(floor(ms_fd / 75), 250);
  ms_tmin = max(2, floor(ms_fd / 1000));
  ms_hop = floor(ms_fd * 0.02 + 0.5);
  pdK.rz_lpset(1800, 0.7071);
  ms_Jn = 0.02 * srate;
  ms_omax = 0.05 * srate;
  ms_T = 0.005 * srate; ms_J = ms_Jn; ms_X = 0.03 * srate; ms_ref = 0; ms_lk = 0; ms_R = 2; ms_ln = 64; ms_st = 1;
  ms_kdn = 1 - exp(-1 / (0.003 * srate));
  ms_kup = 1 - exp(-1 / (0.025 * srate));
  ms_clp = 1 - exp(-2 * $pi * 13000 / srate);
  ms_cb0 = ost_tanh(0.15); ms_cbn = 1 / (1.5 * (1 - ms_cb0 * ms_cb0));
  ms_kc = 1 - exp(-1 / (0.3 * srate));
  rz_smf = 1 - exp(-1 / (0.006 * srate));
  in_init();
  rz_msr = srate / 1000;
  rz_sms = 1 - exp(-1 / (0.35 * srate));
  rz_smw = 1 - exp(-1 / (0.12 * srate));
  rz_smk = 1 - exp(-1 / (0.03 * srate));
  rz_smd = 1 - exp(-1 / (0.5 * srate));
);
rz_vm = slider9 >= 1.5; rz_vmt = rz_vm; rz_mf = 1;
rz_srinit(); ostL.ost_ch_init(); ostR.ost_ch_init();
rz_hpc = 0;
rz_ph = rand(1);
drA.drift_init(0.8 + rand(1) * 0.5); drB.drift_init(0.8 + rand(1) * 0.5); drR.drift_init(0.8 + rand(1) * 0.5);
rz_ipk = 0; rz_opkL = 0; rz_opkR = 0;
update();
rz_r = rz_rt; rz_d = rz_dt; rz_w = rz_wt; rz_mx = rz_mxt; rz_k = rz_kt; rz_o = rz_ot; rz_sum = rz_sumt; rz_stm = rz_st;
rz_cA = 0; rz_cB = 0; rz_dvA = 0; rz_dvB = 0; rz_rv = 0; rz_fph = 0; rz_fv = 0;
ms_on = ms_ont; ms_cb = ms_cbt; ms_ks = ms_kst; ms_lock = 0; ms_lkt = 0;
msL.c = msL.ct; msL.dc = msL.dt; msL.hold = 0; msL.g = 1; msL.fp = 1; msL.act = 0; msL.dA = 0; msL.dB = 0;
msR.c = msR.ct; msR.dc = msR.dt; msR.hold = 0; msR.g = 1; msR.fp = 1; msR.act = 0; msR.dA = 0; msR.dB = 0;
ms_cxy = 0; ms_cxx = 0; ms_cyy = 0;

by_setup(25);
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 0.8; pwr_wu_lp = 9000; pwr_bloom = 0;
#rz_pm = "Init|Vocal Air|Keys Wide|Bass Safe|Guitar Double|1+4 Deep|Strings Bloom|Pad Halo|Backing Vocals|Drum Room|Mono Check|Vocal Doubler|Wide Guitar|Subtle Thickener|Quarter-Tone Detune|Doubled Ensemble|Slap Double";
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(25, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 17 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(17, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();

@block
prs_chk();
rz_now = time_precise();
rz_tp > 0 && rz_now - rz_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > rz_gpp && play_position - rz_gpp < 4 * rz_gpd + 0.05) ? (
  memset(rz_bufA, 0, rz_bsz); memset(rz_bufB, 0, rz_bsz); memset(ms_buf, 0, ms_bsz);
  rz_mf = 0; ms_on = 0;
);
rz_tp = rz_now; rz_gpp = play_position; rz_gpd = samplesblock / srate;
srate != rz_sr ? rz_srinit();
update();
rz_di = 0.2 * dm_s * samplesblock / srate;
rz_dvA = 0.025 * dm_a * drA.drift_tick(rz_di);
rz_dvB = 0.025 * dm_a * drB.drift_tick(rz_di);
rz_rv  = 0.04  * dm_a * drR.drift_tick(rz_di);
pwr_block(byp_on < 0.5);
ms_trk && pd_n >= ms_hop ? ( pd_n = 0; ms_yin(); );
!ms_trk ? ms_lkt = 0;
ms_lock += (ms_lkt - ms_lock) * min(1, samplesblock / (0.06 * srate));
ms_lock > 0.5 ? (
  ms_J = max(1, floor(ms_Jn / ms_T + 0.5)) * ms_T;
  ms_ref = 1; ms_lk = 1;
  ms_R = min(max(floor(0.3 * ms_T), 2), floor(0.0006 * srate) + 2);
  ms_st = max(1, floor(srate / 24000));
  ms_ln = floor(min(max(1.5 * ms_T, 0.006 * srate), 0.01 * srate) / ms_st);
  ms_X = max(0.012 * srate, 2 * ms_T);
) : (
  ms_J = ms_Jn; ms_ref = 0; ms_lk = 0; ms_X = 0.03 * srate;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
by_in();
in_process(spl0, spl1);
pwr_in(in_l, in_r);
rz_l = pwr_l; rz_r0 = pwr_r;
rz_ipk = max(rz_ipk, max(abs(rz_l), abs(rz_r0)));

rz_r  += (rz_rt - rz_r) * rz_sms;
rz_d  += (rz_dt - rz_d) * rz_sms;
rz_w  += (rz_wt - rz_w) * rz_smw;
rz_mx += (rz_mxt - rz_mx) * rz_smk;
rz_k  += (rz_kt - rz_k) * rz_smk;
rz_o  += (rz_ot - rz_o) * rz_smk;
rz_sum += (rz_sumt - rz_sum) * rz_smw;
rz_stm += (rz_st - rz_stm) * rz_smw;
rz_cA += (rz_dvA - rz_cA) * rz_smd;
rz_cB += (rz_dvB - rz_cB) * rz_smd;

ms_on += (ms_ont - ms_on) * rz_smw;
ms_in = 0.5 * (rz_l + rz_r0);
ms_buf[ms_wp] = ms_in;
ms_trk ? (
  ms_y = pdA.ms_bq(ms_in + rz_den); ms_y = pdB.ms_bq(ms_y);
  (ms_dcn += 1) >= ms_dec ? ( ms_dcn = 0; pd_buf[pd_wi] = ms_y; pd_wi = (pd_wi + 1) & 1023; pd_n += 1; );
);
ms_ont || ms_on > 0.00002 ? (
  ms_a = msL.ms_side();
  ms_b = msR.ms_side();
  ms_cb += (ms_cbt - ms_cb) * rz_smk;
  ms_cb > 0.0001 ? ( ms_a += (cL.ms_col(ms_a) - ms_a) * ms_cb; ms_b += (cR.ms_col(ms_b) - ms_b) * ms_cb; );
  ms_ks += (ms_kst - ms_ks) * rz_smk;
  ms_m = 0.5 * (ms_a + ms_b); ms_s = 0.5 * (ms_a - ms_b) * ms_ks;
  ms_gg = ms_on * rz_mx * 0.8;
  ms_cm = 1 / sqrt(1 + 0.9 * ms_gg * ms_gg);
  ms_g = ms_gg * ms_cm * sqrt(2 / (1 + ms_ks * ms_ks));
  rz_l  = rz_l  * ms_cm + ms_g * (ms_m + ms_s);
  rz_r0 = rz_r0 * ms_cm + ms_g * (ms_m - ms_s);
);
ms_wp = (ms_wp + 1) & ms_mask;

rz_mf += ((rz_vm == rz_vmt) - rz_mf) * rz_smf;
rz_vm != rz_vmt && rz_mf < 0.002 ? ( rz_vm = rz_vmt; rz_voice(rz_vm); );

rz_ph += rz_r * (1 + rz_rv) / srate; rz_ph >= 1 ? rz_ph -= 1;
rz_shp == 0 ? (
  rz_t = rz_ph < 0.5 ? 4 * rz_ph - 1 : 3 - 4 * rz_ph;
  rz_lv = rz_t * (1.5 - 0.5 * rz_t * rz_t);
  rz_fv = 0;
) : (
  rz_lv = -cos(2 * $pi * rz_ph);
  rz_fph += 5.7 / srate; rz_fph >= 1 ? rz_fph -= 1;
  rz_fv = rz_fdp * sin(2 * $pi * rz_fph);
);

rz_m = 0.5 * (rz_l + rz_r0);
rz_xa = rz_m + (rz_l - rz_m) * rz_stm;
rz_xb = rz_m + (rz_r0 - rz_m) * rz_stm;
rz_hs > 0 ? ( rz_xa += rz_hs * (rand(2) - 1); rz_xb += rz_hs * (rand(2) - 1); );
rz_dA = max((rz_cen * (1 + rz_cA) + rz_d * rz_lv + rz_fv) * rz_msr, 2);
rz_dB = max((rz_cen * (1 + rz_cB) - rz_d * rz_lv - rz_fv) * rz_msr, 2);
rz_a = lnA.rz_line(rz_xa, rz_bufA, rz_dA);
rz_b = lnB.rz_line(rz_xb, rz_bufB, rz_dB);
rz_wp = (rz_wp + 1) & rz_mask;

rz_g0 = rz_w * rz_mx;
rz_cmp = 1 / sqrt(sqrt(1 + 2 * rz_g0 * rz_g0));
rz_g = rz_g0 * rz_mf * rz_vtr;
rz_ol = (rz_l  + rz_g * hwL.rz_hp(rz_a - rz_k * rz_b)) * rz_cmp;
rz_or = (rz_r0 + rz_g * hwR.rz_hp(rz_b - rz_k * rz_a)) * rz_cmp;
rz_mm = 0.5 * (rz_ol + rz_or);
rz_ol += (rz_mm - rz_ol) * rz_sum; rz_or += (rz_mm - rz_or) * rz_sum;

pwr_out(rz_ol, rz_or); rz_ol = pwr_l; rz_or = pwr_r;
rz_ol = ostL.ost_band(rz_ol) * rz_o;
rz_or = ostR.ost_band(rz_or) * rz_o;
ost_out(rz_ol, rz_or);
spl0 = ost_l; spl1 = ost_r;
by_out();
rz_opl_d = max(rz_opl_d, abs(spl0)); rz_opr_d = max(rz_opr_d, abs(spl1));
rz_opkL = max(rz_opkL, abs(spl0)); rz_opkR = max(rz_opkR, abs(spl1));
ms_cxy += (spl0 * spl1 - ms_cxy) * ms_kc + rz_den;
ms_cxx += (spl0 * spl0 - ms_cxx) * ms_kc + rz_den;
ms_cyy += (spl1 * spl1 - ms_cyy) * ms_kc + rz_den;

@gfx 900 355
ui_begin(900, 355);
v5_begin();
RQF = 0x2E3336; RQW = 0x141617; RQI = 0xEDE6D3; RQA = 0xF0A63A; RQH = 0x1C1A19;
sc != rq_fsc ? (
  rq_fsc = sc;
