function rq_lcol(i, n) local(t) ( t = i / (n - 1); t < 0.3 ? 0x3A9CFF : t < 0.58 ? 0x3CE05A : t < 0.72 ? 0xFFC81E : t < 0.86 ? 0xFF8A1E : 0xFF3A2A; );
function rq_fall(v, pk) ( pk = pk > 0.0000001 ? 20 * log10(pk) : -90; pk > v ? pk : max(v - 0.6, -90); );
function rq_segs(x, y, h, lv, pk) local(n, sh, i, sy, c, on, pi) (
  n = 14; sh = h / n; pi = floor((pk + 40.5) / 3);
