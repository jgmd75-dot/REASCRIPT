function sp_kd(cx, cy, a, capr, at, sz) ( v5_d(cx + sin(a) * capr * at, cy - cos(a) * capr * at, max(capr * sz, 2)); );
function sp_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
