desc:Split Mod [modulation] (GFX Lab)
//tags: modulation phaser chorus flanger band split crossover two band stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider23:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1100<110,9900,1>-Split (Hz)
slider3:0<0,1,1{Phaser high,Chorus high}>-Order
slider4:70<0,100,1>-Phaser depth (%)
slider5:0.3<0.01,10,0.001>-Phaser rate (Hz)
slider6:0<0,1,1{Off,On}>-Phaser sync
slider7:0<0,1,1{Off,On}>-Phaser feedback
slider8:0<0,3,1{Sine,Square,Triangle,Random}>-Phaser LFO shape
slider9:0<0,2,1{4,8,12}>-Phaser stages
slider10:0<-100,100,1>-Phaser pan / trem (%)
slider11:50<0,100,1>-Chorus depth (%)
slider12:0.513<0.01,10,0.001>-Chorus rate (Hz)
slider13:0<0,1,1{Off,On}>-Chorus sync
slider14:0<0,3,1{I,II,I+II,Flanger}>-Chorus mode
slider15:0<0,1,1{Off,On}>-Chorus sat
slider16:0<0,1,1{Off,On}>-Chorus detune
slider17:100<0,200,1>-Chorus width (%)
slider18:0<0,1,1{Off,On}>-Flanger jet
slider19:20<0,100,1>-Sat (%)
slider20:100<0,200,1>-Width (%)
slider21:0<-18,18,0.1>-Output (dB)
slider22:50<0,100,1>-Drift (%)
slider24:prs_sel=0<0,8,1{No preset,HIPHA LOCHO,HICHO LOPHA,HIPHA LOFLA,HIFLA LOPHA,Silk Top,Jet Air,Pulse Low,Wide Keys}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

@init
function psw_all(v) ( slider_show(16777215, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(16777215, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-split-mod";
ext_noinit = 1;

function sp_tcf(ms, fs) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * fs)); );
function sp_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );
function sp_th(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function sp_sat(x) local(a) ( a = abs(x); a < 0.7 ? x : sign(x) * (0.7 + 0.3 * sp_th((a - 0.7) / 0.3)); );

DLN = 65536; DLM = 65535;
B_CHL = 1048576; B_CHR = B_CHL + DLN; B_FLL = B_CHR + DLN; B_FLR = B_FLL + DLN;
APS = 1400000;
SPT = 600000;

function sp_rd(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = sp_wp - d; rp < 0 ? rp += DLN;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i - 1) & DLM]; x0 = buf[i & DLM]; x1 = buf[(i + 1) & DLM]; x2 = buf[(i + 2) & DLM];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f + 0.5 * (x1 - xm1)) * f + x0);
);

function sp_xo(x) instance(s1, s2, s3, s4, s5, s6, s7, s8, lo, hi) local(v1, v2, v3, u) (
  v3 = x - s2; v1 = sp_a1 * s1 + sp_a2 * v3; v2 = s2 + sp_a2 * s1 + sp_a3 * v3; s1 = 2 * v1 - s1; s2 = 2 * v2 - s2; u = v2;
  v3 = u - s4; v1 = sp_a1 * s3 + sp_a2 * v3; v2 = s4 + sp_a2 * s3 + sp_a3 * v3; s3 = 2 * v1 - s3; s4 = 2 * v2 - s4; lo = v2;
  v3 = x - s6; v1 = sp_a1 * s5 + sp_a2 * v3; v2 = s6 + sp_a2 * s5 + sp_a3 * v3; s5 = 2 * v1 - s5; s6 = 2 * v2 - s6; u = x - 1.4142135623730951 * v1 - v2;
  v3 = u - s8; v1 = sp_a1 * s7 + sp_a2 * v3; v2 = s8 + sp_a2 * s7 + sp_a3 * v3; s7 = 2 * v1 - s7; s8 = 2 * v2 - s8; hi = u - 1.4142135623730951 * v1 - v2;
);
function sp_xz() instance(s1, s2, s3, s4, s5, s6, s7, s8, lo, hi) ( s1 = s2 = s3 = s4 = s5 = s6 = s7 = s8 = lo = hi = 0; );

function sp_bbd(x) instance(dx, dy) local(u, e) (
  u = (sp_th(2.5 * x + 0.12) - sp_t12) * sp_bbn;
  e = u - dx + sp_dc5 * dy; dx = u; dy = e; e;
);
function sp_bbz() instance(dx, dy) ( dx = dy = 0; );

function sp_apc(x, base, a) local(i, y) (
  i = 0;
  loop(12,
    y = a * x + base[i]; base[i] = x - a * y; x = y;
    i == 3 ? sp_t4 = x : i == 7 ? sp_t8 = x;
    i += 1;
  );
  sp_w4 * sp_t4 + sp_w8 * sp_t8 + sp_w12 * x;
);
function sp_pha(l, r) local(a, b) (
  a = sp_apc(l + sp_pfb * sp_pzl, APS, sp_pal); sp_pzl = sp_sat(a);
  b = sp_apc(r + sp_pfb * sp_pzr, APS + 12, sp_par); sp_pzr = sp_sat(b);
  a *= sp_pfc * sp_ptl; b *= sp_pfc * sp_ptr;
  sp_pol = (l + a) * 0.635; sp_por = (r + b) * 0.635;
);

function sp_cho(l, r) local(wl, wr, a, b, c, e, cen) (
  wl = l; wr = r;
  sp_csa > 0.0001 ? ( wl += sp_csa * (sbL.sp_bbd(l) - l); wr += sp_csa * (sbR.sp_bbd(r) - r); );
  B_CHL[sp_wp] = wl; B_CHR[sp_wp] = wr;
  sp_gfl < 0.9999 ? (
    a = sp_cga * sp_rd(B_CHL, sp_dAL) + sp_cgb * sp_rd(B_CHL, sp_dBL);
    b = sp_cga * sp_rd(B_CHR, sp_dAR) + sp_cgb * sp_rd(B_CHR, sp_dBR);
    sp_dtg > 0.0001 ? (
      a += sp_dtg * 0.55 * (sp_rd(B_CHL, sp_tL1) * sp_wL1 + sp_rd(B_CHL, sp_tL2) * sp_wL2);
      b += sp_dtg * 0.55 * (sp_rd(B_CHR, sp_tR1) * sp_wR1 + sp_rd(B_CHR, sp_tR2) * sp_wR2);
    );
    a = sp_th(a * 1.15) / 1.15; b = sp_th(b * 1.15) / 1.15;
    cen = (3.5 + sp_wob) * sp_spm;
    c = (sp_cga + sp_cgb) * 0.5 * (sp_rd(B_CHL, cen) - sp_rd(B_CHR, cen));
    e = (a - b) * 0.5; e = c + (e - c) * sp_cw; c = (a + b) * 0.5; a = c + e; b = c - e;
    sp_c1l += (a - sp_c1l) * sp_clk; sp_c2l += (sp_c1l - sp_c2l) * sp_clk; a = sp_c2l;
    sp_c1r += (b - sp_c1r) * sp_clk; sp_c2r += (sp_c1r - sp_c2r) * sp_clk; b = sp_c2r;
    sp_col = (l + a) * 0.635; sp_cor = (r + b) * 0.635;
  );
  sp_gfl > 0.0001 ? (
    B_FLL[sp_wp] = wl + sp_ffb * sp_fzl; B_FLR[sp_wp] = wr + sp_ffb * sp_fzr;
    a = sp_rd(B_FLL, sp_fdl); b = sp_rd(B_FLR, sp_fdr);
    sp_f1l += (a - sp_f1l) * sp_flk; sp_f1r += (b - sp_f1r) * sp_flk;
    sp_fzl = sp_sat(sp_f1l); sp_fzr = sp_sat(sp_f1r);
    sp_fol = (l + sp_f1l * sp_ffc) * 0.635; sp_for = (r + sp_f1r * sp_ffc) * 0.635;
  ) : ( B_FLL[sp_wp] = wl; B_FLR[sp_wp] = wr; sp_fzl = sp_fzr = sp_f1l = sp_f1r = 0; );
  sp_gfl >= 0.9999 ? ( sp_ool = sp_fol; sp_oor = sp_for; ) :
  sp_gfl <= 0.0001 ? ( sp_ool = sp_col; sp_oor = sp_cor; ) :
  ( sp_ool = sp_col + sp_gfl * (sp_fol - sp_col); sp_oor = sp_cor + sp_gfl * (sp_for - sp_cor); );
);

function sp_clear() (
  memset(B_CHL, 0, 4 * DLN); memset(APS, 0, 24);
  xoL.sp_xz(); xoR.sp_xz(); sbL.sp_bbz(); sbR.sp_bbz();
  osbL.ost_ch_init(); osbR.ost_ch_init();
  sp_c1l = sp_c2l = sp_c1r = sp_c2r = 0; sp_pzl = sp_pzr = 0; sp_fzl = sp_fzr = sp_f1l = sp_f1r = 0;
  sp_col = sp_cor = sp_fol = sp_for = 0;
);
function sp_reset() ( sp_clear(); memset(BY_BUF, 0, 2 * BY_N); sp_fi = -2; );

function sp_beats(k) ( k <= 0 ? 32 : k == 1 ? 16 : k == 2 ? 8 : k == 3 ? 4 : k == 4 ? 2 : k == 5 ? 1 : k == 6 ? 0.5 : k == 7 ? 0.25 : 0.125; );
function sp_div(hz) ( min(max(floor(log(min(max(hz, 0.01), 10) / 0.01) / log(1000) * 8 + 0.5), 0), 8); );

#sp_pm = "HIPHA LOCHO|HICHO LOPHA|HIPHA LOFLA|HIFLA LOPHA|Silk Top|Jet Air|Pulse Low|Wide Keys";
function sp_w10(a, b, c, d, e, f, g, h, i, j) (
  sp_wq[0] = a; sp_wq[1] = b; sp_wq[2] = c; sp_wq[3] = d; sp_wq[4] = e; sp_wq[5] = f; sp_wq[6] = g; sp_wq[7] = h; sp_wq[8] = i; sp_wq[9] = j; sp_wq += 10;
);
sp_wq = SPT;
sp_w10(1100, 0, 70, 0.3,   0, 0, 0, 0, 0,   50);  sp_w10(0.513, 0, 0, 0, 0, 100, 0, 20, 100, 0);
sp_w10(1100, 1, 70, 0.3,   0, 0, 0, 1, 0,   55);  sp_w10(0.62,  0, 2, 0, 1, 130, 0, 20, 100, 0);
sp_w10(660,  0, 75, 0.25,  0, 1, 2, 1, 0,   60);  sp_w10(0.15,  0, 3, 0, 0, 100, 0, 20, 100, 0);
sp_w10(2200, 1, 80, 0.12,  0, 0, 0, 0, 0,   70);  sp_w10(0.08,  0, 3, 0, 0, 100, 1, 20, 100, 0);
sp_w10(3300, 1, 50, 0.2,   0, 0, 0, 0, 0,   55);  sp_w10(0.6,   0, 2, 0, 1, 160, 0, 15, 110, 0);
sp_w10(4400, 1, 60, 0.1,   0, 0, 2, 1, 0,   85);  sp_w10(0.06,  0, 3, 0, 0, 100, 1, 25, 100, 0);
sp_w10(330,  1, 60, 1.778, 1, 0, 1, 0, 80,  45);  sp_w10(0.5,   0, 0, 0, 0, 100, 0, 25, 100, 0);
sp_w10(880,  0, 60, 0.4,   0, 0, 0, 1, -50, 50);  sp_w10(0.7,   0, 1, 1, 0, 180, 0, 20, 120, 0);
function load_preset(p) local(i, q) (
  q = SPT + (p >= 9 ? 0 : p - 1) * 20;
  i = 0; loop(20, slider(2 + i) = q[i]; i += 1; );
  p >= 9 ? slider22 = 50;
  i = 2; loop(21, ui_auto(i); i += 1; );
  pr_cur = p >= 9 ? 1 : p;
);

function sp_coef() (
  sp_fs = srate;
  sp_dc5 = 1 - 2 * $pi * 5 / sp_fs;
  sp_flk = sp_opk(12000, sp_fs);
  sp_spm = sp_fs / 1000;
);
function sp_srinit() (
  sp_sr = srate;
  c_kn = sp_tcf(30, srate);
  c_sw = sp_tcf(15, srate);
  c_dl = sp_tcf(60, srate);
  c_sh = sp_tcf(20, srate);
  sp_fis = 1 / (0.01 * srate);
  sp_dks = 1 / (0.006 * srate);
  ost_init(0);
  sp_coef(); sp_clear();
  sp_snap = 1;
);
sp_srinit();
pwr_init(); pwr_wu_loss = 0.3; pwr_wu_drv = 0.5; pwr_wu_lp = 12000; pwr_bloom = 0;
dRt.drift_init(0.8 + rand(1) * 0.4); dClk.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
sp_t12 = sp_th(0.12); sp_bbn = 1 / (2.5 * (1 - sp_t12 * sp_t12));
sp_dk = 1; sp_fi = 1;
sp_pp = 0; sp_cp = 0; sp_fp = 0; sp_dq = 0;
sp_ra = rand(2) - 1; sp_rb = rand(2) - 1; sp_rc = rand(2) - 1; sp_rd2 = rand(2) - 1;
pdc_delay = 0;
by_setup(1);

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(22, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != sp_sr ? sp_srinit();
sp_now = time_precise();
sp_tp > 0 && sp_now - sp_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > sp_gpp && play_position - sp_gpp < 4 * sp_gpd + 0.05) ? sp_reset();
sp_tp = sp_now; sp_gpp = play_position; sp_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
sp_satt = min(max(slider19, 0), 100) / 100;
sp_snap ? sp_satv = sp_satt : sp_satv += (sp_satt - sp_satv) * min(1, samplesblock / srate / 0.03);
ost_setup(sp_satv, 0.3, 120, 6000, -0.3, 1);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider22);
sp_n = samplesblock / srate;
sp_vr = dRt.drift_tick(0.05 * dm_s * sp_n); sp_vc = dClk.drift_tick(0.07 * dm_s * sp_n);
sp_rdf = 1 + 0.04 * dm_a * sp_vr; sp_wobt = 0.12 * dm_a * sp_vc;

sp_xft = log(min(max(slider2, 110), 9900));
sp_ordt = slider3 >= 0.5;
sp_pdpt = min(max(slider4, 0), 100) / 100;
sp_psy = slider6 >= 0.5;
sp_pbt = sp_beats(sp_div(slider5));
sp_prt = sp_psy ? log(max(tempo, 20) / 60 / sp_pbt) : log(min(max(slider5, 0.01), 10));
sp_pfbt = slider7 >= 0.5 ? 0.62 : 0;
sp_psh = min(max(slider8 | 0, 0), 3);
sp_hs0t = sp_psh == 0; sp_hs1t = sp_psh == 1; sp_hs2t = sp_psh == 2; sp_hs3t = sp_psh == 3;
sp_pst = slider9 >= 1.5 ? 2 : slider9 >= 0.5 ? 1 : 0;
sp_w4t = sp_pst == 0; sp_w8t = sp_pst == 1; sp_w12t = sp_pst == 2;
sp_ptt = min(max(slider10, -100), 100) / 100;
sp_cdpt = min(max(slider11, 0), 100) / 100;
sp_csy = slider13 >= 0.5;
sp_cbt = sp_beats(sp_div(slider12));
sp_cmd = min(max(slider14 | 0, 0), 3);
sp_crt = sp_csy ? log(max(tempo, 20) / 60 / sp_cbt) : log(min(max(slider12, 0.01), 10));
sp_cmrt = sp_cmd == 1 && !sp_csy ? 1.682 : 1;
sp_cgat = sp_cmd == 2 ? 0.6 : 1; sp_cgbt = sp_cmd == 2 ? 0.6 : 0;
sp_gflt = sp_cmd == 3;
sp_csat = slider15 >= 0.5;
sp_clkt = log(sp_csat ? 6600 : 8700);
sp_dtgt = slider16 >= 0.5 && sp_cmd != 3;
sp_cwt = min(max(slider17, 0), 200) / 100;
sp_ffbt = slider18 >= 0.5 ? 0.82 : 0.4;
sp_mwt = min(max(slider20, 0), 200) / 100;
sp_ogt = exp(min(max(slider21, -18), 18) * 0.11512925464970228);

sp_pk = 0; sp_ck = 0;
play_state & 1 ? (
  sp_psy ? ( sp_t = beat_position / sp_pbt; sp_t -= floor(sp_t); sp_e = sp_t - sp_pp; sp_e -= floor(sp_e + 0.5); sp_pk = sp_e * min(1, sp_n / 0.4) / max(samplesblock, 1); );
  sp_csy ? (
    sp_t = beat_position / sp_cbt; sp_t -= floor(sp_t);
    sp_e = sp_t - (sp_gflt ? sp_fp : sp_cp); sp_e -= floor(sp_e + 0.5); sp_ck = sp_e * min(1, sp_n / 0.4) / max(samplesblock, 1);
  );
);
sp_prd = sp_psy ? 1 : sp_rdf; sp_crd = sp_csy ? 1 : sp_rdf;

sp_snap ? (
  sp_xf = sp_xft; sp_ord = sp_ordt; sp_pdp = sp_pdpt; sp_pr = sp_prt; sp_pfb = sp_pfbt;
  sp_hs0 = sp_hs0t; sp_hs1 = sp_hs1t; sp_hs2 = sp_hs2t; sp_hs3 = sp_hs3t;
  sp_w4 = sp_w4t; sp_w8 = sp_w8t; sp_w12 = sp_w12t; sp_pt = sp_ptt;
  sp_cdp = sp_cdpt; sp_cr = sp_crt; sp_cmr = sp_cmrt; sp_cga = sp_cgat; sp_cgb = sp_cgbt; sp_gfl = sp_gflt;
  sp_csa = sp_csat; sp_clf = sp_clkt; sp_dtg = sp_dtgt; sp_cw = sp_cwt; sp_ffb = sp_ffbt; sp_mw = sp_mwt; sp_og = sp_ogt; sp_wob = sp_wobt;
  sp_pcl = log(sp_ord ? sqrt(exp(sp_xf) * 50) : sqrt(exp(sp_xf) * 16000));
);
sp_snap = 0;

sp_otl_d = max(sp_otl_d, sp_pol2); sp_otr_d = max(sp_otr_d, sp_por2); sp_pol2 = sp_por2 = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
sp_xl = spl0; sp_xr = spl1;

sp_xf += (sp_xft - sp_xf) * c_kn;
sp_pdp += (sp_pdpt - sp_pdp) * c_kn; sp_pr += (sp_prt - sp_pr) * c_kn; sp_pfb += (sp_pfbt - sp_pfb) * c_kn;
sp_hs0 += (sp_hs0t - sp_hs0) * c_sh; sp_hs1 += (sp_hs1t - sp_hs1) * c_sh; sp_hs2 += (sp_hs2t - sp_hs2) * c_sh; sp_hs3 += (sp_hs3t - sp_hs3) * c_sh;
sp_w4 += (sp_w4t - sp_w4) * c_kn; sp_w8 += (sp_w8t - sp_w8) * c_kn; sp_w12 += (sp_w12t - sp_w12) * c_kn;
sp_pt += (sp_ptt - sp_pt) * c_kn;
sp_cdp += (sp_cdpt - sp_cdp) * c_dl; sp_cr += (sp_crt - sp_cr) * c_kn; sp_cmr += (sp_cmrt - sp_cmr) * c_kn;
sp_cga += (sp_cgat - sp_cga) * c_kn; sp_cgb += (sp_cgbt - sp_cgb) * c_kn; sp_gfl += (sp_gflt - sp_gfl) * c_sw;
sp_csa += (sp_csat - sp_csa) * c_sw; sp_clf += (sp_clkt - sp_clf) * c_kn; sp_dtg += (sp_dtgt - sp_dtg) * c_sw;
sp_cw += (sp_cwt - sp_cw) * c_kn; sp_ffb += (sp_ffbt - sp_ffb) * c_kn;
sp_mw += (sp_mwt - sp_mw) * c_kn; sp_og += (sp_ogt - sp_og) * c_kn; sp_wob += (sp_wobt - sp_wob) * c_dl;

sp_ordt != sp_ord ? ( sp_dk = max(sp_dk - sp_dks, 0); sp_dk == 0 ? sp_ord = sp_ordt; ) : sp_dk = min(sp_dk + sp_dks, 1);
sp_pcl += ((sp_ord ? log(sqrt(exp(sp_xf) * 50)) : log(sqrt(exp(sp_xf) * 16000))) - sp_pcl) * (sp_dk < 1 ? 1 : c_kn);

sp_g = tan($pi * min(exp(sp_xf), 0.45 * srate) / srate);
sp_a1 = 1 / (1 + sp_g * (sp_g + 1.4142135623730951)); sp_a2 = sp_g * sp_a1; sp_a3 = sp_g * sp_a2;

sp_pp += exp(sp_pr) * sp_prd / srate + sp_pk;
sp_pp >= 1 ? ( sp_pp -= 1; sp_ra = sp_rb; sp_rb = rand(2) - 1; ) : sp_pp < 0 ? sp_pp += 1;
sp_q = sp_pp + 0.25; sp_q >= 1 ? sp_q -= 1;
sp_q < sp_dq ? ( sp_rc = sp_rd2; sp_rd2 = rand(2) - 1; ); sp_dq = sp_q;
sp_snl = sin(2 * $pi * sp_pp); sp_snr = sin(2 * $pi * sp_q);
sp_uL = sp_hs0 * sp_snl + sp_hs1 * sp_th(3 * sp_snl) + sp_hs2 * (4 * abs(sp_pp + 0.75 - floor(sp_pp + 0.75) - 0.5) - 1) + sp_hs3 * (sp_ra + (sp_rb - sp_ra) * (0.5 - 0.5 * cos($pi * sp_pp)));
sp_uR = sp_hs0 * sp_snr + sp_hs1 * sp_th(3 * sp_snr) + sp_hs2 * (4 * abs(sp_q + 0.75 - floor(sp_q + 0.75) - 0.5) - 1) + sp_hs3 * (sp_rc + (sp_rd2 - sp_rc) * (0.5 - 0.5 * cos($pi * sp_q)));
sp_fc = min(max(exp(sp_pcl) * 2 ^ (2 * sp_pdp * sp_uL), 20), 0.45 * srate); sp_t = tan($pi * sp_fc / srate); sp_pal = (sp_t - 1) / (sp_t + 1);
sp_fc = min(max(exp(sp_pcl) * 2 ^ (2 * sp_pdp * sp_uR), 20), 0.45 * srate); sp_t = tan($pi * sp_fc / srate); sp_par = (sp_t - 1) / (sp_t + 1);
