g_s = 0;
loop(16, g_x = 200 + g_s * 40 + floor(g_s / 4) * 6;
  mkey(g_x, 348, 36, 24, sprintf(#stp, "%d", g_s + 1), g_s == cur_pat || g_s == pending_pat, g_s == cur_pat ? ORG : YEL) ? pat_sel_d = g_s;
  g_s += 1; );
// the step bar: the original's four colour groups, a light on the playing step
g_sd = step_disp;
g_s = 0;
loop(16, g_x = 200 + g_s * 40 + floor(g_s / 4) * 6;
  ui_col(g_s < 4 ? 0xD8402A : g_s < 8 ? ORG : g_s < 12 ? YEL : CRMC);  gfx_rect(g_x * sc, 384 * sc, 36 * sc, 4 * sc);
  gfx_setfont(4);  ui_cola(INKC, g_s < LEN[cur_pat] ? 0.85 : 0.35);  ui_text((g_x + 12) * sc, 389 * sc, sprintf(#stp, "%d", g_s + 1));
  pk_led((g_x + 28) * sc, 396 * sc, 3.2 * sc, g_s == g_sd, dy_red);
  g_s += 1; );
// the grid: 11 tracks x 16 steps
g_t = 0;
loop(11,
  g_y = 410 + g_t * 18;
  gfx_setfont(5);
  g_hov = mouse_x >= 158 * sc && mouse_x < 198 * sc && mouse_y >= g_y * sc && mouse_y < (g_y + 16) * sc;
  ui_cola(INKC, g_hov ? 1 : 0.8);
  ui_text(178 * sc, (g_y + 1) * sc, g_t == 0 ? "BD" : g_t == 1 ? "SD" : g_t == 2 ? "LT" : g_t == 3 ? "MT" : g_t == 4 ? "HT" :
    g_t == 5 ? "RS" : g_t == 6 ? "CP" : g_t == 7 ? "CH" : g_t == 8 ? "OH" : g_t == 9 ? "CR" : "RD");
  g_hov && pressed && drag_id == 0 ? ( drag_id = -1;  aud_t_d = g_t;  aud_n_d += 1; );     // audition
  g_s = 0;
  loop(16,
    g_x = 200 + g_s * 40 + floor(g_s / 4) * 6;
    g_a = (cur_pat * 11 + g_t) * 16 + g_s;  g_v = SEQ[g_a];
    g_in = mouse_x >= g_x * sc && mouse_x < (g_x + 36) * sc && mouse_y >= g_y * sc && mouse_y < (g_y + 16) * sc;
    g_in && pressed && drag_id == 0 ? ( drag_id = -3;  paint_v = (g_v + 1) % 3;  SEQ[g_a] = paint_v;  g_v = paint_v; );
    g_in && drag_id == -3 && mdown && g_v != paint_v ? ( SEQ[g_a] = paint_v;  g_v = paint_v; );
    ui_col(0x0C0C0E);  gfx_rect(g_x * sc, g_y * sc, 36 * sc, 16 * sc);
    ui_col(g_v == 2 ? 0xE0301E : g_v == 1 ? 0xF2C840 : g_in ? 0x3A3A3E : 0x2A2A2D);
    gfx_rect((g_x + 1) * sc, (g_y + 1) * sc, 34 * sc, 14 * sc);
    g_v > 0 ? ( ui_cola(0xFFFFFF, 0.3);  gfx_rect((g_x + 3) * sc, (g_y + 2) * sc, 30 * sc, 2 * sc); );
    g_s == g_sd ? ( ui_cola(0xFFFFFF, 0.14);  gfx_rect(g_x * sc, g_y * sc, 36 * sc, 16 * sc); );
    g_s >= LEN[cur_pat] ? ( ui_cola(SECC, 0.7);  gfx_rect(g_x * sc, g_y * sc, 36 * sc, 16 * sc); );
    g_s += 1; );
  g_t += 1;
);

