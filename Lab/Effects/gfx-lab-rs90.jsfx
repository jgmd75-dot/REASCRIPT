  strcat(#em, "|>Load a demo pattern|Four to the floor|House|Techno|Electro|Breakbeat|Garage shuffle|Acid|Minimal|<Tom fill");
  gfx_x = 34 * sc;  gfx_y = 604 * sc;  g_k = gfx_showmenu(#em);
  g_k == 1 ? ( memset(SEQ + cur_pat * NV * 16, 0, NV * 16); );
  g_k >= 18 ? demo_pat(g_k - 17);
  g_k >= 2 && g_k <= 17 ? ( g_p = g_k - 2;  g_p != cur_pat ? ( memcpy(SEQ + g_p * NV * 16, SEQ + cur_pat * NV * 16, NV * 16);  LEN[g_p] = LEN[cur_pat]; ); );
);
vline(150, 344, 260);
// pattern keys (on the step columns): the playing one lit orange, a waiting one lit yellow
