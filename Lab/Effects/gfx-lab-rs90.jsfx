menu_box(54, 446, 56, 28, #ls) ? (
  strcpy(#lm, "");  g_j = 1;  loop(16, g_j == LEN[cur_pat] ? strcat(#lm, "!");  strcat(#lm, sprintf(#stp, "%d", g_j));  g_j < 16 ? strcat(#lm, "|");  g_j += 1; );
  gfx_x = 54 * sc;  gfx_y = 476 * sc;  g_k = gfx_showmenu(#lm);  g_k > 0 ? LEN[cur_pat] = g_k;
);
