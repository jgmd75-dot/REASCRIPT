desc:GFX Lab G Duo Lead [synth]
//tags: instrument synthesizer duophonic lead mono sync ring
//author: JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-clip, gfx-lab-os, gfx-lab-uimin, gfx-lab-bverb, gfx-lab-bdelay (.jsfx-inc) in the same folder.
//
// DUO LEAD - a duophonic lead synth in the spirit of the mid-70s two-voice synths: two oscillators that can play two
// different notes. Hold one key and both play it; hold two and the lower key goes to OSC 1, the higher to OSC 2 -
// lines in fifths, thirds or octaves from two fingers, or split a bass line and a melody. UNISON puts both on the last
// key (a mono lead). Built on DTW 90's engine and FX:
//   - MIDI read in @block into a timed queue, fired at its exact sample in @sample (and passed through)
//   - control rate every 16 samples (envelopes, glide, pitch, filter coefficients, drift, LFO), ramped per sample
//   - FX from the GFX units: the broadcast-delay engine (gfx-bdelay), the broadcast-reverb engine (gfx-bverb),
//     the house output stage (gfx-output: CLIP always on, ceiling -0.3 dBFS)
//
// SIGNAL FLOW
//   KEYS    DUO (lowest held key -> OSC 1, highest -> OSC 2; one key = both) or UNISON (both on the last key);
//           SINGLE (legato: a new key glides without restarting the envelopes) or MULTI (every new key restarts them);
//           GLIDE (portamento, 0 - 2 s), SPREAD (OSC 1 left, OSC 2 right), OCT (-2 .. +2 octaves).
//   OSC 1 / OSC 2: SAW, SQUARE or PULSE (band-limited), OSC 2 SEMI and DETUNE, SYNC (OSC 2 hard-synced to OSC 1,
//           band-limited resets), PW
//   MIXER   OSC 1, OSC 2, RING (OSC 1 x OSC 2), NOISE
//     -> HPF (6 dB) -> FILTER: 4-pole ladder (one per oscillator, same settings; LP 24 / LP 12 / BP / HP 24), CUTOFF,
//        RESO, ENV, KEY (follows the two notes' middle) -> AMP (ADSR)
//   LFO     SINE, TRIANGLE, SAW, SQUARE or S&H (smoothed), RATE in Hz or with SYNC a note value; DELAY fades it in
//           from each new phrase; depths VIBRATO, PWM and CUTOFF. The mod wheel adds vibrato (WHEEL).
//   DRIVE   (from FFAT, IN key): TUBE, FUZZ, RECT or CRUSH, anti-aliased and level-matched, DRIVE and MIX;
//           OS key (header): the drive alone runs at 1x / 2x / 4x (default 1x).
//   voices -> DRIVE -> CHORUS -> DELAY (stereo / ping-pong, sync; HPF and LPF in the repeats' loop)
//   -> SPACE (house reverb, fed by the delay; 500 Hz CUT on the reverb) -> EQ (low / high shelf) -> DC blocker
//   -> FFAT (one-knob squash) -> house output stage
//
// DRIFT (0 - 100 %, 50 % = standard): the two oscillators wander out of tune against each other (each +/-12 cents,
//   slowly, on its own), each new note lands a little off (+/-4 cents per oscillator), the cutoff drifts
//   (+/-0.3 oct, slowly) and every glide takes a slightly different time (+/-25 %). 0 % = none, 100 % = twice.
//
// GUI: S / M / L / ? size picker (the ? opens the credits and the manual link); drag knobs (Shift = fine), mouse wheel
//   (Shift = fine), double-click or Ctrl-click = default. Menus for the waves, filter mode, LFO shape and the keys.
// MIDI: two oscillators (duophonic), sustain pedal, pitch bend +/-2 st, mod wheel (vibrato), all-notes-off
//   (CC 120 / 123); notes are released when the transport stops. MIDI passes through.
// PRESETS: from the house preset bar (click the display for the list).
// Latency: 0 samples at 1x, 31 at 2x, 37 at 4x (reported).
//
// STATUS: v1.0 (Oct 2026).

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-uimin.jsfx-inc
import gfx-lab-bverb.jsfx-inc
import gfx-lab-bdelay.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider1:keymode=0<0,1,1{Duo,Unison}>-Keys
slider2:trig=1<0,1,1{Single,Multi}>-Trigger
slider3:glide=0.2<0,1,0.001>-Glide
slider4:spread=0.3<0,1,0.001>-Spread
slider5:o1wave=0<0,2,1{Saw,Square,Pulse}>-Osc 1 wave
slider6:o2wave=0<0,2,1{Saw,Square,Pulse}>-Osc 2 wave
slider7:o2semi=0<-24,24,1>-Osc 2 semitones
slider8:o2det=6<0,50,0.1>-Osc 2 detune (cents)
slider9:o2sync=0<0,1,1{Off,On}>-Osc 2 sync
slider10:pwid=0.3<0.05,0.5,0.001>-Pulse width
slider11:lv1=0.8<0,1,0.001>-Mixer osc 1
slider12:lv2=0.8<0,1,0.001>-Mixer osc 2
slider13:lvring=0<0,1,0.001>-Mixer ring
slider14:lvnoise=0<0,1,0.001>-Mixer noise
slider15:f1mode=0<0,3,1{LP 24,LP 12,BP,HP 24}>-Filter mode
slider16:cutoff=1800<20,20000,1:log>-Cutoff (Hz)
slider17:fres=0.3<0,1,0.001>-Resonance
slider18:fenvamt=0.45<-1,1,0.001>-Filter env amount
slider19:fkey=0.5<0,1,0.01>-Key tracking
slider20:hpf=20<20,2000,1:log>-HPF (Hz)
slider21:fe_a=2<0.5,5000,0.1:log>-Filter attack (ms)
slider22:fe_d=400<1,10000,1:log>-Filter decay (ms)
slider23:fe_s=30<0,100,0.1>-Filter sustain (%)
slider24:fe_r=300<1,10000,1:log>-Filter release (ms)
slider25:ae_a=3<0.5,5000,0.1:log>-Amp attack (ms)
slider26:ae_d=500<1,10000,1:log>-Amp decay (ms)
slider27:ae_s=80<0,100,0.1>-Amp sustain (%)
slider28:ae_r=250<1,10000,1:log>-Amp release (ms)
slider29:vsens=0.4<0,1,0.01>-Velocity
slider30:ch_mix=0<0,1,0.001>-Chorus mix
slider31:dl_sync=1<0,1,1{Free,Sync}>-Delay sync
slider32:dl_ms=375<10,2000,1:log>-Delay time (ms)
slider33:dl_div=8<0,13,1{1/1,1/2,1/2D,1/2T,1/4,1/4D,1/4T,1/8,1/8D,1/8T,1/16,1/16D,1/16T,1/32}>-Delay time (sync)
slider34:dl_fb=0.35<0,0.95,0.001>-Delay feedback
slider35:dl_mix=0.18<0,1,0.001>-Delay mix
slider36:dl_pp=1<0,1,1{Stereo,Ping-pong}>-Delay mode
slider37:dl_hpf=150<20,2000,1:log>-Delay HPF (Hz)
slider38:dl_lpf=4500<1000,20000,1:log>-Delay LPF (Hz)
slider39:sp_size=0.55<0,1,0.001>-Space size
slider40:sp_decay=2.2<0.2,12,0.01:log>-Space decay (s)
slider41:sp_damp=0.5<0,1,0.001>-Space damping
slider42:sp_mix=0.15<0,1,0.001>-Space mix
slider43:sp_cut=1<0,3,1{Off,-3 dB,-6 dB,-9 dB}>-Space 500 Hz cut
slider44:eq_lo=0<-12,12,0.1>-EQ low (dB)
slider45:eq_hi=0<-12,12,0.1>-EQ high (dB)
slider46:vol=0<-24,6,0.1>-Volume (dB)
slider47:drift=50<0,100,1>-Drift (%)
slider48:lfo_shape=0<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO shape
slider49:lfo_sync=0<0,1,1{Free,Sync}>-LFO sync
slider50:lfo_hz=5.5<0.02,20,0.001:log>-LFO rate (Hz)
slider51:lfo_div=11<0,13,1{4 bars,2 bars,1 bar,1/2,1/2 dotted,1/4,1/4 dotted,1/4 triplet,1/8,1/8 dotted,1/8 triplet,1/16,1/16 triplet,1/32}>-LFO note value
slider52:lfo_vib=0<0,100,0.1>-LFO to pitch (cents)
slider53:lfo_pwm=0<0,1,0.001>-LFO to pulse width
slider54:lfo_cut=0<0,3,0.01>-LFO to cutoff (oct)
slider55:lfo_dly=300<0,3000,1>-LFO delay (ms)
slider56:mw_vib=30<0,100,0.1>-Mod wheel to pitch (cents)
slider57:drv_on=0<0,1,1{Off,On}>-Drive
slider58:drv_type=0<0,3,1{Tube,Fuzz,Rect,Crush}>-Drive type
slider59:drv_amt=3<0,10,0.1>-Drive amount
slider60:drv_mix=100<0,100,0.1>-Drive mix (%)
slider61:ffat=0<0,10,0.1>-Ffat
slider62:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling (the drive)
slider63:octv=0<-2,2,1>-Octave

@init
#ui_man = "gfx-lab-g-duo-lead";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );   // first instance: M size, the Init preset (later loads restore their own)
ui_dflt = 1;
CR = 16;                          // control rate: every 16 samples

// ---------- memory map (2000 - 3200 belong to gfx-bverb's tables) ----------
KH = 900;  KHV = 920;  KHS = 940;  // held keys in the order played: note, velocity, held by the pedal
LDA = 960;  LDB = 970;              // the two ladders' states (4 each)
MQ = 4096;                        // MIDI queue: 4 slots per event (offset, status, data1, data2)
MQMAX = 1000;
FX_MEM = 1048576;                 // the reverb lines, then the delay lines, then the chorus lines
memset(KH, 0, 80);  memset(LDA, 0, 20);

// ---------- FX memory ----------
bv_alloc(FX_MEM);
bd_alloc(BV_END);
CH_N = ceil(0.03 * srate) + 4;  CH_L = BD_END;  CH_R = CH_L + CH_N;  memset(CH_L, 0, 2 * CH_N);
cho_w = 0;  cho_c = 1;  cho_s = 0;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();                 // house output stage (CLIP)
RVM = 1960;  k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );

// ---------- helpers ----------
function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );   // fast tanh (flat beyond 3)

// ---------- DRIVE (FFAT's): one channel; a, b: clip kit clippers, pf: the kit's drive-tracking pre-filter ----------
function ds_tick(x) instance(a, b, pf, cnt, held, xp, dcx, dcy) local(u, y, dry) (
  dry = 0.5 * (x + xp);  xp = x;                                 // the ADAA half-sample, matched on the dry side
  dt_a == 3 ? (
    cnt -= 1;                                                    // CRUSH: hold, then quantise
    cnt <= 0 ? ( cnt = cr_hold;  held = min(max(floor(x * cr_q + 0.5) / cr_q, -1), 1); );
    y = held;  dry = x;
  ) : (
    u = pf.clp_pf_run(x) * ds_g;
    dt_a == 0 ? ( y = (a.clp_run(u + ds_b) - ds_rest) * ds_c; ) :          // TUBE
    dt_a == 1 ? ( y = a.clp_run(u) * ds_c; ) :                             // FUZZ
                ( y = 0.5 * (a.clp_run(u) + b.clp_run(u)) * ds_c; );        // RECT
  );
  dcy = y - dcx + ds_dcc * dcy;  dcx = y;                        // DC blocker (the rectifier's DC, the tube's bias), 4 Hz
  dry + (dcy - dry) * dmx_s;
);
function ds_reset() instance(a, b, cnt, held, xp, dcx, dcy) (
  a.clp_reset();  b.clp_reset();  cnt = 0;  held = 0;  xp = 0;  dcx = 0;  dcy = 0;
);
// ---------- a 2-pole state-variable filter (TPT) as an instance: the SPACE 500 Hz cut ----------
function sv2_set(fc, k) instance(a1, a2, a3, kk) local(g) (
  g = tan($pi * min(max(fc, 10), srate * 0.45) / srate);
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  kk = k;
);
function sv2_run(x) instance(a1, a2, a3, kk, s0, s1, hp, bp) local(v1, v2, v3) (
  v3 = x - s1;  v1 = a1 * s0 + a2 * v3;  v2 = s1 + a2 * s0 + a3 * v3;
  s0 = 2 * v1 - s0;  s1 = 2 * v2 - s1;
  bp = v1;  hp = x - kk * v1 - v2;
  v2;
);
// the vintage wet EQ (Space's): HP 140 Hz > a 500 Hz dip (band-pass subtracted, depth glided) > LP 5 kHz
function vt_run(x) instance(h, m, l) local(y) (
  h.sv2_run(x);  y = h.hp;                                       // HP 140 Hz
  m.sv2_run(y);  y -= vt_c * m.kk * m.bp;                        // 500 Hz: the band (unity at its centre) taken out by vt_c
  l.sv2_run(y);                                                  // LP 5 kHz
);
function vt_set() (
  vtL.h.sv2_set(140, 1.41421356);  vtR.h.sv2_set(140, 1.41421356);
  vtL.m.sv2_set(500, 1 / 0.9);     vtR.m.sv2_set(500, 1 / 0.9);
  vtL.l.sv2_set(5000, 1.41421356); vtR.l.sv2_set(5000, 1.41421356);
);
dsL.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);  dsR.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);   // DRIVE (FFAT's)
dsL.pf.clp_pf_reset();  dsR.pf.clp_pf_reset();  dsL.ds_reset();  dsR.ds_reset();
// DRIVE: FFAT's curves and level match, worked out every 16 samples while DRIVE glides (no steps)
function drv_curves() (
  dn = dam_s / 10;  ds_st = min(1, dam_s / 3);
  dt_a == 0 ? (
    ds_g = 10 ^ (dam_s * 2.4 / 20);  ds_b = 0.08 + 0.12 * dn;
    dsL.a.clp_set(1, 1, 0.72, 0);  dsR.a.clp_set(1, 1, 0.72, 0);
    ds_rest = dsL.a.clp_crv(ds_b);
    ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(dsL.a.clp_crv(0.25 * ds_g + ds_b) - ds_rest, 0.0001);
  ) : dt_a == 1 ? (
    ds_g = 10 ^ (dam_s * 4 / 20);
    dsL.a.clp_set(0, 0.6, 0.6, 0.04 * dn);  dsR.a.clp_set(0, 0.6, 0.6, 0.04 * dn);
    ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(dsL.a.clp_crv(0.25 * ds_g), 0.0001);
  ) : dt_a == 2 ? (
    ds_g = 10 ^ (dam_s * 2 / 20);
    dsL.a.clp_set(3, 1, 1, 0);  dsR.a.clp_set(3, 1, 1, 0);
    dsL.b.clp_set(1, 1, 1, 0);  dsR.b.clp_set(1, 1, 1, 0);
    ds_c = 0.25 / max(0.5 * (dsL.a.clp_crv(0.25 * ds_g) + dsL.b.clp_crv(0.25 * ds_g)), 0.0001);
  ) : (
    cr_q = 2 ^ (15 - dam_s * 1.3);                                 // 16 bits .. 3 bits
    cr_hold = (1 + floor(sqr(dn) * 23)) * os_f;                    // the same hold time at every OS factor
  );
);
OSD = 3400;  memset(OSD, 0, 128);  osd_w = 0;                                       // OS: the plain delay (L / R, 64 each)
os_design();  os_base = 0;  os_f = os_tf = os_f2n(os_sel);  os_gsetup();
dr_gc = 1 - exp(-16 / (0.05 * srate));  dr_cn = 0;   // DRIVE glides 50 ms
dr_ec = 1 - exp(-1 / (0.4 * srate));  dr_mc = 1 - exp(-1 / (0.2 * srate));  dr_m = 1;  dr_ei = dr_eo = 0;   // DRIVE level match
ffc_att = 1 - exp(-1 / (0.003 * srate));  ffc_rel = 1 - exp(-1 / (0.09 * srate));          // FFAT
vt_set();                                                                                  // SPACE 500 Hz cut
// band-limited saw: rising 2p - 1 minus a polyBLEP at the wrap
function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);
function env_coef(ms) ( exp(-6.9 * CR / max(1, ms * 0.001 * srate)); );   // one tick of a ~ms fall to -60 dB
// ---------- FILTER: 4-pole ladder, zero-delay feedback (TPT one-poles), state s[0..3] (Flurry's) ----------
function lad(s, x) local(u, v, y1, y2, y3, y4) (
  y4 = (lG4 * x + lB * (lG3 * s[0] + lG2 * s[1] + lG * s[2] + s[3])) * linv;
  u = ts(x - kres * y4);
  v = (u - s[0]) * lG;   y1 = v + s[0];  s[0] = y1 + v;
  v = (y1 - s[1]) * lG;  y2 = v + s[1];  s[1] = y2 + v;
  v = (y2 - s[2]) * lG;  y3 = v + s[2];  s[2] = y3 + v;
  v = (y3 - s[3]) * lG;  y4 = v + s[3];  s[3] = y4 + v;
  lc0 * u + lc1 * y1 + lc2 * y2 + lc3 * y3 + lc4 * y4;          // the mode: a mix of the stage taps
);

function set_taps(m) (
  m < 0.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 0;  lc3 = 0;  lc4 = 1; ) :        // LP 24
  m < 1.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 1;  lc3 = 0;  lc4 = 0; ) :        // LP 12
  m < 2.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 4;  lc3 = -8; lc4 = 4; ) :        // BP
            ( lc0 = 1;  lc1 = -4; lc2 = 6;  lc3 = -4; lc4 = 1; );         // HP 24
);
// one oscillator sample at phase p (0..1), increment d: 0 saw, 1 square, 2 pulse (width pw_s)
function osc(w, p, d) local(q) (
  w < 0.5 ? saw_bl(p, d) :
  ( q = p + (w < 1.5 ? 0.5 : pw_s);  q >= 1 ? q -= 1;  saw_bl(p, d) - saw_bl(q, d); );
);
// the same wave without band-limiting (the SYNC reset works out its step from it)
function osc_nv(w, p) local(q) (
  w < 0.5 ? 2 * p - 1 : ( q = p + (w < 1.5 ? 0.5 : pw_s);  q -= floor(q);  2 * p - 2 * q; );
);

// ---------- KEYS: the held keys, in the order played (sustained ones flagged) ----------
function kh_find(n) local(i, f) ( f = -1;  i = 0;  loop(kh_n, KH[i] == n ? f = i;  i += 1; );  f; );
function kh_cut(f) local(i) (
  i = f;  loop(kh_n - f - 1, KH[i] = KH[i + 1];  KHV[i] = KHV[i + 1];  KHS[i] = KHS[i + 1];  i += 1; );  kh_n -= 1;
);
// the oscillators' notes from the held keys; new_vel > 0: a key has just gone down (with that velocity)
function assign(new_vel) local(i, lo, hi, last) (
  kh_n == 0 ? (
    gate ? ( gate = 0;  ast = 4;  fst = 4; );
  ) : (
    last = KH[kh_n - 1];  lo = 128;  hi = -1;
    i = 0;  loop(kh_n, lo = min(lo, KH[i]);  hi = max(hi, KH[i]);  i += 1; );
    keymode >= 0.5 ? ( t1 = last;  t2 = last; ) : ( t1 = lo;  t2 = hi; );
    new_vel > 0 ? (
      !gate && aen < 0.001 ? ( p1 = t1;  p2 = t2; );                // from silence: no swoop in
      !gate ? l_fade = 0;                                           // a new phrase: the LFO DELAY starts again
      !gate || trig >= 0.5 ? (
        ast = 1;  fst = 1;                                          // attack (levels carry on: no click)
        a_gain = 1 - vsens + vsens * new_vel / 127;
        f_vel = 1 - 0.5 * vsens + 0.5 * vsens * new_vel / 127;
      );
      nd1 = (rand(2) - 1) * 0.04 * dm_a;  nd2 = (rand(2) - 1) * 0.04 * dm_a;   // DRIFT: each note +/-4 cents
      gl_f = max(0.3, 1 + (rand(2) - 1) * 0.25 * dm_a);                         // DRIFT: each glide +/-25 %
    );
    gate = 1;
  );
  n1_disp = t1;  n2_disp = t2;  keys_disp = kh_n;
);
function key_on(n, v) local(f) (
  f = kh_find(n);  f >= 0 ? kh_cut(f);
  kh_n < 16 ? ( KH[kh_n] = n;  KHV[kh_n] = v;  KHS[kh_n] = 0;  kh_n += 1; );
  assign(v);
);
function key_off(n) local(f) (
  f = kh_find(n);
  f >= 0 ? ( sustain ? KHS[f] = 1 : ( kh_cut(f);  assign(0); ); );
);
function pedal_up() local(i) (
  i = kh_n - 1;  loop(kh_n, KHS[i] ? kh_cut(i);  i -= 1; );
  assign(0);
);
function all_off() ( kh_n = 0;  assign(0); );

function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? key_on(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? key_off(d1) :
  st == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :      // +/-2 semitones
  st == 0xB0 ? (
    d1 == 1 ? mw_t = d2 / 127 :                                    // mod wheel: vibrato
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? ( sustain = 0;  pedal_up(); );  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? all_off();
  );
);

// ---------- envelope tick (stage: 1 attack, 2 decay / sustain, 4 release, 0 done) ----------
function env_tick(lv, stg, a_inc, d_c, s_lv, r_c) (
  stg == 1 ? ( lv += a_inc;  lv >= 1 ? ( lv = 1;  stg = 2; ); ) :
  stg == 2 ? ( lv = s_lv + (lv - s_lv) * d_c; ) :
  stg == 4 ? ( lv *= r_c; );
  env_out_stg = stg;
  lv;
);

// ---------- control tick: envelopes, glide, drift, pitch, cutoff ----------
function c_tick() local(t, g, fc, s, vb) (
  aen = env_tick(aen, ast, a_ainc, a_dc, a_sl, a_rc);  ast = env_out_stg;
  fen = env_tick(fen, fst, f_ainc, f_dc, f_sl, f_rc);  fst = env_out_stg;
  // GLIDE: each oscillator slides to its note (time to ~95 %; DRIFT varies it per note)
  t = gl_ms * gl_f;
  t < 1 ? ( p1 = t1;  p2 = t2; ) : ( g = 1 - exp(-3 * CR / (t * 0.001 * srate));  p1 += (t1 - p1) * g;  p2 += (t2 - p2) * g; );
  // DRIFT: the oscillators wander on their own (against each other), the cutoff on its own
  dv1 = dr1.drift_tick(0.25 * dm_s * CR / srate) * 0.12 * dm_a;
  dv2 = dr2.drift_tick(0.25 * dm_s * CR / srate) * 0.12 * dm_a;
  dvc = drc.drift_tick(0.15 * dm_s * CR / srate) * 0.3 * dm_a;
  // LFO depths (DELAY fades them in from each new phrase; the mod wheel's vibrato isn't delayed)
  gate ? l_fade = min(1, l_fade + l_fstep);
  mw_s += (mw_t - mw_s) * fl_k;
  vb = lfo_v * (l_fade * lv_s + mw_s * mw_vib) * 0.01;            // vibrato in semitones
  s = bend + octv * 12 + vb;
  inc1 = min(440 * 2 ^ ((p1 - 69 + s + dv1 + nd1) / 12) / srate, 0.45);
  inc2 = min(440 * 2 ^ ((p2 - 69 + s + o2_st + dv2 + nd2) / 12) / srate, 0.45);
  pw_t = max(0.03, min(0.97, pwid + lfo_v * l_fade * lpw_s * 0.45));
  // cutoff in octaves: the knob + key tracking (the two notes' middle) + envelope (+/-6 oct) + drift + LFO
  fc = 2 ^ (lcs + fk_s * ((p1 + p2) * 0.5 + octv * 12 - 60) / 12 + fen * fl_ev * 6 * f_vel + dvc + lfo_v * l_fade * lc_s);
  t = max(20, min(fc, 0.45 * srate));  g = tan($pi * t / srate);  t = g / (1 + g);
  flt_gs = (t - flt_g) / CR;
  av_s = (aen * a_gain - av) / CR;
);

gate = 0;  kh_n = 0;  t1 = t2 = p1 = p2 = 60;  aen = fen = 0;  ast = fst = 0;  av = av_s = 0;  a_gain = f_vel = 1;
nd1 = nd2 = 0;  gl_f = 1;  l_fade = 0;  mw_t = mw_s = 0;  bend = 0;  sustain = 0;  cr_n = 0;
n1_disp = n2_disp = 60;  keys_disp = 0;
dr1.drift_init(0.8 + rand(1) * 0.4);  dr2.drift_init(0.8 + rand(1) * 0.4);  drc.drift_init(0.8 + rand(1) * 0.4);
o1p = o2p = 0;  ph1 = 0;  ph2 = 0.37;  inc1 = inc2 = 0.005;  flt_g = 0.1;  flt_gs = 0;
hp_a = hp_b = 0;  nz_s = 0;
sz_s = sp_size;  lfo_ph = 0;  lfo_v = 0;  lfo_raw = 0;  lfo_sh = 0;
pw_s = pwid;
lcs = fl_c1 = log(cutoff) / log(2);  kres = fres * 4.1;  fl_ev = fenvamt;

// ---------- per block: delay and space settings (Flurry's) ----------
function fx_block() local(k, sz, ms, t) (
  t = dl_sync >= 0.5 ? 60 / max(tempo, 20) * bd_beats(floor(dl_div + 0.5)) : dl_ms * 0.001;
  dl_t = min(t * srate, 3 * srate);
  dl_dc = 1 - exp(-2 * $pi * min(dl_lpf, 0.45 * srate) / srate);  // LPF: the repeats darken above it
  dl_hc = 1 - exp(-2 * $pi * dl_hpf / srate);                    // HPF: and thin out below it
  sl_c = 1 - exp(-1 / (0.15 * srate));                            // the head glides to a new time in ~150 ms
  sz_s += (sp_size - sz_s) * min(1, samplesblock / (0.25 * srate));  // SIZE glides (~250 ms): the lines stretch, never jump
  sz = 0.3 + 0.7 * sz_s;
  k = 0;
  loop(8,
    ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
    ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
    k += 1;
  );
  bv_t60 = sp_decay;  bv_rtlo = 1.25;  bv_rthi = 1 - 0.82 * sp_damp;
  k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
  bv_xover();
  sp_pre = (0.008 + 0.03 * sz_s) * srate;
  k = 0;
  loop(8,
    RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
    ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
    k += 1;
  );
  dl_mix > 0.0005 && !dl_live ? ( memset(BD_L, 0, 2 * DL_N);  dlL.init = 0;  dlR.init = 0;  dl_fl = dl_fr = dl_hl = dl_hr = 0; );
  sp_mix > 0.0005 && !sp_live ? bv_alloc(FX_MEM);
  dl_live = dl_mix > 0.0005 || dlm_s > 0.0005;  sp_live = sp_mix > 0.0005 || spm_s > 0.0005;   // (on until the mix has glided out)
);
// ---------- parameters -> engine values (audio thread: @slider, and @block after a faceplate edit) ----------
function update_params() local(t) (
  a_ainc = CR / max(1, ae_a * 0.001 * srate);  a_dc = env_coef(ae_d);  a_sl = ae_s / 100;  a_rc = env_coef(ae_r);
  f_ainc = CR / max(1, fe_a * 0.001 * srate);  f_dc = env_coef(fe_d);  f_sl = fe_s / 100;  f_rc = env_coef(fe_r);
  drift_macro(drift);                                              // dm_a: amount 0 - 2 (50 % = 1), dm_s: speed 0.5 - 1.5
  dc_r = 1 - 2 * $pi * 5 / srate;                                  // DC blockers: 5 Hz
  outg_t = 10 ^ (vol / 20) * 0.21;                                  // TWEAK: the overall level (checkpoint 2 level-matches)
  o2_st = o2semi + o2det * 0.01;
  gl_ms = 2000 * glide * glide;                                    // GLIDE: 0 - 2 s, finer at the short end
  l_fstep = CR / max(1, lfo_dly * 0.001 * srate);                  // LFO DELAY: the fade-in
  l1_t = lv1;  l2_t = lv2;  lr_t = lvring;  ln_t = lvnoise;  spr_t = spread;
  hp_t = 1 - exp(-2 * $pi * hpf / srate);
  // waves and filter mode can't glide: a change dips the voices for 5 ms, swaps at the bottom, comes back
  w1_t = floor(o1wave + 0.5);  w2_t = floor(o2wave + 0.5);  fm_t = floor(f1mode + 0.5);  sy_t = o2sync >= 0.5;
  smk = 1 - exp(-1 / (0.015 * srate));  lfo_sm = 1 - exp(-CR / (0.004 * srate));  dk_st = 1 / (0.005 * srate);
  chm_t = ch_mix;  dlm_t = dl_mix;  spm_t = sp_mix;
  // chorus: TWEAK rate 0.5 Hz, 6 ms +/- 2.5 ms
  t = 2 * $pi * 0.5 / srate;  cho_ca = cos(t);  cho_sa = sin(t);
  cho_base = 0.006 * srate;  cho_dep = 0.0025 * srate;
  eq_lc = 1 - exp(-2 * $pi * 200 / srate);  eq_hc = 1 - exp(-2 * $pi * 4500 / srate);
  eql_t = 10 ^ (eq_lo / 20) - 1;  eqh_t = 10 ^ (eq_hi / 20) - 1;
  // DRIVE, FFAT, the SPACE 500 Hz cut
  drv_t = drv_on >= 0.5;  dt_t = floor(drv_type + 0.5);  dam_t = drv_amt;  dmx_t = drv_mix * 0.01;
  ffat_t = ffat;
  t = floor(sp_cut + 0.5);  vt_t = t > 0;  t > 0 ? vtc_t = 1 - 10 ^ (-3 * t / 20);
);

update_params();
// the glided values start on their targets
l1_s = l1_t;  l2_s = l2_t;  lr_s = lr_t;  ln_s = ln_t;  spr_s = spr_t;  hp_c = hp_t;  out_g = outg_t;
chm_s = chm_t;  dlm_s = dlm_t;  spm_s = spm_t;
drv_s = drv_t;  dt_a = dt_t;  dam_s = dam_t;  dmx_s = dmx_t;  ffat_s = ffat_t;  vt_s = vt_t;  vt_c = vtc_t;  grs = 0;
eql_s = eql_t;  eqh_s = eqh_t;  fk_s = fkey;  lc_s = lfo_cut;  lv_s = lfo_vib;  lpw_s = lfo_pwm;
w1_l = w1_t;  w2_l = w2_t;  fm_l = fm_t;  sy_l = sy_t;  set_taps(fm_l);  dk = 1;  dk_req = 0;

@slider
update_params();

@block
// MIDI into the timed queue (fired at its exact sample in @sample)
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);                        // pass MIDI through
);
mq_i = 0;  spos = 0;
// release every note when the transport stops (playing / recording -> stopped or paused)
tp_now = play_state & 1;  tp_was && !tp_now ? all_off();
tp_was = tp_now;
prm_dirty ? ( prm_dirty = 0;  update_params(); );                  // a change from the faceplate
(w1_t != w1_l || w2_t != w2_l || fm_t != fm_l || sy_t != sy_l) ? dk_req = 1;
// LFO: a running phase (a RATE change never jumps); SYNC = a note value at the tempo, pulled gently onto the timeline
lfo_bpc = lfo_div < 0.5 ? 16 : lfo_div < 1.5 ? 8 : lfo_div < 2.5 ? 4 : lfo_div < 3.5 ? 2 : lfo_div < 4.5 ? 3 : lfo_div < 5.5 ? 1 :
          lfo_div < 6.5 ? 1.5 : lfo_div < 7.5 ? 2 / 3 : lfo_div < 8.5 ? 0.5 : lfo_div < 9.5 ? 0.75 : lfo_div < 10.5 ? 1 / 3 :
          lfo_div < 11.5 ? 0.25 : lfo_div < 12.5 ? 1 / 6 : 0.125;                // beats per cycle
lfo_rate = lfo_sync >= 0.5 ? max(tempo, 20) / 60 / lfo_bpc : lfo_hz;
lfo_sync >= 0.5 && tp_now ? (
  lfo_dd = beat_position / lfo_bpc;  lfo_dd -= floor(lfo_dd);  lfo_dd -= lfo_ph;  lfo_dd -= floor(lfo_dd + 0.5);
  lfo_ph += lfo_dd * 0.25;  lfo_ph -= floor(lfo_ph);
);
lfo_disp = lfo_ph;
fx_block();
// DRIVE: FFAT's curves and level match; a type change dips the voices and swaps at the bottom
dt_t != dt_a ? dk_req = 1;
ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
dsL.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);  dsR.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);
os_tf = os_f2n(os_sel);                                           // OS: the factor asked for (os_gate swaps it in)
dsL.a.clp_tidy();  dsR.a.clp_tidy();  dsL.b.clp_tidy();  dsR.b.clp_tidy();
drv_t && !drv_live ? ( dsL.ds_reset();  dsR.ds_reset();  dr_ei = dr_eo = 0;  dr_m = 1; );       // switched in: no stale state
drv_live = drv_t || drv_s > 0.0001;
ff_live = ffat_t > 0 || ffat_s > 0.0001;                          // FFAT: on until its glide reaches 0
fl_k = 1 - exp(-CR / (0.015 * srate));
f_in = 0.35 * (1 + 0.5 * kres);
f_out = 1 / 0.35;
ost_setup(0, 0.3, 120, 6000, -0.3, 1);                             // house output stage: CLIP, always on, -0.3 dBFS
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);         // (ost_setup clears it)
outpk_disp = max(outpk_disp, outpk);  outpk = 0;                   // OUT meter hand-off
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );
gate_disp = gate;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

// control tick
cr_n <= 0 ? (
  cr_n = CR;
  fl_c1 += (log(cutoff) / log(2) - fl_c1) * fl_k;  lcs += (fl_c1 - lcs) * fl_k;   // CUTOFF, RESO, ENV glide
  kres += (fres * 4.1 - kres) * fl_k;
  fl_ev += (fenvamt - fl_ev) * fl_k;
  fk_s += (fkey - fk_s) * fl_k;
  lc_s += (lfo_cut - lc_s) * fl_k;  lv_s += (lfo_vib - lv_s) * fl_k;  lpw_s += (lfo_pwm - lpw_s) * fl_k;
  // the LFO: shape, then a 4 ms smoothing (square and S&H steps never click)
  lfo_ph += lfo_rate * CR / srate;
  lfo_ph >= 1 ? ( lfo_ph -= floor(lfo_ph);  lfo_sh = rand(2) - 1; );
  lfo_raw = lfo_shape < 0.5 ? sin(2 * $pi * lfo_ph) : lfo_shape < 1.5 ? 1 - 4 * abs(lfo_ph - 0.5) :
            lfo_shape < 2.5 ? 1 - 2 * lfo_ph : lfo_shape < 3.5 ? ( lfo_ph < 0.5 ? 1 : -1 ) : lfo_sh;
  lfo_v += (lfo_raw - lfo_v) * lfo_sm;
  c_tick();
);
cr_n -= 1;
pw_s += (pw_t - pw_s) * 0.002;                                     // PW glides (~10 ms)
// levels glide (15 ms); a wave, SYNC or filter-mode change dips 5 ms, swaps, comes back
l1_s += (l1_t - l1_s) * smk;  l2_s += (l2_t - l2_s) * smk;  lr_s += (lr_t - lr_s) * smk;  ln_s += (ln_t - ln_s) * smk;
spr_s += (spr_t - spr_s) * smk;  hp_c += (hp_t - hp_c) * smk;  out_g += (outg_t - out_g) * smk;
chm_s += (chm_t - chm_s) * smk;  dlm_s += (dlm_t - dlm_s) * smk;  spm_s += (spm_t - spm_s) * smk;
eql_s += (eql_t - eql_s) * smk;  eqh_s += (eqh_t - eqh_s) * smk;
dk_req ? (
  dk -= dk_st;
  dk <= 0 ? ( dk = 0;  w1_l = w1_t;  w2_l = w2_t;  fm_l = fm_t;  sy_l = sy_t;  set_taps(fm_l);  dt_t != dt_a ? ( dt_a = dt_t;  dsL.ds_reset();  dsR.ds_reset(); );  dk_req = 0; );
) : dk < 1 ? dk = min(1, dk + dk_st);

// ---------- the oscillators (both one sample late: a SYNC reset corrects the sample before it, band-limited) ----------
ph2_o = ph2;
ph1 += inc1;  w1 = ph1 >= 1;  w1 ? ph1 -= 1;
ph2 += inc2;  ph2 >= 1 ? ph2 -= 1;
y1 = osc(w1_l, ph1, inc1);
sy_l && w1 ? (
  u_t = ph1 / inc1;                                                // how long ago OSC 1 wrapped (0 .. 1 sample)
  u_pe = ph2_o + (1 - u_t) * inc2;  u_pe -= floor(u_pe);           // where OSC 2 was when it was reset
  ph2 = u_t * inc2;
  u_h = osc_nv(w2_l, 0) - osc_nv(w2_l, u_pe);                      // the reset's step
  y2 = osc(w2_l, ph2, inc2);
  y2 -= (-2) * -sqr(1 - u_t) * 0.5;                                // (the saw's own wrap correction assumed a -2 step)
  y2 += u_h * -sqr(1 - u_t) * 0.5;                                 // polyBLEP: this sample ...
  o2p += u_h * sqr(u_t) * 0.5;                                     // ... and the one before
) : y2 = osc(w2_l, ph2, inc2);
u_o1 = o1p;  u_o2 = o2p;  o1p = y1;  o2p = y2;

// ---------- MIXER -> HPF -> FILTER (one ladder per oscillator) -> AMP ----------
nz_s = rand(2) - 1;
u_sh = (u_o1 * u_o2 * lr_s + nz_s * ln_s * 0.7) * 0.5;             // RING and NOISE go half to each side
u_a = u_o1 * l1_s + u_sh;  u_b = u_o2 * l2_s + u_sh;
hp_a += (u_a - hp_a) * hp_c;  u_a -= hp_a;  hp_b += (u_b - hp_b) * hp_c;  u_b -= hp_b;
flt_g += flt_gs;  lG = flt_g;  lB = 1 - lG;  lG2 = lG * lG;  lG3 = lG2 * lG;  lG4 = lG2 * lG2;  linv = 1 / (1 + kres * lG4);
u_a = lad(LDA, u_a * f_in) * f_out;  u_b = lad(LDB, u_b * f_in) * f_out;
av += av_s;
u_g = av * out_g * dk;
u_p = spr_s * 0.8;                                                 // SPREAD: OSC 1 left, OSC 2 right
yl = (u_a + u_b * (1 - u_p)) * u_g;  yr = (u_a * (1 - u_p) + u_b) * u_g;
dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;

// ---------- DRIVE (FFAT's): the IN key crossfades it in and out (15 ms) ----------
drv_s += (drv_t - drv_s) * smk;  dmx_s += (dmx_t - dmx_s) * smk;
// OS: a factor change dips everything 5 ms and swaps at the silent point (os_gate)
os_gate();
os_chg ? (
  osuL.os_clr();  osuR.os_clr();  osdL.os_clr();  osdR.os_clr();  dsL.ds_reset();  dsR.ds_reset();
  dsL.pf.clp_pf_reset();  dsR.pf.clp_pf_reset();
  dsL.pf.clp_pf_block(dn, srate * os_f, 1);  dsR.pf.clp_pf_block(dn, srate * os_f, 1);
  ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);  dr_cn = 0;
);
// the voices delayed by the OS latency (the drive's dry side, and everything while the drive is out)
OSD[osd_w] = yl;  OSD[64 + osd_w] = yr;
u_l = OSD[(osd_w - os_lat(os_f)) & 63];  u_r = OSD[64 + ((osd_w - os_lat(os_f)) & 63)];
osd_w = (osd_w + 1) & 63;
drv_live ? (
  dr_cn -= 1;
  dr_cn <= 0 ? ( dr_cn = 16;  dam_s += (dam_t - dam_s) * dr_gc;  drv_curves(); );
  os_f == 1 ? ( u_dl = dsL.ds_tick(yl);  u_dr = dsR.ds_tick(yr); ) : (
    osuL.os_up(yl);  osuR.os_up(yr);
    oa0 = dsL.ds_tick(osuL.s0);  ob0 = dsR.ds_tick(osuR.s0);
    oa1 = dsL.ds_tick(osuL.s1);  ob1 = dsR.ds_tick(osuR.s1);
    os_f > 2 ? (
      oa2 = dsL.ds_tick(osuL.s2);  ob2 = dsR.ds_tick(osuR.s2);
      oa3 = dsL.ds_tick(osuL.s3);  ob3 = dsR.ds_tick(osuR.s3);
    );
    u_dl = osdL.os_dn(oa0, oa1, oa2, oa3);  u_dr = osdR.os_dn(ob0, ob1, ob2, ob3);
  );
  yl = u_l;  yr = u_r;
  // level-matched on programme: the drive's output follows the voices' own level (RMS over ~0.4 s, glided)
  dr_ei += (yl * yl + yr * yr - dr_ei) * dr_ec;  dr_eo += (u_dl * u_dl + u_dr * u_dr - dr_eo) * dr_ec;
  dr_m += ((dr_eo > 0.00000001 ? min(max(sqrt(dr_ei / dr_eo), 0.25), 2) : 1) - dr_m) * dr_mc;
  yl += (u_dl * dr_m - yl) * drv_s;  yr += (u_dr * dr_m - yr) * drv_s;
) : ( drv_s = 0;  yl = u_l;  yr = u_r; );
yl *= os_g;  yr *= os_g;                                           // OS: the switch dip, before the FX (their tails ride through)

// ---------- CHORUS: two modulated taps in quadrature (left sin, right cos) ----------
(                                                                   // (always running: no stale buffer when MIX comes up)
  CH_L[cho_w] = yl;  CH_R[cho_w] = yr;
  c_t = cho_c * cho_ca - cho_s * cho_sa;  cho_s = cho_s * cho_ca + cho_c * cho_sa;  cho_c = c_t;
  c_p = cho_w - (cho_base + cho_dep * cho_s);  c_p < 0 ? c_p += CH_N;
  c_i = floor(c_p);  c_f = c_p - c_i;  c_j = c_i + 1;  c_j >= CH_N ? c_j = 0;
  c_l = CH_L[c_i] + (CH_L[c_j] - CH_L[c_i]) * c_f;
  c_p = cho_w - (cho_base + cho_dep * cho_c);  c_p < 0 ? c_p += CH_N;
  c_i = floor(c_p);  c_f = c_p - c_i;  c_j = c_i + 1;  c_j >= CH_N ? c_j = 0;
  c_r = CH_R[c_i] + (CH_R[c_j] - CH_R[c_i]) * c_f;
  yl = yl * (1 - 0.35 * chm_s) + c_l * 0.7 * chm_s;
  yr = yr * (1 - 0.35 * chm_s) + c_r * 0.7 * chm_s;
  cho_w += 1;  cho_w >= CH_N ? ( cho_w = 0;  c_t = 1 / sqrt(cho_c * cho_c + cho_s * cho_s);  cho_c *= c_t;  cho_s *= c_t; );
);

// ---------- DELAY (house engine) ----------
dl_live ? (
  u_dl = dlL.sl_run(BD_L, dl_t);  u_dr = dlR.sl_run(BD_R, dl_t);
  dl_hl += (u_dl - dl_hl) * dl_hc;  dl_hr += (u_dr - dl_hr) * dl_hc;
  dl_fl += (u_dl - dl_hl - dl_fl) * dl_dc;  dl_fr += (u_dr - dl_hr - dl_fr) * dl_dc;
  u_fl = ts(dl_fl * dl_fb * 1.25) * 0.8;  u_fr = ts(dl_fr * dl_fb * 1.25) * 0.8;
  dl_pp >= 0.5 ? bd_put((yl + yr) * 0.5 + u_fr + bv_dn, u_fl + bv_dn)
               : bd_put(yl + u_fl + bv_dn, yr + u_fr + bv_dn);
  yl += u_dl * dlm_s;  yr += u_dr * dlm_s;
);

// ---------- SPACE (house reverb; it hears the delay too) ----------
sp_live ? (
  bv_pre(yl, yr);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, sz_s);
  fdn_run(dif_l, dif_r);
  vt_s += (vt_t - vt_s) * smk;  vt_c += (vtc_t - vt_c) * smk;  // 500 Hz CUT: in / out and its depth glide
  u_wl = vtL.vt_run(fdn_l);  u_wr = vtR.vt_run(fdn_r);          // (always running with the reverb: never stale)
  u_wl = fdn_l + (u_wl - fdn_l) * vt_s;  u_wr = fdn_r + (u_wr - fdn_r) * vt_s;
  yl += u_wl * 0.55 * spm_s;  yr += u_wr * 0.55 * spm_s;
);

// ---------- EQ: low and high shelves ----------
eq_l1 += (yl - eq_l1) * eq_lc;  eq_h1 += (yl - eq_h1) * eq_hc;
eq_r1 += (yr - eq_r1) * eq_lc;  eq_g1 += (yr - eq_g1) * eq_hc;
yl += eq_l1 * eql_s + (yl - eq_h1) * eqh_s;
yr += eq_r1 * eql_s + (yr - eq_g1) * eqh_s;

dc_ol = yl - dc_qol + dc_r * dc_ol;  dc_qol = yl;  yl = dc_ol;
dc_or = yr - dc_qor + dc_r * dc_or;  dc_qor = yr;  yr = dc_or;
// ---------- FFAT (FFAT's squash: stereo-linked, soft 6 dB knee, auto make-up) ----------
ff_live ? (
  ffat_s += (ffat_t - ffat_s) * smk;                               // glided per sample: threshold, ratio and make-up rise together
  cn = ffat_s / 10;  ff_thr = -32 * cn;  ff_sl = 1 - 1 / (1 + 5 * cn);  ff_mk = -ff_thr * ff_sl * 0.5;
  u_cl = max(abs(yl), abs(yr));
  u_cdb = u_cl > 0.000001 ? 20 * log10(u_cl) : -120;
  u_ov = u_cdb - ff_thr;
  u_cg = u_ov <= -3 ? 0 : u_ov >= 3 ? u_ov * ff_sl : ff_sl * sqr(u_ov + 3) / 12;
  grs += (u_cg - grs) * (u_cg > grs ? ffc_att : ffc_rel);
  u_cg = 10 ^ ((ff_mk - grs) / 20);
  yl *= u_cg;  yr *= u_cg;
) : ( grs = 0;  ffat_s = 0; );
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;
@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);

@gfx 1200 876
// =====================================================================
// GUI - DUO LEAD faceplate (JG): honey, with recessed trays, a dark brown header and a honey-gold rule, amber LCDs,
// steel-blue and ember caps (pastel cap centres per section, as DTW 90). House parts: knobs, faders, lamp keys, LCDs, preset bar, S / M / L / ?.
// =====================================================================
function set_pal() (
  C_CAPW = 0xF4F0EA;  LK_YEL = 0xF2C230;  LK_AMB = 0xF2A41E;  LK_ORG = 0xF28A2E;  LK_RED = 0xE8503A;  lk_well = 0x141518;
  C_PANEL = 0xD8A646;  C_SEC1 = 0xC99436;  C_SEC2 = 0xC48F32;  C_SEC3 = 0xCD993C;  C_EDGE = 0x8A6420;
  C_INK = 0x2A1A06;  C_INK2 = 0x4A3310;  C_TITLE = 0x2A1A06;  C_DIM = 0x9A7432;  C_RIV = 0x9C7428;
  C_HEAD = 0x2B1C0C;  C_HTXT = 0xFFF1D6;  C_HSUB = 0xF4C064;  C_RULE = 0xF4B030;
  C_LCDBG = 0x140D06;  C_LCDTX = 0xFFB347;  C_TEAL = 0x2E5E8C;  C_EMB = 0xD9542B;  C_SILV = 0xD8D2C4;
);

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_l(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function rivet(x, y) (
  col(C_RIV, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.7); gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
// a section: its shade, a narrow darker bottom / right edge, a light top line, the title
function section(x, y, w, h, c, title) local(i) (
  // a recessed tray (JG): a darker lip round it, the tray, an inner shadow on the top and left (light from the top
  // left, drawn as an L: each pixel once), a light inner edge on the bottom and right
  col(shade(C_PANEL, 0.72), 1);  u_rect(x - 2, y - 2, w + 4, 2);  u_rect(x - 2, y, 2, h + 2);
  col(0xFFFFFF, 0.35);  u_rect(x - 2, y + h, w + 4, 2);  u_rect(x + w, y - 2, 2, h + 2);
  col(c, 1);  u_rect(x, y, w, h);
  i = 0;
  loop(5,
    col(0x000000, 0.16 - i * 0.03);  u_rect(x + i, y + i, w - i, 1);  u_rect(x + i, y + i + 1, 1, h - i - 1);
    i += 1;
  );
  col(0xFFFFFF, 0.28);  u_rect(x + 1, y + h - 1, w - 1, 1);  u_rect(x + w - 1, y + 1, 1, h - 2);
  gfx_setfont(4);  col(C_TITLE, 1);  text_l(px(x + 16), py(y + 26), title);
);
// sliders past 32 are automated by name
function sl_auto(idx) (
  idx == 33 ? slider_automate(dl_div) : idx == 34 ? slider_automate(dl_fb) : idx == 35 ? slider_automate(dl_mix) :
  idx == 36 ? slider_automate(dl_pp) : idx == 37 ? slider_automate(dl_hpf) : idx == 38 ? slider_automate(dl_lpf) :
  idx == 39 ? slider_automate(sp_size) : idx == 40 ? slider_automate(sp_decay) : idx == 41 ? slider_automate(sp_damp) :
  idx == 42 ? slider_automate(sp_mix) : idx == 43 ? slider_automate(sp_cut) : idx == 44 ? slider_automate(eq_lo) :
  idx == 45 ? slider_automate(eq_hi) : idx == 46 ? slider_automate(vol) : idx == 47 ? slider_automate(drift) :
  idx == 48 ? slider_automate(lfo_shape) : idx == 49 ? slider_automate(lfo_sync) : idx == 50 ? slider_automate(lfo_hz) :
  idx == 51 ? slider_automate(lfo_div) : idx == 52 ? slider_automate(lfo_vib) : idx == 53 ? slider_automate(lfo_pwm) :
  idx == 54 ? slider_automate(lfo_cut) : idx == 55 ? slider_automate(lfo_dly) : idx == 56 ? slider_automate(mw_vib) :
  idx == 57 ? slider_automate(drv_on) : idx == 58 ? slider_automate(drv_type) : idx == 59 ? slider_automate(drv_amt) :
  idx == 60 ? slider_automate(drv_mix) : idx == 61 ? slider_automate(ffat) : idx == 62 ? slider_automate(os_sel) :
  idx == 63 ? slider_automate(octv);
);
function param_touched(idx) (
  idx <= 32 ? slider_automate(2 ^ (idx - 1)) : sl_auto(idx);
  gui_dirty = 1;
);
// pointer as a filled quad, with anti-aliased edges: clean at any angle
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
// value text for the hover tag
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v * 100 + 0.5) :
  fmt == 2 ? ( v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
  fmt == 3 ? ( v < 10 ? sprintf(#kv, "%.1f ms", v) : v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 4 ? sprintf(#kv, "%d %%", v) :
  fmt == 7 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 12 ? sprintf(#kv, "%+d %%", v * 100) :
  fmt == 14 ? sprintf(#kv, "%+d st", v) :
  fmt == 15 ? sprintf(#kv, "%.1f c", v) :
  fmt == 16 ? strcpy(#kv, bd_divname(floor(v + 0.5))) :
  fmt == 17 ? sprintf(#kv, "%.1f s", v) :
  fmt == 21 ? ( v = floor(v + 0.5);  v == 0 ? strcpy(#kv, "root") : sprintf(#kv, "%+d", v); ) :
  fmt == 22 ? ( v = 2000 * v * v;  v < 1 ? strcpy(#kv, "off") : v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 23 ? ( v = floor(v + 0.5);  v == 0 ? strcpy(#kv, "0") : sprintf(#kv, "%+d oct", v); ) :
  fmt == 24 ? sprintf(#kv, "%d c", v) :
  fmt == 9 ? sprintf(#kv, "+/-%.2f oct", v) :
  fmt == 10 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 19 ? sprintf(#kv, "+/-%.1f c", v) :
  fmt == 20 ? ( v = floor(v + 0.5);  strcpy(#kv, v == 0 ? "4 bars" : v == 1 ? "2 bars" : v == 2 ? "1 bar" : v == 3 ? "1/2" : v == 4 ? "1/2 dotted" :
    v == 5 ? "1/4" : v == 6 ? "1/4 dotted" : v == 7 ? "1/4 triplet" : v == 8 ? "1/8" : v == 9 ? "1/8 dotted" : v == 10 ? "1/8 triplet" :
    v == 11 ? "1/16" : v == 12 ? "1/16 triplet" : "1/32"); ) :
              sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
// soft drop shadow, down and to the right: 4 layers at 13 % black
function dshadow(x, y, r) local(i) (
  i = 0;
  loop(4, col(0x000000, 0.13);  gfx_circle(x + ps(2 + i * 1.33), y + ps(3 + i * 1.67), r + ps(i * 0.6), 1, 1);  i += 1; );
);

// a dotted arc from angle a0 to a1 at radius r (small anti-aliased dots: smooth at any size)
function dot_arc(x, y, r, a0, a1, w) local(n, i, a) (
  n = max(2, ceil(abs(a1 - a0) * r / max(w * 0.6, 0.5)));  i = 0;
  loop(n + 1, a = a0 + (a1 - a0) * i / n;  gfx_circle(x + sin(a) * r, y - cos(a) * r, w * 0.5, 1, 1);  i += 1; );
);
// the knob itself, in style ui_knb (0 here: silver cap, as DTW 90): 0 silver ring + coloured cap, 1 desk knob, 2 satin white, 3 black
function knob_face(x, y, rr, tv, t, cap, pcol, big) local(k) (
  k = floor(ui_knb + 0.5);
  k == 1 ? (
    col(0x7E848A, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x5E646A, 1);  gfx_circle(x, y, rr, 0, 1);       // grey skirt
    col(0xE6E3DC, 1);  gfx_circle(x, y, rr * 0.78, 1, 1);                                               // light body
    col(0xFFFFFF, 0.5);  gfx_arc(x, y, rr * 0.74, -1.6, -0.3, 1);
    col(cap, 1);  gfx_circle(x, y, rr * 0.5, 1, 1);  col(shade(cap, 0.75), 1);  gfx_circle(x, y, rr * 0.5, 0, 1);
    col(0x1A1A1A, 1);  pointer(x, y, sin(tv), cos(tv), 0, rr * 0.98, ps(big ? 1.7 : 1.3));             // full length
  ) : k == 2 ? (
    col(C_INK2, 0.35);  dot_arc(x, y, rr + ps(3), -0.75 * $pi, 0.75 * $pi, ps(1.6));                    // thin track
    col(cap, 1);  dot_arc(x, y, rr + ps(3), -0.75 * $pi, tv, ps(2.6));                                  // value arc
    col(0xBDB8B0, 1);  gfx_circle(x, y, rr, 1, 1);
    col(0xF7F5F1, 1);  gfx_circle(x, y, rr * 0.9, 1, 1);                                                 // satin white cap
    col(0x000000, 0.06);  gfx_circle(x + ps(1), y + ps(1.5), rr * 0.9, 0, 1);
    col(0xFFFFFF, 0.9);  gfx_arc(x, y, rr * 0.82, -1.7, -0.2, 1);                                        // one soft highlight
    col(0x2A2A2A, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.3, rr * 0.86, ps(big ? 1.6 : 1.2));
  ) : k == 3 ? (
    col(cap, 1);  dot_arc(x, y, rr + ps(3.5), -0.75 * $pi, tv, ps(2.4));                                // value arc
    col(0x101113, 1);  gfx_circle(x, y, rr, 1, 1);
    col(0x3A3C40, 1);  gfx_circle(x, y, rr, 0, 1);                                                       // knurled edge
    col(0x26282C, 1);  gfx_circle(x, y, rr * 0.8, 1, 1);
    col(0xFFFFFF, 0.12);  gfx_arc(x, y, rr * 0.76, -1.7, -0.2, 1);
    col(0xF2F2F2, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.25, rr * 0.92, ps(big ? 1.6 : 1.2));
  ) : big ? (
    col(0xA39A90, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x7D746A, 1);  gfx_circle(x, y, rr, 0, 1);
    col(C_SILV, 1);    gfx_circle(x, y, rr * 0.84, 1, 1);
    col(cap, 1);       gfx_circle(x, y, rr * 0.62, 1, 1);
    col(0xFFFFFF, 0.35);  gfx_arc(x, y, rr * 0.58, -1.7, -0.2, 1);
    col(shade(cap, 0.7), 1);  gfx_circle(x, y, rr * 0.62, 0, 1);
    col(pcol, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.08, rr * 0.97, ps(1.9));
  ) : (
    col(0x8E857B, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x6A6259, 1);  gfx_circle(x, y, rr, 0, 1);
    col(0xD6D0C8, 1);  gfx_circle(x, y, rr * 0.76, 1, 1);
    col(cap, 1);       gfx_circle(x, y, rr * 0.6, 1, 1);
    col(0xFFFFFF, 0.3);  gfx_arc(x, y, rr * 0.55, -1.7, -0.2, 1);
    col(shade(cap, 0.7), 1);  gfx_circle(x, y, rr * 0.6, 0, 1);
    col(pcol, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.97, ps(1.3));
  );
);

// Knob. big = 1: chunky silver knob with a coloured cap; 0: small desk knob. klog = 1 before a call: log taper;
// kstep > 0: stepped. kdim = 1: shown dimmed. kzero = 1: a "0" at the top (centre). Double-click / Ctrl-click = default.
function kn(cx, cy, r, idx, vmin, vmax, def, cap, pcol, lbl, fmt, big)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lgt, st, dm, zr)
(
  lgt = klog;  klog = 0;  st = kstep;  kstep = 0;  dm = kdim;  kdim = 0;  zr = kzero;  kzero = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 200)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st :
    lgt ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 1000 + 0.5) / 1000;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  col(C_INK2, 0.8);  j = 0;
  ui_knb < 1.5 ? loop(11, b = a0 + j / 10 * (a1 - a0);
    !(zr && j == 5) ? gfx_circle(x + sin(b) * (rr + ps(6)), y - cos(b) * (rr + ps(6)), ps(big ? 1.4 : 1.1), 1, 1);  j += 1; );
  zr ? ( gfx_setfont(5);  col(C_INK2, 1);  text_c(x, y - rr - ps(8), "0"); );
  dshadow(x, y, rr);
  knob_face(x, y, rr, tv, t, cap, pcol, big);
  dm ? ( col(C_SEC2, 0.55);  gfx_circle(x, y, rr + ps(1), 1, 1); );
  gfx_setfont(6);  col(dm ? C_DIM : C_INK, 1);  text_c(x, y + rr + ps(19), lbl);      // label 19 below the rim
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(16), fmtv(v, fmt));
);

// Vertical fader: drag anywhere in its column; double-click / Ctrl-click = default; value on hover.
function fader(x, y0, h, idx, vmin, vmax, def, lgt, lbl, fmt) local(t, v, cy, hov, now, j, cx)
(
  cx = px(x);
  v = slider(idx);  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  hov = abs(mouse_x - cx) < ps(12) && mouse_y >= py(y0 - 10) && mouse_y <= py(y0 + h + 10);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? h * 5 : h)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    lgt ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = slider(idx);  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  cy = y0 + h * (1 - t);
  col(shade(C_PANEL, 0.4), 1);  u_rect(x - 3, y0, 6, h);  col(0x1A1612, 1);  u_rect(x - 1, y0 + 2, 2, h - 4);
  col(C_INK2, 0.7);  j = 0;  loop(5, u_rect(x - 10, y0 + j * h / 4, 4, 1);  j += 1; );
  j = 0;  loop(4, col(0x000000, 0.13);  u_rect(x - 10 + 2 + j * 1.33, cy - 8 + 3 + j * 1.67, 20, 16);  j += 1; );
  col(C_SILV, 1);  u_rect(x - 10, cy - 8, 20, 16);
  col(0xFFFFFF, 0.6);  u_rect(x - 10, cy - 8, 20, 1.5);
  col(shade(C_SILV, 0.75), 1);  u_rect(x - 10, cy + 6.5, 20, 1.5);  u_rect(x + 8.5, cy - 8, 1.5, 16);
  col(fcap, 1);  u_rect(x - 10, cy - 1, 20, 2);
  gfx_setfont(6);  col(C_INK, 1);  text_c(cx, py(y0 + h + 14), lbl);
  hov || drag_idx == idx ? hover_tag(cx, py(y0 - 14), fmtv(v, fmt));
);

// ---------- house lamp keys: a coloured lens in a dark well (lit = feathered glow) ----------
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, col(0x000000, 0.13);  lk_rr(x - 4 * k + 2 + i * 1.33, y - 4 * k + 3 + i * 1.67, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
// ---------- LCD: dark glass, amber text with a faint glow ----------
function lcd_box(x, y, w, h) (
  col(shade(C_PANEL, 0.75), 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x050302, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  col(0xFFFFFF, 0.06);  u_rect(x + 4, y + 4, w - 8, 1);
);
function lcd_text(x, y, fnt, str) local(tw, th, gy) (
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y) - th * 0.5;
  col(C_LCDTX, 0.22);
  gfx_x = px(x) - 1;  gfx_y = gy;  gfx_drawstr(str);
  gfx_x = px(x) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x);  gfx_y = gy;  gfx_drawstr(str);
);
function lcd(x, y, w, h, fnt, str) ( lcd_box(x, y, w, h);  lcd_text(x + 10, y + h * 0.5, fnt, str); );

// ---------- house preset bar: [PRESETS][<][>][LCD] ----------
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xE2DCD2, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(C_INK, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

// a lamp key that opens a menu of a list slider's values; shows the current one
function lk_menu(x, y, w, h, idx, list, n, c) local(t, sel, i) (
  t = floor(slider(idx) + 0.5);
  lk_key(x, y, w, h, 1, c, pb_item(list, t + 1, #lm)) ? (
    strcpy(#lmm, "");  i = 0;
    loop(n, i == t ? strcat(#lmm, "!");  strcat(#lmm, pb_item(list, i + 1, #lmt));  i < n - 1 ? strcat(#lmm, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h + 4);  sel = gfx_showmenu(#lmm);
    sel > 0 ? ( slider(idx) = sel - 1;  param_touched(idx); );
  );
);

// one cycle of a wave for the oscillator display (naive shapes: it's a picture)
function g_wave(w, p) local(q) (
  w < 0.5 ? 2 * p - 1 :
  w < 1.5 ? ( p < 0.5 ? 1 : -1 ) :
  ( q = p - floor(p);  (2 * q - 1) - (2 * (q + pwid - floor(q + pwid)) - 1) );
);

WAVE_LIST = "SAW|SQUARE|PULSE";
NOTE_LIST = "C|C#|D|Eb|E|F|F#|G|Ab|A|Bb|B";
function note_name(n, dst) ( sprintf(dst, "%s%d", pb_item(NOTE_LIST, n % 12 + 1, #nnt), floor(n / 12) - 1); );

// ---------- presets (GUI thread only) ----------
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 0); pv(2, 1); pv(3, 0.2); pv(4, 0.3); pv(5, 0); pv(6, 0); pv(7, 0); pv(8, 6); pv(9, 0); pv(10, 0.3);
  pv(11, 0.8); pv(12, 0.8); pv(13, 0); pv(14, 0); pv(15, 0); pv(16, 1800); pv(17, 0.3); pv(18, 0.45); pv(19, 0.5); pv(20, 20);
  pv(21, 2); pv(22, 400); pv(23, 30); pv(24, 300); pv(25, 3); pv(26, 500); pv(27, 80); pv(28, 250); pv(29, 0.4);
  pv(30, 0); pv(31, 1); pv(32, 375); pv(33, 8); pv(34, 0.35); pv(35, 0.18); pv(36, 1); pv(37, 150); pv(38, 4500);
  pv(39, 0.55); pv(40, 2.2); pv(41, 0.5); pv(42, 0.15); pv(43, 1); pv(44, 0); pv(45, 0); pv(46, 0); pv(47, 50);
  pv(48, 0); pv(49, 0); pv(50, 5.5); pv(51, 11); pv(52, 0); pv(53, 0); pv(54, 0); pv(55, 300); pv(56, 30);
  pv(57, 0); pv(58, 0); pv(59, 3); pv(60, 100); pv(61, 0); pv(63, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (                                                                                   // Sync Lead
    pv(46, -1.8); pv(1, 1); pv(2, 0); pv(3, 0.25); pv(9, 1); pv(7, 9); pv(8, 0); pv(11, 0.5); pv(12, 1); pv(16, 3200); pv(17, 0.2); pv(18, 0.3);
    pv(52, 18); pv(55, 500); pv(57, 1); pv(58, 0); pv(59, 3); pv(60, 30); pv(61, 2); pv(35, 0.22); ) :
  p == 3 ? (                                                                                   // Ring Bells
    pv(46, -0.2); pv(5, 1); pv(6, 1); pv(7, 7); pv(8, 0); pv(11, 0.3); pv(12, 0.2); pv(13, 0.9); pv(16, 5000); pv(17, 0.1); pv(18, 0.2);
    pv(25, 1); pv(26, 900); pv(27, 0); pv(28, 1200); pv(3, 0); pv(42, 0.25); pv(40, 3); ) :
  p == 4 ? (                                                                                   // Square Duo
    pv(46, -2.2); pv(5, 1); pv(6, 1); pv(8, 4); pv(16, 1400); pv(17, 0.35); pv(18, 0.5); pv(4, 0.7); pv(3, 0.12);
    pv(22, 300); pv(23, 20); pv(35, 0.25); pv(57, 1); pv(59, 2); pv(60, 25); ) :
  p == 5 ? (                                                                                   // Pulse Vibrato
    pv(46, -1.9); pv(1, 1); pv(5, 2); pv(6, 2); pv(8, 9); pv(10, 0.22); pv(52, 22); pv(53, 0.35); pv(50, 5.2); pv(55, 450);
    pv(16, 2400); pv(17, 0.25); pv(18, 0.35); pv(30, 0.3); pv(3, 0.18); ) :
  p == 6 ? (                                                                                   // Fat Unison
    pv(46, -1.4); pv(1, 1); pv(8, 16); pv(4, 0.6); pv(16, 900); pv(17, 0.45); pv(18, 0.6); pv(22, 600); pv(23, 40); pv(63, -1);
    pv(57, 1); pv(58, 0); pv(59, 5); pv(60, 40); pv(61, 3); pv(3, 0.3); ) :
  p == 7 ? (                                                                                   // Thirds Lead
    pv(46, 1.8); pv(3, 0.22); pv(8, 3); pv(4, 0.5); pv(16, 2600); pv(17, 0.25); pv(18, 0.35); pv(22, 700); pv(23, 45);
    pv(52, 14); pv(55, 600); pv(30, 0.35); pv(35, 0.2); pv(42, 0.18); ) :
  p == 8 ? (                                                                                   // Bass + Melody
    pv(46, -2.1); pv(5, 1); pv(6, 0); pv(8, 0); pv(4, 0.2); pv(3, 0.08); pv(16, 1500); pv(17, 0.3); pv(18, 0.45);
    pv(19, 0.8); pv(22, 350); pv(23, 25); pv(27, 85); pv(28, 180); pv(35, 0.12); pv(42, 0.1); pv(44, 2); ) :
  p == 9 ? (                                                                                   // Soft Flute
    pv(46, -4.3); pv(1, 1); pv(5, 1); pv(6, 1); pv(7, 12); pv(8, 2); pv(11, 0.9); pv(12, 0.25); pv(14, 0.08); pv(15, 1);
    pv(16, 1100); pv(17, 0.05); pv(18, 0.15); pv(19, 0.9); pv(25, 70); pv(27, 90); pv(28, 350); pv(3, 0.1);
    pv(52, 16); pv(50, 4.8); pv(55, 700); pv(30, 0.25); pv(42, 0.25); pv(40, 2.8); pv(35, 0.12); ) :
  p == 10 ? (                                                                                  // Brass Duo
    pv(46, 0.7); pv(8, 7); pv(16, 700); pv(17, 0.15); pv(18, 0.7); pv(21, 60); pv(22, 500); pv(23, 55); pv(24, 250);
    pv(25, 25); pv(27, 85); pv(28, 220); pv(29, 0.6); pv(3, 0.06); pv(4, 0.55); pv(30, 0.2); pv(42, 0.2); ) :
  p == 11 ? (                                                                                  // Acid Line
    pv(46, 3.5); pv(1, 1); pv(2, 0); pv(3, 0.14); pv(12, 0); pv(16, 350); pv(17, 0.82); pv(18, 0.75); pv(22, 220); pv(23, 0);
    pv(24, 120); pv(26, 300); pv(27, 70); pv(28, 90); pv(29, 0.7); pv(63, -1); pv(57, 1); pv(58, 0); pv(59, 4);
    pv(60, 60); pv(33, 8); pv(35, 0.2); pv(34, 0.4); pv(42, 0.06); ) :
  p == 12 ? (                                                                                  // Whistle
    pv(46, -6.2); pv(1, 1); pv(5, 1); pv(6, 1); pv(8, 1.5); pv(15, 1); pv(16, 900); pv(17, 0.1); pv(18, 0); pv(19, 1);
    pv(63, 1); pv(3, 0.2); pv(25, 30); pv(28, 400); pv(52, 20); pv(50, 6); pv(55, 350); pv(42, 0.3); pv(40, 3.5);
    pv(35, 0.15); ) :
  p == 13 ? (                                                                                  // Fifth Stack
    pv(46, 1.7); pv(1, 1); pv(7, 7); pv(8, 2); pv(4, 0.45); pv(16, 2000); pv(17, 0.3); pv(18, 0.4); pv(3, 0.15);
    pv(22, 600); pv(23, 40); pv(30, 0.3); pv(35, 0.2); pv(52, 10); pv(55, 500); ) :
  p == 14 ? (                                                                                  // Screamer
    pv(46, 0.8); pv(1, 1); pv(2, 0); pv(9, 1); pv(7, 19); pv(8, 0); pv(11, 0.3); pv(12, 1); pv(16, 4500); pv(17, 0.35);
    pv(18, 0.25); pv(21, 2); pv(22, 900); pv(23, 50); pv(3, 0.3); pv(52, 25); pv(55, 400); pv(57, 1); pv(58, 1);
    pv(59, 5); pv(60, 70); pv(45, -2); pv(35, 0.25); pv(42, 0.2); ) :
  p == 15 ? (                                                                                  // Breath Pulse
    pv(46, -2.2); pv(1, 1); pv(5, 2); pv(6, 2); pv(8, 5); pv(10, 0.15); pv(14, 0.3); pv(16, 1300); pv(17, 0.2); pv(18, 0.3);
    pv(21, 80); pv(25, 90); pv(27, 85); pv(28, 450); pv(53, 0.2); pv(50, 0.6); pv(55, 0); pv(30, 0.4);
    pv(42, 0.3); pv(40, 3.2); pv(3, 0.12); ) :
  p == 16 ? (                                                                                  // Slow Swell
    pv(46, 1.3); pv(8, 12); pv(4, 0.8); pv(16, 900); pv(17, 0.2); pv(18, 0.45); pv(21, 900); pv(22, 2500); pv(23, 60);
    pv(24, 1500); pv(25, 600); pv(27, 100); pv(28, 1800); pv(3, 0.25); pv(30, 0.6); pv(35, 0.25); pv(33, 5);
    pv(34, 0.5); pv(42, 0.4); pv(39, 0.8); pv(40, 5); ) :
  p == 17 ? (                                                                                  // Nasal Reed
    pv(46, -2.3); pv(5, 2); pv(6, 2); pv(10, 0.12); pv(8, 4); pv(15, 2); pv(16, 1400); pv(17, 0.45); pv(18, 0.2);
    pv(20, 180); pv(3, 0.1); pv(52, 12); pv(55, 500); pv(30, 0.2); pv(42, 0.15); ) :
  p == 18 ? (                                                                                  // Chip Duo
    pv(46, -5.0); pv(5, 1); pv(6, 2); pv(10, 0.25); pv(8, 0); pv(16, 12000); pv(17, 0); pv(18, 0); pv(3, 0); pv(47, 15);
    pv(25, 0.5); pv(26, 250); pv(27, 70); pv(28, 60); pv(57, 1); pv(58, 3); pv(59, 4); pv(60, 50);
    pv(33, 9); pv(35, 0.2); pv(34, 0.3); pv(42, 0.08); ) : 0;
  i = 1;  loop(63, i != 62 ? param_touched(i);  i += 1; );   // (OS is not part of a preset)
);
PRESET_MENU = "Init|Sync Lead|Ring Bells|Square Duo|Pulse Vibrato|Fat Unison|Thirds Lead|Bass + Melody|Soft Flute|Brass Duo|Acid Line|Whistle|Fifth Stack|Screamer|Breath Pulse|Slow Swell|Nasal Reed|Chip Duo";
// ---------- frame setup ----------
set_pal();
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;                          // S / M / L
sc = g_ret * max(min(g_want, min(gfx_w / (1200 * g_ret), gfx_h / (876 * g_ret))), 0.5);
ox = (gfx_w - 1200 * sc) * 0.5;
oy = (gfx_h - 876 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
klog = 0;  kstep = 0;  kdim = 0;  kzero = 0;  fcap = C_TEAL;

gfx_setfont(1, "Century Gothic", ps(30), 'b');
gfx_setfont(10, "Century Gothic", ps(11), 'b');
gfx_setfont(2, "Century Gothic", ps(14), 'b');
gfx_setfont(3, "Verdana", ps(13), 'b');
gfx_setfont(4, "Century Gothic", ps(15), 'b');
gfx_setfont(5, "Verdana", ps(11), 'b');
gfx_setfont(6, "Century Gothic", ps(13), 'b');
gfx_setfont(7, "Courier New", ps(15), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');
gfx_setfont(9, "Courier New", ps(24), 'b');

out_m = max(outpk_disp, out_m * 0.85);  outpk_disp = 0;
// a thin inked line splitting a plate into parts
function divider(x, y0, y1) ( col(C_EDGE, 0.8);  u_rect(x, y0, 1, y1 - y0);  col(0xFFFFFF, 0.25);  u_rect(x + 1, y0, 1, y1 - y0); );
function sub_title(x, y, str) ( gfx_setfont(6);  col(C_TITLE, 1);  text_l(px(x), py(y), str); );

// ---------- faceplate ----------
col(C_PANEL, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(C_HEAD, 1);  u_rect(0, 0, 1200, 58);
col(0x000000, 1);  u_rect(0, 58, 1200, 3);  col(C_RULE, 1);  u_rect(0, 61, 1200, 1);
col(shade(C_PANEL, 0.78), 1);  u_rect(0, 873, 1200, 3);  u_rect(1197, 62, 3, 814);
rivet(8, 8);  rivet(1192, 8);  rivet(8, 868);  rivet(1192, 868);
gfx_setfont(1);  col(C_HTXT, 1);  text_l(px(24), py(24), "DUO LEAD");
gfx_setfont(10);  col(C_HSUB, 1);  text_l(px(26), py(47), "DUOPHONIC LEAD SYNTHESISER");
gfx_setfont(4);  col(C_HSUB, 1);  text_l(px(970), py(29), "GFX");

pb_k = preset_bar(410, 12, 34, 320, pr_cur, PRESET_MENU);
pb_k > 0 ? ( load_preset(pb_k);  pr_cur = pb_k > pb_count(PRESET_MENU) ? 1 : pb_k; );

// ---------- layout (design units, 1200 x 876), DTW 90's 8-pt system ----------
// Rows: 224 (OSCILLATORS | FILTER | KEYS), 196 (LFO | ENVELOPES), the effects plate, then MIXER | DRIVE | FFAT | MASTER.

// ---------- OSCILLATORS ----------
section(16, 76, 436, 224, C_SEC2, "OSCILLATORS");
C_CAPW = 0xCFEBD9;   // pastel mint centres (a shade per section, as DTW 90)
gfx_setfont(6);  col(C_INK2, 1);  text_c(px(166), py(102), "1");  text_c(px(268), py(102), "2");
lk_menu(176, 90, 76, 24, 5, WAVE_LIST, 3, LK_ORG);
lk_menu(278, 90, 76, 24, 6, WAVE_LIST, 3, LK_ORG);
lk_key(366, 90, 70, 24, o2sync >= 0.5, LK_RED, "SYNC") ? ( slider(9) = o2sync >= 0.5 ? 0 : 1;  param_touched(9); );
lcd_box(32, 128, 404, 60);
g_ym = 172;
col(C_LCDTX, 0.15);  u_rect(44, g_ym, 380, 1);
g_r = 2 ^ ((o2semi + o2det * 0.01) / 12);  g_a1 = lv1;  g_a2 = lv2;
g_mx = 0.001;  g_j = 0;  g_n = 160;
loop(2,
  g_j = 0;
  loop(g_n + 1,
    g_p = g_j / g_n * 2;
    g_q = o2sync >= 0.5 ? (g_p - floor(g_p)) * g_r : g_p * g_r;
    g_v = g_a1 * g_wave(o1wave, g_p - floor(g_p)) + g_a2 * g_wave(o2wave, g_q - floor(g_q));
    g_pass == 0 ? g_mx = max(g_mx, abs(g_v)) : (
      g_xx = px(44 + g_j / g_n * 380);  g_yy = py(g_ym - g_v / g_mx * 11);
      g_j > 0 ? gfx_line(g_xp, g_yp, g_xx, g_yy, 1);
      g_xp = g_xx;  g_yp = g_yy;
    );
    g_j += 1;
  );
  g_pass = !g_pass;  col(C_LCDTX, 1);
);
g_pass = 0;
pb_item(WAVE_LIST, o1wave + 1, #w1);  pb_item(WAVE_LIST, o2wave + 1, #w2);
sprintf(#ow, "%s + %s  %+d ST%s", #w1, #w2, o2semi, o2sync >= 0.5 ? "  SYNC" : "");
lcd_text(44, 147, 7, #ow);
kstep = 1;  kzero = 1;  kn(96, 242, 18, 7, -24, 24, 0, C_CAPW, 0x262B45, "SEMI", 14, 0);
kn(234, 242, 18, 8, 0, 50, 6, C_CAPW, 0x262B45, "DETUNE", 15, 0);
kdim = o1wave < 1.5 && o2wave < 1.5;  kn(372, 242, 18, 10, 0.05, 0.5, 0.3, C_CAPW, 0x262B45, "PW", 1, 0);

// ---------- FILTER ----------
section(468, 76, 408, 224, C_SEC1, "FILTER");
C_CAPW = 0xF7D7C2;   // pastel peach
lk_menu(768, 90, 92, 24, 15, "LP 24|LP 12|BP|HP 24", 4, LK_ORG);
// the response (the ladder's taps over its feedback loop, with the HPF; the knobs only: no envelope or key)
lcd_box(484, 128, 376, 60);
col(C_LCDTX, 0.15);  u_rect(496, 150, 352, 1);
g_m = floor(f1mode + 0.5);
g_c0 = g_m == 3 ? 1 : 0;  g_c1 = g_m == 3 ? -4 : 0;  g_c2 = g_m == 1 ? 1 : g_m == 2 ? 4 : g_m == 3 ? 6 : 0;
g_c3 = g_m == 2 ? -8 : g_m == 3 ? -4 : 0;  g_c4 = g_m == 0 || g_m >= 2 ? (g_m == 2 ? 4 : 1) : 0;
g_k = fres * 4.1;  col(C_LCDTX, 1);  g_j = 0;
loop(89,
  g_f = 20 * 1000 ^ (g_j / 88);  g_w = g_f / cutoff;                // (1 + s), s = j f / fc
  g_r1 = 1;  g_i1 = g_w;
  g_r2 = 1 - g_w * g_w;  g_i2 = 2 * g_w;                           // (1 + s)^2
  g_r3 = g_r2 - g_i2 * g_w;  g_i3 = g_i2 + g_r2 * g_w;             // ^3
  g_r4 = g_r3 - g_i3 * g_w;  g_i4 = g_i3 + g_r3 * g_w;             // ^4
  g_nr = g_c0 * g_r4 + g_c1 * g_r3 + g_c2 * g_r2 + g_c3 * g_r1 + g_c4;
  g_ni = g_c0 * g_i4 + g_c1 * g_i3 + g_c2 * g_i2 + g_c3 * g_i1;
  g_v = sqrt((g_nr * g_nr + g_ni * g_ni) / (sqr(g_r4 + g_k) + g_i4 * g_i4)) * (1 + 0.5 * g_k * (g_m == 0 || g_m == 1));
  g_v *= g_f / sqrt(g_f * g_f + hpf * hpf);                        // the HPF (6 dB)
  g_db = max(-36, min(18, 20 * log10(max(g_v, 0.00001))));
  g_xx = px(496 + g_j / 88 * 352);  g_yy = py(150 - g_db * 30 / 54 * (g_db > 0 ? 0.8 : 1));
  g_j > 0 ? gfx_line(g_xp, g_yp, g_xx, g_yy, 1);
  g_xp = g_xx;  g_yp = g_yy;  g_j += 1;
);
klog = 1;  kn(520, 241, 17, 20, 20, 2000, 20, 0xF2D04A, 0x262B45, "HPF", 2, 0);       // HPF yellow (house)
klog = 1;  kn(600, 230, 28, 16, 20, 20000, 1800, C_EMB, 0xFFFFFF, "CUTOFF", 2, 1);
kn(690, 236, 22, 17, 0, 1, 0.3, C_EMB, 0xFFFFFF, "RESO", 1, 1);
kzero = 1;  kn(770, 241, 17, 18, -1, 1, 0.45, C_CAPW, 0x262B45, "ENV", 12, 0);
kn(836, 241, 17, 19, 0, 1, 0.5, C_CAPW, 0x262B45, "KEY", 1, 0);

// ---------- KEYS ----------
section(892, 76, 292, 224, C_SEC3, "KEYS");
C_CAPW = 0xF4EBB8;   // pastel lemon
lk_menu(972, 90, 96, 24, 1, "DUO|UNISON", 2, LK_YEL);
lk_menu(1078, 90, 90, 24, 2, "SINGLE|MULTI", 2, LK_YEL);
lcd_box(908, 128, 260, 60);
// the notes the two oscillators play
keys_disp > 0 ? ( note_name(n1_disp, #n1);  note_name(n2_disp, #n2); ) : ( strcpy(#n1, "--");  strcpy(#n2, "--"); );
keymode >= 0.5 ? (
  lcd_text(920, 147, 7, "OSC 1 + 2");  lcd_text(920, 172, 8, #n1);
) : (
  lcd_text(920, 147, 7, "OSC 1");  lcd_text(1040, 147, 7, "OSC 2");
  lcd_text(920, 172, 8, #n1);  lcd_text(1040, 172, 8, #n2);
);
kn(950, 242, 18, 3, 0, 1, 0.2, C_TEAL, 0xFFFFFF, "GLIDE", 22, 0);
kn(1038, 242, 18, 4, 0, 1, 0.3, C_CAPW, 0x262B45, "SPREAD", 1, 0);
kstep = 1;  kzero = 1;  kn(1126, 242, 18, 63, -2, 2, 0, C_CAPW, 0x262B45, "OCT", 23, 0);

// ---------- LFO ----------
section(16, 316, 576, 196, C_SEC3, "LFO");
C_CAPW = 0xCDB6F2;   // pastel lilac
g_t = lfo_shape < 0.5 ? 0.5 + 0.5 * sin(2 * $pi * lfo_disp) : 1 - abs(2 * lfo_disp - 1);
col(0x000000, 0.4);  gfx_circle(px(70), py(342), ps(5.5), 1, 1);
col(LK_AMB, 0.2 + 0.8 * g_t);  gfx_circle(px(70), py(342), ps(4.5), 1, 1);
col(LK_AMB, 0.25 * g_t);  gfx_circle(px(70), py(342), ps(8), 1, 1);
lk_menu(140, 330, 84, 24, 48, "SINE|TRI|SAW|SQUARE|S&H", 5, LK_YEL);
lk_key(236, 330, 64, 24, lfo_sync >= 0.5, LK_YEL, "SYNC") ? ( slider(49) = lfo_sync >= 0.5 ? 0 : 1;  param_touched(49); );
lfo_sync >= 0.5 ? ( kstep = 1;  kn(72, 426, 22, 51, 0, 13, 11, C_TEAL, 0xFFFFFF, "RATE", 20, 1); )
                : ( klog = 1;  kn(72, 426, 22, 50, 0.02, 20, 5.5, C_TEAL, 0xFFFFFF, "RATE", 10, 1); );
kn(160, 431, 17, 55, 0, 3000, 300, C_CAPW, 0x262B45, "DELAY", 3, 0);
kn(238, 431, 17, 52, 0, 100, 0, C_CAPW, 0x262B45, "VIBRATO", 24, 0);
kn(316, 431, 17, 53, 0, 1, 0, C_CAPW, 0x262B45, "PWM", 1, 0);
kn(394, 431, 17, 54, 0, 3, 0, C_CAPW, 0x262B45, "CUTOFF", 9, 0);
divider(448, 364, 498);
sub_title(468, 342, "MOD WHEEL");
kn(520, 431, 17, 56, 0, 100, 30, C_CAPW, 0x262B45, "VIBRATO", 24, 0);

// ---------- ENVELOPES ----------
section(608, 316, 576, 196, C_SEC2, "ENVELOPES");
gfx_setfont(6);  col(C_INK2, 1);  text_c(px(784), py(336), "AMP");  text_c(px(1064), py(336), "FILTER");
divider(924, 364, 498);
fcap = C_TEAL;
fader(700, 372, 96, 25, 0.5, 5000, 3, 1, "A", 3);
fader(756, 372, 96, 26, 1, 10000, 500, 1, "D", 3);
fader(812, 372, 96, 27, 0, 100, 80, 0, "S", 4);
fader(868, 372, 96, 28, 1, 10000, 250, 1, "R", 3);
fcap = C_EMB;
fader(980, 372, 96, 21, 0.5, 5000, 2, 1, "A", 3);
fader(1036, 372, 96, 22, 1, 10000, 400, 1, "D", 3);
fader(1092, 372, 96, 23, 0, 100, 30, 0, "S", 4);
fader(1148, 372, 96, 24, 1, 10000, 300, 1, "R", 3);
fcap = C_TEAL;

// ---------- EFFECTS: one plate, no title, three parts: CHORUS | DELAY | SPACE with its 500 Hz CUT (as DTW 90) ----------
section(16, 528, 1168, 136, C_SEC1, "");
C_CAPW = 0xC9E6EE;   // pastel aqua
divider(196, 540, 652);  divider(656, 540, 652);
sub_title(32, 554, "CHORUS");
kn(106, 606, 20, 30, 0, 1, 0, C_TEAL, 0xFFFFFF, "MIX", 1, 1);
sub_title(212, 554, "DELAY");
lk_key(518, 542, 58, 24, dl_sync >= 0.5, LK_YEL, "SYNC") ? ( slider(31) = dl_sync >= 0.5 ? 0 : 1;  param_touched(31); );
lk_key(584, 542, 58, 24, dl_pp >= 0.5, LK_YEL, "PING") ? ( slider(36) = dl_pp >= 0.5 ? 0 : 1;  param_touched(36); );
dl_sync >= 0.5 ? ( kstep = 1;  kn(256, 610, 16, 33, 0, 13, 8, 0xC4EBBE, 0x262B45, "TIME", 16, 0); )
               : ( klog = 1;  kn(256, 610, 16, 32, 10, 2000, 375, 0xC4EBBE, 0x262B45, "TIME", 3, 0); );
kn(326, 610, 16, 34, 0, 0.95, 0.35, 0xC4EBBE, 0x262B45, "FDBK", 1, 0);
kn(396, 610, 16, 35, 0, 1, 0.18, 0xC4EBBE, 0x262B45, "MIX", 1, 0);
klog = 1;  kn(476, 610, 16, 37, 20, 2000, 150, 0xF2D04A, 0x262B45, "HPF", 2, 0);     // HPF yellow, LPF black (house)
klog = 1;  kn(546, 610, 16, 38, 1000, 20000, 4500, 0x232327, 0xFFFFFF, "LPF", 2, 0);
sub_title(672, 554, "SPACE");
#spn = sp_size < 0.25 ? "ROOM" : sp_size < 0.5 ? "CHAMBER" : sp_size < 0.8 ? "HALL" : "CATHEDRAL";
gfx_setfont(5);  col(C_INK2, 1);  text_l(px(740), py(554), #spn);
kn(704, 611, 15, 39, 0, 1, 0.55, C_CAPW, 0x262B45, "SIZE", 1, 0);
klog = 1;  kn(768, 611, 15, 40, 0.2, 12, 2.2, C_CAPW, 0x262B45, "DECAY", 17, 0);
kn(832, 611, 15, 41, 0, 1, 0.5, C_CAPW, 0x262B45, "DAMP", 1, 0);
kn(896, 611, 15, 42, 0, 1, 0.15, C_TEAL, 0xFFFFFF, "MIX", 1, 0);
sub_title(950, 554, "500 Hz CUT");
g_j = 0;
loop(4,
  lk_key(950 + g_j * 56, 597, 48, 26, floor(sp_cut + 0.5) == g_j, LK_AMB, g_j == 0 ? "OFF" : g_j == 1 ? "-3" : g_j == 2 ? "-6" : "-9") ? ( slider(43) = g_j;  param_touched(43); );
  g_j += 1;
);
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1060), py(645), "WITH HP 140 Hz  /  LP 5 kHz");

// ---------- the bottom row (MIXER | DRIVE | FFAT | MASTER), drawn 152 lower than its design numbers ----------
oy += 152 * sc;
// ---------- MIXER ----------
section(16, 528, 300, 180, C_SEC3, "MIXER");
C_CAPW = 0xD6E4F5;   // pastel sky
kn(64, 629, 17, 11, 0, 1, 0.8, C_TEAL, 0xFFFFFF, "OSC 1", 1, 0);
kn(134, 629, 17, 12, 0, 1, 0.8, C_TEAL, 0xFFFFFF, "OSC 2", 1, 0);
kn(204, 629, 17, 13, 0, 1, 0, C_CAPW, 0x262B45, "RING", 1, 0);
kn(274, 629, 17, 14, 0, 1, 0, C_CAPW, 0x262B45, "NOISE", 1, 0);

// ---------- DRIVE (FFAT's): the IN key switches it in and out ----------
section(332, 528, 320, 180, C_SEC1, "DRIVE");
C_CAPW = 0xF8D2B4;   // pastel apricot
lk_key(478, 542, 64, 24, drv_on >= 0.5, LK_AMB, "IN") ? ( slider(57) = drv_on >= 0.5 ? 0 : 1;  param_touched(57); );   // IN (house: amber)
lk_menu(556, 542, 80, 24, 58, "TUBE|FUZZ|RECT|CRUSH", 4, LK_ORG);
kdim = drv_on < 0.5;  kn(436, 624, 22, 59, 0, 10, 3, C_EMB, 0xFFFFFF, "DRIVE", 0, 1);
kdim = drv_on < 0.5;  kn(556, 629, 17, 60, 0, 100, 100, C_CAPW, 0x262B45, "MIX", 4, 0);

// ---------- FFAT: the one-knob squash (FFAT's) ----------
section(668, 528, 168, 180, C_SEC3, "FFAT");
kn(752, 624, 22, 61, 0, 10, 0, C_TEAL, 0xFFFFFF, "FFAT", 0, 1);

// ---------- MASTER ----------
section(852, 528, 332, 180, C_SEC2, "MASTER");
C_CAPW = 0xF2D0DA;   // pastel rose
u_db = out_m > 0.000001 ? 8.685889638065035 * log(out_m) : -120;
u_now = time_precise();
u_db >= pk_db || u_now - pk_t > 1.5 ? (
  u_db >= pk_db ? ( pk_db = u_db;  pk_t = u_now; ) : pk_db = max(u_db, pk_db - 20 * (u_now - pk_last));
);
pk_last = u_now;
pk_db > -48 ? sprintf(#pk, "%.1f dB", min(pk_db, 0)) : strcpy(#pk, "-inf");
sprintf(#ms, "KEYS %d  PEAK %s", keys_disp, #pk);
lcd(868, 566, 250, 28, 7, #ms);
clip_d ? ( clip_t = u_now;  clip_d = 0; );
u_on = u_now - clip_t < 0.4;
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1150), py(554), "CLIP");
col(u_on ? 0xFF4A30 : 0x5A2620, 1);  gfx_circle(px(1124), py(554), ps(4), 1, 1);
u_on ? ( col(0xFF4A30, 0.3);  gfx_circle(px(1124), py(554), ps(7), 1, 1); );
col(0x141210, 1);  u_rect(1140, 566, 20, 110);
g_j = 0;
loop(24,
  u_d = -48 + (g_j + 1) * 2;
  col(u_d > -1 ? 0xE0503A : u_d > -6 ? 0xF2A41E : 0x5FC4C0, u_db >= u_d - 2 ? 1 : 0.14);
  u_rect(1143, 673 - (g_j + 1) * 104 / 24 + 1, 14, 104 / 24 - 1.2);
  g_j += 1;
);
pk_db > -48 ? (
  u_y = 673 - (min(pk_db, 0) + 48) / 48 * 104;
  col(0xFFFFFF, 0.95);  u_rect(1142, u_y - 1, 16, 2);
);
click && mouse_x >= px(1140) && mouse_x < px(1160) && mouse_y >= py(566) && mouse_y < py(676) ? pk_db = -120;   // clear the peak
gfx_setfont(6);  col(C_INK, 1);  text_c(px(1150), py(690), "OUT");
kn(886, 648, 15, 44, -12, 12, 0, C_CAPW, 0x262B45, "LOW", 7, 0);
kn(938, 648, 15, 45, -12, 12, 0, C_CAPW, 0x262B45, "HIGH", 7, 0);
kn(990, 648, 15, 29, 0, 1, 0.4, C_CAPW, 0x262B45, "VELO", 1, 0);
kn(1042, 648, 15, 47, 0, 100, 50, C_CAPW, 0x262B45, "DRIFT", 4, 0);
kn(1094, 648, 15, 46, -24, 6, 0, C_TEAL, 0xFFFFFF, "VOL", 7, 0);

oy -= 152 * sc;

// ---------- OS key (house): left of the S / M / L / ? picker; cycles 1x -> 2x -> 4x ----------
os_key(ox / sc + 1090, oy / sc + 18, 62, C_HSUB, 12) ? gui_dirty = 1;

// ---------- S / M / L / ? (size picker and credits), house layout: four 13 x 18 keys on a 14 pitch ----------
g_j = 0;
loop(4,
  g_x = 1126 + g_j * 14;  g_on = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(0x050302, 1);  u_rect(g_x, 20, 13, 18);
  col(g_on ? C_LCDTX : shade(C_HEAD, 1.6), 1);  u_rect(g_x + 1, 21, 11, 16);
  gfx_setfont(5);  col(g_on ? C_LCDBG : C_HSUB, 1);  text_c(px(g_x + 6.5), py(29), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(20) && mouse_y < py(38) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
sz_help && click && !sz_new ? sz_help = 0;            // any click closes the pop-up
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
  gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
  g_cw = max(g_tw + ps(40), ps(380));  g_ch = ps(130);
  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(0xE0603A, 1);    gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(102);  gfx_drawstr("Click anywhere to close.");
);

// ---------- end of frame ----------
!lmb ? drag_idx = 0;
mouse_wheel = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // parameters rebuilt in @block, never on the GUI thread
