desc:GFX faceplate parts (include)
//author: JGWizrad / Garden FX (GFX)
//
// gfx-faceplate: faceplate parts shared by the hardware-style panels (Phaser, Flanger, Polyvibe, Rotary, Echo, Space). Import after gfx-ui, gfx-panel, gfx-dyn.
// All coordinates unscaled (multiplied by sc inside), colours 0xRRGGBB.
//   rd_brushed(x, y, w, h, col)          brushed metal: base colour with fine horizontal grain
//   rd_hammer(x, y, w, h, col)           hammertone / crinkle paint: speckled
//   rd_plate(x, y, w, h, col, r)         flat painted plate with a soft top light and an edge
//   rd_rack(x, y, w, h, col)             rack ears with slots at both ends (x, w = the whole width)
//   rd_screw(x, y)                       panel screw
//   rd_badge(x, y, r, fg, bg)            the GFX roundel
//   rd_title(x, y, s, size, col)         bold title; rd_sub(x, y, s, col, a) small print
//   rd_sq(x, y, w, h, on, col, s)        a coloured square lit key with its caption on it; returns 1 when clicked
//   rd_sqlbl(x, y, w, h, on, col, s)     the same key, caption underneath
//   rd_led(x, y, r, on, col)             round LED
//   rd_seg(x, y, w, h, n, s, con, coff)  seven-segment readout (right-aligned in n cells)
//   rd_lamp(cx, cy, r, lvl, col)         a glowing bulb / lamp, lvl 0..1
//   rd_io(x, y, iT, iG, iS, iM)          the inline input / output strip: TRIM (click it for GUARD, LED), SAT, OUT keys
//                                        uses dy_ink for print, rd_ioc1..3 for the caps; 214 wide, 76 high
//   ui_io(x, y, iT, iG, iS, iM)          the same strip for the themed panels (ui_knob caps, theme ink, GUARD tag); 200 wide, 70 high
@init

// rounded rectangle without seams (scaled inputs): whole pixels, pieces overlap
function rd_rr(x, y, w, h, r) local(x2, y2) (
  x = floor(x + 0.5); y = floor(y + 0.5); x2 = floor(x + w + 0.5); y2 = floor(y + h + 0.5); w = x2 - x; h = y2 - y;
  r = floor(min(r, min(w, h) * 0.5) + 0.5);
  ui_rrpx(x, y, w, h, r);   // one non-overlapping pass (gfx-ui): translucent shadows don't double at the corners
);
function rd_brushed(x, y, w, h, col) local(i, yy, a) (
  ui_col(col); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  i = 0; loop(floor(h * sc),
    a = 0.025 + 0.03 * (0.5 + 0.5 * sin(i * 12.9898 + sin(i * 0.37) * 3));
    ui_cola(i % 3 ? 0xFFFFFF : 0x000000, a); gfx_line(x * sc, y * sc + i, (x + w) * sc, y * sc + i);
    i += 1; );
  gfx_gradrect(x * sc, y * sc, w * sc, h * sc * 0.5, 1, 1, 1, 0.07, 0, 0, 0, 0, 0, 0, 0, -0.07 / (h * sc * 0.5));
);
function rd_hash(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453; v - floor(v); );
function rd_hammer(x, y, w, h, col) local(i, px, py, s) (
  ui_col(col); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  i = 0; loop(floor(w * h / 9),
    px = x + w * rd_hash(i * 2 + 1); py = y + h * rd_hash(i * 2 + 7.3); s = rd_hash(i * 3 + 2.1);
    ui_cola(s > 0.5 ? 0xFFFFFF : 0x000000, 0.035 + 0.04 * abs(s - 0.5)); gfx_circle(px * sc, py * sc, (0.8 + 2.2 * rd_hash(i + 0.5)) * sc, 1, 1);
    i += 1; );
  gfx_gradrect(x * sc, y * sc, w * sc, h * sc * 0.4, 1, 1, 1, 0.08, 0, 0, 0, 0, 0, 0, 0, -0.08 / (h * sc * 0.4));
);
function rd_plate(x, y, w, h, col, r) (
  ui_cola(0x000000, 0.45); rd_rr((x + 1) * sc, (y + 3) * sc, w * sc, h * sc, r * sc);
  ui_col(ui_mix(col, 0x000000, 0.35)); rd_rr(x * sc, y * sc, w * sc, h * sc, r * sc);
  ui_col(col); rd_rr((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, max(r - 1, 0) * sc);
  gfx_gradrect((x + 2) * sc, (y + 1) * sc, (w - 4) * sc, h * sc * 0.45, 1, 1, 1, 0.09, 0, 0, 0, 0, 0, 0, 0, -0.09 / (h * sc * 0.45));
  ui_cola(0xFFFFFF, 0.18); gfx_line((x + r) * sc, (y + 1) * sc, (x + w - r) * sc, (y + 1) * sc);
);
function rd_screw(x, y) (
  ui_cola(0x000000, 0.4); gfx_circle((x + 0.6) * sc, (y + 1) * sc, 4.6 * sc, 1, 1);
  ui_col(0x8A8D92); gfx_circle(x * sc, y * sc, 4.4 * sc, 1, 1);
  ui_col(0xC4C7CC); gfx_circle((x - 0.6) * sc, (y - 0.7) * sc, 3.2 * sc, 1, 1);
  ui_col(0x55585D); gfx_line((x - 2.8) * sc, (y - 1.2) * sc, (x + 2.8) * sc, (y + 1.2) * sc, 1);
);
function rd_rack(x, y, w, h, col) local(e) (
  e = 26;
  rd_brushed(x, y, e, h, col); rd_brushed(x + w - e, y, e, h, col);
  ui_cola(0x000000, 0.5); gfx_rect((x + e - 1) * sc, y * sc, 1.5 * sc, h * sc); gfx_rect((x + w - e) * sc, y * sc, 1.5 * sc, h * sc);
  ui_col(0x0A0A0B);
  ui_rrect((x + 7) * sc, (y + 18) * sc, 12 * sc, 22 * sc, 6 * sc); ui_rrect((x + 7) * sc, (y + h - 40) * sc, 12 * sc, 22 * sc, 6 * sc);
  ui_rrect((x + w - 19) * sc, (y + 18) * sc, 12 * sc, 22 * sc, 6 * sc); ui_rrect((x + w - 19) * sc, (y + h - 40) * sc, 12 * sc, 22 * sc, 6 * sc);
);
function rd_badge(x, y, r, fg, bg) (
  ui_col(fg); gfx_circle(x * sc, y * sc, r * sc, 1, 1);
  gfx_setfont(4); ui_col(bg); ui_text(x * sc, (y - 5) * sc, "GFX");
);
function rd_title(x, y, s, size, col) (
  gfx_setfont(6, "Trebuchet MS", size * sc, 'b'); ui_col(col); gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s);
);
function rd_titlei(x, y, s, size, col) (
  gfx_setfont(6, "Trebuchet MS", size * sc, 'bi'); ui_col(col); gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s);
);
function rd_sub(x, y, s, col, a) ( gfx_setfont(4); ui_cola(col, a); gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function rd_lbl(x, y, s, col, a) ( gfx_setfont(4); ui_cola(col, a); ui_text(x * sc, y * sc, s); );
function rd_led(x, y, r, on, col) (
  ui_col(0x060607); gfx_circle(x * sc, y * sc, (r + 1.5) * sc, 1, 1);
  on ? ( ui_cola(col, 0.22); gfx_circle(x * sc, y * sc, (r + 4) * sc, 1, 1); ui_col(col); ) : ui_col(ui_mix(col, 0x000000, 0.78));
  gfx_circle(x * sc, y * sc, r * sc, 1, 1);
  ui_cola(0xFFFFFF, on ? 0.6 : 0.15); gfx_circle((x - r * 0.3) * sc, (y - r * 0.35) * sc, r * 0.35 * sc, 1, 1);
);
// the coloured square lit key (caption printed on the key)
rd_sqdark = 0;   // 1: caption stays dark on a lit key
rd_sqbg = 0x101012;   // what an unlit key's colour is mixed towards
function rd_sq(x, y, w, h, on, col, s) local(hit, hov) (
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.5); gfx_rect((x + 1) * sc, (y + 2) * sc, w * sc, h * sc);
  ui_col(0x0A0A0B); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  on ? (
    ui_cola(col, 0.25); gfx_rect((x - 2) * sc, (y - 2) * sc, (w + 4) * sc, (h + 4) * sc);
    ui_col(col); gfx_rect((x + 1.5) * sc, (y + 1.5) * sc, (w - 3) * sc, (h - 3) * sc);
    gfx_gradrect((x + 1.5) * sc, (y + 1.5) * sc, (w - 3) * sc, (h - 3) * sc * 0.5, 1, 1, 1, 0.35, 0, 0, 0, 0, 0, 0, 0, -0.35 / ((h - 3) * sc * 0.5));
  ) : (
    ui_col(ui_mix(col, rd_sqbg, 0.72)); gfx_rect((x + 1.5) * sc, (y + 1.5) * sc, (w - 3) * sc, (h - 3) * sc);
    gfx_gradrect((x + 1.5) * sc, (y + 1.5) * sc, (w - 3) * sc, (h - 3) * sc * 0.5, 1, 1, 1, 0.08, 0, 0, 0, 0, 0, 0, 0, -0.08 / ((h - 3) * sc * 0.5));
  );
  hov ? ( ui_cola(0xFFFFFF, 0.08); gfx_rect(x * sc, y * sc, w * sc, h * sc); );
  strlen(s) ? (
    gfx_setfont(4); ui_col(on ? (rd_sqdark ? 0x101010 : (((col & 255) + ((col >> 8) & 255) + ((col >> 16) & 255)) > 450 ? 0x141414 : 0xFFFFFF)) : ui_mix(col, 0xDDDDDD, 0.35));
    ui_keytext((x + w * 0.5) * sc, (y + h * 0.5) * sc, s);
  );
  hit;
);
function rd_sqlbl(x, y, w, h, on, col, s) local(hit) (
  hit = rd_sq(x, y, w, h, on, col, "");
  rd_lbl(x + w * 0.5, y + h + 4, s, dy_ink, 0.9);
  hit;
);
// seven-segment readout
function rd_segm(c) (
  c == '0' || c == 'O' ? 63 : c == '1' || c == 'I' ? 6 : c == '2' ? 91 : c == '3' ? 79 : c == '4' ? 102 : c == '5' || c == 'S' ? 109 :
  c == '6' ? 125 : c == '7' ? 7 : c == '8' ? 127 : c == '9' ? 111 : c == '-' ? 64 : c == 'A' ? 119 : c == 'B' || c == 'b' ? 124 :
  c == 'C' ? 57 : c == 'c' ? 88 : c == 'D' || c == 'd' ? 94 : c == 'E' ? 121 : c == 'F' ? 113 : c == 'G' ? 61 : c == 'H' ? 118 :
  c == 'h' ? 116 : c == 'J' ? 30 : c == 'L' ? 56 : c == 'N' || c == 'n' ? 84 : c == 'o' ? 92 : c == 'P' ? 115 : c == 'r' || c == 'R' ? 80 :
  c == 't' || c == 'T' ? 120 : c == 'U' ? 62 : c == 'u' ? 28 : c == 'Y' ? 110 : c == '_' ? 8 : 0
);
function rd_segd(x, y, w, h, m, con, coff, dot) local(t, hh, g) (
  t = max(1.5, floor(w * 0.19 + 0.5)); hh = floor(h * 0.5); g = max(0.6, t * 0.2);
  ui_col(m & 1 ? con : coff);  gfx_rect(x + t + g, y, w - 2 * t - 2 * g, t);
  ui_col(m & 2 ? con : coff);  gfx_rect(x + w - t, y + t + g, t, hh - t - 1.5 * g);
  ui_col(m & 4 ? con : coff);  gfx_rect(x + w - t, y + hh + 0.5 * g, t, hh - t - 1.5 * g);
  ui_col(m & 8 ? con : coff);  gfx_rect(x + t + g, y + h - t, w - 2 * t - 2 * g, t);
  ui_col(m & 16 ? con : coff); gfx_rect(x, y + hh + 0.5 * g, t, hh - t - 1.5 * g);
  ui_col(m & 32 ? con : coff); gfx_rect(x, y + t + g, t, hh - t - 1.5 * g);
  ui_col(m & 64 ? con : coff); gfx_rect(x + t + g, y + hh - t * 0.5, w - 2 * t - 2 * g, t);
  ui_col(dot ? con : coff); gfx_rect(x + w + t * 0.6, y + h - t, t, t);
);
function rd_seg(x, y, w, h, n, s, con, coff) local(len, i, c, cells, k, dt, gap) (
  x *= sc; y *= sc; w *= sc; h *= sc;
  len = strlen(s); gap = w * 0.34;
  cells = 0; i = 0; loop(len, str_getchar(s, i) != '.' ? cells += 1; i += 1; );
  k = 0; loop(n - cells, rd_segd(x + k * (w + gap), y, w, h, 0, con, coff, 0); k += 1; );
  i = 0;
  loop(len,
    c = str_getchar(s, i);
    c != '.' ? (
      dt = i + 1 < len ? str_getchar(s, i + 1) == '.' : 0;
      rd_segd(x + k * (w + gap), y, w, h, rd_segm(c), con, coff, dt);
      k += 1;
    );
    i += 1; );
);
// glowing lamp
function rd_lamp(cx, cy, r, lvl, col) local(i) (
  lvl = min(max(lvl, 0), 1);
  i = 5; loop(5, ui_cola(col, 0.05 * lvl); gfx_circle(cx * sc, cy * sc, r * (1 + i * 0.45) * sc, 1, 1); i -= 1; );
  ui_col(ui_mix(0x2A2420, col, 0.15 + 0.85 * lvl)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.15 + 0.6 * lvl); gfx_circle(cx * sc, cy * sc, r * 0.45 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.25); gfx_circle((cx - r * 0.35) * sc, (cy - r * 0.4) * sc, r * 0.22 * sc, 1, 1);
);

// a stepped dy_knob's printed labels are clickable: call right after dy_knob with the same centre / radius
function rd_stepclick(cx, cy, r, idx, n) local(i, a, px, py) (
  pressed && drag_id == 0 ? (
    i = 0; loop(n,
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi;
      px = (cx + sin(a) * (r + 18)) * sc; py = (cy - cos(a) * (r + 18)) * sc;
      abs(mouse_x - px) < 14 * sc && abs(mouse_y - py) < 8 * sc ? ( slider(idx) = i; ui_auto(idx); drag_id = -1; );
      i += 1; );
  );
);
// ---------- the inline input / output strip ----------
// TRIM with its GUARD key beside it (the guard protects the input; the key glows while it catches peaks),
// SAT: the band saturation. (The output stage has no keys: its mode is fixed per unit.) iM is not used.
rd_ioc1 = 0x2A2A2E; rd_ioc2 = 0xD8B040; rd_ioc3 = 0xC83A2A; rd_iok = 20; rd_gcol = 0xFF4A30;
rd_iotx = 0;   // a panel with room can move TRIM further left of its GUARD key
function rd_io(x, y, iT, iG, iS, iM) local(r, k0) (
  r = 15; k0 = dy_kst;
  dy_kst = rd_iok;
  sprintf(#rdv, "%+.1f dB", slider(iT)); dy_knob(x + 50 - rd_iotx, y + 22, r, iT, -24, 12, 0, 0, rd_ioc1, "TRIM", #rdv);
  // GUARD: click the TRIM knob; its LED (upper right) is lit while the guard is on
  ui_guardclick(1600 + iT, iG, x + 50 - rd_iotx, y + 22, r + 9);
  sprintf(#rdv, "%.0f%%", slider(iS)); dy_knob(x + 148, y + 22, r, iS, 0, 100, 0, 0, rd_ioc2, "SAT", #rdv);
  gfx_setfont(8, "Trebuchet MS", ui_fs4 * ui_okfs, 'b'); gfx_setfont(4);   // (fonts as the old OUT keys left them)
  dy_kst = k0 ? k0 : 7;
);

// ---------- the IN / OUT strip for the themed panels (follows the colour theme and HW / FLAT) ----------
function ui_io(x, y, iT, iG, iS, iM) (
  ui_kcap = 0x3A3B40; ui_knob((x + 46) * sc, (y + 30) * sc, iT, -24, 12, 0, 0, "TRIM", "%+.1f dB");
  ui_guardclick(iT, iG, x + 46, y + 30, 20.5);   // click TRIM for GUARD; its LED sits at the knob's upper right
  ui_kcap = 0xD8B040; ui_knob((x + 142) * sc, (y + 30) * sc, iS, 0, 100, 0, 0, "SAT", "%.0f%%");
  gfx_setfont(8, "Trebuchet MS", ui_fs4 * ui_okfs, 'b'); gfx_setfont(4);   // (fonts as the old OUT keys left them)
);
