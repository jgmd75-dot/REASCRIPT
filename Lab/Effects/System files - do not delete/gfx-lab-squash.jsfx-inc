desc:GFX Squash stage (over-easy compression + mastering clip)
// author: JGWizrad / Garden FX (GFX)

@init

function sqh_init() (
    sqh_env = 0;
    sqh_gr = 1;
    sqh_l = 0;
    sqh_r = 0;
    sqh_det_c = 1 - exp(-1 / (0.01 * srate));
    sqh_att_c = 1 - exp(-1 / (0.005 * srate));
    sqh_rel_c = 1 - exp(-1 / (0.050 * srate));
);

function sqh_setup(thresh_db, ratio, knee_db, attack_ms, release_ms, ceiling_db, enable) (
    sqh_thresh = thresh_db;
    sqh_ratio = max(ratio, 1);
    sqh_knee = max(knee_db, 0);
    sqh_att_c = 1 - exp(-1 / (max(attack_ms, 0.1) * 0.001 * srate));
    sqh_rel_c = 1 - exp(-1 / (max(release_ms, 1.0) * 0.001 * srate));
    sqh_ceiling = 10 ^ (ceiling_db / 20);
    sqh_en = enable;
);

function sqh_clip(x, c) local(a, k) (
    a = abs(x);
    k = 0.8 * c;
    a < k ? x : (
        sqh_clipped = 1;
        sign(x) * (k + (c - k) * ((exp(2 * ((a - k) / (c - k))) - 1) / (exp(2 * ((a - k) / (c - k))) + 1)));
    );
);

function sqh_process(l, r) local(pk, db_in, db_out, slope, gain_target, x) (
    sqh_en ? (
        pk = max(abs(l), abs(r));
        sqh_env += (pk - sqh_env) * (pk > sqh_env ? sqh_att_c : sqh_rel_c);

        db_in = 20 * log10(max(sqh_env, 0.00001));

        db_out = db_in;
        sqh_knee > 0 ? (
            x = db_in - sqh_thresh;
            2 * x < -sqh_knee ? db_out = db_in :
            2 * x > sqh_knee ? db_out = sqh_thresh + (db_in - sqh_thresh) / sqh_ratio :
            db_out = db_in + (1 / sqh_ratio - 1) * (x + sqh_knee * 0.5) ^ 2 / (2 * sqh_knee);
        ) : (
            db_in > sqh_thresh ? db_out = sqh_thresh + (db_in - sqh_thresh) / sqh_ratio;
        );

        gain_target = 10 ^ ((db_out - db_in) / 20);
        sqh_gr += (gain_target - sqh_gr) * 0.1;

        l *= sqh_gr;
        r *= sqh_gr;
    ) : (
        sqh_gr = 1;
    );

    sqh_l = sqh_clip(l, sqh_ceiling);
    sqh_r = sqh_clip(r, sqh_ceiling);
);
