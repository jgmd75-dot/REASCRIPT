desc:GFX Series 74 panel parts (include)
//author: JGWizrad / Garden FX (GFX)
//
// The look of Series 74 - the OB remote and broadcast series: units built like ruggedized outside-broadcast flight
// cases. A matte olive-drab case; hard-edged modules set in thick dark-steel channels, each with a header strip held
// by exposed hex screws; heavy cast-metal pointer knobs with high-visibility index lines; square backlit ITT-style
// lens switches; razor-thin routing wireframes in deep charcoal and hazard orange. Geometric sans-serif capitals.
//
// Every unit has two models, OB and CLEAN (s74_pal(model)): the steel case stays the same, the modules change -
// OB: olive-drab modules, round gunmetal knobs, smoked lenses lit amber, amber meter windows. CLEAN, after the 1980s
// broadcast desks (the Auditronics 200 series): warm light-grey module plates, charcoal print, black screws, round
// aluminium knobs with a red cap, cream keys that light red, cream VU windows.
//
// Usage (after gfx-ui and gfx-panel):
//   import gfx-s74.jsfx-inc
//   @gfx     ui_begin(W, H); s74_pal(model); s74_fonts(); s74_face(W, H); ... pk_end(); ui_end();
// Coordinates are in base pixels (they are scaled by sc inside).
//   s74_mod(x, y, w, h, title)                                    a module: olive plate, a header strip, four hex screws
//   s74_knob(cx, cy, r, idx, lo, hi, def, log, label, fmt, step)   drag, SHIFT fine, double-click / Ctrl-click default,
//                                                                 wheel; the value shows only while touched
//   s74_lens(x, y, w, h, on, s)                                    a square lens switch, lit when on; returns 1 on a click
//   inst.s74_edge(x, y, w, h, level, label)                        an edgewise meter (level: linear, 1 = 0 VU)
//   s74_box / s74_wire / s74_node                                  the routing wireframe (lit = the live path)
//   s74_title(x, y, s) / s74_cap(cx, y, s) / s74_small(x, y, s)    module title / centred caption / small print

@init
// ---------- colours: the case is fixed, the lamps follow the model ----------
function s74_pal(m) (
  s74_m = m >= 0.5;
  S74_FACE = 0x25282A;                                  // the steel channels (and the case behind the modules)
  S74_STEEL = 0x34383B; S74_STEELH = 0x4A4F53;
  S74_CHAR = 0x22251F; S74_HAZ = 0xFF6A13;
  // the house colour code for knob caps and keys (set s74_kc / s74_lc to one before the call, back to 0 after):
  // LF brown, LMF blue, HMF green, HF red, HPF yellow, LPF black
  S74_C_LF = 0x7A4A2A; S74_C_LMF = 0x2F5FA8; S74_C_HMF = 0x2F7D46; S74_C_HF = 0xC0302A; S74_C_HPF = 0xE0B52A; S74_C_LPF = 0x1C1C1E;
  S74_RED = s74_m ? 0x7A1408 : 0xC2321A;
  S74_GRID = 0x000000; S74_GRA = 0;
  !s74_m ? (
    // OB: olive-drab modules, cream print, amber lamps
    S74_OLIVE = 0x4D5338; S74_OLIVED = 0x3E432D; S74_OLIVEL = 0x5C6344;
    S74_INK = 0xE9E6D6; S74_DIM = 0xA9A98E;
    S74_LAMP = 0xFFAE3A; S74_LAMPD = 0x5A3A12; S74_LAMPW = 0xFFD48A; S74_LTXT = 0x231507;
  ) : (
    // CLEAN: the broadcast desk - warm light-grey module plates, charcoal print, cream VU windows, red lit keys
    S74_OLIVE = 0xD8D4C8; S74_OLIVED = 0xC6C1B3; S74_OLIVEL = 0xE4E0D5;
    S74_INK = 0x26282A; S74_DIM = 0x6E6A61;
    S74_LAMP = 0xF2683A; S74_LAMPD = 0xD9502A; S74_LAMPW = 0xFFA36E; S74_LTXT = 0xFFF4EA;
  );
  S74_AMBD = S74_LAMPD; S74_AMBW = S74_LAMPW; S74_NDL = 0x16181A; S74_ORNG = S74_HAZ; S74_IDX = 0xF4F2E8;
  S74_PLATE = S74_OLIVE; S74_KEYC = S74_LAMP; S74_KEYT = S74_LTXT; S74_KEYH = S74_OLIVEL;
);
s74_pal(0);
// the house lamp keys (gfx-ui's lk_fit): a unit opts in with s74_lamp = 1; s74_lk = the next lens's colour
// (LK_AMB unless set; cleared after each lens). lk_well / lk_font / lk_font2 are the unit's to set.
s74_lamp = 0; s74_lk = 0;

// ---------- type ----------
function s74_fonts() (
  sc != s74_calsc ? (
    s74_calsc = sc;
    s74_f1 = ui_fitarial(11, 13.5 * sc);      // captions (the knobs' labels)
    s74_f2 = ui_fitarial(12, 12.5 * sc);      // module titles
    s74_f3 = ui_fitarial(13, 10 * sc);        // small print, values
  );
  gfx_setfont(11, "Arial", s74_f1, 'b'); gfx_setfont(12, "Arial", s74_f2, 'b'); gfx_setfont(13, "Arial", s74_f3, 'b');
  gfx_setfont(14, "Arial", 26 * sc, 'b'); gfx_setfont(15, "Arial", 15 * sc, 'b');
);
function s74_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function s74_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function s74_t(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function s74_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = floor(cy * sc - th * 0.55 + 0.5); gfx_drawstr(s); );
function s74_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function s74_set(idx, v) ( slider(idx) = v; ui_auto(idx); );
function s74_ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny) (
  x1 *= sc; y1 *= sc; x2 *= sc; y2 *= sc; w *= sc * 0.5;
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * w; ny = dx / l * w;
  w < 0.7 ? gfx_line(x1, y1, x2, y2, 1) : l < 8 ? gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny)
    : ui_ssline(x1, y1, x2, y2, 2 * w, 0);   // (lines 8 px and longer supersampled: even at every angle)
);
function s74_title(x, y, s) ( gfx_setfont(12); ui_col(S74_INK); s74_t(x, y, s); );
function s74_cap(cx, y, s) ( gfx_setfont(11); ui_col(S74_INK); s74_tc(cx, y, s); );
function s74_small(x, y, s) ( gfx_setfont(13); ui_col(S74_DIM); s74_t(x, y, s); );
function s74_smallc(cx, y, s) ( gfx_setfont(13); ui_col(S74_DIM); s74_tc(cx, y, s); );

// ---------- the case ----------
// the dark-steel case: the channels between the modules, a faint sheen towards the top
function s74_face(w, h) local(i) (
  ui_col(S74_FACE); gfx_rect(0, 0, gfx_w, gfx_h);
  i = 0; loop(8, ui_cola(0xFFFFFF, 0.012); s74_r(0, 0, w, h * (1 - i / 8) * 0.5); i += 1; );
);
// an exposed hex screw: a steel head, a hex socket
function s74_hex(cx, cy, r) local(i, a0, a1) (
  ui_cola(0x000000, 0.45); gfx_circle((cx + 0.6) * sc, (cy + 1) * sc, r * sc, 1, 1);
  ui_col(s74_m ? 0x1A1B1C : 0x8C9296); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  ui_col(s74_m ? 0x3A3C3E : 0xB6BBBE); gfx_circle((cx - r * 0.12) * sc, (cy - r * 0.12) * sc, r * 0.82 * sc, 1, 1);
  ui_col(s74_m ? 0x2A2C2E : 0x9CA2A6); gfx_circle(cx * sc, cy * sc, r * 0.8 * sc, 1, 1);
  ui_col(s74_m ? 0x0A0B0C : 0x26292B);
  i = 0; loop(6, a0 = i * $pi / 3 + 0.3; a1 = a0 + $pi / 3;
    gfx_triangle(cx * sc, cy * sc, (cx + cos(a0) * r * 0.45) * sc, (cy + sin(a0) * r * 0.45) * sc, (cx + cos(a1) * r * 0.45) * sc, (cy + sin(a1) * r * 0.45) * sc); i += 1; );
);
// a module: a hard-edged olive plate, a darker header strip with its title, a hex screw in each corner
function s74_mod(x, y, w, h, title) (
  ui_cola(0x000000, 0.5); s74_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(S74_OLIVE); s74_r(x, y, w, h);
  ui_cola(0xFFFFFF, 0.10); s74_r(x, y, w, 1); s74_r(x, y, 1, h);
  ui_cola(0x000000, 0.30); s74_r(x, y + h - 1, w, 1); s74_r(x + w - 1, y, 1, h);
  ui_col(S74_OLIVED); s74_r(x + 1, y + 1, w - 2, 22);
  ui_cola(0x000000, 0.35); s74_r(x + 1, y + 23, w - 2, 1);
  s74_hex(x + 10, y + 12, 4.2); s74_hex(x + w - 10, y + 12, 4.2);
  s74_hex(x + 10, y + h - 10, 4.2); s74_hex(x + w - 10, y + h - 10, 4.2);
  strlen(title) ? ( gfx_setfont(12); ui_col(S74_INK); s74_t(x + 22, y + 5, title); );
);

// a plain plate (no header strip): a hex screw at each end, half way down - the routing strip along the foot
function s74_plate(x, y, w, h) (
  ui_cola(0x000000, 0.5); s74_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(S74_OLIVE); s74_r(x, y, w, h);
  ui_cola(0xFFFFFF, 0.10); s74_r(x, y, w, 1); s74_r(x, y, 1, h);
  ui_cola(0x000000, 0.30); s74_r(x, y + h - 1, w, 1); s74_r(x + w - 1, y, 1, h);
  s74_hex(x + 10, y + h * 0.5, 4.2); s74_hex(x + w - 10, y + h * 0.5, 4.2);
);

// ---------- the cast-metal pointer knob ----------
// printed ticks; a heavy gunmetal skirt; a machined top; a bold high-visibility index line running to the edge
// CLEAN: the desk knob - a black body with a thin ridged rim, a large coloured cap (the house colour code), a stark
// index line
function s74_cap_clean(cx, cy, r, n) local(a, ca, sa, i, t, l, k, x0, y0, x1, y1) (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 10 : 7.5;
    ui_cola(S74_INK, 0.85); s74_ln(cx + sin(t) * (r + 4), cy - cos(t) * (r + 4), cx + sin(t) * (r + l), cy - cos(t) * (r + l), i == 0 || i == 5 || i == 10 ? 1.8 : 1.2);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  // the body: black, a thin ridged ring at the rim, a large coloured cap (grey unless the code colour is set)
  ui_cola(0x000000, 0.45); gfx_circle((cx + 1.6) * sc, (cy + 3) * sc, r * sc, 1, 1);
  ui_col(0x17181A); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  i = 0; loop(30, t = i * 2 * $pi / 30; ui_col(0x34373A);
    s74_ln(cx + cos(t) * r * 0.9, cy + sin(t) * r * 0.9, cx + cos(t) * (r - 0.4), cy + sin(t) * (r - 0.4), max(1, r * 0.05)); i += 1; );
  k = s74_kc ? s74_kc : 0x8E9195;
  ui_col(ui_mix(k, 0x000000, 0.35)); gfx_circle(cx * sc, cy * sc, r * 0.82 * sc, 1, 1);
  ui_col(k); gfx_circle((cx - r * 0.03) * sc, (cy - r * 0.04) * sc, r * 0.76 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.22); gfx_circle((cx - r * 0.22) * sc, (cy - r * 0.25) * sc, r * 0.3 * sc, 1, 1);
  ui_col(k); gfx_circle((cx - r * 0.12) * sc, (cy - r * 0.14) * sc, r * 0.3 * sc, 1, 1);
  // the index: a stark line from the centre to the rim (black on a pale cap, white otherwise)
  ui_col(k == S74_C_HPF || k == 0x8E9195 ? 0x101214 : 0xF6F4EE);
  s74_ln(cx + ca * r * 0.1, cy + sa * r * 0.1, cx + ca * r * 0.92, cy + sa * r * 0.92, max(2.6, r * 0.13));
);
function s74_cap_draw(cx, cy, r, n) local(a, ca, sa, i, t, l) (
  s74_m ? s74_cap_clean(cx, cy, r, n) : (
  i = 0;
  loop(11,
    t = -0.75 * $pi + i * 0.15 * $pi; l = i == 0 || i == 5 || i == 10 ? 10 : 7.5;
    ui_cola(S74_INK, 0.85); s74_ln(cx + sin(t) * (r + 4), cy - cos(t) * (r + 4), cx + sin(t) * (r + l), cy - cos(t) * (r + l), i == 0 || i == 5 || i == 10 ? 1.8 : 1.2);
    i += 1;
  );
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle((cx + 1.6) * sc, (cy + 3) * sc, r * sc, 1, 1);
  ui_col(0x1C1E20); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
  // the skirt's flutes
  i = 0; loop(18, t = i * 2 * $pi / 18; ui_col(0x34383C); s74_ln(cx + cos(t) * r * 0.78, cy + sin(t) * r * 0.78, cx + cos(t) * (r - 0.6), cy + sin(t) * (r - 0.6), max(1.4, r * 0.09)); i += 1; );
  // the machined top: concentric turning, lit from the top left
  ui_col(0x2B2E31); gfx_circle(cx * sc, cy * sc, r * 0.74 * sc, 1, 1);
  ui_col(0x5E6366); gfx_circle((cx - r * 0.03) * sc, (cy - r * 0.04) * sc, r * 0.68 * sc, 1, 1);
  ui_col(0x4B5054); gfx_circle((cx + r * 0.02) * sc, (cy + r * 0.03) * sc, r * 0.64 * sc, 1, 1);
  i = 1; loop(4, ui_cola(0xFFFFFF, 0.05); gfx_circle(cx * sc, cy * sc, r * (0.64 - i * 0.12) * sc, 0, 1); i += 1; );
  // the colour code, as a coloured centre on the machined top
  s74_kc ? ( ui_col(ui_mix(s74_kc, 0x000000, 0.3)); gfx_circle(cx * sc, cy * sc, r * 0.36 * sc, 1, 1);
             ui_col(s74_kc); gfx_circle((cx - r * 0.02) * sc, (cy - r * 0.03) * sc, r * 0.32 * sc, 1, 1); );
  // the index line: a bold white bar from the centre across the skirt to the rim
  ui_cola(0x000000, 0.4); s74_ln(cx + ca * r * 0.12 + 0.8, cy + sa * r * 0.12 + 0.8, cx + ca * r + 0.8, cy + sa * r + 0.8, max(3, r * 0.15));
  ui_col(S74_IDX); s74_ln(cx + ca * r * 0.12, cy + sa * r * 0.12, cx + ca * r, cy + sa * r, max(3, r * 0.15));
  );
);
function s74_pill(cx, y, s) local(tw, th) (
  gfx_setfont(13); gfx_measurestr(s, tw, th);
  ui_col(S74_CHAR); gfx_rect(cx * sc - tw * 0.5 - 6 * sc, y * sc, tw + 12 * sc, th + 4 * sc);
  ui_col(S74_LAMP); gfx_x = floor(cx * sc - tw * 0.5 + 0.5); gfx_y = y * sc + 2 * sc; gfx_drawstr(s);
);
// dim = 1 greys the caption (a control the model leaves out of the path)
function s74_knob(cx, cy, r, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, dx, dy, hov, did) (
  did = 4000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - s74_lt < 0.35 && s74_lid == idx && !s74_mv) || (mouse_cap & 4) ? ( s74_set(idx, def); drag_id = -1; s74_lt = 0; ) : (
      drag_id = did; s74_ky = mouse_y; s74_ky0 = mouse_y; s74_mv = 0; s74_lt = time_precise(); s74_lid = idx;
      s74_kn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == did && !s74_mv && abs(mouse_y - s74_ky0) > 3 * sc ? ( s74_mv = 1; s74_ky = mouse_y; );
  drag_id == did && s74_mv ? (
    s74_kn = min(max(s74_kn + (s74_ky - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); s74_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ s74_kn : lo + s74_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s74_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    s74_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  s74_cap_draw(cx, cy, r, min(max(n, 0), 1));
  (hov || drag_id == did) ? (
    strlen(fmt) ? sprintf(#s74_vv, fmt, v) : strcpy(#s74_vv, #s74_vs);
    s74_pill(cx, cy + r + 8, #s74_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(11); ui_col(s74_off ? S74_DIM : S74_INK); s74_tc(cx, cy + r + 18, label); );
  );
);

// ---------- the square lens switch (ITT style): a black bezel, a lens lit from behind when engaged ----------
// CLEAN: a chunky square desk key - a coloured cap (crimson, or s74_lc) that glows when engaged, a white legend
function s74_lens(x, y, w, h, on, s) local(hov, hit, i, k, kl) (
  s74_lamp ? ( hit = lk_fit(x, y, w, h, on, s74_lk ? s74_lk : LK_AMB, s); ) : (
  hov = s74_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  s74_m ? (
    k = s74_lc ? s74_lc : 0x9A2034;
    kl = !s74_lc || s74_lc == 0xA8203A ? 0xD9506E : s74_lc == 0xC8761E ? 0xF0962E : ui_mix(s74_lc, 0xFFFFFF, s74_lc == S74_C_LPF ? 0.55 : 0.4);
    k = ui_mix(k, 0x000000, 0.3);
    ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
    ui_col(0x2A2A2C); s74_r(x, y, w, h);
    on ? ( i = 0; loop(2, ui_cola(kl, 0.06); s74_r(x - 2 - i * 2, y - 2 - i * 2, w + 4 + i * 4, h + 4 + i * 4); i += 1; ); );
    ui_col(on ? kl : hov ? ui_mix(k, 0xFFFFFF, 0.12) : k); s74_r(x + 2, y + 2, w - 4, h - 4);
    ui_cola(0xFFFFFF, on ? 0.30 : 0.16); s74_r(x + 2, y + 2, w - 4, 2); s74_r(x + 2, y + 2, 2, h - 4);
    ui_cola(0x000000, on ? 0.10 : 0.28); s74_r(x + 2, y + h - 4, w - 4, 2); s74_r(x + w - 4, y + 2, 2, h - 4);
    gfx_setfont(13); ui_col(s74_lc == S74_C_HPF && s74_lc ? 0x2A2416 : on ? 0xFFFFFF : 0xF0E6E8); s74_tc(x + w * 0.5, y + h * 0.5, s);
  ) : (
    ui_cola(0x000000, 0.45); s74_r(x + 1, y + 2, w, h);
    ui_col(0x101112); s74_r(x, y, w, h);
    ui_col(0x3A3E41); s74_r(x + 1, y + 1, w - 2, 1);
    on ? (
      i = 0; loop(3, ui_cola(S74_LAMP, 0.10); s74_r(x - 2 - i * 2, y - 2 - i * 2, w + 4 + i * 4, h + 4 + i * 4); i += 1; );
      ui_col(S74_LAMP); s74_r(x + 3, y + 3, w - 6, h - 6); ui_cola(0xFFFFFF, 0.3); s74_r(x + 3, y + 3, w - 6, (h - 6) * 0.4);
    ) : (
      ui_col(hov ? 0x3A3D34 : 0x2A2C27); s74_r(x + 3, y + 3, w - 6, h - 6);
      ui_cola(0xFFFFFF, 0.06); s74_r(x + 3, y + 3, w - 6, (h - 6) * 0.4);
    );
    gfx_setfont(13); ui_col(on ? S74_LTXT : 0x8C8E80); s74_tc(x + w * 0.5, y + h * 0.5, s);
  );
  );
  s74_lk = 0;
  hit;
);
// ---------- the desk fader: a short vertical fader in a slot, a coloured cap (s74_fc: cream unless set) ----------
// x = the slot's centre, y = its top, h = its travel. Drag, SHIFT fine, double-click / Ctrl-click default, wheel;
// the value shows beside the cap while touched. The label sits under the slot.
S74_F_CREAM = 0xE9E2CC; S74_F_BLUE = 0x2F63B8; S74_F_YELLOW = 0xE8C22E;
function s74_fader(x, y, h, idx, lo, hi, def, lg, label, fmt, stp) local(v, n, hov, did, cy, i, k, ty) (
  did = 6000 + idx; v = slider(idx);
  n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1);
  cy = y + h * (1 - n);
  hov = s74_hov(x - 18, y - 10, 36, h + 20);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - s74_lt < 0.35 && s74_lid == idx && !s74_mv) || (mouse_cap & 4) ? ( s74_set(idx, def); drag_id = -1; s74_lt = 0; ) : (
      drag_id = did; s74_ky = mouse_y; s74_ky0 = mouse_y; s74_mv = 0; s74_lt = time_precise(); s74_lid = idx; s74_kn = n;
      // a click on the slot away from the cap jumps the cap there
      abs(mouse_y / sc - cy) > 9 ? ( s74_kn = min(max(1 - (mouse_y / sc - y) / h, 0), 1); s74_mv = 1;
        v = lg ? lo * (hi / lo) ^ s74_kn : lo + s74_kn * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp; s74_set(idx, v); );
    );
  );
  drag_id == did && !s74_mv && abs(mouse_y - s74_ky0) > 3 * sc ? ( s74_mv = 1; s74_ky = mouse_y; );
  drag_id == did && s74_mv ? (
    s74_kn = min(max(s74_kn + (s74_ky - mouse_y) / ((mouse_cap & 8) ? h * 6 * sc : h * sc), 0), 1); s74_ky = mouse_y;
    v = lg ? lo * (hi / lo) ^ s74_kn : lo + s74_kn * (hi - lo);
    stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    slider(idx) != v ? s74_set(idx, v);
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(n + mouse_wheel / 120 * (stp > 0 ? stp / (hi - lo) : ((mouse_cap & 8) ? 0.005 : 0.025)), 0), 1);
    v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    s74_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1); cy = y + h * (1 - n);
  // the scale: 11 ticks either side, the ends and the middle longer
  i = 0; loop(11, ty = y + h * i / 10; ui_cola(S74_INK, 0.75);
    s74_r(x - 16 - (i == 0 || i == 5 || i == 10 ? 4 : 0), ty - 0.5, i == 0 || i == 5 || i == 10 ? 8 : 4, 1);
    s74_r(x + 12, ty - 0.5, i == 0 || i == 5 || i == 10 ? 8 : 4, 1); i += 1; );
  // the slot
  ui_col(0x0E0F10); s74_r(x - 2.5, y - 4, 5, h + 8);
  ui_cola(0xFFFFFF, 0.12); s74_r(x + 2.5, y - 4, 1, h + 8);
  // the cap: a block with ridges across its top and a white line at its middle
  k = s74_fc ? s74_fc : s74_m ? S74_F_CREAM : 0x2C2F31;
  ui_cola(0x000000, 0.45); s74_r(x - 12 + 1.5, cy - 9 + 3, 24, 18);
  ui_col(ui_mix(k, 0x000000, 0.35)); s74_r(x - 12, cy - 9, 24, 18);
  ui_col(k); s74_r(x - 11, cy - 8, 22, 15);
  i = 0; loop(3, ui_cola(0x000000, 0.18); s74_r(x - 10, cy - 6 + i * 3, 20, 1); ui_cola(0xFFFFFF, 0.25); s74_r(x - 10, cy - 5 + i * 3, 20, 1); i += 1; );
  ui_col(k == S74_F_CREAM || k == S74_F_YELLOW ? 0x1A1A1A : 0xF6F4EE); s74_r(x - 11, cy + 2, 22, 1.6);
  (hov || drag_id == did) ? (
    strlen(fmt) ? sprintf(#s74_vv, fmt, v) : strcpy(#s74_vv, #s74_vs);
    s74_pill(x, y + h + 12, #s74_vv);
  ) : (
    strlen(label) ? ( gfx_setfont(11); ui_col(s74_off ? S74_DIM : S74_INK); s74_tc(x, y + h + 22, label); );
  );
);

// ---------- the paired ON / OFF keys for a module's in / out (slider idx: 1 = in) ----------
// CLEAN: a red ON key and an orange OFF key, the live one lit; OB: two smoked lenses, the live one lit amber.
function s74_onoff(x, y, idx) local(on, lc) (
  on = slider(idx) >= 0.5;
  s74_lamp ? (
    s74_lk = LK_AMB; s74_lens(x, y, 34, 18, on, "ON") ? s74_set(idx, 1);
    s74_lk = LK_RED; s74_lens(x + 38, y, 34, 18, !on, "OFF") ? s74_set(idx, 0);
  ) : s74_m ? (
    lc = s74_lc; s74_lc = 0xA8203A; s74_lens(x, y, 34, 18, on, "ON") ? s74_set(idx, 1);
    s74_lc = 0xC8761E; s74_lens(x + 38, y, 34, 18, !on, "OFF") ? s74_set(idx, 0); s74_lc = lc;
  ) : (
    s74_lens(x, y, 34, 18, on, "ON") ? s74_set(idx, 1);
    s74_lens(x + 38, y, 34, 18, !on, "OFF") ? s74_set(idx, 0);
  );
);

// the house swap-order lens: lights for a moment when pressed; returns 1 on a click
function s74_orderkey(x, y, w, h, s) instance(t) local(hit) (
  s74_lamp && !s74_lk ? s74_lk = s74_m ? LK_AMB : LK_WHT;
  hit = s74_lens(x, y, w, h, time_precise() - t < 0.25, s); hit ? t = time_precise(); hit;
);

// ---------- the routing wireframe: razor-thin lines, charcoal at rest, hazard orange on the live path ----------
function s74_wire(x1, y1, x2, y2, on) ( ui_col(on ? S74_HAZ : s74_m ? 0x8E8A80 : S74_CHAR); s74_ln(x1, y1, x2, y2, on ? 1.2 : 1); );
function s74_node(x, y, on) ( ui_col(on ? S74_HAZ : s74_m ? 0x8E8A80 : S74_CHAR); gfx_circle(x * sc, y * sc, 2.2 * sc, 1, 1); );
function s74_box(x, y, w, h, s, on) (
  ui_col(on ? S74_HAZ : s74_m ? 0x8E8A80 : S74_CHAR);
  s74_r(x, y, w, 1); s74_r(x, y + h - 1, w, 1); s74_r(x, y, 1, h); s74_r(x + w - 1, y, 1, h);
  gfx_setfont(13); ui_col(on ? S74_HAZ : s74_m ? 0x7E7A70 : S74_CHAR); s74_tc(x + w * 0.5, y + h * 0.5 + 0.5, s);
);

// ---------- an edgewise meter in a backlit window (amber on OB, telemetry white on CLEAN) ----------
function s74_edge(x, y, w, h, lvl, label) instance(pos, vel, lt) local(dt, tgt, i, d, px, wx, ww) (
  dt = min(max(time_precise() - lt, 0.001), 0.05); lt = time_precise();
  d = 20 * log10(max(lvl, 0.00001));
  tgt = min(max((d + 20) / 23, -0.04), 1.04);
  vel += (150 * (tgt - pos) - 17 * vel) * dt; pos += vel * dt; pos = min(max(pos, -0.05), 1.05);
  ui_spill(x * sc, y * sc, w * sc, h * sc, 1);
  ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
  ui_col(0x101112); s74_r(x, y, w, h);
  wx = x + 5; ww = w - 10;
  ui_glow(wx * sc, (y + 5) * sc, ww * sc, (h - 10) * sc, 1);                  // backlit (gfx-ui ui_glow)
  i = 0;
  loop(8,
    d = i == 0 ? -20 : i == 1 ? -10 : i == 2 ? -7 : i == 3 ? -5 : i == 4 ? -3 : i == 5 ? 0 : i == 6 ? 1 : 3;
    px = wx + 22 + (ww - 44) * (d + 20) / 23;
    ui_col(d > 0 ? S74_RED : S74_CHAR); s74_r(px, y + 8, 1.2, d == 0 || d == -20 || d == 3 ? 7 : 4);
    gfx_setfont(13);
    d == -20 || d == -10 || d == -5 || d == 0 || d == 3 ? ( sprintf(#s74_e, d > 0 ? "+%d" : "%d", d); s74_tc(px, y + 24, #s74_e); );
    i += 1;
  );
  ui_cola(S74_CHAR, 0.8); s74_r(wx + 22, y + 8, (ww - 44) * 20 / 23, 1); ui_col(S74_RED); s74_r(wx + 22 + (ww - 44) * 20 / 23, y + 8, (ww - 44) * 3 / 23, 1);
  px = wx + 22 + (ww - 44) * pos;
  ui_col(S74_NDL); s74_r(px - 0.8, y + 6, 1.8, h - 12);
  gfx_setfont(13); ui_col(S74_CHAR); s74_tc(wx + ww * 0.5, y + h - 13, label);
  ui_cola(0xFFFFFF, 0.08); s74_r(wx, y + 5, ww, (h - 10) * 0.4);
);
function s74_grpos(g) ( 1 - log(1 + max(g, 0)) / log(21); );
function s74_gredge(x, y, w, h, gr, label) instance(pos, vel, lt) local(dt, tgt, i, d, px, wx, ww) (
  dt = min(max(time_precise() - lt, 0.001), 0.05); lt = time_precise();
  tgt = s74_grpos(gr);
  vel += (150 * (tgt - pos) - 17 * vel) * dt; pos += vel * dt; pos = min(max(pos, -0.02), 1.02);
  ui_spill(x * sc, y * sc, w * sc, h * sc, 1);
  ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
  ui_col(0x101112); s74_r(x, y, w, h);
  wx = x + 5; ww = w - 10;
  ui_glow(wx * sc, (y + 5) * sc, ww * sc, (h - 10) * sc, 1);                  // backlit (gfx-ui ui_glow)
  i = 0;
  loop(8,
    d = i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 10 : i == 6 ? 14 : 20;
    px = wx + 22 + (ww - 44) * s74_grpos(d);
    ui_col(S74_CHAR); s74_r(px, y + 8, 1.2, d == 0 || d == 10 || d == 20 ? 7 : 4);
    gfx_setfont(13);
    d == 0 || d == 2 || d == 4 || d == 6 || d == 10 || d == 20 ? ( sprintf(#s74_e, d == 0 ? "0" : "-%d", d); s74_tc(px, y + 24, #s74_e); );
    i += 1;
  );
  ui_cola(S74_CHAR, 0.8); s74_r(wx + 22, y + 8, ww - 44, 1);
  px = wx + 22 + (ww - 44) * pos;
  ui_col(S74_NDL); s74_r(px - 0.8, y + 6, 1.8, h - 12);
  gfx_setfont(13); ui_col(S74_CHAR); s74_tc(wx + ww * 0.5, y + h - 13, label);
  ui_cola(0xFFFFFF, 0.08); s74_r(wx, y + 5, ww, (h - 10) * 0.4);
);

// ---------- the model switch, in the header: two big lenses, OB / CLEAN ----------
function s74_modelkeys(x, y, idx) (
  s74_lamp ? s74_lk = LK_YEL; s74_lens(x, y, 50, 26, slider(idx) < 0.5, "OB") ? s74_set(idx, 0);
  s74_lamp ? s74_lk = LK_YEL; s74_lens(x + 56, y, 70, 26, slider(idx) >= 0.5, "CLEAN") ? s74_set(idx, 1);
);
// ---------- the header (on the steel): the 74 plate, the name, two lines of small print, the presets, the model
// switch, the size picker. Returns the preset picked (0 = none).
function s74_header(w, name, l1, l2, pm, midx) local(k) (
  ui_col(S74_HAZ); s74_r(16, 13, 30, 28);
  gfx_setfont(15); ui_col(0x16181A); s74_tc(31, 27, "74");
  gfx_setfont(14); gfx_measurestr(name, k, s74_hh);
  k > 124 * sc ? ( gfx_setfont(14, "Arial", 26 * sc * 124 * sc / k, 'b'); gfx_measurestr(name, k, s74_hh); );
  ui_col(0xE9E6D6); gfx_x = 56 * sc; gfx_y = 13 * sc - s74_hh * 0.17; gfx_drawstr(name);
  s74_sx = 56 + k / sc + 14;
  gfx_setfont(13); gfx_measurestr(strlen(l1) > strlen(l2) ? l1 : l2, k, s74_hh);
  k > (292 - s74_sx) * sc ? gfx_setfont(13, "Arial", s74_f3 * (292 - s74_sx) * sc / k, 'b');
  ui_col(0xA9A98E); s74_t(s74_sx, 15, l1); s74_t(s74_sx, 29, l2);
  pk_pextra = "Reset all to defaults";
  k = pk_preset(300 * sc, 10 * sc, (w - 560) * sc, 34 * sc, pr_cur, pm);
  s74_modelkeys(w - 228, 14, midx);
  ui_size_picker((w - 74) * sc, 18 * sc);
  k;
);

// =====================================================================================================================
// DSP helpers shared by the Series 74 units (all in @init, called from @init / @block / @sample)
// =====================================================================================================================
// memory: the unit sets s74_mem (the first free slot) before its first s74_alloc
function s74_alloc(n) local(p) ( p = s74_mem; s74_mem += n; memset(p, 0, n); p; );
// tanh (Pade 3/2), exactly 1 with zero slope at +/-3
function s74_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
// a one-pole smoothing / low-pass coefficient for f Hz at the rate fs
function s74_k(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
// a time constant (seconds) as a one-pole coefficient at the rate fs
function s74_kt(t, fs) ( 1 - exp(-1 / (max(t, 0.00001) * fs)); );
// RBJ biquads. t: 0 low-pass, 1 high-pass, 2 band-pass (0 dB peak), 3 peak, 4 low shelf, 5 high shelf, 6 all-pass
function s74_bqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(A, w, cs, sn, al, a0, sa) (
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * max(q, 0.05));
  t == 0 ? ( a0 = 1 + al; b0 = (1 - cs) / 2 / a0; b1 = (1 - cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 1 ? ( a0 = 1 + al; b0 = (1 + cs) / 2 / a0; b1 = -(1 + cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 2 ? ( a0 = 1 + al; b0 = al / a0; b1 = 0; b2 = -al / a0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 3 ? ( a0 = 1 + al / A; b0 = (1 + al * A) / a0; b1 = -2 * cs / a0; b2 = (1 - al * A) / a0; a1 = -2 * cs / a0; a2 = (1 - al / A) / a0; ) :
  t == 4 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) + (A - 1) * cs + sa;
             b0 = A * ((A + 1) - (A - 1) * cs + sa) / a0; b1 = 2 * A * ((A - 1) - (A + 1) * cs) / a0; b2 = A * ((A + 1) - (A - 1) * cs - sa) / a0;
             a1 = -2 * ((A - 1) + (A + 1) * cs) / a0; a2 = ((A + 1) + (A - 1) * cs - sa) / a0; ) :
  t == 5 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) - (A - 1) * cs + sa;
             b0 = A * ((A + 1) + (A - 1) * cs + sa) / a0; b1 = -2 * A * ((A - 1) + (A + 1) * cs) / a0; b2 = A * ((A + 1) + (A - 1) * cs - sa) / a0;
             a1 = 2 * ((A - 1) - (A + 1) * cs) / a0; a2 = ((A + 1) - (A - 1) * cs - sa) / a0; ) :
  ( a0 = 1 + al; b0 = (1 - al) / a0; b1 = -2 * cs / a0; b2 = 1; a1 = b1; a2 = b0; );
);
function s74_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
function s74_bqclr() instance(z1, z2) ( z1 = z2 = 0; );
// a one-pole low-pass (k from s74_k)
function s74_lp1(x, k) instance(s) ( s += (x - s) * k; s; );
// a delay line: n samples of memory; write then read d samples back (fractional, linear) - instance per line
function s74_dlinit(n) instance(buf, len, w) ( buf = s74_alloc(n); len = n; w = 0; );
function s74_dlw(x) instance(buf, len, w) ( w += 1; w >= len ? w = 0; buf[w] = x; );
function s74_dlr(d) instance(buf, len, w) local(p, i, f, a, b) (
  d = min(max(d, 0), len - 2); p = w - d; p < 0 ? p += len; i = floor(p); f = p - i;
  a = buf[i]; i += 1; i >= len ? i = 0; b = buf[i];
  a + (b - a) * f;
);
// a cubic (Hermite) read, for modulated lines
function s74_dlr3(d) instance(buf, len, w) local(p, i, f, xm, x0, x1, x2, c1, c2, c3) (
  d = min(max(d, 1), len - 3); p = w - d; p < 0 ? p += len; i = floor(p); f = p - i;
  xm = buf[i - 1 < 0 ? len - 1 : i - 1]; x0 = buf[i]; x1 = buf[(i + 1) % len]; x2 = buf[(i + 2) % len];
  c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);
// a Schroeder all-pass on a delay line (g, d samples)
function s74_ap(x, d, g) instance(buf, len, w) local(v, y) (
  v = this.s74_dlr(d); y = v - g * x; this.s74_dlw(x + g * y); y;
);
// ---------- oversampling: linear-phase half-bands (Kaiser windowed, polyphase), as in Drive57 and Drive74 ----------
function s74_bi0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= sqr(x / (2 * k)); s += t; k += 1; ); s; );
function s74_hbdesign(h, n, beta) local(c, t, k, w, x, se, i0) (
  c = (n - 1) / 2; i0 = s74_bi0(beta); t = 0;
  loop(n, k = t - c; x = 2 * t / (n - 1) - 1; w = s74_bi0(beta * sqrt(max(0, 1 - x * x))) / i0;
          h[t] = k == 0 ? 0.5 : sin($pi * k / 2) / ($pi * k) * w; t += 1; );
  se = 0; t = 0; loop((n + 1) / 2, se += h[2 * t]; t += 1; );
  t = 0; loop((n + 1) / 2, h[2 * t] *= 0.5 / se; t += 1; );
);
function s74_upinit(n, h, sz) instance(buf, sz2, w, hu, np, mm, dd) local(j) (
  buf = s74_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; dd = ((n - 1) / 2 - 1) / 2;
  hu = s74_alloc(np); j = 0; loop(np, hu[j] = 2 * h[2 * j]; j += 1; );
);
function s74_up(x) instance(buf, sz2, w, hu, np, mm, dd, o0, o1) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x; buf[w + sz2] = x;
  p = buf + w + sz2; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-j] + p[j + 1 - mm]); j += 1; );
  o0 = s; o1 = p[-dd];
);
function s74_dninit(n, h, sz) instance(buf, sz2, w, hu, np, mm, cc) local(j) (
  buf = s74_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; cc = (n - 1) / 2;
  hu = s74_alloc(np); j = 0; loop(np, hu[j] = h[2 * j]; j += 1; );
);
function s74_dn(x0, x1) instance(buf, sz2, w, hu, np, mm, cc) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x0; buf[w + sz2] = x0;
  w += 1; w >= sz2 ? w = 0; buf[w] = x1; buf[w + sz2] = x1;
  p = buf + w + sz2 - 1; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-2 * j] + p[2 * (j + 1 - mm)]); j += 1; );
  s + 0.5 * p[-cc];
);
// pink-ish noise (Paul Kellet's economy filter on white), about -12 dBFS RMS
function s74_pink() instance(p0, p1, p2) local(w) (
  w = rand(2) - 1; p0 = 0.99765 * p0 + w * 0.099046; p1 = 0.963 * p1 + w * 0.2965164; p2 = 0.57 * p2 + w * 1.0526913;
  (p0 + p1 + p2 + w * 0.1848) * 0.12;
);

// =====================================================================================================================
// Meters for the measuring units (Meter74, Master74)
// =====================================================================================================================
// the needle's place (0 .. 1) on each scale. mode: 0 VU (-20 .. +3, the classic voltage-law scale),
// 1 PPM (DIN: -50 .. +5 dB, the bottom 20 dB compressed), 2 PPM (Nordic: -36 .. +9 dB, linear), 3 PEAK (-60 .. 0 dBFS)
function s74_scpos(mode, d) (
  mode == 0 ? ( (10 ^ (max(d, -40) / 20) - 0.1) / (1.41254 - 0.1) ) :
  mode == 1 ? ( d < -30 ? 0.2 * (max(d, -60) + 50) / 20 : 0.2 + 0.8 * (d + 30) / 35 ) :
  mode == 2 ? ( (d + 36) / 45 ) :
              ( d < -30 ? 0.25 * (max(d, -70) + 60) / 30 : 0.25 + 0.75 * (d + 30) / 30 );
);
// an arc meter: an amber window, the scale on an arc, the needle from a pivot below the window
//   db: the reading on the scale (relative to the reference for VU / PPM, dBFS for PEAK); hold: a drag pointer (or -999)
function s74_arcm(x, y, w, h, db, hold, mode, label, ch) local(px, py, R, a, i, d, t, n, lo, hi, red, p, s, c, x1, y1, x2, y2)
(
  // the case and the window
  ui_spill(x * sc, y * sc, w * sc, h * sc, 1);
  ui_cola(0x000000, 0.18); s74_rr(x + 1, y + 3, w, h, 6);
  ui_col(S74_INK); s74_rr(x, y, w, h, 6);
  ui_glow((x + 7) * sc, (y + 7) * sc, (w - 14) * sc, (h - 14) * sc, 1);         // backlit (gfx-ui ui_glow)
  px = x + w * 0.5; py = y + h - 12; R = h - 58;
  // the scale arc (-48 .. +48 degrees)
  n = mode == 0 ? 11 : mode == 1 ? 12 : 9;
  red = mode == 0 ? 0 : mode == 1 ? 0 : mode == 2 ? 0 : -6;
  i = 0;
  loop(n,
    d = mode == 0 ? (i == 0 ? -20 : i == 1 ? -10 : i == 2 ? -7 : i == 3 ? -5 : i == 4 ? -3 : i == 5 ? -2 : i == 6 ? -1 : i == 7 ? 0 : i == 8 ? 1 : i == 9 ? 2 : 3) :
        mode == 1 ? (i == 0 ? -50 : i == 1 ? -40 : i == 2 ? -30 : i == 3 ? -25 : i == 4 ? -20 : i == 5 ? -15 : i == 6 ? -10 : i == 7 ? -5 : i == 8 ? -3 : i == 9 ? 0 : i == 10 ? 3 : 5) :
        mode == 2 ? (i == 0 ? -36 : i == 1 ? -30 : i == 2 ? -24 : i == 3 ? -18 : i == 4 ? -12 : i == 5 ? -6 : i == 6 ? 0 : i == 7 ? 6 : 9) :
                    (i == 0 ? -60 : i == 1 ? -40 : i == 2 ? -30 : i == 3 ? -24 : i == 4 ? -18 : i == 5 ? -12 : i == 6 ? -6 : i == 7 ? -3 : 0);
    p = min(max(s74_scpos(mode, d), 0), 1); a = (-48 + 96 * p) * $pi / 180; s = sin(a); c = cos(a);
    ui_col(d > red ? 0xC2321A : S74_INK);
    s74_ln(px + s * R, py - c * R, px + s * (R - 10), py - c * (R - 10), 1.4);
    gfx_setfont(13);
    (mode != 0 || d == -20 || d == -10 || d == -5 || d == -3 || d == 0 || d == 3 || d == -7) && (mode != 1 || d != -25 && d != -15 && d != -3) && (mode != 3 || d != -40) ? (
      sprintf(#s74_e, d > 0 ? "+%d" : "%d", d); s74_tc(px + s * (R + 12), py - c * (R + 12), #s74_e); );
    i += 1;
  );
  // the arc line, charcoal and red
  i = 0; loop(48, t = i / 48; p = s74_scpos(mode, red); a = (-48 + 96 * t) * $pi / 180;
    ui_col(t > p ? 0xC2321A : S74_INK); s74_ln(px + sin(a) * R, py - cos(a) * R, px + sin(a + 2 * $pi / 180) * R, py - cos(a + 2 * $pi / 180) * R, t > p ? 2.6 : 1.2); i += 1; );
  // the hold pointer
  hold > -900 ? ( p = min(max(s74_scpos(mode, hold), -0.02), 1.03); a = (-48 + 96 * p) * $pi / 180;
    ui_col(S74_ORNG); s74_ln(px + sin(a) * (R - 26), py - cos(a) * (R - 26), px + sin(a) * (R - 2), py - cos(a) * (R - 2), 1.6); );
  // the label
  gfx_setfont(11); ui_col(S74_INK); s74_tc(px, y + h - 52, label);
  gfx_setfont(13); ui_col(S74_DIM); s74_tc(px, y + h - 36, ch);
  // the needle
  p = min(max(s74_scpos(mode, db), -0.03), 1.04); a = (-48 + 96 * p) * $pi / 180;
  x1 = px + sin(a) * (R * 0.2); y1 = py - cos(a) * (R * 0.2); x2 = px + sin(a) * (R + 2); y2 = py - cos(a) * (R + 2);
  ui_cola(0x000000, 0.22); s74_ln(x1 + 2, y1 + 2, x2 + 2, y2 + 2, 2);
  ui_col(S74_NDL); s74_ln(x1, y1, x2, y2, 1.8);
  // the pivot cover (a charcoal band across the bottom of the window) and the glass
  ui_col(S74_INK); s74_r(x + 7, y + h - 18, w - 14, 11);
  ui_cola(0xFFFFFF, 0.07); s74_rr(x + 7, y + 7, w - 14, (h - 14) * 0.38, 3);
);
// a nixie read-out: n characters of s glowing orange in a smoked tube row
function s74_nixie(x, y, w, h, s, lit) local(n, i, cw) (
  n = strlen(s); cw = w / max(n, 1);
  ui_col(0x16120F); s74_rr(x, y, w, h, 3);
  i = 0; loop(n,
    ui_cola(0xFFFFFF, 0.05); s74_rr(x + i * cw + 2, y + 2, cw - 4, h - 4, cw * 0.4);
    i += 1; );
  gfx_setfont(14); gfx_measurestr(s, n, i);
  lit ? ( ui_cola(0xFF7A2A, 0.35); gfx_x = floor((x + w * 0.5) * sc - n * 0.5) + 1; gfx_y = floor((y + h * 0.5) * sc - i * 0.5) + 1; gfx_drawstr(s); );
  ui_col(lit ? 0xFF9A4A : 0x4A3426); gfx_x = floor((x + w * 0.5) * sc - n * 0.5); gfx_y = floor((y + h * 0.5) * sc - i * 0.5); gfx_drawstr(s);
);
