@init
v5_cr = 0xF2EAD2; v5_ink = 0xC9CCC6; v5_ne = 0x39FF6A; v5_am = 0xFFB030; v5_rd = 0xFF3A2A;
v5_led = 0x39FF6A; v5_bptr = 0x1E6B3C; v5_ccap = 0x1F4A33; v5_fcap = 0x39FF6A;
v5_fk = 13; v5_fs = 14; v5_step = 0;

function v5_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function v5_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function v5_d(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function v5_q(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function v5_t(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function v5_arc(cx, cy, r, a0, a1, w) ( ui_ssarc(cx * sc, cy * sc, r * sc, a0, a1, w * sc); );
function v5_ln(x1, y1, x2, y2, w) ( ui_ssline(x1 * sc, y1 * sc, x2 * sc, y2 * sc, w * sc, 1); );
function v5_shc(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0, 0.08); v5_d(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function v5_shr(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0, 0.08); v5_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function v5_vig(x, y, r) local(i) ( i = 0; loop(6, ui_cola(0, 0.16 * (1 - i / 6)); gfx_circle(x * sc, y * sc, (r - i * 0.9) * sc, 0, 1); i += 1; ); );
function v5_dots(cx, cy, r, n) local(i, t) ( i = 0; loop(n, t = -0.75 * $pi + i / (n - 1) * 1.5 * $pi; ui_col(v5_ink); v5_d(cx + sin(t) * r, cy - cos(t) * r, i == 0 || i == n - 1 || i == (n - 1) / 2 ? 1.8 : 1.3); i += 1; ); );
function v5_pdot(cx, cy, a, cr, col) ( ui_col(col); v5_d(cx + sin(a) * cr * 0.62, cy - cos(a) * cr * 0.62, max(2, cr * 0.19)); );

function v5_begin() (
  v5_dn = mouse_cap & 1; v5_pr = v5_dn && !v5_pdn; v5_pdn = v5_dn;
  !v5_dn ? v5_drag = 0;
  v5_shift = mouse_cap & 8; v5_ctrl = mouse_cap & 4;
  sc != v5_csc ? ( v5_csc = sc; v5_szk = ui_fitfont(v5_fk, 14.5 * sc); v5_szs = ui_fitfont(v5_fs, 12 * sc); );
  gfx_setfont(v5_fk, "Trebuchet MS", v5_szk, 'b');
  gfx_setfont(v5_fs, "Trebuchet MS", v5_szs, 'b');
);

function v5_ctl(idx, vmin, vmax, vdef, lg, hit, horiz, span) local(v, n, d, now, m) (
  v = slider(idx);
  n = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  m = horiz ? mouse_x - mouse_y : -mouse_y;
  v5_pr && hit && v5_drag == 0 ? (
    now = time_precise();
    (now - v5_lct < 0.35 && v5_lci == idx) || v5_ctrl ? (
      slider(idx) = vdef; ui_auto(idx); v5_drag = -1; v5_lct = 0;
      n = lg ? log(vdef / vmin) / log(vmax / vmin) : (vdef - vmin) / (vmax - vmin);
    ) : (
      v5_drag = idx; v5_my = m; v5_mz = m; v5_dz = 0; v5_n = n; v5_lct = now; v5_lci = idx;
    );
  );
  v5_drag == idx ? (
    !v5_dz && abs(m - v5_mz) > 3 * sc ? ( v5_dz = 1; v5_my = m; );
    v5_dz ? (
      d = m - v5_my;
      v5_n = min(max(v5_n + d / ((v5_shift ? 5 : 1) * span * sc), 0), 1); v5_my = m;
      v = lg ? vmin * (vmax / vmin) ^ v5_n : vmin + v5_n * (vmax - vmin);
      v5_step > 0 && !v5_shift ? v = vmin + floor((v - vmin) / v5_step + 0.5) * v5_step;
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
      n = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
    );
  );
  hit && mouse_wheel != 0 && v5_drag == 0 ? (
    v5_step > 0 && !v5_shift ? (
      v = min(max(vmin + (floor((v - vmin) / v5_step + 0.5) + sign(mouse_wheel)) * v5_step, vmin), vmax);
    ) : (
      n = min(max(n + mouse_wheel / 120 * (v5_shift ? 0.005 : 0.03), 0), 1);
      v = lg ? vmin * (vmax / vmin) ^ n : vmin + n * (vmax - vmin);
    );
    slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
    n = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  );
  v5_step = 0;
  v5_act = hit || v5_drag == idx;
  min(max(n, 0), 1);
);

function v5_label(cx, cy, label, idx, fmt) (
  gfx_setfont(v5_fk); ui_col(v5_ink);
  v5_act ? ( sprintf(#v5_vs, fmt, slider(idx)); ui_col(0xFFFFFF); v5_t(cx, cy, #v5_vs); ) : v5_t(cx, cy, label);
);

function v5_toggle(idx, hit) (
  v5_pr && hit && v5_drag == 0 ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); v5_drag = -1; );
  slider(idx) >= 0.5;
);

function v5_hit(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function v5_hitc(cx, cy, r) local(dx, dy) ( dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; dx * dx + dy * dy <= r * r * sc * sc; );

function v5_arcc(t) ( t < 0.55 ? ui_mix(v5_ne, 0xFFC81E, t / 0.55) : ui_mix(0xFFC81E, 0xFF3A2A, (t - 0.55) / 0.45); );
function v5_dial_arc(cx, cy, r, v) local(a, n, i, t0, t1) (
  a = -0.75 * $pi + v * 1.5 * $pi;
  ui_col(0x0B0D0C); v5_arc(cx, cy, r + 7, -0.75 * $pi, 0.75 * $pi, 4);
  v > 0.002 ? (
    n = max(1, ceil(v * 48)); i = 0;
    loop(n, t0 = i / n * v; t1 = (i + 1) / n * v + 0.004;
      ui_cola(v5_arcc((t0 + t1) * 0.5), 0.18); v5_arc(cx, cy, r + 7, -0.75 * $pi + t0 * 1.5 * $pi, -0.75 * $pi + min(t1, v) * 1.5 * $pi, 9); i += 1; );
    i = 0;
    loop(n, t0 = i / n * v; t1 = (i + 1) / n * v + 0.004;
      ui_col(v5_arcc((t0 + t1) * 0.5)); v5_arc(cx, cy, r + 7, -0.75 * $pi + t0 * 1.5 * $pi, -0.75 * $pi + min(t1, v) * 1.5 * $pi, 3.2); i += 1; );
  );
  v5_shc(cx, cy, r);
  ui_col(0x1A1C1D); v5_d(cx, cy, r);
  ui_col(0x232627); v5_d(cx, cy, r * 0.9);
  v5_vig(cx, cy, r);
  ui_cola(0xFFFFFF, 0.10); v5_arc(cx, cy, r * 0.8, -1.9, -0.4, 1.2);
  v5_pdot(cx, cy, a, r * 0.9, v5_cr);
);
function v5_dial_cream(cx, cy, r, v) local(a, i, t) (
  a = -0.75 * $pi + v * 1.5 * $pi;
  v5_dots(cx, cy, r + 9, 5);
  v5_shc(cx, cy, r);
  ui_col(0x1B1D1E); v5_d(cx, cy, r);
  i = 0; loop(30, t = i / 30 * 2 * $pi; ui_col(0x34383A); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xBDB49E); v5_d(cx, cy, r * 0.74);
  ui_col(v5_cr); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  ui_cola(0xFFFFFF, 0.55); v5_arc(cx, cy, r * 0.58, -1.9, -0.5, 1.2);
  v5_pdot(cx, cy, a, r * 0.70, v5_bptr);
);
function v5_dial_ring(cx, cy, r, v) local(a, i, t, on, lx, ly, lr) (
  a = -0.75 * $pi + v * 1.5 * $pi; lr = r < 18 ? 2.0 : 2.5;
  i = 0; loop(11, t = -0.75 * $pi + i / 10 * 1.5 * $pi; lx = cx + sin(t) * (r + 8 + lr); ly = cy - cos(t) * (r + 8 + lr); on = i / 10 <= v + 0.001;
    on ? ( ui_cola(v5_led, 0.22); v5_d(lx, ly, lr + 3); );
    ui_col(0x050606); v5_d(lx, ly, lr + 0.9); ui_col(on ? v5_led : ui_mix(v5_led, 0x0A0B0B, 0.82)); v5_d(lx, ly, lr);
    on ? ( ui_cola(0xFFFFFF, 0.5); v5_d(lx - 0.7, ly - 0.7, 0.8); );
    i += 1; );
  v5_shc(cx, cy, r);
  ui_col(ui_mix(v5_ccap, 0, 0.55)); v5_d(cx, cy, r);
  ui_col(v5_ccap); v5_d(cx, cy, r * 0.86);
  v5_vig(cx, cy, r * 0.86);
  ui_cola(0xFFFFFF, 0.14); v5_arc(cx, cy, r * 0.72, -1.9, -0.4, 1.2);
  v5_pdot(cx, cy, a, r * 0.86, v5_cr);
);

function v5_dial(cx, cy, r, idx, vmin, vmax, vdef, lg, sty, label, fmt) local(n, ext) (
  ext = sty == 0 ? 11 : sty == 2 ? 13 : 9;
  n = v5_ctl(idx, vmin, vmax, vdef, lg, v5_hitc(cx, cy, r + ext), 0, 200);
  sty == 0 ? v5_dial_arc(cx, cy, r, n) : sty == 1 ? v5_dial_cream(cx, cy, r, n) : v5_dial_ring(cx, cy, r, n);
  v5_act ? ( ui_cola(0xFFFFFF, 0.10); v5_arc(cx, cy, r + 1.5, -$pi, $pi, 1); );
  v5_label(cx, cy + r + ext + 14, label, idx, fmt);
);

function v5_slot(x, y, w, h, lit, frac, vert) local(fy) (
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, min(w, h) * 0.5);
  ui_col(0x141617); v5_rr(x, y, w, h, min(w, h) * 0.5);
  lit && frac > 0.005 ? (
    vert ? ( fy = y + h * (1 - frac); ui_cola(v5_fcap, 0.18); v5_rr(x - 3, fy, w + 6, y + h - fy, 4); ui_col(v5_fcap); v5_rr(x + 1, fy, w - 2, y + h - fy - 1, 2); )
         : ( fy = x + w * frac; ui_cola(v5_fcap, 0.18); v5_rr(x, y - 3, fy - x, h + 6, 4); ui_col(v5_fcap); v5_rr(x + 1, y + 1, fy - x - 1, h - 2, 2); );
  );
);
function v5_fscale(x, y, len, vert) local(i) (
  i = 0; loop(5, ui_col(v5_ink); vert ? v5_d(x, y + i * len / 4, i == 0 || i == 4 || i == 2 ? 1.8 : 1.2) : v5_d(x + i * len / 4, y, i == 0 || i == 4 || i == 2 ? 1.8 : 1.2); i += 1; );
);
function v5_capB(cx, cy, vert, act) local(w, h, x, y) (
  w = vert ? 34 : 18; h = vert ? 18 : 34; x = cx - w / 2; y = cy - h / 2;
  v5_shr(x, y, w, h, 4);
  ui_col(0x0A0B0B); v5_rr(x, y, w, h, 4);
  ui_col(act ? 0x3E4346 : 0x34383A); v5_rr(x + 1, y + 1, w - 2, h - 2, 4);
  ui_cola(0xFFFFFF, 0.10); v5_r(x + 3, y + 2, w - 6, 1);
  ui_col(v5_fcap); vert ? v5_rr(x + 4, cy - 1.5, w - 8, 3, 1.5) : v5_rr(cx - 1.5, y + 4, 3, h - 8, 1.5);
  ui_cola(v5_fcap, 0.25); vert ? v5_rr(x + 2, cy - 4, w - 4, 8, 4) : v5_rr(cx - 4, y + 2, 8, h - 4, 4);
);
function v5_capC(cx, cy, vert, act) local(w, h, x, y) (
  w = vert ? 28 : 16; h = vert ? 16 : 28; x = cx - w / 2; y = cy - h / 2;
  v5_shr(x, y, w, h, 7);
  ui_col(0x3E4245); v5_rr(x, y, w, h, 7);
  ui_col(act ? 0x63676B : 0x55595D); v5_rr(x + 1, y + 1, w - 2, h - 3, 7);
  ui_cola(0xFFFFFF, 0.14); v5_rr(x + 3, y + 2, w - 6, 3, 2);
  ui_col(0xF4F2EC); vert ? v5_r(x + 5, cy - 0.75, w - 10, 1.5) : v5_r(cx - 0.75, y + 5, 1.5, h - 10);
);
function v5_fader(x, y, len, vert, idx, vmin, vmax, vdef, lg, sty, label, fmt) local(n, cx, cy) (
  n = v5_ctl(idx, vmin, vmax, vdef, lg, vert ? v5_hit(x - 20, y - 12, 40, len + 24) : v5_hit(x - 12, y - 20, len + 24, 40), !vert, len);
  vert ? (
    v5_fscale(x - 26, y, len, 1);
    sty == 0 ? v5_slot(x - 3, y, 6, len, 1, n, 1) : v5_slot(x - 2.5, y, 5, len, 0, 0, 1);
    cy = y + len * (1 - n);
    sty == 0 ? v5_capB(x, cy, 1, v5_act) : v5_capC(x, cy, 1, v5_act);
    v5_label(x, y + len + 30, label, idx, fmt);
  ) : (
    v5_fscale(x, y - 24, len, 0);
    sty == 0 ? v5_slot(x, y - 3, len, 6, 1, n, 0) : v5_slot(x, y - 2.5, len, 5, 0, 0, 0);
    cx = x + len * n;
    sty == 0 ? v5_capB(cx, y, 0, v5_act) : v5_capC(cx, y, 0, v5_act);
    v5_label(x + len / 2, y + 34, label, idx, fmt);
  );
);

function v5_keycap(x, y, w, h, dn, body, top, ink, lg, led) local(t, s, b, o) (
  o = dn ? 2.5 : 0; t = 3 + o; s = 5; b = 8 - o;
  v5_shr(x, y + o, w, h - o, 5);
  ui_col(ui_mix(body, 0, 0.55)); v5_rr(x, y + o, w, h - o, 5);
  ui_col(ui_mix(body, 0xFFFFFF, 0.10)); v5_q(x + 1, y + 1 + o, x + w - 1, y + 1 + o, x + w - s, y + t, x + s, y + t);
  ui_col(ui_mix(body, 0xFFFFFF, 0.04)); v5_q(x + 1, y + 1 + o, x + s, y + t, x + s, y + h - b, x + 1, y + h - 1);
  ui_col(ui_mix(body, 0, 0.22)); v5_q(x + w - 1, y + 1 + o, x + w - 1, y + h - 1, x + w - s, y + h - b, x + w - s, y + t);
  ui_col(ui_mix(body, 0, 0.32)); v5_q(x + 1, y + h - 1, x + s, y + h - b, x + w - s, y + h - b, x + w - 1, y + h - 1);
  ui_col(top); v5_rr(x + s, y + t, w - 2 * s, h - t - b, 4);
  ui_cola(0, 0.07); v5_rr(x + s + 3, y + t + 3, w - 2 * s - 6, h - t - b - 6, 4);
  ui_cola(0xFFFFFF, 0.14); v5_r(x + s + 3, y + t + 1, w - 2 * s - 6, 1);
  led >= 0 ? ( ui_col(0x050606); v5_d(x + s + 7, y + t + 7, 3.4); ui_col(led ? v5_am : ui_mix(v5_am, 0x111111, 0.78)); v5_d(x + s + 7, y + t + 7, 2.5);
    led ? ( ui_cola(v5_am, 0.25); v5_d(x + s + 7, y + t + 7, 6); ); );
  gfx_setfont(v5_fk); ui_col(ink); v5_t(x + w / 2 + (led >= 0 ? 4 : 0), y + t + (h - t - b) / 2 + 1, lg);
);
function v5_lowpro(x, y, w, h, dn, lg) local(o) (
  o = dn ? 1.5 : 0;
  v5_shr(x, y + o, w, h - o, 3);
  ui_col(0x0A0B0B); v5_rr(x, y + o, w, h - o, 3);
  ui_col(dn ? 0x2A2D2F : 0x323638); v5_rr(x + 1, y + 1 + o, w - 2, h - 3 - o, 3);
  ui_cola(0xFFFFFF, 0.08); v5_r(x + 3, y + 2 + o, w - 6, 1);
  dn ? ( ui_cola(v5_led, 0.22); v5_r(x + 6, y + h - 7, w - 12, 4); ui_col(v5_led); v5_r(x + 8, y + h - 6, w - 16, 2); )
     : ( ui_col(ui_mix(v5_led, 0x0A0B0B, 0.8)); v5_r(x + 8, y + h - 6, w - 16, 2); );
  gfx_setfont(v5_fk); ui_col(dn ? 0xF6F8F4 : v5_cr); v5_t(x + w / 2, y + (h - 6) / 2 + o, lg);
);
function v5_pad(x, y, w, h, on, lg) local(i) (
  v5_shr(x, y, w, h, 6);
  ui_col(0x050606); v5_rr(x, y, w, h, 6);
  gfx_setfont(v5_fk);
  on ? (
    ui_col(ui_mix(v5_led, 0, 0.45)); v5_rr(x + 3, y + 3, w - 6, h - 6, 4);
    i = 0; loop(8, ui_cola(ui_mix(v5_led, 0xF0FFF0, i / 8 * 0.45), 0.35); v5_rr(x + 4 + i * 1.3, y + 4 + i * 1.1, w - 8 - i * 2.6, h - 8 - i * 2.2, 4); i += 1; );
    ui_cola(v5_led, 0.15); v5_rr(x - 4, y - 4, w + 8, h + 8, 9);
    ui_col(ui_mix(v5_led, 0, 0.8)); v5_t(x + w / 2, y + h / 2 + 0.5, lg);
  ) : (
    ui_col(ui_mix(v5_led, 0x0A0B0B, 0.85)); v5_rr(x + 3, y + 3, w - 6, h - 6, 4);
    ui_cola(0xFFFFFF, 0.06); v5_rr(x + 4, y + 4, w - 8, (h - 8) * 0.45, 3);
    ui_col(ui_mix(v5_cr, 0x1A2A20, 0.15)); v5_t(x + w / 2, y + h / 2 + 0.5, lg);
  );
);
function v5_strip(x, y, w, h, on, lg) (
  v5_shr(x, y, w, h, 4);
  ui_col(0x0A0B0B); v5_rr(x, y, w, h, 4);
  ui_col(0x2E3233); v5_rr(x + 1, y + 1, w - 2, h - 2, 4);
  ui_col(0x26292A); v5_rr(x + 1, y + h * 0.5, w - 2, h * 0.5 - 1, 4);
  ui_cola(0xFFFFFF, 0.09); v5_r(x + 5, y + 2, w - 10, 1);
  ui_col(0x050606); v5_rr(x + 8, y + 6, w - 16, 5, 2.5);
  on ? ( ui_cola(v5_led, 0.25); v5_rr(x + 5, y + 3, w - 10, 11, 5); ui_col(v5_led); v5_rr(x + 9, y + 7, w - 18, 3, 1.5); )
     : ( ui_col(ui_mix(v5_led, 0x0A0B0B, 0.75)); v5_rr(x + 9, y + 7, w - 18, 3, 1.5); );
  gfx_setfont(v5_fk); ui_col(v5_cr); v5_t(x + w / 2, y + h * 0.64, lg);
);
function v5_ring(cx, cy, r, on, lg) local(i) (
  on ? ( i = 0; loop(5, ui_cola(v5_led, 0.07); v5_d(cx, cy, r + 9 - i * 1.4); i += 1; ); );
  v5_shc(cx, cy, r + 3);
  ui_col(0x050606); v5_d(cx, cy, r + 3);
  ui_col(on ? v5_led : ui_mix(v5_led, 0x0A0B0B, 0.75)); v5_arc(cx, cy, r + 1.2, -$pi, $pi, 2.2);
  ui_col(0x262A2B); v5_d(cx, cy, r - 1);
  v5_vig(cx, cy, r - 1);
  ui_cola(0xFFFFFF, 0.12); v5_arc(cx, cy, r * 0.7, -1.9, -0.5, 1.2);
  gfx_setfont(v5_fk); ui_col(v5_ink); v5_t(cx, cy + r + 18, lg);
);
function v5_edge(x, y, w, h, on, lg, lc) local(dn) (
  dn = on ? 1.5 : 0;
  v5_shr(x, y, w, h, 4);
  ui_col(0x0A0B0B); v5_rr(x, y, w, h, 4);
  ui_col(0x6E7274); v5_rr(x + 1, y + 1 + dn, w - 2, h - 2 - dn, 4);
  ui_cola(0xFFFFFF, 0.12); v5_r(x + 5, y + 2 + dn, w - 10, 1);
  on ? (
    ui_cola(lc, 0.25); v5_rr(x + 3, y + 3 + dn, w - 6, h - 6 - dn, 4);
    ui_col(lc); v5_rr(x + 4, y + 4 + dn, w - 8, h - 8 - dn, 3);
    ui_col(0x777B7D); v5_rr(x + 6, y + 6 + dn, w - 12, h - 12 - dn, 2);
  ) : (
    ui_col(ui_mix(lc, 0x1A1C1C, 0.78)); v5_rr(x + 4, y + 4, w - 8, h - 8, 3);
    ui_col(0x6E7274); v5_rr(x + 6, y + 6, w - 12, h - 12, 2);
    ui_cola(0, 0.15); v5_r(x + 4, y + h - 3, w - 8, 1.5);
  );
  strlen(lg) ? ( gfx_setfont(v5_fk); ui_col(on ? 0xF6F8F4 : v5_cr); v5_t(x + w / 2, y + h / 2 + dn * 0.5, lg); );
);

function v5_key(x, y, w, h, idx, sty, lg) local(on, hit) (
  hit = sty == 2 ? v5_hitc(x, y, w + 4) : v5_hit(x, y, w, h);
  on = v5_toggle(idx, hit);
  sty == 0 ? v5_pad(x, y, w, h, on, lg) :
  sty == 1 ? v5_strip(x, y, w, h, on, lg) :
  sty == 2 ? v5_ring(x, y, w, on, lg) :
  sty == 3 ? v5_edge(x, y, w, h, on, lg, v5_led) :
  sty == 4 ? v5_keycap(x, y, w, h, on, 0x3A3E41, 0x4A4F53, on ? v5_am : v5_cr, lg, -1) :
  sty == 5 ? v5_keycap(x, y, w, h, on, 0xCFC6AE, 0xE6DEC6, 0x2B2620, lg, -1) :
  sty == 6 ? v5_keycap(x, y, w, h, on, 0x8C8678, 0xA49E8E, 0xF4EEDC, lg, -1) :
  v5_lowpro(x, y, w, h, on, lg);
);

function v5_small(x, y, idx, lg) local(on) (
  on = v5_toggle(idx, v5_hit(x, y, 30, 30));
  v5_edge(x, y, 30, 30, on, "", v5_rd);
  strlen(lg) ? ( gfx_setfont(v5_fk); ui_col(v5_ink); v5_t(x + 15, y + 46, lg); );
);

function v5_byp(x, y, w, h, idx, sty) local(on, k) (
  on = v5_toggle(idx, v5_hit(x, y, w, h));
  sty == 0 ? v5_keycap(x, y, w, h, on, 0x3A3E41, 0x4A4F53, v5_cr, "BYPASS", on) : (
    on ? ( ui_cola(v5_rd, 0.18); v5_rr(x - 5, y - 5, w + 10, h + 10, 10); );
    v5_shr(x, y, w, h, 8); ui_col(0x0A0B0B); v5_rr(x - 1, y - 1, w + 2, h + 2, 9);
    ui_col(on ? 0xE2402A : 0x5A2620); v5_rr(x, y, w, h, 8);
    on ? ( k = 0; loop(6, ui_cola(0xFFD0B0, 0.10); v5_rr(x + 6 + k * 3, y + 4 + k * 2, w - 12 - k * 6, h - 8 - k * 4, 6); k += 1; ); )
       : ( ui_cola(0xFFFFFF, 0.06); v5_rr(x + 4, y + 2, w - 8, h * 0.35, 6); );
    gfx_setfont(v5_fk); ui_col(on ? 0x3A0E08 : 0xC89A90); v5_t(x + w / 2, y + h / 2, "BYPASS");
  );
);

function v5_part(s, k) local(i, n, c, st, l) (
  i = 0; n = 0; st = 0; l = strlen(s);
  while (i <= l && n <= k) (
    c = i < l ? str_getchar(s, i) : '|';
    c == '|' ? ( n == k ? strcpy_substr(#v5_pt, s, st, i - st); n += 1; st = i + 1; );
    i += 1;
  );
  #v5_pt;
);
function v5_sel(x, y, w, h, gap, idx, n, labels, sty) local(k, kx, cur) (
  cur = floor(slider(idx) + 0.5);
  k = 0;
  loop(n, kx = x + k * (w + gap);
    v5_pr && v5_drag == 0 && v5_hit(kx, y, w, h) && cur != k ? ( slider(idx) = k; ui_auto(idx); cur = k; v5_drag = -1; );
    v5_part(labels, k);
    sty == 0 ? v5_keycap(kx, y, w, h, k == cur, 0xCFC6AE, 0xE6DEC6, 0x2B2620, #v5_pt, k == cur) :
    sty == 1 ? v5_keycap(kx, y, w, h, k == cur, 0x3A3E41, 0x4A4F53, k == cur ? v5_am : v5_cr, #v5_pt, k == cur) :
               v5_lowpro(kx, y, w, h, k == cur, #v5_pt);
    k += 1; );
);
