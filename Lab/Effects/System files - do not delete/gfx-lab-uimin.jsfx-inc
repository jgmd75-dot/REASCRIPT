//author: JGWizrad / Garden FX (GFX)
//
// gfx-uimin - the two gfx-ui helpers that the FX engines' panel code calls (gfx-bverb's seven-segment text and
// parameter table): ui_col and ui_auto, the same as in gfx-ui. For a unit that imports gfx-bverb / gfx-bdelay
// but draws its own faceplate instead of importing gfx-ui. Import it before gfx-bverb. Never import it together
// with gfx-ui (the names would clash).
@init

function ui_col(c) (
  gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = 1;
);
function ui_auto(idx) ( idx <= 63 ? slider_automate(2 ^ (idx - 1)); );
