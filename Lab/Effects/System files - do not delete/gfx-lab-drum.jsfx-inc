desc:GFX drum machine panel parts (include)
//author: JGWizrad / Garden FX (GFX)
//
// The shared look of the GFX drum machines (Pulse family): the header, the voice matrix (a colour tab per
// voice, the step grid, the voice's knobs on a band in its colour) and memory-bound mini knobs.
// Import after gfx-ui and gfx-panel. All coordinates are unscaled (multiplied by sc inside).
//
//   dr_vcol(v)                                  voice colour (15 distinct)
//   dr_header(name, sub, ink, panel, accent, w)  GFX badge, name, subtitle, the accent rule under the header
//   dr_tab(x, y, w, h, col, name, sub, lit, sel) a voice's row tab; returns 1 when clicked (play it / select it)
//   dr_cell(x, y, w, h, val, col, play, on)      a step: 0 off, 1 hit, 2 accent; play = the playhead is here
//   dr_band(x, y, w, h, col, hot)                the tinted band behind a row's knobs
//   dr_mknob(cx, cy, ptr, lo, hi, def, lg, step, fmt, id)
//                                                a mini knob on a memory value (drag, wheel, double-click resets);
//                                                shows the value while touched; returns 1 while changing
//   dr_klabel(cx, y, s)                          a small label under / over a mini knob

@init

// skin (a plugin may change these before drawing): tab, selected tab, ink, step cell on-beat / off-beat
dr_tabc = 0x2A2B30; dr_tabs = 0x3A3C42; dr_ink = 0xE8E6E0; dr_c0 = 0x34353B; dr_c1 = 0x24252A; dr_hl = 0xFFFFFF;

function dr_vcol(v) (
  v == 0 ? 0xE0603A : v == 1 ? 0xE8B23A : v == 2 ? 0xD8D25A : v == 3 ? 0x6FCB7A : v == 4 ? 0x4FB8B0 :
  v == 5 ? 0x4A9AD8 : v == 6 ? 0x8E7AE0 : v == 7 ? 0xD070B8 : v == 8 ? 0xE07A7A : v == 9 ? 0xC8A060 :
  v == 10 ? 0x9CCB5A : v == 11 ? 0x5AC8D8 : v == 12 ? 0x7A8EE0 : v == 13 ? 0xC07AE0 : 0xB0B4BA;
);

function dr_header(name, sub, ink, panel, accent, w) local(tw, th) (
  ui_col(ink); gfx_circle(40 * sc, 38 * sc, 14 * sc, 1, 1);
  gfx_setfont(4); ui_col(panel); ui_text(40 * sc, 33 * sc, "GFX");
  gfx_setfont(6, "Trebuchet MS", 24 * sc, 'b'); ui_col(ink); gfx_x = 62 * sc; gfx_y = 24 * sc; gfx_drawstr(name);
  gfx_measurestr(name, tw, th);
  gfx_setfont(4); ui_cola(ink, 0.6); gfx_x = 62 * sc + tw + 10 * sc; gfx_y = 34 * sc; gfx_drawstr(sub);
  ui_col(accent); gfx_rect(14 * sc, 70 * sc, (w - 28) * sc, 3 * sc);
);

function dr_tab(x, y, w, h, col, name, sub, lit, sel) local(inb, hit, tw, th) (
  inb = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = pressed && drag_id == 0 && inb; hit ? drag_id = -1;
  ui_col(sel ? dr_tabs : dr_tabc); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  ui_col(col); gfx_rect(x * sc, y * sc, 4 * sc, h * sc);
  lit > 0.05 ? ( ui_cola(col, lit * 0.45); gfx_rect((x + 4) * sc, y * sc, (w - 4) * sc, h * sc); );
  inb && !mdown ? ( ui_cola(dr_hl, 0.06); gfx_rect((x + 4) * sc, y * sc, (w - 4) * sc, h * sc); );
  gfx_setfont(2); ui_col(dr_ink); gfx_measurestr(name, tw, th);
  gfx_x = (x + 12) * sc; gfx_y = y * sc + (h * sc - th) * 0.5; gfx_drawstr(name);
  strlen(sub) > 0 ? ( gfx_setfont(4); ui_col(dr_ink < 0x808080 ? ui_mix(col, dr_ink, 0.5) : col); gfx_measurestr(sub, tw, th);
    gfx_x = (x + w - 8) * sc - tw; gfx_y = y * sc + (h * sc - th) * 0.5; gfx_drawstr(sub); );
  hit;
);

function dr_cell(x, y, w, h, val, col, play, on) (
  ui_col(on ? dr_c0 : dr_c1); ui_rrect(x * sc, y * sc, w * sc, h * sc, 3 * sc);
  val > 0 ? (
    ui_cola(col, val == 2 ? 1 : 0.62); ui_rrect((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, 2 * sc);
    val == 2 ? ( ui_col(0xFFFFFF); gfx_rect((x + 3) * sc, (y + 3) * sc, (w - 6) * sc, 2.5 * sc); );
  );
  play ? ( ui_cola(0xFFFFFF, val > 0 ? 0.5 : 0.16); ui_rrect(x * sc, y * sc, w * sc, h * sc, 3 * sc); );
);

function dr_band(x, y, w, h, col, hot) (
  ui_cola(col, hot ? 0.3 : 0.14); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  ui_col(col); gfx_rect((x + w - 3) * sc, (y + 3) * sc, 3 * sc, (h - 6) * sc);
);

function dr_klabel(cx, y, s) ( gfx_setfont(4); ui_cola(dr_ink, 0.62); ui_text(cx * sc, y * sc, s); );

function dr_mknob(cx, cy, ptr, lo, hi, def, lg, step, fmt, id) local(r, v, n, a1, dx, dy, hover, act, ch) (
  r = 10 * sc; v = ptr[0]; ch = 0;
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc;
  hover = dx * dx + dy * dy <= (r + 5 * sc) * (r + 5 * sc);
  pressed && hover && drag_id == 0 ? (
    time_precise() - dr_lct < 0.35 && dr_lid == id ? ( ptr[0] = def; drag_id = -1; dr_lct = 0; ch = 1; ) : (
      drag_id = 5000 + id; dr_dy = mouse_y; dr_lct = time_precise(); dr_lid = id;
      dr_dn = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    );
  );
  drag_id == 5000 + id ? (
    dr_dn = min(max(dr_dn + (dr_dy - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1); dr_dy = mouse_y;
    v = lg ? lo * (hi / lo) ^ dr_dn : lo + dr_dn * (hi - lo);
    step > 0 ? v = lo + floor((v - lo) / step + 0.5) * step;
    ptr[0] != v ? ( ptr[0] = v; ch = 1; );
  );
  hover && mouse_wheel != 0 && drag_id == 0 ? (
    step > 0 ? v = min(max(v + sign(mouse_wheel) * step, lo), hi) : (
      n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
      n = min(max(n + mouse_wheel / 120 * 0.03, 0), 1); v = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo);
    );
    ptr[0] = v; mouse_wheel = 0; ch = 1;
  );
  v = ptr[0]; n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  a1 = -0.75 * $pi + n * 1.5 * $pi;
  act = hover || drag_id == 5000 + id;
  ui_knob_6a(cx * sc, cy * sc, r, a1, n, act);
  act ? ( gfx_setfont(4); ui_col(0xFFFFFF); sprintf(#dr_kv, fmt, v); ui_text(cx * sc, (cy + 13) * sc, #dr_kv); );
  ch;
);
