desc:GFX Lab Sidebar - the SIDEBAR peak saturation (include)
//author: JGWizrad / Garden FX (GFX)

@init
SB_PAD = 0.12589254117941673; SB_RST = 1 / SB_PAD;
function sb_sat(x) ( x / sqrt(1 + x * x); );
function sb_rate(fs) local(w) (
  sb_fs = fs; w = 2 * $pi / fs;
  sb_dcc = 1 - 5 * w; sb_lpk = 1 - exp(-15000 * w); sb_ha = exp(-exp(sb_fz) * w);
);
function sb_target(hr_db, amt, on, tone, hb) (
  sb_tt = exp((-36 + hr_db) * 0.11512925464970228) / max(hb, 0.1);
  sb_gt = max(amt, 0) * (on >= 0.5);
  sb_fzt = log(min(max(tone, 22), 2200));
);
function sb_snap() ( sb_t = sb_tt; sb_g = sb_gt; sb_fz = sb_fzt; sb_ha = exp(-2 * $pi * exp(sb_fz) / sb_fs); );
function sb_glide(kk, ks) ( sb_t += (sb_tt - sb_t) * kk; sb_g += (sb_gt - sb_g) * ks; sb_tp = sb_t * 0.88; sb_tn = sb_t * 1.12; );
function sb_ctl(k) ( sb_fz += (sb_fzt - sb_fz) * k; sb_ha = exp(-2 * $pi * exp(sb_fz) / sb_fs); );
function sb_run(x) instance(dx, dy, hx, hy, lp) local(p, a, t, d) (
  p = x * SB_PAD; a = abs(p);
  t = p >= 0 ? sb_tp : sb_tn;
  d = a > t ? ( (t + t * sb_sat((a - t) / t)) * (p >= 0 ? 1 : -1) - p ) : 0;
  d *= SB_RST;
  dy = d - dx + sb_dcc * dy; dx = d;
  hy = sb_ha * (hy + dy - hx); hx = dy;
  lp += (hy - lp) * sb_lpk;
  abs(lp) < 0.000000000001 ? lp = 0;
  d = lp * sb_g; sb_pk = max(sb_pk, abs(d));
  d;
);
function sb_clr() instance(dx, dy, hx, hy, lp) ( dx = dy = hx = hy = lp = 0; );
