desc:GFX Parameter sliders switch (include)

@init
psw_last = -1;

function psw_font(fnt, s) local(w, h) (
  gfx_setfont(fnt, "Trebuchet MS", 100, 'b');  gfx_measurestr("THRESHOLD", w, h);
  psw_fk = w > 0 ? 528 / w : 1;
  gfx_setfont(fnt, "Trebuchet MS", 16 * s * psw_fk, 'b');
);

function psw_row(cx, y, s, fnt, clk, on) local(q, w, h, tw1, tw2, th, pw, ph, px, kx, ky, lx, ly, r) (
  psw_font(fnt, s);
  gfx_measurestr("SLIDERS", tw1, th);  gfx_measurestr("SHOW ALL", tw2, th);
  q = 24 * s;  w = tw1 + 28 * s + q + 16 * s + 13 * s + 12 * s + tw2;
  pw = w + 56 * s;  ph = 48 * s;  px = cx - pw * 0.5;
  gfx_set(0.075, 0.078, 0.086, 1);  gfx_rect(px, y, pw, ph);
  gfx_set(0, 0, 0, 0.55);  gfx_rect(px, y, pw, max(1, 2 * s));  gfx_rect(px, y + 2 * s, max(1, 2 * s), ph - 2 * s);
  gfx_set(1, 1, 1, 0.10);  gfx_rect(px + 2 * s, y + ph - max(1, s), pw - 2 * s, max(1, s));  gfx_rect(px + pw - max(1, s), y + 2 * s, max(1, s), ph - 3 * s);
  kx = cx - w * 0.5;  ky = y + (ph - q) * 0.5 - 1 * s;
  gfx_set(0.95, 0.95, 0.93, 1);  gfx_x = kx;  gfx_y = y + (ph - th) * 0.5;  gfx_drawstr("SLIDERS");
  kx += tw1 + 28 * s;
  lx = kx + q + 16 * s;  ly = ky + q * 0.5 + 2 * s;
  gfx_set(0, 0, 0, 0.13);  gfx_rect(kx + 2 * s, ky + 5 * s, q, q);
  gfx_set(0.02, 0.02, 0.024, 1);  gfx_rect(kx - s, ky + s, q + 2 * s, q + 2 * s);
  on ? gfx_set(0.54, 0.55, 0.565, 1) : gfx_set(0.61, 0.62, 0.635, 1);
  gfx_rect(kx + s, ky + (on ? 4 : 3) * s, q - 2 * s, q - (on ? 3 : 2) * s);
  on ? ( gfx_set(1, 0.23, 0.16, 0.22);  gfx_circle(lx, ly, 9 * s, 1, 1); );
  gfx_set(0.02, 0.02, 0.024, 1);  gfx_circle(lx, ly, 6.5 * s, 1, 1);
  on ? gfx_set(1, 0.23, 0.16, 1) : gfx_set(0.35, 0.08, 0.06, 1);  gfx_circle(lx, ly, 4.8 * s, 1, 1);
  on ? ( gfx_set(1, 1, 1, 0.55);  gfx_circle(lx - 1.4 * s, ly - 1.4 * s, 1.4 * s, 1, 1); );
  gfx_set(0.95, 0.95, 0.93, 1);  gfx_x = lx + 13 * s + 12 * s;  gfx_y = y + (ph - th) * 0.5;  gfx_drawstr("SHOW ALL");
  r = -1;
  clk && mouse_x >= kx - 3 * s && mouse_x < lx + 13 * s + 12 * s + tw2 && mouse_y >= y && mouse_y < y + ph ? r = !on;
  r;
);
