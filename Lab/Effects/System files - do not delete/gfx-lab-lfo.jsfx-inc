desc:GFX LFO (include)
//author: JGWizrad / Garden FX (GFX)

@init

function lfo_tanh(x) local(e) (
  x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1);
);

function lfo_shape_k(p, shp, k, tk) (
  shp == 0 ? sin(2 * $pi * p) : (
    shp == 1 ? ( p < 0.25 ? 4 * p : ( p < 0.75 ? 2 - 4 * p : 4 * p - 4 ) )
             : lfo_tanh(k * sin(2 * $pi * p)) / tk;
  );
);

function lfo_div_q(i) local(barq) (
  barq = ts_denom > 0 ? ts_num * 4 / ts_denom : 4;
  i == 0 ? 4 * barq : i == 1 ? 2 * barq : i == 2 ? barq :
  i == 3 ? 2 : i == 4 ? 3 : i == 5 ? 4 / 3 :
  i == 6 ? 1 : i == 7 ? 1.5 : i == 8 ? 2 / 3 :
  i == 9 ? 0.5 : i == 10 ? 0.75 : i == 11 ? 1 / 3 :
  i == 12 ? 0.25 : i == 13 ? 0.375 : i == 14 ? 1 / 6 : 0.125;
);

function lfo_shape_d(p, shp, k, tk) local(x, e) (
  shp == 0 ? sin(2 * $pi * p) : (
    shp == 1 ? ( p < 0.25 ? 4 * p : ( p < 0.75 ? 2 - 4 * p : 4 * p - 4 ) )
             : ( x = min(max(k * sin(2 * $pi * p), -20), 20); e = exp(2 * x); (e - 1) / (e + 1) / tk; );
  );
);

function lfo_div_name(i) (
  i == 0 ? "4 BARS" : i == 1 ? "2 BARS" : i == 2 ? "1 BAR" :
  i == 3 ? "1/2" : i == 4 ? "1/2 D" : i == 5 ? "1/2 T" :
  i == 6 ? "1/4" : i == 7 ? "1/4 D" : i == 8 ? "1/4 T" :
  i == 9 ? "1/8" : i == 10 ? "1/8 D" : i == 11 ? "1/8 T" :
  i == 12 ? "1/16" : i == 13 ? "1/16 D" : i == 14 ? "1/16 T" : "1/32";
);

function lfo_init() instance(ph, p, lastp, ra, rb, v) (
  ph = 0; p = 0; lastp = 0; ra = rand(2) - 1; rb = rand(2) - 1; v = 0;
);

function lfo_setup(shp, smooth) instance(shape, sm, k, tk) (
  shape = shp; sm = smooth;
  k = 1 + 49 * (1 - smooth) ^ 2;
  tk = lfo_tanh(k);
);

function lfo_block(sync, div, frate) instance(syncm, rate, inc, ph) local(lenq) (
  syncm = sync; rate = frate;
  sync ? (
    lenq = lfo_div_q(div);
    sync == 1 && (play_state & 1) ? ( ph = beat_position / lenq; ph -= floor(ph); );
    inc = tempo / 60 / lenq / srate;
  );
);

function lfo_tick(phoff, rd, dv)
  instance(syncm, rate, inc, ph, p, lastp, ra, rb, shape, sm, k, tk, v) local(f) (
  syncm ? (
    ph += inc;
    p = ph + phoff + rd * 0.5 * dv;
  ) : (
    ph += rate * (1 + rd * dv) / srate;
    p = ph + phoff;
  );
  ph -= floor(ph);
  p -= floor(p);
  shape == 3 ? (
    p < lastp - 0.5 ? ( ra = rb; rb = rand(2) - 1; );
    f = sm > 0.001 ? min(p / sm, 1) : 1;
    v = ra + (rb - ra) * (0.5 - 0.5 * cos($pi * f));
  ) : (
    v = lfo_shape_k(p, shape, k, tk);
  );
  lastp = p;
  v;
);
