desc:GFX synth voice engine (include)
//author: JGWizrad / Garden FX (GFX)
//
// Shared synth building blocks for the GFX instruments (Bass, Leads, Pads, Strings).
// All stateful parts are instance functions: give each voice / oscillator its own namespace,
// e.g.  o1.vo_saw(inc);  flt.vo_ladder(x);  aenv.vo_adsr();
//
//   vo_tanh(x)                       cheap soft clip (rational tanh)
//   vo_coef(ms)                      one-pole coefficient that settles in about ms milliseconds
//   o.vo_saw(inc)                    band-limited saw, inc = freq / srate (returns -1..1)
//   o.vo_pulse(inc, pw)              band-limited pulse, pw 0.05..0.95
//   o.vo_sub(inc, div)               band-limited square at freq / div (div 2 or 4), own phase
//   o.vo_reset(ph)                   set an oscillator's phase
//   f.vo_ladder(x, fc, res, kind)    24 dB ladder: kind 0 = warm (bass drops with resonance, classic ladder),
//                                    kind 1 = acid (sharper, bass kept, 101-ish). res 0..1 (self-oscillates near 1)
//   f.vo_svf(x, fc, res)             12 dB state-variable low-pass, res 0..1
//   e.vo_adsr_set(a_ms, d_ms, s, r_ms)   e.vo_adsr_gate(on, retrig)   e.vo_adsr()  -> 0..1
//   l.vo_lfo(rate_hz, shape)         shape 0 sine, 1 triangle, 2 saw, 3 square, 4 sample & hold (-1..1)

@init

function vo_tanh(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function vo_coef(ms) ( 1 - exp(-4.6 / (max(ms, 0.05) * 0.001 * srate)); );

function vo_blep(t, dt) (
  t < dt ? ( t /= dt; 2 * t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + 2 * t + 1; ) : 0;
);

function vo_reset(p) instance(ph) ( ph = p; );

function vo_saw(inc) instance(ph) local(y) (
  ph += inc; ph -= floor(ph);
  y = 2 * ph - 1 - vo_blep(ph, inc);
  y;
);

function vo_pulse(inc, pw) instance(ph) local(y, p2) (
  ph += inc; ph -= floor(ph);
  p2 = ph + 1 - pw; p2 -= floor(p2);
  y = (2 * ph - 1 - vo_blep(ph, inc)) - (2 * p2 - 1 - vo_blep(p2, inc));
  y;                              // the difference of two saws has no DC for any width
);

function vo_sub(inc, div) instance(ph) local(d, p2) (
  d = inc / div;
  ph += d; ph -= floor(ph);
  p2 = ph + 0.5; p2 -= floor(p2);
  (2 * ph - 1 - vo_blep(ph, d)) - (2 * p2 - 1 - vo_blep(p2, d));
);

function vo_ladder(x, fc, res, kind) instance(s1, s2, s3, s4) local(g, k, u) (
  g = 1 - exp(-2 * $pi * min(fc, srate * 0.45) / srate);
  g = min(g, 0.92);
  k = kind == 1 ? res * 4.3 : res * 4;
  u = kind == 1 ? x - vo_tanh(k * s4) : vo_tanh(x - k * s4);
  s1 += g * (u - s1);
  s2 += g * (s1 - s2);
  s3 += g * (s2 - s3);
  kind == 1 ? s4 += g * (vo_tanh(s3) - s4) : s4 += g * (s3 - s4);
  s4 * (kind == 1 ? 1 + 0.5 * k : 1 + 0.3 * k);      // make-up for the resonance's bass loss
);

function vo_svf(x, fc, res) instance(ic1, ic2) local(g, k, a1, a2, a3, v1, v2, v3) (
  g = tan($pi * min(fc, srate * 0.45) / srate);
  k = 2 - 1.95 * res;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  vo_tanh(v2);
);

function vo_adsr_set(a, d, s, r) instance(ac, dc, sl, rc) (
  ac = vo_coef(a); dc = vo_coef(d); sl = s; rc = vo_coef(r);
);
// retrig = 0 keeps the current level (legato: no new attack)
function vo_adsr_gate(on, retrig) instance(st, lv) (
  on ? ( retrig || st == 0 || st == 3 ? st = 1; ) : ( st > 0 ? st = 3; );
);
function vo_adsr() instance(st, lv, ac, dc, sl, rc) (
  st == 1 ? ( lv += (1.3 - lv) * ac; lv >= 1 ? ( lv = 1; st = 2; ); ) :
  st == 2 ? ( lv += (sl - lv) * dc; ) :
  st == 3 ? ( lv += (0 - lv) * rc; lv < 0.00002 ? ( lv = 0; st = 0; ); );
  lv;
);

function vo_lfo(rate, shape) instance(ph, sh) local(y) (
  ph += rate / srate;
  ph >= 1 ? ( ph -= floor(ph); sh = rand(2) - 1; );
  y = shape == 0 ? sin(2 * $pi * ph) :
      shape == 1 ? 1 - 4 * abs(ph - 0.5) :
      shape == 2 ? 2 * ph - 1 :
      shape == 3 ? (ph < 0.5 ? 1 : -1) : sh;
  y;
);
