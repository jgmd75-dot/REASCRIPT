desc:Tower V5 [tape keyboard] (GFX Lab)
//tags: instrument tape replay keyboard choir strings flute organ tonewheel combo pipes wow flutter vintage arcana
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider22:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Choir
slider2:1<0,1,1{Off,On}>-Strings
slider3:0<0,1,1{Off,On}>-Flutes
slider4:0<0,1,1{Off,On}>-Organ
slider5:100<0,100,0.1>-Choir level (%)
slider6:100<0,100,0.1>-Strings level (%)
slider7:100<0,100,0.1>-Flutes level (%)
slider8:100<0,100,0.1>-Organ level (%)
slider9:0<0,2,1{Tonewheel,Combo,Pipes}>-Organ tape
slider10:8<8,16,0.01>-Length (s)
slider11:35<0,100,0.1>-Wobble (%)
slider12:25<0,100,0.1>-Age (%)
slider13:0<-100,100,0.1>-Tone (dark .. bright, %)
slider14:0.15<0.03,3,0.001:log>-Release (s)
slider15:20<-10,40,0.1>-Temperature (C)
slider16:45<10,95,0.1>-Humidity (%)
slider17:30<0,100,1>-Touch (velocity, %)
slider18:0<-24,6,0.1>-Volume (dB)
slider19:1<0,1,1{Low,Normal}>-Fate
slider20:0<0,16,1>-MIDI channel (0 = omni)
slider21:prs_sel=0<0,14,1{No preset,Init,Three Violins,Choir Aah,Flute Tape,Tonewheel Tape,Combo Tape,Pipe Tape,Long Strip Strings,Cold Room Flutes,Damp Cellar Choir,Worn Copy,Strings and Flutes,Choir and Organ,Summer Heat}>-Preset

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(4194303, v); );
function psw_allg(v) ( slider_show(4194303, v); );
#ui_man = "gfx-lab-g-tower-v5";
ext_noinit = 1;

NV = 16; VS = 128; VOX = 0;
KP = 3000; KS = 3200; KH = 3400; MQ = 4000; TDEF = 5100; TTMP = 5200; TWF = 5400; TSIN = 5500;
TWT = 8192; TWTL = 1025; TWTS = 16 * 1025;
TGH = 131072; TGM = 262143; TCH = 400000; FBO = 420000; FJT = 490000; SPCK = 600000;
CR = 16;

V_ON = 0; V_LV = 1; V_LS = 2; V_PA = 3; V_IA = 4; V_PB = 5; V_IB = 6; V_M = 7; V_NT = 8; V_LPC = 9;
V_L0 = 10; V_L1 = 11; V_L2 = 12; V_L3 = 13; V_CHF = 15; V_PC = 16; V_IC = 17;
V_GATE = 18; V_REL = 19; V_RLS = 20; V_TG = 21; V_TGN = 22; V_AGE = 23; V_CUT = 24; V_FI = 25; V_FIK = 26; V_SCP = 27;
V_W = 28; V_EV = 32; V_DO = 36; V_DOT = 37; V_DOC = 38; V_INC = 39; V_M2 = 40; V_FRS = 41; V_P2 = 42; V_I2 = 43;
V_WP = 44; V_VP = 45; V_CK = 46; V_CKN = 47; V_CKA = 48; V_CKB = 49;
F_P = 50; F_TG = 51; F_W = 52; F_BV = 53; F_ENV = 54; F_LV = 55; F_LP = 56; F_DCX = 57; F_DCY = 58; F_NZ = 59;
F_N = 60; F_H0 = 61; F_H1 = 62; F_H2 = 63; F_H3 = 64; F_JI = 65; F_JF = 66; F_HZ = 67; F_AN = 68; F_AD = 69;
F_LPC = 70; F_DL = 71; F_DJ = 72; F_OC = 73; F_OS = 74; F_OG = 75; F_VM = 76; F_VD = 77; F_VPH = 78; F_VR = 79; F_FC = 80;
memset(VOX, 0, NV * VS); memset(KP, 0, 128); memset(KS, 0, 128);

function tv_hash(n) ( n = sin(n * 12.9898 + 4.1) * 43758.5453; n - floor(n); );
function ts(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function tv_k(f) ( 1 - exp(-2 * $pi * min(f, srate * 0.45) / srate); );
function tv_vn(sd, x) local(i, f, a, b) (
  i = floor(x); f = x - i; a = tv_hash(sd + i * 1.618); b = tv_hash(sd + (i + 1) * 1.618);
  a + (b - a) * (0.5 - 0.5 * cos($pi * f)) - 0.5;
);
function tv_wander(q, bs) local(ph) (
  ph = q[2] + q[3] * bs;
  ph >= 1 ? ( ph -= floor(ph); q[0] = q[1]; q[1] = rand(2) - 1; );
  q[2] = ph;
  q[0] + (q[1] - q[0]) * (0.5 - 0.5 * cos($pi * ph));
);
function tv_bpset(c, f, bw) local(g, k) (
  g = tan($pi * min(f, srate * 0.45) / srate); k = min(bw / f, 1.8);
  c[0] = 1 / (1 + g * (g + k)); c[1] = g * c[0]; c[2] = g * c[1]; c[3] = k;
);
function tv_bp(x, c) instance(s1, s2) local(v1, v2, v3) (
  v3 = x - s2; v1 = c[0] * s1 + c[1] * v3; v2 = s2 + c[1] * s1 + c[2] * v3;
  s1 = v1 + v1 - s1; s2 = v2 + v2 - s2;
  v1 * c[3];
);

i_ = 0; loop(128,
  KH[i_ * 4] = (tv_hash(i_ + 0.31) - 0.5) * 7;
  KH[i_ * 4 + 1] = 2 ^ ((tv_hash(i_ + 7.7) - 0.5) * 0.24);
  KH[i_ * 4 + 2] = (tv_hash(i_ + 3.3) - 0.5);
  KH[i_ * 4 + 3] = tv_hash(i_ + 9.1);
  i_ += 1; );

function tv_amp(s, k) local(j) (
  s == 0 ? k ^ -1.15 :
  s == 1 ? 1 / k * (1 + 0.35 * exp(-sqr((k - 4) / 2.5))) :
  s == 2 ? ( (k & 1) ? ( k == 1 ? 1 : k == 3 ? 0.42 : k == 5 ? 0.14 : k == 7 ? 0.06 : 0.4 / (k * k) ) :
             ( k == 2 ? 0.5 : k == 4 ? 0.2 : k == 6 ? 0.08 : k == 8 ? 0.04 : 0 ) ) :
  s == 3 ? ( k == 1 ? 0.62 : k == 2 ? 1 : k == 4 ? 0.58 : k == 8 ? 0.36 : k == 16 ? 0.05 : k == 3 ? 0.012 : k == 5 ? 0.008 : 0 ) :
  ( (k & 1) ? 1 / k ^ 1.08 : ( j = k / 2; (j & 1) ? 0.5 / j ^ 1.08 : 0 ) );
);
function tv_tables() local(s, m, ft, hm, k, a, i, b, ph, pk, nrm) (
  i = 0; loop(1024, TSIN[i] = sin(2 * $pi * i / 1024); i += 1; ); TSIN[1024] = 0;
  s = 0;
  loop(5,
    m = 0;
    loop(16,
      b = TWT + s * TWTS + m * TWTL; memset(b, 0, TWTL);
      ft = 30 * 2 ^ ((m + 1) / 2); hm = min(64, max(1, floor(min(srate * 0.45, 21000) / ft)));
      k = 1;
      loop(hm,
        a = tv_amp(s, k);
        a > 0 ? (
          ph = s < 2 || s == 3 ? floor(1024 * (k * k * 0.37 + k * 0.11 - floor(k * k * 0.37 + k * 0.11))) : 0;
          i = 0; loop(1024, b[i] += a * TSIN[(k * i + ph) & 1023]; i += 1; );
        );
        k += 1; );
      b[1024] = b[0];
      m += 1; );
    pk = 0; b = TWT + s * TWTS; i = 0; loop(1024, pk = max(pk, abs(b[i])); i += 1; );
    nrm = 1 / max(pk, 0.001);
    i = 0; loop(TWTS, b[i] *= nrm; i += 1; );
    s += 1; );
);
function tv_lvl(f) ( min(max(ceil(2 * log(f / 30) / log(2) - 1), 0), 15); );

function tv_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
tv_nums("0 1 0 0 100 100 100 100 0 8 35 25 0 0.15 20 45 30 0 1 0", TDEF);
#tg_pm = "Init|Three Violins|Choir Aah|Flute Tape|Tonewheel Tape|Combo Tape|Pipe Tape|Long Strip Strings|Cold Room Flutes|Damp Cellar Choir|Worn Copy|Strings and Flutes|Choir and Organ|Summer Heat";
function tv_pstr(p) (
  p == 2  ? "11:30 12:20 13:10 14:0.25" :
  p == 3  ? "1:1 2:0 14:0.4 13:-8" :
  p == 4  ? "2:0 3:1 12:20 13:5 14:0.2" :
  p == 5  ? "2:0 4:1 9:0 12:30 11:25 14:0.08" :
  p == 6  ? "2:0 4:1 9:1 12:35 13:12 14:0.08" :
  p == 7  ? "2:0 4:1 9:2 12:20 13:-10 14:0.35" :
  p == 8  ? "10:16 11:55 12:35 14:0.5" :
  p == 9  ? "2:0 3:1 15:-6 11:40 13:-12 14:0.25" :
  p == 10 ? "1:1 2:0 16:88 12:45 13:-18 14:0.45" :
  p == 11 ? "12:92 11:55 13:-25 10:12" :
  p == 12 ? "3:1 7:62 6:90 14:0.3" :
  p == 13 ? "1:1 2:0 4:1 9:2 8:58 14:0.5 10:12" :
  p == 14 ? "15:37 16:65 11:45 13:6 14:0.3" :
  "";
);
function load_preset(p) local(n, i) (
  i = 1; loop(17, slider(i) = TDEF[i - 1]; i += 1; );
  n = tv_nums(tv_pstr(p), TTMP);
  i = 0; loop(floor(n / 2), TTMP[i * 2] >= 1 && TTMP[i * 2] <= 17 ? slider(TTMP[i * 2]) = TTMP[i * 2 + 1]; i += 1; );
  slider_automate(131071);
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(20, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

function tv_vgain(vel, n) ( (1 - tv_vel + tv_vel * vel) * KH[n * 4 + 1]; );
function tv_find(note) local(v, q, best, oa, ll) (
  best = -1;
  v = 0; loop(NV, q = VOX + v * VS; best < 0 && q[V_ON] && q[V_NT] == note && !q[V_CUT] ? best = v; v += 1; );
  best < 0 ? ( v = 0; loop(NV, q = VOX + v * VS; best < 0 && !q[V_ON] ? best = v; v += 1; ); );
  best < 0 ? (
    oa = 1000000000000;
    v = 0; loop(NV, q = VOX + v * VS; q[V_AGE] + (q[V_RLS] ? -100000000 : 0) < oa ? ( oa = q[V_AGE] + (q[V_RLS] ? -100000000 : 0); best = v; ); v += 1; );
    q = VOX + best * VS; q[V_CUT] = 1; q[V_RLS] = 1;
    ll = 10; v = 0; loop(NV, q = VOX + v * VS; q[V_LV] < ll ? ( ll = q[V_LV]; best = v; ); v += 1; );
  );
  best;
);
function tv_fclear(v) ( memset(FBO + v * 4096, 0, 4096); memset(FJT + v * 2048, 0, 2048); );
function tv_non(note, vel) local(v, q, p, fresh, f) (
  v = tv_find(note);
  q = VOX + v * VS;
  p = KP[note];
  fresh = p < 0.02;
  q[V_ON] && q[V_NT] == note && !q[V_CUT] ? (
    q[V_RLS] = 0; q[V_REL] = 1;
  ) : (
    memset(q, 0, VS); tv_fclear(v);
    q[V_NT] = note; q[V_REL] = 1;
    q[V_PA] = tv_hash(note + 0.5); q[V_PB] = tv_hash(note + 1.5); q[V_PC] = tv_hash(note + 2.5); q[V_P2] = tv_hash(note + 3.5);
    q[V_W + 3] = 0.15 + rand(1) * 0.25; q[V_EV + 3] = 0.06 + rand(1) * 0.12; q[V_W] = q[V_W + 1] = rand(2) - 1; q[V_EV] = q[V_EV + 1] = rand(2) - 1;
    q[V_W + 2] = rand(1); q[V_EV + 2] = rand(1);
    f = 440 * 2 ^ ((note + 14 - 69) / 12);
    q[V_M] = tv_lvl(f); q[V_M2] = tv_lvl(f * 0.5);
    q[V_LPC] = 0.5; q[V_DO] = 1; q[V_DOT] = 1;
    q[V_WP] = KH[note * 4 + 3] + p * (0.45 + 0.6 * KH[note * 4 + 3]);
    q[V_VR] = 4.7 + 1.1 * tv_hash(note + 5.5); q[V_VP] = tv_hash(note + 6.5) + p * q[V_VR];
    q[F_VR] = 4.9 + 0.7 * tv_hash(note + 8.5); q[F_VPH] = tv_hash(note + 4.5) + p * q[F_VR];
    q[F_P] = fresh ? 0 : 0.6; q[F_TG] = fresh ? 1 : 0; q[F_VM] = 1;
    q[V_FI] = fresh ? 1 : 0; q[V_FIK] = 1 / (0.004 * srate);
    q[V_FRS] = 1 / (0.03 * srate);
    q[V_CK] = fresh; q[V_CKN] = 0;
    q[V_CHF] = fresh * 0.5;
    q[V_ON] = 1;
  );
  q[V_SCP] = -(fresh ? 0.024 : 0.012) * (0.4 + tv_wob);
  q[V_GATE] = 1; q[V_TG] = tv_vgain(vel, note); !q[V_TGN] ? q[V_TGN] = q[V_TG];
  q[V_AGE] = tv_age; tv_age += 1;
  q[V_INC] = 440 * 2 ^ ((note - 69) / 12) / srate;
  q[V_IA] = q[V_IB] = q[V_IC] = q[V_INC];
  KS[note] = 1;
  mi_led_d = 1;
);
function tv_noff(note) local(v, q) (
  v = 0; loop(NV, q = VOX + v * VS; q[V_ON] && q[V_NT] == note && q[V_GATE] ? ( q[V_GATE] = 0; !tv_ped ? ( q[V_RLS] = 1; KS[note] = 0; ); ); v += 1; );
  !tv_ped ? KS[note] = 0;
);
function tv_pedup() local(v, q) (
  v = 0; loop(NV, q = VOX + v * VS; q[V_ON] && !q[V_GATE] ? ( q[V_RLS] = 1; KS[q[V_NT]] = 0; ); v += 1; );
);
function tv_alloff() local(v, q) (
  v = 0; loop(NV, q = VOX + v * VS; q[V_ON] ? ( q[V_GATE] = 0; q[V_RLS] = 1; ); v += 1; );
  memset(KS, 0, 128); tv_ped = 0;
);

function tv_fcr(q) local(nt, f, tp, w, a, cut, pdl, pdc, dn, qq, jr, jc, ja, pdj, hk, de, dv, c, hm) (
  nt = q[V_NT]; while (nt < 48) ( nt += 12; ); while (nt > 96) ( nt -= 12; );
  q[F_VD] = q[V_LV] > 0 ? min(1, max(0, (KP[q[V_NT]] - 0.45) / 0.6)) : 0;
  q[F_VPH] += q[F_VR] * CR / srate * tv_spd; q[F_VPH] -= floor(q[F_VPH]);
  dv = 0.32 * q[F_VD] * q[F_VD] * (3 - 2 * q[F_VD]);
  q[F_VM] = 1 + 0.16 * dv * sin(2 * $pi * q[F_VPH]);
  c = q[F_FC] + dv * 14 * sin(2 * $pi * q[F_VPH]);
  f = 440 * 2 ^ ((nt - 69) / 12 + c / 1200) * tv_spd * (1 + q[V_SCP]);
  tp = srate / f; w = 2 * $pi * f / srate;
  cut = min(0.45 * srate, 4850 * (0.75 + 0.5 * q[F_P]) * tv_fbr);
  q[F_LPC] = 1 - exp(-2 * $pi * cut / srate); a = 1 - q[F_LPC];
  pdl = atan2(a * sin(w), 1 - a * cos(w)) / w;
  pdc = -((($pi - w) * 0.5) - atan2(tv_dcr * sin(w), 1 - tv_dcr * cos(w))) / w;
  q[F_DL] = q[F_DL] < 1 ? max(4, min(4090, tp - 1 - pdl - pdc)) : q[F_DL] + (max(4, min(4090, tp - 1 - pdl - pdc)) - q[F_DL]) * tv_dlk;
  dn = floor(q[F_DL]) - 1; qq = q[F_DL] - dn; q[F_N] = dn;
  q[F_H0] = -(qq - 1) * (qq - 2) * (qq - 3) / 6; q[F_H1] = qq * (qq - 2) * (qq - 3) * 0.5;
  q[F_H2] = -qq * (qq - 1) * (qq - 3) * 0.5; q[F_H3] = qq * (qq - 1) * (qq - 2) / 6;
  hm = q[F_LPC] / sqrt(1 - 2 * a * cos(w) + a * a);
  jr = 0.5 * (1.06 - 0.12 * min(1, q[F_P]));
  jc = 1 - exp(-2 * $pi * min(2 * f, 0.45 * srate) / srate); ja = 1 - jc;
  pdj = atan2(ja * sin(w), 1 - ja * cos(w)) / w;
  q[F_DJ] = q[F_DJ] < 0.5 ? max(1, min(2040, jr * tp - pdj)) : q[F_DJ] + (max(1, min(2040, jr * tp - pdj)) - q[F_DJ]) * tv_dlk;
  q[F_JI] = floor(q[F_DJ]); q[F_JF] = q[F_DJ] - q[F_JI];
  hk = max(0, min(1, (nt - 70) / 20));
  q[F_OC] = hk > 0.001 ? 1 - exp(-2 * $pi * min(0.45 * srate, 1.5 * f / hk ^ 0.8) / srate) : 1;
  q[F_OG] = (1 + 0.25 * hk) * (1 + (hk > 0.001) * hk ^ 1.6 / 2.25);
  de = 2.2 * (0.7 + 0.6 * min(1, q[F_P])) * (1 - 0.3 * hk);
  q[F_AN] = (1 - 0.82 * hm) * 0.6 / max(0.04, 0.5 * (ts(1 + 0.6 * de) - ts(1 - 0.6 * de)));
  q[F_AD] = de; q[F_HZ] = jc;
);

function tv_vblk(q) local(n, pos, L, sd, rl, rb, rp, rv, w, ev, wd, wr, vb, cents, f, d, cut, att, as, body, ro, tg, fr, sag, lf, kn) (
  n = q[V_NT]; L = tv_len; lf = (L - 8) / 8;
  pos = KP[n];
  q[V_GATE] || !q[V_RLS] ? ( pos < L ? pos = min(L, pos + tv_bs * tv_sbm * (1 + q[V_SCP])); KP[n] = pos; );
  kn = 1.3; sd = n * 7.31;
  rl = tv_vn(sd, pos / kn); rb = tv_vn(sd + 101, pos / kn); rp = tv_vn(sd + 202, pos / kn); rv = tv_vn(sd + 303, pos / kn);
  w = tv_wander(q + V_W, tv_bs);
  ev = tv_wander(q + V_EV, tv_bs);
  wr = (0.45 + 0.6 * KH[n * 4 + 3]) * (1 - 0.35 * lf);
  q[V_WP] += wr * tv_bs * tv_sbm; q[V_WP] -= floor(q[V_WP]);
  wd = tv_wob * 7 * (1 + 1.6 * lf) * (0.55 + 0.9 * min(pos / L, 1)) * (1 + 1.2 * tv_warm) * (1 + 0.6 * tv_fat);
  q[V_VP] += q[V_VR] * tv_bs * tv_sbm; q[V_VP] -= floor(q[V_VP]);
  vb = sin(2 * $pi * q[V_VP]);
  sag = -lf * 6 * min(pos / L, 1) * (0.5 + tv_wob) - tv_hdrag * 5 * min(pos / 2, 1);
  cents = KH[n * 4] + rp * 5 + sag + w * wd * 0.35
        + sin(2 * $pi * q[V_WP]) * wd
        + vb * tv_vibd * min(pos / 0.9, 1) * (1 + 0.8 * rv);
  q[F_FC] = KH[n * 4] + rp * 4 + sag + w * wd * 0.35 + sin(2 * $pi * q[V_WP]) * wd;
  f = 440 * 2 ^ ((n - 69 + tv_bend + cents * 0.01) / 12);
  q[V_INC] = f / srate;
  d = tv_det * (1 + 0.35 * ev);
  q[V_IA] = q[V_INC] * 2 ^ (d / 2400); q[V_IB] = q[V_INC] * 2 ^ (-d / 2400); q[V_IC] = q[V_INC] * 2 ^ (d * 0.15 * w / 2400);
  q[V_I2] = q[V_INC] * 1.4983070768766815;
  cut = tv_vcut * 2 ^ (0.35 * ev + 0.5 * rb + 0.6 * KH[n * 4 + 2] - 1.1 * tv_gn - 0.7 * tv_cold - 0.8 * tv_hum2 - 0.5 * tv_fat * tv_fg);
  q[V_LPC] = tv_k(cut);
  q[V_CHF] *= tv_chkb; q[V_CHF] < 0.0005 ? q[V_CHF] = 0;
  att = tv_att;
  as = min(pos / att, 1); as = as * as * (3 - 2 * as);
  body = (0.82 + 0.18 * exp(-pos * 0.45)) * (1 + 0.05 * ev) * (1 + 0.16 * rl);
  ro = min(max((L - pos) / 0.45, 0), 1); ro = ro * ro * (3 - 2 * ro);
  q[V_RLS] ? ( q[V_REL] *= (q[V_CUT] ? tv_rkf : tv_rk); );
