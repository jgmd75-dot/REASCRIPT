);

w_s += (w_t - w_s) * dp_gl;
wm = (oL + oR) * 0.5; ws = (oL - oR) * 0.5 * w_s;
m_vol += (m_vol_t - m_vol) * dp_gl;
ost_out((wm + ws) * m_vol, (wm - ws) * m_vol);
oa = ost_l; ob = ost_r;
oa != oa ? oa = 0; ob != ob ? ob = 0;
spl0 = oa;
spl1 = ob;
mn_ms += 0.5 * (oa * oa + ob * ob); mn_pkm = max(mn_pkm, max(abs(oa), abs(ob)));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
DQF = 0x2E2A40; DQB = 0x0D0B16; DQI = 0xE8E6DA; DQH = 0x14121E; DQV = 0xFFD060; DQA = 0xFFB030;
DQK = 0xB0703C; DQS = 0xE85A48; DQT = 0xF2CC38;
sc != dq_fsc ? (
  dq_fsc = sc;
  dq_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  dq_f6 = ui_fitfont(6, 24 * sc);
);
function dq_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * dq_kt * sc, 'b'); );
function dq_fc(px) ( gfx_setfont(12, "Courier New", px * dq_kt * sc, 'b'); );
function dq_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function dq_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function dq_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function dq_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function dq_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function dq_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
);
DQIN = ui_mix(ui_mix(DQF, 0, 0.10), 0, 0.30);
function dq_pocket(x, y, w, h) ( dq_cham(x, y, w, h, 3, DQF); ui_col(DQIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function dq_hover(cx, cy, fs) ( dq_hon = 1; dq_hx = cx; dq_hy = cy; dq_hfs = fs; );
function dq_head(x, y, w, ttl, sub, uc) (
  dq_ft(16); ui_col(DQI); dq_tl(x + 14, y + 19, ttl);
  dq_ft(12); ui_col(v5_ink); dq_tr(x + w - 14, y + 20, sub);
  ui_col(uc); v5_r(x + 12, y + 31, w - 24, 3);
);
function dq_fmt(idx) local(v) (
  v = slider(idx);
  idx == 1 || idx == 8 || idx == 58 || idx == 51 || idx == 10 || idx == 60 || idx == 46 || idx == 63 ? (
    v < 1000 ? sprintf(#dq_hv, "%d Hz", v + 0.5) : sprintf(#dq_hv, "%.1f kHz", v / 1000); )
  : idx == 4 || idx == 12 || idx == 59 || idx == 52 || idx == 47 || idx == 48 ? sprintf(#dq_hv, "%d ms", v + 0.5)
  : idx == 7 || idx == 14 || idx == 61 || idx == 53 || idx == 50 || idx == 64 || idx == 40 ? sprintf(#dq_hv, "%+.1f dB", v)
  : idx == 45 || idx == 62 ? sprintf(#dq_hv, "%+.1f st", v)
  : idx == 39 ? ( v <= -59.9 ? strcpy(#dq_hv, "OFF") : sprintf(#dq_hv, "%.1f dB", v); )
  : sprintf(#dq_hv, "%d %%", v + 0.5);
);
function dq_dial(cx, cy, r, idx, lo, hi, def, lg, lbl, ptr, fs, wm) local(n, a, i, t, rs) (
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 8), 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  wm ? (
    dq_ft(11); ui_col(0xC8CDC4); t = -0.75 * $pi;
    v5_t(cx + sin(t) * (rs + 2), cy - cos(t) * (rs + 2), "M"); v5_t(cx, cy - rs - 3, "C"); v5_t(cx - sin(t) * (rs + 2), cy - cos(t) * (rs + 2), "S");
  ) : (
    ui_col(0xC8CDC4); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  );
  v5_shc(cx, cy, r);
  ui_col(0x151817); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2E3331); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xBDB49E); v5_d(cx, cy, r * 0.74);
  ui_col(dq_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, ptr);
  v5_act ? ( dq_fmt(idx); dq_hover(cx, cy + r + 19, fs); ) : ( dq_ft(fs); ui_col(DQI); v5_t(cx, cy + r + 19, lbl); );
);
function dq_dead(cx, cy, r, lbl) local(i, t, rs) (
  rs = r + 7; ui_col(0x6A6C70); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  v5_shc(cx, cy, r);
  ui_col(0x151817); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2E3331); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0x6E6A60); v5_d(cx, cy, r * 0.74);
  ui_col(ui_mix(dq_cc, DQIN, 0.6)); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  dq_ft(15); ui_col(0x8C8E92); v5_t(cx, cy + r + 19, lbl);
);
function dq_led(x, y, c, g) local(i) (
  ui_col(0x050606); v5_d(x, y, 5.5);
  ui_col(ui_mix(c, 0x101214, 0.78)); v5_d(x, y, 4);
  g > 0.01 ? (
    i = 0; loop(5, ui_cola(c, 0.07 * g); v5_d(x, y, 4 + 2.2 * (5 - i)); i += 1; );
    ui_cola(c, g); v5_d(x, y, 4);
    ui_cola(ui_mix(c, 0xFFFFFF, 0.6), 0.85 * g); v5_d(x - 1, y - 1.2, 1.6);
  );
);
function dq_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x1A1C1D); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  c0 = ui_mix(0x9EA49A, 0xC6CCBF, 0.44); c1 = 0xC6CCBF; c2 = ui_mix(0x9EA49A, 0xC6CCBF, 0.16);
  dq_grad(x, y, w, floor(h * 0.4 + 0.5), c0, c1); dq_grad(x, y + floor(h * 0.4 + 0.5), w, h - floor(h * 0.4 + 0.5), c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function dq_arrkey(x, y, w, h, dir) local(cx, cy) (
  v5_keycap(x, y, w, h, 0, 0x3A3E41, 0x4A4F53, v5_cr, "", -1);
  cx = x + w / 2; cy = y + h * 0.42; ui_col(v5_cr);
  dir < 0 ? gfx_triangle((cx - 5.5) * sc, cy * sc, (cx + 3.5) * sc, (cy - 5.5) * sc, (cx + 3.5) * sc, (cy + 5.5) * sc)
          : gfx_triangle((cx + 5.5) * sc, cy * sc, (cx - 3.5) * sc, (cy - 5.5) * sc, (cx - 3.5) * sc, (cy + 5.5) * sc);
);
function dq_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#dq_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 38, 34) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
  v5_pr && v5_drag == 0 && v5_hit(x + 42, y, 38, 34) ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; v5_drag = -1; );
  dq_arrkey(x, y, 38, 34, -1); dq_arrkey(x + 42, y, 38, 34, 1);
  gx = x + 90; dq_glass(gx, y + 3, w - 90, 28);
  cur >= 1 && cur <= n ? pk_pitem(#dq_pm, cur, #dq_pl) : strcpy(#dq_pl, "--");
  dq_fc(18); ui_col(0x15180F); dq_tl(gx + 10, y + 17.5, #dq_pl);
  v5_pr && v5_drag == 0 && v5_hit(gx, y + 3, w - 90, 28) ? ( open = 1; v5_drag = -1; );
  open ? (
    strcpy(#dq_pmm, ""); i = 1;
    loop(n, i == cur ? strcat(#dq_pmm, "!"); strcat(#dq_pmm, pk_pitem(#dq_pm, i, #dq_pt)); i < n ? strcat(#dq_pmm, "|"); i += 1; );
    gfx_x = gx * sc; gfx_y = (y + 36) * sc; i = gfx_showmenu(#dq_pmm); i > 0 ? sel = i;
  );
  sel;
);
function dq_sml(x, y) local(i, cur, on) (
  cur = ui_sz == 1 ? 0 : ui_sz == 2 ? 2 : 1;
  ui_col(0x050505); v5_rr(x - 2, y - 2, 84, 22, 3);
  i = 0; loop(4, on = i < 3 ? i == cur : ui_help_open;
    v5_pr && v5_drag == 0 && v5_hit(x + i * 20, y, 20, 18) ? (
      i == 0 ? ui_sz = 1 : i == 1 ? ui_sz = 0 : i == 2 ? ui_sz = 2 : ( ui_help_open = 1; ui_help_new = 1; );
      v5_drag = -1; on = 1;
