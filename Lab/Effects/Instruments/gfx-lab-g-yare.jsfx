F_HM = 40;  F_PVEL = 41;  F_PPLY = 42;  F_PGID = 43;  F_LPC = 44;  F_NZ = 45;  F_HZ = 46;  F_RAD = 47;
F_VRT = 48;  F_FIN = 49;  F_PDR = 50;  F_PDT = 51;  F_PDM = 52;  F_HLP = 53;  F_PN = 54;  F_BB = 55;  F_JB = 56;  F_N = 57;  F_H0 = 58;  F_H1 = 59;  F_H2 = 60;  F_H3 = 61;  F_JI = 62;  F_JF = 63;  F_AN = 64;  F_AD = 65;  F_VM = 66;  F_VDL = 67;  F_OG = 68;  F_RQ = 69;  F_TGA = 70;  F_TGK = 71;  F_SCP = 72;  F_TAR = 73;  F_BRV = 74;  F_RDT = 75;  F_ROB = 76;  F_BZ = 77;  F_BZP = 78;  F_CL = 79;  F_RK = 80;  F_ROF = 81;  F_RSL = 82;  F_RPS = 83;  F_RCL = 84;  F_RX = 85;  F_RT = 86;  F_HX = 87;  F_HV = 88;  F_HW = 89;  F_FA = 90;  F_FB = 91;  F_FC = 92;  F_FD = 93;  F_FE = 94;  F_FF = 95;  F_FG = 96;  F_FH = 97;  F_RL = 98;  F_RAX = 99;  F_RAY = 100;

memset(VOX, 0, NV * VS);  memset(PLG, 0, 100);
function ty_set(t, c, a, e, j, w, v, k, g, l, n) local(b) (
  b = TYP + t * TYN;  b[0] = c;  b[1] = a;  b[2] = e;  b[3] = j;  b[4] = w;  b[5] = v;  b[6] = k;  b[7] = g;  b[8] = l;  b[9] = n;  b[10] = 1;  b[11] = 0;  b[12] = 0;  b[13] = 0;  b[14] = 1;  b[15] = 0;
);
function ty_r(t, k) ( TYP[t * TYN + 15] = k; );
function ty_y(t, cl, ob) local(b) ( b = TYP + t * TYN;  b[13] = cl;  b[14] = ob; );
function ty_x(t, scp, bz, rs) local(b) ( b = TYP + t * TYN;  b[10] = scp;  b[11] = bz;  b[12] = rs; );
function ar_set(i, amt, ms, scp, air) ( ART[i * 4] = amt;  ART[i * 4 + 1] = ms;  ART[i * 4 + 2] = scp;  ART[i * 4 + 3] = air; );
ar_set(0, 1, 22, 0, 1);
ar_set(1, 0.55, 32, -6, 1.15);
ar_set(2, 0.85, 15, 4, 0.85);
ar_set(3, 0.28, 48, -11, 1.7);
