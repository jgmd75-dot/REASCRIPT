u_ih = 0;  k = 0;  loop(5, PMG[k] += (PMT[k] - PMG[k]) * smk;  PLG[k] += (PLB[k] - PLG[k]) * (PLB[k] < PLG[k] ? pgd_k : pgu_k);  PLI[k] += (PLH[k] - PLI[k]) * 0.00012 * 48000 / srate;  u_ih += PLI[k] * (0.6 + 0.1 * k);  k += 1; );

