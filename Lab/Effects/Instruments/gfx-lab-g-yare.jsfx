  loop(12, PAT[pat_i] = pat_i == 0 ? 64 : pat_i == 1 ? 66 : pat_i == 2 ? 71 : pat_i == 3 ? 73 : pat_i == 4 ? 74 : pat_i == 5 ? 66 : pat_i == 6 ? 64 : pat_i == 7 ? 73 : pat_i == 8 ? 71 : pat_i == 9 ? 66 : pat_i == 10 ? 74 : 73;  PATV[pat_i] = 0.7;  pat_i += 1; );
  pat_init = 1;
);
HSK = 1400;  RRC = 1540;  ART = 1550;  TYP = 1600;  TYN = 16;
MQ = 4096;  MQMAX = 1000;
BOR = 65536;  BOM = 4095;  JET = 131072;  JTM = 2047;
FX_MEM = 1048576;
RLUT = 200000;
(
  rz_i = 0;
  loop(5,
    rz_z = 0.15 + rz_i * 0.1;  rz_k = 0;
    loop(1025,
      rz_x = rz_k / 1023;  rz_lo = 0;  rz_hi = rz_x;
      rz_x > 0 && rz_x < 1 ? loop(40, rz_m = (rz_lo + rz_hi) * 0.5;  rz_d = rz_x - rz_m;  rz_f = rz_d > 0 && rz_d < 1 ? rz_z * (1 - rz_d) * sqrt(rz_d) : 0;  rz_m - rz_f > 0 ? rz_hi = rz_m : rz_lo = rz_m; );
      RLUT[rz_i * 1025 + rz_k] = rz_x > 0 && rz_x < 1 ? (rz_lo + rz_hi) * 0.5 : 0;
      rz_k += 1;
    );
    rz_i += 1;
  );
);

F_ON = 0;  F_KEY = 1;  F_GATE = 2;  F_SUS = 3;  F_AGE = 4;  F_STEAL = 5;  F_PEND = 6;  F_FADE = 7;
F_P = 8;  F_VEL = 9;  F_PLY = 10;  F_GID = 11;  F_NOTE = 12;  F_NT = 13;  F_DL = 14;  F_DLT = 15;
