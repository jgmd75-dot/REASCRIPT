memset(RRC, 0, 5);
ty_set(0, 1, 0, 0, 1, 0, 1, 1, 1, 1, 1);
ty_set(1, 0.65, 0.06, 0.04, 0.88, 0, 0.9, 1.3, 0.8, 0.98, 1.3);
ty_set(2, 0.42, 0.12, 0.08, 0.75, 0, 0.75, 1.8, 0.6, 0.96, 1.7);
ty_set(3, 1.5, 0, -0.06, 1.15, 0, 0.8, 0.7, 1.3, 1.02, 0.8);
ty_set(4, 0.75, 0.26, -0.22, 0.95, 0, 1.25, 1.1, 1.2, 1, 1.6);
ty_set(5, 1.25, 0.02, 0.2, 1.1, 0.75, 0.5, 0.6, 1.6, 0.9, 0.6);
ty_set(6, 1.15, 0.1, 0.05, 1.05, 0, 1.1, 0.9, 1.2, 0.95, 1.2);  ty_x(6, 1.3, 1, 0);
ty_set(7, 0.68, 0.42, -0.12, 1, 0, 1.4, 1.5, 0.45, 1, 3);  ty_x(7, 2.6, 0, 0.15);
ty_set(8, 0.8, 0.3, -0.18, 1.05, 0, 1.2, 1.2, 0.7, 1, 2.2);  ty_x(8, 1.8, 0, 1);
ty_x(4, 1.6, 0, 0);
ty_set(9, 1.3, 0.34, -0.6, 1, 0, 0.9, 0.8, 1.5, 1, 2.4);  ty_x(9, 1.4, 0, 0.05);  ty_y(9, 1, 0);
ty_set(10, 0.4, 0.12, -0.62, 0.6, 0.3, 0.8, 1, 0.8, 1, 1);  ty_y(10, 1, 0);
ty_set(11, 0.8, 0, 0, 1, 0, 0.3, 1, 1, 1, 0.5);  ty_x(11, 0.5, 0, 0);  ty_y(11, 0, 0);  ty_r(11, 1);
ty_set(12, 0.28, 0.06, -0.35, 1, 0, 0.2, 1.4, 0.8, 1, 0.8);  ty_x(12, 0.7, 0, 0);  ty_y(12, 0, 0);  ty_r(12, 1);
  memset(HSK, 0, 130);

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );

PVB = 4194304;  PLM = 65535;
function pl_clear() ( memset(PVB, 0, 15 * 65536);  pl_lp = pl_da = pl_db = pl_fa = pl_fb = pl_e = 0; );
function pl_rd(i, d) ( PVB[i * 65536 + ((pl_w - d) & PLM)]; );
function pl_rf(i, d) local(n, f, a) ( n = floor(d);  f = d - n;  a = pl_rd(i, n);  a + (pl_rd(i, n + 1) - a) * f; );
function pl_wr(i, x) ( PVB[i * 65536 + (pl_w & PLM)] = x; );
function pl_ap(i, x, d, g) local(v, u) ( v = pl_rd(i, d);  u = x + g * v;  pl_wr(i, u);  v - g * u; );
function pl_apm(i, x, d, g) local(v, u) ( v = pl_rf(i, d);  u = x - g * v;  pl_wr(i, u);  v + g * u; );
function pl_run(l, r) local(x, k, a, b, ya, yb, ch_a, ch_b) (
  k = pl_k;
  pl_wr(0, (l + r) * 0.5);
  x = pl_rd(0, pl_pre);
  pl_lp += (x - pl_lp) * pl_bw;
  x = pl_ap(1, pl_lp, floor(142 * k), 0.75);
  x = pl_ap(2, x, floor(107 * k), 0.75);
  x = pl_ap(3, x, floor(379 * k), 0.625);
  x = pl_ap(4, x, floor(277 * k), 0.625);
  a = x + 0.72 * pl_fb;
  b = x + 0.72 * pl_fa;
  a = pl_apm(5, a, (672 + 12 * sin(2 * $pi * pl_ma)) * k, 0.7);
  pl_wr(6, a);  ya = pl_rd(6, floor(4453 * k));
  pl_da += (ya - pl_da) * pl_dm;
  ya = pl_ap(7, pl_da * 0.72, floor(1800 * k), 0.5);
  pl_wr(8, ya);  pl_fa = pl_rd(8, floor(3720 * k));
  b = pl_apm(9, b, (908 + 12 * sin(2 * $pi * pl_mb + 1.3)) * k, 0.7);
  pl_wr(10, b);  yb = pl_rd(10, floor(4217 * k));
  pl_db += (yb - pl_db) * pl_dm;
  yb = pl_ap(11, pl_db * 0.72, floor(2656 * k), 0.5);
  pl_wr(12, yb);  pl_fb = pl_rd(12, floor(3163 * k));
  ya = pl_rd(10, floor(266 * k)) + pl_rd(10, floor(2974 * k)) - pl_rd(11, floor(1913 * k)) + pl_rd(12, floor(1996 * k)) - pl_rd(6, floor(1990 * k)) - pl_rd(7, floor(187 * k)) - pl_rd(8, floor(1066 * k));
  yb = pl_rd(6, floor(353 * k)) + pl_rd(6, floor(3627 * k)) - pl_rd(7, floor(1228 * k)) + pl_rd(8, floor(2673 * k)) - pl_rd(10, floor(2111 * k)) - pl_rd(11, floor(335 * k)) - pl_rd(12, floor(121 * k));
  ya *= 0.6;  yb *= 0.6;
  pl_wr(13, ya);  pl_wr(14, yb);
  pl_cp += 0.71 / srate;  pl_cp -= floor(pl_cp);
  pl_cq += 0.53 / srate;  pl_cq -= floor(pl_cq);
  ch_a = pl_rf(13, (0.012 + 0.002 * sin(2 * $pi * pl_cp)) * srate);
  ch_b = pl_rf(14, (0.012 - 0.002 * sin(2 * $pi * pl_cq)) * srate);
  pl_l = 0.55 * ya + 0.8 * ch_a - 0.25 * ch_b;
  pl_r = 0.55 * yb + 0.8 * ch_b - 0.25 * ch_a;
  pl_e += (abs(pl_l) + abs(pl_r) - pl_e) * 0.0005;
  pl_w = (pl_w + 1) & 1048575;
);

function fx_block() local(k, ms, sz) (
  sz = 0.3 + 0.7 * 0.55;
  k = 0;
  loop(8,
    ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
    ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
    k += 1;
  );
  bv_t60 = 2.6;  bv_rthi = 1 - 0.82 * 0.5;  bv_rtlo = 1.1;
  k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
  bv_xover();
  sp_pre = 0.022 * srate;
  k = 0;
  loop(8,
    RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
    ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
    k += 1;
  );
  space > 0.0005 && !sp_live ? bv_alloc(FX_MEM);
  sp_live = space > 0.0005 || spm_s > 0.0005;
  pl_k = srate / 29761;
  pl_pre = floor(0.11 * srate);
  pl_bw = 1 - exp(-2 * $pi * 6500 / srate);
  pl_dm = 1 - exp(-2 * $pi * 4200 / srate);
  pl_ma += samplesblock / srate * 0.93;  pl_ma -= floor(pl_ma);
  pl_mb += samplesblock / srate * 0.71;  pl_mb -= floor(pl_mb);
  verb > 0.0005 && !pl_live ? pl_clear();
  pl_live = verb > 0.0005 || vb_s > 0.0005 || pl_e > 0.000001;
);

bv_alloc(FX_MEM);  pl_clear();
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
RVM = 1960;  k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );
drf_g.drift_init(0.8);

function hum_ratio(i) (
  i == 0 ? 1 : i == 1 ? 0.5 : i == 2 ? 0.6674 : i == 3 ? 0.7492 : i == 4 ? 0.7937 : 1.0595;
);

function v_clear(b) local(v) (
  v = (b - VOX) / VS;
  memset(BOR + v * 4096, 0, 4096);  memset(JET + v * 2048, 0, 2048);
  b[F_W] = 0;  b[F_OA] = 0;  b[F_OB] = 0;  b[F_LP] = 0;  b[F_DCX] = 0;  b[F_DCY] = 0;  b[F_BV] = 0;  b[F_ENV] = 0;
  b[F_BB] = BOR + v * 4096;  b[F_JB] = JET + v * 2048;  b[F_DL] = 0;  b[F_DJ] = 0;
  b[F_P] = 0;  b[F_NZ] = 0;  b[F_RAD] = 0;  b[F_LV] = 0;  b[F_HLP] = 0;
);

function v_place(b, key, vel, ply, gid, n) local(sp, pn, c, ar, rv) (
  b[F_OT] = vel < 0;  vel = abs(vel);
  b[F_ON] = 1;  b[F_RQ] = 0;  b[F_KEY] = key;  b[F_GATE] = 1;  b[F_SUS] = 0;  b[F_VEL] = vel;  b[F_PLY] = ply;  b[F_GID] = gid;
  age_n += 1;  b[F_AGE] = age_n;  b[F_STEAL] = 0;  b[F_FADE] = 1;
  b[F_LV] < 0.00002 && b[F_P] < 0.0005 || b[F_RK] != TYP[PTI[ply] * TYN + 15] ? (
    v_clear(b);  b[F_RK] = TYP[PTI[ply] * TYN + 15];  b[F_RL] = b[F_RK] == 2 && key >= 84 ? 1 : b[F_RK];  b[F_RAX] = b[F_RAY] = 0;  b[F_RX] = 0;  b[F_HX] = 0;  b[F_HV] = 0;  b[F_FA] = b[F_FB] = b[F_FC] = b[F_FD] = b[F_FE] = b[F_FF] = b[F_FG] = b[F_FH] = 0;  b[F_NOTE] = key;  b[F_FIN] = 0;
    b[F_VPH] = rand(1);  b[F_HPH] = rand(1);  b[F_FPH] = rand(1);
    b[F_PDR] = (rand(2) - 1) * 0.5;  b[F_PDT] = rand(2) - 1;  b[F_PDM] = 0.5 + rand(1) * 2;
  );
  ar = RRC[ply];  RRC[ply] = (ar + 1 + (rand(1) < 0.2)) % 5;  ar = ART + ar * 4;
  b[F_TGA] = ar[0] * (1 + (rand(2) - 1) * 0.1);
  b[F_TGK] = exp(-1 / (ar[1] * 0.001 * (1 + (rand(2) - 1) * 0.15) * srate));
  b[F_SCP] = (ar[2] + (rand(2) - 1) * 2) * TYP[PTI[ply] * TYN + 10];  b[F_BZ] = 0;  b[F_BZP] = 0;  b[F_CL] = 1;  b[F_TAR] = ar[3];
  rv = (rand(1) + rand(1) + rand(1) - 1.5) * min(1, drift / 50);
  b[F_BRV] = 1 + 0.06 * rv + 0.18 * nt_acc;  b[F_TGA] *= 1 + 0.3 * nt_acc;
  b[F_RDT] = 0.08 * rv * 30 + (rand(2) - 1) * 1.5 * min(1, drift / 50);
  b[F_ROB] = !ovb_t && TYP[PTI[ply] * TYN + 14] > 0.5 && key < 73 && rand(1) < (0.012 + max(0, 0.08 * rv - 0.04) * 0.6) * (drift > 27.5) ? 0.6 + rand(1) * 0.3 : 0;
  b[F_NT] = key;  b[F_VON] = 0;  b[F_TG] = 1;  b[F_VM] = 1;  b[F_VDL] = vdel * 0.001 * (1 + (rand(2) - 1) * 0.15 * sect_on);
  sect_on && n > 1 ? (
    sp = sp_t;
    pn = (PRK[ply] - (n - 1) * 0.5) / max(1, (n - 1) * 0.5);
    b[F_DET] = pn * (3 + 9 * sp) + (rand(2) - 1) * 1.5;
    b[F_JV] = 1 + (rand(2) - 1) * 0.04;
    b[F_DLY] = floor((ply == 0 ? 0 : 0.004 + rand(1) * 0.022 * (0.4 + sp)) * srate);
    b[F_VRT] = 1 + (rand(2) - 1) * 0.12;
    c = 0.5 + 0.5 * pn * (0.25 + 0.75 * sp);
  ) : (
    b[F_DET] = (rand(2) - 1) * 0.8;
    b[F_JV] = 1 + (rand(2) - 1) * 0.01;
    b[F_DLY] = 0;
    b[F_VRT] = 1 + (rand(2) - 1) * 0.05;
    c = 0.5 + max(-0.18, min(0.18, (key - 72) / 36 * 0.18));
  );
  b[F_GL] = cos(c * $pi * 0.5);  b[F_GR] = sin(c * $pi * 0.5);
  click_req += vel * !b[F_OT] * (sect_on ? PMT[ply] : 1);
);

function v_pick(gid) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : b[F_GID] == gid ? 1000000001 : b[F_STEAL] ? 1000000000 : (!b[F_GATE] && !b[F_SUS]) ? b[F_LV] : 2 + b[F_AGE];
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  VOX + best * VS;
);

function v_put(key, vel, i, gid, n) local(b, v, c, ot, m) (
  ot = vel < 0;  b = -1;
  pat_play ? ( v = 0;  m = 0;  loop(NV, c = VOX + v * VS;  c[F_ON] && !c[F_STEAL] && c[F_PLY] == i && c[F_OT] == ot && !c[F_GATE] && !c[F_SUS] ? ( m += 1;  b < 0 || c[F_AGE] < b[F_AGE] ? b = c; );  v += 1; );  m < 2 ? b = -1; );
  b >= 0 ? ( b[F_STEAL] = 1;  b[F_PEND] = key;  b[F_PVEL] = vel;  b[F_PPLY] = i;  b[F_PGID] = gid;  b[F_GID] = gid;  b[F_PN] = n; ) : (
  b = v_pick(gid);
  b[F_ON] && b[F_LV] > 0.00002 ? (
    b[F_STEAL] = 1;  b[F_PEND] = key;  b[F_PVEL] = vel;  b[F_PPLY] = i;  b[F_PGID] = gid;  b[F_GID] = gid;  b[F_PN] = n;
  ) : v_place(b, key, vel, i, gid, n);
  );
);
function v_one(key, vel, i, gid, n) (
  v_put(key, vel, i, gid, n);
  ovb_t && TYP[PTI[i] * TYN + 14] > 0.5 && key > 72 && key < 85 ? v_put(key, -vel, i, gid, n);
);
function pq_add(due, ty, key, vel, ply, gid, n) local(q) (
  pq_n < PQMAX ? (
    q = PQ + pq_n * PQS;  q[0] = due;  q[1] = ty;  q[2] = key;  q[3] = vel;  q[4] = ply;  q[5] = gid;  q[6] = n;  q[7] = nt_acc;
    pq_n += 1;  pq_min = min(pq_min, due);
  );
);
function pq_del(j) local(q, z) (
  pq_n -= 1;  q = PQ + j * PQS;  z = PQ + pq_n * PQS;  memcpy(q, z, PQS);
);
function pq_drop(ply, key) local(j, q) (
  j = 0;
  while (j < pq_n) ( q = PQ + j * PQS;  q[1] == 1 && q[4] == ply && (key < 0 || q[2] == key) ? pq_del(j) : j += 1; );
);
function v_rel_ply(key, ply) local(v, b) (
  pq_drop(ply, key);
  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_KEY] == key && b[F_PLY] == ply ? ( sustain ? b[F_SUS] = 1;  b[F_GATE] = 0; );
    b[F_STEAL] && b[F_PEND] == key && b[F_PPLY] == ply ? b[F_PEND] = -1;
    v += 1;
  );
);
function pq_run() local(j, q, m) (
  m = 10000000000;  j = 0;
  while (j < pq_n) (
    q = PQ + j * PQS;
    q[0] <= scount ? (
      q[1] == 1 ? ( nt_acc = q[7];  v_one(q[2], q[3], q[4], q[5], q[6]); ) : v_rel_ply(q[2], q[4]);
      pq_del(j);
    ) : ( m = min(m, q[0]);  j += 1; );
  );
  pq_min = m;
);
function v_group(key, vel) local(n, i, d) (
  n = sect_on ? pl_n : 1;
  gid_n += 1;
  sect_on && hoc_on ? (
    n > 0 ? (
      i = hk_n % 5;  loop(5, !PMT[i] ? i = (i + 1) % 5; );  hk_n = i + 1;
      d = !leg_on ? floor(SHO[i]) : 0;
      d >= 1 ? pq_add(scount + d, 1, key, vel, i, gid_n, n) : v_one(key, vel, i, gid_n, n);
    );
  ) : (
    i = 0;
    loop(sect_on ? 5 : 1,
      !sect_on || PMT[i] ? (
        d = sect_on && !leg_on ? floor(SHO[i]) : 0;
        d >= 1 ? pq_add(scount + d, 1, key, vel, i, gid_n, n) : v_one(key, vel, i, gid_n, n);
      );
      i += 1;
    );
  );
);

function v_retarget(key, vel) local(v, b, hit) (
  hit = 0;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_ON] && (b[F_GATE] || b[F_SUS]) && !b[F_STEAL] ? ( b[F_RQ] = 0;  b[F_KEY] = key;  b[F_NT] = key;  b[F_GATE] = 1;  b[F_SUS] = 0;  hit = 1; );
    b[F_STEAL] ? b[F_PEND] = key;
    v += 1;
  );
  hit ? click_req += vel * 0.8;
  hit;
);

function hs_push(n) local(i, j) (
  j = 0;  i = 0;
  loop(hs_n, HSK[i] != n ? ( HSK[j] = HSK[i];  j += 1; );  i += 1; );
  hs_n = j;  hs_n < 120 ? ( HSK[hs_n] = n;  hs_n += 1; );
);
function hs_drop(n) local(i, j) (
  j = 0;  i = 0;
  loop(hs_n, HSK[i] != n ? ( HSK[j] = HSK[i];  j += 1; );  i += 1; );
  hs_n = j;
);

function v_release_key(key) local(v, b, i, d) (
  i = 0;
  loop(5,
    d = sect_on && !leg_on ? floor(SHO[i]) : 0;
    d >= 1 ? pq_add(scount + d, 0, key, 0, i, 0, 0) : v_rel_ply(key, i);
    i += 1;
  );
);

function acc_at() local(bt, bn, f, w, d) (
  w = 0;
  tp_now ? (
    bt = bp0 + spos / srate * max(20, tempo) / 60;
    bn = max(1, ts_num | 0);
    f = bt - floor(bt / bn) * bn;
    d = f - floor(f + 0.5);
    abs(d) < 0.07 ? (
      w = floor(f + 0.5) % bn == 0 ? 1 : bn % 2 == 0 && floor(f + 0.5) == bn / 2 ? 0.7 : 0.5;
    ) : abs(f - floor(f) - 0.5) < 0.06 ? w = 0.22;
  );
  w;
);
function note_on(key, vel) (
  rec_on && PATN < 32 ? ( PAT[PATN] = key;  PATV[PATN] = vel;  PATN += 1;  PATN >= 32 ? rec_on = 0; );
  nt_acc = acc_at();
  yr_mlt += 1;
  leg_on ? (
    hs_push(key);
    hs_n > 1 && v_retarget(key, vel) ? 0 : v_group(key, vel);
  ) : v_group(key, vel);
);
function note_off(key) local(top) (
  leg_on ? (
    top = hs_n > 0 ? HSK[hs_n - 1] : -1;
    hs_drop(key);
    hs_n > 0 && top == key ? v_retarget(HSK[hs_n - 1], 0.4) : hs_n == 0 ? v_release_key(key);
  ) : v_release_key(key);
);
function v_pedal_up() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_SUS] = 0;  v += 1; ); );
function v_all_off() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_GATE] = 0;  b[F_RQ] = 0;  b[F_SUS] = 0;  b[F_STEAL] ? b[F_PEND] = -1;  v += 1; );
  hs_n = 0;  pq_n = 0;  pq_min = 10000000000;  v = 0;  loop(5, PLK[v] = -1;  v += 1; );
);
function v_kill() local(v) (
  memset(VOX, 0, NV * VS);  v = 0;  loop(NV, memset(BOR + v * 4096, 0, 4096);  memset(JET + v * 2048, 0, 2048);  v += 1; );
  hs_n = 0;  pq_n = 0;  pq_min = 10000000000;
);

function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? note_on(d1, d2 / 127) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? note_off(d1) :
  st == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xD0 ? ex_at = d1 / 127 :
  st == 0xB0 ? (
    d1 == 1 ? mw = d2 / 127 :
    d1 == 2 ? ex_br = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  rec_on && c && !sustain && PATN < 32 ? ( PAT[PATN] = -1;  PATV[PATN] = 0;  PATN += 1; );  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);

function lb_load(i) local(b, k, j) (
  b = PLIB + i * PLIS;  PATN = b[0];  k = 0;  loop(32, PAT[k] = b[4 + k];  PATV[k] = b[36 + k];  k += 1; );
  rec_on = 0;  k = 0;  loop(5, PLK[k] >= 0 ? v_rel_ply(PLK[k], k);  PLK[k] = -1;  PLA[k] = -1000000;  k += 1; );  k = 1;  loop(4, PHP[k] = 0;  PHS[k] = 0;  k += 1; );
  slider(15) = 1;  slider(29) = b[3];  slider(28) = 1;  slider(27) = b[68];  slider(39) = b[69];  slider(40) = b[70];  slider(41) = b[71];  slider(42) = b[72];
  k = 0;  loop(5, slider(31 + k) = k >= b[1];  k += 1; );
  k = 0;  loop(4, j = b[2] - k;  j < 1 ? j = k + 1;  slider(k == 0 ? 26 : 35 + k) = b[2] < 0.5 ? 0 : max(1, min(6, j));  k += 1; );
  slider_automate(2 ^ 14 + 2 ^ 25 + 2 ^ 27 + 2 ^ 28 + 2 ^ 30 + 2 ^ 31 + 2 ^ 32 + 2 ^ 33 + 2 ^ 34 + 2 ^ 35 + 2 ^ 36 + 2 ^ 37 + 2 ^ 26 + 2 ^ 38 + 2 ^ 39 + 2 ^ 40 + 2 ^ 41);
);
function update_params() (
  ty_b = TYP + max(0, min(12, ftype | 0)) * TYN;  hoc_on = ty_b[13] > 0.5 && ty_b[14] < 0.5 && (ftype | 0) == 9;
  pa_k = 1 - exp(-2.5 / max(1, atk * ty_b[6] * 0.001 * srate));
  up_k = 0;  loop(5, up_t = up_k == 0 ? ftype : slider(37 + up_k);  up_t = up_k > 0 && up_t < 0.5 ? ftype : up_k > 0 ? up_t - 1 : up_t;  up_t = max(0, min(12, up_t | 0));  PTI[up_k] = up_t;  PDV[up_k * 12 + 9] = 1 - exp(-2.5 / max(1, atk * TYP[up_t * TYN + 6] * 0.001 * srate));  up_k += 1; );
  pr_k = 1 - exp(-4 / max(1, rel * 0.001 * srate));
  fin_step = 1 / (0.002 * srate);  fade_step = 1 / (0.003 * srate);
  env_k = 1 - exp(-1 / (0.01 * srate));
  lv_k = 1 - exp(-1 / (0.02 * srate));
  smk = 1 - exp(-1 / (0.03 * srate));  crk = 1 - exp(-CR / (0.03 * srate));
  glk = 1 - exp(-CR / (0.028 * srate));
  dlk = 1 - exp(-CR / (0.0012 * srate));
  rob_k = exp(-CR / (0.05 * srate));
  bzp_k = exp(-1 / (0.03 * srate));
  plf_k = exp(-CR / (3.5 * srate));
  pgd_k = 1 - exp(-1 / (0.26 * srate));  pgu_k = 1 - exp(-1 / (0.42 * srate));
  von_k = CR / ((0.25 + min(0.5, vdel * 0.0004)) * srate);
  dc_r = 1 - 2 * $pi * 18 / srate;
  odc_r = 1 - 2 * $pi * 5 / srate;
  hpn_c = 1 - exp(-2 * $pi * 2200 / srate);
  nlp_c = 1 - exp(-2 * $pi * 7000 / srate);
  hlp_c = 1 - exp(-2 * $pi * 900 / srate);
  fl_dk = exp(-1 / (0.45 * srate));
  ap_al = (1 - tan($pi * 3000 / srate)) / (1 + tan($pi * 3000 / srate));
  fm_w = 2 * $pi * 600 / srate;  fo_b1 = 0.95 * 0.95;  fo_a1 = 2 * 0.95 * cos(fm_w);  fo_g1 = (1 - 0.95) * sqrt(1 - 2 * 0.95 * cos(2 * fm_w) + fo_b1) / (2 * sin(fm_w));
  fm_w = 2 * $pi * 1850 / srate;  fo_b2 = 0.965 * 0.965;  fo_a2 = 2 * 0.965 * cos(fm_w);  fo_g2 = (1 - 0.965) * sqrt(1 - 2 * 0.965 * cos(2 * fm_w) + fo_b2) / (2 * sin(fm_w));
  fm_w = 2 * $pi * 1400 / srate;  fh_b1 = 0.94 * 0.94;  fh_a1 = 2 * 0.94 * cos(fm_w);  fh_g1 = (1 - 0.94) * sqrt(1 - 2 * 0.94 * cos(2 * fm_w) + fh_b1);
  fm_w = 2 * $pi * 3100 / srate;  fh_b2 = 0.93 * 0.93;  fh_a2 = 2 * 0.93 * cos(fm_w);  fh_g2 = (1 - 0.93) * sqrt(1 - 2 * 0.93 * cos(2 * fm_w) + fh_b2);
  drift_macro(drift);
  outg_t = 10 ^ (vol / 20) * OUTK;
  blow_t = blow;  air_t = air;  tone_t = tone;  edge_t = edge;
  tg_t = tongue;  fl_t = flut;  hum_t = hum;  keys_t = keys;  sp_t = spread;  spm_t = space;  vb_t = verb;
  ovb_t = ovb >= 0.5;  sect_t = sect >= 0.5;  leg_on = legato >= 0.5;
  hr_t = hum_ratio(max(0, min(5, hum_int | 0)));
  vib_t = vib;
  lung_t = lungs;  SHT[1] = shift;  SHT[2] = sh3;  SHT[3] = sh4;  SHT[4] = sh5;
  ck_a1 = 2 * 0.9965 * cos(2 * $pi * 310 / srate);  ck_a2 = 0.9965 * 0.9965;
  ck_b1 = 2 * 0.9925 * cos(2 * $pi * 1240 / srate);  ck_b2 = 0.9925 * 0.9925;
  ck_c1 = 2 * 0.985 * cos(2 * $pi * 3400 / srate);  ck_c2 = 0.985 * 0.985;
);

function cr_slot(b) local(nt, f, tp, w, a, pdl, pdc, jr, jc, ja, pdj, cut, c, dv, ov, ot, dn, q, de, hk, tq, co, rth, rdy, rtq) (
  tq = PTS + b[F_PLY] * 16;  co = 0.2 + 1.6 * (edge_s + tq[2]);
  nt = b[F_NOTE] + (b[F_NT] - b[F_NOTE]) * glk;  b[F_NOTE] = nt;
  b[F_PDM] -= CR / srate * dm_s;
  b[F_PDM] <= 0 ? ( b[F_PDT] = rand(2) - 1;  b[F_PDM] = 1.5 + rand(1) * 3; );
  b[F_PDR] += (b[F_PDT] - b[F_PDR]) * CR / (1.2 * srate);
  b[F_VDL] > 0 ? b[F_VDL] -= CR / srate : b[F_VON] = min(1, b[F_VON] + von_k);
  dv = (vibs * tq[5] + mw * 0.7) * b[F_VON] * b[F_VON] * (3 - 2 * b[F_VON]);
  b[F_VM] = 1 + 0.16 * dv * sin(2 * $pi * b[F_VPH]);
  c = bend * 100 + b[F_DET] * (sect_s > 0.5 ? 1 : 0.6) + dm_a * (b[F_PDR] * 7 + glb_d * 4) + dv * 14 * sin(2 * $pi * b[F_VPH]) + tune_c;
  while (nt < 36) ( nt += 12; );  while (nt > 108) ( nt -= 12; );
  ot = ovb_s * tq[14] * (nt > 72) * max(0, min(1, (85 - nt) / 12));  ov = b[F_OT] ? 1 : max(ovb_s * tq[14], b[F_ROB]) * max(0, min(1, 73 - nt));  ot = sqrt(b[F_OT] ? ot : 1 - ot);  b[F_ROB] *= rob_k;
  c += b[F_RDT] + b[F_SCP] * b[F_TG] ^ 0.35;
  c += ov * (nt < 60 ? 10.2 + (60 - nt) * 1.12 : nt < 72 ? 10.2 - (nt - 60) * 0.55 : 3.6 - (nt - 72) * 0.48);
  b[F_RK] == 3 ? c -= 200 * hb_s;
  f = 440 * 2 ^ ((nt - 69) / 12 + c / 1200);
  tp = srate / f;
  w = 2 * $pi * f / srate;
  cut = min(0.45 * srate, (2600 + 9000 * tones * tones) * (0.75 + 0.5 * b[F_P]) * tq[0]);
  b[F_RK] == 2 ? cut = min(cut, 4500);
  b[F_LPC] = 1 - exp(-2 * $pi * cut / srate);  a = 1 - b[F_LPC];
  pdl = atan2(a * sin(w), 1 - a * cos(w)) / w;
  pdc = -((($pi - w) * 0.5) - atan2(dc_r * sin(w), 1 - dc_r * cos(w))) / w;
  b[F_RK] > 0 ? (
    pdc = b[F_RL] == 2 ? pdc : 0;
    rth = atan2(sin(w) * (1 - ap_al * ap_al), 2 * ap_al - (ap_al * ap_al + 1) * cos(w));
    rth <= 0 ? rth += 2 * $pi;
    b[F_DLT] = max(4, min(4090, (b[F_RL] == 1 ? tp * 0.5 * 2 ^ ((3 + (nt - 50) * 0.24 - (b[F_RK] == 2) * (7 + (nt - 84) * 0.6)) / 1200) : ($pi + rth) / w) - pdl - pdc));
    b[F_ROF] = max(0, min(4, (b[F_RK] == 1 ? 1 + 2 * max(0, min(1, edge_s + tq[2])) : 0.6 * max(0, min(1, edge_s + tq[2])) + 0.1) * 1));
    b[F_RCL] = 0.97;
    rdy = min(1, PDV[b[F_PLY] * 12] * (0.42 + 0.58 * b[F_VEL]) * b[F_BRV]);
    b[F_RL] == 1 ? b[F_RPS] = 0.42 + 0.36 * (0.12 + 0.6 * rdy) / 0.72 : (
      b[F_ROF] = 0.6 + 0.18 * max(0, min(1, edge_s + tq[2]));
      rtq = (1 / (0.95 * max(0.5, b[F_LPC] / sqrt(1 - 2 * a * cos(w) + a * a))) - b[F_ROF]) / 0.6;
      b[F_RCL] = (1 - b[F_ROF]) / 0.3;
      b[F_RPS] = rtq * 1.04 + (b[F_RCL] - rtq * 1.04) * (0.12 + 0.6 * rdy);
    );
    b[F_RT] = b[F_RK] == 1 ? 0.45 : b[F_RK] == 2 ? 0.92 : 0.85;
    b[F_RK] == 3 ? ( b[F_HW] = 4 * sin(w * 0.49915) ^ 2;  b[F_ROF] = 0.2 + 1.1 * max(0, min(1, edge_s + tq[2])); );
  ) : b[F_DLT] = max(4, min(4090, tp - 1 - pdl - pdc));
  b[F_DL] = b[F_DL] < 1 ? b[F_DLT] : b[F_DL] + (b[F_DLT] - b[F_DL]) * dlk;
  dn = floor(b[F_DL]) - 1;  q = b[F_DL] - dn;  b[F_N] = dn;
  b[F_H0] = -(q - 1) * (q - 2) * (q - 3) / 6;  b[F_H1] = q * (q - 2) * (q - 3) * 0.5;
  b[F_H2] = -q * (q - 1) * (q - 3) * 0.5;  b[F_H3] = q * (q - 1) * (q - 2) / 6;
  b[F_HM] = b[F_LPC] / sqrt(1 - 2 * a * cos(w) + a * a);
  jr = (0.5 - 0.25 * ov) * b[F_JV] * (1 + dm_a * b[F_PDR] * 0.015) * (1.06 - 0.12 * min(1, b[F_P]));
  jc = 1 - exp(-2 * $pi * min(2 * f, 0.45 * srate) / srate);  ja = 1 - jc;
  pdj = atan2(ja * sin(w), 1 - ja * cos(w)) / w;
  b[F_DJT] = max(1, min(2040, jr * tp - pdj));
  b[F_DJ] = b[F_DJ] < 0.5 ? b[F_DJT] : b[F_DJ] + (b[F_DJT] - b[F_DJ]) * dlk;
  b[F_JI] = floor(b[F_DJ]);  b[F_JF] = b[F_DJ] - b[F_JI];
  hk = max(0, min(1, (nt - 70) / 20));
  b[F_OC] = hk > 0.001 ? 1 - exp(-2 * $pi * min(0.45 * srate, 1.5 * f / hk ^ 0.8) / srate) : 1;
  b[F_OG] = ot * (1 + 0.25 * hk) * (1 + (b[F_OC] < 1) * ((1.5 * f / max(hk, 0.001) ^ 0.8) / f) ^ -2);
  de = (0.9 + 2.6 * tones) * (0.7 + 0.6 * min(1, b[F_P])) * tq[3] * (1 - 0.3 * hk);  b[F_AN] = (1 - 0.82 * b[F_HM]) * 0.6 / max(0.04, 0.5 * (ts(co + 0.6 * de) - ts(co - 0.6 * de)));
  b[F_AD] = de;
  b[F_RK] == 1 ? ( b[F_OC] = tq[0] < 0.5 ? 1 - exp(-2 * $pi * 2400 / srate) : 1;  b[F_OG] = tq[0] < 0.5 ? 1.15 : 1; ) : b[F_RK] == 3 ? ( b[F_OC] = 1;  b[F_OG] = 1; );
  b[F_RK] == 2 ? b[F_OG] *= 10 ^ ((b[F_RL] == 1 ? 2.4 - max(0, nt - 88) * 1.6 : max(-2.5, (70 - nt) * 0.62 - 1)) / 20);
  b[F_HST] = f * hr_t / srate;
  b[F_HZ] = jc;
);

function cr_tick() local(k, b, act, pl, g, need, busy, nout) (
  vibs += (vib_t - vibs) * crk;
  hb_s += (max(ex_br, ex_at) - hb_s) * crk * 0.5;
  hw_ph += 4.8 * CR / srate;  hw_ph -= floor(hw_ph);
  hw_w = fl_s * (0.5 - 0.5 * cos(2 * $pi * hw_ph));
  hw_c = max(0, min(1, (1 - tones) + hw_w * 0.9));
  hw_g = 1 - 0.45 * hw_w;
  hm_w = 2 * $pi * max(350, 1400 - 750 * hw_c - 400 * hb_s) / srate;  hm_r = 0.93 + 0.04 * hw_c;  fh_b1 = hm_r * hm_r;  fh_a1 = 2 * hm_r * cos(hm_w);  fh_g1 = (1 - hm_r) * sqrt(1 - 2 * hm_r * cos(2 * hm_w) + fh_b1);
  hm_w = 2 * $pi * (3100 - 900 * hw_c) / srate;  fh_b2 = 0.93 * 0.93;  fh_a2 = 2 * 0.93 * cos(hm_w);  fh_g2 = (1 - 0.93) * sqrt(1 - 2 * 0.93 * cos(2 * hm_w) + fh_b2);
  hw_lk = 1 - exp(-2 * $pi * 12000 * (0.11 + 0.89 * (1 - hw_c) ^ 2) / srate);
  ovb_s += (ovb_t - ovb_s) * crk * 0.7;
  tones += (tone_t - tones) * crk;
  k = 0;  loop(5, b = PTS + k * 16;  pl = TYP + PTI[k] * TYN;  g = 0;  loop(15, b[g] += (pl[g] - b[g]) * crk;  g += 1; );  k += 1; );
  sect_s = sect_t;
  sh_dt = CR / srate;
  sh_st = 15 / max(40, min(300, tempo > 0 ? tempo : 120)) * srate;
  SHO[0] = 0;  PHG[0] = 1;  k = 1;
  loop(4,
    sh_t = SHT[k];  sh_bt = 2 ^ (6 - max(1, min(6, floor(sh_t + 0.5)))) * max(1, ts_num | 0) * 4 / (ts_denom > 0 ? ts_denom : 4) * 60 / max(20, tempo > 0 ? tempo : 120) / 1.55;
    pat_play && !snap && sh_t > 0.5 && sect_on ? (
      PHP[k] += sh_dt / (sh_bt * 1.55);  PHP[k] >= pat_L ? PHP[k] -= pat_L;  PHS[k] = 0;  PHT[k] = sh_bt * 0.55;  PHG[k] = 1;
    ) : sh_t > 0.5 && sect_on && !leg_on ? (
      PHS[k] == 0 ? (
        PHT[k] = min(PHT[k], sh_bt * 0.55) - sh_dt;
        PHT[k] <= 0 ? ( PHS[k] = 1;  PHF[k] = PHP[k];  PHT[k] = 0; );
      ) : PHS[k] == 1 ? (
        PHT[k] += sh_dt / sh_bt;
        sh_u = min(1, PHT[k]);  PHP[k] = PHF[k] + sh_u * sh_u * (3 - 2 * sh_u);
        PHT[k] >= 1 ? ( PHP[k] = PHF[k] + 1;  PHP[k] >= 3.999 && !pat_play ? ( PHS[k] = 2;  PHT[k] = 0.4;  PHG[k] = 0; ) : ( PHS[k] = 0;  PHT[k] = sh_bt * 0.55;  pat_play && PHP[k] >= pat_L - 0.001 ? PHP[k] -= pat_L; ); );
      ) : (
        PHT[k] -= sh_dt;
        PHT[k] <= 0 ? ( PHS[k] == 2 ? ( PHS[k] = 3;  PHT[k] = 0.35;  PHP[k] = 0;  pq_drop(k, -1);  sh_i = 0;  loop(NV, sh_b = VOX + sh_i * VS;  sh_b[F_PLY] == k ? sh_b[F_GATE] = 0;  sh_i += 1; ); ) : ( PHS[k] = 0;  PHT[k] = sh_bt * 0.55;  PHG[k] = 1; ); );
      );
    ) : (
      pat_play && PHP[k] > pat_L * 0.5 ? ( PHP[k] += sh_dt * 0.5;  PHP[k] >= pat_L ? PHP[k] = 0; ) : PHP[k] = max(0, PHP[k] - sh_dt * 0.5);  PHS[k] = 0;  PHT[k] = sh_bt * 0.55;  PHG[k] = 1;
    );
    SHO[k] = pat_play ? 0 : PHP[k] * sh_st;
    k += 1;
  );
  k = 0;
  loop(NV,
    b = VOX + k * VS;
    b[F_ON] ? (
      cr_slot(b);
      b[F_VPH] += vrate * b[F_VRT] * (1 + dm_a * b[F_PDR] * 0.04) * CR / srate;  b[F_VPH] -= floor(b[F_VPH]);
    );
    k += 1;
  );
  pl = 0;  nout = 0;
  loop(5,
    act = 0;  k = 0;
    loop(NV, b = VOX + k * VS;  act |= b[F_ON] && (b[F_GATE] || b[F_SUS]) && b[F_PLY] == pl && sect_on;  k += 1; );
    busy = 0;  k = 0;  loop(5, k != pl && PLS[k] > 0 ? busy = 1;  k += 1; );
    PLS[pl] == 0 ? (
      act ? PLN[pl] -= CR / (srate * max(3, lung_t));
      need = PLN[pl] <= 0 && act;
      need && (!busy || PLN[pl] < -0.35) ? ( PLS[pl] = 1;  PLT[pl] = 0.35 + rand(1) * 0.1; );
      g = (0.8 + 0.2 * min(1, max(0, PLN[pl]) * 4)) * (1 + 0.16 * PLF[pl]);
    ) : PLS[pl] == 1 ? (
      PLT[pl] -= CR / srate;  g = 0;
      PLT[pl] <= 0 ? ( PLS[pl] = 2;  PLT[pl] = 0.7 + rand(1) * 0.35;  PLH[pl] = 1; );
    ) : PLS[pl] == 2 ? (
      PLT[pl] -= CR / srate;  g = 0;
      PLN[pl] = min(1, PLN[pl] + CR / srate * 1.4);
      PLT[pl] <= 0 ? ( PLS[pl] = 3;  PLT[pl] = 0.45;  PLN[pl] = 1;  PLH[pl] = 0;  PLF[pl] = 1; );
    ) : (
      PLT[pl] -= CR / srate;  g = 1 + 0.16 * PLF[pl];
      PLT[pl] <= 0 ? PLS[pl] = 0;
    );
    PLF[pl] *= plf_k;
