    u_nz = rand(2) - 1;
    vb[F_NZ] += (u_nz - vb[F_NZ]) * nlp_c;  u_nz = vb[F_NZ];
    vb[F_RK] > 2.5 ? (
      u_dh = u_tq[0] * (0.42 + 0.58 * vb[F_VEL]) * vb[F_BRV];
      u_ps = max(0, u_pr / max(0.05, u_dh) * (1 + u_nz * u_tq[3] * 0.3 * u_ta));
      u_hg = 0.006 * (u_ps - 0.35);
      u_hx = vb[F_HX];  u_hv = vb[F_HV];
      u_hv += -vb[F_HW] * u_hx + (u_hg > 0 ? u_hg * (1 - u_hx * u_hx) : max(-0.01, u_hg)) * u_hv + u_nz * 0.00003 * u_ps;
      u_hx = max(-4, min(4, u_hx + u_hv));  vb[F_HX] = u_hx;  vb[F_HV] = u_hv;
      u_y = max(0, u_hx - vb[F_ROF]) * sqrt(min(1.3, u_ps));
      u_dc = u_y - vb[F_DCX] + dc_r * vb[F_DCY];  vb[F_DCX] = u_y;  vb[F_DCY] = u_dc;
      vb[F_LV] += (abs(u_dc) - vb[F_LV]) * env_k;
      u_y = (u_dc - vb[F_RT] * vb[F_RX]) * HLEV * sqrt(min(1.2, u_dh));  vb[F_RX] = u_dc;
      u_fa = u_y * fh_g1 + fh_a1 * vb[F_FA] - fh_b1 * vb[F_FB];  vb[F_FB] = vb[F_FA];  vb[F_FA] = u_fa;
      u_fc = u_y * fh_g2 + fh_a2 * vb[F_FC] - fh_b2 * vb[F_FD];  vb[F_FD] = vb[F_FC];  vb[F_FC] = u_fc;
      u_y = (u_y * (0.55 - 0.3 * hw_c) + u_fa * (0.9 + 0.8 * hw_c) + u_fc * 0.6 * (1 - 0.6 * hw_c)) * hw_g;
      vb[F_FE] += (u_y - vb[F_FE]) * hw_lk;  vb[F_FF] += (vb[F_FE] - vb[F_FF]) * hw_lk;  u_y = vb[F_FF];
      u_dc = u_y;
    ) : vb[F_RK] > 0 ? (
      u_wp = vb[F_W];
      u_dh = u_tq[0] * (0.42 + 0.58 * vb[F_VEL]) * vb[F_BRV];
      u_ps = min(vb[F_RCL] * 0.96, u_pr / max(0.05, u_dh) * vb[F_RPS] * (1 + u_nz * u_tq[3] * 0.3 * u_ta));
      u_rt = vb[F_TG];  u_rh = 1 - 0.6 * min(1, u_tq[4]);
      u_rt > u_rh && vb[F_GATE] ? u_ps *= 0.04 : vb[F_GATE] ? u_ps = max(u_ps, min(vb[F_RCL] * 0.96, vb[F_RPS] * min(1, 1.6 * u_tq[4]) * (1 + 0.6 * min(1, u_tq[4]) * u_rt / u_rh)));
      u_rc = u_rt <= u_rh && u_rt > u_rh - 0.12 ? (u_rt - u_rh + 0.12) / 0.12 * u_tq[4] * vb[F_VEL] : 0;
      vb[F_RK] == 2 && u_rc > 0 ? u_ps = min(vb[F_RCL] * 1.08, u_ps * (1 + 0.5 * (u_rt - u_rh + 0.12) / 0.12));
      u_bb = vb[F_BB];
      u_ri = u_wp - vb[F_N];
      u_r = vb[F_H0] * u_bb[u_ri & BOM] + vb[F_H1] * u_bb[(u_ri - 1) & BOM] + vb[F_H2] * u_bb[(u_ri - 2) & BOM] + vb[F_H3] * u_bb[(u_ri - 3) & BOM];
      vb[F_LP] += (u_r - vb[F_LP]) * vb[F_LPC];
      u_y = vb[F_LP];
      u_dc = u_y - vb[F_DCX] + dc_r * vb[F_DCY];  vb[F_DCX] = u_y;  vb[F_DCY] = u_dc;
      vb[F_RL] == 1 ? ( u_ym = -0.95 * u_y;  u_rq = 2 * u_ym; ) : (
        u_yd = -0.95 * u_dc;  u_ym = ap_al * u_yd - vb[F_RAX] + ap_al * vb[F_RAY];  vb[F_RAX] = u_yd;  vb[F_RAY] = u_ym;  u_rq = u_yd + u_ym;
      );
      u_x = u_ps - u_rq;
      vb[F_RL] == 2 ? ( u_pd = u_ym - u_ps;  u_fq = u_ps + u_pd * max(-1, min(1, vb[F_ROF] - 0.3 * u_pd)) - u_ym; ) : u_x <= 0 ? u_fq = 0 : u_x >= 1 ? u_fq = 0 : (
        u_xi = u_x * 1023;  u_k = u_xi | 0;  u_xf = u_xi - u_k;  u_zi = vb[F_ROF];  u_zk = min(3, u_zi | 0);  u_zf = u_zi - u_zk;
        u_l0 = RLUT + u_zk * 1025 + u_k;  u_l1 = u_l0 + 1025;
        u_fq = (u_l0[0] + (u_l0[1] - u_l0[0]) * u_xf) * (1 - u_zf) + (u_l1[0] + (u_l1[1] - u_l1[0]) * u_xf) * u_zf;
      );
      u_bb[u_wp & BOM] = u_ym + u_fq + (u_rc > 0 ? (u_rt - u_rh + 0.12) * 1.2 * u_ps : 0);
      vb[F_RL] == 9 ? ( u_mp = u_rq + u_fq;  u_dc = u_mp - vb[F_HX] + dc_r * vb[F_HV];  vb[F_HX] = u_mp;  vb[F_HV] = u_dc;  u_dc *= RMP; );
      vb[F_W] = u_wp + 1;
      vb[F_LV] += (abs(u_dc) - vb[F_LV]) * env_k;
      u_y = (u_dc - vb[F_RT] * vb[F_RX]) * RLEV * sqrt(min(1.2, u_dh)) + u_nz * u_rc * 0.05;  vb[F_RX] = u_dc;
      vb[F_RK] == 2 ? (
        u_fa = (u_y - vb[F_FF]) * fo_g1 + fo_a1 * vb[F_FA] - fo_b1 * vb[F_FB];  vb[F_FB] = vb[F_FA];  vb[F_FA] = u_fa;  vb[F_FF] = vb[F_FE];  vb[F_FE] = u_y;
        u_fc = (u_y - vb[F_FH]) * fo_g2 + fo_a2 * vb[F_FC] - fo_b2 * vb[F_FD];  vb[F_FD] = vb[F_FC];  vb[F_FC] = u_fc;  vb[F_FH] = vb[F_FG];  vb[F_FG] = u_y;
        u_y = u_y * 0.3 + u_fa * 1.3 + u_fc * 2.6;
      );
    ) : (
    u_bv = vb[F_BV];
    u_ji = u_bv + u_nz * u_tq[3] * u_ta * (0.3 + u_pr) * (1 + 3 * u_tg * u_tq[4] + 2 * u_fe * (1 - u_f));
    u_wp = vb[F_W];
    u_jb = vb[F_JB];
    u_jb[u_wp & JTM] = u_ji;
    u_ri = u_wp - vb[F_JI];  u_j0 = u_jb[u_ri & JTM];
    u_jd = u_j0 + (u_jb[(u_ri - 1) & JTM] - u_j0) * vb[F_JF];
    vb[F_ENV] += (u_jd - vb[F_ENV]) * vb[F_HZ];  u_jd = vb[F_ENV];
    vb[F_LV] += (abs(u_jd) - vb[F_LV]) * env_k;
    u_jn = u_jd / (vb[F_LV] * 1.5 + 0.02);
    u_src = -u_U * (ts(vb[F_AD] * u_jn + u_tq[1]) - u_tq[2]) * vb[F_AN];
    u_x = 0.82 * u_bv + u_src;
    u_bb = vb[F_BB];
    u_bb[u_wp & BOM] = u_x;
    u_ri = u_wp - vb[F_N];
    u_r = vb[F_H0] * u_bb[u_ri & BOM] + vb[F_H1] * u_bb[(u_ri - 1) & BOM] + vb[F_H2] * u_bb[(u_ri - 2) & BOM] + vb[F_H3] * u_bb[(u_ri - 3) & BOM];
    vb[F_LP] += (u_r - vb[F_LP]) * vb[F_LPC];
    u_y = vb[F_LP];
    u_dc = u_y - vb[F_DCX] + dc_r * vb[F_DCY];  vb[F_DCX] = u_y;  vb[F_DCY] = u_dc;
    vb[F_BV] = u_dc;
    vb[F_W] = u_wp + 1;
    u_y = u_dc;
    );
    vb[F_OC] < 1 ? (
      vb[F_OA] += (u_y - vb[F_OA]) * vb[F_OC];  vb[F_OB] += (vb[F_OA] - vb[F_OB]) * vb[F_OC];  u_y = vb[F_OB] * vb[F_OG];
    ) : ( vb[F_OA] = vb[F_OB] = u_y;  u_y *= vb[F_OG]; );
    u_o = u_y * 1.6 + u_nz * u_tq[5] * u_pr * u_ta  + u_nz * u_tg * u_tg * u_tq[4] * vb[F_VEL] * 0.06;
    hum_s > 0.0005 ? u_o += vb[F_HLP] * hum_s * u_U * 0.09;
    u_tq[6] > 0.001 ? (
      vb[F_BZP] = max(abs(u_dc), vb[F_BZP] * bzp_k);
      u_m = abs(u_dc) - 0.62 * vb[F_BZP];  u_m = u_m > 0 ? (u_dc > 0 ? u_m : -u_m) : 0;
      u_o += (u_m - vb[F_BZ]) * u_tq[6] * 9;  vb[F_BZ] = u_m;
    );
    u_tq[7] > 0.001 ? u_o += u_nz * abs(u_dc) * u_tq[7] * 0.45;
    vb[F_FIN] < 1 ? ( u_w = 0.5 - 0.5 * cos($pi * vb[F_FIN]);  vb[F_FIN] = min(1, vb[F_FIN] + fin_step); ) : u_w = 1;
    u_o *= u_w * vb[F_FADE] * u_nm * u_tq[8] * (sect_on ? PMG[vb[F_PLY]] : 1);
    vb[F_RAD] += (abs(u_o) - vb[F_RAD]) * lv_k;
    yl += u_o * vb[F_GL];  yr += u_o * vb[F_GR];
    vb[F_STEAL] ? (
      vb[F_FADE] -= fade_step;
      vb[F_FADE] <= 0 ? (
        vb[F_FADE] = 0;  vb[F_STEAL] = 0;  vb[F_LV] = 0;  vb[F_P] = 0;
        vb[F_PEND] >= 0 ? v_place(vb, vb[F_PEND], vb[F_PVEL], vb[F_PPLY], vb[F_PGID], vb[F_PN]) : vb[F_ON] = 0;
      );
    ) : !vb[F_GATE] && !vb[F_SUS] && u_p < 0.0002 && vb[F_RAD] < 0.00002 && u_tg < 0.001 ? (
      vb[F_ON] = 0;  vb[F_LV] = 0;  vb[F_P] = 0;
    );
    );
  );
  vb += VS;
);

u_ih > 0.0005 ? (
  in_n += ((rand(2) - 1) - in_n) * 0.35;  in_h += (in_n - in_h) * 0.02;
  u_in = (in_n - in_h) * u_ih * 0.012 * blow_s;
  yl += u_in * PDV[8];  yr += u_in * 0.85 * PDV[8];
);
click_req > 0 ? ( ck_x = min(1.5, click_req) * keys_s * keys_s;  click_req = 0;  ck_n = floor(0.0006 * srate); );
ck_n > 0 ? ( u_ci = ck_x * (rand(2) - 1) * 0.05;  ck_n -= 1; ) : u_ci = 0;
ck_e > 0.0000001 || u_ci != 0 ? (
  u_c1 = u_ci + ck_a1 * ck_ay1 - ck_a2 * ck_ay2;  ck_ay2 = ck_ay1;  ck_ay1 = u_c1;
  u_c2 = u_ci + ck_b1 * ck_by1 - ck_b2 * ck_by2;  ck_by2 = ck_by1;  ck_by1 = u_c2;
  u_c3 = u_ci + ck_c1 * ck_cy1 - ck_c2 * ck_cy2;  ck_cy2 = ck_cy1;  ck_cy1 = u_c3;
  u_ck = u_c1 * 0.012 + u_c2 * 0.03 + u_c3 * 0.05;
  ck_e = abs(ck_ay1) + abs(ck_by1) + abs(ck_cy1) + abs(u_ci);
  yl += u_ck * PDV[8];  yr += u_ck * 0.9 * PDV[8];
);

dc_xl = yl - dc_pl + odc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + odc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
yl *= out_g * sect_g;  yr *= out_g * sect_g;
pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;
pl_dl = yl;  pl_dr = yr;
sp_live ? (
  bv_pre(yl, yr);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, 0.62);
  fdn_run(dif_l, dif_r);
  yl += fdn_l * 0.6 * spm_s;  yr += fdn_r * 0.6 * spm_s;
);
pl_live ? (
  pl_run(pl_dl, pl_dr);
  yl += pl_l * vb_s * 0.5;  yr += pl_r * vb_s * 0.5;
);
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;
);

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;
file_avail(0) != 0 ? ( file_var(0, PATN);  file_mem(0, PAT, 32);  file_mem(0, PATV, 32); );
pwr_ser();

@gfx 900 400
ui_begin(900, 400);
v5_begin();
YRF = 0x1E4A44;  YRB = 0x0A1C1D;  YRA = 0x4FE0B0;  YRI = 0xE4F0EC;  YRH = 0x0A1C1D;  YRV = 0xFFD58A;
YRY = 0xF1E2B8;  YC1 = 0xA8D4C4;  YC2 = 0xE0B860;  YC3 = 0x4FE0B0;
YRIN = 0x9C7244;
sc != yr_fsc ? (
  yr_fsc = sc;
  yr_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  yr_f6 = ui_fitfont(6, 26 * sc);
);
function yr_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * yr_kt * sc, 'b'); );
function yr_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function yr_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function yr_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function yr_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function yr_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A8D90); v5_d(x, y, 4); ui_col(0xBCBEC0); v5_d(x - 0.8, y - 0.8, 2.4); );
function yr_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.12); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.16)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
);
function yr_pocket(x, y, w, h) ( yr_cham(x, y, w, h, 3, YRF); ui_col(YRIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function yr_title(x, y, s, c) ( yr_ft(17); ui_col(YRY); yr_tl(x, y, s); ui_col(c); v5_r(x, y + 13, yr_tw(s), 3); );
function yr_hover(cx, cy, fs) ( yr_hon = 1; yr_hx = cx; yr_hy = cy; yr_hfs = fs; );
function yr_fmt(idx) local(v) (
  v = slider(idx);
  idx == 8 || idx == 9 ? ( v < 1000 ? sprintf(#yr_hv, "%d ms", v) : sprintf(#yr_hv, "%.2f s", v / 1000); )
  : idx == 7 ? ( v < 0.1 ? sprintf(#yr_hv, "%.3f Hz", v) : v < 1 ? sprintf(#yr_hv, "%.2f Hz", v) : sprintf(#yr_hv, "%.1f Hz", v); )
  : idx == 24 ? ( v < 1000 ? sprintf(#yr_hv, "%d ms", v) : sprintf(#yr_hv, "%.2f s", v / 1000); )
  : idx == 16 ? sprintf(#yr_hv, "%d", v)
  : idx == 17 ? sprintf(#yr_hv, "%.1f s", v)
  : idx == 21 ? sprintf(#yr_hv, "%+.1f dB", v)
  : idx == 26 || idx >= 36 ? ( v < 0.5 ? strcpy(#yr_hv, "OFF") : v > 5.5 ? strcpy(#yr_hv, "1 BAR") : sprintf(#yr_hv, "%d BARS", 2 ^ (6 - floor(v + 0.5))); )
  : sprintf(#yr_hv, "%d %%", v * 100 + 0.5);
);
function yr_dial(cx, cy, r, idx, lo, hi, def, lg, lbl, ptr, fs) local(n, a, i, t, rs) (
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 8), 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(0xD8D2C4); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  v5_shc(cx, cy, r);
  ui_col(0x121416); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2A2E30); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xB4B8B4); v5_d(cx, cy, r * 0.74);
  ui_col(yr_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, ptr);
  v5_act ? ( yr_fmt(idx); yr_hover(cx, cy + r + 19, fs); ) : ( yr_ft(fs); ui_col(YRI); v5_t(cx, cy + r + 19, lbl); );
);
function yr_grey(x, y, w, h) ( ui_cola(YRIN, 0.6); v5_r(x, y, w, h); );
function yr_led(x, y, c, g) local(i) (
  ui_col(0x050505); v5_d(x, y, 5.5);
  ui_col(ui_mix(c, 0x101010, 0.78)); v5_d(x, y, 4);
  g > 0.01 ? (
    i = 0; loop(5, ui_cola(c, 0.07 * g); v5_d(x, y, 4 + 2.2 * (5 - i)); i += 1; );
    ui_cola(c, g); v5_d(x, y, 4);
    ui_cola(ui_mix(c, 0xFFFFFF, 0.6), 0.85 * g); v5_d(x - 1, y - 1.2, 1.6);
  );
);
function yr_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050505); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x1A1A1A); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  c0 = ui_mix(0x9EA49A, 0xC6CCBF, 0.44); c1 = 0xC6CCBF; c2 = ui_mix(0x9EA49A, 0xC6CCBF, 0.16);
  yr_grad(x, y, w, h * 0.4, c0, c1); yr_grad(x, y + h * 0.4, w, h * 0.6, c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function yr_arrkey(x, y, w, h, dir) local(cx, cy) (
  v5_keycap(x, y, w, h, 0, 0x3A3E41, 0x4A4F53, v5_cr, "", -1);
  cx = x + w / 2; cy = y + h * 0.42; ui_col(v5_cr);
  dir < 0 ? gfx_triangle((cx - 5.5) * sc, cy * sc, (cx + 3.5) * sc, (cy - 5.5) * sc, (cx + 3.5) * sc, (cy + 5.5) * sc)
          : gfx_triangle((cx + 5.5) * sc, cy * sc, (cx - 3.5) * sc, (cy - 5.5) * sc, (cx - 3.5) * sc, (cy + 5.5) * sc);
);
function yr_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#yr_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 38, 34) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
  v5_pr && v5_drag == 0 && v5_hit(x + 42, y, 38, 34) ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; v5_drag = -1; );
