function pname(n) ( n==0 ? "Burl Grain" : n==1 ? "Bongo Ping" : n==2 ? "Fold Engine" : n==3 ? "Laser Clave" : n==4 ? "Vactrol Rain" : n==5 ? "Industrial Scrape" : n==6 ? "Metal Rite" : n==7 ? "Sluggish Gate" : n==8 ? "Oak Knot" : n==9 ? "Ringing Hollow" : n==10 ? "Zap Ritual" : n==11 ? "Dead Reckoning" : n==12 ? "Polymeter Grove" : n==13 ? "Tangle Root" : n==14 ? "Fold Storm" : n==15 ? "Slow Vactrol" : n==16 ? "Seven Against Five" : "Warm Optocouplers" );
function load_bank(b) local(i) ( memcpy(PAT, BANK + clampv(b, 0, 5)*384, 384); i = 0; loop(24, LEN[i] = 16; i += 1; ); );
function unc_v(s, v) ( UNC[s*18 + v*3] = rand(2) - 1; UNC[s*18 + v*3 + 1] = rand(2) - 1; UNC[s*18 + v*3 + 2] = rand(2) - 1; );
function unc_new(s) local(v) ( v = 0; loop(18, UNC[s*18 + v] = rand(2) - 1; v += 1; ); );
function unc_all() local(s) ( s = 0; loop(16, unc_new(s); s += 1; ); );
function load_preset(n) local(i, g) (
  n = clampv(floor(n), 0, NPRE - 1);
  i = 0; loop(54, slider(10 + i) = PRV[n*54 + i]; i += 1; );
  g = PRG + n*14;
  slider4 = g[1]; slider5 = g[2]; slider64 = g[3]; ulock_d = g[4]; slider6 = g[5]; slider7 = g[6]; slider8 = g[7];
  prs_cur_d = n + 1;
  load_bank(g[0]); unc_all();
  i = 0; loop(24, LEN[i] = g[8 + (i % 6)]; i += 1; );
  i = 1; loop(63, sliderchange(2^(i - 1)); i += 1; ); sliderchange(slider64);
);
load_bank(PRG[0]); unc_all(); ulock_d = PRG[4];

function blep(t, dt) ( t < dt ? (t /= dt; 2*t - t*t - 1) : t > 1 - dt ? (t = (t - 1)/dt; t*t + 2*t + 1) : 0 );
function sqw(ph, dt) local(y, t) ( y = (ph < 0.5 ? 1 : -1) + blep(ph, dt); t = ph + 0.5; t -= floor(t); y - blep(t, dt) );
function tri(ph) ( ph -= floor(ph); 1 - 4*abs(ph - 0.5) );
function th(x) local(x2) ( x = clampv(x, -3, 3); x2 = x*x; x*(27 + x2)/(27 + 9*x2) );
function adaa_c(x) instance(xp, fp) local(f, y) (
  f = abs(x) <= 1 ? 0.5*x*x : abs(x) - 0.5;
  abs(x - xp) > 0.000001 ? ( y = (f - fp)/(x - xp); ) : ( y = clampv(0.5*(x + xp), -1, 1); );
  xp = x; fp = f; y;
);
function dcb(x) instance(x1, y1) ( y1 = x - x1 + 0.9995*y1; x1 = x; y1 );

function ev_add(ofs, v, vel, k) local(i) (
  ne < 256 ? (
    i = ne; while (i > 0 && EVO[i - 1] > ofs) ( EVO[i] = EVO[i - 1]; EVV[i] = EVV[i - 1]; EVL[i] = EVL[i - 1]; EVK[i] = EVK[i - 1]; i -= 1; );
    EVO[i] = ofs; EVV[i] = v; EVL[i] = vel; EVK[i] = k; ne += 1;
  );
);

function v_ctl(v) local(d, fo, dm, k, t) (
  d = VS + v*64;
  fo = vp(v, 2)/100 + slider6/200 + d[36] + WLK[v*3 + 1]*0.12*drift;
  fo = clampv(fo, 0, 1.3);
  d[16] = 1 + fo*(v == 0 ? 3 : v == 4 ? 7 : 5.5);
  dm = 2^(slider7/50);
  t = max(0.008, d[31]*dm);
  k = 1 + WLK[v*3 + 2]*0.25*drift;
  d[4] = min(0.5, 6.9/(t*srate)*k);
  d[42] = 1 - exp(-1/(0.0015*srate/k));
  d[28] = vnorm(v)*(vp(v, 8)/100)^1.5*1.5;
  t = (vp(v, 7)/100 + 1)*$pi/4; d[29] = cos(t)*1.4142; d[30] = sin(t)*1.4142;
  d[34] = vp(v, 6)/100;
  d[35] = vp(v, 3)/100;
);

function v_strike(v, vel, k) local(d, s, us, ua, tg, st, tune, snap, ch, dec, tc, pit) (
  d = VS + v*64;
  s = floor(k/4) - 1; k = k % 4;
  s < 0 ? ( s = CNT[v] % 16; !ulock_d ? unc_new(s); CNT[v] += 1; );
  us = UNC + s*18 + v*3;
  ua = sqr(slider5/100); tg = slider64|0;
  tune = vp(v, 0) + (k == 1 ? 19 : 0) + ((tg & 1) ? us[0]*ua*12 : 0);
  pit = tune + (WLK[v*3]*25*drift + (rand(2) - 1)*4*drift)/100;
  d[36] = (tg & 2) ? us[1]*ua*0.6 : 0;
  st = vp(v, 4)/100; snap = vp(v, 1)/100; ch = vp(v, 3)/100; dec = vp(v, 5)/100;
  d[15] = basef(v)*2^(pit/12);
  d[33] = snap*(v == 0 ? 3 : v == 1 ? 1.5 : v == 4 ? 0.5 : v == 5 ? 5 : 1);
  tc = v == 0 ? 0.005 + ch*ch*0.15 : v == 1 ? 0.012 : v == 4 ? 0.01 : v == 5 ? 0.05 : 0.02;
  d[13] = 1; d[44] = exp(-8/(tc*srate)); d[43] = 0;
  d[31] = 0.02*150^dec*((tg & 4) ? 2^(us[2]*ua*1.5) : 1)*(k == 2 ? 6 : k == 1 ? 0.5 : 1);
  d[31] = min(d[31], 10);
  d[22] = k;
  d[1] < 0.02 ? ( d[7] = 0; d[8] = 0; d[9] = rand(); d[10] = rand(); d[11] = rand(); d[12] = rand(); d[17] = 0; );
  v_ctl(v);
  d[2] = floor((0.0005 + st*0.006)*srate); d[3] = min(1, (0.4 + 0.6*(vel/127)^1.3)*(0.6 + 0.4*st));
  d[20] = st*vel/127*0.35;
  d[0] = 1;
  HIT[v] = 1;
);

sq_was = 0; sq_fb = 0; sq_exp = -1; sq_step = -1; ne = 0;
sel = 0;
vf = 1; pending = -1; vfstep = 1/(0.004*srate); opkd = exp(-1/(0.25*srate));
t = tan($pi*2400/srate); hp1 = 1/(1 + t*(t + 1.4142)); hp2 = t*hp1; hp3 = t*hp2; outg_s = 10^(slider9/20);
drift = slider8/100;
i = 0; loop(6, v_ctl(i); i += 1; );

function bu_req(k) ( pending = k - 1; pend_t = time_precise(); pend_s = bu_spos; );

function prs_hash() local(i, h) ( h = 0; i = 1; loop(65, i != 65 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; bu_req(k);
    k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( bu_req(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;
function gap_clear() local(i) (
  memset(VS, 0, 6*64); memset(SCB, 0, 1024); memset(ENVH, 0, 200);
  ne = 0; ei = 0; bus = 0; busn = 0;
  dcL.x1 = dcL.y1 = dcR.x1 = dcR.y1 = 0; cpL.xp = cpL.fp = cpR.xp = cpR.fp = 0;
  i = 0; loop(6, v_ctl(i); i += 1; );
);
pwr_init(); pwr_hum_db = -80.5; pwr_sag = 0.15; pwr_wu_loss = 0.4; pwr_wu_drv = 0.5; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
drift = slider8/100;

@block
prs_chk();
bu_now = time_precise();
bu_tp > 0 && bu_now - bu_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > bu_gpp && play_position - bu_gpp < 4 * bu_gpd + 0.05) ? gap_clear();
bu_tp = bu_now; bu_gpp = play_position; bu_gpd = samplesblock / srate;
pwr_block(1);
drift = slider8/100;
outg_t = 10^(slider9/20);
dtb = samplesblock/srate;
i = 0; loop(18, WLK[i] += -WLK[i]*dtb/6 + 0.45*sqrt(dtb)*(rand() + rand() + rand() - 1.5)*2; i += 1; );
i = 0; loop(6, (VS + i*64)[0] ? v_ctl(i); i += 1; );

while (ei < ne) ( v_strike(EVV[ei], EVL[ei], EVK[ei]); ei += 1; );
ne = 0; ei = 0; spos = 0;

while (midirecv(mo, m1, m2, m3)) (
  1 ? (
    mst = m1 & 0xF0;
    mst == 0x90 && m3 > 0 ? (
      mid_n += 1;
      m2 == 36 || m2 == 35 ? ev_add(mo, 0, m3, 0) :
      m2 == 38 || m2 == 40 ? ev_add(mo, 1, m3, 0) :
      m2 == 37 ? ev_add(mo, 1, m3, 1) :
      m2 == 48 || m2 == 50 ? ev_add(mo, 2, m3, 0) :
      m2 == 45 || m2 == 47 || m2 == 43 || m2 == 41 || m2 == 58 ? ev_add(mo, 3, m3, 0) :
      m2 == 42 || m2 == 44 ? ev_add(mo, 4, m3, 0) :
      m2 == 46 || m2 == 51 || m2 == 53 || m2 == 59 ? ev_add(mo, 4, m3, 2) :
      m2 == 49 || m2 == 52 || m2 == 55 || m2 == 57 ? ev_add(mo, 5, m3, 0);
    ) :
    mst == 0xB0 && (m2 == 120 || m2 == 123) ? ( i = 0; loop(6, d = VS + i*64; d[2] = 0; d[31] = 0.005; v_ctl(i); i += 1; ); );
  );
  midisend(mo, m1, m2, m3);
);

sq_play = play_state & 1;
sq_on = slider1 >= 0.5 || (slider2 >= 0.5 && sq_play);
sq_bps = tempo/60/srate;
sq_on ? (
  sq_play ? ( sq_t0 = beat_position; ) : ( !sq_was || sq_wasplay ? sq_fb = 0; sq_t0 = sq_fb; );
  sq_t1 = sq_t0 + sq_bps*samplesblock;
  sq_L = 0.25; sq_sw = slider4/100; sq_tp = clampv(slider3|0, 0, 3);
  !sq_was ? sq_pat = sq_tp;
  k = floor(sq_t0/sq_L) - 1;
  while (k*sq_L < sq_t1) (
    tv = (k & 1) ? k*sq_L + sq_L*sq_sw : k*sq_L;
    k >= 0 && tv >= sq_t0 && tv < sq_t1 ? (
      k % 16 == 0 ? sq_pat = sq_tp;
      ofs = min(floor((tv - sq_t0)/sq_bps), samplesblock - 1);
      i = 0;
      loop(6,
        ln = LEN[sq_pat*6 + i]; ln = ln < 1 ? 16 : min(ln, 16);
        s = k % ln;
        !ulock_d ? unc_v(s, i);
        c = PAT[(sq_pat*6 + i)*16 + s];
        c > 0 ? ev_add(ofs, i, c == 2 ? 127 : c == 3 ? 110 : 96, (i == 4 && c == 3 ? 2 : 0) + 4*(s + 1));
        i += 1;
      );
    );
    k*sq_L >= sq_t0 && k*sq_L < sq_t1 && k >= 0 ? ( sq_step = k % 16; sq_k = k; );
    k += 1;
  );
  sq_exp = sq_t1;
  !sq_play ? sq_fb = sq_t1;
) : (
  sq_step = -1; sq_pat = clampv(slider3|0, 0, 3);
);
sq_was = sq_on; sq_wasplay = sq_play;
aud_d > 0 ? ( ev_add(0, aud_d - 1, 110, 0); aud_d = 0; );
pend_done_d ? ( pend_done_d = 0; pending = -1; vf = 1; );
pk_disp = max(pk_disp, bu_pk); bu_pk = 0;
mid_d = mid_n;

eh_p = (eh_p + 1) % 200; ENVH[eh_p] = (VS + sel*64)[1];

@sample
bu_spos += 1;
while (ei < ne && (EVO[ei] <= spos || spos >= samplesblock - 1)) ( v_strike(EVV[ei], EVL[ei], EVK[ei]); ei += 1; );
spos += 1;

oL = oR = 0; busn = 0;
v = 0; d = VS;
loop(6,
  d[0] ? (
    g = d[1];
    d[2] > 0 ? ( g += (d[3] - g)*d[42]; d[2] -= 1; ) : ( g *= 1 - d[4]*(0.3 + 0.7*g); );
    d[1] = g;
    (d[43] -= 1) <= 0 ? (
      d[43] = 8;
      d[13] *= d[44];
      d[37] = d[15]*2^(d[33]*d[13]);
      fc = min((v == 4 ? 700 : v == 1 ? 150 : v == 5 ? 160 : 70)*2^(g*(v == 4 ? 5.2 : v == 1 ? 7.1 : 7.6)), 0.45*srate); gl = tan($pi*fc/srate);
      d[45] = 1/(1 + gl*(gl + 1.15)); d[46] = gl*d[45]; d[47] = gl*d[46];
      v == 5 ? (
        fc = min(d[37], 0.45*srate); gb = tan($pi*fc/srate); kb = 2 - 1.97*d[35];
        d[48] = 1/(1 + gb*(gb + kb)); d[49] = gb*d[48]; d[50] = gb*d[49];
      );
    );
    f = d[37];
    fmb = d[34]*(bus - d[21])*0.35;
    v == 0 ? (
      d[7] += f/srate; d[7] -= floor(d[7]);
      x = sin(2*$pi*(d[7] + fmb));
    ) : v == 1 ? (
      d[7] += f/srate; d[7] -= floor(d[7]);
      d[8] += f*(1.4 + 3.3*d[35])/srate; d[8] -= floor(d[8]);
      x = sin(2*$pi*(d[7] + fmb) + (0.8 + 5*g)*sin(2*$pi*d[8]));
      d[22] != 1 ? ( nz = rand(2) - 1; d[27] += (nz - d[27])*0.5; x = x*0.65 + (nz - d[27])*0.8; );
    ) : v <= 3 ? (
      d[7] += f/srate; d[7] -= floor(d[7]);
      d[8] += f*1.593/srate; d[8] -= floor(d[8]);
      fb = d[35]*d[17]*0.35;
      x = tri(d[7] + fb + fmb)*0.75 + tri(d[8] + fb*0.5 + fmb)*0.3;
    ) : v == 4 ? (
      sp = 0.4 + 1.2*d[35];
      dt = f/srate;
      d[7] += dt; d[7] -= floor(d[7]);                       a1 = sqw(d[7] + fmb - floor(d[7] + fmb), dt);
      t = dt*(1 + 0.483*sp); d[8] += t; d[8] -= floor(d[8]);   a2 = sqw(d[8], t);
      t = dt*(1 + 0.932*sp); d[9] += t; d[9] -= floor(d[9]);   a3 = sqw(d[9], t);
      t = dt*(1 + 1.546*sp); d[10] += t; d[10] -= floor(d[10]); a4 = sqw(d[10], t);
      t = dt*(1 + 2.103*sp); d[11] += t; d[11] -= floor(d[11]); a5 = sqw(d[11], t);
      t = dt*(1 + 2.68*sp); d[12] += t; d[12] -= floor(d[12]);  a6 = sqw(d[12], t);
      x = (a1*a2 + a3*a4 + a5*a6)*0.45;
    ) : (
      d[7] += f/srate; d[7] -= floor(d[7]);
      nz = rand(2) - 1;
      xi = nz*0.55 + 0.6*sin(2*$pi*(d[7] + fmb));
      v3 = xi - d[24]; v1 = d[48]*d[23] + d[49]*v3; v2 = d[24] + d[49]*d[23] + d[50]*v3;
      d[23] = 3*th((2*v1 - d[23])/3); d[24] = 2*v2 - d[24];
      x = v1*(0.6 + 1.6*d[35]);
    );
    u = x*d[16];
    ff = -cos(1.5707963*u)/1.5707963;
    y = abs(u - d[18]) > 0.000001 ? (ff - d[19])/(u - d[18]) : sin(0.78539816*(u + d[18]));
    d[18] = u; d[19] = ff;
    d[17] = y;
    v == 4 ? (
      v3 = y - d[26]; v1 = hp1*d[25] + hp2*v3; v2 = d[26] + hp2*d[25] + hp3*v3;
      d[25] = 2*v1 - d[25]; d[26] = 2*v2 - d[26];
      y = y - 1.4142*v1 - v2;
    );
    v == sel ? ( scw = (scw + 1) & 1023; SCB[scw] = y; scf = f; );
    xi = y + d[20]; d[20] = 0;
    v3 = xi - d[6]; v1 = d[45]*d[5] + d[46]*v3; v2 = d[6] + d[46]*d[5] + d[47]*v3;
    d[5] = 2*v1 - d[5]; d[6] = 2*v2 - d[6];
    o = v2*g*sqrt(g)*d[28];
    d[21] = o; busn += o;
    oL += o*d[29]; oR += o*d[30];
    d[2] <= 0 && g < 0.00003 ? ( d[0] = 0; d[1] = 0; d[5] = d[6] = d[21] = d[23] = d[24] = d[25] = d[26] = 0; d[36] = 0; );
  );
  v += 1; d += 64;
);
bus = busn;

pending >= 0 ? (
  vf -= vfstep;
  vf <= 0 ? ( vf = 0; load_preset(pending); i = 0; loop(6, v_ctl(i); i += 1; ); pending = -1; );
) : ( vf < 1 ? vf = min(1, vf + vfstep); );

outg_s += (outg_t - outg_s)*0.002;
pwr_in(oL, oR); oL = pwr_l; oR = pwr_r;
xl = dcL.dcb(oL)*0.75*outg_s*vf; xr = dcR.dcb(oR)*0.75*outg_s*vf;
pwr_out(xl, xr); xl = pwr_l; xr = pwr_r;
spl0 = cpL.adaa_c(xl*BU_CINV)*BU_CEIL;
spl1 = cpR.adaa_c(xr*BU_CINV)*BU_CEIL;
bu_pk = max(bu_pk, max(abs(spl0), abs(spl1)));
opk = max(opk*opkd, max(abs(spl0), abs(spl1)));

@serialize
file_var(0, ui_sz);
file_var(0, sel);
file_var(0, pr_cur);
file_var(0, ulock_d);
file_mem(0, PAT, 384);
file_mem(0, UNC, 288);
file_mem(0, LEN, 24);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@gfx 900 400
ui_begin(900, 400);
v5_begin();
BUF = 0x2E2E31; BUB = 0x141415; BUI = 0xE8E2D4; BUH = 0x161618; BUV = 0xF4C46A; BUA = 0xF0A830; BUO = 0xC8561E; BUC = 0xD9D2C2;
sc != bu_fsc ? (
  bu_fsc = sc;
  bu_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  bu_f6 = ui_fitfont(6, 24 * sc);
);
function bu_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * bu_kt * sc, 'b'); );
function bu_fc(px) ( gfx_setfont(12, "Courier New", px * bu_kt * sc, 'b'); );
function bu_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bu_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bu_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function bu_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function bu_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function bu_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
);
BUIN = ui_mix(ui_mix(BUF, 0, 0.10), 0, 0.30);
function bu_pocket(x, y, w, h) ( bu_cham(x, y, w, h, 3, BUF); ui_col(BUIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function bu_head(x, y, s, uc) ( bu_ft(16); ui_col(BUI); bu_tl(x + 14, y + 19, s); ui_col(uc); v5_r(x + 12, y + 31, bu_tw(s) + 6, 3); );
function bu_hover(cx, cy, fs) ( bu_hon = 1; bu_hx = cx; bu_hy = cy; bu_hfs = fs; );
function bu_cl(x, a, b) ( x < a ? a : x > b ? b : x );
function bu_vname(v) ( v == 0 ? "KICK" : v == 1 ? "SNARE" : v == 2 ? "TOM 1" : v == 3 ? "TOM 2" : v == 4 ? "METAL" : "BURST" );
function bu_cname(v) ( v == 0 ? "SWEEP" : v == 1 ? "RATIO" : v <= 3 ? "LOOP" : v == 4 ? "SPREAD" : "RESO" );
function bu_fam(v) ( v == 0 ? 0xB07A4A : v == 1 ? 0xE0605A : v == 2 ? 0x6CC070 : v == 3 ? 0x4A9A52 : v == 4 ? 0x5AA0E8 : 0xA884E0 );
function bu_lo(i) ( i == 64 ? 0 : i >= 10 ? ((i - 10) % 9 == 0 ? -24 : (i - 10) % 9 == 7 ? -100 : 0) : i == 6 || i == 7 ? -100 : i == 9 ? -24 : 0 );
function bu_hi(i) ( i == 64 ? 7 : i >= 10 ? ((i - 10) % 9 == 0 ? 24 : 100) : i <= 3 ? (i == 3 ? 3 : 1) : i == 4 ? 75 : i == 9 ? 12 : 100 );
function bu_def(i) ( i >= 10 ? PRV[pr_cur*54 + i - 10] : i == 4 ? PRG[pr_cur*14 + 1] : i == 5 ? PRG[pr_cur*14 + 2] : i == 6 ? PRG[pr_cur*14 + 5] : i == 7 ? PRG[pr_cur*14 + 6] : i == 8 ? PRG[pr_cur*14 + 7] : 0 );
function bu_set(i, v) ( slider(i) = bu_cl(v, bu_lo(i), bu_hi(i)); ui_auto(i); );
function bu_fmtt(t) ( t < 1 ? sprintf(#bu_hv, "%d ms", t*1000 + 0.5) : sprintf(#bu_hv, "%.2f s", t) );
function bu_fmt(i) local(j, vv, v) (
  v = slider(i);
  i >= 10 ? (
    j = (i - 10) % 9; vv = floor((i - 10)/9);
    j == 0 ? sprintf(#bu_hv, "%+.1f st", v) :
    j == 3 && vv == 0 ? bu_fmtt(0.005 + sqr(v/100)*0.15) :
    j == 3 && vv == 1 ? sprintf(#bu_hv, "1 : %.2f", 1.4 + 3.3*v/100) :
    j == 5 ? bu_fmtt(0.02*150^(v/100)) :
    j == 7 ? ( abs(v) < 0.5 ? strcpy(#bu_hv, "C") : v < 0 ? sprintf(#bu_hv, "L %d", -v + 0.5) : sprintf(#bu_hv, "R %d", v + 0.5) ) :
    sprintf(#bu_hv, "%d %%", v + 0.5);
  ) :
  i == 9 ? sprintf(#bu_hv, "%+.1f dB", v) :
  i == 6 || i == 7 ? sprintf(#bu_hv, "%+d %%", v) :
  sprintf(#bu_hv, "%d %%", v + 0.5);
);
function bu_dial(cx, cy, r, idx, cc, ptr, lbl, mk) local(n, a, i, t, rs, lo, hi) (
  lo = bu_lo(idx); hi = bu_hi(idx);
  n = v5_ctl(idx, lo, hi, bu_def(idx), 0, v5_hitc(cx, cy, r + 8), 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(0xC8CDC4); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  strlen(mk) ? ( t = -0.75 * $pi + (0 - lo) / (hi - lo) * 1.5 * $pi; bu_ft(11); ui_col(0xC8CDC4); v5_t(cx + sin(t) * (rs + 3), cy - cos(t) * (rs + 3), mk); );
