desc:Burl V5 [west coast drum machine] (GFX Lab)
//tags: instrument drum machine percussion west coast wavefolder low pass gate vactrol fm step sequencer
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider66:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders

import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider1:0<0,1,1{Stop,Run}>-Run
slider2:1<0,1,1{Off,On}>-Sync (follow REAPER's transport)
slider3:0<0,3,1{A,B,C,D}>-Pattern
slider4:10<0,75,1>-Swing (%)
