desc:Combo 63/72 [combo organ] (GFX Lab)
//tags: instrument organ combo transistor divider 60s 70s vibrato
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider43:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:model=0<0,1,1{Medway 63,Combo 72}>-Model
slider2:db16=4<0,8,1>-Medway 16' bass (drawbar)
slider3:db8f=8<0,8,1>-Medway 8' flute (drawbar)
slider4:db8p=0<0,8,1>-Medway 8' principal (drawbar)
slider5:db4f=6<0,8,1>-Medway 4' flute (drawbar)
slider6:db4s=0<0,8,1>-Medway 4' string (drawbar)
slider7:db2=0<0,8,1>-Medway 2' (drawbar)
slider8:dbmx=0<0,8,1>-Medway IV mixture (drawbar)
slider9:vib_on=1<0,1,1{Off,On}>-Medway vibrato
slider10:vib_spd=6.5<0.01,9,0.01>-Medway vibrato speed (Hz)
slider11:vib_dep=45<0,100,0.1>-Medway vibrato depth (%)
slider12:voicing=1<0,2,1{Mellow,Normal,Brilliant}>-Medway voicing
slider13:kclick=35<0,100,0.1>-Medway key click (%)
slider14:drive=2<0,10,0.01>-Medway preamp drive
slider15:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider16:spread=50<0,100,0.1>-Medway stereo spread (%)
slider17:ft16=60<0,100,0.1>-Combo 16' level (%)
slider18:ft8=80<0,100,0.1>-Combo 8' level (%)
slider19:ft4=60<0,100,0.1>-Combo 4' level (%)
slider20:ft223=0<0,100,0.1>-Combo 2 2/3' level (%)
slider21:ft2=40<0,100,0.1>-Combo 2' level (%)
slider22:ft135=0<0,100,0.1>-Combo 1 3/5' level (%)
slider23:c_wave=1<0,3,1{Flute,Square,Pulse,Narrow}>-Combo wave
slider24:c_voicing=1<0,3,1{Open,Reed,Brass,String}>-Combo voicing
slider25:perc_on=0<0,1,1{Off,On}>-Combo percussion
slider26:perc_ft=0<0,1,1{4',2 2/3'}>-Combo percussion footage
slider27:perc_dec=300<80,2000,1:log>-Combo percussion decay (ms)
slider28:perc_lvl=60<0,100,0.1>-Combo percussion level (%)
slider29:key_clk=83<0,100,0.1>-Combo key click (%)
slider30:c_vmode=0<0,3,1{Off,Vibrato,Chorus,Ensemble}>-Combo vibrato mode
slider31:c_vrate=6<0.01,10,0.001:log>-Combo vibrato speed (Hz)
slider32:c_vdepth=50<0,100,0.1>-Combo vibrato depth (%)
slider33:bass=0<-12,12,0.1>-Combo bass (dB)
slider34:brill=0<-12,12,0.1>-Combo brilliance (dB)
slider35:c_sustain=12<5,2000,1:log>-Combo sustain (ms)
slider36:spr_dwell=50<0,100,0.1>-Combo spring dwell (%)
slider37:spr_mix=15<0,100,0.1>-Combo spring mix (%)
slider38:tune=0<-100,100,0.1>-Tune (cents)
slider39:drift=50<0,100,1>-Drift (%)
slider40:vol=0<-24,6,0.1>-Volume (dB)
slider41:sat=0<0,100,1>-Saturation (%)
slider42:prs_sel=0<0,30,1{No preset,63 Init,63 Beat Group,63 Garage Fuzz,63 Soft Flutes,63 Nasal Strings,63 Full Combo,63 Psych Swirl,63 Glass Top,63 Bass Pedal,63 Ballad,63 Surf Stab,63 Mixture Lead,63 Cathedral Club,63 Straight Eights,72 Init,72 Sixties Combo,72 Soft Flutes,72 Reed Solo,72 Full Combo,72 Percussive Keys,72 Brass Tabs,72 String Chorus,72 Spring Ballad,72 Surf Combo,72 Thin Pulse,72 Ensemble Strings,72 Rock Combo,72 Bossa Keys,72 Late Night Flute,72 Church Hall}>-Preset

@init
function psw_all(v) ( slider_show(8796093022207, v); );
function psw_allg(v) ( slider_show(8796093022207, v); );
#ui_man = "gfx-lab-g-combo-63-72";
ext_noinit = 1;
gfx_ext_retina = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1;  pr_m0 = 1;  pr_m1 = 15; );
ui_dflt = 1;
CR = 16;
CB = 1048576;
HK = 900000;  HS = 900200;
memset(HK, 0, 400);  hk_ped = 0;

NK = 24;  KS = 24;  M_KEY = 0;
M_PH = 600;  M_INC = 620;  M_PCM = 640;
M_DV = 660;  M_DT = 680;  M_DTM = 700;
M_PNL = 720;  M_PNR = 740;
NE = 168;
M_EPC = 800;  M_EM = 1000;  M_EF = 1200;
M_SQ = 1400;  M_SW = 1600;
M_LSQ = 1800;  M_LSW = 2000;  M_STP = 2200;
M_KBD = 2400;
MQ = 4096;  MQMAX = 1000;
ZE = NE;

K_ON = 0;  K_NOTE = 1;  K_GATE = 2;  K_SUS = 3;  K_ENV = 4;  K_TGT = 5;  K_AGE = 6;  K_BNC = 7;
K_E16 = 8;  K_E8 = 9;  K_E4 = 10;  K_E2 = 11;  K_M1 = 12;  K_M2 = 13;  K_M3 = 14;  K_M4 = 15;
K_GL = 16;  K_GR = 17;  K_STL = 18;  K_PEND = 19;  K_FAST = 20;

memset(M_KEY, 0, NK * KS);  memset(M_SQ, 0, 2 * 200);  memset(M_STP, 0, 200);  memset(M_KBD, 0, 128);

e_i = 0;
loop(NE + 1,
  e_pc = floor(e_i / 14);  e_o = e_i - e_pc * 14;
  M_EPC[e_i] = min(e_pc, 11);  M_EM[e_i] = 2 ^ min(e_o, 10);
  M_EF[e_i] = e_o > 10 || e_i >= NE ? 1000000 : 440 * 2 ^ ((e_pc - 69) / 12) * 2 ^ e_o;
  e_i += 1;
);

function n2e(n) local(pc, o, e) (
  n < 0 ? ZE : (
    pc = n % 12;  o = floor(n / 12);
    e = pc * 14 + o;
    o > 10 || M_EF[e] > 0.4 * srate ? ZE : e;
  );
);

function n2e_mx(n) local(e) (
  e = n2e(n);
  while (e != ZE && M_EF[e] > 5500) ( n -= 12;  e = n2e(n); );
  e;
);

k = 0;
loop(12,
  t = k == 0 ? -0.8 : k == 1 ? 0.6 : k == 2 ? -0.4 : k == 3 ? 0.9 : k == 4 ? -0.6 : k == 5 ? 0.3 :
      k == 6 ? -0.9 : k == 7 ? 0.5 : k == 8 ? -0.3 : k == 9 ? 0.8 : k == 10 ? -0.5 : 0.4;
  M_PNL[k + 12] = t;
  M_PH[k] = rand(1);  M_DV[k] = rand(2) - 1;  M_DT[k] = rand(2) - 1;  M_DTM[k] = rand(3);  M_PCM[k] = 1;
  k += 1;
);

drf_vib.drift_init(0.8);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
os_design();
os_f = os_tf = os_f2n(os_sel);  os_base = 0;  os_gsetup();

function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);

function sqr_bl(p, d) local(q) ( q = p + 0.5;  q >= 1 ? q -= 1;  saw_bl(q, d) - saw_bl(p, d); );

function bq_cf(tp, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w, cw, al, a, n0) (
  f = min(f, 0.45 * srate);  w = 2 * $pi * f / srate;  cw = cos(w);  al = sin(w) / (2 * q);  a = 10 ^ (gdb / 40);
  tp == 0 ? ( n0 = 1 + al;  b0 = (1 - cw) * 0.5 / n0;  b1 = (1 - cw) / n0;  b2 = b0;  a1 = -2 * cw / n0;  a2 = (1 - al) / n0; ) :
  tp == 1 ? ( n0 = 1 + al;  b0 = (1 + cw) * 0.5 / n0;  b1 = -(1 + cw) / n0;  b2 = b0;  a1 = -2 * cw / n0;  a2 = (1 - al) / n0; ) :
  tp == 2 ? ( n0 = 1 + al / a;  b0 = (1 + al * a) / n0;  b1 = -2 * cw / n0;  b2 = (1 - al * a) / n0;  a1 = b1;  a2 = (1 - al / a) / n0; ) :
  (
    al = sin(w) * 0.5 * sqrt(2);  n0 = (a + 1) - (a - 1) * cw + 2 * sqrt(a) * al;
    b0 = a * ((a + 1) + (a - 1) * cw + 2 * sqrt(a) * al) / n0;
    b1 = -2 * a * ((a - 1) + (a + 1) * cw) / n0;
    b2 = a * ((a + 1) + (a - 1) * cw - 2 * sqrt(a) * al) / n0;
    a1 = 2 * ((a - 1) - (a + 1) * cw) / n0;
    a2 = ((a + 1) - (a - 1) * cw - 2 * sqrt(a) * al) / n0;
  );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1;  z1 = b1 * x - a1 * y + z2;  z2 = b2 * x - a2 * y;  y;
);
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );

function bus_filters() (
  bsL1.bq_cf(0, 700, 0.6, 0);    bsR1.bq_cf(0, 700, 0.6, 0);
  flL1.bq_cf(0, 1300, 0.6, 0);   flR1.bq_cf(0, 1300, 0.6, 0);
  flL2.bq_cf(0, 3200, 0.7, 0);   flR2.bq_cf(0, 3200, 0.7, 0);
  prL1.bq_cf(2, 1200, 0.8, 3);   prR1.bq_cf(2, 1200, 0.8, 3);
  prL2.bq_cf(0, 5000, 0.7, 0);   prR2.bq_cf(0, 5000, 0.7, 0);
  stL1.bq_cf(1, 520, 0.6, 0);    stR1.bq_cf(1, 520, 0.6, 0);
  stL2.bq_cf(2, 2600, 1.4, 7);   stR2.bq_cf(2, 2600, 1.4, 7);
  stL3.bq_cf(0, 7500, 0.7, 0);   stR3.bq_cf(0, 7500, 0.7, 0);
  brL1.bq_cf(1, 260, 0.6, 0);    brR1.bq_cf(1, 260, 0.6, 0);
  brL2.bq_cf(0, 9500, 0.7, 0);   brR2.bq_cf(0, 9500, 0.7, 0);
);
function voicing_filters(g) (
  voL1.bq_cf(3, 2600, 0.7, g);  voR1.bq_cf(3, 2600, 0.7, g);
  voL2.bq_cf(2, 5000, 0.9, max(0, g) * 0.45);  voR2.bq_cf(2, 5000, 0.9, max(0, g) * 0.45);
);

function db_g(v) ( v < 0.5 ? 0 : 10 ^ ((v - 8) * 3 / 20); );

function ge_run(x) instance(u1) local(u, y) (
  u = x * ge_g + ge_b;
  y = (u + u1) / (sqrt(1 + u * u) + sqrt(1 + u1 * u1));
  u1 = u;
  ge_pk = max(ge_pk, abs(u));
  (y - ge_fb) * ge_mk;
);

function k_start(b, n) local(pc) (
  b[K_ON] = 1;  b[K_NOTE] = n;  b[K_GATE] = 1;  b[K_SUS] = 0;  b[K_TGT] = 1;
  age_n += 1;  b[K_AGE] = age_n;
  b[K_E16] = n2e(n - 12);  b[K_E8] = n2e(n);  b[K_E4] = n2e(n + 12);  b[K_E2] = n2e(n + 24);
  b[K_M1] = n2e_mx(n + 19);  b[K_M2] = n2e_mx(n + 24);  b[K_M3] = n2e_mx(n + 28);  b[K_M4] = n2e_mx(n + 36);
  pc = n % 12;  b[K_GL] = M_PNL[pc];  b[K_GR] = M_PNR[pc];
  b[K_BNC] = (0.002 + rand(1) * 0.004) * srate;
  b[K_FAST] = 0;  b[K_STL] = 0;
);
function key_on(n) local(k, b, best, bq, q) (
  best = -1;  bq = 1000000000;  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    q = !b[K_ON] ? -1 : (!b[K_GATE] && !b[K_SUS]) ? b[K_ENV] : 2 + b[K_AGE];
    b[K_ON] && b[K_NOTE] == n && !b[K_STL] ? q = -2;
    q < bq ? ( bq = q;  best = k; );
    k += 1;
  );
  b = M_KEY + best * KS;
  b[K_ON] && b[K_NOTE] != n && b[K_ENV] > 0.001 ? (
    b[K_STL] = 1;  b[K_PEND] = n;  b[K_TGT] = 0;  b[K_GATE] = 0;  b[K_SUS] = 0;
  ) : k_start(b, n);
  lst_dirty = 1;
);
function key_off(n) local(k, b) (
  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    b[K_ON] && b[K_GATE] && b[K_NOTE] == n && !b[K_STL] ? ( b[K_GATE] = 0;  sustain ? b[K_SUS] = 1 : b[K_TGT] = 0; );
    b[K_STL] && b[K_PEND] == n ? b[K_PEND] = -1;
    k += 1;
  );
);
function pedal_up() local(k, b) (
  k = 0;
  loop(NK, b = M_KEY + k * KS;  b[K_SUS] ? ( b[K_SUS] = 0;  !b[K_GATE] ? b[K_TGT] = 0; );  k += 1; );
);
function all_off() local(k, b) (
  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    b[K_ON] ? ( b[K_GATE] = 0;  b[K_SUS] = 0;  b[K_TGT] = 0; );
    b[K_STL] ? b[K_PEND] = -1;
    k += 1;
  );
);
function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? key_on(d1) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? key_off(d1) :
  st == 0xB0 ? (
    d1 == 1 ? mw = d2 / 127 :
    d1 == 11 ? ex_t = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? all_off();
  );
);

function mark_sq(e) ( e != ZE && M_STP[e] != stamp ? ( M_STP[e] = stamp;  M_LSQ[lsq_n] = e;  lsq_n += 1; ); );
function mark_sw(e) ( e != ZE ? ( M_LSW[lsw_n] = e;  lsw_n += 1;  mark_sq(e);  mark_sq(e + 1);  mark_sq(e + 2);  mark_sq(e + 3); ); );
function build_lists() local(k, b) (
  stamp += 1;  lsq_n = 0;  lsw_n = 0;
  k = 0;
  loop(NK,
    b = M_KEY + k * KS;
    b[K_ON] ? (
      mark_sq(b[K_E16]);  mark_sq(b[K_E8]);  mark_sq(b[K_E4]);  mark_sq(b[K_E2]);
      mark_sq(b[K_M1]);  mark_sq(b[K_M2]);  mark_sq(b[K_M3]);  mark_sq(b[K_M4]);
      mark_sw(b[K_E8]);  mark_sw(b[K_E4]);
    );
    k += 1;
  );

);

function m_update() local(t) (
  drift_macro(drift);
  dr_c = 1 - exp(-CR * dm_s / (1.5 * srate));
  g16_t = db_g(db16);  g8f_t = db_g(db8f);  g8p_t = db_g(db8p);  g4f_t = db_g(db4f);
  g4s_t = db_g(db4s);  g2_t = db_g(db2);  gmx_t = db_g(dbmx);
  vd_t = vib_on >= 0.5 ? (vib_dep * 0.01) : 0;
  vo_t = voicing < 0.5 ? -10 : voicing < 1.5 ? 0 : 7;
  kc_t = (kclick * 0.01);
  t = drive / 10;  drv_t = t;
  sp_t = (spread * 0.01);
  outg_t = 10 ^ (vol / 20);
  tune_t = tune;
  os_tf = os_f2n(os_sel);
  sat_t = sat / 100;
);

function sl_auto_au(idx) ( slider_automate(2 ^ (idx - 1)); );
function m_ix(i) ( i <= 14 ? i + 1 : i == 15 ? 38 : i == 16 ? 16 : i == 17 ? 39 : i == 18 ? 40 : 41; );
function m_pv(i, v) ( slider(m_ix(i)) = (i == 10 || i == 12 || i == 16) ? v * 100 : v; );
function c_pv(i, v) ( slider(i + 16) = (i <= 6 || i == 12 || i == 13 || i == 16 || i == 20 || i == 21) ? v * 100 : v; );

function m_p_init() (
  m_pv(1, 4); m_pv(2, 8); m_pv(3, 0); m_pv(4, 6); m_pv(5, 0); m_pv(6, 0); m_pv(7, 0);
  m_pv(8, 1); m_pv(9, 6.5); m_pv(10, 0.45); m_pv(11, 1); m_pv(12, 0.35); m_pv(13, 2);
  m_pv(15, 0); m_pv(16, 0.5); m_pv(17, 50); m_pv(18, 0); m_pv(19, 0);
);
function m_load(p) local(i) (
  m_p_init();
  p == 2 ? (
    m_pv(1, 0); m_pv(2, 8); m_pv(3, 6); m_pv(4, 0); m_pv(5, 7); m_pv(6, 4); m_pv(7, 0); m_pv(11, 2); m_pv(13, 3.5); m_pv(10, 0.4);
  ) :
  p == 3 ? (
    m_pv(1, 5); m_pv(2, 8); m_pv(3, 8); m_pv(4, 6); m_pv(5, 6); m_pv(6, 5); m_pv(7, 4); m_pv(11, 2); m_pv(13, 8.5); m_pv(10, 0.5); m_pv(12, 0.5); m_pv(18, -2);
  ) :
  p == 4 ? (
    m_pv(1, 3); m_pv(2, 8); m_pv(3, 0); m_pv(4, 5); m_pv(5, 0); m_pv(6, 0); m_pv(7, 0); m_pv(11, 0); m_pv(13, 0.5); m_pv(10, 0.3); m_pv(9, 5.8); m_pv(12, 0.15);
  ) :
  p == 5 ? (
    m_pv(1, 0); m_pv(2, 4); m_pv(3, 0); m_pv(4, 0); m_pv(5, 8); m_pv(6, 3); m_pv(7, 0); m_pv(11, 1); m_pv(13, 2.5); m_pv(10, 0.35); m_pv(18, 3.5);
  ) :
  p == 6 ? (
    m_pv(1, 6); m_pv(2, 8); m_pv(3, 7); m_pv(4, 7); m_pv(5, 6); m_pv(6, 6); m_pv(7, 6); m_pv(11, 1); m_pv(13, 4); m_pv(18, -2);
  ) :
  p == 7 ? (
    m_pv(1, 5); m_pv(2, 8); m_pv(3, 0); m_pv(4, 7); m_pv(5, 0); m_pv(6, 5); m_pv(7, 3); m_pv(9, 4.2); m_pv(10, 0.9); m_pv(13, 3); m_pv(16, 0.8);
  ) :
  p == 8 ? (
    m_pv(1, 0); m_pv(2, 0); m_pv(3, 0); m_pv(4, 6); m_pv(5, 0); m_pv(6, 8); m_pv(7, 6); m_pv(11, 2); m_pv(13, 1.5); m_pv(10, 0.3); m_pv(18, 1);
  ) :
  p == 9 ? (
    m_pv(1, 8); m_pv(2, 6); m_pv(3, 0); m_pv(4, 0); m_pv(5, 0); m_pv(6, 0); m_pv(7, 0); m_pv(8, 0); m_pv(11, 0); m_pv(13, 2); m_pv(12, 0.5); m_pv(16, 0);
  ) :
  p == 10 ? (
    m_pv(1, 4); m_pv(2, 8); m_pv(3, 3); m_pv(4, 4); m_pv(5, 0); m_pv(6, 0); m_pv(7, 0); m_pv(9, 5); m_pv(10, 0.3); m_pv(11, 0); m_pv(13, 1); m_pv(12, 0.1); m_pv(16, 0.7);
  ) :
  p == 11 ? (
    m_pv(1, 0); m_pv(2, 7); m_pv(3, 8); m_pv(4, 0); m_pv(5, 5); m_pv(6, 6); m_pv(7, 0); m_pv(8, 0); m_pv(11, 2); m_pv(13, 6); m_pv(12, 0.6);
  ) :
  p == 12 ? (
    m_pv(1, 0); m_pv(2, 8); m_pv(3, 0); m_pv(4, 0); m_pv(5, 0); m_pv(6, 0); m_pv(7, 8); m_pv(9, 7.5); m_pv(10, 0.5); m_pv(11, 1); m_pv(13, 4.5);
  ) :
  p == 13 ? (
    m_pv(1, 8); m_pv(2, 8); m_pv(3, 6); m_pv(4, 8); m_pv(5, 4); m_pv(6, 6); m_pv(7, 5); m_pv(8, 0); m_pv(11, 1); m_pv(13, 1); m_pv(16, 0.9); m_pv(18, -3);
  ) :
  p == 14 ? (
    m_pv(1, 3); m_pv(2, 0); m_pv(3, 8); m_pv(4, 0); m_pv(5, 6); m_pv(6, 0); m_pv(7, 0); m_pv(8, 0); m_pv(11, 1); m_pv(13, 4); m_pv(12, 0.45); m_pv(18, 3);
  ) : 0;
);

function rate_setup() (
  bus_filters();
  smk = 1 - exp(-1 / (0.015 * srate));
  cf_att = 1 - exp(-1 / (0.003 * srate));  cf_rel = 1 - exp(-1 / (0.012 * srate));
  cf_bnc = 1 - exp(-1 / (0.0003 * srate));  cf_stl = 1 - exp(-1 / (0.001 * srate));
  dc_r = 1 - 2 * $pi * 5 / srate;
  ge_env_c = 1 - exp(-1 / (0.04 * srate));
  sag_c = 1 - exp(-CR / (0.08 * srate));
  drL.bq_cf(1, 55, 0.6, 0);  drR.bq_cf(1, 55, 0.6, 0);
);

function os_rcoefs(f) ( amL.bq_cf(0, 9000 / f, 0.6, 0);  amR.bq_cf(0, 9000 / f, 0.6, 0);  );

rate_setup();
m_update();
mw = 0;  ex_t = 1;  ex_s = 1;  sustain = 0;  age_n = 0;  cr_n = 0;  stamp = 0;  lsq_n = 0;  lsw_n = 0;
vph = 0;  vib_v = 0;  vm = 1;  vm_d = 0;  sag_s = 0;
g16 = g16_t;  g8f = g8f_t;  g8p = g8p_t;  g4f = g4f_t;  g4s = g4s_t;  g2 = g2_t;  gmx = gmx_t;
vd_s = vd_t;  vo_s = vo_t;  vo_l = 1000;  kc_s = kc_t;  drv_s = drv_t;  sp_s = sp_t;  out_g = outg_t;  tune_s = tune_t;
voicing_filters(vo_s);  vo_l = vo_s;

amp_f = os_f;  os_rcoefs(os_f);

function gap_clear() (
  memset(M_KEY, 0, NK * KS);  memset(M_SQ, 0, 2 * 200);  lsq_n = 0;  lsw_n = 0;  sustain = 0;
  bsL1.bq_clr(); bsR1.bq_clr(); flL1.bq_clr(); flR1.bq_clr(); flL2.bq_clr(); flR2.bq_clr();
  prL1.bq_clr(); prR1.bq_clr(); prL2.bq_clr(); prR2.bq_clr();
  stL1.bq_clr(); stR1.bq_clr(); stL2.bq_clr(); stR2.bq_clr(); stL3.bq_clr(); stR3.bq_clr();
  brL1.bq_clr(); brR1.bq_clr(); brL2.bq_clr(); brR2.bq_clr();
  voL1.bq_clr(); voR1.bq_clr(); voL2.bq_clr(); voR2.bq_clr();
  drL.bq_clr(); drR.bq_clr(); amL.bq_clr(); amR.bq_clr();
  gL.u1 = 0; gR.u1 = 0; ge_e = 0;
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  dc_xl = dc_pl = dc_xr = dc_pr = 0;
  ostL.ost_ch_init(); ostR.ost_ch_init();
  gp_g = 0;
);
gp_g = 1;  gp_c = 1 / (0.015 * srate);

KG = CB + 0;     KE = CB + 128;   KP = CB + 256;   CKS = CB + 384;   KT = CB + 512;
AKL = CB + 640;
PLT = CB + 800;  PL = CB + 940;   PSTP = CB + 1080;
PIV = CB + 1220; PMK = CB + 1360; PPC = CB + 1500;
PLS = CB + 1640;
PKO = CB + 2000;
TWA = CB + 2200; TWB = CB + 2340; TWT = CB + 2480; TWD = CB + 2620;
TWK = CB + 2760; TWP = CB + 2900;
MPH = CB + 1780; MCN = CB + 1792; MIN0 = CB + 1804; MINC = CB + 1816;
DRV = CB + 1830; DRT = CB + 1842; DRM = CB + 1854;
FOFS = CB + 1870;
VBL = CB + 4096;  VB_N = 8192;
SPM = CB + 16384;

FOFS[0] = -12;  FOFS[1] = 0;  FOFS[2] = 12;  FOFS[3] = 19;  FOFS[4] = 24;  FOFS[5] = 28;
memset(KG, 0, 640);  memset(PLT, 0, 420);
k = 0;  loop(128, KT[k] = rand(2) - 1;  k += 1; );
k = 0;
loop(129,
  PPC[k] = k % 12;
  PMK[k] = 2 ^ floor((120 + (k % 12) - k) / 12) - 1;
  PIV[k] = 1 / (PMK[k] + 1);
  PKO[k] = floor((120 + (k % 12) - k) / 12) * TSTR;
  k += 1;
);
k = 0;
loop(12,
  MPH[k] = rand(1);  MCN[k] = floor(rand(1024));
  MIN0[k] = 440 * 2 ^ ((120 + k - 69) / 12) / srate;
  DRV[k] = rand(2) - 1;  DRT[k] = rand(2) - 1;  DRM[k] = rand(3);
  k += 1;
);
memset(VBL, 0, VB_N);  vb_w = 0;
k = 0;
loop(129,
  TWA[k] = 0;  TWB[k] = rand(1) < 0.35 ? 0 : (rand(2) - 1) * 2;  TWD[k] = 3 + rand(1) * 2;  TWT[k] = rand(1) * TWD[k];
  TWK[k] = 0;  TWP[k] = 0;
  k += 1;
);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
c_dsup.drift_init(0.9);  c_dvib.drift_init(1.1);

function c_ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
WT = CB + 262144;  TSTR = 2056;  TN = 2048;  FB = CB + 196608;
function c_build_tables() local(w, k, n, nmax, wd, a, b, i, t) (
  w = 0;
  loop(4,
    wd = w == 1 ? 0.5 : w == 2 ? 0.25 : 0.125;
    k = 0;
    loop(11,
      nmax = min(TN / 2 - 1, floor(0.47 * srate / (15804 / 2 ^ k * 1.19)));
      memset(FB, 0, TN * 2);
      n = 1;
      loop(nmax,
        w == 0 ? (
          (n & 1) ? ( a = -4 / ($pi * $pi * n * n);  b = 0; ) : ( a = 0;  b = 0; );
        ) : (
          t = 2 / ($pi * n) * sin($pi * n * wd);
          a = t * cos($pi * n * wd);  b = -t * sin($pi * n * wd);
        );
        FB[2 * n] = a;  FB[2 * n + 1] = b;  FB[2 * (TN - n)] = a;  FB[2 * (TN - n) + 1] = -b;
        n += 1;
      );
      fft_ipermute(FB, TN);  ifft(FB, TN);
      t = WT + (w * 11 + k) * TSTR;
      i = 0;  loop(TN, t[i] = FB[2 * i];  i += 1; );  t[TN] = t[0];
      k += 1;
    );
    w += 1;
  );
);
c_build_tables();
function c_tone(tb, q) local(x, i) (
  x = q * TN;  i = floor(x);
  tb[i] + (tb[i + 1] - tb[i]) * (x - i);
);

function c_bq_peak(c, f, q, db) local(w, a, al, cs, a0) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate;  a = 10 ^ (db / 40);  al = sin(w) / (2 * q);  cs = cos(w);
  a0 = 1 + al / a;
  c[0] = (1 + al * a) / a0;  c[1] = -2 * cs / a0;  c[2] = (1 - al * a) / a0;  c[3] = -2 * cs / a0;  c[4] = (1 - al / a) / a0;
);
function c_bq_hp(c, f, q) local(w, al, cs, a0) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate;  al = sin(w) / (2 * q);  cs = cos(w);  a0 = 1 + al;
  c[0] = (1 + cs) * 0.5 / a0;  c[1] = -(1 + cs) / a0;  c[2] = (1 + cs) * 0.5 / a0;  c[3] = -2 * cs / a0;  c[4] = (1 - al) / a0;
);
function c_bq(c, x) instance(x1, x2, y1, y2) local(y) (
  y = c[0] * x + c[1] * x1 + c[2] * x2 - c[3] * y1 - c[4] * y2;
  x2 = x1;  x1 = x;  y2 = y1;  y1 = y;
  y;
);
BQV1 = CB + 1900;  BQV2 = CB + 1910;  BQHP = CB + 1920;  BQN1 = CB + 1930;  BQN2 = CB + 1940;

function c_voicing_set(c1, c2, v) (
  v < 0.5 ? ( c_bq_peak(c1, 1100, 1, 0);  c_bq_peak(c2, 3300, 1, 0); ) :
  v < 1.5 ? ( c_bq_peak(c1, 1100, 1.4, 5.5);  c_bq_peak(c2, 3300, 2, 4); ) :
  v < 2.5 ? ( c_bq_peak(c1, 660, 1, 5);  c_bq_peak(c2, 2200, 1.4, 4.5); ) :
            ( c_bq_peak(c1, 220, 0.7, -7);  c_bq_peak(c2, 4400, 1.5, 6); );
);

function c_ap1(x, a) instance(z) local(y) ( y = -a * x + z;  z = x + a * y;  y; );
function c_spr_init(mem) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, lc) (
  b1 = mem;  n1 = floor(0.0371 * srate);  b2 = mem + n1 + 8;  n2 = floor(0.0433 * srate);
  memset(mem, 0, n1 + n2 + 16);  w1 = 0;  w2 = 0;  lp1 = 0;  lp2 = 0;
  lc = 1 - exp(-2 * $pi * 3800 / srate);
);
function c_spr_run(x, gfb) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, lc, s1, s2, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) local(y) (
  y = d6.c_ap1(d5.c_ap1(d4.c_ap1(d3.c_ap1(d2.c_ap1(d1.c_ap1(x, 0.62), 0.62), 0.62), 0.62), 0.62), 0.62);
  s1 = b1[w1];  s2 = b2[w2];
  lp1 += (s1 - lp1) * lc;  lp2 += (s2 - lp2) * lc;
  b1[w1] = y + e1.c_ap1(e2.c_ap1(lp2 * gfb, 0.5), 0.5);
  b2[w2] = y + e3.c_ap1(e4.c_ap1(lp1 * gfb, 0.5), 0.5);
  w1 += 1;  w1 >= n1 ? w1 = 0;  w2 += 1;  w2 >= n2 ? w2 = 0;
);
spr.c_spr_init(SPM);
c_bq_hp(BQHP, 33, 0.6);

function c_key_on(n) local(i, f) (
  f = 0;  i = 0;  loop(ak_n, AKL[i] == n ? f = 1;  i += 1; );
  !f && ak_n < 128 ? ( AKL[ak_n] = n;  ak_n += 1; );
  KG[n] = 1;  CKS[n] = 0;
  KP[n] = 1;
  ck_e = min(1, ck_e + 0.8);
);
function c_key_off(n) (
  KG[n] ? ( sustain_p ? CKS[n] = 1;  KG[n] = 0;  ck_e = min(1, ck_e + 0.3); );
);
function c_pedal_up() local(i) ( i = 0;  loop(128, CKS[i] = 0;  i += 1; ); );
function c_all_off() local(i) ( i = 0;  loop(128, KG[i] = 0;  CKS[i] = 0;  i += 1; ); );

function c_midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? c_key_on(d1) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? c_key_off(d1) :
  st == 0xE0 ? c_bend_t = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  sustain_p && !c ? c_pedal_up();  sustain_p = c; ) :
    (d1 == 123 || d1 == 120) ? c_all_off();
  );
);

function c_add_pitch(p, lv) (
  p >= 0 ? ( while (p > 108) ( p -= 12; );  PLT[p] += lv; );
);

function c_ctl_tick() local(i, j, n, e, pe, g, keep, nkey, pt, f) (
  memset(PLT, 0, 129);
  nkey = 0;  i = 0;  j = 0;
  loop(ak_n,
    n = AKL[i];
    e = KE[n];
    (KG[n] || CKS[n]) ? ( e = min(1, e + k_ainc);  nkey += 1; ) : e *= k_rc;
    KE[n] = e;
    pe = KP[n] * p_dc;  KP[n] = pe;
    keep = KG[n] || CKS[n] || e > 0.0001;
    keep ? (
      AKL[j] = n;  j += 1;
      g = e * (1 + KT[n] * 0.06 * dm_a);
      c_add_pitch(n - 12, g * l16);  c_add_pitch(n, g * l8);  c_add_pitch(n + 12, g * l4);
      c_add_pitch(n + 19, g * l223);  c_add_pitch(n + 24, g * l2);  c_add_pitch(n + 28, g * l135);
      pc_s > 0.0001 ? c_add_pitch(n + pc_ofs, g * pe * pc_s);
    ) : ( KE[n] = 0;  KP[n] = 0; );
    i += 1;
  );
  ak_n = j;
  pl_n = 0;  i = 0;
  loop(129,
    pt = PLT[i];
    (pt > 0 || PL[i] > 0.000001) ? ( PSTP[i] = (pt - PL[i]) / CR;  PLS[pl_n] = i;  pl_n += 1; ) : ( PL[i] = 0;  PSTP[i] = 0; );
    i += 1;
  );
  c_bend_s += (c_bend_t - c_bend_s) * bd_k;
  c_sag += (min(nkey, 10) - c_sag) * c_sagk;
  f = 2 ^ ((tune + wu_c + c_bend_s * 100 + (sup_v * 2 - c_sag * 0.4) * dm_a) / 1200);
  i = 0;
  loop(12, MINC[i] = MIN0[i] * f * 2 ^ (DRV[i] * 3 * dm_a / 1200);  i += 1; );
  keys_d = nkey;
);

function c_update() (
  drift_macro(drift);
  l16_t = (ft16 * 0.01);  l8_t = (ft8 * 0.01);  l4_t = (ft4 * 0.01);  l223_t = (ft223 * 0.01);  l2_t = (ft2 * 0.01);  l135_t = (ft135 * 0.01);
  k_ainc = CR / (0.002 * srate);
  k_rc = exp(-6.9 * CR / (c_sustain * 0.001 * srate));
  p_dc = exp(-4.6 * CR / (perc_dec * 0.001 * srate));
  pc_t = perc_on >= 0.5 ? (perc_lvl * 0.01) * 1.4 : 0;
  pc_ofs = perc_ft >= 0.5 ? 19 : 12;
  ck_t = (key_clk * 0.01) * 0.027;
  wv_t = floor(c_wave + 0.5);  vc_t = floor(c_voicing + 0.5);
  (wv_t != wv_l || vc_t != vc_l) ? c_dkreq = 1;
  c_voicing_set(BQN1, BQN2, vc_t);
  bs_t = 10 ^ (bass / 20) - 1;  br_t = 10 ^ (brill / 20) - 1;
  c_vm = floor(c_vmode + 0.5);
  vdry_t = c_vm == 0 ? 1 : c_vm == 1 ? 0 : c_vm == 2 ? 0.72 : 0.55;
  vwa_t = c_vm == 1 ? 1 : c_vm == 2 ? 0.72 : 0;
  ven_t = c_vm == 3 ? 0.78 : 0;
  vdp_t = (0.00004 + 0.0006 * (c_vdepth * 0.01)) * srate;
  spm_t = (spr_mix * 0.01);  sfb = 0.55 + 0.35 * (spr_dwell * 0.01);
  c_outg_t = 10 ^ (vol / 20) * 0.09;
);

lc_8k = 1 - exp(-2 * $pi * 8800 / srate);
lc_bs = 1 - exp(-2 * $pi * 220 / srate);  lc_br = 1 - exp(-2 * $pi * 2200 / srate);
c_smk = 1 - exp(-1 / (0.015 * srate));
c_dkst = 1 / (0.005 * srate);
bd_k = 1 - exp(-CR / (0.01 * srate));  c_sagk = 1 - exp(-CR / (0.4 * srate));
c_dcr = 1 - 2 * $pi * 5 / srate;
ck_dc = exp(-1 / (0.003 * srate));
ak_n = 0;  pl_n = 0;  c_crn = 0;  c_bend_t = 0;  c_bend_s = 0;  c_sag = 0;  sustain_p = 0;  ck_e = 0;  sup_v = 0;
vb_c = 1;  vb_s = 0;  en_c = 1;  en_s = 0;

c_update();
wv_l = wv_t;  vc_l = vc_t;  c_dk = 1;  c_dkreq = 0;  memcpy(BQV1, BQN1, 5);  memcpy(BQV2, BQN2, 5);
wv_tb = WT + wv_l * 11 * TSTR;  wv_g = wv_l == 0 ? 0.9 : wv_l == 1 ? 0.56 : wv_l == 2 ? 1.15 : 2.1;
l16 = l16_t;  l8 = l8_t;  l4 = l4_t;  l223 = l223_t;  l2 = l2_t;  l135 = l135_t;  pc_s = pc_t;  ck_s = ck_t;
bs_s = bs_t;  br_s = br_t;  vdry = vdry_t;  vwa = vwa_t;  ven = ven_t;  vdp = vdp_t;  spm_s = spm_t;  c_outg = c_outg_t;

function c_p_init() (
  c_pv(1, 0.6); c_pv(2, 0.8); c_pv(3, 0.6); c_pv(4, 0); c_pv(5, 0.4); c_pv(6, 0); c_pv(7, 1); c_pv(8, 1);
  c_pv(9, 0); c_pv(10, 0); c_pv(11, 300); c_pv(12, 0.6); c_pv(13, 0.83);
  c_pv(14, 0); c_pv(15, 6); c_pv(16, 0.5); c_pv(17, 0); c_pv(18, 0); c_pv(19, 12);
  c_pv(20, 0.5); c_pv(21, 0.15); c_pv(22, 0); c_pv(23, 50); c_pv(24, 0); c_pv(25, 0);
);
function c_load(p) local(i) (
  c_p_init();
  p == 2 ? (
    c_pv(1, 0.3); c_pv(2, 1); c_pv(3, 0.8); c_pv(5, 0.7); c_pv(14, 1); c_pv(15, 6.5); c_pv(16, 0.55); c_pv(18, 3); c_pv(21, 0.18); c_pv(24, -2.5);
  ) :
  p == 3 ? (
    c_pv(1, 0.4); c_pv(2, 0.9); c_pv(3, 0.5); c_pv(5, 0); c_pv(7, 0); c_pv(8, 0); c_pv(14, 2); c_pv(15, 5.5); c_pv(16, 0.4); c_pv(18, -3); c_pv(19, 120); c_pv(21, 0.25); c_pv(24, -1);
  ) :
  p == 4 ? (
    c_pv(1, 0); c_pv(2, 1); c_pv(3, 0.5); c_pv(4, 0.4); c_pv(5, 0); c_pv(7, 2); c_pv(14, 1); c_pv(15, 6.8); c_pv(16, 0.6); c_pv(18, 2); c_pv(24, -3);
  ) :
  p == 5 ? (
    c_pv(1, 1); c_pv(2, 0.9); c_pv(3, 0.8); c_pv(4, 0.5); c_pv(5, 0.8); c_pv(6, 0.4); c_pv(8, 2); c_pv(14, 2); c_pv(15, 6.5); c_pv(21, 0.2); c_pv(24, -7.5);
  ) :
  p == 6 ? (
    c_pv(1, 0.4); c_pv(2, 0.9); c_pv(3, 0); c_pv(5, 0); c_pv(8, 0); c_pv(9, 1); c_pv(11, 260); c_pv(12, 0.8); c_pv(13, 1); c_pv(24, 4);
  ) :
  p == 7 ? (
    c_pv(1, 0.7); c_pv(2, 1); c_pv(3, 0.7); c_pv(5, 0); c_pv(7, 2); c_pv(8, 2); c_pv(14, 1); c_pv(15, 5.5); c_pv(16, 0.3); c_pv(18, 2); c_pv(24, -5.2);
  ) :
  p == 8 ? (
    c_pv(1, 0); c_pv(2, 1); c_pv(3, 0.8); c_pv(5, 0.5); c_pv(7, 3); c_pv(8, 3); c_pv(14, 2); c_pv(15, 5); c_pv(16, 0.7); c_pv(19, 300); c_pv(21, 0.3); c_pv(24, -1);
  ) :
  p == 9 ? (
    c_pv(1, 0); c_pv(2, 1); c_pv(3, 0.3); c_pv(5, 0); c_pv(7, 0); c_pv(9, 1); c_pv(10, 1); c_pv(11, 700); c_pv(12, 0.5); c_pv(14, 1); c_pv(15, 5.8); c_pv(16, 0.45); c_pv(19, 200); c_pv(20, 0.7); c_pv(21, 0.35); c_pv(24, 2.7);
  ) :
  p == 10 ? (
    c_pv(1, 0); c_pv(2, 1); c_pv(3, 1); c_pv(5, 1); c_pv(6, 0.5); c_pv(14, 1); c_pv(15, 7); c_pv(16, 0.7); c_pv(18, 4); c_pv(20, 0.75); c_pv(21, 0.45); c_pv(24, -5.9);
  ) :
  p == 11 ? (
    c_pv(1, 0); c_pv(2, 1); c_pv(3, 0); c_pv(5, 0.4); c_pv(7, 3); c_pv(8, 0); c_pv(14, 2); c_pv(17, -4); c_pv(24, -0.9);
  ) :
  p == 12 ? (
    c_pv(1, 0.3); c_pv(2, 1); c_pv(3, 0.7); c_pv(5, 0.4); c_pv(7, 3); c_pv(8, 3); c_pv(14, 3); c_pv(15, 6); c_pv(16, 0.6); c_pv(18, 1); c_pv(19, 450); c_pv(21, 0.25); c_pv(24, 1.4);
  ) :
  p == 13 ? (
    c_pv(1, 0.5); c_pv(2, 1); c_pv(3, 0.9); c_pv(4, 0.3); c_pv(5, 0.8); c_pv(9, 1); c_pv(11, 180); c_pv(12, 0.7); c_pv(13, 1); c_pv(14, 2); c_pv(15, 7); c_pv(16, 0.4); c_pv(18, 4); c_pv(21, 0.12); c_pv(24, -6);
  ) :
  p == 14 ? (
    c_pv(1, 0); c_pv(2, 0.8); c_pv(3, 0.4); c_pv(5, 0); c_pv(7, 0); c_pv(8, 0); c_pv(9, 1); c_pv(10, 1); c_pv(11, 420); c_pv(12, 0.7); c_pv(13, 1); c_pv(14, 1); c_pv(15, 5.2); c_pv(16, 0.35); c_pv(19, 60); c_pv(21, 0.2); c_pv(24, 4.1);
  ) :
  p == 15 ? (
    c_pv(1, 0.5); c_pv(2, 0.9); c_pv(3, 0.2); c_pv(5, 0); c_pv(7, 0); c_pv(8, 0); c_pv(14, 3); c_pv(15, 4); c_pv(16, 0.45); c_pv(18, -4); c_pv(19, 250); c_pv(21, 0.3); c_pv(24, 3.1);
  ) :
  p == 16 ? (
    c_pv(1, 0.8); c_pv(2, 1); c_pv(3, 0.7); c_pv(5, 0.6); c_pv(7, 0); c_pv(8, 1); c_pv(14, 1); c_pv(15, 5.5); c_pv(16, 0.25); c_pv(19, 600); c_pv(20, 0.85); c_pv(21, 0.5); c_pv(24, -2.5);
  ) : 0;
);

function c_gap_clear() (
  memset(VBL, 0, VB_N);  spr.c_spr_init(SPM);
  fm1.x1 = fm1.x2 = fm1.y1 = fm1.y2 = 0;  fm2.x1 = fm2.x2 = fm2.y1 = fm2.y2 = 0;  hpf.x1 = hpf.x2 = hpf.y1 = hpf.y2 = 0;
  t_l = t_h = o_lp = 0;  c_dcxl = c_dcpl = c_dcxr = c_dcpr = 0;  ck_e = 0;  ck_h = ck_l = 0;
  ostL.ost_ch_init();  ostR.ost_ch_init();
  c_gf = 0;
);
c_gf = 1;  c_gfi = 1 / (0.015 * srate);

function update_params() ( m_update(); c_update(); mdl_t = model >= 0.5; );

function load_preset(p) local(i) (
  p <= 14 ? ( model = 0;  m_load(p); ) : ( model = 1;  c_load(p - 14); );
  i = 1;  loop(41, i != 15 ? sl_auto_au(i);  i += 1; );
  prm_dirty = 1;
);

PR_N = 30;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(41, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  load_preset(k);
    k <= PR_N ? ( prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel;  prs_sel > 0 && prs_hs ? ( load_preset(prs_sel);  prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0;  prs_ok = 1; );
);
prs_ok = 0;  prs_dirty = 0;

function hk_clr() ( memset(HK, 0, 128);  memset(HS, 0, 128); );
function hk_ev(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? ( HK[d1] = 1;  HS[d1] = 0; ) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? ( HK[d1] ? ( HK[d1] = 0;  hk_ped ? HS[d1] = 1; ); ) :
  st == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  hk_ped && !c ? memset(HS, 0, 128);  hk_ped = c; ) :
    (d1 == 123 || d1 == 120) ? hk_clr();
  );
);
function pwr_model() (
  pwr_sag = 0.3;  pwr_wu_loss = 0.6;  pwr_wu_wob = 0.3;  pwr_bloom = 0;
  mdl_a ? ( pwr_hum_db = -51;  pwr_wu_drv = 1;  pwr_wu_lp = 9000; ) : ( pwr_hum_db = -83;  pwr_wu_drv = 1.5;  pwr_wu_lp = 8000; );
  pwr_mode_a ? pwr_table(pwr_mode_a);
);
function c_keys_clr() (
  c_all_off();  memset(KE, 0, 128);  memset(KP, 0, 128);  memset(PL, 0, 129);  memset(PSTP, 0, 129);  ak_n = 0;  pl_n = 0;  ck_e = 0;
);
function do_swap() local(n) (
  mdl_a = mdl_t;
  gap_clear();  c_gap_clear();  c_keys_clr();  cux.os_clr();  cdn.os_clr();
  sustain = hk_ped;  sustain_p = hk_ped;
  n = 0;
  loop(128,
    HK[n] || HS[n] ? (
      mdl_a ? c_key_on(n) : key_on(n);
      HS[n] && !HK[n] ? ( mdl_a ? c_key_off(n) : key_off(n); );
    );
    n += 1;
  );
  ck_e = 0;
  pwr_model();
);

pwr_init();
mdl_t = model >= 0.5;  mdl_a = mdl_t;  sw_g = 1;  sw_c = 1 / (0.006 * srate);
pwr_model();

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update_params();
!au_ran && mdl_a != mdl_t ? ( mdl_a = mdl_t;  pwr_model(); );
os_snap(slider(15));

@block
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? ( gap_clear();  c_gap_clear();  hk_clr(); );
g_tp = g_now;  g_gpp = play_position;  g_gpd = samplesblock / srate;
prs_chk();
pwr_block(1);
wu_c = (1 - pwr_gm) * (-8 + 3 * pwr_w1);
prm_dirty ? ( prm_dirty = 0;  update_params(); );
!au_ran && mdl_a != mdl_t ? ( mdl_a = mdl_t;  pwr_model(); );
mdl_t != mdl_a && sw_g <= 0 ? do_swap();

pn_dirty ? ( pn_dirty = 0;  sustain = 0;  all_off();  sustain_p = 0;  c_all_off();  hk_ped = 0;  hk_clr(); );

mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  (m_st & 0xF0) == 0x90 && m_d2 > 0 ? mi_led_d = 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? ( all_off();  c_all_off();  hk_clr(); );  tp_was = tp_now;

!mdl_a ? (
  vib_dv = drf_vib.drift_tick(samplesblock / srate * 0.2 * dm_s);
  vib_rate = vib_spd * (1 + 0.04 * dm_a * vib_dv);
) : (
  t_b = samplesblock / srate;
  k = 0;
  loop(12,
    DRM[k] -= t_b * dm_s;  DRM[k] <= 0 ? ( DRT[k] = rand(2) - 1;  DRM[k] = 2 + rand(3); );
    DRV[k] += (DRT[k] - DRV[k]) * min(1, t_b * dm_s / 1.5);
    k += 1;
  );
  sup_v = c_dsup.drift_tick(t_b * 0.2 * dm_s);
  vb_dv = c_dvib.drift_tick(t_b * 0.25 * dm_s);
  t_a = 2 * $pi * c_vrate * (1 + 0.08 * dm_a * vb_dv) / srate;  vb_ca = cos(t_a);  vb_sa = sin(t_a);
  t_a = 1 / sqrt(max(vb_c * vb_c + vb_s * vb_s, 0.0001));  vb_c *= t_a;  vb_s *= t_a;
  vb_disp = vb_s;
  k = 0;
  loop(129,
    TWT[k] += t_b;
    TWT[k] >= TWD[k] ? (
      TWA[k] = TWB[k];  TWT[k] = 0;  TWD[k] = 3 + rand(1) * 2;
      TWB[k] = rand(1) < 0.35 ? 0 : max(-2, min(2, TWA[k] + (rand(2) - 1) * 2));
    );
    t_a = TWA[k] + (TWB[k] - TWA[k]) * (0.5 - 0.5 * cos($pi * TWT[k] / TWD[k]));
    TWK[k] = t_a * dm_a * 0.000577623;
    k += 1;
  );
  vb_base = 0.003 * srate;
  t_a = 2 * $pi * c_vrate * 0.1 * (1 + 0.08 * dm_a * vb_dv) / srate;  en_ca = cos(t_a);  en_sa = sin(t_a);
  t_a = 1 / sqrt(max(en_c * en_c + en_s * en_s, 0.0001));  en_c *= t_a;  en_s *= t_a;
  en_base = 0.006 * srate;
  spr_live = spm_t > 0.0005 || spm_s > 0.0005;
  !spr_was && spr_live ? spr.c_spr_init(SPM);  spr_was = spr_live;
);
ost_setup(sat_t, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
od_disp = max(od_disp, ge_pk);  ge_pk = 0;
lfo_disp = mdl_a ? vb_s * (c_vmode >= 0.5) : vib_v * (vd_s > 0.01);
os_snapb(slider(15));

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( hk_ev(mq_i);  mdl_a ? c_midi_event(mq_i) : midi_event(mq_i);  mq_i += 1; );
spos += 1;
au_ran = 1;

os_gate();
os_chg ? (
  os_rcoefs(os_f);  amL.bq_clr();  amR.bq_clr();  uxL.os_clr();  uxR.os_clr();  dnL.os_clr();  dnR.os_clr();
  cux.os_clr();  cdn.os_clr();
);

!mdl_a ? (
  cr_n <= 0 ? (
    cr_n = CR;
    build_lists();

    vph += vib_rate * CR / srate;  vph >= 1 ? vph -= 1;
    t = vph < 0.42 ? 0.5 * vph / 0.42 : 0.5 + 0.5 * (vph - 0.42) / 0.58;
    vib_v = sin(2 * $pi * t);
    vd_s += (vd_t - vd_s) * (1 - exp(-CR / (0.03 * srate)));

    ld = 0;  k = 0;
    loop(NK, kb = M_KEY + k * KS;  ld += kb[K_ENV];  k += 1; );
    ld *= (g16 + g8f + g8p + g4f + g4s + g2 + gmx * 2) / 9;
    sag_s += (min(1, ld / 10) - sag_s) * sag_c;
    tune_s += (tune_t - tune_s) * (1 - exp(-CR / (0.03 * srate)));

    k = 0;
    loop(12,
      M_DTM[k] -= CR / srate * dm_s;  M_DTM[k] <= 0 ? ( M_DT[k] = rand(2) - 1;  M_DTM[k] = 1.5 + rand(1) * 3; );
      M_DV[k] += (M_DT[k] - M_DV[k]) * dr_c;
      M_INC[k] = 440 * 2 ^ ((k - 69 + (tune_s + wu_c + (M_DV[k] * 2.5 - sag_s * 3) * dm_a) * 0.01) / 12) / srate;
      k += 1;
    );

    t = 2 ^ ((vib_v * (vd_s + mw * 0.5) * 60) / 1200);
    vm_d = (t - vm) / CR;

    sp_s += (sp_t - sp_s) * (1 - exp(-CR / (0.03 * srate)));
    k = 0;
    loop(12, t = M_PNL[k + 12] * sp_s;  M_PNL[k] = sqrt(0.5 * (1 - t));  M_PNR[k] = sqrt(0.5 * (1 + t));  k += 1; );
    k = 0;
    loop(NK, kb = M_KEY + k * KS;  kb[K_ON] ? ( t = kb[K_NOTE] % 12;  kb[K_GL] = M_PNL[t];  kb[K_GR] = M_PNR[t]; );  k += 1; );

    vo_s += (vo_t - vo_s) * (1 - exp(-CR / (0.03 * srate)));
    abs(vo_s - vo_l) > 0.02 ? ( voicing_filters(vo_s);  vo_l = vo_s; );

    drv_s += (drv_t - drv_s) * (1 - exp(-CR / (0.03 * srate)));
    ge_g = 1.2 * 10 ^ (drv_s * 30 / 20);
    ge_b = 0.16 + 0.22 * drv_s * min(1, ge_e * ge_g * 1.5);
    ge_fb = ge_b / sqrt(1 + ge_b * ge_b);
    !ge_i0 ? ( gL.u1 = gR.u1 = ge_b;  ge_i0 = 1; );
    t = 0.07 * ge_g + ge_b;  ge_mk = 0.07 / (t / sqrt(1 + t * t) - ge_fb);
    ge_mk *= 1 - 0.045 * sag_s * dm_a;
    kc_s = kc_t;
  );
  cr_n -= 1;

  g16 += (g16_t - g16) * smk;  g8f += (g8f_t - g8f) * smk;  g8p += (g8p_t - g8p) * smk;  g4f += (g4f_t - g4f) * smk;
  g4s += (g4s_t - g4s) * smk;  g2 += (g2_t - g2) * smk;  gmx += (gmx_t - gmx) * smk;
  out_g += (outg_t - out_g) * smk;  ex_s += (ex_t - ex_s) * smk;
  vm += vm_d;

  k = 0;
  loop(12, t = M_PH[k] + M_INC[k] * vm;  t >= 1 ? t -= 1;  M_PH[k] = t;  k += 1; );
  i = 0;
  loop(lsq_n,
    e = M_LSQ[i];  t = M_EPC[e];  em = M_EM[e];
    q = M_PH[t] * em;  q -= floor(q);
    M_SQ[e] = sqr_bl(q, M_INC[t] * vm * em);
    i += 1;
  );
  i = 0;
  loop(lsw_n,
    e = M_LSW[i];
    M_SW[e] = (M_SQ[e] + 0.5 * M_SQ[e + 1] + 0.25 * M_SQ[e + 2] + 0.125 * M_SQ[e + 3]) * 0.6;
    i += 1;
  );

  bsl = bsr = fll = flr = prl = prr = stl = str = brl = brr = 0;
  kb = M_KEY;  k = 0;
  loop(NK,
    kb[K_ON] ? (

      kb[K_BNC] > 0 ? (
        kb[K_BNC] -= 1;
        (kb[K_BNC] & 63) == 0 ? kb[K_FAST] = rand(1) < 0.5 ? 1 - kc_s : 1;
        e_v = kb[K_FAST];
        kb[K_ENV] += (e_v - kb[K_ENV]) * cf_bnc;
      ) : kb[K_STL] ? (
        kb[K_ENV] -= kb[K_ENV] * cf_stl;
        kb[K_ENV] < 0.0005 ? ( kb[K_ENV] = 0;  kb[K_STL] = 0;  kb[K_PEND] >= 0 ? ( k_start(kb, kb[K_PEND]);  lst_dirty = 1; ) : kb[K_ON] = 0; );
      ) : (
        kb[K_ENV] += (kb[K_TGT] - kb[K_ENV]) * (kb[K_TGT] > kb[K_ENV] ? cf_att : cf_rel);
        !kb[K_TGT] && kb[K_ENV] < 0.00002 ? ( kb[K_ENV] = 0;  kb[K_ON] = 0; );
      );
      a = kb[K_ENV];
      x = M_SQ[kb[K_E16]] * g16 * a;  bsl += x * kb[K_GL];  bsr += x * kb[K_GR];
      x = (M_SQ[kb[K_E8]] * g8f + M_SQ[kb[K_E4]] * g4f) * a;  fll += x * kb[K_GL];  flr += x * kb[K_GR];
      x = M_SW[kb[K_E8]] * g8p * a;  prl += x * kb[K_GL];  prr += x * kb[K_GR];
      x = M_SW[kb[K_E4]] * g4s * a;  stl += x * kb[K_GL];  str += x * kb[K_GR];
      x = (M_SQ[kb[K_E2]] * g2 + (M_SQ[kb[K_M1]] * 0.8 + M_SQ[kb[K_M2]] + M_SQ[kb[K_M3]] * 0.6 + M_SQ[kb[K_M4]] * 0.7) * gmx * 0.55) * a;
      brl += x * kb[K_GL];  brr += x * kb[K_GR];
    );
    kb += KS;  k += 1;
  );

  yl = bsL1.bq_run(bsl) * 1.3 + flL2.bq_run(flL1.bq_run(fll)) * 1.1 + prL2.bq_run(prL1.bq_run(prl))
     + stL3.bq_run(stL2.bq_run(stL1.bq_run(stl))) * 1.3 + brL2.bq_run(brL1.bq_run(brl)) * 0.7;
  yr = bsR1.bq_run(bsr) * 1.3 + flR2.bq_run(flR1.bq_run(flr)) * 1.1 + prR2.bq_run(prR1.bq_run(prr))
     + stR3.bq_run(stR2.bq_run(stR1.bq_run(str))) * 1.3 + brR2.bq_run(brR1.bq_run(brr)) * 0.7;
  yl = voL2.bq_run(voL1.bq_run(yl)) * 0.04 * ex_s;
  yr = voR2.bq_run(voR1.bq_run(yr)) * 0.04 * ex_s;

  pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;

  ge_e += (max(abs(yl), abs(yr)) - ge_e) * ge_env_c;
  yl = drL.bq_run(yl);  yr = drR.bq_run(yr);
  uxL.os_up(yl);  uxR.os_up(yr);
  os_f == 1 ? (
    yl = amL.bq_run(gL.ge_run(yl));  yr = amR.bq_run(gR.ge_run(yr));
  ) : os_f == 2 ? (
    a0 = amL.bq_run(gL.ge_run(uxL.s0));  a1 = amL.bq_run(gL.ge_run(uxL.s1));
    b0 = amR.bq_run(gR.ge_run(uxR.s0));  b1 = amR.bq_run(gR.ge_run(uxR.s1));
    yl = dnL.os_dn(a0, a1, 0, 0);  yr = dnR.os_dn(b0, b1, 0, 0);
  ) : (
    a0 = amL.bq_run(gL.ge_run(uxL.s0));  a1 = amL.bq_run(gL.ge_run(uxL.s1));
    a2 = amL.bq_run(gL.ge_run(uxL.s2));  a3 = amL.bq_run(gL.ge_run(uxL.s3));
    b0 = amR.bq_run(gR.ge_run(uxR.s0));  b1 = amR.bq_run(gR.ge_run(uxR.s1));
    b2 = amR.bq_run(gR.ge_run(uxR.s2));  b3 = amR.bq_run(gR.ge_run(uxR.s3));
    yl = dnL.os_dn(a0, a1, a2, a3);  yr = dnR.os_dn(b0, b1, b2, b3);
  );
  yl *= os_g;  yr *= os_g;

  dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
  dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
  pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
  ost_out(yl * out_g, yr * out_g);  yl = ost_l;  yr = ost_r;
  gp_g < 1 ? ( gp_g = min(1, gp_g + gp_c);  t = gp_g * gp_g * (3 - 2 * gp_g);  yl *= t;  yr *= t; );
) : (
  l16 += (l16_t - l16) * c_smk;  l8 += (l8_t - l8) * c_smk;  l4 += (l4_t - l4) * c_smk;
  l223 += (l223_t - l223) * c_smk;  l2 += (l2_t - l2) * c_smk;  l135 += (l135_t - l135) * c_smk;
  pc_s += (pc_t - pc_s) * c_smk;  ck_s += (ck_t - ck_s) * c_smk;  bs_s += (bs_t - bs_s) * c_smk;  br_s += (br_t - br_s) * c_smk;
  vdry += (vdry_t - vdry) * c_smk;  vwa += (vwa_t - vwa) * c_smk;  ven += (ven_t - ven) * c_smk;  vdp += (vdp_t - vdp) * c_smk;
  spm_s += (spm_t - spm_s) * c_smk;  c_outg += (c_outg_t - c_outg) * c_smk;
  c_dkreq ? (
    c_dk -= c_dkst;
    c_dk <= 0 ? (
      c_dk = 0;  wv_l = wv_t;  vc_l = vc_t;  c_dkreq = 0;
      wv_tb = WT + wv_l * 11 * TSTR;  wv_g = wv_l == 0 ? 0.9 : wv_l == 1 ? 0.56 : wv_l == 2 ? 1.15 : 2.1;
      memcpy(BQV1, BQN1, 5);  memcpy(BQV2, BQN2, 5);
    );
  ) : c_dk < 1 ? c_dk = min(1, c_dk + c_dkst);

  c_crn <= 0 ? ( c_crn = CR;  c_ctl_tick(); );
  c_crn -= 1;

  k = 0;
  loop(12,
    u_ph = MPH[k] + MINC[k];  u_ph >= 1 ? ( u_ph -= 1;  MCN[k] = (MCN[k] + 1) & 1023; );  MPH[k] = u_ph;
    k += 1;
  );
  bus = 0;  k = 0;
  loop(pl_n,
    u_p = PLS[k];
    u_lv = PL[u_p] + PSTP[u_p];  PL[u_p] = u_lv;
    u_m = PPC[u_p];  u_iv = PIV[u_p];
    u_q = TWP[u_p] + MINC[u_m] * u_iv * TWK[u_p];
    u_q >= 1 ? u_q -= 1 : u_q < 0 ? u_q += 1;  TWP[u_p] = u_q;
    u_q += ((MCN[u_m] & PMK[u_p]) + MPH[u_m]) * u_iv;  u_q >= 1 ? u_q -= 1;
    bus += c_tone(wv_tb + PKO[u_p], u_q) * u_lv;
    k += 1;
  );
  ck_e > 0.0001 ? (
    u_n = rand(2) - 1;  ck_h += (u_n - ck_h) * lc_br;  ck_l += (u_n - ck_h - ck_l) * 0.5;
    bus += ck_l * ck_e * ck_s * 20;  ck_e *= ck_dc;
  ) : ck_e = 0;

  pwr_in(bus, bus);  bus = pwr_l;
  cux.os_up(bus);
  os_f == 1 ? ( y = c_ts(bus * wv_g * 0.12) * 4.2; ) :
  os_f == 2 ? ( y = cdn.os_dn(c_ts(cux.s0 * wv_g * 0.12) * 4.2, c_ts(cux.s1 * wv_g * 0.12) * 4.2, 0, 0); ) :
  ( y = cdn.os_dn(c_ts(cux.s0 * wv_g * 0.12) * 4.2, c_ts(cux.s1 * wv_g * 0.12) * 4.2, c_ts(cux.s2 * wv_g * 0.12) * 4.2, c_ts(cux.s3 * wv_g * 0.12) * 4.2); );
  y *= os_g;
  y = fm2.c_bq(BQV2, fm1.c_bq(BQV1, y));
  t_l += (y - t_l) * lc_bs;  t_h += (y - t_h) * lc_br;
  y += t_l * bs_s + (y - t_h) * br_s;
  y = hpf.c_bq(BQHP, y);
  o_lp += (y - o_lp) * lc_8k;  y = o_lp * c_outg * c_dk;

  VBL[vb_w] = y;
  u_c = vb_c * vb_ca - vb_s * vb_sa;  vb_s = vb_s * vb_ca + vb_c * vb_sa;  vb_c = u_c;
  (vwa > 0.0001) ? (
    u_dd = vb_w - (vb_base + vdp * vb_s);  u_dd < 0 ? u_dd += VB_N;
    u_i = floor(u_dd);  u_f = u_dd - u_i;
    u_a = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
    u_dd = vb_w - (vb_base - vdp * vb_s);  u_dd < 0 ? u_dd += VB_N;
    u_i = floor(u_dd);  u_f = u_dd - u_i;
    u_b = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
  ) : ( u_a = 0;  u_b = 0; );
  u_bw = c_vmode >= 1.5 && c_vmode < 2.5 ? 1 : 0;  vbw += (u_bw - vbw) * c_smk;
  u_dly = VBL[(vb_w - floor(vb_base) + VB_N) & (VB_N - 1)];
  vb_w = (vb_w + 1) & (VB_N - 1);
  yl = u_dly * vdry + u_a * vwa;
  yr = u_dly * vdry + (u_a + (u_b - u_a) * vbw) * vwa;
  u_c = en_c * en_ca - en_s * en_sa;  en_s = en_s * en_ca + en_c * en_sa;  en_c = u_c;
  ven > 0.0001 ? (
    u_e = vdp * 2.6;  u_f2 = 0.0001 * srate * (0.3 + (c_vdepth * 0.01));
    u_dd = vb_w - (en_base + u_e * en_s + u_f2 * vb_s);  u_dd < 0 ? u_dd += VB_N;
    u_i = floor(u_dd);  u_f = u_dd - u_i;  u_e1 = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
    u_dd = vb_w - (en_base + u_e * (-0.5 * en_s + 0.8660254 * en_c) + u_f2 * vb_c);  u_dd < 0 ? u_dd += VB_N;
    u_i = floor(u_dd);  u_f = u_dd - u_i;  u_e2 = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
    u_dd = vb_w - (en_base + u_e * (-0.5 * en_s - 0.8660254 * en_c) - u_f2 * vb_s);  u_dd < 0 ? u_dd += VB_N;
    u_i = floor(u_dd);  u_f = u_dd - u_i;  u_e3 = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
    yl += (u_e1 + 0.5 * u_e2) * ven;  yr += (u_e3 + 0.5 * u_e2) * ven;
  );

  spr_live ? (
    spr.c_spr_run((yl + yr) * 0.5, sfb);
    yl += spr.s1 * spm_s * 0.7;  yr += spr.s2 * spm_s * 0.7;
  );

  c_dcxl = yl - c_dcpl + c_dcr * c_dcxl;  c_dcpl = yl;  yl = c_dcxl;
  c_dcxr = yr - c_dcpr + c_dcr * c_dcxr;  c_dcpr = yr;  yr = c_dcxr;
  pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
  ost_out(ostL.ost_band(yl), ostR.ost_band(yr));  yl = ost_l;  yr = ost_r;
  c_gf < 1 ? ( c_gf = min(1, c_gf + c_gfi);  u_g = c_gf * c_gf * (3 - 2 * c_gf);  yl *= u_g;  yr *= u_g; );
);

sw_g = mdl_t == mdl_a ? min(1, sw_g + sw_c) : max(0, sw_g - sw_c);
sw_g < 1 ? ( t = sw_g * sw_g * (3 - 2 * sw_g);  yl *= t;  yr *= t; );
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

