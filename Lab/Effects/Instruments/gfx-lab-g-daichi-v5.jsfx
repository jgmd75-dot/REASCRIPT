      dh_v = (dh_y - dh_p[20]) * dh_lg; dh_y = dh_v + dh_p[20]; dh_p[20] = dh_y + dh_v;
      dh_v = (dh_y - dh_p[21]) * dh_lg; dh_y = dh_v + dh_p[21]; dh_p[21] = dh_y + dh_v;
      dh_v = (dh_y - dh_p[22]) * dh_lg; dh_y = dh_v + dh_p[22]; dh_p[22] = dh_y + dh_v;
      dh_y *= 1 + dh_lk * 0.5;
