function dh_qpush(ofs, t, n, v) local(i) (
  dh_qc < 300 ? (
    i = dh_qc; while (i > 0 && DQO[i - 1] > ofs) ( DQO[i] = DQO[i - 1]; DQT[i] = DQT[i - 1]; DQN[i] = DQN[i - 1]; DQV[i] = DQV[i - 1]; i -= 1; );
    DQO[i] = ofs; DQT[i] = t; DQN[i] = n; DQV[i] = v; dh_qc += 1;
  );
);

function dh_lfo_beats(r) ( r == 0 ? 16 : r == 1 ? 8 : r == 2 ? 4 : r == 3 ? 2 : r == 4 ? 4 / 3 : r == 5 ? 1 : r == 6 ? 2 / 3 :
                          r == 7 ? 0.5 : r == 8 ? 1 / 3 : r == 9 ? 0.25 : r == 10 ? 1 / 6 : 0.125; );
function dh_arp_beats(r) ( r == 0 ? 1 : r == 1 ? 2 / 3 : r == 2 ? 0.5 : r == 3 ? 1 / 3 : r == 4 ? 0.25 : r == 5 ? 1 / 6 : 0.125; );
function dh_dly_beats(r) ( r == 0 ? 2 : r == 1 ? 1.5 : r == 2 ? 1 : r == 3 ? 2 / 3 : r == 4 ? 0.75 : r == 5 ? 0.5 : r == 6 ? 1 / 3 : 0.25; );

function dh_lfo_set(l, a, c) local(b, r) (
  b = DLF + l * 16;
  b[0] = floor(slider(a) + 0.5); b[2] = floor(slider(a + 2) + 0.5);
  b[3] = dh_lfo_beats(floor(slider(a + 3) + 0.5)) * (b[0] == 7 ? 16 : 1);
  r = b[2] ? dh_tmp / 60 / b[3] : slider(a + 1) / (b[0] == 7 ? 16 : 1);
  b[1] = r; b[11] = r * 4 / srate;
  b[4] = slider(a + 4) / 100; b[5] = floor(slider(a + 5) + 0.5); b[6] = slider(a + 6) >= 0.5;
  b[7] = slider(c) / 100; b[8] = floor(slider(c + 1) + 0.5); b[9] = slider(c + 2) >= 0.5;
  b[10] = slider(c + 3) > 0 ? 4 / (slider(c + 3) * 0.001 * srate) : 1;
  b[12] = 1 - exp(-4 / (0.002 * srate));
  dh_dk = 1 - exp(-4 / (0.03 * srate));
  b[14] = b[4] != 0 || b[7] != 0 || (l == 0 && dh_mwd == 2);
  b[9] && b[14] ? dh_anyv = 1;
);

function dh_c4(c) ( 1 - (1 - c) ^ 4; );
function update() local(r, g) (
  dh_w1 = slider1; dh_subw = slider2; dh_sub = slider3 / 100 * 0.8;
  dh_fm = sqr(slider4 / 100) * 1.5;
  dh_w2 = slider5; dh_o2st = slider6 + slider7 / 100; dh_trk = slider8; dh_sync = slider9;
  dh_ring = slider10 / 100; r = slider11 / 100; dh_mixr = r;
  dh_m1 = (1 - r) * (1 - dh_ring); dh_m2 = r * (1 - dh_ring);
  dh_pw = slider12 / 100;
  dh_ma4 = dh_c4(vo_coef(slider13)); dh_md4 = dh_c4(vo_coef(slider14)); dh_mamt = slider15 / 100; dh_mdst = slider16;
  dh_ftt = floor(slider17 + 0.5); dh_cut = slider18; dh_res = slider19 / 100;
  fl_lc = log(dh_cut);
  dh_k = 2 - 1.985 * fl_rs;
  dh_lk = fl_rs * 4.15;
  dh_sat = slider20 / 100; dh_sg = 1 + dh_sat * 5; dh_sn = 1 / (1 + dh_sat * 1.6);
  dh_key = slider21 / 100; dh_fenv = slider22 / 100; dh_fvel = slider23 / 100;
  dh_fa4 = dh_c4(vo_coef(slider24)); dh_fd4 = dh_c4(vo_coef(slider25)); dh_fs = slider26 / 100; dh_fr4 = dh_c4(vo_coef(slider27));
  dh_aa = vo_coef(slider28); dh_ad = vo_coef(slider29); dh_as = slider30 / 100; dh_ar = vo_coef(slider31);
  dh_gain = 10 ^ (slider32 / 20) * 0.9; dh_avel = slider33 / 100;
  dh_tmp = tempo > 0 ? tempo : 120;
  dh_mode = slider48; dh_nv = max(1, min(16, floor(slider49 + 0.5)));
  dh_un = min(max(1, floor(slider50 + 0.5)), dh_nv); dh_uscl = 1 / sqrt(dh_un);
  dh_udet = slider51 / 100; dh_uspr = slider52 / 100;
  dh_porta = slider53; dh_pc = slider53 > 0 ? dh_c4(vo_coef(slider53)) : 1;
  dh_brng = slider54; dh_mwd = slider55;
  dh_anyv = 0; dh_lfo_set(0, 34, 85); dh_lfo_set(1, 41, 89); dh_lfo_set(2, 93, 100);
  dh_dtyp = slider62; dh_dat = max(slider63 - 50, 0) / 50;
  dh_dwt = min(dh_dat * 10, 1);

  dh_phst = slider64 >= 0.5 && slider66 > 0; dh_phr = slider65; dh_phd = slider66 / 100;
  dh_cho = slider67; dh_chf = slider68; dh_chr = slider69; dh_chd = slider70 / 100;
  dh_dly = slider71; dh_dlb = dh_dly_beats(slider72); dh_dfb = slider73 / 100; dh_dmx = slider74 / 100; dh_dpp = slider75;
  dh_dlt = min(dh_dlb * 60 / dh_tmp * srate, DDLM - 4);
  dh_drift = slider76 / 100; dh_volt = 10 ^ ((slider77 + slider104) / 20); dh_chan = slider78;
  dh_fmax = srate * 0.45; dh_pis = $pi / srate; dh_440s = 440 / srate;
  ins_output_setup(79);
);

function dh_daa(z) instance(z1, ad1, cv1, rd) local(q, ad, cv, d, y) (
  q = z * z;
  q < 9 ? ( ad = q * 0.05555555555555556 + 1.3333333333333333 * log(1 + q * 0.3333333333333333); cv = z * (27 + q) / (27 + 9 * q); )
        : ( ad = abs(z) - 0.6516075; cv = sign(z); );
  rd ? ( z1 = z; ad1 = ad; cv1 = cv; rd = 0; );
  d = z - z1;
  y = abs(d) > 0.00001 ? (ad - ad1) / d : vo_tanh(0.5 * (z + z1));
  y += 0.5 * (cv - cv1);
  z1 = z; ad1 = ad; cv1 = cv;
  y;
);
dh_dzl.rd = dh_dzr.rd = 1;
dh_pfl.clp_pf_cfg(40000, 6000, -1.5, 150); dh_pfr.clp_pf_cfg(40000, 6000, -1.5, 150);
dh_pfl.clp_pf_reset(); dh_pfr.clp_pf_reset();

ins_drift_init();
fl_ok = 0;
dh_bend = 0; dh_mw = 0; dh_pedal = 0; dh_hc = 0; dh_age = 0; dh_last = -1; dh_qc = 0;
dh_wasarp = 0; dh_lastmode = -1; dh_ct = 0;
dh_i = 0; loop(3, dh_zg = DLG + dh_i * 12; memset(dh_zg, 0, 12); dh_zg[1] = rand(2) - 1; dh_zg[2] = rand(2) - 1;
                  dh_zg[4] = dh_zg[5] = dh_zg[6] = dh_zg[7] = 1; dh_i += 1; );
dh_lw0.drift_init(0.8 + rand(1) * 0.5); dh_lw1.drift_init(0.8 + rand(1) * 0.5); dh_lw2.drift_init(0.8 + rand(1) * 0.5);
dh_dfirst = 1; dh_damg = max(slider63 - 50, 0) / 50; dh_gtrem = 1; dh_chdm = slider70 / 100; dh_chg = dh_chdm; dh_csn = 1; dh_dmxm = slider74 / 100;

dh_grg = slider10 / 100; dh_gm1 = (1 - slider11 / 100) * (1 - dh_grg); dh_gm2 = slider11 / 100 * (1 - dh_grg);
dh_gsub = slider3 / 100 * 0.8; dh_gk = 2 - 1.985 * slider19 / 100; dh_glk = slider19 / 100 * 4.15;
dh_dcxl = dh_dcyl = dh_dcxr = dh_dcyr = 0; dh_vol = 1; dh_wp = 0; dh_cwp = 0; dh_dts = -1;
dh_wasdly = 0; dh_wascho = 0; dh_phph = 0; dh_chph = 0; dh_vph = 0; dh_hold = 0; dh_holdr = 0; dh_hcnt = 0;

function dh_srinit() ( dh_sr = srate; dh_sm = 1 - exp(-1 / (0.03 * srate)); ost_init(20000); dh_dts = -1; );
dh_srinit();
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
update(); dh_ft = dh_ftt; dh_fdk = 1; dh_phw = dh_phst;
dh_lastmode = dh_mode; dh_wasarp = slider56;
dh_pcf = 0; dh_pck = dh_pcg = 1;

DPCP = 43300; dh_pcn = 0;
function dh_pchold(n, v) ( dh_pcn < 32 ? ( DPCP[dh_pcn * 2] = n; DPCP[dh_pcn * 2 + 1] = v; dh_pcn += 1; ); );
function dh_pcunhold(n) local(i, j) (
  i = j = 0; loop(dh_pcn, DPCP[i * 2] != n ? ( DPCP[j * 2] = DPCP[i * 2]; DPCP[j * 2 + 1] = DPCP[i * 2 + 1]; j += 1; ); i += 1; ); dh_pcn = j;
);
function dh_pcapply() local(i, p) (
  i = 0; loop(16, p = DV + i * 64; p[13] == 3 ? ( p[13] = 0; p[15] = 0; p[14] = 0; p[17] = 0; p[0] = -1; p[19] = p[20] = p[21] = p[22] = 0; ); i += 1; );
  update(); dh_lastmode = dh_mode; dh_pcf = 0; dh_ft = dh_ftt; dh_fdk = 1;
  i = 0; loop(dh_pcn, dh_note_on(DPCP[i * 2], DPCP[i * 2 + 1]); i += 1; ); dh_pcn = 0;
  dh_dly && !dh_wasdly ? ( memset(DDLL, 0, 524288 * 2); dh_dts = -1; ); dh_wasdly = dh_dly;
  dh_cho && !dh_wascho ? ( memset(DCHL, 0, 8192 * 2); dh_csn = 1; ); dh_wascho = dh_cho;
  dh_dts = dh_dlt;
);
dh_vol = dh_volt;
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(105, i != 105 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 40 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(40, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;
function av_gap() local(i, p) (
  memset(DDLL, 0, 1048576); memset(DCHL, 0, 16384);
  i = 0; loop(16, p = DV + i * 64; p[1] = 0; p[13] = 0; p[14] = 0; p[15] = 0; p[17] = 0; p[0] = -1; p[19] = p[20] = p[21] = p[22] = 0; i += 1; );
  ostL.ost_ch_init(); ostR.ost_ch_init(); dh_pck = 0; dh_pcg = 0;
);
pwr_init(); pwr_hum_db = -71.1; pwr_sag = 0.1; pwr_wu_loss = 0.3; pwr_wu_drv = 0.2; pwr_wu_lp = 12000; pwr_wu_wob = 0.04; pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
!dh_panic && !dh_pcf ? update();

@block
prs_chk();
av_now = time_precise();
av_tp > 0 && av_now - av_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > av_gpp && play_position - av_gpp < 4 * av_gpd + 0.05) ? av_gap();
av_tp = av_now; av_gpp = play_position; av_gpd = samplesblock / srate;
pwr_block(1);
srate != dh_sr ? dh_srinit();
dh_pcr = 1 / (0.012 * srate); dh_fdr = 1 / (0.006 * srate); dh_phk = 1 - exp(-1 / (0.012 * srate));
dh_cdk = 1 - exp(-1 / (0.0015 * srate));
dh_dcr = 1 / (0.002 * srate);

fl_k = 1 - exp(-1 / (0.015 * srate));
!fl_ok ? ( fl_c1 = fl_c2 = log(slider18); fl_rs = slider19 / 100; fl_ev = slider22 / 100; fl_ok = 1; );
dh_panic && !dh_pcf ? ( dh_i = 0; loop(16, DV[dh_i * 64 + 13] > 0 ? dh_pcf = 1; dh_i += 1; ); );
!dh_pcf ? update();
arp_params(slider57, dh_arp_beats(slider59), slider58, slider60 / 100, 0, 16, 0, 1, 0, 0, 0, 100, 0);
dh_pfl.clp_pf_block(dh_damt * dh_damt, srate, samplesblock); dh_pfr.clp_pf_block(dh_damt * dh_damt, srate, samplesblock);

dh_qc = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, dh_chan) ? (
    dh_st = m1 & 0xF0;
    dh_st == 0x90 || dh_st == 0x80 ? (
      slider56 ? arp_key(m2, m3, 0, dh_st == 0x90 && m3 > 0) : dh_qpush(mofs, dh_st == 0x90 && m3 > 0, m2, m3);
      dh_st == 0x90 && m3 > 0 ? ins_midi_hit();
    ) :
    dh_st == 0xE0 ? dh_bend = (((m3 * 128 + m2) - 8192) / 8192) * dh_brng :
    dh_st == 0xB0 ? (
      m2 == 1 ? dh_mw = m3 / 127 :
      m2 == 64 ? ( dh_pedal = m3 >= 64; !dh_pedal ? dh_qpush(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? dh_qpush(mofs, 3, 0, 0);
    );
  );
  midisend(mofs, m1, m2, m3);
);

gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( dh_qpush(0, 3, 0, 0); );
gfx_pst_prev = gfx_pst;
!slider56 && dh_wasarp ? ( arp_outn = 0; arp_flush(); arp_sn = 0; arp_pn = 0; dh_qpush(0, 3, 0, 0); );
slider56 && !dh_wasarp ? dh_qpush(0, 3, 0, 0);
dh_wasarp = slider56;
dh_mode != dh_lastmode ? ( dh_qpush(0, 3, 0, 0); dh_lastmode = dh_mode; );
slider56 ? (
  arp_block(play_state & 1, beat_position, dh_tmp, samplesblock);
  dh_i = 0; loop(arp_outn, dh_qpush(arp_out_ofs[dh_i], arp_out_on[dh_i], arp_out_note[dh_i], arp_out_vel[dh_i]); dh_i += 1; );
);
dh_panic ? ( dh_all_off(); dh_panic = 0; );

dh_i = dh_nv; loop(16 - dh_nv, dh_p = DV + dh_i * 64; dh_p[1] ? dh_vrel(dh_p); dh_i += 1; );
dh_eqi = 0; dh_spos = 0;

play_state & 1 ? (
  dh_i = 0;
  loop(3,
    dh_zb = DLF + dh_i * 16; dh_zg = DLG + dh_i * 12;
    dh_zb[2] == 1 && !dh_zb[6] ? (
      dh_zp = beat_position / dh_zb[3]; dh_zp -= floor(dh_zp);
      dh_zp < dh_zg[0] - 0.5 ? ( dh_zg[2] = dh_zg[1]; dh_zg[1] = rand(2) - 1; );
      dh_zg[0] = dh_zp;
    );
    dh_i += 1;
  );
);
dh_zp = 0.35 * samplesblock / srate;
DLG[7] = 1 + dh_lw0.drift_tick(dh_zp) * dh_drift * 0.08;
DLG[19] = 1 + dh_lw1.drift_tick(dh_zp) * dh_drift * 0.08;
DLG[31] = 1 + dh_lw2.drift_tick(dh_zp) * dh_drift * 0.08;

dh_dly && !dh_wasdly ? ( memset(DDLL, 0, 524288 * 2); dh_dts = -1; ); dh_wasdly = dh_dly;
dh_cho && !dh_wascho ? ( memset(DCHL, 0, 8192 * 2); dh_csn = 1; ); dh_wascho = dh_cho;
dh_dts < 0 ? dh_dts = dh_dlt;

abs(dh_pfl) + abs(dh_a1l) + abs(dh_a2l) + abs(dh_a3l) + abs(dh_a4l) < 0.0000000001 ? dh_pfl = dh_a1l = dh_a2l = dh_a3l = dh_a4l = 0;
abs(dh_pfr) + abs(dh_a1r) + abs(dh_a2r) + abs(dh_a3r) + abs(dh_a4r) < 0.0000000001 ? dh_pfr = dh_a1r = dh_a2r = dh_a3r = dh_a4r = 0;
abs(dh_dfl) + abs(dh_dfr) + abs(dh_tl) + abs(dh_tr) < 0.0000000001 ? dh_dfl = dh_dfr = dh_tl = dh_tr = 0;
abs(dh_dcyl) + abs(dh_dcyr) < 0.0000000001 ? dh_dcyl = dh_dcyr = 0;

ins_drift_block(dh_drift, samplesblock);
dh_dps = 12 * log(ins_pitch) / LN2;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_mem(0, DSTEP, 48);
file_avail(0) != 0 ? file_var(0, dh_lsel);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
while (dh_eqi < dh_qc && (DQO[dh_eqi] <= dh_spos || dh_spos >= samplesblock - 1)) (
  dh_et = DQT[dh_eqi];
  dh_et == 1 ? ( dh_pcf ? dh_pchold(DQN[dh_eqi], DQV[dh_eqi]) : dh_note_on(DQN[dh_eqi], DQV[dh_eqi]); ) : dh_et == 0 ? ( dh_pcunhold(DQN[dh_eqi]); dh_note_off(DQN[dh_eqi]); ) : dh_et == 2 ? dh_pedal_up() : ( dh_pcn = 0; dh_all_off(); );
  dh_eqi += 1;
);
dh_spos += 1;
dh_pcf ? ( dh_pck -= dh_pcr; dh_pck <= 0 ? ( dh_pck = 0; dh_pcapply(); ); dh_pcg = 0.5 - 0.5 * cos($pi * dh_pck); ) :
dh_pck < 1 ? ( dh_pck = min(dh_pck + dh_pcr, 1); dh_pcg = 0.5 - 0.5 * cos($pi * dh_pck); );

fl_c1 += (fl_lc - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (dh_res - fl_rs) * fl_k; fl_ev += (dh_fenv - fl_ev) * fl_k;

dh_ct += 1;
dh_tick = dh_ct >= 4;
dh_tick ? (
  dh_ct = 0;
  dh_lfo_tick();
  dh_pmod = dh_bend + dh_dps; dh_l2p = ins_aux; dh_loct = ins_cut; dh_trem = 1; dh_lpan = 0; dh_lfm = 0; dh_lpw = 0;
  dh_lres = dh_lmix = dh_lring = dh_lsub = dh_ludet = dh_lcho = dh_ldly = 0;
  dh_lfo_all();
  dh_mwd == 1 ? ( dh_vph += 5.5 * 4 / srate; dh_vph -= floor(dh_vph); dh_pmod += sin(2 * $pi * dh_vph) * dh_mw * 0.5; ) :
  dh_mwd == 3 ? dh_loct += dh_mw * 3 :
  dh_mwd == 4 ? dh_lfm += dh_mw * 0.8;
  dh_gtrem = dh_trem;
  dh_chdm = min(max(dh_chd + dh_lcho, 0), 1); dh_dmxm = min(max(dh_dmx + dh_ldly, 0), 1);

  dh_gpmod = dh_pmod; dh_gl2p = dh_l2p; dh_gloct = dh_loct; dh_glpan = dh_lpan; dh_glfm = dh_lfm; dh_glpw = dh_lpw;
  dh_glres = dh_lres; dh_glmix = dh_lmix; dh_glring = dh_lring; dh_glsub = dh_lsub; dh_gludet = dh_ludet;
  dh_vr = min(max(dh_mixr + dh_lmix, 0), 1); dh_grg = min(max(dh_ring + dh_lring, 0), 1);
  dh_gm1 = (1 - dh_vr) * (1 - dh_grg); dh_gm2 = dh_vr * (1 - dh_grg); dh_gsub = min(max(dh_sub + dh_lsub, 0), 0.8);
  dh_vr = min(max(fl_rs + dh_lres, 0), 1); dh_gk = 2 - 1.985 * dh_vr; dh_glk = dh_vr * 4.15;
);

dh_L = dh_R = 0;
dh_p = DV;
loop(16,
  dh_p[13] > 0 ? (
    (dh_tick || dh_p[38]) ? (
      dh_p[38] = 0;
      dh_p[4] += (dh_p[5] - dh_p[4]) * dh_pc;

      dh_e = dh_p[16];
      dh_p[15] == 1 ? ( dh_e += (1.3 - dh_e) * dh_fa4; dh_e >= 1 ? ( dh_e = 1; dh_p[15] = 2; ); ) :
      dh_p[15] == 2 ? dh_e += (dh_fs - dh_e) * dh_fd4 :
      dh_p[15] == 3 ? dh_e -= dh_e * dh_fr4;
      dh_p[16] = dh_e;
      dh_m = dh_p[18];
      dh_p[17] == 1 ? ( dh_m += (1.3 - dh_m) * dh_ma4; dh_m >= 1 ? ( dh_m = 1; dh_p[17] = 2; ); ) :
      dh_p[17] == 2 ? dh_m -= dh_m * dh_md4;
      dh_p[18] = dh_m; dh_m *= dh_mamt;

      dh_anyv ? (
        dh_pmod = dh_gpmod; dh_l2p = dh_gl2p; dh_loct = dh_gloct; dh_lpan = dh_glpan; dh_lfm = dh_glfm; dh_lpw = dh_glpw;
        dh_lres = dh_glres; dh_lmix = dh_glmix; dh_lring = dh_glring; dh_lsub = dh_glsub; dh_ludet = dh_gludet; dh_trem = 1;
        dh_vlfo(dh_p);
        dh_p[35] = dh_trem;
        dh_vr = min(max(dh_mixr + dh_lmix, 0), 1); dh_rg = min(max(dh_ring + dh_lring, 0), 1);
        dh_p[39] = (1 - dh_vr) * (1 - dh_rg); dh_p[40] = dh_vr * (1 - dh_rg); dh_p[41] = dh_rg;
        dh_p[42] = min(max(dh_sub + dh_lsub, 0), 0.8);
        dh_vr = min(max(fl_rs + dh_lres, 0), 1); dh_p[36] = 2 - 1.985 * dh_vr; dh_p[37] = dh_vr * 4.15;
      ) : (
        dh_p[35] = 1; dh_p[39] = dh_gm1; dh_p[40] = dh_gm2; dh_p[41] = dh_grg; dh_p[42] = dh_gsub;
        dh_p[36] = dh_gk; dh_p[37] = dh_glk;
      );

      dh_ud = dh_ludet != 0 ? dh_p[8] * max(1 + dh_ludet, 0) : dh_p[8];
      dh_b = dh_p[4] + dh_p[7] + dh_ud + dh_pmod;
      dh_p[24] = min(exp((dh_b - 69) * L12) * dh_440s, 0.45);
      dh_b2 = (dh_trk ? dh_b : 60 + dh_p[7] + dh_ud + dh_pmod) + dh_o2st + dh_l2p + (dh_mdst == 0 ? dh_m * 48 : 0);
      dh_p[25] = min(exp((dh_b2 - 69) * L12) * dh_440s, 0.45);

      dh_v = dh_p[6];
