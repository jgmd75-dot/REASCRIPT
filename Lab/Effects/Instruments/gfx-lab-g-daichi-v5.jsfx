@gfx 900 400
AVPF = 0xB9BCC0; AVINX = 0xA4A8AE; AVI = 0x1C1E21; AVDOT = 0x34373C; AVTD = 0.3; AVB = 0x45494F; AVM = 0xFF8A3D;
