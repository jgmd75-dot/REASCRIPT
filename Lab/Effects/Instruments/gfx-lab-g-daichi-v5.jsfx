                              (2 * dh_q - 1 - vo_blep(dh_q, dh_i2)) - (2 * dh_qr - 1 - vo_blep(dh_qr, dh_i2)); ) : rand(2) - 1;
      dh_o2 = dh_p[23]; dh_p[23] = dh_o2n;
