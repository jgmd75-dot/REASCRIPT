);
function av_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * av_kt * sc, 'b'); );
function av_fc(px) ( gfx_setfont(12, "Courier New", px * av_kt * sc, 'b'); );
function av_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function av_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function av_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function av_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function av_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function av_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(ui_mix(f, 0, 0.10 + d * 0.012)); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
AVIN = AVINX > 0 ? AVINX : ui_mix(ui_mix(AVPF, 0, 0.10), 0, 0.42);
function av_pocket(x, y, w, h) ( av_cham(x, y, w, h, 3, AVPF); ui_col(AVIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function av_hover(cx, cy, fs) ( av_hon = 1; av_hx = cx; av_hy = cy; av_hfs = fs; );
function av_title(x, y, s, c) local(tw, th, x0, y0, i, n) (
  av_ft(16); gfx_measurestr(s, tw, th);
  x0 = floor(x * sc); y0 = floor(y * sc - th * 0.5);
  ui_col(AVI); gfx_x = x0; gfx_y = y0; gfx_drawstr(s);
  n = ceil(th) + 2;
  gfx_dest = 60; gfx_setimgdim(60, ceil(tw) + 4, n);
  ui_col(AVIN); gfx_rect(0, 0, ceil(tw) + 4, n);
  ui_col(AVTD > 0 ? ui_mix(c, 0, AVTD) : ui_mix(c, 0, 0.3)); gfx_x = 2; gfx_y = 1; gfx_drawstr(s);
  gfx_dest = av_bk ? 119 : -1; gfx_mode = 2;
