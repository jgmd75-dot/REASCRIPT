ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
arp_init(30000);
DV  = 40000;
DHN = 41100;
DQO = 41300; DQT = 41600; DQN = 41900; DQV = 42200;
DLEV = 42600; DACC = 42620; DTIE = 42640;
DEFM = 43600;
