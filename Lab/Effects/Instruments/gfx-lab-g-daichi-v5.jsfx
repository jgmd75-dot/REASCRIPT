DLG = 43450;
DSTEP = 43500;
DTMP = 42800;
DCHL = 44000; DCHR = 52192; DCHM = 8191;
DDLL = 61000; DDLR = 61000 + 524288; DDLM = 524287;
memset(DV, 0, 1024);
dh_i = 0; loop(16, DLEV[dh_i] = 1; DACC[dh_i] = 0; DTIE[dh_i] = 0; dh_i += 1; );
arp_pattern(DLEV, DACC, DTIE);
dh_i = 0; loop(16, DV[dh_i * 64] = -1; dh_i += 1; );
memset(DCHL, 0, 8192 * 2);
memset(DDLL, 0, 524288 * 2);

L12 = log(2) / 12; LN2 = log(2);

#dh_def = "2 0 0 0 2 0 8 1 0 0 50 50 1 300 0 0 1 6000 10 0 50 0 0 1 400 50 300 1 300 100 200 0 50 0 5 0 5 0 2 0 1 0.5 0 5 0 0 0 0 8 1 15 60 0 2 1 0 0 1 4 60 0 0 30 0 0.4 60 0 0 0.6 50 0 4 35 25 1";

#dh_def2 = "0 6 0 0 0 2 0 0 0 0.25 0 5 0 2 0 0 4 0 0 -11.6";

function dh_stepdef(l) local(i) ( i = 0; loop(16, DSTEP[l * 16 + i] = ((i & 3) - 1.5) / 1.5; i += 1; ); );

function dh_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
dh_nums(#dh_def, DEFM); dh_nums(#dh_def2, DEFM + 84);
!ui_dflt ? ( dh_stepdef(0); dh_stepdef(1); dh_stepdef(2); );

#dh_pm = "Init|Fat Saw Bass|Acid Line|FM Bass|Sub Bass|Sync Lead|Square Lead|Unison Lead|Soft Lead|PWM Strings|Warm Pad|Sweep Pad|Glass Pad|FM E-Piano|Bell Tines|Clav Pluck|Organ|Poly Brass|Brass Stab|Arp Pulse|Arp Glass|Chip Square|Chip Arp|Noise Sweep|Wind Riser|Laser Zap|Reso Pluck|Hoover|Bit Bass|Phase Keys|Fifth Lead|Dark Drone|Shimmer Pad|Late Vibrato|Step Bass|Gate Pad|Drunk Strings|Tremolo Keys|Random Ripple|Wobble Bass";
