      dh_y = (dh_p[28] * dh_x + dh_bb * (dh_lg * (dh_lg * (dh_lg * dh_p[19] + dh_p[20]) + dh_p[21]) + dh_p[22])) / (1 + dh_lk * dh_p[28]);
      dh_u = dh_x - dh_lk * dh_y; dh_u = vo_tanh(dh_u * 0.8) * 1.25;
