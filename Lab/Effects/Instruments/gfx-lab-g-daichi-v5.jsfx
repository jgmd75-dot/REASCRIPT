#av_title = "DAICHI"; #av_sub1 = "VIRTUAL ANALOGUE"; #av_sub2 = "POLY SYNTH"; #av_num = ""; AVEM = 0;
#av_pm = "Init|Fat Saw Bass|Acid Line|FM Bass|Sub Bass|Sync Lead|Square Lead|Unison Lead|Soft Lead|PWM Strings|Warm Pad|Sweep Pad|Glass Pad|FM E-Piano|Bell Tines|Clav Pluck|Organ|Poly Brass|Brass Stab|Arp Pulse|Arp Glass|Chip Square|Chip Arp|Noise Sweep|Wind Riser|Laser Zap|Reso Pluck|Hoover|Bit Bass|Phase Keys|Fifth Lead|Dark Drone|Shimmer Pad|Late Vibrato|Step Bass|Gate Pad|Drunk Strings|Tremolo Keys|Random Ripple|Wobble Bass";
