// ---------- COMBIS: factory pairs of patch A + patch B (JG, 29 Oct 2026) ----------
// cmb_set(k, A, B, level A, level B, BALANCE, B octave): the two patches, each patch's LEVEL (dB, set so the pair sits
// at patch A's own level with B behind it), BALANCE (50 = both full; lower = B further back), B transposed by octaves. Names = strings 300 + k.
CB = 58000; NCB = 27;
CBG = 58400;                                       // the first combi of each menu group
function cmb_set(k, a, b, la, lb, bal, bo, s) ( CB[(k - 1)*8] = a; CB[(k - 1)*8 + 1] = b; CB[(k - 1)*8 + 2] = la; CB[(k - 1)*8 + 3] = lb; CB[(k - 1)*8 + 4] = bo; CB[(k - 1)*8 + 5] = bal; strcpy(300 + k, s); );
CBG[0] = 1; strcpy(290 + 0, "KEYS");
cmb_set(1, 0, 16, -7.5, -11.0, 50, 0, "PIANO + STRINGS");
cmb_set(2, 8, 45, -5.0, -9.5, 50, 0, "EP + PAD");
cmb_set(3, 11, 17, -2.0, -10.0, 50, 0, "WURLY + STRINGS");
cmb_set(4, 6, 46, 4.0, -11.0, 46, 0, "BELL PIANO + GLASS");
cmb_set(5, 7, 54, -7.0, -11.5, 50, 0, "VIBES + CHOIR");
cmb_set(6, 3, 29, -7.5, -11.0, 50, 0, "ORGAN + STRINGS");
cmb_set(7, 5, 19, 0.5, -10.0, 50, 0, "HARPSI + CHAMBER");
cmb_set(8, 15, 58, -1.5, -8.5, 50, 0, "MUSIC BOX + SPACE");
CBG[1] = 9; strcpy(290 + 1, "STRINGS");
cmb_set(9, 16, 43, -4.5, -6.5, 50, 0, "STRINGS + BRASS");
cmb_set(10, 21, 20, -5.0, -6.5, 50, 0, "CELLOS + VIOLINS");
cmb_set(11, 25, 54, -3.5, -4.5, 50, 0, "STRINGS + CHOIR");
cmb_set(12, 18, 48, -9.0, -11.0, 50, 0, "PWM WASH");
cmb_set(13, 26, 17, 3.0, -10.5, 50, 0, "PIZZ + STRINGS");
CBG[2] = 14; strcpy(290 + 2, "SYNTH");
cmb_set(14, 42, 44, -2.5, -8.0, 50, 0, "BRASS + PAD");
cmb_set(15, 52, 9, 1.0, -0.5, 50, 0, "STAB SECTION");
cmb_set(16, 51, 45, 2.0, -7.5, 50, 0, "PLUCK + PAD");
cmb_set(17, 50, 45, -4.0, -6.0, 50, 0, "SYNC + WARM PAD");
cmb_set(18, 56, 49, -11.0, -8.5, 50, 0, "FAT FIFTHS");
CBG[3] = 19; strcpy(290 + 3, "BASS");
cmb_set(19, 66, 65, -1.5, -5.0, 50, 0, "RESO + SUB");
cmb_set(20, 62, 74, -4.0, -1.5, 50, 0, "BASS + SLAP");
cmb_set(21, 68, 65, -2.0, -7.5, 50, 0, "SYNC + SUB");
CBG[4] = 22; strcpy(290 + 4, "LEAD");
cmb_set(22, 79, 78, -0.5, -4.5, 50, 0, "SAW + SQUARE");
cmb_set(23, 30, 84, -5.0, -10.5, 50, 0, "FLUTE + SINE");
cmb_set(24, 81, 77, 0.5, -2.5, 50, 0, "BRASSY SYNC");
CBG[5] = 25; strcpy(290 + 5, "MALLETS + FX");
cmb_set(25, 35, 44, -2.5, -11.5, 23, 0, "MARIMBA + PAD");
cmb_set(26, 36, 54, 0.5, -11.5, 49, 0, "KALIMBA + CHOIR");
