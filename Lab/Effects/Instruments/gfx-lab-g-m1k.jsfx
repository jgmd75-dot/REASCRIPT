// banks: first patch of each, and their names
function cat_start(c) ( c == 0 ? 0 : c == 1 ? 16 : c == 2 ? 30 : c == 3 ? 42 : c == 4 ? 62 : c == 5 ? 76 : c == 6 ? 88 : 100; );
function cat_of(p) local(c) ( c = 0; loop(6, p >= cat_start(c + 1) ? c += 1; ); c; );
function cat_name(c) ( c == 0 ? "KEYBOARD" : c == 1 ? "STRINGS" : c == 2 ? "WIND+PERC" : c == 3 ? "SYNTH" : c == 4 ? "BASS" : c == 5 ? "LEAD" : "EFFECTS"; );
function lfo_name(w) ( w == 0 ? "TRIANGLE" : w == 1 ? "SAW UP" : w == 2 ? "SAW DOWN" : w == 3 ? "SQUARE" : w == 4 ? "RANDOM" : "NOISE"; );

// ---------- factory bank ----------
