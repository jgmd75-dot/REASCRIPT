in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-g-m1k";
NV = 6;
VN = 50000; VG = 50010; VT = 50020; VS = 50030;    // per voice: note (-1 free), gate, age, held by sustain
HN = 50100;                                        // mono: held-note stack
EQO = 50300; EQT = 50600; EQN = 50900; EQV = 51200; // note event queue (300 each)
PB = 60000;                                        // patch bank: 100 x 128
PSL = 59100;                                       // the slider behind each patch field
LPA = 52000; LPB = 52100;                          // layer A / layer B: each patch's engine settings and filter state
MR = 200000;                                       // Mod Rack lines
gi = 0; loop(NV, VN[gi] = -1; VG[gi] = 0; VT[gi] = 0; VS[gi] = 0; gi += 1; );

function pp(p, j, a, b, c, d, e, f, g, h, i, k) local(o) (
  o = PB + p*128 + j;
  o[0] = a; o[1] = b; o[2] = c; o[3] = d; o[4] = e; o[5] = f; o[6] = g; o[7] = h; o[8] = i; o[9] = k;
);
function pn(p, s) ( strcpy(100 + p, s); );
NPF = 77;
PSL[0] = 9;
PSL[1] = 10;
PSL[2] = 11;
PSL[3] = 12;
PSL[4] = 13;
PSL[5] = 14;
PSL[6] = 15;
