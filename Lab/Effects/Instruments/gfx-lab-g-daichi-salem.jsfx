  p == 56 ? "1:6 5:2 6:12 7:0 11:25 17:0 18:2600 19:20 21:50 22:14 23:0 24:2 25:600 26:50 27:300 28:3 29:600 30:80 31:350 33:60 50:2 51:6 52:50 53:60 54:2 71:1 72:4 73:40 74:22 75:1 76:25 105:1 106:0 107:0 115:1 116:1 117:0.6 118:4.2 119:0.4 120:0.18 121:0 122:1 123:0.125 124:0.25 125:0.5 126:150 127:0.3 128:0.35 129:1 104:-7.8" :
  p == 57 ? "1:5 5:6 6:0 7:0 11:0 17:0 18:8000 19:10 21:50 22:7 23:0 24:2 25:800 26:80 27:600 28:2 29:800 30:85 31:500 33:40 50:1 51:12 52:70 53:0 54:2 76:25 108:0.8 109:0.3 110:2 111:0 112:0 115:1 116:1 117:0.5 118:2.5 119:0.4 120:0.25 121:0 122:1 123:0.125 124:0.25 125:0.4 126:300 127:0.25 128:0 129:0 104:-13.3" :
  "";
);

function sx_pcell(p) (
  p == 55 ? "2 8 40 2 9 1600 2 3 2 3 8 70 3 9 2600 3 3 4 3 10 35 4 8 100 4 9 4200 4 3 7 4 10 30 5 8 20 5 9 700 6 8 50 6 9 1300 6 3 1 6 13 25 7 8 80 7 3 5 7 9 3000 8 8 60 8 3 6 8 9 5500 8 10 50 8 15 100" :
  p == 56 ? "2 0 2 2 9 3000 3 0 4 3 9 3400 4 0 6 4 9 3800 4 8 35 5 0 1 5 9 2200 5 8 15 6 0 3 6 9 2600 7 0 5 7 9 3200 7 10 35 8 0 7 8 9 4200 8 8 40" :
  p == 57 ? "2 8 30 2 1 1.2 2 3 2 3 8 60 3 1 1.6 3 3 5 4 8 100 4 3 7 5 2 1 5 1 1.4 5 9 4000 6 8 40 6 2 0.6 6 3 3 6 9 5000 7 8 75 7 3 6 7 9 6000 8 8 50 8 1 2.2 8 3 4 8 9 3000 8 10 30" :
  "";
);

function dh_psteps(p) (
  p == 35 ? "1 100 -60 20 -100 80 -100 40 -20 100 -80 0 -100 60 -40 90 -100" :
  p == 36 ? "2 100 100 -100 100 -100 100 100 -100 100 -100 100 100 -100 100 100 -100" :
  "";
);
DSRC = 3990000; DVX = 3991000; DNW = 3992000; DRVM = 3993000;
DFFT = 2228224; DSPEC = 2232320;
DTB0 = 3000000; DWT0 = 3100000; DTB1 = 3400000; DWT1 = 3500000;
DSPM = 4200000;
XQ_TLT = 2; XQ_EVN = 3; XQ_BNK = 5; XQ_FRM = 6; XQ_SWP = 7;
XQ_BKC = 10; XQ_BKX = 11; XQ_BKT = 12; XQ_BKE = 13; XQ_BKI = 14;
XQ_WTC = 15; XQ_WTX = 16; XQ_WTB = 17; XQ_WTJ = 18; XQ_WJB = 19; XQ_WTI = 20;
XQ_TB = 21; XQ_WT = 22;
memset(DSRC, 0, 64); memset(DVX, 0, 64); memset(DNW, 0, 128);
DSRC[XQ_TB] = DTB0; DSRC[XQ_WT] = DWT0; DSRC[32 + XQ_TB] = DTB1; DSRC[32 + XQ_WT] = DWT1;
DSRC[XQ_TLT] = DSRC[32 + XQ_TLT] = 1; DSRC[XQ_EVN] = DSRC[32 + XQ_EVN] = 1;
sx_k = 0; loop(8, DRVM[sx_k] = sx_k * 0.1237; sx_k += 1; );

function sx_add_bake(bank, s) local(sp, lv, hm, h, i, base, a, sum, sk, tl, ev) (
  sp = DSRC + s * 32; tl = sp[XQ_TLT]; ev = sp[XQ_EVN];
  sum = 0; h = 1;
  loop(128, a = h ^ (-tl) * (h % 2 == 0 ? ev : 1); sum += a * a; h += 1; );
  sk = 0.6 / sqrt(2 * sum + 0.000000001);
  lv = 0;
  loop(8,
    hm = 128 / (2 ^ lv);
    memset(DFFT, 0, 4096);
    h = 1;
    loop(hm,
      a = h ^ (-tl) * (h % 2 == 0 ? ev : 1);
      DFFT[2 * h + 1] = -a; DFFT[2 * (2048 - h) + 1] = a;
      h += 1;
    );
    fft_ipermute(DFFT, 2048);
    ifft(DFFT, 2048);
    base = sp[XQ_TB] + bank * 16384 + lv * 2048; i = 0;
    loop(2048, base[i] = DFFT[2 * i] * sk; i += 1; );
    lv += 1;
  );
  sp[XQ_BKT] = tl; sp[XQ_BKE] = ev;
);

function sx_add_level(inc) local(hn, lv) (
  hn = floor(0.45 / max(inc * 1.03, 0.0000001));
  lv = 0; loop(7, 128 / (2 ^ lv) > hn ? lv += 1; );
  lv;
);

function sx_amp(h, a) ( DSPEC[2 * h + 1] = -a; DSPEC[2 * (2048 - h) + 1] = a; );
function sx_gauss(h, c, w) ( exp(-sqr((h - c) / w)); );
function sx_vowel(v, i) (
  i == 0 ? ( v == 0 ? 5.6 : v == 1 ? 4.1 : v == 2 ? 2.1 : v == 3 ? 4.4 : 2.3; ) :
  i == 1 ? ( v == 0 ? 8.4 : v == 1 ? 14.2 : v == 2 ? 17.6 : v == 3 ? 6.5 : 6.7; ) :
           ( v == 0 ? 18.8 : v == 1 ? 19 : v == 2 ? 23 : v == 3 ? 18.5 : 17.2; );
);
function sx_wt_fill(bank, k) local(h, i, t, y, a, v0, v1, vt, c, g, x, lev) (
  memset(DSPEC, 0, 4096);
  bank == 1 ? (
    vt = k * 4 / 7; v0 = floor(vt); v1 = min(v0 + 1, 4); vt -= v0;
    h = 1;
    loop(160,
      a = 0; i = 0;
      loop(3, c = sx_vowel(v0, i) + (sx_vowel(v1, i) - sx_vowel(v0, i)) * vt; a += (i == 0 ? 1 : i == 1 ? 0.7 : 0.35) * sx_gauss(h, c, 0.8 + c * 0.12); i += 1; );
      sx_amp(h, h ^ -0.7 * (0.04 + a)); h += 1;
    );
  ) : bank == 2 ? (
    i = 0;
    loop(9,
      h = i == 0 ? 1 : i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 8 : i == 6 ? 10 : i == 7 ? 12 : 16;
      g = k == 0 ? ( i == 0 ) : k == 1 ? ( i <= 1 ) : k == 2 ? ( i <= 2 ) : k == 3 ? ( i <= 3 ? 1 : 0.4 ) :
          k == 4 ? ( i == 0 || i == 2 || i == 4 ) : k == 5 ? ( i == 0 || i == 1 || i == 3 || i == 5 ) :
          k == 6 ? ( i == 0 ? 1 : i >= 4 ) : 1;
      g > 0 ? sx_amp(h, g / (1 + i * 0.15));
      i += 1;
    );
  ) : bank == 7 ? (
    c = log(2 * 20 ^ (k / 7)) / log(2);
    h = 1; loop(400, sx_amp(h, (1 / h) * (1 + 8 * exp(-sqr((log(h) / log(2) - c) / 0.25)))); h += 1; );
  ) : (
    i = 0;
    loop(2048,
      t = i / 2048;
      bank == 0 ? (
        y = sin(2 * $pi * t);
        k == 1 ? y = (t < 0.25 ? 4 * t : t < 0.75 ? 2 - 4 * t : 4 * t - 4);
        k == 2 ? y = 0.5 * (t < 0.25 ? 4 * t : t < 0.75 ? 2 - 4 * t : 4 * t - 4) + 0.5 * (1 - 2 * t);
        k == 3 ? y = 1 - 2 * t;
        k >= 4 ? ( x = k == 4 ? 0.5 : k == 5 ? 0.3 : k == 6 ? 0.15 : 0.07; y = t < x ? 1 : -1; );
      ) : bank == 3 ? (
        lev = k == 0 ? 32 : k == 1 ? 12 : k == 2 ? 6 : k == 3 ? 3 : k == 4 ? 16 : k == 5 ? 8 : k == 6 ? 4 : 2;
        y = k < 4 ? sin(2 * $pi * t) : 1 - 2 * t;
        y = floor(y * lev * 0.5 + 0.5) / (lev * 0.5);
      ) : bank == 4 ? (
        x = sin(2 * $pi * t) * (1 + k * 1.1);
        y = 4 * abs((x + 1) / 4 - floor((x + 1) / 4 + 0.5)) - 1;
        y = -y;
      ) : bank == 5 ? (
        x = t * (1 + k * 0.6); y = 1 - 2 * (x - floor(x));
      ) : (
        x = 0.5 - k * 0.067; y = t < x ? 1 : -1;
      );
      DFFT[2 * i] = y; DFFT[2 * i + 1] = 0;
      i += 1;
    );
    fft(DFFT, 2048); fft_permute(DFFT, 2048);
    memcpy(DSPEC, DFFT, 4096);
  );
  DSPEC[0] = 0; DSPEC[1] = 0;
);

function sx_wt_frame(bank, dst, k, s) local(lv, hm, i, base, sum, sk) (
  sx_wt_fill(bank, k);
  lv = 0;
  loop(8,
    hm = 1024 / (2 ^ lv);
    memcpy(DFFT, DSPEC, 4096);
    i = hm + 1; loop(2047 - hm, DFFT[2 * i] = 0; DFFT[2 * i + 1] = 0; i += 1; );
    i = 2048 - hm; loop(hm, DFFT[2 * i] = DSPEC[2 * i]; DFFT[2 * i + 1] = DSPEC[2 * i + 1]; i += 1; );
    fft_ipermute(DFFT, 2048); ifft(DFFT, 2048);
    lv == 0 ? ( sum = 0; i = 0; loop(2048, sum += sqr(DFFT[2 * i]); i += 1; ); sk = 0.55 / sqrt(sum / 2048 + 0.0000000001); );
    base = DSRC[s * 32 + XQ_WT] + dst * 131072 + (k * 8 + lv) * 2048; i = 0;
    loop(2048, base[i] = DFFT[2 * i] * sk; i += 1; );
    lv += 1;
  );
);

function sx_wt_level(inc) local(hn, lv) (
  hn = floor(0.45 / max(inc * 1.03, 0.0000001));
  lv = 0; loop(7, 1024 / (2 ^ lv) > hn ? lv += 1; );
  lv;
);

function sx_xf_adv(sp) (
  sp[XQ_BKX] > 0 ? ( sp[XQ_BKX] += sx_bks; sp[XQ_BKX] >= 1 ? ( sp[XQ_BKC] = 1 - sp[XQ_BKC]; sp[XQ_BKX] = 0; ); );
  sp[XQ_WTX] > 0 ? ( sp[XQ_WTX] += sx_wts; sp[XQ_WTX] >= 1 ? ( sp[XQ_WTC] = 1 - sp[XQ_WTC]; sp[XQ_WTX] = 0; ); );
);

function sx_src_bake(s) local(sp, k) (
  sp = DSRC + s * 32;
  !sp[XQ_BKI] ? ( sx_add_bake(0, s); sp[XQ_BKC] = 0; sp[XQ_BKX] = 0; sp[XQ_BKI] = 1; );
  !sp[XQ_WTI] ? (
    sp[XQ_WTC] = 0; sp[XQ_WTX] = 0; sp[XQ_WTJ] = -1; sp[XQ_WTI] = 1;
    k = 0; loop(8, sx_wt_frame(sp[XQ_BNK], 0, k, s); k += 1; ); sp[XQ_WTB] = sp[XQ_BNK];
  );
  sp[XQ_WTJ] < 0 && sp[XQ_WTX] == 0 && sp[XQ_BNK] != sp[XQ_WTB] ? ( sp[XQ_WTJ] = 0; sp[XQ_WJB] = sp[XQ_BNK]; );
  sp[XQ_WTJ] >= 0 ? (
    sx_wt_frame(sp[XQ_WJB], 1 - sp[XQ_WTC], sp[XQ_WTJ], s); sp[XQ_WTJ] += 1;
    sp[XQ_WTJ] >= 8 ? ( sp[XQ_WTJ] = -1; sp[XQ_WTB] = sp[XQ_WJB]; sp[XQ_WTX] = 0.000001; );
  );
  sp[XQ_BKX] == 0 && (abs(sp[XQ_TLT] - sp[XQ_BKT]) > 0.003 || abs(sp[XQ_EVN] - sp[XQ_BKE]) > 0.003) ? (
    sx_add_bake(1 - sp[XQ_BKC], s); sp[XQ_BKX] = 0.000001;
  );
);

function sx_tab(s, en, lv, pos, ph) local(sp, re, na, nb, w, m, q, qq, x, y, cur, xf, a1) (
  sp = DSRC + s * 32;
  re = ph * 2048; na = floor(re); re -= na; na &= 2047; nb = (na + 1) & 2047;
  en == 6 ? (
    w = min(floor(pos), 6); m = pos - w;
    cur = sp[XQ_WTC]; xf = sp[XQ_WTX];
    q = sp[XQ_WT] + cur * 131072 + (w * 8 + lv) * 2048; qq = q + 16384;
    x = q[na] + (q[nb] - q[na]) * re; y = qq[na] + (qq[nb] - qq[na]) * re; x += (y - x) * m;
    xf > 0 ? (
      a1 = q + (cur ? -131072 : 131072); qq = a1 + 16384;
      y = a1[na] + (a1[nb] - a1[na]) * re; y += (qq[na] + (qq[nb] - qq[na]) * re - y) * m;
      x += (y - x) * xf;
    );
  ) : (
    cur = sp[XQ_BKC]; xf = sp[XQ_BKX];
    q = sp[XQ_TB] + cur * 16384 + lv * 2048;
    x = q[na] + (q[nb] - q[na]) * re;
    xf > 0 ? ( qq = sp[XQ_TB] + (1 - cur) * 16384 + lv * 2048; x += (qq[na] + (qq[nb] - qq[na]) * re - x) * xf; );
  );
  x;
);

function sx_update() local(sp) (
  sp = DSRC;
  sp[XQ_BNK] = floor(slider105 + 0.5); sp[XQ_FRM] = slider106; sp[XQ_SWP] = slider107; sp[XQ_TLT] = slider108; sp[XQ_EVN] = slider109;
  sp = DSRC + 32;
  sp[XQ_BNK] = floor(slider110 + 0.5); sp[XQ_FRM] = slider111; sp[XQ_SWP] = slider112; sp[XQ_TLT] = slider113; sp[XQ_EVN] = slider114;
  sx_bks = 1 / (0.02 * srate); sx_wts = 1 / (0.03 * srate);
  dh_wu = slider115 >= 0.5;
  sx_spon = slider116 >= 0.5; sx_spsz = slider117; sx_spdc = slider118; sx_spdm = slider119; sx_spmx = slider120; sx_spfz = slider121 >= 0.5;
);

function sx_spclr() ( memset(DSPM, 0, BV_END - DSPM); pre_w = 0; sx_spq = 0; );

function sx_sp_block() local(k, sz, ms) (
  sx_fst = 1 / (0.01 * srate);
  sx_spqmax = floor(2 * srate);
  sx_spon && sx_spg == 0 && !sx_splive ? sx_spclr();
  sx_spon || sx_spg > 0 ? (
    sz = 0.3 + 0.7 * sx_spsz;
    k = 0;
    loop(8,
      ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
      ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
      k += 1;
    );
    bv_t60 = sx_spfz ? 100000 : sx_spdc;
    bv_rtlo = sx_spfz ? 1 : 1.25; bv_rthi = sx_spfz ? 1 : 1 - 0.82 * sx_spdm;
    k = 0; loop(8, bv_loss(k, ln_len[k]); k += 1; );
    bv_xover();
    sx_sppre = (0.008 + 0.03 * sx_spsz) * srate;
    k = 0;
    loop(8,
      DRVM[k] += samplesblock / srate * (0.07 + 0.013 * k); DRVM[k] -= floor(DRVM[k]);
      ln_mod[k] = (6 + 5 * sin(2 * $pi * DRVM[k])) * srate / 48000;
      k += 1;
    );
  );
);

DSN = 3994000; DEP = 3994200; DWTS = 3994300; DMPX = 3994400;
DMPX[0] = 106; DMPX[1] = 108; DMPX[2] = 109; DMPX[3] = 111; DMPX[4] = 113; DMPX[5] = 114; DMPX[6] = 12; DMPX[7] = 4;
DMPX[8] = 11; DMPX[9] = 18; DMPX[10] = 19; DMPX[11] = 22; DMPX[12] = 10; DMPX[13] = 51; DMPX[14] = 3; DMPX[15] = 52;
sx_j = 0; loop(16, DEP[sx_j] = 0; sx_j += 1; ); memset(DWTS, 0, 8);
sx_pc = 0; sx_pxs = sx_pys = -1;

function sx_mlo(j) ( AVL[DMPX[j]]; );
function sx_mhi(j) ( AVH[DMPX[j]]; );
function sx_cset(c, j, v) ( DSN[(c - 1) * 16 + j] = max(sx_mlo(j), min(sx_mhi(j), v)); );
function sx_fill() local(c, j) ( c = 0; loop(8, j = 0; loop(16, DSN[c * 16 + j] = slider(DMPX[j]); j += 1; ); c += 1; ); );
function sx_vary() local(b) (
  b = DSN;
  sx_cset(2, 9, b[9] * 1.6); sx_cset(2, 10, b[10] + 10);
  sx_cset(3, 9, b[9] * 2.5); sx_cset(3, 10, b[10] + 15); sx_cset(3, 13, b[13] * 1.5 + 3);
  sx_cset(4, 9, b[9] * 4); sx_cset(4, 6, b[6] - 25); sx_cset(4, 7, b[7] + 15); sx_cset(4, 15, 100);
  sx_cset(5, 9, b[9] * 0.6); sx_cset(5, 12, b[12] + 20); sx_cset(5, 10, b[10] + 20);
  sx_cset(6, 9, b[9] * 0.8); sx_cset(6, 0, b[0] + 2); sx_cset(6, 3, b[3] + 2); sx_cset(6, 1, b[1] * 1.3); sx_cset(6, 8, b[8] + 30);
  sx_cset(7, 9, b[9] * 1.3); sx_cset(7, 0, b[0] + 4); sx_cset(7, 3, b[3] + 4); sx_cset(7, 1, b[1] * 0.7); sx_cset(7, 2, b[2] * 0.5); sx_cset(7, 6, b[6] - 15);
  sx_cset(8, 9, b[9] * 2); sx_cset(8, 7, b[7] + 25); sx_cset(8, 0, b[0] + 7); sx_cset(8, 3, b[3] + 7); sx_cset(8, 8, b[8] + 60); sx_cset(8, 10, b[10] + 25);
);

function sx_pad_apply() (
  DSRC[XQ_FRM] = DEP[0]; DSRC[XQ_TLT] = DEP[1]; DSRC[XQ_EVN] = DEP[2];
  DSRC[32 + XQ_FRM] = DEP[3]; DSRC[32 + XQ_TLT] = DEP[4]; DSRC[32 + XQ_EVN] = DEP[5];
  dh_pw = DEP[6] / 100; dh_fm = sqr(DEP[7] / 100) * 1.5;
  dh_mixr = DEP[8] / 100; dh_ring = DEP[12] / 100;
  dh_m1 = (1 - dh_mixr) * (1 - dh_ring); dh_m2 = dh_mixr * (1 - dh_ring);
  dh_cut = DEP[9]; fl_lc = log(dh_cut);
  dh_res = DEP[10] / 100; dh_fenv = DEP[11] / 100;
  dh_udet = DEP[13] / 100; dh_sub = DEP[14] / 100 * 0.8; dh_uspr = DEP[15] / 100;
);

function sx_pad_cfg() (
  sx_padon = slider122 >= 0.5; sx_px = slider123; sx_py = slider124; sx_snap = slider125;
  sx_psc = 1 - exp(-16 / max(1, slider126 * 0.001 * srate));
  sx_mrate = slider127; sx_mdep = slider128; sx_mshp = slider129;
  sx_cd = 1;
);

function sx_pad_tick() local(c, j, w, ws, dx, dy, d2, pw, v, mx, my) (
  pad_dirty ? ( pad_dirty = 0; sx_cd = 1; );
  sx_padon ? (
    sx_mph += sx_mrate * 16 / srate; sx_mph -= floor(sx_mph);
    sx_mshp < 0.5 ? ( dx = cos(2 * $pi * sx_mph); dy = sin(2 * $pi * sx_mph); ) :
    sx_mshp < 1.5 ? ( dx = sin(2 * $pi * sx_mph); dy = sin(4 * $pi * sx_mph); ) :
    sx_mshp < 2.5 ? ( sx_mph2 += 1.5 * sx_mrate * 16 / srate; sx_mph2 -= floor(sx_mph2); dx = sin(2 * $pi * sx_mph); dy = sin(2 * $pi * sx_mph2); ) :
                    ( dx = sx_pmx.drift_tick(sx_mrate * 16 / srate); dy = sx_pmy.drift_tick(sx_mrate * 0.83 * 16 / srate); );
    pw = sx_hold_d ? 0 : sx_mdep * 0.5;
    mx = sx_px + dx * pw; mx < 0 ? mx = -mx; mx > 1 ? mx = 2 - mx;
    my = sx_py + dy * pw; my < 0 ? my = -my; my > 1 ? my = 2 - my;
    sx_pxs < 0 ? ( sx_pxs = mx; sx_pys = my; );
    sx_pxs += (mx - sx_pxs) * sx_psc; sx_pys += (my - sx_pys) * sx_psc;
    sx_cd || abs(sx_pxs - sx_plx) > 0.0000001 || abs(sx_pys - sx_ply) > 0.0000001 ? (
      sx_cd = 0; sx_plx = sx_pxs; sx_ply = sx_pys;
      pw = 1 + sx_snap * 7; ws = 0; c = 0;
      loop(8,
        dx = (sx_pxs - ((c % 4) + 0.5) / 4) * 1.667; dy = sx_pys - (floor(c / 4) + 0.5) / 2;
        d2 = dx * dx + dy * dy;
        w = d2 < 0.0000001 ? 10000000000 : d2 ^ (-0.5 * pw);
        DWTS[c] = w; ws += w; c += 1;
      );
      j = 0;
      loop(16,
        v = 0; c = 0;
        j == 9 ? ( loop(8, v += DWTS[c] * log(max(20, DSN[c * 16 + j])); c += 1; ); DEP[j] = exp(v / ws); )
               : ( loop(8, v += DWTS[c] * DSN[c * 16 + j]; c += 1; ); DEP[j] = v / ws; );
        j += 1;
      );
      c = 0; loop(8, DWTS[c] /= ws; c += 1; );
      sx_pad_apply();
    );
  ) : ( sx_pxs = -1; );
);
sx_pmx.a = sx_pmx.v = 0.3; sx_pmx.b = -0.6; sx_pmx.ph = 0; sx_pmx.rm = 1;
sx_pmy.a = sx_pmy.v = -0.4; sx_pmy.b = 0.5; sx_pmy.ph = 0.5; sx_pmy.rm = 1;

function load_preset(p) local(n, i, l, k) (
  dh_panic = 1;
  i = 0; loop(75, slider(i + 1) = DEFM[i]; i += 1; );
  i = 84; loop(20, slider(i + 1) = DEFM[i]; i += 1; );
  i = 0; loop(25, slider(105 + i) = DEFM[120 + i]; i += 1; );
  n = dh_nums(dh_pstr(p), DTMP);
  i = 0; loop(floor(n / 2), DTMP[i * 2] >= 1 && (DTMP[i * 2] <= 75 || (DTMP[i * 2] >= 85 && DTMP[i * 2] <= 129)) ? slider(DTMP[i * 2]) = DTMP[i * 2 + 1]; i += 1; );
  dh_stepdef(0); dh_stepdef(1); dh_stepdef(2);
  n = dh_nums(dh_psteps(p), DTMP);
  i = 0; loop(floor(n / 17), l = DTMP[i * 17] - 1;
    l >= 0 && l < 3 ? ( k = 0; loop(16, DSTEP[l * 16 + k] = min(max(DTMP[i * 17 + 1 + k] / 100, -1), 1); k += 1; ); ); i += 1; );
  slider64 < 0.5 ? slider66 = 0; slider64 = 1;
  i = 1; loop(75, ui_auto(i); i += 1; );
  i = 85; loop(45, ui_auto(i); i += 1; );
  sx_fill(); sx_vary(); n = dh_nums(sx_pcell(p), DTMP); n >= 3 ? ( sx_fill(); i = 0; loop(floor(n / 3), DSN[(DTMP[i * 3] - 1) * 16 + DTMP[i * 3 + 1]] = DTMP[i * 3 + 2]; i += 1; ); ); sx_snok = 1; pad_dirty = 1;
  pr_cur = p; dh_panic = 1;
);

function dh_lfov(l, sh, ph, hv, pv) (
  sh == 0 ? sin(2 * $pi * ph) : sh == 1 ? 1 - 4 * abs(ph - 0.5) : sh == 2 ? 2 * ph - 1 : sh == 3 ? (ph < 0.5 ? 1 : -1) :
  sh == 4 ? hv : sh == 5 ? 1 - 2 * ph : sh == 6 ? pv + (hv - pv) * (0.5 - 0.5 * cos($pi * ph)) :
  DSTEP[l * 16 + min(floor(ph * 16), 15)];
);
function dh_fadec(x) ( x * x * (3 - 2 * x); );

function dh_lfo_to(v, d, a) (
  d == 0 ? dh_pmod += v * 12 * a * abs(a) :
  d == 1 ? dh_l2p += v * 24 * a * abs(a) :
  d == 2 ? dh_loct += v * 4 * a :
  d == 3 ? dh_trem *= 1 - abs(a) * (0.5 - 0.5 * v * sign(a)) :
  d == 4 ? dh_lpan += v * a :
  d == 5 ? dh_lfm += v * a * 0.75 :
  d == 6 ? dh_lpw += v * a * 0.45 :
  d == 7 ? dh_lres += v * a * 0.5 :
  d == 8 ? dh_lmix += v * a * 0.5 :
  d == 9 ? dh_lring += v * a * 0.5 :
  d == 10 ? dh_lsub += v * a * 0.8 :
  d == 11 ? dh_ludet += v * a :
  d == 12 ? dh_lcho += v * a * 0.5 :
  d == 13 ? dh_ldly += v * a * 0.5 :
  d < 17 ? DLG[(d - 14) * 12 + 8] *= 2 ^ (v * a * 2) :
  d < 20 ? DLG[(d - 17) * 12 + 9] *= 1 - abs(a) * (0.5 - 0.5 * v * sign(a)) :
  d == 20 ? dh_lt1 += v * a * 3.5 : dh_lt2 += v * a * 3.5;
);

function dh_lfo_tick() local(l, b, g, ph) (
  l = 0;
  loop(3,
    b = DLF + l * 16; g = DLG + l * 12;
    ph = g[0] + b[11] * (b[2] == 1 ? 1 : g[5] * g[7]);
    ph >= 1 ? ( ph -= floor(ph); g[2] = g[1]; g[1] = rand(2) - 1; );
    g[0] = ph;
    b[14] || g[10] != 0 || g[11] != 0 ? (
      g[3] += (dh_lfov(l, b[0], ph, g[1], g[2]) - g[3]) * b[12];
      g[4] = min(g[4] + b[10], 1);
    );
    l += 1;
  );
);

function dh_lfo_all() local(l, b, g, v) (
  DLG[8] = DLG[9] = DLG[20] = DLG[21] = DLG[32] = DLG[33] = 1;
  dh_anyv = 0;
  l = 0;
  loop(3,
    b = DLF + l * 16; g = DLG + l * 12;
    b[13] = b[4]; l == 0 && dh_mwd == 2 ? b[13] += dh_mw * ((b[4] < 0 ? -1 : 1) - b[4]);
    b[9] != b[15] ? ( g[10] = g[11] = 0; b[15] = b[9]; );
    g[10] += (b[13] - g[10]) * dh_dk; abs(g[10]) < 0.00001 && b[13] == 0 ? g[10] = 0;
    g[11] += (b[7] - g[11]) * dh_dk; abs(g[11]) < 0.00001 && b[7] == 0 ? g[11] = 0;
    b[9] && (g[10] != 0 || g[11] != 0) ? dh_anyv = 1;
    g[10] != 0 || g[11] != 0 ? (
      v = g[3] * dh_fadec(g[4]) * g[6];
      b[9] ? (
        b[5] >= 12 && g[10] != 0 ? dh_lfo_to(v, b[5], g[10]); b[8] >= 12 && g[11] != 0 ? dh_lfo_to(v, b[8], g[11]);
      ) : (
        g[10] != 0 ? dh_lfo_to(v, b[5], g[10]); g[11] != 0 ? dh_lfo_to(v, b[8], g[11]);
      );
    );
    l += 1;
  );
  DLG[5] = DLG[8]; DLG[6] = DLG[9]; DLG[17] = DLG[20]; DLG[18] = DLG[21]; DLG[29] = DLG[32]; DLG[30] = DLG[33];
);

function dh_vlfo(p) local(l, b, q, ph, v) (
  l = 0;
  loop(3,
    b = DLF + l * 16;
    b[9] && (DLG[l * 12 + 10] != 0 || DLG[l * 12 + 11] != 0) ? (
      q = p + 44 + l * 5;
      ph = q[0] + b[11] * (b[2] == 1 ? 1 : DLG[l * 12 + 5] * p[59 + l]);
      ph >= 1 ? ( ph -= floor(ph); q[2] = q[1]; q[1] = rand(2) - 1; );
      q[0] = ph;
      q[3] += (dh_lfov(l, b[0], ph, q[1], q[2]) - q[3]) * b[12];
      q[4] = min(q[4] + b[10], 1);
      v = q[3] * dh_fadec(q[4]) * DLG[l * 12 + 6];
      b[5] < 12 ? dh_lfo_to(v, b[5], DLG[l * 12 + 10]);
      b[8] < 12 ? dh_lfo_to(v, b[8], DLG[l * 12 + 11]);
    );
    l += 1;
  );
);

function dh_vlfo_start(p) local(l, b, q) (
  l = 0;
  loop(3,
    b = DLF + l * 16; q = p + 44 + l * 5;
    q[0] = b[6] ? rand(1) * 0.02 * dh_drift : b[2] == 1 ? DLG[l * 12] : rand(1);
    q[1] = rand(2) - 1; q[2] = rand(2) - 1;
    q[3] = dh_lfov(l, b[0], q[0], q[1], q[2]);
    q[4] = b[10] >= 1 ? 1 : 0;
    p[59 + l] = b[2] == 1 ? 1 : 1 + (rand(2) - 1) * 0.06 * dh_drift;
    l += 1;
  );
);

function dh_vrel(p) ( p[1] = 0; p[3] = 0; p[13] > 0 ? p[13] = 3; p[15] > 0 ? p[15] = 3; );
function dh_vstart(p, n, v, retrig, udet, upan, from) (
  p[13] == 0 ? (

    p[10] = dh_w1 == 0 ? 0 : dh_w1 == 1 ? 0.25 : rand(1);
    p[11] = dh_w2 == 0 ? 0 : dh_w2 == 1 ? 0.25 : rand(1);
    p[12] = dh_subw ? rand(1) : 0; p[23] = 0; p[33] = 0; p[62] = 0;
    p[19] = p[20] = p[21] = p[22] = 0; p[14] = 0; p[16] = 0; p[18] = 0;
    p[4] = from;
    dh_wu ? nw_start(DNW + (p - DV) / 64 * 8);
  );
  dh_pc >= 1 ? p[4] = n;
  p[0] = n; p[1] = 1; p[3] = 0; p[5] = n; p[6] = v / 127;
  p[8] = udet; p[9] = upan;
  retrig || p[13] == 0 || p[13] == 3 ? (
    p[7] = log(ins_note_detune()) / log(2) * 12;
    p[13] = 1; p[15] = 1; p[17] = 1;
    dh_anyv ? dh_vlfo_start(p);
  );
  p[34] = dh_gain * (1 - dh_avel + dh_avel * p[6]) * dh_uscl;
  p[38] = 1;
);
function dh_alloc() local(i, p, best, ba) (
  best = -1;
  i = 0; loop(dh_nv, p = DV + i * 64; p[13] == 0 && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; );
  best < 0 ? ( i = 0; loop(dh_nv, p = DV + i * 64; !p[1] && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; ); );
  best < 0 ? ( i = 0; loop(dh_nv, p = DV + i * 64; best < 0 || p[2] < ba ? ( best = i; ba = p[2]; ); i += 1; ); );
  DV + best * 64;
);
function dh_upos(k) ( dh_un > 1 ? k / (dh_un - 1) * 2 - 1 : 0; );
function dh_poly_on(n, v) local(i, p, k, from) (
  i = 0; loop(16, p = DV + i * 64; p[0] == n && p[1] ? dh_vrel(p); i += 1; );
  from = dh_last >= 0 && dh_porta > 0 ? dh_last : n;
  k = 0;
  loop(dh_un,
    p = dh_alloc();
    dh_age += 1; p[2] = dh_age;
    dh_vstart(p, n, v, 1, dh_upos(k) * dh_udet, dh_upos(k) * dh_uspr, from);
    k += 1;
  );
);
function dh_poly_off(n) local(i, p) (
  i = 0; loop(16, p = DV + i * 64; p[0] == n && p[1] ? ( dh_pedal ? p[3] = 1 : dh_vrel(p); ); i += 1; );
);
function dh_mono_go(n, v, retrig) local(k, p) (
  k = 0;
  loop(dh_un,
    p = DV + k * 64;
    dh_age += 1; p[2] = dh_age;
    dh_vstart(p, n, v, retrig, dh_upos(k) * dh_udet, dh_upos(k) * dh_uspr, p[13] > 0 ? p[4] : (dh_last >= 0 && dh_porta > 0 ? dh_last : n));
    k += 1;
  );
);
function dh_mono_on(n, v) local(i, f, held) (
  held = dh_hc > 0;
  f = -1; i = 0; loop(dh_hc, DHN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(dh_hc - f - 1, DHN[i] = DHN[i + 1]; i += 1; ); dh_hc -= 1; );
  dh_hc < 127 ? ( DHN[dh_hc] = n; dh_hc += 1; );
  dh_mono_go(n, v, !(held && dh_mode == 2));
);
function dh_mono_off(n) local(i, f, k, p) (
  f = -1; i = 0; loop(dh_hc, DHN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(dh_hc - f - 1, DHN[i] = DHN[i + 1]; i += 1; ); dh_hc -= 1;
    dh_hc > 0 ? (

      k = 0; loop(dh_un, p = DV + k * 64; p[0] = DHN[dh_hc - 1]; p[5] = p[0]; dh_pc >= 1 ? p[4] = p[0]; k += 1; );
    ) : (
      k = 0; loop(dh_un, p = DV + k * 64; dh_pedal ? p[3] = 1 : dh_vrel(p); k += 1; );
    );
  );
);
function dh_note_on(n, v) local(i, held) (
  ins_midi_hit();
  held = 0; i = 0; loop(16, DV[i * 64 + 1] ? held = 1; i += 1; );
  i = 0;
  loop(3,
    (dh_mode == 0 || dh_hc == 0 || dh_mode == 1) && DLF[i * 16 + 6] ? DLG[i * 12] = 0;
    !held && DLF[i * 16 + 10] < 1 ? DLG[i * 12 + 4] = 0;
    i += 1;
  );
  dh_mode ? dh_mono_on(n, v) : dh_poly_on(n, v);
  dh_last = n;
);
function dh_note_off(n) ( dh_mode ? dh_mono_off(n) : dh_poly_off(n); );
function dh_all_off() local(i, p) (
  i = 0; loop(16, p = DV + i * 64; p[1] ? dh_vrel(p); p[0] = -1; i += 1; );
  dh_hc = 0;
);
function dh_pedal_up() local(i, p) ( i = 0; loop(16, p = DV + i * 64; p[3] ? dh_vrel(p); i += 1; ); );
function dh_qpush(ofs, t, n, v) local(i) (
  dh_qc < 300 ? (
    i = dh_qc; while (i > 0 && DQO[i - 1] > ofs) ( DQO[i] = DQO[i - 1]; DQT[i] = DQT[i - 1]; DQN[i] = DQN[i - 1]; DQV[i] = DQV[i - 1]; i -= 1; );
    DQO[i] = ofs; DQT[i] = t; DQN[i] = n; DQV[i] = v; dh_qc += 1;
  );
);

function dh_lfo_beats(r) ( r == 0 ? 16 : r == 1 ? 8 : r == 2 ? 4 : r == 3 ? 2 : r == 4 ? 4 / 3 : r == 5 ? 1 : r == 6 ? 2 / 3 :
                          r == 7 ? 0.5 : r == 8 ? 1 / 3 : r == 9 ? 0.25 : r == 10 ? 1 / 6 : 0.125; );
function dh_arp_beats(r) ( r == 0 ? 1 : r == 1 ? 2 / 3 : r == 2 ? 0.5 : r == 3 ? 1 / 3 : r == 4 ? 0.25 : r == 5 ? 1 / 6 : 0.125; );
function dh_dly_beats(r) ( r == 0 ? 2 : r == 1 ? 1.5 : r == 2 ? 1 : r == 3 ? 2 / 3 : r == 4 ? 0.75 : r == 5 ? 0.5 : r == 6 ? 1 / 3 : 0.25; );

function dh_lfo_set(l, a, c) local(b, r) (
  b = DLF + l * 16;
  b[0] = floor(slider(a) + 0.5); b[2] = floor(slider(a + 2) + 0.5);
  b[3] = dh_lfo_beats(floor(slider(a + 3) + 0.5)) * (b[0] == 7 ? 16 : 1);
  r = b[2] ? dh_tmp / 60 / b[3] : slider(a + 1) / (b[0] == 7 ? 16 : 1);
  b[1] = r; b[11] = r * 4 / srate;
  b[4] = slider(a + 4) / 100; b[5] = floor(slider(a + 5) + 0.5); b[6] = slider(a + 6) >= 0.5;
  b[7] = slider(c) / 100; b[8] = floor(slider(c + 1) + 0.5); b[9] = slider(c + 2) >= 0.5;
  b[10] = slider(c + 3) > 0 ? 4 / (slider(c + 3) * 0.001 * srate) : 1;
  b[12] = 1 - exp(-4 / (0.002 * srate));
  dh_dk = 1 - exp(-4 / (0.03 * srate));
  b[14] = b[4] != 0 || b[7] != 0 || (l == 0 && dh_mwd == 2);
  b[9] && b[14] ? dh_anyv = 1;
);

function dh_c4(c) ( 1 - (1 - c) ^ 4; );
function update() local(r, g) (
  dh_w1 = slider1; dh_subw = slider2; dh_sub = slider3 / 100 * 0.8;
  dh_fm = sqr(slider4 / 100) * 1.5;
  dh_w2 = slider5; dh_o2st = slider6 + slider7 / 100; dh_trk = slider8; dh_sync = slider9;
  dh_ring = slider10 / 100; r = slider11 / 100; dh_mixr = r;
  dh_m1 = (1 - r) * (1 - dh_ring); dh_m2 = r * (1 - dh_ring);
  dh_pw = slider12 / 100;
  dh_ma4 = dh_c4(vo_coef(slider13)); dh_md4 = dh_c4(vo_coef(slider14)); dh_mamt = slider15 / 100; dh_mdst = slider16;
  dh_ftt = floor(slider17 + 0.5); dh_cut = slider18; dh_res = slider19 / 100;
  fl_lc = log(dh_cut);
  dh_k = 2 - 1.985 * fl_rs;
  dh_lk = fl_rs * 4.15;
  dh_sat = slider20 / 100; dh_sg = 1 + dh_sat * 5; dh_sn = 1 / (1 + dh_sat * 1.6);
  dh_key = slider21 / 100; dh_fenv = slider22 / 100; dh_fvel = slider23 / 100;
  dh_fa4 = dh_c4(vo_coef(slider24)); dh_fd4 = dh_c4(vo_coef(slider25)); dh_fs = slider26 / 100; dh_fr4 = dh_c4(vo_coef(slider27));
  dh_aa = vo_coef(slider28); dh_ad = vo_coef(slider29); dh_as = slider30 / 100; dh_ar = vo_coef(slider31);
  dh_gain = 10 ^ (slider32 / 20) * 0.9; dh_avel = slider33 / 100;
  dh_tmp = tempo > 0 ? tempo : 120;
  dh_mode = slider48; dh_nv = max(1, min(16, floor(slider49 + 0.5)));
  dh_un = min(max(1, floor(slider50 + 0.5)), dh_nv); dh_uscl = 1 / sqrt(dh_un);
  dh_udet = slider51 / 100; dh_uspr = slider52 / 100;
  dh_porta = slider53; dh_pc = slider53 > 0 ? dh_c4(vo_coef(slider53)) : 1;
  dh_brng = slider54; dh_mwd = slider55;
  dh_anyv = 0; dh_lfo_set(0, 34, 85); dh_lfo_set(1, 41, 89); dh_lfo_set(2, 93, 100);
  dh_dtyp = slider62; dh_dat = max(slider63 - 50, 0) / 50;
  dh_dwt = min(dh_dat * 10, 1);

  dh_phst = slider64 >= 0.5 && slider66 > 0; dh_phr = slider65; dh_phd = slider66 / 100;
  dh_cho = slider67; dh_chf = slider68; dh_chr = slider69; dh_chd = slider70 / 100;
  dh_dly = slider71; dh_dlb = dh_dly_beats(slider72); dh_dfb = slider73 / 100; dh_dmx = slider74 / 100; dh_dpp = slider75;
  dh_dlt = min(dh_dlb * 60 / dh_tmp * srate, DDLM - 4);
  dh_drift = slider76 / 100; dh_volt = 10 ^ ((slider77 + slider104) / 20); dh_chan = slider78;
  dh_fmax = srate * 0.45; dh_pis = $pi / srate; dh_440s = 440 / srate;
  ins_output_setup(79);
  sx_update(); sx_pad_cfg(); sx_padon ? sx_pad_apply();
);

function dh_daa(z) instance(z1, ad1, cv1, rd) local(q, ad, cv, d, y) (
  q = z * z;
  q < 9 ? ( ad = q * 0.05555555555555556 + 1.3333333333333333 * log(1 + q * 0.3333333333333333); cv = z * (27 + q) / (27 + 9 * q); )
        : ( ad = abs(z) - 0.6516075; cv = sign(z); );
  rd ? ( z1 = z; ad1 = ad; cv1 = cv; rd = 0; );
  d = z - z1;
  y = abs(d) > 0.00001 ? (ad - ad1) / d : vo_tanh(0.5 * (z + z1));
  y += 0.5 * (cv - cv1);
  z1 = z; ad1 = ad; cv1 = cv;
  y;
);
dh_dzl.rd = dh_dzr.rd = 1;
dh_pfl.clp_pf_cfg(40000, 6000, -1.5, 150); dh_pfr.clp_pf_cfg(40000, 6000, -1.5, 150);
dh_pfl.clp_pf_reset(); dh_pfr.clp_pf_reset();

ins_drift_init();
fl_ok = 0;
dh_bend = 0; dh_mw = 0; dh_pedal = 0; dh_hc = 0; dh_age = 0; dh_last = -1; dh_qc = 0;
dh_wasarp = 0; dh_lastmode = -1; dh_ct = 0;
dh_i = 0; loop(3, dh_zg = DLG + dh_i * 12; memset(dh_zg, 0, 12); dh_zg[1] = rand(2) - 1; dh_zg[2] = rand(2) - 1;
                  dh_zg[4] = dh_zg[5] = dh_zg[6] = dh_zg[7] = 1; dh_i += 1; );
dh_lw0.drift_init(0.8 + rand(1) * 0.5); dh_lw1.drift_init(0.8 + rand(1) * 0.5); dh_lw2.drift_init(0.8 + rand(1) * 0.5);
dh_dfirst = 1; dh_damg = max(slider63 - 50, 0) / 50; dh_gtrem = 1; dh_chdm = slider70 / 100; dh_chg = dh_chdm; dh_csn = 1; dh_dmxm = slider74 / 100;

dh_grg = slider10 / 100; dh_gm1 = (1 - slider11 / 100) * (1 - dh_grg); dh_gm2 = slider11 / 100 * (1 - dh_grg);
dh_gsub = slider3 / 100 * 0.8; dh_gk = 2 - 1.985 * slider19 / 100; dh_glk = slider19 / 100 * 4.15;
dh_dcxl = dh_dcyl = dh_dcxr = dh_dcyr = 0; dh_vol = 1; dh_wp = 0; dh_cwp = 0; dh_dts = -1;
dh_wasdly = 0; dh_wascho = 0; dh_phph = 0; dh_chph = 0; dh_vph = 0; dh_hold = 0; dh_holdr = 0; dh_hcnt = 0;

function dh_srinit() ( dh_sr = srate; dh_sm = 1 - exp(-1 / (0.03 * srate)); ost_init(20000); dh_dts = -1; );
dh_srinit();
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
update(); dh_ft = dh_ftt; dh_fdk = 1; dh_phw = dh_phst;
dh_lastmode = dh_mode; dh_wasarp = slider56;
dh_pcf = 0; dh_pck = dh_pcg = 1;

DPCP = 43300; dh_pcn = 0;
function dh_pchold(n, v) ( dh_pcn < 32 ? ( DPCP[dh_pcn * 2] = n; DPCP[dh_pcn * 2 + 1] = v; dh_pcn += 1; ); );
function dh_pcunhold(n) local(i, j) (
  i = j = 0; loop(dh_pcn, DPCP[i * 2] != n ? ( DPCP[j * 2] = DPCP[i * 2]; DPCP[j * 2 + 1] = DPCP[i * 2 + 1]; j += 1; ); i += 1; ); dh_pcn = j;
);
function dh_pcapply() local(i, p) (
  i = 0; loop(16, p = DV + i * 64; p[13] == 3 ? ( p[13] = 0; p[15] = 0; p[14] = 0; p[17] = 0; p[0] = -1; p[19] = p[20] = p[21] = p[22] = 0; ); i += 1; );
  update(); dh_lastmode = dh_mode; dh_pcf = 0; dh_ft = dh_ftt; dh_fdk = 1;
  i = 0; loop(dh_pcn, dh_note_on(DPCP[i * 2], DPCP[i * 2 + 1]); i += 1; ); dh_pcn = 0;
  dh_dly && !dh_wasdly ? ( memset(DDLL, 0, 524288 * 2); dh_dts = -1; ); dh_wasdly = dh_dly;
  dh_cho && !dh_wascho ? ( memset(DCHL, 0, 8192 * 2); dh_csn = 1; ); dh_wascho = dh_cho;
  dh_dts = dh_dlt;
);
dh_vol = dh_volt;
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(129, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 57 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(57, prs_sel | 0));
