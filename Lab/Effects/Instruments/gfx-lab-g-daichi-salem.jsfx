#av_pm = "Init|Fat Saw Bass|Acid Line|FM Bass|Sub Bass|Sync Lead|Square Lead|Unison Lead|Soft Lead|PWM Strings|Warm Pad|Sweep Pad|Glass Pad|FM E-Piano|Bell Tines|Clav Pluck|Organ|Poly Brass|Brass Stab|Arp Pulse|Arp Glass|Chip Square|Chip Arp|Noise Sweep|Wind Riser|Laser Zap|Reso Pluck|Hoover|Bit Bass|Phase Keys|Fifth Lead|Dark Drone|Shimmer Pad|Late Vibrato|Step Bass|Gate Pad|Drunk Strings|Tremolo Keys|Random Ripple|Wobble Bass|Supersaw Lead|Velvet Pad|Pluck|Square Bass|Pulse Strings|Soft Brass|Band Sweep|Thin Pulse|Glide Lead|Additive Organ|Glass Bell|Formant Choir|Sync Sweep Lead|Fold Bass|Morph Pad|Vowel Lead|Bell Organ";
ui_begin(900, 355);
v5_begin();
sc != av_fsc ? (
  av_fsc = sc;
  av_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
