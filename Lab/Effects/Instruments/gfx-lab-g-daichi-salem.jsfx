);

sx_spg += sx_spon ? (sx_spg < 1 ? sx_fst : 0) : (sx_spg > 0 ? -sx_fst : 0); sx_spg = max(0, min(1, sx_spg));
sx_splive = sx_spg > 0;
sx_splive ? (
  abs(dh_L) + abs(dh_R) > 0.000000000001 || sx_spg < 1 || sx_spfz ? sx_spq = 0;
  sx_spq < sx_spqmax ? (
    sx_u = sx_spfz ? 0 : 1;
