  ui_col(AVTD > 0 ? ui_mix(c, 0, AVTD) : ui_mix(c, 0, 0.3)); gfx_x = 2; gfx_y = 1; gfx_drawstr(s);
  gfx_dest = av_bk ? 119 : -1; gfx_mode = 2;
  i = 0; loop(n,
    gfx_a = 1;
    gfx_blit(60, 1, 0, 0, i, ceil(tw) + 4, 1, x0 - 2, y0 - 1 + i, ceil(tw) + 4, 1);
    i += 1;
  );
  gfx_mode = 0; gfx_a = 1;
);
function av_lab(x, cy, s) ( av_ft(14); ui_col(ui_mix(AVI, AVIN, 0.25)); av_tl(x, cy, s); );
function av_labc(cx, cy, s) ( av_ft(14); ui_col(ui_mix(AVI, AVIN, 0.25)); v5_t(cx, cy, s); );
function av_ms(v) ( v < 10 ? sprintf(#av_hv, "%.1f ms", v) : v < 1000 ? sprintf(#av_hv, "%d ms", v + 0.5) : sprintf(#av_hv, "%.2f s", v / 1000); );
function av_fmt(idx) local(v, m, f) (
  v = av_fvs ? av_fv : slider(idx); av_fvs = 0; m = floor(v + 0.5); f = AVF[idx];
  f == 1 ? av_ms(v) :
  f == 14 ? ( v >= AVH[idx] - 0.5 ? strcpy(#av_hv, "HOLD") : av_ms(v); ) :
  f == 2 ? ( v >= 1000 ? sprintf(#av_hv, "%.2f kHz", v / 1000) : v < 1 ? sprintf(#av_hv, "%.2f Hz", v) : v < 20 ? sprintf(#av_hv, "%.1f Hz", v) : sprintf(#av_hv, "%d Hz", m); ) :
  f == 3 ? sprintf(#av_hv, "%+d st", m) :
  f == 12 ? sprintf(#av_hv, "%+.2f st", v) :
  f == 4 ? sprintf(#av_hv, "%+.1f c", v) :
  f == 5 ? sprintf(#av_hv, "%+.1f dB", v) :
  f == 6 ? sprintf(#av_hv, "%.2f s", v) :
  f == 7 ? sprintf(#av_hv, "%.2f", v) :
  f == 8 ? sprintf(#av_hv, "%d", m) :
  f == 10 ? sprintf(#av_hv, "%+d", m) :
  f == 11 ? sprintf(#av_hv, "%d DEG", m) :
  f == 13 ? sprintf(#av_hv, "%+.2f", v) :
  f == 15 ? sprintf(#av_hv, "%+d %%", m) :
  f == 16 ? sprintf(#av_hv, "%+d %%", m - 100) :
  f == 9 ? strcpy(#av_hv, v5_part(av_enl, m)) :
  sprintf(#av_hv, "%d %%", m);
);
function av_dial(cx, cy, r, idx, lbl, fs) local(n, a, i, t, rs, dm) (
  dm = av_dim; av_dim = 0;
  AVS[idx] > 0 ? v5_step = AVS[idx];
  n = v5_ctl(idx, AVL[idx], AVH[idx], AVD[idx], AVG[idx], v5_hitc(cx, cy, r + 8) && !av_lock, 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(AVDOT); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  v5_shc(cx, cy, r);
  ui_col(0x16141A); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x34303A); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(ui_mix(av_cc, 0, 0.35)); v5_d(cx, cy, r * 0.74);
  ui_col(dm ? ui_mix(av_cc, AVIN, 0.55) : av_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, ((av_cc >> 16) & 255) * 0.3 + ((av_cc >> 8) & 255) * 0.59 + (av_cc & 255) * 0.11 < 100 ? 0xEDE3CC : 0x2A2430);
  v5_act && !av_lock ? ( av_fmt(idx); av_hover(cx, cy + r + 19, fs); ) : ( av_ft(fs); ui_col(dm ? ui_mix(AVI, AVIN, 0.55) : AVI); v5_t(cx, cy + r + 19, lbl); );
  av_lock = 0;
);
function sx_mj(idx) local(j, r) ( r = -1; j = 0; loop(16, DMPX[j] == idx ? r = j; j += 1; ); r; );
function sx_shift(j, nw, ov) local(c, q) (
  c = 0;
  loop(8,
    q = (DSN + c * 16)[j];
    q = j == 9 ? q * nw / max(ov, 1) : q + nw - ov;
    (DSN + c * 16)[j] = max(AVL[DMPX[j]], min(AVH[DMPX[j]], q));
    c += 1;
  );
);
function sx_touch(idx) local(j) (
  ui_auto(idx);
  ed_cell > 0 ? ( j = sx_mj(idx); j >= 0 ? DSN[(ed_cell - 1) * 16 + j] = slider(idx); );
  pad_dirty = 1;
);
function sx_store(c) local(j) ( j = 0; loop(16, DSN[c * 16 + j] = slider(DMPX[j]); j += 1; ); pad_dirty = 1; );
function sx_recall(c) local(j) (
  j = 0;
  loop(16, slider(DMPX[j]) = DSN[c * 16 + j]; ui_auto(DMPX[j]); j += 1; );
  slider123 = ((c % 4) + 0.5) / 4; slider124 = (floor(c / 4) + 0.5) / 2; ui_auto(123); ui_auto(124);
  ed_cell = c + 1; pad_dirty = 1;
);
function sa_ctl(idx, v, vmin, vmax, vdef, lg, hit) local(n, d, now, m, nw) (
  n = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  m = -mouse_y; sa_ch = 0; nw = v;
  v5_pr && hit && v5_drag == 0 ? (
    now = time_precise();
    (now - sa_lct < 0.35 && sa_lci == idx) || v5_ctrl ? (
      nw = vdef; sa_ch = 1; v5_drag = -1; sa_lct = 0;
    ) : (
      v5_drag = idx; sa_my = m; sa_mz = m; sa_dz = 0; sa_n = n; sa_lct = now; sa_lci = idx; sa_kd = v;
    );
  );
  v5_drag == idx ? (
    !sa_dz && abs(m - sa_mz) > 3 * sc ? ( sa_dz = 1; sa_my = m; );
    sa_dz ? (
      d = m - sa_my;
      sa_n = min(max(sa_n + d / ((v5_shift ? 5 : 1) * 200 * sc), 0), 1); sa_my = m;
      nw = lg ? vmin * (vmax / vmin) ^ sa_n : vmin + sa_n * (vmax - vmin);
      v5_step > 0 && !v5_shift ? nw = vmin + floor((nw - vmin) / v5_step + 0.5) * v5_step;
      nw != v ? sa_ch = 1;
    );
  );
  hit && mouse_wheel != 0 && v5_drag == 0 ? (
    v5_step > 0 && !v5_shift ? (
      nw = min(max(vmin + (floor((v - vmin) / v5_step + 0.5) + sign(mouse_wheel)) * v5_step, vmin), vmax);
    ) : (
      n = min(max(n + mouse_wheel / 120 * (v5_shift ? 0.005 : 0.03), 0), 1);
      nw = lg ? vmin * (vmax / vmin) ^ n : vmin + n * (vmax - vmin);
    );
    sa_ch = nw != v; mouse_wheel = 0;
  );
  v5_step = 0;
  v5_act = hit || v5_drag == idx;
  sa_nv = nw;
);
function sa_dial(cx, cy, r, idx, lbl, fs) local(mj, lk, v, n, a, i, t, rs, dm, lo, hi, lg) (
  dm = av_dim; av_dim = 0;
  lo = AVL[idx]; hi = AVH[idx]; lg = AVG[idx];
  AVS[idx] > 0 ? v5_step = AVS[idx];
  mj = sx_mj(idx); lk = mj >= 0 && slider122 >= 0.5 && ed_cell == 0;
