pwr_out(dh_L, dh_R); dh_L = pwr_l; dh_R = pwr_r;
dh_dcyl = dh_L - dh_dcxl + 0.9996 * dh_dcyl; dh_dcxl = dh_L; dh_L = dh_dcyl;
dh_dcyr = dh_R - dh_dcxr + 0.9996 * dh_dcyr; dh_dcxr = dh_R; dh_R = dh_dcyr;

dh_vol += (dh_volt - dh_vol) * dh_sm;
dh_L = ostL.ost_band(dh_L * dh_vol * dh_pcg); dh_R = ostR.ost_band(dh_R * dh_vol * dh_pcg);
ost_out(dh_L, dh_R);
spl0 = ost_l; spl1 = ost_r;
dh_pk_disp = max(dh_pk_disp, max(abs(spl0), abs(spl1)));
av_pk = max(abs(spl0), abs(spl1)); av_pk > av_pk_d ? av_pk_d = av_pk;

@gfx 900 355
AVPF = 0xD3DCE7; AVINX = 0xC2CDDA; AVI = 0x1E3550; AVDOT = 0x4A6280; AVTD = 0.3; AVB = 0x1E1838; AVM = 0xD86AB8;
