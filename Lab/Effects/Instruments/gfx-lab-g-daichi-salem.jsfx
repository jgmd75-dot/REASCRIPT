dh_phst == 0 && dh_phw < 0.00001 ? ( dh_phw = 0; dh_a1l = dh_a2l = dh_a3l = dh_a4l = dh_a1r = dh_a2r = dh_a3r = dh_a4r = dh_pfl = dh_pfr = 0; );
dh_phs = dh_phst || dh_phw > 0;

pwr_in(dh_L, dh_R); dh_L = pwr_l; dh_R = pwr_r;
dh_dwg += (dh_dwt - dh_dwg) * dh_sm;
dh_dist = dh_dwg > 0.0001;
dh_damg += (dh_dat - dh_damg) * dh_sm;
dh_dist && (dh_tick || dh_dfirst) ? (
  dh_dfirst = 0; dh_damt = dh_damg;
  dh_dg = 1 + 30 * dh_damt * dh_damt; dh_dl = 1 / (1 + 0.9 * sqrt(dh_damt * 3)); dh_dt0 = vo_tanh(0.12 * dh_damt);
  dh_bits = 2 ^ (12 - 9 * dh_damt); dh_hr = 1 / (1 + 15 * dh_damt * dh_damt);
);
dh_dist ? (
  dh_dxl = dh_L; dh_dxr = dh_R;
  dh_dtyp == 0 ? (
    dh_L = (dh_dzl.dh_daa(dh_pfl.clp_pf_run(dh_L) * dh_dg + 0.12 * dh_damt) - dh_dt0) * dh_dl;
    dh_R = (dh_dzr.dh_daa(dh_pfr.clp_pf_run(dh_R) * dh_dg + 0.12 * dh_damt) - dh_dt0) * dh_dl;
    dh_tl += (dh_L - dh_tl) * 0.55; dh_tr += (dh_R - dh_tr) * 0.55; dh_L = dh_tl; dh_R = dh_tr;
  ) : (
    dh_hcnt += dh_hr; dh_hcnt >= 1 ? ( dh_hcnt -= 1; dh_hold = floor(dh_L * dh_bits + 0.5) / dh_bits; dh_holdr = floor(dh_R * dh_bits + 0.5) / dh_bits; );
    dh_L = dh_hold; dh_R = dh_holdr;
