function ws_title(x, y, s) ( ws_ft(17); ui_col(WSY); ws_tl(x, y, s); );
function ws_hover(cx, cy, fs) ( ws_hon = 1; ws_hx = cx; ws_hy = cy; ws_hfs = fs; );
function ws_note(n) local(k) (
  k = (n | 0) % 12;
  #ws_nn = k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "Eb" : k == 4 ? "E" : k == 5 ? "F" : k == 6 ? "F#" : k == 7 ? "G" : k == 8 ? "Ab" : k == 9 ? "A" : k == 10 ? "Bb" : "B";
  sprintf(#ws_no, "%d", floor((n | 0) / 12) - 1); strcat(#ws_nn, #ws_no);
  #ws_nn;
);
function ws_fmt(idx) local(v) (
  v = slider(idx);
  idx == 7 || idx == 8 ? ( v < 1000 ? sprintf(#ws_hv, "%d ms", v) : sprintf(#ws_hv, "%.2f s", v / 1000); )
  : idx == 11 ? ( v < 0.1 ? sprintf(#ws_hv, "%.3f Hz", v) : sprintf(#ws_hv, "%.2f Hz", v); )
  : idx == 20 ? ( v < 24.5 ? strcpy(#ws_hv, "OFF") : strcpy(#ws_hv, ws_note(v)); )
  : idx == 32 ? ( v = 50 * 2 ^ (v * 7.6); v < 1000 ? sprintf(#ws_hv, "%d Hz", v) : sprintf(#ws_hv, "%.1f kHz", v / 1000); )
  : idx == 35 ? sprintf(#ws_hv, "%+.1f dB", v)
