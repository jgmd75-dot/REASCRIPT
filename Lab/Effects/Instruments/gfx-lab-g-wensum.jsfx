desc:Wensum [string machine] (GFX Lab)
//tags: instrument synthesizer string machine strings ensemble divide-down chorus choir brass vintage pad
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-bverb (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-bverb.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider38:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:era=3<0,6,1{Echo 69,Organ 72,Warm 73,Glass 74,Multi 77,Choir 79,Sweep 80}>-Era
slider2:lv_vn=0.8<0,1,0.001>-Violin level
slider3:lv_va=0.6<0,1,0.001>-Viola level
slider4:lv_ce=0.5<0,1,0.001>-Cello level
slider5:bright=0.5<0,1,0.001>-Bright
slider6:vib=0<0,1,0.001>-Vibrato
slider7:atk=120<5,5000,1:log>-Attack (ms)
slider8:rel=900<20,8000,1:log>-Release (ms)
slider9:ens_on=1<0,1,1{Off,On}>-Ensemble
slider10:ens_dep=0.5<0,1,0.001>-Ensemble depth
slider11:ens_rate=0.6<0.01,5,0.001:log>-Ensemble rate (Hz)
slider12:ens_mix=0.8<0,1,0.001>-Ensemble mix
slider13:space=0.15<0,1,0.001>-Space
slider14:e_echo=0.45<0,1,0.001>-Echo 69 echo
slider15:e_wow=0.35<0,1,0.001>-Echo 69 wow
slider16:e_spread=0.5<0,1,0.001>-Echo 69 spread
slider17:o_flute=0.35<0,1,0.001>-Organ 72 flute
slider18:o_silk=0.6<0,1,0.001>-Organ 72 silk
slider19:o_width=0.7<0,1,0.001>-Organ 72 width
slider20:w_split=53<24,84,1>-Warm 73 split (note)
slider21:w_lower=0.6<0,1,0.001>-Warm 73 lower
slider22:w_wood=0.5<0,1,0.001>-Warm 73 wood
slider23:g_ice=0.5<0,1,0.001>-Glass 74 ice
slider24:g_horn=0<0,1,0.001>-Glass 74 horn
slider25:g_bass=0.3<0,1,0.001>-Glass 74 bass
slider26:m_bass=0.6<0,1,0.001>-Multi 77 bass
slider27:m_brass=0.45<0,1,0.001>-Multi 77 brass
slider28:m_vcf=0.5<0,1,0.001>-Multi 77 filter
slider29:c_male=0.6<0,1,0.001>-Choir 79 male
slider30:c_female=0.6<0,1,0.001>-Choir 79 female
slider31:c_vowel=0.4<0,1,0.001>-Choir 79 vowel
slider32:s_cut=0.35<0,1,0.001>-Sweep 80 cutoff
slider33:s_res=0.55<0,1,0.001>-Sweep 80 resonance
slider34:s_env=0.6<0,1,0.001>-Sweep 80 envelope
slider35:vol=0<-24,6,0.1>-Volume (dB)
slider36:drift=50<0,100,1>-Drift (%)
slider37:prs_sel=0<0,36,1{No preset,Init,Three Heads,Copy Room,Reed Swarm,Wobbly Reel,First Light,Hover,Silk Road,Wide Drone,Home Organ,Slow Planet,Woody Section,Cello Floor,Split Hall,Warm Velvet,Lower Lights,Icicle,Benchmark,Cold Light,Horn and Strings,Frost Line,Workhorse,Disco Stage,Brass Pad,Bass and Strings,Arena Night,Liquid Voices,Choir Loft,Strings and Voices,Ether,Tall Room,Slow Sweep,Resonant Pad,Opening Up,Filter Bloom,Night Drive}>-Preset

@init
function psw_all(v) ( slider_show(274877906943, v); );
function psw_allg(v) ( slider_show(274877906943, v); );
#ui_man = "gfx-lab-g-wensum";
#ws_pm = "Init|Three Heads|Copy Room|Reed Swarm|Wobbly Reel|First Light|Hover|Silk Road|Wide Drone|Home Organ|Slow Planet|Woody Section|Cello Floor|Split Hall|Warm Velvet|Lower Lights|Icicle|Benchmark|Cold Light|Horn and Strings|Frost Line|Workhorse|Disco Stage|Brass Pad|Bass and Strings|Arena Night|Liquid Voices|Choir Loft|Strings and Voices|Ether|Tall Room|Slow Sweep|Resonant Pad|Opening Up|Filter Bloom|Night Drive";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

NV = 16;  VS = 32;  VOX = 0;
TOP = 600;  TIC = 620;  PDV = 640;  PDT = 660;  PDM = 680;
EPS = 700;  EPF = 704;  ERS = 708;  ERF = 712;
PRF = 800;  PRN = 24;
VWL = 1000;
MQ = 4096;  MQMAX = 1000;
EB = 65536;  EN = 16384;
TB = 131072;  TN = 131072;
FX_MEM = 1048576;

F_ON = 0;  F_KEY = 1;  F_GATE = 2;  F_SUS = 3;  F_ENV = 4;  F_AGE = 5;  F_FIN = 6;  F_FADE = 7;
F_STEAL = 8;  F_PEND = 9;  F_PC = 10;  F_I8 = 11;  F_WU = 12;  F_WL = 13;  F_TU = 14;  F_TL = 15;
F_BE = 16;  F_BR = 17;  F_BZ = 18;  F_BA = 19;  F_NOTE = 20;

memset(VOX, 0, NV * VS);  memset(TOP, 0, 12);  memset(EPS, 0, 16);
memset(EB, 0, EN);  memset(TB, 0, TN);

k = 0;
loop(12, TOP[k] = rand(1) * 1024;  PDV[k] = 0;  PDT[k] = rand(2) - 1;  PDM[k] = rand(3);  k += 1; );
k = 0;  loop(3, EPS[k] = k / 3;  EPF[k] = k / 3;  k += 1; );

function prf_row(e, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11) local(p) (
  p = PRF + e * PRN;
  p[0] = a0;  p[1] = a1;  p[2] = a2;  p[3] = a3;  p[4] = a4;  p[5] = a5;
  p[6] = a6;  p[7] = a7;  p[8] = a8;  p[9] = a9;  p[10] = a10;  p[11] = a11;
);
function prf_row2(e, b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11) local(p) (
  p = PRF + e * PRN + 12;
  p[0] = b0;  p[1] = b1;  p[2] = b2;  p[3] = b3;  p[4] = b4;  p[5] = b5;
  p[6] = b6;  p[7] = b7;  p[8] = b8;  p[9] = b9;  p[10] = b10;  p[11] = b11;
);
prf_row(0, 0.25, 3800, 1300, 0.9, 2600, 1400, 160, 6, 0.3, 0.3, 6.0, 1);
prf_row2(0, 0.31, 0.37, 0.43, 0.88, 1.0, 1.15, 4500, 0.219, 0.5, 0.35, 1.0, 1.0);
prf_row(1, 0.15, 5200, 2000, 0.3, 3500, 1800, 120, 7, 2.2, 0.15, 5.7, 1);
prf_row2(1, 1, 1.37, 1.79, 0.9, 1.0, 1.1, 7000, 0.178, 0.7, 0.6, 1.0, 1.0);
prf_row(2, 0.85, 3000, 1100, 0.4, 2000, 900, 90, 5.5, 1.4, 0.15, 5.2, 0);
prf_row2(2, 1, 1, 1, 1, 1, 1, 6000, 0.366, 0.6, 0.3, 1.3, 1.0);
prf_row(3, 0.7, 9000, 3200, 1.0, 4500, 2200, 220, 5, 1.6, 0.18, 6.0, 0);
prf_row2(3, 1, 1, 1, 1, 1, 1, 9500, 0.327, 0.6, 0.6, 0.8, 1.0);
prf_row(4, 0.75, 7500, 2800, 0.7, 4000, 1800, 180, 5, 1.5, 0.17, 5.6, 0);
prf_row2(4, 1, 1, 1, 1, 1, 1, 8500, 0.311, 0.6, 0.5, 0.9, 1.0);
prf_row(5, 0.6, 6000, 2500, 0.4, 3500, 1600, 140, 8, 2.5, 0.12, 5.0, 1);
prf_row2(5, 1, 1.29, 1.61, 0.88, 1.0, 1.1, 7500, 0.236, 0.9, 0.4, 1.0, 1.0);
prf_row(6, 0.9, 11000, 3000, 0.4, 6000, 3000, 100, 5, 1.5, 0.15, 5.8, 0);
prf_row2(6, 1, 1, 1, 1, 1, 1, 9000, 0.652, 0.7, 0.5, 1.0, 1.0);

function vw_set(i, a, b, c, d, e, f) ( VWL[i * 6] = a;  VWL[i * 6 + 1] = b;  VWL[i * 6 + 2] = c;  VWL[i * 6 + 3] = d;  VWL[i * 6 + 4] = e;  VWL[i * 6 + 5] = f; );
vw_set(0, 320, 800, 2240, 370, 950, 2670);
vw_set(1, 700, 1100, 2450, 850, 1220, 2810);
vw_set(2, 290, 2100, 3000, 320, 2700, 3300);

bv_alloc(FX_MEM);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
RVM = 1960;  k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );
drf_g.drift_init(0.8);  drf_e.drift_init(1.2);

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function pb(t, dt) ( t < dt ? ( t /= dt;  t + t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt;  t * t + t + t + 1; ) : 0; );

function svf_c(fc, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(max(fc, 10), 0.45 * srate) / srate);  k = 1 / q;
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf(x) instance(ic1, ic2, a1, a2, a3, lp, bp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;  lp = v2;  bp = v1;  v2;
);
function svf_z() instance(ic1, ic2, lp, bp) ( ic1 = ic2 = lp = bp = 0; );

function lad(x) local(u, v, y1, y2, y3, y4) (
  y4 = (lgk4 * x + lbk * (lgk3 * LS0 + lgk2 * LS1 + lgk * LS2 + LS3)) * linv;
  u = ts(x - kres * y4);
  v = (u - LS0) * lgk;   y1 = v + LS0;  LS0 = y1 + v;
  v = (y1 - LS1) * lgk;  y2 = v + LS1;  LS1 = y2 + v;
  v = (y2 - LS2) * lgk;  y3 = v + LS2;  LS2 = y3 + v;
  v = (y3 - LS3) * lgk;  y4 = v + LS3;  LS3 = y4 + v;
  y4;
);

function v_note(b, key) local(n, pc, d) (
  n = key;  while (n < 12) ( n += 12; );
  pc = n % 12;  while (n > 96 + pc) ( n -= 12; );
  d = (108 + pc - n) / 12;
  b[F_NOTE] = n;  b[F_PC] = pc;  b[F_I8] = 2 ^ (-d);  b[F_BZ] = key < 53;
);
function v_zone(b) (
  split_on ? ( b[F_TU] = b[F_KEY] >= w_sp;  b[F_TL] = 1 - b[F_TU]; ) : ( b[F_TU] = 1;  b[F_TL] = 1; );
);
function v_start(b, key) (
  b[F_ON] = 1;  b[F_KEY] = key;  b[F_GATE] = 1;  b[F_SUS] = 0;  b[F_BA] = 1;
  age_n += 1;  b[F_AGE] = age_n;
  b[F_STEAL] = 0;  b[F_FADE] = 1;
  v_note(b, key);  v_zone(b);
  b[F_ENV] < 0.0005 && b[F_BE] < 0.0005 && b[F_BR] < 0.0005 ? (
    b[F_FIN] = 0;  b[F_ENV] = 0;  b[F_BE] = 0;  b[F_BR] = 0;
    b[F_WU] = b[F_TU];  b[F_WL] = b[F_TL];
  );
);
function v_alloc(key) local(v, b, best, bq, q, same) (
  same = -1;  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_ON] && b[F_KEY] == key && !b[F_STEAL] ? same = v;  v += 1; );
  same >= 0 ? v_start(VOX + same * VS, key) : (
    best = 0;  bq = 1000000000;  v = 0;
    loop(NV,
      b = VOX + v * VS;
      q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? max(b[F_ENV], max(b[F_BE], b[F_BR])) : 2 + b[F_AGE];
      q < bq ? ( bq = q;  best = v; );
      v += 1;
    );
    b = VOX + best * VS;
    b[F_ON] && (b[F_ENV] > 0.0005 || b[F_BE] > 0.0005 || b[F_BR] > 0.0005) ? (
      b[F_STEAL] = 1;  b[F_PEND] = key;
    ) : v_start(b, key);
  );
);
function v_release_key(key) local(v, b) (
  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_KEY] == key ? ( sustain ? b[F_SUS] = 1;  b[F_GATE] = 0; );
    b[F_STEAL] && b[F_PEND] == key ? b[F_PEND] = -1;
    v += 1;
  );
);
function v_pedal_up() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_SUS] = 0;  v += 1; ); );
function v_all_off() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_STEAL] ? b[F_PEND] = -1;  v += 1; );
);
function v_kill() local(v, b) (
  v = 0;  loop(NV, b = VOX + v * VS;  memset(b, 0, VS);  v += 1; );
);

function note_on(n) ( ws_mlt += 1;  v_alloc(n);  fe_stg = 1; );
function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? note_on(d1) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? v_release_key(d1) :
  st == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 1 ? mw = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);

function v_run(b) local(pc, tp, ti, i8, p, dt, t, s8, s4, s16, q8, q4, q16, x8, x4, x16, e, tgt, w, g, wu, wl, gb) (
  pc = b[F_PC];  tp = TOP[pc];  ti = TIC[pc];  i8 = b[F_I8];
  p = tp * i8;  p -= floor(p);  dt = ti * i8;
  s8 = p + p - 1 - pb(p, dt);  t = p + 0.5;  t >= 1 ? t -= 1;  q8 = s8 - (t + t - 1 - pb(t, dt));
  p = tp * i8 * 0.5;  p -= floor(p);  dt *= 0.5;
  s16 = p + p - 1 - pb(p, dt);  t = p + 0.5;  t >= 1 ? t -= 1;  q16 = s16 - (t + t - 1 - pb(t, dt));
  p = tp * i8 * 2;  p -= floor(p);  dt *= 4;
  s4 = p + p - 1 - pb(p, dt);  t = p + 0.5;  t >= 1 ? t -= 1;  q4 = s4 - (t + t - 1 - pb(t, dt));
  x8 = q8 + sh_s * (s8 - q8);  x16 = q16 + sh_s * (s16 - q16);  x4 = q4 + sh_s * (s4 - q4);
  tgt = b[F_GATE] || b[F_SUS];
  e = b[F_ENV];  e += (tgt - e) * (tgt > e ? env_ka : env_kr);  b[F_ENV] = e;
  b[F_FIN] < 1 ? ( w = 0.5 - 0.5 * cos($pi * b[F_FIN]);  b[F_FIN] = min(1, b[F_FIN] + fin_step); ) : w = 1;
  w *= b[F_FADE];
  g = e * w;
  wu = b[F_WU] + (b[F_TU] - b[F_WU]) * zn_k;  b[F_WU] = wu;
  wl = b[F_WL] + (b[F_TL] - b[F_WL]) * zn_k;  b[F_WL] = wl;
  bAu += g * wu * x8;  bBu += g * wu * x4;  bAl += g * wl * x8;  bCl += g * wl * x16;
  ex_fl ? bFl += g * (q8 + 0.5 * q4);
  ex_hn ? bHn += g * q8;
  ex_ch ? ( bMl += g * x16;  bFm += g * s8; );
  ex_bs ? (
    b[F_BA] ? ( b[F_BE] += (1.05 - b[F_BE]) * bs_ka;  b[F_BE] >= 1 ? b[F_BA] = 0; )
            : b[F_BE] += ((tgt ? bs_sus : 0) - b[F_BE]) * (tgt ? bs_kd : bs_kr);
    bBs += b[F_BE] * w * b[F_BZ] * (s16 + 0.5 * s8);
  ) : b[F_BE] = 0;
  ex_br ? (
    gb = b[F_BR];  gb += (tgt - gb) * (tgt > gb ? br_ka : br_kr);  b[F_BR] = gb;
    bBr += gb * w * s8;
  ) : b[F_BR] = 0;
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? (
      b[F_FADE] = 0;  b[F_STEAL] = 0;  b[F_ENV] = 0;  b[F_BE] = 0;  b[F_BR] = 0;
      b[F_PEND] >= 0 ? v_start(b, b[F_PEND]) : b[F_ON] = 0;
    );
  ) : !tgt && e < 0.00002 && b[F_BE] < 0.00002 && b[F_BR] < 0.00002 ? (
    b[F_ON] = 0;  b[F_ENV] = 0;  b[F_BE] = 0;  b[F_BR] = 0;
  );
);

function fx_block() local(k, ms, sz) (
  sz = 0.3 + 0.7 * 0.62;
  k = 0;
  loop(8,
    ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
    ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
    k += 1;
  );
  bv_t60 = 3.2;  bv_rtlo = 1.2;  bv_rthi = 1 - 0.82 * 0.55;
  k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
  bv_xover();
  sp_pre = 0.026 * srate;
  k = 0;
  loop(8,
    RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
    ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
    k += 1;
  );
  space > 0.0005 && !sp_live ? bv_alloc(FX_MEM);
  sp_live = space > 0.0005 || spm_s > 0.0005;
);

function era_targets() local(p, e) (
  e = era_a;  p = PRF + e * PRN;
  ens_ind = p[11];
  ers_t = 0;
  ens_base_t = p[7];
  dS_t = p[8] * ens_dep * 2;  dF_t = p[9] * ens_dep * 2;
  e == 1 ? ( dS_t *= 0.4 + 1.2 * o_silk;  dF_t *= 1.4 - 0.9 * o_silk; );
  e == 0 ? ( dS_t *= 0.5 + 2 * e_wow; );
  wid_t = e == 1 ? o_width : p[20];
  eg_t = p[19];
  vB_t = p[21] + (e == 3 ? 0.8 * g_ice - 0.4 : 0);
  lvc_k = p[22];  lva_k = p[23];
  sh_t = p[0];
  bri = 2 ^ ((bright - 0.5) * 3);
  vlp_t = p[1] * bri * (e == 3 ? 2 ^ ((g_ice - 0.5) * 1.2) : 1);
  pkf_t = p[2];  pkg_t = p[3] * (e == 3 ? 0.6 + 0.8 * g_ice : 1);
  valp_t = p[4] * bri;  clp_t = p[5] * bri;  hpf_t = p[6];
  wlp_t = p[18];
  wood_t = e == 2 ? w_wood : 0;
  cm_t = e == 2 ? 0.4 + 1.2 * w_lower : 1;
  fl_t = e == 1 ? o_flute : 0;
  hn_t = e == 3 ? g_horn : 0;
  gbs = e == 3 ? g_bass : e == 4 ? m_bass : 0;
  bs_t = gbs;  br_t = e == 4 ? m_brass : 0;
  ml_t = e == 5 ? c_male : 0;  fm_t = e == 5 ? c_female : 0;
  sw_t = e == 6;
  echo_t = e == 0 ? e_echo : 0;
  split_on = e == 2 && w_split > 24.5;  w_sp = w_split | 0;
);

function update_params() local(t) (
  env_ka = 1 - exp(-2.2 / max(1, atk * 0.001 * srate));
  env_kr = 1 - exp(-5 / max(1, rel * 0.001 * srate));
  fin_step = 1 / (0.002 * srate);  fade_step = 1 / (0.003 * srate);
  zn_k = 1 - exp(-1 / (0.012 * srate));
  bs_ka = 1 - exp(-1 / (0.004 * srate));  bs_kd = 1 - exp(-1 / (0.7 * srate));  bs_kr = 1 - exp(-1 / (0.18 * srate));  bs_sus = 0.35;
  br_ka = 1 - exp(-1 / (0.045 * srate));  br_kr = 1 - exp(-1 / (max(0.06, rel * 0.0005) * srate));
  fe_a = 1 - exp(-CR / (max(0.005, atk * 0.0008) * srate));  fe_d = 1 - exp(-CR / (1.6 * srate));  fe_r = exp(-CR / (max(0.05, rel * 0.0008) * srate));
  smk = 1 - exp(-1 / (0.015 * srate));  crk = 1 - exp(-CR / (0.02 * srate));
  dk_st = 1 / (0.012 * srate);
  drift_macro(drift);
  outg_t = 10 ^ (vol / 20) * OUTK;
  lvn_t = lv_vn * lv_vn;  lva_t = lv_va * lv_va;  lce_t = lv_ce * lv_ce;
  enon_t = ens_on >= 0.5;  mix_t = ens_mix;  spm_t = space;
  vib_t = vib;
  era_t = max(0, min(6, era | 0));
  era_targets();
);

function cr_tick() local(k, p, f, c, q, m, v0, v1, vf, i, fc) (
  vibs += (vib_t + mw * 0.6 - vibs) * crk;
  vib_ph += 5.6 * CR / srate;  vib_ph -= floor(vib_ph);
  m = bend * 100 + vibs * 30 * sin(2 * $pi * vib_ph) + glb_d * 3 * dm_a;
  k = 0;
  loop(12,
    c = m + PDV[k] * 4 * dm_a;
    TIC[k] = 440 * 2 ^ ((108 + k - 69) / 12 + c / 1200) / srate;
    k += 1;
  );
  sh_s += (sh_t - sh_s) * crk;
  vlp_s += (vlp_t - vlp_s) * crk;  valp_s += (valp_t - valp_s) * crk;  clp_s += (clp_t - clp_s) * crk;
  pkg_s += (pkg_t - pkg_s) * crk;  vB_s += (vB_t - vB_s) * crk;
  fvl.svf_c(vlp_s, 0.707);  fpk.svf_c(pkf_t, 1.2);  fva.svf_c(valp_s, 0.6);  fce.svf_c(clp_s, 0.6);
  hp_c = 1 - exp(-2 * $pi * hpf_t / srate);
  wlp_s += (wlp_t - wlp_s) * crk;  wl_c = 1 - exp(-2 * $pi * min(wlp_s, 0.4 * srate) / srate);
  base_s += (ens_base_t - base_s) * crk;  dS_s += (dS_t - dS_s) * crk;  dF_s += (dF_t - dF_s) * crk;  wid_s += (wid_t - wid_s) * crk;
  held = 0;  k = 0;  loop(NV, p = VOX + k * VS;  held += p[F_ON] && (p[F_GATE] || p[F_SUS]);  k += 1; );
  fe_stg == 1 ? ( fe_v += (1.03 - fe_v) * fe_a;  fe_v >= 1 ? ( fe_v = 1;  fe_stg = 2; ); ) :
  fe_stg == 2 ? ( fe_v += (fe_sus - fe_v) * fe_d;  !held ? fe_stg = 3; ) :
  fe_v *= fe_r;
  wood_s > 0.0005 || wood_t > 0 ? ( fw1.svf_c(280, 1.4);  fw2.svf_c(900, 1.8); );
  hn_s > 0.0005 || hn_t > 0 ? fhn.svf_c(1400 * bri, 0.8);
  fl_c = 1 - exp(-2 * $pi * 1900 * bri / srate);
  bs_s > 0.0005 || bs_t > 0 ? fbs.svf_c(650 * bri, 0.8);
  br_s > 0.0005 || br_t > 0 ? (
    mv_s += (m_vcf - mv_s) * crk;
    fbr.svf_c(220 * 2 ^ (mv_s * 4.5 + fe_v * 2.5), 1.3);
  );
  ml_s > 0.0005 || fm_s > 0.0005 || ml_t > 0 || fm_t > 0 ? (
    vw_s += (c_vowel - vw_s) * crk;
    v0 = vw_s < 0.5 ? 0 : 1;  vf = vw_s < 0.5 ? vw_s * 2 : vw_s * 2 - 1;
    i = 0;
    loop(6,
      f = VWL[v0 * 6 + i] + (VWL[(v0 + 1) * 6 + i] - VWL[v0 * 6 + i]) * vf;
      q = (i % 3) == 0 ? 7 : (i % 3) == 1 ? 9 : 11;
      i == 0 ? fm0.svf_c(f, q) : i == 1 ? fm1.svf_c(f, q) : i == 2 ? fm2.svf_c(f, q) :
      i == 3 ? ff0.svf_c(f, q) : i == 4 ? ff1.svf_c(f, q) : ff2.svf_c(f, q);
      i += 1;
    );
  );
  sw_s > 0.0005 || sw_t ? (
    sc_s += (s_cut - sc_s) * crk;  sr_s += (s_res - sr_s) * crk;  se_s += (s_env - se_s) * crk;
    fc = 50 * 2 ^ (sc_s * 7.6 + se_s * fe_v * 4.5);
    fc = min(fc, 0.42 * srate);
    lgk = tan($pi * fc / srate);  lgk = lgk / (1 + lgk);  lbk = 1 - lgk;  lgk2 = lgk * lgk;  lgk3 = lgk2 * lgk;  lgk4 = lgk2 * lgk2;
    kres = sr_s * 3.8;  linv = 1 / (1 + kres * lgk4);
  );
);

function pz(e, vn, va, ce, br, vb, at, rl, eo, dp, rt, mx, sp, a, b, c, vl) (
  slider(1) = e;  slider(2) = vn;  slider(3) = va;  slider(4) = ce;  slider(5) = br;  slider(6) = vb;
  slider(7) = at;  slider(8) = rl;  slider(9) = eo;  slider(10) = dp;  slider(11) = rt;  slider(12) = mx;  slider(13) = sp;
  slider(14 + e * 3) = a;  slider(15 + e * 3) = b;  slider(16 + e * 3) = c;  slider(35) = vl;
);
function p_init() (
  slider(14) = 0.45;  slider(15) = 0.35;  slider(16) = 0.5;  slider(17) = 0.35;  slider(18) = 0.6;  slider(19) = 0.7;
  slider(20) = 53;  slider(21) = 0.6;  slider(22) = 0.5;  slider(23) = 0.5;  slider(24) = 0;  slider(25) = 0.3;
  slider(26) = 0.6;  slider(27) = 0.45;  slider(28) = 0.5;  slider(29) = 0.6;  slider(30) = 0.6;  slider(31) = 0.4;
  slider(32) = 0.35;  slider(33) = 0.55;  slider(34) = 0.6;
  pz(3, 0.8, 0.6, 0.5, 0.5, 0, 120, 900, 1, 0.5, 0.6, 0.8, 0.15, 0.5, 0, 0.3, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? pz(0, 0.8, 0.6, 0.5, 0.5, 0, 150, 1200, 1, 0.5, 0.4, 0.8, 0.15, 0.45, 0.35, 0.5, 0) :
  p == 3 ? pz(0, 0.6, 0.8, 0.3, 0.4, 0, 200, 1500, 1, 0.6, 0.3, 0.9, 0.25, 0.7, 0.5, 0.4, 0) :
  p == 4 ? pz(0, 0.9, 0.4, 0.2, 0.65, 0.1, 60, 700, 1, 0.7, 0.5, 0.85, 0.1, 0.3, 0.2, 0.8, 0) :
  p == 5 ? pz(0, 0.7, 0.7, 0.6, 0.45, 0, 300, 2000, 1, 0.55, 0.25, 0.8, 0.2, 0.6, 0.9, 0.6, 0) :
  p == 6 ? pz(0, 0.5, 0.6, 0.8, 0.4, 0, 500, 2500, 1, 0.45, 0.2, 0.75, 0.3, 0.35, 0.3, 0.35, 0) :
  p == 7 ? pz(1, 0.8, 0.7, 0.5, 0.5, 0, 250, 1800, 1, 0.55, 0.45, 0.85, 0.25, 0.35, 0.7, 0.75, 0) :
  p == 8 ? pz(1, 0.7, 0.8, 0.6, 0.55, 0, 400, 2500, 1, 0.65, 0.3, 0.9, 0.3, 0.2, 0.9, 0.85, 0) :
  p == 9 ? pz(1, 0.6, 0.6, 0.9, 0.4, 0, 900, 4000, 1, 0.7, 0.12, 0.9, 0.4, 0.4, 1.0, 1.0, 0) :
  p == 10 ? pz(1, 0.5, 0.6, 0.5, 0.45, 0.15, 30, 500, 1, 0.45, 0.8, 0.7, 0.1, 0.8, 0.4, 0.5, 0) :
  p == 11 ? pz(1, 0.7, 0.5, 0.7, 0.35, 0, 1200, 5000, 1, 0.8, 0.05, 0.95, 0.45, 0.3, 0.8, 0.9, 0) :
  p == 12 ? pz(2, 0.7, 0.7, 0.7, 0.5, 0, 150, 1100, 1, 0.5, 0.55, 0.8, 0.15, 24, 0.6, 0.6, 0) :
  p == 13 ? pz(2, 0.3, 0.5, 0.95, 0.4, 0, 250, 1500, 1, 0.45, 0.5, 0.75, 0.2, 24, 0.7, 0.8, 0) :
  p == 14 ? pz(2, 0.8, 0.6, 0.8, 0.5, 0, 120, 1000, 1, 0.5, 0.6, 0.8, 0.2, 55, 0.65, 0.5, 0) :
  p == 15 ? pz(2, 0.6, 0.8, 0.6, 0.35, 0, 400, 2200, 1, 0.6, 0.35, 0.85, 0.25, 24, 0.6, 0.9, 0) :
  p == 16 ? pz(2, 0.7, 0.5, 0.9, 0.45, 0.1, 200, 1600, 1, 0.55, 0.45, 0.8, 0.3, 48, 0.9, 0.7, 0) :
  p == 17 ? pz(3, 0.9, 0.5, 0.3, 0.6, 0, 100, 1000, 1, 0.55, 0.6, 0.85, 0.2, 0.85, 0, 0.1, 0) :
  p == 18 ? pz(3, 0.8, 0.6, 0.5, 0.5, 0, 120, 900, 1, 0.5, 0.6, 0.8, 0.15, 0.5, 0, 0.3, 0) :
  p == 19 ? pz(3, 0.7, 0.7, 0.6, 0.55, 0, 350, 2000, 1, 0.65, 0.4, 0.9, 0.35, 0.7, 0, 0.2, 0) :
  p == 20 ? pz(3, 0.7, 0.5, 0.5, 0.5, 0, 90, 900, 1, 0.5, 0.6, 0.8, 0.15, 0.4, 0.6, 0.4, 0) :
  p == 21 ? pz(3, 0.85, 0.4, 0.2, 0.7, 0, 60, 700, 1, 0.6, 0.7, 0.8, 0.25, 1.0, 0, 0, 0) :
  p == 22 ? pz(4, 0.8, 0.6, 0.4, 0.5, 0, 80, 700, 1, 0.5, 0.6, 0.8, 0.12, 0.6, 0.45, 0.5, 0) :
  p == 23 ? pz(4, 0.8, 0.5, 0.3, 0.6, 0, 40, 400, 1, 0.55, 0.7, 0.8, 0.1, 0.8, 0.3, 0.6, 0) :
  p == 24 ? pz(4, 0.3, 0.3, 0.2, 0.5, 0, 60, 600, 1, 0.45, 0.6, 0.7, 0.15, 0.3, 0.9, 0.55, 0) :
  p == 25 ? pz(4, 0.7, 0.6, 0.5, 0.45, 0, 100, 800, 1, 0.5, 0.5, 0.8, 0.12, 0.9, 0.2, 0.4, 0) :
  p == 26 ? pz(4, 0.8, 0.7, 0.5, 0.55, 0, 150, 1200, 1, 0.6, 0.55, 0.85, 0.3, 0.6, 0.6, 0.7, 0) :
  p == 27 ? pz(5, 0.6, 0.6, 0.5, 0.5, 0, 300, 2200, 1, 0.55, 0.3, 0.9, 0.35, 0.6, 0.7, 0.45, 0) :
  p == 28 ? pz(5, 0.2, 0.3, 0.3, 0.45, 0.1, 350, 2500, 1, 0.5, 0.25, 0.85, 0.4, 0.8, 0.8, 0.2, 0) :
  p == 29 ? pz(5, 0.8, 0.6, 0.5, 0.5, 0, 250, 2000, 1, 0.55, 0.35, 0.85, 0.3, 0.4, 0.5, 0.5, 0) :
  p == 30 ? pz(5, 0.4, 0.5, 0.4, 0.4, 0, 800, 4000, 1, 0.7, 0.15, 0.95, 0.5, 0.5, 0.9, 0.8, 0) :
  p == 31 ? pz(5, 0.5, 0.5, 0.6, 0.45, 0, 500, 3500, 1, 0.6, 0.2, 0.9, 0.6, 0.9, 0.4, 0.3, 0) :
  p == 32 ? pz(6, 0.8, 0.6, 0.5, 0.5, 0, 1500, 2500, 1, 0.5, 0.5, 0.8, 0.25, 0.15, 0.4, 0.7, 0) :
  p == 33 ? pz(6, 0.7, 0.6, 0.6, 0.5, 0, 300, 1500, 1, 0.5, 0.5, 0.8, 0.2, 0.3, 0.85, 0.55, 0) :
  p == 34 ? pz(6, 0.8, 0.5, 0.4, 0.55, 0, 2500, 3000, 1, 0.55, 0.4, 0.8, 0.3, 0.1, 0.5, 0.9, 0) :
  p == 35 ? pz(6, 0.7, 0.7, 0.5, 0.5, 0, 600, 2000, 1, 0.6, 0.35, 0.85, 0.3, 0.45, 0.65, 0.4, 0) :
  p == 36 ? pz(6, 0.8, 0.5, 0.6, 0.45, 0, 200, 1200, 1, 0.5, 0.7, 0.75, 0.2, 0.25, 0.7, 0.6, 0) :
  0;
  i = 1;  loop(35, slider_automate(2 ^ (i - 1));  i += 1; );
);

PR_N = 36;
function prs_hash() local(i, h) ( h = 0;  i = 1;  loop(36, h += slider(i) * (1 + i * 0.7071);  i += 1; );  h; );
function prs_same() local(h, r) ( h = prs_hash();  r = h == prs_h0;  prs_h0 = h;  r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  load_preset(k);
    k <= PR_N ? ( prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel;  prs_sel > 0 && prs_hs ? ( load_preset(prs_sel);  prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0;  prs_ok = 1; );
);
prs_ok = 0;  prs_dirty = 0;

function gap_clear() (
  v_kill();  memset(EB, 0, EN);  memset(TB, 0, TN);  bv_alloc(FX_MEM);
  fvl.svf_z();  fpk.svf_z();  fva.svf_z();  fce.svf_z();  fw1.svf_z();  fw2.svf_z();  fhn.svf_z();  fbs.svf_z();  fbr.svf_z();
  fm0.svf_z();  fm1.svf_z();  fm2.svf_z();  ff0.svf_z();  ff1.svf_z();  ff2.svf_z();
  LS0 = LS1 = LS2 = LS3 = 0;  hpv = flp = 0;  wl1 = wl2 = wr1 = wr2 = 0;  tlp = tfb = 0;
  dc_xl = dc_pl = dc_xr = dc_pr = 0;  dk = 0;  fe_v = 0;  fe_stg = 3;
);

OUTK = 0.16;
bend = 0;  mw = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  ew = 0;  tw = 0;  fe_stg = 3;  fe_v = 0;  fe_sus = 0.35;
era_a = max(0, min(6, era | 0));
update_params();
sh_s = sh_t;  vlp_s = vlp_t;  valp_s = valp_t;  clp_s = clp_t;  pkg_s = pkg_t;  vB_s = vB_t;  wlp_s = wlp_t;
base_s = ens_base_t;  dS_s = dS_t;  dF_s = dF_t;  wid_s = wid_t;
lvn_s = lvn_t;  lva_s = lva_t;  lce_s = lce_t;  enon_s = enon_t;  mix_s = mix_t;  spm_s = spm_t;  out_g = outg_t;
eg_s = eg_t;  cm_s = cm_t;  wood_s = wood_t;  fl_s = fl_t;  hn_s = hn_t;  bs_s = bs_t;  br_s = br_t;  ml_s = ml_t;  fm_s = fm_t;
sw_s = sw_t;  echo_s = echo_t;  vibs = vib_t;  mv_s = m_vcf;  vw_s = c_vowel;  sc_s = s_cut;  sr_s = s_res;  se_s = s_env;
dk = 1;  era_req = 0;
dc_r = 1 - 2 * $pi * 5 / srate;
cr_tick();

pwr_init();  pwr_sag = 0.12;  pwr_wu_loss = 0.5;  pwr_wu_drv = 0.3;  pwr_wu_lp = 9000;  pwr_wu_wob = 0.2;  pwr_bloom = 0.1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5;  psw_all(psw_last); );
prs_chk();
update_params();

@block
prs_chk();
ws_now = time_precise();
ws_tp > 0 && ws_now - ws_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > ws_gpp && play_position - ws_gpp < 4 * ws_gpd + 0.05) ? gap_clear();
ws_tp = ws_now;  ws_gpp = play_position;  ws_gpd = samplesblock / srate;
pwr_block(1);
update_params();
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
n_on0 = 0;  k = 0;  loop(NV, n_on0 += VOX[k * VS + F_ON] > 0;  k += 1; );
tp_now = play_state & 1;  tp_was && !tp_now ? v_all_off();  tp_was = tp_now;
era_t != era_a ? era_req = 1;
ex_fl = era_a == 1 || fl_s > 0.0005;  ex_hn = era_a == 3 || hn_s > 0.0005;  ex_ch = era_a == 5 || ml_s > 0.0005 || fm_s > 0.0005;
ex_bs = era_a == 3 || era_a == 4 || bs_s > 0.0005;  ex_br = era_a == 4 || br_s > 0.0005;
k = 0;  loop(NV, vb = VOX + k * VS;  vb[F_ON] ? v_zone(vb);  k += 1; );
glb_d = drf_g.drift_tick(samplesblock / srate * 0.2 * dm_s);
ere_d = drf_e.drift_tick(samplesblock / srate * 0.25 * dm_s);
k = 0;
loop(12,
  PDM[k] -= samplesblock / srate * dm_s;
  PDM[k] <= 0 ? ( PDT[k] = rand(2) - 1;  PDM[k] = 2 + rand(1) * 4; );
  PDV[k] += (PDT[k] - PDV[k]) * min(1, samplesblock / (1.5 * srate));
  k += 1;
);
e_p = PRF + era_a * PRN;
e_rs = ens_rate * (1 + 0.08 * dm_a * ere_d) / srate;
e_rf = e_p[10] / srate;
k = 0;
loop(3,
  ERS[k] = e_rs * (ens_ind ? e_p[12 + k] : 1);
  ERF[k] = e_rf * (ens_ind ? 1 + (e_p[15 + k] - 1) * (era_a == 0 ? 2 * e_spread : 1) : 1);
  k += 1;
);
fx_block();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = 0;
ws_qt = outpk < 0.0000001 ? ws_qt + samplesblock / srate : 0;
ws_idle = n_on0 == 0 && mq_n == 0 && ws_qt > 1 && !era_req;
ws_pk_d = max(ws_pk_d, outpk);  ws_lv_d = max(ws_lv_d * 0.8, outpk);  outpk = 0;
n_on = 0;  k = 0;  loop(NV, vb = VOX + k * VS;  n_on += vb[F_ON] > 0;  k += 1; );
voices_d = n_on;
ws_mid_d = ws_mlt;
ens_d0_d = sin(2 * $pi * EPS[0]) * dS_s + sin(2 * $pi * EPF[0]) * dF_s;
ens_d1_d = sin(2 * $pi * EPS[1]) * dS_s + sin(2 * $pi * EPF[1]) * dF_s;
ens_d2_d = sin(2 * $pi * EPS[2]) * dS_s + sin(2 * $pi * EPF[2]) * dF_s;
era_d = era_a;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;
ws_idle ? ( spl0 = 0;  spl1 = 0; ) : (

cr_n <= 0 ? ( cr_n = CR;  cr_tick(); );
cr_n -= 1;

k = 0;  loop(12, u_p = TOP[k] + TIC[k];  u_p >= 1024 ? u_p -= 1024;  TOP[k] = u_p;  k += 1; );

era_req ? (
  dk -= dk_st;
  dk <= 0 ? (
    dk = 0;  era_a = era_t;  era_req = 0;  era_targets();
    sh_s = sh_t;  vlp_s = vlp_t;  valp_s = valp_t;  clp_s = clp_t;  pkg_s = pkg_t;  vB_s = vB_t;  wlp_s = wlp_t;
    base_s = ens_base_t;  dS_s = dS_t;  dF_s = dF_t;  wid_s = wid_t;
    eg_s = eg_t;  cm_s = cm_t;  wood_s = wood_t;  fl_s = fl_t;  hn_s = hn_t;  bs_s = bs_t;  br_s = br_t;  ml_s = ml_t;  fm_s = fm_t;
    sw_s = sw_t;  echo_s = echo_t;
    !ens_ind ? ( EPS[1] = EPS[0] + 1 / 3;  EPS[2] = EPS[0] + 2 / 3;  EPF[1] = EPF[0] + 1 / 3;  EPF[2] = EPF[0] + 2 / 3; );
    ex_fl = era_a == 1;  ex_hn = era_a == 3;  ex_ch = era_a == 5;  ex_bs = era_a == 3 || era_a == 4;  ex_br = era_a == 4;
    LS0 = LS1 = LS2 = LS3 = 0;
    cr_tick();
  );
) : dk < 1 ? dk = min(1, dk + dk_st);

lvn_s += (lvn_t - lvn_s) * smk;  lva_s += (lva_t - lva_s) * smk;  lce_s += (lce_t - lce_s) * smk;
enon_s += (enon_t - enon_s) * smk;  mix_s += (mix_t - mix_s) * smk;  spm_s += (spm_t - spm_s) * smk;  out_g += (outg_t - out_g) * smk;
eg_s += (eg_t - eg_s) * smk;  cm_s += (cm_t - cm_s) * smk;  wood_s += (wood_t - wood_s) * smk;  fl_s += (fl_t - fl_s) * smk;
hn_s += (hn_t - hn_s) * smk;  bs_s += (bs_t - bs_s) * smk;  br_s += (br_t - br_s) * smk;  ml_s += (ml_t - ml_s) * smk;
fm_s += (fm_t - fm_s) * smk;  sw_s += (sw_t - sw_s) * smk;  echo_s += (echo_t - echo_s) * smk;

bAu = bBu = bAl = bCl = bFl = bHn = bMl = bFm = bBs = bBr = 0;
vb = VOX;  loop(NV, vb[F_ON] ? v_run(vb);  vb += VS; );

u_vn = fvl.svf(bAu + vB_s * bBu);
fpk.svf(u_vn);  u_vn += pkg_s * fpk.bp * fpk.k;
hpv += (u_vn - hpv) * hp_c;  u_vn -= hpv;
u_va = fva.svf(bAu);
u_ce = fce.svf(bCl + 0.5 * bAl);
u_st = u_vn * lvn_s + u_va * lva_s * lva_k + u_ce * lce_s * lvc_k * cm_s;
wood_s > 0.0005 ? ( fw1.svf(u_st);  fw2.svf(u_st);  u_st += wood_s * (fw1.bp * fw1.k * 1.1 + fw2.bp * fw2.k * 0.6); );
hn_s > 0.0005 ? ( fhn.svf(bHn);  u_st += fhn.lp * hn_s * 0.9; );
fl_s > 0.0005 ? ( flp += (bFl - flp) * fl_c;  u_st += flp * fl_s * 0.8; );
ml_s > 0.0005 || fm_s > 0.0005 ? (
  u_m = bMl * 0.8;  u_f = bFm * 0.8;
  fm0.svf(u_m);  fm1.svf(u_m);  fm2.svf(u_m);  ff0.svf(u_f);  ff1.svf(u_f);  ff2.svf(u_f);
  u_st += ml_s * (fm0.bp * fm0.k + 0.55 * fm1.bp * fm1.k + 0.3 * fm2.bp * fm2.k) * 1.6;
  u_st += fm_s * (ff0.bp * ff0.k + 0.55 * ff1.bp * ff1.k + 0.3 * ff2.bp * ff2.k) * 1.6;
);
sw_s > 0.0005 ? ( u_l = lad(u_st * 0.5) * 2.4 * (1 + sr_s * 0.6);  u_st += (u_l - u_st) * sw_s; );

EB[ew] = u_st;
u_dl = u_dr = 0;  k = 0;
loop(3,
  EPS[k] += ERS[k];  EPS[k] >= 1 ? EPS[k] -= 1;
  EPF[k] += ERF[k];  EPF[k] >= 1 ? EPF[k] -= 1;
  u_d = (base_s + dS_s * sin(2 * $pi * EPS[k]) + dF_s * sin(2 * $pi * EPF[k])) * 0.001 * srate;
  u_p = ew - u_d;  u_p < 0 ? u_p += EN;
  u_i = floor(u_p);  u_f2 = u_p - u_i;
  u_y = EB[u_i] + (EB[(u_i + 1) & (EN - 1)] - EB[u_i]) * u_f2;
  k == 0 ? ( u_dl += u_y * (1 + wid_s);  u_dr += u_y * (1 - wid_s); ) :
  k == 1 ? ( u_dl += u_y;  u_dr += u_y; ) :
           ( u_dl += u_y * (1 - wid_s);  u_dr += u_y * (1 + wid_s); );
  k += 1;
);
ew = (ew + 1) & (EN - 1);
wl1 += (u_dl * 0.45 - wl1) * wl_c;  wl2 += (wl1 - wl2) * wl_c;
wr1 += (u_dr * 0.45 - wr1) * wl_c;  wr2 += (wr1 - wr2) * wl_c;
u_em = mix_s * enon_s;
yl = u_st * (1 - u_em) + wl2 * u_em;
yr = u_st * (1 - u_em) + wr2 * u_em;

echo_s > 0.0005 ? (
  wo_p1 += 0.55 / srate;  wo_p1 -= floor(wo_p1);  wo_p2 += 6.3 / srate;  wo_p2 -= floor(wo_p2);
  u_w = 1 + e_wow * (0.01 * sin(2 * $pi * wo_p1) + 0.0018 * sin(2 * $pi * wo_p2));
  TB[tw] = (yl + yr) * 0.5 + tfb;
  u_e1 = u_e2 = u_e3 = 0;  k = 1;
  loop(3,
    u_p = tw - (0.062 * k + 0.004 * (k == 2)) * srate * u_w;  u_p < 0 ? u_p += TN;
    u_i = floor(u_p);  u_f2 = u_p - u_i;
    u_y = TB[u_i] + (TB[(u_i + 1) % TN] - TB[u_i]) * u_f2;
    k == 1 ? u_e1 = u_y : k == 2 ? u_e2 = u_y : u_e3 = u_y;
    k += 1;
  );
  tw = (tw + 1) % TN;
  tlp += (u_e3 - tlp) * (1 - exp(-2 * $pi * 3000 / srate));
  tfb = ts(tlp * 1.2) * 0.26;
  yl += (u_e1 + 0.6 * u_e3) * echo_s * 0.75;
  yr += (u_e2 + 0.6 * u_e3) * echo_s * 0.75;
);

bs_s > 0.0005 ? ( fbs.svf(bBs);  u_b = ts(fbs.lp * 0.9) * bs_s * 0.9;  yl += u_b;  yr += u_b; );
br_s > 0.0005 ? ( fbr.svf(bBr);  u_b = fbr.lp * br_s * 0.55;  yl += u_b;  yr += u_b * 0.92; );

dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
yl *= out_g * eg_s;  yr *= out_g * eg_s;
pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;
sp_live ? (
  bv_pre(yl, yr);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, 0.62);
  fdn_run(dif_l, dif_r);
  yl += fdn_l * 0.55 * spm_s;  yr += fdn_r * 0.55 * spm_s;
);
pwr_out(yl, yr);  yl = pwr_l * dk;  yr = pwr_r * dk;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;
);

@serialize
