    vamix = 0; aA = 0.001; aD = 0.2; aS = 0; aR = 0.6; chor = 0.6; lvl = 0.6; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.35;
    ks_lvl = 0.8; ks_T = 3; ks_br = 0.5; ks_pick = 0;
    bl_lvl = 0.5; bR0 = 1; bR1 = 2.32; bR2 = 4.1; bR3 = 6.7; bA0 = 1; bA1 = 0.5; bA2 = 0.3; bA3 = 0.15; bD0 = 2.5; bD1 = 1.4; bD2 = 0.8; bD3 = 0.4;
  ) : s == 58 ? (  // BASS MARIMBA: wooden bars tuned 1 : 4 : 10, a soft mallet thump
    vamix = 0; aA = 0.001; aD = 0.1; aS = 0; aR = 0.3; chf = 0.15; chor = 0.2; lvl = 0.7;
    bl_lvl = 1; bR0 = 1; bR1 = 3.99; bR2 = 9.9; bR3 = 2; bA0 = 1; bA1 = 0.35; bA2 = 0.1; bA3 = 0.08; bD0 = 1.2; bD1 = 0.35; bD2 = 0.12; bD3 = 0.6;
  ) : s == 59 ? (  // GAMELAN BELL: bronze - inharmonic partials that ring and shimmer
    vamix = 0; aA = 0.001; aD = 0.1; aS = 0; aR = 0.6; chf = 0.1; chor = 0.6; lvl = 0.6;
    bl_lvl = 1; bR0 = 1; bR1 = 2.76; bR2 = 4.07; bR3 = 5.43; bA0 = 1; bA1 = 0.5; bA2 = 0.35; bA3 = 0.2; bD0 = 4; bD1 = 2.5; bD2 = 1.5; bD3 = 1;
  ) : s == 60 ? (  // VIBRAPHONE: soft mallets on metal bars, the motor's tremolo (retro 60s)
    vamix = 0; aA = 0.001; aD = 0.1; aS = 0; aR = 0.5; chf = 0.06; trem = 0.35; chor = 0.25; lvl = 0.6;
    bl_lvl = 1; bR0 = 1; bR1 = 4; bR2 = 10; bR3 = 3; bA0 = 1; bA1 = 0.25; bA2 = 0.06; bA3 = 0; bD0 = 3.5; bD1 = 1; bD2 = 0.3; bD3 = 0.2;
  ) : s == 61 ? (  // EASTERN BELLS: near-harmonic temple bells over a soft sine strike, with echo
    o1w = 1; o2l = 0; det = 0; vamix = 0.2; fbase = 3000; famt = 0.2; fres = 0; aA = 0.002; aD = 1.5; aS = 0; aR = 0.6; fA = 0.01; fD = 1; fS = 0.8;
    chf = 0.08; chor = 0.5; lvl = 0.55; dl_mix = 0.2; dl_bt = 1; dl_fb = 0.35;
    bl_lvl = 0.9; bR0 = 1; bR1 = 2; bR2 = 3.01; bR3 = 5.2; bA0 = 1; bA1 = 0.6; bA2 = 0.4; bA3 = 0.2; bD0 = 3; bD1 = 2; bD2 = 1.2; bD3 = 0.6;
  ) : s == 62 ? (  // SYN MARIMBA: the 80s analogue marimba - a filtered square that snaps shut
    o1w = 2; o2l = 0; det = 0; fbase = 900; famt = 2; fres = 0.3; ktrk = 0.8; aA = 0.001; aD = 0.25; aS = 0; aR = 0.15; fA = 0.001; fD = 0.12; fS = 0;
    chor = 0.5; lvl = 0.5;
    bl_lvl = 0.4; bR0 = 1; bR1 = 4; bR2 = 10; bR3 = 2; bA0 = 1; bA1 = 0.3; bA2 = 0; bA3 = 0; bD0 = 0.4; bD1 = 0.1; bD2 = 0.05; bD3 = 0.05;
  ) : s == 63 ? (  // TINE WAVE: a digital tine - bright high partials over a sine body
    o1w = 1; o2l = 0; det = 0; vamix = 0.4; fbase = 3000; famt = 0.2; fres = 0; aA = 0.002; aD = 2; aS = 0.3; aR = 0.5; fA = 0.01; fD = 1; fS = 0.8;
    chor = 0.7; lvl = 0.5;
    bl_lvl = 0.6; bR0 = 1; bR1 = 2; bR2 = 7.1; bR3 = 13.8; bA0 = 1; bA1 = 0.4; bA2 = 0.3; bA3 = 0.2; bD0 = 2.5; bD1 = 1.5; bD2 = 0.2; bD3 = 0.08;
  ) : s == 64 ? (  // SYNTHETIC ELECTRIC: the FM e-piano with more bark and tine, chorused
    fm_bark = 1.3; fm_tine = 1.4; fm_dk = 1.1; chor = 0.6; lvl = 1;
  ) : s == 65 ? (  // PCM E-PIANO: a clean electric piano - gentle bark, a soft tine, long
    fm_bark = 0.6; fm_tine = 0.7; fm_dk = 1.2; chor = 0.3; lvl = 1;
  ) : s == 66 ? (  // PIANO FIFTY: the bright house piano
    pn_hard = 0.8; pn_T = 0.75; pn_uni = 1.4; pn_knock = 1.2; chor = 0.4; lvl = 0.45;
  ) : s == 67 ? (  // PIANISSIMO: a soft, round synthesised piano
    pn_hard = 0.45; pn_T = 1.2; pn_uni = 0.9; pn_knock = 0.7; chor = 0.15; lvl = 0.55;
  ) : s == 68 ? (  // HARPSICHORD STABS: a bright picked string with a saw stab (fusion)
    det = 0.006; o2l = 0.8; fbase = 700; famt = 3; fres = 0.2; aA = 0.001; aD = 0.3; aS = 0.15; aR = 0.2; fA = 0.001; fD = 0.2; fS = 0.1;
    vamix = 0.7; chor = 0.5; lvl = 0.45;
    ks_lvl = 1; ks_T = 1.5; ks_br = 0.9; ks_pick = 1;
  ) : s == 69 ? (  // SLOW ROTOR: drawbar organ with percussion, the rotor turning slowly
    org_reg = 0; org_perc = 0.5; chor = 0.7; crate = 0.8; lvl = 0.3;
  ) : s == 70 ? (  // ROCK ORGAN: every drawbar out, fast rotor
    org_reg = 1; chor = 0.8; crate = 6.2; lvl = 0.25;
  ) : s == 71 ? (  // CATHEDRAL ORGAN: a principal chorus with mixture; the pipes speak and die away slowly
    org_reg = 2; org_at = 0.06; org_rt = 0.5; org_clk = 0.4; chor = 0; lvl = 0.25;
  ) : s == 72 ? (  // SYN-HARMONIUM: a reed organ, two reeds beating slowly - hypnotic
    org_reg = 3; org_at = 0.05; org_rt = 0.15; org_clk = 0; chor = 0.9; crate = 0.5; lvl = 0.3;
  // ---------- K50 checkpoint 4: guitars, brass, leads and flutes, a bass, effects ----------
  ) : s == 73 ? (  // GRIITTTARR: a picked electric string driven hard, over a saw body
    det = 0.004; fbase = 1200; famt = 0.6; fres = 0.1; aA = 0.002; aD = 1; aS = 0.5; aR = 0.3; fA = 0.01; fD = 0.8; fS = 0.6;
    vamix = 0.3; chor = 0.5; lvl = 0.45; dl_mix = 0.15; dl_bt = 0.75; dl_fb = 0.3;
    ks_lvl = 1; ks_T = 2.5; ks_br = 0.7; ks_pick = 1; ks_bite = 1;
  ) : s == 74 ? (  // BREATHY CHIFFER: the LA solo voice - a breathy pipe with a strong chiff
    o1w = 1; o2w = 1; o2l = 0.3; det = 0; fbase = 2500; famt = 0.3; fres = 0.05; ktrk = 0.7; aA = 0.03; aD = 1; aS = 0.95; aR = 0.3; fA = 0.04; fD = 1; fS = 0.9;
    br_lvl = 0.18; brp = 1; chf = 0.25; vib = 5.5; vibd = 0.6; mono = 1; glide = 0.03; chor = 0.5; lvl = 0.4; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.3;
  ) : s == 75 ? (  // SLAP BRASS: half slap bass, half brass
    det = 0.004; o2l = 0.8; subl = 0.5; fbase = 250; famt = 3.5; fres = 0.25; ktrk = 0.5; aA = 0.002; aD = 0.4; aS = 0.6; aR = 0.2; fA = 0.001; fD = 0.25; fS = 0.3;
    pe_amt = -0.5; pe_t = 0.05; vf = 0.6; chor = 0.3; lvl = 0.4;
    ks_lvl = 0.6; ks_T = 0.6; ks_br = 0.8; ks_pick = 1;
  ) : s == 76 ? (  // RICH BRASS: a full synth brass section
    det = 0.008; o2l = 1; subl = 0.2; fbase = 350; famt = 2.4; fres = 0.12; aA = 0.05; aD = 0.7; aS = 0.85; aR = 0.35; fA = 0.1; fD = 0.7; fS = 0.5;
    pe_amt = -0.4; pe_t = 0.05; vib = 5; vibd = 0.3; chor = 0.7; three = 1; lvl = 0.32;
  ) : s == 77 ? (  // PIPE SOLO: a flute that chases itself (the echo follows each phrase)
    o1w = 1; o2l = 0; det = 0; fbase = 3000; famt = 0.3; fres = 0; aA = 0.06; aD = 1; aS = 0.9; aR = 0.3; fA = 0.08; fD = 1; fS = 0.9;
    br_lvl = 0.2; brp = 1; chf = 0.2; vib = 5.2; vibd = 0.6; mono = 1; glide = 0.05; chor = 0.4; lvl = 0.45; dl_mix = 0.3; dl_bt = 0.375; dl_fb = 0.3;
  ) : s == 78 ? (  // SHAMUS THEME: a fusion solo synth - saw and square, resonant, a scoop into each note
    det = 0.005; o2w = 1; o2l = 0.7; fbase = 700; famt = 2.2; fres = 0.35; ktrk = 0.5; aA = 0.005; aD = 0.8; aS = 0.7; aR = 0.25; fA = 0.005; fD = 0.5; fS = 0.4;
    pe_amt = -1; pe_t = 0.04; vib = 5.5; vibd = 0.5; mono = 1; glide = 0.06; chor = 0.4; lvl = 0.35; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.3;
  ) : s == 79 ? (  // FLUTISH BRASS: a soft brassy solo with a flute's breath
    o1w = 1; o2l = 0.5; det = 0.004; fbase = 1200; famt = 1.2; fres = 0.1; aA = 0.05; aD = 0.6; aS = 0.8; aR = 0.3; fA = 0.08; fD = 0.6; fS = 0.5;
    br_lvl = 0.1; brp = 1; chf = 0.1; vib = 5.2; vibd = 0.5; mono = 1; glide = 0.03; chor = 0.5; lvl = 0.4;
  ) : s == 80 ? (  // HOLLOWED HARP: a harp with a hollow, woody body - a soft pluck ringing over a decaying square (polyphonic)
    vamix = 0.4; o1w = 2; o2l = 0.35; det = 0.003; fbase = 900; famt = 2; fres = 0.1; ktrk = 0.5;
    aA = 0.002; aD = 1.6; aS = 0; aR = 0.8; fA = 0.001; fD = 0.35; fS = 0;
    chor = 0.6; lvl = 0.42; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.35;
    ks_lvl = 0.8; ks_T = 2.4; ks_br = 0.35; ks_pick = 0;
  ) : s == 81 ? (  // SHAKUHACHI: a breathy bamboo flute - an overblown puff and a scoop up into the note
    o1w = 1; o2l = 0; det = 0; fbase = 2000; famt = 0.3; fres = 0; aA = 0.09; aD = 1; aS = 0.9; aR = 0.35; fA = 0.1; fD = 1; fS = 0.9;
    br_lvl = 0.35; brp = 1; chf = 0.45; pe_amt = -0.8; pe_t = 0.12; vib = 5; vibd = 0.7; chor = 0.2; lvl = 0.45; dl_mix = 0.2; dl_bt = 1; dl_fb = 0.3;
  ) : s == 82 ? (  // PICKED GUITAR: a picked steel string over a soft body
    o1w = 1; o2l = 0; det = 0; fbase = 1500; famt = 0.3; fres = 0; aA = 0.2; aD = 2; aS = 0.4; aR = 0.6; fA = 0.2; fD = 1; fS = 0.6;
    vamix = 0.15; chf = 0.1; chor = 0.6; lvl = 0.55;
    ks_lvl = 1; ks_T = 2.4; ks_br = 0.65; ks_pick = 1;
  ) : s == 83 ? (  // NIGHTMARE: a powerful digital drone that sinks, with clanging partials and a long echo
    det = 0.02; o2w = 1; o2l = 1; subl = 0.8; fbase = 300; famt = 2; fres = 0.6; aA = 0.3; aD = 1; aS = 0.95; aR = 2.5; fA = 3; fD = 4; fS = 0.3; flfo = 0.8;
    pe_amt = 7; pe_t = 1.5; trem = 0.2; chor = 1.2; lvl = 0.25; dl_mix = 0.35; dl_bt = 1.5; dl_fb = 0.55;
    bl_lvl = 0.5; bR0 = 1; bR1 = 1.41; bR2 = 2.83; bR3 = 3.9; bA0 = 1; bA1 = 0.6; bA2 = 0.4; bA3 = 0.3; bD0 = 3; bD1 = 2; bD2 = 1.5; bD3 = 1;
  ) : s == 84 ? (  // VELO-BRASS: the classic synth brass - playing harder opens it up
    det = 0.006; o2l = 0.9; fbase = 260; famt = 3.2; fres = 0.15; aA = 0.02; aD = 0.5; aS = 0.8; aR = 0.3; fA = 0.06; fD = 0.6; fS = 0.4;
    vf = 0.8; chor = 0.5; lvl = 0.36;
  ) : s == 85 ? (  // INTRUDER FX: alien - a resonant square that climbs two octaves into a ringing cloud
    o1w = 2; o2l = 1; det = 0.03; fbase = 600; famt = 2.5; fres = 0.75; aA = 0.5; aD = 1; aS = 0.95; aR = 3; fA = 2; fD = 3; fS = 0.2; flfo = 1.2;
    pe_amt = -24; pe_t = 2.5; trem = 0.4; chor = 1.5; lvl = 0.25; dl_mix = 0.4; dl_bt = 0.75; dl_fb = 0.6;
    bl_lvl = 0.6; bR0 = 0.5; bR1 = 1.73; bR2 = 3.1; bR3 = 5.9; bA0 = 1; bA1 = 0.6; bA2 = 0.4; bA3 = 0.3; bD0 = 4; bD1 = 3; bD2 = 2; bD3 = 1;
  ) : s == 86 ? (  // STEEL PICK: a spiky synth - a hard pick on a metal string over a snapping saw
    det = 0.01; o2l = 1; fbase = 900; famt = 3; fres = 0.3; aA = 0.001; aD = 0.35; aS = 0.2; aR = 0.25; fA = 0.001; fD = 0.15; fS = 0.05;
    vamix = 0.8; chor = 0.7; lvl = 0.4; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.3;
    ks_lvl = 0.8; ks_T = 0.8; ks_br = 0.95; ks_pick = 1;
  ) : s == 87 ? (  // SYNTH BASS: mega-powerful and digital - square, saw and sub, a bright digital edge on each note
    o1w = 2; o2l = 1; det = 0.004; subl = 1; fbase = 180; famt = 3.5; fres = 0.4; ktrk = 0.3; aA = 0.002; aD = 0.5; aS = 0.8; aR = 0.12; fA = 0.001; fD = 0.22; fS = 0.2;
    mono = 1; glide = 0.02; chor = 0; lvl = 0.5;
    bl_lvl = 0.5; bR0 = 1; bR1 = 2; bR2 = 3; bR3 = 5; bA0 = 1; bA1 = 0.6; bA2 = 0.4; bA3 = 0.3; bD0 = 0.2; bD1 = 0.15; bD2 = 0.1; bD3 = 0.05;
  ) : s == 88 ? (  // BONES: a trombone - slides between notes, a brassy blat, a little breath
    det = 0.003; o2l = 0.6; fbase = 300; famt = 2.2; fres = 0.1; ktrk = 0.6; aA = 0.08; aD = 0.7; aS = 0.85; aR = 0.2; fA = 0.12; fD = 0.8; fS = 0.5;
    pe_amt = -1; pe_t = 0.08; vib = 4.8; vibd = 0.4; br_lvl = 0.04; chf = 0.06; mono = 1; glide = 0.08; chor = 0.2; lvl = 0.38;
  ) : s == 89 ? (  // BOTTLE BLOWER: breath across a bottle's neck, a long echo (New Age)
    o1w = 1; o2l = 0; det = 0; fbase = 1800; famt = 0.3; fres = 0; aA = 0.15; aD = 1; aS = 0.9; aR = 0.5; fA = 0.15; fD = 1; fS = 0.9; flfo = 0.2;
    br_lvl = 0.45; brp = 1; chf = 0.3; vib = 4.5; vibd = 0.4; chor = 0.6; lvl = 0.5; dl_mix = 0.3; dl_bt = 1; dl_fb = 0.45;
  // ---------- K50 checkpoint 5: splits - the left hand below C4 plays the lower part ----------
  ) : s == 90 ? (  // JAZZ GUITAR DUO: an upright bass on the left, a warm jazz guitar on the right
    o1w = 1; o2l = 0; det = 0; fbase = 900; famt = 0.2; fres = 0; aA = 0.1; aD = 1.5; aS = 0.3; aR = 0.4; fA = 0.1; fD = 1; fS = 0.8;
    vamix = 0.25; chor = 0.2; lvl = 0.6;
    ks_lvl = 1; ks_T = 1.8; ks_br = 0.35; ks_pick = 0;
    spl_on = 1; lw_type = 1; lw_lvl = 0.39;
  ) : s == 91 ? (  // FLUTE-PIANO DUO: an electric piano on the left, a breathy flute on the right
    o1w = 1; o2l = 0; det = 0; fbase = 3000; famt = 0.3; fres = 0; aA = 0.07; aD = 1; aS = 0.9; aR = 0.3; fA = 0.08; fD = 1; fS = 0.9;
    br_lvl = 0.2; brp = 1; chf = 0.15; vib = 5.2; vibd = 0.5; chor = 0.4; lvl = 0.45;
    spl_on = 1; lw_type = 4; lw_lvl = 1.64;
  ) : s == 92 ? (  // BASIN BLUES: an electric bass on the left, a clean chorused electric guitar on the right
    o1w = 1; o2l = 0; det = 0; fbase = 1200; famt = 0.2; fres = 0; aA = 0.2; aD = 2; aS = 0.4; aR = 0.5; fA = 0.2; fD = 1; fS = 0.7;
    vamix = 0.1; chf = 0.06; chor = 0.8; lvl = 0.55; dl_mix = 0.15; dl_bt = 0.75; dl_fb = 0.3;
    ks_lvl = 1; ks_T = 2.2; ks_br = 0.6; ks_pick = 1;
    spl_on = 1; lw_type = 2; lw_lvl = 0.28;
  ) : s == 93 ? (  // CIRCLE SESSION: a log drum on the left, a bamboo flute on the right
    o1w = 1; o2l = 0; det = 0; fbase = 2200; famt = 0.3; fres = 0; aA = 0.08; aD = 1; aS = 0.9; aR = 0.3; fA = 0.1; fD = 1; fS = 0.9;
    br_lvl = 0.28; brp = 1; chf = 0.3; pe_amt = -0.5; pe_t = 0.1; vib = 5; vibd = 0.6; chor = 0.3; lvl = 0.45; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.3;
    spl_on = 1; lw_type = 5; lw_lvl = 1.86;
  ) : s == 94 ? (  // E-BASS AND E-PIANO: the standard split - electric bass left, FM e-piano right
    chor = 0.5; lvl = 1;
    spl_on = 1; lw_type = 2; lw_lvl = 1.12;
  ) : s == 95 ? (  // SLAP BASS N BRASS: a slap bass left, a powerful two-oscillator synth brass right
    det = 0.006; o2l = 1; fbase = 300; famt = 3; fres = 0.15; aA = 0.02; aD = 0.5; aS = 0.8; aR = 0.3; fA = 0.06; fD = 0.5; fS = 0.45;
    vf = 0.6; chor = 0.5; lvl = 0.36;
    spl_on = 1; lw_type = 3; lw_lvl = 1.24;
  );
  // LA retunes: closer to the classic layered presets
  s == 9 ? ( dl_mix = 0.3; dl_bt = 0.75; dl_fb = 0.4; );                       // STACCATO GLASS: its echo
  s == 10 ? ( ks_br = 0.65; bl_lvl = 0.3; dl_mix = 0.12; dl_bt = 0.5; dl_fb = 0.25; );   // PIZZ FLOW: brighter pluck
  s == 12 ? ( dl_mix = 0.15; dl_bt = 1; dl_fb = 0.3; );                         // NYLON ATMOS
  // the choir's vowels
  form == 1 ? ( fA1.svf_set(730, 5); fA2.svf_set(1090, 7); fA3.svf_set(2440, 9); ) :
  form == 2 ? ( fA1.svf_set(320, 5); fA2.svf_set(800, 6); fA3.svf_set(2300, 8); ) :
  form == 3 ? ( fA1.svf_set(530, 5); fA2.svf_set(1840, 7); fA3.svf_set(2480, 9); );
);

// ---------- plucked string: set up and run (clav and the pluck layers) ----------
function ks_setup(v, b, f0, vg, h, Ts, bright, pick) local(L, x, j, rr, x2_) (
  L = srate / f0;
  b[F_KL] = L; b[F_KW] = floor(L); b[F_KLP] = 0; b[F_KAP] = 0; b[F_KHP] = 0; b[F_KX] = 0; b[F_O3] = 1;
  b[F_KG] = 10 ^ (-3 / (Ts * f0));
  b[F_KPO] = pick ? max(floor(L * 0.13), 1) : 0;
  x = 0; x2_ = 0; j = 0;
  loop(min(ceil(L) + 2, KSL),
    rr = rand(2) - 1; x += (rr - x) * (bright * (0.3 + 0.7 * h));   // softer pluck when played gently
    x2_ += (x - x2_) * 0.6;
    KSB[v * KSL + j] = x2_ * vg * 0.45 * sin($pi * min(j / L, 1)) * (j < L * 0.5 ? 1 : 0.7);
    j += 1;
  );
);
function ks_tick(av, b, pick, bite) local(lc_, L, Li, fr, w_, ofs, rp, sv, ac, ap, lpv, gk, pq, y) (
  lc_ = 0.72 + 0.26 * tone;                                   // loop brightness
  L = b[F_KL] / pdrift - (1 - lc_) / lc_;                     // minus the loop filter delay
  Li = floor(L); fr = L - Li; fr < 0.1 ? ( Li -= 1; fr += 1; );
  w_ = b[F_KW]; ofs = av * KSL;
  rp = w_ - Li; rp < 0 ? rp += KSL;
  sv = KSB[ofs + rp];
  ac = (1 - fr) / (1 + fr);                                   // fractional delay (first-order allpass)
  ap = ac * sv + b[F_KX] - ac * b[F_KAP];
  b[F_KX] = sv; b[F_KAP] = ap;
  lpv = b[F_KLP] + (ap - b[F_KLP]) * lc_;
  b[F_KLP] = lpv;
  gk = held ? b[F_KG] : b[F_KG] * 0.8;                       // the damper: a fast stop when the key lifts
  KSB[ofs + w_] = lpv * gk;
  b[F_KW] = (w_ + 1) % KSL;
  pick ? ( pq = w_ - b[F_KPO]; pq < 0 ? pq += KSL; y = sv - KSB[ofs + pq]; ) : y = sv;
  b[F_KHP] += (y - b[F_KHP]) * 0.02; y -= b[F_KHP];
  y = bite ? tanh_(y * 1.5) * 3.5 : y * 2.2;
  b[F_O3] = b[F_O3] * 0.9995 + abs(y) * 0.0005;              // level tracker
  y;
);
// bell partials (glockenspiel and the bell layers)
function bell_set(b, f0, vg, h, ratio, amp, dk, k) local(w) (
  w = 2 * $pi * min(f0 * ratio, srate * 0.45) / srate;
  b[F_MS + k] = 0; b[F_MC + k] = 1; b[F_MWS + k] = sin(w); b[F_MWC + k] = cos(w);
  b[F_MA + k] = f0 * ratio < srate * 0.45 ? amp : 0; b[F_MD + k] = tc(dk);
);
function bell_tick(b, rel) local(k, s_, y) (
  k = 0; y = 0; bell_amp = 0;
  loop(4,
    s_ = b[F_MS + k] * b[F_MWC + k] + b[F_MC + k] * b[F_MWS + k];
    b[F_MC + k] = b[F_MC + k] * b[F_MWC + k] - b[F_MS + k] * b[F_MWS + k];
    b[F_MS + k] = s_;
    b[F_MA + k] *= b[F_MD + k] * rel;
    y += s_ * b[F_MA + k]; bell_amp += b[F_MA + k];
    k += 1;
  );
  y;
);

// 16-partial bank (synthetic piano, drawbar organ)
function pn_set(b, k, f, amp, T) local(w) (
  w = 2 * $pi * min(f, srate * 0.45) / srate;
  b[P_MS + k] = 0; b[P_MC + k] = 1; b[P_WS + k] = sin(w); b[P_WC + k] = cos(w);
  b[P_MA + k] = f < srate * 0.45 ? amp : 0; b[P_MD + k] = T > 0 ? tc(T) : 1;
);
function pn_tick(b, rel) local(k, s_, y) (
  k = 0; y = 0; pn_amp = 0;
  loop(16,
    b[P_MA + k] > 0.00001 ? (
      s_ = b[P_MS + k] * b[P_WC + k] + b[P_MC + k] * b[P_WS + k];
      b[P_MC + k] = b[P_MC + k] * b[P_WC + k] - b[P_MS + k] * b[P_WS + k];
      b[P_MS + k] = s_;
      b[P_MA + k] *= b[P_MD + k] * rel;
      y += s_ * b[P_MA + k]; pn_amp += b[P_MA + k];
    );
    k += 1;
  );
  y;
);
// the oscillator pairs drift in amplitude after many cycles: renormalise once a block
function pn_norm(b) local(k, m) (
  k = 0; loop(16, m = sqrt(sqr(b[P_MS + k]) + sqr(b[P_MC + k])); m > 0 ? ( b[P_MS + k] /= m; b[P_MC + k] /= m; ); k += 1; );
);

// ---------- voices ----------
function vfree() local(v, best, ba) (
  best = -1; v = 0;
  loop(cnv, best < 0 && !cvb[v * VS + F_ACT] ? best = v; v += 1; );
  best < 0 ? ( ba = 1000000000; v = 0; loop(cnv, (cvb[v * VS + F_AGE] + (cvb[v * VS + F_G] ? 100000000 : 0)) < ba ? ( ba = cvb[v * VS + F_AGE] + (cvb[v * VS + F_G] ? 100000000 : 0); best = v; ); v += 1; ); );
  best;
);

function note_on(n, vel) local(v, b, f0, vg, h, Tn, j, k, L, x, rr, ratio, amp, dk, w, was, hd, Bc) (
  f0 = 440 * 2 ^ ((n - 69) / 12) * tune * (eng != 0 ? ins_note_detune() : 1);   // (DRIFT: each note a little out)
  vg = (1 - sens) + sens * (vel / 127) ^ 1.3;
  h = vel / 127;
  mono && eng == 0 ? (
    v = 0;                                   // mono: always voice 0, glide from the last note
    b = cvb;
    b[F_DCF] = 1; !b[F_ACT] ? ( b[F_PY] = 0; b[F_PY2] = 0; b[F_DCO] = 0; ); b[F_ATK] = 1;
    mono_n >= 0 && b[F_ACT] && b[F_AE] > 0.01 ? ( b[F_F0] = f0; b[F_G] = 1; b[F_N] = n; b[F_VEL] = vg; mono_n = n; ) : (
      was = b[F_ACT];                        // still ringing: rise from where it is
      b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0; mono_f = f0;
      b[F_DT] = 1; b[F_VT] = 0; !was ? ( b[F_AE] = 0; b[F_FE] = 0; );
      b[F_AST] = 0; b[F_FST] = 0; mono_n = n;
    );
  ) : (
  // re-strike the same key on the same voice, else a free / old one
  v = -1; k = 0; loop(cnv, cvb[k * VS + F_N] == n && cvb[k * VS + F_ACT] ? v = k; k += 1; );
  v < 0 ? v = vfree();
  b = cvb + v * VS;
  age += 1; b[F_AGE] = age;
  was = b[F_ACT];                                          // re-struck / reused while still sounding?
  b[F_DCF] = 1; !was ? ( b[F_PY] = 0; b[F_PY2] = 0; b[F_DCO] = 0; );
  b[F_ATK] = eng == 0 && ks_lvl == 0 && bl_lvl == 0 ? 1 : 0;   // struck / plucked sounds get a short fade-in
  b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0;
  b[F_DT] = ins_note_detune();                              // each note slightly out (GFX drift)
  b[F_E1] = 0;
  b[F_AST] = 0; b[F_FST] = 0; b[F_VT] = 0; !was ? b[F_FE] = 0;
  eng == 0 ? (
    // a sounding voice keeps its oscillators and rises from where it is; a fresh one starts clean
    !was ? ( b[F_P1] = rand(1); b[F_P2] = rand(1); b[F_P3] = rand(1); b[F_AE] = 0; b[F_O1] = 0; b[F_O2] = 0; b[F_O3] = 0; );
    // attack / extra layers
    Tn = 2 ^ (-(n - 72) / 24) * dec_k;
    k = 0; loop(4, b[F_MA + k] = 0; k += 1; );
    bl_lvl > 0 && !nd ? (
      bell_set(b, f0, vg, h, bR0, vg * bl_lvl * bA0,              bD0 * Tn, 0);
      bell_set(b, f0, vg, h, bR1, vg * bl_lvl * bA1 * (0.5 + h), bD1 * Tn, 1);
      bell_set(b, f0, vg, h, bR2, vg * bl_lvl * bA2 * (0.4 + h), bD2 * Tn, 2);
      bell_set(b, f0, vg, h, bR3, vg * bl_lvl * bA3 * (0.3 + h), bD3 * Tn, 3);
    );
    ks_lvl > 0 ? ks_setup(v + cks, b, f0, vg * ks_lvl, h, ks_T * 2 ^ (-(n - 60) / 24) * dec_k, ks_br, ks_pick);
    b[F_CLK] = chf * vg;
    b[F_PE] = pe_amt;
  ) : eng == 4 ? (
    // synthetic piano: stretched partials, two strings each (a quick prompt string and a slower, detuned
    // after-ring one); velocity sets the hammer: brightness, loudness, knock and how fast the top fades
    Tn = 7 * pn_T * 2 ^ (-(n - 40) / 17) * dec_k;
    hd = min(max(pn_hard * (0.15 + 1.15 * h ^ 1.2) + (tone - 0.5) * 0.5, 0.05), 1.15);
    vg = (1 - min(sens * 1.3, 1)) + min(sens * 1.3, 1) * h * h;     // a wider dynamic range than the synths
    Bc = 0.00025 * 2 ^ ((n - 60) / 20);
    k = 0;
    loop(8,
      j = k + 1;
      ratio = j * sqrt(1 + Bc * j * j);
      amp = vg * j ^ -0.85 * hd ^ ((j - 1) * 0.75) * (0.35 + 0.65 * abs(sin($pi * j * 0.13)) );
      dk = Tn / (1 + 0.45 * (j - 1) * (0.6 + 0.8 * h));
      pn_set(b, k * 2,     f0 * ratio,                                   amp * 0.72, dk * 0.42);
      pn_set(b, k * 2 + 1, f0 * ratio * 2 ^ ((0.9 + 0.5 * k) * pn_uni / 1200), amp * 0.38, dk * 1.5);
      k += 1;
    );
    b[F_CLK] = pn_knock * (0.05 + 0.3 * h * h) * vg;       // the hammer's knock
    b[F_HN] = 0; b[F_HL] = 0; b[F_AE] = 1;
  ) : eng == 5 ? (
    // drawbar organ: 16' 8' 5 1/3' 4' + a little 2 2/3' and 2', third-harmonic percussion on fresh chords
    k = 0;
    loop(9,
      ratio = k == 0 ? 0.5 : k == 1 ? 1 : k == 2 ? 1.5 : k == 3 ? 2 : k == 4 ? 3 : k == 5 ? 4 : k == 6 ? 5 : k == 7 ? 6 : 8;
      amp = ORG[org_reg * 9 + k];                        // the registration (drawbars / stops)
      pn_set(b, k, f0 * ratio, amp * vg * 0.5, 0);
      k += 1;
    );
    pn_set(b, 9, f0 * 3, org_perc * (nact == 0 ? 1 : 0.3) * vg * 0.6, 0.35);
    b[F_CLK] = 0.15 * vg * org_clk;                       // key click
    !was || org_at <= 0.001 ? b[F_AE] = org_at > 0.001 ? 0 : 1;   // pipes and reeds take a moment to speak
    b[F_HN] = 0; b[F_HL] = 0;
  ) :
  eng == 1 ? (
    // FM e-piano: carriers C1 (body) and C3 (tine), modulators M2 (ratio 1) and M4 (ratio 14)
    !was ? ( b[F_O1] = 0; b[F_O2] = 0; b[F_O3] = 0; b[F_O4] = 0; );
    Tn = 4.5 * fm_dk * 2 ^ (-(n - 48) / 20);
    b[F_E1] = vg; b[F_E2] = (0.9 + 1.6 * h) * fm_bark; b[F_E3] = vg * 0.55; b[F_E4] = (0.6 + 2.2 * h * h) * fm_tine;
    b[F_MD] = tc(Tn * dec_k); b[F_MD + 1] = tc(Tn * 0.35 * dec_k); b[F_MD + 2] = tc(Tn * 0.4 * dec_k); b[F_MD + 3] = tc(0.09 + 0.05 * (1 - h));
    b[F_AE] = 1;
  ) : eng == 2 ? (
    // clav: a bright pluck, pickup near the string's end
    ks_setup(v + cks, b, f0, vg, h, 4 * 2 ^ (-(n - 48) / 24) * dec_k, 0.4, 1);
    b[F_AE] = 1;
  ) : (
    // glockenspiel bar: 4 inharmonic partials
    Tn = 3.2 * 2 ^ (-(n - 72) / 24) * dec_k;
    k = 0;
    loop(4,
      ratio = k == 0 ? 1 : k == 1 ? 2.756 : k == 2 ? 5.404 : 8.933;
      amp = vg * (k == 0 ? 1 : k == 1 ? 0.22 + 0.25 * h : k == 2 ? 0.08 + 0.15 * h : 0.04 + 0.08 * h);
      dk = Tn * (k == 0 ? 1 : k == 1 ? 0.35 : k == 2 ? 0.14 : 0.07);
      bell_set(b, f0, vg, h, ratio, amp, dk, k);
      k += 1;
    );
    b[F_CLK] = vg * (0.1 + 0.15 * h);                      // mallet click (soft)
    b[F_AE] = 1;
  );
  // DRIFT: each attack transient a little different (hammer, mallet, chiff, tine bark, the upper bell partials)
  ntv = 1 + (rand(2) - 1) * 0.3 * dm_a;
  b[F_CLK] *= ntv;
  eng == 1 ? b[F_E4] *= ntv : ( k = 1; loop(3, b[F_MA + k] *= ntv; k += 1; ); );
  );
  lastb = b;
);
function note_off(n) local(v, b) (
  v = 0; loop(cnv, b = cvb + v * VS; b[F_N] == n && b[F_G] ? ( b[F_G] = 0; b[F_S] = pedal; ); v += 1; );
  mono && n == mono_n ? mono_n = -1;
);
function pedal_set(on) local(v) ( pedal = on; !on ? ( v = 0; loop(NV + LWN, VB[v * VS + F_S] = 0; v += 1; ); v = 0; loop(NA, AVB[v * VS + F_S] = 0; v += 1; ); ); );
function all_off() local(v) ( v = 0; loop(NV + LWN, VB[v * VS + F_G] = 0; VB[v * VS + F_S] = 0; v += 1; ); v = 0; loop(NA, AVB[v * VS + F_G] = 0; AVB[v * VS + F_S] = 0; v += 1; ); pedal = 0; at_t = 0; );
function att_kill() ( memset(AVB, 0, NA * VS); memset(KSB + AKV * KSL, 0, NA * KSL); att_n = 0; );
function kill_all() ( memset(VB, 0, (NV + LWN) * VS); memset(KSB, 0, NV * KSL); memset(KSB + LKV * KSL, 0, LWN * KSL); pedal = 0; mono_n = -1; );

// ---------- the split: the lower part (left hand, below C4) - its own four voices ----------
// basses: a plucked string (upright: soft, no pickup; electric: the pickup; slap: hard, bright, driven) over a sine
// body with a finger / slap thump; e-piano: the FM tine piano, a little gentler; log drum: a struck wooden tongue
function lw_note_on(n, vel) local(v, b, k, ba, f0, vg, h, Tn) (
  f0 = 440 * 2 ^ ((n - 69) / 12) * tune;
  vg = (1 - sens) + sens * (vel / 127) ^ 1.3; h = vel / 127;
  v = -1; k = 0; loop(LWN, LWB[k * VS + F_N] == n && LWB[k * VS + F_ACT] ? v = k; k += 1; );
  v < 0 ? ( k = 0; loop(LWN, v < 0 && !LWB[k * VS + F_ACT] ? v = k; k += 1; ); );
  v < 0 ? ( ba = 1000000000; k = 0; loop(LWN, LWB[k * VS + F_AGE] < ba ? ( ba = LWB[k * VS + F_AGE]; v = k; ); k += 1; ); );
  b = LWB + v * VS;
  lw_was = b[F_ACT];
  age += 1; b[F_AGE] = age;
  b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0; b[F_HN] = 0; b[F_HL] = 0;
  b[F_DCF] = 1; !lw_was ? ( b[F_PY] = 0; b[F_PY2] = 0; b[F_DCO] = 0; );   // a stolen / re-struck voice carries on from where it was
  b[F_ATK] = 0;                                              // ... and the new note fades in over 2 ms
  lw_type <= 3 ? (
    ks_setup(LKV + v, b, f0, vg, h, (lw_type == 1 ? 1.2 : lw_type == 2 ? 2.5 : 1.5) * 2 ^ (-(n - 40) / 24),
             lw_type == 1 ? 0.3 : lw_type == 2 ? 0.5 : 0.95, lw_type >= 2);
    b[F_P1] = 0; b[F_AE] = vg * (lw_type == 1 ? 0.7 : lw_type == 2 ? 0.45 : 0.35);
    b[F_MD] = tc(lw_type == 1 ? 0.6 : 1.2);
    b[F_CLK] = lw_type == 3 ? vg * (0.15 + 0.3 * h) : lw_type == 1 ? vg * 0.12 : 0;
  ) : lw_type == 4 ? (
    b[F_O1] = 0; b[F_O2] = 0; b[F_O3] = 0; b[F_O4] = 0;
    Tn = 4.5 * 2 ^ (-(n - 48) / 20);
    b[F_E1] = vg; b[F_E2] = (0.9 + 1.6 * h) * 0.8; b[F_E3] = vg * 0.55; b[F_E4] = (0.6 + 2.2 * h * h) * 0.8;
    b[F_MD] = tc(Tn); b[F_MD + 1] = tc(Tn * 0.35); b[F_MD + 2] = tc(Tn * 0.4); b[F_MD + 3] = tc(0.09 + 0.05 * (1 - h));
  ) : (
    bell_set(b, f0, vg, h, 1, vg, 0.35, 0);
    bell_set(b, f0, vg, h, 2.32, vg * 0.35 * (0.5 + h), 0.12, 1);
    bell_set(b, f0, vg, h, 4.1, vg * 0.12 * (0.4 + h), 0.05, 2);
    bell_set(b, f0, vg, h, 0.5, 0, 0.1, 3);
    b[F_CLK] = vg * 0.25;
  );
);
function lw_note_off(n) local(v, b) ( v = 0; loop(LWN, b = LWB + v * VS; b[F_N] == n && b[F_G] ? ( b[F_G] = 0; b[F_S] = pedal; ); v += 1; ); );
// a note goes to the lower part when the sound is a split and the note is below the split point
function k_note_on(n, vel) ( spl_on && n < spl_pt ? lw_note_on(n, vel) : note_on(n, vel); );
function k_note_off(n) ( note_off(n); spl_on ? lw_note_off(n); );

// ---------- the two voices: VOICE 1 (the sound, with the split and the sound's own effects) and VOICE 2 ----------
// each voice's sound settings live in a record; the working names hold voice 1's, voice 2's are swapped in for
// its own voices (note-ons and the voice loop) and swapped out again
function lay_put(q) (
  q[0] = snd; q[1] = eng; q[2] = o2w; q[3] = det; q[4] = subl; q[5] = o2l; q[6] = fbase;
  q[7] = famt; q[8] = fres; q[9] = ktrk; q[10] = aA; q[11] = aD; q[12] = aS; q[13] = aR; q[14] = fA; q[15] = fD;
  q[16] = fS; q[17] = vib; q[18] = vibd; q[19] = mono; q[20] = glide; q[21] = chor; q[22] = three; q[23] = flfo;
  q[24] = lvl; q[25] = bl_lvl; q[26] = bR0; q[27] = bR1; q[28] = bR2; q[29] = bR3; q[30] = bA0; q[31] = bA1;
  q[32] = bA2; q[33] = bA3; q[34] = bD0; q[35] = bD1; q[36] = bD2; q[37] = bD3; q[38] = ks_lvl; q[39] = ks_T;
  q[40] = ks_br; q[41] = ks_pick; q[42] = br_lvl; q[43] = chf; q[44] = o1w; q[45] = vamix; q[46] = form;
  q[47] = pe_amt; q[48] = pe_t; q[49] = vf; q[50] = brp; q[51] = dl_mix; q[52] = dl_bt; q[53] = dl_fb; q[54] = trem;
  q[55] = crate; q[56] = nd; q[57] = pn_hard; q[58] = pn_T; q[59] = pn_uni; q[60] = pn_knock; q[61] = pn_ch;
  q[62] = org_perc; q[63] = at_f; q[64] = at_v; q[65] = at_l; q[66] = spl_on; q[67] = spl_pt; q[68] = lw_type;
  q[69] = lw_lvl; q[70] = ks_bite; q[71] = fm_bark; q[72] = fm_tine; q[73] = fm_dk; q[74] = fm_tr; q[75] = org_reg;
  q[76] = org_at; q[77] = org_rt; q[78] = org_clk; q[79] = tune; q[80] = a_inc; q[81] = fi_step; q[82] = dc_k;
  q[83] = f_inc; q[84] = a_dec; q[85] = a_rel; q[86] = f_dec; q[87] = gl_c; q[88] = fm_rel; q[89] = ks_damp;
  q[90] = gl_rel; q[91] = chf_d; q[92] = pe_c; q[93] = pn_damp; q[94] = pn_kd; q[95] = org_rel; q[96] = org_ai;
  q[97] = org_ck; q[98] = lw_rel; q[99] = lw_ck; q[100] = gf_on; q[101] = fA1.a1; q[102] = fA1.a2; q[103] = fA1.a3;
  q[104] = fA1.k; q[105] = fA2.a1; q[106] = fA2.a2; q[107] = fA2.a3; q[108] = fA2.k; q[109] = fA3.a1; q[110] = fA3.a2;
  q[111] = fA3.a3; q[112] = fA3.k;
  q[113] = tone; q[114] = tone_oct; q[115] = filt_oct; q[116] = reso; q[117] = atk_k; q[118] = rel_k; q[119] = dec_k;
  q[120] = sus_v; q[121] = aS_m; q[122] = org_s; q[123] = org_dk; q[124] = ab_t; q[125] = ab_len; q[126] = sens;
);
function lay_get(q) (
  snd = q[0]; eng = q[1]; o2w = q[2]; det = q[3]; subl = q[4]; o2l = q[5]; fbase = q[6];
  famt = q[7]; fres = q[8]; ktrk = q[9]; aA = q[10]; aD = q[11]; aS = q[12]; aR = q[13]; fA = q[14]; fD = q[15];
  fS = q[16]; vib = q[17]; vibd = q[18]; mono = q[19]; glide = q[20]; chor = q[21]; three = q[22]; flfo = q[23];
  lvl = q[24]; bl_lvl = q[25]; bR0 = q[26]; bR1 = q[27]; bR2 = q[28]; bR3 = q[29]; bA0 = q[30]; bA1 = q[31];
  bA2 = q[32]; bA3 = q[33]; bD0 = q[34]; bD1 = q[35]; bD2 = q[36]; bD3 = q[37]; ks_lvl = q[38]; ks_T = q[39];
  ks_br = q[40]; ks_pick = q[41]; br_lvl = q[42]; chf = q[43]; o1w = q[44]; vamix = q[45]; form = q[46];
  pe_amt = q[47]; pe_t = q[48]; vf = q[49]; brp = q[50]; dl_mix = q[51]; dl_bt = q[52]; dl_fb = q[53]; trem = q[54];
  crate = q[55]; nd = q[56]; pn_hard = q[57]; pn_T = q[58]; pn_uni = q[59]; pn_knock = q[60]; pn_ch = q[61];
  org_perc = q[62]; at_f = q[63]; at_v = q[64]; at_l = q[65]; spl_on = q[66]; spl_pt = q[67]; lw_type = q[68];
  lw_lvl = q[69]; ks_bite = q[70]; fm_bark = q[71]; fm_tine = q[72]; fm_dk = q[73]; fm_tr = q[74]; org_reg = q[75];
  org_at = q[76]; org_rt = q[77]; org_clk = q[78]; tune = q[79]; a_inc = q[80]; fi_step = q[81]; dc_k = q[82];
  f_inc = q[83]; a_dec = q[84]; a_rel = q[85]; f_dec = q[86]; gl_c = q[87]; fm_rel = q[88]; ks_damp = q[89];
  gl_rel = q[90]; chf_d = q[91]; pe_c = q[92]; pn_damp = q[93]; pn_kd = q[94]; org_rel = q[95]; org_ai = q[96];
  org_ck = q[97]; lw_rel = q[98]; lw_ck = q[99]; gf_on = q[100]; fA1.a1 = q[101]; fA1.a2 = q[102]; fA1.a3 = q[103];
  fA1.k = q[104]; fA2.a1 = q[105]; fA2.a2 = q[106]; fA2.a3 = q[107]; fA2.k = q[108]; fA3.a1 = q[109]; fA3.a2 = q[110];
  fA3.a3 = q[111]; fA3.k = q[112];
  tone = q[113]; tone_oct = q[114]; filt_oct = q[115]; reso = q[116]; atk_k = q[117]; rel_k = q[118]; dec_k = q[119];
  sus_v = q[120]; aS_m = q[121]; org_s = q[122]; org_dk = q[123]; ab_t = q[124]; ab_len = q[125]; sens = q[126];
);
function st_put(q) (
  q[0] = mono_f; q[1] = mono_n; q[2] = gf1; q[3] = gf2; q[4] = fA1.ic1; q[5] = fA1.ic2;
  q[6] = fA2.ic1; q[7] = fA2.ic2; q[8] = fA3.ic1; q[9] = fA3.ic2;
  q[10] = fl_f1; q[11] = fl_fo; q[12] = fl_t1; q[13] = fl_to; q[14] = fl_rs; q[15] = fl_n; q[16] = gf_a1; q[17] = gf_a2;
  q[18] = gf_a3; q[19] = ab_s;
);
function st_get(q) (
  mono_f = q[0]; mono_n = q[1]; gf1 = q[2]; gf2 = q[3]; fA1.ic1 = q[4]; fA1.ic2 = q[5];
  fA2.ic1 = q[6]; fA2.ic2 = q[7]; fA3.ic1 = q[8]; fA3.ic2 = q[9];
  fl_f1 = q[10]; fl_fo = q[11]; fl_t1 = q[12]; fl_to = q[13]; fl_rs = q[14]; fl_n = q[15]; gf_a1 = q[16]; gf_a2 = q[17];
  gf_a3 = q[18]; ab_s = q[19];
);
function att_enter() ( st_put(SBOD); lay_get(LATT); st_get(SATT); va_res = fres + fl_rs * (1.02 - fres); cvb = AVB; cnv = NA; cks = AKV; cisatt = 1; );
function att_leave() ( st_put(SATT); lay_get(LBOD); st_get(SBOD); va_res = fres + fl_rs * (1.02 - fres); cvb = VB; cnv = NV; cks = 0; cisatt = 0; );
// a note: voice 1's, then voice 2's (right-hand part only on a split); each gets its attack gate, and DRIFT moves
// each note's length and attack level a little
function kk_on(n, vel) local(lw) (
  lw = spl_on && n < spl_pt;
  lastb = 0; k_note_on(n, vel);
  bl_vel_d = vel / 127; bl_cnt_d += 1;                  // (for the panel's ATTACK BLEND circles)
  !lw && lastb ? ( lastb[F_AG] = 0; lastb[F_AL] = ab_len * (dm_a > 0 ? 1 + (rand(2) - 1) * 0.25 * dm_a : 1); lastb[F_AV] = dm_a > 0 ? 1 + (rand(2) - 1) * 0.2 * dm_a : 1; );
  att_on && !lw && !att_pend ? (
    att_any = 1; att_enter();
    tune *= 2 ^ ((rand(2) - 1) * 8 * dm_a / 1200);        // DRIFT: voice 2 sits a few cents off voice 1, note by note
    note_on(n, vel);
    lastb[F_AG] = 0;
    lastb[F_AL] = ab_len * (1 + (rand(2) - 1) * 0.25 * dm_a);
    lastb[F_AV] = 1 + (rand(2) - 1) * 0.2 * dm_a;
    att_leave();
  );
);
function kk_off(n) local(v, b) (
  k_note_off(n);
  v = 0; loop(NA, b = AVB + v * VS; b[F_N] == n && b[F_G] ? ( b[F_G] = 0; b[F_S] = pedal; ); v += 1; );
);

// ---------- reverb (GFX Space engine) ----------
rv_a = 96000;                                 // small arrays: 8 per field
rlw = rv_a; rlz = rv_a + 10; rlph = rv_a + 20; rlrt = rv_a + 30; rllen = rv_a + 40; rlga = rv_a + 50; rlgb = rv_a + 60;
rapw = rv_a + 70; rapl = rv_a + 80; rbl = rv_a + 90; rtmp = rv_a + 100; rmix = rv_a + 110;
memset(rv_a, 0, 120);
rbl[0] = 31.7; rbl[1] = 37.1; rbl[2] = 41.3; rbl[3] = 47.9; rbl[4] = 53.3; rbl[5] = 61.1; rbl[6] = 70.7; rbl[7] = 79.3;
rapl[0] = 142; rapl[1] = 107; rapl[2] = 379; rapl[3] = 277;
i = 0; loop(8, rlrt[i] = 0.31 + 0.11 * i; rlph[i] = rand(1); i += 1; );
RBLK = ceil(0.16 * srate) + 16;
rpre_b = 100000; rpre_len = ceil(0.16 * srate) + 8;
rap_b = rpre_b + rpre_len;                    // 4 diffusers, rings of 4096
rln_b = rap_b + 4 * 4096;                     // 8 lines
memset(rpre_b, 0, rln_b + 8 * RBLK - rpre_b);
rpre_w = 0; rv_on = 0;
DLB = 400000; memset(DLB, 0, 262144); dl_w = 0; dl_tail = 0; dlpL = 0; dlpR = 0; trph = 0; bt_pos = 0; nd_last = -1; dl_len = 24000;
function rv_update() local(i, sz, L, gl, gh, a, t60) (
  rtyp = slider19;
  sz = rtyp == 0 ? 0.42 : rtyp == 1 ? 1 : 0.55;
  rdiff = rtyp == 2 ? 0.95 : 0.75;
  rpre = slider20 * 0.001 * srate;
  t60 = slider21 * 1.11;
  rmod = rtyp == 2 ? 0.0004 : 0.0008;
  i = 0;
  loop(8,
    L = min(rbl[i] * sz * 0.001 * srate, RBLK - 64);
    rllen[i] = L;
    gl = 10 ^ (-3 * L / (t60 * srate));
    gh = 10 ^ (-3 * L / (t60 * (1 - 0.9 * slider22 / 100) * srate * (rtyp == 2 ? 1.4 : 1)));
    a = (gl - gh) / (gl + gh); rlga[i] = a; rlgb[i] = gl * (1 - a);
    i += 1;
  );
  rv_wet = slider23 / 100;
  rv_on = rv_wet > 0.001;
);

function update() (
  slider1 != snd ? (
    snd >= 0 && nact > 0 && !lx_pgo ? ( lx_pcf = 1; ) : (     // voices sounding: they fade out under the old sound first
    lx_pgo = 0;
    snd >= 0 ? (
      // a new sound starts from its own settings: the sound-shaping knobs go back to neutral
      !prs_keep1 ? (
        slider17 = 0; slider18 = 0; slider2 = 50; slider3 = 0; slider4 = 0; slider5 = 100; slider26 = 0; slider36 = 0;
        sliderchange(slider2); sliderchange(slider3); sliderchange(slider4); sliderchange(slider5);
        sliderchange(slider17); sliderchange(slider18); sliderchange(slider26); sliderchange(slider36);
      );
      prs_keep1 = 0;
    );
    kill_all(); patch_set(slider1);
    );
  );
  tone = slider2 / 100;
  atk_k = 4 ^ (slider3 / 100); rel_k = 4 ^ (slider4 / 100); dec_k = 4 ^ (slider26 / 100); sus_v = slider36 / 100;
  chor_k = slider5 / 100;
  sens = slider6 / 100;
  tune = 2 ^ (slider7 / 12);                               // TUNE: +/- 24 semitones (whole steps, Shift-drag for cents)
  drift_macro(slider8); drift = dm_a * 0.4;               // (the instrument drift at 40 % of its full scale = standard)
  chan = slider9;
  out_t = 10 ^ ((slider10 + (prs_sel > 0 && prs_sel <= NPR && slider1 == PRB[prs_sel] && slider27 == PR2[prs_sel] ? PRT[prs_sel] : 0)) / 20);
                                                        // a combi's own trim, while its two sounds play
  ins_output_setup(11); ins_stereo_setup(24);
  filt_oct = slider17; reso = slider18 / 100;
  rv_update();
  ab_t = slider28 < 0 ? 1 + slider28 / 100 : 1; ab_len = slider30 / 1000;   // MIX (towards 1: voice 1 the attack) and its length
  // LEVEL per voice (-48 dB = off)
  v1_gt = slider32 <= -47.95 ? 0 : 10 ^ (slider32 / 20); v2_gt = slider31 <= -47.95 ? 0 : 10 ^ (slider31 / 20); att_on = v2_gt > 0.0005;
  // FX (both voices): each unit runs while its amount is up
  fc_on = slider35 > 0.05; fc_rt = slider33; fc_dp_t = slider34 / 100; fc_mx_t = slider35 / 100;
  fd_on = slider45 > 0.05; fd_fb_t = slider44 / 100; fd_mx_t = slider45 / 100; fd_pp = slider46 > 0.5;
  fd_bt = slider43 == 1 ? 0.25 : slider43 == 2 ? 1 / 3 : slider43 == 3 ? 0.5 : slider43 == 4 ? 0.75 : slider43 == 5 ? 2 / 3 :
          slider43 == 6 ? 1 : slider43 == 7 ? 1.5 : slider43 == 8 ? 2 : 4;
  fd_dt = min((slider43 > 0 ? fd_bt * 60 / max(tempo, 20) : slider42 / 1000), 2) * srate;
  fp_on = slider51 > 0.05; fp_pan = slider48 > 0.5; fp_dp_t = slider51 / 100;
  fp_bt = slider50 == 1 ? 4 : slider50 == 2 ? 2 : slider50 == 3 ? 1 : slider50 == 4 ? 0.5 : slider50 == 5 ? 1 / 3 : 0.25;
  fp_rt = slider50 > 0 ? max(tempo, 20) / 60 / fp_bt : slider49;
);

