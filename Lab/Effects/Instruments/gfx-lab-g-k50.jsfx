function snd_menu(x, y, tg) local(i, k, sel) (       // tg: 0 = voice 1's sound, 1 = voice 2's
  #sm = ""; i = 0;
  loop(NSND,
    k = pos_grp(i);
    i == GST[k] ? ( strcat(#sm, ">"); strcat(#sm, grp_menu(k)); strcat(#sm, "|"); );
    i == GST[k] + GSZ[k] - 1 ? strcat(#sm, "<");
    (tg ? slider27 : slider1) == mord[i] ? strcat(#sm, "!");
    strcat(#sm, sname(mord[i]));
    i < NSND - 1 ? strcat(#sm, "|");
    i += 1;
  );
  gfx_x = x; gfx_y = y; sel = gfx_showmenu(#sm);
  sel > 0 ? ( tg ? ( slider27 = mord[sel - 1]; ui_auto(27); ) : ( slider1 = mord[sel - 1]; slider_automate(1); ); );
);
function combi_menu(x, y) local(k, sel) (
  #sm = ""; k = 1;
  loop(NPR, kx_prs == k ? strcat(#sm, "!"); strcat(#sm, pname(k)); k < NPR ? strcat(#sm, "|"); k += 1; );
  gfx_x = x; gfx_y = y; sel = gfx_showmenu(#sm);
  sel > 0 ? ( prs_dirty = sel; kx_prs = sel; );
);

