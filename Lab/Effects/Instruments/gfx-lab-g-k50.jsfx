!ui_dflt ? ui_kstyle = 0;
!ui_dflt ? lx_page = 0;
kx_prs = 0;
BRW = 0x3A2E28; INKL = 0xE8DED2; TEAL = 0x2FB5A0; REDL = 0xFF3A2A; V2C = 0xE8A23A;   // voice 1 teal, voice 2 amber
SH1 = 0x463830; SH2 = 0x403229; SH3 = 0x372B24;       // macros, reverb, utility
function mgroup(x, y, w, h, sec, title, shade) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  pk_box(x * sc, y * sc, w * sc, h * sc, TEAL, title);
  ui_section(sec == 0 ? 2 : sec); C_INK = INKL;
);
snd = -1;
// the per-block coefficients of the sound (also run at once when a sound change applies in @sample)
// the output filter's coefficients and the analogue voices' resonance, from the glided FILTER / RESONANCE
function fl_gf() (
  gf_g = tan($pi * min(18000 * 2 ^ fl_fo, srate * 0.45) / srate); gf_k = 2 - 1.9 * fl_rs;
  gf_a1 = 1 / (1 + gf_g * (gf_g + gf_k)); gf_a2 = gf_g * gf_a1; gf_a3 = gf_g * gf_a2;
  va_res = fres + fl_rs * (1.02 - fres);
);
function lx_coefs() (
  fl_k = 1 - exp(-1 / (0.015 * srate));
  // envelope coefficients (with the ATTACK / RELEASE macros)
  a_inc = 1 / max(max(aA * atk_k, 0.003) * srate, 1);      // never faster than 3 ms (no click)
  fi_step = 1 / ((eng == 1 ? 0.003 : 0.002) * srate); dc_k = exp(-1 / (0.002 * srate));
  f_inc = 1 / max(max(fA * atk_k, 0.002) * srate, 1);
  a_dec = tc(aD * dec_k); a_rel = tc(aR * rel_k);
  aS_m = sus_v < 0 ? aS * (1 + sus_v) : aS + (1 - aS) * sus_v;          // SUSTAIN: 0 = the sound's own level
  org_s = sus_v < 0 ? 1 + sus_v : 1; org_dk = tc(0.6 * dec_k);          // (the organs: a decay to it after the pipes speak)
  f_dec = tc(fD);
  gl_c = glide > 0 ? 1 - exp(-1 / (glide * srate)) : 1;
  fm_rel = tc(0.28 * rel_k); ks_damp = 0.6; gl_rel = tc(1.5 * rel_k); chf_d = tc(0.03);
  tone_oct = (tone - 0.5) * 3 + dg_top;            // TONE: +/- 1.5 octaves on filters / brightness (+ the digital drift)
  // output filter for the FM / string / bar sounds (FILTER 0 and no RESONANCE = bypassed)
  gf_on = eng != 0 && (filt_oct < -0.01 || reso > 0.005);
  fl_ok ? fl_gf();
  // analogue sounds: the knobs move each note's filter
  pe_c = tc(pe_t); pn_damp = tc(0.18 * rel_k) ^ 0.5; pn_kd = tc(0.012); org_rel = tc(org_rt * rel_k); org_ai = 1 / (max(org_at * atk_k, 0.0005) * srate); org_ck = tc(0.004); lw_rel = tc(0.08 * rel_k); lw_ck = tc(0.004);
  (eng == 4 || eng == 5) ? ( pv = 0; loop(cnv, cvb[pv * VS + F_ACT] ? pn_norm(cvb + pv * VS); pv += 1; ); );
);
// a sound change while voices sound: the old sound fades out (12 ms), the new one applies at the silent point and
// the output fades back in (12 ms), so nothing is cut dead; notes played during the fade start at that point
LXP = 7000; lx_pcf = 0; lx_pck = lx_pcg = 1; lx_pcn = 0; lx_pgo = 0;
function lx_hold(n, v) ( lx_pcn < 32 ? ( LXP[lx_pcn * 2] = n; LXP[lx_pcn * 2 + 1] = v; lx_pcn += 1; ); );
function lx_unhold(n) local(i, j) (
  i = j = 0; loop(lx_pcn, LXP[i * 2] != n ? ( LXP[j * 2] = LXP[i * 2]; LXP[j * 2 + 1] = LXP[i * 2 + 1]; j += 1; ); i += 1; ); lx_pcn = j;
);
// voice 2's settings: its sound's, polyphonic, no split / loop, with its own controls
function att_build() (
  lay_put(LBOD);
  patch_set(att_cur); mono = 0; glide = 0; spl_on = 0; nd = 0;
  tone = slider41 / 100; filt_oct = slider39; reso = slider40 / 100;
  atk_k = 4 ^ (slider52 / 100); dec_k = 4 ^ (slider53 / 100); sus_v = slider54 / 100; rel_k = 4 ^ (slider55 / 100);
  tune = 2 ^ (slider47 / 12);
  ab_t = slider28 > 0 ? 1 - slider28 / 100 : 1; ab_len = slider29 / 1000;   // (towards 2: voice 2 the attack)
  cvb = AVB; cnv = NA; lx_coefs(); cvb = VB; cnv = NV;
  lay_put(LATT);
  lay_get(LBOD);
  att_tr = patch_trim(att_cur) / patch_trim(snd);       // each sound's level trim, relative to voice 1's
  va_res = fres + fl_rs * (1.02 - fres);
);
// a new voice 2 sound starts from its own settings (unless a combi set them)
function v2_neutral() (
  !prs_keep2 ? (
    slider39 = 0; slider40 = 0; slider41 = 50; slider52 = 0; slider53 = 0; slider54 = 0; slider55 = 0;
    sliderchange(slider39); sliderchange(slider40); sliderchange(slider41); sliderchange(slider52);
    sliderchange(slider53); sliderchange(slider54); sliderchange(slider55);
  );
  prs_keep2 = 0;
);
function lx_pcapply() local(i) (
  lx_pgo = 1; update(); lx_coefs(); lx_pcf = 0; att_build();
  dl_len = min(floor(dl_bt * 60 / tempo * srate), 131000);       // (the echo time moves here too, while it is silent)
  i = 0; loop(lx_pcn, kk_on(LXP[i * 2], LXP[i * 2 + 1]); i += 1; ); lx_pcn = 0;
);
