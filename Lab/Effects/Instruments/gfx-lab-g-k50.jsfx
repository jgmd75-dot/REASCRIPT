// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset
// bar asks through prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling
// its state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= NPR ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(NPR, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

update();
lx_coefs(); att_cur = slider27; att_build(); ab_s = ab_t; v1_g = v1_gt; att_og = v2_gt;
att_enter(); fl_f1 = fl_fo = filt_oct; fl_t1 = fl_to = tone_oct; fl_rs = reso; fl_n = 0; ab_s = ab_t; att_leave();   // voice 2's glides start where they are
out_s = out_t;
ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme

// one layer's voices (cvb / cnv / cks name the layer), summed
function lay_run() (
  lr = 0; av = 0;
  loop(cnv,
    b = cvb + av * VS;
    b[F_ACT] ? (
      nact += 1;
      held = b[F_G] || b[F_S];
      y = 0;
      eng == 0 ? (
        // ---------- analogue voice ----------
        mono ? ( mono_f += (b[F_F0] - mono_f) * gl_c; f = mono_f; ) : f = b[F_F0];
        b[F_VT] = min(b[F_VT] + 1 / (0.6 * srate), 1);                         // delayed vibrato
        f *= b[F_DT] * pdrift * (1 + (vibd * 0.006 * b[F_VT] * (vib > 0) + (modw + at_v * at_s) * 0.008) * sin(2 * $pi * vph));
        b[F_PE] != 0 ? ( f *= 2 ^ (b[F_PE] / 12); b[F_PE] *= pe_c; abs(b[F_PE]) < 0.001 ? b[F_PE] = 0; );   // pitch envelope
        dt = f / srate;
        b[F_P1] += dt * (1 + det); b[F_P1] >= 1 ? b[F_P1] -= 1;
        b[F_P2] += dt * (1 - det); b[F_P2] >= 1 ? b[F_P2] -= 1;
        b[F_P3] += dt * 0.5;       b[F_P3] >= 1 ? b[F_P3] -= 1;
        x = (o1w == 2 ? sqw(b[F_P1], dt * (1 + det)) : o1w ? 1.2 * sin(2 * $pi * b[F_P1]) : saw(b[F_P1], dt * (1 + det))) + o2l * (o2w ? sqw(b[F_P2], dt) : saw(b[F_P2], dt * (1 - det))) + subl * sqw(b[F_P3], dt * 0.5);
        // envelopes
        held ? (
          b[F_AST] == 0 ? ( b[F_AE] += a_inc; b[F_AE] >= 1 ? ( b[F_AE] = 1; b[F_AST] = 1; ); ) : b[F_AE] = aS_m + (b[F_AE] - aS_m) * a_dec;
          b[F_FST] == 0 ? ( b[F_FE] += f_inc; b[F_FE] >= 1 ? ( b[F_FE] = 1; b[F_FST] = 1; ); ) : b[F_FE] = fS + (b[F_FE] - fS) * f_dec;
        ) : ( b[F_AE] *= a_rel; b[F_FE] *= a_rel; );
        // 4-pole filter
        fc = fbase * 2 ^ (famt * b[F_FE] * (vf > 0 ? (1 - vf) * (0.6 + 0.4 * b[F_VEL]) + vf * b[F_VEL] * b[F_VEL] * 1.2 : 0.6 + 0.4 * b[F_VEL]) + fl_to + fl_fo + b[F_E1] + ins_cut + ktrk * log(f / 261.6) / log(2) + flfo * sin(2 * $pi * flph) + at_f * at_s);
        g = tan($pi * min(fc, srate * 0.42) / srate); gG = g / (1 + g);
        u = tanh_(x * 0.5 - va_res * 3.9 * b[F_S4]);
        v_ = (u - b[F_S1]) * gG; y1 = v_ + b[F_S1]; b[F_S1] = y1 + v_;
        v_ = (y1 - b[F_S2]) * gG; y2 = v_ + b[F_S2]; b[F_S2] = y2 + v_;
        v_ = (y2 - b[F_S3]) * gG; y3 = v_ + b[F_S3]; b[F_S3] = y3 + v_;
        v_ = (y3 - b[F_S4]) * gG; y4 = v_ + b[F_S4]; b[F_S4] = y4 + v_;
        y = y4 * b[F_AE] * b[F_VEL] * 2 * (1 + 0.8 * va_res) * vamix * (1 + at_l * at_s);
        // attack / extra layers
        bl_lvl > 0 ? y += 0.6 * bell_tick(b, held ? 1 : gl_rel) : bell_amp = 0;
        ks_lvl > 0 ? y += ks_tick(av + cks, b, ks_pick, ks_bite) : b[F_O3] = 0;
        br_lvl > 0 || b[F_CLK] > 0.0005 ? (
          b[F_O1] += (nz - b[F_O1]) * 0.35; b[F_O2] += (b[F_O1] - b[F_O2]) * 0.03;      // breath band
          brp ? (
            // the pipes: breath through a narrow band an octave above the note (it sounds with the pipe, not as hiss);
            // the broad band only for the brief chiff
            bfc = 2 * sin($pi * min(f * 2, 6000) / srate);
            b[F_KLP] += bfc * b[F_KAP]; bfh = nz * br_lvl * b[F_AE] * b[F_VEL] - b[F_KLP] - 0.3 * b[F_KAP]; b[F_KAP] += bfc * bfh;
            y += b[F_KAP] * 0.8 + (b[F_O1] - b[F_O2]) * b[F_CLK];
          ) : y += (b[F_O1] - b[F_O2]) * (br_lvl * b[F_AE] * b[F_VEL] + b[F_CLK]);
          b[F_CLK] *= chf_d;
        );
        !held && b[F_AE] < 0.0003 && bell_amp < 0.0003 && b[F_O3] < 0.0002 ? (
          b[F_ACT] = 0; ks_lvl > 0 ? memset(KSB + (av + cks) * KSL, 0, KSL);
        );
      ) : eng == 1 ? (
        // ---------- FM e-piano ----------
        f = b[F_F0] * pdrift * (1 + modw * 0.008 * sin(2 * $pi * vph));
        b[F_O1] += f / srate;          b[F_O1] -= floor(b[F_O1]);
        b[F_O2] += f / srate;          b[F_O2] -= floor(b[F_O2]);
        b[F_O3] += f * 1.0017 / srate; b[F_O3] -= floor(b[F_O3]);
        b[F_O4] += f * fm_tr / srate;     b[F_O4] -= floor(b[F_O4]);
        br = 2 ^ (tone_oct * 0.5);
        m2 = sin(2 * $pi * b[F_O2]) * b[F_E2] * br;
        m4 = sin(2 * $pi * b[F_O4]) * b[F_E4] * br;
        y = (0.62 * sin(2 * $pi * b[F_O1] + m2) * b[F_E1] + 0.42 * sin(2 * $pi * b[F_O3] + m4) * b[F_E3]);
        rm = held ? 1 : fm_rel;
        b[F_E1] *= b[F_MD] * rm; b[F_E2] *= b[F_MD + 1]; b[F_E3] *= b[F_MD + 2] * rm; b[F_E4] *= b[F_MD + 3];
        y *= 0.6;
        b[F_E1] + b[F_E3] < 0.0003 ? b[F_ACT] = 0;
      ) : eng == 4 ? (
        // ---------- synthetic piano ----------
        rm = held ? 1 : pn_damp;
        y = pn_tick(b, rm) * 0.5;
        b[F_CLK] > 0.0003 ? (                                    // knock: a low thud and a short click
          b[F_HN] += (nz - b[F_HN]) * 0.08; b[F_HL] += (b[F_HN] - b[F_HL]) * 0.02;
          y += (b[F_HN] - b[F_HL] * 0.6) * b[F_CLK]; b[F_CLK] *= pn_kd;
        );
        pn_amp < 0.0003 && b[F_CLK] < 0.0003 ? b[F_ACT] = 0;
      ) : eng == 5 ? (
        // ---------- drawbar organ ----------
        held ? ( !b[F_AST] ? ( b[F_AE] = min(b[F_AE] + org_ai, 1); b[F_AE] >= 1 ? b[F_AST] = 1; ) :
          b[F_AE] = org_s + (b[F_AE] - org_s) * org_dk; ) : b[F_AE] *= org_rel;
        y = pn_tick(b, 1) * b[F_AE];
        b[F_CLK] > 0.0003 ? ( b[F_HN] += (nz - b[F_HN]) * 0.5; y += (nz - b[F_HN]) * b[F_CLK]; b[F_CLK] *= org_ck; );
        !held && b[F_AE] < 0.0003 ? b[F_ACT] = 0;
      ) : eng == 2 ? (
        // ---------- clav string ----------
        y = ks_tick(av + cks, b, 1, 1);
        !held && b[F_O3] < 0.0002 ? ( b[F_ACT] = 0; memset(KSB + (av + cks) * KSL, 0, KSL); );
      ) : (
        // ---------- glockenspiel bar ----------
        y = bell_tick(b, held ? 1 : gl_rel); amp = bell_amp;
        b[F_CLK] > 0.0005 ? ( b[F_KHP] += (nz - b[F_KHP]) * 0.45; y += (nz - b[F_KHP]) * b[F_CLK]; b[F_CLK] *= 0.993; );
        y *= 0.6;
        amp < 0.0003 && b[F_CLK] < 0.0005 ? b[F_ACT] = 0;
      );
      // de-click: fade-in for struck sounds, and any jump at a (re)start is smoothed over ~2 ms
      b[F_ATK] < 1 ? ( b[F_ATK] = min(b[F_ATK] + fi_step, 1); y *= b[F_ATK]; );
      // the attack gate (MIX): full for the first third of its length, then a smooth fall to the BODY level (0 = silence: the voice ends)
      b[F_AG] += 1 / srate;
      ab_s < 0.999 ? (
        ag_l = b[F_AL];                                   // (each note keeps the LENGTH it started with)
        b[F_AG] < 0.35 * ag_l ? ag = 1 : ( ag_u = (b[F_AG] - 0.35 * ag_l) / (0.65 * ag_l); ag = ag_u >= 1 ? 0 : 0.5 + 0.5 * cos($pi * ag_u); );
        ag = ab_s + (1 - ab_s) * ag * b[F_AV];
        ab_s < 0.0005 && b[F_AG] >= ag_l ? ( b[F_ACT] = 0; memset(KSB + (av + cks) * KSL, 0, KSL); );
        y *= ag;
      );
      cisatt ? att_n += 1;
      b[F_DCF] ? ( b[F_DCO] = 2 * b[F_PY] - b[F_PY2] - y; b[F_DCF] = 0; );   // continue the waveform's own slope
      y += b[F_DCO]; b[F_DCO] *= dc_k;
      b[F_PY2] = b[F_PY]; b[F_PY] = y;
      lr += y;
    );
    av += 1;
  );
  lr;
);

@slider
prs_chk();
update();

@block
prs_chk();
evn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  stt = m1 & 0xF0; mch = (m1 & 0x0F) + 1;
  (chan == 0 || mch == chan) && evn < 512 ? (
    evq[evn * 4] = mofs; evq[evn * 4 + 1] = stt; evq[evn * 4 + 2] = m2; evq[evn * 4 + 3] = m3; evn += 1;
  );
  midisend(mofs, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( all_off(); lx_pcn = 0; );
gfx_pst_prev = gfx_pst;
evi = 0; spos = 0;
panic_dirty ? ( all_off(); panic_dirty = 0; );
lx_pcr = 1 / (0.012 * srate);
update();
ins_drift_block(drift, samplesblock);            // GFX instrument drift
pdrift = ins_pitch;
ins_cut = 0; ins_fx = 0; dg_top = 0; dg_ch = 0;           // DRIFT here is fine tuning and the attack: no filter / chorus wander
lx_coefs();
slider27 != att_cur && !att_pend ? ( att_n > 0 && att_og > 0.001 ? att_pend = 1 : ( att_kill(); att_cur = slider27; v2_neutral(); ); );
att_build();
// FX RACK: a unit faded right out starts again from clean lines
!fc_on && fc_g < 0.0001 && !fc_clr ? ( memset(FXC, 0, 16384); fc_clr = 1; );
!fd_on && fd_g < 0.0001 && !fd_clr ? ( memset(FXD, 0, 2 * FXDN); fd_lpL = fd_lpR = 0; fd_clr = 1; );
// tempo: the host's when playing, else free-running at its tempo
bt_inc = tempo / 60 / srate;
(play_state & 1) ? bt_pos = beat_position;
// echo time (beats)
dl_len = min(floor(dl_bt * 60 / tempo * srate), 131000);

@serialize
file_var(0, ui_sz);
file_var(0, lx_page);                                  // (appended: older states read on as the SOUNDS page)
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall
file_avail(0) != 0 ? file_var(0, kx_prs);

@sample
while (evi < evn && (evq[evi * 4] <= spos || spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  e1 = evq[evi * 4 + 1]; e2 = evq[evi * 4 + 2]; e3 = evq[evi * 4 + 3];
  e1 == 0x90 && e3 > 0 ? ( lx_pcf ? lx_hold(e2, e3) : kk_on(e2, e3); midi_led = 1; ins_midi_hit(); ) :
  e1 == 0x80 || e1 == 0x90 ? ( lx_unhold(e2); kk_off(e2); ) :
  e1 == 0xD0 ? at_t = e2 / 127 :                       // channel pressure
  e1 == 0xA0 ? at_t = e3 / 127 :                       // poly pressure (taken as the whole keyboard's)
  e1 == 0xB0 ? (
    e2 == 64 ? pedal_set(e3 >= 64);
    e2 == 1 ? modw = e3 / 127;
    e2 == 120 || e2 == 123 ? ( all_off(); lx_pcn = 0; );
  );
  evi += 1;
);
spos += 1;
// FILTER, RESONANCE and TONE glide (two 15 ms stages on the octaves, 15 ms on RESONANCE), so a turned knob never steps;
// the output filter and the analogue voices' resonance follow every 16 samples
!fl_ok ? ( fl_f1 = fl_fo = filt_oct; fl_t1 = fl_to = tone_oct; fl_rs = reso; fl_ok = 1; );
fl_f1 += (filt_oct - fl_f1) * fl_k; fl_fo += (fl_f1 - fl_fo) * fl_k; fl_t1 += (tone_oct - fl_t1) * fl_k; fl_to += (fl_t1 - fl_to) * fl_k;
fl_rs += (reso - fl_rs) * fl_k;
(fl_n -= 1) <= 0 ? ( fl_n = 16; fl_gf(); );
lx_pcf ? ( lx_pck -= lx_pcr; lx_pck <= 0 ? ( lx_pck = 0; lx_pcapply(); ); lx_pcg = 0.5 - 0.5 * cos($pi * lx_pck); ) :
lx_pck < 1 ? ( lx_pck = min(lx_pck + lx_pcr, 1); lx_pcg = 0.5 - 0.5 * cos($pi * lx_pck); );

nz = rand(2) - 1;
at_s += (at_t - at_s) * at_c;                    // aftertouch, smoothed (30 ms)
vph += (vib > 0 ? vib : 5.5) / srate; vph >= 1 ? vph -= 1;
flph += 0.13 / srate; flph >= 1 ? flph -= 1;
// NATIVE DANCE: a 16-step log-drum pattern, retuned to each held note
nd ? (
  ndst = floor(bt_pos * 4) & 15;
  ndst != nd_last ? (
    nd_last = ndst;
    ndh = ndst == 0 || ndst == 3 || ndst == 6 || ndst == 8 || ndst == 10 || ndst == 11 || ndst == 14;
    ndh ? (
      ndr = ndst == 6 || ndst == 14 ? 1.5 : ndst == 10 ? 2 : ndst == 11 ? 0.75 : 1;
      nda = ndst == 0 || ndst == 8 ? 1 : 0.6;
      av = 0;
      loop(NV,
        b = VB + av * VS;
        b[F_ACT] && (b[F_G] || b[F_S]) ? (
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr,        b[F_VEL] * bl_lvl * nda, 0.22, 0);
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr * 2.76, b[F_VEL] * bl_lvl * nda * 0.35, 0.07, 1);
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr * 4.1,  b[F_VEL] * bl_lvl * nda * 0.15, 0.04, 2);
          b[F_CLK] = b[F_VEL] * 0.12 * nda;
        );
        av += 1;
      );
    ) : ndst % 2 == 1 ? (
      av = 0; loop(NV, b = VB + av * VS; b[F_ACT] && (b[F_G] || b[F_S]) ? b[F_CLK] = b[F_VEL] * 0.05; av += 1; );   // shaker ticks
    );
  );
);
bt_pos += bt_inc;
// ---------- VOICE 2: its voices, through its own vowel / output filters ----------
att_og += (v2_gt - att_og) * att_k; v1_g += (v1_gt - v1_g) * att_k;   // MIX glides (15 ms)
!att_on && att_og < 0.0005 && att_n > 0 ? att_kill();
att_pend ? ( att_xg -= lx_pcr; att_xg <= 0 ? ( att_xg = 0; att_kill(); att_cur = slider27; att_pend = 0; v2_neutral(); att_build(); ); ) :
  att_xg < 1 ? att_xg = min(att_xg + lx_pcr, 1);
ab_s += (ab_t - ab_s) * sm;                          // voice 1's attack gate glides
amix = 0; nact = 0;
att_n > 0 || att_any ? (
  att_any = 0; att_enter(); att_n = 0;
  // voice 2's own CUTOFF, RESO, TONE and attack gate glide as voice 1's do
  fl_f1 += (filt_oct - fl_f1) * fl_k; fl_fo += (fl_f1 - fl_fo) * fl_k; fl_t1 += (tone_oct - fl_t1) * fl_k; fl_to += (fl_t1 - fl_to) * fl_k;
  fl_rs += (reso - fl_rs) * fl_k; ab_s += (ab_t - ab_s) * sm;
  (fl_n -= 1) <= 0 ? ( fl_n = 16; fl_gf(); );
  amix = lay_run() * lvl;
  form ? ( fo1 = fA1.svf_bp(amix); fo2 = fA2.svf_bp(amix); fo3 = fA3.svf_bp(amix); amix = 0.25 * amix + 1.6 * fo1 + 1.1 * fo2 + 0.7 * fo3; );
  gf_on ? (
    gv3 = amix - gf2; gv1 = gf_a1 * gf1 + gf_a2 * gv3; gv2 = gf2 + gf_a2 * gf1 + gf_a3 * gv3;
    gf1 = 2 * gv1 - gf1; gf2 = 2 * gv2 - gf2; amix = gv2;
  ) : ( gf1 = 0; gf2 = 0; );
  att_leave();
  amix *= att_og * att_xg * att_tr;
);
// ---------- VOICE 1 ----------
mix = lay_run();
mix *= lvl;
// ---------- the split's lower part ----------
spl_on ? (
  lwm = 0; av = 0;
  loop(LWN,
    b = LWB + av * VS;
    b[F_ACT] ? (
      nact += 1;
      held = b[F_G] || b[F_S];
      f = b[F_F0] * pdrift;
      lw_type <= 3 ? (
        y = ks_tick(LKV + av, b, lw_type >= 2, 0);
        b[F_P1] += f / srate; b[F_P1] -= floor(b[F_P1]);
        y += sin(2 * $pi * b[F_P1]) * b[F_AE]; b[F_AE] *= held ? b[F_MD] : lw_rel;
        b[F_CLK] > 0.0005 ? ( b[F_HN] += (nz - b[F_HN]) * 0.25; b[F_HL] += (b[F_HN] - b[F_HL]) * 0.05; y += (b[F_HN] - b[F_HL]) * b[F_CLK] * 2; b[F_CLK] *= lw_ck; );   // a band of noise: the thump / pop
        !held && b[F_O3] < 0.0002 && b[F_AE] < 0.0003 ? ( b[F_ACT] = 0; memset(KSB + (LKV + av) * KSL, 0, KSL); );
      ) : lw_type == 4 ? (
        b[F_O1] += f / srate;          b[F_O1] -= floor(b[F_O1]);
        b[F_O2] += f / srate;          b[F_O2] -= floor(b[F_O2]);
        b[F_O3] += f * 1.0017 / srate; b[F_O3] -= floor(b[F_O3]);
        b[F_O4] += f * 14 / srate;     b[F_O4] -= floor(b[F_O4]);
        y = 0.62 * sin(2 * $pi * b[F_O1] + sin(2 * $pi * b[F_O2]) * b[F_E2]) * b[F_E1] + 0.42 * sin(2 * $pi * b[F_O3] + sin(2 * $pi * b[F_O4]) * b[F_E4]) * b[F_E3];
        rm = held ? 1 : fm_rel;
        b[F_E1] *= b[F_MD] * rm; b[F_E2] *= b[F_MD + 1]; b[F_E3] *= b[F_MD + 2] * rm; b[F_E4] *= b[F_MD + 3];
        y *= 0.6;
        b[F_E1] + b[F_E3] < 0.0003 ? b[F_ACT] = 0;
      ) : (
        y = bell_tick(b, held ? 1 : gl_rel) * 0.6;
        b[F_CLK] > 0.0005 ? ( b[F_HN] += (nz - b[F_HN]) * 0.45; y += (nz - b[F_HN]) * b[F_CLK]; b[F_CLK] *= 0.99; );
        bell_amp < 0.0003 && b[F_CLK] < 0.0005 ? b[F_ACT] = 0;
      );
      b[F_ATK] < 1 ? ( b[F_ATK] = min(b[F_ATK] + fi_step, 1); y *= b[F_ATK]; );
      b[F_DCF] ? ( b[F_DCO] = 2 * b[F_PY] - b[F_PY2] - y; b[F_DCF] = 0; );
      y += b[F_DCO]; b[F_DCO] *= dc_k;
      b[F_PY2] = b[F_PY]; b[F_PY] = y;
      lwm += y;
    );
    av += 1;
  );
  mix += lwm * lw_lvl;
);
form ? (
  // "aah": three vocal formants
  fo1 = fA1.svf_bp(mix); fo2 = fA2.svf_bp(mix); fo3 = fA3.svf_bp(mix);
  mix = 0.25 * mix + 1.6 * fo1 + 1.1 * fo2 + 0.7 * fo3;
);
gf_on ? (
  gv3 = mix - gf2; gv1 = gf_a1 * gf1 + gf_a2 * gv3; gv2 = gf2 + gf_a2 * gf1 + gf_a3 * gv3;
  gf1 = 2 * gv1 - gf1; gf2 = 2 * gv2 - gf2;
  mix = gv2;
) : ( gf1 = 0; gf2 = 0; );

mix = mix * v1_g + amix;
mix *= lx_pcg;                                   // (a sound change: the effects' inputs fade too, so no cut reaches them)
// chorus / three-phase ensemble
cbuf[cwp] = mix;
ca = chor * chor_k * (1 + dg_ch);
ca > 0.001 ? (
  cps += crate * (1 + 0.15 * ins_fx) / srate; cps >= 1 ? cps -= 1;
  cpf += 5.5 / srate; cpf >= 1 ? cpf -= 1;
  aj = 0; t0 = 0; t1 = 0; t2 = 0;
  loop(3,
    d_ = (0.007 + ((crate > 2 ? 0.0006 : 0.0017) * sin(2 * $pi * cps + aj * 2.0944) + (three ? 0.0004 * sin(2 * $pi * cpf + aj * 2.0944) : 0)) * min(ca, 1.5)) * srate;
    rp2 = cwp - d_; ri = floor(rp2); rf = rp2 - ri;
    tv = cbuf[ri & cmask] * (1 - rf) + cbuf[(ri + 1) & cmask] * rf;
    aj == 0 ? t0 = tv : aj == 1 ? t1 = tv : t2 = tv;
    aj += 1;
  );
  wet = min(ca, 1);
  oL = mix * (1 - 0.5 * wet) + wet * (t0 + 0.5 * t1) * 0.7;
  oR = mix * (1 - 0.5 * wet) + wet * (t2 + 0.5 * t1) * 0.7;
) : ( oL = mix; oR = mix; );
cwp = (cwp + 1) & cmask;
// tremolo (stereo, as an autopan)
trem > 0 ? ( trph += 4.6 / srate; trph -= floor(trph); tw = sin(2 * $pi * trph) * trem; oL *= 1 - tw; oR *= 1 + tw; );
// tempo-synced ping-pong echo
dl_mix > 0 || dl_tail > 0.00001 ? (
  drp = dl_w - dl_len; drp < 0 ? drp += 131072;
  dyL = DLB[drp]; dyR = DLB[131072 + drp];
  dlpL += (dyL - dlpL) * 0.35; dlpR += (dyR - dlpR) * 0.35;           // each repeat a little darker
  DLB[dl_w] = (oL + oR) * 0.5 * (dl_mix > 0) + dlpR * dl_fb;
  DLB[131072 + dl_w] = dlpL * dl_fb;
  dl_w = (dl_w + 1) % 131072;
  oL += dyL * dl_mix * 1.4; oR += dyR * dl_mix * 1.4;
  dl_tail = max(abs(dyL), abs(dyR)) * 0.001 + dl_tail * 0.999;
);

// ---------- FX (both voices): CHORUS > DELAY > PAN / TREM, each faded in / out as its amount comes up from 0 (15 ms) ----------
fc_g += (fc_on - fc_g) * att_k;
fc_g > 0.0001 ? (
  fc_clr = 0;
  fc_dp += (fc_dp_t - fc_dp) * sm; fc_mx += (fc_mx_t - fc_mx) * sm;
  FXC[fc_w] = oL; FXC[8192 + fc_w] = oR;
  fc_ph += fc_rt / srate; fc_ph -= floor(fc_ph);
  fx_d = (0.008 + 0.0045 * fc_dp * sin(2 * $pi * fc_ph)) * srate;       // the two sides swing in quadrature
  fx_p = fc_w - fx_d; fx_i = floor(fx_p); fx_f = fx_p - fx_i;
  fx_l = FXC[fx_i & 8191] * (1 - fx_f) + FXC[(fx_i + 1) & 8191] * fx_f;
  fx_d = (0.008 + 0.0045 * fc_dp * cos(2 * $pi * fc_ph)) * srate;
  fx_p = fc_w - fx_d; fx_i = floor(fx_p); fx_f = fx_p - fx_i;
  fx_r = FXC[8192 + (fx_i & 8191)] * (1 - fx_f) + FXC[8192 + ((fx_i + 1) & 8191)] * fx_f;
  fc_w = (fc_w + 1) & 8191;
  fx_m = fc_mx * fc_g;                                                       // (at full MIX: 0.65 dry + 0.65 wet, level kept)
  oL = oL * (1 - 0.35 * fx_m) + fx_l * 0.65 * fx_m; oR = oR * (1 - 0.35 * fx_m) + fx_r * 0.65 * fx_m;
);
fd_g += (fd_on - fd_g) * att_k;
fd_g > 0.0001 ? (
  fd_clr = 0;
  fd_ds < 0 ? fd_ds = fd_dt;
  fd_ds += (fd_dt - fd_ds) * fd_k;                                          // a new TIME glides (tape-like), never jumps
  fd_fb += (fd_fb_t - fd_fb) * sm; fd_mx += (fd_mx_t - fd_mx) * sm; fd_ppg += (fd_pp - fd_ppg) * att_k;
  fx_p = fd_w - fd_ds; fx_i = floor(fx_p); fx_f = fx_p - fx_i;
  fx_l = FXD[fx_i & (FXDN - 1)] * (1 - fx_f) + FXD[(fx_i + 1) & (FXDN - 1)] * fx_f;
  fx_r = FXD[FXDN + (fx_i & (FXDN - 1))] * (1 - fx_f) + FXD[FXDN + ((fx_i + 1) & (FXDN - 1))] * fx_f;
  fd_lpL += (fx_l - fd_lpL) * 0.4; fd_lpR += (fx_r - fd_lpR) * 0.4;        // each repeat a little darker
  // PING-PONG: the input enters on the left and the repeats cross sides; off: each side repeats on itself
  FXD[fd_w] = (oL * (1 - fd_ppg) + (oL + oR) * 0.5 * fd_ppg) * fd_g + fd_fb * (fd_lpL * (1 - fd_ppg) + fd_lpR * fd_ppg);
  FXD[FXDN + fd_w] = oR * (1 - fd_ppg) * fd_g + fd_fb * (fd_lpR * (1 - fd_ppg) + fd_lpL * fd_ppg);
  fd_w = (fd_w + 1) & (FXDN - 1);
  oL += fx_l * fd_mx * fd_g; oR += fx_r * fd_mx * fd_g;
);
fp_g += (fp_on - fp_g) * att_k;
fp_g > 0.0001 ? (
  fp_dp += (fp_dp_t - fp_dp) * sm; fp_pg += (fp_pan - fp_pg) * att_k;
  fp_ph += fp_rt / srate; fp_ph -= floor(fp_ph);                            // a running phase: RATE changes never jump
  fx_s = sin(2 * $pi * fp_ph);
  fx_t = 1 - fp_dp * (0.5 - 0.5 * fx_s);                                    // tremolo: the level dips
  fx_l = sqrt(1 - fp_dp * fx_s); fx_r = sqrt(1 + fp_dp * fx_s);             // autopan: equal power, side to side
  fx_l = fx_t * (1 - fp_pg) + fx_l * fp_pg; fx_r = fx_t * (1 - fp_pg) + fx_r * fp_pg;
  oL *= 1 + (fx_l - 1) * fp_g; oR *= 1 + (fx_r - 1) * fp_g;
);

// ---------- reverb send ----------
rv_on || rv_tail > 0.00001 ? (
  rin = 0.5 * (oL + oR) * (rv_on ? 1 : 0);
  rpre_b[rpre_w] = rin;
  rq = rpre_w - floor(rpre); rq < 0 ? rq += rpre_len;
  rd = rpre_b[rq];
  rpre_w += 1; rpre_w >= rpre_len ? rpre_w = 0;
  ak = 0;
  loop(4,
    rn = floor(rapl[ak] * srate / 48000 * (0.6 + 0.4 * rdiff));
    ro = rap_b + ak * 4096; rw = rapw[ak];
    rr = rw - rn; rr < 0 ? rr += 4096;
    rbv = ro[rr]; ryv = -rdiff * 0.75 * rd + rbv; ro[rw] = rd + rdiff * 0.75 * ryv; rd = ryv;
    rapw[ak] = (rw + 1) % 4096;
    ak += 1;
  );
  ak = 0;
  loop(8,
    rlph[ak] += rlrt[ak] / srate; rlph[ak] >= 1 ? rlph[ak] -= 1;
    rm = rmod * srate * sin(2 * $pi * rlph[ak]);
    rp3 = rlw[ak] - rllen[ak] - rm; rp3 < 0 ? rp3 += RBLK;
    ri3 = floor(rp3); rf3 = rp3 - ri3; ro = rln_b + ak * RBLK;
    rv3 = ro[ri3 % RBLK] * (1 - rf3) + ro[(ri3 + 1) % RBLK] * rf3;
    rlz[ak] = rlgb[ak] * rv3 + rlga[ak] * rlz[ak];
    rtmp[ak] = rlz[ak];
    ak += 1;
  );
  ra0 = rtmp[0]; ra1 = rtmp[1]; ra2 = rtmp[2]; ra3 = rtmp[3]; ra4 = rtmp[4]; ra5 = rtmp[5]; ra6 = rtmp[6]; ra7 = rtmp[7];
  rb0 = ra0 + ra1; rb1 = ra0 - ra1; rb2 = ra2 + ra3; rb3 = ra2 - ra3; rb4 = ra4 + ra5; rb5 = ra4 - ra5; rb6 = ra6 + ra7; rb7 = ra6 - ra7;
  rc0 = rb0 + rb2; rc1 = rb1 + rb3; rc2 = rb0 - rb2; rc3 = rb1 - rb3; rc4 = rb4 + rb6; rc5 = rb5 + rb7; rc6 = rb4 - rb6; rc7 = rb5 - rb7;
  rmix[0] = (rc0 + rc4) * 0.35355339; rmix[1] = (rc1 + rc5) * 0.35355339; rmix[2] = (rc2 + rc6) * 0.35355339; rmix[3] = (rc3 + rc7) * 0.35355339;
  rmix[4] = (rc0 - rc4) * 0.35355339; rmix[5] = (rc1 - rc5) * 0.35355339; rmix[6] = (rc2 - rc6) * 0.35355339; rmix[7] = (rc3 - rc7) * 0.35355339;
  ak = 0;
  loop(8,
    ro = rln_b + ak * RBLK;
    ro[rlw[ak]] = rmix[ak] + rd * (ak & 1 ? -0.5 : 0.5);
    rlw[ak] += 1; rlw[ak] >= RBLK ? rlw[ak] = 0;
    ak += 1;
  );
  rvL = (ra0 - ra2 + ra4 - ra6 + 0.5 * (ra1 + ra5)) * 0.5;
  rvR = (ra1 - ra3 + ra5 - ra7 + 0.5 * (ra2 - ra6)) * 0.5;
  rv_tail = max(abs(rvL), abs(rvR)) * 0.001 + rv_tail * 0.999;
  oL += rvL * rv_wet * 0.6; oR += rvR * rv_wet * 0.6;
);

out_s += (out_t - out_s) * sm;
ptr_s = patch_trim(snd);                        // follows the sound in use at once (a sound change is a discrete event)
oL = ostL.ost_band((oL) * ptr_s * lx_pcg) * out_s;
oR = ostR.ost_band((oR) * ptr_s * lx_pcg) * out_s;
ins_stereo(oL, oR); ost_out(ins_sl, ins_sr);           // mono-maker / widener, then the output stage
spl0 = ost_l;
spl1 = ost_r;
pkL = max(pkL * pk_dec, abs(spl0)); pkR = max(pkR * pk_dec, abs(spl1));   // (the meters fall here: @gfx only reads them)

@gfx 1080 820
ui_thm = 10; ui_hw = 1;
ui_begin(1080, 820);

// ---------- helpers (design units x sc) ----------
function kx_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kx_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function kx_txt(x, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = x * sc; gfx_y = y * sc - h * 0.5; gfx_drawstr(t); );
function kx_rtxt(x, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = x * sc - w; gfx_y = y * sc - h * 0.5; gfx_drawstr(t); );
function kx_ctxt(x, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = x * sc - w * 0.5; gfx_y = y * sc - h * 0.5; gfx_drawstr(t); );
function kx_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a section: recessed face, a 32-high title band (title on its centre line, a coloured rule under it), content below
function kx_sect(x, y, w, h, t, shade, col) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  ui_col(ui_mix(shade, 0x000000, 0.25)); kx_r(x, y, w, 32);
  ui_col(col); kx_r(x, y + 31, w, 2);
  gfx_setfont(6, "Trebuchet MS", 16 * sc, 'b'); ui_col(INKL); kx_txt(x + 14, y + 17, t);
);
// a dark menu box with its label above
function kx_box(x, y, w, h, lb, t) (
  gfx_setfont(12); ui_cola(INKL, 0.75); kx_txt(x, y - 11, lb);
  ui_col(0x14100D); kx_rr(x, y, w, h, 4);
  gfx_setfont(11); ui_col(INKL); kx_txt(x + 12, y + h * 0.5, t);
);
// a voice's sound: [LCD] with ◄ ► beside it (voice 1: arrows on the left; voice 2: on the right) - a click on the LCD lists the sounds
function kx_voice(x, y, tg, arl) local(lx, ax, q, sv) (
  sv = tg ? slider27 : slider1; q = snd_pos(sv);
  lx = arl ? x + 54 : x; ax = arl ? x : x + 194;
  ui_noled = 1;
  ui_button(ax * sc, y * sc, 24 * sc, 34 * sc, "◄", 0, 1) ? ( sv = mord[(q + NSND - 1) % NSND]; tg ? ( slider27 = sv; ui_auto(27); ) : ( slider1 = sv; slider_automate(1); ); );
  ui_button((ax + 26) * sc, y * sc, 24 * sc, 34 * sc, "►", 0, 1) ? ( sv = mord[(q + 1) % NSND]; tg ? ( slider27 = sv; ui_auto(27); ) : ( slider1 = sv; slider_automate(1); ); );
  ui_noled = 0;
  pk_lcd(lx * sc, y * sc, 190 * sc, 34 * sc, 1);
  pk_lcdfont(7, 16 * sc); ui_col(pk_lcdc); kx_txt(lx + 10, y + 17, sname(tg ? slider27 : slider1));
  pressed && drag_id == 0 && kx_hov(lx, y, 190, 34) ? ( drag_id = -1; snd_menu(lx * sc, (y + 36) * sc, tg); );
);
// a centred dial's hover value: "AS MADE" at 0, else the time factor
// a pastel desk-knob cap for the next knob (ui_knob clears these after each knob)
function kx_pc(c, r) ( ui_kdesk = c; ui_kdesk_r = r; );
function kx_tf(v) ( abs(v) < 0.5 ? "AS MADE" : ( sprintf(#kf, "x%.2f", 4 ^ (v / 100)); #kf; ); );
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');    // small print
gfx_setfont(11, "Trebuchet MS", 16 * sc, 'b');    // box text

// ---------- chassis: dark brown workstation, voice 1 teal, voice 2 amber ----------
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
pk_chassis(8 * sc, 4 * sc, 1064 * sc, 778 * sc, BRW);
ui_col(TEAL); kx_r(8, 66, 1064, 2);
ui_col(TEAL); gfx_circle(40 * sc, 35 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(BRW); ui_text(40 * sc, 30 * sc, "GFX");
gfx_setfont(6, "Trebuchet MS", 28 * sc, 'b'); ui_col(INKL); gfx_x = 66 * sc; gfx_y = 10 * sc; gfx_drawstr("K50");
gfx_setfont(12); ui_cola(INKL, 0.7); gfx_x = 67 * sc; gfx_y = 44 * sc; gfx_drawstr("DIGITAL SOUND WORKSTATION");
pk_led(148 * sc, 25 * sc, 4 * sc, ins_midi_lit() || nact > 0, REDL);
gfx_setfont(12); ui_col(INKL); kx_txt(158, 25, "MIDI IN");

// ---------- the COMBI bar: [COMBI][◄][►][LCD] - a combi loads both voices, their blend, their controls and the FX ----------
prs_cur_d > 0 ? ( kx_prs = prs_cur_d; prs_cur_d = 0; );
kx_prs > 0 && (PRB[kx_prs] != slider1 || PR2[kx_prs] != slider27) ? kx_prs = 0;      // another sound chosen: no combi
ui_noled = 1; ui_button(300 * sc, 17 * sc, 64 * sc, 34 * sc, "COMBI", 0, 1) ? combi_menu(300 * sc, 53 * sc);
ui_button(368 * sc, 17 * sc, 24 * sc, 34 * sc, "◄", 0, 1) ? ( kx_prs = kx_prs > 0 ? (kx_prs + NPR - 2) % NPR + 1 : NPR; prs_dirty = kx_prs; );
ui_button(394 * sc, 17 * sc, 24 * sc, 34 * sc, "►", 0, 1) ? ( kx_prs = kx_prs > 0 ? kx_prs % NPR + 1 : 1; prs_dirty = kx_prs; );
ui_noled = 0;
pk_lcd(424 * sc, 17 * sc, 300 * sc, 34 * sc, 1);
pk_lcdfont(7, 20 * sc); ui_col(pk_lcdc); kx_txt(436, 34, kx_prs > 0 ? pname(kx_prs) : "- - -");
pressed && drag_id == 0 && kx_hov(424, 17, 300, 34) ? ( drag_id = -1; combi_menu(424 * sc, 53 * sc); );
pk_ledbtn(748 * sc, 20 * sc, 28 * sc, 28 * sc, 0, REDL) ? panic_dirty = 1;
gfx_setfont(12); ui_col(INKL); kx_txt(781, 34, "PANIC");
ui_size_picker(998 * sc, 25 * sc);

// ---------- the BLEND strip: VOICE 1 (sound, LEVEL) | MIX | VOICE 2 (mirrored) ----------
pk_inset(16 * sc, 80 * sc, 1048 * sc, 140 * sc, SH1);
ui_col(ui_mix(SH1, 0x000000, 0.25)); kx_r(16, 80, 1048, 32);
ui_col(TEAL); kx_r(16, 111, 384, 2); ui_col(INKL); kx_r(400, 111, 280, 2); ui_col(V2C); kx_r(680, 111, 384, 2);
ui_col(ui_mix(SH1, 0x000000, 0.4)); kx_r(399, 113, 2, 107); kx_r(679, 113, 2, 107);
gfx_setfont(6, "Trebuchet MS", 16 * sc, 'b'); ui_col(INKL);
kx_txt(30, 97, "VOICE 1"); kx_ctxt(540, 97, "ATTACK BLEND"); kx_rtxt(1050, 97, "VOICE 2");
kx_voice(30, 141, 0, 1);
kx_voice(806, 141, 1, 0);
ui_section(2); C_INK = INKL;
kx_pc(0x9FDCC6, 20); ui_knob(340 * sc, 158 * sc, 32, -48, 6, 0, 0, "LEVEL", slider32 <= -47.95 ? "OFF" : "%+.1f dB");
kx_pc(0xF4C49A, 20); ui_knob(740 * sc, 158 * sc, 31, -48, 6, 0, 0, "LEVEL", slider31 <= -47.95 ? "OFF" : "%+.1f dB");
// MIX: a desk knob, "1" and "2" printed at its ends (towards 1: voice 1 the attack, voice 2 the body)
kx_pc(0xC9B8EA, 28); ui_kdesk_x = 1; ui_kdesk_d = 4;
ui_knob(540 * sc, 156 * sc, 28, -100, 100, 0, 0, "MIX", slider28 < -99.5 ? "1 ATTACK" : slider28 > 99.5 ? "2 ATTACK" : abs(slider28) < 0.5 ? "BOTH BODY" : "%+.0f");
gfx_setfont(11);
ui_col(TEAL); kx_ctxt(540 - 30, 156 + 30, "1");
ui_col(V2C); kx_ctxt(540 + 30, 156 + 30, "2");
// ATTACK BLEND circles, one each side of MIX: each voice's share of the note. At rest a voice that is all attack is
// a small circle and one that is all body a wide one; each note pops both by its velocity (brighter glow too), then
// the attack voice shrinks back as its gate falls while the body voice stays wide.
bl_cnt_d != bl_seen ? ( bl_seen = bl_cnt_d; bl_t0 = time_precise(); bl_v = bl_vel_d; );
bl_h += ((nact > 0) - bl_h) * 0.12;
bl_t = time_precise() - bl_t0;
bl_i = 0;
loop(2,
  bl_ab = bl_i ? (slider28 > 0 ? 1 - slider28 / 100 : 1) : (slider28 < 0 ? 1 + slider28 / 100 : 1);
  bl_l = max(slider(bl_i ? 29 : 30), 20) / 1000;
  bl_g = bl_t < 0.35 * bl_l ? 1 : bl_t < bl_l ? bl_ab + (1 - bl_ab) * 0.5 * (1 + cos($pi * (bl_t - 0.35 * bl_l) / (0.65 * bl_l))) : bl_ab;
  bl_x = bl_i ? 625 : 455; bl_c = bl_i ? V2C : TEAL;
  (bl_i ? slider31 : slider32) <= -47.95 ? (
    ui_cola(INKL, 0.25); gfx_circle(bl_x * sc, 156 * sc, 6 * sc, 0, 1);
  ) : (
    bl_r = 6 + 14 * (bl_ab + (bl_g - bl_ab) * bl_h) + 6 * bl_v * bl_h * bl_g;
    bl_gw = 0.3 + 0.7 * bl_v * bl_h * bl_g;
    bl_k = 6; loop(6, ui_cola(bl_c, 0.06 * bl_gw); gfx_circle(bl_x * sc, 156 * sc, (bl_r + bl_k * 1.6) * sc, 1, 1); bl_k -= 1; );
    ui_cola(ui_mix(bl_c, 0x000000, 0.45 - 0.35 * bl_gw), 1); gfx_circle(bl_x * sc, 156 * sc, bl_r * sc, 1, 1);
    ui_cola(ui_mix(bl_c, 0xFFF6E0, 0.45 * bl_gw), 0.9); gfx_circle(bl_x * sc, 156 * sc, bl_r * 0.55 * sc, 1, 1);
  );
  bl_i += 1;
);
gfx_a = 1;
// a voice whose LEVEL is off is greyed
slider32 <= -47.95 ? ( ui_cola(SH1, 0.55); kx_r(18, 114, 290, 104); );
slider31 <= -47.95 ? ( ui_cola(SH1, 0.55); kx_r(772, 114, 290, 104); );

// ---------- the two voices: FILTER & TUNE and AMP ENVELOPE, the same on each side ----------
kx_vx = 16; kx_v = 0;
loop(2,
  kx_sect(kx_vx, 232, 516, 268, kx_v ? "VOICE 2" : "VOICE 1", SH2, kx_v ? V2C : TEAL);
  gfx_setfont(12); ui_cola(INKL, 0.75); kx_rtxt(kx_vx + 502, 249, sname(kx_v ? slider27 : slider1));
  gfx_setfont(12); ui_cola(INKL, 0.7); kx_txt(kx_vx + 16, 280, "FILTER & TUNE"); kx_txt(kx_vx + 16, 404, "AMP ENVELOPE");
  ui_col(ui_mix(SH2, 0x000000, 0.35)); kx_r(kx_vx + 12, 380, 492, 1);
  ui_section(2); C_INK = INKL;
  kx_pc(0xA8CBEE, 20); ui_knob((kx_vx + 86) * sc,  320 * sc, kx_v ? 39 : 17, -6, 3, 0, 0, "CUTOFF", slider(kx_v ? 39 : 17) > -0.005 && slider(kx_v ? 39 : 17) < 0.005 ? "OPEN" : "%+.2f oct");
  kx_pc(0xA8CBEE, 20); ui_knob((kx_vx + 200) * sc, 320 * sc, kx_v ? 40 : 18, 0, 100, 0, 0, "RESO", "%.0f%%");
  kx_pc(0xA8CBEE, 20); ui_knob((kx_vx + 314) * sc, 320 * sc, kx_v ? 41 : 2, 0, 100, 50, 0, "TONE", "%.0f%%");
  kx_pc(0xA8CBEE, 20); ui_knob((kx_vx + 428) * sc, 320 * sc, kx_v ? 47 : 7, -24, 24, 0, 0, "TUNE", abs(slider(kx_v ? 47 : 7)) < 0.005 ? "0 st" : "%+.2f st");
  drag_id == (kx_v ? 47 : 7) && !(mouse_cap & 8) && slider(drag_id) != floor(slider(drag_id) + 0.5) ? (   // whole semitones; Shift: cents
    slider(drag_id) = floor(slider(drag_id) + 0.5); ui_auto(drag_id); );
  kx_pc(0xB9E0A5, 20); ui_knob((kx_vx + 86) * sc,  444 * sc, kx_v ? 52 : 3, -100, 100, 0, 0, "ATTACK", kx_tf(slider(kx_v ? 52 : 3)));
  kx_pc(0xB9E0A5, 20); ui_knob((kx_vx + 200) * sc, 444 * sc, kx_v ? 53 : 26, -100, 100, 0, 0, "DECAY", kx_tf(slider(kx_v ? 53 : 26)));
  kx_pc(0xB9E0A5, 20); ui_knob((kx_vx + 314) * sc, 444 * sc, kx_v ? 54 : 36, -100, 100, 0, 0, "SUSTAIN", abs(slider(kx_v ? 54 : 36)) < 0.5 ? "AS MADE" : "%+.0f%%");
  kx_pc(0xB9E0A5, 20); ui_knob((kx_vx + 428) * sc, 444 * sc, kx_v ? 55 : 4, -100, 100, 0, 0, "RELEASE", kx_tf(slider(kx_v ? 55 : 4)));
  (kx_v ? slider31 : slider32) <= -47.95 ? ( ui_cola(SH2, 0.55); kx_r(kx_vx + 2, 266, 512, 232); );
  kx_vx = 548; kx_v += 1;
);

// ---------- FX: one set for both voices ----------
kx_sect(16, 512, 1048, 140, "FX  -  BOTH VOICES", SH1, INKL);
ui_section(2); C_INK = INKL;
kx_pc(0xF0DD92, 20); ui_knob(160 * sc, 598 * sc, 35, 0, 100, 0, 0, "CHORUS", slider35 < 0.5 ? "OFF" : "%.0f%%");
kx_pc(0xF0DD92, 20); ui_knob(360 * sc, 598 * sc, 51, 0, 100, 0, 0, "PAN / TREM", slider51 < 0.5 ? "OFF" : "%.0f%%");
kx_pc(0xF0DD92, 20); ui_knob(560 * sc, 598 * sc, 45, 0, 100, 0, 0, "DELAY", slider45 < 0.5 ? "OFF" : "%.0f%%");
kx_box(620, 581, 150, 34, "DELAY SYNC", slider43 == 0 ? "FREE" : slider43 == 1 ? "1/16" : slider43 == 2 ? "1/8 TRIPLET" : slider43 == 3 ? "1/8" :
  slider43 == 4 ? "1/8 DOTTED" : slider43 == 5 ? "1/4 TRIPLET" : slider43 == 6 ? "1/4" : slider43 == 7 ? "1/4 DOTTED" : slider43 == 8 ? "1/2" : "1 BAR");
pressed && drag_id == 0 && kx_hov(620, 581, 150, 34) ? ( drag_id = -1;
  #gxm = ""; gx_i = 0; loop(10, strcat(#gxm, slider43 == gx_i ? "!" : "");
    strcat(#gxm, gx_i == 0 ? "Free (375 ms)" : gx_i == 1 ? "1/16" : gx_i == 2 ? "1/8 triplet" : gx_i == 3 ? "1/8" : gx_i == 4 ? "1/8 dotted" :
      gx_i == 5 ? "1/4 triplet" : gx_i == 6 ? "1/4" : gx_i == 7 ? "1/4 dotted" : gx_i == 8 ? "1/2" : "1 bar"); gx_i < 9 ? strcat(#gxm, "|"); gx_i += 1; );
  gfx_x = 620 * sc; gfx_y = 617 * sc; gx_i = gfx_showmenu(#gxm); gx_i > 0 ? ( slider43 = gx_i - 1; ui_auto(43); ); );
kx_pc(0xF0DD92, 20); ui_knob(920 * sc, 598 * sc, 23, 0, 100, 25, 0, "REVERB", slider23 < 0.5 ? "OFF" : "%.0f%%");

// ---------- OUTPUT: DRIFT | MIDI | MASTER ----------
pk_inset(16 * sc, 664 * sc, 1048 * sc, 140 * sc, SH3);
ui_col(ui_mix(SH3, 0x000000, 0.25)); kx_r(16, 664, 1048, 32);
ui_col(TEAL); kx_r(16, 695, 1048, 2);
ui_col(ui_mix(SH3, 0x000000, 0.4)); kx_r(220, 697, 2, 107); kx_r(660, 697, 2, 107);
gfx_setfont(6, "Trebuchet MS", 16 * sc, 'b'); ui_col(INKL);
kx_txt(30, 681, "DRIFT"); kx_txt(236, 681, "MIDI"); kx_txt(676, 681, "MASTER");
ui_section(2); C_INK = INKL;
kx_pc(0xEDB7B0, 20); ui_knob(118 * sc, 754 * sc, 8, 0, 100, 50, 0, "DRIFT", "%.0f%%");
sprintf(#gch, "%d", slider9);
kx_box(250, 737, 130, 34, "CHANNEL", slider9 < 0.5 ? "OMNI" : #gch);
