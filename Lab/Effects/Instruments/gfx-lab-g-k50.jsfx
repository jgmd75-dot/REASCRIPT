in_pin:none
out_pin:left output
out_pin:right output

@init
fl_ok = 0;
#ui_man = "gfx-lab-g-k50";
ext_noinit = 1;                                  // the ? pop-up links to this manual

NV = 12; VS = 172;
VB = 1000;                       // voice blocks: VB + v * 64
// field offsets
F_N = 0; F_G = 1; F_S = 2; F_ACT = 3; F_AGE = 4; F_VEL = 5; F_F0 = 6; F_AE = 7; F_AST = 8; F_FE = 9; F_FST = 10;
F_P1 = 11; F_P2 = 12; F_P3 = 13; F_S1 = 14; F_S2 = 15; F_S3 = 16; F_S4 = 17;
F_O1 = 18; F_O2 = 19; F_O3 = 20; F_O4 = 21; F_E1 = 22; F_E2 = 23; F_E3 = 24; F_E4 = 25; F_VT = 26;
F_MS = 27; F_MC = 31; F_MA = 35; F_MD = 39; F_MWS = 43; F_MWC = 47; F_CLK = 51;
F_DCO = 64; F_DCF = 65; F_PY = 66; F_ATK = 67; F_PY2 = 68;   // de-click: offset, flag, last two outputs, fade-in
F_PE = 69; F_HN = 70; F_HL = 71;                              // pitch envelope, hammer / click noise state
P_MS = 72; P_MC = 88; P_MA = 104; P_MD = 120; P_WS = 136; P_WC = 152;   // 16 partials (piano, organ)
F_KW = 55; F_KL = 56; F_KLP = 57; F_KAP = 58; F_KG = 59; F_KPO = 60; F_KHP = 61; F_KX = 62; F_DT = 63;
KSB = 30000; KSL = 4096;         // clav string delay lines, one per voice
evq = 4000;                      // MIDI event queue
cbuf = 8192; cmask = 8191;       // chorus delay line
LWN = 4; LWB = VB + NV * VS; LKV = 170;      // the split's lower part: 4 voice blocks after the main ones; its strings at KSB + 170 * KSL
// voice 2: 8 voices of its own (blocks at AVB, strings at KSB + 180 * KSL); fields 168 - 170 of a block (both voices):
// the attack gate's time (s), this note's length and level (DRIFT)
NA = 8; AVB = 20000; AKV = 180; F_AG = 168; F_AL = 169; F_AV = 170;
LBOD = 21500; LATT = 21700; SBOD = 21900; SATT = 21950;      // the two voices' sound settings and filter / glide states
memset(AVB, 0, NA * VS); memset(KSB + AKV * KSL, 0, NA * KSL);
// FX RACK lines: chorus 2 x 8192, flanger 2 x 4096, delay 2 x 524288 (up to 2 s at 192 kHz)
FXC = 1048576; FXF = FXC + 16384; FXD = FXF + 8192; FXDN = 524288;
memset(FXC, 0, 16384 + 8192 + 2 * FXDN);
fc_w = fd_w = 0; fc_g = fd_g = fp_g = 0; fc_ph = fp_ph = 0; fd_lpL = fd_lpR = 0; fd_ds = -1;
cvb = VB; cnv = NV; cks = 0; cisatt = 0; att_cur = -1; att_og = 0; att_xg = 1; att_pend = 0; att_n = 0;
memset(VB, 0, (NV + LWN) * VS); memset(KSB, 0, NV * KSL); memset(KSB + LKV * KSL, 0, LWN * KSL); memset(cbuf, 0, 8192);
age = 0; pedal = 0; modw = 0; cwp = 0; cps = 0; cpf = 0; mono_n = -1; mono_f = 0;

// organ registrations (amplitudes for 16' 8' 5 1/3' 4' 2 2/3' 2' 1 3/5' 1 1/3' 1'): 0 the 888 drawbar sound,
// 1 drawbars all out, 2 a cathedral principal chorus with mixture, 3 a harmonium reed
ORG = 17400;
ORG[0] = 0.8; ORG[1] = 0.8; ORG[2] = 0.8; ORG[3] = 0.45; ORG[4] = 0.25; ORG[5] = 0.2; ORG[6] = 0.06; ORG[7] = 0.06; ORG[8] = 0.06;
ORG[9] = 0.7; ORG[10] = 0.7; ORG[11] = 0.7; ORG[12] = 0.7; ORG[13] = 0.7; ORG[14] = 0.7; ORG[15] = 0.7; ORG[16] = 0.7; ORG[17] = 0.7;
ORG[18] = 0.6; ORG[19] = 0.9; ORG[20] = 0.15; ORG[21] = 0.6; ORG[22] = 0.3; ORG[23] = 0.4; ORG[24] = 0.2; ORG[25] = 0.25; ORG[26] = 0.3;
ORG[27] = 0; ORG[28] = 1; ORG[29] = 0; ORG[30] = 0.55; ORG[31] = 0.4; ORG[32] = 0.3; ORG[33] = 0.24; ORG[34] = 0.2; ORG[35] = 0.12;

function svf_set(f, q) instance(a1, a2, a3, k) local(g) (
  g = tan($pi * min(f, srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf_bp(x) instance(a1, a2, a3, k, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  v1;
);
function tanh_(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1) );
function blep(t, dt) (
  t < dt ? ( t /= dt; t + t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0;
);
function saw(p, dt) ( 2 * p - 1 - blep(p, dt) );
function sqw(p, dt) local(q) ( q = p + 0.5; q >= 1 ? q -= 1; (p < 0.5 ? 1 : -1) + blep(p, dt) - blep(q, dt) );
function tc(t) ( exp(-1 / (max(t, 0.0005) * srate)) );

// ---------- the sounds: settings used when a key is struck ----------
function patch_set(s) (
  snd = s;
  eng = s == 0 || s == 25 || s == 64 || s == 65 || s == 94 ? 1 : s == 1 ? 2 : s == 2 ? 3 : s == 24 || s == 38 || s == 66 || s == 67 ? 4 :
        s == 34 || (s >= 69 && s <= 72) ? 5 : 0;
  // 0 analogue, 1 FM, 2 plucked string, 3 metal bar, 4 synthetic piano, 5 drawbar organ
  // analogue defaults
  o2w = 0; det = 0.006; subl = 0; o2l = 1; fbase = 1200; famt = 1.5; fres = 0.2; ktrk = 0.5;
  aA = 0.01; aD = 0.5; aS = 0.8; aR = 0.4; fA = 0.01; fD = 0.6; fS = 0.3; vib = 0; vibd = 0.4; mono = 0; glide = 0;
  chor = 0.3; three = 0; flfo = 0; lvl = 0.5;
  // layers (off by default): bell partials, plucked string, breath + chiff, osc 1 sine, formant "aah"
  bl_lvl = 0; bR0 = 1; bR1 = 2; bR2 = 3; bR3 = 4; bA0 = 1; bA1 = 0.5; bA2 = 0.3; bA3 = 0.15; bD0 = 1; bD1 = 0.5; bD2 = 0.25; bD3 = 0.12;
  ks_lvl = 0; ks_T = 1; ks_br = 0.4; ks_pick = 0; br_lvl = 0; chf = 0; o1w = 0; vamix = 1; form = 0;
  // extras: pitch envelope (semitones, s), velocity to filter, echo (mix, beats, feedback), tremolo, chorus rate,
  // rhythmic loop layer, piano brightness / decay / unison, organ percussion
  pe_amt = 0; pe_t = 0.1; vf = 0; brp = 0; dl_mix = 0; dl_bt = 0.75; dl_fb = 0.35; trem = 0; crate = 0.6; nd = 0;
  pn_hard = 0.6; pn_T = 1; pn_uni = 1; pn_knock = 1; pn_ch = 0.3; org_perc = 0;
  at_f = 0; at_v = 0; at_l = 0;
  spl_on = 0; spl_pt = 60; lw_type = 0; lw_lvl = 1;   // the split: lower part below C4 (1 upright, 2 electric, 3 slap bass, 4 e-piano, 5 log drum)
  ks_bite = 0;                                   // the pluck layer driven hard (grit)
  fm_bark = 1; fm_tine = 1; fm_dk = 1; fm_tr = 14;   // FM e-piano: body bark, tine level, decay, tine ratio
  org_reg = 0; org_at = 0; org_rt = 0.03; org_clk = 1;   // organ: registration, speak time, release, key click                 // aftertouch: filter (octaves), vibrato (x mod wheel), swell (x level)
  s == 3 ? ( det = 0.009; fbase = 700; famt = 1.6; fres = 0.25; aA = 0.6; aD = 1; aS = 0.85; aR = 1.6; fA = 1.2; fD = 2; fS = 0.5; chor = 0.6; lvl = 0.3; ) :
  s == 4 ? ( det = 0.004; subl = 0.6; o2l = 0.5; fbase = 420; famt = 0.8; fres = 0.12; aA = 0.9; aD = 1; aS = 0.9; aR = 2.2; fA = 1.5; fD = 2; fS = 0.6; chor = 0.9; flfo = 0.35; lvl = 0.32; ) :
  s == 5 ? ( det = 0.003; o2w = 1; o2l = 0.5; subl = 0.8; fbase = 140; famt = 3.2; fres = 0.45; ktrk = 0.3; aA = 0.002; aD = 0.5; aS = 0.75; aR = 0.12; fA = 0.001; fD = 0.28; fS = 0.15; mono = 1; glide = 0.04; chor = 0; lvl = 0.55; ) :
  s == 6 ? ( det = 0.005; fbase = 2200; famt = 0.6; fres = 0.1; ktrk = 0.8; aA = 0.35; aD = 1; aS = 0.9; aR = 0.8; fA = 0.4; fD = 1; fS = 0.7; vib = 5.3; vibd = 0.5; chor = 0.4; lvl = 0.3; ) :
  s == 7 ? ( det = 0.002; fbase = 4500; famt = 0.3; fres = 0.05; ktrk = 0.6; aA = 0.06; aD = 1; aS = 1; aR = 0.9; fA = 0.05; fD = 1; fS = 0.8; chor = 0.55; three = 1; lvl = 0.28; ) :
  s == 8 ? (   // BELL PAD
    det = 0.008; fbase = 800; famt = 1; fres = 0.15; aA = 0.8; aD = 1; aS = 0.85; aR = 2.2; fA = 1; fD = 2; fS = 0.5; chor = 0.9; lvl = 0.3;
    bl_lvl = 0.5; bR0 = 1; bR1 = 3.52; bR2 = 6.01; bR3 = 8.93; bA0 = 1; bA1 = 0.5; bA2 = 0.3; bA3 = 0.15; bD0 = 2.4; bD1 = 1; bD2 = 0.5; bD3 = 0.25;
  ) : s == 9 ? (   // STACCATO CHOIR
