desc:Calder 88 [hybrid electric keys] (GFX Lab)
//tags: instrument electric-piano keys reed string physical-modelling
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-os (.jsfx-inc) in the same folder.

slider41:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider42:sub_amt=35<0,100,1>-Sub octave (%)
slider43:str_pk=2<0,3,1{Lower,Upper,Both,Both reversed}>-String pickups
slider44:dl_sync=0<0,1,1{Off,On}>-Delay sync
slider45:dl_note=8<0,12,1{1/32,1/16 triplet,1/16,1/16 dotted,1/8 triplet,1/8,1/8 dotted,1/4 triplet,1/4,1/4 dotted,1/2,1/2 dotted,1/1}>-Delay note
slider1:0<0,2,1{Pad,Reed,String}>-Model
slider2:1<0,2,1{Soft,Mid,Bright}>-Timbre
slider3:0<0,1,1{Off,On}>-Dyno
slider4:50<0,100,1>-Body (%)
slider5:1<0,2,1{Light,Normal,Heavy}>-Touch
slider6:50<0,100,1>-Hammer (%)
slider7:50<0,100,1>-Decay (%)
slider8:40<0,100,1>-String resonance (%)
slider9:15<0,100,1>-Detune (%)
slider10:35<0,100,1>-Noise (%)
slider11:0<0,1,1{Off,On}>-Long release
slider12:60<0,100,1>-Width (%)
slider13:0<0,1,1{Off,On}>-Mod 1
slider14:0<0,3,1{Tremolo,Pan,Wah,Ring}>-Mod 1 type
slider15:4.5<0.01,12,0.01>-Mod 1 rate (Hz)
slider16:35<0,100,1>-Mod 1 depth (%)
slider17:0<0,1,1{Off,On}>-Mod 2
slider18:2<0,3,1{Phaser,Flanger,Chorus,Vibe}>-Mod 2 type
slider19:0.6<0.01,12,0.01>-Mod 2 rate (Hz)
slider20:35<0,100,1>-Mod 2 depth (%)
slider21:0<0,1,1{Off,On}>-Delay
slider22:375<20,1500,1>-Delay time (ms)
slider23:30<0,95,1>-Delay feedback (%)
slider24:18<0,100,1>-Delay mix (%)
slider25:0<0,1,1{Off,On}>-Delay ping-pong
slider26:0<0,1,1{Off,On}>-Amp
slider27:0<0,2,1{Round,Bright,Small}>-Amp type
slider28:20<0,100,1>-Amp drive (%)
slider29:0<-12,12,0.1>-Bass (dB)
slider31:0<-12,12,0.1>-Treble (dB)
slider32:0<0,1,1{Off,On}>-Comp
slider33:30<0,100,1>-Comp amount (%)
slider34:1<0,1,1{Off,On}>-Reverb
slider35:1<0,2,1{Room,Stage,Hall}>-Reverb type
slider36:20<0,100,1>-Reverb amount (%)
slider37:0<-24,6,0.1>-Volume (dB)
slider38:1<0,1,1{Low,Normal}>-Drift
slider39:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider40:prs_sel=0<0,28,1{No preset,Init,Pad Classic,Pad Bright,Pad Ballad,Pad Honky,Pad Rock,Pad Echo Wash,Pad Warm Body,Pad Sub Bass,Pad Wide Shimmer,Pad Vibe Ballad,Reed Bark,Reed Tremolo,Reed Pan,Reed Chorus,Soft Reed,Reed Warm Case,Reed Ring Mod,Reed Wah Funk,Reed Sub Lead,String Funk,String Phase,String Dry,String Wah,String Bass Pluck,String Flanged,String Echo Pan,String Vibe Soul}>-Preset

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-os.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(2199023255551, v); slider_show(sub_amt, v); slider_show(str_pk, v); slider_show(dl_sync, v); slider_show(dl_note, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(2199023255551, v); slider_show(sub_amt, v); slider_show(str_pk, v); slider_show(dl_sync, v); slider_show(dl_note, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-calder-88";
ext_noinit = 1;

NV = 20; VS = 160; VB = 100000; SCB = 2000000;
SBUF = 200000;
CB = 560000; CBP = 52000;
MQ = 40000;
DLL = 700000; DLR = 1100000; DLN = 393216;
RV = 1500000; RVN = 32768; RVP = 54000; RVD = 1770000;
MB = 1800000;
PHS = 53000;
DFT = 56000; TMP = 57000;
CZT = 58000;
BOD = 59000; BDN = 16;

function cz_db(x) ( exp(x * 0.11512925464970228); );
function cz_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function cz_cf(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );

function cz_lg(n, a, b, c, d, e, f, g) local(i, t, y0, y1) (
  n = min(max(n, 21), 97);
  i = n < 33 ? 0 : n < 45 ? 1 : n < 57 ? 2 : n < 69 ? 3 : n < 81 ? 4 : 5;
  y0 = i == 0 ? a : i == 1 ? b : i == 2 ? c : i == 3 ? d : i == 4 ? e : f;
  y1 = i == 0 ? b : i == 1 ? c : i == 2 ? d : i == 3 ? e : i == 4 ? f : g;
  t = i < 5 ? (n - 21 - 12 * i) / 12 : (n - 81) / 16;
  exp(log(y0) + (log(y1) - log(y0)) * t);
);

function cz_apd(a, w) local(p) (
  p = atan2(-sin(w), a + cos(w)) - atan2(-a * sin(w), 1 + a * cos(w));
  p > 0 ? p -= 2 * $pi;
  -p / w;
);
function cz_lpd(b, w) ( atan2(b * sin(w), 1 - b * cos(w)) / w; );
function cz_tap(d, w) ( sin((1 - d) * w * 0.5) / sin((1 + d) * w * 0.5); );
function cz_bsr(b) local(be) (
  be = b / sqr(1 - b) * sqr(srate / 48000);
  ((2 * be + 1) - sqrt(4 * be + 1)) / (2 * be);
);

function cz_str(q, f, t60, b, nd, ad, td, slack) local(per, w, dtot, nint, d) (
  per = srate / f; w = 2 * $pi * f / srate;
  dtot = per - nd * cz_apd(ad, w) - cz_lpd(b, w);
  nint = floor(dtot - 0.5 - slack); nint = max(nint, 2);
  d = max(dtot - nint, 0.1);
  q[2] = nint; q[3] = cz_tap(d, w); q[8] = b; q[10] = ad; q[11] = nd;
  q[20] = exp(-6.9078 / (max(t60, 0.01) * f)); q[21] = exp(-6.9078 / (max(td, 0.005) * f));
  q[6] = q[7] = q[20];
);
function cz_retune(p) local(q, rc, f, w, dtot, d) (
  q = p + 30;
  rc = p[28] * exp(-p[9] * p[29]);
  f = p[54] * 2 ^ (rc / 1200); w = 2 * $pi * f / srate;
  dtot = srate / f - q[11] * cz_apd(q[10], w) - cz_lpd(q[8], w);
  d = max(dtot - q[2], 0.1);
  q[3] = cz_tap(d, w);
);
function cz_mode(q, f, g, t60, td, fresh) local(w) (
  w = 2 * $pi * f / srate;
  f >= 0.45 * srate ? g = 0;
  q[4] = g; q[5] = exp(-6.9078 / (max(t60, 0.002) * srate)); q[6] = exp(-6.9078 / (max(td, 0.002) * srate));
  q[7] = cos(w); q[8] = sin(w);
  fresh ? ( q[2] = 0; q[3] = 0; );
);

function bq_set(t, f, q, db) instance(b0, b1, b2, a1, a2) local(ga, w, cw, sw, al, a0, sq) (
  f = min(f, srate * 0.45); ga = 10 ^ (db / 40); w = 2 * $pi * f / srate; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / ga; b0 = (1 + al * ga) / a0; b1 = -2 * cw / a0; b2 = (1 - al * ga) / a0; a1 = b1; a2 = (1 - al / ga) / a0;
  ) : t == 1 ? (
    sq = 2 * sqrt(ga) * al; a0 = (ga + 1) + (ga - 1) * cw + sq;
    b0 = ga * ((ga + 1) - (ga - 1) * cw + sq) / a0; b1 = 2 * ga * ((ga - 1) - (ga + 1) * cw) / a0; b2 = ga * ((ga + 1) - (ga - 1) * cw - sq) / a0;
    a1 = -2 * ((ga - 1) + (ga + 1) * cw) / a0; a2 = ((ga + 1) + (ga - 1) * cw - sq) / a0;
  ) : t == 2 ? (
    sq = 2 * sqrt(ga) * al; a0 = (ga + 1) - (ga - 1) * cw + sq;
    b0 = ga * ((ga + 1) + (ga - 1) * cw + sq) / a0; b1 = -2 * ga * ((ga - 1) + (ga + 1) * cw) / a0; b2 = ga * ((ga + 1) + (ga - 1) * cw - sq) / a0;
    a1 = 2 * ((ga - 1) - (ga + 1) * cw) / a0; a2 = ((ga + 1) - (ga - 1) * cw - sq) / a0;
  ) : t == 3 ? (
    a0 = 1 + al; b0 = (1 + cw) * 0.5 / a0; b1 = -(1 + cw) / a0; b2 = b0; a1 = -2 * cw / a0; a2 = (1 - al) / a0;
  ) : (
    a0 = 1 + al; b0 = (1 - cw) * 0.5 / a0; b1 = (1 - cw) / a0; b2 = b0; a1 = -2 * cw / a0; a2 = (1 - al) / a0;
  );
);
function bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );

function cz_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
#cz_def = "0 1 0 50 1 50 50 40 15 35 0 60 0 0 4.5 35 0 2 0.6 35 0 375 30 18 0 0 0 20 0 0 0 0 30 1 1 20 0 1";
cz_nums(#cz_def, DFT);
#cz_pm = "Init|Pad Classic|Pad Bright|Pad Ballad|Pad Honky|Pad Rock|Pad Echo Wash|Pad Warm Body|Pad Sub Bass|Pad Wide Shimmer|Pad Vibe Ballad|Reed Bark|Reed Tremolo|Reed Pan|Reed Chorus|Soft Reed|Reed Warm Case|Reed Ring Mod|Reed Wah Funk|Reed Sub Lead|String Funk|String Phase|String Dry|String Wah|String Bass Pluck|String Flanged|String Echo Pan|String Vibe Soul";
function cz_pstr(p) (
  p == 2  ? "8:50 35:2 36:22 37:-3" :
  p == 3  ? "2:2 6:65 12:70 32:1 33:34 35:1 36:15" :
  p == 4  ? "2:0 6:30 7:65 8:60 11:1 35:2 36:26 37:-2" :
  p == 5  ? "2:2 6:60 9:85 10:45 35:0 36:16 37:2" :
  p == 6  ? "2:2 6:75 26:1 27:1 28:21 32:1 33:38 35:0 36:11 37:-1" :
  p == 7  ? "2:0 7:80 11:1 17:1 18:2 19:0.25 20:24 21:1 22:450 23:38 24:21 25:1 35:2 36:34 37:-2.5" :
  p == 8  ? "2:0 4:85 42:55 6:40 8:55 12:75 35:1 36:19" :
  p == 9  ? "2:0 4:60 42:90 6:45 7:40 12:30 34:0 37:-2" :
  p == 10 ? "2:2 12:100 17:1 18:2 19:0.35 20:42 21:1 22:500 23:34 24:18 25:1 35:2 36:26 37:1" :
  p == 11 ? "2:1 6:35 11:1 17:1 18:3 19:1.2 20:31 35:2 36:22" :
  p == 12 ? "1:1 2:2 6:70 26:1 27:2 28:28 35:0 36:11 37:-4" :
  p == 13 ? "1:1 13:1 14:0 15:5.5 16:41 36:14" :
  p == 14 ? "1:1 2:0 13:1 14:1 15:3.2 16:64 26:1 27:0 28:14 36:11" :
  p == 15 ? "1:1 2:2 3:1 17:1 18:2 19:0.5 20:31 36:15 37:-3" :
  p == 16 ? "1:1 2:0 6:30 7:70 11:1 17:1 18:3 19:0.8 20:24 35:2 36:22" :
  p == 17 ? "1:1 2:0 4:85 42:45 13:1 14:0 15:4 16:30 26:1 27:0 28:18 36:15" :
  p == 18 ? "1:1 2:2 13:1 14:3 15:8 16:34 21:1 22:300 23:26 24:14 36:11 37:-1" :
  p == 19 ? "1:1 2:2 3:1 13:1 14:2 16:52 26:1 27:2 28:31 32:1 33:38 34:0 37:7.5" :
  p == 20 ? "1:1 42:80 26:1 27:0 28:38 21:1 22:375 23:30 24:15 25:1 36:11 37:-10" :
  p == 21 ? "1:2 2:2 6:65 43:2 26:1 27:1 28:18 32:1 33:30 34:0 37:1" :
  p == 22 ? "1:2 43:1 17:1 18:0 19:0.35 20:38 36:11" :
  p == 23 ? "1:2 2:1 43:0 34:0" :
  p == 24 ? "1:2 2:2 43:3 13:1 14:2 16:45 34:0" :
  p == 25 ? "1:2 2:0 43:0 6:40 26:1 27:0 28:21 29:4 34:0 37:2" :
  p == 26 ? "1:2 2:2 43:1 17:1 18:1 19:0.15 20:42 32:1 33:34 34:0" :
  p == 27 ? "1:2 43:2 13:1 14:1 15:2.5 16:52 21:1 22:333 23:34 24:21 25:1 36:11 37:3" :
  p == 28 ? "1:2 2:0 43:3 17:1 18:3 19:0.8 20:38 26:1 27:0 28:14 36:15 37:3" :
  "";
);
function load_preset(p) local(n, i) (
  i = 0; loop(38, slider(i + 1) = DFT[i]; i += 1; );
  sub_amt = 35; str_pk = 2; dl_sync = 0; dl_note = 8;
  n = cz_nums(cz_pstr(p), TMP);
  i = 0; loop(floor(n / 2), TMP[i * 2] == 43 ? str_pk = TMP[i * 2 + 1] : TMP[i * 2] == 44 ? dl_sync = TMP[i * 2 + 1] : TMP[i * 2] == 45 ? dl_note = TMP[i * 2 + 1] : TMP[i * 2] == 42 ? sub_amt = TMP[i * 2 + 1] : TMP[i * 2] >= 1 && TMP[i * 2] <= 38 ? slider(TMP[i * 2]) = TMP[i * 2 + 1]; i += 1; );
  i = 1; loop(38, slider_automate(2 ^ (i - 1)); i += 1; );
  slider_automate(sub_amt); slider_automate(str_pk); slider_automate(dl_sync); slider_automate(dl_note);
);

function cz_vc(vel) local(v) (
  v = min(max(vel / 127, 0.01), 1);
  cz_touch == 0 ? v ^ 0.6 : cz_touch == 2 ? v ^ 1.6 : v;
);

function cz_noise(th, sw) ( cz_nthe = max(cz_nthe, th * cz_nz); cz_nswe = max(cz_nswe, sw * cz_nz); );

function cz_damp(p) (
  p[154] = 1 - exp(-2 * $pi * min(max(p[54] * 2, 350), 0.4 * srate) / srate);
  p[5] == 0 ? ( p[37] = p[51]; p[67] = p[81]; p[97] = p[115]; ) : p[5] == 3 ? p[37] = p[51] : p[87] = 1;
);

function cz_excite(p, n, vel) local(m, v, tr, per, th, amp, tm, hf, ka) (
  m = p[5]; v = cz_vc(vel); p[6] = v;
  tr = min(max((n - 21) / 87, 0), 1);
  tm = cz_tmb == 0 ? 1.45 : cz_tmb == 2 ? 0.72 : 1;
  hf = 2 ^ ((0.5 - cz_hard) * 1.0) * (1 + (rand(2) - 1) * 0.06 * cz_dr);
  p[9] = 0;
  m == 0 ? (
    amp = cz_db((v - 1) * 36);
    per = srate / p[54];
    th = cz_thk * 0.0032 * 2 ^ (-(n - 21) / 30) * (cz_hw0 - cz_hw1 * v ^ 0.8) * tm * hf * srate;
    th = max(th, 1.5);
    p[15] = th; p[23] = 2 * $pi / th;
    p[16] = 0.5 * amp * cz_gk0 * cz_lg(n, 0.87, 0.95, 1, 1, 1.25, 1.66, 3.1) * (n > 97 ? cz_db(n - 97) : 1);
    p[17] = per / 8.5; p[24] = cz_scd;
    p[55] = max(th * 0.25, 1); p[57] = 2 * $pi / p[55];
    p[56] = p[16] * (0.04 + 0.45 * v ^ 2.2) * (cz_tmb == 0 ? 0.5 : cz_tmb == 2 ? 1.6 : 1) * 2 ^ ((cz_hard - 0.5) * 1.5) / 0.25 * cz_cpk;
    p[18] = p[16] * 0.05 * (0.1 + 0.9 * v * v); p[19] = exp(-1 / (0.035 * srate)); p[22] = 1 - exp(-2 * $pi * 2800 / srate); p[20] = 0;
    p[148] = 1 - exp(-2 * $pi * min(0.4 * srate, (cz_hfa + cz_hfb * v ^ 2.5) * 2 ^ ((n - 60) / 24) / tm * hf) / srate);
    p[150] = 1 - exp(-1 / (max(cz_swt * 2 ^ (-(n - 48) / 24) * (1.3 - 0.6 * v), 0.0004) * srate));
    !p[0] ? p[149] = cz_sw0;
    p[12] = 1;
    ka = amp * cz_kk1 * (1 - 0.45 * tr) * (0.35 + 0.65 * v); cz_kimp += max(0, ka - abs(cz_kv) - 0.5 * cz_kimp);
    cz_kne = max(cz_kne, amp * cz_kk2 * (0.3 + 0.7 * v));
  ) : m == 3 ? (
    amp = cz_db((v - 1) * 28);
    per = srate / p[54];
    th = 0.0006 * (1.45 - 0.75 * v) * hf * (cz_tmb == 0 ? 1.6 : cz_tmb == 2 ? 0.8 : 1) * srate;
    th = max(th, 1.2);
    p[15] = th; p[23] = 2 * $pi / th;
    p[16] = 0.5 * amp * cz_ck0 * cz_lg(n, 2.26, 2.26, 1.63, 1.15, 1.03, 1.48, 2.53);
    p[17] = per / 12; p[24] = 0.9;
    p[18] = 0; p[55] = 0;
    p[28] = 14 * v * v * 2 ^ ((cz_hard - 0.5) * 0.8); p[29] = 1 / (0.03 * srate);
    p[12] = 1;
  ) : (
    p[17] = -100000; p[24] = 0; p[18] = 0;
    amp = cz_db((v - 1) * 30);
    th = 0.0018 * 2 ^ (-(n - 40) / 40) * (1.35 - 0.6 * v) * tm * hf * srate;
    p[25] = (0.15 + 0.85 * v ^ 1.5) * 2 ^ ((cz_hard - 0.5) * 0.6);
    p[12] = amp * cz_rk0 / p[25] * cz_lg(n, 2.5, 1.86, 0.94, 0.94, 1.1, 1.5, 9.5);
    th = max(th, 1.5);
    p[15] = th; p[23] = 2 * $pi / th; p[16] = 1 / th;
    p[55] = max(0.0009 * (1.3 - 0.6 * v) * hf * srate, 1); p[57] = 2 * $pi / p[55];
    p[56] = cz_rck * (cz_tmb == 0 ? 0.5 : cz_tmb == 2 ? 1.7 : 1) * (0.5 + v) / p[55];
  );
);

function cz_setup(p, n, vel) local(m, f, tr, tc, ln, b, t60, td, ad, nd, d, o, bt, per, q, kt, dc, w, r) (
  m = cz_model; p[5] = m; p[1] = n;
  tr = min(max((n - 21) / 87, 0), 1);
  tc = (rand(2) - 1) * (m == 0 ? 1.2 : 2.5) * cz_dr + cz_wand * cz_dr;
  m == 0 ? tc += n < 69 ? -14 * sqr((69 - n) / 48) : 28 * sqr((n - 69) / 39);
  f = 440 * 2 ^ ((n - 69 + tc / 100) / 12);
  m == 0 || m == 3 ? f = max(f, 24);
  p[54] = f;
  ln = cz_lrel ? 3.2 : 1;
  dc = (0.2 + 11.8 * cz_det * cz_det) / 1200;
  m == 0 ? (
    t60 = cz_dec * cz_lg(n, 20, 16, 12, 9, 6, 3.5, cz_tt) * (n > 97 ? 2 ^ (-(n - 97) / 24) : 1);
    b = cz_lg(n, 0.6, 0.35, 0.2, 0.13, 0.075, 0.035, 0.012) * (n > 97 ? 2 ^ (-(n - 97) / 8) : 1);
    b *= (cz_tmb == 0 ? 1.4 : cz_tmb == 2 ? 0.75 : 1) * cz_lb;
    b = cz_bsr(min(b, 0.85));
    ad = -1 + min(cz_lg(n, 0.042, 0.1, 0.22, 0.33, 0.455, 0.536, 0.672) * 48000 / srate, 0.98);
    nd = n <= 100 ? 4 : 0;
    td = 0.14 * ln * (1 + (1 - tr) * 1.2);
    n >= 89 ? td = t60;
    q = p + 30; q[0] = SBUF + (p - VB) / VS * 16384; memset(q[0], 0, 8192); q[1] = 0;
    cz_str(q, f, t60 * (n < 33 ? 1 : cz_ta), b, nd, ad, td, 0);
    p[50] = q[20]; p[51] = q[21];
    q = p + 60; q[0] = SBUF + (p - VB) / VS * 16384 + 8192; memset(q[0], 0, 8192); q[1] = 0;
    cz_str(q, f * 2 ^ dc, t60 * 2.6, b * 0.8, nd, ad, td, 0);
    p[136] = 0.42; p[134] = q[20];
    n >= 41 ? (
      q = p + 90; q[0] = SCB + (p - VB) / VS * 8192; memset(q[0], 0, 8192); q[1] = 0;
      cz_str(q, f * 2 ^ (-0.8 * dc), t60 * 1.7, b * 0.9, nd, ad, td, 0);
      p[114] = q[20]; p[115] = q[21]; p[116] = 0.6; p[117] = 1;
    );
    w = 2 * $pi * f * 0.5 * 2 ^ (-cz_subc / 1200) / srate;
    p[141] = cos(w); p[142] = sin(w);
    p[139] = exp(-6.9078 / (max(t60 * 0.7, 0.05) * srate));
