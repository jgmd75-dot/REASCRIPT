function tg_wash(x, y, w, h) ( ui_cola(DPK, 0.55); v5_r(x, y, w, h); );

function tg_shape(sh, ph) ( ph -= floor(ph); sh == 0 ? sin(2 * $pi * ph) : sh == 1 ? 1 - 4 * abs(ph - 0.5) : 2 * ph - 1; );
function tg_pathpt(t, cx0, cy0, xd, yd, sx, sy, ph, tt) local(lx, ly, rad) (
