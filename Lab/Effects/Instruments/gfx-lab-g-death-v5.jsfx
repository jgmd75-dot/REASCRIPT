    sx = -0.6; loop(5, gfx_line(x1 * m, (y1 + sx) * m, x2 * m, (y2 + sx) * m, 1); sx += 0.3; ); k += 1; );
  sx = 11; bw = 16; bh = 11;
  ui_col(DGOLD); gfx_rect((sx - 0.7) * m, 5.5 * m, 1.4 * m, 23 * m); gfx_circle(sx * m, 5.8 * m, 1.4 * m, 1, 1);
  ui_col(0x0A0A0C);
  gfx_triangle((sx + 0.7) * m, 6.5 * m, (sx + 0.7 + bw) * m, 6.5 * m, (sx + 0.7 + bw) * m, (6.5 + bh) * m, (sx + 0.7) * m, (6.5 + bh) * m);
  gfx_triangle((sx + 0.7) * m, (6 + bh) * m, (sx + 0.7 + bw * 0.5) * m, (6 + bh) * m, (sx + 0.7) * m, (6.5 + bh + 5) * m);
  gfx_triangle((sx + 0.7 + bw * 0.5) * m, (6 + bh) * m, (sx + 0.7 + bw) * m, (6 + bh) * m, (sx + 0.7 + bw) * m, (6.5 + bh + 5) * m);
  x1 = sx + 0.7 + bw * 0.5; y1 = 6.5 + bh * 0.5; sr = 3.8; k = 0;
  loop(5, sx = -0.5 * $pi + k * 0.4 * $pi; ui_col(DBONEH); gfx_circle((x1 + cos(sx) * sr * 0.52) * m, (y1 + sin(sx) * sr * 0.52) * m, sr * 0.5 * m, 1, 1); k += 1; );
  ui_col(DINK); gfx_circle(x1 * m, y1 * m, (sr * 0.34 + 0.3) * m, 1, 1);
  ui_col(DGOLD); gfx_circle(x1 * m, y1 * m, sr * 0.34 * m, 1, 1);
  gfx_dest = 119; gfx_a = 1; gfx_mode = 0; gfx_x = floor(ox * sc + 0.5); gfx_y = floor(oy * sc + 0.5); gfx_blit(121, 0.25, 0);
);
function tg_led(x, y, c, g) local(i) (
  ui_col(0x050606); v5_d(x, y, 5.5);
