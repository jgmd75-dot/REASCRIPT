  ui_col(ui_mix(f, 0, 0.30)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.06)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.12)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
