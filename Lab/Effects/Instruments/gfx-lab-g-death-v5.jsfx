function tw_drone_set(n) local(k, p) (
  k = 0;
  loop(8,
    p = TDV[k];
    p >= 0 && !(p[63] && p[8] > 0 && p[8] != 3) ? ( p = -1; TDV[k] = -1; );
    k < n ? (
      p >= 0 ? ( p[5] = TDN[k]; p[0] = TDN[k]; ) : (
        p = tw_dalloc();
        p >= 0 ? (
          tw_age += 1; p[2] = tw_age;
