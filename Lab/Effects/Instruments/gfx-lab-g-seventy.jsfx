inset(530, 392, 414, 132, SH2); band(530, 392, 414, "MASTER");
sprintf(#v, "%.0f%%", slider23); dy_knob(595, 466, 18, 23, 0, 100, 60, 0, CAPG, "DRIFT", #v);
sprintf(#v, "%+.1f dB", slider24); dy_knob(713, 462, 24, 24, -24, 6, 0, 0, CAPC, "VOLUME", #v);
sprintf(#v, "%.0f%%", slider26); dy_knob(831, 466, 18, 26, 0, 100, 0, 0, CAPG, "SAT", #v);
mL.ui_ledm(906 * sc, 420 * sc, 10 * sc, 92 * sc, pk_disp); pk_disp *= 0.85;


// ---------- row 4: the FX section (FFAT, PHASER, CHORUS, DELAY), each with its own IN key ----------
// an FX unit's inset; off = greyed (the face colour half over it), its IN key drawn on top
function fx_unit(x, title) ( inset(x, 544, 223, 164, SH1); band(x, 544, 223, title); );
function fx_grey(x, on) ( !on ? ( ui_cola(SH1, 0.5); gfx_rect(x * sc, 562 * sc, 223 * sc, 146 * sc); ); );
function fx_in(x, idx, on) (
  gfx_setfont(13); lk_font = 13; lk_font2 = 13;
  lk_key(x + 14, 578, 52, 28, on, LK_AMB, "IN") ? ( slider(idx) = on ? 0 : 1; slider_automate(2 ^ (idx - 1)); );
);
// FFAT
fx_unit(16, "FFAT");
dbox(130, 582, 84, 26, "TYPE", dr_type < 0.5 ? "TUBE" : dr_type < 1.5 ? "FUZZ" : dr_type < 2.5 ? "RECT" : "CRUSH") ? (
  gfx_x = 130 * sc; gfx_y = 610 * sc;
  g_k = gfx_showmenu(sprintf(#sq_m, "%sTube|%sFuzz|%sRect|%sCrush", dr_type == 0 ? "!" : "", dr_type == 1 ? "!" : "", dr_type == 2 ? "!" : "", dr_type == 3 ? "!" : ""));
  g_k > 0 ? ( slider(33) = g_k - 1; slider_automate(dr_type); );
);
sprintf(#v, "%.1f", dr_amt); dy_knob(56, 650, 18, 34, 0, 10, 3, 0, 0xE08A1E, "DRIVE", #v);
sprintf(#v, "%.0f%%", dr_mix); dy_knob(127, 650, 18, 35, 0, 100, 100, 0, CAPD, "MIX", #v);
sprintf(#v, "%.1f", ffat); dy_knob(198, 650, 18, 36, 0, 10, 0, 0, 0xD8332E, "FFAT", #v);
fx_grey(16, dr_on >= 0.5); fx_in(16, 32, dr_on >= 0.5);
// PHASER
fx_unit(251, "PHASER");
sprintf(#v, "%.2f Hz", ph_rate); dy_knob(291, 650, 18, 38, 0.05, 8, 0.4, 1, CAPD, "RATE", #v);
sprintf(#v, "%.0f%%", ph_dep); dy_knob(362, 650, 18, 39, 0, 100, 60, 0, CAPD, "DEPTH", #v);
sprintf(#v, "%.0f%%", ph_fb); dy_knob(433, 650, 18, 40, 0, 90, 40, 0, CAPD, "FEEDBACK", #v);
fx_grey(251, ph_on >= 0.5); fx_in(251, 37, ph_on >= 0.5);
// CHORUS
fx_unit(486, "CHORUS");
sprintf(#v, "x %.2f", ch_rate); dy_knob(526, 650, 18, 42, 0.25, 4, 1, 1, CAPD, "RATE", #v);
sprintf(#v, "%.0f%%", ch_dep); dy_knob(597, 650, 18, 43, 0, 100, 60, 0, CAPD, "DEPTH", #v);
sprintf(#v, "%.0f%%", ch_mix); dy_knob(668, 650, 18, 44, 0, 100, 50, 0, CAPD, "MIX", #v);
fx_grey(486, ch_on >= 0.5); fx_in(486, 41, ch_on >= 0.5);
// DELAY
fx_unit(721, "DELAY");
g_d = floor(dl_div + 0.5);
dbox(835, 582, 84, 26, "TIME", g_d == 0 ? "1/16" : g_d == 1 ? "1/8 T" : g_d == 2 ? "1/8" : g_d == 3 ? "1/4 T" : g_d == 4 ? "1/8 D" : g_d == 5 ? "1/4" : g_d == 6 ? "1/4 D" : "1/2") ? (
  strcpy(#sq_m, ""); g_j = 0;
  loop(8, g_j == g_d ? strcat(#sq_m, "!");
    strcat(#sq_m, g_j == 0 ? "1/16" : g_j == 1 ? "1/8 triplet" : g_j == 2 ? "1/8" : g_j == 3 ? "1/4 triplet" : g_j == 4 ? "1/8 dotted" : g_j == 5 ? "1/4" : g_j == 6 ? "1/4 dotted" : "1/2");
    g_j < 7 ? strcat(#sq_m, "|"); g_j += 1; );
  gfx_x = 835 * sc; gfx_y = 610 * sc; g_k = gfx_showmenu(#sq_m); g_k > 0 ? ( slider(46) = g_k - 1; slider_automate(dl_div); );
);
sprintf(#v, "%.0f%%", dl_fb); dy_knob(761, 650, 18, 47, 0, 90, 35, 0, CAPD, "FEEDBACK", #v);
sprintf(#v, "%.0f%%", dl_tone); dy_knob(832, 650, 18, 48, 0, 100, 55, 0, CAPD, "TONE", #v);
sprintf(#v, "%.0f%%", dl_mix); dy_knob(903, 650, 18, 49, 0, 100, 25, 0, CAPD, "MIX", #v);
fx_grey(721, dl_on >= 0.5); fx_in(721, 45, dl_on >= 0.5);

sv_rcap = mouse_cap;
pk_end();
ui_end();
