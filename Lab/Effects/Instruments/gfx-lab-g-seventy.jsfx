mL.ui_ledm(906 * sc, 420 * sc, 10 * sc, 92 * sc, pk_disp); pk_disp *= 0.85;

// ---------- row 4: the SEQUENCER ----------
inset(16, 544, 928, 296, SH1); band(16, 544, 928, "SEQUENCER");
// RUN / FOLLOW (it never starts by itself)
gfx_setfont(13); lk_font = 13; lk_font2 = 13;
seq_follow >= 0.5 ? ( lk_inert = 1; lk_key(32, 594, 92, 34, gfx_pst_g, LK_RED, gfx_pst_g ? "PLAYING" : "WAITING"); ) :
  lk_key(32, 594, 92, 34, seq_run_d, LK_RED, seq_run_d ? "STOP" : "RUN") ? seq_run_d = !seq_run_d;
gfx_pst_g = play_state == 1 || play_state == 5;
gfx_setfont(13);
lk_key(136, 594, 92, 34, seq_follow >= 0.5, LK_YEL, "FOLLOW") ? ( slider(37) = seq_follow >= 0.5 ? 0 : 1; slider_automate(seq_follow); seq_run_d = 0; );
// RATE, PATTERN, LAST STEP, KEY: display boxes (click for a menu)
sq_L = max(1, min(16, SQB[512 + seq_pat]));
dbox(250, 596, 76, 30, "RATE", seq_rate < 0.5 ? "1/8" : seq_rate < 1.5 ? "1/16" : seq_rate < 2.5 ? "1/32" : seq_rate < 3.5 ? "1/8 T" : "1/16 T") ? (
  gfx_x = 250 * sc; gfx_y = 628 * sc;
  g_k = gfx_showmenu(sprintf(#sq_m, "%s1/8|%s1/16|%s1/32|%s1/8 triplet|%s1/16 triplet", seq_rate == 0 ? "!" : "", seq_rate == 1 ? "!" : "",
        seq_rate == 2 ? "!" : "", seq_rate == 3 ? "!" : "", seq_rate == 4 ? "!" : ""));
  g_k > 0 ? ( slider(32) = g_k - 1; slider_automate(seq_rate); );
);
sprintf(#sq_v, "%d", seq_pat + 1);
dbox(338, 596, 64, 30, "PATTERN", #sq_v) ? (
  strcpy(#sq_m, ""); g_j = 0; loop(8, g_j == seq_pat ? strcat(#sq_m, "!"); strcat(#sq_m, sprintf(#sq_t, "Pattern %d", g_j + 1)); g_j < 7 ? strcat(#sq_m, "|"); g_j += 1; );
  gfx_x = 338 * sc; gfx_y = 628 * sc; g_k = gfx_showmenu(#sq_m); g_k > 0 ? ( slider(25) = g_k - 1; slider_automate(seq_pat); );
);
sprintf(#sq_v, "%d", sq_L);
dbox(414, 596, 64, 30, "LAST STEP", #sq_v) ? (
  strcpy(#sq_m, ""); g_j = 1; loop(16, g_j == sq_L ? strcat(#sq_m, "!"); strcat(#sq_m, sprintf(#sq_t, "%d", g_j)); g_j < 16 ? strcat(#sq_m, "|"); g_j += 1; );
  gfx_x = 414 * sc; gfx_y = 628 * sc; g_k = gfx_showmenu(#sq_m); g_k > 0 ? SQB[512 + seq_pat] = g_k;
);
dbox(490, 596, 64, 30, "KEY", nname(48 + seq_tr_d)) ? (
  gfx_x = 490 * sc; gfx_y = 628 * sc; g_k = gfx_showmenu("Back to C3 (as written)"); g_k > 0 ? seq_trz_dirty = 1;
);
// SWING, GATE, ACCENT, SLIDE (desk knobs, the house dy_knob)
sprintf(#v, "%.0f%%", seq_swing); dy_knob(612, 610, 18, 33, 0, 75, 0, 0, CAPD, "SWING", #v);
sprintf(#v, "%.0f%%", seq_gate);  dy_knob(686, 610, 18, 34, 10, 100, 55, 0, CAPD, "GATE", #v);
sprintf(#v, "%.0f%%", seq_acc);   dy_knob(760, 610, 18, 35, 0, 100, 60, 0, 0xD8332E, "ACCENT", #v);
sprintf(#v, "%.0f ms", seq_slide); dy_knob(834, 610, 18, 36, 10, 400, 70, 1, 0x3D7FD6, "SLIDE", #v);
// TOOLS: pattern edits
gfx_setfont(13);
lk_key(882, 596, 50, 30, 0, LK_AMB, "EDIT") ? (
  strcpy(#sq_m, "Clear pattern|Randomise pattern|Shift left|Shift right|Octave up|Octave down|>Copy pattern to");
  g_j = 0; loop(8, strcat(#sq_m, g_j == 7 ? "|<" : "|"); strcat(#sq_m, sprintf(#sq_t, "Pattern %d", g_j + 1)); g_j += 1; );
  strcat(#sq_m, "|Factory pattern");
  gfx_x = 882 * sc; gfx_y = 628 * sc; g_k = gfx_showmenu(#sq_m);
  g_b = SQB + seq_pat * 64;
  g_k == 1 ? ( memset(g_b, 0, 64); ) :
  g_k == 2 ? ( g_j = 0; loop(16, g_r = rand(6) | 0;
                 g_b[g_j * 4] = (g_r == 0 ? 0 : g_r == 1 ? 3 : g_r == 2 ? 5 : g_r == 3 ? 7 : g_r == 4 ? 10 : 12) + (rand(5) < 1 ? 12 : 0);
                 g_b[g_j * 4 + 1] = rand(4) >= 1; g_b[g_j * 4 + 2] = rand(4) < 1; g_b[g_j * 4 + 3] = rand(5) < 1; g_j += 1; ); ) :
  g_k == 3 ? ( memcpy(SQB + 600, g_b, 4); memcpy(g_b, g_b + 4, 60); memcpy(g_b + 60, SQB + 600, 4); ) :
  g_k == 4 ? ( memcpy(SQB + 600, g_b + 60, 4); memcpy(g_b + 4, g_b, 60); memcpy(g_b, SQB + 600, 4); ) :
  g_k == 5 || g_k == 6 ? ( g_j = 0; loop(16, g_b[g_j * 4] = min(max(g_b[g_j * 4] + (g_k == 5 ? 12 : -12), -12), 24); g_j += 1; ); ) :
  g_k >= 7 && g_k <= 14 ? ( memcpy(SQB + (g_k - 7) * 64, g_b, 64); SQB[512 + g_k - 7] = SQB[512 + seq_pat]; ) :
  g_k == 15 ? sq_factory(seq_pat);
);
// the 16 steps
SX0 = 98; SPW = 52.5;
gfx_setfont(12); ui_col(DIMI);
ui_text(56 * sc, 664 * sc, "STEP"); ui_text(56 * sc, 698 * sc, "NOTE"); ui_text(56 * sc, 730 * sc, "PITCH");
ui_col(ui_mix(LK_AMB, INK, 0.3)); ui_text(56 * sc, 762 * sc, "ON");
ui_col(ui_mix(LK_RED, INK, 0.3)); ui_text(56 * sc, 790 * sc, "ACCENT");
ui_col(ui_mix(LK_BLU_LT, INK, 0.3)); ui_text(56 * sc, 818 * sc, "SLIDE");
// beats 1 and 3 lightly shaded so the groups of four read at a glance
ui_cola(0x000000, 0.10); gfx_rect((SX0 - 2) * sc, 652 * sc, (SPW * 4) * sc, 182 * sc); gfx_rect((SX0 - 2 + SPW * 8) * sc, 652 * sc, (SPW * 4) * sc, 182 * sc);
pk_lcd(SX0 * sc, 686 * sc, (SPW * 16 - 4) * sc, 24 * sc, 0);
sq_cur = seq_step_d >= 0 && seq_pat_d == seq_pat ? seq_step_d : -1;
g_i = 0;
loop(16,
  g_cx = SX0 + SPW * g_i + SPW * 0.5 - 2;
  g_b = SQB + (seq_pat * 16 + g_i) * 4;
  gfx_setfont(12); ui_col(g_i < sq_L ? INK : DIMI); ui_text((g_cx - 7) * sc, 664 * sc, sprintf(#sq_t, "%d", g_i + 1));
  rd_led(g_cx + 12, 664, 3.5, g_i == sq_cur, 0xFF4A2A);
  g_i == sq_cur ? ( ui_cola(pk_lcdc, 0.25); gfx_rect((g_cx - SPW * 0.5 + 3) * sc, 689 * sc, (SPW - 6) * sc, 18 * sc); );
  gfx_setfont(14); ui_cola(pk_lcdc, g_b[1] ? 1 : 0.3);
  ui_text(g_cx * sc, 690 * sc, g_b[1] ? nname(48 + seq_tr_d + g_b[0]) : "-");
  sq_knob(g_i, g_cx, 732, 13);
  lk_key(g_cx - 20, 754, 40, 18, g_b[1], LK_AMB, "") ? g_b[1] = !g_b[1];
  lk_key(g_cx - 20, 782, 40, 18, g_b[2], LK_RED, "") ? g_b[2] = !g_b[2];
  lk_key(g_cx - 20, 810, 40, 18, g_b[3], LK_BLU_LT, "") ? g_b[3] = !g_b[3];
  g_i >= sq_L ? ( ui_cola(SH1, 0.55); gfx_rect((g_cx - SPW * 0.5 + 1) * sc, 652 * sc, (SPW - 2) * sc, 182 * sc); );
  g_i += 1;
);

sv_rcap = mouse_cap;
pk_end();
