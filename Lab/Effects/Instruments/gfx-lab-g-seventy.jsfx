desc:Seventy [mono synth] (GFX Lab)
//tags: instrument synth mono lead bass analog 70s phaser chorus delay drive
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-drift, gfx-lab-voice, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-dyn, gfx-lab-faceplate, gfx-lab-clip, gfx-lab-os (.jsfx-inc).
//
// A monophonic synth in the spirit of the mid-70s two-oscillator Japanese monos, with an FX section built in
// (the Lab rework, Oct 2026):
//   VCO 1      triangle, saw, square, pulse, or pulse-width modulated by the MG; six octaves, 64' to 2'.
//   VCO 2      saw, ring-modulated against VCO 1, or white / pink / red noise; TUNE offsets it from VCO 1.
//   BLEND      the mix of the two sources.
//   FILTER     a high-pass and a low-pass filter in series (HPF and LPF knobs), 12 dB each, with a three-step
//              RESONANCE switch; EG and MG switches set how far the envelope and the MG move them.
//   AUTO BEND  a pitch bend into every new note (up or down, with its own time); VIBRATO has its own LFO.
//   ENVELOPE   attack, decay, sustain, release for the filter and the amp. Last-note priority, portamento.
// SIGNAL FLOW: VCOs -> FILTER -> VCA -> FFAT -> PHASER -> CHORUS -> DELAY -> VOLUME -> output stage (CLIP).
// FX SECTION (new; each unit has its own amber IN key, crossfaded in and out over 15 ms; every knob glides):
//   FFAT       Ffat's drive: TUBE (asymmetric soft, even harmonics), FUZZ (hard, with a gate that opens with
//              DRIVE), RECT (rectifier, octave up) or CRUSH (bits and sample-rate hold), from a menu; DRIVE (level-
//              matched: it changes the character, not the loudness), MIX, and FFAT - the one-knob squash
//              (threshold, ratio and make-up rise together). The drive runs oversampled with the OS key (1x / 2x /
//              4x in the header; 1x = no latency, 2x 31 samples, 4x 37, reported). A TYPE change dips the drive to
//              the clean sound for 3 ms and swaps there.
//   PHASER     six all-pass stages swept from 200 Hz up to 4 kHz: RATE, DEPTH, FEEDBACK; left and right a
//              quarter-cycle apart.
//   CHORUS     three delay lines (2 - 7 ms) swept by a three-phase LFO - a slow sweep and a fast shimmer mixed 10:1
//              (the 70s string-machine kind); RATE, DEPTH, MIX.
//   DELAY      ping-pong, in time with the project: TIME (a note value, from a menu), FEEDBACK, TONE (the damping
//              in the loop), MIX. Its repeats ring on after it is switched out.
// DRIFT (heavy, 70s unstable; 60% by default): the universal GFX instrument drift pushed harder - pitch, VCO 2
//   detune, pulse width and the filters wander, with a random tuning offset on each new note - and the envelope's
//   timing wanders too, a little different on every note. The supply sags under loud playing (pitch dips a few
//   cents, the filter darkens a touch, both recover in a moment), and the chorus and phaser rates drift a little.
//   0% = steady.
// IN / OUT: the GFX band saturation (SAT on the panel); the output soft clip is always on.
// MIDI: note on / off, pitch bend (+/- 2 st), CC120 / 123; MIDI passes through.
// PRESETS: sixteen, each with its FX; chosen from the preset bar or the hidden Preset parameter.
// Latency: 0 samples (OS 1x), 31 (2x), 37 (4x), reported.

import gfx-lab-drift.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-faceplate.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc

slider1:1<0,4,1{Triangle,Saw,Square,Pulse,PWM}>-VCO 1 wave
slider2:3<0,5,1{64',32',16',8',4',2'}>-VCO 1 octave
slider3:0<0,4,1{Saw,Ring,White noise,Pink noise,Red noise}>-VCO 2 source
slider4:0.12<-12,12,0.01>-VCO 2 tune (semitones)
slider5:35<0,100,1>-Blend (VCO 1 - VCO 2, %)
slider6:5<0.1,30,0.01>-MG rate (Hz)
slider7:50<0,100,1>-PWM depth (%)
slider8:5.5<1,12,0.01>-Vibrato rate (Hz)
slider9:12<0,100,1>-Vibrato depth (cents)
slider10:20<20,8000,1>-Filter HPF (Hz)
slider11:1800<60,18000,1>-Filter LPF (Hz)
slider12:1<0,2,1{Low,Mid,High}>-Resonance
slider13:1<0,2,1{Off,Half,Full}>-EG to filter
slider14:0<0,2,1{Off,Half,Full}>-MG to filter
slider15:5<1,5000,0.1>-Attack (ms)
slider16:700<10,8000,1>-Decay (ms)
slider17:70<0,100,1>-Sustain (%)
slider18:300<10,8000,1>-Release (ms)
slider19:0<-12,12,0.1>-Auto bend depth (semitones)
slider20:200<10,2000,1>-Auto bend time (ms)
slider21:40<0,1500,1>-Portamento (ms)
slider22:0<0,100,1>-Velocity (%)
slider23:60<0,100,1>-Drift (%)
slider24:0<-24,6,0.1>-Volume (dB)
slider25:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling (FFAT drive)
slider26:0<0,100,1>-Band sat (%)
slider27:30<0,100,1>-Bias (%)
slider28:120<40,400,1>-Sat low band (Hz)
slider29:6000<2000,16000,10>-Sat high band (Hz)
slider30:-0.3<-24,0,0.1>-Ceiling (dB)
slider31:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider32:dr_on=0<0,1,1{Out,In}>-Ffat
slider33:dr_type=0<0,3,1{Tube,Fuzz,Rect,Crush}>-Ffat drive type
slider34:dr_amt=3<0,10,0.1>-Ffat drive
slider35:dr_mix=100<0,100,1>-Ffat mix (%)
slider36:ffat=0<0,10,0.1>-Ffat squash
slider37:ph_on=0<0,1,1{Out,In}>-Phaser
slider38:ph_rate=0.4<0.05,8,0.01>-Phaser rate (Hz)
slider39:ph_dep=60<0,100,1>-Phaser depth (%)
slider40:ph_fb=40<0,90,1>-Phaser feedback (%)
slider41:ch_on=0<0,1,1{Out,In}>-Chorus
slider42:ch_rate=1<0.25,4,0.01>-Chorus rate (x)
slider43:ch_dep=60<0,100,1>-Chorus depth (%)
slider44:ch_mix=50<0,100,1>-Chorus mix (%)
slider45:dl_on=0<0,1,1{Out,In}>-Delay
slider46:dl_div=4<0,7,1{1/16,1/8 triplet,1/8,1/4 triplet,1/8 dotted,1/4,1/4 dotted,1/2}>-Delay time
slider47:dl_fb=35<0,90,1>-Delay feedback (%)
slider48:dl_tone=55<0,100,1>-Delay tone (%)
slider49:dl_mix=25<0,100,1>-Delay mix (%)
slider50:prs_sel=0<0,16,1{No preset,Seventy Lead,64' Bass,Filter Sweep,Ring Bells,PWM Strings,Auto Bend Brass,Whistle,Wind,Squelch,Theremin,Zap Drum,Hollow Pipe,Phase Lead,Ffat Fuzz Bass,Space Echo Lead,Crushed Zap}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-g-seventy";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; sv_pal = 0; pr_trim_t = 1; );   // first instance: M size, olive faceplate
HN = 1000; hcount = 0;                       // held-note stack (last-note priority)
PHS = 1200;                                   // the phaser's all-pass states (L 0-5, R 8-13)
DRB = 1300;                                   // the clean sound, delayed to line up with the oversampled drive
CHB = 131072; CHN = 8192;                     // the chorus line (mono in)
DLB = 1048576; DLN = 524288;                  // the delay's two lines (L, then R at DLB + DLN)
fl_ok = 0;
memset(HN, 0, 128); memset(PHS, 0, 16); memset(DRB, 0, 64); memset(CHB, 0, CHN); memset(DLB, 0, 2 * DLN);
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
ins_drift_init();
sv_dE.drift_init(0.8 + rand(1) * 0.5);        // the envelope's slow timing wander
sv_dF.drift_init(0.8 + rand(1) * 0.5);        // the chorus / phaser clocks
bend = 1; nd_mul = 1; cur = 60; tgt = 60; vel = 0.8; gate = 0; ab_v = 0;
sm = vo_coef(30);
dxp = dyp = 0; sag = 0;
ch_w = 0; dl_w = 0; ph_p = 0; ch_pa = 0; ch_pb = 0.33;
// the FFAT drive (Ffat's): the kit's drive-tracking pre-filter, oversampled with the OS key
dsA.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150); dsA.pf.clp_pf_reset();
os_design(); os_base = 0;
os_f = os_tf = os_f2n(os_sel); os_gsetup();
dr_sw = 1; dt_a = floor(dr_type + 0.5);

// ---------- the filters: 12 dB state-variable (TPT), low-pass and high-pass outputs ----------
function sv_svf(x, fc, k) instance(ic1, ic2, lp, hp) local(g, a1, a2, a3, v1, v2, v3) (
  g = tan($pi * min(fc, srate * 0.45) / srate);
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  lp = v2; hp = x - k * v1 - v2;
);
// a naive triangle is clean enough (its harmonics fall fast); own phase
function sv_tri(inc) instance(ph) ( ph += inc; ph -= floor(ph); ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph; );
function db2g(d) ( exp(d * 0.11512925464970228); );
function fx_frac(x) ( x - floor(x); );
function fx_ts(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

// ---------- the FFAT drive (from Ffat), one channel: a, b clip-kit clippers, pf the kit's pre-filter ----------
function ds_tick(x) instance(a, b, pf, cnt, held, xp, dcx, dcy) local(u, y, dry) (
  dry = 0.5 * (x + xp); xp = x;                                  // the ADAA half-sample, matched on the dry side
  dt_a == 3 ? (
    cnt -= 1;                                                    // CRUSH: hold, then quantise
    cnt <= 0 ? ( cnt = cr_hold; held = min(max(floor(x * cr_q + 0.5) / cr_q, -1), 1); );
    y = held; dry = x;
  ) : (
    u = pf.clp_pf_run(x) * ds_g;
    dt_a == 0 ? ( y = (a.clp_run(u + ds_b) - ds_rest) * ds_c; ) :          // TUBE
    dt_a == 1 ? ( y = a.clp_run(u) * ds_c; ) :                             // FUZZ
                ( y = 0.5 * (a.clp_run(u) + b.clp_run(u)) * ds_c; );        // RECT
  );
  dcy = y - dcx + ds_dcc * dcy; dcx = y;                         // DC blocker (the rectifier's DC, the tube's bias), 4 Hz
  dry + (dcy - dry) * dmix_s;
);
function ds_reset() instance(a, b, cnt, held, xp, dcx, dcy) (
  a.clp_reset(); b.clp_reset(); cnt = 0; held = 0; xp = 0; dcx = 0; dcy = 0;
);
// the drive at the running OS factor
function drive_os(x) (
  os_f == 1 ? dsA.ds_tick(x) : (
    osu.os_up(x);
    oa0 = dsA.ds_tick(osu.s0); oa1 = dsA.ds_tick(osu.s1);
    os_f > 2 ? ( oa2 = dsA.ds_tick(osu.s2); oa3 = dsA.ds_tick(osu.s3); );
    osd.os_dn(oa0, oa1, oa2, oa3);
  );
);
// the drive's curves and level match (-12 dBFS in = -12 dBFS out; at DRIVE 0 unity for small signals), per block
function ds_curves() local(dn) (
  dn = dr_s / 10;
  ds_st = min(1, dr_s / 3);
  dt_a == 0 ? (
    ds_g = db2g(dr_s * 2.4); ds_b = 0.08 + 0.12 * dn;
    dsA.a.clp_set(1, 1, 0.72, 0);
    ds_rest = dsA.a.clp_crv(ds_b);
    ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(dsA.a.clp_crv(0.25 * ds_g + ds_b) - ds_rest, 0.0001);
  ) : dt_a == 1 ? (
    ds_g = db2g(dr_s * 4);
    dsA.a.clp_set(0, 0.6, 0.6, 0.04 * dn);
    ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(dsA.a.clp_crv(0.25 * ds_g), 0.0001);
  ) : dt_a == 2 ? (
    ds_g = db2g(dr_s * 2);
    dsA.a.clp_set(3, 1, 1, 0); dsA.b.clp_set(1, 1, 1, 0);
    ds_c = 0.25 / max(0.5 * (dsA.a.clp_crv(0.25 * ds_g) + dsA.b.clp_crv(0.25 * ds_g)), 0.0001);
  ) : (
    cr_q = 2 ^ (15 - dr_s * 1.3);                                // 16 bits .. 3 bits
    cr_hold = (1 + floor(sqr(dn) * 23)) * os_f;                  // the same hold time at every OS factor
  );
  ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
  dsA.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);
  dsA.a.clp_tidy(); dsA.b.clp_tidy();
);

// per-preset level trim (keeps the hottest patches out of the output clipper; quieter ones are left alone)
function patch_trim(p) (
  p == 1 ? 0.540 : p == 2 ? 0.500 : p == 3 ? 0.440 : p == 4 ? 1.000 : p == 5 ? 0.520 : p == 6 ? 1.000 :
  p == 7 ? 0.170 : p == 8 ? 0.620 : p == 9 ? 1.000 : p == 10 ? 0.380 : p == 11 ? 1.000 : p == 12 ? 1.000 :
  p == 13 ? 0.900 : p == 14 ? 0.370 : p == 15 ? 0.300 : 1.000;
);

// ---------- presets (audio side only) ----------
function setvco(w, o, s2, tu, bl) ( slider1 = w; slider2 = o; slider3 = s2; slider4 = tu; slider5 = bl; );
function setmod(mr, pd, vr, vd) ( slider6 = mr; slider7 = pd; slider8 = vr; slider9 = vd; );
function settrv(hp, lp, rs, eg, mg) ( slider10 = hp; slider11 = lp; slider12 = rs; slider13 = eg; slider14 = mg; );
function setenv(a, d, s, r) ( slider15 = a; slider16 = d; slider17 = s; slider18 = r; );
function setperf(bd, bt, pt, vl) ( slider19 = bd; slider20 = bt; slider21 = pt; slider22 = vl; );
// the FX: FFAT (in, type, drive, mix, squash), PHASER (in, rate, depth, feedback), CHORUS (in, rate, depth, mix),
// DELAY (in, time, feedback, tone, mix)
function setffat(on, ty, dv, mx, sq) ( dr_on = on; dr_type = ty; dr_amt = dv; dr_mix = mx; ffat = sq; );
function setph(on, rt, dp, fb) ( ph_on = on; ph_rate = rt; ph_dep = dp; ph_fb = fb; );
function setch(on, rt, dp, mx) ( ch_on = on; ch_rate = rt; ch_dep = dp; ch_mix = mx; );
function setdl(on, dv, fb, tn, mx) ( dl_on = on; dl_div = dv; dl_fb = fb; dl_tone = tn; dl_mix = mx; );
function load_preset(p) (
  sv_preq = 1;                                   // (first: the audio thread holds the old sound until it has faded)
  setffat(0, 0, 3, 100, 0); setph(0, 0.4, 60, 40); setch(0, 1, 60, 50); setdl(0, 4, 35, 55, 25);
  p == 1  ? ( setvco(1, 3, 0, 0.12, 35); setmod(5, 50, 5.5, 12);  settrv(20, 1800, 1, 1, 0);  setenv(5, 700, 70, 300);   setperf(0, 200, 40, 0);
              setch(1, 0.8, 45, 35); setdl(1, 4, 30, 50, 20); ) :                                                                       // Seventy Lead
  p == 2  ? ( setvco(2, 1, 0, 12.05, 30);setmod(5, 50, 5.5, 0);   settrv(20, 700, 1, 1, 0);   setenv(2, 450, 40, 120);   setperf(0, 200, 0, 30);
              setffat(1, 0, 2.5, 100, 3); ) :                                                                                             // 64' Bass (32' + VCO 2 an octave up)
  p == 3  ? ( setvco(1, 2, 0, 0.2, 50);  setmod(0.25, 50, 5, 0);  settrv(60, 900, 2, 0, 2);   setenv(10, 1000, 100, 600);setperf(0, 200, 0, 0);
              setph(1, 0.15, 70, 55); ) :                                                                                                 // Filter Sweep
  p == 4  ? ( setvco(2, 3, 1, 7.0, 75);  setmod(5, 50, 5, 0);     settrv(200, 6000, 1, 1, 0); setenv(1, 1600, 0, 1400);  setperf(0, 200, 0, 40);
              setch(1, 0.6, 50, 40); setdl(1, 6, 40, 45, 30); ) :                                                                       // Ring Bells
  p == 5  ? ( setvco(4, 3, 0, 0.15, 25); setmod(0.6, 80, 5, 6);   settrv(150, 3200, 0, 0, 0); setenv(250, 800, 85, 700); setperf(0, 200, 0, 0);
              setch(1, 1, 80, 60); ) :                                                                                                    // PWM Strings
  p == 6  ? ( setvco(1, 3, 0, 0.1, 40);  setmod(5, 50, 5.5, 8);   settrv(60, 1200, 1, 2, 0);  setenv(40, 500, 70, 250);  setperf(-1.5, 120, 0, 40);
              setffat(1, 0, 2, 100, 2); setdl(1, 2, 25, 50, 15); ) :                                                                    // Auto Bend Brass
  p == 7  ? ( setvco(0, 4, 3, 0, 8);     setmod(5, 50, 6, 18);    settrv(400, 5000, 2, 0, 0); setenv(30, 300, 90, 400);  setperf(0.6, 90, 60, 0);
              setdl(1, 5, 45, 40, 30); ) :                                                                                                // Whistle
  p == 8  ? ( setvco(0, 3, 3, 0, 100);   setmod(0.15, 50, 5, 0);  settrv(300, 1500, 2, 0, 2); setenv(800, 2000, 90, 2000);setperf(0, 200, 0, 0);
              setph(1, 0.08, 80, 60); ) :                                                                                                 // Wind
  p == 9  ? ( setvco(3, 2, 0, 0.1, 20);  setmod(5, 50, 5, 0);     settrv(20, 250, 2, 2, 0);   setenv(1, 280, 10, 120);   setperf(0, 200, 30, 50);
              setffat(1, 1, 3, 70, 0); setdl(1, 1, 30, 40, 18); ) :                                                                     // Squelch
  p == 10 ? ( setvco(0, 3, 0, 0, 0);     setmod(5, 50, 6.2, 30);  settrv(20, 2500, 0, 0, 0); setenv(120, 500, 100, 500);setperf(0, 200, 180, 0);
              setdl(1, 6, 50, 35, 30); ) :                                                                                                // Theremin
  p == 11 ? ( setvco(0, 1, 2, 0, 35);    setmod(5, 50, 5, 0);     settrv(20, 3000, 1, 2, 0);  setenv(1, 180, 0, 150);    setperf(12, 70, 0, 60);
              setffat(1, 0, 4, 100, 4); ) :                                                                                               // Zap Drum
  p == 12 ? ( setvco(2, 3, 0, 12.0, 45); setmod(4, 50, 5, 4);     settrv(250, 2200, 0, 1, 0); setenv(20, 600, 80, 350);  setperf(0, 200, 20, 20);
              setch(1, 0.7, 40, 35); ) :                                                                                                  // Hollow Pipe
  // the FX presets: the FX section up front
  p == 13 ? ( setvco(1, 3, 0, 0.1, 30);  setmod(5, 50, 5.5, 8);   settrv(40, 2200, 1, 1, 0);  setenv(4, 600, 75, 300);   setperf(0, 200, 30, 0);
              setph(1, 0.35, 75, 65); setdl(1, 4, 35, 50, 22); ) :                                                                      // Phase Lead
  p == 14 ? ( setvco(1, 1, 0, 0.08, 25); setmod(5, 50, 5, 0);     settrv(30, 900, 1, 1, 0);   setenv(2, 380, 50, 120);   setperf(0, 200, 0, 30);
              setffat(1, 1, 6, 100, 5); ) :                                                                                               // Ffat Fuzz Bass
  p == 15 ? ( setvco(2, 3, 0, 7.02, 30); setmod(5, 50, 5.5, 10);  settrv(80, 2600, 1, 1, 0);  setenv(10, 800, 70, 500);  setperf(0, 200, 60, 0);
              setffat(1, 0, 3, 60, 2); setch(1, 0.7, 50, 35); setdl(1, 6, 55, 35, 35); ) :                                              // Space Echo Lead
            ( setvco(0, 2, 2, 0, 40);    setmod(5, 50, 5, 0);     settrv(20, 4000, 1, 2, 0);  setenv(1, 220, 0, 160);    setperf(12, 90, 0, 60);
              setffat(1, 3, 6, 100, 3); setph(1, 2.5, 50, 60); setdl(1, 0, 40, 60, 25); );                                            // Crushed Zap
  pr_trim_t = patch_trim(p);                     // (applied at the silent point, with the new sound)
  slider_automate(2 ^ 24 - 1);                   // sliders 1-24
  slider_automate(dr_on); slider_automate(dr_type); slider_automate(dr_amt); slider_automate(dr_mix); slider_automate(ffat);
  slider_automate(ph_on); slider_automate(ph_rate); slider_automate(ph_dep); slider_automate(ph_fb);
  slider_automate(ch_on); slider_automate(ch_rate); slider_automate(ch_dep); slider_automate(ch_mix);
  slider_automate(dl_on); slider_automate(dl_div); slider_automate(dl_fb); slider_automate(dl_tone); slider_automate(dl_mix);
);

// ---------- notes ----------
// the envelope's timing (DRIFT): slow wander plus a fresh offset on every new note
function env_times() local(f) (
  f = 2 ^ ((sv_ew + (rand(2) - 1) * 0.6) * drift * 0.35);
  aenv.vo_adsr_set(slider15 * f, slider16 * f, slider17 / 100, slider18 * f);
);
function note_on(n, v) local(i, f, legato) (
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  tgt = n; vel = v / 127;
  !legato ? ( nd_mul = ins_note_detune() * 2 ^ ((rand(2) - 1) * drift * 0.05 / 12); env_times(); );
  porta_ms <= 0 ? cur = n;                       // PORTA glides between every note when it is up
  ab_v = ab_d;                                    // AUTO BEND starts from its depth on every new note
  aenv.vo_adsr_gate(1, !legato);
  gate = 1;
  ins_midi_hit();
);
function note_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? ( tgt = HN[hcount - 1]; porta_ms <= 0 ? cur = tgt; ) : ( aenv.vo_adsr_gate(0, 0); gate = 0; );
  );
);
function all_off() ( hcount = 0; aenv.vo_adsr_gate(0, 0); gate = 0; );

// ---------- parameters ----------
function update() local(k) (
  w1 = floor(slider1 + 0.5); oc1 = 2 ^ (floor(slider2 + 0.5) - 3);
  src2 = floor(slider3 + 0.5); tune2 = slider4; blend = slider5 / 100;
  mg_rate = slider6; pwm_d = slider7 / 100; vib_r = slider8; vib_d = slider9;
  hpf = slider10; lpf = slider11;
  rk = floor(slider12 + 0.5); rk = rk == 0 ? 1.7 : rk == 1 ? 0.85 : 0.22;
  eg_i = floor(slider13 + 0.5) * 2.6; mg_i = floor(slider14 + 0.5) * 1.1;
  ab_d = slider19; ab_c = 1 - exp(-1 / (max(slider20, 1) * 0.001 * srate / 4.6));
  porta_ms = slider21; porta_c = slider21 > 0 ? vo_coef(slider21) : 1;
  velsens = slider22 / 100;
  drift = slider23 / 100 * 1.6;                   // heavy: the universal drift pushed further
  vol_t = 10 ^ (slider24 / 20);
  pr_trim = pr_trim_t;
  ins_output_setup(26);   // output stage: CLIP, always on
  // the FX section (targets; the audio glides to them)
  dr_t = dr_amt; dmx_t = dr_mix / 100; ffat_t = ffat; dt_t = floor(dr_type + 0.5);
  ph_d = ph_dep / 100; ph_f = ph_fb / 100 * 0.9;
  ch_d = ch_dep / 100; ch_m = ch_mix / 100;
  k = floor(dl_div + 0.5);
  dl_beats = k == 0 ? 0.25 : k == 1 ? 1 / 3 : k == 2 ? 0.5 : k == 3 ? 2 / 3 : k == 4 ? 0.75 : k == 5 ? 1 : k == 6 ? 1.5 : 2;
  dl_fbg = dl_fb / 100; dl_dc = 1 - exp(-2 * $pi * min(1500 * 10 ^ (dl_tone / 100), 0.45 * srate) / srate); dl_mx = dl_mix / 100;
  os_tf = os_f2n(os_sel);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_base + os_lat(os_f);   // (ins_output_setup clears it)
);
// a preset loaded while a note sounds: the old sound fades out (12 ms), the new patch applies at the silent point
// and the note fades back in with it (12 ms), so the change never clicks
sv_preq = 0; sv_pcf = 0; sv_pck = sv_pcg = 1;
update();
dr_s = dr_t; dmix_s = dmx_t; ffat_s = ffat_t;
ph_ds = ph_d; ph_fs = ph_f; ch_ds = ch_d; ch_ms = ch_m; dl_ms_ = dl_mx; dl_fs = dl_fbg;
phx = ph_on >= 0.5; chx = ch_on >= 0.5; dlx = dl_on >= 0.5; drx = dr_on >= 0.5; ffx = drx;
vol_s = vol_t; tr_s = pr_trim;
env_times();
hcount = 0; aenv.vo_adsr_gate(0, 0); gate = 0;
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the
// preset bar asks through prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project
// or recalling its state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 16 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
!sv_preq && !sv_pcf ? update();

@block
prs_chk();
sv_pcr = 1 / (0.012 * srate);
fl_k = 1 - exp(-1 / (0.015 * srate));        // the filters' glide (15 ms stages)
sv_preq && !sv_pcf ? ( ae > 0.0001 ? sv_pcf = 1 : sv_preq = 0; );   // a note sounding: fade first
!sv_pcf ? update();
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? note_on(m2, m3) :
  st == 0x80 || (st == 0x90 && m3 == 0) ? note_off(m2) :
  st == 0xB0 && (m2 == 123 || m2 == 120) ? all_off() :
  st == 0xE0 ? bend = ins_bend(m2, m3, 2);
  midisend(mofs, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? all_off();
gfx_pst_prev = gfx_pst;
ins_drift_block(drift, samplesblock);              // GFX instrument drift (heavy)
sv_ew = sv_dE.drift_tick(0.3 * samplesblock / srate);
fx_dr = 1 + 0.15 * drift * sv_dF.drift_tick(0.35 * samplesblock / srate);   // DRIFT: the chorus / phaser clocks wander
sag_ka = 1 - exp(-1 / (0.15 * srate)); sag_kr = 1 - exp(-1 / (0.4 * srate));
// the FX section's block work: glides (30 ms), the drive's curves, the rates
kb = 1 - exp(-samplesblock / (0.03 * srate));
dr_s += (dr_t - dr_s) * kb; ffat_s += (ffat_t - ffat_s) * kb; ffx += ((dr_on >= 0.5) - ffx) * kb;
ds_curves();
cn = ffat_s / 10 * ffx;                            // FFAT squash: threshold, ratio and make-up rise together
c_thr = -32 * cn; c_sl = 1 - 1 / (1 + 5 * cn); c_mk = -c_thr * c_sl * 0.5;
c_att = 1 - exp(-1 / (0.003 * srate)); c_rel = 1 - exp(-1 / (0.09 * srate));
gl_sm = 1 - exp(-1 / (0.03 * srate)); sw_c = 1 - exp(-1 / (0.015 * srate)); dr_swk = 1 / (0.003 * srate);
ph_inc = ph_rate * fx_dr / srate;
ch_ia = 0.56 * ch_rate * fx_dr / srate; ch_ib = 7.14 * ch_rate * fx_dr / srate; ch_lpc = 1 - exp(-2 * $pi * 9000 / srate);
dl_tt = min(DLN - 4, dl_beats * 60 / max(tempo, 20) * srate); dtm_c = 1 - exp(-1 / (0.15 * srate));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, sv_pal);
file_var(0, pr_trim_t); pr_trim = pr_trim_t;
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
sv_pcf ? ( sv_pck -= sv_pcr; sv_pck <= 0 ? ( sv_pck = 0; sv_pcf = 0; sv_preq = 0; update(); ); sv_pcg = 0.5 - 0.5 * cos($pi * sv_pck); ) :
sv_pck < 1 ? ( sv_pck = min(sv_pck + sv_pcr, 1); sv_pcg = 0.5 - 0.5 * cos($pi * sv_pck); );
// pitch: portamento, auto bend, vibrato, drift (and the supply sagging under loud playing)
cur += (tgt - cur) * porta_c;
ab_v -= ab_v * ab_c;
vb_ph += vib_r / srate; vb_ph -= floor(vb_ph);
semi = cur + ab_v + sin(2 * $pi * vb_ph) * vib_d / 100 - sag * drift * 0.05;
f1 = 440 * 2 ^ ((semi - 69) / 12) * bend * ins_pitch * nd_mul * oc1;
inc1 = min(f1 / srate, 0.45);
inc2 = min(inc1 * 2 ^ ((tune2 + ins_aux) / 12), 0.45);

// MG: the main LFO (triangle), for PWM and the filters
mg_ph += mg_rate / srate; mg_ph -= floor(mg_ph);
mg = mg_ph < 0.5 ? 4 * mg_ph - 1 : 3 - 4 * mg_ph;

// VCO 1
v1 = w1 == 0 ? t1.sv_tri(inc1) : w1 == 1 ? o1.vo_saw(inc1) : w1 == 2 ? o1.vo_pulse(inc1, 0.5) :
     w1 == 3 ? o1.vo_pulse(inc1, min(max(0.25 + ins_cut * 0.04, 0.08), 0.92)) :
               o1.vo_pulse(inc1, min(max(0.5 + mg * pwm_d * 0.44 + ins_cut * 0.04, 0.06), 0.94));

// VCO 2: saw, ring (VCO 1 x VCO 2), or noise
wn = rand(2) - 1;
src2 == 0 ? v2 = o2.vo_saw(inc2) :
src2 == 1 ? v2 = v1 * o2.vo_saw(inc2) :
src2 == 2 ? v2 = wn :
src2 == 3 ? ( pb0 = 0.99765 * pb0 + wn * 0.0990460; pb1 = 0.96300 * pb1 + wn * 0.2965164; pb2 = 0.57000 * pb2 + wn * 1.0526913;
              v2 = (pb0 + pb1 + pb2 + wn * 0.1848) * 0.22; ) :
            ( rn += (wn - rn) * 0.03; v2 = rn * 4; );
y = (v1 * (1 - blend) + v2 * blend) * 0.45;

// the FILTER: HPF then LPF, moved by the EG and the MG (and DRIFT)
// (HPF and LPF glide in two 15 ms stages, RESONANCE, EG and MG in one: a turned knob or a key never steps)
!fl_ok ? ( fl_h1 = fl_h2 = log(hpf); fl_l1 = fl_l2 = log(lpf); fl_rk = rk; fl_eg = eg_i; fl_mg = mg_i; fl_ok = 1; );
fl_h1 += (log(hpf) - fl_h1) * fl_k; fl_h2 += (fl_h1 - fl_h2) * fl_k; fl_l1 += (log(lpf) - fl_l1) * fl_k; fl_l2 += (fl_l1 - fl_l2) * fl_k;
fl_rk += (rk - fl_rk) * fl_k; fl_eg += (eg_i - fl_eg) * fl_k; fl_mg += (mg_i - fl_mg) * fl_k;
ae = aenv.vo_adsr();
oct = (fl_eg * ae + fl_mg * mg + ins_cut - sag * drift * 0.1) * 0.693147;
fh.sv_svf(y, min(max(exp(fl_h2 + oct), 15), srate * 0.45), fl_rk); y = fh.hp;
fl.sv_svf(y, min(max(exp(fl_l2 + oct), 30), srate * 0.45), fl_rk); y = fl.lp;
y = vo_tanh(y * 0.8) / 0.8;

// VCA (the supply sags as the level it delivers rises)
y *= ae * (1 - velsens + velsens * vel);
sag += (ae - sag) * (ae > sag ? sag_ka : sag_kr);

// DC block, the preset fade
dy = y - dxp + 0.9995 * dyp; dxp = y; dyp = dy; y = dy;      // DC block low enough for 64' notes
y *= sv_pcg;

// ---------- FX SECTION ----------
phx += ((ph_on >= 0.5) - phx) * sw_c; chx += ((ch_on >= 0.5) - chx) * sw_c; dlx += ((dl_on >= 0.5) - dlx) * sw_c;
drx += ((dr_on >= 0.5) - drx) * sw_c;
dmix_s += (dmx_t - dmix_s) * gl_sm; ph_ds += (ph_d - ph_ds) * gl_sm; ph_fs += (ph_f - ph_fs) * gl_sm;
ch_ds += (ch_d - ch_ds) * gl_sm; ch_ms += (ch_m - ch_ms) * gl_sm; dl_ms_ += (dl_mx - dl_ms_) * gl_sm; dl_fs += (dl_fbg - dl_fs) * gl_sm;
// FFAT: the drive (oversampled with the OS key) crossfaded in; a TYPE change dips to the clean sound and swaps there
os_gate();
os_chg ? ( osu.os_clr(); osd.os_clr(); dsA.ds_reset(); dsA.pf.clp_pf_reset(); dsA.pf.clp_pf_block(dr_s / 10, srate * os_f, 1);
           ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f); memset(DRB, 0, 64); );
dt_t != dt_a ? ( dr_sw = max(0, dr_sw - dr_swk); dr_sw == 0 ? ( dsA.ds_reset(); dt_a = dt_t; ds_curves(); ); ) :
dr_sw < 1 ? dr_sw = min(1, dr_sw + dr_swk);
drx > 0.0001 || os_f > 1 ? (
  DRB[drw] = y; yd = DRB[(drw - os_lat(os_f)) & 63]; drw = (drw + 1) & 63;   // the clean sound, in time with the drive
  y = drive_os(y);
  y = yd + (y - yd) * drx * dr_sw;
  ds_idle = 0;
) : ( !ds_idle ? ( dsA.ds_reset(); ds_idle = 1; ); );
// FFAT squash (soft 6 dB knee, auto make-up)
cn > 0.001 ? (
  cl = abs(y); cdb = cl > 0.000001 ? 20 * log10(cl) : -120;
  ov = cdb - c_thr;
  cg = ov <= -3 ? 0 : ov >= 3 ? ov * c_sl : c_sl * sqr(ov + 3) / 12;
  grs += (cg - grs) * (cg > grs ? c_att : c_rel);
  y *= db2g(c_mk - grs);
) : ( grs = 0; );
yl = y; yr = y;
// PHASER: 6 first-order all-passes swept from 200 Hz to 4 kHz (DEPTH), feedback round them; left and right 90 degrees apart
phx > 0.0001 ? (
  ph_p += ph_inc; ph_p -= floor(ph_p);
  g_a = 200 * 20 ^ (ph_ds * (0.5 + 0.5 * sin(2 * $pi * ph_p))); g_b = 200 * 20 ^ (ph_ds * (0.5 + 0.5 * cos(2 * $pi * ph_p)));
  g_a = tan($pi * g_a / srate); g_a = (g_a - 1) / (g_a + 1); g_b = tan($pi * g_b / srate); g_b = (g_b - 1) / (g_b + 1);
  u = yl + phl_fb * ph_fs; k = 0; loop(6, t = g_a * u + PHS[k]; PHS[k] = u - g_a * t; u = t; k += 1; ); phl_fb = u;
  yl = yl + (u - yl) * 0.5 * phx;
  u = yr + phr_fb * ph_fs; k = 0; loop(6, t = g_b * u + PHS[8 + k]; PHS[8 + k] = u - g_b * t; u = t; k += 1; ); phr_fb = u;
  yr = yr + (u - yr) * 0.5 * phx;
  ph_z = 1;
) : ph_z ? ( memset(PHS, 0, 16); phl_fb = 0; phr_fb = 0; ph_z = 0; );    // out: it starts clean next time
// CHORUS: three lines (2 - 7 ms), a three-phase LFO - 0.56 Hz and 7.14 Hz mixed 10:1
CHB[ch_w] = (yl + yr) * 0.5;                                           // (the line is kept fresh while the chorus is out)
chx > 0.0001 ? (
  ch_pa += ch_ia; ch_pa -= floor(ch_pa); ch_pb += ch_ib; ch_pb -= floor(ch_pb);
  k = 0; c_l = 0; c_r = 0;
  loop(3,
    t = (abs(2 * fx_frac(ch_pa + k / 3) - 1) * 10 + abs(2 * fx_frac(ch_pb + k / 3) - 1)) / 11;   // two triangles, 120 degrees apart per line
    d = (2.2 + (2 + 3 * t) * ch_ds) * 0.001 * srate;
    u = ch_w - d; u < 0 ? u += CHN; i = floor(u); f = u - i; j = i + 1; j >= CHN ? j = 0;
    u = CHB[i] + (CHB[j] - CHB[i]) * f;
    k == 0 ? ( c_l += u; ) : k == 1 ? ( c_l += u * 0.5; c_r += u * 0.5; ) : ( c_r += u; );
    k += 1; );
  ch_lp1 += (c_l - ch_lp1) * ch_lpc; ch_lp2 += (c_r - ch_lp2) * ch_lpc;                       // a darker top, as a BBD's
  yl += ch_lp1 * 0.75 * ch_ms * chx; yr += ch_lp2 * 0.75 * ch_ms * chx;
  yl *= 1 - 0.25 * ch_ms * chx; yr *= 1 - 0.25 * ch_ms * chx;
);
ch_w += 1; ch_w >= CHN ? ch_w = 0;
// DELAY: a note value (glided), FEEDBACK through TONE and a soft limit in the loop, MIX; ping-pong
dlx > 0.0001 || dl_tail > 0.00001 ? (
  dl_ts += (dl_tt - dl_ts) * dtm_c;
  u = dl_w - dl_ts; u < 0 ? u += DLN; i = floor(u); f = u - i; j = i + 1; j >= DLN ? j = 0;
  el = DLB[i] + (DLB[j] - DLB[i]) * f; er = DLB[DLN + i] + (DLB[DLN + j] - DLB[DLN + i]) * f;
  dl_fl += (el - dl_fl) * dl_dc; dl_fr += (er - dl_fr) * dl_dc;
  DLB[dl_w] = fx_ts(((yl + yr) * 0.5 * dlx + dl_fr * dl_fs) * 1.1) / 1.1; DLB[DLN + dl_w] = fx_ts(dl_fl * dl_fs * 1.1) / 1.1;   // in on the left, the repeats cross
  yl += el * dl_ms_; yr += er * dl_ms_;
  dl_tail = max(abs(el), abs(er)) * 0.002 + dl_tail * 0.998;
) : ( DLB[dl_w] = 0; DLB[DLN + dl_w] = 0; dl_ts = dl_tt; );
dl_w += 1; dl_w >= DLN ? dl_w = 0;

// volume, the GFX output stage
vol_s += (vol_t - vol_s) * sm;
tr_s += (pr_trim - tr_s) * gl_sm;                          // the preset's level trim, after the FX (glided)
oL = ostL.ost_band(yl * vol_s * tr_s); oR = ostR.ost_band(yr * vol_s * tr_s);
ost_out(oL * os_g, oR * os_g);
spl0 = ost_l; spl1 = ost_r;
pk_disp = max(pk_disp, max(abs(spl0), abs(spl1)));

@gfx 960 724
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_begin(960, 724);

// faceplate colours: sv_pal 0 = olive (default), 1 = slate (the two swatches in the header)
ORG = 0xE08A1E; CAPO = 0xE08A1E; CAPC = 0xF6EFDF; CAPG = 0x9DA2A8;
sv_pal == 1 ? ( PNL = 0x3A4552; SH1 = 0x445160; SH2 = 0x3E4A58; SH3 = 0x35404C; INK = 0xEEF0F2; DIMI = 0xA9B4C0; CAPD = 0xEEF0F2; SQBG = 0x1F252D; BTX = 0xFFF6E8; ORG = 0xE0701E; CAPO = 0xE0701E; ) :
              ( PNL = 0x3F4227; SH1 = 0x4A4D2F; SH2 = 0x43462A; SH3 = 0x393C23; INK = 0xEFE9D4; DIMI = 0xBDB89A; CAPD = 0xEFE9D4; SQBG = 0x23251A; BTX = 0xFFF6E8; );
SLOT = ui_mix(PNL, 0x000000, 0.65);
dy_ink = INK; dy_bg = PNL; dy_nov = 1; rd_sqbg = SQBG;
dy_ntick = 5;                  // five marks round a plain dial (JG, 29 Oct 2026)
#sv_pm = "Seventy Lead|64' Bass|Filter Sweep|Ring Bells|PWM Strings|Auto Bend Brass|Whistle|Wind|Squelch|Theremin|Zap Drum|Hollow Pipe|Phase Lead|Ffat Fuzz Bass|Space Echo Lead|Crushed Zap";
ui_fitfont(12, 12.5 * sc);     // display-box labels
ui_fitfont(13, 14 * sc);       // lamp-key legends

function pr_go(n) ( prs_dirty = n; pr_cur = n; );
function setv(idx, v) ( slider(idx) = v; slider_automate(2 ^ (idx - 1)); );
// recessed front-panel section (the GFX instrument inset): sloped walls, corner creases, light from the top left
function inset(x, y, w, h, col) local(b, ox, oy, ow, oh) (
  x *= sc; y *= sc; w *= sc; h *= sc; b = 5 * sc;
  ox = x - b; oy = y - b; ow = w + 2 * b; oh = h + 2 * b;
  ui_col(ui_mix(col, 0x000000, 0.30)); gfx_triangle(ox, oy, ox + ow, oy, x + w, y, x, y);
  ui_col(ui_mix(col, 0x000000, 0.18)); gfx_triangle(ox, oy, x, y, x, y + h, ox, oy + oh);
  ui_col(ui_mix(col, 0xFFFFFF, 0.30)); gfx_triangle(ox, oy + oh, x, y + h, x + w, y + h, ox + ow, oy + oh);
  ui_col(ui_mix(col, 0xFFFFFF, 0.12)); gfx_triangle(ox + ow, oy, ox + ow, oy + oh, x + w, y + h, x + w, y);
  ui_col(col); gfx_rect(x, y, w, h);
  gfx_gradrect(x, y, w, 6 * sc, 0, 0, 0, 0.14, 0, 0, 0, 0, 0, 0, 0, -0.14 / (6 * sc));
  ui_cola(0x000000, 0.30); gfx_line(ox, oy, x, y, 1); gfx_line(ox + ow, oy, x + w, y, 1);
  ui_cola(0xFFFFFF, 0.35); gfx_line(ox, oy + oh, x, y + h, 1); gfx_line(ox + ow, oy + oh, x + w, y + h, 1);
);
// section title: an orange band across the top of the inset
function band(x, y, w, s) ( ui_col(ORG); gfx_rect(x * sc, y * sc, w * sc, 18 * sc); gfx_setfont(4); ui_col(BTX); gfx_x = (x + 8) * sc; gfx_y = (y + 3) * sc; gfx_drawstr(s); );
// a row of lit keys for a stepped slider
function keys(x, y, w, h, gap, idx, n, names) local(i) (
  i = 0;
  loop(n,
    strcpy_substr(#kn, names, i * 4, 4);
    while (strlen(#kn) > 0 && str_getchar(#kn, strlen(#kn) - 1) == ' ') ( strcpy_substr(#kn, #kn, 0, strlen(#kn) - 1); );
    rd_sq(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == i, ORG, #kn) ? setv(idx, i);
    i += 1;
  );
);
// the wave symbols on the WAVE keys: 0 triangle, 1 saw, 2 square, 3 narrow pulse, 4 PWM (pulse with a width arrow)
function wglyph(cx, cy, t, on) local(x0, x1, y0, y1, w, k) (
  ui_col(on ? 0x1A1210 : 0xE8DCC6); w = 30; x0 = cx - w / 2; x1 = cx + w / 2; y0 = cy - 7; y1 = cy + 7;
  k = 0; loop(2,
    t == 0 ? ( gfx_line(x0 * sc, (y1 + k) * sc, (cx - 7.5) * sc, (y0 + k) * sc, 1); gfx_line((cx - 7.5) * sc, (y0 + k) * sc, (cx + 7.5) * sc, (y1 + k) * sc, 1);
               gfx_line((cx + 7.5) * sc, (y1 + k) * sc, x1 * sc, (y0 + k) * sc, 1); ) :
    t == 1 ? ( gfx_line(x0 * sc, (y1 + k) * sc, cx * sc, (y0 + k) * sc, 1); gfx_line(cx * sc, (y0 + k) * sc, cx * sc, (y1 + k) * sc, 1);
               gfx_line(cx * sc, (y1 + k) * sc, x1 * sc, (y0 + k) * sc, 1); gfx_line(x1 * sc, (y0 + k) * sc, x1 * sc, (y1 + k) * sc, 1); ) :
    ( w = t == 2 ? 7.5 : 3.5;
      gfx_line(x0 * sc, (y1 + k) * sc, x0 * sc, (y0 + k) * sc, 1); gfx_line(x0 * sc, (y0 + k) * sc, (x0 + w) * sc, (y0 + k) * sc, 1);
      gfx_line((x0 + w) * sc, (y0 + k) * sc, (x0 + w) * sc, (y1 + k) * sc, 1); gfx_line((x0 + w) * sc, (y1 + k) * sc, (x0 + 15) * sc, (y1 + k) * sc, 1);
      gfx_line((x0 + 15) * sc, (y1 + k) * sc, (x0 + 15) * sc, (y0 + k) * sc, 1); gfx_line((x0 + 15) * sc, (y0 + k) * sc, (x0 + 15 + w) * sc, (y0 + k) * sc, 1);
      gfx_line((x0 + 15 + w) * sc, (y0 + k) * sc, (x0 + 15 + w) * sc, (y1 + k) * sc, 1); gfx_line((x0 + 15 + w) * sc, (y1 + k) * sc, x1 * sc, (y1 + k) * sc, 1); );
    k += 0.6;
  );
  t == 4 ? ( gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 9) * sc, (cy + 10) * sc, 1);
             gfx_line((x0 + 15 + 9) * sc, (cy + 10) * sc, (x0 + 15 + 6) * sc, (cy + 8) * sc, 1); gfx_line((x0 + 15 + 9) * sc, (cy + 10) * sc, (x0 + 15 + 6) * sc, (cy + 12) * sc, 1);
             gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 2) * sc, (cy + 8) * sc, 1); gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 2) * sc, (cy + 12) * sc, 1); );
);
// recolour a house filter knob's cap and pointer (same geometry as the house knob); n = position 0..1
function fcap(cx, cy, r, n, cap, ptr) local(rr, a1) (
  cx *= sc; cy *= sc; r *= sc; rr = r * 0.74; a1 = -0.75 * $pi + n * 1.5 * $pi;
  ui_col(ui_mix(cap, 0x000000, 0.35)); gfx_circle(cx, cy, rr + 1 * sc, 1, 1);
  ui_col(cap); gfx_circle(cx, cy, rr, 1, 1);
  ui_cola(0xFFFFFF, 0.18); gfx_circle(cx - rr * 0.3, cy - rr * 0.35, rr * 0.45, 1, 1);
  ui_col(cap); gfx_circle(cx + rr * 0.05, cy + rr * 0.1, rr * 0.62, 1, 1);
  ui_kline(cx, cy, a1, rr * 0.15, r * 0.98, 2.2, ptr);
);
// a cycle key: click steps forward, right-click back
function cyc(x, y, w, h, idx, n) local(hov, v) (
  v = floor(slider(idx) + 0.5);
  rd_sq(x, y, w, h, 1, ORG, "") ? setv(idx, (v + 1) % n);
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hov && (mouse_cap & 2) && !(sv_rcap & 2) ? setv(idx, (v + n - 1) % n);
);
// position dots under a cycle key
function dots(cx, y, n, cur) local(i, x0) (
  x0 = cx - (n - 1) * 5; i = 0;
  loop(n, i == cur ? ui_col(ORG) : ui_cola(INK, 0.35); gfx_circle((x0 + i * 10) * sc, y * sc, 2.6 * sc, 1, 1); i += 1; );
);


// ---------- panel parts ----------
// a mode display box: dark recessed window with light text, its label above (small caps); returns 1 when clicked
function dbox(x, y, w, h, lbl, s) local(hit, hov) (
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  gfx_setfont(12); ui_col(DIMI); ui_text((x + w * 0.5) * sc, (y - 13) * sc, lbl);
  ui_cola(0x000000, 0.35); gfx_rect((x + 1) * sc, (y + 2) * sc, w * sc, h * sc);
  ui_col(0x0A0A08); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  ui_col(0x1E1D18); gfx_rect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc);
  ui_cola(0x000000, 0.5); gfx_rect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, 2 * sc); gfx_rect((x + 2) * sc, (y + 2) * sc, 2 * sc, (h - 4) * sc);
  hov ? ( ui_cola(0xFFFFFF, 0.06); gfx_rect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc); );
  gfx_setfont(13); ui_col(0xF2E6C8); ui_text((x + w * 0.5) * sc, (y + h * 0.5 - 7) * sc, s);
  hit;
);

// ---------- panel ----------
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(PNL); gfx_rect(0, 0, 960 * sc, 724 * sc);
gfx_gradrect(0, 0, 960 * sc, 270 * sc, 1, 1, 1, 0.10, 0, 0, 0, 0, 0, 0, 0, -0.10 / (270 * sc));
ui_col(ORG); gfx_rect(0, 64 * sc, 960 * sc, 4 * sc);
ui_cola(0x000000, 0.25); gfx_rect(0, 720 * sc, 960 * sc, 4 * sc);

// header: badge, name, presets [PRESETS][◄][►][LCD], MIDI, size
rd_badge(36, 32, 16, INK, PNL);
rd_title(62, 14, "SEVENTY", 28, INK);
rd_sub(66, 46, "MONOPHONIC SYNTHESIZER", DIMI, 1);
