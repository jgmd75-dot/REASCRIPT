desc:Seventy [mono synth] (GFX Lab)
//tags: instrument synth mono lead bass analog 70s sequencer step accent slide
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-drift, gfx-lab-voice, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-dyn, gfx-lab-faceplate (.jsfx-inc).
//
// A monophonic synth in the spirit of the mid-70s two-oscillator Japanese monos, with a 16-step sequencer built in
// (the Lab rework, Oct 2026):
//   VCO 1      triangle, saw, square, pulse, or pulse-width modulated by the MG; six octaves, 64' to 2'.
//   VCO 2      saw, ring-modulated against VCO 1, or white / pink / red noise; TUNE offsets it from VCO 1.
//   BLEND      the mix of the two sources.
//   FILTER     a high-pass and a low-pass filter in series (HPF and LPF knobs), 12 dB each, with a three-step
//              RESONANCE switch; EG and MG switches set how far the envelope and the MG move them.
//   AUTO BEND  a pitch bend into every new note (up or down, with its own time); VIBRATO has its own LFO.
//   ENVELOPE   attack, decay, sustain, release for the filter and the amp. Last-note priority, portamento.
// SEQUENCER (new): 16 steps, each with its own NOTE (an octave below to two above the key), ON, ACCENT and SLIDE.
//   ACCENT     an accented step plays louder and opens the filter with an extra sweep; accents close together
//              stack up, so a run of them gets brighter and brighter. The ACCENT dial sets how far both go
//              (plain steps sit back a little as it goes up, so accents jump out).
//   SLIDE      a step with SLIDE lit glides into the next step without a new attack (SLIDE dial = glide time).
//   GATE       how long a plain step holds (10 - 100 % of the step); SWING delays every second step.
//   RATE       1/8, 1/16, 1/32 or triplets, at the project tempo. LAST STEP shortens the pattern (1 - 16).
//   PATTERN    eight patterns, saved with the project; a new pattern takes over when the current one comes round.
//   KEYS       while the sequencer runs, a key played transposes the pattern (C3 = as written) and stays until the
//              next key; stopped, the keyboard plays the synth as before.
//   RUN        starts and stops it (it never starts by itself); FOLLOW runs it with REAPER's transport instead.
//              While REAPER plays, the steps lock to the timeline (bar 1 = step 1); stopped, RUN free-runs at the
//              project tempo.
// DRIFT (heavy, 70s unstable; 60% by default): the universal GFX instrument drift pushed harder - pitch, VCO 2
//   detune, pulse width and the filters wander, with a random tuning offset on each new note - and the envelope's
//   timing wanders too, a little different on every note. The supply sags under a busy, accented line (pitch
//   dips a few cents, the filter darkens a touch, both recover in a moment) and the sequencer's clock is a hair
//   loose (well under a millisecond). 0% = steady.
// IN / OUT: the GFX band saturation (SAT on the panel); the output soft clip is always on.
// MIDI: note on / off, pitch bend (+/- 2 st), CC120 / 123; MIDI passes through.
// PRESETS: twelve sounds (the sequencer left as it is) and four sequence presets that also set the sequencer and
//   pick a pattern; chosen from the preset bar or the hidden Preset parameter.
// Latency: none.

import gfx-lab-drift.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-faceplate.jsfx-inc

slider1:1<0,4,1{Triangle,Saw,Square,Pulse,PWM}>-VCO 1 wave
slider2:3<0,5,1{64',32',16',8',4',2'}>-VCO 1 octave
slider3:0<0,4,1{Saw,Ring,White noise,Pink noise,Red noise}>-VCO 2 source
slider4:0.12<-12,12,0.01>-VCO 2 tune (semitones)
slider5:35<0,100,1>-Blend (VCO 1 - VCO 2, %)
slider6:5<0.1,30,0.01>-MG rate (Hz)
slider7:50<0,100,1>-PWM depth (%)
slider8:5.5<1,12,0.01>-Vibrato rate (Hz)
slider9:12<0,100,1>-Vibrato depth (cents)
slider10:20<20,8000,1>-Filter HPF (Hz)
slider11:1800<60,18000,1>-Filter LPF (Hz)
slider12:1<0,2,1{Low,Mid,High}>-Resonance
slider13:1<0,2,1{Off,Half,Full}>-EG to filter
slider14:0<0,2,1{Off,Half,Full}>-MG to filter
slider15:5<1,5000,0.1>-Attack (ms)
slider16:700<10,8000,1>-Decay (ms)
slider17:70<0,100,1>-Sustain (%)
slider18:300<10,8000,1>-Release (ms)
slider19:0<-12,12,0.1>-Auto bend depth (semitones)
slider20:200<10,2000,1>-Auto bend time (ms)
slider21:40<0,1500,1>-Portamento (ms)
slider22:0<0,100,1>-Velocity (%)
slider23:60<0,100,1>-Drift (%)
slider24:0<-24,6,0.1>-Volume (dB)
slider25:seq_pat=0<0,7,1{1,2,3,4,5,6,7,8}>-Sequencer pattern
slider26:0<0,100,1>-Band sat (%)
slider27:30<0,100,1>-Bias (%)
slider28:120<40,400,1>-Sat low band (Hz)
slider29:6000<2000,16000,10>-Sat high band (Hz)
slider30:-0.3<-24,0,0.1>-Ceiling (dB)
slider31:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider32:seq_rate=1<0,4,1{1/8,1/16,1/32,1/8 triplet,1/16 triplet}>-Sequencer rate
slider33:seq_swing=0<0,75,1>-Sequencer swing (%)
slider34:seq_gate=55<10,100,1>-Sequencer gate (%)
slider35:seq_acc=60<0,100,1>-Sequencer accent (%)
slider36:seq_slide=70<10,400,1>-Sequencer slide (ms)
slider37:seq_follow=0<0,1,1{Off,On}>-Sequencer follows transport
slider38:prs_sel=0<0,16,1{No preset,Seventy Lead,64' Bass,Filter Sweep,Ring Bells,PWM Strings,Auto Bend Brass,Whistle,Wind,Squelch,Theremin,Zap Drum,Hollow Pipe,Acid Squelch,Octave Bass,Berlin Pulse,Rubber Lead}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-g-seventy";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; sv_pal = 0; pr_trim_t = 1; );   // first instance: M size, olive faceplate
HN = 1000; hcount = 0;                       // held-note stack (last-note priority)
SQB = 16384;                                  // the patterns: 8 x 16 steps x (note, on, accent, slide); lengths at SQB + 512
fl_ok = 0;
memset(HN, 0, 128);
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
ins_drift_init();
sv_dE.drift_init(0.8 + rand(1) * 0.5);            // the envelope's slow timing wander
bend = 1; nd_mul = 1; cur = 60; tgt = 60; vel = 0.8; gate = 0; ab_v = 0;
sm = vo_coef(30);
dxp = dyp = 0;
acc_g = acc_gt = 1; acc_e = acc_s = 0; sag = 0;
sq_run = 0; sq_gate = 0; sq_off_t = -1; sq_tr = 0; seq_tr_d = 0; seq_step_d = -1; seq_run_d = 0;

// ---------- the filters: 12 dB state-variable (TPT), low-pass and high-pass outputs ----------
function sv_svf(x, fc, k) instance(ic1, ic2, lp, hp) local(g, a1, a2, a3, v1, v2, v3) (
  g = tan($pi * min(fc, srate * 0.45) / srate);
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  lp = v2; hp = x - k * v1 - v2;
);
// a naive triangle is clean enough (its harmonics fall fast); own phase
function sv_tri(inc) instance(ph) ( ph += inc; ph -= floor(ph); ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph; );

// per-preset level trim (keeps the hottest patches out of the output clipper; quieter ones are left alone)
function patch_trim(p) (
  p == 1 ? 1.000 : p == 2 ? 1.000 : p == 3 ? 0.440 : p == 4 ? 1.000 : p == 5 ? 0.720 : p == 6 ? 1.000 :
  p == 7 ? 0.320 : p == 8 ? 0.620 : p == 9 ? 1.000 : p == 10 ? 0.530 : p == 11 ? 1.000 : p == 12 ? 1.000 :
  p == 13 ? 1.000 : p == 14 ? 0.950 : p == 15 ? 1.500 : 0.800;
);

// ---------- the patterns ----------
// a pattern as text: one word per step - the note in semitones from the key (C3), "a" = accent, "s" = slide,
// "-" = a rest; e.g. "0a 0 12s 0 3a - ..."
function sq_parse(p, len, s) local(i, c, d, k, v, neg, has, a, sl, rest, b, n) (
  k = 0; i = 0; v = 0; neg = 0; has = 0; a = 0; sl = 0; rest = 0; n = strlen(s);
  loop(n + 1,
    c = i < n ? str_getchar(s, i) : 32;
    c == 32 ? (
      (has || rest) && k < 16 ? ( b = SQB + (p * 16 + k) * 4; b[0] = neg ? -v : v; b[1] = !rest; b[2] = a; b[3] = sl; k += 1; );
      v = 0; neg = 0; has = 0; a = 0; sl = 0; rest = 0;
    ) : c == 45 ? (
      d = i + 1 < n ? str_getchar(s, i + 1) : 32;
      d >= 48 && d <= 57 ? ( neg = 1; ) : ( rest = 1; );
    ) : c >= 48 && c <= 57 ? ( v = v * 10 + c - 48; has = 1; ) :
    c == 97 ? ( a = 1; ) : c == 115 ? ( sl = 1; );
    i += 1;
  );
  loop(16 - k, b = SQB + (p * 16 + k) * 4; b[0] = 0; b[1] = 0; b[2] = 0; b[3] = 0; k += 1; );
  SQB[512 + p] = len;
);
function sq_factory(p) (
  p == 0 ? sq_parse(0, 16, "0a 0 12s 0 3a - 15s 3 0a 12 0s 10a 7 - 3as 5") :          // acid line
  p == 1 ? sq_parse(1, 16, "0a 12 0 12 0a 12 0 12 3a 15 3 15 -2a 10 -2 10") :          // octave bass
  p == 2 ? sq_parse(2, 16, "0a 7 12 7 3 7 10 7 0a 7 12 7 5 7 15 7") :                  // Berlin pulse
  p == 3 ? sq_parse(3, 16, "0s 5s 7 - 0 - 10s 12 7a - 5s 3 0 - -2s 0") :                // rubber slides
  p == 4 ? sq_parse(4, 16, "0a - 0 12a - 0 10 - 0a - 7 - 5a - 3 0") :                  // funk
  p == 5 ? sq_parse(5, 16, "0a 3 5 7 10a 7 5 3 0a 3 5 7 12a 10 7 5") :                 // minor walk
  p == 6 ? sq_parse(6, 16, "0a - - 0 - - 7a - 5 - - 3 - - 0s 12") :                    // dub
           sq_parse(7, 12, "0a 0 12 0a 0 7 0a 0 10 0a 3s 5");                          // 12-step pulse (against the bar)
);
!seq_ok ? ( k = 0; loop(8, sq_factory(k); k += 1; ); seq_ok = 1; );

// ---------- presets (audio side only) ----------
function setvco(w, o, s2, tu, bl) ( slider1 = w; slider2 = o; slider3 = s2; slider4 = tu; slider5 = bl; );
function setmod(mr, pd, vr, vd) ( slider6 = mr; slider7 = pd; slider8 = vr; slider9 = vd; );
function settrv(hp, lp, rs, eg, mg) ( slider10 = hp; slider11 = lp; slider12 = rs; slider13 = eg; slider14 = mg; );
function setenv(a, d, s, r) ( slider15 = a; slider16 = d; slider17 = s; slider18 = r; );
function setperf(bd, bt, pt, vl) ( slider19 = bd; slider20 = bt; slider21 = pt; slider22 = vl; );
function setseq(pat, rt, sw, gt, ac, sd) (
  seq_pat = pat; seq_rate = rt; seq_swing = sw; seq_gate = gt; seq_acc = ac; seq_slide = sd;
  slider_automate(seq_pat); slider_automate(seq_rate); slider_automate(seq_swing);
  slider_automate(seq_gate); slider_automate(seq_acc); slider_automate(seq_slide);
);
function load_preset(p) (
  sv_preq = 1;                                   // (first: the audio thread holds the old sound until it has faded)
  p == 1  ? ( setvco(1, 3, 0, 0.12, 35); setmod(5, 50, 5.5, 12);  settrv(20, 1800, 1, 1, 0);  setenv(5, 700, 70, 300);   setperf(0, 200, 40, 0);   ) :   // Seventy Lead
  p == 2  ? ( setvco(2, 1, 0, 12.05, 30);setmod(5, 50, 5.5, 0);   settrv(20, 700, 1, 1, 0);   setenv(2, 450, 40, 120);   setperf(0, 200, 0, 30);   ) :   // 64' Bass (32' + VCO 2 an octave up)
  p == 3  ? ( setvco(1, 2, 0, 0.2, 50);  setmod(0.25, 50, 5, 0);  settrv(60, 900, 2, 0, 2);   setenv(10, 1000, 100, 600);setperf(0, 200, 0, 0);    ) :   // Filter Sweep
  p == 4  ? ( setvco(2, 3, 1, 7.0, 75);  setmod(5, 50, 5, 0);     settrv(200, 6000, 1, 1, 0); setenv(1, 1600, 0, 1400);  setperf(0, 200, 0, 40);   ) :   // Ring Bells
  p == 5  ? ( setvco(4, 3, 0, 0.15, 25); setmod(0.6, 80, 5, 6);   settrv(150, 3200, 0, 0, 0); setenv(250, 800, 85, 700); setperf(0, 200, 0, 0);    ) :   // PWM Strings
  p == 6  ? ( setvco(1, 3, 0, 0.1, 40);  setmod(5, 50, 5.5, 8);   settrv(60, 1200, 1, 2, 0);  setenv(40, 500, 70, 250);  setperf(-1.5, 120, 0, 40);) :   // Auto Bend Brass
  p == 7  ? ( setvco(0, 4, 3, 0, 8);     setmod(5, 50, 6, 18);    settrv(400, 5000, 2, 0, 0); setenv(30, 300, 90, 400);  setperf(0.6, 90, 60, 0);  ) :   // Whistle
  p == 8  ? ( setvco(0, 3, 3, 0, 100);   setmod(0.15, 50, 5, 0);  settrv(300, 1500, 2, 0, 2); setenv(800, 2000, 90, 2000);setperf(0, 200, 0, 0);    ) :   // Wind
  p == 9  ? ( setvco(3, 2, 0, 0.1, 20);  setmod(5, 50, 5, 0);     settrv(20, 250, 2, 2, 0);   setenv(1, 280, 10, 120);   setperf(0, 200, 30, 50);  ) :   // Squelch
  p == 10 ? ( setvco(0, 3, 0, 0, 0);     setmod(5, 50, 6.2, 30);  settrv(20, 2500, 0, 0, 0); setenv(120, 500, 100, 500);setperf(0, 200, 180, 0);  ) :   // Theremin
  p == 11 ? ( setvco(0, 1, 2, 0, 35);    setmod(5, 50, 5, 0);     settrv(20, 3000, 1, 2, 0);  setenv(1, 180, 0, 150);    setperf(12, 70, 0, 60);   ) :   // Zap Drum
  p == 12 ? ( setvco(2, 3, 0, 12.0, 45); setmod(4, 50, 5, 4);     settrv(250, 2200, 0, 1, 0); setenv(20, 600, 80, 350);  setperf(0, 200, 20, 20);  ) :   // Hollow Pipe
  // the sequence presets: the sound, the sequencer settings and a pattern
  p == 13 ? ( setvco(1, 2, 0, 0, 0);     setmod(5, 50, 5, 0);     settrv(20, 260, 2, 2, 0);   setenv(1, 260, 0, 90);     setperf(0, 200, 0, 0);
              setseq(0, 1, 0, 55, 80, 70); ) :                                                                                                             // Acid Squelch
  p == 14 ? ( setvco(2, 1, 0, 12.05, 30);setmod(5, 50, 5, 0);     settrv(20, 650, 1, 1, 0);   setenv(1, 320, 20, 90);    setperf(0, 200, 0, 0);
              setseq(1, 1, 18, 40, 55, 60); ) :                                                                                                            // Octave Bass
  p == 15 ? ( setvco(4, 2, 0, 0.08, 30); setmod(0.35, 60, 5, 0);  settrv(40, 900, 1, 2, 0);   setenv(1, 220, 15, 140);   setperf(0, 200, 0, 0);
              setseq(2, 1, 0, 50, 40, 60); ) :                                                                                                             // Berlin Pulse
            ( setvco(1, 3, 0, 7.02, 28); setmod(5, 50, 5.5, 6);   settrv(40, 1300, 1, 1, 0);  setenv(4, 600, 60, 220);   setperf(0, 200, 0, 0);
              setseq(3, 1, 0, 85, 50, 130); );                                                                                                             // Rubber Lead
  pr_trim_t = patch_trim(p);                     // (applied at the silent point, with the new sound)
  slider_automate(2 ^ 24 - 1);                   // sliders 1-24
);

// ---------- notes ----------
// the envelope's timing (DRIFT): slow wander plus a fresh offset on every new note
function env_times() local(f) (
  f = 2 ^ ((sv_ew + (rand(2) - 1) * 0.6) * drift * 0.35);
  aenv.vo_adsr_set(slider15 * f, slider16 * f, slider17 / 100, slider18 * f);
);
function note_on(n, v) local(i, f, legato) (
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  tgt = n; vel = v / 127; gl_c = porta_c; acc_gt = 1;
  !legato ? ( nd_mul = ins_note_detune() * 2 ^ ((rand(2) - 1) * drift * 0.05 / 12); env_times(); );
  porta_ms <= 0 ? cur = n;                       // PORTA glides between every note when it is up
  ab_v = ab_d;                                    // AUTO BEND starts from its depth on every new note
  aenv.vo_adsr_gate(1, !legato);
  gate = 1;
  ins_midi_hit();
);
function note_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? ( tgt = HN[hcount - 1]; porta_ms <= 0 ? cur = tgt; ) : ( aenv.vo_adsr_gate(0, 0); gate = 0; );
  );
);
function all_off() ( hcount = 0; aenv.vo_adsr_gate(0, 0); gate = 0; sq_gate = 0; sq_off_t = -1; );

// ---------- the sequencer ----------
// a step from the sequencer: a new note (attack), or a slide from the step before (no new attack, the pitch glides)
function seq_note(n, acc, slide_in) (
  tgt = n; vel = acc ? 1 : 0.8;
  // accents jump out, plain steps sit back; a sequenced line sits about 5 dB under a played note (its steps are
  // mostly attack and decay, where a held note settles to its sustain)
  acc_gt = 0.55 * (acc ? 1 + 0.3 * acc_amt : 1 - 0.3 * acc_amt);
  acc ? acc_e = min(acc_e * 0.5 + 1, 1.6);       // accents close together stack up (the sweep's charge)
  slide_in ? ( gl_c = sl_c; ) : (
    gl_c = porta_c; porta_ms <= 0 ? cur = n;
    nd_mul = ins_note_detune() * 2 ^ ((rand(2) - 1) * drift * 0.05 / 12); env_times();
    ab_v = ab_d;
    aenv.vo_adsr_gate(1, 1);
  );
  gate = 1; sq_gate = 1;
);
function seq_off() ( sq_gate ? ( aenv.vo_adsr_gate(0, 0); gate = 0; sq_gate = 0; ); );
function sq_sw(n) ( (n & 1) ? sq_swk : 0; );
// fire step n (counted from the start of the run / the timeline)
function seq_fire(n) local(L, i, b, st, ln) (
  L = max(1, min(16, SQB[512 + sq_pat]));
  n % L == 0 && sq_pat != sq_preq ? ( sq_pat = sq_preq; L = max(1, min(16, SQB[512 + sq_pat])); );
  i = n % L; b = SQB + (sq_pat * 16 + i) * 4;
  seq_step_d = i; seq_pat_d = sq_pat;
  st = n + sq_sw(n); ln = (n + 1 + sq_sw(n + 1)) - st;
  b[1] ? (
    seq_note(48 + sq_tr + b[0], b[2], sq_slp && sq_gate);
    sq_off_t = b[3] ? st + ln * 1.02 : st + ln * sq_gl;      // a slide holds into the next step (a rest ends it)
    sq_slp = b[3];
  ) : ( sq_slp = 0; );
);

// ---------- parameters ----------
function update() (
  w1 = floor(slider1 + 0.5); oc1 = 2 ^ (floor(slider2 + 0.5) - 3);
  src2 = floor(slider3 + 0.5); tune2 = slider4; blend = slider5 / 100;
  mg_rate = slider6; pwm_d = slider7 / 100; vib_r = slider8; vib_d = slider9;
  hpf = slider10; lpf = slider11;
  rk = floor(slider12 + 0.5); rk = rk == 0 ? 1.7 : rk == 1 ? 0.85 : 0.22;
  eg_i = floor(slider13 + 0.5) * 2.6; mg_i = floor(slider14 + 0.5) * 1.1;
  ab_d = slider19; ab_c = 1 - exp(-1 / (max(slider20, 1) * 0.001 * srate / 4.6));
  porta_ms = slider21; porta_c = slider21 > 0 ? vo_coef(slider21) : 1;
  velsens = slider22 / 100;
  drift = slider23 / 100 * 1.6;                   // heavy: the universal drift pushed further
  vol_t = 10 ^ (slider24 / 20);
  pr_trim = pr_trim_t;
  ins_output_setup(26);   // output stage: CLIP, always on
  // the sequencer
  sq_spk = seq_rate < 0.5 ? 2 : seq_rate < 1.5 ? 4 : seq_rate < 2.5 ? 8 : seq_rate < 3.5 ? 3 : 6;   // steps per beat
  sq_swk = seq_swing / 100 * 0.5;
  sq_gl = seq_gate / 100;
  acc_amt = seq_acc / 100;
  sl_c = vo_coef(seq_slide);
  sq_preq = max(0, min(7, seq_pat | 0));
);
// a preset loaded while a note sounds: the old sound fades out (12 ms), the new patch applies at the silent point
// and the note fades back in with it (12 ms), so the change never clicks
sv_preq = 0; sv_pcf = 0; sv_pck = sv_pcg = 1;
update();
sq_pat = sq_preq;
gl_c = porta_c;
vol_s = vol_t;
env_times();
hcount = 0; aenv.vo_adsr_gate(0, 0); gate = 0;
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the
// preset bar asks through prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project
// or recalling its state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 16 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
!sv_preq && !sv_pcf ? update();

@block
prs_chk();
sv_pcr = 1 / (0.012 * srate);
fl_k = 1 - exp(-1 / (0.015 * srate));        // the filters' glide (15 ms stages)
sv_preq && !sv_pcf ? ( ae > 0.0001 ? sv_pcf = 1 : sv_preq = 0; );   // a note sounding: fade first
!sv_pcf ? update();
seq_trz_dirty ? ( seq_trz_dirty = 0; sq_tr = 0; );
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? (
    sq_run ? ( sq_tr = min(max(m2 - 48, -24), 24); ins_midi_hit(); ) : note_on(m2, m3);   // running: a key transposes
  ) :
  st == 0x80 || (st == 0x90 && m3 == 0) ? ( !sq_run ? note_off(m2); ) :
  st == 0xB0 && (m2 == 123 || m2 == 120) ? all_off() :
  st == 0xE0 ? bend = ins_bend(m2, m3, 2);
  midisend(mofs, m1, m2, m3);
);
seq_tr_d = sq_tr;
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? all_off();
gfx_pst_prev = gfx_pst;
// the sequencer: RUN (never on by itself), or FOLLOW = run with REAPER's transport
run_t = seq_follow >= 0.5 ? gfx_pst : seq_run_d;
run_t != sq_run ? (
  sq_run = run_t;
  sq_run ? (
    hcount = 0; sq_slp = 0; sq_off_t = -1; sq_pat = sq_preq;
    gfx_pst ? ( sq_pos = beat_position * sq_spk; sq_n = ceil(sq_pos - 0.0001); ) : ( sq_pos = -0.000001; sq_n = 0; );
    sq_on_t = sq_n + sq_sw(sq_n);
  ) : ( seq_off(); sq_off_t = -1; seq_step_d = -1; );
);
!sq_run ? ( sq_pat = sq_preq; seq_pat_d = sq_pat; );
sq_run ? (
  sq_spk != sq_spk0 && sq_spk0 > 0 ? (                       // RATE changed while running: same place, new grid
    sq_pos *= sq_spk / sq_spk0; sq_off_t >= 0 ? sq_off_t *= sq_spk / sq_spk0;
    sq_n = ceil(sq_pos - 0.0001); sq_on_t = sq_n + sq_sw(sq_n);
  );
  gfx_pst ? (                                                // REAPER plays: lock to the timeline
    p0 = beat_position * sq_spk;
    abs(p0 - sq_pos) > 0.5 ? (                               // a jump (seek, loop): carry on from there
      sq_n = ceil(p0 - 0.0001); sq_on_t = sq_n + sq_sw(sq_n);
      sq_off_t >= 0 ? sq_off_t = p0; sq_slp = 0;
    );
    sq_pos = p0;
  );
  sq_inc = sq_spk * max(tempo, 20) / 60 / srate;             // steps per sample
  sq_hum = 0.0006 * drift * srate * sq_inc;                  // DRIFT: the clock is a hair loose (in steps)
);
sq_spk0 = sq_spk;
ins_drift_block(drift, samplesblock);              // GFX instrument drift (heavy)
sv_ew = sv_dE.drift_tick(0.3 * samplesblock / srate);
acc_dk = exp(-1 / (0.2 * srate));                  // the accent sweep dies away over about 200 ms
acc_k = 1 - exp(-1 / (0.004 * srate));
sag_ka = 1 - exp(-1 / (0.15 * srate)); sag_kr = 1 - exp(-1 / (0.4 * srate));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, sv_pal);
file_var(0, pr_trim_t); pr_trim = pr_trim_t;
file_var(0, seq_ok);
file_mem(0, SQB, 520);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
sv_pcf ? ( sv_pck -= sv_pcr; sv_pck <= 0 ? ( sv_pck = 0; sv_pcf = 0; sv_preq = 0; update(); ); sv_pcg = 0.5 - 0.5 * cos($pi * sv_pck); ) :
sv_pck < 1 ? ( sv_pck = min(sv_pck + sv_pcr, 1); sv_pcg = 0.5 - 0.5 * cos($pi * sv_pck); );
// the sequencer clock (sample-accurate): a step starts, a gate ends
sq_run ? (
  sq_pos += sq_inc;
  sq_pos >= sq_on_t ? ( seq_fire(sq_n); sq_n += 1; sq_on_t = sq_n + sq_sw(sq_n) + (rand(2) - 1) * sq_hum; );
  sq_off_t >= 0 && sq_pos >= sq_off_t ? ( sq_off_t = -1; seq_off(); );
);
// pitch: portamento / slide, auto bend, vibrato, drift (and the supply sagging under a busy line)
cur += (tgt - cur) * gl_c;
ab_v -= ab_v * ab_c;
vb_ph += vib_r / srate; vb_ph -= floor(vb_ph);
semi = cur + ab_v + sin(2 * $pi * vb_ph) * vib_d / 100 - sag * drift * 0.05;
f1 = 440 * 2 ^ ((semi - 69) / 12) * bend * ins_pitch * nd_mul * oc1;
inc1 = min(f1 / srate, 0.45);
inc2 = min(inc1 * 2 ^ ((tune2 + ins_aux) / 12), 0.45);

// MG: the main LFO (triangle), for PWM and the filters
mg_ph += mg_rate / srate; mg_ph -= floor(mg_ph);
mg = mg_ph < 0.5 ? 4 * mg_ph - 1 : 3 - 4 * mg_ph;

// VCO 1
v1 = w1 == 0 ? t1.sv_tri(inc1) : w1 == 1 ? o1.vo_saw(inc1) : w1 == 2 ? o1.vo_pulse(inc1, 0.5) :
     w1 == 3 ? o1.vo_pulse(inc1, min(max(0.25 + ins_cut * 0.04, 0.08), 0.92)) :
               o1.vo_pulse(inc1, min(max(0.5 + mg * pwm_d * 0.44 + ins_cut * 0.04, 0.06), 0.94));

// VCO 2: saw, ring (VCO 1 x VCO 2), or noise
wn = rand(2) - 1;
src2 == 0 ? v2 = o2.vo_saw(inc2) :
src2 == 1 ? v2 = v1 * o2.vo_saw(inc2) :
src2 == 2 ? v2 = wn :
src2 == 3 ? ( pb0 = 0.99765 * pb0 + wn * 0.0990460; pb1 = 0.96300 * pb1 + wn * 0.2965164; pb2 = 0.57000 * pb2 + wn * 1.0526913;
              v2 = (pb0 + pb1 + pb2 + wn * 0.1848) * 0.22; ) :
            ( rn += (wn - rn) * 0.03; v2 = rn * 4; );
y = (v1 * (1 - blend) + v2 * blend) * 0.45;

// the FILTER: HPF then LPF, moved by the EG, the MG, the ACCENT sweep (and DRIFT)
// (HPF and LPF glide in two 15 ms stages, RESONANCE, EG and MG in one: a turned knob or a key never steps)
!fl_ok ? ( fl_h1 = fl_h2 = log(hpf); fl_l1 = fl_l2 = log(lpf); fl_rk = rk; fl_eg = eg_i; fl_mg = mg_i; fl_ok = 1; );
fl_h1 += (log(hpf) - fl_h1) * fl_k; fl_h2 += (fl_h1 - fl_h2) * fl_k; fl_l1 += (log(lpf) - fl_l1) * fl_k; fl_l2 += (fl_l1 - fl_l2) * fl_k;
fl_rk += (rk - fl_rk) * fl_k; fl_eg += (eg_i - fl_eg) * fl_k; fl_mg += (mg_i - fl_mg) * fl_k;
ae = aenv.vo_adsr();
acc_e *= acc_dk; acc_s += (acc_e - acc_s) * acc_k; acc_g += (acc_gt - acc_g) * acc_k;
oct = (fl_eg * ae + fl_mg * mg + ins_cut + acc_amt * acc_s * 1.3 - sag * drift * 0.1) * 0.693147;
fh.sv_svf(y, min(max(exp(fl_h2 + oct), 15), srate * 0.45), fl_rk); y = fh.hp;
fl.sv_svf(y, min(max(exp(fl_l2 + oct), 30), srate * 0.45), fl_rk); y = fl.lp;
y = vo_tanh(y * 0.8) / 0.8;

// VCA (the supply sags as the level it delivers rises)
y *= ae * (1 - velsens + velsens * vel) * acc_g;
sg_t = ae * acc_g; sag += (sg_t - sag) * (sg_t > sag ? sag_ka : sag_kr);

// DC block, volume, the GFX output stage
dy = y - dxp + 0.9995 * dyp; dxp = y; dyp = dy; y = dy;      // DC block low enough for 64' notes
vol_s += (vol_t - vol_s) * sm;
y *= pr_trim * vol_s * sv_pcg;
oL = ostL.ost_band(y); oR = ostR.ost_band(y);
ost_out(oL, oR);
spl0 = ost_l; spl1 = ost_r;
pk_disp = max(pk_disp, abs(spl0));

@gfx 960 856
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_begin(960, 856);

// faceplate colours: sv_pal 0 = olive (default), 1 = slate (the two swatches in the header)
ORG = 0xE08A1E; CAPO = 0xE08A1E; CAPC = 0xF6EFDF; CAPG = 0x9DA2A8;
sv_pal == 1 ? ( PNL = 0x3A4552; SH1 = 0x445160; SH2 = 0x3E4A58; SH3 = 0x35404C; INK = 0xEEF0F2; DIMI = 0xA9B4C0; CAPD = 0xEEF0F2; SQBG = 0x1F252D; BTX = 0xFFF6E8; ORG = 0xE0701E; CAPO = 0xE0701E; ) :
              ( PNL = 0x3F4227; SH1 = 0x4A4D2F; SH2 = 0x43462A; SH3 = 0x393C23; INK = 0xEFE9D4; DIMI = 0xBDB89A; CAPD = 0xEFE9D4; SQBG = 0x23251A; BTX = 0xFFF6E8; );
SLOT = ui_mix(PNL, 0x000000, 0.65);
dy_ink = INK; dy_bg = PNL; dy_nov = 1; rd_sqbg = SQBG;
dy_ntick = 5;                  // five marks round a plain dial (JG, 29 Oct 2026)
#sv_pm = "Seventy Lead|64' Bass|Filter Sweep|Ring Bells|PWM Strings|Auto Bend Brass|Whistle|Wind|Squelch|Theremin|Zap Drum|Hollow Pipe|Acid Squelch|Octave Bass|Berlin Pulse|Rubber Lead";
ui_fitfont(12, 12.5 * sc);     // sequencer labels
ui_fitfont(13, 14 * sc);       // lamp-key legends
gfx_setfont(14, "Courier New", 15 * sc, 'b');   // the NOTE display

function pr_go(n) ( prs_dirty = n; pr_cur = n; );
function setv(idx, v) ( slider(idx) = v; slider_automate(2 ^ (idx - 1)); );
// recessed front-panel section (the GFX instrument inset): sloped walls, corner creases, light from the top left
function inset(x, y, w, h, col) local(b, ox, oy, ow, oh) (
  x *= sc; y *= sc; w *= sc; h *= sc; b = 5 * sc;
  ox = x - b; oy = y - b; ow = w + 2 * b; oh = h + 2 * b;
  ui_col(ui_mix(col, 0x000000, 0.30)); gfx_triangle(ox, oy, ox + ow, oy, x + w, y, x, y);
  ui_col(ui_mix(col, 0x000000, 0.18)); gfx_triangle(ox, oy, x, y, x, y + h, ox, oy + oh);
  ui_col(ui_mix(col, 0xFFFFFF, 0.30)); gfx_triangle(ox, oy + oh, x, y + h, x + w, y + h, ox + ow, oy + oh);
  ui_col(ui_mix(col, 0xFFFFFF, 0.12)); gfx_triangle(ox + ow, oy, ox + ow, oy + oh, x + w, y + h, x + w, y);
  ui_col(col); gfx_rect(x, y, w, h);
  gfx_gradrect(x, y, w, 6 * sc, 0, 0, 0, 0.14, 0, 0, 0, 0, 0, 0, 0, -0.14 / (6 * sc));
  ui_cola(0x000000, 0.30); gfx_line(ox, oy, x, y, 1); gfx_line(ox + ow, oy, x + w, y, 1);
  ui_cola(0xFFFFFF, 0.35); gfx_line(ox, oy + oh, x, y + h, 1); gfx_line(ox + ow, oy + oh, x + w, y + h, 1);
);
// section title: an orange band across the top of the inset
function band(x, y, w, s) ( ui_col(ORG); gfx_rect(x * sc, y * sc, w * sc, 18 * sc); gfx_setfont(4); ui_col(BTX); gfx_x = (x + 8) * sc; gfx_y = (y + 3) * sc; gfx_drawstr(s); );
// a row of lit keys for a stepped slider
function keys(x, y, w, h, gap, idx, n, names) local(i) (
  i = 0;
  loop(n,
    strcpy_substr(#kn, names, i * 4, 4);
    while (strlen(#kn) > 0 && str_getchar(#kn, strlen(#kn) - 1) == ' ') ( strcpy_substr(#kn, #kn, 0, strlen(#kn) - 1); );
    rd_sq(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == i, ORG, #kn) ? setv(idx, i);
    i += 1;
  );
);
// the wave symbols on the WAVE keys: 0 triangle, 1 saw, 2 square, 3 narrow pulse, 4 PWM (pulse with a width arrow)
function wglyph(cx, cy, t, on) local(x0, x1, y0, y1, w, k) (
  ui_col(on ? 0x1A1210 : 0xE8DCC6); w = 30; x0 = cx - w / 2; x1 = cx + w / 2; y0 = cy - 7; y1 = cy + 7;
  k = 0; loop(2,
    t == 0 ? ( gfx_line(x0 * sc, (y1 + k) * sc, (cx - 7.5) * sc, (y0 + k) * sc, 1); gfx_line((cx - 7.5) * sc, (y0 + k) * sc, (cx + 7.5) * sc, (y1 + k) * sc, 1);
               gfx_line((cx + 7.5) * sc, (y1 + k) * sc, x1 * sc, (y0 + k) * sc, 1); ) :
    t == 1 ? ( gfx_line(x0 * sc, (y1 + k) * sc, cx * sc, (y0 + k) * sc, 1); gfx_line(cx * sc, (y0 + k) * sc, cx * sc, (y1 + k) * sc, 1);
               gfx_line(cx * sc, (y1 + k) * sc, x1 * sc, (y0 + k) * sc, 1); gfx_line(x1 * sc, (y0 + k) * sc, x1 * sc, (y1 + k) * sc, 1); ) :
    ( w = t == 2 ? 7.5 : 3.5;
      gfx_line(x0 * sc, (y1 + k) * sc, x0 * sc, (y0 + k) * sc, 1); gfx_line(x0 * sc, (y0 + k) * sc, (x0 + w) * sc, (y0 + k) * sc, 1);
      gfx_line((x0 + w) * sc, (y0 + k) * sc, (x0 + w) * sc, (y1 + k) * sc, 1); gfx_line((x0 + w) * sc, (y1 + k) * sc, (x0 + 15) * sc, (y1 + k) * sc, 1);
      gfx_line((x0 + 15) * sc, (y1 + k) * sc, (x0 + 15) * sc, (y0 + k) * sc, 1); gfx_line((x0 + 15) * sc, (y0 + k) * sc, (x0 + 15 + w) * sc, (y0 + k) * sc, 1);
      gfx_line((x0 + 15 + w) * sc, (y0 + k) * sc, (x0 + 15 + w) * sc, (y1 + k) * sc, 1); gfx_line((x0 + 15 + w) * sc, (y1 + k) * sc, x1 * sc, (y1 + k) * sc, 1); );
    k += 0.6;
  );
  t == 4 ? ( gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 9) * sc, (cy + 10) * sc, 1);
             gfx_line((x0 + 15 + 9) * sc, (cy + 10) * sc, (x0 + 15 + 6) * sc, (cy + 8) * sc, 1); gfx_line((x0 + 15 + 9) * sc, (cy + 10) * sc, (x0 + 15 + 6) * sc, (cy + 12) * sc, 1);
             gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 2) * sc, (cy + 8) * sc, 1); gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 2) * sc, (cy + 12) * sc, 1); );
);
// recolour a house filter knob's cap and pointer (same geometry as the house knob); n = position 0..1
function fcap(cx, cy, r, n, cap, ptr) local(rr, a1) (
  cx *= sc; cy *= sc; r *= sc; rr = r * 0.74; a1 = -0.75 * $pi + n * 1.5 * $pi;
  ui_col(ui_mix(cap, 0x000000, 0.35)); gfx_circle(cx, cy, rr + 1 * sc, 1, 1);
  ui_col(cap); gfx_circle(cx, cy, rr, 1, 1);
  ui_cola(0xFFFFFF, 0.18); gfx_circle(cx - rr * 0.3, cy - rr * 0.35, rr * 0.45, 1, 1);
  ui_col(cap); gfx_circle(cx + rr * 0.05, cy + rr * 0.1, rr * 0.62, 1, 1);
  ui_kline(cx, cy, a1, rr * 0.15, r * 0.98, 2.2, ptr);
);
// a cycle key: click steps forward, right-click back
function cyc(x, y, w, h, idx, n) local(hov, v) (
  v = floor(slider(idx) + 0.5);
  rd_sq(x, y, w, h, 1, ORG, "") ? setv(idx, (v + 1) % n);
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hov && (mouse_cap & 2) && !(sv_rcap & 2) ? setv(idx, (v + n - 1) % n);
);
// position dots under a cycle key
function dots(cx, y, n, cur) local(i, x0) (
  x0 = cx - (n - 1) * 5; i = 0;
  loop(n, i == cur ? ui_col(ORG) : ui_cola(INK, 0.35); gfx_circle((x0 + i * 10) * sc, y * sc, 2.6 * sc, 1, 1); i += 1; );
);

// ---------- sequencer panel parts ----------
// note name of MIDI note n (C3 = 48) into #nn
function nname(n) local(k, o) (
  n = max(0, min(127, n | 0)); k = n % 12; o = floor(n / 12) - 1;
  strcpy_substr(#nk, "C C#D D#E F F#G G#A A#B ", k * 2, 2);
  str_getchar(#nk, 1) == 32 ? strcpy_substr(#nk, #nk, 0, 1);
  sprintf(#nn, "%s%d", #nk, o);
  #nn;
);
// a mode display box: dark recessed window with light text, its label above (small caps); returns 1 when clicked
function dbox(x, y, w, h, lbl, s) local(hit, hov) (
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = pressed && hov && drag_id == 0; hit ? drag_id = -1;
  gfx_setfont(12); ui_col(DIMI); ui_text((x + w * 0.5) * sc, (y - 13) * sc, lbl);
  ui_cola(0x000000, 0.35); gfx_rect((x + 1) * sc, (y + 2) * sc, w * sc, h * sc);
  ui_col(0x0A0A08); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  ui_col(0x1E1D18); gfx_rect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc);
  ui_cola(0x000000, 0.5); gfx_rect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, 2 * sc); gfx_rect((x + 2) * sc, (y + 2) * sc, 2 * sc, (h - 4) * sc);
  hov ? ( ui_cola(0xFFFFFF, 0.06); gfx_rect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc); );
  gfx_setfont(13); ui_col(0xF2E6C8); ui_text((x + w * 0.5) * sc, (y + h * 0.5 - 7) * sc, s);
  hit;
);
// the NOTE knob of step i (a small cream desk knob, -12 .. +24 semitones from the key; the key's place marked)
function sq_knob(i, cx, cy, r) local(b, v, nrm, dx, dy, hov, did, a) (
  b = SQB + (seq_pat * 16 + i) * 4; v = b[0]; did = 3000 + i;
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - sq_lt < 0.35 && sq_lid == i ? ( b[0] = 0; drag_id = -1; sq_lt = 0; ) :
    ( drag_id = did; sq_y = mouse_y; sq_lt = time_precise(); sq_lid = i; sk_nv = (v + 12) / 36; );
  );
  drag_id == did ? (
    sk_nv = min(max(sk_nv + (sq_y - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); sq_y = mouse_y;
    b[0] = floor(sk_nv * 36 + 0.5) - 12;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( b[0] = min(max(v + sign(mouse_wheel), -12), 24); mouse_wheel = 0; );
  v = b[0]; nrm = (v + 12) / 36; a = -0.75 * $pi + nrm * 1.5 * $pi;
  ui_kdesk_d = 3;                                            // four dots: -12, the key, +12, +24
  ui_knob_desk(cx * sc, cy * sc, r * sc, a, hov || drag_id == did, CAPD, 0x1A1A18);
  ui_kdesk_d = 0;
);

// ---------- panel ----------
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(PNL); gfx_rect(0, 0, 960 * sc, 856 * sc);
gfx_gradrect(0, 0, 960 * sc, 270 * sc, 1, 1, 1, 0.10, 0, 0, 0, 0, 0, 0, 0, -0.10 / (270 * sc));
ui_col(ORG); gfx_rect(0, 64 * sc, 960 * sc, 4 * sc);
ui_cola(0x000000, 0.25); gfx_rect(0, 852 * sc, 960 * sc, 4 * sc);

// header: badge, name, presets [PRESETS][◄][►][LCD], MIDI, size
rd_badge(36, 32, 16, INK, PNL);
rd_title(62, 14, "SEVENTY", 28, INK);
rd_sub(66, 46, "MONOPHONIC SYNTHESIZER", DIMI, 1);
pk_k = pk_preset(376 * sc, 15 * sc, 394 * sc, 34 * sc, pr_cur, #sv_pm);
pk_k > 0 ? pr_go(pk_k);
rd_led(796, 33, 5, ins_midi_lit(), 0x3ADF6A); rd_lbl(796, 44, "MIDI", DIMI, 1);
ui_size_picker(830 * sc, 24 * sc);
// colour swatches: olive / slate
rd_sq(898, 22, 18, 18, sv_pal == 0, 0x6E7342, "") ? sv_pal = 0;
rd_sq(922, 22, 18, 18, sv_pal == 1, 0x6A7A8E, "") ? sv_pal = 1;
rd_lbl(919, 46, "COLOUR", DIMI, 1);

// ---------- row 1: VCO 1, VCO 2, MODULATION ----------
// one cycle key each for WAVE, OCTAVE and SOURCE: click for the next setting, right-click for the one before;
// the dots underneath show where you are
inset(16, 88, 226, 132, SH1); band(16, 88, 226, "VCO 1");
rd_lbl(68, 116, "WAVE", DIMI, 1);
w_ = floor(slider1 + 0.5);
cyc(28, 128, 80, 40, 1, 5) ? 0;
w_ == 4 ? ( gfx_setfont(5); ui_col(0x1A1210); ui_text(68 * sc, 141 * sc, "PW"); ) : wglyph(68, 148, w_, 1);
dots(68, 182, 5, w_);
rd_lbl(176, 116, "OCTAVE", DIMI, 1);
cyc(136, 128, 80, 40, 2, 6) ? 0;
o_ = floor(slider2 + 0.5);
gfx_setfont(6, "Trebuchet MS", 22 * sc, 'b'); ui_col(0x1A1210); ui_text(176 * sc, 136 * sc, o_ == 0 ? "64'" : o_ == 1 ? "32'" : o_ == 2 ? "16'" : o_ == 3 ? "8'" : o_ == 4 ? "4'" : "2'");
dots(176, 182, 6, o_);

inset(254, 88, 330, 132, SH2); band(254, 88, 330, "VCO 2");
rd_lbl(304, 116, "SOURCE", DIMI, 1);
cyc(264, 128, 80, 40, 3, 5) ? 0;
s_ = floor(slider3 + 0.5);
s_ == 0 ? wglyph(304, 148, 1, 1) : ( gfx_setfont(5); ui_col(0x1A1210); ui_text(304 * sc, 141 * sc, s_ == 1 ? "RING" : s_ == 2 ? "WHITE" : s_ == 3 ? "PINK" : "RED"); );
dots(304, 182, 5, s_);
