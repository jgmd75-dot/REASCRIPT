  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function js_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x7A8188); v5_d(x, y, 4); ui_col(0xA8AEB4); v5_d(x - 0.8, y - 0.8, 2.4); );
function js_emblem(ox, oy) local(m, wi, hi, cx, by, bl) (
  m = sc * 4; wi = ceil(40 * m); hi = ceil(38 * m); cx = 20; by = 11; bl = 13;
  gfx_setimgdim(121, 0, 0); gfx_setimgdim(121, wi, hi); gfx_dest = 121; gfx_a = 1; gfx_mode = 0;
  ui_col(JB); gfx_rect(0, 0, wi, hi);
  ui_col(0xC9CDD1);
  gfx_rect((cx - 0.9) * m, by * m, 1.8 * m, 21 * m);
  gfx_rect((cx - 6) * m, 32 * m, 12 * m, 1.8 * m); gfx_rect((cx - 3.6) * m, 34.6 * m, 7.2 * m, 1.4 * m);
  ui_col(JC); ui_ssline((cx - bl) * m, (by + 0.2) * m, (cx + bl) * m, (by - 0.2) * m, 1.6 * m, 1);
  ui_cola(JC, 0.8);
  ui_ssline((cx - bl) * m, by * m, (cx - bl - 4.2) * m, (by + 13) * m, 0.9 * m, 1); ui_ssline((cx - bl) * m, by * m, (cx - bl + 4.2) * m, (by + 13) * m, 0.9 * m, 1);
  ui_ssline((cx + bl) * m, by * m, (cx + bl - 4.2) * m, (by + 13) * m, 0.9 * m, 1); ui_ssline((cx + bl) * m, by * m, (cx + bl + 4.2) * m, (by + 13) * m, 0.9 * m, 1);
  ui_col(JGD);
