  on ? ( ui_cola(JG, 0.10); v5_rr(x + 2, y + 2, w - 4, h - 4, 2); );
  ui_col(on ? JG : 0x8E9196); js_icon(x + w * 0.5, y + h * 0.5, lfo ? 0.8 : 1, k, lfo);
);
function js_glass(x, y, w, h) (
  ui_col(0x050606); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x1A1C1D); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  js_grad(x, y, w, h * 0.4, 0x1E1C14, 0x14130E); js_grad(x, y + h * 0.4, w, h * 0.6, 0x14130E, 0x0E0D0A);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
