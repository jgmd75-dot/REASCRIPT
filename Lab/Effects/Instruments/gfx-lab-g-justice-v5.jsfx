  gfx_dest = 119; gfx_a = 1; gfx_mode = 0; gfx_x = floor(ox * sc + 0.5); gfx_y = floor(oy * sc + 0.5); gfx_blit(121, 0.25, 0);
);
function js_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.07); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.42)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.30)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.06)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.12)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
