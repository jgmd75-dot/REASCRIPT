  gfx_triangle((cx + bl - 6) * m, (by + 13) * m, (cx + bl + 6) * m, (by + 13) * m, (cx + bl + 3.6) * m, (by + 16) * m, (cx + bl - 3.6) * m, (by + 16) * m);
