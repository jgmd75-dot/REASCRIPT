pwr_in(oL, oR); oL = pwr_l; oR = pwr_r;
pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
oL *= outg_s*JV_OUT; oR *= outg_s*JV_OUT;
oL != oL ? oL = 0; oR != oR ? oR = 0;
oL = ostL.ost_band(oL); oR = ostR.ost_band(oR);
ost_out(oL, oR);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
mL += (spl0*spl0 - mL)*0.0005; mR += (spl1*spl1 - mR)*0.0005;
a_ = max(abs(spl0), abs(spl1)); a_ > js_pk2 ? js_pk2 = a_;

@gfx 900 400
ui_begin(900, 400);
v5_begin();
