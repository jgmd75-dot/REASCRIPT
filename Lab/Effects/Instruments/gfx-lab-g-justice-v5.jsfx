) : (
  yL = yR = 0;
);

pk = max(abs(yL), abs(yR));
ce = pk > ce ? ce + (pk - ce)*0.3 : ce*crel;
cg_t = ce > 0.35 ? (0.35*pow(ce/0.35, 1/cratio))/ce : 1;
cg += (cg_t - cg)*ms3;
yL *= cg; yR *= cg;

pending >= 0 ? (
  vf -= vfstep;
  vf <= 0 ? ( vf = 0; load_preset(pending); calc(); prs_h0 = prs_hash(); pending = -1; );
) : ( vf < 1 ? vf = min(1, vf + vfstep); );
yL *= vf; yR *= vf;

yL *= sqrt(1 - ftp); yR *= sqrt(1 + ftp);

rinL = yL*0.03; rinR = yR*0.03;
rv_q = abs(rinL) + abs(rinR) > 0.000000000001 || rmix_s > 0.0000001 && (abs(wL) + abs(wR) > 0.000000000001) ? 0 : rv_q + 1;
rv_sl ? (
  rv_q == 0 ? rv_sl = 0;
) : rv_q > rv_hold ? (
  rv_sl = 1; memset(RVB, 0, 12*RVS); cL1.st = cL2.st = cL3.st = cL4.st = cR1.st = cR2.st = cR3.st = cR4.st = 0;
);
rv_sl ? ( wL = wR = 0; ) : (
  wL = cL1.comb(rinL) + cL2.comb(rinL) + cL3.comb(rinL) + cL4.comb(rinL);
