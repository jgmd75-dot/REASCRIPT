function js_preset(x, y, w, cur) local(n, gx, sel, open, i) (
  n = pk_pcount(#js_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 36, 26) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
