     : ( ui_col(ui_mix(led, 0x0A0B0B, 0.75)); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); );
  gfx_setfont(v5_fk); ui_col(on ? 0xF6F8F4 : 0xA8ACA6); v5_t((gx + 11 + x + w - 4) * 0.5, y + h * 0.5 + 0.5, lg);
);
function js_icon(cx, cy, s, k, lfo) local(l, r, t, b, m, i, px, py, nx, ny, st, lw) (
  l = cx - 9 * s; r = cx + 9 * s; t = cy - 5.5 * s; b = cy + 5.5 * s; m = cx; lw = 1.7;
  !lfo && k == 0 ? ( v5_ln(l, b, r, t, lw); v5_ln(r, t, r, b, lw); ) :
  !lfo && k == 1 ? ( v5_ln(l, b, l, t, lw); v5_ln(l, t, m, t, lw); v5_ln(m, t, m, b, lw); v5_ln(m, b, r, b, lw); v5_ln(r, b, r, t, lw); ) :
  (!lfo && k == 2) || (lfo && k == 1) ? ( v5_ln(l, b, m, t, lw); v5_ln(m, t, r, b, lw); ) :
  (!lfo && k == 3) || (lfo && k == 0) ? (
    i = 0; px = l; py = cy;
    loop(16, i += 1; nx = l + (r - l) * i / 16; ny = cy - (b - t) * 0.5 * sin(2 * $pi * i / 16); v5_ln(px, py, nx, ny, lw); px = nx; py = ny; );
  ) : (
    st = (r - l) / 4;
    v5_ln(l, b, l, t, lw); v5_ln(l, t, l + st, t, lw); v5_ln(l + st, t, l + st, cy, lw); v5_ln(l + st, cy, l + 2 * st, cy, lw);
    v5_ln(l + 2 * st, cy, l + 2 * st, b, lw); v5_ln(l + 2 * st, b, l + 3 * st, b, lw); v5_ln(l + 3 * st, b, l + 3 * st, t + (b - t) * 0.25, lw); v5_ln(l + 3 * st, t + (b - t) * 0.25, r, t + (b - t) * 0.25, lw);
  );
);
function js_ikey(x, y, w, h, idx, k, lfo) local(on, hv) (
  hv = v5_hit(x, y, w, h);
  v5_pr && v5_drag == 0 && hv ? ( slider(idx) = k; ui_auto(idx); v5_drag = -1; );
  on = (slider(idx) | 0) == k;
