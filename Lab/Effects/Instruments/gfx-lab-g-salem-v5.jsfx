  ed_cell = 0;  store_arm = 0;
  gui_dirty = 1;
);

function prs_sl() (
update_params();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(75, i != 75 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );

  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;
#ui_man = "gfx-lab-g-salem-v5";
!ui_dflt ? ( ui_sz = 0; ); ui_dflt = 1;
function av_gap() (
  memset(FX_MEM, 0, BD_END - FX_MEM); memset(VOX, 0, NV * VS);
  dc_xl = dc_xr = dc_pl = dc_pr = dc_ol = dc_or = dc_qol = dc_qor = 0;
  dv_xl = dv_xr = dv_pl = dv_pr = dv_tl = dv_tr = dl_hl = dl_hr = dl_fl = dl_fr = 0;
  dvL.clp_pf_reset(); dvR.clp_pf_reset(); dvL.clp_reset(); dvR.clp_reset();
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.1; pwr_wu_loss = 0.3; pwr_wu_drv = 0.2; pwr_wu_lp = 12000; pwr_wu_wob = 0.04; pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();

@block
prs_chk();
av_now = time_precise();
av_tp > 0 && av_now - av_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > av_gpp && play_position - av_gpp < 4 * av_gpd + 0.05) ? av_gap();
av_tp = av_now; av_gpp = play_position; av_gpd = samplesblock / srate;
pwr_block(1);

mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256); (m_st & 0xF0) == 0x90 && m_d2 > 0 ? ins_midi_hit();
);
mq_i = 0;  spos = 0;

!sn_ok ? ( sn_fill();  sn_vary();  sn_ok = 1; );
!src_ok ? ( ctl_update();  src_ok = 1; );

src_bake(0);  src_bake(1);
fx_block();
prm_dirty ? ( prm_dirty = 0;  update_params(); );
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

xf_adv(SRC);  xf_adv(SRC + 32);

cr_n <= 0 ? (
  cr_n = CR;
  pwm_ph += pwm_hz * CR / srate;  pwm_ph -= floor(pwm_ph);
  ctl_update();

  fl_k = 1 - exp(-CR / (0.015 * srate));
  !fl_ok ? ( fl_c1 = fl_c2 = log(e_cutoff);  fl_rs = e_reso;  fl_ev = e_fenv;  fl_ok = 1; );
  fl_c1 += (log(e_cutoff) - fl_c1) * fl_k;  fl_c2 += (fl_c1 - fl_c2) * fl_k;  fl_rs += (e_reso - fl_rs) * fl_k;  fl_ev += (e_fenv - fl_ev) * fl_k;
  wob_lfo = sin(2 * $pi * pwm_ph);
  pmod = e_pwm * wob_lfo;
  vb = VOX;  loop(NV, vb[F_ON] ? v_tick(vb);  vb += VS; );
);
cr_n -= 1;

mixL = 0;  mixR = 0;  vb = VOX;
loop(NV, vb[F_ON] ? v_run(vb);  vb += VS; );

yl = mixL * out_g;  yr = mixR * out_g;

dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;

pwr_in(yl, yr); yl = pwr_l; yr = pwr_r;
dv_g += drv_on >= 0.5 ? (dv_g < 1 ? fx_st : 0) : (dv_g > 0 ? -fx_st : 0);  dv_g = max(0, min(1, dv_g));
dv_g > 0 ? (
  u_l = dvL.clp_run(dvL.clp_pf_run(yl * dv_gin));  u_r = dvR.clp_run(dvR.clp_pf_run(yr * dv_gin));
  dv_xl = u_l - dv_pl + 0.9995 * dv_xl;  dv_pl = u_l;  dv_xr = u_r - dv_pr + 0.9995 * dv_xr;  dv_pr = u_r;
  dv_tl += (dv_xl - dv_tl) * dv_tc;  dv_tr += (dv_xr - dv_tr) * dv_tc;
  u_m = dv_g * drv_mix;
  yl += (dv_tl * dv_gout - yl) * u_m;  yr += (dv_tr * dv_gout - yr) * u_m;
);

dl_g += dl_on >= 0.5 ? (dl_g < 1 ? fx_st : 0) : (dl_g > 0 ? -fx_st : 0);  dl_g = max(0, min(1, dl_g));
dl_live = dl_g > 0;
dl_live ? (
  cr_n == CR ? ( dl_wl = dwL.drift_tick(CR * 0.35 / srate);  dl_wr = dwR.drift_tick(CR * 0.31 / srate); );
  u_dl = dlL.sl_run(BD_L, dl_t * (1 + dl_wl * 0.005 * drift / 100));
  u_dr = dlR.sl_run(BD_R, dl_t * (1 + dl_wr * 0.005 * drift / 100));
  dl_hl += (u_dl - dl_hl) * dl_hc;  dl_hr += (u_dr - dl_hr) * dl_hc;
  dl_fl += (u_dl - dl_hl - dl_fl) * dl_dc;  dl_fr += (u_dr - dl_hr - dl_fr) * dl_dc;
  u_fl = ts(dl_fl * dl_fb * 1.25) * 0.8;  u_fr = ts(dl_fr * dl_fb * 1.25) * 0.8;
  u_m = dl_g * dl_send;
  dl_pp >= 0.5 ? bd_put((yl + yr) * 0.5 * u_m + u_fr + bv_dn, u_fl + bv_dn)
               : bd_put(yl * u_m + u_fl + bv_dn, yr * u_m + u_fr + bv_dn);
  u_m = dl_g * dl_mix;
  yl = yl * min(1, 2 - 2 * u_m) + u_dl * min(1, 2 * u_m);
  yr = yr * min(1, 2 - 2 * u_m) + u_dr * min(1, 2 * u_m);
);

sp_g += sp_on >= 0.5 ? (sp_g < 1 ? fx_st : 0) : (sp_g > 0 ? -fx_st : 0);  sp_g = max(0, min(1, sp_g));
sp_live = sp_g > 0;
sp_live ? (
  u_m = sp_freeze >= 0.5 ? 0 : 1;
  bv_pre(yl * u_m, yr * u_m);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, sp_size);
  fdn_run(dif_l, dif_r);
  u_m = sp_g * sp_mix;
  yl = yl * min(1, 2 - 2 * u_m) + fdn_l * 0.55 * min(1, 2 * u_m);
  yr = yr * min(1, 2 - 2 * u_m) + fdn_r * 0.55 * min(1, 2 * u_m);
);

pwr_out(yl, yr); yl = pwr_l; yr = pwr_r;
dc_ol = yl - dc_qol + dc_r * dc_ol;  dc_qol = yl;  yl = dc_ol;
dc_or = yr - dc_qor + dc_r * dc_or;  dc_qor = yr;  yr = dc_or;

ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
av_pk = max(abs(spl0), abs(spl1)); av_pk > av_pk_d ? av_pk_d = av_pk;

