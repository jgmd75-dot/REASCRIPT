file_var(0, pr_cur);
file_var(0, sn_ok);
file_mem(0, SN, 128);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();
file_avail(0) != 0 ? file_var(0, ui_sz);

@gfx 900 400
