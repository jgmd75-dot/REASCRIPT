    ) :
    sn_d1 == 120 || sn_d1 == 123 ? sn_alloff();
  );
  sn_mqi += 1;
);
sn_si += 1;
sn_ec += 1;
sn_ec >= 16 ? (
  sn_ec = 0;
  abs(sn_vlp - sn_vlpt) > 1 ? ( sn_vlp *= (sn_vlpt / sn_vlp) ^ sn_eg; abs(sn_vlp - sn_vlpt) < 2 ? sn_vlp = sn_vlpt; v3l.bq_set(4, sn_vlp, 0.7, 0); v3r.bq_set(4, sn_vlp, 0.7, 0); );
  sn_bas != sn_bat || sn_mid != sn_mit || sn_tre != sn_trt3 ? (
    sn_bas += (sn_bat - sn_bas) * sn_eg; sn_mid += (sn_mit - sn_mid) * sn_eg; sn_tre += (sn_trt3 - sn_tre) * sn_eg;
    abs(sn_bas - sn_bat) < 0.01 ? sn_bas = sn_bat; abs(sn_mid - sn_mit) < 0.01 ? sn_mid = sn_mit; abs(sn_tre - sn_trt3) < 0.01 ? sn_tre = sn_trt3;
    sn_toneeq();
  );
);

sn_pk += (sn_pkt - sn_pk) * sn_tg; sn_res += (sn_rest - sn_res) * sn_tg; sn_dv += (sn_drv - sn_dv) * sn_tg;
sn_trd += ((sn_trt ? sn_trdt : 0) - sn_trd) * sn_tg;

sn_yl = sn_yr = 0;
sn_bus > 0 ? (
  sn_gl = sn_gr = 0;
  sn_i = 0; sn_p = VB;
  loop(NV, sn_p[0] ? ( sn_voice(sn_p); sn_gl += sn_vl; sn_gr += sn_vr; ); sn_p += VS; );

  sn_tx = sn_tu1; sn_tu1 = sn_tc1 * sn_tx - sn_ts1 * sn_tv1 + sn_tki; sn_tv1 = sn_ts1 * sn_tx + sn_tc1 * sn_tv1;
  sn_tx = sn_tu2; sn_tu2 = sn_tc2 * sn_tx - sn_ts2 * sn_tv2 + sn_tki * 0.6; sn_tv2 = sn_ts2 * sn_tx + sn_tc2 * sn_tv2;
  sn_tki = 0;
  sn_tne > 0.0000001 ? ( sn_tlp += sn_tlc * ((rand(2) - 1) * sn_tne - sn_tlp); sn_tlq += sn_tlc * (sn_tlp - sn_tlq); sn_tne *= sn_tnd; ) : sn_tlp = sn_tlq = 0;
  sn_tk = sn_tv1 + sn_tv2 + sn_tlq;
  sn_gl += sn_tk; sn_gr += sn_tk;
  sn_fin = (sn_gl + sn_gr) * 0.5;
  sn_fl = sn_fr = 0; sn_q = FRM;
  loop(FRN,
    sn_u = sn_q[5]; sn_v = sn_q[6];
    sn_q[5] = sn_q[0] * sn_u - sn_q[1] * sn_v + sn_fin * sn_q[2];
    sn_q[6] = sn_q[1] * sn_u + sn_q[0] * sn_v;
    sn_fl += sn_q[6] * sn_q[3]; sn_fr += sn_q[6] * sn_q[4];
    sn_q += 8;
  );
  sn_gl += sn_fl * 0.5 * sn_res; sn_gr += sn_fr * 0.5 * sn_res;

  sn_xl = pzl.bq(sn_gl); sn_xr = pzr.bq(sn_gr);
  sn_tl = sn_xl - sn_pdl; sn_pdl = sn_xl; sn_tr2 = sn_xr - sn_pdr; sn_pdr = sn_xr;
  sn_pw = sn_pk * 1.4 - 0.3;
  sn_xl += sn_pw * sn_tl * 1.6; sn_xr += sn_pw * sn_tr2 * 1.6;
  sn_dcyl = sn_xl - sn_dcxl + sn_dcc * sn_dcyl; sn_dcxl = sn_xl; sn_xl = sn_dcyl;
  sn_dcyr = sn_xr - sn_dcxr + sn_dcc * sn_dcyr; sn_dcxr = sn_xr; sn_xr = sn_dcyr;
  mb_lol += mb_c1 * (sn_xl - mb_lol); mb_lor += mb_c1 * (sn_xr - mb_lor);
  mb_xl = sn_xl - mb_lol; mb_xr = sn_xr - mb_lor;
  mb_mdl += mb_c2 * (mb_xl - mb_mdl); mb_mdr += mb_c2 * (mb_xr - mb_mdr);
  mb_a = max(abs(mb_lol), abs(mb_lor)); mb_e1 += (mb_a - mb_e1) * (mb_a > mb_e1 ? mb_ca : mb_cr);
  mb_a = max(abs(mb_mdl), abs(mb_mdr)); mb_e2 += (mb_a - mb_e2) * (mb_a > mb_e2 ? mb_ca : mb_cr);
  mb_a = max(abs(mb_xl - mb_mdl), abs(mb_xr - mb_mdr)); mb_e3 += (mb_a - mb_e3) * (mb_a > mb_e3 ? mb_ca : mb_cr);
  mb_g1 = mb_e1 > MB_T1 ? (MB_T1 / mb_e1) ^ MB_K1 : 1;
  mb_g2 = mb_e2 > MB_T2 ? (MB_T2 / mb_e2) ^ MB_K2 : 1;
  mb_g3 = mb_e3 > MB_T3 ? (MB_T3 / mb_e3) ^ MB_K3 : 1;
  sn_xl = mb_lol * mb_g1 + mb_mdl * mb_g2 + (mb_xl - mb_mdl) * mb_g3;
  sn_xr = mb_lor * mb_g1 + mb_mdr * mb_g2 + (mb_xr - mb_mdr) * mb_g3;
  sn_yl = v4l.bq(v3l.bq(v2l.bq(v1l.bq(sn_xl)))); sn_yr = v4r.bq(v3r.bq(v2r.bq(v1r.bq(sn_xr))));
);

pwr_in(sn_yl, sn_yr); sn_yl = pwr_l; sn_yr = pwr_r;

cp_t = -6 - 18 * sn_dv; cp_r = 1 - 1 / (1.5 + 4.5 * sn_dv);
sn_a = max(abs(sn_yl), abs(sn_yr));
cp_e += (sn_a - cp_e) * (sn_a > cp_e ? cp_ca : cp_cr);
cp_x = cp_e > 0.00001 ? 20 * log10(cp_e) - cp_t : -100;
cp_gd = cp_x <= -3 ? 0 : cp_x < 3 ? -cp_r * sqr(cp_x + 3) / 12 : -cp_r * cp_x;
cp_g = 10 ^ ((cp_gd + CP_MK * sn_dv) / 20);
sn_yl *= cp_g; sn_yr *= cp_g;

sn_ezl = sn_yl - sn_exl + sn_dcc * sn_ezl; sn_exl = sn_yl; sn_yl = sn_ezl;
sn_ezr = sn_yr - sn_exr + sn_dcc * sn_ezr; sn_exr = sn_yr; sn_yr = sn_ezr;
sn_yl = e3l.bq(e2l.bq(e1l.bq(sn_yl))); sn_yr = e3r.bq(e2r.bq(e1r.bq(sn_yr)));
thk_proc(sn_yl, sn_yr, slider30 >= 0.5); sn_yl = thk_l; sn_yr = thk_r;
sn_a = max(abs(sn_yl), abs(sn_yr));
sn_lve += (sn_a - sn_lve) * (sn_a > sn_lve ? sn_lva : sn_lvr);
sn_lvg = sn_lve > SN_LT ? (SN_LT / sn_lve) ^ 0.75 : 1;
sn_yl *= sn_lvg; sn_yr *= sn_lvg;

sn_chm += (sn_cht - sn_chm) * sn_tg; sn_chd += (sn_chdt - sn_chd) * sn_tg;
CHB[sn_cw] = (sn_yl + sn_yr) * 0.5;
sn_cph += sn_chr / srate; sn_cph >= 1 ? sn_cph -= 1;
sn_chm > 0.0001 ? (
  sn_cda = (5.5 + 3.5 * sn_chd * (1 + sin(2 * $pi * sn_cph))) * 0.001 * srate;
  sn_cdb = (5.5 + 3.5 * sn_chd * (1 + sin(2 * $pi * sn_cph + $pi))) * 0.001 * srate;
  sn_ri = sn_cw - sn_cda; sn_ri < 0 ? sn_ri += 8192; sn_i0 = floor(sn_ri); sn_fr = sn_ri - sn_i0;
  sn_ca = CHB[sn_i0 & 8191] * (1 - sn_fr) + CHB[(sn_i0 + 1) & 8191] * sn_fr;
  sn_ri = sn_cw - sn_cdb; sn_ri < 0 ? sn_ri += 8192; sn_i0 = floor(sn_ri); sn_fr = sn_ri - sn_i0;
  sn_cb = CHB[sn_i0 & 8191] * (1 - sn_fr) + CHB[(sn_i0 + 1) & 8191] * sn_fr;
  sn_cfl += sn_clc * (sn_ca - sn_cfl); sn_cfr += sn_clc * (sn_cb - sn_cfr);
  sn_yl += sn_chm * (sn_cfl * 0.8 - sn_yl * 0.2); sn_yr += sn_chm * (sn_cfr * 0.8 - sn_yr * 0.2);
);
sn_cw = (sn_cw + 1) & 8191;

sn_tph += sn_trr / srate; sn_tph >= 1 ? sn_tph -= 1;
sn_trd > 0.0001 ? (
  sn_s = sin(2 * $pi * sn_tph);
  sn_yl *= 1 - sn_trd * (0.5 + 0.5 * sn_s); sn_yr *= 1 - sn_trd * (0.5 - 0.5 * sn_s);
);

pwr_out(sn_yl, sn_yr); sn_yl = pwr_l; sn_yr = pwr_r;
sn_vg += (sn_vgt - sn_vg) * sn_ks;
sn_yl *= sn_vg; sn_yr *= sn_vg;
