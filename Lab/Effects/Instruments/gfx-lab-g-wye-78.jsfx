function sn_srinit() (
  sn_sr = srate;
  sn_phc = 1 - exp(-2 * $pi * 160 / srate); sn_plc = 1 - exp(-2 * $pi * 3500 / srate); sn_eg = 1 - exp(-16 / (0.04 * srate)); sn_lva = 1 - exp(-1 / (0.001 * srate)); sn_lvr = 1 - exp(-1 / (0.25 * srate)); sn_gk = sn_cf(6); sn_kst = 1 / (0.003 * srate); sn_ks = sn_cf(30); sn_tg = sn_cf(20);
  sn_dcc = exp(-2 * $pi * 5 / srate); mb_c1 = 1 - exp(-2 * $pi * 220 / srate); mb_c2 = 1 - exp(-2 * $pi * 2200 / srate); mb_ca = 1 - exp(-1 / (0.006 * srate)); cp_ca = 1 - exp(-1 / (0.01 * srate)); cp_cr = 1 - exp(-1 / (0.15 * srate)); mb_cr = 1 - exp(-1 / (0.16 * srate)); sn_clc = 1 - exp(-2 * $pi * 7000 / srate);
  sn_r = exp(-6.9078 / (0.07 * srate)); sn_w = 2 * $pi * 105 / srate; sn_tc1 = sn_r * cos(sn_w); sn_ts1 = sn_r * sin(sn_w);
  sn_r = exp(-6.9078 / (0.04 * srate)); sn_w = 2 * $pi * 190 / srate; sn_tc2 = sn_r * cos(sn_w); sn_ts2 = sn_r * sin(sn_w);
  sn_tnd = exp(-1 / (0.004 * srate)); sn_tlc = 1 - exp(-2 * $pi * 700 / srate);
