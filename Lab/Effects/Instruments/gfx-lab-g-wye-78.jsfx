function sn_pstr(p) (
  p == 2 ? "2:54 3:40 4:62 5:38 7:19 8:70 9:6.3 10:-3.8 11:12 13:3.9 14:78 15:50 16:82 17:0.6 20:30 21:74 23:-9 24:12 26:0.12 27:62" :
  p == 3 ? "2:20 6:55 8:50 12:0 15:10 25:0 30:1 17:-1" :
  p == 4 ? "2:68 4:80 6:90 9:1 10:2 11:6 12:0 15:45 20:40 25:0 17:-3" :
  p == 5 ? "6:50 8:70 12:0 16:100 26:0.4 27:60 21:40 2:21" :
  p == 6 ? "2:14 6:30 9:2 10:-2 11:-4 27:15 12:0 30:1 21:50" :
  p == 7 ? "12:1 13:4.5 14:60 25:0 6:65 2:32" :
  p == 8 ? "12:1 13:6 14:40 16:100 26:0.8 27:40 6:70" :
  p == 9 ? "1:0 2:61 21:100 6:70 15:35 8:30 9:-2 10:3 12:0 25:0" :
  p == 10 ? "5:100 20:30 12:0 25:0 23:-26 24:14 4:80" :
  p == 11 ? "6:40 30:1 9:4 11:-3 25:0 12:0 16:20 8:55 2:35" :
  p == 12 ? "6:20 7:90 4:60 8:80 11:-6 9:2 12:0 27:15 21:55 2:25" :
  p == 13 ? "1:1 2:52 3:52 4:80 5:100 6:83 7:67 8:85 9:2.6 10:-3.4 11:4.1 12:0 15:14 20:43 21:56 23:-27 24:35 25:1 26:0.72 27:14 30:1" :
  p == 14 ? "1:1 2:55 3:29 4:69 5:77 6:68 7:71 8:42 9:3.8 10:4.1 11:4.8 12:1 13:0.4 14:75 15:0 16:60 20:20 21:9 23:-7.5 24:14 25:1 26:0.09 27:53 30:0" :
  p == 15 ? "1:0 2:70 3:75 4:0 5:96 6:71 7:79 8:95 9:3.8 10:4.3 11:4.8 12:1 13:0.015 14:67 15:2 16:72 20:0 21:0 23:-30 24:38.4 25:1 26:0.036 27:74 30:0" :
  "";
);
function load_preset(p) local(n, i) (
  i = 1; loop(30, i != 28 && i != 29 ? slider(i) = SN_DFT[i - 1]; i += 1; );
  n = sn_nums(sn_pstr(p), SN_TMP);
  i = 0; loop(floor(n / 2), SN_TMP[i * 2] >= 1 && SN_TMP[i * 2] <= 30 && SN_TMP[i * 2] != 28 && SN_TMP[i * 2] != 29 ? slider(SN_TMP[i * 2]) = SN_TMP[i * 2 + 1]; i += 1; );
  i = 1; loop(30, i != 28 && i != 29 ? slider_automate(2 ^ (i - 1)); i += 1; );
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(30, i != 29 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
