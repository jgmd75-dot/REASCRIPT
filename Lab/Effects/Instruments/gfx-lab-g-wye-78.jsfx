desc:Wye 78 [electric grand] (GFX Lab)
//tags: instrument electric grand piano stage piano strings piezo pickup tremolo physical-modelling
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-thick, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider29:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:1<0,1,1{73 keys,88 keys}>-Size
slider2:25<0,100,1>-Hammer (%)
slider3:50<0,100,1>-Strike point (%)
slider4:95<0,100,1>-Bark (%)
slider5:70<0,100,1>-String detune (%)
slider6:75<0,100,1>-Brightness (%)
slider7:80<0,100,1>-Body (%)
slider8:35<0,100,1>-Decay (%)
slider9:3<-12,12,0.1>-Bass (dB)
slider10:-4<-12,12,0.1>-Middle (dB)
slider11:3<-12,12,0.1>-Treble (dB)
slider12:1<0,1,1{Off,On}>-Tremolo
slider13:1.2<0.01,12,0.01>-Tremolo rate (Hz)
slider14:70<0,100,1>-Tremolo depth (%)
slider15:20<0,100,1>-Compression (%)
slider16:85<0,100,1>-Width (%)
slider17:0<-24,6,0.1>-Volume (dB)
slider18:1<0,1,1{Low,Normal}>-Drift
slider19:1<0,2,1{Light,Normal,Heavy}>-Touch
slider20:0<0,100,1>-String tightness (%)
slider21:70<0,100,1>-Hammer thump (%)
slider22:75<0,100,1>-(unused, was Attack softness)
slider23:-20<-30,0,0.1>-Low tuning (cents)
slider24:5<0,40,0.1>-High tuning (cents)
slider25:1<0,1,1{Off,On}>-Chorus
slider26:0.5<0.01,8,0.01>-Chorus rate (Hz)
slider27:20<0,100,1>-Chorus depth (%)
slider28:0<0,2,1{1x,2x,4x}>-(unused, was Oversampling)
slider30:0<0,1,1{Off,On}>-Thick
slider31:prs_sel=0<0,15,1{No preset,Init,Stage Drive,Ballad,Bright Rock,Chorus Pad,Mellow,Tremolo Keys,Pan Shimmer,Punchy 73,Honky Detune,Bass Keys,Dark Grand,Stretched Grand,Warm Tremolo,Wide 73}>-Preset

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(805306367, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(805306367, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-wye-78";
ext_noinit = 1;

NV = 16; VS = 384; VB = 100000; SBUF = 1048576; CHB = 700000;
MQ = 40000; FRM = 60000; FRN = 8;

function sn_db(x) ( exp(x * 0.11512925464970228); );
function sn_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function sn_cf(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );

function sn_lg(n, a, b, c, d, e, f, g) local(i, t, y0, y1) (
  n = min(max(n, 21), 97);
  i = n < 33 ? 0 : n < 45 ? 1 : n < 57 ? 2 : n < 69 ? 3 : n < 81 ? 4 : 5;
  y0 = i == 0 ? a : i == 1 ? b : i == 2 ? c : i == 3 ? d : i == 4 ? e : f;
  y1 = i == 0 ? b : i == 1 ? c : i == 2 ? d : i == 3 ? e : i == 4 ? f : g;
  t = i < 5 ? (n - 21 - 12 * i) / 12 : (n - 81) / 16;
  exp(log(y0) + (log(y1) - log(y0)) * t);
);

function sn_apd(a, w) local(p) (
  p = atan2(-sin(w), a + cos(w)) - atan2(-a * sin(w), 1 + a * cos(w));
  p > 0 ? p -= 2 * $pi;
  -p / w;
);
function sn_lpd(b, w) ( atan2(b * sin(w), 1 - b * cos(w)) / w; );
function sn_tap(d, w) ( sin((1 - d) * w * 0.5) / sin((1 + d) * w * 0.5); );
function sn_bsr(b) local(be) (
  be = b / sqr(1 - b) * sqr(srate / 48000);
  ((2 * be + 1) - sqrt(4 * be + 1)) / (2 * be);
);

function sn_str(q, f, t60, b, nd, ad, td) local(per, w, dtot, nint, d) (
  per = srate / f; w = 2 * $pi * f / srate;
  dtot = per - nd * sn_apd(ad, w) - sn_lpd(b, w);
  nint = max(floor(dtot - 0.5), 2);
  d = max(dtot - nint, 0.1);
  q[2] = nint; q[3] = sn_tap(d, w); q[8] = b; q[10] = ad; q[11] = nd;
  q[20] = exp(-6.9078 / (max(t60, 0.01) * f)); q[21] = exp(-6.9078 / (max(td, 0.005) * f));
  q[6] = q[7] = q[20];
);

function sn_q(p, s) ( s < p[21] ? p + 30 + s * 44 : p + 200 + (s - p[21]) * 44; );

function sn_sstep(q, ex) local(b, w, x, y, a, ad, k, z, g, i0, fr, o) (
  b = q[0]; w = q[1];
  q[43] ? ( x = q[40]; q[40] = x * q[42] - q[41] * q[43]; q[41] = x * q[43] + q[41] * q[42]; );
  o = sn_gc + q[40];
  abs(o) > 0.001 ? (
    g = q[23] * o * 0.000578; i0 = floor(g); fr = g - i0;
    x = b[(w - q[2] + i0 + 8192) & 8191] * (1 - fr) + b[(w - q[2] + i0 + 8193) & 8191] * fr;
  ) : x = b[(w - q[2] + 8192) & 8191];
  a = q[3]; y = a * x + q[4] - a * q[5]; q[4] = x; q[5] = y;
  ad = q[10]; z = q + 24;
  loop(q[11],
    x = y; y = ad * x + z[0] - ad * z[1]; z[0] = x; z[1] = y; z += 2;
  );
  q[6] += (q[7] - q[6]) * sn_gk;
  q[9] += (1 - q[8]) * (y - q[9]);
  y = q[9] * q[6];
  b[w] = y + ex;
  q[1] = (w + 1) & 8191;
  y;
);

function sn_vc(vel) local(v) (
  v = min(max(vel / 127, 0.01), 1);
  sn_touch == 0 ? v ^ 0.6 : sn_touch == 2 ? v ^ 1.6 : v;
);

function sn_lw(n) ( 0.3 + 0.7 * exp(-sqr((n - 64) / 20)); );

function sn_setup(p, n, vel) local(f, tr, tc, t60, td, b, ad, nd, dc, q, s, ns, w, r, kb, sz, k, dp) (
  p[1] = n;
  tr = min(max((n - 21) / 87, 0), 1);
  sz = sn_size;
  tc = (rand(2) - 1) * 0.5 * sn_dr + sn_wand * sn_dr;
  tc += n < 69 ? sn_tlo * sqr((69 - n) / 48) : sn_thi * sqr((n - 69) / 39);
  f = max(440 * 2 ^ ((n - 69 + tc / 100) / 12), 24);
  p[20] = f;
  ns = n < 36 ? 1 : n < 72 ? 2 : 3;
  p[21] = ns;
  dc = (0.15 + 4.85 * sn_det * sn_det) / 1200;
  kb = n < 57 ? 1 + sz * (57 - n) / 36 : 1;
  t60 = sn_dec * (1 + 0.35 * sn_loose * sn_lw(n)) * sn_lg(n, 9, 7.5, 6, 4.6, 3.1, 1.8, 0.9) * (sz ? (n < 57 ? 1 + 0.35 * (57 - n) / 36 : 1) : 1) * (1 - 0.22 * min(max((55 - n) / 31, 0), 1));
  b = sn_lg(n, 0.85, 0.55, 0.3, 0.16, 0.085, 0.04, 0.014) * sn_lb;
  b = sn_bsr(min(b, 0.88));
  ad = -1 + min((sz ? sn_lg(n, 0.05, 0.105, 0.22, 0.39, 0.59, 0.7, 0.46) : sn_lg(n, 0.045, 0.09, 0.2, 0.39, 0.59, 0.7, 0.46)) * 48000 / srate, 0.98);
  nd = n <= 100 ? 8 : 0;
  td = n >= 90 ? t60 : 0.11 * (1 + (1 - tr) * 1.4);
  s = 0;
  loop(ns * 2,
    q = sn_q(p, s); k = s % ns;
    q[0] = SBUF + ((p - VB) / VS * 6 + s) * 8192; memset(q[0], 0, 8192); q[1] = 0; q[4] = q[5] = q[9] = 0; memset(q + 24, 0, 16);
    w = k == 0 ? 0 : k == 1 ? 1 : -0.7;
    q[23] = srate / (f * 2 ^ (w * dc));
    sn_str(q, f * 2 ^ (w * dc + (rand(2) - 1) * 0.00012 * sn_dr), t60 * (k == 0 ? 1 : k == 1 ? 1.6 : 1.3) * (s >= ns ? 0.92 : 1), s >= ns ? min(b + 0.3 * (1 - b), 0.9) : b * (k == 0 ? 1 : 0.92), s >= ns ? 0 : nd, ad, td);
    q[22] = (k == 0 ? 1 : k == 1 ? 0.8 : 0.62) * (s >= ns ? 0.85 : 1);
    s >= ns ? (
      r = rand(1) * 2 * $pi; dp = sn_pdep * (0.8 + rand(1) * 0.4) * (rand(2) < 1 ? -1 : 1);
      q[40] = dp * cos(r); q[41] = dp * sin(r);
      r = 2 * $pi * (0.02 + rand(1) * 0.05) / srate; q[42] = cos(r); q[43] = sin(r);
    ) : ( q[40] = q[41] = q[43] = 0; q[42] = 1; );
    s += 1;
  );
  p[22] = (ns == 1 ? 1 : ns == 2 ? 0.62 : 0.5) * 0.72;
  p[23] = kb;
  n < 64 ? (
    p[170] = sn_bark * sn_bkg * (64 - n) / 43 * (n < 48 ? (0.05 + 0.95 * sqr((n - 21) / 27)) * (1 - 0.6 * sn_hard * (48 - n) / 27) : 1);
    b = sz ? sn_lg(n, 0.0005, 0.0004, 0.0003, 0.0003, 0.0004, 0.0012, 0.005) : sn_lg(n, 0.0008, 0.0006, 0.0004, 0.0003, 0.0004, 0.0012, 0.005);
    nd = max(2, floor(sn_lg(n, 19, 15, 11.5, 9, 7, 6, 5) + 0.5));
    w = 2 * $pi * min(f * nd * sqrt(1 + b * nd * nd), 0.4 * srate) / srate;
    r = exp(-6.9078 / ((n < 48 ? 0.035 + 0.185 * (n - 21) / 27 : 0.22) * srate));
    p[172] = r * cos(w); p[173] = r * sin(w); p[181] = 1 - r;
    nd = floor(nd * 2.07 + 0.5); w = 2 * $pi * min(f * nd * sqrt(1 + b * nd * nd), 0.4 * srate) / srate; r = exp(-6.9078 / ((n < 48 ? 0.025 + 0.095 * (n - 21) / 27 : 0.12) * srate));
    p[176] = r * cos(w); p[177] = r * sin(w); p[182] = 1 - r;
    p[180] = 1 - exp(-2 * $pi * 45 / srate);
    p[183] = sn_bke * (n < 48 ? max(0.1, (n - 21) / 27) ^ 1.5 : 1) * (n < 48 ? 1 - 0.7 * sn_hard * (48 - n) / 27 : 1);
    p[171] = p[174] = p[175] = p[178] = p[179] = 0;
  ) : p[170] = 0;
  w = min(max((n - 64) / 28, -1), 1) * sn_wid;
  p[10] = sqrt(0.5 * (1 - w)); p[11] = sqrt(0.5 * (1 + w));
  p[7] = 1; p[8] = 0; p[13] = 0; p[14] = 0; p[190] = p[191] = 0;
);

function sn_excite(p, n, vel) local(v, amp, per, th, hf) (
  v = sn_vc(vel); p[6] = v;
  amp = sn_db(-30 * (1 - v ^ 0.75));
  per = srate / p[20];
  hf = 2 ^ ((0.5 - sn_hard) * 1.1) * (1 + (rand(2) - 1) * 0.05 * sn_dr);
  th = 0.0019 * (1 + 0.35 * max(sn_loose, 0.5) * sn_lw(n)) * (1 + 0.5 * sn_soft) * 2 ^ (-(n - 21) / 30) * (1.45 - 0.75 * v) * hf * srate;
  th = min(max(th, 1.5), per * 0.9);
  p[15] = th; p[16] = 2 * $pi / th;
  p[17] = 0.5 * amp * sn_gk0 * sn_lg(n, 0.8, 0.9, 1, 1.05, 1.2, 1.4, 1.8) * p[23];
  p[25] = per * (0.06 + 0.12 * sn_stk); p[26] = 0.35 + 0.4 * sn_stk;
  p[27] = 1 - exp(-2 * $pi * min(0.4 * srate, (1 - 0.3 * max(sn_loose, 0.5) * sn_lw(n)) * (1 - 0.35 * sn_soft) * (3000 + 12000 * v ^ 2) * 2 ^ ((n - 60) / 20) * 2 ^ ((sn_hard - 0.5) * 1.6)) / srate);
  p[19] = 1 - exp(-1 / (max((0.004 + 0.012 * sn_soft) * 2 ^ (-(n - 48) / 60) * (1.3 - 0.4 * v), 0.0004) * srate));
  p[162] = sn_loose * 7 * v * v * sn_lw(n);
  p[163] = exp(-1 / ((0.05 + 0.07 * sn_loose * sn_lw(n)) * srate));
  !p[0] ? p[24] = 0.25 - 0.17 * sn_soft;
  sn_tki += sn_thump * sn_tkg * amp * (0.4 + 0.6 * v) * (n < 60 ? 1 : max(0.35, 1 - (n - 60) / 40));
  sn_tne = max(sn_tne, sn_thump * sn_tng * amp * v);
  p[12] = 1;
  p[9] = 0;
);

function sn_damp(p) local(s, q) (
  s = 0; loop(p[21] * 2, q = sn_q(p, s); q[7] = q[21]; s += 1; );
);
function sn_undamp(p) local(s, q) (
  s = 0; loop(p[21] * 2, q = sn_q(p, s); q[7] = q[20]; s += 1; );
);

function sn_alloc() local(i, p, best, ba, nact, sc_) (
  nact = 0; i = 0; loop(NV, p = VB + i * VS; p[0] && !p[8] ? nact += 1; i += 1; );
  nact >= 12 ? (
    best = -1; i = 0;
    loop(NV, p = VB + i * VS;
      p[0] && !p[8] ? (
        sc_ = (p[3] || p[4] ? 1000 : 0) + (p[3] ? 1000 : 0) + p[14] * 100 + p[2] * 0.000001;
        (best < 0 || sc_ < ba) ? ( best = i; ba = sc_; );
      );
      i += 1; );
    best >= 0 ? ( p = VB + best * VS; p[8] = 1; );
  );
  best = -1; i = 0; loop(NV, p = VB + i * VS; best < 0 && !p[0] ? best = i; i += 1; );
  best < 0 ? ( i = 0; loop(NV, p = VB + i * VS; p[8] && (best < 0 || p[7] < ba) ? ( best = i; ba = p[7]; ); i += 1; ); );
  best < 0 ? best = 0;
  VB + best * VS;
);

function sn_on(n, vel) local(i, p, found) (
  sn_bus = max(sn_bus, 0.25 * srate);
  found = -1; i = 0;
  loop(NV, p = VB + i * VS; p[0] && p[1] == n && !p[8] ? found = i; i += 1; );
  found >= 0 ? (
    p = VB + found * VS; sn_age += 1; p[2] = sn_age; p[3] = 1; p[4] = 0;
    sn_undamp(p);
    sn_excite(p, n, vel);
  ) : (
    p = sn_alloc(); memset(p, 0, VS); sn_age += 1; p[2] = sn_age;
    sn_setup(p, n, vel); sn_excite(p, n, vel);
    p[0] = 1; p[3] = 1; p[4] = 0;
  );
);
function sn_rel(p) ( p[3] = 0; p[4] = 0; sn_damp(p); );
function sn_off(n) local(i, p) (
  i = 0;
  loop(NV, p = VB + i * VS;
    p[0] && p[1] == n && p[3] && !p[8] ? ( sn_ped ? ( p[3] = 0; p[4] = 1; ) : sn_rel(p); );
    i += 1; );
);
function sn_pedup() local(i, p) ( i = 0; loop(NV, p = VB + i * VS; p[0] && p[4] ? sn_rel(p); i += 1; ); );
function sn_alloff() local(i, p) (
  i = 0; loop(NV, p = VB + i * VS; p[0] && (p[3] || p[4]) ? sn_rel(p); i += 1; ); sn_ped = 0;
);

function sn_voice(p) local(t, e, ts, s, q, y, x, u, v, lo, out) (
  t = p[9]; p[9] = t + 1;
  e = 0;
  t < p[15] ? e = p[17] * (1 - cos(t * p[16]));
  ts = t - p[25];
  ts >= 0 && ts < p[15] ? e -= p[26] * p[17] * (1 - cos(ts * p[16]));
  p[28] += p[27] * (e - p[28]); p[29] += p[27] * (p[28] - p[29]); e = p[29];
  sn_gc = p[162]; p[162] *= p[163];
  y = 0; s = 0;
  loop(p[21],
    q = sn_q(p, s);
    y += sn_sstep(q, e * q[22]);
    s += 1;
  );
  x = 0;
  loop(p[21],
    q = sn_q(p, s);
    x += sn_sstep(q, e * q[22]);
    s += 1;
  );
  p[190] += sn_phc * (x - p[190]); x -= p[190];
  p[191] += sn_plc * (x - p[191]);
  y = (y + p[191]) * p[22];
  lo = 0;
  p[170] > 0 ? (
    x = y * y * p[170];
    p[171] += p[180] * (x - p[171]); x -= p[171];
    x += e * p[170] * p[183];
    u = p[174]; v = p[175];
    p[174] = p[172] * u - p[173] * v + x * p[181]; p[175] = p[173] * u + p[172] * v;
    u = p[178]; v = p[179];
    p[178] = p[176] * u - p[177] * v + x * p[182]; p[179] = p[177] * u + p[176] * v;
    lo = p[175] + 0.6 * p[179];
  );
  p[24] += p[19] * (1 - p[24]);
  out = (y + lo) * p[12] * p[7] * p[24];
  sn_vl = out * p[10]; sn_vr = out * p[11];
  p[8] ? ( p[7] -= sn_kst; p[7] <= 0 ? ( p[7] = 0; p[0] = 0; ); );
  u = abs(sn_vl) + abs(sn_vr); u > p[14] ? p[14] = u;
);

function bq_set(t, f, q, db) instance(b0, b1, b2, a1, a2) local(ga, w, cw, sw, al, a0, sq) (
  f = min(f, srate * 0.45); ga = 10 ^ (db / 40); w = 2 * $pi * f / srate; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / ga; b0 = (1 + al * ga) / a0; b1 = -2 * cw / a0; b2 = (1 - al * ga) / a0; a1 = b1; a2 = (1 - al / ga) / a0;
  ) : t == 1 ? (
    sq = 2 * sqrt(ga) * al; a0 = (ga + 1) + (ga - 1) * cw + sq;
    b0 = ga * ((ga + 1) - (ga - 1) * cw + sq) / a0; b1 = 2 * ga * ((ga - 1) - (ga + 1) * cw) / a0; b2 = ga * ((ga + 1) - (ga - 1) * cw - sq) / a0;
    a1 = -2 * ((ga - 1) + (ga + 1) * cw) / a0; a2 = ((ga + 1) + (ga - 1) * cw - sq) / a0;
  ) : t == 2 ? (
    sq = 2 * sqrt(ga) * al; a0 = (ga + 1) - (ga - 1) * cw + sq;
    b0 = ga * ((ga + 1) + (ga - 1) * cw + sq) / a0; b1 = -2 * ga * ((ga - 1) + (ga + 1) * cw) / a0; b2 = ga * ((ga + 1) + (ga - 1) * cw - sq) / a0;
    a1 = 2 * ((ga - 1) - (ga + 1) * cw) / a0; a2 = ((ga + 1) - (ga - 1) * cw - sq) / a0;
  ) : t == 3 ? (
    a0 = 1 + al; b0 = (1 + cw) * 0.5 / a0; b1 = -(1 + cw) / a0; b2 = b0; a1 = -2 * cw / a0; a2 = (1 - al) / a0;
  ) : (
    a0 = 1 + al; b0 = (1 - cw) * 0.5 / a0; b1 = (1 - cw) / a0; b2 = b0; a1 = -2 * cw / a0; a2 = (1 - al) / a0;
  );
);
function bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );

function sn_voiceeq() (
  pzl.bq_set(3, sn_pzf, 0.6, 0); pzr.bq_set(3, sn_pzf, 0.6, 0);
  v1l.bq_set(0, 1600, 0.9, sn_vmid); v1r.bq_set(0, 1600, 0.9, sn_vmid);
  v2l.bq_set(0, 420, 1.1, -2.5); v2r.bq_set(0, 420, 1.1, -2.5);
  v3l.bq_set(4, sn_vlp, 0.7, 0); v3r.bq_set(4, sn_vlp, 0.7, 0);
  v4l.bq_set(1, 110, 0.7, sn_size ? 2.5 : 0); v4r.bq_set(1, 110, 0.7, sn_size ? 2.5 : 0);
);
function sn_toneeq() (
  e1l.bq_set(1, 100, 0.7, sn_bas); e1r.bq_set(1, 100, 0.7, sn_bas);
  e2l.bq_set(0, 1000, 0.8, sn_mid); e2r.bq_set(0, 1000, 0.8, sn_mid);
  e3l.bq_set(2, 5000, 0.7, sn_tre); e3r.bq_set(2, 5000, 0.7, sn_tre);
);

function sn_frameset() local(k, f, t, g, r, w, q) (
  k = 0;
  loop(FRN,
    f = k == 0 ? 212 : k == 1 ? 387 : k == 2 ? 641 : k == 3 ? 983 : k == 4 ? 1452 : k == 5 ? 2147 : k == 6 ? 3093 : 4410;
    t = k < 2 ? 0.22 : k < 5 ? 0.14 : 0.08;
    g = k < 3 ? 1 : 0.8;
    r = exp(-6.9078 / (t * srate)); w = 2 * $pi * min(f, 0.45 * srate) / srate;
    q = FRM + k * 8;
