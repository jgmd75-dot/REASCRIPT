  sn_fresh = 0; sn_vlp = sn_vlpt; sn_bas = sn_bat; sn_mid = sn_mit; sn_tre = sn_trt3;
  v3l.bq_set(4, sn_vlp, 0.7, 0); v3r.bq_set(4, sn_vlp, 0.7, 0); sn_toneeq();
  sn_pk = sn_pkt; sn_res = sn_rest; sn_dv = sn_drv; sn_vg = sn_vgt; sn_chm = sn_cht; sn_chd = sn_chdt; sn_trd = sn_trt ? sn_trdt : 0;
);

sn_mqn = 0; sn_mqi = 0; sn_si = 0;
while (midirecv(sn_mo, sn_ma, sn_mb, sn_mc)) (
  midisend(sn_mo, sn_ma, sn_mb, sn_mc);
  sn_mqn < 256 ? ( MQ[sn_mqn * 4] = sn_mo; MQ[sn_mqn * 4 + 1] = sn_ma; MQ[sn_mqn * 4 + 2] = sn_mb; MQ[sn_mqn * 4 + 3] = sn_mc; sn_mqn += 1; );
);

sn_i = 0; sn_any = 0;
loop(NV,
  sn_p = VB + sn_i * VS;
  sn_p[0] ? (
    !sn_p[3] && !sn_p[4] && sn_p[9] > 0.03 * srate && sn_p[14] < 0.00002 ? ( sn_p[13] += 1; sn_p[13] > 3 ? sn_p[0] = 0; ) :
    sn_p[14] < 0.00003 && sn_p[9] > srate ? sn_p[0] = 0 : sn_p[13] = 0;
    sn_p[14] = 0;
    sn_any = 1;
  );
  sn_i += 1;
);
sn_any ? sn_bus = 0.25 * srate : sn_bus = max(sn_bus - samplesblock, 0);
sn_pk_d = max(sn_pk_d, sn_pk2); sn_pk2 = 0; sn_cph_d = sn_cph; sn_tph_d = sn_tph;

@sample
while (sn_mqi < sn_mqn && MQ[sn_mqi * 4] <= sn_si) (
  sn_st = MQ[sn_mqi * 4 + 1] & 0xF0; sn_d1 = MQ[sn_mqi * 4 + 2]; sn_d2 = MQ[sn_mqi * 4 + 3];
  sn_st == 0x90 && sn_d2 > 0 ? ( sn_on(sn_d1, sn_d2); mi_led_d = 1; ) :
  sn_st == 0x80 || sn_st == 0x90 ? sn_off(sn_d1) :
  sn_st == 0xB0 ? (
    sn_d1 == 64 ? (
      sn_d2 >= 64 && !sn_ped ? sn_ped = 1 :
