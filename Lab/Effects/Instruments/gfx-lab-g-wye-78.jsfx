sn_szt != sn_size ? ( sn_size = sn_szt; sn_voiceeq(); );
sn_touch = max(0, min(2, slider19 | 0));
sn_loose = 1 - slider20 / 100;
sn_tlo = slider23; sn_thi = slider24;
sn_cht = slider25 >= 0.5; sn_chr = min(max(slider26, 0.01), 8); sn_chdt = slider27 / 100;
sn_vlpt = 4500 * 2 ^ (slider6 / 100 * 2);
sn_thump = slider21 / 200;
sn_soft = max(0, min(1, (97 - 0.65 * slider2) / 100));
sn_hard = slider2 / 100;
sn_stk = slider3 / 100;
sn_bark = slider4 / 100;
sn_det = slider5 / 100; sn_pdep = 0.5 + 3 * sn_det;
sn_pkt = slider6 / 100;
sn_rest = slider7 / 100;
sn_dec = 2 ^ ((slider8 - 50) / 50 * 1.3);
sn_wid = slider16 / 100;
sn_dr = slider18 >= 0.5 ? 1 : 0.1;
sn_wand = dW.drift_tick(samplesblock / srate * 0.05) * 0.8;
