srate != sn_sr ? sn_srinit();
sn_now = time_precise();
sn_tp > 0 && sn_now - sn_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > sn_gpp && play_position - sn_gpp < 4 * sn_gpd + 0.05) ? sn_clear();
sn_tp = sn_now; sn_gpp = play_position; sn_gpd = samplesblock / srate;
