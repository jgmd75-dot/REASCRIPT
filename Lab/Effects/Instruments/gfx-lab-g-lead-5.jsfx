function load_preset(p) local(i, q) (
  q = PT + (min(max(p, 1), NP) - 1) * PS;
  i = 0; loop(PS, i != 26 && i != 27 && i != 28 && i < 50 ? ( slider(1 + i) = q[i]; slider_automate(2 ^ i); ); i += 1; );
  pr_cur = min(max(p, 1), NP);
);

function prs_sl() ( l5_update(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(50, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(NP, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl(); all_kill(); fx_clear();
      prs_q ? ( k <= NP ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

function l5_srinit() (
  l5_sr = srate;
  l5_w1 = $pi / srate; l5_fmx = min(20000, 0.45 * srate);
  l5_fis = 1 / (0.002 * srate); l5_fds = 1 / (0.003 * srate);
  l5_sm = 1 - exp(-1 / (0.015 * srate)); l5_lsm = 1 - exp(-1 / (0.0007 * srate));
  l5_dcr = 1 - 2 * $pi * 5 / srate;
  l5_sm2 = 1 - exp(-1 / (0.03 * srate)); l5_wsm = 1 - exp(-1 / (0.01 * srate)); l5_dsm = 1 - exp(-1 / (0.12 * srate));
  ff_att = 1 - exp(-1 / (0.003 * srate)); ff_rel = 1 - exp(-1 / (0.09 * srate));
  ch_lp = 1 - exp(-2 * $pi * 8000 / srate);
  dl_hpc = 1 - exp(-2 * $pi * 120 / srate); dl_lpc = 1 - exp(-2 * $pi * 3200 / srate);
  fx_clear();
  nw_setup(40, 2500, 1.2, 0.25);
);

NWV = 53000;
vc0.vinit(0, -0.24); vc1.vinit(1, 0.24); vc2.vinit(2, -0.12); vc3.vinit(3, 0.12); vc4.vinit(4, 0);
l5_srinit();
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
pwr_init(); pwr_sag = 0.15; pwr_wu_loss = 0.8; pwr_wu_drv = 1.5; pwr_wu_lp = 7000; pwr_wu_wob = 0.25; pwr_bloom = 0.15;
dGl.drift_init(0.9);
wu_t = 1; bend = 1; bend_s = 1; modw = 0; pedal = 0; hcount = 0; vage = 0; qcount = 0; rr = NV - 1;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0; rs_f = 1;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
l5_update();
l5_scut = exp(l5_lcut); l5_sk = l5_kt2; l5_sfe = l5_fet; l5_spe = l5_pet; l5_spb = l5_pbt;
l5_ffs = l5_fft; ph_n = l5_pht; ph_w = ph_n > 0; l5_phr = l5_phrt; l5_phd = l5_phdt; l5_phq = l5_phqt;
ch_ws = l5_chm > 0; l5_chr = l5_chrt; l5_chd = l5_chdt; l5_chxs = l5_chx; l5_dts = l5_dtt; l5_dfs = l5_dft; l5_dxs = l5_dxt;
l5_sma = l5_mat; l5_smb = l5_mbt; l5_spw = l5_pwt; l5_vbs = l5_vbt; l5_lps = l5_lpt; l5_lcs = l5_lct;
vol_s = vol_t; ptr_s = ptr_t; last_uni = l5_uni;
all_kill();
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();

@block
prs_chk();
prs_sl();
srate != l5_sr ? l5_srinit();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? (
  all_kill(); fx_clear(); qcount = 0; rs_f = 0; rs_c = 1 / (0.015 * srate);
  ostL.ost_ch_init(); ostR.ost_ch_init(); l5_dz1 = l5_dz2 = l5_dy1 = l5_dy2 = 0;
);
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pwr_block(1);
wu_t = exp(-(1 - pwr_gm) * (4 + 1.5 * pwr_w1) / 1200 * 0.6931471805599453);

qcount = 0;
while (midirecv(mofs, m1, m2, m3)) (
  midisend(mofs, m1, m2, m3);
  ins_chan_ok(m1, chan) ? (
    st = m1 & 0xF0;
    st == 0x90 && m3 > 0 ? ins_midi_hit();
    st == 0x90 || st == 0x80 ? q_push(mofs, st == 0x90 && m3 > 0, m2, m3) :
    st == 0xE0 ? bend = ins_bend(m2, m3, 2) :
    st == 0xB0 ? (
      m2 == 1 ? modw = m3 / 127 :
      m2 == 64 ? ( pedal = m3 >= 64; !pedal ? q_push(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? q_push(mofs, 3, 0, 0);
    );
  );
);
au_pst = play_state == 1 || play_state == 5;
au_pst_prev && !au_pst ? q_push(0, 3, 0, 0);
au_pst_prev = au_pst;
l5_uni != last_uni ? ( q_push(0, 3, 0, 0); last_uni = l5_uni; );
panic_dirty ? ( panic_dirty = 0; q_push(0, 3, 0, 0); pedal = 0; );
eqi = 0; spos = 0;

l5_dt = 0.35 * samplesblock / srate;
l5_gd = dGl.drift_tick(l5_dt * 0.5) * l5_dm * 3;
vc0.vblock(l5_dt); vc1.vblock(l5_dt); vc2.vblock(l5_dt); vc3.vblock(l5_dt); vc4.vblock(l5_dt);
l5_vt_d = (vc0.as > 0) + (vc1.as > 0) * 2 + (vc2.as > 0) * 4 + (vc3.as > 0) * 8 + (vc4.as > 0) * 16;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (eqi < qcount && (EQO[eqi] <= spos || spos >= samplesblock - 1)) (
  et = EQT[eqi];
  et == 1 ? note_on(EQN[eqi], EQV[eqi]) : et == 0 ? note_off(EQN[eqi]) : et == 2 ? pedal_up() : all_off();
  eqi += 1;
);
spos += 1;

l5_scut *= exp((l5_lcut - log(l5_scut)) * l5_sm);
l5_sk += (l5_kt2 - l5_sk) * l5_sm; l5_sfe += (l5_fet - l5_sfe) * l5_sm;
l5_spe += (l5_pet - l5_spe) * l5_sm; l5_spb += (l5_pbt - l5_spb) * l5_sm;
l5_sma += (l5_mat - l5_sma) * l5_sm; l5_smb += (l5_mbt - l5_smb) * l5_sm; l5_spw += (l5_pwt - l5_spw) * l5_sm;
l5_vbs += (l5_vbt - l5_vbs) * l5_sm; l5_lps += (l5_lpt - l5_lps) * l5_sm; l5_lcs += (l5_lct - l5_lcs) * l5_sm;
bend_s += (bend - bend_s) * l5_sm; modw_s += (modw - modw_s) * l5_sm;
l5_base = 440 * bend_s * wu_t;

l5_lph += l5_lfr / srate;
l5_lph >= 1 ? ( l5_lph -= floor(l5_lph); l5_shv = rand(1) * 2 - 1; );
l5_lr = l5_lws == 0 ? sin(2 * $pi * l5_lph) : l5_lws == 1 ? 1 - 4 * abs(l5_lph - 0.5) : l5_lws == 2 ? 2 * l5_lph - 1 : l5_lws == 3 ? (l5_lph < 0.5 ? 1 : -1) : l5_shv;
l5_lfs += (l5_lr - l5_lfs) * l5_lsm;
l5_vo = l5_lfs * (l5_vbs + modw_s * 50) / 1200;
l5_lpo = l5_lfs * l5_lps * 0.4;
l5_lco = l5_lfs * l5_lcs * 3;

y0 = vc0.vrun(); y1 = vc1.vrun(); y2 = vc2.vrun(); y3 = vc3.vrun(); y4 = vc4.vrun();
l5_uni ? ( oL = oR = (y0 + y1 + y2 + y3 + y4) * 0.75; ) : (
  oL = y0 * (1 - max(vc0.pan, 0)) + y1 * (1 - max(vc1.pan, 0)) + y2 * (1 - max(vc2.pan, 0)) + y3 * (1 - max(vc3.pan, 0)) + y4;
  oR = y0 * (1 + min(vc0.pan, 0)) + y1 * (1 + min(vc1.pan, 0)) + y2 * (1 + min(vc2.pan, 0)) + y3 * (1 + min(vc3.pan, 0)) + y4;
);
l5_dy1 = oL - l5_dz1 + l5_dcr * l5_dy1; l5_dz1 = oL;
l5_dy2 = oR - l5_dz2 + l5_dcr * l5_dy2; l5_dz2 = oR;

vol_s += (vol_t - vol_s) * l5_sm;
ptr_s += (ptr_t - ptr_s) * l5_sm;
fx_l = l5_dy1 * 0.2 * ptr_s; fx_r = l5_dy2 * 0.2 * ptr_s;

l5_ffs += (l5_fft - l5_ffs) * l5_sm2;
l5_ffs > 0.001 ? (
  ff_cn = l5_ffs / 10; ff_thr = -32 * ff_cn; ff_sl = 1 - 1 / (1 + 5 * ff_cn); ff_mk = -ff_thr * ff_sl * 0.5;
  ff_cl = max(abs(fx_l), abs(fx_r));
  ff_ov = (ff_cl > 0.000001 ? 20 * log10(ff_cl) : -120) - ff_thr;
  ff_cg = ff_ov <= -3 ? 0 : ff_ov >= 3 ? ff_ov * ff_sl : ff_sl * sqr(ff_ov + 3) / 12;
  ff_grs += (ff_cg - ff_grs) * (ff_cg > ff_grs ? ff_att : ff_rel);
  ff_g = exp((ff_mk - ff_grs) * 0.11512925464970228);
  fx_l *= ff_g; fx_r *= ff_g;
) : ff_grs = 0;

ph_w += ((ph_n > 0 && ph_n == l5_pht ? 1 : 0) - ph_w) * l5_wsm;
ph_n != l5_pht && ph_w < 0.0005 ? ( ph_n = l5_pht; ph_w = 0; memset(PHS, 0, 24); ph_fbl = ph_fbr = 0; );
l5_phr += (l5_phrt - l5_phr) * l5_sm; l5_phd += (l5_phdt - l5_phd) * l5_sm; l5_phq += (l5_phqt - l5_phq) * l5_sm;
ph_ph += l5_phr / srate; ph_ph >= 1 ? ph_ph -= 1;
ph_n > 0 ? (
  ph_t = tan(min(160 * exp(3.33 * l5_phd * (0.5 - 0.5 * cos(2 * $pi * ph_ph))), 0.4 * srate) * $pi / srate); ph_c = (ph_t - 1) / (ph_t + 1);
  ph_x = fx_l + l5_th(ph_fbl * l5_phq); ph_i = 0;
  loop(ph_n, ph_y = ph_c * ph_x + PHS[ph_i]; PHS[ph_i] = ph_x - ph_c * ph_y; ph_x = ph_y; ph_i += 1; );
  ph_fbl = ph_x; fx_l += (0.5 * (ph_x - fx_l)) * ph_w;
