desc:Lead 5 [poly synth] (GFX Lab)
//tags: instrument synth poly lead analogue vintage poly-mod
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-warmup, gfx-lab-power, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider52:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:p_w1=0<0,1,1{Saw,Pulse}>-Osc 1 wave
slider2:p_w2=0<0,2,1{Saw,Pulse,Triangle}>-Osc 2 wave
slider3:p_crs=0<-24,24,1>-Osc 2 coarse (st)
slider4:p_fin=8<-50,50,0.1>-Osc 2 fine (cents)
slider5:p_mix=50<0,100,1>-Osc mix (%)
slider6:p_pw=50<5,95,1>-Pulse width (%)
slider7:p_cut=2200<20,18000,1>-Cutoff (Hz)
slider8:p_res=25<0,100,1>-Resonance (%)
slider9:p_env=45<-100,100,1>-Filter env amount (%)
slider10:p_ktr=50<0,100,1>-Key track (%)
slider11:p_fra=0.667<0.05,20,0.001>-Filter attack (x attack)
slider12:p_frd=1.75<0.05,20,0.001>-Filter decay (x decay)
slider13:p_fsu=35<0,100,1>-Filter sustain (%)
slider14:p_frr=1.2<0.05,20,0.001>-Filter release (x release)
slider15:p_att=3<0.5,3000,0.1>-Attack (ms)
slider16:p_dec=200<5,5000,1>-Decay (ms)
slider17:p_asu=90<0,100,1>-Sustain (%)
slider18:p_rel=250<5,5000,1>-Release (ms)
slider19:p_lfr=5.2<0.01,20,0.01>-LFO rate (Hz)
slider20:p_lfs=1<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO shape
slider21:p_vib=6<0,100,1>-Vibrato (cents)
slider22:p_lpw=0<0,100,1>-LFO to PWM (%)
slider23:p_lct=0<0,100,1>-LFO to cutoff (%)
slider24:p_gld=0<0,1000,1>-Glide (ms)
slider25:p_vm=0<0,1,1{Poly,Unison}>-Voice mode
slider26:p_vel=40<0,100,1>-Velocity (%)
slider27:p_drf=50<0,100,1>-Drift (%)
slider28:p_ch=0<0,16,1>-MIDI channel (0 = omni)
slider29:p_vol=0<-24,6,0.1>-Volume (dB)
slider30:p_wid=60<0,100,1>-Stereo width (%)
slider31:p_pmf=0<0,100,1>-Poly-mod filter env (%)
slider32:p_pmo=0<0,100,1>-Poly-mod osc 2 (%)
slider33:p_pfa=0<0,1,1{Off,On}>-Poly-mod to osc 1 pitch
slider34:p_ppw=0<0,1,1{Off,On}>-Poly-mod to osc 1 pulse width
slider35:p_pff=0<0,1,1{Off,On}>-Poly-mod to filter
slider36:p_syn=0<0,1,1{Off,On}>-Sync osc 1 to osc 2
slider37:p_lo=0<0,1,1{Off,On}>-Osc 2 low frequency
slider38:p_age=35<0,100,1>-Age (%)
slider39:p_crd=1<0,1,1{Early,Late}>-Voice cards
slider40:p_trm=1.273<0.1,4,0.001>-Patch level (x)
slider41:p_fft=0<0,10,0.1>-Ffat
slider42:p_phs=0<0,3,1{Off,4 stages,8 stages,12 stages}>-Phaser
slider43:p_phr=0.5<0.01,10,0.01>-Phaser rate (Hz)
slider44:p_phd=60<0,100,1>-Phaser depth (%)
slider45:p_phq=30<0,100,1>-Phaser resonance (%)
slider46:p_chm=1<0,3,1{Off,I,II,I+II}>-Chorus
slider47:p_chx=50<0,100,1>-Chorus mix (%)
slider48:p_dlt=380<40,1000,1>-Tape delay time (ms)
slider49:p_dlf=35<0,100,1>-Tape delay repeats (%)
slider50:p_dlx=18<0,100,1>-Tape delay mix (%)
slider51:prs_sel=0<0,24,1{No preset,Five Lead,Sync Scream,Poly-Mod Bell,Brass Five,Unison Bass,Early Strings,Clav Pluck,Resonant Sweep,Hollow Pipe,Metal Clang,LO Wobble,Fifths,Aged Pad,Stack Lead,Sync Brass,Phase Keys,Poly-Mod Growl,Tape Echo Pluck,Jet Pad,Ffat Stab,Sweep Bass,Choir Five,Worn Strings,Init}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

@init
function psw_all(v) ( slider_show(4503599627370495, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); );
#ui_man = "gfx-lab-g-lead-5";
ext_noinit = 1;

NV = 5; NP = 24; PS = 50;
DLN = 262144; CN = 4096; DLL = 100000; DLR = 400000; CHB = 700000; PHS = 56000;
VN = 50000; VG = 50010; VT = 50020; VS = 50030;
HN = 50100;
EQO = 50300; EQT = 50600; EQN = 50900; EQV = 51200;
CRD = 52000;
PT = 60000;
l5_i = 0; loop(NV, VN[l5_i] = -1; VG[l5_i] = 0; VT[l5_i] = 0; VS[l5_i] = 0; l5_i += 1; );

function l5_crd(i, a, b, c, q, e, p, g) ( CRD[i * 8] = a; CRD[i * 8 + 1] = b; CRD[i * 8 + 2] = c; CRD[i * 8 + 3] = q; CRD[i * 8 + 4] = e; CRD[i * 8 + 5] = p; CRD[i * 8 + 6] = g; );
l5_crd(0, 0.6, -0.3, 0.4, -0.2, 0.3, -0.5, 0.2);
l5_crd(1, -0.8, 0.5, -0.6, 0.5, -0.4, 0.3, -0.6);
l5_crd(2, 0.2, 0.9, 0.1, -0.7, 0.8, 0.6, 0.4);
l5_crd(3, -0.4, -0.9, 0.9, 0.3, -0.7, -0.2, -0.3);
l5_crd(4, 1.0, 0.1, -0.8, 0.9, 0.0, -0.9, 0.5);

function l5_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function l5_cf(t, k) ( 1 - exp(-k / (max(t, 0.0001) * srate)); );

function vinit(i, p) instance(id, pan, cur, tgt, played, nwb, dra, drb, drc, ca, cb, cc, cq, ce, cp, cg) (
  id = i; pan = p; cur = 60; tgt = 60; played = 0;
  nwb = NWV; NWV += 4;
  ca = CRD[i * 8]; cb = CRD[i * 8 + 1]; cc = CRD[i * 8 + 2]; cq = CRD[i * 8 + 3]; ce = CRD[i * 8 + 4]; cp = CRD[i * 8 + 5]; cg = CRD[i * 8 + 6];
  dra.drift_init(0.8 + rand(1) * 0.5); drb.drift_init(0.8 + rand(1) * 0.5); drc.drift_init(0.8 + rand(1) * 0.5);
);
function vblock(dt) instance(id, ca, cb, cc, cq, ce, cp, cg, dra, drb, drc, ofa, ofb, ofc, kq, kg, pwo, fac, fdc, frc, aac, adc, arc) local(m, da, db, dc, u) (
  da = dra.drift_tick(dt) * l5_dm; db = drb.drift_tick(dt) * l5_dm; dc = drc.drift_tick(dt) * l5_dm;
  u = l5_uni ? (id - 2) * 2.5 : 0;
  ofa = (ca * l5_age * 14 + da * 5 + u + l5_gd) / 1200;
  ofb = (cb * l5_age * 14 + db * 5 - u + l5_gd) / 1200;
  ofc = cc * l5_age * 0.35 + dc * 0.07;
  kq = 1 + cq * l5_age * 0.25;
  kg = exp(cg * l5_age * 1.2 * 0.11512925);
  pwo = cp * l5_age * 0.06;
  m = exp(ce * l5_age * 0.3);
  fac = l5_cf(l5_tfa * m, l5_atk); fdc = l5_cf(l5_tfd * m, 4.6); frc = l5_cf(l5_tfr * m, 4.6);
  aac = l5_cf(l5_taa * m, l5_atk); adc = l5_cf(l5_tad * m, 4.6); arc = l5_cf(l5_tar * m, 4.6);
);
function vgo(n, v) instance(as, ae, fs, fe, tgt, cur, vel, fi, nwb, played, pend, fd, prel) (
  ae < 0.003 ? ( fi = 0; nw_start(nwb); );
  tgt = n; vel = v / 127;
  l5_gc >= 1 || !played ? cur = n;
  fs = 1; as = 1; played = 1; pend = 0; fd = 1;
  prel ? ( fs = 3; as = 3; prel = 0; );
);
function vstart(n, v) instance(as, ae, tgt, pend, pnote, pvel, prel) (
  prel = 0;
  ae > 0.003 && as > 0 && n != tgt ? ( pend = 1; pnote = n; pvel = v; ) : this.vgo(n, v);
);
function vglide(n) instance(tgt) ( tgt = n; );
function vstop() instance(as, fs, pend, prel) ( pend ? prel = 1; fs > 0 ? fs = 3; as > 0 ? as = 3; );
function vkill() instance(as, ae, fs, fe, s1, s2, s3, s4, fi, pend, fd, ap, bp, bo, prel) (
  as = ae = fs = fe = 0; s1 = s2 = s3 = s4 = 0; fi = 0; pend = 0; fd = 1; ap = bp = bo = 0; prel = 0;
);
function vrun() instance(id, cur, tgt, vel, pa, pb, ap, bp, bo, s1, s2, s3, s4, fs, fe, as, ae, fi, fd, pend, pnote, pvel, prel,
    nwb, played, ofa, ofb, ofc, kq, kg, pwo, fac, fdc, frc, aac, adc, arc)
  local(pm, fa, fb, ia, ib, wb, ab, wa, aa, pe, a, h, pwa, pwb, bc, ac, cpa, cca, x, oct, fc, g, k, u, y1, y, vgn) (
  as == 0 && !pend ? 0 : (
    fs == 1 ? ( fe += (1.5 - fe) * fac; fe >= 1 ? ( fe = 1; fs = 2; ); ) : fs == 2 ? fe += (l5_fsl - fe) * fdc : fs == 3 ? fe -= fe * frc;
    as == 1 ? ( ae += (1.5 - ae) * aac; ae >= 1 ? ( ae = 1; as = 2; ); ) : as == 2 ? ae += (l5_asl - ae) * adc :
    as == 3 ? ( ae -= ae * arc; ae < 0.00002 ? ( ae = 0; as = 0; fs = 0; fe = 0; ); );
    cur += (tgt - cur) * l5_gc;
    pm = fe * l5_spe + bo * l5_spb;
    fa = l5_base * exp(((cur - 69) / 12 + ofa + l5_vo + (l5_pfa ? pm * 4 : 0)) * 0.6931471805599453);
    fb = l5_base * exp((((l5_lo ? 60 : cur) + l5_sst - 69) / 12 + ofb + l5_vo) * 0.6931471805599453) * (l5_lo ? 0.00390625 : 1);
    ia = min(max(fa / srate, 0.000001), 0.45); ib = min(max(fb / srate, 0.0000001), 0.45);
    pwb = min(max(l5_spw + l5_lpo + pwo, 0.03), 0.97);
    pwa = min(max(l5_spw + l5_lpo + (l5_ppw ? pm * 0.45 : 0) - pwo, 0.03), 0.97);

    pb += ib; wb = 0; ab = 0;
    pb >= 1 ? ( pb -= floor(pb); wb = 1; ab = pb / ib; );
    bc = 0;
    l5_bw == 0 ? ( bc += 2 * pb - 1; wb ? ( bp -= ab * ab; bc += (1 - ab) * (1 - ab); ); );
    l5_bw == 2 ? bc += 4 * abs(pb - 0.5) - 1;
    l5_bw == 1 ? (
      bc += pb < pwb ? 1 : -1;
      wb ? ( bp += ab * ab; bc -= (1 - ab) * (1 - ab); );
      (wb ? pb >= pwb : (pb - ib < pwb && pb >= pwb)) ? ( a = (pb - pwb) / ib; a <= 1 ? ( bp -= a * a; bc += (1 - a) * (1 - a); ); );
    );
    bo = bp; bp = bc;

    pa += ia; cpa = 0; cca = 0;
    l5_sync && wb ? (
      pe = pa - ab * ia;
      pe >= 1 ? (
        pe -= floor(pe); aa = pe / ia + ab; aa = min(aa, 1);
        !l5_aw ? ( cpa -= aa * aa; cca += (1 - aa) * (1 - aa); );
        l5_aw ? ( cpa += aa * aa; cca -= (1 - aa) * (1 - aa); );
      ) : (
        l5_aw && pe >= pwa && pe - (1 - ab) * ia < pwa ? ( a = min((pe - pwa) / ia + ab, 1); cpa -= a * a; cca += (1 - a) * (1 - a); );
      );
      !l5_aw ? ( h = -pe; cpa += h * ab * ab; cca -= h * (1 - ab) * (1 - ab); );
      l5_aw ? ( h = pe < pwa ? 0 : 1; cpa += h * ab * ab; cca -= h * (1 - ab) * (1 - ab); );
      pa = ab * ia;
    ) : (
      wa = 0; aa = 0;
      pa >= 1 ? ( pa -= floor(pa); wa = 1; aa = pa / ia; );
      !l5_aw && wa ? ( cpa -= aa * aa; cca += (1 - aa) * (1 - aa); );
      l5_aw ? (
        wa ? ( cpa += aa * aa; cca -= (1 - aa) * (1 - aa); );
        (wa ? pa >= pwa : (pa - ia < pwa && pa >= pwa)) ? ( a = (pa - pwa) / ia; a <= 1 ? ( cpa -= a * a; cca += (1 - a) * (1 - a); ); );
      );
    );
    ac = (!l5_aw ? 2 * pa - 1 : (pa < pwa ? 1 : -1)) + cca;
    ap += cpa;
    x = ap * l5_sma + bo * l5_smb;
    ap = ac;

    vgn = 1 - l5_vel + l5_vel * vel;
    oct = ofc + l5_sfe * fe * (0.6 + 0.4 * vgn) + l5_kt * (cur - 60) / 12 + l5_lco + (l5_pff ? pm * 3 : 0);
    fc = min(max(l5_scut * exp(oct * 0.6931471805599453), 8), l5_fmx);
    g = tan(l5_w1 * fc); g = g / (1 + g);
    k = l5_sk * kq;
    y1 = g * g * g * (1 - g) * s1 + g * g * (1 - g) * s2 + g * (1 - g) * s3 + (1 - g) * s4;
    u = x * l5_dr * (1 + l5_cmp * k);
    y = (g * g * g * g * u + y1) / (1 + k * g * g * g * g);
    u = l5_th(u - k * y);
    a = (u - s1) * g; y1 = a + s1; s1 = y1 + a;
    a = (y1 - s2) * g; y1 = a + s2; s2 = y1 + a;
    a = (y1 - s3) * g; y1 = a + s3; s3 = y1 + a;
    a = (y1 - s4) * g; y1 = a + s4; s4 = y1 + a;
    y = y1 * l5_fo;

    y *= ae * kg * vgn;
    fi < 1 ? ( y *= 0.5 - 0.5 * cos($pi * fi); fi = min(fi + l5_fis, 1); );
    pend ? (
      fd -= l5_fds; y *= max(fd, 0);
      fd <= 0 ? (
        ae = 0; fe = 0; fi = 0; nw_start(nwb);
        tgt = pnote; vel = pvel / 127; l5_gc >= 1 ? cur = pnote;
        fs = 1; as = 1; pend = 0; fd = 1;
        prel ? ( fs = 3; as = 3; prel = 0; );
      );
    );
    nw_run(nwb, y);
  );
);

function v_start(i, n, v) ( i == 0 ? vc0.vstart(n, v) : i == 1 ? vc1.vstart(n, v) : i == 2 ? vc2.vstart(n, v) : i == 3 ? vc3.vstart(n, v) : vc4.vstart(n, v); );
function v_stop(i) ( i == 0 ? vc0.vstop() : i == 1 ? vc1.vstop() : i == 2 ? vc2.vstop() : i == 3 ? vc3.vstop() : vc4.vstop(); );
function v_glide(i, n) ( i == 0 ? vc0.vglide(n) : i == 1 ? vc1.vglide(n) : i == 2 ? vc2.vglide(n) : i == 3 ? vc3.vglide(n) : vc4.vglide(n); );

function all_off() local(i) (
  i = 0; loop(NV, VG[i] ? v_stop(i); VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; );
  hcount = 0;
);
function all_kill() local(i) (
  vc0.vkill(); vc1.vkill(); vc2.vkill(); vc3.vkill(); vc4.vkill();
  i = 0; loop(NV, VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; );
  hcount = 0;
);
function poly_on(n, v) local(i, j, best, ba) (
  best = -1;
  i = 0; loop(NV, VN[i] == n ? best = i; i += 1; );
  best < 0 ? ( j = 1; loop(NV, i = (rr + j) % NV; best < 0 && !VG[i] ? best = i; j += 1; ); );
  best < 0 ? ( ba = -1; i = 0; loop(NV, best < 0 || VT[i] < ba ? ( best = i; ba = VT[i]; ); i += 1; ); );
  rr = best;
  vage += 1; VT[best] = vage; VN[best] = n; VG[best] = 1; VS[best] = 0;
  v_start(best, n, v);
);
function poly_off(n) local(i) (
  i = 0; loop(NV, VN[i] == n && VG[i] ? ( pedal ? VS[i] = 1 : ( v_stop(i); VG[i] = 0; ); ); i += 1; );
);
function uni_on(n, v) local(i, f, legato) (
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  i = 0; loop(NV, legato && VG[i] ? v_glide(i, n) : v_start(i, n, v); VN[i] = n; VG[i] = 1; VS[i] = 0; i += 1; );
);
function uni_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? ( i = 0; loop(NV, v_glide(i, HN[hcount - 1]); VN[i] = HN[hcount - 1]; i += 1; ); ) :
      ( i = 0; loop(NV, pedal ? VS[i] = 1 : ( v_stop(i); VG[i] = 0; ); i += 1; ); );
  );
);
function note_on(n, v) ( l5_uni ? uni_on(n, v) : poly_on(n, v); );
function note_off(n) ( l5_uni ? uni_off(n) : poly_off(n); );
function pedal_up() local(i) ( i = 0; loop(NV, VS[i] ? ( v_stop(i); VG[i] = 0; VS[i] = 0; ); i += 1; ); );

function q_push(ofs, t, n, v) local(i) (
  qcount < 300 ? (
    i = qcount; while (i > 0 && EQO[i - 1] > ofs) ( EQO[i] = EQO[i - 1]; EQT[i] = EQT[i - 1]; EQN[i] = EQN[i - 1]; EQV[i] = EQV[i - 1]; i -= 1; );
    EQO[i] = ofs; EQT[i] = t; EQN[i] = n; EQV[i] = v; qcount += 1;
  );
);

function l5_update() local(e, w) (
  l5_aw = p_w1 >= 0.5; l5_bw = floor(p_w2 + 0.5);
  l5_sst = p_crs + p_fin / 100;
  l5_mat = 0.9 * (1 - p_mix / 100); l5_mbt = 0.9 * p_mix / 100;
  l5_pwt = p_pw / 100;
  l5_lcut = log(min(max(p_cut, 20), 18000));
  l5_early = p_crd < 0.5;
  e = p_res / 100;
  l5_kt2 = l5_early ? 4.6 * e ^ 0.9 : 4.25 * e ^ 1.25;
  l5_cmp = l5_early ? 0.45 : 0;
  l5_dr = l5_early ? 1.25 : 0.9; l5_fo = 1 / l5_dr * (l5_early ? 0.85 : 1);
  l5_fet = p_env / 100 * 6;
  l5_kt = p_ktr / 100;
  l5_taa = p_att / 1000; l5_tad = p_dec / 1000; l5_asl = p_asu / 100; l5_tar = p_rel / 1000;
  l5_tfa = min(max(p_att * p_fra, 0.5), 3000) / 1000; l5_tfd = min(max(p_dec * p_frd, 5), 5000) / 1000;
  l5_fsl = p_fsu / 100; l5_tfr = min(max(p_rel * p_frr, 5), 5000) / 1000;
  l5_atk = l5_early ? 1.204 : 1.0986;
  l5_lfr = min(max(p_lfr, 0.01), 20); l5_lws = floor(p_lfs + 0.5);
  l5_vbt = p_vib; l5_lpt = p_lpw / 100; l5_lct = p_lct / 100;
  l5_gc = p_gld < 0.5 ? 1 : 1 - exp(-3 / (p_gld / 1000 * srate));
  l5_uni = p_vm >= 0.5; l5_vel = p_vel / 100;
  l5_dm = p_drf / 50 * (l5_early ? 2 : 1);
  chan = p_ch | 0;
  vol_t = exp(min(max(p_vol, -24), 6) * 0.11512925464970228);
  w = p_wid / 100;
  vc0.pan = -0.40 * w; vc1.pan = 0.40 * w; vc2.pan = -0.20 * w; vc3.pan = 0.20 * w; vc4.pan = 0;
  l5_pet = sqr(p_pmf / 100); l5_pbt = sqr(p_pmo / 100);
  l5_pfa = p_pfa >= 0.5; l5_ppw = p_ppw >= 0.5; l5_pff = p_pff >= 0.5;
  l5_sync = p_syn >= 0.5; l5_lo = p_lo >= 0.5;
  l5_age = p_age / 100;
  ptr_t = p_trm * (l5_uni ? 0.5 : 1);
  l5_fft = min(max(p_fft, 0), 10);
  l5_pht = floor(p_phs + 0.5) * 4; l5_phrt = min(max(p_phr, 0.01), 10); l5_phdt = p_phd / 100; l5_phqt = p_phq / 100 * 0.8;
  l5_chm = floor(p_chm + 0.5); l5_chx = p_chx / 100;
  l5_chrt = l5_chm == 1 ? 0.513 : l5_chm == 2 ? 0.863 : 9.75;
  l5_chdt = l5_chm == 1 ? 1.6 : l5_chm == 2 ? 2.4 : 0.32;
  l5_dtt = min(max(p_dlt, 40), 1000); l5_dft = p_dlf / 100 * 0.92; l5_dxt = p_dlx / 100;
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);
);

function fx_clear() (
  memset(DLL, 0, DLN); memset(DLR, 0, DLN); memset(CHB, 0, CN); memset(PHS, 0, 24);
  ph_fbl = ph_fbr = 0; dl_hl = dl_hr = dl_xl = dl_xr = dl_ll = dl_lr = 0;
  ch_p1 = ch_p2 = ch_o1 = ch_o2 = 0; ff_grs = 0;
);
function dl_rd(base, d) local(p, i, f) (
  p = dl_w - min(max(d, 1), DLN - 4); p < 0 ? p += DLN;
  i = floor(p); f = p - i;
  base[i] + (base[(i + 1) & (DLN - 1)] - base[i]) * f;
);
function ch_rd(d) local(p, i, f) (
  p = ch_w - min(max(d, 1), CN - 4); p < 0 ? p += CN;
  i = floor(p); f = p - i;
  CHB[i] + (CHB[(i + 1) & (CN - 1)] - CHB[i]) * f;
);

