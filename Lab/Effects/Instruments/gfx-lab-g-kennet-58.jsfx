  k5_f6 = ui_fitfont(6, 24 * sc);
);
function k5_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * k5_kt * sc, 'b'); );
function k5_fc(px) ( gfx_setfont(12, "Courier New", px * k5_kt * sc, 'b'); );
function k5_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function k5_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function k5_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function k5_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function k5_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(ui_mix(f, 0, 0.10 + d * 0.012)); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
KIN = ui_mix(ui_mix(KF, 0, 0.10), 0, 0.30);
function k5_pocket(x, y, w, h) ( k5_cham(x, y, w, h, 3, KF); ui_col(KIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function k5_hover(cx, cy, fs) ( k5_hon = 1; k5_hx = cx; k5_hy = cy; k5_hfs = fs; );
function k5_title(x, y, s) ( k5_ft(16); ui_col(KI); k5_tl(x, y, s); );
function k5_rule(x, y, s, c) ( k5_ft(16); ui_col(c); v5_r(x, y + 12, k5_tw(s), 3); );
function k5_pct(v, a, b) (
  abs(v) < 0.005 ? strcpy(#k5_hv, "CENTRE") : v < 0 ? sprintf(#k5_hv, "%s %d %%", a, -v * 100 + 0.5) : sprintf(#k5_hv, "%s %d %%", b, v * 100 + 0.5);
);
function k5_fmt(idx) local(v) (
  v = slider(idx);
  idx == 17 ? k5_pct(v, "HARMONIC", "METAL") :
  idx == 43 ? k5_pct(v, "TO HARMONIC", "TO METAL") :
  idx == 45 ? k5_pct(v, "WOOD", "GLASS") :
  idx == 13 || idx == 42 ? ( v = floor(v + 0.5); v == 0 ? strcpy(#k5_hv, "0 OCT") : sprintf(#k5_hv, "%+d OCT", v); ) :
  idx == 44 || idx == 21 ? ( v < 1 ? sprintf(#k5_hv, "%d ms", v * 1000 + 0.5) : sprintf(#k5_hv, "%.2f s", v); ) :
  idx == 5 ? sprintf(#k5_hv, "%.2f x", v) :
  idx == 10 || idx == 23 ? sprintf(#k5_hv, "%.2f Hz", v) :
  idx == 12 ? sprintf(#k5_hv, "%+.1f c", v) :
  idx == 16 ? sprintf(#k5_hv, "%+.1f dB", v) :
  idx == 25 ? sprintf(#k5_hv, "%+d %%", v * 100) :
  idx == 27 ? sprintf(#k5_hv, "%.1f", v) :
  idx == 35 ? sprintf(#k5_hv, "%.1f s", v) :
  idx == 36 || idx == 38 ? sprintf(#k5_hv, "%d %%", v) :
  idx == 37 ? sprintf(#k5_hv, "%d ms", v) :
  idx == 39 || idx == 49 ? sprintf(#k5_hv, "%d Hz", v) :
  idx == 51 ? ( v < 1000 ? sprintf(#k5_hv, "%d Hz", v) : sprintf(#k5_hv, "%.1f kHz", v / 1000); ) :
  idx == 48 || idx == 50 ? sprintf(#k5_hv, "%+.1f dB", v) :
  sprintf(#k5_hv, "%d %%", v * 100 + 0.5);
);
function k5_dial(cx, cy, r, idx, lo, hi, def, lg, lbl, ptr, fs, bip) local(n, a, i, t, rs) (
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 8), 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(0xC8CDC4); t = -0.75 * $pi; v5_d(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_d(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  bip ? v5_d(cx, cy - rs, 1.5);
  v5_shc(cx, cy, r);
  ui_col(0x13151B); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2C3038); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xBDB49E); v5_d(cx, cy, r * 0.74);
  ui_col(k5_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  ui_cola(0xFFFFFF, 0.55); v5_arc(cx, cy, r * 0.58, -1.9, -0.5, 1.2);
  v5_pdot(cx, cy, a, r * 0.70, ptr);
  v5_act ? ( k5_fmt(idx); k5_hover(cx, cy + r + 19, fs); ) : ( k5_ft(fs); ui_col(k5_dim ? ui_mix(KI, KIN, 0.55) : KI); v5_t(cx, cy + r + 19, lbl); );
  k5_dim = 0;
);
function k5_menu(x, y, w, h, idx, n, labels, en) local(cur, i, k) (
  cur = max(0, min(n - 1, slider(idx) | 0));
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(0x141615); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.4); v5_r(x + 1, y + 1, w - 2, 2);
  k5_fc(15); ui_col(en ? 0xFFB347 : 0x6A5A40); v5_t(x + (w - 12) / 2, y + h / 2 + 1, v5_part(labels, cur));
  ui_col(en ? 0xFFB347 : 0x6A5A40); gfx_triangle((x + w - 13) * sc, (y + h / 2 - 2.5) * sc, (x + w - 5) * sc, (y + h / 2 - 2.5) * sc, (x + w - 9) * sc, (y + h / 2 + 2.5) * sc);
  v5_pr && v5_drag == 0 && v5_hit(x, y, w, h) ? (
    v5_drag = -1; strcpy(#k5_mm, ""); i = 0;
    loop(n, i == cur ? strcat(#k5_mm, "!"); strcat(#k5_mm, v5_part(labels, i)); i < n - 1 ? strcat(#k5_mm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h + 2) * sc; k = gfx_showmenu(#k5_mm);
    k > 0 ? ( slider(idx) = k - 1; ui_auto(idx); );
  );
  v5_hit(x, y, w, h) && mouse_wheel != 0 && v5_drag == 0 ? (
    slider(idx) = max(0, min(n - 1, cur - sign(mouse_wheel))); ui_auto(idx); mouse_wheel = 0;
  );
);
function k5_head(x, y, ttl, idx) local(on) (
  on = v5_toggle(idx, v5_hit(x + 6, y + 6, k5_tw(ttl) + 34, 26));
  ui_col(0x050606); v5_d(x + 17, y + 19, 6.5);
  ui_col(0xD8CFB4); v5_d(x + 17, y + 19, 5.2);
  on ? ( ui_cola(KA, 0.18); v5_d(x + 17, y + 19, 11); ui_col(KA); v5_d(x + 17, y + 19, 3.6); ui_cola(0xFFF0C8, 0.8); v5_d(x + 16.2, y + 18.2, 1.3); )
     : ( ui_col(0x5A4A2A); v5_d(x + 17, y + 19, 3.6); );
  k5_ft(16); ui_col(KI); k5_tl(x + 29, y + 20, ttl);
  on;
);
function k5_grey(x, y, w, h, on) ( !on ? ( ui_cola(KIN, 0.45); v5_r(x + 4, y + 36, w - 8, h - 40); ); );
function k5_led(x, y, c, g) local(i) (
  ui_col(0x050606); v5_d(x, y, 5.5);
  ui_col(ui_mix(c, 0x101214, 0.78)); v5_d(x, y, 4);
  g > 0.01 ? (
    i = 0; loop(5, ui_cola(c, 0.07 * g); v5_d(x, y, 4 + 2.2 * (5 - i)); i += 1; );
    ui_cola(c, g); v5_d(x, y, 4);
    ui_cola(ui_mix(c, 0xFFFFFF, 0.6), 0.85 * g); v5_d(x - 1, y - 1.2, 1.6);
  );
);
function k5_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x1A1C1D); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  c0 = ui_mix(0x9EA49A, 0xC6CCBF, 0.44); c1 = 0xC6CCBF; c2 = ui_mix(0x9EA49A, 0xC6CCBF, 0.16);
  k5_grad(x, y, w, h * 0.4, c0, c1); k5_grad(x, y + h * 0.4, w, h * 0.6, c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function k5_arrkey(x, y, w, h, dir) local(cx, cy) (
  v5_keycap(x, y, w, h, 0, 0x3A3E41, 0x4A4F53, v5_cr, "", -1);
  cx = x + w / 2; cy = y + h * 0.42; ui_col(v5_cr);
  dir < 0 ? gfx_triangle((cx - 5.5) * sc, cy * sc, (cx + 3.5) * sc, (cy - 5.5) * sc, (cx + 3.5) * sc, (cy + 5.5) * sc)
          : gfx_triangle((cx + 5.5) * sc, cy * sc, (cx - 3.5) * sc, (cy - 5.5) * sc, (cx - 3.5) * sc, (cy + 5.5) * sc);
);
function k5_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#k5_pm); sel = 0; open = 0;
