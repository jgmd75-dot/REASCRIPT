@gfx 900 400
ui_begin(900, 400);
v5_begin();
KF = 0x2C3450; KB = 0x10141E; KI = 0xE8E6DA; KH = 0x141A2A; KV = 0xFFD060; KA = 0xFFB030; KG = 0xE8C45A;
sc != k5_fsc ? (
  k5_fsc = sc;
