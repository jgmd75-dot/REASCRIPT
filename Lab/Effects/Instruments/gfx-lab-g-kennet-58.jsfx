desc:Kennet 58 [mallet synth] (GFX Lab)
//tags: instrument synth mallet vibraphone marimba glockenspiel celesta modal morph bowed fm pad physical model
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-warmup (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-warmup.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider1:model=0<0,3,1{Vibes,Marimba,Glock,Celesta}>-Instrument
slider2:hard=0.45<0,1,0.001>-Mallet hardness
slider3:strike=0.25<0,1,0.001>-Strike position
slider4:vtone=0.6<0,1,0.001>-Velocity to tone
slider5:decay=1<0.25,4,0.001>-Decay (x)
slider6:reso=0.75<0,1,0.001>-Resonators
slider7:damp=0.6<0,1,0.001>-Damper
slider8:pedal=0<0,1,1{Off,On}>-Pedal (damper off)
slider9:mot_on=1<0,1,1{Off,On}>-Motor
slider10:mot_spd=4.5<1,12,0.01>-Motor speed (Hz)
slider11:mot_dep=0.45<0,1,0.001>-Motor depth
slider12:tune=0<-50,50,0.1>-Fine tune (cents)
slider13:octave=0<-2,2,1>-Bars octave
slider14:spread=0.6<0,1,0.001>-Stereo spread
slider15:drift=50<0,100,1>-Drift (%)
slider16:vol=0<-24,6,0.1>-Volume (dB)
slider17:morph=0<-1,1,0.001>-Morph (harmonic .. metal)
slider18:bow=0<0,1,1{Struck,Bowed}>-Bow
slider19:ltype=0<0,7,1{FM,Pad,Sub,Glow Chime,Glow Organ,Glow Choir,Glow Spectra,Glow Shimmer}>-Layer
slider20:blend=0.55<0,1,0.001>-Layer level
slider21:bloom=0.25<0.005,3,0.001>-Bloom (s)
slider22:fx_mod=0<0,2,1{Off,Chorus,Flanger}>-Mod
slider23:mod_rate=0.6<0.05,8,0.01>-Mod rate (Hz)
slider24:mod_dep=0.5<0,1,0.001>-Mod depth
slider25:mod_fb=0.4<-0.95,0.95,0.001>-Flanger feedback
slider26:mod_mix=0.5<0,1,0.001>-Mod mix
slider27:ffat_amt=0<0,10,0.1>-Ffat
slider28:dl_on=0<0,1,1{Off,On}>-Delay
slider29:dl_div=8<0,11,1{1/32,1/16 T,1/16,1/16 D,1/8 T,1/8,1/8 D,1/4 T,1/4,1/4 D,1/2,1 bar}>-Delay time
slider30:dl_fb=0.35<0,0.9,0.001>-Delay feedback
slider31:dl_mix=0.25<0,1,0.001>-Delay mix
slider32:dl_pp=1<0,1,1{Off,On}>-Delay ping-pong
slider33:rv_on=0<0,1,1{Off,On}>-Reverb
slider34:rv_alg=0<0,2,1{Hall,Room,Plate}>-Reverb type
slider35:rv_dec=2.4<0.3,8,0.01>-Reverb decay (s)
slider36:rv_size=100<50,150,1>-Reverb size (%)
slider37:rv_pre=20<0,200,0.1>-Reverb pre-delay (ms)
slider38:rv_damp=40<0,100,1>-Reverb HF damping (%)
slider39:rv_lc=110<20,660,1>-Reverb low cut (Hz)
slider40:rv_mix=0.25<0,1,0.001>-Reverb mix
slider41:bars_lv=1<0,1,0.001>-Bars level
slider42:layer_oct=0<-2,2,1>-Layer octave
slider43:prs_sel=0<0,19,1{No preset,Init,Pure Vibes,Glass Harmonica,Gamelan Night,Steel Pan,Rosewood Sub,Bowed Vibes,FM Mallets,Dream Vibes,Bell Tower,Music Box,Metal Drone,Log Drum,Crystal Pad,Choir Bars,Micro Chime,Spectral Marimba,Organ Vibes,Bit Shimmer}>-Preset

@init
#ui_man = "gfx-lab-g-kennet-58";
ext_noinit = 1;
gfx_ext_retina = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = max(16, floor(16 * srate / 48000));

NVOX = 16;  VSZ = 104;  M_VOX = 0;
M_BT = 2000;
M_MG = 2200;
M_MG[0] = 1;  M_MG[1] = 1.45;  M_MG[2] = 1.2;  M_MG[3] = 1.4;
M_MD = 2400;
MQ = 4096;  MQMAX = 1000;

V_ON = 0;  V_NOTE = 1;  V_GATE = 2;  V_SUS = 3;  V_AGE = 4;  V_EN = 5;  V_STL = 6;  V_FD = 7;
V_PEND = 8;  V_PVEL = 9;  V_T = 10;  V_TC = 11;  V_XA = 12;  V_NM = 13;  V_GL = 14;  V_GR = 15;
V_DMP = 16;  V_MDL = 17;  V_TT = 18;  V_TG = 19;  V_T0 = 20;  V_NZ = 21;  V_NH = 22;  V_BOW = 23;
V_MO = 24;  MST = 10;
F_RE = 0;  F_IM = 1;  F_C = 2;  F_S = 3;  F_RAT = 4;  F_TM = 5;  F_G = 6;  F_R = 7;  F_BN = 8;
V_LT = 84;  V_LE = 85;  V_P1 = 86;  V_P2 = 87;  V_P3 = 88;  V_LP1 = 89;  V_LP2 = 90;  V_FI = 91;  V_BE = 92;
V_BL = 93;  V_LA = 94;  V_LI = 95;  V_BQ = 96;  V_GM = 97;  V_NW = 98;
D_RAT = 0;  D_G = 4;  D_TM = 8;  D_NM = 12;  D_T0 = 13;  D_EX = 14;  D_TUBG = 15;  D_TUBT = 16;  D_DMP = 17;

memset(M_VOX, 0, NVOX * VSZ);

function md_set(m, r0, r1, r2, r3, g0, g1, g2, g3, t0, t1, t2, t3, nm, d0, ex, tg, tt, dp) local(b) (
  b = M_MD + m * 32;
  b[0] = r0;  b[1] = r1;  b[2] = r2;  b[3] = r3;  b[4] = g0;  b[5] = g1;  b[6] = g2;  b[7] = g3;
  b[8] = t0;  b[9] = t1;  b[10] = t2;  b[11] = t3;
  b[D_NM] = nm;  b[D_T0] = d0;  b[D_EX] = ex;  b[D_TUBG] = tg;  b[D_TUBT] = tt;  b[D_DMP] = dp;
);
md_set(0, 1, 3.98, 9.85, 0,    1, 0.42, 0.16, 0,     1, 0.32, 0.12, 0,    3, 9.0, 0.6, 1.3, 0.45, 1);
md_set(1, 1, 3.92, 9.24, 0,    1.5, 0.9, 0.4, 0,      1, 0.3, 0.12, 0,    3, 1.2, 0.7, 1.4, 0.28, 0);
md_set(2, 1, 2.71, 5.15, 8.43, 1, 0.55, 0.30, 0.15,  1, 0.50, 0.32, 0.2,  4, 9.0, 0.5, 0.15, 0.08, 0);
md_set(3, 1, 2.76, 5.40, 0,    1, 0.16, 0.05, 0,     1, 0.40, 0.20, 0,    3, 4.0, 0.5, 1.0, 0.18, 1);

k = 0;  loop(128, M_BT[k] = rand(2) - 1;  k += 1; );
drf_mot.drift_init(0.8);  drf_pad.drift_init(1.1);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
nz_s = 12345;

function nz_run() ( nz_s = (nz_s * 1103515245 + 12345) % 2147483648;  nz_s / 1073741824 - 1; );
function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);

GP = 8192;  G_SIN = 8320;  G_WRK = 10496;  GT = 16384;  G_TLV = 2049;  G_SET = 7 * 2049;  GV = 160000;  G_PM = 162600;
function gp_clr() ( memset(GP, 0, 64); );
function gp_set(k, a) ( k >= 1 && k <= 64 ? GP[k - 1] = min(max(a, 0), 1); );
function gp_lim(n) ( n < 64 ? memset(GP + n, 0, 64 - n); );
function gp_shape(sh, a, b, g) local(k, v) (
  k = 1;
  loop(64,
    v = sh == 0 ? (k == 1) :
        sh == 3 ? (k & 1) / (k * k) :
        sh == 4 ? ((k & 1) ? 1 / k ^ a : b / k ^ a) :
        sh == 5 ? 1 / k ^ a :
        sh == 6 ? max(exp(-sqr((k - a) / b)), (k == 1) * 0.6) / (1 + k * 0.02) :
        sh == 7 ? (k == 1 ? 1 : k == 2 ? 0.8 : k == 3 ? 0.7 : k == 4 ? 0.55 : k == 6 ? 0.4 : k == 8 ? 0.35 : k == 10 ? 0.15 : k == 12 ? 0.2 : k == 16 ? 0.15 : 0) :
        sh == 8 ? (k == 1 ? 1 : (k & 1) ? 0 : 1 / k ^ a) :
        sh == 9 ? (k == 1 ? 1 : k == 2 ? 0.08 : (k >= a && k <= a + 3) ? 0.32 / (1 + (k - a)) : (k >= a * 2 - 1 && k <= a * 2 + 1) ? 0.12 : 0) : 0;
    GP[k - 1] = min(1, GP[k - 1] + g * max(v, 0));
    k += 1;
  );
);
function gp_build(s) local(k, a, i, lv, pk, base, g, x) (
  memset(G_WRK, 0, 2048);  pk = 0;  k = 1;
  loop(64,
    a = GP[k - 1];
    a > 0.0005 ? ( i = 0;  loop(2048, G_WRK[i] += a * G_SIN[(i * k) & 2047];  i += 1; ); );
    (k & (k - 1)) == 0 ? (
      lv = k == 64 ? 0 : k == 32 ? 1 : k == 16 ? 2 : k == 8 ? 3 : k == 4 ? 4 : k == 2 ? 5 : 6;
      base = GT + s * G_SET + lv * G_TLV;
      i = 0;  loop(2048, base[i] = G_WRK[i];  pk = max(pk, abs(G_WRK[i]));  i += 1; );
    );
    k += 1;
  );
  g = pk > 0.000001 ? 0.98 / pk : 0;
  lv = 0;
  loop(7, base = GT + s * G_SET + lv * G_TLV;  i = 0;  loop(2048, base[i] *= g;  i += 1; );  base[2048] = base[0];  lv += 1; );
  base = GT + s * G_SET;
  i = 0;  loop(256, x = base[i * 8];  GV[s * 256 + i] = floor(x * 127 + 0.5) / 127;  i += 1; );
);
function gp_patch(j, vin, mm, mt, tr) ( G_PM[j * 4] = vin;  G_PM[j * 4 + 1] = mm;  G_PM[j * 4 + 2] = mt;  G_PM[j * 4 + 3] = tr; );
function gp_all() local(i, k, a) (
  i = 0;  loop(2048, G_SIN[i] = sin(2 * $pi * i / 2048);  i += 1; );
  gp_clr();  gp_shape(4, 0.7, 0.12, 1);  gp_lim(16);  gp_build(0);
  gp_clr();  gp_shape(3, 0, 0, 1);  gp_set(2, 0.1);  gp_lim(16);  gp_build(1);
  gp_patch(0, 1, 1, 2.6, 1.1);
  gp_clr();  gp_shape(7, 0, 0, 1);  gp_lim(16);
  k = 1;  loop(32, a = k == 1 ? 1 : (k & 1) ? 0 : 1 / k ^ 1.2;  GP[2 * k - 1] = min(1, GP[2 * k - 1] + 0.45 * a);  k += 1; );
  gp_build(2);  gp_build(3);
  gp_patch(1, 1, 0, 1, 1.5);
  gp_clr();  gp_shape(6, 4, 2.2, 1);  gp_set(12, 0.35);  gp_set(13, 0.3);  gp_build(4);
  gp_clr();  gp_shape(6, 9, 2.5, 1);  gp_set(2, 0.3);  gp_set(18, 0.3);  gp_build(5);
  gp_patch(2, 0, 2, 4.2, 2);
  gp_clr();  gp_shape(6, 7, 5, 1);  gp_shape(5, 1.6, 0, 0.6);  gp_build(6);
  gp_clr();  gp_shape(6, 16, 4, 1);  gp_shape(8, 1.2, 0, 0.6);  gp_build(7);
  gp_patch(3, 0, 2, 6, 2.4);
  gp_clr();  gp_shape(4, 0.8, 0.1, 1);  gp_lim(32);  gp_build(8);
  gp_clr();  gp_shape(9, 12, 0, 1);  gp_lim(32);  gp_build(9);
  gp_patch(4, 1, 2, 0.7, 1.3);
);
!gp_done ? ( gp_all();  gp_done = 1; );

function v_coef(b, snap) local(f0, dmp, en, i, mb, w, t60, rt, r, h) (
  f0 = 440 * 2 ^ ((b[V_NOTE] + oct_s * 12 - 69 + bend_s + (cents + M_BT[b[V_NOTE]] * 4 * dm_a) * 0.01) / 12);
  dmp = b[V_DMP] && !b[V_GATE] && !b[V_SUS] && !ped_on && !sustain;
  en = 0;  i = 0;
  loop(5,
    mb = b + V_MO + i * MST;
    i < b[V_NM] || (i == 4 && morph_s > 0) ? (
      r = mb[F_RAT];
      i == 4 ? r = 1 + 0.015 * max(0, morph_s) :
      morph_s < 0 ? ( h = i + 1;  r += (h - r) * (-morph_s); ) :
      r = r ^ (1 + 0.5 * morph_s);
      w = 2 * $pi * f0 * r / srate;
      w < 0.9 * $pi ? (
        t60 = b[V_T0] * mb[F_TM] * dec_s;
        dmp ? t60 = min(t60, dmp_t60 * (i == 0 || i == 4 ? 1 : 0.6));
        rt = exp(-6.907755 / (t60 * srate));
        snap ? mb[F_R] = rt : mb[F_R] += (rt - mb[F_R]) * kr;
        mb[F_C] = mb[F_R] * cos(w);  mb[F_S] = mb[F_R] * sin(w);
        mb[F_BN] = sqrt(1 - mb[F_R] * mb[F_R]);
      ) : ( mb[F_C] = mb[F_S] = mb[F_RE] = mb[F_IM] = 0; );
      en += abs(mb[F_RE]) + abs(mb[F_IM]);
    );
    i += 1;
  );
  mb = b + V_MO + 5 * MST;
  w = 2 * $pi * f0 * 1.004 / srate;
  w < 0.9 * $pi ? (
    mb[F_R] = exp(-6.907755 / (b[V_TT] * srate));
    mb[F_C] = mb[F_R] * cos(w);  mb[F_S] = mb[F_R] * sin(w);  mb[F_G] = 2 * (1 - mb[F_R]);
  ) : ( mb[F_C] = mb[F_S] = mb[F_RE] = mb[F_IM] = mb[F_G] = 0; );
  en += (abs(mb[F_RE]) + abs(mb[F_IM])) * b[V_TG];
  b[V_EN] = en;
  f0 *= 2 ^ (loct_s - oct_s);
  b[V_LI] = f0 / srate;
  b[V_LT] == 1 ? b[V_FI] = 1 - exp(-2 * $pi * min(f0 * 5, 9000) / srate);
  b[V_LT] >= 3 ? (
    h = 0.45 * srate / max(f0, 1);
    i = h >= 64 ? 0 : h >= 32 ? 1 : h >= 16 ? 2 : h >= 8 ? 3 : h >= 4 ? 4 : h >= 2 ? 5 : 6;
    mb = (b[V_LT] - 3) * 4;
    b[V_FI] = GT + 2 * (b[V_LT] - 3) * G_SET + i * G_TLV;
    !snap ? b[V_P2] += b[V_P3] * CR / srate;
    r = G_PM[mb + 1] == 1 ? ( t60 = min(b[V_P2], 1);  1 - (1 - t60) * (1 - t60); ) :
        G_PM[mb + 1] == 2 ? 0.5 - 0.5 * cos($pi * b[V_P2]) : 0;
    G_PM[mb] ? r = floor(r * 32 + 0.5) / 32;
    b[V_GM] = r;
  );
  b[V_LT] == 0 ? (
    w = 2 * $pi * min(f0 * 3.5, 0.45 * srate) / srate;  b[V_LP1] = cos(w);  b[V_LP2] = sin(w);
    r = sqrt(sqr(b[V_P2]) + sqr(b[V_P3]));  r > 0.000001 ? ( b[V_P2] /= r;  b[V_P3] /= r; ) : ( b[V_P2] = 1;  b[V_P3] = 0; );
  );
);
function v_hit(b, vel) local(v, hd, st, f0, tc, d, mb) (
  v = vel / 127;
  d = M_MD + b[V_MDL] * 32;
  hd = max(0, min(1, hard + (rand(1) - 0.5) * 0.12 * dm_a));
  st = max(0, min(1, strike + (rand(1) - 0.5) * 0.16 * dm_a));
  f0 = 440 * 2 ^ ((b[V_NOTE] + oct_s * 12 - 69) / 12);
  tc = 0.0035 * 0.07 ^ hd;
  tc *= 2 ^ (-vtone * (v - 0.6) * 1.6);
  tc = min(tc, 0.6 / f0);
  b[V_TC] = max(2, tc * srate);  b[V_T] = b[V_BOW] ? b[V_TC] : 0;
  b[V_XA] = 0.06 + 0.94 * v ^ 1.6;
  b[V_LA] = b[V_XA];
  b[V_NZ] = hd * hd * hd * 0.5;
  b[V_LT] == 0 ? b[V_FI] = 0.8 + 2.2 * hd * (0.4 + 0.6 * v);
  mb = b + V_MO;
  mb[F_G] = d[D_G] * (1 - 0.25 * st);
  mb[MST + F_G] = d[D_G + 1] * (0.3 + 1.6 * st);
  mb[2 * MST + F_G] = d[D_G + 2] * (1 + 0.5 * (1 - st));
  mb[3 * MST + F_G] = d[D_G + 3] * (0.5 + st);
  mb[4 * MST + F_G] = d[D_G] * 0.8;
  b[V_LE] < 0.05 ? nw_start(b + V_NW);
  b[V_GATE] = 1;  b[V_SUS] = 0;  b[V_BQ] = 0;
);
function v_start(b, n, vel) local(m, d, f0, i, mb) (
  b[V_ON] = 1;  b[V_NOTE] = n;  b[V_GATE] = 1;  b[V_SUS] = 0;  b[V_STL] = 0;  b[V_FD] = 1;
  age_n += 1;  b[V_AGE] = age_n;
  m = floor(model + 0.5);  m = max(0, min(3, m));  d = M_MD + m * 32;
  b[V_MDL] = m;  b[V_NM] = d[D_NM];  b[V_TG] = d[D_TUBG];  b[V_TT] = d[D_TUBT];  b[V_DMP] = d[D_DMP];
  b[V_BOW] = bow >= 0.5;  b[V_BE] = 0;  b[V_BL] = 0;
  b[V_LT] = max(0, min(7, floor(ltype + 0.5)));  b[V_LE] = 0;  b[V_LP1] = b[V_LP2] = 0;
  b[V_P1] = 0;  b[V_P2] = 0;  b[V_P3] = rand(1);  b[V_GM] = 0;
  b[V_LT] >= 3 ? b[V_P3] = (1 + (rand(1) - 0.5) * 0.3 * dm_a) / G_PM[(b[V_LT] - 3) * 4 + 2];
  i = 0;
  loop(6,
    mb = b + V_MO + i * MST;
    mb[F_RE] = mb[F_IM] = 0;  mb[F_R] = 0;  mb[F_G] = 0;
    i < 4 ? ( mb[F_RAT] = d[D_RAT + i];  mb[F_TM] = d[D_TM + i]; ) : ( mb[F_RAT] = 1;  mb[F_TM] = 1; );
    i += 1;
  );
  f0 = 440 * 2 ^ ((n + oct_s * 12 - 69) / 12);
  b[V_T0] = max(0.08, min(40, d[D_T0] * (262 / f0) ^ d[D_EX]));
  v_hit(b, vel);
  v_coef(b, 1);
);
function key_on(n, vel) local(k, b, best, bq, q, hit) (
  hit = -1;  best = -1;  bq = 1000000000;  k = 0;
  loop(NVOX,
    b = M_VOX + k * VSZ;
    b[V_ON] && !b[V_STL] && b[V_NOTE] == n && b[V_MDL] == floor(model + 0.5) && b[V_BOW] == (bow >= 0.5)
      && b[V_LT] == floor(ltype + 0.5) ? hit = k;
    q = !b[V_ON] ? -1 : (!b[V_GATE] && !b[V_SUS]) ? b[V_EN] + b[V_LE] * b[V_LA] : 1000 + b[V_AGE];
    q < bq ? ( bq = q;  best = k; );
    k += 1;
  );
  hit >= 0 ? v_hit(M_VOX + hit * VSZ, vel) : (
    b = M_VOX + best * VSZ;
    b[V_ON] ? (
      b[V_STL] = 1;  b[V_PEND] = n;  b[V_PVEL] = vel;  b[V_GATE] = 0;  b[V_SUS] = 0;
    ) : v_start(b, n, vel);
  );
);
function key_off(n) local(k, b) (
  k = 0;
  loop(NVOX,
    b = M_VOX + k * VSZ;
    b[V_ON] && b[V_GATE] && b[V_NOTE] == n ? ( b[V_GATE] = 0;  sustain ? b[V_SUS] = 1; );
    b[V_STL] && b[V_PEND] == n ? b[V_PEND] = -1 - b[V_PEND];
    k += 1;
  );
);
function pedal_up() local(k, b) ( k = 0;  loop(NVOX, b = M_VOX + k * VSZ;  b[V_SUS] = 0;  k += 1; ); );
function all_off() local(k, b) (
  k = 0;  loop(NVOX, b = M_VOX + k * VSZ;  b[V_GATE] = 0;  b[V_SUS] = 0;  k += 1; );
  sustain = 0;
);
function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? key_on(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? key_off(d1) :
  st == 0xE0 ? bend_t = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 1 ? mw = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? all_off();
  );
);

FXM = 200000;  fx_next = FXM;
function fx_alloc(n) local(p) ( p = fx_next;  fx_next += n;  memset(p, 0, n);  p; );
function dp_p2(n) local(p) ( p = 1;  while (p < n) ( p *= 2; );  p; );
function dp_hash(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453;  v - floor(v); );

function fx_mem() (
  fx_next = FXM;
  ch_sz = dp_p2(0.03 * srate);  ch_m = ch_sz - 1;  ch_b = fx_alloc(2 * ch_sz);
  dg_sz = dp_p2(3.1 * srate);   dg_m = dg_sz - 1;  dg_b = fx_alloc(2 * dg_sz);
  dp_bsz = dp_p2(0.2 * srate);   dp_bm = dp_bsz - 1;
  dp_asz = dp_p2(0.034 * srate); dp_am = dp_asz - 1;
  dp_psz = dp_p2(0.21 * srate);  dp_pm = dp_psz - 1;
  dp_tsz = dp_p2(0.13 * srate);  dp_tm = dp_tsz - 1;
  dp_lb = fx_alloc(8 * dp_bsz);  dp_ab = fx_alloc(8 * dp_asz);  dp_db = fx_alloc(8 * dp_asz);
  dp_tb = fx_alloc(2 * dp_tsz);  dp_tank1 = fx_next;  dp_pb = fx_alloc(2 * dp_psz);
  dp_len = fx_alloc(16);  dp_ln = fx_alloc(16);  dp_lf = fx_alloc(16);  dp_apl = fx_alloc(16);  dp_kl = fx_alloc(16);
  dp_ja = fx_alloc(16);  dp_jb = fx_alloc(16);  dp_tfl = fx_alloc(16);  dp_tfr = fx_alloc(16);  dp_tql = fx_alloc(16);
  dp_tqr = fx_alloc(16);  dp_sgl = fx_alloc(16);  dp_sgr = fx_alloc(16);  dp_is = fx_alloc(16);  dp_dln = fx_alloc(8);
  dp_dbl = fx_alloc(8);  dp_etl = fx_alloc(16);  dp_etr = fx_alloc(16);  dp_egl = fx_alloc(16);  dp_egr = fx_alloc(16);
  dp_efl = fx_alloc(16);  dp_efr = fx_alloc(16);
);

function dp_tables() local(i, f) (
  i = 0;
  loop(16,
    dp_len[i] = i == 0 ? 17.3 : i == 1 ? 22.7 : i == 2 ? 26.9 : i == 3 ? 31.7 : i == 4 ? 35.9 : i == 5 ? 40.1 : i == 6 ? 46.1 : 52.7;
    f = i * 0.6180339 + 0.13 - floor(i * 0.6180339 + 0.13);  dp_tfl[i] = 0.06 + 0.9 * f;
    f = i * 0.3819661 + 0.71 - floor(i * 0.3819661 + 0.71);  dp_tfr[i] = 0.06 + 0.9 * f;
    dp_sgl[i] = (i == 1 || i == 2 || i == 6 || i == 9 || i == 11 || i == 12 || i == 13 || i == 15) ? -1 : 1;
    dp_sgr[i] = (i == 0 || i == 3 || i == 4 || i == 6 || i == 10 || i == 11 || i == 13 || i == 14) ? -1 : 1;
    dp_is[i] = (i == 2 || i == 3 || i == 6 || i == 7 || i == 9 || i == 12 || i == 13 || i == 14) ? -1 : 1;
    dp_efl[i] = min(max(((i + 0.55 + 0.38 * (dp_hash(i + 3) - 0.5)) / 16) ^ 1.12, 0.01), 1);
    dp_efr[i] = min(max(((i + 0.45 + 0.38 * (dp_hash(i + 41) - 0.5)) / 16) ^ 1.12, 0.01), 1);
    dp_egl[i] = (dp_hash(i + 7) < 0.5 ? -1 : 1) * (1 - 0.55 * dp_efl[i]) * (i & 1 ? 0.75 : 1);
    dp_egr[i] = (dp_hash(i + 77) < 0.5 ? -1 : 1) * (1 - 0.55 * dp_efr[i]) * (i & 1 ? 1 : 0.75);
    i += 1;
  );
  i = 0;
  loop(8, dp_dbl[i] = i == 0 ? 1.13 : i == 1 ? 1.71 : i == 2 ? 2.93 : i == 3 ? 4.31 : i == 4 ? 1.29 : i == 5 ? 1.93 : i == 6 ? 3.17 : 4.67;  i += 1; );
);
function dp_setup(k) local(i, s, ap) (
  dp_lsc = k == 0 ? 1.9 : k == 1 ? 0.72 : 1.15;
  dp_erl = k == 0 ? 0.45 : k == 1 ? 0.8 : 0;
  dp_ers = k == 0 ? 0.075 : k == 1 ? 0.034 : 0.1;
  dp_c0 = k == 2 ? -0.32 : 0;
  dp_thf = k == 0 ? 7 : k == 1 ? 5 : 10;
  dp_lomul = k == 0 ? 1.15 : k == 1 ? 1.0 : 0.92;
  dp_apg = k == 0 ? 0.62 : k == 1 ? 0.58 : 0.66;
  dp_wg = k == 1 ? 0.75 : k == 2 ? 1.12 : 1;
  dp_chi = 1 - exp(-2 * $pi * 3500 / srate);
  dp_clo = 1 - exp(-2 * $pi * 300 / srate);
  i = 0;
  loop(8,
    s = sqrt(dp_lsc);
    ap = i == 0 ? 3.1 : i == 1 ? 5.3 : i == 2 ? 2.7 : i == 3 ? 4.9 : i == 4 ? 2.3 : i == 5 ? 4.1 : i == 6 ? 6.7 : 3.9;
    dp_apl[i] = floor(ap * s * 0.001 * srate) | 1;
    i += 1;
  );
);
function dp_lclr() instance(lo, y, d1x, d1y, d2x, d2y, o) ( lo = y = d1x = d1y = d2x = d2y = o = 0; );
function dp_clear() (
  memset(dp_lb, 0, dp_tank1 - dp_lb);  memset(dp_pb, 0, 2 * dp_psz);
  dpL0.dp_lclr(); dpL1.dp_lclr(); dpL2.dp_lclr(); dpL3.dp_lclr(); dpL4.dp_lclr(); dpL5.dp_lclr(); dpL6.dp_lclr(); dpL7.dp_lclr();
  dp_lc1l = dp_lc1r = dp_lc2l = dp_lc2r = 0;
);
function dp_dap(x) instance(b, ln) local(y) ( y = b[(dp_aw - ln) & dp_am] - 0.7 * x;  b[dp_aw] = x + 0.7 * y;  y; );
function dp_diff(x, k0) (
  k0 ? dpD7.dp_dap(dpD6.dp_dap(dpD5.dp_dap(dpD4.dp_dap(x)))) : dpD3.dp_dap(dpD2.dp_dap(dpD1.dp_dap(dpD0.dp_dap(x))));
);
function dp_line() instance(bb, ln, lf, tql, tqr, sgl, sgr, lo, y, kl, ja, jb, o) local(n, v) (
  n = dp_w - ln;
  v = bb[n & dp_bm];  v += (bb[(n - 1) & dp_bm] - v) * lf;
  dp_tl += sgl * bb[(dp_w - tql) & dp_bm];
  dp_tr += sgr * bb[(dp_w - tqr) & dp_bm];
  lo += (v - lo) * dp_clo;
  v += kl * lo;
  y += (v - y) * dp_chi;
  o = jb * (v + ja * (v - y));
);
function dp_ap(odd) instance(o, is, ab, apl, d1x, d1y, d2x, d2y, bb) local(u, v, g, yy) (
  u = o * 0.35355 + is * (odd ? dp_dbx : dp_dax);
  v = ab[(dp_aw - apl) & dp_am];
  g = odd ? -dp_apg : dp_apg;
  yy = v - g * u;  ab[dp_aw] = u + g * yy;
  dp_c0 != 0 ? (
    u = dp_c0 * yy + d1x - dp_c0 * d1y;  d1x = yy;  d1y = u;
    yy = dp_c0 * u + d2x - dp_c0 * d2y;  d2x = u;  d2y = yy;
  );
  bb[dp_w] = min(max(yy + dp_dn, -4), 4);
);
function dp_lsync(i) instance(bb, ln, lf, tql, tqr, sgl, sgr, kl, ja, jb, is, ab, apl) (
  bb = dp_lb + i * dp_bsz;  ab = dp_ab + i * dp_asz;
  ln = dp_ln[i];  lf = dp_lf[i];  tql = dp_tql[i];  tqr = dp_tqr[i];  sgl = dp_sgl[i];  sgr = dp_sgr[i];
  kl = dp_kl[i];  ja = dp_ja[i];  jb = dp_jb[i];  is = dp_is[i];  apl = dp_apl[i];
);
function dp_etap() instance(tpl, tpr, gl, gr) (
  dp_el += gl * dp_tb[(dp_tw - tpl) & dp_tm];
  dp_er += gr * dp_tb[dp_tsz + ((dp_tw - tpr) & dp_tm)];
);
function dp_esync(i) instance(tpl, tpr, gl, gr) ( tpl = dp_etl[i];  tpr = dp_etr[i];  gl = dp_egl[i];  gr = dp_egr[i]; );
function dp_dsync(i) instance(b, ln) ( b = dp_db + i * dp_asz;  ln = dp_dln[i]; );
function dp_sync() (
  dpL0.dp_lsync(0); dpL1.dp_lsync(1); dpL2.dp_lsync(2); dpL3.dp_lsync(3); dpL4.dp_lsync(4); dpL5.dp_lsync(5);
  dpL6.dp_lsync(6); dpL7.dp_lsync(7);
  dpR0.dp_esync(0); dpR1.dp_esync(1); dpR2.dp_esync(2); dpR3.dp_esync(3); dpR4.dp_esync(4); dpR5.dp_esync(5);
  dpR6.dp_esync(6); dpR7.dp_esync(7); dpR8.dp_esync(8); dpR9.dp_esync(9); dpR10.dp_esync(10); dpR11.dp_esync(11);
  dpD0.dp_dsync(0); dpD1.dp_dsync(1); dpD2.dp_dsync(2); dpD3.dp_dsync(3);
  dpD4.dp_dsync(4); dpD5.dp_dsync(5); dpD6.dp_dsync(6); dpD7.dp_dsync(7);
);
function dp_ctl() local(i, rt, rtl, rth, rL, gl, gm, gh, d, sz, s2) (
  dp_ts += (dp_tt - dp_ts) * dp_tk;
  dp_szs += (dp_szt - dp_szs) * dp_tk;
  rt = dp_ts;  rtl = rt * dp_lomul;
  rth = 1 / (1 / (rt * dp_dmp) + 1 / dp_thf);
  sz = dp_lsc * dp_szs * 0.001 * srate;
  i = 0;
  loop(8,
    d = max(dp_len[i] * sz, 8);
    dp_ln[i] = floor(d);  dp_lf[i] = d - dp_ln[i];
    dp_tql[i] = max(floor(d * dp_tfl[i]), 1);  dp_tqr[i] = max(floor(d * dp_tfr[i]), 1);
    rL = (d + dp_apl[i]) * -6.9077553 / srate;
    gl = exp(rL / rtl);  gm = exp(rL / rt);  gh = exp(rL / rth);
    dp_kl[i] = gl / gm - 1;  dp_ja[i] = gh / gm - 1;  dp_jb[i] = gm;
    i += 1;
  );
  s2 = dp_szs * 0.001 * srate;
  i = 0;  loop(8, dp_dln[i] = max(floor(dp_dbl[i] * s2), 1);  i += 1; );
  d = dp_ers * dp_szs;
  i = 0;  loop(16, dp_etl[i] = min(max(floor(dp_efl[i] * d * srate), 1), dp_tm);  dp_etr[i] = min(max(floor(dp_efr[i] * d * srate), 1), dp_tm);  i += 1; );
  dp_wgs = dp_wg * (2.4 / max(dp_ts, 0.2)) ^ 0.15;
  dp_sync();
);

function ch_rd(base, d) local(p, i, f) (
  p = ch_w - d;  i = floor(p);  f = p - i;
  base[i & ch_m] + (base[(i + 1) & ch_m] - base[i & ch_m]) * f;
);
function dg_beats(i) (
  i == 0 ? 0.125 : i == 1 ? 1 / 6 : i == 2 ? 0.25 : i == 3 ? 0.375 : i == 4 ? 1 / 3 : i == 5 ? 0.5 : i == 6 ? 0.75 :
  i == 7 ? 2 / 3 : i == 8 ? 1 : i == 9 ? 1.5 : i == 10 ? 2 : 4;
);
function fx_rate() (
  fx_mem();  dp_tables();  dp_setup(dp_key);  dp_clear();
  fx_sw = 1 - exp(-1 / (0.005 * srate));
  fx_tf = 1 / (0.006 * srate);
  ff_att = 1 - exp(-1 / (0.003 * srate));  ff_rel = 1 - exp(-1 / (0.09 * srate));
  dp_tk = 1 - exp(-32 / (0.15 * srate));
  dg_lpc = 1 - exp(-2 * $pi * 9000 / srate);  dg_hpc = 1 - exp(-2 * $pi * 60 / srate);
  dp_dcc = 1 - 2 * $pi * 5 / srate;
  ch_w = 0;  dg_w = 0;  dp_w = 0;  dp_aw = 0;  dp_tw = 0;  dp_pw = 0;  dp_cc = 0;
);
dp_key = 0;  dp_dn = 0.000000000000001;  dp_wq = 32768;

function update_params() (
  drift_macro(drift);
  dec_t = decay;
  res_t = reso;
  dmp_t60 = 1.2 * 0.035 ^ damp;
  mot_tr = mot_on >= 0.5 ? mot_spd : 0;
  mdep_t = mot_on >= 0.5 ? mot_dep : 0;
  tune_t = tune;
  oct_s = floor(octave + 0.5);  loct_s = floor(layer_oct + 0.5);
  sp_t = spread;
  outg_t = 10 ^ (vol / 20);
  ped_on = pedal >= 0.5;
  morph_t = morph;
  blend_t = blend;  bars_t = bars_lv;
  k_blm = 1 - exp(-1 / (max(0.005, bloom) * srate));
  ch_tt = floor(fx_mod + 0.5);
  ch_inc = mod_rate / srate;
  ch_dept = mod_dep;  ch_mxt = mod_mix;  ch_fbt = mod_fb;
  ff_t = ffat_amt;
  dg_t = dl_on >= 0.5;  dg_pp = dl_pp >= 0.5;
  dg_dt = min(dg_beats(floor(dl_div + 0.5)) * 60 / max(tempo, 20), 3) * srate;
  dg_fbt = dl_fb;  dg_mxt = dl_mix;
  rv_t = rv_on >= 0.5;  dp_ktar = max(0, min(2, floor(rv_alg + 0.5)));
  dp_tt = rv_dec;  dp_szt = rv_size * 0.01 * 1;  dp_szt = max(0.5, min(1.5, dp_szt));
  dp_pret = rv_pre * 0.001 * srate;
  dp_dmp = 1 - 0.85 * rv_damp * 0.01;
  dp_lcc = 1 - exp(-2 * $pi * rv_lc / srate);
  dp_mxt = rv_mix;
);

function sl_auto_au(idx) ( slider_automate(2 ^ (idx - 1)); );
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 0); pv(2, 0.45); pv(3, 0.25); pv(4, 0.6); pv(5, 1); pv(6, 0.75); pv(7, 0.6); pv(8, 0);
  pv(9, 1); pv(10, 4.5); pv(11, 0.45); pv(12, 0); pv(13, 0); pv(42, 0); pv(14, 0.6); pv(15, 50); pv(16, 0);
  pv(17, 0); pv(18, 0); pv(19, 0); pv(20, 0.55); pv(41, 1); pv(21, 0.25);
  pv(22, 0); pv(23, 0.6); pv(24, 0.5); pv(25, 0.4); pv(26, 0.5); pv(27, 0); pv(28, 0); pv(29, 8); pv(30, 0.35); pv(31, 0.25);
  pv(32, 1); pv(33, 0); pv(34, 0); pv(35, 2.4); pv(36, 100); pv(37, 20); pv(38, 40); pv(39, 110); pv(40, 0.25);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (
    pv(2, 0.3); pv(3, 0.2); pv(5, 1.3); pv(10, 3.2); pv(11, 0.6); pv(20, 0.0); pv(41, 1.0);
  ) :
  p == 3 ? (
    pv(1, 3); pv(5, 1.6); pv(8, 1); pv(9, 0); pv(17, -0.5); pv(18, 1); pv(19, 1); pv(20, 0.5); pv(41, 0.87); pv(21, 1.2); pv(16, -4); pv(33, 1); pv(34, 2); pv(35, 3.2); pv(40, 0.28);
  ) :
  p == 4 ? (
    pv(2, 0.55); pv(5, 1.4); pv(9, 0); pv(17, 0.75); pv(19, 2); pv(20, 0.55); pv(41, 0.84); pv(21, 0.05); pv(8, 1); pv(16, -2.5); pv(33, 1); pv(34, 0); pv(35, 3.5); pv(37, 40); pv(40, 0.3);
  ) :
  p == 5 ? (
    pv(1, 1); pv(2, 0.6); pv(5, 1.8); pv(9, 0); pv(17, -0.8); pv(19, 0); pv(20, 0.45); pv(41, 0.89); pv(21, 0.01); pv(28, 1); pv(29, 7); pv(30, 0.25); pv(31, 0.18);
  ) :
  p == 6 ? (
    pv(1, 1); pv(2, 0.4); pv(6, 0.85); pv(9, 0); pv(19, 2); pv(20, 0.67); pv(41, 0.74); pv(21, 0.03);
  ) :
  p == 7 ? (
    pv(10, 2.6); pv(11, 0.7); pv(18, 1); pv(19, 1); pv(20, 0.55); pv(41, 0.84); pv(21, 0.8); pv(16, -3);
  ) :
  p == 8 ? (
    pv(2, 0.7); pv(4, 0.8); pv(9, 0); pv(19, 0); pv(20, 0.74); pv(41, 0.67); pv(21, 0.01); pv(16, -1); pv(27, 3); pv(33, 1); pv(34, 1); pv(35, 1.1); pv(40, 0.2);
  ) :
  p == 9 ? (
    pv(2, 0.2); pv(5, 1.6); pv(8, 1); pv(10, 2.4); pv(11, 0.8); pv(14, 0.85); pv(19, 1); pv(20, 0.63); pv(41, 0.77); pv(21, 1.5); pv(22, 1); pv(23, 0.4); pv(24, 0.6); pv(26, 0.45); pv(33, 1); pv(35, 4); pv(40, 0.3);
  ) :
  p == 10 ? (
    pv(1, 2); pv(2, 0.6); pv(5, 2); pv(9, 0); pv(13, -1); pv(42, -1); pv(17, 0.6); pv(19, 0); pv(20, 0.55); pv(41, 0.84); pv(21, 0.1); pv(16, -3); pv(33, 1); pv(35, 6); pv(36, 140); pv(37, 60); pv(40, 0.32);
  ) :
  p == 11 ? (
    pv(1, 3); pv(2, 0.7); pv(3, 0.6); pv(5, 0.6); pv(6, 0.4); pv(9, 0); pv(13, 1); pv(42, 1); pv(20, 0.39); pv(41, 0.92); pv(21, 0.01); pv(28, 1); pv(29, 9); pv(30, 0.3); pv(31, 0.22);
  ) :
  p == 12 ? (
    pv(1, 2); pv(5, 2.5); pv(8, 1); pv(9, 1); pv(10, 1.6); pv(11, 0.5); pv(13, -1); pv(42, -1); pv(17, 1); pv(18, 1); pv(19, 1); pv(20, 0.59); pv(41, 0.81); pv(21, 2); pv(16, -4);
  ) :
  p == 13 ? (
    pv(1, 1); pv(2, 0.25); pv(3, 0.5); pv(5, 0.35); pv(6, 1); pv(9, 0); pv(13, -1); pv(42, -1); pv(17, -0.3); pv(20, 0.0); pv(41, 1.0); pv(27, 4);
  ) :
  p == 14 ? (
    pv(1, 3); pv(2, 0.35); pv(5, 1.5); pv(8, 1); pv(10, 3.5); pv(11, 0.6); pv(17, -1); pv(19, 1); pv(20, 0.84); pv(41, 0.55); pv(21, 1); pv(16, -0.5); pv(22, 1); pv(23, 0.3); pv(24, 0.7); pv(26, 0.5); pv(33, 1); pv(34, 2); pv(35, 4.5); pv(40, 0.3);
  ) :
  p == 15 ? (
    pv(2, 0.3); pv(5, 1.4); pv(10, 2.8); pv(11, 0.55); pv(19, 5); pv(20, 0.67); pv(41, 0.74); pv(21, 0.9); pv(16, 0.5);
  ) :
  p == 16 ? (
    pv(1, 2); pv(2, 0.65); pv(5, 1.2); pv(9, 0); pv(19, 3); pv(20, 0.63); pv(41, 0.77); pv(21, 0.005); pv(16, -3);
  ) :
  p == 17 ? (
    pv(1, 1); pv(2, 0.4); pv(5, 1.5); pv(9, 0); pv(14, 0.8); pv(19, 6); pv(20, 0.63); pv(41, 0.77); pv(21, 1.2); pv(16, 2); pv(28, 1); pv(29, 6); pv(30, 0.3); pv(31, 0.2);
  ) :
  p == 18 ? (
    pv(2, 0.5); pv(10, 6.5); pv(11, 0.5); pv(19, 4); pv(20, 0.59); pv(41, 0.81); pv(21, 0.04); pv(16, -1);
  ) :
  p == 19 ? (
    pv(1, 3); pv(2, 0.55); pv(5, 1.3); pv(9, 0); pv(17, 0.4); pv(19, 7); pv(20, 0.55); pv(41, 0.84); pv(21, 0.02); pv(16, -2); pv(22, 2); pv(23, 0.15); pv(24, 0.5); pv(25, 0.5); pv(26, 0.4); pv(33, 1); pv(34, 2); pv(40, 0.25);
  ) : 0;
  i = 1;  loop(42, sl_auto_au(i);  i += 1; );
  prm_dirty = 1;
);

PR_N = 19;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(42, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  load_preset(k);
    k <= PR_N ? ( prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel;  prs_sel > 0 && prs_hs ? ( load_preset(prs_sel);  prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0;  prs_ok = 1; );
);
prs_ok = 0;  prs_dirty = 0;

function rate_setup() (
  smk = 1 - exp(-1 / (0.03 * srate));
  kr = 1 - exp(-CR / (0.012 * srate));
  kt = 1 - exp(-CR / (0.03 * srate));
  k_mor = 1 - exp(-CR / (0.08 * srate));
  k_up = 1 - exp(-CR / (0.7 * srate));
  k_dn = 1 - exp(-CR / (2.0 * srate));
  k_dep = 1 - exp(-CR / (0.25 * srate));
  k_bwr = 1 - exp(-1 / (0.15 * srate));
  k_fmi = 1 - exp(-1 / (0.6 * srate));
  fd_k = 1 / (0.003 * srate);
  dac_inc = 31250 / srate;
  dc_r = 1 - 2 * $pi * 5 / srate;
  e_off = 0.000003;
);

rate_setup();
fx_rate();
update_params();
dp_ts = dp_tt;  dp_szs = dp_szt;  dp_pre = dp_pret;  dg_d = dg_dt;
mw = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  bend_t = 0;  bend_s = 0;
cents = 0;  mph = 0;  mot_r = 0;  mdep_s = 0;  md_v = 0;  md_d = 0;
k_lrel = 0.0001;  dec_s = dec_t;  res_s = res_t;  tune_s = tune_t;  sp_s = sp_t;  out_g = outg_t;  morph_s = morph_t;  blend_s = blend_t;  bars_s = bars_t;

pwr_init();  pwr_sag = 0.15;  pwr_wu_loss = 0.3;  pwr_wu_drv = 0;  pwr_wu_lp = 12000;  pwr_wu_wob = 0.1;  pwr_bloom = 0;
pwr_hum_db = -83;

@slider
prs_chk();
update_params();

@block
prs_chk();
pwr_block(1);
wu_c = (1 - pwr_gm) * (6 + 2 * pwr_w1);
prm_dirty ? ( prm_dirty = 0;  update_params(); );
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? all_off();  tp_was = tp_now;
mot_dv = drf_mot.drift_tick(samplesblock / srate * 0.2 * dm_s);
pad_dv = drf_pad.drift_tick(samplesblock / srate * 0.3 * dm_s);
pad_dt = 0.004 * (1 + 0.5 * dm_a * pad_dv);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = 0;
dg_dt = min(dg_beats(floor(dl_div + 0.5)) * 60 / max(tempo, 20), 3) * srate;
ffgr_d = max(ffgr_d, ffgr_pk);  ffgr_pk = 0;
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
mph_disp = mph;  mot_disp = mot_r;  mdep_disp = mdep_s;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  dec_s += (dec_t - dec_s) * kt;  res_s += (res_t - res_s) * kt;  tune_s += (tune_t - tune_s) * kt;
  sp_s += (sp_t - sp_s) * kt;  bend_s += (bend_t - bend_s) * kt;  morph_s += (morph_t - morph_s) * k_mor;
  k_lrel = 1 - exp(-1 / ((0.25 + 0.35 * dec_s) * srate));
  t = mot_tr * (1 + 0.04 * dm_a * mot_dv) * (0.97 + 0.03 * pwr_rail);
  mot_r += (t - mot_r) * (t > mot_r ? k_up : k_dn);
  t = min(1, mdep_t + (mot_tr > 0) * mw * 0.6);
  mdep_s += (t - mdep_s) * (t < mdep_s && mot_tr == 0 ? k_dn : k_dep);
  mph += mot_r * CR / srate;  mph -= floor(mph);
  t = 0.5 - 0.5 * cos(2 * $pi * mph);  t = t * t * (3 - 2 * t);
  md_d = (t * mdep_s - md_v) / CR;
  cents = tune_s + wu_c;
  k = 0;
  loop(NVOX,
    kb = M_VOX + k * VSZ;
    kb[V_ON] ? (
      v_coef(kb, 0);
      t = (kb[V_NOTE] - 72) / 24 * sp_s;  t = max(-1, min(1, t));
      kb[V_GL] = sqrt(0.5 * (1 - t));  kb[V_GR] = sqrt(0.5 * (1 + t));
      kb[V_BQ] = kb[V_T] >= kb[V_TC] && kb[V_EN] < e_off * kb[V_XA] && !(kb[V_BOW] && (kb[V_GATE] || kb[V_SUS] || kb[V_BE] > 0.0001));
      !kb[V_STL] && kb[V_T] >= kb[V_TC] && kb[V_EN] < e_off * kb[V_XA] && kb[V_LE] < 0.0003 && kb[V_BE] < 0.0001
        && !(kb[V_GATE] && (kb[V_BOW] || blend_s > 0.001)) ? kb[V_ON] = 0;
    );
    k += 1;
  );
);
cr_n -= 1;

out_g += (outg_t - out_g) * smk;
blend_s += (blend_t - blend_s) * smk;  bars_s += (bars_t - bars_s) * smk;
md_v += md_d;

dl = dr = tl = tr = ll = lr = 0;
tw = max(0, morph_s);
kb = M_VOX;  k = 0;
loop(NVOX,
  kb[V_ON] ? (
    held = kb[V_GATE] || kb[V_SUS];
    x = 0;  xn = 0;  xb = 0;
    kb[V_T] < kb[V_TC] ? (
      t = sin($pi * kb[V_T] / kb[V_TC]);  t *= t;
      x = kb[V_XA] * t * 2 / kb[V_TC];
      kb[V_NZ] > 0 ? ( t2 = nz_run();  xn = (t2 - kb[V_NH]) * kb[V_NZ] * kb[V_XA] * t;  kb[V_NH] = t2; );
      kb[V_T] += 1;
    );
    kb[V_BOW] ? (
      t = kb[V_GATE] || kb[V_SUS] ? 1 : 0;
      kb[V_BE] += (t - kb[V_BE]) * (t > kb[V_BE] ? k_blm : k_bwr);
      kb[V_BE] > 0.00001 ? ( kb[V_BL] += (nz_run() - kb[V_BL]) * 0.25;  xb = kb[V_BL] * kb[V_BE] * kb[V_XA] * 3; );
    );
    y = 0;  tb = 0;
    !kb[V_BQ] ? (
    mb = kb + V_MO;
    loop(kb[V_NM],
      re = mb[F_RE];  im = mb[F_IM];
      mb[F_RE] = mb[F_C] * re - mb[F_S] * im + (x + xb * mb[F_BN]) * mb[F_G];
      mb[F_IM] = mb[F_S] * re + mb[F_C] * im;
      y += mb[F_IM];
      mb += MST;
    );
    tw > 0 ? (
      mb = kb + V_MO + 4 * MST;
      re = mb[F_RE];  im = mb[F_IM];
      mb[F_RE] = mb[F_C] * re - mb[F_S] * im + (x + xb * mb[F_BN]) * mb[F_G];
      mb[F_IM] = mb[F_S] * re + mb[F_C] * im;
      y += mb[F_IM] * tw;
    );
    mb = kb + V_MO + 5 * MST;
    re = mb[F_RE];  im = mb[F_IM];
    mb[F_RE] = mb[F_C] * re - mb[F_S] * im + kb[V_MO + F_IM] * mb[F_G];
    mb[F_IM] = mb[F_S] * re + mb[F_C] * im;
    tb = mb[F_IM] * kb[V_TG];
    );
    ly = 0;
    t = held && blend_s > 0.0005 ? 1 : 0;
    kb[V_LE] += (t - kb[V_LE]) * (t > kb[V_LE] ? k_blm : k_lrel);
    kb[V_LE] < 0.0003 && !t ? kb[V_LE] = 0;
    kb[V_LE] > 0.00001 && blend_s > 0.0005 ? (
      lt = kb[V_LT];  li = kb[V_LI];
      lt == 0 ? (
        kb[V_P1] += li;  kb[V_P1] -= floor(kb[V_P1]);
        t = kb[V_P2] * kb[V_LP1] - kb[V_P3] * kb[V_LP2];
        kb[V_P3] = kb[V_P3] * kb[V_LP1] + kb[V_P2] * kb[V_LP2];  kb[V_P2] = t;
        kb[V_FI] += (0.35 - kb[V_FI]) * k_fmi;
        ly = sin(2 * $pi * kb[V_P1] + kb[V_FI] * kb[V_P3]);
      ) : lt == 1 ? (
        kb[V_P1] += li * (1 + pad_dt);  kb[V_P1] -= floor(kb[V_P1]);
        kb[V_P3] += li * (1 - pad_dt);  kb[V_P3] -= floor(kb[V_P3]);
        t = (saw_bl(kb[V_P1], li) + saw_bl(kb[V_P3], li)) * 0.5;
        kb[V_LP1] += (t - kb[V_LP1]) * kb[V_FI];  kb[V_LP2] += (kb[V_LP1] - kb[V_LP2]) * kb[V_FI];
        ly = kb[V_LP2] * 1.5;
      ) : lt == 2 ? (
        kb[V_P1] += li * 0.5;  kb[V_P1] -= floor(kb[V_P1]);
        ly = sin(2 * $pi * kb[V_P1]) + 0.25 * sin(4 * $pi * kb[V_P1]);
      ) : (
        kb[V_P1] += li;  kb[V_P1] -= floor(kb[V_P1]);
        lg_j = (lt - 3) * 4;  lg_mo = kb[V_GM];
        G_PM[lg_j] ? (
          kb[V_LP1] += dac_inc;
          kb[V_LP1] >= 1 ? (
            kb[V_LP1] -= 1;
            lg_i = GV + (lt - 3) * 512 + floor(kb[V_P1] * 256);  t = lg_i[0];
            lg_mo > 0.0001 ? t = floor((t + lg_mo * (lg_i[256] - t)) * 127 + 0.5) / 127;
            kb[V_LP2] = t;
          );
          ly = kb[V_LP2];
        ) : (
          lg_i = kb[V_FI];  t = kb[V_P1] * 2048;  lg_x = floor(t);  t -= lg_x;  lg_i += lg_x;
          ly = lg_i[0] + t * (lg_i[1] - lg_i[0]);
          lg_mo > 0.0001 ? ( lg_i += G_SET;  ly += lg_mo * (lg_i[0] + t * (lg_i[1] - lg_i[0]) - ly); );
        );
        ly *= G_PM[lg_j + 3];
      );
      ly *= kb[V_LE] * kb[V_LA] * 0.5;
      ly = nw_run(kb + V_NW, ly);
    );
    kb[V_STL] ? (
      kb[V_FD] -= fd_k;
      kb[V_FD] <= 0 ? (
        kb[V_PEND] >= 0 ? v_start(kb, kb[V_PEND], kb[V_PVEL]) : kb[V_PEND] < -0.5 ? ( v_start(kb, -1 - kb[V_PEND], kb[V_PVEL]);  kb[V_GATE] = 0; ) : kb[V_ON] = 0;
        y = 0;  tb = 0;  xn = 0;  ly = 0;
      );
      t = max(kb[V_FD], 0);  y *= t;  tb *= t;  ly *= t;
    );
    y += xn;
    t = M_MG[kb[V_MDL]];  y *= t;  tb *= t;
    dl += y * kb[V_GL];  dr += y * kb[V_GR];  tl += tb * kb[V_GL];  tr += tb * kb[V_GR];
    ll += ly * kb[V_GL];  lr += ly * kb[V_GR];
  );
  kb += VSZ;  k += 1;
);

t = bars_s * 0.126;  t2 = blend_s * 0.14;
yl = (dl * (1 - 0.5 * md_v) + tl * res_s * (1 - 0.92 * md_v)) * t;
yr = (dr * (1 - 0.5 * md_v) + tr * res_s * (1 - 0.92 * md_v)) * t;
ff_s += (ff_t - ff_s) * fx_sw * 0.2;
ff_s > 0.0005 ? (
  ff_cn = ff_s / 10;  ff_thr = -32 * ff_cn;  ff_sl = 1 - 1 / (1 + 5 * ff_cn);  ff_mk = -ff_thr * ff_sl * 0.5;
  ff_l = max(abs(yl), abs(yr));
  ff_ov = (ff_l > 0.000001 ? 20 * log10(ff_l) : -120) - ff_thr;
  ff_g = ff_ov <= -3 ? 0 : ff_ov >= 3 ? ff_ov * ff_sl : ff_sl * sqr(ff_ov + 3) / 12;
  ff_gr += (ff_g - ff_gr) * (ff_g > ff_gr ? ff_att : ff_rel);
  ff_k = 10 ^ ((ff_mk - ff_gr) / 20);
  yl *= ff_k;  yr *= ff_k;
) : ( ff_gr = 0; );
ffgr_pk = max(ffgr_pk, ff_gr);
yl += ll * t2 * (1 - md_v);
yr += lr * t2 * (1 - (mdep_s - md_v));
dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;

ch_b[ch_w] = yl;  ch_b[ch_sz + ch_w] = yr;
ch_ty != ch_tt ? ( ch_tg = max(ch_tg - fx_tf, 0);  ch_tg <= 0 ? ( ch_ty = ch_tt;  ch_fbl = ch_fbr = 0; ); ) : ch_tg = min(ch_tg + fx_tf, 1);
ch_on = ch_ty > 0 ? ch_tg : 0;
ch_s += (ch_on - ch_s) * fx_sw;
ch_s > 0.0001 ? (
  ch_dep += (ch_dept - ch_dep) * fx_sw * 0.2;  ch_mx += (ch_mxt - ch_mx) * fx_sw * 0.2;  ch_fb += (ch_fbt - ch_fb) * fx_sw * 0.2;
  ch_ph += ch_inc;  ch_ph -= floor(ch_ph);
  ch_ty == 1 ? (
    ch_ql = ch_rd(ch_b, (7 + 2.5 * ch_dep * (1 + sin(2 * $pi * ch_ph))) * 0.001 * srate)
          + ch_rd(ch_b, (9 + 2.5 * ch_dep * (1 + sin(2 * $pi * (ch_ph + 0.5)))) * 0.001 * srate);
    ch_qr = ch_rd(ch_b + ch_sz, (7 + 2.5 * ch_dep * (1 + sin(2 * $pi * (ch_ph + 0.25))))* 0.001 * srate)
          + ch_rd(ch_b + ch_sz, (9 + 2.5 * ch_dep * (1 + sin(2 * $pi * (ch_ph + 0.75)))) * 0.001 * srate);
    ch_ql *= 0.6;  ch_qr *= 0.6;
  ) : (
    ch_ql = ch_rd(ch_b, max(3, 2 * 2 ^ (ch_dep * 1.6 * sin(2 * $pi * ch_ph)) * 0.001 * srate));
    ch_qr = ch_rd(ch_b + ch_sz, max(3, 2 * 2 ^ (ch_dep * 1.6 * sin(2 * $pi * (ch_ph + 0.25))) * 0.001 * srate));
    ch_u = ch_ql * ch_fb;  ch_b[ch_w] = yl + ch_u / sqrt(1 + 0.25 * ch_u * ch_u);
    ch_u = ch_qr * ch_fb;  ch_b[ch_sz + ch_w] = yr + ch_u / sqrt(1 + 0.25 * ch_u * ch_u);
  );
  ch_u = ch_mx * ch_s;
  ch_ty == 1 ? ( yl = yl * (1 - 0.5 * ch_u) + ch_ql * ch_u * 0.8;  yr = yr * (1 - 0.5 * ch_u) + ch_qr * ch_u * 0.8; )
             : ( ch_v = 1 - 0.5 * abs(ch_fb);
                 yl += (ch_ql * ch_v - yl) * ch_u;  yr += (ch_qr * ch_v - yr) * ch_u; );
) : ch_s = 0;
ch_w = (ch_w + 1) & ch_m;

dg_s += (dg_t - dg_s) * fx_sw;
dg_s > 0.0001 || dg_t ? (
  dg_d += (dg_dt - dg_d) * 0.0004;
  dg_mx += (dg_mxt - dg_mx) * fx_sw * 0.2;  dg_fb += (dg_fbt - dg_fb) * fx_sw * 0.2;
  dg_n = floor(dg_d);  dg_f = dg_d - dg_n;
  dg_i0 = (dg_w - dg_n) & dg_m;  dg_i1 = (dg_w - dg_n - 1) & dg_m;
  dg_ql = dg_b[dg_i0] + (dg_b[dg_i1] - dg_b[dg_i0]) * dg_f;
  dg_qr = dg_b[dg_sz + dg_i0] + (dg_b[dg_sz + dg_i1] - dg_b[dg_sz + dg_i0]) * dg_f;
  dg_ll += (dg_ql - dg_ll) * dg_lpc;  dg_lr += (dg_qr - dg_lr) * dg_lpc;
  dg_hl += (dg_ll - dg_hl) * dg_hpc;  dg_hr += (dg_lr - dg_hr) * dg_hpc;
  dg_u = dg_ll - dg_hl;  dg_v = dg_lr - dg_hr;
  dg_pp ? (
    dg_b[dg_w] = (yl + yr) * 0.5 * dg_s + dg_fb * dg_v;  dg_b[dg_sz + dg_w] = dg_fb * dg_u;
  ) : (
    dg_b[dg_w] = yl * dg_s + dg_fb * dg_u;  dg_b[dg_sz + dg_w] = yr * dg_s + dg_fb * dg_v;
  );
  yl += dg_ql * dg_mx * dg_s;  yr += dg_qr * dg_mx * dg_s;
  dg_s <= 0.0001 && !dg_t ? ( memset(dg_b, 0, 2 * dg_sz);  dg_ll = dg_lr = dg_hl = dg_hr = 0;  dg_s = 0; );
);
dg_w = (dg_w + 1) & dg_m;

dp_g += ((rv_t && dp_ktar == dp_key ? 1 : 0) - dp_g) * fx_sw;
dp_ktar != dp_key && dp_g < 0.0005 ? ( dp_key = dp_ktar;  dp_setup(dp_key);  dp_clear();  dp_cc = 0; );
dp_g > 0.00005 || rv_t ? (
  dp_mx += (dp_mxt - dp_mx) * fx_sw * 0.2;
  dp_pre += (dp_pret - dp_pre) * 0.0004;
  (dp_cc -= 1) <= 0 ? ( dp_cc = 32;  dp_ctl(); );
  dp_dn = -dp_dn;
  dp_pb[dp_pw] = yl * dp_g;  dp_pb[dp_psz + dp_pw] = yr * dp_g;
  dp_rp = dp_pw - dp_pre;  dp_rp < 0 ? dp_rp += dp_psz;
  dp_ri = floor(dp_rp);  dp_rf = dp_rp - dp_ri;  dp_i0 = dp_ri & dp_pm;  dp_i1 = (dp_ri + 1) & dp_pm;
  dp_xa = dp_pb[dp_i0] + (dp_pb[dp_i1] - dp_pb[dp_i0]) * dp_rf;
  dp_xb = dp_pb[dp_psz + dp_i0] + (dp_pb[dp_psz + dp_i1] - dp_pb[dp_psz + dp_i0]) * dp_rf;
  dp_pw = (dp_pw + 1) & dp_pm;
  dp_tb[dp_tw] = dp_xa;  dp_tb[dp_tsz + dp_tw] = dp_xb;
  dp_el = 0;  dp_er = 0;
  dp_erl > 0 ? (
    dpR0.dp_etap(); dpR1.dp_etap(); dpR2.dp_etap(); dpR3.dp_etap(); dpR4.dp_etap(); dpR5.dp_etap();
    dpR6.dp_etap(); dpR7.dp_etap(); dpR8.dp_etap(); dpR9.dp_etap(); dpR10.dp_etap(); dpR11.dp_etap();
    dp_el *= 0.3;  dp_er *= 0.3;
  );
  dp_dax = dp_diff(dp_xa, 0) * 0.5 + dp_el * 0.35;
  dp_dbx = dp_diff(dp_xb, 4) * 0.5 + dp_er * 0.35;
  dp_tl = 0;  dp_tr = 0;
  dpL0.dp_line(); dpL1.dp_line(); dpL2.dp_line(); dpL3.dp_line(); dpL4.dp_line(); dpL5.dp_line(); dpL6.dp_line(); dpL7.dp_line();
  dp_ha0 = dpL0.o + dpL1.o; dp_ha1 = dpL0.o - dpL1.o; dp_ha2 = dpL2.o + dpL3.o; dp_ha3 = dpL2.o - dpL3.o;
  dp_ha4 = dpL4.o + dpL5.o; dp_ha5 = dpL4.o - dpL5.o; dp_ha6 = dpL6.o + dpL7.o; dp_ha7 = dpL6.o - dpL7.o;
  dp_hb0 = dp_ha0 + dp_ha2; dp_hb2 = dp_ha0 - dp_ha2; dp_hb1 = dp_ha1 + dp_ha3; dp_hb3 = dp_ha1 - dp_ha3;
  dp_hb4 = dp_ha4 + dp_ha6; dp_hb6 = dp_ha4 - dp_ha6; dp_hb5 = dp_ha5 + dp_ha7; dp_hb7 = dp_ha5 - dp_ha7;
  dpL0.o = dp_hb0 + dp_hb4; dpL4.o = dp_hb0 - dp_hb4; dpL1.o = dp_hb1 + dp_hb5; dpL5.o = dp_hb1 - dp_hb5;
  dpL2.o = dp_hb2 + dp_hb6; dpL6.o = dp_hb2 - dp_hb6; dpL3.o = dp_hb3 + dp_hb7; dpL7.o = dp_hb3 - dp_hb7;
  dpL0.dp_ap(0); dpL1.dp_ap(1); dpL2.dp_ap(0); dpL3.dp_ap(1); dpL4.dp_ap(0); dpL5.dp_ap(1); dpL6.dp_ap(0); dpL7.dp_ap(1);
  dp_w = (dp_w + 1) & dp_bm;
  dp_wl = dp_tl * 0.35355 * dp_wgs + dp_el * dp_erl;
  dp_wr = dp_tr * 0.35355 * dp_wgs + dp_er * dp_erl;
  dp_tw = (dp_tw + 1) & dp_tm;  dp_aw = (dp_aw + 1) & dp_am;
  dp_wl = floor(dp_wl * dp_wq + 0.5) / dp_wq;  dp_wr = floor(dp_wr * dp_wq + 0.5) / dp_wq;
  dp_lc1l += (dp_wl - dp_lc1l) * dp_lcc;  dp_wl -= dp_lc1l;  dp_lc2l += (dp_wl - dp_lc2l) * dp_lcc;  dp_wl -= dp_lc2l;
  dp_lc1r += (dp_wr - dp_lc1r) * dp_lcc;  dp_wr -= dp_lc1r;  dp_lc2r += (dp_wr - dp_lc2r) * dp_lcc;  dp_wr -= dp_lc2r;
  dp_gd = 1 - (1 - min(2 * (1 - dp_mx), 1)) * dp_g;  dp_gw = min(2 * dp_mx, 1) * dp_g;
  yl = yl * dp_gd + dp_wl * dp_gw;  yr = yr * dp_gd + dp_wr * dp_gw;
  dp_g <= 0.00005 && !rv_t ? ( dp_clear();  dp_g = 0; );
);

pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
ost_out(yl * out_g, yr * out_g);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;
pwr_ser();

@gfx 1200 900
V_FACE = 0x3A4258; V_CHAM = 0x5E6880; V_DARK = 0xB4C3D3; V_BODY = 0x1C2232; V_S1 = 0xE8C45A; V_S2 = 0xC9A24A; V_S3 = 0x5E6880; V_TTL = 0xF2E2B0; V_SUB = 0xC8CEDC;
V_INK = 0x1E2228;  V_INK2 = 0x4A5058;  V_LIT = 0x9A4A1A;  V_DOT = 0x3E444C;
C_LCDBG = 0x0E1210;  C_LCDTX = 0xFFB848;  C_AMB = 0xFFB030;
T_BAR = 0xF2C98A;  T_INS = T_BAR;  T_MAL = T_BAR;
K_OCH = 0xD9A24E;
  T_LAY = 0xC8B6E2;  T_BOD = 0x9CC8EC;  T_MOT = 0x9FD8C4;
T_OUT = 0xD8D2C8;  T_MOD = 0xE8A8C0;  T_FAT = 0xF0A868;  T_DLY = 0x8FD0CC;  T_REV = 0xAAB6EA;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) local(x0, y0) (
  x0 = floor(px(x) + 0.5);  y0 = floor(py(y) + 0.5);
  gfx_rect(x0, y0, max(1, floor(px(x + w) + 0.5) - x0), max(1, floor(py(y + h) + 0.5) - y0), 1);
);
function u_disc(x, y, r) ( gfx_circle(px(x), py(y), ps(r), 1, 1); );
function u_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(px(x1), py(y1), px(x2), py(y2), px(x3), py(y3), px(x4), py(y4)); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_r(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function ui_rrs(x0, y0, ww, hh, r) local(rad, rdi, i, dy, ins, ci, fr, a0, yt, yb) (
  x0 = floor(x0 + 0.5);  y0 = floor(y0 + 0.5);  ww = floor(ww + 0.5);  hh = floor(hh + 0.5);
  rad = min(r, min(ww, hh) * 0.5);  rdi = ceil(rad);  a0 = gfx_a;
  gfx_rect(x0, y0 + rdi, ww, hh - 2 * rdi);
  i = 0;
  loop(rdi,
    dy = rad - (i + 0.5);  ins = dy > 0 ? rad - sqrt(max(rad * rad - dy * dy, 0)) : 0;  ci = ceil(ins);  fr = ci - ins;
    yt = y0 + i;  yb = y0 + hh - 1 - i;
    gfx_a = a0;  gfx_rect(x0 + ci, yt, ww - 2 * ci, 1);  gfx_rect(x0 + ci, yb, ww - 2 * ci, 1);
    ci > 0 && fr > 0.02 ? ( gfx_a = a0 * fr;  gfx_rect(x0 + ci - 1, yt, 1, 1);  gfx_rect(x0 + ww - ci, yt, 1, 1);  gfx_rect(x0 + ci - 1, yb, 1, 1);  gfx_rect(x0 + ww - ci, yb, 1, 1); );
    i += 1;
  );
  gfx_a = a0;
);
function u_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );

function fit_font(idx, face, size) local(fs, w, h, target) (
  target = (face == "Courier New" ? 5.4 : 5.28) * size;  fs = size;
  loop(3,
    gfx_setfont(idx, face, fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);

function v4_bevel(x, y, w, h, b, c, face, bg) (
  col(ui_mix(bg, 0, 0.30), 1);  u_rect(x + 1, y + h, w, 1);  u_rect(x + w, y + 1, 1, h);
  col(ui_mix(bg, 0, 0.12), 1);  u_rect(x + 2, y + h + 1, w, 1);  u_rect(x + w + 1, y + 2, 1, h);
  col(ui_mix(c, 0, 0.55), 1);  u_rect(x, y, w, h);
  x += 1;  y += 1;  w -= 2;  h -= 2;
  col(ui_mix(c, 0xFFFFFF, 0.24), 1);  u_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  col(ui_mix(c, 0xFFFFFF, 0.12), 1);  u_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  col(ui_mix(c, 0, 0.28), 1);  u_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  col(ui_mix(c, 0, 0.45), 1);  u_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  col(face, 1);  u_rect(x + b, y + b, w - 2 * b, h - 2 * b);
);
function v4_well(x, y, w, h, b, c, face) (
  col(ui_mix(c, 0, 0.42), 1);  u_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  col(ui_mix(c, 0, 0.28), 1);  u_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  col(ui_mix(c, 0xFFFFFF, 0.10), 1);  u_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  col(ui_mix(c, 0xFFFFFF, 0.22), 1);  u_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  col(face, 1);  u_rect(x + b, y + b, w - 2 * b, h - 2 * b);
  col(ui_mix(face, 0, 0.35), 1);  u_rect(x + b, y + b, w - 2 * b, 2);  u_rect(x + b, y + b, 2, h - 2 * b);
);
function v4_tline(x1, y1, x2, y2, th) local(n, i, t) (
  n = max(ceil(sqrt(sqr(x2 - x1) + sqr(y2 - y1)) * sc * 2), 1);  i = 0;
  while (i <= n) ( t = i / n;  gfx_circle(px(x1 + (x2 - x1) * t), py(y1 + (y2 - y1) * t), ps(th) * 0.5, 1, 1);  i += 1; );
);
function v4_glyph(x, y, t) local(i) (
  t == 0 ? ( i = 0;  loop(12, v4_tline(x + i * 2, y + 6 * sin(i * 0.9), x + i * 2 + 2, y + 6 * sin((i + 1) * 0.9), 1.6);  i += 1; ); )
  : t == 1 ? ( i = 0;  loop(12, v4_tline(x + i * 2, y + 5 - 9 / (1 + exp(-(i - 6))), x + i * 2 + 2, y + 5 - 9 / (1 + exp(-(i - 5))), 1.6);  i += 1; ); )
  : ( i = 0;  loop(5, u_rect(x + i * 5, y + 6 - (i + 1) * 2.4, 3, (i + 1) * 2.4);  i += 1; ); );
);
function v4_sub(x, y, w, h, n, s, tc, g) (
  v4_bevel(x, y, w, h, 7, V_CHAM, V_DARK, V_FACE);
  col(ui_mix(V_DARK, 0, 0.3), 1);  u_rect(x + 10, y + 41, w - 20, 1);
  col(tc, 1);  u_rect(x + 7, y + 7, w - 14, 28);  col(ui_mix(tc, 0, 0.25), 1);  u_rect(x + 7, y + 33, w - 14, 2);
  col(0xF4F6F8, 1);  u_rect(x + 13, y + 12, 28, 18);
  gfx_setfont(7);  col(0x1A1A1C, 1);  text_c(px(x + 27), py(y + 21), n);
  gfx_setfont(8);  col(0x1A1A1C, 1);  text_l(px(x + 49), py(y + 21), s);
  g >= 0 ? ( col(0x1A1A1C, 1);  v4_glyph(x + w - 41, y + 21, g); );
  col(0x4A4D52, 1);  u_disc(x + 13, y + h - 13, 3);  u_disc(x + w - 13, y + h - 13, 3);
  col(0x8A8E94, 1);  u_disc(x + 12.5, y + h - 13.5, 1.8);  u_disc(x + w - 13.5, y + h - 13.5, 1.8);
);
function v4_dim(x, y, w, h) ( col(V_DARK, 0.5);  col(ui_mix(V_DARK, 0x808080, 0.35), 0.55);  u_rect(x + 8, y + 43, w - 16, h - 51); );

function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v * 100 + 0.5) :
  fmt == 2 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 3 ? sprintf(#kv, "%+.1f c", v) :
  fmt == 4 ? sprintf(#kv, "%d %%", v) :
  fmt == 5 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 6 ? sprintf(#kv, "%.2fx", v) :
  fmt == 7 ? sprintf(#kv, "%+d", floor(v + 0.5)) :
  fmt == 8 ? (abs(v) < 0.005 ? strcpy(#kv, "AS IS") : sprintf(#kv, v < 0 ? "HARM %d %%" : "METAL %d %%", abs(v) * 100 + 0.5)) :
  fmt == 9 ? (v < 1 ? sprintf(#kv, "%d ms", v * 1000 + 0.5) : sprintf(#kv, "%.2f s", v)) :
  fmt == 10 ? sprintf(#kv, "%.1f", v) :
  fmt == 11 ? ( v = floor(v + 0.5);  strcpy(#kv, v == 0 ? "1/32" : v == 1 ? "1/16 T" : v == 2 ? "1/16" : v == 3 ? "1/16 D" : v == 4 ? "1/8 T" :
                v == 5 ? "1/8" : v == 6 ? "1/8 D" : v == 7 ? "1/4 T" : v == 8 ? "1/4" : v == 9 ? "1/4 D" : v == 10 ? "1/2" : "1 BAR"); ) :
  fmt == 12 ? sprintf(#kv, "%.1f s", v) :
  fmt == 13 ? sprintf(#kv, "%d ms", v + 0.5) :
  fmt == 14 ? sprintf(#kv, "%d Hz", v + 0.5) :
  fmt == 15 ? sprintf(#kv, "%+d %%", v * 100 + (v < 0 ? -0.5 : 0.5)) :
  fmt == 16 ? sprintf(#kv, "BARS %d / LAYER %d", 100 - floor(v * 100 + 0.5), floor(v * 100 + 0.5)) :
             sprintf(#kv, "%.2f", v);
  #kv;
);

function v4_cap(cx, cy, r, a, act, pc, nd, ctr, dm) local(i, t, x, y, rr, rd) (
  x = px(cx);  y = py(cy);  rr = ps(r);  rd = rr + ps(8);
  col(V_DOT, dm ? 0.45 : 1);  i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(x + sin(t) * rd, y - cos(t) * rd, ps(i == 0 || i == nd || (ctr && i * 2 == nd) ? 2.0 : 1.4), 1, 1);  i += 1; );
  i = 1;  loop(2, col(ui_mix(V_DARK, 0, 0.18 + (2 - i) * 0.12), 1);  gfx_circle(x + ps(i), y + ps(i * 1.5), rr + ps(2.5), 1, 1);  i += 1; );
  col(0x5C6064, 1);  gfx_circle(x, y, rr + ps(2.5), 1, 1);
  col(act ? 0xB4B9BE : 0x9DA2A7, 1);  gfx_circle(x - ps(0.4), y - ps(0.5), rr + ps(1.9), 1, 1);
  col(0x6E7277, 1);  gfx_circle(x + ps(0.3), y + ps(0.4), rr + ps(1.6), 1, 1);
  col(0x1B1C1E, 1);  gfx_circle(x, y, rr + ps(0.6), 1, 1);
  col(cap_c ? (act ? ui_mix(cap_c, 0xFFFFFF, 0.12) : cap_c) : act ? 0x34373B : 0x2A2C30, 1);  gfx_circle(x, y, rr - ps(0.4), 1, 1);
  i = 0;  loop(4, col(0x000000, (cap_c ? 0.07 : 0.10) * (1 - i / 4));  gfx_circle(x, y, rr - ps(0.4) - ps(i), 0, 1);  i += 1; );
  col(0xFFFFFF, 0.16);  gfx_arc(x, y, rr - ps(1.6), -1.9, -0.4, 1);  gfx_arc(x, y, rr - ps(2.2), -1.9, -0.4, 1);
  cap_c ? col(dm ? ui_mix(0x141414, cap_c, 0.45) : 0x141414, 1) : col(dm ? ui_mix(pc, 0x2A2C30, 0.55) : pc, 1);
  gfx_circle(x + sin(a) * rr * 0.62, y - cos(a) * rr * 0.62, max(rr * 0.19, ps(2)), 1, 1);
);
function v4_knob(cx, cy, r, idx, vmin, vmax, def, pc, lbl, fmt)
  local(x, y, rr, v, t, hov, now, tv, lgt, st, dm, zr, nd, act)
(
  lgt = klog;  klog = 0;  st = kstep;  kstep = 0;  dm = kdim;  kdim = 0;  zr = kzero;  kzero = 0;  nd = knd;  knd = 0;  cap_c = kcap;  kcap = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr + ps(6));
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  kd_my = mouse_y;  kd_t = t;  kd_dz = mouse_y; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx && abs(mouse_y - kd_dz) >= 3 ? (
    t = max(0, min(1, kd_t + (kd_my - mouse_y) / ps((mouse_cap & 8) ? 1100 : 200)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st : v = floor(v * 1000 + 0.5) / 1000;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    kd_dz = -100000;
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  tv = -0.75 * $pi + t * 1.5 * $pi;
  act = hov || drag_idx == idx;
  zr ? ( gfx_setfont(11);  col(V_INK2, 1);  text_c(x, y - rr - ps(16), "0"); );
  v4_cap(cx, cy, r, tv, act, pc, nd > 0 ? nd : st > 0 ? min(12, floor((vmax - vmin) / st + 0.5)) : 4, zr, dm);
  gfx_setfont(10);  col(act ? V_LIT : dm ? ui_mix(V_INK, V_DARK, 0.55) : V_INK, 1);
  text_c(x, y + rr + ps(20), act ? fmtv(v, fmt) : lbl);
  act;
);
function v4_key(x, y, w, h, on, lc, str) local(hov, hit, ly) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  col(ui_mix(V_DARK, 0, 0.25), 1);  u_rr(x - 1, y - 0.5, w + 4, h + 5, 4);
  col(0x0E0F10, 1);  u_rr(x - 2, y - 2, w + 4, h + 4, 4);
  col(0x1A1B1D, 1);  u_rr(x, y, w, h, 3);
  col(0x45484D, 1);  u_rr(x, y, w - 1, h - 1, 3);
  col(0x2C2E32, 1);  u_rr(x + 1, y + 1, w - 2, h - 2, 3);
  col(hov ? 0x3B3E42 : 0x34363A, 1);  u_rr(x + 1, y + 1, w - 2, h - 8, 3);
  col(0x3E4146, 1);  u_rect(x + 4, y + 1, w - 8, 1);
  lc >= 0 ? (
    on ? ( col(lc, 0.3);  u_rr(x + w / 2 - 14, y + 4, 28, 12, 3);  col(ui_mix(lc, 0xFFFFFF, 0.25), 1);  u_rr(x + w / 2 - 11, y + 6, 22, 8, 2); )
       : ( col(ui_mix(lc, 0x1E2023, 0.75), 1);  u_rr(x + w / 2 - 11, y + 6, 22, 8, 2); );
    ly = y + h - 12;
  ) : ly = y + h / 2 - 1;
  gfx_setfont(10);  col(0xE8EBEE, 1);  text_c(px(x + w / 2), py(ly), str);
  hit;
);
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
function v4_badge(x, y, s, fill, ink) local(w, h, bw, bh) (
  gfx_setfont(16);  gfx_measurestr(s, w, h);  bw = ceil(w / sc) + 12;  bh = ceil(h / sc) + 6;
  col(0x1A1A1C, 1);  u_rr(x - 6, y - 3, bw, bh, 3);  col(fill, 1);  u_rr(x - 5, y - 2, bw - 2, bh - 2, 2);
  col(ink, 1);  gfx_x = px(x);  gfx_y = py(y);  gfx_drawstr(s);  bw;
);
function lcd_box(x, y, w, h) (
  col(0x0A0B0C, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(C_LCDBG, 1);  u_rect(x, y, w, h);
  col(0xFFFFFF, 0.05);  u_rect(x + 2, y + 2, w - 4, 1);
);
function lcd_text(x, y, fnt, str) local(tw, th, gy) (
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x);  gfx_y = gy;  gfx_drawstr(str);
);
function lamp(x, y, c, lv) (
  col(0x000000, 0.7);  u_disc(x, y, 6.5);
  lv > 0.02 ? ( col(c, 0.28 * lv);  u_disc(x, y, 11); );
  col(ui_mix(ui_mix(c, 0, 0.72), c, lv), 1);  u_disc(x, y, 5);
  lv > 0.3 ? ( col(0xFFFFFF, 0.5 * lv);  u_disc(x - 1.4, y - 1.4, 1.4); );
);
function v4_print(x, y, s) ( gfx_setfont(11);  col(V_INK2, 1);  text_c(px(x), py(y), s); );

function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  v4_key(x, y, 64, h, 0, -1, "PRESETS") ? open = 1;
  v4_key(x + 68, y, 24, h, 0, -1, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  v4_key(x + 94, y, 24, h, 0, -1, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0xE8EBEE, 1);  pb_tri(x + 80, y + h * 0.5 - 1, 4.5, -1);  pb_tri(x + 106, y + h * 0.5 - 1, 4.5, 1);
  lx = x + 124;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd_box(lx, y, lw, h);  lcd_text(lx + 10, y + h * 0.5, 9, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
PRESET_MENU = "Init|Pure Vibes|Glass Harmonica|Gamelan Night|Steel Pan|Rosewood Sub|Bowed Vibes|FM Mallets|Dream Vibes|Bell Tower|Music Box|Metal Drone|Log Drum|Crystal Pad|Choir Bars|Micro Chime|Spectral Marimba|Organ Vibes|Bit Shimmer";

g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1200 * g_ret), gfx_h / (900 * g_ret))), 0.5);
ox = floor((gfx_w - 1200 * sc) * 0.5);
oy = floor((gfx_h - 900 * sc) * 0.5);
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
h_click = sz_help ? click : 0;  h_wheel = sz_help ? mouse_wheel : 0;
sz_help ? ( click = 0;  mouse_wheel = 0; );
klog = 0;  kstep = 0;  kdim = 0;  kzero = 0;  knd = 0;
sc != ff_sc ? (
  ff_sc = sc;
  fs20 = fit_font(10, "Arial", ps(14));
  fs21 = fit_font(11, "Arial", ps(12));
