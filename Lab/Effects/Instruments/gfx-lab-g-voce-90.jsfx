desc:Voce 90 [e-piano module] (GFX Lab)
//tags: instrument synth electric piano clav autowah velocity layer
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel and gfx-lab-instrument (.jsfx-inc) in the same folder.
//
// Half-rack electric piano module in the spirit of the classic 90s EP modules.
// Five synthesised pianos (no samples):
//   TINE    - FM tine piano: warm body plus a metallic attack "ding", bark at high velocity
//   REED    - FM reed piano with soft-clipped bark
//   PLUCK   - short, bright sticky-reed pluck
//   CLAV    - plucked string with a pickup comb filter and damper mute
//   BUZZ    - buzzy pulse-wave plucked keyboard
// VELOCITY LAYER (the Lab rework, Oct 2026): every note plays two of the pianos at once, a SOFT piano and a HARD
//   piano, mixed by how hard the key is struck. SPLIT is the velocity (1 - 127) where the two sit half and half;
//   BLEND sets how gradual the change is (0 % = a near switch over about 4 velocity steps, 100 % = across the whole
//   range). The mix is fixed at the note-on (equal power, each piano level-matched), so changing it never clicks a
//   held note. The same piano picked twice is the Stable Voce 90's single voice.
// SIGNAL FLOW: pianos -> drive -> tone -> vibrato (stereo pan tremolo) -> chorus -> autowah -> FX row -> volume -> output stage.
// FX ROW (JG, 29 Oct 2026): the GFX Mod Rack's TREMOLO, CHORUS, VIBE and DELAY (as in M1K), in parallel, each with
//   L / C / R and tempo SYNC (a menu under its RATE / TIME knob); levels glide 30 ms. All off = the sound without it.
// Autowah: ENV follows your playing; 1/4, 1/8, 1/16 sweep in time with the project tempo.
// DRIFT (0 - 100 %, 25 % default): the GFX instrument standard (pitch, tone, vibrato / chorus rate, wah centre), plus
//   the two pianos wander apart: each has its own slow tuning drift (up to +/-8 cents at 100 %) and its own few cents
//   per note, so where they overlap they beat gently, like two instruments not quite in tune.
// GUI: the SOFT and HARD rows of LED keys pick the two pianos; the VELOCITY strip shows the mix across the keyboard's
//   velocity range (the last note played marked). OUTPUT folds out the output stage (SAT, MONO, WIDTH).
// MIDI: sustain pedal (CC64), pitch bend (+/- 2 semitones), all notes off (CC120 / 123); MIDI passes through.
// PRESETS: twelve patches (each with its FX row), chosen from the preset bar or the hidden Preset parameter.
// Latency: none.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc

slider1:0<0,4,1{Tine,Reed,Pluck,Clav,Buzz}>-Soft piano
slider2:20<0,100,1>-Drive (%)
slider3:55<0,100,1>-Tone (%)
slider4:4<0.5,10,0.01>-Vibrato rate (Hz)
slider5:30<0,100,1>-Vibrato depth (%)
slider6:20<0,100,1>-Chorus depth (%)
slider7:0.6<0.1,5,0.01>-Chorus rate (Hz)
slider8:60<0,100,1>-Wah sensitivity (%)
slider9:60<0,100,1>-Wah range (%)
slider10:55<0,100,1>-Wah Q (%)
slider11:60<0,100,1>-Wah mix (%)
slider12:0<0,3,1{Env,1/4,1/8,1/16}>-Wah mode
slider13:25<0,100,1>-Drift (%)
slider14:0<-24,6,0.1>-Volume (dB)
slider15:1<0,4,1{Tine,Reed,Pluck,Clav,Buzz}>-Hard piano
slider16:0<0,100,1>-Band sat (%)
slider17:30<0,100,1>-Bias (%)
slider18:120<40,400,1>-Sat low band (Hz)
slider19:6000<2000,16000,10>-Sat high band (Hz)
slider20:-0.3<-24,0,0.1>-Ceiling (dB)
slider21:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider22:20<20,500,1>-Mono below (Hz, 20 = off)
slider23:0<0,100,1>-Stereo width (%)
slider24:90<1,127,1>-Split (velocity)
slider25:40<0,100,1>-Blend (%)
slider26:0.8<0.05,8,0.01>-FX chorus rate (Hz)
slider27:50<0,100,1>-FX chorus depth (%)
slider28:0<0,100,1>-FX chorus mix (%)
slider29:0<0,100,1>-FX chorus clock stretch (%)
slider30:1<0,1,1{Off,On}>-FX chorus L
slider31:0<0,1,1{Off,On}>-FX chorus C
slider32:1<0,1,1{Off,On}>-FX chorus R
slider33:0<0,3,1{Off,Straight,Dotted,Triplet}>-FX chorus sync
slider34:2<0,7,1{4 Bars,2 Bars,1 Bar,1/2,1/4,1/8,1/16,1/32}>-FX chorus sync rate
slider35:4<0.1,15,0.01>-FX tremolo rate (Hz)
slider36:0<0,100,1>-FX tremolo depth (%)
slider38:0<0,100,1>-FX tremolo square chop (%)
slider39:1<0,1,1{Off,On}>-FX tremolo L
slider40:0<0,1,1{Off,On}>-FX tremolo C
slider41:1<0,1,1{Off,On}>-FX tremolo R
slider42:0<0,3,1{Off,Straight,Dotted,Triplet}>-FX tremolo sync
slider43:5<0,7,1{4 Bars,2 Bars,1 Bar,1/2,1/4,1/8,1/16,1/32}>-FX tremolo sync rate
slider44:1.5<0.1,12,0.01>-FX vibe rate (Hz)
slider45:0<0,100,1>-FX vibe depth (%)
slider47:0<0,100,1>-FX vibe asymmetrical lamp (%)
slider48:1<0,1,1{Off,On}>-FX vibe L
slider49:0<0,1,1{Off,On}>-FX vibe C
slider50:1<0,1,1{Off,On}>-FX vibe R
slider51:0<0,3,1{Off,Straight,Dotted,Triplet}>-FX vibe sync
slider52:4<0,7,1{4 Bars,2 Bars,1 Bar,1/2,1/4,1/8,1/16,1/32}>-FX vibe sync rate
slider53:350<20,1500,1>-FX delay time (ms)
slider54:30<0,95,1>-FX delay feedback (%)
slider55:0<0,100,1>-FX delay mix (%)
slider56:0<0,100,1>-FX delay runaway clock (%)
slider57:1<0,1,1{Off,On}>-FX delay L
slider58:0<0,1,1{Off,On}>-FX delay C
slider59:1<0,1,1{Off,On}>-FX delay R
slider60:0<0,3,1{Off,Straight,Dotted,Triplet}>-FX delay sync
slider61:4<0,7,1{4 Bars,2 Bars,1 Bar,1/2,1/4,1/8,1/16,1/32}>-FX delay sync rate
slider62:prs_sel=0<0,12,1{No preset,Soul Tine,Clean Tine,Suitcase,Gospel Wah,Neo Soul,Reed Bark,Reed Trem,Pluck Pop,Funk Clav,Sync Clav,Buzz 70s,Dirty Keys}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-g-voce-90";                              // the ? pop-up links to this manual
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );

NV = 12;                                   // polyphony
// per-voice state (memory arrays, 20 slots each); layer B (the HARD piano) keeps its own copy at + LB
v_act = 1000;  v_note = 1020; v_vel = 1040; v_held = 1060; v_sus = 1080; v_age = 1100;
v_ph  = 1120;  v_inc  = 1140; v_env = 1160; v_att  = 1180; v_dec = 1200; v_rel = 1220;
v_ie  = 1240;  v_idc  = 1260; v_te  = 1280; v_tdc  = 1300; v_typ = 1320; v_lp  = 1340;
v_len = 1360;  v_wp   = 1380; v_fb  = 1400; v_fbr  = 1420; v_det = 1440; v_g   = 1460;
LB = 3000;                                 // layer B arrays: 4000 .. 4479
memset(1000, 0, 480); memset(1000 + LB, 0, 480);
CLV = 200000; CLVSZ = 8192;                // clav delay lines, one per voice
memset(CLV, 0, NV * CLVSZ);
CHL = 40000; CHR = 50000; CHSZ = 8192;     // chorus delay lines
memset(CHL, 0, CHSZ); memset(CHR, 0, CHSZ); chw = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();   // 20000..24095
MR = 400000;                               // Mod Rack lines (to about 1.8M at 192 kHz)

ins_drift_init();
dLa.drift_init(0.8 + rand(1) * 0.5); dLb.drift_init(0.8 + rand(1) * 0.5);   // each piano's own tuning wander
lay_pa = 1; lay_pb = 1;

tp = 2 * $pi;
agec = 0; sus_pedal = 0; bend = 1;
atk_k = 1 - exp(-1 / (0.0015 * srate));
envf_a = 1 - exp(-1 / (0.003 * srate)); envf_r = 1 - exp(-1 / (0.12 * srate));
sm = 1 - exp(-1 / (0.03 * srate));
// each piano's level, so the SOFT / HARD mix doesn't jump in loudness (8-note chords, first 400 ms RMS matched to the
// tine within 1.5 dB from velocity 60 to 120; the clav a touch up)
function typ_gain(t) ( t == 3 ? 1.1 : 1; );
// per-patch level trim: every patch at the same level (a 4-note chord at velocity 90 about -21 dBFS RMS; the
// spiky pluck / clav patches lower, peaks under -6 dBFS)
function patch_trim(p) (
  p == 1 ? 0.562 : p == 2 ? 0.473 : p == 3 ? 0.556 : p == 4 ? 0.569 : p == 5 ? 0.537 : p == 6 ? 0.589 :
  p == 7 ? 0.519 : p == 8 ? 0.49 : p == 9 ? 0.40 : p == 10 ? 0.49 : p == 11 ? 0.631 : p == 12 ? 0.785 : 0.562;
);
ptr_t = patch_trim(1); ptr_s = ptr_t;
vlp = 0; dxp = 0; dyp = 0; tlp = 0; wenv = 0; wph = 0; vph = 0; cph = 0;
wL1 = wL2 = wR1 = wR2 = 0;
!ui_dflt ? ui_thm = 10; !ui_dflt ? ui_hw = 1;                    // fixed black-and-amber faceplate

// ---------- patches (leave Drift and Volume alone) ----------
function setp(va, vb, sp, bl, drv, ton, vr, vd, cd, cr, ws, wr, wq, wm, wmo) (
  slider1 = va; slider15 = vb; slider24 = sp; slider25 = bl;
  slider2 = drv; slider3 = ton; slider4 = vr; slider5 = vd; slider6 = cd; slider7 = cr;
  slider8 = ws; slider9 = wr; slider10 = wq; slider11 = wm; slider12 = wmo;
);
// the FX row: everything back to its default, then chorus mix, tremolo depth, vibe depth, delay mix, delay sync
// (0 = free, 1 straight, 2 dotted, 3 triplet), delay note (0 = 4 bars .. 7 = 1/32), delay feedback
function mrp(cm, td, vd, dm, dsy, drt, dfb) local(i) (
  slider26 = 0.8; slider27 = 50; slider28 = cm; slider29 = 0; slider33 = 0; slider34 = 2;
  slider35 = 4; slider36 = td; slider38 = 0; slider42 = 0; slider43 = 5;
  slider44 = 1.5; slider45 = vd; slider47 = 0; slider51 = 0; slider52 = 4;
  slider53 = 350; slider54 = dfb; slider55 = dm; slider56 = 0; slider60 = dsy; slider61 = drt;
  i = 0; loop(4, slider(30 + i * 9) = 1; slider(31 + i * 9) = 0; slider(32 + i * 9) = 1; i += 1; );
);
//        SOFT HARD SPLIT BLEND  DRV TONE VIBR VIBD CHOD CHOR  WSEN WRNG WQ  WMIX WMODE
function load_preset(p) local(i) (
  p == 1  ? setp(0, 1, 96,  45,  20, 55, 4,   30, 20, 0.6, 60, 60, 55, 60, 0) :   // Soul Tine: tine, reed bark when dug in
  p == 2  ? setp(0, 0, 90,  40,  5,  50, 4,   0,  0,  0.6, 50, 50, 40, 0,  0) :   // Clean Tine: the tine alone
  p == 3  ? setp(0, 1, 100, 35,  15, 52, 5,   60, 0,  0.6, 50, 50, 40, 0,  0) :   // Suitcase
  p == 4  ? setp(0, 1, 84,  50,  35, 60, 4,   0,  15, 0.5, 75, 70, 65, 85, 0) :   // Gospel Wah
  p == 5  ? setp(0, 2, 92,  60,  25, 45, 3.5, 20, 35, 0.4, 45, 55, 50, 35, 0) :   // Neo Soul: tine, pluck sparkle on top
  p == 6  ? setp(1, 4, 104, 30,  40, 60, 6,   25, 0,  0.6, 50, 50, 40, 0,  0) :   // Reed Bark: reed, buzz when hit hard
  p == 7  ? setp(0, 1, 80,  70,  15, 55, 5.5, 55, 0,  0.6, 50, 50, 40, 0,  0) :   // Reed Trem
  p == 8  ? setp(2, 3, 96,  40,  10, 70, 4,   0,  30, 0.8, 50, 50, 40, 0,  0) :   // Pluck Pop: pluck, clav snap on accents
  p == 9  ? setp(2, 3, 70,  45,  25, 65, 4,   0,  0,  0.6, 70, 75, 70, 90, 0) :   // Funk Clav: muted pluck, clav on top
  p == 10 ? setp(3, 3, 90,  40,  20, 60, 4,   0,  0,  0.6, 50, 70, 70, 80, 3) :   // Sync Clav: the clav alone
  p == 11 ? setp(4, 1, 96,  50,  20, 55, 4,   0,  40, 0.7, 50, 50, 40, 0,  0) :   // Buzz 70s
            setp(1, 4, 88,  40,  70, 50, 4,   0,  10, 0.6, 50, 65, 60, 50, 2);    // Dirty Keys
  //       CHO TRM VIBE DLY SYNC NOTE FDBK
  p == 1  ? mrp(0,  0,  0,  14, 2,   5,   25) :     // Soul Tine: a dotted-eighth echo
  p == 5  ? mrp(25, 0,  0,  16, 1,   4,   30) :     // Neo Soul: chorus and a quarter-note echo
  p == 6  ? mrp(0,  0,  35, 0,  0,   4,   30) :     // Reed Bark: vibe
  p == 8  ? mrp(0,  0,  0,  18, 1,   5,   35) :     // Pluck Pop: an eighth-note echo
  p == 11 ? mrp(0,  0,  40, 0,  0,   4,   30) :     // Buzz 70s: vibe
  p == 12 ? mrp(0,  0,  0,  20, 2,   5,   40) :     // Dirty Keys: a dotted-eighth echo
            mrp(0,  0,  0,  0,  0,   4,   30);      // the rest: FX row off
  ptr_t = patch_trim(p);
  slider_automate(4095 + 16384 + 8388608 + 16777216);   // sliders 1-12, 15, 24, 25
  i = 26; loop(36, i != 37 && i != 46 ? slider_automate(2 ^ (i - 1)); i += 1; );   // FX 26 - 61
);

// ---------- voices ----------
function blep(t, dt) (
  t < dt ? ( t /= dt; 2 * t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + 2 * t + 1; ) : 0;
);

// one piano's settings for voice slot j (j = i for SOFT, i + LB for HARD)
function lay_init(j, typ, vel, ks, g) local(dec, rel) (
  v_typ[j] = typ; v_g[j] = g * typ_gain(typ); v_env[j] = g > 0 ? 1 : 0; v_lp[j] = 0; v_ph[j] = 0;
  v_det[j] = ins_note_detune();                          // per-note tuning offset, up to +/-6 cents (each piano its own)
  typ == 0 ? ( dec = 4.5; rel = 0.18; v_ie[j] = 1.8 * vel; v_idc[j] = 0.5;  v_te[j] = 0.6 * vel; v_tdc[j] = 0.08; ) :
  typ == 1 ? ( dec = 3.0; rel = 0.12; v_ie[j] = 2.5 * vel; v_idc[j] = 0.3;  v_te[j] = 0;         v_tdc[j] = 0.05; ) :
  typ == 2 ? ( dec = 1.6; rel = 0.06; v_ie[j] = 1.5 * vel; v_idc[j] = 0.15; v_te[j] = 0.4 * vel; v_tdc[j] = 0.03; ) :
  typ == 3 ? ( dec = 30;  rel = 0.05; v_ie[j] = 0;         v_idc[j] = 0.1;  v_te[j] = 0;         v_tdc[j] = 0.05; ) :
             ( dec = 1.8; rel = 0.08; v_ie[j] = 0.9 * vel; v_idc[j] = 0.4;  v_te[j] = 0;         v_tdc[j] = 0.05; );
  v_dec[j] = exp(-1 / (dec * ks * srate));
  v_rel[j] = exp(-1 / (rel * srate));
  v_idc[j] = exp(-1 / (v_idc[j] * ks * srate));
  v_tdc[j] = exp(-1 / (v_tdc[j] * srate));
);

// how much of the HARD piano a note of velocity n (1 - 127) gets: 0 .. 1 around SPLIT, BLEND wide (smooth S curve)
function hard_amt(n) local(w, x) (
  w = 4 + slider25 / 100 * 120;
  x = min(max((n - slider24) / w + 0.5, 0), 1);
  x * x * (3 - 2 * x);
);

function note_on(n, mv) local(i, k, best, ba, f, ks, len, bl, br, nz, base, vel, h, ta, tb) (
  best = -1;
  i = 0; loop(NV, v_act[i] && v_note[i] == n && best < 0 ? best = i; i += 1; );      // retrigger same key
  i = 0; loop(NV, !v_act[i] && best < 0 ? best = i; i += 1; );                        // free voice
  best < 0 ? ( ba = 1000000000000; i = 0; loop(NV, v_age[i] < ba ? ( ba = v_age[i]; best = i; ); i += 1; ); );  // oldest
  i = best;
  f = 440 * 2 ^ ((n - 69) / 12);
  ks = 2 ^ (-(n - 60) / 30);               // higher notes decay faster
  vel = (mv / 127) ^ 0.8;
  ta = voice_a; tb = voice_b;
  h = ta == tb ? 0 : hard_amt(mv);         // the same piano twice = one piano
  last_vel_d = mv;
  v_act[i] = 1; v_note[i] = n; v_vel[i] = vel; v_held[i] = 1; v_sus[i] = 0;
  agec += 1; v_age[i] = agec;
  v_inc[i] = f / srate; v_att[i] = 0;
  lay_init(i, ta, vel, ks, h < 1 ? cos(h * $pi * 0.5) : 0);
  lay_init(i + LB, tb, vel, ks, h > 0 ? sin(h * $pi * 0.5) : 0);
  // the HARD piano starts half a turn on (a quarter for tine + pluck), measured so the equal-power mix stays within
  // 1.5 dB of level through the crossover for every pair
  v_ph[i + LB] = ta + tb == 2 && ta * tb == 0 ? 0.25 : 0.5;
  ta == 3 || tb == 3 ? (
    // clav: fill the string with a velocity-filtered noise burst
    len = min(srate / f, CLVSZ - 4); v_len[i] = len;
    base = CLV + i * CLVSZ; memset(base, 0, CLVSZ);
    br = 0.25 + 0.7 * vel; bl = 0;
    k = 0; loop(floor(len) + 2, nz = rand(2) - 1; bl += (nz - bl) * br; base[k] = bl * (0.6 + 0.6 * vel); k += 1; );
    v_wp[i] = floor(len) + 2;
    v_fb[i]  = 10 ^ (-3 / (3.0 * ks * f));     // ~3 s ring while held
    v_fbr[i] = 10 ^ (-3 / (0.06 * f));         // damper: dies in ~60 ms
  );
);

function note_off(n) local(i) (
  i = 0;
  loop(NV,
    v_act[i] && v_held[i] && v_note[i] == n ? ( v_held[i] = 0; sus_pedal ? v_sus[i] = 1; );
    i += 1;
  );
);

function all_off() local(i) ( i = 0; loop(NV, v_held[i] = 0; v_sus[i] = 0; i += 1; ); );

// one piano's sample for voice i, layer slot j (advances its phase, envelope and filters)
function lay_smp(i, j, dt0, held, lp) local(ph, dt, typ, vel, y, base, len, rp, ri, fr, r2, ys, nw, pr, p2) (
  held ? ( v_env[j] *= v_dec[j]; ) : ( v_env[j] *= v_rel[j]; );
  v_ie[j] *= v_idc[j]; v_te[j] *= v_tdc[j];
  dt = dt0 * v_det[j] * lp;
  ph = v_ph[j] + dt; ph -= floor(ph); v_ph[j] = ph;
  vel = v_vel[i]; typ = v_typ[j];
  typ == 0 ? (                                     // tine
    y = sin(tp * ph + (0.35 + v_ie[j]) * sin(tp * ph));
    y += 0.18 * vel * y * y;
    y += v_te[j] * sin(tp * ph + 1.5 * sin(tp * 14 * ph));
  ) : typ == 1 ? (                                 // reed
    y = sin(tp * ph + (0.6 + v_ie[j]) * sin(tp * ph)) * (1 + 1.5 * vel);
    y = 1.3 * y / (1 + abs(y));
  ) : typ == 2 ? (                                 // pluck
    y = sin(tp * ph + (0.2 + v_ie[j]) * sin(tp * ph)) + v_te[j] * sin(tp * 3 * ph);
  ) : typ == 3 ? (                                 // clav: plucked string + pickup comb
    base = CLV + i * CLVSZ;
    len = min(v_len[i] / (dt / v_inc[i]), CLVSZ - 4);
    rp = v_wp[i] - len; rp < 0 ? rp += CLVSZ;
    ri = floor(rp); fr = rp - ri; r2 = ri + 1; r2 >= CLVSZ ? r2 -= CLVSZ;
    ys = base[ri] * (1 - fr) + base[r2] * fr;
    nw = (held ? v_fb[i] : v_fbr[i]) * (0.55 * ys + 0.45 * v_lp[j]);
    v_lp[j] = ys;
    base[v_wp[i]] = nw;
    v_wp[i] += 1; v_wp[i] >= CLVSZ ? v_wp[i] = 0;
    pr = ri - floor(len * 0.18); pr < 0 ? pr += CLVSZ;
    y = 3.5 * (ys - base[pr]);
  ) : (                                            // buzz: band-limited pulse, closing filter
    p2 = ph + 0.3; p2 -= floor(p2);
    y = (2 * ph - 1 - blep(ph, dt)) - (2 * p2 - 1 - blep(p2, dt));
    v_lp[j] += (y - v_lp[j]) * (0.04 + 0.5 * v_ie[j]);
    y = 0.8 * v_lp[j];
  );
  y * v_env[j] * v_g[j];
);

// ---------- FX: the GFX Mod Rack inside (as in M1K): chorus, tremolo, vibe, delay in parallel, after the autowah ----------
// each module adds only its change ("delta") to the dry signal; L / C / R pick left, mono centre, right
mrCHN = 16384; mrDLN = floor(srate*2.2) + 8;
mrChA = MR; mrChB = MR + mrCHN; mrChC = MR + 2*mrCHN;
mrDlA = MR + 3*mrCHN; mrDlB = mrDlA + mrDLN; mrDlC = mrDlB + mrDLN;
mrVsC = mrDlC + mrDLN; mrVsT = mrVsC + 48; mrVsV = mrVsT + 48; mrPre = mrVsV + 48; mrDls = mrPre + 4; mrRg = mrDls + 8; mrVbF = mrRg + 24;
memset(MR, 0, mrVbF + 4 - MR);
mrVsT[0] = mrVsT[16] = mrVsT[32] = 1;
mrVbF[0] = 60; mrVbF[1] = 180; mrVbF[2] = 480; mrVbF[3] = 1300;
mrCw = 1 - exp(-1/(0.15*srate)); mrCs = 1 - exp(-1/(3*srate)); mrCd = 1 - exp(-1/(0.8*srate)); mrCdr = 1 - exp(-1/(3*srate));
function mr_opc(fc) ( 1 - exp(-2*$pi*min(fc, srate*0.45)/srate); );
function mr_tanh(v) ( v = max(-20, min(20, v)); 1 - 2/(exp(2*v) + 1); );
mrVbLp = mr_opc(160); mrVbAt = 1 - exp(-1/(0.008*srate));
mrDlLc = mr_opc(3500); mrDlHc = mr_opc(70); mrDlTs = 1 - exp(-1/(0.25*srate)); mrDlT = 350;
function mr_div(i, md) (
  (i == 0 ? 4*mrBar : i == 1 ? 2*mrBar : i == 2 ? mrBar : i == 3 ? 2 : i == 4 ? 1 : i == 5 ? 0.5 : i == 6 ? 0.25 : 0.125)*(md == 2 ? 1.5 : md == 3 ? 2/3 : 1);
);
function mr_hread(buf, n, pos) local(i, f, xm1, x0, x1, x2, c1, c2, c3) (
  pos < 0 ? pos += n; pos >= n ? pos -= n;
  i = floor(pos); f = pos - i;
  xm1 = buf[(i - 1 + n) % n]; x0 = buf[i]; x1 = buf[(i + 1) % n]; x2 = buf[(i + 2) % n];
  c1 = 0.5*(x1 - xm1); c2 = xm1 - 2.5*x0 + 2*x1 - 0.5*x2; c3 = 0.5*(x2 - xm1) + 1.5*(x0 - x1);
  ((c3*f + c2)*f + c1)*f + x0;
);
function mr_rgen(q, period, coef) ( q[0] -= 1; q[0] <= 0 ? ( q[0] = period*srate; q[1] = rand(2) - 1; ); q[2] += coef*(q[1] - q[2]); q[2]; );
function mr_ch(buf, phoff, vs) local(lf, dms, y) (
  lf = sin(2*$pi*(mrChPh + phoff));
  dms = mrChBase + mrChDep*lf + mrWarb;
  y = mr_hread(buf, mrCHN, mrChW - max(1, dms)*srate*0.001);
  mrClkOn ? ( vs[0] += mrClkInc; vs[0] >= 1 ? ( vs[0] -= 1; vs[1] = y; ); y = vs[1]; );
  vs[2] += mrChPc*(y - vs[2]); vs[3] += mrChPc*(vs[2] - vs[3]);
  vs[3];
);
function mr_tr(phoff, vs) local(sv, sh, g) (
  sv = sin(2*$pi*(mrTrPh + phoff));
  sh = mrTrK > 1.01 ? mr_tanh(mrTrK*sv)/mrTrTk : sv;
  g = 1 - mrTrDep*(0.5 - 0.5*sh);
  vs[0] += mrTrLag*(g - vs[0]); vs[0];
);
function mr_vb(x, phoff, vs) local(q, pw, lf, c, rr, oc, k, y, f, t, a1, xi) (
  q = mrVbPh + phoff; q -= floor(q);
  pw = q < mrVbSk ? 0.5*q/mrVbSk : 0.5 + 0.5*(q - mrVbSk)/(1 - mrVbSk);
  lf = 0.5 - 0.5*cos(2*$pi*pw);
  c = lf > vs[8] ? mrVbAt : mrVbRl; vs[8] += c*(lf - vs[8]); rr = vs[8];
  oc = mrVbOct*rr; y = x; k = 0;
  loop(4, f = min(srate*0.45, mrVbF[k]*2^oc); t = tan($pi*f/srate); a1 = (t - 1)/(t + 1);
    xi = y; y = a1*xi + vs[k*2] - a1*vs[k*2 + 1]; vs[k*2] = xi; vs[k*2 + 1] = y; k += 1; );
  vs[9] += mrVbLp*(x - vs[9]);
  mrVbWet*(0.5*(y - x) + mrVbTh*(2*rr - 1)*vs[9]);
);
function mr_loop(y, q) local(v) ( q[0] += mrDlLc*(y - q[0]); q[1] += mrDlHc*(q[0] - q[1]); v = q[0] - q[1]; mr_tanh(v*mrFbE*1.15)/1.15; );
// the controls (each block)
function mr_update() local(st, fclk, chop, asym) (
  mrChLo = slider30 > 0.5; mrChCo = slider31 > 0.5; mrChRo = slider32 > 0.5;
  mrTrLo = slider39 > 0.5; mrTrCo = slider40 > 0.5; mrTrRo = slider41 > 0.5;
  mrVbLo = slider48 > 0.5; mrVbCo = slider49 > 0.5; mrVbRo = slider50 > 0.5;
  mrDlLo = slider57 > 0.5; mrDlCo = slider58 > 0.5; mrDlRo = slider59 > 0.5;
  st = slider29/100;
  mrChBase = 7 + 18*st; mrChDep = slider27/100*(3 + 4*st); mrSt = st;
  fclk = 40000*(1 - 0.88*st); mrClkOn = fclk < srate*0.98; mrClkInc = fclk/srate;
  mrChPc = mr_opc(min(14000, fclk*0.42)); mrChMixT = slider28/100;
  chop = slider38/100; mrTrK = 1 + 40*chop*chop; mrTrTk = mr_tanh(mrTrK); mrTrDepT = slider36/100;
  mrTrLag = 1 - exp(-1/((0.3 + 5.7*(1 - chop))*0.001*srate));
  asym = slider47/100; mrVbSk = 0.5 - 0.38*asym; mrVbRl = 1 - exp(-1/((0.04 + 0.25*asym)*srate));
  mrVbTh = 0.9*asym; mrVbOctT = 3*slider45/100; mrVbWetT = min(1, 2*slider45/100);
  mrRun = slider56/100; mrFbE = 0.95*slider54/95 + 0.30*mrRun; mrDlMixT = slider55/100;
);
// tempo (each block)
function mr_block() (
  mrBar = ts_denom > 0 ? ts_num*4/ts_denom : 4;
  mrPlay = play_state & 1; mrBpos = beat_position; mrBpInc = tempo/(60*srate);
  mrChSy = slider33 > 0.5; mrChQn = mr_div(slider34, slider33);
  mrTrSy = slider42 > 0.5; mrTrQn = mr_div(slider43, slider42);
  mrVbSy = slider51 > 0.5; mrVbQn = mr_div(slider52, slider51);
  mrDlTgt = slider60 > 0.5 && tempo > 0 ? min(1500, mr_div(slider61, slider60)*60000/tempo) : slider53;
  mrOn = mrChMixT > 0 || mrTrDepT > 0 || mrVbWetT > 0 || mrDlMixT > 0 ||
         mrChMix > 0.00001 || mrTrDep > 0.00001 || mrVbWet > 0.00001 || mrDlMix > 0.00001;
);
// one sample: in mrL / mrR, out mrL / mrR
function mr_run() local(ixl, ixr, m, dl, dr, y, sp, kc, ws, wc, dsm, dmod, ya, yb, yc) (
  ixl = mrL; ixr = mrR; m = 0.5*(ixl + ixr); dl = dr = 0;
  // the levels glide (30 ms), so a preset or a key never steps them
  mrChMix += sm*(mrChMixT - mrChMix); mrTrDep += sm*(mrTrDepT - mrTrDep); mrVbWet += sm*(mrVbWetT - mrVbWet);
  mrVbOct += sm*(mrVbOctT - mrVbOct); mrDlMix += sm*(mrDlMixT - mrDlMix);
  mrChMix < 0.00001 && mrChMixT == 0 ? mrChMix = 0; mrTrDep < 0.00001 && mrTrDepT == 0 ? mrTrDep = 0;
  mrVbWet < 0.00001 && mrVbWetT == 0 ? mrVbWet = 0; mrDlMix < 0.00001 && mrDlMixT == 0 ? mrDlMix = 0;
  mrBpos += mrBpInc;
  mrChSy ? mrChPh = (mrPlay ? mrBpos/mrChQn : mrChPh + mrBpInc/mrChQn) : mrChPh += slider26/srate;
  mrTrSy ? mrTrPh = (mrPlay ? mrBpos/mrTrQn : mrTrPh + mrBpInc/mrTrQn) : mrTrPh += slider35/srate;
  mrVbSy ? mrVbPh = (mrPlay ? mrBpos/mrVbQn : mrVbPh + mrBpInc/mrVbQn) : mrVbPh += slider44/srate;
  mrChPh -= floor(mrChPh); mrTrPh -= floor(mrTrPh); mrVbPh -= floor(mrVbPh);
  // chorus
  mrWarb = mrSt*(2.5*mr_rgen(mrRg + 9, 0.3, mrCw) + 4*mr_rgen(mrRg + 12, 4, mrCs));
  mrPre[0] += mrChPc*(ixl - mrPre[0]); mrPre[1] += mrChPc*(ixr - mrPre[1]); mrPre[2] += mrChPc*(m - mrPre[2]);
  mrChA[mrChW] = mrPre[0]; mrChB[mrChW] = mrPre[1]; mrChC[mrChW] = mrPre[2];
  mrChMix > 0 ? (
    sp = mrChCo && (mrChLo || mrChRo); kc = (mrChLo || mrChRo) ? 0.707 : 1;
    mrChLo ? dl += mrChMix*mr_ch(mrChA, 0, mrVsC);
    mrChRo ? dr += mrChMix*mr_ch(mrChB, sp ? 2/3 : 0.25, mrVsC + 16);
    mrChCo ? ( y = mrChMix*kc*mr_ch(mrChC, sp ? 1/3 : 0, mrVsC + 32); dl += y; dr += y; );
  );
  // tremolo
  mrTrDep > 0 ? (
    sp = mrTrCo && (mrTrLo || mrTrRo); ws = mrTrCo ? 0.5 : 1; wc = (mrTrLo || mrTrRo) ? 0.5 : 1;
    mrTrLo ? dl += ws*ixl*(mr_tr(0, mrVsT) - 1);
    mrTrRo ? dr += ws*ixr*(mr_tr(sp ? 2/3 : 0, mrVsT + 16) - 1);
    mrTrCo ? ( y = wc*m*(mr_tr(sp ? 1/3 : 0, mrVsT + 32) - 1); dl += y; dr += y; );
  );
  // vibe
  mrVbWet > 0 ? (
    sp = mrVbCo && (mrVbLo || mrVbRo); kc = (mrVbLo || mrVbRo) ? 0.707 : 1;
    mrVbLo ? dl += mr_vb(ixl, 0, mrVsV);
    mrVbRo ? dr += mr_vb(ixr, sp ? 2/3 : 0, mrVsV + 16);
    mrVbCo ? ( y = kc*mr_vb(m, sp ? 1/3 : 0, mrVsV + 32); dl += y; dr += y; );
  );
  // delay
  mrDlT += mrDlTs*(mrDlTgt - mrDlT);
  mrWow += 0.45/srate; mrWow -= floor(mrWow); mrFl += 6.3/srate; mrFl -= floor(mrFl);
  dmod = mrRun*(5*sin(2*$pi*mrWow) + 0.5*sin(2*$pi*mrFl) + 2.5*mr_rgen(mrRg + 15, 1.2, mrCd));
  dsm = max(2, min(mrDLN*0.55, (mrDlT + dmod)*srate*0.001));
  sp = mrDlCo && (mrDlLo || mrDlRo); kc = (mrDlLo || mrDlRo) ? 0.707 : 1;
  mrDlLo && (mrDlMix > 0 || mrDlMixT > 0) ? ( ya = mr_hread(mrDlA, mrDLN, mrDlW - dsm*(sp ? 0.75 : 1)); mrDlA[mrDlW] = ixl + mr_loop(ya, mrDls); dl += mrDlMix*ya; ) : mrDlA[mrDlW] = 0;
  mrDlRo && (mrDlMix > 0 || mrDlMixT > 0) ? ( yb = mr_hread(mrDlB, mrDLN, mrDlW - dsm*(sp ? 1.25 : 1)); mrDlB[mrDlW] = ixr + mr_loop(yb, mrDls + 2); dr += mrDlMix*yb; ) : mrDlB[mrDlW] = 0;
  mrDlCo && (mrDlMix > 0 || mrDlMixT > 0) ? ( yc = mr_hread(mrDlC, mrDLN, mrDlW - dsm); mrDlC[mrDlW] = m + mr_loop(yc, mrDls + 4); y = mrDlMix*kc*yc; dl += y; dr += y; ) : mrDlC[mrDlW] = 0;
  mrChW += 1; mrChW >= mrCHN ? mrChW = 0;
  mrDlW += 1; mrDlW >= mrDLN ? mrDlW = 0;
  mrL = ixl + dl; mrR = ixr + dr;
);


// ---------- parameters ----------
function update() (
  voice_a = slider1; voice_b = slider15;
  // gentle drive: gain rises with the square of the knob, so 10-30% stays almost transparent
  // (unity gain at low levels, only the peaks round off); a touch of bias adds even harmonics
  // headroom drv_h shrinks as the knob goes up, so low settings leave even loud chords untouched
  drv = slider2 / 100; drv_g = 1 + 6 * drv * drv; drv_b = 0.05 * drv; drv_h = 2.5 - 1.7 * drv;
  t1 = exp(2 * (drv_g * 0.15 / drv_h + drv_b)); t2 = exp(2 * drv_b);
  drv_n = 0.15 / ((t1 - 1) / (t1 + 1) - (t2 - 1) / (t2 + 1));   // level match at a 0.15 peak
  tone_f = 1500 * 2 ^ (slider3 / 100 * 3.1);
  vib_r = slider4; vib_d = slider5 / 100;
  ch_d = slider6 / 100; ch_r = slider7;
  w_sens = slider8 / 100; w_rng = slider9 / 100; w_q = 0.7 + (slider10 / 100) ^ 1.5 * 7; w_comp = 1 / (0.5 + 0.5 * sqrt(w_q)); w_mix = slider11 / 100;
  w_mode = slider12;
  drift = slider13 / 100;
  vol_t = 10 ^ (slider14 / 20);
  ins_output_setup(16); ins_stereo_setup(22);   // output stage: CLIP, always on
  mr_update();
);

update();
vol_s = vol_t;
// glided copies of the effect settings (a preset change never steps them)
drv_s = drv; dg_s = drv_g; db_s = drv_b; dh_s = drv_h; dn_s = drv_n; tf_s = tone_f; vd_s = vib_d; cd_s = ch_d;
wm_s = w_mix; wr_s = w_rng; wq_s = w_q; wc_s = w_comp; ws_s = w_sens;
tf_s = tone_f; tone_c = 1 - exp(-tp * tf_s / srate); wsm = 1 - exp(-1 / (0.002 * srate));
ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the
// preset bar asks through prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project
// or recalling its state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
update();
// MIDI in
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? ( note_on(m2, m3); ins_midi_hit(); ) :
  st == 0x80 || (st == 0x90 && m3 == 0) ? note_off(m2) :
  st == 0xB0 && m2 == 64 ? (
    sus_pedal = m3 >= 64;
    !sus_pedal ? ( i = 0; loop(NV, v_sus[i] = 0; i += 1; ); );
  ) :
  st == 0xB0 && (m2 == 123 || m2 == 120) ? all_off() :
  st == 0xE0 ? bend = ins_bend(m2, m3, 2);
  midisend(mofs, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( all_off(); );
gfx_pst_prev = gfx_pst;
// drift (block rate)
ins_drift_block(drift, samplesblock);                   // GFX instrument drift
pmul = bend * ins_pitch;                                // pitch wander, up to +/-20 cents
dinc = 0.35 * samplesblock / srate;                     // the two pianos wander apart, up to +/-8 cents each at 100 %
lay_pa = 2 ^ (dLa.drift_tick(dinc) * drift * 8 / 1200);
lay_pb = 2 ^ (dLb.drift_tick(dinc) * drift * 8 / 1200);
// tone wanders like a filter cutoff, up to +/-0.45 octave
tone_t = min(tone_f * 2 ^ ins_tone, srate * 0.45);
vib_inc = vib_r * (1 + 0.15 * ins_fx) / srate;
ch_inc  = ch_r  * (1 + 2 * ins_aux) / srate;            // own drift source, up to +/-30%
// wah tempo sync
w_mult = w_mode == 1 ? 1 : w_mode == 2 ? 2 : 4;
w_inc = tempo / 60 * w_mult / srate;
w_mode > 0 && (play_state & 1) ? wph = (beat_position * w_mult) - floor(beat_position * w_mult);
mr_block();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, ptr_t); ptr_s = ptr_t;
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
// ---------- glides (30 ms): every effect setting moves smoothly, so presets never step ----------
drv_s += (drv - drv_s) * sm; dg_s += (drv_g - dg_s) * sm; db_s += (drv_b - db_s) * sm; dh_s += (drv_h - dh_s) * sm;
dn_s += (drv_n - dn_s) * sm; tf_s += (tone_t - tf_s) * sm; vd_s += (vib_d - vd_s) * sm; cd_s += (ch_d - cd_s) * sm;
wm_s += (w_mix - wm_s) * sm; wr_s += (w_rng - wr_s) * sm; wq_s += (w_q - wq_s) * sm; wc_s += (w_comp - wc_s) * sm;
ws_s += (w_sens - ws_s) * sm; ptr_s += (ptr_t - ptr_s) * sm;
(scnt += 1) >= 16 ? ( scnt = 0; tone_c = 1 - exp(-tp * tf_s / srate); );

// ---------- voices: SOFT piano + HARD piano per note ----------
xs = 0;
i = 0;
loop(NV,
  v_act[i] ? (
    v_att[i] += (1 - v_att[i]) * atk_k;
    hld = v_held[i] || v_sus[i];
    dt0 = v_inc[i] * pmul;
    y = 0;
    v_g[i] > 0 ? y += lay_smp(i, i, dt0, hld, lay_pa);
    v_g[i + LB] > 0 ? y += lay_smp(i, i + LB, dt0, hld, lay_pb);
    xs += y * v_att[i] * (0.55 + 0.45 * v_vel[i]);
    en = max(v_g[i] > 0 ? v_env[i] : 0, v_g[i + LB] > 0 ? v_env[i + LB] : 0);
    !hld && en < 0.0003 ? v_act[i] = 0;
    en < 0.00003 ? v_act[i] = 0;
  );
  i += 1;
);
x = xs * 0.2;

// ---------- drive (gentle, slightly asymmetric soft clip) + DC block ----------
drv_s > 0.001 ? (
  e1 = exp(2 * min(max(dg_s * x / dh_s + db_s, -20), 20)); e2 = exp(2 * db_s);
  dx = ((e1 - 1) / (e1 + 1) - (e2 - 1) / (e2 + 1)) * dn_s;
  x = drv_s < 0.01 ? x + (dx - x) * (drv_s - 0.001) / 0.009 : dx;     // fades in from off, never steps
);
dy = x - dxp + 0.995 * dyp; dxp = x; dyp = dy; x = dy;

// ---------- tone ----------
tlp += (x - tlp) * tone_c; x = tlp;

// ---------- vibrato: stereo pan tremolo ----------
vph += vib_inc; vph -= floor(vph);
vs = sin(tp * vph);
xL = x * (1 - vd_s * 0.5 * (1 - vs));
xR = x * (1 - vd_s * 0.5 * (1 + vs));

// ---------- chorus ----------
CHL[chw] = xL; CHR[chw] = xR;
cph += ch_inc; cph -= floor(cph);
cd_s > 0.0005 ? (
  dl = (0.007 + 0.004 * cd_s * (0.5 + 0.5 * sin(tp * cph))) * srate;
  dr = (0.007 + 0.004 * cd_s * (0.5 + 0.5 * cos(tp * cph))) * srate;
  rp = chw - dl; rp < 0 ? rp += CHSZ; ri = floor(rp); fr = rp - ri; r2 = ri + 1; r2 >= CHSZ ? r2 -= CHSZ;
  cwL = CHL[ri] * (1 - fr) + CHL[r2] * fr;
  rp = chw - dr; rp < 0 ? rp += CHSZ; ri = floor(rp); fr = rp - ri; r2 = ri + 1; r2 >= CHSZ ? r2 -= CHSZ;
  cwR = CHR[ri] * (1 - fr) + CHR[r2] * fr;
  xL = xL * (1 - 0.35 * cd_s) + cwR * 0.8 * cd_s;
  xR = xR * (1 - 0.35 * cd_s) + cwL * 0.8 * cd_s;
);
chw += 1; chw >= CHSZ ? chw = 0;

// ---------- autowah ----------
wm_s > 0.0005 ? (
  a_in = 0.5 * abs(xL + xR);
  wenv += (a_in - wenv) * (a_in > wenv ? envf_a : envf_r);
  w_mode == 0 ? (
    ctl = min(wenv * (1 + ws_s * 40), 1) ^ 0.6;
  ) : (
    wph += w_inc; wph -= floor(wph);
    ctl = 0.5 - 0.5 * cos(tp * wph);
    ctl *= 0.4 + 0.6 * ws_s;
  );
  wctl += (ctl - wctl) * wsm;                           // a WAH MODE change glides (2 ms), never jumps
  ctl = min(max(wctl + 0.15 * ins_fx, 0), 1);
  fc = min(250 * (2 ^ (1 + wr_s * 4)) ^ ctl, srate * 0.45);
  g = tan($pi * fc / srate); k = 1 / wq_s;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = xL - wL2; v1 = a1 * wL1 + a2 * v3; v2 = wL2 + a2 * wL1 + a3 * v3;
  wL1 = 2 * v1 - wL1; wL2 = 2 * v2 - wL2; yL = (v2 + 0.5 * v1) * wc_s;
  v3 = xR - wR2; v1 = a1 * wR1 + a2 * v3; v2 = wR2 + a2 * wR1 + a3 * v3;
  wR1 = 2 * v1 - wR1; wR2 = 2 * v2 - wR2; yR = (v2 + 0.5 * v1) * wc_s;
  xL = xL * (1 - wm_s) + yL * wm_s;
  xR = xR * (1 - wm_s) + yR * wm_s;
) : ( wL1 = wL2 = wR1 = wR2 = 0; wctl = 0; );

// ---------- volume + output stage (soft clip at -0.3 dB) ----------
vol_s += (vol_t - vol_s) * sm;
// ---------- FX row (Mod Rack) ----------
mrL = xL; mrR = xR;
mrOn ? ( mr_run(); xL = mrL; xR = mrR; );
oL = ostL.ost_band(xL * ptr_s) * vol_s;
oR = ostR.ost_band(xR * ptr_s) * vol_s;
ins_stereo(oL, oR); ost_out(ins_sl, ins_sr);           // mono-maker / widener, then the output stage
spl0 = ost_l;
spl1 = ost_r;

@gfx 960 614
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
ui_thm = 10; ui_hw = 1;
ui_begin(960, show_out ? 614 : 494);       // folded away, the module fills the window

AMB = 0xE8A33A; INKC = 0xD8D4CC; SOFTC = 0x7FB6E8; HARDC = 0xE8743A;
#vc_pm = "Soul Tine|Clean Tine|Suitcase|Gospel Wah|Neo Soul|Reed Bark|Reed Trem|Pluck Pop|Funk Clav|Sync Clav|Buzz 70s|Dirty Keys";
function pr_go(n) ( prs_dirty = n; pr_cur = n; );
// the panel's own copy of hard_amt (the audio side has its own: never one function on both threads)
function hard_amt_g(n) local(w, x) (
  w = 4 + slider25 / 100 * 120;
  x = min(max((n - slider24) / w + 0.5, 0), 1);
  x * x * (3 - 2 * x);
);
// LED-cap key (as the GUARD key, larger): returns 1 when clicked
function capbtn(x, y, w, h, on, ledc) local(hit, bx, by, kt) (
  hit = pressed && drag_id == 0 && mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  hit ? drag_id = -1;
  bx = x + w * 0.5; by = y + h * 0.26; kt = y + h * 0.5;
  ui_keyshadow(x, y, w, h, 2 * sc);
  ui_col(0x0E0E10); ui_rrs(x, y, w, h, 2 * sc);
  ui_col(0x232326); gfx_rect(x + 1 * sc, y + 1 * sc, w - 2 * sc, kt - y - 1 * sc);
  ui_cola(0xFFFFFF, 0.1); gfx_line(x + 2 * sc, y + 1 * sc, x + w - 3 * sc, y + 1 * sc);
  ui_col(0x313136); gfx_rect(x + 1 * sc, kt, w - 2 * sc, 1 * sc);
  ui_col(0x1A1A1D); gfx_rect(x + 4 * sc, kt + 4 * sc, w - 8 * sc, y + h - kt - 8 * sc);
  ui_cola(0xFFFFFF, 0.07); gfx_line(x + 4 * sc, kt + 4 * sc, x + w - 5 * sc, kt + 4 * sc);
  ui_cola(0x000000, 0.5);  gfx_line(x + 4 * sc, y + h - 4 * sc, x + w - 5 * sc, y + h - 4 * sc);
  ui_col(0x060607); gfx_circle(bx, by, 5.5 * sc, 1, 1);
  on ? (
    ui_cola(ledc, 0.22); gfx_circle(bx, by, 9 * sc, 1, 1);
    ui_col(ledc); gfx_circle(bx, by, 4.4 * sc, 1, 1);
    ui_cola(0xFFFFFF, 0.75); gfx_circle(bx - 1.2 * sc, by - 1.3 * sc, 1.3 * sc, 1, 1);
  ) : (
    ui_col(ui_mix(ledc, 0x000000, 0.78)); gfx_circle(bx, by, 4.4 * sc, 1, 1);
    ui_cola(0xFFFFFF, 0.18); gfx_circle(bx - 1.2 * sc, by - 1.3 * sc, 1.1 * sc, 1, 1);
  );
  hit;
);
function screw(x, y) local(rr) (
  rr = 4.5 * sc;
  ui_cola(0x000000, 0.4); gfx_circle(x + 1, y + 1.5, rr, 1, 1);
  ui_col(0x55585E); gfx_circle(x, y, rr, 1, 1);
  ui_col(0x6E7178); gfx_circle(x - rr * 0.2, y - rr * 0.2, rr * 0.6, 1, 1);
  ui_col(0x222326); gfx_line(x - rr * 0.7, y, x + rr * 0.7, y, 1);
);
function divider(x) (
  ui_cola(0x000000, 0.5); gfx_line(x * sc, 86 * sc, x * sc, 300 * sc);
  ui_cola(0xFFFFFF, 0.06); gfx_line(x * sc + 1, 86 * sc, x * sc + 1, 300 * sc);
);
function stitle(cx, s) ( gfx_setfont(12); ui_col(AMB); ui_text(cx * sc, 90 * sc, s); );

// ---------- faceplate ----------
ui_fitfont(12, 14 * sc);   // section titles
ui_fitfont(13, 13 * sc);   // key names, row labels
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
fh = show_out ? 596 : 476;
ui_cola(0x000000, 0.5); ui_rrect(14 * sc, 18 * sc, 936 * sc, fh * sc, 6 * sc);
ui_col(0x3A3B40); ui_rrect(12 * sc, 14 * sc, 936 * sc, fh * sc, 6 * sc);
gfx_gradrect(13 * sc, 15 * sc, 934 * sc, (fh - 2) * sc, 0.165, 0.169, 0.184, 1, 0, 0, 0, 0, -0.075 / ((fh - 2) * sc), -0.075 / ((fh - 2) * sc), -0.075 / ((fh - 2) * sc), 0);
ui_cola(0xFFFFFF, 0.12); gfx_line(18 * sc, 16 * sc, 942 * sc, 16 * sc);
screw(26 * sc, 28 * sc); screw(934 * sc, 28 * sc); screw(26 * sc, (fh + 2) * sc); screw(934 * sc, (fh + 2) * sc);

// brand + title
ui_col(AMB); gfx_circle(58 * sc, 44 * sc, 15 * sc, 1, 1);
gfx_setfont(2); ui_col(0x1A1206); ui_text(58 * sc, 37 * sc, "GFX");
gfx_setfont(6, "Trebuchet MS", 27 * sc, 'b'); ui_col(INKC); gfx_x = 84 * sc; gfx_y = 26 * sc; gfx_drawstr("VOCE 90");
gfx_setfont(13); ui_cola(INKC, 0.6); gfx_x = 86 * sc; gfx_y = 56 * sc; gfx_drawstr("ELECTRIC PIANO MODULE");

// preset bar
pk_lcdc = AMB;
pk_k = pk_preset(300 * sc, 24 * sc, 330 * sc, 34 * sc, pr_cur, #vc_pm);
pk_k > 0 ? pr_go(pk_k);

// header rule
ui_cola(0x000000, 0.55); gfx_rect(26 * sc, 74 * sc, 908 * sc, 2 * sc);
ui_cola(0xFFFFFF, 0.07); gfx_rect(26 * sc, 76 * sc, 908 * sc, 1 * sc);

// ---------- PIANOS: SOFT and HARD rows ----------
stitle(170, "PIANOS");
gv = 0;
loop(5,
  kx = 74 + gv * 50;
  gfx_setfont(13); ui_col(INKC);
  ui_text((kx + 21) * sc, 112 * sc, gv == 0 ? "TINE" : gv == 1 ? "REED" : gv == 2 ? "PLUCK" : gv == 3 ? "CLAV" : "BUZZ");
  capbtn(kx * sc, 130 * sc, 42 * sc, 44 * sc, slider1 == gv, SOFTC) ? ( slider1 = gv; slider_automate(1); );
  capbtn(kx * sc, 184 * sc, 42 * sc, 44 * sc, slider15 == gv, HARDC) ? ( slider15 = gv; slider_automate(16384); );
  gv += 1;
);
gfx_setfont(13);
ui_col(SOFTC); gfx_x = 30 * sc; gfx_y = 146 * sc; gfx_drawstr("SOFT");
ui_col(HARDC); gfx_x = 30 * sc; gfx_y = 200 * sc; gfx_drawstr("HARD");

// velocity strip: how much of each piano a note gets, velocity 1 .. 127 left to right; the last note marked
vx = 30; vw = 286; vy = 244; vh = 50;
ui_col(0x050505); ui_rrect((vx - 3) * sc, (vy - 3) * sc, (vw + 6) * sc, (vh + 6) * sc, 3 * sc);
ui_col(0x141518); gfx_rect(vx * sc, vy * sc, vw * sc, vh * sc);
ui_cola(0xFFFFFF, 0.06); gfx_line(vx * sc, (vy + vh * 0.5) * sc, (vx + vw) * sc, (vy + vh * 0.5) * sc);
same = slider1 == slider15;
px = 0;
loop(floor(vw / 2) + 1,
  vn = 1 + px / vw * 126;
  gh = same ? 0 : hard_amt_g(vn);
  ga = cos(gh * $pi * 0.5); gb = sin(gh * $pi * 0.5);
  same ? ( ga = 1; gb = 0; );
  ya = (vy + vh - 3 - ga * (vh - 8)) * sc; yb = (vy + vh - 3 - gb * (vh - 8)) * sc;
  px > 0 ? (
    ui_col(SOFTC); ui_ssline(pxs, pya, (vx + px) * sc, ya, 1.6 * sc, 1);
    !same ? ( ui_col(HARDC); ui_ssline(pxs, pyb, (vx + px) * sc, yb, 1.6 * sc, 1); );
  );
  pxs = (vx + px) * sc; pya = ya; pyb = yb;
  px += 2;
);
last_vel_d > 0 ? (
  mx = (vx + (last_vel_d - 1) / 126 * vw) * sc;
  ui_cola(AMB, 0.8); gfx_line(mx, (vy + 2) * sc, mx, (vy + vh - 2) * sc);
  ui_cola(AMB, 0.8); gfx_line(mx + 1, (vy + 2) * sc, mx + 1, (vy + vh - 2) * sc);
);

// ---------- effect sections ----------
C_INK = INKC;
ui_section(2);
// pastel desk-knob caps, one shade per section (JG, 29 Oct 2026)
P_VEL = 0xA48FD6; P_DRV = 0xF6D2AE; P_VIB = 0x86C49C; P_CHO = 0xBCD8F2; P_WAH = 0xF4C2CF; P_MST = 0xE2E0DA;   // VELOCITY, VIBRATO darker; MASTER plain (JG)
divider(330); stitle(380, "VELOCITY");
ui_kdesk = P_VEL; ui_knob(380 * sc, 150 * sc, 24, 1, 127, 90, 0, "SPLIT", "%.0f");
ui_kdesk = P_VEL; ui_knob(380 * sc, 244 * sc, 25, 0, 100, 40, 0, "BLEND", "%.0f%%");
divider(430); stitle(475, "DRIVE");
ui_kdesk = P_DRV; ui_knob(475 * sc, 150 * sc, 2, 0, 100, 20, 0, "DRIVE", "%.0f%%");
ui_kdesk = P_DRV; ui_knob(475 * sc, 244 * sc, 3, 0, 100, 55, 0, "TONE", "%.0f%%");
divider(520); stitle(565, "VIBRATO");
ui_kdesk = P_VIB; ui_knob(565 * sc, 150 * sc, 4, 0.5, 10, 4, 1, "RATE", "%.2f Hz");
ui_kdesk = P_VIB; ui_knob(565 * sc, 244 * sc, 5, 0, 100, 30, 0, "DEPTH", "%.0f%%");
divider(610); stitle(655, "CHORUS");
ui_kdesk = P_CHO; ui_knob(655 * sc, 150 * sc, 6, 0, 100, 20, 0, "DEPTH", "%.0f%%");
ui_kdesk = P_CHO; ui_knob(655 * sc, 244 * sc, 7, 0.1, 5, 0.6, 1, "RATE", "%.2f Hz");
divider(700); stitle(772, "AUTOWAH");
ui_kdesk = P_WAH; ui_knob(737 * sc, 150 * sc, 8, 0, 100, 60, 0, "SENS", "%.0f%%");
ui_kdesk = P_WAH; ui_knob(807 * sc, 150 * sc, 9, 0, 100, 60, 0, "RANGE", "%.0f%%");
ui_kdesk = P_WAH; ui_knob(737 * sc, 244 * sc, 10, 0, 100, 55, 0, "Q", "%.0f%%");
ui_kdesk = P_WAH; ui_knob(807 * sc, 244 * sc, 11, 0, 100, 60, 0, "MIX", "%.0f%%");
// wah mode: a display box, click for the menu
mbx = 748; mby = 194; mbw = 48; mbh = 20;
ui_col(0x050505); ui_rrect(mbx * sc, mby * sc, mbw * sc, mbh * sc, 2 * sc);
gfx_setfont(13); ui_col(AMB);
ui_text((mbx + mbw * 0.5) * sc, (mby + 3) * sc, slider12 == 0 ? "ENV" : slider12 == 1 ? "1/4" : slider12 == 2 ? "1/8" : "1/16");
pressed && drag_id == 0 && mouse_x >= mbx * sc && mouse_x < (mbx + mbw) * sc && mouse_y >= mby * sc && mouse_y < (mby + mbh) * sc ? (
  drag_id = -1;
  #wm = ""; strcat(#wm, slider12 == 0 ? "!ENV|" : "ENV|"); strcat(#wm, slider12 == 1 ? "!1/4|" : "1/4|");
  strcat(#wm, slider12 == 2 ? "!1/8|" : "1/8|"); strcat(#wm, slider12 == 3 ? "!1/16" : "1/16");
  gfx_x = mbx * sc; gfx_y = (mby + mbh) * sc; wm_k = gfx_showmenu(#wm);
  wm_k > 0 ? ( slider12 = wm_k - 1; slider_automate(2048); );
);
divider(844); stitle(892, "MASTER");
ui_kdesk = P_MST; ui_knob(892 * sc, 150 * sc, 13, 0, 100, 25, 0, "DRIFT", "%.0f%%");
ui_kdesk = P_MST; ui_knob(892 * sc, 244 * sc, 14, -24, 6, 0, 0, "VOLUME", "%.1f dB");

// ---------- FX row: the Mod Rack's four units (as in M1K) ----------
// a small lamp key (design units): lit = amber lens, dark legend; returns 1 when clicked
function fx_key(x, y, w, h, on, t) local(hit) (
  hit = pressed && drag_id == 0 && mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit ? drag_id = -1;
  ui_keyshadow(x * sc, y * sc, w * sc, h * sc, 2 * sc);
  ui_col(0x060607); ui_rrect(x * sc, y * sc, w * sc, h * sc, 3 * sc);
  on ? (
    ui_cola(AMB, 0.25); ui_rrect((x - 2) * sc, (y - 2) * sc, (w + 4) * sc, (h + 4) * sc, 4 * sc);
    ui_col(AMB); ui_rrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc, 2 * sc);
    ui_cola(0xFFF0C8, 0.45); ui_rrect((x + 5) * sc, (y + 4) * sc, (w - 10) * sc, (h - 10) * sc, 2 * sc);
    ui_col(0x2A1A06);
  ) : (
    ui_col(0x3A3226); ui_rrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 4) * sc, 2 * sc);
    ui_col(0xBDB4A4);
  );
  gfx_setfont(13); ui_text((x + w * 0.5) * sc, (y + h * 0.5) * sc - gfx_texth * 0.5, t);
  hit;
);
function fx_div(i, md) (
  strcpy(#fxd, i == 0 ? "4 BARS" : i == 1 ? "2 BARS" : i == 2 ? "1 BAR" : i == 3 ? "1/2" : i == 4 ? "1/4" : i == 5 ? "1/8" : i == 6 ? "1/16" : "1/32");
  md == 2 ? strcat(#fxd, " D") : md == 3 ? strcat(#fxd, " T"); #fxd;
);
// the SYNC box under a RATE / TIME knob: FREE, or the note value; click for the menu
function fx_sync(cx, y, b) local(md, x, w, k, j, t) (
  md = floor(slider(b + 7) + 0.5); w = 76; x = cx - w * 0.5;
  ui_col(0x050505); ui_rrect(x * sc, y * sc, w * sc, 22 * sc, 2 * sc);
  gfx_setfont(13); ui_col(md > 0 ? AMB : INKC);
  ui_text(cx * sc, (y + 11) * sc - gfx_texth * 0.5, md > 0 ? fx_div(slider(b + 8), md) : "FREE");
  pressed && drag_id == 0 && mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + 22) * sc ? (
    drag_id = -1;
    strcpy(#fxm, md == 0 ? "!Free|" : "Free|");
    j = 1; loop(3,
      strcat(#fxm, j == 1 ? ">Straight|" : j == 2 ? ">Dotted|" : ">Triplet|");
      k = 0; loop(8,
        k == 7 ? strcat(#fxm, "<"); md == j && floor(slider(b + 8) + 0.5) == k ? strcat(#fxm, "!");
        strcat(#fxm, k == 0 ? "4 bars" : k == 1 ? "2 bars" : k == 2 ? "1 bar" : k == 3 ? "1/2" : k == 4 ? "1/4" : k == 5 ? "1/8" : k == 6 ? "1/16" : "1/32");
        strcat(#fxm, "|"); k += 1; );
      j += 1; );
    gfx_x = x * sc; gfx_y = (y + 22) * sc; t = gfx_showmenu(#fxm);
    t == 1 ? ( slider(b + 7) = 0; slider_automate(2 ^ (b + 6)); );
    t > 1 ? (
      slider(b + 7) = 1 + floor((t - 2) / 8); slider(b + 8) = (t - 2) % 8;
      slider_automate(2 ^ (b + 6) + 2 ^ (b + 7));
    );
  );
);
// a coloured-cap knob; dim = the knob is greyed and can't be moved (its rate follows the tempo)
function fx_knob(cx, cy, idx, lo, hi, def, lg, lbl, fmt, cap, dim) local(v, n, rr) (
  dim ? (
    v = slider(idx); n = lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo);
    ui_kcap_d = 4; rr = ui_knob_cap(cx * sc, cy * sc, 16 * sc, -0.75 * $pi + n * 1.5 * $pi, 0, cap); ui_kcap_d = 0;
    ui_cola(0x232428, 0.55); gfx_circle(cx * sc, cy * sc, rr + 7 * sc, 1, 1);
    gfx_setfont(2); ui_cola(INKC, 0.45); ui_text(cx * sc, cy * sc + rr + 6 * sc, lbl);
  ) : (
    ui_kcap = cap; ui_kcap_r = 16; ui_kcap_d = 4; ui_knob(cx * sc, cy * sc, idx, lo, hi, def, lg, lbl, fmt);   // coloured-cap knobs, five scale dots (JG)
  );
);
// one unit: b = its first slider, kind 0 tremolo, 1 chorus, 2 vibe, 3 delay
function fx_mod(x, w, b, kind, cap) local(y, n, st, a, md, k) (
  y = 314;
  ui_col(0x1E1F23); ui_rrect(x * sc, y * sc, w * sc, 148 * sc, 4 * sc);
  ui_cola(0x000000, 0.35); gfx_rect(x * sc, y * sc, w * sc, 1 * sc);
  gfx_setfont(12); ui_col(AMB); gfx_x = (x + 12) * sc; gfx_y = (y + 9) * sc;
  gfx_drawstr(kind == 0 ? "TREMOLO" : kind == 1 ? "CHORUS" : kind == 2 ? "VIBE" : "DELAY");
  ui_col(cap); gfx_rect((x + 12) * sc, (y + 28) * sc, 24 * sc, 3 * sc);
  k = 0; loop(3,
    fx_key(x + w - 96 + k * 30, y + 7, 26, 22, slider(b + 4 + k) > 0.5, k == 0 ? "L" : k == 1 ? "C" : "R") ? (
      slider(b + 4 + k) = slider(b + 4 + k) > 0.5 ? 0 : 1;
      slider_automate(2 ^ (b + 3 + k));
    );
    k += 1; );
  md = slider(b + 7) > 0.5;
  n = kind == 1 || kind == 3 ? 4 : 3; st = (w - 16) / n; a = x + 8 + st * 0.5;
  kind == 3 ? fx_knob(a, y + 70, b, 20, 1500, 350, 1, "TIME", "%.0f ms", cap, md)
            : fx_knob(a, y + 70, b, kind == 1 ? 0.05 : 0.1, kind == 1 ? 8 : kind == 0 ? 15 : 12, kind == 1 ? 0.8 : kind == 0 ? 4 : 1.5, 1, "RATE", "%.2f Hz", cap, md);
  fx_sync(a, y + 116, b);
  a += st;
  kind == 3 ? fx_knob(a, y + 70, b + 1, 0, 95, 30, 0, "FDBK", "%.0f%%", cap, 0)
            : fx_knob(a, y + 70, b + 1, 0, 100, kind == 1 ? 50 : 0, 0, "DEPTH", "%.0f%%", cap, 0);
  a += st;
  n == 4 ? ( fx_knob(a, y + 70, b + 2, 0, 100, 0, 0, "MIX", "%.0f%%", cap, 0); a += st; );
  fx_knob(a, y + 70, b + 3, 0, 100, 0, 0, kind == 0 ? "CHOP" : kind == 1 ? "STRETCH" : kind == 2 ? "LAMP" : "RUNAWAY", "%.0f%%", cap, 0);
);
ui_cola(0x000000, 0.5); gfx_line(26 * sc, 306 * sc, 934 * sc, 306 * sc);
ui_cola(0xFFFFFF, 0.06); gfx_line(26 * sc, 307 * sc, 934 * sc, 307 * sc);
ui_section(2);
fx_mod(26, 196, 35, 0, 0xC9A227); fx_mod(227, 250, 26, 1, 0x3F7FC0); fx_mod(482, 196, 44, 2, 0x2E9A8E); fx_mod(683, 250, 53, 3, 0xD0603E);

// MIDI activity LED (header, right of the preset bar)
lit = ins_midi_lit();
lit ? ( ui_cola(0x3ADF6A, 0.25); gfx_circle(694 * sc, 41 * sc, 5.5 * sc, 1, 1); ui_col(0x3ADF6A); )
    : ui_col(0x123A1C);
gfx_circle(694 * sc, 41 * sc, 2.8 * sc, 1, 1);
gfx_setfont(13); ui_cola(INKC, 0.7); gfx_x = 654 * sc; gfx_y = 34 * sc; gfx_drawstr("MIDI");

// ---------- output stage: OUTPUT key folds the panel out below the module ----------
capbtn(736 * sc, 22 * sc, 26 * sc, 34 * sc, show_out, AMB) ? show_out = !show_out;
gfx_setfont(13); ui_col(INKC); gfx_x = 768 * sc; gfx_y = 33 * sc; gfx_drawstr("OUTPUT");
ui_size_picker(878 * sc, 30 * sc);
show_out ? (
  ui_cola(0x000000, 0.5); gfx_line(26 * sc, 478 * sc, 934 * sc, 478 * sc);
  ui_cola(0xFFFFFF, 0.06); gfx_line(26 * sc, 479 * sc, 934 * sc, 479 * sc);
  ins_stereo_box(220, 488, 22, 0x1E1F23, INKC);
  ins_output_tray(410, 488, 16, 0x1E1F23, INKC, 0xFF3A2A);
);

ui_end();
