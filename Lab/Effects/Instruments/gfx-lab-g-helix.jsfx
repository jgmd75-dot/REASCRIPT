desc:Helix [endless-rise synth] (GFX Lab)
//tags: instrument synth endless rise fall glide steps illusion pad drone
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-sliders, gfx-lab-warmup, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider22:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Glide,Steps}>-Motion
slider2:1<0,2,1{Still,Up,Down}>-Direction
slider3:1<0.02,12,0.01>-Rate (semitones per second)
slider4:0<0,1,1{Off,On}>-Tempo sync
slider5:5<0,10,1{1/32,1/16T,1/16,1/8T,1/16D,1/8,1/8D,1/4,1/4D,1/2,1 bar}>-Synced step (one semitone)
slider6:440<110,3300,1>-Centre (Hz)
slider7:1.6<0.5,4,0.01>-Width (octaves)
slider8:0<0,100,0.1>-Tone (%)
slider9:60<0,100,0.1>-Spread (%)
slider10:30<1,4000,1>-Attack (ms)
slider11:900<20,8000,1>-Release (ms)
slider12:60<0,100,0.1>-Reverb size (%)
slider13:25<0,100,0.1>-Reverb mix (%)
slider14:50<0,100,0.1>-Drift (%)
slider15:0<-24,6,0.1>-Volume (dB)
slider16:0<0,16,1>-MIDI channel (0 = omni)
slider17:2<0,12,1>-Pitch bend range (semitones)
slider18:0<0,3,1{Sine,Strings,Pad,Glow}>-Engine
slider19:22000<110,22000,1>-Cutoff (Hz)
slider20:0<0,100,0.1>-Resonance (%)
slider21:prs_sel=0<0,12,1{No preset,Endless Rise,Endless Stair,Falling Stair,Long Climb,Slow Descent,Still Organ,Siren Loop,Slow Vortex,Glass Helix,Deep Well,Clock Steps,Bright Reed}>-Preset

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-helix";
ext_noinit = 1;

ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
HXDEF = 1000; HXTMP = 1100;
VOX = 10000; VS = 128; NVO = 8; NL = 10; LB = 16; LS = 8; WU = 110;
MQ = 12000; MQN = 512;
DSP = 14000;
SPCK = 15000; SPB = 15200;
HRV = 1100000; HRN = 16384; HRM = 16383;
HAP = 1240000; HAPN = 4096; HAPM = 4095;
HPD = 1260000; HPDM = 16383;
CHB = 1280000; CHM = 8191; GA = 16000; GB = 16300;
memset(VOX, 0, NVO * VS); memset(MQ, 0, 4 * MQN); memset(DSP, 0, 2 * NVO * NL + 16);
memset(CHB, 0, 8192); memset(HRV, 0, 8 * HRN); memset(HAP, 0, 4 * HAPN); memset(HPD, 0, 16384);
TWOPI = 2 * $pi; TK = 16; HXF0 = 16.3516;

function hx_tab(dst, a1, a2, a3, a4, a5, a6, a7, a8) local(i, t, y, m) (
  m = 0; i = 0;
  loop(256, t = i / 256 * 2 * $pi;
    y = a1 * sin(t) + a2 * sin(2 * t) + a3 * sin(3 * t) + a4 * sin(4 * t) + a5 * sin(5 * t) + a6 * sin(8 * t) + a7 * sin(12 * t) + a8 * sin(16 * t);
    dst[i] = y; m = max(m, abs(y)); i += 1; );
  i = 0; loop(256, dst[i] = floor(dst[i] / m * 127 + 0.5) / 127; i += 1; );
);
hx_tab(GA, 1, 0.5, 0, 0.3, 0, 0.18, 0, 0.1);
hx_tab(GB, 1, 0.25, 0.6, 0.2, 0.45, 0.3, 0.25, 0.15);
#hx_def = "0 1 1 0 5 440 1.6 0 60 30 900 60 25 50 0 0 2 0 22000 0";
function hx_nums(s, dst) local(i, n, c, len, acc, neg, fr, fsc, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; fsc = 1; neg = 0; );
      fr ? ( fsc *= 0.1; acc += (c - 48) * fsc; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; fsc = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; fsc = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
hx_nums(#hx_def, HXDEF);
#hx_pm = "Endless Rise|Endless Stair|Falling Stair|Long Climb|Slow Descent|Still Organ|Siren Loop|Slow Vortex|Glass Helix|Deep Well|Clock Steps|Bright Reed";
hx_npre = 12;
function hx_pstr(p) (
  p == 1 ? "" :
  p == 2 ? "1:1 3:2 8:15 10:20" :
  p == 3 ? "1:1 2:2 3:2 8:15 10:20" :
  p == 4 ? "3:0.35 6:550 7:1.9 8:20 9:70 10:600 11:2500 12:75 13:30 18:1 19:5500" :
  p == 5 ? "2:2 3:0.5 6:330 7:1.7 8:45 9:55 10:400 11:2000 12:70 13:25 18:2 19:3300 20:20" :
  p == 6 ? "2:0 6:330 7:1.2 8:30 9:40 10:8 11:350 12:35 13:15 18:3" :
  p == 7 ? "3:7 6:880 7:1.3 8:20 9:80 10:60 11:1200 12:55" :
  p == 8 ? "2:2 3:0.06 7:2.4 8:60 9:90 10:2500 11:6000 12:95 13:40 18:2 19:2200 20:35" :
  p == 9 ? "3:0.8 6:1650 7:0.9 8:80 9:85 10:300 11:3000 12:80 13:35 18:3" :
  p == 10 ? "2:2 3:0.4 6:110 7:1.5 8:40 9:50 10:500 11:3000 12:70 13:25 18:1 19:3300" :
  p == 11 ? "1:1 4:1 5:5 6:660 7:1.5 8:50 9:70 10:5 11:500 12:50 13:22 18:3" :
  p == 12 ? "1:1 2:2 3:3 6:770 7:1.4 8:100 9:50 10:10 11:600 12:45 13:20" :
  "";
);
function load_preset(p) local(n, i) (
  i = 0; loop(20, i < 13 || i >= 17 ? slider(i + 1) = HXDEF[i]; i += 1; );
  n = hx_nums(hx_pstr(p), HXTMP);
  i = 0; loop(floor(n / 2), (HXTMP[i * 2] >= 1 && HXTMP[i * 2] <= 13) || (HXTMP[i * 2] >= 18 && HXTMP[i * 2] <= 20) ? slider(HXTMP[i * 2]) = HXTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(20, slider_automate(2 ^ (i - 1)); i += 1; );
);

function hx_div(i) ( i == 0 ? 0.125 : i == 1 ? 1 / 6 : i == 2 ? 0.25 : i == 3 ? 1 / 3 : i == 4 ? 0.375 : i == 5 ? 0.5 :
                     i == 6 ? 0.75 : i == 7 ? 1 : i == 8 ? 1.5 : i == 9 ? 2 : hx_bpb; );

function hx_update() local(d) (
  hx_tmp = tempo > 0 ? tempo : 120;
  hx_bpb = (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  hx_md = slider1 >= 0.5;
  d = floor(slider2 + 0.5); hx_dv = d == 1 ? 1 : d == 2 ? -1 : 0;
  hx_sy = slider4 >= 0.5;
  hx_dq = hx_div(floor(slider5 + 0.5));
  hx_vt = hx_sy ? hx_dv * hx_tmp / 60 / hx_dq / 12 : hx_dv * slider3 / 12;
  hx_lct = log(slider6 / HXF0) / log(2);
  hx_wdt = slider7;
  hx_tnt = slider8 / 100;
  hx_spt = slider9 / 100;
  hx_ka = 1 - exp(-1.47 / (max(slider10, 1) * 0.001 * srate));
  hx_kr = exp(-6.9 / (max(slider11, 20) * 0.001 * srate));
  hx_rsz = slider12 / 100; hx_rmx = slider13 / 100;
  hx_dra = slider14 / 50;
  hx_volt = 10 ^ (slider15 / 20) * 0.115;
  hx_chan = floor(slider16 + 0.5);
  hx_pbr = slider17;
  hx_engt = min(max(floor(slider18 + 0.5), 0), 3);
  hx_fct = log(min(max(slider19, 110), 22000)); hx_frt = slider20 / 100;
  hx_rdec = 1.6 + 10 * hx_rsz * hx_rsz;
  d = srate / 1000 * (0.6 + 1.3 * hx_rsz);
  HXTMP[180] = min(37.1 * d, HRN - 40); HXTMP[181] = min(41.3 * d, HRN - 40); HXTMP[182] = min(47.9 * d, HRN - 40);
  HXTMP[183] = min(53.3 * d, HRN - 40); HXTMP[184] = min(59.7 * d, HRN - 40); HXTMP[185] = min(67.1 * d, HRN - 40);
  HXTMP[186] = min(73.9 * d, HRN - 40); HXTMP[187] = min(81.7 * d, HRN - 40);
  ost_setup(0, 0, 120, 6000, -0.3, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
);

function hx_srinit() (
  hx_sr = srate; ost_init(0);
  hx_kv = 1 - exp(-TK / (0.35 * srate));
  hx_kg = 1 - exp(-TK / (0.005 * srate));
  hx_sk = 1 - exp(-TK / (0.03 * srate));
  hx_ck = 1 - exp(-TK / (0.12 * srate));
  hx_sm = 1 - exp(-1 / (0.03 * srate));
  hx_fik = 1 / (0.002 * srate);
  hx_fgk = 1 / (0.003 * srate);
  hx_fik2 = 1 - exp(-1 / (0.02 * srate));
  hx_edk = 1 / (0.006 * srate); hx_chk = 1 - exp(-1 / (0.05 * srate));
  hx_crs = TWOPI * 0.63 / srate; hx_crf = TWOPI * 5.7 / srate; hx_cds = 0.0013 * srate; hx_cdf = 0.0003 * srate; hx_cjr = 0.513 / srate;
  hx_rdmp = 1 - exp(-TWOPI * 5200 / srate);
  hx_rhk = 1 - exp(-TWOPI * 140 / srate);
  HXTMP[190] = min(floor(4.77 * srate / 1000), HAPN - 2); HXTMP[191] = min(floor(3.59 * srate / 1000), HAPN - 2);
  HXTMP[192] = min(floor(12.73 * srate / 1000), HAPN - 2); HXTMP[193] = min(floor(9.31 * srate / 1000), HAPN - 2);
  hx_pdn = floor(0.02 * srate);
  hx_rslm = HRN + floor(1.5 * srate);
  nw_setup(40, 2500, 0.9, 0.2);
  hx_update();
  hx_vs = hx_vt;
  hx_first = 1;
);

function hx_rl(base, n, gn, m) instance(z) local(rp, ri, f, d) (
  m != 0 ? ( rp = hx_rw - n - m; ri = floor(rp); f = rp - ri; d = base[ri & HRM]; d += (base[(ri + 1) & HRM] - d) * f; ) :
           d = base[(hx_rw - n) & HRM];
  z += (d - z) * hx_rdmp;
  z * gn;
);
function hx_ap(base, n, x, k) instance(wp) local(d, v) (
  d = base[(wp - n) & HAPM]; v = x + k * d; abs(v) < 0.000000000001 ? v = 0; base[wp] = v; wp = (wp + 1) & HAPM;
  d - k * v;
);

function hx_vcalc(q, snap) local(x, j, l, xj, f, a, d, e, s2, nm, t, sr45) (
  x = hx_gs + q[2] + q[8] * hx_dra + hx_pdr + hx_pbs;
  sr45 = 0.45 * srate; s2 = 0;
  j = 0; l = q + LB;
  loop(NL,
    xj = j + x; xj -= NL * floor(xj / NL);
    f = HXF0 * 2 ^ xj;
    d = (xj - hx_lc) / hx_wd; a = exp(-0.5 * d * d);
    e = min(xj / 1.2, (NL - xj) / 1.2); e = min(max(e, 0), 1); a *= e * e * (3 - 2 * e);
    hx_eng == 1 || hx_eng == 2 ? ( f > 0.18 * srate ? a *= max(0, (0.28 * srate - f) / (0.1 * srate)); ) :
    f > 0.38 * srate ? a *= max(0, (sr45 - f) / (sr45 - 0.38 * srate));
    a < 0.0003 ? a = 0;
    hx_eng == 0 ? ( t = 2 * $pi * min(f, sr45) / srate; l[2] = cos(t); l[3] = sin(t); ) : l[2] = min(f, sr45) / srate;
    l[6] = hx_tn * min(max((sr45 - 3 * f) / (0.05 * srate), 0), 1);
    l[7] = hx_tn * min(max((sr45 - 5 * f) / (0.05 * srate), 0), 1);
    HXTMP[200 + j] = a; s2 += a * a;
    DSP[(q - VOX) / VS * NL + j] = xj;
    l += LS; j += 1;
  );
  nm = 1 / sqrt(max(s2, 0.05)) * (hx_eng == 0 ? 1 / (1 + 0.45 * hx_tn) : hx_eng == 1 ? 1.2 : hx_eng == 2 ? 1.18 : 1.1);
  j = 0; l = q + LB;
  loop(NL,
    a = HXTMP[200 + j] * nm;
    snap ? ( l[4] = a; l[5] = 0; ) : l[5] = (a - l[4]) / TK;
    l += LS; j += 1;
  );
);

function hx_vstart(q, n, vel) local(j, l, a) (
  q[0] = 1; q[1] = n; q[2] = (n % 12) / 12; q[3] = 0; q[4] = vel; q[5] = hx_age; hx_age += 1;
  q[6] = 0; q[7] = 1; q[9] = -1; q[11] = 0; q[12] = 0;
  q[8] = (rand(1) * 2 - 1) * 0.005;
  j = 0; l = q + LB;
  loop(NL, a = rand(1) * TWOPI; hx_eng == 0 ? ( l[0] = cos(a); l[1] = sin(a); ) : l[0] = rand(1); l[2] = 1; l[3] = 0; l[4] = 0; l[5] = 0; l[6] = 0; l[7] = 0; l += LS; j += 1; );
  nw_start(q + WU);
  hx_vcalc(q, 1);
);
function hx_relayer() local(i, q, j, l, a) (
  i = 0;
  loop(NVO, q = VOX + i * VS;
    q[0] > 0 ? (
      l = q + LB; j = 0;
      loop(NL, a = rand(1) * TWOPI; hx_eng == 0 ? ( l[0] = cos(a); l[1] = sin(a); ) : ( l[0] = rand(1); l[1] = 0; ); l += LS; j += 1; );
      hx_vcalc(q, 1);
    );
    i += 1; );
);
function hx_blep(t, dt) ( t < dt ? ( t /= dt; t + t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0; );
function hx_non(n, vel) local(q, i, best, bv, fr, rel) (
  q = 0; i = 0; fr = 0;
  loop(NVO, best = VOX + i * VS; best[0] > 0 && best[1] == n && !best[12] ? q = best; i += 1; );
  q ? (
    q[0] = 1; q[4] = vel; q[6] = 0; q[5] = hx_age; hx_age += 1;
  ) : (
    i = 0; loop(NVO, best = VOX + i * VS; !fr && best[0] == 0 ? fr = best; i += 1; );
    fr ? hx_vstart(fr, n, vel) : (
      rel = 0; bv = 10; i = 0;
      loop(NVO, best = VOX + i * VS; best[0] == 2 && best[3] < bv ? ( bv = best[3]; rel = best; ); i += 1; );
      !rel ? ( bv = 10000000000; i = 0; loop(NVO, best = VOX + i * VS; best[5] < bv ? ( bv = best[5]; rel = best; ); i += 1; ); );
      rel[12] = 1; rel[9] = n; rel[10] = vel;
    );
  );
);
function hx_noff(n) local(q, i) (
  i = 0;
  loop(NVO, q = VOX + i * VS;
    q[0] == 1 && q[1] == n ? ( hx_ped ? q[6] = 1 : q[0] = 2; );
    q[12] && q[9] == n ? q[9] = -1;
    i += 1; );
);
function hx_pedup() local(q, i) ( i = 0; loop(NVO, q = VOX + i * VS; q[0] == 1 && q[6] ? ( q[0] = 2; q[6] = 0; ); i += 1; ); );
function hx_allup() local(q, i) ( i = 0; loop(NVO, q = VOX + i * VS; q[0] == 1 ? ( q[0] = 2; q[6] = 0; ); q[9] = -1; i += 1; ); hx_ped = 0; );
function hx_midi(m1, m2, m3) local(st) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? ( hx_non(m2, (0.35 + 0.65 * m3 / 127)); mi_led_d = 1; ) :
  st == 0x80 || (st == 0x90 && m3 == 0) ? hx_noff(m2) :
  st == 0xE0 ? hx_pbt = ((m3 * 128 + m2) - 8192) / 8192 * hx_pbr / 12 :
  st == 0xB0 ? (
    m2 == 1 ? hx_whv = m3 / 127 :
    m2 == 64 ? ( hx_ped = m3 >= 64; !hx_ped ? hx_pedup(); ) :
    (m2 == 120 || m2 == 123) ? hx_allup();
  );
);

function hx_clear() local(i, q) (
  memset(HRV, 0, 8 * HRN); memset(HAP, 0, 4 * HAPN); memset(HPD, 0, 16384);
  hr0.z = hr1.z = hr2.z = hr3.z = hr4.z = hr5.z = hr6.z = hr7.z = 0;
  i = 0; loop(NVO, q = VOX + i * VS; q[0] = 0; i += 1; );
  hx_dcyl = hx_dcyr = hx_dcxl = hx_dcxr = 0; hx_fl1 = hx_fl2 = hx_fr1 = hx_fr2 = 0; memset(CHB, 0, 8192); hx_rsil = hx_rslm; hx_fin = 0; hx_mqn = 0; hx_mqr = 0;
);

pwr_init(); pwr_wu_loss = 0.2; pwr_wu_drv = 0.2; pwr_wu_lp = 13000; pwr_bloom = 0; pwr_hum_db = -83;
hxD1.drift_init(1); hxD2.drift_init(0.8); hxD3.drift_init(1.2);
hx_ct = TK - 1; hx_cmp = 1; hx_graw = 0; hx_gs = 0; hx_age = 0; hx_ped = 0; hx_whl = hx_whv = 0; hx_pbt = hx_pbs = 0;
hx_rw = 0; hx_pdw = 0; hx_rsil = 0; hx_fin = 1; hx_mqn = 0; hx_mqr = 0; hx_lock = 0;
hx_srinit();
hx_eng = hx_engt; hx_egn = 1; hx_chs = 1; hx_flc = hx_fct; hx_frs = hx_frt;
hx_lc = hx_lct; hx_wd = hx_wdt; hx_tn = hx_tnt; hx_spr = hx_spt; hx_vol = hx_volt;
hx_rsil = hx_rslm;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(20, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
hx_update();

@block
prs_chk();
srate != hx_sr ? hx_srinit();
hx_now = time_precise();
hx_tp > 0 && hx_now - hx_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > hx_gpp && play_position - hx_gpp < 4 * hx_gpd + 0.05) ? hx_clear();
hx_tp = hx_now; hx_gpp = play_position; hx_gpd = samplesblock / srate;
pwr_block(1);
hx_update();
hx_xp = play_state & 1;
hx_xpw && !hx_xp ? hx_allup();
hx_xpw = hx_xp;

hx_lk = hx_sy && hx_xp && hx_dv != 0;
hx_bp0 = beat_position; hx_bps = hx_tmp / 60 / srate;
hx_lkey = hx_dv * 100 + hx_dq;
hx_lk && (!hx_lock || hx_lkey != hx_lkl) ? (
  hx_off = hx_graw - hx_dv * hx_bp0 / hx_dq / 12;
  hx_off = floor(hx_off * 12 + 0.5) / 12;
);
hx_lock = hx_lk; hx_lkl = hx_lkey;

hx_mqn = 0; hx_mqr = 0; hx_si = 0;
while (midirecv(mofs, m1, m2, m3)) (
  (hx_chan == 0 || (m1 & 15) + 1 == hx_chan) && hx_mqn < MQN ? (
    hx_q = MQ + hx_mqn * 4; hx_q[0] = mofs; hx_q[1] = m1; hx_q[2] = m2; hx_q[3] = m3; hx_mqn += 1;
  );
  midisend(mofs, m1, m2, m3);
);

hx_bi = samplesblock / srate;
hx_pdr = hxD1.drift_tick(0.05 * hx_bi) * 0.0167 * hx_dra + hxD3.drift_tick(0.11 * hx_bi) * 0.004 * hx_dra;
hx_cdr = hxD2.drift_tick(0.03 * hx_bi) * 0.3 * hx_dra;

