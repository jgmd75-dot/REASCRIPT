@init
function psw_all(v) ( slider_show(72057594037927935, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(72057594037927935, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-tunne";
ext_noinit = 1;

JZ = 1000; MO = 1030;
NMAP = 1100; NVEL = 1240;
LV = 1400; LPOS = 1420; LSND = 1440; LT = 1460; VTR = 1480; VDW = 1500; VDT = 1520; VGS = 1540; VPL = 1560; VPR = 1580; VPT = 1600;
HQ = 2000;
PAT = 4000;
LIB = 250000;
SLN = 11000;
SQO = 11200; SQL = 11500; SQV = 11800;
MBK = 640;
MBASE = 20000;
WT = 32000;
ERB = 40000; ERN = 65536;
FDB = 110000; FDN = 32768;
ostL.ost_ch_init(); ostR.ost_ch_init();

JZ[0]=2.405; JZ[1]=3.832; JZ[2]=5.136; JZ[3]=5.520; JZ[4]=6.380; JZ[5]=7.016; JZ[6]=7.588; JZ[7]=8.417;
JZ[8]=8.654; JZ[9]=8.771; JZ[10]=9.761; JZ[11]=9.936; JZ[12]=10.173; JZ[13]=11.065; JZ[14]=11.086; JZ[15]=11.620;
JZ[16]=11.792; JZ[17]=12.225; JZ[18]=12.339; JZ[19]=13.015; JZ[20]=13.323; JZ[21]=13.354; JZ[22]=13.589; JZ[23]=14.372;
MO[0]=0; MO[1]=1; MO[2]=2; MO[3]=0; MO[4]=3; MO[5]=1; MO[6]=4; MO[7]=2; MO[8]=0; MO[9]=5; MO[10]=3; MO[11]=6;
MO[12]=1; MO[13]=4; MO[14]=7; MO[15]=2; MO[16]=0; MO[17]=8; MO[18]=5; MO[19]=3; MO[20]=1; MO[21]=9; MO[22]=6; MO[23]=4;

LV[0]=0; LV[1]=0; LV[2]=1; LV[3]=1; LV[4]=2; LV[5]=3; LV[6]=4; LV[7]=5; LV[8]=5; LV[9]=6; LV[10]=7; LV[11]=8;
VPT[0]=0; VPT[1]=-0.2; VPT[2]=-0.4; VPT[3]=0.35; VPT[4]=0.22; VPT[5]=0.3; VPT[6]=-0.45; VPT[7]=0.5; VPT[8]=-0.3;
VTR[0]=1.19; VTR[1]=2.83; VTR[2]=2.4; VTR[3]=4.67; VTR[4]=4.23; VTR[5]=2.57; VTR[6]=1.46; VTR[7]=0.339; VTR[8]=1.41;

memset(NMAP, -1, 128);
NMAP[35]=0; NMAP[36]=0; NMAP[38]=1; NMAP[40]=1;
NMAP[63]=2; NMAP[37]=3; NMAP[39]=3; NMAP[62]=13; NMAP[64]=4; NMAP[60]=5; NMAP[61]=6;
NMAP[41]=7; NMAP[43]=8; NMAP[45]=15; NMAP[47]=9; NMAP[48]=9; NMAP[65]=10; NMAP[66]=10;
NMAP[73]=11; NMAP[74]=14;

tn_seed = 271828;
function tn_rnd() ( tn_seed = (tn_seed * 16807) % 2147483647; tn_seed / 2147483647; );

function bes(m, x) local(k, t, s, h)
(
  h = x * 0.5;
  t = 1; k = 1;
  loop(m, t *= h / k; k += 1;);
  s = t; k = 1;
  loop(40, t *= -(h * h) / (k * (k + m)); s += t; k += 1;);
  s;
);

function mbp(b) ( MBASE + b * MBK; );

function mem_build(b, n, tb) local(p, i, k, pos, r) (
  p = mbp(b); i = 0;
  loop(n,
    r = JZ[i] / JZ[0];
    MO[i] > 0 ? r = 1 + (r - 1) * 0.86;
    p[7] = r; p[8] = 1; p[4] = MO[i] == 0 ? 1 : 0.42; p[5] = p[6] = 0;
    k = 0;
    loop(9, pos = k / 8 * 0.9; WT[tb * 216 + k * 24 + i] = bes(MO[i], JZ[i] * pos) * r ^ -0.25; k += 1; );
    p += 10; i += 1;
  );
);

function fix_build(b, n, f, d, wi, wo) local(p, i) (
  p = mbp(b) + n * 10; p[7] = f; p[8] = d; p[3] = wi; p[9] = wi; p[4] = wo; p[5] = p[6] = 0;
);

function cym_build(b, n, k1, ex, jit, wlo, whi, dsp) local(p, i, r, t) (
  p = mbp(b); i = 0;
  loop(n,
    r = (1 + k1 * i ^ ex) * (1 + jit * (tn_rnd() * 2 - 1));
    t = i / max(n - 1, 1);
    p[7] = r; p[8] = (1 - dsp * t) * (0.75 + 0.5 * tn_rnd());
    p[9] = (wlo + (whi - wlo) * t) * (0.6 + 0.8 * tn_rnd()); p[3] = p[9];
    p[4] = (tn_rnd() > 0.5 ? 1 : -1) * (0.6 + 0.4 * tn_rnd());
    p[5] = p[6] = 0;
    p += 10; i += 1;
  );
);

function mb_tune(p, n, f) local(w) (
  loop(n, w = min(2 * $pi * f * p[7] / srate, 2.85); p[0] = cos(w); p[1] = sin(w); p += 10; );
);
function mb_decay(p, n, t0, tilt) local(t) (
  loop(n, t = max(t0 * p[8] / (1 + tilt * (p[7] - 1)), 0.002); p[2] = exp(-6.9078 / (t * srate)); p += 10; );
);
function mb_nyq(p, n, f) (
  loop(n, f * p[7] > 0.42 * srate ? p[3] = 0; p += 10; );
);
function mb_pos(p, n, tb, pos) local(k, fr, i, q) (
  q = min(max(pos, 0), 0.9) / 0.9 * 8; k = min(floor(q), 7); fr = q - k; i = 0;
  loop(n, p[3] = WT[tb * 216 + k * 24 + i] * (1 - fr) + WT[tb * 216 + (k + 1) * 24 + i] * fr; p += 10; i += 1; );
);
function mb_win(p, n) ( loop(n, p[3] = p[9]; p += 10; ); );
function mb_clr(p, n) ( loop(n, p[5] = 0; p[6] = 0; p += 10; ); );
function mb_damp(p, n, g) ( loop(n, p[5] *= g; p[6] *= g; p += 10; ); );
function mb_run(p, n, f) local(o, x, y, c, s, r) (
  o = 0;
  loop(n,
    x = p[5]; y = p[6]; c = p[0]; s = p[1]; r = p[2];
    p[5] = r * (c * x - s * y) + f * p[3];
    y = r * (s * x + c * y); p[6] = y; o += p[4] * y;
    p += 10;
  );
  o;
);
function mb_run2(p, n, f) local(o, a, x, y, c, s, r, g) (
  o = 0; a = 0; g = 1;
  loop(n,
    x = p[5]; y = p[6]; c = p[0]; s = p[1]; r = p[2];
    p[5] = r * (c * x - s * y) + f * p[3];
    y = r * (s * x + c * y); p[6] = y; y *= p[4]; o += y; a += g * y; g = -g;
    p += 10;
  );
  mb_alt = a;
  o;
);

function svf_k(fc, q) instance(a1, a2, a3, k) local(g) (
  g = tan($pi * min(fc, srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf_bp(x) instance(a1, a2, a3, k, ic1, ic2, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; hp = x - k * v1 - v2;
  v1;
);
function svf_clr() instance(ic1, ic2) ( ic1 = 0; ic2 = 0; );

function pl_go(amp, tcs) instance(pt, pn, pa, pw) (
  pn = max(2, floor(tcs * srate)); pt = 0; pa = amp * 2 / pn; pw = $pi / pn;
);
function pl_run() instance(pt, pn, pa, pw) local(s) (
  pt < pn ? ( s = sin(pw * pt); pt += 1; pa * s * s; ) : 0;
);

function dr_init(bm, nm, ba, na, tb, gk) instance(pm, npm, pax, npx, tbl, gl, act, pk, cnt, fp, wl) (
  pm = mbp(bm); npm = nm; pax = ba >= 0 ? mbp(ba) : 0; npx = ba >= 0 ? na : 0; tbl = tb; gl = gk;
  act = 0; pk = 0; cnt = 0; fp = 0; wl = 0;
);
function dr_clr() instance(pm, npm, pax, npx, act, pk, fp, we) (
  mb_clr(pm, npm); npx > 0 ? mb_clr(pax, npx);
  act = 0; pk = 0; fp = 0; we = 0;
  this.kn.svf_clr(); this.w1.svf_clr(); this.w2.svf_clr(); this.w3.svf_clr();
);
function dr_hit(amp, tcs, pos, f0n, fan, t0, tilt, ta, ak, ag, kg, kf, nzk)
  instance(pm, npm, pax, npx, tbl, f0, fa, act, cnt, akk, agg, kgg, nz, pt) (
  f0 = f0n; fa = fan; akk = ak; agg = ag; kgg = kg; nz = nzk;
  mb_damp(pm, npm, 0.5);
  mb_pos(pm, npm, tbl, pos);
  mb_tune(pm, npm, f0); mb_nyq(pm, npm, f0); mb_decay(pm, npm, t0, tilt);
  npx > 0 ? ( mb_tune(pax, npx, fa); mb_decay(pax, npx, ta, 0); mb_win(pax, npx); mb_nyq(pax, npx, fa); );
  this.kn.svf_k(kf, 2.2);
  this.pl_go(amp, tcs);
  act = 1; cnt = 0;
);
function dr_run(xin) instance(pm, npm, pax, npx, f0, gl, act, pk, cnt, fp, akk, agg, kgg, nz, wl, we, wr, sym, pt, pn, gmm)
  local(f, o, oa, a0, fm, d, kx, w, nn) (
  f = this.pl_run();
  cnt <= 0 ? (
    cnt = 16;
    gl > 0 ? (
      a0 = sqrt(pm[5] * pm[5] + pm[6] * pm[6]);
      fm = 1 + gl * min(a0, 1.4) * min(a0, 1.4);
      mb_tune(pm, min(npm, 10), f0 * fm);
    );
    pk < 0.000002 && pt >= pn && we < 0.000002 && sym < 0.5 ? ( this.dr_clr(); );
  );
  cnt -= 1;
  act ? (
    o = mb_run(pm, npm, f);
    oa = npx > 0 ? mb_run(pax, npx, pm[6] * akk + xin) : 0;
    d = f - fp; fp = f;
    kx = this.kn.svf_bp(d * 30 + (rand(2) - 1) * f * nz);
    o += oa * agg + kx * kgg;
    wl > 0 ? (
      w = abs(oa) * 0.0074 + abs(o) * 0.02;
      we = w > we ? we + (w - we) * 0.5 : we * wr;
      nn = rand(2) - 1;
      o += (this.w1.svf_bp(nn) * 0.9 + this.w2.svf_bp(nn) * 1.1 + this.w3.svf_bp(nn) * 0.8) * we * wl * 6;
    );
    o *= gmm;
    pk = max(abs(o), pk * 0.9995);
    o;
  ) : 0;
);

function pe_init(ty) instance(typ, act, en, snd, sh, pk, cnt) ( typ = ty; act = 0; en = 0; snd = 0; sh = 0; pk = 0; cnt = 0; );
function pe_clr() instance(act, en, snd, sh, pk, th, oo) (
  act = 0; en = 0; snd = 0; sh = 0; pk = 0; th = 0; oo = 0;
  this.f1.svf_clr(); this.f2.svf_clr(); this.f3.svf_clr(); this.fk.svf_clr();
);
function pe_hit(amp, len, edec, dens, sdec, g1, g2, g3, thg, tick) instance(act, sh, shn, sa, ed, dn, sd, gg1, gg2, gg3, tg, tk, tc, cnt) (
  shn = max(2, floor(len * srate)); sh = shn; sa = amp * 4 / shn;
  ed = edec; dn = dens; sd = sdec; gg1 = g1; gg2 = g2; gg3 = g3; tg = thg; tk = tick; tc = 0;
  act = 1; cnt = 0;
);
function pe_run() instance(act, typ, en, snd, sh, shn, sa, ed, dn, sd, gg1, gg2, gg3, tg, tk, tc, pk, cnt, th, oo)
  local(inj, x, o, nz) (
  act ? (
    inj = 0;
    sh > 0 ? ( inj = sa * sin($pi * (shn - sh) / shn); sh -= 1; en += inj; );
    en *= ed;
    tk > 0 ? (
      tc -= 1;
      tc <= 0 && sh > 0 ? ( snd += sa * shn * 0.06 * (0.6 + 0.8 * rand(1)); tc = tk * (0.85 + 0.3 * rand(1)); );
    ) : (
      rand(1) < dn ? snd += en * (0.4 + 1.2 * rand(1));
    );
    nz = rand(2) - 1;
    x = snd * nz; snd *= sd;
    o = this.f1.svf_bp(x) * gg1 + this.f2.svf_bp(x) * gg2 + this.f3.svf_bp(x) * gg3;
    tg > 0 ? o += this.fk.svf_bp(inj * 40) * tg;
    oo = o;
    pk = max(abs(o), pk * 0.9995);
    cnt -= 1;
    cnt <= 0 ? ( cnt = 32; sh <= 0 && pk < 0.000002 && en < 0.000001 && snd < 0.000001 ? this.pe_clr(); );
    o;
  ) : 0;
);

function plate_build(b, n, tb) local(p, i, m, k, q, xx, yy, mm, nn) (
  p = mbp(b); i = 0;
  loop(n,
    mm = PLM[i * 2]; nn = PLM[i * 2 + 1];
    p[7] = (mm * mm + 1.35 * nn * nn) / 2.35; p[8] = 1; p[4] = (mm & 1) && (nn & 1) ? 1 : 0.35; p[5] = p[6] = 0;
    k = 0;
    loop(9, q = k / 8 * 0.9; xx = 0.5 + 0.06 * q; yy = 0.5 + 0.47 * q;
      WT[tb * 216 + k * 24 + i] = sin(mm * $pi * xx) * sin(nn * $pi * yy) * p[7] ^ -0.2; k += 1; );
    p += 10; i += 1;
  );
);
PLM = 1700;
PLM[0]=1; PLM[1]=1; PLM[2]=2; PLM[3]=1; PLM[4]=1; PLM[5]=2; PLM[6]=2; PLM[7]=2; PLM[8]=3; PLM[9]=1; PLM[10]=1; PLM[11]=3;
PLM[12]=3; PLM[13]=2; PLM[14]=2; PLM[15]=3; PLM[16]=4; PLM[17]=1; PLM[18]=1; PLM[19]=4; PLM[20]=3; PLM[21]=3; PLM[22]=4; PLM[23]=2;
PLM[24]=2; PLM[25]=4; PLM[26]=5; PLM[27]=1; PLM[28]=4; PLM[29]=3; PLM[30]=1; PLM[31]=5;

function flat_tab(tb, n, w1) local(i, k) (
  i = 0; loop(n, k = 0; loop(9, WT[tb * 216 + k * 24 + i] = i == 0 ? 1 : w1; k += 1; ); i += 1; );
);

function kit_build() local(i, b) (
  plate_build(0, 16, 0);
  fix_build(1, 0, 0.62, 1, 1, 1); fix_build(1, 1, 2.9, 0.3, 0.6, 0.5); fix_build(1, 2, 4.4, 0.25, 0.5, 0.4);
  mem_build(2, 14, 1); mem_build(4, 14, 2); mem_build(6, 12, 3); mem_build(8, 12, 4);
  i = 0;
  loop(4,
    b = 3 + i * 2;
    fix_build(b, 0, 0.47, 1, 1, 0.8); fix_build(b, 1, 3.1, 0.35, 0.7, 0.45); fix_build(b, 2, 4.7, 0.25, 0.5, 0.35);
    i += 1;
  );
  mem_build(10, 14, 5); fix_build(11, 0, 1, 1, 1, 1); fix_build(11, 1, 4.1, 0.3, 0.4, 0.3);
  mem_build(12, 16, 6); fix_build(13, 0, 1.7, 0.5, 0.6, 0.5);
  fix_build(14, 0, 1, 1, 1, 1); fix_build(14, 1, 2.04, 0.35, 0.35, 0.25); flat_tab(7, 2, 0.4);
  fix_build(15, 0, 1, 1, 1, 1); fix_build(15, 1, 1.83, 0.7, 0.8, 0.7); fix_build(15, 2, 2.95, 0.5, 0.6, 0.5); fix_build(15, 3, 4.3, 0.35, 0.5, 0.4);
);
kit_build();

function tn_srinit() local(i) (
  tn_sr = srate;
  vcj.dr_init(0, 16, 1, 3, 0, 0.03);
  vcg.dr_init(2, 14, 3, 3, 1, 0.07);
  vtb.dr_init(4, 14, 5, 3, 2, 0.07);
  vbh.dr_init(6, 12, 7, 3, 3, 0.05);
  vbl.dr_init(8, 12, 9, 3, 4, 0.05);
  vcj.gmm = vcg.gmm = vtb.gmm = vbh.gmm = vbl.gmm = 0.2;
  vdj.dr_init(10, 14, 11, 2, 5, 0.06); vfr.dr_init(12, 16, 13, 1, 6, 0.04); vud.dr_init(14, 2, 15, 4, 7, 0.3);
  vdj.gmm = vfr.gmm = vud.gmm = 0.2;
  vgu.pe_init(3);
  vdj.w1.svf_k(4200, 3); vdj.w2.svf_k(6500, 4); vdj.w3.svf_k(9000, 3);
  vfr.w1.svf_k(900, 1.5); vfr.w2.svf_k(1700, 1.5); vfr.w3.svf_k(3200, 1.5);
  vcj.w1.svf_k(1900, 1.2); vcj.w2.svf_k(3300, 1.4); vcj.w3.svf_k(5600, 1.0);
  tn_sm = 1 - exp(-1 / (0.03 * srate));
  tn_smr = 1 - exp(-1 / (0.25 * srate));
  tn_dcc = 1 - exp(-2 * $pi * 5 / srate);
  tn_rlp = 1 - exp(-2 * $pi * 6500 / srate);
  ost_init(20000);
  memset(ERB, 0, ERN); memset(FDB, 0, 4 * FDN);
  tn_erw = 0; tn_fw = 0;
  i = 0; loop(9, VGS[i] = 0; i += 1; );
);
tn_srinit();

function tn_p(v, k) ( slider(12 + v * 5 + k); );
function tn_f(v) ( 2 ^ ((tn_p(v, 0) * 100 + VDW[v] + (rand(2) - 1) * tn_drift * 30 + (rand(2) - 1) * tn_hum * 4) / 1200); );

function tn_ed(t) ( exp(-1 / (max(t, 0.0005) * srate)); );
function tn_hit(ln, vel, g) local(v, a, tu, de, to, ch, tc, jt, hv, mt) (
  v = ln == 13 ? 1 : ln == 14 ? 8 : ln == 15 ? 5 : LV[ln];
  hv = min(max(vel * (1 + (rand(2) - 1) * 0.14 * tn_hum), 0.02), 1);
  a = hv ^ 1.5 * g;
  tu = tn_f(v); de = tn_p(v, 1) / 100; to = tn_p(v, 2) / 100; ch = tn_p(v, 3) / 100;
  jt = (rand(2) - 1) * 0.06 * (0.3 + tn_hum);
  v == 0 ? (
    vcj.wl = 0.1 + 0.9 * ch; vcj.wr = exp(-6.9078 / ((0.04 + 0.12 * ch) * de * srate));
    ln == 0 ? (
      tc = (0.006 - 0.0035 * to) * (1 - 0.3 * hv);
      mb_damp(vcj.pm, vcj.npm, 0.06);
      vcj.dr_hit(a * 0.066, tc, 0.04 + abs(jt), 118 * tu, 118 * tu, 0.18 * de, 0.9, 0.32 * de, 0.83, 0.3, 0.3, 1800, 0.5);
    ) : (
      tc = (0.0011 - 0.0006 * to) * (1 - 0.3 * hv);
      vcj.dr_hit(a, tc, 0.82 + jt, 118 * tu, 118 * tu, 0.09 * de, 0.5, 0.12 * de, 0.2, 0.3, 1.6 + 2 * to, 2600 + 1400 * to, 2);
    );
  ) : v <= 4 ? (
    mt = 1 - 0.75 * ch;
    tc = (0.0034 - 0.002 * to) * (1 - 0.3 * hv);
    ln == 3 ? (
      tc = 0.0005 * (1 - 0.3 * hv);
      vcg.dr_hit(a * 0.21, tc, 0.86 + jt, 228 * tu, 228 * tu, 0.08 * de, 2.5, 0.06 * de, 0.3, 0.05, 2.5 + 2 * to, 3000 + 1500 * to, 3);
    ) : ln == 13 ? (
      vcg.dr_hit(a * 0.8, tc, 0.5 + jt, 228 * tu, 228 * tu, 0.05 * de, 2.5, 0.05 * de, 0.3, 0.05, 0.4, 2500, 0.5);
    ) : v == 1 ? vcg.dr_hit(a, tc, 0.62 + jt, 228 * tu, 228 * tu, 0.55 * de * mt, 1.6, 0.4 * de * mt, 0.3, 0.07, 0.25 + 0.6 * to, 2400 + 1200 * to, 0.6) :
    v == 2 ? vtb.dr_hit(a, tc, 0.62 + jt, 172 * tu, 172 * tu, 0.65 * de * mt, 1.6, 0.45 * de * mt, 0.3, 0.07, 0.25 + 0.6 * to, 2200 + 1200 * to, 0.6) :
    v == 3 ? vbh.dr_hit(a, tc * 0.7, 0.66 + jt, 430 * tu, 430 * tu, 0.32 * de * mt, 1.8, 0.2 * de * mt, 0.3, 0.06, 0.35 + 0.8 * to, 3400 + 1500 * to, 0.6) :
             vbl.dr_hit(a, tc * 0.7, 0.66 + jt, 305 * tu, 305 * tu, 0.4 * de * mt, 1.8, 0.25 * de * mt, 0.3, 0.06, 0.35 + 0.8 * to, 3200 + 1500 * to, 0.6);
  ) : v == 5 ? (
    vdj.wl = ch * 1.2; vdj.wr = exp(-6.9078 / ((0.08 + 0.15 * ch) * de * srate));
    ln == 7 ? (
      tc = (0.006 - 0.003 * to) * (1 - 0.3 * hv);
      mb_damp(vdj.pm, vdj.npm, 0.03);
      vdj.dr_hit(a * 0.014, tc, 0.03 + abs(jt), 340 * tu, 78 * tu, 0.2 * de, 1.6, 0.3 * de, 20, 0.08, 0.2, 1500, 0.3);
    ) : ln == 15 ? (
      tc = 0.00045 * (1 - 0.3 * hv);
      vdj.dr_hit(a * 0.22, tc, 0.86 + jt, 340 * tu, 78 * tu, 0.07 * de, 2.5, 0.05 * de, 0.3, 0.04, 2.5 + 2 * to, 3300 + 1500 * to, 3);
    ) : (
      tc = (0.0018 - 0.001 * to) * (1 - 0.3 * hv);
      vdj.dr_hit(a, tc, 0.62 + jt, 340 * tu, 78 * tu, 0.3 * de, 1.4, 0.2 * de, 0.3, 0.08, 0.3 + 0.6 * to, 2600 + 1200 * to, 0.6);
    );
  ) : v == 6 ? (
    vfr.wl = ch * 1.5; vfr.wr = exp(-6.9078 / ((0.1 + 0.25 * ch) * de * srate));
    tc = (0.003 - 0.002 * to) * (1 - 0.3 * hv);
    vfr.dr_hit(a, tc, 0.1 + 0.8 * to + jt, 92 * tu, 92 * tu, 0.9 * de, 1.3, 0.3 * de, 0.2, 0.05, 0.2 + 0.6 * to, 2000 + 1500 * to, 0.4);
  ) : v == 7 ? (
    vud.gl = 0.05 + 0.5 * ch;
    tc = (0.006 - 0.004 * to) * (1 - 0.3 * hv);
    vud.dr_hit(a, tc, 0.1, 105 * tu, 330 * tu, 0.45 * de, 0.5, 0.06 * de, 0.4, 0.35, 0.15 + 0.4 * to, 1200 + 800 * to, 0.3);
  ) : (
    vgu.f1.svf_k(1150 * tu, 8); vgu.f2.svf_k(2450 * tu, 10); vgu.f3.svf_k(4300 * tu, 6);
    vgu.pe_hit(a, (ln == 14 ? 0.32 : 0.09 + 0.2 * ch) * (0.7 + 0.3 * de), tn_ed(0.01), 0, tn_ed(0.0012 * de), 1, 0.9, 0.6, 0, srate / (30 + 90 * to));
  );
  LT[ln == 13 ? 2 : ln == 14 ? 11 : ln == 15 ? 8 : ln] = 1; tn_hitn += 1;
);

function tn_clrall() (
  vcj.dr_clr(); vcg.dr_clr(); vtb.dr_clr(); vbh.dr_clr(); vbl.dr_clr();
  vdj.dr_clr(); vfr.dr_clr(); vud.dr_clr(); vgu.pe_clr();
  memset(ERB, 0, ERN); memset(FDB, 0, 4 * FDN); tn_fl0 = tn_fl1 = tn_fl2 = tn_fl3 = 0;
  tn_hqn = 0; tn_dcl = tn_dcr = 0;
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
function gap_clear() ( tn_clrall(); );

function tn_rd(base, n, w, d) local(r, i0, fr) (
  r = w - d; r < 0 ? r += n; i0 = floor(r); fr = r - i0;
  base[i0] * (1 - fr) + base[(i0 + 1) % n] * fr;
);

function tn_update() local(i, im, p) (
  tn_vol = 10 ^ (slider1 / 20);
  tn_drift = slider2 / 100;
  tn_chan = floor(slider3 + 0.5);
  tn_room = slider4 / 100;
  tn_size = slider5 / 100;
  tn_hum = slider7 / 100;
  sq_swing = slider8 / 100 * 0.5;
  tn_acc = slider9 / 100;
  im = slider6;
  i = 0;
  loop(9,
    p = im >= 1.5 ? 0 : im >= 0.5 ? -VPT[i] : VPT[i];
    VPL[i] = sqrt(1 - p); VPR[i] = sqrt(1 + p);
    i += 1;
  );
  ost_setup(0, 0, 120, 6000, -0.3, 1);
);

function pv(v, tu, de, to, ch, lvl) local(b) ( b = 12 + v * 5; slider(b) = tu; slider(b + 1) = de; slider(b + 2) = to; slider(b + 3) = ch; slider(b + 4) = lvl; );
function pk_(rm, sz, im) ( slider4 = rm; slider5 = sz; slider6 = im; );
function load_preset(p) local(i) (
  p == 1 ? (
    pk_(25, 40, 0);
    pv(0, 0, 100, 50, 55, 85); pv(1, 0, 100, 50, 20, 75); pv(2, 0, 100, 50, 20, 75); pv(3, 0, 100, 50, 20, 65); pv(4, 0, 100, 50, 20, 65); pv(5, 0, 100, 50, 30, 80); pv(6, 0, 100, 50, 30, 70); pv(7, 0, 100, 50, 50, 70); pv(8, 0, 100, 50, 50, 60);
  ) : p == 2 ? (
    pk_(30, 50, 0);
    pv(0, 0, 90, 55, 40, 70); pv(1, 1, 100, 60, 15, 80); pv(2, 1, 100, 60, 15, 78); pv(3, 1, 100, 60, 15, 70); pv(4, 1, 100, 60, 15, 70); pv(5, 1, 100, 60, 30, 80); pv(6, 1, 100, 60, 30, 70); pv(7, 1, 100, 60, 50, 70); pv(8, 1, 100, 60, 50, 60);
  ) : p == 3 ? (
    pk_(20, 35, 0);
    pv(0, -1, 120, 40, 70, 90); pv(1, 0, 110, 45, 25, 70); pv(2, 0, 110, 45, 25, 70); pv(3, 0, 100, 45, 25, 60); pv(4, 0, 100, 45, 25, 60); pv(5, 0, 110, 45, 30, 80); pv(6, 0, 110, 45, 30, 70); pv(7, 0, 110, 45, 50, 70); pv(8, 0, 110, 45, 50, 60);
  ) : p == 4 ? (
    pk_(8, 20, 0);
    pv(0, 1, 70, 65, 40, 85); pv(1, 1, 70, 65, 40, 72); pv(2, 1, 70, 65, 40, 72); pv(3, 1, 70, 65, 40, 62); pv(4, 1, 70, 65, 40, 62); pv(5, 1, 70, 65, 30, 80); pv(6, 1, 70, 65, 30, 70); pv(7, 1, 70, 65, 50, 70); pv(8, 1, 70, 65, 50, 60);
  ) : p == 5 ? (
    pk_(65, 85, 0);
    pv(0, -1, 120, 45, 60, 85); pv(1, -1, 120, 50, 15, 75); pv(2, -1, 120, 50, 15, 75); pv(3, -1, 110, 50, 15, 65); pv(4, -1, 110, 50, 15, 65); pv(5, -1, 120, 50, 30, 80); pv(6, -1, 120, 50, 30, 70); pv(7, -1, 120, 50, 50, 70); pv(8, -1, 120, 50, 50, 60);
  ) : p == 6 ? (
    pk_(30, 45, 0);
    pv(0, 2, 90, 75, 45, 85); pv(1, 2, 100, 75, 15, 78); pv(2, 2, 100, 75, 15, 76); pv(3, 2, 100, 75, 15, 68); pv(4, 2, 100, 75, 15, 68); pv(5, 2, 100, 75, 30, 80); pv(6, 2, 100, 75, 30, 70); pv(7, 2, 100, 75, 50, 70); pv(8, 2, 100, 75, 50, 60);
  ) : p == 7 ? (
    pk_(35, 50, 0);
    pv(0, -1, 110, 10, 50, 85); pv(1, -1, 110, 15, 30, 72); pv(2, -1, 110, 15, 30, 72); pv(3, -1, 110, 15, 30, 62); pv(4, -1, 110, 15, 30, 62); pv(5, -1, 110, 15, 30, 80); pv(6, -1, 110, 15, 30, 70); pv(7, -1, 110, 15, 50, 70); pv(8, -1, 110, 15, 50, 60);
  ) : p == 8 ? (
    pk_(10, 25, 0);
    pv(0, 2, 60, 70, 30, 86); pv(1, 2, 60, 70, 45, 74); pv(2, 2, 60, 70, 45, 74); pv(3, 2, 60, 70, 45, 64); pv(4, 2, 60, 70, 45, 64); pv(5, 2, 60, 70, 30, 80); pv(6, 2, 60, 70, 30, 70); pv(7, 2, 60, 70, 50, 70); pv(8, 2, 60, 70, 50, 60);
  ) : p == 9 ? (
    pk_(30, 55, 0);
    pv(0, -2, 110, 30, 60, 88); pv(1, -2, 110, 30, 30, 74); pv(2, -2, 110, 30, 30, 74); pv(3, -2, 110, 30, 30, 64); pv(4, -2, 110, 30, 30, 64); pv(5, -2, 110, 30, 30, 80); pv(6, -2, 110, 30, 30, 70); pv(7, -2, 110, 30, 50, 70); pv(8, -2, 110, 30, 50, 60);
  ) : p == 10 ? (
    pk_(45, 70, 0);
    pv(0, 0, 110, 60, 65, 86); pv(1, 0, 110, 60, 20, 76); pv(2, 0, 110, 60, 20, 76); pv(3, 0, 110, 60, 20, 66); pv(4, 0, 110, 60, 20, 66); pv(5, 0, 110, 60, 30, 80); pv(6, 0, 110, 60, 30, 70); pv(7, 0, 110, 60, 50, 70); pv(8, 0, 110, 60, 50, 60);
  );
  p >= 1 && p <= 10 ? ( i = 1; loop(56, slider_automate(2 ^ (i - 1)); i += 1; ); );
);

PS = 204; LCUR = 13400;
function lrow(p, r, s) local(i, c) (
  i = 0;
  loop(16, c = str_getchar(s, i); LIB[p * PS + r * 16 + i] = c == 88 ? 3 : c == 120 ? 2 : c == 103 ? 1 : 0; i += 1; );
);
function lib_build() (
  memset(LIB, 0, 22 * PS);
  lrow(0, 5, "x.xxx.xxx.xxx.xx");
  lrow(0, 6, "....X.......X...");
  lrow(0, 2, "X.....X...X.....");
  lrow(0, 9, "..x...x...x...x.");
  lrow(1, 3, "....X.......X...");
  lrow(1, 2, "......XX......X.");
  lrow(1, 4, "..............X.");
  lrow(1, 5, "XxxxXxxxXxxxXxxx");
  lrow(1, 6, "..x...x...x...x.");
  lrow(1, 11, "X.xxX.xxX.xxX.xx");
  lrow(2, 0, "X..xX..xX..xX..x");
  lrow(2, 1, "..x.....g.x.....");
  lrow(2, 9, "g.x.g.x.g.x.g.x.");
  lrow(2, 2, "......X.......X.");
  lrow(3, 7, "X.......X.......");
  lrow(3, 8, "..x.x.x...x.x.x.");
  lrow(3, 4, "X......xX......x");
  lrow(3, 2, "....X.x.....X.x.");
  lrow(3, 9, "xxXxxxXxxxXxxxXx");
  lrow(4, 0, "X.....x...X.....");
  lrow(4, 1, "....X..g.g..X..x");
  lrow(4, 2, "..x.......x.....");
  lrow(5, 0, "X.......X.x.....");
  lrow(5, 1, "....X.......X...");
  lrow(5, 9, "x.x.x.x.x.x.x.x.");
  lrow(6, 7, "X.....X.X.......");
  lrow(6, 8, "..x.x...x.x.x.xX");
  lrow(6, 2, "X..X..X...X.X...");
  lrow(6, 9, "x.x.x.x.x.x.x.x.");
  lrow(7, 0, "X...X...X...X...");
  lrow(7, 1, "...X..X....X..X.");
  lrow(7, 9, "xxxxxxxxxxxxxxxx");
  lrow(8, 9, "..X...X...X...X.");
  lrow(8, 2, "X.....X...X.....");
  lrow(8, 5, "..x.....x.x.....");
  lrow(8, 8, "....x.......x...");
  lrow(9, 11, "X.xxX.xxX.xxX.xx");
  lrow(9, 2, "......X.......X.");
  lrow(9, 0, "X.......X.......");
  lrow(9, 9, "x.x.x.x.x.x.x.x.");
  lrow(10, 9, "X.x...x.X...x...");
  lrow(10, 10, "X.......X.......");
  lrow(11, 5, "X.xx..x.X.xx..x.");
  lrow(11, 2, "........X..X....");
  lrow(11, 9, "g.x.g.x.g.x.g.x.");
  lrow(12, 10, "X..x..X...x.X...");
  lrow(12, 8, "....x.......x..x");
  lrow(12, 9, "x.xxx.xxx.xxx.xx");
  lrow(13, 0, "X.......X.......");
  lrow(13, 1, "....X.......X...");
  lrow(13, 9, "g.g.g.g.g.g.g.g.");
  lrow(14, 5, "XxXxXxXx........");
  lrow(14, 6, "........XxXxXxXx");
  lrow(15, 2, "X.xX.xX.x.X.xXx.");
  lrow(15, 3, "...X.......X....");
  lrow(15, 4, "......X.X.....X.");
  lrow(16, 9, "X.xX.xX.xX.xX.x.");
  lrow(16, 10, "X.....X.....X...");
  lrow(17, 8, "X.x.xX..x.x.xX..");
  LIB[12 * PS + 192 + 10] = 6; LIB[17 * PS + 192 + 8] = 12;
  LIB[0 * PS + 192 + 9] = 12;
  LIB[1 * PS + 192 + 6] = 12;
  LIB[2 * PS + 192 + 9] = 6;
  LIB[3 * PS + 192 + 8] = 12;
  LIB[4 * PS + 192 + 2] = 10;
  LIB[6 * PS + 192 + 9] = 12;
  LIB[8 * PS + 192 + 5] = 12;
  LIB[10 * PS + 192 + 10] = 12;
  LIB[15 * PS + 192 + 4] = 14;
  lrow(17, 7, "X.......X.......");
  lrow(17, 9, "x.x.x.x.x.x.x.x.");
  lrow(18, 0, "X...X...........");
  lrow(18, 1, "....x.x.xxxxXXXX");
  lrow(19, 5, "XxxX............");
  lrow(19, 6, "....XxxX........");
  lrow(19, 2, "........XxxX....");
  lrow(19, 4, "............XxxX");
  lrow(20, 11, "X.......X.......");
  lrow(21, 0, "X...............");
  lrow(21, 9, "X...............");
);
function lib_name(p) (
  p == 0 ? "POP HANDS" : p == 1 ? "TUMBAO" : p == 2 ? "BOSSA" : p == 3 ? "SAMBA" : p == 4 ? "RUMBA BOX" : p == 5 ? "BOX POP" : p == 6 ? "DJEMBE DUN" : p == 7 ? "REGGAETON" : p == 8 ? "HOUSE PERC" : p == 9 ? "CUMBIA" : p == 10 ? "MAQSUM" : p == 11 ? "BOLERO" : p == 12 ? "UDU GROOVE" : p == 13 ? "BALLAD" : p == 14 ? "BONGO RUN" : p == 15 ? "CONGA SOLO" : p == 16 ? "FRAME SIX" : p == 17 ? "DJEMBE CALL" : p == 18 ? "BOX FILL" : p == 19 ? "HAND FILL" : p == 20 ? "LONG GUIRO" : p == 21 ? "STOP" : "EMPTY";
);
#lib_menu = ">Pop and Dance|Pop Hands|Box Pop|House Perc|Reggaeton|<Ballad|>Latin|Tumbao|Bossa|Samba|Cumbia|<Bolero|>World|Djembe Dun|Djembe Call|Maqsum|Udu Groove|<Frame Six|>Hand Drums|Rumba Box|Conga Solo|<Bongo Run|>Parts and Fills|Box Fill|Hand Fill|Long Guiro|<Stop";
#lib_ids = "0,5,8,7,13,1,2,3,9,11,6,17,10,12,16,4,15,14,18,19,20,21";
LIBN = 22;
LIBO = 11100;
gi = 0; gk = 0; lb_v = 0;
loop(strlen(#lib_ids) + 1,
  gc = gi < strlen(#lib_ids) ? str_getchar(#lib_ids, gi) : 44;
  gc == 44 ? ( LIBO[gk] = lb_v; gk += 1; lb_v = 0; ) : lb_v = lb_v * 10 + gc - 48;
  gi += 1;
);
function slots_default() local(i) (
  i = 0; loop(16, memcpy(PAT + i * PS, LIB + i * PS, PS); SLN[i] = i; i += 1; );
);
lib_build();
!init_done ? ( memset(PAT, 0, 16 * PS); slots_default(); init_done = 1; );

i = 0; loop(9, VDW[i] = 0; VDT[i] = 0; i += 1; );
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; dv_sel = 0; tn_last = 0; );
tn_update();
tn_vol_s = tn_vol; tn_room_s = tn_room; tn_size_s = 0.5 + 1.1 * tn_size;
i = 0; loop(9, VGS[i] = (tn_p(i, 4) / 100) ^ 2 * VTR[i]; i += 1; );
pwr_init(); pwr_hum_db = -84; pwr_sag = 0.08; pwr_rip = 0.002; pwr_wu_loss = 0.2; pwr_wu_drv = 0.3; pwr_wu_lp = 15000; pwr_wu_wob = 0.04; pwr_bloom = 0;
cur_step = -1; cur_pat = slider11; run = 0; run_rq_d = 0; sq_n = 0; tn_hqn = 0; tn_sc = 0;
mn_pk_d = 0; mn_pkm = 0;
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(56, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; k = k > 10 ? 1 : k; load_preset(k);
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
tn_update();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, PAT, 16 * PS);
file_mem(0, SLN, 16);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
prs_chk();
srate != tn_sr ? ( tn_srinit(); tn_clrall(); );
tn_update();
pwr_block(1);
tn_bi = 0;
loop(9,
  VDT[tn_bi] -= samplesblock / srate;
  VDT[tn_bi] <= 0 ? ( VDT[tn_bi] = 3 + rand(5); tn_dwt = (rand(2) - 1) * tn_drift * 60; VDW[tn_bi + 10] = tn_dwt; );
  VDW[tn_bi] += (VDW[tn_bi + 10] - VDW[tn_bi]) * min(1, samplesblock / srate / 3);
  tn_bi += 1;
);
pat_dirty > 0 ? (
  pat_dirty <= LIBN ? ( memcpy(PAT + slider11 * PS, LIB + LIBO[pat_dirty - 1] * PS, PS); SLN[slider11] = LIBO[pat_dirty - 1]; ) :
  pat_dirty == 100 ? ( memset(PAT + slider11 * PS, 0, PS); SLN[slider11] = -1; ) :
  pat_dirty > 100 && pat_dirty <= 116 ? ( memcpy(PAT + (pat_dirty - 101) * PS, PAT + slider11 * PS, PS); SLN[pat_dirty - 101] = SLN[slider11]; );
  pat_dirty = 0;
);
tn_en = 0;
while (midirecv(tn_mo, tn_m1, tn_m2, tn_m3)) (
  (tn_m1 & 0xF0) == 0x90 && tn_m3 > 0 && ins_chan_ok(tn_m1, tn_chan) && tn_en < 256 && NMAP[tn_m2] >= 0 ? (
