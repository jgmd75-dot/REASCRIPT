tn_aud_dirty > 0 ? ( tn_hit(tn_aud_dirty - 1, 0.85, 1); tn_aud_dirty = 0; );

run_t = slider10 >= 0.5 ? (play_state & 1) : run_rq_d;
run_t != run ? ( run = run_t; run ? ( free_pos = 0; seq_next = 0; next_t = 0; was_play = 0; cur_pat = slider11; ); );
