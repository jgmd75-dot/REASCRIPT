      loop(12,
        q_ln = PAT[cur_pat * PS + 192 + q_r]; q_ln = q_ln >= 1 && q_ln < 16 ? q_ln : 16;
        q_ls = seq_next - floor(seq_next / q_ln) * q_ln; LCUR[q_r] = q_ls;
