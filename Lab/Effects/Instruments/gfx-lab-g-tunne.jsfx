tn_y = vcg.dr_run(0) * VGS[1]; tn_l += tn_y * VPL[1]; tn_r += tn_y * VPR[1]; tn_rs += tn_y * 0.8;
tn_y = vtb.dr_run(0) * VGS[2]; tn_l += tn_y * VPL[2]; tn_r += tn_y * VPR[2]; tn_rs += tn_y * 0.8;
