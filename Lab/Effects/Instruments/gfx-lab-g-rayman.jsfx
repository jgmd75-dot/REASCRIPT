desc:RAYMAN [bass keyboard] (GFX Lab)
//tags: instrument bass keyboard piano-bass organ combo tine transistor vintage
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-os

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-os.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider1:tn_on=1<0,1,1{Off,On}>-Tine in
slider2:tn_lvl=0.8<0,1,0.001>-Tine level
slider3:tn_hard=0.5<0,1,0.001>-Tine hardness
slider4:tn_bell=0.35<0,1,0.001>-Tine bell
slider5:tn_voic=0.5<0,1,0.001>-Tine voicing (dark - bark)
slider6:tn_dec=0.5<0,1,0.001>-Tine decay
slider7:tb_on=0<0,1,1{Off,On}>-Tab in
slider8:tb_lvl=0.8<0,1,0.001>-Tab level
slider9:tb_16=0.8<0,1,0.001>-Tab 16' level
slider10:tb_8=0.5<0,1,0.001>-Tab 8' level
slider11:tb_wave=0<0,2,1{Flute,Square,Pulse}>-Tab wave
slider12:tb_perc=0.3<0,1,0.001>-Tab percussion
slider13:tb_sus=30<5,2000,1:log>-Tab sustain (ms)
slider14:rd_on=0<0,1,1{Off,On}>-Reed in
slider15:rd_lvl=0.8<0,1,0.001>-Reed level
slider16:rd_16=0.8<0,1,0.001>-Reed 16' level
slider17:rd_8=0.5<0,1,0.001>-Reed 8' level
slider18:rd_tone=1100<220,5500,1:log>-Reed tone (Hz)
slider19:rd_drv=2<0,10,0.01>-Reed preamp drive
slider20:mono=0<0,1,1{Poly,Mono}>-Mono
slider21:glide=80<0,1000,1>-Glide (ms)
slider22:octave=0<-2,1,1>-Octave
slider23:vel_sens=70<0,100,1>-Velocity (%)
slider24:bass_db=0<-12,12,0.1>-Bass (dB)
slider25:treb_db=0<-12,12,0.1>-Treble (dB)
slider26:amp_drv=1<0,10,0.01>-Amp drive
slider27:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider28:drift=50<0,100,1>-Drift (%)
slider29:vol=0<-24,6,0.1>-Volume (dB)
slider30:prs_sel=0<0,8,1{No preset,Init,Piano Bass,Combo Bass,Reed Bass,Garage Fuzz,Tine and Tab,Three-Way Stack,Mono Glide}>-Preset

@init
#ui_man = "gfx-lab-g-rayman";
ext_noinit = 1;
gfx_ext_retina = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

TVB = 0;     TVS = 64;   TVN = 12;
OVB = 1024;  OVS = 32;   OVN = 12;
MSK = 1500;
MQ = 4096;   MQMAX = 1000;
FB = 196608;
WT = 262144;  TSTR = 2056;  TN = 2048;

T_ON = 0;  T_NOTE = 1;  T_GATE = 2;  T_SUS = 3;  T_AGE = 4;  T_STL = 5;  T_FADE = 6;  T_DMP = 7;
T_PL = 8;  T_PI = 9;  T_OFF = 10;  T_NRM = 11;  T_FPR = 12;  T_BPH = 13;  T_BINC = 14;  T_BDP = 15;
T_EN = 16;  T_THG = 17;  T_BM = 18;  T_HOF = 19;
T_M = 24;
M_Y1 = 0;  M_Y2 = 1;  M_A1 = 2;  M_A2 = 3;  M_G = 4;  M_W = 5;  M_RUP = 6;  M_RDN = 7;
O_ON = 0;  O_NOTE = 1;  O_GATE = 2;  O_SUS = 3;  O_AGE = 4;  O_STL = 5;  O_FADE = 6;  O_ETB = 7;
O_ERD = 8;  O_TGT = 9;  O_PRC = 10;  O_PH = 11;  O_PCUR = 12;  O_PTGT = 13;  O_INC = 14;  O_BNC = 15;
O_FAST = 16;  O_DTN = 17;  O_K16 = 18;  O_K8 = 19;  O_K4 = 20;  O_ISTP = 21;

memset(TVB, 0, TVS * TVN);  memset(OVB, 0, OVS * OVN);  memset(MSK, 0, 128);

ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
os_design();
os_f = os_tf = os_f2n(os_sel);  os_base = 0;  os_gsetup();
drf_sup.drift_init(0.9);  drf_pk.drift_init(1.3);

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function hash(n, k) local(v) ( v = sin(n * 12.9898 + k * 78.233 + 0.5) * 43758.5453;  v - floor(v); );

function build_tables() local(w, k, n, nmax, wd, a, b, i, t) (
  w = 0;
  loop(3,
    wd = w == 1 ? 0.5 : 0.25;
    k = 0;
    loop(11,
      nmax = min(TN / 2 - 1, floor(0.47 * srate / (15804 / 2 ^ k * 1.19)));
      memset(FB, 0, TN * 2);
      n = 1;
      loop(nmax,
        w == 0 ? (
          (n & 1) ? ( a = -4 / ($pi * $pi * n * n);  b = 0; ) : ( a = 0;  b = 0; );
        ) : (
          t = 2 / ($pi * n) * sin($pi * n * wd);
          a = t * cos($pi * n * wd);  b = -t * sin($pi * n * wd);
        );
        FB[2 * n] = a;  FB[2 * n + 1] = b;  FB[2 * (TN - n)] = a;  FB[2 * (TN - n) + 1] = -b;
        n += 1;
      );
      fft_ipermute(FB, TN);  ifft(FB, TN);
      t = WT + (w * 11 + k) * TSTR;
      i = 0;  loop(TN, t[i] = FB[2 * i];  i += 1; );  t[TN] = t[0];
      k += 1;
    );
    w += 1;
  );
);
build_tables();
function tone(tb, q) local(x, i) ( x = q * TN;  i = floor(x);  tb[i] + (tb[i + 1] - tb[i]) * (x - i); );
function tb_oct(f) ( min(10, max(0, floor(log(15804 / max(f, 1)) / log(2)))) * TSTR; );

function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);
function sqr_bl(p, d) local(q) ( d = min(d, 0.45);  q = p + 0.5;  q >= 1 ? q -= 1;  saw_bl(q, d) - saw_bl(p, d); );

function bq_cf(tp, f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n0) (
  f = min(f, 0.45 * srate);  w = 2 * $pi * f / srate;  cw = cos(w);  al = sin(w) / (2 * q);  n0 = 1 + al;
  tp == 0 ? ( b0 = (1 - cw) * 0.5 / n0;  b1 = (1 - cw) / n0; ) : ( b0 = (1 + cw) * 0.5 / n0;  b1 = -(1 + cw) / n0; );
  b2 = b0;  a1 = -2 * cw / n0;  a2 = (1 - al) / n0;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1;  z1 = b1 * x - a1 * y + z2;  z2 = b2 * x - a2 * y;  y;
);

function ge_run(x) instance(u1) local(u, y) (
  u = x * ge_g + ge_b;
  y = (u + u1) / (sqrt(1 + u * u) + sqrt(1 + u1 * u1));
  u1 = u;
  ge_pk = max(ge_pk, abs(u));
  (y - ge_fb) * ge_mk;
);
function ge_clr() instance(u1) ( u1 = ge_b; );
function amp_run(x) ( (ts(x * am_g + am_b) - am_fb) * am_mk; );

function pu_f(u) local(s) ( s = 1 / (u * u + 1);  s * sqrt(s); );
function pu_d1(u) ( abs(3 * u * (u * u + 1) ^ -2.5); );
function pu_d2(u) ( abs(3 * (4 * u * u - 1) * (u * u + 1) ^ -3.5); );
function t60_of(n) local(i, x0, x1) (
  n = min(max(n, 28), 108);
  i = n < 40 ? 0 : n < 52 ? 1 : n < 58 ? 2 : n < 64 ? 3 : n < 76 ? 4 : n < 88 ? 5 : n < 100 ? 6 : 7;
  x0 = i == 0 ? 28 : i == 1 ? 40 : i == 2 ? 52 : i == 3 ? 58 : i == 4 ? 64 : i == 5 ? 76 : i == 6 ? 88 : 100;
  x1 = i == 0 ? 40 : i == 1 ? 52 : i == 2 ? 58 : i == 3 ? 64 : i == 4 ? 76 : i == 5 ? 88 : i == 6 ? 100 : 108;
  exp(log(i == 0 ? 40 : i == 1 ? 27 : i == 2 ? 11 : i == 3 ? 9 : i == 4 ? 10.5 : i == 5 ? 7.6 : i == 6 ? 3.1 : 1.4) * (x1 - n) / (x1 - x0)
    + log(i == 0 ? 27 : i == 1 ? 11 : i == 2 ? 9 : i == 3 ? 10.5 : i == 4 ? 7.6 : i == 5 ? 3.1 : i == 6 ? 1.4 : 0.9) * (n - x0) / (x1 - x0));
);
function r_of(t60) ( exp(-6.9078 / (max(t60, 0.002) * srate)); );
function vcurve(vel) local(x, b) (
  x = min(max(vel / 127, 0.01), 1);  b = min(vs_k * 4, 1);
  0.7 * (1 - b) + b * x ^ (0.45 + 2.15 * vs_k ^ 1.3);
);
function tn_norm(p) local(off, xr, w) (
  off = p[T_OFF];  xr = p[T_HOF];  w = p[T_M + M_W];
  p[T_NRM] = 1 / max(2 * sin(0.5 * w) * sqrt(sqr(pu_d1(off) * xr) + sqr(0.5 * pu_d2(off) * xr * xr)), 0.000000001);
);

function tn_strike(p, n, vel, fresh) local(tr, kt, f, k, q, rat, w, tf, tl, L, i, c, fr, fi, F0, av, ab, m, t) (
  tr = min(max((n - 21) / 87, 0), 1);
  kt = (n - 60) / 12;
  av = vcurve(vel);
  ab = 1.6 - 1.0 * tr;
  tl = (2.4 - 1.6 * tn_hard) * (1.25 - 0.5 * av) * 2 ^ (-kt / 3) * 0.001;
  L = max(2, floor(min(max(tl, 0.0003), 0.008) * srate));
  fresh ? (
    p[T_NOTE] = n;
    f = 440 * 2 ^ ((n - 69 + (hash(n, 1) - 0.5) * 0.003 + (rand(2) - 1) * 0.003 * dm_a) / 12);
    tf = min(max(t60_of(n) * dk_sc * (0.88 + 0.24 * hash(n, 2)), 0.35), 45);
    k = 0;
    loop(3,
      q = p + T_M + k * 8;
      rat = k == 0 ? 1 : k == 1 ? 7.11 * (1 + (hash(n, 3) - 0.5) * 0.02) : 20.25 * (1 + (hash(n, 4) - 0.5) * 0.02);
      w = min(2 * $pi * f * rat / srate, 0.9 * $pi);
      t = k == 0 ? tf : min(tf, (k == 1 ? 1.15 : 0.3) * 2 ^ (-kt / 1.5) * (0.8 + 0.4 * hash(n, 10 + k)) * sqrt(dk_sc));
      q[M_W] = w;  q[M_RUP] = r_of(t);
      q[M_RDN] = r_of(k == 0 ? (0.16 + 0.3 * (1 - tr)) : k == 1 ? 0.09 : 0.05);
      q[M_Y1] = q[M_Y2] = 0;
      k += 1;
    );
    p[T_OFF] = tn_off * (1 + (hash(n, 5) - 0.5) * 0.12);
    p[T_HOF] = 0.45 * ab;
    tn_norm(p);
    p[T_FPR] = pu_f(p[T_OFF]);
    p[T_BINC] = 2 * $pi * CR * (0.3 + (0.25 + 0.45 * tr) * hash(n, 6)) / srate;
    p[T_BPH] = 2 * $pi * hash(n, 7);  p[T_BDP] = 0.05 + 0.05 * hash(n, 8);
    p[T_EN] = 0;  p[T_BM] = 1;
  );
  w = p[T_M + M_W];  c = 0;  fr = 0;  fi = 0;  i = 0;
  loop(L, c = 0.5 - 0.5 * cos(2 * $pi * (i + 0.5) / L);  fr += c * cos(w * i);  fi += c * sin(w * i);  i += 1; );
  F0 = max(sqrt(fr * fr + fi * fi), 0.000001);
  k = 0;
  loop(3,
    q = p + T_M + k * 8;
    m = k == 0 ? 1 : k == 1 ? 0.06 * tn_bell * (0.8 + 0.4 * hash(n, 30)) * (0.6 + 0.4 * av) : 0.006 * (0.4 + tn_hard) * av;
    q[M_G] = av * ab * m * sin(q[M_W]) / F0;
    q[M_A1] = 2 * q[M_RUP] * cos(q[M_W]);  q[M_A2] = q[M_RUP] * q[M_RUP];
    k += 1;
  );
  p[T_PL] = L;  p[T_PI] = 0;
  p[T_THG] = 0.035 * av * av;
  p[T_ON] = 1;  p[T_GATE] = 1;  p[T_SUS] = 0;  p[T_DMP] = 0;  p[T_STL] = 0;  p[T_FADE] = 1;
  age_n += 1;  p[T_AGE] = age_n;
  hm_disp = max(hm_disp, av);
);
function tn_damp(p) local(k, q) (
  p[T_DMP] = 1;  p[T_GATE] = 0;  p[T_SUS] = 0;
  k = 0;  loop(3, q = p + T_M + k * 8;  q[M_A1] = 2 * q[M_RDN] * cos(q[M_W]);  q[M_A2] = q[M_RDN] * q[M_RDN];  k += 1; );
);
function tn_alloc() local(i, p, best, ba, nact) (
  nact = 0;  i = 0;  loop(TVN, p = TVB + i * TVS;  p[T_ON] && !p[T_STL] ? nact += 1;  i += 1; );
  nact >= 8 ? (
    best = -1;  i = 0;
    loop(TVN, p = TVB + i * TVS;
      p[T_ON] && !p[T_STL] && (best < 0 || p[T_AGE] - p[T_DMP] * 1000000 < ba) ? ( best = i;  ba = p[T_AGE] - p[T_DMP] * 1000000; );
      i += 1; );
    best >= 0 ? ( p = TVB + best * TVS;  p[T_STL] = 1; );
  );
  best = -1;  i = 0;  loop(TVN, p = TVB + i * TVS;  best < 0 && !p[T_ON] ? best = i;  i += 1; );
  best < 0 ? ( i = 0;  loop(TVN, p = TVB + i * TVS;  p[T_STL] && (best < 0 || p[T_FADE] < ba) ? ( best = i;  ba = p[T_FADE]; );  i += 1; ); );
  TVB + max(best, 0) * TVS;
);
function tn_on_note(n, vel) local(i, p, f) (
  f = -1;  i = 0;
  loop(TVN, p = TVB + i * TVS;  p[T_ON] && p[T_NOTE] == n && !p[T_STL] ? f = i;  i += 1; );
  mono_k ? ( i = 0;  loop(TVN, p = TVB + i * TVS;  p[T_ON] && !p[T_STL] && !p[T_DMP] && i != f ? tn_damp(p);  i += 1; ); );
  f >= 0 ? (
    p = TVB + f * TVS;
    k_i = 0;  loop(3, k_q = p + T_M + k_i * 8;  k_q[M_A1] = 2 * k_q[M_RUP] * cos(k_q[M_W]);  k_q[M_A2] = k_q[M_RUP] * k_q[M_RUP];  k_i += 1; );
    tn_strike(p, n, vel, 0);
  ) : ( p = tn_alloc();  memset(p, 0, TVS);  tn_strike(p, n, vel, 1); );
);
function tn_off_note(n) local(i, p) (
  i = 0;
  loop(TVN, p = TVB + i * TVS;
    p[T_ON] && p[T_NOTE] == n && p[T_GATE] && !p[T_STL] ? ( sustain ? ( p[T_GATE] = 0;  p[T_SUS] = 1; ) : tn_damp(p); );
    i += 1; );
);

function og_tick_v(p) local(f, inc) (
  p[O_PCUR] += (p[O_PTGT] - p[O_PCUR]) * (mono_k ? gl_c : 1);
  f = 440 * 2 ^ ((p[O_PCUR] - 69 + bend_s + (p[O_DTN] + sup_v * 2 - sag_s * 2) * dm_a * 0.01 + wu_c * 0.01) / 12);
  inc = 0.5 * f / srate;
  p[O_INC] <= 0 ? p[O_INC] = inc;
  p[O_ISTP] = (inc - p[O_INC]) / CR;
  p[O_K16] = tb_oct(0.5 * f);  p[O_K8] = tb_oct(f);  p[O_K4] = tb_oct(2 * f);
);

function og_start(p, n, legato) (
  !legato ? (
    p[O_NOTE] = n;  p[O_PTGT] = n;  p[O_PCUR] = n;
    p[O_PRC] = 1;
    p[O_BNC] = floor((0.002 + rand(1) * 0.004) * srate);  p[O_FAST] = 1;
    p[O_DTN] = (rand(2) - 1) * 1.5;
    !p[O_ON] ? ( p[O_PH] = rand(1);  p[O_INC] = 0; );
  ) : ( p[O_NOTE] = n;  p[O_PTGT] = n; );
  p[O_ON] = 1;  p[O_GATE] = 1;  p[O_SUS] = 0;  p[O_TGT] = 1;  p[O_STL] = 0;  p[O_FADE] = 1;
  age_n += 1;  p[O_AGE] = age_n;
  og_tick_v(p);
);
function og_alloc() local(i, p, best, ba, nact) (
  nact = 0;  i = 0;  loop(OVN, p = OVB + i * OVS;  p[O_ON] && !p[O_STL] ? nact += 1;  i += 1; );
  nact >= 8 ? (
    best = -1;  i = 0;
    loop(OVN, p = OVB + i * OVS;
      p[O_ON] && !p[O_STL] && (best < 0 || p[O_AGE] + p[O_GATE] * 1000000 < ba) ? ( best = i;  ba = p[O_AGE] + p[O_GATE] * 1000000; );
      i += 1; );
    best >= 0 ? ( p = OVB + best * OVS;  p[O_STL] = 1; );
  );
  best = -1;  i = 0;  loop(OVN, p = OVB + i * OVS;  best < 0 && !p[O_ON] ? best = i;  i += 1; );
  best < 0 ? ( i = 0;  loop(OVN, p = OVB + i * OVS;  p[O_STL] && (best < 0 || p[O_FADE] < ba) ? ( best = i;  ba = p[O_FADE]; );  i += 1; ); );
  OVB + max(best, 0) * OVS;
);
function og_release(p) ( p[O_GATE] = 0;  sustain ? p[O_SUS] = 1 : p[O_TGT] = 0; );

function key_on(n, vel) local(i, p, f, lg) (
  n = n + 12 * oct_k;
  n >= 0 && n <= 127 ? (
    tn_on_note(n, vel);
    mono_k ? (
      i = 0;  f = 0;  loop(msk_n, MSK[i] == n ? f = 1;  f ? MSK[i] = MSK[i + 1];  i += 1; );  f ? msk_n -= 1;
      MSK[msk_n] = n;  msk_n = min(msk_n + 1, 127);
      p = OVB;  lg = p[O_ON] && p[O_GATE];
      og_start(p, n, lg);
    ) : (
      f = -1;  i = 0;
      loop(OVN, p = OVB + i * OVS;  p[O_ON] && p[O_NOTE] == n && !p[O_STL] ? f = i;  i += 1; );
      f >= 0 ? og_start(OVB + f * OVS, n, 0) : ( p = og_alloc();  memset(p, 0, OVS);  og_start(p, n, 0); );
    );
  );
);
function key_off(n) local(i, p, f, top) (
  n = n + 12 * oct_k;
  n >= 0 && n <= 127 ? (
    tn_off_note(n);
    mono_k ? (
      top = msk_n > 0 ? MSK[msk_n - 1] : -1;
      i = 0;  f = 0;  loop(msk_n, MSK[i] == n ? f = 1;  f ? MSK[i] = MSK[i + 1];  i += 1; );  f ? msk_n -= 1;
      p = OVB;
      top == n ? ( msk_n > 0 ? og_start(p, MSK[msk_n - 1], 1) : ( p[O_ON] && p[O_GATE] ? og_release(p); ); );
    ) : (
      i = 0;
      loop(OVN, p = OVB + i * OVS;  p[O_ON] && p[O_GATE] && p[O_NOTE] == n && !p[O_STL] ? og_release(p);  i += 1; );
    );
  );
);
function pedal_up() local(i, p) (
  i = 0;  loop(TVN, p = TVB + i * TVS;  p[T_ON] && p[T_SUS] ? tn_damp(p);  i += 1; );
  i = 0;  loop(OVN, p = OVB + i * OVS;  p[O_SUS] ? ( p[O_SUS] = 0;  !p[O_GATE] ? p[O_TGT] = 0; );  i += 1; );
);
function all_off() local(i, p) (
  i = 0;  loop(TVN, p = TVB + i * TVS;  p[T_ON] && !p[T_DMP] ? tn_damp(p);  i += 1; );
  i = 0;  loop(OVN, p = OVB + i * OVS;  p[O_ON] ? ( p[O_GATE] = 0;  p[O_SUS] = 0;  p[O_TGT] = 0; );  i += 1; );
  msk_n = 0;
);
function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? key_on(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? key_off(d1) :
  st == 0xE0 ? bend_t = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? all_off();
  );
);

function update_params() local(t, m) (
  drift_macro(drift);
  gtn_t = tn_on >= 0.5 ? tn_lvl : 0;  gtb_t = tb_on >= 0.5 ? tb_lvl : 0;  grd_t = rd_on >= 0.5 ? rd_lvl : 0;
  dk_sc = 0.25 * 8 ^ tn_dec;
  tn_off_t = 0.9 - 0.82 * tn_voic ^ 1.3;
  vs_k = vel_sens / 100;
  l16_t = tb_16;  l8_t = tb_8;  pc_t = tb_perc * 1.2;
  wv_t = floor(tb_wave + 0.5);  wv_t != wv_l ? dk_req = 1;
  k_rc = exp(-6.9 / (tb_sus * 0.001 * srate));
  r16_t = rd_16;  r8_t = rd_8;  rt_t = rd_tone;  rdv_t = rd_drv / 10;
  m = mono >= 0.5;  m != mono_k ? ( all_off();  mono_k = m; );
  gl_c = glide < 1 ? 1 : 1 - exp(-CR / (glide * 0.001 * srate * 0.4));
  oct_t = floor(octave + 0.5);
  bs_t = 10 ^ (bass_db / 20) - 1;  br_t = 10 ^ (treb_db / 20) - 1;
  adv_t = amp_drv / 10;
  outg_t = 10 ^ (vol / 20);
  os_tf = os_f2n(os_sel);
);

function sl_auto_au(idx) ( slider_automate(2 ^ (idx - 1)); );
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 1); pv(2, 0.8); pv(3, 0.5); pv(4, 0.35); pv(5, 0.5); pv(6, 0.5);
  pv(7, 0); pv(8, 0.8); pv(9, 0.8); pv(10, 0.5); pv(11, 0); pv(12, 0.3); pv(13, 30);
  pv(14, 0); pv(15, 0.8); pv(16, 0.8); pv(17, 0.5); pv(18, 1100); pv(19, 2);
  pv(20, 0); pv(21, 80); pv(22, 0); pv(23, 70); pv(24, 0); pv(25, 0); pv(26, 1); pv(28, 50); pv(29, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (
    pv(3, 0.45); pv(4, 0.3); pv(5, 0.6); pv(6, 0.55); pv(24, 2); pv(25, -2); pv(26, 2.5); pv(29, 2);
  ) :
  p == 3 ? (
    pv(1, 0); pv(7, 1); pv(9, 0.9); pv(10, 0.35); pv(12, 0.5); pv(13, 60); pv(24, 1);
  ) :
  p == 4 ? (
    pv(1, 0); pv(14, 1); pv(16, 0.8); pv(17, 0.6); pv(18, 880); pv(19, 3); pv(26, 1.5);
  ) :
  p == 5 ? (
    pv(1, 0); pv(14, 1); pv(16, 0.6); pv(17, 0.9); pv(18, 2200); pv(19, 8); pv(26, 5); pv(24, 2); pv(25, -3);
  ) :
  p == 6 ? (
    pv(2, 0.75); pv(5, 0.45); pv(7, 1); pv(8, 0.5); pv(9, 0.9); pv(10, 0); pv(12, 0); pv(13, 120);
  ) :
  p == 7 ? (
    pv(2, 0.7); pv(5, 0.65); pv(7, 1); pv(8, 0.45); pv(10, 0.3); pv(11, 1); pv(14, 1); pv(15, 0.4); pv(17, 0.4); pv(18, 660);
    pv(19, 4); pv(26, 3);
  ) :
  p == 8 ? (
    pv(1, 0); pv(7, 1); pv(9, 1); pv(10, 0.25); pv(11, 1); pv(12, 0); pv(13, 40); pv(20, 1); pv(21, 120); pv(25, -2); pv(26, 2);
  ) : 0;
  i = 1;  loop(29, sl_auto_au(i);  i += 1; );
  prm_dirty = 1;
);

PR_N = 8;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(30, i != 30 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  load_preset(k);
    k <= PR_N ? ( prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel;  prs_sel > 0 && prs_hs ? ( load_preset(prs_sel);  prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0;  prs_ok = 1; );
);
prs_ok = 0;  prs_dirty = 0;

function rate_setup() (
  smk = 1 - exp(-1 / (0.015 * srate));
  k_ainc = 1 / (0.002 * srate);
  p_dc = exp(-4.6 / (0.22 * srate));
  cf_att = 1 - exp(-1 / (0.003 * srate));  cf_rel = 1 - exp(-1 / (0.012 * srate));
  cf_bnc = 1 - exp(-1 / (0.0003 * srate));
  st_dc = exp(-1 / (0.003 * srate));
  dk_st = 1 / (0.005 * srate);
  dc_r = 1 - 2 * $pi * 5 / srate;
  lc_bs = 1 - exp(-2 * $pi * 110 / srate);  lc_br = 1 - exp(-2 * $pi * 2200 / srate);
  lc_tb = 1 - exp(-2 * $pi * 4400 / srate);
  r16L.bq_cf(0, 700, 0.6);
  ge_env_c = 1 - exp(-1 / (0.04 * srate));
  gl_c = 1;
);

rate_setup();
update_params();
mono_k = mono >= 0.5;  oct_k = oct_t;
age_n = 0;  cr_n = 0;  bend_t = 0;  bend_s = 0;  sag_s = 0;  sustain = 0;  msk_n = 0;  sup_v = 0;  pk_v = 0;
gtn = gtn_t;  gtb = gtb_t;  grd = grd_t;  tn_off = tn_off_t;  l16 = l16_t;  l8 = l8_t;  pc_s = pc_t;
r16 = r16_t;  r8 = r8_t;  rt_s = rt_t;  rt_l = 0;  rdv_s = rdv_t;  bs_s = bs_t;  br_s = br_t;  adv_s = adv_t;  out_g = outg_t;
wv_l = wv_t;  dk = 1;  dk_req = 0;  wv_tb = WT + wv_l * 11 * TSTR;  wv_g = wv_l == 0 ? 1.2 : wv_l == 1 ? 0.75 : 1;
os_tf = os_f2n(os_sel);

pwr_init(); pwr_hum_db = -89;  pwr_sag = 0.35;  pwr_wu_loss = 0.8;  pwr_wu_drv = 1.5;  pwr_wu_lp = 7000;  pwr_wu_wob = 0.3;  pwr_bloom = 0.1;

@slider
prs_chk();
update_params();
os_snap(slider(27));

@block
prs_chk();
pwr_block(1);
wu_c = (1 - pwr_gm) * (-8 + 3 * pwr_w1);
prm_dirty ? ( prm_dirty = 0;  update_params(); );
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? all_off();  tp_was = tp_now;
oct_t != oct_k ? ( b_n = 0;  b_i = 0;  loop(OVN, b_p = OVB + b_i * OVS;  b_p[O_ON] && b_p[O_GATE] ? b_n += 1;  b_i += 1; );  b_n == 0 ? oct_k = oct_t; );
t_b = samplesblock / srate;
sup_v = drf_sup.drift_tick(t_b * 0.2 * dm_s);
pk_v = drf_pk.drift_tick(t_b * 0.15 * dm_s);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
od_disp = max(od_disp, ge_pk * (grd > 0.01));  ge_pk = 0;
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );
b_n = 0;  b_i = 0;  loop(TVN, b_p = TVB + b_i * TVS;  b_p[T_ON] && !b_p[T_STL] ? b_n += 1;  b_i += 1; );  keys_d = b_n;
os_snapb(slider(27));

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  bend_s += (bend_t - bend_s) * (1 - exp(-CR / (0.01 * srate)));
  b_n = 0;  b_i = 0;  loop(OVN, b_p = OVB + b_i * OVS;  b_n += b_p[O_ON] * max(b_p[O_ETB] * (gtb > 0.001), b_p[O_ERD] * (grd > 0.001));  b_i += 1; );
  sag_s += (min(b_n, 6) / 6 - sag_s) * (1 - exp(-CR / (0.08 * srate)));
  tn_off += (tn_off_t - tn_off) * (1 - exp(-CR / (0.03 * srate)));
  b_i = 0;
  loop(OVN, b_p = OVB + b_i * OVS;  b_p[O_ON] ? og_tick_v(b_p);  b_i += 1; );
  b_i = 0;
  loop(TVN,
    b_p = TVB + b_i * TVS;
    b_p[T_ON] ? (
      b_p[T_BPH] += b_p[T_BINC];  b_p[T_BPH] > 2 * $pi ? b_p[T_BPH] -= 2 * $pi;
      b_p[T_BM] = 1 + b_p[T_BDP] * sin(b_p[T_BPH]);
      b_t = tn_off * (1 + (hash(b_p[T_NOTE], 5) - 0.5) * 0.12) + 0.012 * pk_v * dm_a;
      abs(b_t - b_p[T_OFF]) > 0.0005 ? ( b_p[T_OFF] = b_t;  tn_norm(b_p);  b_p[T_FPR] = pu_f(b_t + b_p[T_M + M_Y1] + b_p[T_M + 8 + M_Y1] + b_p[T_M + 16 + M_Y1]); );
    );
    b_i += 1;
  );
  rt_s += (rt_t - rt_s) * (1 - exp(-CR / (0.03 * srate)));
  abs(rt_s - rt_l) > rt_l * 0.002 ? ( r8L.bq_cf(0, rt_s, 0.8);  rt_l = rt_s; );
  rdv_s += (rdv_t - rdv_s) * (1 - exp(-CR / (0.03 * srate)));
  ge_g = 1.2 * 10 ^ (rdv_s * 30 / 20);
  ge_b = 0.16 + 0.22 * rdv_s * min(1, ge_e * ge_g * 1.5);
  ge_fb = ge_b / sqrt(1 + ge_b * ge_b);
  b_t = 0.07 * ge_g + ge_b;  ge_mk = 0.07 / (b_t / sqrt(1 + b_t * b_t) - ge_fb);
  adv_s += (adv_t - adv_s) * (1 - exp(-CR / (0.03 * srate)));
  am_g = 0.6 * 10 ^ (adv_s * 24 / 20);  am_b = 0.12 * adv_s;  am_fb = ts(am_b);
  am_mk = 0.1 / (ts(0.1 * am_g + am_b) - am_fb) * (1 - 0.03 * sag_s * dm_a);
);
cr_n -= 1;
!ge_ok ? ( gR.ge_clr();  ge_ok = 1; );

gtn += (gtn_t - gtn) * smk;  gtb += (gtb_t - gtb) * smk;  grd += (grd_t - grd) * smk;
l16 += (l16_t - l16) * smk;  l8 += (l8_t - l8) * smk;  pc_s += (pc_t - pc_s) * smk;
r16 += (r16_t - r16) * smk;  r8 += (r8_t - r8) * smk;
bs_s += (bs_t - bs_s) * smk;  br_s += (br_t - br_s) * smk;  out_g += (outg_t - out_g) * smk;
dk_req ? (
  dk -= dk_st;
  dk <= 0 ? ( dk = 0;  wv_l = wv_t;  dk_req = 0;  wv_tb = WT + wv_l * 11 * TSTR;  wv_g = wv_l == 0 ? 1.2 : wv_l == 1 ? 0.75 : 1; );
) : dk < 1 ? dk = min(1, dk + dk_st);

tnb = 0;
tn_live = gtn > 0.00001 || gtn_t > 0;
p = TVB;  v = 0;
loop(TVN,
  p[T_ON] ? (
    u_f = 0;
    p[T_PI] < p[T_PL] ? ( u_f = 0.5 - 0.5 * cos(2 * $pi * (p[T_PI] + 0.5) / p[T_PL]);  p[T_PI] += 1; );
    q = p + T_M;
    u_y = q[M_A1] * q[M_Y1] - q[M_A2] * q[M_Y2] + q[M_G] * u_f;  q[M_Y2] = q[M_Y1];  q[M_Y1] = u_y;  u_d = u_y;
    q += 8;
    u_y = q[M_A1] * q[M_Y1] - q[M_A2] * q[M_Y2] + q[M_G] * u_f;  q[M_Y2] = q[M_Y1];  q[M_Y1] = u_y;  u_d += u_y;
    q += 8;
    u_y = q[M_A1] * q[M_Y1] - q[M_A2] * q[M_Y2] + q[M_G] * u_f;  q[M_Y2] = q[M_Y1];  q[M_Y1] = u_y;  u_d += u_y;
    u_fl = pu_f(u_d + p[T_OFF]);
    u_o = ((u_fl - p[T_FPR]) * p[T_NRM] * p[T_BM] + u_f * p[T_THG]) * p[T_FADE];
    p[T_FPR] = u_fl;
    p[T_STL] ? ( p[T_FADE] *= st_dc;  p[T_FADE] < 0.0001 ? p[T_ON] = 0; );
    p[T_EN] = max(abs(u_o), p[T_EN] * 0.9995);
    p[T_DMP] && p[T_EN] < 0.00001 && p[T_PI] >= p[T_PL] ? p[T_ON] = 0;
    !p[T_DMP] && p[T_EN] < 0.000001 && p[T_PI] >= p[T_PL] && p[T_FADE] > 0 ? (
      abs(p[T_M + M_Y1]) < 0.0000001 ? p[T_ON] = 0;
    );
    tnb += u_o;
  );
  p += TVS;  v += 1;
);

tbb = 0;  rb16 = 0;  rb8 = 0;
tb_live = gtb > 0.00001 || gtb_t > 0;  rd_live = grd > 0.00001 || grd_t > 0;
p = OVB;
loop(OVN,
  p[O_ON] ? (
    p[O_INC] += p[O_ISTP];
    u_ph = p[O_PH] + p[O_INC];  u_ph >= 1 ? u_ph -= 1;  p[O_PH] = u_ph;
    u_e = p[O_ETB];
    p[O_TGT] ? u_e = min(1, u_e + k_ainc) : u_e *= k_rc;
    p[O_ETB] = u_e;  p[O_PRC] *= p_dc;
    p[O_BNC] > 0 ? (
      p[O_BNC] -= 1;
      (p[O_BNC] & 63) == 0 ? p[O_FAST] = rand(1) < 0.5 ? 0.6 : 1;
      p[O_ERD] += (p[O_FAST] - p[O_ERD]) * cf_bnc;
    ) : p[O_ERD] += (p[O_TGT] - p[O_ERD]) * (p[O_TGT] > p[O_ERD] ? cf_att : cf_rel);
    u_g = p[O_FADE];
    p[O_STL] ? ( p[O_FADE] *= st_dc;  p[O_FADE] < 0.0001 ? p[O_ON] = 0; );
    tb_live && u_e > 0.000001 ? (
      u_q8 = u_ph * 2;  u_q8 -= floor(u_q8);  u_q4 = u_ph * 4;  u_q4 -= floor(u_q4);
      tbb += (l16 * tone(wv_tb + p[O_K16], u_ph) + l8 * tone(wv_tb + p[O_K8], u_q8)
              + pc_s * p[O_PRC] * tone(wv_tb + p[O_K4], u_q4)) * u_e * u_g;
    );
    rd_live && p[O_ERD] > 0.000001 ? (
      u_d = p[O_INC];
      u_q8 = u_ph * 2;  u_q8 -= floor(u_q8);  u_q4 = u_ph * 4;  u_q4 -= floor(u_q4);  u_q2 = u_ph * 8;  u_q2 -= floor(u_q2);
      u_s = p[O_ERD] * u_g;
      rb16 += sqr_bl(u_ph, u_d) * u_s;
      rb8 += (sqr_bl(u_q8, 2 * u_d) + 0.5 * sqr_bl(u_q4, 4 * u_d) + 0.25 * sqr_bl(u_q2, 8 * u_d)) * u_s;
    );
    !p[O_TGT] && u_e < 0.00001 && p[O_ERD] < 0.00001 ? p[O_ON] = 0;
  );
  p += OVS;
);

t_lp += (tbb - t_lp) * lc_tb;
other = tnb * 0.1 * gtn + t_lp * 0.125 * wv_g * gtb * dk;
reed = (r16L.bq_run(rb16) * 1.3 + r8L.bq_run(rb8)) * 0.05 * grd;
ge_e += (abs(reed) - ge_e) * ge_env_c;

pwr_in(other, reed);  other = pwr_l;  reed = pwr_r;

os_gate();
os_chg ? ( gR.ge_clr();  uxO.os_clr();  uxR.os_clr();  dnA.os_clr(); );
uxO.os_up(other);  uxR.os_up(reed);
os_f == 1 ? (
  y = amp_run(other + gR.ge_run(reed));
) : os_f == 2 ? (
  a0 = amp_run(uxO.s0 + gR.ge_run(uxR.s0));  a1 = amp_run(uxO.s1 + gR.ge_run(uxR.s1));
  y = dnA.os_dn(a0, a1, 0, 0);
) : (
  a0 = amp_run(uxO.s0 + gR.ge_run(uxR.s0));  a1 = amp_run(uxO.s1 + gR.ge_run(uxR.s1));
  a2 = amp_run(uxO.s2 + gR.ge_run(uxR.s2));  a3 = amp_run(uxO.s3 + gR.ge_run(uxR.s3));
  y = dnA.os_dn(a0, a1, a2, a3);
);
y *= os_g;

t_l += (y - t_l) * lc_bs;  t_h += (y - t_h) * lc_br;
y += t_l * bs_s + (y - t_h) * br_s;
dc_x = y - dc_p + dc_r * dc_x;  dc_p = y;  y = dc_x;
pwr_out(y, y);  y = pwr_l;
ost_out(y * out_g, y * out_g);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;
pwr_ser();

@gfx 1200 640
C_PANEL = 0x141A2A;  C_SEC1 = 0x2B3554;  C_SEC2 = 0x222B45;
C_INK = 0xECE6D8;  C_INK2 = 0xB9B3A6;  C_DIM = 0x6A6C70;  C_RIV = 0x4F5A78;
C_HEAD = 0xEDE5D0;  C_HINK = 0x1C1A16;  C_HINK2 = 0x5A5246;
C_TN = 0x9EC0E0;  C_TB = 0xF0A84A;  C_RD = 0xEC7A6E;
C_LCDBG = 0x120D05;  C_LCDTX = 0xFFB547;  lk_well = 0x111214;
LK_AMB = 0xF2A41E;  LK_ORG = 0xF28A2E;  LK_RED = 0xE8503A;
CP_TN = 0xC3D9EE;  CP_TB = 0xF6D29A;  CP_RD = 0xF4B0A2;
CP_BRN = 0xD9B48C;  CP_COR = 0xF2A68E;  CP_CRM = 0xF1EAD8;  CP_GRY = 0xC9C9C4;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_l(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_r(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function rivet(x, y) (
  col(C_RIV, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.45);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
function section(x, y, w, h, c, title, c3) (
  col(c, 1);  u_rect(x, y, w, h);
  col(0x000000, 0.28);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h - 2);
  col(0xFFFFFF, 0.12);  u_rect(x, y, w - 2, 1);  u_rect(x, y, 1, h - 2);
  gfx_setfont(4);  col(C_INK, 1);  text_l(px(x + 16), py(y + 20), title);
  col(c3, 1);  u_rect(x + 16, y + 32, w - 32, 3);
);
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v * 100 + 0.5) :
  fmt == 3 ? ( v < 10 ? sprintf(#kv, "%.1f ms", v) : v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 4 ? sprintf(#kv, "%d %%", v) :
  fmt == 5 ? ( v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
  fmt == 6 ? sprintf(#kv, "%.1f", v) :
  fmt == 7 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 8 ? sprintf(#kv, "%+d", v) :
  fmt == 9 ? ( v < 1 ? strcpy(#kv, "OFF") : sprintf(#kv, "%d ms", v); ) :
  fmt == 10 ? sprintf(#kv, v < 0.34 ? "DARK %d" : v < 0.67 ? "CLASSIC %d" : "BARK %d", v * 100 + 0.5) :
             sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
function dshadow(x, y, r) local(i) (
  i = 0;
  loop(4, col(0x000000, 0.13);  gfx_circle(x + ps(2 + i * 1.33), y + ps(3 + i * 1.67), r + ps(i * 0.6), 1, 1);  i += 1; );
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.55 + 0.5); gfx_drawstr(str);
);

function kn(cx, cy, r, idx, vmin, vmax, def, cap, lbl, fmt)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lgt, st, dm, zr, capr, dr)
(
  lgt = klog;  klog = 0;  st = kstep;  kstep = 0;  dm = kdim;  kdim = 0;  zr = kzero;  kzero = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t;  drag_y0 = mouse_y; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx && abs(mouse_y - drag_y0) >= 3 ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 200)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st :
    lgt ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 1000 + 0.5) / 1000;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    drag_y0 = -100000;
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  j = 0;
  st > 0 && (vmax - vmin) / st <= 6 ? (
    loop((vmax - vmin) / st + 1,
      b = a0 + j * st / (vmax - vmin) * (a1 - a0);
      col(C_INK2, 0.9);  gfx_circle(x + sin(b) * (rr + ps(7)), y - cos(b) * (rr + ps(7)), max(1, ps(1.7)), 1, 1);
      j += 1;
    );
  ) : (
    loop(5,
      b = a0 + j / 4 * (a1 - a0);
      col(C_INK2, 0.9);
      !(zr && j == 2) ? gfx_circle(x + sin(b) * (rr + ps(7)), y - cos(b) * (rr + ps(7)), max(1, ps(j == 0 || j == 4 ? 1.8 : 1.4)), 1, 1);
      j += 1;
    );
  );
  zr ? ( gfx_setfont(5);  col(C_INK2, 1);  text_c(x, y - rr - ps(10), "0"); );
  dshadow(x, y, rr);
  col(0x17181B, 1);  gfx_circle(x, y, rr, 1, 1);
  col(0x3A3D42, 1);  gfx_circle(x, y, rr - ps(1), 0, 1);
  col(0xFFFFFF, 0.10);  gfx_arc(x, y, rr - ps(1.5), -1.9, -0.2, 1);
  capr = rr * 0.74;
  col(dm ? shade(cap, 0.55) : cap, 1);  gfx_circle(x, y, capr, 1, 1);
  col(0x000000, 0.10);  gfx_arc(x, y, capr - ps(0.5), -3.1, 3.1, 1);
  col(0x000000, 0.10);  gfx_arc(x, y, capr - ps(0.5), 0.3, 2.8, 1);  gfx_arc(x, y, capr - ps(1.5), 0.6, 2.5, 1);
  col(0xFFFFFF, 0.35);  gfx_arc(x, y, capr - ps(1), -1.7, -0.3, 1);
  dr = max(2, capr * 0.19);
  col(dm ? 0x55534E : 0x26221C, 1);  gfx_circle(x + sin(tv) * capr * 0.62, y - cos(tv) * capr * 0.62, dr, 1, 1);
  gfx_setfont(6);  col(dm ? C_DIM : C_INK, 1);  text_c(x, y + rr + ps(19), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(18), fmtv(v, fmt));
);

function rk_tab(x, y, w, h, on, c, str) local(hov, hit, i, lens, m)
(
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  i = 0;  loop(4, col(0x000000, 0.13);  lk_rr(x - 3 + 2 + i * 1.33, y - 3 + 3 + i * 1.67, w + 6, h + 6, 5);  i += 1; );
  on ? ( col(c, 0.12);  lk_rr(x - 9, y - 9, w + 18, h + 18, 10);  col(c, 0.18);  lk_rr(x - 6, y - 6, w + 12, h + 12, 8); );
  col(lk_well, 1);  lk_rr(x - 3, y - 3, w + 6, h + 6, 5);
  lens = on ? c : shade(ui_mix(c, 0xCFC9BC, 0.45), 0.62);
  m = y + h * 0.5;
  on ? (
    col(shade(lens, 0.78), 1);  lk_rr(x, y, w, h * 0.5 + 2, 4);
    col(lens, 1);  lk_rr(x, m, w, h * 0.5, 4);
    col(ui_mix(lens, 0xFFFFFF, 0.18), 1);  lk_rr(x + 4, m + 3, w - 8, h * 0.5 - 8, 3);
    col(ui_mix(lens, 0xFFFFFF, 0.32), 1);  lk_rr(x + 8, m + 6, w - 16, h * 0.5 - 14, 3);
    col(0x000000, 0.35);  u_rect(x + 1, m - 1, w - 2, 1.5);
  ) : (
    col(lens, 1);  lk_rr(x, y, w, h * 0.5 + 2, 4);
    col(shade(lens, 0.72), 1);  lk_rr(x, m, w, h * 0.5, 4);
    col(0x000000, 0.12);  lk_rr(x + 1, y + 1, w - 2, h - 2, 4);
    col(lens, 1);  lk_rr(x + 3, y + 3, w - 6, h * 0.5 - 4, 3);
    col(0x000000, 0.4);  u_rect(x + 1, m + 1, w - 2, 1.5);
  );
  col(0xFFFFFF, on ? 0.45 : 0.25);  u_rect(x + 4, y + 1, w - 8, 1.5);
  hov ? ( col(0xFFFFFF, 0.07);  lk_rr(x, y, w, h, 4); );
  gfx_setfont(2);  col(on ? shade(c, 0.28) : 0x1C1A16, 1);
  ui_keytext(px(x + w * 0.5), py(on ? m + h * 0.25 : y + h * 0.25 + 1), str);
  hit;
);

function lcd_box(x, y, w, h) (
  col(0x000000, 0.5);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x050403, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  col(0xFFFFFF, 0.06);  u_rect(x + 4, y + 4, w - 8, 1);
);
function lcd_text(x, y, fnt, str) local(tw, th, gy) (
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y) - th * 0.5;
  col(C_LCDTX, 0.22);
  gfx_x = px(x) - 1;  gfx_y = gy;  gfx_drawstr(str);
  gfx_x = px(x) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x);  gfx_y = gy;  gfx_drawstr(str);
);
function lcd(x, y, w, h, fnt, str) ( lcd_box(x, y, w, h);  lcd_text(x + 10, y + h * 0.5, fnt, str); );

function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, col(0x000000, 0.13);  lk_rr(x - 4 * k + 2 + i * 1.33, y - 4 * k + 3 + i * 1.67, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
  col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
  col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
  col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  col(0xFFFFFF, 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);

function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, LK_ORG, "PRESETS") ? open = 1;
  lk_key(x + 96, y + 3, 24, h - 6, 0, LK_ORG, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 122, y + 3, 24, h - 6, 0, LK_ORG, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1A1A, 1);  pb_tri(x + 108, y + h * 0.5, 4.5, -1);  pb_tri(x + 134, y + h * 0.5, 4.5, 1);
  lx = x + 152;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
function dsp_menu(x, y, w, h, idx, list, n, lbl) local(t, sel, i) (
  t = floor(slider(idx) + 0.5);
  gfx_setfont(5);  col(C_INK2, 1);  text_l(px(x), py(y - 14), lbl);
  lcd(x, y, w, h, 7, pb_item(list, t + 1, #lm));
  col(C_LCDTX, 0.8);  pb_tri(x + w - 14, y + h * 0.5, 4, 1);
  click && !drag_idx && mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h) ? (
    strcpy(#lmm, "");  i = 0;
    loop(n, i == t ? strcat(#lmm, "!");  strcat(#lmm, pb_item(list, i + 1, #lmt));  i < n - 1 ? strcat(#lmm, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h + 4);  sel = gfx_showmenu(#lmm);
    sel > 0 ? ( slider(idx) = sel - 1;  param_touched(idx); );
  );
);
function lamp(x, y, c, lv, lbl) (
  col(0x000000, 0.7);  gfx_circle(px(x), py(y), ps(6.5), 1, 1);
  lv > 0.02 ? ( col(c, 0.28 * lv);  gfx_circle(px(x), py(y), ps(11), 1, 1); );
  col(ui_mix(shade(c, 0.28), c, lv), 1);  gfx_circle(px(x), py(y), ps(5), 1, 1);
  lv > 0.3 ? ( col(0xFFFFFF, 0.5 * lv);  gfx_circle(px(x) - ps(1.4), py(y) - ps(1.4), ps(1.4), 1, 1); );
  gfx_setfont(5);  col(C_INK2, 1);  text_r(px(x - 14), py(y), lbl);
);
function grey_over(x, y, w, h, c) ( col(c, 0.5);  u_rect(x + 1, y + 40, w - 3, h - 42); );

WAVE_LIST = "FLUTE|SQUARE|PULSE";
PRESET_MENU = "Init|Piano Bass|Combo Bass|Reed Bass|Garage Fuzz|Tine and Tab|Three-Way Stack|Mono Glide";

g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1200 * g_ret), gfx_h / (640 * g_ret))), 0.5);
ox = (gfx_w - 1200 * sc) * 0.5;
oy = (gfx_h - 640 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
h_click = sz_help ? click : 0;  h_wheel = sz_help ? mouse_wheel : 0;
sz_help ? ( click = 0;  mouse_wheel = 0; );
klog = 0;  kstep = 0;  kdim = 0;  kzero = 0;

function fit_font(idx, face, size) local(fs, w, h, target) (
  target = 5.28 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, face, fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);
sc != ff_sc ? (
  ff_sc = sc;
  fs10 = fit_font(10, "Courier New", ps(14));
  fs2 = fit_font(2, "Courier New", ps(15));
  fs3 = fit_font(3, "Courier New", ps(14));
  fs4 = fit_font(4, "Courier New", ps(18));
  fs5 = fit_font(5, "Courier New", ps(13));
  fs6 = fit_font(6, "Courier New", ps(16));
  fs11 = fit_font(11, "Trebuchet MS", ps(18));
);
gfx_setfont(1, "Trebuchet MS", ps(34), 'bi');
gfx_setfont(10, "Courier New", fs10, 'b');
gfx_setfont(2, "Courier New", fs2, 'b');
gfx_setfont(3, "Courier New", fs3, 'b');
gfx_setfont(4, "Courier New", fs4, 'b');
gfx_setfont(5, "Courier New", fs5, 'b');
gfx_setfont(6, "Courier New", fs6, 'b');
gfx_setfont(11, "Trebuchet MS", fs11, 'b');
gfx_setfont(7, "Courier New", ps(17), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');

out_m = max(outpk_disp, out_m * 0.85);  outpk_disp = 0;
od_m = max(od_disp, od_m * 0.8);  od_disp = 0;
hm_m = max(hm_disp, hm_m * 0.82);  hm_disp = 0;

col(0x0C101A, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(C_PANEL, 1);  u_rect(0, 0, 1200, 640);
col(C_HEAD, 1);  u_rect(0, 0, 1200, 66);
col(0xFFFFFF, 0.35);  u_rect(0, 0, 1200, 1);
col(0x000000, 0.10);  u_rect(0, 62, 1200, 4);
col(C_TN, 1);  u_rect(0, 66, 400, 5);  col(C_TB, 1);  u_rect(400, 66, 400, 5);  col(C_RD, 1);  u_rect(800, 66, 400, 5);
col(0x000000, 1);  u_rect(0, 71, 1200, 3);
rivet(8, 8);  rivet(1192, 8);  rivet(8, 632);  rivet(1192, 632);
gfx_setfont(1);  col(0x000000, 0.18);  text_l(px(26), py(35), "RAYMAN");  col(C_HINK, 1);  text_l(px(24), py(33), "RAYMAN");
gfx_setfont(1);  gfx_measurestr("RAYMAN", ttl_w, ttl_h);
gfx_setfont(10);  col(C_HINK2, 1);  text_l(px(24) + ttl_w + ps(16), py(37), "BASS KEYBOARD");
gfx_setfont(11);  col(C_HINK, 1);  text_l(px(944), py(33), "GFX");

prs_cur_d > 0 ? ( pr_cur = prs_cur_d;  prs_cur_d = 0; );
pb_k = preset_bar(400, 16, 34, 320, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > PR_N ? 1 : pb_k; );

col(0x000000, 0.35);  u_rect(0, 637, 1200, 3);  u_rect(1197, 74, 3, 566);

MY = 90;  MH = 312;

section(16, MY, 378, MH, C_SEC1, "TINE", C_TN);
gfx_setfont(5);  col(C_INK2, 1);  text_r(px(378), py(MY + 20), "PIANO BASS");
tn_on < 0.5 ? grey_over(16, MY, 378, MH, C_SEC1);
rk_tab(40, MY + 64, 64, 56, tn_on >= 0.5, LK_RED, "ON") ? ( slider(1) = tn_on >= 0.5 ? 0 : 1;  param_touched(1); );
kdim = tn_on < 0.5;  kn(196, MY + 96, 28, 2, 0, 1, 0.8, CP_TN, "LEVEL", 1);
lamp(352, MY + 96, 0xFFC864, tn_on >= 0.5 ? min(1, hm_m) : 0, "HAMMER");
kdim = tn_on < 0.5;  kn(68, MY + 226, 20, 3, 0, 1, 0.5, CP_TN, "HARDNESS", 1);
kdim = tn_on < 0.5;  kn(158, MY + 226, 20, 4, 0, 1, 0.35, CP_TN, "BELL", 1);
kdim = tn_on < 0.5;  kn(248, MY + 226, 20, 5, 0, 1, 0.5, CP_TN, "VOICING", 10);
kdim = tn_on < 0.5;  kn(338, MY + 226, 20, 6, 0, 1, 0.5, CP_TN, "DECAY", 1);

section(410, MY, 378, MH, C_SEC2, "TAB", C_TB);
gfx_setfont(5);  col(C_INK2, 1);  text_r(px(772), py(MY + 20), "TRANSISTOR BASS");
tb_on < 0.5 ? grey_over(410, MY, 378, MH, C_SEC2);
rk_tab(434, MY + 64, 64, 56, tb_on >= 0.5, LK_RED, "ON") ? ( slider(7) = tb_on >= 0.5 ? 0 : 1;  param_touched(7); );
kdim = tb_on < 0.5;  kn(590, MY + 96, 28, 8, 0, 1, 0.8, CP_TB, "LEVEL", 1);
dsp_menu(660, MY + 84, 110, 32, 11, WAVE_LIST, 3, "WAVE");
kdim = tb_on < 0.5;  kn(462, MY + 226, 20, 9, 0, 1, 0.8, CP_TB, "16'", 1);
