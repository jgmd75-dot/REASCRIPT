AVS1 = 0xE6A47A; AVS2 = 0x9FD8C4; AVS3 = 0x4CF58A;
#av_title = "TEMPERANCE"; #av_sub1 = "STRUCK"; #av_num = "XIV"; AVEM = 4; #av_sub2 = "STRINGS";
#av_pm = "Init|Still Water|Two Cups|Iris Path|Mercury Rain|Nigredo|Circulatio|Aqua Vitae|Patient Hands|Quintessence|Prima Materia|The Middle Way";
ui_begin(900, 400);
v5_begin();
sc != av_fsc ? (
