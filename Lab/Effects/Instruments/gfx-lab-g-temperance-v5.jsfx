  r;
);
function av_rings(x, cy, n, r, sp, col) local(i, cx) (
  i = 0; loop(n, cx = x + r + i * sp;
    ui_col(col); gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); gfx_circle(cx * sc, cy * sc, (r - 0.5) * sc, 0, 1);
    i += 1; );
