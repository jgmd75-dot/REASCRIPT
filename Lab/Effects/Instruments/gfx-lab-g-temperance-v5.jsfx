    i = 1; loop(4, ui_col(ui_mix(col, 0xFFFFFF, 0.08 * i)); v5_rr(x + 1 + i * s * 0.07, y + 1 + i * s * 0.06, s - 2 - i * s * 0.14, s - 2 - i * s * 0.12, 2); i += 1; );
    ui_cola(0xFFFFFF, 0.4); v5_r(x + 3, y + 2, s - 6, 1);
  ) : (
