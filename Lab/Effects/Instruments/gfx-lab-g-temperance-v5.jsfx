function av_sqv(x, y, s, on, lg) local(r) (
  r = v5_pr && v5_drag == 0 && v5_hit(x, y, s, s) ? ( v5_drag = -1; 1; ) : 0;
  v5_edge(x, y, s, s, on, lg, AVA);
