fill_on_d = sq_fill || fill_arm;
eqi = 0; spos = 0;

w_dt = samplesblock / srate;
w_dpi = dP.drift_tick(w_dt * 0.3) * w_dm; w_dli = dL.drift_tick(w_dt * 0.25) * w_dm; w_dfi = dF.drift_tick(w_dt * 0.3) * w_dm;
w_drp = exp((w_dpi * 3 + (w_era == 2 ? w_dli * 6 : 0)) / 1200 * 0.6931471805599453);
w_drl = 1 + w_dli * (w_era == 2 ? 0.05 : 0.015);
w_ffb = w_era == 3 ? w_dfi * 0.25 : 0;
