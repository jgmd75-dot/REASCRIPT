function ed_def(i) ( i == 0 ? 60 : i == 1 ? 55 : i == 2 ? 0 : i == 3 ? 60 : i == 4 ? 60 : i == 5 ? 0 : i == 6 ? 60 : i == 7 ? 70 : i == 8 ? 1 :
  i == 9 ? 55 : i == 10 ? 50 : i == 11 ? 35 : i == 12 ? 60 : i == 13 ? 60 : i == 14 ? 40 : i == 15 ? 50 : i == 16 ? 25 : 6 );
function load_preset(p) local(i, q, e) (
