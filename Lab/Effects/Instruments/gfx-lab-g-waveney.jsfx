    m2 == 123 || m2 == 120 ? q_push(mofs, 3, 0, 0);
  );
);
au_pst = play_state == 1 || play_state == 5;
au_pst_prev && !au_pst ? q_push(0, 3, 0, 0);
au_pst_prev = au_pst;
w_era != last_era ? ( last_era >= 0 ? q_push(0, 3, 0, 0); last_era = w_era; );

fill_dirty ? ( fill_dirty = 0; sq_on ? fill_arm = 1; );
sq_play = play_state & 1;
sq_on = p_run >= 0.5 || (p_syn >= 0.5 && sq_play);
sq_tmp = p_syn >= 0.5 ? tempo : p_tmp;
sq_bps = sq_tmp / 60 / srate;
sq_on ? (
  !sq_was ? ( g_sty = min(max(p_sty | 0, 0), 15); g_var = p_var >= 0.5; sq_fb = 0; sq_lt = -1; sq_fill = 0; fill_arm = 0; sq_crash = 0; );
  sq_t0 = sq_play && p_syn >= 0.5 ? beat_position : sq_fb;
  sq_t0 < sq_lt - 0.01 ? sq_lt = sq_t0 - 0.000001;
  sq_t1 = sq_t0 + sq_bps * samplesblock;
  sq_L = 1 / SB[g_sty];
  k_ = floor(sq_t0 / sq_L) - 1;
  sq_guard = 0;
