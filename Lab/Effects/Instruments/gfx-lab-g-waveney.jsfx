function pr(a, b, c, d, e, f, g, h, i, j, k, l, m) ( pq[0] = a; pq[1] = b; pq[2] = c; pq[3] = d; pq[4] = e; pq[5] = f; pq[6] = g; pq[7] = h; pq[8] = i; pq[9] = j; pq[10] = k; pq[11] = l; pq[12] = m; pq += PS; );
pq = PT;
