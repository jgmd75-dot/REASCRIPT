);

w_trms > 0.001 ? ( tg = 1 - w_trms * 0.45 * (1 + sin(2 * $pi * w_vph * 0.93 + 1)); oL *= tg; oR *= tg; );

w_rots > 0.001 ? (
  rot_sp += ((modw_s > 0.5 ? 6.4 : 0.75) - rot_sp) * 0.00004;
  rot_ph += rot_sp / srate; rot_ph >= 1 ? rot_ph -= 1;
