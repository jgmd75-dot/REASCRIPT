      g_var = p_var >= 0.5;
      sq_ns != g_sty ? (
        sq_ob = SB[g_sty]; g_sty = sq_ns;
        SB[g_sty] != sq_ob ? ( sq_L = 1 / SB[g_sty]; k_ = floor(k_ * sq_ob / SB[g_sty]); );
        s_ = k_ % SN[g_sty];
      );
