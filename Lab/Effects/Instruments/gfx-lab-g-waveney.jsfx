  dl_a = (7 + 2.2 * sin(2 * $pi * ch_ph)) * srate * 0.001; dl_b = (7 + 2.2 * cos(2 * $pi * ch_ph)) * srate * 0.001;
  p_ = dl_w - dl_a; p_ < 0 ? p_ += DLN; j = floor(p_); fr = p_ - j; wa_ = DLY[j] + (DLY[(j + 1) & DLM] - DLY[j]) * fr;
  p_ = dl_w - dl_b; p_ < 0 ? p_ += DLN; j = floor(p_); fr = p_ - j; wb_ = DLY[j] + (DLY[(j + 1) & DLM] - DLY[j]) * fr;
  oL += wa_ * 0.38 * w_chos; oR += wb_ * 0.38 * w_chos;
  dl_w = (dl_w + 1) & DLM;
);

dsL = dsR = 0;
dn_ = 0; r = DR;
loop(8,
  r[0] ? (
    e = r[1]; r[1] *= r[2];
    r[4] = r[5] + (r[4] - r[5]) * r[6];
    y = 0;
    r[7] > 0 ? (
      r[3] += r[4] / srate; r[3] -= floor(r[3]);
      y = sin(2 * $pi * r[3]) * r[7] * e;
      r[22] > 0 ? ( r[21] += r[4] * r[22] / srate; r[21] -= floor(r[21]); y += sin(2 * $pi * r[21]) * r[7] * e * 0.5; );
    );
    r[8] > 0 ? (
      nz = rand(2) - 1; r[11] += (nz - r[11]) * r[12]; r[16] += ((nz - r[11]) - r[16]) * r[17];
      y += r[16] * r[8] * r[9]; r[9] *= r[10];
    );
    r[19] > 0.0001 ? ( y += (rand(2) - 1) * r[19]; r[19] *= 0.6; );
