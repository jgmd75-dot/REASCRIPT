rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pwr_block(1);
wu_t = exp(-(1 - pwr_gm) * (2 + 1.0 * pwr_w1) / 1200 * 0.6931471805599453);

qcount = 0;
while (midirecv(mofs, m1, m2, m3)) (
  midisend(mofs, m1, m2, m3);
  st_ = m1 & 0xF0;
  st_ == 0x90 && m3 > 0 ? ins_midi_hit();
  st_ == 0x90 || st_ == 0x80 ? q_push(mofs, st_ == 0x90 && m3 > 0, m2, m3) :
  st_ == 0xE0 ? bend = ins_bend(m2, m3, 2) :
