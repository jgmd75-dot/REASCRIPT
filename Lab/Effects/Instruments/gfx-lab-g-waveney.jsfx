  dl_a = (1.6 + 0.9 * rs_) * srate * 0.001; dl_b = (1.6 - 0.9 * rs_) * srate * 0.001;
  p_ = dl_w - dl_a; p_ < 0 ? p_ += DLN; j = floor(p_); fr = p_ - j; wa_ = DLY[j] + (DLY[(j + 1) & DLM] - DLY[j]) * fr;
  p_ = dl_w - dl_b; p_ < 0 ? p_ += DLN; j = floor(p_); fr = p_ - j; wb_ = DLY[j] + (DLY[(j + 1) & DLM] - DLY[j]) * fr;
  wa_ *= 1 + 0.25 * rc_; wb_ *= 1 - 0.25 * rc_;
  oL += (wa_ * 1.1 - oL) * w_rots * 0.75; oR += (wb_ * 1.1 - oR) * w_rots * 0.75;
  dl_w = (dl_w + 1) & DLM;
) : w_chos > 0.001 ? (
  DLY[dl_w] = (oL + oR) * 0.5;
