@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (eqi < qcount && (EQO[eqi] <= spos || spos >= samplesblock - 1)) (
  et_ = EQT[eqi];
  et_ == 1 ? note_on(EQN[eqi], EQV[eqi]) : et_ == 0 ? note_off(EQN[eqi]) : et_ == 2 ? pedal_up() : et_ == 3 ? all_off() : seq_step(EQN[eqi], EQV[eqi]);
  eqi += 1;
);
spos += 1;

w_cabs += (w_cabt - w_cabs) * w_sm; w_trms += (w_trmt - w_trms) * w_sm; w_mtns += (w_mtnt - w_mtns) * w_sm;
w_pks += (w_pkt - w_pks) * w_sm; w_spks += (w_spkt - w_spks) * w_sm; w_cuts += (w_cutt - w_cuts) * w_sm;
w_fenvs += (w_fenvt - w_fenvs) * w_sm; w_subs += (w_subt - w_subs) * w_sm; w_lows += (w_lowt - w_lows) * w_sm;
w_peds += (w_pedt - w_peds) * w_sm; w_rots += (w_rott - w_rots) * w_sm; w_bals += (w_balt - w_bals) * w_sm;
w_chos += (w_chot - w_chos) * w_sm; w_vibs += (w_vibt - w_vibs) * w_sm; vol_s += (vol_t - vol_s) * w_sm;
w_mfs += (w_mfc - w_mfs) * w_sm; w_pfs += (w_pfc - w_pfs) * w_sm;
bend_s += (bend - bend_s) * w_sm; modw_s += (modw - modw_s) * w_sm;

w_vph += w_vrt / srate; w_vph >= 1 ? w_vph -= 1;
w_lfo = sin(2 * $pi * w_vph);
w_pmu = bend_s * w_drp * wu_t * exp(w_lfo * (w_vibs + (w_era == 4 ? 0 : modw_s * 0.6)) * 35 / 1200 * 0.6931471805599453);
w_pma = w_drp * wu_t;

(w_ctr -= 1) <= 0 ? ( w_ctr = 16; w_cof = 1; ) : w_cof = 0;
oL = oR = 0;
i_ = 0; d = VX;
loop(NS,
  d[0] ? (
    k = d[2];
    pm = k == 0 ? w_pmu : w_pma;
    ph = d[4] + d[3] * pm; ph -= floor(ph); d[4] = ph;
    x = ph * 2048; j = floor(x); fr = x - j; t = d[6];
    a = t[j]; b = t[(j + 1) & 2047]; y = a + (b - a) * fr;
    d[16] > 0.0005 ? ( t = d[7]; a = t[j]; b = t[(j + 1) & 2047]; y += (a + (b - a) * fr - y) * d[16]; d[16] *= d[17]; );
    d[8] > 0 ? (
      ph2 = d[5] + d[3] * pm * d[35]; ph2 -= floor(ph2); d[5] = ph2;
      x = ph2 * 2048; j = floor(x); fr = x - j; t = d[8];
      a = t[j]; b = t[(j + 1) & 2047]; y += (a + (b - a) * fr - y) * w_bals;
    );
    d[18] > 0.0005 ? ( nz = rand(2) - 1; d[20] += (nz - d[20]) * d[37]; y += (nz - d[20]) * d[18]; d[18] *= d[19]; );
    d[39] == 3 && k == 0 ? (
      d[34] += d[3] * pm * 0.5; d[34] -= floor(d[34]);
      y += sin(2 * $pi * d[34]) * w_subs * 0.8;
      d[30] *= w_fedc;
