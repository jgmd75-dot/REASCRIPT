wv_age = 0; ped_n = -1; qcount = 0; pedal = 0; bend = 1; bend_s = 1; modw = 0; modw_s = 0;
sq_was = 0; sq_fill = 0; sq_crash = 0; fill_arm = 0; sq_step_d = -1; sq_n_d = 16; sq_spb_d = 4;
sq_lt = -1; g_sty = 3; g_var = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.12; pwr_wu_loss = 0.5; pwr_wu_drv = 0.4; pwr_wu_lp = 9000; pwr_wu_wob = 0.1; pwr_bloom = 0;
dP.drift_init(0.7); dL.drift_init(0.9); dF.drift_init(1.1);
rs_f = 1; mn_pk_d = 0; last_era = -1;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
wv_srinit();
w_cabs = w_cabt; w_trms = w_trmt; w_mtns = w_mtnt; w_pks = w_pkt; w_spks = w_spkt; w_cuts = w_cutt; w_fenvs = w_fenvt; w_subs = w_subt;
w_lows = w_lowt; w_peds = w_pedt; w_rots = w_rott; w_bals = w_balt; w_chos = w_chot; w_vibs = w_vibt; vol_s = vol_t;
w_mfs = w_mfc; w_pfs = w_pfc; rot_sp = 0.75;
all_kill();
ui_dflt = 1;

