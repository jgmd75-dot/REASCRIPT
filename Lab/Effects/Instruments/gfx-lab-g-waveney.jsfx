slider30:p_dlv=70<0,100,1>-Drums level (%)
slider31:p_acc=50<0,100,1>-Accent (%)
slider32:p_vol=0<-24,6,0.1>-Volume (dB)
slider33:p_drf=50<0,100,1>-Drift (%)
slider34:prs_sel=0<0,30,1{No preset,Parlour Organ,Chapel Pipes,Reed Quartet,Sunday Brass,Music Box Vibes,Mini Reed Pop,Mini Flute Waltz,Mini Brass March,Mini Vibes Bossa,Mini Synth Disco,Pocket Beeps,Calculator Pop,Tiny Offbeat,Battery Flute,Bedroom Samba,Filter Lead Pop,Sub Swing,Neon Ballad,Hybrid Brass,Deep Sixteen,Spinet Theatre,Rotor Gospel,Pedal Tango,Lounge Beguine,Slow Rock Spinet,Layered Piano,String Choir Bank,Brass Stack,Polka Accordion,Tonebank Ballad}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

options:gfx_hz=60

@init
function psw_all(v) ( slider_show(4503599627370495, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); );
#ui_man = "gfx-lab-g-waveney";
ext_noinit = 1;

NP = 30; PS = 13;
NS = 20; VSZ = 48;
VX = 300000; DR = 302000; HELD = 303000; TE = 303200; PAT = 304000; FIL = 307600;
SN = 308100; SB = 308120; SWT = 308140; SWA = 308160; SF = 308180; WW = 308200;
EQO = 309000; EQT = 309400; EQN = 309800; EQV = 310200;
PT = 311000; DLY = 320000; DLN = 4096; DLM = 4095;
FFTB = 131072; SPR = 140000; SPI = 142000;
TBL = 1048576;
memset(VX, 0, NS * VSZ); memset(DR, 0, 256); memset(HELD, 0, 128); memset(DLY, 0, DLN);

function sp_clr() ( memset(SPR, 0, 1024); memset(SPI, 0, 1024); );
function sp_h(k, a) ( k >= 1 && k < 1024 ? ( SPR[k] = 0; SPI[k] = -a; ); );
function sp_td() local(i) (
  fft(FFTB, 2048); fft_permute(FFTB, 2048);
  i = 1; loop(1023, SPR[i] = FFTB[2 * i]; SPI[i] = FFTB[2 * i + 1]; i += 1; );
);
function tb_make(tid, q) local(m, hh, k, i, pk, rms, g, x, base) (
  m = 0; g = 0;
  loop(8,
    hh = min(1023, floor(19000 / (27.5 * 2 ^ (m + 1))));
    memset(FFTB, 0, 4096);
    k = 1; loop(hh, FFTB[2 * k] = SPR[k]; FFTB[2 * k + 1] = SPI[k]; FFTB[2 * (2048 - k)] = SPR[k]; FFTB[2 * (2048 - k) + 1] = -SPI[k]; k += 1; );
    fft_ipermute(FFTB, 2048); ifft(FFTB, 2048);
    m == 0 ? (
      rms = 0; pk = 0; i = 0;
      loop(2048, x = FFTB[2 * i]; rms += x * x; pk = max(pk, abs(x)); i += 1; );
      rms = sqrt(rms / 2048); g = rms > 0 ? 0.35 / rms : 0; pk * g > 1.1 ? g = 1.1 / pk;
    );
    base = TBL + (tid * 8 + m) * 2048;
    i = 0; loop(2048, x = FFTB[2 * i] * g; q ? x = floor(x * 127 + 0.5) / 127; base[i] = x; i += 1; );
    m += 1;
  );
);
function tone_v(t) local(k) (
  sp_clr();
  t == 0 ? ( sp_h(1, 1); sp_h(2, 0.7); sp_h(3, 0.5); sp_h(4, 0.45); sp_h(6, 0.25); sp_h(8, 0.3); sp_h(10, 0.08); sp_h(12, 0.1); sp_h(16, 0.06); ) :
  t == 1 ? ( k = 1; loop(24, sp_h(k, 1 / k ^ 1.3); k += 1; ); sp_h(2, 0.55); ) :
  t == 2 ? ( sp_h(1, 1); sp_h(2, 0.14); sp_h(3, 0.09); sp_h(4, 0.03); ) :
  t == 3 ? ( sp_h(1, 1); sp_h(3, 0.62); sp_h(5, 0.36); sp_h(7, 0.22); sp_h(9, 0.12); sp_h(11, 0.07); sp_h(2, 0.04); sp_h(4, 0.05); sp_h(13, 0.04); ) :
  t == 4 ? ( k = 1; loop(20, sp_h(k, exp(-sqr((k - 3.2) / 2.6)) + 0.08 / k); k += 1; ); ) :
  t == 5 ? ( k = 1; loop(30, sp_h(k, (1 / k ^ 0.85) * (k < 6 ? 0.7 + 0.06 * k : 1)); k += 1; ); ) :
  t == 6 ? ( k = 1; loop(40, sp_h(k, 1 / k * (1 + 0.6 * exp(-sqr((k - 5) / 3)))); k += 1; ); ) :
  t == 7 ? ( k = 1; loop(16, sp_h(k, 1 / k ^ 1.6); k += 1; ); ) :
  t == 8 ? ( k = 1; loop(48, k % 7 != 0 ? sp_h(k, 1 / k ^ 0.75); k += 1; ); ) :
  t == 9 ? ( sp_h(1, 1); sp_h(4, 0.22); sp_h(10, 0.04); ) :
  t == 10 ? ( k = 1; loop(36, sp_h(k, abs(sin($pi * k * 0.27)) / k ^ 0.8); k += 1; ); ) :
  ( k = 1; loop(30, sp_h(k, ((k & 1) ? 1 : 0.18) / k); k += 1; ); );
);
function tone_c(t) local(k) (
  sp_clr();
  t == 0 ? ( k = 1; loop(40, sp_h(k, 0.6 / k ^ 0.4); k += 1; ); ) :
  t == 1 ? ( sp_h(1, 0.3); k = 3; loop(12, sp_h(k, 0.5 / sqrt(k)); k += 2; ); ) :
  t == 2 ? ( k = 1; loop(8, sp_h(k, 0.5 / sqrt(k)); k += 1; ); ) :
  t == 3 ? ( k = 1; loop(14, sp_h(k, 0.8 / sqrt(k)); k += 2; ); ) :
  t == 4 ? ( k = 1; loop(24, sp_h(k, 1 / sqrt(k)); k += 1; ); ) :
  t == 5 ? ( sp_h(1, 1); sp_h(2, 0.25); sp_h(3, 0.08); ) :
  t == 6 ? ( k = 1; loop(60, sp_h(k, 1 / k ^ 0.7); k += 1; ); ) :
  t == 7 ? ( k = 1; loop(48, sp_h(k, 1 / k ^ 0.55); k += 1; ); ) :
  t == 8 ? ( k = 1; loop(80, sp_h(k, 1 / k ^ 0.45); k += 1; ); ) :
  t == 9 ? ( sp_h(1, 1); sp_h(4, 0.5); sp_h(10, 0.45); sp_h(17, 0.25); ) :
  t == 10 ? ( k = 1; loop(40, sp_h(k, 1 / k ^ 0.6); k += 1; ); ) :
  ( k = 1; loop(40, sp_h(k, 1 / k); k += 1; ); );
);
function sqw(t) ( t -= floor(t); t < 0.5 ? 1 : -1; );
function wwset(t, a, b, c, d) ( WW[t * 4] = a; WW[t * 4 + 1] = b; WW[t * 4 + 2] = c; WW[t * 4 + 3] = d; );
wwset(0, 1, 0.6, 0, 0.3); wwset(1, 1, 0.5, 0.25, 0.125); wwset(2, 0, 0, 0, 0); wwset(3, 1, 0, 0, 0);
wwset(4, 0.5, 1, 0.35, 0); wwset(5, 1, 0.5, 0.25, 0.25); wwset(6, 1, 0.45, 0.3, 0.2); wwset(7, 1, 0.3, 0.15, 0);
wwset(8, 0.3, 0, 0.6, 0.5); wwset(9, 0, 0, 0.25, 0); wwset(10, 0, 0, 0, 0); wwset(11, 1, 0, 1, 0);
function tone_w(t) local(i, p, x) (
  i = 0;
  loop(2048, p = i / 2048;
    x = WW[t * 4] * sqw(p) + WW[t * 4 + 1] * sqw(2 * p) + WW[t * 4 + 2] * sqw(4 * p) + WW[t * 4 + 3] * sqw(8 * p);
    t == 2 || t == 9 ? x += floor((sin(2 * $pi * p) + 1) * 7.5 + 0.5) / 7.5 - 1;
    t == 10 ? x = sqw(p) - 0.8 * sqw(p + 0.27);
    FFTB[2 * i] = x; FFTB[2 * i + 1] = 0; i += 1; );
  sp_td();
);
wv_t = 0;
loop(12,
  tone_c(wv_t); tb_make(wv_t, 0);
  tone_v(wv_t); tb_make(12 + wv_t, 0);
  wv_k = 7; loop(24, SPI[wv_k] *= 1 + (wv_k - 6) * 0.03; wv_k += 1; ); tb_make(36 + wv_t, 1);
  tone_w(wv_t); tb_make(24 + wv_t, 0);
  wv_t += 1;
);
sp_clr(); sp_h(1, 1); sp_h(2, 0.6); sp_h(3, 0.1); sp_h(4, 0.25); tb_make(48, 0);

function tdef(t, att, dec, sus, ct, nz, nh, dk, g) local(q) ( q = TE + t * 8; q[0] = att; q[1] = dec; q[2] = sus; q[3] = ct; q[4] = nz; q[5] = nh; q[6] = dk; q[7] = g; );
tdef(0, 0.002, 1, 1, 0.012, 0.35, 2500, 0, 1);
tdef(1, 0.03, 1, 1, 0.07, 0.25, 1500, 0, 1);
tdef(2, 0.04, 1, 0.95, 0.08, 0.3, 1200, 0, 1.1);
tdef(3, 0.02, 1.5, 0.85, 0.045, 0.1, 1500, 0, 1);
tdef(4, 0.015, 1.5, 0.85, 0.04, 0.08, 2000, 0, 0.95);
tdef(5, 0.02, 0.8, 0.8, 0.05, 0.06, 1500, 0, 0.9);
tdef(6, 0.09, 2, 0.9, 0.13, 0.08, 3000, 0, 0.95);
tdef(7, 0.002, 2.2, 0, 0.03, 0.25, 800, 1, 1.8);
tdef(8, 0.001, 1.4, 0, 0.018, 0.3, 2500, 1, 1.4);
tdef(9, 0.002, 3, 0, 0.025, 0.12, 3000, 1, 1.6);
tdef(10, 0.012, 1.5, 0.9, 0.035, 0.07, 2000, 0, 0.9);
tdef(11, 0.006, 0.9, 0.75, 0.03, 0, 1000, 0, 0.9);

function smeta(s, n, b, wt, sa, f) ( SN[s] = n; SB[s] = b; SWT[s] = wt; SWA[s] = sa; SF[s] = f; );
function prow(base, r, s) local(i, c) ( i = 0; loop(strlen(s), c = str_getchar(s, i); base[r * 16 + i] = c == '.' ? 0 : c; i += 1; ); );
function pa(st, v, k, s, r, h, c, t, p) local(b) (
  b = PAT + (st * 2 + v) * 112;
  prow(b, 0, k); prow(b, 1, s); prow(b, 2, r); prow(b, 3, h); prow(b, 4, c); prow(b, 5, t); prow(b, 6, p);
);
function fl(f, k, s, r, h, c, t, p) local(b) (
  b = FIL + f * 112;
  prow(b, 0, k); prow(b, 1, s); prow(b, 2, r); prow(b, 3, h); prow(b, 4, c); prow(b, 5, t); prow(b, 6, p);
);
memset(PAT, 0, 32 * 112); memset(FIL, 0, 4 * 112);
smeta(0, 16, 4, 0, 0, 0); smeta(1, 12, 4, 0, 0, 1); smeta(2, 16, 4, 2, 0.62, 0); smeta(3, 16, 4, 0, 0, 0);
smeta(4, 16, 4, 1, 0.12, 0); smeta(5, 16, 4, 0, 0, 0); smeta(6, 16, 4, 0, 0, 3); smeta(7, 16, 4, 0, 0, 3);
smeta(8, 16, 4, 1, 0.15, 0); smeta(9, 12, 3, 0, 0, 2); smeta(10, 16, 4, 2, 0.35, 0); smeta(11, 16, 4, 0, 0, 0);
smeta(12, 16, 4, 0, 0, 0); smeta(13, 16, 4, 0, 0, 3); smeta(14, 16, 4, 1, 0.1, 0); smeta(15, 16, 4, 0, 0, 0);
