        g = tan($pi * fc / srate); d[41] = 1 / (1 + g * (g + 0.9)); d[42] = g * d[41]; d[43] = g * d[42]; d[40] = 1;
      );
      v3 = y - d[29]; v1 = d[41] * d[28] + d[42] * v3; v2 = d[29] + d[42] * d[28] + d[43] * v3;
      d[28] = 2 * v1 - d[28]; d[29] = 2 * v2 - d[29]; y = v2;
    );
    st = d[11]; e = d[10];
    st == 1 ? ( e += d[12]; e >= 1 ? ( e = 1; d[11] = 2; ); ) :
    st == 2 ? ( e = d[14] + (e - d[14]) * d[13]; d[14] <= 0 && e < 0.00002 ? d[11] = 4; ) :
    e *= d[15];
    d[10] = e;
    fi = d[22];
    fi < 1 ? ( d[22] = min(fi + w_fis, 1); fi = 0.5 - 0.5 * cos($pi * fi); );
    km = 1;
    d[44] ? ( d[31] -= w_ks; km = max(d[31], 0); );
    o = y * e * d[23] * fi * km;
    k == 1 ? o *= w_lows : k == 2 ? o *= w_peds;
    oL += o * d[24]; oR += o * d[25];
    (d[44] && d[31] <= 0) || ((st >= 3 || d[11] == 4) && e < 0.00002) ? v_free(d);
  );
