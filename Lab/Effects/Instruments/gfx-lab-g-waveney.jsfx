w_cabs > 0.001 ? (
  cb_1a += cb_f1 * (oL - cb_1a - 0.5 * cb_1b); cb_1b += cb_f1 * cb_1a;
  cb_2a += cb_f2 * (oL - cb_2a - 0.4 * cb_2b); cb_2b += cb_f2 * cb_2a;
  cb_la += (oL - cb_la) * cb_lp;
  cr_1a += cb_f1 * (oR - cr_1a - 0.5 * cr_1b); cr_1b += cb_f1 * cr_1a;
