@gfx 900 400
ui_begin(900, 400);
v5_begin();
WF = 0xE9DDBF; WB = 0x1C1410; WI = 0x2E261F; WH = 0x170F0B; WV = 0xFFD27A; WA = 0xFFB030;
WS1 = 0xF08A3C; WS2 = 0xE8C547; WS3 = 0x3FA7A0;
sc != wg_fsc ? (
  wg_fsc = sc;
  wg_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  wg_f6 = ui_fitfont(6, 24 * sc);
);
function wg_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * wg_kt * sc, 'b'); );
function wg_fc(px) ( gfx_setfont(12, "Courier New", px * sc, 'b'); );
function wg_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function wg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function wg_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function wg_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function wg_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function wg_cham(x, y, w, h, dd, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - dd, y + dd, x + dd, y + dd);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + dd, y + dd, x + dd, y + h - dd, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - dd, y + h - dd, x + w - dd, y + dd);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + dd, y + h - dd, x + w - dd, y + h - dd, x + w, y + h);
);
WIN = 0xF5F2E8;
function wg_pocket(x, y, w, h) ( wg_cham(x, y, w, h, 3, WF); ui_col(WIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function wg_hover(cx, cy, fs) ( wg_hon = 1; wg_hx = cx; wg_hy = cy; wg_hfs = fs; );
function wg_title(x, y, s, c) ( wg_ft(16); ui_col(WI); wg_tl(x, y, s); ui_col(c); v5_r(x, y + 12, wg_tw(s), 3); );
function wg_tname(t) ( t == 0 ? "ORGAN" : t == 1 ? "PIPE ORGAN" : t == 2 ? "FLUTE" : t == 3 ? "CLARINET" : t == 4 ? "OBOE" : t == 5 ? "TRUMPET" :
  t == 6 ? "STRINGS" : t == 7 ? "PIANO" : t == 8 ? "HARPSICHORD" : t == 9 ? "VIBES" : t == 10 ? "ACCORDION" : "SYNTH" );
function wg_nname(n) local(p) (
  p = n % 12;
  sprintf(#wg_hv, "%s%d", p == 0 ? "C" : p == 1 ? "C#" : p == 2 ? "D" : p == 3 ? "D#" : p == 4 ? "E" : p == 5 ? "F" : p == 6 ? "F#" : p == 7 ? "G" : p == 8 ? "G#" : p == 9 ? "A" : p == 10 ? "A#" : "B", floor(n / 12) - 1);
);
function wg_fmt(idx) local(v, m) (
  v = slider(idx); m = floor(v + 0.5);
  idx == 3 ? ( v < 1000 ? sprintf(#wg_hv, "%d ms", m) : sprintf(#wg_hv, "%.2f s", v / 1000); ) :
  idx == 5 ? ( v < 1 ? sprintf(#wg_hv, "%.2f Hz", v) : sprintf(#wg_hv, "%.1f Hz", v); ) :
  idx == 6 ? wg_nname(m) :
  idx == 15 ? strcpy(#wg_hv, m == 0 ? "-1 OCT" : m == 2 ? "+1 OCT" : "0 OCT") :
  idx == 24 ? strcpy(#wg_hv, wg_tname(m)) :
  idx == 23 ? sprintf(#wg_hv, "%.1f c", v / 4) :
  idx == 22 ? ( m <= 0 ? strcpy(#wg_hv, "A") : m >= 100 ? strcpy(#wg_hv, "B") : sprintf(#wg_hv, "A %d / B %d", 100 - m, m); ) :
  idx == 29 ? sprintf(#wg_hv, "%d BPM", m) :
  idx == 32 ? sprintf(#wg_hv, "%+.1f dB", v) :
  sprintf(#wg_hv, "%d %%", m);
);
function wg_dial(cx, cy, r, idx, lo, hi, def, lg, lbl, fs) local(n, a, i, t, rs) (
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 8), 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(0x5A4E42); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  v5_shc(cx, cy, r);
  ui_col(0x16110E); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x35302B); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(ui_mix(wg_cc, 0, 0.35)); v5_d(cx, cy, r * 0.74);
  ui_col(wg_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, 0x2A2018);
  v5_act ? ( wg_fmt(idx); wg_hover(cx, cy + r + 19, fs); ) : ( wg_ft(fs); ui_col(wg_dim ? ui_mix(WI, WIN, 0.6) : WI); v5_t(cx, cy + r + 19, lbl); );
  wg_dim ? ( ui_cola(WIN, 0.5); v5_d(cx, cy, r + 1); );
  wg_dim = 0;
);
function wg_menu(x, y, w, h, idx, n, labels, mnu) local(cur, i, k) (
  cur = max(0, min(n - 1, slider(idx) | 0));
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(0x141210); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.4); v5_r(x + 1, y + 1, w - 2, 2);
  wg_fc(15); ui_col(0xFFB347); v5_t(x + (w - 12) / 2, y + h / 2 + 1, v5_part(labels, cur));
  gfx_triangle((x + w - 13) * sc, (y + h / 2 - 2.5) * sc, (x + w - 5) * sc, (y + h / 2 - 2.5) * sc, (x + w - 9) * sc, (y + h / 2 + 2.5) * sc);
  v5_pr && v5_drag == 0 && v5_hit(x, y, w, h) ? (
    v5_drag = -1; strcpy(#wg_mm, ""); i = 0;
    loop(n, i == cur ? strcat(#wg_mm, "!"); strcat(#wg_mm, v5_part(mnu, i)); i < n - 1 ? strcat(#wg_mm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h + 2) * sc; k = gfx_showmenu(#wg_mm);
    k > 0 ? ( slider(idx) = k - 1; ui_auto(idx); );
  );
  v5_hit(x, y, w, h) && mouse_wheel != 0 && v5_drag == 0 ? (
    slider(idx) = max(0, min(n - 1, cur - sign(mouse_wheel))); ui_auto(idx); mouse_wheel = 0;
  );
);
function wg_led(x, y, c, gg) local(i) (
  ui_col(0x050606); v5_d(x, y, 5.5);
  ui_col(ui_mix(c, 0x101214, 0.78)); v5_d(x, y, 4);
  gg > 0.01 ? (
    i = 0; loop(5, ui_cola(c, 0.07 * gg); v5_d(x, y, 4 + 2.2 * (5 - i)); i += 1; );
    ui_cola(c, gg); v5_d(x, y, 4);
    ui_cola(ui_mix(c, 0xFFFFFF, 0.6), 0.85 * gg); v5_d(x - 1, y - 1.2, 1.6);
  );
);
function wg_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
