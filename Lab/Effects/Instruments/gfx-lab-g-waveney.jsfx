);
dc_yl = oL - dc_xl + w_dcr * dc_yl; dc_xl = oL;
dc_yr = oR - dc_xr + w_dcr * dc_yr; dc_xr = oR;
pwr_in(dc_yl * w_drl, dc_yr * w_drl);
oL = ostL.ost_band(pwr_l);
oR = ostR.ost_band(pwr_r);
