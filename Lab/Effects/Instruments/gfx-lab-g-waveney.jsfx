desc:Waveney [home keyboard] (GFX Lab)
//tags: instrument keyboard home organ portable rhythm drum machine vintage digital
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-power, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider35:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:p_era=0<0,5,1{Parlour 1980,Mini 1981,Pocket 1981,Hybrid 1983,Spinet 1983,Tonebank 1987}>-Era
slider2:p_tone=0<0,11,1{Organ,Pipe organ,Flute,Clarinet,Oboe,Trumpet,Strings,Piano,Harpsichord,Vibes,Accordion,Synth}>-Tone
slider3:p_rel=150<5,3000,1>-Release (ms)
slider4:p_vib=15<0,100,1>-Vibrato (%)
slider5:p_vrt=5.5<0.01,12,0.01>-Vibrato rate (Hz)
slider6:p_spl=54<36,72,1>-Spinet split (note)
slider7:p_e00=60<0,100,1>-Parlour consonant (%)
slider8:p_e01=55<0,100,1>-Parlour cabinet (%)
slider9:p_e02=0<0,100,1>-Parlour tremolo (%)
slider10:p_e10=60<0,100,1>-Mini consonant (%)
slider11:p_e11=60<0,100,1>-Mini tone (%)
slider12:p_e12=0<0,100,1>-Mini sustain (%)
slider13:p_e20=60<0,100,1>-Pocket bright (%)
slider14:p_e21=70<0,100,1>-Pocket speaker (%)
slider15:p_e22=1<0,2,1{-1 octave,0,+1 octave}>-Pocket octave
slider16:p_e30=55<0,100,1>-Hybrid cutoff (%)
slider17:p_e31=50<0,100,1>-Hybrid envelope (%)
slider18:p_e32=35<0,100,1>-Hybrid sub (%)
slider19:p_e40=60<0,100,1>-Spinet lower (%)
slider20:p_e41=60<0,100,1>-Spinet pedal (%)
slider21:p_e42=40<0,100,1>-Spinet rotor (%)
slider22:p_e50=50<0,100,1>-Tonebank balance (%)
slider23:p_e51=25<0,100,1>-Tonebank detune (%)
