desc:KX 24 [synth] (GFX Lab)
//tags: instrument synthesizer polysynth analogue dco chorus 80s
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-warmup, gfx-lab-output, gfx-lab-uimin, gfx-lab-bverb, gfx-lab-bdelay

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-uimin.jsfx-inc
import gfx-lab-bverb.jsfx-inc
import gfx-lab-bdelay.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider1:o1wave=0<0,3,1{Saw,Square,Pulse,Saw and pulse}>-DCO 1 wave
slider2:o1oct=1<0,2,1{16',8',4'}>-DCO 1 octave
slider3:o2wave=2<0,3,1{Saw,Square,Pulse,Saw and pulse}>-DCO 2 wave
slider4:o2oct=1<0,2,1{16',8',4'}>-DCO 2 octave
slider5:o2int=0<-12,12,1>-DCO 2 interval (semitones)
slider6:o2det=7<0,50,0.1>-DCO 2 detune (cents)
slider7:pwid=0.3<0.05,0.5,0.001>-Pulse width
slider8:pwm=0<0,1,0.001>-PWM (from the LFO)
slider9:mix1=0.8<0,1,0.001>-DCO 1 level
slider10:mix2=0.6<0,1,0.001>-DCO 2 level
slider11:noise=0<0,1,0.001>-Noise level
slider12:cutoff=2200<20,20000,1:log>-Cutoff (Hz)
slider13:fres=0.2<0,1,0.001>-Resonance
slider14:fenvamt=0.4<-1,1,0.001>-Filter env amount
slider15:fkey=0.5<0,1,0.01>-Key tracking
slider16:fe_a=2<0.5,5000,0.1:log>-Filter attack (ms)
slider17:fe_d=600<1,10000,1:log>-Filter decay (ms)
slider18:fe_s=30<0,100,0.1>-Filter sustain (%)
slider19:fe_r=400<1,10000,1:log>-Filter release (ms)
slider20:ae_a=3<0.5,5000,0.1:log>-Amp attack (ms)
slider21:ae_d=800<1,10000,1:log>-Amp decay (ms)
slider22:ae_s=80<0,100,0.1>-Amp sustain (%)
slider23:ae_r=450<1,10000,1:log>-Amp release (ms)
slider24:vsens=0.5<0,1,0.01>-Velocity
slider25:lfo_shape=0<0,3,1{Triangle,Saw,Square,Random}>-LFO shape
slider26:lfo_hz=5<0.05,20,0.001:log>-LFO rate (Hz)
slider27:lfo_dly=0<0,3000,1>-LFO delay (ms)
slider28:lfo_vib=0<0,100,0.1>-LFO to pitch (cents)
slider29:lfo_cut=0<0,3,0.01>-LFO to cutoff (oct)
slider30:key_mode=0<0,3,1{Poly,Unison,Split,Double}>-Key assign
slider31:split_pt=60<36,84,1>-Split point (note)
slider32:b_shift=-12<-24,24,1>-Part B shift (semitones)
slider33:b_det=0<0,50,0.1>-Part B detune (cents)
slider34:b_tone=0<-3,3,0.01>-Part B tone (oct)
slider35:b_lvl=0.8<0,1,0.001>-Part B level
slider36:uni_det=15<0,50,0.1>-Unison spread (cents)
slider37:glide=0<0,2000,1>-Glide (ms)
slider38:ch_on=1<0,1,1{Off,On}>-Chorus
slider39:ch_rate=0.6<0.1,5,0.001:log>-Chorus rate (Hz)
slider40:ch_depth=0.5<0,1,0.001>-Chorus depth
slider41:bloom=0.5<0,1,0.001>-Bloom
slider42:dl_sync=1<0,1,1{Free,Sync}>-Delay sync
slider43:dl_ms=350<10,2000,1:log>-Delay time (ms)
slider44:dl_div=8<0,13,1{1/1,1/2,1/2D,1/2T,1/4,1/4D,1/4T,1/8,1/8D,1/8T,1/16,1/16D,1/16T,1/32}>-Delay time (sync)
slider45:dl_fb=0.35<0,0.95,0.001>-Delay feedback
slider46:dl_mix=0<0,1,0.001>-Delay mix
slider47:dl_pp=1<0,1,1{Stereo,Ping-pong}>-Delay mode
slider48:dl_hpf=110<20,2000,1:log>-Delay HPF (Hz)
slider49:dl_lpf=5500<1000,20000,1:log>-Delay LPF (Hz)
slider50:sp_size=0.5<0,1,0.001>-Space size
slider51:sp_decay=1.8<0.2,12,0.01:log>-Space decay (s)
slider52:sp_damp=0.5<0,1,0.001>-Space damping
slider53:sp_mix=0.12<0,1,0.001>-Space mix
slider54:eq_lo=0<-12,12,0.1>-EQ low (dB)
slider55:eq_hi=0<-12,12,0.1>-EQ high (dB)
slider56:vol=0<-24,6,0.1>-Volume (dB)
slider57:drift=50<0,100,1>-Drift (%)
slider58:comp=0<0,10,0.1>-Comp
slider59:ffat=0<0,10,0.1>-Ffat
slider60:prs_sel=0<0,18,1{No preset,Init,Bloom Pad,Brass 83,Poly Strings,Unison Lead,Split Bass and Pad,Double Octaves,Glass Keys,Slow Sweep,Dub Chords,Choir Pad,Bass Pluck,Neon Pluck,Unison Bass,Wide Keys,Noise Wind,Funk Stab,Hall Brass}>-Preset

@init
#ui_man = "gfx-lab-g-kx-24";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

NV = 8;  VS = 64;  VOX = 0;
UST = 600;
VDL = 700;  VDP = 710;
VTC = 720;  VTG = 730;
VRF = 740;  VCA = 750;  VSA = 760;
PLC = 770;
MQ = 4096;
MQMAX = 1000;
FX_MEM = 1048576;

F_ON = 0;   F_NOTE = 1;  F_VEL = 2;   F_AGE = 3;   F_GATE = 4;  F_SUS = 5;
F_AEN = 6;  F_AST = 7;   F_FEN = 8;   F_FST = 9;
F_INC = 10; F_FADE = 11; F_PEND = 12; F_PVEL = 13; F_STEAL = 14;
F_AV = 15;  F_AS = 16;   F_GAIN = 17; F_FVEL = 18;
F_G = 19;   F_GS = 20;
F_LL = 21;
F_P1 = 25;  F_P2 = 26;  F_I2 = 27;  F_NEW = 28;
F_DV = 29;  F_DT = 30;  F_DTM = 31;
F_KEY = 32; F_PKEY = 33; F_PART = 34; F_PPART = 35;
F_UO = 36;  F_PUO = 37;  F_PN = 38;
F_PLC = 39; F_LDL = 40;
F_CC = 41;  F_CS = 42;
F_PL = 43;  F_PR = 44;  F_WL = 45;  F_WR = 46;
F_DPL = 47; F_DPR = 48; F_DWL = 49; F_DWR = 50;
F_CB = 51;  F_DCB = 52;  F_FIN = 53;  F_NW = 54;

memset(VOX, 0, NV * VS);  memset(UST, 0, 16);  memset(VDL, 0, 20);

k = 0;
loop(NV,
  VTC[k] = rand(2) - 1;  VTG[k] = rand(2) - 1;
  VRF[k] = k == 0 ? 1 : k == 1 ? 0.83 : k == 2 ? 1.17 : k == 3 ? 0.91 : k == 4 ? 1.09 : k == 5 ? 0.87 : k == 6 ? 1.21 : 0.95;
  b = VOX + k * VS;  b[F_CC] = cos(2 * $pi * k / NV);  b[F_CS] = sin(2 * $pi * k / NV);
  b[F_CB] = 1;
  k += 1;
);
PLC[0] = -0.9;  PLC[1] = 0.9;  PLC[2] = -0.45;  PLC[3] = 0.45;  PLC[4] = -0.7;  PLC[5] = 0.7;  PLC[6] = -0.2;  PLC[7] = 0.2;
plc_n = 0;

bv_alloc(FX_MEM);
bd_alloc(BV_END);
CH_N = 1024;  while (CH_N < ceil(0.03 * srate) + 4) ( CH_N *= 2; );
CH_M = BD_END;  memset(CH_M, 0, CH_N);
BLM = CH_M + CH_N;  memset(BLM, 0, NV * CH_N);
cho_w = 0;  cho_c = 1;  cho_s = 0;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
RVM = 1960;  k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );

drf_clk.drift_init(0.9);  drf_cho.drift_init(1.1);

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );

function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);
function env_coef(ms) ( exp(-6.9 * CR / max(1, ms * 0.001 * srate)); );

function osc(w, p, d) local(q) (
  w < 0.5 ? saw_bl(p, d) :
  w < 1.5 ? ( q = p + 0.5;  q >= 1 ? q -= 1;  saw_bl(p, d) - saw_bl(q, d); ) :
  w < 2.5 ? ( q = p + pw_s;  q >= 1 ? q -= 1;  saw_bl(p, d) - saw_bl(q, d); ) :
            ( q = p + pw_s;  q >= 1 ? q -= 1;  (2 * saw_bl(p, d) - saw_bl(q, d)) * 0.6; );
);

function lad(s, x) local(u, v, y1, y2, y3, y4) (
  y4 = (lG4 * x + lB * (lG3 * s[0] + lG2 * s[1] + lG * s[2] + s[3])) * linv;
  u = ts(x - kres * y4);
  v = (u - s[0]) * lG;   y1 = v + s[0];  s[0] = y1 + v;
  v = (y1 - s[1]) * lG;  y2 = v + s[1];  s[1] = y2 + v;
  v = (y2 - s[2]) * lG;  y3 = v + s[2];  s[2] = y3 + v;
  v = (y3 - s[3]) * lG;  y4 = v + s[3];  s[3] = y4 + v;
  y4;
);

function oct_mul(o) ( o < 0.5 ? 0.5 : o < 1.5 ? 1 : 2; );
function v_freq(b) local(n, f) (
  n = b[F_PN] + b[F_UO] + (b[F_PART] ? b_sh : 0) + bend + b[F_DV] * 0.015 * dm_a + clk_v * 0.025 * dm_a
      + lfo_v * vib_s * b[F_LDL] * 0.01;
  f = 440 * 2 ^ ((n - 69) / 12);
  b[F_INC] = min(f * oc1_m / srate, 0.45);
  b[F_I2] = min(f * oc2_m * o2_rat / srate, 0.45);
);
function v_start(b, note, vel, key, part, uo) (
  b[F_ON] = 1;  b[F_NOTE] = note;  b[F_VEL] = vel;  b[F_GATE] = 1;  b[F_SUS] = 0;
  b[F_KEY] = key;  b[F_PART] = part;  b[F_UO] = uo;
  b[F_PN] = gl_c < 1 && gl_from >= 0 ? gl_from : note;
  age_n += 1;  b[F_AGE] = age_n;
  b[F_AST] = 1;  b[F_FST] = 1;
  b[F_GAIN] = (1 - vsens + vsens * vel / 127) * (km_a == 1 ? 0.42 : part ? b_lvl : 1);
  b[F_FVEL] = 1 - 0.5 * vsens + 0.5 * vsens * vel / 127;
  b[F_AV] < 0.05 ? ( b[F_FIN] = 0;  nw_start(b + F_NW); );
  b[F_FADE] = 1;  b[F_STEAL] = 0;  b[F_AS] = 0;  b[F_GS] = 0;
  b[F_LDL] = ld_inc >= 1 ? 1 : 0;
  b[F_AV] < 0.0005 ? ( b[F_PLC] = PLC[plc_n];  plc_n = (plc_n + 1) & 7; );
  !b[F_AV] ? (
    memset(b + F_LL, 0, 4);
    b[F_AEN] = 0;  b[F_FEN] = 0;  b[F_P1] = rand(1);  b[F_P2] = rand(1);  b[F_NEW] = 1;
    b[F_DV] = rand(2) - 1;  b[F_DT] = rand(2) - 1;  b[F_DTM] = rand(2);
  );
  v_freq(b);
);
function v_alloc(note, vel, key, part) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? b[F_AEN] : 2 + b[F_AGE];
    b[F_ON] && b[F_NOTE] == note && b[F_PART] == part && !b[F_STEAL] ? q = -2;
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  b = VOX + best * VS;
  (b[F_ON] && b[F_AV] > 0.0005 && b[F_NOTE] != note) ? (
    b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel;  b[F_PKEY] = key;  b[F_PPART] = part;  b[F_PUO] = 0;
  ) : v_start(b, note, vel, key, part, 0);
);
function uni_on(note, vel) local(v, b, uo) (
  v = 0;
  loop(NV,
    b = VOX + v * VS;  uo = (v / (NV - 1) * 2 - 1) * uni_c;
    (b[F_ON] && b[F_AV] > 0.0005) ? (
      b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel;  b[F_PKEY] = note;  b[F_PPART] = 0;  b[F_PUO] = uo;
    ) : v_start(b, note, vel, note, 0, uo);
    v += 1;
  );
);
function uni_move(note) local(v, b) (
  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_STEAL] ? ( b[F_PEND] = note;  b[F_PKEY] = note; ) : ( b[F_NOTE] = note;  b[F_KEY] = note; );
    v += 1;
  );
);
function us_add(n) local(i, f) (
  f = -1;  i = 0;  loop(us_n, UST[i] == n ? f = i;  i += 1; );
  f >= 0 ? ( i = f;  loop(us_n - f - 1, UST[i] = UST[i + 1];  i += 1; );  us_n -= 1; );
  us_n < 16 ? ( UST[us_n] = n;  us_n += 1; );
);
function us_del(n) local(i, f) (
  f = -1;  i = 0;  loop(us_n, UST[i] == n ? f = i;  i += 1; );
  f >= 0 ? ( i = f;  loop(us_n - f - 1, UST[i] = UST[i + 1];  i += 1; );  us_n -= 1; );
);
function v_release_key(key) local(v, b) (
  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_KEY] == key ? (
      sustain ? b[F_SUS] = 1;
      b[F_GATE] = 0;  b[F_AST] = 4;  b[F_FST] = 4;
    );
    b[F_STEAL] && b[F_PKEY] == key ? b[F_PEND] = -1;
    v += 1;
  );
);
function v_pedal_up() local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;  b[F_SUS] = 0;  v += 1; );
);
function v_all_off() local(v, b) (
  v = 0;
  loop(NV,
    b = VOX + v * VS;
    b[F_ON] ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_AST] = 4;  b[F_FST] = 4; );
    b[F_STEAL] ? b[F_PEND] = -1;
    v += 1;
  );
  us_n = 0;
);

function note_on(n, vel) local(f) (
  f = last_note;  last_note = n;  gl_from = f;
  km_a == 1 ? (
    us_add(n);
    us_n == 1 ? uni_on(n, vel) : uni_move(n);
  ) : km_a == 2 ? v_alloc(n, vel, n, n < split_pt ? 1 : 0) :
      km_a == 3 ? ( v_alloc(n, vel, n, 0);  v_alloc(n, vel, n, 1); ) :
                  v_alloc(n, vel, n, 0);
);
function note_off(n) local(top) (
  km_a == 1 ? (
    top = us_n > 0 ? UST[us_n - 1] : -1;
    us_del(n);
    us_n > 0 ? ( top == n ? ( gl_from = n;  last_note = UST[us_n - 1];  uni_move(UST[us_n - 1]); ); )
             : v_release_key(n);
  ) : v_release_key(n);
);

function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? note_on(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? note_off(d1) :
  st == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 1 ? mw = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);

function env_tick(lv, stg, a_inc, d_c, s_lv, r_c) (
  stg == 1 ? ( lv += a_inc;  lv >= 1 ? ( lv = 1;  stg = 2; ); ) :
  stg == 2 ? ( lv = s_lv + (lv - s_lv) * d_c; ) :
  stg == 4 ? ( lv *= r_c; );
  env_out_stg = stg;
  lv;
);

function v_tick(b, v) local(fc, g, t, a, pos, wp) (
  b[F_SUS] && !b[F_GATE] && b[F_AST] == 4 ? ( b[F_AST] = 2;  b[F_FST] = 2; );
  !b[F_SUS] && !b[F_GATE] && b[F_AST] != 4 ? ( b[F_AST] = 4;  b[F_FST] = 4; );
  b[F_AEN] = env_tick(b[F_AEN], b[F_AST], a_ainc, a_dc, a_sl, a_rc);  b[F_AST] = env_out_stg;
  b[F_FEN] = env_tick(b[F_FEN], b[F_FST], f_ainc, f_dc, f_sl, f_rc);  b[F_FST] = env_out_stg;
  b[F_DTM] -= CR / srate * dm_s;  b[F_DTM] <= 0 ? ( b[F_DT] = rand(2) - 1;  b[F_DTM] = 1.5 + rand(1) * 2.5; );
  b[F_DV] += (b[F_DT] - b[F_DV]) * dr_c;
  b[F_PN] += (b[F_NOTE] - b[F_PN]) * gl_c;
  b[F_LDL] = min(1, b[F_LDL] + ld_inc);
  v_freq(b);
  fc = 2 ^ (lcs + fk_s * (b[F_NOTE] - 60) / 12 + b[F_FEN] * fl_ev * 6 * b[F_FVEL] + (b[F_PART] ? bt_s : 0)
            + lfo_v * lc_s * b[F_LDL] + VTC[v] * 0.15 * dm_a);
  t = max(20, min(fc, 0.45 * srate));  g = tan($pi * t / srate);  t = g / (1 + g);
  b[F_NEW] ? ( b[F_G] = t;  b[F_GS] = 0; ) : b[F_GS] = (t - b[F_G]) / CR;
  a = b[F_AEN] * b[F_GAIN] * (1 + VTG[v] * 0.07 * dm_a);
  b[F_AS] = (a - b[F_AV]) / CR;
  pos = b[F_PLC] * sqrt(blm_s);  wp = pos;
  t = b[F_NEW] ? 1 : 0;
  g = sqrt(1 - pos);  b[F_DPL] = t ? 0 : (g - b[F_PL]) / CR;  t ? b[F_PL] = g;
  g = sqrt(1 + pos);  b[F_DPR] = t ? 0 : (g - b[F_PR]) / CR;  t ? b[F_PR] = g;
  g = sqrt(1 - wp) * blm_s * bw_g;  b[F_DWL] = (g - b[F_WL]) * bw_k / CR;
  g = sqrt(1 + wp) * blm_s * bw_g;  b[F_DWR] = (g - b[F_WR]) * bw_k / CR;
  g = 1 - blm_s;  b[F_DCB] = t ? 0 : (g - b[F_CB]) / CR;  t ? b[F_CB] = g;
  b[F_NEW] = 0;
  b[F_AST] == 4 && b[F_AEN] < 0.0001 && b[F_AV] < 0.0001 && !b[F_STEAL] ? (
    b[F_ON] = 0;  b[F_AEN] = 0;  b[F_FEN] = 0;  b[F_AV] = 0;  b[F_AS] = 0;
  );
);

function v_run(b, v) local(d, ph, x, y, w, ln, c, p, i, f, yw) (
  d = b[F_INC];  ph = b[F_P1] + d;  ph >= 1 ? ph -= 1;  b[F_P1] = ph;
  x = osc(w1_l, ph, d) * o1_g;
  d = b[F_I2];  ph = b[F_P2] + d;  ph >= 1 ? ph -= 1;  b[F_P2] = ph;  x += osc(w2_l, ph, d) * o2_g;
  nz_s > 0.0001 ? x += (rand(2) - 1) * nz_s;
  b[F_G] += b[F_GS];  lG = b[F_G];  lB = 1 - lG;  lG2 = lG * lG;  lG3 = lG2 * lG;  lG4 = lG2 * lG2;  linv = 1 / (1 + kres * lG4);
  y = lad(b + F_LL, x * f_in) * f_out;
  b[F_AV] += b[F_AS];
  w = b[F_AV] * b[F_FADE];
  b[F_FIN] < 1 ? ( w *= 0.5 - 0.5 * cos($pi * b[F_FIN]);  b[F_FIN] = min(b[F_FIN] + fin_step, 1); );
  y *= w;
  y = nw_run(b + F_NW, y);
  b[F_PL] += b[F_DPL];  b[F_PR] += b[F_DPR];  b[F_WL] += b[F_DWL];  b[F_WR] += b[F_DWR];  b[F_CB] += b[F_DCB];
  mixL += y * b[F_PL];  mixR += y * b[F_PR];  cbus += y * b[F_CB];
  ln = BLM + v * CH_N;  ln[cho_w] = y;
  bw_live ? (
    c = b[F_CC] * VCA[v] - b[F_CS] * VSA[v];  b[F_CS] = b[F_CS] * VCA[v] + b[F_CC] * VSA[v];  b[F_CC] = c;
    p = cho_w - (cho_base + cho_dep * b[F_CS]);  p < 0 ? p += CH_N;
    i = floor(p);  f = p - i;
    yw = ln[i] + (ln[(i + 1) & (CH_N - 1)] - ln[i]) * f;
    wetL += yw * b[F_WL];
    p = cho_w - (cho_base + cho_dep * b[F_CC]);  p < 0 ? p += CH_N;
    i = floor(p);  f = p - i;
    yw = ln[i] + (ln[(i + 1) & (CH_N - 1)] - ln[i]) * f;
    wetR += yw * b[F_WR];
  );
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? (
      b[F_FADE] = 0;  b[F_STEAL] = 0;
      b[F_PEND] >= 0 ? ( b[F_AV] = 0;  b[F_AEN] = 0;  b[F_FEN] = 0;
                         v_start(b, b[F_PEND], b[F_PVEL], b[F_PKEY], b[F_PPART], b[F_PUO]); )
                     : ( b[F_ON] = 0;  b[F_AV] = 0;  b[F_AEN] = 0; );
    );
  );
);

lfo_ph = 0;  lfo_v = 0;  lfo_raw = 0;  lfo_sh = 0;  mw = 0;  clk_v = 0;  cho_dv = 0;
bend = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  us_n = 0;  last_note = -1;  gl_from = -1;
pw_s = pwid;  km_a = floor(key_mode + 0.5);
lcs = fl_c1 = log(cutoff) / log(2);  kres = fres * 4.1;  fl_ev = fenvamt;

function fx_block() local(k, sz, ms, t) (
  t = dl_sync >= 0.5 ? 60 / max(tempo, 20) * bd_beats(floor(dl_div + 0.5)) : dl_ms * 0.001;
  dl_t = min(t * srate, 3 * srate);
  dl_dc = 1 - exp(-2 * $pi * min(dl_lpf, 0.45 * srate) / srate);
  dl_hc = 1 - exp(-2 * $pi * dl_hpf / srate);
  sl_c = 1 - exp(-1 / (0.15 * srate));
  sz_s += (sp_size - sz_s) * min(1, samplesblock / (0.25 * srate));
  sz = 0.3 + 0.7 * sz_s;
  k = 0;
  loop(8,
    ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
    ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
    k += 1;
  );
  bv_t60 = sp_decay;  bv_rtlo = 1.25;  bv_rthi = 1 - 0.82 * sp_damp;
  k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
  bv_xover();
  sp_pre = (0.008 + 0.03 * sz_s) * srate;
  k = 0;
  loop(8,
    RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
    ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
    k += 1;
  );
  dl_mix > 0.0005 && !dl_live ? ( memset(BD_L, 0, 2 * DL_N);  dlL.init = 0;  dlR.init = 0;  dl_fl = dl_fr = dl_hl = dl_hr = 0; );
  sp_mix > 0.0005 && !sp_live ? bv_alloc(FX_MEM);
  dl_live = dl_mix > 0.0005 || dlm_s > 0.0005;  sp_live = sp_mix > 0.0005 || spm_s > 0.0005;
);
sz_s = sp_size;

function update_params() local(t) (
  a_ainc = CR / max(1, ae_a * 0.001 * srate);  a_dc = env_coef(ae_d);  a_sl = ae_s / 100;  a_rc = env_coef(ae_r);
  f_ainc = CR / max(1, fe_a * 0.001 * srate);  f_dc = env_coef(fe_d);  f_sl = fe_s / 100;  f_rc = env_coef(fe_r);
  fade_step = 1 / (0.003 * srate);  fin_step = 1 / (0.002 * srate);
  bw_k = 1 - exp(-CR / (0.012 * srate));
  drift_macro(drift);
  dr_c = 1 - exp(-CR * dm_s / (1.2 * srate));
  dc_r = 1 - 2 * $pi * 5 / srate;
  outg_t = 10 ^ (vol / 20) * 0.1;
  o2_rat = 2 ^ ((o2int + o2det * 0.01) / 12);
  o1g_t = mix1;  o2g_t = mix2;  nz_t = noise * 0.8;
  w1_t = floor(o1wave + 0.5);  w2_t = floor(o2wave + 0.5);  oc1_t = oct_mul(o1oct);  oc2_t = oct_mul(o2oct);
  smk = 1 - exp(-1 / (0.015 * srate));  lfo_sm = 1 - exp(-CR / (0.004 * srate));  dk_st = 1 / (0.005 * srate);
  km_t = floor(key_mode + 0.5);
  b_sh = b_shift + b_det * 0.01;  uni_c = uni_det * 0.01;
  gl_c = glide < 1 ? 1 : 1 - exp(-CR / (glide * 0.001 * srate));
  ld_inc = lfo_dly < 5 ? 1 : CR / (lfo_dly * 0.001 * srate);
  cho_base = 0.0065 * srate;  chd_t = (0.0004 + 0.0032 * ch_depth) * srate;
  chm_t = ch_on >= 0.5;  blm_t = bloom;
  dlm_t = dl_mix;  spm_t = sp_mix;
  eq_lc = 1 - exp(-2 * $pi * 220 / srate);  eq_hc = 1 - exp(-2 * $pi * 4400 / srate);
  eql_t = 10 ^ (eq_lo / 20) - 1;  eqh_t = 10 ^ (eq_hi / 20) - 1;
  t = comp / 10;  cp_thr_v = -10 - 26 * t;  cp_cc_v = 0.75 * t;  cpg_t = 10 ^ (cp_cc_v * max(0, -22 - cp_thr_v) * 0.8 / 20);
  cp_t = comp > 0;  ffat_t = ffat;
);

function cp_curve(lv) local(o, f) (
  o = lv - cp_thr_v;
  f = o <= -5 ? 0 : o >= 5 ? o : sqr(o + 5) / 20;
  max(-cp_cc_v * f, -60);
);
function cp_smooth(t, e) local(d) (
  t < e ? ( d = e - t;  e + (t - e) * min(1, max(d, 5) / (0.15 * srate)); ) : min(t, e + cp_rel);
);
cp_rms = 1 - exp(-1 / (0.008 * srate));  cp_rel = 120 / srate;
ffc_att = 1 - exp(-1 / (0.003 * srate));  ffc_rel = 1 - exp(-1 / (0.09 * srate));

update_params();
o1_g = o1g_t;  o2_g = o2g_t;  nz_s = nz_t;  out_g = outg_t;  chm_s = chm_t;  blm_s = blm_t;  dlm_s = dlm_t;  spm_s = spm_t;
cho_dep = chd_t;  eql_s = eql_t;  eqh_s = eqh_t;  fk_s = fkey;  lc_s = lfo_cut;  vib_s = lfo_vib;  bt_s = b_tone;
cp_s = cp_t;  cpg_s = cpg_t;  ffat_s = ffat_t;  grs = 0;  cp_e = 0;
w1_l = w1_t;  w2_l = w2_t;  oc1_m = oc1_t;  oc2_m = oc2_t;  dk = 1;  dk_req = 0;  bw_g = 0.6 * chm_s;

function sl_auto(idx) (
  idx == 33 ? slider_automate(b_det) : idx == 34 ? slider_automate(b_tone) : idx == 35 ? slider_automate(b_lvl) :
  idx == 36 ? slider_automate(uni_det) : idx == 37 ? slider_automate(glide) : idx == 38 ? slider_automate(ch_on) :
  idx == 39 ? slider_automate(ch_rate) : idx == 40 ? slider_automate(ch_depth) : idx == 41 ? slider_automate(bloom) :
  idx == 42 ? slider_automate(dl_sync) : idx == 43 ? slider_automate(dl_ms) : idx == 44 ? slider_automate(dl_div) :
  idx == 45 ? slider_automate(dl_fb) : idx == 46 ? slider_automate(dl_mix) : idx == 47 ? slider_automate(dl_pp) :
  idx == 48 ? slider_automate(dl_hpf) : idx == 49 ? slider_automate(dl_lpf) : idx == 50 ? slider_automate(sp_size) :
  idx == 51 ? slider_automate(sp_decay) : idx == 52 ? slider_automate(sp_damp) : idx == 53 ? slider_automate(sp_mix) :
  idx == 54 ? slider_automate(eq_lo) : idx == 55 ? slider_automate(eq_hi) : idx == 56 ? slider_automate(vol) :
  idx == 57 ? slider_automate(drift) : idx == 58 ? slider_automate(comp) : idx == 59 ? slider_automate(ffat);
);
function sl_auto_au(idx) (
  idx == 33 ? slider_automate(b_det) : idx == 34 ? slider_automate(b_tone) : idx == 35 ? slider_automate(b_lvl) :
  idx == 36 ? slider_automate(uni_det) : idx == 37 ? slider_automate(glide) : idx == 38 ? slider_automate(ch_on) :
  idx == 39 ? slider_automate(ch_rate) : idx == 40 ? slider_automate(ch_depth) : idx == 41 ? slider_automate(bloom) :
  idx == 42 ? slider_automate(dl_sync) : idx == 43 ? slider_automate(dl_ms) : idx == 44 ? slider_automate(dl_div) :
  idx == 45 ? slider_automate(dl_fb) : idx == 46 ? slider_automate(dl_mix) : idx == 47 ? slider_automate(dl_pp) :
  idx == 48 ? slider_automate(dl_hpf) : idx == 49 ? slider_automate(dl_lpf) : idx == 50 ? slider_automate(sp_size) :
  idx == 51 ? slider_automate(sp_decay) : idx == 52 ? slider_automate(sp_damp) : idx == 53 ? slider_automate(sp_mix) :
  idx == 54 ? slider_automate(eq_lo) : idx == 55 ? slider_automate(eq_hi) : idx == 56 ? slider_automate(vol) :
  idx == 57 ? slider_automate(drift) : idx == 58 ? slider_automate(comp) : idx == 59 ? slider_automate(ffat);
);
function param_touched(idx) (
  idx <= 32 ? slider_automate(2 ^ (idx - 1)) : sl_auto(idx);
  gui_dirty = 1;
);
function param_touched_au(idx) (
  idx <= 32 ? slider_automate(2 ^ (idx - 1)) : sl_auto_au(idx);
  prm_dirty = 1;
);
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 0); pv(2, 1); pv(3, 2); pv(4, 1); pv(5, 0); pv(6, 7); pv(7, 0.3); pv(8, 0); pv(9, 0.8); pv(10, 0.6); pv(11, 0);
  pv(12, 2200); pv(13, 0.2); pv(14, 0.4); pv(15, 0.5); pv(16, 2); pv(17, 600); pv(18, 30); pv(19, 400);
  pv(20, 3); pv(21, 800); pv(22, 80); pv(23, 450); pv(24, 0.5);
  pv(25, 0); pv(26, 5); pv(27, 0); pv(28, 0); pv(29, 0);
  pv(30, 0); pv(31, 60); pv(32, -12); pv(33, 0); pv(34, 0); pv(35, 0.8); pv(36, 15); pv(37, 0);
  pv(38, 1); pv(39, 0.6); pv(40, 0.5); pv(41, 0.5);
  pv(42, 1); pv(43, 350); pv(44, 8); pv(45, 0.35); pv(46, 0); pv(47, 1); pv(48, 110); pv(49, 5500);
  pv(50, 0.5); pv(51, 1.8); pv(52, 0.5); pv(53, 0.12); pv(54, 0); pv(55, 0); pv(56, 0); pv(57, 50); pv(58, 0); pv(59, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (
    pv(3, 0); pv(6, 9); pv(12, 1650); pv(13, 0.15); pv(14, 0.25); pv(16, 700); pv(17, 2000); pv(18, 60); pv(19, 1800); pv(20, 550); pv(21, 2000); pv(22, 90); pv(23, 1800); pv(39, 0.45); pv(40, 0.6); pv(41, 1); pv(50, 0.7); pv(51, 3.3); pv(53, 0.25); pv(56, -0.1);
  ) :
  p == 3 ? (
    pv(3, 0); pv(6, 6); pv(12, 660); pv(13, 0.15); pv(14, 0.6); pv(16, 45); pv(17, 550); pv(18, 45); pv(19, 300); pv(20, 25); pv(21, 900); pv(22, 85); pv(23, 300); pv(41, 0.3); pv(56, 0.5); pv(58, 4);
  ) :
  p == 4 ? (
    pv(1, 2); pv(6, 8); pv(7, 0.35); pv(8, 0.5); pv(10, 0.7); pv(12, 3300); pv(13, 0.05); pv(14, 0.1); pv(20, 330); pv(21, 1500); pv(22, 85); pv(23, 1100); pv(26, 0.5); pv(40, 0.7); pv(41, 0.7); pv(51, 2.6); pv(53, 0.22); pv(56, -4);
  ) :
  p == 5 ? (
    pv(3, 1); pv(10, 0.5); pv(12, 1500); pv(13, 0.35); pv(14, 0.5); pv(17, 400); pv(18, 40); pv(22, 90); pv(23, 250); pv(26, 5.5); pv(27, 400); pv(28, 12); pv(30, 1); pv(36, 18); pv(37, 55); pv(41, 0.6); pv(44, 9); pv(45, 0.3); pv(46, 0.18); pv(56, 4.9);
  ) :
  p == 6 ? (
    pv(3, 0); pv(6, 10); pv(12, 1100); pv(14, 0.35); pv(20, 220); pv(21, 1500); pv(22, 85); pv(23, 900); pv(30, 2); pv(31, 55); pv(34, -1); pv(35, 1); pv(41, 0.8); pv(53, 0.18); pv(56, 2.6);
  ) :
  p == 7 ? (
    pv(14, 0.35); pv(20, 8); pv(21, 1200); pv(22, 70); pv(23, 500); pv(30, 3); pv(32, 12); pv(33, 6); pv(35, 0.6); pv(41, 0.6); pv(46, 0.12); pv(56, 0.2);
  ) :
  p == 8 ? (
    pv(1, 1); pv(2, 2); pv(7, 0.18); pv(10, 0.5); pv(12, 4400); pv(13, 0.45); pv(14, 0.2); pv(17, 350); pv(18, 10); pv(20, 1); pv(21, 1200); pv(22, 0); pv(23, 700); pv(24, 0.7); pv(41, 1); pv(46, 0.1); pv(53, 0.18); pv(56, 4);
  ) :
  p == 9 ? (
    pv(3, 0); pv(6, 12); pv(12, 440); pv(13, 0.55); pv(14, 0); pv(20, 600); pv(22, 100); pv(23, 1500); pv(26, 0.08); pv(29, 2.2); pv(41, 0.9); pv(51, 3); pv(53, 0.25); pv(56, 3.7);
  ) :
  p == 10 ? (
    pv(7, 0.4); pv(9, 1); pv(10, 0.9); pv(12, 880); pv(13, 0.35); pv(14, 0.55); pv(17, 220); pv(18, 0); pv(19, 180); pv(20, 1); pv(21, 300); pv(22, 0); pv(23, 200); pv(41, 0.7); pv(45, 0.55); pv(46, 0.32); pv(48, 330); pv(49, 3300); pv(51, 3.5); pv(53, 0.22); pv(56, 5);
  ) :
  p == 11 ? (
    pv(1, 2); pv(6, 5); pv(7, 0.12); pv(8, 0.35); pv(12, 1100); pv(13, 0.4); pv(14, 0.15); pv(20, 420); pv(22, 85); pv(23, 1300); pv(26, 0.33); pv(40, 0.8); pv(41, 0.8); pv(53, 0.25); pv(56, 0.8);
  ) :
  p == 12 ? (
    pv(2, 0); pv(3, 1); pv(4, 0); pv(10, 0.5); pv(12, 330); pv(13, 0.3); pv(14, 0.7); pv(17, 250); pv(18, 5); pv(19, 120); pv(20, 1); pv(21, 450); pv(22, 30); pv(23, 120); pv(24, 0.7); pv(38, 0); pv(41, 0); pv(53, 0.05); pv(56, 5.3);
  ) :
  p == 13 ? (
    pv(2, 2); pv(3, 0); pv(6, 12); pv(9, 1); pv(10, 0.9); pv(12, 770); pv(13, 0.4); pv(14, 0.7); pv(17, 180); pv(18, 0); pv(19, 200); pv(20, 1); pv(21, 450); pv(22, 12); pv(23, 220); pv(41, 1); pv(44, 10); pv(45, 0.45); pv(46, 0.3); pv(53, 0.15); pv(56, 5.9);
  ) :
  p == 14 ? (
    pv(2, 0); pv(3, 1); pv(4, 0); pv(12, 550); pv(13, 0.25); pv(14, 0.45); pv(17, 300); pv(18, 20); pv(20, 2); pv(22, 90); pv(23, 150); pv(30, 1); pv(36, 9); pv(37, 20); pv(38, 0); pv(41, 0); pv(53, 0.04); pv(56, 1.9); pv(59, 2);
  ) :
  p == 15 ? (
    pv(1, 1); pv(3, 0); pv(4, 2); pv(10, 0.35); pv(13, 0.1); pv(14, 0.3); pv(17, 900); pv(18, 20); pv(20, 2); pv(21, 1800); pv(22, 20); pv(23, 600); pv(24, 0.7); pv(39, 0.9); pv(41, 1); pv(53, 0.15); pv(56, 2.9);
  ) :
  p == 16 ? (
    pv(9, 0); pv(10, 0); pv(11, 1); pv(12, 880); pv(13, 0.75); pv(14, 0); pv(15, 0); pv(20, 900); pv(22, 100); pv(23, 2000); pv(25, 3); pv(26, 0.3); pv(29, 1.5); pv(41, 1); pv(51, 5); pv(53, 0.35); pv(56, 6);
  ) :
  p == 17 ? (
    pv(7, 0.25); pv(9, 1); pv(10, 0.9); pv(12, 990); pv(13, 0.3); pv(14, 0.6); pv(17, 180); pv(18, 0); pv(19, 120); pv(20, 1); pv(21, 300); pv(22, 10); pv(23, 120); pv(30, 3); pv(32, 12); pv(33, 4); pv(35, 0.5); pv(41, 0.4); pv(53, 0.08); pv(56, 4.6); pv(58, 6);
  ) :
  p == 18 ? (
    pv(3, 0); pv(12, 880); pv(13, 0.15); pv(14, 0.55); pv(16, 80); pv(17, 900); pv(18, 55); pv(19, 500); pv(20, 60); pv(21, 1200); pv(22, 90); pv(23, 700); pv(27, 600); pv(28, 6); pv(41, 0.7); pv(51, 2.8); pv(53, 0.3); pv(56, -2.7); pv(58, 5); pv(59, 3);
  ) : 0;
  i = 1;  loop(59, param_touched_au(i);  i += 1; );
);

PR_N = 18;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(60, i != 60 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= PR_N ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

pwr_init(); pwr_sag = 0.2;  pwr_wu_loss = 0.5;  pwr_wu_drv = 0;  pwr_wu_lp = 9000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
pwr_block(1);
prm_dirty ? ( prm_dirty = 0;  update_params(); );
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? v_all_off();  tp_was = tp_now;
km_t != km_a ? ( v_all_off();  km_a = km_t; );
(w1_t != w1_l || w2_t != w2_l || oc1_t != oc1_m || oc2_t != oc2_m) ? dk_req = 1;
lfo_rate = lfo_hz;
lfo_disp = lfo_ph;
clk_v = drf_clk.drift_tick(samplesblock / srate * 0.25 * dm_s);
cho_dv = drf_cho.drift_tick(samplesblock / srate * 0.2 * dm_s);
cho_rt = max(0.05, ch_rate * (1 + 0.15 * dm_a * cho_dv));
t_a = 2 * $pi * cho_rt / srate;  cho_ca = cos(t_a);  cho_sa = sin(t_a);
k = 0;
loop(NV,
  t_a = 2 * $pi * cho_rt * VRF[k] / srate;  VCA[k] = cos(t_a);  VSA[k] = sin(t_a);
  vb = VOX + k * VS;  t_a = 1 / sqrt(max(vb[F_CC] * vb[F_CC] + vb[F_CS] * vb[F_CS], 0.0001));  vb[F_CC] *= t_a;  vb[F_CS] *= t_a;
  k += 1;
);
t_a = 1 / sqrt(max(cho_c * cho_c + cho_s * cho_s, 0.0001));  cho_c *= t_a;  cho_s *= t_a;
fx_block();
fl_k = 1 - exp(-CR / (0.015 * srate));
f_in = 0.35 * (1 + 0.5 * kres);
f_out = 1 / 0.35;
pw_t0 = pwid;
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = 0;
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );
n_on = 0;  k = 0;
loop(NV,
  vb = VOX + k * VS;  n_on += vb[F_ON] > 0;
  VDL[k] = vb[F_ON] ? vb[F_AV] * vb[F_FADE] / max(vb[F_GAIN], 0.05) : 0;  VDP[k] = vb[F_PLC] * sqrt(blm_s);
  k += 1;
);
voices_disp = n_on;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  fl_c1 += (log(cutoff) / log(2) - fl_c1) * fl_k;  lcs += (fl_c1 - lcs) * fl_k;
  kres += (fres * 4.1 - kres) * fl_k;
  fl_ev += (fenvamt - fl_ev) * fl_k;
  fk_s += (fkey - fk_s) * fl_k;  bt_s += (b_tone - bt_s) * fl_k;
  lc_s += (lfo_cut - lc_s) * fl_k;  vib_s += (lfo_vib + mw * 40 - vib_s) * fl_k;
  blm_s += (blm_t - blm_s) * fl_k;
  lfo_ph += lfo_rate * CR / srate;
  lfo_ph >= 1 ? ( lfo_ph -= floor(lfo_ph);  lfo_sh = rand(2) - 1; );
  lfo_raw = lfo_shape < 0.5 ? 1 - 4 * abs(lfo_ph - 0.5) : lfo_shape < 1.5 ? 1 - 2 * lfo_ph :
            lfo_shape < 2.5 ? ( lfo_ph < 0.5 ? 1 : -1 ) : lfo_sh;
  lfo_v += (lfo_raw - lfo_v) * lfo_sm;
  pw_t = max(0.04, min(0.96, pw_t0 + pwm * 0.4 * lfo_v));
  vb = VOX;  v_i = 0;  loop(NV, vb[F_ON] ? v_tick(vb, v_i);  vb += VS;  v_i += 1; );
);
cr_n -= 1;
pw_s += (pw_t - pw_s) * 0.002;
o1_g += (o1g_t - o1_g) * smk;  o2_g += (o2g_t - o2_g) * smk;  nz_s += (nz_t - nz_s) * smk;  out_g += (outg_t - out_g) * smk;
chm_s += (chm_t - chm_s) * smk;  dlm_s += (dlm_t - dlm_s) * smk;  spm_s += (spm_t - spm_s) * smk;
eql_s += (eql_t - eql_s) * smk;  eqh_s += (eqh_t - eqh_s) * smk;  cho_dep += (chd_t - cho_dep) * smk;
bw_g = 0.6 * chm_s;  bw_live = chm_s > 0.0001 && blm_s > 0.0005;
dk_req ? (
  dk -= dk_st;
  dk <= 0 ? ( dk = 0;  w1_l = w1_t;  w2_l = w2_t;  oc1_m = oc1_t;  oc2_m = oc2_t;  dk_req = 0; );
) : dk < 1 ? dk = min(1, dk + dk_st);

mixL = 0;  mixR = 0;  cbus = 0;  wetL = 0;  wetR = 0;
vb = VOX;  v_i = 0;
loop(NV, vb[F_ON] ? v_run(vb, v_i) : ( BLM[v_i * CH_N + cho_w] = 0; );  vb += VS;  v_i += 1; );

CH_M[cho_w] = cbus;
c_t = cho_c * cho_ca - cho_s * cho_sa;  cho_s = cho_s * cho_ca + cho_c * cho_sa;  cho_c = c_t;
chm_s > 0.0001 ? (
  c_p = cho_w - (cho_base + cho_dep * cho_s);  c_p < 0 ? c_p += CH_N;
  c_i = floor(c_p);  c_f = c_p - c_i;
  c_l = CH_M[c_i] + (CH_M[(c_i + 1) & (CH_N - 1)] - CH_M[c_i]) * c_f;
  c_p = cho_w - (cho_base + cho_dep * cho_c);  c_p < 0 ? c_p += CH_N;
  c_i = floor(c_p);  c_f = c_p - c_i;
  c_r = CH_M[c_i] + (CH_M[(c_i + 1) & (CH_N - 1)] - CH_M[c_i]) * c_f;
) : ( c_l = 0;  c_r = 0; );
cho_w = (cho_w + 1) & (CH_N - 1);
bbd_dry = 1 - 0.3 * chm_s;
yl = (mixL * bbd_dry + c_l * 0.6 * chm_s + wetL) * out_g * dk;
yr = (mixR * bbd_dry + c_r * 0.6 * chm_s + wetR) * out_g * dk;
dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;

dl_live ? (
  u_dl = dlL.sl_run(BD_L, dl_t);  u_dr = dlR.sl_run(BD_R, dl_t);
  dl_hl += (u_dl - dl_hl) * dl_hc;  dl_hr += (u_dr - dl_hr) * dl_hc;
  dl_fl += (u_dl - dl_hl - dl_fl) * dl_dc;  dl_fr += (u_dr - dl_hr - dl_fr) * dl_dc;
  u_fl = ts(dl_fl * dl_fb * 1.25) * 0.8;  u_fr = ts(dl_fr * dl_fb * 1.25) * 0.8;
  dl_pp >= 0.5 ? bd_put((yl + yr) * 0.5 + u_fr + bv_dn, u_fl + bv_dn)
               : bd_put(yl + u_fl + bv_dn, yr + u_fr + bv_dn);
  yl += u_dl * dlm_s;  yr += u_dr * dlm_s;
);

sp_live ? (
  bv_pre(yl, yr);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, sz_s);
  fdn_run(dif_l, dif_r);
  yl += fdn_l * 0.55 * spm_s;  yr += fdn_r * 0.55 * spm_s;
);

eq_l1 += (yl - eq_l1) * eq_lc;  eq_h1 += (yl - eq_h1) * eq_hc;
eq_r1 += (yr - eq_r1) * eq_lc;  eq_g1 += (yr - eq_g1) * eq_hc;
yl += eq_l1 * eql_s + (yl - eq_h1) * eqh_s;
yr += eq_r1 * eql_s + (yr - eq_g1) * eqh_s;

dc_ol = yl - dc_qol + dc_r * dc_ol;  dc_qol = yl;  yl = dc_ol;
dc_or = yr - dc_qor + dc_r * dc_or;  dc_qor = yr;  yr = dc_or;
cp_s += (cp_t - cp_s) * smk;
(cp_t || cp_s > 0.0001) ? (
  cpg_s += (cpg_t - cpg_s) * smk;
  cp_ml += (yl * yl - cp_ml) * cp_rms;  cp_mr += (yr * yr - cp_mr) * cp_rms;
  cp_lv = 10 * log10(0.5 * (cp_ml + cp_mr) + 0.0000000001);
  cp_e = cp_smooth(cp_curve(cp_lv), cp_e);
  u_cg = 10 ^ (cp_e / 20) * cpg_s;
  yl += (yl * u_cg - yl) * cp_s;  yr += (yr * u_cg - yr) * cp_s;
) : ( cp_s = 0;  cp_e = 0;  cp_ml = cp_mr = 0; );
(ffat_t > 0 || ffat_s > 0.0001) ? (
  ffat_s += (ffat_t - ffat_s) * smk;
  cn = ffat_s / 10;  ff_thr = -32 * cn;  ff_sl = 1 - 1 / (1 + 5 * cn);  ff_mk = -ff_thr * ff_sl * 0.5;
  u_cl = max(abs(yl), abs(yr));
  u_cdb = u_cl > 0.000001 ? 20 * log10(u_cl) : -120;
  u_ov = u_cdb - ff_thr;
  u_cg = u_ov <= -3 ? 0 : u_ov >= 3 ? u_ov * ff_sl : ff_sl * sqr(u_ov + 3) / 12;
  grs += (u_cg - grs) * (u_cg > grs ? ffc_att : ffc_rel);
  u_cg = 10 ^ ((ff_mk - grs) / 20);
  yl *= u_cg;  yr *= u_cg;
) : ( grs = 0;  ffat_s = 0; );
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@gfx 1200 952
C_CAPW = 0xF4F0EA;  LK_YEL = 0xF2C230;  LK_AMB = 0xF2A41E;  LK_ORG = 0xF28A2E;  LK_RED = 0xE8503A;  lk_well = 0x111214;  C_SILV = 0xCDD0D6;
C_PANEL = 0x141414;  C_SEC1 = 0x222222;  C_SEC2 = 0x1C1C1C;  C_SEC3 = 0x282828;  C_EDGE = 0x5A5A5A;
C_INK = 0xF2F2F2;  C_INK2 = 0xC8C8C8;  C_TITLE = 0xFFD21E;  C_DIM = 0x6A6A6A;  C_RIV = 0x4A4A4A;
C_SKY1 = 0x000000;  C_SKY2 = 0x5A2810;  C_HTXT = 0xFFD21E;  C_HSUB = 0xFFD21E;  C_RULE = 0xFFD21E;
C_LCDBG = 0x0C0A00;  C_LCDTX = 0xFFD21E;  C_TEAL = 0xFFD21E;  C_TPT = 0x141414;  C_EMB = 0xF2A41E;
C_ROCK = 0xA4502A;  C_PBK = 0xFF2E00;  C_GRASS = 0x7A8A2A;  C_MIST = 0xFFD8A0;
k_mod = 1;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_l(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function rivet(x, y) (
  col(C_RIV, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.5); gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
function section(x, y, w, h, c, title) (
  col(c, 1);  u_rect(x, y, w, h);
  col(shade(c, 0.78), 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h);
  col(0xFFFFFF, 0.16);  u_rect(x, y, w - 2, 1);
  gfx_setfont(4);  col(C_TITLE, 1);  text_l(px(x + 16), py(y + 20), title);
);
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
NOTE_LIST = "C|C#|D|Eb|E|F|F#|G|Ab|A|Bb|B";
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function note_name(n, dst) ( pb_item(NOTE_LIST, (n | 0) % 12 + 1, dst);  sprintf(#nn_o, "%d", floor((n | 0) / 12) - 1);  strcat(dst, #nn_o); );
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v * 100 + 0.5) :
  fmt == 2 ? ( v < 1000 ? sprintf(#kv, "%d Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
  fmt == 3 ? ( v < 10 ? sprintf(#kv, "%.1f ms", v) : v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 4 ? sprintf(#kv, "%d %%", v) :
  fmt == 7 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 12 ? sprintf(#kv, "%+d %%", v * 100) :
  fmt == 14 ? sprintf(#kv, "%+d st", v) :
  fmt == 15 ? sprintf(#kv, "%.1f c", v) :
  fmt == 16 ? strcpy(#kv, bd_divname(floor(v + 0.5))) :
  fmt == 17 ? sprintf(#kv, "%.1f s", v) :
  fmt == 9 ? sprintf(#kv, "+/-%.2f oct", v) :
  fmt == 10 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 11 ? sprintf(#kv, "%+.2f oct", v) :
  fmt == 18 ? note_name(v, #kv) :
              sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
function dshadow(x, y, r) local(i) (
  i = 0;
  loop(4, col(0x000000, 0.13);  gfx_circle(x + ps(2 + i * 1.33), y + ps(3 + i * 1.67), r + ps(i * 0.6), 1, 1);  i += 1; );
);
function thick_arc(x, y, r, a, b, w) local(i, n) (
  a > b ? ( i = a;  a = b;  b = i; );
  b - a > 0.01 ? ( n = max(1, ceil(w * 2));  i = 0;  loop(n + 1, gfx_arc(x, y, r - w * 0.5 + i * w / n, a, b, 1);  i += 1; ); );
);
function knob_halo(x, y, rr, tv, cap, dm) local(ac, i, a, n, on, r1, r2, lum) (
  lum = floor(cap / 65536) * 0.3 + (floor(cap / 256) % 256) * 0.59 + (cap % 256) * 0.11;
  ac = lum < 70 ? C_HSUB : cap;  dm ? ac = shade(ac, 0.45);
  n = 31;  r1 = rr + ps(5);  r2 = rr + ps(11);
  col(0x000000, 0.6);  thick_arc(x, y, (r1 + r2) * 0.5, -0.78 * $pi, 0.78 * $pi, r2 - r1 + ps(3));
  i = 0;
  loop(n,
    a = -0.75 * $pi + 1.5 * $pi * i / (n - 1);  on = a <= tv + 0.001;
    on ? ( col(ac, 0.22);  thick_arc(x, y, (r1 + r2) * 0.5, a - 0.05, a + 0.05, r2 - r1 + ps(4)); );
    col(on ? ac : 0x2E2E2E, 1);  thick_arc(x, y, (r1 + r2) * 0.5, a - 0.035, a + 0.035, r2 - r1);
    i += 1;
  );
  col(0x5A5C60, 1);  gfx_circle(x, y, rr, 1, 1);
  col(0x2A2B2E, 1);  i = 0;  loop(48, a = 2 * $pi * i / 48;  gfx_line(x + sin(a) * rr * 0.86, y - cos(a) * rr * 0.86, x + sin(a) * rr, y - cos(a) * rr, 1);  i += 1; );
  i = 0;
  loop(9,
    col(ui_mix(0xE4E6EA, 0x8E9298, i / 8), 1);  gfx_circle(x, y, rr * (0.84 - i * 0.075), 1, 1);
    col(0xFFFFFF, 0.18);  gfx_arc(x, y, rr * (0.84 - i * 0.075), -1.9, -0.2, 1);
    col(0x000000, 0.12);  gfx_arc(x, y, rr * (0.84 - i * 0.075), 1.3, 2.9, 1);
    i += 1;
  );
  col(0xFFFFFF, 0.55);  gfx_arc(x, y, rr * 0.84, -1.6, -0.5, 1);
  col(0x000000, 0.35);  gfx_circle(x, y, rr * 0.84, 0, 1);
  col(dm ? 0x6A6A6A : 0x111111, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.2, rr * 0.8, ps(2));
  col(ac, dm ? 0.4 : 1);  gfx_circle(x + sin(tv) * rr * 0.68, y - cos(tv) * rr * 0.68, ps(2.2), 1, 1);
);
function kdot(x, y, a, capr) local(rd) ( rd = max(capr * 0.19, ps(2));  gfx_circle(x + sin(a) * capr * 0.62, y - cos(a) * capr * 0.62, rd, 1, 1); );
function knob_pastel(x, y, rr, tv, cap, zr, dm) local(i, a, n, cpr, lum, pd)
(
  lum = floor(cap / 65536) * 0.3 + (floor(cap / 256) % 256) * 0.59 + (cap % 256) * 0.11;
  pd = lum < 90 ? 0xF2F2F2 : 0x232323;
  dm ? ( cap = ui_mix(cap, 0x3A3A3A, 0.55);  pd = ui_mix(pd, 0x3A3A3A, 0.5); );
  col(C_INK2, 0.85);  i = 0;
  loop(5, a = -0.75 * $pi + i * 0.375 * $pi;  !(zr && i == 2) ? gfx_circle(x + sin(a) * (rr + ps(6)), y - cos(a) * (rr + ps(6)), ps(i == 0 || i == 4 ? 1.7 : 1.3), 1, 1);  i += 1; );
  col(0x0C0C0C, 1);  gfx_circle(x, y, rr, 1, 1);
  col(0x2E2E2E, 1);  i = 0;  n = 36;
  loop(n, a = 2 * $pi * i / n;  gfx_line(x + sin(a) * rr * 0.8, y - cos(a) * rr * 0.8, x + sin(a) * rr * 0.97, y - cos(a) * rr * 0.97, 1);  i += 1; );
  col(0xFFFFFF, 0.12);  gfx_arc(x, y, rr - 1, -1.9, -0.2, 1);
  cpr = rr * 0.7;
  col(0x000000, 0.45);  gfx_circle(x + ps(0.8), y + ps(1), cpr, 1, 1);
  col(shade(cap, 0.7), 1);  gfx_circle(x, y, cpr, 1, 1);
  col(cap, 1);  gfx_circle(x, y, cpr * 0.9, 1, 1);
  col(0xFFFFFF, 0.4);  gfx_arc(x, y, cpr * 0.86, -1.8, -0.3, 1);
  col(pd, 1);  kdot(x, y, tv, cpr * 0.95);
);

function kn(cx, cy, r, idx, vmin, vmax, def, cap, pcol, lbl, fmt, big)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lgt, st, dm, zr, hl)
(
  hl = k_halo;  k_halo = 0;  lgt = klog;  klog = 0;  st = kstep;  kstep = 0;  dm = kdim;  kdim = 0;  zr = kzero;  kzero = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t;  drag_y0 = mouse_y; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx && abs(mouse_y - drag_y0) >= 3 ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 200)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st :
    lgt ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 1000 + 0.5) / 1000;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    drag_y0 = -100000;
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  col(C_INK2, 0.8);  j = 0;
  !k_mod && !hl ? loop(11, b = a0 + j / 10 * (a1 - a0);
    !(zr && j == 5) ? gfx_circle(x + sin(b) * (rr + ps(6)), y - cos(b) * (rr + ps(6)), ps(big ? 1.4 : 1.1), 1, 1);  j += 1; );
  zr ? ( gfx_setfont(5);  col(C_INK2, 1);  text_c(x, y - rr - ps(14), "0"); );
  dshadow(x, y, rr);
  hl ? knob_halo(x, y, rr, tv, cap, dm) : knob_pastel(x, y, rr, tv, cap == 0xF2D04A ? 0xF2DC8A : cap == 0x232327 ? 0x3A3A3E : k_pc, zr, dm);
  dm ? ( col(C_SEC2, 0.55);  gfx_circle(x, y, rr + ps(1), 1, 1); );
  gfx_setfont(6);  col(dm ? C_DIM : C_INK, 1);  text_c(x, y + rr + ps(hl ? 26 : 19), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(16), fmtv(v, fmt));
);

function fader(x, y0, h, idx, vmin, vmax, def, lgt, lbl, fmt) local(t, v, cy, hov, now, j, cx)
(
  cx = px(x);
  v = slider(idx);  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  hov = abs(mouse_x - cx) < ps(12) && mouse_y >= py(y0 - 10) && mouse_y <= py(y0 + h + 10);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? h * 5 : h)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    lgt ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = slider(idx);  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  cy = y0 + h * (1 - t);
  col(shade(C_PANEL, 0.5), 1);  u_rect(x - 3, y0, 6, h);  col(0x0A0A0B, 1);  u_rect(x - 1, y0 + 2, 2, h - 4);
  col(C_INK2, 0.7);  j = 0;  loop(5, u_rect(x - 10, y0 + j * h / 4, 4, 1);  j += 1; );
  j = 0;  loop(4, col(0x000000, 0.13);  u_rect(x - 10 + 2 + j * 1.33, cy - 8 + 3 + j * 1.67, 20, 16);  j += 1; );
  col(C_SILV, 1);  u_rect(x - 10, cy - 8, 20, 16);
  col(0xFFFFFF, 0.6);  u_rect(x - 10, cy - 8, 20, 1.5);
  col(shade(C_SILV, 0.75), 1);  u_rect(x - 10, cy + 6.5, 20, 1.5);  u_rect(x + 8.5, cy - 8, 1.5, 16);
  col(fcap, 1);  u_rect(x - 10, cy - 1, 20, 2);
  gfx_setfont(6);  col(C_INK, 1);  text_c(cx, py(y0 + h + 16), lbl);
  hov || drag_idx == idx ? hover_tag(cx, py(y0 - 14), fmtv(v, fmt));
);

function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str);
);
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, col(0x000000, 0.13);  lk_rr(x - 4 * k + 2 + i * 1.33, y - 4 * k + 3 + i * 1.67, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lcd_box(x, y, w, h) (
  col(shade(C_PANEL, 0.6), 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x020303, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  col(0xFFFFFF, 0.06);  u_rect(x + 4, y + 4, w - 8, 1);
);
function lcd_text(x, y, fnt, str) local(tw, th, gy) (
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y) - th * 0.5;
  col(C_LCDTX, 0.22);
  gfx_x = px(x) - 1;  gfx_y = gy;  gfx_drawstr(str);
  gfx_x = px(x) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x);  gfx_y = gy;  gfx_drawstr(str);
);
function lcd(x, y, w, h, fnt, str) ( lcd_box(x, y, w, h);  lcd_text(x + 10, y + h * 0.5, fnt, str); );

function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, C_PBK, "PRESETS") ? open = 1;
  lk_key(x + 96, y + 3, 24, h - 6, 0, C_PBK, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 122, y + 3, 24, h - 6, 0, C_PBK, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1A1A, 1);  pb_tri(x + 108, y + h * 0.5, 4.5, -1);  pb_tri(x + 134, y + h * 0.5, 4.5, 1);
  lx = x + 152;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);

function lk_menu(x, y, w, h, idx, list, n, c) local(t, sel, i) (
  t = floor(slider(idx) + 0.5);
  lk_key(x, y, w, h, 1, c, pb_item(list, t + 1, #lm)) ? (
    strcpy(#lmm, "");  i = 0;
    loop(n, i == t ? strcat(#lmm, "!");  strcat(#lmm, pb_item(list, i + 1, #lmt));  i < n - 1 ? strcat(#lmm, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h + 4);  sel = gfx_showmenu(#lmm);
    sel > 0 ? ( slider(idx) = sel - 1;  param_touched(idx); );
  );
);

function g_wave(w, p) local(q) (
  q = p - floor(p);
  w < 0.5 ? 2 * q - 1 :
  w < 1.5 ? ( q < 0.5 ? 1 : -1 ) :
  w < 2.5 ? ( q < pwid ? 1 : -1 ) :
            ( (2 * q - 1) + (q < pwid ? 0.5 : -0.5) ) * 0.75;
);
function divider(x, y0, y1) ( col(0x000000, 0.35);  u_rect(x, y0, 1, y1 - y0);  col(0xFFFFFF, 0.10);  u_rect(x + 1, y0, 1, y1 - y0); );
function sub_title(x, y, str) ( gfx_setfont(6);  col(C_TITLE, 1);  text_l(px(x), py(y), str); );
function small_l(x, y, str) ( gfx_setfont(6);  col(C_INK2, 1);  text_l(px(x), py(y), str); );

WAVE_LIST = "SAW|SQUARE|PULSE|SAW+PULSE";
OCT_LIST = "16'|8'|4'";
PRESET_MENU = "Init|Bloom Pad|Brass 83|Poly Strings|Unison Lead|Split Bass and Pad|Double Octaves|Glass Keys|Slow Sweep|Dub Chords|Choir Pad|Bass Pluck|Neon Pluck|Unison Bass|Wide Keys|Noise Wind|Funk Stab|Hall Brass";

function hr(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453;  v - floor(v); );
function isl_d(u, d, sd) ( d * (1 - abs(u) ^ 1.25) ^ 1.6 * (0.55 + 0.45 * abs(sin(u * 4.2 + sd)) + 0.12 * sin(u * 23 + sd * 3)); );
function isl(cx, ty, w, d, sd) local(n, i, u, dd, x0, y0, c, k, rx, ry, rl)
(
  n = ceil(ps(w));  x0 = px(cx - w * 0.5);  y0 = py(ty);
  i = 0;
  loop(n,
    u = i / n * 2 - 1;
    dd = isl_d(u, d, sd);
    c = ui_mix(shade(C_ROCK, 1.35), shade(C_ROCK, 0.6), (u + 1) * 0.5);
    col(c, 1);  gfx_rect(x0 + i, y0, 1, ps(max(dd, 1)), 1);
    col(0x000000, 0.28);  gfx_rect(x0 + i, y0 + ps(dd * 0.62), 1, ps(max(dd * 0.38, 0.5)), 1);
    col(shade(C_ROCK, 0.5), 0.5);  gfx_rect(x0 + i, y0 + ps(dd * 0.33), 1, 1, 1);
    i += 1;
  );
  i = 0;
  loop(n,
    u = i / n * 2 - 1;
    dd = 3.2 * sqrt(max(0, 1 - u * u));
    col(ui_mix(shade(C_GRASS, 1.3), shade(C_GRASS, 0.75), (u + 1) * 0.5), 1);  gfx_rect(x0 + i, y0 - ps(dd), 1, ps(dd + 1.5), 1);
    i += 1;
  );
  k = 0;
  loop(floor(w / 22) + 1,
    u = (hr(sd * 7 + k) * 1.4 - 0.7);  rx = cx + u * w * 0.5;  rl = 2.5 + hr(sd * 11 + k) * 3.5;
    col(shade(C_GRASS, 0.7), 1);  gfx_rect(px(rx) - ps(0.5), py(ty - rl - 1), max(1, ps(1)), ps(rl + 1), 1);
    col(shade(C_GRASS, 0.95), 1);  gfx_circle(px(rx), py(ty - rl - 2), ps(rl * 0.75), 1, 1);
    col(shade(C_GRASS, 1.4), 0.7);  gfx_circle(px(rx - rl * 0.25), py(ty - rl - 2.6), ps(rl * 0.35), 1, 1);
    k += 1;
  );
  k = 0;
  loop(floor(w / 9),
    u = hr(sd * 13 + k) * 1.6 - 0.8;  rx = cx + u * w * 0.5;
    dd = isl_d(u, d, sd);  ry = ty + dd * 0.85;  rl = 4 + hr(sd * 17 + k) * 12;
    col(shade(C_ROCK, 0.45), 0.75);
    i = 0;  loop(6, gfx_line(px(rx + sin(i + k) * 0.8), py(ry + i * rl / 6), px(rx + sin(i + 1 + k) * 0.8), py(ry + (i + 1) * rl / 6), 1);  i += 1; );
    k += 1;
  );
);
function mist(cx, cy, w, h, a) local(i, n, t, al, x0, x1, fw, m_r, m_g, m_b) (
  m_r = floor(C_MIST / 65536) / 255;  m_g = (floor(C_MIST / 256) % 256) / 255;  m_b = (C_MIST % 256) / 255;
  n = max(1, ceil(ps(h)));  x0 = px(cx - w * 0.5);  x1 = px(cx + w * 0.5);  fw = (x1 - x0) * 0.3;  i = 0;
  loop(n,
    t = (i + 0.5) / n * 2 - 1;  al = a * 0.55 * (1 - t * t) ^ 1.5;
    gfx_gradrect(x0, py(cy - h * 0.5) + i, fw, 1, m_r, m_g, m_b, 0, 0, 0, 0, al / fw);
    gfx_gradrect(x0 + fw, py(cy - h * 0.5) + i, x1 - x0 - 2 * fw, 1, m_r, m_g, m_b, al);
    gfx_gradrect(x1 - fw, py(cy - h * 0.5) + i, fw, 1, m_r, m_g, m_b, al, 0, 0, 0, -al / fw);
    i += 1;
  );
);
function veil(x, y, w, h, a) local(i, n) (
  n = ceil(ps(h));  i = 0;
  loop(n, col(ui_mix(C_SKY1, C_SKY2, ((py(y) + i) / ps(100)) ^ 1.3), a);  gfx_rect(px(x), py(y) + i, ps(w), 1, 1);  i += 1; );
);
function header_art(w, h) local(i, t, sox, soy, r) (
  sox = ox;  soy = oy;  ox = 0;  oy = 0;
  gfx_setimgdim(20, -1, -1);  gfx_setimgdim(20, w, h);  gfx_dest = 20;
  i = 0;
  loop(h, t = (i / h) ^ 1.3;  col(ui_mix(C_SKY1, C_SKY2, t), 1);  gfx_rect(0, i, w, 1, 1);  i += 1; );
  i = 0;  loop(40, col(0xFFFFFF, 0.25 + 0.4 * hr(i + 3));  gfx_rect(px(300 + hr(i) * 880), py(2 + hr(i + 50) * 34), max(1, ps(1)), max(1, ps(1)), 1);  i += 1; );
  isl(1012, 54, 30, 22, 4.1);  veil(990, 44, 44, 40, 0.5);
  mist(640, 90, 900, 14, 0.9);
  isl(352, 40, 100, 54, 1.3);
  isl(472, 72, 50, 24, 2.7);
  isl(592, 62, 128, 36, 3.9);
  i = 0;  r = ceil(ps(34));
  loop(r, t = i / r;  col(C_MIST, 0.7 * (1 - t) ^ 0.8);  gfx_rect(px(647.4 + t * 1.2), py(60) + i, max(1, ps(1.6 + t * 1.6)), 1, 1);
    col(C_MIST, 0.25 * (1 - t));  gfx_rect(px(646.4 + t * 0.6), py(60) + i, max(1, ps(3.6 + t * 3)), 1, 1);  i += 1; );
  i = 0;  loop(5, col(C_MIST, 0.07);  gfx_circle(px(649), py(93), ps(3 + i * 1.6), 1, 1);  i += 1; );
  isl(722, 82, 56, 18, 5.2);
  isl(842, 68, 108, 32, 6.6);
  isl(1090, 80, 40, 22, 7.4);  isl(1166, 76, 44, 26, 8.8);
  mist(380, 97, 260, 8, 0.7);  mist(1000, 95, 360, 8, 0.6);
  gfx_dest = -1;  ox = sox;  oy = soy;
);

g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1200 * g_ret), gfx_h / (952 * g_ret))), 0.5);
ox = (gfx_w - 1200 * sc) * 0.5;
oy = (gfx_h - 952 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
h_click = sz_help ? click : 0;  h_wheel = sz_help ? mouse_wheel : 0;
sz_help ? ( click = 0;  mouse_wheel = 0; );
klog = 0;  kstep = 0;  kdim = 0;  kzero = 0;  fcap = C_TEAL;

function fit_font(idx, size) local(fs, w, h, target) (
  target = 5.28 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, "Trebuchet MS", fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);
sc != ff_sc ? (
  ff_sc = sc;
  fs10 = fit_font(10, ps(12));
  fs2 = fit_font(2, ps(15));
  fs3 = fit_font(3, ps(14));
  fs4 = fit_font(4, ps(18));
  fs5 = fit_font(5, ps(13));
  fs6 = fit_font(6, ps(15));
);
gfx_setfont(1, "Century Gothic", ps(30), 'b');
gfx_setfont(10, "Trebuchet MS", fs10, 'b');
gfx_setfont(2, "Trebuchet MS", fs2, 'b');
gfx_setfont(3, "Trebuchet MS", fs3, 'b');
gfx_setfont(4, "Trebuchet MS", fs4, 'b');
gfx_setfont(5, "Trebuchet MS", fs5, 'b');
gfx_setfont(6, "Trebuchet MS", fs6, 'b');
gfx_setfont(7, "Courier New", ps(15), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');
gfx_setfont(9, "Courier New", ps(22), 'b');

out_m = max(outpk_disp, out_m * 0.85);  outpk_disp = 0;

col(C_PANEL, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
g_aw = ceil(ps(1200));  g_ah = ceil(ps(100));
(g_aw != art_w || g_ah != art_h) ? ( header_art(g_aw, g_ah);  art_w = g_aw;  art_h = g_ah; );
gfx_x = floor(ox);  gfx_y = floor(oy);  gfx_blit(20, 1, 0);
col(0x000000, 1);  u_rect(0, 100, 1200, 3);  col(C_RULE, 1);  u_rect(0, 103, 1200, 1);
rivet(8, 8);  rivet(1192, 8);
gfx_setfont(1);  col(0x000000, 0.5);  text_l(px(26), py(26), "KX 24");  col(C_HTXT, 1);  text_l(px(24), py(24), "KX 24");
gfx_setfont(10);  col(0x000000, 0.5);  text_l(px(27), py(48), "EIGHT-VOICE POLYPHONIC SYNTHESISER");
col(C_HSUB, 1);  text_l(px(26), py(47), "EIGHT-VOICE POLYPHONIC SYNTHESISER");
gfx_setfont(4);  col(0x000000, 0.5);  text_l(px(1042), py(31), "GFX");  col(C_HSUB, 1);  text_l(px(1040), py(29), "GFX");

prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );
pb_k = preset_bar(400, 12, 34, 340, pr_cur, PRESET_MENU);
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k > PR_N ? 1 : pb_k; );

oy += 44 * sc;
col(shade(C_PANEL, 0.7), 1);  u_rect(0, 905, 1200, 3);  u_rect(1197, 60, 3, 848);
rivet(8, 900);  rivet(1192, 900);

section(16, 76, 300, 208, C_SEC1, "DCO 1");
small_l(32, 138, "WAVE");  lk_menu(110, 126, 160, 26, 1, WAVE_LIST, 4, LK_ORG);
small_l(32, 178, "OCTAVE");  lk_menu(110, 166, 80, 26, 2, OCT_LIST, 3, LK_YEL);
C_CAPW = 0xF7D7C2;  k_pc = 0xC9B6E8;
g_pw = o1wave >= 1.5 || o2wave >= 1.5;
kdim = !g_pw;  kn(96, 236, 18, 7, 0.05, 0.5, 0.3, C_CAPW, 0x262B45, "PW", 1, 0);
kdim = !g_pw;  kn(236, 236, 18, 8, 0, 1, 0, C_CAPW, 0x262B45, "PWM", 1, 0);

section(332, 76, 300, 208, C_SEC2, "DCO 2");
small_l(348, 138, "WAVE");  lk_menu(426, 126, 160, 26, 3, WAVE_LIST, 4, LK_ORG);
small_l(348, 178, "OCTAVE");  lk_menu(426, 166, 80, 26, 4, OCT_LIST, 3, LK_YEL);
kstep = 1;  kzero = 1;  kn(412, 236, 18, 5, -12, 12, 0, C_CAPW, 0x262B45, "INTERVAL", 14, 0);
kn(552, 236, 18, 6, 0, 50, 7, C_CAPW, 0x262B45, "DETUNE", 15, 0);

section(648, 76, 260, 208, C_SEC3, "MIXER");
lcd_box(664, 116, 228, 62);
g_ym = 147;
