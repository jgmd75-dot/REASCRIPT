  p == 9 ? ( pv(9, 0); pv(10, 0); pv(11, 1); pv(12, 262); pv(13, 0.95); pv(14, 0); pv(15, 1); pv(20, 400); pv(21, 2000); pv(22, 100); pv(23, 1200); pv(25, 0); pv(26, 0.2); pv(29, 0.08); pv(41, 1); pv(50, 0.8); pv(51, 6); pv(53, 0.35); pv(58, 10); pv(59, 5); pv(56, 0.7); ) :
  p == 10 ? ( pv(9, 1); pv(10, 0); pv(11, 0.35); pv(12, 262); pv(13, 0.97); pv(14, 0); pv(15, 1); pv(20, 1); pv(21, 500); pv(22, 0); pv(23, 600); pv(24, 0.8); pv(41, 1); pv(44, 8); pv(45, 0.45); pv(46, 0.25); pv(50, 0.7); pv(51, 3.5); pv(53, 0.3); pv(59, 4); pv(56, 6); ) :
  p == 11 ? ( pv(1, 3); pv(3, 0); pv(6, 10); pv(12, 1400); pv(13, 0.3); pv(14, 0.45); pv(17, 700); pv(18, 30); pv(20, 2); pv(21, 700); pv(22, 60); pv(23, 500); pv(30, 2); pv(31, 55); pv(32, -24); pv(33, 8); pv(34, -1.5); pv(35, 1); pv(41, 0.9); pv(45, 0.4); pv(46, 0.15); pv(53, 0.18); pv(56, 3.4); ) :
  p == 12 ? ( pv(1, 1); pv(3, 0); pv(5, 1); pv(6, 3); pv(12, 1800); pv(13, 0.25); pv(14, 0.35); pv(17, 900); pv(18, 40); pv(20, 1); pv(21, 1200); pv(22, 40); pv(23, 400); pv(39, 4); pv(40, 0.6); pv(41, 0.3); pv(53, 0.12); pv(56, 4.9); ) :
  p == 13 ? ( pv(1, 1); pv(2, 2); pv(3, 1); pv(5, 6); pv(6, 2); pv(12, 2600); pv(13, 0.3); pv(14, 0.5); pv(15, 0.8); pv(17, 800); pv(18, 0); pv(19, 1500); pv(20, 1); pv(21, 1500); pv(22, 0); pv(23, 1500); pv(24, 0.7); pv(41, 1); pv(50, 0.7); pv(51, 3); pv(53, 0.3); pv(56, 2.8); ) :
  p == 14 ? ( pv(3, 0); pv(6, 8); pv(12, 1600); pv(13, 0.2); pv(14, 0.2); pv(16, 2000); pv(18, 100); pv(20, 2500); pv(21, 2000); pv(22, 100); pv(23, 60); pv(41, 0.8); pv(44, 4); pv(45, 0.8); pv(46, 0.4); pv(49, 2500); pv(50, 0.9); pv(51, 5); pv(53, 0.35); pv(56, 3.4); ) :
  p == 15 ? ( pv(1, 2); pv(3, 2); pv(7, 0.15); pv(10, 0.5); pv(12, 1800); pv(13, 0.4); pv(14, 0.2); pv(20, 2); pv(22, 100); pv(23, 200); pv(25, 1); pv(26, 3); pv(28, 100); pv(38, 0); pv(41, 0); pv(44, 5); pv(45, 0.85); pv(46, 0.45); pv(48, 330); pv(49, 2200); pv(53, 0.2); pv(56, -2); ) :
  p == 16 ? ( pv(1, 2); pv(3, 2); pv(5, 7); pv(7, 0.06); pv(8, 1); pv(12, 4000); pv(13, 0.3); pv(14, 0); pv(20, 200); pv(22, 90); pv(23, 800); pv(25, 1); pv(26, 14); pv(41, 1); pv(53, 0.25); pv(56, -0.5); ) :
  p == 17 ? ( pv(3, 0); pv(6, 5); pv(12, 2000); pv(13, 0.2); pv(14, 0.3); pv(20, 5); pv(21, 1500); pv(22, 70); pv(23, 600); pv(39, 5); pv(40, 1); pv(41, 0); pv(53, 0.1); pv(56, 3); ) :
  p == 18 ? ( pv(3, 1); pv(12, 1200); pv(13, 0.4); pv(14, 0.65); pv(17, 250); pv(18, 0); pv(19, 200); pv(20, 1); pv(21, 350); pv(22, 0); pv(23, 250); pv(24, 0.8); pv(41, 0.7); pv(50, 0.6); pv(51, 2.5); pv(53, 0.35); pv(58, 10); pv(59, 8); pv(56, -3); ) :
  p == 19 ? ( pv(1, 3); pv(3, 0); pv(12, 2200); pv(13, 0.3); pv(14, 0.4); pv(17, 900); pv(18, 20); pv(20, 1); pv(21, 900); pv(22, 30); pv(23, 500); pv(30, 3); pv(32, 24); pv(33, 15); pv(34, 2); pv(35, 0.35); pv(41, 0.9); pv(46, 0.15); pv(53, 0.15); pv(56, 2.3); ) :
  p == 20 ? ( pv(2, 0); pv(3, 0); pv(4, 0); pv(11, 0.2); pv(12, 300); pv(13, 0.5); pv(14, 0.1); pv(20, 300); pv(22, 100); pv(23, 900); pv(25, 3); pv(26, 0.8); pv(29, 1); pv(30, 3); pv(32, -12); pv(34, -1); pv(35, 0.8); pv(41, 0.5); pv(53, 0.1); pv(59, 3); pv(56, -3.6); ) :
  p == 21 ? ( pv(1, 1); pv(3, 0); pv(6, 8); pv(12, 900); pv(13, 0.45); pv(14, 0.15); pv(20, 5); pv(21, 2500); pv(22, 60); pv(23, 900); pv(25, 0); pv(26, 0.12); pv(29, 2); pv(41, 0.9); pv(53, 0.2); pv(56, 1.6); ) :
  p == 22 ? ( pv(3, 0); pv(6, 11); pv(12, 1300); pv(13, 0.2); pv(14, 0.1); pv(20, 1500); pv(21, 3000); pv(22, 100); pv(23, 4000); pv(39, 0.1); pv(40, 1); pv(41, 1); pv(50, 1); pv(51, 12); pv(52, 0.2); pv(53, 0.45); pv(56, 0.2); ) :
  0;
  i = 1;  loop(59, param_touched_au(i);  i += 1; );
);

PR_N = 22;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(59, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= PR_N ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

pwr_init(); pwr_sag = 0.2;  pwr_wu_loss = 0.5;  pwr_wu_drv = 0;  pwr_wu_lp = 9000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update_params();

@block
prs_chk();
pwr_block(1);
prm_dirty = 0;  update_params();
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? v_all_off();  tp_was = tp_now;
km_t != km_a ? ( v_all_off();  km_a = km_t; );
(w1_t != w1_l || w2_t != w2_l || oc1_t != oc1_m || oc2_t != oc2_m) ? dk_req = 1;
lfo_rate = lfo_hz;
lfo_disp = lfo_ph;
clk_v = drf_clk.drift_tick(samplesblock / srate * 0.25 * dm_s);
cho_dv = drf_cho.drift_tick(samplesblock / srate * 0.2 * dm_s);
cho_rt = max(0.05, ch_rate * (1 + 0.15 * dm_a * cho_dv));
t_a = 2 * $pi * cho_rt / srate;  cho_ca = cos(t_a);  cho_sa = sin(t_a);
k = 0;
loop(NV,
  t_a = 2 * $pi * cho_rt * VRF[k] / srate;  VCA[k] = cos(t_a);  VSA[k] = sin(t_a);
  vb = VOX + k * VS;  t_a = 1 / sqrt(max(vb[F_CC] * vb[F_CC] + vb[F_CS] * vb[F_CS], 0.0001));  vb[F_CC] *= t_a;  vb[F_CS] *= t_a;
  k += 1;
);
t_a = 1 / sqrt(max(cho_c * cho_c + cho_s * cho_s, 0.0001));  cho_c *= t_a;  cho_s *= t_a;
fx_block();
fl_k = 1 - exp(-CR / (0.015 * srate));
f_in = 0.35 * (1 + 0.5 * kres);
f_out = 1 / 0.35;
pw_t0 = pwid;
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = 0;
kx_pk_d = max(kx_pk_d, outpk);  kx_lv_d = max(kx_lv_d * 0.8, outpk);  outpk = 0;
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );
n_on = 0;  k = 0;
loop(NV,
  vb = VOX + k * VS;  n_on += vb[F_ON] > 0;
  VDL[k] = vb[F_ON] ? vb[F_AV] * vb[F_FADE] / max(vb[F_GAIN], 0.05) : 0;  VDP[k] = vb[F_PLC] * sqrt(blm_s);  VDC[k] = vb[F_CS];
  k += 1;
);
voices_disp = n_on;
kx_mid_d = kx_mlt;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  fl_c1 += (log(cutoff) / log(2) - fl_c1) * fl_k;  lcs += (fl_c1 - lcs) * fl_k;
  kres += (fres * 4.1 - kres) * fl_k;
  fl_ev += (fenvamt - fl_ev) * fl_k;
  fk_s += (fkey - fk_s) * fl_k;  bt_s += (b_tone - bt_s) * fl_k;
  lc_s += (lfo_cut - lc_s) * fl_k;  vib_s += (lfo_vib + mw * 40 - vib_s) * fl_k;
  blm_s += (blm_t - blm_s) * fl_k;
  lfo_ph += lfo_rate * CR / srate;
  lfo_ph >= 1 ? ( lfo_ph -= floor(lfo_ph);  lfo_sh = rand(2) - 1; );
  lfo_raw = lfo_shape < 0.5 ? 1 - 4 * abs(lfo_ph - 0.5) : lfo_shape < 1.5 ? 1 - 2 * lfo_ph :
            lfo_shape < 2.5 ? ( lfo_ph < 0.5 ? 1 : -1 ) : lfo_sh;
  lfo_v += (lfo_raw - lfo_v) * lfo_sm;
  pw_t = max(0.04, min(0.96, pw_t0 + pwm * 0.4 * lfo_v));
  vb = VOX;  v_i = 0;  loop(NV, vb[F_ON] ? v_tick(vb, v_i);  vb += VS;  v_i += 1; );
);
cr_n -= 1;
pw_s += (pw_t - pw_s) * 0.002;
o1_g += (o1g_t - o1_g) * smk;  o2_g += (o2g_t - o2_g) * smk;  nz_s += (nz_t - nz_s) * smk;  out_g += (outg_t - out_g) * smk;
chm_s += (chm_t - chm_s) * smk;  dlm_s += (dlm_t - dlm_s) * smk;  spm_s += (spm_t - spm_s) * smk;
eql_s += (eql_t - eql_s) * smk;  eqh_s += (eqh_t - eqh_s) * smk;  cho_dep += (chd_t - cho_dep) * smk;
bw_g = 0.6 * chm_s;  bw_live = chm_s > 0.0001 && blm_s > 0.0005;
dk_req ? (
  dk -= dk_st;
  dk <= 0 ? ( dk = 0;  w1_l = w1_t;  w2_l = w2_t;  oc1_m = oc1_t;  oc2_m = oc2_t;  dk_req = 0; );
) : dk < 1 ? dk = min(1, dk + dk_st);

mixL = 0;  mixR = 0;  cbus = 0;  wetL = 0;  wetR = 0;
vb = VOX;  v_i = 0;
loop(NV, vb[F_ON] ? v_run(vb, v_i) : ( BLM[v_i * CH_N + cho_w] = 0; );  vb += VS;  v_i += 1; );

CH_M[cho_w] = cbus;
c_t = cho_c * cho_ca - cho_s * cho_sa;  cho_s = cho_s * cho_ca + cho_c * cho_sa;  cho_c = c_t;
chm_s > 0.0001 ? (
  c_p = cho_w - (cho_base + cho_dep * cho_s);  c_p < 0 ? c_p += CH_N;
  c_i = floor(c_p);  c_f = c_p - c_i;
  c_l = CH_M[c_i] + (CH_M[(c_i + 1) & (CH_N - 1)] - CH_M[c_i]) * c_f;
  c_p = cho_w - (cho_base + cho_dep * cho_c);  c_p < 0 ? c_p += CH_N;
  c_i = floor(c_p);  c_f = c_p - c_i;
  c_r = CH_M[c_i] + (CH_M[(c_i + 1) & (CH_N - 1)] - CH_M[c_i]) * c_f;
) : ( c_l = 0;  c_r = 0; );
cho_w = (cho_w + 1) & (CH_N - 1);
bbd_dry = 1 - 0.3 * chm_s;
yl = (mixL * bbd_dry + c_l * 0.6 * chm_s + wetL) * out_g * dk;
yr = (mixR * bbd_dry + c_r * 0.6 * chm_s + wetR) * out_g * dk;
dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;

dl_live ? (
  u_dl = dlL.sl_run(BD_L, dl_t);  u_dr = dlR.sl_run(BD_R, dl_t);
  dl_hl += (u_dl - dl_hl) * dl_hc;  dl_hr += (u_dr - dl_hr) * dl_hc;
  dl_fl += (u_dl - dl_hl - dl_fl) * dl_dc;  dl_fr += (u_dr - dl_hr - dl_fr) * dl_dc;
  u_fl = ts(dl_fl * dl_fb * 1.25) * 0.8;  u_fr = ts(dl_fr * dl_fb * 1.25) * 0.8;
  dl_pp >= 0.5 ? bd_put((yl + yr) * 0.5 + u_fr + bv_dn, u_fl + bv_dn)
               : bd_put(yl + u_fl + bv_dn, yr + u_fr + bv_dn);
  yl += u_dl * dlm_s;  yr += u_dr * dlm_s;
);

sp_live ? (
  bv_pre(yl, yr);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, sz_s);
  fdn_run(dif_l, dif_r);
  yl += fdn_l * 0.55 * spm_s;  yr += fdn_r * 0.55 * spm_s;
);

eq_l1 += (yl - eq_l1) * eq_lc;  eq_h1 += (yl - eq_h1) * eq_hc;
eq_r1 += (yr - eq_r1) * eq_lc;  eq_g1 += (yr - eq_g1) * eq_hc;
yl += eq_l1 * eql_s + (yl - eq_h1) * eqh_s;
yr += eq_r1 * eql_s + (yr - eq_g1) * eqh_s;

dc_ol = yl - dc_qol + dc_r * dc_ol;  dc_qol = yl;  yl = dc_ol;
dc_or = yr - dc_qor + dc_r * dc_or;  dc_qor = yr;  yr = dc_or;
cp_s += (cp_t - cp_s) * smk;
(cp_t || cp_s > 0.0001) ? (
  cpg_s += (cpg_t - cpg_s) * smk;
  cp_ml += (yl * yl - cp_ml) * cp_rms;  cp_mr += (yr * yr - cp_mr) * cp_rms;
  cp_lv = 10 * log10(0.5 * (cp_ml + cp_mr) + 0.0000000001);
  cp_e = cp_smooth(cp_curve(cp_lv), cp_e);
  u_cg = 10 ^ (cp_e / 20) * cpg_s;
  yl += (yl * u_cg - yl) * cp_s;  yr += (yr * u_cg - yr) * cp_s;
) : ( cp_s = 0;  cp_e = 0;  cp_ml = cp_mr = 0; );
(ffat_t > 0 || ffat_s > 0.0001) ? (
  ffat_s += (ffat_t - ffat_s) * smk;
  cn = ffat_s / 10;  ff_thr = -32 * cn;  ff_sl = 1 - 1 / (1 + 5 * cn);  ff_mk = -ff_thr * ff_sl * 0.5;
  u_cl = max(abs(yl), abs(yr));
  u_cdb = u_cl > 0.000001 ? 20 * log10(u_cl) : -120;
  u_ov = u_cdb - ff_thr;
  u_cg = u_ov <= -3 ? 0 : u_ov >= 3 ? u_ov * ff_sl : ff_sl * sqr(u_ov + 3) / 12;
  grs += (u_cg - grs) * (u_cg > grs ? ffc_att : ffc_rel);
  u_cg = 10 ^ ((ff_mk - grs) / 20);
  yl *= u_cg;  yr *= u_cg;
) : ( grs = 0;  ffat_s = 0; );
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();
@gfx 900 400
ui_begin(900, 400);
v5_begin();
KXF = 0x262624; KXB = 0x0E0D0B; KXI = 0xECE8DC; KXH = 0x1A1608; KXV = 0xFFD21E; KXA = 0xFFB030; KXY = 0xFFD21E;
sc != kx_fsc ? (
  kx_fsc = sc;
  kx_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  kx_f6 = ui_fitfont(6, 26 * sc);
);
function kx_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * kx_kt * sc, 'b'); );
function kx_fc(px) ( gfx_setfont(12, "Courier New", px * kx_kt * sc, 'b'); );
function kx_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kx_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kx_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function kx_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function kx_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A8D90); v5_d(x, y, 4); ui_col(0xBCBEC0); v5_d(x - 0.8, y - 0.8, 2.4); );
function kx_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.12); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.16)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
);
KXIN = ui_mix(KXF, 0, 0.34);
function kx_pocket(x, y, w, h) ( kx_cham(x, y, w, h, 3, KXF); ui_col(KXIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function kx_title(x, y, s) ( kx_ft(17); ui_col(KXY); kx_tl(x, y, s); );
function kx_hover(cx, cy, fs) ( kx_hon = 1; kx_hx = cx; kx_hy = cy; kx_hfs = fs; );
function kx_note(n) local(k) (
  k = (n | 0) % 12;
  #kx_nn = k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "Eb" : k == 4 ? "E" : k == 5 ? "F" : k == 6 ? "F#" : k == 7 ? "G" : k == 8 ? "Ab" : k == 9 ? "A" : k == 10 ? "Bb" : "B";
  sprintf(#kx_no, "%d", floor((n | 0) / 12) - 1); strcat(#kx_nn, #kx_no);
  #kx_nn;
);
function kx_fmt(idx) local(v) (
  v = slider(idx);
  idx == 5 || idx == 32 ? sprintf(#kx_hv, "%+d st", v)
  : idx == 6 || idx == 33 || idx == 36 ? sprintf(#kx_hv, "%.1f c", v)
  : idx == 31 ? strcpy(#kx_hv, kx_note(v))
  : idx == 34 ? sprintf(#kx_hv, "%+.2f oct", v)
  : idx == 37 ? ( v < 1 ? strcpy(#kx_hv, "OFF") : sprintf(#kx_hv, "%d ms", v); )
  : idx == 16 || idx == 17 || idx == 19 || idx == 20 || idx == 21 || idx == 23 ? ( v < 10 ? sprintf(#kx_hv, "%.1f ms", v) : v < 1000 ? sprintf(#kx_hv, "%d ms", v) : sprintf(#kx_hv, "%.2f s", v / 1000); )
  : idx == 18 || idx == 22 ? sprintf(#kx_hv, "%d %%", v)
  : idx == 39 ? sprintf(#kx_hv, "%.2f Hz", v)
  : idx == 56 ? sprintf(#kx_hv, "%+.1f dB", v)
  : sprintf(#kx_hv, "%d %%", v * 100 + 0.5);
);
function kx_dial(cx, cy, r, idx, lo, hi, def, lg, lbl, ptr, fs, bip) local(n, a, i, t, rs) (
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 8), 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(0xC8C6BE); t = -0.75 * $pi; v5_d(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_d(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  bip ? ( kx_ft(11); ui_col(0xC8C6BE); v5_t(cx, cy - rs - 3, "0"); );
  v5_shc(cx, cy, r);
  ui_col(0x141413); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30302E); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xBDB49E); v5_d(cx, cy, r * 0.74);
  ui_col(kx_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  ui_cola(0xFFFFFF, 0.5); v5_arc(cx, cy, r * 0.58, -1.9, -0.5, 1.2);
  v5_pdot(cx, cy, a, r * 0.70, ptr);
  v5_act ? ( kx_fmt(idx); kx_hover(cx, cy + r + 19, fs); ) : ( kx_ft(fs); ui_col(KXI); v5_t(cx, cy + r + 19, lbl); );
);
function kx_grey(x, y, w, h) ( ui_cola(KXIN, 0.58); v5_r(x, y, w, h); );
function kx_led(x, y, c, g) local(i) (
  ui_col(0x050505); v5_d(x, y, 5.5);
  ui_col(ui_mix(c, 0x101010, 0.78)); v5_d(x, y, 4);
  g > 0.01 ? (
    i = 0; loop(5, ui_cola(c, 0.07 * g); v5_d(x, y, 4 + 2.2 * (5 - i)); i += 1; );
    ui_cola(c, g); v5_d(x, y, 4);
    ui_cola(ui_mix(c, 0xFFFFFF, 0.6), 0.85 * g); v5_d(x - 1, y - 1.2, 1.6);
  );
);
function kx_menu(x, y, w, h, idx, n, labels) local(cur, i, k) (
  cur = max(0, min(n - 1, slider(idx) | 0));
  ui_col(0x050505); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(0x151412); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.4); v5_r(x + 1, y + 1, w - 2, 2);
  kx_fc(15); ui_col(0xFFC23A); v5_t(x + (w - 12) / 2, y + h / 2 + 1, v5_part(labels, cur));
  gfx_triangle((x + w - 14) * sc, (y + h / 2 - 2.5) * sc, (x + w - 6) * sc, (y + h / 2 - 2.5) * sc, (x + w - 10) * sc, (y + h / 2 + 2.5) * sc);
  v5_pr && v5_drag == 0 && v5_hit(x, y, w, h) ? (
    v5_drag = -1; strcpy(#kx_mm, ""); i = 0;
    loop(n, i == cur ? strcat(#kx_mm, "!"); strcat(#kx_mm, v5_part(labels, i)); i < n - 1 ? strcat(#kx_mm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h + 2) * sc; k = gfx_showmenu(#kx_mm);
    k > 0 ? ( slider(idx) = k - 1; ui_auto(idx); );
  );
);
function kx_sel(x, y, w, h, gap, idx, n, labels) local(k, kx, cur) (
  cur = max(0, min(n - 1, slider(idx) | 0));
  k = 0;
  loop(n, kx = x + k * (w + gap);
    v5_pr && v5_drag == 0 && v5_hit(kx, y, w, h) && cur != k ? ( slider(idx) = k; ui_auto(idx); cur = k; v5_drag = -1; );
    v5_keycap(kx, y, w, h, k == cur, 0xCFC6AE, 0xE6DEC6, 0x2B2620, v5_part(labels, k), -1);
    kx_led(kx + w / 2, y + h + 10, KXA, k == cur);
    k += 1; );
);
function kx_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050505); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x1A1A1A); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  c0 = ui_mix(0x9EA49A, 0xC6CCBF, 0.44); c1 = 0xC6CCBF; c2 = ui_mix(0x9EA49A, 0xC6CCBF, 0.16);
  kx_grad(x, y, w, h * 0.4, c0, c1); kx_grad(x, y + h * 0.4, w, h * 0.6, c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function kx_arrkey(x, y, w, h, dir) local(cx, cy) (
  v5_keycap(x, y, w, h, 0, 0x3A3E41, 0x4A4F53, v5_cr, "", -1);
  cx = x + w / 2; cy = y + h * 0.42; ui_col(v5_cr);
  dir < 0 ? gfx_triangle((cx - 5.5) * sc, cy * sc, (cx + 3.5) * sc, (cy - 5.5) * sc, (cx + 3.5) * sc, (cy + 5.5) * sc)
          : gfx_triangle((cx + 5.5) * sc, cy * sc, (cx - 3.5) * sc, (cy - 5.5) * sc, (cx - 3.5) * sc, (cy + 5.5) * sc);
);
function kx_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#kx_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 38, 34) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
  v5_pr && v5_drag == 0 && v5_hit(x + 42, y, 38, 34) ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; v5_drag = -1; );
  kx_arrkey(x, y, 38, 34, -1); kx_arrkey(x + 42, y, 38, 34, 1);
  gx = x + 90; kx_glass(gx, y + 3, w - 90, 28);
  cur >= 1 && cur <= n ? pk_pitem(#kx_pm, cur, #kx_pl) : strcpy(#kx_pl, "--");
  kx_fc(18); ui_col(0x15180F); kx_tl(gx + 10, y + 17.5, #kx_pl);
  v5_pr && v5_drag == 0 && v5_hit(gx, y + 3, w - 90, 28) ? ( open = 1; v5_drag = -1; );
  open ? (
    strcpy(#kx_pmm, ""); i = 1;
    loop(n, i == cur ? strcat(#kx_pmm, "!"); strcat(#kx_pmm, pk_pitem(#kx_pm, i, #kx_pt)); i < n ? strcat(#kx_pmm, "|"); i += 1; );
    gfx_x = gx * sc; gfx_y = (y + 36) * sc; i = gfx_showmenu(#kx_pmm); i > 0 ? sel = i;
  );
  sel;
);
