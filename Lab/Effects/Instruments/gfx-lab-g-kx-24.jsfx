g_r = (o2oct < 0.5 ? 0.5 : o2oct < 1.5 ? 1 : 2) / (o1oct < 0.5 ? 0.5 : o1oct < 1.5 ? 1 : 2) * 2 ^ ((o2int + o2det * 0.01) / 12);
g_mx = 0.001;  g_j = 0;  g_n = 150;
loop(g_n + 1,
  g_p = g_j / g_n * 2;
  g_v = mix1 * g_wave(o1wave, g_p) + mix2 * g_wave(o2wave, g_p * g_r);
  g_mx = max(g_mx, abs(g_v));  g_j += 1;
);
col(C_LCDTX, 1);  g_j = 0;
loop(g_n + 1,
  g_p = g_j / g_n * 2;
  g_v = mix1 * g_wave(o1wave, g_p) + mix2 * g_wave(o2wave, g_p * g_r);
  g_xx = px(674 + g_j / g_n * 208);  g_yy = py(g_ym - g_v / g_mx * 22);
  g_j > 0 ? gfx_line(g_xp, g_yp, g_xx, g_yy, 1);
  g_xp = g_xx;  g_yp = g_yy;  g_j += 1;
);
