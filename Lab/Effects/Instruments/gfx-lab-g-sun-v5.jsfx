  on;
);
function av_sqv(x, y, s, on, lg) local(r) (
  r = v5_pr && v5_drag == 0 && v5_hit(x, y, s, s) ? ( v5_drag = -1; 1; ) : 0;
  v5_edge(x, y, s, s, on, lg, AVA);
  r;
);
function av_lamp(x, y, s, on, lg, col) local(r, i, lens) (
  r = v5_pr && v5_drag == 0 && v5_hit(x - 3, y - 3, s + 6, s + 6) ? ( v5_drag = -1; 1; ) : 0;
  on ? ( ui_cola(col, 0.12); v5_rr(x - 7, y - 7, s + 14, s + 14, 8); ui_cola(col, 0.2); v5_rr(x - 5, y - 5, s + 10, s + 10, 6); );
  v5_shr(x - 3, y - 3, s + 6, s + 6, 4);
  ui_col(0x070808); v5_rr(x - 3, y - 3, s + 6, s + 6, 4);
  ui_col(0x26292B); v5_rr(x - 2, y - 2, s + 4, s + 4, 3);
  ui_col(0x0C0D0E); v5_rr(x, y, s, s, 2);
  on ? (
    ui_col(col); v5_rr(x + 1, y + 1, s - 2, s - 2, 2);
    i = 1; loop(4, ui_col(ui_mix(col, 0xFFFFFF, 0.08 * i)); v5_rr(x + 1 + i * s * 0.07, y + 1 + i * s * 0.06, s - 2 - i * s * 0.14, s - 2 - i * s * 0.12, 2); i += 1; );
    ui_cola(0xFFFFFF, 0.4); v5_r(x + 3, y + 2, s - 6, 1);
  ) : (
    lens = ui_mix(ui_mix(col, 0xCFC9BC, 0.5), 0x101213, 0.62);
    ui_col(ui_mix(lens, 0, 0.3)); v5_rr(x + 1, y + 1, s - 2, s - 2, 2);
    ui_col(lens); v5_rr(x + 3, y + 3, s - 6, s - 6, 2);
    ui_cola(0xFFFFFF, 0.12); v5_r(x + 3, y + 2, s - 6, 1);
  );
  gfx_setfont(v5_fk); ui_col(on ? ui_mix(col, 0, 0.72) : ui_mix(col, 0x0A0B0B, 0.85)); v5_t(x + s / 2, y + s / 2 + 0.5, lg);
  r;
);
function av_rings(x, cy, n, r, sp, col) local(i, cx) (
  i = 0; loop(n, cx = x + r + i * sp;
    ui_col(col); gfx_circle(cx * sc, cy * sc, r * sc, 0, 1); gfx_circle(cx * sc, cy * sc, (r - 0.5) * sc, 0, 1);
    i += 1; );
);
function av_mcs(cx, cy, r) local(t, rs) (
  av_ft(12); ui_col(ui_mix(AVI, AVIN, 0.2));
  v5_t(cx - r - 14, cy + r - 1, "M"); v5_t(cx + r + 14, cy + r - 1, "S");
  ui_col(AVDOT); v5_sd(cx, cy - r - 7, 1.7);
);
function av_grey(x, y, w, h) ( ui_cola(AVIN, 0.5); v5_r(x, y, w, h); );
function av_led(x, y, c, g) local(i) (
  ui_col(0x050606); v5_d(x, y, 5.5);
  ui_col(ui_mix(c, 0x101214, 0.78)); v5_d(x, y, 4);
