  on ? ( ui_cola(0xFFB030, 0.22); v5_rr(x + 7, y + 5 + dn, 26, 15 - dn, 5); ui_col(0xFFC860); ) : ui_col(0x5E5A50);
  v5_t(x + 20, y + 12 + dn * 0.5, "IN");
