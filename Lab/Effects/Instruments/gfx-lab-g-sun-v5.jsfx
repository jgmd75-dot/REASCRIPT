  SUTL[3 * SUTLN + su_tw] = (su_tlp3 - su_h) * su_tg3 - su_x;
  su_t = su_tmn * su_tgn * su_tdk * 0.6;
  su_L += (su_t0 - su_t2) * su_t; su_R += (su_t1 - su_t3) * su_t;
);
su_tw = (su_tw + 1) & SUTLM;

su_wgn > 0.0001 ? (
  su_m = (su_L + su_R) * 0.5; su_s = (su_L - su_R) * 0.5;
  su_v3 = su_s - su_wi2; su_v1 = su_wa1 * su_wi1 + su_wa2 * su_v3; su_v2 = su_wi2 + su_wa2 * su_wi1 + su_wa3 * su_v3;
  su_wi1 = 2 * su_v1 - su_wi1; su_wi2 = 2 * su_v2 - su_wi2;
  su_s += ((su_s - su_wk * su_v1 - su_v2) * su_wgv - su_s) * su_wgn;
  su_L = su_m + su_s; su_R = su_m - su_s;
);

su_src == 1 ? (
  su_x = (spl2 + spl3) * 0.5;
  su_ph1 += (su_x - su_ph1) * su_phk; su_x -= su_ph1;
  su_pl1 += (su_x - su_pl1) * su_plk; su_pl2 += (su_pl1 - su_pl2) * su_plk;
  su_pdc -= 1;
  su_pdc <= 0 ? ( su_pdc = su_pdec; SUPD[su_pw] = su_pl2; su_pw = (su_pw + 1) & SUPDM; su_pnew += 1; );
);

pwr_out(su_L, su_R); su_L = pwr_l; su_R = pwr_r;

su_dcyl = su_L - su_dcxl + 0.9997 * su_dcyl; su_dcxl = su_L; su_L = su_dcyl;
su_dcyr = su_R - su_dcxr + 0.9997 * su_dcyr; su_dcxr = su_R; su_R = su_dcyr;

su_pcf == 1 ? ( su_pcg -= su_pcdn; su_pcg <= 0 ? ( su_pcg = 0; su_pcf = 2; ); ) :
su_pcf == 3 ? ( su_pcg += su_pcup; su_pcg >= 1 ? ( su_pcg = 1; su_pcf = 0; ); );
su_vol += (su_volt - su_vol) * su_sm;
su_L *= su_pcg * su_vol; su_R *= su_pcg * su_vol;
su_L = ostL.ost_band(su_L); su_R = ostR.ost_band(su_R);
ost_out(su_L, su_R);
spl0 = ost_l; spl1 = ost_r;
su_pk = max(su_pk, max(abs(spl0), abs(spl1)));
av_pk = max(abs(spl0), abs(spl1)); av_pk > av_pk_d ? av_pk_d = av_pk;

@gfx 900 400
AVPF = 0xB09460; AVB = 0x24180C; AVI = 0xFBF2DE; AVH0 = 0x1E140A; AVV = 0xFFD060; AVA = 0xFFB12E; AVM = 0xFFB12E; AVDOT = 0xF0E2C2;
AVPF = 0xC4B085; AVINX = 0xCEBC94; AVI = 0x2C1C0D; AVDOT = 0x4A3420; AVTD = 0.55; AVB = 0x3A2614;
AVS1 = 0xFFE27A; AVS2 = 0xFFB12E; AVS3 = 0xF2742A;
#av_title = "THE SUN"; #av_sub1 = "SOLAR"; #av_num = "XIX"; AVEM = 2; #av_sub2 = "DRONE";
#av_pm = "Init|Dawn Raga|Midday Radiance|Saffron Drone|Corona|Solar Wind|Bhairav Morning|Golden Hour|Seven Rays|Zenith|Sunset Kafi|Eternal Noon";
ui_begin(900, 400);
v5_begin();
sc != av_fsc ? (
  av_fsc = sc;
  av_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  av_f6 = ui_fitfont(6, 24 * sc);
);
function av_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * av_kt * sc, 'b'); );
function av_fc(px) ( gfx_setfont(12, "Courier New", px * av_kt * sc, 'b'); );
function av_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function av_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function av_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function av_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function av_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function av_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(ui_mix(f, 0, 0.10 + d * 0.012)); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
AVIN = AVINX > 0 ? AVINX : ui_mix(ui_mix(AVPF, 0, 0.10), 0, 0.42);
function av_pocket(x, y, w, h) ( av_cham(x, y, w, h, 3, AVPF); ui_col(AVIN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function av_hover(cx, cy, fs) ( av_hon = 1; av_hx = cx; av_hy = cy; av_hfs = fs; );
function av_title(x, y, s, c) local(tw, th, x0, y0, i, n) (
  av_ft(16); gfx_measurestr(s, tw, th);
  x0 = floor(x * sc); y0 = floor(y * sc - th * 0.5);
  ui_col(AVI); gfx_x = x0; gfx_y = y0; gfx_drawstr(s);
  n = ceil(th) + 2;
  gfx_dest = 60; gfx_setimgdim(60, ceil(tw) + 4, n);
  ui_col(AVIN); gfx_rect(0, 0, ceil(tw) + 4, n);
  ui_col(AVTD > 0 ? ui_mix(c, 0, AVTD) : ui_mix(c, 0, 0.3)); gfx_x = 2; gfx_y = 1; gfx_drawstr(s);
  gfx_dest = -1; gfx_mode = 2;
  i = 0; loop(n,
    gfx_a = min(1, max(0, (i - n * 0.1) / (n * 0.55)));
    gfx_blit(60, 1, 0, 0, i, ceil(tw) + 4, 1, x0 - 2, y0 - 1 + i, ceil(tw) + 4, 1);
    i += 1;
  );
  gfx_mode = 0; gfx_a = 1;
);
function av_lab(x, cy, s) ( av_ft(14); ui_col(ui_mix(AVI, AVIN, 0.25)); av_tl(x, cy, s); );
function av_labc(cx, cy, s) ( av_ft(14); ui_col(ui_mix(AVI, AVIN, 0.25)); v5_t(cx, cy, s); );
function av_ms(v) ( v < 10 ? sprintf(#av_hv, "%.1f ms", v) : v < 1000 ? sprintf(#av_hv, "%d ms", v + 0.5) : sprintf(#av_hv, "%.2f s", v / 1000); );
function av_fmt(idx) local(v, m, f) (
  v = slider(idx); m = floor(v + 0.5); f = AVF[idx];
  f == 1 ? av_ms(v) :
  f == 14 ? ( v >= AVH[idx] - 0.5 ? strcpy(#av_hv, "HOLD") : av_ms(v); ) :
  f == 2 ? ( v >= 1000 ? sprintf(#av_hv, "%.2f kHz", v / 1000) : v < 1 ? sprintf(#av_hv, "%.2f Hz", v) : v < 20 ? sprintf(#av_hv, "%.1f Hz", v) : sprintf(#av_hv, "%d Hz", m); ) :
  f == 3 ? sprintf(#av_hv, "%+d st", m) :
  f == 12 ? sprintf(#av_hv, "%+.2f st", v) :
  f == 4 ? sprintf(#av_hv, "%+.1f c", v) :
  f == 5 ? sprintf(#av_hv, "%+.1f dB", v) :
  f == 6 ? sprintf(#av_hv, "%.2f s", v) :
  f == 7 ? sprintf(#av_hv, "%.2f", v) :
  f == 8 ? sprintf(#av_hv, "%d", m) :
  f == 10 ? sprintf(#av_hv, "%+d", m) :
  f == 11 ? sprintf(#av_hv, "%d DEG", m) :
  f == 13 ? sprintf(#av_hv, "%+.2f", v) :
  f == 15 ? sprintf(#av_hv, "%+d %%", m) :
  f == 16 ? sprintf(#av_hv, "%+d %%", m - 100) :
  f == 9 ? strcpy(#av_hv, v5_part(av_enl, m)) :
  sprintf(#av_hv, "%d %%", m);
);
function av_dial(cx, cy, r, idx, lbl, fs) local(n, a, i, t, rs, dm) (
  dm = av_dim; av_dim = 0;
  AVS[idx] > 0 ? v5_step = AVS[idx];
  n = v5_ctl(idx, AVL[idx], AVH[idx], AVD[idx], AVG[idx], v5_hitc(cx, cy, r + 8) && !av_lock, 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(AVDOT); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  v5_shc(cx, cy, r);
  ui_col(0x16141A); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x34303A); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(ui_mix(av_cc, 0, 0.35)); v5_d(cx, cy, r * 0.74);
  ui_col(dm ? ui_mix(av_cc, AVIN, 0.55) : av_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, ((av_cc >> 16) & 255) * 0.3 + ((av_cc >> 8) & 255) * 0.59 + (av_cc & 255) * 0.11 < 100 ? 0xEDE3CC : 0x2A2430);
  v5_act && !av_lock ? ( av_fmt(idx); av_hover(cx, cy + r + 19, fs); ) : ( av_ft(fs); ui_col(dm ? ui_mix(AVI, AVIN, 0.55) : AVI); v5_t(cx, cy + r + 19, lbl); );
  av_lock = 0;
);
function av_d(cx, cy, idx, lbl) ( av_dial(cx, cy, 15, idx, lbl, 14); );
function av_menu(x, y, w, h, idx, n, labels, mnu) local(cur, i, k, en, ik) (
  en = !av_dim; av_dim = 0;
  cur = max(0, min(n - 1, slider(idx) | 0));
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(0x141615); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.4); v5_r(x + 1, y + 1, w - 2, 2);
  ik = en ? 0xFFB347 : 0x6A5A40;
  v5_part(labels, cur); av_fc(15); av_tw(#v5_pt) > w - 22 ? av_fc(13); ui_col(ik); v5_t(x + (w - 12) / 2, y + h / 2 + 1, #v5_pt);
  ui_col(ik); gfx_triangle((x + w - 13) * sc, (y + h / 2 - 2.5) * sc, (x + w - 5) * sc, (y + h / 2 - 2.5) * sc, (x + w - 9) * sc, (y + h / 2 + 2.5) * sc);
  v5_pr && v5_drag == 0 && v5_hit(x, y, w, h) ? (
    v5_drag = -1; strcpy(#av_mm, ""); i = 0;
    loop(n, i == cur ? strcat(#av_mm, "!"); strcat(#av_mm, v5_part(mnu, i)); i < n - 1 ? strcat(#av_mm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h + 2) * sc; k = gfx_showmenu(#av_mm);
    k > 0 ? ( slider(idx) = k - 1; ui_auto(idx); );
  );
  v5_hit(x, y, w, h) && mouse_wheel != 0 && v5_drag == 0 ? (
    slider(idx) = max(0, min(n - 1, cur - sign(mouse_wheel))); ui_auto(idx); mouse_wheel = 0;
  );
);
function av_mlab(cx, y, w, s) ( av_ft(13); ui_col(ui_mix(AVI, AVIN, 0.25)); v5_t(cx + w / 2, y - 11, s); );
function av_lowpro(x, y, w, h, dn, lg) (
  ui_cola(0, 0.28); v5_rr(x - 3, y - 3, w + 6, h + 6, 5);
  ui_cola(0xFFFFFF, 0.10); v5_r(x - 1, y + h + 2, w + 2, 1); v5_r(x + w + 2, y, 1, h + 1);
  ui_col(0x0A0B0B); v5_rr(x, y, w, h, 3);
  ui_col(dn ? 0x25282A : 0x2F3335); v5_rr(x + 1, y + 1, w - 2, h - 2, 3);
  ui_cola(0, 0.4); v5_r(x + 2, y + 1, w - 4, 2); v5_r(x + 1, y + 2, 2, h - 4);
  dn ? ( ui_cola(v5_led, 0.22); v5_r(x + 6, y + h - 7, w - 12, 4); ui_col(v5_led); v5_r(x + 8, y + h - 6, w - 16, 2); )
     : ( ui_col(ui_mix(v5_led, 0x0A0B0B, 0.8)); v5_r(x + 8, y + h - 6, w - 16, 2); );
  gfx_setfont(v5_fk); ui_col(dn ? 0xF6F8F4 : v5_cr); v5_t(x + w / 2, y + (h - 6) / 2 + 1, lg);
);
function av_tog(x, y, w, h, idx, lg) local(on) (
  on = v5_toggle(idx, v5_hit(x, y, w, h));
  v5_led = AVA; av_lp ? av_lowpro(x, y, w, h, on, lg) : v5_strip(x, y, w, h, on, lg);
  on;
);
function av_sel(x, y, w, h, gap, idx, n, labels) local(k, kx, cur) (
  cur = floor(slider(idx) + 0.5); k = 0; v5_led = AVA;
  loop(n, kx = x + k * (w + gap);
    v5_pr && v5_drag == 0 && v5_hit(kx, y, w, h) && cur != k ? ( slider(idx) = k; ui_auto(idx); cur = k; v5_drag = -1; );
    av_lp ? av_lowpro(kx, y, w, h, k == cur, v5_part(labels, k)) : v5_strip(kx, y, w, h, k == cur, v5_part(labels, k));
    k += 1; );
);
function av_vsel(x, y, w, h, gap, v, n, labels) local(k, kx, r) (
  r = -1; k = 0; v5_led = AVA;
  loop(n, kx = x + k * (w + gap);
    v5_pr && v5_drag == 0 && v5_hit(kx, y, w, h) ? ( r = k; v5_drag = -1; );
    av_lp ? av_lowpro(kx, y, w, h, k == v, v5_part(labels, k)) : v5_strip(kx, y, w, h, k == v, v5_part(labels, k));
    k += 1; );
  r;
);
function av_fate(x, y, idx) local(on, nv) (
  nv = AVD[idx];
  on = slider(idx) >= (nv + 5) * 0.5;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 30, 30) ? ( slider(idx) = on ? 5 : nv; ui_auto(idx); on = !on; v5_drag = -1; );
  v5_edge(x, y, 30, 30, on, "", v5_rd);
);
function av_in(x, y, idx) local(on, dn) (
  on = v5_toggle(idx, v5_hit(x, y, 40, 24));
  dn = on ? 1.5 : 0;
  v5_shr(x, y, 40, 24, 4);
  ui_col(0x0A0B0B); v5_rr(x, y, 40, 24, 4);
  ui_col(on ? 0x2A2D2F : 0x323638); v5_rr(x + 1, y + 1 + dn, 38, 22 - dn, 4);
  ui_cola(0xFFFFFF, 0.08); v5_r(x + 4, y + 2 + dn, 32, 1);
