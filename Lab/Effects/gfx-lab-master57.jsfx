// ---------- OUTPUT ----------
s57_plate(730, 68, 210, 332);
s57_title(742, 76, "OUTPUT");
s57_lcol = LK_BLU; s57_key(868, 76, 60, 20, slider24 >= 0.5, "LINK") ? s57_set(24, slider24 >= 0.5 ? 0 : 1);
ms_db = 20 * log10(max(max(msa_l_d, msa_r_d), 0.0000001));
msPK.s57_arcm(742, 98, 186, 134, ms_db, -999, 3, "PEAK", "dBFS");
// L / R: a floating peak hold per side - a new peak shows at once and holds for 2 s, then floats down 3 dB a second,
// so each figure sits at that side's running peak level (compare them with LINK lit and dark); click a figure to clear
mph_tn = time_precise(); mph_dt = min(max(mph_tn - mph_tp, 0), 0.1); mph_tp = mph_tn;
msa_l_d >= mph_l ? ( mph_l = msa_l_d; mph_tl = mph_tn; ) : mph_tn - mph_tl > 2 ? mph_l *= 10 ^ (-0.15 * mph_dt);
msa_r_d >= mph_r ? ( mph_r = msa_r_d; mph_tr = mph_tn; ) : mph_tn - mph_tr > 2 ? mph_r *= 10 ^ (-0.15 * mph_dt);
pressed && (s57_hov(742, 240, 90, 26) || s57_hov(838, 240, 90, 26)) ? ( mph_l = mph_r = 0; );
sprintf(#nl_, "%+.1f", 20 * log10(max(mph_l, 0.000001))); sprintf(#nr_, "%+.1f", 20 * log10(max(mph_r, 0.000001)));
s57_nixie(742, 240, 90, 26, #nl_, mph_l > 0.00001); s57_nixie(838, 240, 90, 26, #nr_, mph_r > 0.00001);
s57_small(742, 270, "L"); s57_small(838, 270, "R");
msa_l_d *= 0.7; msa_r_d *= 0.7;
