gfx_setfont(13); ui_col(S57_INK); s57_t(32, 300, "ELLIPTICAL  (MONO BASS)");
ck_font = 10; m_ = 0; loop(4, ck_key(32 + m_ * 50, 316, 46, 22, slider7 == m_, m_ == 0 ? "OFF" : m_ == 1 ? "70" : m_ == 2 ? "150" : "300") ? s57_set(7, m_); m_ += 1; );
