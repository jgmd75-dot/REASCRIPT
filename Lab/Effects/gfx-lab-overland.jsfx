desc: GFX Lab Overland [drive]
//author: JGWizrad / Garden FX (GFX)
//
// Overland — a go-anywhere drive and weight processor. Mood: an 80s Japanese 4WD
// camper van (two-tone paint, triple pinstripe, slanted decals). Brand names of
// any reference vehicle stay out of the panel and the FX list.
//
// DRIVE runs two parallel layers that trade places as it rises:
//   A  the TRANSFER layer, a wide soft curve (up to +15 dB):
//      2H  one gentle stage, whole signal (warmth, thickening)
//      4H  four bands (150 / 1.2k / 5k), each driven on its own, summed
//      3L  low range for hill climbs: lows driven harder with slow heavy glue and
//          a little sub-octave, the top driven lightly
//      (TRANSFER switches crossfade over ~20 ms)
//   B  HEAD, the GFX Head tape stage: tight-bias tanh at 2x, emphasis / de-
//      emphasis, head bump, gap loss; as DRIVE rises more of the low end skips
//      the curve, a high-pass tightens what it saturates and a high shelf opens
//      the top. Its VOICE follows the livery (warm NORMAL, balanced MEDIUM,
//      bright BRIGHT).
//   The blend moves from A towards HEAD as DRIVE rises, and A is driven less as
//   HEAD takes over: tape density instead of more fuzz. Both are level-matched at
//   -12 dBFS (DRIVE changes the character, not the loudness).
//   Warm liveries: the low-pass comes down as DRIVE rises (to ~5 kHz).
//   Bright liveries: width and a left / right detune grow with DRIVE.
// LIFT      ground clearance: trims mud below ~150 Hz (pre-drive) and adds a
//           high shelf at 6 kHz (post-drive)
// TERRAIN   tarmac to rough track: slow wobble in pitch and level; above half
//           way, a little grit on the top end's transients
// DIFF LOCK everything below ~120 Hz to mono
// FOG       a warm haze: low-pass at 6.5 kHz with a touch of blur
// LIVERY    the paint has a sound: darker liveries lift the highs less, saturate
//           the lows more (asymmetric) and narrow slightly; lighter liveries do
//           the opposite and widen. Changes glide.
// OUTPUT DECKS (from TRIMD, at 1x): RACK (warm: weighty flat 4:1 limiter, mids into
//   a knee clipper and back), MASTER (balanced: clean peak clamp, detector ignores
//   the sub-bass, wide soft knee, faint top rounding), AIR (bright: air into a soft
//   knee, phase-dispersed tops, side widened above 2.5 kHz as it works). Blended by
//   the livery's lightness; pushed a little harder with DRIVE. They keep the
//   wooliness under control.
// 4WD / 2WD (the plate): 4WD = every saturation stage anti-aliased (HEAD at 2x, ADAA on
//   the TRANSFER curves, the grit and the decks' clippers); 2WD = all at 1x with plain
//   curves: lighter on the CPU, a rawer top with a little aliasing fizz. The switch dips
//   the output for ~5 ms (the oversampling filters change the timing).
// Output: house output stage, CLIP always on (-0.3 dBFS). Latency: 1.5 ms
// (TERRAIN's wobble delay, always in the path so it never jumps).
//
// STATUS: Lab (experimental, may change). v0.1.

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc

slider1:drive=4<0,10,0.1>-Drive
slider2:lift=3<0,10,0.1>-Lift
slider3:terrain=2<0,10,0.1>-Terrain
slider4:xfer=1<0,2,1{2H,4H,3L}>-Transfer
slider5:diff=0<0,1,1{Open,Locked}>-Diff Lock
slider6:fog=0<0,1,1{Off,On}>-Fog
slider7:out_db=0<-12,12,0.1>-Output (dB)
slider8:livery=3<0,7,1{Toy Teal,Sage,Desert Tan,Alpine Blue,Alpine Cream,Midnight Gold,Sunset Bronze,Bottle Green}>-Livery
slider9:wd=1<0,1,1{2WD,4WD}>-Drive (4WD = anti-aliased)

@init
ext_noinit = 1;
gfx_ext_retina = 1;
pr_cur = 1;              // preset shown on the LCD (saved with the project)
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();

// ---------- memory map ----------
LV = 0;          // liveries, 6 per entry (0..47)
BF = 100;  BE = 200;  ST = 300;  vb_m = 400;      // visualiser (vb_m: GUI only)
CO = 500;        // SVF coefficient sets, 6 each (a1 a2 a3 m0 m1 m2)
SL = 700;  SR = 800;                               // filter states per channel, 2 per filter
DLB = 1000;  DRB = 9000;  DSZ = 8192;              // TERRAIN delay lines

// liveries: upper, lower, stripe a, stripe b (accent), wheel (unused), decal
function lv_set(i, up, lo, sa, sb, wh, dc) ( LV[i * 6] = up; LV[i * 6 + 1] = lo; LV[i * 6 + 2] = sa; LV[i * 6 + 3] = sb; LV[i * 6 + 4] = wh; LV[i * 6 + 5] = dc; );
// liveries in order, brightest -> warmest (the lightness that also sets each one's sound)
lv_set(0, 0x2FA7B6, 0xD7DBDB, 0x1E2A31, 0x1E2A31, 0x1C1C1C, 0x1E2A31);
lv_set(1, 0xA7B8A8, 0x9DAE9E, 0x2C3830, 0x55705E, 0x1C1C1C, 0x2C3830);
lv_set(2, 0xCBA676, 0xBF9A69, 0x5E3F24, 0xE8CDA0, 0x1C1C1C, 0x5E3F24);
lv_set(3, 0x6F8299, 0xC9CCCB, 0x2C333D, 0xC85A38, 0xDCDCD6, 0x2C333D);
lv_set(4, 0xE8E3D3, 0x3F5C40, 0x8E3029, 0xE8E3D3, 0xD0D0CA, 0xE8E3D3);
lv_set(5, 0x222A39, 0xB9AB8C, 0xE0D2AA, 0xB4562E, 0xC8C8C2, 0x222A39);
lv_set(6, 0x3B2F27, 0x8C6C4F, 0xE09A55, 0xD8BE7A, 0xC8C8C2, 0xE09A55);
lv_set(7, 0x2F4B37, 0x2A4532, 0xC9A23F, 0xC9A23F, 0x1C1C1C, 0xC9A23F);

// =====================================================================
// DSP building blocks
// =====================================================================
function db2g(d) ( exp(d * 0.11512925464970228); );
function tg(f) ( tan($pi * min(f, srate * 0.45) / srate); );
function lv_lum(c) ( (0.3 * floor(c / 65536) + 0.59 * (floor(c / 256) % 256) + 0.11 * (c % 256)) / 255; );

// coefficient sets for a shared-coefficient SVF (Cytomic): y = m0 x + m1 v1 + m2 v2
function cs_core(i, g, k) local(c) ( c = CO + i * 6;  c[0] = 1 / (1 + g * (g + k));  c[1] = g * c[0];  c[2] = g * c[1]; );
function cs_lp(i, f, q) local(c) ( cs_core(i, tg(f), 1 / q);  c = CO + i * 6;  c[3] = 0;  c[4] = 0;  c[5] = 1; );
function cs_hp(i, f, q) local(c) ( cs_core(i, tg(f), 1 / q);  c = CO + i * 6;  c[3] = 1;  c[4] = -1 / q;  c[5] = -1; );
function cs_ls(i, f, db) local(c, A) ( A = exp(db * 0.05756462732485115);  cs_core(i, tg(f) / sqrt(A), 1.41421356);
  c = CO + i * 6;  c[3] = 1;  c[4] = 1.41421356 * (A - 1);  c[5] = A * A - 1; );
function cs_hs(i, f, db) local(c, A) ( A = exp(db * 0.05756462732485115);  cs_core(i, tg(f) * sqrt(A), 1.41421356);
  c = CO + i * 6;  c[3] = A * A;  c[4] = 1.41421356 * (1 - A) * A;  c[5] = 1 - A * A; );
// one step: coefficient set i, state at s
function svc(x, i, s) local(c, v1, v2, v3) (
  c = CO + i * 6;  v3 = x - s[1];
  v1 = c[0] * s[0] + c[1] * v3;  v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
  c[3] * x + c[4] * v1 + c[5] * v2;
);

// house soft saturator with first-order ADAA (half-sample lag made up)
function sat_f(x) ( x / (1 + abs(x)); );
function sat_ad(x) ( abs(x) - log(1 + abs(x)); );
function adaa(x) instance(xp, Fp, yp) local(F, yc, d, y) (
  F = sat_ad(x);  yc = sat_f(x);  d = x - xp;
  abs(d) < 0.00001 ? ( y = sat_f(0.5 * (x + xp)); ) : ( y = (F - Fp) / d; );
  y += 0.5 * (yc - yp);
  xp = x;  Fp = F;  yp = yc;  y;
);
// a driven, biased stage, level-matched at -12 dBFS (DRIVE adds density, not level):
// out = (f(g x + b) - f(b)) * ref / (f(g ref + b) - f(b))
STG_REF = 0.25;
// (at DRIVE 0 the stage is unity for small signals instead, so it starts transparent)
function stage(x, g, b) instance(a) (
  ((aa_on ? a.adaa(x * g + b) : sat_f(x * g + b)) - sat_f(b)) * ((1 - stg_t) * sqr(1 + b) / g + stg_t * STG_REF / (sat_f(g * STG_REF + b) - sat_f(b)));
);

// ---------- RBJ biquads (per instance; fs = the rate the filter runs at) ----------
function bq_set(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs;  cw = cos(w0);  sw = sin(w0);  al = sw / (2 * q);  amp = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al;  b0 = (1 - cw) * 0.5 / n;  b1 = (1 - cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al;  b0 = (1 + cw) * 0.5 / n;  b1 = -(1 + cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / amp;  b0 = (1 + al * amp) / n;  b1 = -2 * cw / n;  b2 = (1 - al * amp) / n;  a1 = b1;  a2 = (1 - al / amp) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n;  b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n;  a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;  a2 = ((amp + 1) - (amp - 1) * cw - sa) / n; ) :
  ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) + (amp - 1) * cw + sa;                       // 4: low shelf
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n;  b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n;  a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;  a2 = ((amp + 1) + (amp - 1) * cw - sa) / n; );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;  x2 = x1;  x1 = x;  y2 = y1;  y1 = y;  y;
);

// ================= HEAD (ported from GFX Head / Headsmoother) =================
function hd_aa() instance(u1, u2, u3, u4, d1, d2, d3, d4) local(fc, fs2) (
  fs2 = 2 * srate;  fc = min(0.42 * srate, 20000);
  u1.bq_set(0, fc, 0.5098, 0, fs2);  u2.bq_set(0, fc, 0.6013, 0, fs2);  u3.bq_set(0, fc, 0.9000, 0, fs2);  u4.bq_set(0, fc, 2.5629, 0, fs2);
  d1.bq_set(0, fc, 0.5098, 0, fs2);  d2.bq_set(0, fc, 0.6013, 0, fs2);  d3.bq_set(0, fc, 0.9000, 0, fs2);  d4.bq_set(0, fc, 2.5629, 0, fs2);
);
// voicing + tape EQ, per block. Overland adds: hhp, a high-pass on what is saturated (rises with DRIVE), and hhs,
// a high shelf after the stage (opens with DRIVE)
function hd_eq(voice, hpf, hsdb) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, hhp, hhs) (
  emp.bq_set(3, 3000, 0.7, 4, srate);  dem.bq_set(3, 3000, 0.7, -4, srate);
  voice == 1 ? ( vpre.bq_set(2, 1400, 0.6, 3.5, srate);  vpost.bq_set(2, 1400, 0.6, -1.5, srate); ) :
  voice == 2 ? ( vpre.bq_set(3, 6000, 0.7, 5, srate);    vpost.bq_set(3, 6000, 0.7, -2, srate); ) :
               ( vpre.bq_set(2, 1000, 0.7, 0, srate);    vpost.bq_set(2, 1000, 0.7, 0, srate); );
  bump.bq_set(2, 70, 0.9, hd_bump, srate);
  gap.bq_set(0, voice == 2 ? 21000 : voice == 1 ? 18000 : 16000, 0.55, 0, srate);
  dcb.bq_set(1, 10, 0.7, 0, srate);
  lop.bq_set(0, 250, 0.6, 0, srate);
  hhp.bq_set(1, hpf, 0.7071, 0, srate);
  hhs.bq_set(3, 5000, 0.7, hsdb, srate);
);
// tanh with a small fixed bias ("tight bias"), level-matched at -12 dBFS
function hd_sat(x, b) local(tb) (
  tb = ost_tanh(b);
  (ost_tanh(hd_g * x + b) - tb) * hd_c;
);
function hd_run(x, b) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, hhp, hhs, u1, u2, u3, u4, d1, d2, d3, d4) local(y, z, lo) (
  lo = lop.bq_run(x) * hd_lb;                      // the part of the lows that skips the curve
  y = hhp.bq_run(vpre.bq_run(emp.bq_run(x - lo))) * 0.5;
  aa_on ? (                                        // 4WD: 2x (zero-stuffed up, filter, curve, filter, keep every second)
    z = u4.bq_run(u3.bq_run(u2.bq_run(u1.bq_run(y * 2))));
    d4.bq_run(d3.bq_run(d2.bq_run(d1.bq_run(hd_sat(z, b)))));
    z = u4.bq_run(u3.bq_run(u2.bq_run(u1.bq_run(0))));
    y = d4.bq_run(d3.bq_run(d2.bq_run(d1.bq_run(hd_sat(z, b))))) * 2;
  ) : ( y = hd_sat(y, b) * 2; );                   // 2WD: the curve at 1x
  hhs.bq_run(dcb.bq_run(gap.bq_run(bump.bq_run(vpost.bq_run(dem.bq_run(y)) + lo * hd_lg))));
);

// ================= OUTPUT DECKS (ported from TRIMD: RACK, MASTER, AIR; at 1x) =================
// m: 1 RACK, 3 MASTER, 4 AIR (TRIMD's model numbers)
// (both channels' filters are set by the same call: JSFX can't pass an instance as an argument)
function dk_pre(t, f, q, g) ( this.aL.bq_set(t, f, q, g, srate);  this.aR.bq_set(t, f, q, g, srate); );
function dk_post(t, f, q, g) ( this.bL.bq_set(t, f, q, g, srate);  this.bR.bq_set(t, f, q, g, srate); );
function dk_model(m) instance(atm, rlm, thr, rat, kh, kw0, kw1, mas, air, trim) (
  mas = m == 3;  air = m == 4;
  m == 1 ? ( atm = 3;    rlm = 180; thr = -5; rat = 0.75;  kh = 3; kw0 = 0.3; kw1 = 0.6;
             this.dk_pre(2, 700, 0.7, 2);    this.dk_post(2, 700, 0.7, -2);    trim = 10 ^ (-2.26 / 20); ) :
  m == 3 ? ( atm = 0.05; rlm = 300; thr = -2; rat = 0.95;  kh = 6; kw0 = 0.4; kw1 = 0.8;
             this.dk_pre(4, 60, 0.707, 0);   this.dk_post(3, 12000, 0.707, -0.7); trim = 10 ^ (-2.24 / 20); ) :
           ( atm = 1.5;  rlm = 150; thr = -5; rat = 0.667; kh = 4; kw0 = 0.3; kw1 = 0.6;
             this.dk_pre(3, 6000, 0.707, 3); this.dk_post(3, 6000, 0.707, -1.5);  trim = 10 ^ (-2.63 / 20); );
  this.kL.clp_set(2, 1, 0.93, 0);  this.kR.clp_set(2, 1, 0.93, 0);
);
function dk_block(ddb) instance(atm, rlm, att, rel, gd, go, trim, kw0, kw1, dv) (
  dv = min(max(ddb / 24, 0), 1);
  att = 1 - exp(-1 / (max(atm, 0.02) * 0.001 * srate));  rel = 1 - exp(-1 / (rlm * 0.001 * srate));
  gd = 10 ^ (ddb / 20);  go = trim * 10 ^ (-0.5 * ddb / 20) * dk_mk;                  // TRIMD: out follows half the drive; dk_mk evens it
  this.kL.clp_knee(kw0 + (kw1 - kw0) * dv);  this.kR.clp_knee(kw0 + (kw1 - kw0) * dv);
);
function dk_gr(e) instance(thr, rat, kh) local(o) (
  o = 20 * log10(max(e, 0.000000001)) - thr;
  o <= -kh ? 0 : o >= kh ? rat * o : rat * sqr(o + kh) / (4 * kh);
);
function dk_run(l, r) instance(att, rel, env, hsL, hsR, gd, go, mas, air, apL, apR, slp, wk, dv, ol, orr) local(pl, pr, al, ar, g, y, s, h) (
  pl = this.aL.bq_run(l * gd);  pr = this.aR.bq_run(r * gd);
  mas ? ( hsL += dk_hk * (pl - hsL);  hsR += dk_hk * (pr - hsR);  al = abs(pl - hsL);  ar = abs(pr - hsR); )
      : ( al = abs(pl);  ar = abs(pr); );
  al = max(al, ar);
  env += (al > env ? att : rel) * (al - env);
  g = 10 ^ (-this.dk_gr(env) / 20);
  ol = this.bL.bq_run(this.kL.clp_run(pl * g)) * go;
  orr = this.bR.bq_run(this.kR.clp_run(pr * g)) * go;
  air ? (
    wk = 0.25 * dv + 0.6 * (1 - g);
    y = dk_apl * ol + apL;  apL = ol - dk_apl * y;  ol = y;
    y = dk_apr * orr + apR;  apR = orr - dk_apr * y;  orr = y;
    s = 0.5 * (ol - orr);  slp += dk_slk * (s - slp);  h = (s - slp) * wk;
    ol += h;  orr -= h;
  );
);

// coefficient set indices
C_LC = 0;  C_HS = 1;  C_X1 = 2;  C_X2 = 3;  C_X3 = 4;  C_L3 = 5;  C_SUB = 6;  C_DF = 7;  C_FOG = 8;  C_GR = 9;
cs_lp(C_X1, 150, 0.70710678);  cs_lp(C_X2, 1200, 0.70710678);  cs_lp(C_X3, 5000, 0.70710678);

// one channel: LIFT (pre) -> TRANSFER (2H / 4H / 3L, crossfaded) -> TERRAIN grit -> LIFT (post) -> FOG
function ch_tick(x, sb, hb) instance(s2, s41, s42, s43, s44, s3l, s3h, sgr, env3, subff, subpv, hd, wlp)
  local(y, y2, y4, y3, b1, r1, b2, r2, b3, b4, lo, hi, gc, sb1, sub, hp, gk, f, dl, ya, yh)
(
  y = svc(x, C_LC, sb);                                         // LIFT: trim the mud
  y2 = y4 = y3 = 0;
  w2 > 0.0005 ? ( y2 = s2.stage(y, dg, 0.05 + 0.12 * lsat_s); );
  w4 > 0.0005 ? (
    b1 = svc(svc(y, C_X1, sb + 2), C_X1, sb + 4);  r1 = y - b1;   // subtractive split: the bands sum back exactly
    b2 = svc(svc(r1, C_X2, sb + 6), C_X2, sb + 8);  r2 = r1 - b2;
    b3 = svc(svc(r2, C_X3, sb + 10), C_X3, sb + 12);  b4 = r2 - b3;
    dl = dg * (1 + 0.6 * lsat_s);
    y4 = s41.stage(b1, dl, 0.04 + 0.16 * lsat_s) + s42.stage(b2, dg, 0.04) + s43.stage(b3, dg, 0.03) + s44.stage(b4, dg * 0.85, 0.02);
  );
  w3 > 0.0005 ? (
    lo = svc(svc(y, C_L3, sb + 14), C_L3, sb + 16);  hi = y - lo;
    env3 += (abs(lo) - env3) * (abs(lo) > env3 ? e3_a : e3_r);   // slow, heavy glue on the lows
    gc = 1 / (1 + env3 * dg * 0.9);
    lo = s3l.stage(lo * gc * (1 + drive_s * 0.1), dg * (1.5 + 0.6 * lsat_s), 0.08 + 0.18 * lsat_s);
    hi = s3h.stage(hi, max(1, dg * 0.45), 0.02);
    // sub-octave: a flip-flop on the low band's upward zero crossings, shaped by its level, smoothed
    sb1 = svc(lo, C_SUB, sb + 18);
    (sb1 > 0 && subpv <= 0) ? subff = -subff;  subff == 0 ? subff = 1;  subpv = sb1;
    sub = svc(subff * min(1, env3 * 2.5), C_SUB, sb + 20);
    y3 = lo + hi + sub * sub_amt;
  );
  ya = y2 * w2 + y4 * w4 + y3 * w3;
  yh = hd.hd_run(y, hb);                                         // HEAD, in parallel
  y = ya + (yh - ya) * hmix;
  // TERRAIN grit: the top end's transients roughened (only above half way)
  grit > 0 ? (
    hp = svc(y, C_GR, sb + 22);  gk = 1 + grit * 5;
    y = y - hp + (aa_on ? sgr.adaa(hp * gk) : sat_f(hp * gk)) / gk * (1 + grit * 0.6);
  );
  y = svc(y, C_HS, sb + 24);                                    // LIFT: the top shelf
  f = svc(y, C_FOG, sb + 26);  y += (f - y) * fog_w;             // FOG
  wlp_on ? ( y = wlp.bq_run(y); );                               // warm liveries: the low-pass that comes down with DRIVE
  y;
);

function update_targets() local(b) (
  b = (lv_lum(LV[livery * 6]) + lv_lum(LV[livery * 6 + 1])) * 0.5;    // the paint's lightness, 0 dark .. 1 light
  b = max(0, min(1, (b - 0.2) / 0.6));
  hsc_t  = 0.55 + 0.9 * b;          // how much air LIFT adds
  lsat_t = 1 - b;                   // extra drive + asymmetry in the lows
  wid_t  = 0.88 + 0.3 * b;          // stereo width
  drive_t = drive;  lift_t = lift;  terr_t = terrain;
  xf = floor(xfer + 0.5);  w2t = xf <= 0;  w4t = xf == 1;  w3t = xf >= 2;
  diff_t = diff;  fog_t = fog;  out_t = db2g(out_db);  wd_t = wd >= 0.5;
);

first_run = 1;
DLY = ceil(0.0015 * srate);                                     // (TERRAIN wobble 0.6 ms + detune 0.25 ms fit inside)                                     // TERRAIN's centre delay = the reported latency
sm   = 1 - exp(-1 / (0.02 * srate));                            // 20 ms glides (per sample)
wd_step = 1 / (0.0025 * srate);                                // 4WD / 2WD: 2.5 ms down, 2.5 ms up
e3_a = 1 - exp(-1 / (0.010 * srate));  e3_r = 1 - exp(-1 / (0.30 * srate));
cs_lp(C_L3, 200, 0.70710678);  cs_lp(C_SUB, 90, 0.7071);  cs_lp(C_DF, 120, 0.70710678);
cs_lp(C_FOG, 6500, 0.6);  cs_hp(C_GR, 3000, 0.7071);
dw_pos = 0;  wob_t = 0;  wob_v = 0;  wob_tgt = 0;  ph1 = 0;  ph2 = 0;
chL.hd.hd_aa();  chR.hd.hd_aa();  coef_hd = 1;  hd_lastd = -1;  wlp_last = -1;
dkR.dk_model(1);  dkM.dk_model(3);  dkA.dk_model(4);
dk_hk = 1 - exp(-2 * $pi * 90 / srate);                       // MASTER: the side-chain's sub-bass high-pass
dk_apl = (tan($pi * 4500 / srate) - 1) / (tan($pi * 4500 / srate) + 1);
dk_apr = (tan($pi * 6500 / srate) - 1) / (tan($pi * 6500 / srate) + 1);
dk_slk = 1 - exp(-2 * $pi * 2500 / srate);
// visualiser: 24 band-pass filters on the output (mono sum)
NB = 24;
function bp_set(i, f) local(g, k) ( g = tan($pi * min(f, srate * 0.45) / srate);  k = 1 / 4.3;
  BF[i * 4] = 1 / (1 + g * (g + k));  BF[i * 4 + 1] = g * BF[i * 4];  BF[i * 4 + 2] = g * BF[i * 4 + 1];  BF[i * 4 + 3] = k; );
vi = 0;  loop(NB, bp_set(vi, 40 * (400 ^ (vi / (NB - 1))));  vi += 1; );
env_r = exp(-1 / (0.12 * srate));

@slider
update_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);   // output stage: CLIP, always on
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = DLY;
first_run ? (
  drive_s = drive_t;  lift_s = lift_t;  terr_s = terr_t;  hsc_s = hsc_t;  lsat_s = lsat_t;  wid_s = wid_t;
  w2 = w2t;  w4 = w4t;  w3 = w3t;  diff_w = diff_t;  fog_w = fog_t;  out_s = out_t;
  aa_on = wd_t;  clp_aa = aa_on;  wd_fade = 1;
  first_run = 0;  coef_dirty = 1;
);

@block
// GUI edits arrive as a flag; targets are rebuilt here, on the audio thread
prm_dirty ? ( prm_dirty = 0;  update_targets(); );
// block-rate glides for what needs new filter coefficients, or the livery's signature
kb = 1 - exp(-samplesblock / (0.04 * srate));
lift_s += (lift_t - lift_s) * kb;  hsc_s += (hsc_t - hsc_s) * kb;  lsat_s += (lsat_t - lsat_s) * kb;  wid_s += (wid_t - wid_s) * kb;
drive_s += (drive_t - drive_s) * kb;  terr_s += (terr_t - terr_s) * kb;
(coef_dirty || abs(lift_s - lift_c) > 0.002 || abs(hsc_s - hsc_c) > 0.002) ? (
  cs_ls(C_LC, 150, -0.8 * lift_s);  cs_hs(C_HS, 6000, 0.5 * lift_s * hsc_s);
  lift_c = lift_s;  hsc_c = hsc_s;  coef_dirty = 0;
);
dg = db2g(drive_s * 1.5 * (1 - 0.4 * hmix));                    // layer A: up to +15 dB, less as HEAD takes over
stg_t = min(1, drive_s / 4);
dn = drive_s / 10;
hmix = 0.2 + 0.55 * dn ^ 1.2;                                  // A -> HEAD as DRIVE rises
// HEAD: drive, bias, low bypass, bump, its high-pass and high shelf, voice by livery
hd_g = 10 ^ (drive_s * 2.2 / 20);
hb_s = 0.03 + 0.07 * lsat_s;
hd_c = 0.25 / ((ost_tanh(hd_g * 0.125 + hb_s) - ost_tanh(hb_s)) - (ost_tanh(-hd_g * 0.125 + hb_s) - ost_tanh(hb_s)));
hd_lb = dn ^ 1.2;
hd_lg = sqrt(hd_g * hd_c * (1 - sqr(ost_tanh(hb_s))));
hd_bump = 1.5 * (1 - 0.5 * dn);
hvoice = lsat_s > 0.64 ? 0 : lsat_s > 0.36 ? 1 : 2;
(abs(drive_s - hd_lastd) > 0.01 || hvoice != hd_lastv || coef_hd) ? (
  chL.hd.hd_eq(hvoice, 20 + 140 * dn ^ 1.5, 4 * dn);  chR.hd.hd_eq(hvoice, 20 + 140 * dn ^ 1.5, 4 * dn);
  hd_lastd = drive_s;  hd_lastv = hvoice;  coef_hd = 0;
);
// warm: the low-pass comes down with DRIVE (to ~5 kHz at full warmth and drive)
wlp_f = 20000 * 2 ^ (-2 * lsat_s * dn);
wlp_on = wlp_f < 19000;
wlp_on && abs(wlp_f - wlp_last) > wlp_f * 0.002 ? (
  chL.wlp.bq_set(0, wlp_f, 0.6, 0, srate);  chR.wlp.bq_set(0, wlp_f, 0.6, 0, srate);  wlp_last = wlp_f;
);
// bright: width and left / right detune grow with DRIVE
brt = 1 - lsat_s;
wid_d = wid_s * (1 + 0.35 * brt * dn);
det_dep = brt * dn * 0.00025 * srate;                          // up to 0.25 ms antiphase
// output decks: drive and the livery blend (warm RACK, balanced MASTER, bright AIR)
dk_ddb = 2 + drive_s * 1.0;
// make-up: measured (pink-ish averages over liveries and TRANSFER modes) so loudness stays put as DRIVE turns
mk_i = min(4.999, dn * 5);  mk_k = floor(mk_i);  mk_f = mk_i - mk_k;
mk_a = mk_k == 0 ? 2.0 : mk_k == 1 ? 0.2 : mk_k == 2 ? -0.9 : mk_k == 3 ? -0.95 : -0.6;
mk_b = mk_k == 0 ? 0.2 : mk_k == 1 ? -0.9 : mk_k == 2 ? -0.95 : mk_k == 3 ? -0.6 : -0.1;
dk_mk = 10 ^ ((mk_a + (mk_b - mk_a) * mk_f) / 20);
dkR.dk_block(dk_ddb);  dkM.dk_block(dk_ddb);  dkA.dk_block(dk_ddb);
dwR = max(0, min(1, (lsat_s - 0.55) / 0.3));
dwA = max(0, min(1, (0.45 - lsat_s) / 0.2));
dwM = max(0, 1 - dwR - dwA);
sub_amt = drive_s * 0.035;
grit = max(0, (terr_s - 5) / 5);
// TERRAIN wobble: a smoothed random walk plus a slow sine; depth up to 0.6 ms and 0.5 dB
wob_t += samplesblock / srate;
wob_t > 0.45 ? ( wob_t = 0;  wob_tgt = rand(2) - 1; );
wob_v += (wob_tgt - wob_v) * (1 - exp(-samplesblock / (srate * 0.35)));
wob_dep = terr_s / 10 * 0.0006 * srate;
wob_amp = terr_s / 10 * 0.5;
// meters / visualiser hand-offs
vi = 0;  loop(NB, BE[50 + vi] = max(BE[50 + vi], BE[vi]);  vi += 1; );
pkL_d = max(pkL_d, pkL);  pkL = 0;  pkR_d = max(pkR_d, pkR);  pkR = 0;

@sample
w2 += (w2t - w2) * sm;  w4 += (w4t - w4) * sm;  w3 += (w3t - w3) * sm;
diff_w += (diff_t - diff_w) * sm;  fog_w += (fog_t - fog_w) * sm;  out_s += (out_t - out_s) * sm;
// 4WD / 2WD: dip, switch at the silent point, return
wd_t != aa_on ? ( wd_fade = max(0, wd_fade - wd_step);  wd_fade == 0 ? ( aa_on = wd_t;  clp_aa = aa_on; ); )
              : wd_fade < 1 ? ( wd_fade = min(1, wd_fade + wd_step); );

aL = chL.ch_tick(spl0, SL, hb_s);
aR = chR.ch_tick(spl1, SR, hb_s);

// DIFF LOCK: lows to mono
diff_w > 0.0005 ? (
  dlL = svc(svc(aL, C_DF, SL + 40), C_DF, SL + 42);
  dlR = svc(svc(aR, C_DF, SR + 40), C_DF, SR + 42);
  dm = (dlL + dlR) * 0.5;
  aL += (dm - dlL) * diff_w;  aR += (dm - dlR) * diff_w;
);
// the livery's width
mm = (aL + aR) * 0.5;  ss = (aL - aR) * 0.5 * wid_d;  aL = mm + ss;  aR = mm - ss;

// TERRAIN wobble: modulated delay (centre DLY, always in the path) + level wobble
ph1 += 2 * $pi * 0.7 / srate;  ph1 > 2 * $pi ? ph1 -= 2 * $pi;
wm = 0.65 * wob_v + 0.35 * sin(ph1);
DLB[dw_pos] = aL;  DRB[dw_pos] = aR;
ph2 += 2 * $pi * 0.33 / srate;  ph2 > 2 * $pi ? ph2 -= 2 * $pi;
dts = det_dep * sin(ph2);                                     // bright liveries: antiphase L / R detune
rd = DLY + wob_dep * wm + dts;
rp = dw_pos - rd;  rp < 0 ? rp += DSZ;
ri = floor(rp);  rf = rp - ri;  rn = ri + 1;  rn >= DSZ ? rn = 0;
aL = DLB[ri] + (DLB[rn] - DLB[ri]) * rf;
rd = DLY + wob_dep * wm - dts;
rp = dw_pos - rd;  rp < 0 ? rp += DSZ;
ri = floor(rp);  rf = rp - ri;  rn = ri + 1;  rn >= DSZ ? rn = 0;
aR = DRB[ri] + (DRB[rn] - DRB[ri]) * rf;
// output decks (TRIMD RACK / MASTER / AIR), blended by livery
dkL = dkR2 = 0;
dwR > 0.001 ? ( dkR.dk_run(aL, aR);  dkL += dkR.ol * dwR;  dkR2 += dkR.orr * dwR; );
dwM > 0.001 ? ( dkM.dk_run(aL, aR);  dkL += dkM.ol * dwM;  dkR2 += dkM.orr * dwM; );
dwA > 0.001 ? ( dkA.dk_run(aL, aR);  dkL += dkA.ol * dwA;  dkR2 += dkA.orr * dwA; );
aL = dkL;  aR = dkR2;
dw_pos += 1;  dw_pos >= DSZ ? dw_pos = 0;
lw = db2g(wob_amp * wm * 0.6);

aL = ostL.ost_band(aL) * out_s * lw * wd_fade;
aR = ostR.ost_band(aR) * out_s * lw * wd_fade;
ost_out(aL, aR);  aL = ost_l;  aR = ost_r;            // house clipper, -0.3 dBFS ceiling

pkL = max(pkL, abs(aL));  pkR = max(pkR, abs(aR));
vm = (aL + aR) * 0.5;
vi = 0;
loop(NB,
  vb = vi * 4;
  v3 = vm - ST[vi * 2 + 1];
  v1 = BF[vb] * ST[vi * 2] + BF[vb + 1] * v3;
  v2 = ST[vi * 2 + 1] + BF[vb + 1] * ST[vi * 2] + BF[vb + 2] * v3;
  ST[vi * 2] = 2 * v1 - ST[vi * 2];  ST[vi * 2 + 1] = 2 * v2 - ST[vi * 2 + 1];
  va = abs(v1 * BF[vb + 3]);
  BE[vi] = va > BE[vi] ? va : BE[vi] * env_r;
  vi += 1;
);
spl0 = aL;  spl1 = aR;

@serialize
file_var(0, pr_cur);

@gfx 1000 560
function col(h, a) ( gfx_r = floor(h / 65536) / 255; gfx_g = (floor(h / 256) % 256) / 255; gfx_b = (h % 256) / 255; gfx_a = a; );
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f)); g = min(255, floor((floor(h / 256) % 256) * f)); b = min(255, floor((h % 256) * f)); r * 65536 + g * 256 + b;
);
function mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 + floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
// a muted rainbow: 0 = red .. 1 = violet
function hue(t) local(h, r, g, b, f) (
  h = t * 5;  f = h - floor(h);
  h < 1 ? ( r = 1; g = f; b = 0; ) : h < 2 ? ( r = 1 - f; g = 1; b = 0; ) : h < 3 ? ( r = 0; g = 1; b = f; ) :
  h < 4 ? ( r = 0; g = 1 - f; b = 1; ) : ( r = f * 0.6; g = 0; b = 1; );
  floor((0.25 + 0.68 * r) * 255) * 65536 + floor((0.25 + 0.62 * g) * 255) * 256 + floor((0.3 + 0.62 * b) * 255);
);
function lum(c) ( 0.3 * floor(c / 65536) + 0.59 * (floor(c / 256) % 256) + 0.11 * (c % 256); );
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h); gfx_x = x - w * 0.5; gfx_y = y - h * 0.5; gfx_drawstr(str); );
function rr(x, y, w, h, r) local(i, d, ins) (
  x = floor(px(x) + 0.5); y = floor(py(y) + 0.5); w = floor(ps(w) + 0.5); h = floor(ps(h) + 0.5);
  r = min(floor(ps(r) + 0.5), floor(min(w, h) * 0.5)); i = 0;
  loop(r, d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1); gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1); i += 1; );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );

// 80s dash knob: black cylinder with a knurled skirt, satin top, a pointer line in the
// livery's accent colour; soft shadow below-right. Value tag on hover only.
function dknob(cx, cy, r, idx, vmin, vmax, def, lbl, fmt) local(x, y, R, v, t, hov, a0, a1, tv, j, b, w, h, ty) (
  x = px(cx); y = py(cy); R = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(R * 1.15);
  v = slider(idx); t = (v - vmin) / (vmax - vmin);
  click && hov ? ( (mouse_cap & 4) ? ( slider(idx) = def; param_touched(idx); ) : ( drag_idx = idx; drag_y = mouse_y; drag_t = t; ); );
  drag_idx == idx ? ( t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps(220))); slider(idx) = vmin + t * (vmax - vmin); param_touched(idx); );
  v = slider(idx); t = (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi; a1 = 0.75 * $pi; tv = a0 + t * (a1 - a0);
  // scale ticks, painted in the label colour
  col(lbl_col, 0.8); j = 0;
  loop(11, b = a0 + j / 10 * (a1 - a0);
    gfx_line(x + sin(b) * (R + ps(5)), y - cos(b) * (R + ps(5)), x + sin(b) * (R + ps(j % 5 ? 9 : 12)), y - cos(b) * (R + ps(j % 5 ? 9 : 12)), 1); j += 1; );
  col(0x000000, 0.32); gfx_circle(x + ps(3), y + ps(4), R, 1, 1);
  col(0x121314, 1); gfx_circle(x, y, R, 1, 1);
  col(0x262829, 1); j = 0;                                             // knurled skirt
  loop(48, b = j * $pi / 24; gfx_line(x + sin(b) * R * 0.80, y - cos(b) * R * 0.80, x + sin(b) * R * 0.98, y - cos(b) * R * 0.98, 1); j += 1; );
  col(0x1B1C1E, 1); gfx_circle(x, y, R * 0.76, 1, 1);
  col(0x2E3032, 1); gfx_circle(x, y, R * 0.74, 0, 1);
  col(0xFFFFFF, 0.07); gfx_circle(x - R * 0.18, y - R * 0.2, R * 0.42, 1, 1);
  col(sbc_k, 1);
  gfx_line(x + sin(tv) * R * 0.18, y - cos(tv) * R * 0.18, x + sin(tv) * R * 0.72, y - cos(tv) * R * 0.72, 1);
  gfx_line(x + sin(tv) * R * 0.18 + cos(tv) * ps(1), y - cos(tv) * R * 0.18 + sin(tv) * ps(1), x + sin(tv) * R * 0.72 + cos(tv) * ps(1), y - cos(tv) * R * 0.72 + sin(tv) * ps(1), 1);
  gfx_line(x + sin(tv) * R * 0.18 - cos(tv) * ps(1), y - cos(tv) * R * 0.18 - sin(tv) * ps(1), x + sin(tv) * R * 0.72 - cos(tv) * ps(1), y - cos(tv) * R * 0.72 - sin(tv) * ps(1), 1);
  gfx_setfont(3); col(lbl_col, 1); text_c(x, y + R + ps(24), lbl);
  hov || drag_idx == idx ? (
    fmt == 0 ? sprintf(#kv, "%.1f", v) : sprintf(#kv, "%+.1f dB", v);
    gfx_setfont(4); gfx_measurestr(#kv, w, h); ty = y - R - ps(16) - h;
    col(0x101214, 0.92); gfx_rect(x - w * 0.5 - ps(6), ty - ps(3), w + ps(12), h + ps(6), 1);
    col(0xF2E8C8, 1); text_c(x, ty + h * 0.5, #kv);
  );
);

// chunky lit key, aftermarket-switch style
function dkey(x, y, w, h, on, c, str) local(hov) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  on ? ( col(c, 0.18); rr(x - 6, y - 6, w + 12, h + 12, 9); );
  col(0x000000, 0.4); rr(x + 2, y + 3, w, h, 5);
  col(0x141516, 1); rr(x, y, w, h, 5);
  col(on ? c : 0x4A4A46, 1); rr(x + 4, y + 4, w - 8, h - 8, 3);
  on ? ( col(0xFFFFFF, 0.25); gfx_rect(px(x + 7), py(y + 6), ps(w - 14), ps(2), 1); );
  gfx_setfont(5); col(on ? 0x1A1408 : 0xB8B4A8, 1); text_c(px(x + w * 0.5), py(y + h * 0.5), str);
  click && hov;
);

// ---------- presets (OUTPUT evens the loudness; GUI thread only) ----------
function pb_item(menu, i, dst) local(k, k0, m, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  m = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( m == i ? strcpy_substr(dst, menu, k0, k - k0);  m += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function load_preset(p) (
  p == 1 ? ( slider(1) = 4;  slider(2) = 3;  slider(3) = 2;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 0;  slider(8) = 3; ) :   // Init
  p == 2 ? ( slider(1) = 5;  slider(2) = 4;  slider(3) = 4;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = -0.5;  slider(8) = 2; ) :   // Gravel Road
  p == 3 ? ( slider(1) = 3;  slider(2) = 2;  slider(3) = 3;  slider(4) = 0;  slider(5) = 0;  slider(6) = 1;  slider(7) = 0;  slider(8) = 4; ) :   // Coastal Fog
  p == 4 ? ( slider(1) = 6;  slider(2) = 1;  slider(3) = 1;  slider(4) = 2;  slider(5) = 1;  slider(6) = 0;  slider(7) = 0;  slider(8) = 7; ) :   // Hill Climb Bass
  p == 5 ? ( slider(1) = 2;  slider(2) = 6;  slider(3) = 0;  slider(4) = 0;  slider(5) = 0;  slider(6) = 0;  slider(7) = 0;  slider(8) = 3; ) :   // Highway Polish
  p == 6 ? ( slider(1) = 4;  slider(2) = 2;  slider(3) = 5;  slider(4) = 1;  slider(5) = 0;  slider(6) = 1;  slider(7) = 1;  slider(8) = 5; ) :   // Night Drive
  p == 7 ? ( slider(1) = 7;  slider(2) = 5;  slider(3) = 6;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = -1;  slider(8) = 1; ) :   // Mountain Pass
  p == 8 ? ( slider(1) = 6;  slider(2) = 3;  slider(3) = 0;  slider(4) = 2;  slider(5) = 1;  slider(6) = 0;  slider(7) = 0;  slider(8) = 6; ) :   // Kick in the Mud
  p == 9 ? ( slider(1) = 8;  slider(2) = 7;  slider(3) = 7;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = -1;  slider(8) = 0; ) :   // Toy Rally
  p == 10 ? ( slider(1) = 3;  slider(2) = 3;  slider(3) = 1;  slider(4) = 1;  slider(5) = 1;  slider(6) = 0;  slider(7) = -0.5;  slider(8) = 3; ) :   // Mix Bus Cruise
  p == 11 ? ( slider(1) = 5;  slider(2) = 1;  slider(3) = 8;  slider(4) = 0;  slider(5) = 0;  slider(6) = 1;  slider(7) = -0.5;  slider(8) = 6; ) :   // Dusty Tape
  p == 12 ? ( slider(1) = 10;  slider(2) = 4;  slider(3) = 10;  slider(4) = 2;  slider(5) = 0;  slider(6) = 0;  slider(7) = -4.5;  slider(8) = 5; ) :   // Off the Map
  p == 13 ? ( slider(1) = 4;  slider(2) = 3;  slider(3) = 2;  slider(4) = 1;  slider(5) = 0;  slider(6) = 0;  slider(7) = 0;  slider(8) = 3;  slider(9) = 1; ) : 0;   // Reset all to defaults
  slider_automate(p == PB_N + 1 ? 511 : 255);   // (Reset also brings back 4WD)
  gui_dirty = 1;
);
PRESET_MENU = "Init|Gravel Road|Coastal Fog|Hill Climb Bass|Highway Polish|Night Drive|Mountain Pass|Kick in the Mud|Toy Rally|Mix Bus Cruise|Dusty Tape|Off the Map";
PB_N = 12;

// ---------- frame ----------
sc = min(gfx_w / 1000, gfx_h / 560); ox = (gfx_w - 1000 * sc) * 0.5; oy = (gfx_h - 560 * sc) * 0.5;
lmb = mouse_cap & 1; click = lmb && !last_lmb;
gfx_setfont(1, "Arial Black", ps(30), 'i');
gfx_setfont(2, "Arial Black", ps(15));
gfx_setfont(3, "Arial", ps(13), 'b');
gfx_setfont(4, "Verdana", ps(12), 'b');
gfx_setfont(5, "Arial", ps(12), 'b');
gfx_setfont(6, "Arial Black", ps(46), 'i');
gfx_setfont(8, "Courier New", ps(16), 'b');
gfx_setfont(7, "Arial Black", ps(19), 'i');
up = LV[livery * 6]; lo = LV[livery * 6 + 1]; sa = LV[livery * 6 + 2]; sbc = LV[livery * 6 + 3]; dc = LV[livery * 6 + 5];
lbl_col = abs(lum(dc) - lum(lo)) > 70 ? dc : (lum(lo) > 120 ? 0x1E232A : 0xEDE6D2);
up_txt  = lum(up) > 120 ? mix(up, 0x000000, 0.62) : mix(up, 0xFFFFFF, 0.62);
sbc_k   = lum(sbc) > 125 ? sbc : 0xF2C230;                                 // knob pointer: the accent stripe, if it reads on black
// meters / visualiser hand-off
gvi = 0; loop(24, vb_m[gvi] = max(BE[50 + gvi], vb_m[gvi] * 0.86); BE[50 + gvi] = 0; gvi += 1; );
mL = max(pkL_d, mL * 0.85); pkL_d = 0; mR = max(pkR_d, mR * 0.85); pkR_d = 0;

// ---------- the two-tone panel ----------
col(0x111214, 1); gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(0x000000, 0.45); rr(26, 26, 954, 516, 22);
col(lo, 1); rr(20, 20, 954, 516, 22);
col(up, 1); rr(20, 20, 954, 290, 22); gfx_rect(px(20), py(280), ps(954), ps(30), 1);
col(0xFFFFFF, 0.10); gfx_rect(px(42), py(24), ps(910), ps(2), 1);
// title + preset box along the top
col(0x000000, 0.3); rr(48, 34, 36, 36, 8); col(up_txt, 1); rr(46, 32, 36, 36, 8);
col(up, 1); rr(49, 35, 30, 30, 6);
gfx_setfont(4); col(up_txt, 1); text_c(px(64), py(50), "GFX");
gfx_setfont(1); col(up_txt, 0.95); gfx_x = px(94); gfx_y = py(30); gfx_drawstr("OVERLAND");
col(0x000000, 0.35); rr(546, 34, 408, 34, 5); col(0x141516, 1); rr(544, 32, 408, 34, 5);
col(0x050505, 1); rr(640, 36, 306, 26, 3);
gfx_gradrect(px(643), py(39), ps(300), ps(20), 0.17, 0.10, 0.02, 1, 0, 0, 0, 0, -0.003, -0.002, -0.001, 0);
cur_ok = pr_cur >= 1 && pr_cur <= PB_N;
cur_ok ? pb_item(PRESET_MENU, pr_cur, #pb_nm) : strcpy(#pb_nm, "--");
gfx_setfont(8); col(0xE8A33A, 1); gfx_x = px(652); gfx_y = py(41); gfx_drawstr(#pb_nm);
gfx_setfont(5); col(0xC8C4B8, 1); text_c(px(572), py(49), "PRESET");
col(0x4A4A46, 1); rr(602, 38, 16, 22, 2); rr(620, 38, 16, 22, 2);
col(0xE8E2CC, 1); gfx_triangle(px(606), py(49), px(614), py(43), px(614), py(55)); gfx_triangle(px(632), py(49), px(624), py(43), px(624), py(55));
pb_sel = 0;
click && mouse_y >= py(36) && mouse_y < py(62) ? (
  mouse_x >= px(602) && mouse_x < px(618) ? pb_sel = pr_cur <= 1 || pr_cur > PB_N ? PB_N : pr_cur - 1 :
  mouse_x >= px(620) && mouse_x < px(636) ? pb_sel = pr_cur >= PB_N || pr_cur < 1 ? 1 : pr_cur + 1 :
  (mouse_x >= px(546) && mouse_x < px(600)) || (mouse_x >= px(640) && mouse_x < px(946)) ? (
    strcpy(#pb_m, ""); gi = 1;
    loop(PB_N, gi == pr_cur ? strcat(#pb_m, "!"); strcat(#pb_m, pb_item(PRESET_MENU, gi, #pb_t)); strcat(#pb_m, "|"); gi += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(640); gfx_y = py(64); gi = gfx_showmenu(#pb_m); gi > 0 ? pb_sel = gi;
  );
);
pb_sel > 0 ? ( load_preset(pb_sel);  pr_cur = pb_sel > PB_N ? 1 : pb_sel; );

// ---------- the window: abstract dusk, a flat mountain, a vanishing road; the foreground is the spectrum ----------
wx = 48; wy = 82; ww = 690; wh = 196;
col(0x0B0D10, 1); rr(wx - 6, wy - 6, ww + 12, wh + 12, 14);
gfx_gradrect(px(wx), py(wy), ps(ww), ps(wh), 0.19, 0.22, 0.30, 1, 0, 0, 0, 0, 0.0025 / sc, 0.0015 / sc, -0.0004 / sc, 0);
// sun disc low on the horizon, banded
col(0xE8A35A, 0.9); gfx_circle(px(wx + 520), py(wy + 112), ps(26), 1, 1);
col(mix(0xE8A35A, 0x30384A, 0.55), 1); j = 0; loop(4, gfx_rect(px(wx + 490), py(wy + 104 + j * 7), ps(60), ps(2 + j * 0.6), 1); j += 1; );
// mountain: two flat planes and a cap
col(0x2B3446, 1); gfx_triangle(px(wx + 250), py(wy + 46), px(wx + 410), py(wy + 140), px(wx + 90), py(wy + 140));
col(0x232B3A, 1); gfx_triangle(px(wx + 250), py(wy + 46), px(wx + 410), py(wy + 140), px(wx + 250), py(wy + 140));
col(0xDDE3EA, 0.85); gfx_triangle(px(wx + 250), py(wy + 46), px(wx + 272), py(wy + 59), px(wx + 228), py(wy + 59));
col(0x1A2029, 1); gfx_rect(px(wx), py(wy + 140), ps(ww), ps(wh - 140), 1);
// road: two converging lines and dashes, in the accent colour
col(sbc_k, 0.55); gfx_line(px(wx + 300), py(wy + 140), px(wx + 120), py(wy + wh), 1); gfx_line(px(wx + 310), py(wy + 140), px(wx + 520), py(wy + wh), 1);
col(sbc_k, 0.8); j = 0; loop(5, gfx_rect(px(wx + 304 - j * 0.6), py(wy + 146 + j * 10), ps(2 + j * 0.5), ps(4 + j), 1); j += 1; );
// spectrum: 24 bands as a dark silhouette rising from the foreground, accent caps
gsv = 0; bw = ww / 24;
loop(24,
  db = vb_m[gsv] > 0.00001 ? 8.685889638065035 * log(vb_m[gsv]) : -100;
  hh = max(3, min(wh * 0.62, (db + 66) / 66 * wh * 0.62));          // the bars stay in the foreground, under the mountain
  hc = hue(gsv / 23);
  col(0x0B0D10, 0.6); gfx_rect(px(wx + gsv * bw + 1), py(wy + wh - hh), ps(bw - 2), ps(hh), 1);
  gfx_gradrect(px(wx + gsv * bw + 1), py(wy + wh - hh), ps(bw - 2), ps(hh),
    floor(hc / 65536) / 255, (floor(hc / 256) % 256) / 255, (hc % 256) / 255, 0.78, 0, 0, 0, 0, 0, 0, 0, -0.62 / max(1, ps(hh)));
  col(mix(hc, 0xFFFFFF, 0.35), 1); gfx_rect(px(wx + gsv * bw + 1), py(wy + wh - hh), ps(bw - 2), ps(2), 1);
  gsv += 1;
);
col(0xFFFFFF, 0.06); gfx_triangle(px(wx), py(wy), px(wx + 140), py(wy), px(wx), py(wy + 120));

// ---------- the louvres: two slatted vents that are the level meters ----------
lx = 760; ly = 82;
col(0x0B0D10, 1); rr(lx - 6, ly - 6, 200, 208, 12);
mLdb = mL > 0.00001 ? 8.685889638065035 * log(mL) : -100;  mRdb = mR > 0.00001 ? 8.685889638065035 * log(mR) : -100;
slat_on = 0xE9C46A;  slat_off = shade(up, lum(up) > 120 ? 0.6 : 0.75);
j = 0;
loop(14,
  d = -42 + (13 - j) * 3;                    // top slat = 0 dBFS
  gy = ly + 4 + j * 14;
  col(mLdb >= d ? (d > -3 ? 0xE8622E : d > -12 ? 0xF2C230 : slat_on) : slat_off, 1);
  rr(lx + 4, gy, 86, 9, 2);
  col(mRdb >= d ? (d > -3 ? 0xE8622E : d > -12 ? 0xF2C230 : slat_on) : slat_off, 1);
  rr(lx + 98, gy, 86, 9, 2);
  col(0xFFFFFF, 0.12); gfx_rect(px(lx + 4), py(gy), ps(86), ps(1), 1); gfx_rect(px(lx + 98), py(gy), ps(86), ps(1), 1);
  j += 1;
);

// ---------- triple pinstripe at the colour split ----------
col(sa, 1); gfx_rect(px(20), py(308), ps(954), ps(5), 1);
col(sbc, 1); gfx_rect(px(20), py(317), ps(954), ps(3), 1);
col(sa, 1); gfx_rect(px(20), py(324), ps(954), ps(5), 1);

// ---------- controls ----------
dknob(120, 420, 50, 1, 0, 10, 4, "DRIVE", 0);
dknob(266, 424, 36, 2, 0, 10, 3, "LIFT", 0);
dknob(384, 424, 36, 3, 0, 10, 3, "TERRAIN", 0);
// transfer selector: 2H / 4H / 4L gate
col(0x000000, 0.35); rr(482, 358, 92, 132, 10); col(0x141516, 1); rr(480, 356, 92, 132, 10);
col(0x050505, 1); rr(520, 370, 12, 104, 6);
gfx_setfont(2); gi = 0;
loop(3, gy = 378 + gi * 44; col(xfer == gi ? 0xF2C230 : 0x8A8A84, 1); gfx_x = px(490); gfx_y = py(gy); gfx_drawstr(gi == 0 ? "2H" : gi == 1 ? "4H" : "3L");
  click && mouse_x >= px(480) && mouse_x < px(572) && mouse_y >= py(gy - 6) && mouse_y < py(gy + 30) ? ( slider(4) = gi; param_touched(4); ); gi += 1; );
gy = 378 + xfer * 44 + 10;
col(0x000000, 0.45); gfx_circle(px(528), py(gy + 3), ps(14), 1, 1);
col(0x111111, 1); gfx_circle(px(526), py(gy), ps(14), 1, 1); col(0x3A3A3A, 1); gfx_circle(px(522), py(gy - 4), ps(5), 1, 1);
gfx_setfont(3); col(lbl_col, 1); text_c(px(526), py(508), "TRANSFER");
dkey(604, 362, 104, 38, diff, 0xE8622E, "DIFF LOCK") ? ( slider(5) = !diff; param_touched(5); );
dkey(604, 414, 104, 38, fog, 0xF2C230, "FOG") ? ( slider(6) = !fog; param_touched(6); );
dknob(826, 428, 40, 7, -12, 12, 0, "OUTPUT", 1);
// 4WD / 2WD plate: a raised button (4WD = anti-aliased)
wd_hov = mouse_x >= px(869) && mouse_x < px(947) && mouse_y >= py(349) && mouse_y < py(381);
wd_dn = wd_hov && lmb ? 1 : 0;
wd ? ( col(0xF2C230, 0.12); rr(865, 345, 86, 40, 7); );
col(0x000000, 0.35); rr(872, 352, 78, 32, 4);
col(0x16181A, 1); rr(869 + wd_dn, 349 + wd_dn, 78, 32, 4);
col(0xFFFFFF, wd_dn ? 0.06 : 0.16); gfx_rect(px(871 + wd_dn), py(350 + wd_dn), ps(74), ps(1.5), 1); gfx_rect(px(870 + wd_dn), py(351 + wd_dn), ps(1.5), ps(28), 1);
col(0x000000, 0.5); gfx_rect(px(871 + wd_dn), py(379 + wd_dn), ps(75), ps(1.5), 1); gfx_rect(px(945 + wd_dn), py(351 + wd_dn), ps(1.5), ps(29), 1);
gfx_setfont(7); col(wd ? 0xEDE3C4 : 0x7E7A6E, 1); text_c(px(908 + wd_dn), py(365 + wd_dn), wd ? "4WD" : "2WD");
wd ? ( col(0xF2C230, 0.9); gfx_rect(px(888 + wd_dn), py(376 + wd_dn), ps(40), ps(1.5), 1); );
click && wd_hov ? ( slider(9) = wd ? 0 : 1;  param_touched(9); );
// livery chips - click to repaint
gi = 0;
loop(8, col(0x000000, 0.4); rr(604 + gi * 21, 486, 18, 18, 3); col(LV[gi * 6], 1); rr(602 + gi * 21, 484, 18, 9, 2); col(LV[gi * 6 + 1], 1); rr(602 + gi * 21, 493, 18, 9, 2);
  livery == gi ? ( col(lbl_col, 1); gfx_rect(px(602 + gi * 21), py(506), ps(18), ps(2), 1); );
  click && mouse_x >= px(602 + gi * 21) && mouse_x < px(620 + gi * 21) && mouse_y >= py(484) && mouse_y < py(502) ? ( slider(8) = gi; param_touched(8); ); gi += 1; );
glb = (lum(up) + lum(lo)) / 510;  glb = max(0, min(1, (glb - 0.2) / 0.6));
gfx_setfont(3); col(lbl_col, 1);
text_c(px(686), py(524), glb < 0.36 ? "LIVERY  -  WARM / DENSE" : glb < 0.64 ? "LIVERY  -  BALANCED" : "LIVERY  -  BRIGHT / WIDE");

!lmb ? drag_idx = 0; last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // targets are rebuilt in @block, never on the GUI thread
