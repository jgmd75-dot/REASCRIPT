desc: GFX Lab Phat [multi-fx]
//author: JGWizrad / Garden FX (GFX)
//
// Phat - a fat multi-effect: drive, two filters, modulation and a squash, in one box. Mood: a 90s
// chrome boombox (gunmetal body, chrome trim, two speakers that pump with the output, a teal LCD).
// Written from the published feature set of the classic freeware multi-effects of its kind (clean-room:
// nothing taken from any original binary). Brand names stay out of the panel and the FX list.
//
// DRIVE     TUBE  soft curve (house clip kit SOFT), asymmetric and biased: even harmonics
//           FUZZ  hard clip with a dead zone that opens with DRIVE (starved-bias gate)
//           RECT  rectifier: full-wave |x| blended with a soft stage (octave-up), DC removed
//           CRUSH bit depth (16 -> 3 bits) and sample-rate hold (1 -> 24 samples) - aliasing on purpose
//           TUBE / FUZZ / RECT are anti-aliased (ADAA, clip kit) behind the kit's drive-tracking pre-filter,
//           and level-matched at -12 dBFS (DRIVE changes the character, not the loudness). MIX blends it in
//           (the dry side is delayed half a sample to line up with ADAA, so the blend doesn't comb).
// FILTER 1 / FILTER 2   state-variable (TPT, Cytomic): OFF, LP 12, LP 24, HP 12, HP 24, BAND, NOTCH;
//           CUT, RES, and how far the LFO and the envelope move the cutoff (+/- 4 octaves each).
//           24 dB modes = a Butterworth stage + the resonant stage. Coefficients refresh every 8 samples.
// ROUTE     the filters in SERIES or PARALLEL;  ORDER  drive before or after the filters
// LFO       the house LFO (gfx-lab-lfo): SINE / TRI / SQR (SMOOTH rounds it) / RND (SMOOTH glides it);
//           FREE (Hz), SYNC (locked to the timeline) or FLOW (tempo rate, free-running phase);
//           WIDTH offsets the right channel's phase (0 - 180 deg)
// ENV       envelope follower on the input (stereo-linked, -60..0 dB -> 0..1); SPEED slows attack + release
// PHAT      one-knob squash after everything: threshold, ratio and make-up rise together; soft 6 dB knee
// OUTPUT    gain, DRY/WET, then the house output stage, CLIP always on (-0.3 dBFS). Latency: none.
// Switching a drive type, a filter type, ROUTE or ORDER dips the output for ~3 ms (no clicks).
//
// STATUS: Lab (experimental, may change). v0.1.

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-lfo.jsfx-inc

slider1:dtype=0<0,3,1{Tube,Fuzz,Rect,Crush}>-Drive Type
slider2:drive=3<0,10,0.1>-Drive
slider3:dmix=100<0,100,0.1>-Drive Mix (%)
slider4:f1type=2<0,6,1{Off,LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 1 Type
slider5:f1cut=1800<20,20000,1:log>-Filter 1 Cutoff (Hz)
slider6:f1res=3<0,10,0.1>-Filter 1 Resonance
slider7:f1lfo=0<-4,4,0.01>-Filter 1 LFO (oct)
slider8:f1env=0<-4,4,0.01>-Filter 1 Envelope (oct)
slider9:f2type=0<0,6,1{Off,LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 2 Type
slider10:f2cut=400<20,20000,1:log>-Filter 2 Cutoff (Hz)
slider11:f2res=0<0,10,0.1>-Filter 2 Resonance
slider12:f2lfo=0<-4,4,0.01>-Filter 2 LFO (oct)
slider13:f2env=0<-4,4,0.01>-Filter 2 Envelope (oct)
slider14:route=0<0,1,1{Series,Parallel}>-Filter Routing
slider15:order=0<0,1,1{Drive First,Filters First}>-Order
slider16:lshape=0<0,3,1{Sine,Triangle,Square,Random}>-LFO Shape
slider17:lmode=1<0,2,1{Free,Sync,Flow}>-LFO Mode
slider18:lhz=1<0.02,20,0.01:log>-LFO Rate (Hz)
slider19:ldiv=6<0,15,1{4 Bars,2 Bars,1 Bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-LFO Division
slider20:lsmooth=3<0,10,0.1>-LFO Smooth
slider21:lwidth=0<0,180,1>-LFO Width (deg)
slider22:espeed=4<0,10,0.1>-Envelope Speed
slider23:phat=0<0,10,0.1>-Phat
slider24:out_db=0<-12,12,0.1>-Output (dB)
slider25:wet_pc=100<0,100,0.1>-Dry/Wet (%)

@init
ext_noinit = 1;
gfx_ext_retina = 1;
pr_cur = 1;              // preset shown on the LCD (saved with the project)
ost_init(0);

// ---------- memory map ----------
CF = 0;          // filter coefficient sets, 8 each: F1 L, F1 R, F2 L, F2 R (a1 a2 a3 k b1 b2 b3)
SB = 100;        // filter states, 4 per filter: L F1, L F2, R F1, R F2
RV = 200;        // the scope's random steps (GUI only reads them)
memset(CF, 0, 32);  memset(SB, 0, 16);
RV[0] = 0.6;  RV[1] = -0.4;  RV[2] = 0.9;  RV[3] = -0.8;  RV[4] = 0.15;  RV[5] = -0.25;  RV[6] = 0.75;  RV[7] = -0.6;

function db2g(d) ( exp(d * 0.11512925464970228); );

// ---------- the filters: shared-coefficient TPT state-variable (Cytomic) ----------
function sv_coef(i, fc, r) local(c, g, k) (
  c = CF + i * 8;
  g = tan($pi * min(max(fc, 20), srate * 0.45) / srate);
  k = 2 - 1.85 * r;                                              // RES 0..1 -> Q 0.5 .. ~6.7 (stops short of self-oscillation)
  c[0] = 1 / (1 + g * (g + k));  c[1] = g * c[0];  c[2] = g * c[1];  c[3] = k;
  c[4] = 1 / (1 + g * (g + 1.41421356));  c[5] = g * c[4];  c[6] = g * c[5];
);
// t: 0 OFF, 1 LP 12, 2 LP 24, 3 HP 12, 4 HP 24, 5 BAND (unity peak), 6 NOTCH;  coefficient set i, state at s
function sv_run(x, t, i, s) local(c, y, v1, v2, v3) (
  t == 0 ? x : (
    c = CF + i * 8;  y = x;
    (t == 2 || t == 4) ? (                                       // 24 dB: a Butterworth stage first
      v3 = y - s[3];  v1 = c[4] * s[2] + c[5] * v3;  v2 = s[3] + c[5] * s[2] + c[6] * v3;
      s[2] = 2 * v1 - s[2];  s[3] = 2 * v2 - s[3];
      y = t == 2 ? v2 : y - 1.41421356 * v1 - v2;
    );
    v3 = y - s[1];  v1 = c[0] * s[0] + c[1] * v3;  v2 = s[1] + c[1] * s[0] + c[2] * v3;
    s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
    t <= 2 ? v2 : t <= 4 ? y - c[3] * v1 - v2 : t == 5 ? c[3] * v1 : y - c[3] * v1;
  );
);
// both filters for one channel (ci: 0 left, 1 right -> sets ci (F1) and ci + 2 (F2); s: that channel's states)
function flt(x, s, ci) (
  rt_a == 0 ? sv_run(sv_run(x, f1t_a, ci, s), f2t_a, ci + 2, s + 4) :
  (f1t_a && f2t_a) ? 0.5 * (sv_run(x, f1t_a, ci, s) + sv_run(x, f2t_a, ci + 2, s + 4)) :
  f1t_a ? sv_run(x, f1t_a, ci, s) : sv_run(x, f2t_a, ci + 2, s + 4);
);

// ---------- the drive, one channel (a, b: clip kit clippers; pf: the kit's pre-filter) ----------
function ds_tick(x) instance(a, b, pf, cnt, held, xp, dcx, dcy) local(u, y, dry) (
  dry = 0.5 * (x + xp);  xp = x;                                 // the ADAA half-sample, matched on the dry side
  dt_a == 3 ? (
    cnt -= 1;                                                    // CRUSH: hold, then quantise
    cnt <= 0 ? ( cnt = cr_hold;  held = min(max(floor(x * cr_q + 0.5) / cr_q, -1), 1); );
    y = held;  dry = x;
  ) : (
    u = pf.clp_pf_run(x) * ds_g;
    dt_a == 0 ? ( y = (a.clp_run(u + ds_b) - ds_rest) * ds_c; ) :          // TUBE
    dt_a == 1 ? ( y = a.clp_run(u) * ds_c; ) :                             // FUZZ
                ( y = 0.5 * (a.clp_run(u) + b.clp_run(u)) * ds_c; );        // RECT
  );
  dcy = y - dcx + 0.9995 * dcy;  dcx = y;                        // DC blocker (the rectifier's DC, the tube's bias)
  dry + (dcy - dry) * dmix_s;
);
function ds_reset() instance(a, b, cnt, held, xp, dcx, dcy) (
  a.clp_reset();  b.clp_reset();  cnt = 0;  held = 0;  dcx = 0;  dcy = 0;
);

function update_targets() (
  dt_t = dtype;  f1t_t = f1type;  f2t_t = f2type;  rt_t = route;  or_t = order;
  drive_t = drive;  dmix_t = dmix * 0.01;
  lt1 = log(f1cut) / log(2);  lt2 = log(f2cut) / log(2);
  r1_t = f1res * 0.1;  r2_t = f2res * 0.1;
  a1l = f1lfo;  a1e = f1env;  a2l = f2lfo;  a2e = f2env;
  lfoL.lfo_setup(lshape, lsmooth * 0.1);  lfoR.lfo_setup(lshape, lsmooth * 0.1);
  lmode_v = lmode;  ldiv_v = ldiv;  lhz_v = lhz;  loff = lwidth / 360;
  e_att = 1 - exp(-1 / (0.002 * 2 ^ (espeed * 0.5) * srate));   // 2 .. 64 ms
  e_rel = 1 - exp(-1 / (0.03 * 2 ^ (espeed * 0.5) * srate));    // 30 ms .. ~1 s
  phat_t = phat;  out_t = db2g(out_db);  wet_t = wet_pc * 0.01;
);

// the switch dip: at the silent point, bring in the new types and clear what they would inherit
function sw_apply() (
  dt_t != dt_a ? ( chL.ds.ds_reset();  chR.ds.ds_reset();  dt_a = dt_t; );
  f1t_t != f1t_a ? ( memset(SB, 0, 4);  memset(SB + 8, 0, 4);  f1t_a = f1t_t; );
  f2t_t != f2t_a ? ( memset(SB + 4, 0, 4);  memset(SB + 12, 0, 4);  f2t_a = f2t_t; );
  rt_a = rt_t;  or_a = or_t;
  cc = 0;  sw_hold = 1;                                          // fade back in once @block has set the new curves
);

chL.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);  chR.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);
chL.ds.pf.clp_pf_reset();  chR.ds.pf.clp_pf_reset();
lfoL.lfo_init();  lfoR.lfo_init();

first_run = 1;
gl_sm = 1 - exp(-1 / (0.02 * srate));                            // 20 ms glides (per sample)
msm   = 1 - exp(-1 / (0.002 * srate));                           // modulation smoothing (de-clicks SQR / RND)
sw_step = 1 / (0.003 * srate);
c_att = 1 - exp(-1 / (0.003 * srate));  c_rel = 1 - exp(-1 / (0.09 * srate));
envlin = 0;  envn = 0;  grs = 0;  cc = 0;  sw_f = 1;  sw_hold = 0;
m1l = m1r = m2l = m2r = 0;

@slider
update_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);   // output stage: CLIP, always on
first_run ? (
  dt_a = dt_t;  f1t_a = f1t_t;  f2t_a = f2t_t;  rt_a = rt_t;  or_a = or_t;
  drive_s = drive_t;  dmix_s = dmix_t;  r1_s = r1_t;  r2_s = r2_t;  phat_s = phat_t;
  lc1 = lt1;  lc2 = lt2;  out_s = out_t;  wet_s = wet_t;
  first_run = 0;
);

@block
// GUI edits arrive as a flag; targets are rebuilt here, on the audio thread
prm_dirty ? ( prm_dirty = 0;  update_targets(); );
kb = 1 - exp(-samplesblock / (0.03 * srate));
drive_s += (drive_t - drive_s) * kb;  r1_s += (r1_t - r1_s) * kb;  r2_s += (r2_t - r2_s) * kb;  phat_s += (phat_t - phat_s) * kb;
dn = drive_s / 10;

// the drive's curves and level match (-12 dBFS in = -12 dBFS out; at DRIVE 0 unity for small signals)
ds_st = min(1, drive_s / 3);
dt_a == 0 ? (
  ds_g = db2g(drive_s * 2.4);  ds_b = 0.08 + 0.12 * dn;
  chL.ds.a.clp_set(1, 1, 0.72, 0);  chR.ds.a.clp_set(1, 1, 0.72, 0);
  ds_rest = chL.ds.a.clp_crv(ds_b);
  ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(chL.ds.a.clp_crv(0.25 * ds_g + ds_b) - ds_rest, 0.0001);
) : dt_a == 1 ? (
  ds_g = db2g(drive_s * 4);
  chL.ds.a.clp_set(0, 0.6, 0.6, 0.04 * dn);  chR.ds.a.clp_set(0, 0.6, 0.6, 0.04 * dn);
  ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(chL.ds.a.clp_crv(0.25 * ds_g), 0.0001);
) : dt_a == 2 ? (
  ds_g = db2g(drive_s * 2);
  chL.ds.a.clp_set(3, 1, 1, 0);  chR.ds.a.clp_set(3, 1, 1, 0);
  chL.ds.b.clp_set(1, 1, 1, 0);  chR.ds.b.clp_set(1, 1, 1, 0);
  ds_c = 0.25 / max(0.5 * (chL.ds.a.clp_crv(0.25 * ds_g) + chL.ds.b.clp_crv(0.25 * ds_g)), 0.0001);
) : (
  cr_q = 2 ^ (15 - drive_s * 1.3);                               // 16 bits .. 3 bits
  cr_hold = 1 + floor(sqr(dn) * 23);
);
chL.ds.pf.clp_pf_block(dn, srate, samplesblock);  chR.ds.pf.clp_pf_block(dn, srate, samplesblock);
chL.ds.a.clp_tidy();  chR.ds.a.clp_tidy();  chL.ds.b.clp_tidy();  chR.ds.b.clp_tidy();
sw_hold = 0;

lfoL.lfo_block(lmode_v, ldiv_v, lhz_v);  lfoR.lfo_block(lmode_v, ldiv_v, lhz_v);

// PHAT: threshold, ratio and make-up rise together
cn = phat_s / 10;
c_on = cn > 0.001;
c_thr = -32 * cn;
c_sl = 1 - 1 / (1 + 5 * cn);
c_mk = -c_thr * c_sl * 0.5;

// meters / display hand-offs
pkL_d = max(pkL_d, pkL);  pkL = 0;  pkR_d = max(pkR_d, pkR);  pkR = 0;
fc1_d = 2 ^ (lc1 + m1l);  fc2_d = 2 ^ (lc2 + m2l);
lph_d = lfoL.p;  env_d = envn;  gr_d = max(gr_d, grs);

@sample
// switch dip: down, swap at the silent point, back up
(dt_t != dt_a || f1t_t != f1t_a || f2t_t != f2t_a || rt_t != rt_a || or_t != or_a) ? (
  sw_f = max(0, sw_f - sw_step);
  sw_f == 0 ? sw_apply();
) : ( !sw_hold && sw_f < 1 ? sw_f = min(1, sw_f + sw_step); );

dmix_s += (dmix_t - dmix_s) * gl_sm;  out_s += (out_t - out_s) * gl_sm;  wet_s += (wet_t - wet_s) * gl_sm;
inL = spl0;  inR = spl1;

// envelope follower (input, stereo-linked)
ea = max(abs(inL), abs(inR));
envlin += (ea - envlin) * (ea > envlin ? e_att : e_rel);
envn = envlin > 0.001 ? min((20 * log10(envlin) + 60) / 60, 1) : 0;

// LFO (the right side offset by WIDTH; with no offset it follows the left exactly, RND included)
wl = lfoL.lfo_tick(0, 0, 0);
wr = lfoR.lfo_tick(loff, 0, 0);
loff <= 0 ? wr = wl;

// cutoffs: slider glide + modulation, in octaves
lc1 += (lt1 - lc1) * gl_sm;  lc2 += (lt2 - lc2) * gl_sm;
m1l += (wl * a1l + envn * a1e - m1l) * msm;  m1r += (wr * a1l + envn * a1e - m1r) * msm;
m2l += (wl * a2l + envn * a2e - m2l) * msm;  m2r += (wr * a2l + envn * a2e - m2r) * msm;
cc -= 1;
cc <= 0 ? (
  cc = 8;
  f1t_a ? ( sv_coef(0, 2 ^ (lc1 + m1l), r1_s);  sv_coef(1, 2 ^ (lc1 + m1r), r1_s); );
  f2t_a ? ( sv_coef(2, 2 ^ (lc2 + m2l), r2_s);  sv_coef(3, 2 ^ (lc2 + m2r), r2_s); );
);

xl = inL;  xr = inR;
or_a == 0 ? ( xl = chL.ds.ds_tick(xl);  xr = chR.ds.ds_tick(xr); );
xl = flt(xl, SB, 0);  xr = flt(xr, SB + 8, 1);
or_a == 1 ? ( xl = chL.ds.ds_tick(xl);  xr = chR.ds.ds_tick(xr); );

// PHAT (stereo-linked, soft 6 dB knee, auto make-up)
c_on ? (
  cl = max(abs(xl), abs(xr));
  cdb = cl > 0.000001 ? 20 * log10(cl) : -120;
  ov = cdb - c_thr;
  cg = ov <= -3 ? 0 : ov >= 3 ? ov * c_sl : c_sl * sqr(ov + 3) / 12;
  grs += (cg - grs) * (cg > grs ? c_att : c_rel);
  cgn = db2g(c_mk - grs);
  xl *= cgn;  xr *= cgn;
) : ( grs = 0; );

xl *= out_s * sw_f;  xr *= out_s * sw_f;
xl = inL + (xl - inL) * wet_s;  xr = inR + (xr - inR) * wet_s;
ost_out(xl, xr);  xl = ost_l;  xr = ost_r;                     // house clipper, -0.3 dBFS ceiling

pkL = max(pkL, abs(xl));  pkR = max(pkR, abs(xr));
spl0 = xl;  spl1 = xr;

@serialize
file_var(0, pr_cur);

@gfx 1000 600
function col(h, a) ( gfx_r = floor(h / 65536) / 255; gfx_g = (floor(h / 256) % 256) / 255; gfx_b = (h % 256) / 255; gfx_a = a; );
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h); gfx_x = x - w * 0.5; gfx_y = y - h * 0.5; gfx_drawstr(str); );
function rr(x, y, w, h, r) local(i, d, ins) (
  x = floor(px(x) + 0.5); y = floor(py(y) + 0.5); w = floor(ps(w) + 0.5); h = floor(ps(h) + 0.5);
  r = min(floor(ps(r) + 0.5), floor(min(w, h) * 0.5)); i = 0;
  loop(r, d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1); gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1); i += 1; );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function hit(x, y, w, h) ( mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h); );
// an arc as short segments (angle 0 = up, clockwise), screen units
function arc(x, y, r, a0, a1) local(n, j, b, c) (
  n = max(2, ceil(abs(a1 - a0) * 8));  j = 0;
  loop(n, b = a0 + (a1 - a0) * j / n;  c = a0 + (a1 - a0) * (j + 1) / n;
    gfx_line(x + sin(b) * r, y - cos(b) * r, x + sin(c) * r, y - cos(c) * r, 1);  j += 1; );
);
function ftn(t) ( t == 1 ? "LP 12" : t == 2 ? "LP 24" : t == 3 ? "HP 12" : t == 4 ? "HP 24" : t == 5 ? "BAND" : t == 6 ? "NOTCH" : "OFF"; );
function hzs(f, dst) ( f < 1000 ? sprintf(dst, "%.0f", f) : sprintf(dst, "%.1fk", f / 1000); );

// chrome-skirted boombox knob: black cap, value ring in the section's colour (from the middle for bipolar
// knobs), pointer line. Ctrl-click = default, Shift-drag = fine. Value tag on hover only.
// lg: log scale;  bip: ring from the centre;  fmt: 0 n.n, 1 dB, 2 Hz, 3 oct, 4 %, 5 deg, 6 sync division, 7 LFO Hz
function knob(cx, cy, r, idx, vmin, vmax, def, lbl, fmt, lg, bip, ac) local(x, y, R, v, t, hov, a0, a1, tv, tb, j, b, w, h, ty) (
  x = px(cx); y = py(cy); R = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(R * 1.2);
  v = slider(idx);
  t = lg ? log(max(v, vmin) / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov ? ( (mouse_cap & 4) ? ( slider(idx) = def; param_touched(idx); ) : ( drag_idx = idx; drag_y = mouse_y; drag_t = t; ); );
  drag_idx == idx ? (
    drag_t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 220)));  drag_y = mouse_y;
    v = lg ? vmin * (vmax / vmin) ^ drag_t : vmin + drag_t * (vmax - vmin);
    fmt == 6 ? v = floor(v + 0.5);
    slider(idx) != v ? ( slider(idx) = v; param_touched(idx); );
  );
  v = slider(idx);
  t = max(0, min(1, lg ? log(max(v, vmin) / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin)));
  a0 = -0.75 * $pi; a1 = 0.75 * $pi; tv = a0 + t * (a1 - a0); tb = bip ? 0 : a0;
  col(0xFFFFFF, 0.10); arc(x, y, R + ps(6), a0, a1); arc(x, y, R + ps(7), a0, a1);
  col(ac, 0.95); arc(x, y, R + ps(5), tb, tv); arc(x, y, R + ps(6), tb, tv); arc(x, y, R + ps(7), tb, tv);
  col(0x000000, 0.35); gfx_circle(x + ps(2), y + ps(3), R, 1, 1);
  col(0x9AA0A7, 1); gfx_circle(x, y, R, 1, 1);                         // chrome skirt
  col(0x5D6269, 1); gfx_circle(x, y, R * 0.92, 1, 1);
  col(0x141518, 1); gfx_circle(x, y, R * 0.84, 1, 1);                  // the cap
  col(0xFFFFFF, 0.06); gfx_circle(x - R * 0.2, y - R * 0.22, R * 0.45, 1, 1);
  col(0xF2F2EE, 1);
  gfx_line(x + sin(tv) * R * 0.25, y - cos(tv) * R * 0.25, x + sin(tv) * R * 0.78, y - cos(tv) * R * 0.78, 1);
  gfx_line(x + sin(tv) * R * 0.25 + cos(tv) * ps(1), y - cos(tv) * R * 0.25 + sin(tv) * ps(1), x + sin(tv) * R * 0.78 + cos(tv) * ps(1), y - cos(tv) * R * 0.78 + sin(tv) * ps(1), 1);
  gfx_setfont(3); col(0xC9CDD3, 1); text_c(x, y + R + ps(20), lbl);
  hov || drag_idx == idx ? (
    fmt == 0 ? sprintf(#kv, "%.1f", v) : fmt == 1 ? sprintf(#kv, "%+.1f dB", v) :
    fmt == 2 ? ( v < 1000 ? sprintf(#kv, "%.0f Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
    fmt == 3 ? sprintf(#kv, "%+.2f oct", v) : fmt == 4 ? sprintf(#kv, "%.0f%%", v) :
    fmt == 5 ? sprintf(#kv, "%.0f deg", v) : fmt == 6 ? strcpy(#kv, lfo_div_name(v)) : sprintf(#kv, "%.2f Hz", v);
    gfx_setfont(4); gfx_measurestr(#kv, w, h); ty = y - R - ps(14) - h;
    col(0x0B0C0E, 0.92); gfx_rect(x - w * 0.5 - ps(6), ty - ps(3), w + ps(12), h + ps(6), 1);
    col(0x7EF0CF, 1); text_c(x, ty + h * 0.5, #kv);
  );
);

// a lit key; returns 1 when clicked
function key(x, y, w, h, on, c, str) (
  on ? ( col(c, 0.16); rr(x - 4, y - 4, w + 8, h + 8, 7); );
  col(0x000000, 0.4); rr(x + 1, y + 2, w, h, 4);
  col(0x15171A, 1); rr(x, y, w, h, 4);
  col(on ? c : 0x3B3F45, 1); rr(x + 3, y + 3, w - 6, h - 6, 3);
  on ? ( col(0xFFFFFF, 0.22); gfx_rect(px(x + 6), py(y + 5), ps(w - 12), ps(1.5), 1); );
  gfx_setfont(5); col(on ? 0x16120C : 0xAEB2B8, 1); text_c(px(x + w * 0.5), py(y + h * 0.5), str);
  click && hit(x, y, w, h);
);

function sect(x, y, w, h, lbl) (
  col(0x000000, 0.25); rr(x + 1, y + 2, w, h, 10);
  col(0x222529, 1); rr(x, y, w, h, 10);
  col(0xFFFFFF, 0.05); gfx_rect(px(x + 10), py(y + 1), ps(w - 20), ps(1), 1);
  gfx_setfont(2); col(0x8D939B, 1); gfx_x = px(x + 12); gfx_y = py(y + 8); gfx_drawstr(lbl);
);

// a filter's type: click for the menu
function tbtn(x, y, w, h, idx, c) local(t, sel) (
  t = slider(idx);
  col(0x0B0C0E, 1); rr(x, y, w, h, 4);
  col(t ? c : 0x5D6269, 1); gfx_rect(px(x + 6), py(y + h * 0.5 - 3), ps(6), ps(6), 1);
  gfx_setfont(5); col(t ? 0xF2F2EE : 0x8D939B, 1); text_c(px(x + w * 0.5 + 4), py(y + h * 0.5), ftn(t));
  col(0x8D939B, 1); gfx_triangle(px(x + w - 13), py(y + h * 0.5 - 2), px(x + w - 5), py(y + h * 0.5 - 2), px(x + w - 9), py(y + h * 0.5 + 3));
  click && hit(x, y, w, h) ? (
    strcpy(#tm, "");  sel = 0;
    loop(7, sel == t ? strcat(#tm, "!"); strcat(#tm, ftn(sel)); sel < 6 ? strcat(#tm, "|"); sel += 1; );
    gfx_x = px(x); gfx_y = py(y + h + 2); sel = gfx_showmenu(#tm);
    sel > 0 ? ( slider(idx) = sel - 1; param_touched(idx); );
  );
);

// speaker: chrome ring with screws, surround, a cone and dust cap that pump with the level (lv 0..1)
function speaker(cx, cy, r, lv) local(x, y, R, p, j, b) (
  x = px(cx); y = py(cy); R = ps(r); p = 1 + 0.06 * lv;
  col(0x000000, 0.4); gfx_circle(x + ps(3), y + ps(4), R, 1, 1);
  col(0xA4AAB1, 1); gfx_circle(x, y, R, 1, 1);
  col(0x666B72, 1); gfx_circle(x, y, R * 0.95, 1, 1);
  col(0x0A0B0C, 1); gfx_circle(x, y, R * 0.88, 1, 1);
  col(0x111215, 1); gfx_circle(x, y, R * 0.80 * p, 1, 1);             // surround roll
  col(0x1D2024, 1); gfx_circle(x, y, R * 0.72 * p, 1, 1);             // cone
  col(0xFFFFFF, 0.05); j = 0; loop(4, gfx_circle(x, y, R * (0.34 + j * 0.1) * p, 0, 1); j += 1; );
  col(0xFF8F2E, 0.12 + 0.5 * lv); gfx_circle(x, y, R * 0.85, 0, 1);  gfx_circle(x, y, R * 0.86, 0, 1);
  col(0x2E3237, 1); gfx_circle(x, y, R * 0.26 * p, 1, 1);             // dust cap
  col(0xFFFFFF, 0.12); gfx_circle(x - R * 0.07, y - R * 0.08, R * 0.11 * p, 1, 1);
  col(0x3B3F45, 1); j = 0;
  loop(8, b = j * $pi / 4 + $pi / 8; gfx_circle(x + sin(b) * R * 0.915, y - cos(b) * R * 0.915, ps(2.5), 1, 1); j += 1; );
);

// the filter section's response (analogue prototypes, for the display): leaves cr_re, cr_im
function cresp(f, t, fc, k) local(w, dre, dim, nre, nim, den, re, im, bre, bim, d2) (
  t == 0 ? ( cr_re = 1; cr_im = 0; ) : (
    w = f / fc; dre = 1 - w * w; dim = k * w;
    t <= 2 ? ( nre = 1; nim = 0; ) : t <= 4 ? ( nre = -w * w; nim = 0; ) : t == 5 ? ( nre = 0; nim = k * w; ) : ( nre = dre; nim = 0; );
    den = dre * dre + dim * dim;
    re = (nre * dre + nim * dim) / den; im = (nim * dre - nre * dim) / den;
    (t == 2 || t == 4) ? (
      dim = 1.41421356 * w; den = dre * dre + dim * dim;
      nre = t == 2 ? 1 : -w * w;
      bre = nre * dre / den; bim = -nre * dim / den;
      d2 = re * bre - im * bim; im = re * bim + im * bre; re = d2;
    );
    cr_re = re; cr_im = im;
  );
);
function chain_db(f) local(r1, i1, r2, i2, re, im, m) (
  cresp(f, f1type, g_fc1, 2 - 0.185 * f1res); r1 = cr_re; i1 = cr_im;
  cresp(f, f2type, g_fc2, 2 - 0.185 * f2res); r2 = cr_re; i2 = cr_im;
  route == 0 || !(f1type && f2type) ? ( re = r1 * r2 - i1 * i2; im = r1 * i2 + i1 * r2; )
                                     : ( re = 0.5 * (r1 + r2); im = 0.5 * (i1 + i2); );
  m = re * re + im * im;
  m > 0.0000000001 ? 10 * log10(m) : -100;
);

// ---------- presets (GUI thread only) ----------
function pv(i, v) ( slider(i) = v; );
function pdef() (
  pv(1, 0); pv(2, 3); pv(3, 100); pv(4, 2); pv(5, 1800); pv(6, 3); pv(7, 0); pv(8, 0);
  pv(9, 0); pv(10, 400); pv(11, 0); pv(12, 0); pv(13, 0); pv(14, 0); pv(15, 0);
  pv(16, 0); pv(17, 1); pv(18, 1); pv(19, 6); pv(20, 3); pv(21, 0); pv(22, 4); pv(23, 0); pv(24, 0); pv(25, 100);
);
function pb_item(menu, i, dst) local(k, k0, m, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  m = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( m == i ? strcpy_substr(dst, menu, k0, k - k0);  m += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function load_preset(p) (
  pdef();
  p == 2 ? ( pv(2, 4); pv(5, 300); pv(6, 6); pv(7, 3); pv(19, 9); pv(23, 3); ) :                                 // Wobble Bass
  p == 3 ? ( pv(2, 6); pv(5, 250); pv(6, 8); pv(8, 3.5); pv(22, 2); pv(23, 2); pv(24, -1); ) :                  // Acid Squelch
  p == 4 ? ( pv(1, 3); pv(2, 5); pv(4, 5); pv(5, 1400); pv(9, 3); pv(10, 250); pv(23, 4); ) :                    // Lo-Fi Radio
  p == 5 ? ( pv(2, 5); pv(3, 70); pv(4, 1); pv(5, 12000); pv(6, 1); pv(23, 6); ) :                               // Phat Drums
  p == 6 ? ( pv(2, 2); pv(4, 1); pv(5, 900); pv(6, 4); pv(7, 2.5); pv(16, 1); pv(17, 0); pv(18, 0.08); pv(21, 90); ) :  // Slow Sweep
  p == 7 ? ( pv(5, 150); pv(6, 2); pv(7, 4); pv(16, 2); pv(19, 12); pv(20, 1); ) :                               // Filter Chop
  p == 8 ? ( pv(1, 1); pv(2, 6); pv(4, 6); pv(5, 1000); pv(6, 5); pv(7, 2); pv(19, 3); pv(21, 60); pv(24, -1); ) : // Fuzz Notch
  p == 9 ? ( pv(1, 2); pv(2, 6); pv(4, 3); pv(5, 180); pv(6, 2); pv(9, 1); pv(10, 6000); pv(11, 3); pv(23, 3); ) : // Octave Lead
  p == 10 ? ( pv(4, 5); pv(5, 1200); pv(6, 6); pv(7, 2); pv(16, 3); pv(19, 12); pv(20, 0); ) :                   // Random Steps
  p == 11 ? ( pv(2, 2); pv(4, 5); pv(5, 700); pv(6, 6); pv(7, 1); pv(9, 5); pv(10, 1600); pv(11, 6); pv(12, -1);
              pv(14, 1); pv(17, 0); pv(18, 0.3); ) :                                                              // Twin Formant
  p == 12 ? ( pv(1, 3); pv(2, 4); pv(5, 2500); pv(6, 3); pv(8, -2); pv(22, 3); pv(23, 7); ) : 0;                  // Crushed Pump
  slider_automate(33554431);                                                                                      // all 25
  gui_dirty = 1;
);
PRESET_MENU = "Init|Wobble Bass|Acid Squelch|Lo-Fi Radio|Phat Drums|Slow Sweep|Filter Chop|Fuzz Notch|Octave Lead|Random Steps|Twin Formant|Crushed Pump";
PB_N = 12;

// ---------- frame ----------
sc = min(gfx_w / 1000, gfx_h / 600); ox = (gfx_w - 1000 * sc) * 0.5; oy = (gfx_h - 600 * sc) * 0.5;
lmb = mouse_cap & 1; click = lmb && !last_lmb;
gfx_setfont(1, "Arial Black", ps(34), 'i');
gfx_setfont(2, "Arial", ps(12), 'b');
gfx_setfont(3, "Arial", ps(11), 'b');
gfx_setfont(4, "Verdana", ps(11), 'b');
gfx_setfont(5, "Arial", ps(11), 'b');
gfx_setfont(8, "Courier New", ps(16), 'b');
gfx_setfont(9, "Courier New", ps(12), 'b');
C_F1 = 0xFF8F2E;  C_F2 = 0xE8609E;  C_MOD = 0x7EF0CF;  C_DRV = 0xF2C230;
// meters / display hand-off
mL = max(pkL_d, mL * 0.85); pkL_d = 0; mR = max(pkR_d, mR * 0.85); pkR_d = 0;
gr_m = max(gr_d, gr_m * 0.88); gr_d = 0;

// ---------- the body ----------
col(0x0F1012, 1); gfx_rect(0, 0, gfx_w, gfx_h, 1);
col(0x000000, 0.45); rr(26, 26, 960, 560, 24);
col(0x2A2D32, 1); rr(20, 20, 960, 560, 24);
col(0x363A40, 1); rr(20, 20, 960, 62, 24); gfx_rect(px(20), py(56), ps(960), ps(26), 1);
gfx_gradrect(px(20), py(80), ps(960), ps(6), 0.78, 0.80, 0.83, 1, 0, 0, 0, 0, 0, 0, 0, -0.5 / max(1, ps(6)));
gfx_gradrect(px(20), py(262), ps(960), ps(5), 0.70, 0.72, 0.75, 1, 0, 0, 0, 0, 0, 0, 0, -0.5 / max(1, ps(5)));

// title + preset box
col(0x000000, 0.3); rr(48, 34, 36, 36, 8); col(C_F1, 1); rr(46, 32, 36, 36, 8);
col(0x363A40, 1); rr(49, 35, 30, 30, 6);
gfx_setfont(4); col(C_F1, 1); text_c(px(64), py(50), "GFX");
gfx_setfont(1); col(0xF2F2EE, 1); gfx_x = px(94); gfx_y = py(26); gfx_drawstr("PHAT");
gfx_setfont(3); col(C_F1, 1); gfx_x = px(214); gfx_y = py(46); gfx_drawstr("MULTI-FX");
col(0x000000, 0.35); rr(546, 34, 408, 34, 5); col(0x15171A, 1); rr(544, 32, 408, 34, 5);
col(0x050505, 1); rr(640, 36, 306, 26, 3);
gfx_gradrect(px(643), py(39), ps(300), ps(20), 0.03, 0.10, 0.08, 1, 0, 0, 0, 0, 0, 0.001, 0.001, 0);
cur_ok = pr_cur >= 1 && pr_cur <= PB_N;
cur_ok ? pb_item(PRESET_MENU, pr_cur, #pb_nm) : strcpy(#pb_nm, "--");
gfx_setfont(8); col(C_MOD, 1); gfx_x = px(652); gfx_y = py(41); gfx_drawstr(#pb_nm);
gfx_setfont(5); col(0xC9CDD3, 1); text_c(px(572), py(49), "PRESET");
col(0x3B3F45, 1); rr(602, 38, 16, 22, 2); rr(620, 38, 16, 22, 2);
col(0xE8EAEC, 1); gfx_triangle(px(606), py(49), px(614), py(43), px(614), py(55)); gfx_triangle(px(632), py(49), px(624), py(43), px(624), py(55));
pb_sel = 0;
click && mouse_y >= py(36) && mouse_y < py(62) ? (
  mouse_x >= px(602) && mouse_x < px(618) ? pb_sel = pr_cur <= 1 || pr_cur > PB_N ? PB_N : pr_cur - 1 :
  mouse_x >= px(620) && mouse_x < px(636) ? pb_sel = pr_cur >= PB_N || pr_cur < 1 ? 1 : pr_cur + 1 :
  (mouse_x >= px(546) && mouse_x < px(600)) || (mouse_x >= px(640) && mouse_x < px(946)) ? (
    strcpy(#pb_m, ""); gi = 1;
    loop(PB_N, gi == pr_cur ? strcat(#pb_m, "!"); strcat(#pb_m, pb_item(PRESET_MENU, gi, #pb_t)); strcat(#pb_m, "|"); gi += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(640); gfx_y = py(64); gi = gfx_showmenu(#pb_m); gi > 0 ? pb_sel = gi;
  );
);
pb_sel > 0 ? ( load_preset(pb_sel);  pr_cur = pb_sel > PB_N ? 1 : pb_sel; );

// ---------- the speakers (the level meters) ----------
lvL = mL > 0.00001 ? max(0, min(1, (8.685889638065035 * log(mL) + 42) / 42)) : 0;
lvR = mR > 0.00001 ? max(0, min(1, (8.685889638065035 * log(mR) + 42) / 42)) : 0;
speaker(122, 174, 74, lvL);
speaker(878, 174, 74, lvR);

// ---------- the LCD: the filter section's live response ----------
col(0x0A0B0C, 1); rr(208, 90, 584, 166, 12);
col(0x0C1714, 1); rr(214, 96, 572, 154, 6);
gx0 = 226; gx1 = 774; gy0 = 116; gy1 = 230;                       // plot area
gdb_t = 24; gdb_b = -36;
col(C_MOD, 0.08); gi = 0;
loop(6, gf = (gi % 2 ? 50 : 20) * 10 ^ floor(gi / 2);                   // light lines: 20 50 200 500 2k 5k
  gxx = gx0 + log(gf / 20) / log(1000) * (gx1 - gx0);
  gi > 0 ? gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0); gi += 1; );
col(C_MOD, 0.2); gi = 0;
loop(3, gf = 100 * 10 ^ gi; gxx = gx0 + log(gf / 20) / log(1000) * (gx1 - gx0);
  gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0);
  gfx_setfont(9); col(C_MOD, 0.45); text_c(px(gxx), py(240), gi == 0 ? "100" : gi == 1 ? "1k" : "10k"); col(C_MOD, 0.2);
  gi += 1; );
gi = 0; loop(5, gdb = 12 - gi * 12; gyy = gy0 + (gdb_t - gdb) / (gdb_t - gdb_b) * (gy1 - gy0);
  col(C_MOD, gdb == 0 ? 0.25 : 0.08); gfx_line(px(gx0), py(gyy), px(gx1), py(gyy), 0); gi += 1; );
g_fc1 = fc1_d > 0 ? fc1_d : f1cut;  g_fc2 = fc2_d > 0 ? fc2_d : f2cut;
gn = 160; gi = 0;
loop(gn + 1,
  gxn = gi / gn; gf = 20 * 1000 ^ gxn;
  gdb = max(gdb_b, min(gdb_t, chain_db(gf)));
  gxx = px(gx0 + gxn * (gx1 - gx0)); gyy = py(gy0 + (gdb_t - gdb) / (gdb_t - gdb_b) * (gy1 - gy0));
  gi > 0 ? (
    col(C_MOD, 0.10); gfx_rect(gxp, gyy, max(1, gxx - gxp), py(gy1) - gyy, 1);
    col(C_MOD, 1); gfx_line(gxp, gyp, gxx, gyy, 1);
  );
  gxp = gxx; gyp = gyy; gi += 1;
);
f1type ? ( gxx = gx0 + log(max(20, min(20000, g_fc1)) / 20) / log(1000) * (gx1 - gx0);
  col(C_F1, 0.8); gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0); gfx_circle(px(gxx), py(gy0), ps(3), 1, 1); );
f2type ? ( gxx = gx0 + log(max(20, min(20000, g_fc2)) / 20) / log(1000) * (gx1 - gx0);
  col(C_F2, 0.8); gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0); gfx_circle(px(gxx), py(gy0), ps(3), 1, 1); );
gfx_setfont(9);
hzs(f1cut, #h1); hzs(f2cut, #h2);
f1type ? sprintf(#l1, "F1 %s %s", ftn(f1type), #h1) : strcpy(#l1, "F1 OFF");
f2type ? sprintf(#l2, "F2 %s %s", ftn(f2type), #h2) : strcpy(#l2, "F2 OFF");
col(C_F1, 1); gfx_x = px(226); gfx_y = py(100); gfx_drawstr(#l1);
col(C_F2, 1); gfx_x = px(380); gfx_y = py(100); gfx_drawstr(#l2);
col(C_MOD, 0.7); strcpy(#lr, route ? "PARALLEL" : "SERIES"); strcat(#lr, order ? "  FLT>DRV" : "  DRV>FLT");
gfx_measurestr(#lr, gw, gh); gfx_x = px(774) - gw; gfx_y = py(100); gfx_drawstr(#lr);

// ---------- row A: DRIVE, FILTER 1, FILTER 2 ----------
sect(32, 278, 298, 146, "DRIVE");
gi = 0;
loop(4,
  key(44, 302 + gi * 28, 76, 22, dtype == gi, C_DRV, gi == 0 ? "TUBE" : gi == 1 ? "FUZZ" : gi == 2 ? "RECT" : "CRUSH") ? ( slider(1) = gi; param_touched(1); );
  gi += 1; );
knob(184, 352, 32, 2, 0, 10, 3, "DRIVE", 0, 0, 0, C_DRV);
knob(280, 358, 22, 3, 0, 100, 100, "MIX", 4, 0, 0, C_DRV);

sect(342, 278, 306, 146, "FILTER 1");
tbtn(548, 286, 88, 22, 4, C_F1);
knob(392, 358, 28, 5, 20, 20000, 1800, "CUT", 2, 1, 0, C_F1);
knob(462, 362, 22, 6, 0, 10, 3, "RES", 0, 0, 0, C_F1);
knob(530, 362, 22, 7, -4, 4, 0, "LFO", 3, 0, 1, C_MOD);
knob(600, 362, 22, 8, -4, 4, 0, "ENV", 3, 0, 1, C_MOD);

sect(660, 278, 308, 146, "FILTER 2");
tbtn(868, 286, 88, 22, 9, C_F2);
knob(710, 358, 28, 10, 20, 20000, 400, "CUT", 2, 1, 0, C_F2);
knob(780, 362, 22, 11, 0, 10, 0, "RES", 0, 0, 0, C_F2);
knob(848, 362, 22, 12, -4, 4, 0, "LFO", 3, 0, 1, C_MOD);
knob(918, 362, 22, 13, -4, 4, 0, "ENV", 3, 0, 1, C_MOD);

// ---------- row B: LFO, ENV, PHAT, OUTPUT ----------
sect(32, 434, 468, 136, "LFO");
gi = 0;
loop(3,
  key(300 + gi * 62, 438, 58, 20, lmode == gi, C_MOD, gi == 0 ? "FREE" : gi == 1 ? "SYNC" : "FLOW") ? ( slider(17) = gi; param_touched(17); );
  gi += 1; );
gi = 0;
loop(4,
  key(44 + (gi % 2) * 68, 468 + floor(gi / 2) * 32, 62, 24, lshape == gi, C_MOD, gi == 0 ? "SINE" : gi == 1 ? "TRI" : gi == 2 ? "SQR" : "RND") ? ( slider(16) = gi; param_touched(16); );
  gi += 1; );
// the scope: two cycles of the shape, the dot is the left channel's phase
col(0x0A0B0C, 1); rr(184, 464, 96, 64, 6); col(0x0C1714, 1); rr(186, 466, 92, 60, 5);
col(C_MOD, 0.15); gfx_line(px(190), py(496), px(274), py(496), 0);
gk = 1 + 49 * sqr(1 - lsmooth * 0.1); gtk = exp(2 * min(gk, 20)); gtk = (gtk - 1) / (gtk + 1);
gn = 48; gi = 0;
loop(gn + 1,
  gxn = gi / gn; gp = 2 * gxn; gp -= floor(gp); gp = gi == gn ? 1 : gp;
  lshape < 3 ? ( gv = lfo_shape_d(gp, lshape, gk, gtk); ) : (
    gq = floor(2 * gxn * 2) % 8; gfr = 2 * gxn * 2 - floor(2 * gxn * 2);
    gfr = lsmooth > 0.01 ? min(gfr / (lsmooth * 0.1), 1) : 1;
    gv = RV[gq] + (RV[(gq + 1) % 8] - RV[gq]) * (0.5 - 0.5 * cos($pi * gfr));
  );
  gxx = px(190 + gxn * 84); gyy = py(496 - gv * 24);
  gi > 0 ? ( col(C_MOD, 1); gfx_line(gxp, gyp, gxx, gyy, 1); );
  gxp = gxx; gyp = gyy; gi += 1;
);
lshape < 3 ? (
  gv = lfo_shape_d(lph_d, lshape, gk, gtk);
  col(0xF2F2EE, 1); gfx_circle(px(190 + lph_d * 42), py(496 - gv * 24), ps(3), 1, 1);
);
lmode == 0 ? knob(326, 502, 26, 18, 0.02, 20, 1, "RATE", 7, 1, 0, C_MOD)
           : knob(326, 502, 26, 19, 0, 15, 6, "RATE", 6, 0, 0, C_MOD);
knob(392, 506, 20, 20, 0, 10, 3, "SMOOTH", 0, 0, 0, C_MOD);
knob(454, 506, 20, 21, 0, 180, 0, "WIDTH", 5, 0, 0, C_MOD);

sect(512, 434, 100, 136, "ENV");
knob(556, 506, 22, 22, 0, 10, 4, "SPEED", 0, 0, 0, C_MOD);
col(0x0A0B0C, 1); rr(594, 466, 8, 76, 3);
genv = max(0, min(1, env_d)); col(C_MOD, 0.9); gfx_rect(px(596), py(540 - 72 * genv), ps(4), ps(72 * genv), 1);

sect(624, 434, 112, 136, "PHAT");
col(0x0A0B0C, 1); rr(640, 456, 80, 8, 3);
ggr = max(0, min(1, gr_m / 12)); col(C_F1, 0.9); gfx_rect(px(718 - 76 * ggr), py(458), ps(76 * ggr), ps(4), 1);
knob(680, 512, 28, 23, 0, 10, 0, "PHAT", 0, 0, 0, C_F1);

sect(748, 434, 220, 136, "OUTPUT");
key(758, 468, 82, 24, route, C_F2, route ? "PARALLEL" : "SERIES") ? ( slider(14) = !route; param_touched(14); );
key(758, 502, 82, 24, order, C_DRV, order ? "FLT>DRIVE" : "DRIVE>FLT") ? ( slider(15) = !order; param_touched(15); );
knob(880, 502, 22, 24, -12, 12, 0, "OUTPUT", 1, 0, 1, 0xF2F2EE);
knob(940, 506, 18, 25, 0, 100, 100, "DRY/WET", 4, 0, 0, 0xF2F2EE);

!lmb ? drag_idx = 0; last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // targets are rebuilt in @block, never on the GUI thread
