desc:GFX Lab Sifon [bus compressor]
//tags: compressor bus master mastering limiter brickwall mid side transformer
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-input, gfx-lab-ui, gfx-lab-panel and gfx-lab-os (.jsfx-inc) in the same folder.
//
// Sifon. A stereo bus processor in the spirit of a transformer-coupled master-bus compressor: a compressor with a
// feed-forward or feedback detector, a parallel BLEND, L/R or M/S working with LINK, and a limiter that can run
// with no latency or as a true-peak brickwall.
//
// SIGNAL FLOW
//   input -> TRIM (+ optional GUARD) -> COMPRESSOR (detector through the SC HPF; L/R or M/S; LINK) -> BLEND with
//   the uncompressed signal (make-up on the compressed side) -> [oversampled: IRON + COLOUR] -> DC blocker ->
//   STEREO FIELD (SIDE HPF, DEPTH, WIDTH) -> LIMITER (last) -> out.
// COMPRESSOR: THRESHOLD -40 .. 0 dBFS, RATIO 1.5 .. 8 : 1 (glided), ATTACK 0.1 - 75 ms, RELEASE 50 ms - 2.5 s or
//   AUTO (a fast release for short peaks, a slow one that only builds up under sustained compression).
//   DETECTOR: FEED-FORWARD listens to the input (tight, precise, 6 dB knee); FEEDBACK listens to its own output (the
//   knee widens to 10 dB and the ratio eases off under fast attacks: softer, more programme-dependent). Both run
//   all the time and the switch crossfades them (15 ms).
//   RMS (key under SC HPF): the detector reads the average level (a 15 ms RMS window, scaled so a steady sine
//   compresses at the same THRESHOLD as in PEAK) instead of every peak: it rides the body of the mix and lets short
//   transients through - smoother, more "loudness" than "peak" control. Works with both detectors; glided 15 ms.
//   SC HPF (off / 60 / 100 / 150 / 250 Hz, 12 dB/oct, glided) keeps the kick from pumping the mix.
//   M/S: the compressor works on Mid and Side; LINK on = one gain for both, off = each side (or Mid and Side) its own
//   detector (glided 10 ms). Changing L/R <-> M/S dips the sound for 5 ms and swaps at the silent point.
// IRON (always on): the output transformer. The lows below ~150 Hz saturate first (mostly 3rd harmonic, a touch of
//   2nd): weight and glue that grow with level. Only the harmonics the saturation makes are added (the lows keep
//   their level), so quiet signal passes untouched.
// COLOUR LOW / HIGH (either, both or neither): a second saturation on each band, added the same way. HIGH: the band above ~3 kHz (widening down to ~1 kHz as TEXTURE rises), mostly 2nd harmonic (sheen,
//   air, upper-mid edge). LOW: the band below ~300 Hz, more asymmetric (2nd harmonic: warmth, thickness).
//   Each band also lifts with TEXTURE (a gentle shelf, up to +2.5 dB at 100 %), and only harmonics are added, so a
//   band never loses level. Switching crossfades (30 ms). TEXTURE (0 - 100 %) drives IRON and COLOUR together.
//   LOW WIDTH / HIGH WIDTH (0 - 200 %, 100 = as made): where each band's added harmonics sit - 0 = centre only,
//   200 = sides only (only the added harmonics move, so no phase issues).
//   SOLO: hear only the band being worked on (LOW's and / or HIGH's, or IRON's when COLOUR is off), crossfaded.
// OS (1x / 2x / 4x, default 2x): IRON + COLOUR run at the chosen rate (gfx-lab-os linear-phase half-bands). The rest
//   runs at 1x. Changing it dips the sound for 5 ms and swaps at the silent point.
// STEREO FIELD: SIDE HPF (off / 80 / 120 / 200 Hz, 12 dB/oct on the Side: mono lows), DEPTH (-100 .. +100 %, 0 =
//   as is: a +/-4 dB shelf above 1.5 kHz on the Side - the room and ambience come forward or sit back), WIDTH
//   (0 - 200 %, 100 = as is).
// LIMITER: CEILING -12 .. 0 dB, FAST / SLOW release, stereo-linked.
//   ZERO LATENCY: soft-knee peak limiter, no look-ahead; very fast transients can pass the ceiling by a little.
//   BRICKWALL: 1.5 ms look-ahead and a true-peak detector (8x interpolated): the gain is down before a peak arrives,
//   so neither the samples nor the peaks between them pass the ceiling (true peak within 0.01 dB on programme).
// BYPASS (top bar): crossfades to the dry input, kept in time with the latency.
// Every key crossfades (IN keys 15 ms), every knob glides (30 ms).
// METERS: IN = a VU pair (L / R, 0 VU = -18 dBFS) after TRIM; GR = the compressor (red) and the limiter (amber),
//   0 - 20 dB; OUT = an LED row each for L and R (-42 .. +3 dBFS, 1.2 s floating peak hold, its figure beside;
//   click a row to clear it).
// GUI: drag a knob (SHIFT = fine), wheel, double-click = default; values show while a knob is touched. RATIO,
//   SC HPF and SIDE HPF: click the box for the list. Keys light when on. S / M / L / ? = size and help.
// PRESETS: Init, Mix Bus Glue, Gentle Master, Drum Bus Smash, M/S Tighten, Warm Low Master, High Sheen Mix,
//   Wide and Open, Vocal Bus Smooth, Loud and Safe, Parallel Crush (they leave TRIM, GUARD and OS as they are).
// Latency: 0 / 31 / 37 samples at 1x / 2x / 4x; BRICKWALL adds 1.5 ms + 7 samples (79 at 48 kHz); reported. On a
//   multichannel track the channels above 1 / 2 are delayed by the same amount (they are not processed). Changing the limiter type
//   dips the sound for 5 ms, swaps at the silent point and comes back once the new latency has come through.

slider1:thr_db=-18<-40,0,0.1>-Threshold (dB)
slider2:ratio_i=1<0,5,1{1.5 to 1,2 to 1,3 to 1,4 to 1,6 to 1,8 to 1}>-Ratio
slider3:att_ms=10<0.1,75,0.1>-Attack (ms)
slider4:rel_ms=300<50,2500,1>-Release (ms)
slider5:rel_auto=0<0,1,1{Off,On}>-Auto release
slider6:mkup_db=0<0,20,0.1>-Make-up (dB)
slider7:blend_pc=100<0,100,1>-Blend (%)
slider8:topo=0<0,1,1{Feed-forward,Feedback}>-Detector
slider9:schpf=0<0,4,1{Off,60 Hz,100 Hz,150 Hz,250 Hz}>-SC HPF
slider10:msmode=0<0,1,1{L/R,M/S}>-Stereo mode
slider11:lnk=1<0,1,1{Off,On}>-Link
slider12:comp_in=1<0,1,1{Out,In}>-Compressor
slider13:lim_ceil=-1<-12,0,0.1>-Limiter ceiling (dB)
slider14:lim_rel=0<0,1,1{Fast,Slow}>-Limiter release
slider15:brick=0<0,1,1{Zero latency,Brickwall}>-Limiter type
slider16:lim_in=0<0,1,1{Out,In}>-Limiter
slider17:trim_db=0<-24,12,0.1>-Input trim (dB)
slider18:guard=0<0,1,1{Off,On}>-Guard
slider19:colour=0<0,3,1{Off,High,Low,Both}>-Colour
slider20:texture=30<0,100,1>-Texture (%)
slider21:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider22:width_pc=100<0,200,1>-Width (%)
slider23:depth_pc=0<-100,100,1>-Depth (%)
slider24:sidehpf=0<0,3,1{Off,80 Hz,120 Hz,200 Hz}>-Side HPF
slider25:csolo=0<0,1,1{Off,On}>-Colour solo
slider26:lo_wid=100<0,200,1>-Low colour width (%)
slider27:hi_wid=100<0,200,1>-High colour width (%)
slider28:byp=0<0,1,1{Off,On}>-Bypass
slider29:rmsdet=0<0,1,1{Peak,RMS}>-Detector level

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc

@init
#ui_man = "gfx-lab-sifon";
ext_noinit = 1;

DLINE = 100000;                               // brickwall audio delay, L / R (1024 each)
GHIST = 102048;                               // look-ahead gain history for the moving average
DQV = 103072; DQI = 104096;                   // sliding-minimum queue (values, times)
TPK = 105120;                                 // true-peak interpolator taps: 7 phases x 16
TPH = 105300;                                 // true-peak histories, L / R (32 each)
RMASK = 1023;
DRY = 106000;                                 // dry input delayed by the latency, L / R (1024 each): the resume fade
XCH = 110000;                                 // channels 3 - 64 (1024 each): delayed by the latency too

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(g) ( log(max(g, 0.000000001)) * 8.685889638065035; );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );

// TPT state-variable high-pass (12 dB/oct, Q 0.707); the cutoff word sc_gw is glided per sample
function svf_hp2(x) instance(s1, s2) local(hp, v1, v2, bp) (    // the same, on its own cutoff (SIDE HPF)
  hp = (x - (sh_gw + 1.4142135623730951) * s1 - s2) * sh_h;
  v1 = sh_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = sh_gw * bp; s2 = s2 + 2 * v2;
  hp;
);
function svf_hp(x) instance(s1, s2) local(hp, v1, v2, bp) (
  hp = (x - (sc_gw + 1.4142135623730951) * s1 - s2) * sc_h;
  v1 = sc_gw * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = sc_gw * bp; s2 = s2 + 2 * v2;
  hp;
);

// static curve: dB over threshold -> dB of reduction (slope, knee width)
function gcurve(o, sl, kw) (
  o <= -0.5 * kw ? 0 : o >= 0.5 * kw ? o * sl : sl * sqr(o + 0.5 * kw) / (2 * kw);
);

// true-peak interpolator: 16-tap Blackman-windowed sinc at the seven 8x points between taps 7 and 8
function tp_design() local(p, k, t, w, x, s) (
  p = 0;
  loop(7,
    s = 0; k = 0;
    loop(16,
      t = (k - 7) - (p + 1) * 0.125;
      x = t / 8.5; w = abs(x) < 1 ? 0.42 + 0.5 * cos($pi * x) + 0.08 * cos(2 * $pi * x) : 0;
      TPK[p * 16 + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
      s += TPK[p * 16 + k]; k += 1;
    );
    k = 0; loop(16, TPK[p * 16 + k] /= s; k += 1; );
    p += 1;
  );
);
// one new sample into channel ch's history (TPH + ch * 32, kept twice so the 16 taps read straight through)
// -> the largest of samples n-8, n-7 and the signal between them: the seven 8x points, the loudest refined by a
//    parabola through it and its neighbours. Within 0.05 dB of the true peak on dense full-range programme.
function tp_peak(ch, x) local(h, b, p, m, y, a, c, e, d, q, pv) (
  h = TPH + ch * 32 + (tp_w & 15);
  h[0] = x; h[16] = x;
  h = TPH + ch * 32 + ((tp_w + 1) & 15);      // oldest of the 16
  pv = h[7]; m = abs(pv); a = c = e = 0; p = 0;
  loop(8,
    p < 7 ? (
      b = TPK + p * 16;
      y = b[0] * h[0] + b[1] * h[1] + b[2] * h[2] + b[3] * h[3] + b[4] * h[4] + b[5] * h[5] + b[6] * h[6] + b[7] * h[7]
        + b[8] * h[8] + b[9] * h[9] + b[10] * h[10] + b[11] * h[11] + b[12] * h[12] + b[13] * h[13] + b[14] * h[14]
        + b[15] * h[15];
    ) : y = h[8];
    abs(y) > m ? ( m = abs(y); a = pv; c = y; e = 0; q = 1; ) : q ? ( e = y; q = 0; );
    pv = y; p += 1;
  );
  // the parabola through the loudest point (c) and its neighbours (a, e), if that point was inside the interval
  c != 0 && e != 0 ? (
    c < 0 ? ( a = -a; c = -c; e = -e; );
    d = 2 * c - a - e;
    d > 0.000000001 ? (
      b = max(min(0.5 * (e - a) / d, 0.5), -0.5);
      m = max(m, c + 0.5 * (e - a) * b - 0.5 * d * b * b);
    );
  );
  m;
);

// TPT one-pole: low-pass output (G = g / (1 + g) for the running rate)
function op_lp(x, gg) instance(s) local(v, y) ( v = (x - s) * gg; y = v + s; s = y + v; y; );
// smooth saturator: x (27 + x^2) / (27 + 9 x^2), flat from |x| = 3 (slope 1 at 0, 0 at the knee)
function sat3(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
// what saturating a band adds: (sat(k x + b) - sat(b)) / (k sat'(b)) - x   (b = bias for the 2nd harmonic; dividing
// by the slope at b keeps quiet signal exactly as it was)
function sat3d(b) ( (sat3(b + 0.0001) - sat3(b - 0.0001)) * 5000; );
function sdiff(x, k, b, d) ( (sat3(k * x + b) - sat3(b)) / (k * d) - x; );
// harmonics only: takes out of a saturated band (h) the part that still follows the band itself (x), measured over
// 30 ms, so COLOUR adds harmonics without turning the band down
function hfund(h, x) instance(cxy, cxx) (
  cxy += (h * x - cxy) * cg_cr; cxx += (x * x - cxx) * cg_cr;
  h - x * (cxx > 0.000000000001 ? cxy / cxx : 1);
);
// IRON + COLOUR on one oversampled sample (per-channel filter states in the instance)
function colour_run(u) instance(ip, rp, bp, ep, hc, lc, ic) local(lo, hi, bl, di, dr, dd, y, band, ev, eb) (
  lo = this.ip.op_lp(u, cg_iron);                         // iron band, below ~150 Hz
  hi = u - this.rp.op_lp(u, cg_red);                       // HIGH band, above 3 kHz - 1 kHz (TEXTURE)
  bl = this.bp.op_lp(u, cg_blue);                          // LOW band, below ~300 Hz
  di = this.ic.hfund(sdiff(lo, k_iron, 0.12, sd_i) + lo, lo);   // the iron's harmonics, the lows' level kept
  // LOW: mostly the even part too (warmth, the bass's octave), with some odd for grip; keeps the low end's level
  eb = (sat3(k_col * bl + 0.35) + sat3(0.35 - k_col * bl) - 2 * sat3(0.35)) / (2 * k_col * sd_b);
  dd = a_lo * (1.5 * eb + 0.4 * this.lc.hfund(sdiff(bl, k_col, 0, 1) + bl, bl));
  // HIGH: mostly the even (2nd-harmonic) part, high-passed, so the top gains sheen instead of losing its peaks
  ev = (sat3(k_red * hi + 0.4) + sat3(0.4 - k_red * hi) - 2 * sat3(0.4)) / (2 * k_red * sd_e);
  ev -= this.ep.op_lp(ev, cg_red);
  dr = a_hi * (2 * ev + 0.2 * this.hc.hfund(sdiff(hi, k_red, 0, 1) + hi, hi));
  // the LOW / HIGH harmonics are handed to cw_add() (their own widths); the dry and IRON stay here
  this.dlo = w_blue * dd; this.dhi = w_red * dr;
  y = u + di + w_red * sh_hi * hi + w_blue * sh_lo * bl;   // + the bands' lift (a gentle shelf each)
  // SOLO: only the band being worked on (the COLOUR bands, or IRON's when COLOUR is off)
  band = max(1 - w_red - w_blue, 0) * (lo + di) + w_red * hi + w_blue * bl;
  y + so_s * (band - y);
);
// COLOUR widths: the added harmonics in M / S. 0 % = centre only, 100 % = as made, 200 % = sides only
function cw_add() local(m, d) (
  m = 0.5 * (chL.dlo + chR.dlo); d = 0.5 * (chL.dlo - chR.dlo);
  cwa = m * lwm_g + d * lws_g; cwb = m * lwm_g - d * lws_g;
  m = 0.5 * (chL.dhi + chR.dhi); d = 0.5 * (chL.dhi - chR.dhi);
  cwa += m * hwm_g + d * hws_g; cwb += m * hwm_g - d * hws_g;
);
function colour_coefs(f) local(g) (
  g = tan($pi * 150 / (srate * f)); cg_iron = g / (1 + g);
  g = tan($pi * 3000 * 2 ^ (-1.6 * tex_s) / (srate * f)); cg_red = g / (1 + g); tex_r = tex_s;
  g = tan($pi * 300 / (srate * f)); cg_blue = g / (1 + g);
  cg_cr = 1 - exp(-1 / (0.03 * srate * f));
);

function set_rate() local(g) (
  la_n = ceil(0.0015 * srate);                // look-ahead length (moving average)
  la_w = la_n + 1;                            // sliding-minimum window
  la_d = la_n + 7;                            // audio delay (the true-peak detector looks 7 samples back)
  c_sw = coef(0.015); c_rms = coef(0.015); c_kn = coef(0.03); c_lk = coef(0.01);
  dip_c = 1 / (0.005 * srate);
  c_vu = coef(0.3);
  sc_tw = tan($pi * 10 / srate);
  dc_c = 1 - 2 * $pi * 5 / srate;
  g = tan($pi * 1500 / srate); dp_g = g / (1 + g);
  zl_att = coef(0.0001);
);

// parameters derived from the sliders: run from @slider and every @block (panel moves don't trigger @slider)
function bx_params() (
  rat_t = ratio_i == 0 ? 1.5 : ratio_i == 1 ? 2 : ratio_i == 2 ? 3 : ratio_i == 3 ? 4 : ratio_i == 4 ? 6 : 8;
  sc_f = schpf == 1 ? 60 : schpf == 2 ? 100 : schpf == 3 ? 150 : schpf == 4 ? 250 : 10;
  sc_tt = tan($pi * sc_f / srate);
  c_att = coef(att_ms * 0.001);
  c_rel = coef(rel_ms * 0.001);
  c_af = coef(0.08); c_as = coef(2.0); c_aa = coef(0.4);  // AUTO: fast release, slow release, slow build-up
  ceil_t = db2g(lim_ceil);
  lr_t = lim_rel ? 0.35 : 0.06;
  in_setup(trim_db, guard);
  os_tf = os_f2n(os_sl);
  sidehpf ? sh_tw = tan($pi * (sidehpf == 1 ? 80 : sidehpf == 2 ? 120 : 200) / srate);
);

function clear_lim() (
  memset(DLINE, 0, 2048); memset(GHIST, 0, 1024);
  dq_h = dq_t = 0; g_sum = 0; g_rl = 1;
  wp = 0; tn = 0;
  memset(TPH, 0, 64); tp_w = 0;
  k = 0; loop(1024, GHIST[k] = 1; k += 1; ); g_sum = la_n;
  zl_env = 0;
);

in_init();
sd_e = sat3d(0.4); sd_i = sat3d(0.12); sd_r = sat3d(0.05); sd_b = sat3d(0.35);
os_design();
os_f = os_tf = os_f2n(os_sl);
colour_coefs(os_f);
tp_design();
set_rate();
clear_lim();

ms_on = msmode; brk_on = brick;
dip_g = 1; dip_hold = 0; rs_f = 1; rs_c = 1 / (0.015 * srate); dw = 0; memset(DRY, 0, 2048);
os_base = brk_on ? la_d : 0;
os_gsetup();

env_fa = env_fb = env_sa = env_sb = 0;
fb_ga = fb_gb = 0; fbs_a = fbs_b = 0;
env_ffa = env_ffb = 0;
rq_a = rq_b = rq_fa = rq_fb = 0; rms_s = rmsdet;
yfa = yfb = 0;
thr_s = thr_db; rat_s = 2; mk_s = db2g(mkup_db); bl_s = blend_pc / 100;
top_s = topo; lk_s = lnk; cin_s = comp_in; lin_s = lim_in; ceil_s = db2g(lim_ceil);
sc_gw = sc_tw; sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
lr_s = 0.06;
w_red = colour & 1; w_blue = (colour & 2) > 0; tex_s = texture * 0.01;
lw_s = lo_wid * 0.01; hw_s = hi_wid * 0.01;
wid_s = width_pc * 0.01; dep_s = depth_pc * 0.01; shp_s = sidehpf > 0;
sh_gw = sh_tw = tan($pi * 80 / srate); sh_h = 1 / (1 + sh_gw * (sh_gw + 1.4142135623730951));

// ---------- presets (TRIM, GUARD and OS stay as they are) ----------
#bx_pmn = "Init|Mix Bus Glue|Gentle Master|Drum Bus Smash|M/S Tighten|Warm Low Master|High Sheen Mix|Wide and Open|Vocal Bus Smooth|Loud and Safe|Parallel Crush";
function load_preset(p) local(i) (
  thr_db = -18; ratio_i = 1; att_ms = 10; rel_ms = 300; rel_auto = 0; mkup_db = 0; blend_pc = 100; topo = 0; rmsdet = 0;
  schpf = 0; msmode = 0; lnk = 1; comp_in = 1; lim_ceil = -1; lim_rel = 0; brick = 0; lim_in = 0;
  colour = 0; texture = 30; lo_wid = 100; hi_wid = 100; width_pc = 100; depth_pc = 0; sidehpf = 0;
  p == 2 ? ( thr_db = -24; ratio_i = 0; att_ms = 30; rel_auto = 1; mkup_db = 2; topo = 1; schpf = 2; ) :
  p == 3 ? ( thr_db = -20; ratio_i = 0; att_ms = 30; rel_ms = 600; mkup_db = 1.5; schpf = 1; lim_in = 1; brick = 1; texture = 20; ) :
  p == 4 ? ( thr_db = -30; ratio_i = 3; att_ms = 3; rel_ms = 120; mkup_db = 6; blend_pc = 50; colour = 1; texture = 60; ) :
  p == 5 ? ( msmode = 1; lnk = 0; thr_db = -22; att_ms = 15; rel_auto = 1; mkup_db = 2; sidehpf = 2; width_pc = 110; ) :
  p == 6 ? ( thr_db = -22; att_ms = 20; rel_auto = 1; mkup_db = 2; colour = 2; texture = 45; lim_in = 1; brick = 1; ) :
  p == 7 ? ( thr_db = -24; ratio_i = 0; att_ms = 30; rel_auto = 1; mkup_db = 1.5; colour = 1; texture = 50; depth_pc = 30; ) :
  p == 8 ? ( thr_db = -20; ratio_i = 0; rel_auto = 1; mkup_db = 1; width_pc = 130; depth_pc = 40; sidehpf = 2; ) :
  p == 9 ? ( topo = 1; thr_db = -26; ratio_i = 2; att_ms = 8; rel_ms = 200; mkup_db = 4; colour = 1; texture = 25; ) :
  p == 10 ? ( thr_db = -26; ratio_i = 3; att_ms = 10; rel_auto = 1; mkup_db = 5; lim_in = 1; brick = 1; lim_ceil = -0.3;
              colour = 2; texture = 40; schpf = 2; ) :
  p == 11 ? ( thr_db = -40; ratio_i = 5; att_ms = 1; rel_ms = 80; mkup_db = 12; blend_pc = 35; );
  i = 1; loop(27, i != 17 && i != 18 && i != 21 && i != 25 ? ui_auto(i); i += 1; );
  ui_auto(29);
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;                               // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );               // new instances open in Medium, on Init
ui_dflt = 1;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@slider
bx_params();

@block
bx_params();
// resume after REAPER's bypass (or any gap in processing): the buffers hold stale audio, so @sample clears them
// and fades in from the dry signal
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? rs_req = 1;
rs_last = rs_now;
// the track's other channels (3 and up, e.g. stems on a multichannel bus) pass through untouched but delayed by
// the same latency, so everything on the track stays in time
xn = min(num_ch, 64) - 2;
pdc_bot_ch = 0; pdc_top_ch = 2 + max(xn, 0);
c_lra = coef(lr_s);

@sample
rs_req ? (
  rs_req = 0; rs_f = 0; rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay;
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  chL.ip.s = chL.rp.s = chL.bp.s = chL.ep.s = chR.ip.s = chR.rp.s = chR.bp.s = chR.ep.s = 0;
  chL.hc.cxy = chL.hc.cxx = chL.lc.cxy = chL.lc.cxx = chR.hc.cxy = chR.hc.cxx = chR.lc.cxy = chR.lc.cxx = 0;
  chL.ic.cxy = chL.ic.cxx = chR.ic.cxy = chR.ic.cxx = 0;
  memset(DLINE, 0, 2048); memset(DRY, 0, 2048);   // the limiter keeps its gain: the best guess for now
  memset(XCH, 0, 62 * 1024);
);
rw_l = spl0; rw_r = spl1;
// ---------- swaps that need silence: L/R <-> M/S, limiter type ----------
(ms_on != msmode || brk_on != brick) ? (
  dip_g = max(dip_g - dip_c, 0);
  dip_g == 0 ? (
    ms_on = msmode;                          // the envelopes carry on: no jump in gain
    brk_on != brick ? (
      brk_on = brick; clear_lim();
      os_base = brk_on ? la_d : 0; pdc_delay = os_base + os_lat(os_f);
      dip_hold = pdc_delay + 8 + 2 * samplesblock;   // stay silent while REAPER takes up the new latency
    );
  );
) : dip_hold > 0 ? dip_hold -= 1 : dip_g < 1 ? dip_g = min(dip_g + dip_c, 1);

// ---------- glides ----------
thr_s += (thr_db - thr_s) * c_kn;
rat_s += (rat_t - rat_s) * c_kn;
mk_s += (db2g(mkup_db) - mk_s) * c_kn;
bl_s += (blend_pc * 0.01 - bl_s) * c_kn;
top_s += (topo - top_s) * c_sw;
rms_s += (rmsdet - rms_s) * c_sw; rmsdet < 0.5 && rms_s < 0.000001 ? rms_s = 0;
lk_s += (lnk - lk_s) * c_lk;
cin_s += (comp_in - cin_s) * c_sw;
lin_s += (lim_in - lin_s) * c_sw;
ceil_s += (ceil_t - ceil_s) * c_kn;
lr_s += (lr_t - lr_s) * c_kn;
sc_gw += (sc_tt - sc_gw) * c_kn;
sc_h = 1 / (1 + sc_gw * (sc_gw + 1.4142135623730951));
so_s += (csolo - so_s) * c_sw;
lw_s += (lo_wid * 0.01 - lw_s) * c_kn; hw_s += (hi_wid * 0.01 - hw_s) * c_kn;
lwm_g = min(1, 2 - lw_s); lws_g = min(1, lw_s); hwm_g = min(1, 2 - hw_s); hws_g = min(1, hw_s);
w_red += ((colour & 1) - w_red) * c_kn; w_blue += (((colour & 2) > 0) - w_blue) * c_kn;
tex_s += (texture * 0.01 - tex_s) * c_kn;
// HIGH widens as it is pushed: its band starts at 3 kHz at TEXTURE 0 and comes down to 1 kHz at 100 %
abs(tex_s - tex_r) > 0.0005 ? ( tex_r = tex_s; tx_g = tan($pi * 3000 * 2 ^ (-1.6 * tex_s) / (srate * os_f)); cg_red = tx_g / (1 + tx_g); );
k_iron = db2g(-17 + 27 * tex_s); k_col = db2g(-4 + 10 * tex_s); k_red = db2g(10 * tex_s);   // drive into the iron and the COLOUR bands
a_hi = a_lo = 1 + tex_s;                                     // the COLOUR harmonics grow with TEXTURE
sh_hi = sh_lo = db2g(2.5 * tex_s) - 1;                       // and each band lifts, up to +2.5 dB   // drive into the iron and the COLOUR bands
wid_s += (width_pc * 0.01 - wid_s) * c_kn; dep_s += (depth_pc * 0.01 - dep_s) * c_kn;
shp_s += ((sidehpf > 0) - shp_s) * c_sw;
sh_gw += (sh_tw - sh_gw) * c_kn; sh_h = 1 / (1 + sh_gw * (sh_gw + 1.4142135623730951));
os_gate();
os_chg ? (
  colour_coefs(os_f);
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr();
  chL.ip.s = chL.rp.s = chL.bp.s = chL.ep.s = chR.ip.s = chR.rp.s = chR.bp.s = chR.ep.s = 0;
  chL.hc.cxy = chL.hc.cxx = chL.lc.cxy = chL.lc.cxx = chR.hc.cxy = chR.hc.cxx = chR.lc.cxy = chR.lc.cxx = 0;
  chL.ic.cxy = chL.ic.cxx = chR.ic.cxy = chR.ic.cxx = 0;
  os_hold += 2 * samplesblock;                // stay silent while REAPER takes up the new latency
);

in_process(spl0, spl1);
xl = in_l; xr = in_r;
vms_l += (xl * xl - vms_l) * c_vu; vms_r += (xr * xr - vms_r) * c_vu;   // the VUs' level (after TRIM)
vu_l_disp = vms_l; vu_r_disp = vms_r;

// ---------- compressor ----------
ms_on ? ( xa = 0.5 * (xl + xr); xb = 0.5 * (xl - xr); ) : ( xa = xl; xb = xr; );

sl_ff = 1 - 1 / rat_s; sl_fb = rat_s - 1;
// feed-forward detector: the input
ha = hpa.svf_hp(xa); hb = hpb.svf_hp(xb); da = abs(ha); db = abs(hb);
rq_a += (ha * ha - rq_a) * c_rms; rq_b += (hb * hb - rq_b) * c_rms;      // RMS: always running, so the key never jumps
rms_s > 0 ? ( da += (sqrt(2 * rq_a) - da) * rms_s; db += (sqrt(2 * rq_b) - db) * rms_s; );
dm = max(da, db); da += (dm - da) * lk_s; db += (dm - db) * lk_s;
tga = gcurve(g2db(da) - thr_s, sl_ff, 6); tgb = gcurve(g2db(db) - thr_s, sl_ff, 6);
// feedback detector: its own output (last sample)
hfa = fha.svf_hp(yfa); hfb = fhb.svf_hp(yfb); fa = abs(hfa); fb = abs(hfb);
rq_fa += (hfa * hfa - rq_fa) * c_rms; rq_fb += (hfb * hfb - rq_fb) * c_rms;
rms_s > 0 ? ( fa += (sqrt(2 * rq_fa) - fa) * rms_s; fb += (sqrt(2 * rq_fb) - fb) * rms_s; );
fm = max(fa, fb); fa += (fm - fa) * lk_s; fb += (fm - fb) * lk_s;
tfa = gcurve(g2db(fa) - thr_s, sl_fb, 10); tfb = gcurve(g2db(fb) - thr_s, sl_fb, 10);

// ballistics in dB (AUTO: the larger of a fast-release and a slow, slowly-built envelope)
rel_auto ? (
  env_ffa += (tga - env_ffa) * (tga > env_ffa ? c_att : c_af);
  env_ffb += (tgb - env_ffb) * (tgb > env_ffb ? c_att : c_af);
  env_sa += (tga - env_sa) * (tga > env_sa ? c_aa : c_as);
  env_sb += (tgb - env_sb) * (tgb > env_sb ? c_aa : c_as);
  gra = max(env_ffa, env_sa); grb = max(env_ffb, env_sb);
  fb_ga += (tfa - fb_ga) * (tfa > fb_ga ? c_att : c_af);
  fb_gb += (tfb - fb_gb) * (tfb > fb_gb ? c_att : c_af);
  fbs_a += (tfa - fbs_a) * (tfa > fbs_a ? c_aa : c_as);
  fbs_b += (tfb - fbs_b) * (tfb > fbs_b ? c_aa : c_as);
  gfa = max(fb_ga, fbs_a); gfb = max(fb_gb, fbs_b);
) : (
  // AUTO just switched off: carry its gain reduction over, so it releases instead of jumping
  env_ffa = max(env_ffa, env_sa); env_ffb = max(env_ffb, env_sb);
  fb_ga = max(fb_ga, fbs_a); fb_gb = max(fb_gb, fbs_b);
  env_ffa += (tga - env_ffa) * (tga > env_ffa ? c_att : c_rel);
  env_ffb += (tgb - env_ffb) * (tgb > env_ffb ? c_att : c_rel);
  gra = env_ffa; grb = env_ffb;
  fb_ga += (tfa - fb_ga) * (tfa > fb_ga ? c_att : c_rel);
  fb_gb += (tfb - fb_gb) * (tfb > fb_gb ? c_att : c_rel);
  gfa = fb_ga; gfb = fb_gb;
  env_sa = env_sb = fbs_a = fbs_b = 0;
);
yfa = xa * db2g(-gfa); yfb = xb * db2g(-gfb);

gr_a = gra + (gfa - gra) * top_s; gr_b = grb + (gfb - grb) * top_s;
ga = db2g(-gr_a); gb = db2g(-gr_b);
grc_disp = max(grc_disp, max(gr_a, gr_b) * cin_s);

wa = xa * (1 + bl_s * (ga * mk_s - 1)); wb = xb * (1 + bl_s * (gb * mk_s - 1));
ms_on ? ( cl = wa + wb; cr = wa - wb; ) : ( cl = wa; cr = wb; );
cl = xl + (cl - xl) * cin_s; cr = xr + (cr - xr) * cin_s;

// ---------- IRON + COLOUR (oversampled) ----------
ul.os_up(cl); ur.os_up(cr);
a0 = chL.colour_run(ul.s0); b0 = chR.colour_run(ur.s0); cw_add(); a0 += cwa; b0 += cwb;
os_f == 1 ? (
  cl = a0; cr = b0;
) : (
  a1 = chL.colour_run(ul.s1); b1 = chR.colour_run(ur.s1); cw_add(); a1 += cwa; b1 += cwb;
  os_f == 2 ? (
    cl = dl_.os_dn(a0, a1, 0, 0); cr = dr_.os_dn(b0, b1, 0, 0);
  ) : (
    a2 = chL.colour_run(ul.s2); b2 = chR.colour_run(ur.s2); cw_add(); a2 += cwa; b2 += cwb;
    a3 = chL.colour_run(ul.s3); b3 = chR.colour_run(ur.s3); cw_add(); a3 += cwa; b3 += cwb;
    cl = dl_.os_dn(a0, a1, a2, a3); cr = dr_.os_dn(b0, b1, b2, b3);
  );
);
// DC blocker (5 Hz): the 2nd harmonic's offset
dcv = cl - dcx_l + dc_c * dcy_l; dcx_l = cl; dcy_l = dcv; cl = dcv;
dcv = cr - dcx_r + dc_c * dcy_r; dcx_r = cr; dcy_r = dcv; cr = dcv;

// ---------- stereo field ----------
sm = 0.5 * (cl + cr); ss = 0.5 * (cl - cr);
ss += (shp.svf_hp2(ss) - ss) * shp_s;                    // SIDE HPF
ss += (ss - dpf.op_lp(ss, dp_g)) * (db2g(4 * dep_s) - 1); // DEPTH: the Side's top, +/-4 dB
ss *= wid_s;
cl = sm + ss; cr = sm - ss;

// ---------- limiter ----------
brk_on ? (
  // true peak of the incoming sample pair, as a gain the next la_w samples must not exceed
  pk = max(tp_peak(0, cl), tp_peak(1, cr)); tp_w += 1;
  gq = pk > ceil_s ? ceil_s / pk : 1;
  // sliding minimum over la_w samples
  while (dq_t > dq_h && DQV[(dq_t - 1) & RMASK] >= gq) ( dq_t -= 1; );
  DQV[dq_t & RMASK] = gq; DQI[dq_t & RMASK] = tn; dq_t += 1;
  while (DQI[dq_h & RMASK] <= tn - la_w) ( dq_h += 1; );
  gmin = DQV[dq_h & RMASK];
  // release (never above the minimum), then a moving average over la_n samples
  g_rl = gmin < g_rl ? gmin : g_rl + (gmin - g_rl) * c_lra;
  g_sum += g_rl - GHIST[(wp - la_n) & RMASK]; GHIST[wp & RMASK] = g_rl;
  lg = g_sum / la_n;
  // the delayed audio
  DLINE[wp & RMASK] = cl; DLINE[1024 + (wp & RMASK)] = cr;
  dl = DLINE[(wp - la_d) & RMASK]; dr = DLINE[1024 + ((wp - la_d) & RMASK)];
  wp += 1; tn += 1;
  (wp & 65535) == 0 ? ( g_sum = 0; k = 0; loop(la_n, g_sum += GHIST[(wp - 1 - k) & RMASK]; k += 1; ); );
  lg = min(lg, 1);
  ol = dl * (1 + lin_s * (lg - 1)); orr = dr * (1 + lin_s * (lg - 1));
  // the last safety: never a sample over the ceiling
  lin_s > 0.999 ? ( ol = max(min(ol, ceil_s), -ceil_s); orr = max(min(orr, ceil_s), -ceil_s); );
) : (
  pk = max(abs(cl), abs(cr));
  zo = g2db(pk) - g2db(ceil_s);
  zt = gcurve(zo, 1, 2);
  zl_env = zt > zl_env ? zt : zl_env + (zt - zl_env) * c_lra;     // instant attack: no look-ahead to hide it
  lg = db2g(-zl_env);
  ol = cl * (1 + lin_s * (lg - 1)); orr = cr * (1 + lin_s * (lg - 1));
);
lgr_disp = max(lgr_disp, -g2db(lg) * lin_s);

dip_s = min(dip_g, os_g); dip_s *= dip_s * (3 - 2 * dip_s);   // an S-curve dip: no corners
spl0 = ol * dip_s; spl1 = orr * dip_s;
// the resume fade: the dry input (as REAPER's bypass passed it, delayed by the latency) into the processed sound
DRY[dw] = rw_l; DRY[1024 + dw] = rw_r;
// For the first (latency) samples nothing delayed exists yet, so the undelayed input plays, then crossfades (5 ms)
// to the delayed one while the processed sound comes in (15 ms)
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
  rs_s = rs_f * rs_f * (3 - 2 * rs_f); rs_xs = rs_x * rs_x * (3 - 2 * rs_x);
  rs_dl = rw_l + (DRY[(dw - pdc_delay) & RMASK] - rw_l) * rs_xs;
  rs_dr = rw_r + (DRY[1024 + ((dw - pdc_delay) & RMASK)] - rw_r) * rs_xs;
  spl0 = rs_dl + (spl0 - rs_dl) * rs_s; spl1 = rs_dr + (spl1 - rs_dr) * rs_s;
);
// BYPASS: crossfades (15 ms) to the dry input, delayed by the latency so it stays in time
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? (
  rs_dl = DRY[(dw - pdc_delay) & RMASK]; rs_dr = DRY[1024 + ((dw - pdc_delay) & RMASK)];
  spl0 += (rs_dl - spl0) * by_s; spl1 += (rs_dr - spl1) * by_s;
);
xn > 0 ? (
  xs = rs_f < 1 ? rs_xs : 1; k = 0;
  loop(xn,
    XCH[k * 1024 + dw] = spl(k + 2);
    spl(k + 2) = (spl(k + 2) + (XCH[k * 1024 + ((dw - pdc_delay) & RMASK)] - spl(k + 2)) * xs) * dip_s;
    k += 1;
  );
);
dw = (dw + 1) & RMASK;
mo_l_d = max(mo_l_d, abs(spl0)); mo_r_d = max(mo_r_d, abs(spl1));
lat_disp = pdc_delay;

@gfx 1080 500
ui_begin(1080, 500);
// =====================================================================
// GUI (design space 1080 x 500; S / M / L = 85 / 100 / 130 %). Graphite faceplate, cream print, two blues (deep:
// the main caps and the section name plates; light: the header rule, value accents, the secondary caps).
// Two plates: the controls (COMPRESSOR | COLOUR | STEREO FIELD | LIMITER) and the meters (TRIM, IN, GR, OUT).
// =====================================================================
BG = 0x26282B; HDR = 0x1D1F22; PL = 0x33363A; PLD = 0x2B2E31; INK = 0xEDE6D2; DIM = 0xA9A391;
BDEEP = 0x2D5E96; BLITE = 0x8DBBEA;
sc != bx_lsc ? (
  bx_lsc = sc;
  bx_f2 = ui_fitfont(2, 14 * sc);                    // knob labels / values: 14 px (the house 12.5 was too small)
  gfx_setfont(10, "Trebuchet MS", 30 * sc, 'b');     // the unit's name
  gfx_setfont(11, "Trebuchet MS", 15 * sc, 'b');     // section titles
  gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');     // small print
  gfx_setfont(14, "Trebuchet MS", 14 * sc, 'b');     // key legends, display boxes
  gfx_setfont(15, "Trebuchet MS", 18 * sc, 'b');     // the OUT peak figure
);
gfx_setfont(2, "Trebuchet MS", bx_f2, 'b'); gfx_setfont(3, "Trebuchet MS", bx_f2, 'b');
C_INK = INK; lk_font = 14; lk_font2 = 14; lk_well = 0x111214;

function bx_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function bx_rr(x, y, w, h, r) ( ui_rrs(x * sc, y * sc, w * sc, h * sc, r * sc); );
function bx_tl(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function bx_tc(cx, y, s) ( ui_text(cx * sc, y * sc, s); );
function bx_tr(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = y * sc; gfx_drawstr(s); );
function bx_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// soft drop shadow, light from the top left: 4 layers, (+2, +3) to (+6, +8)
function bx_shadow(x, y, w, h, r) local(j) (
  j = 0; loop(4, ui_cola(0x000000, 0.13); bx_rr(x + 2 + j * 1.3, y + 3 + j * 1.7, w + j * 0.4, h + j * 0.4, r + j); j += 1; );
);
// a plate: shadow, a light top / left edge, a dark bottom / right edge (one pixel each, drawn once)
function bx_plate(x, y, w, h) (
  bx_shadow(x, y, w, h, 6);
  ui_col(0x16171A); bx_rr(x, y, w, h, 6);
  ui_col(0x4A4E53); bx_rr(x, y, w - 1, h - 1, 6);
  ui_col(PL); bx_rr(x + 1, y + 1, w - 2.5, h - 2.5, 5);
  gfx_gradrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, h * 0.4 * sc, 1, 1, 1, 0.05, 0, 0, 0, 0, 0, 0, 0, -0.05 / (h * 0.4 * sc));
);
// a section header band: the name on a deep-blue plate, a light-blue line under the band
function bx_head(x, w, title) local(tw, th) (
  ui_col(PLD); bx_r(x + 1, 81, w - 2, 32);
  ui_cola(BLITE, 0.55); bx_r(x + 1, 113, w - 2, 1);
  gfx_setfont(11); gfx_measurestr(title, tw, th);
  ui_col(0x1B3C61); bx_rr(x + 11, 85, tw / sc + 22, 24, 4);
  ui_col(BDEEP); bx_rr(x + 12, 86, tw / sc + 20, 22, 3);
  ui_col(INK); gfx_x = (x + 22) * sc; gfx_y = 97 * sc - th * 0.5; gfx_drawstr(title);
);
// a divider between two sections: a dark and a light hairline
function bx_div(x) ( ui_col(0x1E2023); bx_r(x, 82, 1, 268); ui_cola(0xFFFFFF, 0.07); bx_r(x + 1, 82, 1, 268); );
// a dark recessed display box with light print: the current item and a down-pointing triangle; a click opens the
// list (items "a|b|c", 0-based v). Its name sits above it. Returns the chosen index or -1.
function bx_box(x, y, w, h, name, menu, v) local(hov, sel, n, i, tw, th) (
  hov = bx_in(x, y, w, h);
  gfx_setfont(13); ui_col(DIM); bx_tc(x + w * 0.5, y - 17, name);
  ui_col(0x0E0F11); bx_rr(x - 1, y - 1, w + 2, h + 2, 4);
  ui_col(0x17191C); bx_rr(x, y, w, h, 3);
  ui_cola(0x000000, 0.5); bx_r(x + 1, y + 1, w - 2, 2);              // shaded top, as if recessed
  hov ? ( ui_cola(0xFFFFFF, 0.06); bx_rr(x, y, w, h, 3); );
  pk_pitem(menu, v + 1, #bx_di);
  gfx_setfont(14); ui_col(BLITE); gfx_measurestr(#bx_di, tw, th);
  gfx_x = (x + (w - 14) * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5) * sc - th * 0.5; gfx_drawstr(#bx_di);
  ui_col(DIM); ui_sstri((x + w - 17) * sc, (y + h * 0.5 - 3) * sc, (x + w - 7) * sc, (y + h * 0.5 - 3) * sc, (x + w - 12) * sc, (y + h * 0.5 + 3) * sc);
  sel = -1;
  pressed && hov && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#bx_dm, ""); n = pk_pcount(menu); i = 1;
    loop(n, i == v + 1 ? strcat(#bx_dm, "!"); strcat(#bx_dm, pk_pitem(menu, i, #bx_dt)); i < n ? strcat(#bx_dm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#bx_dm); i > 0 ? sel = i - 1;
  );
  sel;
);
// a desk knob (ui_knob does the mouse, the value on touch and the label)
function bx_kn(cx, cy, r, idx, lo, hi, def, lg, cap, lbl, fmt) (
  ui_kdesk = cap; ui_kdesk_r = r; ui_kdesk_p = 0;
  ui_knob(cx * sc, cy * sc, idx, lo, hi, def, lg, lbl, fmt);
  ui_kdesk = 0; ui_kdesk_r = 0;
);
// a WIDTH dial: M (mono) / C (as is) / S (sides) printed in place of the end and centre dots, one dot between
function bx_wkn(cx, cy, r, idx) local(a, k) (
  ui_kdesk_d = 4; ui_kdesk_x = 1; bx_kn(cx, cy, r, idx, 0, 200, 100, 0, BLITE, "WIDTH", "%.0f %%");
  gfx_setfont(13); ui_col(BLITE); k = 0;
  loop(3, a = -0.75 * $pi + k * 0.75 * $pi;
    bx_tc(cx + sin(a) * (r + 8) + (k - 1) * 3, cy - cos(a) * (r + 8) - (k == 1 ? 7 : 10), k == 0 ? "M" : k == 1 ? "C" : "S");
    k += 1; );
);
// a small "0" printed outside a dial at the normalised position n
function bx_zero(cx, cy, r, n) local(a) (
  a = -0.75 * $pi + n * 1.5 * $pi; gfx_setfont(13); ui_col(BLITE);
  bx_tc(cx + sin(a) * (r + 17), cy - cos(a) * (r + 17) - 7, "0");
);
// a lamp key from its slider: lit = on; the click toggles
function bx_key(x, y, w, h, idx, col, s) (
  lk_key(x, y, w, h, slider(idx) >= 0.5, col, s) ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
);
// a GR bar: 20 segments of 1 dB, from the left
function bx_gr(x, y, w, h, gr, col) local(i, c, lit) (
  ui_col(0x0A0A0B); bx_r(x - 2, y - 2, w + 4, h + 4);
  c = w / 20; i = 0;
  loop(20,
    lit = gr >= i + 0.5;
    lit ? ( ui_cola(col, 0.3); bx_r(x + i * c - 0.5, y - 1, c, h + 2); ui_col(col); ) : ui_cola(col, 0.12);
    bx_r(x + i * c + 0.5, y, c - 1.5, h);
    i += 1;
  );
);

// ---------- the meters' hand-off (the audio thread fills, the panel takes and clears) ----------
bx_grc = max(grc_disp, bx_grc * 0.85); grc_disp = 0;
bx_grl = max(lgr_disp, bx_grl * 0.85); lgr_disp = 0;
bx_ol = mo_l_d; bx_or = mo_r_d; mo_l_d = mo_r_d = 0;

// ---------- faceplate and header ----------
ui_col(BG); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(HDR); bx_r(0, 0, 1080, 64);
ui_col(BLITE); bx_r(0, 63, 1080, 2); ui_col(0x101113); bx_r(0, 65, 1080, 1);
ui_cola(0x000000, 0.35); bx_r(1077, 0, 3, 500); bx_r(0, 497, 1080, 3);       // a narrow darker right / bottom edge
ui_screw(9 * sc, 9 * sc); ui_screw((1080 - 9) * sc, 9 * sc); ui_screw(9 * sc, (500 - 9) * sc); ui_screw((1080 - 9) * sc, (500 - 9) * sc);
// the GFX roundel, the name
ui_col(INK); gfx_circle(40 * sc, 32 * sc, 16 * sc, 1, 1);
gfx_setfont(13); ui_col(HDR); ui_keytext(40 * sc, 32 * sc, "GFX");
gfx_setfont(10); ui_col(INK); bx_tl(68, 15, "SIFON"); gfx_measurestr("SIFON", bx_tw, bx_th);
gfx_setfont(13); ui_col(BLITE); bx_tl(82 + bx_tw / sc, 20, "BUS"); bx_tl(82 + bx_tw / sc, 34, "COMPRESSOR");
bx_k = pk_preset(340 * sc, 15 * sc, 290 * sc, 34 * sc, pr_cur, #bx_pmn);
bx_k > 0 ? load_preset(bx_k);
os_key(960, 21, 21, INK, 12);
bx_key(830, 20, 84, 26, 28, LK_WHT, "BYPASS");
ui_size_picker(998 * sc, 23 * sc);

// ---------- the controls plate ----------
bx_plate(16, 80, 1048, 272);
bx_head(16, 472, "COMPRESSOR"); bx_head(488, 180, "COLOUR"); bx_head(668, 196, "STEREO FIELD"); bx_head(864, 200, "LIMITER");
bx_div(488); bx_div(668); bx_div(864);

// COMPRESSOR
bx_kn(76, 178, 30, 1, -40, 0, -18, 0, BDEEP, "THRESHOLD", "%.1f dB");
bx_zero(76, 178, 30, 22 / 40);                        // 0 VU (-18 dBFS)
bx_kn(168, 178, 20, 3, 0.1, 75, 10, 1, BDEEP, "ATTACK", "%.1f ms");
bx_kn(248, 178, 20, 4, 50, 2500, 300, 1, BDEEP, "RELEASE", "%.0f ms");
bx_kn(328, 178, 20, 6, 0, 20, 0, 0, BDEEP, "MAKE-UP", "+%.1f dB");
bx_kn(408, 178, 20, 7, 0, 100, 100, 0, BDEEP, "BLEND", "%.0f %%");
bx_v = bx_box(36, 264, 96, 30, "RATIO", "1.5 : 1|2 : 1|3 : 1|4 : 1|6 : 1|8 : 1", ratio_i);
bx_v >= 0 ? ( ratio_i = bx_v; ui_auto(2); );
bx_v = bx_box(148, 264, 96, 30, "SC HPF", "OFF|60 Hz|100 Hz|150 Hz|250 Hz", schpf);
bx_v >= 0 ? ( schpf = bx_v; ui_auto(9); );
bx_key(272, 262, 96, 32, 8, LK_BLU_LT, "FEEDBACK");
bx_key(384, 262, 84, 32, 5, LK_BLU_LT, "AUTO");
bx_key(272, 308, 96, 32, 11, LK_BLU_LT, "LINK");
bx_key(384, 308, 84, 32, 10, LK_BLU_LT, "M/S");
bx_key(148, 308, 96, 32, 29, LK_BLU_LT, "RMS");

// COLOUR (IRON is always on)
lk_key(584, 130, 66, 34, colour & 1, LK_RED, "HIGH") ? ( colour = colour ~ 1; ui_auto(19); );
lk_key(506, 130, 66, 34, (colour & 2) > 0, LK_BLU_LT, "LOW") ? ( colour = colour ~ 2; ui_auto(19); );
bx_kn(578, 206, 26, 20, 0, 100, 30, 0, BLITE, "TEXTURE", "%.0f %%");
bx_wkn(539, 296, 14, 26);
bx_wkn(617, 296, 14, 27);
bx_key(596, 86, 60, 22, 25, LK_YEL, "SOLO");

// STEREO FIELD
bx_wkn(718, 178, 20, 22);
bx_kn(814, 178, 20, 23, -100, 100, 0, 0, BLITE, "DEPTH", "%+.0f %%");
bx_zero(814, 178, 20, 0.5);
bx_v = bx_box(706, 264, 120, 30, "SIDE HPF", "OFF|80 Hz|120 Hz|200 Hz", sidehpf);
bx_v >= 0 ? ( sidehpf = bx_v; ui_auto(24); );

// LIMITER
bx_kn(920, 184, 26, 13, -12, 0, -1, 0, BDEEP, "CEILING", "%.1f dB");
bx_key(984, 140, 64, 32, 14, LK_BLU_LT, "SLOW");
bx_key(984, 190, 64, 32, 15, LK_BLU_LT, "BRICK");
gfx_setfont(13); ui_col(DIM);
bx_tc(964, 264, brick ? "BRICKWALL: TRUE PEAK" : "ZERO LATENCY");
sprintf(#bx_s, "LATENCY %d SAMPLES", lat_disp); bx_tc(964, 284, #bx_s);

// a switched-off section: greyed, its IN key drawn on top
!comp_in ? ( ui_cola(PL, 0.5); bx_r(17, 114, 470, 236); );
!lim_in ? ( ui_cola(PL, 0.5); bx_r(865, 114, 198, 236); );
lk_font = lk_font2 = 13;
bx_key(424, 86, 52, 22, 12, LK_AMB, "IN");
bx_key(1000, 86, 52, 22, 16, LK_AMB, "IN");
lk_font = lk_font2 = 14;

// ---------- the meters plate ----------
bx_plate(16, 368, 1048, 116);
// TRIM + GUARD
ui_kdesk = 0x4A4D52; ui_kdesk_r = 16; ui_knob(52 * sc, 400 * sc, 17, -24, 12, 0, 0, "TRIM", "%+.1f dB"); ui_kdesk = 0; ui_kdesk_r = 0;
lk_font = lk_font2 = 13; bx_key(24, 448, 56, 24, 18, LK_AMB, "GUARD"); lk_font = lk_font2 = 14;
// IN: a VU pair
bx_vl = vu_l_disp; bx_vr = vu_r_disp;
vuL.ui_vu(98 * sc, 378 * sc, 146 * sc, 96 * sc, 10 * log10(max(bx_vl, 0.0000000001)) + 18, "L");
vuR.ui_vu(252 * sc, 378 * sc, 146 * sc, 96 * sc, 10 * log10(max(bx_vr, 0.0000000001)) + 18, "R");
// GR
gfx_setfont(13); ui_col(DIM); bx_tl(428, 378, "GAIN REDUCTION (dB)");
ui_col(INK); bx_tl(428, 404, "COMP"); bx_tl(428, 440, "LIMIT");
bx_gr(484, 404, 200, 14, bx_grc, 0xE0463A);
bx_gr(484, 440, 200, 14, bx_grl, 0xF2A41E);
ui_col(DIM); bx_i = 0;
loop(5, bx_n = bx_i == 0 ? 0 : bx_i == 1 ? 3 : bx_i == 2 ? 6 : bx_i == 3 ? 10 : 20;
  sprintf(#bx_s, "%d", bx_n); bx_tc(484 + bx_n * 10 - (bx_n == 20 ? 6 : 0) + (bx_n == 0 ? 4 : 0), 422, #bx_s); bx_i += 1; );
// OUT: L and R rows, the floating peak and its figure
gfx_setfont(13); ui_col(DIM); bx_tl(720, 378, "OUT (dBFS)");
ui_col(INK); bx_tl(720, 403, "L"); bx_tl(720, 431, "R");
mOL.ui_ledm(740 * sc, 404 * sc, 236 * sc, 14 * sc, bx_ol); mOR.ui_ledm(740 * sc, 432 * sc, 236 * sc, 14 * sc, bx_or);
gfx_setfont(13); ui_col(DIM);
bx_tc(740 + 236 * 2 / 15, 452, "-36"); bx_tc(740 + 236 * 6 / 15, 452, "-24"); bx_tc(740 + 236 * 10 / 15, 452, "-12");
bx_tc(740 + 236 * 14 / 15, 452, "0");
bx_pk = max(mOL.hold, mOR.hold);
gfx_setfont(15); ui_col(bx_pk > -0.05 ? 0xFF5A4A : INK);
bx_pk > -60 ? sprintf(#bx_s, "%.1f", bx_pk) : strcpy(#bx_s, "--"); bx_tr(1048, 412, #bx_s);
gfx_setfont(13); ui_col(DIM); bx_tr(1048, 440, "PEAK");

pk_end();
ui_end();
