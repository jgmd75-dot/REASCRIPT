rg_tl(rg_px(28), rg_py(224), rg_p == 0 ? "saturation diodes and" : rg_p == 1 ? "tone and a micro / fat" : rg_p == 2 ? "second stage, one EQ" : rg_p == 3 ? "a three-band tone" : "boost, a parametric");
rg_tl(rg_px(28), rg_py(242), rg_p == 0 ? "a three-band tone" : rg_p == 1 ? "voicing" : rg_p == 2 ? "tilt" : rg_p == 3 ? "stack" : "and a spring reverb");

rg_x0 = 208;  rg_y0 = 74;
rg_p == 0 ? (
  rg_module(rg_x0, rg_y0, 856, 220, 0, "DESERT TEN", "PREAMP  -  OP-AMP, DIODES");
  rg_kn(rg_x0 + 100, rg_y0 + 120, 32, rpi(18), 0, 10, 5, rg_ks, 0xE6E0D0, "PRE", "%.1f");
  rg_tog(rg_x0 + 190, rg_y0 + 104, 130, 30, rpi(19), rg_kc, "SATURATION");
  rg_div(rg_x0 + 360, rg_y0 + 50, rg_y0 + 196);
  rg_kn(rg_x0 + 460, rg_y0 + 120, 24, rpi(20), 0, 10, 5, rg_ks, 0x75787D, "LOW", "%.1f");
  rg_kn(rg_x0 + 580, rg_y0 + 120, 24, rpi(21), 0, 10, 5, rg_ks, 0x75787D, "MID", "%.1f");
  rg_kn(rg_x0 + 700, rg_y0 + 120, 24, rpi(22), 0, 10, 5, rg_ks, 0x75787D, "HIGH", "%.1f");
) : rg_p == 1 ? (
  rg_c = slider(rpi(24)) >= 0.5;
  rg_module(rg_x0, rg_y0, 856, 220, 1 + rg_c, "MT-15", "PREAMP  -  ONE 12AX7");
  rg_small(rg_x0 + 82, rg_y0 + 58, "VOICING");
  rg_rad(rg_x0 + 32, rg_y0 + 76, 100, 30, rpi(24), 0, rg_kc, "MICRO");
  rg_rad(rg_x0 + 32, rg_y0 + 124, 100, 30, rpi(24), 1, rg_kc, "FAT");
  rg_div(rg_x0 + 170, rg_y0 + 50, rg_y0 + 190);
  rg_kn(rg_x0 + 300, rg_y0 + 116, 32, rpi(25), 0, 10, 5, rg_ks, 0, "GAIN", "%.1f");
  rg_kn(rg_x0 + 460, rg_y0 + 116, 26, rpi(26), 0, 10, 5, rg_ks, 0, "TONE", "%.1f");
) : rg_p == 2 ? (
  rg_module(rg_x0, rg_y0, 856, 220, 3, "APE 20", "PREAMP  -  DIODE CLIPPING");
  rg_kn(rg_x0 + 140, rg_y0 + 116, 32, rpi(29), 0, 10, 5, rg_ks, 0, "DRIVE", "%.1f");
  rg_kzero = 1;  rg_kn(rg_x0 + 300, rg_y0 + 116, 26, rpi(30), -5, 5, 0, rg_ks, 0, "EQ", "%+.1f");
  rg_small(rg_x0 + 300, rg_y0 + 178, "DARK  -  BRIGHT");
) : rg_p == 3 ? (
  rg_module(rg_x0, rg_y0, 856, 220, 3, "SPRITE 10", "PREAMP  -  TWO INPUTS");
  rg_small(rg_x0 + 92, rg_y0 + 58, "INPUT");
  rg_rad(rg_x0 + 32, rg_y0 + 76, 120, 30, rpi(31), 1, rg_kc, "OVERDRIVE");
  rg_rad(rg_x0 + 32, rg_y0 + 124, 120, 30, rpi(31), 0, rg_kc, "NORMAL");
  rg_div(rg_x0 + 190, rg_y0 + 50, rg_y0 + 190);
  rg_kn(rg_x0 + 290, rg_y0 + 116, 28, rpi(32), 0, 10, 5, rg_ks, 0, "VOLUME", "%.1f");
  rg_kn(rg_x0 + 430, rg_y0 + 116, 24, rpi(33), 0, 10, 5, rg_ks, 0, "BASS", "%.1f");
  rg_kn(rg_x0 + 550, rg_y0 + 116, 24, rpi(34), 0, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
  rg_kn(rg_x0 + 670, rg_y0 + 116, 24, rpi(35), 0, 10, 5, rg_ks, 0, "TREBLE", "%.1f");
) : (
  rg_module(rg_x0, rg_y0, 856, 220, 3, "TENOR 20", "PREAMP  -  TWO CHANNELS");
