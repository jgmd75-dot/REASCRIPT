desc:GFX Lab Ramp Mini [practice amp]
//tags: amp amplifier guitar practice small solid state hybrid head combo cabinet broken speaker modular
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-amp, gfx-lab-clip, gfx-lab-os (.jsfx-inc) in the same folder.
//
// RAMP MINI - one small guitar amp built from interchangeable pieces: the little amps of the range (Desert Ten, MT-15
// and the three BED34 practice amps) split into a PREAMP, a POWER AMP and a SPEAKER, and any piece plugs into any other:
// the TENOR's mid-forward preamp into the MT-15's solid-state crunch and the Desert Ten's 8", say. Choose the pieces of
// one original and you have that amp (each piece is its original's code, ported).
//   PREAMP     DESERT TEN  the op-amp PRE into its rails, SATURATION (the diode clipper and its mid push), LOW / MID / HIGH.
//              MT-15       one starved 12AX7: GAIN, TONE, and a MICRO / FAT voicing.
//              APE 20      fizzy op-amp diode clipping into a second stage: DRIVE and one EQ tilt.
//              SPRITE 10   NORMAL / OVERDRIVE inputs, VOLUME, BASS, MIDDLE, TREBLE.
//              TENOR 20    channel A (VOLUME, clean) or B (GAIN), BASS / MID / TREBLE, MID BOOST, a PARAMETRIC EQ (LEVEL,
//                          Q, FREQUENCY) and its spring REVERB (after the speaker, as on the original).
//   POWER AMP  DESERT TEN  10 W solid state: clean, then a hard clip. POST.
//              MT-15       a small solid-state amp on an unregulated supply: VOLUME and its own MICRO / FAT voicing.
//              BED34       the BED34's 20 W solid-state amp: MASTER and PRESENCE (the TENOR's, now for any preamp).
//   CABINET    8" open (Desert Ten), 1x12 or 2x12 closed (MT-15), 6.5", 8" or 10" open (BED34), or off (the line out).
//              MIC (on to off axis) moves the Desert Ten and MT-15 mics. BROKEN: the BED34's torn cone, on any cabinet.
// Levels: a piece feeding another's input is scaled so the next piece sees the level its own partner gives it, and
//   each mixed pair is level-matched to the preamp's own amp.
// Piece changes duck (8 ms out, the swap at silence, 8 ms back), so nothing clicks.
// ANTI-ALIASING / OS: the preamp and power amp run together at 1x, 2x (the default: the Desert Ten and MT-15 ran at 2x)
//   or 4x (the OS key; 2x = 31 samples of latency, 4x = 37). Every clipper keeps its original's ADAA and pre-filter.
// DRIFT (0 - 100 %, 50 % = standard; JG, 27 Oct 2026): each piece brings the drift of its original - the Desert Ten's
//   diodes, the MT-15's valve bias and supply, the BED34's sagging supply and its loosening paper cone.
// IN / OUT: TRIM (GUARD), MONO IN, GATE (fully down = off), OUTPUT, and the house output stage (CLIP, always on).
//
// Latency: 0 samples at 1x, 31 at 2x, 37 at 4x (reported).

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-amp.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc

slider1:0<0,4,1{Desert Ten,MT-15,Ape 20,Sprite 10,Tenor 20}>-Preamp
slider2:0<0,2,1{Desert Ten,MT-15,BED34}>-Power amp
slider3:1<0,6,1{Off (line out),8 inch open (Desert Ten),1x12 closed (MT-15),2x12 closed (MT-15),6.5 inch open (BED34),8 inch open (BED34),10 inch open (BED34)}>-Cabinet
slider4:3<0,10,0.1>-Mic position (on - off axis)
slider5:0<0,1,1{Off,On}>-Broken speaker
slider6:0<0,1,1{Off,On}>-Mono in
slider7:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider8:1<0,2,1{1x,2x,4x}>-Oversampling
slider9:0<-24,12,0.1>-Input trim (dB)
slider10:0<0,1,1{Off,On}>-Input guard
slider11:50<0,100,1>-Drift (%)
slider12:0<-24,12,0.1>-Output (dB)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-Ceiling (dB)
slider18:5<-12,2000,0.01>-Preamp control 1
slider19:0<-12,2000,0.01>-Preamp control 2
slider20:5<-12,2000,0.01>-Preamp control 3
slider21:5<-12,2000,0.01>-Preamp control 4
slider22:5<-12,2000,0.01>-Preamp control 5
slider23:0<-12,2000,0.01>-Preamp control 6
slider24:0<-12,2000,0.01>-Preamp control 7
slider25:0<-12,2000,0.01>-Preamp control 8
slider26:0<-12,2000,0.01>-Preamp control 9
slider27:0<-12,2000,0.01>-Preamp control 10
slider28:0<-12,2000,0.01>-Preamp control 11
slider29:4<-12,12,0.01>-Power amp control 1
slider30:0<-12,12,0.01>-Power amp control 2

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-ramp-mini";                             // the ? pop-up links to this manual
ext_noinit = 1;

// ================================================================ shared
function rp_alloc(n) local(p) ( p = rp_nm; rp_nm += n; memset(p, 0, n); p; );
function rp_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

// ================================================================ DESERT TEN (gfx-lab-desert-ten)
// op-amp into its rails: a firm knee (k sets the hardness): r(x) = x / (1 + |x|^k)^(1/k)
function dt_rail(x, k) ( x / (1 + abs(x) ^ k) ^ (1 / k); );
// silicon diode pair to ground: soft-ish, with a slight imbalance; and its antiderivative (F(0) = 0)
function dt_diode(x, a) ( x >= 0 ? 1 - exp(-x) : -(1 - exp(x * (1 + a))) / (1 + a); );
function dt_diodeF(x, a) local(b) ( x >= 0 ? x + exp(-x) - 1 : ( b = 1 + a; (exp(x * b) - 1) / (b * b) - x / b; ); );
// the rails as tables (read linearly) with their exact running integral, for the ADAA
DT_RN = 2048; DT_RU = 8; DT_RS = (DT_RN - 1) / DT_RU;
function dt_rbuild(t, k) local(i, x, c) (
  c = t + DT_RN + 1; i = 0;
  loop(DT_RN, x = i / DT_RS; t[i] = dt_rail(x, k); i += 1; );
  t[DT_RN] = t[DT_RN - 1]; c[0] = 0; i = 0;
  loop(DT_RN - 1, c[i + 1] = c[i] + 0.5 * (t[i] + t[i + 1]) / DT_RS; i += 1; );
);
function dt_rc(x, t) local(a, p, i) (
  a = min(abs(x) * DT_RS, DT_RN - 1.001); i = floor(a); p = a - i;
  a = t[i] + (t[i + 1] - t[i]) * p; x < 0 ? -a : a;
);
function dt_rF(x, t) local(a, p, i, c) (
  a = abs(x) * DT_RS; c = t + DT_RN + 1;
  a >= DT_RN - 1 ? c[DT_RN - 1] + t[DT_RN - 1] * (a - DT_RN + 1) / DT_RS : (
    i = floor(a); p = a - i; c[i] + (t[i] * p + 0.5 * (t[i + 1] - t[i]) * p * p) / DT_RS;
  );
);
// one anti-aliased clipper (a rail table t, offset o), its input pre-emphasised (dt_eb) so the half-sample average
// does not dull the top end; and the diodes (offset o, imbalance a)
function dt_aar(x, t, o) instance(u1, f1, xp) local(u, f, d, y) (
  u = x + dt_eb * (x - xp) + o; xp = x; f = dt_rF(u, t); d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : dt_rc(0.5 * (u + u1), t);
  u1 = u; f1 = f; y;
);
function dt_aad(x, o, a) instance(u1, f1, xp, ao, oo) local(u, f, d, y) (
  u1 === 1000000 ? ( u1 = o; xp = 0; f1 = dt_diodeF(u1, a); ao = a; oo = o; ) :           // back from rest
  a !== ao || o !== oo ? ( u1 += o - oo; f1 = dt_diodeF(u1, a); ao = a; oo = o; );   // re-read under a new curve
  u = x + dt_eb * (x - xp) + o; xp = x; f = dt_diodeF(u, a); d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : dt_diode(0.5 * (u + u1), a);
  u1 = u; f1 = f; y;
);
function dt_aaclr() instance(u1, f1, xp) ( u1 = f1 = xp = 0; );
dt_eb = 0.25;
// the level trim (dB at PRE 0, 1 .. 10, SATURATION off / on) and the line-out shelf / peak / trim rows
function dt_trow(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = DT_TR + k; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function dt_trim(v, k) local(i, f) ( v = min(max(v, 0), 10); i = min(floor(v), 9); f = v - i; k += DT_TR; k[i] * (1 - f) + k[i + 1] * f; );
function dt_lo(k, v) ( dt_trim(v, k + 22); );
function dt_tables() (
  DT_R4 = rp_alloc(2 * (DT_RN + 2)); DT_R8 = rp_alloc(2 * (DT_RN + 2)); DT_TR = rp_alloc(96);
  dt_rbuild(DT_R4, 4); dt_rbuild(DT_R8, 8);
  dt_trow(0, 0, 0, 0, 0, 0, 0, 0, 0.15, 0.35, 0.63, 0.92);
  dt_trow(11, 0.05, 0.05, 0.06, 0.08, 0.1, 0.16, 0.25, 0.38, 0.54, 0.7, 0.84);
  dt_trow(22, -2.04, -2.00, -1.76, -1.37, -0.81, 0.02, 1.16, 2.63, 4.32, 5.88, 7.02);
  dt_trow(33, -0.40, -0.38, -0.36, -0.31, -0.24, -0.11, 0.10, 0.44, 0.91, 1.45, 2.04);
  dt_trow(44, -0.02, 0.01, 0.03, 0.06, 0.09, 0.10, 0.07, 0.08, 0.03, -0.02, -0.10);
  dt_trow(55, -1.94, -1.90, -1.67, -1.31, -0.79, -0.08, 0.84, 1.93, 3.16, 4.41, 5.51);
  dt_trow(66, -0.46, -0.42, -0.38, -0.31, -0.22, -0.09, 0.10, 0.35, 0.70, 1.17, 1.73);
  dt_trow(77, 0.06, 0.07, 0.07, 0.08, 0.06, 0.06, 0.05, 0.04, 0.02, -0.02, -0.08);
  dt_r06 = dt_rc(0.06, DT_R4);
);
// PRE glides (25 ms, per sample): the drive into the op-amp (-6 .. +30 dB) and into the diodes (+14 .. +26 dB)
function dt_gset() (
  dt_g1 = exp(0.1151292546 * (dt_gs * 3.6 - 6)); dt_c1 = exp(-0.06907755279 * (dt_gs * 3.6 - 6));
  dt_gss = exp(0.1151292546 * (dt_gs * 1.2 + 14));
);
function dt_glide() (
  dt_gs !== RP_ST[18] ? ( dt_gs += (RP_ST[18] - dt_gs) * dt_gk; abs(dt_gs - RP_ST[18]) < 0.00001 ? dt_gs = RP_ST[18]; dt_gset(); );
);
// ---- DESERT TEN preamp, one side (dpL / dpR): x -> the tone controls' output
function dt_pre(x) instance() local(y) (
  y = this.ihp.am_run(this.pf.clp_pf_run(x));                      // the drive-tracking pre-filter (gfx-clip)
  y = (this.s1.dt_aar(y * dt_g1, DT_R4, 0.06) - dt_r06) * dt_c1;    // PRE: the op-amp stage (slightly off centre)
  dt_sat ? (                                                        // SATURATION: midrange push into the diodes
    y = this.shp.am_run(y); y = this.spk.am_run(y);
    y = this.s2.dt_aad(y * dt_gss, dt_bias, dt_asy) - dt_diode(dt_bias, dt_asy);
    y = this.slp.am_run(y) * 0.26;
  ) : ( this.s2.u1 = 1000000; );
  this.th.am_run(this.tm.am_run(this.tl.am_run(y)));               // tone controls
);
function dt_precoef() instance() (
  this.ihp.am_bq(1, 80, 0.7, 0, rp_fs);
  this.shp.am_bq(1, 220, 0.7, 0, rp_fs);
  this.spk.am_bq(2, 900, 0.7, 8, rp_fs);
  this.slp.am_bq(0, 5000, 0.7, 0, rp_fs);
  this.tl.am_bq(4, 120, 0.7, (RP_ST[20] - 5) * 2.6, rp_fs);
  this.tm.am_bq(2, 700, 0.6, (RP_ST[21] - 5) * 2.6 + 1.5, rp_fs);
  this.th.am_bq(3, 2800, 0.7, (RP_ST[22] - 5) * 2.6, rp_fs);
);
function dt_preclr() instance() (
  this.ihp.rp_bqclr(); this.shp.rp_bqclr(); this.spk.rp_bqclr(); this.slp.rp_bqclr();
  this.tl.rp_bqclr(); this.tm.rp_bqclr(); this.th.rp_bqclr();
  this.s1.dt_aaclr(); this.s2.u1 = 1000000;
  this.pf.clp_pf_cfg(40000, 9000, -1.5, 150); this.pf.clp_pf_reset(); this.pf.clp_pf_block(dt_gs / 10, rp_fs, 1);
);
// ---- DESERT TEN power amp, one side (dwL / dwR): POST into 10 W of solid state, clean then a hard clip
function dt_pow(x) instance() local(y) (
  y = this.phc.am_run(x) * dt_pm;
  y = this.s3.dt_aar(y, DT_R8, 0);
  this.plp.am_run(y) * dt_mk;
);
function dt_powcoef() instance() (
  this.phc.am_bq(1, 50, 0.7, 0, rp_fs); this.plp.am_bq(0, 16000, 0.7, 0, rp_fs);
  this.phc.rp_bqclr(); this.plp.rp_bqclr(); this.s3.dt_aaclr();
);
function dt_powupd() ( dt_pm = 10 ^ ((RP_ST[23] * 3.4 - 18) / 20); dt_mk = 0.84 / (dt_pm ^ 0.78); );   // (x 2: the original's output gain)
// the preamp's settings (per block; the filters only when a control they follow has moved)
function dt_preupd() local(ch) (
  ch = 3 * RP_ST[20] + 7 * RP_ST[21] + 11 * RP_ST[22] + 23 * rp_fs;
  ch !== dt_lch ? ( dt_lch = ch; dpL.dt_precoef(); dpR.dt_precoef(); );
);
// DRIFT: the clipping diodes' balance wanders (the original's 25 % amount, 0.25 Hz)
function dt_drift() local(i) (
  i = 0.25 * dm_s * samplesblock / srate;
  dt_asy = 0.15 + 0.1 * 0.25 * dm_a * dtB1.drift_tick(i);
  dt_bias = 0.03 * 0.25 * dm_a * dtB2.drift_tick(i);
);
// the line out (CAB off): a high shelf and a peak following PRE keep its level and top end
function dt_loset() instance() (
  this.lo1.am_bq(3, 0.25 * srate, 0.8, dt_lo(dt_lk, dt_gs), srate); this.lo2.am_bq(2, 0.1666667 * srate, 0.7, dt_lo(dt_lk + 11, dt_gs), srate);
);
// the 8" open-back combo cabinet (gfx-amp's type 4), one coefficient set for both sides
function dt_cabset() ( dcL.am_cab_set(4, rp_mic); dcR.am_cab_set(4, rp_mic); );

// ================================================================ MT-15 (gfx-mt-15)
// a smooth saturator (rational, exactly 1 from |x| = 3), its slope, a triode (grid side ap, cutoff side an), and the
// antiderivatives for the anti-aliasing
function m5_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function m5_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function m5_tg(u, ap, an) ( u >= 0 ? ap * m5_th(u / ap) : an * m5_th(u / an); );
function m5_tgd(u, ap, an) ( u >= 0 ? m5_thd(u / ap) : m5_thd(u / an); );
function m5_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function m5_tgF(u, ap, an) ( u >= 0 ? ap * ap * m5_F(u / ap) : an * an * m5_F(u / an); );
// a stage at operating point b (first-order ADAA; a new operating point re-reads the last point on the new curve)
function m5_stset(b, pp, nn) instance(b0, g0, n0, ap, an, u1, ga1) (
  ap = pp; an = nn; u1 += b - b0; ga1 = m5_tgF(u1, ap, an);
  b0 = b; g0 = m5_tg(b, ap, an); n0 = 1 / max(m5_tgd(b, ap, an), 0.05);
);
function m5_strun(x) instance(b0, g0, n0, ap, an, u1, ga1) local(u, ga, d, y) (
  u = x + b0; ga = m5_tgF(u, ap, an); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : m5_tg(0.5 * (u + u1), ap, an);
  u1 = u; ga1 = ga;
  (y - g0) * n0 + m5_dn;
);
function m5_stclr() instance(b0, u1, ga1) ( b0 = u1 = ga1 = 0; );
// first-order sections: the cathode bypass shelf (bilinear), a one-pole coefficient
function m5_shset(fz, fr, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * fr;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function m5_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function m5_k(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
// the post-shelves' biquads (gfx-s74's peak and high shelf)
function m5_bqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(A, w, cs, sn, al, a0, sa) (
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * max(q, 0.05));
  t == 3 ? ( a0 = 1 + al / A; b0 = (1 + al * A) / a0; b1 = -2 * cs / a0; b2 = (1 - al * A) / a0; a1 = -2 * cs / a0; a2 = (1 - al / A) / a0; ) : (
    sa = 2 * sqrt(A) * al; a0 = (A + 1) - (A - 1) * cs + sa;
    b0 = A * ((A + 1) + (A - 1) * cs + sa) / a0; b1 = -2 * A * ((A - 1) + (A + 1) * cs) / a0; b2 = A * ((A + 1) + (A - 1) * cs - sa) / a0;
    a1 = 2 * ((A - 1) - (A + 1) * cs) / a0; a2 = ((A + 1) - (A - 1) * cs - sa) / a0;
  );
);
function m5_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function m5_bqclr() instance(z1, z2) ( z1 = z2 = 0; );
// ---- MT-15 preamp, one side (mpL / mpR): V1a, the coupling cap, the voicing and its dip, GAIN, V1b on the (sagging)
// preamp supply, TONE -> into VOLUME
function m5_pre(x) instance(cs, v1, mid, dp, v2, h1, l1, h2, l2, tz, ps) local(y) (
  y = cs.m5_1run(x * m5_K1);
  y = -v1.m5_strun(y);                                  // V1a
  h1 += (y - h1) * m5_kh1; y -= h1;                     // the coupling cap (its corner rises with GAIN)
  l1 += (y - l1) * m5_kl1;                              // the grid stopper / Miller roll-off
  y = dp.am_run(mid.am_run(l1)) * m5_gn;                 // the voicing network, the 300 Hz dip (deepens with GAIN), GAIN
  y = -ps * v2.m5_strun(y / ps);                        // V1b, on the (sagging) preamp supply
  h2 += (y - h2) * m5_kh2; y -= h2;
  l2 += (y - l2) * m5_kl2;
  tz += (l2 - tz) * m5_ktn;                             // TONE: a treble bleed round a 1st-order split
  tz * m5_tl + (l2 - tz) * m5_tk;
);
function m5_preclr() instance(cs, v1, mid, dp, v2, h1, l1, h2, l2, tz) (
  cs.x1 = cs.y1 = 0; mid.rp_bqclr(); dp.rp_bqclr(); v1.m5_stclr(); v2.m5_stclr(); h1 = l1 = h2 = l2 = tz = 0;
);
function m5_pside() instance(cs, mid) (
  !m5_pmod ? ( cs.m5_shset(240, 2.6, rp_fs); mid.am_bq(2, 950, 0.7, 5.5, rp_fs); )
           : ( cs.m5_shset(32, 1.9, rp_fs);  mid.am_bq(2, 380, 0.75, 4.5, rp_fs); );
);
// the valves' operating points and the preamp supply (DRIFT; w1..w3 the side's wander, -1..1)
function m5_pbias(w1, w2, w3) instance(v1, v2, sb, ps, d1, d2, d3) (
  d1 = w1; d2 = w2; d3 = w3;
  v1.m5_stset(m5_b1 + 0.05 * dm_a * w1, m5_P1, m5_N1);
  v2.m5_stset(m5_b2 + 0.05 * dm_a * w2, m5_P2, m5_N2);
  sb = 1 + 0.015 * dm_a * w3;
  rp_w != 1 ? ps = sb;
);
// the voicing's constants (at the silent point of a duck)
M5_C1F = 0.0885; M5_C1G = -0.07; M5_C1Q = 0.46; M5_C2F = 0.3241; M5_C2G = 6.16; M5_C2Q = 0.49;   // MICRO
M5_C3F = 0.1631; M5_C3G = 0.28; M5_C3Q = 0.87; M5_C4F = 0.2404; M5_C4G = 2.95; M5_C4Q = 0.67;     // FAT
function m5_pmodset() (
  m5_pmod = RP_ST[24] >= 0.5;
  !m5_pmod ? (                                          // MICRO: starved, tight, mid-pushed
    m5_K1 = 1.7; m5_P1 = 0.75; m5_N1 = 1.15; m5_b1 = -0.18; m5_P2 = 0.6; m5_N2 = 0.95; m5_b2 = -0.14;
    m5_kl1 = m5_k(11000, rp_fs); m5_kh2 = m5_k(80, rp_fs); m5_kl2 = m5_k(7500, rp_fs);
    m5_glo = -2; m5_ghi = 36; m5_ktn = m5_k(900, rp_fs); m5_hp0 = 150;
    rpfL.clp_pf_cfg(40000, 8000, -1.5, 150); rpfR.clp_pf_cfg(40000, 8000, -1.5, 150);
    mkL1.m5_bqset(3, M5_C1F * srate, M5_C1G, M5_C1Q, srate); mkL2.m5_bqset(5, M5_C2F * srate, M5_C2G, M5_C2Q, srate);
  ) : (                                                 // FAT: headroom, lower-mid punch, the fizz tamed
    m5_K1 = 1.2; m5_P1 = 1.0; m5_N1 = 1.8; m5_b1 = -0.3; m5_P2 = 0.95; m5_N2 = 1.6; m5_b2 = -0.25;
    m5_kl1 = m5_k(6500, rp_fs); m5_kh2 = m5_k(30, rp_fs); m5_kl2 = m5_k(4800, rp_fs);
    m5_glo = -6; m5_ghi = 28; m5_ktn = m5_k(650, rp_fs); m5_hp0 = 40;
    rpfL.clp_pf_cfg(40000, 6500, -1.5, 150); rpfR.clp_pf_cfg(40000, 6500, -1.5, 150);
    mkL1.m5_bqset(3, M5_C3F * srate, M5_C3G, M5_C3Q, srate); mkL2.m5_bqset(5, M5_C4F * srate, M5_C4G, M5_C4Q, srate);
  );
  mkR1.b0 = mkL1.b0; mkR1.b1 = mkL1.b1; mkR1.b2 = mkL1.b2; mkR1.a1 = mkL1.a1; mkR1.a2 = mkL1.a2;
  mkR2.b0 = mkL2.b0; mkR2.b1 = mkL2.b1; mkR2.b2 = mkL2.b2; mkR2.a1 = mkL2.a1; mkR2.a2 = mkL2.a2;
  rpfL.clp_pf_reset(); rpfR.clp_pf_reset();
  mpL.m5_pside(); mpR.m5_pside();
  mpL.m5_pbias(mpL.d1, mpL.d2, mpL.d3); mpR.m5_pbias(mpR.d1, mpR.d2, mpR.d3);
);
// per block, from the glided GAIN: the coupling cap's corner rises, the 300 Hz dip deepens, the pre-filter slides
function m5_gblk(force) local(g) (
  m5_gb += (RP_ST[25] - m5_gb) * (force ? 1 : 1 - exp(-samplesblock / (0.03 * srate)));
  g = min(max(m5_gb, 0), 10) / 10;
  m5_kh1 = m5_k(m5_hp0 * (1 + g), rp_fs);
  mpL.dp.am_bq(2, 300, 0.9, -3.5 * g ^ 1.3, rp_fs);
  mpR.dp.b0 = mpL.dp.b0; mpR.dp.b1 = mpL.dp.b1; mpR.dp.b2 = mpL.dp.b2; mpR.dp.a1 = mpL.dp.a1; mpR.dp.a2 = mpL.dp.a2;
  rpfL.clp_pf_block(g, srate, force ? 1 : samplesblock); rpfR.clp_pf_block(g, srate, force ? 1 : samplesblock);
);
// GAIN (glided as a log) and its makeup; TONE
function m5_pupd() local(t) (
  m5_tgn = (m5_glo + (m5_ghi - m5_glo) * min(max(RP_ST[25], 0), 10) / 10) * 0.11512925;
  t = min(max(RP_ST[26], 0), 10) / 10;
  m5_ttk = 0.16 * 8 ^ t; m5_ttl = 1 - 0.3 * t;
);
// the makeup for each GAIN (dB, GAIN 0 .. 10; MICRO, FAT)
function m5_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = M5_MKT + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function m5_mkdb(m, g) local(p, i, f, q) (
  p = min(max(g, 0), 10); i = min(floor(p), 9); f = p - i; q = M5_MKT + m * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
function m5_tables() (
  M5_MKT = rp_alloc(24);
  m5_row(0, 7.26, 3.55, 0.22, -3.09, -5.85, -7.79, -9.32, -10.23, -10.79, -11.13, -11.17);
  m5_row(1, 11.28, 8.10, 5.26, 1.93, -1.26, -4.05, -6.91, -9.54, -11.65, -13.41, -14.52);
);
// ---- MT-15 power amp, one side (mwL / mwR): VOLUME (an audio-taper pot) into a clean solid-state stage with a hard
// round-off at its sagging rails (the house KNEE clipper)
function m5_pow(x) instance(rl, pa, yo) local(y) (
  y = rl * pa.clp_run(x * m5_vk / rl);
  yo = y;
  y;
);
function m5_wmodset() (
  m5_wmod = RP_ST[27] >= 0.5;
  !m5_wmod ? ( m5_rail = 1; m5_sagk = 0.12; m5_kw0 = m5_kw1 = 0.15; m5_kt = 0; )     // MICRO: low rails, a hard knee
           : ( m5_rail = 1.4; m5_sagk = 0.06; m5_kw0 = 0.42; m5_kw1 = 0.6; m5_kt = 1; );   // FAT: the knee softens with GAIN
  m5_Gpa = 8;
  mwL.pa.clp_set(2, 1, 1, 0); mwL.pa.clp_kt_cfg(m5_kw0, m5_kw1); mwR.pa.clp_set(2, 1, 1, 0); mwR.pa.clp_kt_cfg(m5_kw0, m5_kw1);
  mwL.pa.kti = mwR.pa.kti = 0;
);
// per block: the knee tracks the MT-15 preamp's GAIN (FAT; with another preamp, as at GAIN 5)
function m5_wblk() local(g, k) (
  g = rp_p == 1 ? min(max(m5_gb, 0), 10) / 10 : 0.5;
  clp_kt_on = m5_kt;
  k = mwL.pa.clp_kt_block(g, srate, samplesblock); mwL.pa.clp_knee(k);
  k = mwR.pa.clp_kt_block(g, srate, samplesblock); mwR.pa.clp_knee(k);
  mwL.pa.clp_tidy(); mwR.pa.clp_tidy();
  m5_tvp = min(max(RP_ST[28], 0), 10) / 10;
  mwL.rd = 1 + 0.003 * dm_a * mpL.d3; mwR.rd = 1 + 0.003 * dm_a * mpR.d3;   // the rails: a trace of drift
);
// the shared supply: the power amp draws, the rails sag, the MT-15 preamp's supply droops with them
function m5_sag() local(a, s) (
  a = max(abs(mwL.yo), abs(mwR.yo)) / m5_rail;
  m5_env += (a - m5_env) * (a > m5_env ? m5_sga : m5_sgr);
  s = m5_sagk * min(max(m5_env - 0.45, 0) * 1.8, 1);
  mwL.rl = m5_rail * (1 - s) * mwL.rd; mwR.rl = m5_rail * (1 - s) * mwR.rd;
  m5_ps = 1 - 0.45 * s;
);
// DRIFT (ticked once a block when an MT-15 piece is in): the valves' bias and the supply wander, each side on its own
function m5_drift() local(i) (
  i = 0.2 * dm_s * samplesblock / srate;
  mpL.m5_pbias(m5w1.drift_tick(i), m5w2.drift_tick(i), m5w3.drift_tick(i));
  mpR.m5_pbias(m5w4.drift_tick(i), m5w5.drift_tick(i), m5w6.drift_tick(i));
);
// the closed-back cabinets (1x12, 2x12), mic 0 = on axis .. 10 = off axis
function m5_cabset(type, mic) instance(c1, c2, c3, c4, c5, c6, c7) local(m, lp) (
  m = min(max(mic, 0), 10) / 10;
  type == 1 ? (
    c1.am_bq(1, 72, 0.95, 0, srate);
    c2.am_bq(2, 115, 1.3, 3.5, srate);
    c3.am_bq(2, 480, 1.0, -2.5, srate);
    c4.am_bq(2, 2300, 1.4, 5 * (1 - 0.7 * m), srate);
    lp = 5800 - 2100 * m;
    c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
    c7.am_bq(2, 7500, 3, -9 * m, srate);
  ) : (
    c1.am_bq(1, 65, 1.05, 0, srate);
    c2.am_bq(2, 105, 1.2, 4.5, srate);
    c3.am_bq(2, 400, 0.9, -3, srate);
    c4.am_bq(2, 2700, 1.5, 4.5 * (1 - 0.7 * m), srate);
    lp = 5400 - 2000 * m;
    c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
    c7.am_bq(2, 6800, 2.6, -10 * m, srate);
  );
);
function m5_cabrun(x) instance(c1, c2, c3, c4, c5, c6, c7) (
  c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c2.am_run(c1.am_run(x)))))));
);
function m5_cabupd(force) (
  m5_micg += (rp_mic - m5_micg) * (force ? 1 : 1 - exp(-samplesblock / (0.03 * srate)));
  force || abs(m5_micg - m5_micl) > 0.001 ? (
    m5_micl = m5_micg;
    mcL.m5_cabset(rp_c - 1, m5_micg - 0.15); mcR.m5_cabset(rp_c - 1, m5_micg + 0.15);
  );
);

// ================================================================ BED34 (gfx-bed34: APE 20, SPRITE 10, TENOR 20)
function bd_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function bd_op(f) ( 1 - exp(-2 * $pi * min(f, 0.49 * srate) / srate); );
function bd_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
// biquads: coefficients at o (b0 b1 b2 a1 a2) for the rate fs, states at s (2)
function bd_w(f, fs) ( 2 * $pi * min(max(f, 5), 0.45 * fs) / fs; );
function bd_pk(o, f, gdb, q, fs) local(A, w, cw, al, n) (
  A = 10 ^ (gdb / 40); w = bd_w(f, fs); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al / A;
  o[0] = (1 + al * A) / n; o[1] = -2 * cw / n; o[2] = (1 - al * A) / n; o[3] = -2 * cw / n; o[4] = (1 - al / A) / n;
);
function bd_lsh(o, f, gdb, fs) local(A, w, cw, al, s, a0) (
  A = 10 ^ (gdb / 40); w = bd_w(f, fs); cw = cos(w); al = sin(w) / 1.41421356; s = 2 * sqrt(A) * al;
  a0 = (A + 1) + (A - 1) * cw + s;
  o[0] = A * ((A + 1) - (A - 1) * cw + s) / a0; o[1] = 2 * A * ((A - 1) - (A + 1) * cw) / a0; o[2] = A * ((A + 1) - (A - 1) * cw - s) / a0;
  o[3] = -2 * ((A - 1) + (A + 1) * cw) / a0; o[4] = ((A + 1) + (A - 1) * cw - s) / a0;
);
function bd_hsh(o, f, gdb, fs) local(A, w, cw, al, s, a0) (
  A = 10 ^ (gdb / 40); w = bd_w(f, fs); cw = cos(w); al = sin(w) / 1.41421356; s = 2 * sqrt(A) * al;
  a0 = (A + 1) - (A - 1) * cw + s;
  o[0] = A * ((A + 1) + (A - 1) * cw + s) / a0; o[1] = -2 * A * ((A - 1) + (A + 1) * cw) / a0; o[2] = A * ((A + 1) + (A - 1) * cw - s) / a0;
  o[3] = 2 * ((A - 1) - (A + 1) * cw) / a0; o[4] = ((A + 1) - (A - 1) * cw - s) / a0;
);
function bd_hp(o, f, q, fs) local(w, cw, al, n) (
  w = bd_w(f, fs); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function bd_lp(o, f, q, fs) local(w, cw, al, n) (
  w = bd_w(f, fs); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function bd_bpf(o, f, q, fs) local(w, cw, al, n) (
  w = bd_w(f, fs); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = al / n; o[1] = 0; o[2] = -al / n; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function bd_bq(x, o, s) local(y) ( y = o[0] * x + s[0]; s[0] = o[1] * x - o[3] * y + s[1]; s[1] = o[2] * x - o[4] * y; y; );
// the preamp's coefficients (BD_PC: 0 coupling HP, 5 pre-emphasis, 10 BASS, 15 MID, 20 TREBLE, 25 the amp's voicing;
// TENOR: 60 the parametric, 70 the mid boost's band), at the amp's rate
function bd_precoef() local(o, a, bb, mm, tt) (
  o = BD_PC; a = rp_p - 2;
  bb = (bd_bs - 5) * 2.4; mm = (bd_md - 5) * 2.4; tt = (bd_tr - 5) * 2.4;
  a == 0 ? ( bb = -1.6 * bd_tl; mm = 0; tt = 1.6 * bd_tl; );         // APE: one EQ, a tilt
  bd_hp(o, 70, 0.7, rp_fs);
  a == 0 ? ( bd_hsh(o + 5, 1000, 6, rp_fs); bd_lsh(o + 10, 400, bb, rp_fs); bd_pk(o + 15, 600, mm, 0.9, rp_fs); bd_hsh(o + 20, 1200, tt, rp_fs); bd_pk(o + 25, 500, -5, 0.8, rp_fs); ) :
  a == 1 ? ( bd_hsh(o + 5, 2000, 4, rp_fs); bd_lsh(o + 10, 250, bb, rp_fs); bd_pk(o + 15, 650, mm, 0.9, rp_fs); bd_hsh(o + 20, 3000, tt, rp_fs); bd_pk(o + 25, 1600, 2, 0.8, rp_fs); ) :
           ( bd_pk(o + 5, 800, 4, 0.7, rp_fs); bd_lsh(o + 10, 220, bb, rp_fs); bd_pk(o + 15, 700, mm, 0.8, rp_fs); bd_hsh(o + 20, 2200, tt, rp_fs); bd_pk(o + 25, 1200, 2, 0.7, rp_fs);
             bd_pk(o + 60, bd_pf, bd_pl, bd_pq, rp_fs); bd_bpf(o + 70, 700, 0.9, rp_fs); );
);
// the speaker's coefficients (BD_SC: 0 HP, 5 its bump, 10 its presence, 15 / 20 its roll-off, 25 its dip), host rate
function bd_spkcoef() local(o, k) (
  o = BD_SC; k = rp_c - 4;
  k == 0 ? ( bd_hp(o, 185, 1, srate); bd_pk(o + 5, 235 * bd_cone, 6, 2, srate); bd_pk(o + 10, 1300, 5, 1.2, srate); bd_lp(o + 15, 3500, 0.8, srate); bd_lp(o + 20, 3500, 0.7, srate); bd_pk(o + 25, 600, -3, 1.2, srate); ) :   // 6.5": boxy, nasal, no lows
  k == 1 ? ( bd_hp(o, 115, 0.9, srate); bd_pk(o + 5, 150 * bd_cone, 4, 1.6, srate); bd_pk(o + 10, 2400, 5, 1.4, srate); bd_lp(o + 15, 4800, 0.7, srate); bd_lp(o + 20, 4800, 0.7, srate); bd_pk(o + 25, 800, -3, 1, srate); ) :      // 8": barky, an edge
           ( bd_hp(o, 70, 0.8, srate); bd_pk(o + 5, 95 * bd_cone, 5, 1.3, srate); bd_pk(o + 10, 1600, 2, 0.9, srate); bd_lp(o + 15, 5800, 0.7, srate); bd_lp(o + 20, 5800, 0.7, srate); bd_pk(o + 25, 1100, -2, 1, srate); );     // 10": round and full
);
// ---- BED34 preamp, one side (bpL / bpR; states at st): coupling, pre-emphasis, GAIN into the amp's two clippers, its
// voicing and tone stack (TENOR: the mid boost before, the parametric after)
function bd_pre(x) instance(st) local(a, g1) (
  a = bd_bq(bd_bq(x, BD_PC, st), BD_PC + 5, st + 2);
  rp_p == 4 ? a += bd_mbs * bd_bq(a, BD_PC + 70, st + 24);              // TENOR: the mid boost (+6 dB at 700 Hz)
  g1 = rp_p == 2 ? bd_gape : rp_p == 3 ? bd_gspk : bd_gten;            // the preamp's gain (glided; TENOR: its channel's)
  a = this.c1.clp_pf_run(a * g1);
  a = this.c1.clp_run(a + bd_bi) - bd_r1;
  a = this.c2.clp_run(a * 2) * 0.5;
  a = bd_bq(bd_bq(bd_bq(bd_bq(a, BD_PC + 25, st + 4), BD_PC + 10, st + 6), BD_PC + 15, st + 8), BD_PC + 20, st + 10);
  rp_p == 4 ? a = bd_bq(a, BD_PC + 60, st + 26);                        // TENOR: the parametric
  a;
);
function bd_precfg(n) instance() local(a) (
  a = rp_p - 2;
  a == 0 ? ( this.c1.clp_set(2, 0.5, 0.42, 0); this.c1.clp_knee(0.08); this.c2.clp_set(1, 0.9, 0.9, 0); bd_bi = 0.02; ) :
  a == 1 ? ( this.c1.clp_set(2, 0.7, 0.66, 0); this.c1.clp_knee(0.15); this.c2.clp_set(1, 1, 1, 0); bd_bi = 0.01; ) :
           ( this.c1.clp_set(1, 1, 0.8, 0); this.c2.clp_set(1, 0.8, 0.8, 0); bd_bi = 0.1; );
  this.c1.clp_pf_cfg(0.45 * rp_fs, a == 1 ? 9000 : 7000, -1.5, 150);
  this.c1.clp_pf_block(bd_gn / 10, rp_fs, n);
  bd_r1 = this.c1.clp_crv(bd_bi);
);
function bd_preclr() instance(st) (
  memset(st, 0, 32); this.c1.clp_reset(); this.c2.clp_reset(); this.c1.clp_pf_reset();
  this.c1.x1 = bd_bi; this.c1.ad1 = this.c1.clp_ad(bd_bi);
);
function bd_pretidy() instance(st) local(i) (
  i = 0; loop(32, st[i] = bd_tn(st[i]); i += 1; ); this.c1.clp_tidy(); this.c2.clp_tidy();
);
// ---- BED34 power amp, one side (bwL / bwR): MASTER into a small solid-state stage on a sagging rail, PRESENCE
function bd_pow(x) instance(st) local(a) (
  a = this.pa.clp_run(x * bd_ms) / bd_msc;
  bd_prn ? a = bd_bq(a, BD_WC, st);
  a;
);
function bd_powclr() instance(st) ( memset(st, 0, 4); this.pa.clp_reset(); );
// ---- the BED34 speakers, one side (bsL / bsR)
function bd_spk(x) instance(st) (
  bd_bq(bd_bq(bd_bq(bd_bq(bd_bq(bd_bq(x, BD_SC, st), BD_SC + 5, st + 2), BD_SC + 10, st + 4), BD_SC + 15, st + 6), BD_SC + 20, st + 8), BD_SC + 25, st + 10);
);
function bd_spkclr() instance(st) local(i) ( memset(st, 0, 12); );
function bd_spktidy() instance(st) local(i) ( i = 0; loop(12, st[i] = bd_tn(st[i]); i += 1; ); );
// the preamp's gains and trims (per block): each gain on a curved taper; the trims keep each amp about level
function bd_pregain() local(db) (
  rp_p == 2 ? (                                         // APE: 0 .. +34 dB, curved (OFF is clean)
    db = 34 * (bd_gn / 10) ^ 1.6; bd_gat = 10 ^ (db / 20) * 0.5; bd_kt = 1.1 * 10 ^ (-0.5 * (db - 11.2) / 20);
  ) : rp_p == 3 ? (                                     // SPRITE: NORMAL / OVERDRIVE
    RP_ST[31] >= 0.5 ? ( db = 10 + 24 * (bd_gn / 10) ^ 1.6; bd_kt = 0.46 * 10 ^ (-0.5 * (db - 17.9) / 20); )
                     : ( db = 22 * (bd_gn / 10) ^ 1.3; bd_kt = 1.25 * 10 ^ (-0.5 * (db - 8.9) / 20); );
    bd_gst = 10 ^ (db / 20) * 0.5;
  ) : (                                                 // TENOR: B (GAIN) or A (VOLUME)
    RP_ST[36] >= 0.5 ? ( db = 30 * (bd_gn / 10) ^ 1.5; bd_kt = 0.96 * 10 ^ (-0.5 * (db - 10.6) / 20); bd_gtt = 10 ^ (db / 20) * 0.5; )
                     : ( bd_kt = 2.45 * 10 ^ (-0.5 * (2 * bd_vo - 10) / 20); bd_gtt = 10 ^ ((-8 + 2 * bd_vo) / 20) * 0.5; );
  );
);
// which store control is each BED34 preamp's GAIN (it slides the pre-filter): APE DRIVE, SPRITE VOLUME, TENOR GAIN
function bd_gidx() ( rp_p == 2 ? 29 : rp_p == 3 ? 32 : 38; );
// per block: the knobs glide (30 ms), the clippers and the coefficients follow
function bd_preblk(snap) local(gl) (
  gl = snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  bd_gn += (min(max(RP_ST[bd_gidx()], 0), 10) - bd_gn) * gl;
  rp_p == 3 ? ( bd_bs += (RP_ST[33] - bd_bs) * gl; bd_md += (RP_ST[34] - bd_md) * gl; bd_tr += (RP_ST[35] - bd_tr) * gl; ) :
  rp_p == 4 ? ( bd_bs += (RP_ST[39] - bd_bs) * gl; bd_md += (RP_ST[40] - bd_md) * gl; bd_tr += (RP_ST[41] - bd_tr) * gl;
                bd_pl += (min(max(RP_ST[43], -12), 12) - bd_pl) * gl; bd_pq += (min(max(RP_ST[44], 0.5), 4) - bd_pq) * gl;
                bd_pfl += (log(min(max(RP_ST[45], 100), 2000)) - bd_pfl) * gl; bd_pf = exp(bd_pfl);
                bd_vo += (min(max(RP_ST[37], 0), 10) - bd_vo) * gl; ) :
              ( bd_tl += (min(max(RP_ST[30], -5), 5) - bd_tl) * gl; );
  bd_mbt = RP_ST[42] >= 0.5;
  bd_rvt = rp_p == 4 ? sqr(min(max(RP_ST[46], 0), 10) / 10) * 0.6 : 0;
  bd_pregain();
  bpL.bd_precfg(snap ? 1 : samplesblock); bpR.bd_precfg(snap ? 1 : samplesblock);
  bd_precoef();
  bpL.bd_pretidy(); bpR.bd_pretidy();
);
// the power amp per block: MASTER (-24 .. +12 dB in; the output follows it at half the rate), the rail, PRESENCE
function bd_powblk(snap) local(gl) (
  gl = snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  bd_mst = 10 ^ ((-24 + 3.6 * min(max(RP_ST[47], 0), 10)) / 20); bd_msc = sqrt(bd_mst);
  bd_pr += (min(max(RP_ST[48], 0), 10) - bd_pr) * gl;
  bd_prn = bd_pr != 0;
  bd_prn ? bd_hsh(BD_WC, 2500, bd_pr * 1.2, rp_fs);
  bwL.pa.clp_set(1, bd_rail, bd_rail * 0.95, 0); bwR.pa.clp_set(1, bd_rail, bd_rail * 0.95, 0);
  bwL.pa.clp_tidy(); bwR.pa.clp_tidy();
  bwL.st[0] = bd_tn(bwL.st[0]); bwL.st[1] = bd_tn(bwL.st[1]); bwR.st[0] = bd_tn(bwR.st[0]); bwR.st[1] = bd_tn(bwR.st[1]);
);
// DRIFT (ticked once a block when a BED34 piece is in): the supply (its rail: wander and sag) and the cone (it
// loosens with what it has played)
function bd_drift() local(n) (
  n = samplesblock / srate;
  bd_vs = bdS.drift_tick(0.04 * dm_s * n); bd_vc = bdC.drift_tick(0.04 * dm_s * n);
  bd_rail = 1 - 0.03 * dm_a * (0.5 + 0.5 * bd_vs) - 0.18 * dm_a * bd_sag;
  bd_cone = 1 - 0.09 * dm_a * bd_heat + 0.01 * dm_a * bd_vc;
  bd_sag = bd_tn(bd_sag); bd_heat = bd_tn(bd_heat);
);
// BROKEN SPEAKER: a torn cone's ragged response and its rattle (on bd_a / bd_b)
function bk_coef() (
  bd_pk(BKC, 1400, -10, 4, srate); bd_pk(BKC + 5, 3200, 4, 2, srate); bd_lsh(BKC + 10, 180, -6, srate); bd_hp(BKC + 15, 900, 0.7, srate);
);
function bk_run() local(a, b, oa, ob, ra, rb) (
  a = bd_bq(bd_bq(bd_bq(bd_a, BKC, BKS), BKC + 5, BKS + 2), BKC + 10, BKS + 4);
  b = bd_bq(bd_bq(bd_bq(bd_b, BKC, BKS + 6), BKC + 5, BKS + 8), BKC + 10, BKS + 10);
  bk_ea += bk_kx * (bd_a * 3 - bk_ea); bk_eb += bk_kx * (bd_b * 3 - bk_eb);   // the cone's excursion (the lows)
  oa = max(abs(bk_ea) - 0.18, 0); ob = max(abs(bk_eb) - 0.18, 0);
  ra = (bk_ea > 0 ? oa : -oa) * 1.6 + (rand(2) - 1) * oa * 0.9;              // it slaps and buzzes past its limit
  rb = (bk_eb > 0 ? ob : -ob) * 1.6 + (rand(2) - 1) * ob * 0.9;
  ra = bd_bq(ra, BKC + 15, BKS + 12); rb = bd_bq(rb, BKC + 15, BKS + 14);
  a += ra * 0.7; b += rb * 0.7;
  bd_a += bd_eK * (a - bd_a); bd_b += bd_eK * (b - bd_b);
);
function bk_tidy() local(i) ( i = 0; loop(16, BKS[i] = bd_tn(BKS[i]); i += 1; ); bk_ea = bd_tn(bk_ea); bk_eb = bd_tn(bk_eb); );
// the TENOR's spring reverb (mono, after the speaker): a dispersion chain, two damped feedback lines (33 and 41 ms)
function rv_run(x) local(i, v, y1, y2, s) (
  v = x; i = 0;
  loop(6, y1 = -0.62 * v + RVD[i]; RVD[i] = v + 0.62 * y1; v = y1; i += 1; );
  y1 = RVA[rv_p1]; y2 = RVB[rv_p2];
  rv_l1 += 0.45 * (y1 - rv_l1); rv_l2 += 0.45 * (y2 - rv_l2);
  RVA[rv_p1] = v + 0.72 * rv_l2; RVB[rv_p2] = v + 0.70 * rv_l1;
  rv_p1 = (rv_p1 + 1) % rv_n1; rv_p2 = (rv_p2 + 1) % rv_n2;
  s = y1 + y2; rv_h += rv_kh * (s - rv_h);
  s - rv_h;
);
function rv_clr() ( memset(RVA, 0, 4100); memset(RVB, 0, 4100); memset(RVD, 0, 8); rv_p1 = rv_p2 = 0; rv_l1 = rv_l2 = rv_h = 0; );
function bd_mem() (
  BD_PC = rp_alloc(80); BD_WC = rp_alloc(8); BD_SC = rp_alloc(32);
  bpL.st = rp_alloc(32); bpR.st = rp_alloc(32); bwL.st = rp_alloc(4); bwR.st = rp_alloc(4); bsL.st = rp_alloc(12); bsR.st = rp_alloc(12);
  BKC = rp_alloc(20); BKS = rp_alloc(16);
  RVA = rp_alloc(4100); RVB = rp_alloc(4100); RVD = rp_alloc(8);
);
function bd_rate() (
  bd_gsm = 1 - exp(-1 / (0.015 * srate));
  bd_ksa = bd_tc(40); bd_ksr = bd_tc(500);              // the supply: sag / recovery
  bd_kh = bd_tc(3000); bd_kc = bd_tc(8000);             // the cone: loosens / recovers
  bk_kx = bd_op(250); rv_kh = bd_op(300); rv_n1 = min(floor(0.0333 * srate), 4000); rv_n2 = min(floor(0.0414 * srate), 4000);
  bd_fst = 1 / (0.01 * srate);
  bk_coef(); memset(BKS, 0, 16); bk_ea = bk_eb = 0;
  rv_clr();
);

// ================================================================ the chassis
// the level each preamp hands its own power amp (the interface: rp_nk), the level each power amp's own preamp(s) give
// it (rp_nkw), and the level match of every mixed pair to the preamp's own amp (dB, row = preamp, column = power amp)
function rp_tables() (
  rp_fam = rp_alloc(5); rp_fam[0] = 0; rp_fam[1] = 1; rp_fam[2] = rp_fam[3] = rp_fam[4] = 2;
  rp_nk = rp_alloc(5); rp_nk[0] = 10 ^ (-22.26 / 20); rp_nk[1] = 10 ^ (-12.59 / 20); rp_nk[2] = 10 ^ (-19.87 / 20); rp_nk[3] = 10 ^ (-22.25 / 20); rp_nk[4] = 10 ^ (-20.44 / 20);
  rp_nkw = rp_alloc(3); rp_nkw[0] = rp_nk[0]; rp_nkw[1] = rp_nk[1]; rp_nkw[2] = 10 ^ (-20.85 / 20);   // (dBFS RMS on a riff, every knob at its default)
  rp_zt = rp_alloc(15);                                 // (measured on a riff, every knob at its default, the preamp's cabinet)
  rp_zt[0] = 0;     rp_zt[1] = -9.35;  rp_zt[2] = -0.87;   // DESERT TEN pre into DESERT TEN / MT-15 / BED34 power
  rp_zt[3] = 9.37;  rp_zt[4] = 0;      rp_zt[5] = 8.5;     // MT-15
  rp_zt[6] = 1.84;  rp_zt[7] = -7.53;  rp_zt[8] = 0;       // APE 20
  rp_zt[9] = -0.53; rp_zt[10] = -9.85; rp_zt[11] = 0;      // SPRITE 10
  rp_zt[12] = 1.28; rp_zt[13] = -8.1;  rp_zt[14] = 0;      // TENOR 20
);
// the pieces in use: rp_p (preamp), rp_w (power amp), rp_c (cabinet); targets rp_tp / rp_tw / rp_tc
function rp_cabset() (
  rp_c == 1 ? ( dt_cabset(); ) :
  rp_c == 2 || rp_c == 3 ? ( m5_cabupd(1); ) :
  rp_c >= 4 ? ( bd_spkcoef(); );
);
function rp_cabclr() (
  dcL.c1.rp_bqclr(); dcL.c2.rp_bqclr(); dcL.c3.rp_bqclr(); dcL.c4.rp_bqclr(); dcL.c5.rp_bqclr(); dcL.c6.rp_bqclr(); dcL.c7.rp_bqclr();
  dcR.c1.rp_bqclr(); dcR.c2.rp_bqclr(); dcR.c3.rp_bqclr(); dcR.c4.rp_bqclr(); dcR.c5.rp_bqclr(); dcR.c6.rp_bqclr(); dcR.c7.rp_bqclr();
  mcL.c1.rp_bqclr(); mcL.c2.rp_bqclr(); mcL.c3.rp_bqclr(); mcL.c4.rp_bqclr(); mcL.c5.rp_bqclr(); mcL.c6.rp_bqclr(); mcL.c7.rp_bqclr();
  mcR.c1.rp_bqclr(); mcR.c2.rp_bqclr(); mcR.c3.rp_bqclr(); mcR.c4.rp_bqclr(); mcR.c5.rp_bqclr(); mcR.c6.rp_bqclr(); mcR.c7.rp_bqclr();
  bsL.bd_spkclr(); bsR.bd_spkclr();
  loL.lo1.rp_bqclr(); loL.lo2.rp_bqclr(); loR.lo1.rp_bqclr(); loR.lo2.rp_bqclr();
);
// a piece coming in starts from a clean state (at the silent point of the duck)
function rp_prein(p) (
  p == 0 ? (
    dt_gs = RP_ST[18]; dt_gset(); dt_sat = RP_ST[19] >= 0.5; dt_lch = -1; dt_preupd(); dt_drift();
    dpL.dt_preclr(); dpR.dt_preclr(); dkL.rp_bqclr(); dkR.rp_bqclr(); dt_lgs = -1;
  ) : p == 1 ? (
    m5_pmodset(); m5_pupd(); m5_gblk(1); m5_lgn = m5_tgn; m5_gn = exp(m5_lgn); m5_tk = m5_ttk; m5_tl = m5_ttl;
    mpL.m5_preclr(); mpR.m5_preclr(); mpL.m5_pbias(mpL.d1, mpL.d2, mpL.d3); mpR.m5_pbias(mpR.d1, mpR.d2, mpR.d3);
    mpL.ps = mpL.sb; mpR.ps = mpR.sb;
    mkL1.m5_bqclr(); mkL2.m5_bqclr(); mkR1.m5_bqclr(); mkR2.m5_bqclr();
    m5_gblk(1);
  ) : (
    bd_gn = min(max(RP_ST[bd_gidx()], 0), 10); bd_preblk(1);
    bd_gape = bd_gat; bd_gspk = bd_gst; bd_gten = bd_gtt; bd_mbs = bd_mbt; bd_rv = bd_rvt;
    bpL.bd_preclr(); bpR.bd_preclr(); rv_clr();
  );
);
function rp_powin(w) (
  w == 0 ? ( dt_powupd(); dwL.dt_powcoef(); dwR.dt_powcoef(); ) :
  w == 1 ? (
    mwL.pa.clp_reset(); mwR.pa.clp_reset(); m5_wmodset(); m5_wblk(); m5_vp = m5_tvp;
    m5_vk = (exp(4.6051702 * m5_vp) - 1) * 0.01010101 * m5_Gpa;
    m5_env = 0; mwL.rl = mwR.rl = m5_rail; mwL.yo = mwR.yo = 0; m5_ps = 1;
    m5_sga = 1 - exp(-1 / (0.006 * rp_fs)); m5_sgr = 1 - exp(-1 / (0.18 * rp_fs));
  ) : (
    bwL.bd_powclr(); bwR.bd_powclr(); bd_powblk(1); bd_ms = bd_mst;
  );
);
// the settings (per block and from @slider)
function rp_update() (
  rp_tp = min(max(slider1 | 0, 0), 4); rp_tw = min(max(slider2 | 0, 0), 2); rp_tc = min(max(slider3 | 0, 0), 6);
  rp_tmono = slider6 >= 0.5;
  rp_mic = slider4;
  rp_gate = slider7;
  bd_tK = slider5 >= 0.5;
  os_tf = os_f2n(slider8);
  in_setup(slider9, slider10 >= 0.5);
  drift_macro(slider11);
  rp_out = 10 ^ (slider12 / 20);
  ost_setup(slider13 / 100, slider14 / 100, slider15, slider16, slider17, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
);
// everything the pieces in use need per block
function rp_block() local(m5d, bdd) (
  m5d = rp_p == 1 || rp_w == 1; bdd = rp_p >= 2 || rp_w == 2 || rp_c >= 4;
  m5d ? m5_drift();
  bdd ? bd_drift();
  // the preamp
  rp_p == 0 ? (
    dt_drift(); dt_preupd();
    dpL.pf.clp_pf_block(dt_gs / 10, rp_fs, samplesblock); dpR.pf.clp_pf_block(dt_gs / 10, rp_fs, samplesblock);
    dt_lk = dt_sat ? 33 : 0;
    rp_ptrim = -dt_trim(dt_gs, dt_sat ? 11 : 0);
    rp_c == 0 ? (
      rp_ptrim += dt_lo(dt_lk + 22, dt_gs);
      dt_gs !== dt_lgs || dt_lk !== dt_llk ? ( dt_lgs = dt_gs; dt_llk = dt_lk; loL.dt_loset(); loR.dt_loset(); );
    );
  ) : rp_p == 1 ? (
    m5_pupd(); m5_gblk(0);
    rp_ptrim = m5_mkdb(m5_pmod, RP_ST[25]);
  ) : (
    bd_preblk(0);
    rp_ptrim = 20 * log10(bd_kt);
  );
  // the power amp
  rp_w == 0 ? ( dt_powupd(); ) :
  rp_w == 1 ? ( m5_wblk(); ) :
  ( bd_powblk(0); );
  // the cabinet
  rp_c == 1 ? ( rp_mic != dt_lmic ? ( dt_lmic = rp_mic; dt_cabset(); ); ) :
  rp_c == 2 || rp_c == 3 ? ( m5_cabupd(0); ) :
  rp_c >= 4 ? ( bd_spkcoef(); bsL.bd_spktidy(); bsR.bd_spktidy(); );
  bk_tidy(); rv_l1 = bd_tn(rv_l1); rv_l2 = bd_tn(rv_l2); rv_h = bd_tn(rv_h);
  // the pair's level
  rp_kin = rp_fam[rp_p] == rp_w ? 1 : rp_nkw[rp_w] / rp_nk[rp_p];
  rp_tg = 10 ^ ((rp_ptrim + rp_zt[rp_p * 3 + rp_w]) / 20);
);
// a piece change (or MONO IN, or a voicing): duck out, swap at the silent point, a short hold, back in
function rp_swap() (
  rp_mono = rp_tmono;
  rp_tp != rp_p ? ( rp_p = rp_tp; rp_prein(rp_p); );
  rp_tw != rp_w ? ( rp_w = rp_tw; rp_powin(rp_w); );
  rp_tc != rp_c ? ( rp_c = rp_tc; rp_cabset(); rp_cabclr(); dt_lgs = -1; dt_lmic = rp_mic; );
  rp_p == 0 && dt_sat != (RP_ST[19] >= 0.5) ? ( dt_sat = RP_ST[19] >= 0.5; dpL.s2.u1 = dpR.s2.u1 = 1000000; );
  rp_p == 1 && m5_pmod != (RP_ST[24] >= 0.5) ? ( m5_pmodset(); m5_pupd(); m5_lgn = m5_tgn; m5_gblk(1); );
  rp_w == 1 && m5_wmod != (RP_ST[27] >= 0.5) ? ( m5_wmodset(); m5_wblk(); );
  rp_block();
  rp_g = rp_tg;
);
// a preset: every piece starts afresh with its new settings (at the silent point of the duck)
function rp_swapall() (
  rp_mono = rp_tmono;
  rp_p = rp_tp; rp_prein(rp_p); rp_w = rp_tw; rp_powin(rp_w);
  rp_c = rp_tc; rp_cabset(); rp_cabclr(); dt_lgs = -1; dt_lmic = rp_mic;
  rp_block();
  rp_g = rp_tg;
);
// everything that depends on the rate the amp runs at (the start, a new sample rate, the OS key)
function rp_rate() (
  rp_fs = srate * os_f;
  dt_gk = 1 - exp(-1 / (0.025 * srate));
  m5_sm = 1 - exp(-1 / (0.025 * srate));
  rp_prein(rp_p); rp_powin(rp_w);
  dt_lmic = rp_mic; rp_cabset(); rp_cabclr(); dt_lgs = -1;
  dkL.am_bq(3, 0.32713 * srate, 0.56, 5.55, srate); dkR.am_bq(3, 0.32713 * srate, 0.56, 5.55, srate);   // the Desert Ten's post-shelf
  uL.os_clr(); uR.os_clr(); dL.os_clr(); dR.os_clr();
  bd_rate();
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
function rp_start() (
  rp_sr = srate; rp_nm = 0;
  ost_init(rp_alloc(4096));
  dt_tables(); m5_tables(); bd_mem(); rp_tables();
  in_init();
  rp_update();
  os_f = os_tf;
  rp_p = rp_tp; rp_w = rp_tw; rp_c = rp_tc; rp_mono = rp_tmono;
  m5_dn = 0.000000000000000001;
  rp_ogk = 1 - exp(-1 / (0.03 * srate));
  bd_cone = bd_rail = 1; bd_sag = bd_heat = 0;
  rp_rate();
  rp_block();
  rp_g = rp_tg; rp_os = rp_out;
  rp_dk = 1; rp_dst = 0; rp_dkr = 1 / (0.008 * srate);
  bd_gK = bd_tK;
  os_gsetup();
);

// ================================================================ the pieces' settings
// Every piece keeps its own settings in a store (RP_ST[n], n = the control's number below), saved with the project, so
// a piece swapped out and back comes back as it was. The host sees only the chosen preamp's and power amp's controls,
// through 11 + 2 generic sliders; rp_sync() keeps them and the store in step.
RP_ST = 4000000; RP_DF = 4000100;
RP_DF[18] = 5;    // DESERT TEN pre Pre
RP_DF[19] = 0;    // DESERT TEN pre Saturation
RP_DF[20] = 5;    // DESERT TEN pre Low
RP_DF[21] = 5;    // DESERT TEN pre Mid
RP_DF[22] = 5;    // DESERT TEN pre High
RP_DF[23] = 4;    // DESERT TEN power Post
RP_DF[24] = 0;    // MT-15 pre Voicing (Micro, Fat)
RP_DF[25] = 5;    // MT-15 pre Gain
RP_DF[26] = 5;    // MT-15 pre Tone
RP_DF[27] = 0;    // MT-15 power Voicing (Micro, Fat)
RP_DF[28] = 5;    // MT-15 power Volume
RP_DF[29] = 5;    // APE 20 pre Drive
RP_DF[30] = 0;    // APE 20 pre EQ (tilt, -5 .. 5)
RP_DF[31] = 0;    // SPRITE 10 pre Input (Normal, Overdrive)
RP_DF[32] = 5;    // SPRITE 10 pre Volume
RP_DF[33] = 5;    // SPRITE 10 pre Bass
RP_DF[34] = 5;    // SPRITE 10 pre Middle
RP_DF[35] = 5;    // SPRITE 10 pre Treble
RP_DF[36] = 1;    // TENOR 20 pre Channel (A, B)
RP_DF[37] = 5;    // TENOR 20 pre Volume (A)
RP_DF[38] = 5;    // TENOR 20 pre Gain (B)
RP_DF[39] = 5;    // TENOR 20 pre Bass
RP_DF[40] = 5;    // TENOR 20 pre Mid
RP_DF[41] = 5;    // TENOR 20 pre Treble
RP_DF[42] = 0;    // TENOR 20 pre Mid boost
RP_DF[43] = 0;    // TENOR 20 pre Parametric level (dB)
RP_DF[44] = 1;    // TENOR 20 pre Parametric Q
RP_DF[45] = 500;  // TENOR 20 pre Parametric frequency (Hz)
RP_DF[46] = 0;    // TENOR 20 pre Reverb
RP_DF[47] = 5;    // BED34 power Master
RP_DF[48] = 0;    // BED34 power Presence
// preamp p's controls are RP_ST[rp_pb[p] .. + rp_pn[p] - 1], power amp w's RP_ST[rp_wb[w] .. + rp_wn[w] - 1]
rp_pb = 4000200; rp_pn = 4000205; rp_wb = 4000210; rp_wn = 4000213;
rp_pb[0] = 18; rp_pb[1] = 24; rp_pb[2] = 29; rp_pb[3] = 31; rp_pb[4] = 36;
rp_pn[0] = 5; rp_pn[1] = 3; rp_pn[2] = 2; rp_pn[3] = 5; rp_pn[4] = 11;
rp_wb[0] = 23; rp_wb[1] = 27; rp_wb[2] = 47; rp_wn[0] = 1; rp_wn[1] = 2; rp_wn[2] = 2;
!rp_pinit ? ( memcpy(RP_ST + 18, RP_DF + 18, 31); rp_pinit = 1; );
rp_lpre = slider1 | 0; rp_lpow = slider2 | 0;
// a preset (asked for by the panel, loaded in @block at the silent point of a duck); every preset starts from Init
// (every control at its default); OS is not part of a preset. rp_s(n, v) sets a piece's control n (the store's numbers).
function rp_s(i, v) ( RP_ST[i] = v; );
function rp_preset(n) (
  memcpy(RP_ST + 18, RP_DF + 18, 31);
  slider1 = 0; slider2 = 0; slider3 = 1; slider4 = 3; slider5 = 0; slider6 = 0; slider7 = -80;
  slider9 = 0; slider10 = 0; slider11 = 50; slider12 = 0;
  slider13 = 0; slider14 = 30; slider15 = 120; slider16 = 6000; slider17 = -0.3;
  // ---- the originals
  n == 2 ? (                                                   // Desert Crunch: SATURATION in, the 8" open back
    slider12 = -9.1; slider1 = 0; slider2 = 0; slider3 = 1;
    rp_s(18, 6); rp_s(19, 1); rp_s(20, 5.5); rp_s(21, 6); rp_s(22, 5); rp_s(23, 5);
  ) : n == 3 ? (                                               // Micro Crunch: the MT-15 as it comes, pushed a little
    slider12 = -0.5; slider1 = 1; slider2 = 1; slider3 = 2;
    rp_s(24, 0); rp_s(25, 6.5); rp_s(26, 6); rp_s(27, 0); rp_s(28, 5);
  ) : n == 4 ? (                                               // Fat Stack: FAT both ends, the 2x12
    slider12 = -0.3; slider1 = 1; slider2 = 1; slider3 = 3;
    rp_s(24, 1); rp_s(25, 7.5); rp_s(26, 5); rp_s(27, 1); rp_s(28, 6);
  ) : n == 5 ? (                                               // Punk Fizz: the APE flat out, tilted bright
    slider12 = -4.4; slider1 = 2; slider2 = 2; slider3 = 5;
    rp_s(29, 9); rp_s(30, 2); rp_s(47, 6);
  ) : n == 6 ? (                                               // Sprite Crunch: the OVERDRIVE input
    slider12 = -2.3; slider1 = 3; slider2 = 2; slider3 = 5;
    rp_s(31, 1); rp_s(32, 5); rp_s(33, 5); rp_s(34, 6); rp_s(35, 6); rp_s(47, 7);
  ) : n == 7 ? (                                               // Tenor Blues: channel B, the mid boost, a little spring
    slider12 = -6.0; slider1 = 4; slider2 = 2; slider3 = 6;
    rp_s(36, 1); rp_s(38, 5); rp_s(39, 6); rp_s(40, 6); rp_s(41, 5); rp_s(42, 1); rp_s(43, 2); rp_s(44, 1); rp_s(45, 700); rp_s(46, 3);
    rp_s(47, 6); rp_s(48, 3);
  // ---- the hybrids
  ) : n == 8 ? (                                               // Desert into Fat: the diodes into the MT-15's FAT power amp
    slider12 = -6.9; slider1 = 0; slider2 = 1; slider3 = 3;
    rp_s(18, 5); rp_s(19, 1); rp_s(20, 6); rp_s(21, 5); rp_s(22, 5); rp_s(27, 1); rp_s(28, 6);
  ) : n == 9 ? (                                               // Tenor Clean Box: channel A and its spring, the Desert Ten's power and 8"
    slider12 = -1.1; slider1 = 4; slider2 = 0; slider3 = 1;
    rp_s(36, 0); rp_s(37, 6); rp_s(39, 5); rp_s(40, 4.5); rp_s(41, 6); rp_s(46, 4); rp_s(23, 4);
  ) : n == 10 ? (                                              // Micro Bedroom: the MT-15's valve into the BED34's 20 W and its 6.5"
    slider12 = 0.9; slider1 = 1; slider2 = 2; slider3 = 4;
    rp_s(24, 0); rp_s(25, 4); rp_s(26, 6); rp_s(47, 4); rp_s(48, 2);
  ) : n == 11 ? (                                              // Sprite Saturator: the OVERDRIVE input, the Desert Ten's rails, the closed 2x12
    slider12 = -0.5; slider1 = 3; slider2 = 0; slider3 = 3;
    rp_s(31, 1); rp_s(32, 6); rp_s(33, 6); rp_s(34, 5); rp_s(35, 5); rp_s(23, 7);
  ) : n == 12 ? (                                              // Broken Fuzz: the APE dark and loud, the MT-15 rails, a torn 8"
    slider12 = -4.1; slider1 = 2; slider2 = 1; slider3 = 5; slider5 = 1;
    rp_s(29, 8); rp_s(30, -2); rp_s(27, 0); rp_s(28, 6);
  ) : n == 13 ? (                                              // Tenor Lead Stack: channel B high, the parametric up at 900, FAT power, 2x12
    slider12 = -7.5; slider1 = 4; slider2 = 1; slider3 = 3;
    rp_s(36, 1); rp_s(38, 8.5); rp_s(39, 5); rp_s(40, 7); rp_s(41, 6); rp_s(42, 1); rp_s(43, 3); rp_s(44, 1.5); rp_s(45, 900); rp_s(46, 2.5);
    rp_s(27, 1); rp_s(28, 6);
  );
  rp_lpre = rp_lpow = -1;                                      // rp_sync() hands the store to the generic sliders
  sliderchange(2 ^ 30 - 1 - 2 ^ 7);
);
// the generic sliders -> the store; a new piece chosen: its stored settings -> the sliders
function rp_sync() local(p, w, k, m) (
  p = min(max(slider1 | 0, 0), 4); w = min(max(slider2 | 0, 0), 2); m = 0;
  p == rp_lpre ? ( k = 0; loop(rp_pn[p], RP_ST[rp_pb[p] + k] = slider(18 + k); k += 1; ); ) : (
    k = 0; loop(11, slider(18 + k) = k < rp_pn[p] ? RP_ST[rp_pb[p] + k] : 0; k += 1; ); m = 1; rp_lpre = p;
  );
  w == rp_lpow ? ( k = 0; loop(rp_wn[w], RP_ST[rp_wb[w] + k] = slider(29 + k); k += 1; ); ) : (
    k = 0; loop(2, slider(29 + k) = k < rp_wn[w] ? RP_ST[rp_wb[w] + k] : 0; k += 1; ); m = 1; rp_lpow = w;
  );
  m ? sliderchange(2 ^ 17 * 8191);
);

os_design();
os_base = 0;
dtB1.drift_init(0.8 + rand(1) * 0.5); dtB2.drift_init(0.8 + rand(1) * 0.5);
m5w1.drift_init(0.8 + rand(1) * 0.5); m5w2.drift_init(0.8 + rand(1) * 0.5); m5w3.drift_init(0.8 + rand(1) * 0.5);
m5w4.drift_init(0.8 + rand(1) * 0.5); m5w5.drift_init(0.8 + rand(1) * 0.5); m5w6.drift_init(0.8 + rand(1) * 0.5);
bdS.drift_init(0.8 + rand(1) * 0.4); bdC.drift_init(0.8 + rand(1) * 0.4);
rp_start();
rp_pkL_disp = rp_pkR_disp = 0;
rp_rf = 1;

ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
rp_sync();
rp_update();

@block
srate != rp_sr ? rp_start();
// back on after REAPER's bypass (the plug-in wasn't called): clear the stale state, crossfade 15 ms from the dry input
rp_now = time_precise();
rp_last > 0 && rp_now - rp_last > max(0.15, 4 * samplesblock / srate) ? ( rp_rate(); rp_rf = 0; rp_rc = 1 / (0.015 * srate); );
rp_last = rp_now;
// a preset asked for (by the panel): duck out, load it at the silent point (below), come back in
rp_prq_d > 0 && rp_dst == 0 ? ( rp_prn = rp_prq_d; rp_prq_d = 0; rp_dfor = 1; rp_dst = 1; );
rp_sync();
rp_update();
rp_dst == 3 ? (
  rp_preset(rp_prn); rp_sync(); rp_update(); rp_swapall();
  rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dfor = 0; rp_dst = 2;
);
// a piece, MONO IN or a voicing asked for: start the duck
rp_dst == 0 && (rp_tp != rp_p || rp_tw != rp_w || rp_tc != rp_c || rp_tmono != rp_mono ||
  (rp_p == 0 && dt_sat != (RP_ST[19] >= 0.5)) || (rp_p == 1 && m5_pmod != (RP_ST[24] >= 0.5)) ||
  (rp_w == 1 && m5_wmod != (RP_ST[27] >= 0.5))) ? rp_dst = 1;
rp_dst < 2 ? rp_block();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_mem(0, RP_ST + 18, 31);
rp_lpre = slider1 | 0; rp_lpow = slider2 | 0;

@sample
// the duck: out, the swap at silence, a hold while the old state rings out, back in
rp_dst == 1 ? ( rp_dk -= rp_dkr; rp_dk <= 0 ? ( rp_dk = 0; rp_dfor ? rp_dst = 3 : ( rp_swap(); rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dst = 2; ); ); ) :
rp_dst == 2 ? ( rp_hc > 0 ? rp_hc -= 1 : ( rp_dk += rp_dkr; rp_dk >= 1 ? ( rp_dk = 1; rp_dst = 0; ); ); );
// the OS key: a factor change swaps in at the silent point of its own dip
os_gate();
os_chg ? rp_rate();

rp_dl = spl0; rp_dr = spl1;
in_process(spl0, spl1);
rp_xl = in_l; rp_xr = in_r;
rp_gate > -79.5 ? ( rp_gg = rp_gt.am_gate(max(abs(rp_xl), abs(rp_xr)), rp_gate); rp_xl *= rp_gg; rp_xr *= rp_gg; );
rp_mono ? ( rp_xl = rp_xr = 0.5 * (rp_xl + rp_xr); );
m5_dn = -m5_dn;

// the host-rate work of the pieces in use
rp_p == 0 ? dt_glide() :
rp_p == 1 ? (
  m5_lgn += (m5_tgn - m5_lgn) * m5_sm; m5_gn = exp(m5_lgn);
  m5_tk += (m5_ttk - m5_tk) * m5_sm; m5_tl += (m5_ttl - m5_tl) * m5_sm;
  rp_xl = rpfL.clp_pf_run(rp_xl); rp_xr = rpfR.clp_pf_run(rp_xr);           // the MT-15's pre-filter (host rate)
) : (
  bd_gape += (bd_gat - bd_gape) * bd_gsm; bd_gspk += (bd_gst - bd_gspk) * bd_gsm; bd_gten += (bd_gtt - bd_gten) * bd_gsm;
  bd_mbs += (bd_mbt - bd_mbs) * bd_gsm;
);
rp_w == 1 ? ( m5_vp += (m5_tvp - m5_vp) * m5_sm; m5_vk = (exp(4.6051702 * m5_vp) - 1) * 0.01010101 * m5_Gpa; ) :
rp_w == 2 ? ( bd_ms += (bd_mst - bd_ms) * bd_gsm; );

// the preamp and power amp at the amp's rate (1x, 2x or 4x)
uL.os_up(rp_xl); uR.os_up(rp_xr);
rp_i = 0;
loop(os_f,
  rp_al = uL.os_s(rp_i); rp_ar = uR.os_s(rp_i);
  rp_p == 0 ? ( rp_al = dpL.dt_pre(rp_al); rp_ar = dpR.dt_pre(rp_ar); ) :
  rp_p == 1 ? ( rp_al = mpL.m5_pre(rp_al); rp_ar = mpR.m5_pre(rp_ar); ) :
  ( rp_al = bpL.bd_pre(rp_al); rp_ar = bpR.bd_pre(rp_ar); );
  rp_al *= rp_kin; rp_ar *= rp_kin;
  rp_w == 0 ? ( rp_al = dwL.dt_pow(rp_al); rp_ar = dwR.dt_pow(rp_ar); ) :
  rp_w == 1 ? (
    rp_al = mwL.m5_pow(rp_al); rp_ar = mwR.m5_pow(rp_ar); m5_sag();
    rp_p == 1 ? ( mpL.ps = m5_ps * mpL.sb; mpR.ps = m5_ps * mpR.sb; );
  ) : ( rp_al = bwL.bd_pow(rp_al); rp_ar = bwR.bd_pow(rp_ar); );
  rp_i == 0 ? ( rp_a0 = rp_al; rp_b0 = rp_ar; ) : rp_i == 1 ? ( rp_a1 = rp_al; rp_b1 = rp_ar; ) :
  rp_i == 2 ? ( rp_a2 = rp_al; rp_b2 = rp_ar; ) : ( rp_a3 = rp_al; rp_b3 = rp_ar; );
  rp_i += 1;
);
rp_yl = dL.os_dn(rp_a0, rp_a1, rp_a2, rp_a3); rp_yr = dR.os_dn(rp_b0, rp_b1, rp_b2, rp_b3);

// the preamp's post-shelf (host rate)
rp_p == 0 ? ( rp_yl = dkL.am_run(rp_yl); rp_yr = dkR.am_run(rp_yr); ) :
rp_p == 1 ? ( rp_yl = mkL2.m5_bq(mkL1.m5_bq(rp_yl)); rp_yr = mkR2.m5_bq(mkR1.m5_bq(rp_yr)); );
// the cabinet (or the line out)
rp_c == 1 ? ( rp_yl = dcL.am_cab_run(rp_yl); rp_yr = dcR.am_cab_run(rp_yr); ) :
rp_c == 2 || rp_c == 3 ? ( rp_yl = mcL.m5_cabrun(rp_yl); rp_yr = mcR.m5_cabrun(rp_yr); ) :
rp_c >= 4 ? ( rp_yl = bsL.bd_spk(rp_yl); rp_yr = bsR.bd_spk(rp_yr); ) : (
  rp_p == 0 ? ( rp_yl = loL.lo2.am_run(loL.lo1.am_run(rp_yl)); rp_yr = loR.lo2.am_run(loR.lo1.am_run(rp_yr)); );
);
// the pair's level
rp_g += (rp_tg - rp_g) * rp_ogk;
rp_yl *= rp_g; rp_yr *= rp_g;
// the BED34's supply sags with what its power amp delivers; its cone loosens with what it has played
rp_w == 2 || rp_c >= 4 ? (
  rp_bd = max(abs(rp_yl), abs(rp_yr)); bd_sag += (rp_bd > bd_sag ? bd_ksa : bd_ksr) * (min(rp_bd, 1) - bd_sag);
  bd_heat += (rp_bd > bd_heat ? bd_kh : bd_kc) * (min(rp_bd, 1) - bd_heat);
);
// the TENOR's spring reverb (mono, the same both sides)
rp_p == 4 ? (
  bd_rv += (bd_rvt - bd_rv) * bd_gsm;
  bd_rv > 0.0001 ? ( rp_rw = rv_run((rp_yl + rp_yr) * 0.5) * bd_rv; rp_yl += rp_rw; rp_yr += rp_rw; );
);
// BROKEN SPEAKER (a 10 ms fade in and out)
bd_gK != bd_tK ? ( bd_gK = bd_tK ? min(bd_gK + bd_fst, 1) : max(bd_gK - bd_fst, 0); );
bd_gK > 0 ? ( bd_eK = bd_gK * bd_gK * (3 - 2 * bd_gK); bd_a = rp_yl; bd_b = rp_yr; bk_run(); rp_yl = bd_a; rp_yr = bd_b; );
// OUTPUT, the ducks, the output stage
rp_os += (rp_out - rp_os) * rp_ogk;
rp_k = rp_os;
rp_dst ? ( rp_dkg = rp_dk * rp_dk * (3 - 2 * rp_dk); rp_k *= rp_dkg; );
os_g < 1 ? rp_k *= os_g;
rp_yl *= rp_k; rp_yr *= rp_k;
rp_yl = ostL.ost_band(rp_yl); rp_yr = ostR.ost_band(rp_yr);
ost_out(rp_yl, rp_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rp_rf < 1 ? (                                                   // the resume crossfade (see @block)
  rp_rf = min(rp_rf + rp_rc, 1); rp_rs = rp_rf * rp_rf * (3 - 2 * rp_rf);
  spl0 = rp_dl + (spl0 - rp_dl) * rp_rs; spl1 = rp_dr + (spl1 - rp_dr) * rp_rs;
);
rp_pkL_disp = max(rp_pkL_disp, abs(spl0)); rp_pkR_disp = max(rp_pkR_disp, abs(spl1));

@gfx 1080 660
// =====================================================================
// GUI - RAMP MINI faceplate: a dark chassis with three slots (PREAMP, POWER AMP, CABINET). The piece in each slot brings
// its own amp's livery: Desert Ten brushed graphite with an orange pinstripe, MT-15 yellow (MICRO) or orange (FAT) with
// hazard stripes, BED34 (Ape, Sprite, Tenor) dark grey and amber. IN / OUT is the chassis's own. House parts: lamp keys,
// LCD preset bar, display boxes (click for the menu), S / M / L / ?, the OS key.
// =====================================================================
function rpi(n) ( 18 + n - rp_pb[slider1 | 0]; );   // a preamp control's number -> its generic slider
function rwi(n) ( 29 + n - rp_wb[slider2 | 0]; );   // a power amp control's number -> its generic slider
// a preset: asked for here, loaded in @block at the silent point of a duck (the pieces' store is the audio thread's)
function load_preset(p) ( rp_prq_d = p; );
function rg_col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function rg_shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function rg_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function rg_px(v) ( rg_ox + v * sc; );
function rg_py(v) ( rg_oy + v * sc; );
function rg_ps(v) ( v * sc; );
function rg_rect(x, y, w, h) ( gfx_rect(rg_px(x), rg_py(y), rg_ps(w), rg_ps(h), 1); );
function rg_tc(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_tl(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_tr(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_rivet(x, y) (
  rg_col(0x6A655E, 1);  gfx_circle(rg_px(x), rg_py(y), rg_ps(3.5), 1, 1);
  rg_col(0xFFFFFF, 0.55);  gfx_circle(rg_px(x) - rg_ps(1), rg_py(y) - rg_ps(1), rg_ps(1.2), 1, 1);
);
function rg_in(x, y, w, h) ( mouse_x >= rg_px(x) && mouse_x < rg_px(x + w) && mouse_y >= rg_py(y) && mouse_y < rg_py(y + h); );
function rg_touch(idx) ( ui_auto(idx); );
// soft drop shadow, down and to the right: 4 layers at 13 % black
function rg_dshadow(x, y, r) local(i) (
  i = 0;  loop(4, rg_col(0x000000, 0.13);  gfx_circle(x + rg_ps(2 + i * 1.33), y + rg_ps(3 + i * 1.67), r + rg_ps(i * 0.6), 1, 1);  i += 1; );
);
// pointer as a filled quad with anti-aliased edges: clean at any angle
function rg_ptr(x, y, sn, cs, ri, ro, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sn * ri;  ay = y - cs * ri;  bx = x + sn * ro;  by = y - cs * ro;  dx = cs * hw;  dy = sn * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function rg_dotarc(x, y, r, a0, a1, w) local(n, i, a) (
  n = max(2, ceil(abs(a1 - a0) * r / max(w * 0.6, 0.5)));  i = 0;
  loop(n + 1, a = a0 + (a1 - a0) * i / n;  gfx_circle(x + sin(a) * r, y - cos(a) * r, w * 0.5, 1, 1);  i += 1; );
);
function rg_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  rg_col(0x14110D, 0.95);  gfx_rect(x - w * 0.5 - rg_ps(6), y - h * 0.5 - rg_ps(3), w + rg_ps(12), h + rg_ps(6), 1);
  rg_col(0xFFB347, 1);  rg_tc(x, y, str);
);

// ---------- the knob faces: 0 desk (Desert Ten, the chassis), 1 MT-15, 2 BED34 ----------
function rg_face(x, y, rr, tv, k, cap) (
  k == 1 ? (                                                   // the MT-15: black ribbed skirt, chrome centre, white line
    rg_col(0x0E0E0F, 1);  gfx_circle(x, y, rr, 1, 1);
    rg_col(0x3A3B3E, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0x1C1D1F, 1);  gfx_circle(x, y, rr * 0.86, 1, 1);
    rg_col(0xFFFFFF, 0.9);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.55, rr * 0.97, rg_ps(1.4));
    rg_col(0x9A9DA2, 1);  gfx_circle(x, y, rr * 0.48, 1, 1);
    rg_col(0xE4E6EA, 1);  gfx_circle(x, y, rr * 0.42, 1, 1);
    rg_col(0xFFFFFF, 0.8);  gfx_arc(x, y, rr * 0.36, -1.7, -0.2, 1);
    rg_col(0x6E7176, 1);  gfx_circle(x, y, rr * 0.42, 0, 1);
  ) : k == 2 ? (                                               // the BED34: dark knob, silver cap, amber value arc
    rg_col(0x3A3B3E, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, 0.75 * $pi, rg_ps(2));
    rg_col(0xF2A33A, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, tv, rg_ps(3.2));
    rg_col(0x151618, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x46484C, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xC9CDD2, 1);  gfx_circle(x, y, rr * 0.66, 1, 1);
    rg_col(0xFFFFFF, 0.7);  gfx_arc(x, y, rr * 0.6, -1.7, -0.2, 1);
    rg_col(0x151618, 1);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.95, rg_ps(1.3));
  ) : (                                                        // the desk knob: grey skirt, light body, coloured cap
    rg_col(0x7E848A, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x5E646A, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xE6E3DC, 1);  gfx_circle(x, y, rr * 0.78, 1, 1);
    rg_col(0xFFFFFF, 0.5);  gfx_arc(x, y, rr * 0.74, -1.6, -0.3, 1);
    rg_col(cap, 1);  gfx_circle(x, y, rr * 0.5, 1, 1);  rg_col(rg_shade(cap, 0.75), 1);  gfx_circle(x, y, rr * 0.5, 0, 1);
    rg_col(0x1A1A1A, 1);  rg_ptr(x, y, sin(tv), cos(tv), 0, rr * 0.98, rg_ps(1.4));
  );
  // a light vignette edge: darker towards the rim (more on the bottom right)
  rg_col(0x000000, 0.10);  gfx_arc(x, y, rr - rg_ps(1), 0.6, 2.9, 1);  gfx_arc(x, y, rr - rg_ps(2), 0.9, 2.6, 1);
);
// Knob: style k (above), cap colour for the desk knob. rg_kstep > 0 = stepped, rg_kdim = shown dimmed, rg_kzero = a
// "0" at the top. Drag 200 px (Shift = fine), wheel 3 % (Shift 0.5 %), double-click / Ctrl-click = default. The value
// shows in a tag above the knob while it is touched.
function rg_kn(cx, cy, r, idx, vmin, vmax, def, k, cap, lbl, fmt)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, st, dm, zr)
(
  st = rg_kstep;  rg_kstep = 0;  dm = rg_kdim;  rg_kdim = 0;  zr = rg_kzero;  rg_kzero = 0;
  x = rg_px(cx);  y = rg_py(cy);  rr = rg_ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = (v - vmin) / (vmax - vmin);
  rg_click && hov && !rg_drag ? (
    now = time_precise();
    (mouse_cap & 4) || (rg_lci == idx && now - rg_lct < 0.35) ? (
      slider(idx) = def;  rg_touch(idx);  rg_drag = 0;
    ) : ( rg_drag = idx;  rg_dy = mouse_y;  rg_dt = t;  rg_dmv = 0; );
    rg_lci = idx;  rg_lct = now;
  );
  hov && mouse_wheel != 0 && !rg_drag ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));  v = vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    mouse_wheel = 0;
  );
  rg_drag == idx ? (
    !rg_dmv && abs(mouse_y - rg_dy) > rg_ps(3) ? ( rg_dmv = 1;  rg_dy = mouse_y; );   // a 3 px dead zone
    rg_dmv ? (
      t = max(0, min(1, rg_dt + (rg_dy - mouse_y) / rg_ps((mouse_cap & 8) ? 1100 : 200)));
      v = vmin + t * (vmax - vmin);
      v = st > 0 ? vmin + floor((v - vmin) / st + 0.5) * st : floor(v * 1000 + 0.5) / 1000;
      v = max(vmin, min(vmax, v));
      v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  k != 2 && k != 3 ? (                                         // the scale: eleven dots (the arcs mark the others)
    rg_col(rg_ink2, 0.85);  j = 0;
    loop(11, b = a0 + j / 10 * (a1 - a0);
      !(zr && j == 5) ? gfx_circle(x + sin(b) * (rr + rg_ps(6)), y - cos(b) * (rr + rg_ps(6)), rg_ps(k == 4 ? 1.6 : 1.2), 1, 1);  j += 1; );
  );
  zr ? ( gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tc(x, y - rr - rg_ps(9), "0"); );
  rg_dshadow(x, y, rr);
  rg_face(x, y, rr, tv, k, cap);
  dm ? ( rg_col(rg_plate, 0.55);  gfx_circle(x, y, rr + rg_ps(5), 1, 1); );
  gfx_setfont(6);  rg_col(dm ? rg_mix(rg_ink, rg_plate, 0.5) : rg_ink, 1);  rg_tc(x, y + rr + rg_ps(19), lbl);
  hov || rg_drag == idx ? ( sprintf(#rgv, fmt, v);  rg_tag(x, y - rr - rg_ps(17), #rgv); );
);
// ---------- house lamp keys: a coloured lens in a dark well (lit = feathered glow) ----------
function rg_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function rg_rr(x, y, w, h, r) ( rg_rrs(rg_px(x), rg_py(y), rg_ps(w), rg_ps(h), rg_ps(r)); );
function rg_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy, tw, th) (
  hov = rg_in(x, y, w, h);
  hit = rg_click && hov && !rg_drag;
  dn = hov && rg_lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = rg_shade(rg_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rr(x - 4 * k + 2 + i * 1.33, y - 4 * k + 3 + i * 1.67, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  on ? (
    rg_col(c, 0.10); rg_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    rg_col(c, 0.18); rg_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  rg_col(0x141518, 1);           rg_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  rg_col(rg_shade(lens, 0.55), 1); rg_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    rg_col(lens, 1); rg_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;  dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      rg_col(rg_mix(c, 0xFFFFFF, t), 1); rg_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    rg_col(rg_shade(lens, 0.62), 1); rg_rr(x, y, w, h - 1 / sc, 4 * k);
    rg_col(rg_shade(lens, 0.78), 1); rg_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    rg_col(rg_shade(lens, 0.92), 1); rg_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    rg_col(lens, 1);                 rg_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  rg_col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(rg_px(x + 4 * k), rg_py(y), rg_ps(w - 8 * k), max(1, rg_ps(1.5)));
  hov && !dn ? ( rg_col(0xFFFFFF, 0.07); rg_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  rg_col(rg_shade(c, on ? 0.30 : 0.17), 1);
  gfx_measurestr(str, tw, th);  gfx_x = floor(rg_px(x + w * 0.5) - tw * 0.5 + 0.5);  gfx_y = floor(rg_py(y + h * 0.5) - th * 0.58 + 0.5);
  gfx_drawstr(str);
  hit;
);
// a toggle key for a slider
function rg_tog(x, y, w, h, idx, c, str) ( rg_key(x, y, w, h, slider(idx) >= 0.5, c, str) ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1;  rg_touch(idx); ); );
// a radio key: lit when the slider holds v, a click sets it
function rg_rad(x, y, w, h, idx, v, c, str) ( rg_key(x, y, w, h, floor(slider(idx) + 0.5) == v, c, str) ? ( slider(idx) = v;  rg_touch(idx); ); );

// ---------- list helpers, menus ----------
function rg_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function rg_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function rg_menu(x, y, idx, list) local(n, t, i, sel) (
  n = rg_count(list);  t = floor(slider(idx) + 0.5);  strcpy(#rgm, "");  i = 0;
  loop(n, i == t ? strcat(#rgm, "!");  strcat(#rgm, rg_item(list, i + 1, #rgmt));  i < n - 1 ? strcat(#rgm, "|");  i += 1; );
  gfx_x = rg_px(x);  gfx_y = rg_py(y);  sel = gfx_showmenu(#rgm);
  sel > 0 && sel - 1 != t ? ( slider(idx) = sel - 1;  rg_touch(idx); );
);
// a display box (a dark recessed box, light text, its label above): a click opens the menu of its slider's values
function rg_disp(x, y, w, h, idx, list, lbl, sub) local(hov, tw, th) (
  hov = rg_in(x, y, w, h);
  gfx_setfont(5);  rg_col(rg_cink2, 1);  rg_tl(rg_px(x), rg_py(y - 12), lbl);
  rg_col(0x000000, 0.45);  rg_rect(x - 2, y - 2, w + 4, 2);  rg_rect(x - 2, y, 2, h + 2);
  rg_col(0xFFFFFF, 0.12);  rg_rect(x - 2, y + h, w + 4, 2);  rg_rect(x + w, y - 2, 2, h + 2);
  rg_col(0x14120F, 1);  rg_rect(x, y, w, h);
  rg_col(0x000000, 0.5);  rg_rect(x, y, w, 2);  rg_rect(x, y, 2, h);
  hov ? ( rg_col(0xFFFFFF, 0.05);  rg_rect(x, y, w, h); );
  gfx_setfont(7);  rg_col(0xF2E8D2, 1);  rg_tl(rg_px(x + 12), rg_py(y + (strlen(sub) ? h * 0.36 : h * 0.5)), rg_item(list, floor(slider(idx) + 0.5) + 1, #rgd));
  strlen(sub) ? ( gfx_setfont(5);  rg_col(0xC8B898, 1);  rg_tl(rg_px(x + 12), rg_py(y + h * 0.74), sub); );
  rg_col(0xE0A030, 1);
  gfx_triangle(rg_px(x + w - 20), rg_py(y + h * 0.5 - 3), rg_px(x + w - 10), rg_py(y + h * 0.5 - 3), rg_px(x + w - 15), rg_py(y + h * 0.5 + 3));
  rg_click && hov && !rg_drag ? rg_menu(x, y + h + 4, idx, list);
);
// ---------- LCD (the preset bar) ----------
function rg_lcd(x, y, w, h, str) local(tw, th) (
  rg_col(0x000000, 0.6);  rg_rect(x - 2, y - 2, w + 4, h + 4);
  rg_col(0x050302, 1);  rg_rect(x, y, w, h);
  rg_col(0x140D06, 1);  rg_rect(x + 3, y + 3, w - 6, h - 6);
  rg_col(0xFFFFFF, 0.06);  rg_rect(x + 4, y + 4, w - 8, 1);
  gfx_setfont(8);  gfx_measurestr(str, tw, th);
  rg_col(0xFFB347, 0.22);  gfx_x = rg_px(x + 10) - 1;  gfx_y = rg_py(y + h * 0.5) - th * 0.5;  gfx_drawstr(str);
  rg_col(0xFFB347, 1);  gfx_x = rg_px(x + 10);  gfx_y = rg_py(y + h * 0.5) - th * 0.5;  gfx_drawstr(str);
);
function rg_tri(cx, cy, s, dir) ( gfx_triangle(rg_px(cx + dir * s), rg_py(cy), rg_px(cx - dir * s), rg_py(cy - s), rg_px(cx - dir * s), rg_py(cy + s)); );
// [PRESETS][<][>][LCD]: h 34, PRESETS 64 wide, arrows 24, 4 px after PRESETS, 2 between the arrows, 6 before the LCD
function rg_pbar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = rg_count(menu);  sel = 0;  open = 0;
  rg_key(x, y + 3, 76, h - 6, 0, 0xE2DCD2, "PRESETS") ? open = 1;
  rg_key(x + 84, y + 3, 26, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  rg_key(x + 114, y + 3, 26, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  rg_col(0x2A2620, 1);  rg_tri(x + 96, y + h * 0.5, 4.5, -1);  rg_tri(x + 128, y + h * 0.5, 4.5, 1);
  lx = x + 150;
  cur >= 1 && cur <= n ? rg_item(menu, cur, #rgpn) : strcpy(#rgpn, "--");
  rg_lcd(lx, y, lw, h, #rgpn);
  rg_click && rg_in(lx, y, lw, h) ? open = 1;
  open ? (
    strcpy(#rgpm, "");  i = 1;
    loop(n, i == cur ? strcat(#rgpm, "!");  strcat(#rgpm, rg_item(menu, i, #rgpt));  i < n ? strcat(#rgpm, "|");  i += 1; );
    gfx_x = rg_px(x);  gfx_y = rg_py(y + h);  i = gfx_showmenu(#rgpm);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- plates ----------
// the chassis's own plate: a recessed tray (a darker lip, an inner shadow top and left drawn as an L, a light edge)
function rg_tray(x, y, w, h, c, title) local(i) (
  rg_col(0x000000, 0.35);  rg_rect(x - 2, y - 2, w + 4, 2);  rg_rect(x - 2, y, 2, h + 2);
  rg_col(0xFFFFFF, 0.10);  rg_rect(x - 2, y + h, w + 4, 2);  rg_rect(x + w, y - 2, 2, h + 2);
  rg_col(c, 1);  rg_rect(x, y, w, h);
  i = 0;  loop(5, rg_col(0x000000, 0.16 - i * 0.03);  rg_rect(x + i, y + i, w - i, 1);  rg_rect(x + i, y + i + 1, 1, h - i - 1);  i += 1; );
  rg_col(0xFFFFFF, 0.08);  rg_rect(x + 1, y + h - 1, w - 1, 1);  rg_rect(x + w - 1, y + 1, 1, h - 2);
  strlen(title) ? ( gfx_setfont(4);  rg_col(rg_cink, 1);  rg_tl(rg_px(x + 16), rg_py(y + 20), title); );
);
// a module's livery (m = 0 Desert Ten, 1 MT-15 MICRO, 2 MT-15 FAT, 3 BED34): plate, inks, knob style, key colour
function rg_livery(m) (
  m == 0 ? ( rg_plate = 0x2A2C30; rg_ink = 0xE4E7EC; rg_ink2 = 0xA9AEB6; rg_acc = 0xFF8A1E; rg_ks = 0; rg_kc = 0xFF9A3A; ) :
  m == 1 ? ( rg_plate = 0xE8D21E; rg_ink = 0x111111; rg_ink2 = 0x3A3608; rg_acc = 0x111111; rg_ks = 1; rg_kc = 0xF2A41E; ) :
  m == 2 ? ( rg_plate = 0xB4541F; rg_ink = 0x111111; rg_ink2 = 0x2A1206; rg_acc = 0x111111; rg_ks = 1; rg_kc = 0xFFC34A; ) :
           ( rg_plate = 0x2E2F31; rg_ink = 0xF5E6CC; rg_ink2 = 0xC2B49A; rg_acc = 0xF2A33A; rg_ks = 2; rg_kc = 0xF2A33A; );
);
// a module plate in its livery, with its own name and a subtitle; a small rivet in each corner
function rg_module(x, y, w, h, m, name, sub) local(i, tw, th, sx) (
  rg_livery(m);
  i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(x + 2 + i * 1.33, y + 3 + i * 1.67, w + i * 0.6, h + i * 0.6);  i += 1; );
  rg_col(rg_plate, 1);  rg_rect(x, y, w, h);
  m == 0 ? (                                                   // brushed graphite, the orange pinstripe
    i = 0;  loop(h / 2, rg_col(i % 3 ? 0xFFFFFF : 0x000000, i % 3 ? 0.03 : 0.06);  rg_rect(x, y + i * 2, w, 1);  i += 1; );
    rg_col(rg_shade(rg_acc, 0.65), 1);  rg_rect(x + 4, y + h - 9, w - 8, 3);
  ) : m <= 2 ? (                                               // the MT-15: a black rule, hazard stripes along the foot
    rg_col(0x111111, 0.8);  rg_rect(x + 16, y + 34, w - 32, 2);
    rg_col(0x111111, 1);  rg_rect(x + 4, y + h - 14, w - 8, 8);
    rg_col(rg_plate, 1);  sx = x + 4;
    loop(floor((w - 16) / 16),
      gfx_triangle(rg_px(sx + 4), rg_py(y + h - 6), rg_px(sx + 10), rg_py(y + h - 14), rg_px(sx + 16), rg_py(y + h - 14), rg_px(sx + 10), rg_py(y + h - 6));
      sx += 16;
    );
  ) : (                                                        // the BED34: a thin amber rule
    rg_col(rg_acc, 0.55);  rg_rect(x + 16, y + 34, w - 32, 1);
  );
  // depth: a narrow darker bottom / right edge, a light top / left one
  rg_col(0x000000, 0.25);  rg_rect(x, y + h - 2, w, 2);  rg_rect(x + w - 2, y, 2, h - 2);
  rg_col(0xFFFFFF, m == 1 || m == 2 ? 0.35 : 0.10);  rg_rect(x, y, w - 2, 1);  rg_rect(x, y + 1, 1, h - 3);
  rg_col(rg_shade(rg_plate, m == 1 || m == 2 ? 0.6 : 1.9), 1);
  gfx_circle(rg_px(x + 8), rg_py(y + 8), rg_ps(2.5), 1, 1);  gfx_circle(rg_px(x + w - 8), rg_py(y + 8), rg_ps(2.5), 1, 1);
  gfx_circle(rg_px(x + 8), rg_py(y + h - 8), rg_ps(2.5), 1, 1);  gfx_circle(rg_px(x + w - 8), rg_py(y + h - 8), rg_ps(2.5), 1, 1);
  gfx_setfont(4);  rg_col(rg_ink, 1);  rg_tl(rg_px(x + 20), rg_py(y + 20), name);
  gfx_measurestr(name, tw, th);
  gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tl(rg_px(x + 20) + tw + rg_ps(12), rg_py(y + 21), sub);
);
// a thin inked line splitting a plate into parts
function rg_div(x, y0, y1) ( rg_col(0x000000, 0.35);  rg_rect(x, y0, 1, y1 - y0);  rg_col(0xFFFFFF, 0.14);  rg_rect(x + 1, y0, 1, y1 - y0); );
function rg_sub(x, y, str) ( gfx_setfont(6);  rg_col(rg_ink, 1);  rg_tl(rg_px(x), rg_py(y), str); );
function rg_small(x, y, str) ( gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tc(rg_px(x), rg_py(y), str); );
// dims a switched-off part (the plate's colour at about half over it)
function rg_dim(x, y, w, h) ( rg_col(rg_plate, 0.5);  rg_rect(x, y, w, h); );

// Labels in the house font, Trebuchet MS bold, sized by width (as ui_fitfont: "THRESHOLD" = 5.28 x the size) so they
// read the same size on every system. Re-measured when the scale changes.
function rg_fit(idx, size) local(fs, w, h, target) (
  target = 5.28 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, "Trebuchet MS", fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);

// ---------- frame setup ----------
rg_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
rg_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;                         // S / M / L
sc = rg_ret * max(min(rg_want, min(gfx_w / (1080 * rg_ret), gfx_h / (660 * rg_ret))), 0.5);
rg_ox = (gfx_w - 1080 * sc) * 0.5;
rg_oy = (gfx_h - 660 * sc) * 0.5;
rg_lmb = mouse_cap & 1;
rg_click = rg_lmb && !rg_llmb;
// while the ? pop-up is open, it takes the clicks (the panel under it doesn't)
rg_hclick = rg_help ? rg_click : 0;
rg_help ? ( rg_click = 0;  mouse_wheel = 0; );
rg_kstep = 0;  rg_kdim = 0;  rg_kzero = 0;
sc != rg_fsc ? (
  rg_fsc = sc;
  rg_f1 = rg_fit(1, rg_ps(30));     // title
  rg_f10 = rg_fit(10, rg_ps(12));   // header subtitle
  rg_f2 = rg_fit(2, rg_ps(15));     // key legends
  rg_f3 = rg_fit(3, rg_ps(14));     // hover values
  rg_f4 = rg_fit(4, rg_ps(18));     // plate titles
  rg_f5 = rg_fit(5, rg_ps(13));     // small print
  rg_f6 = rg_fit(6, rg_ps(16));     // knob labels, part titles
  rg_f7 = rg_fit(7, rg_ps(17));     // display boxes
);
gfx_setfont(1, "Trebuchet MS", rg_f1, 'b');  gfx_setfont(10, "Trebuchet MS", rg_f10, 'b');
gfx_setfont(2, "Trebuchet MS", rg_f2, 'b');  gfx_setfont(3, "Trebuchet MS", rg_f3, 'b');
gfx_setfont(4, "Trebuchet MS", rg_f4, 'b');  gfx_setfont(5, "Trebuchet MS", rg_f5, 'b');
gfx_setfont(6, "Trebuchet MS", rg_f6, 'b');  gfx_setfont(7, "Trebuchet MS", rg_f7, 'b');
gfx_setfont(8, "Courier New", rg_ps(20), 'b');

// the chassis colours
rg_chas = 0x2B2926;  rg_tray0 = 0x34312D;  rg_cink = 0xEDE4D0;  rg_cink2 = 0xB9AE98;
PRESET_MENU = "Init|Desert Crunch|Micro Crunch|Fat Stack|Punk Fizz|Sprite Crunch|Tenor Blues|Desert into Fat|Tenor Clean Box|Micro Bedroom|Sprite Saturator|Broken Fuzz|Tenor Lead Stack";
PRE_LIST = "Desert Ten|MT-15|Ape 20|Sprite 10|Tenor 20";
POW_LIST = "Desert Ten|MT-15|BED34";
CAB_LIST = "Line out|1x8 open|1x12 closed|2x12 closed|1x6.5 open|1x8 open|1x10 open";

// ---------- the chassis ----------
rg_col(rg_chas, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
rg_col(0x141312, 1);  rg_rect(0, 0, 1080, 58);
rg_col(0x000000, 1);  rg_rect(0, 58, 1080, 3);  rg_col(0xE0A030, 1);  rg_rect(0, 61, 1080, 1);
rg_col(rg_shade(rg_chas, 0.7), 1);  rg_rect(0, 657, 1080, 3);  rg_rect(1077, 62, 3, 598);
rg_rivet(8, 70);  rg_rivet(1072, 70);  rg_rivet(8, 651);  rg_rivet(1072, 651);
gfx_setfont(1);  rg_col(0xF4EEDF, 1);  rg_tl(rg_px(24), rg_py(23), "RAMP MINI");
gfx_setfont(10);  rg_col(0xE0A030, 1);  rg_tl(rg_px(26), rg_py(46), "MODULAR PRACTICE AMP");
gfx_setfont(1);  gfx_measurestr("RAMP MINI", rg_tw, rg_th);
gfx_setfont(4);  rg_col(0xE0A030, 1);  rg_tl(rg_px(24) + rg_tw + rg_ps(16), rg_py(24), "GFX");

rg_k = rg_pbar(330, 12, 34, 300, pr_cur, PRESET_MENU);
rg_k > 0 ? ( load_preset(rg_k);  pr_cur = rg_k; );

// ================================================================ PREAMP
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 74, 180, 220, rg_tray0, "PREAMP");
rg_p = floor(slider1 + 0.5);
rg_disp(28, 128, 156, 48, 1, PRE_LIST, "MODULE",
  rg_p == 0 ? "OP-AMP, DIODES" : rg_p == 1 ? "ONE 12AX7" : rg_p == 2 ? "DIODE CLIPPING" : rg_p == 3 ? "TWO INPUTS" : "TWO CHANNELS");
