  rg_rad(rg_x0 + 24, rg_y0 + 124, 96, 30, rpi(36), 1, rg_kc, "B  DRIVE");
  rg_kdim = rg_c;   rg_kn(rg_x0 + 172, rg_y0 + 112, 20, rpi(37), 0, 10, 5, rg_ks, 0, "VOLUME", "%.1f");
  rg_kdim = !rg_c;  rg_kn(rg_x0 + 244, rg_y0 + 112, 20, rpi(38), 0, 10, 5, rg_ks, 0, "GAIN", "%.1f");
  rg_div(rg_x0 + 286, rg_y0 + 50, rg_y0 + 200);
  rg_kn(rg_x0 + 332, rg_y0 + 112, 20, rpi(39), 0, 10, 5, rg_ks, 0, "BASS", "%.1f");
  rg_kn(rg_x0 + 404, rg_y0 + 112, 20, rpi(40), 0, 10, 5, rg_ks, 0, "MID", "%.1f");
  rg_kn(rg_x0 + 476, rg_y0 + 112, 20, rpi(41), 0, 10, 5, rg_ks, 0, "TREBLE", "%.1f");
  rg_tog(rg_x0 + 344, rg_y0 + 168, 120, 28, rpi(42), rg_kc, "MID BOOST");
  rg_div(rg_x0 + 518, rg_y0 + 50, rg_y0 + 200);
  rg_small(rg_x0 + 634, rg_y0 + 58, "PARAMETRIC");
  rg_kzero = 1;  rg_kn(rg_x0 + 564, rg_y0 + 112, 20, rpi(43), -12, 12, 0, rg_ks, 0, "LEVEL", "%+.1f dB");
  rg_kn(rg_x0 + 634, rg_y0 + 112, 20, rpi(44), 0.5, 4, 1, rg_ks, 0, "Q", "%.2f");
  rg_kn(rg_x0 + 704, rg_y0 + 112, 20, rpi(45), 100, 2000, 500, rg_ks, 0, "FREQ", "%.0f Hz");
  rg_div(rg_x0 + 748, rg_y0 + 50, rg_y0 + 200);
  rg_kn(rg_x0 + 800, rg_y0 + 112, 20, rpi(46), 0, 10, 0, rg_ks, 0, "REVERB", "%.1f");
);

// ================================================================ POWER AMP
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 310, 180, 176, rg_tray0, "POWER AMP");
rg_w = floor(slider2 + 0.5);
rg_disp(28, 364, 156, 48, 2, POW_LIST, "MODULE", rg_w == 0 ? "10 W SOLID STATE" : rg_w == 1 ? "15 W, SAGGING" : "20 W SOLID STATE");
gfx_setfont(5);  rg_col(rg_cink2, 1);
rg_tl(rg_px(28), rg_py(438), rg_w == 0 ? "Clean, then a hard clip" : rg_w == 1 ? "A soft rail, the supply" : "Master and presence,");
rg_tl(rg_px(28), rg_py(456), rg_w == 0 ? "at its rails" : rg_w == 1 ? "droops when pushed" : "a sagging supply");
rg_x0 = 208;  rg_y0 = 310;
rg_w == 0 ? (
  rg_module(rg_x0, rg_y0, 320, 176, 0, "DESERT TEN", "");
  rg_kn(rg_x0 + 160, rg_y0 + 96, 26, rwi(23), 0, 10, 4, rg_ks, 0x7FB2DC, "POST", "%.1f");
) : rg_w == 1 ? (
  rg_c = slider(rwi(27)) >= 0.5;
  rg_module(rg_x0, rg_y0, 320, 176, 1 + rg_c, "MT-15", "");
  rg_rad(rg_x0 + 24, rg_y0 + 62, 92, 28, rwi(27), 0, rg_kc, "MICRO");
  rg_rad(rg_x0 + 24, rg_y0 + 104, 92, 28, rwi(27), 1, rg_kc, "FAT");
  rg_kn(rg_x0 + 220, rg_y0 + 92, 26, rwi(28), 0, 10, 5, rg_ks, 0, "VOLUME", "%.1f");
) : (
  rg_module(rg_x0, rg_y0, 320, 176, 3, "BED34", "");
  rg_kn(rg_x0 + 100, rg_y0 + 92, 24, rwi(47), 0, 10, 5, rg_ks, 0, "MASTER", "%.1f");
  rg_kn(rg_x0 + 220, rg_y0 + 92, 24, rwi(48), 0, 10, 0, rg_ks, 0, "PRESENCE", "%.1f");
);

// ================================================================ CABINET
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(544, 310, 180, 176, rg_tray0, "CABINET");
rg_cb = floor(slider3 + 0.5);
rg_disp(556, 364, 156, 48, 3, CAB_LIST, "SPEAKERS", rg_cb == 0 ? "NO CABINET" : rg_cb == 1 ? "DESERT TEN" : rg_cb <= 3 ? "MT-15" : "BED34");
gfx_setfont(5);  rg_col(rg_cink2, 1);
rg_tl(rg_px(556), rg_py(438), "BROKEN: a torn cone,");
rg_tl(rg_px(556), rg_py(456), "on any cabinet");
rg_m = rg_cb == 0 ? -1 : rg_cb == 1 ? 0 : rg_cb <= 3 ? 1 : 3;
rg_x0 = 736;  rg_y0 = 310;
rg_m >= 0 ? (
  rg_livery(rg_m);
  rg_i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(rg_x0 + 2 + rg_i * 1.33, rg_y0 + 3 + rg_i * 1.67, 328 + rg_i * 0.6, 176 + rg_i * 0.6);  rg_i += 1; );
  rg_col(rg_m == 1 ? 0x18181A : rg_plate, 1);  rg_rect(rg_x0, rg_y0, 328, 176);
  // the grille: the Desert Ten's perforated metal, the MT-15's black cloth, the BED34's mesh
  rg_gc = rg_m == 0 ? 0x1C1D20 : rg_m == 1 ? 0x101012 : 0x202124;
  rg_col(rg_gc, 1);  rg_rect(rg_x0 + 14, rg_y0 + 14, 170, 148);
  rg_m == 0 ? (
    rg_i = 0;  loop(14, rg_j = 0;  loop(12, rg_col(0x5A5E66, 0.7);  gfx_circle(rg_px(rg_x0 + 22 + rg_i * 11.6 + (rg_j % 2) * 5.8), rg_py(rg_y0 + 22 + rg_j * 12), rg_ps(2), 1, 1);  rg_j += 1; );  rg_i += 1; );
  ) : rg_m == 1 ? (
    rg_i = 0;  loop(42, rg_col(0xFFFFFF, 0.05);  rg_rect(rg_x0 + 14 + rg_i * 4.05, rg_y0 + 14, 1, 148);  rg_col(0x000000, 0.2);  rg_rect(rg_x0 + 14, rg_y0 + 14 + rg_i * 3.5, 170, 1);  rg_i += 1; );
  ) : (
    rg_i = 0;  loop(30, rg_col(0x46484C, 0.6);  rg_rect(rg_x0 + 14 + rg_i * 5.67, rg_y0 + 14, 1, 148);  rg_rect(rg_x0 + 14, rg_y0 + 14 + rg_i * 4.93, 170, 1);  rg_i += 1; );
  );
  rg_col(0x000000, 0.4);  rg_rect(rg_x0 + 14, rg_y0 + 14, 170, 2);  rg_rect(rg_x0 + 14, rg_y0 + 14, 2, 148);
  gfx_setfont(6);  rg_col(0xD8CCB4, 0.85);
  rg_tc(rg_px(rg_x0 + 99), rg_py(rg_y0 + 88), rg_cb == 1 || rg_cb == 5 ? "1 x 8  OPEN" : rg_cb == 2 ? "1 x 12  CLOSED" : rg_cb == 3 ? "2 x 12  CLOSED" : rg_cb == 4 ? "1 x 6.5  OPEN" : "1 x 10  OPEN");
  rg_col(0x000000, 0.25);  rg_rect(rg_x0, rg_y0 + 174, 328, 2);  rg_rect(rg_x0 + 326, rg_y0, 2, 174);
  rg_m == 1 ? ( rg_livery(1);  rg_ink = 0xEDE4D0;  rg_ink2 = 0xB9AE98;  rg_plate = 0x18181A; );   // (light print on the black box)
  rg_kdim = rg_cb >= 4;
  rg_kn(rg_x0 + 256, rg_y0 + 52, 20, 4, 0, 10, 3, rg_ks, 0x75787D, "MIC", "%.1f");
  rg_cb <= 3 ? rg_small(rg_x0 + 256, rg_y0 + 114, "ON - OFF AXIS");
  rg_tog(rg_x0 + 206, rg_y0 + 134, 100, 28, 5, 0xE8503A, "BROKEN");
) : (
  rg_tray(rg_x0, rg_y0, 328, 176, rg_tray0, "");
  gfx_setfont(6);  rg_col(rg_cink2, 1);  rg_tc(rg_px(rg_x0 + 99), rg_py(rg_y0 + 88), "LINE OUT");
  rg_tog(rg_x0 + 206, rg_y0 + 134, 100, 28, 5, 0xE8503A, "BROKEN");
);

// ================================================================ IN / OUT
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 502, 1048, 142, rg_tray0, "IN / OUT");
rg_tog(40, 546, 110, 30, 6, 0xF2A41E, "MONO IN");
rg_tog(40, 594, 110, 30, 10, 0x5FC4C0, "GUARD");
rg_kn(300, 582, 20, 9, -24, 12, 0, 0, 0xE6E3DC, "TRIM", "%+.1f dB");
rg_kn(420, 582, 20, 7, -80, -20, -80, 0, 0x8A8C86, "GATE", slider7 <= -79.5 ? "off" : "%.0f dB");
rg_kn(540, 582, 20, 11, 0, 100, 50, 0, 0x6F8794, "DRIFT", "%.0f %%");
rg_kn(660, 582, 20, 12, -24, 12, 0, 0, 0xE0A030, "OUTPUT", "%+.1f dB");
// the output meter: L / R LED bars, -42 .. +3 dBFS in 3 dB steps, the peak held 1.2 s then falling
!rg_minit ? ( rg_hl = rg_hr = -120;  rg_minit = 1; );
rg_ml = max(rp_pkL_disp, rg_ml * 0.85);  rg_mr = max(rp_pkR_disp, rg_mr * 0.85);  rp_pkL_disp = rp_pkR_disp = 0;
rg_now = time_precise();
rg_j = 0;
loop(2,
  rg_v = rg_j ? rg_mr : rg_ml;  rg_db = rg_v > 0.000001 ? 20 * log10(rg_v) : -120;
  rg_db >= (rg_j ? rg_hr : rg_hl) || rg_now - (rg_j ? rg_tmr : rg_tml) > 1.2 ? (
    rg_db >= (rg_j ? rg_hr : rg_hl) ? ( rg_j ? ( rg_hr = rg_db; rg_tmr = rg_now; ) : ( rg_hl = rg_db; rg_tml = rg_now; ); ) :
      ( rg_j ? rg_hr = max(rg_db, rg_hr - 0.6) : rg_hl = max(rg_db, rg_hl - 0.6); );
  );
  rg_mx = 1000 + rg_j * 22;
  rg_col(0x0E0D0C, 1);  rg_rect(rg_mx, 520, 18, 100);
  rg_i = 0;
  loop(15,
    rg_d = -42 + rg_i * 3;
    rg_col(rg_d >= 0 ? 0xE0503A : rg_d >= -9 ? 0xF2A41E : 0x5FC4C0, rg_db >= rg_d ? 1 : 0.14);
    rg_rect(rg_mx + 3, 616 - (rg_i + 1) * 6.4 + 1, 12, 5);
    rg_i += 1;
  );
  rg_h = rg_j ? rg_hr : rg_hl;
  rg_h > -42 ? ( rg_col(0xFFFFFF, 0.95);  rg_rect(rg_mx + 2, 616 - (floor((min(rg_h, 3) + 42) / 3) + 1) * 6.4 + 1, 14, 2); );
  rg_j += 1;
);
rg_click && rg_in(1000, 520, 40, 100) ? rg_hl = rg_hr = -120;   // clear the peaks
gfx_setfont(5);  rg_col(rg_cink2, 1);  rg_tc(rg_px(1009), rg_py(630), "L");  rg_tc(rg_px(1031), rg_py(630), "R");

// ---------- OS key (house): left of the S / M / L / ? picker; cycles 1x -> 2x -> 4x ----------
os_key(rg_ox / sc + 956, rg_oy / sc + 18, 8, 0xE0A030, 12);

// ---------- S / M / L / ? (size picker and credits), four 13 x 18 keys on a 14 pitch ----------
rg_j = 0;
loop(4,
  rg_gx = 1006 + rg_j * 14;  rg_on = rg_j == 0 ? ui_sz == 1 : rg_j == 1 ? ui_sz == 0 : rg_j == 2 ? ui_sz == 2 : rg_help;
  rg_col(0x050302, 1);  rg_rect(rg_gx, 20, 13, 18);
  rg_col(rg_on ? 0xFFB347 : 0x3A3632, 1);  rg_rect(rg_gx + 1, 21, 11, 16);
  gfx_setfont(5);  rg_col(rg_on ? 0x140D06 : 0xE0C8A0, 1);  rg_tc(rg_px(rg_gx + 6.5), rg_py(29), rg_j == 0 ? "S" : rg_j == 1 ? "M" : rg_j == 2 ? "L" : "?");
  rg_click && !rg_help && rg_in(rg_gx, 20, 13, 18) ? (
    rg_j == 0 ? ui_sz = 1 : rg_j == 1 ? ui_sz = 0 : rg_j == 2 ? ui_sz = 2 : ( rg_help = 1;  rg_hnew = 1; );
  );
  rg_j += 1;
);
// the card: credits, website, manual; a click anywhere closes it
strcpy(#rgh3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#rgh3, #ui_man);  strcat(#rgh3, ".pdf");
gfx_setfont(5);  gfx_measurestr(#rgh3, rg_tw, rg_th);
rg_cw = max(rg_tw + rg_ps(40), rg_ps(440));  rg_ch = rg_ps(140);
rg_cx = (gfx_w - rg_cw) * 0.5;  rg_cy = (gfx_h - rg_ch) * 0.5;
rg_help && rg_hclick && !rg_hnew ? ( rg_help = 0;  rg_hclick = 0; );
rg_hnew = 0;
rg_help ? (
  rg_col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  rg_col(0x000000, 0.5);  rg_rrs(rg_cx + rg_ps(3), rg_cy + rg_ps(5), rg_cw, rg_ch, rg_ps(8));
  rg_col(0x1C1D20, 1);    rg_rrs(rg_cx, rg_cy, rg_cw, rg_ch, rg_ps(8));
  rg_col(0xE0A030, 1);    gfx_rect(rg_cx + rg_ps(20), rg_cy + rg_ps(36), rg_cw - rg_ps(40), max(1, rg_ps(1)), 1);
  gfx_setfont(6);  rg_col(0xF2F2EE, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  rg_col(0xE8B23A, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  rg_col(0xD8D6D0, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(72);  gfx_drawstr(#rgh3);
  rg_col(0x85837E, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(110);  gfx_drawstr("Click anywhere to close.");
);

// ---------- end of frame ----------
!rg_lmb ? rg_drag = 0;
mouse_wheel = 0;
rg_llmb = rg_lmb;
