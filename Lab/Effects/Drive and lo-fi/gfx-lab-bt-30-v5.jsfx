);
B5I = 0xECE7DB; B5H = 0x121416; B5V = 0xFFD060;
sc != b5_fsc ? (
  b5_fsc = sc;
  b5_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  b5_f6 = ui_fitfont(6, 26 * sc);
);
function b5_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * b5_kt * sc, 'b'); );
function b5_fc(px) ( gfx_setfont(12, "Courier New", px * b5_kt * sc, 'b'); );
function b5_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function b5_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function b5_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function b5_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function b5_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function b5_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
);
B5IN = ui_mix(ui_mix(B5F, 0, 0.10), 0, 0.32);
function b5_pocket(x, y, w, h) ( b5_cham(x, y, w, h, 3, B5F); ui_col(B5IN); v5_r(x + 3, y + 3, w - 6, h - 6); );
function b5_hover(cx, cy, fs) ( b5_hon = 1; b5_hx = cx; b5_hy = cy; b5_hfs = fs; );
