  b3_rss = b3_rsf * b3_rsf * (3 - 2 * b3_rsf);
  b3_yl = by_il + (b3_yl - by_il) * b3_rss; b3_yr = by_ir + (b3_yr - by_ir) * b3_rss;
);
spl0 = abs(b3_yl) < 0.00000000000000000001 ? 0 : b3_yl;
spl1 = abs(b3_yr) < 0.00000000000000000001 ? 0 : b3_yr;
by_out();
b3_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); b3_pkm = max(b3_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
b5_m = slider(1) >= 0.5;
b5_m ? (
  B5F = 0x383B40; B5B = 0xE6E1D3; B5BI = 0x2A2C2F; B5BS = 0x5C5F63; B5A = 0xD8403A;
  B5S1 = 0xD8403A; B5S2 = 0x8A8E94; B5S3 = 0x2A2C2F;
