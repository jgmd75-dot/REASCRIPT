b3_pk_d = max(b3_pk_d, b3_pkm); b3_pkm = 0;
b3_sg_d = max(b3_sg_d, b3_sgm); b3_sgm = 0;
os_snapb(slider(22));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
