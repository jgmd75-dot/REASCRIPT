prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();
os_snap(slider(22));

@block
prs_chk();
b3_now = time_precise();
b3_tp > 0 && b3_now - b3_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > b3_gpp && play_position - b3_gpp < 4 * b3_gpd + 0.05) ? b3_rq = 1;
b3_tp = b3_now; b3_gpp = play_position; b3_gpd = samplesblock / srate;
