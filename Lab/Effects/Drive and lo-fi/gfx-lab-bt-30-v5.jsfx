@sample
by_in();
b3_rq ? ( b3_rq = 0; b3_rsf = 0; b3_rsc = 1 / (0.015 * srate); b3_rsw = pdc_delay; b3_gclr(); );
b3_rst ? ( b3_rst = 0; cL.b3_rest(); cR.b3_rest(); );
in_process(spl0, spl1);
b3_xl = in_l; b3_xr = in_r;
b3_mn += (b3_tmono - b3_mn) * b3_smk;
b3_xm = 0.5 * (b3_xl + b3_xr); b3_xl += (b3_xm - b3_xl) * b3_mn; b3_xr += (b3_xm - b3_xr) * b3_mn;
b3_dn = -b3_dn;
b3_tmod != b3_mod && b3_fst == 0 ? b3_fst = 1;
b3_fst == 1 ? ( b3_fade -= b3_fd; b3_fade <= 0 ? ( b3_fade = 0; b3_setmodel(b3_tmod); b3_hold = os_lat(os_f) + 48; b3_fst = 2; ); ) :
b3_fst == 2 ? ( b3_hold -= 1; b3_hold <= 0 ? b3_fst = 3; ) :
b3_fst == 3 ? ( b3_fade += b3_fd; b3_fade >= 1 ? ( b3_fade = 1; b3_fst = 0; ); );
b3_gd += (b3_tgd - b3_gd) * b3_smk; b3_mkd += (b3_tmkd - b3_mkd) * b3_smk; b3_mvd += (b3_tmvd - b3_mvd) * b3_smk;
b3_g = exp(b3_gd * 0.1151293); b3_mv = exp(b3_mvd * 0.1151293);
b3_rvg += (b3_trv - b3_rvg) * b3_smk; b3_cabm += (b3_tcab - b3_cabm) * b3_smk; b3_o += (b3_to - b3_o) * b3_smk;
b3_xl = pL.pf.clp_pf_run(pL.bb.am_run(pL.bv.am_run(pL.hi.b3_1run(b3_xl))));
b3_xr = pR.pf.clp_pf_run(pR.bb.am_run(pR.bv.am_run(pR.hi.b3_1run(b3_xr))));
b3_x2 = 0.5 * (b3_xl * b3_xl + b3_xr * b3_xr);
b3_me += (b3_x2 - b3_me) * (b3_x2 > b3_me ? b3_mea : b3_mer);
(b3_mc -= 1) <= 0 ? (
  b3_mc = 32;
  b3_e = min(max((10 * log10(b3_me + 0.0000000001) + 33) / 18, 0), 1);
  b3_md = -(b3_gg ^ 1.4) * (b3_mod ? 1.5 + 1.5 * b3_e : 2 + 2 * b3_e);
  cL.md.am_bq(2, b3_mod ? 750 : 650, 0.6, b3_md, b3_fr); cR.md.b0 = cL.md.b0; cR.md.b1 = cL.md.b1;
  cR.md.b2 = cL.md.b2; cR.md.a1 = cL.md.a1; cR.md.a2 = cL.md.a2;
);
pwr_in(b3_xl, b3_xr); b3_xl = pwr_l; b3_xr = pwr_r;
b3_rl = rsL.am_spring_run(sL.b3_send(cL.sacc * b3_ri), 0.7); b3_rr = rsR.am_spring_run(sR.b3_send(cR.sacc * b3_ri), 0.7);
cL.sacc = 0; cR.sacc = 0;
os_gate();
os_chg ? ( b3_rates(); b3_setmodel(b3_mod); upL.os_clr(); upR.os_clr(); dnL.os_clr(); dnR.os_clr(); );
os_f == 1 ? (
  b3_yl = k2L.s74_bq(k1L.s74_bq(cL.b3_core(b3_xl, b3_rl))); b3_yr = k2R.s74_bq(k1R.s74_bq(cR.b3_core(b3_xr, b3_rr)));
) : (
  upL.os_up(b3_xl); upR.os_up(b3_xr);
  b3_l0 = k2L.s74_bq(k1L.s74_bq(cL.b3_core(upL.s0, b3_rl))); b3_r0 = k2R.s74_bq(k1R.s74_bq(cR.b3_core(upR.s0, b3_rr)));
  b3_l1 = k2L.s74_bq(k1L.s74_bq(cL.b3_core(upL.s1, b3_rl))); b3_r1 = k2R.s74_bq(k1R.s74_bq(cR.b3_core(upR.s1, b3_rr)));
  os_f == 4 ? (
    b3_l2 = k2L.s74_bq(k1L.s74_bq(cL.b3_core(upL.s2, b3_rl))); b3_r2 = k2R.s74_bq(k1R.s74_bq(cR.b3_core(upR.s2, b3_rr)));
    b3_l3 = k2L.s74_bq(k1L.s74_bq(cL.b3_core(upL.s3, b3_rl))); b3_r3 = k2R.s74_bq(k1R.s74_bq(cR.b3_core(upR.s3, b3_rr)));
  );
  b3_yl = dnL.os_dn(b3_l0, b3_l1, b3_l2, b3_l3); b3_yr = dnR.os_dn(b3_r0, b3_r1, b3_r2, b3_r3);
);
os_g < 1 ? ( b3_gs = os_g * os_g * (3 - 2 * os_g); b3_yl *= b3_gs; b3_yr *= b3_gs; );
pwr_out(b3_yl, b3_yr); b3_yl = pwr_l; b3_yr = pwr_r;
b3_sgm = max(b3_sgm, max(cL.pa.env, cR.pa.env));
b3_cl = cabL.b3_cabrun(b3_yl); b3_cr = cabR.b3_cabrun(b3_yr);
b3_yl += (b3_cl - b3_yl) * b3_cabm; b3_yr += (b3_cr - b3_yr) * b3_cabm;
b3_k = exp(b3_mkd * 0.1151293) * b3_o * b3_fade;
b3_yl = ostL.ost_band(b3_yl * b3_k); b3_yr = ostR.ost_band(b3_yr * b3_k);
ost_out(b3_yl, b3_yr);
b3_yl = ost_l; b3_yr = ost_r;
b3_rsf < 1 ? (
