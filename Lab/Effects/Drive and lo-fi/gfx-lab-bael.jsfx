      this.A.clp_set(1, 1, 0.45, 0); this.B.clp_set(1, 1, 0.62, max(0.03 + 0.06 * tk + 1.2 * dz, 0));
      fz_kL1 = lg_op(7000, lg_fs2); fz_fbk = -0.8; fz_kF = lg_op(5, lg_fs2);
