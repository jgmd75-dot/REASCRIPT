function ch_clr() instance(lp1, lp2, tl) ( this.bo.bo_reset(); this.dr.dr_reset(); this.fu.fu_reset(); this.db.f4_bqc(); this.g0.gh_clr(); this.g1.gh_clr(); this.g2.gh_clr(); lp1 = lp2 = tl = 0; );

function lg_cfg(n) (
  chL.bo.bo_cfg(tb_bL, n); chR.bo.bo_cfg(tb_bR, n);
  chL.dr.odA.od_set(0, d3_vd, d3_vt, lg_fs2, n);
  chL.dr.odB.od_set(1, d3_vd, d3_vt, lg_fs2, n);
  chR.dr.odA.od_set(0, min(d3_vd * (1 + 0.1 * lg_wd), 1), d3_vt * (1 - 0.1 * lg_wd), lg_fs2, n);
  chR.dr.odB.od_set(1, min(d3_vd * (1 + 0.1 * lg_wd), 1), d3_vt * (1 - 0.1 * lg_wd), lg_fs2, n);
  dz_GA = 2.5 * 10 ^ (40 * d3_vf / 20); dz_GB = 3;
  dz_khp = lg_op(50, lg_fs2); dz_kL1 = lg_op(6000, lg_fs2); dz_kH1 = lg_op(80, lg_fs2); dz_kp = lg_op(5200, lg_fs2);
  chL.fu.dz.dz_cfg(d3_vf, d3_vbi, lg_fs2, n);
  chR.fu.dz.dz_cfg(min(d3_vf * (1 + 0.08 * lg_wd), 1), min(d3_vbi + 0.12 * lg_wd, 1), lg_fs2, n);
  chL.fu.ff.ff_cfg(fy_vfz, ff_bBL, fy_dz, lg_fs2, n); chR.fu.ff.ff_cfg(fy_vfz, ff_bBR, fy_dz, lg_fs2, n);
  chL.fu.f4.f4_coef(); chR.fu.f4.f4_coef();
