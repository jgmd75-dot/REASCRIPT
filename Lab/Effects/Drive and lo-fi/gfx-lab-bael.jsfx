function prs_hash() local(i, h) ( h = 0; i = 1; loop(31, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 34 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(34, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
lg_update();
pdc_delay = 0;

@block
prs_chk();
lg_now = time_precise();
lg_tp > 0 && lg_now - lg_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > lg_gpp && play_position - lg_gpp < 4 * lg_gpd + 0.05) ? lg_rq = 1;
lg_tp = lg_now; lg_gpp = play_position; lg_gpd = samplesblock / srate;
pwr_block(byp < 0.5);
srate != lg_sr ? ( lg_rate(); lg_all_clr(); lg_snap = 1; );
lg_update();
lg_pB == 2 ? ( lg_mB = lg_tmB; chL.bo.bo_reset(); chR.bo.bo_reset(); lg_prB = 1; lg_pB = 3; );
lg_pF == 2 ? ( lg_mF = lg_tmF; chL.fu.fu_reset(); chR.fu.fu_reset(); lg_prF = 1; lg_pF = 3; );
lg_block(samplesblock);
lg_pB == 3 ? lg_pB = 0;
lg_pF == 3 ? ( fz_gin = fz_tgin; lg_lvFs = lg_tlvF; fz_hL = fz_sHL; fz_hk = 1 / fz_sHL; lg_pF = 0; );
lg_tmB != lg_mB && lg_pB == 0 ? lg_pB = 1;
lg_tmF != lg_mF && lg_pF == 0 ? lg_pF = 1;
lg_tord != lg_ord && lg_pO == 0 ? lg_pO = 1;
c1_blk(samplesblock);
chL.bo.bo_tidy(); chR.bo.bo_tidy(); chL.dr.dr_tidy(); chR.dr.dr_tidy(); chL.fu.fu_tidy(); chR.fu.fu_tidy();
chL.db.f4_bqt(); chR.db.f4_bqt();
chL.lp1 = lg_tn(chL.lp1); chL.lp2 = lg_tn(chL.lp2); chR.lp1 = lg_tn(chR.lp1); chR.lp2 = lg_tn(chR.lp2);
d3_ef = lg_tn(d3_ef); d3_es = lg_tn(d3_es); d3_trs = lg_tn(d3_trs);
fy_env = lg_tn(fy_env); d3_e2 = lg_tn(d3_e2); d3_e3 = lg_tn(d3_e3); fz_env = lg_tn(fz_env);
fz_gev = lg_tn(fz_gev); fz_eb = lg_tn(fz_eb); fz_ew = lg_tn(fz_ew); fz_ep = lg_tn(fz_ep); fz_dg = lg_tn(fz_dg);
ostL.dcx = lg_tn(ostL.dcx); ostL.dcy = lg_tn(ostL.dcy); ostR.dcx = lg_tn(ostR.dcx); ostR.dcy = lg_tn(ostR.dcy);
lg_vu_d = max(lg_vu_d, sqrt(lg_ms / max(samplesblock, 1))); lg_ms = 0;
lg_pk_d = max(lg_pk_d, lg_pkm); lg_pkm = 0;
lg_aB_d = max(lg_aB_d, lg_aB * (slider2 >= 0.5)); lg_aD_d = max(lg_aD_d, lg_aD * (slider9 >= 0.5)); lg_aF_d = max(lg_aF_d, lg_aF * (slider14 >= 0.5)); lg_aB = lg_aD = lg_aF = 0;
pdc_delay = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
by_in();
lg_rq ? ( lg_rq = 0; lg_resume(); );
lg_xl = spl0; lg_xr = spl1;
lg_xl != lg_xl ? lg_xl = 0; lg_xr != lg_xr ? lg_xr = 0;
in_process(lg_xl, lg_xr);
pwr_in(in_l, in_r);
lg_xl = pwr_l; lg_xr = pwr_r;
abs(lg_xl) < 0.000000000000001 ? lg_xl = 0;
abs(lg_xr) < 0.000000000000001 ? lg_xr = 0;

os_gate();
os_chg ? ( lg_rate(); lg_cfg(1); lg_all_clr(); lg_prB = lg_prF = 1; pdc_delay = 0; os_hold = 32; );

fz_gin += (fz_tgin - fz_gin) * lg_gsm;
lg_xl *= fz_gin; lg_xr *= fz_gin;
chL.lp1 += fz_cl1 * (lg_xl - chL.lp1); chL.lp2 += fz_cl2 * (chL.lp1 - chL.lp2); lg_xl = chL.lp2;
chR.lp1 += fz_cl1 * (lg_xr - chR.lp1); chR.lp2 += fz_cl2 * (chR.lp1 - chR.lp2); lg_xr = chR.lp2;
lg_a = max(abs(lg_xl), abs(lg_xr)); fz_gev += (lg_a > fz_gev ? fz_gda : fz_gdr) * (lg_a - fz_gev);
fz_gthr > 0 ? ( fz_gev > fz_gthr ? fz_gop = 1 : fz_gev < 0.63 * fz_gthr ? fz_gop = 0; ) : fz_gop = 1;
fz_gg += (fz_gop ? fz_gga : fz_ggr) * (fz_gop - fz_gg);
lg_a = max(abs(lg_xl), abs(lg_xr));
d3_ef += (lg_a > d3_ef ? d3_tfa : d3_tfr) * (lg_a - d3_ef);
d3_es += (lg_a > d3_es ? d3_tsa : d3_tsr) * (lg_a - d3_es);
d3_trs += (min(max((d3_ef - 1.5 * d3_es) / (1.5 * d3_es + 0.00001), 0), 1) - d3_trs) * d3_tsm;
d3_flk = d3_tlk * (0.35 + 0.65 * d3_trs);
lg_a = max(lg_xl * lg_xl, lg_xr * lg_xr); fz_ep += (lg_a > fz_ep ? fz_dpa : fz_dqr) * (lg_a - fz_ep);

lg_tB = lg_inB && lg_pB == 0; lg_tD = lg_inD; lg_tF = lg_inF && lg_pF == 0;
lg_gB != lg_tB ? ( lg_gB == 0 ? ( chL.bo.bo_reset(); chR.bo.bo_reset(); chL.bo.bo_prime(tb_bL); chR.bo.bo_prime(tb_bR); );
                   lg_gB = lg_tB ? min(lg_gB + lg_fst, 1) : max(lg_gB - lg_fst, 0); );
lg_gD != lg_tD ? ( lg_gD == 0 ? ( chL.dr.dr_reset(); chR.dr.dr_reset(); );
                   lg_gD = lg_tD ? min(lg_gD + lg_fst, 1) : max(lg_gD - lg_fst, 0); );
lg_gF != lg_tF ? ( lg_gF == 0 ? ( chL.fu.fu_reset(); chR.fu.fu_reset(); chL.fu.ff.ff_prime(ff_bBL); chR.fu.ff.ff_prime(ff_bBR); );
                   lg_gF = lg_tF ? min(lg_gF + lg_fst, 1) : max(lg_gF - lg_fst, 0); );
lg_pB == 1 && lg_gB == 0 ? lg_pB = 2;
lg_pF == 1 && lg_gF == 0 ? lg_pF = 2;
lg_eB = lg_ss(lg_gB); lg_eD = lg_ss(lg_gD); lg_eF = lg_ss(lg_gF);
lg_tmD ? (
  d3_wB < 1 ? ( d3_wB == 0 ? ( chL.dr.odB.od_reset(); chR.dr.odB.od_reset(); ); d3_wB = min(d3_wB + lg_fst, 1); d3_wA = 1 - d3_wB; );
) : (
  d3_wA < 1 ? ( d3_wA == 0 ? ( chL.dr.odA.od_reset(); chR.dr.odA.od_reset(); ); d3_wA = min(d3_wA + lg_fst, 1); d3_wB = 1 - d3_wA; );
);
lg_pO == 1 ? (
  lg_dk = max(lg_dk - lg_dkc, 0);
  lg_dk == 0 ? ( lg_ord = lg_tord; lg_all_clr(); chL.bo.bo_prime(tb_bL); chR.bo.bo_prime(tb_bR); chL.fu.ff.ff_prime(ff_bBL); chR.fu.ff.ff_prime(ff_bBR); lg_pO = 2; lg_dh = 32; );
) : lg_pO == 2 ? (
  lg_dh > 0 ? lg_dh -= 1 : ( lg_dk = min(lg_dk + lg_dkc, 1); lg_dk >= 1 ? lg_pO = 0; );
);

ff_GAs += (ff_GA - ff_GAs) * lg_gsm;
tb_outs += (tb_out - tb_outs) * lg_gsm;
tb_khps *= (tb_khp / max(tb_khps, 0.0000001)) ^ lg_rsm;
tb_mids += (tb_mid - tb_mids) * lg_rsm;
zz_o += (zz_t - zz_o) * lg_gsm; zz_of += (zz_tf - zz_of) * lg_gsm;
lg_lvBs += (lg_tlvB - lg_lvBs) * lg_gsm; lg_lvDs += (lg_tlvD - lg_lvDs) * lg_gsm; lg_lvFs += (lg_tlvF - lg_lvFs) * lg_gsm;
d3_k2 = max(d3_kb - d3_sg * d3_e2, 0.5); d3_ik2 = 1 / d3_k2;
d3_kf = max(d3_kb - d3_sg * d3_e3, 0.5); d3_ikf = 1 / d3_kf;
chL.fu.dz.dz_rc(); chR.fu.dz.dz_rc();
fz_k = max(fz_kb - fz_sg * fz_env, 0.5); fz_ik = 1 / fz_k; fz_kmin = min(fz_kmin, fz_k);

