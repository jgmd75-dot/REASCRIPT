desc:Bael [drive board] (GFX Lab)
//tags: drive overdrive fuzz boost treble booster vibe octave germanium silicon stompbox guitar pedalboard
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-clip, gfx-lab-os, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider33:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,5,1{Boost then drive then fuzz,Boost then fuzz then drive,Drive then boost then fuzz,Drive then fuzz then boost,Fuzz then boost then drive,Fuzz then drive then boost}>-Order
slider2:1<0,1,1{Out,In}>-Boost in
slider3:0<0,2,1{Maze,Treble,Vibe}>-Boost model
slider4:5<0,10,0.1>-Boost
slider5:5<0,10,0.1>-Boost tone
slider6:0<0,2,1{Treble,Full,Mid}>-Treble range
slider7:0<0,1,1{Germanium,Silicon}>-Treble transistor
slider8:5<0,10,0.1>-Boost level
slider9:1<0,1,1{Out,In}>-Drive in
slider10:0<0,1,1{Model A,Model B}>-Drive model
slider11:5<0,10,0.1>-Drive
slider12:5<0,10,0.1>-Drive tone
slider13:5<0,10,0.1>-Drive level
slider14:0<0,1,1{Out,In}>-Fuzz in
slider15:0<0,11,1{Fyre,DST,Hyper boost,Hyper I,Hyper II,Brass,Twin,Upper,Round GE,Round SI,Octave,Thick}>-Fuzz model
slider16:6<0,10,0.1>-Fuzz
slider17:5<0,10,0.1>-Fuzz tone
slider18:5<0,10,0.1>-Fuzz bias / bass / hi-mid
slider19:5<0,10,0.1>-Fuzz level
slider20:100<0,100,1>-Blend (chain / clean, %)
slider21:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider22:10<0,10,0.1>-Guitar volume
slider23:75<0,100,1>-Tame (%)
slider24:0<0,1,1{Off,On}>-Width
slider25:0<-24,12,0.1>-Input trim (dB)
slider26:0<0,1,1{Off,On}>-Input guard
slider28:33<0,100,1>-Drift (%)
slider29:0<-24,12,0.1>-Output (dB)
slider30:os_sel=1<0,2,1{1x,2x,4x}>-Oversampling
slider31:byp=0<0,1,1{Off,On}>-Bypass
slider32:prs_sel=0<0,34,1{No preset,Init,Clean Sparkle,Treble Bite,Silicon Treble,Full Range Push,Mid Push,Thick Fuzz,Cleans Up,Treble Into Fuzz,Fuzz Into Boost,Sputter Gate,Wall of Fyre,Warm Buffer,Edge of Breakup,Mid Hump Lead,Bass Overdrive,Low End Grind,Stacked Grit,Fuzz Under Glass,Attack Keeper,Wall of Fuzz,Gated Sputter,Dry Fuzz Bed,Hyper Wall,Singing Lead,Boosted Crunch,Brass Buzz,Modelled Round,Ring Upper,Germanium Round,Volume Clean-Up,Silicon Scream,Octave Lead,Thick Octave}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
function psw_all(v) ( slider_show(8589934591, v); );
function psw_allg(v) ( slider_show(8589934591, v); );
#ui_man = "gfx-lab-bael";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;

function lg_op(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.49 * fs) / fs); );
function lg_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function lg_lv(q) ( q <= 0.5 ? sqr(q / 0.5) : 1 + (q - 0.5) * 2; );
function lg_ss(g) ( g * g * (3 - 2 * g); );

lg_h0 = 0.036681502164; lg_h1 = 0.136547624632; lg_h2 = 0.274631759379; lg_h3 = 0.423138617437;
lg_h4 = 0.561098697879; lg_h5 = 0.677540049974; lg_h6 = 0.769741833863; lg_h7 = 0.839889624850;
lg_h8 = 0.892260818004; lg_h9 = 0.931541959963; lg_h10 = 0.962094548378; lg_h11 = 0.987816370733;
function hb_up(x) instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5, o0, o1) local(t, y) (
  t = x;
  y = lg_h0 * (t - ua0) + ux0; ux0 = t; ua0 = y; t = y;
  y = lg_h2 * (t - ua1) + ux1; ux1 = t; ua1 = y; t = y;
  y = lg_h4 * (t - ua2) + ux2; ux2 = t; ua2 = y; t = y;
  y = lg_h6 * (t - ua3) + ux3; ux3 = t; ua3 = y; t = y;
  y = lg_h8 * (t - ua4) + ux4; ux4 = t; ua4 = y; t = y;
  y = lg_h10 * (t - ua5) + ux5; ux5 = t; ua5 = y; o0 = y;
  t = x;
  y = lg_h1 * (t - ub0) + uy0; uy0 = t; ub0 = y; t = y;
  y = lg_h3 * (t - ub1) + uy1; uy1 = t; ub1 = y; t = y;
  y = lg_h5 * (t - ub2) + uy2; uy2 = t; ub2 = y; t = y;
  y = lg_h7 * (t - ub3) + uy3; uy3 = t; ub3 = y; t = y;
  y = lg_h9 * (t - ub4) + uy4; uy4 = t; ub4 = y; t = y;
  y = lg_h11 * (t - ub5) + uy5; uy5 = t; ub5 = y; o1 = y;
);
function hb_dn(s0, s1) instance(da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5, dy0, dy1, dy2, dy3, dy4, dy5) local(t, y, p) (
  t = s1;
  y = lg_h0 * (t - da0) + dx0; dx0 = t; da0 = y; t = y;
  y = lg_h2 * (t - da1) + dx1; dx1 = t; da1 = y; t = y;
  y = lg_h4 * (t - da2) + dx2; dx2 = t; da2 = y; t = y;
  y = lg_h6 * (t - da3) + dx3; dx3 = t; da3 = y; t = y;
  y = lg_h8 * (t - da4) + dx4; dx4 = t; da4 = y; t = y;
  y = lg_h10 * (t - da5) + dx5; dx5 = t; da5 = y; p = y;
  t = s0;
  y = lg_h1 * (t - db0) + dy0; dy0 = t; db0 = y; t = y;
  y = lg_h3 * (t - db1) + dy1; dy1 = t; db1 = y; t = y;
  y = lg_h5 * (t - db2) + dy2; dy2 = t; db2 = y; t = y;
  y = lg_h7 * (t - db3) + dy3; dy3 = t; db3 = y; t = y;
  y = lg_h9 * (t - db4) + dy4; dy4 = t; db4 = y; t = y;
  y = lg_h11 * (t - db5) + dy5; dy5 = t; db5 = y;
  0.5 * (p + y);
);
function hb_uclr() instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5, o0, o1) (
  ua0 = ua1 = ua2 = ua3 = ua4 = ua5 = ux0 = ux1 = ux2 = ux3 = ux4 = ux5 = 0;
  ub0 = ub1 = ub2 = ub3 = ub4 = ub5 = uy0 = uy1 = uy2 = uy3 = uy4 = uy5 = o0 = o1 = 0;
);
function hb_dclr() instance(da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5, dy0, dy1, dy2, dy3, dy4, dy5) (
  da0 = da1 = da2 = da3 = da4 = da5 = dx0 = dx1 = dx2 = dx3 = dx4 = dx5 = 0;
  db0 = db1 = db2 = db3 = db4 = db5 = dy0 = dy1 = dy2 = dy3 = dy4 = dy5 = 0;
);
function hb_utidy() instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5) (
  ua0 = lg_tn(ua0); ua1 = lg_tn(ua1); ua2 = lg_tn(ua2); ua3 = lg_tn(ua3); ua4 = lg_tn(ua4); ua5 = lg_tn(ua5);
  ux0 = lg_tn(ux0); ux1 = lg_tn(ux1); ux2 = lg_tn(ux2); ux3 = lg_tn(ux3); ux4 = lg_tn(ux4); ux5 = lg_tn(ux5);
  ub0 = lg_tn(ub0); ub1 = lg_tn(ub1); ub2 = lg_tn(ub2); ub3 = lg_tn(ub3); ub4 = lg_tn(ub4); ub5 = lg_tn(ub5);
  uy0 = lg_tn(uy0); uy1 = lg_tn(uy1); uy2 = lg_tn(uy2); uy3 = lg_tn(uy3); uy4 = lg_tn(uy4); uy5 = lg_tn(uy5);
);
function hb_dtidy() instance(da0, da1, da2, da3, da4, da5, dx0, dx1, dx2, dx3, dx4, dx5, db0, db1, db2, db3, db4, db5, dy0, dy1, dy2, dy3, dy4, dy5) (
  da0 = lg_tn(da0); da1 = lg_tn(da1); da2 = lg_tn(da2); da3 = lg_tn(da3); da4 = lg_tn(da4); da5 = lg_tn(da5);
  dx0 = lg_tn(dx0); dx1 = lg_tn(dx1); dx2 = lg_tn(dx2); dx3 = lg_tn(dx3); dx4 = lg_tn(dx4); dx5 = lg_tn(dx5);
  db0 = lg_tn(db0); db1 = lg_tn(db1); db2 = lg_tn(db2); db3 = lg_tn(db3); db4 = lg_tn(db4); db5 = lg_tn(db5);
  dy0 = lg_tn(dy0); dy1 = lg_tn(dy1); dy2 = lg_tn(dy2); dy3 = lg_tn(dy3); dy4 = lg_tn(dy4); dy5 = lg_tn(dy5);
);
function os_clr4() ( this.u1.hb_uclr(); this.u2.hb_uclr(); this.d1.hb_dclr(); this.d2.hb_dclr(); );
function os_tidy4() ( this.u1.hb_utidy(); this.u2.hb_utidy(); this.d1.hb_dtidy(); this.d2.hb_dtidy(); );

LG_PERM = 0;
LG_PERM[0] = 0; LG_PERM[1] = 1; LG_PERM[2] = 2;
LG_PERM[3] = 0; LG_PERM[4] = 2; LG_PERM[5] = 1;
LG_PERM[6] = 1; LG_PERM[7] = 0; LG_PERM[8] = 2;
LG_PERM[9] = 1; LG_PERM[10] = 2; LG_PERM[11] = 0;
LG_PERM[12] = 2; LG_PERM[13] = 0; LG_PERM[14] = 1;
LG_PERM[15] = 2; LG_PERM[16] = 1; LG_PERM[17] = 0;

D3T = 100;
function d3_tab(base, v) local(i, f) (
  v = min(max(v, 0), 1) * 10; i = min(floor(v), 9); f = v - i;
  10 ^ ((D3T[base + i] * (1 - f) + D3T[base + i + 1] * f) / 20);
);
function d3_tset(base, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) (
  D3T[base] = a0; D3T[base + 1] = a1; D3T[base + 2] = a2; D3T[base + 3] = a3; D3T[base + 4] = a4; D3T[base + 5] = a5;
  D3T[base + 6] = a6; D3T[base + 7] = a7; D3T[base + 8] = a8; D3T[base + 9] = a9; D3T[base + 10] = a10;
);
d3_tset(0,  -14.47, -15.23, -15.88, -16.80, -17.50, -18.53, -19.27, -20.09, -20.49, -21.09, -21.62);
d3_tset(11, -13.31, -14.34, -15.78, -17.32, -18.97, -20.35, -21.69, -23.04, -24.20, -24.25, -25.07);
d3_tset(22, -12.51, -16.81, -20.07, -22.81, -24.88, -26.21, -27.10, -27.76, -28.66, -29.33, -29.49);

C_F1 = 1000; C_F2 = 1005; C_F3 = 1010; C_F4 = 1015;
function zz_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1) );
function zz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function zz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function zz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function zz_bmt() instance(z1, z2) ( z1 = lg_tn(z1); z2 = lg_tn(z2); );
function zz_run(x, o) instance(fh, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = this.zA.zz_bm(x, C_F1);
  ha = abs(h); fh += (ha - fh) * (ha > fh ? zz_a : zz_r);
  fp += (abs(x) - fp) * zz_w;
  nn = 1 / (max(fh, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (zz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fh;
  e = this.zD.zz_bm(this.zC.zz_bm(this.zB.zz_bm(e, C_F2), C_F3), C_F4);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? zz_a : zz_r);
  g = o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function zz_clr() instance(fh, fp, fe) ( this.zA.zz_bmz(); this.zB.zz_bmz(); this.zC.zz_bmz(); this.zD.zz_bmz(); fh = fp = fe = 0; );
function zz_tidy() instance(fh, fp, fe) ( this.zA.zz_bmt(); this.zB.zz_bmt(); this.zC.zz_bmt(); this.zD.zz_bmt(); fh = lg_tn(fh); fp = lg_tn(fp); fe = lg_tn(fe); );
function zz_coef() (
  zz_bqc(C_F1, 4, 3500, 0, 0.7071, lg_fs2); zz_bqc(C_F2, 4, 5500, 0, 0.7071, lg_fs2);
  zz_bqc(C_F3, 0, 8000, 4, 0.7, lg_fs2); zz_bqc(C_F4, 2, 12000, -6, 0.7, lg_fs2);
  zz_a = 1 - exp(-1 / (0.003 * lg_fs2)); zz_r = 1 - exp(-1 / (0.12 * lg_fs2)); zz_w = 1 - exp(-1 / (0.06 * lg_fs2));
);

function mz_run(x) instance(hp, lo) local(h, v, y) (
  h = x - hp; hp += mz_khp * (x - hp);
  v = h * (lg_sd ? mz_gR : mz_gL);
  y = this.c.clp_run(v * 0.625 + mz_b) * 1.6 - mz_r;
  lo += mz_klo * (y - lo); y = lo + mz_hs * (y - lo);
  y;
);
function mz_reset() instance(hp, lo) ( hp = lo = 0; this.c.clp_reset(); );
function mz_tidy() instance(hp, lo) ( hp = lg_tn(hp); lo = lg_tn(lo); this.c.clp_tidy(); );
function mz_cfg() ( this.c.clp_set(1, 1, 0.9, 0); mz_r = this.c.clp_crv(mz_b) * 1.6; );

function tb_run(x) instance(hp, lp, ol, dc, rest) local(h, v, y) (
  h = x - hp; hp += tb_khps * (x - hp);
  lp += tb_klp * (h - lp); h += tb_mids * (lp - h);
  v = this.c.clp_pf_run(h);
  y = this.c.clp_run(v * (lg_sd ? tb_GR : tb_GL) + (lg_sd ? tb_bR : tb_bL)) - rest;
  ol += tb_kol * (y - ol);
  y = ol - dc; dc += tb_kdc * (ol - dc);
  y * tb_outs;
);
function tb_reset() instance(hp, lp, ol, dc) ( hp = lp = ol = dc = 0; this.c.clp_reset(); this.c.clp_pf_reset(); );
function tb_tidy() instance(hp, lp, ol, dc) ( hp = lg_tn(hp); lp = lg_tn(lp); ol = lg_tn(ol); dc = lg_tn(dc); this.c.clp_tidy(); );
function tb_cfg(drv, b, fs, n) instance(rest) (
  tb_si ? ( this.c.clp_set(2, 0.78, 0.72, 0); this.c.clp_kt_cfg(0.08, 0.18); )
        : ( this.c.clp_set(2, 0.85, 0.5, 0);  this.c.clp_kt_cfg(0.22, 0.38); );
  this.c.clp_knee(this.c.clp_kt_block(drv, fs, n));
  this.c.clp_pf_cfg(40000, 12000, -1, 120); this.c.clp_pf_block(drv, fs, n);
  rest = this.c.clp_crv(b);
);

function c1_reset() instance(c_l1, c_lm, c_hs, c_o, c_s1x, c_s1y, c_s2x, c_s2y, c_s3x, c_s3y, c_s4x, c_s4y) (
  c_l1 = c_lm = c_hs = c_o = 0; c_s1x = c_s1y = c_s2x = c_s2y = c_s3x = c_s3y = c_s4x = c_s4y = 0;
  this.c1c.clp_reset();
);
function c1_run(x) instance(c_l1, c_lm, c_hs, c_o, c_s1x, c_s1y, c_s2x, c_s2y, c_s3x, c_s3y, c_s4x, c_s4y, c_a1, c_a2, c_a3, c_a4) local(y, h, a) (
  c_l1 += c1_kld * (x - c_l1);
  c_lm += c1_klm * (c_l1 - c_lm);
  y = c_l1 + 0.26 * c_lm;
  h = y - c_hs; c_hs += c1_khp * (y - c_hs);
  y = (this.c1c.clp_run(1.6 * h + 0.12) - c1_rb) * 0.625;
  a = c_a1 * y + c_s1x - c_a1 * c_s1y; c_s1x = y; c_s1y = a;
  h = c_a2 * a + c_s2x - c_a2 * c_s2y; c_s2x = a; c_s2y = h;
  a = c_a3 * h + c_s3x - c_a3 * c_s3y; c_s3x = h; c_s3y = a;
  h = c_a4 * a + c_s4x - c_a4 * c_s4y; c_s4x = a; c_s4y = h;
  y = 0.8 * y + 0.2 * h;
  c_o += c1_ktop * (y - c_o);
  1.315 * c_o;
);
function c1_apc(f) local(t) ( t = tan($pi * min(max(f, 5), 0.45 * srate) / srate); (t - 1) / (t + 1); );
function c1_side(fb) instance(c_l1, c_lm, c_hs, c_o, c_s1x, c_s1y, c_s2x, c_s2y, c_s3x, c_s3y, c_s4x, c_s4y, c_a1, c_a2, c_a3, c_a4) (
  c_a1 = c1_apc(fb * 0.313); c_a2 = c1_apc(fb * 0.0214); c_a3 = c1_apc(fb * 10); c_a4 = c1_apc(fb);
  this.c1c.clp_set(1, 1, 0.75, 0);
  this.c1c.clp_tidy();
  c_l1 = lg_tn(c_l1); c_lm = lg_tn(c_lm); c_hs = lg_tn(c_hs); c_o = lg_tn(c_o);
  c_s1x = lg_tn(c_s1x); c_s1y = lg_tn(c_s1y); c_s2x = lg_tn(c_s2x); c_s2y = lg_tn(c_s2y);
  c_s3x = lg_tn(c_s3x); c_s3y = lg_tn(c_s3y); c_s4x = lg_tn(c_s4x); c_s4y = lg_tn(c_s4y);
);
function c1_blk(n) local(u, k, v, fb) (
  c1_ph += 0.2 * (1 + 0.15 * dm_a * c1R.drift_tick(0.05 * dm_s * n / srate)) * n / srate;
  c1_ph -= floor(c1_ph);
  u = 0.5 + 0.5 * sin(2 * $pi * c1_ph);
  k = u > c1_bulb ? 1 - exp(-n / (0.015 * srate)) : 1 - exp(-n / (0.09 * srate)); c1_bulb += (u - c1_bulb) * k;
