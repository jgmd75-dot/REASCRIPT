function gh_clr() instance(ax1, ay1, ax2, ay2, dp) ( this.os_clr4(); ax1 = ay1 = ax2 = ay2 = dp = 0; );
function ch_run(x) instance(dy) local(y, k, m, s) (
  y = x; k = 0; dy = x; s = 0;
  loop(3,
    m = LG_PERM[lg_ord * 3 + k];
    m == 0 ? ( lg_aB = max(lg_aB, abs(y)); lg_gB > 0 ? y += lg_eB * (this.bo.bo_run(y) * lg_lvBs - y); k == 0 ? ( dy = y; s = 1; ); ) :
    m == 1 ? ( lg_aD = max(lg_aD, abs(y)); lg_gD > 0 ? y += lg_eD * (this.dr.dr_run(y) * lg_lvDs - y); ) :
             ( lg_aF = max(lg_aF, abs(y)); lg_gF > 0 ? y += lg_eF * (this.fu.fu_run(y) * lg_lvFs - y); );
    k += 1;
