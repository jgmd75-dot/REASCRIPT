    loop(3 - s,
      m = LG_PERM[lg_ord * 3 + k];
      m == 0 ? ( lg_mB < 2 && lg_eB > 0 ? ( lg_ga = 0; dy += lg_eB * (this.g0.gh_run(dy) - dy); ); ) :
      m == 1 ? ( lg_eD > 0 ? ( lg_ga = 0; dy += lg_eD * (this.g1.gh_run(dy) - dy); ); ) :
