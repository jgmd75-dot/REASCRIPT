function fu_reset() instance(lo, ax1, ay1, ax2, ay2, dp) ( this.ff.ff_reset(); this.dz.dz_reset(); this.zf.zz_clr(); this.f4.f4_reset(); this.os_clr4(); lo = ax1 = ay1 = ax2 = ay2 = dp = 0; );
function fu_tidy() instance(lo, ax1, ay1, ax2, ay2, dp) ( this.ff.ff_tidy(); this.dz.dz_tidy(); this.zf.zz_tidy(); this.f4.f4_tidy(); this.os_tidy4(); lo = lg_tn(lo); ax1 = lg_tn(ax1); ay1 = lg_tn(ay1); ax2 = lg_tn(ax2); ay2 = lg_tn(ay2); dp = lg_tn(dp); );

function gh_one(s) instance(ax1, ay1, ax2, ay2, dp) local(w, w2) (
  lg_ga > 0 ? (
    w = d3_apk * dp + ax1 - d3_apk * ay1; ax1 = dp; ay1 = w;
    w2 = d3_apk * w + ax2 - d3_apk * ay2; ax2 = w; ay2 = w2;
    dp = s; s += lg_ga * (w2 - s);
