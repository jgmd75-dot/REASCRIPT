function lg_targets() (
  lg_tord = floor(min(max(slider1, 0), 5) + 0.5);
  lg_tmB = floor(min(max(slider3, 0), 2) + 0.5);
  lg_tmD = slider10 >= 0.5;
  lg_tmF = floor(min(max(slider15, 0), 11) + 0.5);
  lg_inB = slider2 >= 0.5; lg_inD = slider9 >= 0.5; lg_inF = slider14 >= 0.5;
  fy_q = min(max(slider4, 0), 10) / 10; fy_qmt = min(max(slider5, 0), 10) / 10;
  lg_qlB = min(max(slider8, 0), 10) / 10;
  d3_qd = min(max(slider11, 0), 10) / 10; d3_qt = min(max(slider12, 0), 10) / 10; lg_qlD = min(max(slider13, 0), 10) / 10;
  lg_qf = min(max(slider16, 0), 10) / 10; lg_qt = min(max(slider17, 0), 10) / 10;
  lg_qx = min(max(slider18, 0), 10) / 10; lg_ql = min(max(slider19, 0), 10) / 10;
  fz_qin = min(max(slider22, 0), 10) / 10;
  fz_qtm = min(max(slider23, 0), 100) / 100;
);
function lg_f4md(m) ( m <= 4 ? m - 2 : m <= 7 ? m - 5 : m <= 9 ? m - 8 : m - 10; );
function lg_f4m(m) ( m <= 4 ? 0 : m <= 7 ? 1 : m <= 9 ? 2 : 3; );

function lg_update() (
  in_setup(slider25, slider26 >= 0.5);
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
  drift_macro(slider28);
  lg_tout = 10 ^ (slider29 / 20);
  fz_gthr = slider21 <= -79.5 ? 0 : 10 ^ (slider21 / 20);
  lg_qbl = min(max(slider20, 0), 100) / 100;
  lg_nrm = 1 / max((lg_qbl ^ 1.4 + (1 - lg_qbl) ^ 1.4) ^ (1 / 1.4), 0.000001);
  lg_twet = lg_qbl * lg_nrm; lg_tdry = (1 - lg_qbl) * lg_nrm;
  os_tf = os_f2n(os_sel);
  lg_targets();
);

function lg_block(n) local(t) (
  lg_gl = lg_snap ? 1 : 1 - exp(-n / (0.03 * srate));
  fy_vmz += (fy_q - fy_vmz) * lg_gl; fy_vmt += (fy_qmt - fy_vmt) * lg_gl; fy_vtb += (fy_q - fy_vtb) * lg_gl;
  fy_vfz += (lg_qf - fy_vfz) * lg_gl; fy_vbi += (lg_qx - fy_vbi) * lg_gl; fy_vft += (lg_qt - fy_vft) * lg_gl; fy_vfv += (lg_ql - fy_vfv) * lg_gl;
  d3_vd += (d3_qd - d3_vd) * lg_gl; d3_vt += (d3_qt - d3_vt) * lg_gl; d3_vf += (lg_qf - d3_vf) * lg_gl; d3_vbi += (lg_qx - d3_vbi) * lg_gl;
  fz_vin += (fz_qin - fz_vin) * lg_gl; fz_vg += (lg_qf - fz_vg) * lg_gl; fz_vb += (lg_qx - fz_vb) * lg_gl;
  fz_vt += (lg_qt - fz_vt) * lg_gl; fz_vf += (lg_qf - fz_vf) * lg_gl; fz_vl += (lg_ql - fz_vl) * lg_gl; fz_vv += (lg_ql - fz_vv) * lg_gl; fz_vh += (lg_qx - fz_vh) * lg_gl;
  lg_wd += ((slider24 >= 0.5) - lg_wd) * lg_gl;
  slider24 < 0.5 && lg_wd < 0.000001 ? lg_wd = 0;
  fz_wd = lg_wd; fz_wg = 1 + 0.2 * lg_wd; fz_wb = 0.06 * lg_wd;
  chL.fu.f4.wg = 1; chL.fu.f4.wb = 0; chR.fu.f4.wg = fz_wg; chR.fu.f4.wb = fz_wb;

  fy_dT = 0.035 * dm_a * dT.drift_tick(0.06 * dm_s * n / srate);
  fy_dF = 0.05 * dm_a * dF.drift_tick(0.05 * dm_s * n / srate);
  fy_dF2 = 0.03 * dm_a * dF2.drift_tick(0.07 * dm_s * n / srate);
  fy_dM = 0.01 * dm_a * dM.drift_tick(0.04 * dm_s * n / srate);
  mz_gL = 10 ^ (20 * fy_vmz / 20); mz_gR = 10 ^ (20 * min(fy_vmz * (1 + 0.06 * lg_wd), 1) / 20);
  mz_hs = 10 ^ ((fy_vmt <= 0.5 ? -6 + 12 * fy_vmt : 18 * (fy_vmt - 0.5)) / 20);
  mz_b = 0.04 + fy_dM;
  tb_si = slider7 >= 0.5; t = floor(slider6 + 0.5); tb_mid = t == 2;
  tb_khp = lg_op(t == 0 ? 1600 : t == 1 ? 80 : 550, lg_fs2);
  tb_kol = lg_op(tb_si ? 12000 : 9000, lg_fs2);
  t = (10 ^ (2 * fy_vtb) - 1) / 99;
  tb_GL = 2 + 38 * t; tb_GR = 2 + 38 * min(t * (1 + 0.1 * lg_wd), 1);
  t = (tb_si ? 0.03 : 0.08) + fy_dT;
  tb_bL = t; tb_bR = t + 0.03 * lg_wd;
  t = floor(slider6 + 0.5);
  tb_out = (tb_si ? 0.9 : 1.05) * (t == 1 ? 0.235 : t == 2 ? 0.45 : 1);
  ff_GA = 3 * 20 ^ fy_vfz; ff_GB = 1.3;
  ff_bA = 0.12 + fy_dF;
  fy_sag = fy_env * 0.12 * dm_a;
  t = (fy_vbi <= 0.5 ? 0.08 - 0.06 * fy_vbi : 0.05 - 0.5 * ((fy_vbi - 0.5) * 2) ^ 1.5) + fy_dF2 - fy_sag;
  ff_bBL = t; ff_bBR = t + 0.04 * lg_wd; fy_bB = t;
  fy_dz = 0.12 * max(fy_vbi - 0.5, 0) * 2;
  ff_tg = 0.15 + 2.2 * fy_vft * fy_vft;
  ff_vol = 0.083 * (fy_vfv <= 0.5 ? sqr(fy_vfv / 0.5) : 1 + (fy_vfv - 0.5) * 2) / (0.6 + 0.4 * ff_tg);

  zz_t = 0.33 * min(max((d3_qd - 0.5) * 2, 0), 1);
  zz_tf = 0.33 * min(max((lg_qf - 0.5) * 2, 0), 1);
  lg_snap ? ( zz_o = zz_t; zz_of = zz_tf; );
  d3_trA = d3_tab(0, d3_vd); d3_trB = d3_tab(11, d3_vd);
  d3_ftr = d3_tab(22, d3_vf);
  d3_sg = 0.08 * dm_a; d3_kb = 1 - 0.03 * dm_a;
  d3_kfb = d3_kf;
  d3_lk = 0.45 * lg_qf * lg_qf;
  d3_fwet = 1 / ((1 + (0.35 * d3_lk) ^ 1.4) ^ (1 / 1.4)); d3_tlk = d3_lk * d3_fwet;

  fz_m = lg_f4m(lg_mF); fz_md = lg_f4md(lg_mF);
  fz_T = dm_a * fzT.drift_tick(0.004 * dm_s * n / srate);
  fz_kblk = fz_k;

  lg_cfg(n);
  lg_snap || lg_prB ? ( chL.bo.bo_prime(tb_bL); chR.bo.bo_prime(tb_bR); );
  lg_snap || lg_prF ? ( chL.fu.ff.ff_prime(ff_bBL); chR.fu.ff.ff_prime(ff_bBR); );
  lg_prB = lg_prF = 0;

  lg_tlvB = lg_mB == 2 ? lg_lv(lg_qlB) : lg_lv(lg_qlB);
  lg_tlvD = lg_lv(lg_qlD);
  lg_tlvF = lg_mF == 0 ? 1 : lg_mF == 1 ? lg_lv(lg_ql) : fz_tlv;
  lg_zin = lg_inF && lg_mF >= 2 ? fz_zin : 1000000;
  t = (10 ^ (1.8 * fz_vin) - 1) / (10 ^ 1.8 - 1);
  lg_vt = 250000 * t * (1 - t);
  fz_tgin = t * lg_zin / (lg_zin + lg_vt + 6000 * t);
  lg_vf = (lg_zin + lg_vt + 6000) / (2 * $pi * 0.8 * t * t + 0.000000001);
  fz_cl1 = lg_vf >= 0.45 * srate ? 1 : lg_op(lg_vf, srate);
  lg_vf = 1 / (2 * $pi * (lg_vt * lg_zin / (lg_vt + lg_zin) + 1) * 0.00000000047);
  fz_cl2 = lg_vf >= 0.45 * srate ? 1 : lg_op(lg_vf, srate);
  lg_href = lg_mF >= 2 ? fz_href : -21;

  lg_snap ? (
    ff_GAs = ff_GA; tb_outs = tb_out; tb_khps = tb_khp; tb_mids = tb_mid;
    lg_lvBs = lg_tlvB; lg_lvDs = lg_tlvD; lg_lvFs = lg_tlvF; fz_gin = fz_tgin; lg_wet = lg_twet; lg_dry = lg_tdry; lg_out = lg_tout;
    fz_tq = fz_qtm; fz_hL = fz_sHL; fz_hk = 1 / fz_sHL;
  );
  lg_snap = 0;
);

function lg_resume() (
  lg_rsf = 0; lg_rsc = 1 / (0.015 * srate);
  lg_all_clr();
  lg_prB = lg_prF = 1;
);

os_base = 0; os_f = os_tf = os_f2n(os_sel); os_gsetup(); pdc_delay = 0;
lg_rate();
in_init();
ostL.ost_ch_init(); ostR.ost_ch_init();
dT.drift_init(0.8 + rand(1) * 0.4); dF.drift_init(0.8 + rand(1) * 0.4); dF2.drift_init(0.8 + rand(1) * 0.4); dM.drift_init(0.8 + rand(1) * 0.4);
c1R.drift_init(0.8 + rand(1) * 0.4); c1D.drift_init(0.8 + rand(1) * 0.4); fzT.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
c1_bulb = c1_ldr = 0.5; c1_ph = rand(1); c1_light = 0.5;
d3_k2 = d3_ik2 = d3_kf = d3_ikf = 1; d3_kfb = 1;
fz_k = fz_ik = 1; fz_kblk = 1; fz_T = 0; fz_gg = 1; fz_gop = 0; fz_sHL = 0.12;
lg_update();
lg_ord = lg_tord; lg_mB = lg_tmB; lg_mF = lg_tmF; lg_mD = lg_tmD;
d3_wA = lg_tmD < 0.5; d3_wB = 1 - d3_wA;
lg_gB = lg_inB; lg_gD = lg_inD; lg_gF = lg_inF;
lg_dk = 1; lg_rsf = 1;
lg_all_clr();
lg_snap = 1;
lg_block(1);
by_setup(31);
pwr_init(); pwr_hum_db = -86; pwr_sag = 0.2; pwr_wu_loss = 0.8; pwr_wu_drv = 1.2; pwr_wu_lp = 8000; pwr_wu_wob = 0.3; pwr_bloom = 0;
