      this.u2.hb_up(this.u1.o0); a = this.fu_one(this.u2.o0); b = this.fu_one(this.u2.o1); a = this.d2.hb_dn(a, b);
      this.u2.hb_up(this.u1.o1); c = this.fu_one(this.u2.o0); d = this.fu_one(this.u2.o1); b = this.d2.hb_dn(c, d);
    );
