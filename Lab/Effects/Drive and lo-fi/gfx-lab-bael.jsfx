function gh_run(x) local(a, b) (
  this.u1.hb_up(x);
  lg_F == 2 ? ( a = this.gh_one(this.u1.o0); b = this.gh_one(this.u1.o1); ) : (
    this.u2.hb_up(this.u1.o0); a = this.d2.hb_dn(this.gh_one(this.u2.o0), this.gh_one(this.u2.o1));
    this.u2.hb_up(this.u1.o1); b = this.d2.hb_dn(this.gh_one(this.u2.o0), this.gh_one(this.u2.o1));
