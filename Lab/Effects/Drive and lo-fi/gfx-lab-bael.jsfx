function lg_rate() (
  lg_sr = srate; lg_F = os_f; lg_fs2 = lg_F * srate;
  mz_khp = lg_op(20, lg_fs2); mz_klo = lg_op(3200, lg_fs2);
  tb_kdc = lg_op(15, lg_fs2); tb_klp = lg_op(3500, lg_fs2);
  ff_kld = lg_op(6000, lg_fs2); ff_khp = lg_op(60, lg_fs2); ff_kL1 = lg_op(7000, lg_fs2); ff_kH1 = lg_op(40, lg_fs2);
  ff_ktl = lg_op(1500, lg_fs2); ff_kdc = lg_op(15, lg_fs2);
  c1_kld = lg_op(12500, srate); c1_klm = lg_op(300, srate); c1_khp = lg_op(30, srate); c1_ktop = lg_op(11000, srate);
  d3_gsm2 = 1 - exp(-1 / (0.012 * lg_fs2));
  d3_apk = tan($pi * 4200 / lg_fs2); d3_apk = (d3_apk - 1) / (d3_apk + 1);
  d3_tfa = 1 - exp(-1 / (0.0005 * srate)); d3_tfr = 1 - exp(-1 / (0.02 * srate));
  d3_tsa = 1 - exp(-1 / (0.04 * srate)); d3_tsr = 1 - exp(-1 / (0.3 * srate));
  d3_tsm = 1 - exp(-1 / (0.002 * srate));
  zz_coef();
  lg_fst = 1 / (0.01 * srate);
  lg_dkc = 1 / (0.006 * srate);
  lg_gsm = 1 - exp(-1 / (0.012 * srate));
  lg_rsm = 1 - exp(-1 / (0.04 * srate));
  fy_eat = 1 - exp(-1 / (0.04 * srate)); fy_ert = 1 - exp(-1 / (1.0 * srate));
  d3_eat = 1 - exp(-1 / (0.03 * srate)); d3_ert = 1 - exp(-1 / (1.2 * srate));
  fz_ktl = lg_op(700, srate);
  fz_dcr = 1 - 2 * $pi * 20 / srate;
  fz_dpa = 1 - exp(-1 / (0.0005 * srate));
  fz_dqa = 1 - exp(-1 / (0.004 * srate)); fz_dqr = 1 - exp(-1 / (0.12 * srate));
  fz_dgs = 1 - exp(-1 / (0.001 * srate));
  fz_eat = 1 - exp(-1 / (0.03 * srate)); fz_ert = 1 - exp(-1 / (1.2 * srate));
  fz_gda = 1 - exp(-1 / (0.0003 * srate)); fz_gdr = 1 - exp(-1 / (0.03 * srate));
  fz_gga = 1 - exp(-1 / (0.001 * srate)); fz_ggr = 1 - exp(-1 / (0.06 * srate));
  lg_c_sw = 1 - exp(-1 / (0.005 * srate));
  ost_init(0);
);

function lg_all_clr() (
  chL.ch_clr(); chR.ch_clr();
  fy_env = d3_e2 = d3_e3 = fz_env = 0; fz_eb = fz_ew = fz_ep = fz_dg = 0; fz_gev = 0;
