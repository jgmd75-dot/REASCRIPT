desc:KRT81 [enhancer] (GFX Lab)
//tags: enhancer exciter phase alignment harmonic generator bass enhancer high-frequency restoration
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

slider16:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,18,0.1>-Input drive (dB)
slider2:0<0,10,0.01>-Lo contour / Bass drive
slider3:0<0,10,0.01>-Hi process / Harmonics
slider4:0<-12,12,0.1>-Output trim (dB)
slider5:0<0,100,1>-Align (%)
slider6:200<150,250,1>-Lo split (Hz)
slider7:3000<2000,4000,10>-Hi split (Hz)
slider8:100<0,100,1>-Mix / Harmonics mix (%)
slider10:0<0,1,1{Off,On}>-Bypass
slider11:1<0,1,1{VFD,Matrix}>-Mode
slider12:70<30,150,1>-Matrix bass freq (Hz)
slider13:3500<1000,10000,10>-Matrix tune (Hz)
slider14:100<0,100,1>-Matrix bass mix (%)
slider17:kr_lps=0<0,1,1{Off,On}>-Linear phase
slider15:prs_sel=0<0,16,1{No preset,Init,Mix Clarity,Vocal Presence,Kick & Bass Tight,Dull Tape Fix,Acoustic Air,Broadcast Bright,Lab Neutral,East Punch,Mastering Touch,Analogue Sheen,Vocal Air,Bass Weight,Drum Bus Glow,Tape Revival,West Punch}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
#ui_man = "gfx-lab-krt81";
function psw_all(v) ( slider_show(65535, v); slider_show(kr_lps, v); );
function psw_allg(v) ( slider_show(65535, v); slider_show(kr_lps, v); );
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
kr_C  = alloc(128);
ost_init(alloc(4096));

function kr_svf(v0, c) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = v0 - ic2;
  v1 = c[0] * ic1 + c[1] * v3;
  v2 = ic2 + c[1] * ic1 + c[2] * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  kr_bp = v1; kr_hp = v0 - c[3] * v1 - v2;
  v2;
);
function kr_svfz() instance(ic1, ic2) ( abs(ic1) < 0.0000000001 ? ic1 = 0; abs(ic2) < 0.0000000001 ? ic2 = 0; );

function kr_cset(c, f, k) local(g) (
  g = tan($pi * min(max(f, 5), 0.45 * srate) / srate);
  c[0] = 1 / (1 + g * (g + k)); c[1] = g * c[0]; c[2] = g * c[1]; c[3] = k;
);

function kr_ch(x, c) instance(sal, s1a, s1b, s1c, sap, s2a, s2b, s2c, ssub, dx, dy, eLo, gLo, eHf, msH, msA, gHd,
                               pl, pm, ph, al, ah) local(u, t, d, lo, hi1, lp, mid, hi, sum, bst, lv, ov, app, g, e, f, wd, tr) (

  kr_wdr > 0.00001 ? (
    u = x * kr_gin;
    t = (ost_tanh(kr_sd * (u + kr_sb)) - kr_stb) * kr_snorm;
    d = t / kr_gin - x;
    dy = d - dx + kr_dcd * dy; dx = d;
    x += kr_wdr * dy;
  );

  sal.kr_svf(x, c); x -= 2 * c[3] * kr_bp;
  kr_xa = x;

  lp = s1a.kr_svf(x, c + 4); t = kr_hp;
  lo = s1b.kr_svf(lp, c + 4);
  s1c.kr_svf(t, c + 4); hi1 = kr_hp;

  sap.kr_svf(lo, c + 8); lo -= 2 * c[11] * kr_bp;

  lp = s2a.kr_svf(hi1, c + 8); t = kr_hp;
  mid = s2b.kr_svf(lp, c + 8);
  s2c.kr_svf(t, c + 8); hi = kr_hp;
  sum = lo + mid + hi;
  pl = max(pl, abs(lo)); pm = max(pm, abs(mid)); ph = max(ph, abs(hi));

  kr_blo > 0.0001 ? (
    ssub.kr_svf(lo, c + 12); bst = kr_hp;
    lv = abs(lo) * kr_glo;
    eLo = lv > eLo ? eLo + (lv - eLo) * kr_aLo : eLo * kr_rLo;
    ov = 8.68588963807 * log(max(eLo, 0.000000001)) + 10;
    app = max(kr_blo - min(dy_curve(ov, 6) * 0.5, 0.6 * kr_blo), 0);
    g = 1 + (exp(app * 0.115129255) - 1) * 1.18;
  ) : ( bst = 0; app = 0; g = 1; eLo *= kr_rLo; );
  gLo += (g - gLo) * kr_sg;
  al = max(al, app);

  kr_bhi > 0.0001 ? (
    eHf += (hi * hi - eHf) * kr_cmf;
    msH += (hi * hi - msH) * kr_cms; msA += (x * x - msA) * kr_cms;

    wd = min(max((-8 - 4.34294482 * log((msH + 0.00000000000001) / (msA + 0.000000000001))) / 16, 0), 1);

    tr = min(max((4.34294482 * log((eHf + 0.00000000000001) / (msH + 0.00000000000001)) - 1.5) / 6, 0), 1);
    f = min(0.3 + 0.5 * wd + 0.4 * tr, 1);
    f *= min(max((4.34294482 * log(msA + 0.00000000000001) + 75) / 15, 0), 1);
    t = kr_bhi * f;
    gHd += (t - gHd) * (t > gHd ? kr_aV : kr_rV);
  ) : ( gHd *= kr_rV; eHf *= 1 - kr_cmf; msH *= 1 - kr_cms; msA *= 1 - kr_cms; );
  gHd < 0.00001 ? gHd = 0;
  e = (exp(gHd * 0.115129255) - 1) * hi;
  e = e / sqrt(1 + e * e * kr_ic2);
  ah = max(ah, gHd);

  sum + kr_mix * ((gLo - 1) * bst + e);
);

function kr_mx(x, c) instance(dx, dy, m1a, m1b, m1c, hA, hB, hP, hL, eB, eS, v0, vq, sM, sG, pl, pm, ph, aq)
                     local(u, t, d, lp, lo, rest, v, ov, gc, w, sc, a, vn, g2, g3, gen, ex) (
  kr_wdr > 0.00001 ? (
    u = x * kr_gin;
    t = (ost_tanh(kr_sd * (u + kr_sb)) - kr_stb) * kr_snorm;
    d = t / kr_gin - x;
    dy = d - dx + kr_dcd * dy; dx = d;
    x += kr_wdr * dy;
  );

  lp = m1a.kr_svf(x, c + 16); t = kr_hp;
  lo = m1b.kr_svf(lp, c + 16);
  m1c.kr_svf(t, c + 16); rest = kr_hp;

  kr_bdg > 1.0001 ? (
    v = lo * kr_bdg;
    a = abs(v); eB = a > eB ? eB + (a - eB) * kr_aB : eB * kr_rB;
    ov = 8.68588963807 * log(max(eB, 0.000000001)) + 24;
    gc = exp(-dy_curve(ov, 8) * 0.6666667 * 0.115129255);
    w = v * gc; w = w / sqrt(1 + w * w * 32);
    w *= kr_bmx * (1 - 1 / kr_bdg);
    aq = max(aq, (kr_bdg - 1) * gc);
  ) : ( w = 0; eB *= kr_rB; );

  hA.kr_svf(x, c + 20); sc = kr_hp;
  hB.kr_svf(sc, c + 24); sc = kr_hp;
  a = abs(sc); eS = a > eS ? a : eS * kr_rS;
  kr_hd > 0.0001 ? (
    vn = sc / max(eS, 0.0000001);
    vq += (vn * vn - vq) * kr_cvq;

    g2 = (vn * vn + vn * v0 + v0 * v0) * 0.33333333;
    g3 = (vn * vn * vn + vn * vn * v0 + vn * v0 * v0 + v0 * v0 * v0) * 0.25 - 0.75 * vq * (vn + v0);
    v0 = vn;

    a = min(sqrt(0.5 / max(vq, 0.03125)), 4);
    gen = eS * kr_hd * a * (g2 + 0.9 * kr_hd * a * g3);
    gen *= min(max((8.68588963807 * log(eS + 0.0000000001) + 72) / 12, 0), 1);
  ) : ( gen = 0; v0 = 0; vq = 0; );
  hP.kr_svf(gen, c + 28); gen = kr_hp;
  gen = hL.kr_svf(gen, c + 32);
  ex = kr_hmx * gen;
  sM += (sc * sc - sM) * kr_cms; sG += (ex * ex - sG) * kr_cms;
  pl = max(pl, abs(lo)); pm = max(pm, abs(rest - sc)); ph = max(ph, abs(sc));
  rest + lo + w + ex;
);
function kr_pre(x) instance(dx, dy) local(u, t, d) (
  kr_wdr > 0.00001 ? (
    u = x * kr_gin;
    t = (ost_tanh(kr_sd * (u + kr_sb)) - kr_stb) * kr_snorm;
    d = t / kr_gin - x;
    dy = d - dx + kr_dcd * dy; dx = d;
    x += kr_wdr * dy;
  );
  x;
);

function kr_chL(x, lo, mid, sb) instance(eLo, gLo, eHf, msH, msA, gHd, pl, pm, ph, al, ah)
                                local(hi, bst, lv, ov, app, g, e, f, wd, tr, t) (
  hi = x - lo - mid;
  pl = max(pl, abs(lo)); pm = max(pm, abs(mid)); ph = max(ph, abs(hi));
  kr_blo > 0.0001 ? (
    bst = sb;
    lv = abs(lo) * kr_glo;
    eLo = lv > eLo ? eLo + (lv - eLo) * kr_aLo : eLo * kr_rLo;
    ov = 8.68588963807 * log(max(eLo, 0.000000001)) + 10;
    app = max(kr_blo - min(dy_curve(ov, 6) * 0.5, 0.6 * kr_blo), 0);
    g = 1 + (exp(app * 0.115129255) - 1) * 1.18;
  ) : ( bst = 0; app = 0; g = 1; eLo *= kr_rLo; );
  gLo += (g - gLo) * kr_sg;
  al = max(al, app);
  kr_bhi > 0.0001 ? (
    eHf += (hi * hi - eHf) * kr_cmf;
    msH += (hi * hi - msH) * kr_cms; msA += (x * x - msA) * kr_cms;
    wd = min(max((-8 - 4.34294482 * log((msH + 0.00000000000001) / (msA + 0.000000000001))) / 16, 0), 1);
    tr = min(max((4.34294482 * log((eHf + 0.00000000000001) / (msH + 0.00000000000001)) - 1.5) / 6, 0), 1);
    f = min(0.3 + 0.5 * wd + 0.4 * tr, 1);
    f *= min(max((4.34294482 * log(msA + 0.00000000000001) + 75) / 15, 0), 1);
    t = kr_bhi * f;
    gHd += (t - gHd) * (t > gHd ? kr_aV : kr_rV);
  ) : ( gHd *= kr_rV; eHf *= 1 - kr_cmf; msH *= 1 - kr_cms; msA *= 1 - kr_cms; );
  gHd < 0.00001 ? gHd = 0;
  e = (exp(gHd * 0.115129255) - 1) * hi;
  e = e / sqrt(1 + e * e * kr_ic2);
  ah = max(ah, gHd);
  x + kr_mix * ((gLo - 1) * bst + e);
);

function kr_mxL(x, lo, c) instance(hA, hB, hP, hL, eB, eS, v0, vq, sM, sG, pl, pm, ph, aq)
                          local(rest, v, a, ov, gc, w, sc, vn, g2, g3, gen, ex) (
  rest = x - lo;
  kr_bdg > 1.0001 ? (
    v = lo * kr_bdg;
    a = abs(v); eB = a > eB ? eB + (a - eB) * kr_aB : eB * kr_rB;
    ov = 8.68588963807 * log(max(eB, 0.000000001)) + 24;
    gc = exp(-dy_curve(ov, 8) * 0.6666667 * 0.115129255);
    w = v * gc; w = w / sqrt(1 + w * w * 32);
    w *= kr_bmx * (1 - 1 / kr_bdg);
    aq = max(aq, (kr_bdg - 1) * gc);
  ) : ( w = 0; eB *= kr_rB; );
  hA.kr_svf(x, c + 20); sc = kr_hp;
  hB.kr_svf(sc, c + 24); sc = kr_hp;
  a = abs(sc); eS = a > eS ? a : eS * kr_rS;
  kr_hd > 0.0001 ? (
    vn = sc / max(eS, 0.0000001);
    vq += (vn * vn - vq) * kr_cvq;
    g2 = (vn * vn + vn * v0 + v0 * v0) * 0.33333333;
    g3 = (vn * vn * vn + vn * vn * v0 + vn * v0 * v0 + v0 * v0 * v0) * 0.25 - 0.75 * vq * (vn + v0);
    v0 = vn;
    a = min(sqrt(0.5 / max(vq, 0.03125)), 4);
    gen = eS * kr_hd * a * (g2 + 0.9 * kr_hd * a * g3);
    gen *= min(max((8.68588963807 * log(eS + 0.0000000001) + 72) / 12, 0), 1);
  ) : ( gen = 0; v0 = 0; vq = 0; );
  hP.kr_svf(gen, c + 28); gen = kr_hp;
  gen = hL.kr_svf(gen, c + 32);
  ex = kr_hmx * gen;
  sM += (sc * sc - sM) * kr_cms; sG += (ex * ex - sG) * kr_cms;
  pl = max(pl, abs(lo)); pm = max(pm, abs(rest - sc)); ph = max(ph, abs(sc));
  rest + w + lo + ex;
);

KL_M = 1048576; KL_Q = 65536;
KL_X = KL_M; KL_D = KL_M + 2 * KL_Q; KL_W = KL_M + KL_Q;
KL_S = KL_M + 3 * KL_Q; KL_O = KL_M + 7 * KL_Q;
KL_H = KL_M + 11 * KL_Q; KL_Y = KL_M + 12 * KL_Q; KL_T = KL_M + 16 * KL_Q;
KL_RL = KL_M + 17 * KL_Q; KL_RR = KL_M + 18 * KL_Q;

function kl_mag(b, f) local(r, q) (
  b == 0 ? ( r = sqr(sqr(f / kl_d1)); 1 / (1 + r); ) :
  b == 1 ? ( r = sqr(sqr(f / kl_d1)); q = sqr(sqr(f / kl_d2)); r / (1 + r) / (1 + q); ) :
  b == 2 ? ( r = sqr(sqr(f / kl_d1)); q = sqr(f / 35); q * q / sqr(1 + q) / (1 + r); ) :
  ( r = sqr(sqr(f / kl_d3)); 1 / (1 + r); );
);

function kl_design(b) local(k, n, i, df, m, sp) (
  df = srate / kl_F;
  memset(KL_D, 0, 2 * kl_F);
  k = 0; loop(kl_F / 2 + 1, m = kl_mag(b, k * df); KL_D[2 * k] = m; k > 0 ? KL_D[2 * (kl_F - k)] = m; k += 1; );
  fft_ipermute(KL_D, kl_F); ifft(KL_D, kl_F);
  sp = KL_S + b * KL_Q;
  memcpy(KL_O + b * KL_Q, sp, 2 * kl_F);
  memset(sp, 0, 2 * kl_F);
  n = 0; loop(kl_N, i = (n - kl_dD + kl_F) % kl_F; sp[2 * n] = KL_D[2 * i] * KL_W[n]; n += 1; );
  fft(sp, kl_F);
);

function kl_band(b, blend) local(y, i, j, r, a) (
  y = KL_Y + b * KL_Q;
  memcpy(y, KL_X, 2 * kl_F); convolve_c(y, KL_S + b * KL_Q, kl_F); ifft(y, kl_F);
  blend ? (
    memcpy(KL_T, KL_X, 2 * kl_F); convolve_c(KL_T, KL_O + b * KL_Q, kl_F); ifft(KL_T, kl_F);
    j = 2 * (kl_F - kl_B);
    i = 0; loop(2 * kl_B, r = ((i >> 1) + 1) / kl_B; a = KL_T[j + i]; y[j + i] = a + (y[j + i] - a) * r; i += 1; );
  );
);

function kl_hop() local(b, bl) (
  kl_ok < 4 ? (
    kl_ok == 0 ? ( kl_d1 = kr_f1; kl_d2 = kr_f2; kl_d3 = kr_bf; kl_q1 = kl_q3 = 0; );
    kl_design(kl_ok); kl_ok += 1; bl = -1;
  ) : (
    bl = -1;
    abs(kr_f1 - kl_d1) > 0.05 || abs(kr_f2 - kl_d2) > 0.5 ? ( kl_q1 = 3; kl_d1 = kr_f1; kl_d2 = kr_f2; );
    abs(kr_bf - kl_d3) > 0.05 ? ( kl_q3 = 1; kl_d3 = kr_bf; );
    kl_q1 > 0 ? ( kl_q1 -= 1; bl = 2 - kl_q1; kl_design(bl); ) : kl_q3 > 0 ? ( kl_q3 = 0; bl = 3; kl_design(3); );
  );
  memcpy(KL_X, KL_H, 2 * kl_F); fft(KL_X, kl_F);
  b = 0; loop(4, kl_band(b, b == bl); b += 1; );
);

function kl_clear() local(b) (
  memset(KL_H, 0, KL_Q); b = 0; loop(4, memset(KL_Y + b * KL_Q, 0, KL_Q); b += 1; );
  memset(KL_RL, 0, KL_Q); memset(KL_RR, 0, KL_Q);
  kl_p = 0; kl_fill = 0;
);

function kl_init() local(n, t) (
  kl_F = srate > 100000 ? 32768 : srate > 50000 ? 16384 : 8192;
  kl_B = kl_F / 8; kl_N = kl_F / 2 + 1; kl_dD = kl_F / 4;
  kl_L = kl_B + kl_dD;
  n = 0; loop(kl_N, t = 2 * $pi * n / (kl_N - 1);
    KL_W[n] = (0.35875 - 0.48829 * cos(t) + 0.14128 * cos(2 * t) - 0.01168 * cos(3 * t)) / (kl_F * kl_F); n += 1; );
  kl_ok = 0; kl_rw = 0; kl_q1 = kl_q3 = 0;
  kl_clear();
);

function kr_flush() instance(sal, s1a, s1b, s1c, sap, s2a, s2b, s2c, ssub, dx, dy, eLo, eHf, msH, msA,
                              m1a, m1b, m1c, hA, hB, hP, hL, eB, eS, sM, sG) (
  sal.kr_svfz(); s1a.kr_svfz(); s1b.kr_svfz(); s1c.kr_svfz(); sap.kr_svfz(); s2a.kr_svfz(); s2b.kr_svfz();
  s2c.kr_svfz(); ssub.kr_svfz();
  m1a.kr_svfz(); m1b.kr_svfz(); m1c.kr_svfz(); hA.kr_svfz(); hB.kr_svfz(); hP.kr_svfz(); hL.kr_svfz();
  eB < 0.0000000001 ? eB = 0; eS < 0.0000000001 ? eS = 0;
  sM < 0.00000000000001 ? sM = 0; sG < 0.00000000000001 ? sG = 0;
  abs(dx) < 0.0000000001 ? dx = 0; abs(dy) < 0.0000000001 ? dy = 0;
  eLo < 0.0000000001 ? eLo = 0; eHf < 0.00000000000001 ? eHf = 0;
  msH < 0.00000000000001 ? msH = 0; msA < 0.00000000000001 ? msA = 0;
);

function kr_zero() instance(sal, s1a, s1b, s1c, sap, s2a, s2b, s2c, ssub, dx, dy, eLo, gLo, eHf, msH, msA, gHd,
                            m1a, m1b, m1c, hA, hB, hP, hL, eB, eS, v0, vq, sM, sG) (
  sal.ic1 = sal.ic2 = s1a.ic1 = s1a.ic2 = s1b.ic1 = s1b.ic2 = s1c.ic1 = s1c.ic2 = sap.ic1 = sap.ic2 = 0;
  s2a.ic1 = s2a.ic2 = s2b.ic1 = s2b.ic2 = s2c.ic1 = s2c.ic2 = ssub.ic1 = ssub.ic2 = 0;
  m1a.ic1 = m1a.ic2 = m1b.ic1 = m1b.ic2 = m1c.ic1 = m1c.ic2 = hA.ic1 = hA.ic2 = hB.ic1 = hB.ic2 = 0;
  hP.ic1 = hP.ic2 = hL.ic1 = hL.ic2 = 0;
  dx = dy = eLo = eHf = msH = msA = gHd = eB = eS = v0 = vq = sM = sG = 0; gLo = 1;
);

function kr_mdb(v) ( 8.68588963807 * log(max(v, 0.00001)) );

function kr_bias(m) ( kr_sd = 0.22; kr_sb = m ? 0.55 : 0.30;
  kr_stb = ost_tanh(kr_sd * kr_sb); kr_snorm = 1 / (kr_sd * (1 - kr_stb * kr_stb)); );

function kr_srinit() (
  kr_sr = srate;
  kr_dcd = 1 - 2 * $pi * 5 / srate;
  kr_dco = 1 - 2 * $pi * 2 / srate;
  kr_aLo = 1 - exp(-1 / (0.010 * srate)); kr_rLo = exp(-1 / (0.160 * srate));
  kr_sg  = 1 - exp(-1 / (0.002 * srate));
  kr_cmf = 1 - exp(-1 / (0.003 * srate));
  kr_cms = 1 - exp(-1 / (0.120 * srate));
  kr_aV  = 1 - exp(-1 / (0.001 * srate)); kr_rV = exp(-1 / (0.060 * srate));
  kr_psm = 1 - exp(-1 / (0.02 * srate));
  kr_xf  = 1 / (0.02 * srate);
  kr_aB  = 1 - exp(-1 / (0.008 * srate)); kr_rB = exp(-1 / (0.200 * srate));
  kr_rS  = exp(-1 / (0.020 * srate));
  kr_cvq = 1 - exp(-1 / (0.005 * srate));
  kr_mst = 1 / (0.015 * srate); kr_mhd = floor(0.010 * srate);
  ost_init(0);
  kl_init();
);
kr_srinit();
kr_ic2 = 1 / sqr(0.32);
kr_AF  = 1.0117; kr_AK = 0.9855;

function kr_update() (
  kr_tdrv = slider1;
  kr_tlo  = min(max(slider2, 0), 10) * 1.2;
  kr_thi  = min(max(slider3, 0), 10) * 1.2;
  kr_tout = 10 ^ (slider4 / 20);
  kr_tal  = min(max(slider5, 0), 100) / 100;
  kr_tf1  = min(max(slider6, 150), 250);
  kr_tf2  = min(max(slider7, 2000), 4000);
  kr_tmix = min(max(slider8, 0), 100) / 100;
  kr_tmode = slider11 >= 0.5;
  kr_tbf  = min(max(slider12, 30), 150);
  kr_ttu  = min(max(slider13, 1000), 10000);
  kr_tbm  = min(max(slider14, 0), 100) / 100;
  drift_macro(0);
  kr_tbyp = slider10 >= 0.5;
  ost_setup(0, 0, 120, 6000, -0.3, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2;
  kr_tlin = kr_lps >= 0.5;
  kr_fresh ? kr_lin = kr_tlin;
  pdc_delay = kr_tlin ? kl_L : 0;
);

function kr_set(dr, lo, hi, o, a, f1, f2, m) (
  slider1 = dr; slider2 = lo; slider3 = hi; slider4 = o; slider5 = a; slider6 = f1; slider7 = f2; slider8 = m;
  slider11 = 0; slider_automate(255 + 1024);
);

function kr_setm(dr, bd, h, o, bf, bm, tu, m, d) (
  slider1 = dr; slider2 = bd; slider3 = h; slider4 = o; slider12 = bf; slider14 = bm; slider13 = tu; slider8 = m;
  slider11 = 1; slider_automate(511 + 1024 + 2048 + 4096 + 8192);
);

function kr_dflt() (
  slider1 = 0; slider2 = 0; slider3 = 0; slider4 = 0; slider5 = 0; slider6 = 200; slider7 = 3000; slider8 = 100;
  slider12 = 70; slider13 = 3500; slider14 = 100; slider_automate(511 + 2048 + 4096 + 8192);
);
function load_preset(p) (
  p == 1  ? kr_dflt() :
  p == 2  ? kr_set(0,   3,   4,  -0.9, 100, 200, 3000, 100) :
  p == 3  ? kr_set(2,   1,   6,  -0.8, 100, 180, 2800, 100) :
  p == 4  ? kr_set(3,   7,   2,  -2.3, 100, 160, 3200, 100) :
  p == 5  ? kr_set(2,   2,   8,  -1.3, 100, 200, 2500, 100) :
  p == 6  ? kr_set(0, 1.5,   5,  -0.8,  80, 220, 3600, 100) :
  p == 7  ? kr_set(6,   4,   7,  -1.6, 100, 200, 3000, 100) :
  p == 8  ? kr_set(0,   0,   0,     0, 100, 200, 3000, 100) :
  p == 9  ? kr_set(8,   6,   5,  -2.0, 100, 180, 3000, 100) :
  p == 10 ? kr_set(1,   2, 2.5,  -0.3,  60, 200, 3500,  60) :
  p == 11 ? kr_setm(0,   0,   5,     0,  70, 100, 4500,  70, 40) :
  p == 12 ? kr_setm(2,   0,   6,     0,  70, 100, 5500,  80, 50) :
  p == 13 ? kr_setm(2,   7,   0,  -1.5,  60,  80, 3500, 100, 50) :
  p == 14 ? kr_setm(4,   5,   6,  -1.0,  80,  70, 3000,  80, 60) :
  p == 15 ? kr_setm(3,   3,   8,  -1.0,  90,  60, 2200,  90, 50) :
  p == 16 ? kr_setm(6,   6,   7,  -1.6,  55,  90, 3000,  90, 80) :
  p == 17 ? (
    kr_dflt(); slider10 = 0; slider11 = 1;
    slider_automate(1536);
  );
);

dF1L.drift_init(0.8 + rand(1) * 0.4); dF1R.drift_init(0.8 + rand(1) * 0.4);
dF2L.drift_init(0.8 + rand(1) * 0.4); dF2R.drift_init(0.8 + rand(1) * 0.4);
dALL.drift_init(0.9 + rand(1) * 0.5); dALR.drift_init(0.9 + rand(1) * 0.5);
kr_mm1 = rand(2) - 1; kr_mm2 = rand(2) - 1; kr_mm3 = rand(2) - 1;
kr_fresh = 1;
kr_update();
kr_lin = kr_tlin; kl_on = 0;
kr_drv = kr_tdrv; kr_blo = kr_tlo; kr_bhi = kr_thi; kr_out = kr_tout; kr_mix = kr_tmix;
kr_al = kr_tal; kr_f1 = kr_tf1; kr_f2 = kr_tf2; kr_bx = kr_tbyp;
kr_bf = kr_tbf; kr_tu = kr_ttu; kr_bmx = kr_tbm;
kr_mode = kr_tmode; kr_mg = 1; kr_mh = 0; kr_bias(kr_mode);
cL.kr_zero(); cR.kr_zero();
kr_d1L = kr_d1R = kr_d2L = kr_d2R = kr_daL = kr_daR = 0;
kr_ox0 = kr_oy0 = kr_ox1 = kr_oy1 = 0;
kra_l0 = kra_l1 = kra_m0 = kra_m1 = kra_h0 = kra_h1 = -60;
kra_a0 = kra_a1 = kra_b0 = kra_b1 = 0;

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
#kv_pm = "Init|Mix Clarity|Vocal Presence|Kick & Bass Tight|Dull Tape Fix|Acoustic Air|Broadcast Bright|Lab Neutral|East Punch|Mastering Touch|Analogue Sheen|Vocal Air|Bass Weight|Drum Bus Glow|Tape Revival|West Punch";
kr_gfi = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(14, i != 15 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 16 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
kr_update();

@block
prs_chk();
kr_now = time_precise();
kr_tp > 0 && kr_now - kr_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > kr_gpp && play_position - kr_gpp < 4 * kr_gpd + 0.05) ? (
  cL.kr_zero(); cR.kr_zero(); kr_ox0 = kr_oy0 = kr_ox1 = kr_oy1 = 0; gdc_x0 = gdc_y0 = gdc_x1 = gdc_y1 = 0; kr_gfi = 0;
  kl_clear(); pL.dx = pL.dy = pR.dx = pR.dy = 0;
);
kr_tp = kr_now; kr_gpp = play_position; kr_gpd = samplesblock / srate; kr_gfs = 1 / (0.02 * srate);
srate != kr_sr ? kr_srinit();
kr_update();
kr_bdt = samplesblock / srate;

kr_k = 1 - exp(-kr_bdt / 0.05);
kr_f1 += (kr_tf1 - kr_f1) * kr_k; kr_f2 += (kr_tf2 - kr_f2) * kr_k; kr_al += (kr_tal - kr_al) * kr_k;
abs(kr_tal - kr_al) < 0.0001 ? kr_al = kr_tal;
kr_bf += (kr_tbf - kr_bf) * kr_k; kr_tu += (kr_ttu - kr_tu) * kr_k;

dm_a *= kr_mode;
kr_di = 0.12 * dm_s * kr_bdt;
kr_d1L = dF1L.drift_tick(kr_di); kr_d1R = dF1R.drift_tick(kr_di);
kr_d2L = dF2L.drift_tick(kr_di); kr_d2R = dF2R.drift_tick(kr_di);
kr_daL = dALL.drift_tick(kr_di); kr_daR = dALR.drift_tick(kr_di);
kr_e1L = 1 + dm_a * (0.025 * kr_d1L + 0.005 * kr_mm1); kr_e1R = 1 + dm_a * (0.025 * kr_d1R - 0.005 * kr_mm1);
kr_e2L = 1 + dm_a * (0.025 * kr_d2L + 0.005 * kr_mm2); kr_e2R = 1 + dm_a * (0.025 * kr_d2R - 0.005 * kr_mm2);
kr_eaL = 1 + dm_a * (0.05 * kr_daL + 0.005 * kr_mm3);  kr_eaR = 1 + dm_a * (0.05 * kr_daR - 0.005 * kr_mm3);

kr_amx = 0.45 * srate;
kr_fa  = kr_AF * kr_f2;
kr_cset(kr_C + 0,  min(kr_fa * kr_eaL / max(kr_al, 0.0001), kr_amx), kr_AK);
kr_cset(kr_C + 4,  kr_f1 * kr_e1L, 1.41421356);
kr_cset(kr_C + 8,  kr_f2 * kr_e2L, 1.41421356);
kr_cset(kr_C + 12, 35, 2);
kr_cset(kr_C + 64, min(kr_fa * kr_eaR / max(kr_al, 0.0001), kr_amx), kr_AK);
kr_cset(kr_C + 68, kr_f1 * kr_e1R, 1.41421356);
kr_cset(kr_C + 72, kr_f2 * kr_e2R, 1.41421356);
kr_cset(kr_C + 76, 35, 2);
kr_lpf = min(18000, 0.42 * srate);
kr_cset(kr_C + 16, kr_bf * kr_e1L, 1.41421356);
kr_cset(kr_C + 20, kr_tu * kr_e2L, 1.84775907); kr_cset(kr_C + 24, kr_tu * kr_e2L, 0.76536686);
kr_cset(kr_C + 28, kr_tu * kr_e2L, 1.41421356); kr_cset(kr_C + 32, kr_lpf, 1.41421356);
kr_cset(kr_C + 80, kr_bf * kr_e1R, 1.41421356);
kr_cset(kr_C + 84, kr_tu * kr_e2R, 1.84775907); kr_cset(kr_C + 88, kr_tu * kr_e2R, 0.76536686);
kr_cset(kr_C + 92, kr_tu * kr_e2R, 1.41421356); kr_cset(kr_C + 96, kr_lpf, 1.41421356);

cL.kr_flush(); cR.kr_flush();
abs(kr_oy0) < 0.0000000001 ? kr_ox0 = kr_oy0 = 0; abs(kr_oy1) < 0.0000000001 ? kr_ox1 = kr_oy1 = 0;

kr_mode ? (
  cL.al = 8.68588963807 * log(1 + kr_bmx * cL.aq); cR.al = 8.68588963807 * log(1 + kr_bmx * cR.aq);
  cL.ah = cL.sM > 0.0000000001 ? 4.34294482 * log(1 + cL.sG / cL.sM) : 0;
  cR.ah = cR.sM > 0.0000000001 ? 4.34294482 * log(1 + cR.sG / cR.sM) : 0;
  cL.aq = cR.aq = 0;
);

kra_l0 = max(kr_mdb(cL.pl), kra_l0 - 20 * kr_bdt); kra_l1 = max(kr_mdb(cR.pl), kra_l1 - 20 * kr_bdt);
kra_m0 = max(kr_mdb(cL.pm), kra_m0 - 20 * kr_bdt); kra_m1 = max(kr_mdb(cR.pm), kra_m1 - 20 * kr_bdt);
kra_h0 = max(kr_mdb(cL.ph), kra_h0 - 20 * kr_bdt); kra_h1 = max(kr_mdb(cR.ph), kra_h1 - 20 * kr_bdt);
kra_a0 = max(cL.al, kra_a0 - 15 * kr_bdt); kra_a1 = max(cR.al, kra_a1 - 15 * kr_bdt);
kra_b0 = max(cL.ah, kra_b0 - 15 * kr_bdt); kra_b1 = max(cR.ah, kra_b1 - 15 * kr_bdt);
cL.pl = cL.pm = cL.ph = cL.al = cL.ah = 0; cR.pl = cR.pm = cR.ph = cR.al = cR.ah = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
kr_fresh = 0;

!kr_lin ? (
  gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
  gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
);
kr_il = spl0; kr_ir = spl1;
kr_el = kr_il; kr_er = kr_ir;

kr_drv += (kr_tdrv - kr_drv) * kr_psm;
kr_blo += (kr_tlo - kr_blo) * kr_psm; kr_bhi += (kr_thi - kr_bhi) * kr_psm;
kr_out += (kr_tout - kr_out) * kr_psm; kr_mix += (kr_tmix - kr_mix) * kr_psm; kr_bmx += (kr_tbm - kr_bmx) * kr_psm;
kr_drv < 0.0001 ? kr_drv = 0; kr_blo < 0.0001 ? kr_blo = 0; kr_bhi < 0.0001 ? kr_bhi = 0;
kr_wdr = min(kr_drv / 2, 1);
kr_gin = exp(kr_drv * 0.115129255);
kr_glo = exp(kr_blo * 0.115129255);

kr_dl = kr_il; kr_dr = kr_ir;
kr_tlin || kr_lin ? (
  !kl_on ? ( kl_clear(); pL.dx = pL.dy = pR.dx = pR.dy = 0; kl_on = 1; );
  kl_j = 2 * (kl_F - kl_B + kl_p);
  kl_0l = KL_Y[kl_j]; kl_0r = KL_Y[kl_j + 1];
  kl_1l = KL_Y[KL_Q + kl_j]; kl_1r = KL_Y[KL_Q + kl_j + 1];
  kl_2l = KL_Y[2 * KL_Q + kl_j]; kl_2r = KL_Y[2 * KL_Q + kl_j + 1];
  kl_3l = KL_Y[3 * KL_Q + kl_j]; kl_3r = KL_Y[3 * KL_Q + kl_j + 1];
  kl_ti = 2 * (kl_F - 2 * kl_B - kl_dD + kl_p);
  kl_xl = KL_H[kl_ti]; kl_xr = KL_H[kl_ti + 1];
  KL_H[kl_j] = pL.kr_pre(kr_el); KL_H[kl_j + 1] = pR.kr_pre(kr_er);
  KL_RL[kl_rw] = kr_il; KL_RR[kl_rw] = kr_ir;
  kl_ti = (kl_rw - kl_L) & 65535; kr_lin ? ( kr_dl = KL_RL[kl_ti]; kr_dr = KL_RR[kl_ti]; );
  kl_rw = (kl_rw + 1) & 65535;
  kl_p += 1; kl_fill += 1;
  kl_p >= kl_B ? ( kl_hop(); memcpy(KL_H, KL_H + 2 * kl_B, 2 * (kl_F - kl_B)); kl_p = 0; );
) : kl_on = 0;

kr_lw = kr_lin != kr_tlin && (!kr_tlin || kl_fill > kl_L + kl_B);
kr_mode != kr_tmode || kr_lw ? (
  kr_mg -= kr_mst;
  kr_mg <= 0 ? ( kr_mg = 0; kr_mode = kr_tmode; kr_lw ? kr_lin = kr_tlin; kr_bias(kr_mode); cL.kr_zero(); cR.kr_zero(); kr_mh = kr_mhd; );
) : kr_mh > 0 ? kr_mh -= 1 : kr_mg < 1 ? kr_mg = min(kr_mg + kr_mst, 1);

kr_mode ? (
  kr_bdg = kr_glo; kr_hd = kr_bhi / 12; kr_hmx = kr_mix * 1.4;
  kr_lin ? (
    kr_yl = cL.kr_mxL(kl_xl, kl_3l, kr_C);
    kr_yr = cR.kr_mxL(kl_xr, kl_3r, kr_C + 64);
  ) : (
    kr_yl = cL.kr_mx(kr_el, kr_C);
    kr_yr = cR.kr_mx(kr_er, kr_C + 64);
  );
) : kr_lin ? (
  kr_yl = cL.kr_chL(kl_xl, kl_0l, kl_1l, kl_2l);
  kr_yr = cR.kr_chL(kl_xr, kl_0r, kl_1r, kl_2r);
) : (
  kr_yl = cL.kr_ch(kr_el, kr_C);
  kr_yr = cR.kr_ch(kr_er, kr_C + 64);
);

kr_t = kr_out * kr_mg * kr_mg * (3 - 2 * kr_mg); kr_yl *= kr_t; kr_yr *= kr_t;
!kr_lin ? (
  kr_t = kr_yl - kr_ox0 + kr_dco * kr_oy0; kr_ox0 = kr_yl; kr_oy0 = kr_t; kr_yl = kr_t;
  kr_t = kr_yr - kr_ox1 + kr_dco * kr_oy1; kr_ox1 = kr_yr; kr_oy1 = kr_t; kr_yr = kr_t;
);

ost_out(kr_yl, kr_yr);

kr_bx = kr_tbyp ? min(kr_bx + kr_xf, 1) : max(kr_bx - kr_xf, 0);
kr_bx > 0 ? (
  kr_t = kr_bx * kr_bx * (3 - 2 * kr_bx);
  spl0 = ost_l + (kr_dl - ost_l) * kr_t;
  spl1 = ost_r + (kr_dr - ost_r) * kr_t;
) : ( spl0 = ost_l; spl1 = ost_r; );
kr_gfi < 1 ? ( kr_gfi = min(kr_gfi + kr_gfs, 1); kr_gq = kr_gfi * kr_gfi * (3 - 2 * kr_gfi); spl0 = kr_dl + (spl0 - kr_dl) * kr_gq; spl1 = kr_dr + (spl1 - kr_dr) * kr_gq; );
kr_opl_d = max(kr_opl_d, abs(spl0)); kr_opr_d = max(kr_opr_d, abs(spl1));

@gfx 900 355
ui_begin(900, 355);
v5_begin();
sc != kv_fsc ? (
  kv_fsc = sc;
  kv_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  kv_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  kv_f6 = ui_fitfont(6, 24 * sc);
);
function kv_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * kv_kt * sc, 'b'); );
function kv_fa(px) ( gfx_setfont(10, "Arial", px * kv_ka * sc, 'b'); );
function kv_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kv_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function kv_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function kv_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function kv_well(x, y, w, h, b, c, face) (
  ui_col(ui_mix(c, 0, 0.42)); v5_q(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0, 0.28)); v5_q(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0xFFFFFF, 0.10)); v5_q(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.22)); v5_q(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(face); v5_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(face, 0, 0.35)); v5_r(x + b, y + b, w - 2 * b, 2); v5_r(x + b, y + b, 2, h - 2 * b);
);
function kv_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.16); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.50)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(face); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function kv_step(x, y, w, h, d, f, face) local(a, b) (
  a = max(1, floor(d * 0.45 + 0.5)); b = max(1, d - a);
  kv_cham(x, y, w, h, a, f, ui_mix(f, 0, 0.14));
  kv_cham(x + a + 5, y + a + 5, w - 2 * a - 10, h - 2 * a - 10, b, ui_mix(f, 0, 0.10), face);
);
function kv_plate(n, x, y, w, h, ttl, rc) local(tw) (
  kv_step(x, y, w, h, 6, KVF, KVW);
  strlen(ttl) ? (
  kv_ft(12); tw = kv_tw(ttl) + 40;
  ui_col(ui_mix(KVF, 0xFFFFFF, 0.22)); v5_rr(x + 12, y + 12, tw, 22, 2); ui_cola(0, 0.12); v5_r(x + 12, y + 33, tw, 1);
  ui_col(rc); v5_r(x + 12, y + 34, tw, 3);
  ui_col(0x1E1C1A); v5_rr(x + 17, y + 17, 20, 12, 1.5); ui_col(0xFFFFFF); v5_rr(x + 18, y + 18, 18, 10, 1);
  kv_ft(9); ui_col(0x1E1C1A); sprintf(#kv_ns, "%02d", n); v5_t(x + 27, y + 23.5, #kv_ns);
  kv_ft(12); ui_col(0x1E1C1A); kv_tl(x + 43, y + 23.5, ttl);
  );
);
function kv_ends(cx, cy, rd, sz) local(t) (
  ui_col(0x8E918E); t = -0.75 * $pi; v5_d(cx + sin(t) * rd, cy - cos(t) * rd, sz); v5_d(cx - sin(t) * rd, cy - cos(t) * rd, sz);
);
function kv_ring(cx, cy, r, v) local(a, i, t, on, lx, ly, lr) (
  a = -0.75 * $pi + v * 1.5 * $pi; lr = 2.2;
  i = 0; loop(11, t = -0.75 * $pi + i / 10 * 1.5 * $pi; lx = cx + sin(t) * (r + 8 + lr); ly = cy - cos(t) * (r + 8 + lr); on = i / 10 <= v + 0.001;
    on ? ( ui_cola(v5_led, 0.22); v5_d(lx, ly, lr + 3); );
    ui_col(0x050606); v5_d(lx, ly, lr + 0.9); ui_col(on ? v5_led : ui_mix(v5_led, 0x0A0B0B, 0.82)); v5_d(lx, ly, lr);
    on ? ( ui_cola(0xFFFFFF, 0.5); v5_d(lx - 0.7, ly - 0.7, 0.8); );
    i += 1; );
  v5_shc(cx, cy, r);
  ui_col(ui_mix(v5_ccap, 0, 0.55)); v5_d(cx, cy, r);
