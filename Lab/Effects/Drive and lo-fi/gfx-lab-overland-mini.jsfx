desc:Overland [drive] (GFX Lab)
//tags: saturation drive tape buss stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-clip, gfx-lab-os, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider21:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:eng=0<0,2,1{Drive,Tape,Buss}>-Engine
slider2:d_drv=4<0,10,0.1>-Drive: drive
slider3:d_mode=1<0,2,1{Full,Bands,Low}>-Drive: saturation mode
slider4:d_cut=3<0,10,0.1>-Drive: low cut
slider5:d_tone=0<-5,5,0.1>-Drive: tone
slider6:t_drv=4<0,10,0.1>-Tape: drive
slider7:t_spd=1<0,2,1{7.5 ips,15 ips,30 ips}>-Tape: speed
slider8:t_wob=2<0,10,0.1>-Tape: wobble
slider9:t_tone=0<-5,5,0.1>-Tape: tone
slider10:b_voice=4<0,7,1{Warm & Dense,Warm,Rounded,Balanced,Clear,Open,Bright,Bright & Wide}>-Buss: voicing
slider11:b_amt=4<0,10,0.1>-Buss: amount
slider12:b_wid=100<0,200,1>-Buss: width (%)
slider13:b_mono=0<0,1,1{Off,On}>-Buss: mono bass
slider14:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider15:byp=0<0,1,1{Off,On}>-Bypass
slider16:mix=100<0,100,1>-Mix (%)
slider17:in_db=0<-12,12,0.1>-Input (dB)
slider18:out_db=0<-12,12,0.1>-Output (dB)
slider19:drift=50<0,100,1>-Drift (%)
slider20:prs_sel=0<0,18,1{No preset,Init,Gravel Road,Hill Climb Bass,Mountain Pass,Kick in the Mud,Off the Map,Coastal Fog,Night Drive,Dusty Tape,Toy Rally,Long Haul,Sunday Reel,Highway Polish,Mix Bus Cruise,Velvet Buss,Wide Open Road,Late Light,Dense Traffic}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(2097151, v); );
function psw_allg(v) ( slider_show(2097151, v); );
#ui_man = "gfx-lab-overland-mini";
ext_noinit = 1;
gfx_ext_retina = 1;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
CO = 500;
SL = 700;  SR = 800;
DSZ = 8192;  DLB = 1000;  DRB = DLB + DSZ;
DRY = 50000;  DRYN = 4096;

function db2g(d) ( exp(d * 0.11512925464970228); );
function tg(f) ( tan($pi * min(f, fsr * 0.45) / fsr); );

function cs_core(i, g, k) local(c) ( c = CO + i * 6;  c[0] = 1 / (1 + g * (g + k));  c[1] = g * c[0];  c[2] = g * c[1]; );
function cs_lp(i, f, q) local(c) ( cs_core(i, tg(f), 1 / q);  c = CO + i * 6;  c[3] = 0;  c[4] = 0;  c[5] = 1; );
function cs_hp(i, f, q) local(c) ( cs_core(i, tg(f), 1 / q);  c = CO + i * 6;  c[3] = 1;  c[4] = -1 / q;  c[5] = -1; );
function cs_ls(i, f, db) local(c, A) ( A = exp(db * 0.05756462732485115);  cs_core(i, tg(f) / sqrt(A), 1.41421356);
  c = CO + i * 6;  c[3] = 1;  c[4] = 1.41421356 * (A - 1);  c[5] = A * A - 1; );
function cs_hs(i, f, db) local(c, A) ( A = exp(db * 0.05756462732485115);  cs_core(i, tg(f) * sqrt(A), 1.41421356);
  c = CO + i * 6;  c[3] = A * A;  c[4] = 1.41421356 * (1 - A) * A;  c[5] = 1 - A * A; );
function svc(x, i, s) local(c, v1, v2, v3) (
  c = CO + i * 6;  v3 = x - s[1];
  v1 = c[0] * s[0] + c[1] * v3;  v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
  c[3] * x + c[4] * v1 + c[5] * v2;
);

function sat_f(x) ( x / (1 + abs(x)); );
function sat_ad(x) ( abs(x) - log(1 + abs(x)); );
function adaa(x) instance(xp, Fp, yp) local(F, yc, d, y, n) (
  n = 1 + abs(x);  F = abs(x) - log(n);  yc = x / n;  d = x - xp;
  abs(d) < 0.00001 ? ( y = sat_f(0.5 * (x + xp)); ) : ( y = (F - Fp) / d; );
  y += 0.5 * (yc - yp);
  xp = x;  Fp = F;  yp = yc;  y;
);
STG_REF = 0.25;
function stn(g, b) ( (1 - stg_t) * sqr(1 + b) / g + stg_t * STG_REF / (sat_f(g * STG_REF + b) - sat_f(b)); );
function stage(x, g, b, k, fb) instance(a) (
  ((aa_on ? a.adaa(x * g + b) : sat_f(x * g + b)) - fb) * k;
);

function bq_set(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs;  cw = cos(w0);  sw = sin(w0);  al = sw / (2 * q);  amp = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al;  b0 = (1 - cw) * 0.5 / n;  b1 = (1 - cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al;  b0 = (1 + cw) * 0.5 / n;  b1 = -(1 + cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / amp;  b0 = (1 + al * amp) / n;  b1 = -2 * cw / n;  b2 = (1 - al * amp) / n;  a1 = b1;  a2 = (1 - al / amp) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n;  b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n;  a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;  a2 = ((amp + 1) - (amp - 1) * cw - sa) / n; ) :
  ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n;  b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n;  a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;  a2 = ((amp + 1) + (amp - 1) * cw - sa) / n; );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;  x2 = x1;  x1 = x;  y2 = y1;  y1 = y;  y;
);
function bq_mlp(f, q, fs) instance(b0, b1, b2, a1, a2) local(w0, z, p0, p1, p2, aa, ab, ac, r1, bb) (
  w0 = 2 * $pi * min(f, fs * 0.49) / fs;  z = 0.5 / q;
  a1 = -2 * exp(-z * w0) * cos(sqrt(1 - z * z) * w0);  a2 = exp(-2 * z * w0);
  aa = sqr(1 + a1 + a2);  ab = sqr(1 - a1 + a2);  ac = -4 * a2;
  p1 = sqr(sin(w0 * 0.5));  p0 = 1 - p1;  p2 = 4 * p0 * p1;
  r1 = (aa * p0 + ab * p1 + ac * p2) * q * q;
  bb = max((r1 - aa * p0) / p1, 0);
  b0 = 0.5 * (sqrt(aa) + sqrt(bb));  b1 = sqrt(aa) - b0;  b2 = 0;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function hd_eq(voice, hpf, hsdb) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, hhp, hhs) (
  emp.bq_set(3, 3000, 0.7, 4, fsr);  dem.bq_set(3, 3000, 0.7, -4, fsr);
  voice == 1 ? ( vpre.bq_set(2, 1400, 0.6, 3.5, fsr);  vpost.bq_set(2, 1400, 0.6, -1.5, fsr); ) :
  voice == 2 ? ( vpre.bq_set(3, 6000, 0.7, 5, fsr);    vpost.bq_set(3, 6000, 0.7, -2, fsr); ) :
               ( vpre.bq_set(2, 1000, 0.7, 0, fsr);    vpost.bq_set(2, 1000, 0.7, 0, fsr); );
  bump.bq_set(2, 70, 0.9, hd_bump, fsr);
  gap.bq_mlp(voice == 2 ? 21000 : voice == 1 ? 18000 : 16000, 0.55, fsr);
  dcb.bq_set(1, 10, 0.7, 0, fsr);
  lop.bq_set(0, 250, 0.6, 0, fsr);
  hhp.bq_set(1, hpf, 0.7071, 0, fsr);
  hhs.bq_set(3, 5000, 0.7, hsdb, fsr);
);
function hd_sat(x, b) (
  (ost_tanh(hd_g * x + b) - hd_tb) * hd_c;
);
function hd_clr() instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, hhp, hhs) (
  emp.bq_clr();  dem.bq_clr();  vpre.bq_clr();  vpost.bq_clr();  bump.bq_clr();
  gap.bq_clr();  dcb.bq_clr();  lop.bq_clr();  hhp.bq_clr();  hhs.bq_clr();
);
function hd_run(x, b) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, hhp, hhs) local(y, lo) (
  lo = lop.bq_run(x) * hd_lb;
  y = hhp.bq_run(vpre.bq_run(emp.bq_run(x - lo))) * 0.5;
  y = hd_sat(y, b) * 2;
  hhs.bq_run(dcb.bq_run(gap.bq_run(bump.bq_run(vpost.bq_run(dem.bq_run(y)) + lo * hd_lg))));
);
function dk_pre(t, f, q, g) ( this.aL.bq_set(t, f, q, g, srate);  this.aR.bq_set(t, f, q, g, srate); );
function dk_post(t, f, q, g) ( this.bL.bq_set(t, f, q, g, srate);  this.bR.bq_set(t, f, q, g, srate); );
function dk_model(m) instance(atm, rlm, thr, rat, kh, kw0, kw1, mas, air, trim) (
  mas = m == 3;  air = m == 4;
  m == 1 ? ( atm = 3;    rlm = 180; thr = -5; rat = 0.75;  kh = 3; kw0 = 0.3; kw1 = 0.6;
             this.dk_pre(2, 700, 0.7, 2);    this.dk_post(2, 700, 0.7, -2);    trim = 10 ^ (-2.26 / 20); ) :
  m == 3 ? ( atm = 0.05; rlm = 300; thr = -2; rat = 0.95;  kh = 6; kw0 = 0.4; kw1 = 0.8;
             this.dk_pre(4, 60, 0.707, 0);   this.dk_post(3, 12000, 0.707, -0.7); trim = 10 ^ (-2.24 / 20); ) :
           ( atm = 1.5;  rlm = 150; thr = -5; rat = 0.667; kh = 4; kw0 = 0.3; kw1 = 0.6;
             this.dk_pre(3, 6000, 0.707, 3); this.dk_post(3, 6000, 0.707, -1.5);  trim = 10 ^ (-2.63 / 20); );
  this.kL.clp_set(2, 1, 0.93, 0);  this.kR.clp_set(2, 1, 0.93, 0);
);
function dk_block(ddb) instance(atm, rlm, att, rel, gd, go, trim, kw0, kw1, dv) (
  dv = min(max(ddb / 24, 0), 1);
  att = 1 - exp(-1 / (max(atm, 0.02) * 0.001 * srate));  rel = 1 - exp(-1 / (rlm * 0.001 * srate));
  gd = 10 ^ (ddb / 20);  go = trim * 10 ^ (-0.5 * ddb / 20) * dk_mk;
  this.kL.clp_knee(kw0 + (kw1 - kw0) * dv);  this.kR.clp_knee(kw0 + (kw1 - kw0) * dv);
);
function dk_gr(e) instance(thr, rat, kh) local(o) (
  o = 8.685889638065037 * log(max(e, 0.000000001)) - thr;
  o <= -kh ? 0 : o >= kh ? rat * o : rat * sqr(o + kh) / (4 * kh);
);
function dk_run(l, r) instance(att, rel, env, hsL, hsR, gd, go, mas, air, apL, apR, slp, wk, dv, ol, orr) local(pl, pr, al, ar, g, y, s, h) (
  pl = this.aL.bq_run(l * gd);  pr = this.aR.bq_run(r * gd);
  mas ? ( hsL += dk_hk * (pl - hsL);  hsR += dk_hk * (pr - hsR);  al = abs(pl - hsL);  ar = abs(pr - hsR); )
      : ( al = abs(pl);  ar = abs(pr); );
  al = max(al, ar);
  env += (al > env ? att : rel) * (al - env);
  g = exp(-0.11512925464970228 * this.dk_gr(env));
  ol = this.bL.bq_run(this.kL.clp_run(pl * g)) * go;
  orr = this.bR.bq_run(this.kR.clp_run(pr * g)) * go;
  air ? (
    wk = 0.25 * dv + 0.6 * (1 - g);
    y = dk_apl * ol + apL;  apL = ol - dk_apl * y;  ol = y;
    y = dk_apr * orr + apR;  apR = orr - dk_apr * y;  orr = y;
    s = 0.5 * (ol - orr);  slp += dk_slk * (s - slp);  h = (s - slp) * wk;
    ol += h;  orr -= h;
  );
);

C_LC = 0;  C_HS = 1;  C_X1 = 2;  C_X2 = 3;  C_X3 = 4;  C_L3 = 5;  C_SUB = 6;  C_DF = 7;  C_BT = 8;  C_TT = 10;

function ch_tick(x, sb) instance(s2, s41, s42, s43, s44, s3l, s3h, env3, subff, subpv, wlp, hfh)
  local(yc, hfl, y, y2, y4, y3, b1, r1, b2, r2, b3, b4, lo, hi, gc, sb1, sub, dl)
(
  y = svc(x, C_LC, sb);
  hfl = svc(y, C_TT, sb + 44);  hfh = y - hfl;
  yc = hfl + hfh * hf_g;
  y2 = y4 = y3 = 0;
  w2 > 0.0005 ? ( y2 = s2.stage(yc, dg, st2_b, st2_k, st2_f); );
  w4 > 0.0005 ? (
    b1 = svc(svc(yc, C_X1, sb + 2), C_X1, sb + 4);  r1 = yc - b1;
    b2 = svc(svc(r1, C_X2, sb + 6), C_X2, sb + 8);  r2 = r1 - b2;
    b3 = svc(svc(r2, C_X3, sb + 10), C_X3, sb + 12);  b4 = r2 - b3;
    dl = dg * (1 + 0.6 * lsat_s);
    y4 = s41.stage(b1, dl, st41_b, st41_k, st41_f) + s42.stage(b2, dg, 0.04, st42_k, st42_f) + s43.stage(b3, dg, 0.03, st43_k, st43_f) + s44.stage(b4, st44_g, 0.02, st44_k, st44_f);
  );
  w3 > 0.0005 ? (
    lo = svc(svc(yc, C_L3, sb + 14), C_L3, sb + 16);  hi = yc - lo;
    env3 += (abs(lo) - env3) * (abs(lo) > env3 ? e3_a : e3_r);
    gc = 1 / (1 + env3 * dg * 0.9);
    lo = s3l.stage(lo * gc * (1 + drive_s * 0.1), st3l_g, st3l_b, st3l_k, st3l_f);
    hi = s3h.stage(hi, st3h_g, 0.02, st3h_k, st3h_f);
    sb1 = svc(lo, C_SUB, sb + 18);
    (sb1 > 0 && subpv <= 0) ? subff = -subff;  subff == 0 ? subff = 1;  subpv = sb1;
    sub = svc(subff * min(1, env3 * 2.5), C_SUB, sb + 20);
    y3 = lo + hi + sub * sub_amt;
  );
  y = y2 * w2 + y4 * w4 + y3 * w3;
  y = svc(y, C_HS, sb + 24);
  wlp_on ? ( y = wlp.bq_run(y); );
  y;
);
function bs_tick(x, sb) instance(s2) local(y) (
  y = s2.stage(x, dg, st2_b, st2_k, st2_f);
  svc(y, C_BT, sb + 26);
);

function update_targets() local(b) (
  b = max(0, min(7, floor(b_voice + 0.5))) / 7;
  blsat_t = 1 - b;  btone_t = (b - 0.5) * 6;
  eng_t = max(0, min(2, floor(eng + 0.5)));  spd_t = max(0, min(2, floor(t_spd + 0.5)));
  sw_t = eng_t == 1 ? 3 + spd_t : eng_t;
  drive_t = d_drv;  cut_t = d_cut;  dtone_t = d_tone;
  xf = floor(d_mode + 0.5);  w2t = xf <= 0;  w4t = xf == 1;  w3t = xf >= 2;
  tdrv_t = t_drv;  twob_t = t_wob;  ttone_t = t_tone;
  bamt_t = b_amt;  bwid_t = b_wid / 100;  bmono_t = b_mono >= 0.5;
  out_t = db2g(out_db);  os_tf = os_f2n(os_sel);
  in_t = db2g(in_db);  inc_t = db2g(in_db > 0 ? -0.35 * in_db : -0.85 * in_db);  mix_t = mix / 100;
);
fz_C = 40000;
function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_tiny(v) ( abs(v) < 0.000000000001 ? 0 : v; );
function fz_run(x) instance(qA, qB, qC, qD, fhi, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = qA.fz_bm(x, fz_C);
  ha = abs(h); fhi += (ha - fhi) * (ha > fhi ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fhi, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fhi;
  e = qD.fz_bm(qC.fz_bm(qB.fz_bm(e, fz_C + 5), fz_C + 10), fz_C + 15);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_dn() instance(fhi, fp, fe) ( fhi = fz_tiny(fhi); fp = fz_tiny(fp); fe = fz_tiny(fe); );
function fz_clr() instance(qA, qB, qC, qD, fhi, fp, fe) ( qA.fz_bmz(); qB.fz_bmz(); qC.fz_bmz(); qD.fz_bmz(); fhi = fp = fe = 0; );
function fz_coef() (
  fz_bqc(fz_C, 4, 3500, 0, 0.7071, fsr); fz_bqc(fz_C + 5, 4, 5500, 0, 0.7071, fsr);
  fz_bqc(fz_C + 10, 0, 8000, 4, 0.7, fsr); fz_bqc(fz_C + 15, 2, 12000, -6, 0.7, fsr);
  fz_a = 1 - exp(-1 / (0.003 * fsr)); fz_r = 1 - exp(-1 / (0.12 * fsr)); fz_w = 1 - exp(-1 / (0.06 * fsr));
);
fz_o = fz_t = 0;
first_run = 1;
DLY = ceil(0.0015 * srate);
sm   = 1 - exp(-1 / (0.02 * srate));
dc_k = 1 - exp(-2 * $pi * 2 / srate);
aa_on = 1;  clp_aa = 1;
CR = 16;  cr_n = 0;
hf_ti = 1 / 0.45;  HF_RT = 0.75;  hf_g = 1;
MB = 900;
eg_k = 1 / (0.006 * srate);  eg_g = 1;  emk_t = emk_s = 1;  emk_f = 1;
function ov_rate() (
  fsr = srate;  cs_lp(C_DF, 120, 0.70710678);
  fsr = srate * os_f;
  e3_a = 1 - exp(-1 / (0.010 * fsr));  e3_r = 1 - exp(-1 / (0.30 * fsr));
  cs_lp(C_X1, 150, 0.70710678);  cs_lp(C_X2, 1200, 0.70710678);  cs_lp(C_X3, 5000, 0.70710678);
  cs_lp(C_L3, 200, 0.70710678);  cs_lp(C_SUB, 90, 0.7071);
  cs_lp(C_TT, 2200, 0.70710678);  hf_a = 1 - exp(-1 / (0.0005 * fsr));  hf_r = 1 - exp(-1 / (0.06 * fsr));
  fz_coef();  coef_dirty = 1;  coef_hd = 1;  wlp_last = -1;  bt_c = -100;
);
os_hq = 1;  os_design();  os_hdesign();
os_f = os_tf = os_f2n(os_sel);  os_base = DLY;
os_gsetup();
ov_rate();
dkR.dk_model(1);  dkM.dk_model(3);  dkA.dk_model(4);
dk_hk = 1 - exp(-2 * $pi * 90 / srate);
dk_apl = (tan($pi * 4500 / srate) - 1) / (tan($pi * 4500 / srate) + 1);
dk_apr = (tan($pi * 6500 / srate) - 1) / (tan($pi * 6500 / srate) + 1);
dk_slk = 1 - exp(-2 * $pi * 2500 / srate);
dw_pos = 0;  wob_t = 0;  wob_v = 0;  wob_tgt = 0;  ph1 = 0;
coef_hd = 1;  hd_lastd = -1;  wlp_last = -1;

function eng_snap() (
  drive_s = drive_t;  cut_s = cut_t;  dtone_s = dtone_t;  tdrv_s = tdrv_t;  twob_s = twob_t;  ttone_s = ttone_t;
  bamt_s = bamt_t;  blsat_s = blsat_t;  btone_s = btone_t;  bwid_s = bwid_t;
);
function clr_eng() (
  memset(SL, 0, 200);  memset(MB, 0, 8);
  chL.hd.hd_clr();  chR.hd.hd_clr();  chL.wlp.bq_clr();  chR.wlp.bq_clr();  fzL.fz_clr();  fzR.fz_clr();
  chL.env3 = chR.env3 = 0;  hf_env = 0;  hf_g = 1;
  dkR.env = dkM.env = dkA.env = 0;
);

function ctl() local(tls) (
  kb = 1 - exp(-CR / (0.04 * srate));
  dr_sp = 0.05 * dm_s * CR / srate;
  dr_dv = 0.6 * dm_a * DRV1.drift_tick(dr_sp);
  dr_bv = 0.012 * dm_a * DRV2.drift_tick(dr_sp * 0.7);
  dr_wv = 0.04 * dm_a * DRV3.drift_tick(dr_sp * 1.3);
  drive_s += (drive_t - drive_s) * kb;  cut_s += (cut_t - cut_s) * kb;  dtone_s += (dtone_t - dtone_s) * kb;
  tdrv_s += (tdrv_t - tdrv_s) * kb;  twob_s += (twob_t - twob_s) * kb;  ttone_s += (ttone_t - ttone_s) * kb;
  bamt_s += (bamt_t - bamt_s) * kb;  blsat_s += (blsat_t - blsat_s) * kb;  btone_s += (btone_t - btone_s) * kb;  bwid_s += (bwid_t - bwid_s) * kb;
  eng_cur == 0 ? (
    (coef_dirty || abs(cut_s - cut_c) > 0.002 || abs(dtone_s - dtone_c) > 0.002) ? (
      cs_ls(C_LC, 150, -0.8 * cut_s);  cs_hs(C_HS, 3300, 1.2 * dtone_s);
      cut_c = cut_s;  dtone_c = dtone_s;  coef_dirty = 0;
    );
    lsat_s = 0.3;
    dg = db2g(drive_s * 1.5 + dr_dv);
    stg_t = min(1, drive_s / 4);
    dn = drive_s / 10;
    wlp_f = 20000 * 2 ^ (-2 * lsat_s * dn);
    wlp_on = wlp_f < 19000;
    wlp_on && abs(wlp_f - wlp_last) > wlp_f * 0.002 ? (
      chL.wlp.bq_mlp(wlp_f, 0.6, fsr);  chR.wlp.bq_mlp(wlp_f, 0.6, fsr);  wlp_last = wlp_f;
    );
    sub_amt = drive_s * 0.035;
    emk_t = db2g(drive_s < 4 ? 0.45 * (4 - drive_s) : -0.15 * (drive_s - 4));
    fz_p = min(max((drive_s - 4) / 6, 0), 1);  fz_t = 0.33 * fz_p * fz_p * (3 - 2 * fz_p);
    st2_b = 0.05 + 0.12 * lsat_s;  st2_k = stn(dg, st2_b);  st2_f = sat_f(st2_b);
    st41_g = dg * (1 + 0.6 * lsat_s);  st41_b = 0.04 + 0.16 * lsat_s;  st41_k = stn(st41_g, st41_b);  st41_f = sat_f(st41_b);
    st42_k = stn(dg, 0.04);  st42_f = sat_f(0.04);  st43_k = stn(dg, 0.03);  st43_f = sat_f(0.03);
    st44_g = dg * 0.85;  st44_k = stn(st44_g, 0.02);  st44_f = sat_f(0.02);
    st3l_g = dg * (1.5 + 0.6 * lsat_s);  st3l_b = 0.08 + 0.18 * lsat_s;  st3l_k = stn(st3l_g, st3l_b);  st3l_f = sat_f(st3l_b);
    st3h_g = max(1, dg * 0.45);  st3h_k = stn(st3h_g, 0.02);  st3h_f = sat_f(0.02);
  ) : eng_cur == 1 ? (
    fz_t = 0;
    dn = tdrv_s / 10;
    tls = spd_cur == 0 ? 0.8 : spd_cur == 1 ? 0.5 : 0.2;
    hd_g = 10 ^ ((tdrv_s * 2.2 + dr_dv) / 20);
    hb_s = 0.03 + 0.07 * tls + dr_bv;
    hd_c = 0.25 / ((ost_tanh(hd_g * 0.125 + hb_s) - ost_tanh(hb_s)) - (ost_tanh(-hd_g * 0.125 + hb_s) - ost_tanh(hb_s)));
    hd_lb = dn ^ 1.2;
    hd_lg = sqrt(hd_g * hd_c * (1 - sqr(ost_tanh(hb_s))));
    hd_bump = (spd_cur == 0 ? 2.5 : spd_cur == 1 ? 1.5 : 0.8) * (1 - 0.5 * dn);
    hd_tb = ost_tanh(hb_s);
    emk_t = db2g(1.8 + 0.5 * tdrv_s - 0.07 * tdrv_s * tdrv_s + (spd_cur == 0 ? 0.6 : 0));
    (abs(tdrv_s - hd_lastd) > 0.01 || abs(ttone_s - hd_lastt) > 0.01 || coef_hd) ? (
      chL.hd.hd_eq(spd_cur, 20 + 140 * dn ^ 1.5, 4 * dn + 1.2 * ttone_s);
      chR.hd.hd_eq(spd_cur, 20 + 140 * dn ^ 1.5, 4 * dn + 1.2 * ttone_s);
      hd_lastd = tdrv_s;  hd_lastt = ttone_s;  coef_hd = 0;
    );
    wob_t += CR / srate;
    wob_t > 0.45 ? ( wob_t = 0;  wob_tgt = rand(2) - 1; );
    wob_v += (wob_tgt - wob_v) * (1 - exp(-CR / (srate * 0.35)));
    wob_dep = twob_s / 10 * 0.0006 * fsr;
    wob_amp = twob_s / 10 * 0.5;
  ) : (
    fz_t = 0;
    lsat_s = blsat_s;
    dg = db2g(bamt_s * 0.9 + dr_dv * 0.5);
    stg_t = min(1, bamt_s / 4);
    dn = bamt_s / 10;
    st2_b = 0.05 + 0.12 * lsat_s;  st2_k = stn(dg, st2_b);  st2_f = sat_f(st2_b);
    abs(btone_s - bt_c) > 0.002 ? ( cs_hs(C_BT, 6600, btone_s);  bt_c = btone_s; );
    dk_ddb = 1 + bamt_s * 0.8;
    mk_i = min(4.999, dn * 5);  mk_k = floor(mk_i);  mk_f = mk_i - mk_k;
    mk_a = mk_k == 0 ? 2.0 : mk_k == 1 ? 0.2 : mk_k == 2 ? -0.9 : mk_k == 3 ? -0.95 : -0.6;
    mk_b = mk_k == 0 ? 0.2 : mk_k == 1 ? -0.9 : mk_k == 2 ? -0.95 : mk_k == 3 ? -0.6 : -0.1;
    dk_mk = 10 ^ ((mk_a + (mk_b - mk_a) * mk_f) / 20);
    dkR.dk_block(dk_ddb);  dkM.dk_block(dk_ddb);  dkA.dk_block(dk_ddb);
    dwR = max(0, min(1, (lsat_s - 0.55) / 0.3));
    dwA = max(0, min(1, (0.45 - lsat_s) / 0.2));
    dwM = max(0, 1 - dwR - dwA);
    wid_d = bwid_s * (1 + dr_wv);
    emk_t = db2g(1.7 - 0.19 * bamt_s);
  );
  emk_f ? ( emk_s = emk_t;  emk_f = 0; );
);

DRV1.drift_init(0.7 + rand(1) * 0.4);  DRV2.drift_init(0.8 + rand(1) * 0.4);  DRV3.drift_init(0.9 + rand(1) * 0.4);
drift_macro(drift);
dr_dv = dr_bv = dr_wv = 0;
in_s = in_t = inc_s = inc_t = 1;  mix_s = mix_t = 1;
memset(DRY, 0, DRYN * 2);  dpos = 0;
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_base + os_lat(os_f);
by_setup(15);
pwr_init();  pwr_hum_db = -83;  pwr_wu_loss = 1.2;  pwr_wu_drv = 2.5;  pwr_wu_lp = 6000;  pwr_bloom = 0.25;  pwr_sag = 0.22;
mn_vu_d = mn_pk_d = 0;  mn_ms = mn_pkm = 0;
rs_f = 1;
PB_N = 18;

function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 0); pv(2, 4); pv(3, 1); pv(4, 3); pv(5, 0); pv(6, 4); pv(7, 1); pv(8, 2); pv(9, 0);
  pv(10, 4); pv(11, 4); pv(12, 100); pv(13, 0); pv(16, 100); pv(17, 0); pv(18, 0); pv(19, 50);
);
function p_d(d, m, c, t, o) ( pv(1, 0); pv(2, d); pv(3, m); pv(4, c); pv(5, t); pv(18, o); );
function p_t(d, s, w, t, o) ( pv(1, 1); pv(6, d); pv(7, s); pv(8, w); pv(9, t); pv(18, o); );
function p_b(v, a, w, m, o) ( pv(1, 2); pv(10, v); pv(11, a); pv(12, w); pv(13, m); pv(18, o); );
function sl_list() local(i) ( i = 1;  loop(19, i != 15 ? slider_automate(2 ^ (i - 1));  i += 1; ); );
function load_preset(p) (
  p_init();
  p == 2 ? p_d(5, 1, 4, 1, -0.5);
  p == 3 ? p_d(6, 2, 1, -1, 0);
  p == 4 ? p_d(7, 1, 5, 2, -1);
  p == 5 ? p_d(6, 2, 3, -3, 0);
  p == 6 ? p_d(10, 0, 4, 0, -4.5);
  p == 7 ? p_t(3, 0, 3, -2, 0);
  p == 8 ? p_t(4, 1, 5, -1, 0);
  p == 9 ? p_t(5, 0, 8, -3, 0);
  p == 10 ? p_t(8, 2, 7, 2, -1);
  p == 11 ? p_t(6, 1, 1, 0, 0);
  p == 12 ? p_t(2, 2, 2, 1, 0);
  p == 13 ? p_b(6, 3, 115, 0, 0);
  p == 14 ? p_b(4, 3, 100, 1, 0);
  p == 15 ? p_b(0, 5, 95, 0, 0);
  p == 16 ? p_b(7, 2, 140, 0, 0);
  p == 17 ? p_b(2, 4, 105, 0, 0);
  p == 18 ? p_b(1, 7, 90, 1, -1);
  p == PB_N + 1 ? ( pv(14, 0); pv(15, 0); slider_automate(byp); slider_automate(os_sel); );
  sl_list();
  prm_dirty = 1;
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(19, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= PB_N ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;  prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(PB_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0;  prs_dirty = 0;

function clr_all() (
  memset(SL, 0, 200);  memset(MB, 0, 8);  memset(DLB, 0, DSZ);  memset(DRB, 0, DSZ);  memset(DRY, 0, DRYN * 2);
  ovuL.os_clr();  ovuR.os_clr();  ovdL.os_clr();  ovdR.os_clr();
  chL.hd.hd_clr();  chR.hd.hd_clr();  chL.wlp.bq_clr();  chR.wlp.bq_clr();  fzL.fz_clr();  fzR.fz_clr();
  dcL = dcR = 0;  apL = apR = 0;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
drift_macro(drift);
update_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_base + os_lat(os_f);
first_run ? (
  eng_snap();  sw_cur = sw_t;  eng_cur = eng_t;  spd_cur = spd_t;  eg_g = 1;
  w2 = w2t;  w4 = w4t;  w3 = w3t;  diff_w = bmono_t;  out_s = out_t;  in_s = in_t;  inc_s = inc_t;  mix_s = mix_t;
  first_run = 0;  coef_dirty = 1;  coef_hd = 1;
);
os_snap(slider(14));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now;  rs_gpp = play_position;  rs_gpd = samplesblock / srate;
prm_dirty ? ( prm_dirty = 0;  update_targets(); );
drift_macro(drift);
pwr_block(byp < 0.5);
fzL.fz_dn();  fzR.fz_dn();
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1)));  mn_ms = 0;  mn_pk_d = max(mn_pk_d, mn_pkm);  mn_pkm = 0;
os_snapb(slider(14));

@serialize
file_var(0, ui_sz);  file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;

@sample
by_in();
rs_req ? ( rs_req = 0;  rs_f = 0;  rs_c = 1 / (0.015 * srate);  rs_wait = pdc_delay;  clr_all(); );
w2 += (w2t - w2) * sm;  w4 += (w4t - w4) * sm;  w3 += (w3t - w3) * sm;
diff_w += (bmono_t - diff_w) * sm;  out_s += (out_t - out_s) * sm;
in_s += (in_t - in_s) * sm;  inc_s += (inc_t - inc_s) * sm;  mix_s += (mix_t - mix_s) * sm;  fz_o += (fz_t - fz_o) * sm;
sw_t != sw_cur ? (
  eg_g -= eg_k;
  eg_g <= 0 ? ( eg_g = 0;  sw_cur = sw_t;  eng_cur = eng_t;  spd_cur = spd_t;  eng_snap();  clr_eng();  fz_o = 0;  coef_dirty = 1;  coef_hd = 1;  cr_n = 0;  ctl();  emk_s = emk_t; );
) : eg_g < 1 ? ( eg_g = min(1, eg_g + eg_k); );
emk_s += (emk_t - emk_s) * sm;
egs = eg_g * eg_g * (3 - 2 * eg_g) * emk_s;
os_gate();
os_chg ? ( ov_rate();  memset(SL, 0, 200);  memset(DLB, 0, DSZ);  memset(DRB, 0, DSZ);  dw_pos = 0;  apL = apR = 0;
           ovuL.os_clr();  ovuR.os_clr();  ovdL.os_clr();  ovdR.os_clr();  chL.hd.hd_clr();  chR.hd.hd_clr();
           chL.wlp.bq_clr();  chR.wlp.bq_clr();  fzL.fz_clr();  fzR.fz_clr();  cr_n = 0; );
cr_n <= 0 ? ( cr_n = CR;  ctl(); );
cr_n -= 1;

pwr_in(spl0, spl1);  xl = pwr_l;  xr = pwr_r;
DRY[dpos * 2] = xl;  DRY[dpos * 2 + 1] = xr;
rp = (dpos + DRYN - pdc_delay) % DRYN;
ml = DRY[rp * 2];  mr = DRY[rp * 2 + 1];
dpos = (dpos + 1) % DRYN;

ovuL.os_up(xl * in_s);  ovuR.os_up(xr * in_s);
fz_on = fz_o > 0.0001;
ok = 0;
loop(os_f,
  xsl = ovuL.os_s(ok);  xsr = ovuR.os_s(ok);
  eng_cur == 0 ? (
    aL = chL.ch_tick(xsl, SL);  aR = chR.ch_tick(xsr, SR);
    fz_on ? ( aL += fzL.fz_run(aL);  aR += fzR.fz_run(aR); );
    hf_e = max(abs(chL.hfh), abs(chR.hfh));
    hf_env += (hf_e > hf_env ? hf_a : hf_r) * (hf_e - hf_env);
    hf_o = hf_env * dg * hf_ti;
    hf_g = hf_o > 1 ? 1 / (1 + HF_RT * (hf_o - 1)) : 1;
  ) : eng_cur == 1 ? (
    aL = chL.hd.hd_run(xsl, hb_s);  aR = chR.hd.hd_run(xsr, hb_s);
  ) : (
    aL = chL.bs_tick(xsl, SL);  aR = chR.bs_tick(xsr, SR);
  );
  aL *= egs;  aR *= egs;
  ph1 += 2 * $pi * 0.7 / fsr;  ph1 > 2 * $pi ? ph1 -= 2 * $pi;
  wm = 0.65 * wob_v + 0.35 * sin(ph1);
  DLB[dw_pos] = aL;  DRB[dw_pos] = aR;
  rd = DLY * os_f + (eng_cur == 1 ? wob_dep * wm : 0);
  rn = floor(rd);  rf = rd - rn;  rf < 0.5 ? ( rn -= 1;  rf += 1; );
  ae = (1 - rf) / (1 + rf);
  ri = dw_pos - rn;  ri < 0 ? ri += DSZ;  rp = ri - 1;  rp < 0 ? rp += DSZ;
  apL = ae * DLB[ri] + DLB[rp] - ae * apL;  apR = ae * DRB[ri] + DRB[rp] - ae * apR;
  aL = apL;  aR = apR;
  dw_pos += 1;  dw_pos >= DSZ ? dw_pos = 0;
  ok == 0 ? ( q0l = aL;  q0r = aR; ) : ok == 1 ? ( q1l = aL;  q1r = aR; ) : ok == 2 ? ( q2l = aL;  q2r = aR; ) : ( q3l = aL;  q3r = aR; );
  ok += 1;
);
aL = ovdL.os_dn(q0l, q1l, q2l, q3l) * inc_s;  aR = ovdR.os_dn(q0r, q1r, q2r, q3r) * inc_s;
dcL += (aL - dcL) * dc_k;  aL -= dcL;  dcR += (aR - dcR) * dc_k;  aR -= dcR;
eng_cur == 2 ? (
  diff_w > 0.0005 ? (
    dlL = svc(svc(aL, C_DF, MB), C_DF, MB + 2);
    dlR = svc(svc(aR, C_DF, MB + 4), C_DF, MB + 6);
    dm = (dlL + dlR) * 0.5;
    aL += (dm - dlL) * diff_w;  aR += (dm - dlR) * diff_w;
  );
  mm = (aL + aR) * 0.5;  ss = (aL - aR) * 0.5 * wid_d;  aL = mm + ss;  aR = mm - ss;
  dkL = dkR2 = 0;
  dwR > 0.001 ? ( dkR.dk_run(aL, aR);  dkL += dkR.ol * dwR;  dkR2 += dkR.orr * dwR; );
  dwM > 0.001 ? ( dkM.dk_run(aL, aR);  dkL += dkM.ol * dwM;  dkR2 += dkM.orr * dwM; );
  dwA > 0.001 ? ( dkA.dk_run(aL, aR);  dkL += dkA.ol * dwA;  dkR2 += dkA.orr * dwA; );
  aL = dkL;  aR = dkR2;
);
lw = eng_cur == 1 ? db2g(wob_amp * wm * 0.6) : 1;
aL = ml + (aL * lw - ml) * mix_s;  aR = mr + (aR * lw - mr) * mix_s;
os_gs = os_g * os_g * (3 - 2 * os_g);
aL *= os_gs;  aR *= os_gs;
pwr_out(aL, aR);  aL = pwr_l;  aR = pwr_r;
aL = ostL.ost_band(aL) * out_s;
aR = ostR.ost_band(aR) * out_s;
ost_out(aL, aR);  aL = ost_l;  aR = ost_r;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : rs_f = min(rs_f + rs_c, 1);
  rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  aL = by_il + (aL - by_il) * rs_s;  aR = by_ir + (aR - by_ir) * rs_s;
);
spl0 = abs(aL) < 0.00000000000000000001 ? 0 : aL;
spl1 = abs(aR) < 0.00000000000000000001 ? 0 : aR;
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);  mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));
@gfx 900 355
ui_begin(900, 355);
mk_face = 0x2E5E46; mk_band = 0x0E0F10; mk_ink = 0xF0F0EC; mk_tab = 0xE89A30; mk_acc = 0xF0A040;
mk_sub = 0x183326; mk_ink2 = 0xCDD0C4;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_stripes(x, yt, yb, c1, c2, c3) local(k, i, a0, r0, r1, py, xl, xr, fl, fr) (
  k = (yb - yt) / 48; i = 0; r0 = floor(yt * sc); r1 = floor(yb * sc);
  loop(3, ui_col(i == 0 ? c1 : i == 1 ? c2 : c3); a0 = gfx_a; py = r0;
    loop(r1 - r0,
      xl = (x + 26 * k * i) * sc + 20 * (py + 0.5 - yt * sc) / 48; xr = xl + 16 * k * sc;
      fl = floor(xl); fr = floor(xr);
      gfx_a = a0 * (1 - (xl - fl)); gfx_rect(fl, py, 1, 1);
      gfx_a = a0; fr > fl + 1 ? gfx_rect(fl + 1, py, fr - fl - 1, 1);
      gfx_a = a0 * (xr - fr); gfx_a > 0.004 ? gfx_rect(fr, py, 1, 1);
      py += 1; );
    gfx_a = a0; i += 1; );
);
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0xF4F6F8); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0x1A1A1C); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(0x1A1A1C); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_well(x, y, w, h) ( ui_cola(0x000000, 0.18); mg_r(x, y, w, h); ui_cola(0x000000, 0.12); mg_r(x, y, w, 2); mg_r(x, y + 2, 2, h - 2); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, i, t) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KRD * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KRD * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KRD * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KRD * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.72);
  ) : sty == 2 ? (
    ui_col(0xA9ACAF); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0xF1F0EC); gfx_circle(KX, KY, KRD * 0.92, 1, 1);
    i = 0; loop(6, ui_cola(0x000000, 0.12 * (1 - i / 6)); gfx_circle(KX, KY, KRD * 0.92 - i * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.9 : 0.8); ui_ssarc(KX, KY, KRD * 0.8, -2.5 + 0.5 * $pi, -1.4 + 0.5 * $pi, 1 * sc);
    ui_col(0x26282C); ui_kdot(KX, KY, a, KRD * 0.92);
  ) : (
    ui_col(0x2C2E33); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0x121315); gfx_circle(KX, KY, KRD * 0.8, 1, 1);
    ui_col(ui_mix(0x2C2E33, 0x000000, 0.25)); gfx_circle(KX, KY, KRD * 0.68, 1, 1);
    ui_cola(0xFFFFFF, act ? 0.22 : 0.12); ui_ssarc(KX, KY, KRD * 0.95, -2.6 + 0.5 * $pi, -1.0 + 0.5 * $pi, 1 * sc);
    ui_col(0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.68);
  );
);
function mg_dots(x, y, r, c) local(i, t, rs, px, py, n) (
  rs = r + 8; i = 0; n = mg_nst > 0 && mg_nst <= 8 ? mg_nst - 1 : 4;
  loop(n + 1, t = -0.75 * $pi + i / n * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_wdial && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); ui_col(c);
      mg_ctxt(px + (i == 0 ? -3 : i == 4 ? 3 : 0), py + (i == 2 ? -2 : 0), i == 0 ? "M" : i == 2 ? "C" : "S"); )
    : mg_zero && i == 2 ? ( gfx_setfont(11); ui_col(c); mg_ctxt(px, py - 2, "0"); )
    : i == 0 || i == n ? ( ui_col(c); mg_disc(px, py, 1.8); );
    i += 1; );
);
function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : mg_nst > 0 ? 160 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi, lg); mg_nst > 0 ? v = floor(v + 0.5);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    mg_nst > 0 ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(mg_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
      slider(idx) = mg_n2v(n, lo, hi, lg);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  mg_dots(cx, cy, r, mk_ink2); mg_cshadow(cx, cy, r);
  mg_kbody(sty, cx, cy, r, a, act, col);
  mg_wdial = 0; mg_zero = 0; mg_nst = 0;
  act;
);
function mg_hz(v) ( v >= 1000 ? sprintf(#mgh, "%.1f kHz", v / 1000) : sprintf(#mgh, "%d Hz", v + 0.5); #mgh; );
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, sty, col, kind, name) local(k, v, m) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) : kind == 1 ? sprintf(#mgv, "%+d %%", floor(v + 0.5)) :
  kind == 2 ? sprintf(#mgv, "%d ms", floor(v + 0.5)) : kind == 3 ? sprintf(#mgv, "%.1f", v) :
  kind == 4 ? strcpy(#mgv, mg_hz(v)) : kind == 5 ? sprintf(#mgv, "%+.1f dB", v) :
  kind == 6 ? ( m = floor(v + 0.5); strcpy(#mgv, m == 0 ? "OFF" : m == 1 ? "33 Hz" : m == 2 ? "55 Hz" : m == 3 ? "77 Hz" : m == 4 ? "110 Hz" : m == 5 ? "220 Hz" : "330 Hz"); ) :
  kind == 7 ? strcpy(#mgv, v <= 11.5 ? "OFF" : mg_hz(v)) : strcpy(#mgv, v >= 21500 ? "OFF" : mg_hz(v));
  gfx_setfont(10); ui_col(k ? mk_acc : mk_ink); mg_ctxt(cx, ly, k ? #mgv : name);
  k;
);
function mg_sqkey(x, y, idx, lbl, lc, ly) local(on, hov, s, b, dn) (
  on = slider(idx) >= 0.5; s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 0 : 1; ui_auto(idx); on = !on; dn = on ? 1.5 : 0; );
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(on ? 0x8A8C90 : 0x9C9EA2); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, 0.28); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, 0.35); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  gfx_setfont(10); ui_col(hov ? mk_acc : mk_ink); mg_ctxt(x + 20, ly, lbl);
);
function mg_sqk(x, y, on, lbl, lc, ly) local(hov, s, b, dn, hit) (
  s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(on ? 0x8A8C90 : 0x9C9EA2); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, 0.28); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, 0.35); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(x + 17, ly, lbl);
  hit;
);
function mg_tkey(x, y, w, on, lc, w1, w2) local(hov, hit, tw, th, cx, ax) (
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + 36) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.25); mg_rr(x, y + 1.5, w + 4, 40, 4);
  ui_col(0x0E0F10); mg_rr(x - 2, y - 2, w + 4, 40, 4);
  ui_col(0x1A1B1D); mg_rr(x, y, w, 36, 3);
  ui_col(0x45484D); mg_rr(x, y, w - 1, 35, 3);
  ui_col(0x2C2E32); mg_rr(x + 1, y + 1, w - 2, 34, 3);
  ui_col(0x34363A); mg_rr(x + 1, y + 1, w - 2, 28, 3);
  ui_col(0x3C3F43); mg_r(x + 4, y + 1, w - 8, 1);
  on ? ( ui_cola(lc, 0.3); mg_rr(x + w / 2 - 14, y + 5, 28, 12, 3); ui_col(ui_mix(lc, 0xFFFFFF, 0.25)); mg_rr(x + w / 2 - 11, y + 7, 22, 8, 2); )
     : ( ui_col(ui_mix(lc, 0x1E2023, 0.75)); mg_rr(x + w / 2 - 11, y + 7, 22, 8, 2); );
  hov ? ( ui_cola(0xFFFFFF, 0.06); mg_rr(x + 1, y + 1, w - 2, 34, 3); );
  gfx_setfont(6); ui_col(0xE8EBEE);
  !strlen(w2) ? ( gfx_measurestr(w1, tw, th); gfx_x = (x + w / 2) * sc - tw * 0.5; gfx_y = (y + 25) * sc - th * 0.5; gfx_drawstr(w1); ) : (
  gfx_measurestr(w1, tw, th); ax = tw / sc; gfx_measurestr(w2, tw, th);
  cx = x + w / 2 - (ax + 20 + tw / sc) * 0.5 + ax + 10;
  gfx_x = (cx - 10 - ax) * sc; gfx_y = (y + 25) * sc - th * 0.5; gfx_drawstr(w1);
  gfx_x = (cx + 10) * sc; gfx_y = (y + 25) * sc - th * 0.5; gfx_drawstr(w2);
  ui_ssline((cx - 6.5) * sc, (y + 25) * sc, (cx + 6.5) * sc, (y + 25) * sc, 1.3 * sc, 1);
  gfx_triangle((cx - 8) * sc, (y + 25) * sc, (cx - 4.5) * sc, (y + 22.6) * sc, (cx - 4.5) * sc, (y + 27.4) * sc);
  gfx_triangle((cx + 8) * sc, (y + 25) * sc, (cx + 4.5) * sc, (y + 22.6) * sc, (cx + 4.5) * sc, (y + 27.4) * sc);
  );
  hit;
);
function mg_badge(x, y, s, f) local(tw, th, bw, bh) (
  gfx_setfont(6); gfx_measurestr(s, tw, th); bw = tw / sc + 12; bh = 20;
  ui_col(0x1A1A1C); mg_rr(x, y, bw, bh, 3); ui_col(f); mg_rr(x + 1, y + 1, bw - 2, bh - 2, 2);
  ui_col(0x1A1A1C); gfx_x = (x + 6) * sc; gfx_y = (y + bh / 2 + 0.5) * sc - th * 0.5; gfx_drawstr(s);
);
function mg_led(x, y, c, v) (
  v > 0.02 ? ( ui_cola(c, 0.2 * v); mg_disc(x, y, 11); );
  ui_col(0x050506); mg_disc(x, y, 7);
  ui_col(ui_mix(ui_mix(c, 0x101214, 0.78), c, v)); mg_disc(x, y, 5);
  ui_cola(0xFFFFFF, 0.12 + 0.43 * v); mg_disc(x - 1.7, y - 1.7, 1.7);
);
function mg_vu(x, y, w, h, vdb, pk) local(fx, fy, fw, fh, rad, px, py, i, t, a, s, ang0, ang1, c) (
  ui_vu_dim = byp >= 0.5;
  ui_spill((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 1);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, h + 18);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, 3); mg_r(x - 9, y - 6, 3, h + 15);
  ui_cola(0xFFFFFF, 0.10); mg_r(x - 9, y + h + 7, w + 18, 2); mg_r(x + w + 7, y - 9, 2, h + 16);
  ui_col(0x0C0C0C); mg_rr(x - 3, y - 3, w + 6, h + 6, 5);
  fx = x + 3; fy = y + 3; fw = w - 6; fh = h - 6;
  ui_glow(floor(fx * sc), floor(fy * sc), fw * sc, fh * sc, 1);
