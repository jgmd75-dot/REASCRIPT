sv_z = ld_cb * sv_xr + ld_ar; ld_ar = sv_xr - ld_cb * sv_z; sv_xr += ld_hb * 0.5 * (sv_xr + sv_z);
sv_z = ld_ct * sv_xl + ld_bl; ld_bl = sv_xl - ld_ct * sv_z; sv_xl += ld_ht * 0.5 * (sv_xl - sv_z);
sv_z = ld_ct * sv_xr + ld_br; ld_br = sv_xr - ld_ct * sv_z; sv_xr += ld_ht * 0.5 * (sv_xr - sv_z);

(ld_ord != ld_ordt || sv_e != sv_et) ? (
  sv_dk -= sv_dks;
  sv_dk <= 0 ? (
    sv_dk = 0;
    ld_ord != ld_ordt ? ( ld_ord = ld_ordt; ld_eqclr(); );
    sv_e != sv_et ? ( sv_e = sv_et; sv_v = sv_e != 1; sv_s = sv_e != 0; sv_vclear(); ld_hpl = ld_hpr = 0; ld_l1l = ld_l2l = ld_l1r = ld_l2r = 0; sv_dxl = sv_dyl = sv_dxr = sv_dyr = 0; sk_env = 0; sv_mo = sv_s ? sk_mk : ld_mu; );
  );
) : sv_dk < 1 ? sv_dk = min(sv_dk + sv_dks, 1);
!ld_ord ? ( sv_xl = ld_eq(0, sv_xl); sv_xr = ld_eq(1, sv_xr); );
abs(sv_xl) < 0.000000000000001 ? sv_xl = 0; abs(sv_xr) < 0.000000000000001 ? sv_xr = 0;
pwr_in(sv_xl, sv_xr); sv_xl = pwr_l; sv_xr = pwr_r;

ld_cw = (ld_cw + 1) & 63; SV_CD[ld_cw] = sv_xl; SV_CD[64 + ld_cw] = sv_xr;
ld_ci = (ld_cw - os_lat(os_f)) & 63; sv_cl = SV_CD[ld_ci]; sv_cr = SV_CD[64 + ld_ci];

sv_v ? (
  ld_hpl += ld_hpk * (sv_xl - ld_hpl); ld_hpr += ld_hpk * (sv_xr - ld_hpr);
  sv_xl -= ld_hpl; sv_xr -= ld_hpr;
);
sk_rl = max(0.6, sk_vr * (1 - sk_sg * min(sk_env, 1)));
os_gate();
os_chg ? ( sv_vclear(); sv_osco(); os_hold += 2 * samplesblock; );
uxL.os_up(sv_xl * dmm_kl); uxR.os_up(sv_xr * dmm_kr);
os_f == 1 ? (
  sv_yl = chL.sv_ch(uxL.s0); sv_yr = chR.sv_ch(uxR.s0);
) : (
  sv_a0 = chL.sv_ch(uxL.s0); sv_b0 = chR.sv_ch(uxR.s0);
  sv_a1 = chL.sv_ch(uxL.s1); sv_b1 = chR.sv_ch(uxR.s1);
  os_f == 2 ? ( sv_yl = dnL.os_dn(sv_a0, sv_a1, 0, 0); sv_yr = dnR.os_dn(sv_b0, sv_b1, 0, 0); ) : (
    sv_a2 = chL.sv_ch(uxL.s2); sv_b2 = chR.sv_ch(uxR.s2);
    sv_a3 = chL.sv_ch(uxL.s3); sv_b3 = chR.sv_ch(uxR.s3);
    sv_yl = dnL.os_dn(sv_a0, sv_a1, sv_a2, sv_a3); sv_yr = dnR.os_dn(sv_b0, sv_b1, sv_b2, sv_b3);
  );
);
sv_yl *= dmm_ol; sv_yr *= dmm_or;
sv_s ? ( sv_v1 = max(abs(sv_yl), abs(sv_yr)); sk_env += (sv_v1 - sk_env) * (sv_v1 > sk_env ? sk_ea : sk_er); );
sv_z = sv_yl - sv_dxl + sv_dcc * sv_dyl; sv_dxl = sv_yl; sv_dyl = sv_z; sv_yl = sv_z;
sv_z = sv_yr - sv_dxr + sv_dcc * sv_dyr; sv_dxr = sv_yr; sv_dyr = sv_z; sv_yr = sv_z;
sv_v ? (
  sv_z = ld_lb0 * sv_yl + ld_l1l; ld_l1l = ld_lb1 * sv_yl - ld_la1 * sv_z + ld_l2l; ld_l2l = ld_lb0 * sv_yl - ld_la2 * sv_z; sv_yl = sv_z;
  sv_z = ld_lb0 * sv_yr + ld_l1r; ld_l1r = ld_lb1 * sv_yr - ld_la1 * sv_z + ld_l2r; ld_l2r = ld_lb0 * sv_yr - ld_la2 * sv_z; sv_yr = sv_z;
