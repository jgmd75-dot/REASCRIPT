sv_yl *= sv_og * sv_osg; sv_yr *= sv_og * sv_osg;
sv_yl != sv_yl ? sv_yl = 0; sv_yr != sv_yr ? sv_yr = 0;
sv_fi < 1 ? (
  sv_fi = min(sv_fi + sv_fis, 1); sv_z = sv_fi * sv_fi * (3 - 2 * sv_fi);
  sv_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; sv_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  sv_yl = sv_a + sv_z * (sv_yl - sv_a); sv_yr = sv_b + sv_z * (sv_yr - sv_b);
