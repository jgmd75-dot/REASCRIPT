  ld_ct = ld_shh(ld_gt, 3300); ld_ht = sv_db(ld_gt) - 1;
  ld_eqglide();
);

sv_xl = in_l * ld_ig; sv_xr = in_r * ld_ig;
sv_v1 = hpL.sk_svf(sv_xl, sk_h1, sk_h2, sk_h3); sv_v1 = sv_xl - 1.4142135623730951 * sk_bpo - sv_v1; sv_xl += sv_hpm * (sv_v1 - sv_xl);
sv_v1 = hpR.sk_svf(sv_xr, sk_h1, sk_h2, sk_h3); sv_v1 = sv_xr - 1.4142135623730951 * sk_bpo - sv_v1; sv_xr += sv_hpm * (sv_v1 - sv_xr);
