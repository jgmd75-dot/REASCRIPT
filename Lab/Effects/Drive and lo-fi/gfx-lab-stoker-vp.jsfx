sv_m = bmM.sk_bq(0.5 * (sv_yl + sv_yr)); sv_sd = bmS.sk_bq(0.5 * (sv_yl - sv_yr));
sv_yl = sv_m + sv_sd; sv_yr = sv_m - sv_sd;
