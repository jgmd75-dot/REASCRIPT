desc:Stoker VP [voicing overdrive] (GFX Lab)
//tags: overdrive drive preamp voicing equaliser valve tube transformer iron diode clipping bass guitar
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-thick, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider37:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:2<0,2,1{Voicing preamp,Overdrive,Preamp into overdrive}>-Engine
slider2:0<-24,20,0.1>-Trim (dB)
slider3:1<0,1,1{Off,On}>-Guard
slider4:0<0,1,1{Off,On}>-Line pad
slider5:33<11,550,1>-HPF (Hz, 11 = off)
slider6:22000<2200,22000,10>-LPF (Hz, 22000 = off)
slider7:0<-15,15,0.1>-Voice bass (dB)
slider8:0<-15,15,0.1>-Voice treble (dB)
slider9:0<-15,15,0.1>-Low gain (dB)
slider10:110<30,240,1>-Low freq (Hz)
slider11:0<-15,15,0.1>-Low-mid gain (dB)
slider12:330<100,800,1>-Low-mid freq (Hz)
slider13:0<-15,15,0.1>-Hi-mid gain (dB)
slider14:1100<450,3600,1>-Hi-mid freq (Hz)
slider15:0<-15,15,0.1>-Hi gain (dB)
slider16:3300<1200,9600,1>-Hi freq (Hz)
slider17:0<0,1,1{Before drive,After drive}>-Voice EQ position
slider18:1<0,2,1{Clean,Voice,Both}>-Channel
slider19:0<-30,10,0.1>-Clean level (dB)
slider20:0<-30,10,0.1>-Voice level (dB)
slider21:12<0,40,0.1>-Drive (dB)
slider22:30<0,100,1>-Iron in (%)
slider23:8<0,30,0.1>-Stage 1 (dB)
slider24:0<0,3,1{Off,GE,SI,Asym}>-Diodes
slider25:4<0,24,0.1>-Stage 2 (dB)
slider26:50<0,100,1>-Iron out (%)
slider27:0<-12,12,0.1>-Tone bass (dB)
slider28:0<-12,12,0.1>-Tone treble (dB)
slider29:0<0,12,0.1>-Mid boost 2.2 kHz (dB)
slider30:0<0,12,0.1>-Side boost 660 Hz (dB)
slider31:0<0,1,1{Off,On}>-Thick
slider32:1.8<-30,12,0.1>-Output (dB)
slider33:50<0,100,1>-Drift (%)
slider34:os_sel=1<0,2,1{1x,2x,4x}>-Oversampling
slider35:byp=0<0,1,1{Off,On}>-Bypass
slider36:prs_sel=0<0,26,1{No preset,Init,Stoker Init,Iron Tickle,GE Fuzz,SI Overdrive,Asym Warm,Bass Growl,Wide Lead,Bus Warmth,Weir VP Init,Bite and Sizzle,Bass Grind,Studio Clean,Nasal Lead,Blend Bass,Heavy Iron,Post Carve,Line Keys,Preamp Push,Voiced Grit,Iron Stack,Bass Stack,Carved Fuzz,Wide Voice,Keys Warmth,Nasal Push}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
function psw_all(v) ( slider_show(137438953471, v); );
function psw_allg(v) ( slider_show(137438953471, v); );
#ui_man = "gfx-lab-stoker-vp";
ext_noinit = 1;

SV_CF = 40000;
SV_ST = 40040;
SV_GL = 40080;
SV_CD = 40200;

function sv_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function sv_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function sv_db(d) ( exp(d * 0.11512925464970228); );
function ld_t(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

function sk_tri(u, e) local(q) (
  q = u * u;
  u / sqrt(1 + (u > 0 ? q : 0.35 * q)) + e * q / (1 + q);
);
function sk_di(x, m) (
  m == 1 ? x / (1 + abs(x) * 3.3333) :
  m == 2 ? x / sqrt(1 + x * x * 4.9383) :
  m == 3 ? ( x > 0 ? x / sqrt(1 + x * x * 4.9383) : x / sqrt(1 + x * x * 1.2346) ) :
  x;
);

function sv_ch(x) instance(ilp, h1x, h1y, dlp, h2x, h2y, ph) local(y, u, d, n, f) (
  ilp += sk_ilk * (x - ilp);
  u = ilp * sk_ia;
  x += (u / sqrt(1 + u * u) + 0.08 * u * u / (1 + u * u) - u) / sk_ia;
  sv_v ? (
    x *= ld_dg;
    sv_pkb = max(sv_pkb, abs(x) * ld_hd);
    x = 4 * ld_t(x * 0.25);
    x = (ld_t(x * ld_hd + ld_bs) - ld_t0) / ld_hd;
    sv_s ? x *= ld_mu;
  );
  sv_s ? (
    !sv_v ? sv_pkb = max(sv_pkb, abs(x) * sk_g1 * 2.5);
    y = sk_rl * sk_tri(x * sk_g1 / sk_rl, sk_e1);
    h1y = sk_hc * (h1y + y - h1x); h1x = y; y = h1y;
    d = sk_di(y, sk_dm);
    sk_dxf < 1 ? ( n = sk_di(y, sk_dmo); d = n + sk_dxf * (d - n); );
    dlp += sk_dlk * ((d - y) - dlp); d = y + dlp;
    h2y = sk_hc * (h2y + d - h2x); h2x = d; d = h2y;
    x = sk_rl * sk_tri(d * sk_g2 / sk_rl, sk_e2);
  );
  ph += ld_ik * (x - ph);
  f = ph * ld_fs;
  x - ld_ko * (f - ld_t(f + ld_rm) + ld_t1) / ld_fs;
);
function sv_chclr() instance(ilp, h1x, h1y, dlp, h2x, h2y, ph) ( ilp = h1x = h1y = dlp = h2x = h2y = ph = 0; );
function sv_chtidy() instance(ilp, h1x, h1y, dlp, h2x, h2y, ph) (
  ilp = sv_tn(ilp); h1x = sv_tn(h1x); h1y = sv_tn(h1y); dlp = sv_tn(dlp); h2x = sv_tn(h2x); h2y = sv_tn(h2y); ph = sv_tn(ph);
);
function sv_osco() local(fo) (
  fo = srate * os_f;
  sk_ilk = 1 - exp(-2 * $pi * 90 / fo);
  sk_hc = exp(-2 * $pi * 22 / fo);
  sk_dlk = 1 - exp(-2 * $pi * min(7700, 0.4 * fo) / fo);
  ld_ik = 1 - exp(-2 * $pi * 120 / fo);
);

function sk_svfc(f) local(g) (
  g = tan($pi * min(f, srate * 0.47) / srate);
  sk_c1 = 1 / (1 + g * (g + 1.4142135623730951)); sk_c2 = g * sk_c1; sk_c3 = g * sk_c2;
);
function sk_svf(x, a1, a2, a3) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; sk_bpo = v1; v2;
);
function sk_svfclr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function sk_svftidy() instance(ic1, ic2) ( ic1 = sv_tn(ic1); ic2 = sv_tn(ic2); );
function sk_bqc(t, f, q, gdb) local(ag, w, cw, sw, al, sA, a0) (
  ag = exp(gdb * 0.05756462732485115); w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); sw = sin(w);
  t == 2 ? (
    al = sw / (2 * q); a0 = 1 + al / ag;
    sk_b0 = (1 + al * ag) / a0; sk_b1 = -2 * cw / a0; sk_b2 = (1 - al * ag) / a0; sk_a1 = sk_b1; sk_a2 = (1 - al / ag) / a0;
  ) : (
    al = sw * 0.7071067811865476; sA = 2 * sqrt(ag) * al;
    t == 0 ? (
      a0 = (ag + 1) + (ag - 1) * cw + sA;
      sk_b0 = ag * ((ag + 1) - (ag - 1) * cw + sA) / a0; sk_b1 = 2 * ag * ((ag - 1) - (ag + 1) * cw) / a0;
      sk_b2 = ag * ((ag + 1) - (ag - 1) * cw - sA) / a0; sk_a1 = -2 * ((ag - 1) + (ag + 1) * cw) / a0;
      sk_a2 = ((ag + 1) + (ag - 1) * cw - sA) / a0;
    ) : (
      a0 = (ag + 1) - (ag - 1) * cw + sA;
      sk_b0 = ag * ((ag + 1) + (ag - 1) * cw + sA) / a0; sk_b1 = -2 * ag * ((ag - 1) + (ag + 1) * cw) / a0;
      sk_b2 = ag * ((ag + 1) + (ag - 1) * cw - sA) / a0; sk_a1 = 2 * ((ag - 1) - (ag + 1) * cw) / a0;
      sk_a2 = ((ag + 1) - (ag - 1) * cw - sA) / a0;
    );
  );
);
function sk_bqset() instance(b0, b1, b2, a1, a2) ( b0 = sk_b0; b1 = sk_b1; b2 = sk_b2; a1 = sk_a1; a2 = sk_a2; );
function sk_bq(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
function sk_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function sk_bqtidy() instance(x1, x2, y1, y2) ( x1 = sv_tn(x1); x2 = sv_tn(x2); y1 = sv_tn(y1); y2 = sv_tn(y2); );

function sk_coefs(snap) local(k) (
  k = snap ? 1 : sk_c16;
  sk_hf += (sk_hft - sk_hf) * k; sk_lf += (sk_lft - sk_lf) * k;
  sk_bs += (sk_bst - sk_bs) * k; sk_tr += (sk_trt - sk_tr) * k;
  sk_md += (sk_mdt - sk_md) * k; sk_sd += (sk_sdt - sk_sd) * k;
  snap || abs(sk_hf - sk_hfc) > 0.0001 ? ( sk_hfc = sk_hf; sk_svfc(exp(sk_hf)); sk_h1 = sk_c1; sk_h2 = sk_c2; sk_h3 = sk_c3; );
  snap || abs(sk_lf - sk_lfc) > 0.0001 ? ( sk_lfc = sk_lf; sk_svfc(exp(sk_lf)); sk_l1 = sk_c1; sk_l2 = sk_c2; sk_l3 = sk_c3; );
  snap || abs(sk_bs - sk_bsc) > 0.0005 ? ( sk_bsc = sk_bs; sk_bqc(0, 110, 0.7, sk_bs); bsL.sk_bqset(); bsR.sk_bqset(); );
  snap || abs(sk_tr - sk_trc) > 0.0005 ? ( sk_trc = sk_tr; sk_bqc(1, 3300, 0.7, sk_tr); trL.sk_bqset(); trR.sk_bqset(); );
  snap || abs(sk_md - sk_mdc) > 0.0005 ? ( sk_mdc = sk_md; sk_bqc(2, 2200, 0.8, sk_md); bmM.sk_bqset(); );
  snap || abs(sk_sd - sk_sdc) > 0.0005 ? ( sk_sdc = sk_sd; sk_bqc(2, 660, 0.8, sk_sd); bmS.sk_bqset(); );
);

function sk_match(g1, g2, m) local(i, a, y, s, s2) (
  s = s2 = 0; i = 0;
  loop(32,
    a = 0.12589 * sin((i + 0.5) / 32 * 2 * $pi);
    y = sk_tri(sk_di(sk_tri(a * g1, sk_e1), m) * g2, sk_e2);
    s += y; s2 += y * y; i += 1;
  );
  s2 = s2 / 32 - sqr(s / 32);
  0.0890215 / sqrt(max(s2, 0.0000000001));
);

function ld_bq(b, f, g) local(av, w, s, c, al, q, a0, o) (
  av = exp(g * 0.05756462732485114); w = 2 * $pi * min(f, 0.45 * srate) / srate; s = sin(w); c = cos(w);
  q = 0.6 + 0.07 * abs(g); al = s / (2 * q); a0 = 1 + al / av; o = SV_CF + b * 5;
  o[0] = (1 + al * av) / a0; o[1] = -2 * c / a0; o[2] = (1 - al * av) / a0; o[3] = -2 * c / a0; o[4] = (1 - al / av) / a0;
);
function ld_bqr(b, ch, x) local(o, s, y) (
  o = SV_CF + b * 5; s = SV_ST + b * 4 + ch * 2;
  y = o[0] * x + s[0]; s[0] = o[1] * x - o[3] * y + s[1]; s[1] = o[2] * x - o[4] * y; y;
);
function ld_eq(ch, x) local(b) ( b = 0; loop(4, SV_GL[b * 4 + 0] != 0 || SV_GL[b * 4 + 2] != 0 ? x = ld_bqr(b, ch, x); b += 1; ); x; );
function ld_eqclr() ( memset(SV_ST, 0, 16); );
function ld_eqglide() local(b, o, g, f) (
  b = 0;
  loop(4, o = SV_GL + b * 4;
    g = o[0] + (o[2] - o[0]) * ld_k16; abs(g - o[2]) < 0.005 ? g = o[2];
    f = o[1] + (o[3] - o[1]) * ld_k16; abs(f - o[3]) < 0.0005 ? f = o[3];
    (g != o[0] || f != o[1] || ld_eqfix) ? ( o[0] = g; o[1] = f; ld_bq(b, exp(f), g); );
    g == 0 ? ( SV_ST[b * 4] = SV_ST[b * 4 + 1] = SV_ST[b * 4 + 2] = SV_ST[b * 4 + 3] = 0; );
    b += 1; );
  ld_eqfix = 0;
);
function ld_shc(g, fc) local(t, v) ( v = sv_db(g); t = tan($pi * fc / srate); g >= 0 ? (t - 1) / (t + 1) : (t - v) / (t + v); );
function ld_shh(g, fc) local(t, v) ( v = sv_db(g); t = tan($pi * fc / srate); g >= 0 ? (t - 1) / (t + 1) : (t * v - 1) / (t * v + 1); );

function sv_vclear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  chL.sv_chclr(); chR.sv_chclr();
  memset(SV_CD, 0, 128);
);
function sv_reset() (
  sv_vclear(); ld_eqclr(); memset(BY_BUF, 0, 2 * BY_N);
  hpL.sk_svfclr(); hpR.sk_svfclr(); lpL.sk_svfclr(); lpR.sk_svfclr();
  bsL.sk_bqclr(); bsR.sk_bqclr(); trL.sk_bqclr(); trR.sk_bqclr(); bmM.sk_bqclr(); bmS.sk_bqclr();
  sv_dxl = sv_dyl = sv_dxr = sv_dyr = 0; sk_env = 0;
  ld_hpl = ld_hpr = 0; ld_l1l = ld_l2l = ld_l1r = ld_l2r = 0; ld_al = ld_ar = ld_bl = ld_br = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  sv_fi = 0;
);

function sv_srinit() local(w, s, c, al, a0) (
  sv_sr = srate;
  c_kn = sv_tc(30); c_sw = sv_tc(15);
  sk_c16 = 1 - exp(-16 / (0.03 * srate)); ld_k16 = sk_c16;
  sv_dcc = 1 - 2 * $pi * 5 / srate;
  sk_dxs = 1 / (0.012 * srate);
  sk_ea = sv_tc(4); sk_er = sv_tc(150);
  sv_fis = 1 / (0.01 * srate);
  sv_dks = 1 / (0.005 * srate);
  sv_fxs = 1 / (0.012 * srate);
  ld_hpk = 1 - exp(-2 * $pi * 33 / srate);
  w = 2 * $pi * min(8800, 0.45 * srate) / srate; s = sin(w); c = cos(w); al = s / (2 * 0.85); a0 = 1 + al;
  ld_lb0 = (1 - c) * 0.5 / a0; ld_lb1 = (1 - c) / a0; ld_la1 = -2 * c / a0; ld_la2 = (1 - al) / a0;
  ost_init(0);
  thk_init(); thk_lift = 3.5; thk_drv = 1.8; thk_asym = 0.2; thk_tr = 1.0; thk_trim = 0;
  sv_osco();
  sv_vclear(); ld_eqclr(); ld_eqfix = 1;
  sk_cc = 0; ld_cr = 0;
);

function sv_tgt() local(b) (
  sv_et = min(max(slider1 | 0, 0), 2);
  ld_igt = sv_db(-(slider4 >= 0.5 ? 12 : 0));
  sk_hft = log(min(max(slider5, 11), 550)); sk_lft = log(min(max(slider6, 2200), 22000));
  sv_hpt = slider5 > 11.5; sv_lpt = slider6 < 21995;
  ld_gbt = min(max(slider7, -15), 15); ld_gtt = min(max(slider8, -15), 15);
  b = 0;
  loop(4, SV_GL[b * 4 + 2] = min(max(slider(9 + b * 2), -15), 15);
    SV_GL[b * 4 + 3] = log(min(max(slider(10 + b * 2), 20), 20000)); b += 1; );
  ld_ordt = slider17 >= 0.5;
  sv_chn = slider18 | 0;
  ld_cot = (sv_chn == 0 || sv_chn == 2) * sv_db(min(max(slider19, -30), 10));
  ld_vot = (sv_chn >= 1) * sv_db(min(max(slider20, -30), 10));
  ld_dr = min(max(slider21, 0), 40);
  ld_dgt = sv_db(ld_dr); ld_mut = sv_db(-26 * (1 - exp(-ld_dr / 18)));
  sk_iat = 0.001 + 4 * min(max(slider22, 0), 100) / 100;
  sk_g1t = sv_db(min(max(slider23, 0), 30)); sk_g2t = sv_db(min(max(slider25, 0), 24));
  sk_dmn = min(max(slider24 | 0, 0), 3);
  ld_fst = 0.4 + 5.6 * min(max(slider26, 0), 100) / 100;
  ld_kot = min(max(slider26, 0), 10) / 10;
  sk_bst = min(max(slider27, -12), 12); sk_trt = min(max(slider28, -12), 12);
  sk_mdt = min(max(slider29, 0), 12); sk_sdt = min(max(slider30, 0), 12);
  sv_ogt = sv_db(min(max(slider32, -30), 12));
  sk_mh = sk_g1t * 1.37 + sk_g2t * 2.11 + sk_dmn * 3.7;
  sk_mh != sk_mhc ? ( sk_mhc = sk_mh; sk_mkt = sk_match(sk_g1t, sk_g2t, sk_dmn); );
);

function sv_mains(e) (
  e == 0 ? ( pwr_hum_db = -84; pwr_sag = 0.35; pwr_wu_loss = 0.5; pwr_wu_drv = 1.2; pwr_wu_lp = 12000; pwr_wu_wob = 0.25; pwr_bloom = 0; )
         : ( pwr_hum_db = -85; pwr_sag = 0.3; pwr_wu_loss = 1.2; pwr_wu_drv = 2.5; pwr_wu_lp = 6000; pwr_wu_wob = 0.4; pwr_bloom = 0.3; );
);

sk_e1 = 0.16; sk_e2 = 0.2;
ld_rm = 0.15; ld_t1 = ld_t(ld_rm);
os_design();
os_f = os_tf = os_f2n(os_sel); os_base = 0;
sv_srinit();
os_gsetup();
in_init();
dSup.drift_init(0.8 + rand(1) * 0.4); dBi.drift_init(0.8 + rand(1) * 0.4);
drift_mm_init();
drift_macro(50);
sv_tgt();
sv_e = sv_et; sv_v = sv_e != 1; sv_s = sv_e != 0; ld_ord = ld_ordt;
sv_hpm = sv_hpt; sv_lpm = sv_lpt;
sv_snap = 1; sv_fi = 1; sv_dk = 1; sk_rl = 1; sk_dxf = 1; sk_dm = sk_dmo = sk_dmn; ld_hd = 1; ld_bs = 0.07; ld_t0 = ld_t(ld_bs);
pdc_delay = os_lat(os_f);
by_setup(35);
pwr_init(); sv_mains(sv_e);
sv_vu_d = sv_pk_d = 0; sv_ms = sv_pkm = 0;

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

#sv_pm = "Init|Stoker Init|Iron Tickle|GE Fuzz|SI Overdrive|Asym Warm|Bass Growl|Wide Lead|Bus Warmth|Weir VP Init|Bite and Sizzle|Bass Grind|Studio Clean|Nasal Lead|Blend Bass|Heavy Iron|Post Carve|Line Keys|Preamp Push|Voiced Grit|Iron Stack|Bass Stack|Carved Fuzz|Wide Voice|Keys Warmth|Nasal Push";
SV_NP = 26;
function sv_set(e, tr, gd, pd, hp, lp, vb, vt, lg, lf, mg, mf, hg, hf, ig, iff, po, ch, cl, vl, dr, ii, s1, dm, s2, io, tb, tt, md, sd, th, ou) (
  slider1 = e; slider2 = tr; slider3 = gd; slider4 = pd; slider5 = hp; slider6 = lp; slider7 = vb; slider8 = vt;
  slider9 = lg; slider10 = lf; slider11 = mg; slider12 = mf; slider13 = hg; slider14 = hf; slider15 = ig; slider16 = iff;
  slider17 = po; slider18 = ch; slider19 = cl; slider20 = vl; slider21 = dr; slider22 = ii; slider23 = s1; slider24 = dm;
  slider25 = s2; slider26 = io; slider27 = tb; slider28 = tt; slider29 = md; slider30 = sd; slider31 = th; slider32 = ou;
);
function load_preset(p) (
  p == 1 ? sv_set(2, 0, 1, 0, 33, 22000, 0, 0, 0, 110, 0, 330, 0, 1100, 0, 3300, 0, 1, 0, 0, 12, 30, 8, 0, 4, 50, 0, 0, 0, 0, 0, 1.8);
  p == 2 ? sv_set(1, 0, 1, 0, 33, 21990, 0, 0, 0, 110, 0, 330, 0, 1100, 0, 3300, 0, 1, 0, 0, 12, 30, 10, 0, 4, 0, 0, 0, 0, 0, 0, 0);
  p == 3 ? sv_set(1, 0, 1, 0, 33, 21990, 0, 0, 0, 110, 0, 330, 0, 1100, 0, 3300, 0, 1, 0, 0, 12, 80, 6, 0, 3, 0, 1, 0, 0, 0, 1, 0);
  p == 4 ? sv_set(1, 0, 1, 0, 55, 21990, 0, 0, 0, 110, 0, 330, 0, 1100, 0, 3300, 0, 1, 0, 0, 12, 40, 18, 1, 10, 0, 0, -2, 3, 0, 0, -1);
  p == 5 ? sv_set(1, 0, 1, 0, 33, 21990, 0, 0, 0, 110, 0, 330, 0, 1100, 0, 3300, 0, 1, 0, 0, 12, 30, 16, 2, 8, 0, 0, 1, 4, 0, 0, -1);
