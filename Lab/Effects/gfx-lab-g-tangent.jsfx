col(0xD9D2C2, 1);  u_rect(60, 462, 108, 26);  col(0x000000, 0.18);  u_rect(60, 462, 108, 2);  u_rect(60, 462, 2, 26);
g_j = 0;
loop(8, g_t = g_j < 4 ? g_j + 1 : 6 + (g_j - 4) * 2;
  led(69 + g_j * 12.9, 475, 3.8, cp_gr_d >= g_t ? 1 : 0, g_j < 4 ? 0x9FD05A : g_j < 6 ? 0xFFB347 : 0xFF4A30);  g_j += 1; );
