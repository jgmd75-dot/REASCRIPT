lk_key(54, 240, 76, 40, t_soft >= 0.5, LK_AMB, "SOFT") ? ( slider(2) = t_soft >= 0.5 ? 0 : 1;  param_touched(2); );
lk_key(154, 240, 76, 40, t_med >= 0.5, LK_AMB, "MEDIUM") ? ( slider(3) = t_med >= 0.5 ? 0 : 1;  param_touched(3); );
lk_key(254, 240, 76, 40, t_treb >= 0.5, LK_AMB, "TREBLE") ? ( slider(4) = t_treb >= 0.5 ? 0 : 1;  param_touched(4); );
lk_key(354, 240, 76, 40, t_bril >= 0.5, LK_AMB, "BRILLIANT") ? ( slider(5) = t_bril >= 0.5 ? 0 : 1;  param_touched(5); );
gfx_setfont(13);  col(C_INK2, 1);  text_c(px(242), py(312), "STRINGS");
col(0xD9D2C2, 1);  u_rect(96, 324, 292, 30);  col(0x000000, 0.18);  u_rect(96, 324, 292, 2);  u_rect(96, 324, 2, 30);
g_j = 0;
loop(NV, led(114 + g_j * 23.3, 339, 5, min(1, VD[g_j]), 0x9FD05A);  g_j += 1; );

// ---------- STRING ----------
section(484, 86, 420, 290, "STRING");
kn(562, 186, 30, 7, 0, 100, 55, "ATTACK", 1);
klog = 1;  kn(694, 191, 26, 37, 50, 2000, 400, "BLOOM", 8);
kn(826, 186, 30, 6, 0, 100, 0, "MUTE", 1);
