wl_unit(16, 728, 1168, 172, C_SEC3);
section(16, 728, 1168, 172, "AMP  ·  VIBRATO CHANNEL");
gfx_setfont(13);  col(C_INK2, 1);  text_c(px(394), py(776), "CHANNEL");  text_c(px(758), py(776), "REVERB");  text_c(px(1028), py(776), "PAN / TREM");
led(970, 776, 6, am_on >= 0.5 ? av_lamp_d : 0, 0xFF5A3A);
col(C_INK2, 0.5);  u_rect(600, 774, 1, 108);  u_rect(916, 774, 1, 108);  u_rect(184, 774, 1, 108);
mk_key(64, 816, 84, 36, am_bri >= 0.5, "BRIGHT", "") ? ( slider(39) = am_bri >= 0.5 ? 0 : 1;  param_touched(39); );
kst = 3;  kn(250, 834, 22, 40, 0, 10, 4, "VOLUME", 9);
kst = 3;  kn(346, 834, 22, 41, 0, 10, 6, "TREBLE", 9);
kst = 3;  kn(442, 834, 22, 42, 0, 10, 5, "MIDDLE", 9);
kst = 3;  kn(538, 834, 22, 43, 0, 10, 4, "BASS", 9);
kst = 3;  kn(662, 834, 22, 44, 0, 4, 2, "REVERB", 9);
kst = 3;  kn(758, 834, 22, 45, 0, 10, 5, "DWELL", 9);
kst = 3;  kn(854, 834, 22, 46, 0, 10, 6, "TONE", 9);
kst = 3;  kn(980, 834, 22, 47, -100, 100, 0, "MODULATION", 10);
kst = 3;  klog = 1;  kn(1076, 834, 22, 48, 0.1, 12, 4.5, "RATE", 7);
am_on < 0.5 ? grey_out(16, 728, 1168, 172);
