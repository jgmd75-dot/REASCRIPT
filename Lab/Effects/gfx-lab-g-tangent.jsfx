mk_key(268, 458, 68, 34, fl_typ < 0.5, "UP", "") ? ( slider(18) = 0;  param_touched(18); );
mk_key(344, 458, 68, 34, fl_typ >= 0.5 && fl_typ < 1.5, "DOWN", "") ? ( slider(18) = 1;  param_touched(18); );
mk_key(420, 458, 68, 34, fl_typ >= 1.5, "WAH", "") ? ( slider(18) = 2;  param_touched(18); );
kst = 2;  kcap = 0x2D6A44;
fl_typ >= 1.5 ? kn(298, 548, 22, 22, 0, 100, 30, "PEDAL", 1) : kn(298, 548, 22, 19, 0, 100, 60, "SENS", 1);
kst = 2;  kcap = 0x2D6A44;  kn(378, 548, 22, 20, 0, 100, 55, "PEAK", 1);
kst = 2;  kcap = 0x2D6A44;  kn(458, 548, 22, 21, 0, 100, 60, "RANGE", 1);
gfx_setfont(13);  col(C_INK2, 1);  text_c(px(378), py(622), fl_typ >= 1.5 ? "PEDAL  (MOD WHEEL)" : "PEDAL  (WAH ONLY)");
col(C_BEZ, 1);  u_rect(288, 636, 180, 14);
fl_typ >= 1.5 ? ( col(0x9FD05A, 1);  u_rect(290, 638, 176 * max(0, min(1, wah_d)), 10); );
