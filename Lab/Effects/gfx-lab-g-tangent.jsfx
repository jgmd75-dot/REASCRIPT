led(845, 470, 6, ph_on >= 0.5 ? ph_ta_d : 0, 0x4A9CFF);  led(899, 470, 6, ph_on >= 0.5 ? ph_sa_d : 0, 0x6EE06A);
kst = 2;  kcap = 0x2D628B;  klog = 1;  kn(824, 548, 22, 29, 0.05, 8, 0.4, "RATE", 7);
kst = 2;  kcap = 0x2D628B;  kn(920, 548, 22, 30, 0, 100, 60, "DEPTH", 1);
kst = 2;  kcap = 0x2D628B;  kn(824, 640, 22, 31, 0, 90, 40, "FEEDBACK", 1);
