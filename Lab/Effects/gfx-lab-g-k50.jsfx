function grp_name(k) ( k == 0 ? "PIANOS & KEYS" : k == 1 ? "ORGANS" : k == 2 ? "MALLETS & BELLS" : k == 3 ? "GUITARS & PLUCKS" : k == 4 ? "PADS" : k == 5 ? "CHOIRS & VOICES" : k == 6 ? "STRINGS & ORCHESTRA" : k == 7 ? "BRASS" : k == 8 ? "LEADS & FLUTES" : k == 9 ? "BASSES" : k == 10 ? "FX" : "SPLITS"; );
function grp_menu(k) ( k == 0 ? "Pianos & Keys" : k == 1 ? "Organs" : k == 2 ? "Mallets & Bells" : k == 3 ? "Guitars & Plucks" : k == 4 ? "Pads" : k == 5 ? "Choirs & Voices" : k == 6 ? "Strings & Orchestra" : k == 7 ? "Brass" : k == 8 ? "Leads & Flutes" : k == 9 ? "Basses" : k == 10 ? "Fx" : "Splits"; );
function snd_pos(sn) local(i, q) ( q = 0; i = 0; loop(NSND, mord[i] == sn ? q = i; i += 1; ); q; );
function pos_grp(q) local(k, g) ( g = 0; k = 0; loop(NGRP, q >= GST[k] ? g = k; k += 1; ); g; );
// the sound list, grouped into sub-menus by type
function snd_menu(x, y) local(i, k, sel) (
  #sm = ""; i = 0;
  loop(NSND,
    k = pos_grp(i);
    i == GST[k] ? ( strcat(#sm, ">"); strcat(#sm, grp_menu(k)); strcat(#sm, "|"); );
    i == GST[k] + GSZ[k] - 1 ? strcat(#sm, "<");
    slider1 == mord[i] ? strcat(#sm, "!");
    strcat(#sm, sname(mord[i]));
    i < NSND - 1 ? strcat(#sm, "|");
    i += 1;
  );
  gfx_x = x; gfx_y = y; sel = gfx_showmenu(#sm);
  sel > 0 ? ( slider1 = mord[sel - 1]; slider_automate(1); );
);

// ---------- state ----------
ins_drift_init();
dgT.drift_init(0.9 + rand(0.3)); dgC.drift_init(1.1 + rand(0.3)); dg_top = 0; dg_ch = 0;
at_t = 0; at_s = 0; at_c = 1 - exp(-1 / (0.03 * srate));
ost_init(90000); ostL.ost_ch_init(); ostR.ost_ch_init();


fA1.svf_set(730, 5); fA2.svf_set(1090, 7); fA3.svf_set(2440, 9);
sm = 1 - exp(-1 / (0.03 * srate));
// per-patch level trim: keeps the hottest patches out of the output clipper (measured with 8 notes at full
// velocity, worst case held under -3 dBFS); the quieter patches are left as they are
function patch_trim(p) (
  p == 0 ? 0.582 :
  p == 1 ? 0.339 :
  p == 2 ? 0.359 :
  p == 3 ? 0.543 :
  p == 4 ? 0.376 :
  p == 5 ? 0.989 :
  p == 6 ? 0.468 :
  p == 7 ? 0.351 :
  p == 8 ? 0.473 :
  p == 9 ? 0.543 :
  p == 10 ? 0.708 :
  p == 11 ? 0.427 :
  p == 12 ? 0.822 :
  p == 13 ? 0.432 :
  p == 14 ? 0.631 :
  p == 15 ? 0.851 :
  p == 16 ? 1.000 :
  p == 17 ? 1.000 :
  p == 18 ? 0.335 :
  p == 19 ? 0.785 :
  p == 20 ? 1.000 :
  p == 21 ? 0.955 :
  p == 22 ? 0.316 :
  p == 23 ? 0.966 :
  p == 24 ? 1.122 :
  p == 25 ? 0.501 :
  p == 26 ? 0.363 :
  p == 27 ? 0.452 :
  p == 28 ? 0.822 :
  p == 29 ? 0.610 :
  p == 30 ? 0.407 :
  p == 31 ? 0.582 :
  p == 32 ? 0.359 :
  p == 33 ? 0.624 :
  p == 34 ? 0.716 :
  p == 35 ? 0.266 :
  p == 36 ? 2.018 :
  p == 37 ? 0.473 :
  p == 38 ? 1.230 :
  p == 39 ? 1.413 :
  p == 40 ? 2.188 :
  p == 41 ? 1.567 :
  p == 42 ? 0.575 :
  p == 43 ? 0.484 :
  p == 44 ? 0.420 :
  p == 45 ? 0.512 :
  p == 46 ? 0.531 :
  p == 47 ? 0.473 :
  p == 48 ? 0.519 :
  p == 49 ? 0.575 :
  p == 50 ? 0.575 :
  p == 51 ? 0.518 :
  p == 52 ? 0.417 :
  p == 53 ? 0.446 :
  p == 54 ? 0.372 :
  p == 55 ? 0.305 :
  p == 56 ? 0.363 :
  p == 57 ? 0.501 :
  p == 58 ? 0.335 :
  p == 59 ? 0.257 :
  p == 60 ? 0.302 :
  p == 61 ? 0.266 :
  p == 62 ? 0.624 :
  p == 63 ? 0.363 :
  p == 64 ? 0.417 :
  p == 65 ? 0.376 :
  p == 66 ? 1.230 :
  p == 67 ? 1.000 :
  p == 68 ? 1.175 :
  p == 69 ? 0.668 :
  p == 70 ? 0.617 :
  p == 71 ? 0.692 :
  p == 72 ? 0.724 :
  p == 73 ? 0.902 :
  p == 74 ? 0.473 :
  p == 75 ? 0.631 :
  p == 76 ? 0.582 :
  p == 77 ? 0.519 :
  p == 78 ? 1.084 :
  p == 79 ? 0.684 :
  p == 80 ? 0.785 :
  p == 81 ? 0.295 :
  p == 82 ? 1.216 :
  p == 83 ? 0.343 :
  p == 84 ? 0.603 :
  p == 85 ? 0.417 :
  p == 86 ? 0.966 :
  p == 87 ? 0.832 :
  p == 88 ? 1.216 :
  p == 89 ? 0.248 :
  p == 90 ? 0.977 :
  p == 91 ? 0.269 :
  p == 92 ? 1.778 :
  p == 93 ? 0.272 :
  p == 94 ? 0.452 :
  p == 95 ? 0.507 :
  1.000;
);
ptr_s = patch_trim(slider1);
pkL = 0; pkR = 0; pk_dec = exp(log(0.85) * 30 / srate); midi_led = 0; nact = 0; vph = 0; flph = 0;
!ui_dflt ? ui_thm = 10; !ui_dflt ? ui_hw = 1;  // fixed late-80s workstation faceplate
!ui_dflt ? ui_kstyle = 0;
!ui_dflt ? lx_page = 0;
kx_grp = 0; kx_lsnd = -1;                                // the panel opens on the SOUNDS page (EDITOR shows the controls)
BRW = 0x3A2E28; INKL = 0xE8DED2; TEAL = 0x2FB5A0; REDL = 0xFF3A2A;
SH1 = 0x463830; SH2 = 0x403229; SH3 = 0x372B24;       // macros, reverb, utility
function mgroup(x, y, w, h, sec, title, shade) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  pk_box(x * sc, y * sc, w * sc, h * sc, TEAL, title);
  ui_section(sec == 0 ? 2 : sec); C_INK = INKL;
);
snd = -1;
// the per-block coefficients of the sound (also run at once when a sound change applies in @sample)
function lx_coefs() (
  // envelope coefficients (with the ATTACK / RELEASE macros)
  a_inc = 1 / max(max(aA * atk_k, 0.003) * srate, 1);      // never faster than 3 ms (no click)
  fi_step = 1 / ((eng == 1 ? 0.003 : 0.002) * srate); dc_k = exp(-1 / (0.002 * srate));
  f_inc = 1 / max(max(fA * atk_k, 0.002) * srate, 1);
  a_dec = tc(aD); a_rel = tc(aR * rel_k);
  f_dec = tc(fD);
  gl_c = glide > 0 ? 1 - exp(-1 / (glide * srate)) : 1;
  fm_rel = tc(0.28 * rel_k); ks_damp = 0.6; gl_rel = tc(1.5 * rel_k); chf_d = tc(0.03);
  tone_oct = (tone - 0.5) * 3 + dg_top;            // TONE: +/- 1.5 octaves on filters / brightness (+ the digital drift)
  // output filter for the FM / string / bar sounds (FILTER 0 and no RESONANCE = bypassed)
  gf_on = eng != 0 && (filt_oct < -0.01 || reso > 0.005);
  gf_g = tan($pi * min(18000 * 2 ^ filt_oct, srate * 0.45) / srate); gf_k = 2 - 1.9 * reso;
  gf_a1 = 1 / (1 + gf_g * (gf_g + gf_k)); gf_a2 = gf_g * gf_a1; gf_a3 = gf_g * gf_a2;
  // analogue sounds: the knobs move each note's filter
  va_res = fres + reso * (1.02 - fres);
  pe_c = tc(pe_t); pn_damp = tc(0.18 * rel_k) ^ 0.5; pn_kd = tc(0.012); org_rel = tc(org_rt * rel_k); org_ai = 1 / (max(org_at * atk_k, 0.0005) * srate); org_ck = tc(0.004); lw_rel = tc(0.08 * rel_k); lw_ck = tc(0.004);
  (eng == 4 || eng == 5) ? ( pv = 0; loop(NV, VB[pv * VS + F_ACT] ? pn_norm(VB + pv * VS); pv += 1; ); );
);
// a sound change while voices sound: the old sound fades out (12 ms), the new one applies at the silent point and
// the output fades back in (12 ms), so nothing is cut dead; notes played during the fade start at that point
LXP = 7000; lx_pcf = 0; lx_pck = lx_pcg = 1; lx_pcn = 0; lx_pgo = 0;
function lx_hold(n, v) ( lx_pcn < 32 ? ( LXP[lx_pcn * 2] = n; LXP[lx_pcn * 2 + 1] = v; lx_pcn += 1; ); );
function lx_unhold(n) local(i, j) (
  i = j = 0; loop(lx_pcn, LXP[i * 2] != n ? ( LXP[j * 2] = LXP[i * 2]; LXP[j * 2 + 1] = LXP[i * 2 + 1]; j += 1; ); i += 1; ); lx_pcn = j;
);
function lx_pcapply() local(i) (
  lx_pgo = 1; update(); lx_coefs(); lx_pcf = 0;
  dl_len = min(floor(dl_bt * 60 / tempo * srate), 131000);       // (the echo time moves here too, while it is silent)
  i = 0; loop(lx_pcn, k_note_on(LXP[i * 2], LXP[i * 2 + 1]); i += 1; ); lx_pcn = 0;
);
update();
out_s = out_t;
ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme

@slider
update();

@block
evn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  stt = m1 & 0xF0; mch = (m1 & 0x0F) + 1;
  (chan == 0 || mch == chan) && evn < 512 ? (
    evq[evn * 4] = mofs; evq[evn * 4 + 1] = stt; evq[evn * 4 + 2] = m2; evq[evn * 4 + 3] = m3; evn += 1;
  );
  midisend(mofs, m1, m2, m3);
);
// transport stop: release whatever is still held (as an all-notes-off would; a safety net if the stop's note-offs go missing)
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( all_off(); lx_pcn = 0; );
gfx_pst_prev = gfx_pst;
evi = 0; spos = 0;
panic_dirty ? ( all_off(); panic_dirty = 0; );
lx_pcr = 1 / (0.012 * srate);
update();
ins_drift_block(drift, samplesblock);            // GFX instrument drift
pdrift = ins_pitch;
// the late-80s digital drift: the bright top and the chorus depth wander
dg_inc = 0.35 * samplesblock / srate * dm_s;
dg_top = dgT.drift_tick(dg_inc) * dm_a * 0.2; dg_ch = dgC.drift_tick(dg_inc) * dm_a * 0.25;
lx_coefs();
// tempo: the host's when playing, else free-running at its tempo
bt_inc = tempo / 60 / srate;
(play_state & 1) ? bt_pos = beat_position;
// echo time (beats)
dl_len = min(floor(dl_bt * 60 / tempo * srate), 131000);

@serialize
file_var(0, ui_sz);
file_var(0, lx_page);                                  // (appended: older states read on as the SOUNDS page)

@sample
while (evi < evn && (evq[evi * 4] <= spos || spos >= samplesblock - 1)) (   // (an event stamped at / past the block end: handled at its last sample)
  e1 = evq[evi * 4 + 1]; e2 = evq[evi * 4 + 2]; e3 = evq[evi * 4 + 3];
  e1 == 0x90 && e3 > 0 ? ( lx_pcf ? lx_hold(e2, e3) : k_note_on(e2, e3); midi_led = 1; ins_midi_hit(); ) :
  e1 == 0x80 || e1 == 0x90 ? ( lx_unhold(e2); k_note_off(e2); ) :
  e1 == 0xD0 ? at_t = e2 / 127 :                       // channel pressure
  e1 == 0xA0 ? at_t = e3 / 127 :                       // poly pressure (taken as the whole keyboard's)
  e1 == 0xB0 ? (
    e2 == 64 ? pedal_set(e3 >= 64);
    e2 == 1 ? modw = e3 / 127;
    e2 == 120 || e2 == 123 ? ( all_off(); lx_pcn = 0; );
  );
  evi += 1;
);
spos += 1;
lx_pcf ? ( lx_pck -= lx_pcr; lx_pck <= 0 ? ( lx_pck = 0; lx_pcapply(); ); lx_pcg = 0.5 - 0.5 * cos($pi * lx_pck); ) :
lx_pck < 1 ? ( lx_pck = min(lx_pck + lx_pcr, 1); lx_pcg = 0.5 - 0.5 * cos($pi * lx_pck); );

nz = rand(2) - 1;
at_s += (at_t - at_s) * at_c;                    // aftertouch, smoothed (30 ms)
vph += (vib > 0 ? vib : 5.5) / srate; vph >= 1 ? vph -= 1;
flph += 0.13 / srate; flph >= 1 ? flph -= 1;
// NATIVE DANCE: a 16-step log-drum pattern, retuned to each held note
nd ? (
  ndst = floor(bt_pos * 4) & 15;
  ndst != nd_last ? (
    nd_last = ndst;
    ndh = ndst == 0 || ndst == 3 || ndst == 6 || ndst == 8 || ndst == 10 || ndst == 11 || ndst == 14;
    ndh ? (
      ndr = ndst == 6 || ndst == 14 ? 1.5 : ndst == 10 ? 2 : ndst == 11 ? 0.75 : 1;
      nda = ndst == 0 || ndst == 8 ? 1 : 0.6;
      av = 0;
      loop(NV,
        b = VB + av * VS;
        b[F_ACT] && (b[F_G] || b[F_S]) ? (
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr,        b[F_VEL] * bl_lvl * nda, 0.22, 0);
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr * 2.76, b[F_VEL] * bl_lvl * nda * 0.35, 0.07, 1);
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr * 4.1,  b[F_VEL] * bl_lvl * nda * 0.15, 0.04, 2);
          b[F_CLK] = b[F_VEL] * 0.12 * nda;
        );
        av += 1;
      );
    ) : ndst % 2 == 1 ? (
      av = 0; loop(NV, b = VB + av * VS; b[F_ACT] && (b[F_G] || b[F_S]) ? b[F_CLK] = b[F_VEL] * 0.05; av += 1; );   // shaker ticks
    );
  );
);
bt_pos += bt_inc;
mix = 0; nact = 0;
av = 0;
loop(NV,
  b = VB + av * VS;
  b[F_ACT] ? (
    nact += 1;
    held = b[F_G] || b[F_S];
    y = 0;
    eng == 0 ? (
      // ---------- analogue voice ----------
      mono ? ( mono_f += (b[F_F0] - mono_f) * gl_c; f = mono_f; ) : f = b[F_F0];
      b[F_VT] = min(b[F_VT] + 1 / (0.6 * srate), 1);                         // delayed vibrato
      f *= b[F_DT] * pdrift * (1 + (vibd * 0.006 * b[F_VT] * (vib > 0) + (modw + at_v * at_s) * 0.008) * sin(2 * $pi * vph));
      b[F_PE] != 0 ? ( f *= 2 ^ (b[F_PE] / 12); b[F_PE] *= pe_c; abs(b[F_PE]) < 0.001 ? b[F_PE] = 0; );   // pitch envelope
      dt = f / srate;
      b[F_P1] += dt * (1 + det); b[F_P1] >= 1 ? b[F_P1] -= 1;
      b[F_P2] += dt * (1 - det); b[F_P2] >= 1 ? b[F_P2] -= 1;
      b[F_P3] += dt * 0.5;       b[F_P3] >= 1 ? b[F_P3] -= 1;
      x = (o1w == 2 ? sqw(b[F_P1], dt * (1 + det)) : o1w ? 1.2 * sin(2 * $pi * b[F_P1]) : saw(b[F_P1], dt * (1 + det))) + o2l * (o2w ? sqw(b[F_P2], dt) : saw(b[F_P2], dt * (1 - det))) + subl * sqw(b[F_P3], dt * 0.5);
      // envelopes
      held ? (
        b[F_AST] == 0 ? ( b[F_AE] += a_inc; b[F_AE] >= 1 ? ( b[F_AE] = 1; b[F_AST] = 1; ); ) : b[F_AE] = aS + (b[F_AE] - aS) * a_dec;
        b[F_FST] == 0 ? ( b[F_FE] += f_inc; b[F_FE] >= 1 ? ( b[F_FE] = 1; b[F_FST] = 1; ); ) : b[F_FE] = fS + (b[F_FE] - fS) * f_dec;
      ) : ( b[F_AE] *= a_rel; b[F_FE] *= a_rel; );
      // 4-pole filter
      fc = fbase * 2 ^ (famt * b[F_FE] * (vf > 0 ? (1 - vf) * (0.6 + 0.4 * b[F_VEL]) + vf * b[F_VEL] * b[F_VEL] * 1.2 : 0.6 + 0.4 * b[F_VEL]) + tone_oct + filt_oct + b[F_E1] + ins_cut + ktrk * log(f / 261.6) / log(2) + flfo * sin(2 * $pi * flph) + at_f * at_s);
      g = tan($pi * min(fc, srate * 0.42) / srate); gG = g / (1 + g);
      u = tanh_(x * 0.5 - va_res * 3.9 * b[F_S4]);
      v_ = (u - b[F_S1]) * gG; y1 = v_ + b[F_S1]; b[F_S1] = y1 + v_;
      v_ = (y1 - b[F_S2]) * gG; y2 = v_ + b[F_S2]; b[F_S2] = y2 + v_;
      v_ = (y2 - b[F_S3]) * gG; y3 = v_ + b[F_S3]; b[F_S3] = y3 + v_;
      v_ = (y3 - b[F_S4]) * gG; y4 = v_ + b[F_S4]; b[F_S4] = y4 + v_;
      y = y4 * b[F_AE] * b[F_VEL] * 2 * (1 + 0.8 * va_res) * vamix * (1 + at_l * at_s);
      // attack / extra layers
      bl_lvl > 0 ? y += 0.6 * bell_tick(b, held ? 1 : gl_rel) : bell_amp = 0;
      ks_lvl > 0 ? y += ks_tick(av, b, ks_pick, ks_bite) : b[F_O3] = 0;
      br_lvl > 0 || b[F_CLK] > 0.0005 ? (
        b[F_O1] += (nz - b[F_O1]) * 0.35; b[F_O2] += (b[F_O1] - b[F_O2]) * 0.03;      // breath band
        brp ? (
          // the pipes: breath through a narrow band an octave above the note (it sounds with the pipe, not as hiss);
          // the broad band only for the brief chiff
          bfc = 2 * sin($pi * min(f * 2, 6000) / srate);
          b[F_KLP] += bfc * b[F_KAP]; bfh = nz * br_lvl * b[F_AE] * b[F_VEL] - b[F_KLP] - 0.3 * b[F_KAP]; b[F_KAP] += bfc * bfh;
          y += b[F_KAP] * 0.8 + (b[F_O1] - b[F_O2]) * b[F_CLK];
        ) : y += (b[F_O1] - b[F_O2]) * (br_lvl * b[F_AE] * b[F_VEL] + b[F_CLK]);
        b[F_CLK] *= chf_d;
      );
      !held && b[F_AE] < 0.0003 && bell_amp < 0.0003 && b[F_O3] < 0.0002 ? (
        b[F_ACT] = 0; ks_lvl > 0 ? memset(KSB + av * KSL, 0, KSL);
      );
    ) : eng == 1 ? (
      // ---------- FM e-piano ----------
      f = b[F_F0] * pdrift * (1 + modw * 0.008 * sin(2 * $pi * vph));
      b[F_O1] += f / srate;          b[F_O1] -= floor(b[F_O1]);
      b[F_O2] += f / srate;          b[F_O2] -= floor(b[F_O2]);
      b[F_O3] += f * 1.0017 / srate; b[F_O3] -= floor(b[F_O3]);
      b[F_O4] += f * fm_tr / srate;     b[F_O4] -= floor(b[F_O4]);
      br = 2 ^ (tone_oct * 0.5);
      m2 = sin(2 * $pi * b[F_O2]) * b[F_E2] * br;
      m4 = sin(2 * $pi * b[F_O4]) * b[F_E4] * br;
      y = (0.62 * sin(2 * $pi * b[F_O1] + m2) * b[F_E1] + 0.42 * sin(2 * $pi * b[F_O3] + m4) * b[F_E3]);
      rm = held ? 1 : fm_rel;
      b[F_E1] *= b[F_MD] * rm; b[F_E2] *= b[F_MD + 1]; b[F_E3] *= b[F_MD + 2] * rm; b[F_E4] *= b[F_MD + 3];
      y *= 0.6;
      b[F_E1] + b[F_E3] < 0.0003 ? b[F_ACT] = 0;
    ) : eng == 4 ? (
      // ---------- synthetic piano ----------
      rm = held ? 1 : pn_damp;
      y = pn_tick(b, rm) * 0.5;
      b[F_CLK] > 0.0003 ? (                                    // knock: a low thud and a short click
        b[F_HN] += (nz - b[F_HN]) * 0.08; b[F_HL] += (b[F_HN] - b[F_HL]) * 0.02;
        y += (b[F_HN] - b[F_HL] * 0.6) * b[F_CLK]; b[F_CLK] *= pn_kd;
      );
      pn_amp < 0.0003 && b[F_CLK] < 0.0003 ? b[F_ACT] = 0;
    ) : eng == 5 ? (
      // ---------- drawbar organ ----------
      held ? b[F_AE] = min(b[F_AE] + org_ai, 1) : b[F_AE] *= org_rel;
      y = pn_tick(b, 1) * b[F_AE];
      b[F_CLK] > 0.0003 ? ( b[F_HN] += (nz - b[F_HN]) * 0.5; y += (nz - b[F_HN]) * b[F_CLK]; b[F_CLK] *= org_ck; );
      !held && b[F_AE] < 0.0003 ? b[F_ACT] = 0;
    ) : eng == 2 ? (
      // ---------- clav string ----------
      y = ks_tick(av, b, 1, 1);
      !held && b[F_O3] < 0.0002 ? ( b[F_ACT] = 0; memset(KSB + av * KSL, 0, KSL); );
    ) : (
      // ---------- glockenspiel bar ----------
      y = bell_tick(b, held ? 1 : gl_rel); amp = bell_amp;
      b[F_CLK] > 0.0005 ? ( b[F_KHP] += (nz - b[F_KHP]) * 0.45; y += (nz - b[F_KHP]) * b[F_CLK]; b[F_CLK] *= 0.993; );
      y *= 0.6;
      amp < 0.0003 && b[F_CLK] < 0.0005 ? b[F_ACT] = 0;
    );
    // de-click: fade-in for struck sounds, and any jump at a (re)start is smoothed over ~2 ms
    b[F_ATK] < 1 ? ( b[F_ATK] = min(b[F_ATK] + fi_step, 1); y *= b[F_ATK]; );
    b[F_DCF] ? ( b[F_DCO] = 2 * b[F_PY] - b[F_PY2] - y; b[F_DCF] = 0; );   // continue the waveform's own slope
    y += b[F_DCO]; b[F_DCO] *= dc_k;
    b[F_PY2] = b[F_PY]; b[F_PY] = y;
    mix += y;
  );
  av += 1;
);
mix *= lvl;
// ---------- the split's lower part ----------
spl_on ? (
  lwm = 0; av = 0;
  loop(LWN,
    b = LWB + av * VS;
    b[F_ACT] ? (
      nact += 1;
      held = b[F_G] || b[F_S];
      f = b[F_F0] * pdrift;
      lw_type <= 3 ? (
        y = ks_tick(LKV + av, b, lw_type >= 2, 0);
        b[F_P1] += f / srate; b[F_P1] -= floor(b[F_P1]);
        y += sin(2 * $pi * b[F_P1]) * b[F_AE]; b[F_AE] *= held ? b[F_MD] : lw_rel;
        b[F_CLK] > 0.0005 ? ( b[F_HN] += (nz - b[F_HN]) * 0.25; b[F_HL] += (b[F_HN] - b[F_HL]) * 0.05; y += (b[F_HN] - b[F_HL]) * b[F_CLK] * 2; b[F_CLK] *= lw_ck; );   // a band of noise: the thump / pop
        !held && b[F_O3] < 0.0002 && b[F_AE] < 0.0003 ? ( b[F_ACT] = 0; memset(KSB + (LKV + av) * KSL, 0, KSL); );
      ) : lw_type == 4 ? (
        b[F_O1] += f / srate;          b[F_O1] -= floor(b[F_O1]);
        b[F_O2] += f / srate;          b[F_O2] -= floor(b[F_O2]);
        b[F_O3] += f * 1.0017 / srate; b[F_O3] -= floor(b[F_O3]);
        b[F_O4] += f * 14 / srate;     b[F_O4] -= floor(b[F_O4]);
        y = 0.62 * sin(2 * $pi * b[F_O1] + sin(2 * $pi * b[F_O2]) * b[F_E2]) * b[F_E1] + 0.42 * sin(2 * $pi * b[F_O3] + sin(2 * $pi * b[F_O4]) * b[F_E4]) * b[F_E3];
        rm = held ? 1 : fm_rel;
        b[F_E1] *= b[F_MD] * rm; b[F_E2] *= b[F_MD + 1]; b[F_E3] *= b[F_MD + 2] * rm; b[F_E4] *= b[F_MD + 3];
        y *= 0.6;
        b[F_E1] + b[F_E3] < 0.0003 ? b[F_ACT] = 0;
      ) : (
        y = bell_tick(b, held ? 1 : gl_rel) * 0.6;
        b[F_CLK] > 0.0005 ? ( b[F_HN] += (nz - b[F_HN]) * 0.45; y += (nz - b[F_HN]) * b[F_CLK]; b[F_CLK] *= 0.99; );
        bell_amp < 0.0003 && b[F_CLK] < 0.0005 ? b[F_ACT] = 0;
      );
      b[F_ATK] < 1 ? ( b[F_ATK] = min(b[F_ATK] + fi_step, 1); y *= b[F_ATK]; );
      b[F_DCF] ? ( b[F_DCO] = 2 * b[F_PY] - b[F_PY2] - y; b[F_DCF] = 0; );
      y += b[F_DCO]; b[F_DCO] *= dc_k;
      b[F_PY2] = b[F_PY]; b[F_PY] = y;
      lwm += y;
    );
    av += 1;
  );
  mix += lwm * lw_lvl;
);
form ? (
  // "aah": three vocal formants
  fo1 = fA1.svf_bp(mix); fo2 = fA2.svf_bp(mix); fo3 = fA3.svf_bp(mix);
  mix = 0.25 * mix + 1.6 * fo1 + 1.1 * fo2 + 0.7 * fo3;
);
gf_on ? (
  gv3 = mix - gf2; gv1 = gf_a1 * gf1 + gf_a2 * gv3; gv2 = gf2 + gf_a2 * gf1 + gf_a3 * gv3;
  gf1 = 2 * gv1 - gf1; gf2 = 2 * gv2 - gf2;
  mix = gv2;
) : ( gf1 = 0; gf2 = 0; );

mix *= lx_pcg;                                   // (a sound change: the effects' inputs fade too, so no cut reaches them)
// chorus / three-phase ensemble
cbuf[cwp] = mix;
ca = chor * chor_k * (1 + dg_ch);
ca > 0.001 ? (
  cps += crate * (1 + 0.15 * ins_fx) / srate; cps >= 1 ? cps -= 1;
  cpf += 5.5 / srate; cpf >= 1 ? cpf -= 1;
  aj = 0; t0 = 0; t1 = 0; t2 = 0;
  loop(3,
    d_ = (0.007 + ((crate > 2 ? 0.0006 : 0.0017) * sin(2 * $pi * cps + aj * 2.0944) + (three ? 0.0004 * sin(2 * $pi * cpf + aj * 2.0944) : 0)) * min(ca, 1.5)) * srate;
    rp2 = cwp - d_; ri = floor(rp2); rf = rp2 - ri;
    tv = cbuf[ri & cmask] * (1 - rf) + cbuf[(ri + 1) & cmask] * rf;
    aj == 0 ? t0 = tv : aj == 1 ? t1 = tv : t2 = tv;
    aj += 1;
  );
  wet = min(ca, 1);
  oL = mix * (1 - 0.5 * wet) + wet * (t0 + 0.5 * t1) * 0.7;
  oR = mix * (1 - 0.5 * wet) + wet * (t2 + 0.5 * t1) * 0.7;
) : ( oL = mix; oR = mix; );
cwp = (cwp + 1) & cmask;
// tremolo (stereo, as an autopan)
trem > 0 ? ( trph += 4.6 / srate; trph -= floor(trph); tw = sin(2 * $pi * trph) * trem; oL *= 1 - tw; oR *= 1 + tw; );
// tempo-synced ping-pong echo
dl_mix > 0 || dl_tail > 0.00001 ? (
  drp = dl_w - dl_len; drp < 0 ? drp += 131072;
  dyL = DLB[drp]; dyR = DLB[131072 + drp];
  dlpL += (dyL - dlpL) * 0.35; dlpR += (dyR - dlpR) * 0.35;           // each repeat a little darker
  DLB[dl_w] = (oL + oR) * 0.5 * (dl_mix > 0) + dlpR * dl_fb;
  DLB[131072 + dl_w] = dlpL * dl_fb;
  dl_w = (dl_w + 1) % 131072;
  oL += dyL * dl_mix * 1.4; oR += dyR * dl_mix * 1.4;
  dl_tail = max(abs(dyL), abs(dyR)) * 0.001 + dl_tail * 0.999;
);

// ---------- reverb send ----------
rv_on || rv_tail > 0.00001 ? (
  rin = 0.5 * (oL + oR) * (rv_on ? 1 : 0);
  rpre_b[rpre_w] = rin;
  rq = rpre_w - floor(rpre); rq < 0 ? rq += rpre_len;
  rd = rpre_b[rq];
  rpre_w += 1; rpre_w >= rpre_len ? rpre_w = 0;
  ak = 0;
  loop(4,
    rn = floor(rapl[ak] * srate / 48000 * (0.6 + 0.4 * rdiff));
    ro = rap_b + ak * 4096; rw = rapw[ak];
    rr = rw - rn; rr < 0 ? rr += 4096;
    rbv = ro[rr]; ryv = -rdiff * 0.75 * rd + rbv; ro[rw] = rd + rdiff * 0.75 * ryv; rd = ryv;
    rapw[ak] = (rw + 1) % 4096;
    ak += 1;
  );
  ak = 0;
  loop(8,
    rlph[ak] += rlrt[ak] / srate; rlph[ak] >= 1 ? rlph[ak] -= 1;
    rm = rmod * srate * sin(2 * $pi * rlph[ak]);
    rp3 = rlw[ak] - rllen[ak] - rm; rp3 < 0 ? rp3 += RBLK;
    ri3 = floor(rp3); rf3 = rp3 - ri3; ro = rln_b + ak * RBLK;
    rv3 = ro[ri3 % RBLK] * (1 - rf3) + ro[(ri3 + 1) % RBLK] * rf3;
    rlz[ak] = rlgb[ak] * rv3 + rlga[ak] * rlz[ak];
    rtmp[ak] = rlz[ak];
    ak += 1;
  );
  ra0 = rtmp[0]; ra1 = rtmp[1]; ra2 = rtmp[2]; ra3 = rtmp[3]; ra4 = rtmp[4]; ra5 = rtmp[5]; ra6 = rtmp[6]; ra7 = rtmp[7];
  rb0 = ra0 + ra1; rb1 = ra0 - ra1; rb2 = ra2 + ra3; rb3 = ra2 - ra3; rb4 = ra4 + ra5; rb5 = ra4 - ra5; rb6 = ra6 + ra7; rb7 = ra6 - ra7;
  rc0 = rb0 + rb2; rc1 = rb1 + rb3; rc2 = rb0 - rb2; rc3 = rb1 - rb3; rc4 = rb4 + rb6; rc5 = rb5 + rb7; rc6 = rb4 - rb6; rc7 = rb5 - rb7;
  rmix[0] = (rc0 + rc4) * 0.35355339; rmix[1] = (rc1 + rc5) * 0.35355339; rmix[2] = (rc2 + rc6) * 0.35355339; rmix[3] = (rc3 + rc7) * 0.35355339;
  rmix[4] = (rc0 - rc4) * 0.35355339; rmix[5] = (rc1 - rc5) * 0.35355339; rmix[6] = (rc2 - rc6) * 0.35355339; rmix[7] = (rc3 - rc7) * 0.35355339;
  ak = 0;
  loop(8,
    ro = rln_b + ak * RBLK;
    ro[rlw[ak]] = rmix[ak] + rd * (ak & 1 ? -0.5 : 0.5);
    rlw[ak] += 1; rlw[ak] >= RBLK ? rlw[ak] = 0;
    ak += 1;
  );
  rvL = (ra0 - ra2 + ra4 - ra6 + 0.5 * (ra1 + ra5)) * 0.5;
  rvR = (ra1 - ra3 + ra5 - ra7 + 0.5 * (ra2 - ra6)) * 0.5;
  rv_tail = max(abs(rvL), abs(rvR)) * 0.001 + rv_tail * 0.999;
  oL += rvL * rv_wet * 0.6; oR += rvR * rv_wet * 0.6;
);

out_s += (out_t - out_s) * sm;
ptr_s = patch_trim(snd);                        // follows the sound in use at once (a sound change is a discrete event)
oL = ostL.ost_band((oL) * ptr_s * lx_pcg) * out_s;
oR = ostR.ost_band((oR) * ptr_s * lx_pcg) * out_s;
ins_stereo(oL, oR); ost_out(ins_sl, ins_sr);           // mono-maker / widener, then the output stage
spl0 = ost_l;
spl1 = ost_r;
pkL = max(pkL * pk_dec, abs(spl0)); pkR = max(pkR * pk_dec, abs(spl1));   // (the meters fall here: @gfx only reads them)

@gfx 960 620
ui_thm = 10; ui_hw = 1;
ui_begin(960, 620);

// ---------- helpers (design units x sc) ----------
function kx_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kx_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function kx_txt(x, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = x * sc; gfx_y = y * sc - h * 0.5; gfx_drawstr(t); );
function kx_rtxt(x, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = x * sc - w; gfx_y = y * sc - h * 0.5; gfx_drawstr(t); );
function kx_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// a section: recessed face, a 32-high title band (title on its centre line), content below
function kx_sect(x, y, w, h, t, shade) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  ui_col(ui_mix(shade, 0x000000, 0.25)); kx_r(x, y, w, 32);
  ui_col(TEAL); kx_r(x, y + 31, w, 2);
  gfx_setfont(6, "Trebuchet MS", 16 * sc, 'b'); ui_col(INKL); kx_txt(x + 14, y + 17, t);
);
gfx_setfont(9, "Trebuchet MS", 19 * sc, 'b');     // sound names
gfx_setfont(10, "Courier New", 16 * sc, 'b');     // sound numbers
gfx_setfont(11, "Trebuchet MS", 16 * sc, 'b');    // group names
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');    // small print

// ---------- chassis: dark brown workstation with teal accents ----------
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
pk_chassis(8 * sc, 4 * sc, 944 * sc, 610 * sc, BRW);
ui_col(TEAL); kx_r(8, 66, 944, 2);
ui_col(TEAL); gfx_circle(40 * sc, 35 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(BRW); ui_text(40 * sc, 30 * sc, "GFX");
gfx_setfont(6, "Trebuchet MS", 28 * sc, 'b'); ui_col(INKL); gfx_x = 66 * sc; gfx_y = 10 * sc; gfx_drawstr("K50");
gfx_setfont(12); ui_cola(INKL, 0.7); gfx_x = 67 * sc; gfx_y = 44 * sc; gfx_drawstr("DIGITAL SOUND WORKSTATION");
pk_led(148 * sc, 25 * sc, 4 * sc, ins_midi_lit() || nact > 0, REDL);
gfx_setfont(12); ui_col(INKL); kx_txt(158, 25, "MIDI IN");

// ---------- the sound bar: [PRESETS][◄][►][LCD: the sound's name] (a click on the LCD opens the list too) ----------
cur_pos = snd_pos(slider1); cur_grp = pos_grp(cur_pos);
slider1 != kx_lsnd ? ( kx_lsnd = slider1; kx_grp = cur_grp; );     // the SOUNDS page follows a sound change
ui_noled = 1; ui_button(266 * sc, 17 * sc, 64 * sc, 34 * sc, "PRESETS", 0, 1) ? snd_menu(266 * sc, 53 * sc);
ui_noled = 1; ui_button(334 * sc, 17 * sc, 24 * sc, 34 * sc, "◄", 0, 1) ? ( slider1 = mord[(cur_pos + NSND - 1) % NSND]; slider_automate(1); );
ui_noled = 1; ui_button(360 * sc, 17 * sc, 24 * sc, 34 * sc, "►", 0, 1) ? ( slider1 = mord[(cur_pos + 1) % NSND]; slider_automate(1); );
ui_noled = 0;
pk_lcd(390 * sc, 17 * sc, 290 * sc, 34 * sc, 1);
pk_lcdfont(7, 20 * sc); ui_col(pk_lcdc); kx_txt(402, 34, sname(slider1));
pressed && drag_id == 0 && kx_hov(390, 17, 290, 34) ? ( drag_id = -1; snd_menu(390 * sc, 53 * sc); );
// EDITOR: the sound-shaping controls on a page of their own (lit while open; press again for the sounds)
ui_button(690 * sc, 17 * sc, 88 * sc, 34 * sc, "EDITOR", lx_page, 1) ? lx_page = !lx_page;
pk_ledbtn(790 * sc, 20 * sc, 28 * sc, 28 * sc, 0, REDL) ? panic_dirty = 1;
gfx_setfont(12); ui_col(INKL); kx_txt(823, 34, "PANIC");
ui_size_picker(882 * sc, 25 * sc);

!lx_page ? (
  // ---------- SOUNDS: the groups down the left, the chosen group's sounds on the right ----------
  kx_sect(16, 80, 240, 524, "GROUPS", SH2);
  g_k = 0;
  loop(NGRP,
    g_y = 124 + g_k * min(46, 476 / NGRP);
    g_on = g_k == kx_grp; g_hv = kx_hov(26, g_y, 220, min(40, 476 / NGRP - 5));
    g_th = min(40, 476 / NGRP - 5);
    ui_col(g_on ? TEAL : g_hv ? 0x5A4A40 : 0x2A211C); kx_rr(26, g_y, 220, g_th, 4);
    !g_on ? ( ui_col(TEAL); kx_rr(26, g_y, 5, g_th, 2); );
    g_k == cur_grp && !g_on ? ( pk_led(232 * sc, (g_y + g_th * 0.5) * sc, 3.5 * sc, 1, TEAL); );
    gfx_setfont(11); ui_col(g_on ? 0x14100D : INKL); kx_txt(40, g_y + g_th * 0.5, grp_name(g_k));
    pressed && drag_id == 0 && g_hv ? ( drag_id = -1; kx_grp = g_k; );
    g_k += 1; );
  kx_sect(268, 80, 676, 524, grp_name(kx_grp), SH2);
  gfx_setfont(12); ui_cola(INKL, 0.7); kx_rtxt(930, 97, kx_grp == NGRP - 1 ? "LEFT HAND BELOW C4  -  RIGHT HAND FROM C4" : "CLICK A SOUND TO PLAY IT");
  g_i = 0;
  loop(GSZ[kx_grp],
    g_q = GST[kx_grp] + g_i;
    g_x = 280 + floor(g_i / 12) * 330;  g_y = 124 + (g_i % 12) * 39;
    g_on = mord[g_q] == slider1; g_hv = kx_hov(g_x, g_y, 322, 35);
    g_on ? ( ui_col(TEAL); kx_rr(g_x, g_y, 322, 35, 4); ) :
      g_hv ? ( ui_col(0x5A4A40); kx_rr(g_x, g_y, 322, 35, 4); ) :
      ( ui_col(0x2A211C); kx_rr(g_x, g_y, 322, 35, 4); );
    gfx_setfont(10); ui_col(g_on ? 0x14100D : ui_mix(INKL, BRW, 0.4)); sprintf(#lb_n, "%02d", g_q + 1); kx_txt(g_x + 12, g_y + 18, #lb_n);
    gfx_setfont(9); ui_col(g_on ? 0x14100D : INKL); kx_txt(g_x + 50, g_y + 18, sname(mord[g_q]));
    pressed && drag_id == 0 && g_hv ? ( drag_id = -1; slider1 = mord[g_q]; slider_automate(1); );
    g_i += 1; );
) : (
  // ---------- EDITOR: the controls (macros, reverb, drift, MIDI, master) ----------
  ui_col(0x1E1814); kx_rr(16, 80, 928, 40, 4);
  ui_col(TEAL); kx_rr(16, 80, 5, 40, 2);
  gfx_setfont(6, "Trebuchet MS", 18 * sc, 'b'); ui_col(INKL); kx_txt(32, 100, sname(slider1));
  gfx_setfont(12); ui_cola(INKL, 0.75); kx_rtxt(930, 100, "A NEW SOUND RESETS FILTER, RESO, TONE, ATTACK, RELEASE, CHORUS");

  // ---------- MACROS ----------
  kx_sect(16, 132, 928, 140, "MACROS", SH1);
  ui_section(2); C_INK = INKL;
  ui_knob(84 * sc,  214 * sc, 17, -6, 3, 0, 0, "FILTER", slider17 > -0.005 && slider17 < 0.005 ? "OPEN" : "%+.2f oct");
  ui_knob(196 * sc, 214 * sc, 18, 0, 100, 0, 0, "RESO", "%.0f%%");
  ui_knob(308 * sc, 214 * sc, 2, 0, 100, 50, 0, "TONE", "%.0f%%");
  ui_knob(420 * sc, 214 * sc, 3, 10, 400, 100, 1, "ATTACK", "%.0f%%");
  ui_knob(532 * sc, 214 * sc, 4, 10, 400, 100, 1, "RELEASE", "%.0f%%");
  ui_knob(644 * sc, 214 * sc, 5, 0, 200, 100, 0, "CHORUS", "%.0f%%");
  ui_knob(756 * sc, 214 * sc, 6, 0, 100, 70, 0, "VELOCITY", "%.0f%%");
  ui_knob(868 * sc, 214 * sc, 7, -50, 50, 0, 0, "TUNE", "%+.0f cents");

  // ---------- REVERB ----------
  kx_sect(16, 284, 928, 140, "REVERB", SH2);
  ui_section(2); C_INK = INKL;
  i = 0;
  loop(3,
    pk_ledbtn(40 * sc, (326 + i * 30) * sc, 28 * sc, 24 * sc, slider19 == i, TEAL) ? ( slider19 = i; slider_automate(262144); );
    gfx_setfont(11); ui_col(INKL); kx_txt(78, 338 + i * 30, i == 0 ? "ROOM" : i == 1 ? "HALL" : "PLATE");
    i += 1;
  );
  ui_knob(300 * sc, 366 * sc, 20, 0, 150, 15, 0, "PRE-DELAY", "%.0f ms");
  ui_knob(480 * sc, 366 * sc, 21, 0.2, 10, 2.2, 1, "DECAY", "%.2f s");
  ui_knob(660 * sc, 366 * sc, 22, 0, 100, 50, 0, "DAMPING", "%.0f%%");
  ui_knob(840 * sc, 366 * sc, 23, 0, 100, 25, 0, "MIX", "%.0f%%");

  // ---------- DRIFT ----------
  kx_sect(16, 436, 170, 168, "DRIFT", SH3);
  ui_section(2); C_INK = INKL;
  ui_knob(101 * sc, 516 * sc, 8, 0, 100, 50, 0, "DRIFT", "%.0f%%");

  // ---------- MIDI ----------
  kx_sect(198, 436, 360, 168, "MIDI", SH3);
  ui_section(2); C_INK = INKL;
  knob_step = 1;
  ui_knob(262 * sc, 516 * sc, 9, 0, 16, 0, 0, "CHANNEL", slider9 == 0 ? "OMNI" : "CH %.0f");
  knob_step = 0;
  pk_led(336 * sc, 486 * sc, 4 * sc, ins_midi_lit() || nact > 0, REDL);
  gfx_setfont(11); ui_col(INKL); kx_txt(348, 486, "MIDI IN");
  gfx_setfont(12); ui_cola(INKL, 0.85);
  kx_txt(330, 514, "CC64  SUSTAIN");  kx_txt(330, 536, "CC1  VIBRATO");
  kx_txt(330, 558, "AFTERTOUCH");
  ui_col(0x0A0807); kx_rr(436, 551, 104, 14, 3);
  ui_col(TEAL); kx_rr(438, 553, max(at_s, 0.0) * 100, 10, 2);       // pressure, as it arrives

  // ---------- MASTER ----------
  kx_sect(570, 436, 374, 168, "MASTER", SH3);
  ui_section(2); C_INK = INKL;
  ui_knob(690 * sc, 516 * sc, 10, -24, 12, 0, 0, "OUTPUT", "%.1f dB");
  mL.ui_ledm(860 * sc, 474 * sc, 16 * sc, 104 * sc, pkL);
  mR.ui_ledm(884 * sc, 474 * sc, 16 * sc, 104 * sc, pkR);
  gfx_setfont(12); ui_col(INKL); kx_txt(868, 592, "OUT");
);

// small rivets in the corners
ui_col(0x1A1410); gfx_circle(18 * sc, 14 * sc, 3 * sc, 1, 1); gfx_circle(942 * sc, 14 * sc, 3 * sc, 1, 1);
gfx_circle(18 * sc, 606 * sc, 3 * sc, 1, 1); gfx_circle(942 * sc, 606 * sc, 3 * sc, 1, 1);

pk_end();
ui_end();
