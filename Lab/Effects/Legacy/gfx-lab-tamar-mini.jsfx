desc:TAMAR Mini [channel strip] (GFX Lab)
//tags: channel strip tape drive eq optical compressor de-esser delay reverb width mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-thick, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-os, gfx-lab-bypass, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider33:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,2,1{1x,2x,4x}>-Oversampling
slider3:3<0,10,0.01>-Drive
slider4:0<0,1,1{Warm,Crisp}>-Drive character
slider5:20<20,250,1>-HPF (Hz)
slider6:30000<3000,30000,10>-LPF (Hz)
slider7:0<-16,16,0.1>-Low (dB)
slider8:0<-16,16,0.1>-Mid (dB)
slider9:880<110,8800,1>-Mid frequency (Hz)
slider10:0<-16,16,0.1>-High (dB)
slider11:0<0,10,0.01>-Opto peak reduction
slider12:0<-12,18,0.1>-Opto gain (dB)
slider13:0<0,1,1{Slow,Fast}>-Opto response
slider14:0<0,1,1{Off,On}>-Thick
slider15:0<0,100,1>-De-ess (%)
slider16:330<10,1000,1>-Delay time (ms)
slider17:30<0,95,1>-Delay feedback (%)
slider18:0<0,100,1>-Delay mix (%)
slider19:1<0,2,1{Room,Plate,Hall}>-Reverb mode
slider20:1.5<0.2,8,0.01>-Reverb decay (s)
slider21:0<0,100,1>-Reverb mix (%)
slider22:100<0,200,1>-Width (%)
slider23:0<-24,12,0.1>-Output (dB)
slider24:1<0,1,1{5 %,33 %}>-Drift
slider25:0<0,1,1{Shelf,Bell}>-Low shape
slider26:0<0,1,1{Shelf,Bell}>-High shape
slider27:0<0,1,1{Off,On}>-Delay sync
slider28:5<0,7,1{1/16,1/8T,1/8,1/4T,1/8D,1/4,1/4D,1/2}>-Delay division
slider30:0<0,100,1>-Saturation (%)
slider31:0<-24,24,0.1>-Trim (dB)
slider32:prs_sel=0<0,10,1{No preset,Init,Vocal Chain,Warm Vocal Room,Acoustic Guitar,Bass DI,Drum Bus Punch,Snare Crack,Wide Synth Pad,Slapback Vocal,Tape Lo-Fi}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(8321499135, v); );
function psw_allg(v) ( slider_show(8321499135, v); );
#ui_man = "gfx-lab-tamar-mini";
ext_noinit = 1;

function kn_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function kn_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function kn_db(d) ( exp(0.11512925464970228 * d); );
function kn_ldb(x) ( 20 * log10(max(x, 0.0000001)); );
function kn_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function kn_over(o, kw) ( o <= -kw * 0.5 ? 0 : o >= kw * 0.5 ? o : sqr(o + kw * 0.5) / (2 * kw); );
function kn_dry(m) ( min(1, 2 * (1 - m)); );
function kn_wet(m) ( min(1, 2 * m); );

function sv_set(f) instance(k, a1, a2, a3) local(g) (
  g = tan($pi * min(max(f, 5), 0.45 * srate) / srate); k = 1.41421356;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function sv_run(x) instance(k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  lp = v2; bp = v1; hp = x - k * v1 - v2;
);
function sv_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function sv_den() instance(ic1, ic2) ( ic1 = kn_tn(ic1); ic2 = kn_tn(ic2); );
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function bq_den() instance(x1, x2, y1, y2) ( x1 = kn_tn(x1); x2 = kn_tn(x2); y1 = kn_tn(y1); y2 = kn_tn(y2); );

function hd_eq(crisp, gm) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop) (
  emp.bq_set(3, 3000, 0.7, 4); dem.bq_set(3, 3000, 0.7, -4);
  crisp ? ( vpre.bq_set(3, 6000, 0.7, 5); vpost.bq_set(3, 6000, 0.7, -2); ) :
          ( vpre.bq_set(2, 1000, 0.7, 0); vpost.bq_set(2, 1000, 0.7, 0); );
  bump.bq_set(2, 70, 0.9, hd_bump);
  gap.bq_set(0, (crisp ? 21000 : 16000) * gm, 0.55, 0);
  dcb.bq_set(1, 10, 0.7, 0);
  lop.bq_set(0, 250, 0.6, 0);
);
function hd_sat(x, b) local(tb) ( tb = kn_tanh(b); (kn_tanh(hd_g * x + b) - tb) * hd_c; );
function hd_pre(x) instance(emp, vpre, lop, lo) (
  lo = lop.bq_run(x) * hd_lb;
  vpre.bq_run(emp.bq_run(x - lo)) * 0.5;
);
function hd_post(y, lod) instance(dem, vpost, bump, gap, dcb) (
  dcb.bq_run(gap.bq_run(bump.bq_run(vpost.bq_run(dem.bq_run(y * 2)) + lod * hd_lg)));
);
function hd_clr() instance(lo) (
  lo = 0; this.emp.bq_clr(); this.dem.bq_clr(); this.vpre.bq_clr(); this.vpost.bq_clr(); this.bump.bq_clr();
  this.gap.bq_clr(); this.dcb.bq_clr(); this.lop.bq_clr();
);
function hd_den() (
  this.emp.bq_den(); this.dem.bq_den(); this.vpre.bq_den(); this.vpost.bq_den(); this.bump.bq_den();
  this.gap.bq_den(); this.dcb.bq_den(); this.lop.bq_den();
);
function hd_law(d) (
  hd_g = 10 ^ (d * 2.2 / 20);
  hd_c = 0.25 / ((kn_tanh(hd_g * 0.125) - 0) - (kn_tanh(-hd_g * 0.125) - 0));
  hd_lb = (d / 10) ^ 1.2;
  hd_lg = sqrt(hd_g * hd_c);
  hd_bump = 1.5 * (1 - 0.5 * d / 10);
);
KN_LD = 64;
function ld_run(x, mem) instance(w) ( mem[w] = x; w = (w + 1) & (KN_LD - 1); mem[(w - 1 - kn_lat) & (KN_LD - 1)]; );

fz_C = 1400;
function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_run(x) instance(qA, qB, qC, qD, fhi, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = qA.fz_bm(x, fz_C);
  ha = abs(h); fhi += (ha - fhi) * (ha > fhi ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fhi, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (kn_tanh(2 * u) / 2 - u + 0.4 * u * u) * fhi;
  e = qD.fz_bm(qC.fz_bm(qB.fz_bm(e, fz_C + 5), fz_C + 10), fz_C + 15);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_dn() instance(fhi, fp, fe) ( fhi = kn_tn(fhi); fp = kn_tn(fp); fe = kn_tn(fe); );
function fz_clr() instance(qA, qB, qC, qD, fhi, fp, fe) ( qA.fz_bmz(); qB.fz_bmz(); qC.fz_bmz(); qD.fz_bmz(); fhi = fp = fe = 0; );
function fz_coef() local(fso) (
  fso = os_f * srate;
  fz_bqc(fz_C, 4, 3500, 0, 0.7071, fso); fz_bqc(fz_C + 5, 4, 5500, 0, 0.7071, fso);
  fz_bqc(fz_C + 10, 0, 8000, 4, 0.7, fso); fz_bqc(fz_C + 15, 2, 12000, -6, 0.7, fso);
  fz_a = 1 - exp(-1 / (0.003 * fso)); fz_r = 1 - exp(-1 / (0.12 * fso)); fz_w = 1 - exp(-1 / (0.06 * fso));
);
fz_o = fz_t = 0;
function tm_sat(x, b) instance(fz) local(y) ( y = hd_sat(x, b); fz_o > 0.0001 ? y += fz.fz_run(y); y; );

function op_run(l, r) instance(ms, of, osl) local(t, lv) (
  ms += kn_kms * (0.5 * (l * l + r * r) - ms);
  lv = 10 * log10(max(ms, 0.00000000001)) + 3;
  t = kn_over(lv - op_th, 12) * (2 / 3);
  of += (t > of ? op_ka : op_kf) * (t - of);
  osl += (t > osl ? op_ksa : 1 / (srate * (op_fast ? 0.5 : 1.2) * (0.8 + 0.12 * osl))) * (t - osl);
  min(0.8 * of + 0.2 * osl, 30);
);
function de_run(pk) instance(env, g) local(t) (
  env += (pk > env ? de_ka : de_kr) * (pk - env);
  t = min(max(kn_ldb(env) - de_th, 0) * 0.75, 20);
  g += (t > g ? de_ga : de_gr) * (t - g);
  g;
);

function kn_beats(i) ( i < 0.5 ? 0.25 : i < 1.5 ? 1 / 3 : i < 2.5 ? 0.5 : i < 3.5 ? 2 / 3 : i < 4.5 ? 0.75 : i < 5.5 ? 1 : i < 6.5 ? 1.5 : 2; );
function rg_rd(mem, n, w, d) local(p, i, f) (
  p = w - d; i = floor(p); f = p - i;
  mem[i & (n - 1)] * (1 - f) + mem[(i + 1) & (n - 1)] * f;
);
function dl_rd(mem, n, w, d) local(p, i, f, y0, y1, y2, y3, c1, c2, c3) (
  d = min(max(d, 1), n - 4);
  p = w - 1 - d; p < 0 ? p += n;
  i = floor(p); f = p - i;
  y0 = mem[i == 0 ? n - 1 : i - 1]; y1 = mem[i]; y2 = mem[(i + 1) % n]; y3 = mem[(i + 2) % n];
  c1 = 0.5 * (y2 - y0); c2 = y0 - 2.5 * y1 + 2 * y2 - 0.5 * y3; c3 = 0.5 * (y3 - y0) + 1.5 * (y1 - y2);
  ((c3 * f + c2) * f + c1) * f + y1;
);
function dl_sat(x) local(y) ( y = min(max(x, -3), 3); y * (27 + y * y) / (27 + 9 * y * y); );
function dl_tone(x) instance(lp, hp) ( lp += dl_klp * (x - lp); hp += kn_k88 * (lp - hp); lp - hp; );

function rv_mode(m) local(k, hall, room) (
  hall = m == 2; room = m == 0;
  k = 0;
  loop(8,
    rv_len[k] = srate * 0.001 * (hall ?
      (k == 0 ? 29.1 : k == 1 ? 34.7 : k == 2 ? 41.3 : k == 3 ? 47.9 : k == 4 ? 53.3 : k == 5 ? 61.7 : k == 6 ? 71.9 : 83.3) :
      room ?
      (k == 0 ? 4.3 : k == 1 ? 5.9 : k == 2 ? 7.1 : k == 3 ? 8.9 : k == 4 ? 10.3 : k == 5 ? 12.7 : k == 6 ? 14.9 : 17.3) :
      (k == 0 ? 11.3 : k == 1 ? 13.7 : k == 2 ? 16.1 : k == 3 ? 19.3 : k == 4 ? 22.7 : k == 5 ? 26.9 : k == 6 ? 31.3 : 37.1));
    k += 1;
  );
  rv_ap[0] = srate * 0.001 * (hall ? 7.3 : room ? 1.7 : 4.1); rv_ap[1] = srate * 0.001 * (hall ? 11.9 : room ? 2.9 : 5.3);
  rv_ap[2] = srate * 0.001 * (hall ? 8.9 : room ? 2.3 : 4.7); rv_ap[3] = srate * 0.001 * (hall ? 13.1 : room ? 3.7 : 6.1);
  rv_apg = hall ? 0.62 : room ? 0.6 : 0.72;
  rv_md = hall ? srate * 0.0004 : srate * 0.00008;
  rv_pre = srate * 0.001 * (hall ? 24 : room ? 3 : 11);
);
function rv_gains(t60, dmp) local(k) (
  k = 0; loop(8, rv_g[k] = 10 ^ (-3 * rv_len[k] / (max(t60, 0.1) * srate)); k += 1; );
  rv_kd = 1 - exp(-2 * $pi * min(16000 * (0.09 ^ dmp), 0.45 * srate) / srate);
);
function rv_apr(k, x) local(b, i, v, y) (
  b = MRV_AP + k * 8192;
  i = (rv_apw - floor(rv_ap[k])) & 8191;
  v = b[i]; y = v - rv_apg * x; b[rv_apw] = x + rv_apg * y;
  y;
);
function rv_run(l, r) local(k, b, v, a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7, c0, c1, c2, c3, c4, c5, c6, c7, hs, d) (
  l = rv_apr(1, rv_apr(0, l)); r = rv_apr(3, rv_apr(2, r));
  rv_apw = (rv_apw + 1) & 8191;
  rv_ph += rv_phi; rv_ph >= 1 ? rv_ph -= 1;
  k = 0;
  loop(8,
    b = MRV_LN + k * 32768;
    d = rv_len[k] + (k < 4 ? rv_md * (1 + sin(2 * $pi * (rv_ph + k * 0.25))) : 0);
    v = rg_rd(b, 32768, rv_w, d);
    rv_lp[k] += rv_kd * (v - rv_lp[k]);
    rv_v[k] = rv_lp[k] * rv_g[k];
    k += 1;
  );
  a0 = rv_v[0]; a1 = rv_v[1]; a2 = rv_v[2]; a3 = rv_v[3]; a4 = rv_v[4]; a5 = rv_v[5]; a6 = rv_v[6]; a7 = rv_v[7];
  b0 = a0 + a1; b1 = a0 - a1; b2 = a2 + a3; b3 = a2 - a3; b4 = a4 + a5; b5 = a4 - a5; b6 = a6 + a7; b7 = a6 - a7;
  c0 = b0 + b2; c1 = b1 + b3; c2 = b0 - b2; c3 = b1 - b3; c4 = b4 + b6; c5 = b5 + b7; c6 = b4 - b6; c7 = b5 - b7;
  hs = 0.35355339;
  MRV_LN[rv_w] = (c0 + c4) * hs + l * 0.5;
  (MRV_LN + 32768)[rv_w] = (c1 + c5) * hs + r * 0.5;
  (MRV_LN + 65536)[rv_w] = (c2 + c6) * hs - l * 0.5;
  (MRV_LN + 98304)[rv_w] = (c3 + c7) * hs - r * 0.5;
  (MRV_LN + 131072)[rv_w] = (c0 - c4) * hs + l * 0.5;
  (MRV_LN + 163840)[rv_w] = (c1 - c5) * hs + r * 0.5;
  (MRV_LN + 196608)[rv_w] = (c2 - c6) * hs - l * 0.5;
  (MRV_LN + 229376)[rv_w] = (c3 - c7) * hs - r * 0.5;
  rv_w = (rv_w + 1) & 32767;
  rv_l = 0.5 * (a0 - a2 + a4 + a6 - 0.6 * a1 + 0.6 * a7);
  rv_r = 0.5 * (a1 + a3 - a5 + a7 + 0.6 * a0 - 0.6 * a6);
);
function rv_den() local(k) ( k = 0; loop(8, rv_lp[k] = kn_tn(rv_lp[k]); k += 1; ); );

rv_len = 1000; rv_ap = 1010; rv_g = 1020; rv_lp = 1030; rv_v = 1040;
MLD = 1100;
MPR = 32768;
MRV_AP = 131072;
MRV_LN = 196608;
MDLY = 524288;

function tm_pa(drv, cr, hp, lp, lo, md, mf, hi) (
  slider3 = drv; slider4 = cr; slider5 = hp; slider6 = lp; slider7 = lo; slider8 = md; slider9 = mf; slider10 = hi;
);
function tm_pb(pk, og, fa, th, de) (
  slider11 = pk; slider12 = og; slider13 = fa; slider14 = th; slider15 = de;
);
function tm_pc(tm, fb, ec, md, dc, vb, wd, ou) (
  slider16 = tm; slider17 = fb; slider18 = ec; slider19 = md; slider20 = dc; slider21 = vb; slider22 = wd; slider23 = ou;
);
function load_preset(p) local(i) (
  p == 1 || p == 11 ? (
    tm_pa(3,   0,  20, 30000,  0,    0,    880,  0);  tm_pb(0, 0, 0, 0, 0);   tm_pc(330, 30, 0,  1, 1.5, 0,  100,  0);
  ) : p == 2 ? (
    tm_pa(2.5, 0,  99, 30000,  0,    2,   3300,  3);  tm_pb(4, 4, 0, 0, 53);  tm_pc(330, 30, 0,  1, 1.2, 14, 100,  0);
  ) : p == 3 ? (
    tm_pa(4.5, 0,  88, 16500,  1, -1.5,    440,  1);  tm_pb(5, 4, 0, 1, 59);  tm_pc(220, 18, 12, 2, 2.2, 22, 100,  0);
  ) : p == 4 ? (
    tm_pa(1.5, 1, 110, 30000, -1,   -3,    220, 2.5); tm_pb(3, 3, 1, 0, 0);   tm_pc(330, 30, 0,  1, 1.4, 16, 115,  0);
  ) : p == 5 ? (
    tm_pa(5.5, 0,  33,  7700,  2, -2.5,    330, -2);  tm_pb(5, 4, 0, 1, 0);   tm_pc(330, 30, 0,  1, 1.5, 0,  60,   0);
  ) : p == 6 ? (
    tm_pa(4,   0,  44, 30000, 2.5,  -2,    440,  2);  tm_pb(4, 3, 1, 1, 0);   tm_pc(330, 30, 0,  1, 0.8, 10, 105,  0);
  ) : p == 7 ? (
    tm_pa(6,   1, 110, 16500, 1.5,   3,   2200, 1.5); tm_pb(5, 4, 1, 0, 0);   tm_pc(330, 30, 0,  1, 1.1, 18, 100, -1);
  ) : p == 8 ? (
    tm_pa(2,   0,  99, 16500,  0,   -2,    330,  1);  tm_pb(3, 2, 0, 0, 0);   tm_pc(440, 35, 18, 2, 4.5, 30, 150, -1);
  ) : p == 9 ? (
    tm_pa(4,   0, 110, 30000,  0,    2,   3300,  2);  tm_pb(5, 4, 1, 0, 53);  tm_pc(110,  8, 22, 1, 1.5, 0,  100,  0);
  ) : p == 10 ? (
    tm_pa(8,   0, 220,  4400,  1,    3,   1650,  0);  tm_pb(5, 2, 0, 1, 0);   tm_pc(280, 45, 25, 1, 1.5, 0,  70,  -3);
  );
  p == 11 ? slider24 = 1;
  slider12 = 0; slider25 = 0; slider26 = 0; slider27 = 0; slider28 = 5; slider30 = 0; slider31 = 0;
  i = 3; loop(29, ui_auto(i); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function kn_osclr() (
  ouL.os_clr(); ouR.os_clr(); odL.os_clr(); odR.os_clr();
  memset(MLD, 0, 4 * KN_LD);
  fzL.fz_clr(); fzR.fz_clr();
);
function kn_reset() (
  kn_osclr(); memset(BY_BUF, 0, 2 * BY_N);
  memset(MPR, 0, 2 * 32768); memset(MRV_AP, 0, 4 * 8192); memset(MRV_LN, 0, 8 * 32768);
  memset(MDLY, 0, 2 * dly_n); memset(rv_lp, 0, 8);
  hL.hd_clr(); hR.hd_clr();
  hpL.sv_clr(); hpR.sv_clr(); lpL.sv_clr(); lpR.sv_clr(); deL.sv_clr(); deR.sv_clr();
  e1L.bq_clr(); e1R.bq_clr(); e2L.bq_clr(); e2R.bq_clr(); e4L.bq_clr(); e4R.bq_clr(); b1L.bq_clr(); b1R.bq_clr(); b4L.bq_clr(); b4R.bq_clr();
  tpL.lp = tpL.hp = tpR.lp = tpR.hp = 0;
  op.ms = op.of = op.osl = 0; de.env = de.g = 0; dc_xl = dc_yl = dc_xr = dc_yr = 0; rv_cold = dl_cold = 1;
  rv_hl = rv_hr = 0;
  kn_fi = 0;
);
function kn_drive() (
  hd_ct != hd_cc ? ( kn_dk = max(kn_dk - kn_dks, 0); kn_dk == 0 ? ( hd_cc = hd_ct; kn_gc = 7; kn_cr = 0; ); ) :
    kn_dk < 1 ? kn_dk = min(kn_dk + kn_dks, 1);
  os_gate();
  os_chg ? ( kn_osclr(); fz_coef(); os_hold += 2 * samplesblock; );
  kn_lat = os_lat(os_f);
  kn_pl = hL.hd_pre(kn_l); kn_pr = hR.hd_pre(kn_r);
  ouL.os_up(kn_pl); ouR.os_up(kn_pr);
  os_f == 1 ? (
    kn_yl = fzL.tm_sat(ouL.s0, hd_bl); kn_yr = fzR.tm_sat(ouR.s0, hd_br);
  ) : os_f == 2 ? (
    kn_a0 = fzL.tm_sat(ouL.s0, hd_bl); kn_a1 = fzL.tm_sat(ouL.s1, hd_bl);
    kn_b0 = fzR.tm_sat(ouR.s0, hd_br); kn_b1 = fzR.tm_sat(ouR.s1, hd_br);
    kn_yl = odL.os_dn(kn_a0, kn_a1, 0, 0); kn_yr = odR.os_dn(kn_b0, kn_b1, 0, 0);
  ) : (
    kn_a0 = fzL.tm_sat(ouL.s0, hd_bl); kn_a1 = fzL.tm_sat(ouL.s1, hd_bl); kn_a2 = fzL.tm_sat(ouL.s2, hd_bl); kn_a3 = fzL.tm_sat(ouL.s3, hd_bl);
    kn_b0 = fzR.tm_sat(ouR.s0, hd_br); kn_b1 = fzR.tm_sat(ouR.s1, hd_br); kn_b2 = fzR.tm_sat(ouR.s2, hd_br); kn_b3 = fzR.tm_sat(ouR.s3, hd_br);
    kn_yl = odL.os_dn(kn_a0, kn_a1, kn_a2, kn_a3); kn_yr = odR.os_dn(kn_b0, kn_b1, kn_b2, kn_b3);
  );
  kn_yl = hL.hd_post(kn_yl, lnA.ld_run(hL.lo, MLD)); kn_yr = hR.hd_post(kn_yr, lnB.ld_run(hR.lo, MLD + KN_LD));
  kn_l = lnC.ld_run(kn_l, MLD + 2 * KN_LD); kn_r = lnD.ld_run(kn_r, MLD + 3 * KN_LD);
  kn_dg = kn_dk * kn_dk * (3 - 2 * kn_dk);
  kn_l += kn_dg * (kn_yl - kn_l); kn_r += kn_dg * (kn_yr - kn_r);
  kn_og = os_g * os_g * (3 - 2 * os_g);
  kn_l *= kn_og; kn_r *= kn_og;
);

function kn_srinit() (
  kn_sr = srate;
  c_kn = kn_tc(30); c_sw = kn_tc(15); c_sl = kn_tc(180);
  kn_kms = kn_tc(5);
  kn_k88 = 1 - exp(-2 * $pi * 88 / srate);
  kn_k110 = 1 - exp(-2 * $pi * 110 / srate);
  de_ka = kn_tc(0.5); de_kr = kn_tc(40); de_ga = kn_tc(1); de_gr = kn_tc(60);
  kn_dks = 1 / (0.010 * srate);
  kn_fis = 1 / (0.01 * srate);
  kn_dcc = 1 - 2 * $pi * 5 / srate;
  dly_n = ceil(2.1 * srate) + 16; dly_w = 0;
  rv_mc = floor(min(max(slider19, 0), 2) + 0.5); rv_mode(rv_mc); rv_phi = 0.13 / srate;
  deL.sv_set(6600); deR.sv_set(6600);
  kn_reset(); kn_fi = 1;
  hd_law(slider3); hL.hd_eq(slider4 >= 0.5, 1); hR.hd_eq(slider4 >= 0.5, 1); hd_cc = slider4 >= 0.5;
  fz_coef();
  thk_init(); thk_lift = 3; thk_drv = 1.5; thk_asym = 0.12; thk_tr = 1.2; thk_trim = 0;
  ost_init(0);
);
os_design();
os_f = os_tf = os_f2n(slider2); os_base = 0;
kn_srinit();
os_gsetup();
kn_snap = 1; kn_dk = 1; rv_dk = 1;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_wu_loss = 0.8; pwr_wu_drv = 1.5; pwr_wu_lp = 8000; pwr_bloom = 0.15;
drL.drift_init(0.8 + rand(1) * 0.4); drR.drift_init(0.8 + rand(1) * 0.4);
dgL.drift_init(0.8 + rand(1) * 0.4); dgR.drift_init(0.8 + rand(1) * 0.4);
dwL.drift_init(0.8 + rand(1) * 0.4); dwR.drift_init(0.8 + rand(1) * 0.4);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(32, i != 32 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(2));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != kn_sr ? kn_srinit();
kn_now = time_precise();
kn_tp > 0 && kn_now - kn_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > kn_gpp && play_position - kn_gpp < 4 * kn_gpd + 0.05) ? kn_reset();
kn_tp = kn_now; kn_gpp = play_position; kn_gpd = samplesblock / srate;
kn_snap ? kn_sat = min(max(slider30, 0), 100) / 100;
kn_sat += (min(max(slider30, 0), 100) / 100 - kn_sat) * (1 - exp(-samplesblock / (0.03 * srate)));
kn_sat < 0.0005 && slider30 < 0.5 ? kn_sat = 0;
ost_setup(kn_sat, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider2); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider24 >= 0.5 ? 33 : 5);
kn_dra = dm_a;

t_hpf = log(min(max(slider5, 20), 250)); t_hpi = slider5 > 20.5;
t_lpf = log(min(max(slider6, 3000), 30000)); t_lpi = slider6 < 29500;
t_drv = min(max(slider3, 0), 10); hd_ct = slider4 >= 0.5;
kn_fp = min(max((t_drv - 3) / 7, 0), 1); fz_t = 0.33 * kn_fp * kn_fp * (3 - 2 * kn_fp);
t_lf = min(max(slider7, -16), 16); t_md = min(max(slider8, -16), 16); t_mdf = log(min(max(slider9, 110), 8800)); t_hf = min(max(slider10, -16), 16);
t_lb = slider25 >= 0.5; t_hb = slider26 >= 0.5;
op_th = -min(max(slider11, 0), 10) * 3; t_opg = kn_db(min(max(slider12, -12), 18) + 0.85 * min(max(slider11, 0), 10)); op_fast = slider13 >= 0.5;
op_ka = kn_tc(op_fast ? 4 : 18); op_kf = kn_tc(op_fast ? 50 : 140); op_ksa = kn_tc(op_fast ? 150 : 400);
kn_dea = min(max(slider15, 0), 100) / 100; t_dei = kn_dea > 0.004; de_th = -6 - 34 * kn_dea;
t_dlt = slider27 >= 0.5 ? min(kn_beats(slider28) * 60 / max(tempo, 20), 2) * srate : min(max(slider16, 10), 1000) * 0.001 * srate; t_dlf = min(max(slider17, 0), 95) / 100;
t_dlm = min(max(slider18, 0), 100) / 100; t_dli = t_dlm > 0;
rv_mt = floor(min(max(slider19, 0), 2) + 0.5); t_rvd = min(max(slider20, 0.2), 8);
t_rvm = min(max(slider21, 0), 100) / 100; t_rvi = t_rvm > 0;
kn_wn = min(max(slider22, 0), 200) / 200;
t_ws = 2 * kn_wn; t_wm = kn_wn <= 0.5 ? 1 : 1 - (kn_wn - 0.5);
