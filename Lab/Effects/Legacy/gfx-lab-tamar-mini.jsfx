function mg_rock(x, y, w, h, d, ca, cd, sa, sd) local(hov, hit, m, la, ld, i) (
  hov = mouse_x >= (x - 3) * sc && mouse_x < (x + w + 3) * sc && mouse_y >= (y - 3) * sc && mouse_y < (y + h + 3) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  m = x + w * 0.5;
  i = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x - 1 + i * 1.3, y + i * 1.6, w + 6, h + 6, 5); i += 1; );
  ui_cola(d ? cd : ca, 0.18); mg_rr(d ? m - 4 : x - 6, y - 6, w * 0.5 + 10, h + 12, 8);
