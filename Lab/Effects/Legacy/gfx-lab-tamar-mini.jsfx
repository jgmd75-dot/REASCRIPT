  ui_col(d ? 0x08302C : 0x221C2A); mg_ctxt(m + w * 0.25 + (d ? 1 : 0), y + h * 0.5 + (d ? 1 : 0), sd);
  hit;
);
function mg_rk(x0, w, y0, idx, ca, cd, sa, sd) local(d) (
  d = slider(idx) >= 0.5;
  mg_rock(x0 + w - 104, y0 + 12, 88, 22, d, ca, cd, sa, sd) ? ( slider(idx) = d ? 0 : 1; ui_auto(idx); );
);
function mg_modebox(x, y, w, h, idx) local(hov, v, r) (
  v = floor(min(max(slider(idx), 0), 2) + 0.5);
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  ui_col(0x0A080E); mg_rr(x - 1, y - 1, w + 2, h + 2, 4);
