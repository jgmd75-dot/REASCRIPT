@gfx 1060 355
ui_begin(1060, 355);
mk_face = 0x403549; mk_band = 0x29242C; mk_ink = 0xEDE6D3; mk_tab = 0xF0A63A; mk_acc = 0xF0A63A;
mk_sub = 0x504659; mk_sub2 = 0x433A4C; mk_ink2 = 0xB7AAD6;
ui_vu_dim = slider1 >= 0.5;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 14 * sc);
  mg_f13 = ui_fitarial(13, 12 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
