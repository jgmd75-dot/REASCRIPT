  gfx_setfont(12); ui_col(mk_ink); mg_ltxt(x + b + 36, y + b + 13, title); gfx_measurestr(title, tw, th);
  ui_col(mk_tab); mg_r(x + b + 36, y + b + 25, tw / sc, 3);
