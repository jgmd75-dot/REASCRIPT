kn_snap ? (
  g_hpf = t_hpf; g_hpi = t_hpi; g_lpf = t_lpf; g_lpi = t_lpi; g_drv = t_drv;
  g_lf = t_lf; g_lb = t_lb; g_hb = t_hb; g_md = t_md; g_mdf = t_mdf; g_hf = t_hf; g_opg = t_opg; g_dei = t_dei;
  g_dli = t_dli; g_dlt = t_dlt; g_dlf = t_dlf; g_dlm = t_dlm;
  g_rvi = t_rvi; g_rvd = t_rvd; g_rvm = t_rvm; g_ws = t_ws; g_wm = t_wm; g_out = t_out; g_trm = t_trm; fz_o = fz_t;
  kn_cr = 0;
);
kn_snap = 0;
hL.hd_den(); hR.hd_den(); hpL.sv_den(); hpR.sv_den(); lpL.sv_den(); lpR.sv_den(); deL.sv_den(); deR.sv_den();
e1L.bq_den(); e1R.bq_den(); e2L.bq_den(); e2R.bq_den(); e4L.bq_den(); e4R.bq_den(); b1L.bq_den(); b1R.bq_den(); b4L.bq_den(); b4R.bq_den();
fzL.fz_dn(); fzR.fz_dn();
rv_den(); op.ms = kn_tn(op.ms);
kn_go_d = max(kn_go_d, kn_gom); kn_gom = 0;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(slider(2));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
g_hpf += (t_hpf - g_hpf) * c_kn; g_hpi += (t_hpi - g_hpi) * c_sw; g_lpf += (t_lpf - g_lpf) * c_kn; g_lpi += (t_lpi - g_lpi) * c_sw;
g_drv += (t_drv - g_drv) * c_kn; fz_o += (fz_t - fz_o) * c_kn;
g_lf += (t_lf - g_lf) * c_kn; g_md += (t_md - g_md) * c_kn; g_mdf += (t_mdf - g_mdf) * c_kn; g_hf += (t_hf - g_hf) * c_kn;
g_lb += (t_lb - g_lb) * c_sw; g_hb += (t_hb - g_hb) * c_sw;
g_opg += (t_opg - g_opg) * c_kn; g_dei += (t_dei - g_dei) * c_sw;
g_dli += (t_dli - g_dli) * c_sw; g_dlt += (t_dlt - g_dlt) * c_sl; g_dlf += (t_dlf - g_dlf) * c_kn; g_dlm += (t_dlm - g_dlm) * c_kn;
g_rvi += (t_rvi - g_rvi) * c_sw; g_rvd += (t_rvd - g_rvd) * c_kn; g_rvm += (t_rvm - g_rvm) * c_kn;
g_ws += (t_ws - g_ws) * c_kn; g_wm += (t_wm - g_wm) * c_kn;
g_out += (t_out - g_out) * c_kn; g_trm += (t_trm - g_trm) * c_kn;

kn_cr <= 0 ? (
  kn_cr = 16;
  hpL.sv_set(exp(g_hpf)); hpR.k = hpL.k; hpR.a1 = hpL.a1; hpR.a2 = hpL.a2; hpR.a3 = hpL.a3;
  lpL.sv_set(exp(g_lpf)); lpR.k = lpL.k; lpR.a1 = lpL.a1; lpR.a2 = lpL.a2; lpR.a3 = lpL.a3;
  hd_law(g_drv);
  kn_v1 = drL.drift_tick(16 * 0.11 * dm_s / srate); kn_v2 = drR.drift_tick(16 * 0.11 * dm_s / srate);
  kn_v3 = dgL.drift_tick(16 * 0.07 * dm_s / srate); kn_v4 = dgR.drift_tick(16 * 0.07 * dm_s / srate);
  kn_v6 = dwL.drift_tick(16 * 0.6 * dm_s / srate); kn_v7 = dwR.drift_tick(16 * 0.5 * dm_s / srate);
  hd_bl = 0.06 * kn_dra * kn_v1; hd_br = 0.06 * kn_dra * kn_v2;
  kn_gc += 1; kn_gc >= 8 ? (
    kn_gc = 0;
    hL.hd_eq(hd_cc, 2 ^ (0.2 * kn_dra * kn_v3)); hR.hd_eq(hd_cc, 2 ^ (0.2 * kn_dra * kn_v4));
    e1L.bq_set(4, 99, 0.7, g_lf); b1L.bq_set(2, 99, 0.5 + 0.11 * abs(g_lf), g_lf); e2L.bq_set(2, exp(g_mdf), 0.5 + 0.11 * abs(g_md), g_md); e4L.bq_set(3, 7700, 0.7, g_hf); b4L.bq_set(2, 7700, 0.5 + 0.11 * abs(g_hf), g_hf);
    e1R.b0 = e1L.b0; e1R.b1 = e1L.b1; e1R.b2 = e1L.b2; e1R.a1 = e1L.a1; e1R.a2 = e1L.a2;
    e2R.b0 = e2L.b0; e2R.b1 = e2L.b1; e2R.b2 = e2L.b2; e2R.a1 = e2L.a1; e2R.a2 = e2L.a2;
    b1R.b0 = b1L.b0; b1R.b1 = b1L.b1; b1R.b2 = b1L.b2; b1R.a1 = b1L.a1; b1R.a2 = b1L.a2;
    b4R.b0 = b4L.b0; b4R.b1 = b4L.b1; b4R.b2 = b4L.b2; b4R.a1 = b4L.a1; b4R.a2 = b4L.a2;
    e4R.b0 = e4L.b0; e4R.b1 = e4L.b1; e4R.b2 = e4L.b2; e4R.a1 = e4L.a1; e4R.a2 = e4L.a2;
    rv_gains(g_rvd, 0.4);
    dl_klp = 1 - exp(-2 * $pi * min(1100 * (10 ^ 0.5), 0.45 * srate) / srate);
  );
);
kn_cr -= 1;

kn_l = spl0 * g_trm; kn_r = spl1 * g_trm;
pwr_in(kn_l, kn_r); kn_l = pwr_l; kn_r = pwr_r;
hpL.sv_run(kn_l); hpR.sv_run(kn_r);
kn_l += g_hpi * (hpL.hp - kn_l); kn_r += g_hpi * (hpR.hp - kn_r);
lpL.sv_run(kn_l); lpR.sv_run(kn_r);
kn_l += g_lpi * (lpL.lp - kn_l); kn_r += g_lpi * (lpR.lp - kn_r);
kn_drive();
kn_a = e1L.bq_run(kn_l); kn_b = b1L.bq_run(kn_l); kn_l = kn_a + g_lb * (kn_b - kn_a);
kn_a = e1R.bq_run(kn_r); kn_b = b1R.bq_run(kn_r); kn_r = kn_a + g_lb * (kn_b - kn_a);
kn_l = e2L.bq_run(kn_l); kn_r = e2R.bq_run(kn_r);
kn_a = e4L.bq_run(kn_l); kn_b = b4L.bq_run(kn_l); kn_l = kn_a + g_hb * (kn_b - kn_a);
kn_a = e4R.bq_run(kn_r); kn_b = b4R.bq_run(kn_r); kn_r = kn_a + g_hb * (kn_b - kn_a);

op_gr = op.op_run(kn_l, kn_r);
kn_g = kn_db(-op_gr) * g_opg;
kn_l *= kn_g; kn_r *= kn_g;
kn_gom = max(kn_gom, op_gr);
thk_proc(kn_l, kn_r, slider14 >= 0.5); kn_l = thk_l; kn_r = thk_r;
t_dei || g_dei > 0.00001 ? (
  deL.sv_run(kn_l); deR.sv_run(kn_r);
  de_gdb = de.de_run(max(abs(deL.hp), abs(deR.hp)));
  kn_g = kn_db(-de_gdb);
  kn_el = kn_l - deL.hp + deL.hp * kn_g; kn_er = kn_r - deR.hp + deR.hp * kn_g;
  kn_l += g_dei * (kn_el - kn_l); kn_r += g_dei * (kn_er - kn_r);
);

t_dli || g_dli > 0.00001 ? (
  dl_cold ? ( tpL.lp = tpL.hp = tpR.lp = tpR.hp = 0; g_dlt = t_dlt; dl_cold = 0; );
  kn_a = tpL.dl_tone(dl_sat(dl_rd(MDLY, dly_n, dly_w, g_dlt * (1 + 0.0015 * kn_dra * kn_v6))));
  kn_b = tpR.dl_tone(dl_sat(dl_rd(MDLY + dly_n, dly_n, dly_w, g_dlt * (1 + 0.0015 * kn_dra * kn_v7))));
  MDLY[dly_w] = kn_l + kn_a * g_dlf; (MDLY + dly_n)[dly_w] = kn_r + kn_b * g_dlf;
  dly_w += 1; dly_w >= dly_n ? dly_w = 0;
  kn_el = kn_l * kn_dry(g_dlm) + kn_a * kn_wet(g_dlm); kn_er = kn_r * kn_dry(g_dlm) + kn_b * kn_wet(g_dlm);
  kn_l += g_dli * (kn_el - kn_l); kn_r += g_dli * (kn_er - kn_r);
) : (
  MDLY[dly_w] = kn_l; (MDLY + dly_n)[dly_w] = kn_r; dly_w += 1; dly_w >= dly_n ? dly_w = 0; dl_cold = 1;
);
rv_hl += kn_k110 * (kn_l - rv_hl); rv_hr += kn_k110 * (kn_r - rv_hr);
MPR[rv_pw] = kn_l - rv_hl; (MPR + 32768)[rv_pw] = kn_r - rv_hr;
rv_pw = (rv_pw + 1) & 32767;
t_rvi || g_rvi > 0.00001 ? (
  rv_cold ? ( memset(MRV_AP, 0, 4 * 8192); memset(MRV_LN, 0, 8 * 32768); memset(rv_lp, 0, 8); rv_cold = 0; );
  rv_mt != rv_mc ? ( rv_dk = max(rv_dk - kn_dks, 0); rv_dk == 0 ? ( rv_mc = rv_mt; rv_mode(rv_mc); memset(MRV_AP, 0, 4 * 8192); memset(MRV_LN, 0, 8 * 32768); memset(rv_lp, 0, 8); kn_gc = 7; kn_cr = 0; ); ) :
    rv_dk < 1 ? rv_dk = min(rv_dk + kn_dks, 1);
  kn_a = rg_rd(MPR, 32768, rv_pw - 1, rv_pre); kn_b = rg_rd(MPR + 32768, 32768, rv_pw - 1, rv_pre);
  rv_run(kn_a * g_rvi, kn_b * g_rvi);
  kn_z = rv_dk * rv_dk * (3 - 2 * rv_dk);
  kn_el = kn_l * kn_dry(g_rvm) + rv_l * kn_wet(g_rvm) * kn_z; kn_er = kn_r * kn_dry(g_rvm) + rv_r * kn_wet(g_rvm) * kn_z;
  kn_l += g_rvi * (kn_el - kn_l); kn_r += g_rvi * (kn_er - kn_r);
) : ( rv_cold = 1; rv_dk = 1; rv_mc != rv_mt ? ( rv_mc = rv_mt; rv_mode(rv_mc); kn_gc = 7; ); );
kn_m = (kn_l + kn_r) * 0.5 * g_wm; kn_s = (kn_l - kn_r) * 0.5 * g_ws;
kn_l = kn_m + kn_s; kn_r = kn_m - kn_s;
kn_z = kn_l - dc_xl + kn_dcc * dc_yl; dc_xl = kn_l; dc_yl = kn_z; kn_l = kn_z;
kn_z = kn_r - dc_xr + kn_dcc * dc_yr; dc_xr = kn_r; dc_yr = kn_z; kn_r = kn_z;
pwr_out(kn_l, kn_r); kn_l = pwr_l; kn_r = pwr_r;
kn_l *= g_out; kn_r *= g_out;
kn_l != kn_l ? kn_l = 0; kn_r != kn_r ? kn_r = 0;
kn_fi < 1 ? (
  kn_fi = min(kn_fi + kn_fis, 1); kn_z = kn_fi * kn_fi * (3 - 2 * kn_fi);
  kn_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; kn_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  kn_l = kn_a + kn_z * (kn_l - kn_a); kn_r = kn_b + kn_z * (kn_r - kn_b);
);
