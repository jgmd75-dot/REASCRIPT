desc:Fullerton 65 [valve combo amp] (GFX Lab)
//tags: amp amplifier guitar combo valve tube stereo reverb spring tremolo vibrato clean keys cabinet
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-faceplate, gfx-lab-amp, gfx-lab-clip, gfx-lab-power
// (.jsfx-inc) in the same folder.
//
// FULLERTON 65. A stereo two-channel valve combo with two 12" speakers in an open-back cabinet, in the spirit of the
// mid-60s American black-panel 2x12 reverb combos: huge clean headroom, a sparkling top, a scooped middle, a long
// three-spring reverb and an optical tremolo (personal use; the sound is designed from scratch).
//
// SIGNAL FLOW (each side, L and R, runs its own complete, identical amp; MONO IN feeds both with L + R)
//   NORMAL channel:  input -> first 12AX7 stage (asymmetric triode curve, cathode-bypass shelf)
//     -> the passive TREBLE / BASS / MIDDLE tone stack (a third-order filter worked out from the parts: 250 pF,
//        100 nF and 47 nF, 250 k treble and bass pots, a 10 k middle pot, 100 k slope resistor; its natural mid
//        scoop included) -> VOLUME (1 M audio pot; BRIGHT = a 120 pF cap across it, strongest at low volume)
//     -> second 12AX7 stage -> the mixer.
//   VIBRATO channel: the same two stages and tone stack, then
//     REVERB: the send drives its own valve (a 12AT7 driver that saturates when hit hard) into a long tank of
//        three coupled springs (each a delay with a dispersive chirp in its loop: every round trip gets a little
//        more 'drip'; dark, about 2 s); the return is mixed by the REVERB pot into a third 12AX7 (the mixer stage)
//     -> the 'vibrato', which is really an optical TREMOLO: an oscillator (SPEED) flashes a lamp onto a light-
//        dependent resistor that shunts the signal (INTENSITY). The cell darkens quickly and recovers slowly, so the
//        throb is smooth and slightly asymmetric. STEREO TREM: the right side throbs in opposite phase.
//   JUMPER feeds the input to both channels (their outputs add up, in phase).
//   -> phase inverter (12AT7, long-tailed pair) -> four 6L6-style power valves in push-pull with negative feedback
//      (the loop worked out exactly: very clean up to full power, then a firm clip) and a gentle supply sag when
//      pushed -> output transformer -> SPEAKER: 12" open back, about 80 Hz - 5 kHz with a presence peak. The two
//      speakers are not quite the same (different cone / mic), and the two reverb tanks are tuned apart.
//   ANTI-ALIASING (the house drive standard): the amp runs at the host rate (no oversampling, no latency) with
//   first-order ADAA on every valve stage (both channels' triodes, the mixer, the reverb driver, the phase inverter)
//   and on the power stage (its closed feedback loop is one curve, a table, so the table's integral serves); each
//   valve's input gets a small pre-emphasis so the stages are driven as before, and a fixed post-shelf makes up the
//   rest of the anti-aliased stages' top-end droop. The drive-tracking pre-filter into the first valves eases the
//   lows below 150 Hz down by up to 1.5 dB as VOLUME rises; its low-pass stays at its top (near the Nyquist): this
//   amp's BRIGHT voicing drives the top octave into the valves, and pulling it down would change the break-up. The
//   valve curves are smooth (no hard knee), so there is no knee to track. The reverb tanks run at half the rate
//   (their springs are dark: nothing above about 4.3 kHz is lost).
// IN / OUT: INPUT trim (click the knob for the house GUARD), OUTPUT, band SAT (the output soft clip is always on).
// DRIFT (0 - 100 %, 50 % = standard): valve and supply wander. The valves' bias wanders (each side on its own),
//   the supply 'breathes' a little, the power valves drift out of balance, and the tremolo rate wanders slightly.
//   0 % = perfectly steady.
//
// MAINS / EQUATOR PROXIMITY (in the ? pop-up, gfx-lab-power): OFF / UK / US mains hum (very faint), power-supply
//   sag and ripple - the rails drop as you dig in (UK tight and quick, US looser and slower); and the warm-up: a cold
//   amp is a little duller, quieter and grittier, and settles as the valves warm (by 5 min at FAR).
//   Default OFF + NEAR = as before.
// GUI: drag a knob (SHIFT = fine, double-click = default, wheel); values show while a knob is touched.
//   The NORMAL / VIBRATO keys pick the channel (the input you plug into). S / M / L / ? = size and help.
//   Click the LCD (or PRESETS) for the preset list.

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-faceplate.jsfx-inc
import gfx-lab-amp.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-power.jsfx-inc

slider1:1<0,1,1{Normal,Vibrato}>-Channel
slider2:0<0,1,1{Off,On}>-Jumper (both channels)
slider3:4<1,10,0.1>-Normal volume
slider4:6<1,10,0.1>-Normal treble
slider5:5<1,10,0.1>-Normal middle
slider6:4<1,10,0.1>-Normal bass
slider7:0<0,1,1{Off,On}>-Normal bright
slider8:4<1,10,0.1>-Vibrato volume
slider9:6<1,10,0.1>-Vibrato treble
slider10:5<1,10,0.1>-Vibrato middle
slider11:4<1,10,0.1>-Vibrato bass
slider12:0<0,1,1{Off,On}>-Vibrato bright
slider13:3<1,10,0.1>-Reverb
slider14:5<1,10,0.1>-Speed
slider15:1<1,10,0.1>-Intensity
slider16:0<0,1,1{Off,On}>-Stereo tremolo
slider17:0<0,1,1{Off,On}>-Mono in
slider18:0<-24,12,0.1>-Input trim (dB)
slider19:0<0,1,1{Off,On}>-Input guard
slider20:50<0,100,1>-Drift (%)
slider21:0<-24,12,0.1>-Output (dB)
slider22:0<0,100,1>-Band sat (%)
slider23:30<0,100,1>-Bias (%)
slider24:120<40,400,1>-Sat low band (Hz)
slider25:6000<2000,16000,10>-Sat high band (Hz)
slider26:-0.3<-24,0,0.1>-Ceiling (dB)
slider27:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider28:prs_sel=0<0,12,1{No preset,Init,Sparkle Clean,Surf Reverb,Country Twang,Jazz Warm,Tremolo Ballad,Stereo Throb,Pushed Edge,Jumpered Fat,Keys Clean,Keys Trem,Edge of Breakup}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=4194304

@init
#ui_man = "gfx-lab-fullerton-65";                          // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function fl_p2(n) local(p) ( p = 1; while (p < n) ( p *= 2; ); p; );

// ---------- valve curves ----------
// a smooth saturator (rational, exactly 1 from |x| = 3) and its slope
function fl_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function fl_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
// triode: the grid-conduction side (positive) clips firmly at 1, the cutoff side runs softer and further (1.8)
function fl_tg(u) ( u >= 0 ? fl_th(u) : 1.8 * fl_th(u * 0.5555556) );
function fl_tgd(u) ( u >= 0 ? fl_thd(u) : fl_thd(u * 0.5555556) );
// antiderivatives (for the anti-aliasing): th = x / 9 + (8 / 3) x / (x^2 + 3), so its integral is x^2 / 18 +
// (4 / 3) ln(1 + x^2 / 3) up to |x| = 3, then 2.3483924 + (|x| - 3) (F(0) = 0); the triode's two sides scale it
function fl_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function fl_tgF(u) ( u >= 0 ? fl_F(u) : 3.24 * fl_F(u * 0.5555556) );
// a stage at operating point b: unity small-signal gain, nothing out at rest (inverting is done by the caller).
// First-order ADAA: y = (G(u) - G(u1)) / (u - u1) on u = x + b (the curve read at the midpoint when the two are within
// 1e-5); a new bias re-reads the last point on the shifted curve, so a DRIFT change never steps. The ADAA's top-end
// droop (half a sample's average) would also take the top out of what the next valve sees, so each stage's input
// gets a first-order pre-emphasis first, x + eb (x - x1): the valves are driven as they were at twice the rate.
function fl_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = fl_tgF(u1); b0 = b; g0 = fl_tg(b); n0 = 1 / max(fl_tgd(b), 0.05); );
function fl_strun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + fl_eb * (x - xp) + b0; xp = x; ga = fl_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : fl_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + fl_dn;                               // (+ a -360 dB whisper: no denormals)
);
// the long-tailed pair: nearly symmetric (ADAA the same way)
// back to rest (a stage switched out: when it comes back it starts from rest, not from a stale last point)
function fl_strest() instance(b0, u1, ga1, xp) ( u1 = b0; ga1 = fl_tgF(b0); xp = 0; );
function fl_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = fl_F(u1); b0 = b; g0 = fl_th(b); n0 = 1 / max(fl_thd(b), 0.05); );
function fl_syrun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + fl_eb * (x - xp) + b0; xp = x; ga = fl_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : fl_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + fl_dn;
);

// ---------- first-order sections (bilinear, c = 2 fs) ----------
function fl_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
// cathode bypass: the gain falls by F below fz (Rk Ck), a shelf between fz and F * fz
function fl_shset(fz, F, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * F;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function fl_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
function fl_lpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * min(f, 0.45 * fs);
  b0 = w / (c + w); b1 = b0; a1 = (w - c) / (c + w);
);
// VOLUME: a 1 M audio-taper pot (p = 0..1); BRIGHT = 120 pF from the top of the pot to the wiper, which works out as
// the pot's gain k plus (1 - k) of a high-pass at 1 / (2 pi tp), tp = Ra Rb C / (Ra + Rb): strongest at low volume.
// br (0..1) fades the cap in and out.
function fl_volset(p, br, fs) instance(k, hb0, ha1, kb) local(fr, Ra, Rb, tp, c, w) (
  fr = p <= 0 ? 0 : (10 ^ (2 * p) - 1) / 99;
  Rb = fr * 1000000; Ra = (1 - fr) * 1000000;
  k = fr; kb = br * (1 - fr);
  tp = max(Ra * Rb / (Ra + Rb + 1) * 0.00000000012, 0.0000000001);
  c = 2 * fs; w = 1 / tp;
  hb0 = c / (c + w); ha1 = (w - c) / (c + w);
);
function fl_volrun(x) instance(k, hb0, ha1, kb, x1, y1) local(h) (
  h = hb0 * (x - x1) - ha1 * y1; x1 = x; y1 = h;
  k * x + kb * h;
);

// ---------- the passive tone stack (third order, from the component values) ----------
// t, m, l = treble, middle, bass pot positions 0..1 (middle and bass audio taper)
function fl_tsset(t, m, l, fs) instance(b0, b1, b2, b3, a1, a2, a3)
  local(C1, C2, C3, R1, R2, R3, R4, nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  C1 = 0.00000000025; C2 = 0.0000001; C3 = 0.000000047;
  R1 = 250000; R2 = 250000; R3 = 10000; R4 = 100000;
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  b0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  b1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  b2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  b3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  a1 = k1 * q; a2 = k2 * q; a3 = k3 * q;
);
function fl_tsrun(x) instance(b0, b1, b2, b3, a1, a2, a3, x1, x2, x3, y1, y2, y3) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 + b3 * x3 - a1 * y1 - a2 * y2 - a3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);

// ---------- the power stage: push-pull pairs inside a negative-feedback loop ----------
// y = S * (th(A (u - B y) / S + d) - th(d)); S = the supply, d = the pairs' imbalance. With y = S Y, u = S U the loop
// reduces to one curve, Y = Q(U + d / A + B th(d)) - th(d), Q solving Q = th(A (U - B Q)): the closed loop worked out
// exactly once (a table, by bisection), so the feedback is exact and stable at any drive.
fl_paA = 8; fl_paB = 0.4; fl_qn = 4096; fl_qr = 4; fl_qs = (fl_qn - 1) / (2 * fl_qr);
function fl_qbuild() local(i, U, lo, hi, m) (
  i = 0;
  loop(fl_qn,
    U = -fl_qr + i / fl_qs; lo = -1; hi = 1;
    loop(44, m = 0.5 * (lo + hi); m - fl_th(fl_paA * (U - fl_paB * m)) > 0 ? hi = m : lo = m; );
    fl_qt[i] = 0.5 * (lo + hi);
    i += 1;
  );
);
// ... and its running integral (exact for the table read linearly): fl_qc[i] = Int Q from the bottom to point i
function fl_qint() local(i, h) (
  h = 1 / fl_qs; fl_qc[0] = 0; i = 0;
  loop(fl_qn - 1, fl_qc[i + 1] = fl_qc[i] + h * 0.5 * (fl_qt[i] + fl_qt[i + 1]); i += 1; );
);
// the antiderivative at p (in table points): inside the table a quadratic per cell, outside a straight continuation
function fl_qF(p) local(i, f, q) (
  p <= 0 ? fl_qt[0] * p / fl_qs : p >= fl_qn - 1 ? fl_qc[fl_qn - 1] + fl_qt[fl_qn - 1] * (p - fl_qn + 1) / fl_qs : (
    i = floor(p); f = p - i; q = fl_qt + i;
    fl_qc[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / fl_qs;
  );
);
function fl_qQ(p) local(i, q) ( p = min(max(p, 0), fl_qn - 1.001); i = floor(p); p -= i; q = fl_qt + i; q[0] + (q[1] - q[0]) * p; );
function fl_paset(d) instance(pd, t0, ofs, p1, f1) local(o) (
  pd = d; t0 = fl_th(d); o = d / fl_paA + fl_paB * t0; p1 += (o - ofs) * fl_qs; f1 = fl_qF(p1); ofs = o;
);
// anti-aliased: the closed loop is one static curve of U, so first-order ADAA runs on the table's integral (fl_qF)
function fl_pa(u) instance(y, sup, sbase, env, t0, ofs, p1, f1, xp) local(p, a, f, d) (
  p = u + fl_eb * (u - xp); xp = u;
  p = (p / sup + ofs + fl_qr) * fl_qs; f = fl_qF(p); d = p - p1;
  y = sup * ((abs(d) > 0.00001 ? (f - f1) / d * fl_qs : fl_qQ(0.5 * (p + p1))) - t0);
  p1 = p; f1 = f;
  // supply sag: only when the valves are pushed hard
  a = abs(y);
  env += (a - env) * (a > env ? fl_sga : fl_sgr);
  sup = sbase * (1 - 0.14 * min(max(env - 0.55, 0) * 2.2, 1));
  y;
);
// output transformer: the core saturates on flux (integrate, saturate, differentiate)
function fl_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * fl_xlk + x * fl_xc; s = fl_th(ph * 0.55) / 0.55; y = (s - sp * fl_xlk) / fl_xc; sp = s; y;
);

// ---------- one side of the amp (host rate): x in, the speaker drive out; rv = reverb return, tg = tremolo ----------
function fl_core(x, rv, tg) instance(v1a, cs1, ts1, vo1, v1b, hp1, v2a, cs3, ts2, vo2, v2b, hp2,
                                     v4b, hp3, pin, pa, ot, sacc, pf, nz, ne, non, von) local(n, v, u, m) (
  x = pf.clp_pf_run(x) + fl_dn;                        // the drive-tracking pre-filter (gfx-clip)
  n = 0;
  fl_nrun ? (                                          // NORMAL
    u = cs1.fl_1run(x * fl_kN);
    u = -70 * v1a.fl_strun(u);
    u = ts1.fl_tsrun(u);
    u = vo1.fl_volrun(u);
    n = -45 * v1b.fl_strun(u);
    n = hp1.fl_1run(n);
    // (the linear response of the VIBRATO side's extra stage, so both channels share one post-shelf)
    u = 0.5 * (n + nz); nz = n; n = u + fl_eb * (u - ne); ne = u;
    non = 1;
  ) : non ? (
    v1a.fl_strest(); v1b.fl_strest(); non = 0;         // (switched out: its valves back to rest, once)
  );
  v = 0;
  fl_vrun ? (                                          // VIBRATO
    u = cs3.fl_1run(x * fl_kV);
    u = -70 * v2a.fl_strun(u);
    u = ts2.fl_tsrun(u);
    u = vo2.fl_volrun(u);
    u = -45 * v2b.fl_strun(u);
    u = hp2.fl_1run(u);
    sacc += u * 0.5;                                   // the reverb send (its driver and the tank run at half the rate)
    // the mixer stage: the dry signal and the reverb return, then the optical cell
    v = -30 * v4b.fl_strun(u * 0.035 + rv * fl_rvg);
    v = hp3.fl_1run(v) * tg;
    v = -v;                                            // polarity matched to NORMAL, so JUMPER adds up
    von = 1;
  ) : von ? (
    v2a.fl_strest(); v2b.fl_strest(); v4b.fl_strest(); von = 0;
  );
  m = (n + v) * 0.026;                                 // the mixing resistors into the phase inverter
  m = pin.fl_syrun(m);
  m = pa.fl_pa(m);
  ot.fl_ot(m);
);

// the reverb send (half rate): a 12AT7 driver that saturates when hit hard, then the tank's input transducer
function fl_send(x) instance(sh1, sl0, drv, sl1, sh2) (
  x = sl0.fl_1run(sh1.fl_1run(x * fl_ksend));
  sh2.am_run(sl1.am_run(drv.fl_strun(x)));
);

// ---------- reverb tank: three springs, each a delay with a low-pass and a dispersive chirp in its loop ----------
// the springs' memory and state: fl_tb (buffers), fl_tn (lengths), fl_tgk (loop gains), fl_tab (chirp buffers), fl_tst
function fl_sread(i) local(b, s, st, v) (
  b = fl_tb[i]; s = b[(fl_tw - fl_tn[i]) & fl_tm];
  st = fl_tst + i; st[0] += (s - st[0]) * fl_tlc; s = st[0];
  b = fl_tab[i] + fl_tp;
  loop(6, st = b[0]; v = s - fl_ta * st; s = fl_ta * v + st; b[0] = v; b += fl_tK; );
  s;
);
function fl_swrite(i, v) local(b) ( b = fl_tb[i]; b[fl_tw] = min(max(v + fl_dn, -3), 3); );
// the springs are coupled through the tank (an orthogonal mix): the first echoes stay clear, the tail thickens
function fl_tank(x, k) instance(lo, hi) local(s0, s1, s2, m, o) (
  s0 = fl_sread(k); s1 = fl_sread(k + 1); s2 = fl_sread(k + 2);
  o = s0 - s1 + 0.9 * s2;
  m = (s0 + s1 + s2) * 0.6666667;
  fl_swrite(k, x + fl_tgk[k] * (s0 - m)); fl_swrite(k + 1, x + fl_tgk[k + 1] * (s1 - m)); fl_swrite(k + 2, -x + fl_tgk[k + 2] * (s2 - m));
  lo += (o - lo) * fl_tol;                             // the output transducer: dark, no boom
  hi += (lo - hi) * fl_toh;
  (lo - hi) * fl_trg;
);

// ---------- the speakers: one 12" each side, open back, not quite matched ----------
function fl_cabset(side) instance(c1, c3, c4, c5, c6, c7) local(lp) (
  side == 0 ? (                                        // left: the warmer cone, mic near the cap
    c1.am_bq(1, 88, 1.25, 0, srate);                    // open back: the low end rolls off under the cone's resonance bump
    c3.am_bq(2, 480, 0.9, -2.5, srate); c4.am_bq(2, 2400, 1.4, 3.5, srate); lp = 5200; c7.am_bq(2, 7600, 2.2, -8, srate);
  ) : (                                                // right: a brighter cone, mic a little off axis
    c1.am_bq(1, 92, 1.35, 0, srate);
    c3.am_bq(2, 560, 1.0, -2.0, srate); c4.am_bq(2, 3000, 1.7, 4.0, srate); lp = 5700; c7.am_bq(2, 8200, 2.2, -7, srate);
  );
  c5.am_bq(0, lp, 0.5412, 0, srate); c6.am_bq(0, lp, 1.3066, 0, srate);
);
function fl_cabrun(x) instance(c1, c3, c4, c5, c6, c7) (
  c7.am_run(c6.am_run(c5.am_run(c4.am_run(c3.am_run(c1.am_run(x))))));
);

// ---------- memory and everything that depends on the sample rate ----------
function fl_trow(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = fl_trt + k; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function fl_trim(v, br) local(i, f, a, b) (
  v = min(max(v, 0), 10); i = min(floor(v), 9); f = v - i;
  a = fl_trt[i] * (1 - f) + fl_trt[i + 1] * f; b = fl_trt[11 + i] * (1 - f) + fl_trt[12 + i] * f;
  a + (b - a) * br;
);
function fl_mem() local(i, n) (
  nextmem = 0;
  fl_tsz = fl_p2(0.08 * srate); fl_tm = fl_tsz - 1;
  fl_tK = max(1, floor(0.5 * srate / 8600 + 0.5));     // the chirp: dispersion up to about 4.3 kHz (the tanks: half rate)
  fl_tb = alloc(6); fl_tn = alloc(6); fl_tgk = alloc(6); fl_tab = alloc(6); fl_tst = alloc(6);
  i = 0; loop(6, fl_tb[i] = alloc(fl_tsz); fl_tab[i] = alloc(6 * fl_tK); i += 1; );
  fl_qt = alloc(fl_qn + 1); fl_qc = alloc(fl_qn + 1);
  // the level trim: pushed (and with BRIGHT on most of all) the host-rate amp comes out a little louder than the
  // former 2x amp did - the anti-aliased valves take less of the very top into their clipping - and this takes it
  // back: dB at VOLUME 0, 1 .. 10, BRIGHT off / on (measured on pink noise at -21 dBFS RMS)
  fl_trt = alloc(22);
  fl_trow(0, 0, 0, 0, 0, 0, 0, 0, 0.2, 0.33, 0.4, 0.46);
  fl_trow(11, 0, 0, 0.21, 0.48, 1.14, 1.5, 1.32, 1.03, 0.75, 0.6, 0.47);
  ost_init(alloc(4096));
);
// the fixed filters of one side (fs2: the amp's rate - the host rate; fsh: the tanks' rate - half of it)
function fl_fix(fs2, fsh) instance(cs1, hp1, cs3, hp2, sh1, sl0, sl1, sh2, hp3, pa, pf) (
  cs1.fl_shset(4.2, 1.9, fs2); hp1.fl_hpset(16, fs2);           // the first stage's cathode bypass (1.5 k, 25 uF)
  cs3.fl_shset(4.2, 1.9, fs2); hp2.fl_hpset(16, fs2);
  sh1.fl_hpset(260, fsh); sl0.fl_lpset(7000, fsh); sl1.am_bq(0, 4800, 0.7, 0, fsh); sh2.am_bq(1, 380, 0.7, 0, fsh);
  hp3.fl_hpset(14, fs2);
  pa.sup = 1; pa.sbase = 1;
  pf.clp_pf_cfg(40000, 40000, -1.5, 150); pf.clp_pf_reset();    // the house pre-filter: 40 kHz (capped), -1.5 dB lows
);

function fl_srinit() local(i, ms, fs2, fsh) (
  fl_sr = srate; fs2 = srate; fsh = 0.5 * srate;       // the amp at the host rate (anti-aliased), the tanks at half
  // spring lengths (ms): left tank, right tank (tuned apart so the two sides decorrelate)
  i = 0;
  loop(6,
    ms = i == 0 ? 33.1 : i == 1 ? 38.9 : i == 2 ? 45.7 : i == 3 ? 35.3 : i == 4 ? 41.3 : 47.9;
    fl_tn[i] = floor(ms * 0.001 * fsh);
    fl_tgk[i] = 10 ^ (-3 * (ms + 3) * 0.001 / 3.5);       // about 2.1 s, with the loop losses
    i += 1;
  );
  fl_ta = 0.75;                                        // six stretched allpasses per loop: about 5 ms of chirp per trip
  fl_tlc = 1 - exp(-2 * $pi * 4200 / fsh);
  fl_tol = 1 - exp(-2 * $pi * 3000 / fsh); fl_toh = 1 - exp(-2 * $pi * 180 / fsh);
  fl_trg = 1.0;
  fl_tw = 0; fl_tp = 0; fl_tph = 0;
  memset(fl_tst, 0, 6);
  // the amp
  cL.fl_fix(fs2, fsh); cR.fl_fix(fs2, fsh);
  // the fixed post-shelf: makes up what is left of the anti-aliased stages' top-end droop (each stage's input gets a
  // first-order pre-emphasis, fl_eb, so the valves see the top end as before; fitted so the small-signal response at
  // the default settings matches the former 2x amp within 0.02 dB from 500 Hz to 12 kHz)
  kL1.am_bq(2, 0.1875 * srate, 0.336, -0.436, srate); kR1.am_bq(2, 0.1875 * srate, 0.336, -0.436, srate);
  kL2.am_bq(2, 0.2674 * srate, 2.097, 3.834, srate); kR2.am_bq(2, 0.2674 * srate, 2.097, 3.834, srate);
  kL3.am_bq(3, 0.20319 * srate, 0.882, 2.015, srate); kR3.am_bq(3, 0.20319 * srate, 0.882, 2.015, srate);
  fl_xc = 2 * $pi * 40 / fs2; fl_xlk = 1 - 2 * $pi * 5 / fs2;
  fl_sga = 1 - exp(-1 / (0.012 * fs2)); fl_sgr = 1 - exp(-1 / (0.16 * fs2));
  cabL.fl_cabset(0); cabR.fl_cabset(1);
  fl_smk = 1 - exp(-1 / (0.02 * srate));
  fl_ldra = 1 - exp(-1 / (0.004 * srate)); fl_ldrr = 1 - exp(-1 / (0.045 * srate));
  fl_vhold = floor(5 * srate);
  in_init(); in_setup(0, 0);
  fl_lts = -1;
);
// ---------- settings ----------
fl_kin = 1 / 1.3;                                      // input (0 dBFS = about 1 V at the jack) to the first grid

fl_eb = 0.25;                                          // the valves' pre-emphasis (see fl_strun)
fl_ksend = 0.05;
function update() (
  fl_gNt = slider2 >= 0.5 || slider1 < 0.5 ? 1 : 0;
  fl_gVt = slider2 >= 0.5 || slider1 >= 0.5 ? 1 : 0;
  fl_mt = slider17 >= 0.5;
  fl_stt = slider16 >= 0.5;
  fl_rate = 1.5 * 6 ^ ((slider14 - 1) / 9);            // SPEED: 1.5 - 9 Hz
  fl_Dt = 10 * sqr((slider15 - 1) / 9);                 // INTENSITY: the cell's pull (up to about -21 dB)
  fl_rvt = 1.5 * ((slider13 - 1) / 9) ^ 1.6;            // REVERB pot
  in_setup(slider18, slider19);
  drift_macro(slider20);
  fl_ot_ = 10 ^ (slider21 / 20) * fl_kout;
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, slider26, 1);   // output stage: CLIP, always on
);
fl_kout = 0.75;

// the tone stacks, VOLUME and BRIGHT follow the knobs smoothly (recomputed every block from glided values)
function fl_tone(force) local(k, ch) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  fl_s3 += (slider3 - fl_s3) * k; fl_s4 += (slider4 - fl_s4) * k; fl_s5 += (slider5 - fl_s5) * k; fl_s6 += (slider6 - fl_s6) * k;
  fl_s7 += ((slider7 >= 0.5) - fl_s7) * k;
  fl_s8 += (slider8 - fl_s8) * k; fl_s9 += (slider9 - fl_s9) * k; fl_s10 += (slider10 - fl_s10) * k; fl_s11 += (slider11 - fl_s11) * k;
  fl_s12 += ((slider12 >= 0.5) - fl_s12) * k;
  fl_rvg += (fl_rvt - fl_rvg) * k;
  ch = fl_s3 + 2 * fl_s4 + 3 * fl_s5 + 5 * fl_s6 + 7 * fl_s7 + 11 * fl_s8 + 13 * fl_s9 + 17 * fl_s10 + 19 * fl_s11 + 23 * fl_s12;
  force || abs(ch - fl_lts) > 0.00001 ? (
    fl_lts = ch;
    cL.ts1.fl_tsset((fl_s4 - 1) / 9, (fl_s5 - 1) / 9, (fl_s6 - 1) / 9, srate);
    cL.ts2.fl_tsset((fl_s9 - 1) / 9, (fl_s10 - 1) / 9, (fl_s11 - 1) / 9, srate);
    cL.vo1.fl_volset((fl_s3 - 1) / 9, fl_s7, srate);
    cL.vo2.fl_volset((fl_s8 - 1) / 9, fl_s12, srate);
    cR.ts1.b0 = cL.ts1.b0; cR.ts1.b1 = cL.ts1.b1; cR.ts1.b2 = cL.ts1.b2; cR.ts1.b3 = cL.ts1.b3;
    cR.ts1.a1 = cL.ts1.a1; cR.ts1.a2 = cL.ts1.a2; cR.ts1.a3 = cL.ts1.a3;
    cR.ts2.b0 = cL.ts2.b0; cR.ts2.b1 = cL.ts2.b1; cR.ts2.b2 = cL.ts2.b2; cR.ts2.b3 = cL.ts2.b3;
    cR.ts2.a1 = cL.ts2.a1; cR.ts2.a2 = cL.ts2.a2; cR.ts2.a3 = cL.ts2.a3;
    cR.vo1.k = cL.vo1.k; cR.vo1.kb = cL.vo1.kb; cR.vo1.hb0 = cL.vo1.hb0; cR.vo1.ha1 = cL.vo1.ha1;
    cR.vo2.k = cL.vo2.k; cR.vo2.kb = cL.vo2.kb; cR.vo2.hb0 = cL.vo2.hb0; cR.vo2.ha1 = cL.vo2.ha1;
  );
);

// the valves' operating points (DRIFT moves them); each side has its own wander
function fl_bias(w1, w2, w3, w4) instance(v1a, v1b, v2a, v2b, v4b, drv, pin, pa) local(a) (
  a = dm_a;
  v1a.fl_stset(-0.30 + 0.05 * a * w1); v1b.fl_stset(-0.25 + 0.05 * a * w2);
  v2a.fl_stset(-0.30 + 0.05 * a * w2); v2b.fl_stset(-0.25 + 0.05 * a * w1);
  v4b.fl_stset(-0.20 + 0.05 * a * w3); drv.fl_stset(-0.10 + 0.04 * a * w3);
  pin.fl_syset(0.04 + 0.03 * a * w4);
  pa.fl_paset(0.025 * a * w4);                         // the power valves drift out of balance
  pa.sbase = 1 + 0.012 * a * w3;                        // the supply breathes
);

// ---------- presets (the input trim / guard and the output stage are left alone; OUTPUT evens out the loudness) ----------
function fl_set(ch, jp, nv, nt, nm, nb, nbr, vv, vt, vm, vb, vbr, rv, sp, it, st, mo, df, ou) (
  slider1 = ch; slider2 = jp; slider3 = nv; slider4 = nt; slider5 = nm; slider6 = nb; slider7 = nbr;
  slider8 = vv; slider9 = vt; slider10 = vm; slider11 = vb; slider12 = vbr;
  slider13 = rv; slider14 = sp; slider15 = it; slider16 = st; slider17 = mo; slider20 = df; slider21 = ou;
  slider_automate(131071 + 524288 + 1048576);          // sliders 1-17, 20 and 21
);
function load_preset(p) (
  //               CH JP  N:VOL TRE  MID  BAS BR   V:VOL TRE  MID  BAS BR   REV  SPD  INT ST MO DRIFT OUTPUT
  p == 1  ? fl_set(1, 0,   4,   6,   5,   4,   0,   4,   6,   5,   4,   0,   3,   5,   1,  0, 0, 50,   0.0) :  // Init
  p == 2  ? fl_set(1, 0,   4,   6,   5,   4,   0, 3.5, 7.5,   4, 3.5,   1, 2.5,   5,   1,  0, 0, 40,  -0.3) :  // Sparkle Clean
  p == 3  ? fl_set(1, 0,   4,   6,   5,   4,   0,   5, 7.5,   6, 3.5,   1, 8.5,   5,   1,  0, 0, 50, -13.6) :  // Surf Reverb
  p == 4  ? fl_set(0, 0, 5.5,   8,   4, 4.5,   1,   4,   6,   5,   4,   0,   3,   5,   1,  0, 0, 45,  -8.4) :  // Country Twang
  p == 5  ? fl_set(1, 0,   4,   6,   5,   4,   0,   4, 3.5,   6,   6,   0,   2,   5,   1,  0, 0, 40,  -0.9) :  // Jazz Warm
  p == 6  ? fl_set(1, 0,   4,   6,   5,   4,   0,   4,   6,   5, 4.5,   0,   4, 3.5, 5.5,  0, 0, 50,   1.5) :  // Tremolo Ballad
  p == 7  ? fl_set(1, 0,   4,   6,   5,   4,   0, 4.5, 6.5,   5,   4,   0, 3.5, 5.5,   7,  1, 0, 50,   0.5) :  // Stereo Throb
  p == 8  ? fl_set(1, 0,   4,   6,   5,   4,   0, 7.5,   6, 6.5,   4,   1, 2.5,   5,   1,  0, 0, 60, -14.3) :  // Pushed Edge
  p == 9  ? fl_set(1, 1,   6,   5,   7,   5,   0,   5, 6.5,   5,   4,   1, 2.5,   5,   1,  0, 0, 50, -12.7) :  // Jumpered Fat
  p == 10 ? fl_set(1, 0,   4,   6,   5,   4,   0, 3.5, 5.5,   5,   5,   0,   2,   5,   1,  0, 0, 40,   2.5) :  // Keys Clean
  p == 11 ? fl_set(1, 0,   4,   6,   5,   4,   0,   4, 5.5,   5,   5,   0, 2.5, 4.5,   6,  1, 0, 45,   1.5) :  // Keys Trem
  p == 12 ? fl_set(1, 0,   4,   6,   5,   4,   0, 6.5, 6.5,   6, 4.5,   0, 2.5,   5,   1,  0, 0, 55, -11.5) :  // Edge of Breakup
  p == 13 ? (                                           // Reset all to defaults
    fl_set(1, 0, 4, 6, 5, 4, 0, 4, 6, 5, 4, 0, 3, 5, 1, 0, 0, 50, 0);
    slider18 = 0; slider19 = 0; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000;
    slider26 = -0.3; slider27 = 1;
    slider_automate(134217727);                         // sliders 1-27
  );
);

// ---------- state ----------
function fl_start() (
  fl_mem(); fl_qbuild(); fl_qint(); fl_srinit(); update(); fl_tone(1);
  cL.fl_bias(0, 0, 0, 0); cR.fl_bias(0, 0, 0, 0);
  fl_gN = fl_gNt; fl_gV = fl_gVt; fl_mn = fl_mt; fl_o = fl_ot2 = fl_ot_; fl_D = fl_Dt; fl_vh = fl_vhold;
  fl_rL = fl_rR = fl_rL1 = fl_rR1 = 0; fl_ph = 0; fl_g1 = fl_g2 = 0;
);
fl_dn = 0.000000000000000001;
fl_start();
ostL.ost_ch_init(); ostR.ost_ch_init();
dw1.drift_init(0.8 + rand(1) * 0.5); dw2.drift_init(0.8 + rand(1) * 0.5); dw3.drift_init(0.8 + rand(1) * 0.5); dw4.drift_init(0.8 + rand(1) * 0.5);
dw5.drift_init(0.8 + rand(1) * 0.5); dw6.drift_init(0.8 + rand(1) * 0.5); dw7.drift_init(0.8 + rand(1) * 0.5); dw8.drift_init(0.8 + rand(1) * 0.5);
dwr.drift_init(0.8 + rand(1) * 0.5);
fl_pkL_disp = fl_pkR_disp = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

pwr_init(); pwr_sag = 0.4;   // MAINS + warm-up (gfx-lab-power)

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update();

@block
prs_chk();
pwr_block(1);                                           // MAINS: sag, ripple, hum; the warm-up
srate != fl_sr ? fl_start();
update();
fl_tone(0);
// DRIFT: valve bias, supply and power-valve balance per side, and the tremolo rate
fl_di = 0.2 * dm_s * samplesblock / srate;
cL.fl_bias(dw1.drift_tick(fl_di), dw2.drift_tick(fl_di), dw3.drift_tick(fl_di), dw4.drift_tick(fl_di));
cR.fl_bias(dw5.drift_tick(fl_di), dw6.drift_tick(fl_di), dw7.drift_tick(fl_di), dw8.drift_tick(fl_di));
fl_rw = 1 + 0.025 * dm_a * dwr.drift_tick(fl_di * 1.5);
// the level trim of the channel in use (JUMPER: the larger one's and half the other's), into OUTPUT's glide
fl_tq = fl_trim(fl_s3, fl_s7); fl_tv = fl_trim(fl_s8, fl_s12);
fl_tq = fl_gNt && fl_gVt ? max(fl_tq, fl_tv) + 0.5 * min(fl_tq, fl_tv) : fl_gNt ? fl_tq : fl_tv;
fl_ot2 = fl_ot_ * 10 ^ (-fl_tq / 20);
// the pre-filter follows the VOLUME of the channel(s) in use (the louder one when JUMPER feeds both)
fl_pfd = max(fl_gNt ? fl_s3 : 1, fl_gVt ? fl_s8 : 1);
cL.pf.clp_pf_block((fl_pfd - 1) / 9, srate, samplesblock); cR.pf.clp_pf_block((fl_pfd - 1) / 9, srate, samplesblock);
fl_isr = fl_rate * fl_rw / srate;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@sample
in_process(spl0, spl1);
pwr_in(in_l, in_r); in_l = pwr_l; in_r = pwr_r;          // mains hum + sag, warm-up drive (OFF + NEAR: untouched)
fl_xl = in_l; fl_xr = in_r;
// MONO IN, the channel select / JUMPER (glides, no clicks)
fl_mn += (fl_mt - fl_mn) * fl_smk;
fl_xm = 0.5 * (fl_xl + fl_xr); fl_xl += (fl_xm - fl_xl) * fl_mn; fl_xr += (fl_xm - fl_xr) * fl_mn;
fl_gN += (fl_gNt - fl_gN) * fl_smk; fl_gV += (fl_gVt - fl_gV) * fl_smk;
fl_nrun = fl_gN > 0.00001; fl_kN = fl_gN * fl_kin; fl_kV = fl_gV * fl_kin;
fl_gV > 0.00001 ? fl_vh = fl_vhold : fl_vh > 0 ? fl_vh -= 1;
fl_vrun = fl_vh > 0;                                   // the vibrato channel keeps running while its reverb rings out
fl_dn = -fl_dn;

// the tremolo: the oscillator flashes the lamp, the cell darkens fast and recovers slowly
fl_D += (fl_Dt - fl_D) * fl_smk;
fl_st += (fl_stt - fl_st) * fl_smk;
fl_ph += fl_isr; fl_ph >= 1 ? fl_ph -= 1;
fl_s = sin(2 * $pi * fl_ph);
fl_lv = max((fl_s - 0.15) * 1.1764706, 0); fl_lv *= sqrt(fl_lv);
fl_g1 += (fl_lv - fl_g1) * (fl_lv > fl_g1 ? fl_ldra : fl_ldrr);
fl_lv = max((-fl_s - 0.15) * 1.1764706, 0); fl_lv *= sqrt(fl_lv);  // the opposite phase (STEREO TREM)
fl_g2 += (fl_lv - fl_g2) * (fl_lv > fl_g2 ? fl_ldra : fl_ldrr);
fl_tgL = 1 / (1 + fl_D * fl_g1);
fl_tgR = 1 / (1 + fl_D * (fl_g1 + (fl_g2 - fl_g1) * fl_st));

// the reverb tanks (half rate, on every other sample; fed with the send of the last two samples, their return
// read in between linearly)
fl_vrun && fl_tph ? (
  fl_rL1 = fl_rL; fl_rR1 = fl_rR;
  fl_rL = tkL.fl_tank(cL.fl_send(cL.sacc), 0); fl_rR = tkR.fl_tank(cR.fl_send(cR.sacc), 3);
  cL.sacc = 0; cR.sacc = 0;
  fl_tw = (fl_tw + 1) & fl_tm; fl_tp += 1; fl_tp >= fl_tK ? fl_tp = 0;
);
fl_tph = !fl_tph;

// the amps (host rate; x 2: the level of the former 2x amp), then the post-shelf
fl_yl = 2 * cL.fl_core(fl_xl, fl_tph ? fl_rL : 0.5 * (fl_rL + fl_rL1), fl_tgL);
fl_yr = 2 * cR.fl_core(fl_xr, fl_tph ? fl_rR : 0.5 * (fl_rR + fl_rR1), fl_tgR);
fl_yl = kL3.am_run(kL2.am_run(kL1.am_run(fl_yl))); fl_yr = kR3.am_run(kR2.am_run(kR1.am_run(fl_yr)));

// the speakers, the output section
fl_yl = cabL.fl_cabrun(fl_yl); fl_yr = cabR.fl_cabrun(fl_yr);
fl_o += (fl_ot2 - fl_o) * fl_smk;
fl_yl = ostL.ost_band(fl_yl) * fl_o; fl_yr = ostR.ost_band(fl_yr) * fl_o;
pwr_out(fl_yl, fl_yr); fl_yl = pwr_l; fl_yr = pwr_r;          // the warm-up's gain and tone, ripple
ost_out(fl_yl, fl_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
fl_pkL_disp = max(fl_pkL_disp, abs(spl0)); fl_pkR_disp = max(fl_pkR_disp, abs(spl1));

@gfx 1000 300
ui_begin(1000, 300);

// =====================================================================
// The combo: black tolex, a black control panel with white print, a silver sparkle grille
// =====================================================================
FV_INK = 0xEEEFEA;                                      // chiffon white print
FV_INK2 = 0xC7BEB3;                                     // elephant's breath (quieter print)
FV_ACC = 0xE8463A;                                      // the value arcs: the pilot lamp's red
FV_PNL = 0x0D0E0F;                                      // the control panel
FV_UT = 0x1A1B1D;                                       // the lower utility panel

gfx_setfont(6,  "Trebuchet MS", 25 * sc, 'b');          // title
gfx_setfont(7,  "Trebuchet MS", 24 * sc, 'bi');         // the chrome script on the grille
gfx_setfont(11, "Trebuchet MS", (12 * sc) * max(ui_tf, 1), 'b');          // small print
gfx_setfont(12, "Trebuchet MS", (12.5 * sc) * max(ui_tf, 1), 'b');        // key captions
gfx_setfont(13, "Trebuchet MS", (15 * sc) * max(ui_tf, 1), 'b');          // knob legends
gfx_setfont(14, "Trebuchet MS", (9.5 * sc) * max(ui_tf, 1), 'b');         // skirt numbers
gfx_setfont(15, "Trebuchet MS", (14 * sc) * max(ui_tf, 1), 'b');          // values (while touched)

function fv_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function fv_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function fv_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function fv_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function fv_hash(i) local(v) ( v = sin(i * 12.9898 + 78.233) * 43758.5453; v - floor(v); );
// a smooth thick arc: anti-aliased arcs every half pixel (pixel coordinates)
function fv_arcw(cx, cy, r, a1, a2, w) local(k) (
  ui_ssarc(cx, cy, r, a1, a2, w);   // (supersampled: an even ring)
);

// ---------- the static parts, drawn once per size into an image ----------
function fv_tolex(x, y, w, h) local(i, n, px, py, k) (
  ui_col(0x050506); fv_r(x, y, w, h);
  ui_col(0x151516); fv_r(x + 1, y + 1, w - 2, h - 2);
  n = floor(w * h / 9); i = 0;
  loop(n,                                               // the pebble grain
    px = x + 1 + fv_hash(i * 3.17 + 0.1) * (w - 3); py = y + 1 + fv_hash(i * 7.91 + 1.3) * (h - 3); k = fv_hash(i * 1.61 + 4.2);
    ui_cola(k > 0.55 ? 0xFFFFFF : 0x000000, k > 0.55 ? 0.045 : 0.3);
    gfx_rect(px * sc, py * sc, max(1, sc), max(1, sc));
    i += 1;
  );
  gfx_gradrect(x * sc, y * sc, w * sc, 40 * sc, 1, 1, 1, 0.05, 0, 0, 0, 0, 0, 0, 0, -0.05 / (40 * sc));
);
function fv_grille(x, y, w, h) local(i, n, px, py, k, c, gx0, gy0, gw, gh) (
  gx0 = floor(x * sc); gy0 = floor(y * sc); gw = floor(w * sc); gh = floor(h * sc);
  ui_col(0x9A9EA2); gfx_rect(gx0, gy0, gw, gh);
  i = 0; loop(floor(gh / 2),                             // the weave, in whole pixels: fine threads both ways
    ui_cola(0x000000, 0.20); gfx_rect(gx0, gy0 + i * 2, gw, 1);
    ui_cola(0xFFFFFF, 0.10); gfx_rect(gx0, gy0 + i * 2 + 1, gw, 1); i += 1; );
  i = 0; loop(floor(gw / 2),
    ui_cola(0x000000, 0.12); gfx_rect(gx0 + i * 2, gy0, 1, gh); i += 1; );
  // the two speakers behind the cloth
  ui_cola(0x000000, 0.13); gfx_circle((x + w * 0.27) * sc, (y + h + 70) * sc, 150 * sc, 1, 1); gfx_circle((x + w * 0.73) * sc, (y + h + 70) * sc, 150 * sc, 1, 1);
  ui_cola(0x000000, 0.10); gfx_circle((x + w * 0.27) * sc, (y + h + 70) * sc, 112 * sc, 1, 1); gfx_circle((x + w * 0.73) * sc, (y + h + 70) * sc, 112 * sc, 1, 1);
  // the sparkle: silver glints, a few blue threads
  n = floor(gw * gh / 22); i = 0;
  loop(n,
    px = gx0 + floor(fv_hash(i * 2.71 + 0.3) * (gw - 1)); py = gy0 + floor(fv_hash(i * 5.23 + 2.1) * (gh - 1)); k = fv_hash(i * 9.13 + 0.7);
    c = k < 0.7 ? 0xFFFFFF : 0xB8DCF4;
    ui_cola(c, 0.25 + 0.6 * fv_hash(i * 0.37));
    gfx_rect(px, py, 1, 1);
    i += 1;
  );
  gfx_gradrect(x * sc, y * sc, w * sc, 14 * sc, 0, 0, 0, 0.35, 0, 0, 0, 0, 0, 0, 0, -0.35 / (14 * sc));   // the baffle's shadow
  // the piping round the baffle
  ui_col(0xE8E0CB); fv_r(x - 2, y - 2, w + 4, 1.5); fv_r(x - 2, y + h + 0.5, w + 4, 1.5); fv_r(x - 2, y - 2, 1.5, h + 4); fv_r(x + w + 0.5, y - 2, 1.5, h + 4);
);
// the chrome script on the grille
function fv_chrome(x, y, s) (
  gfx_setfont(7);
  ui_cola(0x000000, 0.55); fv_txt(x + 1.5, y + 2, s);
  ui_col(0x6E737A); fv_txt(x + 0.6, y + 0.8, s);
  ui_col(0xD7DBE0); fv_txt(x, y, s);
  ui_cola(0xFFFFFF, 0.5); fv_txt(x - 0.4, y - 0.5, s);
);
function fv_static() local(i, cx) (
  gfx_setimgdim(120, gfx_w, gfx_h); gfx_dest = 120;
  ui_col(0x050506); gfx_rect(0, 0, gfx_w, gfx_h);
  fv_tolex(0, 0, 1000, 300);
  // the control panel: black, white print, a thin aluminium frame
  ui_cola(0x000000, 0.6); fv_r(12, 51, 978, 149);
  ui_col(0x8E9399); fv_r(11, 49, 978, 149);
  ui_col(0x3A3D41); fv_r(12, 50, 976, 147);
  ui_col(FV_PNL); fv_r(13, 51, 974, 145);
  gfx_gradrect(13 * sc, 51 * sc, 974 * sc, 50 * sc, 1, 1, 1, 0.045, 0, 0, 0, 0, 0, 0, 0, -0.045 / (50 * sc));
  ui_cola(0xFFFFFF, 0.25); fv_r(13, 51, 974, 1);
  // the gap between the channels
  ui_cola(0xFFFFFF, 0.14); fv_r(376, 60, 1, 128);
  // legends over the knobs
  gfx_setfont(13); ui_col(FV_INK);
  i = 0;
  loop(11,
    cx = i < 4 ? 124 + i * 71 : 488 + (i - 4) * 71;
    fv_ctxt(cx, 79, i == 0 || i == 4 ? "Volume" : i == 1 || i == 5 ? "Treble" : i == 2 || i == 6 ? "Middle" : i == 3 || i == 7 ? "Bass" :
                    i == 8 ? "Reverb" : i == 9 ? "Speed" : "Intensity");
    i += 1;
  );
  // the tremolo pair: one bracket under the legends
  ui_cola(FV_INK2, 0.6); fv_r(816, 62, 125, 1); fv_r(816, 62, 1, 4); fv_r(940, 62, 1, 4);
  gfx_setfont(11); ui_col(FV_PNL); fv_r(850, 56, 56, 12); ui_col(FV_INK2); fv_ctxt(878, 62, "VIBRATO");
  // input jacks (the look of the panel; the keys above them pick the input)
  i = 0;
  loop(4,
    cx = i < 2 ? 38 + i * 30 : 402 + (i - 2) * 30;
    ui_col(0x050505); gfx_circle(cx * sc, 128 * sc, 9.5 * sc, 1, 1);
    ui_col(0x9CA1A7); gfx_circle(cx * sc, 128 * sc, 8.5 * sc, 1, 1);
    ui_col(0xD9DCE0); fv_arcw(cx * sc, 128 * sc, 7.2 * sc, -0.66 * $pi, 0.06 * $pi, 1.2 * sc);
    ui_col(0x5E636A); gfx_circle(cx * sc, 128 * sc, 5.5 * sc, 1, 1);
    ui_col(0x050505); gfx_circle(cx * sc, 128 * sc, 4.2 * sc, 1, 1);
    gfx_setfont(11); ui_col(FV_INK2); fv_ctxt(cx, 147, i % 2 ? "2" : "1");
    i += 1;
  );
  // the grille and the utility panel
  fv_grille(14, 208, 542, 84);
  fv_chrome(30, 214, "Fullerton");
  pk_inset(576 * sc, 210 * sc, 404 * sc, 80 * sc, FV_UT);
  // header print
  ui_col(FV_INK); gfx_circle(28 * sc, 25 * sc, 15 * sc, 1, 1);
  gfx_setfont(4); ui_col(0x151516); ui_text(28 * sc, 19.5 * sc, "GFX");
  gfx_setfont(6); ui_cola(0x000000, 0.6); fv_txt(53, 11, "FULLERTON 65"); ui_col(FV_INK); fv_txt(52, 10, "FULLERTON 65");
  gfx_setfont(11); ui_col(FV_INK2); fv_txt(244, 11, "STEREO 2x12"); fv_txt(244, 25, "REVERB COMBO");
  gfx_setfont(11); ui_col(FV_INK2); fv_ctxt(771, 17.5, "L"); fv_ctxt(771, 30.5, "R");
  gfx_dest = -1;
);
(gfx_w != fv_bw || gfx_h != fv_bh || sc != fv_bsc) ? ( fv_bw = gfx_w; fv_bh = gfx_h; fv_bsc = sc; fv_static(); );
gfx_x = 0; gfx_y = 0; gfx_a = 1; gfx_mode = 0; gfx_blit(120, 1, 0);

// ---------- a lit key; returns 1 when clicked ----------
function fv_key(x, y, w, h, lbl, on, col) local(hov, hit) (
  hov = fv_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.5); fv_r(x + 1, y + 2, w, h);
  ui_col(0x040405); fv_r(x, y, w, h);
  on ? (
    ui_cola(col, 0.18); fv_r(x - 3, y - 3, w + 6, h + 6);
    ui_col(col); fv_r(x + 1, y + 1, w - 2, h - 2);
    ui_cola(0xFFFFFF, 0.5); fv_r(x + 1, y + 1, w - 2, 1);
    ui_cola(0x000000, 0.12); fv_r(x + 1, y + h - 2, w - 2, 1);
    ui_col(0x16171A);
  ) : (
    ui_col(hov ? 0x3B3E43 : 0x2B2D31); fv_r(x + 1, y + 1, w - 2, h - 2);
    ui_cola(0xFFFFFF, 0.13); fv_r(x + 1, y + 1, w - 2, 1);
    ui_col(0xC9CDD2);
  );
  gfx_setfont(12); fv_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);

// ---------- the main knob: a black skirt numbered 1 - 10, the house white cap, the value arc in red ----------
// drag (SHIFT = fine), double-click = default, wheel (SHIFT = fine); the value shows under it while touched
function fv_knob(cx, cy, idx, def, label) local(v, n, dx, dy, hov, did, a, a0, ca, sa, X, Y, rs, rc, rt, i, t, tw, th) (
  did = 1900 + idx; v = slider(idx);
  X = cx * sc; Y = cy * sc; rs = 27.5 * sc; rc = 12.5 * sc; rt = 31 * sc;
  dx = mouse_x - X; dy = mouse_y - Y; hov = dx * dx + dy * dy <= sqr(32 * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - fv_lt < 0.35 && fv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; fv_lt = 0; ) : (
      drag_id = did; fv_y = mouse_y; fv_lt = time_precise(); fv_lid = idx; fv_n = (v - 1) / 9;
    );
  );
  drag_id == did ? (
    fv_n = min(max(fv_n + (fv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); fv_y = mouse_y;
    v = floor((1 + 9 * fv_n) * 10 + 0.5) / 10;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    slider(idx) = min(max(floor((v + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.1 : 0.5)) * 10 + 0.5) / 10, 1), 10);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = (v - 1) / 9;
  a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  // track and value arc
  ui_col(0x34373C); fv_arcw(X, Y, rt, a0, 0.75 * $pi, 1.3 * sc);
  n > 0.004 ? (
    ui_col(FV_ACC); fv_arcw(X, Y, rt, a0, a, 2.8 * sc);
    gfx_circle(X + sin(a0) * rt, Y - cos(a0) * rt, 1.4 * sc, 1, 1); gfx_circle(X + ca * rt, Y + sa * rt, 1.4 * sc, 1, 1);
  );
  // the skirt
  ui_cola(0x000000, 0.55); gfx_circle(X + 1.5 * sc, Y + 3 * sc, rs, 1, 1);
  ui_col(0x0A0A0B); gfx_circle(X, Y, rs, 1, 1);
  gfx_gradrect(X - rs * 0.8, Y - rs * 0.85, rs * 1.6, rs * 0.85, 1, 1, 1, 0.07, 0, 0, 0, 0, 0, 0, 0, -0.07 / (rs * 0.85));
  ui_cola(0xFFFFFF, 0.16); gfx_arc(X, Y, rs - 0.5, -0.7 * $pi, 0.2 * $pi, 1);
  gfx_setfont(14); ui_col(FV_INK);
  i = 1;
  loop(10,
    t = a0 + (i - 1) / 9 * 1.5 * $pi;
    sprintf(#fvn, "%d", i); gfx_measurestr(#fvn, tw, th);
    gfx_x = X + sin(t) * 20.6 * sc - tw * 0.5; gfx_y = Y - cos(t) * 20.6 * sc - th * 0.48; gfx_drawstr(#fvn);
    i += 1;
  );
  // the house white cap: a flat satin cap, one soft highlight on its upper-left edge, a thin dark rim, a dark pointer
  ui_cola(0x000000, 0.35); gfx_circle(X + 0.8 * sc, Y + 1.6 * sc, rc, 1, 1);
  ui_col(0x50565E); gfx_circle(X, Y, rc, 1, 1);
  ui_col(0xB3B9C0); gfx_circle(X, Y, rc - 1.3 * sc, 1, 1);
  ui_col(0xD9DDE1); fv_arcw(X, Y, rc - 2.8 * sc, -0.66 * $pi, 0.06 * $pi, 1.3 * sc);
  ui_col(0x1A1E24); i = -1;
  ui_ssline(X + ca * rc * 0.25, Y + sa * rc * 0.25, X + ca * (rc - 2.5 * sc), Y + sa * (rc - 2.5 * sc), 2.4 * sc, 1);
  (hov || drag_id == did) ? (
    ui_cola(0xFFFFFF, 0.07); gfx_circle(X, Y, rs, 1, 1);
    sprintf(#fvv, "%.1f", v); gfx_setfont(15); ui_col(FV_INK); fv_ctxt(cx, cy + 43, #fvv);
  );
);

// ---------- the pilot lamp: a faceted red jewel in a chrome bezel ----------
function fv_jewel(cx, cy) local(X, Y, i, t, t2, r, c) (
  X = cx * sc; Y = cy * sc;
  ui_cola(0xFF2A1A, 0.06); gfx_circle(X, Y, 26 * sc, 1, 1);
  ui_cola(0xFF2A1A, 0.10); gfx_circle(X, Y, 19 * sc, 1, 1);
  ui_col(0x050505); gfx_circle(X, Y, 15.5 * sc, 1, 1);
  ui_col(0x8F949A); gfx_circle(X, Y, 14.5 * sc, 1, 1);
  ui_col(0xDADDE1); fv_arcw(X, Y, 13 * sc, -0.7 * $pi, 0.1 * $pi, 1.5 * sc);
  ui_col(0x55595F); fv_arcw(X, Y, 13 * sc, 0.35 * $pi, 1.15 * $pi, 1.2 * sc);
  ui_col(0x3A0604); gfx_circle(X, Y, 11 * sc, 1, 1);
  r = 10.2 * sc; i = 0;
  loop(10,                                              // the facets
    t = i / 10 * 2 * $pi; t2 = (i + 1) / 10 * 2 * $pi;
    c = 0.5 + 0.5 * cos(t + 0.35 * $pi - 0.3);
    ui_col(ui_mix(0x9A0C06, 0xFF4A30, c));
    gfx_triangle(X, Y, X + sin(t) * r, Y - cos(t) * r, X + sin(t2) * r, Y - cos(t2) * r);
    i += 1;
  );
  ui_col(0xFF5A3A); gfx_circle(X, Y, 5 * sc, 1, 1);
  ui_cola(0xFFE0D0, 0.85); gfx_circle(X - 3.5 * sc, Y - 4 * sc, 1.8 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.35); gfx_circle(X + 3 * sc, Y + 3 * sc, 1 * sc, 1, 1);
);

// =====================================================================
// Header: the preset bar, the output meter, size / help
// =====================================================================
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
fv_k = pk_preset(352 * sc, 7 * sc, 400 * sc, 32 * sc, pr_cur,
  "Init|Sparkle Clean|Surf Reverb|Country Twang|Jazz Warm|Tremolo Ballad|Stereo Throb|Pushed Edge|Jumpered Fat|Keys Clean|Keys Trem|Edge of Breakup");
fv_k > 0 ? ( prs_dirty = fv_k; pr_cur = fv_k > 12 ? 1 : fv_k; );
mtL.ui_ledm(780 * sc, 14 * sc, 150 * sc, 7 * sc, fl_pkL_disp); mtR.ui_ledm(780 * sc, 27 * sc, 150 * sc, 7 * sc, fl_pkR_disp);
fl_pkL_disp = 0; fl_pkR_disp = 0;
ui_size_picker(942 * sc, 14 * sc);

// =====================================================================
// The control panel: NORMAL | VIBRATO, the pilot lamp
// =====================================================================
fv_ch = slider1 >= 0.5; fv_jp = slider2 >= 0.5;
fv_key(22, 60, 62, 26, "NORMAL", !fv_ch || fv_jp, 0xFFFDD0) ? ( slider1 = 0; slider2 = 0; ui_auto(1); ui_auto(2); );
fv_key(22, 160, 62, 24, "BRIGHT", slider7 >= 0.5, 0xFFB030) ? ( slider7 = slider7 >= 0.5 ? 0 : 1; ui_auto(7); );
fv_knob(124, 128, 3, 4, "Volume"); fv_knob(195, 128, 4, 6, "Treble"); fv_knob(266, 128, 5, 5, "Middle"); fv_knob(337, 128, 6, 4, "Bass");
fv_key(386, 60, 62, 26, "VIBRATO", fv_ch || fv_jp, 0xFFFDD0) ? ( slider1 = 1; slider2 = 0; ui_auto(1); ui_auto(2); );
fv_key(386, 160, 62, 24, "BRIGHT", slider12 >= 0.5, 0xFFB030) ? ( slider12 = slider12 >= 0.5 ? 0 : 1; ui_auto(12); );
fv_knob(488, 128, 8, 4, "Volume"); fv_knob(559, 128, 9, 6, "Treble"); fv_knob(630, 128, 10, 5, "Middle"); fv_knob(701, 128, 11, 4, "Bass");
fv_knob(772, 128, 13, 3, "Reverb"); fv_knob(843, 128, 14, 5, "Speed"); fv_knob(914, 128, 15, 1, "Intensity");
fv_jewel(966, 128);

// =====================================================================
// The utility panel: JUMPER, MONO IN, STEREO TREM | INPUT (GUARD), DRIFT, OUTPUT, SAT
// =====================================================================
fv_key(588, 216, 104, 20, "JUMPER", fv_jp, 0xFFFDD0) ? ( slider2 = fv_jp ? 0 : 1; ui_auto(2); );
fv_key(588, 240, 104, 20, "MONO IN", slider17 >= 0.5, 0xFFFDD0) ? ( slider17 = slider17 >= 0.5 ? 0 : 1; ui_auto(17); );
fv_key(588, 264, 104, 20, "STEREO TREM", slider16 >= 0.5, 0xFFFDD0) ? ( slider16 = slider16 >= 0.5 ? 0 : 1; ui_auto(16); );
dy_ink = FV_INK; dy_bg = FV_UT; dy_kst = 20; dy_ntick = 11;
sprintf(#fvv, "%+.1f dB", slider18); dy_knob(734, 236, 13, 18, -24, 12, 0, 0, 0x9DA2A8, "INPUT", #fvv);
ui_guardclick(1600 + 18, 19, 734, 236, 22);             // click INPUT for the house GUARD (its LED, upper right)
sprintf(#fvv, "%.0f%%", slider20); dy_knob(804, 236, 13, 20, 0, 100, 50, 0, 0x6F8794, "DRIFT", #fvv);
sprintf(#fvv, "%+.1f dB", slider21); dy_knob(874, 236, 13, 21, -24, 12, 0, 0, 0x9DA2A8, "OUTPUT", #fvv);
sprintf(#fvv, "%.0f%%", slider22); dy_knob(944, 236, 13, 22, 0, 100, 0, 0, 0xD8B040, "SAT", #fvv);
dy_kst = 7;

pk_end();
// the ? pop-up (ui_end, opened out): credits and links, then MAINS / EQUATOR PROXIMITY under them
ui_help_xh = 192;
