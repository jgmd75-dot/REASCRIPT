desc:Stour [chord arpeggiator] (GFX Lab)
//tags: midi arpeggiator arp chord four lanes inversion pattern utility
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider38:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:shold=0<0,1,1{Off,On}>-Hold
slider2:sswing=0<0,75,1>-Swing (%)
slider3:schans=0<0,1,1{Off,On}>-Lanes on channels 1 to 4
slider4:a_on=1<0,1,1{Off,On}>-Lane A low note on
slider5:a_rate=1<0,11,1{2 bars,1 bar,1/2,1/4 dotted,1/4,1/4 triplet,1/8 dotted,1/8,1/8 triplet,1/16,1/16 triplet,1/32}>-Lane A rate
slider6:a_mode=0<0,7,1{Pulse,Octaves,Fifths,Alternate,Offbeat,Three and rest,Three three two,Gallop}>-Lane A mode
slider7:a_oct=-1<-2,2,1>-Lane A octave
slider8:a_inv=0<0,3,1>-Lane A inversion
slider9:a_gate=90<10,100,1>-Lane A gate (%)
slider10:a_vel=90<0,100,1>-Lane A velocity (%)
slider11:a_len=0<0,7,1{All,2,3,4,5,6,7,8}>-Lane A steps
slider12:b_on=1<0,1,1{Off,On}>-Lane B lower chord on
slider13:b_rate=7<0,11,1{2 bars,1 bar,1/2,1/4 dotted,1/4,1/4 triplet,1/8 dotted,1/8,1/8 triplet,1/16,1/16 triplet,1/32}>-Lane B rate
slider14:b_mode=0<0,5,1{Up,Down,Up-down,Down-up,Random,Chord}>-Lane B mode
slider15:b_oct=-1<-2,2,1>-Lane B octave
slider16:b_inv=1<0,3,1>-Lane B inversion
slider17:b_gate=60<10,100,1>-Lane B gate (%)
slider18:b_vel=75<0,100,1>-Lane B velocity (%)
slider19:b_len=0<0,7,1{All,2,3,4,5,6,7,8}>-Lane B steps
slider20:c_on=1<0,1,1{Off,On}>-Lane C as played on
slider21:c_rate=4<0,11,1{2 bars,1 bar,1/2,1/4 dotted,1/4,1/4 triplet,1/8 dotted,1/8,1/8 triplet,1/16,1/16 triplet,1/32}>-Lane C rate
slider22:c_mode=0<0,4,1{Up,Down,Up-down,Down-up,Random}>-Lane C mode
slider23:c_oct=0<-2,2,1>-Lane C octave
slider24:c_inv=0<0,3,1>-Lane C inversion
slider25:c_gate=85<10,100,1>-Lane C gate (%)
slider26:c_vel=70<0,100,1>-Lane C velocity (%)
slider27:c_len=0<0,7,1{All,2,3,4,5,6,7,8}>-Lane C steps
slider28:d_on=1<0,1,1{Off,On}>-Lane D high note on
slider29:d_rate=9<0,11,1{2 bars,1 bar,1/2,1/4 dotted,1/4,1/4 triplet,1/8 dotted,1/8,1/8 triplet,1/16,1/16 triplet,1/32}>-Lane D rate
slider30:d_mode=0<0,7,1{Pulse,Octaves,Fifths,Alternate,Offbeat,Three and rest,Three three two,Gallop}>-Lane D mode
slider31:d_oct=1<-2,2,1>-Lane D octave
slider32:d_inv=0<0,3,1>-Lane D inversion
slider33:d_gate=40<10,100,1>-Lane D gate (%)
slider34:d_vel=65<0,100,1>-Lane D velocity (%)
slider35:d_len=0<0,7,1{All,2,3,4,5,6,7,8}>-Lane D steps
slider36:sbyp=0<0,1,1{Off,On}>-Bypass
slider37:prs_sel=0<0,12,1{No preset,Four Lanes,Slow Bloom,Driving Eighths,Bass and Bells,Dotted Echo,Triplet Climb,Cascade,Offbeat Bass,Gallop,Shimmer,Inversion Walk,Random Rain}>-Preset

in_pin:none
out_pin:none

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
function psw_all(v) ( slider_show(274877906943, v); );
function psw_allg(v) ( slider_show(274877906943, v); );
#ui_man = "gfx-lab-stour";
#so_pm = "Four Lanes|Slow Bloom|Driving Eighths|Bass and Bells|Dotted Echo|Triplet Climb|Cascade|Offbeat Bass|Gallop|Shimmer|Inversion Walk|Random Rain";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;

HP = 1000;  HS = 1040;  HV = 1080;  TS = 1120;  TV = 1160;  TMP = 1200;  TMV = 1240;
QT = 6000;  QY = 6600;  QC = 7200;  QN = 7800;  QV = 8400;  QMAX = 560;
SN = 10000;
LN = 12200;  LV = 12300;  LNC = 12400;  LCN = 12410;  LPB = 12420;
LON = 12430;  LRT = 12440;  LMD = 12450;  LOC = 12460;  LIV = 12470;  LGT = 12480;  LVL = 12490;  LLN = 12640;
LDN = 12500;  LDC = 12600;  LDI = 12610;  LDF = 12620;  LDM = 12630;

memset(SN, 0, 2048);
q_n = 0;  os_n = 0;  oh_n = 0;  so_scnt = 0;  so_in = 0;  so_mid = 0;
so_wrun = 0;  so_wplay = 0;  so_fb = 0;  so_exp = 0;  g_tp = 0;  g_gpp = 0;  g_gpd = 0;  so_wbyp = 0;
so_i = 0;  loop(4, LPB[so_i] = -1000000000;  LCN[so_i] = 0;  LDF[so_i] = 0;  LDI[so_i] = -2;  so_i += 1; );

function q_add(t, ty, c, n, v) (
  q_n < QMAX ? ( QT[q_n] = t;  QY[q_n] = ty;  QC[q_n] = c;  QN[q_n] = n;  QV[q_n] = v;  q_n += 1; );
);
function q_note(t, d, n, v, c) (
  n >= 0 && n <= 127 ? (
    q_add(t, 2, c, n, min(max(floor(v + 0.5), 1), 127));
    q_add(t + d, 0, c, n, 0);
  );
);
function q_emit(t0, ns) local(i, b, bt, by, ofs, k, c, n) (
  loop(q_n,
    b = -1;  bt = 0;  by = 0;  i = 0;
    loop(q_n, QT[i] < t0 + ns && (b < 0 || QT[i] < bt || (QT[i] == bt && QY[i] < by)) ? ( b = i;  bt = QT[i];  by = QY[i]; );  i += 1; );
    b >= 0 ? (
      ofs = min(max(floor(bt - t0), 0), ns - 1);
      c = QC[b];  n = QN[b];  k = SN + c * 128 + n;
      by == 2 ? (
        k[0] > 0 ? midisend(ofs, 0x80 | c, n, 0);
        midisend(ofs, 0x90 | c, n, QV[b]);  k[0] += 1;
      ) : (
        k[0] > 0 ? ( k[0] -= 1;  k[0] == 0 ? midisend(ofs, 0x80 | c, n, 0); );
      );
      q_n -= 1;
      QT[b] = QT[q_n];  QY[b] = QY[q_n];  QC[b] = QC[q_n];  QN[b] = QN[q_n];  QV[b] = QV[q_n];
    );
  );
);
function q_flush(ofs) local(i) (
  q_n = 0;
  i = 0;  loop(2048, SN[i] > 0 ? ( midisend(ofs, 0x80 | (i >> 7), i & 127, 0);  SN[i] = 0; );  i += 1; );
);

function so_key(n, v, c, on) local(i, f) (
  so_in = c;
  on ? (
    shold >= 0.5 && oh_n == 0 ? os_n = 0;
    f = 0;  i = 0;  loop(oh_n, HP[i] == n ? f = 1;  i += 1; );
    !f && oh_n < 32 ? ( HP[oh_n] = n;  oh_n += 1; );
    f = 0;  i = 0;  loop(os_n, HS[i] == n ? ( f = 1;  HV[i] = v; );  i += 1; );
    !f && os_n < 32 ? ( HS[os_n] = n;  HV[os_n] = v;  os_n += 1; );
  ) : (
    i = 0;  f = -1;  loop(oh_n, HP[i] == n ? f = i;  i += 1; );
    f >= 0 ? ( i = f;  loop(oh_n - f - 1, HP[i] = HP[i + 1];  i += 1; );  oh_n -= 1; );
    shold < 0.5 ? (
      i = 0;  f = -1;  loop(os_n, HS[i] == n ? f = i;  i += 1; );
      f >= 0 ? ( i = f;  loop(os_n - f - 1, HS[i] = HS[i + 1];  HV[i] = HV[i + 1];  i += 1; );  os_n -= 1; );
    );
  );
);
function so_sort() local(i, j, n, v) (
  i = 0;  loop(os_n, TS[i] = HS[i];  TV[i] = HV[i];  i += 1; );
  i = 1;
  loop(max(os_n - 1, 0),
    n = TS[i];  v = TV[i];  j = i - 1;
    while (j >= 0 && TS[j] > n) ( TS[j + 1] = TS[j];  TV[j + 1] = TV[j];  j -= 1; );
    TS[j + 1] = n;  TV[j + 1] = v;
    i += 1;
  );
);
function so_md(a, n) ( a - n * floor(a / n); );
function so_build(L) local(n, i, x, v, b, bv, k) (
  n = min(os_n, 12);  b = LN + L * 16;  bv = LV + L * 16;
  i = 0;  loop(n, TMP[i] = TS[i];  TMV[i] = TV[i];  i += 1; );
  n > 0 ? loop(LIV[L],
    x = TMP[0];  v = TMV[0];
    i = 0;  loop(n - 1, TMP[i] = TMP[i + 1];  TMV[i] = TMV[i + 1];  i += 1; );
    TMP[n - 1] = x + 12;  TMV[n - 1] = v;
  );
  k = LOC[L] * 12;
  n <= 0 ? LNC[L] = 0 : L == 0 ? ( b[0] = TMP[0] + k;  bv[0] = TMV[0];  b[1] = TMP[min(1, n - 1)] + k;  LNC[L] = 1; )
  : L == 3 ? ( b[0] = TMP[n - 1] + k;  bv[0] = TMV[n - 1];  b[1] = TMP[max(0, n - 2)] + k;  LNC[L] = 1; )
  : ( i = 0;  loop(n, b[i] = TMP[i] + k;  bv[i] = TMV[i];  i += 1; );  LNC[L] = n; );
  i = 0;  loop(LNC[L], LDN[L * 16 + i] = b[i];  i += 1; );
  LDC[L] = LNC[L];  LDM[L] = LMD[L];
  (L == 0 || L == 3) && n > 0 && LMD[L] >= 1 && LMD[L] <= 3 ? (
    LDN[L * 16 + 1] = LMD[L] == 1 ? b[0] + (L == 0 ? 12 : -12) : LMD[L] == 2 ? b[0] + (L == 0 ? 7 : -5) : b[1];
    LDC[L] = 2;
  );
);
function so_steps(r) local(bar) (
  bar = max(1, ts_num | 0) * 4 / (ts_denom > 0 ? ts_denom : 4);
  r == 0 ? 2 * bar : r == 1 ? bar : r == 2 ? 2 : r == 3 ? 1.5 : r == 4 ? 1 : r == 5 ? 2 / 3 :
  r == 6 ? 0.75 : r == 7 ? 0.5 : r == 8 ? 1 / 3 : r == 9 ? 0.25 : r == 10 ? 1 / 6 : 0.125;
);
function so_trig(L, cnt, tq, sl) local(b, bv, n, md, nlen, c, vs, i, x, p, nt) (
  b = LN + L * 16;  bv = LV + L * 16;  n = LNC[L];  md = LMD[L];
  nlen = max(LGT[L] / 100 * sl, 0.004 * srate);
  c = schans >= 0.5 ? L : so_in;
  vs = LVL[L] / 100;
  n > 0 && vs > 0 ? (
    L == 0 || L == 3 ? (
      p = so_md(cnt, 8);
      (md == 5 && so_md(cnt, 4) == 3) || (md == 6 && p != 0 && p != 3 && p != 6) || (md == 7 && so_md(cnt, 4) == 1) ? 0 : (
        nt = b[0];
        so_md(cnt, 2) == 1 ? (
          md == 1 ? nt += L == 0 ? 12 : -12
          : md == 2 ? nt += L == 0 ? 7 : -5
          : md == 3 ? nt = b[1];
        );
        md == 4 ? ( tq += 0.5 * sl;  nlen = max(0.5 * nlen, 0.004 * srate); );
        q_note(tq, nlen, nt, bv[0] * vs, c);
        LDI[L] = md >= 1 && md <= 3 ? so_md(cnt, 2) : 0;  LDF[L] += 1;
      );
    ) : md == 5 ? (
      i = 0;  loop(n, q_note(tq, nlen, b[i], bv[i] * vs, c);  i += 1; );
      LDI[L] = -1;  LDF[L] += 1;
    ) : (
      md == 0 ? x = so_md(cnt, n) :
      md == 1 ? x = n - 1 - so_md(cnt, n) :
      md == 4 ? x = min(n - 1, floor(rand(1) * n)) :
      n < 2 ? x = 0 : (
        p = so_md(cnt, 2 * n - 2);  p = p < n ? p : 2 * n - 2 - p;
        x = md == 3 ? n - 1 - p : p;
      );
      q_note(tq, nlen, b[x], bv[x] * vs, c);
      LDI[L] = x;  LDF[L] += 1;
    );
  );
);
function so_fresh() local(k) (
  k = 0;  loop(4, LPB[k] = -1000000000;  LCN[k] = 0;  k += 1; );
);
function so_alloff(ofs) (
  q_flush(ofs);  os_n = 0;  oh_n = 0;  so_wrun = 0;
);
function so_thru(ofs, m1, m2, m3) local(st, k) (
  st = m1 & 0xF0;
  schans >= 0.5 && st >= 0x80 && st < 0xF0 ? (
    k = 0;  loop(4, LON[k] ? midisend(ofs, st | k, m2, m3);  k += 1; );
  ) : midisend(ofs, m1, m2, m3);
);

function pl(L, on, rt, md, oc, iv, gt, vl, stp) local(b) (
  b = 4 + L * 8;
  slider(b) = on;  slider(b + 1) = rt;  slider(b + 2) = md;  slider(b + 3) = oc;  slider(b + 4) = iv;  slider(b + 5) = gt;  slider(b + 6) = vl;  slider(b + 7) = stp;
);
function load_preset(p) local(i) (
  p == 1 ? ( sswing = 0;  pl(0, 1, 1, 0, -1, 0, 90, 90, 0);  pl(1, 1, 7, 0, -1, 1, 60, 75, 0);  pl(2, 1, 4, 0, 0, 0, 85, 70, 0);  pl(3, 1, 9, 0, 1, 0, 40, 65, 0); ) :
  p == 2 ? ( sswing = 0;  pl(0, 1, 0, 0, -1, 0, 100, 85, 0);  pl(1, 0, 4, 2, -1, 1, 80, 70, 0);  pl(2, 1, 4, 2, 0, 0, 90, 65, 0);  pl(3, 1, 6, 3, 1, 0, 50, 55, 0); ) :
  p == 3 ? ( sswing = 0;  pl(0, 1, 7, 1, -1, 0, 55, 95, 0);  pl(1, 1, 9, 0, 0, 1, 45, 70, 3);  pl(2, 0, 4, 0, 0, 0, 80, 60, 0);  pl(3, 0, 4, 4, 1, 0, 50, 65, 0); ) :
  p == 4 ? ( sswing = 0;  pl(0, 1, 9, 6, -1, 0, 70, 95, 0);  pl(1, 0, 7, 0, -1, 1, 60, 70, 0);  pl(2, 0, 4, 1, 0, 0, 80, 65, 0);  pl(3, 1, 8, 2, 1, 0, 35, 70, 0); ) :
  p == 5 ? ( sswing = 0;  pl(0, 1, 2, 0, -1, 0, 90, 85, 0);  pl(1, 1, 6, 0, -1, 1, 60, 75, 3);  pl(2, 0, 3, 0, 0, 0, 80, 60, 0);  pl(3, 1, 3, 3, 1, 0, 45, 60, 0); ) :
  p == 6 ? ( sswing = 0;  pl(0, 1, 1, 2, -1, 0, 90, 85, 0);  pl(1, 1, 8, 0, -1, 2, 60, 75, 0);  pl(2, 0, 5, 4, 0, 1, 70, 60, 0);  pl(3, 1, 5, 4, 1, 0, 45, 65, 0); ) :
  p == 7 ? ( sswing = 0;  pl(0, 1, 2, 0, -1, 0, 85, 85, 0);  pl(1, 1, 9, 1, -1, 1, 50, 70, 0);  pl(2, 1, 7, 1, 0, 1, 55, 60, 4);  pl(3, 0, 9, 0, 1, 0, 40, 60, 0); ) :
  p == 8 ? ( sswing = 20;  pl(0, 1, 7, 4, -1, 0, 60, 95, 0);  pl(1, 0, 9, 2, 0, 1, 45, 65, 0);  pl(2, 1, 9, 2, 0, 0, 50, 70, 5);  pl(3, 0, 9, 0, 1, 0, 40, 60, 0); ) :
  p == 9 ? ( sswing = 0;  pl(0, 1, 9, 7, -1, 0, 60, 90, 0);  pl(1, 0, 7, 0, -1, 1, 60, 70, 0);  pl(2, 1, 4, 0, 0, 0, 80, 65, 0);  pl(3, 1, 7, 5, 1, 0, 40, 60, 0); ) :
  p == 10 ? ( sswing = 0;  pl(0, 0, 0, 0, -1, 0, 100, 75, 0);  pl(1, 1, 10, 2, 0, 2, 50, 60, 0);  pl(2, 1, 2, 0, 0, 0, 100, 55, 0);  pl(3, 1, 11, 3, 1, 0, 40, 50, 0); ) :
  p == 11 ? ( sswing = 0;  pl(0, 1, 4, 3, -1, 1, 80, 85, 0);  pl(1, 1, 7, 0, -1, 1, 60, 70, 5);  pl(2, 1, 7, 1, 0, 2, 55, 60, 4);  pl(3, 0, 2, 1, 1, 0, 70, 60, 0); ) :
  p == 12 ? ( sswing = 10;  pl(0, 1, 1, 2, -1, 0, 90, 80, 0);  pl(1, 1, 9, 4, 0, 1, 40, 65, 0);  pl(2, 0, 7, 4, 0, 1, 45, 55, 0);  pl(3, 1, 7, 6, 1, 0, 40, 60, 0); ) :
  0;
  i = 2;  loop(34, slider_automate(2 ^ (i - 1));  i += 1; );
  pr_cur = p;
);

NP = 12;
function prs_hash() local(i, h) ( h = 0;  i = 1;  loop(36, h += slider(i) * (1 + i * 0.7071);  i += 1; );  h; );
function prs_same() local(h, r) ( h = prs_hash();  r = h == prs_h0;  prs_h0 = h;  r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  load_preset(k);
    prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k;
    prs_last = prs_sel;  prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(NP, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel;  prs_sel > 0 && prs_hs ? ( load_preset(prs_sel);  prs_cur_d = prs_sel;  prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0;  prs_ok = 1; );
);
prs_ok = 0;  prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5;  psw_all(psw_last); );
prs_chk();

@block
prs_chk();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? so_alloff(0);
g_tp = g_now;  g_gpp = play_position;  g_gpd = samplesblock / srate;
so_ns = samplesblock;
so_on = sbyp < 0.5;
so_hold = shold >= 0.5;
so_whold && !so_hold ? (
  os_n = 0;  so_i = 0;  loop(oh_n, HS[os_n] = HP[so_i];  HV[os_n] = 100;  os_n += 1;  so_i += 1; );
);
so_whold = so_hold;
so_i = 0;
loop(4,
  so_b = 4 + so_i * 8;
  LON[so_i] = slider(so_b) >= 0.5;
  LRT[so_i] = max(0, min(11, slider(so_b + 1) | 0));
  LMD[so_i] = max(0, min(so_i == 0 || so_i == 3 ? 7 : so_i == 2 ? 4 : 5, slider(so_b + 2) | 0));
  LOC[so_i] = max(-2, min(2, slider(so_b + 3) | 0));
  LIV[so_i] = max(0, min(3, slider(so_b + 4) | 0));
  LGT[so_i] = max(10, min(100, slider(so_b + 5)));
  LVL[so_i] = max(0, min(100, slider(so_b + 6)));
  LLN[so_i] = max(0, min(7, slider(so_b + 7) | 0));  LLN[so_i] = LLN[so_i] > 0 ? LLN[so_i] + 1 : 0;
  so_i += 1;
);

while (midirecv(m_ofs, m_1, m_2, m_3)) (
  m_st = m_1 & 0xF0;
  m_st == 0x90 && m_3 > 0 ? so_mid += 1;
  !so_on ? midisend(m_ofs, m_1, m_2, m_3) :
  m_st == 0x90 || m_st == 0x80 ? (
    so_key(m_2, m_3, m_1 & 15, m_st == 0x90 && m_3 > 0);
  ) : (
    m_st == 0xB0 && (m_2 == 120 || m_2 == 123) ? so_alloff(m_ofs);
    so_thru(m_ofs, m_1, m_2, m_3);
  );
);
!so_on && so_wbyp ? so_alloff(0);
so_wbyp = so_on;

so_play = play_state & 1;
so_sort();
so_i = 0;  loop(4, so_build(so_i);  so_i += 1; );
so_run = so_on && os_n > 0;
so_bps = max(20, tempo) / 60 / srate;
so_run ? (
  so_play ? (
    so_t0 = beat_position;
    so_late = 0;
    !so_wrun ? ( so_fresh();  so_late = 0.1; ) : (!so_wplay || abs(so_t0 - so_exp) > 0.05) ? ( so_i = 0;  loop(4, LPB[so_i] = -1000000000;  so_i += 1; ); );
  ) : (
    !so_wrun || so_wplay ? ( so_fb = 0;  !so_wrun ? so_fresh() : ( so_i = 0;  loop(4, LPB[so_i] = -1000000000;  so_i += 1; ); ); );
    so_t0 = so_fb;
  );
  so_t1 = so_t0 + so_bps * so_ns;
  so_k = 0;
  loop(4,
    LON[so_k] ? (
      so_sb = so_steps(LRT[so_k]);
      so_m = ceil((so_t0 - (so_play ? so_late : 0)) / so_sb - 0.000001);
      while (so_m * so_sb < so_t1) (
        so_tb = so_m * so_sb;
        so_tb > LPB[so_k] + 0.0001 ? (
          so_T = so_scnt + (so_tb - so_t0) / so_bps + (so_md(so_m, 2) ? sswing / 100 * 0.5 * so_sb / so_bps : 0);
          so_trig(so_k, LCN[so_k], so_T, so_sb / so_bps);
