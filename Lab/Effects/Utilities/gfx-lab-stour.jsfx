    e = r + 10;  x0 = floor((cx - 26) * sc);  y0 = floor((cy - e) * sc);  w0 = ceil((cx + 26) * sc) - x0;  h0 = ceil((cy + r + 30) * sc) - y0;
    gfx_x = x0;  gfx_y = y0;  gfx_mode = 2;  gfx_blit(119, 1, 0, x0, y0, w0, h0, x0, y0, w0, h0);  gfx_mode = 0;
