);
function so_pocket(x, y, w, h) ( so_cham(x, y, w, h, 3, SOF); ui_col(SOP); v5_r(x + 3, y + 3, w - 6, h - 6); );
function so_title(x, y, s, c) ( so_ft(17); ui_col(SOI); so_tl(x, y, s); ui_col(c); v5_r(x, y + 13, so_tw(s), 3); );
function so_hover(cx, cy, fs) ( so_hon = 1; so_hx = cx; so_hy = cy; so_hfs = fs; );
function so_fmt(idx) local(v, j) (
  v = slider(idx);  j = (idx - 4) % 8;
