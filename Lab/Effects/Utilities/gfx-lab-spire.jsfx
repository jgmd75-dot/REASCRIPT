desc:Spire [level meter] (GFX Lab)
//tags: meter level peak rms analysis utility
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider4:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:sp_rng=0<0,2,1{60 dB,40 dB,24 dB}>-Range
slider2:sp_hold=1<0,2,1{1 s,3 s,Infinite}>-Peak hold
slider3:sp_arst=1<0,1,1{Off,On}>-Reset on play
slider5:sp_ms=0<0,1,1{Left / right,Mid / side}>-Channels
slider6:sp_bars=0<0,2,1{Peak + RMS,Peak,RMS}>-Bars

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-ui.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

@init
function psw_all(v) ( slider_show(63, v); );
function psw_allg(v) ( slider_show(63, v); );
#ui_man = "gfx-lab-spire";
ext_noinit = 1;

RQL = 100000; RQR = 400000;
rq_n = max(64, floor(0.3 * srate));
function rq_clear() (
  memset(RQL, 0, rq_n); memset(RQR, 0, rq_n);
  rq_p = 0; rq_sl = rq_sr = 0; rq_al = rq_ar = 0;
  a_pl = a_pr = 0; sp_rl_d = sp_rr_d = 0;
);
rq_clear();

!ui_dflt ? ( ui_sz = 0; );
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;

@block
gp_now = time_precise();
gp_tp > 0 && gp_now - gp_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_pp && play_position - gp_pp < 4 * gp_pd + 0.05) ? rq_clear();
gp_tp = gp_now; gp_pp = play_position; gp_pd = samplesblock / srate;
(sp_ms >= 0.5) != a_msl ? ( a_msl = sp_ms >= 0.5; rq_clear(); sp_rst_d = 1; );
gp_play = play_state & 1;
sp_arst >= 0.5 && gp_play && !gp_lastp ? sp_rst_d = 1;
gp_lastp = gp_play;
sp_pl_d = max(sp_pl_d, a_pl); sp_pr_d = max(sp_pr_d, a_pr); a_pl = a_pr = 0;
sp_rl_d = sqrt(max(0, rq_sl) / rq_n); sp_rr_d = sqrt(max(0, rq_sr) / rq_n);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;

@serialize
file_var(0, ui_sz);

@sample
s_l = spl0 == spl0 ? spl0 : 0; s_r = spl1 == spl1 ? spl1 : 0;
sp_ms >= 0.5 ? ( s_m = 0.5 * (s_l + s_r); s_r = 0.5 * (s_l - s_r); s_l = s_m; );
a_pl = max(a_pl, abs(s_l)); a_pr = max(a_pr, abs(s_r));
s_ql = s_l * s_l; s_qr = s_r * s_r;
rq_sl += s_ql - RQL[rq_p]; rq_sr += s_qr - RQR[rq_p];
RQL[rq_p] = s_ql; RQR[rq_p] = s_qr;
rq_al += s_ql; rq_ar += s_qr;
(rq_p += 1) >= rq_n ? ( rq_p = 0; rq_sl = rq_al; rq_sr = rq_ar; rq_al = rq_ar = 0; );

@gfx 244 720
ui_begin(244, 720);
v5_begin();
SPF = 0x34302C; SPI = 0xEDE6D4; SPI2 = 0xB8AE9C; SPA = 0xFFB030;
sc != sp_fsc ? (
  sp_fsc = sc;
  sp_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  sp_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  sp_f6 = ui_fitfont(6, 26 * sc);
);
function sp_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * sp_kt * sc, 'b'); );
function sp_fa(px) ( gfx_setfont(10, "Arial", px * sp_ka * sc, 'b'); );
function sp_fc(px) ( gfx_setfont(12, "Courier New", px * sp_kt * sc, 'b'); );
function sp_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sp_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sp_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function sp_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function sp_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A847C); v5_d(x, y, 4); ui_col(0xC4BEB4); v5_d(x - 0.8, y - 0.8, 2.4); );
function sp_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.16)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(ui_mix(f, 0, 0.10 + d * 0.012)); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function sp_pocket(x, y, w, h) (
  sp_cham(x, y, w, h, 3, SPF);
  ui_col(ui_mix(SPF, 0, 0.14)); v5_r(x + 3, y + 3, w - 6, h - 6);
  sp_cham(x + 8, y + 8, w - 16, h - 16, 3, ui_mix(SPF, 0, 0.10));
);
function sp_pocket1(x, y, w, h) ( sp_cham(x, y, w, h, 3, SPF); ui_col(ui_mix(ui_mix(SPF, 0, 0.10), 0, 0.136)); v5_r(x + 3, y + 3, w - 6, h - 6); );
function sp_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 5, y - 5, w + 10, h + 10, 5);
  ui_col(0x1E1A16); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  c1 = 0xE4D8BC; c0 = ui_mix(0xB8A884, c1, 0.44); c2 = ui_mix(0xB8A884, c1, 0.16);
  sp_grad(x, y, w, h * 0.4, c0, c1); sp_grad(x, y + h * 0.4, w, h * 0.6, c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function sp_led(x, y, c, g) local(i) (
  ui_col(0x050606); v5_d(x, y, 6);
  ui_col(ui_mix(c, 0x101214, 0.78)); v5_d(x, y, 4.5);
  g > 0.01 ? (
    i = 0; loop(5, ui_cola(c, 0.07 * g); v5_d(x, y, 4.5 + 2.2 * (5 - i)); i += 1; );
    ui_cola(c, g); v5_d(x, y, 4.5);
    ui_cola(ui_mix(c, 0xFFFFFF, 0.6), 0.85 * g); v5_d(x - 1.2, y - 1.4, 1.7);
  );
);
function sp_mbox(x, y, w, h, lbl, txt) local(r) (
  sp_ft(13); ui_col(SPI2); sp_tl(x + 2, y - 11, lbl);
  ui_col(0x050506); v5_rr(x - 1, y - 1, w + 2, h + 2, 4);
  ui_col(0x1A1612); v5_rr(x + 1, y + 1, w - 2, h - 2, 3);
  ui_cola(0, 0.35); v5_r(x + 2, y + 2, w - 4, 2); v5_r(x + 2, y + 2, 2, h - 4);
  sp_ft(15); ui_col(SPA); sp_tl(x + 10, y + h / 2 + 0.5, txt);
  gfx_triangle((x + w - 15) * sc, (y + h / 2 - 3) * sc, (x + w - 5) * sc, (y + h / 2 - 3) * sc, (x + w - 10) * sc, (y + h / 2 + 3) * sc);
  r = v5_pr && v5_drag == 0 && v5_hit(x, y, w, h); r ? v5_drag = -1;
  r;
);
function sp_sml(x, y) local(i, cur, on) (
  cur = ui_sz == 1 ? 0 : ui_sz == 2 ? 2 : 1;
  ui_col(0x050505); v5_rr(x - 2, y - 2, 84, 22, 3);
  i = 0; loop(4, on = i < 3 ? i == cur : ui_help_open;
    v5_pr && v5_drag == 0 && v5_hit(x + i * 20, y, 20, 18) ? (
      i == 0 ? ui_sz = 1 : i == 1 ? ui_sz = 0 : i == 2 ? ui_sz = 2 : ( ui_help_open = 1; ui_help_new = 1; );
      v5_drag = -1; on = 1;
    );
    ui_col(on ? 0xF0A030 : 0x2A2D30); v5_r(x + i * 20 + (i > 0), y, 20 - (i > 0), 18);
    on ? ( ui_cola(0xFFF0C8, 0.3); v5_r(x + i * 20 + 2, y + 2, 16, 14); );
    sp_ft(11); ui_col(on ? 0x3A2408 : v5_cr); v5_t(x + i * 20 + 10, y + 9, i == 0 ? "S" : i == 1 ? "M" : i == 2 ? "L" : "?");
    i += 1; );
);
function sp_db(v) ( v > 0.0000001 ? 20 * log10(v) : -140; );
function sp_rbw(t) local(f) (
  t = min(max(t, 0), 1) * 5; f = t - floor(t);
  t < 1 ? ui_mix(0x3A86FF, 0x22D8E8, f) : t < 2 ? ui_mix(0x22D8E8, 0x3CE05A, f) : t < 3 ? ui_mix(0x3CE05A, 0xFFD21E, f) :
  t < 4 ? ui_mix(0xFFD21E, 0xFF8A1E, f) : ui_mix(0xFF8A1E, 0xFF3A2A, t >= 5 ? 1 : f);
);
function sp_fig(v) (
  v <= -99.95 ? strcpy(#sp_fs, "--") : sprintf(#sp_fs, "%.1f", v);
  #sp_fs;
);

sp_now = time_precise();
sp_dt = sp_tl0 > 0 ? min(0.1, max(0, sp_now - sp_tl0)) : 0;
sp_tl0 = sp_now;
sp_bot = sp_rng < 0.5 ? -60 : sp_rng < 1.5 ? -40 : -24;
sp_hs = sp_hold < 0.5 ? 1 : sp_hold < 1.5 ? 3 : -1;

sp_rst_d ? ( sp_rst = 1; sp_rst_d = 0; );
(sp_ms >= 0.5) != sp_msl ? ( sp_msl = sp_ms >= 0.5; sp_rst = 1; );
sp_bm = sp_bars | 0;
sp_inl = sp_db(sp_pl_d); sp_inr = sp_db(sp_pr_d); sp_pl_d = 0; sp_pr_d = 0;
sp_rml = sp_db(sp_rl_d); sp_rmr = sp_db(sp_rr_d);
sp_rst ? (
  sp_mxl = sp_mxr = -140; sp_mrl = sp_mrr = -140; sp_ovl = sp_ovr = 0;
  sp_hl = sp_hr = -140; sp_htl = sp_htr = 0; sp_rst = 0;
);
sp_bl = max(sp_inl, sp_bl - 26 * sp_dt); sp_br = max(sp_inr, sp_br - 26 * sp_dt);
sp_vl = sp_bm == 2 ? sp_rml : sp_inl; sp_vr = sp_bm == 2 ? sp_rmr : sp_inr;
sp_fl = sp_bm == 2 ? sp_rml : sp_bl; sp_fr = sp_bm == 2 ? sp_rmr : sp_br;
sp_vl >= sp_hl ? ( sp_hl = sp_vl; sp_htl = sp_now; ) : sp_hs > 0 && sp_now - sp_htl > sp_hs ? sp_hl = max(sp_fl, sp_hl - 20 * sp_dt);
sp_vr >= sp_hr ? ( sp_hr = sp_vr; sp_htr = sp_now; ) : sp_hs > 0 && sp_now - sp_htr > sp_hs ? sp_hr = max(sp_fr, sp_hr - 20 * sp_dt);
sp_mxl = max(sp_mxl, sp_inl); sp_mxr = max(sp_mxr, sp_inr);
sp_mrl = max(sp_mrl, sp_rml); sp_mrr = max(sp_mrr, sp_rmr);
sp_inl >= -0.1 ? sp_ovl = 1; sp_inr >= -0.1 ? sp_ovr = 1;

ui_col(ui_mix(SPF, 0, 0.3)); gfx_rect(0, 0, gfx_w, gfx_h);
sp_grad(0, 0, 244, 720, ui_mix(SPF, 0xFFFFFF, 0.22), ui_mix(SPF, 0, 0.22));
ui_cola(0xFFFFFF, 0.12); v5_r(0, 0, 244, 1.5); v5_r(0, 0, 1.5, 720);
ui_cola(0, 0.30); v5_r(0, 717, 244, 3); v5_r(241, 0, 3, 720);
sp_rivet(7, 7); sp_rivet(237, 7); sp_rivet(7, 713); sp_rivet(237, 713);

ui_col(0x171412); v5_r(12, 12, 220, 52);
ui_col(0x0A0908); v5_r(12, 64, 220, 2);
ui_col(0x1A1A1C); v5_d(36, 38, 16); ui_col(0xE8EBEE); v5_d(36, 38, 14); ui_col(0x1A1A1C); v5_d(36, 38, 12);
ui_col(0xE8EBEE); gfx_circle(36 * sc, 38 * sc, 12.8 * sc, 0, 1);
sp_fa(8.5); ui_col(0xF4F6F8); v5_t(36, 38, "GFX");
gfx_setfont(6, "Trebuchet MS", sp_f6, 'b'); ui_col(v5_cr); sp_tl(60, 31, "SPIRE"); sp_x0 = 60 + sp_tw("SPIRE");
sp_ft(11); ui_col(SPI2); sp_tl(61, 52, "LEVEL METER");
sp_i = 0; loop(3, ui_col(sp_rbw(sp_i * 0.4));
  v5_q(160 + sp_i * 14, 64, 168 + sp_i * 14, 44, 176 + sp_i * 14, 44, 168 + sp_i * 14, 64); sp_i += 1; );
sp_sml(148, 19);

sp_pocket(12, 76, 220, 112);
sp_ft(13); ui_col(SPI2); v5_t(71, 96, sp_msl ? "MID" : "LEFT"); v5_t(173, 96, sp_msl ? "SIDE" : "RIGHT");
sp_gl = 0;
while (sp_gl < 2) (
  sp_gx = sp_gl == 0 ? 25 : 127; sp_mx = sp_gl == 0 ? sp_mxl : sp_mxr; sp_mr = sp_gl == 0 ? sp_mrl : sp_mrr;
  sp_glass(sp_gx, 110, 92, 62);
  sp_fc(24); ui_col(sp_mx >= -0.1 ? 0xC81E14 : 0x1A140C); v5_t(sp_gx + 46, 128, sp_fig(sp_mx));
  sp_fc(16); ui_col(sp_mx >= -0.1 ? 0xC81E14 : 0x1A140C);
  sp_mr <= -99.95 ? strcpy(#sp_rs, "RMS --") : sprintf(#sp_rs, "RMS %.1f", sp_mr);
  v5_t(sp_gx + 46, 157, #sp_rs);
  sp_gl += 1;
);
v5_pr && v5_drag == 0 && v5_hit(20, 84, 204, 96) ? ( sp_rst = 1; v5_drag = -1; );

sp_pocket(12, 198, 220, 344);
sp_y0 = 236; sp_y1 = 522; sp_lh = sp_y1 - sp_y0;
sp_xl = 38; sp_xr = 150; sp_bw = 56;
sp_ft(12); ui_col(SPI2); v5_t(122, 218, "OVER");
sp_led(sp_xl + sp_bw / 2, 218, 0xFF3A2A, sp_ovl);
sp_led(sp_xr + sp_bw / 2, 218, 0xFF3A2A, sp_ovr);
function sp_ydb(d) ( sp_y1 - (max(sp_bot, min(0, d)) - sp_bot) / -sp_bot * sp_lh; );
sp_ns = floor(sp_lh / 6);
sp_ss = sp_lh / sp_ns;
sp_gl = 0;
while (sp_gl < 2) (
  sp_x = sp_gl == 0 ? sp_xl : sp_xr;
  sp_pk = sp_gl == 0 ? sp_bl : sp_br; sp_rm = sp_gl == 0 ? sp_rml : sp_rmr; sp_hd = sp_gl == 0 ? sp_hl : sp_hr;
  ui_col(0x050505); v5_rr(sp_x - 4, sp_y0 - 4, sp_bw + 8, sp_lh + 8, 3);
  ui_col(0x0E0C0B); v5_r(sp_x - 2, sp_y0 - 2, sp_bw + 4, sp_lh + 4);
  sp_top = sp_bm == 1 ? sp_pk : sp_bm == 2 ? sp_rm : max(sp_pk, sp_rm);
  sp_top > sp_bot ? (
    sp_gy = sp_ydb(sp_top);
    sp_k = 0; loop(6,
      ui_cola(sp_rbw((sp_top - sp_bot) / -sp_bot), 0.035);
      v5_rr(sp_x - 3 - sp_k * 1.6, sp_gy - 2 - sp_k * 1.6, sp_bw + 6 + sp_k * 3.2, sp_y1 - sp_gy + 4 + sp_k * 3.2, 4 + sp_k);
      sp_k += 1; );
  );
  sp_hk = sp_hd > sp_bot ? floor((sp_hd - sp_bot) / -sp_bot * sp_ns - 0.0001) : -1;
  sp_k = 0;
  loop(sp_ns,
    sp_sd = sp_bot + (sp_k + 0.5) / sp_ns * -sp_bot;
    sp_st = sp_bot + sp_k / sp_ns * -sp_bot;
    sp_c = sp_rbw((sp_sd - sp_bot) / -sp_bot);
    sp_sy = sp_y1 - (sp_k + 1) * sp_ss + 1;
    sp_bm == 1 ? ( sp_lit = sp_pk > sp_st; sp_dim = 0; ) : sp_bm == 2 ? ( sp_lit = sp_rm > sp_st; sp_dim = 0; ) : ( sp_lit = sp_rm > sp_st; sp_dim = sp_pk > sp_st; );
    sp_lit ? ( ui_col(sp_c); ) : sp_dim ? ( ui_col(ui_mix(sp_c, 0x0E0C0B, 0.55)); ) : sp_k == sp_hk ? ( ui_col(sp_c); ) : ( ui_col(ui_mix(sp_c, 0x0E0C0B, 0.86)); );
    v5_r(sp_x, sp_sy, sp_bw, sp_ss - 2);
    sp_lit || sp_k == sp_hk ? (
      ui_cola(sp_c, 0.22); v5_r(sp_x - 2, sp_sy - 1, sp_bw + 4, sp_ss);
      ui_cola(ui_mix(sp_c, 0xFFFFFF, 0.55), 0.5); v5_r(sp_x + 3, sp_sy + 0.8, sp_bw - 6, max(1, sp_ss - 3.6));
    );
    sp_k == sp_hk ? ( ui_cola(0xFFFFFF, 0.45); v5_r(sp_x, sp_sy, sp_bw, 1.5); );
    sp_k += 1;
  );
  ui_cola(0xFFFFFF, 0.06); v5_r(sp_x, sp_y0, sp_bw * 0.4, sp_lh);
  sp_gl += 1;
);
sp_rng < 0.5 ? ( sp_m0 = 0; sp_mn = 11; ) : sp_rng < 1.5 ? ( sp_m0 = 11; sp_mn = 12; ) : ( sp_m0 = 23; sp_mn = 13; );
sp_i = 0;
loop(sp_mn,
  sp_j = sp_m0 + sp_i;
  sp_md = sp_j == 0 ? 0 : sp_j == 1 ? -3 : sp_j == 2 ? -6 : sp_j == 3 ? -9 : sp_j == 4 ? -12 : sp_j == 5 ? -18 : sp_j == 6 ? -24 : sp_j == 7 ? -30 : sp_j == 8 ? -40 : sp_j == 9 ? -50 : sp_j == 10 ? -60 :
          sp_j == 11 ? 0 : sp_j == 12 ? -3 : sp_j == 13 ? -6 : sp_j == 14 ? -9 : sp_j == 15 ? -12 : sp_j == 16 ? -15 : sp_j == 17 ? -18 : sp_j == 18 ? -21 : sp_j == 19 ? -24 : sp_j == 20 ? -30 : sp_j == 21 ? -35 : sp_j == 22 ? -40 :
          -2 * (sp_j - 23);
  sp_my = sp_ydb(sp_md);
  ui_col(sp_md == -18 ? SPA : SPI2);
  v5_d(sp_xl + sp_bw + 9, sp_my, sp_md == 0 || sp_md == -18 ? 1.8 : 1.3);
  v5_d(sp_xr - 9, sp_my, sp_md == 0 || sp_md == -18 ? 1.8 : 1.3);
  sp_fa(12); ui_col(sp_md == -18 ? SPA : SPI);
  sprintf(#sp_ms, "%d", sp_md); v5_t(122, sp_my, #sp_ms);
  sp_i += 1;
);
v5_pr && v5_drag == 0 && v5_hit(20, 206, 204, 328) ? ( sp_rst = 1; v5_drag = -1; );

sp_pocket1(12, 552, 220, 96);
v5_sel(24, 562, 94, 34, 8, 5, 2, "L / R|M / S", 1);
v5_sel(20, 604, 66, 34, 3, 6, 3, "BOTH|PEAK|RMS", 1);
sp_pocket1(12, 656, 220, 56);
sp_rn = sp_rng | 0;
sp_mbox(22, 678, 96, 26, "RANGE", sp_rn == 0 ? "60 dB" : sp_rn == 1 ? "40 dB" : "24 dB") ? (
  gfx_x = 22 * sc; gfx_y = 706 * sc;
  sp_r = gfx_showmenu(sp_rn == 0 ? "!60 dB|40 dB|24 dB" : sp_rn == 1 ? "60 dB|!40 dB|24 dB" : "60 dB|40 dB|!24 dB");
  sp_r > 0 ? ( slider(1) = sp_r - 1; ui_auto(1); );
);
sp_hn = sp_hold | 0;
sp_mbox(126, 678, 96, 26, "PEAK HOLD", sp_hn == 0 ? "1 s" : sp_hn == 1 ? "3 s" : "INFINITE") ? (
  gfx_x = 126 * sc; gfx_y = 706 * sc;
  sp_r = gfx_showmenu(sp_hn == 0 ? "!1 s|3 s|Infinite" : sp_hn == 1 ? "1 s|!3 s|Infinite" : "1 s|3 s|!Infinite");
  sp_r > 0 ? ( slider(2) = sp_r - 1; ui_auto(2); );
);

ui_help_clk = 0;
ui_help_open ? (
  ui_help_open && v5_pr && !ui_help_new && (ui_mx < sp_cx || ui_mx >= sp_cx + sp_cw || ui_my < sp_cy || ui_my >= sp_cy + sp_ch) ? ui_help_open = 0 : ui_help_clk = v5_pr && !ui_help_new;
);
ui_help_new = 0;
ui_help_open ? (
