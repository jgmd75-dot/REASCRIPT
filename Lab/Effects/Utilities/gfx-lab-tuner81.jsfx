desc:Tuner81 [tuner] (GFX Lab)
//tags: tuner guitar bass chromatic strobe needle ladder utility
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider8:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:tn_disp=1<0,2,1{Ladder,Needle,Strobe}>-Display
slider2:tn_ref=440<400,480,1>-Reference A4 (Hz)
slider3:tn_sens=60<0,100,1>-Sensitivity (%)
slider4:tn_mute=0<0,1,1{Off,On}>-Mute
slider5:tn_flat=0<0,1,1{Sharps,Flats}>-Note names
slider6:tn_byp=0<0,1,1{Off,On}>-Bypass
slider7:prs_sel=0<0,10,1{No preset,Init,Guitar Strobe,Bass Needle,Stage Ladder,Quiet Room,Horn Section (flats),Baroque 415,Concert 442,Orchestra 443,Low A 432}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

@init
function psw_all(v) ( slider_show(255, v); );
function psw_allg(v) ( slider_show(255, v); );
#ui_man = "gfx-lab-tuner81";
ext_noinit = 1;
ext_nodenorm = 1;

st_D = max(1, floor(srate / 7500 + 0.5));
st_fs = srate / st_D;
st_N = 4096; st_MASK = st_N - 1;
st_RB = 200000;
st_X = 205000;
st_XF = 208000;
st_DF = 215000;
st_CM = 217000;
st_L = 2048;
st_win = floor(0.04 * st_fs);
st_tmin = max(2, floor(st_fs / 1400));
st_tmax = min(ceil(st_fs / 24), 1000);
st_hop = floor(0.025 * st_fs);
st_dt = st_hop / st_fs;
st_W2min = floor(0.03 * st_fs);
st_Lref = floor(0.16 * st_fs);

function st_lp_set(f, q) instance(b0, b1, b2, a1, a2) local(w, cs, al, a0) (
  w = 2 * $pi * f / srate; cs = cos(w); al = sin(w) / (2 * q); a0 = 1 + al;
  b0 = (1 - cs) * 0.5 / a0; b1 = (1 - cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0;
);
function st_lp(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y;
  abs(z1) < 0.000000000001 ? z1 = 0; abs(z2) < 0.000000000001 ? z2 = 0;
  y;
);
st_fc = min(1900, 0.3 * st_fs);
st_lpA.st_lp_set(st_fc, 0.5412); st_lpB.st_lp_set(st_fc, 1.3066);
st_hpR = exp(-2 * $pi * 12 / st_fs);
st_mstep = 1 / (0.02 * srate);

function st_bp(f0, q) local(w, cs, al, a0, b0, a1, a2, i, x, y, z1, z2, p) (
  w = 2 * $pi * min(f0, 0.42 * st_fs) / st_fs; cs = cos(w); al = sin(w) / (2 * q); a0 = 1 + al;
  b0 = al / a0; a1 = -2 * cs / a0; a2 = (1 - al) / a0;
  p = st_w & st_MASK; i = 0;
  loop(st_N, st_XF[i] = st_RB[p]; p = (p + 1) & st_MASK; i += 1; );
  loop(4,
    z1 = 0; z2 = 0; p = st_XF;
    loop(st_N, x = p[0]; y = b0 * x + z1; z1 = -a1 * y + z2; z2 = -b0 * x - a2 * y; p[0] = y; p += 1; );
  );
);

function st_dl(lag, w2) local(a, b, v, d, ea, eb) (
  b = st_src + st_L - w2; a = b - lag; d = 0; ea = 0; eb = 0;
  loop(w2, v = a[0] - b[0]; d += v * v; ea += a[0] * a[0]; eb += b[0] * b[0]; a += 1; b += 1; );
  st_ea = ea; st_eb = eb;
  d;
);
function st_refine(k, per, w2) local(c, dm, dp, d0, n, den, off) (
  c = floor(k * per + 0.5);
  d0 = st_dl(c, w2); dm = st_dl(c - 1, w2); dp = st_dl(c + 1, w2);
  n = 0;
  while (n < 6 && dm < d0) ( c -= 1; dp = d0; d0 = dm; dm = st_dl(c - 1, w2); n += 1; );
  while (n < 6 && dp < d0) ( c += 1; dm = d0; d0 = dp; dp = st_dl(c + 1, w2); n += 1; );
  st_dl(c, w2);
  den = dm - 2 * d0 + dp;
  off = den > 0 ? 0.5 * (dm - dp) / den : 0;
  off = min(max(off, -0.5), 0.5);
  st_lag = c + off;
  (d0 - 0.25 * (dm - dp) * off) / max(st_ea + st_eb, 0.0000000001) > 0.06 || dm < d0 || dp < d0 ? 0 : (c + off) / k;
);
function st_dy(t) local(p, q, v, d) (
  d = 0; p = st_X + st_s0; q = p + t;
  loop(st_win, v = p[0] - q[0]; d += v * v; p += 1; q += 1; );
  d;
);
function st_cmin(c) local(t, t0, t1, m, b) (
  t0 = max(st_tmin, floor(c * 0.97) - 1); t1 = min(st_tmax + 39, ceil(c * 1.03) + 1);
  m = 10; b = -1; t = t0;
  while (t <= t1) ( st_CM[t] < m ? ( m = st_CM[t]; b = t; ); t += 1; );
  st_cb = b;
  m;
);

function st_detect() local(i, p, q, t, d, v, sum, cm, best, gmin, gt, go, a, b, c, den, off, per, k, w2, lt, nper, e, f, lf, m, n, nr, cb, c2, c3, b2, b3, zp, r) (
  p = (st_w - st_L) & st_MASK; i = 0;
  loop(st_L, st_X[i] = st_RB[p]; p = (p + 1) & st_MASK; i += 1; );
  e = 0; p = st_X + st_L - st_win; loop(st_win, e += p[0] * p[0]; p += 1; );
  st_plv = st_lvl;
  st_lvl = 10 * log10(e / st_win + 0.00000000001);
  st_open ? ( st_lvl < st_thr - 6 ? st_open = 0; ) : ( st_lvl > st_thr ? st_open = 1; );
  st_open ? (
    st_s0 = st_L - st_win - st_tmax - 41;
    sum = 0; t = 1;
    loop(st_tmax + 39,
      d = 0; p = st_X + st_s0; q = p + t;
      loop(st_win, v = p[0] - q[0]; d += v * v; p += 1; q += 1; );
      st_DF[t] = d; sum += d;
      st_CM[t] = sum > 0 ? d * t / sum : 1;
      t += 1;
    );
    best = -1; gmin = 10; gt = -1; t = st_tmin;
    while (t < st_tmax) (
      cm = st_CM[t];
      cm < gmin ? ( gmin = cm; gt = t; );
      best < 0 && cm < 0.15 ? (
        best = t;
        while (best + 1 < st_tmax + 39 && st_CM[best + 1] < st_CM[best]) ( best += 1; );
        t = st_tmax;
      );
      t += 1;
    );
    best < 0 && gt > 0 && gmin < 0.3 ? best = gt;
    best >= st_tmax || best < 2 ? best = -1;
    best > 0 ? (
      cb = st_CM[best];
      c2 = 2 * best <= st_tmax ? st_cmin(2 * best) : 10; b2 = st_cb;
      c3 = 3 * best <= st_tmax ? st_cmin(3 * best) : 10; b3 = st_cb;
      cb > 0.02 ? (
        c3 < c2 && c3 < cb * 0.35 ? best = b3 : c2 < cb * 0.35 ? best = b2;
      );
      st_conf = st_CM[best];
      b = st_DF[best]; c = st_dy(best + 1); a = st_dy(best - 1);
      n = 0;
      while (n < 12 && c < b && best + 1 < st_tmax + 40) ( best += 1; a = b; b = c; c = st_dy(best + 1); n += 1; );
      while (n < 12 && a < b && best > 2) ( best -= 1; c = b; b = a; a = st_dy(best - 1); n += 1; );
      den = a - 2 * b + c; off = den > 0 ? 0.5 * (a - c) / den : 0;
      per = best + min(max(off, -0.5), 0.5);
      st_bp(st_fs / per, 1.2);
      st_src = st_XF + st_N - st_L;
      w2 = floor(ceil(st_W2min / per) * per + 0.5);
      lt = min(st_Lref, st_L - w2 - 6);
      st_lag = per;
      k = 1; go = 1;
      while (go && k * 2 * per <= lt) (
        nper = st_refine(k * 2, per, w2);
        nper > 0 ? ( per = nper; k *= 2; ) : go = 0;
      );
      go ? ( m = floor(lt / per); m > k ? ( nper = st_refine(m, per, w2); nper > 0 ? ( per = nper; k = m; ); ); );
      st_span = (k * per + w2) * 0.5 / st_fs;
      f = st_fs / per;
      f >= 23 && f <= 1450 ? (
        lf = log(f) / log(2);
        st_age > 0.3 || st_lvl > st_plv + 6 ? st_nrd = 0 : st_nrd += 1;
        st_nrd >= 10 ? (
          abs(lf - st_pos - 1) < 0.04 ? lf -= 1 : abs(lf - st_pos + 1) < 0.04 ? lf += 1;
        );
        st_age > 0.3 ? ( st_h1 = lf; st_h2 = lf; );
        m = max(min(lf, st_h1), min(max(lf, st_h1), st_h2));
        st_h2 = st_h1; st_h1 = lf;
        zp = st_pos + st_vel * st_dt;
        r = m - zp;
        st_age > 0.3 || abs(r) > 0.0208 ? ( st_pos = m; st_vel = 0; ) : (
          st_pos = zp + 0.3 * r;
          st_vel = min(max(st_vel + 0.04 * r / st_dt, -0.17), 0.17);
        );
        st_lf = st_pos + st_vel * st_span * min(1, max(0, (abs(st_vel) - 0.009) / 0.006));
        n = 69 + 12 * (st_lf - log(st_ref) / log(2)); nr = floor(n + 0.5);
        st_age > 0.3 || st_note < 0 || abs(n - st_note) > 0.62 ? ( st_note = nr; st_cc = 0; ) :
        abs(n - st_note) > 0.5 ? (
          nr == st_cand ? st_cc += 1 : ( st_cand = nr; st_cc = 1; );
          st_cc >= 3 ? ( st_note = nr; st_cc = 0; );
        ) : st_cc = 0;
        st_cents = (n - st_note) * 100;
        st_freq = 2 ^ st_lf;
        st_age = 0; st_seq += 1;
      );
    );
  );
);

function st_update() (
  st_ref = tn_ref;
  st_thr = -24 - 0.56 * tn_sens;
  st_mute = tn_mute >= 0.5 && tn_byp < 0.5;
);

st_w = 0; st_cnt = 0; st_new = 0; st_open = 0; st_age = 100; st_note = -1; st_cand = -1; st_cc = 0;
st_lf = 0; st_pos = 0; st_vel = 0; st_h1 = st_h2 = 0; st_cents = 0; st_freq = 0; st_lvl = -120; st_seq = 0; st_span = 0;
st_hx = st_hy = 0;
memset(st_RB, 0, 20000);
st_update();
st_mr = st_mute ? 0 : 1;

TS7 = 230000; memset(TS7, 0, 128);
TS7['0'] = 63; TS7['1'] = 6; TS7['2'] = 91; TS7['3'] = 79; TS7['4'] = 102; TS7['5'] = 109; TS7['6'] = 125;
TS7['7'] = 7; TS7['8'] = 127; TS7['9'] = 111; TS7[65] = 119; TS7[66] = 124; TS7[98] = 124; TS7[67] = 57;
TS7[68] = 94; TS7[69] = 121; TS7[70] = 113; TS7[71] = 61; TS7['-'] = 64; TS7['+'] = 128; TS7['#'] = 256;
STP = 231000; memset(STP, 0, 8);

NP = 10;
function pp(md, rf, sn, nm) (
  slider(1) = md; slider(2) = rf; slider(3) = sn; slider(5) = nm; slider(4) = 0;
);
function load_preset(p) (
  p == 1  ? pp(1, 440, 60, 0) :
  p == 2  ? pp(2, 440, 60, 0) :
  p == 3  ? pp(1, 440, 72, 0) :
  p == 4  ? pp(0, 440, 42, 0) :
  p == 5  ? pp(1, 440, 88, 0) :
  p == 6  ? pp(0, 440, 60, 1) :
  p == 7  ? pp(2, 415, 60, 1) :
  p == 8  ? pp(1, 442, 60, 0) :
  p == 9  ? pp(1, 443, 60, 0) :
  p == 10 ? pp(0, 432, 60, 0);
  p >= 1 && p <= NP ? slider_automate(31);
);

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; ); ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(6, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= NP ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(NP, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
st_update();

@block
prs_chk();
st_update();
st_age += samplesblock / srate;
st_new >= st_hop ? ( st_new = 0; tn_byp < 0.5 ? st_detect() : st_age = 100; );

@serialize
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, pr_cur) : pr_cur = 0;
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
st_y = st_lpB.st_lp(st_lpA.st_lp((spl0 + spl1) * 0.5));
st_cnt += 1;
st_cnt >= st_D ? (
  st_cnt = 0;
  st_hy = st_y - st_hx + st_hpR * st_hy; st_hx = st_y;
  abs(st_hy) < 0.000000000001 ? st_hy = 0;
  st_RB[st_w] = st_hy; st_w = (st_w + 1) & st_MASK; st_new += 1;
);
st_mute ? ( st_mr > 0 ? st_mr = max(st_mr - st_mstep, 0); ) : ( st_mr < 1 ? st_mr = min(st_mr + st_mstep, 1); );
st_mr < 1 ? (
  st_g = st_mr * st_mr * (3 - 2 * st_mr);
  spl0 *= st_g; spl1 *= st_g;
);

@gfx 900 355
ui_begin(900, 355);
v5_begin();
TNF = 0x2A403C; TNI = 0xE6F0EC; TNI2 = 0xB4CAC3; TWK = 0xA8D8C8; TGH = 0x15201D; TWB = 0x070B0A;
TOK = 0x39FF6A; TMD = 0xFFB030; THT = 0xFF3A2A;
sc != tg_fsc ? (
  tg_fsc = sc;
  tg_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  tg_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  tg_f6 = ui_fitfont(6, 26 * sc);
);
function tg_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * tg_kt * sc, 'b'); );
function tg_fa(px) ( gfx_setfont(10, "Arial", px * tg_ka * sc, 'b'); );
function tg_fc(px) ( gfx_setfont(12, "Courier New", px * tg_kt * sc, 'b'); );
function tg_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function tg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function tg_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function tg_txt(x, cy, s, al) ( al == 0 ? tg_tl(x, cy, s) : al == 2 ? tg_tr(x, cy, s) : v5_t(x, cy, s); );
function tg_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function tg_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9C98); v5_d(x, y, 4); ui_col(0xBCCEC9); v5_d(x - 0.8, y - 0.8, 2.4); );
function tg_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.14); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.16)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(ui_mix(f, 0, 0.10 + d * 0.012)); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function tg_pocket(x, y, w, h) (
  tg_cham(x, y, w, h, 3, TNF);
  ui_col(ui_mix(TNF, 0, 0.14)); v5_r(x + 3, y + 3, w - 6, h - 6);
  tg_cham(x + 8, y + 8, w - 16, h - 16, 3, ui_mix(TNF, 0, 0.10));
);
function tg_pocket1(x, y, w, h) ( tg_cham(x, y, w, h, 3, TNF); ui_col(ui_mix(ui_mix(TNF, 0, 0.10), 0, 0.136)); v5_r(x + 3, y + 3, w - 6, h - 6); );
function tg_win(x, y, w, h) (
  ui_col(0x030404); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x141C1A); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  ui_col(TWB); v5_r(x, y, w, h);
  ui_cola(0, 0.45); v5_r(x, y, w, 3); v5_r(x, y + 3, 3, h - 3);
  ui_cola(TWK, 0.05); v5_r(x, y + h - 1, w, 1);
);
function tg_wtxt(x, cy, s, al, c, a) (
  ui_cola(c, 0.16 * a); tg_txt(x - 0.6, cy, s, al); tg_txt(x + 0.6, cy, s, al);
  ui_cola(c, a); tg_txt(x, cy, s, al);
);
function tg_cell(x, y, w, h, c, k) (
  ui_col(TGH); v5_rr(x, y, w, h, 1.5);
  k > 0 ? (
    ui_cola(c, 0.16 * k); v5_rr(x - 2.5, y - 2.5, w + 5, h + 5, 3);
    ui_cola(c, 0.9 * k + 0.1); v5_rr(x, y, w, h, 1.5);
    ui_cola(0xFFFFFF, 0.2 * k); v5_r(x + 1.5, y + 1.5, w - 3, h * 0.28);
  );
);
function tg_ccol(c) ( c = abs(c); c < 3 ? TOK : c < 15 ? TMD : THT; );
function tg_seg(x1, y1, x2, y2, t, on, col, k) local(h, g) (
  h = t * 0.5; g = t * 0.12 + 0.35;
  on ? ( ui_cola(col, 0.12 * k); x1 == x2 ? v5_r(x1 - h - 1, y1 - 0.5, t + 2, y2 - y1 + 1) : v5_r(x1 - 0.5, y1 - h - 1, x2 - x1 + 1, t + 2);
         ui_cola(col, 0.25 + 0.75 * k); ) : ui_col(TGH);
  x1 == x2 ? gfx_triangle(x1 * sc, (y1 + g) * sc, (x1 + h) * sc, (y1 + g + h) * sc, (x1 + h) * sc, (y2 - g - h) * sc,
                          x1 * sc, (y2 - g) * sc, (x1 - h) * sc, (y2 - g - h) * sc, (x1 - h) * sc, (y1 + g + h) * sc)
           : gfx_triangle((x1 + g) * sc, y1 * sc, (x1 + g + h) * sc, (y1 - h) * sc, (x2 - g - h) * sc, (y1 - h) * sc,
                          (x2 - g) * sc, y1 * sc, (x2 - g - h) * sc, (y1 + h) * sc, (x1 + g + h) * sc, (y1 + h) * sc);
);
function tg_7seg(x, y, w, h, c, col, k) local(m, t, xl, xr, yt, ym, yb) (
  m = TS7[c & 127]; t = max(w * 0.17, 2);
  xl = x + t * 0.5; xr = x + w - t * 0.5; yt = y + t * 0.5; ym = y + h * 0.5; yb = y + h - t * 0.5;
  m & 256 ? (
