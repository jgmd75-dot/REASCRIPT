#c9_ol = "Input|Ch 1|Ch 2|Ch 3|Ch 4|Ch 5|Ch 6|Ch 7|Ch 8|Ch 9|Ch 10|Ch 11|Ch 12|Ch 13|Ch 14|Ch 15|Ch 16";
(sc != w_csc || gfx_w != w_cw || gfx_h != w_ch) ? (
