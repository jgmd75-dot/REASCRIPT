desc:Evenlode [counterpoint arpeggiator] (GFX Lab)
//tags: midi arpeggiator arp counterpoint canon inversion retrograde augmentation harmony utility
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider30:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:shold=1<0,1,1{Off,On}>-Hold
slider2:sstep=7<0,11,1{2 bars,1 bar,1/2,1/4 dotted,1/4,1/4 triplet,1/8 dotted,1/8,1/8 triplet,1/16,1/16 triplet,1/32}>-Rate
slider3:skey=0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Key
slider4:sscale=0<0,3,1{Major,Minor,Harmonic minor,Dorian}>-Scale
slider5:snotes=2<0,4,1{4,6,8,12,16}>-Notes kept
slider6:sgate=80<10,100,1>-Gate (%)
slider7:sinkey=1<0,1,1{Exact intervals,In key}>-Intervals
slider8:schans=0<0,1,1{Off,On}>-Voices on channels 1 to 4
slider9:v1_on=1<0,1,1{Off,On}>-Subject on
slider10:v1_oct=0<-2,2,1>-Subject octave
slider11:v1_vel=90<0,100,1>-Subject velocity (%)
slider12:a_on=1<0,1,1{Off,On}>-Answer on
slider13:a_form=1<0,3,1{As played,Mirror,Reverse,Reverse mirror}>-Answer form
slider14:a_speed=2<0,3,1{Four times slower,Two times slower,Same,Two times faster}>-Answer speed
slider15:a_int=1<0,9,1{Two octaves down,Octave down,Fifth down,Fourth down,Third down,Unison,Third up,Fourth up,Fifth up,Octave up}>-Answer pitch
slider16:a_entry=2<0,16,1>-Answer entry (steps)
slider17:a_vel=80<0,100,1>-Answer velocity (%)
slider18:c_on=0<0,1,1{Off,On}>-Counter on
slider19:c_form=2<0,3,1{As played,Mirror,Reverse,Reverse mirror}>-Counter form
slider20:c_speed=1<0,3,1{Four times slower,Two times slower,Same,Two times faster}>-Counter speed
slider21:c_int=0<0,9,1{Two octaves down,Octave down,Fifth down,Fourth down,Third down,Unison,Third up,Fourth up,Fifth up,Octave up}>-Counter pitch
slider22:c_entry=4<0,16,1>-Counter entry (steps)
slider23:c_vel=70<0,100,1>-Counter velocity (%)
slider24:sbass=0<0,1,1{Off,On}>-Bass line
slider25:ssus=0<0,100,1>-Suspensions (%)
slider26:spath=0<0,5,1{Home,To fifth,To fourth,To relative,I IV V I,I VI IV V}>-Key path
slider27:sexch=0<0,1,1{Off,On}>-Voice exchange
slider28:sbyp=0<0,1,1{Off,On}>-Bypass
slider29:prs_sel=0<0,12,1{No preset,Mirror Answer,Three-Voice Canon,Crab Canon,Slow Cantus,Running Counter,Stretto Pile,Chorale Bass,Suspensions,Round of Keys,Relative Turn,Voice Exchange,Fifth Answer}>-Preset

in_pin:none
out_pin:none

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
function psw_all(v) ( slider_show(1073741823, v); );
function psw_allg(v) ( slider_show(1073741823, v); );
#ui_man = "gfx-lab-evenlode";
#cp_pm = "Mirror Answer|Three-Voice Canon|Crab Canon|Slow Cantus|Running Counter|Stretto Pile|Chorale Bass|Suspensions|Round of Keys|Relative Turn|Voice Exchange|Fifth Answer";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;

HP = 1000;  HS = 1040;  HV = 1080;
SCL = 1200;  PTH = 1240;  PTN = 1270;  IVD = 1280;  IVS = 1290;  SPF = 1300;
QT = 6000;  QY = 6600;  QC = 7200;  QN = 7800;  QV = 8400;  QMAX = 560;
SN = 10000;
LPB = 12420;  VON = 12430;  VFM = 12440;  VSF = 12450;  VIV = 12460;  VEN = 12470;  VVL = 12480;  VOC = 12490;
LDN = 12500;  LDF = 12510;  LDS = 12520;  LSD = 12540;  THR = 12600;  STL = 12740;  STV = 12760;

SCL[0] = 0;  SCL[1] = 2;  SCL[2] = 4;  SCL[3] = 5;  SCL[4] = 7;  SCL[5] = 9;  SCL[6] = 11;
SCL[8] = 0;  SCL[9] = 2;  SCL[10] = 3;  SCL[11] = 5;  SCL[12] = 7;  SCL[13] = 8;  SCL[14] = 10;
SCL[16] = 0;  SCL[17] = 2;  SCL[18] = 3;  SCL[19] = 5;  SCL[20] = 7;  SCL[21] = 8;  SCL[22] = 11;
SCL[24] = 0;  SCL[25] = 2;  SCL[26] = 3;  SCL[27] = 5;  SCL[28] = 7;  SCL[29] = 9;  SCL[30] = 10;
PTH[0] = 0;  PTN[0] = 1;
PTH[4] = 0;  PTH[5] = 1;  PTN[1] = 2;
PTH[8] = 0;  PTH[9] = 2;  PTN[2] = 2;
PTH[12] = 0;  PTH[13] = 3;  PTN[3] = 2;
PTH[16] = 0;  PTH[17] = 2;  PTH[18] = 1;  PTH[19] = 0;  PTN[4] = 4;
PTH[20] = 0;  PTH[21] = 3;  PTH[22] = 2;  PTH[23] = 1;  PTN[5] = 4;
IVD[0] = -14;  IVD[1] = -7;  IVD[2] = -4;  IVD[3] = -3;  IVD[4] = -2;  IVD[5] = 0;  IVD[6] = 2;  IVD[7] = 3;  IVD[8] = 4;  IVD[9] = 7;
IVS[0] = -24;  IVS[1] = -12;  IVS[2] = -7;  IVS[3] = -5;  IVS[4] = -4;  IVS[5] = 0;  IVS[6] = 4;  IVS[7] = 5;  IVS[8] = 7;  IVS[9] = 12;
SPF[0] = 0.25;  SPF[1] = 0.5;  SPF[2] = 1;  SPF[3] = 2;

memset(SN, 0, 2048);  memset(THR, 0, 128);  cp_capt = 0;  cp_rec = 0;  cp_lat = 0;  stn = 0;  cp_tk = -1;  rec_dirty = 0;  clr_dirty = 0;  rest_dirty = 0;
q_n = 0;  os_n = 0;  oh_n = 0;  cp_scnt = 0;  cp_in = 0;  cp_mid = 0;  cp_lon = -1000000000;
cp_wrun = 0;  cp_wplay = 0;  cp_fb = 0;  cp_exp = 0;  g_tp = 0;  g_gpp = 0;  g_gpd = 0;  cp_wbyp = 0;
cp_g0 = -1;  cp_lb = -1;  cp_lm = -1;  cp_newp = 0;
cp_i = 0;  loop(4, LPB[cp_i] = -1000000000;  LDN[cp_i] = -1;  LDF[cp_i] = 0;  LDS[cp_i] = 0;  cp_i += 1; );

function q_add(t, ty, c, n, v) (
  q_n < QMAX ? ( QT[q_n] = t;  QY[q_n] = ty;  QC[q_n] = c;  QN[q_n] = n;  QV[q_n] = v;  q_n += 1; );
);
function q_note(t, d, n, v, c) (
  n >= 0 && n <= 127 ? (
    q_add(t, 2, c, n, min(max(floor(v + 0.5), 1), 127));
    q_add(t + d, 0, c, n, 0);
  );
);
function q_emit(t0, ns) local(i, b, bt, by, ofs, k, c, n) (
  loop(q_n,
    b = -1;  bt = 0;  by = 0;  i = 0;
    loop(q_n, QT[i] < t0 + ns && (b < 0 || QT[i] < bt || (QT[i] == bt && QY[i] < by)) ? ( b = i;  bt = QT[i];  by = QY[i]; );  i += 1; );
    b >= 0 ? (
      ofs = min(max(floor(bt - t0), 0), ns - 1);
      c = QC[b];  n = QN[b];  k = SN + c * 128 + n;
      by == 2 ? (
        k[0] > 0 ? midisend(ofs, 0x80 | c, n, 0);
        midisend(ofs, 0x90 | c, n, QV[b]);  k[0] += 1;
      ) : (
        k[0] > 0 ? ( k[0] -= 1;  k[0] == 0 ? midisend(ofs, 0x80 | c, n, 0); );
      );
      q_n -= 1;
      QT[b] = QT[q_n];  QY[b] = QY[q_n];  QC[b] = QC[q_n];  QN[b] = QN[q_n];  QV[b] = QV[q_n];
    );
  );
);
function q_flush(ofs) local(i) (
  q_n = 0;
  i = 0;  loop(2048, SN[i] > 0 ? ( midisend(ofs, 0x80 | (i >> 7), i & 127, 0);  SN[i] = 0; );  i += 1; );
);

function cp_md(a, n) ( a - n * floor(a / n); );
function cp_hash(c, L) local(x) ( x = sin(c * 12.9898 + L * 78.233) * 43758.5453;  x - floor(x); );
function cp_bar() ( max(1, ts_num | 0) * 4 / (ts_denom > 0 ? ts_denom : 4); );
function cp_drop() local(i) (
  i = 0;  loop(os_n - 1, HS[i] = HS[i + 1];  HV[i] = HV[i + 1];  i += 1; );
  os_n -= 1;
);
function cp_hp(n, on) local(i, f) (
  on ? (
    f = 0;  i = 0;  loop(oh_n, HP[i] == n ? f = 1;  i += 1; );
    !f && oh_n < 32 ? ( HP[oh_n] = n;  oh_n += 1; );
  ) : (
    i = 0;  f = -1;  loop(oh_n, HP[i] == n ? f = i;  i += 1; );
    f >= 0 ? ( i = f;  loop(oh_n - f - 1, HP[i] = HP[i + 1];  i += 1; );  oh_n -= 1; );
  );
);
function cp_rest() (
  stn < 16 ? ( STL[stn] = -1;  STV[stn] = 0;  stn += 1;  stn >= 16 ? cp_recend = 1; );
);
function cp_key(n, v, c, on, tnow, ofs) local(i, f) (
  cp_in = c;
  cp_rec ? (
    on ? (
      THR[n] > 0 ? midisend(ofs, 0x80 | c, n, 0);  midisend(ofs, 0x90 | c, n, v);  THR[n] = c + 1;
      stn < 16 ? ( STL[stn] = n;  STV[stn] = v;  stn += 1;  stn >= 16 ? cp_recend = 1; );
    ) : ( THR[n] > 0 ? ( midisend(ofs, 0x80 | (THR[n] - 1), n, 0);  THR[n] = 0; ); );
  ) : stn > 0 ? (
    on ? ( cp_tk = n;  cp_lat = 1; );
    cp_hp(n, on);
  ) : on ? (
    cp_hold && !cp_capt ? ( os_n = 0;  cp_newp = 1; );
    cp_hold ? ( cp_capt = 1;  THR[n] > 0 ? midisend(ofs, 0x80 | c, n, 0);  midisend(ofs, 0x90 | c, n, v);  THR[n] = c + 1; );
    cp_lon = tnow;
    f = 0;  i = 0;  loop(oh_n, HP[i] == n ? f = 1;  i += 1; );
    !f && oh_n < 32 ? ( HP[oh_n] = n;  oh_n += 1; );
    cp_hold ? (
      os_n >= cp_keep ? cp_drop();
      HS[os_n] = n;  HV[os_n] = v;  os_n += 1;
    ) : (
      f = 0;  i = 0;  loop(os_n, HS[i] == n ? ( f = 1;  HV[i] = v; );  i += 1; );
      !f ? ( os_n >= cp_keep ? cp_drop();  HS[os_n] = n;  HV[os_n] = v;  os_n += 1; );
    );
  ) : (
    THR[n] > 0 ? ( midisend(ofs, 0x80 | (THR[n] - 1), n, 0);  THR[n] = 0; );
    i = 0;  f = -1;  loop(oh_n, HP[i] == n ? f = i;  i += 1; );
    f >= 0 ? ( i = f;  loop(oh_n - f - 1, HP[i] = HP[i + 1];  i += 1; );  oh_n -= 1; );
    !cp_hold ? (
      i = 0;  f = -1;  loop(os_n, HS[i] == n ? f = i;  i += 1; );
      f >= 0 ? ( i = f;  loop(os_n - f - 1, HS[i] = HS[i + 1];  HV[i] = HV[i + 1];  i += 1; );  os_n -= 1; );
    );
  );
);
function cp_steps(r) local(bar) (
  bar = cp_bar();
  r == 0 ? 2 * bar : r == 1 ? bar : r == 2 ? 2 : r == 3 ? 1.5 : r == 4 ? 1 : r == 5 ? 2 / 3 :
  r == 6 ? 0.75 : r == 7 ? 0.5 : r == 8 ? 1 / 3 : r == 9 ? 0.25 : r == 10 ? 1 / 6 : 0.125;
);
function cp_deg(n, root, s) local(r, o, pc, i, k) (
  r = n - root;  o = floor(r / 12);  pc = r - o * 12;
  k = 0;  i = 0;  loop(7, SCL[s * 8 + i] <= pc ? k = i;  i += 1; );
  cp_df = pc - SCL[s * 8 + k];
  o * 7 + k;
);
function cp_pit(d, f, root, s) ( root + floor(d / 7) * 12 + SCL[s * 8 + cp_md(d, 7)] + f; );
function cp_path(cyc) local(code, o) (
  code = PTH[cp_pa * 4 + cp_md(cyc, PTN[cp_pa])];
  cp_pc = code;
  code == 1 ? ( o = -5;  cp_ps = cp_s; ) : code == 2 ? ( o = 5;  cp_ps = cp_s; ) :
  code == 3 ? ( cp_s == 0 ? ( o = -3;  cp_ps = 1; ) : ( o = 3;  cp_ps = 0; ); ) : ( o = 0;  cp_ps = cp_s; );
  cp_pr = cp_k + o;
);
function cp_note(L, c, tb) local(n, i, a, p, d, f, iv, cyc, ad, fm) (
  n = os_n;
  i = cp_md(c, n);  VFM[L] >= 2 ? i = n - 1 - i;
  n <= 0 ? -1 : HS[i] < 0 ? -1 : (
    cyc = floor(floor((tb - cp_g0) / cp_sb + 0.0001) / n);
    cp_path(cyc);
    fm = VFM[L];
    p = HS[i];  a = cp_ax;  cp_nv = HV[i];
    iv = VIV[L];
    cp_exch && (L == 1 || L == 2) && cp_md(cyc, 2) == 1 ? iv = VIV[3 - L];
    cp_ink ? (
      d = cp_deg(p, cp_k, cp_s);  f = cp_df;
      fm == 1 || fm == 3 ? ( ad = cp_deg(a, cp_k, cp_s);  d = 2 * ad - d;  f = -f; );
      d += IVD[iv] + VOC[L] * 7;
      cp_pit(d, f, cp_pr, cp_ps);
    ) : (
      fm == 1 || fm == 3 ? p = 2 * a - p;
      p += IVS[iv] + VOC[L] * 12;
      d = cp_deg(p, cp_k, cp_s);
      cp_pit(d, cp_df, cp_pr, cp_ps);
    );
  );
);
function cp_bass(tb) local(kk, m, dm, j, r, pc, p, best, bc, cost, md, bd, iv, piv, k) (
  kk = floor((tb - cp_g0) / cp_sb + 0.0001);
  m = cp_note(0, kk, tb);
  m < 0 ? -1 : (
    m -= VOC[0] * 12;
    cp_bv = cp_nv;
    dm = cp_deg(m, cp_pr, cp_ps);
    cp_lb < 0 ? ( cp_lb = 36 + cp_md(cp_pr - 36, 12);  cp_lb < 40 ? cp_lb += 12;  cp_lm = m; );
    best = -1;  bc = 1000000;
    j = 0;
    loop(3,
      r = dm - j * 2;
      pc = cp_md(cp_pit(r, 0, cp_pr, cp_ps), 12);
      p = 33 + cp_md(pc - 33, 12);
      k = 0;
      loop(2,
        p <= 57 ? (
          cost = abs(p - cp_lb) * 0.5;
          md = sign(m - cp_lm);  bd = sign(p - cp_lb);
          md != 0 && bd == md ? cost += 3;
          p == cp_lb ? cost += 1.5;
          iv = cp_md(m - p, 12);  piv = cp_md(cp_lm - cp_lb, 12);
          (iv == 0 || iv == 7) && iv == piv && p != cp_lb ? cost += 5;
          cost += j == 0 ? 0.6 : j == 1 ? 0 : 0.9;
          cp_md(kk, os_n) == 0 && cp_md(r, 7) == 0 ? cost -= 2.5;
          cost += cp_hash(kk, 7 + j * 2 + k) * 0.8;
          cost < bc ? ( bc = cost;  best = p; );
        );
        p += 12;  k += 1;
      );
      j += 1;
    );
    best >= 0 ? ( cp_lb = best;  cp_lm = m; );
    best;
  );
);
function cp_trig(L, c, tq, sl, tb, vb) local(n, nn, pv, ch, vs, nlen, up, d, t0, sc0, sn0) (
  ch = schans >= 0.5 ? L : cp_in;
  vs = VVL[L] / 100;
  nlen = max(cp_gate / 100 * sl, 0.004 * srate);
  L == 3 ? (
    n = cp_bass(tb);
    n >= 0 && vs > 0 ? ( q_note(tq, nlen, n, cp_bv * vs, ch);  LDN[L] = n;  LDF[L] += 1; );
  ) : (
    pv = -1;  nn = -1;
    (L == 1 || L == 2) && cp_sus > 0 ? (
      pv = c > 0 ? cp_note(L, c - 1, tb - vb) : -1;
      nn = cp_note(L, c + 1, tb + vb);
    );
    n = cp_note(L, c, tb);
    n >= 0 && vs > 0 ? (
      t0 = tq;
      sc0 = (L == 1 || L == 2) && cp_sus > 0 && c > 0 && cp_hash(c, L) < cp_sus;
      sn0 = (L == 1 || L == 2) && cp_sus > 0 && cp_hash(c + 1, L) < cp_sus;
      sc0 ? (
        d = pv - n;
        d >= 1 && d <= 2 ? (
          tq += 0.5 * sl;
        ) : (
          up = cp_pit(cp_deg(n, cp_pr, cp_ps) + 1, 0, cp_pr, cp_ps);
          q_note(tq, max(0.48 * sl, 0.004 * srate), up, cp_nv * vs, ch);
          tq += 0.5 * sl;
        );
        nlen = max(cp_gate / 100 * 0.5 * sl, 0.004 * srate);
      );
      sn0 && nn >= 0 && n - nn >= 1 && n - nn <= 2 ? nlen = t0 + 1.5 * sl - tq - 0.002 * srate;
      q_note(tq, nlen, n, cp_nv * vs, ch);
      LDN[L] = n;  LDF[L] += 1;
    );
  );
);
function cp_fresh() local(k) (
  k = 0;  loop(4, LPB[k] = -1000000000;  k += 1; );
  cp_g0 = -1;  cp_lb = -1;  cp_lm = -1;
);
function cp_alloff(ofs) local(i) (
  q_flush(ofs);  os_n = 0;  oh_n = 0;  cp_wrun = 0;  cp_capt = 0;
  i = 0;  loop(128, THR[i] > 0 ? ( midisend(ofs, 0x80 | (THR[i] - 1), i, 0);  THR[i] = 0; );  i += 1; );
);
function cp_thru(ofs, m1, m2, m3) local(st, k) (
  st = m1 & 0xF0;
  schans >= 0.5 && st >= 0x80 && st < 0xF0 ? (
    k = 0;  loop(4, VON[k] ? midisend(ofs, st | k, m2, m3);  k += 1; );
  ) : midisend(ofs, m1, m2, m3);
);

function pv(L, on, fm, sp, iv, en, vl) local(b) (
  b = 12 + (L - 1) * 6;
  slider(b) = on;  slider(b + 1) = fm;  slider(b + 2) = sp;  slider(b + 3) = iv;  slider(b + 4) = en;  slider(b + 5) = vl;
);
function pg(rt, nt, gt, ik, v1, o1, vl1, bs, su, pa, ex) (
  sstep = rt;  snotes = nt;  sgate = gt;  sinkey = ik;  v1_on = v1;  v1_oct = o1;  v1_vel = vl1;
  sbass = bs;  ssus = su;  spath = pa;  sexch = ex;
);
function load_preset(p) local(i) (
  p == 1 ? ( pg(7, 2, 80, 1, 1, 0, 90, 0, 0, 0, 0);  pv(1, 1, 1, 2, 1, 2, 80);  pv(2, 0, 2, 1, 0, 4, 70); ) :
  p == 2 ? ( pg(7, 2, 75, 1, 1, 0, 90, 0, 0, 0, 0);  pv(1, 1, 0, 2, 1, 4, 80);  pv(2, 1, 0, 2, 0, 8, 70); ) :
  p == 3 ? ( pg(7, 2, 80, 1, 1, 0, 90, 0, 0, 0, 0);  pv(1, 1, 2, 2, 1, 0, 80);  pv(2, 0, 3, 2, 0, 4, 70); ) :
  p == 4 ? ( pg(9, 3, 70, 1, 1, 0, 75, 0, 0, 0, 0);  pv(1, 1, 0, 0, 0, 0, 90);  pv(2, 1, 1, 3, 9, 2, 60); ) :
  p == 5 ? ( pg(4, 2, 85, 1, 1, 0, 90, 0, 0, 0, 0);  pv(1, 1, 1, 3, 9, 1, 70);  pv(2, 0, 0, 1, 1, 0, 70); ) :
  p == 6 ? ( pg(7, 2, 70, 1, 1, 0, 85, 0, 0, 0, 0);  pv(1, 1, 0, 2, 8, 1, 75);  pv(2, 1, 0, 2, 3, 2, 70); ) :
  p == 7 ? ( pg(4, 1, 90, 1, 1, 0, 90, 1, 0, 0, 0);  pv(1, 1, 1, 1, 4, 0, 70);  pv(2, 0, 0, 2, 1, 0, 70); ) :
  p == 8 ? ( pg(7, 2, 85, 1, 1, 0, 85, 0, 60, 0, 0);  pv(1, 1, 0, 2, 4, 0, 75);  pv(2, 1, 1, 2, 1, 2, 70); ) :
  p == 9 ? ( pg(7, 2, 80, 1, 1, 0, 90, 1, 0, 4, 0);  pv(1, 1, 1, 2, 1, 2, 75);  pv(2, 0, 0, 1, 0, 0, 70); ) :
  p == 10 ? ( pg(7, 2, 80, 1, 1, 0, 85, 0, 20, 3, 0);  pv(1, 1, 3, 2, 1, 0, 75);  pv(2, 1, 0, 1, 0, 0, 70); ) :
  p == 11 ? ( pg(7, 2, 80, 1, 1, 0, 85, 0, 0, 0, 1);  pv(1, 1, 0, 2, 6, 2, 75);  pv(2, 1, 0, 2, 1, 4, 70); ) :
  p == 12 ? ( pg(7, 2, 80, 1, 1, 0, 90, 0, 0, 1, 0);  pv(1, 1, 0, 2, 8, 4, 80);  pv(2, 0, 0, 2, 1, 8, 70); ) :
  0;
  i = 2;  loop(26, slider_automate(2 ^ (i - 1));  i += 1; );
  pr_cur = p;
);

NP = 12;
function prs_hash() local(i, h) ( h = 0;  i = 1;  loop(28, h += slider(i) * (1 + i * 0.7071);  i += 1; );  h; );
function prs_same() local(h, r) ( h = prs_hash();  r = h == prs_h0;  prs_h0 = h;  r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  load_preset(k);
    prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k;
