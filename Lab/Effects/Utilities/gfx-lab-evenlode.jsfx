  cp_g0 >= 0 ? ( cp_path(floor(floor((cp_t0 - cp_g0) / cp_sb + 0.0001) / max(os_n, 1)));  cp_pr_d = cp_md(cp_pr, 12);  cp_ps_d = cp_ps;  cp_pc_d = cp_pc; );
  !cp_play ? cp_fb = cp_t1;
