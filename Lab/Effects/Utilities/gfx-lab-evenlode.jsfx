cp_wrun = cp_run;  cp_wplay = cp_play;  cp_wcap = cp_capt;
q_emit(cp_scnt, cp_ns);
cp_scnt += cp_ns;
cp_i = 0;  loop(16, LSD[cp_i] = cp_rec ? ( cp_i < stn ? STL[cp_i] : -1 ) : cp_i < os_n ? HS[cp_i] : -1;  cp_i += 1; );
