  VIV[cp_i] = max(0, min(9, slider(cp_b + 3) | 0));
  VEN[cp_i] = max(0, min(16, slider(cp_b + 4) | 0));
  VVL[cp_i] = max(0, min(100, slider(cp_b + 5)));
  VOC[cp_i] = 0;
  cp_i += 1;
);
VON[3] = sbass >= 0.5;  VFM[3] = 0;  VSF[3] = 0.5;  VIV[3] = 5;  VEN[3] = 0;  VVL[3] = VVL[0] * 0.9 + 10;  VOC[3] = 0;

while (midirecv(m_ofs, m_1, m_2, m_3)) (
  m_st = m_1 & 0xF0;
  m_st == 0x90 && m_3 > 0 ? cp_mid += 1;
  !cp_on ? midisend(m_ofs, m_1, m_2, m_3) :
  m_st == 0x90 || m_st == 0x80 ? (
