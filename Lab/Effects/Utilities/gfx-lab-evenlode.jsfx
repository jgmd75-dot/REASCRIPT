    );
    os_n = stn;  cp_i = 0;  while (cp_i < stn - 1 && HS[cp_i] < 0) ( cp_i += 1; );  cp_ax = HS[cp_i];
  );
) : cp_ax = HS[0];
cp_rec ? os_n = 0;

cp_bps = max(20, tempo) / 60 / srate;
cp_sb = cp_steps(max(0, min(11, sstep | 0)));
cp_capt = cp_hold && os_n > 0 && cp_capt && (cp_scnt + cp_ns - cp_lon) * cp_bps < max(2 * cp_sb, 1);
!cp_hold ? cp_capt = 0;
cp_wplay && !cp_play ? cp_lat = 0;
cp_run = cp_on && os_n > 0 && !cp_capt && !cp_rec && (stn == 0 || cp_play || oh_n > 0 || (cp_hold && cp_lat));
cp_run ? (
  cp_play ? (
    cp_t0 = beat_position;
    cp_late = 0;
    !cp_wrun ? ( cp_fresh();  cp_late = cp_wcap ? 0 : 0.1; ) : (!cp_wplay || abs(cp_t0 - cp_exp) > 0.05) ? cp_fresh();
  ) : (
