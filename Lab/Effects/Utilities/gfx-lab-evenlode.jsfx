rest_dirty ? ( rest_dirty = 0;  cp_rec ? cp_rest(); );
cp_recend ? (
  cp_recend = 0;  cp_rec = 0;
  cp_i = 0;  loop(128, THR[cp_i] > 0 ? ( midisend(0, 0x80 | (THR[cp_i] - 1), cp_i, 0);  THR[cp_i] = 0; );  cp_i += 1; );
  cp_tk = -1;  cp_lat = 0;  os_n = 0;  cp_fresh();
);
clr_dirty ? (
