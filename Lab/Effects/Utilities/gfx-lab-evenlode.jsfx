  os_n = 0;  cp_i = 0;  loop(min(oh_n, cp_keep), HS[os_n] = HP[cp_i];  HV[os_n] = 100;  os_n += 1;  cp_i += 1; );
);
cp_whold = cp_hold;
stn == 0 ? while (os_n > cp_keep) ( cp_drop(); );
VON[0] = v1_on >= 0.5;  VFM[0] = 0;  VSF[0] = 1;  VIV[0] = 5;  VEN[0] = 0;  VVL[0] = max(0, min(100, v1_vel));  VOC[0] = max(-2, min(2, v1_oct | 0));
cp_i = 1;
loop(2,
  cp_b = 12 + (cp_i - 1) * 6;
  VON[cp_i] = slider(cp_b) >= 0.5;
  VFM[cp_i] = max(0, min(3, slider(cp_b + 1) | 0));
