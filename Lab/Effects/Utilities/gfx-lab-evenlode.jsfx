          : v5_q(cx + 5.5, cy, cx - 3.5, cy - 5.5, cx - 3.5, cy + 5.5, cx - 3.5, cy + 5.5);
);
function cg_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#cp_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 34, 34) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
