cp_run_d = cp_run;  cp_capt_d = cp_capt;  cp_os_d = os_n;  cp_mid_d = cp_mid;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;
