prs_ok = 0;  prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5;  psw_all(psw_last); );
prs_chk();

@block
prs_chk();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? cp_alloff(0);
