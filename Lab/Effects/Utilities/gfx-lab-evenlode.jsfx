);
cp_f0 = -1;  cp_i = 0;  loop(stn, cp_f0 < 0 && STL[cp_i] >= 0 ? cp_f0 = STL[cp_i];  cp_i += 1; );
stn > 0 && !cp_rec ? (
  cp_f0 < 0 ? os_n = 0 : (
    cp_tk < 0 ? cp_tk = cp_f0;
