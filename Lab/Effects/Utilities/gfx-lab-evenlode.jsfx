  : idx == 16 || idx == 22 ? ( v == 0 ? strcpy(#cg_hv, "AT ONCE") : v == 1 ? strcpy(#cg_hv, "1 STEP") : sprintf(#cg_hv, "%d STEPS", v); )
  : sprintf(#cg_hv, "%d %%", v);
