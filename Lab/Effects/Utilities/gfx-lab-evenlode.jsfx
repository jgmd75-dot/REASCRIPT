);
!cp_on && cp_wbyp ? cp_alloff(0);
cp_wbyp = cp_on;
cp_newp ? ( cp_newp = 0;  cp_fresh(); );
cp_play = play_state & 1;
rec_dirty ? (
  rec_dirty = 0;
  !cp_rec ? ( q_flush(0);  cp_rec = 1;  stn = 0;  os_n = 0;  cp_capt = 0;  cp_ped = 0; ) : ( cp_recend = 1; );
