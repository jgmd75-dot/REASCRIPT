    );
    lk_azt = lk_azb + 360 * lk_oph;
    lk_dz = lk_azt - lk_az; lk_dz -= 360 * floor((lk_dz + 180) / 360);
    abs(lk_dz) > 0.0001 ? ( lk_az += lk_dz * lk_kz; abs(lk_dz) < 0.002 ? lk_az = lk_az + lk_dz; lk_pchg = 1; );
