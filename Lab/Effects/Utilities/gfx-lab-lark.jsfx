    lk_ds != lk_dst ? ( lk_ds += (lk_dst - lk_ds) * lk_kz; abs(lk_ds - lk_dst) < 0.00001 ? lk_ds = lk_dst; lk_pchg = 1; );
    lk_pchg ? (
      lk_pchg = 0;
      sA.lk_src((lk_az - lk_sp * 0.5) * $pi / 180); sB.lk_src((lk_az + lk_sp * 0.5) * $pi / 180);
      lk_dg = lk_db2g(-12 * lk_ds);
      lk_am = min(1, lk_ds * 20);
      lk_ac = 1 - exp(-2 * $pi * min(20000 * (3300 / 20000) ^ lk_ds, srate * 0.45) / srate);
    );
    lk_fresh2 ? ( sA.dl = sA.dlt; sA.dr = sA.drt; sB.dl = sB.dlt; sB.dr = sB.drt; lk_fresh2 = 0; );
    sA.lk_step(); sB.lk_step();
  );
  sA.lk_run(lk_l); sB.lk_run(lk_r);
  lk_hm < 1 ? ( lk_pl = sA.ol + sB.ol; lk_pr = sA.or + sB.or; ) : ( lk_pl = 0; lk_pr = 0; );
  lk_hm > 0 ? ( lk_pl += lk_hm * ((sA.hl + sB.hl) * 0.70710678 - lk_pl); lk_pr += lk_hm * ((sA.hr + sB.hr) * 0.70710678 - lk_pr); );
  lk_dg != 1 ? ( lk_pl *= lk_dg; lk_pr *= lk_dg; );
  lk_si < 1 ? ( lk_l += lk_si * (lk_pl - lk_l); lk_r += lk_si * (lk_pr - lk_r); ) : ( lk_l = lk_pl; lk_r = lk_pr; );
);

lk_mix < 1 ? ( lk_l = lk_ix + lk_mix * (lk_l - lk_ix); lk_r = lk_iy + lk_mix * (lk_r - lk_iy); );
lk_out != 1 ? ( lk_l *= lk_out; lk_r *= lk_out; );
pwr_out(lk_l, lk_r); lk_l = pwr_l; lk_r = pwr_r;
ost_out(lk_l, lk_r); lk_l = ost_l; lk_r = ost_r;
lk_l != lk_l ? lk_l = 0; lk_r != lk_r ? lk_r = 0;
lk_fi < 1 ? (
  lk_fi = min(lk_fi + lk_fis, 1); lk_z = lk_fi * lk_fi * (3 - 2 * lk_fi);
  lk_l = lk_xl + (lk_l - lk_xl) * lk_z; lk_r = lk_xr + (lk_r - lk_xr) * lk_z;
);
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); lk_l *= prs_w; lk_r *= prs_w; );
spl0 = lk_l; spl1 = lk_r;
lk_pkm = max(lk_pkm, max(abs(spl0), abs(spl1)));
);
by_out();

@gfx 900 400
ui_begin(900, 400);
v5_begin();
v5_led = 0xFFB030;
CVF = 0x474E54; CVW = 0x151C22; CVI = 0xE9ECE4; CVA = 0xF2C98A; CVH = 0x10141A; CVB = 0x141820;
CVD = 0x00B8D4; CVS = 0xF2B66A; CVO = 0xE2E2DF; CVM = 0x9AD0C2;
sc != cv_fsc ? (
  cv_fsc = sc;
  cv_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  cv_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  cv_f6 = ui_fitfont(6, 24 * sc);
);
function cv_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * cv_kt * sc, 'b'); );
function cv_fa(px) ( gfx_setfont(10, "Arial", px * cv_ka * sc, 'b'); );
function cv_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function cv_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function cv_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function cv_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function cv_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.16); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.50)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(face); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function cv_step(x, y, w, h, d, f, face) local(a, b) (
  a = max(1, floor(d * 0.45 + 0.5)); b = max(1, d - a);
  cv_cham(x, y, w, h, a, f, ui_mix(f, 0, 0.14));
  cv_cham(x + a + 5, y + a + 5, w - 2 * a - 10, h - 2 * a - 10, b, ui_mix(f, 0, 0.10), face);
);
function cv_plate(x, y, w, h, ttl, rc) (
  strlen(ttl) ? cv_cham(x, y, w, h, 3, CVF, CVW) : cv_step(x, y, w, h, 6, CVF, CVW);
  strlen(ttl) ? ( cv_ft(18); ui_col(CVI); v5_t(x + w / 2, y + 27, ttl);
    ui_col(rc); v5_r(x + w / 2 - cv_tw(ttl) / 2, y + 39, cv_tw(ttl), 3); );
);
function cv_dwell(x, y, w, h) local(j) (
  ui_cola(0xFFFFFF, 0.10); v5_r(x, y + h, w + 1, 1.5); v5_r(x + w, y, 1.5, h + 1);
  ui_col(ui_mix(CVW, 0, 0.45)); v5_rr(x, y, w, h, 3);
  j = 0; loop(4, ui_cola(0, 0.16 - j * 0.035); v5_r(x + 1, y + 1 + j, w - 2, 1); v5_r(x + 1 + j, y + 2 + j, 1, h - 3 - j); j += 1; );
);
function cv_ends(cx, cy, r) local(t, rd, sz) (
  rd = r + 11; sz = r >= 20 ? 1.8 : 1.5;
  ui_col(0x9A948A); t = -0.75 * $pi; v5_sd(cx + sin(t) * rd, cy - cos(t) * rd, sz); v5_sd(cx - sin(t) * rd, cy - cos(t) * rd, sz);
);
function cv_skirt(cx, cy, r) local(i, t) (
  v5_shc(cx, cy, r);
  ui_col(0x1B1D1E); v5_d(cx, cy, r);
  i = 0; loop(30, t = i / 30 * 2 * $pi; ui_col(0x34383A); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  cv_ends(cx, cy, r);
);
function cv_cap(cx, cy, r, v) local(a) (
  a = -0.75 * $pi + v * 1.5 * $pi;
  ui_col(ui_mix(cv_cc, 0, 0.25)); v5_d(cx, cy, r * 0.74);
  ui_col(cv_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, 0x2A1E14);
);
function cv_val(idx, v) (
  idx == 3 ? sprintf(#cv_vs, "%.1f dB", v) :
  idx == 4 || idx == 13 || idx == 17 ? sprintf(#cv_vs, "%d %%", floor(v + 0.5)) :
  idx == 5 ? sprintf(#cv_vs, "%.2f s", v) :
  idx == 6 ? sprintf(#cv_vs, "%d ms", floor(v + 0.5)) :
  idx == 7 ? ( abs(v) < 0.5 ? strcpy(#cv_vs, "EVEN") : v > 0 ? sprintf(#cv_vs, "LOW +%d", floor(v + 0.5)) : sprintf(#cv_vs, "HIGH +%d", floor(-v + 0.5)) ) :
  idx == 12 ? sprintf(#cv_vs, "%d°", floor(v + 0.5)) :
  idx == 16 ? sprintf(#cv_vs, "%.2f Hz", v) :
  idx == 18 ? sprintf(#cv_vs, "%+.1f dB", v) :
  sprintf(#cv_vs, "%.1f", v);
  #cv_vs;
);
function cv_dial(cx, cy, r, idx, lo, hi, def, lg, cap, lbl) local(n, fs, ly) (
  cv_cc = cap;
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 9), 0, 200);
  cv_cap(cx, cy, r, n);
  fs = r >= 26 ? 16 : r >= 18 ? 15 : 14; ly = cy + r + 15 + fs * 0.55;
  v5_act ? ( ui_cola(0xFFFFFF, 0.10); v5_arc(cx, cy, r + 1.5, -$pi, $pi, 1);
    cv_hon = 1; cv_hx = cx; cv_hy = ly; cv_hfs = max(fs, 14); strcpy(#cv_hv, cv_val(idx, slider(idx))); )
  : ( cv_ft(fs); ui_col(CVI); v5_t(cx, ly, lbl); );
);
function cv_in(x, y, idx) local(on, dn) (
  on = v5_toggle(idx, v5_hit(x, y, 40, 24));
  dn = on ? 1.5 : 0;
  v5_shr(x, y, 40, 24, 4);
  ui_col(0x0A0B0B); v5_rr(x, y, 40, 24, 4);
  ui_col(on ? 0x2A2D2F : 0x323638); v5_rr(x + 1, y + 1 + dn, 38, 22 - dn, 4);
  ui_cola(0xFFFFFF, 0.08); v5_r(x + 4, y + 2 + dn, 32, 1);
  gfx_setfont(v5_fk);
  on ? v5_glowt(x + 20, y + 12 + dn * 0.5, "IN") : ( ui_col(0x5E5A50); v5_t(x + 20, y + 12 + dn * 0.5, "IN"); );
  on;
);
function cv_rk(x, y, w, h, on, lg) local(gx, hv) (
  hv = v5_hit(x, y, w, h);
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(hv ? 0x1C1E1D : 0x141615); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.45); v5_r(x + 1, y + 1, w - 2, 2); v5_r(x + 1, y + 1, 2, h - 2);
  ui_cola(0xFFFFFF, 0.06); v5_r(x + 2, y + h - 1, w - 3, 1);
  gx = x + 7;
  ui_col(0x050606); v5_rr(gx, y + 5, 7, h - 10, 3.5);
  on ? ( ui_cola(v5_led, 0.25); v5_rr(gx - 3, y + 3, 13, h - 6, 5); ui_col(v5_led); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); )
     : ( ui_col(ui_mix(v5_led, 0x0A0B0B, 0.75)); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); );
  gfx_setfont(v5_fk); ui_col(on ? 0xF6F8F4 : 0xB8B4A8); v5_t((gx + 11 + x + w - 4) * 0.5, y + h * 0.5 + 0.5, lg);
);
function cv_lp(x, y, w, h, idx, lg) local(on) (
  on = v5_toggle(idx, v5_hit(x, y, w, h));
  cv_rk(x, y, w, h, on, lg);
);
function cv_sel(x, y, w, h, gap, idx, n, labels) local(k, kx, cur) (
  cur = floor(slider(idx) + 0.5); k = 0;
  loop(n, kx = x + k * (w + gap);
    v5_pr && v5_drag == 0 && v5_hit(kx, y, w, h) && cur != k ? ( slider(idx) = k; ui_auto(idx); cur = k; v5_drag = -1; );
    v5_part(labels, k); cv_rk(kx, y, w, h, k == cur, #v5_pt);
    k += 1; );
);
function cv_wash(x, y, w, h) ( ui_cola(CVW, 0.5); v5_r(x, y, w, h); );
function cv_led(x, y, on, c) (
  ui_col(0x050606); v5_sd(x, y, 3.6);
  on ? ( ui_cola(c, 0.28); v5_d(x, y, 6); ui_col(c); v5_sd(x, y, 2.8); ui_cola(0xFFFFFF, 0.55); v5_d(x - 0.8, y - 0.8, 0.8); )
     : ( ui_col(ui_mix(c, 0x0A0B0B, 0.78)); v5_sd(x, y, 2.8); );
);
function cv_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x1A1C1D); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  c0 = ui_mix(0x9EA49A, 0xC6CCBF, 0.44); c1 = 0xC6CCBF; c2 = ui_mix(0x9EA49A, 0xC6CCBF, 0.16);
  cv_grad(x, y, w, h * 0.4, c0, c1); cv_grad(x, y + h * 0.4, w, h * 0.6, c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function cv_arrkey(x, y, w, h, dir) local(cx, cy) (
