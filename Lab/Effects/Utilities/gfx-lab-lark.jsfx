desc:Lark [spatial panner and dereverb] (GFX Lab)
//tags: utility spatial panner azimuth binaural headphones dereverb reverb reduction anechoic room restoration dialogue
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider20:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,1,1{Off,On}>-Dereverb
slider3:12<0,40,0.1>-Reduction (dB)
slider4:50<0,100,1>-Sensitivity (%)
slider5:1<0.2,5,0.01>-Room decay (s)
slider6:80<10,500,1>-Release (ms)
slider7:0<-100,100,1>-Tilt (%)
slider8:0<0,2,1{Room,Dry,Anechoic}>-Dereverb mode
slider9:0<0,1,1{Off,On}>-Listen to removed reverb
slider10:1<0,1,1{Off,On}>-Space
slider11:0<-180,180,1>-Azimuth (degrees)
slider12:60<0,180,1>-Spread (degrees)
slider13:0<0,100,1>-Distance (%)
slider14:0<0,1,1{Speakers,Headphones}>-Listening
slider15:0<0,1,1{Off,On}>-Orbit
slider16:0.1<0.01,2,0.01>-Orbit rate (Hz)
slider17:100<0,100,1>-Mix (%)
slider18:0<-12,12,0.1>-Output (dB)
slider19:prs_sel=0<0,14,1{No preset,Init,Vocal Room Tame,Dry Vocal Booth,Anechoic Voice,Podcast Room,Drum Room Cut,Guitar Amp Room,Hall Recording Dry,Phones Wide,Phones Left 60,Behind You,Far Away,Slow Orbit,Dry and Placed}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(1048575, v); );
function psw_allg(v) ( slider_show(1048575, v); );
#ui_man = "gfx-lab-lark";
ext_noinit = 1;

LK_PB = 0; LK_RN = 4096;
LK_CF = 24000;
LK_BT = 24100; LK_DC = 24200; LK_QI = 24300; LK_RS = 24400; LK_RH = 24500; LK_DL = 24600;
LK_SD = 32768; LK_DN = 2048;
LK_GD = 40000;
LK_RL0 = 0.08; LK_RL1 = 0.06; LK_RL2 = 0.05; LK_AT0 = 0.008; LK_AT1 = 0.005; LK_GA = 0.002;

function lk_db2g(d) ( exp(d * 0.11512925465); );
function lk_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * srate)); );

function lk_bqc(o, f, t) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  t == 0 ? ( o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; ) :
  t == 1 ? ( o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; ) :
           ( o[0] = (1 - al) / n; o[1] = -2 * cw / n; o[2] = 1; );
  o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function lk_bq(x, o) instance(s1, s2) local(y) (
  y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y;
);
function lk_bclr() instance(s1, s2) ( s1 = s2 = 0; );
function lk_btidy() instance(s1, s2) ( abs(s1) < 0.000000000001 ? s1 = 0; abs(s2) < 0.000000000001 ? s2 = 0; );
function lk_split(x, o) instance(la, lb, ha, hb) (
  lk_lo = lb.lk_bq(la.lk_bq(x, o), o);
  lk_hi = hb.lk_bq(ha.lk_bq(x, o + 5), o + 5);
);
function lk_sp_clr() instance(la, lb, ha, hb) ( la.lk_bclr(); lb.lk_bclr(); ha.lk_bclr(); hb.lk_bclr(); );
function lk_sp_tidy() instance(la, lb, ha, hb) ( la.lk_btidy(); lb.lk_btidy(); ha.lk_btidy(); hb.lk_btidy(); );
function lk_bank(x) instance(s0, s1, s2, s3, p0a, p0b, p0c, p1b, p1c, p2c, b0, b1, b2, b3, b4) (
  s0.lk_split(x, LK_CF); b0 = lk_lo;
  s1.lk_split(lk_hi, LK_CF + 15); b1 = lk_lo; b0 = p0a.lk_bq(b0, LK_CF + 25);
  s2.lk_split(lk_hi, LK_CF + 30); b2 = lk_lo; b0 = p0b.lk_bq(b0, LK_CF + 40); b1 = p1b.lk_bq(b1, LK_CF + 40);
  s3.lk_split(lk_hi, LK_CF + 45); b3 = lk_lo; b4 = lk_hi;
  b0 = p0c.lk_bq(b0, LK_CF + 55); b1 = p1c.lk_bq(b1, LK_CF + 55); b2 = p2c.lk_bq(b2, LK_CF + 55);
);
function lk_bk_clr() instance(s0, s1, s2, s3, p0a, p0b, p0c, p1b, p1c, p2c) (
  s0.lk_sp_clr(); s1.lk_sp_clr(); s2.lk_sp_clr(); s3.lk_sp_clr();
  p0a.lk_bclr(); p0b.lk_bclr(); p0c.lk_bclr(); p1b.lk_bclr(); p1c.lk_bclr(); p2c.lk_bclr();
);
function lk_bk_tidy() instance(s0, s1, s2, s3, p0a, p0b, p0c, p1b, p1c, p2c) (
  s0.lk_sp_tidy(); s1.lk_sp_tidy(); s2.lk_sp_tidy(); s3.lk_sp_tidy();
  p0a.lk_btidy(); p0b.lk_btidy(); p0c.lk_btidy(); p1b.lk_btidy(); p1c.lk_btidy(); p2c.lk_btidy();
);

function lk_tg(p, k) local(o, pd, r, gg) (
  o = LK_PB + k * LK_RN;
  o[lk_rw] = p;
  pd = o[(lk_rw - lk_tdn) & (LK_RN - 1)];
  LK_RH[k] = max(LK_RH[k] * LK_RS[k], LK_DC[k] * pd);
  LK_RH[k + 8] = max(LK_RH[k + 8] * LK_RS[k], LK_DL[k] * o[(lk_rw - lk_tdl) & (LK_RN - 1)]);
  p += 0.000000000001;
  r = max((LK_RH[k] / p - LK_DC[k]) * LK_QI[k], (LK_RH[k + 8] / p - LK_DL[k]) * LK_QI[k + 8]);
  gg = 1 - LK_BT[k] * min(max(r, 0), 1.5);
  gg = gg > 0 ? sqrt(gg) : 0;
  max(gg, lk_gmin);
);

function lk_rd(o, w, d) local(i, t, m, y0, y1, y2, y3) (
  i = floor(d) - 1; i < 0 ? i = 0;
  t = d - i; m = LK_DN - 1;
  y0 = o[(w - i) & m];
  t == 0 ? y0 : (
    y1 = o[(w - i - 1) & m]; y2 = o[(w - i - 2) & m]; y3 = o[(w - i - 3) & m];
    -(t - 1) * (t - 2) * (t - 3) / 6 * y0 + t * (t - 2) * (t - 3) * 0.5 * y1 - t * (t - 1) * (t - 3) * 0.5 * y2 + t * (t - 1) * (t - 2) / 6 * y3;
  );
);

function lk_src(th) instance(sl, sr, dlt, drt, bl0, bl1, al1, br0, br1, ar1, rk) local(s, c, ph, t, gl, gr, n, gA, gB, k) (
  s = sin(th); c = cos(th);
  rk = lk_db2g(-9 * max(0, -c)) - 1;
  abs(rk) < 0.0000001 ? rk = 0;
  ph = asin(max(-1, min(1, s)));
  ph <= -$pi / 6 ? ( sl = 1; sr = 0; ) : ph >= $pi / 6 ? ( sl = 0; sr = 1; ) : (
    t = tan(ph) * 1.7320508075688772; gl = 1 - t; gr = 1 + t; n = 1 / sqrt(gl * gl + gr * gr); sl = gl * n; sr = gr * n;
  );
  t = lk_itd * (ph + s);
  dlt = t > 0 ? t : 0; drt = t < 0 ? -t : 0;
  gA = (1.05 + 0.95 * cos(acos(max(-1, min(1, -s))) * 1.2)) / lk_a90; gA = min(gA, 2);
  gB = (1.05 + 0.95 * cos(acos(max(-1, min(1, s))) * 1.2)) / lk_a90; gB = min(gB, 2);
  k = lk_hk; n = 1 / (1 + k);
  bl0 = (1 + gA * k) * n; bl1 = (1 - gA * k) * n; al1 = (1 - k) * n;
  br0 = (1 + gB * k) * n; br1 = (1 - gB * k) * n; ar1 = al1;
);
function lk_step() instance(dl, dr, dlt, drt, ddl, ddr) (
  ddl = (dlt - dl) / 16; ddr = (drt - dr) / 16;
);
function lk_run(x) instance(o, w, rk, rlp, alp, sl, sr, dl, dr, ddl, ddr, bl0, bl1, al1, br0, br1, ar1, xl1, yl1, xr1, yr1, ol, or, hl, hr) local(y, a, b) (
  rk != 0 ? ( rlp += (x - rlp) * lk_rc; x += rk * (x - rlp); ) : rlp = x;
  lk_am > 0 ? ( alp += (x - alp) * lk_ac; x += (alp - x) * lk_am; ) : alp = x;
  ol = sl * x; or = sr * x;
  lk_hon ? (
    o[w] = x;
    dl += ddl; dr += ddr;
    a = lk_rd(o, w, dl); b = lk_rd(o, w, dr);
    y = bl0 * a + bl1 * xl1 - al1 * yl1; xl1 = a; yl1 = y; hl = y;
    y = br0 * b + br1 * xr1 - ar1 * yr1; xr1 = b; yr1 = y; hr = y;
    w = (w + 1) & (LK_DN - 1);
  );
);
function lk_sclr() instance(o, w, rlp, alp, xl1, yl1, xr1, yr1, dl, dr, dlt, drt, ddl, ddr) (
  memset(o, 0, LK_DN); w = 0; rlp = alp = xl1 = yl1 = xr1 = yr1 = 0; dl = dlt; dr = drt; ddl = ddr = 0;
);
function lk_stidy() instance(rlp, alp, xl1, yl1, xr1, yr1) (
  abs(rlp) < 0.000000000001 ? rlp = 0; abs(alp) < 0.000000000001 ? alp = 0;
  abs(yl1) < 0.000000000001 ? yl1 = 0; abs(yr1) < 0.000000000001 ? yr1 = 0;
);

function lk_setup() local(m, b, t, k) (
  lk_don = slider2 >= 0.5;
  lk_gmin = lk_db2g(-min(max(slider3, 0), 40));
  b = 0.7 * 4 ^ (min(max(slider4, 0), 100) / 100);
  m = min(max(floor(slider8 + 0.5), 0), 2);
  lk_md = m;
  lk_td = m == 0 ? 0.08 : m == 1 ? 0.04 : 0.015;
  lk_tdn = max(1, floor(lk_td * srate / 16 + 0.5));
  lk_td = lk_tdn * 16 / srate;
  lk_tdl = lk_tdn * 3;
  t = min(max(slider5, 0.2), 5);
  k = 0;
  loop(5,
    LK_BT[k] = b * 2 ^ (min(max(slider7, -100), 100) / 100 * (2 - k) * 0.5) * (m == 2 ? 1.25 : 1);
    LK_DC[k] = 10 ^ (-6 * lk_td / (t * (k == 0 ? 1.15 : k == 1 ? 1.06 : k == 2 ? 1 : k == 3 ? 0.94 : 0.85)));
    LK_DL[k] = LK_DC[k] * LK_DC[k] * LK_DC[k];
    LK_QI[k] = 1 / max(1 - LK_DC[k], 0.02);
    LK_QI[k + 8] = 1 / max(1 - LK_DL[k], 0.02);
    LK_RS[k] = 10 ^ (-6 * 16 / (srate * t * (k == 0 ? 1.15 : k == 1 ? 1.06 : k == 2 ? 1 : k == 3 ? 0.94 : 0.85)));
    k += 1; );
  lk_kf = 10 ^ (-1 / (min(max(slider6, 10), 500) * 0.001 * srate)); lk_ku = lk_kf ^ -0.25;
  lk_lit = slider9 >= 0.5;
  lk_son = slider10 >= 0.5;
  lk_azb = min(max(slider11, -180), 180);
  lk_spt = min(max(slider12, 0), 180);
  lk_dst = min(max(slider13, 0), 100) / 100;
  lk_hmt = slider14 >= 0.5;
  lk_orb = slider15 >= 0.5;
  lk_orr = min(max(slider16, 0.01), 2);
  lk_mixt = min(max(slider17, 0), 100) / 100;
  lk_outt = lk_db2g(min(max(slider18, -12), 12));
);

function lk_clear() (
  memset(LK_PB, 0, 5 * LK_RN); memset(LK_RH, 0, 16);
  bkL.lk_bk_clr(); bkR.lk_bk_clr();
  lk_p0 = lk_p1 = lk_p2 = lk_p3 = lk_p4 = 0; lk_f0 = lk_f1 = lk_f2 = lk_f3 = lk_f4 = 0;
  lk_g0 = lk_g1 = lk_g2 = lk_g3 = lk_g4 = 1;
  lk_t0 = lk_t1 = lk_t2 = lk_t3 = lk_t4 = 1;
  sA.lk_sclr(); sB.lk_sclr();
);

function lk_srinit() (
  lk_sr = srate;
  lk_k = 0; loop(4, lk_f = lk_k == 0 ? 220 : lk_k == 1 ? 660 : lk_k == 2 ? 2200 : 6600;
    lk_bqc(LK_CF + lk_k * 15, lk_f, 0); lk_bqc(LK_CF + lk_k * 15 + 5, lk_f, 1); lk_bqc(LK_CF + lk_k * 15 + 10, lk_f, 2); lk_k += 1; );
  lk_kp0 = lk_tc(LK_RL0); lk_kp1 = lk_tc(LK_RL1); lk_kp = lk_tc(LK_RL2);
  lk_kq0 = lk_tc(LK_AT0); lk_kq = lk_tc(LK_AT1);
  lk_kfa = lk_tc(0.0007); lk_kfr0 = lk_tc(0.02); lk_kfr = lk_tc(0.012); lk_on = 2;
  lk_ka = lk_tc(LK_GA);
  lk_sw = lk_tc(0.012);
  lk_smc = lk_tc(0.03);
  lk_kz = 1 - exp(-16 / (0.04 * srate));
  lk_ko = 1 - exp(-16 / (0.3 * srate));
  lk_itd = 0.0875 / 343 * srate;
  lk_hk = 1 / tan(min(3920 / srate, 1.5));
  lk_a90 = 1.05 + 0.95 * cos($pi * 0.6);
  lk_rc = 1 - exp(-2 * $pi * 4000 / srate);
  lk_fis = 1 / (0.01 * srate);
  lk_sqn = floor(0.3 * srate);
  sA.o = LK_SD; sB.o = LK_SD + LK_DN;
  lk_setup(); lk_clear();
);
lk_az = 0; lk_sp = 60; lk_ds = 0; lk_oph = 0;
lk_srinit();
lk_sp = lk_spt; lk_ds = lk_dst; lk_az = lk_azb;
lk_di = lk_don; lk_li = lk_lit; lk_si = lk_son; lk_hm = lk_hmt; lk_mix = lk_mixt; lk_out = lk_outt;
lk_fi = 1; lk_pchg = 1; lk_hon = lk_hmt; lk_fresh2 = 1;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init(); ost_setup(0, 0, 110, 6600, -0.3, 1);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(1);
pwr_init(); pwr_wu_loss = 0.3; pwr_wu_drv = 0.3; pwr_wu_lp = 14000; pwr_wu_wob = 0.1; pwr_bloom = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function lk_pd(on, rd, se, dc, rl, tl, md) (
  slider2 = on; slider3 = rd; slider4 = se; slider5 = dc; slider6 = rl; slider7 = tl; slider8 = md; slider9 = 0;
);
function lk_ps(on, az, sp, ds, hp, ob, rt) (
  slider10 = on; slider11 = az; slider12 = sp; slider13 = ds; slider14 = hp; slider15 = ob; slider16 = rt;
);
function load_preset(p) (
  slider17 = 100; slider18 = 0;
  lk_pd(1, 12, 50, 1, 80, 0, 0); lk_ps(1, 0, 60, 0, 0, 0, 0.1);
  p == 2 ? ( lk_pd(1, 14, 55, 0.8, 70, 20, 1); ) :
  p == 3 ? ( lk_pd(1, 18, 50, 0.6, 60, 10, 2); ) :
  p == 4 ? ( lk_pd(1, 30, 70, 1.2, 50, 0, 2); ) :
  p == 5 ? ( lk_pd(1, 16, 60, 0.7, 90, 30, 1); ) :
  p == 6 ? ( lk_pd(1, 12, 50, 1.5, 40, 0, 0); ) :
  p == 7 ? ( lk_pd(1, 10, 45, 0.9, 100, -10, 0); ) :
  p == 8 ? ( lk_pd(1, 20, 60, 2.5, 150, 20, 0); ) :
  p == 9 ? ( lk_pd(0, 12, 50, 1, 80, 0, 0); lk_ps(1, 0, 90, 0, 1, 0, 0.1); ) :
  p == 10 ? ( lk_pd(0, 12, 50, 1, 80, 0, 0); lk_ps(1, -60, 20, 0, 1, 0, 0.1); ) :
  p == 11 ? ( lk_pd(0, 12, 50, 1, 80, 0, 0); lk_ps(1, 180, 40, 10, 1, 0, 0.1); ) :
  p == 12 ? ( lk_pd(0, 12, 50, 1, 80, 0, 0); lk_ps(1, 20, 30, 70, 0, 0, 0.1); ) :
  p == 13 ? ( lk_pd(0, 12, 50, 1, 80, 0, 0); lk_ps(1, 0, 30, 15, 1, 1, 0.05); ) :
  p == 14 ? ( lk_pd(1, 24, 60, 1, 70, 10, 2); lk_ps(1, 45, 20, 0, 1, 0, 0.1); );
  slider_automate(262143);
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(18, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); lk_setup();
      prs_q ? ( k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;
lk_fresh = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
lk_setup();
lk_fresh ? ( lk_sp = lk_spt; lk_ds = lk_dst; lk_az = lk_azb; lk_pchg = 1; );
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != lk_sr ? lk_srinit();
lk_now = time_precise();
lk_tp > 0 && lk_now - lk_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > lk_gpp && play_position - lk_gpp < 4 * lk_gpd + 0.05) ? ( lk_clear(); lk_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
lk_tp = lk_now; lk_gpp = play_position; lk_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
lk_setup();
lk_fresh ? ( lk_sp = lk_spt; lk_ds = lk_dst; lk_az = lk_azb; lk_pchg = 1; );
lk_hn = lk_hmt || lk_hm > 0.000001;
lk_hn && !lk_hon ? ( sA.lk_sclr(); sB.lk_sclr(); );
lk_hon = lk_hn;
bkL.lk_bk_tidy(); bkR.lk_bk_tidy();
sA.lk_stidy(); sB.lk_stidy();
lk_p0 < 0.0000000000000001 ? lk_p0 = 0; lk_p1 < 0.0000000000000001 ? lk_p1 = 0; lk_p2 < 0.0000000000000001 ? lk_p2 = 0;
lk_p3 < 0.0000000000000001 ? lk_p3 = 0; lk_p4 < 0.0000000000000001 ? lk_p4 = 0;
ost_setup(0, 0, 110, 6600, -0.3, 1);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
lk_k = 0; loop(5, LK_GD[lk_k] = max(LK_GD[lk_k], LK_GD[8 + lk_k]); LK_GD[8 + lk_k] = 0; lk_k += 1; );
lk_pk_d = max(lk_pk_d, lk_pkm); lk_pkm = 0;
lk_az_d = lk_az; lk_sp_d = lk_sp; lk_slp_d = lk_slp;
lk_fresh = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
lk_xl = spl0; lk_xr = spl1;
max(abs(lk_xl), abs(lk_xr)) > 0.0000001 ? lk_sq = 0 : lk_sq < lk_sqn ? lk_sq += 1;
lk_sl2 = lk_sq >= lk_sqn && !pwr_act && prs_gs == 0 && lk_fi >= 1;
lk_sl2 && !lk_slp ? lk_clear();
lk_slp = lk_sl2;
lk_slp ? (
  spl0 = spl1 = 0;
) : (
pwr_in(lk_xl, lk_xr); lk_l = pwr_l; lk_r = pwr_r;
lk_ix = lk_l; lk_iy = lk_r;
lk_di += (lk_don - lk_di) * lk_sw; abs(lk_di - lk_don) < 0.000001 ? lk_di = lk_don;
lk_li += (lk_lit - lk_li) * lk_sw; abs(lk_li - lk_lit) < 0.000001 ? lk_li = lk_lit;
lk_si += (lk_son - lk_si) * lk_sw; abs(lk_si - lk_son) < 0.000001 ? lk_si = lk_son;
lk_hm += (lk_hmt - lk_hm) * lk_sw; abs(lk_hm - lk_hmt) < 0.000001 ? lk_hm = lk_hmt;
lk_mix += (lk_mixt - lk_mix) * lk_smc; abs(lk_mix - lk_mixt) < 0.0000001 ? lk_mix = lk_mixt;
lk_out += (lk_outt - lk_out) * lk_smc; abs(lk_out - lk_outt) < 0.0000001 ? lk_out = lk_outt;

lk_cc = (lk_cc + 1) & 15;
lk_dact = lk_di > 0 || lk_li > 0;
lk_dact ? (
  bkL.lk_bank(lk_l); bkR.lk_bank(lk_r);
  lk_a0 = bkL.b0; lk_a1 = bkL.b1; lk_a2 = bkL.b2; lk_a3 = bkL.b3; lk_a4 = bkL.b4;
  lk_c0 = bkR.b0; lk_c1 = bkR.b1; lk_c2 = bkR.b2; lk_c3 = bkR.b3; lk_c4 = bkR.b4;
  lk_q = lk_a0 * lk_a0 + lk_c0 * lk_c0; lk_p0 += (lk_q - lk_p0) * (lk_q > lk_p0 ? lk_kq0 : lk_kp0); lk_f0 += (lk_q - lk_f0) * (lk_q > lk_f0 ? lk_kfa : lk_kfr0);
  lk_q = lk_a1 * lk_a1 + lk_c1 * lk_c1; lk_p1 += (lk_q - lk_p1) * (lk_q > lk_p1 ? lk_kq : lk_kp1); lk_f1 += (lk_q - lk_f1) * (lk_q > lk_f1 ? lk_kfa : lk_kfr);
  lk_q = lk_a2 * lk_a2 + lk_c2 * lk_c2; lk_p2 += (lk_q - lk_p2) * (lk_q > lk_p2 ? lk_kq : lk_kp); lk_f2 += (lk_q - lk_f2) * (lk_q > lk_f2 ? lk_kfa : lk_kfr);
  lk_q = lk_a3 * lk_a3 + lk_c3 * lk_c3; lk_p3 += (lk_q - lk_p3) * (lk_q > lk_p3 ? lk_kq : lk_kp); lk_f3 += (lk_q - lk_f3) * (lk_q > lk_f3 ? lk_kfa : lk_kfr);
  lk_q = lk_a4 * lk_a4 + lk_c4 * lk_c4; lk_p4 += (lk_q - lk_p4) * (lk_q > lk_p4 ? lk_kq : lk_kp); lk_f4 += (lk_q - lk_f4) * (lk_q > lk_f4 ? lk_kfa : lk_kfr);
  lk_cc == 0 ? (
    lk_t0 = lk_tg(lk_p0, 0); lk_t1 = lk_tg(lk_p1, 1); lk_t2 = lk_tg(lk_p2, 2); lk_t3 = lk_tg(lk_p3, 3); lk_t4 = lk_tg(lk_p4, 4);
    lk_o0 = lk_f0 > lk_on * lk_p0; lk_o1 = lk_f1 > lk_on * lk_p1; lk_o2 = lk_f2 > lk_on * lk_p2; lk_o3 = lk_f3 > lk_on * lk_p3; lk_o4 = lk_f4 > lk_on * lk_p4;
    lk_rw = (lk_rw + 1) & (LK_RN - 1);
  );
  lk_t0 > lk_g0 ? ( lk_g0 = lk_o0 ? lk_g0 + (lk_t0 - lk_g0) * lk_ka : min(lk_t0, lk_g0 * lk_ku); ) : lk_g0 = max(lk_t0, lk_g0 * lk_kf);
  lk_t1 > lk_g1 ? ( lk_g1 = lk_o1 ? lk_g1 + (lk_t1 - lk_g1) * lk_ka : min(lk_t1, lk_g1 * lk_ku); ) : lk_g1 = max(lk_t1, lk_g1 * lk_kf);
  lk_t2 > lk_g2 ? ( lk_g2 = lk_o2 ? lk_g2 + (lk_t2 - lk_g2) * lk_ka : min(lk_t2, lk_g2 * lk_ku); ) : lk_g2 = max(lk_t2, lk_g2 * lk_kf);
  lk_t3 > lk_g3 ? ( lk_g3 = lk_o3 ? lk_g3 + (lk_t3 - lk_g3) * lk_ka : min(lk_t3, lk_g3 * lk_ku); ) : lk_g3 = max(lk_t3, lk_g3 * lk_kf);
  lk_t4 > lk_g4 ? ( lk_g4 = lk_o4 ? lk_g4 + (lk_t4 - lk_g4) * lk_ka : min(lk_t4, lk_g4 * lk_ku); ) : lk_g4 = max(lk_t4, lk_g4 * lk_kf);
  lk_xa = lk_a0 + lk_a1 + lk_a2 + lk_a3 + lk_a4; lk_xb = lk_c0 + lk_c1 + lk_c2 + lk_c3 + lk_c4;
  lk_yl = lk_a0 * lk_g0 + lk_a1 * lk_g1 + lk_a2 * lk_g2 + lk_a3 * lk_g3 + lk_a4 * lk_g4;
  lk_yr = lk_c0 * lk_g0 + lk_c1 * lk_g1 + lk_c2 * lk_g2 + lk_c3 * lk_g3 + lk_c4 * lk_g4;
  lk_li > 0 ? ( lk_yl += lk_li * (lk_xa - 2 * lk_yl); lk_yr += lk_li * (lk_xb - 2 * lk_yr); );
  lk_di < 1 ? (
    lk_l += lk_di * (lk_yl - lk_l); lk_r += lk_di * (lk_yr - lk_r);
    lk_ix += lk_di * (lk_xa - lk_ix); lk_iy += lk_di * (lk_xb - lk_iy);
  ) : ( lk_l = lk_yl; lk_r = lk_yr; lk_ix = lk_xa; lk_iy = lk_xb; );
  lk_e0 = 1 + lk_di * (lk_g0 - 1); lk_e1 = 1 + lk_di * (lk_g1 - 1); lk_e2 = 1 + lk_di * (lk_g2 - 1);
  lk_e3 = 1 + lk_di * (lk_g3 - 1); lk_e4 = 1 + lk_di * (lk_g4 - 1);
  LK_GD[8] = max(LK_GD[8], 1 - lk_e0); LK_GD[9] = max(LK_GD[9], 1 - lk_e1); LK_GD[10] = max(LK_GD[10], 1 - lk_e2);
  LK_GD[11] = max(LK_GD[11], 1 - lk_e3); LK_GD[12] = max(LK_GD[12], 1 - lk_e4);
);

lk_sact = lk_si > 0;
lk_sact ? (
  lk_cc == 0 ? (
    lk_orb ? ( lk_oph += lk_orr * 16 / srate; lk_oph >= 1 ? lk_oph -= 1; ) : lk_oph > 0 ? (
