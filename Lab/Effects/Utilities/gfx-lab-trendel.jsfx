pat_cmd_dirty ? ( rec_on = !rec_on;  rec_on ? PATN = 0 : PATN == 0 ? ( PAT[0] = 60;  PATV[0] = 0.7;  PATN = 1; );  pat_cmd_dirty = 0; );
pld_dirty > 0 ? ( lb_load(pld_dirty - 1);  pld_d = pld_dirty;  pld_dirty = 0; );

while (midirecv(m_ofs, m_1, m_2, m_3)) (
  m_st = m_1 & 0xF0;
  m_st == 0x90 && m_3 > 0 ? tr_mid += 1;
  !tr_on ? midisend(m_ofs, m_1, m_2, m_3) :
  m_st == 0x90 || m_st == 0x80 ? (
    rec_on ? (
      m_st == 0x90 && m_3 > 0 && PATN < 32 ? ( PAT[PATN] = m_2;  PATV[PATN] = m_3 / 127;  PATN += 1;  PATN >= 32 ? rec_on = 0; );
      midisend(m_ofs, m_1, m_2, m_3);
