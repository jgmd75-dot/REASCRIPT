tr_play = play_state & 1;
tr_sort();
tr_pf = -1;  tr_i = 0;  while (tr_i < PATN && tr_pf < 0) ( PAT[tr_i] >= 0 ? tr_pf = PAT[tr_i];  tr_i += 1; );
