desc:Trendel [section arpeggiator] (GFX Lab)
//tags: midi arpeggiator arp section phasing canon round step sequencer utility
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider38:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:src=0<0,1,1{Chord,Pattern}>-Source
slider2:amode=0<0,6,1{Up,Down,Up-Down,Down-Up,As played,Random,Chord}>-Mode
slider3:arate=3<0,5,1{1/4,1/8,1/8 T,1/16,1/16 T,1/32}>-Rate
slider4:octs=1<1,4,1>-Octaves
slider5:agate=70<10,100,1>-Gate (%)
slider6:aswing=0<0,75,1>-Swing (%)
slider7:ahold=0<0,1,1{Off,On}>-Hold
slider8:asnap=1<0,1,1{Free,Snap}>-Shift snap
slider9:aspread=50<0,100,1>-Spread (%)
slider10:rnd_on=1<0,1,1{Off,On}>-Round
slider11:abreath=10<3,30,0.1>-Breath length (s)
slider12:sh2=0<0,6,1{Off,1 bar,2 bars,4 bars,8 bars,16 bars,32 bars}>-Shift player 2 (bars per step)
slider13:sh3=0<0,6,1{Off,1 bar,2 bars,4 bars,8 bars,16 bars,32 bars}>-Shift player 3 (bars per step)
slider14:sh4=0<0,6,1{Off,1 bar,2 bars,4 bars,8 bars,16 bars,32 bars}>-Shift player 4 (bars per step)
slider15:sh5=0<0,6,1{Off,1 bar,2 bars,4 bars,8 bars,16 bars,32 bars}>-Shift player 5 (bars per step)
slider16:pm1=100<0,100,1>-Player 1 level (%)
slider17:pm2=100<0,100,1>-Player 2 level (%)
slider18:pm3=100<0,100,1>-Player 3 level (%)
slider19:pm4=100<0,100,1>-Player 4 level (%)
slider20:pm5=0<0,100,1>-Player 5 level (%)
slider21:chans=0<0,1,1{Off,On}>-Channels
slider22:ch1=1<1,16,1>-Player 1 channel
slider23:ch2=2<1,16,1>-Player 2 channel
slider24:ch3=3<1,16,1>-Player 3 channel
slider25:ch4=4<1,16,1>-Player 4 channel
slider26:ch5=5<1,16,1>-Player 5 channel
slider27:po1=0<-2,2,1>-Player 1 octave
slider28:po2=0<-2,2,1>-Player 2 octave
slider29:po3=0<-2,2,1>-Player 3 octave
slider30:po4=0<-2,2,1>-Player 4 octave
slider31:po5=0<-2,2,1>-Player 5 octave
slider32:eatk=0<-100,100,1>-Attack (%)
slider33:edec=0<-100,100,1>-Decay (%)
slider34:erel=0<-100,100,1>-Release (%)
slider35:vary=50<0,100,1>-Vary (%)
slider36:byp=0<0,1,1{Off,On}>-Bypass
slider37:prs_sel=0<0,13,1{No preset,Init,Rising Four,Slow Canon,Phase Drift,Free Phasing,Chord Breath,Random Rain,Triplet Wheel,Swung Eights,Short Tongues,Soft Swell,Long Round,Pattern Round}>-Preset

in_pin:none
out_pin:none

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

@init
function psw_all(v) ( slider_show(274877906943, v); );
function psw_allg(v) ( slider_show(274877906943, v); );
#ui_man = "gfx-lab-trendel";
#tr_pm = "Init|Rising Four|Slow Canon|Phase Drift|Free Phasing|Chord Breath|Random Rain|Triplet Wheel|Swung Eights|Short Tongues|Soft Swell|Long Round|Pattern Round";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;

HP = 1000;  HV = 1040;  HS = 1080;  TS = 1160;  TV = 1200;
PAT = 2000;  PATV = 2040;
PLIB = 3000;  PLIS = 74;  PLIN = 21;
QT = 6000;  QY = 6600;  QC = 7200;  QN = 7800;  QV = 8400;  QMAX = 560;
SN = 10000;  LCC = 12100;  RT = 12200;
PHP = 12300;  PHS = 12310;  PHT = 12320;  PHF = 12330;  PLA = 12340;  PLN = 12350;  PLS = 12360;  PLT = 12370;  PLF = 12380;  PLB = 12390;
PMT = 12400;  PRC = 12410;  PVR = 12420;  SHT = 12450;  PFL = 12460;  PCH = 12470;  POC = 12480;  PSX = 12490;
ART = 12500;  PVL = 12530;

function lb_set(i, n, pl, sh, sq, rq, o1, o2, o3, o4, o5) local(b) (
  b = PLIB + i * PLIS;  memset(b, 0, PLIS);
  b[0] = n;  b[1] = pl;  b[2] = sh;  b[3] = sq;  b[4] = rq;  b[5] = o1;  b[6] = o2;  b[7] = o3;  b[8] = o4;  b[9] = o5;
  lb_i = i;  lb_k = 0;
);
function lb_n(a) local(b) ( b = PLIB + lb_i * PLIS + 10;  b[lb_k] = a;  b[32 + lb_k] = lb_k == 0 ? 0.85 : lb_k % 2 ? 0.62 : 0.72;  lb_k += 1; );
function lb_4(a, b, c, d) ( lb_n(a);  lb_n(b);  lb_n(c);  lb_n(d); );
function lb_3(a, b, c) ( lb_n(a);  lb_n(b);  lb_n(c); );

lb_set(0, 6, 5, 3, 0, 1, 0, 0, 1, 0, -1);  lb_3(60, 64, 60);  lb_3(64, 65, 64);
lb_set(1, 8, 5, 4, 0, 1, 0, 1, 0, 0, -1);  lb_4(64, 65, 64, -1);  lb_4(64, 65, 64, 67);
lb_set(2, 8, 4, 3, 0, 1, 0, 0, 1, -1, 0);  lb_4(62, 66, 67, 69);  lb_4(-1, 67, 66, 62);
lb_set(3, 8, 5, 5, 0, 1, 1, 1, 0, 0, 1);  lb_4(72, 72, 72, 72);  lb_4(72, 72, 72, 72);
lb_set(4, 16, 5, 2, 0, 1, 0, 0, -1, 1, 0);  lb_4(60, -1, -1, -1);  lb_4(67, -1, -1, -1);  lb_4(65, -1, -1, -1);  lb_4(64, -1, -1, -1);
lb_set(5, 8, 4, 3, 0, 1, 0, 1, 0, -1, 0);  lb_4(67, 70, 72, 74);  lb_4(72, 70, 67, 65);
lb_set(6, 10, 5, 4, 0, 1, 0, 0, 1, -1, 1);  lb_4(55, 62, 67, 62);  lb_3(55, 62, 69);  lb_3(62, 67, -1);
lb_set(7, 12, 2, 4, 1, 3, 0, 0, 0, 0, 0);  lb_4(64, 67, 71, 72);  lb_4(67, 64, 74, 72);  lb_4(71, 67, 72, 74);
lb_set(8, 12, 2, 3, 1, 3, 0, 0, 0, 0, 0);  lb_4(67, 67, -1, 67);  lb_4(-1, 67, 67, 67);  lb_4(-1, 67, -1, -1);
lb_set(9, 8, 3, 4, 1, 3, 0, 0, 1, 0, 0);  lb_4(69, 69, 73, 73);  lb_4(76, 76, 73, 73);
lb_set(10, 12, 3, 4, 1, 3, 0, 0, 0, 0, 0);  lb_4(64, -1, 67, 69);  lb_4(-1, 71, 74, -1);  lb_4(71, 69, -1, 67);
lb_set(11, 8, 2, 5, 1, 3, 0, 0, 0, 0, 0);  lb_4(62, -1, 69, -1);  lb_4(64, 71, -1, 66);
lb_set(12, 8, 3, 4, 1, 3, 0, 1, 0, 0, 0);  lb_4(59, 62, 66, 62);  lb_4(64, 66, 69, 66);
lb_set(13, 16, 2, 3, 1, 3, 0, 0, 0, 0, 0);  lb_4(64, 66, 71, -1);  lb_4(73, 71, -1, 66);  lb_4(64, -1, 69, 71);  lb_4(-1, 69, 66, -1);
lb_set(14, 9, 2, 0, 1, 3, 0, -1, 0, 0, 0);  lb_3(57, 60, 57);  lb_3(60, 64, 57);  lb_3(60, 64, 67);
lb_set(15, 8, 2, 0, 1, 3, 0, -1, 0, 0, 0);  lb_4(57, 60, 64, 60);  lb_4(53, 57, 60, 57);
lb_set(16, 12, 2, 0, 1, 4, 0, 1, 0, 0, 0);  lb_4(60, 64, 67, 64);  lb_4(67, 72, 67, 64);  lb_4(60, 64, 67, 72);
lb_set(17, 12, 2, 0, 1, 3, 0, -1, 0, 0, 0);  lb_4(57, 60, 64, 59);  lb_4(62, 65, 60, 64);  lb_4(67, 62, 65, 69);
lb_set(18, 16, 2, 0, 1, 3, 0, -1, 0, 0, 0);  lb_4(57, 64, 60, 64);  lb_4(55, 62, 59, 62);  lb_4(53, 60, 57, 60);  lb_4(52, 59, 56, 59);
lb_set(19, 8, 2, 0, 1, 3, -1, 0, 0, 0, 0);  lb_4(45, 52, 57, 52);  lb_4(57, 60, 57, 52);
lb_set(20, 10, 3, 6, 1, 3, 0, -1, 1, 0, 0);  lb_n(62);  lb_n(65);  lb_n(69);  lb_n(65);  lb_n(69);  lb_n(72);  lb_n(69);  lb_n(65);  lb_n(69);  lb_n(65);

#tr_plm = "Modal Cell|Grace Turn|Sharp Fourth|High Pulse|Long Tones|Mixolydian Loop|Drone Bloom|Phase Twelve|Clap Cell|Pulse Chords|Mallet Canon|Interlock|Resulting Lines|Sixteen Shift|One Two Three|Two Chords|Three Over Two|Rising Triads|Falling Cadence|Low Ostinato|Additive Ten";

function ar_set(i, v, lq, a, d, r) local(b) ( b = ART + i * 5;  b[0] = v;  b[1] = lq;  b[2] = a;  b[3] = d;  b[4] = r; );
ar_set(0, 1, 0.9, -10, 0, 0);
ar_set(1, 0.82, 1.1, 12, 6, 6);
ar_set(2, 0.92, 0.7, -16, -8, -8);
ar_set(3, 0.7, 1.15, 24, 10, 12);
ar_set(4, 1.08, 1, -4, 4, 4);

!tr_seed ? (
  tr_seed = 1;
  tr_i = 0;  loop(25, PVR[tr_i] = rand(2) - 1;  tr_i += 1; );
  PVR[0] = 0;  PVR[1] = 0;  PVR[2] = 0;
  memset(PAT, 0, 80);
  PATN = PLIB[15 * PLIS];  tr_i = 0;  loop(32, PAT[tr_i] = PLIB[15 * PLIS + 10 + tr_i];  PATV[tr_i] = PLIB[15 * PLIS + 42 + tr_i];  tr_i += 1; );
);
function tr_rtab() local(i) ( i = 0;  loop(16, RT[i] = rand(1);  i += 1; ); );
tr_rtab();
memset(SN, 0, 2048);  memset(LCC, -1, 48);
q_n = 0;  os_n = 0;  oh_n = 0;  tr_scnt = 0;  tr_in = 0;  tr_sus = 0;  rec_on = 0;
tr_i = 0;  loop(5, PHP[tr_i] = 0;  PHS[tr_i] = 0;  PHT[tr_i] = 0;  PLA[tr_i] = -1000000000;  PLN[tr_i] = 1 - tr_i * 0.19;  PLS[tr_i] = 0;  PLF[tr_i] = 0;  PLB[tr_i] = 1;  PRC[tr_i] = tr_i;  PFL[tr_i] = 0;  PSX[tr_i] = -1;  tr_i += 1; );
tr_wrun = 0;  tr_wplay = 0;  tr_fb = 0;  tr_exp = 0;  g_tp = 0;  g_gpp = 0;  g_gpd = 0;  tr_wbyp = 0;

function q_add(t, ty, c, n, v) (
  q_n < QMAX ? ( QT[q_n] = t;  QY[q_n] = ty;  QC[q_n] = c;  QN[q_n] = n;  QV[q_n] = v;  q_n += 1; );
);
function q_note(t, d, n, v, c) (
  n >= 0 && n <= 127 ? (
    q_add(t, 2, c, n, min(max(floor(v + 0.5), 1), 127));
    q_add(t + d, 0, c, n, 0);
  );
);
function q_emit(t0, ns) local(i, b, bt, by, ofs, k, c, n) (
  loop(q_n,
    b = -1;  bt = 0;  by = 0;  i = 0;
    loop(q_n, QT[i] < t0 + ns && (b < 0 || QT[i] < bt || (QT[i] == bt && QY[i] < by)) ? ( b = i;  bt = QT[i];  by = QY[i]; );  i += 1; );
    b >= 0 ? (
      ofs = min(max(floor(bt - t0), 0), ns - 1);
      c = QC[b];  n = QN[b];  k = SN + c * 128 + n;
      by == 2 ? (
        k[0] > 0 ? midisend(ofs, 0x80 | c, n, 0);
        midisend(ofs, 0x90 | c, n, QV[b]);  k[0] += 1;
      ) : by == 1 ? (
        midisend(ofs, 0xB0 | c, n, QV[b]);
      ) : (
        k[0] > 0 ? ( k[0] -= 1;  k[0] == 0 ? midisend(ofs, 0x80 | c, n, 0); );
      );
      q_n -= 1;
      QT[b] = QT[q_n];  QY[b] = QY[q_n];  QC[b] = QC[q_n];  QN[b] = QN[q_n];  QV[b] = QV[q_n];
    );
  );
);
function q_flush(ofs) local(i) (
  q_n = 0;
  i = 0;  loop(2048, SN[i] > 0 ? ( midisend(ofs, 0x80 | (i >> 7), i & 127, 0);  SN[i] = 0; );  i += 1; );
  memset(LCC, -1, 48);
);

function tr_key(n, v, c, on) local(i, f) (
  tr_in = c;
  on ? (
    ahold && oh_n == 0 ? os_n = 0;
    f = 0;  i = 0;  loop(oh_n, HP[i] == n ? f = 1;  i += 1; );
    !f && oh_n < 32 ? ( HP[oh_n] = n;  oh_n += 1; );
    f = 0;  i = 0;  loop(os_n, HS[i] == n ? ( f = 1;  HV[i] = v; );  i += 1; );
    !f && os_n < 32 ? ( HS[os_n] = n;  HV[os_n] = v;  os_n += 1; );
  ) : (
    i = 0;  f = -1;  loop(oh_n, HP[i] == n ? f = i;  i += 1; );
    f >= 0 ? ( i = f;  loop(oh_n - f - 1, HP[i] = HP[i + 1];  i += 1; );  oh_n -= 1; );
    !ahold ? (
      i = 0;  f = -1;  loop(os_n, HS[i] == n ? f = i;  i += 1; );
      f >= 0 ? ( i = f;  loop(os_n - f - 1, HS[i] = HS[i + 1];  HV[i] = HV[i + 1];  i += 1; );  os_n -= 1; );
    );
  );
);
function tr_sort() local(i, j, n, v) (
  i = 0;  loop(os_n, TS[i] = HS[i];  TV[i] = HV[i];  i += 1; );
  i = 1;
  loop(max(os_n - 1, 0),
    n = TS[i];  v = TV[i];  j = i - 1;
    while (j >= 0 && TS[j] > n) ( TS[j + 1] = TS[j];  TV[j + 1] = TV[j];  j -= 1; );
    TS[j + 1] = n;  TV[j + 1] = v;
    i += 1;
  );
);
function tr_md(a, n) ( a - n * floor(a / n); );
function tr_seqlen() local(nd) (
  src >= 0.5 ? max(1, PATN) * tr_oct : (
    nd = max(1, os_n * tr_oct);
    tr_mode == 6 ? tr_oct : tr_mode == 5 ? 16 : tr_mode == 2 || tr_mode == 3 ? max(1, 2 * nd - 2) : nd;
  );
);
function tr_idx(m, nd) local(p) (
  tr_mode == 0 || tr_mode == 4 ? tr_md(m, nd) :
  tr_mode == 1 ? nd - 1 - tr_md(m, nd) :
  tr_mode == 5 ? min(nd - 1, floor(RT[tr_md(m, 16)] * nd)) :
  nd < 2 ? 0 : ( p = tr_md(m, 2 * nd - 2);  p = p < nd ? p : 2 * nd - 2 - p;  tr_mode == 3 ? nd - 1 - p : p; );
);
function tr_acc(t) local(bn, f, d, w) (
  w = 0;
  tr_play ? (
    bn = max(1, ts_num | 0);
    f = t - floor(t / bn) * bn;
    d = f - floor(f + 0.5);
    abs(d) < 0.07 ? ( w = floor(f + 0.5) % bn == 0 ? 1 : bn % 2 == 0 && floor(f + 0.5) == bn / 2 ? 0.7 : 0.5; )
    : abs(f - floor(f) - 0.5) < 0.06 ? w = 0.22;
  );
  w;
);
function tr_cc(t, c, j, v) local(k) (
  v = min(max(floor(v + 0.5), 0), 127);
  k = LCC + c * 3 + j;
  k[0] != v ? ( k[0] = v;  q_add(t, 1, c, j == 0 ? 73 : j == 1 ? 75 : 72, v); );
);
function tr_trig(k, m, tq, sl, tb) local(a, ab, vf, lf, dl, c, sp, vr, n, nd, i, x, key, oc, tp, v, ln, pv) (
  rnd_on >= 0.5 && (PLS[k] == 1 || PLS[k] == 2) ? 0 : (
    sp = aspread / 100;  vr = vary / 100;  pv = PVR + k * 5;
    a = PRC[k];  PRC[k] = (a + 1 + (rand(1) < 0.2)) % 5;  ab = ART + a * 5;
    vf = PVL[k] * (1 + (ab[0] - 1) * vr) * (1 + pv[0] * 0.1 * sp) * PLB[k] * (1 + 0.15 * tr_acc(tb) * vr) * (1 + (rand(2) - 1) * 0.04 * vr);
    lf = (1 + (ab[1] - 1) * vr) * (1 + pv[1] * 0.12 * sp);
    ln = max(agate / 100 * sl * lf, 0.004 * srate);
    dl = k == 0 ? 0 : (0.003 + abs(pv[2]) * 0.012 + rand(1) * 0.008) * sp * srate;
    c = chans >= 0.5 ? PCH[k] - 1 : tr_in;
    chans >= 0.5 ? (
      tr_cc(tq + dl, c, 0, 64 + eatk * 0.63 + pv[3] * 12 * sp + ab[2] * vr);
      tr_cc(tq + dl, c, 1, 64 + edec * 0.63 + pv[4] * 10 * sp + ab[3] * vr);
      tr_cc(tq + dl, c, 2, 64 + erel * 0.63 + (pv[3] + pv[4]) * 6 * sp + ab[4] * vr);
    );
    oc = POC[k] * 12;
    src >= 0.5 ? (
      x = tr_md(m, max(1, PATN));  PSX[k] = x;
      key = PAT[x];
      key >= 0 ? (
        tp = os_n > 0 && tr_pf >= 0 ? TS[0] - tr_pf : 0;
        key += tp + 12 * tr_md(floor(m / max(1, PATN)), tr_oct) + oc;
        q_note(tq + dl, ln, key, max(0.3, PATV[x]) * 127 * vf, c);  PFL[k] += 1;
      );
    ) : os_n > 0 ? (
      n = os_n;
      tr_mode == 6 ? (
        x = tr_md(m, tr_oct);  PSX[k] = x;
        i = 0;  loop(n, q_note(tq + dl, ln, TS[i] + 12 * x + oc, TV[i] * vf - 3 * i, c);  i += 1; );
      ) : (
        nd = n * tr_oct;  x = tr_idx(m, nd);  PSX[k] = tr_md(m, tr_sql);
        i = tr_md(x, n);
        tr_mode == 4 ? ( key = HS[i];  v = HV[i]; ) : ( key = TS[i];  v = TV[i]; );
        q_note(tq + dl, ln, key + 12 * floor(x / n) + oc, v * vf, c);
      );
      PFL[k] += 1;
    );
  );
);

function tr_shift(dt, L) local(k, sh, bt, bar, u) (
  bar = max(1, ts_num | 0) * 4 / (ts_denom > 0 ? ts_denom : 4) * 60 / max(20, tempo > 0 ? tempo : 120);
  PHP[0] = 0;
  k = 1;
  loop(4,
    sh = SHT[k];  bt = 2 ^ (max(1, min(6, sh)) - 1) * bar / 1.55;
    tr_run && sh > 0 && PMT[k] ? (
      asnap < 0.5 ? (
        PHP[k] += dt / (bt * 1.55);  PHS[k] = 0;  PHT[k] = bt * 0.55;
      ) : PHS[k] == 0 ? (
        PHT[k] = min(PHT[k], bt * 0.55) - dt;
        PHT[k] <= 0 ? ( PHS[k] = 1;  PHF[k] = PHP[k];  PHT[k] = 0; );
      ) : (
        PHT[k] += dt / bt;  u = min(1, PHT[k]);  PHP[k] = PHF[k] + u * u * (3 - 2 * u);
        PHT[k] >= 1 ? ( PHP[k] = PHF[k] + 1;  PHS[k] = 0;  PHT[k] = bt * 0.55; );
      );
    ) : sh <= 0 ? (
      PHP[k] > L * 0.5 ? PHP[k] += dt * 0.5 : PHP[k] = max(0, PHP[k] - dt * 0.5);
      PHS[k] = 0;  PHT[k] = bt * 0.55;
    );
    PHP[k] >= L ? ( u = L * floor(PHP[k] / L);  PHP[k] -= u;  PLA[k] -= u; );
    k += 1;
  );
);
function tr_breath(dt) local(pl, k, act, busy, need, g, nout, fk) (
  fk = exp(-dt / 3.5);  nout = 0;  pl = 0;
  loop(5,
    act = tr_run && PMT[pl];
    busy = 0;  k = 0;  loop(5, k != pl && PLS[k] > 0 ? busy = 1;  k += 1; );
    PLS[pl] == 0 ? (
      act ? PLN[pl] -= dt / max(3, abreath);
      need = PLN[pl] <= 0 && act;
      need && (!busy || PLN[pl] < -0.35) ? ( PLS[pl] = 1;  PLT[pl] = 0.35 + rand(1) * 0.1; );
      g = (0.8 + 0.2 * min(1, max(0, PLN[pl]) * 4)) * (1 + 0.16 * PLF[pl]);
    ) : PLS[pl] == 1 ? (
      PLT[pl] -= dt;  g = 0;
      PLT[pl] <= 0 ? ( PLS[pl] = 2;  PLT[pl] = 0.7 + rand(1) * 0.35; );
    ) : PLS[pl] == 2 ? (
      PLT[pl] -= dt;  g = 0;  PLN[pl] = min(1, PLN[pl] + dt * 1.4);
      PLT[pl] <= 0 ? ( PLS[pl] = 3;  PLT[pl] = 0.45;  PLN[pl] = 1;  PLF[pl] = 1; );
    ) : (
      PLT[pl] -= dt;  g = 1 + 0.16 * PLF[pl];
      PLT[pl] <= 0 ? PLS[pl] = 0;
    );
    PLF[pl] *= fk;
    PLS[pl] == 1 || PLS[pl] == 2 ? nout += 1;
    rnd_on < 0.5 ? ( PLS[pl] = 0;  PLN[pl] = 1 - pl * 0.19;  PLF[pl] = 0;  g = 1; );
    PLB[pl] = g;
    pl += 1;
  );
  nout > 0 ? ( pl = 0;  loop(5, PLS[pl] != 1 && PLS[pl] != 2 ? PLB[pl] *= 1 + 0.1 * nout;  pl += 1; ); );
);
function tr_fresh() local(k) (
