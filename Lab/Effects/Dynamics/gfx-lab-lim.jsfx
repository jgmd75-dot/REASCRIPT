desc:Līm [clean drive compressor] (GFX Lab)
//tags: dynamics compressor limiter drive saturation clean peak transient return parallel stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-sliders

slider14:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-12,18,0.1>-Input (dB)
slider3:9<0,24,0.1>-Drive (dB)
slider4:1<0,6,1{Soft,Warm,Firm,Hard,Fuzz,Valve,Iron}>-Curve
slider5:80<20,1000,1>-Release (ms)
slider6:0<0,1,1{Clean,Drive}>-Mode
slider7:50<0,100,1>-Return (%)
slider8:2200<110,9900,1>-Return tone (Hz)
slider9:0<-18,18,0.1>-Output (dB)
slider10:100<0,100,1>-Mix (%)
slider11:1<0,1,1{Off,On}>-Link
slider12:0<0,2,1{1x,2x,4x}>-Oversampling
slider15:2<0.5,50,0.1>-Attack (ms)
slider16:60<5,500,1>-Decay (ms)
slider17:100<0,100,1>-Sustain (%)
slider13:prs_sel=0<0,9,1{No preset,Init,Clean Peaks,Gentle Hold,Firm Catch,Hard Catch,Drum Buss,Valve Body and Air,Iron Weight,Fuzz with Clean Top}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(131071, v); );
function psw_allg(v) ( slider_show(131071, v); );
#ui_man = "gfx-lab-lim";
ext_noinit = 1;

CL_DL = 100000; CL_N = 8192;

function cl_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function cl_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function cl_db(d) ( exp(d * 0.11512925464970228); );
function cl_pw(u, p) local(a) ( a = abs(u); a < 0.0000001 ? u : u / (1 + a ^ p) ^ (1 / p); );
function cl_fp(u, c) (
  c == 0 ? cl_pw(u, 1.5) : c == 1 ? cl_pw(u, 2) : c == 2 ? cl_pw(u, 4) : c == 3 ? cl_pw(u, 10) :
  c == 4 ? (cl_pw(2.2 * u + 0.3, 8) - cl_fzb) / 2.2 :
  c == 5 ? ( u >= 0 ? cl_pw(u, 2) : cl_pw(u * 0.6, 2.5) / 0.6 ) :
  cl_pw(u, 3);
);
function cl_one(u, c) instance(l) local(y) (
  c == 6 ? (
    l += cl_ilk * (u - l);
    y = cl_pw((u - l) * 0.35, 2) / 0.35;
    y + cl_pw(l * 1.6 + 0.08, 3) / 1.6 - cl_irb;
  ) : cl_fp(u, c);
);
function cl_sh(x) local(u, a) (
  u = x * cl_k;
  a = this.cl_one(u, cl_c1);
  cl_cx < 1 ? a = this.cl_one(u, cl_c0) + cl_cs * (a - this.cl_one(u, cl_c0));
  a * cl_ik;
);
function cl_g1(e, el, c) local(u, v) (
  u = e * cl_k;
  c == 6 ? (
    v = 1.6 * el * cl_k; v = v < 0.0000001 ? 1 : cl_pw(v, 3) / v;
    u = u * 0.35; u < 0.0000001 ? v : v * cl_pw(u, 2) / u;
  ) : u < 0.0000001 ? 1 : (abs(cl_fp(u, c)) + abs(cl_fp(-u, c))) / (2 * u);
);
function cl_gt(e, el) local(a) (
  a = cl_g1(e, el, cl_c1);
  cl_cx < 1 ? a = cl_g1(e, el, cl_c0) + cl_cs * (a - cl_g1(e, el, cl_c0));
  a;
);
function cl_drv(xa, xb) (
  uxA.os_up(xa); uxB.os_up(xb);
  os_f == 1 ? ( cl_ya = shA.cl_sh(uxA.s0); cl_yb = shB.cl_sh(uxB.s0); ) :
  os_f == 2 ? (
    cl_ya = dnA.os_dn(shA.cl_sh(uxA.s0), shA.cl_sh(uxA.s1), 0, 0);
    cl_yb = dnB.os_dn(shB.cl_sh(uxB.s0), shB.cl_sh(uxB.s1), 0, 0);
  ) : (
    cl_ya = dnA.os_dn(shA.cl_sh(uxA.s0), shA.cl_sh(uxA.s1), shA.cl_sh(uxA.s2), shA.cl_sh(uxA.s3));
    cl_yb = dnB.os_dn(shB.cl_sh(uxB.s0), shB.cl_sh(uxB.s1), shB.cl_sh(uxB.s2), shB.cl_sh(uxB.s3));
  );
  cl_q = cl_ya - cl_dxa + cl_dcc * cl_dya; cl_dxa = cl_ya; cl_dya = cl_q; cl_ya = cl_q;
  cl_q = cl_yb - cl_dxb + cl_dcc * cl_dyb; cl_dxb = cl_yb; cl_dyb = cl_q; cl_yb = cl_q;
);
function cl_hp(x) instance(c1, c2) local(v1, v2, v3) (
  v3 = x - c2; v1 = cl_a1 * c1 + cl_a2 * v3; v2 = c2 + cl_a2 * c1 + cl_a3 * v3;
  c1 = 2 * v1 - c1; c2 = 2 * v2 - c2;
  x - 1.4142135623730951 * v1 - v2;
);
function cl_clear() (
  uxA.os_clr(); uxB.os_clr(); dnA.os_clr(); dnB.os_clr();
  hpA.c1 = hpA.c2 = hpB.c1 = hpB.c2 = 0; shA.l = shB.l = 0; cl_dxa = cl_dya = cl_dxb = cl_dyb = 0; cl_la2 = cl_lb2 = 0;
);
function cl_reset() (
  cl_clear(); memset(CL_DL, 0, 2 * CL_N); memset(BY_BUF, 0, 2 * BY_N);
  cl_ga = cl_gb = 1; cl_ea = cl_eb = cl_ua = cl_ub = 0; in_dxL = in_dyL = in_dxR = in_dyR = 0;
  cl_fi = 0;
);

#cl_pm = "Init|Clean Peaks|Gentle Hold|Firm Catch|Hard Catch|Drum Buss|Valve Body and Air|Iron Weight|Fuzz with Clean Top";
function cl_set(ig, dr, cv, rl, md, rt, tn, ou, mx, lk, at, dc, su) (
  slider15 = at; slider16 = dc; slider17 = su;
  slider2 = ig; slider3 = dr; slider4 = cv; slider5 = rl; slider6 = md; slider7 = rt; slider8 = tn; slider9 = ou; slider10 = mx; slider11 = lk;
);
function load_preset(p) local(i) (
  p == 1 ? cl_set(0,  9, 1,  80, 0, 50, 2200,   0, 100, 1,  2,  60, 100) :
  p == 2 ? cl_set(0, 10, 1,  60, 0, 50, 2200, 0.5, 100, 1, 0.5, 60, 100) :
  p == 3 ? cl_set(0,  7, 0, 220, 0, 50, 2200,   0, 100, 1,  5, 120,  70) :
  p == 4 ? cl_set(0, 12, 2,  50, 0, 50, 2200,   1, 100, 1,  1,  60, 100) :
  p == 5 ? cl_set(0, 12, 3,  30, 0, 50, 2200,   1, 100, 1, 0.5, 60, 100) :
  p == 6 ? cl_set(0, 14, 2,  40, 0, 50, 2200,   2,  70, 1, 12,  80,  40) :
  p == 7 ? cl_set(0, 12, 5,  80, 1, 60, 2200,   0, 100, 1,  2,  60, 100) :
  p == 8 ? cl_set(0, 12, 6,  80, 1, 40, 4400,   0, 100, 1,  2,  60, 100) :
  p == 9 ? cl_set(0, 14, 4,  80, 1, 65, 1100,   2, 100, 1,  2,  60, 100);
  i = 2; loop(10, ui_auto(i); i += 1; ); ui_auto(15); ui_auto(16); ui_auto(17);
  pr_cur = p;
);

function cl_lat() ( cl_la + os_lat(os_f); );
function cl_srinit() (
  cl_sr = srate;
  c_kn = cl_tc(30); c_mk = 1 / (0.015 * srate);
  cl_la = floor(0.002 * srate + 0.5);
    cl_fis = 1 / (0.01 * srate);
  cl_dcc = 1 - 2 * $pi * 5 / srate; cl_ilkb = 1 - exp(-2 * $pi * 160 / srate);
  cl_fzb = cl_pw(0.3, 8); cl_irb = cl_pw(0.08, 3) / 1.6;
  ost_init(0);
  os_base = cl_la;
  cl_clear(); memset(CL_DL, 0, 2 * CL_N);
);
os_design();
os_f = os_tf = os_f2n(slider12);
cl_srinit();
os_gsetup();
in_init();
cl_snap = 1; cl_fi = 1; cl_ga = cl_gb = 1; cl_w = 0;
pdc_delay = cl_lat();
by_setup(1);
pwr_init(); pwr_sag = 0.15; pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 9000; pwr_wu_wob = 0.2; pwr_bloom = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(17, i != 13 && i != 14 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(12));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != cl_sr ? cl_srinit();
cl_now = time_precise();
cl_tp > 0 && cl_now - cl_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > cl_gpp && play_position - cl_gpp < 4 * cl_gpd + 0.05) ? cl_reset();
cl_tp = cl_now; cl_gpp = play_position; cl_gpd = samplesblock / srate;
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider12); pdc_delay = cl_lat();
pdc_bot_ch = 0; pdc_top_ch = 2;
cl_igt = cl_db(min(max(slider2, -12), 18));
cl_kt = cl_db(min(max(slider3, 0), 24));
cl_ci = floor(min(max(slider4, 0), 6) + 0.5);
cl_snap ? ( cl_c0 = cl_c1 = cl_ci; cl_cx = 1; cl_cs = 1; ) : cl_ci != cl_c1 ? ( cl_c0 = cl_c1; cl_c1 = cl_ci; cl_cx = 0; );
cl_ilk = 1 - exp(-2 * $pi * 160 / (srate * os_f));
cl_kr = cl_tc(min(max(slider5, 20), 1000));
cl_kat = cl_tc(min(max(slider15, 0.5), 50) / 3);
cl_kd = cl_tc(min(max(slider16, 5), 500) / 3);
cl_sut = min(max(slider17, 0), 100) / 100;
cl_mdt = slider6 >= 0.5;
cl_rtt = min(max(slider7, 0), 100) / 100;
cl_tft = min(max(slider8, 110), 9900);
cl_ogt = cl_db(min(max(slider9, -18), 18));
cl_mxt = min(max(slider10, 0), 100) / 100;
cl_lkt = slider11 >= 0.5;
cl_snap ? ( cl_ig = cl_igt; cl_k = cl_kt; cl_md = cl_mdt; cl_rt = cl_rtt; cl_tf = cl_tft;
            cl_og = cl_ogt; cl_mx = cl_mxt; cl_lk = cl_lkt; cl_su = cl_sut; );
cl_snap = 0;
cl_tf += (cl_tft - cl_tf) * min(1, samplesblock / (0.03 * srate));
cl_q = tan($pi * min(cl_tf, 0.45 * srate) / srate);
cl_a1 = 1 / (1 + cl_q * (cl_q + 1.4142135623730951)); cl_a2 = cl_q * cl_a1; cl_a3 = cl_q * cl_a2;
hpA.c1 = cl_tn(hpA.c1); hpA.c2 = cl_tn(hpA.c2); hpB.c1 = cl_tn(hpB.c1); hpB.c2 = cl_tn(hpB.c2);
cl_gr_d = max(cl_gr_d, cl_gm); cl_gm = 0;
cl_md_d = cl_mdt;
os_snapb(slider(12));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
cl_ig += (cl_igt - cl_ig) * c_kn; cl_og += (cl_ogt - cl_og) * c_kn; cl_mx += (cl_mxt - cl_mx) * c_kn;
cl_k += (cl_kt - cl_k) * c_kn; cl_rt += (cl_rtt - cl_rt) * c_kn;
cl_lk += (cl_lkt - cl_lk) * c_kn; cl_su += (cl_sut - cl_su) * c_kn;
cl_ik = 1 / cl_k;
cl_cx < 1 ? ( cl_cx = min(cl_cx + c_mk, 1); cl_cs = cl_cx * cl_cx * (3 - 2 * cl_cx); );
cl_md = cl_mdt ? min(cl_md + c_mk, 1) : max(cl_md - c_mk, 0);
cl_xl = in_l * cl_ig; cl_xr = in_r * cl_ig;
pwr_in(cl_xl, cl_xr); cl_xl = pwr_l; cl_xr = pwr_r;
abs(cl_xl) < 0.000000000000001 ? cl_xl = 0; abs(cl_xr) < 0.000000000000001 ? cl_xr = 0;
CL_DL[cl_w] = cl_xl; CL_DL[CL_N + cl_w] = cl_xr;
cl_pa = abs(cl_xl); cl_pb = abs(cl_xr); cl_em = max(cl_pa, cl_pb);
cl_pa += cl_lk * (cl_em - cl_pa); cl_pb += cl_lk * (cl_em - cl_pb);
cl_la2 += cl_ilkb * (cl_xl - cl_la2); cl_lb2 += cl_ilkb * (cl_xr - cl_lb2);
cl_ola = abs(cl_la2); cl_olb = abs(cl_lb2); cl_em = max(cl_ola, cl_olb);
cl_ola += cl_lk * (cl_em - cl_ola); cl_olb += cl_lk * (cl_em - cl_olb);
cl_ta = cl_gt(cl_pa, cl_ola); cl_tb = cl_gt(cl_pb, cl_olb);
cl_ta = -8.685889638065035 * log(max(cl_ta, 0.00001)); cl_tb = -8.685889638065035 * log(max(cl_tb, 0.00001));
cl_ea += (cl_ta - cl_ea) * (cl_ta > cl_ea ? cl_kat : cl_kr);
cl_eb += (cl_tb - cl_eb) * (cl_tb > cl_eb ? cl_kat : cl_kr);
cl_ua += (cl_ea - cl_ua) * (cl_ea > cl_ua ? cl_kd : cl_kr);
cl_ub += (cl_eb - cl_ub) * (cl_eb > cl_ub ? cl_kd : cl_kr);
cl_qa = max(cl_ea - (1 - cl_su) * cl_ua, 0); cl_qb = max(cl_eb - (1 - cl_su) * cl_ub, 0);
cl_ga = cl_db(-cl_qa); cl_gb = cl_db(-cl_qb);
cl_gm = max(cl_gm, max(cl_qa, cl_qb));
os_gate();
os_chg ? ( cl_clear(); os_hold += 2 * samplesblock; );
cl_i = (cl_w - cl_la) & (CL_N - 1);
cl_drv(CL_DL[cl_i], CL_DL[CL_N + cl_i]);
cl_i = (cl_w - cl_lat()) & (CL_N - 1);
cl_ca = CL_DL[cl_i]; cl_cb = CL_DL[CL_N + cl_i];
cl_w = (cl_w + 1) & (CL_N - 1);
cl_ra = cl_ya + cl_rt * hpA.cl_hp(cl_ca - cl_ya);
cl_rb = cl_yb + cl_rt * hpB.cl_hp(cl_cb - cl_yb);
cl_s = cl_md * cl_md * (3 - 2 * cl_md);
cl_yl = cl_ca * cl_ga + cl_s * (cl_ra - cl_ca * cl_ga);
cl_yr = cl_cb * cl_gb + cl_s * (cl_rb - cl_cb * cl_gb);
pwr_out(cl_yl, cl_yr); cl_yl = pwr_l; cl_yr = pwr_r;
cl_osg = os_g * os_g * (3 - 2 * os_g);
cl_yl = cl_ca + cl_mx * (cl_yl * cl_osg - cl_ca);
cl_yr = cl_cb + cl_mx * (cl_yr * cl_osg - cl_cb);
cl_yl *= cl_og; cl_yr *= cl_og;
cl_yl != cl_yl ? cl_yl = 0; cl_yr != cl_yr ? cl_yr = 0;
cl_fi < 1 ? (
  cl_fi = min(cl_fi + cl_fis, 1); cl_q2 = cl_fi * cl_fi * (3 - 2 * cl_fi);
  cl_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; cl_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  cl_yl = cl_a + cl_q2 * (cl_yl - cl_a); cl_yr = cl_b + cl_q2 * (cl_yr - cl_b);
);
ost_out(cl_yl, cl_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
cl_pk_d = max(cl_pk_d, max(abs(spl0), abs(spl1)));
by_out();

@gfx 900 355
ui_begin(900, 355);
v5_begin();
CVF = 0x6E6A62; CVW = 0x22201D; CVI = 0xEDE6D3; CVA = 0xF2C98A; CVH = 0x161412; CVB = 0x1A1816;
CVT1 = 0xE8C89A; CVT2 = 0xF0A060; CVT3 = 0x9EC8D8; CVT4 = 0xD8D2C8;
sc != cv_fsc ? (
  cv_fsc = sc;
  cv_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  cv_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  cv_f6 = ui_fitfont(6, 24 * sc);
);
function cv_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * cv_kt * sc, 'b'); );
function cv_fa(px) ( gfx_setfont(10, "Arial", px * cv_ka * sc, 'b'); );
function cv_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function cv_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function cv_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function cv_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function cv_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.16); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.50)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(face); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function cv_step(x, y, w, h, d, f, face) local(a, b) (
  a = max(1, floor(d * 0.45 + 0.5)); b = max(1, d - a);
  cv_cham(x, y, w, h, a, f, ui_mix(f, 0, 0.14));
  cv_cham(x + a + 5, y + a + 5, w - 2 * a - 10, h - 2 * a - 10, b, ui_mix(f, 0, 0.10), face);
);
function cv_plate(x, y, w, h, ttl, rc) (
  cv_step(x, y, w, h, 6, CVF, CVW);
  strlen(ttl) ? ( cv_ft(15); ui_col(CVI); v5_t(x + w / 2, y + 26, ttl);
    ui_col(rc); v5_r(x + w / 2 - cv_tw(ttl) / 2, y + 37, cv_tw(ttl), 2.5); );
);
function cv_dwell(x, y, w, h) local(j) (
  ui_cola(0xFFFFFF, 0.10); v5_r(x, y + h, w + 1, 1.5); v5_r(x + w, y, 1.5, h + 1);
  ui_col(ui_mix(CVW, 0, 0.45)); v5_rr(x, y, w, h, 3);
  j = 0; loop(4, ui_cola(0, 0.16 - j * 0.035); v5_r(x + 1, y + 1 + j, w - 2, 1); v5_r(x + 1 + j, y + 2 + j, 1, h - 3 - j); j += 1; );
);
function cv_ends(cx, cy, rd, sz) local(t) (
  ui_col(0x9A948A); t = -0.75 * $pi; v5_d(cx + sin(t) * rd, cy - cos(t) * rd, sz); v5_d(cx - sin(t) * rd, cy - cos(t) * rd, sz);
);
