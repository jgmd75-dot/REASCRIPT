desc:Remote 66 [compressor] (GFX Lab)
//tags: compressor limiter vari-mu variable mu valve tube remote cutoff glue bus stereo mid side lateral vertical
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-thick, gfx-lab-v5-parts, gfx-lab-sliders

slider19:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-12,18,0.1>-Input (dB)
slider3:-12<-30,0,0.1>-Threshold (dBFS)
slider4:0<0,5,1{1,2,3,4,5,6}>-Time constant
slider5:50<0,100,1>-Bias (%)
slider6:0<-18,18,0.1>-Output (dB)
slider7:100<0,100,1>-Mix (%)
slider8:1<0,1,1{Off,On}>-Link
slider9:0<0,1,1{Stereo,Lat/Vert}>-Mode
slider10:0<0,1,1{Off,On}>-SC HPF
slider11:50<0,100,1>-Drift (%)
slider12:0<0,2,1{1x,2x,4x}>-Oversampling
slider14:0<0,100,1>-Drive (%)
slider15:0<0,1,1{Off,On}>-Thick
slider16:0<-12,6,0.1>-Mid (dB)
slider17:0<-12,6,0.1>-Side (dB)
slider18:prs_sel=0<0,8,1{No preset,Init,Glue Buss,Vocal Ride,Drum Squash,Gentle Master,Bass Hold,Lat Vert Wide,Parallel Smash}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(520191, v); );
function psw_allg(v) ( slider_show(520191, v); );
#ui_man = "gfx-lab-remote-66";
ext_noinit = 1;

function rm_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function rm_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function rm_db(d) ( exp(d * 0.11512925464970228); );
function rm_th(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

function rm_valve(v, g, e2) local(w) (
  w = v * g * 2;
  w = w + e2 * w * w;
  rm_th(w * 0.25 * rm_dv) * 2 / rm_dv * rm_dmu;
);
function rm_os(xa, xb, ga, gb) (
  rm_pa = rm_valve(xa, ga, rm_e2a);  rm_pb = rm_valve(xb, gb, rm_e2c);
  rm_ila += rm_ilk * (rm_pa - rm_ila); rm_ilb += rm_ilk * (rm_pb - rm_ilb);
  rm_pa += rm_th(rm_ila * 1.4) / 1.4 - rm_ila;
  rm_pb += rm_th(rm_ilb * 1.4) / 1.4 - rm_ilb;
);
function rm_rcoefs(f) ( rm_ilk = 1 - exp(-2 * $pi * 110 / (srate * f)); );
function rm_clear() ( uxA.os_clr(); uxB.os_clr(); dnA.os_clr(); dnB.os_clr(); rm_ila = rm_ilb = 0; );
function rm_reset() (
  rm_clear(); memset(BY_BUF, 0, 2 * BY_N);
  rm_dxa = rm_dya = rm_dxb = rm_dyb = 0; rm_hpa = rm_hpb = rm_hxa = rm_hxb = 0;
  rm_cfa = rm_csa = rm_cfb = rm_csb = 0; rm_ga = rm_gb = 1; rm_za = rm_zb = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  rm_fi = 0;
);

#rm_pm = "Init|Glue Buss|Vocal Ride|Drum Squash|Gentle Master|Bass Hold|Lat Vert Wide|Parallel Smash";
function rm_set(ig, th, tc, bi, ou, mx, lk, md, hp, dr, tk, mi, si) (
  slider2 = ig; slider3 = th; slider4 = tc; slider5 = bi; slider6 = ou; slider7 = mx; slider8 = lk; slider9 = md; slider10 = hp;
  slider14 = dr; slider15 = tk; slider16 = mi; slider17 = si;
);
function load_preset(p) local(i) (
  p == 1 ? rm_set(          0, -12,  0,  50,    0, 100,  1,  0,  0,    0,   0,    0,   0) :
  p == 2 ? rm_set(          2, -16,  3,  40,    2, 100,  1,  0,  1,   20,   1,    0,   0) :
  p == 3 ? rm_set(          4, -20,  1,  65,    4, 100,  1,  0,  1,   10,   0,    0,   0) :
  p == 4 ? rm_set(          8, -22,  0,  90,    4, 100,  1,  0,  0,   60,   1,    0,   0) :
  p == 5 ? rm_set(          0,  -8,  4,  20,  0.5, 100,  1,  0,  1,    0,   0,    0,   0) :
  p == 6 ? rm_set(          3, -18,  2,  70,    3, 100,  1,  0,  0,   30,   1,    0,  -3) :
  p == 7 ? rm_set(          2, -14,  5,  45,    1, 100,  0,  1,  1,    0,   0, -0.5,   2) :
  p == 8 ? rm_set(         10, -26,  0, 100,    2,  45,  1,  0,  0,   80,   1,    0,   0) :
  p == 9 ? ( rm_set(0, -12, 0, 50, 0, 100, 1, 0, 0, 0, 0, 0, 0); slider11 = 50; );
  i = 2; loop(16, ui_auto(i); i += 1; );
  pr_cur = p == 9 ? 1 : p;
);

function rm_srinit() (
  rm_sr = srate;
  c_kn = rm_tc(30); c_lk = rm_tc(10);
  rm_dcc = 1 - 2 * $pi * 5 / srate;
  rm_hpk = exp(-2 * $pi * 110 / srate);
  rm_mdk = 1 / (0.006 * srate);
  rm_fis = 1 / (0.01 * srate);
  ost_init(0);
  rm_rcoefs(os_f); rm_clear();
  thk_init(); thk_lift = 3; thk_drv = 1.4; thk_asym = 0.2; thk_tr = 1; thk_trim = 0;
);
os_design();
os_f = os_tf = os_f2n(slider12); os_base = 0;
rm_srinit();
os_gsetup();
in_init();
dSup.drift_init(0.8 + rand(1) * 0.4); dVa.drift_init(0.8 + rand(1) * 0.4); dVb.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
rm_snap = 1; rm_fi = 1; rm_ga = rm_gb = 1; rm_mdg = 1; rm_msa = slider9 >= 0.5;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_sag = 0.3; pwr_wu_loss = 1; pwr_wu_drv = 2; pwr_wu_lp = 7000; pwr_wu_wob = 0.4; pwr_bloom = 0.2;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(18, i != 18 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(12));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != rm_sr ? rm_srinit();
rm_now = time_precise();
rm_tp > 0 && rm_now - rm_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > rm_gpp && play_position - rm_gpp < 4 * rm_gpd + 0.05) ? rm_reset();
rm_tp = rm_now; rm_gpp = play_position; rm_gpd = samplesblock / srate;
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider12); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider11);
rm_n = samplesblock / srate;
rm_vs = dSup.drift_tick(0.03 * dm_s * rm_n);
rm_va = dVa.drift_tick(0.05 * dm_s * rm_n); rm_vb = dVb.drift_tick(0.05 * dm_s * rm_n);
rm_igt = rm_db(min(max(slider2, -12), 18));
rm_thc = min(max(slider3, -30), 0) + 0.4 * dm_a * rm_vs;
rm_tha_t = rm_thc + 0.3 * dm_a * rm_va; rm_thb_t = rm_thc + 0.3 * dm_a * rm_vb;
rm_b = min(max(slider5, 0), 100) / 100;
rm_k0t = 0.4 + 1.2 * rm_b; rm_k1t = 0.05 + 0.4 * rm_b; rm_kwt = 12 - 9 * rm_b;
rm_h2t = 0.004 + 0.012 * rm_b; rm_h2dt = 0.02 + 0.08 * rm_b;
rm_tci = floor(min(max(slider4, 0), 5) + 0.5);
rm_att = rm_tci == 0 || rm_tci == 1 || rm_tci == 5 ? 0.2 : 0.4;
rm_rel = rm_tci == 0 ? 300 : rm_tci == 1 ? 800 : rm_tci == 2 ? 2000 : rm_tci == 3 ? 5000 : rm_tci == 4 ? 2000 : 300;
rm_rls = rm_tci == 4 ? 10000 : rm_tci == 5 ? 25000 : 0;
rm_ka = rm_tc(rm_att); rm_kr = rm_tc(rm_rel);
rm_kas = rm_tc(400); rm_krs = rm_tc(max(rm_rls, 1));
rm_hon = slider10 >= 0.5;
rm_lkt = slider8 >= 0.5;
rm_mst = slider9 >= 0.5;
rm_ogt = rm_db(min(max(slider6, -18), 18));
rm_mxt = min(max(slider7, 0), 100) / 100;
rm_drv = min(max(slider14, 0), 100) / 100;
rm_dvt = rm_db(12 * rm_drv); rm_dmt = rm_db(1.2 * rm_drv); rm_d2t = 0.04 * rm_drv;
rm_tkon = slider15 >= 0.5;
rm_mit = rm_db(min(max(slider16, -12), 6)); rm_sit = rm_db(min(max(slider17, -12), 6));
rm_snap ? ( rm_ig = rm_igt; rm_tha = rm_tha_t; rm_thb = rm_thb_t; rm_k0 = rm_k0t; rm_k1 = rm_k1t; rm_kw = rm_kwt;
            rm_h2 = rm_h2t; rm_h2d = rm_h2dt; rm_og = rm_ogt; rm_mx = rm_mxt; rm_lk = rm_lkt; rm_hs = rm_hon; rm_msa = rm_mst;
            rm_dv = rm_dvt; rm_dmu = rm_dmt; rm_d2 = rm_d2t; rm_mi = rm_mit; rm_si = rm_sit; );
rm_snap = 0;
rm_ila = rm_tn(rm_ila); rm_ilb = rm_tn(rm_ilb); rm_cfa = rm_tn(rm_cfa); rm_cfb = rm_tn(rm_cfb);
rm_csa = rm_tn(rm_csa); rm_csb = rm_tn(rm_csb); rm_hpa = rm_tn(rm_hpa); rm_hpb = rm_tn(rm_hpb);
rm_gra_d = max(rm_gra_d, rm_gma); rm_grb_d = max(rm_grb_d, rm_gmb); rm_gma = rm_gmb = 0;
rm_ms_d = rm_msa;
os_snapb(slider(12));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
rm_ig += (rm_igt - rm_ig) * c_kn; rm_og += (rm_ogt - rm_og) * c_kn; rm_mx += (rm_mxt - rm_mx) * c_kn;
rm_tha += (rm_tha_t - rm_tha) * c_kn; rm_thb += (rm_thb_t - rm_thb) * c_kn;
rm_k0 += (rm_k0t - rm_k0) * c_kn; rm_k1 += (rm_k1t - rm_k1) * c_kn; rm_kw += (rm_kwt - rm_kw) * c_kn;
rm_h2 += (rm_h2t - rm_h2) * c_kn; rm_h2d += (rm_h2dt - rm_h2d) * c_kn;
rm_dv += (rm_dvt - rm_dv) * c_kn; rm_dmu += (rm_dmt - rm_dmu) * c_kn; rm_d2 += (rm_d2t - rm_d2) * c_kn; rm_mi += (rm_mit - rm_mi) * c_kn; rm_si += (rm_sit - rm_si) * c_kn;
rm_lk += (rm_lkt - rm_lk) * c_lk; rm_hs += (rm_hon - rm_hs) * c_lk;
rm_mst != rm_msa ? ( rm_mdg = max(rm_mdg - rm_mdk, 0); rm_mdg <= 0 ? rm_msa = rm_mst; ) : rm_mdg = min(rm_mdg + rm_mdk, 1);
rm_xl = in_l * rm_ig; rm_xr = in_r * rm_ig;
pwr_in(rm_xl, rm_xr); rm_xl = pwr_l; rm_xr = pwr_r;
rm_msa ? ( rm_xa = (rm_xl + rm_xr) * 0.7071067811865476; rm_xb = (rm_xl - rm_xr) * 0.7071067811865476; )
       : ( rm_xa = rm_xl; rm_xb = rm_xr; );
abs(rm_xa) < 0.000000000000001 ? rm_xa = 0; abs(rm_xb) < 0.000000000000001 ? rm_xb = 0;
rm_za = rm_xa * rm_ga; rm_zb = rm_xb * rm_gb;
rm_q = rm_za - rm_hxa; rm_hxa = rm_za; rm_hpa = rm_hpk * (rm_hpa + rm_q);
rm_q = rm_zb - rm_hxb; rm_hxb = rm_zb; rm_hpb = rm_hpk * (rm_hpb + rm_q);
rm_da = abs(rm_za + rm_hs * (rm_hpa - rm_za)); rm_db2 = abs(rm_zb + rm_hs * (rm_hpb - rm_zb));
rm_dm = max(rm_da, rm_db2);
rm_da += rm_lk * (rm_dm - rm_da); rm_db2 += rm_lk * (rm_dm - rm_db2);
rm_oa = 20 * log10(max(rm_da, 0.0000001)) - rm_tha; rm_ob = 20 * log10(max(rm_db2, 0.0000001)) - rm_thb;
rm_q = rm_kw * 0.5;
rm_oa = rm_oa >= rm_q ? rm_oa : rm_oa <= -rm_q ? 0 : sqr(rm_oa + rm_q) / (2 * rm_kw);
rm_ob = rm_ob >= rm_q ? rm_ob : rm_ob <= -rm_q ? 0 : sqr(rm_ob + rm_q) / (2 * rm_kw);
rm_cfa += (rm_oa - rm_cfa) * (rm_oa > rm_cfa ? rm_ka : rm_kr);
rm_cfb += (rm_ob - rm_cfb) * (rm_ob > rm_cfb ? rm_ka : rm_kr);
rm_rls > 0 ? (
  rm_csa += (rm_oa - rm_csa) * (rm_oa > rm_csa ? rm_kas : rm_krs);
  rm_csb += (rm_ob - rm_csb) * (rm_ob > rm_csb ? rm_kas : rm_krs);
  rm_ca = max(rm_cfa, rm_csa); rm_cb = max(rm_cfb, rm_csb);
) : ( rm_csa = rm_csb = 0; rm_ca = rm_cfa; rm_cb = rm_cfb; );
rm_gda = min(rm_ca * (rm_k0 + rm_k1 * rm_ca), 40); rm_gdb = min(rm_cb * (rm_k0 + rm_k1 * rm_cb), 40);
rm_gpa = rm_ga; rm_gpb = rm_gb;
rm_ga = rm_db(-rm_gda); rm_gb = rm_db(-rm_gdb);
rm_gma = max(rm_gma, rm_gda); rm_gmb = max(rm_gmb, rm_gdb);
rm_e2a = rm_h2 + rm_d2 + rm_h2d * min(rm_gda / 12, 1); rm_e2c = rm_h2 + rm_d2 + rm_h2d * min(rm_gdb / 12, 1);
os_gate();
os_chg ? ( rm_rcoefs(os_f); rm_clear(); os_hold += 2 * samplesblock; );
uxA.os_up(rm_xa); uxB.os_up(rm_xb);
os_f == 1 ? (
  rm_os(uxA.s0, uxB.s0, rm_ga, rm_gb); rm_ya = rm_pa; rm_yb = rm_pb;
) : (
  rm_dla = (rm_ga - rm_gpa) / os_f; rm_dlb = (rm_gb - rm_gpb) / os_f;
  rm_os(uxA.s0, uxB.s0, rm_gpa + rm_dla, rm_gpb + rm_dlb); rm_a0 = rm_pa; rm_b0 = rm_pb;
  rm_os(uxA.s1, uxB.s1, rm_gpa + 2 * rm_dla, rm_gpb + 2 * rm_dlb); rm_a1 = rm_pa; rm_b1 = rm_pb;
  os_f == 2 ? ( rm_ya = dnA.os_dn(rm_a0, rm_a1, 0, 0); rm_yb = dnB.os_dn(rm_b0, rm_b1, 0, 0); ) : (
    rm_os(uxA.s2, uxB.s2, rm_gpa + 3 * rm_dla, rm_gpb + 3 * rm_dlb); rm_a2 = rm_pa; rm_b2 = rm_pb;
    rm_os(uxA.s3, uxB.s3, rm_ga, rm_gb); rm_a3 = rm_pa; rm_b3 = rm_pb;
    rm_ya = dnA.os_dn(rm_a0, rm_a1, rm_a2, rm_a3); rm_yb = dnB.os_dn(rm_b0, rm_b1, rm_b2, rm_b3);
  );
);
rm_q = rm_ya - rm_dxa + rm_dcc * rm_dya; rm_dxa = rm_ya; rm_dya = rm_q; rm_ya = rm_q;
rm_q = rm_yb - rm_dxb + rm_dcc * rm_dyb; rm_dxb = rm_yb; rm_dyb = rm_q; rm_yb = rm_q;
rm_msa ? ( rm_yl = (rm_ya + rm_yb) * 0.7071067811865476; rm_yr = (rm_ya - rm_yb) * 0.7071067811865476; )
       : ( rm_yl = rm_ya; rm_yr = rm_yb; );
rm_yl *= rm_mdg; rm_yr *= rm_mdg;
thk_proc(rm_yl, rm_yr, rm_tkon); rm_yl = thk_l; rm_yr = thk_r;
pwr_out(rm_yl, rm_yr); rm_yl = pwr_l; rm_yr = pwr_r;
rm_osg = os_g * os_g * (3 - 2 * os_g);
rm_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; rm_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
rm_yl = rm_a + rm_mx * (rm_yl * rm_osg - rm_a);
rm_yr = rm_b + rm_mx * (rm_yr * rm_osg - rm_b);
rm_q = (rm_yl + rm_yr) * 0.5 * rm_mi; rm_z = (rm_yl - rm_yr) * 0.5 * rm_si;
rm_yl = (rm_q + rm_z) * rm_og; rm_yr = (rm_q - rm_z) * rm_og;
rm_yl != rm_yl ? rm_yl = 0; rm_yr != rm_yr ? rm_yr = 0;
rm_fi < 1 ? (
  rm_fi = min(rm_fi + rm_fis, 1); rm_q = rm_fi * rm_fi * (3 - 2 * rm_fi);
  rm_yl = rm_a + rm_q * (rm_yl - rm_a); rm_yr = rm_b + rm_q * (rm_yr - rm_b);
);
ost_out(rm_yl, rm_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
rm_pk_d = max(rm_pk_d, max(abs(spl0), abs(spl1)));
by_out();

@gfx 900 400
ui_begin(900, 400);
v5_begin();
RMF = 0x5C6878; RMW = 0x1B2330; RMI = 0xEDE6D3; RMA = 0xF2C98A; RMH = 0x141A22; RMB = 0x18202C;
RMT1 = 0x9FD8C4; RMT2 = 0xF2C98A; RMT3 = 0x9EC2E8; RMT4 = 0xC8B6E2;
sc != r6_fsc ? (
  r6_fsc = sc;
  r6_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  r6_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  r6_f6 = ui_fitfont(6, 24 * sc);
);
function r6_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * r6_kt * sc, 'b'); );
function r6_fa(px) ( gfx_setfont(10, "Arial", px * r6_ka * sc, 'b'); );
function r6_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function r6_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function r6_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  gfx_gradrect(x * sc, y * sc, w * sc, h * sc, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (h * sc), (g2 - g1) / (h * sc), (b2 - b1) / (h * sc), 0);
);
function r6_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function r6_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.16); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.50)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
