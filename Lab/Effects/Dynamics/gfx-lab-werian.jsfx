    fL.svf(wr_l); fR.svf(wr_r);
    wr_bnl = wr_dsh ? fL.hp : fL.bp; wr_bnr = wr_dsh ? fR.hp : fR.bp;
    wr_dd = max(abs(wr_bnl), abs(wr_bnr));
    wr_denv += (wr_dd - wr_denv) * (wr_dd > wr_denv ? wr_dat : wr_drel);
    wr_dov = wr_drm ? wr_g2db(wr_denv) - wr_g2db(wr_fenv) - wr_dths * 0.5 : wr_g2db(wr_denv) - wr_dths;
