#cv_pm = "Init|Kick Tight|Snare Snap|Tom Clean-Up|Hi-Hat Tidy|Vocal Clean|Vocal Air|Podcast Voice|Acoustic Guitar|Room Mic Tame|Bass DI Tidy|Gated Snare 80s|Drum Buss Snap";
function cv_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#cv_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 36, 26) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
