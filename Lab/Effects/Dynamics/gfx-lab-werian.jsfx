  ui_col(0xFFB030); v5_t(x + (w - 14) / 2, y + h / 2, #cv_os);
  ui_col(0xFFB030); gfx_triangle((x + w - 15) * sc, (y + h / 2 - 2.5) * sc, (x + w - 7) * sc, (y + h / 2 - 2.5) * sc, (x + w - 11) * sc, (y + h / 2 + 3) * sc);
  v5_pr && v5_drag == 0 && v5_hit(x, y, w, h) ? (
    v5_drag = -1;
