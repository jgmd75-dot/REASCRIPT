  ui_col(ui_mix(cv_cc, 0, 0.25)); v5_d(cx, cy, r * 0.74);
  ui_col(cv_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, 0x2A1E14);
);
function cv_hz(v) ( v >= 1000 ? sprintf(#cv_hzs, "%.1f kHz", v / 1000) : sprintf(#cv_hzs, "%d Hz", floor(v + 0.5)); #cv_hzs; );
function cv_val(idx, v) (
  idx == 4 || idx == 25 ? sprintf(#cv_vs, "%.1f dB", v) :
  idx == 32 ? sprintf(#cv_vs, "%+.1f dB", v) :
  idx == 5 || idx == 26 || idx == 11 ? sprintf(#cv_vs, "%.1f dB", v) :
  idx == 6 ? ( v < 1 ? sprintf(#cv_vs, "%.2f ms", v) : sprintf(#cv_vs, "%.1f ms", v) ) :
  idx == 7 || idx == 8 || idx == 18 || idx == 27 ? sprintf(#cv_vs, "%d ms", floor(v + 0.5)) :
  idx == 17 ? sprintf(#cv_vs, "%.1f ms", v) :
  idx == 9 ? ( v <= 20.5 ? strcpy(#cv_vs, "OFF") : cv_hz(v) ) :
  idx == 10 ? ( v >= 19999 ? strcpy(#cv_vs, "OFF") : cv_hz(v) ) :
  idx == 19 ? ( v <= 20.5 ? strcpy(#cv_vs, "OFF") : cv_hz(v) ) :
  idx == 24 ? cv_hz(v) :
  idx == 15 || idx == 16 ? sprintf(#cv_vs, "%+d %%", floor(v + (v < 0 ? -0.5 : 0.5))) :
