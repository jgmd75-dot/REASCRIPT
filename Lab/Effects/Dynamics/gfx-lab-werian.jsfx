);
function cv_ends(cx, cy, rd, sz) local(t) (
  ui_col(0x9A948A); t = -0.75 * $pi; v5_sd(cx + sin(t) * rd, cy - cos(t) * rd, sz); v5_sd(cx - sin(t) * rd, cy - cos(t) * rd, sz);
);
function cv_cap(cx, cy, r, v) local(a, i, t) (
  a = -0.75 * $pi + v * 1.5 * $pi;
  v5_shc(cx, cy, r);
