desc:Werian [gate, shaper and de-esser] (GFX Lab)
//tags: dynamics gate expander transient shaper de-esser sibilance drums vocal channel clean-up
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider35:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,1,1{Off,On}>-Gate
slider3:0<0,1,1{Gate,Expander}>-Gate mode
slider4:-60<-80,0,0.1>-Gate threshold (dB)
slider5:40<0,80,0.1>-Gate range (dB)
slider6:0.5<0.05,50,0.01>-Gate attack (ms)
slider7:40<0,500,1>-Gate hold (ms)
slider8:150<5,2000,1>-Gate release (ms)
slider9:20<20,4400,1>-Key HPF (Hz, 20 = off)
slider10:20000<1100,20000,1>-Key LPF (Hz, 20000 = off)
slider11:4<0,12,0.1>-Hysteresis (dB)
slider12:0<0,1,1{Off,On}>-Lookahead
slider13:0<0,1,1{Off,On}>-Key listen
slider14:1<0,1,1{Off,On}>-Shape
slider15:0<-100,100,1>-Shape attack (%)
slider16:0<-100,100,1>-Shape sustain (%)
slider17:20<5,60,0.1>-Shape speed (ms)
slider18:250<50,1000,1>-Shape length (ms)
slider19:20<20,550,1>-Shape focus (Hz, 20 = off)
slider20:0<0,1,1{Off,On}>-Keyed by gate
slider21:1<0,1,1{Off,On}>-De-ess
slider22:0<0,1,1{Split,Wide}>-De-ess mode
slider23:0<0,1,1{Band,High}>-De-ess shape
slider24:6600<2000,12000,1>-De-ess frequency (Hz)
slider25:-26<-50,0,0.1>-De-ess threshold (dB)
slider26:10<0,24,0.1>-De-ess range (dB)
slider27:60<20,300,1>-De-ess release (ms)
slider28:0<0,1,1{Off,On}>-De-ess auto threshold
slider29:0<0,1,1{Off,On}>-De-ess listen
slider30:0<0,2,1{Gate shape de-ess,Gate de-ess shape,De-ess gate shape}>-Order
slider31:100<0,100,1>-Mix (%)
slider32:0<-12,12,0.1>-Output (dB)
slider33:1<0,1,1{Off,On}>-Drift
slider34:prs_sel=0<0,13,1{No preset,Init,Kick Tight,Snare Snap,Tom Clean-Up,Hi-Hat Tidy,Vocal Clean,Vocal Air,Podcast Voice,Acoustic Guitar,Room Mic Tame,Bass DI Tidy,Gated Snare 80s,Drum Buss Snap}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
ext_gr_meter = 0;
function psw_all(v) ( slider_show(34359738367, v); );
function psw_allg(v) ( slider_show(34359738367, v); );
#ui_man = "gfx-lab-werian";
ext_noinit = 1;

WR_DL = 100000; WR_N = 4096;

function wr_db2g(d) ( exp(d * 0.11512925465); );
function wr_g2db(g) ( 8.68588963807 * log(max(g, 0.0000000001)); );
function wr_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * srate)); );
function wr_smst(v) ( v = max(0, min(1, v)); v * v * (3 - 2 * v); );
function wr_softk(o, w) ( o <= -w * 0.5 ? 0 : o >= w * 0.5 ? o : (o + w * 0.5) * (o + w * 0.5) / (2 * w); );

function bq_hp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.7071); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_lp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.7071); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function bq_tidy() instance(x1, x2, y1, y2) (
  abs(x1) < 0.000000000001 ? x1 = 0; abs(x2) < 0.000000000001 ? x2 = 0; abs(y1) < 0.000000000001 ? y1 = 0; abs(y2) < 0.000000000001 ? y2 = 0;
);

function gt_tgain(L, op) local(g, te, b) (
  wr_gmd == 0 ? (
    g = op ? 0 : -wr_grng;
  ) : (
    te = op ? wr_gthr - wr_ghy : wr_gthr;
    b = te - L;
    g = -min(wr_grng, wr_softk(b, 10));
  );
  g;
);
function gt_step(lv) instance(hl, hc, op, g, tg) local(above) (
  above = op ? (lv >= wr_gthr - wr_ghy) : (lv >= wr_gthr);
  above ? ( op = 1; hc = wr_ghold; hl = lv; ) : (
    hc > 0 ? hc -= 1 : ( op = 0; hl = lv; );
  );
  tg = gt_tgain(hl, op);
  g += (tg - g) * (tg > g ? wr_gca : wr_gcr);
  g;
);

function ts_det(d) instance(ef, es, eh) (
  ef += (d - ef) * (d > ef ? wr_cfa : wr_cfr);
  es += (d - es) * (d > es ? wr_csa : wr_cfr);
  eh += (d - eh) * (d > eh ? wr_cfa : wr_chr);
);
function ts_shape(at, st, kw) instance(ef, es, eh, gdb) local(fd, hd, w, ac, sc2) (
  fd = wr_g2db(ef); hd = wr_g2db(eh);
  w = min(max((hd + 66) / 12, 0), 1);
  ac = at * min(max(0, fd - wr_g2db(es)), 24) * 0.5 * kw; sc2 = st * min(max(0, hd - fd), 24) * 0.6 * w;
  gdb += (min(max(ac + sc2, -24), 15) - gdb) * 0.35;
  gdb;
);
function ts_clr() instance(ef, es, eh, gdb) ( ef = es = eh = gdb = 0; );
function ts_tidy() instance(ef, es, eh) ( abs(ef) < 0.0000000001 ? ef = 0; abs(es) < 0.0000000001 ? es = 0; abs(eh) < 0.0000000001 ? eh = 0; );

function svf_set(f, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(f, srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf(x) instance(g, k, a1, a2, a3, ic1, ic2, v1, v2, v3, hp, bp) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  hp = x - k * v1 - v2; bp = k * v1;
);
function svf_clr() instance(ic1, ic2, hp, bp) ( ic1 = ic2 = hp = bp = 0; );
function hshelf(x, lin) instance(ic1, ic2) local(shA, g, a1, a2, a3, v1, v2, v3) (
  shA = sqrt(max(lin, 0.0001)); g = wr_hsT * sqrt(shA);
  a1 = 1 / (1 + g * (g + 1.4142)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  shA * shA * x + 1.4142 * (1 - shA) * shA * v1 + (1 - shA * shA) * v2;
);
function hs_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );

function wr_fset() (
  fL.svf_set(wr_dfs, wr_dsh ? 0.7071 : 1.2); fR.svf_set(wr_dfs, wr_dsh ? 0.7071 : 1.2);
  wr_hsT = tan($pi * min(wr_dfs, srate * 0.45) / srate);
);
function wr_kset() (
  wr_khon = wr_khf > 20.5; wr_khon ? ( khL.bq_hp(wr_khf); khR.bq_hp(wr_khf); );
  wr_klon = wr_klf < 19999; wr_klon ? ( klL.bq_lp(wr_klf); klR.bq_lp(wr_klf); );
);
function wr_tset() ( tfL.bq_hp(wr_tfs); tfR.bq_hp(wr_tfs); );

function wr_latch() (
  wr_cur = wr_req;
  wr_ord = wr_cur & 3; wr_dmd = (wr_cur >> 2) & 1; wr_dsh = (wr_cur >> 3) & 1; wr_dli = (wr_cur >> 4) & 1;
  wr_drm = (wr_cur >> 5) & 1; wr_kli = (wr_cur >> 6) & 1; wr_lk = (wr_cur >> 7) & 1;
  wr_la = wr_lk ? floor(0.0015 * srate + 0.5) : 0;
  wr_fset();
);
function wr_setup() (
  wr_req = min(max(floor(slider30 + 0.5), 0), 2) + 4 * (slider22 >= 0.5) + 8 * (slider23 >= 0.5) + 16 * (slider29 >= 0.5)
         + 32 * (slider28 >= 0.5) + 64 * (slider13 >= 0.5) + 128 * (slider12 >= 0.5);
  wr_gon = slider2 >= 0.5; wr_gmd = slider3 >= 0.5;
  wr_gtht = min(max(slider4, -80), 0) + wr_dgt;
  wr_grng = min(max(slider5, 0), 80);
  wr_gca = wr_tc(min(max(slider6, 0.05), 50) * 0.001 / 3);
  wr_ghold = floor(min(max(slider7, 0), 500) * 0.001 * srate);
  wr_gcr = wr_tc(min(max(slider8, 5), 2000) * 0.001 / 3 * wr_drl);
  wr_khf = min(max(slider9, 20), 4400); wr_klf = min(max(slider10, 1100), 20000);
  wr_ghy = min(max(slider11, 0), 12);
  wr_son = slider14 >= 0.5;
  wr_sat = min(max(slider15, -100), 100) / 100 * wr_dad; wr_sst = min(max(slider16, -100), 100) / 100;
  wr_csa = wr_tc(min(max(slider17, 5), 60) * 0.001 * wr_dsp);
  wr_chr = wr_tc(min(max(slider18, 50), 1000) * 0.001 * wr_dln);
  wr_tft = min(max(slider19, 20), 550); wr_tfon = slider19 > 20.5;
  wr_kyt = slider20 >= 0.5;
  wr_don = slider21 >= 0.5;
  wr_dft = min(max(slider24, 2000), 12000) * wr_dfd;
  wr_dtht = min(max(slider25, -50), 0) + wr_ddt; wr_drgt = min(max(slider26, 0), 24);
  wr_drel = wr_tc(min(max(slider27, 20), 300) * 0.001 * wr_drl);
  wr_mixt = min(max(slider31, 0), 100) / 100;
  wr_outt = wr_db2g(min(max(slider32, -12), 12));
);
function wr_clear() (
  memset(WR_DL, 0, 2 * WR_N);
  khL.bq_clr(); khR.bq_clr(); klL.bq_clr(); klR.bq_clr(); tfL.bq_clr(); tfR.bq_clr();
  fL.svf_clr(); fR.svf_clr(); hsL.hs_clr(); hsR.hs_clr();
  tsA.ts_clr();
  wr_genv = 0; gG.hc = 0; gG.op = 0; gG.hl = -160; gG.g = gt_tgain(-160, 0); gG.tg = gG.g;
  wr_denv = 0; wr_dgr = 0; wr_fenv = 0;
  wr_dcx0 = wr_dcy0 = wr_dcx1 = wr_dcy1 = 0;
);

function wr_pg(on, md, th, rg, at, ho, re, hp, lp, hy, lk) (
  slider2 = on; slider3 = md; slider4 = th; slider5 = rg; slider6 = at; slider7 = ho; slider8 = re;
  slider9 = hp; slider10 = lp; slider11 = hy; slider12 = lk; slider13 = 0;
);
function wr_ps(on, at, su, sp, ln, fo, ky) (
  slider14 = on; slider15 = at; slider16 = su; slider17 = sp; slider18 = ln; slider19 = fo; slider20 = ky;
);
function wr_pd(on, md, sh, f, th, rg, re, au) (
  slider21 = on; slider22 = md; slider23 = sh; slider24 = f; slider25 = th; slider26 = rg; slider27 = re; slider28 = au; slider29 = 0;
);
function load_preset(p) (
  slider30 = 0; slider31 = 100; slider32 = 0; slider33 = 1;
  wr_pg(1, 0, -60, 40, 0.5, 40, 150, 20, 20000, 4, 0); wr_ps(1, 0, 0, 20, 250, 20, 0); wr_pd(1, 0, 0, 6600, -26, 10, 60, 0);
  p == 2 ? ( wr_pg(1, 0, -30, 60, 0.1, 30, 90, 20, 440, 6, 1); wr_ps(1, 30, -30, 25, 180, 20, 1); wr_pd(0, 0, 0, 6600, -26, 10, 60, 0); ) :
  p == 3 ? ( wr_pg(1, 0, -28, 40, 0.05, 40, 120, 220, 8800, 6, 1); wr_ps(1, 50, -10, 12, 200, 110, 1); wr_pd(0, 0, 0, 6600, -26, 10, 60, 0); ) :
  p == 4 ? ( wr_pg(1, 0, -36, 30, 1, 120, 400, 55, 3300, 8, 1); wr_ps(1, 20, 0, 20, 300, 20, 1); wr_pd(0, 0, 0, 6600, -26, 10, 60, 0); ) :
  p == 5 ? ( wr_pg(1, 0, -34, 24, 0.05, 15, 60, 4400, 20000, 5, 1); wr_ps(1, 20, -30, 10, 150, 20, 0); wr_pd(1, 1, 1, 9900, -22, 6, 60, 0); ) :
  p == 6 ? ( wr_pg(1, 1, -50, 12, 2, 80, 250, 110, 20000, 3, 0); wr_ps(0, 0, 0, 20, 250, 20, 0); wr_pd(1, 0, 0, 6600, -28, 8, 60, 1); ) :
  p == 7 ? ( wr_pg(1, 1, -48, 10, 2, 80, 250, 110, 20000, 3, 0); wr_ps(1, 10, 0, 20, 250, 20, 0); wr_pd(1, 0, 1, 7700, -26, 9, 70, 0); ) :
  p == 8 ? ( wr_pg(1, 1, -45, 15, 2, 100, 300, 110, 8800, 4, 0); wr_ps(0, 0, 0, 20, 250, 20, 0); wr_pd(1, 0, 0, 5500, -28, 10, 60, 1); slider30 = 2; ) :
  p == 9 ? ( wr_pg(0, 1, -50, 12, 2, 80, 250, 20, 20000, 4, 0); wr_ps(1, 20, -10, 15, 300, 110, 0); wr_pd(1, 0, 0, 4400, -24, 6, 90, 0); slider30 = 1; ) :
  p == 10 ? ( wr_pg(1, 1, -40, 18, 2, 60, 350, 110, 20000, 4, 0); wr_ps(1, 10, -50, 20, 300, 20, 0); wr_pd(0, 0, 0, 6600, -26, 10, 60, 0); ) :
  p == 11 ? ( wr_pg(1, 1, -50, 30, 3, 50, 200, 20, 2200, 4, 0); wr_ps(1, 15, 0, 25, 250, 20, 0); wr_pd(0, 0, 0, 6600, -26, 10, 60, 0); ) :
  p == 12 ? ( wr_pg(1, 0, -24, 80, 0.05, 250, 40, 110, 20000, 10, 1); wr_ps(1, 40, 60, 15, 600, 20, 1); wr_pd(0, 0, 0, 6600, -26, 10, 60, 0); ) :
  p == 13 ? ( wr_pg(0, 0, -60, 40, 0.5, 40, 150, 20, 20000, 4, 0); wr_ps(1, 35, -15, 18, 250, 88, 0); wr_pd(1, 1, 1, 8800, -24, 4, 60, 0); );
  slider_automate(8589934591);
);

function wr_srinit() (
  wr_sr = srate;
  wr_smc = 1 - exp(-1 / (0.03 * srate));
  wr_sw = 1 - exp(-1 / (0.012 * srate));
  wr_fk = exp(-16 / (0.03 * srate));
  wr_dks = 1 / (0.006 * srate);
  wr_fis = 1 / (0.01 * srate);
  wr_gdr = exp(-1 / (0.015 * srate));
  wr_cfa = wr_tc(0.0003); wr_cfr = wr_tc(0.03);
  wr_dat = wr_tc(0.0003); wr_fat = wr_tc(0.005); wr_frl = wr_tc(0.06);
  wr_dcr = 1 - 2 * $pi / srate;
  wr_setup(); wr_dfs = wr_dft; wr_tfs = wr_tft; wr_latch(); wr_kset(); wr_tset(); wr_clear();
  wr_lkh = wr_khf + wr_klf * 3;
);
wr_dgt = 0; wr_drl = 1; wr_dad = 1; wr_dsp = 1; wr_dln = 1; wr_ddt = 0; wr_dfd = 1;
dA.drift_init(0.8 + rand(1) * 0.5); dB.drift_init(0.8 + rand(1) * 0.5); dC.drift_init(0.8 + rand(1) * 0.5);
wr_oA = rand(2) - 1; wr_oB = rand(2) - 1;
wr_srinit();
wr_w = 0;
wr_gths = wr_gtht; wr_gis = wr_gon; wr_sis = wr_son; wr_dis = wr_don; wr_kys = wr_kyt;
wr_sats = wr_sat; wr_ssts = wr_sst; wr_dths = wr_dtht; wr_drgs = wr_drgt; wr_mix = wr_mixt; wr_out = wr_outt;
wr_dk = 1; wr_fi = 1; wr_sws = 0;
pdc_delay = wr_la; pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(1);
pwr_init(); pwr_wu_loss = 0.4; pwr_wu_drv = 0.5; pwr_wu_lp = 12000; pwr_wu_wob = 0.12; pwr_bloom = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(33, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); wr_setup();
      prs_q ? ( k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

function wr_latsnap() (
  wr_setup();
  wr_req != wr_cur ? ( wr_latch(); wr_sws = 0; wr_dk = 1; );
  pdc_delay = wr_la; pdc_bot_ch = 0; pdc_top_ch = 2;
);
wr_fresh = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
wr_fresh ? wr_latsnap() : wr_setup();
!wr_sws ? ( pdc_delay = wr_la; pdc_bot_ch = 0; pdc_top_ch = 2; );

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
ext_gr_meter = min(-(wr_ggm + wr_esm), 0);
prs_chk();
srate != wr_sr ? wr_srinit();
wr_fresh ? wr_latsnap();
wr_now = time_precise();
wr_tp > 0 && wr_now - wr_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > wr_gpp && play_position - wr_gpp < 4 * wr_gpd + 0.05) ? ( wr_clear(); wr_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
wr_tp = wr_now; wr_gpp = play_position; wr_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
drift_macro(slider33 >= 0.5 ? 50 : 5);
wr_inc = 0.05 * dm_s * samplesblock / srate;
wr_w1 = dA.drift_tick(wr_inc); wr_w2 = dB.drift_tick(wr_inc * 0.7); wr_w3 = dC.drift_tick(wr_inc * 1.3);
wr_dgt = dm_a * (0.5 * wr_w1 + 0.1 * wr_oA);
wr_drl = 1 + 0.06 * dm_a * wr_w2;
wr_dad = 1 + 0.04 * dm_a * wr_w3;
wr_dsp = 1 + dm_a * (0.05 * wr_w2 + 0.02 * wr_oB);
wr_dln = 1 + dm_a * (0.06 * wr_w3 + 0.03 * wr_oA);
wr_ddt = dm_a * (0.35 * wr_w3 + 0.15 * wr_oB);
wr_dfd = 2 ^ (dm_a * (0.025 * wr_w1 + 0.01 * wr_oB));
wr_setup();
wr_lkh2 = wr_khf + wr_klf * 3;
wr_lkh2 != wr_lkh ? ( wr_lkh = wr_lkh2; wr_kset(); );
wr_req != wr_cur ? wr_sws = 1;
!wr_sws ? ( pdc_delay = wr_la; pdc_bot_ch = 0; pdc_top_ch = 2; );
khL.bq_tidy(); khR.bq_tidy(); klL.bq_tidy(); klR.bq_tidy(); tfL.bq_tidy(); tfR.bq_tidy(); tsA.ts_tidy();
wr_genv < 0.0000000001 ? wr_genv = 0; abs(wr_denv) < 0.0000000001 ? wr_denv = 0;
wr_gg_d = max(wr_gg_d, wr_ggm); wr_ggm = 0;
abs(wr_shm) > abs(wr_sh_d) ? wr_sh_d = wr_shm; wr_shm = 0;
wr_es_d = max(wr_es_d, wr_esm); wr_esm = 0;
wr_pk_d = max(wr_pk_d, wr_pkm); wr_pkm = 0;
wr_op_d = max(wr_op_d, wr_opm); wr_opm = 0;
wr_fresh = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
wr_she = 0;
wr_dcy0 = spl0 - wr_dcx0 + wr_dcr * wr_dcy0; wr_dcx0 = spl0; wr_il = wr_dcy0;
wr_dcy1 = spl1 - wr_dcx1 + wr_dcr * wr_dcy1; wr_dcx1 = spl1; wr_ir = wr_dcy1;
wr_gths += (wr_gtht - wr_gths) * wr_smc;
wr_sats += (wr_sat - wr_sats) * wr_smc; wr_ssts += (wr_sst - wr_ssts) * wr_smc;
wr_dths += (wr_dtht - wr_dths) * wr_smc; abs(wr_dths - wr_dtht) < 0.00001 ? wr_dths = wr_dtht;
wr_drgs += (wr_drgt - wr_drgs) * wr_smc; abs(wr_drgs - wr_drgt) < 0.00001 ? wr_drgs = wr_drgt;
wr_mix += (wr_mixt - wr_mix) * wr_smc; abs(wr_mix - wr_mixt) < 0.0000001 ? wr_mix = wr_mixt;
wr_out += (wr_outt - wr_out) * wr_smc; abs(wr_out - wr_outt) < 0.0000001 ? wr_out = wr_outt;
wr_gis += (wr_gon - wr_gis) * wr_sw; wr_sis += (wr_son - wr_sis) * wr_sw; wr_dis += (wr_don - wr_dis) * wr_sw;
wr_kys += (wr_kyt - wr_kys) * wr_sw;
wr_sws ? ( wr_dk = max(wr_dk - wr_dks, 0); wr_dk == 0 ? ( wr_latch(); wr_sws = 0; pdc_delay = wr_la; ); ) : wr_dk < 1 ? wr_dk = min(wr_dk + wr_dks, 1);
wr_cc = (wr_cc + 1) & 15;
wr_cc == 0 ? (
  wr_dfs != wr_dft ? ( wr_dfs = wr_dft + (wr_dfs - wr_dft) * wr_fk; abs(wr_dfs - wr_dft) < 0.05 ? wr_dfs = wr_dft; wr_fset(); );
  wr_tfs != wr_tft ? ( wr_tfs = wr_tft + (wr_tfs - wr_tft) * wr_fk; abs(wr_tfs - wr_tft) < 0.05 ? wr_tfs = wr_tft; wr_tset(); );
);
pwr_in(wr_il, wr_ir); wr_il = pwr_l; wr_ir = pwr_r;

wr_kl = wr_il; wr_kr = wr_ir;
wr_khon ? ( wr_kl = khL.bq_run(wr_kl); wr_kr = khR.bq_run(wr_kr); );
wr_klon ? ( wr_kl = klL.bq_run(wr_kl); wr_kr = klR.bq_run(wr_kr); );
wr_kv = max(abs(wr_kl), abs(wr_kr));
wr_genv = wr_kv > wr_genv ? wr_kv : wr_genv * wr_gdr;
wr_gthr = wr_gths;
wr_gg = gG.gt_step(wr_g2db(wr_genv));
wr_glin = 1 + wr_gis * (wr_db2g(wr_gg) - 1);
wr_open = 1 - wr_gis * min(1, -wr_gg / max(wr_grng, 1));

WR_DL[wr_w] = wr_il; WR_DL[WR_N + wr_w] = wr_ir;
wr_rp = (wr_w - wr_la) & (WR_N - 1);
wr_xl = WR_DL[wr_rp]; wr_xr = WR_DL[WR_N + wr_rp];
wr_w = (wr_w + 1) & (WR_N - 1);
wr_l = wr_xl; wr_r = wr_xr;

wr_st = 0;
loop(3,
  wr_sg = wr_ord == 2 ? (wr_st == 0 ? 2 : wr_st == 1 ? 0 : 1) : wr_ord == 1 ? (wr_st == 0 ? 0 : wr_st == 1 ? 2 : 1) : wr_st;
  wr_sg == 0 ? (
    wr_l *= wr_glin; wr_r *= wr_glin;
