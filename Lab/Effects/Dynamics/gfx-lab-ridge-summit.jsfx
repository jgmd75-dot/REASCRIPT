rs_k3 = spl2 == spl2 ? spl2 : 0; rs_k4 = spl3 == spl3 ? spl3 : 0;
in_process(spl0, spl1);
pwr_in(in_l, in_r); rs_xl = pwr_l; rs_xr = pwr_r;
abs(rs_xl) < 0.000000000000001 ? rs_xl = 0; abs(rs_xr) < 0.000000000000001 ? rs_xr = 0;
wSb.tw_glide(c_sw); wGt.tw_glide(c_sw); wCp.tw_glide(c_sw); wLm.tw_glide(c_sw);
rs_dson += (rs_dsont - rs_dson) * c_sw; rs_gon += (rs_gont - rs_gon) * c_sw; rs_kx += (rs_kxt - rs_kx) * c_sw;
rs_fon += (rs_font - rs_fon) * c_sw; rs_con += (rs_cont - rs_con) * c_sw; rs_lon += (rs_lont - rs_lon) * c_sw;
