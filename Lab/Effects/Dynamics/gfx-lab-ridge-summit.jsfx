    rs_os(uxL.s3, uxR.s3, rs_gnl, rs_gnr); rs_a3 = rs_pl; rs_b3 = rs_pr;
    rs_yl = dnL.os_dn(rs_a0, rs_a1, rs_a2, rs_a3); rs_yr = dnR.os_dn(rs_b0, rs_b1, rs_b2, rs_b3);
  );
);
rs_gpl = rs_gnl; rs_gpr = rs_gnr;
rs_clw > 0.5 && rs_pkc > 0.9 ? rs_lpm |= 4;
rs_ndm < -1 ? rs_lpm |= 8;
rs_htm = max(rs_htm, rs_fa * (1 - min(rs_el * rs_cel, rs_er * rs_cer)));
rs_z = rs_yl - rs_dxl + rs_dcc * rs_dyl; rs_dxl = rs_yl; rs_dyl = rs_z; rs_yl = rs_z;
rs_z = rs_yr - rs_dxr + rs_dcc * rs_dyr; rs_dxr = rs_yr; rs_dyr = rs_z; rs_yr = rs_z;
pwr_out(rs_yl, rs_yr); rs_yl = pwr_l * rs_mks; rs_yr = pwr_r * rs_mks;
