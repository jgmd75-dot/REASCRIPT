  rs_con = rs_cont; rs_cth = rs_ctht; rs_csl = rs_cslt; rs_mkg = rs_mkt;
  rs_lon = rs_lont; rs_thp = rs_thpt; rs_thr = rs_thrt; rs_dvon = rs_dvont; rs_clw = rs_clwt; rs_lth = rs_ltht;
  rs_fa = rs_fat; rs_mks = rs_mkst; rs_lk = rs_lkt; rs_wd = rs_wdt; rs_mbon = rs_mbont; rs_mbk = rs_mbkt;
  rs_snap = 0;
);
ntM.c1 = rs_tn(ntM.c1); ntM.c2 = rs_tn(ntM.c2); ntS.c1 = rs_tn(ntS.c1); ntS.c2 = rs_tn(ntS.c2); ds_tn(); rs_dfe = rs_tn(rs_dfe);
kfL.s1 = rs_tn(kfL.s1); kfL.s2 = rs_tn(kfL.s2); kfR.s1 = rs_tn(kfR.s1); kfR.s2 = rs_tn(kfR.s2);
cpL.ms = rs_tn(cpL.ms); cpR.ms = rs_tn(cpR.ms);
spL.a = rs_tn(spL.a); spL.b = rs_tn(spL.b); spR.a = rs_tn(spR.a); spR.b = rs_tn(spR.b);
rs_msl = rs_tn(rs_msl); rs_msr = rs_tn(rs_msr); mbS.s1 = rs_tn(mbS.s1); mbS.s2 = rs_tn(mbS.s2);
rs_gg_d = min(rs_gg_d, rs_ggm); rs_gc_d = min(rs_gc_d, rs_gcm); rs_gl_d = min(rs_gl_d, rs_glm); rs_ggm = rs_gcm = rs_glm = 0;
rs_lp_d |= rs_lpm; rs_lpm = 0;
