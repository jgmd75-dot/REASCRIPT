rs_thp += (rs_thpt - rs_thp) * c_kn; rs_thr += (rs_thrt - rs_thr) * c_kn; rs_lth += (rs_ltht - rs_lth) * c_kn;
rs_fa += (rs_fat - rs_fa) * c_kn; rs_mks += (rs_mkst - rs_mks) * c_kn;
rs_wd += (rs_wdt - rs_wd) * c_kn; rs_mbon += (rs_mbont - rs_mbon) * c_sw; rs_mbk += (rs_mbkt - rs_mbk) * c_kn;
rs_gmx = min(rs_gmx + rs_mxs, 1);

rs_mm = 0.5 * (rs_xl + rs_xr); rs_ss = 0.5 * (rs_xl - rs_xr);
