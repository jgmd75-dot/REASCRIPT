@gfx 1400 632
ui_begin(1400, 632);
RGP = 0x1A2233; RGPS = 0x202A3F; RGPH = 0x0C111B; RGPW = 0x070A10; RGI = 0xEDE8DA; RGT = 0xF1E8D4; RGA = 0xF0A63A;
RGI2 = ui_mix(RGI, RGP, 0.36); RGT2 = ui_mix(RGT, RGPH, 0.40);
CGY = 0xC9CDD3; CLI = 0xC4B4E8; CMN = 0xA8DCC0; CBL = 0x9EC2E8; CCO = 0xF0A898; CCR = 0xEDE6CF; CPE = 0xF5C89A;

sc != rg_fsc ? (
  rg_fsc = sc;
  rg_f10 = ui_fitfont(10, 15 * sc);
  rg_f11 = ui_fitfont(11, 16 * sc);
  rg_f12 = ui_fitfont(12, 11.5 * sc);
  rg_f13 = ui_fitfont(13, 14 * sc);
  rg_f14 = ui_fitfont(14, 27 * sc);
);
gfx_setfont(10, "Trebuchet MS", rg_f10, 'b'); gfx_setfont(11, "Trebuchet MS", rg_f11, 'b');
gfx_setfont(12, "Trebuchet MS", rg_f12, 'b'); gfx_setfont(13, "Trebuchet MS", rg_f13, 'b');
gfx_setfont(14, "Trebuchet MS", rg_f14, 'b');

function rg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function rg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rg_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); rg_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function rg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function rg_plate(x, y, w, h) local(j, c, b) (
  b = 6; c = ui_mix(RGPS, 0xFFFFFF, 0.10);
  j = 0; loop(3, ui_cola(0x000000, 0.07); rg_r(x + 1 + j, y + 2 + j, w + j, h + j); j += 1; );
  ui_cola(0x000000, 0.30); rg_r(x + 1, y + h, w, 1); rg_r(x + w, y + 1, 1, h - 1);
  ui_cola(0x000000, 0.12); rg_r(x + 2, y + h + 1, w, 1); rg_r(x + w + 1, y + 2, 1, h - 1);
  ui_col(ui_mix(c, 0x000000, 0.55)); rg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.20)); rg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.10)); rg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); rg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.42)); rg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(RGPS); rg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(RGPH); rg_r(x + b, y + b, w - 2 * b, 38);
  ui_cola(RGA, 0.55); rg_r(x + b, y + b + 38, w - 2 * b, 1);
);
function rg_split(x, y, h) ( ui_col(RGPW); rg_r(x, y + 46, 1, h - 53); ui_cola(0xFFFFFF, 0.07); rg_r(x + 1, y + 46, 1, h - 53); );
function rg_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
function rg_hit(x, y, w, h) ( pressed && drag_id == 0 && mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function rg_key(x, y, w, h, lbl, on, col) ( lk_well = 0x0A0B0C; lk_font = 13; lk_font2 = 13; lk_fit(x, y, w, h, on, col, lbl); );
function rg_title(x, y, s, idx) local(cy) (
  cy = y + 26;
  idx > 0 ? (
    rg_key(x + 12, y + 12.5, 52, 27, "IN", slider(idx) >= 0.5, LK_AMB) ? rg_tog(idx);
    gfx_setfont(11); ui_col(RGT); rg_ltxt(x + 74, cy, s);
  ) : ( gfx_setfont(11); ui_col(RGT); rg_ltxt(x + 18, cy, s); );
);
function rg_tgt(xr, y, idx) local(i, x, v, on) (
  v = floor(slider(idx) + 0.5); i = 0; y += 9;
  loop(3,
    x = xr - 3 * 36 + 4 + i * 36; on = v == i;
    rg_hit(x, y + 6, 32, 22) ? ( slider(idx) = i; ui_auto(idx); drag_id = -1; );
    ui_col(0x050405); rg_r(x, y + 6, 32, 22);
    on ? ( ui_cola(0xFFF0C8, 0.18); rg_r(x - 2, y + 4, 36, 26); ui_col(0xEDE5CF); rg_r(x + 1, y + 7, 30, 20); ui_cola(0xFFFFFF, 0.5); rg_r(x + 1, y + 7, 30, 1); )
       : ( ui_col(0x26304A); rg_r(x + 1, y + 8, 30, 19); ui_cola(0x000000, 0.35); rg_r(x + 1, y + 8, 30, 1.5); );
    gfx_setfont(13); ui_col(on ? 0x2A2620 : RGI2); rg_ctxt(x + 16, y + 17.5 + (on ? 0 : 0.5), i == 0 ? "ST" : i == 1 ? "M" : "S");
    i += 1;
  );
);
rg_lg = 0; rg_step = 0;
function rg_kn(v, lo, hi) ( rg_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function rg_kv(n, lo, hi) ( rg_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
rg_wid = 0;
function rg_cap(cx, cy, r, a, act, cap, nd) local(i, t, x, y, rr, rd) (
  x = cx * sc; y = cy * sc; rr = r * sc; rd = rr + 8 * sc;
  ui_col(RGI2); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    (!rg_wid || (i & 1)) ? gfx_circle(x + sin(t) * rd, y - cos(t) * rd, (i == 0 || i == nd ? 1.9 : 1.5) * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.13); gfx_circle(x + (2 + i * 1.3) * sc, y + (3 + i * 1.6) * sc, rr + i * 0.6 * sc, 1, 1); i += 1; );
  ui_col(0x15181B); gfx_circle(x, y, rr, 1, 1);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C);
    ui_ssline(x + sin(t) * rr * 0.80, y - cos(t) * rr * 0.80, x + sin(t) * rr * 0.95, y - cos(t) * rr * 0.95, 1.1 * sc, 0); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.28 : 0.16); ui_ssarc(x, y, rr - 0.6 * sc, -2.2, 0.6, 1 * sc);
  ui_col(ui_mix(cap, 0x000000, 0.5)); gfx_circle(x, y, rr * 0.76, 1, 1);
  ui_col(cap); gfx_circle(x, y, rr * 0.72, 1, 1);
  i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(x, y, rr * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.40 : 0.26); ui_ssarc(x, y, rr * 0.62, -1.7, -0.3, 1 * sc);
  ui_col(0x1A1D22); ui_kdot(x, y, a, rr * 0.72);
);
function rg_knob(cx, cy, r, idx, lo, hi, def, cap, nd) local(v, n, dx, dy, hov, did, act) (
