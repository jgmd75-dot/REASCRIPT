desc:RIDGE SUMMIT [channel dynamics] (GFX Lab)
//tags: compressor limiter gate expander ducker de-esser sibilance fet mid side m/s sidechain key filter channel dynamics stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<0,1,1{Off,On}>-Sibilance
slider3:1<0,1,1{Low,High}>-Sibilance range
slider4:50<0,100,1>-Sens (%)
slider5:0<0,2,1{Stereo,Mid,Side}>-Sibilance works on
slider6:0<0,1,1{Off,On}>-Gate
slider7:1<0,2,1{Gate,Expand,Duck}>-Gate mode
slider8:-35<-40,20,0.1>-Gate threshold (dB)
slider9:12<0,60,0.1>-Gate range (dB)
slider10:0.3<0.02,5,0.001>-Gate release (s per 20 dB)
slider11:0<0,1,1{Self,Ext 3/4}>-Gate key
slider12:0<0,7,1{Off,110 Hz,220 Hz,550 Hz,1.1 kHz,2.2 kHz,5.5 kHz,9.9 kHz}>-Gate key filter
slider13:0<0,2,1{Stereo,Mid,Side}>-Gate works on
slider14:1<0,1,1{Off,On}>-Compressor
slider15:-6<-30,20,0.1>-Compressor threshold (dB)
slider16:3<1,20,0.01>-Ratio
slider17:10<0.2,200,0.01>-Attack (ms)
slider18:0.4<0.05,5,0.001>-Release (s per 20 dB)
slider19:0<0,1,1{Off,On}>-Auto timing
slider20:1<0,1,1{Off,On}>-Auto make-up
slider21:0<0,2,1{Stereo,Mid,Side}>-Compressor works on
slider22:1<0,1,1{Off,On}>-Limiter
slider23:-3<-24,0,0.1>-Limiter threshold (dBFS)
slider24:50<0,100,1>-Function (%)
slider25:0.3<0.05,5,0.001>-Limiter release (s)
slider26:3<0,7,1{Off,110 Hz,220 Hz,330 Hz,550 Hz,880 Hz,1.1 kHz,2.2 kHz}>-Divide
slider27:0<0,1,1{Off,On}>-Clip
slider28:0<0,2,1{Stereo,Mid,Side}>-Limiter works on
slider29:30<0,100,1>-Colour (%)
slider30:0<-20,20,0.1>-Output (dB)
slider31:1<0,1,1{Off,On}>-Link
slider32:50<0,100,1>-Drift (%)
slider33:0<0,2,1{1x,2x,4x}>-Oversampling
slider34:100<0,200,1>-Width (%)
slider35:0<0,6,1{Off,44 Hz,66 Hz,88 Hz,110 Hz,220 Hz,330 Hz}>-Mono below
slider36:prs_sel=0<0,10,1{No preset,Init,Vocal Chain,Drum Bus,Kick Gate,Bass Body,Bright Guitars,Mid Glue,Wide Gate Sides,Voice Over Duck,Warm FET}>-Preset

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-ridge-summit";
ext_noinit = 1;

function rs_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function rs_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function rs_db(d) ( exp(d * 0.11512925464970228); );
function rs_ldb(x) ( 20 * log10(max(x, 0.0000001)); );
function rs_div(i) ( i == 1 ? 110 : i == 2 ? 220 : i == 3 ? 330 : i == 4 ? 550 : i == 5 ? 880 : i == 6 ? 1100 : 2200; );
function rs_mbf(i) ( i == 1 ? 44 : i == 2 ? 66 : i == 3 ? 88 : i == 4 ? 110 : i == 5 ? 220 : 330; );
function rs_flt(i) ( i == 1 ? 110 : i == 2 ? 220 : i == 3 ? 550 : i == 4 ? 1100 : i == 5 ? 2200 : i == 6 ? 5500 : 9900; );

function tw_set(t) instance(at, mt, st) ( at = t < 0.5; mt = t >= 0.5 && t < 1.5; st = t >= 1.5; );
function tw_glide(k) instance(a, m, s, at, mt, st) ( a += k * (at - a); m += k * (mt - m); s += k * (st - s); );
function tw_snap() instance(a, m, s, at, mt, st) ( a = at; m = mt; s = st; );
function tw_det(l, r) instance(a, m, s) local(c) ( c = m * 0.5 * (l + r) + s * 0.5 * (l - r); rs_dl = a * l + c; rs_dr = a * r + c; );
function tw_app(l, r, gl, gr) instance(a, m, s) local(g, mm, ss) (
  g = 0.5 * (gl + gr); mm = 0.5 * (l + r); ss = 0.5 * (l - r);
  rs_yl = a * gl * l + m * (g * mm + ss) + s * (mm + g * ss);
  rs_yr = a * gr * r + m * (g * mm - ss) + s * (mm - g * ss);
);
function tw_eff(gl, gr) instance(a, m, s) local(g) ( g = 0.5 * (gl + gr); rs_el = a * gl + (m + s) * g; rs_er = a * gr + (m + s) * g; );

DSB = 6000000;
function ds_setup(m) local(i, f, lo, hi, g) (
  lo = m == 0 ? 2200 : 4400; hi = min(m == 0 ? 6600 : 11000, 0.42 * srate);
  i = 0;
  loop(8,
    f = lo * (hi / lo) ^ (i / 7); g = tan($pi * f / srate);
    DSB[i * 8 + 2] = g; DSB[i * 8 + 3] = 1 / 6; DSB[i * 8 + 5] = f;
    i += 1;
  );
  rs_dlo = lo; rs_dhi = hi;
);
function ds_run(x) local(i, b, hp, bp, v1, g, k, s1, s2) (
  i = 0;
  loop(8,
    b = DSB + i * 8; g = b[2]; k = b[3]; s1 = b[0]; s2 = b[1];
    hp = (x - (k + g) * s1 - s2) / (1 + k * g + g * g);
    v1 = g * hp; bp = v1 + s1; b[0] = bp + v1; s2 += 2 * g * bp; b[1] = s2;
    b[4] += rs_kde * (bp * bp - b[4]);
    i += 1;
  );
);
function ds_clr() local(i) ( i = 0; loop(8, DSB[i * 8] = DSB[i * 8 + 1] = DSB[i * 8 + 4] = 0; i += 1; ); );
function ds_tn() local(i) ( i = 0; loop(8, DSB[i * 8] = rs_tn(DSB[i * 8]); DSB[i * 8 + 1] = rs_tn(DSB[i * 8 + 1]); DSB[i * 8 + 4] = rs_tn(DSB[i * 8 + 4]); i += 1; ); );
function ds_tick() local(i, j, e, em, ea, eb, ec, p, r) (
  em = -1; j = 0; i = 0;
  loop(8, e = DSB[i * 8 + 4]; e > em ? ( em = e; j = i; ); i += 1; );
  r = em / max(rs_dfe, 0.000000000001);
  rs_ndt = 0;
  em > 0.000000001 && r > rs_drt ? (
    rs_ndt = -min((r - rs_drt) / rs_drt * 12, 18);
    ea = 10 * log10(max(DSB[max(j - 1, 0) * 8 + 4], 0.0000000000001));
    eb = 10 * log10(max(em, 0.0000000000001));
    ec = 10 * log10(max(DSB[min(j + 1, 7) * 8 + 4], 0.0000000000001));
    p = (j > 0 && j < 7) ? 0.5 * (ea - ec) / max(ea - 2 * eb + ec, 0.0001) : 0;
    p = min(max(p, -0.5), 0.5);
    rs_nft = log(DSB[j * 8 + 5]) / log(2) + p * log(rs_dhi / rs_dlo) / log(2) / 7;
  );
);
function nt_set() local(amp, g) (
  amp = exp(rs_nd * 0.05756462732485115); g = tan($pi * min(2 ^ rs_nf, 0.45 * srate) / srate);
  nt_k = 1 / (4 * amp); nt_a1 = 1 / (1 + g * (g + nt_k)); nt_a2 = g * nt_a1; nt_a3 = g * nt_a2; nt_m1 = nt_k * (amp * amp - 1);
);
function nt_run(v0) instance(c1, c2) local(v1, v2, v3) (
  v3 = v0 - c2; v1 = nt_a1 * c1 + nt_a2 * v3; v2 = c2 + nt_a2 * c1 + nt_a3 * v3;
  c1 = 2 * v1 - c1; c2 = 2 * v2 - c2;
  v0 + nt_m1 * v1;
);

function kf_run(x) instance(s1, s2) local(hp, bp, v1, g) (
  g = rs_fk; hp = (x - 1.4142 * s1 - g * s1 - s2) / (1 + 1.4142 * g + g * g);
  v1 = g * hp; bp = v1 + s1; s1 = bp + v1; s2 += 2 * g * bp;
  x + rs_fon * (1.4142 * bp - x);
);
function mb_run(x) instance(s1, s2) local(hp, bp, v1, g) (
  g = rs_mbk; hp = (x - 1.4142 * s1 - g * s1 - s2) / (1 + 1.4142 * g + g * g);
  v1 = g * hp; bp = v1 + s1; s1 = bp + v1; s2 += 2 * g * bp;
  hp;
);
function gt_lev(x) instance(ep) local(a) ( a = abs(x); ep = a > ep ? a : ep * rs_epd; rs_ldb(ep); );
function gt_et(md, lv) instance(gst) local(t) (
  md == 0 ? (
    lv >= rs_geth ? gst = 1 : lv < rs_geth - 3 ? gst = 0;
    t = gst ? 0 : min(-19 * (rs_geth - lv), 0);
  ) : md == 1 ? t = min(lv - rs_geth, 0)
    : t = min(-19 * (lv - rs_geth), 0);
  max(t, -rs_grng);
);
function gt_gain(lv) instance(ge) local(t, ka) (
  t = this.gt_et(rs_gmode, lv); rs_gmx < 1 ? t = rs_gmx * t + (1 - rs_gmx) * this.gt_et(rs_gmdp, lv);
  ka = rs_gmode == 0 ? rs_kag : rs_gmode == 2 ? rs_kad : rs_kae * (1 + min(max(ge - t, 0) * 0.15, 9));
  t < ge ? ge += min(ka, 1) * (t - ge) : ge = min(t, ge + rs_grel);
  ge;
);

function cp_lev(x) instance(ms, pk) (
  ms += rs_kat * (x * x - ms);
  pk = max(abs(x), pk * rs_pkd);
  10 * log10(max(ms, 0.00000000001)) + 3.0103;
);
function cp_gain(lv) instance(gc, gf, gs) local(ov, t) (
  ov = lv - rs_cth;
  t = ov <= -3 ? 0 : ov >= 3 ? -ov * rs_csl : -rs_csl * sqr(ov + 3) / 12;
  rs_aut > 0.5 ? (
    gf = t < gf ? t : min(t, gf + 3 * rs_crel);
    gs = t < gs ? gs + rs_kas * (t - gs) : min(t, gs + rs_crel / 3);
    gc = min(gf, gs);
  ) : (
    gc = t < gc ? t : min(t, gc + rs_crel);
    gf = gs = gc;
  );
  gc;
);

function dv_run(x, k) instance(a, b) ( a += k * (x - a); b += k * (a - b); );
function rs_gc(lv, th, sl, kw) local(ov, k2) (
  ov = lv - th; k2 = kw * 0.5;
  -(ov <= -k2 ? 0 : ov >= k2 ? ov * sl : sl * sqr(ov + k2) / (2 * kw));
);
function lm_det(pk, ms) instance(pf, ps, rr) local(tp, tr, k) (
  tp = rs_gc(20 * log10(max(pk, 0.0000001)), rs_thp, 0.98, 2);
  pf += (tp < pf ? 1 : rs_kpf) * (tp - pf);
  ps += (tp < ps ? rs_kph : rs_kpr) * (tp - ps);
  tr = rs_gc(10 * log10(max(ms, 0.00000000001)) + 3.0103, rs_thr, 0.975, 3);
  k = tr < rr ? rs_kra * (1 + min((rr - tr) * 0.25, 4.7)) : rs_krr;
  rr += min(k, 1) * (tr - rr);
  rs_pkg = min(pf, ps);
  max(min(rs_pkg, rr), -30);
);

function rs_clip(x) local(u, a) (
  u = x * rs_cci; a = abs(u);
  a > 0.9 ? ( a = 0.9 + 0.1 * (a - 0.9) / (0.1 + (a - 0.9)); u = sign(u) * min(a, 1); );
  rs_cc * u;
);
function rs_os(xl, xr, gl, gr) local(yl, yr) (
  wLm.tw_app(xl, xr, gl, gr); yl = rs_yl; yr = rs_yr;
  wLm.tw_eff(gl, gr);
  yl += rs_fa * (1 - rs_el * rs_cel) * yl * yl / (1 + abs(yl));
  yr += rs_fa * (1 - rs_er * rs_cer) * yr * yr / (1 + abs(yr));
  rs_pkc = max(rs_pkc, max(abs(yl), abs(yr)) * rs_cci);
  rs_pl = yl + rs_clw * (rs_clip(yl) - yl); rs_pr = yr + rs_clw * (rs_clip(yr) - yr);
);

function rs_clear() ( uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); );
function rs_reset() (
  rs_clear(); ds_clr(); memset(BY_BUF, 0, 2 * BY_N);
  ntM.c1 = ntM.c2 = ntS.c1 = ntS.c2 = 0; rs_dfe = 0;
  kfL.s1 = kfL.s2 = kfR.s1 = kfR.s2 = 0; gtL.ep = gtR.ep = gtL.ge = gtR.ge = 0; gtL.gst = gtR.gst = 1;
  cpL.ms = cpL.pk = cpL.gc = cpL.gf = cpL.gs = cpR.ms = cpR.pk = cpR.gc = cpR.gf = cpR.gs = 0;
  lmL.pf = lmL.ps = lmL.rr = lmR.pf = lmR.ps = lmR.rr = 0;
  spL.a = spL.b = spR.a = spR.b = 0; rs_msl = rs_msr = 0;
  rs_gpl = rs_gnl = rs_gpr = rs_gnr = 1;
  rs_dxl = rs_dyl = rs_dxr = rs_dyr = 0; mbS.s1 = mbS.s2 = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  rs_fi = 0;
);

#rs_pm = "Init|Vocal Chain|Drum Bus|Kick Gate|Bass Body|Bright Guitars|Mid Glue|Wide Gate Sides|Voice Over Duck|Warm FET";
function rs_sb(on, md, se, tg) ( slider2 = on; slider3 = md; slider4 = se; slider5 = tg; );
function rs_gt(on, md, th, rg, re, ky, fl, tg) ( slider6 = on; slider7 = md; slider8 = th; slider9 = rg; slider10 = re; slider11 = ky; slider12 = fl; slider13 = tg; );
function rs_cp(on, th, ra, at, re, au, mk, tg) ( slider14 = on; slider15 = th; slider16 = ra; slider17 = at; slider18 = re; slider19 = au; slider20 = mk; slider21 = tg; );
function rs_lm(on, th, fn, re, dv, cl, tg) ( slider22 = on; slider23 = th; slider24 = fn; slider25 = re; slider26 = dv; slider27 = cl; slider28 = tg; );
function rs_ou(co, ou) ( slider29 = co; slider30 = ou; slider31 = 1; slider34 = 100; slider35 = 0; );
function load_preset(p) local(i) (
  p == 1 || p == 11 ? (
    rs_sb(0, 1, 50, 0); rs_gt(0, 1, -35, 12, 0.3, 0, 0, 0); rs_cp(1,  -6, 3,   10, 0.4,  0, 1, 0); rs_lm(1, -3, 50, 0.3,  3, 0, 0); rs_ou(30, 0);
  ) : p == 2 ? (
    rs_sb(1, 0, 55, 0); rs_gt(1, 1, -38, 10, 0.4, 0, 0, 0); rs_cp(1, -12, 4,    8, 0.4,  1, 1, 0); rs_lm(1, -4, 60, 0.25, 4, 0, 0); rs_ou(25, 0);
  ) : p == 3 ? (
    rs_sb(0, 1, 50, 0); rs_gt(0, 1, -35, 12, 0.3, 0, 0, 0); rs_cp(1, -10, 4,   20, 0.15, 0, 1, 0); rs_lm(1, -2, 40, 0.1,  2, 1, 0); rs_ou(50, 0);
  ) : p == 4 ? (
    rs_sb(0, 1, 50, 0); rs_gt(1, 0, -14, 40, 0.12, 0, 1, 0); rs_cp(0, -6, 3,   10, 0.4,  0, 1, 0); rs_lm(1, -1,  0, 0.15, 0, 0, 0); rs_ou(15, 0);
  ) : p == 5 ? (
    rs_sb(0, 1, 50, 0); rs_gt(0, 1, -35, 12, 0.3, 0, 0, 0); rs_cp(1,  -8, 4,   15, 0.5,  0, 1, 0); rs_lm(1, -4, 80, 0.6,  2, 0, 0); rs_ou(45, 0);
  ) : p == 6 ? (
    rs_sb(1, 1, 40, 0); rs_gt(0, 1, -35, 12, 0.3, 0, 0, 0); rs_cp(1,  -8, 3,   12, 0.3,  1, 1, 0); rs_lm(1, -4, 70, 0.4,  6, 0, 0); rs_ou(30, 0);
  ) : p == 7 ? (
    rs_sb(0, 1, 50, 0); rs_gt(0, 1, -35, 12, 0.3, 0, 0, 0); rs_cp(1,  -8, 2.5, 30, 0.6,  0, 1, 1); rs_lm(1, -2, 30, 0.3,  3, 0, 0); rs_ou(20, 0);
  ) : p == 8 ? (
    rs_sb(0, 1, 50, 0); rs_gt(1, 0, -26, 18, 0.25, 0, 0, 2); rs_cp(1, -6, 2,   20, 0.5,  0, 1, 1); rs_lm(1, -2, 40, 0.3,  3, 0, 0); rs_ou(20, 0);
  ) : p == 9 ? (
    rs_sb(0, 1, 50, 0); rs_gt(1, 2, -14, 12, 0.8, 1, 0, 0); rs_cp(0, -6, 3,    10, 0.4,  0, 1, 0); rs_lm(1, -1,  0, 0.2,  0, 0, 0); rs_ou(15, 0);
  ) : p == 10 ? (
    rs_sb(0, 1, 50, 0); rs_gt(0, 1, -35, 12, 0.3, 0, 0, 0); rs_cp(1, -10, 3,   10, 0.5,  1, 1, 0); rs_lm(1, -6, 50, 0.5,  3, 0, 0); rs_ou(90, 0);
  );
  p == 11 ? slider32 = 50;
  i = 2; loop(30, ui_auto(i); i += 1; );
  ui_auto(34); ui_auto(35); p == 11 ? ui_auto(32);
  pr_cur = p == 11 ? 1 : p;
);

function rs_srinit() (
  rs_sr = srate;
  rs_kde = rs_tc(2);
  rs_nfk = 1 - exp(-16 / (0.005 * srate));
  rs_nda = 1 - exp(-16 / (0.001 * srate)); rs_ndr = 1 - exp(-16 / (0.04 * srate));
  rs_epd = exp(-1 / (0.005 * srate));
  rs_kag = rs_tc(0.02); rs_kad = rs_tc(10); rs_kae = rs_tc(10);
  rs_pkd = exp(-1 / (0.05 * srate)); rs_kas = rs_tc(80);
  rs_kpf = rs_tc(30); rs_kph = rs_tc(12); rs_kms = rs_tc(8); rs_kra = rs_tc(40);
  c_kn = rs_tc(30); c_lk = rs_tc(10); c_sw = rs_tc(15);
  rs_mxs = 1 / (0.015 * srate);
  rs_dcc = 1 - 2 * $pi * 5 / srate;
  rs_dsi = -1; rs_fli = -1; rs_dvi = -1; rs_fis = 1 / (0.01 * srate);
  rs_nf = 12; rs_nd = 0; nt_set();
  ost_init(0);
  rs_clear(); ds_clr();
);
os_design();
os_f = os_tf = os_f2n(slider33); os_base = 0;
rs_srinit();
os_gsetup();
in_init();
dSup.drift_init(0.8 + rand(1) * 0.4); dF.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
gtL.gst = gtR.gst = 1; rs_gmode = rs_gmdp = 1; rs_gmx = 1;
rs_gpl = rs_gnl = rs_gpr = rs_gnr = 1; rs_cel = rs_cer = 1;
rs_mbkt = tan($pi * 110 / srate); rs_snap = 1; rs_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_sag = 0.3;  pwr_wu_loss = 0.3;  pwr_wu_drv = 0.5;  pwr_wu_lp = 12000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(35, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != rs_sr ? rs_srinit();
rs_now = time_precise();
rs_tp > 0 && rs_now - rs_tp > max(0.25, 4 * samplesblock / srate) ? rs_reset();
rs_tp = rs_now;
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider33); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider32);
rs_n = samplesblock / srate;
rs_vv = dSup.drift_tick(0.04 * dm_s * rs_n); rs_vf = dF.drift_tick(0.03 * dm_s * rs_n);
rs_dr = 0.35 * dm_a * rs_vv;
wSb.tw_set(slider5); wGt.tw_set(slider13); wCp.tw_set(slider21); wLm.tw_set(slider28);
rs_dsn = slider3 >= 0.5;
rs_dsn != rs_dsi ? ( rs_dsi = rs_dsn; ds_setup(rs_dsn); );
rs_dsont = slider2 >= 0.5;
rs_drt = 0.5 - 0.4 * min(max(slider4, 0), 100) / 100;
rs_gont = slider6 >= 0.5;
rs_gmt = floor(min(max(slider7, 0), 2) + 0.5);
rs_gmt != rs_gmode ? ( rs_gmdp = rs_gmode; rs_gmode = rs_gmt; rs_gmx = 0; );
rs_getht = min(max(slider8, -40), 20) - 18 + rs_dr;
rs_grngt = min(max(slider9, 0), 60);
