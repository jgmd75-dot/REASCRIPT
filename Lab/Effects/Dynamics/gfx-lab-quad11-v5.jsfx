desc:Quad11 V5 [multiband comp] (GFX Lab)
//tags: multiband compressor bus eq saturation dynamics mastering
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider63:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-24,12,0.1>-Input trim (dB)
slider2:0<0,1,1{Off,On}>-Input guard
slider3:100<0,100,1>-Mix (%)
slider4:0<-24,12,0.1>-Output (dB)
slider5:0<0,100,1>-Output saturation (%)
slider6:1<0,2,1{1x,2x,4x}>-Oversampling
slider7:120<30,16000,1>-Crossover 1 (Hz)
slider8:1000<30,16000,1>-Crossover 2 (Hz)
slider9:5000<30,16000,1>-Crossover 3 (Hz)
slider10:20<20,500,1>-HPF (Hz, 20 = off)
slider11:100<30,500,1>-Low shelf freq (Hz)
slider12:0<-12,12,0.1>-Low shelf gain (dB)
slider13:8000<2000,16000,10>-High shelf freq (Hz)
slider14:0<-12,12,0.1>-High shelf gain (dB)
slider15:20000<2000,20000,10>-LPF (Hz, 20000 = off)
slider16:60<20,20000,1>-Low: EQ freq (Hz)
slider17:0.8<0.3,6,0.01>-Low: EQ width (Q)
slider18:0<-12,12,0.1>-Low: EQ gain (dB)
slider19:0<-48,48,0.1>-Low: threshold (dB; - compress / + expand)
slider20:2<1,20,0.1>-Low: ratio
slider21:40<0.1,100,0.1>-Low: attack (ms)
slider22:150<10,2000,1>-Low: release (ms)
slider23:0<0,2,1{Tape,Tube,Clip}>-Low: sat type
slider24:0<0,100,1>-Low: drive (%)
slider25:1<0,1,1{Pre,Post}>-Low: sat position
slider26:0<0,2,1{Active,Bypass,Solo}>-Low: state
slider27:400<20,20000,1>-Lo-mid: EQ freq (Hz)
slider28:0.8<0.3,6,0.01>-Lo-mid: EQ width (Q)
slider29:0<-12,12,0.1>-Lo-mid: EQ gain (dB)
slider30:0<-48,48,0.1>-Lo-mid: threshold (dB; - compress / + expand)
slider31:2<1,20,0.1>-Lo-mid: ratio
slider32:30<0.1,100,0.1>-Lo-mid: attack (ms)
slider33:120<10,2000,1>-Lo-mid: release (ms)
slider34:0<0,2,1{Tape,Tube,Clip}>-Lo-mid: sat type
slider35:0<0,100,1>-Lo-mid: drive (%)
slider36:1<0,1,1{Pre,Post}>-Lo-mid: sat position
slider37:0<0,2,1{Active,Bypass,Solo}>-Lo-mid: state
slider38:2500<20,20000,1>-Hi-mid: EQ freq (Hz)
slider39:0.8<0.3,6,0.01>-Hi-mid: EQ width (Q)
slider40:0<-12,12,0.1>-Hi-mid: EQ gain (dB)
slider41:0<-48,48,0.1>-Hi-mid: threshold (dB; - compress / + expand)
slider42:2<1,20,0.1>-Hi-mid: ratio
slider43:20<0.1,100,0.1>-Hi-mid: attack (ms)
slider44:90<10,2000,1>-Hi-mid: release (ms)
slider45:0<0,2,1{Tape,Tube,Clip}>-Hi-mid: sat type
slider46:0<0,100,1>-Hi-mid: drive (%)
slider47:1<0,1,1{Pre,Post}>-Hi-mid: sat position
slider48:0<0,2,1{Active,Bypass,Solo}>-Hi-mid: state
slider49:10000<20,20000,1>-High: EQ freq (Hz)
slider50:0.8<0.3,6,0.01>-High: EQ width (Q)
slider51:0<-12,12,0.1>-High: EQ gain (dB)
slider52:0<-48,48,0.1>-High: threshold (dB; - compress / + expand)
slider53:hi_rat=2<1,20,0.1>-High: ratio
slider54:hi_atk=10<0.1,100,0.1>-High: attack (ms)
slider55:hi_rel=60<10,2000,1>-High: release (ms)
slider56:hi_typ=0<0,2,1{Tape,Tube,Clip}>-High: sat type
slider57:hi_drv=0<0,100,1>-High: drive (%)
slider58:hi_pos=1<0,1,1{Pre,Post}>-High: sat position
slider59:hi_st=0<0,2,1{Active,Bypass,Solo}>-High: state
slider60:lk_on=1<0,1,1{Off,On}>-Link
slider61:q11_byp=0<0,1,1{Off,On}>-Bypass
slider62:prs_sel=0<0,11,1{No preset,Init,Gentle Glue,Mix Bus Punch,Drum Bus Smash (parallel),Transient Lift (expand),Vocal Control,Bass Tighten,De-Mud & Air,Tape Warmth,Master Gentle,Parallel Crush}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
ext_gr_meter = 0;
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(hi_rat, v); slider_show(hi_atk, v); slider_show(hi_rel, v); slider_show(hi_typ, v); slider_show(hi_drv, v); slider_show(hi_pos, v); slider_show(hi_st, v); slider_show(lk_on, v); slider_show(q11_byp, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(hi_rat, v); slider_show(hi_atk, v); slider_show(hi_rel, v); slider_show(hi_typ, v); slider_show(hi_drv, v); slider_show(hi_pos, v); slider_show(hi_st, v); slider_show(lk_on, v); slider_show(q11_byp, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-quad11-v5";
ext_noinit = 1;

function bq_set(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * q);
  amp = 10 ^ (gdb / 40);
  type == 0 ? (
    n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 1 ? (
    n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 2 ? (
    n = 1 + al / amp; b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = b1; a2 = (1 - al / amp) / n;
  ) : type == 3 ? (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n; b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n; a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;
    a2 = ((amp + 1) - (amp - 1) * cw - sa) / n;
  ) : type == 4 ? (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n; b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n; a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;
    a2 = ((amp + 1) + (amp - 1) * cw - sa) / n;
  ) : (
    n = 1 + al; b0 = (1 - al) / n; b1 = -2 * cw / n; b2 = 1; a1 = b1; a2 = b0;
  );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function bq_tidy() instance(x1, x2, y1, y2) (
  abs(y1) < 0.000000000000000000001 ? y1 = 0; abs(y2) < 0.000000000000000000001 ? y2 = 0;
  abs(x1) < 0.000000000000000000001 ? x1 = 0; abs(x2) < 0.000000000000000000001 ? x2 = 0;
);
function bq_mag(w) instance(b0, b1, b2, a1, a2) local(c1, c2, s1, s2, nr, ni, dr, di) (
  c1 = cos(w); c2 = cos(2 * w); s1 = sin(w); s2 = sin(2 * w);
  nr = b0 + b1 * c1 + b2 * c2; ni = b1 * s1 + b2 * s2;
  dr = 1 + a1 * c1 + a2 * c2;  di = a1 * s1 + a2 * s2;
  sqrt((nr * nr + ni * ni) / max(dr * dr + di * di, 0.000000000001));
);

function xo_set(f1, f2, f3) instance(la1, la2, ha1, ha2, lb1, lb2, hb1, hb2, lc1, lc2, hc1, hc2, ap1, ap3, d1, d2, d3) (
  la1.bq_set(0, f2, 0.70710678, 0, srate); la2.bq_set(0, f2, 0.70710678, 0, srate);
  ha1.bq_set(1, f2, 0.70710678, 0, srate); ha2.bq_set(1, f2, 0.70710678, 0, srate);
  lb1.bq_set(0, f1, 0.70710678, 0, srate); lb2.bq_set(0, f1, 0.70710678, 0, srate);
  hb1.bq_set(1, f1, 0.70710678, 0, srate); hb2.bq_set(1, f1, 0.70710678, 0, srate);
  lc1.bq_set(0, f3, 0.70710678, 0, srate); lc2.bq_set(0, f3, 0.70710678, 0, srate);
  hc1.bq_set(1, f3, 0.70710678, 0, srate); hc2.bq_set(1, f3, 0.70710678, 0, srate);
  ap1.bq_set(5, f1, 0.70710678, 0, srate); ap3.bq_set(5, f3, 0.70710678, 0, srate);
  d1.bq_set(5, f1, 0.70710678, 0, srate); d2.bq_set(5, f2, 0.70710678, 0, srate); d3.bq_set(5, f3, 0.70710678, 0, srate);
);
function xo_run(x, xd) instance(la1, la2, ha1, ha2, lb1, lb2, hb1, hb2, lc1, lc2, hc1, hc2, ap1, ap3, d1, d2, d3,
                           o1, o2, o3, o4, od) local(lo, hi) (
  lo = ap3.bq_run(la2.bq_run(la1.bq_run(x)));
  hi = ap1.bq_run(ha2.bq_run(ha1.bq_run(x)));
  o1 = lb2.bq_run(lb1.bq_run(lo)); o2 = hb2.bq_run(hb1.bq_run(lo));
  o3 = lc2.bq_run(lc1.bq_run(hi)); o4 = hc2.bq_run(hc1.bq_run(hi));
  od = d3.bq_run(d2.bq_run(d1.bq_run(xd)));
);
function xo_clr() instance(la1, la2, ha1, ha2, lb1, lb2, hb1, hb2, lc1, lc2, hc1, hc2, ap1, ap3, d1, d2, d3) (
  la1.bq_clr(); la2.bq_clr(); ha1.bq_clr(); ha2.bq_clr(); lb1.bq_clr(); lb2.bq_clr(); hb1.bq_clr(); hb2.bq_clr();
  lc1.bq_clr(); lc2.bq_clr(); hc1.bq_clr(); hc2.bq_clr(); ap1.bq_clr(); ap3.bq_clr(); d1.bq_clr(); d2.bq_clr(); d3.bq_clr();
);
function xo_tidy() instance(la1, la2, ha1, ha2, lb1, lb2, hb1, hb2, lc1, lc2, hc1, hc2, ap1, ap3, d1, d2, d3) (
  la1.bq_tidy(); la2.bq_tidy(); ha1.bq_tidy(); ha2.bq_tidy(); lb1.bq_tidy(); lb2.bq_tidy(); hb1.bq_tidy(); hb2.bq_tidy();
  lc1.bq_tidy(); lc2.bq_tidy(); hc1.bq_tidy(); hc2.bq_tidy(); ap1.bq_tidy(); ap3.bq_tidy(); d1.bq_tidy(); d2.bq_tidy(); d3.bq_tidy();
);

function meq_set(fh, fl, gl, fu, gu, fp) instance(hp, ls, hs, lp) (
  hp.bq_set(1, fh, 0.70710678, 0, srate);
  ls.bq_set(4, fl, 0.70710678, gl, srate);
  hs.bq_set(3, fu, 0.70710678, gu, srate);
  lp.bq_set(0, fp, 0.70710678, 0, srate);
);
function meq_run(x) instance(hp, ls, hs, lp) local(y) (
  y = hp.bq_run(x); x = meq_hp ? y : x;
  x = hs.bq_run(ls.bq_run(x));
  y = lp.bq_run(x); meq_lp ? y : x;
);
function meq_clr() instance(hp, ls, hs, lp) ( hp.bq_clr(); ls.bq_clr(); hs.bq_clr(); lp.bq_clr(); );
function meq_tidy() instance(hp, ls, hs, lp) ( hp.bq_tidy(); ls.bq_tidy(); hs.bq_tidy(); lp.bq_tidy(); );

function sat_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
TB15 = sat_th(0.15);
function sat_curve(u, t) local(a) (
  t == 0 ? sat_th(u + 0.15) - TB15 :
  t == 1 ? ( u >= 0 ? sat_th(u) : sat_th(1.6 * u) / 1.6 ) :
  ( a = abs(u); a < 0.8 ? u : sign(u) * (0.8 + 0.2 * sat_th((a - 0.8) / 0.2)) );
);
function sat_init(mem) instance(dcx, dcy, rb, w, run) ( dcx = 0; dcy = 0; rb = mem; memset(rb, 0, 64); w = 0; run = 0; );
function sat_mix(z, g, c, t, cw) ( cw <= 0 ? z : cw >= 1 ? sat_curve(g * z, t) * c : z + (sat_curve(g * z, t) * c - z) * cw; );
function sat_run(x, g, c, t, off) instance(dcx, dcy, cw, rb, w, run) local(i, z, p0, p1, p2, p3, y) (
  cw = off ? max(cw - sat_ws, 0) : min(cw + sat_ws, 1);
  os_f == 1 ? y = sat_mix(x, g, c, t, cw) : (
    w = (w + 1) & 63; rb[w] = x;
    off && cw <= 0 ? ( run = 0; y = rb[(w - os_lat(os_f)) & 63]; ) : (
      !run ? (
        run = 1; i = 40;
        loop(40, this.up.os_up(rb[(w - i) & 63]); this.dn.os_dn(this.up.s0, this.up.s1, this.up.s2, this.up.s3); i -= 1; );
      );
      this.up.os_up(x);
      i = 0;
      loop(os_f,
        z = sat_mix(this.up.os_s(i), g, c, t, cw);
        i == 0 ? p0 = z : i == 1 ? p1 = z : i == 2 ? p2 = z : p3 = z;
        i += 1;
      );
      y = this.dn.os_dn(p0, p1, p2, p3);
    );
  );
  cw <= 0 ? ( dcx = dcy = 0; y; ) : ( dcy = y - dcx + sat_dcr * dcy; dcx = y; cw >= 1 ? dcy : y + (dcy - y) * cw; );
);
function sat_clr() instance(run, rb, dcx, dcy) ( this.up.os_clr(); this.dn.os_clr(); run = 0; memset(rb, 0, 64); dcx = dcy = 0; );
function sat_snap(snon) instance(cw) ( cw = snon; );

function band_init(mem) instance(sL, sR, yL, yR, env, gr_d, amk, enva, envb, amka, amkb, dk, dks) (
  sL.sat_init(mem); sR.sat_init(mem + 64); yL.sat_init(mem + 128); yR.sat_init(mem + 192);
  env = 0; gr_d = 0; amk = 0; enva = envb = amka = amkb = 0; dk = 1; dks = 0;
);
function band_coef() instance(eqL, eqR, cf, cq, cg, cdr, st, sg, smk) (
  eqL.bq_set(2, cf, cq, cg, srate); eqR.bq_set(2, cf, cq, cg, srate);
  sg = 0.25 * 10 ^ (max(cdr, 0) * 0.3 / 20);
  smk = 0.5 / (sat_curve(sg * 0.25, st) - sat_curve(-sg * 0.25, st));
);
function band_set(base) instance(tf, tq, tg, tdr, thr, rat, atc, rlc, nst, npre, state, soff) (
  tf = slider(base); tq = slider(base + 1); tg = slider(base + 2);
  thr = slider(base + 3); rat = max(slider(base + 4), 1);
  atc = 1 - exp(-1 / (max(slider(base + 5), 0.05) * 0.001 * srate));
  rlc = 1 - exp(-1 / (max(slider(base + 6), 1) * 0.001 * srate));
  nst = slider(base + 7) | 0;
  tdr = slider(base + 8);
  npre = slider(base + 9) < 0.5;
  state = slider(base + 10) | 0;
  soff = tdr <= 0;
);
function band_snap() instance(sL, sR, tf, tq, tg, tdr, cf, cq, cg, cdr, st, nst, pre, npre, soff, bw, sw, state, dk, dks) (
  cf = tf; cq = tq; cg = tg; cdr = tdr; st = nst; pre = npre; dk = 1; dks = 0;
  bw = state == 1; sw = !any_solo || state == 2;
  sL.sat_snap(!soff); sR.sat_snap(!soff);
  this.band_coef();
);
function band_glide(kb) instance(tf, tq, tg, tdr, cf, cq, cg, cdr, st, nst, pre, npre, dks, sL, sR) local(mv) (
  mv = 0;
  cf != tf ? ( abs(log(tf / cf)) > 0.002 ? cf *= (tf / cf) ^ kb : cf = tf; mv = 1; );
  cq != tq ? ( abs(log(tq / cq)) > 0.002 ? cq *= (tq / cq) ^ kb : cq = tq; mv = 1; );
  cg != tg ? ( abs(tg - cg) > 0.01 ? cg += (tg - cg) * kb : cg = tg; mv = 1; );
  cdr != tdr ? ( abs(tdr - cdr) > 0.05 ? cdr += (tdr - cdr) * kb : cdr = tdr; mv = 1; );
  (nst != st || npre != pre) && dks == 0 ? (
    sL.cw <= 0 && sR.cw <= 0 && tdr <= 0 ? ( st = nst; pre = npre; mv = 1; ) : dks = -1;
  );
  mv ? this.band_coef();
);
function band_gr(lv) instance(thr, rat) local(over, gr) (
  over = lv - (thr < 0 ? thr : -thr);
  gr = over < -3 ? 0 : over > 3 ? (1 - 1 / rat) * over : (1 - 1 / rat) * (over + 3) * (over + 3) / 12;
  thr < 0 ? -gr : thr > 0 ? min(gr, 6) : 0;
);
function band_run(l, r) instance(eqL, eqR, sL, sR, yL, yR, thr, rat, atc, rlc, st, sg, smk, soff, pre, state,
                                env, gr_d, amk, ol, orr, enva, envb, amka, amkb, bw, sw, dk, dks, nst, npre) local(dl, dr, lv, gr, g, ga, gb, sk) (
  dl = yL.sat_run(l, 1, 1, 0, 1); dr = yR.sat_run(r, 1, 1, 0, 1);
  pre ? ( l = sL.sat_run(l, sg, smk, st, soff); r = sR.sat_run(r, sg, smk, st, soff); );
  l = eqL.bq_run(l); r = eqR.bq_run(r);
  lv = 20 * log10(max(max(abs(l), abs(r)), 0.000001));
  gr = this.band_gr(lv);
  env += (gr - env) * (abs(gr) > abs(env) ? atc : rlc);
  abs(env) > abs(gr_d) ? gr_d = env;
  amk += (env - amk) * amc;
  lk_u > 0 ? (
    gr = this.band_gr(20 * log10(max(abs(l), 0.000001)));
    enva += (gr - enva) * (abs(gr) > abs(enva) ? atc : rlc); amka += (enva - amka) * amc;
    gr = this.band_gr(20 * log10(max(abs(r), 0.000001)));
    envb += (gr - envb) * (abs(gr) > abs(envb) ? atc : rlc); amkb += (envb - amkb) * amc;
    abs(enva) > abs(gr_d) ? gr_d = enva; abs(envb) > abs(gr_d) ? gr_d = envb;
    g = env - 0.75 * amk;
    ga = g + (enva - 0.75 * amka - g) * lk_u; gb = g + (envb - 0.75 * amkb - g) * lk_u;
    q_gra = min(q_gra, min(enva, envb));
    l *= 10 ^ (ga / 20); r *= 10 ^ (gb / 20);
  ) : (
    enva = envb = env; amka = amkb = amk;
    g = 10 ^ ((env - 0.75 * amk) / 20);
    l *= g; r *= g;
  );
  q_gra = min(q_gra, env);
  !pre ? ( l = sL.sat_run(l, sg, smk, st, soff); r = sR.sat_run(r, sg, smk, st, soff); );
  dks != 0 ? (
    dk += dks * q_dkr;
    dk <= 0 ? ( dk = 0; st = nst; pre = npre; this.band_coef(); dks = 1; ) : dk >= 1 ? ( dk = 1; dks = 0; );
  );
  dk < 1 ? ( sk = dk * dk * (3 - 2 * dk); l *= sk; r *= sk; );
  bw += ((state == 1) - bw) * q_swc;
  sw += ((!any_solo || state == 2) - sw) * q_swc;
  ol = (l + (dl - l) * bw) * sw; orr = (r + (dr - r) * bw) * sw;
);
function band_clr() instance(eqL, eqR, sL, sR, yL, yR, env, amk, enva, envb, amka, amkb) (
  eqL.bq_clr(); eqR.bq_clr(); sL.sat_clr(); sR.sat_clr(); yL.sat_clr(); yR.sat_clr();
  env = amk = enva = envb = amka = amkb = 0;
);
function band_osclr() instance(sL, sR, yL, yR) ( sL.sat_clr(); sR.sat_clr(); yL.sat_clr(); yR.sat_clr(); );
function band_tidy() instance(eqL, eqR) ( eqL.bq_tidy(); eqR.bq_tidy(); );

function q_auto_au(i) ( slider_automate(2 ^ (i - 1)); );
function att_t_au(k, slow) ( slow ? (k == 0 ? 40 : k == 1 ? 30 : k == 2 ? 20 : 10) : (k == 0 ? 10 : k == 1 ? 6 : k == 2 ? 3 : 1) );
function rel_t_au(k, slow) ( slow ? (k == 0 ? 600 : k == 1 ? 450 : k == 2 ? 350 : 250) : (k == 0 ? 150 : k == 1 ? 120 : k == 2 ? 90 : 60) );
function pb(k, f, q, g, t, rt, ksa, ksr, ty, dr, ps) local(b) (
  b = 16 + k * 11;
  slider(b) = f; slider(b + 1) = q; slider(b + 2) = g; slider(b + 3) = t; slider(b + 4) = rt;
  slider(b + 5) = att_t_au(k, ksa); slider(b + 6) = rel_t_au(k, ksr);
  slider(b + 7) = ty; slider(b + 8) = dr; slider(b + 9) = ps; slider(b + 10) = 0;
);
function pm(x1, x2, x3, hp, lf, lg, hf, hg, lp, mx) (
  slider7 = x1; slider8 = x2; slider9 = x3;
  slider10 = hp; slider11 = lf; slider12 = lg; slider13 = hf; slider14 = hg; slider15 = lp; slider3 = mx;
);
function load_preset(p) local(i) (
  p == 1 ? (
    pm(120, 1000, 5000, 20, 100, 0, 8000, 0, 20000, 100);
    pb(0, 60, 0.8, 0, 0, 2, 1, 0, 0, 0, 1); pb(1, 400, 0.8, 0, 0, 2, 1, 0, 0, 0, 1);
    pb(2, 2500, 0.8, 0, 0, 2, 1, 0, 0, 0, 1); pb(3, 10000, 0.8, 0, 0, 2, 1, 0, 0, 0, 1);
    slider1 = 0; slider2 = 0; slider4 = 0; slider5 = 0; slider6 = 1; lk_on = 1;
  ) : p == 2 ? (
    pm(120, 1000, 5000, 20, 100, 0, 8000, 0, 20000, 100);
    pb(0, 60, 0.8, 0, -14, 1.5, 1, 1, 0, 0, 1); pb(1, 400, 0.8, 0, -14, 1.5, 1, 1, 0, 0, 1);
    pb(2, 2500, 0.8, 0, -14, 1.5, 1, 1, 0, 0, 1); pb(3, 10000, 0.8, 0, -14, 1.5, 1, 1, 0, 0, 1);
  ) : p == 3 ? (
    pm(120, 1000, 5000, 25, 100, 0, 8000, 0, 20000, 100);
    pb(0, 60, 0.8, 0, -18, 3, 1, 0, 0, 20, 1); pb(1, 400, 0.8, 0, -16, 2.5, 1, 0, 0, 0, 1);
    pb(2, 2500, 0.8, 0, -16, 2.5, 1, 0, 0, 0, 1); pb(3, 10000, 0.8, 0, -14, 2, 1, 0, 0, 0, 1);
  ) : p == 4 ? (
    pm(100, 800, 6000, 30, 80, 1.5, 10000, 1.5, 20000, 45);
    pb(0, 60, 0.8, 0, -30, 6, 0, 0, 0, 30, 1); pb(1, 400, 0.8, 0, -30, 6, 0, 0, 2, 20, 1);
    pb(2, 2500, 0.8, 0, -30, 6, 0, 0, 2, 20, 1); pb(3, 10000, 0.8, 0, -28, 5, 0, 0, 0, 10, 1);
  ) : p == 5 ? (
    pm(120, 1000, 5000, 20, 100, 0, 8000, 0, 20000, 100);
    pb(0, 60, 0.8, 0, 18, 2, 0, 0, 0, 0, 1); pb(1, 400, 0.8, 0, 14, 2, 0, 0, 0, 0, 1);
    pb(2, 2500, 0.8, 0, 18, 2, 0, 0, 0, 0, 1); pb(3, 10000, 0.8, 0, 12, 1.5, 0, 0, 0, 0, 1);
  ) : p == 6 ? (
    pm(200, 2000, 7000, 80, 200, 0, 10000, 1, 20000, 100);
    pb(0, 150, 0.8, -1, -20, 2, 1, 1, 0, 0, 1); pb(1, 450, 1.2, 0, -20, 3, 1, 0, 0, 0, 1);
    pb(2, 3500, 1.5, 0, -24, 4, 0, 0, 0, 0, 1); pb(3, 8000, 1, 0, -28, 6, 0, 0, 0, 0, 1);
  ) : p == 7 ? (
    pm(80, 250, 2000, 30, 60, 0, 8000, 0, 20000, 100);
    pb(0, 50, 0.8, 1, -20, 4, 1, 0, 1, 25, 0); pb(1, 160, 1, -1.5, -18, 3, 0, 0, 1, 15, 0);
    pb(2, 800, 0.8, 0, -16, 2, 0, 0, 0, 0, 1); pb(3, 4000, 0.8, 0, 0, 2, 0, 0, 0, 0, 1);
  ) : p == 8 ? (
    pm(150, 800, 6000, 25, 100, 0, 12000, 1.5, 20000, 100);
    pb(0, 80, 0.8, 0, -16, 2, 1, 1, 0, 0, 1); pb(1, 350, 1, -3, -18, 2, 1, 0, 0, 0, 1);
    pb(2, 2500, 0.8, 0, -16, 2, 1, 0, 0, 0, 1); pb(3, 12000, 0.7, 2, -20, 1.5, 0, 0, 0, 0, 1);
  ) : p == 9 ? (
    pm(120, 1000, 5000, 20, 100, 0, 8000, 0, 20000, 100);
    pb(0, 60, 0.8, 0, 0, 2, 1, 1, 0, 30, 1); pb(1, 400, 0.8, 0, 0, 2, 1, 1, 0, 20, 1);
    pb(2, 2500, 0.8, 0, 0, 2, 1, 1, 0, 15, 1); pb(3, 10000, 0.8, 0, 0, 2, 1, 1, 0, 10, 1);
  ) : p == 10 ? (
    pm(100, 900, 6000, 20, 100, 0, 8000, 0, 20000, 100);
    pb(0, 60, 0.8, 0, -10, 1.5, 1, 1, 0, 8, 1); pb(1, 400, 0.8, 0, -10, 1.4, 1, 1, 0, 0, 1);
    pb(2, 2500, 0.8, 0, -10, 1.4, 1, 1, 0, 0, 1); pb(3, 10000, 0.8, 0, -8, 1.3, 1, 1, 0, 0, 1);
  ) : p == 11 ? (
    pm(120, 1000, 5000, 20, 100, 0, 8000, 0, 20000, 35);
    pb(0, 60, 0.8, 0, -36, 10, 0, 0, 2, 40, 1); pb(1, 400, 0.8, 0, -36, 10, 0, 0, 2, 40, 1);
    pb(2, 2500, 0.8, 0, -36, 10, 0, 0, 2, 40, 1); pb(3, 10000, 0.8, 0, -36, 10, 0, 0, 2, 30, 1);
  );
  p >= 1 && p <= 11 ? ( i = 1; loop(60, q_auto_au(i); i += 1; ); );
);

function q_targets() (
  xt1 = min(max(slider7, 30), srate * 0.4);
  xt2 = min(max(slider8, xt1 * 1.25), srate * 0.42);
  xt3 = min(max(slider9, xt2 * 1.25), srate * 0.44);
  mt_h = max(slider10, 20); mt_ls = slider11; mt_lg = slider12; mt_hs = slider13; mt_hg = slider14; mt_p = slider15;
);
function q_coef() (
  xL.xo_set(xf1, xf2, xf3); xR.xo_set(xf1, xf2, xf3);
  meL.meq_set(mc_h, mc_ls, mc_lg, mc_hs, mc_hg, mc_p); meR.meq_set(mc_h, mc_ls, mc_lg, mc_hs, mc_hg, mc_p);
);
function q_gl(c, t, k) ( abs(log(t / c)) > 0.002 ? c * (t / c) ^ k : t; );
function q_glide(kb) local(mv) (
  mv = xf1 != xt1 || xf2 != xt2 || xf3 != xt3 || mc_h != mt_h || mc_ls != mt_ls || mc_lg != mt_lg || mc_hs != mt_hs || mc_hg != mt_hg || mc_p != mt_p;
  mv ? (
    xf1 = q_gl(xf1, xt1, kb); xf2 = q_gl(xf2, xt2, kb); xf3 = q_gl(xf3, xt3, kb);
    mc_h = q_gl(mc_h, mt_h, kb); mc_ls = q_gl(mc_ls, mt_ls, kb); mc_hs = q_gl(mc_hs, mt_hs, kb); mc_p = q_gl(mc_p, mt_p, kb);
    mc_lg = abs(mt_lg - mc_lg) > 0.01 ? mc_lg + (mt_lg - mc_lg) * kb : mt_lg;
    mc_hg = abs(mt_hg - mc_hg) > 0.01 ? mc_hg + (mt_hg - mc_hg) * kb : mt_hg;
    q_coef();
  );
  bnd0.band_glide(kb); bnd1.band_glide(kb); bnd2.band_glide(kb); bnd3.band_glide(kb);
);
function update() (
  q_targets();
  meq_hp = slider10 > 20.5; meq_lp = slider15 < 19990;
  bnd0.band_set(16); bnd1.band_set(27); bnd2.band_set(38); bnd3.band_set(49);
  os_tf = os_f2n(slider6);
  any_solo = bnd0.state == 2 || bnd1.state == 2 || bnd2.state == 2 || bnd3.state == 2;
  mix_t = any_solo ? 1 : slider3 / 100;
  out_t = 10 ^ (slider4 / 20);
  lk_t = lk_on >= 0.5;
  in_setup(slider1, slider2);
  ost_setup(slider5 / 100, 0.3, 120, 6000, -0.3, 0);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_base + os_lat(os_f);
);
function q_snap() (
  xf1 = xt1; xf2 = xt2; xf3 = xt3;
  mc_h = mt_h; mc_ls = mt_ls; mc_lg = mt_lg; mc_hs = mt_hs; mc_hg = mt_hg; mc_p = mt_p;
  q_coef();
  bnd0.band_snap(); bnd1.band_snap(); bnd2.band_snap(); bnd3.band_snap();
);
function q_clear() (
  xL.xo_clr(); xR.xo_clr(); meL.meq_clr(); meR.meq_clr();
  bnd0.band_clr(); bnd1.band_clr(); bnd2.band_clr(); bnd3.band_clr();
  dsL.sat_clr(); dsR.sat_clr(); ostL.ost_ch_init(); ostR.ost_ch_init();
);
function q_srinit() (
  q_sr = srate;
  sm = 1 - exp(-1 / (0.03 * srate));
  amc = 1 - exp(-1 / (1.5 * srate));
  lk_c = 1 - exp(-1 / (0.01 * srate));
  q_swc = 1 - exp(-1 / (0.01 * srate));
  q_dkr = 1 / (0.005 * srate);
  sat_ws = 1 / (0.01 * srate);
  rs_c = 1 / (0.015 * srate);
);

in_init();
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
os_design(); os_base = 0; os_f = os_tf = os_f2n(slider6); os_gsetup();
sat_dcr = 1 - 0.0005 / os_f;
SRB = 600000;
bnd0.band_init(SRB); bnd1.band_init(SRB + 256); bnd2.band_init(SRB + 512); bnd3.band_init(SRB + 768);
dsL.sat_init(SRB + 1024); dsR.sat_init(SRB + 1088);
q_srinit();
pkIL_d = 0; pkIR_d = 0; pkOL_d = 0; pkOR_d = 0;
update();
q_snap();
mix_s = mix_t; out_s = out_t; lk_s = lk_t; lk_u = 1 - lk_s;
QS = 700000; memset(QS, 0, 64);
by_setup(61);
q_gra = 0; rs_f = 1;
ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function q_changed() local(i, c) (
  c = srate != q_sr; i = 1;
  loop(61, slider(i) != QS[i] ? ( c = 1; QS[i] = slider(i); ); i += 1; );
  c;
);

function prs_sl() ( update(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(61, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 || !prs_run ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      !prs_run ? q_snap();
      prs_q ? ( k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = prs_run ? 1 / (0.030 * srate) : 0;
      !prs_run ? prs_g = 1;
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0; prs_run = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();
!prs_run ? q_snap();
os_snap(slider6);

@block
ext_gr_meter = min(q_gra, 0); q_gra = 0;
prs_chk();
srate != q_sr ? q_srinit();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; q_clear(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
q_changed() ? update();
q_glide(1 - exp(-samplesblock / (0.03 * srate)));
xL.xo_tidy(); xR.xo_tidy(); meL.meq_tidy(); meR.meq_tidy();
bnd0.band_tidy(); bnd1.band_tidy(); bnd2.band_tidy(); bnd3.band_tidy();
os_snapb(slider6);
prs_run = 1;

@serialize
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
os_gate();
os_chg ? (
  bnd0.band_osclr(); bnd1.band_osclr(); bnd2.band_osclr(); bnd3.band_osclr(); dsL.sat_clr(); dsR.sat_clr();
  sat_dcr = 1 - 0.0005 / os_f;
);
in_process(spl0, spl1);
pkIL_d = max(pkIL_d, abs(in_l)); pkIR_d = max(pkIR_d, abs(in_r));
l = in_l; r = in_r;
l = meL.meq_run(l); r = meR.meq_run(r);
xL.xo_run(l, in_l); xR.xo_run(r, in_r);
lk_s += (lk_t - lk_s) * lk_c; lk_s > 0.9999 && lk_t ? lk_s = 1; lk_s < 0.0001 && !lk_t ? lk_s = 0;
lk_u = 1 - lk_s;

bnd0.band_run(xL.o1, xR.o1); bnd1.band_run(xL.o2, xR.o2);
bnd2.band_run(xL.o3, xR.o3); bnd3.band_run(xL.o4, xR.o4);
wl = bnd0.ol + bnd1.ol + bnd2.ol + bnd3.ol;
wr = bnd0.orr + bnd1.orr + bnd2.orr + bnd3.orr;

dl = dsL.sat_run(xL.od, 1, 1, 0, 1); dr = dsR.sat_run(xR.od, 1, 1, 0, 1);
mix_s += (mix_t - mix_s) * sm;
out_s += (out_t - out_s) * sm;
q_ol = (dl + (wl - dl) * mix_s) * out_s;
q_or = (dr + (wr - dr) * mix_s) * out_s;
q_ol = ostL.ost_band(q_ol); q_or = ostR.ost_band(q_or);
ost_out(q_ol, q_or);
spl0 = ost_l * os_g;
spl1 = ost_r * os_g;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  os_f == 1 ? ( spl0 = by_il + (spl0 - by_il) * rs_s; spl1 = by_ir + (spl1 - by_ir) * rs_s; ) : ( spl0 *= rs_s; spl1 *= rs_s; );
);
by_out();
pkOL_d = max(pkOL_d, abs(spl0)); pkOR_d = max(pkOR_d, abs(spl1));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );

@gfx 900 355
ui_begin(900, 355);
v5_begin();
v5p_use(1); v5p_bg = 0x2A1E18; v5p_pk = 0x382820; v5p_cap = 0xE0D0B8; v5p_c2 = 0x6A4A30; v5p_c3 = 0x8A3A30; v5p_acc = 0xE89A3C; v5p_dim = 0x3E2C20; v5p_ink = 0xE2D6C6;
QBG = v5p_bg; QPK = v5p_pk; QINK = v5p_ink; QACC = v5p_acc;
QBAR = ui_mix(v5p_dim, 0x101414, 0.55);
QKEY = ui_mix(QBAR, 0, 0.30); QKEYH = ui_mix(QBAR, 0, 0.12);
QDIM = ui_mix(QINK, QPK, 0.42); QHV = 0xF2D4A0; QHP = 0x141A18;
QB0 = 0xA8743E; QB1 = 0x4A86C8; QB2 = 0x4E9E62; QB3 = 0xC8584A;
QHPF = 0xE8C430; QLPF = 0x202426;
v5_ink = ui_mix(QINK, QPK, 0.25); v5_led = 0xFFB030;
sc != q_fsc ? (
  q_fsc = sc;
  q_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  q_f6 = ui_fitfont(6, 26 * sc);
);
function q_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * q_kt * sc, 'b'); );
function q_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function q_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function q_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function q_bc(k) ( k == 0 ? QB0 : k == 1 ? QB1 : k == 2 ? QB2 : QB3; );
function q_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function q_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x7A8478); v5_d(x, y, 4); ui_col(0xC8D0C0); v5_d(x - 0.8, y - 0.8, 2.4); );
function q_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.22); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.42)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.30)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.10)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.20)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(face); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function q_plate(x, y, w, h, ttl, rc) (
  q_cham(x, y, w, h, 3, QBG, QPK);
  q_ft(18); ui_col(QINK); q_tl(x + 16, y + 21, ttl);
  ui_col(rc); v5_r(x + 16, y + 33, q_tw(ttl), 3);
);
function q_sub(x, y, w, ttl, c) (
  q_ft(13); ui_col(QINK); q_tl(x, y, ttl);
  ui_col(c); v5_r(x, y + 9, w, 2);
);
function q_well(x, y, w, h) local(j) (
  ui_cola(0xFFFFFF, 0.25); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h + 1);
  ui_col(v5p_well); v5_rr(x, y, w, h, 3);
  j = 0; loop(4, ui_cola(0, 0.18 - j * 0.04); v5_r(x + 1, y + 1 + j, w - 2, 1); v5_r(x + 1 + j, y + 2 + j, 1, h - 3 - j); j += 1; );
);
function q_fmt(dst, f) ( f >= 1000 ? sprintf(dst, "%.2f kHz", f / 1000) : sprintf(dst, "%.0f Hz", f); );
function q_val(idx) local(v, b, o) (
  v = slider(idx);
  idx == 1 || idx == 4 ? sprintf(#q_vs, "%+.1f dB", v) :
  idx == 3 || idx == 5 ? sprintf(#q_vs, "%.0f %%", v) :
  idx == 10 ? ( v <= 20.5 ? strcpy(#q_vs, "OFF") : q_fmt(#q_vs, v) ) :
  idx == 15 ? ( v >= 19990 ? strcpy(#q_vs, "OFF") : q_fmt(#q_vs, v) ) :
  idx == 12 || idx == 14 ? sprintf(#q_vs, "%+.1f dB", v) :
  idx == 11 || idx == 13 ? q_fmt(#q_vs, v) : (
    b = 16 + floor((idx - 16) / 11) * 11; o = idx - b;
    o == 0 ? q_fmt(#q_vs, v) :
    o == 1 ? sprintf(#q_vs, "Q %.2f", v) :
    o == 2 ? sprintf(#q_vs, "%+.1f dB", v) :
