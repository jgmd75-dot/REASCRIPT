      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi;
      strlen(#dv_sl) ? dv_ctxt(cx + sin(a) * (r + nr), cy - cos(a) * (r + nr), #dv_sl);
      i += 1; k0 = k + 1;
    );
