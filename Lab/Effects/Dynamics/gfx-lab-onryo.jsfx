    ui_ssline(x + sin(t) * rr * 0.74, y - cos(t) * rr * 0.74, x + sin(t) * rr * 0.95, y - cos(t) * rr * 0.95, 1.1 * sc, 0); i += 1; );
  i = 0; loop(5, ui_cola(0x000000, 0.14 * (1 - i / 5)); gfx_circle(x, y, rr - i * 0.8 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.22 : 0.14); ui_ssarc(x, y, rr * 0.97, -1.9, -0.1, 1 * sc);
  ui_col(ui_mix(cap, 0x000000, 0.45)); gfx_circle(x, y, rr * 0.66, 1, 1);
  ui_col(cap); gfx_circle(x, y, rr * 0.62, 1, 1);
  i = 0; loop(4, ui_cola(0x000000, 0.06 * (1 - i / 4)); gfx_circle(x, y, rr * 0.62 - i * 0.8 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.34 : 0.24); ui_ssarc(x, y, rr * 0.55, -1.7, -0.25, 1 * sc);
  ui_col(((cap >> 16) & 255) * 0.3 + ((cap >> 8) & 255) * 0.59 + (cap & 255) * 0.11 > 165 ? 0x1A1A18 : 0xF7F5EE);
  ui_kdot(x, y, a, rr * 0.62);
);
function dv_knob(cx, cy, r, idx, lo, hi, def, cap, nd) local(v, n, dx, dy, hov, did, act) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - dv_lt < 0.35 && dv_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; dv_lt = 0; ) : (
      drag_id = did; dv_my = mouse_y; dv_dz = 0; dv_lt = time_precise(); dv_lid = idx; dv_n = dv_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    dv_dz += abs(dv_my - mouse_y);
    dv_dz > 3 * sc ? (
      dv_n = min(max(dv_n + (dv_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = dv_kv(dv_n, lo, hi);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    dv_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(dv_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    slider(idx) = dv_kv(n, lo, hi);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(dv_kn(v, lo, hi), 0), 1);
  act = hov || drag_id == did;
  dv_cap(cx, cy, r, -0.75 * $pi + n * 1.5 * $pi, act, cap, nd);
  act;
);
function dv_name(cx, cy, r, act, name, val) ( gfx_setfont(10); ui_col(act ? DVA : DVI); dv_ctxt(cx, cy + r + 19, act ? val : name); );
function dv_scale(cx, cy, r, n, nr, labels) local(i, k, k0, len, c, a) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  gfx_setfont(12); ui_col(DVI2);
