desc:Onryō [compressor] (GFX Lab)
//tags: compressor limiter distortion saturation nuke opto parallel crush drums vocals bass stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-sliders

slider17:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:6<-10,30,0.1>-Input (dB)
slider3:5<-30,10,0.1>-Output (dB)
slider4:5<0,10,0.01>-Attack (0 - 10)
slider5:5<0,10,0.01>-Release (0 - 10)
slider6:3<0,7,1{1.5:1,2:1,3:1,4:1,6:1,10:1 Opto,20:1,Nuke}>-Ratio
slider7:0<0,2,1{Clean,Dist 2,Dist 3}>-Audio
slider8:0<0,1,1{Off,On}>-Brit
slider9:0<0,1,1{Off,On}>-Detector HP
slider10:0<0,1,1{Off,On}>-Band emphasis
slider11:1<0,1,1{Off,On}>-Link
slider12:0<0,100,1>-Crush (%)
slider13:100<0,100,1>-Mix (%)
slider14:50<0,100,1>-Drift (%)
slider15:0<0,2,1{1x,2x,4x}>-Oversampling
slider16:prs_sel=0<0,10,1{No preset,Init,Vocal Opto,Room Nuke,Bass Dist 3,Snare Brit,Mix Bus Glue,Parallel Crush,De-harsh Vocal,Fast Peaks,Gentle Acoustic}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(131071, v); );
function psw_allg(v) ( slider_show(131071, v); );
#ui_man = "gfx-lab-onryo";
ext_noinit = 1;

function du_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function du_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function du_db(d) ( exp(d * 0.11512925464970228); );
function du_slope(i) ( i == 0 ? 0.3333 : i == 1 ? 0.5 : i == 2 ? 0.6667 : i == 3 ? 0.75 : i == 4 ? 0.8333 : i == 5 ? 0.9 : i == 6 ? 0.95 : 1; );
function du_knee(i) ( i == 0 ? 18 : i == 1 ? 15 : i == 2 ? 10 : i == 3 ? 8 : i == 4 ? 6 : i == 5 ? 7 : i == 6 ? 2 : 0; );
function du_att(k) ( 0.05 * 600 ^ (min(max(k, 0), 10) / 10); );
function du_rel(k) ( 50 * 60 ^ (min(max(k, 0), 10) / 10); );

function bq_hp(f) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_pk(f, q, g) instance(b0, b1, b2, a1, a2) local(w, cw, al, aa, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); aa = 10 ^ (g / 40); n = 1 + al / aa;
  b0 = (1 + al * aa) / n; b1 = -2 * cw / n; b2 = (1 - al * aa) / n; a1 = b1; a2 = (1 - al / aa) / n;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, s1, s2) local(y) ( y = b0 * x + s1; s1 = b1 * x - a1 * y + s2; s2 = b2 * x - a2 * y; y; );

function du_gc(lv) local(ov, k2) (
  ov = lv - du_th; k2 = du_kw * 0.5;
  ov <= -k2 ? 0 : ov >= k2 ? ov * du_sl : du_sl * sqr(ov + k2) / (2 * max(du_kw, 0.0001));
);
function du_env(t) instance(g, gs) local(kr) (
  kr = du_kr * (1 + (2.5 * du_wn + 1.5 * du_wb) * min(g / 12, 1));
  g += (t > g ? du_ka : min(kr, 0.5)) * (t - g);
  gs += (g > gs ? du_kos : du_kor) * (g - gs);
  max(g, du_wo * 0.85 * gs);
);
function du_cenv(t) instance(g) ( g += (t > g ? du_kca : du_kcr) * (t - g); g; );

function du_d2(z) local(u, v) (
  u = 1.6 * du_hd * z; v = u + 0.15 * u * u / (1 + 0.2 * u * u); v = v / sqrt(1 + 0.08 * v * v);
  v / (1.6 * du_hd);
);
function du_d3(z, gd) local(u) ( u = gd * du_hd * z; u / sqrt(1 + u * u) / (gd * du_hd); );

function du_os(xl, xr, gl, gr, cl, cr) local(a, b, wa, wb, ca, cb) (
  a = xl * du_ig * gl; b = xr * du_ig * gr;
  du_zl = a; du_zr = b;
  wa = a + du_w2 * (du_d2(a) - a) + du_w3 * (du_d3(a, 2.4) - a) + du_bb * a * a;
  wb = b + du_w2 * (du_d2(b) - b) + du_w3 * (du_d3(b, 2.4) - b) + du_bb * b * b;
  du_cw > 0.0001 ? (
    ca = du_d3(xl * du_ig * cl * 5.0119, 2.2); cb = du_d3(xr * du_ig * cr * 5.0119, 2.2);
    wa += du_cw * ca; wb += du_cw * cb;
  );
  du_pl = xl + du_mx * (wa * du_mk - xl); du_pr = xr + du_mx * (wb * du_mk - xr);
);
function du_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
);

function du_reset() (
  du_clear(); memset(BY_BUF, 0, 2 * BY_N);
  eL.g = eL.gs = eR.g = eR.gs = crL.g = crR.g = 0;
  du_gpl = du_gpr = du_cpl = du_cpr = 1;
  hL.s1 = hL.s2 = hR.s1 = hR.s2 = pL.s1 = pL.s2 = pR.s1 = pR.s2 = 0;
  du_dxl = du_dyl = du_dxr = du_dyr = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  du_fi = 0;
);

#du_pm = "Init|Vocal Opto|Room Nuke|Bass Dist 3|Snare Brit|Mix Bus Glue|Parallel Crush|De-harsh Vocal|Fast Peaks|Gentle Acoustic";
function du_set(ii, oo, at, re, ra, au, br, hp, bd, cr, mx) (
  slider2 = ii; slider3 = oo; slider4 = at; slider5 = re; slider6 = ra; slider7 = au; slider8 = br;
  slider9 = hp; slider10 = bd; slider11 = 1; slider12 = cr; slider13 = mx;
);
function load_preset(p) local(i) (
  p == 1 ? du_set(    6,    5,    5,   5,    3,    0,    0,   0,  0,    0, 100) :
  p == 2 ? du_set(    8,  3.5,    4,   6,    5,    1,    0,   1,  0,    0, 100) :
  p == 3 ? du_set(   14,  6.5,    1,   2,    7,    2,    0,   1,  0,    0, 100) :
  p == 4 ? du_set(   10,    6,    3,   4,    4,    2,    0,   0,  0,    0, 100) :
  p == 5 ? du_set(   10,    7,    2,   3,    3,    1,    1,   0,  0,    0, 100) :
  p == 6 ? du_set(    4,    1,    7,   6,    1,    1,    0,   1,  0,    0, 100) :
  p == 7 ? du_set(    6, -0.5,    6,   4,    2,    1,    0,   1,  0,   50, 100) :
  p == 8 ? du_set(    6,    4,    3,   5,    2,    0,    0,   1,  1,    0, 100) :
  p == 9 ? du_set(   10,    6,    1,   3,    4,    0,    0,   0,  0,    0, 100) :
  p == 10 ? du_set(    4,  1.5,    6,   7,    1,    1,    0,   1,  0,    0, 100) :
  p == 11 ? ( du_set(6, 5, 5, 5, 3, 0, 0, 0, 0, 0, 100); slider14 = 50; );
  i = 2; loop(13, ui_auto(i); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function du_srinit() (
  du_sr = srate;
  c_kn = du_tc(30); c_lk = du_tc(10); c_sw = du_tc(15);
  du_kos = du_tc(400); du_kor = du_tc(2500);
  du_kca = du_tc(0.1);
  du_dcc = 1 - 2 * $pi * 5 / srate;
  hL.bq_hp(110); hR.bq_hp(110); pL.bq_pk(6600, 0.9, 8); pR.bq_pk(6600, 0.9, 8);
  du_fis = 1 / (0.01 * srate);
  ost_init(0);
  du_clear();
);
os_design();
os_f = os_tf = os_f2n(slider15); os_base = 0;
du_srinit();
os_gsetup();
in_init();
dV.drift_init(0.8 + rand(1) * 0.4); dT.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
du_snap = 1; du_fi = 1; du_gpl = du_gpr = du_cpl = du_cpr = 1;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_hum_db = -94;  pwr_sag = 0.3;  pwr_wu_loss = 0.4;  pwr_wu_drv = 0.8;  pwr_wu_lp = 11000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(16, i != 16 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(15));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != du_sr ? du_srinit();
du_now = time_precise();
du_tp > 0 && du_now - du_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > du_gpp && play_position - du_gpp < 4 * du_gpd + 0.05) ? du_reset();
du_tp = du_now; du_gpp = play_position; du_gpd = samplesblock / srate;
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider15); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider14);
du_n = samplesblock / srate;
du_vv = dV.drift_tick(0.03 * dm_s * du_n); du_vt = dT.drift_tick(0.05 * dm_s * du_n);
du_ri = floor(min(max(slider6, 0), 7) + 0.5);
du_bt = slider8 >= 0.5;
du_slt = du_slope(du_ri); du_kwt = du_knee(du_ri);
du_bt ? ( du_slt += (1 - du_slt) * 0.6; du_kwt *= 0.4; );
du_tht = -20 - 4 * du_bt + 0.3 * dm_a * du_vt;
du_wot = du_ri == 5; du_wnt = du_ri == 7; du_wbt = du_bt;
du_aud = floor(min(max(slider7, 0), 2) + 0.5); du_w2t = du_aud == 1; du_w3t = du_aud == 2;
du_hdt = du_db(0.5 * dm_a * du_vv);
du_wht = slider9 >= 0.5; du_wpt = slider10 >= 0.5; du_lkt = slider11 >= 0.5;
du_igt = du_db(min(max(slider2, -10), 30)); du_mkt = du_db(min(max(slider3, -30), 10));
du_mxt = min(max(slider13, 0), 100) / 100;
du_cwt = (min(max(slider12, 0), 100) / 100) ^ 1.5;
du_att_ms = du_att(slider4); du_rel_ms = du_rel(slider5);
du_wo > 0.01 ? du_att_ms = max(du_att_ms, 0.5 + 9.5 * du_wo);
du_ka = du_tc(du_att_ms); du_kr = du_tc(du_rel_ms);
du_kcr = du_tc(min(max(0.5 * du_rel_ms, 40), 400));
du_snap ? ( du_th = du_tht; du_sl = du_slt; du_kw = du_kwt; du_wo = du_wot; du_wn = du_wnt; du_wb = du_wbt;
            du_w2 = du_w2t; du_w3 = du_w3t; du_hd = du_hdt; du_wh = du_wht; du_wp = du_wpt; du_lk = du_lkt;
            du_ig = du_igt; du_mk = du_mkt; du_mx = du_mxt; du_cw = du_cwt; );
du_snap = 0;
hL.s1 = du_tn(hL.s1); hL.s2 = du_tn(hL.s2); hR.s1 = du_tn(hR.s1); hR.s2 = du_tn(hR.s2);
pL.s1 = du_tn(pL.s1); pL.s2 = du_tn(pL.s2); pR.s1 = du_tn(pR.s1); pR.s2 = du_tn(pR.s2);
eL.g = du_tn(eL.g); eR.g = du_tn(eR.g); eL.gs = du_tn(eL.gs); eR.gs = du_tn(eR.gs); crL.g = du_tn(crL.g); crR.g = du_tn(crR.g);
du_gr_d = min(du_gr_d, du_grm); du_grm = 0;
du_ol_d = max(du_ol_d, du_ol); du_or_d = max(du_or_d, du_or); du_ol = du_or = 0;
du_dl_d = max(du_dl_d, du_dz * du_hd * (du_w2 * 1.6 + du_w3 * 2.4 + du_bb * 4)); du_dz = 0;
os_snapb(slider(15));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
du_xl = in_l; du_xr = in_r;
pwr_in(du_xl, du_xr); du_xl = pwr_l; du_xr = pwr_r;
abs(du_xl) < 0.000000000000001 ? du_xl = 0; abs(du_xr) < 0.000000000000001 ? du_xr = 0;
du_th += (du_tht - du_th) * c_kn; du_sl += (du_slt - du_sl) * c_kn; du_kw += (du_kwt - du_kw) * c_kn;
du_ig += (du_igt - du_ig) * c_kn; du_mk += (du_mkt - du_mk) * c_kn; du_mx += (du_mxt - du_mx) * c_kn; du_cw += (du_cwt - du_cw) * c_kn;
du_hd += (du_hdt - du_hd) * c_kn;
du_wo += (du_wot - du_wo) * c_sw; du_wn += (du_wnt - du_wn) * c_sw; du_wb += (du_wbt - du_wb) * c_sw;
du_w2 += (du_w2t - du_w2) * c_sw; du_w3 += (du_w3t - du_w3) * c_sw;
du_wh += (du_wht - du_wh) * c_sw; du_wp += (du_wpt - du_wp) * c_sw; du_lk += (du_lkt - du_lk) * c_lk;
du_sl0 = du_xl * du_ig; du_sr0 = du_xr * du_ig;
du_sl0 += du_wh * (hL.bq_run(du_sl0) - du_sl0); du_sr0 += du_wh * (hR.bq_run(du_sr0) - du_sr0);
du_sl0 += du_wp * (pL.bq_run(du_sl0) - du_sl0); du_sr0 += du_wp * (pR.bq_run(du_sr0) - du_sr0);
du_al = abs(du_sl0); du_ar = abs(du_sr0); du_am = max(du_al, du_ar);
du_al += du_lk * (du_am - du_al); du_ar += du_lk * (du_am - du_ar);
du_ll = 8.685889638 * log(max(du_al, 0.000001)); du_lr = 8.685889638 * log(max(du_ar, 0.000001));
du_gdl = eL.du_env(du_gc(du_ll)); du_gdr = eR.du_env(du_gc(du_lr));
du_cdl = crL.du_cenv(max(du_ll - du_th + 10, 0)); du_cdr = crR.du_cenv(max(du_lr - du_th + 10, 0));
du_grm = min(du_grm, -max(du_gdl, du_gdr));
du_bb = 0.4 * du_wb * min(0.5 * (du_gdl + du_gdr) / 15, 1);
du_gnl = exp(-0.115129255 * du_gdl); du_gnr = exp(-0.115129255 * du_gdr);
du_cnl = exp(-0.115129255 * du_cdl); du_cnr = exp(-0.115129255 * du_cdr);
os_gate();
os_chg ? ( du_clear(); os_hold += 2 * samplesblock; );
uxL.os_up(du_xl); uxR.os_up(du_xr);
os_f == 1 ? (
  du_os(uxL.s0, uxR.s0, du_gnl, du_gnr, du_cnl, du_cnr); du_yl = du_pl; du_yr = du_pr;
) : (
  du_q = 1 / os_f;
  du_dgl = (du_gnl - du_gpl) * du_q; du_dgr = (du_gnr - du_gpr) * du_q;
  du_dcl = (du_cnl - du_cpl) * du_q; du_dcr = (du_cnr - du_cpr) * du_q;
  du_os(uxL.s0, uxR.s0, du_gpl + du_dgl, du_gpr + du_dgr, du_cpl + du_dcl, du_cpr + du_dcr); du_a0 = du_pl; du_b0 = du_pr;
  du_os(uxL.s1, uxR.s1, du_gpl + 2 * du_dgl, du_gpr + 2 * du_dgr, du_cpl + 2 * du_dcl, du_cpr + 2 * du_dcr); du_a1 = du_pl; du_b1 = du_pr;
  os_f == 2 ? ( du_yl = dnL.os_dn(du_a0, du_a1, 0, 0); du_yr = dnR.os_dn(du_b0, du_b1, 0, 0); ) : (
    du_os(uxL.s2, uxR.s2, du_gpl + 3 * du_dgl, du_gpr + 3 * du_dgr, du_cpl + 3 * du_dcl, du_cpr + 3 * du_dcr); du_a2 = du_pl; du_b2 = du_pr;
    du_os(uxL.s3, uxR.s3, du_gnl, du_gnr, du_cnl, du_cnr); du_a3 = du_pl; du_b3 = du_pr;
    du_yl = dnL.os_dn(du_a0, du_a1, du_a2, du_a3); du_yr = dnR.os_dn(du_b0, du_b1, du_b2, du_b3);
  );
);
du_gpl = du_gnl; du_gpr = du_gnr; du_cpl = du_cnl; du_cpr = du_cnr;
du_dz = max(du_dz, max(abs(du_zl), abs(du_zr)));
du_z = du_yl - du_dxl + du_dcc * du_dyl; du_dxl = du_yl; du_dyl = du_z; du_yl = du_z;
du_z = du_yr - du_dxr + du_dcc * du_dyr; du_dxr = du_yr; du_dyr = du_z; du_yr = du_z;
pwr_out(du_yl, du_yr); du_yl = pwr_l; du_yr = pwr_r;
du_osg = os_g * os_g * (3 - 2 * os_g);
du_yl *= du_osg; du_yr *= du_osg;
du_yl != du_yl ? du_yl = 0; du_yr != du_yr ? du_yr = 0;
du_fi < 1 ? (
  du_fi = min(du_fi + du_fis, 1); du_z = du_fi * du_fi * (3 - 2 * du_fi);
  du_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; du_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  du_yl = du_a + du_z * (du_yl - du_a); du_yr = du_b + du_z * (du_yr - du_b);
);
ost_out(du_yl, du_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
du_ol = max(du_ol, abs(spl0)); du_or = max(du_or, abs(spl1));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
ONF = 0x30363C; ONW = 0x181B1F; ONI = 0xE8E0CB; ONA = 0xF0883A; ONH = 0x141619; ONB = 0x14171A;
sc != oy_fsc ? (
  oy_fsc = sc;
  oy_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  oy_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  oy_f6 = ui_fitfont(6, 24 * sc);
);
function oy_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * oy_kt * sc, 'b'); );
function oy_fa(px) ( gfx_setfont(10, "Arial", px * oy_ka * sc, 'b'); );
function oy_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function oy_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function oy_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
