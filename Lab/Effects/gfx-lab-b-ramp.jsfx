desc:GFX Lab B Ramp [bass amp]
//tags: amp amplifier bass valve tube solid state head cabinet di sub compressor graphic modular
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-amp, gfx-lab-clip, gfx-lab-os (.jsfx-inc) in the same folder.
//
// B RAMP - one bass amp built from interchangeable pieces: the bass heads of the range (Amp Head's BASS model, AD-200,
// 5F6) and a new solid-state head (SB-80) split into a PREAMP, a POWER AMP and a CABINET, and any piece plugs into any
// other: the SB-80's graphic preamp into the AD-200's valves and the 5F6's open 4x10, say. Choose the pieces of one
// original and you have that amp (each piece is its original's code, ported; a matched set nulls against the original
// with DRIFT at 0 - the AD-200 at 2x, the others at 1x).
//   PREAMP     AMP HEAD    two valves: GAIN, BASS / MIDRANGE (five FREQUENCIES) / TREBLE, ULTRA LO and ULTRA HI.
//              AD-200      the CRUSH / DEEP valve preamp: GAIN, the passive BASS / MIDDLE / TREBLE stack with its
//                          MIDDLE frequency keys, and SUB (the clean low end under the drive).
//              5F6         the tweed: VOLUME, BLEND (normal - jumpered - bright), the cathode follower into its stack
//                          (TREBLE / MIDDLE / BASS), TWEED / GREYBEARD.
//              SB-80       new, in the spirit of the 80s British solid-state bass amps: GAIN into a transistor stage,
//                          the built-in COMPRESSOR, the PRE-SHAPE mid scoop and a seven-band GRAPHIC.
//   POWER AMP  AMP HEAD    a big push-pull valve stage on a sagging supply, MASTER.
//              AD-200      four power valves inside a feedback loop (CRUSH / DEEP), the valve rectifier, MASTER.
//              5F6         the tweed's two valves, PRESENCE in the feedback, MASTER (new: 5 = the original), the
//                          speaker load the low feedback lets through, TWEED / GREYBEARD.
//              SB-80       a big clean solid-state amp that rounds off at its rails, MASTER.
//   CABINET    8x10 (Amp Head), 8x10 / 4x10 sealed and 1x15 ported (AD-200), 4x10 open (5F6), 4x10 and 1x15 (SB-80),
//              or off (the line out). MIC from on axis (bright) to off axis (dark).
// DI: the clean DI signal (in time with the amp) blended in after the cabinet.
// Levels: a piece feeding another's input is scaled so the next piece sees the level its own partner gives it, and
//   each mixed pair is level-matched to the preamp's own amp.
// Piece changes duck (8 ms out, the swap at silence, 8 ms back), so nothing clicks.
// ANTI-ALIASING / OS: the preamp and power amp run together at 1x, 2x or 4x (the OS key; 2x = 31 samples of latency,
//   4x = 37). 1x keeps each original's own host-rate anti-aliasing (ADAA on every valve, the drive-tracking pre-filter,
//   the post-shelves); the AD-200 ran at 2x, so it matches its original at 2x.
// DRIFT (0 - 100 %, 50 % = standard; JG, 27 Oct 2026): each piece brings the drift of its original - the valves' bias,
//   the power valves' balance and the supply's breathing; the SB-80's supply breathes and its speakers loosen as they
//   warm up (JG).
// IN / OUT: TRIM (GUARD), MONO IN, GATE (fully down = off), DI, OUTPUT, and the house output stage (CLIP, always on).
// PRESETS: Init, ten originals (Amp Head, AD-200, 5F6, SB-80) and five hybrids, levelled to about -22 dBFS RMS on a
//   bass line with OUTPUT; every preset starts from Init, and loads at the silent point of a duck.
//
// Latency: 0 samples at 1x, 31 at 2x, 37 at 4x (reported).

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-amp.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc

slider1:0<0,3,1{Amp Head,AD-200,5F6,SB-80}>-Preamp
slider2:0<0,3,1{Amp Head,AD-200,5F6,SB-80}>-Power amp
slider3:1<0,7,1{Off (line out),8x10 (Amp Head),8x10 sealed (AD-200),4x10 sealed (AD-200),1x15 ported (AD-200),4x10 open (5F6),4x10 (SB-80),1x15 (SB-80)}>-Cabinet
slider4:3<0,10,0.1>-Mic position (on - off axis)
slider5:0<0,100,1>-DI blend (%)
slider6:0<0,1,1{Off,On}>-Mono in
slider7:-80<-80,-20,0.5>-Gate threshold (dB, -80 = off)
slider8:0<0,2,1{1x,2x,4x}>-Oversampling
slider9:0<-24,12,0.1>-Input trim (dB)
slider10:0<0,1,1{Off,On}>-Input guard
slider11:50<0,100,1>-Drift (%)
slider12:0<-24,12,0.1>-Output (dB)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-Ceiling (dB)
slider18:4<-12,100,0.01>-Preamp control 1
slider19:0<-12,100,0.01>-Preamp control 2
slider20:0<-12,100,0.01>-Preamp control 3
slider21:0<-12,100,0.01>-Preamp control 4
slider22:0<-12,100,0.01>-Preamp control 5
slider23:1<-12,100,0.01>-Preamp control 6
slider24:0<-12,100,0.01>-Preamp control 7
slider25:0<-12,100,0.01>-Preamp control 8
slider26:0<-12,100,0.01>-Preamp control 9
slider27:0<-12,100,0.01>-Preamp control 10
slider28:4<-12,12,0.01>-Power amp control 1
slider29:0<-12,12,0.01>-Power amp control 2
slider30:0<-12,12,0.01>-Power amp control 3

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-b-ramp";                                // the ? pop-up links to this manual
ext_noinit = 1;

// ================================================================ shared
function rp_alloc(n) local(p) ( p = rp_nm; rp_nm += n; memset(p, 0, n); p; );
function rp_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
// the s74 biquad (the AD-200's and the 5F6's filters): 0 LP, 1 HP, 2 BP, 3 peak, 4 low shelf, 5 high shelf
function rp_sbqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(A, w, cs, sn, al, a0, sa) (
  A = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * max(q, 0.05));
  t == 0 ? ( a0 = 1 + al; b0 = (1 - cs) / 2 / a0; b1 = (1 - cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 1 ? ( a0 = 1 + al; b0 = (1 + cs) / 2 / a0; b1 = -(1 + cs) / a0; b2 = b0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 2 ? ( a0 = 1 + al; b0 = al / a0; b1 = 0; b2 = -al / a0; a1 = -2 * cs / a0; a2 = (1 - al) / a0; ) :
  t == 3 ? ( a0 = 1 + al / A; b0 = (1 + al * A) / a0; b1 = -2 * cs / a0; b2 = (1 - al * A) / a0; a1 = -2 * cs / a0; a2 = (1 - al / A) / a0; ) :
  t == 4 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) + (A - 1) * cs + sa;
             b0 = A * ((A + 1) - (A - 1) * cs + sa) / a0; b1 = 2 * A * ((A - 1) - (A + 1) * cs) / a0; b2 = A * ((A + 1) - (A - 1) * cs - sa) / a0;
             a1 = -2 * ((A - 1) + (A + 1) * cs) / a0; a2 = ((A + 1) + (A - 1) * cs - sa) / a0; ) :
  t == 5 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) - (A - 1) * cs + sa;
             b0 = A * ((A + 1) + (A - 1) * cs + sa) / a0; b1 = -2 * A * ((A - 1) + (A + 1) * cs) / a0; b2 = A * ((A + 1) + (A - 1) * cs - sa) / a0;
             a1 = 2 * ((A - 1) - (A + 1) * cs) / a0; a2 = ((A + 1) - (A - 1) * cs - sa) / a0; ) :
  ( a0 = 1 + al; b0 = (1 - al) / a0; b1 = -2 * cs / a0; b2 = 1; a1 = b1; a2 = b0; );
);
function rp_sbq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function rp_sbqclr() instance(z1, z2) ( z1 = z2 = 0; );
rp_dn = 0.000000000000000001;

// ================================================================ AMP HEAD (the BASS model of gfx-amp-head)
// a valve stage, anti-aliased (am_tube's tanh with first-order ADAA on ln cosh); ah_tset(b) moves the bias smoothly
function ah_tset(b) instance(tb, tt, tn, u1, f1) local(a) (
  b !== tb ? (
    u1 += b - tb; tb = b; tt = am_tanh(b); tn = 1 / (1 - tt * tt);
    a = abs(u1); f1 = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  );
);
function ah_tube(x) instance(tb, tt, tn, u1, f1) local(u, a, f, d, y) (
  u = x + tb; a = abs(u);
  f = a + log(1 + exp(-2 * a)) - 0.6931471805599453;
  d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : am_tanh(0.5 * (u + u1));
  u1 = u; f1 = f;
  (y - tt) * tn;
);
function ah_tzero() instance(tb, tt, tn, u1, f1) ( tb = tt = u1 = f1 = 0; tn = 1; );
// the level trims (dB at GAIN / MASTER 0, 1 .. 10): GAIN, MASTER; and the line out's shelf, peak and trim
function ab_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = ab_trt + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function ab_trim(k, v) local(p, i, f, q) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i; q = ab_trt + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
function ab_tables() (
  ab_trt = rp_alloc(5 * 11);
  ab_row(0, 0, 0, 0, 0, 0, 0.06, 0.17, 0.36, 0.57, 0.81, 0.99);
  ab_row(1, 0, 0, 0, 0, 0, 0, 0.03, 0.11, 0.19, 0.36, 0.53);
  ab_row(2, -0.78, -0.52, 0.01, 0.78, 1.78, 2.97, 4.19, 5.18, 5.68, 5.62, 5.25);
  ab_row(3, -0.61, -0.59, -0.54, -0.46, -0.33, -0.14, 0.10, 0.40, 0.69, 0.93, 1.13);
  ab_row(4, 0.10, 0.12, 0.14, 0.14, 0.11, 0.09, 0.05, 0.02, -0.03, -0.06, -0.11);
);
function ab_loset() instance(s1, s2) (
  s1.am_bq(3, 0.25 * srate, 0.8, ab_trim(2, ab_gs), srate); s2.am_bq(2, 0.1666667 * srate, 0.7, ab_trim(3, ab_gs), srate);
);
// the output transformer: the core saturates on flux
function ab_xf_run(x, k) instance(ph, sp) local(s, y) (
  ph = ph * ab_xf_lk + x * ab_xf_c; s = am_tanh(ph * k) / k; y = (s - sp * ab_xf_lk) / ab_xf_c; sp = s; y;
);
// ---- AMP HEAD preamp, one side (abpL / abpR): x (after the pre-filter) -> V2 and its cathode follower
function ab_pre(x) instance(ihp, v1, mil, tb, tm, tt, ul1, ul2, uh, c2hp, v2) local(y) (
  y = ihp.am_run(x);
  y = v1.ah_tube(y * ab_g1);                                // V1 (bias ab_b1)
  y = mil.am_run(y) * ab_c1;
  y = tb.am_run(y); y = tm.am_run(y); y = tt.am_run(y);     // the tone stack
  y = ul1.am_run(y); y = ul2.am_run(y); y = uh.am_run(y);   // ULTRA LO / HI
  y = c2hp.am_run(y);
  v2.ah_tube(y * 2.5) * 0.4;                                // V2 + cathode follower (bias ab_b2)
);
function ab_preset() instance(ihp, mil, tb, tm, tt, ul1, ul2, uh, c2hp) local(mf) (
  mf = RP_ST[23] | 0; mf = mf == 0 ? 220 : mf == 1 ? 450 : mf == 2 ? 800 : mf == 3 ? 1600 : 3000;
  ihp.am_bq(1, 35, 0.7, 0, rp_fs);
  mil.am_bq(0, 14000, 0.7, 0, rp_fs);
  tb.am_bq(4, 80, 0.7, RP_ST[21], rp_fs);
  tm.am_bq(2, mf, 0.9, RP_ST[22], rp_fs);
  tt.am_bq(3, 5000, 0.7, RP_ST[24], rp_fs);
  ul1.am_bq(4, 40, 0.8, RP_ST[19] >= 0.5 ? 4 : 0, rp_fs);
  ul2.am_bq(2, 500, 0.8, RP_ST[19] >= 0.5 ? -10 : 0, rp_fs);
  uh.am_bq(3, 8000, 0.7, RP_ST[20] >= 0.5 ? 8 : 0, rp_fs);
  c2hp.am_bq(1, 20, 0.7, 0, rp_fs);
);
function ab_preclr() instance(ihp, v1, mil, tb, tm, tt, ul1, ul2, uh, c2hp, v2) (
  ihp.rp_bqclr(); mil.rp_bqclr(); tb.rp_bqclr(); tm.rp_bqclr(); tt.rp_bqclr();
  ul1.rp_bqclr(); ul2.rp_bqclr(); uh.rp_bqclr(); c2hp.rp_bqclr();
  v1.ah_tzero(); v2.ah_tzero(); v1.ah_tset(ab_b1); v2.ah_tset(ab_b2);
);
function ab_gset() ( ab_g1 = exp(0.1151292546 * (ab_gs * 4.2 - 6)); ab_c1 = 1 / sqrt(ab_g1); );   // -6 .. +36 dB into V1
function ab_glide() (
  ab_gs !== RP_ST[18] ? ( ab_gs += (RP_ST[18] - ab_gs) * ab_gk; abs(ab_gs - RP_ST[18]) < 0.00001 ? ab_gs = RP_ST[18]; ab_gset(); );
);
// ---- AMP HEAD power amp, one side (abwL / abwR): the phase inverter, MASTER, push-pull on the shared supply, the iron
function ab_pow(x) instance(vpi, phc, vpw, xfo, pa) local(y) (
  y = vpi.ah_tube(x * 0.9);                                 // (bias -0.04)
  y = phc.am_run(y) * ab_pm;                                // into the power stage (MASTER)
  y = ab_sup * vpw.ah_tube(y / ab_sup);                     // push-pull, with supply sag (symmetric: bias 0)
  pa = abs(y);
  y = xfo.ab_xf_run(y + ab_pbias * y * y, 0.5);
  y * ab_mk;
);
function ab_sag() local(a) (
  a = max(abwL.pa, abwR.pa);
  ab_sgenv += (a - ab_sgenv) * (a > ab_sgenv ? ab_sga : ab_sgr);
  ab_sup = 1 - 0.3 * min(ab_sgenv, 1);
);
function ab_powclr() instance(vpi, phc, vpw, xfo, pa) (
  vpi.ah_tzero(); vpw.ah_tzero(); vpi.ah_tset(-0.04); phc.rp_bqclr(); xfo.ph = xfo.sp = 0; pa = 0;
  phc.am_bq(1, 25, 0.7, 0, rp_fs);
);
function ab_powupd() ( ab_pm = 10 ^ ((RP_ST[48] * 3.4 - 15) / 20); ab_mk = 2 * 0.55 / (ab_pm ^ 0.55); );   // (x 2: the original's)
// DRIFT (the original's 25 % amount and 0.25 Hz speed, scaled by the DRIFT dial)
function ab_pdrift() local(inc) (
  inc = 0.25 * dm_s * samplesblock / srate;
  ab_b1 = 0.15 + 0.06 * 0.25 * dm_a * abD1.drift_tick(inc);
  ab_b2 = 0.10 + 0.05 * 0.25 * dm_a * abD2.drift_tick(inc);
  abpL.v1.ah_tset(ab_b1); abpL.v2.ah_tset(ab_b2); abpR.v1.ah_tset(ab_b1); abpR.v2.ah_tset(ab_b2);
);
function ab_wdrift() ( ab_pbias = 0.02 * 0.25 * dm_a * abD3.drift_tick(0.25 * dm_s * samplesblock / srate); );
function ab_prein() (
  ab_gs = RP_ST[18]; ab_gset(); ab_lpre = -1;
  abfL.clp_pf_cfg(40000, 9000, -1.5, 150); abfL.clp_pf_reset(); abfR.clp_pf_cfg(40000, 9000, -1.5, 150); abfR.clp_pf_reset();
  abpL.ab_preset(); abpR.ab_preset(); abpL.ab_preclr(); abpR.ab_preclr();
  abkL1.rp_bqclr(); abkL2.rp_bqclr(); abkR1.rp_bqclr(); abkR2.rp_bqclr();
  abkL1.am_bq(2, 0.27808 * srate, 1.02, 12.82, srate); abkL2.am_bq(3, 0.16527 * srate, 0.54, 2.76, srate);   // the post-shelf (1x)
  abkR1.am_bq(2, 0.27808 * srate, 1.02, 12.82, srate); abkR2.am_bq(3, 0.16527 * srate, 0.54, 2.76, srate);
  abloL.s1.rp_bqclr(); abloL.s2.rp_bqclr(); abloR.s1.rp_bqclr(); abloR.s2.rp_bqclr(); ab_lgs = -1;
);
function ab_powin() (
  ab_xf_c = 2 * $pi * 40 / rp_fs; ab_xf_lk = 1 - 2 * $pi * 5 / rp_fs;
  ab_sga = 1 - exp(-1 / (0.005 * rp_fs)); ab_sgr = 1 - exp(-1 / (0.12 * rp_fs));
  ab_sup = 1; ab_sgenv = 0;
  abwL.ab_powclr(); abwR.ab_powclr(); ab_powupd();
);
function ab_preblk() local(ch) (
  ch = RP_ST[19] + 2 * RP_ST[20] + 3 * RP_ST[21] + 5 * RP_ST[22] + 7 * RP_ST[23] + 11 * RP_ST[24];
  ch != ab_lpre ? ( ab_lpre = ch; abpL.ab_preset(); abpR.ab_preset(); );
  abfL.clp_pf_block(ab_gs / 10, srate, samplesblock); abfR.clp_pf_block(ab_gs / 10, srate, samplesblock);
);

// ================================================================ AD-200 (gfx-ad-200)
// valve curves: a smooth saturator (rational, exactly 1 from |x| = 3) and its slope; the triode's two sides
function a2_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function a2_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function a2_tg(u) ( u >= 0 ? a2_th(u) : 1.8 * a2_th(u * 0.5555556) );
function a2_tgd(u) ( u >= 0 ? a2_thd(u) : a2_thd(u * 0.5555556) );
function a2_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function a2_tgF(u) ( u >= 0 ? a2_F(u) : 3.24 * a2_F(u * 0.5555556) );
// first-order ADAA with a small pre-emphasis (a2_eb) on each stage's input
function a2_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = a2_tgF(u1); b0 = b; g0 = a2_tg(b); n0 = 1 / max(a2_tgd(b), 0.05); );
function a2_strun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + a2_eb * (x - xp) + b0; xp = x; ga = a2_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : a2_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + a2_dn;
);
function a2_stclr() instance(b0, g0, n0, u1, ga1, xp) ( b0 = g0 = u1 = ga1 = xp = 0; n0 = 1; );
function a2_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = a2_F(u1); b0 = b; g0 = a2_th(b); n0 = 1 / max(a2_thd(b), 0.05); );
function a2_syrun(x) instance(b0, g0, n0, u1, ga1, xp) local(u, ga, d, y) (
  u = x + a2_eb * (x - xp) + b0; xp = x; ga = a2_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : a2_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + a2_dn;
);
a2_eb = 0.25;
a2_dn = 0.000000000000000001;
// first-order sections (bilinear)
function a2_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function a2_1clr() instance(x1, y1) ( x1 = y1 = 0; );
function a2_shset(fz, F, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * F;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function a2_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
// the passive tone stack (third order, from the component values; C3 / R3 = the switched middle cap and pot)
function a2_tsset(t, m, l, C3, R3, fs) instance(b0, b1, b2, b3, a1, a2, a3)
  local(C1, C2, R1, R2, R4, nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  C1 = 0.00000000047; C2 = 0.000000047;
  R1 = 250000; R2 = 1000000; R4 = 47000;
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  b0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  b1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  b2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  b3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  a1 = k1 * q; a2 = k2 * q; a3 = k3 * q;
);
function a2_tsrun(x) instance(b0, b1, b2, b3, a1, a2, a3, x1, x2, x3, y1, y2, y3) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 + b3 * x3 - a1 * y1 - a2 * y2 - a3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);
function a2_tsclr() instance(x1, x2, x3, y1, y2, y3) ( x1 = x2 = x3 = y1 = y2 = y3 = 0; );
// the power stage: push-pull pairs inside a negative-feedback loop, worked out once per model as a table
a2_qn = 4096; a2_qr = 4; a2_qs = (a2_qn - 1) / (2 * a2_qr);
function a2_qbuild(tab, A, B) local(i, U, lo, hi, m) (
  i = 0;
  loop(a2_qn,
    U = -a2_qr + i / a2_qs; lo = -1; hi = 1;
    loop(44, m = 0.5 * (lo + hi); m - a2_th(A * (U - B * m)) > 0 ? hi = m : lo = m; );
    tab[i] = 0.5 * (lo + hi);
    i += 1;
  );
  tab[a2_qn] = tab[a2_qn - 1];
);
function a2_qint(t, c) local(i, h) (
  h = 1 / a2_qs; c[0] = 0; i = 0;
  loop(a2_qn - 1, c[i + 1] = c[i] + h * 0.5 * (t[i] + t[i + 1]); i += 1; );
);
function a2_qF(t, c, p) local(i, f, q) (
  p <= 0 ? t[0] * p / a2_qs : p >= a2_qn - 1 ? c[a2_qn - 1] + t[a2_qn - 1] * (p - a2_qn + 1) / a2_qs : (
    i = floor(p); f = p - i; q = t + i;
    c[i] + (q[0] * f + 0.5 * (q[1] - q[0]) * f * f) / a2_qs;
  );
);
function a2_qQ(t, p) local(i) ( p = min(max(p, 0), a2_qn - 1.001); i = floor(p); p -= i; t[i] + (t[i + 1] - t[i]) * p; );
function a2_paset(d) instance(t00, of0, t01, of1, va, vb) (
  t00 = a2_th(d); of0 = d / a2_A0 + a2_B0 * t00;
  t01 = t00; of1 = d / a2_A1 + a2_B1 * t01;
  va = vb = 0;
);
function a2_pa(u) instance(sup, sbase, e1, e2, t00, of0, t01, of1, dr, u1, fa1, fb1, va, vb, xp) local(p, y, y1, a, d, f) (
  p = u + a2_eb * (u - xp); xp = u;
  u = p / sup; d = (u - u1) * a2_qs;
  a2_ww < 0.9999 ? (
    !va ? ( fa1 = a2_qF(a2_QA, a2_QAC, (u1 + of0 + a2_qr) * a2_qs); va = 1; );
    p = (u + of0 + a2_qr) * a2_qs; f = a2_qF(a2_QA, a2_QAC, p);
    y = (abs(d) > 0.00001 ? (f - fa1) / d * a2_qs : a2_qQ(a2_QA, p - 0.5 * d)) - t00; fa1 = f;
  ) : ( va = 0; );
  a2_ww > 0.0001 ? (
    !vb ? ( fb1 = a2_qF(a2_QB, a2_QBC, (u1 + of1 + a2_qr) * a2_qs); vb = 1; );
    p = (u + of1 + a2_qr) * a2_qs; f = a2_qF(a2_QB, a2_QBC, p);
    y1 = (abs(d) > 0.00001 ? (f - fb1) / d * a2_qs : a2_qQ(a2_QB, p - 0.5 * d)) - t01; fb1 = f;
    y = a2_ww < 0.9999 ? y + (y1 - y) * a2_ww : y1;
  ) : ( vb = 0; );
  u1 = u;
  y *= sup;
  // the supply sags on the current the valves draw: a fast dip (the rectifier) and a slower one (the reservoir)
  a = abs(y);
  e1 += (a - e1) * (a > e1 ? a2_sa1 : a2_sr1);
  e2 += (a - e2) * (a > e2 ? a2_sa2 : a2_sr2);
  dr = a2_sgd * min(max(0.65 * e1 + 0.35 * e2 - a2_sgt, 0) * a2_sgs, 1);
  sup = sbase * (1 - dr);
  y;
);
function a2_ot(x) instance(ph, php) local(y) (
  php = ph; ph = ph * a2_xlk + x * a2_xc;
  (a2_th(ph * a2_otk) - a2_xlk * a2_th(php * a2_otk)) / (a2_otk * a2_xc);
);
// ---- AD-200 preamp, one side (a2pL / a2pR): V1a, GAIN, V1b, the tone stack, V2a (the recovery stage). Out in the
// input's polarity (the original's power amp put it back; here the power amp takes it as it comes)
function a2_pre(x) instance(cs1, v1a, hp1, v1b, hp2, ts, v2a) local(u) (
  u = cs1.a2_1run(x * a2_kin);
  u = -a2_G1 * v1a.a2_strun(u);                             // V1a
  u = hp1.a2_1run(u) * a2_gp;                               // GAIN
  u = -a2_G2 * v1b.a2_strun(u);                             // V1b
  u = hp2.a2_1run(u);
  u = ts.a2_tsrun(u) * a2_kts;                              // the tone stack
  -(-a2_G3 * v2a.a2_strun(u));                              // V2a
);
function a2_preclr() instance(cs1, v1a, hp1, v1b, hp2, ts, v2a) (
  cs1.a2_1clr(); hp1.a2_1clr(); hp2.a2_1clr(); ts.a2_tsclr();
  v1a.a2_stclr(); v1b.a2_stclr(); v2a.a2_stclr();
);
// ---- AD-200 power amp, one side (a2wL / a2wR): MASTER, the phase inverter, the power valves, the transformer
function a2_pow(x) instance(hp3, pin, pa, ot) local(u) (
  u = hp3.a2_1run(-x * a2_mp);                              // MASTER, the coupling into the phase inverter
  u = pin.a2_syrun(u * a2_kpi);                             // the phase inverter
  u = pa.a2_pa(u);                                          // the power valves, the supply
  -ot.a2_ot(u);                                             // the output transformer
);
function a2_powclr() instance(hp3, pin, pa, ot) (
  hp3.a2_1clr(); pin.a2_stclr(); ot.ph = ot.php = 0;
  pa.sup = pa.sbase = 1; pa.e1 = pa.e2 = pa.dr = pa.u1 = pa.fa1 = pa.fb1 = pa.va = pa.vb = pa.xp = 0;
);
// the linear copy (host rate): the same filters with no valves - the SUB's clean low end
function a2_lin(x) instance(cs1, hp1, hp2, ts, hp3) (
  hp3.a2_1run(ts.a2_tsrun(hp2.a2_1run(hp1.a2_1run(cs1.a2_1run(x)))));
);
function a2_linclr() instance(cs1, hp1, hp2, ts, hp3) ( cs1.a2_1clr(); hp1.a2_1clr(); hp2.a2_1clr(); ts.a2_tsclr(); hp3.a2_1clr(); );
// the cabinets (procedural; mic 0 = on axis .. 10 = off axis): 1 8x10 sealed, 2 4x10 sealed, 3 1x15 ported
function a2_cabset(type, mic) instance(f1, f2, f3, f4, f5, f6, f7, f8, tr) local(m, lp) (
  m = mic / 10;
  tr = type == 2 ? 0.98 : 1;                                // the cabs level matched
  type == 1 ? (
    f1.rp_sbqset(1, 45, 0, 0.85, srate);
    f2.rp_sbqset(3, 95, 2.5, 1.1, srate);
    f3.rp_sbqset(3, 420, -3, 1.1, srate);
    f4.rp_sbqset(3, 1300, 1.5, 1.4, srate);
    f5.rp_sbqset(3, 2600, 3.5 * (1 - m) - 1.5 * m, 1.8, srate);
    lp = 5000 - 1900 * m; f8.rp_sbqset(3, 6200, -9 * m, 3, srate);
  ) : type == 2 ? (
    f1.rp_sbqset(1, 55, 0, 0.95, srate);
    f2.rp_sbqset(3, 115, 2, 1.2, srate);
    f3.rp_sbqset(3, 520, -2.5, 1.2, srate);
    f4.rp_sbqset(3, 1600, 2, 1.3, srate);
    f5.rp_sbqset(3, 3100, 4 * (1 - m) - 1.5 * m, 1.8, srate);
    lp = 5800 - 2100 * m; f8.rp_sbqset(3, 7200, -9 * m, 3, srate);
  ) : (
    f1.rp_sbqset(1, 36, 0, 1.15, srate);
    f2.rp_sbqset(3, 62, 3, 1.4, srate);
    f3.rp_sbqset(3, 330, -3, 1.0, srate);
    f4.rp_sbqset(3, 850, 2.5, 1.2, srate);
    f5.rp_sbqset(3, 1900, 2 * (1 - m) - 1 * m, 2, srate);
    lp = 3400 - 1100 * m; f8.rp_sbqset(3, 4600, -10 * m, 3, srate);
  );
  f6.rp_sbqset(0, lp, 0, 0.5412, srate); f7.rp_sbqset(0, lp, 0, 1.3066, srate);
);
function a2_cabclr() instance(f1, f2, f3, f4, f5, f6, f7, f8) (
  f1.rp_sbqclr(); f2.rp_sbqclr(); f3.rp_sbqclr(); f4.rp_sbqclr(); f5.rp_sbqclr(); f6.rp_sbqclr(); f7.rp_sbqclr(); f8.rp_sbqclr();
);
function a2_cabrun(x) instance(f1, f2, f3, f4, f5, f6, f7, f8, tr) (
  f8.rp_sbq(f7.rp_sbq(f6.rp_sbq(f5.rp_sbq(f4.rp_sbq(f3.rp_sbq(f2.rp_sbq(f1.rp_sbq(x)))))))) * tr;
);
// the makeup tables: GAIN (CRUSH, DEEP; GAIN 0 .. 10) and MASTER (CRUSH, DEEP; MASTER 2 .. 10), dB
function a2_row(k, a, b, c, d, e, f, g, h, i, j, l) local(p) (
  p = a2_MK + k * 11; p[0] = a; p[1] = b; p[2] = c; p[3] = d; p[4] = e; p[5] = f; p[6] = g; p[7] = h; p[8] = i; p[9] = j; p[10] = l;
);
function a2_mk(k, g) local(p, i, f, q) (
  p = min(max(g, 0), 10); i = min(floor(p), 9); f = p - i; q = a2_MK + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
function a2_mcd(k, m) local(p, i, f, q) (
  p = min(max(m, 2), 10); i = min(floor(p), 9); f = p - i; q = a2_MK + 22 + k * 11;
  q[i] * (1 - f) + q[i + 1] * f;
);
// MASTER past 4: the anti-aliased power stage comes out a little louder; this takes it back (g = the AD-200's GAIN)
function a2_mx(m, g) local(t) (
  t = min(max(m - 4, 0), 6);
  t = t < 2 ? 0.095 * t : t < 4 ? 0.19 + 0.12 * (t - 2) : t < 5 ? 0.43 + 0.05 * (t - 4) : 0.48 + 0.05 * (t - 5);
  t * ((g < 4 ? 0.66 + 0.085 * g : 1 - 0.133 * (g - 4)) * (1 - a2_ww) + 0.53 * max(g - 4, 0) / 6 * a2_ww);
);
function a2_pot(p) ( 0.002 + 0.998 * (10 ^ (2 * p) - 1) / 99; );
function a2_tables() local(p) (
  a2_QA = rp_alloc(a2_qn + 1); a2_QB = rp_alloc(a2_qn + 1); a2_QAC = rp_alloc(a2_qn + 1); a2_QBC = rp_alloc(a2_qn + 1);
  a2_A0 = 10; a2_B0 = 0.14; a2_A1 = 10; a2_B1 = 0.6;
  a2_qbuild(a2_QA, a2_A0, a2_B0); a2_qbuild(a2_QB, a2_A1, a2_B1); a2_qint(a2_QA, a2_QAC); a2_qint(a2_QB, a2_QBC);
  a2_MK = rp_alloc(48);
  a2_row(0, -21.71, -10.22, -3.27, 1.67, 6.13, 10.09, 12.86, 14.14, 14.92, 15.48, 15.84);
  a2_row(1, -48.05, -36.14, -29.48, -23.96, -19.41, -14.87, -11.49, -7.91, -5.24, -3.92, -3.11);
  p = a2_MK + 22; p[0] = -8.03; p[1] = -8.03; p[2] = -8.03; p[3] = -3.71; p[4] = 0; p[5] = 2.98; p[6] = 4.38; p[7] = 4.79; p[8] = 4.14; p[9] = 3.65; p[10] = 2.67;
  p = a2_MK + 33; p[0] = -8.04; p[1] = -8.04; p[2] = -8.04; p[3] = -3.43; p[4] = 0; p[5] = 3.73; p[6] = 7.08; p[7] = 9.77; p[8] = 13.17; p[9] = 16.42; p[10] = 19.13;
);
a2_kin = 1 / 1.3;                                         // input (0 dBFS = about 1 V at the jack) to the first grid
function a2_lerp(a, b, w) ( a + (b - a) * w; );
function a2_glerp(a, b, w) ( a * (b / a) ^ w; );
// the preamp's circuit values: CRUSH (w = 0) .. DEEP (w = 1)
function a2_pmodel() local(w, fz, f1, f2, f3) (
  w = a2_wp;
  a2_G1 = a2_glerp(50, 40, w); a2_G2 = a2_glerp(34, 12, w); a2_G3 = a2_glerp(24, 10, w);
  a2_kts = a2_glerp(0.1, 0.14, w);
  a2_dbp = a2_lerp(1.3, 0.7, w);
  fz = a2_lerp(30, 4, w); f1 = a2_lerp(30, 7, w); f2 = a2_lerp(20, 6, w); f3 = a2_lerp(18, 5, w);
  a2pL.cs1.a2_shset(fz, 1.9, rp_fs); a2pL.hp1.a2_hpset(f1, rp_fs); a2pL.hp2.a2_hpset(f2, rp_fs);
  a2pR.cs1.a2_shset(fz, 1.9, rp_fs); a2pR.hp1.a2_hpset(f1, rp_fs); a2pR.hp2.a2_hpset(f2, rp_fs);
  a2lL.cs1.a2_shset(fz, 1.9, srate); a2lL.hp1.a2_hpset(f1, srate); a2lL.hp2.a2_hpset(f2, srate); a2lL.hp3.a2_hpset(f3, srate);
  a2lR.cs1.a2_shset(fz, 1.9, srate); a2lR.hp1.a2_hpset(f1, srate); a2lR.hp2.a2_hpset(f2, srate); a2lR.hp3.a2_hpset(f3, srate);
);
// ... and the power amp's
function a2_wmodel() local(w, f3) (
  w = a2_ww;
  a2_kpi = a2_glerp(1.8, 1.4, w);
  a2_sgd = a2_lerp(0.32, 0.07, w); a2_sgt = a2_lerp(0.25, 0.6, w); a2_sgs = a2_lerp(1.6, 1.2, w);
  a2_sa1 = 1 - exp(-1 / (a2_lerp(0.003, 0.001, w) * rp_fs)); a2_sr1 = 1 - exp(-1 / (a2_lerp(0.18, 0.06, w) * rp_fs));
  a2_sa2 = 1 - exp(-1 / (a2_lerp(0.04, 0.02, w) * rp_fs)); a2_sr2 = 1 - exp(-1 / (a2_lerp(0.4, 0.15, w) * rp_fs));
  a2_otk = a2_lerp(1.3, 0.4, w);
  a2_xlk = 1 - 2 * $pi * a2_lerp(9, 3, w) / rp_fs; a2_xc = 2 * $pi * 40 / rp_fs;
  a2_dbw = a2_lerp(1.3, 0.7, w);
  f3 = a2_lerp(18, 5, w);
  a2wL.hp3.a2_hpset(f3, rp_fs); a2wR.hp3.a2_hpset(f3, rp_fs);
);
// the tone stack and the MIDDLE frequency follow the controls smoothly (recomputed every block from glided values)
function a2_tone(force) local(k, ch, c3, r3, mf) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  mf = RP_ST[29] | 0;
  c3 = mf == 0 ? 5.6 : mf == 1 ? 1.65 : mf == 2 ? 0.578 : 0.203;
  r3 = mf == 1 ? 100000 : 250000;
  a2_s3 += (RP_ST[27] - a2_s3) * k; a2_s4 += (RP_ST[28] - a2_s4) * k; a2_s6 += (RP_ST[30] - a2_s6) * k;
  a2_lc3 += (log(c3 * 0.000000022) - a2_lc3) * k; a2_r3 += (r3 - a2_r3) * k;
  ch = a2_s3 + 2 * a2_s4 + 3 * a2_s6 + 5 * a2_lc3 + 7 * a2_r3 / 100000;
  force || abs(ch - a2_lts) > 0.00001 ? (
    a2_lts = ch;
    a2pL.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, rp_fs);
    a2pR.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, rp_fs);
    a2lL.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, srate);
    a2lR.ts.a2_tsset(a2_s6 / 10, a2_s4 / 10, a2_s3 / 10, exp(a2_lc3), a2_r3, srate);
  );
);
// DRIFT: the preamp valves' operating points; the phase inverter, the power valves' balance and the supply
function a2_pbias() local(a, inc) (
  inc = 0.2 * dm_s * samplesblock / srate;
  a = dm_a * a2_dbp;
  a2_d1 = a2D1.drift_tick(inc); a2_d2 = a2D2.drift_tick(inc); a2_d3 = a2D3.drift_tick(inc);
  a2pL.v1a.a2_stset(a2_lerp(-0.36, -0.28, a2_wp) + 0.05 * a * a2_d1); a2pR.v1a.a2_stset(a2_lerp(-0.36, -0.28, a2_wp) + 0.05 * a * a2_d1);
  a2pL.v1b.a2_stset(a2_lerp(-0.30, -0.22, a2_wp) + 0.05 * a * a2_d2); a2pR.v1b.a2_stset(a2_lerp(-0.30, -0.22, a2_wp) + 0.05 * a * a2_d2);
  a2pL.v2a.a2_stset(a2_lerp(-0.26, -0.20, a2_wp) + 0.05 * a * a2_d3); a2pR.v2a.a2_stset(a2_lerp(-0.26, -0.20, a2_wp) + 0.05 * a * a2_d3);
);
function a2_wbias() local(a, inc) (
  inc = 0.2 * dm_s * samplesblock / srate;
  a = dm_a * a2_dbw;
  a2_d4 = a2D4.drift_tick(inc); a2_d5 = a2D5.drift_tick(inc); a2_d6 = a2D6.drift_tick(inc);
  a2wL.pin.a2_syset(0.04 + 0.03 * a * a2_d4); a2wR.pin.a2_syset(0.04 + 0.03 * a * a2_d4);
  a2wL.pa.a2_paset(0.03 * a * a2_d5); a2wR.pa.a2_paset(0.03 * a * a2_d5);
  a2wL.pa.sbase = a2wR.pa.sbase = 1 + 0.015 * a * a2_d6 * a2_lerp(1, 0.4, a2_ww);
);
function a2_prein() (
  a2_wp = RP_ST[25] >= 0.5;
  a2_pmodel(); a2pL.a2_preclr(); a2pR.a2_preclr(); a2lL.a2_linclr(); a2lR.a2_linclr();
  a2_tone(1); a2_lts = -1; a2_tone(1);
  a2_pbias();
  a2_gs = RP_ST[26]; a2_gpt = a2_pot(a2_gs / 10); a2_gp = a2_gpt; a2_sbt = RP_ST[31] / 100; a2_sb = a2_sbt;
  a2fL.clp_pf_cfg(40000, 14000, -1.5, 100); a2fL.clp_pf_reset(); a2fR.clp_pf_cfg(40000, 14000, -1.5, 100); a2fR.clp_pf_reset();
  a2fL.clp_pf_block(a2_gs / 10, srate, samplesblock); a2fR.clp_pf_block(a2_gs / 10, srate, samplesblock);
  a2kL.rp_sbqset(5, 0.23875 * srate, 0.608, 1.071, srate); a2kR.rp_sbqset(5, 0.23875 * srate, 0.608, 1.071, srate);   // the post-shelf
  a2kL.rp_sbqclr(); a2kR.rp_sbqclr();
  a2s1L.rp_sbqset(0, 90, 0, 0.7071, srate); a2s2L.rp_sbqset(0, 90, 0, 0.7071, srate);   // the SUB crossover (LR4)
  a2s3L.rp_sbqset(0, 90, 0, 0.7071, srate); a2s4L.rp_sbqset(0, 90, 0, 0.7071, srate);
  a2s1R.rp_sbqset(0, 90, 0, 0.7071, srate); a2s2R.rp_sbqset(0, 90, 0, 0.7071, srate);
  a2s3R.rp_sbqset(0, 90, 0, 0.7071, srate); a2s4R.rp_sbqset(0, 90, 0, 0.7071, srate);
  a2s1L.rp_sbqclr(); a2s2L.rp_sbqclr(); a2s3L.rp_sbqclr(); a2s4L.rp_sbqclr();
  a2s1R.rp_sbqclr(); a2s2R.rp_sbqclr(); a2s3R.rp_sbqclr(); a2s4R.rp_sbqclr();
  a2_msyL = a2_mslL = a2_msyR = a2_mslR = 0; a2_gL = a2_gR = 1;
  a2loL.rp_sbqclr(); a2loR.rp_sbqclr(); a2_lgs = -1;
);
function a2_powin() (
  a2_ww = RP_ST[49] >= 0.5;
  a2_wmodel(); a2wL.a2_powclr(); a2wR.a2_powclr();
  a2_wbias();
  a2_mpt = a2_pot(RP_ST[50] / 10) * 0.08; a2_mp = a2_mpt;
);
function a2_preblk() (
  a2_tone(0);
  a2_pbias();
  a2_gs += (RP_ST[26] - a2_gs) * a2_wk; abs(RP_ST[26] - a2_gs) < 0.0005 ? a2_gs = RP_ST[26];
  a2_gpt = a2_pot(a2_gs / 10); a2_sbt = RP_ST[31] / 100;
  a2fL.clp_pf_block(a2_gs / 10, srate, samplesblock); a2fR.clp_pf_block(a2_gs / 10, srate, samplesblock);
  a2_gs !== a2_lgs ? ( a2_lgs = a2_gs; a2_lk = 2.5 * (a2_gs / 10) ^ 1.5;
    a2loL.rp_sbqset(5, 9000, a2_lk, 0.7, srate); a2loR.rp_sbqset(5, 9000, a2_lk, 0.7, srate); );
);
function a2_powblk() ( a2_wbias(); a2_mpt = a2_pot(RP_ST[50] / 10) * 0.08; );

// ================================================================ 5F6 (gfx-5f6)
function f6_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function f6_thd(x) local(q) ( abs(x) >= 3 ? 0 : ( q = 27 + 9 * x * x; ((27 + 3 * x * x) * q - 18 * x * x * (27 + x * x)) / (q * q); ); );
function f6_tg(u) ( u >= 0 ? f6_th(u) : 1.8 * f6_th(u * 0.5555556) );
function f6_tgd(u) ( u >= 0 ? f6_thd(u) : f6_thd(u * 0.5555556) );
function f6_F(x) local(a) ( a = abs(x); a < 3 ? x * x * 0.0555555556 + 1.3333333333 * log(1 + x * x * 0.3333333333) : 2.3483924 + a - 3; );
function f6_tgF(u) ( u >= 0 ? f6_F(u) : 3.24 * f6_F(u * 0.5555556) );
function f6_stset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = f6_tgF(u1); b0 = b; g0 = f6_tg(b); n0 = 1 / max(f6_tgd(b), 0.05); );
function f6_strun(x) instance(b0, g0, n0, u1, ga1) local(u, ga, d, y) (
  u = x + b0; ga = f6_tgF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : f6_tg(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
function f6_stclr() instance(b0, g0, n0, u1, ga1) ( b0 = g0 = u1 = ga1 = 0; n0 = 1; );
function f6_syset(b) instance(b0, g0, n0, u1, ga1) ( u1 += b - b0; ga1 = f6_F(u1); b0 = b; g0 = f6_th(b); n0 = 1 / max(f6_thd(b), 0.05); );
function f6_syrun(x) instance(b0, g0, n0, u1, ga1) local(u, ga, d, y) (
  u = x + b0; ga = f6_F(u); d = u - u1;
  y = abs(d) > 0.00001 ? (ga - ga1) / d : f6_th(0.5 * (u + u1));
  u1 = u; ga1 = ga;
  (y - g0) * n0 + rp_dn;
);
function f6_1run(x) instance(b0, b1, a1, x1, y1) local(y) ( y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y; );
function f6_1clr() instance(x1, y1) ( x1 = y1 = 0; );
function f6_shset(fz, F, fs) instance(b0, b1, a1) local(c, wz, wp) (
  c = 2 * fs; wz = 2 * $pi * fz; wp = wz * F;
  b0 = (c + wz) / (c + wp); b1 = (wz - c) / (c + wp); a1 = (wp - c) / (c + wp);
);
function f6_hpset(f, fs) instance(b0, b1, a1) local(c, w) (
  c = 2 * fs; w = 2 * $pi * f;
  b0 = c / (c + w); b1 = -b0; a1 = (w - c) / (c + w);
);
// the channel VOLUME pots (1 M, audio taper); BRIGHT: a cap across the pot (coefficients shared, state per side)
function f6_volset(p, cap, fs) local(fr, Ra, Rb, tp, c, w) (
  fr = 0.01 + 0.99 * (10 ^ (2 * p) - 1) / 99;
  Rb = fr * 1000000; Ra = (1 - fr) * 1000000;
  f6_vk = fr; f6_vkb = 1 - fr;
  tp = max(Ra * Rb / (Ra + Rb + 1) * cap, 0.0000000001);
  c = 2 * fs; w = 1 / tp;
  f6_vhb0 = c / (c + w); f6_vha1 = (w - c) / (c + w);
);
function f6_volrun(x) instance(x1, y1) local(h) (
  h = f6_vhb0 * (x - x1) - f6_vha1 * y1; x1 = x; y1 = h;
  f6_vk * x + f6_vkb * h;
);
// the passive tone stack (third order, from the part values; coefficients shared)
function f6_tsset(t, m, l, C1, C2, C3, R1, R2, R3, R4, fs)
  local(nb1, nb2, nb3, da0, da1, da2, da3, c, cc2, cc3, k0, k1, k2, k3, q) (
  m = exp((m - 1) * 3.4); l = exp((l - 1) * 3.4);
  nb1 = t*C1*R1 + m*C3*R3 + l*(C1*R2 + C2*R2) + (C1*R3 + C2*R3);
  nb2 = t*(C1*C2*R1*R4 + C1*C3*R1*R4) - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + m*(C1*C3*R1*R3 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R1*R2 + C1*C2*R2*R4 + C1*C3*R2*R4)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     + (C1*C2*R1*R3 + C1*C2*R3*R4 + C1*C3*R3*R4);
  nb3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + t*C1*C2*C3*R1*R3*R4 - t*m*C1*C2*C3*R1*R3*R4
     + t*l*C1*C2*C3*R1*R2*R4;
  da0 = 1;
  da1 = (C1*R1 + C1*R3 + C2*R3 + C2*R4 + C3*R4) + m*C3*R3 + l*(C1*R2 + C2*R2);
  da2 = m*(C1*C3*R1*R3 - C2*C3*R3*R4 + C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*m*(C1*C3*R2*R3 + C2*C3*R2*R3)
     - m*m*(C1*C3*R3*R3 + C2*C3*R3*R3)
     + l*(C1*C2*R2*R4 + C1*C2*R1*R2 + C1*C3*R2*R4 + C2*C3*R2*R4)
     + (C1*C2*R1*R4 + C1*C3*R1*R4 + C1*C2*R3*R4 + C1*C2*R1*R3 + C1*C3*R3*R4 + C2*C3*R3*R4);
  da3 = l*m*(C1*C2*C3*R1*R2*R3 + C1*C2*C3*R2*R3*R4)
     - m*m*(C1*C2*C3*R1*R3*R3 + C1*C2*C3*R3*R3*R4)
     + m*(C1*C2*C3*R3*R3*R4 + C1*C2*C3*R1*R3*R3 - C1*C2*C3*R1*R3*R4)
     + l*C1*C2*C3*R1*R2*R4
     + C1*C2*C3*R1*R3*R4;
  c = 2 * fs; cc2 = c * c; cc3 = cc2 * c;
  k0 = -da0 - da1*c - da2*cc2 - da3*cc3;
  k1 = -3*da0 - da1*c + da2*cc2 + 3*da3*cc3;
  k2 = -3*da0 + da1*c + da2*cc2 - 3*da3*cc3;
  k3 = -da0 + da1*c - da2*cc2 + da3*cc3;
  q = 1 / k0;
  f6_tb0 = (-nb1*c - nb2*cc2 - nb3*cc3) * q;
  f6_tb1 = (-nb1*c + nb2*cc2 + 3*nb3*cc3) * q;
  f6_tb2 = (nb1*c + nb2*cc2 - 3*nb3*cc3) * q;
  f6_tb3 = (nb1*c - nb2*cc2 + nb3*cc3) * q;
  f6_ta1 = k1 * q; f6_ta2 = k2 * q; f6_ta3 = k3 * q;
);
function f6_tsrun(x) instance(x1, x2, x3, y1, y2, y3) local(y) (
  y = f6_tb0 * x + f6_tb1 * x1 + f6_tb2 * x2 + f6_tb3 * x3 - f6_ta1 * y1 - f6_ta2 * y2 - f6_ta3 * y3;
  x3 = x2; x2 = x1; x1 = x; y3 = y2; y2 = y1; y1 = y;
  y;
);
function f6_tsclr() instance(x1, x2, x3, y1, y2, y3) ( x1 = x2 = x3 = y1 = y2 = y3 = 0; );
// the power stage: two valves in push-pull (class AB) inside the feedback loop, solved by Newton, anti-aliased
function f6_pa(u) instance(yn, yp, h1, env, sh, sup, sbase, pd, pp0, v1) local(un, o, c, v, ta, tb, g, k, y, a, z, aa, d, z1, az1, y1) (
  un = u / sup;
  o = f6_pga * f6_pB * f6_pp * (-f6_phb0 * yp - f6_pha1 * h1);
  c = f6_pc0 + sh;
  k = f6_pga * f6_pBe;
  loop(3,
    v = f6_pga * un - k * yn + o; ta = v - c + pd; tb = v + c + pd;
    g = yn - 0.5 * (f6_th(ta) + f6_th(tb)) + pp0;
    yn -= g / (1 + k * 0.5 * (f6_thd(ta) + f6_thd(tb)));
  );
  z = f6_pga * un + o; v = z - k * yn;
  aa = 0.5 * (f6_F(v - c + pd) + f6_F(v + c + pd)) - pp0 * v + 0.5 * k * yn * yn;
  y1 = 0.5 * (f6_th(v1 - c + pd) + f6_th(v1 + c + pd)) - pp0; z1 = v1 + k * y1;
  az1 = 0.5 * (f6_F(v1 - c + pd) + f6_F(v1 + c + pd)) - pp0 * v1 + 0.5 * k * y1 * y1;
  d = z - z1; y = abs(d) > 0.00001 ? (aa - az1) / d : 0.5 * (yn + y1);
  v1 = v;
  h1 = f6_phb0 * (yn - yp) - f6_pha1 * h1; yp = yn;
  // grid current charges the coupling caps: the bias runs colder for a moment, then recovers
  a = max(abs(v) - 2.5, 0) * f6_bsk;
  sh += (min(a, 0.45) - sh) * (a > sh ? f6_bsa : f6_bsr);
  y *= sup;
  a = abs(y);
  env += (a - env) * (a > env ? f6_sga : f6_sgr);
  sup = sbase * (1 - f6_sgk * min(max(env - f6_sge, 0) / (1 - f6_sge), 1));
  y;
);
function f6_ot(x) instance(ph, sp) local(s, y) (
  ph = ph * f6_xlk + x * f6_xc; s = f6_th(ph * f6_xk) / f6_xk; y = (s - sp * f6_xlk) / f6_xc; sp = s; y;
);
// ---- 5F6 preamp, one side (fpL / fpR): the first valve, the VOLUME pots and BLEND, the second stage, the cathode
// follower into the tone stack
function f6_pre(x) instance(cs1, v1, hc1, vb, cs2, v2, cf, ts) local(u, n, m, w) (
  u = cs1.f6_1run(x * f6_kin + rp_dn);
  u = -f6_g1 * v1.f6_strun(u);
  u = hc1.f6_1run(u);                                       // coupling cap into the volume pots
  n = vb.f6_volrun(u);                                      // BRIGHT channel
  m = (n * f6_gb + u * f6_vk * f6_gn) * f6_pad;             // + NORMAL, through the mixing resistors
  w = -f6_g2 * v2.f6_strun(cs2.f6_1run(m));                 // the second stage
  w = cf.clp_run(w);                                        // the cathode follower's grid current (a knee)
  ts.f6_tsrun(w);                                           // the tone stack
);
function f6_preclr() instance(cs1, v1, hc1, vb, cs2, v2, cf, ts) (
  cs1.f6_1clr(); hc1.f6_1clr(); cs2.f6_1clr(); vb.x1 = vb.y1 = 0; ts.f6_tsclr(); cf.clp_reset();
  v1.f6_stclr(); v2.f6_stclr();
  hc1.f6_hpset(8, rp_fs);
  cf.clp_kt_cfg(0.5, 1); cf.kti = 0;
);
// ---- 5F6 power amp, one side (fwL / fwR): the phase inverter (MASTER ahead of it), the coupling caps, the power
// valves in their loop, the transformer
function f6_pow(x) instance(pin, hpp, pw, hdc, ot) local(w) (
  w = pin.f6_syrun((x * f6_kpi) * f6_pmv);
  w = hpp.f6_1run(w);
  w = pw.f6_pa(w);
  w = hdc.f6_1run(w);                                       // (the push-pull primary carries no DC)
  ot.f6_ot(w) * f6_wk;
);
function f6_powclr() instance(pin, hpp, pw, hdc, ot) (
  pin.f6_stclr(); hpp.f6_1clr(); hdc.f6_1clr(); ot.ph = ot.sp = 0;
  pw.yn = pw.yp = pw.h1 = pw.env = pw.sh = pw.v1 = 0; pw.sup = pw.sbase = 1; pw.pd = 0;
  hpp.f6_hpset(7, rp_fs); hdc.f6_hpset(4, rp_fs);
);
// the speaker load (low feedback lets the speaker's impedance through; host rate, with the power amp)
function f6_ldset() instance(r1, r2) (
  r1.rp_sbqset(3, 95, f6_lr, 1.3, srate);
  r2.rp_sbqset(5, 2600, f6_lh, 0.6, srate);
);
function f6_ldrun(x) instance(r1, r2) ( r2.rp_sbq(r1.rp_sbq(x)); );
// the cabinet: four 10" in an open back, one mic (the two sides' mics a hair apart)
function f6_cabset(m, k) instance(c1, c2, c3, c4, c5, c6, c7, c8) local(lp) (
  m = min(max(m, 0), 1);
  c1.rp_sbqset(1, 72 * k, 0, 0.75, srate);
  c2.rp_sbqset(3, 108 * k, 2.5, 1.3, srate);
  c3.rp_sbqset(3, 430 * k, -2.5, 1.0, srate);
  c4.rp_sbqset(3, 1650 * k, 2.5, 1.1, srate);
  c5.rp_sbqset(3, 3300 * k, 4.5 * (1 - m), 2.0, srate);
  lp = (5800 - 2100 * m) * k;
  c6.rp_sbqset(0, lp, 0, 0.5412, srate); c7.rp_sbqset(0, lp, 0, 1.3066, srate);
  c8.rp_sbqset(3, 7200 * k, -9 * m, 3, srate);
);
function f6_cabrun(x) instance(c1, c2, c3, c4, c5, c6, c7, c8) (
  c8.rp_sbq(c7.rp_sbq(c6.rp_sbq(c5.rp_sbq(c4.rp_sbq(c3.rp_sbq(c2.rp_sbq(c1.rp_sbq(x))))))));
);
// the makeup: every VOLUME level-matched per model, and BLEND towards NORMAL / BRIGHT (dB)
function f6_tables() local(p) (
  F6_MKTAB = rp_alloc(32); F6_BTAB = rp_alloc(32);
  p = F6_MKTAB;
  p[0] = 13.48; p[1] = 9.60; p[2] = 6.29; p[3] = 3.17; p[4] = 1.11; p[5] = 0.13; p[6] = -0.68; p[7] = -0.95; p[8] = -0.88; p[9] = -0.89; p[10] = -0.65;
  p = F6_MKTAB + 11;
  p[0] = 19.30; p[1] = 15.30; p[2] = 11.69; p[3] = 7.93; p[4] = 4.73; p[5] = 2.39; p[6] = 0.49; p[7] = -0.65; p[8] = -1.28; p[9] = -1.59; p[10] = -1.60;
  F6_BTAB[0] = 13.21; F6_BTAB[1] = 12.49; F6_BTAB[2] = 10.06; F6_BTAB[3] = 5.03; F6_BTAB[4] = 2.10; F6_BTAB[5] = 0.75;
  F6_BTAB[6] = 15.20; F6_BTAB[7] = 14.86; F6_BTAB[8] = 13.86; F6_BTAB[9] = 10.17; F6_BTAB[10] = 5.04; F6_BTAB[11] = 1.39;
  F6_BTAB[12] = 0.72; F6_BTAB[13] = 0.63; F6_BTAB[14] = 0.36; F6_BTAB[15] = -0.37; F6_BTAB[16] = 0.03; F6_BTAB[17] = 0.75;
  F6_BTAB[18] = 0.49; F6_BTAB[19] = 0.54; F6_BTAB[20] = 0.80; F6_BTAB[21] = 0.71; F6_BTAB[22] = 1.07; F6_BTAB[23] = 1.39;
);
function f6_bmk(mm, v, b) local(p, i, f, x, y, u, w) (
  p = min(max(v, 0), 10) / 2; i = min(floor(p), 4); f = p - i;
  x = F6_BTAB[i] * (1 - f) + F6_BTAB[i + 1] * f;
  y = F6_BTAB[6 + i] * (1 - f) + F6_BTAB[7 + i] * f;
  u = F6_BTAB[12 + i] * (1 - f) + F6_BTAB[13 + i] * f;
  w = F6_BTAB[18 + i] * (1 - f) + F6_BTAB[19 + i] * f;
  (x + (y - x) * mm) * max(1 - 2 * b, 0) ^ 1.75 + (u + (w - u) * mm) * max(2 * b - 1, 0) ^ 1.75;
);
function f6_mk(mm, v) local(p, i, f, a, b) (
  p = min(max(v, 0), 10); i = min(floor(p), 9); f = p - i;
  a = F6_MKTAB[i] * (1 - f) + F6_MKTAB[i + 1] * f;
  b = F6_MKTAB[11 + i] * (1 - f) + F6_MKTAB[12 + i] * f;
  a + (b - a) * mm;
);
f6_kin = 1 / 1.3;
function f6_lerp(a, b, m) ( a + (b - a) * m; );
function f6_glerp(a, b, m) ( a * (b / a) ^ m; );
// the preamp's model and knobs glide (per block); everything they move is recomputed from the glided values
function f6_ptone(force) local(k, km, ch, b, m) (
  k = force ? 1 : f6_tk; km = force ? 1 : f6_mk_;
  f6_mt = RP_ST[32] >= 0.5;
  f6_mm1 += (f6_mt - f6_mm1) * km; f6_mm += (f6_mm1 - f6_mm) * km;
  abs(f6_mt - f6_mm) < 0.0005 && abs(f6_mt - f6_mm1) < 0.0005 ? f6_mm = f6_mm1 = f6_mt;
  f6_s2 += (RP_ST[33] - f6_s2) * k; f6_s3 += (RP_ST[34] - f6_s3) * k; f6_s4 += (RP_ST[35] - f6_s4) * k;
  f6_s5 += (RP_ST[36] - f6_s5) * k; f6_s6 += (RP_ST[37] - f6_s6) * k;
  ch = f6_mm + 2 * f6_s2 + 3 * f6_s3 + 5 * f6_s4 + 7 * f6_s5 + 11 * f6_s6;
  force || abs(ch - f6_lts) > 0.00001 ? (
    f6_lts = ch; m = f6_mm;
    f6_g1 = f6_lerp(30, 52, m);
    f6_pad = f6_lerp(0.5, 0.25, m);
    f6_g2 = 45;
    f6_kc = f6_lerp(22, 60, m);
    fpL.cs1.f6_shset(f6_lerp(0.8, 4.2, m), 1.9, rp_fs); fpR.cs1.f6_shset(f6_lerp(0.8, 4.2, m), 1.9, rp_fs);
    fpL.cs2.f6_shset(7.8, 1.9, rp_fs); fpR.cs2.f6_shset(7.8, 1.9, rp_fs);
    f6_volset(f6_s2 / 10, 0.00000000025, rp_fs);
    f6_tsset(f6_s4 / 10, f6_s5 / 10, f6_s6 / 10, 0.00000000025, f6_glerp(0.00000002, 0.0000001, m), f6_glerp(0.00000002, 0.000000047, m),
             250000, f6_glerp(1000000, 250000, m), f6_glerp(25000, 10000, m), f6_glerp(56000, 100000, m), rp_fs);
    b = f6_s3 / 100; f6_gb = min(2 * b, 1); f6_gn = min(2 * (1 - b), 1);
    f6_mkdb = f6_mk(m, f6_s2) + f6_bmk(m, f6_s2, b);
  );
);
// ... and the power amp's (PRESENCE, MASTER, the model)
function f6_wtone(force) local(k, km, ch, m) (
  k = force ? 1 : f6_tk; km = force ? 1 : f6_mk_;
  f6_wt = RP_ST[51] >= 0.5;
  f6_mw1 += (f6_wt - f6_mw1) * km; f6_mw += (f6_mw1 - f6_mw) * km;
  abs(f6_wt - f6_mw) < 0.0005 && abs(f6_wt - f6_mw1) < 0.0005 ? f6_mw = f6_mw1 = f6_wt;
  f6_s7 += (RP_ST[52] - f6_s7) * k; f6_s8 += (RP_ST[53] - f6_s8) * k;
  ch = f6_mw + 13 * f6_s7 + 17 * f6_s8;
  force || abs(ch - f6_lws) > 0.00001 ? (
    f6_lws = ch; m = f6_mw;
    f6_kpi = 0.06;
    f6_pga = f6_lerp(6, 8, m); f6_pB = f6_lerp(0.22, 0.42, m);
    f6_pp = 0.9 * (f6_s7 / 10) ^ 1.2 * f6_lerp(1, 0.85, m);
    f6_pBe = f6_pB * (1 - f6_pp * f6_phb0);
    f6_pc0 = f6_lerp(0.28, 0.2, m);
    f6_bsk = f6_lerp(0.25, 0.1, m); f6_bsr = 1 - exp(-1 / (f6_lerp(0.09, 0.04, m) * rp_fs));
    f6_sgk = f6_lerp(0.28, 0.08, m); f6_sge = f6_lerp(0.3, 0.55, m);
    f6_sga = 1 - exp(-1 / (f6_lerp(0.012, 0.006, m) * rp_fs)); f6_sgr = 1 - exp(-1 / (f6_lerp(0.22, 0.12, m) * rp_fs));
    f6_xc = 2 * $pi * f6_lerp(55, 32, m) / rp_fs; f6_xlk = 1 - 2 * $pi * 5 / rp_fs; f6_xk = f6_lerp(0.95, 0.5, m);
    f6_lr = f6_lerp(3.5, 1.2, m); f6_lh = f6_lerp(3, 1, m);
    ldL.f6_ldset(); ldR.f6_ldset();
    f6_pmv = 10 ^ ((f6_s8 - 5) * 2.4 / 20);                 // MASTER (new): +/- 12 dB into the phase inverter, 5 = the original
    f6_wk = 0.125 / f6_pmv ^ 0.55;
  );
);
// DRIFT: each side's valves wander on their own
function f6_pbias(w1, w2) instance(v1, v2) local(a) (
  a = dm_a * f6_lerp(1, 0.75, f6_mm);
  v1.f6_stset(-0.30 + 0.05 * a * w1); v2.f6_stset(-0.25 + 0.05 * a * w2);
);
function f6_wbias(w3, w4) instance(pin, pw) local(a) (
  a = dm_a * f6_lerp(1, 0.75, f6_mw);
  pin.f6_syset(0.04 + 0.03 * a * w3);
  pw.pd = 0.03 * a * w4;
  pw.pp0 = 0.5 * (f6_th(pw.pd - f6_pc0) + f6_th(pw.pd + f6_pc0));
  pw.sbase = 1 + f6_lerp(0.016, 0.008, f6_mw) * a * w3;
);
function f6_pdrift() local(i) (
  i = 0.2 * dm_s * samplesblock / srate;
  fpL.f6_pbias(f6D1.drift_tick(i), f6D2.drift_tick(i)); fpR.f6_pbias(f6D5.drift_tick(i), f6D6.drift_tick(i));
);
function f6_wdrift() local(i) (
  i = 0.2 * dm_s * samplesblock / srate;
  fwL.f6_wbias(f6D3.drift_tick(i), f6D4.drift_tick(i)); fwR.f6_wbias(f6D7.drift_tick(i), f6D8.drift_tick(i));
);
// per block: the follower's knee (it widens as VOLUME rises) and the pre-filter
function f6_cblk() instance(pf, cf) local(k) (
  k = cf.clp_kt_block(f6_s2 / 10, srate, samplesblock);
  cf.clp_set(2, f6_kc, 100000, 0); cf.clp_knee(k * f6_kc);
  pf.clp_pf_block(f6_s2 / 10, srate, samplesblock);
  cf.clp_tidy();
);
function f6_prein() (
  fpL.f6_preclr(); fpR.f6_preclr();
  f6_lts = -1; f6_ptone(1);
  fpL.pf.clp_pf_cfg(40000, 9000, -1.5, 150); fpL.pf.clp_pf_reset(); fpR.pf.clp_pf_cfg(40000, 9000, -1.5, 150); fpR.pf.clp_pf_reset();
  f6_pdrift();
  f6k1L.rp_sbqset(3, 0.2470 * srate, 11.58, 1.13, srate); f6k1R.rp_sbqset(3, 0.2470 * srate, 11.58, 1.13, srate);   // the post-shelf (1x)
  f6k2L.rp_sbqset(5, 0.1506 * srate, 3.98, 0.57, srate); f6k2R.rp_sbqset(5, 0.1506 * srate, 3.98, 0.57, srate);
  f6k1L.rp_sbqclr(); f6k1R.rp_sbqclr(); f6k2L.rp_sbqclr(); f6k2R.rp_sbqclr();
);
function f6_powin() (
  f6_phb0 = 2 * rp_fs / (2 * rp_fs + 2 * $pi * 2000); f6_pha1 = (2 * $pi * 2000 - 2 * rp_fs) / (2 * rp_fs + 2 * $pi * 2000);
  f6_bsa = 1 - exp(-1 / (0.002 * rp_fs));
  fwL.f6_powclr(); fwR.f6_powclr();
  f6_lws = -1; f6_wtone(1);
  f6_wdrift();
  ldL.r1.rp_sbqclr(); ldL.r2.rp_sbqclr(); ldR.r1.rp_sbqclr(); ldR.r2.rp_sbqclr();
);

// ================================================================ SB-80 (new: in the spirit of the 80s British solid-state bass amps)
// ---- SB-80 preamp, one side (sbpL / sbpR): GAIN into a transistor stage (soft, a touch asymmetric), the COMPRESSOR,
// the PRE-SHAPE (a low lift, the deep mid scoop, a top lift) and the seven-band GRAPHIC
function sb_pre(x) instance(hp, v, env, ps1, ps2, ps3, q1, q2, q3, q4, q5, q6, q7) local(y, a) (
  y = hp.am_run(x);
  y = v.ah_tube(y * sb_g) * sb_c;                           // the input stage (bias 0.12)
  sb_cmp ? (                                                // the compressor: a fast peak sensor, ratio and threshold from COMP
    a = abs(y); env += (a - env) * (a > env ? sb_ca : sb_cr);
    env > sb_th ? y *= exp(sb_cs * log(env / sb_th));
    y *= sb_cm;
  );
  y = ps3.am_run(ps2.am_run(ps1.am_run(y)));
  y = q7.am_run(q6.am_run(q5.am_run(q4.am_run(q3.am_run(q2.am_run(q1.am_run(y)))))));
  y;
);
function sb_preclr() instance(hp, v, env, ps1, ps2, ps3, q1, q2, q3, q4, q5, q6, q7) (
  hp.rp_bqclr(); ps1.rp_bqclr(); ps2.rp_bqclr(); ps3.rp_bqclr();
  q1.rp_bqclr(); q2.rp_bqclr(); q3.rp_bqclr(); q4.rp_bqclr(); q5.rp_bqclr(); q6.rp_bqclr(); q7.rp_bqclr();
  v.ah_tzero(); v.ah_tset(0.12); env = 0;
  hp.am_bq(1, 30, 0.7, 0, rp_fs);
);
function sb_preset() instance(ps1, ps2, ps3, q1, q2, q3, q4, q5, q6, q7) (
  ps1.am_bq(4, 60, 0.7, 3 * sb_psa, rp_fs);
  ps2.am_bq(2, 550, 0.6, -10 * sb_psa, rp_fs);
  ps3.am_bq(3, 3500, 0.7, 5 * sb_psa, rp_fs);
  q1.am_bq(2, 50, 1.4, sb_e1, rp_fs); q2.am_bq(2, 100, 1.4, sb_e2, rp_fs); q3.am_bq(2, 200, 1.4, sb_e3, rp_fs);
  q4.am_bq(2, 400, 1.4, sb_e4, rp_fs); q5.am_bq(2, 800, 1.4, sb_e5, rp_fs); q6.am_bq(2, 1600, 1.4, sb_e6, rp_fs);
  q7.am_bq(2, 3200, 1.4, sb_e7, rp_fs);
);
function sb_gset() ( sb_g = 10 ^ ((sb_gs * 3.6 - 12) / 20); sb_c = 1 / sqrt(sb_g); );   // -12 .. +24 dB into the stage
function sb_preblk(force) local(k, c, ch) (
  k = force ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
  sb_gs += (RP_ST[38] - sb_gs) * k; abs(sb_gs - RP_ST[38]) < 0.0005 ? sb_gs = RP_ST[38]; sb_gset();
  sb_psa += ((RP_ST[39] >= 0.5) - sb_psa) * k; abs(sb_psa - (RP_ST[39] >= 0.5)) < 0.0005 ? sb_psa = RP_ST[39] >= 0.5;
  sb_e1 += (RP_ST[41] - sb_e1) * k; sb_e2 += (RP_ST[42] - sb_e2) * k; sb_e3 += (RP_ST[43] - sb_e3) * k;
  sb_e4 += (RP_ST[44] - sb_e4) * k; sb_e5 += (RP_ST[45] - sb_e5) * k; sb_e6 += (RP_ST[46] - sb_e6) * k;
  sb_e7 += (RP_ST[47] - sb_e7) * k;
  ch = sb_psa + 2 * sb_e1 + 3 * sb_e2 + 5 * sb_e3 + 7 * sb_e4 + 11 * sb_e5 + 13 * sb_e6 + 17 * sb_e7;
  force || abs(ch - sb_lch) > 0.00001 ? ( sb_lch = ch; sbpL.sb_preset(); sbpR.sb_preset(); );
  // COMP 0 .. 10: the threshold falls from -8 to -26 dB (of the stage's full swing), the ratio rises to 8:1
  sb_cv += (RP_ST[40] - sb_cv) * k; abs(sb_cv - RP_ST[40]) < 0.0005 ? sb_cv = RP_ST[40];
  c = sb_cv / 10; sb_cmp = c > 0.0005;
  sb_th = 10 ^ ((-8 - 18 * c) / 20); sb_cs = 1 / (1 + 7 * c) - 1; sb_cm = 10 ^ (9 * c / 20);
);
function sb_prein() (
  sb_ca = 1 - exp(-1 / (0.002 * rp_fs)); sb_cr = 1 - exp(-1 / (0.15 * rp_fs));
  sbpL.sb_preclr(); sbpR.sb_preclr(); sb_preblk(1);
);
// ---- SB-80 power amp, one side (sbwL / sbwR): MASTER into a big clean solid-state stage that rounds off at its rails
// (a knee clipper, anti-aliased), on a supply shared by both sides that sags as you dig in
function sb_pow(x) instance(cl, pa) local(y) (
  y = sb_sup * cl.clp_run(x * sb_pm / sb_sup);
  pa = abs(y);
  y * sb_mk;
);
function sb_sag() local(a) (
  a = max(sbwL.pa, sbwR.pa);
  sb_sgenv += (a - sb_sgenv) * (a > sb_sgenv ? sb_sga : sb_sgr);
  sb_sup = sb_sbase * (1 - 0.15 * min(sb_sgenv, 1));
);
function sb_powupd() ( sb_pm = 10 ^ ((RP_ST[54] * 3 - 15) / 20); sb_mk = 0.88 / sb_pm ^ 0.6; );
function sb_powin() (
  sbwL.cl.clp_reset(); sbwR.cl.clp_reset(); sbwL.cl.clp_set(2, 1, 1, 0); sbwR.cl.clp_set(2, 1, 1, 0);
  sbwL.cl.clp_knee(0.35); sbwR.cl.clp_knee(0.35); sbwL.pa = sbwR.pa = 0;
  sb_sga = 1 - exp(-1 / (0.008 * rp_fs)); sb_sgr = 1 - exp(-1 / (0.25 * rp_fs));
  sb_sgenv = 0; sb_sup = sb_sbase = 1; sb_powupd();
);
// DRIFT (Supply and speaker, JG): the supply breathes; the speakers loosen as they warm (see sb_cabset)
function sb_wdrift() ( sb_sbase = 1 + 0.03 * dm_a * sbD1.drift_tick(0.2 * dm_s * samplesblock / srate); sb_sup = sb_sup; );
// the SB-80 cabinets: 6 = 4x10 sealed (tight, a bright cone), 7 = 1x15 (deep, round); warmth h (0 .. 1) lowers the
// cones' resonance and softens their edge
function sb_cabset(type, mic, h) instance(f1, f2, f3, f4, f5, f6, f7, f8) local(m, lp, r) (
  m = mic / 10; r = 1 - 0.08 * h;
  type == 6 ? (
    f1.rp_sbqset(1, 50 * r, 0, 0.9, srate);
    f2.rp_sbqset(3, 105 * r, 2.5 + 0.8 * h, 1.1, srate);
    f3.rp_sbqset(3, 450, -2, 1.0, srate);
    f4.rp_sbqset(3, 1800, 2.5 - 0.6 * h, 1.2, srate);
    f5.rp_sbqset(3, 3800, 3.5 * (1 - m) - 1.5 * m - h, 1.6, srate);
    lp = 6200 - 2000 * m; f8.rp_sbqset(3, 7800, -9 * m, 3, srate);
  ) : (
    f1.rp_sbqset(1, 40 * r, 0, 1.1, srate);
    f2.rp_sbqset(3, 70 * r, 3 + 0.8 * h, 1.3, srate);
    f3.rp_sbqset(3, 350, -3, 1.0, srate);
    f4.rp_sbqset(3, 900, 2 - 0.5 * h, 1.2, srate);
    f5.rp_sbqset(3, 2200, 2 * (1 - m) - 1 * m - 0.6 * h, 2, srate);
    lp = 3800 - 1200 * m; f8.rp_sbqset(3, 5000, -10 * m, 3, srate);
  );
  f6.rp_sbqset(0, lp, 0, 0.5412, srate); f7.rp_sbqset(0, lp, 0, 1.3066, srate);
);
function sb_cabrun(x) instance(f1, f2, f3, f4, f5, f6, f7, f8) (
  f8.rp_sbq(f7.rp_sbq(f6.rp_sbq(f5.rp_sbq(f4.rp_sbq(f3.rp_sbq(f2.rp_sbq(f1.rp_sbq(x))))))));
);

// ================================================================ the chassis
// the level each preamp hands its own power amp (rp_nk), the level each power amp's own preamp gives it (rp_nkw = the
// same, the pieces come in matched pairs), and the level match of every mixed pair to the preamp's own amp (dB, row =
// preamp, column = power amp)
function rp_tables() (
  rp_nk = rp_alloc(4);                                  // (dBFS RMS on a bass line, every knob at its default)
  rp_nk[0] = 10 ^ (-17.58 / 20); rp_nk[1] = 10 ^ (18.45 / 20); rp_nk[2] = 10 ^ (17.35 / 20); rp_nk[3] = 10 ^ (-18.13 / 20);
  rp_zt = rp_alloc(16);                                 // (measured on a bass line, every knob at its default, the preamp's cabinet)
  rp_zt[0] = 0;     rp_zt[1] = -7.3;   rp_zt[2] = 2.67;  rp_zt[3] = 0.64;    // AMP HEAD pre into AMP HEAD / AD-200 / 5F6 / SB-80 power
  rp_zt[4] = 7.26;  rp_zt[5] = 0;      rp_zt[6] = 9.94;  rp_zt[7] = 7.86;    // AD-200
  rp_zt[8] = -1.63; rp_zt[9] = -9.16;  rp_zt[10] = 0;    rp_zt[11] = -1.16;  // 5F6
  rp_zt[12] = -0.58; rp_zt[13] = -7.84; rp_zt[14] = 2.25; rp_zt[15] = 0;     // SB-80
);
function rp_cabtype() ( rp_c == 2 ? 1 : rp_c == 3 ? 2 : 3; );
function rp_cabset() (
  rp_c == 1 ? ( abcL.am_cab_set(1, rp_micg); abcR.am_cab_set(1, rp_micg); ) :
  rp_c >= 2 && rp_c <= 4 ? ( a2cL.a2_cabset(rp_cabtype(), rp_micg); a2cR.a2_cabset(rp_cabtype(), rp_micg); ) :
  rp_c == 5 ? ( f6cL.f6_cabset(rp_micg / 10 - 0.015, 1); f6cR.f6_cabset(rp_micg / 10 + 0.015, 1.03); ) :
  rp_c >= 6 ? ( sbcL.sb_cabset(rp_c, rp_micg, sb_hw); sbcR.sb_cabset(rp_c, rp_micg, sb_hw); );
);
function rp_cabclr() (
  abcL.c1.rp_bqclr(); abcL.c2.rp_bqclr(); abcL.c3.rp_bqclr(); abcL.c4.rp_bqclr(); abcL.c5.rp_bqclr(); abcL.c6.rp_bqclr(); abcL.c7.rp_bqclr();
  abcR.c1.rp_bqclr(); abcR.c2.rp_bqclr(); abcR.c3.rp_bqclr(); abcR.c4.rp_bqclr(); abcR.c5.rp_bqclr(); abcR.c6.rp_bqclr(); abcR.c7.rp_bqclr();
  a2cL.a2_cabclr(); a2cR.a2_cabclr();
  f6cL.c1.rp_sbqclr(); f6cL.c2.rp_sbqclr(); f6cL.c3.rp_sbqclr(); f6cL.c4.rp_sbqclr(); f6cL.c5.rp_sbqclr(); f6cL.c6.rp_sbqclr(); f6cL.c7.rp_sbqclr(); f6cL.c8.rp_sbqclr();
  f6cR.c1.rp_sbqclr(); f6cR.c2.rp_sbqclr(); f6cR.c3.rp_sbqclr(); f6cR.c4.rp_sbqclr(); f6cR.c5.rp_sbqclr(); f6cR.c6.rp_sbqclr(); f6cR.c7.rp_sbqclr(); f6cR.c8.rp_sbqclr();
  sbcL.a2_cabclr(); sbcR.a2_cabclr();
);
// a piece coming in starts from a clean state (at the silent point of the duck)
function rp_prein(p) ( p == 0 ? ab_prein() : p == 1 ? a2_prein() : p == 2 ? f6_prein() : sb_prein(); );
function rp_powin(w) ( w == 0 ? ab_powin() : w == 1 ? a2_powin() : w == 2 ? f6_powin() : sb_powin(); );
// the settings (per block and from @slider)
function rp_update() (
  rp_tp = min(max(slider1 | 0, 0), 3); rp_tw = min(max(slider2 | 0, 0), 3); rp_tc = min(max(slider3 | 0, 0), 7);
  rp_tmono = slider6 >= 0.5;
  rp_dit = slider5 / 100;
  rp_gate = slider7;
  os_tf = os_f2n(slider8);
  in_setup(slider9, slider10 >= 0.5);
  drift_macro(slider11);
  rp_out = 10 ^ (slider12 / 20);
  ost_setup(slider13 / 100, slider14 / 100, slider15, slider16, slider17, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
);
// everything the pieces in use need per block
function rp_block() local(k) (
  // the mic glides (30 ms)
  k = 1 - exp(-samplesblock / (0.03 * srate));
  rp_micg += (slider4 - rp_micg) * k; abs(rp_micg - slider4) < 0.0001 ? rp_micg = slider4;
  // the preamp
  rp_p == 0 ? (
    ab_pdrift(); ab_preblk();
    rp_ptrim = -ab_trim(0, ab_gs);
    rp_c == 0 ? (
      rp_ptrim += ab_trim(4, ab_gs);
      ab_gs !== ab_lgs ? ( ab_lgs = ab_gs; abloL.ab_loset(); abloR.ab_loset(); );
    );
  ) : rp_p == 1 ? (
    a2_preblk();
    rp_ptrim = -(a2_mk(0, a2_gs) + (a2_mk(1, a2_gs) - a2_mk(0, a2_gs)) * a2_wp) + (rp_c == 0 ? 20 * log10(0.84) : 0);
  ) : rp_p == 2 ? (
    f6_ptone(0); f6_pdrift(); fpL.f6_cblk(); fpR.f6_cblk();
    rp_ptrim = f6_mkdb;
  ) : (
    sb_preblk(0);
    rp_ptrim = 0;
  );
  // the power amp
  rp_w == 0 ? (
    ab_wdrift(); ab_powupd();
    rp_wtrim = -0.5 * ab_trim(1, RP_ST[48]);
  ) : rp_w == 1 ? (
    a2_powblk();
    rp_wtrim = -(a2_mcd(0, RP_ST[50]) + (a2_mcd(1, RP_ST[50]) - a2_mcd(0, RP_ST[50])) * a2_ww + a2_mx(RP_ST[50], rp_p == 1 ? a2_gs : 4));
  ) : rp_w == 2 ? (
    f6_wtone(0); f6_wdrift();
    rp_wtrim = 0;
  ) : (
    sb_wdrift(); sb_powupd();
    rp_wtrim = 0;
  );
  // the cabinet: the mic (and the SB-80's warm speakers) recomputed when they move
  rp_c >= 6 ? ( sb_hw = min(sb_heat * dm_a, 1.5); abs(sb_hw - sb_lhw) > 0.002 ? ( sb_lhw = sb_hw; rp_lmic = -1; ); );
  rp_micg != rp_lmic ? ( rp_lmic = rp_micg; rp_cabset(); );
  // the pair's level
  rp_kin = rp_p == rp_w ? 1 : rp_nk[rp_w] / rp_nk[rp_p];
  rp_tg = 10 ^ ((rp_ptrim + rp_wtrim + rp_zt[rp_p * 4 + rp_w]) / 20);
);
// a piece change (or MONO IN, or a model): duck out, swap at the silent point, a short hold, back in
function rp_swap() (
  rp_mono = rp_tmono;
  rp_tp != rp_p ? ( rp_p = rp_tp; rp_prein(rp_p); );
  rp_tw != rp_w ? ( rp_w = rp_tw; rp_powin(rp_w); );
  rp_tc != rp_c ? ( rp_c = rp_tc; rp_lmic = -1; rp_cabclr(); ab_lgs = -1; );
  rp_p == 1 && a2_wp != (RP_ST[25] >= 0.5) ? ( a2_wp = RP_ST[25] >= 0.5; a2_pmodel(); a2_pbias(); );
  rp_w == 1 && a2_ww != (RP_ST[49] >= 0.5) ? ( a2_ww = RP_ST[49] >= 0.5; a2_wmodel(); a2_wbias(); );
  rp_block();
  rp_g = rp_tg;
);
// a preset: every piece starts afresh with its new settings (at the silent point of the duck)
function rp_swapall() (
  rp_mono = rp_tmono;
  rp_p = rp_tp; rp_prein(rp_p); rp_w = rp_tw; rp_powin(rp_w);
  rp_c = rp_tc; rp_lmic = -1; rp_cabclr(); ab_lgs = -1; rp_micg = slider4;
  rp_block();
  rp_g = rp_tg;
);
// everything that depends on the rate the amp runs at (the start, a new sample rate, the OS key)
function rp_rate() (
  rp_fs = srate * os_f;
  ab_gk = 1 - exp(-1 / (0.025 * srate));
  a2_sk = 1 - exp(-1 / (0.02 * srate)); a2_msk = 1 - exp(-1 / (0.06 * srate)); a2_wk = 1 - exp(-samplesblock / (0.03 * srate));
  f6_tk = 1 - exp(-64 / (0.03 * srate)); f6_mk_ = 1 - exp(-64 / (0.02 * srate));
  rp_prein(rp_p); rp_powin(rp_w);
  rp_lmic = -1; rp_cabclr(); ab_lgs = -1;
  uL.os_clr(); uR.os_clr(); dL.os_clr(); dR.os_clr();
  memset(rp_DRY, 0, 256); rp_dw = 0;
  rp_dhL.a2_hpset(25, srate); rp_dhR.a2_hpset(25, srate); rp_dhL.a2_1clr(); rp_dhR.a2_1clr();
  sb_heat = 0; sb_kh = 1 - exp(-1 / (4 * srate)); sb_kc = 1 - exp(-1 / (20 * srate));
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
function rp_start() (
  rp_sr = srate; rp_nm = 0;
  ost_init(rp_alloc(4096));
  ab_tables(); a2_tables(); f6_tables(); rp_tables();
  rp_DRY = rp_alloc(256);
  in_init();
  rp_update();
  os_f = os_tf;
  rp_p = rp_tp; rp_w = rp_tw; rp_c = rp_tc; rp_mono = rp_tmono; rp_micg = slider4; rp_di = rp_dit;
  rp_ogk = 1 - exp(-1 / (0.03 * srate));
  rp_rate();
  rp_block();
  rp_g = rp_tg; rp_os = rp_out;
  rp_dk = 1; rp_dst = 0; rp_dkr = 1 / (0.008 * srate);
  os_gsetup();
);

// ================================================================ the pieces' settings
// Every piece keeps its own settings in a store (RP_ST[n], n = the control's number below), saved with the project, so
// a piece swapped out and back comes back as it was. The host sees only the chosen preamp's and power amp's controls,
// through 10 + 3 generic sliders; rp_sync() keeps them and the store in step.
RP_ST = 4000000; RP_DF = 4000100;
RP_DF[18] = 4;    // AMP HEAD pre Gain
RP_DF[19] = 0;    // AMP HEAD pre Ultra lo
RP_DF[20] = 0;    // AMP HEAD pre Ultra hi
RP_DF[21] = 0;    // AMP HEAD pre Bass (dB)
RP_DF[22] = 0;    // AMP HEAD pre Midrange (dB)
RP_DF[23] = 1;    // AMP HEAD pre Midrange frequency (220, 450, 800, 1.6k, 3k)
RP_DF[24] = 0;    // AMP HEAD pre Treble (dB)
RP_DF[25] = 0;    // AD-200 pre Model (Crush, Deep)
RP_DF[26] = 4;    // AD-200 pre Gain
RP_DF[27] = 5;    // AD-200 pre Bass
RP_DF[28] = 5;    // AD-200 pre Middle
RP_DF[29] = 1;    // AD-200 pre Middle frequency (250, 500, 800, 1.5k)
RP_DF[30] = 5;    // AD-200 pre Treble
RP_DF[31] = 50;   // AD-200 pre Sub (%)
RP_DF[32] = 0;    // 5F6 pre Model (Tweed, Greybeard)
RP_DF[33] = 5;    // 5F6 pre Volume
RP_DF[34] = 50;   // 5F6 pre Blend (%)
RP_DF[35] = 6;    // 5F6 pre Treble
RP_DF[36] = 5;    // 5F6 pre Middle
RP_DF[37] = 5;    // 5F6 pre Bass
RP_DF[38] = 5;    // SB-80 pre Gain
RP_DF[39] = 0;    // SB-80 pre Pre-shape
RP_DF[40] = 0;    // SB-80 pre Compressor
RP_DF[41] = 0;    // SB-80 pre Graphic 50 Hz (dB)
RP_DF[42] = 0;    // SB-80 pre Graphic 100 Hz (dB)
RP_DF[43] = 0;    // SB-80 pre Graphic 200 Hz (dB)
RP_DF[44] = 0;    // SB-80 pre Graphic 400 Hz (dB)
RP_DF[45] = 0;    // SB-80 pre Graphic 800 Hz (dB)
RP_DF[46] = 0;    // SB-80 pre Graphic 1.6 kHz (dB)
RP_DF[47] = 0;    // SB-80 pre Graphic 3.2 kHz (dB)
RP_DF[48] = 4;    // AMP HEAD power Master
RP_DF[49] = 0;    // AD-200 power Model (Crush, Deep)
RP_DF[50] = 4;    // AD-200 power Master
RP_DF[51] = 0;    // 5F6 power Model (Tweed, Greybeard)
RP_DF[52] = 4;    // 5F6 power Presence
RP_DF[53] = 5;    // 5F6 power Master
RP_DF[54] = 5;    // SB-80 power Master
RP_N = 37;        // (18 .. 54)
// preamp p's controls are RP_ST[rp_pb[p] .. + rp_pn[p] - 1], power amp w's RP_ST[rp_wb[w] .. + rp_wn[w] - 1]
rp_pb = 4000200; rp_pn = 4000205; rp_wb = 4000210; rp_wn = 4000215;
rp_pb[0] = 18; rp_pb[1] = 25; rp_pb[2] = 32; rp_pb[3] = 38;
rp_pn[0] = 7; rp_pn[1] = 7; rp_pn[2] = 6; rp_pn[3] = 10;
rp_wb[0] = 48; rp_wb[1] = 49; rp_wb[2] = 51; rp_wb[3] = 54;
rp_wn[0] = 1; rp_wn[1] = 2; rp_wn[2] = 3; rp_wn[3] = 1;
!rp_pinit ? ( memcpy(RP_ST + 18, RP_DF + 18, RP_N); rp_pinit = 1; );
rp_lpre = slider1 | 0; rp_lpow = slider2 | 0;
// a preset (asked for by the panel, loaded in @block at the silent point of a duck); every preset starts from Init
// (every control at its default); OS is not part of a preset. rp_s(n, v) sets a piece's control n (the store's numbers).
function rp_s(i, v) ( RP_ST[i] = v; );
function rp_preset(n) (
  memcpy(RP_ST + 18, RP_DF + 18, RP_N);
  slider1 = 0; slider2 = 0; slider3 = 1; slider4 = 3; slider5 = 0; slider6 = 0; slider7 = -80;
  slider9 = 0; slider10 = 0; slider11 = 50; slider12 = 0;
  slider13 = 0; slider14 = 30; slider15 = 120; slider16 = 6000; slider17 = -0.3;
  // ---- the originals
  n == 2 ? (                                                   // Valve Warm: Amp Head's BASS, round and full
    slider12 = -5.2; slider1 = 0; slider2 = 0; slider3 = 1; slider4 = 5;
    rp_s(18, 4.5); rp_s(21, 3); rp_s(22, 1); rp_s(23, 1); rp_s(24, -2); rp_s(48, 5);
  ) : n == 3 ? (                                               // Valve Growl: Amp Head pushed, the mids up, a little DI
    slider12 = -6.1; slider1 = 0; slider2 = 0; slider3 = 1; slider4 = 3; slider5 = 25;
    rp_s(18, 7); rp_s(21, 2); rp_s(22, 5); rp_s(23, 2); rp_s(24, 2); rp_s(48, 6);
  ) : n == 4 ? (                                               // Soul Fingers: the AD-200 DEEP into its 8x10
    slider12 = -3.3; slider1 = 1; slider2 = 1; slider3 = 2; slider4 = 4;
    rp_s(25, 1); rp_s(26, 3); rp_s(27, 6); rp_s(28, 6); rp_s(29, 1); rp_s(30, 4.5); rp_s(31, 60); rp_s(49, 1); rp_s(50, 4);
  ) : n == 5 ? (                                               // Deep Dub: DEEP, the bass and SUB up, the ported 1x15
    slider12 = 1.8; slider1 = 1; slider2 = 1; slider3 = 4; slider4 = 7;
    rp_s(25, 1); rp_s(26, 3.5); rp_s(27, 8.5); rp_s(28, 4); rp_s(29, 1); rp_s(30, 2); rp_s(31, 90); rp_s(49, 1); rp_s(50, 4);
  ) : n == 6 ? (                                               // Grunge Growl: the AD-200 CRUSH, driven
    slider12 = 1.6; slider1 = 1; slider2 = 1; slider3 = 2; slider4 = 4;
    rp_s(25, 0); rp_s(26, 7.5); rp_s(27, 6); rp_s(28, 7); rp_s(29, 2); rp_s(30, 5); rp_s(31, 60); rp_s(49, 0); rp_s(50, 6);
  ) : n == 7 ? (                                               // Chicago Shuffle: the 5F6 TWEED turned up
    slider12 = -2.9; slider1 = 2; slider2 = 2; slider3 = 5; slider4 = 3;
    rp_s(32, 0); rp_s(33, 8); rp_s(34, 50); rp_s(35, 6); rp_s(36, 7); rp_s(37, 4.5); rp_s(51, 0); rp_s(52, 5); rp_s(53, 5);
  ) : n == 8 ? (                                               // Soul Clean: the 5F6 GREYBEARD, clean and warm
    slider12 = -2.2; slider1 = 2; slider2 = 2; slider3 = 5; slider4 = 4;
    rp_s(32, 1); rp_s(33, 4.5); rp_s(34, 40); rp_s(35, 5); rp_s(36, 4); rp_s(37, 6); rp_s(51, 1); rp_s(52, 3); rp_s(53, 5);
  ) : n == 9 ? (                                               // Clean Punch: the SB-80, a little COMP, a gentle smile
    slider12 = -6.8; slider1 = 3; slider2 = 3; slider3 = 6; slider4 = 3;
    rp_s(38, 5); rp_s(40, 4); rp_s(41, 2); rp_s(42, 3); rp_s(44, -2); rp_s(46, 2); rp_s(47, 3); rp_s(54, 5);
  ) : n == 10 ? (                                              // Slap Scoop: PRE-SHAPE in, more COMP, bright top, some DI
    slider12 = -4.9; slider1 = 3; slider2 = 3; slider3 = 6; slider4 = 2; slider5 = 20;
    rp_s(38, 4); rp_s(39, 1); rp_s(40, 6); rp_s(41, 3); rp_s(42, 2); rp_s(44, -3); rp_s(45, -2); rp_s(46, 3); rp_s(47, 5); rp_s(54, 5);
  ) : n == 11 ? (                                              // Rock Drive: the SB-80's GAIN up, the upper mids pushed
    slider12 = -11.5; slider1 = 3; slider2 = 3; slider3 = 6; slider4 = 3;
    rp_s(38, 8.5); rp_s(40, 2); rp_s(42, 2); rp_s(45, 4); rp_s(46, 2); rp_s(54, 7);
  // ---- the hybrids
  ) : n == 12 ? (                                              // Graphic into Valves: the SB-80 preamp into the AD-200 DEEP power amp
    slider12 = 5.3; slider1 = 3; slider2 = 1; slider3 = 2; slider4 = 4;
    rp_s(38, 5); rp_s(40, 3); rp_s(41, 2); rp_s(42, 3); rp_s(44, -2); rp_s(46, 1); rp_s(47, 2); rp_s(49, 1); rp_s(50, 5);
  ) : n == 13 ? (                                              // Tweed on the Rails: the 5F6 preamp into the SB-80 power amp and 1x15
    slider12 = -0.8; slider1 = 2; slider2 = 3; slider3 = 7; slider4 = 4;
    rp_s(32, 0); rp_s(33, 7); rp_s(34, 50); rp_s(35, 5); rp_s(36, 6); rp_s(37, 6); rp_s(54, 6);
  ) : n == 14 ? (                                              // Stack Grind: Amp Head's preamp hot, ULTRA LO, into the AD-200 CRUSH 4x10
    slider12 = -5.6; slider1 = 0; slider2 = 1; slider3 = 3; slider4 = 3;
    rp_s(18, 8); rp_s(19, 1); rp_s(21, 1); rp_s(22, 4); rp_s(23, 2); rp_s(24, 1); rp_s(49, 0); rp_s(50, 7);
  ) : n == 15 ? (                                              // Sub Fifteen: the AD-200 DEEP with SUB into the 5F6 power amp, the SB-80 1x15
    slider12 = -12.6; slider1 = 1; slider2 = 2; slider3 = 7; slider4 = 5;
    rp_s(25, 1); rp_s(26, 3.5); rp_s(27, 7); rp_s(28, 4); rp_s(29, 1); rp_s(30, 3); rp_s(31, 90); rp_s(51, 1); rp_s(52, 3); rp_s(53, 5);
  ) : n == 16 ? (                                              // Graphic Tweed: the SB-80 preamp into the 5F6 GREYBEARD and its open 4x10
    slider12 = -3.1; slider1 = 3; slider2 = 2; slider3 = 5; slider4 = 3;
    rp_s(38, 6); rp_s(40, 3); rp_s(42, 2); rp_s(43, 1); rp_s(45, 2); rp_s(47, -2); rp_s(51, 1); rp_s(52, 4); rp_s(53, 6);
  );
  rp_lpre = rp_lpow = -1;                                      // rp_sync() hands the store to the generic sliders
  sliderchange(2 ^ 30 - 1 - 2 ^ 7);
);
// the generic sliders -> the store; a new piece chosen: its stored settings -> the sliders
function rp_sync() local(p, w, k, m) (
  p = min(max(slider1 | 0, 0), 3); w = min(max(slider2 | 0, 0), 3); m = 0;
  p == rp_lpre ? ( k = 0; loop(rp_pn[p], RP_ST[rp_pb[p] + k] = slider(18 + k); k += 1; ); ) : (
    k = 0; loop(10, slider(18 + k) = k < rp_pn[p] ? RP_ST[rp_pb[p] + k] : 0; k += 1; ); m = 1; rp_lpre = p;
  );
  w == rp_lpow ? ( k = 0; loop(rp_wn[w], RP_ST[rp_wb[w] + k] = slider(28 + k); k += 1; ); ) : (
    k = 0; loop(3, slider(28 + k) = k < rp_wn[w] ? RP_ST[rp_wb[w] + k] : 0; k += 1; ); m = 1; rp_lpow = w;
  );
  m ? sliderchange(2 ^ 17 * 8191);
);

os_design();
os_base = 0;
clp_kt_on = 1;                                                 // (the 5F6 follower's knee tracks VOLUME)
abD1.drift_init(0.8 + rand(1) * 0.5); abD2.drift_init(0.8 + rand(1) * 0.5); abD3.drift_init(0.8 + rand(1) * 0.5);
a2D1.drift_init(0.8 + rand(1) * 0.5); a2D2.drift_init(0.8 + rand(1) * 0.5); a2D3.drift_init(0.8 + rand(1) * 0.5);
a2D4.drift_init(0.8 + rand(1) * 0.5); a2D5.drift_init(0.8 + rand(1) * 0.5); a2D6.drift_init(0.8 + rand(1) * 0.5);
f6D1.drift_init(0.8 + rand(1) * 0.5); f6D2.drift_init(0.8 + rand(1) * 0.5); f6D3.drift_init(0.8 + rand(1) * 0.5);
f6D4.drift_init(0.8 + rand(1) * 0.5); f6D5.drift_init(0.8 + rand(1) * 0.5); f6D6.drift_init(0.8 + rand(1) * 0.5);
f6D7.drift_init(0.8 + rand(1) * 0.5); f6D8.drift_init(0.8 + rand(1) * 0.5);
sbD1.drift_init(0.8 + rand(1) * 0.5);
rp_start();
rp_pkL_disp = rp_pkR_disp = 0;
rp_rf = 1;

ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
rp_sync();
rp_update();

@block
srate != rp_sr ? rp_start();
// back on after REAPER's bypass (the plug-in wasn't called): clear the stale state, crossfade 15 ms from the dry input
rp_now = time_precise();
rp_last > 0 && rp_now - rp_last > max(0.15, 4 * samplesblock / srate) ? ( rp_rate(); rp_rf = 0; rp_rc = 1 / (0.015 * srate); );
rp_last = rp_now;
// a preset asked for (by the panel): duck out, load it at the silent point (below), come back in
rp_prq_d > 0 && rp_dst == 0 ? ( rp_prn = rp_prq_d; rp_prq_d = 0; rp_dfor = 1; rp_dst = 1; );
rp_sync();
rp_update();
rp_dst == 3 ? (
  rp_preset(rp_prn); rp_sync(); rp_update(); rp_swapall();
  rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dfor = 0; rp_dst = 2;
);
// a piece, MONO IN or a model asked for: start the duck
rp_dst == 0 && (rp_tp != rp_p || rp_tw != rp_w || rp_tc != rp_c || rp_tmono != rp_mono ||
  (rp_p == 1 && a2_wp != (RP_ST[25] >= 0.5)) || (rp_w == 1 && a2_ww != (RP_ST[49] >= 0.5))) ? rp_dst = 1;
rp_dst < 2 ? rp_block();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_mem(0, RP_ST + 18, RP_N);
rp_lpre = slider1 | 0; rp_lpow = slider2 | 0;

@sample
// the duck: out, the swap at silence, a hold while the old state rings out, back in
rp_dst == 1 ? ( rp_dk -= rp_dkr; rp_dk <= 0 ? ( rp_dk = 0; rp_dfor ? rp_dst = 3 : ( rp_swap(); rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dst = 2; ); ); ) :
rp_dst == 2 ? ( rp_hc > 0 ? rp_hc -= 1 : ( rp_dk += rp_dkr; rp_dk >= 1 ? ( rp_dk = 1; rp_dst = 0; ); ); );
// the OS key: a factor change swaps in at the silent point of its own dip
os_gate();
os_chg ? rp_rate();

rp_dl = spl0; rp_dr = spl1;
in_process(spl0, spl1);
rp_xl = in_l; rp_xr = in_r;
rp_gate > -79.5 ? ( rp_gg = rp_gt.am_gate(max(abs(rp_xl), abs(rp_xr)), rp_gate); rp_xl *= rp_gg; rp_xr *= rp_gg; );
rp_mono ? ( rp_xl = rp_xr = 0.5 * (rp_xl + rp_xr); );
rp_dn = -rp_dn; a2_dn = -a2_dn;
// the dry signal, delayed to the amp's latency (the AD-200's SUB and the DI)
rp_dw = (rp_dw + 1) & 127; rp_DRY[rp_dw] = rp_xl; rp_DRY[128 + rp_dw] = rp_xr;
rp_ddl = rp_DRY[(rp_dw - os_lat(os_f)) & 127]; rp_ddr = rp_DRY[128 + ((rp_dw - os_lat(os_f)) & 127)];

// the host-rate work of the pieces in use (the preamp's drive-tracking pre-filter, the knobs that glide per sample)
rp_p == 0 ? ( ab_glide(); rp_al = abfL.clp_pf_run(rp_xl); rp_ar = abfR.clp_pf_run(rp_xr); ) :
rp_p == 1 ? ( a2_gp += (a2_gpt - a2_gp) * a2_sk; a2_sb += (a2_sbt - a2_sb) * a2_sk;
              rp_al = a2fL.clp_pf_run(rp_xl); rp_ar = a2fR.clp_pf_run(rp_xr); ) :
rp_p == 2 ? ( rp_al = fpL.pf.clp_pf_run(rp_xl); rp_ar = fpR.pf.clp_pf_run(rp_xr); ) :
( rp_al = rp_xl; rp_ar = rp_xr; );
rp_w == 1 ? ( a2_mp += (a2_mpt - a2_mp) * a2_sk; );

// the preamp and power amp at the amp's rate (1x, 2x or 4x)
uL.os_up(rp_al); uR.os_up(rp_ar);
rp_i = 0;
loop(os_f,
  rp_al = uL.os_s(rp_i); rp_ar = uR.os_s(rp_i);
  rp_p == 0 ? ( rp_al = abpL.ab_pre(rp_al); rp_ar = abpR.ab_pre(rp_ar); ) :
  rp_p == 1 ? ( rp_al = a2pL.a2_pre(rp_al); rp_ar = a2pR.a2_pre(rp_ar); ) :
  rp_p == 2 ? ( rp_al = fpL.f6_pre(rp_al); rp_ar = fpR.f6_pre(rp_ar); ) :
  ( rp_al = sbpL.sb_pre(rp_al); rp_ar = sbpR.sb_pre(rp_ar); );
  rp_al *= rp_kin; rp_ar *= rp_kin;
  rp_w == 0 ? ( rp_al = abwL.ab_pow(rp_al); rp_ar = abwR.ab_pow(rp_ar); ab_sag(); ) :
  rp_w == 1 ? ( rp_al = a2wL.a2_pow(rp_al); rp_ar = a2wR.a2_pow(rp_ar); ) :
  rp_w == 2 ? ( rp_al = fwL.f6_pow(rp_al); rp_ar = fwR.f6_pow(rp_ar); ) :
  ( rp_al = sbwL.sb_pow(rp_al); rp_ar = sbwR.sb_pow(rp_ar); sb_sag(); );
  rp_i == 0 ? ( rp_a0 = rp_al; rp_b0 = rp_ar; ) : rp_i == 1 ? ( rp_a1 = rp_al; rp_b1 = rp_ar; ) :
  rp_i == 2 ? ( rp_a2 = rp_al; rp_b2 = rp_ar; ) : ( rp_a3 = rp_al; rp_b3 = rp_ar; );
  rp_i += 1;
);
rp_yl = dL.os_dn(rp_a0, rp_a1, rp_a2, rp_a3); rp_yr = dR.os_dn(rp_b0, rp_b1, rp_b2, rp_b3);

// the preamp's post-shelf (host rate; the Amp Head's and the 5F6's at 1x only), the AD-200's SUB
rp_p == 0 ? ( os_f == 1 ? ( rp_yl = abkL2.am_run(abkL1.am_run(rp_yl)); rp_yr = abkR2.am_run(abkR1.am_run(rp_yr)); ); ) :
rp_p == 1 ? (
  rp_yl = a2kL.rp_sbq(rp_yl); rp_yr = a2kR.rp_sbq(rp_yr);
  // SUB: below the crossover the amp's lows are replaced by the clean copy at the amp's own level
  a2_ln = a2lL.a2_lin(rp_ddl);
  a2_ly = a2s2L.rp_sbq(a2s1L.rp_sbq(rp_yl)); a2_ll = a2s4L.rp_sbq(a2s3L.rp_sbq(a2_ln));
  a2_msyL += (a2_ly * a2_ly - a2_msyL) * a2_msk; a2_mslL += (a2_ll * a2_ll - a2_mslL) * a2_msk;
  a2_mslL > 0.00000000000001 ? a2_gL = min(sqrt(a2_msyL / a2_mslL), 100000);
  rp_yl += (a2_gL * a2_ll - a2_ly) * a2_sb;
  a2_ln = a2lR.a2_lin(rp_ddr);
  a2_ly = a2s2R.rp_sbq(a2s1R.rp_sbq(rp_yr)); a2_ll = a2s4R.rp_sbq(a2s3R.rp_sbq(a2_ln));
  a2_msyR += (a2_ly * a2_ly - a2_msyR) * a2_msk; a2_mslR += (a2_ll * a2_ll - a2_mslR) * a2_msk;
  a2_mslR > 0.00000000000001 ? a2_gR = min(sqrt(a2_msyR / a2_mslR), 100000);
  rp_yr += (a2_gR * a2_ll - a2_ly) * a2_sb;
) :
rp_p == 2 ? ( os_f == 1 ? ( rp_yl = f6k2L.rp_sbq(f6k1L.rp_sbq(rp_yl)); rp_yr = f6k2R.rp_sbq(f6k1R.rp_sbq(rp_yr)); ); );
// the 5F6 power amp's speaker load
rp_w == 2 ? ( rp_yl = ldL.f6_ldrun(rp_yl); rp_yr = ldR.f6_ldrun(rp_yr); );
// the cabinet (or the preamp's own line out)
rp_c == 1 ? ( rp_yl = abcL.am_cab_run(rp_yl); rp_yr = abcR.am_cab_run(rp_yr); ) :
rp_c >= 2 && rp_c <= 4 ? ( rp_yl = a2cL.a2_cabrun(rp_yl); rp_yr = a2cR.a2_cabrun(rp_yr); ) :
rp_c == 5 ? ( rp_yl = f6cL.f6_cabrun(rp_yl); rp_yr = f6cR.f6_cabrun(rp_yr); ) :
rp_c >= 6 ? ( rp_yl = sbcL.sb_cabrun(rp_yl); rp_yr = sbcR.sb_cabrun(rp_yr); ) : (
  rp_p == 0 ? ( rp_yl = abloL.s2.am_run(abloL.s1.am_run(rp_yl)); rp_yr = abloR.s2.am_run(abloR.s1.am_run(rp_yr)); ) :
  rp_p == 1 ? ( rp_yl = a2loL.rp_sbq(rp_yl); rp_yr = a2loR.rp_sbq(rp_yr); );
);
// the SB-80's speakers warm with what they play
rp_c >= 6 ? ( rp_sa = min(max(abs(rp_yl), abs(rp_yr)), 1); sb_heat += (rp_sa - sb_heat) * (rp_sa > sb_heat ? sb_kh : sb_kc); );
// the pair's level
rp_g += (rp_tg - rp_g) * rp_ogk;
rp_yl *= rp_g; rp_yr *= rp_g;
// DI: the clean signal (in time with the amp) blended in after the cabinet
rp_di += (rp_dit - rp_di) * rp_ogk;
rp_di > 0.00001 ? (
  rp_yl += (rp_dhL.a2_1run(rp_ddl) * 1.12 - rp_yl) * rp_di; rp_yr += (rp_dhR.a2_1run(rp_ddr) * 1.12 - rp_yr) * rp_di;
) : ( rp_dhL.a2_1run(rp_ddl); rp_dhR.a2_1run(rp_ddr); );
// OUTPUT, the ducks, the output stage
rp_os += (rp_out - rp_os) * rp_ogk;
rp_k = rp_os;
rp_dst ? ( rp_dkg = rp_dk * rp_dk * (3 - 2 * rp_dk); rp_k *= rp_dkg; );
os_g < 1 ? rp_k *= os_g;
rp_yl *= rp_k; rp_yr *= rp_k;
rp_yl = ostL.ost_band(rp_yl); rp_yr = ostR.ost_band(rp_yr);
ost_out(rp_yl, rp_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rp_rf < 1 ? (                                                   // the resume crossfade (see @block)
  rp_rf = min(rp_rf + rp_rc, 1); rp_rs = rp_rf * rp_rf * (3 - 2 * rp_rf);
  spl0 = rp_dl + (spl0 - rp_dl) * rp_rs; spl1 = rp_dr + (spl1 - rp_dr) * rp_rs;
);
rp_pkL_disp = max(rp_pkL_disp, abs(spl0)); rp_pkR_disp = max(rp_pkR_disp, abs(spl1));

@gfx 1080 660
// =====================================================================
// GUI - B RAMP faceplate: a dark chassis with three slots (PREAMP, POWER AMP, CABINET). The piece in each slot brings
// its own amp's livery: Amp Head brushed graphite with its BASS blue pinstripe, the AD-200 navy and gold, the 5F6 tweed
// (or GREYBEARD charcoal) with teal, the SB-80 black with green and a fader graphic. IN / OUT is the chassis's own.
// House parts: lamp keys, LCD preset bar, display boxes (click for the menu), S / M / L / ?, the OS key.
// =====================================================================
function rpi(n) ( 18 + n - rp_pb[slider1 | 0]; );   // a preamp control's number -> its generic slider
function rwi(n) ( 28 + n - rp_wb[slider2 | 0]; );   // a power amp control's number -> its generic slider
// a preset: asked for here, loaded in @block at the silent point of a duck (the pieces' store is the audio thread's)
function load_preset(p) ( rp_prq_d = p; );
function rg_col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function rg_shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function rg_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function rg_px(v) ( rg_ox + v * sc; );
function rg_py(v) ( rg_oy + v * sc; );
function rg_ps(v) ( v * sc; );
function rg_rect(x, y, w, h) ( gfx_rect(rg_px(x), rg_py(y), rg_ps(w), rg_ps(h), 1); );
function rg_tc(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_tl(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_tr(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rg_rivet(x, y) (
  rg_col(0x6A655E, 1);  gfx_circle(rg_px(x), rg_py(y), rg_ps(3.5), 1, 1);
  rg_col(0xFFFFFF, 0.55);  gfx_circle(rg_px(x) - rg_ps(1), rg_py(y) - rg_ps(1), rg_ps(1.2), 1, 1);
);
function rg_in(x, y, w, h) ( mouse_x >= rg_px(x) && mouse_x < rg_px(x + w) && mouse_y >= rg_py(y) && mouse_y < rg_py(y + h); );
function rg_touch(idx) ( ui_auto(idx); );
// soft drop shadow, down and to the right: 4 layers at 13 % black
function rg_dshadow(x, y, r) local(i) (
  i = 0;  loop(4, rg_col(0x000000, 0.13);  gfx_circle(x + rg_ps(2 + i * 1.33), y + rg_ps(3 + i * 1.67), r + rg_ps(i * 0.6), 1, 1);  i += 1; );
);
// pointer as a filled quad with anti-aliased edges: clean at any angle
function rg_ptr(x, y, sn, cs, ri, ro, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sn * ri;  ay = y - cs * ri;  bx = x + sn * ro;  by = y - cs * ro;  dx = cs * hw;  dy = sn * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function rg_dotarc(x, y, r, a0, a1, w) local(n, i, a) (
  n = max(2, ceil(abs(a1 - a0) * r / max(w * 0.6, 0.5)));  i = 0;
  loop(n + 1, a = a0 + (a1 - a0) * i / n;  gfx_circle(x + sin(a) * r, y - cos(a) * r, w * 0.5, 1, 1);  i += 1; );
);
function rg_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  rg_col(0x14110D, 0.95);  gfx_rect(x - w * 0.5 - rg_ps(6), y - h * 0.5 - rg_ps(3), w + rg_ps(12), h + rg_ps(6), 1);
  rg_col(0xFFB347, 1);  rg_tc(x, y, str);
);

// ---------- the knob faces: 0 desk (the chassis), 1 Amp Head, 2 5F6, 3 SB-80, 4 AD-200 ----------
function rg_face(x, y, rr, tv, k, cap) (
  k == 1 ? (                                                   // Amp Head: black ribbed skirt, chrome centre, white line
    rg_col(0x0E0E0F, 1);  gfx_circle(x, y, rr, 1, 1);
    rg_col(0x3A3B3E, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0x1C1D1F, 1);  gfx_circle(x, y, rr * 0.86, 1, 1);
    rg_col(0xFFFFFF, 0.9);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.55, rr * 0.97, rg_ps(1.4));
    rg_col(0x9A9DA2, 1);  gfx_circle(x, y, rr * 0.48, 1, 1);
    rg_col(0xE4E6EA, 1);  gfx_circle(x, y, rr * 0.42, 1, 1);
    rg_col(0xFFFFFF, 0.8);  gfx_arc(x, y, rr * 0.36, -1.7, -0.2, 1);
    rg_col(0x6E7176, 1);  gfx_circle(x, y, rr * 0.42, 0, 1);
  ) : k == 2 ? (                                               // 5F6: dark knob, silver cap, teal value arc
    rg_col(rg_shade(rg_plate, 0.8), 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, 0.75 * $pi, rg_ps(2));
    rg_col(rg_acc, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, tv, rg_ps(3.2));
    rg_col(0x2E3133, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x141516, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xC9CDD2, 1);  gfx_circle(x, y, rr * 0.62, 1, 1);
    rg_col(0xFFFFFF, 0.7);  gfx_arc(x, y, rr * 0.56, -1.7, -0.2, 1);
    rg_col(0x141516, 1);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.95, rg_ps(1.3));
  ) : k == 3 ? (                                               // SB-80: green cap in a light metal ring, white line
    rg_col(0x2C302D, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, 0.75 * $pi, rg_ps(2));
    rg_col(rg_acc, 1);  rg_dotarc(x, y, rr + rg_ps(4), -0.75 * $pi, tv, rg_ps(3.2));
    rg_col(0xB8BCBE, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x5C6062, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xFFFFFF, 0.5);  gfx_arc(x, y, rr - rg_ps(1.5), -1.6, -0.3, 1);
    rg_col(0x1E7A3C, 1);  gfx_circle(x, y, rr * 0.8, 1, 1);  rg_col(0x145A2C, 1);  gfx_circle(x, y, rr * 0.8, 0, 1);
    rg_col(0xFFFFFF, 0.95);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.2, rr * 0.78, rg_ps(1.4));
  ) : k == 4 ? (                                               // AD-200: black knob, gold line (gold dots round it)
    rg_col(0x151719, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x050607, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0x303336, 1);  gfx_circle(x, y, rr * 0.9, 1, 1);
    rg_col(0xFFFFFF, 0.13);  gfx_arc(x, y, rr * 0.84, -1.7, -0.2, 1);
    rg_col(0xF2D27A, 1);  rg_ptr(x, y, sin(tv), cos(tv), rr * 0.3, rr * 0.92, rg_ps(1.8));
  ) : (                                                        // the desk knob: grey skirt, light body, coloured cap
    rg_col(0x7E848A, 1);  gfx_circle(x, y, rr, 1, 1);  rg_col(0x5E646A, 1);  gfx_circle(x, y, rr, 0, 1);
    rg_col(0xE6E3DC, 1);  gfx_circle(x, y, rr * 0.78, 1, 1);
    rg_col(0xFFFFFF, 0.5);  gfx_arc(x, y, rr * 0.74, -1.6, -0.3, 1);
    rg_col(cap, 1);  gfx_circle(x, y, rr * 0.5, 1, 1);  rg_col(rg_shade(cap, 0.75), 1);  gfx_circle(x, y, rr * 0.5, 0, 1);
    rg_col(0x1A1A1A, 1);  rg_ptr(x, y, sin(tv), cos(tv), 0, rr * 0.98, rg_ps(1.4));
  );
  // a light vignette edge: darker towards the rim (more on the bottom right)
  rg_col(0x000000, 0.10);  gfx_arc(x, y, rr - rg_ps(1), 0.6, 2.9, 1);  gfx_arc(x, y, rr - rg_ps(2), 0.9, 2.6, 1);
);
// Knob: style k (above), cap colour for the desk knob. rg_kstep > 0 = stepped, rg_kdim = shown dimmed, rg_kzero = a
// "0" at the top. Drag 200 px (Shift = fine), wheel 3 % (Shift 0.5 %), double-click / Ctrl-click = default. The value
// shows in a tag above the knob while it is touched.
function rg_kn(cx, cy, r, idx, vmin, vmax, def, k, cap, lbl, fmt)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, st, dm, zr)
(
  st = rg_kstep;  rg_kstep = 0;  dm = rg_kdim;  rg_kdim = 0;  zr = rg_kzero;  rg_kzero = 0;
  x = rg_px(cx);  y = rg_py(cy);  rr = rg_ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = (v - vmin) / (vmax - vmin);
  rg_click && hov && !rg_drag ? (
    now = time_precise();
    (mouse_cap & 4) || (rg_lci == idx && now - rg_lct < 0.35) ? (
      slider(idx) = def;  rg_touch(idx);  rg_drag = 0;
    ) : ( rg_drag = idx;  rg_dy = mouse_y;  rg_dt = t;  rg_dmv = 0; );
    rg_lci = idx;  rg_lct = now;
  );
  hov && mouse_wheel != 0 && !rg_drag ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));  v = vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    mouse_wheel = 0;
  );
  rg_drag == idx ? (
    !rg_dmv && abs(mouse_y - rg_dy) > rg_ps(3) ? ( rg_dmv = 1;  rg_dy = mouse_y; );   // a 3 px dead zone
    rg_dmv ? (
      t = max(0, min(1, rg_dt + (rg_dy - mouse_y) / rg_ps((mouse_cap & 8) ? 1100 : 200)));
      v = vmin + t * (vmax - vmin);
      v = st > 0 ? vmin + floor((v - vmin) / st + 0.5) * st : floor(v * 1000 + 0.5) / 1000;
      v = max(vmin, min(vmax, v));
      v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  k != 2 && k != 3 ? (                                         // the scale: eleven dots (the arcs mark the others)
    rg_col(rg_ink2, 0.85);  j = 0;
    loop(11, b = a0 + j / 10 * (a1 - a0);
      !(zr && j == 5) ? gfx_circle(x + sin(b) * (rr + rg_ps(6)), y - cos(b) * (rr + rg_ps(6)), rg_ps(k == 4 ? 1.6 : 1.2), 1, 1);  j += 1; );
  );
  zr ? ( gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tc(x, y - rr - rg_ps(9), "0"); );
  rg_dshadow(x, y, rr);
  rg_face(x, y, rr, tv, k, cap);
  dm ? ( rg_col(rg_plate, 0.55);  gfx_circle(x, y, rr + rg_ps(5), 1, 1); );
  gfx_setfont(6);  rg_col(dm ? rg_mix(rg_ink, rg_plate, 0.5) : rg_ink, 1);  rg_tc(x, y + rr + rg_ps(19), lbl);
  hov || rg_drag == idx ? ( sprintf(#rgv, fmt, v);  rg_tag(x, y - rr - rg_ps(17), #rgv); );
);
// ---------- house lamp keys: a coloured lens in a dark well (lit = feathered glow) ----------
function rg_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function rg_rr(x, y, w, h, r) ( rg_rrs(rg_px(x), rg_py(y), rg_ps(w), rg_ps(h), rg_ps(r)); );
function rg_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy, tw, th) (
  hov = rg_in(x, y, w, h);
  hit = rg_click && hov && !rg_drag;
  dn = hov && rg_lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = rg_shade(rg_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rr(x - 4 * k + 2 + i * 1.33, y - 4 * k + 3 + i * 1.67, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  on ? (
    rg_col(c, 0.10); rg_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    rg_col(c, 0.18); rg_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  rg_col(0x141518, 1);           rg_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  rg_col(rg_shade(lens, 0.55), 1); rg_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    rg_col(lens, 1); rg_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;  dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      rg_col(rg_mix(c, 0xFFFFFF, t), 1); rg_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    rg_col(rg_shade(lens, 0.62), 1); rg_rr(x, y, w, h - 1 / sc, 4 * k);
    rg_col(rg_shade(lens, 0.78), 1); rg_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    rg_col(rg_shade(lens, 0.92), 1); rg_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    rg_col(lens, 1);                 rg_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  rg_col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(rg_px(x + 4 * k), rg_py(y), rg_ps(w - 8 * k), max(1, rg_ps(1.5)));
  hov && !dn ? ( rg_col(0xFFFFFF, 0.07); rg_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  rg_col(rg_shade(c, on ? 0.30 : 0.17), 1);
  gfx_measurestr(str, tw, th);  gfx_x = floor(rg_px(x + w * 0.5) - tw * 0.5 + 0.5);  gfx_y = floor(rg_py(y + h * 0.5) - th * 0.58 + 0.5);
  gfx_drawstr(str);
  hit;
);
// a toggle key for a slider
function rg_tog(x, y, w, h, idx, c, str) ( rg_key(x, y, w, h, slider(idx) >= 0.5, c, str) ? ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1;  rg_touch(idx); ); );
// a radio key: lit when the slider holds v, a click sets it
function rg_rad(x, y, w, h, idx, v, c, str) ( rg_key(x, y, w, h, floor(slider(idx) + 0.5) == v, c, str) ? ( slider(idx) = v;  rg_touch(idx); ); );

// ---------- list helpers, menus ----------
function rg_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function rg_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function rg_menu(x, y, idx, list) local(n, t, i, sel) (
  n = rg_count(list);  t = floor(slider(idx) + 0.5);  strcpy(#rgm, "");  i = 0;
  loop(n, i == t ? strcat(#rgm, "!");  strcat(#rgm, rg_item(list, i + 1, #rgmt));  i < n - 1 ? strcat(#rgm, "|");  i += 1; );
  gfx_x = rg_px(x);  gfx_y = rg_py(y);  sel = gfx_showmenu(#rgm);
  sel > 0 && sel - 1 != t ? ( slider(idx) = sel - 1;  rg_touch(idx); );
);
// a display box (a dark recessed box, light text, its label above): a click opens the menu of its slider's values
// (rg_dsh = 1: the box shows the item from the shorter list #rgds instead)
function rg_disp(x, y, w, h, idx, list, lbl, sub) local(hov, tw, th) (
  hov = rg_in(x, y, w, h);
  gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tl(rg_px(x), rg_py(y - 12), lbl);
  rg_col(0x000000, 0.45);  rg_rect(x - 2, y - 2, w + 4, 2);  rg_rect(x - 2, y, 2, h + 2);
  rg_col(0xFFFFFF, 0.12);  rg_rect(x - 2, y + h, w + 4, 2);  rg_rect(x + w, y - 2, 2, h + 2);
  rg_col(0x14120F, 1);  rg_rect(x, y, w, h);
  rg_col(0x000000, 0.5);  rg_rect(x, y, w, 2);  rg_rect(x, y, 2, h);
  hov ? ( rg_col(0xFFFFFF, 0.05);  rg_rect(x, y, w, h); );
  gfx_setfont(7);  rg_col(0xF2E8D2, 1);  rg_tl(rg_px(x + 12), rg_py(y + (strlen(sub) ? h * 0.36 : h * 0.5)), rg_item(rg_dsh ? #rgds : list, floor(slider(idx) + 0.5) + 1, #rgd));  rg_dsh = 0;
  strlen(sub) ? ( gfx_setfont(5);  rg_col(0xC8B898, 1);  rg_tl(rg_px(x + 12), rg_py(y + h * 0.74), sub); );
  rg_col(0xE0A030, 1);
  gfx_triangle(rg_px(x + w - 20), rg_py(y + h * 0.5 - 3), rg_px(x + w - 10), rg_py(y + h * 0.5 - 3), rg_px(x + w - 15), rg_py(y + h * 0.5 + 3));
  rg_click && hov && !rg_drag ? rg_menu(x, y + h + 4, idx, list);
);
// ---------- LCD (the preset bar) ----------
function rg_lcd(x, y, w, h, str) local(tw, th) (
  rg_col(0x000000, 0.6);  rg_rect(x - 2, y - 2, w + 4, h + 4);
  rg_col(0x050302, 1);  rg_rect(x, y, w, h);
  rg_col(0x140D06, 1);  rg_rect(x + 3, y + 3, w - 6, h - 6);
  rg_col(0xFFFFFF, 0.06);  rg_rect(x + 4, y + 4, w - 8, 1);
  gfx_setfont(8);  gfx_measurestr(str, tw, th);
  rg_col(0xFFB347, 0.22);  gfx_x = rg_px(x + 10) - 1;  gfx_y = rg_py(y + h * 0.5) - th * 0.5;  gfx_drawstr(str);
  rg_col(0xFFB347, 1);  gfx_x = rg_px(x + 10);  gfx_y = rg_py(y + h * 0.5) - th * 0.5;  gfx_drawstr(str);
);
function rg_tri(cx, cy, s, dir) ( gfx_triangle(rg_px(cx + dir * s), rg_py(cy), rg_px(cx - dir * s), rg_py(cy - s), rg_px(cx - dir * s), rg_py(cy + s)); );
// [PRESETS][<][>][LCD]: h 34, PRESETS 64 wide, arrows 24, 4 px after PRESETS, 2 between the arrows, 6 before the LCD
function rg_pbar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = rg_count(menu);  sel = 0;  open = 0;
  rg_key(x, y + 3, 76, h - 6, 0, 0xE2DCD2, "PRESETS") ? open = 1;
  rg_key(x + 84, y + 3, 26, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  rg_key(x + 114, y + 3, 26, h - 6, 0, 0xE2DCD2, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  rg_col(0x2A2620, 1);  rg_tri(x + 96, y + h * 0.5, 4.5, -1);  rg_tri(x + 128, y + h * 0.5, 4.5, 1);
  lx = x + 150;
  cur >= 1 && cur <= n ? rg_item(menu, cur, #rgpn) : strcpy(#rgpn, "--");
  rg_lcd(lx, y, lw, h, #rgpn);
  rg_click && rg_in(lx, y, lw, h) ? open = 1;
  open ? (
    strcpy(#rgpm, "");  i = 1;
    loop(n, i == cur ? strcat(#rgpm, "!");  strcat(#rgpm, rg_item(menu, i, #rgpt));  i < n ? strcat(#rgpm, "|");  i += 1; );
    gfx_x = rg_px(x);  gfx_y = rg_py(y + h);  i = gfx_showmenu(#rgpm);  i > 0 ? sel = i;
  );
  sel;
);

// ---------- plates ----------
// the chassis's own plate: a recessed tray (a darker lip, an inner shadow top and left drawn as an L, a light edge)
function rg_tray(x, y, w, h, c, title) local(i) (
  rg_col(0x000000, 0.35);  rg_rect(x - 2, y - 2, w + 4, 2);  rg_rect(x - 2, y, 2, h + 2);
  rg_col(0xFFFFFF, 0.10);  rg_rect(x - 2, y + h, w + 4, 2);  rg_rect(x + w, y - 2, 2, h + 2);
  rg_col(c, 1);  rg_rect(x, y, w, h);
  i = 0;  loop(5, rg_col(0x000000, 0.16 - i * 0.03);  rg_rect(x + i, y + i, w - i, 1);  rg_rect(x + i, y + i + 1, 1, h - i - 1);  i += 1; );
  rg_col(0xFFFFFF, 0.08);  rg_rect(x + 1, y + h - 1, w - 1, 1);  rg_rect(x + w - 1, y + 1, 1, h - 2);
  strlen(title) ? ( gfx_setfont(4);  rg_col(rg_cink, 1);  rg_tl(rg_px(x + 16), rg_py(y + 20), title); );
);
// a module's livery (m = 0 Amp Head graphite, 1 AD-200 navy, 2 5F6 tweed, 3 5F6 greybeard, 4 SB-80): plate, inks,
// accent, knob style, key colour
function rg_livery(m) (
  m == 0 ? ( rg_plate = 0x2A2C30; rg_ink = 0xD8DCE2; rg_ink2 = 0xA0A6AE; rg_acc = 0x3A8DFF; rg_ks = 1; rg_kc = 0x6AB4F4; ) :
  m == 1 ? ( rg_plate = 0x16263F; rg_ink = 0xDDBC66; rg_ink2 = 0xBFA066; rg_acc = 0xC9A24A; rg_ks = 4; rg_kc = 0xF2C55C; ) :
  m == 2 ? ( rg_plate = 0xE6DCC0; rg_ink = 0x2A2C2E; rg_ink2 = 0x55585C; rg_acc = 0x2F9A93; rg_ks = 2; rg_kc = 0xF2A41E; ) :
  m == 3 ? ( rg_plate = 0x3D4044; rg_ink = 0xE8E4D8; rg_ink2 = 0xA6AAAE; rg_acc = 0x52C2BA; rg_ks = 2; rg_kc = 0x52C2BA; ) :
           ( rg_plate = 0x18191A; rg_ink = 0xF0F2EC; rg_ink2 = 0x9DB5A4; rg_acc = 0x3FCF6A; rg_ks = 3; rg_kc = 0x4FD878; );
);
// a module plate in its livery, with its own name and a subtitle; a small rivet in each corner
function rg_module(x, y, w, h, m, name, sub) local(i, j, tw, th) (
  rg_livery(m);
  i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(x + 2 + i * 1.33, y + 3 + i * 1.67, w + i * 0.6, h + i * 0.6);  i += 1; );
  rg_col(rg_plate, 1);  rg_rect(x, y, w, h);
  m == 0 ? (                                                   // brushed graphite, the blue pinstripe
    i = 0;  loop(h / 2, rg_col(i % 3 ? 0xFFFFFF : 0x000000, i % 3 ? 0.03 : 0.06);  rg_rect(x, y + i * 2, w, 1);  i += 1; );
    rg_col(rg_shade(rg_acc, 0.65), 1);  rg_rect(x + 4, y + h - 9, w - 8, 3);
  ) : m == 1 ? (                                               // navy, a gold rule under the name, gold piping
    rg_col(0x1C2F4C, 1);  rg_rect(x + 8, y + 40, w - 16, h - 54);
    rg_col(rg_acc, 0.8);  rg_rect(x + 16, y + 34, w - 32, 1);
    rg_col(rg_acc, 0.45);  rg_rect(x + 4, y + h - 8, w - 8, 2);
  ) : m == 2 ? (                                               // tweed: a fine diagonal weave, a teal rule
    i = 0;  loop(floor((w + h) / 6), rg_col(0x6A5A3A, 0.06);
      gfx_line(rg_px(x + max(0, i * 6 - h)), rg_py(y + min(h, i * 6)), rg_px(x + min(w, i * 6)), rg_py(y + max(0, i * 6 - w)), 1);  i += 1; );
    rg_col(rg_acc, 0.8);  rg_rect(x + 16, y + 34, w - 32, 2);
  ) : m == 3 ? (                                               // greybeard: charcoal, a teal rule
    rg_col(rg_acc, 0.6);  rg_rect(x + 16, y + 34, w - 32, 1);
  ) : (                                                        // SB-80: black, a green stripe along the foot
    rg_col(rg_acc, 0.55);  rg_rect(x + 16, y + 34, w - 32, 1);
    rg_col(rg_shade(rg_acc, 0.8), 1);  rg_rect(x + 4, y + h - 12, w - 8, 5);
    rg_col(0xFFFFFF, 0.18);  rg_rect(x + 4, y + h - 12, w - 8, 1);
  );
  // depth: a narrow darker bottom / right edge, a light top / left one
  rg_col(0x000000, 0.25);  rg_rect(x, y + h - 2, w, 2);  rg_rect(x + w - 2, y, 2, h - 2);
  rg_col(0xFFFFFF, m == 2 ? 0.35 : 0.10);  rg_rect(x, y, w - 2, 1);  rg_rect(x, y + 1, 1, h - 3);
  rg_col(m == 2 ? rg_shade(rg_plate, 0.6) : rg_shade(rg_plate, 2.2), 1);
  gfx_circle(rg_px(x + 8), rg_py(y + 8), rg_ps(2.5), 1, 1);  gfx_circle(rg_px(x + w - 8), rg_py(y + 8), rg_ps(2.5), 1, 1);
  gfx_circle(rg_px(x + 8), rg_py(y + h - 8), rg_ps(2.5), 1, 1);  gfx_circle(rg_px(x + w - 8), rg_py(y + h - 8), rg_ps(2.5), 1, 1);
  gfx_setfont(4);  rg_col(rg_ink, 1);  rg_tl(rg_px(x + 20), rg_py(y + 20), name);
  gfx_measurestr(name, tw, th);
  gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tl(rg_px(x + 20) + tw + rg_ps(12), rg_py(y + 21), sub);
);
// A graphic EQ fader (the SB-80): a slot with dB marks, a black cap with a green line. Drag (Shift = fine), wheel,
// double-click / Ctrl-click = 0 dB; the value shows in a tag above while touched.
function rg_fad(cx, y0, h, idx, vmin, vmax, def, lbl) local(x, v, t, hov, now, cy, j, yy) (
  hov = rg_in(cx - 18, y0 - 8, 36, h + 16);
  v = max(vmin, min(vmax, slider(idx)));  t = (v - vmin) / (vmax - vmin);
  rg_click && hov && !rg_drag ? (
    now = time_precise();
    (mouse_cap & 4) || (rg_lci == idx && now - rg_lct < 0.35) ? ( slider(idx) = def;  rg_touch(idx);  rg_drag = 0; ) :
      ( rg_drag = idx;  rg_dy = mouse_y;  rg_dt = t;  rg_dmv = 0; );
    rg_lci = idx;  rg_lct = now;
  );
  hov && mouse_wheel != 0 && !rg_drag ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));  v = floor((vmin + t * (vmax - vmin)) * 10 + 0.5) / 10;
    v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    mouse_wheel = 0;
  );
  rg_drag == idx ? (
    !rg_dmv && abs(mouse_y - rg_dy) > rg_ps(3) ? ( rg_dmv = 1;  rg_dy = mouse_y; );
    rg_dmv ? (
      t = max(0, min(1, rg_dt + (rg_dy - mouse_y) / rg_ps((mouse_cap & 8) ? h * 5 : h)));
      v = floor((vmin + t * (vmax - vmin)) * 10 + 0.5) / 10;
      v != slider(idx) ? ( slider(idx) = v;  rg_touch(idx); );
    );
  );
  v = max(vmin, min(vmax, slider(idx)));  t = (v - vmin) / (vmax - vmin);
  // the marks: +12, +6, 0 (longer), -6, -12
  j = 0;  loop(5, yy = y0 + h * j / 4;  rg_col(rg_ink2, j == 2 ? 1 : 0.7);
    rg_rect(cx - (j == 2 ? 17 : 14), yy - 0.5, j == 2 ? 8 : 5, 1);  rg_rect(cx + (j == 2 ? 9 : 9), yy - 0.5, j == 2 ? 8 : 5, 1);  j += 1; );
  // the slot
  rg_col(0x000000, 0.8);  rg_rect(cx - 3, y0 - 4, 6, h + 8);  rg_col(0xFFFFFF, 0.10);  rg_rect(cx + 3, y0 - 4, 1, h + 8);
  // the cap: soft shadow, black body, a green line across
  cy = y0 + h * (1 - t);  x = cx - 13;
  j = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(x + 2 + j * 1.33, cy - 8 + 3 + j * 1.67, 26 + j * 0.6, 16 + j * 0.6);  j += 1; );
  rg_col(0x0E0F0F, 1);  rg_rect(x, cy - 8, 26, 16);
  rg_col(0x3A3D3C, 1);  rg_rect(x, cy - 8, 26, 1);  rg_rect(x, cy - 8, 1, 16);
  rg_col(0x000000, 0.4);  rg_rect(x + 1, cy + 7, 25, 1);  rg_rect(x + 25, cy - 7, 1, 15);
  rg_col(rg_acc, 1);  rg_rect(x + 3, cy - 1, 20, 2);
  hov && !rg_drag ? ( rg_col(0xFFFFFF, 0.08);  rg_rect(x, cy - 8, 26, 16); );
  gfx_setfont(6);  rg_col(rg_ink, 1);  rg_tc(rg_px(cx), rg_py(y0 + h + 24), lbl);
  hov || rg_drag == idx ? ( sprintf(#rgv, "%+.1f dB", v);  rg_tag(rg_px(cx), rg_py(y0 - 22), #rgv); );
);
// a thin inked line splitting a plate into parts
function rg_div(x, y0, y1) ( rg_col(0x000000, 0.35);  rg_rect(x, y0, 1, y1 - y0);  rg_col(0xFFFFFF, 0.14);  rg_rect(x + 1, y0, 1, y1 - y0); );
function rg_sub(x, y, str) ( gfx_setfont(6);  rg_col(rg_ink, 1);  rg_tl(rg_px(x), rg_py(y), str); );
function rg_small(x, y, str) ( gfx_setfont(5);  rg_col(rg_ink2, 1);  rg_tc(rg_px(x), rg_py(y), str); );
// dims a switched-off part (the plate's colour at about half over it)
function rg_dim(x, y, w, h) ( rg_col(rg_plate, 0.5);  rg_rect(x, y, w, h); );

// Labels in the house font, Trebuchet MS bold, sized by width (as ui_fitfont: "THRESHOLD" = 5.28 x the size) so they
// read the same size on every system. Re-measured when the scale changes.
function rg_fit(idx, size) local(fs, w, h, target) (
  target = 5.28 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, "Trebuchet MS", fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);

// ---------- frame setup ----------
rg_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
rg_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;                         // S / M / L
sc = rg_ret * max(min(rg_want, min(gfx_w / (1080 * rg_ret), gfx_h / (660 * rg_ret))), 0.5);
rg_ox = (gfx_w - 1080 * sc) * 0.5;
rg_oy = (gfx_h - 660 * sc) * 0.5;
rg_lmb = mouse_cap & 1;
rg_click = rg_lmb && !rg_llmb;
// while the ? pop-up is open, it takes the clicks (the panel under it doesn't)
rg_hclick = rg_help ? rg_click : 0;
rg_help ? ( rg_click = 0;  mouse_wheel = 0; );
rg_kstep = 0;  rg_kdim = 0;  rg_kzero = 0;
sc != rg_fsc ? (
  rg_fsc = sc;
  rg_f1 = rg_fit(1, rg_ps(30));     // title
  rg_f10 = rg_fit(10, rg_ps(12));   // header subtitle
  rg_f2 = rg_fit(2, rg_ps(15));     // key legends
  rg_f3 = rg_fit(3, rg_ps(14));     // hover values
  rg_f4 = rg_fit(4, rg_ps(18));     // plate titles
  rg_f5 = rg_fit(5, rg_ps(13));     // small print
  rg_f6 = rg_fit(6, rg_ps(16));     // knob labels, part titles
  rg_f7 = rg_fit(7, rg_ps(17));     // display boxes
);
gfx_setfont(1, "Trebuchet MS", rg_f1, 'b');  gfx_setfont(10, "Trebuchet MS", rg_f10, 'b');
gfx_setfont(2, "Trebuchet MS", rg_f2, 'b');  gfx_setfont(3, "Trebuchet MS", rg_f3, 'b');
gfx_setfont(4, "Trebuchet MS", rg_f4, 'b');  gfx_setfont(5, "Trebuchet MS", rg_f5, 'b');
gfx_setfont(6, "Trebuchet MS", rg_f6, 'b');  gfx_setfont(7, "Trebuchet MS", rg_f7, 'b');
gfx_setfont(8, "Courier New", rg_ps(20), 'b');

// the chassis colours
rg_chas = 0x2B2926;  rg_tray0 = 0x34312D;  rg_cink = 0xEDE4D0;  rg_cink2 = 0xB9AE98;
PRESET_MENU = "Init|Valve Warm|Valve Growl|Soul Fingers|Deep Dub|Grunge Growl|Chicago Shuffle|Soul Clean|Clean Punch|Slap Scoop|Rock Drive|Graphic into Valves|Tweed on the Rails|Stack Grind|Sub Fifteen|Graphic Tweed";
PRE_LIST = "Amp Head|AD-200|5F6|SB-80";
CAB_LIST = "Line out|8x10 (Amp Head)|8x10 sealed (AD-200)|4x10 sealed (AD-200)|1x15 ported (AD-200)|4x10 open (5F6)|4x10 (SB-80)|1x15 (SB-80)";

// ---------- the chassis ----------
rg_col(rg_chas, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
rg_col(0x141312, 1);  rg_rect(0, 0, 1080, 58);
rg_col(0x000000, 1);  rg_rect(0, 58, 1080, 3);  rg_col(0xE0A030, 1);  rg_rect(0, 61, 1080, 1);
rg_col(rg_shade(rg_chas, 0.7), 1);  rg_rect(0, 657, 1080, 3);  rg_rect(1077, 62, 3, 598);
rg_rivet(8, 70);  rg_rivet(1072, 70);  rg_rivet(8, 651);  rg_rivet(1072, 651);
gfx_setfont(1);  rg_col(0xF4EEDF, 1);  rg_tl(rg_px(24), rg_py(23), "B RAMP");
gfx_setfont(10);  rg_col(0xE0A030, 1);  rg_tl(rg_px(26), rg_py(46), "MODULAR BASS AMP");
gfx_setfont(1);  gfx_measurestr("B RAMP", rg_tw, rg_th);
gfx_setfont(4);  rg_col(0xE0A030, 1);  rg_tl(rg_px(24) + rg_tw + rg_ps(16), rg_py(24), "GFX");

rg_k = rg_pbar(330, 12, 34, 300, pr_cur, PRESET_MENU);
rg_k > 0 ? ( load_preset(rg_k);  pr_cur = rg_k; );

// ================================================================ PREAMP
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 74, 180, 220, rg_tray0, "PREAMP");
rg_p = floor(slider1 + 0.5);
rg_disp(28, 128, 156, 48, 1, PRE_LIST, "MODULE",
  rg_p == 0 ? "TWO VALVES" : rg_p == 1 ? "VALVE, SUB" : rg_p == 2 ? "TWEED, FOLLOWER" : "SOLID STATE");
gfx_setfont(5);  rg_col(rg_cink2, 1);
rg_tl(rg_px(28), rg_py(206), rg_p == 0 ? "Two valves into a" : rg_p == 1 ? "A valve preamp, a" : rg_p == 2 ? "Two inputs blended," : "Transistor gain, a");
rg_tl(rg_px(28), rg_py(224), rg_p == 0 ? "three-band stack, five" : rg_p == 1 ? "passive stack, and SUB" : rg_p == 2 ? "a cathode follower" : "compressor, the mid");
rg_tl(rg_px(28), rg_py(242), rg_p == 0 ? "mid frequencies" : rg_p == 1 ? "for a clean low end" : rg_p == 2 ? "into the tweed stack" : "scoop and a graphic");

rg_x0 = 208;  rg_y0 = 74;
rg_p == 0 ? (
  rg_module(rg_x0, rg_y0, 856, 220, 0, "AMP HEAD", "PREAMP  -  TWO VALVES");
  rg_kn(rg_x0 + 90, rg_y0 + 118, 32, rpi(18), 0, 10, 4, rg_ks, 0, "GAIN", "%.1f");
  rg_div(rg_x0 + 170, rg_y0 + 50, rg_y0 + 196);
  rg_kzero = 1;  rg_kn(rg_x0 + 240, rg_y0 + 118, 24, rpi(21), -12, 12, 0, rg_ks, 0, "BASS", "%+.1f dB");
  rg_kzero = 1;  rg_kn(rg_x0 + 350, rg_y0 + 118, 24, rpi(22), -12, 12, 0, rg_ks, 0, "MIDRANGE", "%+.1f dB");
  rg_kzero = 1;  rg_kn(rg_x0 + 460, rg_y0 + 118, 24, rpi(24), -12, 12, 0, rg_ks, 0, "TREBLE", "%+.1f dB");
  rg_div(rg_x0 + 530, rg_y0 + 50, rg_y0 + 196);
  rg_disp(rg_x0 + 556, rg_y0 + 100, 120, 40, rpi(23), "220 Hz|450 Hz|800 Hz|1.6 kHz|3 kHz", "MID FREQUENCY", "");
  rg_div(rg_x0 + 700, rg_y0 + 50, rg_y0 + 196);
  rg_tog(rg_x0 + 726, rg_y0 + 76, 106, 30, rpi(19), rg_kc, "ULTRA LO");
  rg_tog(rg_x0 + 726, rg_y0 + 128, 106, 30, rpi(20), rg_kc, "ULTRA HI");
) : rg_p == 1 ? (
  rg_module(rg_x0, rg_y0, 856, 220, 1, "AD-200", "PREAMP  -  VALVE, PASSIVE STACK, SUB");
  rg_small(rg_x0 + 74, rg_y0 + 58, "MODEL");
  rg_rad(rg_x0 + 24, rg_y0 + 76, 100, 30, rpi(25), 0, rg_kc, "CRUSH");
  rg_rad(rg_x0 + 24, rg_y0 + 124, 100, 30, rpi(25), 1, rg_kc, "DEEP");
  rg_div(rg_x0 + 150, rg_y0 + 50, rg_y0 + 196);
  rg_kn(rg_x0 + 216, rg_y0 + 118, 30, rpi(26), 0, 10, 4, rg_ks, 0, "GAIN", "%.1f");
  rg_div(rg_x0 + 280, rg_y0 + 50, rg_y0 + 196);
  rg_kn(rg_x0 + 340, rg_y0 + 118, 22, rpi(27), 0, 10, 5, rg_ks, 0, "BASS", "%.1f");
  rg_kn(rg_x0 + 440, rg_y0 + 118, 22, rpi(28), 0, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
  rg_kn(rg_x0 + 540, rg_y0 + 118, 22, rpi(30), 0, 10, 5, rg_ks, 0, "TREBLE", "%.1f");
  rg_div(rg_x0 + 600, rg_y0 + 50, rg_y0 + 196);
  rg_disp(rg_x0 + 620, rg_y0 + 100, 116, 40, rpi(29), "250 Hz|500 Hz|800 Hz|1.5 kHz", "MID FREQUENCY", "");
  rg_div(rg_x0 + 756, rg_y0 + 50, rg_y0 + 196);
  rg_kn(rg_x0 + 806, rg_y0 + 118, 24, rpi(31), 0, 100, 50, rg_ks, 0, "SUB", "%.0f %%");
) : rg_p == 2 ? (
  rg_c = slider(rpi(32)) >= 0.5;
  rg_module(rg_x0, rg_y0, 856, 220, 2 + rg_c, "5F6", rg_c ? "PREAMP  -  GREYBEARD" : "PREAMP  -  TWEED");
  rg_small(rg_x0 + 84, rg_y0 + 58, "MODEL");
  rg_rad(rg_x0 + 24, rg_y0 + 76, 120, 30, rpi(32), 0, rg_kc, "TWEED");
  rg_rad(rg_x0 + 24, rg_y0 + 124, 120, 30, rpi(32), 1, rg_kc, "GREYBEARD");
  rg_div(rg_x0 + 170, rg_y0 + 50, rg_y0 + 196);
  rg_kn(rg_x0 + 250, rg_y0 + 116, 30, rpi(33), 0, 10, 5, rg_ks, 0, "VOLUME", "%.1f");
  rg_kn(rg_x0 + 380, rg_y0 + 116, 26, rpi(34), 0, 100, 50, rg_ks, 0, "BLEND", "%.0f %%");
  rg_small(rg_x0 + 380, rg_y0 + 186, "NORMAL  -  BRIGHT");
  rg_div(rg_x0 + 460, rg_y0 + 50, rg_y0 + 196);
  rg_kn(rg_x0 + 540, rg_y0 + 116, 24, rpi(35), 0, 10, 6, rg_ks, 0, "TREBLE", "%.1f");
  rg_kn(rg_x0 + 650, rg_y0 + 116, 24, rpi(36), 0, 10, 5, rg_ks, 0, "MIDDLE", "%.1f");
  rg_kn(rg_x0 + 760, rg_y0 + 116, 24, rpi(37), 0, 10, 5, rg_ks, 0, "BASS", "%.1f");
) : (
  rg_module(rg_x0, rg_y0, 856, 220, 4, "SB-80", "PREAMP  -  SOLID STATE, SEVEN-BAND GRAPHIC");
  rg_kn(rg_x0 + 80, rg_y0 + 112, 28, rpi(38), 0, 10, 5, rg_ks, 0, "GAIN", "%.1f");
  rg_kn(rg_x0 + 196, rg_y0 + 112, 24, rpi(40), 0, 10, 0, rg_ks, 0, "COMP", "%.1f");
  rg_div(rg_x0 + 260, rg_y0 + 50, rg_y0 + 196);
  rg_tog(rg_x0 + 282, rg_y0 + 98, 120, 30, rpi(39), rg_kc, "PRE-SHAPE");
  rg_small(rg_x0 + 342, rg_y0 + 150, "MID SCOOP");
  rg_div(rg_x0 + 426, rg_y0 + 50, rg_y0 + 196);
  rg_j = 0;
  loop(7,
    rg_fad(rg_x0 + 462 + rg_j * 58, rg_y0 + 66, 96, rpi(41 + rg_j), -12, 12, 0,
      rg_j == 0 ? "50" : rg_j == 1 ? "100" : rg_j == 2 ? "200" : rg_j == 3 ? "400" : rg_j == 4 ? "800" : rg_j == 5 ? "1.6K" : "3.2K");
    rg_j += 1;
  );
);

// ================================================================ POWER AMP
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 310, 180, 176, rg_tray0, "POWER AMP");
rg_w = floor(slider2 + 0.5);
rg_disp(28, 364, 156, 48, 2, PRE_LIST, "MODULE", rg_w == 0 ? "PUSH-PULL VALVES" : rg_w == 1 ? "FOUR VALVES" : rg_w == 2 ? "TWO VALVES" : "SOLID STATE");
gfx_setfont(5);  rg_col(rg_cink2, 1);
rg_tl(rg_px(28), rg_py(438), rg_w == 0 ? "Big valves on a" : rg_w == 1 ? "Feedback and a valve" : rg_w == 2 ? "PRESENCE in the" : "Big and clean, it");
rg_tl(rg_px(28), rg_py(456), rg_w == 0 ? "sagging supply" : rg_w == 1 ? "rectifier" : rg_w == 2 ? "feedback, loose lows" : "rounds off at its rails");
rg_x0 = 208;  rg_y0 = 310;
rg_w == 0 ? (
  rg_module(rg_x0, rg_y0, 320, 176, 0, "AMP HEAD", "");
  rg_kn(rg_x0 + 160, rg_y0 + 96, 28, rwi(48), 0, 10, 4, rg_ks, 0, "MASTER", "%.1f");
) : rg_w == 1 ? (
  rg_module(rg_x0, rg_y0, 320, 176, 1, "AD-200", "");
  rg_rad(rg_x0 + 24, rg_y0 + 62, 92, 28, rwi(49), 0, rg_kc, "CRUSH");
  rg_rad(rg_x0 + 24, rg_y0 + 106, 92, 28, rwi(49), 1, rg_kc, "DEEP");
  rg_kn(rg_x0 + 220, rg_y0 + 96, 26, rwi(50), 0, 10, 4, rg_ks, 0, "MASTER", "%.1f");
) : rg_w == 2 ? (
  rg_c = slider(rwi(51)) >= 0.5;
  rg_module(rg_x0, rg_y0, 320, 176, 2 + rg_c, "5F6", "");
  rg_rad(rg_x0 + 20, rg_y0 + 62, 106, 28, rwi(51), 0, rg_kc, "TWEED");
  rg_rad(rg_x0 + 20, rg_y0 + 106, 106, 28, rwi(51), 1, rg_kc, "GREYBEARD");
  rg_kn(rg_x0 + 182, rg_y0 + 96, 22, rwi(53), 0, 10, 5, rg_ks, 0, "MASTER", "%.1f");
  rg_kn(rg_x0 + 264, rg_y0 + 96, 22, rwi(52), 0, 10, 4, rg_ks, 0, "PRESENCE", "%.1f");
) : (
  rg_module(rg_x0, rg_y0, 320, 176, 4, "SB-80", "");
  rg_kn(rg_x0 + 160, rg_y0 + 92, 28, rwi(54), 0, 10, 5, rg_ks, 0, "MASTER", "%.1f");
);

// ================================================================ CABINET
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(544, 310, 180, 176, rg_tray0, "CABINET");
rg_cb = floor(slider3 + 0.5);
rg_dsh = 1;  #rgds = "Line out|8x10|8x10 sealed|4x10 sealed|1x15 ported|4x10 open|4x10|1x15";
rg_disp(556, 364, 156, 48, 3, CAB_LIST, "SPEAKERS", rg_cb == 0 ? "NO CABINET" : rg_cb == 1 ? "AMP HEAD" : rg_cb <= 4 ? "AD-200" : rg_cb == 5 ? "5F6" : "SB-80");
gfx_setfont(5);  rg_col(rg_cink2, 1);
rg_tl(rg_px(556), rg_py(438), rg_cb ? "MIC: on axis (bright)" : "The amp's line out,");
rg_tl(rg_px(556), rg_py(456), rg_cb ? "to off axis (dark)" : "no speakers");
// the 5F6 box takes the 5F6 power amp's model (or the preamp's, else the last one set)
rg_c = slider2 == 2 ? slider(rwi(51)) : slider1 == 2 ? slider(rpi(32)) : RP_ST[51];
rg_m = rg_cb == 0 ? -1 : rg_cb == 1 ? 0 : rg_cb <= 4 ? 1 : rg_cb == 5 ? 2 + (rg_c >= 0.5) : 4;
rg_x0 = 736;  rg_y0 = 310;
rg_m >= 0 ? (
  rg_livery(rg_m);
  rg_i = 0;  loop(4, rg_col(0x000000, 0.13);  rg_rect(rg_x0 + 2 + rg_i * 1.33, rg_y0 + 3 + rg_i * 1.67, 328 + rg_i * 0.6, 176 + rg_i * 0.6);  rg_i += 1; );
  rg_col(rg_m == 2 ? 0x2A2420 : rg_plate, 1);  rg_rect(rg_x0, rg_y0, 328, 176);
  // the grille: Amp Head's perforated metal, the AD-200's black cloth with gold piping, the 5F6's tweed-era cloth,
  // the SB-80's black mesh
  rg_gc = rg_m == 0 ? 0x1C1D20 : rg_m == 1 ? 0x101215 : rg_m == 2 ? 0x8C7350 : rg_m == 3 ? 0x2A2C2F : 0x161718;
  rg_col(rg_gc, 1);  rg_rect(rg_x0 + 14, rg_y0 + 14, 170, 148);
  rg_m == 0 ? (
    rg_i = 0;  loop(14, rg_j = 0;  loop(12, rg_col(0x5A5E66, 0.7);  gfx_circle(rg_px(rg_x0 + 22 + rg_i * 11.6 + (rg_j % 2) * 5.8), rg_py(rg_y0 + 22 + rg_j * 12), rg_ps(2), 1, 1);  rg_j += 1; );  rg_i += 1; );
  ) : rg_m == 1 ? (
    rg_i = 0;  loop(42, rg_col(0xFFFFFF, 0.04);  rg_rect(rg_x0 + 14 + rg_i * 4.05, rg_y0 + 14, 1, 148);  rg_col(0x000000, 0.2);  rg_rect(rg_x0 + 14, rg_y0 + 14 + rg_i * 3.5, 170, 1);  rg_i += 1; );
    rg_col(rg_acc, 0.8);  rg_rect(rg_x0 + 10, rg_y0 + 10, 178, 2);  rg_rect(rg_x0 + 10, rg_y0 + 164, 178, 2);
    rg_rect(rg_x0 + 10, rg_y0 + 10, 2, 156);  rg_rect(rg_x0 + 186, rg_y0 + 10, 2, 156);
  ) : rg_m <= 3 ? (
    rg_i = 0;  loop(56, rg_col(rg_m == 2 ? 0x3A2A18 : 0x000000, 0.16);  rg_rect(rg_x0 + 14 + rg_i * 3.04, rg_y0 + 14, 1, 148);
      rg_col(0xFFFFFF, 0.05);  rg_rect(rg_x0 + 14, rg_y0 + 14 + rg_i * 2.64, 170, 1);  rg_i += 1; );
  ) : (
    rg_i = 0;  loop(30, rg_col(0x46484C, 0.6);  rg_rect(rg_x0 + 14 + rg_i * 5.67, rg_y0 + 14, 1, 148);  rg_rect(rg_x0 + 14, rg_y0 + 14 + rg_i * 4.93, 170, 1);  rg_i += 1; );
    rg_col(rg_acc, 0.8);  rg_rect(rg_x0 + 14, rg_y0 + 158, 170, 4);
  );
  rg_col(0x000000, 0.4);  rg_rect(rg_x0 + 14, rg_y0 + 14, 170, 2);  rg_rect(rg_x0 + 14, rg_y0 + 14, 2, 148);
  gfx_setfont(6);  #rgcn = rg_cb == 1 || rg_cb == 2 ? "8 x 10" : rg_cb == 3 || rg_cb == 6 ? "4 x 10" : rg_cb == 5 ? "4 x 10" : "1 x 15";
  gfx_measurestr(#rgcn, rg_tw, rg_th);
  rg_col(0x000000, 0.55);  gfx_rect(rg_px(rg_x0 + 99) - rg_tw * 0.5 - rg_ps(8), rg_py(rg_y0 + 88) - rg_th * 0.5 - rg_ps(3), rg_tw + rg_ps(16), rg_th + rg_ps(6), 1);
  rg_col(0xEDE4D0, 1);  rg_tc(rg_px(rg_x0 + 99), rg_py(rg_y0 + 88), #rgcn);
  rg_col(0x000000, 0.25);  rg_rect(rg_x0, rg_y0 + 174, 328, 2);  rg_rect(rg_x0 + 326, rg_y0, 2, 174);
  rg_m == 2 ? ( rg_ink = 0xEDE4D0;  rg_ink2 = 0xB9AE98;  rg_plate = 0x2A2420; );   // (light print on the tweed box's dark side)
  gfx_setfont(5);  rg_col(rg_ink2, 1);
  rg_tc(rg_px(rg_x0 + 256), rg_py(rg_y0 + 24), rg_cb == 2 || rg_cb == 3 ? "SEALED" : rg_cb == 4 ? "PORTED" : rg_cb == 5 ? "OPEN BACK" : "");
  rg_kn(rg_x0 + 256, rg_y0 + 86, 24, 4, 0, 10, 3, rg_ks, 0x75787D, "MIC", "%.1f");
  rg_small(rg_x0 + 256, rg_y0 + 150, "ON - OFF AXIS");
) : (
  rg_tray(rg_x0, rg_y0, 328, 176, rg_tray0, "");
  gfx_setfont(6);  rg_col(rg_cink2, 1);  rg_tc(rg_px(rg_x0 + 164), rg_py(rg_y0 + 80), "LINE OUT");
  gfx_setfont(5);  rg_tc(rg_px(rg_x0 + 164), rg_py(rg_y0 + 104), "the amp without a cabinet");
);

// ================================================================ IN / OUT
rg_livery(0);  rg_plate = rg_tray0;  rg_ink = rg_cink;  rg_ink2 = rg_cink2;
rg_tray(16, 502, 1048, 142, rg_tray0, "IN / OUT");
rg_tog(40, 546, 110, 30, 6, 0xF2A41E, "MONO IN");
rg_tog(40, 594, 110, 30, 10, 0x5FC4C0, "GUARD");
rg_kn(280, 582, 20, 9, -24, 12, 0, 0, 0xE6E3DC, "TRIM", "%+.1f dB");
rg_kn(400, 582, 20, 7, -80, -20, -80, 0, 0x8A8C86, "GATE", slider7 <= -79.5 ? "off" : "%.0f dB");
rg_kn(520, 582, 20, 5, 0, 100, 0, 0, 0x7FB2DC, "DI", "%.0f %%");
rg_kn(640, 582, 20, 11, 0, 100, 50, 0, 0x6F8794, "DRIFT", "%.0f %%");
rg_kn(760, 582, 20, 12, -24, 12, 0, 0, 0xE0A030, "OUTPUT", "%+.1f dB");
// the output meter: L / R LED bars, -42 .. +3 dBFS in 3 dB steps, the peak held 1.2 s then falling
!rg_minit ? ( rg_hl = rg_hr = -120;  rg_minit = 1; );
rg_ml = max(rp_pkL_disp, rg_ml * 0.85);  rg_mr = max(rp_pkR_disp, rg_mr * 0.85);  rp_pkL_disp = rp_pkR_disp = 0;
rg_now = time_precise();
rg_j = 0;
loop(2,
  rg_v = rg_j ? rg_mr : rg_ml;  rg_db = rg_v > 0.000001 ? 20 * log10(rg_v) : -120;
  rg_db >= (rg_j ? rg_hr : rg_hl) || rg_now - (rg_j ? rg_tmr : rg_tml) > 1.2 ? (
    rg_db >= (rg_j ? rg_hr : rg_hl) ? ( rg_j ? ( rg_hr = rg_db; rg_tmr = rg_now; ) : ( rg_hl = rg_db; rg_tml = rg_now; ); ) :
      ( rg_j ? rg_hr = max(rg_db, rg_hr - 0.6) : rg_hl = max(rg_db, rg_hl - 0.6); );
  );
  rg_mx = 1000 + rg_j * 22;
  rg_col(0x0E0D0C, 1);  rg_rect(rg_mx, 520, 18, 100);
  rg_i = 0;
  loop(15,
    rg_d = -42 + rg_i * 3;
    rg_col(rg_d >= 0 ? 0xE0503A : rg_d >= -9 ? 0xF2A41E : 0x5FC4C0, rg_db >= rg_d ? 1 : 0.14);
    rg_rect(rg_mx + 3, 616 - (rg_i + 1) * 6.4 + 1, 12, 5);
    rg_i += 1;
  );
  rg_h = rg_j ? rg_hr : rg_hl;
  rg_h > -42 ? ( rg_col(0xFFFFFF, 0.95);  rg_rect(rg_mx + 2, 616 - (floor((min(rg_h, 3) + 42) / 3) + 1) * 6.4 + 1, 14, 2); );
  rg_j += 1;
);
rg_click && rg_in(1000, 520, 40, 100) ? rg_hl = rg_hr = -120;   // clear the peaks
gfx_setfont(5);  rg_col(rg_cink2, 1);  rg_tc(rg_px(1009), rg_py(630), "L");  rg_tc(rg_px(1031), rg_py(630), "R");

// ---------- OS key (house): left of the S / M / L / ? picker; cycles 1x -> 2x -> 4x ----------
os_key(rg_ox / sc + 956, rg_oy / sc + 18, 8, 0xE0A030, 12);

// ---------- S / M / L / ? (size picker and credits), four 13 x 18 keys on a 14 pitch ----------
rg_j = 0;
loop(4,
  rg_gx = 1006 + rg_j * 14;  rg_on = rg_j == 0 ? ui_sz == 1 : rg_j == 1 ? ui_sz == 0 : rg_j == 2 ? ui_sz == 2 : rg_help;
  rg_col(0x050302, 1);  rg_rect(rg_gx, 20, 13, 18);
  rg_col(rg_on ? 0xFFB347 : 0x3A3632, 1);  rg_rect(rg_gx + 1, 21, 11, 16);
  gfx_setfont(5);  rg_col(rg_on ? 0x140D06 : 0xE0C8A0, 1);  rg_tc(rg_px(rg_gx + 6.5), rg_py(29), rg_j == 0 ? "S" : rg_j == 1 ? "M" : rg_j == 2 ? "L" : "?");
  rg_click && !rg_help && rg_in(rg_gx, 20, 13, 18) ? (
    rg_j == 0 ? ui_sz = 1 : rg_j == 1 ? ui_sz = 0 : rg_j == 2 ? ui_sz = 2 : ( rg_help = 1;  rg_hnew = 1; );
  );
  rg_j += 1;
);
// the card: credits, website, manual; a click anywhere closes it
strcpy(#rgh3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#rgh3, #ui_man);  strcat(#rgh3, ".pdf");
gfx_setfont(5);  gfx_measurestr(#rgh3, rg_tw, rg_th);
rg_cw = max(rg_tw + rg_ps(40), rg_ps(440));  rg_ch = rg_ps(140);
rg_cx = (gfx_w - rg_cw) * 0.5;  rg_cy = (gfx_h - rg_ch) * 0.5;
rg_help && rg_hclick && !rg_hnew ? ( rg_help = 0;  rg_hclick = 0; );
rg_hnew = 0;
rg_help ? (
  rg_col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  rg_col(0x000000, 0.5);  rg_rrs(rg_cx + rg_ps(3), rg_cy + rg_ps(5), rg_cw, rg_ch, rg_ps(8));
  rg_col(0x1C1D20, 1);    rg_rrs(rg_cx, rg_cy, rg_cw, rg_ch, rg_ps(8));
  rg_col(0xE0A030, 1);    gfx_rect(rg_cx + rg_ps(20), rg_cy + rg_ps(36), rg_cw - rg_ps(40), max(1, rg_ps(1)), 1);
  gfx_setfont(6);  rg_col(0xF2F2EE, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  rg_col(0xE8B23A, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  rg_col(0xD8D6D0, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(72);  gfx_drawstr(#rgh3);
  rg_col(0x85837E, 1);  gfx_x = rg_cx + rg_ps(20);  gfx_y = rg_cy + rg_ps(110);  gfx_drawstr("Click anywhere to close.");
);

// ---------- end of frame ----------
!rg_lmb ? rg_drag = 0;
mouse_wheel = 0;
rg_llmb = rg_lmb;
