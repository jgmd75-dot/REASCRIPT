desc:GFX Lab OC77 [utility]
//tags: soundscape noise generator ocean waves wind rain calibration utility
//author: JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-uimin, gfx-lab-bverb (.jsfx-inc) in the same folder.
//
// OC77 - a coastal soundscape generator and a calibrated noise generator, in the spirit of vintage analogue noise
// generators and immersive environmental soundscape synthesisers. Every sound is synthesised (no samples).
//
// SIGNAL FLOW (SOUNDSCAPE)
//   NOISE CORE: white, pink and brown noise, left and right their own.
//   WAVES: breakers on the shore, each with its own life - the swell building as a low rumble, the crash (a burst of
//   bright noise), the wash running up the sand, then the backwash drawing away. WAVE RATE sets how often they come
//   (0.05 - 0.5 a second, never quite regular; two can overlap). SHORELINE LICK: the foam - fizzing, popping bubbles
//   and splash on the wash. Behind them the distant swell rolls slowly.
//   WIND: noise through two moving resonances, in gusts (WIND GUST: how much air moves); strong gusts whistle a little.
//   RAIN: droplets (RAIN DENSITY: from a few drops to a downpour), each a tiny bright tick somewhere in the field, over
//   a soft hiss of rain.
//   THICK (the small grey key, red LED): a deep low rumble - the body of the ocean under it all.
//   NOISE LEVEL adds the raw noise (NOISE TYPE) to the scene (-inf by default).
//   FILTER CUTOFF: a gentle low-pass over the whole scene (warm and muffled down low, open at the top).
//   -> output stage (mix tool: no saturation, the house -0.3 dBFS ceiling as a safety) -> LEVEL
// IN (amber; off when it loads, so a new instance is silent): fades the generator in and out.
// EFFECTS (the EFFECTS page; for the soundscape only - they fade out in CALIBRATION; their tails ring on after IN):
//   CHORUS (RATE, DEPTH, MIX) -> DELAY (TIME: a note value with SYNC lit, or ms; FEEDBACK, MIX) -> REVERB (the house
//   engine: SIZE, DECAY, MIX) -> WIDTH (0 - 200 %, "0" marks normal; the last stage). Each has a title lamp (in / out,
//   crossfaded) and its own HPF and LPF on what it works on (readouts under them): keep the lows out of the reverb,
//   darken the echoes (the delay's sit in its loop, so each repeat is darker), widen only the top.
// DRIFT (0 - 100 %, 50 % = standard; SOUNDSCAPE only - calibration noise stays exact): the air pressure wanders (the
//   whole scene's level and warmth breathe slowly), sea-breeze micro-fluctuations in the wind, and a faint analogue
//   noise floor whose level drifts with temperature.
// GUI: two pages, SEA and EFFECTS (keys top right), the preset bar top left, S / M / L / ?. SEA page: the SHORELINE
//   window (the last 10 seconds of the output rolling in from the right - the body solid, the spray fainter) and the
//   SPECTRUM window (the noise's density in 1/3 octaves, 20 Hz - 20 kHz: pink noise reads flat); both stay live in
//   CALIBRATION, where the sea's controls rest (greyed). NOISE: type keys, level (readout under it), MEASURED, BAND,
//   CHANNELS. OUTPUT: MODE keys, IN, LEVEL, DRIFT, L / R meters.
// PRESETS (the soundscapes level-matched at -20 LUFS; IN is never changed by a preset): Default, Gentle Evening
//   Shoreline, Deep Ocean Swells, Coastal Gale, Midnight Rain, Calibrated White Noise / Calibrated Pink Noise
//   (-20 dBFS RMS, full band), Brown Noise Room Test (-20 dBFS RMS, mono), Distant Surf, Stormy Beach.
// Latency: 0 samples.
//
// CALIBRATION (the MODE key): a precise noise generator - no scene, no effects, no DRIFT, OUTPUT LEVEL bypassed.
//   NOISE TYPE: WHITE, PINK or BROWN. NOISE LEVEL: the RMS level of what comes out, in dBFS, exactly (each channel),
//   for the BAND chosen - the gain is worked out from the noise's spectrum and the filters' exact responses, so
//   -20 dB reads -20.0 dBFS RMS on a meter. BAND: FULL (20 Hz - 20 kHz), 500 Hz - 2 kHz (speaker calibration),
//   20 - 80 Hz (sub), or one octave (31.5 Hz - 16 kHz); 4th-order Butterworth edges. CHANNELS: STEREO (uncorrelated),
//   MONO (L = R), LEFT or RIGHT only. A change of type, band or channels dips for 10 ms and comes back - no clicks.
//   MEASURED: the true RMS of the output (1 s average), shown under the level. Peaks: noise runs about 12 dB above its
//   RMS, so above about -12 dBFS RMS the -0.3 dBFS safety ceiling starts to touch the peaks.
// STATUS: v1.0 - in the Lab (Oct 2026).

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-uimin.jsfx-inc
import gfx-lab-bverb.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider1:mode=0<0,1,1{Soundscape,Calibration}>-Mode
slider2:ntype=1<0,2,1{White,Pink,Brown}>-Noise type
slider3:nlev=-61<-61,0,0.1>-Noise level (dB, -61 = off)
slider4:wrate=0.1<0.05,0.5,0.001:log>-Wave rate (Hz)
slider5:lick=40<0,100,1>-Shoreline lick (%)
slider6:wind=30<0,100,1>-Wind gust (%)
slider7:rain=0<0,100,1>-Rain density (%)
slider8:cutoff=5000<20,20000,1:log>-Filter cutoff (Hz)
slider9:vol=0<-18,6,0.1>-Output level (dB)
slider10:drift=50<0,100,1>-Drift (%)
slider11:in_on=0<0,1,1{Off,In}>-In
slider12:thick=0<0,1,1{Off,On}>-Thick
slider13:ch_on=0<0,1,1{Out,In}>-Chorus
slider14:ch_rate=0.4<0.05,4,0.001:log>-Chorus rate (Hz)
slider15:ch_dep=40<0,100,1>-Chorus depth (%)
slider16:ch_mix=35<0,100,1>-Chorus mix (%)
slider17:ch_hpf=120<20,2000,1:log>-Chorus HPF (Hz)
slider18:ch_lpf=12000<1000,20000,1:log>-Chorus LPF (Hz)
slider19:wd_on=0<0,1,1{Out,In}>-Width
slider20:width=140<0,200,1>-Width (%)
slider21:wd_hpf=300<20,2000,1:log>-Width HPF (Hz)
slider22:wd_lpf=20000<1000,20000,1:log>-Width LPF (Hz)
slider23:dl_on=0<0,1,1{Out,In}>-Delay
slider24:dl_sync=1<0,1,1{Free,Sync}>-Delay time mode
slider25:dl_div=7<0,12,1{1/32,1/16T,1/16,1/8T,1/16D,1/8,1/4T,1/8D,1/4,1/2T,1/4D,1/2,1 bar}>-Delay time (sync)
slider26:dl_ms=450<20,2000,1:log>-Delay time (ms)
slider27:dl_fb=35<0,95,1>-Delay feedback (%)
slider28:dl_mix=25<0,100,1>-Delay mix (%)
slider29:dl_hpf=200<20,2000,1:log>-Delay HPF (Hz)
slider30:dl_lpf=6000<1000,20000,1:log>-Delay LPF (Hz)
slider31:rv_on=0<0,1,1{Out,In}>-Reverb
slider32:rv_size=70<0,100,1>-Reverb size (%)
slider33:rv_decay=4<0.5,20,0.1:log>-Reverb decay (s)
slider34:rv_mix=25<0,100,1>-Reverb mix (%)
slider35:rv_hpf=150<20,2000,1:log>-Reverb HPF (Hz)
slider36:rv_lpf=9000<1000,20000,1:log>-Reverb LPF (Hz)
slider37:band=0<0,12,1{Full (20 Hz - 20 kHz),500 Hz - 2 kHz (speakers),20 - 80 Hz (sub),31.5 Hz octave,63 Hz octave,125 Hz octave,250 Hz octave,500 Hz octave,1 kHz octave,2 kHz octave,4 kHz octave,8 kHz octave,16 kHz octave}>-Calibration band
slider38:chans=0<0,3,1{Stereo (uncorrelated),Mono (L = R),Left only,Right only}>-Calibration channels
slider39:prs_sel=0<0,10,1{No preset,Default,Gentle Evening Shoreline,Deep Ocean Swells,Coastal Gale,Midnight Rain,Calibrated White Noise,Calibrated Pink Noise,Brown Noise Room Test,Distant Surf,Stormy Beach}>-Preset

@init
#ui_man = "gfx-lab-oc77";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 32;
WV = 100;  WS = 32;                      // two wave records: WV + w * WS
DR = 200;  DS = 8;  NDR = 10;            // rain drops: DR + d * DS
W_ON = 0;  W_U = 1;  W_DU = 2;  W_STR = 3;  W_PAN = 4;  W_F = 5;  W_A = 6;  W_FZ = 7;  W_FA = 8;  W_FT = 9;  W_AT = 10;
W_L1 = 11;  W_L2 = 12;  W_R1 = 13;  W_R2 = 14;  W_G = 15;  W_BR = 16;  W_FG = 17;  W_HL = 18;  W_HR = 19;  W_BUB = 20;  W_BL = 21;  W_BR2 = 22;
memset(WV, 0, 2 * WS);  memset(DR, 0, NDR * DS);
CHB = 40000;  CHN = 4096;                // the chorus lines (L, R)
FX_MEM = 1048576;                        // the reverb (house engine) lines
DLB = 3000000;  DLN = 524288;            // the delay lines (L, R): up to 2.7 s at 192 kHz
VB = 60000;  VBN = 8192;                  // the visualisers: the output (mono) for the spectrum ...
VP = 70000;  VPN = 512;  VPB = 2048;      // ... and the shoreline: peak and RMS of every 2048 samples (VP + 2i, + 2i + 1)
FB = 131072;                              // the spectrum's FFT (8192 complex, inside one 65536 block)
SPB = 150000;  SPN = 31;                  // the spectrum's bands (1/3 octave, 20 Hz - 20 kHz): smoothed power
memset(CHB, 0, 2 * CHN);  memset(DLB, 0, 2 * DLN);
bv_alloc(FX_MEM);  RVM = 1900;  RVB = 1910;  k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );

// ---------- helpers ----------
function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
// TPT state-variable filter, one per instance: set g / k, then run: lp, bp, hp out
function svf_set(f, q) instance(g, k) ( g = tan($pi * min(max(f, 10), 0.45 * srate) / srate);  k = 1 / max(q, 0.1); );
function svf(x) instance(g, k, s1, s2, lp, bp, hp) local(a1, v1, v2, v3) (
  a1 = 1 / (1 + g * (g + k));  v3 = x - s2;  v1 = a1 * s1 + g * a1 * v3;  v2 = s2 + g * v1;
  s1 = 2 * v1 - s1;  s2 = 2 * v2 - s2;  lp = v2;  bp = v1;  hp = x - k * v1 - v2;  lp;
);
// the noise core: white -> pink (Kellet's filter) -> brown (leaky integrator), per channel
function nz_run() instance(w, b0, b1, b2, pk, br) (
  w = rand(2) - 1;
  b0 = 0.99765 * b0 + w * 0.0990460;  b1 = 0.96300 * b1 + w * 0.2965164;  b2 = 0.57000 * b2 + w * 1.0526913;
  pk = (b0 + b1 + b2 + w * 0.1848) * 0.11;
  br = (br + 0.02 * w) / 1.02;
  w;
);

// ---------- a wave: build, crash, wash, backwash ----------
// u runs 0 -> 1 over the wave's life; its level, brightness and foam follow the shape below (TWEAK)
function w_shape(b) local(u, a, f, fz) (
  u = b[W_U];
  u < 0.35 ? ( a = 0.35 * (u / 0.35) ^ 2;  f = 160 + 500 * u / 0.35;  fz = 0; ) :                        // the swell builds
  u < 0.42 ? ( a = 0.35 + 0.65 * (u - 0.35) / 0.07;  f = 660 + 5000 * (u - 0.35) / 0.07;  fz = 0.3 * (u - 0.35) / 0.07; ) :   // it breaks
  u < 0.72 ? ( a = 1 - 0.55 * (u - 0.42) / 0.3;  f = 5660 - 3800 * (u - 0.42) / 0.3;  fz = 0.3 + 0.7 * min(1, (u - 0.42) / 0.1); ) :   // the wash runs up
  ( a = 0.45 * (1 - (u - 0.72) / 0.28) ^ 1.6;  f = 1860 - 1100 * (u - 0.72) / 0.28;  fz = (1 - (u - 0.72) / 0.28) ^ 1.2; );   // the backwash
  b[W_AT] = a * b[W_STR];  b[W_FT] = f * (0.8 + 0.4 * b[W_BR]);  b[W_FA] = fz * b[W_STR];
);
function w_start(b) (
  b[W_ON] = 1;  b[W_U] = 0;  b[W_STR] = 0.55 + rand(1) * 0.45;  b[W_PAN] = (rand(2) - 1) * 0.6;  b[W_BR] = rand(1);
  b[W_DU] = CR / ((1.4 + rand(1) * 0.6) / max(wrate, 0.01) * srate);    // a wave lives 1.4 - 2 cycles: they overlap
);

wl.svf_set(400, 0.7);  wr.svf_set(400, 0.7);  fl.svf_set(3000, 0.7);  fr.svf_set(3000, 0.7);
nL.w = 0;  nR.w = 0;  wv_t = 0;  sw_ph = 0;  gust = 0;  gust_t = 0;  in_x = 0;  th_x = 0;  sc_x = 1;  cr_n = 0;
pw.drift_init(0.4 + rand(1) * 0.3);  bz.drift_init(1.5 + rand(1) * 0.5);  tf.drift_init(0.6 + rand(1) * 0.3);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
cal_key = -1;  cal_pend = 0;  cal_dk = 0;  cal_g = 0;  cal_x = 0;  cal_ms = 0;
ch_w = 0;  ch_ph = 0;  dl_w = 0;  dtm_s = -1;  ch_x = 0;  wd_x = 0;  dl_x = 0;  rv_x = 0;  sz_cur = 0.3 + 0.7 * rv_size / 100;  rvd_s = rv_decay;
// ---------- CALIBRATION: the exact gain for a type and band ----------
// |H|^2 of a TPT state-variable section (cut-off fc, k = 1/Q) at f: the bilinear image of the analogue one
function svf_p(fc, k, f, hp) local(w, x) (
  w = tan($pi * min(f, 0.4999 * srate) / srate) / tan($pi * min(fc, 0.45 * srate) / srate);  x = sqr(1 - w * w) + sqr(k * w);
  hp ? w ^ 4 / x : 1 / x;
);
// the band's edges (4th-order Butterworth: two sections, Q 0.5412 and 1.3066)
function cal_edges(b) local(c) (
  b = floor(b + 0.5);
  b == 0 ? ( cal_hn = 20;  cal_ln = 20000; ) : b == 1 ? ( cal_hn = 500;  cal_ln = 2000; ) : b == 2 ? ( cal_hn = 20;  cal_ln = 80; ) :
  ( c = 31.5 * 2 ^ (b - 3);  cal_hn = c / sqrt(2);  cal_ln = c * sqrt(2); );
  cal_ln = min(cal_ln, 0.45 * srate);
);
// the power that comes out of the generator (type t) through the band, by integrating its spectrum (1 Hz .. fs/2)
function cal_power(t, b) local(i, n, f, f0, df, w, p, re, im, d, a, c, k, sum, pw) (
  cal_edges(b);  n = 3000;  sum = 0;  f0 = 1;
  i = 0;
  loop(n,
    f = 1 * (0.4999 * srate) ^ ((i + 0.5) / n);  df = f * log(0.4999 * srate) / n;      // log-spaced, df = f d(ln f)
    w = 2 * $pi * f / srate;
    t == 0 ? p = 1 :
    t == 1 ? (                                                            // pink: 0.11 x (three one-poles + 0.1848)
      re = 0.1848;  im = 0;  k = 0;
      loop(3, a = k == 0 ? 0.99765 : k == 1 ? 0.963 : 0.57;  c = k == 0 ? 0.099046 : k == 1 ? 0.2965164 : 1.0526913;
        d = 1 - 2 * a * cos(w) + a * a;  re += c * (1 - a * cos(w)) / d;  im -= c * a * sin(w) / d;  k += 1; );
      p = (re * re + im * im) * 0.0121;
    ) : (                                                                 // brown: (0.02 / 1.02) / (1 - z^-1 / 1.02)
      a = 1 / 1.02;  p = sqr(0.02 / 1.02) / (1 - 2 * a * cos(w) + a * a);
    );
    pw = svf_p(cal_hn, 1 / 0.5412, f, 1) * svf_p(cal_hn, 1 / 1.3066, f, 1) * svf_p(cal_ln, 1 / 0.5412, f, 0) * svf_p(cal_ln, 1 / 1.3066, f, 0);
    sum += p * pw * df;
    i += 1;
  );
  sum * (1 / 3) / (0.5 * srate);                                          // white noise: variance 1/3 spread over 0 .. fs/2
);
function div_beats(d) ( d = floor(d + 0.5);
  d == 0 ? 0.125 : d == 1 ? 1 / 6 : d == 2 ? 0.25 : d == 3 ? 1 / 3 : d == 4 ? 0.375 : d == 5 ? 0.5 : d == 6 ? 2 / 3 : d == 7 ? 0.75 :
  d == 8 ? 1 : d == 9 ? 4 / 3 : d == 10 ? 1.5 : d == 11 ? 2 : 4; );

function update_params() (
  drift_macro(drift);
  sm_c = 1 - exp(-1 / (0.03 * srate));  sw_c = 1 - exp(-1 / (0.05 * srate));     // knobs glide 30 ms, IN / modes fade 50 ms
  out_t = 10 ^ (vol / 20);
  nz_t = nlev <= -60.95 ? 0 : 10 ^ (nlev / 20);
  lick_t = lick / 100;  wind_t = wind / 100;  rain_t = rain / 100;
  drop_rate = rain_t ^ 2 * 450;                                         // RAIN: drops a second
  // the effects: each one's own HPF / LPF on what goes into it
  chh_l.svf_set(ch_hpf, 0.707);  chh_r.svf_set(ch_hpf, 0.707);  chl_l.svf_set(ch_lpf, 0.707);  chl_r.svf_set(ch_lpf, 0.707);
  wdh.svf_set(wd_hpf, 0.707);  wdl.svf_set(wd_lpf, 0.707);
  dlh_l.svf_set(dl_hpf, 0.707);  dlh_r.svf_set(dl_hpf, 0.707);  dll_l.svf_set(dl_lpf, 0.707);  dll_r.svf_set(dl_lpf, 0.707);
  rvh_l.svf_set(rv_hpf, 0.707);  rvh_r.svf_set(rv_hpf, 0.707);  rvl_l.svf_set(rv_lpf, 0.707);  rvl_r.svf_set(rv_lpf, 0.707);
  chm_t = ch_mix / 100;  chd_t = ch_dep / 100;  wdt = width / 100;  dfb_t = dl_fb / 100 * 0.95;  dmx_t = dl_mix / 100;  rmx_t = rv_mix / 100;
  dtm_c = 1 - exp(-1 / (0.15 * srate));
  cdk_c = 1 - exp(-1 / (0.002 * srate));  cms_c = 1 - exp(-1 / (1 * srate));      // the calibration dip (10 ms), the meter's 1 s average
);
update_params();
chm_g = chm_t;  chd_g = chd_t;  wd_g = wdt;  dfb_g = dfb_t;  dmx_g = dmx_t;  rmx_g = rmx_t;
out_g = out_t;  nz_g = nz_t;  lick_g = lick_t;  wind_g = wind_t;  rain_g = rain_t;  cut_s = cutoff;

// (moved here from @gfx: the PRESET parameter loads presets on the audio side)
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function param_touched_au(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 0); pv(2, 1); pv(3, -61); pv(4, 0.1); pv(5, 40); pv(6, 30); pv(7, 0); pv(8, 5000); pv(9, 0); pv(10, 50); pv(12, 0);
  pv(13, 0); pv(14, 0.4); pv(15, 40); pv(16, 35); pv(17, 120); pv(18, 12000); pv(19, 0); pv(20, 140); pv(21, 300); pv(22, 20000);
  pv(23, 0); pv(24, 1); pv(25, 7); pv(26, 450); pv(27, 35); pv(28, 25); pv(29, 200); pv(30, 6000);
  pv(31, 0); pv(32, 70); pv(33, 4); pv(34, 25); pv(35, 150); pv(36, 9000); pv(37, 0); pv(38, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? ( pv(4, 0.08);  pv(5, 55);  pv(6, 12);  pv(8, 6500);  pv(9, -0.3);  pv(19, 1);  pv(20, 130);  pv(31, 1);  pv(32, 60);  pv(33, 3);  pv(34, 18); );   // Gentle Evening Shoreline
  p == 3 ? ( pv(4, 0.06);  pv(5, 12);  pv(6, 20);  pv(8, 1100);  pv(9, 1.4);  pv(12, 1);  pv(31, 1);  pv(32, 95);  pv(33, 7);  pv(34, 30);  pv(35, 80);  pv(36, 4000); );   // Deep Ocean Swells
  p == 4 ? ( pv(4, 0.2);  pv(5, 70);  pv(6, 92);  pv(7, 12);  pv(8, 10000);  pv(9, -8.6);  pv(12, 1);  pv(13, 1);  pv(14, 0.3);  pv(15, 50);  pv(16, 25);  pv(19, 1);  pv(20, 160); );   // Coastal Gale
  p == 5 ? ( pv(4, 0.07);  pv(5, 18);  pv(6, 8);  pv(7, 65);  pv(8, 4200);  pv(9, -1.9);  pv(19, 1);  pv(20, 140);  pv(31, 1);  pv(32, 70);  pv(33, 3.5);  pv(34, 24); );   // Midnight Rain
  p == 6 ? ( pv(1, 1);  pv(2, 0);  pv(3, -20); );   // Calibrated White Noise
  p == 7 ? ( pv(1, 1);  pv(2, 1);  pv(3, -20); );   // Calibrated Pink Noise
  p == 8 ? ( pv(1, 1);  pv(2, 2);  pv(3, -20);  pv(38, 1); );   // Brown Noise Room Test
  p == 9 ? ( pv(4, 0.09);  pv(5, 8);  pv(6, 25);  pv(8, 850);  pv(9, 1.8);  pv(12, 1);  pv(23, 1);  pv(24, 0);  pv(25, 9);  pv(26, 620);  pv(27, 30);  pv(28, 14);  pv(29, 250);  pv(30, 2200);  pv(31, 1);  pv(32, 100);  pv(33, 8);  pv(34, 40);  pv(35, 120);  pv(36, 3500); );   // Distant Surf
  p == 10 ? ( pv(4, 0.3);  pv(5, 85);  pv(6, 75);  pv(7, 80);  pv(8, 12000);  pv(9, -10.0);  pv(12, 1);  pv(19, 1);  pv(20, 150);  pv(31, 1);  pv(32, 80);  pv(33, 4);  pv(34, 22); );   // Stormy Beach
  i = 1;  loop(38, i != 11 ? param_touched_au(i);  i += 1; );      // IN is never changed by a preset
);

// PRESET parameter (JG, 28 Oct 2026: accessibility - a screen reader reaches the presets through REAPER's parameter list).
// A change of prs_sel (a screen reader, the host, automation) loads that preset (0 = No preset: nothing loaded); the preset bar asks through
// prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project or recalling its
// state never reloads a preset over the saved settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_params();

@block
prs_chk();
prm_dirty ? ( prm_dirty = 0;  update_params(); );
bt = samplesblock / srate;
// DRIFT (soundscape only): the air pressure (the scene's level and warmth), the breeze, the noise floor's temperature
dsc = mode < 0.5 ? dm_a : 0;
p_w = pw.drift_tick(0.05 * bt * dm_s) * dsc;
b_w = bz.drift_tick(0.6 * bt * dm_s) * dsc;
t_w = tf.drift_tick(0.1 * bt * dm_s) * dsc;
// WIND: gusts - a new target now and then, more often and stronger with WIND GUST
gust_t -= bt;  gust_t <= 0 ? ( gust_t = (1.5 + rand(1) * 5) / (0.4 + wind_t * 1.6);  gust_tg = rand(1) ^ (1.5 - wind_t); );
gust += (gust_tg - gust) * min(1, bt / 1.2);
ost_setup(0, 0, 120, 6000, -0.3, 1);                                  // a mix tool: no saturation; -0.3 dBFS ceiling as a safety
opkl_d = max(opkl_d, pkl);  opkr_d = max(opkr_d, pkr);  pkl = 0;  pkr = 0;
// CALIBRATION: a new type / band / channel layout - work out the gain now, swap it in while the output dips
g_key = floor(ntype + 0.5) * 1000 + floor(band + 0.5) * 10 + floor(chans + 0.5);
g_key != cal_key && !cal_pend ? (
  cal_nt = floor(ntype + 0.5);  cal_nb = floor(band + 0.5);  cal_nc = floor(chans + 0.5);
  cal_np = cal_power(cal_nt, cal_nb);  cal_nhn = cal_hn;  cal_nln = cal_ln;
  cal_key = g_key;  cal_pend = 1;
);
cal_tg = nlev <= -60.95 ? 0 : 10 ^ (nlev / 20) / sqrt(max(cal_p, 0.0000000001));
cal_rms_d = sqrt(cal_ms);
// DELAY: the time (a note value at the tempo, or ms), in samples
dtm_t = max(0.01, min(DLN / srate - 0.01, dl_sync >= 0.5 ? div_beats(dl_div) * 60 / max(tempo, 20) : dl_ms / 1000)) * srate;
dtm_s < 0 ? dtm_s = dtm_t;
// REVERB (house engine): SIZE sets the line lengths (gliding), DECAY the T60
kb2 = min(1, samplesblock / (0.25 * srate));  rvd_s += (rv_decay - rvd_s) * kb2;
sz_t = 0.3 + 0.7 * rv_size / 100;  sz_c = 1 - exp(-1 / (0.3 * srate));
k = 0;
loop(8,
  ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
  RVB[k] = ms * 0.001 * srate * 1.6;  ln_len[k] = RVB[k] * sz_cur;
  RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
  ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
  k += 1;
);
bv_t60 = rvd_s;  bv_rtlo = 1.15;  bv_rthi = 0.7;
k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
bv_xover();
wv0_d = WV[W_ON] ? WV[W_A] : 0;  wv1_d = WV[WS + W_ON] ? WV[WS + W_A] : 0;

@sample
// ---------- control tick ----------
cr_n <= 0 ? (
  cr_n = CR;
  // the next wave
  wv_t -= CR / srate;
  wv_t <= 0 ? (
    wv_t = (0.75 + rand(1) * 0.5) / max(wrate, 0.01);                   // never quite regular
    wb = WV[W_ON] ? (WV[WS + W_ON] ? (WV[W_U] > WV[WS + W_U] ? WV : WV + WS) : WV + WS) : WV;   // a free record, else the older
    w_start(wb);
  );
  k = 0;
  loop(2, wb = WV + k * WS;
    wb[W_ON] ? ( wb[W_U] += wb[W_DU];  wb[W_U] >= 1 ? wb[W_ON] = 0 : w_shape(wb); ) : ( wb[W_AT] = 0;  wb[W_FA] = 0; );
    k += 1; );
  // the distant swell rolls at about half the wave rate
  sw_ph += wrate * 0.55 * CR / srate;  sw_ph -= floor(sw_ph);
  sw_a = 0.35 + 0.65 * (0.5 - 0.5 * cos(2 * $pi * sw_ph));
  // the filters
  WV[W_F] += (WV[W_FT] - WV[W_F]) * 0.3;  WV[WS + W_F] += (WV[WS + W_FT] - WV[WS + W_F]) * 0.3;
  w0l.svf_set(WV[W_F], 0.6);  w0r.svf_set(WV[W_F] * 1.05, 0.6);  w1l.svf_set(WV[WS + W_F], 0.6);  w1r.svf_set(WV[WS + W_F] * 0.95, 0.6);
  swl.svf_set(260, 0.6);  swr.svf_set(250, 0.6);
  fzl.svf_set(2600, 0.7);  fzr.svf_set(2900, 0.7);
  wf = (380 + 900 * gust) * (1 + b_w * 0.1);
  wnl.svf_set(wf, 1.3 + gust * 1.5);  wnr.svf_set(wf * 1.12, 1.3 + gust * 1.5);
  wh1.svf_set(wf * 3.1, 9);  wh2.svf_set(wf * 3.4, 9);
  rbl.svf_set(1200, 0.5);  rbr.svf_set(1300, 0.5);
  thl.svf_set(70, 0.7);  thr.svf_set(66, 0.7);
  cut_s += (cutoff - cut_s) * 0.15;
  mf = cut_s * 2 ^ (p_w * 0.25);
  ml.svf_set(mf, 0.707);  mr.svf_set(mf, 0.707);
);
cr_n -= 1;

// glides
in_x += ((in_on >= 0.5) - in_x) * sw_c;
sc_x += ((mode < 0.5) - sc_x) * sw_c;
th_x += ((thick >= 0.5) - th_x) * sw_c;
nt = floor(ntype + 0.5);  nx0 += ((nt == 0) - nx0) * sw_c;  nx1 += ((nt == 1) - nx1) * sw_c;  nx2 += ((nt == 2) - nx2) * sw_c;
out_g += (out_t - out_g) * sm_c;  nz_g += (nz_t - nz_g) * sm_c;  lick_g += (lick_t - lick_g) * sm_c;  wind_g += (wind_t - wind_g) * sm_c;  rain_g += (rain_t - rain_g) * sm_c;
WV[W_A] += (WV[W_AT] - WV[W_A]) * 0.001;  WV[WS + W_A] += (WV[WS + W_AT] - WV[WS + W_A]) * 0.001;
WV[W_FZ] += (WV[W_FA] - WV[W_FZ]) * 0.001;  WV[WS + W_FZ] += (WV[WS + W_FA] - WV[WS + W_FZ]) * 0.001;

yl = 0;  yr = 0;
in_x > 0.00001 ? (
  nL.nz_run();  nR.nz_run();
  // ---------- SOUNDSCAPE ----------
  sc_x > 0.00001 ? (
    sl = 0;  sr = 0;
    // WAVES: pink noise through the wave's moving low-pass, foam on the wash
    a0 = WV[W_A];  a1 = WV[WS + W_A];
    a0 + a1 > 0.0001 ? (
      p0 = WV[W_PAN];  p1 = WV[WS + W_PAN];
      v = w0l.svf(nL.pk) * a0;  sl += v * (1 - p0 * 0.5);  v = w0r.svf(nR.pk) * a0;  sr += v * (1 + p0 * 0.5);
      v = w1l.svf(nR.pk * 0.7 + nL.br * 0.6) * a1;  sl += v * (1 - p1 * 0.5);  v = w1r.svf(nL.pk * 0.7 + nR.br * 0.6) * a1;  sr += v * (1 + p1 * 0.5);
      // SHORELINE LICK: the foam - high fizz, chopped into bubbles that pop at random
      fz = (WV[W_FZ] + WV[WS + W_FZ]) * lick_g;
      fz > 0.0005 ? (
        rand(1) < fz * 0.08 ? bub = 0.4 + rand(1) * 0.6;  bub *= 0.993;
        fzl.svf(nL.w);  fzr.svf(nR.w);
        sl += fzl.hp * fz * (0.25 + bub) * 0.5;  sr += fzr.hp * fz * (0.25 + bub * 0.8) * 0.5;
      );
    );
    // the distant swell
    sl += swl.svf(nL.br) * sw_a * 0.75;  sr += swr.svf(nR.br) * sw_a * 0.75;
    // WIND: two moving resonances in gusts, a faint whistle at the top of a strong gust
    wind_g > 0.001 ? (
      wa = wind_g * (0.25 + 0.75 * gust) * (1 + b_w * 0.15);
      wnl.svf(nL.pk);  wnr.svf(nR.pk);
      sl += wnl.bp * wa * 1.6;  sr += wnr.bp * wa * 1.6;                // TWEAK: the wind's level
      wh = max(0, gust - 0.6) * wind_g * 0.15;
      wh > 0.0005 ? ( wh1.svf(nL.w);  wh2.svf(nR.w);  sl += wh1.bp * wh;  sr += wh2.bp * wh; );
    );
    // RAIN: drops (a tiny decaying tick each) over a soft hiss
    rain_g > 0.001 ? (
      rand(1) < drop_rate / srate ? (
        db = DR + dr_i * DS;  dr_i = (dr_i + 1) % NDR;
        db[0] = 0;  db[1] = (2500 + rand(1) * 5500) / srate;  db[2] = (0.2 + rand(1) * 0.8) * 0.3;  db[3] = exp(-1 / ((0.0015 + rand(1) * 0.004) * srate));  db[4] = rand(1);
      );
      k = 0;  loop(NDR, db = DR + k * DS;
        db[2] > 0.0005 ? ( db[0] += db[1];  db[0] -= floor(db[0]);  v = sin(2 * $pi * db[0]) * db[2];  db[2] *= db[3];
          sl += v * sqrt(1 - db[4]);  sr += v * sqrt(db[4]); );
        k += 1; );
      rbl.svf(nL.pk);  rbr.svf(nR.pk);
      sl += rbl.hp * rain_g * 0.35;  sr += rbr.hp * rain_g * 0.35;
    );
    // THICK: the ocean's body, deep and slow
    th_x > 0.0001 ? ( sl += thl.svf(nL.br) * th_x * sw_a * 1.6;  sr += thr.svf(nR.br) * th_x * sw_a * 1.6; );
    // the raw noise, if NOISE LEVEL is up
    nz_g > 0.00001 ? (                                                    // the type crossfades (no click)
      sl += (nL.w * 0.577 * nx0 + nL.pk * nx1 + nL.br * 0.35 * nx2) * nz_g;  sr += (nR.w * 0.577 * nx0 + nR.pk * nx1 + nR.br * 0.35 * nx2) * nz_g; );
    // DRIFT: the noise floor's warmth
    sl += nL.w * 0.0004 * (1 + t_w) * dsc;  sr += nR.w * 0.0004 * (1 + t_w) * dsc;
    // FILTER CUTOFF and the air pressure
    pg = 1 + p_w * 0.12;
    yl += ml.svf(sl) * pg * sc_x;  yr += mr.svf(sr) * pg * sc_x;
  );
  // ---------- CALIBRATION: exact noise, its band, its channels ----------
  cal_x > 0.00001 ? (
    ct = cal_t;  q_l = ct == 0 ? nL.w : ct == 1 ? nL.pk : nL.br;  q_r = cal_c == 1 ? q_l : ct == 0 ? nR.w : ct == 1 ? nR.pk : nR.br;
    ch1l.svf(q_l);  ch2l.svf(ch1l.hp);  q_l = cl2l.svf(cl1l.svf(ch2l.hp));
    ch1r.svf(q_r);  ch2r.svf(ch1r.hp);  q_r = cl2r.svf(cl1r.svf(ch2r.hp));
    cg = cal_g * cal_dk * cal_x;
    yl += q_l * cg * (cal_c != 3);  yr += q_r * cg * (cal_c != 2);
  );
  yl *= in_x;  yr *= in_x;
);
// CALIBRATION: the swap, the dip, the level
cal_dk += ((cal_pend ? 0 : 1) - cal_dk) * cdk_c;
cal_pend && cal_dk < 0.001 ? (
  cal_t = cal_nt;  cal_c = cal_nc;  cal_p = cal_np;
  ch1l.s1 = ch1l.s2 = ch2l.s1 = ch2l.s2 = cl1l.s1 = cl1l.s2 = cl2l.s1 = cl2l.s2 = 0;      // start the new filters clean (the output is silent here)
  ch1r.s1 = ch1r.s2 = ch2r.s1 = ch2r.s2 = cl1r.s1 = cl1r.s2 = cl2r.s1 = cl2r.s2 = 0;
  ch1l.svf_set(cal_nhn, 0.5412);  ch2l.svf_set(cal_nhn, 1.3066);  cl1l.svf_set(cal_nln, 0.5412);  cl2l.svf_set(cal_nln, 1.3066);
  ch1r.svf_set(cal_nhn, 0.5412);  ch2r.svf_set(cal_nhn, 1.3066);  cl1r.svf_set(cal_nln, 0.5412);  cl2r.svf_set(cal_nln, 1.3066);
  cal_tg = nlev <= -60.95 ? 0 : 10 ^ (nlev / 20) / sqrt(max(cal_p, 0.0000000001));  cal_g = cal_tg;
  cal_pend = 0;
);
cal_g += (cal_tg - cal_g) * sm_c;
cal_x += ((mode >= 0.5) - cal_x) * sw_c;

// ---------- EFFECTS (the soundscape only: they fade out in CALIBRATION; their tails ring on after IN) ----------
fxs = sc_x;
ch_x += ((ch_on >= 0.5) * fxs - ch_x) * sw_c;  dl_x += ((dl_on >= 0.5) * fxs - dl_x) * sw_c;
rv_x += ((rv_on >= 0.5) * fxs - rv_x) * sw_c;  wd_x += ((wd_on >= 0.5) * fxs - wd_x) * sw_c;
chm_g += (chm_t - chm_g) * sm_c;  chd_g += (chd_t - chd_g) * sm_c;  wd_g += (wdt - wd_g) * sm_c;
dfb_g += (dfb_t - dfb_g) * sm_c;  dmx_g += (dmx_t - dmx_g) * sm_c;  rmx_g += (rmx_t - rmx_g) * sm_c;
// CHORUS: two swept voices (7 - 19 ms) on the band between its HPF and LPF
xl = chl_l.svf(chh_l.svf(yl) * 0 + chh_l.hp);  xr = chl_r.svf(chh_r.svf(yr) * 0 + chh_r.hp);
CHB[ch_w] = xl;  CHB[CHN + ch_w] = xr;
ch_x > 0.0001 ? (
  ch_ph += ch_rate / srate;  ch_ph -= floor(ch_ph);
  cda = (13 + 6 * chd_g * sin(2 * $pi * ch_ph)) * 0.001 * srate;  cdb = (13 + 6 * chd_g * sin(2 * $pi * ch_ph + 2.1)) * 0.001 * srate;
  rp = ch_w - cda;  rp < 0 ? rp += CHN;  ri = floor(rp);  rf = rp - ri;  rj = ri + 1;  rj >= CHN ? rj = 0;
  col_ = CHB[ri] + (CHB[rj] - CHB[ri]) * rf;
  rp = ch_w - cdb;  rp < 0 ? rp += CHN;  ri = floor(rp);  rf = rp - ri;  rj = ri + 1;  rj >= CHN ? rj = 0;
  cor_ = CHB[CHN + ri] + (CHB[CHN + rj] - CHB[CHN + ri]) * rf;
  yl += col_ * chm_g * ch_x;  yr += cor_ * chm_g * ch_x;
);
ch_w += 1;  ch_w >= CHN ? ch_w = 0;
// DELAY: a stereo echo, its HPF / LPF in the loop (each repeat darker and thinner)
dtm_s += (dtm_t - dtm_s) * dtm_c;
dl_x > 0.0001 || dl_tail > 0.00001 ? (
  rp = dl_w - dtm_s;  rp < 0 ? rp += DLN;  ri = floor(rp);  rf = rp - ri;  rj = ri + 1;  rj >= DLN ? rj = 0;
  el = DLB[ri] + (DLB[rj] - DLB[ri]) * rf;  er = DLB[DLN + ri] + (DLB[DLN + rj] - DLB[DLN + ri]) * rf;
  dll_l.svf(yl * dl_x + el * dfb_g);  dlh_l.svf(dll_l.lp);  dll_r.svf(yr * dl_x + er * dfb_g);  dlh_r.svf(dll_r.lp);
  DLB[dl_w] = ts(dlh_l.hp * 1.1) / 1.1;  DLB[DLN + dl_w] = ts(dlh_r.hp * 1.1) / 1.1;
  yl += el * dmx_g;  yr += er * dmx_g;
  dl_tail = max(abs(el), abs(er)) * 0.002 + dl_tail * 0.998;
) : ( DLB[dl_w] = 0;  DLB[DLN + dl_w] = 0; );
dl_w += 1;  dl_w >= DLN ? dl_w = 0;
// REVERB: the house engine, fed through its HPF / LPF
rv_x > 0.0001 || rv_tail > 0.00001 ? (
  sz_cur += (sz_t - sz_cur) * sz_c;
  ln_len[0] = RVB[0] * sz_cur;  ln_len[1] = RVB[1] * sz_cur;  ln_len[2] = RVB[2] * sz_cur;  ln_len[3] = RVB[3] * sz_cur;
  ln_len[4] = RVB[4] * sz_cur;  ln_len[5] = RVB[5] * sz_cur;  ln_len[6] = RVB[6] * sz_cur;  ln_len[7] = RVB[7] * sz_cur;
  sp_pre = (0.01 + 0.03 * (sz_cur - 0.3) / 0.7) * srate;  pr_i = floor(sp_pre);  pr_f = sp_pre - pr_i;
  rvl_l.svf(rvh_l.svf(yl * rv_x) * 0 + rvh_l.hp);  rvl_r.svf(rvh_r.svf(yr * rv_x) * 0 + rvh_r.hp);
  bv_pre(rvl_l.lp, rvl_r.lp);
  pl = pre_l(pr_i);  pq = pre_r(pr_i);  pl += (pre_l(pr_i + 1) - pl) * pr_f;  pq += (pre_r(pr_i + 1) - pq) * pr_f;
  dif_run(pl, pq, 0.75, 0.9);
  fdn_run(dif_l, dif_r);
  yl += fdn_l * 0.55 * rmx_g;  yr += fdn_r * 0.55 * rmx_g;
  rv_tail = max(abs(fdn_l), abs(fdn_r)) * 0.001 + rv_tail * 0.999;
);
// WIDTH (last): the side signal of the band between its HPF and LPF is widened (0 = mono, 100 = as is, 200 = twice)
wd_x > 0.0001 ? (
  w_mid = (yl + yr) * 0.5;  w_sid = (yl - yr) * 0.5;
  wsb = wdl.svf(wdh.svf(w_sid) * 0 + wdh.hp);
  w_sid += wsb * (wd_g - 1) * wd_x;
  yl = w_mid + w_sid;  yr = w_mid - w_sid;
);

og = out_g + (1 - out_g) * cal_x;                                       // CALIBRATION bypasses OUTPUT LEVEL
yl *= og;  yr *= og;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
pkl = max(pkl, abs(yl));  pkr = max(pkr, abs(yr));
cal_ms += ((cal_c == 3 ? yr * yr : yl * yl) - cal_ms) * cms_c;           // MEASURED (the left channel, or the right if only it plays)
// the visualisers (written here only; the panel reads them)
VB[vb_w] = (yl + yr) * 0.5;  vb_w = (vb_w + 1) & (VBN - 1);
vp_pk = max(vp_pk, max(abs(yl), abs(yr)));  vp_ms += yl * yl + yr * yr;  vp_n += 1;
vp_n >= VPB ? ( VP[vp_w * 2] = vp_pk;  VP[vp_w * 2 + 1] = sqrt(vp_ms / (2 * VPB));  vp_w = (vp_w + 1) % VPN;  vp_cnt += 1;  vp_pk = 0;  vp_ms = 0;  vp_n = 0; );
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, ui_pg);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@gfx 1080 560
// =====================================================================
// GUI - OC77: a deep oceanic teal-blue faceplate, crisp white scale markings, cream selector keys, pointer knobs,
// the small square grey THICK key with its red LED.
// =====================================================================
C_FACE = 0x1D4A57;  C_SEC1 = 0x225868;  C_SEC2 = 0x1E5161;  C_SEC3 = 0x24606F;
C_INK = 0xF2F7F6;  C_INK2 = 0xA9C9CC;  C_ORG = 0x9FD3D6;  C_SCL = 0xCDEBEC;  C_YEL = 0xF2C230;  C_BEZ = 0x0C2228;
C_LCDBG = 0x061416;  C_LCDTX = 0x8FF0E6;
LK_YEL = 0xF2C230;  LK_AMB = 0xF2A41E;  LK_RED = 0xF0503A;  lk_well = 0x0C1C20;

function col(h, a) ( gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a; );
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));  b = min(255, floor((h % 256) * f));
  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 + floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_r(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rivet(x, y) ( col(0x0E2A31, 1);  gfx_circle(px(x), py(y), ps(4), 1, 1);  col(0x8FB8BE, 1);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.4), 1, 1); );
// age: faint stains and wear on the cream, painted once into image 121 (again on resize)
function wx_rnd() ( wx_s = (wx_s * 16807) % 2147483647;  wx_s / 2147483647; );
function wx_build() local(i, x, y, r) (
  gfx_setimgdim(121, ceil(ps(1080)), ceil(ps(560)));  gfx_dest = 121;
  col(C_FACE, 1);  gfx_rect(0, 0, ps(1080), ps(560), 1);
  wx_s = 9277;  i = 0;
  loop(380, x = wx_rnd() * 1080;  y = wx_rnd() * 560;  r = 2 + wx_rnd() * 24;       // the title's corner stays clear
    col(wx_rnd() < 0.6 ? 0x000000 : 0xBFEFF0, 0.010 + 0.014 * wx_rnd());  gfx_circle(ps(x), ps(y), ps(r), 1, 1);  i += 1; );
  gfx_dest = -1;  wx_sc = sc;
);
// a section: a recessed teal panel, its title in white over a pale rule
function section(x, y, w, h, c, title) (
  col(0x000000, 0.25);  u_rect(x + 2, y + 3, w, h);
  col(c, 1);  u_rect(x, y, w, h);
  col(shade(c, 0.75), 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h);
  col(0xFFFFFF, 0.12);  u_rect(x, y, w - 2, 1);
  col(C_SCL, 0.7);  u_rect(x + 16, y + 34, w - 32, 2);
  gfx_setfont(4);  col(C_INK, 1);  text_l(px(x + 16), py(y + 19), title);
);
function shd_r(x, y, w, h) local(i) ( i = 0;  loop(4, col(0x000000, 0.13);  u_rect(x + 2 + i * 1.3, y + 3 + i * 1.6, w + i * 0.6, h + i * 0.6);  i += 1; ); );
function shd_c(cx, cy, r) local(i) ( i = 0;  loop(4, col(0x000000, 0.13);  gfx_circle(px(cx + 2 + i * 1.2), py(cy + 3 + i * 1.5), ps(r + i * 0.6), 1, 1);  i += 1; ); );
function vig_c(cx, cy, r, a) local(i) ( i = 0;  loop(7, col(0x000000, a * (1 - i / 7));  gfx_circle(px(cx), py(cy), ps(r - i * 0.8), 0, 1);  gfx_circle(px(cx + 0.4), py(cy + 0.4), ps(r - i * 0.8 - 0.4), 0, 1);  i += 1; ); );
// a light recessed READOUT box (a value read at a glance), dark text
function rbox(x, y, w, h, str) ( col(0x4A4636, 1);  u_rect(x - 1, y - 1, w + 2, h + 2);  col(0xF2ECD8, 1);  u_rect(x, y, w, h);
  col(0x000000, 0.15);  u_rect(x, y, w, 2);  u_rect(x, y, 2, h);  gfx_setfont(2);  col(0x1C1A14, 1);  text_c(px(x + w * 0.5), py(y + h * 0.5), str); );
// a status LED: lit by lv (0 - 1), a black ring, a highlight and a halo
function sled(x, y, r, c, lv) ( col(0x0A0A0A, 1);  gfx_circle(px(x), py(y), ps(r + 2), 1, 1);  col(ui_mix(shade(c, 0.3), c, min(1, lv)), 1);  gfx_circle(px(x), py(y), ps(r), 1, 1);
  lv > 0.05 ? ( col(c, 0.25 * min(1, lv));  gfx_circle(px(x), py(y), ps(r * 2.2), 1, 1);  col(0xFFFFFF, 0.6 * min(1, lv));  gfx_circle(px(x - r * 0.3), py(y - r * 0.3), ps(r * 0.35), 1, 1); ); );
// a KEY + LED: a small square key, its own LED beside it (lit green when on)
function kled(x, y, w, h, on, str) local(hov, hit) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);  hit = click && hov && !drag_idx;
  shd_r(x - 2, y - 2, w + 4, h + 4);  col(0x101010, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(on ? 0xF2C230 : 0xC9A85A, 1);  u_rect(x, y, w, h);  col(0xFFFFFF, 0.3);  u_rect(x, y, w, 2);  col(0x000000, 0.12);  u_rect(x, y + h - 4, w, 4);  u_rect(x + w - 3, y, 3, h);
  hov ? ( col(0xFFFFFF, 0.08);  u_rect(x, y, w, h); );
  gfx_setfont(2);  col(0x3A2A08, 1);  text_c(px(x + w * 0.5), py(y + h * 0.5), str);
  sled(x + w + 16, y + h * 0.5, 5, 0x7CE05A, on);
  hit;
);
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function divname(v) ( v = floor(v + 0.5);  strcpy(#kv, v == 0 ? "1/32" : v == 1 ? "1/16 T" : v == 2 ? "1/16" : v == 3 ? "1/8 T" : v == 4 ? "1/16 D" :
  v == 5 ? "1/8" : v == 6 ? "1/4 T" : v == 7 ? "1/8 D" : v == 8 ? "1/4" : v == 9 ? "1/2 T" : v == 10 ? "1/4 D" : v == 11 ? "1/2" : "1 bar"); #kv; );
function hzname(v) ( v >= 1000 ? sprintf(#hz, "%.1f kHz", v / 1000) : sprintf(#hz, "%d Hz", v);  #hz; );
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v) :
  fmt == 2 ? sprintf(#kv, "%.1f Hz", v) :
  fmt == 3 ? sprintf(#kv, "%+.1f st", v) :
  fmt == 4 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 5 ? sprintf(#kv, "%.3f MHz", v) :
  fmt == 6 ? sprintf(#kv, "%.1f st", v) :
  fmt == 7 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 8 ? sprintf(#kv, "%d ms", v) :
  fmt == 9 ? ( v >= 1000 ? sprintf(#kv, "%.1f kHz", v / 1000) : sprintf(#kv, "%d Hz", v); ) :
  fmt == 10 ? divname(v) :
  fmt == 11 ? sprintf(#kv, "%.1f s", v) :
  sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
// a pointer knob: a black fluted skirt, a black cap with a white line; orange and black scale on the cream
function kn(cx, cy, r, idx, vmin, vmax, def, lbl, fmt) local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lgt, fin, stp, kc)
(
  lgt = klog;  klog = 0;  fin = kfine;  kfine = 0;  stp = kstep;  kstep = 0;  kc = kcap;  kcap = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.2);
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? ( slider(idx) = def;  param_touched(idx);  drag_idx = 0; )
                                                                           : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    stp ? v = max(vmin, min(vmax, floor(v + 0.5) + sign(mouse_wheel))) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 220)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    v = stp ? floor(v + 0.5) : fin ? floor(v * 1000 + 0.5) / 1000 : floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  j = 0;
  loop(21,
    b = a0 + j / 20 * (a1 - a0);  col(j % 5 == 0 ? C_INK : C_ORG, j % 5 == 0 ? 0.9 : 0.85);
    gfx_line(x + sin(b) * (rr + ps(6)), y - cos(b) * (rr + ps(6)), x + sin(b) * (rr + ps(j % 5 == 0 ? 14 : 10)), y - cos(b) * (rr + ps(j % 5 == 0 ? 14 : 10)), 1);
    j += 1;
  );
  shd_c(cx, cy, r);
  kc ? (
    // COLOURED CAP: a light metal ring round a flat coloured cap
    col(0xB8BCC4, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x6E7278, 1);  gfx_circle(x, y, rr, 0, 1);  col(0xFFFFFF, 0.25);  gfx_arc(x, y, rr - ps(1.5), -1.7, -0.3, 1);
    col(kc, 1);  gfx_circle(x, y, rr * 0.84, 1, 1);  vig_c(cx, cy, r * 0.84, 0.16);
  ) : (
    col(0x1A1918, 1);  gfx_circle(x, y, rr, 1, 1);
    j = 0;  loop(36, b = j / 36 * 2 * $pi;  col(0x3E3B36, 1);  gfx_line(x + sin(b) * rr * 0.86, y - cos(b) * rr * 0.86, x + sin(b) * rr * 0.98, y - cos(b) * rr * 0.98, 1);  j += 1; );
    col(0x262422, 1);  gfx_circle(x, y, rr * 0.8, 1, 1);  vig_c(cx, cy, r, 0.16);
  );
  col(0xFFFFFF, 0.10);  gfx_arc(x, y, rr * 0.74, -1.8, -0.1, 1);
  col(0xF4EEDC, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.92, ps(r > 30 ? 2.6 : 1.8));
  gfx_setfont(6);  col(C_INK, 1);  text_c(x, y + rr + ps(26), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(22), fmtv(v, fmt));
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r, d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);  i += 1; );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) ( gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str); );
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? ( col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);  col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k); );
  shd_r(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k);
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4, t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;  dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);  i += 1; );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lcd_box(x, y, w, h) ( col(0x2A2722, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(0x050402, 1);  u_rect(x, y, w, h);  col(C_LCDBG, 1);  u_rect(x + 3, y + 3, w - 6, h - 6); );
function lcd(x, y, w, h, fnt, str) local(tw, th, gy) (
  lcd_box(x, y, w, h);
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);
// a vertical LED meter (-48 .. 0 dB) with its name below
function vmeter(x, y, h, lv, name) local(db, j, d, n) (
  db = lv > 0.000001 ? 8.685889638065035 * log(lv) : -120;  n = 20;
  shd_r(x, y, 22, h);
  col(0x14120F, 1);  u_rect(x, y, 22, h);
  j = 0;
  loop(n, d = -48 + (j + 1) * 48 / n;
    col(d > -1 ? 0xFF4A30 : d > -10 ? 0xFFB347 : 0x9FD05A, db >= d - 2.4 ? 1 : 0.12);
    u_rect(x + 3, y + h - 3 - (j + 1) * (h - 6) / n + 1, 16, (h - 6) / n - 1.5);  j += 1; );
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(x + 11), py(y + h + 14), name);
);
// a round warning lamp in a black bezel, with its name beside it
function lamp(x, y, c, lv, name) (
  col(C_BEZ, 1);  gfx_circle(px(x), py(y), ps(10), 1, 1);
  col(shade(c, 0.35), 1);  gfx_circle(px(x), py(y), ps(7), 1, 1);
  col(c, min(1, lv));  gfx_circle(px(x), py(y), ps(7), 1, 1);
  lv > 0.05 ? ( col(c, 0.25 * min(1, lv));  gfx_circle(px(x), py(y), ps(13), 1, 1);  col(0xFFFFFF, 0.5 * min(1, lv));  gfx_circle(px(x - 2), py(y - 2), ps(2.2), 1, 1); );
  gfx_setfont(5);  col(C_INK, 1);  text_l(px(x + 18), py(y), name);
);
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1, c = k < len ? str_getchar(menu, k) : 124;  c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );  k += 1; );
  dst;
);
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xD8D0BC, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xD8D0BC, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xD8D0BC, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1B1C, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  i < n ? strcat(#pb_m, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
// a cream selector key with an amber LED (one of a group)
function ck(x, y, w, h, sel, str) local(hov, hit, yy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  yy = sel ? y : y + 1.5;
  shd_r(x, yy, w, h - 1.5);
  col(sel ? 0xF0E8D2 : 0xB3AE9F, 1);  u_rect(x, yy, w, h - 1.5);
  col(shade(sel ? 0xF0E8D2 : 0xB3AE9F, 0.72), 1);  u_rect(x, yy + h - 3.5, w, 2);  u_rect(x + w - 2, yy, 2, h - 1.5);
  hov ? ( col(0xFFFFFF, 0.1);  u_rect(x, yy, w, h - 1.5); );
  col(0xF2A41E, sel ? 0.35 : 0);  gfx_circle(px(x + w - 9), py(yy + 9), ps(5), 1, 1);
  col(sel ? 0xF2A41E : 0x6A5A40, 1);  gfx_circle(px(x + w - 9), py(yy + 9), ps(2.8), 1, 1);
  gfx_setfont(2);  col(sel ? 0x2A2A28 : 0x4A4840, 1);  text_c(px(x + w * 0.5 - 4), py(yy + h * 0.5), str);
  hit;
);
// a dark display box for a choice from a menu (BAND, CHANNELS); a small arrow says it opens a list
function dbox(x, y, w, h, str) local(hov) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  shd_r(x, y, w, h);
  col(0x2A2722, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(C_LCDBG, 1);  u_rect(x, y, w, h);  col(0xFFFFFF, hov ? 0.12 : 0.05);  u_rect(x, y + h - 1, w, 1);
  gfx_setfont(2);  col(C_LCDTX, 1);  text_c(px(x + w * 0.5 - 6), py(y + h * 0.5), str);
  col(C_LCDTX, 0.7);  gfx_triangle(px(x + w - 16), py(y + h * 0.5 - 2), px(x + w - 8), py(y + h * 0.5 - 2), px(x + w - 12), py(y + h * 0.5 + 3));
  click && hov && !drag_idx;
);
// the small square grey key with a red LED beside it (THICK)
function gkey(x, y, s, on, str) local(hov, hit) (
  hov = mouse_x >= px(x) && mouse_x < px(x + s) && mouse_y >= py(y) && mouse_y < py(y + s);  hit = click && hov && !drag_idx;
  shd_r(x - 2, y - 2, s + 4, s + 4);  col(0x0A0C0C, 1);  u_rect(x - 2, y - 2, s + 4, s + 4);
  col(on ? 0xB4B8B8 : 0x9A9E9E, 1);  u_rect(x, y, s, s);  col(0xFFFFFF, 0.3);  u_rect(x, y, s, 2);  u_rect(x, y, 2, s);
  col(0x000000, 0.15);  u_rect(x, y + s - 3, s, 3);  u_rect(x + s - 3, y, 3, s);
  hov ? ( col(0xFFFFFF, 0.08);  u_rect(x, y, s, s); );
  sled(x + s + 16, y + s * 0.5, 5, 0xFF3A22, on);
  gfx_setfont(5);  col(C_INK, 1);  text_l(px(x + s + 30), py(y + s * 0.5), str);
  hit;
);

// a section with a TITLE LAMP: the lamp (or the title) switches the effect in / out (slider idx)
function section_l(x, y, w, h, c, title, on, idx) local(hov) (
  section(x, y, w, h, c, "");
  col(0x061416, 1);  gfx_circle(px(x + 26), py(y + 19), ps(10), 1, 1);
  col(on ? 0xFFF4D8 : 0x5A6E72, 1);  gfx_circle(px(x + 26), py(y + 19), ps(8), 1, 1);
  col(on ? 0xF2A41E : 0x1E3034, 1);  gfx_circle(px(x + 26), py(y + 19), ps(5), 1, 1);
  on ? ( col(0xF2A41E, 0.28);  gfx_circle(px(x + 26), py(y + 19), ps(15), 1, 1); );
  gfx_setfont(4);  col(on ? C_INK : C_INK2, 1);  text_l(px(x + 46), py(y + 19), title);
  hov = mouse_x >= px(x + 10) && mouse_x < px(x + 180) && mouse_y >= py(y) && mouse_y < py(y + 34);
  click && hov && !drag_idx ? ( slider(idx) = on ? 0 : 1;  param_touched(idx); );
);
// an effect's HPF (yellow cap) and LPF (black cap), a readout under each
function fx_filt(x, y, ih, il, dh, dl) (
  kcap = 0xD8B024;  klog = 1;  kn(x + 64, y, 24, ih, 20, 2000, dh, "HPF", 9);
  kcap = 0x1E1C18;  klog = 1;  kn(x + 192, y, 24, il, 1000, 20000, dl, "LPF", 9);
  rbox(x + 24, y + 62, 80, 26, hzname(slider(ih)));  rbox(x + 152, y + 62, 80, 26, hzname(slider(il)));
);
PRESET_MENU = "Default|Gentle Evening Shoreline|Deep Ocean Swells|Coastal Gale|Midnight Rain|Calibrated White Noise|Calibrated Pink Noise|Brown Noise Room Test|Distant Surf|Stormy Beach";

// ---------- frame ----------
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1080 * g_ret), gfx_h / (560 * g_ret))), 0.5);
ox = (gfx_w - 1080 * sc) * 0.5;  oy = (gfx_h - 560 * sc) * 0.5;
lmb = mouse_cap & 1;  click = lmb && !last_lmb;  klog = 0;  kfine = 0;  kstep = 0;  kcap = 0;
gfx_setfont(1, "Trebuchet MS", ps(30), 'b');
gfx_setfont(2, "Trebuchet MS", ps(14), 'b');
gfx_setfont(3, "Trebuchet MS", ps(14), 'b');
gfx_setfont(4, "Trebuchet MS", ps(16), 'b');
gfx_setfont(5, "Trebuchet MS", ps(12.5), 'b');
gfx_setfont(6, "Trebuchet MS", ps(14), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');
gfx_setfont(10, "Trebuchet MS", ps(12.5), 'b');
oml = max(opkl_d, oml * 0.85);  omr = max(opkr_d, omr * 0.85);  opkl_d = 0;  opkr_d = 0;

// ---------- faceplate ----------
col(0x0A1A1E, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
wx_sc != sc ? wx_build();
gfx_a = 1;  gfx_x = px(0);  gfx_y = py(0);  gfx_blit(121, 1, 0);
col(0x000000, 0.3);  u_rect(0, 556, 1080, 4);  u_rect(1076, 0, 4, 560);
rivet(12, 12);  rivet(1068, 12);  rivet(12, 548);  rivet(1068, 548);
gfx_setfont(1);  col(C_INK, 1);  text_l(px(32), py(32), "OC77");
gfx_setfont(10);  col(C_SCL, 1);  text_l(px(130), py(24), "SHORELINE");  text_l(px(130), py(41), "NOISE GENERATOR");
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
pb_k = preset_bar(280, 15, 34, 300, pr_cur, PRESET_MENU);
// the pages
lk_key(808, 18, 84, 28, ui_pg == 0, LK_YEL, "SEA") ? ui_pg = 0;
lk_key(900, 18, 84, 28, ui_pg == 1, LK_YEL, "EFFECTS") ? ui_pg = 1;
pb_k > 0 ? ( prs_dirty = pb_k;  pr_cur = pb_k; );
col(C_SCL, 0.8);  u_rect(16, 62, 1048, 2);

ui_pg == 0 ? (
// ---------- SEA ----------
section(16, 76, 528, 468, C_SEC1, "SEA");
// the shoreline window: the waves rolling in (a scrolling picture of the two waves and the wind)
// SHORELINE: the last 10 seconds rolling in from the right - the body (RMS) solid, the spray (peaks) fainter
lcd_box(32, 122, 264, 162);
gfx_setfont(10);  col(C_LCDTX, 0.75);  text_l(px(44), py(138), "SHORELINE");
col(C_LCDTX, 0.12);  u_rect(38, 216, 252, 1);
g_j = 0;
loop(240,
  g_k = (vp_cnt - 240 + g_j);
  g_k >= 0 ? (
    g_k %= VPN;
    g_pk = VP[g_k * 2];  g_rm = VP[g_k * 2 + 1];
    g_hp = min(1, (g_pk * 2) ^ 0.7) * 58;  g_hr = min(1, (g_rm * 2) ^ 0.7) * 58;      // -6 dBFS fills the window
    g_x0 = floor(px(40 + g_j * 1.033));  g_x1 = floor(px(40 + (g_j + 1) * 1.033));       // whole pixels: no gaps
    col(C_LCDTX, 0.25);  gfx_rect(g_x0, py(216 - g_hp), max(1, g_x1 - g_x0), ps(g_hp * 2), 1);
    col(C_LCDTX, 0.8);   gfx_rect(g_x0, py(216 - g_hr), max(1, g_x1 - g_x0), ps(g_hr * 2), 1);
  );
  g_j += 1;
);
// SPECTRUM: noise density in 1/3 octaves (pink noise reads flat), 20 Hz - 20 kHz
lcd_box(308, 122, 220, 162);
gfx_setfont(10);  col(C_LCDTX, 0.75);  text_l(px(320), py(138), "SPECTRUM");
frame_n += 1;
frame_n % 2 == 0 ? (
  g_i = 0;  g_w = vb_w;
  loop(VBN, g_t = (g_i + 0.5) / VBN;  FB[g_i * 2] = VB[(g_w + g_i) & (VBN - 1)] * (0.5 - 0.5 * cos(2 * $pi * g_t));  FB[g_i * 2 + 1] = 0;  g_i += 1; );
  fft(FB, VBN);  fft_permute(FB, VBN);
  g_bw = srate / VBN;
  g_b = 0;
  loop(SPN,
    g_fc = 20 * 2 ^ (g_b / 3);  g_lo = g_fc * 2 ^ (-1 / 6);  g_hi = g_fc * 2 ^ (1 / 6);
    g_k0 = max(1, floor(g_lo / g_bw - 0.5));  g_k1 = min(VBN / 2 - 1, ceil(g_hi / g_bw + 0.5));
    g_p = 0;  g_k = g_k0;
    loop(g_k1 - g_k0 + 1,
      g_ov = min(g_hi, (g_k + 0.5) * g_bw) - max(g_lo, (g_k - 0.5) * g_bw);
      g_ov > 0 ? g_p += (sqr(FB[g_k * 2]) + sqr(FB[g_k * 2 + 1])) * g_ov / g_bw;
      g_k += 1; );
    g_p *= 16 / (3 * VBN * VBN);                                          // Hann: the band's power
    SPB[g_b] += (g_p - SPB[g_b]) * 0.25;
    g_b += 1; );
);
col(C_LCDTX, 0.12);  g_j = 0;  loop(4, u_rect(316, 160 + g_j * 24, 204, 1);  g_j += 1; );     // -10, -30, -50, -70 dB
g_b = 0;
loop(SPN,
  g_v = SPB[g_b] > 0.0000000001 ? max(0, min(1, (10 * log10(SPB[g_b]) + 90) / 80)) : 0;
  g_x = 318 + g_b * 6.5;
  col(C_LCDTX, 0.18);  u_rect(g_x, 160, 4.5, 96);
  col(C_LCDTX, 0.85);  u_rect(g_x, 256 - g_v * 96, 4.5, g_v * 96);
  g_b += 1;
);
gfx_setfont(10);  col(C_LCDTX, 0.6);
text_c(px(318 + 7 * 6.5 + 2), py(270), "100");  text_c(px(318 + 17 * 6.5 + 2), py(270), "1k");  text_c(px(318 + 27 * 6.5 + 2), py(270), "10k");
klog = 1;  kn(104, 348, 28, 4, 0.05, 0.5, 0.1, "WAVE RATE", 7);
kn(272, 348, 28, 5, 0, 100, 40, "SHORELINE LICK", 1);
kn(440, 348, 28, 6, 0, 100, 30, "WIND GUST", 1);
kn(104, 470, 28, 7, 0, 100, 0, "RAIN DENSITY", 1);
klog = 1;  kn(272, 470, 28, 8, 20, 20000, 5000, "FILTER CUTOFF", 2);
gkey(400, 458, 22, thick >= 0.5, "THICK") ? ( slider(12) = thick >= 0.5 ? 0 : 1;  param_touched(12); );
mode >= 0.5 ? ( col(C_SEC1, 0.5);  u_rect(16, 292, 528, 252); );        // the sea rests in CALIBRATION (the windows stay live)

// ---------- NOISE ----------
section(560, 76, 256, 468, C_SEC2, "NOISE");
g_j = 0;
loop(3,
  ck(576 + g_j * 76, 124, 70, 34, floor(ntype + 0.5) == g_j, g_j == 0 ? "WHITE" : g_j == 1 ? "PINK" : "BROWN") ? ( slider(2) = g_j;  param_touched(2); );
  g_j += 1;
);
kn(688, 240, 36, 3, -61, 0, -61, "NOISE LEVEL", 4);
rbox(640, 320, 96, 28, nlev <= -60.95 ? "-inf dB" : sprintf(#nb, "%.1f dB", nlev));
// MEASURED: the true RMS of the output (calibration)
lcd_box(596, 364, 184, 28);  gfx_setfont(10);  col(C_LCDTX, 1);
text_c(px(688), py(378), mode >= 0.5 && in_on >= 0.5 && cal_rms_d > 0.00001 ? sprintf(#mr, "MEASURED %.1f dBFS", 20 * log10(cal_rms_d)) : "MEASURED  --");
gfx_setfont(5);  col(C_INK2, 1);  text_c(px(688), py(414), "BAND");  text_c(px(688), py(474), "CHANNELS");
g_b = floor(band + 0.5);
dbox(584, 428, 208, 30, g_b == 0 ? "FULL 20 Hz - 20 kHz" : g_b == 1 ? "500 Hz - 2 kHz" : g_b == 2 ? "SUB 20 - 80 Hz" :
  sprintf(#bn, "OCTAVE %s", g_b == 3 ? "31.5 Hz" : g_b == 4 ? "63 Hz" : g_b == 5 ? "125 Hz" : g_b == 6 ? "250 Hz" : g_b == 7 ? "500 Hz" :
  g_b == 8 ? "1 kHz" : g_b == 9 ? "2 kHz" : g_b == 10 ? "4 kHz" : g_b == 11 ? "8 kHz" : "16 kHz")) ? (
  gfx_x = px(584);  gfx_y = py(458);
  g_i = gfx_showmenu(sprintf(#bm, "%sFull (20 Hz - 20 kHz)|%s500 Hz - 2 kHz (speakers)|%s20 - 80 Hz (sub)|>Octave|%s31.5 Hz|%s63 Hz|%s125 Hz|%s250 Hz|%s500 Hz|%s1 kHz|%s2 kHz|%s4 kHz|%s8 kHz|<%s16 kHz",
    g_b == 0 ? "!" : "", g_b == 1 ? "!" : "", g_b == 2 ? "!" : "", g_b == 3 ? "!" : "", g_b == 4 ? "!" : "", g_b == 5 ? "!" : "", g_b == 6 ? "!" : "",
    g_b == 7 ? "!" : "", g_b == 8 ? "!" : "", g_b == 9 ? "!" : "", g_b == 10 ? "!" : "", g_b == 11 ? "!" : "", g_b == 12 ? "!" : ""));
  g_i > 0 ? ( slider(37) = g_i - 1;  param_touched(37); ); );
g_c = floor(chans + 0.5);
dbox(584, 488, 208, 30, g_c == 0 ? "STEREO" : g_c == 1 ? "MONO (L = R)" : g_c == 2 ? "LEFT ONLY" : "RIGHT ONLY") ? (
  gfx_x = px(584);  gfx_y = py(518);
  g_i = gfx_showmenu(sprintf(#cm, "%sStereo (uncorrelated)|%sMono (L = R)|%sLeft only|%sRight only", g_c == 0 ? "!" : "", g_c == 1 ? "!" : "", g_c == 2 ? "!" : "", g_c == 3 ? "!" : ""));
  g_i > 0 ? ( slider(38) = g_i - 1;  param_touched(38); ); );
mode < 0.5 ? ( col(C_SEC2, 0.5);  u_rect(576, 356, 224, 172); );        // band, channels and the meter are for CALIBRATION

// ---------- OUTPUT ----------
section(832, 76, 232, 468, C_SEC3, "OUTPUT");
lk_key(848, 122, 200, 30, mode < 0.5, LK_YEL, "SOUNDSCAPE") ? ( slider(1) = 0;  param_touched(1); );
lk_key(848, 162, 200, 30, mode >= 0.5, LK_YEL, "CALIBRATION") ? ( slider(1) = 1;  param_touched(1); );
lk_key(848, 214, 84, 30, in_on >= 0.5, LK_AMB, "IN") ? ( slider(11) = in_on >= 0.5 ? 0 : 1;  param_touched(11); );   // off when it loads
kn(890, 330, 28, 9, -18, 6, 0, "LEVEL", 4);
kn(890, 460, 18, 10, 0, 100, 50, "DRIFT", 1);
mode >= 0.5 ? ( col(C_SEC3, 0.5);  u_rect(848, 290, 92, 240); );        // CALIBRATION: unity output, no drift
vmeter(980, 220, 270, oml, "L");
vmeter(1014, 220, 270, omr, "R");
) : (
// ================= EFFECTS (the soundscape's: they fade out in CALIBRATION) =================
// ---------- CHORUS ----------
section_l(16, 76, 256, 468, C_SEC1, "CHORUS", ch_on >= 0.5, 13);
// each effect its own cap colour (HPF stays yellow, LPF black - the house code): chorus violet, delay blue, reverb green, width coral
C_CH = 0x7E5BB5;  C_DL = 0x2F6FB8;  C_RV = 0x3E9A5C;  C_WD = 0xC4583A;
klog = 1;  kcap = C_CH;  kn(64, 170, 24, 14, 0.05, 4, 0.4, "RATE", 7);
kcap = C_CH;  kn(144, 170, 24, 15, 0, 100, 40, "DEPTH", 1);
kcap = C_CH;  kn(224, 170, 24, 16, 0, 100, 35, "MIX", 1);
fx_filt(16, 330, 17, 18, 120, 12000);
ch_on < 0.5 ? ( col(C_SEC1, 0.5);  u_rect(16, 112, 256, 432); );
// ---------- DELAY ----------
section_l(280, 76, 256, 468, C_SEC2, "DELAY", dl_on >= 0.5, 23);
kled(440, 82, 52, 24, dl_sync >= 0.5, "SYNC") ? ( slider(24) = dl_sync >= 0.5 ? 0 : 1;  param_touched(24); );
dl_sync >= 0.5 ? ( kcap = C_DL;  kstep = 1;  kn(328, 170, 24, 25, 0, 12, 7, "TIME", 10);  rbox(292, 238, 72, 24, divname(dl_div)); )
               : ( kcap = C_DL;  klog = 1;  kn(328, 170, 24, 26, 20, 2000, 450, "TIME", 8);  rbox(292, 238, 72, 24, sprintf(#dt, "%d ms", dl_ms)); );
kcap = C_DL;  kn(408, 170, 24, 27, 0, 95, 35, "FEEDBACK", 1);
kcap = C_DL;  kn(488, 170, 24, 28, 0, 100, 25, "MIX", 1);
fx_filt(280, 330, 29, 30, 200, 6000);
dl_on < 0.5 ? ( col(C_SEC2, 0.5);  u_rect(280, 112, 256, 432); );
// ---------- REVERB ----------
section_l(544, 76, 256, 468, C_SEC1, "REVERB", rv_on >= 0.5, 31);
kcap = C_RV;  kn(592, 170, 24, 32, 0, 100, 70, "SIZE", 1);
kcap = C_RV;  klog = 1;  kn(672, 170, 24, 33, 0.5, 20, 4, "DECAY", 11);
kcap = C_RV;  kn(752, 170, 24, 34, 0, 100, 25, "MIX", 1);
fx_filt(544, 330, 35, 36, 150, 9000);
rv_on < 0.5 ? ( col(C_SEC1, 0.5);  u_rect(544, 112, 256, 432); );
// ---------- WIDTH ----------
section_l(808, 76, 256, 468, C_SEC3, "WIDTH", wd_on >= 0.5, 19);
kcap = C_WD;  kn(936, 180, 32, 20, 0, 200, 140, "WIDTH", 1);
gfx_setfont(10);  col(C_SCL, 1);  text_c(px(936), py(180 - 32 - 22), "0");     // the normal width (100 %)
fx_filt(808, 330, 21, 22, 300, 20000);
wd_on < 0.5 ? ( col(C_SEC3, 0.5);  u_rect(808, 112, 256, 432); );
);

// ---------- S / M / L / ? ----------
g_j = 0;
loop(4,
  g_x = 998 + g_j * 14;  g_on = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(C_BEZ, 1);  u_rect(g_x, 23, 13, 18);
  col(g_on ? C_SCL : 0x3E6A74, 1);  u_rect(g_x + 1, 24, 11, 16);
  gfx_setfont(5);  col(g_on ? 0x0C2228 : C_INK, 1);  text_c(px(g_x + 6.5), py(32), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(23) && mouse_y < py(41) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
sz_help && click && !sz_new ? sz_help = 0;
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
  gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
  g_cw = max(g_tw + ps(40), ps(380));  g_ch = ps(130);  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(0xE0603A, 1);    gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(102);  gfx_drawstr("Click anywhere to close.");
);
!lmb ? drag_idx = 0;
mouse_wheel = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );
