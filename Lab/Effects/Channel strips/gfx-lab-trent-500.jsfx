    lb_ps(2, 4,  -20,    6,  120,    8,   5,    0, 0);
    lb_ps(3, 3,    2,   -1,   -3,  330,   2, 1100, 0);
    lb_ps(4, 8,    6,  -20,   40,    0,   0,    0, 0);
    lb_ps(5, 10,    3,    5,    0,    1, 100,    1, 0);
  ) : tp == 5 ? (
    lb_ps(0, 2,   66, 22000,   0,    0,   0,    0, 0);
    lb_ps(1, 1,    6,   11,    0,   -1,   2,    0, 0);
