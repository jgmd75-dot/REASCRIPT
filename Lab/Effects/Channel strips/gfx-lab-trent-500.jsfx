function lb_db(d) ( exp(d * 0.11512925464970228); );
function lb_th(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function lb_hard(x) ( x = max(-8, min(8, x)); x / sqrt(sqrt(1 + x * x * x * x)); );
function lb_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * lb_rt)); );
function lb_map(m, k, n) local(tp) (
  tp = LB_MDT + (m * 6 + k) * 10;
  tp[3] == 1 ? tp[1] * exp(n * log(tp[2] / tp[1])) : tp[3] == 2 ? tp[1] + floor(n * (tp[2] - tp[1]) + 0.5) : tp[1] + n * (tp[2] - tp[1]);
);
function lb_inv(m, k, v) local(tp, n) (
  tp = LB_MDT + (m * 6 + k) * 10;
  tp[0] ? (
    n = tp[3] == 1 ? log(max(v, tp[1]) / tp[1]) / log(tp[2] / tp[1]) : (v - tp[1]) / (tp[2] - tp[1]);
    floor(min(max(n, 0), 1) * 1000 + 0.5) / 1000;
  ) : 0;
);

function lb_bset(tp, t, f, q, g) local(w, cw, sw, al, a, sa, a0) (
  t == 0 ? ( tp[0] = 1; tp[1] = tp[2] = tp[3] = tp[4] = 0; ) : (
    f = min(max(f, 5), lb_rt * 0.45);
    w = 2 * $pi * f / lb_rt; cw = cos(w); sw = sin(w); al = sw / (2 * q); a = exp(g * 0.05756462732485115); sa = 2 * sqrt(a) * al;
    t == 1 ? (
      a0 = 1 + al / a; tp[0] = (1 + al * a) / a0; tp[1] = -2 * cw / a0; tp[2] = (1 - al * a) / a0; tp[3] = tp[1]; tp[4] = (1 - al / a) / a0;
    ) : t == 2 ? (
      a0 = (a + 1) + (a - 1) * cw + sa;
      tp[0] = a * ((a + 1) - (a - 1) * cw + sa) / a0; tp[1] = 2 * a * ((a - 1) - (a + 1) * cw) / a0; tp[2] = a * ((a + 1) - (a - 1) * cw - sa) / a0;
      tp[3] = -2 * ((a - 1) + (a + 1) * cw) / a0; tp[4] = ((a + 1) + (a - 1) * cw - sa) / a0;
    ) : t == 3 ? (
      a0 = (a + 1) - (a - 1) * cw + sa;
      tp[0] = a * ((a + 1) + (a - 1) * cw + sa) / a0; tp[1] = -2 * a * ((a - 1) + (a + 1) * cw) / a0; tp[2] = a * ((a + 1) + (a - 1) * cw - sa) / a0;
      tp[3] = 2 * ((a - 1) - (a + 1) * cw) / a0; tp[4] = ((a + 1) - (a - 1) * cw - sa) / a0;
    ) : t == 6 ? (
      a0 = 1 + al; tp[0] = al / a0; tp[1] = 0; tp[2] = -al / a0; tp[3] = -2 * cw / a0; tp[4] = (1 - al) / a0;
    ) : t == 4 ? (
      a0 = 1 + al; tp[0] = (1 + cw) * 0.5 / a0; tp[1] = -(1 + cw) / a0; tp[2] = tp[0]; tp[3] = -2 * cw / a0; tp[4] = (1 - al) / a0;
    ) : (
      a0 = 1 + al; tp[0] = (1 - cw) * 0.5 / a0; tp[1] = (1 - cw) / a0; tp[2] = tp[0]; tp[3] = -2 * cw / a0; tp[4] = (1 - al) / a0;
    );
  );
);
function lb_bq(tp) local(x, y) (
  x = lb_l; y = tp[0] * x + tp[5]; tp[5] = tp[1] * x - tp[3] * y + tp[6]; tp[6] = tp[2] * x - tp[4] * y; lb_l = y;
  x = lb_r; y = tp[0] * x + tp[7]; tp[7] = tp[1] * x - tp[3] * y + tp[8]; tp[8] = tp[2] * x - tp[4] * y; lb_r = y;
);
function lb_bq1(tp, x) local(y) ( y = tp[0] * x + tp[5]; tp[5] = tp[1] * x - tp[3] * y + tp[6]; tp[6] = tp[2] * x - tp[4] * y; y; );
function lb_db20(x) ( 20 * log10(max(x, 0.0000001)); );
function lb_isat(x) ( x / sqrt(1 + x * x); );
function lb_iron(st, u, kc, tg, tl, tb, rb, kb) local(lo) (
  st[0] += (u - st[0]) * kc;
  lo = (lb_isat(st[0] * tl + tb) - rb) * kb / tl;
  lb_isat((u - st[0] + lo) * tg) / tg;
);
function lb_core(st, x, k, c, lk) local(sv, y) (
  x = min(max(x, -1.2), 1.2);
  st[0] = min(max(st[0] * lk + x * c, -4), 4);
  sv = lb_th(st[0] * k) / k; y = (sv - st[1] * lk) / c; st[1] = sv;
  y;
);
function lb_sbl(s, x) ( s == 0 ? sbl0.sb_run(x) : s == 1 ? sbl1.sb_run(x) : s == 2 ? sbl2.sb_run(x) : s == 3 ? sbl3.sb_run(x) : s == 4 ? sbl4.sb_run(x) : sbl5.sb_run(x); );
function lb_sbr(s, x) ( s == 0 ? sbr0.sb_run(x) : s == 1 ? sbr1.sb_run(x) : s == 2 ? sbr2.sb_run(x) : s == 3 ? sbr3.sb_run(x) : s == 4 ? sbr4.sb_run(x) : sbr5.sb_run(x); );
function lb_sbz(s) (
  s == 0 ? ( sbl0.sb_clr(); sbr0.sb_clr(); ) : s == 1 ? ( sbl1.sb_clr(); sbr1.sb_clr(); ) : s == 2 ? ( sbl2.sb_clr(); sbr2.sb_clr(); ) :
  s == 3 ? ( sbl3.sb_clr(); sbr3.sb_clr(); ) : s == 4 ? ( sbl4.sb_clr(); sbr4.sb_clr(); ) : ( sbl5.sb_clr(); sbr5.sb_clr(); );
);
function lb_rlen(i) ( i == 0 ? 1116 : i == 1 ? 1188 : i == 2 ? 1277 : i == 3 ? 1356 : i == 4 ? 1422 : i == 5 ? 1491 : i == 6 ? 1557 : 1617; );

function lb_clr(SLB) local(i) (
  i = 0; loop(6, memset(SLB + 64 + i * 9 + 5, 0, 4); i += 1; );
  memset(SLB + 120, 0, 40); SLB[13] = 0;
  SLB[6] == 5 ? SLB[122] = 1;
  SLB[6] == 6 ? SLB[122] = 1;
  SLB[6] == 9 ? memset(LB_FL + SLB[17] * 8192, 0, 8192);
  SLB[6] == 11 ? lb_sbz(SLB[17]);
  SLB[6] == 17 ? ( memset(LB_BIG + SLB[17] * LB_BS, 0, 2097152); SLB[133] = -1; );
  SLB[6] == 18 ? memset(LB_BIG + SLB[17] * LB_BS, 0, 1048576 + 262144);
);

function lb_design(SLB) local(m, kb, P, v, ub, t, q1, q2) (
  m = SLB[6]; kb = SLB[7]; P = SLB + 32;
  m == 1 ? (
    v = lb_map(1, 0, SLB[0]);
    P[0] = lb_db(v) * ((kb & 2) ? 2 : 1);
    P[1] = lb_db(lb_map(1, 2, SLB[2]) - v * 0.8) / ((kb & 2) ? 2 : 1) * ((kb & 1) ? -1 : 1);
