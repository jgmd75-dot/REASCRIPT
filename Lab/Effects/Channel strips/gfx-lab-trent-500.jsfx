@gfx 900 400
TQHT = 400; tq_f = 1 + (TQHT - 355) / 95 * 0.55; tq_e = (TQHT - 355) / 95;
ui_begin(900, TQHT);
v5_begin();
TQF = 0x4A4643; TQP = 0x524E4A; TQH = 0x1C1A19; TQI = 0xEDE6D3; TQA = 0xF0A63A;
sc != tq_fsc ? (
  tq_fsc = sc;
  tq_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  tq_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  tq_f6 = ui_fitfont(6, 24 * sc);
);
function tq_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * tq_kt * sc, 'b'); );
function tq_fa(px) ( gfx_setfont(10, "Arial", px * tq_ka * sc, 'b'); );
function tq_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function tq_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function tq_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function tq_lum(c) ( (0.2126 * ((c >> 16) & 255) + 0.7152 * ((c >> 8) & 255) + 0.0722 * (c & 255)) / 255; );
function tq_dfs(r, d) ( max(9, min(d, floor(r * 0.62 + 0.5))); );
function tq_kd(cx, cy, a, capr, at, sz) ( v5_d(cx + sin(a) * capr * at, cy - cos(a) * capr * at, max(capr * sz, 2)); );
function tq_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  gfx_gradrect(x * sc, y * sc, w * sc, h * sc, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (h * sc), (g2 - g1) / (h * sc), (b2 - b1) / (h * sc), 0);
);
function tq_y(y) ( 104 + (y - 104) * tq_f; );
function tq_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );

function ox_fstr(f) local(v) (
  f < 1000 ? sprintf(#oxfq, "%d Hz", floor(f + 0.5)) : (
    v = f / 1000;
    abs(v - floor(v + 0.5)) < 0.001 ? sprintf(#oxfq, "%d kHz", floor(v + 0.5)) : sprintf(#oxfq, "%.1f kHz", v);
  );
  #oxfq;
);
function lg_mname(m) ( m == 1 ? "IRON PRE" : m == 2 ? "FILTER" : m == 3 ? "4-BAND EQ" : m == 4 ? "VCA" : m == 5 ? "VARI-MU" :
  m == 6 ? "GATE" : m == 7 ? "DE-ESS" : m == 8 ? "DRIVE" : m == 9 ? "TAPE" : m == 10 ? "TAPE + OPTO" :
  m == 11 ? "SIDEBAR PRE" : m == 12 ? "PROGRAM EQ" : m == 13 ? "OPCOM" : m == 14 ? "FET" : m == 15 ? "TRANSIENT" :
  m == 16 ? "TILT" : m == 17 ? "ECHO" : m == 18 ? "SPACE" : ""; );
function lg_mmenu(m) ( m == 1 ? "IRON PRE  -  transformer preamp" : m == 2 ? "FILTER  -  high-pass / low-pass filter" : m == 3 ? "4-BAND EQ  -  broadcast EQ" :
  m == 4 ? "VCA  -  VCA compressor" : m == 5 ? "VARI-MU  -  vari-mu compressor" : m == 6 ? "GATE  -  gate / expander" :
  m == 7 ? "DE-ESS  -  de-esser" : m == 8 ? "DRIVE  -  drive" : m == 9 ? "TAPE  -  tape" : m == 10 ? "TAPE + OPTO  -  tape + opto" :
  m == 11 ? "SIDEBAR PRE  -  iron preamp with SIDEBAR" : m == 12 ? "PROGRAM EQ  -  program EQ" : m == 13 ? "OPCOM  -  opto compressor" :
  m == 14 ? "FET  -  FET limiter" : m == 15 ? "TRANSIENT  -  transient shaper" : m == 16 ? "TILT  -  tilt EQ" :
  m == 17 ? "ECHO  -  delay" : "SPACE  -  reverb"; );
function lg_mord(i) ( i == 0 ? 1 : i == 1 ? 11 : i == 2 ? 2 : i == 3 ? 3 : i == 4 ? 12 : i == 5 ? 16 : i == 6 ? 4 : i == 7 ? 5 :
  i == 8 ? 13 : i == 9 ? 14 : i == 10 ? 10 : i == 11 ? 6 : i == 12 ? 7 : i == 13 ? 15 : i == 14 ? 8 : i == 15 ? 9 : i == 16 ? 17 : 18; );
function lg_mtype(m) ( m == 1 ? "TRANSFORMER PREAMP" : m == 2 ? "HIGH-PASS / LOW-PASS" : m == 3 ? "BROADCAST EQUALISER" :
  m == 4 ? "VCA COMPRESSOR" : m == 5 ? "VARI-MU COMPRESSOR" : m == 6 ? "GATE / EXPANDER" : m == 7 ? "DE-ESSER" :
  m == 8 ? "STUDIO DRIVE" : m == 9 ? "TAPE MACHINE" : m == 10 ? "TAPE + OPTO" : m == 11 ? "IRON PREAMP" : m == 12 ? "PROGRAM EQUALISER" :
  m == 13 ? "OPTICAL COMPRESSOR" : m == 14 ? "FET LIMITER" : m == 15 ? "TRANSIENT SHAPER" : m == 16 ? "TILT EQUALISER" :
  m == 17 ? "TAPE-STYLE DELAY" : "REVERB"; );
function lg_mspec(m, kb) ( m == 1 ? "SHELVES 110 Hz / 8.8 kHz" : m == 2 ? ((kb & 3) == 0 ? "12 dB/OCT" : (kb & 3) == 3 ? "24 dB/OCT" : (kb & 1) ? "HP 24  /  LP 12 dB/OCT" : "HP 12  /  LP 24 dB/OCT") :
  m == 3 ? ((kb & 1) ? "BELLS 110 Hz / 8.8 kHz" : "SHELVES 110 Hz / 8.8 kHz") : m == 4 ? "FEED-FORWARD  -  6 dB KNEE" : m == 5 ? "FEEDBACK  -  VALVE PAIR" :
  m == 6 ? ((kb & 1) ? "1 : 2 EXPANDER" : "3 dB HYSTERESIS") : m == 7 ? ((kb & 1) ? "SPLIT BAND" : "WIDE BAND") : m == 8 ? "LEVEL-MATCHED" :
  m == 9 ? ((kb & 1) ? "30 IPS" : "15 IPS") : m == 10 ? ((kb & 2) ? "TAPE, THEN OPTO" : "OPTO, THEN TAPE") : m == 11 ? "IRON IN + OUT  -  SIDEBAR" :
  m == 12 ? "HIGH ATTEN SHELF 10 kHz" : m == 13 ? ((kb & 1) ? "10 : 1 LIMIT" : "3 : 1 COMPRESS") : m == 14 ? "FIXED THRESHOLD" :
  m == 15 ? ((kb & 1) ? "SHORT WINDOWS" : "LONG WINDOWS") : m == 16 ? ((kb & 2) ? "MID ONLY  -  AIR 16 kHz" : "STEREO  -  AIR 16 kHz") :
  m == 17 ? ((kb & 1) ? "PING-PONG" : "STEREO REPEATS") : ((kb & 1) ? "PLATE  -  8 LINES" : "ROOM  -  8 LINES"); );
function lg_fam(m) ( m == 1 || m == 11 ? 1 : m == 2 ? 2 : m == 3 || m == 12 || m == 16 ? 3 : m == 4 || m == 5 || m == 13 || m == 14 || m == 10 ? 4 :
  m == 6 || m == 7 || m == 15 ? 5 : m == 8 || m == 9 ? 6 : 7; );
function lg_fbase(m) local(f) ( f = lg_fam(m);
  f == 1 ? 0xD3CCBA : f == 2 ? 0xBBA766 : f == 3 ? 0x5B6C80 : f == 4 ? 0x86504A : f == 5 ? 0x655766 : f == 6 ? 0xB27D55 : 0x4E6E6C; );
function lg_shade(m) ( m == 11 || m == 12 || m == 4 || m == 7 || m == 17 ? 1 : m == 16 || m == 13 || m == 15 || m == 18 ? 2 : m == 14 || m == 9 ? 3 : m == 10 ? 4 : 0; );
function lg_face(m) local(c, v) ( c = lg_fbase(m); v = lg_shade(m);
  v == 1 ? ui_mix(c, 0, 0.16) : v == 2 ? ui_mix(c, 0xFFFFFF, 0.13) : v == 3 ? ui_mix(c, 0x808080, 0.38) : v == 4 ? ui_mix(c, 0x4A3A30, 0.3) : c; );
function lg_st1(m) ( m == 8 ? 0xC0561E : m == 10 ? 0x4E9A6E : m == 2 ? 0xE2D3B0 : m == 3 ? 0x8EC6F0 : m == 1 ? 0xC8CACC : m == 6 ? 0xF0C4CC : m == 5 ? 0xC7BEB3 : m == 11 ? 0xB0503A : m == 12 ? 0xC8A050 : m == 16 ? 0xE8826E : m == 4 ? 0xD0A232 : m == 13 ? 0xA01E32 :
  m == 14 ? 0x2E5C9A : m == 7 ? 0xB8BEC4 : m == 15 ? 0xC4C9CF : m == 9 ? 0x3A2A1E : m == 17 ? 0xE08A36 : m == 18 ? 0xB8A8D8 : 0; );
function lg_st2(m) ( m == 8 ? 0xC0561E : m == 10 ? 0x6A94D2 : m == 2 ? 0xE2D3B0 : m == 3 ? 0x8EC6F0 : m == 1 ? 0xC8CACC : m == 6 ? 0xF0C4CC : m == 5 ? 0xC7BEB3 : m == 11 ? 0xE8DFC6 : m == 12 ? 0xC8A050 : m == 16 ? 0xEDE5CF : m == 4 ? 0xD0A232 : m == 13 ? 0xA01E32 :
  m == 14 ? 0x8EC0EA : m == 7 ? 0xB8BEC4 : m == 15 ? 0xC4C9CF : m == 9 ? 0xE8DFC6 : m == 17 ? 0xE08A36 : m == 18 ? 0xF0ECF6 : 0; );
function lg_dark(m) local(f) ( f = lg_fam(m); f >= 3 && f != 6; );
function lg_mcol(m) ( ui_mix(lg_face(m), 0xFFFFFF, lg_dark(m) ? 0.5 : 0.4); );
function lg_kst(m) local(f) ( f = lg_fam(m); f == 1 ? 1 : f == 2 ? 2 : f == 3 ? 3 : f == 4 ? 4 : f == 5 ? 5 : f == 6 ? 6 : 7; );
function lg_kcap(m, k) (
