  tp == 9 ? ( slider4 = 50; );
  i = 2; loop(58, ui_auto(i); i += 1; );
  pr_cur = tp == 9 ? 1 : tp;
);

function lb_srinit() (
  lb_sr = srate; lb_rt = srate * os_f;
  lb_kc = 1 - exp(-16 / (0.03 * srate));
  lb_dks = 1 / (0.006 * srate);
  lb_iks = 1 / (0.01 * srate);
  c_kn = 1 - exp(-1 / (0.03 * srate));
  lb_fis = 1 / (0.01 * srate);
  ost_init(0);
  sb_rate(lb_rt);
  lb_redesign();
);
function lb_clear() ( upl.os_clr(); upr.os_clr(); dnl.os_clr(); dnr.os_clr(); );
function lb_reset() local(s) (
  lb_clear(); memset(BY_BUF, 0, 2 * BY_N);
  s = 0; loop(6, lb_clr(LB_SL + s * LB_SS); s += 1; );
  lb_fi = 0;
