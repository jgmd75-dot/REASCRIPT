    lb_ps(5, 18,  35,  1.2,   30,   12, 220, 8800, 3);
  ) : tp == 3 ? (
    lb_ps(0, 3,    3,    2,   -2,  440, 1.5, 4400, 0);
    lb_ps(1, 15,  40,  -15,    0,    0,   0,    0, 0);
