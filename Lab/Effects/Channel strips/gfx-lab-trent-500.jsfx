spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
lb_a = abs(spl0); lb_a > lb_pol ? lb_pol = lb_a; lb_a = abs(spl1); lb_a > lb_por ? lb_por = lb_a;
