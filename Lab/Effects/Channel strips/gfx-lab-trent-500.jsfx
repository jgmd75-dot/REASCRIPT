memset(LB_SL, 0, 6 * LB_SS);
memset(LB_MB, 0, 24);
lb_si = 0; loop(6, lb_b = LB_SL + lb_si * LB_SS; lb_b[17] = lb_si; lb_b[8] = 1; lb_b[9] = 1; lb_b[18] = 1; lb_si += 1; );
os_design();
os_f = os_tf = os_f2n(slider5); os_base = 0;
lb_srinit();
os_gsetup();
lb_clear();
d1.drift_init(0.8 + rand(1) * 0.4); d2.drift_init(0.8 + rand(1) * 0.4); d3.drift_init(0.8 + rand(1) * 0.4);
d4.drift_init(0.8 + rand(1) * 0.4); d5.drift_init(0.8 + rand(1) * 0.4); d6.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
lb_snap = 1; lb_fi = 1; lb_og = 1; lb_mx = 1;
pdc_delay = os_lat(os_f);
by_setup(1);
pwr_init(); pwr_sag = 0.2; pwr_wu_loss = 1; pwr_wu_drv = 1.5; pwr_wu_lp = 7000; pwr_wu_wob = 0.3; pwr_bloom = 0.15;

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(59, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
