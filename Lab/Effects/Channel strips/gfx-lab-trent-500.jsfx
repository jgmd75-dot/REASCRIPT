    lb_ps(2, 3,   -2,    3,   -4,  550,   3, 2200, 0);
    lb_ps(3, 4,  -20,    6,   80,    2,   4,    0, 0);
    lb_ps(4, 8,   10,   20,   50,   -1,   0,    0, 1);
