    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(5));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();
tq_rd = file_avail(0) >= 0;
!tq_rd ? tq_ver = 1;
file_avail(0) != 0 ? file_var(0, tq_ver) : tq_ver = 0;
tq_rd && tq_ver < 1 ? (
  tq_s = 0; loop(6, (slider(6 + tq_s) | 0) == 2 && slider(21 + tq_s * 6) == 0 ? slider(21 + tq_s * 6) = 0.5; tq_s += 1; );
  prs_h0 = prs_hash(); tq_ver = 1;
);

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != lb_sr ? lb_srinit();
lb_now = time_precise();
lb_tp > 0 && lb_now - lb_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > lb_gpp && play_position - lb_gpp < 4 * lb_gpd + 0.05) ? lb_reset();
lb_tp = lb_now; lb_gpp = play_position; lb_gpd = samplesblock / srate;
