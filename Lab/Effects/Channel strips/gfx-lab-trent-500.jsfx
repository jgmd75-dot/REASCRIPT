lb_ogt = lb_db(min(max(slider3, -18), 18));
lb_mxt = min(max(slider2, 0), 200) / 100;
lb_snap ? ( lb_og = lb_ogt; lb_mx = lb_mxt; );
lb_si = 0;
loop(6,
  lb_b = LB_SL + lb_si * LB_SS;
  lb_b[20] = min(max(slider(6 + lb_si) | 0, 0), 18);
  lb_b[21] = min(max(slider(54 + lb_si) | 0, 0), lb_b[20] == 2 ? 7 : 3);
  lb_b[22] = slider(12 + lb_si) >= 0.5;
  lb_k = 0; loop(6, lb_b[24 + lb_k] = min(max(slider(18 + lb_si * 6 + lb_k), 0), 1); lb_k += 1; );
  lb_b[20] != lb_b[6] || lb_b[21] != lb_b[7] ? lb_b[10] = 1;
  lb_snap ? ( lb_apply(lb_b); lb_b[8] = lb_b[22]; lb_b[9] = 1; lb_b[18] = lb_b[8]; );
  lb_dv = lb_si == 0 ? d1.drift_tick(0.04 * dm_s * lb_n) : lb_si == 1 ? d2.drift_tick(0.04 * dm_s * lb_n) :
          lb_si == 2 ? d3.drift_tick(0.04 * dm_s * lb_n) : lb_si == 3 ? d4.drift_tick(0.04 * dm_s * lb_n) :
          lb_si == 4 ? d5.drift_tick(0.04 * dm_s * lb_n) : d6.drift_tick(0.04 * dm_s * lb_n);
  lb_b[12] = dm_a * lb_dv;
  LB_MB[lb_si * 2] = max(LB_MB[lb_si * 2], lb_b[14]); lb_b[14] = 0;
  LB_MB[lb_si * 2 + 1] = max(LB_MB[lb_si * 2 + 1], lb_b[15]); lb_b[15] = 0;
  LB_MB[12 + lb_si] = max(LB_MB[12 + lb_si], lb_b[16]); lb_b[16] = 0;
  lb_si += 1;
);
lb_snap = 0;
lb_inl_d = max(lb_inl_d, lb_pil); lb_inr_d = max(lb_inr_d, lb_pir); lb_pil = lb_pir = 0;
lb_otl_d = max(lb_otl_d, lb_pol); lb_otr_d = max(lb_otr_d, lb_por); lb_pol = lb_por = 0;
os_snapb(slider(5));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
lb_a = abs(spl0); lb_a > lb_pil ? lb_pil = lb_a; lb_a = abs(spl1); lb_a > lb_pir ? lb_pir = lb_a;
lb_og += (lb_ogt - lb_og) * c_kn; lb_mx += (lb_mxt - lb_mx) * c_kn;
lb_si = 0;
loop(6,
  lb_b = LB_SL + lb_si * LB_SS;
  lb_b[10] ? ( lb_b[9] = max(lb_b[9] - lb_dks, 0); lb_b[9] <= 0 ? lb_apply(lb_b); ) : lb_b[9] < 1 ? lb_b[9] = min(lb_b[9] + lb_dks, 1);
  lb_b[22] ? ( lb_b[8] < 1 ? lb_b[8] = min(lb_b[8] + lb_iks, 1); ) : ( lb_b[8] > 0 ? lb_b[8] = max(lb_b[8] - lb_iks, 0); );
  lb_a = lb_b[9] * lb_b[9] * (3 - 2 * lb_b[9]); lb_q = lb_b[8] * lb_b[8] * (3 - 2 * lb_b[8]);
  lb_b[18] = lb_a * lb_q;
  lb_si += 1;
);
sb_glide(c_kn, c_kn);
lb_cc += 1; lb_cc >= 16 ? ( lb_cc = 0; lb_ctl(); );
pwr_in(spl0, spl1); lb_xl = pwr_l; lb_xr = pwr_r;
os_gate();
os_chg ? ( lb_rt = srate * os_f; sb_rate(lb_rt); lb_redesign(); lb_clear(); os_hold += 2 * samplesblock; );
upl.os_up(lb_xl); upr.os_up(lb_xr);
os_f == 1 ? (
  lb_l = upl.s0; lb_r = upr.s0; lb_chain(); lb_yl = lb_l; lb_yr = lb_r;
) : (
  lb_l = upl.s0; lb_r = upr.s0; lb_chain(); lb_a0 = lb_l; lb_b0 = lb_r;
  lb_l = upl.s1; lb_r = upr.s1; lb_chain(); lb_a1 = lb_l; lb_b1 = lb_r;
  os_f == 2 ? ( lb_yl = dnl.os_dn(lb_a0, lb_a1, 0, 0); lb_yr = dnr.os_dn(lb_b0, lb_b1, 0, 0); ) : (
    lb_l = upl.s2; lb_r = upr.s2; lb_chain(); lb_a2 = lb_l; lb_b2 = lb_r;
    lb_l = upl.s3; lb_r = upr.s3; lb_chain(); lb_a3 = lb_l; lb_b3 = lb_r;
    lb_yl = dnl.os_dn(lb_a0, lb_a1, lb_a2, lb_a3); lb_yr = dnr.os_dn(lb_b0, lb_b1, lb_b2, lb_b3);
  );
);
pwr_out(lb_yl, lb_yr); lb_yl = pwr_l; lb_yr = pwr_r;
lb_osg = os_g * os_g * (3 - 2 * os_g);
lb_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; lb_q = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
lb_wm = (lb_yl + lb_yr) * 0.5; lb_ws = (lb_yl - lb_yr) * 0.5 * lb_mx;
lb_yl = (lb_wm + lb_ws) * lb_osg * lb_og;
lb_yr = (lb_wm - lb_ws) * lb_osg * lb_og;
lb_yl != lb_yl ? lb_yl = 0; lb_yr != lb_yr ? lb_yr = 0;
lb_fi < 1 ? (
  lb_fi = min(lb_fi + lb_fis, 1); lb_z = lb_fi * lb_fi * (3 - 2 * lb_fi);
