desc:Havel 500 [channel strip] (GFX Lab)
//tags: channel strip 500 series preamp eq compressor limiter valve broadcast console
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-os, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

slider64:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider62:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider1:order=0<0,1,1{EQ first,DYN first}>-Order
slider2:pre_m=0<0,2,1{Elbe,Spree,Mistral}>-PRE Model
slider3:eq_m=1<0,2,1{Elbe,Spree,Mistral}>-EQ Model
slider4:dyn_m=2<0,2,1{Elbe,Spree,Mistral}>-DYN Model
slider5:pre_on=1<0,1,1{Off,On}>-PRE In
slider6:eq_on=1<0,1,1{Off,On}>-EQ In
slider7:dyn_on=0<0,1,1{Off,On}>-DYN In
slider8:out_db=0<-12,12,0.5>-Output (dB)
slider9:out_sat=0<0,100,1>-Output Sat (%)
slider10:drift=50<0,100,1>-Drift (%)
slider11:pol=0<0,1,1{Normal,Reversed}>-PRE Phase
slider12:e_gain=0<-6,18,3>-Elbe PRE Gain (dB)
slider13:e_cut=0<0,2,1{Off,60 Hz,120 Hz}>-Elbe PRE HPF
slider14:s_gain=0<-24,24,0.1>-Spree PRE Gain (dB)
slider15:s_hpf=0<0,2,1{Off,80 Hz,140 Hz}>-Spree PRE HPF
slider16:m_hpf=0<0,3,1{Off,40 Hz,80 Hz,120 Hz}>-Mistral PRE HPF
slider17:m_gain=0<-12,15,3>-Mistral PRE Gain (dB)
slider18:m_dv=0<0,10,2>-Mistral PRE Output dV (dB)
slider19:e_lo_g=0<-12,12,2>-Elbe EQ Low (dB)
slider20:e_lo_f=2<0,4,1{40 Hz,60 Hz,100 Hz,150 Hz,220 Hz}>-Elbe EQ Low Freq
slider21:e_pr_g=0<0,10,2>-Elbe EQ Presence (dB)
slider22:e_pr_f=1<0,4,1{1.4 kHz,2 kHz,2.8 kHz,4 kHz,5.6 kHz}>-Elbe EQ Presence Freq
slider23:e_hi_g=0<-12,12,2>-Elbe EQ High (dB)
slider24:e_hi_f=1<0,3,1{5 kHz,7 kHz,10 kHz,14 kHz}>-Elbe EQ High Freq
slider25:s_hg=5<0,10,1{-15,-10,-6,-4,-2,0,+2,+4,+6,+10,+15}>-Spree EQ High Gain (dB)
slider26:s_hf=5<0,10,1{1.5k,1.9k,2.4k,3k,3.8k,4.7k,6k,7.5k,9.5k,11.5k,15k}>-Spree EQ High Freq
slider27:s_hq=1<0,2,1{Narrow,Medium,Broad}>-Spree EQ High Q
slider28:s_mg=5<0,10,1{-15,-10,-6,-4,-2,0,+2,+4,+6,+10,+15}>-Spree EQ Mid Gain (dB)
slider29:s_mf=5<0,10,1{300,378,475,600,754,950,1.2k,1.5k,1.9k,2.4k,3k}>-Spree EQ Mid Freq
slider30:s_mq=1<0,2,1{Narrow,Medium,Broad}>-Spree EQ Mid Q
slider31:s_lg=5<0,10,1{-15,-10,-6,-4,-2,0,+2,+4,+6,+10,+15}>-Spree EQ Low Gain (dB)
slider32:s_lf=3<0,10,1{45,57,71,90,113,142,180,226,285,357,450}>-Spree EQ Low Freq
slider33:s_lq=1<0,2,1{Narrow,Medium,Broad}>-Spree EQ Low Q
slider34:m_hs=0<-15,15,3>-Mistral EQ High Shelf (dB)
slider35:m_ls=0<-15,15,3>-Mistral EQ Low Shelf (dB)
slider36:m_pf=1<0,5,1{0.7 kHz,1.0 kHz,1.5 kHz,2.3 kHz,3.5 kHz,5.6 kHz}>-Mistral EQ Presence Freq
slider37:m_pg=0<-8,8,2>-Mistral EQ Presence Gain (dB)
slider38:e_thr=6<-20,20,0.5>-Elbe DYN Threshold (dBu)
slider39:e_mode=0<0,1,1{Comp,Limit}>-Elbe DYN Mode
slider40:e_atk=1<0,2,1{Fast,Medium,Slow}>-Elbe DYN Attack
slider41:e_rel=2<0,5,1{0.3 s,0.6 s,1.2 s,2.5 s,5 s,Auto}>-Elbe DYN Release
slider42:e_cg=0<0,20,0.5>-Elbe DYN Gain (dB)
slider43:s_thr=-12<-40,0,1>-Spree DYN Threshold (dB)
slider44:s_ratio=2<0,4,1{1:1,1.5:1,2:1,3:1,5:1}>-Spree DYN Ratio
slider45:s_atk=1<0,2,1{0.25 ms,2.5 ms,25 ms}>-Spree DYN Attack
slider46:s_rel=3<0,7,1{0.1 s,0.2 s,0.5 s,1 s,2 s,5 s,10 s,Auto}>-Spree DYN Release
slider47:s_lthr=1<-20,1,1>-Spree DYN Limit Threshold (dB, top = Off)
slider48:s_mk=0<0,10,0.5>-Spree DYN Makeup (dB)
slider49:s_ethr=-70<-70,-20,1>-Spree DYN Expander Threshold (dB, bottom = Off)
slider50:s_erel=1<0,3,1{0.05 s,0.2 s,0.5 s,2 s}>-Spree DYN Expander Release
slider51:s_link=1<0,1,1{Dual,Linked}>-Spree DYN Stereo Link
slider52:s_dess=0<0,1,1{Off,On}>-Spree DYN De-Ess
slider53:s_bcut=0<0,1,1{Off,On}>-Spree DYN SC HPF
slider54:m_thr=-10<-30,0,2.5>-Mistral DYN Threshold (dB)
slider55:m_deg=3<0,9,1{Limit 3,Limit 2,Limit 1,Off,1.5:1,2:1,3:1,4:1,6:1,10:1}>-Mistral DYN Limit / Compress
slider56:m_rec=1<0,4,1{0.3 s,0.8 s,2 s,5 s,Prog}>-Mistral DYN Recovery
slider57:m_sc=1<0,3,1{Off,60 Hz,120 Hz,200 Hz}>-Mistral DYN SC HPF
slider58:m_mk=0<0,20,0.5>-Mistral DYN Makeup (dB)
slider59:m_ceil=0.5<-12,0.5,0.1>-Mistral DYN Limiter Ceiling (dB, top = Off)
slider60:m_lrel=2<0,5,1{10 ms,25 ms,50 ms,100 ms,200 ms,500 ms}>-Mistral DYN Limiter Release
slider61:byp_on=0<0,1,1{Off,On}>-Bypass
slider63:prs_sel=0<0,12,1{No preset,Init,Vocal: Valve Front,Vocal: Radio Voice,Vocal: Close and Soft,Drums: Room Smash,Drums: Snare Crack,Bass: Iron Weight,Guitar: Edge,Acoustic: Air,Keys: Sheen,Bus: Glue,Colour: Hot Valve}>-Preset

@init
ext_gr_meter = 0;
ext_noinit = 1;
#ui_man = "gfx-lab-havel-500";
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; ); ui_dflt = 1;
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(s_dess, v); slider_show(s_bcut, v); slider_show(m_thr, v); slider_show(m_deg, v); slider_show(m_rec, v); slider_show(m_sc, v); slider_show(m_mk, v); slider_show(m_ceil, v); slider_show(m_lrel, v); slider_show(byp_on, v); slider_show(os_sel, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(s_dess, v); slider_show(s_bcut, v); slider_show(m_thr, v); slider_show(m_deg, v); slider_show(m_rec, v); slider_show(m_sc, v); slider_show(m_mk, v); slider_show(m_ceil, v); slider_show(m_lrel, v); slider_show(byp_on, v); slider_show(os_sel, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
HV_OS = 8380000; hv_fs = srate; os_design(); os_base = 0;
os_f = os_tf = os_f2n(os_sel); os_gsetup(); pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(61);
pwr_init(); pwr_sag = 0.2; pwr_wu_loss = 1; pwr_wu_drv = 1.5; pwr_wu_lp = 7000; pwr_wu_wob = 0.2; pwr_bloom = 0.15;
#hv_pm = "Init|Vocal: Valve Front|Vocal: Radio Voice|Vocal: Close and Soft|Drums: Room Smash|Drums: Snare Crack|Bass: Iron Weight|Guitar: Edge|Acoustic: Air|Keys: Sheen|Bus: Glue|Colour: Hot Valve";
gfx_ext_retina = 1;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
CR = 16;

mod_on = 0;  mod_tgt = 4;
LOF = 100; LOF[0] = 40;  LOF[1] = 60;  LOF[2] = 100;  LOF[3] = 150;  LOF[4] = 220;
PRF = 108; PRF[0] = 1400;  PRF[1] = 2000;  PRF[2] = 2800;  PRF[3] = 4000;  PRF[4] = 5600;
HIF = 116; HIF[0] = 5000;  HIF[1] = 7000;  HIF[2] = 10000;  HIF[3] = 14000;
RELT = 124; RELT[0] = 0.3;  RELT[1] = 0.6;  RELT[2] = 1.2;  RELT[3] = 2.5;  RELT[4] = 5;
ATKT = 132; ATKT[0] = 2;  ATKT[1] = 8;  ATKT[2] = 25;
eqg_tab = 140; eqg_tab[0]=-15; eqg_tab[1]=-10; eqg_tab[2]=-6; eqg_tab[3]=-4; eqg_tab[4]=-2; eqg_tab[5]=0;
eqg_tab[6]=2; eqg_tab[7]=4; eqg_tab[8]=6; eqg_tab[9]=10; eqg_tab[10]=15;
hf_tab = 160; hf_tab[0]=1500; hf_tab[1]=1900; hf_tab[2]=2400; hf_tab[3]=3000; hf_tab[4]=3800; hf_tab[5]=4700;
hf_tab[6]=6000; hf_tab[7]=7500; hf_tab[8]=9500; hf_tab[9]=11500; hf_tab[10]=15000;
mf_tab = 180; mf_tab[0]=300; mf_tab[1]=378; mf_tab[2]=475; mf_tab[3]=600; mf_tab[4]=754; mf_tab[5]=950;
mf_tab[6]=1200; mf_tab[7]=1500; mf_tab[8]=1900; mf_tab[9]=2400; mf_tab[10]=3000;
lf_tab = 200; lf_tab[0]=45; lf_tab[1]=57; lf_tab[2]=71; lf_tab[3]=90; lf_tab[4]=113; lf_tab[5]=142;
lf_tab[6]=180; lf_tab[7]=226; lf_tab[8]=285; lf_tab[9]=357; lf_tab[10]=450;
q_tab = 220; q_tab[0]=2.0; q_tab[1]=1.0; q_tab[2]=0.5;
srt_tab = 230; srt_tab[0]=1; srt_tab[1]=1.5; srt_tab[2]=2; srt_tab[3]=3; srt_tab[4]=5;
sat_tab = 240; sat_tab[0]=0.25; sat_tab[1]=2.5; sat_tab[2]=25;
srl_tab = 250; srl_tab[0]=100; srl_tab[1]=200; srl_tab[2]=500; srl_tab[3]=1000; srl_tab[4]=2000; srl_tab[5]=5000; srl_tab[6]=10000;
ser_tab = 260; ser_tab[0]=50; ser_tab[1]=200; ser_tab[2]=500; ser_tab[3]=2000;
mpf_tab = 270; mpf_tab[0] = 700;  mpf_tab[1] = 1000; mpf_tab[2] = 1500; mpf_tab[3] = 2300; mpf_tab[4] = 3500; mpf_tab[5] = 5600;
mrt_tab = 280; mrt_tab[1] = 1.5; mrt_tab[2] = 2; mrt_tab[3] = 3; mrt_tab[4] = 4; mrt_tab[5] = 6; mrt_tab[6] = 10;
mlr_tab = 290; mlr_tab[0] = 10; mlr_tab[1] = 25; mlr_tab[2] = 50; mlr_tab[3] = 100; mlr_tab[4] = 200; mlr_tab[5] = 500;
mrc_tab = 300; mrc_tab[0] = 300; mrc_tab[1] = 800; mrc_tab[2] = 2000; mrc_tab[3] = 5000;

EL_PK = 0.32; EL_PB = 0.14; EL_EK = 0.16; EL_EB = 0.08; EL_MK0 = 0.12; EL_MK1 = 0.42; EL_MB = 0.10;
EL_XI = 0.55; EL_XO = 0.40; EL_DIP = -3;
SP_IRON = 80; SP_K = 0.2; SP_B = 0.08;
MI_LS = 120; MI_HS = 9000; MI_PQ = 0.9; MI_IRON = 50; MI_K = 0.2; MI_B = 0.04;

HTL.drift_init(0.8 + rand(1) * 0.4);  HTR.drift_init(0.8 + rand(1) * 0.4);
HGL.drift_init(0.7 + rand(1) * 0.4);  HGR.drift_init(0.7 + rand(1) * 0.4);
MNS.drift_init(1.0 + rand(1) * 0.4);
CPA.drift_init(0.6 + rand(1) * 0.4);  CPR.drift_init(0.6 + rand(1) * 0.4);  CPT.drift_init(0.6 + rand(1) * 0.4);
warm_t = 0;

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );
function tg(f) ( tan($pi * min(f, hv_fs * 0.45) / hv_fs); );
function zc() instance(z1, z2, dx, dy, lp, ic1, ic2, s, xp, fp, yp) ( z1 = z2 = dx = dy = lp = ic1 = ic2 = s = xp = fp = yp = 0; );

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function dts(b) local(u, v) ( u = 27 + 9 * b * b;  v = 27 + b * b;  ((27 + 3 * b * b) * u - b * v * 18 * b) / (u * u); );
function valve(x, k, b, sl, dr) instance(dx, dy) local(y) (
  y = (ts(x * k + b) - ts(b)) / (k * sl);
  dy = y - dx + dr * dy;  dx = y;
  dy;
);
function xfmr(x, k, c) instance(lp) ( lp += (x - lp) * c;  x - lp + ts(lp * k) / k; );
function bq_set(kind, f, db, q) instance(b0, b1, b2, a1, a2, n0, n1, n2, m1, m2, bq_n) local(ga, w, cw, sw, alp, a0, sa) (
  ga = 10 ^ (db / 40);  w = 2 * $pi * min(f, 0.45 * hv_fs) / hv_fs;  cw = cos(w);  sw = sin(w);  alp = sw / (2 * q);
  kind == 0 ? (
    a0 = 1 + alp / ga;  n0 = (1 + alp * ga) / a0;  n1 = -2 * cw / a0;  n2 = (1 - alp * ga) / a0;  m1 = -2 * cw / a0;  m2 = (1 - alp / ga) / a0;
  ) : kind == 1 ? (
    sa = 2 * sqrt(ga) * alp;
    a0 = (ga + 1) + (ga - 1) * cw + sa;
    n0 = ga * ((ga + 1) - (ga - 1) * cw + sa) / a0;  n1 = 2 * ga * ((ga - 1) - (ga + 1) * cw) / a0;  n2 = ga * ((ga + 1) - (ga - 1) * cw - sa) / a0;
    m1 = -2 * ((ga - 1) + (ga + 1) * cw) / a0;  m2 = ((ga + 1) + (ga - 1) * cw - sa) / a0;
  ) : kind == 2 ? (
    sa = 2 * sqrt(ga) * alp;
    a0 = (ga + 1) - (ga - 1) * cw + sa;
    n0 = ga * ((ga + 1) + (ga - 1) * cw + sa) / a0;  n1 = -2 * ga * ((ga - 1) + (ga + 1) * cw) / a0;  n2 = ga * ((ga + 1) + (ga - 1) * cw - sa) / a0;
    m1 = 2 * ((ga - 1) - (ga + 1) * cw) / a0;  m2 = ((ga + 1) - (ga - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + alp;  n0 = (1 + cw) * 0.5 / a0;  n1 = -(1 + cw) / a0;  n2 = (1 + cw) * 0.5 / a0;  m1 = -2 * cw / a0;  m2 = (1 - alp) / a0;
  );
  bq_jump ? ( b0 = n0;  b1 = n1;  b2 = n2;  a1 = m1;  a2 = m2;  bq_n = 0; ) : bq_n = CR;
);
function bq(x) instance(b0, b1, b2, a1, a2, n0, n1, n2, m1, m2, bq_n, z1, z2) local(y, t) (
  bq_n > 0 ? ( t = 1 / bq_n;  b0 += (n0 - b0) * t;  b1 += (n1 - b1) * t;  b2 += (n2 - b2) * t;  a1 += (m1 - a1) * t;  a2 += (m2 - a2) * t;  bq_n -= 1; );
  y = b0 * x + z1;  z1 = b1 * x - a1 * y + z2;  z2 = b2 * x - a2 * y;  y;
);

function op_set(fc) instance(g) local(w) ( w = tg(fc);  g = w / (1 + w); );
function op_lp(x) instance(g, s) local(v, y) ( v = (x - s) * g;  y = v + s;  s = y + v;  y; );
function svf_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tg(fc);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf_tick(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;
  lp = v2;  bp = v1;  hp = x - k * v1 - v2;
);
function bell_set(fc, q, db) instance(g, k, a1, a2, a3, m1) local(ga) (
  ga = exp(db * 0.05756462732485115);  g = tg(fc);  k = 1 / (q * ga);
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  m1 = k * (ga * ga - 1);
);
function bell_tick(x) instance(g, k, a1, a2, a3, m1, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;
  x + m1 * v1;
);
function sat_f(x) ( x / (1 + abs(x)); );
function sat_ad(x) ( abs(x) - log(1 + abs(x)); );
function adaa(x) instance(xp, fp, yp) local(fq, yc, d, y) (
  fq = sat_ad(x);  yc = sat_f(x);  d = x - xp;
  abs(d) < 0.00001 ? ( y = sat_f(0.5 * (x + xp)); ) : ( y = (fq - fp) / d; );
  y += 0.5 * (yc - yp);  xp = x;  fp = fq;  yp = yc;
  y;
);

function adab(x) instance(xp, fp, yp) local(fq, yc, d, y) (
  fq = sqrt(1 + x * x);  yc = x / fq;  d = x - xp;
  abs(d) < 0.00001 ? ( y = 0.5 * (x + xp) / sqrt(1 + 0.25 * sqr(x + xp)); ) : ( y = (fq - fp) / d; );
  y += 0.5 * (yc - yp);  xp = x;  fp = fq;  yp = yc;
  y;
);
function el_pre(x, hg, bias, sl) instance(av, hp) local(y) (
  y = av.valve(x * el_pg * hg, EL_PK, bias, sl, el_drp) * pol_s;
  hp.bq(y);
);
function sp_pre(x) instance(lc, ironlp, ironsat, stage, dc) local(y, lf, s) (
  y = x * sp_g;
  sp_hpon ? ( lc.svf_tick(y); y = lc.hp; );
  lf = ironlp.op_lp(y);
  y = (y - lf) + ironsat.adaa(lf * sp_ik) / sp_ik;
  s = y * sp_kd;
  abs(s) > sp_pk ? sp_pk = abs(s);
  y = (stage.adaa(s + SP_B) - sp_bf) * sp_nd;
  y - dc.op_lp(y);
);
function mi_pre(x) instance(lc, ironlp, ironsat, stage, dc) local(y, lf) (
  y = x * mi_g;
  mi_hpon ? ( lc.svf_tick(y); y = lc.hp; );
  lf = ironlp.op_lp(y);
  y = (y - lf) + ironsat.adaa(lf * mi_ik) / mi_ik;
  y = (stage.adab(y * mi_kd + MI_B) - mi_bf) * mi_nd;
  y = y - dc.op_lp(y);
  y * mi_post;
);
function sp_eqt(x) instance(hb, mb, lb) local(y) (
  y = x;
  sp_eh ? y = hb.bell_tick(y);
  sp_em ? y = mb.bell_tick(y);
  sp_el ? y = lb.bell_tick(y);
  y;
);
function mi_eqt(x) instance(lo, hi, mid) local(l, h) (
  l = lo.op_lp(x);  h = x - hi.op_lp(x);  mid.svf_tick(x);
  x + mi_lg1 * l + mi_hg1 * h + mi_pg1 * mid.k * mid.bp;
);

function sp_gain(ldb, pdb) instance(cgr, lgr, egr) local(over, gt, c, lt, et) (
  over = ldb - sp_thd;
  over <= -3 ? gt = 0 : over >= 3 ? gt = over * sp_slope : gt = sp_slope * sqr(over + 3) / 12;
  gt > cgr ? c = sp_ac : ( sp_rauto ? c = (cgr - gt) > 3 ? sp_rcf : sp_rcs : c = sp_rc; );
  cgr += (gt - cgr) * c;
  sp_lon ? (
    lt = max(0, (pdb - cgr) - s_lthr) * 0.98;
    lt > lgr ? lgr += (lt - lgr) * sp_lac : lgr += (lt - lgr) * sp_lrc;
  ) : lgr = 0;
  sp_eon ? (
    et = min(20, max(0, s_ethr - ldb));
    et > egr ? egr += (et - egr) * sp_erc : egr += (et - egr) * sp_eac;
  ) : egr = 0;
  db2g(s_mk - cgr - lgr - egr);
);
function sp_dyn() local(sl, sr, ll, lr, gl, gr, ql, qr) (
  sl = aL;  sr = aR;
  s_bcut >= 0.5 ? ( bcL.svf_tick(sl); sl = bcL.hp;  bcR.svf_tick(sr); sr = bcR.hp; );
  s_dess >= 0.5 ? ( dsL.svf_tick(sl); sl += 3 * dsL.k * dsL.bp;  dsR.svf_tick(sr); sr += 3 * dsR.k * dsR.bp; );
  sp_rl += (sl * sl - sp_rl) * sp_rmc;  sp_rr += (sr * sr - sp_rr) * sp_rmc;
  ll = abs(sl);  lr = abs(sr);
  s_link >= 0.5 ? (
    ql = max(sp_rl, sp_rr);  ll = max(ll, lr);
    gl = spdL.sp_gain(ql > 0.000000000001 ? 10 * log10(ql) + 3 : -120, ll > 0.000001 ? g2db(ll) : -120);  gr = gl;
  ) : (
    gl = spdL.sp_gain(sp_rl > 0.000000000001 ? 10 * log10(sp_rl) + 3 : -120, ll > 0.000001 ? g2db(ll) : -120);
    gr = spdR.sp_gain(sp_rr > 0.000000000001 ? 10 * log10(sp_rr) + 3 : -120, lr > 0.000001 ? g2db(lr) : -120);
  );
  aL *= gl;  aR *= gr;
  dyn_pk = max(dyn_pk, max(spdL.cgr + spdL.lgr, s_link >= 0.5 ? 0 : spdR.cgr + spdR.lgr));
);
function mi_dyn() local(sl, sr, lvl, ldb, over, hk, gt, c, gg, pk, tgt) (
  mi_scon ? ( scL.svf_tick(aL); scR.svf_tick(aR); sl = scL.hp; sr = scR.hp; ) : ( sl = aL; sr = aR; );
  lvl = max(abs(sl), abs(sr));
  ldb = lvl > 0.000001 ? 8.685889638065035 * log(lvl) : -120;
  over = ldb - mi_thd;  hk = mi_knee * 0.5;
  over <= -hk ? gt = 0 : over >= hk ? gt = over * mi_slope : gt = mi_slope * sqr(over + hk) / (2 * mi_knee);
  gt > mi_cgr ? c = mi_ac : ( m_rec >= 3.5 ? c = (mi_cgr - gt) > 3 ? mi_rcf : mi_rcs : c = mi_rc; );
  mi_cgr += (gt - mi_cgr) * c;
  gg = db2g(m_mk - mi_cgr);
  aL *= gg;  aR *= gg;
  mi_lon ? (
    pk = max(abs(aL), abs(aR));
    tgt = pk > mi_lcg ? mi_lcg / pk : 1;
    tgt < mi_lg ? mi_lg = tgt : mi_lg += (tgt - mi_lg) * mi_lrc;
    aL *= mi_lg;  aR *= mi_lg;
  ) : mi_lg = 1;
  dyn_pk = max(dyn_pk, mi_cgr - g2db(mi_lg));
);
function el_eqt() local(el, er) (
  el = HSL.bq(PRL.bq(LSL.bq(aL)));  er = HSR.bq(PRR.bq(LSR.bq(aR)));
  aL = EVL.valve(el, EL_EK, EL_EB, el_esl, el_dr);  aR = EVR.valve(er, EL_EK, EL_EB, el_esl, el_dr);
);
function el_dyn() local(ql, qr) (
  ql = aL * el_cg;  qr = aR * el_cg;
  el_det += (max(ql * ql, qr * qr) - el_det) * el_rmsc;
  aL = DPL.bq(MVL.valve(ql * el_mkg, el_muk, EL_MB, el_musl, el_dr));
  aR = DPR.bq(MVR.valve(qr * el_mkg, el_muk, EL_MB, el_musl, el_dr));
  dyn_pk = max(dyn_pk, -el_gr);
);

function run_eq() ( mdl_e == 0 ? el_eqt() : mdl_e == 1 ? ( aL = speL.sp_eqt(aL); aR = speR.sp_eqt(aR); ) : ( aL = mieL.mi_eqt(aL); aR = mieR.mi_eqt(aR); ); );
function run_dyn() ( mdl_d == 0 ? el_dyn() : mdl_d == 1 ? sp_dyn() : mi_dyn(); );
function run_module(m) local(w, dl, dr) (
  w = mod_on[m];
  w > 0 ? (
    dl = aL;  dr = aR;
    m == 1 ? run_eq() : run_dyn();
    w < 1 ? ( aL = dl + (aL - dl) * w;  aR = dr + (aR - dr) * w; );
  ) : m == 2 && mdl_d == 0 ? ( el_det = 0; el_gr = 0; el_cg = 1; el_cgi = 0; );
);

function clr_pre(k) (
  k == 0 ? ( elpL.av.zc(); elpL.hp.zc(); elpR.av.zc(); elpR.hp.zc(); ) :
  k == 1 ? ( sppL.lc.zc(); sppL.ironlp.zc(); sppL.ironsat.zc(); sppL.stage.zc(); sppL.dc.zc(); sppR.lc.zc(); sppR.ironlp.zc(); sppR.ironsat.zc(); sppR.stage.zc(); sppR.dc.zc(); ) :
           ( mipL.lc.zc(); mipL.ironlp.zc(); mipL.ironsat.zc(); mipL.stage.zc(); mipL.dc.zc(); mipR.lc.zc(); mipR.ironlp.zc(); mipR.ironsat.zc(); mipR.stage.zc(); mipR.dc.zc(); mipL.stage.fp = mipR.stage.fp = 1; MHL.zc(); MHR.zc(); );
);
function clr_eq(k) (
  k == 0 ? ( LSL.zc(); PRL.zc(); HSL.zc(); EVL.zc(); LSR.zc(); PRR.zc(); HSR.zc(); EVR.zc(); ) :
  k == 1 ? ( speL.hb.zc(); speL.mb.zc(); speL.lb.zc(); speR.hb.zc(); speR.mb.zc(); speR.lb.zc(); ) :
           ( mieL.lo.zc(); mieL.hi.zc(); mieL.mid.zc(); mieR.lo.zc(); mieR.hi.zc(); mieR.mid.zc(); );
);
function clr_dyn(k) (
  k == 0 ? ( el_det = 0; el_gr = 0; el_gravg = 0; el_cg = 1; el_cgi = 0; DPL.zc(); DPR.zc(); MVL.zc(); MVR.zc(); ) :
  k == 1 ? ( sp_rl = sp_rr = 0; spdL.cgr = spdL.lgr = spdL.egr = 0; spdR.cgr = spdR.lgr = spdR.egr = 0; bcL.zc(); bcR.zc(); dsL.zc(); dsR.zc(); ) :
           ( mi_cgr = 0; mi_lg = 1; scL.zc(); scR.zc(); );
);

function hv_reset() local(k) (
  k = 0; loop(3, clr_pre(k); clr_eq(k); clr_dyn(k); k += 1; );
  XIL.zc(); XIR.zc(); XQL.zc(); XQR.zc(); XHL.zc(); XHR.zc();
  osuL.os_clr(); osuR.os_clr(); osdL.os_clr(); osdR.os_clr();
  ostL.ost_ch_init(); ostR.ost_ch_init();
  sag_env = 0; memset(BY_BUF, 0, 2 * BY_N); hv_fi = 0;
);

function el_target() (
  t_pg = e_gain;  t_cutf = log(e_cut < 0.5 ? 8 : e_cut < 1.5 ? 60 : 120);
  t_lo = e_lo_g;  t_lof = log(LOF[floor(e_lo_f + 0.5)]);
  t_pr = e_pr_g;  t_prf = log(PRF[floor(e_pr_f + 0.5)]);
  t_hi = e_hi_g;  t_hif = log(HIF[floor(e_hi_f + 0.5)]);
  t_thr = e_thr;  t_mk = e_cg;
  el_lim = e_mode >= 0.5;
  el_atk = ATKT[floor(e_atk + 0.5)];
  el_rauto = e_rel >= 4.5;  el_rels = el_rauto ? 1 : RELT[floor(e_rel + 0.5)];
);

function update_params() local(i, f) (
  hv_fs = srate;
  ord_new = order >= 0.5;
  mdl_new = floor(pre_m + 0.5) + 3 * floor(eq_m + 0.5) + 9 * floor(dyn_m + 0.5);
  mod_tgt[0] = pre_on >= 0.5;  mod_tgt[1] = eq_on >= 0.5;  mod_tgt[2] = dyn_on >= 0.5;
  t_pol = pol >= 0.5 ? -1 : 1;
  el_target();

  sp_g = db2g(s_gain);
  sp_ik = 0.15 + 0.01 * max(s_gain, 0);
  sp_bf = sat_f(SP_B);
  sp_hpon = s_hpf >= 0.5;
  mi_g = db2g(m_gain);
  mi_post = db2g(m_dv) / max(mi_g, 1);
  mi_ik = 0.15 + 0.05 * max(m_gain, 0);
  mi_bf = MI_B / sqrt(1 + MI_B * MI_B);
  mi_hpon = m_hpf >= 0.5;
  hv_fs = srate * os_f;
  f = s_hpf < 1.5 ? 80 : 140;
  sppL.lc.svf_set(f, 0.707);  sppR.lc.svf_set(f, 0.707);
  sppL.ironlp.op_set(SP_IRON);  sppR.ironlp.op_set(SP_IRON);
  sppL.dc.op_set(8);  sppR.dc.op_set(8);
  f = m_hpf < 1.5 ? 40 : m_hpf < 2.5 ? 80 : 120;
  mipL.lc.svf_set(f, 0.707);  mipR.lc.svf_set(f, 0.707);
  mipL.ironlp.op_set(MI_IRON);  mipR.ironlp.op_set(MI_IRON);
  mipL.dc.op_set(8);  mipR.dc.op_set(8);
  el_xcp = 1 - exp(-2 * $pi * 120 / hv_fs);
  el_drp = 1 - 2 * $pi * 5 / hv_fs;
  hv_fs = srate;

  sp_eh = s_hg != 5;  sp_em = s_mg != 5;  sp_el = s_lg != 5;
  speL.hb.bell_set(hf_tab[s_hf], q_tab[s_hq], eqg_tab[s_hg]);  speR.hb.bell_set(hf_tab[s_hf], q_tab[s_hq], eqg_tab[s_hg]);
  speL.mb.bell_set(mf_tab[s_mf], q_tab[s_mq], eqg_tab[s_mg]);  speR.mb.bell_set(mf_tab[s_mf], q_tab[s_mq], eqg_tab[s_mg]);
  speL.lb.bell_set(lf_tab[s_lf], q_tab[s_lq], eqg_tab[s_lg]);  speR.lb.bell_set(lf_tab[s_lf], q_tab[s_lq], eqg_tab[s_lg]);

  mi_lg1 = db2g(m_ls) - 1;  mi_hg1 = db2g(m_hs) - 1;  mi_pg1 = db2g(m_pg) - 1;
  mieL.lo.op_set(MI_LS);  mieR.lo.op_set(MI_LS);
  mieL.hi.op_set(MI_HS);  mieR.hi.op_set(MI_HS);
  f = mpf_tab[max(0, min(5, floor(m_pf + 0.5)))];
  mieL.mid.svf_set(f, MI_PQ);  mieR.mid.svf_set(f, MI_PQ);

  sp_slope = 1 - 1 / srt_tab[s_ratio];
  sp_ac = 1 - exp(-1000 / (sat_tab[s_atk] * srate));
  sp_rc = 1 - exp(-1000 / (srl_tab[min(6, s_rel)] * srate));
  sp_rauto = s_rel >= 6.5;
  sp_rcf = 1 - exp(-1000 / (150 * srate));
  sp_rcs = 1 - exp(-1000 / (2500 * srate));
  sp_lon = s_lthr < 1;
  sp_lac = 1 - exp(-1000 / (0.25 * srate));
  sp_lrc = 1 - exp(-1000 / (min(500, sp_rauto ? 100 : srl_tab[s_rel]) * srate));
  sp_eon = s_ethr > -70;
  sp_eac = 1 - exp(-1000 / (1 * srate));
  sp_erc = 1 - exp(-1000 / (ser_tab[s_erel] * srate));
  bcL.svf_set(150, 0.707);  bcR.svf_set(150, 0.707);
  dsL.svf_set(6500, 1.2);   dsR.svf_set(6500, 1.2);

  i = floor(m_deg + 0.5) - 3;
  i < 0 ? ( mi_slope = 0.95; mi_knee = i == -1 ? 9 : i == -2 ? 6 : 3; f = 1; ) :
  i > 0 ? ( mi_slope = 1 - 1 / mrt_tab[min(6, i)]; mi_knee = 6; f = 8; ) :
          ( mi_slope = 0; mi_knee = 6; f = 8; );
  mi_ac = 1 - exp(-1000 / (f * srate));
  mi_rc = 1 - exp(-1000 / (mrc_tab[min(3, m_rec)] * srate));
  mi_rcf = 1 - exp(-1000 / (250 * srate));
  mi_rcs = 1 - exp(-1000 / (2500 * srate));
  mi_scon = m_sc >= 0.5;
  f = m_sc < 1.5 ? 60 : m_sc < 2.5 ? 120 : 200;
  scL.svf_set(f, 0.707);  scR.svf_set(f, 0.707);
  mi_lon = m_ceil <= 0;
  mi_lcg = db2g(min(m_ceil, 0));
  mi_lrc = 1 - exp(-1000 / (mlr_tab[max(0, min(5, m_lrel))] * srate));

  out_t = db2g(out_db);
  out_sm = 1 - exp(-1 / (0.02 * srate));
  drift_macro(drift);
  drift_amt = drift / 100;
  sag_a = 1 - exp(-1000 / (30 * srate));
  sag_r = 1 - exp(-1000 / (400 * srate));
  ramp_step = 1 / (0.010 * srate);
  fade_step = 1 / (0.004 * srate);

  first_run ? (
    i = 0;  loop(3, mod_on[i] = mod_tgt[i];  i += 1; );
    ord_act = ord_new;  mdl_act = mdl_new;  out_s = out_t;  pol_s = t_pol;
    mdl_p = mdl_act % 3;  mdl_e = floor(mdl_act / 3) % 3;  mdl_d = floor(mdl_act / 9);
    el_iron = el_iron0 = mdl_p == 0 || mdl_e == 0 || mdl_d == 0;
    el_spg = t_pg;  el_slo = t_lo;  el_slof = t_lof;  el_spr = t_pr;  el_sprf = t_prf;  el_shi = t_hi;  el_shif = t_hif;
    el_sthr = t_thr;  el_smk = t_mk;  el_scut = t_cutf;
    el_pg = db2g(el_spg);  el_mkg = db2g(el_smk);  el_pgi = el_mki = 0;
    eq_tick = 1;  bq_jump = 1;
    first_run = 0;
  );
);

el_dr = 1 - 2 * $pi * 5 / srate;
el_xc = 1 - exp(-2 * $pi * 120 / srate);
sp_rmc = 1 - exp(-1 / (0.010 * srate));
hv_fs = srate; bq_jump = 1; XHL.bq_set(2, 14000, -1.5, 0.5); XHR.bq_set(2, 14000, -1.5, 0.5); MHL.bq_set(2, 12000, -1.2, 0.5); MHR.bq_set(2, 12000, -1.2, 0.5);
el_rmsc = 1 - exp(-1 / (0.003 * srate));
el_smc = 1 - exp(-CR / (0.03 * srate));
sw_c = 1 - exp(-1 / (0.012 * srate));
el_cg = 1; el_gr = 0; el_gravg = 0; el_det = 0; mi_lg = 1;
first_run = 1;
fade_g = 1;
hv_fi = 1; hv_fis = 1 / (0.01 * srate);
cr_n = 0;
update_params();
ost_setup(out_sat / 100, 0.3, 120, 6000, -0.3, 1);
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;

function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 0); pv(2, 0); pv(3, 1); pv(4, 2); pv(5, 1); pv(6, 1); pv(7, 0); pv(8, 0); pv(9, 0); pv(10, 50);
  pv(11, 0); pv(12, 0); pv(13, 0); pv(14, 0); pv(15, 0); pv(16, 0); pv(17, 0); pv(18, 0);
  pv(19, 0); pv(20, 2); pv(21, 0); pv(22, 1); pv(23, 0); pv(24, 1);
  pv(25, 5); pv(26, 5); pv(27, 1); pv(28, 5); pv(29, 5); pv(30, 1); pv(31, 5); pv(32, 3); pv(33, 1);
  pv(34, 0); pv(35, 0); pv(36, 1); pv(37, 0);
  pv(38, 6); pv(39, 0); pv(40, 1); pv(41, 2); pv(42, 0);
  pv(43, -12); pv(44, 2); pv(45, 1); pv(46, 3); pv(47, 1); pv(48, 0); pv(49, -70); pv(50, 1); pv(51, 1); pv(52, 0); pv(53, 0);
  pv(54, -10); pv(55, 3); pv(56, 1); pv(57, 1); pv(58, 0); pv(59, 0.5); pv(60, 2);
);
function load_preset(p) (
  p_init();
  p == 2 ? (
    pv(2, 0); pv(3, 1); pv(4, 2); pv(7, 1);
    pv(12, 3); pv(13, 1);
    pv(25, 7); pv(26, 8); pv(27, 2); pv(28, 4); pv(29, 3); pv(30, 1); pv(32, 3);
    pv(54, -15); pv(55, 6); pv(56, 1); pv(57, 2); pv(58, 3); pv(59, -1); pv(60, 3);
  );
  p == 3 ? (
    pv(2, 2); pv(3, 0); pv(4, 1); pv(7, 1);
    pv(16, 3); pv(17, 6); pv(18, 4);
    pv(19, -4); pv(20, 3); pv(21, 8); pv(22, 3); pv(23, 2); pv(24, 1);
    pv(43, -24); pv(44, 4); pv(45, 1); pv(46, 1); pv(47, -4); pv(48, 6); pv(49, -50); pv(52, 1); pv(53, 1);
  );
  p == 4 ? (
