    pv(14, 6); pv(15, 1);
    pv(34, 3); pv(35, -3); pv(36, 3); pv(37, 4);
    pv(38, 2); pv(40, 1); pv(41, 1); pv(42, 3);
  );
  p == 5 ? (
    pv(2, 1); pv(3, 0); pv(4, 1); pv(7, 1);
    pv(14, 12);
    pv(19, 2); pv(20, 2); pv(21, 4); pv(22, 2); pv(23, 4); pv(24, 2);
    pv(43, -30); pv(44, 4); pv(45, 1); pv(46, 1); pv(47, -2); pv(48, 8);
  );
  p == 6 ? (
    pv(2, 2); pv(3, 1); pv(4, 0); pv(7, 1);
    pv(16, 1); pv(17, 3); pv(18, 4);
    pv(25, 7); pv(26, 4); pv(27, 0); pv(28, 2); pv(29, 2); pv(30, 0); pv(31, 7); pv(32, 2);
    pv(38, -6); pv(40, 0); pv(41, 0); pv(42, 8);
  );
  p == 7 ? (
    pv(2, 0); pv(3, 2); pv(4, 1); pv(7, 1);
    pv(12, 6);
    pv(34, 0); pv(35, 6); pv(36, 0); pv(37, 2);
    pv(43, -16); pv(44, 3); pv(45, 2); pv(46, 1); pv(48, 3); pv(49, -45); pv(50, 0);
  );
  p == 8 ? (
    pv(2, 1); pv(3, 0); pv(4, 2); pv(7, 1);
    pv(14, 6); pv(15, 1);
    pv(19, -2); pv(20, 4); pv(21, 4); pv(22, 3); pv(23, 4); pv(24, 3);
    pv(54, -12.5); pv(55, 5); pv(56, 0); pv(57, 2); pv(58, 2);
  );
  p == 9 ? (
    pv(2, 2); pv(3, 1); pv(4, 0); pv(7, 1);
    pv(16, 2); pv(17, 3); pv(18, 2);
    pv(25, 7); pv(26, 9); pv(27, 2); pv(28, 4); pv(29, 1); pv(31, 4); pv(32, 4);
    pv(38, 6); pv(40, 2); pv(41, 2); pv(42, 2);
  );
  p == 10 ? (
    pv(2, 0); pv(3, 2); pv(4, 1); pv(7, 1);
    pv(12, 3); pv(13, 1);
    pv(34, 6); pv(35, 0); pv(36, 1); pv(37, -2);
    pv(43, -14); pv(44, 1); pv(46, 7); pv(48, 2);
  );
  p == 11 ? (
    pv(1, 0); pv(2, 1); pv(3, 2); pv(4, 0); pv(7, 1);
    pv(34, 3); pv(35, 0); pv(36, 5); pv(37, 0);
    pv(38, 2); pv(40, 2); pv(41, 5); pv(42, 3);
  );
  p == 12 ? (
    pv(2, 0); pv(3, 0); pv(4, 2); pv(7, 1);
    pv(12, 18);
    pv(19, 2); pv(20, 2); pv(23, 2); pv(24, 2);
    pv(55, 3); pv(59, -1); pv(60, 1);
  );
  out_db = p == 2 ? -2.5 : p == 3 ? 4 : p == 4 ? -7 : p == 5 ? 0.5 : p == 6 ? -5 : p == 7 ? -6.5 : p == 8 ? -6.5 : p == 9 ? -3.5 : p == 10 ? -4 : p == 11 ? -3.5 : p == 12 ? -11.5 : 0;
  slider_automate(4503599627370495); slider_automate(s_dess); slider_automate(s_bcut); slider_automate(m_thr); slider_automate(m_deg);
  slider_automate(m_rec); slider_automate(m_sc); slider_automate(m_mk); slider_automate(m_ceil); slider_automate(m_lrel);
  gui_dirty = 1;
);

function prs_sl() (
update_params();
ost_setup(out_sat / 100, 0.3, 120, 6000, -0.3, 1);
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(62, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl(); prs_h0 = prs_hash();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();
os_tf = os_f2n(os_sel);
os_snap(slider(62));

@block
ext_gr_meter = min(-dyn_pk, 0);
hv_now = time_precise();
hv_tp > 0 && hv_now - hv_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > hv_gpp && play_position - hv_gpp < 4 * hv_gpd + 0.05) ? hv_reset();
hv_tp = hv_now; hv_gpp = play_position; hv_gpd = samplesblock / srate;
prs_chk();
gui_dirty ? ( gui_dirty = 0; prm_dirty = 1; );
prm_dirty ? ( prm_dirty = 0;  update_params();  ost_setup(out_sat / 100, 0.3, 120, 6000, -0.3, 1); os_keep(); );
ord_dirty = ord_new != ord_act || mdl_new != mdl_act;
pwr_block(byp_on < 0.5);
bdt = samplesblock / srate;
warm_t += bdt;
dw_t += bdt;
dw_t > 0.7 ? ( dw_t = 0;  dw_target = rand(2) - 1; );
dw += (dw_target - dw) * (1 - exp(-samplesblock / (srate * 1.5)));
sp_thd = s_thr + drift_amt * 0.6 * dw;
mi_thd = m_thr + drift_amt * 0.6 * dw;
volt_g = 1 + drift_amt * 0.012 * dw;
wu = exp(-warm_t / 22) * min(dm_a, 1);
hsp = 0.035 * dm_s * bdt;
el_bl = EL_PB + 0.06 * dm_a * HTL.drift_tick(hsp) + 0.10 * wu;
el_br = EL_PB + 0.06 * dm_a * HTR.drift_tick(hsp) + 0.10 * wu;
el_hgl = db2g(0.18 * dm_a * HGL.drift_tick(hsp) - 1.2 * wu);
el_hgr = db2g(0.18 * dm_a * HGR.drift_tick(hsp) - 1.2 * wu);
el_sll = dts(el_bl);  el_slr = dts(el_br);
el_mains = db2g(0.06 * dm_a * MNS.drift_tick(0.12 * dm_s * bdt));
csp = 0.02 * dm_s * bdt;
el_agea = 1 + 0.18 * dm_a * CPA.drift_tick(csp);
el_ager = 1 + 0.18 * dm_a * CPR.drift_tick(csp);
el_aget = 0.6 * dm_a * CPT.drift_tick(csp);
el_muk = EL_MK0 + (EL_MK1 - EL_MK0) * min(1, el_smk / 20);
el_musl = dts(EL_MB);  el_esl = dts(EL_EB);
inL_d  = max(inL_d,  inpkL);   inpkL = 0;   inR_d  = max(inR_d,  inpkR);   inpkR = 0;
outL_d = max(outL_d, outpkL);  outpkL = 0;  outR_d = max(outR_d, outpkR);  outpkR = 0;
gr_d   = max(gr_d, dyn_pk);    dyn_pk = 0;
pk_d   = max(pk_d, pre_hot);   pre_hot = 0;
os_tf = os_f2n(os_sel);
os_snapb(slider(62));

@sample
by_in();
pwr_in(spl0, spl1); aL = pwr_l;  aR = pwr_r;
inpkL = max(inpkL, abs(aL));  inpkR = max(inpkR, abs(aR));

lvl = max(abs(aL), abs(aR));
sag_env += (lvl - sag_env) * (lvl > sag_env ? sag_a : sag_r);
sg = min(sag_env, 1);
sup_g = volt_g * (1 - drift_amt * 0.04 * sg);

i = 0;
loop(3,
  t = mod_tgt[i];  v = mod_on[i];
  v != t ? ( mod_on[i] = t > v ? min(t, v + ramp_step) : max(t, v - ramp_step); );
  i += 1;
);
pol_s += (t_pol - pol_s) * sw_c;

ord_dirty ? (
  fade_g = max(0, fade_g - fade_step);
  fade_g == 0 ? (
    mdl_new % 3 != mdl_p ? clr_pre(mdl_new % 3);
    floor(mdl_new / 3) % 3 != mdl_e ? clr_eq(floor(mdl_new / 3) % 3);
    floor(mdl_new / 9) != mdl_d ? clr_dyn(floor(mdl_new / 9));
    ord_act = ord_new;  mdl_act = mdl_new;  ord_dirty = 0;
    mdl_p = mdl_act % 3;  mdl_e = floor(mdl_act / 3) % 3;  mdl_d = floor(mdl_act / 9);
    el_iron = mdl_p == 0 || mdl_e == 0 || mdl_d == 0;
    el_iron != el_iron0 ? ( XIL.zc(); XIR.zc(); XQL.zc(); XQR.zc(); XHL.zc(); XHR.zc(); el_iron0 = el_iron; );
  );
) : fade_g < 1 ? ( fade_g = min(1, fade_g + fade_step); );

os_gate();
os_chg ? ( osuL.os_clr(); osuR.os_clr(); osdL.os_clr(); osdR.os_clr(); update_params(); clr_pre(mdl_p); bq_jump = 1; eq_tick = 1; pdc_delay = os_lat(os_f); );

el_iron ? (
  cr_n <= 0 ? (
    cr_n = CR;
    el_spg += (t_pg - el_spg) * el_smc;  el_sthr += (t_thr - el_sthr) * el_smc;  el_smk += (t_mk - el_smk) * el_smc;
    abs(t_cutf - el_scut) > 0.0001 || eq_tick ? (
      el_scut += (t_cutf - el_scut) * el_smc;  abs(t_cutf - el_scut) <= 0.0001 ? el_scut = t_cutf;
      hv_fs = srate * os_f;
      elpL.hp.bq_set(3, exp(el_scut), 0, 0.707);  elpR.hp.bq_set(3, exp(el_scut), 0, 0.707);
      hv_fs = srate;
    );
    e_mv = abs(t_lo - el_slo) + abs(t_lof - el_slof) + abs(t_pr - el_spr) + abs(t_prf - el_sprf) + abs(t_hi - el_shi) + abs(t_hif - el_shif);
    e_mv > 0.0001 || eq_tick || abs(el_smk - el_mklast) > 0.001 ? (
      el_slo += (t_lo - el_slo) * el_smc;  el_slof += (t_lof - el_slof) * el_smc;  el_spr += (t_pr - el_spr) * el_smc;
      el_sprf += (t_prf - el_sprf) * el_smc;  el_shi += (t_hi - el_shi) * el_smc;  el_shif += (t_hif - el_shif) * el_smc;
      LSL.bq_set(1, exp(el_slof), el_slo, 0.5);  LSR.bq_set(1, exp(el_slof), el_slo, 0.5);
      PRL.bq_set(0, exp(el_sprf), el_spr, 0.7);  PRR.bq_set(0, exp(el_sprf), el_spr, 0.7);
      HSL.bq_set(2, exp(el_shif), el_shi, 0.5);  HSR.bq_set(2, exp(el_shif), el_shi, 0.5);
      el_dipv = EL_DIP * (min(1, el_smk / 20)) ^ 1.5;
      DPL.bq_set(0, 2000, el_dipv, 0.45);  DPR.bq_set(0, 2000, el_dipv, 0.45);
      el_mklast = el_smk;  eq_tick = 0;
    );
    bq_jump = 0;
    el_pgi = (db2g(el_spg) - el_pg) / CR;  el_mki = (db2g(el_smk) - el_mkg) / CR;
    mdl_d == 0 ? (
      el_lv = 10 * log10(el_det + 0.0000000001) + 18;
      el_ov = el_lv - (el_sthr + el_aget);
      el_lim ? ( el_kw = 2;  el_rr = 10; ) : ( el_kw = 6;  el_rr = min(3.5, 1.5 + 0.25 * max(el_ov, 0)); );
      el_tgr = el_ov <= -el_kw * 0.5 ? 0 : el_ov < el_kw * 0.5 ? (1 - el_rr) * sqr(el_ov + el_kw * 0.5) / (2 * el_kw) : (1 - el_rr) * el_ov;
      el_ac = 1 - exp(-CR / (el_atk * 0.001 * el_agea * srate));
      el_rauto ? (
        el_gravg += (el_gr - el_gravg) * (1 - exp(-CR / (3 * srate)));
        el_rt = 0.3 + 3 * min(1, -el_gravg / 10);
      ) : el_rt = el_rels;
      el_rcc = 1 - exp(-CR / (el_rt * el_ager * srate));
      el_gr += (el_tgr - el_gr) * (el_tgr < el_gr ? el_ac : el_rcc);
      el_cgi = (db2g(el_gr) - el_cg) / CR;
    );
  );
  cr_n -= 1;
  el_cg += el_cgi;  el_pg += el_pgi;  el_mkg += el_mki;
);

mdl_p == 1 ? (
  sp_kd = SP_K * (1 + drift_amt * (0.12 * dw + 0.6 * sg));
  sp_nd = sqr(1 + SP_B) / sp_kd;
  sp_g = db2g(s_gain) * pol_s;
) : mdl_p == 2 ? (
  mi_kd = MI_K * (1 + drift_amt * (0.12 * dw + 0.6 * sg));
  mi_nd = (1 + MI_B * MI_B) ^ 1.5 / mi_kd;
  mi_g = db2g(m_gain) * pol_s;
);

hv_w = mod_on[0];
osuL.os_up(aL); osuR.os_up(aR);
hv_p = 0; loop(os_f,
  hv_xl = osuL.os_s(hv_p); hv_xr = osuR.os_s(hv_p);
  el_iron ? ( hv_xl = XIL.xfmr(hv_xl, EL_XI, el_xcp); hv_xr = XIR.xfmr(hv_xr, EL_XI, el_xcp); );
  hv_w > 0 ? (
    mdl_p == 0 ? ( hv_yl = elpL.el_pre(hv_xl, el_hgl, el_bl, el_sll); hv_yr = elpR.el_pre(hv_xr, el_hgr, el_br, el_slr); ) :
    mdl_p == 1 ? ( hv_yl = sppL.sp_pre(hv_xl); hv_yr = sppR.sp_pre(hv_xr); ) :
                 ( hv_yl = mipL.mi_pre(hv_xl); hv_yr = mipR.mi_pre(hv_xr); );
    hv_w < 1 ? ( hv_yl = hv_xl + (hv_yl - hv_xl) * hv_w; hv_yr = hv_xr + (hv_yr - hv_xr) * hv_w; );
  ) : ( hv_yl = hv_xl; hv_yr = hv_xr; );
  HV_OS[hv_p] = hv_yl; HV_OS[4 + hv_p] = hv_yr;
  hv_p += 1; );
aL = osdL.os_dn(HV_OS[0], HV_OS[1], HV_OS[2], HV_OS[3]) * os_g; aR = osdR.os_dn(HV_OS[4], HV_OS[5], HV_OS[6], HV_OS[7]) * os_g;
mdl_p == 2 && hv_w > 0 ? ( hv_ml = MHL.bq(aL); hv_mr = MHR.bq(aR); aL += (hv_ml - aL) * hv_w; aR += (hv_mr - aR) * hv_w; );
pre_hot = max(pre_hot, mdl_p == 1 ? sp_pk : max(abs(aL), abs(aR))); sp_pk = 0;

ord_act ? ( run_module(2); run_module(1); ) : ( run_module(1); run_module(2); );

el_iron ? ( aL = XHL.bq(XQL.xfmr(aL, EL_XO, el_xc)); aR = XHR.bq(XQR.xfmr(aR, EL_XO, el_xc)); );
out_s += (out_t * (el_iron ? el_mains : 1) - out_s) * out_sm;
pwr_out(aL, aR); aL = pwr_l; aR = pwr_r;
aL = ostL.ost_band(aL) * out_s * fade_g * sup_g;
aR = ostR.ost_band(aR) * out_s * fade_g * sup_g;
ost_out(aL, aR);  aL = ost_l;  aR = ost_r;
outpkL = max(outpkL, abs(aL));  outpkR = max(outpkR, abs(aR));
spl0 = aL;  spl1 = aR;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
hv_fi < 1 ? (
  hv_fi = min(hv_fi + hv_fis, 1); hv_z = hv_fi * hv_fi * (3 - 2 * hv_fi);
  by_d > 0 ? ( hv_a = (by_w - by_d) & (BY_N - 1); hv_dl = BY_BUF[hv_a]; hv_dr = BY_BUF[BY_N + hv_a]; ) : ( hv_dl = by_il; hv_dr = by_ir; );
  spl0 = hv_dl + (spl0 - hv_dl) * hv_z; spl1 = hv_dr + (spl1 - hv_dr) * hv_z;
);
by_out();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@gfx 900 400
ui_begin(900, 400);
v5_begin();
v5p_use(14);
HVF = v5p_bg; HVW = v5p_well; HVH = 0x1C1A19; HVA = 0xF0A63A;
sc != hv_fsc ? (
  hv_fsc = sc;
  hv_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  hv_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  hv_f6 = ui_fitfont(6, 24 * sc);
);
function hv_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * hv_kt * sc, 'b'); );
function hv_fa(px) ( gfx_setfont(10, "Arial", px * hv_ka * sc, 'b'); );
function hv_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function hv_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function hv_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function hv_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function hv_twell(x, y, w, h, b, c, face) (
  ui_col(ui_mix(c, 0, 0.42)); v5_q(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0, 0.28)); v5_q(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0xFFFFFF, 0.10)); v5_q(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.22)); v5_q(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(face); v5_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(face, 0, 0.35)); v5_r(x + b, y + b, w - 2 * b, 2); v5_r(x + b, y + b, 2, h - 2 * b);
);
function hv_ends(cx, cy, rd, sz) local(t) (
  ui_col(hv_dot); t = -0.75 * $pi; v5_sd(cx + sin(t) * rd, cy - cos(t) * rd, sz); v5_sd(cx - sin(t) * rd, cy - cos(t) * rd, sz);
);
function hv_cap(cx, cy, r, v) local(a, i, t) (
  a = -0.75 * $pi + v * 1.5 * $pi;
  v5_shc(cx, cy, r);
  ui_col(0x1B1D1E); v5_d(cx, cy, r);
  i = 0; loop(30, t = i / 30 * 2 * $pi; ui_col(0x34383A); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(ui_mix(hv_capc, 0, 0.25)); v5_d(cx, cy, r * 0.74);
  ui_col(hv_capc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, hv_ptr);
);
function hv_lum(c) ( (0.2126 * ((c >> 16) & 255) + 0.7152 * ((c >> 8) & 255) + 0.0722 * (c & 255)) / 255; );
function hv_pick(s, k) ( v5_part(s, k); strcpy(#hv_vs, #v5_pt); );
function hv_val(idx, v) local(k) (
  k = floor(v + 0.5);
  idx == 13 ? hv_pick("OFF|60 Hz|120 Hz", k) :
  idx == 15 ? hv_pick("OFF|80 Hz|140 Hz", k) :
  idx == 16 ? hv_pick("OFF|40 Hz|80 Hz|120 Hz", k) :
  idx == 20 ? hv_pick("40 Hz|60 Hz|100 Hz|150 Hz|220 Hz", k) :
  idx == 22 ? hv_pick("1.4 kHz|2 kHz|2.8 kHz|4 kHz|5.6 kHz", k) :
  idx == 24 ? hv_pick("5 kHz|7 kHz|10 kHz|14 kHz", k) :
  idx == 25 || idx == 28 || idx == 31 ? hv_pick("-15 dB|-10 dB|-6 dB|-4 dB|-2 dB|0 dB|+2 dB|+4 dB|+6 dB|+10 dB|+15 dB", k) :
  idx == 26 ? hv_pick("1.5 kHz|1.9 kHz|2.4 kHz|3 kHz|3.8 kHz|4.7 kHz|6 kHz|7.5 kHz|9.5 kHz|11.5 kHz|15 kHz", k) :
  idx == 29 ? hv_pick("300 Hz|378 Hz|475 Hz|600 Hz|754 Hz|950 Hz|1.2 kHz|1.5 kHz|1.9 kHz|2.4 kHz|3 kHz", k) :
  idx == 32 ? hv_pick("45 Hz|57 Hz|71 Hz|90 Hz|113 Hz|142 Hz|180 Hz|226 Hz|285 Hz|357 Hz|450 Hz", k) :
  idx == 27 || idx == 30 || idx == 33 ? hv_pick("NARROW|MEDIUM|BROAD", k) :
  idx == 36 ? hv_pick("700 Hz|1 kHz|1.5 kHz|2.3 kHz|3.5 kHz|5.6 kHz", k) :
  idx == 40 ? hv_pick("FAST|MEDIUM|SLOW", k) :
  idx == 41 ? hv_pick("0.3 s|0.6 s|1.2 s|2.5 s|5 s|AUTO", k) :
  idx == 44 ? hv_pick("1 : 1|1.5 : 1|2 : 1|3 : 1|5 : 1", k) :
  idx == 45 ? hv_pick("0.25 ms|2.5 ms|25 ms", k) :
  idx == 46 ? hv_pick("0.1 s|0.2 s|0.5 s|1 s|2 s|5 s|10 s|AUTO", k) :
  idx == 47 ? ( v >= 0.5 ? strcpy(#hv_vs, "OFF") : sprintf(#hv_vs, "%.0f dB", v) ) :
  idx == 49 ? ( v <= -69.5 ? strcpy(#hv_vs, "OFF") : sprintf(#hv_vs, "%.0f dB", v) ) :
  idx == 50 ? hv_pick("0.05 s|0.2 s|0.5 s|2 s", k) :
  idx == 55 ? hv_pick("LIMIT 3|LIMIT 2|LIMIT 1|OFF|1.5 : 1|2 : 1|3 : 1|4 : 1|6 : 1|10 : 1", k) :
  idx == 56 ? hv_pick("0.3 s|0.8 s|2 s|5 s|PROG", k) :
  idx == 57 ? hv_pick("OFF|60 Hz|120 Hz|200 Hz", k) :
  idx == 59 ? ( v > 0 ? strcpy(#hv_vs, "OFF") : sprintf(#hv_vs, "%.1f dB", v) ) :
  idx == 60 ? hv_pick("10 ms|25 ms|50 ms|100 ms|200 ms|500 ms", k) :
  idx == 38 ? sprintf(#hv_vs, "%+.1f dBu", v) :
  idx == 10 || idx == 9 ? sprintf(#hv_vs, "%.0f %%", v) :
  idx == 42 || idx == 48 || idx == 58 || idx == 18 || idx == 21 ? sprintf(#hv_vs, "+%.1f dB", v) :
  idx == 43 || idx == 54 ? sprintf(#hv_vs, "%.1f dB", v) :
  sprintf(#hv_vs, "%+.1f dB", v);
  #hv_vs;
);
function hv_dial(cx, cy, r, idx, lo, hi, def, col, lbl) local(n, ext, fs, ly) (
  hv_capc = col;
  ext = 9;
  n = v5_ctl(idx, lo, hi, def, 0, v5_hitc(cx, cy, r + ext), 0, 200);
  hv_ptr = hv_lum(col) < 0.5 ? 0xF0EAD8 : 0x1A1A1A;
  hv_cap(cx, cy, r, n); hv_ends(cx, cy, r + ext + 2, 1.8);
  fs = r >= 26 ? 16 : hv_lfs; ly = cy + r + ext + 6 + fs * 0.55;
  v5_act ? ( ui_cola(0xFFFFFF, 0.10); v5_arc(cx, cy, r + 1.5, -$pi, $pi, 1);
    hv_hon = 1; hv_hx = cx; hv_hy = ly; hv_hfs = max(fs, 13); strcpy(#hv_hv, hv_val(idx, slider(idx))); )
  : ( hv_ft(fs); ui_col(hv_ink); v5_t(cx, ly, lbl); );
);
function hv_sd(cx, cy, r, idx, n, def, col, lbl) ( v5_step = 1; hv_dial(cx, cy, r, idx, 0, n - 1, def, col, lbl); );
function hv_rk(x, y, w, h, on, lg) local(gx, hv) (
  hv = v5_hit(x, y, w, h);
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(hv ? 0x1C1E1D : 0x141615); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.45); v5_r(x + 1, y + 1, w - 2, 2); v5_r(x + 1, y + 1, 2, h - 2);
  ui_cola(0xFFFFFF, 0.06); v5_r(x + 2, y + h - 1, w - 3, 1);
  gx = x + 7;
  ui_col(0x050606); v5_rr(gx, y + 5, 7, h - 10, 3.5);
  on ? ( ui_cola(hv_led, 0.25); v5_rr(gx - 3, y + 3, 13, h - 6, 5); ui_col(hv_led); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); )
     : ( ui_col(ui_mix(hv_led, 0x0A0B0B, 0.75)); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); );
  hv_ft(13); ui_col(on ? 0xF6F8F4 : 0xB8B4A8); v5_t((gx + 11 + x + w - 4) * 0.5, y + h * 0.5 + 0.5, lg);
);
function hv_key(x, y, w, h, idx, lg) local(on) ( on = v5_toggle(idx, v5_hit(x, y, w, h)); hv_rk(x, y, w, h, on, lg); );
function hv_segs(x, y, h, lv, pk) local(n, sh, i, sy, c, on, pi, t) (
