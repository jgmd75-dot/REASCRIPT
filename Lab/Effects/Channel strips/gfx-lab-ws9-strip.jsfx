desc:WS9 Strip [channel strip] (GFX Lab)
//tags: channel strip location mixer transformer iron saturation sidebar peak harmonics multiband stagger eq compressor clipper broadcast
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-sidebar

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-20,20,0.1>-Trim (dB)
slider3:0<0,2,1{Full,Split,Stagger}>-Sidebar
slider4:0<0,4,1{Off,33 Hz,66 Hz,110 Hz,220 Hz}>-HPF
slider5:0<-12,12,0.1>-LF (dB)
slider6:1<0,2,1{55 Hz,110 Hz,220 Hz}>-LF frequency
slider7:0<-12,12,0.1>-LMF (dB)
slider8:2<0,5,1{220 Hz,330 Hz,440 Hz,660 Hz,880 Hz,1.1 kHz}>-LMF frequency
slider9:0<-12,12,0.1>-HMF (dB)
slider10:2<0,5,1{1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz}>-HMF frequency
slider11:0<-12,12,0.1>-HF (dB)
slider12:2<0,3,1{4.4 kHz,6.6 kHz,8.8 kHz,11 kHz}>-HF frequency
slider13:1<0,1,1{Off,On}>-EQ in
slider14:-12<-30,0,0.1>-Threshold (dBFS)
slider15:1<0,5,1{1.5:1,2:1,3:1,4:1,8:1,Limit}>-Ratio
slider16:3<0.1,30,0.01>-Attack (ms)
slider17:300<50,2000,1>-Release (ms)
slider18:50<0,100,1>-Grab (%)
slider19:0<0,5,1{Off,33 Hz,66 Hz,110 Hz,220 Hz,330 Hz}>-SC HPF
slider20:100<0,100,1>-Mix (%)
slider21:1<0,1,1{Off,On}>-Link
slider22:1<0,1,1{Off,On}>-Comp in
slider23:0<0,1,1{EQ first,Comp first}>-Order
slider24:0<-24,12,0.1>-Level (dB)
slider25:15<12,15,0.01>-Battery (V)
slider26:1<0,2,1{1x,2x,4x}>-Oversampling
slider27:4<0,4,1{4.4 kHz,6.6 kHz,8.8 kHz,11 kHz,Off}>-LPF
slider28:prs_sel=0<0,10,1{No preset,Init,Dialogue Boom,Lead Vocal,Drum Room,Snare Crack,Acoustic Guitar,Bass DI,Hot Peaks,Parallel Drums,Clean Desk}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sidebar.jsfx-inc

@init
#ui_man = "gfx-lab-ws9-strip";
ext_noinit = 1;

function lc_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function lc_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function lc_db(d) ( exp(d * 0.11512925464970228); );
function lc_hpf(i) ( i == 1 ? 33 : i == 2 ? 66 : i == 3 ? 110 : 220; );
function lc_lpf(i) ( i == 0 ? 4400 : i == 1 ? 6600 : i == 2 ? 8800 : 11000; );
function lc_lff(i) ( i == 0 ? 55 : i == 1 ? 110 : 220; );
function lc_lmf(i) ( i == 0 ? 220 : i == 1 ? 330 : i == 2 ? 440 : i == 3 ? 660 : i == 4 ? 880 : 1100; );
function lc_hmf(i) ( 1100 * (i + 1); );
function lc_hff(i) ( i == 0 ? 4400 : i == 1 ? 6600 : i == 2 ? 8800 : 11000; );
function lc_ratio(i) ( i == 0 ? 1.5 : i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 8 : 20; );
function lc_knee(i) ( i == 0 ? 10 : i == 1 ? 8 : i == 2 ? 6 : i == 3 ? 4 : i == 4 ? 2 : 1; );
function lc_sch(i) ( i == 1 ? 33 : i == 2 ? 66 : i == 3 ? 110 : i == 4 ? 220 : 330; );

function ir_sat(x) ( x / sqrt(1 + x * x); );
function ir_run(u, g, gl, b, rb, kb, kc) instance(lp) local(lo) (
  lp += (u - lp) * kc;
  lo = (ir_sat(lp * gl + b) - rb) * kb / gl;
  ir_sat((u - lp + lo) * g) / g;
);
function ir_tgt(d, kg, kl, kbias, hb) instance(tg, tgl, tb, trb, tkb) (
  tg = lc_db(kg * d - 9) * hb; tgl = tg * (1 + kl * d); tb = kbias * d;
  trb = ir_sat(tb); tkb = (1 + tb * tb) ^ 1.5;
);
function ir_glide(k) instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) (
  g += (tg - g) * k; gl += (tgl - gl) * k; b += (tb - b) * k; rb += (trb - rb) * k; kb += (tkb - kb) * k;
);
function ir_snap() instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) ( g = tg; gl = tgl; b = tb; rb = trb; kb = tkb; );

function xo_coef(f, fs) instance(c1, c2, c3) local(g) (
  g = tan($pi * min(f, 0.45 * fs) / fs); c1 = 1 / (1 + g * (g + 1.4142135623730951)); c2 = g * c1; c3 = g * c2;
);
function xo_run(x, c1, c2, c3) instance(a1, a2, b1, b2, d1, d2, lo, hi) local(v1, v2, v3, l, h) (
  v3 = x - a2; v1 = c1 * a1 + c2 * v3; v2 = a2 + c2 * a1 + c3 * v3; a1 = 2 * v1 - a1; a2 = 2 * v2 - a2;
  l = v2; h = x - 1.4142135623730951 * v1 - v2;
  v3 = l - b2; v1 = c1 * b1 + c2 * v3; v2 = b2 + c2 * b1 + c3 * v3; b1 = 2 * v1 - b1; b2 = 2 * v2 - b2;
  lo = v2;
  v3 = h - d2; v1 = c1 * d1 + c2 * v3; v2 = d2 + c2 * d1 + c3 * v3; d1 = 2 * v1 - d1; d2 = 2 * v2 - d2;
  hi = h - 1.4142135623730951 * v1 - v2;
);
function xo_clr() instance(a1, a2, b1, b2, d1, d2, lo, hi) ( a1 = a2 = b1 = b2 = d1 = d2 = lo = hi = 0; );
function bd_run(x) local(s) (
  this.m.xo_run(x, xoM.c1, xoM.c2, xoM.c3);
  this.l.xo_run(this.m.lo, xoL.c1, xoL.c2, xoL.c3);
  this.h.xo_run(this.m.hi, xoH.c1, xoH.c2, xoH.c3);
  s = this.s0.sb_run(this.l.lo) + this.s1.sb_run(this.l.hi) + this.s2.sb_run(this.h.lo) + this.s3.sb_run(this.h.hi);
  s;
);
function bd_clr() ( this.m.xo_clr(); this.l.xo_clr(); this.h.xo_clr(); this.s0.sb_clr(); this.s1.sb_clr(); this.s2.sb_clr(); this.s3.sb_clr();
  this.n.xo_clr(); this.p.xo_clr(); this.q.xo_clr(); );
ST_N = 16384; ST_M = ST_N - 1;
function bd_stg(x, buf) local(w, d1, d2, s) (
  w = st_w; d1 = st_d / 3; d2 = 2 * d1;
  this.m.xo_run(x, xoM.c1, xoM.c2, xoM.c3);
  this.l.xo_run(this.m.lo, xoL.c1, xoL.c2, xoL.c3);
  this.h.xo_run(this.m.hi, xoH.c1, xoH.c2, xoH.c3);
  buf[w] = this.l.lo; buf[ST_N + w] = this.l.hi; buf[2 * ST_N + w] = this.h.lo; buf[3 * ST_N + w] = x;
  s = this.s0.sb_run(buf[(w - st_d) & ST_M] + buf[ST_N + ((w - d2) & ST_M)] + buf[2 * ST_N + ((w - d1) & ST_M)] + this.h.hi);
  this.n.xo_run(s, xoM.c1, xoM.c2, xoM.c3);
  this.p.xo_run(this.n.lo, xoL.c1, xoL.c2, xoL.c3);
  this.q.xo_run(this.n.hi, xoH.c1, xoH.c2, xoH.c3);
  buf[4 * ST_N + w] = this.p.hi; buf[5 * ST_N + w] = this.q.lo; buf[6 * ST_N + w] = this.q.hi;
  buf[3 * ST_N + ((w - st_d) & ST_M)] + this.p.lo
    + buf[4 * ST_N + ((w - d1) & ST_M)] + buf[5 * ST_N + ((w - d2) & ST_M)] + buf[6 * ST_N + ((w - st_d) & ST_M)];
);

function bq(x, b0, b1, b2, a1, a2) instance(s1, s2) local(y) ( y = b0 * x + s1; s1 = b1 * x - a1 * y + s2; s2 = b2 * x - a2 * y; y; );
function bq_clr() instance(s1, s2) ( s1 = s2 = 0; );
function bq_hp(f, fs) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * fs) / fs; cw = cos(w); al = sin(w) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_lp(f, fs) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * fs) / fs; cw = cos(w); al = sin(w) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_ls(f, gdb, fs) instance(b0, b1, b2, a1, a2) local(ga, w, cw, sa, n) (
  ga = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.45 * fs) / fs; cw = cos(w); sa = 2 * sqrt(ga) * sin(w) / 2 * sqrt(2);
  n = (ga + 1) + (ga - 1) * cw + sa;
  b0 = ga * ((ga + 1) - (ga - 1) * cw + sa) / n; b1 = 2 * ga * ((ga - 1) - (ga + 1) * cw) / n;
  b2 = ga * ((ga + 1) - (ga - 1) * cw - sa) / n; a1 = -2 * ((ga - 1) + (ga + 1) * cw) / n; a2 = ((ga + 1) + (ga - 1) * cw - sa) / n;
);
function bq_hs(f, gdb, fs) instance(b0, b1, b2, a1, a2) local(ga, w, cw, sa, n) (
  ga = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.45 * fs) / fs; cw = cos(w); sa = 2 * sqrt(ga) * sin(w) / 2 * sqrt(2);
  n = (ga + 1) - (ga - 1) * cw + sa;
  b0 = ga * ((ga + 1) + (ga - 1) * cw + sa) / n; b1 = -2 * ga * ((ga - 1) + (ga + 1) * cw) / n;
  b2 = ga * ((ga + 1) + (ga - 1) * cw - sa) / n; a1 = 2 * ((ga - 1) - (ga + 1) * cw) / n; a2 = ((ga + 1) - (ga - 1) * cw - sa) / n;
);
function bq_pk(f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(ga, w, cw, al, n) (
  ga = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.45 * fs) / fs; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al / ga;
  b0 = (1 + al * ga) / n; b1 = -2 * cw / n; b2 = (1 - al * ga) / n; a1 = b1; a2 = (1 - al / ga) / n;
);
function eq_upd(k) local(fs) (
  fs = srate * os_f;
  eq_lf += (eq_lft - eq_lf) * k; eq_lm += (eq_lmt - eq_lm) * k; eq_hm += (eq_hmt - eq_hm) * k; eq_hf += (eq_hft - eq_hf) * k;
  eq_lz += (eq_lzt - eq_lz) * k; eq_lmz += (eq_lmzt - eq_lmz) * k; eq_hmz += (eq_hmzt - eq_hmz) * k; eq_hz += (eq_hzt - eq_hz) * k;
  eq_hpm < 0.0001 ? eq_pz = eq_pzt : eq_pz += (eq_pzt - eq_pz) * k;
  eq_lpm < 0.0001 ? eq_qz = eq_qzt : eq_qz += (eq_qzt - eq_qz) * k;
  cHP.bq_hp(exp(eq_pz), fs); cLP.bq_lp(exp(eq_qz), fs); cLS.bq_ls(exp(eq_lz), eq_lf, fs); cP1.bq_pk(exp(eq_lmz), eq_lm, 0.9, fs);
  cP2.bq_pk(exp(eq_hmz), eq_hm, 0.9, fs); cHS.bq_hs(exp(eq_hz), eq_hf, fs);
  sb_ctl(k);
);
function eq_run(x) local(d) (
  d = x;
  x = this.l.bq(x, cLS.b0, cLS.b1, cLS.b2, cLS.a1, cLS.a2);
  x = this.m.bq(x, cP1.b0, cP1.b1, cP1.b2, cP1.a1, cP1.a2);
  x = this.n.bq(x, cP2.b0, cP2.b1, cP2.b2, cP2.a1, cP2.a2);
  x = this.s.bq(x, cHS.b0, cHS.b1, cHS.b2, cHS.a1, cHS.a2);
  x * eq_m + d * (1 - eq_m);
);
function eq_clr() ( this.h.bq_clr(); this.l.bq_clr(); this.m.bq_clr(); this.n.bq_clr(); this.s.bq_clr(); );

function hp_set(f) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function hp_run(x) instance(b0, b1, b2, a1, a2, s1, s2) local(y) ( y = b0 * x + s1; s1 = b1 * x - a1 * y + s2; s2 = b2 * x - a2 * y; y; );

function cp_gc(lv) local(ov, k2) (
  ov = lv - cp_th; k2 = cp_kw * 0.5;
  -(ov <= -k2 ? 0 : ov >= k2 ? ov * cp_sl : cp_sl * sqr(ov + k2) / (2 * cp_kw));
);
function cp_env(t) instance(gp, gf, gs) (
  gp += (t < gp ? cp_ka : cp_kr) * (t - gp);
  gf += (t < gf ? cp_kaf : cp_krf) * (t - gf);
  gs += (t < gs ? cp_kas : cp_krs) * (t - gs);
  gp + cp_gb * (min(gf, gs) - gp);
);

function sd_run(x, buf) (
  sb_mode == 0 ? x + this.s0.sb_run(x) : sb_mode == 1 ? x + this.bd_run(x) : this.bd_stg(x, buf);
);
function lc_os(xl, xr, ga, gb) local(a, b) (
  a = iaL.ir_run(xl, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  b = iaR.ir_run(xr, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  a += eq_hpm * (hfL.bq(a, cHP.b0, cHP.b1, cHP.b2, cHP.a1, cHP.a2) - a);
  b += eq_hpm * (hfR.bq(b, cHP.b0, cHP.b1, cHP.b2, cHP.a1, cHP.a2) - b);
  a += eq_lpm * (lfL.bq(a, cLP.b0, cLP.b1, cLP.b2, cLP.a1, cLP.a2) - a);
  b += eq_lpm * (lfR.bq(b, cLP.b0, cLP.b1, cLP.b2, cLP.a1, cLP.a2) - b);
  a = bL.sd_run(a, ST_L); b = bR.sd_run(b, ST_R);
  sb_mode == 2 ? st_w = (st_w + 1) & ST_M;
  od_on ? (
    lc_wl = a; lc_wr = b;
    a = eqL.eq_run(a * ga); b = eqR.eq_run(b * gb);
  ) : (
    a = eqL.eq_run(a); b = eqR.eq_run(b);
    lc_wl = a; lc_wr = b; a *= ga; b *= gb;
  );
  a = obL.ir_run(a * lc_lv, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);
  b = obR.ir_run(b * lc_lv, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);
  lc_pl = a; lc_pr = b;
);
function lc_rcoefs(f) local(w, fs) (
  fs = srate * f; w = 2 * $pi / fs; ir_kci = 1 - exp(-150 * w); ir_kco = 1 - exp(-120 * w);
  xoL.xo_coef(220, fs); xoM.xo_coef(1100, fs); xoH.xo_coef(5500, fs);
  sb_rate(fs);
  eq_upd(1);
  st_d = st_db * f;
);
function lc_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  iaL.lp = iaR.lp = obL.lp = obR.lp = 0;
  bL.bd_clr(); bR.bd_clr();
  memset(ST_L, 0, 7 * ST_N); memset(ST_R, 0, 7 * ST_N); st_w = 0;
  eqL.eq_clr(); eqR.eq_clr(); hfL.bq_clr(); hfR.bq_clr(); lfL.bq_clr(); lfR.bq_clr();
);

function lc_reset() (
  lc_clear(); memset(BY_BUF, 0, 2 * BY_N);
  eL.gp = eL.gf = eL.gs = eR.gp = eR.gf = eR.gs = 0; lc_msl = lc_msr = 0;
  lc_gpl = lc_gnl = lc_gpr = lc_gnr = 1;
  hL.s1 = hL.s2 = hR.s1 = hR.s2 = 0; lc_dxl = lc_dyl = lc_dxr = lc_dyr = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0; sg_e = 0;
  lc_fi = 0;
);

#lc_pm = "Init|Dialogue Boom|Lead Vocal|Drum Room|Snare Crack|Acoustic Guitar|Bass DI|Hot Peaks|Parallel Drums|Clean Desk";
PRS = 500000; PRS_MAP = PRS + 20 * 12;
function ps_a(p, a, b, c, d, e, f, g, h, i, j) local(m) ( m = PRS + p * 20; m[0] = a; m[1] = b; m[2] = c; m[3] = d; m[4] = e; m[5] = f; m[6] = g; m[7] = h; m[8] = i; m[9] = j; );
function ps_b(p, a, b, c, d, e, f, g, h, i, j) local(m) ( m = PRS + p * 20 + 10; m[0] = a; m[1] = b; m[2] = c; m[3] = d; m[4] = e; m[5] = f; m[6] = g; m[7] = h; m[8] = i; m[9] = j; );
ps_a(1,    0,  0,    0,  1,    0,  2,    0,   2,    0,  2); ps_b(1,  -12,  1,   3, 300,  50,  0, 100,  0,   0,  15);
ps_a(2,    4,  3,   -2,  1, -1.5,  2,    2,   3,    1,  2); ps_b(2,  -22,  2,   3, 250,  60,  3, 100,  0,  -2,  15);
ps_a(3,    2,  2,   -1,  1,   -1,  3,  2.5,   2,    2,  3); ps_b(3,  -20,  2,   5, 300,  50,  2, 100,  0,  -1,  15);
ps_a(4,    6,  2,    2,  1,   -2,  2,  1.5,   3,    2,  2); ps_b(4,  -18,  3,  10, 200,  70,  2, 100,  1,  -5,  14);
ps_a(5,    3,  2,    1,  2,   -2,  3,    3,   2,  1.5,  1); ps_b(5,  -16,  2,   1, 150,  60,  3, 100,  1,  -2,  15);
ps_a(6,   -2,  2,   -2,  1, -1.5,  2,    1,   3,  2.5,  2); ps_b(6,  -18,  1,  10, 300,  50,  2, 100,  0,   1,  15);
ps_a(7,    6,  1,    3,  0,   -2,  3,    1,   1,   -1,  1); ps_b(7,  -20,  2,  20, 250,  30,  0, 100,  0,  -4,  14);
ps_a(8,   10,  0,    0,  1,    0,  2,    0,   2,    0,  2); ps_b(8,  -10,  1,   3, 300,  50,  0, 100,  0,  -9,  15);
ps_a(9,    4,  1,    2,  1,   -1,  2,    1,   3,  1.5,  2); ps_b(9,  -26,  4,   1, 120,  90,  2,  45,  1,  -2,  13);
ps_a(10,  -8,  0,    0,  1,    0,  2,    0,   2,    0,  2); ps_b(10,  -6,  0,   3, 300,  50,  0, 100,  0,   8,  15);
PRS_MAP[0] = 2; PRS_MAP[1] = 4; PRS_MAP[2] = 5; PRS_MAP[3] = 6; PRS_MAP[4] = 7; PRS_MAP[5] = 8; PRS_MAP[6] = 9;
PRS_MAP[7] = 10; PRS_MAP[8] = 11; PRS_MAP[9] = 12; PRS_MAP[10] = 14; PRS_MAP[11] = 15; PRS_MAP[12] = 16; PRS_MAP[13] = 17;
PRS_MAP[14] = 18; PRS_MAP[15] = 19; PRS_MAP[16] = 20; PRS_MAP[17] = 23; PRS_MAP[18] = 24; PRS_MAP[19] = 25;
function load_preset(p) local(i, q) (
  q = p == 11 ? 1 : p;
  i = 0; loop(20, slider(PRS_MAP[i]) = PRS[q * 20 + i]; i += 1; );
  slider13 = 1; slider21 = 1; slider22 = 1; slider27 = 4;
  i = 2; loop(26, ui_auto(i); i += 1; );
  pr_cur = q;
);

function lc_srinit() (
  lc_sr = srate;
  lc_kd = lc_tc(1);
  c_kn = lc_tc(30); c_lk = lc_tc(10); c_sw = lc_tc(15);
  c_k32 = 1 - exp(-32 / (0.03 * srate));
  sg_k = lc_tc(60);
  lc_dcc = 1 - 2 * $pi * 1.5 / srate;
  lc_hpi = -1; lc_fis = 1 / (0.01 * srate);
  st_db = 3 * floor(0.01 * srate / 3 + 0.5);
  os_base = sb_mode == 2 ? st_db : 0;
  ost_init(0);
  lc_rcoefs(os_f); lc_clear();
);
os_design();
ST_L = 1048576; ST_R = ST_L + 7 * ST_N;
os_f = os_tf = os_f2n(slider26);
sb_mode = sb_mt = floor(min(max(slider3, 0), 2) + 0.5); st_g = 1; st_hold = 0;
od_on = od_t = slider23 >= 0.5; od_g = 1; od_hold = 0;
eq_lf = eq_lft = slider5; eq_lm = eq_lmt = slider7; eq_hm = eq_hmt = slider9; eq_hf = eq_hft = slider11;
eq_lz = eq_lzt = log(lc_lff(slider6)); eq_lmz = eq_lmzt = log(lc_lmf(slider8));
eq_hmz = eq_hmzt = log(lc_hmf(slider10)); eq_hz = eq_hzt = log(lc_hff(slider12));
eq_pz = eq_pzt = log(110); eq_hpm = slider4 >= 0.5; eq_qz = eq_qzt = log(11000); eq_lpm = slider27 < 3.5; eq_m = slider13 >= 0.5;
lc_srinit();
os_gsetup();
in_init();
dV.drift_init(0.8 + rand(1) * 0.4); dT.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
lc_snap = 1; lc_fi = 1; lc_cr = 0;
pdc_delay = os_base + os_lat(os_f);
by_setup(1);
pwr_init(); pwr_sag = 0.35;  pwr_wu_loss = 0.5;  pwr_wu_drv = 1;  pwr_wu_lp = 10000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(27, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(26));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
pwr_block(slider(1) < 0.5);
srate != lc_sr ? lc_srinit();
lc_now = time_precise();
lc_tp > 0 && lc_now - lc_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > lc_gpp && play_position - lc_gpp < 4 * lc_gpd + 0.05) ? lc_reset();
lc_tp = lc_now; lc_gpp = play_position; lc_gpd = samplesblock / srate;
in_setup(min(max(slider2, -20), 20), 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider26); pdc_delay = os_base + os_lat(os_f);
sb_mt = floor(min(max(slider3, 0), 2) + 0.5);
od_t = slider23 >= 0.5;
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(25 + 25 * (15 - min(max(slider25, 12), 15)));
lc_n = samplesblock / srate;
lc_vv = dV.drift_tick(0.03 * dm_s * lc_n); lc_vt = dT.drift_tick(0.05 * dm_s * lc_n);
lc_vs = min(max(slider25, 12), 15);
lc_sag = 0.4 * min(sqrt(sg_e) / 0.5, 1) * (1 + 0.6 * (15 - lc_vs) / 3);
lc_v = max(lc_vs - 0.25 * dm_a * (0.5 + 0.5 * lc_vv) - lc_sag, 11);
lc_hb = (15 / lc_v) ^ 1.5; lc_rf = (15 / lc_v) ^ 2;
iIn.ir_tgt(min(max(0.3 + 0.618 * min(max(slider2, -20), 20) / 20, 0), 1), 21, 0.8, 0.1, lc_hb);
iOut.ir_tgt(min(max(0.3 + 0.618 * min(max(slider24, -24), 12) / 20, 0), 1), 19, 2, 0.25, lc_hb);
sb_target(sb_mode == 0 ? 14 : sb_mode == 1 ? 11 : 12, 1, 1, 220, lc_hb);
eq_hpi = floor(min(max(slider4, 0), 4) + 0.5);
eq_hpt = eq_hpi > 0; eq_hpi > 0 ? eq_pzt = log(lc_hpf(eq_hpi));
eq_lpi = floor(min(max(slider27, 0), 4) + 0.5);
eq_lpt = eq_lpi < 4; eq_lpi < 4 ? eq_qzt = log(lc_lpf(eq_lpi));
eq_lft = min(max(slider5, -12), 12); eq_lmt = min(max(slider7, -12), 12);
eq_hmt = min(max(slider9, -12), 12); eq_hft = min(max(slider11, -12), 12);
eq_lzt = log(lc_lff(floor(min(max(slider6, 0), 2) + 0.5)));
eq_lmzt = log(lc_lmf(floor(min(max(slider8, 0), 5) + 0.5)));
eq_hmzt = log(lc_hmf(floor(min(max(slider10, 0), 5) + 0.5)));
eq_hzt = log(lc_hff(floor(min(max(slider12, 0), 3) + 0.5)));
eq_mt = slider13 >= 0.5;
cp_tht = min(max(slider14, -30), 0) + 0.3 * dm_a * lc_vt;
cp_ri = floor(min(max(slider15, 0), 5) + 0.5); cp_slt = 1 - 1 / lc_ratio(cp_ri); cp_kwt = lc_knee(cp_ri);
cp_gb = min(max(slider18, 0), 100) / 100;
cp_att = min(max(slider16, 0.1), 30); cp_rel = min(max(slider17, 50), 2000) * lc_rf;
cp_ka = lc_tc(cp_att); cp_kr = lc_tc(cp_rel);
cp_kaf = lc_tc(cp_att / (1 + 3 * cp_gb)); cp_krf = lc_tc(0.25 * cp_rel);
cp_kas = lc_tc(10 * cp_att + 20); cp_krs = lc_tc(2.5 * cp_rel);
cp_hi = floor(min(max(slider19, 0), 5) + 0.5); cp_hon = cp_hi > 0;
cp_hon && cp_hi != lc_hpi ? ( lc_hpi = cp_hi; hL.hp_set(lc_sch(cp_hi)); hR.hp_set(lc_sch(cp_hi)); );
cp_lkt = slider21 >= 0.5;
cp_mxt = (slider22 >= 0.5) * min(max(slider20, 0), 100) / 100;
lc_lvt = lc_db(min(max(slider24, -24), 12));
lc_snap ? (
  cp_th = cp_tht; cp_sl = cp_slt; cp_kw = cp_kwt; cp_mx = cp_mxt; cp_lk = cp_lkt; lc_lv = lc_lvt;
  eq_m = eq_mt; eq_hpm = eq_hpt; eq_lpm = eq_lpt; iIn.ir_snap(); iOut.ir_snap(); lc_gpl = lc_gnl = lc_gpr = lc_gnr = 1;
  eq_lf = eq_lft; eq_lm = eq_lmt; eq_hm = eq_hmt; eq_hf = eq_hft;
  eq_lz = eq_lzt; eq_lmz = eq_lmzt; eq_hmz = eq_hmzt; eq_hz = eq_hzt; eq_pz = eq_pzt; eq_qz = eq_qzt; sb_snap(); eq_upd(1);
);
lc_snap = 0;
iaL.lp = lc_tn(iaL.lp); iaR.lp = lc_tn(iaR.lp); obL.lp = lc_tn(obL.lp); obR.lp = lc_tn(obR.lp);
hL.s1 = lc_tn(hL.s1); hL.s2 = lc_tn(hL.s2); hR.s1 = lc_tn(hR.s1); hR.s2 = lc_tn(hR.s2);
lc_msl = lc_tn(lc_msl); lc_msr = lc_tn(lc_msr); sg_e = lc_tn(sg_e);
lca_gr_d = min(lca_gr_d, lc_grm < 1 ? 20 * log10(max(lc_grm, 0.0001)) : 0); lc_grm = 1;
lca_ol_d = max(lca_ol_d, lc_ol); lca_or_d = max(lca_or_d, lc_or); lc_ol = lc_or = 0;
lca_cl_d = max(lca_cl_d, lc_clp); lc_clp = 0;
lca_v_d = lc_v;
os_snapb(slider(26));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
lc_xl = in_l; lc_xr = in_r;
pwr_in(lc_xl, lc_xr); lc_xl = pwr_l; lc_xr = pwr_r;
abs(lc_xl) < 0.000000000000001 ? lc_xl = 0; abs(lc_xr) < 0.000000000000001 ? lc_xr = 0;
iIn.ir_glide(c_kn); iOut.ir_glide(c_kn);
sb_glide(c_kn, c_sw);
eq_m += (eq_mt - eq_m) * c_sw; eq_hpm += (eq_hpt - eq_hpm) * c_sw; eq_lpm += (eq_lpt - eq_lpm) * c_sw;
cp_th += (cp_tht - cp_th) * c_kn; cp_sl += (cp_slt - cp_sl) * c_kn; cp_kw += (cp_kwt - cp_kw) * c_kn;
cp_mx += (cp_mxt - cp_mx) * c_sw; cp_lk += (cp_lkt - cp_lk) * c_lk; lc_lv += (lc_lvt - lc_lv) * c_kn;
(lc_cr -= 1) <= 0 ? ( lc_cr = 32; eq_upd(c_k32); );
sg_e += (max(lc_xl * lc_xl, lc_xr * lc_xr) - sg_e) * sg_k;
os_gate();
os_chg ? ( lc_rcoefs(os_f); lc_clear(); os_hold += 2 * samplesblock; );
sb_mt != sb_mode ? (
  st_g = max(st_g - os_gc, 0);
  st_g == 0 ? (
    sb_mode = sb_mt; os_base = sb_mode == 2 ? st_db : 0; pdc_delay = os_base + os_lat(os_f);
    lc_clear(); st_hold = os_base + os_lat(os_f) + 8 + 2 * samplesblock;
  );
) : st_hold > 0 ? st_hold -= 1 : st_g < 1 ? st_g = min(st_g + os_gc, 1);
od_t != od_on ? (
  od_g = max(od_g - os_gc, 0);
  od_g == 0 ? ( od_on = od_t; eqL.eq_clr(); eqR.eq_clr(); od_hold = 32; );
) : od_hold > 0 ? od_hold -= 1 : od_g < 1 ? od_g = min(od_g + os_gc, 1);
uxL.os_up(lc_xl); uxR.os_up(lc_xr);
os_f == 1 ? (
  lc_os(uxL.s0, uxR.s0, lc_gnl, lc_gnr); lc_dpl = lc_wl; lc_dpr = lc_wr; lc_yl = lc_pl; lc_yr = lc_pr;
) : (
  lc_dl = (lc_gnl - lc_gpl) / os_f; lc_dr = (lc_gnr - lc_gpr) / os_f;
  lc_os(uxL.s0, uxR.s0, lc_gpl + lc_dl, lc_gpr + lc_dr); lc_dpl = lc_wl; lc_dpr = lc_wr; lc_a0 = lc_pl; lc_b0 = lc_pr;
  lc_os(uxL.s1, uxR.s1, lc_gpl + 2 * lc_dl, lc_gpr + 2 * lc_dr); lc_a1 = lc_pl; lc_b1 = lc_pr;
  os_f == 2 ? ( lc_yl = dnL.os_dn(lc_a0, lc_a1, 0, 0); lc_yr = dnR.os_dn(lc_b0, lc_b1, 0, 0); ) : (
    lc_os(uxL.s2, uxR.s2, lc_gpl + 3 * lc_dl, lc_gpr + 3 * lc_dr); lc_a2 = lc_pl; lc_b2 = lc_pr;
    lc_os(uxL.s3, uxR.s3, lc_gnl, lc_gnr); lc_a3 = lc_pl; lc_b3 = lc_pr;
    lc_yl = dnL.os_dn(lc_a0, lc_a1, lc_a2, lc_a3); lc_yr = dnR.os_dn(lc_b0, lc_b1, lc_b2, lc_b3);
  );
);
lc_hl = hL.hp_run(lc_dpl); lc_hr = hR.hp_run(lc_dpr);
cp_hon ? ( lc_dpl = lc_hl; lc_dpr = lc_hr; );
lc_msl += lc_kd * (lc_dpl * lc_dpl - lc_msl); lc_msr += lc_kd * (lc_dpr * lc_dpr - lc_msr);
lc_mm = max(lc_msl, lc_msr);
lc_ml = lc_msl + cp_lk * (lc_mm - lc_msl); lc_mr = lc_msr + cp_lk * (lc_mm - lc_msr);
lc_tl = cp_gc(10 * log10(max(lc_ml, 0.00000000001)) + 3.0103);
lc_tr = cp_gc(10 * log10(max(lc_mr, 0.00000000001)) + 3.0103);
lc_gdl = eL.cp_env(lc_tl); lc_gdr = eR.cp_env(lc_tr);
lc_gpl = lc_gnl; lc_gpr = lc_gnr;
lc_gnl = 1 + cp_mx * (exp(0.115129255 * lc_gdl) - 1); lc_gnr = 1 + cp_mx * (exp(0.115129255 * lc_gdr) - 1);
lc_grm = min(lc_grm, min(lc_gnl, lc_gnr));
lc_z = lc_yl - lc_dxl + lc_dcc * lc_dyl; lc_dxl = lc_yl; lc_dyl = lc_z; lc_yl = lc_z;
lc_z = lc_yr - lc_dxr + lc_dcc * lc_dyr; lc_dxr = lc_yr; lc_dyr = lc_z; lc_yr = lc_z;
pwr_out(lc_yl, lc_yr); lc_yl = pwr_l; lc_yr = pwr_r;
lc_osg = os_g * os_g * (3 - 2 * os_g) * st_g * st_g * (3 - 2 * st_g) * od_g * od_g * (3 - 2 * od_g);
lc_yl *= lc_osg; lc_yr *= lc_osg;
lc_yl != lc_yl ? lc_yl = 0; lc_yr != lc_yr ? lc_yr = 0;
lc_fi < 1 ? (
  lc_fi = min(lc_fi + lc_fis, 1); lc_z = lc_fi * lc_fi * (3 - 2 * lc_fi);
  lc_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; lc_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  lc_yl = lc_a + lc_z * (lc_yl - lc_a); lc_yr = lc_b + lc_z * (lc_yr - lc_b);
);
max(abs(lc_yl), abs(lc_yr)) > 0.89 ? lc_clp = 1;
ost_out(lc_yl, lc_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
lc_ol = max(lc_ol, abs(spl0)); lc_or = max(lc_or, abs(spl1));

@gfx 1080 706
ui_begin(1080, 706);
LVP = 0xC69C35; LVPS = 0xD2AA45; LVPH = 0x1F2B45; LVPW = 0x7A5E1C; LVI = 0x1B1610; LVT = 0xF1E6CC; LVA = 0xA8321F;
LVI2 = ui_mix(LVI, LVP, 0.38); LVT2 = ui_mix(LVT, LVPH, 0.38);
CRD = 0xC4222B; CSL = 0x2D5A48; CAM = 0xE07A1F; CYL = 0xF2C21B; CBK = 0x26262A; CGY = 0xBDC0BA; CBL = 0x2F62A6;
CBR = 0x8A5A32; CGN = 0x3E8A4A;

sc != lv_fsc ? (
  lv_fsc = sc;
  lv_f10 = ui_fitfont(10, 14 * sc);
  lv_f11 = ui_fitfont(11, 15 * sc);
  lv_f12 = ui_fitfont(12, 11 * sc);
  lv_f13 = ui_fitfont(13, 14 * sc);
  lv_f14 = ui_fitfont(14, 27 * sc);
  lv_f15 = ui_fitfont(15, 11.5 * sc);
);
gfx_setfont(10, "Trebuchet MS", lv_f10, 'b'); gfx_setfont(11, "Trebuchet MS", lv_f11, 'b');
gfx_setfont(12, "Trebuchet MS", lv_f12, 'b'); gfx_setfont(13, "Trebuchet MS", lv_f13, 'b');
gfx_setfont(14, "Trebuchet MS", lv_f14, 'b'); gfx_setfont(15, "Trebuchet MS", lv_f15, 'b');

function lv_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function lv_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lv_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lv_thick(x1, y1, x2, y2, w) ( ui_ssline(x1, y1, x2, y2, w, 0); );
function lv_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); lv_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function lv_plate(x, y, w, h) (
  lv_shadow(x, y, w, h);
  ui_col(LVPW); lv_r(x, y, w, h);
  ui_col(LVPS); lv_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.07); lv_r(x + 1, y + 1, w - 2, 1); lv_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, 0.22); lv_r(x + 1, y + h - 3, w - 2, 2); lv_r(x + w - 3, y + 1, 2, h - 2);
  ui_col(LVPH); lv_r(x + 1, y + 1, w - 2, 32);
  ui_cola(LVT, 0.35); lv_r(x + 1, y + 33, w - 2, 1);
);
function lv_title(x, y, s) ( gfx_setfont(11); ui_col(LVT); lv_ltxt(x + 14, y + 17, s); );
function lv_split(x, y, h) ( ui_col(LVPW); lv_r(x, y + 1, 1, h - 2); ui_cola(0xFFFFFF, 0.06); lv_r(x + 1, y + 34, 1, h - 35); );
function lv_grey(x, y, w, h) ( ui_cola(LVPS, 0.55); lv_r(x + 1, y + 34, w - 1, h - 37); );
function lv_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
function lv_tlamp(x, y, s, idx) local(cx, cy, on, hov, j) (
  cx = x + 22; cy = y + 17; on = slider(idx) >= 0.5;
  hov = sqr(mouse_x - cx * sc) + sqr(mouse_y - cy * sc) <= sqr(12 * sc);
  hov && pressed && drag_id == 0 ? ( lv_tog(idx); drag_id = -1; on = !on; );
  on ? ( j = 0; loop(4, ui_cola(0xFFB030, 0.07); gfx_circle(cx * sc, cy * sc, (8.5 + j * 2) * sc, 1, 1); j += 1; ); );
  ui_cola(0x000000, 0.35); gfx_circle((cx + 1) * sc, (cy + 1.5) * sc, 7.5 * sc, 1, 1);
  ui_col(0xE8E0CB); gfx_circle(cx * sc, cy * sc, 7.5 * sc, 1, 1);
  ui_col(0x2A2418); gfx_circle(cx * sc, cy * sc, 5.4 * sc, 1, 1);
  ui_col(on ? 0xFFB030 : 0x5A4022); gfx_circle(cx * sc, cy * sc, 4.5 * sc, 1, 1);
  on ? ( ui_cola(0xFFF0C8, 0.75); gfx_circle((cx - 1.3) * sc, (cy - 1.3) * sc, 1.7 * sc, 1, 1); );
  hov ? ( ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, 7.5 * sc, 1, 1); );
  gfx_setfont(11); ui_col(LVT); lv_ltxt(x + 38, y + 17, s);
);

function lv_hpf(i) ( i == 1 ? 33 : i == 2 ? 66 : i == 3 ? 110 : 220; );
function lv_lpf(i) ( i == 0 ? 4400 : i == 1 ? 6600 : i == 2 ? 8800 : 11000; );
function lv_lff(i) ( i == 0 ? 55 : i == 1 ? 110 : 220; );
function lv_lmf(i) ( i == 0 ? 220 : i == 1 ? 330 : i == 2 ? 440 : i == 3 ? 660 : i == 4 ? 880 : 1100; );
function lv_hmf(i) ( 1100 * (i + 1); );
function lv_hff(i) ( i == 0 ? 4400 : i == 1 ? 6600 : i == 2 ? 8800 : 11000; );
function lv_sch(i) ( i == 1 ? 33 : i == 2 ? 66 : i == 3 ? 110 : i == 4 ? 220 : 330; );
function lv_hz(f) ( f < 1000 ? sprintf(#lvh, "%d Hz", f) : sprintf(#lvh, "%.1f kHz", f / 1000); #lvh; );
lv_lg = 0; lv_step = 0;
function lv_kn(v, lo, hi) ( lv_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function lv_kv(n, lo, hi) ( lv_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function lv_cap(cx, cy, r, a, act, cap, nd) local(i, t, x, y, rr) (
  x = cx * sc; y = cy * sc; rr = r * sc;
  ui_col(LVI); i = 0;
  lv_csw <= 0 ? lv_csw = 1;
  loop(nd + 1, t = (-0.75 + i / nd * 1.5) * $pi * lv_csw;
    gfx_circle(x + sin(t) * (rr + 7 * sc), y - cos(t) * (rr + 7 * sc), (i == 0 || i == nd ? 1.5 : 1.2) * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.13); gfx_circle(x + (2 + i * 1.3) * sc, y + (3 + i * 1.6) * sc, rr + i * 0.6 * sc, 1, 1); i += 1; );
  ui_col(0x121212); gfx_circle(x, y, rr, 1, 1);
  i = 0; loop(30, t = i / 30 * 2 * $pi; ui_col(0x34343A);
