) : ( lm_L = lm_Ls = -120; lm_pk = lm_pc = lm_h = 0; lm_gr = 0; lm_e = 0; lm_hit = 0; lmL.ost_acx(sp_yl); lmR.ost_acx(sp_yr); );
lm_hit ? lm_d = 1;
