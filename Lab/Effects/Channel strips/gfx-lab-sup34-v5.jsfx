@gfx 900 355
ui_begin(900, 355);
v5_begin();
v5p_use(6);
SPF = v5p_bg; SPK = v5p_pk; SPI = v5p_ink; SPD = ui_mix(v5p_ink, v5p_pk, 0.35);
SPB = 0x1C2A26; SPKF = 0x1E3D2C; SPKH = 0x285038; SPKT = ui_mix(SPKF, 0xFFFFFF, 0.08);
SPP = 0xD88FA6; SPPD = 0x3A1420; SPA = 0xF2D4A0; SPH = 0x141A18; SPT = v5p_acc;
SPC = 0xE9E4D6; SPCD = 0x23282A; SPBK = 0x24272A;
v5_led = 0xF0A030;
sc != su_fsc ? (
  su_fsc = sc;
  su_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  su_f6 = ui_fitfont(6, 26 * sc);
);
function su_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * su_kt * sc, 'b'); );
function su_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function su_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function su_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function su_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function su_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.18); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.30)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.20)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.10)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.22)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(face); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function su_plate(x, y, w, h, ttl, rc) (
  su_cham(x, y, w, h, 3, SPF, SPK);
  su_ft(18); ui_col(SPI); su_tl(x + 16, y + 21, ttl);
  ui_col(rc); v5_r(x + 16, y + 33, su_tw(ttl), 3);
);
function su_dwell(x, y, w, h) local(j) (
  ui_cola(0xFFFFFF, 0.2); v5_r(x, y + h, w + 1, 1.5); v5_r(x + w, y, 1.5, h + 1);
  ui_col(v5p_well); v5_rr(x, y, w, h, 3);
  j = 0; loop(4, ui_cola(0, 0.18 - j * 0.04); v5_r(x + 1, y + 1 + j, w - 2, 1); v5_r(x + 1 + j, y + 2 + j, 1, h - 3 - j); j += 1; );
);
function su_marks(cx, cy, r, ink) local(i, t, r1) (
  ui_col(ink); i = 0;
  loop(2, t = -0.75 * $pi + i * 1.5 * $pi; r1 = r + 6;
    v5_ln(cx + sin(t) * (r + 1.5), cy - cos(t) * (r + 1.5), cx + sin(t) * r1, cy - cos(t) * r1, 1.6); i += 1; );
);
function su_knob(cx, cy, r, v, cap, pc) local(a, cr) (
