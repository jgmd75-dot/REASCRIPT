sp_gE != sp_tE ? ( sp_gE == 0 ? ( chA.ea.eq_reset(); chB.ea.eq_reset(); chA.es.eq_reset(); chB.es.eq_reset(); ); sp_gE = sp_tE ? min(sp_gE + sp_fst, 1) : max(sp_gE - sp_fst, 0); );
