desc:SUP34 V5 [channel strip] (GFX Lab)
//tags: channel strip preamp harmonic drive sidebar peak saturation filters compressor gate expander 4-band eq sidechain key
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-clip, gfx-lab-os, gfx-lab-sidebar, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider31:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-20,20,0.1>-Gain (dB)
slider3:0<0,10,0.1>-Drive (0 = off, 2nd .. 3rd harmonics)
slider4:0<0,1,1{Normal,Inverted}>-Polarity
slider5:15<15,350,1>-HPF (Hz, 15 = off)
slider6:22<3,22,0.1>-LPF (kHz, 22 = off)
slider7:1<0,1,1{Out,In}>-Comp in
slider8:3<1,21,0.1>-Ratio (21 = inf)
slider9:-20<-40,0,0.1>-Comp threshold (dBFS)
slider10:0.3<0.1,8,0.01>-Comp release (s, 5 and up = auto)
slider11:0<0,1,1{Off,On}>-Comp fast attack
slider12:1<0,2,1{Peak,RMS,RMS slow}>-Comp detector
slider13:1<0,1,1{Out,In}>-EQ in
slider14:0<-15,15,0.1>-LF gain (dB)
slider15:110<30,450,1>-LF freq (Hz)
slider16:0<-15,15,0.1>-MID gain (dB)
slider17:1100<200,7000,1>-MID freq (Hz)
slider18:0<-15,15,0.1>-HF gain (dB)
slider19:8.8<1.5,16,0.1>-HF freq (kHz)
slider20:0<0,1,1{Off,On}>-Pad (sidebar drive)
slider21:0<0,1,1{Off,On}>-External sidechain (in 3/4)
slider22:0<-20,20,0.1>-Output trim (dB)
slider23:50<0,100,1>-Drift (%)
slider24:0<0,100,1>-Heat (%)
slider25:0<0,2,1{1x,2x,4x}>-Oversampling
slider26:0<0,1,1{Off,On}>-Bypass
slider27:0<0,100,1>-Sat (%)
slider28:0<0,1,1{EQ first,Comp first}>-Order
slider29:0<-18,0,0.1>-Limiter threshold (dBFS, 0 = off)
slider30:20<20,500,1>-Comp sidechain HPF (Hz, 20 = off)
slider32:prs_sel=0<0,12,1{No preset,Init,Vocal Polish,Pushed Vocal,Kick,Snare,Toms,Bass DI,Acoustic Guitar,Electric Guitar,Drum Bus Punch,Piano,Overheads}>-Preset

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-sidebar.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
ext_gr_meter = 0;
function psw_all(v) ( slider_show(2 ^ 32 - 1, v); );
function psw_allg(v) ( slider_show(2 ^ 32 - 1, v); );
#ui_man = "gfx-lab-sup34-v5";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 0; clp_kt_on = 0;

function sp_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function sp_op(f) ( 1 - exp(-2 * $pi * min(f, 0.49 * srate) / srate); );
function sp_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function sp_sm(g) ( g * g * (3 - 2 * g); );

HPC = 100; LPC = 105; B0C = 110; B1C = 115; B2C = 120; B3C = 125; SCC = 130;
function sp_w(f) ( 2 * $pi * min(max(f, 5), 0.45 * srate) / srate; );
function sp_lsh(o, f, gdb, q) local(Ag, w, cw, al, s, a0) (
  Ag = 10 ^ (gdb / 40); w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(Ag) * al;
  a0 = (Ag + 1) + (Ag - 1) * cw + s;
  o[0] = Ag * ((Ag + 1) - (Ag - 1) * cw + s) / a0; o[1] = 2 * Ag * ((Ag - 1) - (Ag + 1) * cw) / a0; o[2] = Ag * ((Ag + 1) - (Ag - 1) * cw - s) / a0;
  o[3] = -2 * ((Ag - 1) + (Ag + 1) * cw) / a0; o[4] = ((Ag + 1) + (Ag - 1) * cw - s) / a0;
);
function sp_hsh(o, f, gdb, q) local(Ag, w, cw, al, s, a0) (
  Ag = 10 ^ (gdb / 40); w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(Ag) * al;
  a0 = (Ag + 1) - (Ag - 1) * cw + s;
  o[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + s) / a0; o[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; o[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - s) / a0;
  o[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; o[4] = ((Ag + 1) - (Ag - 1) * cw - s) / a0;
);
function sp_pk(o, f, gdb, q) local(Ag, w, cw, al, n) (
  Ag = 10 ^ (gdb / 40); w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al / Ag;
  o[0] = (1 + al * Ag) / n; o[1] = -2 * cw / n; o[2] = (1 - al * Ag) / n; o[3] = -2 * cw / n; o[4] = (1 - al / Ag) / n;
);
function sp_hp2(o, f, q) local(w, cw, al, n) (
  w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function sp_lp2(o, f, q) local(w, cw, al, n) (
  w = sp_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function sp_bq(x, o) instance(s1, s2) local(y) ( y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y; );
function sp_bqz() instance(s1, s2) ( s1 = s2 = 0; );
function sp_bqt() instance(s1, s2) ( s1 = sp_tn(s1); s2 = sp_tn(s2); );
function sp_upd(k) local(m, g0, g3, q1, q2) (
  g0 = sp_y0 != sp_y0t ? 0 : sp_g0t; g3 = sp_y3 != sp_y3t ? 0 : sp_g3t;
  m = abs(sp_f0_ - sp_f0t) + abs(sp_g0_ - g0) + abs(sp_f1_ - sp_f1t) + abs(sp_g1_ - sp_g1t) + abs(sp_q1_ - sp_q1t)
    + abs(sp_f2_ - sp_f2t) + abs(sp_g2_ - sp_g2t) + abs(sp_q2_ - sp_q2t) + abs(sp_f3_ - sp_f3t) + abs(sp_g3_ - g3)
    + abs(sp_qs_ - sp_qst) + abs(sp_vq_ - sp_vqt) + abs(sp_hf_ - sp_hft) + abs(sp_lf_ - sp_lft);
  m > 0.0001 || k >= 1 || sp_y0 != sp_y0t || sp_y3 != sp_y3t ? (
    sp_f0_ *= (sp_f0t / sp_f0_) ^ k; sp_f1_ *= (sp_f1t / sp_f1_) ^ k; sp_f2_ *= (sp_f2t / sp_f2_) ^ k; sp_f3_ *= (sp_f3t / sp_f3_) ^ k;
    sp_q1_ *= (sp_q1t / sp_q1_) ^ k; sp_q2_ *= (sp_q2t / sp_q2_) ^ k; sp_hf_ *= (sp_hft / sp_hf_) ^ k; sp_lf_ *= (sp_lft / sp_lf_) ^ k;
    sp_g0_ += (g0 - sp_g0_) * k; sp_g1_ += (sp_g1t - sp_g1_) * k; sp_g2_ += (sp_g2t - sp_g2_) * k; sp_g3_ += (g3 - sp_g3_) * k;
    sp_qs_ += (sp_qst - sp_qs_) * k; sp_vq_ += (sp_vqt - sp_vq_) * k;
    sp_y0 != sp_y0t && abs(sp_g0_) < 0.03 ? ( sp_y0 = sp_y0t; sp_g0_ = 0; );
    sp_y3 != sp_y3t && abs(sp_g3_) < 0.03 ? ( sp_y3 = sp_y3t; sp_g3_ = 0; );
    q1 = sp_q1_ * (1 + sp_vq_ * (abs(sp_g1_) / 15 - 0.5)); q2 = sp_q2_ * (1 + sp_vq_ * (abs(sp_g2_) / 15 - 0.5));
    sp_y0 ? sp_pk(B0C, sp_f0_, sp_g0_, 0.8) : sp_lsh(B0C, sp_f0_, sp_g0_, sp_qs_);
    sp_pk(B1C, sp_f1_, sp_g1_, q1); sp_pk(B2C, sp_f2_, sp_g2_, q2);
    sp_y3 ? sp_pk(B3C, sp_f3_, sp_g3_, 0.8) : sp_hsh(B3C, sp_f3_, sp_g3_, sp_qs_);
    sp_hp2(HPC, sp_hf_, 1); sp_h1 = sp_op(sp_hf_);
    sp_lp2(LPC, sp_lf_, 0.70710678);
  );
);

function fl_run() instance(pa, pb) local(ya, yb) (
  sp_eH > 0 ? (
    ya = sp_a - pa; pa += sp_h1 * (sp_a - pa); yb = sp_b - pb; pb += sp_h1 * (sp_b - pb);
    ya = this.ha.sp_bq(ya, HPC); yb = this.hb.sp_bq(yb, HPC);
    sp_a += sp_eH * (ya - sp_a); sp_b += sp_eH * (yb - sp_b);
  );
  sp_eL > 0 ? (
    ya = this.la.sp_bq(sp_a, LPC); yb = this.lb.sp_bq(sp_b, LPC);
    sp_a += sp_eL * (ya - sp_a); sp_b += sp_eL * (yb - sp_b);
  );
);
function fl_reset() instance(pa, pb) ( pa = pb = 0; this.ha.sp_bqz(); this.hb.sp_bqz(); this.la.sp_bqz(); this.lb.sp_bqz(); );
function fl_tidy() instance(pa, pb) ( pa = sp_tn(pa); pb = sp_tn(pb); this.ha.sp_bqt(); this.hb.sp_bqt(); this.la.sp_bqt(); this.lb.sp_bqt(); );
function eq_run() local(ya, yb) (
  ya = this.a3.sp_bq(this.a2.sp_bq(this.a1.sp_bq(this.a0.sp_bq(sp_a, B0C), B1C), B2C), B3C);
  yb = this.b3.sp_bq(this.b2.sp_bq(this.b1.sp_bq(this.b0.sp_bq(sp_b, B0C), B1C), B2C), B3C);
  sp_a += sp_eE * (ya - sp_a); sp_b += sp_eE * (yb - sp_b);
);
function eq_reset() ( this.a0.sp_bqz(); this.a1.sp_bqz(); this.a2.sp_bqz(); this.a3.sp_bqz(); this.b0.sp_bqz(); this.b1.sp_bqz(); this.b2.sp_bqz(); this.b3.sp_bqz(); );
function eq_tidy() ( this.a0.sp_bqt(); this.a1.sp_bqt(); this.a2.sp_bqt(); this.a3.sp_bqt(); this.b0.sp_bqt(); this.b1.sp_bqt(); this.b2.sp_bqt(); this.b3.sp_bqt(); );

function dy_run() instance(ms, mz, pk, gdb, grm, gf, gs) local(x2, lv, lr, ov, t, th, a, cl) (
  sp_gC > 0 ? (
    a = max(abs(sp_sa), abs(sp_sb)); pk = a > pk ? a : pk * cp_kpk;
    x2 = 0.5 * (sp_sa * sp_sa + sp_sb * sp_sb); ms += cp_krms * (x2 - ms); mz += cp_kslo * (x2 - mz);
    lr = cp_wr > 0.0001 ? cp_wr * (10 * log10(max(ms, 0.00000000001)) + 3.0103) : 0;
    cp_ws > 0.0001 ? lr += cp_ws * (10 * log10(max(mz, 0.00000000001)) + 3.0103);
    lv = cp_wp > 0.0001 ? cp_wp * 20 * log10(max(pk, 0.0000001)) + lr : lr;
    ov = lv - cp_th;
    th = ov > 0 ? ov * cp_sl : 0;
    t = ov <= -5 ? 0 : ov >= 5 ? ov * cp_sl : cp_sl * sqr(ov + 5) / 20;
    t = -(t + cp_wp * (th - t));
    gf += (t < gf ? cp_ka : cp_kr) * (t - gf);
    cp_au ? ( gs += (gf < gs ? cp_kcs : cp_kss) * (gf - gs); gdb = min(gf, gs); ) : ( gs = gf; gdb = gf; );
    grm = min(grm, gdb);
  ) : gdb = gf = gs = 0;
  cl = exp(0.115129255 * gdb * sp_eC);
  sp_a *= cl; sp_b *= cl;
);
function dy_reset() instance(ms, mz, pk, gdb, gf, gs) ( ms = mz = pk = gdb = gf = gs = 0; );
function dy_tidy() instance(ms, mz, pk) ( ms = sp_tn(ms); mz = sp_tn(mz); pk = sp_tn(pk); );

function set_run(xl, xr, kl, kr, r) local(dp, fs, es, ek) (
  dp = r & 1; fs = r & 2; es = r & 4; ek = r & 8;
  sp_a = xl; sp_b = xr;
  !fs ? this.fa.fl_run();
  !dp && !es ? this.ea.eq_run();
  sp_ta = sp_a; sp_tb = sp_b;
  ek ? ( sp_a = kl; sp_b = kr; );
  fs ? this.fs.fl_run();
  es ? this.es.eq_run();
  sp_sa = this.sa.sp_bq(sp_a, SCC); sp_sb = this.sb.sp_bq(sp_b, SCC); sp_a = sp_ta; sp_b = sp_tb;
  this.dy.dy_run();
  dp && !es ? this.ea.eq_run();
);
function set_reset() ( this.fa.fl_reset(); this.fs.fl_reset(); this.ea.eq_reset(); this.es.eq_reset(); this.dy.dy_reset(); this.sa.sp_bqz(); this.sb.sp_bqz(); );
function set_tidy() ( this.fa.fl_tidy(); this.fs.fl_tidy(); this.ea.eq_tidy(); this.es.eq_tidy(); this.dy.dy_tidy(); this.sa.sp_bqt(); this.sb.sp_bqt(); );

function vh_run() instance(r2, r3) local(ua, ub, a2, b2, a3, b3) (
  ua = sp_a * 0.9; ub = sp_b * 0.9;
  a2 = this.c2a.clp_run(ua + vh_b2) - r2; b2 = this.c2b.clp_run(ub + vh_b2) - r2;
  a3 = this.c3a.clp_run(ua + vh_b3) - r3; b3 = this.c3b.clp_run(ub + vh_b3) - r3;
  sp_vpk = max(sp_vpk, max(abs(ua), abs(ub)));
  sp_a = (a2 + vh_h * (a3 - a2)) * 1.1111111; sp_b = (b2 + vh_h * (b3 - b2)) * 1.1111111;
);
function vh_cfg() instance(r2, r3) (
  this.c2a.clp_set(1, 1, 0.7, 0); this.c2b.clp_set(1, 1, 0.7, 0);
  this.c3a.clp_set(1, 0.75, 0.75, 0); this.c3b.clp_set(1, 0.75, 0.75, 0);
  r2 = this.c2a.clp_crv(vh_b2); r3 = this.c3a.clp_crv(vh_b3);
);
function vh_prime() (
  this.c2a.x1 = this.c2b.x1 = vh_b2; this.c2a.ad1 = this.c2b.ad1 = this.c2a.clp_ad(vh_b2);
  this.c3a.x1 = this.c3b.x1 = vh_b3; this.c3a.ad1 = this.c3b.ad1 = this.c3a.clp_ad(vh_b3);
);
function hs_lo(x) instance(s1, s2) ( s1 += hs_lk * (x - s1); s2 += hs_lk * (s1 - s2); s2; );
function hs_pre(x) instance(x1, y1) local(y) ( y = hs_pb0 * x + hs_pb1 * x1 - hs_pa1 * y1; x1 = x; y1 = y; y; );
function hs_de(x) instance(x1, y1) local(y) ( y = hs_db0 * x + hs_db1 * x1 - hs_da1 * y1; x1 = x; y1 = y; y; );
function hs_clr() ( dcL.z = dcR.z = 0; loL.s1 = loL.s2 = loR.s1 = loR.s2 = 0; pL.x1 = pL.y1 = pR.x1 = pR.y1 = eL.x1 = eL.y1 = eR.x1 = eR.y1 = 0; );
function hs_coefs(fs) local(k, hsg) (
  hs_kh = min(sp_hdb / 18, 1);
  hs_lb = hs_kh ^ 1.2;
  hsg = exp(0.115129255 * 9 * hs_kh);
  hs_lk = 1 - exp(-2 * $pi * 220 / fs); hs_dk = 1 - exp(-2 * $pi * 5 / fs);
  k = tan($pi * min(2200, 0.45 * fs) / fs);
  hs_pb0 = (hsg + k) / (1 + k); hs_pb1 = (k - hsg) / (1 + k); hs_pa1 = (k - 1) / (1 + k);
  hs_db0 = (1 + k) / (hsg + k); hs_db1 = (k - 1) / (hsg + k); hs_da1 = (k - hsg) / (hsg + k);
);
function hs_dc(d) instance(z) ( z += hs_dk * (d - z); d - z; );
function sp_stage(x, y) local(la, lb) (
  sp_w > 0 ? (
    la = loL.hs_lo(x) * hs_lb; lb = loR.hs_lo(y) * hs_lb;
    sp_a = pL.hs_pre(x - la) * sp_hin; sp_b = pR.hs_pre(y - lb) * sp_hin; vh.vh_run();
    sp_pa = x + sp_w * dcL.hs_dc(eL.hs_de(sp_a * sp_hout) + la - x); sp_pb = y + sp_w * dcR.hs_dc(eR.hs_de(sp_b * sp_hout) + lb - y);
  ) : ( sp_pa = x; sp_pb = y; dcL.z = dcR.z = 0; );
  sb_g > 0.000001 || sb_gt > 0 ? ( sp_pa += sbL.sb_run(sp_pa); sp_pb += sbR.sb_run(sp_pb); );
);
function vh_tidy() ( this.c2a.clp_tidy(); this.c2b.clp_tidy(); this.c3a.clp_tidy(); this.c3b.clp_tidy(); );

#sp_pm = "Init|Vocal Polish|Pushed Vocal|Kick|Snare|Toms|Bass DI|Acoustic Guitar|Electric Guitar|Drum Bus Punch|Piano|Overheads";
function sp_pre(vo, vh, pol, hp, lp, ek, ht, pd) (
  slider3 = vo ? max(vh, 0.2) : 0; slider4 = pol; slider5 = hp; slider6 = lp; slider21 = ek; slider24 = ht; slider20 = pd;
);
function sp_dyn(ci, ra, th, re, fa, pk) (
  slider7 = ci; slider8 = ra; slider9 = th; slider10 = re; slider11 = fa; slider12 = pk == 1 ? 0 : pk == 2 ? 2 : 1;
);
function sp_eqs(ei, lg, lf, mg, mf, fg, ff) (
  slider13 = ei; slider14 = lg; slider15 = lf; slider16 = mg; slider17 = mf; slider18 = fg; slider19 = ff;
);
function load_preset(p) local(i) (
  p == 1  ? ( sp_pre(0, 5, 0, 15, 22, 0, 0, 0);  sp_dyn(1, 3, -20, 0.3, 0, 0);    sp_eqs(1, 0, 110, 0, 1100, 0, 8.8); ) :
  p == 2  ? ( sp_pre(0, 5, 0, 77, 22, 0, 0, 0);  sp_dyn(1, 3, -24, 0.25, 0, 2);   sp_eqs(1, -2, 165, 2, 3300, 3, 9.9); ) :
  p == 3  ? ( sp_pre(1, 3, 0, 99, 18, 0, 30, 1); sp_dyn(1, 4, -26, 0.2, 1, 0);    sp_eqs(1, -2, 110, 3, 3300, 4, 11); ) :
  p == 4  ? ( sp_pre(0, 5, 0, 33, 12, 0, 15, 1); sp_dyn(1, 4, -16, 0.15, 0, 1);   sp_eqs(1, 5, 55, -6, 330, 2, 9.9); ) :
  p == 5  ? ( sp_pre(1, 6, 0, 77, 22, 0, 35, 1); sp_dyn(1, 5, -18, 0.12, 1, 1);   sp_eqs(1, 3, 165, -4, 550, 4, 9.9); ) :
  p == 6  ? ( sp_pre(0, 5, 0, 55, 14, 0, 0, 0);  sp_dyn(1, 3, -18, 0.3, 0, 0);    sp_eqs(1, 3, 110, -6, 440, 2, 8.8); ) :
  p == 7  ? ( sp_pre(1, 2, 0, 33, 9.9, 0, 25, 1); sp_dyn(1, 4, -22, 0.3, 0, 2);   sp_eqs(1, 3, 77, 3, 990, -2, 6.6); ) :
  p == 8  ? ( sp_pre(0, 5, 0, 77, 22, 0, 0, 0);  sp_dyn(1, 2.5, -22, 0.4, 0, 2);  sp_eqs(1, -2, 220, -3, 330, 3, 11); ) :
  p == 9  ? ( sp_pre(1, 7, 0, 88, 8.8, 0, 35, 1); sp_dyn(1, 3, -18, 0.3, 0, 0);   sp_eqs(1, -2, 110, 3, 770, -2, 7.7); ) :
  p == 10 ? ( sp_pre(0, 5, 0, 15, 22, 0, 30, 1); sp_dyn(1, 4, -16, 0.1, 0, 1);    sp_eqs(1, 3, 55, -2, 440, 3, 11); ) :
  p == 11 ? ( sp_pre(0, 5, 0, 44, 22, 0, 0, 0);  sp_dyn(1, 2, -18, 0.5, 0, 2);    sp_eqs(1, 1, 110, -2, 330, 2, 11); ) :
  p == 12 ? ( sp_pre(0, 5, 0, 165, 22, 0, 0, 0); sp_dyn(1, 2, -20, 0.3, 0, 0);    sp_eqs(1, 0, 110, -2, 550, 3, 11); );
  slider28 = p == 3 || p == 10;
  i = 2; loop(23, ui_auto(i); i += 1; ); ui_auto(28);
  pr_cur = p;
);

function sp_srinit() (
  sp_sr = srate;
  cp_kcs = sp_tc(1500); cp_kss = sp_tc(15000);
  lm_h10 = floor(0.010 * srate); lm_h20 = floor(0.020 * srate); lm_pkd = exp(-1 / (0.002 * srate));
  lm_la = 1 - exp(-1 / (0.00065 * srate)); lm_lrs = 20 / (0.2 * srate); lm_lrss = 20 / (15 * srate);
  cp_krms = sp_tc(10); cp_kslo = sp_tc(60); cp_kpk = exp(-1 / (0.005 * srate));
  sp_fst = 1 / (0.01 * srate);
  sp_xst = 1 / (0.025 * srate);
  sp_hst = 1 / (0.03 * srate);
