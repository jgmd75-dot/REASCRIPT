desc:Bure [channel strip] (GFX Lab)
//tags: channel strip commentary voice broadcast speech progressive compressor limiter protection eq high pass
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider19:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-20,20,0.1>-Gain (dB)
slider2:0<0,1,1{Normal,Inverted}>-Polarity
slider3:88<15,350,1>-HPF (Hz, 15 = off)
slider4:0<0,1,1{Off,On}>-Cough (mute)
slider5:1<0,1,1{Out,In}>-EQ in
slider6:0<-12,12,0.1>-Low (dB)
slider7:0<-12,12,0.1>-Presence (dB)
slider8:3300<1100,5500,1>-Presence freq (Hz)
slider9:0<-12,12,0.1>-Air (dB)
slider10:22<3,22,0.1>-LPF (kHz, 22 = off)
slider11:1<0,1,1{Out,In}>-Comp in
slider12:-24<-40,-6,0.1>-Comp threshold (dBFS)
slider13:-10<-24,-1,0.1>-Limit (dBFS)
slider14:0<0,1,1{Normal,Slow}>-Recovery
slider15:0<-20,20,0.1>-Output trim (dB)
slider16:0<0,100,1>-Sat (%)
slider17:50<0,100,1>-Drift (%)
slider18:0<0,1,1{Off,On}>-Bypass
slider20:prs_sel=0<0,10,1{No preset,Init,Commentary,Studio Talk,Podcast,Phone Guest,Crowd Mic,Voice-over,Live Vocal,Light Guard,Hard Guard}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
ext_gr_meter = 0;
function psw_all(v) ( slider_show(2 ^ 20 - 1, v); );
function psw_allg(v) ( slider_show(2 ^ 20 - 1, v); );
#ui_man = "gfx-lab-bure";
ext_noinit = 1;

function br_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function br_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function br_sm(g) ( g * g * (3 - 2 * g); );

HPC = 100; LPC = 105; B0C = 110; B1C = 115; B2C = 120;
function br_w(f) ( 2 * $pi * min(max(f, 5), 0.45 * srate) / srate; );
function br_lsh(o, f, gdb, q) local(ag, w, cw, al, s, a0) (
  ag = 10 ^ (gdb / 40); w = br_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(ag) * al;
  a0 = (ag + 1) + (ag - 1) * cw + s;
  o[0] = ag * ((ag + 1) - (ag - 1) * cw + s) / a0; o[1] = 2 * ag * ((ag - 1) - (ag + 1) * cw) / a0; o[2] = ag * ((ag + 1) - (ag - 1) * cw - s) / a0;
  o[3] = -2 * ((ag - 1) + (ag + 1) * cw) / a0; o[4] = ((ag + 1) + (ag - 1) * cw - s) / a0;
);
function br_hsh(o, f, gdb, q) local(ag, w, cw, al, s, a0) (
  ag = 10 ^ (gdb / 40); w = br_w(f); cw = cos(w); al = sin(w) / (2 * q); s = 2 * sqrt(ag) * al;
  a0 = (ag + 1) - (ag - 1) * cw + s;
  o[0] = ag * ((ag + 1) + (ag - 1) * cw + s) / a0; o[1] = -2 * ag * ((ag - 1) + (ag + 1) * cw) / a0; o[2] = ag * ((ag + 1) + (ag - 1) * cw - s) / a0;
  o[3] = 2 * ((ag - 1) - (ag + 1) * cw) / a0; o[4] = ((ag + 1) - (ag - 1) * cw - s) / a0;
);
function br_pk(o, f, gdb, q) local(ag, w, cw, al, n) (
  ag = 10 ^ (gdb / 40); w = br_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al / ag;
  o[0] = (1 + al * ag) / n; o[1] = -2 * cw / n; o[2] = (1 - al * ag) / n; o[3] = -2 * cw / n; o[4] = (1 - al / ag) / n;
);
function br_hp2(o, f, q) local(w, cw, al, n) (
  w = br_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function br_lp2(o, f, q) local(w, cw, al, n) (
  w = br_w(f); cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function br_bq(x, o) instance(s1, s2) local(y) ( y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y; );
function br_bqz() instance(s1, s2) ( s1 = s2 = 0; );
function br_bqt() instance(s1, s2) ( s1 = br_tn(s1); s2 = br_tn(s2); );

function br_upd(k) local(m) (
  m = abs(br_hf_ - br_hft) + abs(br_lf_ - br_lft) + abs(br_g0_ - br_g0t) + abs(br_g1_ - br_g1t) + abs(br_f1_ - br_f1t) + abs(br_g2_ - br_g2t);
  m > 0.0001 || k >= 1 ? (
    br_hf_ *= (br_hft / br_hf_) ^ k; br_lf_ *= (br_lft / br_lf_) ^ k; br_f1_ *= (br_f1t / br_f1_) ^ k;
    br_g0_ += (br_g0t - br_g0_) * k; br_g1_ += (br_g1t - br_g1_) * k; br_g2_ += (br_g2t - br_g2_) * k;
    br_hp2(HPC, br_hf_, 0.7071); br_lp2(LPC, br_lf_, 0.7071);
    br_lsh(B0C, 110, br_g0_, 0.7071); br_pk(B1C, br_f1_, br_g1_, 1); br_hsh(B2C, 11000, br_g2_, 0.7071);
  );
);

function ch_run(x) instance(y) (
  y = x;
  br_eH > 0 ? y += br_eH * (this.h0.br_bq(y, HPC) - y) : this.h0.br_bqz();
  br_eE > 0 ? y += br_eE * (this.e2.br_bq(this.e1.br_bq(this.e0.br_bq(y, B0C), B1C), B2C) - y);
  br_eL > 0 ? y += br_eL * (this.lp.br_bq(y, LPC) - y);
  y;
);
function ch_reset() ( this.h0.br_bqz(); this.h1.br_bqz(); this.e0.br_bqz(); this.e1.br_bqz(); this.e2.br_bqz(); this.lp.br_bqz(); );
function ch_tidy() ( this.h0.br_bqt(); this.h1.br_bqt(); this.e0.br_bqt(); this.e1.br_bqt(); this.e2.br_bqt(); this.lp.br_bqt(); );

function cm_curve(o, span) ( o <= 0 ? 0 : o < span ? o * o * o / (3 * span * span) : span / 3 + (o - span); );
function cm_run(a, b) instance(ms, pk, gf, gs, gp, lv) local(x2, p, rd, pd, t, o) (
  x2 = 0.5 * (a * a + b * b); ms += cm_krms * (x2 - ms);
  p = max(abs(a), abs(b)); pk = p > pk ? p : pk * cm_kpk;
  rd = 10 * log10(max(ms, 0.0000000001)) + 3.0103;
  pd = 20 * log10(max(pk, 0.00001));
  lv = max(rd, pd - 6);
  o = lv - cm_th;
  t = -cm_curve(o, cm_span);
  t < gf ? gf += (cm_ka + cm_kad * min(max(-t - 6, 0) / 12, 1)) * (t - gf) : gf += cm_kr * (t - gf);
  gs += (gf < gs ? cm_ksa : cm_ksr) * (gf - gs);
  t = min(gf, gs);
  o = pd + t - cm_pc;
  o > 0 ? ( gp = min(gp, -o); ) : gp += cm_kpr * (0 - gp);
  t + gp;
);
function cm_reset() instance(ms, pk, gf, gs, gp, lv) ( ms = pk = gf = gs = gp = 0; lv = -120; );
function cm_tidy() instance(ms, pk) ( ms = br_tn(ms); pk = br_tn(pk); );

#br_pm = "Init|Commentary|Studio Talk|Podcast|Phone Guest|Crowd Mic|Voice-over|Live Vocal|Light Guard|Hard Guard";
function br_set(g, hp, eq, lo, pr, pf, ai, lp, ci, th, li, sl) (
  slider2 = 0; slider3 = hp; slider4 = 0; slider5 = eq; slider6 = lo; slider7 = pr; slider8 = pf; slider9 = ai; slider10 = lp;
  slider11 = ci; slider12 = th; slider13 = li; slider14 = sl;
);
function load_preset(p) local(i) (
  p == 1  ? br_set(0, 88, 1, 0, 0, 3300, 0, 22, 1, -24, -10, 0) :
  p == 2  ? br_set(0, 110, 1, -2, 2.5, 3300, 1.5, 22, 1, -26, -11, 0) :
  p == 3  ? br_set(0, 77, 1, 1, 1.5, 2200, 2, 22, 1, -24, -9, 0) :
  p == 4  ? br_set(0, 88, 1, 1.5, 2, 3300, 2, 22, 1, -27, -12, 1) :
  p == 5  ? br_set(0, 330, 1, -4, 4, 2200, -6, 5.5, 1, -28, -12, 0) :
  p == 6  ? br_set(0, 165, 1, -3, 0, 3300, 1, 16, 1, -30, -14, 1) :
  p == 7  ? br_set(0, 66, 1, 2, 1.5, 4400, 2.5, 22, 1, -25, -10, 1) :
  p == 8  ? br_set(0, 110, 1, -1, 2, 3300, 2, 22, 1, -22, -7, 0) :
  p == 9  ? br_set(0, 88, 0, 0, 0, 3300, 0, 22, 1, -18, -6, 0) :
  p == 10 ? br_set(0, 110, 1, -1, 1.5, 3300, 1, 22, 1, -32, -14, 0);
  i = 2; loop(16, ui_auto(i); i += 1; );
  pr_cur = p;
);

function br_srinit() (
  br_sr = srate;
  cm_krms = br_tc(8); cm_kpk = exp(-1 / (0.004 * srate));
  cm_ka = br_tc(4); cm_kad = br_tc(0.6) - cm_ka; cm_kpr = br_tc(60);
  br_fst = 1 / (0.012 * srate);
  br_gsm = 1 - exp(-1 / (0.015 * srate));
  br_gk = 1 - exp(-32 / (0.05 * srate));
  ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
);
br_srinit();
in_init();
dTh.drift_init(0.8 + rand(1) * 0.4); dS.drift_init(0.7 + rand(1) * 0.4);
drift_macro(50);
chL.ch_reset(); chR.ch_reset(); cm.cm_reset();
br_snap = 1;
rs_g = 1; rs_req = 0;
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
by_setup(18);
pwr_init(); pwr_sag = 0.08; pwr_wu_loss = 0.25; pwr_wu_drv = 1.1; pwr_wu_lp = 14000; pwr_wu_wob = 0.05; pwr_bloom = 0;
xgr_a = 0; lv_disp = -120;

ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(17, i != 4 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
pdc_delay = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
ext_gr_meter = min(xgr_a, 0); xgr_a = 0;
prs_chk();
srate != br_sr ? br_srinit();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
in_setup(0, 0);
br_sat = min(max(slider16, 0), 100) / 100;
ost_setup(br_sat, 0.3, 120, 6000, -0.3, 0);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
pwr_block(slider18 < 0.5);
drift_macro(slider17);
br_n = samplesblock / srate;
br_vt = dTh.drift_tick(0.05 * dm_s * br_n); br_vs = dS.drift_tick(0.07 * dm_s * br_n);
br_tP = slider2 >= 0.5 ? -1 : 1;
br_tM = slider4 >= 0.5 ? 0 : 1;
br_tH = slider3 > 15.5; br_tL = slider10 < 21.95; br_tE = slider5 >= 0.5; br_tK = slider11 >= 0.5;
br_tH ? br_hft = min(max(slider3, 16), 350);
br_tL ? br_lft = min(max(slider10, 3), 22) * 1000;
br_g0t = min(max(slider6, -12), 12); br_g1t = min(max(slider7, -12), 12); br_f1t = min(max(slider8, 1100), 5500); br_g2t = min(max(slider9, -12), 12);
br_gnt = 10 ^ (min(max(slider1, -20), 20) / 20);
br_outt = 10 ^ (min(max(slider15, -20), 20) / 20);
cm_th = min(max(slider12, -40), -6) + 0.3 * dm_a * br_vt;
cm_lim = max(min(max(slider13, -24), -1), cm_th + 2);
cm_span = 1.5 * (cm_lim - cm_th);
cm_pc = cm_lim + 3;
br_sl = slider14 >= 0.5;
cm_kr = br_tc(br_sl ? 320 : 110); cm_ksa = br_tc(br_sl ? 2500 : 2000); cm_ksr = br_tc(br_sl ? 6000 : 3000);
br_snap ? (
  !br_tH ? br_hft = 16; !br_tL ? br_lft = 22000;
  br_hf_ = br_hft; br_lf_ = br_lft; br_g0_ = br_g0t; br_g1_ = br_g1t; br_f1_ = br_f1t; br_g2_ = br_g2t;
  br_upd(1);
  br_gH = br_tH; br_gL = br_tL; br_gE = br_tE; br_gC = br_tK; br_pol = br_tP; br_mu = br_tM;
  br_gns = br_gnt; br_outs = br_outt;
);
br_snap = 0;
chL.ch_tidy(); chR.ch_tidy(); cm.cm_tidy();
o_disp = max(o_disp, max(br_ol, br_or));
br_on > 0 ? orms_disp = max(orms_disp, sqrt(br_os / br_on));
br_ip > 0 ? lvl_disp = max(lvl_disp, br_ip);
lv_disp = br_lvb; gr_disp = min(gr_disp, br_grb);
br_ol = br_or = 0; br_os = br_on = 0; br_ip = 0; br_grb = 0;

@sample
by_in();
rs_req ? (
  rs_req = 0; rs_g = 0;
  chL.ch_reset(); chR.ch_reset(); cm.cm_reset();
);
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
br_dl = spl0; br_dr = spl1;
in_process(spl0, spl1);
br_a = in_l; br_b = in_r;
abs(br_a) < 0.000000000000001 ? br_a = 0; abs(br_b) < 0.000000000000001 ? br_b = 0;
br_gH != br_tH ? br_gH = br_tH ? min(br_gH + br_fst, 1) : max(br_gH - br_fst, 0);
br_gL != br_tL ? br_gL = br_tL ? min(br_gL + br_fst, 1) : max(br_gL - br_fst, 0);
br_gE != br_tE ? ( br_gE == 0 ? ( chL.e0.br_bqz(); chL.e1.br_bqz(); chL.e2.br_bqz(); chR.e0.br_bqz(); chR.e1.br_bqz(); chR.e2.br_bqz(); ); br_gE = br_tE ? min(br_gE + br_fst, 1) : max(br_gE - br_fst, 0); );
br_gC != br_tK ? ( br_gC == 0 ? cm.cm_reset(); br_gC = br_tK ? min(br_gC + br_fst, 1) : max(br_gC - br_fst, 0); );
br_pol != br_tP ? br_pol = br_tP > br_pol ? min(br_pol + 2 * br_fst, 1) : max(br_pol - 2 * br_fst, -1);
br_mu != br_tM ? br_mu = br_tM > br_mu ? min(br_mu + br_fst, 1) : max(br_mu - br_fst, 0);
br_eH = br_sm(br_gH); br_eL = br_sm(br_gL); br_eE = br_sm(br_gE); br_eC = br_sm(br_gC);
(br_cnt += 1) >= 32 ? ( br_cnt = 0; br_upd(br_gk); );
br_gns += (br_gnt - br_gns) * br_gsm;
br_outs += (br_outt - br_outs) * br_gsm;
br_a *= br_gns * br_pol; br_b *= br_gns * br_pol;
pwr_in(br_a, br_b); br_a = pwr_l; br_b = pwr_r;
br_a = chL.ch_run(br_a); br_b = chR.ch_run(br_b);
br_ip = max(br_ip, max(abs(br_a), abs(br_b)));
br_eC > 0 ? (
  br_gr = cm.cm_run(br_a, br_b) * br_eC;
  br_c = exp(0.115129255 * br_gr);
  br_a *= br_c; br_b *= br_c;
  br_lvb = cm.lv; br_grb = min(br_grb, br_gr);
) : ( br_gr = 0; br_lvb = -120; );
pwr_out(br_a, br_b); br_a = pwr_l; br_b = pwr_r;
br_ms = br_sm(br_mu);
br_a *= br_outs * br_ms; br_b *= br_outs * br_ms;
xgr_a = min(xgr_a, br_gr);
rs_g < 1 ? (
  rs_g = min(rs_g + br_fst, 1); rs_e = rs_g * rs_g * (3 - 2 * rs_g);
  br_a = br_dl + rs_e * (br_a - br_dl); br_b = br_dr + rs_e * (br_b - br_dr);
);
br_a = ostL.ost_band(br_a); br_b = ostR.ost_band(br_b);
br_a != br_a ? br_a = 0; br_b != br_b ? br_b = 0;
ost_out(br_a, br_b);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
br_ol = max(br_ol, abs(spl0)); br_or = max(br_or, abs(spl1));
br_os += 0.5 * (spl0 * spl0 + spl1 * spl1); br_on += 1;

@gfx 900 355
ui_begin(900, 355);
v5_begin();
v5p_use(14);
BF = v5p_bg; BK = v5p_pk; BI = v5p_ink;
BB = ui_mix(v5p_bg, 0, 0.55); BKF = ui_mix(BB, 0, 0.30); BKH = ui_mix(BB, 0, 0.12); BKT = ui_mix(BKF, 0xFFFFFF, 0.08);
BA = 0xF2D4A0; BH = 0x141618; BT = v5p_acc; BC2 = 0x8A4A3A; BG = 0x9CC46A;
v5_led = 0xF0A030;
sc != bu_fsc ? (
  bu_fsc = sc;
  bu_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  bu_f6 = ui_fitfont(6, 26 * sc);
);
function bu_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * bu_kt * sc, 'b'); );
function bu_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bu_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function bu_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function bu_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function bu_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.18); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.30)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
