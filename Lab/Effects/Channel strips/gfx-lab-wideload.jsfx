desc:Wideload [channel strip] (GFX Lab)
//tags: channel strip 500 series preamp eq compressor vari-mu console
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-os, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

slider56:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider57:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider1:order=0<0,1,1{EQ first,COMP first}>-Order
slider2:pre_model=0<0,1,1{AR-70 (A),SX-6 (B)}>-PRE Model
slider3:eq_model=0<0,1,1{VX-4 (A),MT-7 (B)}>-EQ Model
slider4:comp_model=0<0,1,1{GB-2 (A),VM-67 (B)}>-COMP Model
slider5:pre_on=1<0,1,1{Off,On}>-PRE In
slider6:ar_gain=0<-24,24,6>-AR-70 Input Level (dB)
slider7:ar_out=0<-20,10,0.5>-AR-70 Output (dB)
slider8:out_sat=0<0,100,1>-Output Sat (%)
slider9:eq_on=1<0,1,1{Off,On}>-EQ In
slider10:lf_f=1<0,3,1{30 Hz,50 Hz,70 Hz,90 Hz}>-VX-4 LF Freq
slider11:lf_g=0<-9,9,0.5>-VX-4 LF Gain (dB)
slider12:hf_f=1<0,3,1{8 kHz,12 kHz,16 kHz,20 kHz}>-VX-4 HF Freq
slider13:hf_g=0<-9,9,0.5>-VX-4 HF Gain (dB)
slider14:lmf_f=400<100,1100,1>-VX-4 LMF Freq (Hz)
slider15:lmf_q=1<0.5,3,0.01>-VX-4 LMF Q
slider16:lmf_g=0<-9,9,0.5>-VX-4 LMF Gain (dB)
slider17:lmf_fc=0<0,1,1{Off,On}>-VX-4 LMF Focus
slider18:hmf_f=2500<600,9000,1>-VX-4 HMF Freq (Hz)
slider19:hmf_q=1<0.5,3,0.01>-VX-4 HMF Q
slider20:hmf_g=0<-9,9,0.5>-VX-4 HMF Gain (dB)
slider21:hmf_fc=0<0,1,1{Off,On}>-VX-4 HMF Focus
slider22:unused22=0<0,3,1>-(unused, was VX-4 HPF)
slider23:unused23=0<-12,12,0.5>-(unused, was VX-4 Trim)
slider24:comp_on=0<0,1,1{Off,On}>-COMP In
slider25:gb_thr=-10<-30,0,0.5>-GB-2 Threshold (dB)
slider26:gb_mk=0<0,20,0.5>-GB-2 Make Up (dB)
slider27:gb_atk=2<0,5,1{0.1 ms,0.3 ms,1 ms,3 ms,10 ms,30 ms}>-GB-2 Attack
slider28:gb_rel=1<0,4,1{0.1 s,0.3 s,0.6 s,1.2 s,Auto}>-GB-2 Release
slider29:gb_ratio=1<0,3,1{1.5:1,2:1,4:1,10:1}>-GB-2 Ratio
slider30:gb_hpf=0<0,5,1{Off,30 Hz,60 Hz,105 Hz,125 Hz,185 Hz}>-GB-2 SC HPF
slider31:out_db=0<-12,12,0.5>-Output (dB)
slider32:drift=0<0,100,1>-Drift (%)
slider33:sx_gain=0<-6,30,0.5>-SX-6 Gain (dB)
slider34:sx_vhd=30<0,100,1>-SX-6 DRV (%)
slider35:sx_hpf=0<0,1,1{Off,75 Hz}>-SX-6 HPF
slider36:sx_out=0<-20,10,0.5>-SX-6 Output (dB)
slider37:mt_lff=1<0,3,1{20 Hz,30 Hz,60 Hz,100 Hz}>-MT-7 LF Freq
slider38:mt_lfb=0<0,10,0.1>-MT-7 LF Boost
slider39:mt_lfa=0<0,10,0.1>-MT-7 LF Atten
slider40:mt_hff=3<0,6,1{3 kHz,4 kHz,5 kHz,8 kHz,10 kHz,12 kHz,16 kHz}>-MT-7 HF Boost Freq
slider41:mt_bw=5<1,10,0.1>-MT-7 HF Bandwidth
slider42:mt_hfb=0<0,10,0.1>-MT-7 HF Boost
slider43:mt_haf=1<0,2,1{5 kHz,10 kHz,20 kHz}>-MT-7 HF Atten Freq
slider44:mt_hfa=0<0,10,0.1>-MT-7 HF Atten
slider45:vm_in=0<0,20,0.5>-VM-67 Input (dB)
slider46:vm_thr=5<0,10,0.1>-VM-67 Threshold
slider47:vm_tc=1<0,5,1{TC 1,TC 2,TC 3,TC 4,TC 5,TC 6}>-VM-67 Time Constant
slider48:vm_out=0<-20,10,0.5>-VM-67 Output (dB)
slider49:os_bias=30<0,100,1>-Bias (output stage, %)
slider50:os_lo=120<40,400,1>-Sat low band (Hz)
slider51:os_hi=6000<2000,16000,10>-Sat high band (Hz)
slider52:os_ceil=-0.3<-24,0,0.1>-Ceiling (dB)
slider54:byp_on=0<0,1,1{Off,On}>-Bypass
slider55:prs_sel=0<0,12,1{No preset,Init,Vocal: Vintage Chain,Vocal: Silky Tube,Vocal: Up Front,Drums: Bus Slam,Drums: Vari-Mu Room,Bass: Iron and Glue,Bass: Low Trick,Guitar: Crunchy Pre,Mix Bus: Glue,Mix Bus: Tube Polish,Colour: All B - Hot}>-Preset

@init
ext_noinit = 1;
#ui_man = "gfx-lab-wideload";
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; ); ui_dflt = 1;
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(byp_on, v); slider_show(prs_sel, v); slider_show(psw_view, v); slider_show(os_sel, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(byp_on, v); slider_show(prs_sel, v); slider_show(psw_view, v); slider_show(os_sel, v); );
WL_OS = 8380000; wl_fs = srate; os_design(); os_base = 0;
os_f = os_tf = os_f2n(os_sel); os_gsetup(); pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(54);
pwr_init(); pwr_sag = 0.2; pwr_wu_loss = 1; pwr_wu_drv = 1.5; pwr_wu_lp = 7000; pwr_wu_wob = 0.2; pwr_bloom = 0.15;
#wl_pm = "Init|Vocal: Vintage Chain|Vocal: Silky Tube|Vocal: Up Front|Drums: Bus Slam|Drums: Vari-Mu Room|Bass: Iron and Glue|Bass: Low Trick|Guitar: Crunchy Pre|Mix Bus: Glue|Mix Bus: Tube Polish|Colour: All B - Hot";
gfx_ext_retina = 1;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();

mod_on = 0;  mod_tgt = 4;
lff_tab = 10; lff_tab[0]=30; lff_tab[1]=50; lff_tab[2]=70; lff_tab[3]=90;
hff_tab = 20; hff_tab[0]=8000; hff_tab[1]=12000; hff_tab[2]=16000; hff_tab[3]=20000;

atk_tab = 40; atk_tab[0]=0.1; atk_tab[1]=0.3; atk_tab[2]=1; atk_tab[3]=3; atk_tab[4]=10; atk_tab[5]=30;
rel_tab = 50; rel_tab[0]=100; rel_tab[1]=300; rel_tab[2]=600; rel_tab[3]=1200;
rt_tab  = 60; rt_tab[0]=1.5; rt_tab[1]=2; rt_tab[2]=4; rt_tab[3]=10;
kn_tab  = 70; kn_tab[0]=12; kn_tab[1]=9; kn_tab[2]=6; kn_tab[3]=3;
lfb_tab = 90; lfb_tab[0]=20; lfb_tab[1]=30; lfb_tab[2]=60; lfb_tab[3]=100;
hfb_tab = 95; hfb_tab[0]=3000; hfb_tab[1]=4000; hfb_tab[2]=5000; hfb_tab[3]=8000; hfb_tab[4]=10000; hfb_tab[5]=12000; hfb_tab[6]=16000;
haf_tab = 105; haf_tab[0]=5000; haf_tab[1]=10000; haf_tab[2]=20000;
tca_tab = 110; tca_tab[0]=0.2; tca_tab[1]=0.2; tca_tab[2]=0.4; tca_tab[3]=0.4; tca_tab[4]=0.4; tca_tab[5]=0.2;
tcr_tab = 120; tcr_tab[0]=300; tcr_tab[1]=800; tcr_tab[2]=2000; tcr_tab[3]=5000; tcr_tab[4]=2000; tcr_tab[5]=300;
sch_tab = 80; sch_tab[0]=0; sch_tab[1]=30; sch_tab[2]=60; sch_tab[3]=105; sch_tab[4]=125; sch_tab[5]=185;

strcpy(100,"30 Hz"); strcpy(101,"50 Hz"); strcpy(102,"70 Hz"); strcpy(103,"90 Hz");
strcpy(110,"8 kHz"); strcpy(111,"12 kHz"); strcpy(112,"16 kHz"); strcpy(113,"20 kHz");
strcpy(120,"OFF"); strcpy(121,"30 Hz"); strcpy(122,"40 Hz"); strcpy(123,"50 Hz");
strcpy(130,"0.1 ms"); strcpy(131,"0.3 ms"); strcpy(132,"1 ms"); strcpy(133,"3 ms"); strcpy(134,"10 ms"); strcpy(135,"30 ms");
strcpy(140,"0.1 s"); strcpy(141,"0.3 s"); strcpy(142,"0.6 s"); strcpy(143,"1.2 s"); strcpy(144,"AUTO");
strcpy(150,"1.5:1"); strcpy(151,"2:1"); strcpy(152,"4:1"); strcpy(153,"10:1");
strcpy(160,"OFF"); strcpy(161,"30 Hz"); strcpy(162,"60 Hz"); strcpy(163,"105 Hz"); strcpy(164,"125 Hz"); strcpy(165,"185 Hz");
strcpy(200,"30"); strcpy(201,"50"); strcpy(202,"70"); strcpy(203,"90");
strcpy(210,"8"); strcpy(211,"12"); strcpy(212,"16"); strcpy(213,"20");
strcpy(220,"OFF"); strcpy(221,"30"); strcpy(222,"40"); strcpy(223,"50");
strcpy(230,".1"); strcpy(231,".3"); strcpy(232,"1"); strcpy(233,"3"); strcpy(234,"10"); strcpy(235,"30");
strcpy(240,".1"); strcpy(241,".3"); strcpy(242,".6"); strcpy(243,"1.2"); strcpy(244,"A");
strcpy(250,"1.5"); strcpy(251,"2"); strcpy(252,"4"); strcpy(253,"10");
strcpy(260,"OFF"); strcpy(261,"30"); strcpy(262,"60"); strcpy(263,"105"); strcpy(264,"125"); strcpy(265,"185");
strcpy(270,"100"); strcpy(271,"330"); strcpy(272,"1.1k");
strcpy(280,"600"); strcpy(281,"2.3k"); strcpy(282,"9k");
strcpy(300,"20 Hz"); strcpy(301,"30 Hz"); strcpy(302,"60 Hz"); strcpy(303,"100 Hz");
strcpy(310,"20"); strcpy(311,"30"); strcpy(312,"60"); strcpy(313,"100");
strcpy(320,"3 kHz"); strcpy(321,"4 kHz"); strcpy(322,"5 kHz"); strcpy(323,"8 kHz"); strcpy(324,"10 kHz"); strcpy(325,"12 kHz"); strcpy(326,"16 kHz");
strcpy(330,"3"); strcpy(331,"4"); strcpy(332,"5"); strcpy(333,"8"); strcpy(334,"10"); strcpy(335,"12"); strcpy(336,"16");
strcpy(340,"5 kHz"); strcpy(341,"10 kHz"); strcpy(342,"20 kHz");
strcpy(345,"5"); strcpy(346,"10"); strcpy(347,"20");
strcpy(350,"TC 1  0.3 s"); strcpy(351,"TC 2  0.8 s"); strcpy(352,"TC 3  2 s"); strcpy(353,"TC 4  5 s"); strcpy(354,"TC 5  AUTO 2-10 s"); strcpy(355,"TC 6  AUTO 0.3-10 s");
strcpy(370,"SHARP"); strcpy(371,"BROAD");
strcpy(360,"1"); strcpy(361,"2"); strcpy(362,"3"); strcpy(363,"4"); strcpy(364,"5"); strcpy(365,"6");

AR_K     = 0.22;
AR_BIAS  = 0.10;
AR_IRON  = 70;
FOCUS_Q  = 2.5;
FOCUS_G  = 15 / 9;
SX_K     = 0.12;
SX_BIAS  = 0.15;
MT_K     = 0.15;
MT_BIAS  = 0.12;
VM_BIAS  = 0.14;

first_run = 1;
fade_g = 1;

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );
function tg(f) ( tan($pi * min(f, wl_fs * 0.45) / wl_fs); );

function op_set(fc) instance(G) local(w) ( w = tg(fc);  G = w / (1 + w); );
function op_lp(x) instance(G, s) local(v, y) ( v = (x - s) * G;  y = v + s;  s = y + v;  y; );

function f2_core(g_, k_) instance(g, k, a1, a2, a3) (
  g = g_;  k = k_;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function ls_set(f, q, db) instance(g, k, a1, a2, a3, m0, m1, m2) local(A) (
  A = exp(db * 0.05756462732485115);
  this.f2_core(tg(f) / sqrt(A), 1 / q);  m0 = 1;  m1 = k * (A - 1);  m2 = A * A - 1;
);
function hs_set(f, q, db) instance(g, k, a1, a2, a3, m0, m1, m2) local(A) (
  A = exp(db * 0.05756462732485115);
  this.f2_core(tg(f) * sqrt(A), 1 / q);  m0 = A * A;  m1 = k * (1 - A) * A;  m2 = 1 - A * A;
);
function pk_set(f, q, db) instance(g, k, a1, a2, a3, m0, m1, m2) local(A) (
  A = exp(db * 0.05756462732485115);
  this.f2_core(tg(f), 1 / (q * A));  m0 = 1;  m1 = k * (A * A - 1);  m2 = 0;
);
function hp_set(f, q) instance(g, k, a1, a2, a3, m0, m1, m2) (
  this.f2_core(tg(f), 1 / q);  m0 = 1;  m1 = -k;  m2 = -1;
);
function f2_tick(x) instance(a1, a2, a3, m0, m1, m2, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;
  m0 * x + m1 * v1 + m2 * v2;
);

function sat_f(x) ( x / (1 + abs(x)); );
function sat_ad(x) ( abs(x) - log(1 + abs(x)); );
function adaa(x) instance(xp, Fp, yp) local(F, yc, d, y) (
  F = sat_ad(x);  yc = sat_f(x);  d = x - xp;
  abs(d) < 0.00001 ? ( y = sat_f(0.5 * (x + xp)); ) : ( y = (F - Fp) / d; );
  y += 0.5 * (yc - yp);
  xp = x;  Fp = F;  yp = yc;  y;
);

function ar_tick(x) instance(ironlp, ironsat, stage, dc, air) local(y, lf, s) (
  y = x * ar_g;
  lf = ironlp.op_lp(y);
  y  = (y - lf) + ironsat.adaa(lf * ar_ik) / ar_ik;
  s  = y * ar_kd;
  abs(s) > ar_pk ? ( ar_pk = abs(s); );
  y = (stage.adaa(s + AR_BIAS) - ar_bias_f) * ar_nd;
  y = y - dc.op_lp(y);
  y = y + 0.096 * (y - air.op_lp(y));
  y * ar_post;
);

function vx_tick(x) instance(lf, lm, hm, hf) local(y) (
  y = x;
  lf_on  ? ( y = lf.f2_tick(y); );
  lmf_on ? ( y = lm.f2_tick(y); );
  hmf_on ? ( y = hm.f2_tick(y); );
  hf_on  ? ( y = hf.f2_tick(y); );
  y;
);

function gb_run() local(sl, sr, lvl, ldb, over, hk, gt, c, gg) (
  sl = aL;  sr = aR;
  gb_hpf > 0 ? ( sl = scL.f2_tick(sl);  sr = scR.f2_tick(sr); );
  lvl = max(abs(sl), abs(sr));
  ldb = lvl > 0.000001 ? 8.685889638065035 * log(lvl) : -120;
  over = ldb - gb_thr_d;
  hk = gb_knee * 0.5;
  over <= -hk ? ( gt = 0; ) :
  over >=  hk ? ( gt = over * gb_slope; ) :
                ( gt = gb_slope * sqr(over + hk) / (2 * gb_knee); );
  gt > gb_gr ? ( c = gb_ac; ) : (
    gb_rel == 4 ? ( c = (gb_gr - gt) > 3 ? gb_rc_fast : gb_rc_slow; ) : ( c = gb_rc; );
  );
  gb_gr += (gt - gb_gr) * c;
  gg = db2g(gb_mk - gb_gr);
  aL *= gg;  aR *= gg;
  gb_gr > gb_gr_pk ? ( gb_gr_pk = gb_gr; );
);

function sx_tick(x) instance(hp, st2, st3, dc) local(y, s, e2, e3) (
  y = x * sx_g;
  sx_hpf ? ( y = hp.f2_tick(y); );
  s = y * sx_kd;
  abs(s) > ar_pk ? ( ar_pk = abs(s); );
  e2 = (st2.adaa(s + SX_BIAS) - sx_bf) * sx_n2;
  e3 = st3.adaa(s);
  y = (e2 + (e3 - e2) * sx_mix) / sx_kd;
  y = y - dc.op_lp(y);
  y * sx_post;
);

function mt_tick(x) instance(lb, la, hb, ha, tube, dc) local(y) (
  y = x;
  mt_lb_on ? ( y = lb.f2_tick(y); );
  mt_la_on ? ( y = la.f2_tick(y); );
  mt_hb_on ? ( y = hb.f2_tick(y); );
  mt_ha_on ? ( y = ha.f2_tick(y); );
  y = (tube.adaa(y * MT_K + MT_BIAS) - mt_bf) * mt_nd;
  y - dc.op_lp(y);
);

function vm_run() local(lvl, ldb, over, o, gt, c, gg) (
  aL *= vm_ig;  aR *= vm_ig;
  lvl = max(abs(aL), abs(aR));
  ldb = lvl > 0.000001 ? 8.685889638065035 * log(lvl) : -120;
  over = ldb - vm_thr_d;
  o = over > 40 ? over : 5 * log(1 + exp(over / 5));
  gt = o * (1 - 1 / (1.5 + 0.2 * o));
  gt > vm_gr ? ( c = vm_ac; ) : (
    vm_auto ? ( c = (vm_gr - gt) > 2 ? vm_rc : vm_rc_slow; ) : ( c = vm_rc; );
  );
  vm_gr += (gt - vm_gr) * c;
  gg = db2g(-vm_gr) * vm_kd;
  aL = (vtL.adaa(aL * gg + VM_BIAS) - vm_bf) * vm_nd;
  aR = (vtR.adaa(aR * gg + VM_BIAS) - vm_bf) * vm_nd;
  aL = (aL - vdL.op_lp(aL)) * vm_og;
  aR = (aR - vdR.op_lp(aR)) * vm_og;
  vm_gr > gb_gr_pk ? ( gb_gr_pk = vm_gr; );
);

function run_module(m) local(w, dl, dr) (
  w = mod_on[m];
  w > 0 ? (
    dl = aL;  dr = aR;
    m == 0 ? 0 :
    m == 1 ? ( mdl_act & 2 ? ( aL = mtL.mt_tick(aL);  aR = mtR.mt_tick(aR); ) : ( aL = vxL.vx_tick(aL);  aR = vxR.vx_tick(aR); ); ) :
             ( mdl_act & 4 ? vm_run() : gb_run(); );
    w < 1 ? ( aL = dl + (aL - dl) * w;  aR = dr + (aR - dr) * w; );
  );
);

function update_params() local(i, f, q, g) (
  ord_new = order;
  mdl_new = (pre_model >= 0.5) + 2 * (eq_model >= 0.5) + 4 * (comp_model >= 0.5);
  mod_tgt[0] = pre_on;  mod_tgt[1] = eq_on;  mod_tgt[2] = comp_on;

  ar_g      = db2g(ar_gain);
  ar_post   = db2g(ar_out);
  ar_ik     = 0.12 + 0.012 * max(ar_gain, 0);
  ar_bias_f = sat_f(AR_BIAS);
  wl_fs = srate * os_f;
  arL.ironlp.op_set(AR_IRON);  arR.ironlp.op_set(AR_IRON);
  arL.dc.op_set(8);            arR.dc.op_set(8);
  arL.air.op_set(9000);        arR.air.op_set(9000);
  wl_fs = srate;

  lf_on  = lf_g  != 0;  hf_on  = hf_g  != 0;
  lmf_on = lmf_g != 0;  hmf_on = hmf_g != 0;
  vxL.lf.ls_set(lff_tab[lf_f], 0.71, lf_g);   vxR.lf.ls_set(lff_tab[lf_f], 0.71, lf_g);
  vxL.hf.hs_set(hff_tab[hf_f], 0.71, hf_g);   vxR.hf.hs_set(hff_tab[hf_f], 0.71, hf_g);
  q = lmf_q * (lmf_fc ? FOCUS_Q : 1);  g = lmf_g * (lmf_fc ? FOCUS_G : 1);
  vxL.lm.pk_set(lmf_f, q, g);  vxR.lm.pk_set(lmf_f, q, g);
  q = hmf_q * (hmf_fc ? FOCUS_Q : 1);  g = hmf_g * (hmf_fc ? FOCUS_G : 1);
  vxL.hm.pk_set(hmf_f, q, g);  vxR.hm.pk_set(hmf_f, q, g);

  gb_slope   = 1 - 1 / rt_tab[gb_ratio];
  gb_knee    = kn_tab[gb_ratio];
  gb_ac      = 1 - exp(-1000 / (atk_tab[gb_atk] * srate));
  gb_rc      = 1 - exp(-1000 / (rel_tab[min(3, gb_rel)] * srate));
  gb_rc_fast = 1 - exp(-1000 / (100 * srate));
  gb_rc_slow = 1 - exp(-1000 / (1200 * srate));
  f = sch_tab[gb_hpf];
  gb_hpf > 0 ? ( scL.hp_set(f, 0.71);  scR.hp_set(f, 0.71); );

  sx_g    = db2g(sx_gain);
  sx_post = db2g(sx_out);
  sx_kd   = SX_K * (1 + 2.5 * sx_vhd / 100);
  sx_mix  = sx_vhd / 100;
  sx_bf   = sat_f(SX_BIAS);
  sx_n2   = sqr(1 + SX_BIAS);
  wl_fs = srate * os_f;
  sxL.hp.hp_set(75, 0.71);  sxR.hp.hp_set(75, 0.71);
  sxL.dc.op_set(8);         sxR.dc.op_set(8);
  wl_fs = srate;

  mt_lb_on = mt_lfb > 0;  mt_la_on = mt_lfa > 0;  mt_hb_on = mt_hfb > 0;  mt_ha_on = mt_hfa > 0;
  f = lfb_tab[mt_lff];
  mtL.lb.ls_set(f, 0.55, mt_lfb * 1.35);         mtR.lb.ls_set(f, 0.55, mt_lfb * 1.35);
  mtL.la.ls_set(f * 2.2, 0.5, -mt_lfa * 1.75);   mtR.la.ls_set(f * 2.2, 0.5, -mt_lfa * 1.75);
  q = 2.5 * pow(0.16, (mt_bw - 1) / 9);
  mtL.hb.pk_set(hfb_tab[mt_hff], q, mt_hfb * 1.6);  mtR.hb.pk_set(hfb_tab[mt_hff], q, mt_hfb * 1.6);
  mtL.ha.hs_set(haf_tab[mt_haf], 0.6, -mt_hfa * 1.6);  mtR.ha.hs_set(haf_tab[mt_haf], 0.6, -mt_hfa * 1.6);
  mt_bf = sat_f(MT_BIAS);
  mt_nd = sqr(1 + MT_BIAS) / MT_K;
  mtL.dc.op_set(8);  mtR.dc.op_set(8);

  vm_ig  = db2g(vm_in);
  vm_og  = db2g(vm_out);
  vm_thr_db = -4 - 3 * vm_thr;
  vm_kd  = 0.14 + 0.008 * vm_in;
  vm_bf  = sat_f(VM_BIAS);
  vm_nd  = sqr(1 + VM_BIAS) / vm_kd;
  vm_ac  = 1 - exp(-1000 / (tca_tab[vm_tc] * srate));
  vm_rc  = 1 - exp(-1000 / (tcr_tab[vm_tc] * srate));
  vm_rc_slow = 1 - exp(-1000 / (10000 * srate));
  vm_auto = vm_tc >= 4;
  vdL.op_set(8);  vdR.op_set(8);

  out_t  = db2g(out_db);
  out_sm = 1 - exp(-1 / (0.02 * srate));
  drift_amt = drift / 100;
  sag_a = 1 - exp(-1000 / (30 * srate));
  sag_r = 1 - exp(-1000 / (400 * srate));
  ramp_step = 1 / (0.010 * srate);
  fade_step = 1 / (0.004 * srate);

  first_run ? (
    i = 0;  loop(3, mod_on[i] = mod_tgt[i];  i += 1; );
    ord_act = ord_new;  mdl_act = mdl_new;  out_s = out_t;
    first_run = 0;
  );
);

