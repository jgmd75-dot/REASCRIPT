function prs_sl() (
update_params();
ost_setup(out_sat / 100, os_bias / 100, os_lo, os_hi, os_ceil, 1);
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(54, i != 53 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();
os_tf = os_f2n(os_sel);
os_snap(slider(57));

@block
prs_chk();
prm_dirty ? ( prm_dirty = 0;  update_params(); );
ord_dirty = ord_new != ord_act || mdl_new != mdl_act;
dw_t += samplesblock / srate;
pwr_block(byp_on < 0.5);
dw_t > 0.7 ? ( dw_t = 0;  dw_target = rand(2) - 1; );
dw += (dw_target - dw) * (1 - exp(-samplesblock / (srate * 1.5)));
gb_thr_d = gb_thr + drift_amt * 0.6 * dw;
vm_thr_d = vm_thr_db + drift_amt * 0.8 * dw;
inL_d  = max(inL_d,  inpkL);   inpkL = 0;   inR_d  = max(inR_d,  inpkR);   inpkR = 0;
outL_d = max(outL_d, outpkL);  outpkL = 0;  outR_d = max(outR_d, outpkR);  outpkR = 0;
gr_d   = max(gr_d, gb_gr_pk);  gb_gr_pk = 0;
arpk_d = max(arpk_d, ar_pk);   ar_pk = 0;
os_tf = os_f2n(os_sel);
os_snapb(slider(57));

@sample
by_in();
pwr_in(spl0, spl1); aL = pwr_l;  aR = pwr_r;
inpkL = max(inpkL, abs(aL));  inpkR = max(inpkR, abs(aR));

lvl = max(abs(aL), abs(aR));
sag_env += (lvl - sag_env) * (lvl > sag_env ? sag_a : sag_r);
sg = min(sag_env, 1);
ar_kd = AR_K * (1 + drift_amt * (0.12 * dw + 0.6 * sg));
ar_nd = sqr(1 + AR_BIAS) / ar_kd;

i = 0;
loop(3,
  t = mod_tgt[i];  v = mod_on[i];
  v != t ? ( mod_on[i] = t > v ? min(t, v + ramp_step) : max(t, v - ramp_step); );
  i += 1;
);

ord_dirty ? (
  fade_g = max(0, fade_g - fade_step);
  fade_g == 0 ? ( ord_act = ord_new;  mdl_act = mdl_new;  ord_dirty = 0; );
) : fade_g < 1 ? ( fade_g = min(1, fade_g + fade_step); );

os_gate();
os_chg ? ( osuL.os_clr(); osuR.os_clr(); osdL.os_clr(); osdR.os_clr(); update_params(); pdc_delay = os_lat(os_f); );
wl_w = mod_on[0];
osuL.os_up(aL); osuR.os_up(aR);
wl_p = 0; loop(os_f,
  wl_xl = osuL.os_s(wl_p); wl_xr = osuR.os_s(wl_p);
  wl_w > 0 ? (
    mdl_act & 1 ? ( wl_yl = sxL.sx_tick(wl_xl); wl_yr = sxR.sx_tick(wl_xr); ) : ( wl_yl = arL.ar_tick(wl_xl); wl_yr = arR.ar_tick(wl_xr); );
    wl_w < 1 ? ( wl_yl = wl_xl + (wl_yl - wl_xl) * wl_w; wl_yr = wl_xr + (wl_yr - wl_xr) * wl_w; );
  ) : ( wl_yl = wl_xl; wl_yr = wl_xr; );
  WL_OS[wl_p] = wl_yl; WL_OS[4 + wl_p] = wl_yr;
  wl_p += 1; );
