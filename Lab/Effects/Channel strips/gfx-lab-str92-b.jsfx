import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider63, v); slider_show(slider64, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider63, v); slider_show(slider64, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-str92-b";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;

function bqf_set(type, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, Ag, n, sa) (
  w0 = 2 * $pi * min(f, vx_fs * 0.45) / vx_fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); Ag = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / Ag; b0 = (1 + al * Ag) / n; b1 = -2 * cw / n; b2 = (1 - al * Ag) / n; a1 = b1; a2 = (1 - al / Ag) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(Ag) * al; n = (Ag + 1) - (Ag - 1) * cw + sa;
                b0 = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / n; b1 = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / n;
                b2 = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / n; a1 = 2 * ((Ag - 1) - (Ag + 1) * cw) / n; a2 = ((Ag + 1) - (Ag - 1) * cw - sa) / n; ) :
  type == 4 ? ( sa = 2 * sqrt(Ag) * al; n = (Ag + 1) + (Ag - 1) * cw + sa;
                b0 = Ag * ((Ag + 1) - (Ag - 1) * cw + sa) / n; b1 = 2 * Ag * ((Ag - 1) - (Ag + 1) * cw) / n;
                b2 = Ag * ((Ag + 1) - (Ag - 1) * cw - sa) / n; a1 = -2 * ((Ag - 1) + (Ag + 1) * cw) / n; a2 = ((Ag + 1) + (Ag - 1) * cw - sa) / n; ) :
  ( n = 1 + al; b0 = al / n; b1 = 0; b2 = -al / n; a1 = -2 * cw / n; a2 = (1 - al) / n; );
);
function bqz() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function vx_db(d) ( exp(0.11512925465 * d); );
function vx_kt(t) ( 1 - exp(-1 / (max(t, 0.000001) * vx_fs)); );
function vx_kf(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * vx_fs) / vx_fs); );

function gl(t) instance(v) ( v += (t - v) * vx_gb; abs(t - v) < 0.0001 * max(abs(t), 0.01) ? v = t; v; );
function gl_set(t) instance(v) ( v = t; );

function pre_run(x, kk) instance(lo, c1) local(u, y, c) (
  lo += (x - lo) * pre_lc;
  x += pre_xa * (lo / sqrt(1 + sqr(pre_xd * lo)) - lo);
  u = this.pf.clp_pf_run(x) * kk + pre_b;
  y = this.k.clp_run(u); c = this.k.clp_crv(u);
  y += 0.5 * (c - c1); c1 = c;
  (y - pre_cb) / (kk * pre_sl);
);
function sat_run(x, kk) instance(c1) local(u, y, c) (
  u = this.pf.clp_pf_run(x) * kk + sat_b;
  y = this.k.clp_run(u); c = this.k.clp_crv(u);
  y += 0.5 * (c - c1); c1 = c;
  (y - sat_cb) / (kk * sat_sl);
);

function dsx_ap(f, q) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, vx_fs * 0.45) / vx_fs; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al;
  b0 = (1 - al) / n; b1 = -2 * cw / n; b2 = 1; a1 = b1; a2 = b0;
);
function dsx_set(fc) (
  this.h1.bqf_set(1, fc, 0.5411961, 0); this.h2.bqf_set(1, fc, 1.3065630, 0);
  this.h3.bqf_set(1, fc, 0.5411961, 0); this.h4.bqf_set(1, fc, 1.3065630, 0);
  this.p1.dsx_ap(fc, 0.5411961); this.p2.dsx_ap(fc, 1.3065630);
);
function dsx_run(x) instance(hi) (
  hi = this.h4.bq_run(this.h3.bq_run(this.h2.bq_run(this.h1.bq_run(x))));
  this.p2.bq_run(this.p1.bq_run(x));
);
function dsx_apr(x) ( this.p2.bq_run(this.p1.bq_run(x)); );

function vx_tab(d, a, b, c, e, f) local(p, i, t) (
  p = min(max(d, 0), 1) * 4; i = min(floor(p), 3); t = p - i;
  i == 0 ? a + (b - a) * t : i == 1 ? b + (c - b) * t : i == 2 ? c + (e - c) * t : e + (f - e) * t;
);
function op_mkup(lv) ( eng ? lv * (-3.215 + lv * (16.977 - 4.483 * lv)) : lv * (-3.677 + lv * (27.191 - 8.781 * lv)); );
function fet_mkup(a, rt) local(d) (
  d = a / 24;
  rt == 0 ? vx_tab(d, 0.08, 1.67, 3.43, 6.61, 10.65) : rt == 1 ? vx_tab(d, 0.09, 1.97, 3.95, 7.59, 12.2) :
  rt == 2 ? vx_tab(d, 0.09, 2.01, 3.93, 7.7, 12.53) : vx_tab(d, 0.1, 2.03, 3.86, 7.71, 12.72);
);

function chg(v) instance(l) ( v != l ? ( l = v; 1; ) : 0; );
function eqk(want) instance(ty, k) ( want != ty ? ( k = max(k - eq_kr, 0); k <= 0 ? ty = want; ) : k = min(k + eq_kr, 1); k; );
function vx_eq() local(lg, lf, lk, mg, mf, mq, hg, hf, hq, fg, ff, fk, q, g) (
  eq_kr = samplesblock / (0.02 * srate);
  lk = eLF.eqk(slider26 >= 0.5); fk = eHF.eqk(slider35 >= 0.5);
  lg = gd_lg.gl(slider24) * lk; lf = gd_lf.gl(slider25);
  mg = gd_mg.gl(slider27); mf = gd_mf.gl(slider28); mq = gd_mq.gl(slider29);
  hg = gd_hg.gl(slider30); hf = gd_hf.gl(slider31); hq = gd_hq.gl(slider32);
  fg = gd_fg.gl(slider33) * fk; ff = gd_ff.gl(slider34);
  vc_e1.chg(lg * 1.3 + lf * 0.0173 + eLF.ty * 7 + eng * 101) ? (
    q = eLF.ty ? ( !eng ? 0.6 : 0.6 + abs(lg) / 15 * 0.9 ) : ( !eng ? 0.55 : 0.9 );
    LP_.e1.bqf_set(eLF.ty ? 2 : 4, lf, q, lg); RP_.e1.bqf_set(eLF.ty ? 2 : 4, lf, q, lg);
  );
  vc_e2.chg(mg * 1.3 + mf * 0.0173 + mq * 7.1 + eng * 101) ? (
    q = !eng ? mq * 0.7 : mq * (0.6 + abs(mg) / 15 * 1.2);
    LP_.e2.bqf_set(2, mf, q, mg); RP_.e2.bqf_set(2, mf, q, mg);
  );
  vc_e3.chg(hg * 1.3 + hf * 0.0173 + hq * 7.1 + eng * 101) ? (
    q = !eng ? hq * 0.7 : hq * (0.6 + abs(hg) / 15 * 1.2);
    LP_.e3.bqf_set(2, hf, q, hg); RP_.e3.bqf_set(2, hf, q, hg);
  );
  vc_e4.chg(fg * 1.3 + ff * 0.0173 + eHF.ty * 7 + eng * 101) ? (
    eHF.ty ? ( q = !eng ? 0.6 : 0.6 + abs(fg) / 15 * 0.9; LP_.e4.bqf_set(2, ff, q, fg); RP_.e4.bqf_set(2, ff, q, fg); )
           : ( !eng ? ( q = 0.5; g = fg > 0 ? 0.85 * fg : fg; ) : ( q = 1.0; g = fg; );
               LP_.e4.bqf_set(3, ff, q, g); RP_.e4.bqf_set(3, ff, q, g); );
  );
  ls_on_t = slider17 >= 1.5;
  ls_on_t ? ls_want = min(max(slider17 | 0, 2), 5) - 1;
  ls_want != ls_ty && (ls_k <= 0 || ls_w < 0.000001) ? ( ls_ty = ls_want; LP_.lb.bqz(); RP_.lb.bqz(); vc_lb.l = -12345; );
  !ls_on_t && ls_w < 0.000001 ? ( LP_.lb.bqz(); RP_.lb.bqz(); );
  vc_lb.chg(ls_ty * 7 + lf * 0.0173 + mf * 0.0191 + mq * 3.1 + hf * 0.0137 + hq * 5.3 + ff * 0.0113 + eLF.ty * 11 + eHF.ty * 13) ? (
    ls_ty == 1 ? ( eLF.ty ? ( LP_.lb.bqf_set(5, lf, 0.7, 0); RP_.lb.bqf_set(5, lf, 0.7, 0); ) : ( LP_.lb.bqf_set(0, lf, 0.70710678, 0); RP_.lb.bqf_set(0, lf, 0.70710678, 0); ); ) :
    ls_ty == 2 ? ( LP_.lb.bqf_set(5, mf, mq, 0); RP_.lb.bqf_set(5, mf, mq, 0); ) :
    ls_ty == 3 ? ( LP_.lb.bqf_set(5, hf, hq, 0); RP_.lb.bqf_set(5, hf, hq, 0); ) :
    ( eHF.ty ? ( LP_.lb.bqf_set(5, ff, 0.7, 0); RP_.lb.bqf_set(5, ff, 0.7, 0); ) : ( LP_.lb.bqf_set(1, ff, 0.70710678, 0); RP_.lb.bqf_set(1, ff, 0.70710678, 0); ); );
  );
);

function vx_voice() local(d, w, s, f, q, g, k) (
  d = gd_pre.gl(slider7 / 100);
  pre_on_t = slider6 >= 0.5;
  !eng ? (
    pre_k = vx_db(-6 + 20 * d); pre_b = 0.15; pre_xa = 0.9 * d; pre_xd = 1.5 + 4 * d;
    PL.k.clp_set(2, 1, 1.3, 0); PR.k.clp_set(2, 1, 1.3, 0);
  ) : (
    pre_k = vx_db(-8 + 16 * d); pre_b = 0.05; pre_xa = 0.35 * d; pre_xd = 1 + 2 * d;
    PL.k.clp_set(2, 1.1, 1.1, 0); PR.k.clp_set(2, 1.1, 1.1, 0);
  );
  PL.pf.clp_pf_block(d, vx_fs, samplesblock * os_f); PR.pf.clp_pf_block(d, vx_fs, samplesblock * os_f);
  w = pkt.clp_kt_block(d, vx_fs, samplesblock * os_f); PL.k.clp_knee(w); PR.k.clp_knee(w);
  pre_mk_t = vx_db(!eng ? vx_tab(d, 0.02, 0.16, 0.65, 1.27, 1.8) : vx_tab(d, 0.01, 0.1, 0.26, 0.56, 1.16));
  pre_cb = PL.k.clp_crv(pre_b);
  pre_sl = pre_b <= PL.k.cp - w ? 1 : 1 - (pre_b - PL.k.cp + w) / (2 * w);
  PL.k.clp_tidy(); PR.k.clp_tidy();
  g = gd_pre.v;
  vc_pre.chg(g + 2 * eng) ? (
    !eng ? ( LP_.pe.bqf_set(2, 220, 0.7, 1.2 * g); RP_.pe.bqf_set(2, 220, 0.7, 1.2 * g); )
         : ( LP_.pe.bqf_set(2, 3000, 0.7, 0.6 * g); RP_.pe.bqf_set(2, 3000, 0.7, 0.6 * g); );
  );
  f = gd_hp.gl(slider8);
  vc_hp.chg(f) ? ( LP_.hp.bqf_set(1, f, 0.70710678, 0); RP_.hp.bqf_set(1, f, 0.70710678, 0); );
  g = gd_ls.gl(slider9);
  vc_ls.chg(g) ? ( LP_.ls.bqf_set(4, 150, 0.70710678, g); RP_.ls.bqf_set(4, 150, 0.70710678, g); );
  g = gd_hs.gl(slider59);
  vc_hs.chg(g) ? ( LP_.hs.bqf_set(3, 10000, 0.70710678, g); RP_.hs.bqf_set(3, 10000, 0.70710678, g); );
  s = gd_op.gl(slider11 / 100);
  !eng ? (
    op_thr = -4 - 36 * s; op_sl = 1 - 1 / 3.5; op_kn = 12;
    op_at = vx_kt(0.010); op_rf = vx_kt(0.08); op_as = vx_kt(0.4); op_rs = vx_kt(2.5); op_sw = 0.65;
  ) : (
    op_thr = -4 - 30 * s; op_sl = 1 - 1 / 2.5; op_kn = 8;
    op_at = vx_kt(0.008); op_rf = vx_kt(0.06); op_as = vx_kt(0.5); op_rs = vx_kt(1.5); op_sw = 0.5;
  );
  op_mk_t = vx_db(op_mkup(s) + slider12);
  op_lin = 10 ^ ((op_thr - 0.5 * op_kn - 3) / 10);
  f = gd_df.gl(slider14);
  vc_df.chg(f) ? ( LP_.ds.dsx_set(1.2 * f); RP_.ds.dsx_set(1.2 * f); );
  ds_thr = slider15; ds_rng = slider16; ds_lin = 10 ^ ((ds_thr - 3) / 20);
  k = gd_fa.gl(slider19);
  fet_rt = slider20 | 0;
  fet_sl = fet_rt == 0 ? 0.75 : fet_rt == 1 ? 0.875 : fet_rt == 2 ? 0.9167 : 0.95;
  fet_thr = -6 - k; fet_lin = 10 ^ ((fet_thr - 1.5) / 20);
  fet_ac = vx_kt(min(max(slider21, 20), 800) * 0.000001);
  fet_rc = vx_kt(min(max(slider22, 50), 1100) * 0.001);
  fet_mk_t = vx_db(fet_mkup(k, fet_rt));
  vx_eq();
  s = gd_sa.gl(slider36 / 100);
  sat_on_t = slider36 > 0.05;
  !eng ? (
    sat_k = vx_db(-8 + 22 * s); sat_b = 0;
    SL.k.clp_set(1, 1, 1, 0); SR.k.clp_set(1, 1, 1, 0);
  ) : (
    sat_k = vx_db(-8 + 18 * s); sat_b = 0.08;
    SL.k.clp_set(2, 1, 1.25, 0); SR.k.clp_set(2, 1, 1.25, 0);
  );
  SL.pf.clp_pf_block(s, vx_fs, samplesblock * os_f); SR.pf.clp_pf_block(s, vx_fs, samplesblock * os_f);
  w = skt.clp_kt_block(s, vx_fs, samplesblock * os_f); SL.k.clp_knee(w); SR.k.clp_knee(w);
  sat_mk_t = vx_db(!eng ? vx_tab(s, 0, 0.32, 0.78, 1.42, 2.33) : vx_tab(s, 0, 0.07, 0.24, 0.63, 1.31));
  sat_cb = SL.k.clp_crv(sat_b);
  sat_sl = eng ? ( sat_b <= 1 - w ? 1 : 1 - (sat_b - 1 + w) / (2 * w) ) : 1;
  SL.k.clp_tidy(); SR.k.clp_tidy();
  vc_sat.chg(s + 2 * eng) ? (
    !eng ? ( LP_.s1.bqf_set(2, 90, 0.9, 1.5 * s); RP_.s1.bqf_set(2, 90, 0.9, 1.5 * s);
             LP_.s2.bqf_set(3, 9000, 0.6, -2.5 * s); RP_.s2.bqf_set(3, 9000, 0.6, -2.5 * s); )
         : ( LP_.s1.bqf_set(2, 180, 0.8, 1.0 * s); RP_.s1.bqf_set(2, 180, 0.8, 1.0 * s);
             LP_.s2.bqf_set(3, 9000, 0.6, 0); RP_.s2.bqf_set(3, 9000, 0.6, 0); );
  );
  f = gd_sc.gl(slider64 >= 1.5 ? 220 : 110);
  vc_sch.chg(f) ? ( LP_.so.bqf_set(1, f, 0.70710678, 0); RP_.so.bqf_set(1, f, 0.70710678, 0); LP_.sf.bqf_set(1, f, 0.70710678, 0); RP_.sf.bqf_set(1, f, 0.70710678, 0); );
  out_t = vx_db(slider38) * (eng ? STORM_TRIM : 1);
);
function vx_model() (
  !eng ? (
    PL.pf.clp_pf_cfg(22000, 7500, -1.0, 80);  PR.pf.clp_pf_cfg(22000, 7500, -1.0, 80);  pkt.clp_kt_cfg(0.55, 1.0);
    SL.pf.clp_pf_cfg(22000, 9000, -1.5, 90);  SR.pf.clp_pf_cfg(22000, 9000, -1.5, 90);  skt.clp_kt_cfg(0.6, 1.0);
  ) : (
    PL.pf.clp_pf_cfg(22000, 12000, -2.0, 120); PR.pf.clp_pf_cfg(22000, 12000, -2.0, 120); pkt.clp_kt_cfg(0.5, 0.9);
    SL.pf.clp_pf_cfg(22000, 11000, -1.5, 100); SR.pf.clp_pf_cfg(22000, 11000, -1.5, 100); skt.clp_kt_cfg(0.5, 0.9);
  );
  pkt.kti = 0; skt.kti = 0;
  vc_sch.l = vc_lb.l = vc_pre.l = vc_sat.l = vc_e1.l = vc_e2.l = vc_e3.l = vc_e4.l = vc_hp.l = vc_ls.l = vc_hs.l = vc_df.l = -12345;
);

function st_lowcut() (
  vx_l = LP_.hp.bq_run(vx_l); vx_r = RP_.hp.bq_run(vx_r);
  vx_l = LP_.ls.bq_run(vx_l); vx_r = RP_.ls.bq_run(vx_r);
  vx_l = LP_.hs.bq_run(vx_l); vx_r = RP_.hs.bq_run(vx_r);
);
function st_eq() local(a, b, il, ir) (
  il = vx_l; ir = vx_r;
  eq_w += (eq_on_t - eq_w) * xs_c;
  eq_w > 0.000001 || eq_on_t ? (
    a = LP_.e4.bq_run(LP_.e3.bq_run(LP_.e2.bq_run(LP_.e1.bq_run(vx_l)))); b = RP_.e4.bq_run(RP_.e3.bq_run(RP_.e2.bq_run(RP_.e1.bq_run(vx_r))));
    vx_l += (a - vx_l) * eq_w; vx_r += (b - vx_r) * eq_w;
  );
  ls_w += (ls_on_t - ls_w) * xs_c;
  ls_w > 0.000001 || ls_on_t ? (
    ls_want != ls_ty ? ls_k = max(ls_k - ls_kr, 0) : ls_k = min(ls_k + ls_kr, 1);
    a = LP_.lb.bq_run(il) * ls_k; b = RP_.lb.bq_run(ir) * ls_k;
    vx_l += (a - vx_l) * ls_w; vx_r += (b - vx_r) * ls_w;
  );
);
function st_op() local(sc, t, e, g, a, b) (
  op_w += (op_on_t - op_w) * xs_c;
  op_w > 0.000001 || op_on_t ? (
    a = LP_.so.bq_run(vx_l); b = RP_.so.bq_run(vx_r);
    sc = max(abs(vx_l + (a - vx_l) * sch_w), abs(vx_r + (b - vx_r) * sch_w));
    op_ms += (sc * sc - op_ms) * op_dc;
    t = op_ms <= op_lin ? 0 : -op_sl * dy_curve(10 * log10(op_ms + 0.0000000001) + 3 - op_thr, op_kn);
    op_ef += (t - op_ef) * (t < op_ef ? op_at : op_rf);
    op_es += (t - op_es) * (t < op_es ? op_as : op_rs);
    e = min(op_ef, op_es * op_sw);
    op_mk += (op_mk_t - op_mk) * sm_c;
