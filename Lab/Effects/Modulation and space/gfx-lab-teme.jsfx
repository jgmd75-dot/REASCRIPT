function cv_val(idx, v) (
  idx == 2 ? ( v >= 1000 ? sprintf(#cv_vs, "%.2f s", v / 1000) : sprintf(#cv_vs, "%d ms", floor(v + 0.5)) ) :
  idx == 4 ? ( v5_part("1/16|1/8T|1/8|1/8D|1/4T|1/4|1/4D|1/2T|1/2|1/2D|1 BAR|2 BARS|4 BARS", floor(v + 0.5)); strcpy(#cv_vs, #v5_pt); ) :
  idx == 5 || idx == 10 || idx == 13 || idx == 19 || idx == 20 ? sprintf(#cv_vs, "%d %%", floor(v + 0.5)) :
  idx == 6 ? ( v < 1 ? sprintf(#cv_vs, "%.2f ms/s", v) : sprintf(#cv_vs, "%.1f ms/s", v) ) :
  idx == 11 || idx == 12 ? ( v >= 1000 ? sprintf(#cv_vs, "%.1f kHz", v / 1000) : sprintf(#cv_vs, "%d Hz", floor(v + 0.5)) ) :
  idx == 14 ? sprintf(#cv_vs, "%+.1f dB", v) :
  sprintf(#cv_vs, "%.1f", v);
  #cv_vs;
);
function cv_dial(cx, cy, r, idx, lo, hi, def, lg, cap, pc, lbl) local(n, fs, ly) (
