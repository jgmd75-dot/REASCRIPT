desc:Teme [phasing loop delay] (GFX Lab)
//tags: delay loop looper phasing phase tape canon repeat minimalist process
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-v5-palette, gfx-lab-sliders, gfx-lab-os (.jsfx-inc) in the same folder.

slider22:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1500<50,8000,1>-Loop time (ms)
slider3:0<0,1,1{Off,On}>-Tempo sync
slider4:10<0,12,1{1/16,1/8T,1/8,1/8D,1/4T,1/4,1/4D,1/2T,1/2,1/2D,1 bar,2 bars,4 bars}>-Loop note
slider5:100<0,100,1>-Repeats (%)
slider6:1<0.01,10,0.01>-Phase rate (ms per second)
slider7:0<0,2,1{2,4,8}>-Voices
slider8:0<0,7,1{Off,Every 1/2 loop,Every loop,Every 2 loops,Every 4 loops,Every 8 loops,Every 16 loops,Every 32 loops}>-Unfold
slider9:0<0,1,1{Off,On}>-Hold loop
slider10:100<0,100,1>-Width (%)
slider11:110<20,1100,1>-High-pass filter (Hz)
slider12:7700<1100,20000,1>-Low-pass filter (Hz)
slider13:50<0,100,1>-Mix (%)
slider14:0<-12,12,0.1>-Output (dB)
slider15:1<0,1,1{Off,On}>-(unused, was Drift)
slider16:0<0,3,1{Off,Align now,Spread now,Polar now}>-Place voices
slider17:prs_sel=0<0,13,1{No preset,Init,Two Machines,Slow Split,Eight Ways,Short Phrase,Bar Loop,Worn Loop,Close Canon,Wide Drift,Speech Loop,Fast Ripple,Long Tape,Space Loop}>-Preset
slider19:30<0,100,1>-Wow and flutter (%)
slider20:30<0,100,1>-Wear in hold (%)
slider21:0<0,1,1{Off,On}>-Space
slider23:165<50,400,1>-Space echo time (ms)
slider24:50<0,100,1>-Space echo feedback (%)
slider25:0<0,1,1{Off,On}>-Space tempo sync
slider26:5<0,9,1{1/32,1/16T,1/16,1/16D,1/8T,1/8,1/8D,1/4T,1/4,1/4D}>-Space echo note
slider27:50<0,100,1>-Space level (%)
slider28:50<0,100,1>-Space modulation (%)
slider29:0<0,12,0.1>-Detune left against right (cents)
slider30:0<0,100,1>-Tape machines (%)
slider31:0<0,2,1{1x,2x,4x}>-Oversampling

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-os.jsfx-inc

@init
function psw_all(v) ( slider_show(2147483647, v); );
function psw_allg(v) ( slider_show(2147483647, v); );
#ui_man = "gfx-lab-teme";
ext_noinit = 1;

TM_VO = 7600000; TM_EB = 6800000; TM_VS = 32; TM_ENV = 7601000; TM_VD = 7602000; TM_NS = 64; TM_PS = 7610000; TM_TQ = 7700000; TM_SM = 7700800; TM_DD = 7701000; TM_WQ = 7701400; TM_W2 = 15; TM_W4 = 17;

function tm_db2g(d) ( exp(d * 0.11512925465); );
function tm_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * srate)); );

function tq_m(i, drv, r, wk, asy, emp, bf, bg, bq, hf, hq) local(p) (
  p = TM_TQ + 600 + i * 12;
  p[0] = drv; p[1] = r; p[2] = wk; p[3] = asy; p[4] = emp; p[5] = bf; p[6] = bg; p[7] = bq; p[8] = hf; p[9] = hq; p[10] = asy / sqrt(1 + asy * asy);
);
tq_m(0, 1.3, 0.60, 0.50, 0.10, 5.0, 60, 2.5, 1.0, 14000, 0.62);
tq_m(1, 1.2, 0.50, 0.40, 0.06, 4.0, 70, 2.5, 1.2, 19000, 0.75);
tq_m(2, 1.0, 0.40, 0.30, 0.03, 3.0, 55, 2.0, 1.4, 21000, 0.80);
tq_m(3, 1.25, 0.55, 0.45, 0.07, 4.5, 50, 3.5, 1.0, 17000, 0.70);
tq_m(4, 1.15, 0.50, 0.40, 0.05, 4.0, 65, 2.5, 1.0, 17500, 0.70);
tq_m(5, 1.1, 0.45, 0.35, 0.05, 3.5, 75, 2.0, 1.3, 20000, 0.80);
tq_m(6, 0.95, 0.40, 0.30, 0.03, 3.0, 60, 2.0, 1.5, 21000, 0.75);
tq_m(7, 1.45, 0.55, 0.45, 0.08, 4.5, 80, 2.5, 1.1, 18000, 0.90);

function tq_s(u) ( u / sqrt(1 + u * u); );
function tq_cal(d, b) local(i, t, u, sb) (
  t = 0; i = 0; sb = tq_s(b);
  loop(32, u = d * 0.17783 * sin(2 * $pi * (i + 0.5) / 32); t += sqr(tq_s(u + b) - sb); i += 1; );
  sqrt(t / 32) / (d * 0.17783 * 0.70711);
);
function tq_run(k, ch, x) local(p, m, z, u, f, a, w, d, e) (
  p = TM_TQ + k * 64; m = TM_TQ + 600 + k * 12; z = p + 24 + ch * 20;
  z[0] += (x - z[0]) * tm_tqe; x += p[0] * (x - z[0]);
  u = x * p[20] + m[3]; f = sqrt(1 + u * u);
  a = u - z[16];
  x = (a > 0.00001 || a < -0.00001 ? (f - z[17]) / a : (u + z[16]) * 0.5 / sqrt(1 + sqr((u + z[16]) * 0.5))) - m[10];
  z[16] = u; z[17] = f;
  a = abs(x); z[19] = a > z[19] ? z[19] + (a - z[19]) * tm_tqka : z[19] * tm_tqkr; z[19] < 0.0000000001 ? z[19] = 0;
  w = m[2] * z[19] * z[19];
  w > 0.000001 ? ( d = min(max((x - z[18]) / w, -3), 3); e = d * d; z[18] = x - w * d * (27 + e) / (27 + 9 * e); ) : z[18] = x;
  x = (x + m[1] * (z[18] - x)) * p[21];
  z[1] += (x - z[1]) * tm_tqe; x += p[1] * (x - z[1]);
  z[2] += (x - z[2]) * p[2];
  z[2];
);
function tq_clr() local(k, z, m) (
  k = 0; loop(8, m = TM_TQ + 600 + k * 12;
    z = TM_TQ + k * 64 + 24; memset(z, 0, 40);
    z[16] = m[3]; z[17] = sqrt(1 + m[3] * m[3]); z[36] = m[3]; z[37] = z[17];
    k += 1; );
);

function tm_rd(o, d) local(p, i, t, a, b, c, e, m0, m1) (
  p = tm_w - d; i = floor(p); t = p - i;
  i < 0 ? i += tm_n;
  a = i - 1; a < 0 ? a += tm_n;
  b = i + 1; b >= tm_n ? b -= tm_n;
  c = b + 1; c >= tm_n ? c -= tm_n;
  e = o[i];
  t == 0 ? e : (
    m0 = (o[b] - o[a]) * 0.5; m1 = (o[c] - e) * 0.5;
    ((((m0 + m1 + 2 * (e - o[b])) * t) + (3 * (o[b] - e) - 2 * m0 - m1)) * t + m0) * t + e;
  );
);

function tm_beats(k) (
  k == 0 ? 0.25 : k == 1 ? 1 / 3 : k == 2 ? 0.5 : k == 3 ? 0.75 : k == 4 ? 2 / 3 : k == 5 ? 1 :
  k == 6 ? 1.5 : k == 7 ? 4 / 3 : k == 8 ? 2 : k == 9 ? 3 : k == 10 ? 4 : k == 11 ? 8 : 16;
);

function tm_setup() local(s, nv, k, j, mg, sd) (
  tm_byp = slider1 >= 0.5;
  tm_sync = slider3 >= 0.5;
  tm_sync ? (
    s = tm_beats(min(max(floor(slider4 + 0.5), 0), 12)) * 60 / max(tempo, 20);
    while (s > tm_lmax + 0.0001) ( s *= 0.5; );
  ) : s = min(max(slider2, 50), 8000) * 0.001;
  s = min(max(s, 0.05), tm_lmax);
  tm_lt = max(64, floor(s * srate + 0.5));
  tm_rep = min(max(slider5, 0), 100) / 100;
  tm_fbt = tm_rep >= 0.995 ? 1 : exp(-6.907755 / (1.5 * exp(6.2146 * tm_rep)));
  tm_rt = min(max(slider6, 0.01), 10) * 0.001;
  nv = min(max(floor(slider7 + 0.5), 0), 2);
  tm_nv = nv == 0 ? 2 : nv == 1 ? 4 : 8;
  tm_uf = slider8 >= 0.5;
  tm_ufn = 2 ^ (min(max(floor(slider8 + 0.5), 1), 7) - 2);
  tm_tpa = min(max(slider30, 0), 100) / 100;
  tm_tpa != tm_tpl || tm_tsr != srate * os_f ? (
    tm_tpl = tm_tpa; tm_tsr = srate * os_f;
    k = 0; loop(8, j = TM_TQ + 600 + k * 12; mg = TM_TQ + k * 64;
      sd = j[0] * tm_db2g(-6 + 24 * tm_tpa);
      mg[22] = sd; mg[23] = 1 / (sd * tq_cal(sd, j[3]));
      mg[0] = tm_db2g(j[4]) - 1; mg[1] = tm_db2g(-j[4]) - 1;
      mg[2] = 1 - exp(-2 * $pi * min(j[8], 0.45 * tm_tsr) / tm_tsr);
      mg[20] <= 0 ? ( mg[20] = mg[22]; mg[21] = mg[23]; );
      k += 1; );
  );
  tm_ht = slider9 >= 0.5;
  tm_wd = min(max(slider10, 0), 100) / 100;
  tm_lpc = 1 - exp(-2 * $pi * min(max(slider12, 1100), 20000) / srate);
  tm_hpc = 1 - exp(-2 * $pi * min(max(slider11, 20), 1100) / srate);
  tm_mixt = min(max(slider13, 0), 100) / 100;
  tm_outt = tm_db2g(min(max(slider14, -12), 12));
  tm_dft = 1;
  tm_wfa = min(max(slider19, 0), 100) / 100;
  tm_wa = min(max(slider20, 0), 100) / 100; tm_wa = tm_wa * sqrt(tm_wa);
  tm_spt = slider21 >= 0.5;
  slider25 >= 0.5 ? (
    k = min(max(floor(slider26 + 0.5), 0), 9);
    s = (k == 0 ? 0.125 : k == 1 ? 1 / 6 : k == 2 ? 0.25 : k == 3 ? 0.375 : k == 4 ? 1 / 3 : k == 5 ? 0.5 : k == 6 ? 0.75 : k == 7 ? 2 / 3 : k == 8 ? 1 : 1.5) * 60 / max(tempo, 20);
    while (s > 0.4001) ( s *= 0.5; ); while (s < 0.05) ( s *= 2; );
    tm_ett = s * srate;
  ) : tm_ett = min(max(slider23, 50), 400) * 0.001 * srate;
  tm_elvt = min(max(slider27, 0), 100) * 0.02;
  tm_emd = min(max(slider28, 0), 100) * 0.02;
  tm_dct = min(max(slider29, 0), 12);
  tm_efb = min(max(slider24, 0), 100) * 0.02;
  tm_et <= 0 || tm_esr != srate ? ( tm_et = tm_ett; tm_esr = srate; );
  s = tm_lc / srate;
  tm_klv = tm_db2g(-0.02 * tm_wa * s);
  tm_khf = min(0.5, 0.4 * tm_wa * s / 5.6);
  tm_kn = 0.012 * tm_wa * sqrt(s);
  tm_kdp = 0.6 * tm_wa * 16 / srate;
  k = 0;
  loop(8,
    j = floor(k / 2); mg = 1 - j * 2 / tm_nv; sd = k & 1 ? 1 : -1;
    TM_VO[k * TM_VS + 20] = sd * mg;
    TM_VO[k * TM_VS + 3] = k == 0 ? 0 : tm_rt * k * 2 / tm_nv;
    k += 1; );
);

function tm_vclr() local(k, o) (
  k = 0;
  loop(8, o = TM_VO + k * TM_VS;
    o[0] = o[1] = tm_lc; o[2] = 0; o[4] = k < 2 ? 1 : 0; o[5] = o[4]; o[9] = o[10] = o[11] = 0; o[12] = 1; o[13] = 0; o[18] = 0;
    o[14] = tm_lc; o[19] = k < 2; o[21] = 0; o[22] = 0;
    k += 1; );
);

function tm_clear() (
  memset(0, 0, 2 * tm_n);
  memset(TM_PS, 0, 2 * tm_pn + 8);
  memset(TM_ENV, 0, TM_NS);
  tm_lpl = tm_lpr = tm_hpl = tm_hpr = 0;
  tm_pk = 0; tm_ms = 0; tm_agc = 1; tm_agt = 1;
  tm_lp = 0;
  memset(TM_EB, 0, tm_en + 10 * floor(2200 * tm_rk + 8) + 64); memset(TM_VO + 310, 0, 20); tm_ss1 = tm_ss2 = 0;
  tm_elf = tm_ehf = tm_eg = 0; tm_sq2 = 10000000;
);

function tm_tqrate() local(f) (
  f = srate * os_f;
  tm_tqka = 1 - exp(-1 / (0.0005 * f)); tm_tqkr = exp(-1 / (0.08 * f)); tm_tqe = 1 - exp(-2 * $pi * 2400 / f);
  tm_tpl = -1;
);
function tm_vmix(k, a, b, j) local(m, sd, t) (
  tm_tpm > 0 && tm_wdc < 0.999 ? ( t = tq_run(k, 0, a); a += (t - a) * tm_tpm; t = tq_run(k, 1, b); b += (t - b) * tm_tpm; );
  m = (a + b) * 0.5; sd = (a - b) * 0.5 * (1 - tm_wdc);
  tm_tpm > 0 && tm_wdc >= 0.999 ? ( t = tq_run(k, 0, m); m += (t - m) * tm_tpm; );
  TM_SM[j * 2] += tm_g * (tm_o[23] * m + sd * 0.70710678); TM_SM[j * 2 + 1] += tm_g * (tm_o[24] * m - sd * 0.70710678);
);
function tm_osclr() (
  dnL.os_clr(); dnR.os_clr(); memset(TM_DD, 0, 400); memset(TM_WQ, 0, 400); memset(TM_SM, 0, 8); tq_clr();
);
function tm_srinit() local(k) (
  tm_sr = srate;
  tm_lmax = min(8, (3400000 / srate - 0.3) * 0.5);
  tm_n = floor((2 * tm_lmax + 0.25) * srate) + 16;
  tm_w = 0;
  tm_setup();
  tm_lc = tm_lt; tm_lpend = tm_lt; tm_lcnt = 0;
  tm_vclr();
  tm_clear();
  tm_xfs = 1 / (0.025 * srate);
  tm_ks = tm_tc(0.015);
  tm_kc = tm_tc(0.03); tm_ket = tm_tc(0.12);
  tm_pn = floor(0.08 * srate) + 4; tm_pw = floor(0.05 * srate); tm_pi = 0;
  tm_kdm = 1 - exp(-16 / (2 * srate)); tm_sdr1 = 16 * 2 * $pi * 0.021 / srate; tm_sdr2 = 16 * 2 * $pi * 0.013 / srate;
  tm_pkr = exp(-1 / (2 * srate)); tm_kms = tm_tc(0.8); tm_kad = tm_tc(0.25); tm_kau = tm_tc(1.5);
  tm_kg = 1 - exp(-16 / (0.05 * srate));
  tm_tqrate(); tq_clr();
  tm_kgu = 1 - exp(-16 / (0.9 * srate));
  tm_fis = 1 / (0.01 * srate);
  tm_wst = 0.0003 * srate;
  tm_ar = 1 - exp(-16 / (0.4 * srate));
  tm_ufc = 0;
  tm_en = floor(1.24 * srate) + 8;
  tm_rk = srate / 48000;
  k = 0; loop(10, TM_VO[300 + k] = floor((k == 0 ? 1427 : k == 1 ? 1781 : k == 2 ? 1973 : k == 3 ? 2099 : k == 4 ? 241 : k == 5 ? 83 : k == 6 ? 257 : k == 7 ? 431 : k == 8 ? 263 : 89) * tm_rk + 0.5); k += 1; );
  memset(TM_EB, 0, tm_en + 10 * floor(2200 * tm_rk + 8) + 64); tm_slc = 1 - exp(-2 * $pi * 2200 / srate);
  tm_ew = 0; tm_rw = 0;
  tm_whc = 1 - exp(-2 * $pi * 3300 / srate);
  tm_elp = 1 - exp(-2 * $pi * 2200 / srate); tm_ehp = 1 - exp(-2 * $pi * 120 / srate);
  tm_rd2 = 1 - exp(-2 * $pi * 2600 / srate);
  tm_wp1 = 2 * $pi * 0.62 / srate; tm_wp2 = 2 * $pi * 6.8 / srate;
);

function tm_prd(o, d) local(p, i, t, b, x0) (
  p = tm_pi - d; i = floor(p); t = p - i; i < 0 ? i += tm_pn; b = i + 1; b >= tm_pn ? b -= tm_pn;
  x0 = TM_PS[o + i]; x0 + (TM_PS[o + b] - x0) * t;
);
function tm_erd(d) local(p, i, t, b, x0) (
  p = tm_ew - d; i = floor(p); t = p - i; i < 0 ? i += tm_en; b = i + 1; b >= tm_en ? b -= tm_en;
  x0 = TM_EB[i]; x0 + (TM_EB[b] - x0) * t;
);
function tm_comb(k, x) local(o, n, i, y) (
  o = TM_EB + tm_en + 8 + k * floor(2200 * tm_rk + 8); n = TM_VO[300 + k];
  i = TM_VO[320 + k]; y = o[i];
  TM_VO[310 + k] += (y - TM_VO[310 + k]) * tm_rd2;
  o[i] = x + TM_VO[310 + k] * 0.8;
  y;
);
function tm_ap(k, x) local(o, n, i, y, v) (
  o = TM_EB + tm_en + 8 + k * floor(2200 * tm_rk + 8); n = TM_VO[300 + k];
  i = TM_VO[320 + k]; y = o[i]; v = x + y * 0.6; o[i] = v; y - v * 0.6;
);
function tm_jump(o, d) (
  o[1] = d; o[2] = 0.000001;
);

function tm_ctl() local(k, o, off, act, na, sw, gs, dn, wt, ws) (
  tm_sdm += ((tm_dft ? 1 : 0) - tm_sdm) * tm_kdm;
  tm_sdp1 += tm_sdr1; tm_sdp1 > 2 * $pi ? tm_sdp1 -= 2 * $pi;
  tm_sdp2 += tm_sdr2; tm_sdp2 > 2 * $pi ? tm_sdp2 -= 2 * $pi;
  tm_etx = tm_ett * (1 + 0.07 * tm_sdm * sin(tm_sdp1));
  tm_efx = max(0, tm_efb + 0.16 * tm_sdm * sin(tm_sdp2 + 1.3));
  tm_lt != tm_lpend ? ( tm_lpend = tm_lt; tm_lcnt = 0; ) : tm_lcnt < 100000 ? tm_lcnt += 16;
  tm_lnew = tm_lpend != tm_lc && tm_lcnt >= 0.06 * srate;
  tm_lnew ? ( tm_lold = tm_lc; tm_lc = tm_lpend; tm_lchg = 1; );
  tm_uf ? ( tm_ufc += 16; ) : tm_ufc = 0;
  tm_ufs = tm_ufn * tm_lc;
  tm_tpm == 0 && tm_tpa > 0 ? tq_clr();
  tm_tpm += ((tm_tpa > 0 ? 1 : 0) - tm_tpm) * tm_kg; abs(tm_tpm - (tm_tpa > 0)) < 0.0001 ? tm_tpm = tm_tpa > 0;
  na = 0; sw = 0;
  k = 0;
  loop(8, o = TM_VO + k * TM_VS;
    act = k < tm_nv && (k < 2 || !tm_uf || tm_ufc >= (k - 1) * tm_ufs);
    act && !o[19] ? (
      o[0] = TM_VO[(k - 1) * TM_VS + (TM_VO[(k - 1) * TM_VS + 2] > 0 ? 1 : 0)];
      o[2] = 0; o[14] = tm_lc; o[21] = tm_algn; o[19] = 1;
    );
    !act && o[19] && o[4] < 0.0001 ? o[19] = 0;
    o[5] = act ? 1 : 0;
    o[5] > o[4] ? o[4] += (o[5] - o[4]) * (tm_uf && k >= 2 ? tm_kgu : tm_kg) : o[4] += (o[5] - o[4]) * tm_kg;
    abs(o[5] - o[4]) < 0.0001 ? o[4] = o[5];
    sw += o[4] * o[4]; o[4] > 0 ? na += 1;
    o[19] && o[2] == 0 ? (
      o[14] != tm_lc ? (
        off = o[0] - o[14]; off = off - floor(off / tm_lc) * tm_lc; k == 0 ? off = 0;
        o[14] = tm_lc; tm_jump(o, tm_lc + off);
      ) : o[21] != tm_algn ? (
        o[21] = tm_algn; k > 0 ? tm_jump(o, tm_lc + floor((tm_amd == 2 ? k / tm_nv : tm_amd == 3 ? (k & 1) * 0.5 : 0) * tm_lc));
      ) : o[0] - tm_lc >= tm_lc ? (
        tm_jump(o, o[0] - tm_lc);
      );
    );
    o = TM_TQ + k * 64; o[20] += (o[22] - o[20]) * tm_kg; o[21] += (o[23] - o[21]) * tm_kg;
    o = TM_VO + k * TM_VS;
    o[25] += 16 * tm_wp1 * (1 + 0.11 * k); o[25] > 2 * $pi ? o[25] -= 2 * $pi;
    o[26] += 16 * tm_wp2 * (1 + 0.07 * k); o[26] > 2 * $pi ? o[26] -= 2 * $pi;
    ws = tm_wfa * srate * (0.0011 * sin(o[25] + k * 1.7) + 0.00006 * sin(o[26] + k * 2.3));
    k > 0 ? (
      tm_dft ? (
        o[12] += o[13];
        o[12] >= 1 ? ( o[12] -= 1; o[10] = o[11]; o[11] = (rand(1) * 2 - 1) * tm_wst; o[13] = 16 * (0.25 + rand(1) * 0.5) / srate; );
        wt = o[10] + (o[11] - o[10]) * (0.5 - 0.5 * cos($pi * o[12]));
      ) : wt = 0;
    ) : wt = 0;
    o[18] = (wt + ws - o[9]) / 16;
    k += 1; );
  tm_ht && tm_h >= 1 ? tm_hage += 16 / srate : !tm_ht ? tm_hage = 0;
  tm_pk > 0.35 ? tm_agt = 0.35 / tm_pk : tm_agt = 1;
  tm_ms > 0.01 ? tm_agt = min(tm_agt, 0.1 / sqrt(tm_ms));
  !tm_slp ? (
