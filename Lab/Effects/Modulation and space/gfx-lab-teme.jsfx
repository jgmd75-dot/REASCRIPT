desc:Teme [phasing loop delay] (GFX Lab)
//tags: delay loop looper phasing phase tape canon repeat minimalist process
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-v5-palette, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider22:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1500<50,8000,1>-Loop time (ms)
slider3:0<0,1,1{Off,On}>-Tempo sync
slider4:10<0,12,1{1/16,1/8T,1/8,1/8D,1/4T,1/4,1/4D,1/2T,1/2,1/2D,1 bar,2 bars,4 bars}>-Loop note
slider5:80<0,100,1>-Repeats (%)
slider6:1<0.01,10,0.01>-Phase rate (ms per second)
slider7:0<0,2,1{2,4,8}>-Voices
slider8:0<0,1,1{Off,On}>-Unfold
slider9:0<0,1,1{Off,On}>-Hold loop
slider10:100<0,100,1>-Width (%)
slider11:110<20,1100,1>-Low cut (Hz)
slider12:7700<1100,20000,1>-High cut (Hz)
slider13:50<0,100,1>-Mix (%)
slider14:0<-12,12,0.1>-Output (dB)
slider15:1<0,1,1{Off,On}>-Drift
slider16:0<0,1,1{Off,Align now}>-Align voices
slider17:prs_sel=0<0,13,1{No preset,Init,Two Machines,Slow Split,Eight Ways,Short Phrase,Bar Loop,Worn Loop,Close Canon,Wide Drift,Speech Loop,Fast Ripple,Long Tape,Space Loop}>-Preset
slider19:30<0,100,1>-Wow and flutter (%)
slider20:30<0,100,1>-Wear in hold (%)
slider21:0<0,1,1{Off,On}>-Space

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4194303, v); );
function psw_allg(v) ( slider_show(4194303, v); );
#ui_man = "gfx-lab-teme";
ext_noinit = 1;

TM_VO = 7600000; TM_EB = 6800000; TM_VS = 32; TM_ENV = 7601000; TM_VD = 7602000; TM_NS = 64;

function tm_db2g(d) ( exp(d * 0.11512925465); );
function tm_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * srate)); );

function tm_rd(o, d) local(p, i, t, a, b, c, e, m0, m1) (
  p = tm_w - d; i = floor(p); t = p - i;
  i < 0 ? i += tm_n;
  a = i - 1; a < 0 ? a += tm_n;
  b = i + 1; b >= tm_n ? b -= tm_n;
  c = b + 1; c >= tm_n ? c -= tm_n;
  e = o[i];
  t == 0 ? e : (
    m0 = (o[b] - o[a]) * 0.5; m1 = (o[c] - e) * 0.5;
    ((((m0 + m1 + 2 * (e - o[b])) * t) + (3 * (o[b] - e) - 2 * m0 - m1)) * t + m0) * t + e;
  );
);

function tm_beats(k) (
  k == 0 ? 0.25 : k == 1 ? 1 / 3 : k == 2 ? 0.5 : k == 3 ? 0.75 : k == 4 ? 2 / 3 : k == 5 ? 1 :
  k == 6 ? 1.5 : k == 7 ? 4 / 3 : k == 8 ? 2 : k == 9 ? 3 : k == 10 ? 4 : k == 11 ? 8 : 16;
);

function tm_setup() local(s, nv, k, j, mg, sd) (
  tm_byp = slider1 >= 0.5;
  tm_sync = slider3 >= 0.5;
  tm_sync ? (
    s = tm_beats(min(max(floor(slider4 + 0.5), 0), 12)) * 60 / max(tempo, 20);
    while (s > tm_lmax + 0.0001) ( s *= 0.5; );
  ) : s = min(max(slider2, 50), 8000) * 0.001;
  s = min(max(s, 0.05), tm_lmax);
  tm_lt = max(64, floor(s * srate + 0.5));
  tm_rep = min(max(slider5, 0), 100) / 100;
  tm_fbt = tm_rep * 0.995;
  tm_rt = min(max(slider6, 0.01), 10) * 0.001;
  nv = min(max(floor(slider7 + 0.5), 0), 2);
  tm_nv = nv == 0 ? 2 : nv == 1 ? 4 : 8;
  tm_uf = slider8 >= 0.5;
  tm_ht = slider9 >= 0.5;
  tm_wd = min(max(slider10, 0), 100) / 100;
  tm_lpc = 1 - exp(-2 * $pi * min(max(slider12, 1100), 20000) / srate);
  tm_hpc = 1 - exp(-2 * $pi * min(max(slider11, 20), 1100) / srate);
  tm_mixt = min(max(slider13, 0), 100) / 100;
  tm_outt = tm_db2g(min(max(slider14, -12), 12));
  tm_dft = slider15 >= 0.5;
  tm_wfa = min(max(slider19, 0), 100) / 100;
  tm_wa = min(max(slider20, 0), 100) / 100; tm_wa = tm_wa * sqrt(tm_wa);
  tm_spt = slider21 >= 0.5;
  s = tm_lc / srate;
  tm_klv = tm_db2g(-0.1 * tm_wa * s);
  tm_khf = min(0.5, 0.4 * tm_wa * s / 5.6);
  tm_kn = 0.012 * tm_wa * sqrt(s);
  tm_kdp = 0.6 * tm_wa * 16 / srate;
  k = 0;
  loop(8,
    j = floor(k / 2); mg = 1 - j * 2 / tm_nv; sd = k & 1 ? 1 : -1;
    TM_VO[k * TM_VS + 20] = sd * mg;
    TM_VO[k * TM_VS + 3] = k == 0 ? 0 : tm_rt * k * 2 / tm_nv;
    k += 1; );
);

function tm_vclr() local(k, o) (
  k = 0;
  loop(8, o = TM_VO + k * TM_VS;
    o[0] = o[1] = tm_lc; o[2] = 0; o[4] = k < 2 ? 1 : 0; o[5] = o[4]; o[9] = o[10] = o[11] = 0; o[12] = 1; o[13] = 0; o[18] = 0;
    o[14] = tm_lc; o[19] = k < 2; o[21] = 0; o[22] = 0;
    k += 1; );
);

function tm_clear() (
  memset(0, 0, 2 * tm_n);
  memset(TM_ENV, 0, TM_NS);
  tm_lpl = tm_lpr = tm_hpl = tm_hpr = 0;
  tm_pk = 0; tm_agc = 1;
  tm_lp = 0;
  memset(TM_EB, 0, tm_en + 10 * floor(2200 * tm_rk + 8) + 64); memset(TM_VO + 310, 0, 20); tm_ss1 = tm_ss2 = 0;
  tm_elf = tm_ehf = tm_eg = 0; tm_sq2 = 10000000;
);

function tm_srinit() local(k) (
  tm_sr = srate;
  tm_lmax = min(8, (3400000 / srate - 0.3) * 0.5);
  tm_n = floor((2 * tm_lmax + 0.25) * srate) + 16;
  tm_w = 0;
  tm_setup();
  tm_lc = tm_lt; tm_lpend = tm_lt; tm_lcnt = 0;
  tm_vclr();
  tm_clear();
  tm_xfs = 1 / (0.025 * srate);
  tm_ks = tm_tc(0.015);
  tm_kc = tm_tc(0.03);
  tm_kg = 1 - exp(-16 / (0.05 * srate));
  tm_kgu = 1 - exp(-16 / (0.9 * srate));
  tm_fis = 1 / (0.01 * srate);
  tm_wst = 0.0003 * srate;
  tm_ar = 1 - exp(-16 / (0.4 * srate));
  tm_ufc = 0;
  tm_en = floor(0.56 * srate) + 8;
  tm_rk = srate / 48000;
  k = 0; loop(10, TM_VO[300 + k] = floor((k == 0 ? 1427 : k == 1 ? 1781 : k == 2 ? 1973 : k == 3 ? 2099 : k == 4 ? 241 : k == 5 ? 83 : k == 6 ? 257 : k == 7 ? 431 : k == 8 ? 263 : 89) * tm_rk + 0.5); k += 1; );
  memset(TM_EB, 0, tm_en + 10 * floor(2200 * tm_rk + 8) + 64); tm_slc = 1 - exp(-2 * $pi * 2200 / srate);
  tm_ew = 0; tm_rw = 0;
  tm_whc = 1 - exp(-2 * $pi * 3300 / srate);
  tm_elp = 1 - exp(-2 * $pi * 2200 / srate); tm_ehp = 1 - exp(-2 * $pi * 120 / srate);
  tm_rd2 = 1 - exp(-2 * $pi * 2600 / srate);
  tm_wp1 = 2 * $pi * 0.62 / srate; tm_wp2 = 2 * $pi * 6.8 / srate;
);

function tm_erd(d) local(p, i, t, b, x0) (
  p = tm_ew - d; i = floor(p); t = p - i; i < 0 ? i += tm_en; b = i + 1; b >= tm_en ? b -= tm_en;
  x0 = TM_EB[i]; x0 + (TM_EB[b] - x0) * t;
);
function tm_comb(k, x) local(o, n, i, y) (
  o = TM_EB + tm_en + 8 + k * floor(2200 * tm_rk + 8); n = TM_VO[300 + k];
  i = TM_VO[320 + k]; y = o[i];
  TM_VO[310 + k] += (y - TM_VO[310 + k]) * tm_rd2;
  o[i] = x + TM_VO[310 + k] * 0.8;
  y;
);
function tm_ap(k, x) local(o, n, i, y, v) (
  o = TM_EB + tm_en + 8 + k * floor(2200 * tm_rk + 8); n = TM_VO[300 + k];
  i = TM_VO[320 + k]; y = o[i]; v = x + y * 0.6; o[i] = v; y - v * 0.6;
);
function tm_jump(o, d) (
  o[1] = d; o[2] = 0.000001;
);

function tm_ctl() local(k, o, off, act, na, sw, gs, dn, wt, ws) (
  tm_lt != tm_lpend ? ( tm_lpend = tm_lt; tm_lcnt = 0; ) : tm_lcnt < 100000 ? tm_lcnt += 16;
  tm_lnew = tm_lpend != tm_lc && tm_lcnt >= 0.06 * srate;
  tm_lnew ? ( tm_lold = tm_lc; tm_lc = tm_lpend; tm_lchg = 1; );
  tm_uf ? ( tm_ufc += 16; ) : tm_ufc = 0;
  tm_ufs = 4 * tm_lc;
  na = 0; sw = 0;
  k = 0;
  loop(8, o = TM_VO + k * TM_VS;
    act = k < tm_nv && (k < 2 || !tm_uf || tm_ufc >= (k - 1) * tm_ufs);
    act && !o[19] ? (
      o[0] = TM_VO[(k - 1) * TM_VS + (TM_VO[(k - 1) * TM_VS + 2] > 0 ? 1 : 0)];
      o[2] = 0; o[14] = tm_lc; o[21] = tm_algn; o[19] = 1;
    );
    !act && o[19] && o[4] < 0.0001 ? o[19] = 0;
    o[5] = act ? 1 : 0;
    o[5] > o[4] ? o[4] += (o[5] - o[4]) * (tm_uf && k >= 2 ? tm_kgu : tm_kg) : o[4] += (o[5] - o[4]) * tm_kg;
    abs(o[5] - o[4]) < 0.0001 ? o[4] = o[5];
    sw += o[4] * o[4]; o[4] > 0 ? na += 1;
    o[19] && o[2] == 0 ? (
      o[14] != tm_lc ? (
        off = o[0] - o[14]; off = off - floor(off / tm_lc) * tm_lc; k == 0 ? off = 0;
        o[14] = tm_lc; tm_jump(o, tm_lc + off);
      ) : o[21] != tm_algn ? (
        o[21] = tm_algn; k > 0 ? tm_jump(o, tm_lc);
      ) : o[0] - tm_lc >= tm_lc ? (
        tm_jump(o, o[0] - tm_lc);
      );
    );
    o[25] += 16 * tm_wp1 * (1 + 0.11 * k); o[25] > 2 * $pi ? o[25] -= 2 * $pi;
    o[26] += 16 * tm_wp2 * (1 + 0.07 * k); o[26] > 2 * $pi ? o[26] -= 2 * $pi;
    ws = tm_wfa * srate * (0.0011 * sin(o[25] + k * 1.7) + 0.00006 * sin(o[26] + k * 2.3));
    k > 0 ? (
      tm_dft ? (
        o[12] += o[13];
        o[12] >= 1 ? ( o[12] -= 1; o[10] = o[11]; o[11] = (rand(1) * 2 - 1) * tm_wst; o[13] = 16 * (0.25 + rand(1) * 0.5) / srate; );
        wt = o[10] + (o[11] - o[10]) * (0.5 - 0.5 * cos($pi * o[12]));
      ) : wt = 0;
    ) : wt = 0;
    o[18] = (wt + ws - o[9]) / 16;
    k += 1; );
  tm_ht && tm_h >= 1 ? (
    tm_age += 16 / srate;
    tm_dpn <= 0 && rand(1) < tm_kdp ? (
      tm_dpn = floor((0.004 + rand(1) * 0.021) * srate); tm_dpt = tm_dpn;
      tm_dpd = (0.08 + rand(1) * 0.3) * min(1, 0.3 + tm_age / 120);
    );
  ) : !tm_ht ? tm_age = 0;
  tm_gn = 1 / sqrt(max(sw, 1));
  tm_ng += (tm_gn - tm_ng) * tm_kg;
);

tm_algn = 0; tm_ng = 0.70710678;
tm_srinit();
tm_mix = tm_mixt; tm_out = tm_outt; tm_h = tm_ht; tm_fb = tm_fbt; tm_wdc = tm_wd;
tm_fi = 1; tm_cc = 0; tm_sq = 0;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init(); ost_setup(0, 0, 110, 6600, -0.3, 1);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(1);
pwr_init(); pwr_hum_db = -83; pwr_wu_loss = 0.3; pwr_wu_drv = 0.2; pwr_wu_lp = 15000; pwr_wu_wob = 0.08; pwr_bloom = 0;

function tm_p(ms, rp, ph, nv, uf, wd, lc, hc, mx, df) (
  slider19 = 30; slider20 = 30; slider21 = 0;
  slider2 = ms; slider5 = rp; slider6 = ph; slider7 = nv; slider8 = uf; slider10 = wd;
  slider11 = lc; slider12 = hc; slider13 = mx; slider15 = df;
);
function load_preset(p) (
  slider3 = 0; slider4 = 10; slider14 = 0; slider16 = 0;
  tm_p(1500, 80, 1, 0, 0, 100, 110, 7700, 50, 1);
  p == 2 ? ( tm_p(1200, 90, 2, 0, 0, 100, 110, 9900, 60, 1); ) :
  p == 3 ? ( tm_p(1800, 85, 0.6, 1, 1, 100, 110, 7700, 55, 1); ) :
  p == 4 ? ( tm_p(1500, 85, 1.5, 2, 1, 100, 110, 6600, 60, 1); ) :
  p == 5 ? ( tm_p(600, 80, 4, 0, 0, 90, 220, 8800, 50, 1); ) :
  p == 6 ? ( tm_p(2000, 85, 1, 0, 0, 100, 110, 9900, 50, 1); slider3 = 1; slider4 = 10; ) :
  p == 7 ? ( tm_p(1400, 95, 1.2, 1, 0, 80, 330, 3300, 55, 1); ) :
  p == 8 ? ( tm_p(1000, 85, 0.2, 0, 0, 60, 110, 7700, 50, 0); ) :
  p == 9 ? ( tm_p(1600, 85, 3, 1, 0, 100, 110, 7700, 60, 1); ) :
  p == 10 ? ( tm_p(800, 100, 1.5, 0, 0, 100, 220, 5500, 65, 1); ) :
  p == 11 ? ( tm_p(400, 70, 10, 2, 0, 100, 110, 9900, 45, 1); ) :
  p == 12 ? ( tm_p(8000, 90, 0.5, 1, 1, 100, 110, 6600, 55, 1); slider20 = 15; ) :
  p == 13 ? ( tm_p(1300, 85, 1.2, 1, 0, 100, 110, 7700, 55, 1); slider19 = 45; slider21 = 1; );
  p == 7 ? ( slider19 = 60; slider20 = 70; );
  p == 8 ? ( slider19 = 10; );
  p == 11 ? ( slider19 = 15; );
  slider_automate(1900542);
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(21, i != 16 && i != 17 && i != 18 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); tm_setup();
      prs_q ? ( k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
tm_setup();
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();
tm_sv = slider9 >= 0.5 && tm_lc > 0 && tm_lc <= tm_n * 0.5;
file_avail(0) != 0 ? file_var(0, tm_sv) : tm_sv = 0;
tm_sv ? (
  file_avail(0) >= 0 ? (
    tm_sl = tm_lc; file_var(0, tm_sl); tm_sk = 0;
    loop(8, file_var(0, TM_VO[tm_sk * TM_VS]); file_var(0, TM_VO[tm_sk * TM_VS + 19]); tm_sk += 1; );
    file_var(0, tm_ufc);
    tm_si = tm_w - tm_sl; tm_si < 0 ? tm_si += tm_n;
    loop(tm_sl, file_var(0, tm_si[0]); file_var(0, tm_si[tm_n]); tm_si += 1; tm_si >= tm_n ? tm_si = 0; );
  ) : (
    file_var(0, tm_sl); tm_sl = min(max(floor(tm_sl), 64), floor(tm_n * 0.5) - 8);
    tm_sk = 0;
    loop(8, file_var(0, tm_sv0); file_var(0, tm_sv1);
      TM_VO[tm_sk * TM_VS] = TM_VO[tm_sk * TM_VS + 1] = max(tm_sl, min(tm_sv0, 2 * tm_sl - 1));
      TM_VO[tm_sk * TM_VS + 2] = 0; TM_VO[tm_sk * TM_VS + 14] = tm_sl; TM_VO[tm_sk * TM_VS + 21] = tm_algn;
      TM_VO[tm_sk * TM_VS + 19] = tm_sv1 > 0.5; TM_VO[tm_sk * TM_VS + 4] = TM_VO[tm_sk * TM_VS + 5] = tm_sv1 > 0.5;
      tm_sk += 1; );
    file_var(0, tm_ufc);
    memset(0, 0, 2 * tm_n);
    tm_si = 0;
    loop(tm_sl, file_var(0, tm_sv0); file_var(0, tm_sv1); tm_si[0] = tm_si[tm_sl] = tm_sv0; tm_si[tm_n] = tm_si[tm_n + tm_sl] = tm_sv1;
      tm_sj = tm_n - tm_sl + tm_si; tm_sj >= 2 * tm_sl ? ( tm_sj[0] = tm_sv0; tm_sj[tm_n] = tm_sv1; ); tm_si += 1; );
    tm_w = 2 * tm_sl; tm_lc = tm_lpend = tm_sl; tm_lcnt = 0; tm_lp = 0; tm_h = 1; tm_sq = 0;
  );
);

@block
prs_chk();
srate != tm_sr ? tm_srinit();
slider16 >= 0.5 ? ( tm_algn += 1; tm_ufc = 0; slider16 = 0; slider_automate(slider16); );
tm_al_dirty ? ( tm_algn += 1; tm_ufc = 0; tm_al_dirty = 0; );
tm_now = time_precise();
tm_tp > 0 && tm_now - tm_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > tm_gpp && play_position - tm_gpp < 4 * tm_gpd + 0.05) ? (
  slider9 < 0.5 ? ( tm_clear(); tm_vclr(); tm_ufc = 0; );
  tm_fi = 0; memset(BY_BUF, 0, 2 * BY_N);
);
tm_tp = tm_now; tm_gpp = play_position; tm_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
tm_setup();
ost_setup(0, 0, 110, 6600, -0.3, 1);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
abs(tm_lpl) < 0.000000000001 ? tm_lpl = 0; abs(tm_lpr) < 0.000000000001 ? tm_lpr = 0;
abs(tm_hpl) < 0.000000000001 ? tm_hpl = 0; abs(tm_hpr) < 0.000000000001 ? tm_hpr = 0;
tm_k = 0; loop(8, TM_VD[tm_k] = (TM_VO[tm_k * TM_VS] - tm_lc) / max(tm_lc, 1); TM_VD[8 + tm_k] = TM_VO[tm_k * TM_VS + 4]; tm_k += 1; );
tm_age_d = tm_age; tm_lp_d = tm_lp / max(tm_lc, 1); tm_lc_d = tm_lc; tm_slp_d = tm_slp;
tm_ml_d = max(tm_ml_d, tm_mlm); tm_mr_d = max(tm_mr_d, tm_mrm); tm_mlm = tm_mrm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
tm_xl = spl0; tm_xr = spl1;
max(abs(tm_xl), abs(tm_xr)) > 0.000000000001 || tm_wo > 0.000000000001 || tm_so > 0.000000000001 || tm_lnew || prs_gs != 0 || tm_fi < 1 || pwr_act ? tm_sq = 0 : tm_sq < 100000000 ? tm_sq += 1;
tm_cc == 0 ? tm_ctl();
tm_cc = (tm_cc + 1) & 15;
tm_slp = tm_sq > 2 * tm_lc + 0.5 * srate;
tm_slp ? (
  tm_w[0] = 0; tm_w[tm_n] = 0;
  tm_w += 1; tm_w >= tm_n ? tm_w = 0;
  tm_lp += 1; tm_lp >= tm_lc ? tm_lp = 0;
