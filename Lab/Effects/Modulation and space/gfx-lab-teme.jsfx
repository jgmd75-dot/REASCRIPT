  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(hv ? 0x1C1E1D : 0x141615); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.45); v5_r(x + 1, y + 1, w - 2, 2); v5_r(x + 1, y + 1, 2, h - 2);
  ui_cola(0xFFFFFF, 0.06); v5_r(x + 2, y + h - 1, w - 3, 1);
  gx = x + 7;
  ui_col(0x050606); v5_rr(gx, y + 5, 7, h - 10, 3.5);
  on ? ( ui_cola(v5_led, 0.25); v5_rr(gx - 3, y + 3, 13, h - 6, 5); ui_col(v5_led); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); )
     : ( ui_col(ui_mix(v5_led, 0x0A0B0B, 0.75)); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); );
  gfx_setfont(v5_fk); ui_col(on ? 0xF6F8F4 : 0xA8ACA6); v5_t((gx + 11 + x + w - 4) * 0.5, y + h * 0.5 + 0.5, lg);
);
function cv_lp(x, y, w, h, idx, lg) local(on) (
  on = v5_toggle(idx, v5_hit(x, y, w, h));
  cv_rk(x, y, w, h, on, lg);
);
function cv_sel(x, y, w, h, gap, idx, n, labels) local(k, kx, cur) (
  cur = floor(slider(idx) + 0.5); k = 0;
  loop(n, kx = x + k * (w + gap);
    v5_pr && v5_drag == 0 && v5_hit(kx, y, w, h) && cur != k ? ( slider(idx) = k; ui_auto(idx); cur = k; v5_drag = -1; );
    v5_part(labels, k); cv_rk(kx, y, w, h, k == cur, #v5_pt);
    k += 1; );
);
function cv_wash(x, y, w, h) ( ui_cola(CVW, 0.55); v5_r(x, y, w, h); );
function cv_led(x, y, on, c) (
  ui_col(0x050606); v5_sd(x, y, 3.6);
  on ? ( ui_cola(c, 0.28); v5_d(x, y, 6); ui_col(c); v5_sd(x, y, 2.8); ui_cola(0xFFFFFF, 0.55); v5_d(x - 0.8, y - 0.8, 0.8); )
     : ( ui_col(ui_mix(c, 0x0A0B0B, 0.78)); v5_sd(x, y, 2.8); );
);
function cv_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
