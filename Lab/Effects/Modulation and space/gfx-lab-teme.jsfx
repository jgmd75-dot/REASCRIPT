function cv_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * cv_kt * sc, 'b'); );
function cv_fa(px) ( gfx_setfont(10, "Arial", px * cv_ka * sc, 'b'); );
function cv_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function cv_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
