function e_r(x, y, w, h) local(x0, y0, x1, y1) (
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  gfx_rect(x0, y0, max(1, x1 - x0), max(1, y1 - y0));
);
function e_fr(x, y, w, h, t) ( e_r(x, y, w, t); e_r(x, y + h - t, w, t); e_r(x, y + t, t, h - 2 * t); e_r(x + w - t, y + t, t, h - 2 * t); );
function e_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function e_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function e_txt(x, cy, s, al) local(tw, th) (
  gfx_measurestr(s, tw, th);
  gfx_x = al == 1 ? x * sc - tw * 0.5 : al == 2 ? x * sc - tw : x * sc; gfx_y = cy * sc - th * 0.5;
  gfx_drawstr(s);
);
function e_hit(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function e_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function e_grp(x, y, w, h, s) local(ty, tw) (
  ty = y + 8; ui_col(e_ink); e_fr(x, ty, w, h - 8, 2);
  tw = e_tw(s); ui_col(e_win); e_r(x + 10, y, tw + 12, 16); ui_col(e_ink); e_txt(x + 16, ty, s, 0);
);
function e_static() local(x, y, w, h, tb, yy, xx, rw, tw) (
