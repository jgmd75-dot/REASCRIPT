desc:Detach Delay [delay] (GFX Lab)
//tags: delay echo tape ping-pong reverb shimmer chorus compressor
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power, gfx-lab-sliders, gfx-lab-sidebar (.jsfx-inc) in the same folder.

slider31:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Pad (sidebar)
slider2:0<0,24,0.1>-Drive (dB)
slider3:20<20,1000,1>-HPF (Hz)
slider4:20000<1000,20000,1>-LPF (Hz)
slider5:375<10,2000,1>-Time (ms)
slider6:1<0,1,1{Off,On}>-Sync
slider7:6<0,12,1{1/32,1/16T,1/16,1/16D,1/8T,1/8,1/8D,1/4T,1/4,1/4D,1/2,1/2D,1/1}>-Note
slider8:0<-100,100,1>-Feel (%)
slider9:20<0,100,1>-Delay drive (%)
slider10:40<0,100,1>-Feedback (%)
slider11:30<0,100,1>-Delay mix (%)
slider12:0<0,1,1{Off,On}>-Delay EQ
slider13:1<0,1,1{Off,On}>-Ping-pong
slider14:2<0,3,1{Off,Room,Hall,Plate}>-Reverb
slider15:50<0,100,1>-Size (%)
slider16:0<0,1,1{Off,On}>-Reverb EQ
slider17:2<0,5,1{-2 oct,-1 oct,Off,+1 oct,+2 oct,+3 oct}>-Octave
slider18:40<0,100,1>-Damp (%)
slider19:20<0,100,1>-Reverb mix (%)
slider20:1<0,3,1{Off,I,II,I+II}>-Chorus
slider21:50<0,100,1>-Depth (%)
slider22:0.5<0.01,10,0.01>-Rate (Hz)
slider23:0<0,1,1{Off,On}>-Chorus sat
slider24:0<-6,6,0.1>-Tilt (dB)
slider25:30<0,100,1>-Chorus mix (%)
slider26:0<0,100,1>-Comp (%)
slider27:100<0,200,1>-Width (%)
slider28:0<-24,12,0.1>-Output (dB)
slider29:0<0,1,1{Off,On}>-Bypass
slider30:0<0,2,1{1x,2x,4x}>-Oversampling
slider32:prs_sel=0<0,12,1{No preset,Init,Slapback Room,Dotted Eighth,Ping Pong Wide,Dub Siren Loop,Tape Echo Haze,Shimmer Hall,Dark Octave Pad,Ensemble Wash,Plate Vocal,Radio Echo,Detached Swing}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-sidebar.jsfx-inc

@init
function psw_all(v) ( slider_show(4294967295, v); );
function psw_allg(v) ( slider_show(4294967295, v); );
#ui_man = "gfx-lab-detach-delay";
ext_noinit = 1;

function dd_db(d) ( exp(d * 0.11512925465); );
function dd_tc(s, fs) ( 1 - exp(-1 / (max(s, 0.000001) * fs)); );
function dd_th(x) local(e) ( x = min(max(x, -15), 15); e = exp(2 * x); (e - 1) / (e + 1); );
function dd_lc(x) local(a) ( a = abs(x); a + log(1 + exp(-2 * a)) - 0.69314718056; );
function dd_adt(x) instance(x1, f1) local(f, d, y) (
  f = dd_lc(x); d = x - x1;
  y = abs(d) > 0.00001 ? (f - f1) / d : dd_th(0.5 * (x + x1));
  x1 = x; f1 = f; y;
);
function dd_adz() instance(x1, f1) ( x1 = f1 = 0; );

function dd_bqc(c, t, f, q, gdb, fs) local(w, cw, sw, al, ag, a0) (
  w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    ag = 10 ^ (gdb / 40); a0 = 1 + al / ag;
    c[0] = (1 + al * ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / ag) / a0;
  ) : t == 1 ? (
    a0 = 1 + al; c[0] = (1 - cw) * 0.5 / a0; c[1] = (1 - cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  ) : t == 2 ? (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  ) : (
    a0 = 1 + al; c[0] = al / a0; c[1] = 0; c[2] = -al / a0; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function dd_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function dd_bqz() instance(z1, z2) ( z1 = z2 = 0; );

function ve_init(c, fs) (
  dd_bqc(c, 2, 140, 0.7071, 0, fs); dd_bqc(c + 5, 1, 5000, 0.7071, 0, fs);
  dd_bqc(c + 10, 0, 500, 0.9, 0, fs); dd_bqc(c + 15, 3, 500, 0.9, 0, fs);
);
function ve_run(x, c) instance() local(y) ( y = this.pk.dd_bq(x, c + 10); y = this.lp.dd_bq(y, c + 5); this.hp.dd_bq(y, c); );
function ve_z() instance() ( this.hp.dd_bqz(); this.lp.dd_bqz(); this.pk.dd_bqz(); );
function ve_det(m, c) instance(env) local(b) (
  b = this.bp.dd_bq(m, c + 15); b *= b;
  env += (b - env) * (b > env ? ve_ka : ve_kr);
);
function ve_upd(c, fs) instance(env, gd) local(lv, gt) (
  lv = 10 * log10(max(env, 0.000000000001)) + 3;
  gt = 4.5 * min(max((lv + 30) / 12, 0), 1);
  gd += (gt - gd) * ve_kg;
  dd_bqc(c + 10, 0, 500, 0.9, -gd, fs);
);
function ve_dz() instance(env, gd) ( env = gd = 0; this.bp.dd_bqz(); );

function op_tilt(f, gdb) instance(n0, n1, d1) local(k, a, b, d0) (
  k = tan($pi * min(f, srate * 0.45) / srate); a = 10 ^ (gdb / 40); b = 1 / a;
  d0 = b / k + 1; n0 = (a / k + 1) / d0 / a; n1 = (1 - a / k) / d0 / a; d1 = (1 - b / k) / d0;
);
function op_run(x) instance(n0, n1, d1, x1, y1) local(y) ( y = n0 * x + n1 * x1 - d1 * y1; x1 = x; y1 = y; y; );
function op_z() instance(x1, y1) ( x1 = y1 = 0; );

function dd_hrd(b, d) local(p, i, f, xm, x0, x1, x2, c1, c2, c3) (
  p = dd_dw - d; p < 0 ? p += DLN;
  i = floor(p); f = p - i;
  xm = b[i == 0 ? DLN - 1 : i - 1]; x0 = b[i]; x1 = b[i + 1 >= DLN ? i + 1 - DLN : i + 1]; x2 = b[i + 2 >= DLN ? i + 2 - DLN : i + 2];
  c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);
function dd_crd(b, d) local(p, i, f) (
  p = dd_cw - d; p < 0 ? p += CHN;
  i = floor(p); f = p - i;
  b[i] * (1 - f) + b[i + 1 >= CHN ? 0 : i + 1] * f;
);
function dd_tri(p) ( 1 - 4 * abs(p - 0.5); );

function dd_sat(x) ( (dd_th(dd_g * x + 0.1) - dd_tb) / dd_dn; );
function dd_ip(l, r) local(sl, sr, pl, pr) (
  sl = l + (dd_sat(l) - l) * dd_dwm; sr = r + (dd_sat(r) - r) * dd_dwm;
  dd_pds > 0.000001 ? (
    pl = l + sbL.sb_run(l); pr = r + sbR.sb_run(r);
    sl += (pl - sl) * dd_pds; sr += (pr - sr) * dd_pds;
  );
  dd_ol = sl; dd_or = sr;
);

function rv_types() local(i) (
  i = 0;
  loop(8, RVT[i] = i == 0 ? 11.3 : i == 1 ? 13.7 : i == 2 ? 15.9 : i == 3 ? 17.3 : i == 4 ? 19.9 : i == 5 ? 22.1 : i == 6 ? 24.7 : 27.3; i += 1; );
  i = 0;
  loop(8, RVT[8 + i] = i == 0 ? 37.1 : i == 1 ? 41.3 : i == 2 ? 46.7 : i == 3 ? 51.1 : i == 4 ? 56.3 : i == 5 ? 61.7 : i == 6 ? 67.1 : 73.9; i += 1; );
  i = 0;
  loop(8, RVT[16 + i] = i == 0 ? 8.9 : i == 1 ? 11.9 : i == 2 ? 14.3 : i == 3 ? 17.9 : i == 4 ? 21.1 : i == 5 ? 24.3 : i == 6 ? 29.3 : 33.7; i += 1; );
  RVA[0] = 4.77; RVA[1] = 3.59; RVA[2] = 12.73; RVA[3] = 9.31; RVA[4] = 4.53; RVA[5] = 3.77; RVA[6] = 11.89; RVA[7] = 8.97;
);
function rv_settype(t) local(k) (
  rv_cur = t; t = max(t, 1) - 1; k = 0;
  loop(8, RVB[k] = RVT[t * 8 + k] * 0.001 * srate; k += 1; );
  rv_apg = t == 0 ? 0.5 : t == 1 ? 0.6 : 0.72;
  rv_nrm = t == 0 ? 0.9 : t == 1 ? 0.55 : 0.6;
);
function rv_ap(j, x) local(b, i, v, u) (
  b = RAP + j * RAN; i = dd_aw - RVAS[j]; i < 0 ? i += RAN;
  v = b[i]; u = x + rv_apg * v; b[dd_aw] = u;
  v - rv_apg * u;
);
function rv_run(l, r) local(k, b, rp, ri, rf, v, a0, a1, a2, a3, a4, a5, a6, a7, b0, b1, b2, b3, b4, b5, b6, b7, c0, c1, c2, c3, c4, c5, c6, c7, hs, ln, md, t) (
  RPD[dd_pw] = l; RPD[RPN + dd_pw] = r;
  rp = dd_pw - rv_pds; rp < 0 ? rp += RPN; ri = floor(rp);
  l = RPD[ri]; r = RPD[RPN + ri];
  dd_pw = (dd_pw + 1) & (RPN - 1);
  l = rv_ap(0, l); l = rv_ap(1, l); l = rv_ap(2, l); l = rv_ap(3, l);
  r = rv_ap(4, r); r = rv_ap(5, r); r = rv_ap(6, r); r = rv_ap(7, r);
  dd_aw = (dd_aw + 1) & (RAN - 1);
  t = rv_mc * rv_mk1 - rv_ms * rv_mk2; rv_ms = rv_ms * rv_mk1 + rv_mc * rv_mk2; rv_mc = t;
  md = rv_md;
  k = 0;
  loop(8,
    b = RVL + k * RVN;
    ln = RVB[k] * rv_sc + md * ((k & 1) ? rv_ms : rv_mc) * ((k & 2) ? -1 : 1) + md + 2;
    rp = dd_rw - ln; rp < 0 ? rp += RVN;
    ri = floor(rp); rf = rp - ri;
    v = b[ri] * (1 - rf) + b[ri + 1 >= RVN ? 0 : ri + 1] * rf;
    RVZ[k] += (v - RVZ[k]) * rv_dpk;
    RVV[k] = RVZ[k] * RVG[k];
    k += 1; );
  a0 = RVV[0]; a1 = RVV[1]; a2 = RVV[2]; a3 = RVV[3]; a4 = RVV[4]; a5 = RVV[5]; a6 = RVV[6]; a7 = RVV[7];
  b0 = a0 + a1; b1 = a0 - a1; b2 = a2 + a3; b3 = a2 - a3; b4 = a4 + a5; b5 = a4 - a5; b6 = a6 + a7; b7 = a6 - a7;
  c0 = b0 + b2; c1 = b1 + b3; c2 = b0 - b2; c3 = b1 - b3; c4 = b4 + b6; c5 = b5 + b7; c6 = b4 - b6; c7 = b5 - b7;
  hs = 0.35355339;
  b = RVL; b[dd_rw] = (c0 + c4) * hs + 0.5 * l + 0.000000000000000001;
  b = RVL + RVN; b[dd_rw] = (c1 + c5) * hs - 0.5 * l;
  b = RVL + 2 * RVN; b[dd_rw] = (c2 + c6) * hs + 0.5 * l;
  b = RVL + 3 * RVN; b[dd_rw] = (c3 + c7) * hs - 0.5 * l;
  b = RVL + 4 * RVN; b[dd_rw] = (c0 - c4) * hs + 0.5 * r;
  b = RVL + 5 * RVN; b[dd_rw] = (c1 - c5) * hs - 0.5 * r;
  b = RVL + 6 * RVN; b[dd_rw] = (c2 - c6) * hs + 0.5 * r;
  b = RVL + 7 * RVN; b[dd_rw] = (c3 - c7) * hs - 0.5 * r;
  dd_rw += 1; dd_rw >= RVN ? dd_rw = 0;
  rv_l = 0.5 * (a0 - a2 + a4 + a6 - 0.6 * a1 + 0.6 * a7) * rv_nrm;
  rv_r = 0.5 * (a1 + a3 - a5 + a7 + 0.6 * a0 - 0.6 * a6) * rv_nrm;
);
function rv_clear() ( memset(RVL, 0, 8 * RVN); memset(RAP, 0, 8 * RAN); memset(RPD, 0, 2 * RPN); memset(SHB, 0, SHN); memset(RVZ, 0, 8); );

function sh_run(x) local(d1, d2, p, i, f, y1, y2, g1, q) (
  SHB[dd_sw] = x;
  q = sh_ph + 0.5; q >= 1 ? q -= 1;
  d1 = sh_ph * sh_win + 2; d2 = q * sh_win + 2;
  p = dd_sw - d1; p < 0 ? p += SHN; i = floor(p); f = p - i; y1 = SHB[i] * (1 - f) + SHB[(i + 1) & (SHN - 1)] * f;
  p = dd_sw - d2; p < 0 ? p += SHN; i = floor(p); f = p - i; y2 = SHB[i] * (1 - f) + SHB[(i + 1) & (SHN - 1)] * f;
  g1 = sin($pi * sh_ph); g1 *= g1;
  dd_sw = (dd_sw + 1) & (SHN - 1);
  sh_ph -= (sh_rat - 1) / sh_win; sh_ph < 0 ? sh_ph += 1 : sh_ph >= 1 ? sh_ph -= 1;
  y1 * g1 + y2 * (1 - g1);
);

function dd_alloc() (
  DLN = ceil(4.2 * srate) + 16; DLL = 1000000; DLR = DLL + DLN;
  CHN = 16384; CHL = 2700000; CHR = CHL + CHN;
  RVN = 65536; RVL = 2800000;
  RAN = 8192; RAP = 3400000;
  RPN = 16384; RPD = 3500000;
  SHN = 32768; SHB = 3600000;
  RVT = 3700000; RVB = 3700100; RVG = 3700120; RVZ = 3700140; RVV = 3700160; RVA = 3700180; RVAS = 3700200;
  VE1 = 3700300; VE2 = 3700330;
  rv_types();
);
function dd_clear() (
  memset(DLL, 0, 2 * DLN); memset(CHL, 0, 2 * CHN); rv_clear();
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); sbL.sb_clr(); sbR.sb_clr();
  eqL.ve_z(); eqR.ve_z(); rvqL.ve_z(); rvqR.ve_z(); dlD.ve_dz(); rvD.ve_dz();
  hpL.dd_bqz(); hpR.dd_bqz(); lpL.dd_bqz(); lpR.dd_bqz(); scL.dd_bqz(); scR.dd_bqz();
  lsL.dd_adz(); lsR.dd_adz(); csL.dd_adz(); csR.dd_adz(); tlL.op_z(); tlR.op_z();
  dd_ix = dd_iy = dd_jx = dd_jy = dd_lx = dd_ly = dd_rx = dd_ry = 0;
  dd_c1l = dd_c1r = dd_c2l = dd_c2r = 0; dd_shf = 0; dd_cen = 0; dd_cgr = 0;
);
function dd_rates() (
  dd_fs = srate * os_f;
  sb_rate(dd_fs);
);
function dd_srinit() (
  dd_sr = srate;
  dd_alloc();
  dd_sm = dd_tc(0.03, srate); dd_sw15 = dd_tc(0.015, srate); dd_kt = dd_tc(0.12, srate);
  dd_dcr = 1 - 2 * $pi * 5 / srate;
  dd_fis = 1 / (0.01 * srate);
  dd_rdk = 1 / (0.02 * srate);
  ve_ka = dd_tc(0.005, srate); ve_kr = dd_tc(0.12, srate); ve_kg = dd_tc(0.03, srate / 16);
  ve_init(VE1, srate); ve_init(VE2, srate);
  scL.dd_bqz(); dd_bqc(3700360, 2, 80, 0.7071, 0, srate);
  dd_crms = dd_tc(0.005, srate); dd_chold = dd_tc(1.5, srate); dd_catt = dd_tc(0.008, srate);
  dd_cbk = 1 - exp(-2 * $pi * 9000 / srate);
  dd_rk = 0; loop(8, RVAS[dd_rk] = floor(RVA[dd_rk] * 0.001 * srate); dd_rk += 1; );
  rv_mk1 = cos(2 * $pi * 0.7 / srate); rv_mk2 = sin(2 * $pi * 0.7 / srate); rv_mc = 1; rv_ms = 0;
  rv_md = 0.0004 * srate;
  sh_win = floor(0.07 * srate);
  rv_settype(slider14 | 0);
  dd_rates(); dd_clear();
  dd_snap = 1;
);

function dd_setup() local(bt, n, t) (
  dd_pdt = slider1 >= 0.5;
  dd_drt = min(max(slider2, 0), 24);
  sb_target(18 - 0.5 * dd_drt, 1, dd_pdt, 220, 1);
  dd_hpt = slider3; dd_lpt = slider4;
  dd_hot = slider3 > 20.5; dd_lot = slider4 < 19900;
  n = slider7 | 0;
  bt = n == 0 ? 0.125 : n == 1 ? 0.16666667 : n == 2 ? 0.25 : n == 3 ? 0.375 : n == 4 ? 0.33333333 : n == 5 ? 0.5 : n == 6 ? 0.75 :
       n == 7 ? 0.66666667 : n == 8 ? 1 : n == 9 ? 1.5 : n == 10 ? 2 : n == 11 ? 3 : 4;
  t = slider6 >= 0.5 ? bt * 60 / max(tempo, 20) : slider5 / 1000;
  dd_tt = min(max(t, 0.01), 3) * srate;
  dd_flt = 0.33 * slider8 / 100;
  dd_dvt = slider9 / 100; dd_fbt = min(slider10 / 100, 1); dd_dmt = slider11 / 100;
  dd_det = slider12 >= 0.5; dd_pgt = slider13 >= 0.5;
  rv_req = slider14 | 0; dd_szt = slider15 / 100; dd_ret = slider16 >= 0.5;
  sh_req = slider17 | 0; dd_dpt = slider18 / 100; dd_rmt = slider19 / 100;
  dd_cmq = slider20 | 0;
  dd_w1t = dd_cmq == 1 ? 1 : dd_cmq == 3 ? 0.7 : 0; dd_w2t = dd_cmq == 2 ? 1 : dd_cmq == 3 ? 0.7 : 0;
  dd_cot = dd_cmq > 0;
  dd_cdt = slider21 / 100; dd_crt = slider22; dd_cst = slider23 >= 0.5; dd_tlt = slider24; dd_cxt = slider25 / 100;
  dd_cpt = slider26 / 100; dd_wdt = slider27 / 100; dd_ogt = dd_db(slider28);
);

function dd_pm(a, b, c, d, e, f, g, h, i, j, k, l, m, n) (
  slider1 = a; slider2 = b; slider3 = c; slider4 = d; slider5 = e; slider6 = f; slider7 = g;
  slider8 = h; slider9 = i; slider10 = j; slider11 = k; slider12 = l; slider13 = m; slider14 = n;
);
function dd_pn(a, b, c, d, e, f, g, h, i, j, k, l, m, n) (
  slider15 = a; slider16 = b; slider17 = c; slider18 = d; slider19 = e; slider20 = f; slider21 = g;
  slider22 = h; slider23 = i; slider24 = j; slider25 = k; slider26 = l; slider27 = m; slider28 = n;
);
function load_preset(p) (
  p == 1 ? ( dd_pm(0, 0, 20, 20000, 375, 1, 6, 0, 20, 40, 30, 0, 1, 2); dd_pn(50, 0, 2, 40, 20, 1, 50, 0.5, 0, 0, 30, 0, 100, 0); ) :
  p == 2 ? ( dd_pm(0, 3, 80, 12000, 110, 0, 6, 0, 30, 15, 35, 1, 0, 1); dd_pn(30, 0, 2, 50, 15, 0, 50, 0.5, 0, 0, 30, 20, 100, 0); ) :
  p == 3 ? ( dd_pm(0, 0, 120, 9000, 375, 1, 6, 0, 15, 45, 30, 0, 0, 2); dd_pn(45, 0, 2, 40, 15, 1, 40, 0.4, 0, 0, 20, 0, 110, 0); ) :
  p == 4 ? ( dd_pm(0, 0, 150, 10000, 375, 1, 5, 0, 10, 50, 35, 0, 1, 2); dd_pn(40, 0, 2, 45, 15, 0, 50, 0.5, 0, 0, 30, 0, 130, 0); ) :
  p == 5 ? ( dd_pm(1, 12, 180, 4000, 375, 1, 9, 0, 70, 92, 45, 1, 1, 1); dd_pn(40, 1, 2, 60, 10, 0, 50, 0.5, 0, -1, 30, 30, 100, -2); ) :
  p == 6 ? ( dd_pm(0, 6, 90, 7000, 330, 0, 6, 0, 55, 55, 35, 1, 0, 1); dd_pn(35, 0, 2, 55, 12, 1, 30, 0.25, 1, -1.5, 30, 15, 100, 0); ) :
  p == 7 ? ( dd_pm(0, 0, 200, 14000, 500, 1, 8, 0, 10, 35, 20, 0, 1, 2); dd_pn(85, 0, 3, 30, 45, 2, 40, 0.2, 0, 1, 30, 0, 120, 0); ) :
  p == 8 ? ( dd_pm(0, 0, 60, 6000, 750, 1, 10, 0, 20, 40, 20, 1, 0, 2); dd_pn(90, 1, 1, 65, 45, 3, 60, 0.12, 1, -2, 40, 10, 110, 0); ) :
  p == 9 ? ( dd_pm(0, 0, 20, 20000, 250, 1, 5, -30, 10, 30, 20, 0, 1, 3); dd_pn(60, 0, 2, 35, 25, 3, 70, 0.6, 0, 0.5, 60, 0, 140, 0); ) :
  p == 10 ? ( dd_pm(0, 0, 120, 16000, 220, 1, 4, 0, 10, 25, 15, 0, 1, 3); dd_pn(55, 1, 2, 35, 30, 0, 50, 0.5, 0, 1, 30, 25, 100, 0); ) :
  p == 11 ? ( dd_pm(1, 10, 300, 3300, 280, 0, 6, 40, 60, 50, 40, 1, 0, 1); dd_pn(25, 1, 2, 50, 10, 1, 50, 1.2, 1, -2, 25, 35, 80, 0); ) :
  p == 12 ? ( dd_pm(0, 0, 100, 12000, 500, 1, 8, 60, 20, 45, 30, 0, 1, 2); dd_pn(60, 0, 4, 40, 25, 2, 45, 0.08, 0, 0, 35, 10, 120, 0); );
  slider_automate(268435455);
