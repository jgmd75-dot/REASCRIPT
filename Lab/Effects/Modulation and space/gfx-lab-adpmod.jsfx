desc:ADPMod [ring modulator] (GFX Lab)
//tags: modulation ringmod frequency-shifter tremolo distortion lfo tempo-sync stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider24:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:ad_mode=0<0,2,1{Ring,Sub,Shift}>-Mode
slider2:ad_rf=220<20,4000,1>-Ring frequency (Hz)
slider3:ad_sr=4<0.01,20,0.01>-Sub rate (Hz)
slider4:ad_shf=30<-2000,2000,0.01>-Shift (Hz)
slider5:ad_wave=0<0,4,1{Sine,Triangle,Square,Saw,Noise}>-Carrier wave
slider6:ad_drv=0<0,10,0.01>-$ Drive
slider7:ad_dep=100<0,100,0.1>-Depth (%)
slider8:ad_har=0<0,100,0.1>-Harmonics (%)
slider9:ad_tone=20000<220,20000,1>-Tone (Hz)
slider10:ad_mix=50<0,100,0.1>-Mix (%)
slider11:ad_hpf=20<20,500,1>-Wet high-pass (Hz)
slider12:ad_out=0<-24,12,0.1>-Output (dB)
slider13:ad_trim=0<-24,12,0.1>-Input trim (dB)
slider14:ad_sat=0<0,100,0.1>-Sat (%)
slider15:ad_dft=50<0,100,0.1>-Drift (%)
slider16:ad_swr=0.2<0.01,10,0.001>-Sweep rate (Hz)
slider17:ad_swa=0<0,100,0.1>-Sweep amount (%)
slider18:ad_spr=0<0,100,0.1>-Spread (%)
slider19:ad_sync=0<0,1,1{Off,On}>-Tempo sync
slider20:ad_note=8<0,12,1{1/32,1/16 triplet,1/16,1/16 dotted,1/8 triplet,1/8,1/8 dotted,1/4 triplet,1/4,1/4 dotted,1/2,1/2 dotted,1/1}>-Sync note
slider21:ad_byp=0<0,1,1{Off,On}>-Bypass
slider22:ad_os=1<0,2,1{1x,2x,4x}>-Oversampling
slider23:prs_sel=0<0,16,1{No preset,Init,Vocal Ring,Sub Tremolo,Metallic Chaos,Subtle Saturation Mod,Robot Voice,Bell Tones,Tempo Chop,Slow Throb,Stereo Tremolo,Phase Drift,Shift Up,Alien Radio,Sweep Ring,Noise Grit,Siren Sweep}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
function psw_all(v) ( slider_show(16777215, v); );
function psw_allg(v) ( slider_show(16777215, v); );
#ui_man = "gfx-lab-adpmod";
ext_noinit = 1;

AD_DRY = 7000000; AD_DN = 256;

function ad_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function ad_db(d) ( exp(d * 0.11512925464970228); );
function ad_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function ad_th(x) local(e) ( x = min(max(x, -12), 12); e = exp(2 * x); (e - 1) / (e + 1); );
function ad_blep(t, dt) (
  t < dt ? ( t /= dt; t + t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0;
);
function ad_w(p, dt, w, nz) local(q) (
  w == 0 ? sin(2 * $pi * p) :
  w == 1 ? ( p < 0.5 ? 4 * p - 1 : 3 - 4 * p ) :
  w == 2 ? ( q = p + 0.5; q -= floor(q); (p < 0.5 ? 1 : -1) + ad_blep(p, dt) - ad_blep(q, dt); ) :
  w == 3 ? 2 * p - 1 - ad_blep(p, dt) :
  nz;
);
function ad_wh(p, dt, w, nz) local(v, q) (
  v = ad_w(p, dt, w, nz);
  ad_hs > 0.0005 ? ( q = 2 * p; q -= floor(q); v += ad_hs * (w == 4 ? nz : ad_w(q, min(2 * dt, 0.45), w, nz)); );
  v;
);

function ad_car(inc, off) instance(ph, na, nb, lp) local(p, dt, nz, v) (
  ph += inc; ph >= 1 ? ( ph -= floor(ph); na = nb; nb = rand(2) - 1; ) : ph < 0 ? ph -= floor(ph);
  p = ph + off; p -= floor(p);
  dt = min(abs(inc), 0.45);
  nz = ad_md == 1 ? na + (nb - na) * (0.5 - 0.5 * cos($pi * ph)) : rand(2) - 1;
  v = ad_wh(p, dt, ad_wv, nz);
  ad_xf < 1 ? v = ad_wh(p, dt, ad_wo, nz) + (v - ad_wh(p, dt, ad_wo, nz)) * ad_xs;
  lp += (v - lp) * ad_clp;
  lp;
);
function ad_sat(x) local(y) (
  ad_dw > 0.0005 ? (
    y = (ad_th(ad_g * x * 0.5 + ad_b) - ad_tb) * ad_c * 2;
    x + (y - x) * ad_dw;
  ) : x;
);
function ad_cell(x, inc, off) instance(c) local(car) (
  ad_md == 2 ? ad_sat(x) : (
    car = c.ad_car(inc, off);
    ad_sat(x * (1 - ad_ds + ad_ds * car));
  );
);
function ad_cclr() instance(c) ( c.lp = 0; );

function ad_ap(x, a) instance(x1, x2, y1, y2) local(y) (
  y = a * (x + y2) - x2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function ad_apclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function ad_hil(x) instance(a1, a2, a3, a4, b1, b2, b3, b4, dz, hi, hq) local(p) (
  p = a4.ad_ap(a3.ad_ap(a2.ad_ap(a1.ad_ap(x, 0.47940086558884), 0.87621849353931), 0.97659758950819), 0.99749925593555);
  hq = dz; dz = p;
  hi = b4.ad_ap(b3.ad_ap(b2.ad_ap(b1.ad_ap(x, 0.16175849836770), 0.73302893234149), 0.94534443203315), 0.99059915668453);
);
function ad_hclr() instance(a1, a2, a3, a4, b1, b2, b3, b4, dz) (
  a1.ad_apclr(); a2.ad_apclr(); a3.ad_apclr(); a4.ad_apclr();
  b1.ad_apclr(); b2.ad_apclr(); b3.ad_apclr(); b4.ad_apclr(); dz = 0;
);
function ad_ssb(x, th, dep) instance(h) local(s1, s2) (
  h.ad_hil(x);
  s1 = h.hi * cos(th) - h.hq * sin(th);
  s2 = ad_hs > 0.0005 ? h.hi * cos(2 * th) - h.hq * sin(2 * th) : 0;
  x + (s1 + ad_hs * s2 - x) * dep;
);

function ad_svf(x, g, k) instance(s1, s2, lp, hp) local(v1, v2, a1) (
  a1 = 1 / (1 + g * (g + k));
  v1 = a1 * (s1 + g * (x - s2));
  v2 = s2 + g * v1;
  s1 = 2 * v1 - s1; s2 = 2 * v2 - s2;
  lp = v2; hp = x - k * v1 - v2;
);
function ad_sclr() instance(s1, s2) ( s1 = s2 = 0; );
function ad_gc(f) ( tan($pi * min(f, 0.45 * srate) / srate); );

function ad_note_b(n) (
  n = max(0, min(12, floor(n + 0.5)));
  n == 0 ? 0.125 : n == 1 ? 1 / 6 : n == 2 ? 0.25 : n == 3 ? 0.375 : n == 4 ? 1 / 3 : n == 5 ? 0.5 : n == 6 ? 0.75 :
  n == 7 ? 2 / 3 : n == 8 ? 1 : n == 9 ? 1.5 : n == 10 ? 2 : n == 11 ? 3 : 4;
);

function ad_srinit() (
  ad_sr0 = srate;
  ad_ksm = ad_tc(30); ad_kxf = 1 / (0.015 * srate); ad_kdk = 1 / (0.006 * srate);
  ad_dcc = 1 - 2 * $pi * 5 / srate;
  rs_c = 1 / (0.015 * srate);
);
function ad_clp_set() ( ad_clp = ad_md == 1 ? 1 - exp(-2 * $pi * 150 / (srate * os_f)) : 1; );
function ad_clear() (
  qL.ad_cclr(); qR.ad_cclr();
  auL.os_clr(); auR.os_clr(); adL.os_clr(); adR.os_clr();
  ahL.h.ad_hclr(); ahR.h.ad_hclr();
  atL.ad_sclr(); atR.ad_sclr(); afW.ad_sclr(); afX.ad_sclr(); afD.ad_sclr(); afE.ad_sclr();
  ad_dxa = ad_dya = ad_dxb = ad_dyb = 0;
  memset(AD_DRY, 0, 2 * AD_DN);
);

function ad_basef() local(f) (
  ad_md == 0 ? log(ad_rf) : ad_md == 1 ? (
    ad_sync >= 0.5 ? log(max(tempo, 20) / 60 / ad_note_b(ad_note)) : log(ad_sr);
  ) : ad_shf;
);

function ad_params() local(d) (
  ad_mt = max(0, min(2, floor(ad_mode + 0.5)));
  ad_wt = max(0, min(4, floor(ad_wave + 0.5)));
  ad_lft = ad_basef();
  d = min(max(ad_drv, 0), 10);
  ad_gt = 10 ^ (d * 2.2 / 20);
  ad_dwt = min(d / 0.5, 1);
  ad_dept = ad_dep / 100; ad_hart = ad_har / 100;
  ad_tgt = ad_gc(ad_tone * (1 + 0.1 * ad_td * vT));
  ad_mixt = ad_mix / 100;
  ad_hgt = ad_gc(max(ad_hpf, 20) * (ad_hpf <= 20.5 ? 0.25 : 1));
  ad_outt = ad_db(ad_out); ad_trt = ad_db(ad_trim);
  ad_swat = ad_md == 1 && ad_sync >= 0.5 ? 0 : ad_swa / 100;
  ad_sprt = ad_spr / 100;
  drift_macro(ad_dft);
  ad_fd = 0.10 * dm_a; ad_dd = 0.15 * dm_a; ad_td = 0.10 * dm_a;
  ost_setup(ad_sat / 100, 0.3, 120, 6000, -0.3, 1);
  os_tf = os_f2n(ad_os);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
  ad_snap ? (
    ad_md = ad_mt; ad_wv = ad_wo = ad_wt; ad_xf = 1; ad_xs = 1;
    ad_lft = ad_basef(); ad_lf = ad_lft; ad_g0 = ad_gt; ad_dw = ad_dwt; ad_ds = ad_dept; ad_hs = ad_hart;
    ad_tg = ad_tgt; ad_mx = ad_mixt; ad_hg = ad_hgt; ad_og = ad_outt; ad_tr = ad_trt; ad_sws = ad_swat; ad_sps = ad_sprt;
    ad_clp_set(); ad_snap = 0;
  );
);

os_design();
os_f = os_tf = os_f2n(ad_os);
os_base = 0;
ad_srinit();
drF.drift_init(0.8 + rand(1) * 0.5); drD.drift_init(0.8 + rand(1) * 0.5); drT.drift_init(0.8 + rand(1) * 0.5);
vF = vD = vT = 0;
ad_snap = 1; ad_dk = 1; ad_dkd = 0;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
ad_params();
ad_clear();
os_gsetup();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
by_setup(21);
pwr_init(); pwr_sag = 0.12; pwr_wu_loss = 0.5; pwr_wu_drv = 1.3; pwr_wu_lp = 11000; pwr_wu_wob = 0.15; pwr_bloom = 0;
ad_pk_d = 0; ad_ph_d = 0; ad_dw_i = 0; rs_f = 1;
ad_swp = 0; ad_lk = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function ad_pa(m, rf, sr, sh, w, sy, nt) ( ad_mode = m; ad_rf = rf; ad_sr = sr; ad_shf = sh; ad_wave = w; ad_sync = sy; ad_note = nt; );
function ad_pb(dr, dp, hr, tn, mx, hp, swr, swa, sp) ( ad_drv = dr; ad_dep = dp; ad_har = hr; ad_tone = tn; ad_mix = mx; ad_hpf = hp; ad_swr = swr; ad_swa = swa; ad_spr = sp; );
function load_preset(p) local(i) (
  p == 1  ? ( ad_pa(0, 220, 4, 30, 0, 0, 8);    ad_pb(0, 100, 0, 20000, 50, 20, 0.2, 0, 0); ) :
  p == 2  ? ( ad_pa(0, 440, 4, 30, 0, 0, 8);    ad_pb(2, 100, 30, 2200, 70, 20, 0.2, 0, 0); ) :
  p == 3  ? ( ad_pa(1, 220, 6.6, 30, 1, 0, 8);  ad_pb(1, 80, 0, 20000, 100, 20, 0.2, 0, 0); ) :
  p == 4  ? ( ad_pa(0, 180, 4, 30, 2, 0, 8);    ad_pb(8, 100, 85, 7700, 85, 20, 0.2, 0, 25); ) :
  p == 5  ? ( ad_pa(0, 220, 4, 30, 0, 0, 8);    ad_pb(0, 50, 0, 9900, 40, 20, 0.2, 0, 0); ) :
  p == 6  ? ( ad_pa(0, 110, 4, 30, 0, 0, 8);    ad_pb(1.5, 100, 0, 5500, 100, 110, 0.2, 0, 0); ) :
  p == 7  ? ( ad_pa(0, 880, 4, 30, 0, 0, 8);    ad_pb(0, 100, 40, 11000, 60, 20, 0.2, 0, 10); ) :
  p == 8  ? ( ad_pa(1, 220, 4, 30, 2, 1, 2);    ad_pb(0, 100, 0, 20000, 100, 20, 0.2, 0, 0); ) :
  p == 9  ? ( ad_pa(1, 220, 0.5, 30, 0, 0, 8);  ad_pb(0, 100, 0, 20000, 100, 20, 0.2, 0, 100); ) :
  p == 10 ? ( ad_pa(1, 220, 4, 30, 1, 1, 5);    ad_pb(0, 60, 0, 20000, 100, 20, 0.2, 0, 100); ) :
  p == 11 ? ( ad_pa(2, 220, 4, 0.8, 0, 0, 8);   ad_pb(0, 100, 0, 20000, 50, 20, 0.2, 0, 100); ) :
  p == 12 ? ( ad_pa(2, 220, 4, 60, 0, 0, 8);    ad_pb(0, 100, 0, 20000, 100, 20, 0.2, 0, 0); ) :
  p == 13 ? ( ad_pa(2, 220, 4, -330, 0, 0, 8);  ad_pb(4, 100, 30, 3300, 80, 330, 0.2, 0, 0); ) :
  p == 14 ? ( ad_pa(0, 440, 4, 30, 0, 0, 8);    ad_pb(0, 100, 20, 11000, 70, 20, 0.1, 60, 15); ) :
  p == 15 ? ( ad_pa(0, 220, 4, 30, 4, 0, 8);    ad_pb(3, 40, 0, 6600, 35, 20, 0.2, 0, 0); ) :
  p == 16 ? ( ad_pa(0, 660, 4, 30, 2, 0, 8);    ad_pb(1, 100, 0, 5500, 70, 20, 0.5, 80, 0); );
  i = 1; loop(20, ui_auto(i); i += 1; );
  pr_cur = p;
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(22, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 16 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
ad_params();
os_snap(slider(22));

@block
prs_chk();
srate != ad_sr0 ? ( ad_srinit(); ad_clp_set(); );
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; ad_clear(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
ad_bi = samplesblock / srate * 0.25 * dm_s;
vF = drF.drift_tick(ad_bi); vD = drD.drift_tick(ad_bi); vT = drT.drift_tick(ad_bi);
ad_params();
ad_lk = 0;
ad_md == 1 && ad_sync >= 0.5 && (play_state & 1) ? (
  ad_nb = ad_note_b(ad_note);
  ad_tp = beat_position / ad_nb; ad_tp -= floor(ad_tp);
  ad_er = ad_tp - qL.c.ph; ad_er -= floor(ad_er + 0.5);
  ad_lk = ad_er * min(1, samplesblock / (0.1 * srate)) / max(samplesblock * os_f, 1);
);
ad_b = 0.05 + vD * ad_dd * 0.06; ad_tb = ad_th(ad_b);
pwr_block(ad_byp < 0.5);
os_snapb(slider(22));

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
ad_md != ad_mt ? (
  ad_dk = max(ad_dk - ad_kdk, 0);
  ad_dk == 0 ? ( ad_hd += 1; ad_hd > os_lat(os_f) + 8 ? ( ad_hd = 0; ad_md = ad_mt; ad_lf = ad_lft = ad_basef(); ad_clp_set(); qL.ad_cclr(); qR.ad_cclr(); ); );
) : ad_dk < 1 ? ad_dk = min(ad_dk + ad_kdk, 1);
ad_xf >= 1 && ad_wt != ad_wv ? ( ad_wo = ad_wv; ad_wv = ad_wt; ad_xf = 0; );
ad_xf < 1 ? ( ad_xf = min(ad_xf + ad_kxf, 1); ad_xs = ad_xf * ad_xf * (3 - 2 * ad_xf); );
ad_lf += (ad_lft - ad_lf) * ad_ksm;
ad_g0 += (ad_gt - ad_g0) * ad_ksm; ad_dw += (ad_dwt - ad_dw) * ad_ksm;
ad_ds += (ad_dept - ad_ds) * ad_ksm; ad_hs += (ad_hart - ad_hs) * ad_ksm;
ad_tg += (ad_tgt - ad_tg) * ad_ksm; ad_mx += (ad_mixt - ad_mx) * ad_ksm;
ad_hg += (ad_hgt - ad_hg) * ad_ksm; ad_og += (ad_outt - ad_og) * ad_ksm; ad_tr += (ad_trt - ad_tr) * ad_ksm;
ad_sws += (ad_swat - ad_sws) * ad_ksm; ad_sps += (ad_sprt - ad_sps) * ad_ksm;
ad_g = ad_g0; ad_c = 0.25 / ((ad_th(ad_g * 0.125 + ad_b) - ad_tb) - (ad_th(-ad_g * 0.125 + ad_b) - ad_tb));

ad_swp += ad_swr / srate; ad_swp -= floor(ad_swp);
ad_sm = exp(1.3862943611198906 * ad_sws * sin(2 * $pi * ad_swp));
ad_fm = ad_md == 1 && ad_sync >= 0.5 ? 1 : 1 + ad_fd * vF;
ad_md == 2 ? ( ad_f = ad_lf * ad_sm * ad_fm; ) : ( ad_f = exp(ad_lf) * ad_sm * ad_fm; ad_f = min(ad_f, 0.45 * srate); );
ad_inc = ad_f / (srate * os_f);
ad_rdet = ad_md == 0 ? 1 + 0.02 * ad_sps : 1;
ad_roff = ad_md == 1 ? 0.5 * ad_sps : 0;

ad_xl = spl0 * ad_tr; ad_xr = spl1 * ad_tr;
pwr_in(ad_xl, ad_xr); ad_xl = pwr_l; ad_xr = pwr_r;
AD_DRY[ad_dwi] = ad_xl; AD_DRY[AD_DN + ad_dwi] = ad_xr;

ad_fs = ad_md == 2 ? ad_f : 0;
ad_thl += 2 * $pi * ad_fs / srate; ad_thl -= 2 * $pi * floor(ad_thl / (2 * $pi));
ad_thr += 2 * $pi * ad_fs * (1 - 2 * ad_sps) / srate; ad_thr -= 2 * $pi * floor(ad_thr / (2 * $pi));
ad_al = ahL.ad_ssb(ad_xl, ad_thl, ad_ds); ad_ar = ahR.ad_ssb(ad_xr, ad_thr, ad_ds);
ad_md != 2 ? ( ad_al = ad_xl; ad_ar = ad_xr; );
ad_dks = ad_dk * ad_dk * (3 - 2 * ad_dk);
ad_al *= ad_dks; ad_ar *= ad_dks;

os_gate();
os_chg ? ( ad_clp_set(); auL.os_clr(); auR.os_clr(); adL.os_clr(); adR.os_clr(); qL.ad_cclr(); qR.ad_cclr(); );
ad_ia = ad_inc + ad_lk; ad_ib = ad_inc * ad_rdet + ad_lk;
auL.os_up(ad_al); auR.os_up(ad_ar);
os_f == 1 ? (
  ad_yl = qL.ad_cell(auL.s0, ad_ia, 0); ad_yr = qR.ad_cell(auR.s0, ad_ib, ad_roff);
) : os_f == 2 ? (
  ad_yl = adL.os_dn(qL.ad_cell(auL.s0, ad_ia, 0), qL.ad_cell(auL.s1, ad_ia, 0), 0, 0);
  ad_yr = adR.os_dn(qR.ad_cell(auR.s0, ad_ib, ad_roff), qR.ad_cell(auR.s1, ad_ib, ad_roff), 0, 0);
) : (
  ad_yl = adL.os_dn(qL.ad_cell(auL.s0, ad_ia, 0), qL.ad_cell(auL.s1, ad_ia, 0), qL.ad_cell(auL.s2, ad_ia, 0), qL.ad_cell(auL.s3, ad_ia, 0));
  ad_yr = adR.os_dn(qR.ad_cell(auR.s0, ad_ib, ad_roff), qR.ad_cell(auR.s1, ad_ib, ad_roff), qR.ad_cell(auR.s2, ad_ib, ad_roff), qR.ad_cell(auR.s3, ad_ib, ad_roff));
);
ad_ph_d = qL.c.ph;

ad_q = ad_yl - ad_dxa + ad_dcc * ad_dya; ad_dxa = ad_yl; ad_dya = ad_q; ad_yl = ad_q;
