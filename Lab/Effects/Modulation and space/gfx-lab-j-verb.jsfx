desc:J-Verb [digital reverb] (GFX Lab)
//tags: reverb hall room plate 3d early reflections broadcast digital 12-bit
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bverb, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bverb.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

slider30:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,3,1{Hall,3D,Flagship 40,12-Bit}>-Model
slider2:8<0,120,1>-1st reflection delay (ms)
slider3:-6<-30,6,0.5>-1st reflection level (dB, -30 = off)
slider4:24<0,250,1>-Reverb delay (ms)
slider5:0<-30,6,0.5>-Reverb level (dB, -30 = off)
slider6:2.8<0.1,20,0.05>-Decay (s)
slider7:0.7<0.1,1.5,0.05>-HF decay (x)
slider8:1.0<0.5,2.5,0.05>-LF decay (x)
slider9:3000<10,12000,1>-Room size (m3)
slider10:60<0,100,1>-Reflection density (%)
slider11:60<0,100,1>-Diffusion (%)
slider12:80<20,1000,1>-Lo cut (Hz)
slider13:12000<1000,20000,10>-Hi cut (Hz)
slider14:0<0,100,1>-Drive (%)
slider15:0<0,1,1{Modern,Vintage}>-Clock
slider16:0<0,2,1{12,16,24}>-Bits (vintage)
slider17:100<0,150,1>-Width (%)
slider18:50<0,100,1>-Drift (%)
slider19:0.15<0.02,2,0.01>-Drift speed (Hz)
slider20:30<0,100,1>-Mix (%)
slider21:0<-24,12,0.1>-Output (dB)
slider22:0<0,100,1>-Band sat (%)
slider23:30<0,100,1>-Bias (%)
slider24:120<40,400,1>-Sat low band (Hz)
slider25:6000<2000,16000,10>-Sat high band (Hz)
slider26:0<-24,12,0.1>-Input trim (dB)
slider27:0<0,1,1{Off,On}>-Input guard
slider28:byp_on=0<0,1,1{Off,On}>-Bypass
slider29:prs_sel=0<0,11,1{No preset,Init,Massive Hall,Vocal Hall,Synth Pad Space,3D Scoring Stage,Film Room,Studio Room 40,Acoustic Guitar,80s Vocal Plate,Drum Room 12-Bit,Synthwave Wash}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-j-verb";
function psw_all(v) ( slider_show(1073741823, v); );
function psw_allg(v) ( slider_show(1073741823, v); );
ext_noinit = 1;

bv_alloc(100000);
JV_LL = 3400;

function er_grid(sz, dens) local(sx, sy, sz_, lx, ly, lz, i, j, k, n, dx, dy, dz, d, d0, t, g, az, sw, tt, gg, cnt, a) (
  sx = 11 * sz; sy = 4.5 * sz; sz_ = 2.25 * sz; lx = 11 * sz; ly = 9.3 * sz; lz = 2.7 * sz;
  d0 = sqrt(sqr(sx - lx) + sqr(sy - ly) + sqr(sz_ - lz));
  n = 0;
  i = -2; loop(5, j = -2; loop(5, k = -2; loop(5,
    a = abs(i) + abs(j) + abs(k);
    a > 0 && a <= 2 && n < 48 ? (
      dx = (i & 1 ? (i + 1) * lx - sx : i * lx + sx) - lx;
      dy = (j & 1 ? (j + 1) * ly - sy : j * ly + sy) - ly;
      dz = (k & 1 ? (k + 1) * lz - sz_ : k * lz + sz_) - lz;
      d = sqrt(dx * dx + dy * dy + dz * dz);
      t = (d - d0) / 343; g = d0 / d * (a == 1 ? 0.75 : 0.5) * (k != 0 ? 0.8 : 1);
      az = atan2(dx, dy);
      er_tl[n] = t; er_tr[n] = t;
      er_gl[n] = g * sqrt(0.5 - 0.5 * sin(az)); er_gr[n] = g * sqrt(0.5 + 0.5 * sin(az));
      n += 1;
    );
    k += 1; ); j += 1; ); i += 1; );
  sw = 1; while(sw) ( sw = 0; i = 0; loop(n - 1,
    er_tl[i] > er_tl[i + 1] ? ( tt = er_tl[i]; er_tl[i] = er_tl[i + 1]; er_tl[i + 1] = tt; er_tr[i] = er_tl[i]; er_tr[i + 1] = er_tl[i + 1];
      gg = er_gl[i]; er_gl[i] = er_gl[i + 1]; er_gl[i + 1] = gg; gg = er_gr[i]; er_gr[i] = er_gr[i + 1]; er_gr[i + 1] = gg; sw = 1; );
    i += 1; ); );
  cnt = min(floor(8 + dens * 24), n);
  i = 0; loop(cnt, er_tl[i] = max(1, floor(er_tl[i] * srate)); er_tr[i] = er_tl[i]; i += 1; );
  cnt;
);
function er_forty(sz, dens) local(i, n, t, g, p, w) (
  bv_seed(4093); n = floor(8 + 32 * dens); w = 0.3 + 0.7 * dens;
  i = 0;
  loop(n,
    t = (3 + 95 * (i / 40) ^ 1.3 + 3 * bv_rnd()) * (0.4 + 0.6 * sz);
    g = 0.8 * exp(-2.2 * i / 40) * (bv_rnd() > 0.35 ? 1 : -1);
    p = (bv_rnd() * 2 - 1) * w;
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1 + 0.02 * p) * 0.001 * srate));
    er_gl[i] = g * sqrt(0.5 - 0.5 * p); er_gr[i] = g * sqrt(0.5 + 0.5 * p);
    i += 1; );
  n;
);
function er_pattern(m, sz, dens) local(i, n, t, g, p) (
  bv_seed(m == 0 ? 3301 : 6007);
  n = m == 0 ? floor(6 + 8 * dens) : floor(3 + 4 * dens);
  i = 0;
  loop(n,
    t = (m == 0 ? 12 + i * 9 + 6 * bv_rnd() : 6 + i * 11 + 3 * bv_rnd()) * (0.5 + 0.5 * sz);
    g = 0.6 * (1 - i / (n + 3)) * (bv_rnd() > 0.5 ? 1 : -1); p = bv_rnd() * 2 - 1;
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1.05 - 0.1 * (i & 1)) * 0.001 * srate));
    er_gl[i] = g * sqrt(0.5 - 0.45 * p); er_gr[i] = g * sqrt(0.5 + 0.45 * p);
    i += 1; );
  n;
);

function jv_t60(m) ( slider6 * (m == 0 ? 1.1 : m == 1 || m == 2 ? 1.12 : 1); );
function jv_loss() local(k) (
  k = 0; loop(jv_nl, bv_loss(k, JV_LL[k]); k += 1; );
);
function jv_hash() ( (slider1 | 0) * 7 + slider9 * 1.37 + slider10 * 3.11 + (slider15 >= 0.5) * 11.3 + (slider16 | 0) * 17.9; );
function jv_hard() local(k, sz, L, lens, dens) (
  mdl = slider1 | 0;
  sz = (slider9 / 1000) ^ (1 / 3);
  dens = slider10 / 100;
  bv_t60 = jv_t60(mdl); bv_rthi = slider7; bv_rtlo = slider8;
  jv_tg = bv_t60; jv_hg = bv_rthi; jv_lg = bv_rtlo;
  bv_lox = 250; bv_hix = mdl == 3 ? 3000 : 5000;
  lens = 2300;
  mdl == 0 ? (
    er_n = er_pattern(0, sz, dens);
    lens[0] = 43.1; lens[1] = 49.7; lens[2] = 57.3; lens[3] = 61.9; lens[4] = 71.3; lens[5] = 79.1; lens[6] = 87.7; lens[7] = 97.3;
    jv_nl = 8;
    k = 0; loop(8, L = min(lens[k] * 0.001 * srate * (0.3 + 0.7 * sz), LN_N - 40); ln_len[k] = L;
      ln_apl[k] = (4.1 + 1.3 * k) * 0.001 * srate * (0.5 + 0.5 * min(sz, 1.5)); JV_LL[k] = L + ln_apl[k]; k += 1; );
  ) : mdl == 1 || mdl == 2 ? (
    er_n = mdl == 1 ? er_grid(sz, dens) : er_forty(sz, dens);
    lens[0] = 29.3; lens[1] = 34.7; lens[2] = 39.1; lens[3] = 44.9; lens[4] = 50.3; lens[5] = 57.7; lens[6] = 64.1; lens[7] = 73.9;
    jv_nl = 8;
    k = 0; loop(8, L = min(lens[k] * 0.001 * srate * (0.3 + 0.7 * sz), LN_N - 40); ln_len[k] = L; JV_LL[k] = L; ln_mod[k] = 0; k += 1; );
    fdn_apg = 0;
  ) : (
    er_n = er_pattern(3, sz, dens);
    lens[0] = 27.1; lens[1] = 33.7; lens[2] = 38.9; lens[3] = 42.3; lens[4] = 30.1; lens[5] = 36.3;
    jv_nl = 6;
    k = 0; loop(6, L = min(lens[k] * 0.001 * srate * (0.5 + 0.5 * sz), LN_N - 4); cb_len[k] = L; JV_LL[k] = L; k += 1; );
  );
  jv_loss();
  bv_xover();
  lofi_set(slider15 >= 0.5 || mdl == 3, mdl == 3 ? 31500 : mdl == 1 ? 48000 : 44100, slider16 < 0.5 ? 12 : slider16 < 1.5 ? 16 : 24);
  jv_hh = jv_hash();
);
function jv_soft() local(dp) (
  diff = slider11 / 100;
  mdl == 0 ? fdn_apg = 0.35 + 0.3 * diff;
  erd_t = slider2 * 0.001 * srate; revd_t = slider4 * 0.001 * srate;
  er_t = slider3 <= -29.9 ? 0 : 10 ^ (slider3 / 20);
  rv_t = slider5 <= -29.9 ? 0 : 10 ^ (slider5 / 20);
  lc_t = 1 - exp(-2 * $pi * slider12 / srate);
  hc_t = 1 - exp(-2 * $pi * min(slider13, srate * 0.45) / srate);
  drv_t = slider14 / 100;
  wid_t = slider17 / 100;
  dp = slider18 <= 50 ? slider18 * 0.4 : 20 + (slider18 - 50) * 1.6;
  dft = dp / 100; dspd = slider19 * (0.5 + 0.5 * dp / 20);
  mix_t = slider20 / 100; out_t = 10 ^ (slider21 / 20);
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, -0.3, 0);
  in_setup(slider26, slider27 >= 0.5);
);
function jv_clear() (
  memset(BV_PRE, 0, BV_END - BV_PRE); memset(ln_z1, 0, 30); memset(cb_z, 0, 10); memset(fdn_v, 0, 20);
  lcL = lcR = hcL = hcR = 0;
  lfiL.a = lfiL.b = lfiL.h = 0; lfiR.a = lfiR.b = lfiR.h = 0; lfoL.a = lfoL.b = 0; lfoR.a = lfoR.b = 0;
);

function setp(m, erd, erl, rvd, rvl, t, hi, lo, vol, dn, df, lc, hc, dr, ck, bt, wd, mx) (
  slider1 = m; slider2 = erd; slider3 = erl; slider4 = rvd; slider5 = rvl; slider6 = t; slider7 = hi; slider8 = lo; slider9 = vol;
  slider10 = dn; slider11 = df; slider12 = lc; slider13 = hc; slider14 = dr; slider15 = ck; slider16 = bt; slider17 = wd; slider20 = mx;
);
function load_preset(p) (
  p == 1 ? (
    setp(0, 8, -6, 24, 0, 2.8, 0.7, 1.0, 3000, 60, 60, 80, 12000, 0, 0, 0, 100, 30);
    slider18 = 50; slider19 = 0.15; slider21 = 0; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000;
    slider26 = 0; slider27 = 0;
  ) :
  p == 2 ? setp(0, 14, -10, 40, 0, 4.5, 0.5, 1.2, 8000, 60, 80, 50, 10000, 0, 0, 1, 130, 30) :
  p == 3 ? setp(0, 10, -8, 30, 0, 2.6, 0.6, 1.0, 3000, 60, 70, 100, 13000, 0, 0, 1, 120, 25) :
  p == 4 ? setp(0, 20, -12, 60, 0, 8.0, 0.5, 1.5, 12000, 50, 90, 50, 10000, 0, 0, 1, 140, 40) :
  p == 5 ? setp(1, 8, -4, 24, -2, 2.2, 0.6, 1.0, 6000, 80, 70, 50, 13000, 0, 0, 1, 110, 30) :
  p == 6 ? setp(1, 4, -2, 12, -4, 1.0, 0.7, 1.0, 900, 70, 60, 100, 13000, 0, 0, 1, 100, 25) :
  p == 7 ? setp(2, 2, -3, 8, -6, 0.7, 0.8, 1.0, 250, 100, 50, 100, 13000, 0, 0, 1, 110, 25) :
  p == 8 ? setp(2, 4, -4, 14, -3, 1.3, 0.7, 0.9, 700, 80, 60, 100, 10000, 0, 1, 1, 120, 25) :
  p == 9 ? setp(3, 6, -12, 20, 0, 2.0, 0.5, 1.0, 1200, 50, 60, 100, 10000, 0, 1, 0, 110, 30) :
  p == 10 ? setp(3, 2, -8, 6, 0, 1.0, 0.6, 1.0, 400, 60, 40, 100, 10000, 20, 1, 0, 100, 30) :
  p == 11 ? setp(0, 30, -14, 80, 0, 12, 0.4, 1.3, 12000, 40, 90, 100, 10000, 0, 1, 1, 150, 45);
  slider_automate(134217727);
);

drA.drift_init(0.8 + rand(1) * 0.5); drB.drift_init(0.8 + rand(1) * 0.5);
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
jv_sm = 1 - exp(-1 / (0.03 * srate));
jv_sd = 1 - exp(-1 / (0.06 * srate));
jv_soft(); jv_hard();
mix_s = mix_t; out_s = out_t; er_s = er_t; rv_s = rv_t; lc_c = lc_t; hc_c = hc_t; drv = drv_t; wid = wid_t;
erd_s = erd_t; revd_s = revd_t;
jv_dkr = 1 / (0.012 * srate); jv_dk = 1; jv_dst = 0;
jv_ipk_d = 0; jv_gf = 1; jv_gfr = 1 / (0.015 * srate);

by_setup(28);
pwr_init(); pwr_wu_loss = 0.4; pwr_wu_drv = 0.6; pwr_wu_lp = 11000; pwr_bloom = 0;
#jv_pm = "Init|Massive Hall|Vocal Hall|Synth Pad Space|3D Scoring Stage|Film Room|Studio Room 40|Acoustic Guitar|80s Vocal Plate|Drum Room 12-Bit|Synthwave Wash";
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(28, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
jv_soft();
jv_dst == 0 && jv_hash() != jv_hh ? jv_dst = 1;

@block
prs_chk();
jv_now = time_precise();
jv_tp > 0 && jv_now - jv_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > jv_gpp && play_position - jv_gpp < 4 * jv_gpd + 0.05) ? (
  jv_clear(); jv_dk = 0; jv_dst = 2; jv_gf = 0;
);
jv_tp = jv_now; jv_gpp = play_position; jv_gpd = samplesblock / srate;
jv_soft();
jv_dst == 0 && jv_hash() != jv_hh ? jv_dst = 1;
jv_dst == 0 ? (
  jv_g = min(1, samplesblock / (0.08 * srate));
  jv_tt = jv_t60(mdl);
  abs(jv_tt - jv_tg) > 0.0005 || abs(slider7 - jv_hg) > 0.0005 || abs(slider8 - jv_lg) > 0.0005 ? (
    jv_tg += (jv_tt - jv_tg) * jv_g; jv_hg += (slider7 - jv_hg) * jv_g; jv_lg += (slider8 - jv_lg) * jv_g;
    abs(jv_tt - jv_tg) < 0.001 ? jv_tg = jv_tt; abs(slider7 - jv_hg) < 0.001 ? jv_hg = slider7; abs(slider8 - jv_lg) < 0.001 ? jv_lg = slider8;
    bv_t60 = jv_tg; bv_rthi = jv_hg; bv_rtlo = jv_lg; jv_loss();
  );
);
vA = drA.drift_tick(dspd * samplesblock / srate); vB = drB.drift_tick(dspd * samplesblock / srate);
mdl == 0 ? ( k = 0; loop(8, ln_mod[k] = dft * 2 * (k & 1 ? vA : vB) * (0.5 + 0.1 * k); k += 1; ); ) : ( bv_hdrift = 1 + 0.2 * dft * vA; bv_xover(); );
mdl == 3 ? ( lf_inc = 31500 * (1 + 0.0004 * dft * vB) / srate; );
pwr_block(byp_on < 0.5);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
jv_dst == 1 ? ( jv_dk -= jv_dkr; jv_dk <= 0 ? (
  jv_dk = 0; jv_hard(); jv_clear(); jv_dst = 2;
  erd_s = erd_t; revd_s = revd_t;
); ) :
jv_dst == 2 ? ( jv_dk += jv_dkr; jv_dk >= 1 ? ( jv_dk = 1; jv_dst = 0; ); );
by_in();
in_process(spl0, spl1);
pwr_in(in_l, in_r);
inL = pwr_l; inR = pwr_r;
jv_ipk_d = max(jv_ipk_d, max(abs(inL), abs(inR)));
mix_s += (mix_t - mix_s) * jv_sm; out_s += (out_t - out_s) * jv_sm;
er_s += (er_t - er_s) * jv_sm; rv_s += (rv_t - rv_s) * jv_sm;
lc_c += (lc_t - lc_c) * jv_sm; hc_c += (hc_t - hc_c) * jv_sm;
drv += (drv_t - drv) * jv_sm; wid += (wid_t - wid) * jv_sm;
erd_s += (erd_t - erd_s) * jv_sd; revd_s += (revd_t - revd_s) * jv_sd;

xl = xfL.xfm_run(inL, drv, 0); xr = xfR.xfm_run(inR, drv, 0);
xl = lfiL.lofi_in(xl); xr = lfiR.lofi_in(xr);
jv_dst ? ( jv_dkg = jv_dk * jv_dk * (3 - 2 * jv_dk); xl *= jv_dkg; xr *= jv_dkg; );
bv_pre(xl, xr);
jv_rp = pre_w - 1 - erd_s; jv_rp < 0 ? jv_rp += PRE_N; jv_ri = floor(jv_rp); jv_rf = jv_rp - jv_ri; jv_rj = jv_ri + 1; jv_rj >= PRE_N ? jv_rj = 0;
er_run(0.5 * (BV_PRE[jv_ri] + (BV_PRE[jv_rj] - BV_PRE[jv_ri]) * jv_rf + BV_PRE[PRE_N + jv_ri] + (BV_PRE[PRE_N + jv_rj] - BV_PRE[PRE_N + jv_ri]) * jv_rf));
jv_rp = pre_w - 1 - revd_s; jv_rp < 0 ? jv_rp += PRE_N; jv_ri = floor(jv_rp); jv_rf = jv_rp - jv_ri; jv_rj = jv_ri + 1; jv_rj >= PRE_N ? jv_rj = 0;
tl = BV_PRE[jv_ri] + (BV_PRE[jv_rj] - BV_PRE[jv_ri]) * jv_rf;
tr = BV_PRE[PRE_N + jv_ri] + (BV_PRE[PRE_N + jv_rj] - BV_PRE[PRE_N + jv_ri]) * jv_rf;
mdl == 0 ? (
  dif_run(tl + 0.15 * er_ol, tr + 0.15 * er_or, diff, 1.3);
  fdn_run(dif_l, dif_r); wl = fdn_l; wr = fdn_r;
) : mdl == 1 || mdl == 2 ? (
  dif_run(tl + 0.3 * er_ol, tr + 0.3 * er_or, mdl == 1 ? 0.5 + 0.5 * diff : diff * 0.8, 1);
  fdn_run(dif_l, dif_r); wl = fdn_l; wr = fdn_r;
) : (
  dif_run(tl, tr, diff * 0.6, 0.6);
  cmb_run(dif_l * 0.5, dif_r * 0.5); wl = cmb_l; wr = cmb_r;
);
wl = er_s * er_ol + rv_s * wl; wr = er_s * er_or + rv_s * wr;
wl = lfoL.lofi_out(wl); wr = lfoR.lofi_out(wr);
jv_dst ? ( wl *= jv_dkg; wr *= jv_dkg; );
lcL += (wl - lcL) * lc_c; wl -= lcL; lcR += (wr - lcR) * lc_c; wr -= lcR;
hcL += (wl - hcL) * hc_c; wl = hcL; hcR += (wr - hcR) * hc_c; wr = hcR;
wm = 0.5 * (wl + wr); ws = 0.5 * (wl - wr) * wid; wl = wm + ws; wr = wm - ws;
jv_rvl_d = max(jv_rvl_d, max(abs(wl), abs(wr)));
oL = inL * (1 - mix_s) + wl * mix_s;
oR = inR * (1 - mix_s) + wr * mix_s;
pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
oL = ostL.ost_band(oL) * out_s; oR = ostR.ost_band(oR) * out_s;
ost_out(oL, oR);
spl0 = ost_l; spl1 = ost_r;
by_out();
jv_gf < 1 ? ( jv_gf = min(jv_gf + jv_gfr, 1); jv_gs = jv_gf * jv_gf * (3 - 2 * jv_gf); spl0 = by_il + (spl0 - by_il) * jv_gs; spl1 = by_ir + (spl1 - by_ir) * jv_gs; );
jv_opl_d = max(jv_opl_d, abs(spl0)); jv_opr_d = max(jv_opr_d, abs(spl1));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
