);

pwr_out(cb_yl, cb_yr); cb_yl = pwr_l; cb_yr = pwr_r;
cb_og += (cb_ogt - cb_og) * cb_ks; cb_yl *= cb_og; cb_yr *= cb_og;
cb_yl != cb_yl ? cb_yl = 0; cb_yr != cb_yr ? cb_yr = 0;
cb_yl = osbL.ost_band(cb_yl); cb_yr = osbR.ost_band(cb_yr);
ost_out(cb_yl, cb_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
cb_a = max(abs(spl0), abs(spl1)); cb_a > cb_pk2 ? cb_pk2 = cb_a;
by_out();

@gfx 900 400
ui_begin(900, 400);
v5_begin();
CBF = 0x181A2E; CBP = 0x20233A; CBB = 0x0A0B16; CBI = 0xE8E8F6; CBA = 0xFF4AA8; CBH = 0x3A0C2A; CBV = 0xFFD060;
sc != cb_fsc ? (
  cb_fsc = sc;
  cb_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  cb_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  cb_f6 = ui_fitfont(6, 24 * sc);
);
function cb_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * cb_kt * sc, 'b'); );
function cb_fa(px) ( gfx_setfont(10, "Arial", px * cb_ka * sc, 'b'); );
function cb_fc(px) ( gfx_setfont(12, "Courier New", px * cb_kt * sc, 'b'); );
function cb_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function cb_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function cb_lum(c) ( (0.2126 * ((c >> 16) & 255) + 0.7152 * ((c >> 8) & 255) + 0.0722 * (c & 255)) / 255; );
function cb_kd(cx, cy, a, capr, at, sz) ( v5_d(cx + sin(a) * capr * at, cy - cos(a) * capr * at, max(capr * sz, 2)); );
function cb_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  gfx_gradrect(x * sc, y * sc, w * sc, h * sc, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (h * sc), (g2 - g1) / (h * sc), (b2 - b1) / (h * sc), 0);
);
function cb_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function cb_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.16); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
