os_tf = os_f2n(slider47);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
fx_dt = slider34 >= 0.5; fx_ft = slider38 >= 0.5; fx_et = slider42 >= 0.5;
fx_ddt = min(max(slider35, 0), 100) / 100;
sb_target(12 - 24 * fx_ddt, 0.5 + 0.8 * fx_ddt, 1, 220, 1); sb_ctl(1);
