fx_mxt = min(max(slider45, 0), 100) / 100;
fx_pp = slider46 >= 0.5;
fx_ge <= 0 && !fx_et && !fx_dz ? fx_dclr();
fx_ge <= 0 ? ( fx_ta = fx_tb = fx_tt; fx_xf = 0; );
fx_ge > 0 ? fx_dz = 0;
flt.fx_lptidy();

cb_i = 0; loop(16, ST[cb_i] = max(0, min(8, slider(6 + cb_i) | 0)); cb_i += 1; );
cb_len = max(1, min(16, slider5 | 0));
cb_sl = cb_rate(max(0, min(4, slider1 | 0)));
cb_sw = 0;
cb_hum = slider4;
cb_aa = slider22 / 100; cb_ad = slider23 / 100; cb_as = slider24 / 100; cb_ar = slider25 / 100;
cb_atv = slider22 < 0.5 && slider25 < 0.5 && slider24 > 99.5;
cb_ea = slider26 / 100; cb_ed = slider27 / 100; cb_es = slider28 / 100; cb_er = slider29 / 100;
cb_etv = slider26 < 0.5 && slider29 < 0.5 && slider28 > 99.5;

cb_x = (min(max(slider3, 1), 20) - 1) / 19;
cb_dt = samplesblock / srate;
cb_dv = dCh.drift_tick(cb_dt * (0.15 + 0.35 * (1 - cb_x)));
cb_ms = (0.5 - cb_x) * 30 + cb_dv * (0.4 + 9 * (1 - cb_x) * (1 - cb_x));
cb_bps = max(tempo, 20) / 60 / srate;
vA.on ? vA.Ln = cb_slen(vA.sl);
vB.on ? vB.Ln = cb_slen(vB.sl);

cb_run = play_state & 1;
cb_run ? cb_pos = beat_position : (
  cb_av == 1 ? vA.tg = 0 : cb_av == 2 ? vB.tg = 0;
  cb_av = 0; cb_li = -1000000000; cb_play_d = -1;
);
cb_offb = cb_ms * 0.001 * max(tempo, 20) / 60;

cb_otl_d = max(cb_otl_d, cb_pk2); cb_pk2 = 0;
os_snapb(slider(47));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
cb_xl = spl0; cb_xr = spl1;
pwr_in(cb_xl, cb_xr); cb_xl = pwr_l; cb_xr = pwr_r;
abs(cb_xl) < 0.000000000000001 ? cb_xl = 0; abs(cb_xr) < 0.000000000000001 ? cb_xr = 0;
BL[cb_wp] = cb_xl; BR[cb_wp] = cb_xr;

cb_run ? (
  cb_q = cb_pos - cb_offb - cb_jit;
  cb_pr = floor(cb_q / (2 * cb_sl)); cb_rr = cb_q - cb_pr * 2 * cb_sl;
  cb_ix = cb_pr * 2 + (cb_rr >= cb_sl * (1 + cb_sw) ? 1 : 0);
  cb_ix > cb_li || cb_ix < cb_li - 2 ? (
    cb_li = cb_ix;
    cb_k = cb_ix - floor(cb_ix / cb_len) * cb_len;
    cb_trig(cb_k);
    cb_jit = cb_hum > 0.5 ? (rand(1) * 2 - 1) * 0.004 * max(tempo, 20) / 60 : 0;
  );
  cb_pos += cb_bps;
);

cb_wa = vA.vo_run(); cb_wb = vB.vo_run();
cb_wd = max(0, 1 - cb_wa - cb_wb);
cb_yl = cb_xl * cb_wd + vA.ol + vB.ol;
cb_yr = cb_xr * cb_wd + vA.orr + vB.orr;
cb_wp = (cb_wp + 1) & BM;

fx_gd != fx_dt ? ( fx_gd == 0 ? ( sbL.sb_clr(); sbR.sb_clr(); fx_ce = 0; ); fx_gd = fx_dt ? min(fx_gd + fx_es, 1) : max(fx_gd - fx_es, 0); );
fx_gf != fx_ft ? ( fx_gf == 0 ? flt.fx_lpclr(); fx_gf = fx_ft ? min(fx_gf + fx_es, 1) : max(fx_gf - fx_es, 0); );
fx_ge != fx_et ? ( fx_ge = fx_et ? min(fx_ge + fx_es2, 1) : max(fx_ge - fx_es2, 0); );
fx_dd += (fx_ddt - fx_dd) * cb_ks; sb_glide(cb_ks, cb_ks); fx_hp += (fx_hpt - fx_hp) * cb_ks; fx_lrs += (fx_lr - fx_lrs) * cb_ks; fx_dmx += (fx_dmt - fx_dmx) * cb_ks;
fx_lfc += (fx_lft - fx_lfc) * cb_ks; fx_k += (fx_kt - fx_k) * cb_ks; fx_env += (fx_envt - fx_env) * cb_ks;
fx_mx += (fx_mxt - fx_mx) * cb_ks; fx_fbs += (fx_fb - fx_fbs) * cb_ks;
fx_ed = fx_gd * fx_gd * (3 - 2 * fx_gd); fx_ef = fx_gf * fx_gf * (3 - 2 * fx_gf);
fx_sy && cb_run ? ( fx_lph = cb_pos / fx_bp; fx_lph -= floor(fx_lph); ) : ( fx_lph += fx_lrs / srate; fx_lph >= 1 ? fx_lph -= 1; );
fx_lfo = sin(2 * $pi * fx_lph);
fx_lfs += (fx_lfo - fx_lfs) * fx_lk;
fx_lgf = fx_lft2 ? min(fx_lgf + fx_es, 1) : max(fx_lgf - fx_es, 0);
fx_dm = fx_ed * fx_dmx;
fx_fc = exp(fx_lfc + fx_lgf * fx_lfs * 1.3862943611198906);
fx_hk = 1 - exp(-2 * $pi * exp(fx_hp) / fx_fs);
fx_th = -14 - 14 * fx_dd; fx_sp = 1 - 1 / (1 + 3 * fx_dd); fx_mkp = 0.6 * (-8 - fx_th) * fx_sp + 2 * fx_dd;
cb_lfo_d = fx_lfs;
os_gate();
os_chg ? ( fx_rate(); fx_clr(); );
ouL.os_up(cb_yl); ouR.os_up(cb_yr);
fx_j = 0;
loop(os_f,
  fx_a = ouL.os_s(fx_j); fx_b = ouR.os_s(fx_j);
  fx_sl += fx_hk * (fx_a - fx_sl); fx_sr += fx_hk * (fx_b - fx_sr);
  fx_ql += fx_hk2 * (fx_a - fx_ql); fx_qr += fx_hk2 * (fx_b - fx_qr);
  fx_gd > 0 ? (
    fx_ma = fx_ql - fx_sl; fx_mb = fx_qr - fx_sr;
    fx_e = max(abs(fx_ma), abs(fx_mb)); fx_ce += (fx_e > fx_ce ? fx_ca : fx_cr) * (fx_e - fx_ce);
    fx_cg = exp((fx_mkp - max(0, 8.685889638 * log(fx_ce + 0.000000001) - fx_th) * fx_sp) * 0.11512925464970228);
    fx_ma *= fx_cg; fx_mb *= fx_cg;
    fx_u = fx_sl + fx_a - fx_ql + fx_ma + sbL.sb_run(fx_ma); fx_v = fx_sr + fx_b - fx_qr + fx_mb + sbR.sb_run(fx_mb);
    fx_a += fx_dm * (fx_u - fx_a); fx_b += fx_dm * (fx_v - fx_b);
  );
  fx_gf > 0 ? (
    flt.fx_lp(fx_a, fx_b);
    fx_a += fx_ef * (fx_oa - fx_a); fx_b += fx_ef * (fx_ob - fx_b);
  );
  fx_j == 0 ? ( fx_p0l = fx_a; fx_p0r = fx_b; ) : fx_j == 1 ? ( fx_p1l = fx_a; fx_p1r = fx_b; ) :
  fx_j == 2 ? ( fx_p2l = fx_a; fx_p2r = fx_b; ) : ( fx_p3l = fx_a; fx_p3r = fx_b; );
  fx_j += 1;
);
cb_yl = odL.os_dn(fx_p0l, fx_p1l, fx_p2l, fx_p3l); cb_yr = odR.os_dn(fx_p0r, fx_p1r, fx_p2r, fx_p3r);
os_g < 1 ? ( cb_yl *= os_g; cb_yr *= os_g; );
fx_dy1 = cb_yl - fx_dc1 + fx_dcr * fx_dy1; fx_dc1 = cb_yl;
fx_dy2 = cb_yr - fx_dc2 + fx_dcr * fx_dy2; fx_dc2 = cb_yr;
cb_yl += fx_ed * (fx_dy1 - cb_yl); cb_yr += fx_ed * (fx_dy2 - cb_yr);
thk_proc(cb_yl, cb_yr, fx_tk && fx_dt); cb_yl = thk_l; cb_yr = thk_r;

fx_ge > 0 ? (
  fx_xf > 0 ? ( fx_xf = max(fx_xf - fx_xs, 0); fx_xf == 0 ? fx_ta = fx_tb; ) : fx_tt != fx_ta ? ( fx_tb = fx_tt; fx_xf = 1; );
  fx_dl = min(max(fx_ta, 3), fx_dn - 4);
  fx_dr = min(max(fx_ta * (1 + 0.015 * (1 - fx_pg)), 3), fx_dn - 4);
  fx_el = fx_rd(DLB, fx_dl); fx_er = fx_rd(DRB, fx_dr);
  fx_xf > 0 ? (
    fx_dl = min(max(fx_tb, 3), fx_dn - 4);
    fx_dr = min(max(fx_tb * (1 + 0.015 * (1 - fx_pg)), 3), fx_dn - 4);
    fx_xw = fx_xf * fx_xf * (3 - 2 * fx_xf);
    fx_el = fx_rd(DLB, fx_dl) + (fx_el - fx_rd(DLB, fx_dl)) * fx_xw; fx_er = fx_rd(DRB, fx_dr) + (fx_er - fx_rd(DRB, fx_dr)) * fx_xw;
  );
  fx_fl = lpA.fx_loop(fx_el) * fx_fbs; fx_fr = lpB.fx_loop(fx_er) * fx_fbs;
  fx_ee = fx_ge * fx_ge * (3 - 2 * fx_ge);
  fx_pg = fx_pp ? min(fx_pg + fx_es2, 1) : max(fx_pg - fx_es2, 0);
  fx_pw = fx_pg * fx_pg * (3 - 2 * fx_pg);
  DLB[fx_w] = cb_yl * fx_ee + fx_fl + fx_pw * (0.5 * (cb_yr - cb_yl) * fx_ee + fx_fr - fx_fl);
  DRB[fx_w] = cb_yr * fx_ee + fx_fr + fx_pw * (fx_fl - cb_yr * fx_ee - fx_fr);
