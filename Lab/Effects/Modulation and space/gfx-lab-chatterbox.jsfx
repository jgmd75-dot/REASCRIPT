fx_dmt = min(max(slider37, 0), 100) / 100;
fx_lft = log(min(max(slider39, 20), 12000));
fx_kt = min(max(slider40, 0), 100) / 100 * 3.6;
fx_envt = min(max(slider41, -100), 100) / 100;
