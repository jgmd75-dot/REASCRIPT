desc:Swale [spring reverb] (GFX Lab)
//tags: reverb spring tank drip chirp dwell surf dub space
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-v5-palette, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider18:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:40<0,100,1>-Dwell (%)
slider3:50<0,100,1>-Tension (%)
slider4:50<0,100,1>-Drip (%)
slider5:2.2<0.5,6,0.01>-Decay (s)
slider6:50<0,100,1>-Length (%)
slider7:1<0,3,1{Combo,Long,Studio,Grand}>-Tank model
slider8:0<0,200,1>-Pre-delay (ms)
slider9:110<20,1100,1>-High-pass filter (Hz)
slider10:4400<1100,7700,1>-Low-pass filter (Hz)
slider11:50<0,100,1>-Tone (%)
slider12:30<0,100,1>-Mix (%)
slider13:0<-12,12,0.1>-Output (dB)
slider14:10<0,100,1>-Saturation (%)
slider15:50<0,100,1>-Drift (%)
slider16:0<0,1,1{Off,Kick now}>-Kick the tank
slider17:prs_sel=0<0,12,1{No preset,Init,Surf Drip,Combo Amp,Studio Tank,Long Tank,Slack Coil,Tight Wire,Dub Splash,Dark Box,Vocal Spring,Grand Tank,Lo-Fi Coil}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(2147483647, v); );
function psw_allg(v) ( slider_show(2147483647, v); );
#ui_man = "gfx-lab-swale";
ext_noinit = 1;

SW_SP = 1000000; SW_SN = 8192; SW_AP = 1100000; SW_M = 40; SW_PB = 1200000; SW_PN = 16384; SW_ST = 1300000; SW_LD = 1310000; SW_HB = 1400000; SW_MT = 1330000;
function sw_mdef(m, ns, mm, tf, ro, cp, hl, l0, l1, l2, l3, l4, l5) local(o) (
  o = SW_MT + m * 64; o[0] = ns; o[1] = mm; o[2] = tf; o[3] = ro; o[4] = cp; o[5] = hl;
  o[8] = l0; o[9] = l1; o[10] = l2; o[11] = l3; o[12] = l4; o[13] = l5;
);
function sw_mpan(m, a0, b0, a1, b1, a2, b2, a3, b3, a4, b4, a5, b5) local(o, k, e) (
  o = SW_MT + m * 64; o[16] = a0; o[24] = b0; o[17] = a1; o[25] = b1; o[18] = a2; o[26] = b2;
  o[19] = a3; o[27] = b3; o[20] = a4; o[28] = b4; o[21] = a5; o[29] = b5;
  e = 0; k = 0; loop(o[0], e += o[16 + k] * o[16 + k]; k += 1; ); o[6] = 1 / sqrt(max(e, 0.01));
);
sw_mdef(0, 2, 40, 1.15, 0, 0.02, 0.3, 27.1, 33.7, 0, 0, 0, 0);
sw_mdef(1, 3, 40, 1, 0, 0.04, 0.35, 35.3, 41.9, 47.7, 0, 0, 0);
sw_mdef(2, 4, 30, 0.9, 0, 0.1, 0.25, 39.1, 44.3, 51.7, 57.1, 0, 0);
sw_mdef(3, 6, 20, 0.85, -0.03, 0.14, 0.2, 41.3, 46.9, 52.3, 58.7, 63.1, 69.7);
sw_mpan(0, 0.95, 0.3, 0.3, 0.95, 0, 0, 0, 0, 0, 0, 0, 0);
sw_mpan(1, 0.85, 0.2, 0.2, 0.85, 0.55, 0.55, 0, 0, 0, 0, 0, 0);
sw_mpan(2, 0.9, 0.15, 0.15, 0.9, 0.7, 0.4, 0.4, 0.7, 0, 0, 0, 0);
sw_mpan(3, 0.85, 0.1, 0.1, 0.85, 0.65, 0.35, 0.35, 0.65, 0.75, 0.2, 0.2, 0.75);
SW_MT[300] = 1; SW_MT[301] = 1.07; SW_MT[302] = 0.94; SW_MT[303] = 1.12; SW_MT[304] = 0.9; SW_MT[305] = 1.04;
SW_MT[310] = 0.37; SW_MT[311] = 0.53; SW_MT[312] = 0.71; SW_MT[313] = 0.43; SW_MT[314] = 0.61; SW_MT[315] = 0.29;

function sw_db(d) ( exp(d * 0.11512925465); );
function sw_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * srate)); );

function bq_lp(f, q, fs) instance(b0, b1, b2, a1, a2) local(w, cw, al, q0) (
  w = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w); al = sin(w) / (2 * q); q0 = 1 + al;
  b0 = (1 - cw) * 0.5 / q0; b1 = (1 - cw) / q0; b2 = b0; a1 = -2 * cw / q0; a2 = (1 - al) / q0;
);
function bq_hp(f, q, fs) instance(b0, b1, b2, a1, a2) local(w, cw, al, q0) (
  w = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w); al = sin(w) / (2 * q); q0 = 1 + al;
  b0 = (1 + cw) * 0.5 / q0; b1 = -(1 + cw) / q0; b2 = b0; a1 = -2 * cw / q0; a2 = (1 - al) / q0;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );

function sw_sf(u) ( u / sqrt(1 + u * u); );

function sw_setup() local(n) (
  sw_byp = slider1 >= 0.5;
  sw_dwt = min(max(slider2, 0), 100) / 100;
  sw_tnt = min(max(slider3, 0), 100) / 100;
  sw_drt = min(max(slider4, 0), 100) / 100;
  sw_dct = min(max(slider5, 0.5), 6);
  sw_lnt = min(max(slider6, 0), 100) / 100;
  sw_mdt = min(max(floor(slider7 + 0.5), 0), 3);
  sw_pdt = min(max(slider8, 0), 200) * 0.001;
  sw_hpt = min(max(slider9, 20), 1100);
  sw_lpt = min(max(slider10, 1100), 7700);
  sw_tot = min(max(slider11, 0), 100) / 100;
  sw_mixt = min(max(slider12, 0), 100) / 100;
  sw_outt = sw_db(min(max(slider13, -12), 12));
  sw_sat = min(max(slider14, 0), 100) / 100;
  sw_dft = min(max(slider15, 0), 100) / 50;
  sw_dwg = sw_db(-6 + 30 * sw_dwt);
);

function sw_sclr(k) local(o) (
  o = SW_ST + k * 32;
  memset(SW_SP + k * SW_SN, 0, SW_SN); memset(SW_HB + k * SW_SN, 0, SW_SN); memset(SW_AP + k * 128, 0, 128);
  o[3] = 0; o[5] = 0; o[17] = 0;
);

function sw_clear() local(k) (
  k = 0; loop(6, sw_sclr(k); SW_ST[k * 32 + 18] = 0; SW_ST[k * 32] = 0; k += 1; );
  memset(SW_PB, 0, SW_PN);
  aa0.bq_clr(); aa1.bq_clr(); aa2.bq_clr(); ul1.bq_clr(); ul2.bq_clr(); ur1.bq_clr(); ur2.bq_clr();
  hp1.bq_clr(); ll1.bq_clr(); lr1.bq_clr();
  sw_x1 = sw_bias; sw_f1 = sqrt(1 + sw_bias * sw_bias);
  sw_pl = sw_pr = sw_cl = sw_cr = 0; sw_xh = 0; sw_rsp = 0; sw_kn = 0; sw_wo = 0;
);

function sw_coef() (
  hp1.bq_hp(sw_hpc, 0.70710678, sw_tr);
  ll1.bq_lp(sw_lpc, 0.70710678, sw_tr); lr1.b0 = ll1.b0; lr1.b1 = ll1.b1; lr1.b2 = ll1.b2; lr1.a1 = ll1.a1; lr1.a2 = ll1.a2;
  sw_dpc = 1 - exp(-2 * $pi * min(sw_ftc * 1.6, 0.42 * sw_tr) / sw_tr);
  sw_hfc = 1 - exp(-2 * $pi * min(sw_ftc * 1.2, 0.42 * sw_tr) / sw_tr);
);

function sw_srinit() local(k, o) (
  sw_sr = srate;
  sw_dec = max(1, floor(srate / 24000 + 0.5));
  sw_tr = srate / sw_dec;
  sw_aaf = min(0.35 * sw_tr, 7700);
  aa0.bq_lp(sw_aaf, 0.70710678, srate);
  aa1.bq_lp(sw_aaf, 0.5411961, srate); aa2.bq_lp(sw_aaf, 1.3065630, srate);
  ul1.bq_lp(sw_aaf, 0.5411961, srate); ul2.bq_lp(sw_aaf, 1.3065630, srate);
  ur1.bq_lp(sw_aaf, 0.5411961, srate); ur2.bq_lp(sw_aaf, 1.3065630, srate);
  sw_kc = 1 - exp(-16 / (0.05 * sw_tr)); sw_kg = 1 - exp(-16 / (0.03 * sw_tr)); sw_kl = 1 - exp(-16 / (0.15 * sw_tr));
  sw_dcc = 1 - exp(-2 * $pi * 30 / sw_tr);
  sw_km = sw_tc(0.03);
  sw_fis = 1 / (0.01 * srate); sw_mxs = 1 / (0.02 * srate);
  sw_lvr = exp(-16 / (0.12 * sw_tr));
  sw_pw = 0; sw_spw = 0; sw_ph = 0; sw_cc = 0;
  sw_setup();
  sw_mdl = sw_mdt; sw_mx = 1;
  sw_dw = sw_dwg; sw_tn = sw_tnt; sw_dr = sw_drt; sw_dc = sw_dct; sw_ln = sw_lnt; sw_to = sw_tot;
  sw_pd = sw_pdt * sw_tr; sw_df = sw_dft;
  sw_hpc = sw_hpt; sw_lpc = sw_lpt; sw_ftc = 1650 * (10 / 3) ^ sw_tn;
  sw_coef();
  k = 0; loop(6, o = SW_ST + k * 32;
    o[12] = k * 2.1; o[13] = 0; o[14] = rand(1) * 2 - 1; o[15] = 0; o[16] = 16 * 0.3 / sw_tr; o[22] = 0;
    k += 1; );
  sw_clear();
);

function sw_ctl() local(k, o, ft, w, r, dt, g, lsc, pl, pr, md, ns) (
  md = SW_MT + sw_mdl * 64; ns = md[0]; sw_ns = ns; sw_mm = md[1]; sw_cpl = md[4]; sw_hlv = md[5]; sw_mn = md[6];
  sw_tn += (sw_tnt - sw_tn) * sw_kc;
  sw_dr += (sw_drt - sw_dr) * sw_kc;
  sw_dc += (sw_dct - sw_dc) * sw_kc;
  sw_ln += (sw_lnt - sw_ln) * sw_kl;
  sw_to += (sw_tot - sw_to) * sw_kc;
  sw_df += (sw_dft - sw_df) * sw_kc;
  sw_pd += (sw_pdt * sw_tr - sw_pd) * sw_kc;
  sw_ftc = 1650 * (10 / 3) ^ sw_tn * md[2];
  sw_hpc += (sw_hpt - sw_hpc) * sw_kc; sw_lpc += (sw_lpt - sw_lpc) * sw_kc;
  sw_coef();
  sw_dmp = 0.6 * (1 - sw_to) * sqrt(1 - sw_to) + 0.03;
  r = min(0.45 + 0.45 * sw_dr ^ 0.7 + md[3], 0.92);
  lsc = 0.55 * (1.6 / 0.55) ^ sw_ln;
  sw_mdp = (0.00008 + 0.00012 * sw_df) * sw_tr;
  k = 0;
  loop(6, o = SW_ST + k * 32;
    o[1] = k < ns ? 1 : 0;
    pl = md[16 + k] * sw_mn; pr = md[24 + k] * sw_mn;
    o[15] += o[16];
    o[15] >= 1 ? ( o[15] -= 1; o[13] = o[14]; o[14] = rand(1) * 2 - 1; o[16] = 16 * (0.12 + rand(1) * 0.25) / sw_tr; );
    o[22] = o[13] + (o[14] - o[13]) * (0.5 - 0.5 * cos($pi * o[15]));
    o[12] += 16 * 2 * $pi * SW_MT[310 + k] / sw_tr; o[12] > 2 * $pi ? o[12] -= 2 * $pi;
    ft = sw_ftc * SW_MT[300 + k] * (1 + 0.02 * sw_df * o[22]);
    w = 2 * $pi * min(ft, 0.42 * sw_tr) / sw_tr;
    dt = md[8 + k] * 0.001 * sw_tr * lsc * (1 + 0.003 * sw_df * o[22]) - 2 * sw_mm + sw_mdp * sin(o[12]);
    dt = min(max(dt, 24), SW_SN - 8);
    g = exp(-6.9077553 * (dt + 2 * sw_mm) / sw_tr / sw_dc) / (1 + sw_cpl);
    o[1] > 0 && !o[18] ? (
      sw_sclr(k); o[18] = 1; o[0] = 0; o[2] = dt; o[6] = -2 * r * cos(w); o[7] = r * r; o[8] = pl; o[9] = pr;
    );
    o[18] ? (
      o[0] += (o[1] - o[0]) * sw_kg; abs(o[0] - o[1]) < 0.0001 ? o[0] = o[1];
      o[8] += (pl - o[8]) * sw_kg; o[9] += (pr - o[9]) * sw_kg;
      o[6] += (-2 * r * cos(w) - o[6]) * sw_kc; o[7] += (r * r - o[7]) * sw_kc;
      o[10] = (dt - o[2]) / 16;
      o[11] = g; o[19] = sqrt(1 - g * g);
      o[1] == 0 && o[0] == 0 ? ( o[18] = 0; sw_sclr(k); );
    );
    SW_LD[k] = max(SW_LD[k] * sw_lvr, o[17]); o[17] = 0;
    SW_LD[8 + k] = o[18] ? o[0] : 0;
    k += 1; );
);

function sw_rd(b, p) local(i, t, j) (
  p < 0 ? p += SW_SN; i = floor(p); t = p - i; i = i & (SW_SN - 1); j = (i + 1) & (SW_SN - 1);
  b[i] + (b[j] - b[i]) * t;
);

function sw_tank(x) local(k, o, b, a, c1, c2, v, w, rd, y, p, kv, i, t, j, xh, rs, hb, hv) (
  sw_cc == 0 ? sw_ctl();
  sw_cc = (sw_cc + 1) & 15;
  SW_PB[sw_pw] = x;
  sw_pd > 0.5 ? (
    p = sw_pw - sw_pd; p < 0 ? p += SW_PN; i = floor(p); t = p - i; j = (i + 1) & (SW_PN - 1);
    x = SW_PB[i] + (SW_PB[j] - SW_PB[i]) * t;
  );
  sw_pw = (sw_pw + 1) & (SW_PN - 1);
  x = hp1.bq_run(x);
  sw_kn > 0 ? (
    sw_kt += 1; t = sw_kt / sw_klen;
    kv = sin($pi * t); kv *= kv;
    sw_kz += ((rand(2) - 1) - sw_kz) * 0.35;
    x += sw_ka * kv * (0.8 * sin(2 * $pi * 41 * sw_kt / sw_tr) + 0.9 * sw_kz) * (1 - t);
    sw_kt >= sw_klen ? sw_kn = 0;
  );
  sw_xh += (x - sw_xh) * sw_hfc; xh = x - sw_xh;
  sw_wl = sw_wr = 0; rs = 0;
  k = 0;
  loop(6, o = SW_ST + k * 32;
    o[18] ? (
      b = SW_SP + k * SW_SN;
      o[2] += o[10];
      rd = sw_rd(b, sw_spw - o[2]);
      o[3] += (rd - o[3]) * sw_dpc; rd += (o[3] - rd) * sw_dmp;
      o[5] += (rd - o[5]) * sw_dcc; rd -= o[5];
      rs += rd;
      v = x + o[11] * (rd + sw_cpl * (sw_rsp - rd));
      v > 1 ? v = 1 + sw_sf(v - 1) : v < -1 ? v = -1 + sw_sf(v + 1);
      a = SW_AP + k * 128; c1 = o[6]; c2 = o[7];
      loop(sw_mm, w = v - c1 * a[0] - c2 * a[1]; v = c2 * w + c1 * a[0] + a[1]; a[1] = a[0]; a[0] = w; a += 2; );
      b[sw_spw] = v;
      y = sw_rd(b, sw_spw - o[2] * 0.5);
      hb = SW_HB + k * SW_SN; hv = xh + o[11] * 0.9 * sw_rd(hb, sw_spw - o[2] * 0.83);
      a = SW_AP + k * 128 + 96; loop(8, w = hv - sw_ha * a[0]; hv = sw_ha * w + a[0]; a[0] = w; a += 1; );
      hb[sw_spw] = hv;
      y = (y + hv * sw_hlv) * o[0] * o[19] * 2.2;
      o[17] = max(o[17], abs(y));
      sw_wl += y * o[8]; sw_wr += y * o[9];
    );
    k += 1; );
  sw_rsp = sw_ns > 1 ? rs / sw_ns : 0;
  sw_spw = (sw_spw + 1) & (SW_SN - 1);
  sw_wl = ll1.bq_run(sw_wl); sw_wr = lr1.bq_run(sw_wr);
);

function sw_kick() (
  sw_kn = 1; sw_kt = 0; sw_klen = floor(0.045 * sw_tr); sw_ka = 0.9; sw_kz = 0; sw_sq = 0;
);

sw_ha = -0.6;
sw_bias = 0.12; sw_fb = sw_bias / sqrt(1 + sw_bias * sw_bias);
sw_srinit();
sw_mix = sw_mixt; sw_out = sw_outt; sw_fi = 1;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init(); ost_setup(sw_sat, 0, 110, 6600, -0.3, 1);
by_setup(1);
pwr_init(); pwr_hum_db = -83; pwr_wu_loss = 0.3; pwr_wu_drv = 0.35; pwr_wu_lp = 14000; pwr_wu_wob = 0.1; pwr_bloom = 0.2;
pdc_delay = 0;

function sw_p(dw, tn, dr, dc, ln, ns, pd, hp, lp, to, mx, st, df) (
  slider2 = dw; slider3 = tn; slider4 = dr; slider5 = dc; slider6 = ln; slider7 = ns; slider8 = pd;
  slider9 = hp; slider10 = lp; slider11 = to; slider12 = mx; slider14 = st; slider15 = df;
);
function load_preset(p) (
  slider13 = 0; slider16 = 0;
  sw_p(40, 50, 50, 2.2, 50, 1, 0, 110, 4400, 50, 30, 10, 50);
  p == 2 ? sw_p(75, 62, 85, 3.3, 55, 1, 0, 220, 5500, 60, 40, 15, 50) :
  p == 3 ? sw_p(30, 40, 35, 1.4, 40, 0, 0, 220, 3300, 35, 18, 5, 50) :
  p == 4 ? sw_p(30, 55, 40, 2.5, 60, 2, 20, 220, 5500, 65, 25, 5, 40) :
  p == 5 ? sw_p(35, 50, 60, 4.5, 75, 1, 10, 110, 4400, 55, 35, 5, 50) :
  p == 6 ? sw_p(50, 10, 70, 3.0, 85, 1, 0, 110, 2200, 35, 35, 10, 60) :
  p == 7 ? sw_p(40, 92, 45, 1.6, 25, 0, 0, 330, 6600, 70, 30, 10, 40) :
  p == 8 ? sw_p(85, 55, 90, 4.5, 60, 1, 0, 330, 3300, 40, 45, 25, 70) :
  p == 9 ? sw_p(40, 35, 50, 2.0, 45, 0, 0, 110, 2200, 25, 30, 10, 50) :
  p == 10 ? sw_p(25, 60, 35, 1.6, 45, 2, 30, 330, 5500, 60, 20, 5, 40) :
  p == 11 ? sw_p(35, 45, 40, 4.5, 70, 3, 20, 110, 5500, 60, 30, 5, 40) :
  p == 12 ? sw_p(95, 40, 80, 2.6, 50, 0, 0, 440, 2200, 30, 40, 40, 80);
  slider_automate(32766);
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(15, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); sw_setup();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
sw_setup();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != sw_sr ? sw_srinit();
slider16 >= 0.5 ? ( sw_kick(); slider16 = 0; slider_automate(slider16); );
sw_kick_dirty ? ( sw_kick(); sw_kick_dirty = 0; );
sw_now = time_precise();
sw_tp > 0 && sw_now - sw_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > sw_gpp && play_position - sw_gpp < 4 * sw_gpd + 0.05) ? (
  sw_clear(); sw_fi = 0; memset(BY_BUF, 0, 2 * BY_N);
);
sw_tp = sw_now; sw_gpp = play_position; sw_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
sw_setup();
ost_setup(sw_sat, 0, 110, 6600, -0.3, 1);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
sw_ml_d = max(sw_ml_d, sw_mlm); sw_mr_d = max(sw_mr_d, sw_mrm); sw_mlm = sw_mrm = 0;
