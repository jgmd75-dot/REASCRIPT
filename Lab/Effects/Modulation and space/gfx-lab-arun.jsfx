desc:Arun [digital reverb] (GFX Lab)
//tags: reverb hall room plate 3d early reflections broadcast dialogue non-linear gated reverse digital 12-bit
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bverb, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bverb.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

slider31:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,7,1{Hall,3D,Flagship 40,12-Bit,Room Sim,Broadcast,Dialogue,Non-Lin}>-Model
slider2:8<0,120,1>-1st reflection delay (ms)
slider3:-6<-30,6,0.5>-1st reflection level (dB, -30 = off)
slider4:24<0,250,1>-Reverb delay (ms)
slider5:0<-30,6,0.5>-Reverb level (dB, -30 = off)
slider6:2.8<0.1,20,0.05>-Decay (s)
slider7:0.7<0.1,1.5,0.05>-HF decay (x)
slider8:1.0<0.5,2.5,0.05>-LF decay (x)
slider9:3000<10,12000,1>-Room size (m3)
slider10:60<0,100,1>-Reflection density (%)
slider11:60<0,100,1>-Diffusion (%)
slider12:80<20,1000,1>-Reverb HPF (Hz)
slider13:12000<1000,20000,10>-Reverb LPF (Hz)
slider14:0<0,100,1>-Drive (%)
slider15:0<0,1,1{Modern,Vintage}>-Clock
slider16:0<0,2,1{12,16,24}>-Bits (vintage)
slider17:100<0,150,1>-Width (%)
slider18:50<0,100,1>-Drift (%)
slider19:0.15<0.02,2,0.01>-Drift speed (Hz)
slider20:30<0,100,1>-Mix (%)
slider21:0<-24,12,0.1>-Output (dB)
slider22:0<0,100,1>-Band sat (%)
slider23:30<0,100,1>-Bias (%)
slider24:120<40,400,1>-Sat low band (Hz)
slider25:6000<2000,16000,10>-Sat high band (Hz)
slider26:0<-24,12,0.1>-Input trim (dB)
slider27:0<0,1,1{Off,On}>-Input guard
slider28:byp_on=0<0,1,1{Off,On}>-Bypass
slider29:1<0,2,1{Room,Gate,Reverse}>-Non-lin shape
slider30:prs_sel=0<0,22,1{No preset,Init,Massive Hall,Vocal Hall,Synth Pad Space,3D Scoring Stage,Film Room,Studio Room 40,Acoustic Guitar,80s Vocal Plate,Drum Room 12-Bit,Synthwave Wash,Room Init,Vocal Air,Concert Room,Drum Room,Broadcast Plate,Warm Hall,Voice-Over Booth,Narration Space,Gated Snare,Reverse Swell,Tight Ambience}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-arun";
function psw_all(v) ( slider_show(2147483647, v); );
function psw_allg(v) ( slider_show(2147483647, v); );
ext_noinit = 1;

bv_alloc(100000);
JV_LL = 3400; JV_NG = 3500;

function er_grid(sz, dens) local(sx, sy, sz_, lx, ly, lz, i, j, k, n, dx, dy, dz, d, d0, t, g, az, sw, tt, gg, cnt, a) (
  sx = 11 * sz; sy = 4.5 * sz; sz_ = 2.25 * sz; lx = 11 * sz; ly = 9.3 * sz; lz = 2.7 * sz;
  d0 = sqrt(sqr(sx - lx) + sqr(sy - ly) + sqr(sz_ - lz));
  n = 0;
  i = -2; loop(5, j = -2; loop(5, k = -2; loop(5,
    a = abs(i) + abs(j) + abs(k);
    a > 0 && a <= 2 && n < 48 ? (
      dx = (i & 1 ? (i + 1) * lx - sx : i * lx + sx) - lx;
      dy = (j & 1 ? (j + 1) * ly - sy : j * ly + sy) - ly;
      dz = (k & 1 ? (k + 1) * lz - sz_ : k * lz + sz_) - lz;
      d = sqrt(dx * dx + dy * dy + dz * dz);
      t = (d - d0) / 343; g = d0 / d * (a == 1 ? 0.75 : 0.5) * (k != 0 ? 0.8 : 1);
      az = atan2(dx, dy);
      er_tl[n] = t; er_tr[n] = t;
      er_gl[n] = g * sqrt(0.5 - 0.5 * sin(az)); er_gr[n] = g * sqrt(0.5 + 0.5 * sin(az));
      n += 1;
    );
    k += 1; ); j += 1; ); i += 1; );
  sw = 1; while(sw) ( sw = 0; i = 0; loop(n - 1,
    er_tl[i] > er_tl[i + 1] ? ( tt = er_tl[i]; er_tl[i] = er_tl[i + 1]; er_tl[i + 1] = tt; er_tr[i] = er_tl[i]; er_tr[i + 1] = er_tl[i + 1];
      gg = er_gl[i]; er_gl[i] = er_gl[i + 1]; er_gl[i + 1] = gg; gg = er_gr[i]; er_gr[i] = er_gr[i + 1]; er_gr[i + 1] = gg; sw = 1; );
    i += 1; ); );
  cnt = min(floor(8 + dens * 24), n);
  i = 0; loop(cnt, er_tl[i] = max(1, floor(er_tl[i] * srate)); er_tr[i] = er_tl[i]; i += 1; );
  cnt;
);
function er_forty(sz, dens) local(i, n, t, g, p, w) (
  bv_seed(4093); n = floor(8 + 32 * dens); w = 0.3 + 0.7 * dens;
  i = 0;
  loop(n,
    t = (3 + 95 * (i / 40) ^ 1.3 + 3 * bv_rnd()) * (0.4 + 0.6 * sz);
    g = 0.8 * exp(-2.2 * i / 40) * (bv_rnd() > 0.35 ? 1 : -1);
    p = (bv_rnd() * 2 - 1) * w;
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1 + 0.02 * p) * 0.001 * srate));
    er_gl[i] = g * sqrt(0.5 - 0.5 * p); er_gr[i] = g * sqrt(0.5 + 0.5 * p);
    i += 1; );
  n;
);
function jer_pat(m, sz, dens) local(i, n, t, g, p) (
  bv_seed(m == 0 ? 3301 : 6007);
  n = m == 0 ? floor(6 + 8 * dens) : floor(3 + 4 * dens);
  i = 0;
  loop(n,
    t = (m == 0 ? 12 + i * 9 + 6 * bv_rnd() : 6 + i * 11 + 3 * bv_rnd()) * (0.5 + 0.5 * sz);
    g = 0.6 * (1 - i / (n + 3)) * (bv_rnd() > 0.5 ? 1 : -1); p = bv_rnd() * 2 - 1;
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1.05 - 0.1 * (i & 1)) * 0.001 * srate));
    er_gl[i] = g * sqrt(0.5 - 0.45 * p); er_gr[i] = g * sqrt(0.5 + 0.45 * p);
    i += 1; );
  n;
);

function er_room(sz, dens) local(el, er_, sx, sy, sz_, lx, ly, lz, i, j, k, n, dx, dy, dz, d, d0, t, g, az, cnt, sw, tt, gg, a) (
  sx = 5.6 * sz; sy = 6.82 * sz; sz_ = 1.8 * sz; lx = 11.2 * sz; ly = 4.95 * sz; lz = 1.92 * sz;
  d0 = sqrt(sqr(sx - lx) + sqr(sy - ly) + sqr(sz_ - lz));
  n = 0;
  i = -2; loop(5, j = -2; loop(5, k = -1; loop(3,
    a = abs(i) + abs(j) + abs(k);
    a > 0 && a <= 2 && n < 48 ? (
      dx = (i & 1 ? (i + 1) * lx - sx : i * lx + sx) - lx;
      dy = (j & 1 ? (j + 1) * ly - sy : j * ly + sy) - ly;
      dz = (k & 1 ? (k + 1) * lz - sz_ : k * lz + sz_) - lz;
      d = sqrt(dx * dx + dy * dy + dz * dz);
      t = (d - d0) / 343;
      g = d0 / d * (a == 1 ? 0.8 : 0.55);
      az = atan2(dy, dx);
      er_tl[n] = t; er_gl[n] = g * (0.55 + 0.45 * cos(az - 0.9)); er_gr[n] = g * (0.55 + 0.45 * cos(az + 0.9));
      er_tr[n] = t + 0.00025 * sin(az);
      n += 1;
    );
    k += 1; ); j += 1; ); i += 1; );
  sw = 1; while(sw) ( sw = 0; i = 0; loop(n - 1,
    er_tl[i] > er_tl[i + 1] ? ( tt = er_tl[i]; er_tl[i] = er_tl[i + 1]; er_tl[i + 1] = tt; tt = er_tr[i]; er_tr[i] = er_tr[i + 1]; er_tr[i + 1] = tt;
      gg = er_gl[i]; er_gl[i] = er_gl[i + 1]; er_gl[i + 1] = gg; gg = er_gr[i]; er_gr[i] = er_gr[i + 1]; er_gr[i + 1] = gg; sw = 1; );
    i += 1; ); );
  cnt = floor(8 + dens * (n - 8));
  el = er_ = 0; i = 0; loop(cnt, er_gl[i] = sign(er_gl[i]) * min(abs(er_gl[i]), 0.45); er_gr[i] = sign(er_gr[i]) * min(abs(er_gr[i]), 0.45);
    el += sqr(er_gl[i]); er_ += sqr(er_gr[i]); i += 1; );
  i = 0; loop(cnt, er_gl[i] *= sqrt(0.35 / max(el, 0.0001)); er_gr[i] *= sqrt(0.35 / max(er_, 0.0001));
    er_gl[i] *= i & 1 ? -1 : 1; er_gr[i] *= i & 2 ? -1 : 1;
    er_tl[i] = max(1, floor(er_tl[i] * srate)); er_tr[i] = max(1, floor(er_tr[i] * srate)); i += 1; );
  cnt;
);
function eer_pat(m, sz, dens) local(i, n, t, g, p) (
  bv_seed(m == 1 ? 911 : m == 2 ? 1747 : 2311);
  n = m == 1 ? 8 : m == 2 ? 14 : 0;
  n = floor(n * (0.5 + 0.5 * dens)) + 2;
  i = 0;
  loop(n,
    t = m == 1 ? (5 + i * 7.5 + 4 * bv_rnd()) * (0.6 + 0.4 * sz) : (2 + i * 1.6 + 1.2 * bv_rnd()) * (0.5 + 0.5 * sz);
    g = (m == 1 ? 0.7 : 0.45) * (1 - i / (n + 2)) * (bv_rnd() > 0.5 ? 1 : -1);
    p = bv_rnd();
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1.03 + 0.05 * p) * 0.001 * srate));
    er_gl[i] = g * (0.6 + 0.4 * p); er_gr[i] = g * (1 - 0.4 * p);
    i += 1; );
  n;
);
function nl_shape(len, shp, dens) local(k, t, g, e, s2) (
  bv_seed(5167); s2 = 0; k = 0;
  loop(nl_n,
    t = (k + 0.3 + 0.4 * bv_rnd() * (0.4 + dens)) / nl_n;
    e = shp == 0 ? exp(-5.5 * t) : shp == 1 ? (t < 0.85 ? 1 - 0.15 * t : (1 - t) / 0.15 * 0.87) : (0.08 + 0.92 * t ^ 1.6) * (t < 0.95 ? 1 : (1 - t) * 20);
    g = e * (bv_rnd() > 0.5 ? 1 : -1) * (0.7 + 0.3 * bv_rnd());
    nl_t[k] = max(1, floor(t * len * srate)); nl_g[k] = g; s2 += g * g;
    k += 1; );
  k = 0; loop(nl_n, nl_g[k] *= 1.4 / sqrt(max(s2, 0.0001)); JV_NG[k] = nl_g[k]; k += 1; );
);

function jv_t60(m) local(e) (
  e = m - 4;
  m < 4 ? slider6 * (m == 0 ? 1.1 : m == 1 || m == 2 ? 1.12 : 1) : slider6 * (e == 0 ? 1.12 : e == 2 ? 0.91 : 1);
);
function jv_loss() local(k) (
  k = 0; loop(jv_nl, bv_loss(k, JV_LL[k]); k += 1; );
  mdl == 6 ? ( LN_G[3] = 1; LN_G[9] = 1; );
);
function jv_hash() local(m) (
  m = slider1 | 0;
  m * 7 + slider9 * 1.37 + slider10 * 3.11 + (slider15 >= 0.5) * 11.3 + (m < 4 ? (slider16 | 0) * 17.9 : 0) +
  (m == 7 ? (slider29 | 0) * 17.9 + slider6 * 29.3 : 0);
);
function jv_hard() local(k, sz, L, lens, dens, e) (
  mdl = slider1 | 0; e = mdl - 4;
  sz = (slider9 / 1000) ^ (1 / 3);
  dens = slider10 / 100;
  bv_t60 = jv_t60(mdl); bv_rthi = slider7; bv_rtlo = slider8;
  jv_tg = bv_t60; jv_hg = bv_rthi; jv_lg = bv_rtlo;
  bv_lox = 250;
  bv_hix = mdl == 3 ? 3000 : mdl < 3 ? 5000 : e == 1 ? 2400 : e == 2 ? 4500 : 3500;
  lens = 2300;
  mdl == 0 ? (
    er_n = jer_pat(0, sz, dens);
    lens[0] = 43.1; lens[1] = 49.7; lens[2] = 57.3; lens[3] = 61.9; lens[4] = 71.3; lens[5] = 79.1; lens[6] = 87.7; lens[7] = 97.3;
    jv_nl = 8; bv_hdrift = 1;
    k = 0; loop(8, L = min(lens[k] * 0.001 * srate * (0.3 + 0.7 * sz), LN_N - 40); ln_len[k] = L;
      ln_apl[k] = (4.1 + 1.3 * k) * 0.001 * srate * (0.5 + 0.5 * min(sz, 1.5)); JV_LL[k] = L + ln_apl[k]; k += 1; );
  ) : mdl == 1 || mdl == 2 ? (
    er_n = mdl == 1 ? er_grid(sz, dens) : er_forty(sz, dens);
    lens[0] = 29.3; lens[1] = 34.7; lens[2] = 39.1; lens[3] = 44.9; lens[4] = 50.3; lens[5] = 57.7; lens[6] = 64.1; lens[7] = 73.9;
    jv_nl = 8;
    k = 0; loop(8, L = min(lens[k] * 0.001 * srate * (0.3 + 0.7 * sz), LN_N - 40); ln_len[k] = L; JV_LL[k] = L; ln_mod[k] = 0; k += 1; );
    fdn_apg = 0;
  ) : mdl == 3 ? (
    er_n = jer_pat(3, sz, dens);
    lens[0] = 27.1; lens[1] = 33.7; lens[2] = 38.9; lens[3] = 42.3; lens[4] = 30.1; lens[5] = 36.3;
    jv_nl = 6;
    k = 0; loop(6, L = min(lens[k] * 0.001 * srate * (0.5 + 0.5 * sz), LN_N - 4); cb_len[k] = L; JV_LL[k] = L; k += 1; );
  ) : e == 0 ? (
    er_n = er_room(sz, dens);
    lens[0] = 31.7; lens[1] = 37.1; lens[2] = 41.3; lens[3] = 47.9; lens[4] = 53.3; lens[5] = 61.1; lens[6] = 70.7; lens[7] = 79.3;
    jv_nl = 8;
    k = 0; loop(8, L = min(lens[k] * 0.001 * srate * (0.25 + 0.75 * sz), LN_N - 4); ln_len[k] = L; JV_LL[k] = L; ln_mod[k] = 0; k += 1; );
    fdn_apg = 0;
  ) : e == 1 ? (
    er_n = eer_pat(1, sz, dens);
    lens[0] = 29.7; lens[1] = 37.1; lens[2] = 41.1; lens[3] = 43.7; lens[4] = 31.3; lens[5] = 39.7;
    jv_nl = 6;
    k = 0; loop(6, L = min(lens[k] * 0.001 * srate * (0.55 + 0.45 * sz), LN_N - 4); cb_len[k] = L; JV_LL[k] = L; k += 1; );
  ) : e == 2 ? (
    er_n = eer_pat(2, sz, dens);
    L = 0.35 + 0.5 * min(sz, 1.6);
    tk_d[0] = 0.1417 * L * srate; tk_d[1] = 0.1063 * L * srate; tk_d[2] = 0.1496 * L * srate; tk_d[3] = 0.1250 * L * srate;
    tk_a[0] = 0.0226 * L * srate; tk_a[1] = 0.0605 * L * srate; tk_a[2] = 0.0305 * L * srate; tk_a[3] = 0.0892 * L * srate;
    jv_nl = 4;
    JV_LL[0] = tk_d[0] + tk_d[1] + tk_a[0] + tk_a[1]; JV_LL[1] = 1; JV_LL[2] = tk_d[2] + tk_d[3] + tk_a[2] + tk_a[3]; JV_LL[3] = 1;
  ) : (
    er_n = 0; jv_nl = 0;
    nl_len = min(0.06 + bv_t60 * 0.2, 1.25);
    nl_shape(nl_len * (0.5 + 0.5 * min(sz, 2)), slider29 | 0, dens);
  );
  jv_loss();
  bv_xover();
  mdl < 4 ? lofi_set(slider15 >= 0.5 || mdl == 3, mdl == 3 ? 31500 : mdl == 1 ? 48000 : 44100, slider16 < 0.5 ? 12 : slider16 < 1.5 ? 16 : 24)
          : lofi_set(slider15 >= 0.5, e == 0 ? 34000 : e == 1 ? 32000 : e == 2 ? 40000 : 31250, e == 1 ? 14 : 16);
  jv_hh = jv_hash();
);
function jv_soft() local(dp) (
  diff = slider11 / 100;
  mdl == 0 ? fdn_apg = 0.35 + 0.3 * diff;
  erd_t = slider2 * 0.001 * srate; revd_t = slider4 * 0.001 * srate;
  er_t = slider3 <= -29.9 ? 0 : 10 ^ (slider3 / 20);
  rv_t = slider5 <= -29.9 ? 0 : 10 ^ (slider5 / 20) * (mdl >= 4 && mdl != 7 ? 1.3 : 1);
  lc_t = 1 - exp(-2 * $pi * slider12 / srate);
  hc_t = 1 - exp(-2 * $pi * min(slider13, srate * 0.45) / srate);
  drv_t = slider14 / 100 * (mdl == 5 ? 1.6 : 1);
  wid_t = slider17 / 100;
  dp = slider18 <= 50 ? slider18 * 0.4 : 20 + (slider18 - 50) * 1.6;
  dft = dp / 100; dspd = slider19 * (0.5 + 0.5 * dp / 20);
  mix_t = slider20 / 100; out_t = 10 ^ (slider21 / 20);
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, -0.3, 0);
  in_setup(slider26, slider27 >= 0.5);
);
function jv_clear() (
  memset(BV_PRE, 0, BV_END - BV_PRE); memset(ln_z1, 0, 30); memset(cb_z, 0, 10); memset(fdn_v, 0, 20); tk_x1 = tk_x2 = 0;
  lcL = lcR = hcL = hcR = 0;
  lfiL.a = lfiL.b = lfiL.h = 0; lfiR.a = lfiR.b = lfiR.h = 0; lfoL.a = lfoL.b = 0; lfoR.a = lfoR.b = 0;
);

function setp(m, erd, erl, rvd, rvl, t, hi, lo, vol, dn, df, lc, hc, dr, ck, bt, wd, mx, shp) (
  slider1 = m; slider2 = erd; slider3 = erl; slider4 = rvd; slider5 = rvl; slider6 = t; slider7 = hi; slider8 = lo; slider9 = vol;
  slider10 = dn; slider11 = df; slider12 = lc; slider13 = hc; slider14 = dr; slider15 = ck; slider16 = bt; slider17 = wd; slider20 = mx;
  slider29 = shp;
);
function setrest() (
  slider18 = 50; slider19 = 0.15; slider21 = 0; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000;
  slider26 = 0; slider27 = 0;
);
function load_preset(p) (
  p == 1 ? ( setp(0, 8, -6, 24, 0, 2.8, 0.7, 1.0, 3000, 60, 60, 80, 12000, 0, 0, 0, 100, 30, 1); setrest(); ) :
  p == 2 ? setp(0, 14, -10, 40, 0, 4.5, 0.5, 1.2, 8000, 60, 80, 50, 10000, 0, 0, 1, 130, 30, 1) :
  p == 3 ? setp(0, 10, -8, 30, 0, 2.6, 0.6, 1.0, 3000, 60, 70, 100, 13000, 0, 0, 1, 120, 25, 1) :
  p == 4 ? setp(0, 20, -12, 60, 0, 8.0, 0.5, 1.5, 12000, 50, 90, 50, 10000, 0, 0, 1, 140, 40, 1) :
  p == 5 ? setp(1, 8, -4, 24, -2, 2.2, 0.6, 1.0, 6000, 80, 70, 50, 13000, 0, 0, 1, 110, 30, 1) :
  p == 6 ? setp(1, 4, -2, 12, -4, 1.0, 0.7, 1.0, 900, 70, 60, 100, 13000, 0, 0, 1, 100, 25, 1) :
  p == 7 ? setp(2, 2, -3, 8, -6, 0.7, 0.8, 1.0, 250, 100, 50, 100, 13000, 0, 0, 1, 110, 25, 1) :
  p == 8 ? setp(2, 4, -4, 14, -3, 1.3, 0.7, 0.9, 700, 80, 60, 100, 10000, 0, 1, 1, 120, 25, 1) :
  p == 9 ? setp(3, 6, -12, 20, 0, 2.0, 0.5, 1.0, 1200, 50, 60, 100, 10000, 0, 1, 0, 110, 30, 1) :
  p == 10 ? setp(3, 2, -8, 6, 0, 1.0, 0.6, 1.0, 400, 60, 40, 100, 10000, 20, 1, 0, 100, 30, 1) :
  p == 11 ? setp(0, 30, -14, 80, 0, 12, 0.4, 1.3, 12000, 40, 90, 100, 10000, 0, 1, 1, 150, 45, 1) :
  p == 12 ? ( setp(4, 8, -6, 24, 0, 2.4, 0.75, 1.1, 2000, 60, 60, 80, 12000, 15, 0, 1, 100, 30, 1); setrest(); ) :
  p == 13 ? setp(4, 6, -6, 18, 0, 1.4, 0.7, 1.0, 600, 70, 60, 120, 14000, 10, 0, 1, 110, 25, 1) :
  p == 14 ? setp(4, 12, -4, 30, 0, 2.2, 0.6, 1.2, 4000, 80, 70, 60, 11000, 15, 0, 1, 120, 30, 1) :
  p == 15 ? setp(4, 2, -2, 8, -3, 0.8, 0.8, 1.0, 180, 90, 50, 100, 12000, 25, 0, 1, 100, 25, 1) :
  p == 16 ? setp(5, 4, -12, 12, 0, 1.8, 0.5, 1.0, 900, 60, 80, 150, 9000, 30, 0, 1, 100, 25, 1) :
  p == 17 ? setp(5, 10, -8, 35, 0, 3.0, 0.45, 1.3, 3500, 60, 70, 80, 8000, 35, 1, 1, 110, 30, 1) :
  p == 18 ? setp(6, 2, -10, 4, -2, 0.5, 0.8, 0.8, 60, 80, 90, 200, 10000, 10, 0, 1, 80, 20, 1) :
  p == 19 ? setp(6, 6, -8, 14, 0, 1.2, 0.7, 0.9, 400, 70, 85, 150, 11000, 10, 0, 1, 100, 22, 1) :
  p == 20 ? setp(7, 0, -30, 0, 0, 1.8, 1.0, 1.0, 1000, 70, 60, 120, 12000, 20, 0, 1, 120, 35, 1) :
