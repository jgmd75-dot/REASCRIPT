  hov ? ( ui_cola(0xFFFFFF, 0.08); gfx_rect(lx, KY + 5.5 * sc, lw, lw); );
  gfx_setfont(13); ly ? ( ui_col(NUI); nu_ctxt(x + s * 0.5, ly, lbl); ) : ( gfx_setfont(11); ui_col(on ? 0x2A1C08 : ui_mix(col, 0xFFFFFF, 0.55)); nu_ctxt(x + s * 0.5, y + s * 0.5 + 0.5, lbl); );
);
function nu_rhalf(x, y, w, h, lit, c, lbl) local(lens) (
