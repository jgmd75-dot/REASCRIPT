function nu_lamp(x, y, s, idx, col, lbl, ly) local(on, hov, KX, KY, KS, lx, lw, i) (
  on = slider(idx) >= 0.5; KX = x * sc; KY = y * sc; KS = s * sc;
  hov = mouse_x >= KX && mouse_x < KX + KS && mouse_y >= KY && mouse_y < KY + KS;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 0 : 1; ui_auto(idx); on = !on; );
  nu_rshadow(x, y, s, s);
  on ? ( ui_cola(col, 0.22); ui_rrect(KX - 5 * sc, KY - 5 * sc, KS + 10 * sc, KS + 10 * sc, 9 * sc); );
  ui_col(0x6E7378); ui_rrect(KX, KY, KS, KS, 5 * sc);
  ui_col(0xB4B9BF); ui_rrect(KX, KY, KS - 1.5 * sc, KS - 1.5 * sc, 5 * sc);
  ui_col(0xE4E7EA); ui_rrect(KX, KY, KS * 0.55, KS * 0.55, 5 * sc);
