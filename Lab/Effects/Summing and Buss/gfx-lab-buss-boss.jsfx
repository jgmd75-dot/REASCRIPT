  nu_os(uxL.s0, uxR.s0); nu_yl = nu_pl; nu_yr = nu_pr; nu_dl = nu_ql; nu_dr = nu_qr;
) : (
  nu_os(uxL.s0, uxR.s0); nu_a0 = nu_pl; nu_b0 = nu_pr; nu_dl = nu_ql; nu_dr = nu_qr;
  nu_os(uxL.s1, uxR.s1); nu_a1 = nu_pl; nu_b1 = nu_pr;
  os_f == 2 ? ( nu_yl = dnL.os_dn(nu_a0, nu_a1, 0, 0); nu_yr = dnR.os_dn(nu_b0, nu_b1, 0, 0); ) : (
