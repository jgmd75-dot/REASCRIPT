@gfx 1188 572
ui_begin(1188, 572);
NUF = 0x2A2C30; NUB = 0xB8862E; NUI = 0xF0F1EC; NUA = 0xE0A060;
NUI2 = ui_mix(NUI, NUF, 0.40);
NS1 = 0x9E4A3C; NS2 = 0xC27A3E; NS3 = 0xD6AE64;
NCH = 0xEC7A6E; NCM = 0x8EC6F0; NCL = 0xC08850;
sc != nu_fsc ? (
  nu_fsc = sc;
  nu_f10 = ui_fitarial(10, 16 * sc);
  nu_f11 = ui_fitarial(11, 12 * sc);
  nu_f12 = ui_fitarial(12, 14 * sc);
  nu_f13 = ui_fitarial(13, 14 * sc);
  nu_f14 = ui_fitarial(14, 27 * sc);
);
gfx_setfont(10, "Arial", nu_f10, 'b'); gfx_setfont(11, "Arial", nu_f11, 'b'); gfx_setfont(12, "Arial", nu_f12, 'b');
gfx_setfont(13, "Arial", nu_f13, 'b'); gfx_setfont(14, "Arial", nu_f14, 'b');
cs_font = 13;
function nu_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function nu_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function nu_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function nu_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function nu_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function nu_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function nu_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); nu_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function nu_rshadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); nu_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function nu_tdots(x, y, r, wd) local(i, t, rs, px, py) (
  rs = r + 10; i = 0;
  loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    wd && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); ui_col(0xC8CDD3);
      nu_ctxt(px + (i == 0 ? -3 : i == 4 ? 3 : 0), py + (i == 2 ? -2 : 0), i == 0 ? "M" : i == 2 ? "C" : "S"); )
    : ( ui_col(0xC8CDD3); nu_disc(px, py, i == 0 || i == 4 ? 2.1 : 1.6); );
    i += 1; );
);
function nu_turbo(x, y, r, a, act, pc, cc) local(i, t, n, KX, KY, KR) (
  KX = x * sc; KY = y * sc; KR = r * sc;
  ui_col(ui_mix(0x8A8E92, 0x000000, 0.3)); gfx_circle(KX, KY, KR + 3 * sc, 1, 1);
  ui_col(ui_mix(0x8A8E92, 0xFFFFFF, 0.3)); gfx_circle(KX - 0.5 * sc, KY - 0.7 * sc, KR + 2.4 * sc, 1, 1);
  ui_col(0x8A8E92); gfx_circle(KX + 0.2 * sc, KY + 0.3 * sc, KR + 2.2 * sc, 1, 1);
  ui_col(0x1B1C1E); gfx_circle(KX, KY, KR + 1 * sc, 1, 1);
