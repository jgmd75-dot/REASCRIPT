  n = 18; i = 0; loop(n, t = 2 * $pi * i / n; ui_col(0x2C2E31); gfx_circle(KX + sin(t) * KR * 0.86, KY - cos(t) * KR * 0.86, max(KR * 0.045, 1.1 * sc), 1, 1); i += 1; );
  ui_col(0x18191B); gfx_circle(KX + 0.4 * sc, KY + 0.6 * sc, KR * 0.73, 1, 1);
  cc ? (
    ui_col(ui_mix(cc, 0xFFFFFF, 0.25)); gfx_circle(KX - 0.4 * sc, KY - 0.6 * sc, KR * 0.72, 1, 1);
    ui_col(cc); gfx_circle(KX, KY, KR * 0.70, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.12 * (1 - i / 5)); gfx_circle(KX, KY, KR * 0.70 - i * 0.9 * sc, 0, 1); i += 1; );
  ) : (
    ui_col(0x2E3034); gfx_circle(KX - 0.4 * sc, KY - 0.6 * sc, KR * 0.72, 1, 1);
    ui_col(0x232427); gfx_circle(KX, KY, KR * 0.70, 1, 1);
    ui_col(0x2B2D31); ui_ssarc(KX, KY, KR * 0.64, -2.1, -0.2, max(KR * 0.05, 1.2 * sc));
  );
  ui_cola(0xFFFFFF, act ? 0.22 : 0.10); ui_ssarc(KX, KY, KR * 0.66, -1.75, -0.55, max(KR * 0.03, 0.9 * sc));
  ui_col(0x3A3D42); ui_ssarc(KX, KY, KR + 0.6 * sc, -1.9, -0.4, 1 * sc);
  ui_col(pc); ui_kdot(KX, KY, a, KR * 0.70);
);
function nu_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function nu_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function nu_knob(cx, cy, r, idx, lo, hi, def, pc, cc, lg) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = !nu_lock && dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - nk_lt < 0.35 && nk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; nk_lt = 0; ) : (
      drag_id = did; nk_my = mouse_y; nk_dz = 0; nk_lt = time_precise(); nk_lid = idx; nk_n = min(max(nu_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    nk_dz += abs(nk_my - mouse_y);
    nk_dz > 3 * sc ? (
      nk_n = min(max(nk_n + (nk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = nu_n2v(nk_n, lo, hi, lg);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    nk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(nu_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    slider(idx) = nu_n2v(n, lo, hi, lg); ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(nu_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  nu_tdots(cx, cy, r, nu_wdial); nu_cshadow(cx, cy, r + 3);
  nu_turbo(cx, cy, r, a, act, pc, cc);
  nu_lock ? ( ui_cola(0x1E2023, 0.55); nu_disc(cx, cy, r + 4); );
  nu_wdial = 0;
  act;
);
function nu_name(cx, ly, act, name, val) ( gfx_setfont(10); ui_col(act ? NUA : NUI); nu_ctxt(cx, ly, act ? val : name); );
function nu_fmt(f) ( f >= 1000 ? sprintf(#nufq, "%.1f kHz", f / 1000) : sprintf(#nufq, "%d Hz", floor(f + 0.5)); #nufq; );
function nu_kdb(cx, cy, r, idx, pc, name) local(k) (
  k = nu_knob(cx, cy, r, idx, -12, 12, 0, pc, 0, 0); sprintf(#nuv, "%+.1f dB", slider(idx)); nu_name(cx, cy + r + 21, k, name, #nuv); );
function nu_kpc(cx, cy, r, idx, def, pc, name) local(k) (
  k = nu_knob(cx, cy, r, idx, 0, 100, def, pc, 0, 0); sprintf(#nuv, "%d %%", floor(slider(idx) + 0.5)); nu_name(cx, cy + r + 21, k, name, #nuv); );
function nu_khz(cx, cy, r, idx, lo, hi, def, pc, cc, name) local(k) (
  k = nu_knob(cx, cy, r, idx, lo, hi, def, pc, cc, 1); nu_name(cx, cy + r + 21, k, name, nu_fmt(slider(idx))); );
function nu_readout(cx, cy, w, s) (
  ui_col(0x101113); nu_r(cx - w * 0.5 - 1, cy - 11, w + 2, 22);
  ui_col(0xE4E0D2); nu_r(cx - w * 0.5, cy - 10, w, 20); ui_cola(0x000000, 0.14); nu_r(cx - w * 0.5, cy - 10, w, 2); nu_r(cx - w * 0.5, cy - 10, 2, 20);
  gfx_setfont(12); ui_col(0x1E1D1A); nu_ctxt(cx, cy + 0.5, s);
);
function nu_split(cx, cy, idx, lo, hi, def, ttl) local(k) (
  k = nu_knob(cx, cy, 13, idx, lo, hi, def, NUI, 0, 1);
  gfx_setfont(10); ui_col(nu_lock ? NUI2 : NUI); nu_ctxt(cx, cy + 34, ttl);
  nu_readout(cx + 62, cy, 64, nu_fmt(nu_lock ? slider(4) * 10 : slider(idx)));
