function nu_rock3(x, y, w, h, idx, c) local(v, hov, KX, KY, KW, KH, hw, side) (
  v = floor(slider(idx) + 0.5); KX = x * sc; KY = y * sc; KW = w * sc; KH = h * sc; hw = floor(KW * 0.5);
  hov = mouse_x >= KX && mouse_x < KX + KW && mouse_y >= KY && mouse_y < KY + KH;
  side = mouse_x < KX + hw ? 1 : 2;
