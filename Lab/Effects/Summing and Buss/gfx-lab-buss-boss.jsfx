desc:Buss Boss [buss colour] (GFX Lab)
//tags: processing saturation transformer valve tape compressor clipper multiband mid-side buss
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-bands, gfx-lab-clip, gfx-lab-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-24,12,0.1>-Trim (dB)
slider3:1<0,1,1{Off,On}>-Guard
slider4:220<110,1100,1>-Low split (Hz)
slider5:2200<1100,11000,1>-High split (Hz)
slider6:0<0,1,1{Off,On}>-High split x10
slider7:22000<3300,22000,1>-High LPF (Hz)
slider8:1<0,1,1{Off,On}>-High iron
slider9:0<0,1,1{Before gain,After gain}>-High iron post
slider10:0<-12,12,0.1>-High gain (dB)
slider11:0<-12,12,0.1>-Air (dB)
slider12:1<0,1,1{Off,On}>-Mid iron
slider13:0<0,1,1{Before gain,After gain}>-Mid iron post
slider14:0<-12,12,0.1>-Mid gain (dB)
slider15:0<-100,100,1>-Tilt (%)
slider16:22<11,330,1>-Low HPF (Hz)
slider17:1<0,1,1{Off,On}>-Low iron
slider18:0<0,1,1{Before gain,After gain}>-Low iron post
slider19:0<-12,12,0.1>-Low gain (dB)
slider20:0<-12,12,0.1>-Bass (dB)
slider21:1<0,2,1{Off,Mid,Side}>-Valve
slider22:2<0,2,1{Off,Mid,Side}>-Tape
slider23:0<0,1,1{Off,On}>-High fizz
slider24:0<0,2,1{Off,Dip,Lift}>-Mid dip / lift
slider25:30<0,100,1>-Comp (%)
slider26:1<0,2,1{Fast,Medium,Slow}>-Comp speed
slider27:1<0,1,1{Off,On}>-Comp link
slider28:0<0,12,0.1>-Clip (dB)
slider29:100<0,100,1>-Mix (%)
slider30:100<0,200,1>-Width (%)
slider31:0<-24,12,0.1>-Output (dB)
slider32:50<0,100,1>-Drift (%)
slider33:0<0,2,1{1x,2x,4x}>-Oversampling
slider34:0<0,1,1{Off,On}>-Low thick
slider35:prs_sel=0<0,6,1{No preset,Init,Warm Bus,Tight Low End,Air and Glue,Wide Tape,Pushed}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-bands.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-buss-boss";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 0; clp_kt_on = 0;

function nu_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function nu_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function nu_db(d) ( exp(d * 0.11512925464970228); );
function nu_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );

function nu_bscoef(f1, f2, fs) local(g) (
  bs_k = 1.4142135623730951;
  f1 = max(10, min(f1, fs * 0.45));  f2 = max(f1 * 1.01, min(f2, fs * 0.45));
  g = tan($pi * f1 / fs);  bs_a1 = 1 / (1 + g * (g + bs_k));  bs_a2 = g * bs_a1;  bs_a3 = g * bs_a2;
  g = tan($pi * f2 / fs);  bs_b1 = 1 / (1 + g * (g + bs_k));  bs_b2 = g * bs_b1;  bs_b3 = g * bs_b2;
);
function nu_svc(f, fs) local(g) ( g = tan($pi * min(f, fs * 0.45) / fs); nu_c1 = 1 / (1 + g * (g + 1.4142135623730951)); nu_c2 = g * nu_c1; nu_c3 = g * nu_c2; );
function nu_svf(x, a1, a2, a3) instance(s1, s2, lp, hp) local(v1, v2, v3) (
  v3 = x - s2;  v1 = a1 * s1 + a2 * v3;  v2 = s2 + a2 * s1 + a3 * v3;  s1 = 2 * v1 - s1;  s2 = 2 * v2 - s2;
  lp = v2;  hp = x - 1.4142135623730951 * v1 - v2;
);
function nu_op(x, k) instance(z) ( z += k * (x - z); );
function nu_iron(x, g) local(t) (
  t = max(-1.5, min(1.5, (g * x + nu_ib) / nu_hd));
  (nu_hd * t * (1 - 0.14814814814814814 * t * t) - nu_ir0) / g;
);
function nu_fizz(h) local(t) (
  t = max(-1.5, min(1.5, 6 * h));
  0.19 * h + 3 * (h - t * (1 - 0.14814814814814814 * t * t) / 6);
);
function nu_vc(u) ( u >= 0 ? u / (1 + 0.5 * u) : u / (1 - 0.25 * u); );
function nu_valve(x, g) ( nu_hd * (nu_vc(g * x / nu_hd + nu_vb) - nu_vr0) / (g * nu_vsl); );
function nu_tape(x, g, bump, lm) instance(z, b1, b2) local(t, y) (
  t = max(-1.5, min(1.5, g * x));
  y = t * (1 - 0.14814814814814814 * t * t) / g;
  z += nu_tk * (y - z);
  b1 += nu_bk1 * (z - b1);  b2 += nu_bk2 * (z - b2);
  y + lm * (z - y) + bump * (b1 - b2);
);

function nu_drv(p) ( nu_db(-24 + 0.42 * min(max(p, 0), 100)); );
function nu_gr(e) local(o) (
  o = e - nu_thr;
  o <= -3 ? 0 : o >= 3 ? o * (1 - 1 / nu_rat) : (1 - 1 / nu_rat) * sqr(o + 3) / 12;
);
function nu_clip(x) instance(q1, r1) local(r, dx, y) (
  r = this.clp_ad(x) - 0.5 * x * x;  dx = x - q1;
  y = abs(dx) > 0.00001 ? (r - r1) / dx : this.clp_crv(0.5 * (x + q1)) - 0.5 * (x + q1);
  q1 = x;  r1 = r;
  x + y;
);
function nu_os(xl, xr) local(m, s, l, r, u, e) (
  nuHL.nu_svf(xl, nu_h1, nu_h2, nu_h3);  nuHR.nu_svf(xr, nu_h1, nu_h2, nu_h3);
  nuLL.nu_svf(nuHL.hp, nu_l1, nu_l2, nu_l3);  nuLR.nu_svf(nuHR.hp, nu_l1, nu_l2, nu_l3);
  l = nuLL.lp + nu_lop * (nuHL.hp - nuLL.lp);  r = nuLR.lp + nu_lop * (nuHR.hp - nuLR.lp);
  nuSL.bs_split(l);  nuSR.bs_split(r);
  u = max(abs(l), abs(r));  nu_xe += (u > nu_xe ? nu_xa : nu_xrc) * (u - nu_xe);
  nu_bl = nuSL.lo + nu_tko * (0.26 * nuKL.nu_op(nuSL.lo, nu_kk) + 0.5 * nuSL.lo * nuSL.lo);
  nu_br = nuSR.lo + nu_tko * (0.26 * nuKR.nu_op(nuSR.lo, nu_kk) + 0.5 * nuSR.lo * nuSR.lo);
  nuDL.nu_svf(nuSL.mi, nu_d1, nu_d2, nu_d3);  nuDR.nu_svf(nuSR.mi, nu_d1, nu_d2, nu_d3);
  nu_ml2 = nuSL.mi + nu_dlo * (nuSL.mi - nuDL.lp - nuDL.hp);  nu_mr2 = nuSR.mi + nu_dlo * (nuSR.mi - nuDR.lp - nuDR.hp);
  nu_hl2 = nuSL.hi + nu_fzo * nu_fizz(nuSL.hi - nuFL.nu_op(nuSL.hi, nu_fk));
  nu_hr2 = nuSR.hi + nu_fzo * nu_fizz(nuSR.hi - nuFR.nu_op(nuSR.hi, nu_fk));
  l = nu_iron(nu_iron(nu_bl, nu_gl1) * nu_lv0, nu_gl2);  r = nu_iron(nu_iron(nu_br, nu_gl1) * nu_lv0, nu_gl2);
  l += nu_iron(nu_iron(nu_ml2, nu_gm1) * nu_lv1, nu_gm2);  r += nu_iron(nu_iron(nu_mr2, nu_gm1) * nu_lv1, nu_gm2);
  l += nu_iron(nu_iron(nu_hl2, nu_gh1) * nu_lv2, nu_gh2);  r += nu_iron(nu_iron(nu_hr2, nu_gh1) * nu_lv2, nu_gh2);
  e = nu_xe * 5;  e = min(3, e * sqrt(e));
  m = (l + r) * 0.5;  s = (l - r) * 0.5;
  m += nu_vmo * e * (nu_valve(m, nu_gvm) - m);  s += nu_vso * e * (nu_valve(s, nu_gvs) - s);
  m += nu_tmo * e * (nuTM.nu_tape(m, nu_gtm, nu_bpm, nu_bpm * 1.6667) - m);
  s += nu_tso * e * (nuTS.nu_tape(s, nu_gts, nu_bps, nu_bps * 1.6667) - s);
  l = m + s;  r = m - s;
  l += nu_sh2 * (l - nuBL.nu_op(l, nu_bk));  r += nu_sh2 * (r - nuBR.nu_op(r, nu_bk));
  m = nuTL.nu_op(l, nu_pk);  u = nuTR.nu_op(r, nu_pk);
  l = m * nu_tlo + (l - m) * nu_thi;  r = u * nu_tlo + (r - u) * nu_thi;
  l += nu_sh0 * nuAL.nu_op(l, nu_ak);  r += nu_sh0 * nuAR.nu_op(r, nu_ak);
  nu_ql = l;  nu_qr = r;
  l *= 1 + nu_mx * (nu_cgl - 1);  r *= 1 + nu_mx * (nu_cgr - 1);
  l *= nu_cd;  r *= nu_cd;
  max(abs(l), abs(r)) > 0.891 ? nu_clf = 1;
  nu_pl = nuCL.nu_clip(l) / nu_cd;  nu_pr = nuCR.nu_clip(r) / nu_cd;
);

function nu_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  nuSL.bs_clear(); nuSR.bs_clear();
  nuHL.s1 = nuHL.s2 = nuHR.s1 = nuHR.s2 = nuLL.s1 = nuLL.s2 = nuLR.s1 = nuLR.s2 = 0;
  nuAL.z = nuAR.z = nuBL.z = nuBR.z = nuTL.z = nuTR.z = 0;
  nuTM.z = nuTM.b1 = nuTM.b2 = nuTS.z = nuTS.b1 = nuTS.b2 = 0;  nu_xe = 0;
  nuKL.z = nuKR.z = nuFL.z = nuFR.z = nuDL.s1 = nuDL.s2 = nuDR.s1 = nuDR.s2 = 0;
  nuCL.q1 = nuCL.r1 = nuCR.q1 = nuCR.r1 = 0;
);
function nu_reset() (
  nu_clear(); memset(BY_BUF, 0, 2 * BY_N);
  nu_dxl = nu_dyl = nu_dxr = nu_dyr = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  nu_grl = nu_grr = 0;
  nu_fi = 0;
);

PT = 6000000;
#nu_pm = "Init|Warm Bus|Tight Low End|Air and Glue|Wide Tape|Pushed";
function nu_w5(a, b, c, d, e) ( nu_wp[0] = a; nu_wp[1] = b; nu_wp[2] = c; nu_wp[3] = d; nu_wp[4] = e; nu_wp += 5; );
nu_wp = PT;
nu_w5(0, 1, 220, 2200, 0);  nu_w5(22000, 1, 0, 0, 0);  nu_w5(1, 0, 0, 0, 22);  nu_w5(1, 0, 0, 0, 1);  nu_w5(2, 0, 0, 30, 1);  nu_w5(1, 0, 100, 100, 0);
nu_w5(0, 1, 220, 2200, 0);  nu_w5(16500, 1, 0, -0.5, -1);  nu_w5(1, 0, 0.5, -20, 33);  nu_w5(1, 1, 1.5, 2, 1);  nu_w5(1, 0, 0, 40, 2);  nu_w5(1, 0, 100, 100, 1);
nu_w5(0, 1, 110, 2200, 0);  nu_w5(22000, 0, 1, 0, 0);  nu_w5(1, 0, 0, 0, 44);  nu_w5(1, 1, 0, 3, 1);  nu_w5(0, 0, 1, 45, 0);  nu_w5(1, 0, 100, 90, 1.5);
nu_w5(0, 1, 330, 3300, 1);  nu_w5(22000, 1, 1, 1, 3);  nu_w5(0, 0, 0, 15, 22);  nu_w5(1, 1, 0, 0, 0);  nu_w5(2, 1, 1, 35, 1);  nu_w5(1, 0, 70, 110, -1.5);
nu_w5(0, 1, 220, 2200, 0);  nu_w5(18000, 1, 0, 1.5, 1);  nu_w5(1, 1, 0, -10, 22);  nu_w5(1, 0, 0, 0, 2);  nu_w5(2, 0, 0, 25, 1);  nu_w5(1, 0, 100, 140, 0.5);
nu_w5(-2, 1, 220, 2200, 0);  nu_w5(16500, 1, 0, 0, 1);  nu_w5(1, 0, 0, 10, 33);  nu_w5(1, 1, 0, 2, 1);  nu_w5(1, 1, 2, 70, 1);  nu_w5(1, 4, 100, 100, 6.5);
function load_preset(p) local(i, q) (
  q = PT + (min(p, 7) == 7 ? 0 : p - 1) * 30;
  i = 0; loop(30, slider(2 + i) = q[i]; i += 1; );
  p == 7 ? slider(32) = 50;
  slider34 = p >= 7 ? 0 : (p == 2 || p == 3 || p == 6);
  i = 2; loop(31, ui_auto(i); i += 1; );  ui_auto(34);
  pr_cur = p == 7 ? 1 : p;
);

function nu_srinit() (
  nu_sr = srate;
  c_kn = nu_tc(30);
  c_sw = nu_tc(10);
  c_tk = 1 - exp(-32 / (0.03 * srate));
  nu_dcc = 1 - 2 * $pi * 5 / srate;
  nu_fis = 1 / (0.01 * srate);
  ost_init(0);
  nu_clear();
  nu_snap = 1;
);
function nu_coef() (
  nu_fs = srate * os_f;
  nu_bscoef(nu_f1, nu_f2, nu_fs);
  nu_svc(nu_fh, nu_fs);  nu_h1 = nu_c1; nu_h2 = nu_c2; nu_h3 = nu_c3;
  nu_svc(nu_fl, nu_fs);  nu_l1 = nu_c1; nu_l2 = nu_c2; nu_l3 = nu_c3;
  nu_ak = nu_opk(110, nu_fs);  nu_bk = nu_opk(8800, nu_fs);  nu_pk = nu_opk(1100, nu_fs);
  nu_tk = nu_opk(18000, nu_fs);  nu_bk1 = nu_opk(110, nu_fs);  nu_bk2 = nu_opk(33, nu_fs);
  nu_kk = nu_opk(110, nu_fs);  nu_fk = nu_opk(4400, nu_fs);
  nu_svc(sqrt(nu_f1 * nu_f2), nu_fs);  nu_d1 = nu_c1; nu_d2 = nu_c2; nu_d3 = nu_c3;
  nu_xa = 1 - exp(-1 / (0.01 * nu_fs));  nu_xrc = 1 - exp(-1 / (0.15 * nu_fs));
);
os_design();
os_f = os_tf = os_f2n(slider33); os_base = 0;
nu_srinit();
os_gsetup();
in_init();
pwr_init(); pwr_wu_loss = 0.8; pwr_wu_drv = 1.5; pwr_wu_lp = 8000; pwr_bloom = 0.2;
dSup.drift_init(0.8 + rand(1) * 0.4); dBi.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
nu_hd = 1; nu_ib = 0.06; nu_ir0 = nu_ib * (1 - 0.14814814814814814 * nu_ib * nu_ib);
nu_vb = 0.15; nu_vr0 = nu_vc(nu_vb); nu_vsl = 1 / sqr(1 + 0.5 * nu_vb);
nu_cgl = nu_cgr = 1; nu_cd = 1;
nuCL.clp_set(2, 0.891, 0.891, 0); nuCL.clp_knee(0.12);
nuCR.clp_set(2, 0.891, 0.891, 0); nuCR.clp_knee(0.12);
nu_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(34, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 6 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(6, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(33));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != nu_sr ? nu_srinit();
nu_now = time_precise();
nu_tp > 0 && nu_now - nu_tp > max(0.25, 4 * samplesblock / srate) ? nu_reset();
nu_tp = nu_now;
pwr_block(slider1 < 0.5);
in_setup(min(max(slider2, -24), 12), slider3 >= 0.5);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider33); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider32);
nu_n = samplesblock / srate;
nu_vs = dSup.drift_tick(0.05 * dm_s * nu_n); nu_vbw = dBi.drift_tick(0.04 * dm_s * nu_n);
nu_hdt = nu_db(0.4 * dm_a * nu_vs);
nu_vbt = 0.15 + 0.02 * dm_a * nu_vbw;
nu_f1t = min(max(slider4, 110), 1100);
nu_f2t = slider6 >= 0.5 ? nu_f1t * 10 : min(max(slider5, 1100), 11000);
nu_flt = min(max(slider7, 3300), 22000);  nu_fht = min(max(slider16, 11), 330);
nu_lopt = sqr(min(max((nu_flt - 16500) / 5500, 0), 1));
nu_z = nu_db(6); nu_a = nu_drv(0);
nu_gh1t = slider8 >= 0.5 && slider9 < 0.5 ? nu_z : nu_a;    nu_gh2t = slider8 >= 0.5 && slider9 >= 0.5 ? nu_z : nu_a;
nu_gm1t = slider12 >= 0.5 && slider13 < 0.5 ? nu_z : nu_a;  nu_gm2t = slider12 >= 0.5 && slider13 >= 0.5 ? nu_z : nu_a;
nu_gl1t = slider17 >= 0.5 && slider18 < 0.5 ? nu_z : nu_a;  nu_gl2t = slider17 >= 0.5 && slider18 >= 0.5 ? nu_z : nu_a;
nu_lv2t = nu_db(slider10);  nu_lv1t = nu_db(slider14);  nu_lv0t = nu_db(slider19);
nu_sh2t = nu_db(slider11) - 1;  nu_sh0t = nu_db(slider20) - 1;
nu_tv = min(max(slider15, -100), 100) / 100;  nu_tlot = nu_db(-6 * nu_tv);  nu_thit = nu_db(6 * nu_tv);
nu_gvmt = nu_gvst = nu_db(-6.5);  nu_gtmt = nu_gtst = nu_db(-7.8);  nu_bpmt = nu_bpst = 0.27;
nu_tkot = slider34 >= 0.5;  nu_fzot = slider23 >= 0.5;  nu_dlot = slider24 < 0.5 ? 0 : slider24 < 1.5 ? nu_db(-2) - 1 : nu_db(1.5) - 1;
nu_vmot = slider21 > 0.5 && slider21 < 1.5;  nu_vsot = slider21 >= 1.5;  nu_tmot = slider22 > 0.5 && slider22 < 1.5;  nu_tsot = slider22 >= 1.5;
nu_cm = min(max(slider25, 0), 100) / 100;
nu_thr = -6 - 24 * nu_cm;  nu_rat = 1 + 3 * nu_cm;
nu_z = slider26 < 0.5 ? 0 : slider26 < 1.5 ? 1 : 2;
nu_ca = 1 - exp(-1 / ((nu_z == 0 ? 0.003 : nu_z == 1 ? 0.010 : 0.030) * srate));
nu_cr = 1 - exp(-1 / ((nu_z == 0 ? 0.080 : nu_z == 1 ? 0.200 : 0.500) * srate));
nu_lkt = slider27 >= 0.5;
nu_cdt = nu_db(min(max(slider28, 0), 12));
nu_mxt = min(max(slider29, 0), 100) / 100;
nu_wdt = min(max(slider30, 0), 200) / 100;
nu_ogt = nu_db(min(max(slider31, -24), 12));
nu_snap ? (
  nu_f1 = nu_f1t; nu_f2 = nu_f2t; nu_fh = nu_fht; nu_fl = nu_flt; nu_lop = nu_lopt;
  nu_gl1 = nu_gl1t; nu_gl2 = nu_gl2t; nu_gm1 = nu_gm1t; nu_gm2 = nu_gm2t; nu_gh1 = nu_gh1t; nu_gh2 = nu_gh2t;
  nu_lv0 = nu_lv0t; nu_lv1 = nu_lv1t; nu_lv2 = nu_lv2t; nu_sh0 = nu_sh0t; nu_sh2 = nu_sh2t;
  nu_tlo = nu_tlot; nu_thi = nu_thit; nu_gvm = nu_gvmt; nu_gvs = nu_gvst; nu_gtm = nu_gtmt; nu_gts = nu_gtst;
  nu_bpm = nu_bpmt; nu_bps = nu_bpst; nu_tko = nu_tkot; nu_fzo = nu_fzot; nu_dlo = nu_dlot; nu_vmo = nu_vmot; nu_vso = nu_vsot; nu_tmo = nu_tmot; nu_tso = nu_tsot; nu_lk = nu_lkt; nu_cd = nu_cdt; nu_mx = nu_mxt; nu_og = nu_ogt; nu_wd = nu_wdt; nu_hd = nu_hdt; nu_vb = nu_vbt;
  nu_coef();
);
nu_snap = 0;
nu_dyl = nu_tn(nu_dyl); nu_dyr = nu_tn(nu_dyr);
abs(nuCL.q1) < 0.000000000001 ? nuCL.q1 = nuCL.r1 = 0; abs(nuCR.q1) < 0.000000000001 ? nuCR.q1 = nuCR.r1 = 0;
nuTM.z = nu_tn(nuTM.z); nuTS.z = nu_tn(nuTS.z);
nu_ol_d = max(nu_ol_d, nu_ol); nu_or_d = max(nu_or_d, nu_or); nu_ol = nu_or = 0;
nu_gr_d = max(nu_gr_d, max(nu_grl, nu_grr));
nu_il_d = max(nu_il_d, nu_il); nu_ir_d = max(nu_ir_d, nu_ir); nu_il = nu_ir = 0;
nu_clf ? nu_cl_d = 1; nu_clf = 0;
os_snapb(slider(33));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
nu_il = max(nu_il, abs(in_l)); nu_ir = max(nu_ir, abs(in_r));
pwr_in(in_l, in_r); nu_xl = pwr_l; nu_xr = pwr_r;
