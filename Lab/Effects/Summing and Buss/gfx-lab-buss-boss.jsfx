);
function nu_dbox(cx, cy, w, s) local(hov) (
  hov = mouse_x >= (cx - w * 0.5) * sc && mouse_x < (cx + w * 0.5) * sc && mouse_y >= (cy - 13) * sc && mouse_y < (cy + 13) * sc;
  ui_col(0x0C0C0D); nu_r(cx - w * 0.5, cy - 13, w, 26);
  ui_col(hov ? 0x2E2A24 : 0x221F1B); nu_r(cx - w * 0.5 + 2, cy - 11, w - 4, 22);
