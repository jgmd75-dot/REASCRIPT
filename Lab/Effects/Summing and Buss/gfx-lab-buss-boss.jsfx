    ui_col(ui_mix(lens, 0xFFFFFF, 0.32)); ui_rrect(x + 9 * sc, y + 9 * sc, w - 18 * sc, h - 18 * sc, 3 * sc);
    ui_cola(0x000000, 0.30); gfx_rect(x + 2 * sc, y + sc, w - 4 * sc, max(1, 2 * sc));
