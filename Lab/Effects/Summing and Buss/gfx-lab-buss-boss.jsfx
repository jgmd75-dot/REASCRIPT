nu_gh1 += (nu_gh1t - nu_gh1) * c_kn; nu_gh2 += (nu_gh2t - nu_gh2) * c_kn;
nu_lv0 += (nu_lv0t - nu_lv0) * c_kn; nu_lv1 += (nu_lv1t - nu_lv1) * c_kn; nu_lv2 += (nu_lv2t - nu_lv2) * c_kn;
nu_sh0 += (nu_sh0t - nu_sh0) * c_kn; nu_sh2 += (nu_sh2t - nu_sh2) * c_kn;
nu_tlo += (nu_tlot - nu_tlo) * c_kn; nu_thi += (nu_thit - nu_thi) * c_kn;
nu_gvm += (nu_gvmt - nu_gvm) * c_kn; nu_gvs += (nu_gvst - nu_gvs) * c_kn;
nu_gtm += (nu_gtmt - nu_gtm) * c_kn; nu_gts += (nu_gtst - nu_gts) * c_kn;
nu_bpm += (nu_bpmt - nu_bpm) * c_kn; nu_bps += (nu_bpst - nu_bps) * c_kn;
nu_cd += (nu_cdt - nu_cd) * c_kn; nu_mx += (nu_mxt - nu_mx) * c_kn; nu_og += (nu_ogt - nu_og) * c_kn; nu_wd += (nu_wdt - nu_wd) * c_kn; nu_lop += (nu_lopt - nu_lop) * c_kn;
nu_lk += (nu_lkt - nu_lk) * c_sw;
nu_tko += (nu_tkot - nu_tko) * c_sw; nu_fzo += (nu_fzot - nu_fzo) * c_sw; nu_dlo += (nu_dlot - nu_dlo) * c_sw;
nu_vmo += (nu_vmot - nu_vmo) * c_sw; nu_vso += (nu_vsot - nu_vso) * c_sw; nu_tmo += (nu_tmot - nu_tmo) * c_sw; nu_tso += (nu_tsot - nu_tso) * c_sw;
nu_hd += (nu_hdt - nu_hd) * c_kn;
nu_vb += (nu_vbt - nu_vb) * c_kn; nu_vr0 = nu_vc(nu_vb); nu_vsl = 1 / sqr(1 + 0.5 * nu_vb);
nu_ir0 = nu_hd * (nu_ib / nu_hd) * (1 - 0.14814814814814814 * sqr(nu_ib / nu_hd));
(nu_tick += 1) >= 32 ? (
