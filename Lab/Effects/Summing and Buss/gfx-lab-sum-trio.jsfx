@init
function psw_all(v) ( slider_show(281474976710655, v); );
function psw_allg(v) ( slider_show(281474976710655, v); );
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0;
#ui_man = "gfx-lab-sum-trio";
ext_noinit = 1;

tr_mem = 0;
function tr_alloc(n) local(p) ( p = tr_mem; tr_mem += n; memset(p, 0, n); p; );
function tr_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function tr_kf(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
function tr_kt(t, fs) ( 1 - exp(-1 / (max(t, 0.00001) * fs)); );
function tr_bqset(t, f, gdb, q, fs) instance(b0, b1, b2, a1, a2) local(ag, w, cs, sn, al, a0, sa) (
  ag = 10 ^ (gdb / 40); w = 2 * $pi * min(f, 0.49 * fs) / fs; cs = cos(w); sn = sin(w); al = sn / (2 * q); sa = 2 * sqrt(ag) * al;
  t == 4 ? ( a0 = (ag + 1) + (ag - 1) * cs + sa;
             b0 = ag * ((ag + 1) - (ag - 1) * cs + sa) / a0; b1 = 2 * ag * ((ag - 1) - (ag + 1) * cs) / a0; b2 = ag * ((ag + 1) - (ag - 1) * cs - sa) / a0;
             a1 = -2 * ((ag - 1) + (ag + 1) * cs) / a0; a2 = ((ag + 1) + (ag - 1) * cs - sa) / a0; ) :
           ( a0 = (ag + 1) - (ag - 1) * cs + sa;
             b0 = ag * ((ag + 1) + (ag - 1) * cs + sa) / a0; b1 = -2 * ag * ((ag - 1) + (ag + 1) * cs) / a0; b2 = ag * ((ag + 1) + (ag - 1) * cs - sa) / a0;
             a1 = 2 * ((ag - 1) - (ag + 1) * cs) / a0; a2 = ((ag + 1) - (ag - 1) * cs - sa) / a0; );
);
function tr_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) ( y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y; );
function tr_bi0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= sqr(x / (2 * k)); s += t; k += 1; ); s; );
function tr_hbdesign(h, n, beta) local(c, t, k, w, x, se, i0) (
  c = (n - 1) / 2; i0 = tr_bi0(beta); t = 0;
  loop(n, k = t - c; x = 2 * t / (n - 1) - 1; w = tr_bi0(beta * sqrt(max(0, 1 - x * x))) / i0;
          h[t] = k == 0 ? 0.5 : sin($pi * k / 2) / ($pi * k) * w; t += 1; );
  se = 0; t = 0; loop((n + 1) / 2, se += h[2 * t]; t += 1; );
  t = 0; loop((n + 1) / 2, h[2 * t] *= 0.5 / se; t += 1; );
);
function tr_upinit(n, h, sz) instance(buf, sz2, w, hu, np, mm, dd) local(j) (
  buf = tr_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; dd = ((n - 1) / 2 - 1) / 2;
  hu = tr_alloc(np); j = 0; loop(np, hu[j] = 2 * h[2 * j]; j += 1; );
);
function tr_up(x) instance(buf, sz2, w, hu, np, mm, dd, o0, o1) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x; buf[w + sz2] = x;
  p = buf + w + sz2; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-j] + p[j + 1 - mm]); j += 1; );
  o0 = s; o1 = p[-dd];
);
function tr_dninit(n, h, sz) instance(buf, sz2, w, hu, np, mm, cc) local(j) (
  buf = tr_alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; cc = (n - 1) / 2;
  hu = tr_alloc(np); j = 0; loop(np, hu[j] = h[2 * j]; j += 1; );
);
function tr_dn(x0, x1) instance(buf, sz2, w, hu, np, mm, cc) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x0; buf[w + sz2] = x0;
  w += 1; w >= sz2 ? w = 0; buf[w] = x1; buf[w + sz2] = x1;
  p = buf + w + sz2 - 1; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-2 * j] + p[2 * (j + 1 - mm)]); j += 1; );
  s + 0.5 * p[-cc];
);
function tr_pink() instance(p0, p1, p2) local(w) (
  w = rand(2) - 1; p0 = 0.99765 * p0 + w * 0.099046; p1 = 0.963 * p1 + w * 0.2965164; p2 = 0.57 * p2 + w * 1.0526913;
  (p0 + p1 + p2 + w * 0.1848) * 0.12;
);

tr_HB = tr_alloc(64); tr_hbdesign(tr_HB, 63, 8);
truL.tr_upinit(63, tr_HB, 64); truR.tr_upinit(63, tr_HB, 64); trdL.tr_dninit(63, tr_HB, 64); trdR.tr_dninit(63, tr_HB, 64);
tr_LAT = 31;
tr_TL = tr_alloc(8); tr_TR = tr_alloc(8);
tr_GL = tr_alloc(8); tr_GR = tr_alloc(8);
tr_PK = tr_alloc(8);
tr_PA = tr_alloc(8);
tr_LH = tr_alloc(8);
tr_IL = tr_alloc(12);
q7_HIS = 10 ^ (-76 / 20); q7_HUM = 10 ^ (-100 / 20);

function q7_slope(b) ( (tr_th(b + 0.001) - tr_th(b - 0.001)) / 0.002; );
function tr_mk(d) local(p, i, f, a, b) (
  p = min(max(d, 0), 18) / 3; i = min(floor(p), 5); f = p - i;
  tr_md == 0 ? (
    a = i == 0 ? 0 : i == 1 ? 0.03 : i == 2 ? 0.06 : i == 3 ? 0.14 : i == 4 ? 0.28 : 0.51;
    b = i == 0 ? 0.03 : i == 1 ? 0.06 : i == 2 ? 0.14 : i == 3 ? 0.28 : i == 4 ? 0.51 : 0.93;
  ) : tr_md == 1 ? (
    tr_vr ? (
      a = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0 : 0.03;
      b = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0.03 : 0.30;
    ) : (
      a = i == 0 ? 0 : i == 1 ? 0.03 : i == 2 ? 0.07 : i == 3 ? 0.16 : i == 4 ? 0.33 : 0.65;
      b = i == 0 ? 0.03 : i == 1 ? 0.07 : i == 2 ? 0.16 : i == 3 ? 0.33 : i == 4 ? 0.65 : 1.19;
    );
  ) : (
    tr_vr ? (
      a = i == 0 ? 0 : i == 1 ? 0.03 : i == 2 ? 0.08 : i == 3 ? 0.17 : i == 4 ? 0.35 : 0.66;
      b = i == 0 ? 0.03 : i == 1 ? 0.08 : i == 2 ? 0.17 : i == 3 ? 0.35 : i == 4 ? 0.66 : 1.24;
    ) : (
      a = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0 : i == 4 ? 0.01 : 0.02;
      b = i == 0 ? 0 : i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 0.01 : i == 4 ? 0.02 : 0.24;
    );
  );
  a + (b - a) * f;
);
function tr_engine() local(fs) (
  fs = 2 * srate;
  tr_md = floor(tr_e / 2); tr_vr = tr_e - 2 * tr_md;
  tr_md == 0 ? (
    q7_pb = tr_vr ? 0.22 : 0.08;
    q7_slp = q7_slope(q7_pb);
    q7_klo = tr_kf(tr_vr ? 80 : 120, fs); q7_ig = tr_vr ? 3.3 : 2.5; q7_khf = tr_kf(tr_vr ? 21000 : 30000, fs);
    tr_mg = 1;
    q7_ic = tr_vr ? 0.03 : 0.015;
    q7_R = 1 - 2 * $pi * 2.5 / fs;
  ) : tr_md == 1 ? (
    q4_klo = tr_kf(100, fs); q4_ig = 3; q4_khf = tr_kf(26000, fs);
    q4_kli = tr_kf(90, srate); q4_igi = 2.6;
    tr_mg = 1;
    q4_HIS = 10 ^ ((tr_vr ? -82 : -68) / 20);
    q4_BUZ = tr_vr ? 0 : 10 ^ (-96 / 20);
    q4_R = 1 - 2 * $pi * 2.5 / fs;
  ) : (
    q1_klo = tr_kf(110, fs); q1_ig = 2.8;
    q1_dcr = 1 - 2 * $pi * 2.5 / fs;
    q1_HIS = 10 ^ ((tr_vr ? -80 : -86) / 20);
    tr_mg = 1;
    tr_vr ? (
      q1eL1.tr_bqset(4, 120, 0.8, 0.6, srate); q1eR1.tr_bqset(4, 120, 0.8, 0.6, srate);
      q1eL2.tr_bqset(5, 14000, -0.9, 0.6, srate); q1eR2.tr_bqset(5, 14000, -0.9, 0.6, srate);
    ) : (
      q1eL1.tr_bqset(4, 55, -0.6, 0.7, srate); q1eR1.tr_bqset(4, 55, -0.6, 0.7, srate);
      q1eL2.tr_bqset(5, 11000, 0.8, 0.7, srate); q1eR2.tr_bqset(5, 11000, 0.8, 0.7, srate);
    );
  );
);
function tr_target() local(m) (
  m = min(max(floor(slider1 + 0.5), 0), 2);
  m * 2 + (slider(35 + 4 * m) >= 0.5);
);
function tr_update() local(i, any, on, lv, a, t, g, b) (
  any = 0; i = 0; loop(8, slider(26 + i) >= 0.5 ? any = 1; i += 1; );
  i = 0;
  loop(8,
    lv = slider(2 + i);
    on = slider(18 + i) < 0.5 && (!any || slider(26 + i) >= 0.5) && lv > -59.95;
    g = on ? 10 ^ (lv / 20) : 0;
    i < 4 ? (
      t = (slider(10 + i) / 100 + 1) * 0.25 * $pi;
      tr_TL[i] = g * cos(t) * sqrt(2); tr_TR[i] = g * sin(t) * sqrt(2);
    ) : (
      a = (slider(10 + i) + 100) / 200;
      tr_TL[i] = g * min(1, 2 * (1 - a)); tr_TR[i] = g * min(1, 2 * a);
    );
    i += 1;
  );
  tr_te = tr_target();
  b = 35 + 4 * tr_md;
  tr_tg = 0.5 * 10 ^ (slider(b + 1) / 20);
  tr_tgm = 10 ^ (tr_mk(slider(b + 1)) / 20) * tr_mg;
  tr_tir = tr_md == 1 && tr_vr ? 0 : slider(b + 2) / 100;
  tr_tnz = slider(b + 3) >= 0.5;
  tr_tms = slider34 <= -59.95 ? 0 : 10 ^ (slider34 / 20);
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = tr_LAT;
);
function tr_srinit() (
  tr_sr = srate;
  tr_sm = tr_kt(0.02, srate); tr_fd = 1 / (0.01 * srate); tr_vuc = tr_kt(0.3, srate);
  tr_sln = floor(0.5 * srate) + 64;
  tr_engine(); ost_init(0);
);
function tr_clear() (
  q7sL.dcx = q7sL.dcy = q7sL.lo = q7sL.hf = 0; q7sR.dcx = q7sR.dcy = q7sR.lo = q7sR.hf = 0;
  q4sL.dcx = q4sL.dcy = q4sL.lo = q4sL.hf = 0; q4sR.dcx = q4sR.dcy = q4sR.lo = q4sR.hf = 0; memset(tr_IL, 0, 12);
  q1sL.dcx = q1sL.dcy = q1sL.lo = q1sR.dcx = q1sR.dcy = q1sR.lo = 0;
  q1eL1.z1 = q1eL1.z2 = q1eR1.z1 = q1eR1.z2 = q1eL2.z1 = q1eL2.z2 = q1eR2.z1 = q1eR2.z2 = 0;
);

tr_e = tr_target();
tr_md = floor(tr_e / 2); tr_vr = tr_e - 2 * tr_md;
tr_srinit(); tr_update();
tr_g = tr_tg; tr_gm = tr_tgm; tr_ir = tr_tir; tr_ms = tr_tms; tr_nz = tr_tnz;
tr_i = 0; loop(8, tr_GL[tr_i] = tr_TL[tr_i]; tr_GR[tr_i] = tr_TR[tr_i]; tr_i += 1; );
tr_fade = 1; tr_fst = 0; tr_slp = 0; tr_sc = 0; tr_fresh = 1;
function tr_snap() local(i) (
  tr_te != tr_e ? ( tr_e = tr_te; tr_md = floor(tr_e / 2); tr_vr = tr_e - 2 * tr_md; tr_engine(); tr_update(); tr_clear(); );
  tr_g = tr_tg; tr_gm = tr_tgm; tr_ir = tr_tir; tr_ms = tr_tms; tr_nz = tr_tnz;
  i = 0; loop(8, tr_GL[i] = tr_TL[i]; tr_GR[i] = tr_TR[i]; i += 1; );
  tr_fst = 0; tr_fade = 1;
);

function q7_stage(x) instance(dcx, dcy, lo, hf) local(u, y, b, t) (
  b = q7_pb;
  u = x * tr_g;
  y = u >= -b ? tr_th(u + b) : tr_th(0.6 * (u + b)) / 0.6;
  y = (y - tr_th(b)) * tr_gm / (tr_g * q7_slp);
  dcy = y - dcx + q7_R * dcy; dcx = y;
  lo += (dcy - lo) * q7_klo;
  t = dcy - lo + tr_th(lo * q7_ig) / q7_ig;
  hf += (t - hf) * q7_khf;
  dcy + tr_ir * (hf - dcy);
);
function q4_in(x, n) local(lo) (
  lo = tr_IL[n]; lo += (x - lo) * q4_kli; tr_IL[n] = lo;
  x + tr_ir * (tr_th(lo * q4_igi) / q4_igi - lo);
);
function q4_stage(x) instance(b0, d0, dcx, dcy, lo, hf) local(u, y, b, t, a) (
  tr_vr ? (
    u = x * tr_g; a = abs(u);
    y = (a < 0.7 ? u : sign(u) * (0.7 + 0.3 * tr_th((a - 0.7) / 0.3))) / tr_g * tr_gm;
  ) : (
    b = 0.15;
    b != b0 ? ( b0 = b; d0 = (tr_th(b + 0.0005) - tr_th(b - 0.0005)) / 0.001; );
    y = (tr_th(x * tr_g + b) - tr_th(b)) / (tr_g * d0) * tr_gm;
    dcy = y - dcx + q4_R * dcy; dcx = y; y = dcy;
    lo += (y - lo) * q4_klo;
    t = y - lo + tr_th(lo * q4_ig) / q4_ig;
    hf += (t - hf) * q4_khf;
    y += tr_ir * (hf - y);
  );
  y;
);
function q1_stage(x) instance(b0, d0, dcx, dcy, lo) local(u, y, a, b, t) (
  u = x * tr_g;
  tr_vr ? (
    b = 0.1;
    b != b0 ? ( b0 = b; d0 = (tr_th(b + 0.0005) - tr_th(b - 0.0005)) / 0.001; );
    y = (tr_th(u + b) - tr_th(b)) / (tr_g * d0) * tr_gm;
    dcy = y - dcx + q1_dcr * dcy; dcx = y; y = dcy;
    lo += (y - lo) * q1_klo; t = y - lo + tr_th(lo * q1_ig) / q1_ig;
    y += tr_ir * (t - y);
  ) : (
    a = abs(u); b = 0.8;
    y = (a < b ? u : sign(u) * (b + (1 - b) * tr_th((a - b) / (1 - b)))) / tr_g * tr_gm;
  );
  y;
);

function tr_pset(m, v, d, ir, nz) (
  slider1 = m; slider(35 + 4 * m) = v; slider(36 + 4 * m) = d; slider(37 + 4 * m) = ir; slider(38 + 4 * m) = nz;
  ui_auto(1); ui_auto(35 + 4 * m); ui_auto(36 + 4 * m); ui_auto(37 + 4 * m); ui_auto(38 + 4 * m);
);
function tr_flat() local(i) (
  i = 0; loop(8, slider(2 + i) = 0; slider(10 + i) = 0; slider(18 + i) = 0; slider(26 + i) = 0; i += 1; );
  i = 2; loop(32, ui_auto(i); i += 1; );
);
function load_preset(p) (
  p == 1  ? tr_pset(0, 0,  6, 30, 0) :
  p == 2  ? tr_pset(0, 0,  0,  0, 0) :
  p == 3  ? tr_pset(0, 1,  8, 40, 0) :
  p == 4  ? tr_pset(0, 1, 15, 45, 0) :
  p == 5  ? tr_pset(0, 0,  6, 90, 0) :
  p == 6  ? tr_pset(0, 0,  9, 50, 1) :
  p == 7  ? tr_pset(0, 1, 11, 60, 0) :
  p == 8  ? tr_pset(0, 0,  4, 20, 0) :
  p == 9  ? tr_pset(0, 0, 18, 35, 0) :
  p == 10 ? tr_pset(0, 1,  5, 30, 0) :
  p == 11 ? tr_pset(0, 1, 12, 70, 1) :
  p == 12 ? tr_pset(1, 0,  6, 40, 0) :
  p == 13 ? tr_pset(1, 1,  0, 40, 0) :
  p == 14 ? tr_pset(1, 0,  9, 55, 0) :
  p == 15 ? tr_pset(1, 0, 15, 60, 0) :
  p == 16 ? tr_pset(1, 0,  6, 95, 0) :
  p == 17 ? tr_pset(1, 0, 12, 70, 1) :
  p == 18 ? tr_pset(1, 1,  4, 40, 1) :
  p == 19 ? tr_pset(1, 0, 10, 50, 0) :
  p == 20 ? tr_pset(1, 1, 15, 40, 0) :
  p == 21 ? tr_pset(1, 0,  8, 45, 0) :
  p == 22 ? tr_pset(1, 0, 12, 80, 1) :
  p == 23 ? tr_pset(2, 0,  6, 50, 0) :
  p == 24 ? tr_pset(2, 0,  0,  0, 0) :
  p == 25 ? tr_pset(2, 0,  8, 70, 0) :
  p == 26 ? tr_pset(2, 0, 15, 60, 0) :
  p == 27 ? tr_pset(2, 0,  3, 100, 0) :
  p == 28 ? tr_pset(2, 1,  6, 60, 0) :
  p == 29 ? tr_pset(2, 1, 10, 100, 0) :
