desc:Sum Trio V5 [summing mixer] (GFX Lab)
//tags: summing mixer valve broadcast outside broadcast console transformer stems bus series57 series74 series81
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-v5-parts, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider48:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
