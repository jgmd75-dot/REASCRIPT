desc:M-Sum V5 [summing mixer] (GFX Lab)
//tags: summing mixer bus console transformer vca compressor stems
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-os, gfx-lab-power, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-v5-palette, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider40:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,24,0.1>-Console input drive (dB)
slider2:0.15<0,1,0.01>-Iron core saturation
slider3:0.05<0,0.3,0.01>-Power rail bus sag
slider4:-12<-30,0,0.5>-VCA threshold (dB)
slider5:4<1,20,0.5>-VCA ratio
slider6:1<0.1,20,0.1>-VCA attack (ms)
slider7:150<10,600,1>-VCA release (ms)
slider8:0<0,18,0.5>-VCA makeup (dB)
slider9:-60<-60,0,1>-Crosstalk / bleed (dB, -60 = off)
slider10:0<-24,12,0.5>-Master output trim (dB)
slider11:1<0,1,1{Out,In}>-VCA in
slider12:0<0,1,1{Off,On}>-VCA auto makeup
slider13:0<-60,6,0.1>-Main 1/2 level (dB)
slider14:0<-60,6,0.1>-Stem 1 level (dB)
slider15:0<-60,6,0.1>-Stem 2 level (dB)
slider16:0<-60,6,0.1>-Stem 3 level (dB)
slider17:0<-60,6,0.1>-Stem 4 level (dB)
slider18:0<-60,6,0.1>-Stem 5 level (dB)
slider19:0<-60,6,0.1>-Stem 6 level (dB)
slider20:0<-60,6,0.1>-Stem 7 level (dB)
slider21:0<0,1,1{Off,On}>-Main 1/2 mute
slider22:0<0,1,1{Off,On}>-Stem 1 mute
slider23:0<0,1,1{Off,On}>-Stem 2 mute
slider24:0<0,1,1{Off,On}>-Stem 3 mute
slider25:0<0,1,1{Off,On}>-Stem 4 mute
slider26:0<0,1,1{Off,On}>-Stem 5 mute
slider27:0<0,1,1{Off,On}>-Stem 6 mute
slider28:0<0,1,1{Off,On}>-Stem 7 mute
slider29:0<0,1,1{Off,On}>-Main 1/2 solo
slider30:0<0,1,1{Off,On}>-Stem 1 solo
slider31:0<0,1,1{Off,On}>-Stem 2 solo
slider32:0<0,1,1{Off,On}>-Stem 3 solo
slider33:0<0,1,1{Off,On}>-Stem 4 solo
slider34:0<0,1,1{Off,On}>-Stem 5 solo
slider35:0<0,1,1{Off,On}>-Stem 6 solo
slider36:0<0,1,1{Off,On}>-Stem 7 solo
slider37:0<0,2,1{1x,2x,4x}>-Oversampling
slider38:0<0,1,1{Off,On}>-Bypass
slider39:prs_sel=0<0,8,1{No preset,Clean Sum,Warm Console,Driven Desk,Broadcast Glue,Heavy Iron,Punch Bus,Stressed Rail,Straight Sum}>-Preset

in_pin:main L
in_pin:main R
in_pin:stem 1 L
in_pin:stem 1 R
in_pin:stem 2 L
in_pin:stem 2 R
in_pin:stem 3 L
in_pin:stem 3 R
in_pin:stem 4 L
in_pin:stem 4 R
in_pin:stem 5 L
in_pin:stem 5 R
in_pin:stem 6 L
in_pin:stem 6 R
in_pin:stem 7 L
in_pin:stem 7 R
out_pin:mix L
out_pin:mix R

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(1099511627775, v); );
function psw_allg(v) ( slider_show(1099511627775, v); );
#ui_man = "gfx-lab-m-sum-v5";
ext_noinit = 1;
ext_gr_meter = 0;

gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0; gdc_x12 = gdc_y12 = 0; gdc_x13 = gdc_y13 = 0; gdc_x14 = gdc_y14 = 0; gdc_x15 = gdc_y15 = 0;

LHD = 180;
DEN = 0.00000000000000000001;
SG = 100; SGT = 110; SPK = 120;
memset(SG, 0, 30); memset(LHD, 0, 8);

os_design(); os_base = 0; os_f = os_tf = os_f2n(slider37);

function update() local(i) (
  drv = 10 ^ (slider1 / 20);
  iron_d = 1 + slider2 * 3;
  sag = slider3;
  thr = slider4; rat = max(slider5, 1);
  ac = dy_ms(slider6); rc_f = dy_ms(slider7); rc_s = dy_ms(slider7 * 4);
  bleed = slider9 <= -59.5 ? 0 : 10 ^ (slider9 / 20);
  trim = 10 ^ (slider10 / 20);
  c_on = slider11;
  mk = 10 ^ ((slider12 ? 0.5 * -thr * (1 - 1 / rat) : slider8) / 20);
  any_solo = 0; i = 0; loop(8, any_solo |= slider(29 + i); i += 1; );
  i = 0;
  loop(8,
    SGT[i] = slider(21 + i) || (any_solo && !slider(29 + i)) || slider(13 + i) <= -59.9 ? 0 : 10 ^ (slider(13 + i) / 20);
    i += 1;
  );
  ost_setup(0, 0, 120, 6000, -0.3, 0);
);

function pp(dv, ir, sgv, ct, t, r, a, rl, mu, au, ci, tr) (
  slider1 = dv; slider2 = ir; slider3 = sgv; slider9 = ct; slider4 = t; slider5 = r; slider6 = a; slider7 = rl;
  slider8 = mu; slider12 = au; slider11 = ci; slider10 = tr;
);
function load_preset(p) local(i) (
  p == 1 ? pp(0, 0.1, 0.03, -60, -12, 2, 5, 200, 0, 0, 0, 0) :
  p == 2 ? pp(3, 0.3, 0.06, -54, -14, 2, 10, 250, 1, 0, 1, -1) :
  p == 3 ? pp(8, 0.55, 0.1, -50, -16, 3, 3, 150, 2, 0, 1, -4) :
  p == 4 ? pp(2, 0.2, 0.05, -60, -18, 4, 1, 120, 0, 1, 1, -1) :
  p == 5 ? pp(6, 1, 0.08, -60, -12, 2, 10, 300, 0, 0, 1, -3) :
  p == 6 ? pp(4, 0.3, 0.12, -48, -20, 6, 0.3, 80, 0, 1, 1, -2) :
  p == 7 ? pp(10, 0.7, 0.2, -45, -10, 2, 10, 300, 0, 0, 1, -6) :
  p == 8 ? pp(0, 0, 0, -60, -12, 1, 1, 150, 0, 0, 0, 0);
  p >= 1 && p <= 8 ? slider_automate(4095);
  p == 9 ? (
    pp(0, 0.15, 0.05, -60, -12, 4, 1, 150, 0, 0, 1, 0);
    i = 0; loop(8, slider(13 + i) = 0; slider(21 + i) = 0; slider(29 + i) = 0; i += 1; );
    slider_automate(68719476735);
  );
);

function xf(x) instance(lo) ( lo += (x - lo) * lp_c + DEN; x - lo + ost_tanh(lo * iron_s) / iron_s; );
function xf_clr() instance(lo) ( lo = 0; );
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function rate_set() ( lp_c = 1 - exp(-2 * $pi * 150 / (os_f * srate)); );

ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
en_a = 1 - exp(-1 / (0.002 * srate)); en_r = 1 - exp(-1 / (0.06 * srate));
rate_set();
bumpL.bq_set(2, 35, 1.2, 0.5); bumpR.bq_set(2, 35, 1.2, 0.5);
det_r = exp(-1 / (0.005 * srate));
sm = 1 - exp(-1 / (0.02 * srate));
ksw = 1 - exp(-1 / (0.015 * srate));
vuc = 1 - exp(-1 / (0.3 * srate));
update();
i = 0; loop(8, SG[i] = SGT[i]; i += 1; );
drv_s = drv; iron_s = iron_d; bleed_s = bleed; trim_s = trim; mk_s = mk; c_m = c_on;

os_gsetup();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_base + os_lat(os_f);
by_setup(38);
pwr_init(); pwr_wu_loss = 0.6; pwr_wu_drv = 1; pwr_wu_lp = 9000; pwr_bloom = 0; pwr_sag = 0.15;
rs_f = 1;
sl_n = 0; sl_was = 0; sl_max = floor(0.5 * srate);
railm_d = 1; grm_d = 0; pk_d = 0; xgr_a = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function clr_all() (
  gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0; gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0; gdc_x12 = gdc_y12 = 0; gdc_x13 = gdc_y13 = 0; gdc_x14 = gdc_y14 = 0; gdc_x15 = gdc_y15 = 0;
  memcpy(SG, SGT, 8);
  en = 0; env = 0; e_ = 0; hold = 0;
  TFL.xf_clr(); TFR.xf_clr(); bumpL.bq_clr(); bumpR.bq_clr();
  UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr();
  ostL.ost_ch_init(); ostR.ost_ch_init();
);

function prs_sl() ( update(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(38, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 || !prs_run ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = prs_run ? 1 / (0.030 * srate) : 0;
      !prs_run ? prs_g = 1;
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0; prs_run = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();
os_snap(slider37);

@block
ext_gr_meter = min(xgr_a, 0); xgr_a = 0;
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; rs_c = 1 / (0.015 * srate); clr_all(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
update();
os_tf = os_f2n(slider37);
pwr_block(slider38 < 0.5);
os_snapb(slider37);
prs_run = 1;

@serialize
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, pr_cur);
gn = 0; loop(8, file_avail(0) != 0 ? file_string(0, UI_NM + gn); gn += 1; );
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
os_gate();
os_chg ? ( rate_set(); TFL.xf_clr(); TFR.xf_clr(); UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr(); );
ms_in = abs(spl0) + abs(spl1) + abs(spl2) + abs(spl3) + abs(spl4) + abs(spl5) + abs(spl6) + abs(spl7)
      + abs(spl8) + abs(spl9) + abs(spl10) + abs(spl11) + abs(spl12) + abs(spl13) + abs(spl14) + abs(spl15);
ms_in > 0.000000000001 || os_g < 1 || os_tf != os_f || prs_g < 1 || prs_gs != 0 || rs_f < 1 || pwr_act ? sl_n = 0;
sl_n > sl_max ? (
  !sl_was ? ( sl_was = 1; clr_all(); );
  by_il = by_ir = 0;
  spl0 = spl1 = 0;
  by_out();
) : (
  sl_was = 0;
  gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
  gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
  gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
  gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
  gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
  gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
  gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
  gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
  gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
  gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
  gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
  gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
  gdc_y12 = spl12 - gdc_x12 + gdc_r * gdc_y12; gdc_x12 = spl12; spl12 = gdc_y12;
  gdc_y13 = spl13 - gdc_x13 + gdc_r * gdc_y13; gdc_x13 = spl13; spl13 = gdc_y13;
  gdc_y14 = spl14 - gdc_x14 + gdc_r * gdc_y14; gdc_x14 = spl14; spl14 = gdc_y14;
  gdc_y15 = spl15 - gdc_x15 + gdc_r * gdc_y15; gdc_x15 = spl15; spl15 = gdc_y15;
  sl = 0; sr = 0; ab = 0; k = 0;
  loop(8,
    SG[k] += (SGT[k] - SG[k]) * sm;
    xl = spl(2 * k) * SG[k]; xr = spl(2 * k + 1) * SG[k];
    SPK[k] = max(SPK[k], max(abs(spl(2 * k)), abs(spl(2 * k + 1))));
    sl += xl; sr += xr;
    ab += abs(xl) + abs(xr);
    k += 1;
  );
  by_il = sl; by_ir = sr;
  drv_s += (drv - drv_s) * sm; iron_s += (iron_d - iron_s) * sm; bleed_s += (bleed - bleed_s) * sm;
  trim_s += (trim - trim_s) * sm; mk_s += (mk - mk_s) * sm; c_m += (c_on - c_m) * ksw;
  pwr_in(sl, sr); sl = pwr_l; sr = pwr_r;
  ab *= drv_s;
  en += (ab - en) * (ab > en ? en_a : en_r);
  v_rail = max(0.65, 1 - en * sag);
  g = v_rail * drv_s;
  bl = (sl + sr * bleed_s) * g; br = (sr + sl * bleed_s) * g;

  UL.os_up(bl); UR.os_up(br);
  p0l = TFL.xf(UL.s0); p0r = TFR.xf(UR.s0);
  os_f > 1 ? (
    p1l = TFL.xf(UL.s1); p1r = TFR.xf(UR.s1);
    os_f > 2 ? ( p2l = TFL.xf(UL.s2); p2r = TFR.xf(UR.s2); p3l = TFL.xf(UL.s3); p3r = TFR.xf(UR.s3); );
  );
  bl = DNL.os_dn(p0l, p1l, p2l, p3l); br = DNR.os_dn(p0r, p1r, p2r, p3r);
  os_g < 1 ? ( bl *= os_g; br *= os_g; );
  bl = bumpL.bq_run(bl); br = bumpR.bq_run(br);

  pk = max(abs(bl), abs(br));
  env = max(pk, env * det_r) + DEN;
  c_on || c_m > 0.000001 ? (
    t_ = -max(0, 20 * log10(env) - thr) * (1 - 1 / rat);
    t_ < e_ ? e_ += (t_ - e_) * ac : (
      e_ += (t_ - e_) * (rc_f + (rc_s - rc_f) * min(hold, 1));
    );
    hold = e_ < -2 ? min(hold + 1 / srate, 1) : max(hold - 2 / srate, 0);
    cg = 10 ^ (e_ / 20) * mk_s;
    c_m < 1 ? cg = 1 + (cg - 1) * c_m;
  ) : ( e_ = 0; hold = 0; cg = 1; c_m = 0; );
  bl *= cg; br *= cg;
  pwr_out(bl, br); bl = pwr_l * trim_s; br = pwr_r * trim_s;
  gr_now = e_ * c_m;
  grm_d = min(grm_d, gr_now); xgr_a = min(xgr_a, gr_now);

  bl = ostL.ost_band(bl); br = ostR.ost_band(br);
  ost_out(bl, br);
  spl0 = ost_l; spl1 = ost_r;
  rs_f < 1 ? (
    rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f);
    os_f == 1 ? ( spl0 = by_il + (spl0 - by_il) * rs_s; spl1 = by_ir + (spl1 - by_ir) * rs_s; ) : ( spl0 *= rs_s; spl1 *= rs_s; );
  );
  by_out();
  railm_d = min(railm_d, v_rail);
  abs(spl0) + abs(spl1) > 0.000000000001 ? sl_n = 0 : sl_n += 1;
);
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
vm += (0.5 * (spl0 * spl0 + spl1 * spl1) - vm) * vuc;
pk_d = max(pk_d, max(abs(spl0), abs(spl1)));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
v5p_use(5);
v5_led = 0xFFB030;
CVF = v5p_bg; CVW = v5p_pk; CVI = v5p_ink; CVL = ui_mix(v5p_ink, v5p_pk, 0.3);
CVA = 0xF2C98A; CVH = 0x14110F; CVB = 0x1C1A18;
CVY = 0xF2D04A; CVO = 0xE8862A; CVR = 0xB8322A; CDK = 0x2E3034;
sc != cv_fsc ? (
  cv_fsc = sc;
  cv_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  cv_f6 = ui_fitfont(6, 26 * sc);
);
function cv_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * cv_kt * sc, 'b'); );
function cv_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function cv_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function cv_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function cv_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function cv_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function cv_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.18); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.30)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.22)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.10)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
