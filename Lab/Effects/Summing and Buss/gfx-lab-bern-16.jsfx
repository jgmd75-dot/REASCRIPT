desc:Bern 16 V5 [summing mixer] (GFX Lab)
//tags: summing mixer broadcast console transformer drive stereo pairs bus
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-v5-parts, gfx-lab-v5-palette, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider44:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-24,24,0.1>-Ch 1/2 gain (dB)
slider2:0<-24,24,0.1>-Ch 3/4 gain (dB)
slider3:0<-24,24,0.1>-Ch 5/6 gain (dB)
slider4:0<-24,24,0.1>-Ch 7/8 gain (dB)
slider5:0<-24,24,0.1>-Ch 9/10 gain (dB)
slider6:0<-24,24,0.1>-Ch 11/12 gain (dB)
slider7:0<-24,24,0.1>-Ch 13/14 gain (dB)
slider8:0<-24,24,0.1>-Ch 15/16 gain (dB)
slider9:0<-100,100,1>-Ch 1/2 balance
slider10:0<-100,100,1>-Ch 3/4 balance
slider11:0<-100,100,1>-Ch 5/6 balance
slider12:0<-100,100,1>-Ch 7/8 balance
slider13:0<-100,100,1>-Ch 9/10 balance
slider14:0<-100,100,1>-Ch 11/12 balance
slider15:0<-100,100,1>-Ch 13/14 balance
slider16:0<-100,100,1>-Ch 15/16 balance
slider17:0<0,1,1{Off,On}>-Ch 1/2 mute
slider18:0<0,1,1{Off,On}>-Ch 3/4 mute
slider19:0<0,1,1{Off,On}>-Ch 5/6 mute
slider20:0<0,1,1{Off,On}>-Ch 7/8 mute
slider21:0<0,1,1{Off,On}>-Ch 9/10 mute
slider22:0<0,1,1{Off,On}>-Ch 11/12 mute
slider23:0<0,1,1{Off,On}>-Ch 13/14 mute
slider24:0<0,1,1{Off,On}>-Ch 15/16 mute
slider25:0<0,1,1{Off,On}>-Ch 1/2 solo
slider26:0<0,1,1{Off,On}>-Ch 3/4 solo
slider27:0<0,1,1{Off,On}>-Ch 5/6 solo
slider28:0<0,1,1{Off,On}>-Ch 7/8 solo
slider29:0<0,1,1{Off,On}>-Ch 9/10 solo
slider30:0<0,1,1{Off,On}>-Ch 11/12 solo
slider31:0<0,1,1{Off,On}>-Ch 13/14 solo
slider32:0<0,1,1{Off,On}>-Ch 15/16 solo
slider33:0<0,18,0.1>-Drive (dB)
slider34:0<-100,100,1>-Tone (dark / bright)
slider35:1<0,1,1{Off,On}>-Colour
slider36:0<0,1,1{Off,On}>-Channel iron
slider37:0<-24,12,0.1>-Volume (dB)
slider38:0<0,1,1{Off,On}>-Mono
slider39:0<0,100,1>-Band sat (%)
slider40:30<0,100,1>-Bias (%)
slider41:120<40,400,1>-Sat low band (Hz)
slider42:6000<2000,16000,10>-Sat high band (Hz)
slider43:prs_sel=0<0,9,1{No preset,Init,Clean Bus,Warm Iron,Drum Bus Glue,Pushed Console,Dark Broadcast,Bright Lift,Tired Console,Mono Check}>-Preset

in_pin:ch 1 left
in_pin:ch 2 right
in_pin:ch 3 left
in_pin:ch 4 right
in_pin:ch 5 left
in_pin:ch 6 right
in_pin:ch 7 left
in_pin:ch 8 right
in_pin:ch 9 left
in_pin:ch 10 right
in_pin:ch 11 left
in_pin:ch 12 right
in_pin:ch 13 left
in_pin:ch 14 right
in_pin:ch 15 left
in_pin:ch 16 right
out_pin:mix L
out_pin:mix R

@init
function psw_all(v) ( slider_show(17592186044415, v); );
function psw_allg(v) ( slider_show(17592186044415, v); );
gdc_r = 1 - 2 * $pi / srate;
function bz_dcclr() (
  gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0; gdc_x2 = gdc_y2 = 0; gdc_x3 = gdc_y3 = 0; gdc_x4 = gdc_y4 = 0; gdc_x5 = gdc_y5 = 0; gdc_x6 = gdc_y6 = 0; gdc_x7 = gdc_y7 = 0;
  gdc_x8 = gdc_y8 = 0; gdc_x9 = gdc_y9 = 0; gdc_x10 = gdc_y10 = 0; gdc_x11 = gdc_y11 = 0; gdc_x12 = gdc_y12 = 0; gdc_x13 = gdc_y13 = 0; gdc_x14 = gdc_y14 = 0; gdc_x15 = gdc_y15 = 0;
);
bz_dcclr();
#ui_man = "gfx-lab-bern-16";
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
BZG  = alloc(16);
BZGT = alloc(16);
BZPL = alloc(16); BZPR = alloc(16);
BZQL = alloc(16); BZQR = alloc(16);
BZPK = alloc(16);
GZH  = alloc(16);
ost_init(alloc(4096));

bz_den = 0.00000000000000000001;

function bz_auto_au(i) ( slider_automate(2 ^ (i - 1)); );

function bz_tone_set(t) (
  bzHPl.bq_set(1, 17, 0.62, 0);  bzHPr.bq_set(1, 17, 0.62, 0);
  bzBMl.bq_set(2, 45, 0.9, 0.5); bzBMr.bq_set(2, 45, 0.9, 0.5);
  bzLSl.bq_set(4, 250, 0.6, -2 * t); bzLSr.bq_set(4, 250, 0.6, -2 * t);
  bzHSl.bq_set(3, 4000, 0.6, 2 * t); bzHSr.bq_set(3, 4000, 0.6, 2 * t);
  bzTPl.bq_set(3, 13000, 0.5, -1.2); bzTPr.bq_set(3, 13000, 0.5, -1.2);
  bz_tset = t;
);

function update() local(i, any, a, heard) (
  any = 0; i = 0; loop(8, any |= slider(25 + i) > 0.5; i += 1; );
  bz_solo = any;
  i = 0;
  loop(8,
    heard = slider(17 + i) < 0.5 && (!any || slider(25 + i) > 0.5);
    BZGT[i] = heard ? 10 ^ (slider(1 + i) / 20) : 0;
    a = slider(9 + i) / 100;
    BZQL[i] = a > 0 ? cos(a * 0.5 * $pi) : 1; BZQR[i] = a < 0 ? cos(-a * 0.5 * $pi) : 1;
    i += 1;
  );
  bz_dt = 10 ^ (slider33 / 20);
  bz_ir = 1 + 1.6 * slider33 / 18;
  bz_ct = slider35 > 0.5; bz_it = slider36 > 0.5; bz_mt = slider38 > 0.5;
  bz_vt = 10 ^ (slider37 / 20);
  bz_bl = 0.08; bz_br = 0.08;
  bz_tbl = ost_tanh(bz_bl); bz_tbr = ost_tanh(bz_br);
  bz_nl = 1 / (1 - bz_tbl * bz_tbl); bz_nr = 1 / (1 - bz_tbr * bz_tbr);
  ost_setup(slider39 / 100, slider40 / 100, slider41, slider42, -0.3, 0);
);

function bz_master(dv, tn, cl, ir, vo, mo) (
  slider33 = dv; slider34 = tn; slider35 = cl; slider36 = ir; slider37 = vo; slider38 = mo;
);
function load_preset(p) local(i) (
  p == 1 ? ( bz_master(0, 0, 1, 0, 0, 0); slider40 = 30; ) :
  p == 2 ? ( bz_master(0, 0, 0, 0, 0, 0); slider40 = 0; ) :
  p == 3 ? bz_master(6, -25, 1, 1, 0, 0) :
  p == 4 ? bz_master(9, 15, 1, 1, -1, 0) :
  p == 5 ? bz_master(14, 0, 1, 1, -2, 0) :
  p == 6 ? bz_master(4, -60, 1, 0, 0, 0) :
  p == 7 ? bz_master(2, 45, 1, 0, 0, 0) :
  p == 8 ? bz_master(7, -15, 1, 1, -0.5, 0) :
  p == 9 ? slider38 = 1 :
  p == 10 ? (
    i = 0; loop(8, slider(1 + i) = 0; slider(9 + i) = 0; slider(17 + i) = 0; slider(25 + i) = 0; i += 1; );
    bz_master(0, 0, 1, 0, 0, 0);
    slider39 = 0; slider40 = 30; slider41 = 120; slider42 = 6000;
  );
  i = 1; loop(42, bz_auto_au(i); i += 1; );
);

function bz_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function bz_fclr() (
  bzHPl.bz_bqclr(); bzHPr.bz_bqclr(); bzBMl.bz_bqclr(); bzBMr.bz_bqclr(); bzLSl.bz_bqclr();
  bzLSr.bz_bqclr(); bzHSl.bz_bqclr(); bzHSr.bz_bqclr(); bzTPl.bz_bqclr(); bzTPr.bz_bqclr();
);
function bz_srinit() (
  bz_sr = srate;
  gdc_r = 1 - 2 * $pi / srate;
  bz_sm = 1 - exp(-1 / (0.02 * srate));
  bz_lpc = 1 - exp(-2 * $pi * 100 / srate);
  bz_rc = 1 - exp(-1 / (0.3 * srate));
  bz_gfr = 1 / (0.015 * srate);
  bz_tone_set(bz_tt);
  bz_fclr();
  ost_init(0);
);
function bz_reset() (
  bz_fclr(); bz_dcclr();
  bz_lol = bz_lor = 0; bz_xl = bz_yl = bz_xr = bz_yr = 0;
  bz_gf = 0;
);
bz_dcc = 0.9993;
bz_gf = 1;
ostL.ost_ch_init(); ostR.ost_ch_init();
bz_tt = slider34 / 100; bz_srinit();
pwr_init(); pwr_sag = 0.15; pwr_rip = 0.003; pwr_wu_loss = 0.4; pwr_wu_drv = 0.6; pwr_wu_lp = 12000; pwr_wu_wob = 0.2; pwr_bloom = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
update();
i = 0; loop(8, BZG[i] = BZGT[i]; BZPL[i] = BZQL[i]; BZPR[i] = BZQR[i]; i += 1; );
bz_ds = bz_dt; bz_cm = bz_ct; bz_im = bz_it; bz_mm = bz_mt; bz_vs = bz_vt;
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(42, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
    prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;

@block
bz_gnow = time_precise();
bz_gtp > 0 && bz_gnow - bz_gtp > max(0.25, 4 * samplesblock / srate) && !(play_position > bz_gpp && play_position - bz_gpp < 4 * bz_gpd + 0.05) ? bz_reset();
bz_gtp = bz_gnow; bz_gpp = play_position; bz_gpd = samplesblock / srate;
prs_chk();
srate != bz_sr ? ( bz_sr = srate; bz_srinit(); );
pwr_block(1);
update();
bz_tt += (slider34 / 100 - bz_tt) * min(1, samplesblock / (0.04 * srate));
abs(bz_tt - bz_tset) > 0.0005 ? bz_tone_set(bz_tt);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;

@serialize
file_var(0, ui_sz);
gn = 0; loop(8, file_avail(0) != 0 ? file_string(0, UI_NM + gn); gn += 1; );
file_avail(0) != 0 ? file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
bz_gf < 1 ? ( bz_dl = spl0; bz_dr = spl1; );
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
gdc_y2 = spl2 - gdc_x2 + gdc_r * gdc_y2; gdc_x2 = spl2; spl2 = gdc_y2;
gdc_y3 = spl3 - gdc_x3 + gdc_r * gdc_y3; gdc_x3 = spl3; spl3 = gdc_y3;
gdc_y4 = spl4 - gdc_x4 + gdc_r * gdc_y4; gdc_x4 = spl4; spl4 = gdc_y4;
gdc_y5 = spl5 - gdc_x5 + gdc_r * gdc_y5; gdc_x5 = spl5; spl5 = gdc_y5;
gdc_y6 = spl6 - gdc_x6 + gdc_r * gdc_y6; gdc_x6 = spl6; spl6 = gdc_y6;
gdc_y7 = spl7 - gdc_x7 + gdc_r * gdc_y7; gdc_x7 = spl7; spl7 = gdc_y7;
gdc_y8 = spl8 - gdc_x8 + gdc_r * gdc_y8; gdc_x8 = spl8; spl8 = gdc_y8;
gdc_y9 = spl9 - gdc_x9 + gdc_r * gdc_y9; gdc_x9 = spl9; spl9 = gdc_y9;
gdc_y10 = spl10 - gdc_x10 + gdc_r * gdc_y10; gdc_x10 = spl10; spl10 = gdc_y10;
gdc_y11 = spl11 - gdc_x11 + gdc_r * gdc_y11; gdc_x11 = spl11; spl11 = gdc_y11;
gdc_y12 = spl12 - gdc_x12 + gdc_r * gdc_y12; gdc_x12 = spl12; spl12 = gdc_y12;
gdc_y13 = spl13 - gdc_x13 + gdc_r * gdc_y13; gdc_x13 = spl13; spl13 = gdc_y13;
gdc_y14 = spl14 - gdc_x14 + gdc_r * gdc_y14; gdc_x14 = spl14; spl14 = gdc_y14;
gdc_y15 = spl15 - gdc_x15 + gdc_r * gdc_y15; gdc_x15 = spl15; spl15 = gdc_y15;
bz_l = 0; bz_r = 0; bz_k = 0;
bz_im += ((bz_it ? 1 : 0) - bz_im) * bz_sm;
loop(8,
  BZG[bz_k] += (BZGT[bz_k] - BZG[bz_k]) * bz_sm;
  BZPL[bz_k] += (BZQL[bz_k] - BZPL[bz_k]) * bz_sm; BZPR[bz_k] += (BZQR[bz_k] - BZPR[bz_k]) * bz_sm;
  bz_x = spl(2 * bz_k) * BZG[bz_k]; bz_x2 = spl(2 * bz_k + 1) * BZG[bz_k];
  bz_im > 0.0001 ? (
    bz_u = min(max(bz_x * 0.5, -1.5), 1.5);
    bz_x += bz_im * ((bz_u - 0.148148 * bz_u * bz_u * bz_u + 0.05 * bz_u * bz_u) * 2 - bz_x);
    bz_u = min(max(bz_x2 * 0.5, -1.5), 1.5);
    bz_x2 += bz_im * ((bz_u - 0.148148 * bz_u * bz_u * bz_u + 0.05 * bz_u * bz_u) * 2 - bz_x2);
  );
  BZPK[bz_k] = max(BZPK[bz_k], max(abs(bz_x), abs(bz_x2)));
  bz_l += bz_x * BZPL[bz_k]; bz_r += bz_x2 * BZPR[bz_k];
  bz_k += 1;
);

pwr_in(bz_l, bz_r); bz_l = pwr_l; bz_r = pwr_r;
bz_ds += (bz_dt - bz_ds) * bz_sm;
bz_g = bz_ds * 0.2;
bz_ul = bz_l * bz_g; bz_ur = bz_r * bz_g;
bz_lol += (bz_ul - bz_lol) * bz_lpc + bz_den; bz_lor += (bz_ur - bz_lor) * bz_lpc + bz_den;
bz_ul += ost_tanh(bz_lol * bz_ir) / bz_ir - bz_lol; bz_ur += ost_tanh(bz_lor * bz_ir) / bz_ir - bz_lor;
bz_ul = (ost_tanh(bz_ul + bz_bl) - bz_tbl) * bz_nl; bz_ur = (ost_tanh(bz_ur + bz_br) - bz_tbr) * bz_nr;
bz_l = bz_ul / bz_g; bz_r = bz_ur / bz_g;
bz_yl = bz_l - bz_xl + bz_dcc * bz_yl; bz_xl = bz_l; bz_l = bz_yl;
bz_yr = bz_r - bz_xr + bz_dcc * bz_yr; bz_xr = bz_r; bz_r = bz_yr;
pwr_out(bz_l, bz_r); bz_l = pwr_l; bz_r = pwr_r;

bz_cm += ((bz_ct ? 1 : 0) - bz_cm) * bz_sm;
bz_cl = bzTPl.bq_run(bzHSl.bq_run(bzLSl.bq_run(bzBMl.bq_run(bzHPl.bq_run(bz_l)))));
bz_cr = bzTPr.bq_run(bzHSr.bq_run(bzLSr.bq_run(bzBMr.bq_run(bzHPr.bq_run(bz_r)))));
bz_l += (bz_cl - bz_l) * bz_cm; bz_r += (bz_cr - bz_r) * bz_cm;

bz_mm += ((bz_mt ? 1 : 0) - bz_mm) * bz_sm;
bz_m = 0.5 * (bz_l + bz_r);
bz_l += (bz_m - bz_l) * bz_mm; bz_r += (bz_m - bz_r) * bz_mm;
bz_vs += (bz_vt - bz_vs) * bz_sm;
bz_l = ostL.ost_band(bz_l) * bz_vs; bz_r = ostR.ost_band(bz_r) * bz_vs;
ost_out(bz_l, bz_r);
spl0 = ost_l; spl1 = ost_r;
bz_gf < 1 ? (
  bz_gf = min(1, bz_gf + bz_gfr); bz_w = 0.5 - 0.5 * cos($pi * bz_gf);
  spl0 = bz_dl + (spl0 - bz_dl) * bz_w; spl1 = bz_dr + (spl1 - bz_dr) * bz_w;
);
bz_k = 2; loop(14, spl(bz_k) = 0; bz_k += 1; );
bz_pkl_d = max(bz_pkl_d, abs(spl0)); bz_pkr_d = max(bz_pkr_d, abs(spl1));
bz_rml += (spl0 * spl0 - bz_rml) * bz_rc; bz_rmr += (spl1 * spl1 - bz_rmr) * bz_rc;

@gfx 900 400
function ver_tag_at(s, slot, x, yb, fs, col) local(x0, y0, r, g, b, a, f) (
  x0 = gfx_x; y0 = gfx_y; r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a; f = gfx_getfont();
  col >= 0 ? ( gfx_r = (col >> 16) / 255; gfx_g = ((col >> 8) & 255) / 255; gfx_b = (col & 255) / 255; gfx_a = 1; );
  gfx_setfont(slot, "Trebuchet MS", max(10, fs), 'b');
  gfx_x = x; gfx_y = yb - 0.8 * gfx_texth; gfx_a *= 0.55; gfx_drawstr(s);
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a; gfx_x = x0; gfx_y = y0; gfx_setfont(f + 1);
);
ui_begin(900, 400);
v5_begin();
v5p_use(13);
BNF = v5p_bg; BNP = v5p_pk; BNI = v5p_ink; BNA = v5p_acc; BNB = v5p_slate;
BNW = ui_mix(v5p_pk, 0, 0.10); BND = ui_mix(BNI, BNP, 0.40); BNH = 0x0E1014; BNV = 0xE8EEF4;
BNS = 0xF2C21B; BNM = 0xFF3A2A;
v5_led = 0xFFB030;
sc != bn_fsc ? (
  bn_fsc = sc;
  bn_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  bn_f6 = ui_fitfont(6, 26 * sc);
);
function bn_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * bn_kt * sc, 'b'); );
function bn_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bn_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bn_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function bn_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function bn_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x7A8690); v5_d(x, y, 4); ui_col(0xC4CCD4); v5_d(x - 0.8, y - 0.8, 2.4); );
function bn_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.22); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.42)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
