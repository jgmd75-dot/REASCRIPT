  cb_vuc = 1 - exp(-1 / (0.3 * srate));
  cb_vu_sine = 10 * log10(2);
  cb_dr_r = 1 - exp(-1 / (0.03 * srate));
  cb_wpos = 0; cb_drop_g = 1; cb_drop_t = 1;
  cb_update();
  cb_i = 0; loop(4, cb_TG[cb_i] = cb_TGT[cb_i]; cb_i += 1; );
  cb_c4_dkr = 1 / (0.012 * srate); cb_c4_dk = 1; cb_c4_dst = 0;
);

function cb_run() (
  cb_c4_dst == 1 ? ( cb_c4_dk -= cb_c4_dkr; cb_c4_dk <= 0 ? ( cb_c4_dk = 0; cb_update(); cb_c4_hc = floor(0.008 * srate); cb_c4_dst = 2; ); ) :
  cb_c4_dst == 2 ? ( cb_c4_hc > 0 ? cb_c4_hc -= 1 : ( cb_c4_dk += cb_c4_dkr; cb_c4_dk >= 1 ? ( cb_c4_dk = 1; cb_c4_dst = 0; ); ); );
  cb_wph += 0.6 / srate; cb_wph -= floor(cb_wph);
  cb_fph += 6.2 / srate; cb_fph -= floor(cb_fph);
  cb_wnd += ((rand(2) - 1) - cb_wnd) * 0.00002;
  cb_wdel = s92_lat + cb_wow_a * (0.45 * sin(2 * $pi * cb_wph) + 1.5 * cb_wnd + 0.06 * sin(2 * $pi * cb_fph)) * 0.001 * srate;
  cb_age > 0 && rand(1) < cb_age * cb_age * 1.2 / srate ? ( cb_drop_t = 10 ^ (-(4 + rand(10)) / 20); cb_drop_n = (0.02 + rand(1) * 0.06) * srate; );
  cb_drop_n > 0 ? cb_drop_n -= 1 : cb_drop_t = 1;
  cb_drop_g += (cb_drop_t - cb_drop_g) * cb_dr_r;
  cb_k = 0;
  loop(8, cb_NZ[cb_k] += ((rand(2) - 1) - cb_NZ[cb_k]) * 0.5; cb_k += 1; );
  cb_k = 0; loop(4, cb_TG[cb_k] += (cb_TGT[cb_k] - cb_TG[cb_k]) * cb_sm; cb_TPK[cb_k] = max(cb_TPK[cb_k], max(abs(spl(2 * cb_k)), abs(spl(2 * cb_k + 1)))); cb_k += 1; );
  cb_t0l = cb_a0l.cb_tp(spl0, 80000, cb_NZ[0] * cb_hiss_g); cb_t0r = cb_a0r.cb_tp(spl1, 80000 + cb_BSZ, cb_NZ[1] * cb_hiss_g);
  cb_t1l = cb_a1l.cb_tp(spl2, 80000 + 2 * cb_BSZ, cb_NZ[2] * cb_hiss_g); cb_t1r = cb_a1r.cb_tp(spl3, 80000 + 3 * cb_BSZ, cb_NZ[3] * cb_hiss_g);
  cb_t2l = cb_a2l.cb_tp(spl4, 80000 + 4 * cb_BSZ, cb_NZ[4] * cb_hiss_g); cb_t2r = cb_a2r.cb_tp(spl5, 80000 + 5 * cb_BSZ, cb_NZ[5] * cb_hiss_g);
  cb_t3l = cb_a3l.cb_tp(spl6, 80000 + 6 * cb_BSZ, cb_NZ[6] * cb_hiss_g); cb_t3r = cb_a3r.cb_tp(spl7, 80000 + 7 * cb_BSZ, cb_NZ[7] * cb_hiss_g);
  cb_wpos = (cb_wpos + 1) & cb_BMSK;
  cb_ml = cb_e0l.cb_eq(cb_t0l) * cb_TG[0] * cb_PL[0] + cb_e1l.cb_eq(cb_t1l) * cb_TG[1] * cb_PL[1] + cb_e2l.cb_eq(cb_t2l) * cb_TG[2] * cb_PL[2] + cb_e3l.cb_eq(cb_t3l) * cb_TG[3] * cb_PL[3];
  cb_mr = cb_e0r.cb_eq(cb_t0r) * cb_TG[0] * cb_PR[0] + cb_e1r.cb_eq(cb_t1r) * cb_TG[1] * cb_PR[1] + cb_e2r.cb_eq(cb_t2r) * cb_TG[2] * cb_PR[2] + cb_e3r.cb_eq(cb_t3r) * cb_TG[3] * cb_PR[3];
  cb_ml *= cb_mst; cb_mr *= cb_mst;
  cb_c4_dst ? ( cb_c4_dkg = cb_c4_dk * cb_c4_dk * (3 - 2 * cb_c4_dk); cb_ml *= cb_c4_dkg; cb_mr *= cb_c4_dkg; );
);

function cp_eq_set(cp_hi, cp_mid, cp_lo) instance(cp_h, cp_m, cp_l) ( cp_h.bq_set(3, 12000, 0.7, cp_hi); cp_m.bq_set(2, 2500, 0.9, cp_mid); cp_l.bq_set(4, 80, 0.7, cp_lo); );
function cp_eq3(cp_x) instance(cp_h, cp_m, cp_l) ( cp_l.bq_run(cp_m.bq_run(cp_h.bq_run(cp_x))) );
function cp_eq2(cp_x) instance(cp_h, cp_l) ( cp_l.bq_run(cp_h.bq_run(cp_x)) );
function cp_rail(cp_x) local(cp_a) (
  cp_hot ? ( cp_x *= 2.8; cp_x = cp_x > 0 ? ost_tanh(cp_x * 1.05) : ost_tanh(cp_x * 1.15) / 1.1; cp_x / 2.94; ) :
  ( cp_a = abs(cp_x); cp_a < 1.2 ? cp_x : sign(cp_x) * (1.2 + 0.2 * ost_tanh((cp_a - 1.2) / 0.2)) );
);

function cp_update() local(cp_i, cp_any, cp_a) (
  cp_mm = slider32 <= -59.9 ? 0 : 10 ^ (slider32 / 20);
  cp_hot = slider33; cp_nse = slider34;
  cp_m1.cp_eq_set(slider43, slider51, slider55); cp_m2.cp_eq_set(slider44, slider52, slider56);
  cp_m3.cp_eq_set(slider45, slider53, slider57); cp_m4.cp_eq_set(slider46, slider54, slider58);
  cp_s5l.cp_eq_set(slider47, 0, slider59); cp_s5r.cp_eq_set(slider47, 0, slider59); cp_s7l.cp_eq_set(slider48, 0, slider60); cp_s7r.cp_eq_set(slider48, 0, slider60);
  cp_s9l.cp_eq_set(slider49, 0, slider61); cp_s9r.cp_eq_set(slider49, 0, slider61); cp_s11l.cp_eq_set(slider50, 0, slider62); cp_s11r.cp_eq_set(slider50, 0, slider62);
  cp_any = 0; cp_i = 0; loop(8, cp_any |= slider( 31 + 48 + cp_i); cp_i += 1; );
  cp_solo_on = cp_any;
  cp_i = 0;
  loop(8,
    cp_CGT[cp_i] = slider( 31 + 40 + cp_i) || (cp_any && !slider( 31 + 48 + cp_i)) || slider( 31 + 4 + cp_i) <= -59.9 ? 0 : 10 ^ (slider( 31 + 4 + cp_i) / 20);
    cp_a = (slider( 31 + 32 + cp_i) + 100) / 200;
    cp_i < 4 ? ( cp_CL[cp_i] = cos(cp_a * 0.5 * $pi); cp_CR[cp_i] = sin(cp_a * 0.5 * $pi); )
          : ( cp_CL[cp_i] = min(1, 2 * (1 - cp_a)); cp_CR[cp_i] = min(1, 2 * cp_a); );
    cp_i += 1;
  );
);

function cp_load_preset(cp_p) (
  cp_p == 1 ? ( slider32 = 0; slider33 = 0; slider34 = 0; ) :
  cp_p == 2 ? ( slider32 = 0; slider33 = 1; slider34 = 0; ) :
  cp_p == 3 ? ( slider32 = 0; slider33 = 1; slider34 = 1; ) :
  cp_p == 4 ? ( slider32 = -3; slider33 = 0; slider34 = 1; );
  cp_p >= 1 && cp_p <= 4 ? s92_autor(32, 34);
  cp_p == 5 ? (
    cp_i = 0; loop(8, slider( 31 + 4 + cp_i) = 0; slider( 31 + 12 + cp_i) = 0; slider( 31 + 24 + cp_i) = 0; slider( 31 + 32 + cp_i) = 0; slider( 31 + 40 + cp_i) = 0; slider( 31 + 48 + cp_i) = 0; cp_i += 1; );
    cp_i = 0; loop(4, slider( 31 + 20 + cp_i) = 0; cp_i += 1; );
    cp_i = 4; loop(52, ui_auto(31 + cp_i); cp_i += 1; );
  );
);

