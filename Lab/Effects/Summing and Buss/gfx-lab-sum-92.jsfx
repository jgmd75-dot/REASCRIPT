  ca_c4_dkr = 1 / (0.012 * srate); ca_c4_dk = 1; ca_c4_dst = 0;
  ca_aer = 1 - exp(-1 / (0.01 * srate)); ca_aes = 1 - exp(-1 / (0.003 * srate));
