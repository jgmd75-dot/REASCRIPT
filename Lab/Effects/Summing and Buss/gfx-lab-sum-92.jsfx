  cb_e3r.cb_bsf.b1 = cb_e3r.cb_bsf.b2 = cb_e3r.cb_bsf.x1 = cb_e3r.cb_bsf.x2 = cb_e3r.cb_bsf.y1 = 0;
  cb_e3r.cb_bsf.y2 = cb_e3r.cb_ts.a1 = cb_e3r.cb_ts.a2 = cb_e3r.cb_ts.b0 = cb_e3r.cb_ts.b1 = cb_e3r.cb_ts.b2 = 0;
  cb_e3r.cb_ts.x1 = cb_e3r.cb_ts.x2 = cb_e3r.cb_ts.y1 = cb_e3r.cb_ts.y2 = 0;
  cb_DEN = 0.00000000000000000001;
