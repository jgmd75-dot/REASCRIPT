  cp_s7r.cp_m.b0 = cp_s7r.cp_m.b1 = cp_s7r.cp_m.b2 = cp_s7r.cp_m.x1 = cp_s7r.cp_m.x2 = cp_s7r.cp_m.y1 = 0;
  cp_s7r.cp_m.y2 = cp_s9l.cp_h.a1 = cp_s9l.cp_h.a2 = cp_s9l.cp_h.b0 = cp_s9l.cp_h.b1 = cp_s9l.cp_h.b2 = 0;
  cp_s9l.cp_h.x1 = cp_s9l.cp_h.x2 = cp_s9l.cp_h.y1 = cp_s9l.cp_h.y2 = cp_s9l.cp_l.a1 = cp_s9l.cp_l.a2 = 0;
  cp_s9l.cp_l.b0 = cp_s9l.cp_l.b1 = cp_s9l.cp_l.b2 = cp_s9l.cp_l.x1 = cp_s9l.cp_l.x2 = cp_s9l.cp_l.y1 = 0;
  cp_s9l.cp_l.y2 = cp_s9l.cp_m.a1 = cp_s9l.cp_m.a2 = cp_s9l.cp_m.b0 = cp_s9l.cp_m.b1 = cp_s9l.cp_m.b2 = 0;
  cp_s9l.cp_m.x1 = cp_s9l.cp_m.x2 = cp_s9l.cp_m.y1 = cp_s9l.cp_m.y2 = cp_s9r.cp_h.a1 = cp_s9r.cp_h.a2 = 0;
  cp_s9r.cp_h.b0 = cp_s9r.cp_h.b1 = cp_s9r.cp_h.b2 = cp_s9r.cp_h.x1 = cp_s9r.cp_h.x2 = cp_s9r.cp_h.y1 = 0;
  cp_s9r.cp_h.y2 = cp_s9r.cp_l.a1 = cp_s9r.cp_l.a2 = cp_s9r.cp_l.b0 = cp_s9r.cp_l.b1 = cp_s9r.cp_l.b2 = 0;
  cp_s9r.cp_l.x1 = cp_s9r.cp_l.x2 = cp_s9r.cp_l.y1 = cp_s9r.cp_l.y2 = cp_s9r.cp_m.a1 = cp_s9r.cp_m.a2 = 0;
  cp_s9r.cp_m.b0 = cp_s9r.cp_m.b1 = cp_s9r.cp_m.b2 = cp_s9r.cp_m.x1 = cp_s9r.cp_m.x2 = cp_s9r.cp_m.y1 = 0;
  cp_s9r.cp_m.y2 = 0;
  cp_CG = 400; cp_CGT = 410; cp_CPK = 420; cp_CL = 430; cp_CR = 440;
  memset(400, 0, 50);
  cp_sm = 1 - exp(-1 / (0.02 * srate));
  cp_nz_g = 10 ^ (-84 / 20);
  cp_update();
  cp_i = 0; loop(8, cp_CG[cp_i] = cp_CGT[cp_i]; cp_i += 1; );
);

function cp_run() (
  cp_k = 0; loop(8, cp_CG[cp_k] += (cp_CGT[cp_k] - cp_CG[cp_k]) * cp_sm; cp_k += 1; );
  cp_k = 0; loop(4, cp_CPK[cp_k] = max(cp_CPK[cp_k], abs(spl(cp_k))); cp_k += 1; );
  cp_k = 0; loop(4, cp_CPK[4 + cp_k] = max(cp_CPK[4 + cp_k], max(abs(spl(4 + 2 * cp_k)), abs(spl(5 + 2 * cp_k)))); cp_k += 1; );
  cp_x = cp_m1.cp_eq3(spl0) * cp_CG[0]; cp_ml = cp_x * cp_CL[0]; cp_mr = cp_x * cp_CR[0];
  cp_x = cp_m2.cp_eq3(spl1) * cp_CG[1]; cp_ml += cp_x * cp_CL[1]; cp_mr += cp_x * cp_CR[1];
  cp_x = cp_m3.cp_eq3(spl2) * cp_CG[2]; cp_ml += cp_x * cp_CL[2]; cp_mr += cp_x * cp_CR[2];
  cp_x = cp_m4.cp_eq3(spl3) * cp_CG[3]; cp_ml += cp_x * cp_CL[3]; cp_mr += cp_x * cp_CR[3];
  cp_ml += cp_s5l.cp_eq2(spl4) * cp_CG[4] * cp_CL[4];   cp_mr += cp_s5r.cp_eq2(spl5) * cp_CG[4] * cp_CR[4];
  cp_ml += cp_s7l.cp_eq2(spl6) * cp_CG[5] * cp_CL[5];   cp_mr += cp_s7r.cp_eq2(spl7) * cp_CG[5] * cp_CR[5];
  cp_ml += cp_s9l.cp_eq2(spl8) * cp_CG[6] * cp_CL[6];   cp_mr += cp_s9r.cp_eq2(spl9) * cp_CG[6] * cp_CR[6];
  cp_ml += cp_s11l.cp_eq2(spl10) * cp_CG[7] * cp_CL[7]; cp_mr += cp_s11r.cp_eq2(spl11) * cp_CG[7] * cp_CR[7];
  cp_nse ? ( cp_ml += (rand(2) - 1) * cp_nz_g; cp_mr += (rand(2) - 1) * cp_nz_g; );
  cp_ml = cp_rail(cp_ml * cp_mm); cp_mr = cp_rail(cp_mr * cp_mm);
);

function fm_f4_hp(fm_f) instance(fm_b0, fm_b1, fm_b2, fm_a1, fm_a2) local(fm_w, fm_cw, fm_al, fm_d0) (
  fm_w = 2 * $pi * fm_f / srate; fm_cw = cos(fm_w); fm_al = sin(fm_w) / (2 * 0.7071); fm_d0 = 1 + fm_al;
  fm_b0 = (1 + fm_cw) / 2 / fm_d0; fm_b1 = -(1 + fm_cw) / fm_d0; fm_b2 = (1 + fm_cw) / 2 / fm_d0; fm_a1 = -2 * fm_cw / fm_d0; fm_a2 = (1 - fm_al) / fm_d0;
);
function fm_f4_bq(fm_x) instance(fm_b0, fm_b1, fm_b2, fm_a1, fm_a2, fm_z1, fm_z2) local(fm_y) (
  fm_y = fm_b0 * fm_x + fm_z1; fm_z1 = fm_b1 * fm_x - fm_a1 * fm_y + fm_z2; fm_z2 = fm_b2 * fm_x - fm_a2 * fm_y; fm_y;
);
function fm_f4_iron(fm_x, fm_amt, fm_drv) instance(fm_lf, fm_hf) local(fm_d, fm_c, fm_sc_) (
  fm_lf += (fm_x - fm_lf) * fm_f4_ia;
  fm_d = 1 + 5 * fm_drv * fm_amt;
  fm_c = fm_lf * fm_d; fm_sc_ = fm_c / sqrt(1 + fm_c * fm_c);
  fm_x += (fm_sc_ - fm_c) / fm_d * (0.6 + 0.4 * fm_amt) + fm_amt * 0.03 * fm_lf * fm_lf * fm_d;
  fm_hf += (fm_x - fm_hf) * fm_f4_ha;
  fm_x + (fm_hf - fm_x) * fm_amt * 0.35;
);
function fm_f4_rail(fm_x, fm_hv) ( fm_x / (1 + (abs(fm_x) / fm_hv) ^ 4) ^ 0.25; );

function fm_ch_set(fm_k) instance(fm_hl, fm_hr, fm_hp_on, fm_trim, fm_il_on, fm_pol, fm_ms, fm_wid, fm_pl, fm_pr, fm_fad, fm_mute, fm_solo) local(fm_th) (
  fm_hp_on = slider( 86 + fm_k) > 75.5; fm_hl.fm_f4_hp(slider( 86 + fm_k)); fm_hr.fm_f4_hp(slider( 86 + fm_k));
  fm_trim = 10 ^ (slider( 86 + fm_k + 1) / 20);
  fm_il_on = slider( 86 + fm_k + 2) > 0.5; fm_pol = slider( 86 + fm_k + 3) > 0.5 ? -1 : 1; fm_ms = slider( 86 + fm_k + 4) > 0.5;
  fm_wid = (slider( 86 + fm_k + 5) + 100) / 100;
  fm_th = (slider( 86 + fm_k + 5) / 100 + 1) * $pi / 4; fm_pl = cos(fm_th) * sqrt(2); fm_pr = sin(fm_th) * sqrt(2);
  fm_fad = slider( 86 + fm_k + 6) <= -39.95 ? 0 : 10 ^ (slider( 86 + fm_k + 6) / 20);
  fm_mute = slider( 86 + fm_k + 7) > 0.5; fm_solo = slider( 86 + fm_k + 8) > 0.5;
);
function fm_ch_run(fm_l, fm_r) instance(fm_hl, fm_hr, fm_il, fm_ir, fm_hp_on, fm_trim, fm_il_on, fm_pol, fm_ms, fm_wid, fm_pl, fm_pr, fm_fad, fm_mute, fm_solo, fm_env, fm_pk, fm_lim)
  local(fm_lv, fm_gr, fm_g, fm_m, fm_s) (
  fm_hp_on ? ( fm_l = fm_hl.fm_f4_bq(fm_l); fm_r = fm_hr.fm_f4_bq(fm_r); );
  fm_l *= fm_trim; fm_r *= fm_trim;
  fm_l = fm_il.fm_f4_iron(fm_l, fm_iron_i, fm_sup); fm_r = fm_ir.fm_f4_iron(fm_r, fm_iron_i, fm_sup);
  fm_l = fm_f4_rail(fm_l, fm_hv); fm_r = fm_f4_rail(fm_r, fm_hv);
  fm_pk = max(fm_pk, max(abs(fm_l), abs(fm_r)));
  fm_il_on ? (
    fm_lv = max(abs(fm_l), abs(fm_r)); fm_env += (fm_lv - fm_env) * (fm_lv > fm_env ? fm_l_at : fm_l_rl);
    fm_gr = max(20 * log10(max(fm_env, 0.000001)) - fm_il_thr, 0) * 0.95; fm_g = 10 ^ (-fm_gr / 20); fm_l *= fm_g; fm_r *= fm_g; fm_lim = max(fm_lim, fm_gr);
  );
  fm_ms ? (
    fm_m = fm_l; fm_s = fm_r * fm_pol * fm_wid;
    fm_l = (fm_m + fm_s) * 0.7071; fm_r = (fm_m - fm_s) * 0.7071;
    fm_l *= fm_fad; fm_r *= fm_fad;
  ) : (
    fm_l *= fm_pol * fm_fad * fm_pl; fm_r *= fm_pol * fm_fad * fm_pr;
  );
  (fm_mute || (fm_any_solo && !fm_solo)) ? ( fm_l = 0; fm_r = 0; );
  fm_ch_l = fm_l; fm_ch_r = fm_r;
);

function fm_setch(fm_k, fm_h, fm_t, fm_ms) ( slider( 86 + fm_k) = fm_h; slider( 86 + fm_k + 1) = fm_t; slider( 86 + fm_k + 4) = fm_ms; );
function fm_setm(fm_ol, fm_th, fm_ir, fm_ii) ( slider124 = fm_ol; slider125 = fm_th; slider126 = fm_ir; slider132 = fm_ii; );
function fm_apply_preset(fm_n) (
  fm_n == 0 ? ( fm_setch(1, 75, 0, 0); fm_setch(10, 75, 0, 0); fm_setch(19, 75, 0, 0); fm_setch(28, 75, 0, 0); fm_setm(2, 20, 30, 30); ) :
  fm_n == 1 ? ( fm_setch(1, 75, 6, 0); fm_setch(10, 100, 4, 0); fm_setch(19, 120, 3, 0); fm_setch(28, 90, 6, 0); fm_setm(2, 16, 55, 45); ) :
  fm_n == 2 ? ( fm_setch(1, 120, 8, 1); fm_setch(10, 120, 6, 0); fm_setch(19, 160, 6, 0); fm_setch(28, 160, 6, 0); fm_setm(2, 18, 30, 30); ) :
  fm_n == 3 ? ( fm_setch(1, 75, 3, 0); fm_setch(10, 90, 3, 0); fm_setch(19, 100, 3, 0); fm_setch(28, 120, 3, 0); fm_setm(2, 18, 45, 40); ) :
  fm_n == 4 ? ( fm_setch(1, 140, 6, 0); fm_setch(10, 140, 6, 0); fm_setch(19, 75, 0, 0); fm_setch(28, 75, 0, 0); fm_setm(2, 18, 25, 25); ) :
           ( fm_setch(1, 75, 2, 0); fm_setch(10, 75, 2, 0); fm_setch(19, 75, 2, 0); fm_setch(28, 75, 2, 0); fm_setm(2, 12, 60, 50); );
  s92_autor(87, 132);
);

function fm_update() (
  fm_c1.fm_ch_set(1); fm_c2.fm_ch_set(10); fm_c3.fm_ch_set(19); fm_c4.fm_ch_set(28);
  fm_any_solo = slider95 > 0.5 || slider104 > 0.5 || slider113 > 0.5 || slider122 > 0.5;
  fm_mfad = slider123 <= -39.95 ? 0 : 10 ^ (slider123 / 20);
  fm_ol_m = floor(slider124 + 0.5); fm_ol_thr = slider125 - 20;
  fm_iron_o = slider126 / 100; fm_iron_i = slider132 / 100;
  fm_tone_on = slider127 > 0.5; fm_tone_f = slider128 < 0.5 ? 1000 : slider128 < 1.5 ? 400 : 100; fm_tone_a = 10 ^ ((slider129 - 20) / 20) * sqrt(2);
  drift_macro(0);
  fm_l_at = 1 - exp(-1 / (max(slider133, 0.05) * 0.001 * srate)); fm_l_rl = 1 - exp(-1 / (slider134 * 0.001 * srate));

);

function fm_reset() (
  fm_any_solo = fm_ch_l = fm_ch_r = fm_f4_ha = fm_f4_ia = fm_grl = fm_grr = fm_hv = fm_il_thr = fm_iron_i = 0;
  fm_iron_o = fm_l_at = fm_l_rl = fm_lastp = fm_lv = fm_mfad = fm_ol = fm_ol_hit = fm_ol_m = fm_ol_t = 0;
  fm_ol_thr = fm_oll_e = fm_olr_e = fm_or = fm_sag = fm_sag_c = fm_sl = fm_sr = fm_sup = fm_tn_ph = fm_tone_a = 0;
  fm_tone_f = fm_tone_on = fm_vu_c = fm_vu_e = fm_vu_sine = fm_vv = fm_c1.fm_env = fm_c1.fm_fad = 0;
  fm_c1.fm_hl.fm_a1 = fm_c1.fm_hl.fm_a2 = fm_c1.fm_hl.fm_b0 = fm_c1.fm_hl.fm_b1 = fm_c1.fm_hl.fm_b2 = 0;
  fm_c1.fm_hl.fm_z1 = fm_c1.fm_hl.fm_z2 = fm_c1.fm_hp_on = fm_c1.fm_hr.fm_a1 = fm_c1.fm_hr.fm_a2 = 0;
  fm_c1.fm_hr.fm_b0 = fm_c1.fm_hr.fm_b1 = fm_c1.fm_hr.fm_b2 = fm_c1.fm_hr.fm_z1 = fm_c1.fm_hr.fm_z2 = 0;
  fm_c1.fm_il.fm_hf = fm_c1.fm_il.fm_lf = fm_c1.fm_il_on = fm_c1.fm_ir.fm_hf = fm_c1.fm_ir.fm_lf = 0;
  fm_c1.fm_lim = fm_c1.fm_ms = fm_c1.fm_mute = fm_c1.fm_pk = fm_c1.fm_pl = fm_c1.fm_pol = fm_c1.fm_pr = 0;
  fm_c1.fm_solo = fm_c1.fm_trim = fm_c1.fm_wid = fm_c2.fm_env = fm_c2.fm_fad = fm_c2.fm_hl.fm_a1 = 0;
  fm_c2.fm_hl.fm_a2 = fm_c2.fm_hl.fm_b0 = fm_c2.fm_hl.fm_b1 = fm_c2.fm_hl.fm_b2 = fm_c2.fm_hl.fm_z1 = 0;
  fm_c2.fm_hl.fm_z2 = fm_c2.fm_hp_on = fm_c2.fm_hr.fm_a1 = fm_c2.fm_hr.fm_a2 = fm_c2.fm_hr.fm_b0 = 0;
  fm_c2.fm_hr.fm_b1 = fm_c2.fm_hr.fm_b2 = fm_c2.fm_hr.fm_z1 = fm_c2.fm_hr.fm_z2 = fm_c2.fm_il.fm_hf = 0;
  fm_c2.fm_il.fm_lf = fm_c2.fm_il_on = fm_c2.fm_ir.fm_hf = fm_c2.fm_ir.fm_lf = fm_c2.fm_lim = fm_c2.fm_ms = 0;
  fm_c2.fm_mute = fm_c2.fm_pk = fm_c2.fm_pl = fm_c2.fm_pol = fm_c2.fm_pr = fm_c2.fm_solo = fm_c2.fm_trim = 0;
  fm_c2.fm_wid = fm_c3.fm_env = fm_c3.fm_fad = fm_c3.fm_hl.fm_a1 = fm_c3.fm_hl.fm_a2 = fm_c3.fm_hl.fm_b0 = 0;
  fm_c3.fm_hl.fm_b1 = fm_c3.fm_hl.fm_b2 = fm_c3.fm_hl.fm_z1 = fm_c3.fm_hl.fm_z2 = fm_c3.fm_hp_on = 0;
  fm_c3.fm_hr.fm_a1 = fm_c3.fm_hr.fm_a2 = fm_c3.fm_hr.fm_b0 = fm_c3.fm_hr.fm_b1 = fm_c3.fm_hr.fm_b2 = 0;
  fm_c3.fm_hr.fm_z1 = fm_c3.fm_hr.fm_z2 = fm_c3.fm_il.fm_hf = fm_c3.fm_il.fm_lf = fm_c3.fm_il_on = 0;
  fm_c3.fm_ir.fm_hf = fm_c3.fm_ir.fm_lf = fm_c3.fm_lim = fm_c3.fm_ms = fm_c3.fm_mute = fm_c3.fm_pk = 0;
  fm_c3.fm_pl = fm_c3.fm_pol = fm_c3.fm_pr = fm_c3.fm_solo = fm_c3.fm_trim = fm_c3.fm_wid = fm_c4.fm_env = 0;
  fm_c4.fm_fad = fm_c4.fm_hl.fm_a1 = fm_c4.fm_hl.fm_a2 = fm_c4.fm_hl.fm_b0 = fm_c4.fm_hl.fm_b1 = 0;
  fm_c4.fm_hl.fm_b2 = fm_c4.fm_hl.fm_z1 = fm_c4.fm_hl.fm_z2 = fm_c4.fm_hp_on = fm_c4.fm_hr.fm_a1 = 0;
  fm_c4.fm_hr.fm_a2 = fm_c4.fm_hr.fm_b0 = fm_c4.fm_hr.fm_b1 = fm_c4.fm_hr.fm_b2 = fm_c4.fm_hr.fm_z1 = 0;
  fm_c4.fm_hr.fm_z2 = fm_c4.fm_il.fm_hf = fm_c4.fm_il.fm_lf = fm_c4.fm_il_on = fm_c4.fm_ir.fm_hf = 0;
  fm_c4.fm_ir.fm_lf = fm_c4.fm_lim = fm_c4.fm_ms = fm_c4.fm_mute = fm_c4.fm_pk = fm_c4.fm_pl = fm_c4.fm_pol = 0;
  fm_c4.fm_pr = fm_c4.fm_solo = fm_c4.fm_trim = fm_c4.fm_wid = fm_drv.a = fm_drv.b = fm_drv.ph = fm_drv.rm = 0;
  fm_drv.v = fm_iol.fm_hf = fm_iol.fm_lf = fm_ior.fm_hf = fm_ior.fm_lf = 0;
  fm_drV.drift_init(0.8 + rand(1) * 0.5);
  fm_f4_ia = 1 - exp(-2 * $pi * 110 / srate);
  fm_f4_ha = 1 - exp(-2 * $pi * 14000 / srate);
  fm_vu_c = 1 - exp(-1 / (0.065 * srate));
  fm_vu_sine = 10 * log10(2);
  fm_sag_c = 1 - exp(-1 / (0.6 * srate));
  fm_update();
);

function fm_run() (
  fm_c1.fm_ch_run(spl0, spl1); fm_sL = fm_ch_l; fm_sR = fm_ch_r;
  fm_c2.fm_ch_run(spl2, spl3); fm_sL += fm_ch_l; fm_sR += fm_ch_r;
  fm_c3.fm_ch_run(spl4, spl5); fm_sL += fm_ch_l; fm_sR += fm_ch_r;
  fm_c4.fm_ch_run(spl6, spl7); fm_sL += fm_ch_l; fm_sR += fm_ch_r;
  fm_sag += (min((abs(fm_sL) + abs(fm_sR)) * 0.5, 2) - fm_sag) * fm_sag_c;

  fm_vu_e += ((fm_sL * fm_sL + fm_sR * fm_sR) * 0.5 - fm_vu_e) * fm_vu_c;

  fm_sL *= fm_mfad; fm_sR *= fm_mfad;
  fm_tone_on ? ( fm_tn_ph += fm_tone_f / srate; fm_tn_ph -= floor(fm_tn_ph); fm_sL = fm_sR = fm_tone_a * sin(2 * $pi * fm_tn_ph); );

  fm_ol_m > 0 ? (
    fm_ol_m == 2 ? ( fm_lv = max(abs(fm_sL), abs(fm_sR)); fm_olL_e += (fm_lv - fm_olL_e) * (fm_lv > fm_olL_e ? fm_l_at : fm_l_rl); fm_olR_e = fm_olL_e; ) :
                ( fm_lv = abs(fm_sL); fm_olL_e += (fm_lv - fm_olL_e) * (fm_lv > fm_olL_e ? fm_l_at : fm_l_rl); fm_lv = abs(fm_sR); fm_olR_e += (fm_lv - fm_olR_e) * (fm_lv > fm_olR_e ? fm_l_at : fm_l_rl); );
    fm_grL = max(20 * log10(max(fm_olL_e, 0.000001)) - fm_ol_t, 0) * 0.95; fm_grR = max(20 * log10(max(fm_olR_e, 0.000001)) - fm_ol_t, 0) * 0.95;
    fm_sL *= 10 ^ (-fm_grL / 20); fm_sR *= 10 ^ (-fm_grR / 20);
    fm_ol_hit = max(fm_ol_hit, max(fm_grL, fm_grR));
  );

  fm_sL = fm_ioL.fm_f4_iron(fm_sL, fm_iron_o, fm_sup); fm_sR = fm_ioR.fm_f4_iron(fm_sR, fm_iron_o, fm_sup);
  fm_oL = fm_sL; fm_oR = fm_sR;
);

function fm_blockrun() (
  fm_update();
  fm_vV = fm_drV.drift_tick(0.08 * dm_s * samplesblock / srate);
  fm_sup = 1 + 0.03 * dm_a * fm_vV - 0.10 * dm_a * min(fm_sag, 1);
  fm_il_thr = -2 + 20 * log10(fm_sup);
  fm_ol_t = fm_ol_thr + 20 * log10(fm_sup);
  fm_hv = 1.58 * fm_sup;
);

function s92_reset(m) ( s92_tfrc = 1; m == 0 ? ca_reset() : m == 1 ? cb_reset() : m == 2 ? cp_reset() : fm_reset(); );
function s92_upd(m) ( m == 2 ? cp_update() : fm_update(); );
function s92_update(m) ( m == 0 ? ( ca_c4_dst != 1 ? ca_update(); ) : m == 1 ? ( cb_c4_dst != 1 ? cb_update(); ) : !(s92_dst == 1 && m == s92_cur) ? s92_upd(m); );
function s92_tchg() local(c) (
  c = (slider2 != s92_t2) | (slider3 != s92_t3) | (slider4 != s92_t4) | (slider5 != s92_t5) | (slider6 != s92_t6) |
    (slider7 != s92_t7) | (slider8 != s92_t8) | (slider9 != s92_t9) | (slider10 != s92_t10) | (slider11 != s92_t11) |
    (slider12 != s92_t12) | (slider13 != s92_t13) | (slider14 != s92_t14) | (slider15 != s92_t15) | (slider16 != s92_t16) |
    (slider17 != s92_t17) | (slider18 != s92_t18) | (slider19 != s92_t19) | (slider20 != s92_t20) | (slider21 != s92_t21) |
    (slider22 != s92_t22) | (slider23 != s92_t23) | (slider24 != s92_t24) | (slider25 != s92_t25) | (slider26 != s92_t26) |
    (slider27 != s92_t27) | (slider28 != s92_t28) | (slider29 != s92_t29) | (slider30 != s92_t30) | (slider31 != s92_t31);
  c ? (
  s92_t2 = slider2; s92_t3 = slider3; s92_t4 = slider4; s92_t5 = slider5; s92_t6 = slider6; s92_t7 = slider7;
  s92_t8 = slider8; s92_t9 = slider9; s92_t10 = slider10; s92_t11 = slider11; s92_t12 = slider12; s92_t13 = slider13;
  s92_t14 = slider14; s92_t15 = slider15; s92_t16 = slider16; s92_t17 = slider17; s92_t18 = slider18; s92_t19 = slider19;
