//author: JGWizrad / Garden FX (GFX)
//
// gfx-lab-glow - the backlit meter face for units that draw their own meters and don't import gfx-lab-ui
// (gfx-lab-ui has the same code as ui_glow / ui_spill - keep the two in step; never import both).

@init
// ---------- a backlit meter face (JG, 26 Oct 2026: "steady glow", dimmed on bypass) ----------
// vg_glow(x, y, w, h, lamp): the face of a needle meter's window (pixels), lit from behind by a warm lamp just below
// the bottom centre - brightest in the lower middle, deeper amber in the corners, a soft inner shadow from the bezel,
// a lit lip round the window. lamp 0..1 (1 = lit). Draw the scale and needle over it.
// ui_vu_dim = 1 (set by the unit while it is bypassed; the house BYPASS key sets it) fades every lamp down to a
// dim glow in about 0.4 s, and back.
// Each size is rendered once into one of the image slots 100 - 107 (looked up by size) and then only blitted.
// vg_glblue = 1 (set before the call): a cool blue lamp instead of the warm one (GLU34, JG 27 Oct 2026); blue faces
// live in slots 108 - 115.
// vg_glblue = 2: a cool daylight-white lamp (OBQ-1, JG 28 Oct 2026); white faces share slots 108 - 115 with the blue
// ones, so a unit uses one or the other.
// vg_spill(x, y, w, h, lamp): the lamp's light spilling softly onto the plate round a bezel (draw before the bezel).
function vg_glvl() local(dt) (
  dt = min(max(time_precise() - vg_glt, 0), 0.05); vg_glt = time_precise();
  vg_gl == 0 ? vg_gl = ui_vu_dim ? 0.18 : 1;                  // the first frame: no fade in
  vg_gl += ((ui_vu_dim ? 0.18 : 1) - vg_gl) * min(dt * 6, 1);
);
function vg_glow(x, y, w, h, lamp) local(fw, fh, s, k, iw, ih, i, j, dx, dy, t, e, q, d, b0) (
  fw = floor(w + 0.5); fh = floor(h + 0.5);
  vg_glvl(); lamp *= vg_gl;
  b0 = vg_glblue ? 108 : 100; s = 0; k = b0;
  loop(8, iw = 0; ih = 0; gfx_getimgdim(k, iw, ih); s == 0 && iw == fw && ih == fh ? s = k; k += 1; );
  s == 0 && fw > 0 && fh > 0 ? (
    k = b0; loop(8, iw = 0; ih = 0; gfx_getimgdim(k, iw, ih); s == 0 && iw == 0 ? s = k; k += 1; );
    s == 0 ? ( s = b0 + vg_gn; vg_gn = (vg_gn + 1) % 8; );
    d = gfx_dest; gfx_setimgdim(s, fw, fh); gfx_dest = s; gfx_a = 1; gfx_mode = 0;
    j = 0;
    loop(fh,
      i = 0;
      loop(fw,
        dx = (i + 0.5 - fw * 0.5) / (fw * 0.62); dy = (j + 0.5 - fh * 1.02) / (fh * 1.05);
        t = exp(-1.35 * (dx * dx + dy * dy));                        // 1 at the lamp, about 0.3 in the top corners
        e = min(min(i, fw - 1 - i), min(j * 0.8, fh - 1 - j)) / max(fh * 0.06, 2);   // the bezel's inner shadow
        q = (e < 1 ? 0.72 + 0.28 * e : 1) / 255;
        gfx_x = i; gfx_y = j;
        vg_glblue == 2 ? gfx_setpixel((0xC4 + 0x38 * t) * q, (0xD2 + 0x2C * t) * q, (0xC6 + 0x30 * t * t) * q) :
        vg_glblue ? gfx_setpixel((0x62 + 0x76 * t * t) * q, (0xA6 + 0x4C * t) * q, (0xDE + 0x21 * t) * q)
                  : gfx_setpixel((0xC9 + 0x36 * t) * q, (0x93 + 0x61 * t) * q, (0x45 + 0x83 * t * t) * q);
        i += 1;
      );
      j += 1;
    );
    gfx_dest = d;
  );
  s ? (
    vg_glblue == 2 ? ( gfx_r = 0.40; gfx_g = 0.42; gfx_b = 0.38; ) :
    vg_glblue ? ( gfx_r = 0.235; gfx_g = 0.333; gfx_b = 0.451; ) : ( gfx_r = 0.431; gfx_g = 0.373; gfx_b = 0.267; );
    gfx_a = 1; gfx_mode = 0; gfx_rect(x, y, fw, fh);                                                // the lamp down
    gfx_x = x; gfx_y = y; gfx_a = lamp; gfx_blit(s, 1, 0);
    vg_glblue == 2 ? ( gfx_r = 0.92; gfx_g = 0.98; gfx_b = 0.92; ) :
    vg_glblue ? ( gfx_r = 0.6; gfx_g = 0.84; gfx_b = 1; ) : ( gfx_r = 1; gfx_g = 0.753; gfx_b = 0.376; );
    gfx_a = 0.35 * lamp;                                                          // the lit lip
    gfx_rect(x - 1, y - 1, fw + 2, 1); gfx_rect(x - 1, y + fh, fw + 2, 1); gfx_rect(x - 1, y, 1, fh); gfx_rect(x + fw, y, 1, fh);
    gfx_a = 1;
  );
);
function vg_spill(x, y, w, h, lamp) local(i, g) (
  vg_glvl(); lamp *= vg_gl;
  g = min(max(floor(h * 0.04), 3), 6) * 1.6;
  vg_glblue == 2 ? ( gfx_r = 0.9; gfx_g = 0.95; gfx_b = 0.85; ) :
  vg_glblue ? ( gfx_r = 0.45; gfx_g = 0.72; gfx_b = 1; ) : ( gfx_r = 1; gfx_g = 0.702; gfx_b = 0.278; );
  i = 0; loop(5, gfx_a = 0.035 * lamp; gfx_rect(x - g * (5 - i) / 5, y - g * (5 - i) / 5, w + 2 * g * (5 - i) / 5, h + 2 * g * (5 - i) / 5); i += 1; );
  gfx_a = 1;
);
