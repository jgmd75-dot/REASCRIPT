desc:Lead 8 Mini [poly lead synth] (GFX Lab)
//tags: instrument synth poly lead analogue mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-voice, gfx-lab-warmup, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider46:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:p_w1=0<0,1,1{Saw,Pulse}>-Osc 1 wave
slider2:p_w2=0<0,1,1{Saw,Pulse}>-Osc 2 wave
slider3:p_crs=0<-24,24,1>-Osc 2 coarse (st)
slider4:p_fin=8<-50,50,0.1>-Osc 2 fine (cents)
slider5:p_mix=50<0,100,1>-Osc mix (%)
slider6:p_pw=50<5,95,1>-Pulse width (%)
slider7:p_cut=2200<20,18000,1>-Cutoff (Hz)
slider8:p_res=25<0,100,1>-Resonance (%)
slider9:p_env=45<-100,100,1>-Filter env amount (%)
slider10:p_ktr=50<0,100,1>-Key track (%)
slider11:p_fra=0.667<0.05,20,0.001>-Filter attack (x attack)
slider12:p_frd=1.75<0.05,20,0.001>-Filter decay (x decay)
slider13:p_fsu=35<0,100,1>-Filter sustain (%)
slider14:p_frr=1.2<0.05,20,0.001>-Filter release (x release)
slider15:p_att=3<0.5,3000,0.1>-Attack (ms)
slider16:p_dec=200<5,5000,1>-Decay (ms)
slider17:p_asu=90<0,100,1>-Sustain (%)
slider18:p_rel=250<5,5000,1>-Release (ms)
slider19:p_lfr=5.2<0.01,20,0.01>-LFO rate (Hz)
slider20:p_lfs=1<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO shape
slider21:p_vib=6<0,100,1>-Vibrato (cents)
slider22:p_lpw=0<0,100,1>-LFO to PWM (%)
slider23:p_lct=0<0,100,1>-LFO to cutoff (%)
slider24:p_gld=0<0,1000,1>-Glide (ms)
slider25:p_vm=1<0,1,1{Poly,Mono}>-Voice mode
slider26:p_vel=40<0,100,1>-Velocity (%)
slider27:p_drf=50<0,100,1>-Drift (%)
slider28:p_ch=0<0,16,1>-MIDI channel (0 = omni)
slider29:p_vol=0<-24,6,0.1>-Volume (dB)
slider30:l8_u30=0<0,1,1>-(unused, was Arp)
slider31:l8_u31=0<0,6,1>-(unused, was Arp mode)
slider32:l8_u32=3<0,5,1>-(unused, was Arp rate)
slider33:l8_u33=1<1,4,1>-(unused, was Arp octaves)
slider34:l8_u34=60<10,200,1>-(unused, was Arp gate)
slider35:l8_u35=0<0,1,1>-(unused, was Arp latch)
slider36:l8_u36=0<0,75,1>-(unused, was Arp swing)
slider37:p_bst=0<0,100,1>-Band sat (%)
slider38:p_bbi=30<0,100,1>-Bias (%)
slider39:p_blo=120<40,400,1>-Sat low band (Hz)
slider40:p_bhi=6000<2000,16000,10>-Sat high band (Hz)
slider41:p_ceil=-0.3<-24,0,0.1>-Ceiling (dB)
slider42:p_trm=0.923<0.1,2,0.001>-Patch level (x)
slider43:p_mlo=20<20,500,1>-Mono below (Hz, 20 = off)
slider44:p_wid=0<0,100,1>-Stereo width (%)
slider45:prs_sel=0<0,12,1{No preset,Classic Lead,Poly Brass,Fat Mono,Square Lead,PWM Strings,Hollow Pipe,Fifths,Soft Poly,Resonant Sweep,Vintage Detune,Wobble Lead,Init}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(70368744177663, v); );
function psw_allg(v) ( slider_show(70368744177663, v); );
#ui_man = "gfx-lab-g-lead-8-mini";
ext_noinit = 1;

NV = 8;
VN = 50000; VG = 50010; VT = 50020; VS = 50030;
HN = 50100;
EQO = 50300; EQT = 50600; EQN = 50900; EQV = 51200;
gi = 0; loop(NV, VN[gi] = -1; VG[gi] = 0; VT[gi] = 0; VS[gi] = 0; gi += 1; );

function vinit(p) instance(pan, cur, tgt, nd, df1, df2, dpw, drA, drB, drP, nwb) (
  nwb = NWV; NWV += 4;
  pan = p; cur = 60; tgt = 60; nd = 1; df1 = 0; df2 = 0; dpw = 0;
  drA.drift_init(0.8 + rand(1) * 0.5); drB.drift_init(0.8 + rand(1) * 0.5); drP.drift_init(0.8 + rand(1) * 0.5);
);
function vblock(inc) instance(df1, df2, dpw, drA, drB, drP) (
  df1 = drA.drift_tick(inc) * drift * 8;
  df2 = drB.drift_tick(inc) * drift * 8;
  dpw = drP.drift_tick(inc) * drift * 0.2;
);
function vstart(n, v, retrig) instance(cur, tgt, vel, nd, fe, ae, played, fi, nwb) (
  ae.lv < 0.05 ? ( fi = 0; nw_start(nwb); );
  tgt = n; vel = v / 127;
  glide_c >= 1 || !played ? cur = n;
  retrig ? nd = ins_note_detune();
  fe.vo_adsr_gate(1, retrig); ae.vo_adsr_gate(1, retrig);
  played = 1;
);
function vstop() instance(fe, ae) ( fe.vo_adsr_gate(0, 0); ae.vo_adsr_gate(0, 0); );
function vglide(n) instance(tgt) ( tgt = n; );
function vkill() instance(fe, ae, flt, fi) (
  fe.st = 0; fe.lv = 0; ae.st = 0; ae.lv = 0;
  flt.s1 = 0; flt.s2 = 0; flt.s3 = 0; flt.s4 = 0; fi = 0;
);
function vrun() instance(o1, o2, flt, fe, ae, cur, tgt, vel, nd, df1, df2, dpw, fi, nwb) local(f, i1, i2, pwv, y, e, oct, vgain) (
  ae.st == 0 ? 0 : (
    cur += (tgt - cur) * glide_c;
    f = 440 * 2 ^ ((cur + vib_st - 69) / 12) * bend * ins_pitch * nd * wu_t;
    i1 = min(f * 2 ^ (df1 / 1200) / srate, 0.45);
    i2 = min(f * o2_ratio * 2 ^ (df2 / 1200 + ins_aux / 12) / srate, 0.45);
    pwv = min(max(pw + lfo * lfo_pwm * 0.4 + dpw, 0.05), 0.95);
    y = (w1 ? o1.vo_pulse(i1, pwv) : o1.vo_saw(i1)) * (1 - mix) + (w2 ? o2.vo_pulse(i2, pwv) : o2.vo_saw(i2)) * mix;
    vgain = 1 - velsens + velsens * vel;
    oct = fl_ev * fe.vo_adsr() * 6 * (0.6 + 0.4 * vgain) + keytr * (cur - 60) / 12 + lfo * lfo_cut * 3;
    y = flt.vo_ladder(y * 0.45, min(max(exp(fl_c2 + oct * 0.693147), 20), srate * 0.45), fl_rs, 0);
    e = ae.vo_adsr();
    fi < 1 ? ( e *= 0.5 - 0.5 * cos($pi * fi); fi = min(fi + 1 / (0.002 * srate), 1); );
    nw_run(nwb, y * e * vgain);
  );
);

function v_start(i, n, v, r) (
  i == 0 ? v0.vstart(n, v, r) : i == 1 ? v1.vstart(n, v, r) : i == 2 ? v2.vstart(n, v, r) : i == 3 ? v3.vstart(n, v, r) :
  i == 4 ? v4.vstart(n, v, r) : i == 5 ? v5.vstart(n, v, r) : i == 6 ? v6.vstart(n, v, r) : v7.vstart(n, v, r);
);
function v_stop(i) (
  i == 0 ? v0.vstop() : i == 1 ? v1.vstop() : i == 2 ? v2.vstop() : i == 3 ? v3.vstop() :
  i == 4 ? v4.vstop() : i == 5 ? v5.vstop() : i == 6 ? v6.vstop() : v7.vstop();
);
function v_idle(i) (
  i == 0 ? v0.ae.st == 0 : i == 1 ? v1.ae.st == 0 : i == 2 ? v2.ae.st == 0 : i == 3 ? v3.ae.st == 0 :
  i == 4 ? v4.ae.st == 0 : i == 5 ? v5.ae.st == 0 : i == 6 ? v6.ae.st == 0 : v7.ae.st == 0;
);

function all_off() local(i) (
  i = 0; loop(NV, VG[i] ? v_stop(i); VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; );
  hcount = 0;
);
function all_kill() local(i) (
  v0.vkill(); v1.vkill(); v2.vkill(); v3.vkill(); v4.vkill(); v5.vkill(); v6.vkill(); v7.vkill();
  i = 0; loop(NV, VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; );
  hcount = 0;
);
function poly_on(n, v) local(i, best, ba) (
  best = -1;
  i = 0; loop(NV, VN[i] == n ? best = i; i += 1; );
  best < 0 ? ( ba = -1; i = 0; loop(NV, v_idle(i) && (best < 0 || VT[i] < ba) ? ( best = i; ba = VT[i]; ); i += 1; ); );
  best < 0 ? ( ba = -1; i = 0; loop(NV, !VG[i] && (best < 0 || VT[i] < ba) ? ( best = i; ba = VT[i]; ); i += 1; ); );
  best < 0 ? ( ba = -1; i = 0; loop(NV, best < 0 || VT[i] < ba ? ( best = i; ba = VT[i]; ); i += 1; ); );
  vage += 1; VT[best] = vage; VN[best] = n; VG[best] = 1; VS[best] = 0;
  v_start(best, n, v, 1);
);
function poly_off(n) local(i) (
  i = 0; loop(NV, VN[i] == n && VG[i] ? ( pedal ? VS[i] = 1 : ( v_stop(i); VG[i] = 0; ); ); i += 1; );
);
function mono_on(n, v) local(i, f, legato) (
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  legato ? ( v0.vglide(n); v0.vstart(n, v, 0); ) : v0.vstart(n, v, 1);
  VN[0] = n; VG[0] = 1; VS[0] = 0;
);
function mono_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? v0.vglide(HN[hcount - 1]) : ( pedal ? VS[0] = 1 : ( v0.vstop(); VG[0] = 0; ); );
  );
);
function note_on(n, v) ( vmode ? mono_on(n, v) : poly_on(n, v); );
function note_off(n) ( vmode ? mono_off(n) : poly_off(n); );
function pedal_up() local(i) ( i = 0; loop(NV, VS[i] ? ( v_stop(i); VG[i] = 0; VS[i] = 0; ); i += 1; ); );

function q_push(ofs, t, n, v) local(i) (
  qcount < 300 ? (
    i = qcount; while (i > 0 && EQO[i - 1] > ofs) ( EQO[i] = EQO[i - 1]; EQT[i] = EQT[i - 1]; EQN[i] = EQN[i - 1]; EQV[i] = EQV[i - 1]; i -= 1; );
    EQO[i] = ofs; EQT[i] = t; EQN[i] = n; EQV[i] = v; qcount += 1;
  );
);

function update() (
  w1 = p_w1; w2 = p_w2;
  o2_ratio = 2 ^ ((p_crs + p_fin / 100) / 12);
  mix = p_mix / 100; pw = p_pw / 100;
  res = p_res / 100 * 0.95; envamt = p_env / 100; keytr = p_ktr / 100;
  fl_lc = log(max(p_cut, 20));
  lfo_rate = max(p_lfr, 0.01); lfo_shape = p_lfs; vib = p_vib; lfo_pwm = p_lpw / 100; lfo_cut = p_lct / 100;
  glide_c = p_gld > 0 ? vo_coef(p_gld) : 1;
  vmode = p_vm; velsens = p_vel / 100; drift = sqr(p_drf / 100); chan = p_ch;
  vol_t = 10 ^ (p_vol / 20); ptr_t = p_trm;
  ins_output_setup(37); ins_stereo_setup(43);
);
function env_update() local(fa, fd, fr) (
  fa = min(max(p_att * p_fra, 0.5), 3000);
  fd = min(max(p_dec * p_frd, 5), 5000);
  fr = min(max(p_rel * p_frr, 5), 5000);
  v0.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v0.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
  v1.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v1.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
  v2.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v2.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
  v3.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v3.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
  v4.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v4.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
  v5.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v5.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
  v6.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v6.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
  v7.fe.vo_adsr_set(fa, fd, p_fsu / 100, fr); v7.ae.vo_adsr_set(p_att, p_dec, p_asu / 100, p_rel);
);

function pv(i, v) ( slider(i) = v; );
function sp(a, b, c, d, e, f) ( pv(1, a); pv(2, b); pv(3, c); pv(4, d); pv(5, e); pv(6, f); );
function sf(a, b, c, d, e, f, g, h) ( pv(7, a); pv(8, b); pv(9, c); pv(10, d); pv(11, e); pv(12, f); pv(13, g); pv(14, h); );
function sa(a, b, c, d) ( pv(15, a); pv(16, b); pv(17, c); pv(18, d); );
function sl(a, b, c, d, e, f, g, t) ( pv(19, a); pv(20, b); pv(21, c); pv(22, d); pv(23, e); pv(24, f); pv(25, g); pv(42, t); );
function load_preset(k) local(p, i) (
  p = k - 1;
  p == 0  ? ( sp(0, 0, 0, 8, 50, 50);    sf(2200, 25, 45, 50, 0.667, 1.75, 35, 1.2);   sa(3, 200, 90, 250);   sl(5.2, 1, 6, 0, 0, 0, 1, 0.923); ) :
  p == 1  ? ( sp(0, 0, 0, 10, 50, 50);   sf(900, 15, 60, 40, 2, 1.25, 40, 1);          sa(30, 400, 85, 400);  sl(5, 1, 0, 0, 0, 0, 0, 0.881); ) :
  p == 2  ? ( sp(0, 0, -12, 6, 45, 50);  sf(1400, 35, 50, 40, 0.5, 1, 25, 1.333);      sa(2, 300, 85, 150);   sl(5, 1, 0, 0, 0, 60, 1, 1.072); ) :
  p == 3  ? ( sp(1, 1, 12, 4, 35, 50);   sf(3500, 10, 20, 60, 0.5, 2, 60, 1.2);        sa(4, 200, 90, 250);   sl(5.5, 0, 12, 0, 0, 30, 1, 0.437); ) :
  p == 4  ? ( sp(1, 1, 0, 9, 50, 40);    sf(3000, 5, 15, 30, 0.75, 1, 70, 1);          sa(400, 600, 90, 900); sl(0.8, 0, 0, 40, 0, 0, 0, 0.519); ) :
  p == 5  ? ( sp(1, 1, 12, 0, 20, 14);   sf(5000, 45, 10, 70, 0.08, 1.5, 50, 1);       sa(25, 200, 85, 300);  sl(5, 0, 10, 0, 0, 20, 1, 0.708); ) :
  p == 6  ? ( sp(0, 0, 7, 4, 45, 50);    sf(2600, 25, 35, 50, 0.5, 1.333, 40, 1.2);    sa(2, 300, 85, 250);   sl(5, 1, 0, 0, 0, 40, 1, 0.933); ) :
  p == 7  ? ( sp(0, 1, 0, 6, 40, 35);    sf(1800, 10, 35, 50, 0.5, 0.75, 20, 0.8);     sa(2, 800, 50, 500);   sl(5, 1, 0, 0, 0, 0, 0, 0.724); ) :
  p == 8  ? ( sp(0, 0, 0, 5, 30, 50);    sf(500, 70, 70, 50, 1, 0.833, 0, 1);          sa(1, 300, 80, 200);   sl(5, 1, 0, 0, 0, 0, 1, 0.966); ) :
  p == 9  ? ( sp(0, 0, 0, 18, 50, 50);   sf(2600, 15, 25, 40, 0.5, 1.667, 50, 0.833);  sa(10, 300, 90, 600);  sl(4.5, 0, 4, 0, 0, 0, 0, 0.881); ) :
  p == 10 ? ( sp(0, 0, -12, 3, 40, 50);  sf(900, 40, 20, 40, 0.5, 1, 40, 1);           sa(2, 300, 90, 200);   sl(4, 0, 0, 0, 35, 20, 1, 1.023); ) :
            ( sp(0, 0, 0, 7, 50, 50);    sf(2500, 20, 40, 50, 1, 1.333, 30, 1.2);      sa(2, 300, 80, 250);   sl(5, 1, 0, 0, 0, 0, 0, 0.955); );
  i = 1; loop(25, slider_automate(2 ^ (i - 1)); i += 1; ); slider_automate(2 ^ 41);
  panic_req = 1;
);

function prs_sl() ( update(); env_update(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(44, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl(); all_kill(); panic_req = 0;
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

NWV = 53000;
v0.vinit(-0.30); v1.vinit(0.30); v2.vinit(-0.15); v3.vinit(0.15);
v4.vinit(-0.22); v5.vinit(0.22); v6.vinit(-0.07); v7.vinit(0.07);
ins_drift_init();
fl_ok = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
sm = 1 - exp(-1 / (0.03 * srate));
pwr_init();  pwr_sag = 0.15;  pwr_wu_loss = 0.8;  pwr_wu_drv = 1.5;  pwr_wu_lp = 7000;  pwr_wu_wob = 0.25;  pwr_bloom = 0.15;
wu_t = 1;
bend = 1; modw = 0; pedal = 0; hcount = 0; vage = 0; last_vm = -1; qcount = 0;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0; rs_f = 1;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
update(); env_update();
last_vm = vmode;
vol_s = vol_t; ptr_s = ptr_t;
all_kill();
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();

@block
prs_chk();
prs_sl();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? (
  all_kill(); qcount = 0; rs_f = 0; rs_c = 1 / (0.015 * srate);
  ostL.ost_ch_init(); ostR.ost_ch_init(); ins_sc1 = ins_sc2 = 0;
);
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pwr_block(1);
wu_t = 2 ^ (-(1 - pwr_gm) * (4 + 1.5 * pwr_w1) / 1200);
fl_k = 1 - exp(-1 / (0.015 * srate));
!fl_ok ? ( fl_c1 = fl_c2 = fl_lc; fl_rs = res; fl_ev = envamt; fl_ok = 1; );

qcount = 0;
while (midirecv(mofs, m1, m2, m3)) (
  midisend(mofs, m1, m2, m3);
  ins_chan_ok(m1, chan) ? (
    st = m1 & 0xF0;
    st == 0x90 && m3 > 0 ? ins_midi_hit();
    st == 0x90 || st == 0x80 ? q_push(mofs, st == 0x90 && m3 > 0, m2, m3) :
    st == 0xE0 ? bend = ins_bend(m2, m3, 2) :
    st == 0xB0 ? (
      m2 == 1 ? modw = m3 / 127 :
      m2 == 64 ? ( pedal = m3 >= 64; !pedal ? q_push(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? q_push(mofs, 3, 0, 0);
    );
  );
);
au_pst = play_state == 1 || play_state == 5;
au_pst_prev && !au_pst ? q_push(0, 3, 0, 0);
au_pst_prev = au_pst;
vmode != last_vm ? ( q_push(0, 3, 0, 0); last_vm = vmode; );
panic_dirty ? ( panic_dirty = 0; panic_req = 1; pedal = 0; );
panic_req ? ( all_off(); panic_req = 0; );
eqi = 0; spos = 0;

ins_drift_block(drift, samplesblock);
dvi = 0.35 * samplesblock / srate;
v0.vblock(dvi); v1.vblock(dvi); v2.vblock(dvi); v3.vblock(dvi);
v4.vblock(dvi); v5.vblock(dvi); v6.vblock(dvi); v7.vblock(dvi);
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (eqi < qcount && (EQO[eqi] <= spos || spos >= samplesblock - 1)) (
  et = EQT[eqi];
  et == 1 ? note_on(EQN[eqi], EQV[eqi]) : et == 0 ? note_off(EQN[eqi]) : et == 2 ? pedal_up() : all_off();
  eqi += 1;
);
spos += 1;

lfo = lfo1.vo_lfo(lfo_rate, lfo_shape);
vib_st = lfo * (vib + modw * 50) / 100;

fl_c1 += (fl_lc - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (res - fl_rs) * fl_k; fl_ev += (envamt - fl_ev) * fl_k;
y0 = v0.vrun(); y1 = v1.vrun(); y2 = v2.vrun(); y3 = v3.vrun();
y4 = v4.vrun(); y5 = v5.vrun(); y6 = v6.vrun(); y7 = v7.vrun();
pan0 = vmode ? 0 : v0.pan;
oL = y0 * (1 - max(pan0, 0)) + y1 * (1 - max(v1.pan, 0)) + y2 * (1 - max(v2.pan, 0)) + y3 * (1 - max(v3.pan, 0))
   + y4 * (1 - max(v4.pan, 0)) + y5 * (1 - max(v5.pan, 0)) + y6 * (1 - max(v6.pan, 0)) + y7 * (1 - max(v7.pan, 0));
oR = y0 * (1 + min(pan0, 0)) + y1 * (1 + min(v1.pan, 0)) + y2 * (1 + min(v2.pan, 0)) + y3 * (1 + min(v3.pan, 0))
   + y4 * (1 + min(v4.pan, 0)) + y5 * (1 + min(v5.pan, 0)) + y6 * (1 + min(v6.pan, 0)) + y7 * (1 + min(v7.pan, 0));

vol_s += (vol_t - vol_s) * sm;
ptr_s += (ptr_t - ptr_s) * sm;
pwr_in(oL * 0.75 * ptr_s, oR * 0.75 * ptr_s);
oL = ostL.ost_band(pwr_l);
oR = ostR.ost_band(pwr_r);
pwr_out(oL, oR);
ins_stereo(pwr_l * vol_s, pwr_r * vol_s); ost_out(ins_sl, ins_sr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); spl0 *= rs_f * rs_f * (3 - 2 * rs_f); spl1 *= rs_f * rs_f * (3 - 2 * rs_f); );
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
