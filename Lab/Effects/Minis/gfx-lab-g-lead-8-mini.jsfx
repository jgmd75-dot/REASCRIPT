  idx == 7 ? ( v >= 1000 ? sprintf(#l8v, "%.1f kHz", v / 1000) : sprintf(#l8v, "%d Hz", m); ) :
  idx == 9 ? sprintf(#l8v, "%+d %%", m) :
  idx == 15 ? ( v < 10 ? sprintf(#l8v, "%.1f ms", v) : v < 1000 ? sprintf(#l8v, "%d ms", m) : sprintf(#l8v, "%.2f s", v / 1000); ) :
  idx == 16 || idx == 18 ? ( v < 1000 ? sprintf(#l8v, "%d ms", m) : sprintf(#l8v, "%.2f s", v / 1000); ) :
  idx == 24 ? ( m < 1 ? strcpy(#l8v, "OFF") : sprintf(#l8v, "%d ms", m); ) :
