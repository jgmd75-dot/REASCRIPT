function l8_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function l8_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function l8_val(idx) local(v, m) (
  v = slider(idx); m = floor(v + 0.5);
  idx == 3 ? sprintf(#l8v, "%+d st", m) :
  idx == 4 ? sprintf(#l8v, "%+.1f c", v) :
  idx == 5 ? ( m < 1 ? strcpy(#l8v, "OSC 1") : m > 99 ? strcpy(#l8v, "OSC 2") : sprintf(#l8v, "%d %%", m); ) :
  idx == 6 ? sprintf(#l8v, "%d %%", m) :
