  pressed && hov && drag_id == 0 ? (
    (time_precise() - l8k_lt < 0.35 && l8k_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; l8k_lt = 0; ) : (
