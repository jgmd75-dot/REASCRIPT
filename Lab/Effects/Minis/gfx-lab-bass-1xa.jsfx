desc:Bass 1Xa [bass synth] (GFX Lab)
//tags: instrument synth bass mono acid reese fm sync mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-voice, gfx-lab-warmup, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-os, gfx-lab-power, gfx-lab-sliders, gfx-lab-thick (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-thick.jsfx-inc

slider56:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,3,1{Saw,Pulse,Sine,Triangle}>-Osc 1 wave
slider2:50<5,95,1>-Pulse width (%)
slider3:0<0,100,1>-Sub level (%)
slider4:0<0,1,1{-1 oct,-2 oct}>-Sub octave
slider5:0<0,100,1>-Osc 2 level (%)
slider6:0<0,50,0.1>-Osc 2 detune (cents)
slider7:1<0,2,1{-1 oct,0,+1 oct}>-Osc 2 octave
slider8:0<0,100,1>-Unison (%)
slider9:0<0,100,1>-Noise (%)
slider10:1<0,4,1{Ladder,Acid,12 dB,Band,Notch}>-Filter type
slider11:300<20,18000,1>-Cutoff (Hz)
slider12:80<0,100,1>-Resonance (%)
slider13:70<0,100,1>-Env amount (%)
slider14:30<0,100,1>-Key track (%)
slider15:1<0.5,3000,0.1>-Filter attack (ms)
slider16:250<5,5000,1>-Filter decay (ms)
slider17:0<0,100,1>-Filter sustain (%)
slider18:150<5,5000,1>-Filter release (ms)
slider19:1<0.5,3000,0.1>-Amp attack (ms)
slider20:400<5,5000,1>-Amp decay (ms)
slider21:70<0,100,1>-Amp sustain (%)
slider22:40<5,5000,1>-Amp release (ms)
slider23:70<0,100,1>-Accent (%)
slider24:60<0,1000,1>-Glide (ms)
slider25:1<0,1,1{Always,Legato}>-Glide mode
slider26:40<0,100,1>-Velocity (%)
slider27:4<0.01,20,0.01>-LFO rate (Hz)
slider28:0<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO shape
slider29:0<0,100,1>-LFO to pitch (cents)
slider30:0<0,100,1>-LFO to cutoff (%)
slider31:0<0,100,1>-LFO to PWM (%)
slider32:25<0,100,1>-Drift (%)
slider33:15<0,100,1>-Drive (%)
slider34:-4.9<-24,6,0.1>-Volume (dB)
slider35:0<0,2,1{1x,2x,4x}>-Oversampling
slider36:0<0,100,1>-Band sat (%)
slider37:30<0,100,1>-Bias (%)
slider38:120<40,400,1>-Sat low band (Hz)
slider39:6000<2000,16000,10>-Sat high band (Hz)
slider40:-0.3<-24,0,0.1>-Ceiling (dB)
slider41:0<0,100,1>-Width (%)
slider45:0<0,2,1{Mix,Sync,FM}>-Osc 2 mode
slider46:7<0,24,0.1>-Sync pitch (st)
slider47:0<0,100,1>-FM amount (%)
slider48:1<0,4,1{x0.5,x1,x2,x3,x4}>-FM ratio
slider49:0<0,100,1>-Filter FM (%)
slider50:0<0,3,1{Off,1x15,4x10,2x12}>-Cabinet
slider51:50<0,100,1>-Cabinet tone (%)
slider52:0<-40,0,0.1>-Comp threshold (dB)
slider53:0<0,10,0.1>-Ffat
slider54:0<0,100,1>-Chorus (%)
slider57:0<-2,2,1>-Octave
slider58:0<0,1,1{Off,On}>-Osc 2 thick
slider55:prs_sel=0<0,36,1{No preset,Acid: Mono Acid,Acid: Zap Bass,Acid: Sync Squelch,Acid: Square Acid,Acid: Notch Acid,Sub: Mono Sub,Sub: Sine Sub,Sub: Triangle Sub,Sub: Deep Octaves,Sub: Thick Sub,Reese: Wide Reese,Reese: Wide Growl,Reese: Chorus Reese,Reese: Dark Reese,Pluck: Ladder Pluck,Pluck: Finger Pluck,Pluck: Pick Bass,Pluck: Band Pluck,Pluck: Short Stab,FM: Glass Bass,FM: Wood Bass,FM: Digital Slap,FM: Bell Sub,FM: Metal FM,Growl: Wobble,Growl: Sync Growl,Growl: Filter FM Growl,Growl: Notch Wobble,Synth Pop: Synth Pop,Synth Pop: Mono PWM,Synth Pop: Ladder Fat,Synth Pop: Chorus Pulse,Dub: Ladder Glide,Dub: Dub Sine,Dub: Steppers,Dub: Round Bass}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-bass-1xa";
bx_ed = 0; bx_tb = 0;
ext_noinit = 1;
NW = 1200;
HN = 1000; hcount = 0;
SN = 1300;
memset(HN, 0, 128); memset(SN, 0, 128);
sustain = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
ins_drift_init();
fl_ok = 0;
bend = 1; nd_mul = 1; cur = 48; tgt = 48; vel = 0.8; acc = 0; gate = 0;
fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0);
sm = vo_coef(30);
fd_in = 1; fd_st = 1 / (0.002 * srate);
vg_k = 1 - exp(-1 / (0.004 * srate));
vg_s = 1; ac_s = 0;
dxp = dyp = 0;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
pn_dirty = 0;

os_design(); os_base = 0; os_f = os_tf = os_f2n(slider35);
os_gsetup();

thk_init(); thk_lift = 5; thk_drv = 1.8; thk_asym = 0.2; thk_tr = 1; thk_trim = 0;
CB = 60000; CBN = 4096; memset(CB, 0, CBN); cb_p = 0;
pwr_init(); pwr_hum_db = -78; pwr_sag = 0.2; pwr_rip = 0.003;
pwr_wu_loss = 0.6; pwr_wu_drv = 0.8; pwr_wu_lp = 9000; pwr_wu_wob = 0.2; pwr_bloom = 0;

function pv(i, v) ( slider(i) = v; );
function setosc(w, pw, sb, so, o2, dt, o2o, un, nz) (
  pv(1, w); pv(2, pw); pv(3, sb); pv(4, so); pv(5, o2); pv(6, dt); pv(7, o2o); pv(8, un); pv(9, nz);
);
function setflt(t, c, r, e, k) ( pv(10, t); pv(11, c); pv(12, r); pv(13, e); pv(14, k); );
function setfenv(a, d, s, r) ( pv(15, a); pv(16, d); pv(17, s); pv(18, r); );
function setaenv(a, d, s, r) ( pv(19, a); pv(20, d); pv(21, s); pv(22, r); );
function setperf(ac, gl, gm, vl) ( pv(23, ac); pv(24, gl); pv(25, gm); pv(26, vl); );
function setlfo(rt, sh, lp, lc, lw) ( pv(27, rt); pv(28, sh); pv(29, lp); pv(30, lc); pv(31, lw); );
function sl_list() local(i) ( i = 1; loop(52, slider_automate(2 ^ (i - 1)); i += 1; ); slider_automate(slider53); slider_automate(slider54); slider_automate(slider57); slider_automate(slider58); );
function setx(om, sy, fm, ra, ff, cy, tn, cp, fa, ch, oc, th, wd, dr, vl) (
  pv(45, om); pv(46, sy); pv(47, fm); pv(48, ra); pv(49, ff); pv(50, cy); pv(51, tn); pv(52, cp); pv(53, fa); pv(54, ch);
  slider57 = oc; slider58 = th; pv(41, wd); pv(33, dr); pv(34, vl);
);
function load_preset(n) local(p) (
  p = n - 1;
  pv(32, 25); pv(36, 0); pv(37, 30); pv(38, 120); pv(39, 6000); pv(40, -0.3);
  p == 0 ? ( setosc(0,50,0,0,0,0,1,0,0); setflt(1,300,80,70,30); setfenv(1,250,0,150); setaenv(1,400,70,40); setperf(70,60,1,40); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-5.9); ) :
  p == 1 ? ( setosc(0,50,30,0,0,0,1,0,0); setflt(1,200,60,100,30); setfenv(1,90,0,60); setaenv(1,250,50,60); setperf(40,0,0,50); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-2.7); ) :
  p == 2 ? ( setosc(0,50,20,0,60,0,1,0,0); setflt(1,350,75,65,30); setfenv(1,220,0,120); setaenv(1,350,70,40); setperf(70,60,1,40); setlfo(4,0,0,0,0); setx(1,9,0,1,0,0,50,0,0,0,0,0,0,30,-7.7); ) :
  p == 3 ? ( setosc(1,50,0,0,0,0,1,0,0); setflt(1,280,82,75,30); setfenv(1,180,0,100); setaenv(1,300,65,40); setperf(80,70,1,40); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,40,-9.3); ) :
  p == 4 ? ( setosc(0,50,25,0,0,0,1,0,0); setflt(4,450,70,65,30); setfenv(1,260,0,120); setaenv(1,350,70,50); setperf(60,50,1,40); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,25,-6.1); ) :
  p == 5 ? ( setosc(1,40,70,0,0,0,1,0,0); setflt(1,600,20,30,40); setfenv(1,300,20,100); setaenv(1,500,80,60); setperf(30,0,1,30); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-10.0); ) :
  p == 6 ? ( setosc(1,50,75,0,0,0,1,0,0); setflt(2,250,0,0,0); setfenv(1,100,100,100); setaenv(3,200,100,80); setperf(0,0,1,20); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-11.3); ) :
  p == 7 ? ( setosc(3,50,40,0,0,0,1,0,0); setflt(2,900,0,0,20); setfenv(1,100,100,100); setaenv(3,200,100,80); setperf(0,0,1,25); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-9.7); ) :
  p == 8 ? ( setosc(2,50,60,1,0,0,1,0,0); setflt(2,700,0,0,10); setfenv(1,100,100,100); setaenv(4,300,100,120); setperf(0,30,1,20); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,1,0,15,-10.6); ) :
  p == 9 ? ( setosc(0,50,40,0,80,4,1,0,0); setflt(0,180,20,20,30); setfenv(2,300,30,120); setaenv(2,500,90,120); setperf(10,0,1,30); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,-15,0,0,0,1,0,15,-7.0); ) :
  p == 10 ? ( setosc(0,50,25,0,60,22,1,60,0); setflt(2,700,25,15,20); setfenv(10,800,60,300); setaenv(5,800,100,250); setperf(10,20,1,30); setlfo(0.3,0,0,15,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,50,15,-10.4); ) :
  p == 11 ? ( setosc(0,50,20,0,70,15,1,50,5); setflt(0,400,55,40,30); setfenv(5,300,20,200); setaenv(2,500,90,150); setperf(20,10,1,40); setlfo(3,1,0,40,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,40,15,-6.5); ) :
  p == 12 ? ( setosc(0,50,20,0,80,18,1,0,0); setflt(0,600,30,25,30); setfenv(5,500,40,200); setaenv(3,600,100,200); setperf(10,20,1,30); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,70,0,0,30,15,-6.2); ) :
  p == 13 ? ( setosc(0,50,30,0,70,12,1,70,0); setflt(0,350,35,30,30); setfenv(5,500,40,200); setaenv(3,600,100,200); setperf(10,20,1,30); setlfo(0.2,0,0,10,0); setx(0,7,0,1,0,1,40,0,4,0,0,0,0,15,-8.5); ) :
  p == 14 ? ( setosc(0,50,40,0,80,5,1,0,0); setflt(0,300,40,75,40); setfenv(1,220,0,120); setaenv(1,500,0,150); setperf(30,0,0,50); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-1.3); ) :
  p == 15 ? ( setosc(3,50,30,0,50,3,1,0,0); setflt(0,400,25,60,40); setfenv(1,180,0,120); setaenv(1,450,0,120); setperf(30,0,0,60); setlfo(4,0,0,0,0); setx(0,7,0,1,0,2,50,-15,0,0,0,0,0,15,-1.2); ) :
  p == 16 ? ( setosc(0,50,20,0,0,0,1,0,0); setflt(0,700,20,50,40); setfenv(1,120,10,100); setaenv(1,600,30,100); setperf(40,0,0,60); setlfo(4,0,0,0,0); setx(0,7,0,1,0,2,70,-20,0,0,0,0,0,25,-6.7); ) :
  p == 17 ? ( setosc(0,50,40,0,0,0,1,0,0); setflt(3,600,50,70,40); setfenv(1,150,0,100); setaenv(1,400,0,120); setperf(40,0,0,60); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-1.3); ) :
  p == 18 ? ( setosc(1,30,30,0,0,0,1,0,0); setflt(0,500,40,80,40); setfenv(1,90,0,60); setaenv(1,150,0,60); setperf(50,0,0,60); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,30,3.5); ) :
  p == 19 ? ( setosc(2,50,20,0,70,0,1,0,0); setflt(2,3000,0,20,30); setfenv(1,500,30,150); setaenv(1,700,40,150); setperf(20,0,1,50); setlfo(4,0,0,0,0); setx(2,7,45,1,0,0,50,0,0,0,0,0,0,15,-7.2); ) :
  p == 20 ? ( setosc(2,50,20,0,70,0,1,0,0); setflt(2,1800,0,30,30); setfenv(1,300,20,120); setaenv(1,500,20,120); setperf(30,0,0,60); setlfo(4,0,0,0,0); setx(2,7,30,2,0,1,50,0,0,0,0,0,0,15,-7.9); ) :
  p == 21 ? ( setosc(2,50,10,0,80,0,1,0,0); setflt(2,2500,10,60,30); setfenv(1,150,10,100); setaenv(1,400,30,100); setperf(50,0,0,60); setlfo(4,0,0,0,0); setx(2,7,70,3,0,0,50,0,0,0,0,0,0,15,-5.8); ) :
  p == 22 ? ( setosc(2,50,50,0,50,0,1,0,0); setflt(2,4000,0,0,20); setfenv(1,300,50,200); setaenv(2,900,60,250); setperf(10,0,1,40); setlfo(4,0,0,0,0); setx(2,7,25,4,0,0,50,0,0,0,0,0,0,15,-8.8); ) :
  p == 23 ? ( setosc(0,50,20,0,70,0,1,0,0); setflt(1,700,40,40,30); setfenv(1,300,20,150); setaenv(1,500,70,100); setperf(40,30,1,40); setlfo(4,0,0,0,0); setx(2,7,80,0,30,0,50,0,0,0,0,0,0,40,-6.6); ) :
  p == 24 ? ( setosc(0,50,30,0,80,10,1,30,0); setflt(0,500,50,20,30); setfenv(10,500,50,300); setaenv(2,500,100,200); setperf(10,30,1,30); setlfo(3,0,0,70,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-8.3); ) :
  p == 25 ? ( setosc(0,50,25,0,80,0,1,0,0); setflt(0,600,45,40,30); setfenv(5,400,40,200); setaenv(2,500,100,150); setperf(20,30,1,40); setlfo(4,0,0,0,0); setx(1,14,0,1,50,0,50,0,0,0,0,0,0,50,-5.9); ) :
  p == 26 ? ( setosc(0,50,30,0,40,8,1,0,0); setflt(0,500,40,30,30); setfenv(5,400,40,200); setaenv(2,500,100,150); setperf(20,20,1,40); setlfo(4,0,0,0,0); setx(0,7,0,1,70,3,50,0,4,0,0,0,0,45,-5.4); ) :
  p == 27 ? ( setosc(0,50,30,0,70,12,1,0,0); setflt(4,700,60,10,30); setfenv(5,500,50,200); setaenv(2,500,100,150); setperf(10,30,1,30); setlfo(2,0,0,60,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,30,-8.9); ) :
  p == 28 ? ( setosc(1,30,30,0,60,7,1,0,0); setflt(1,1500,30,40,50); setfenv(1,300,20,150); setaenv(1,400,60,100); setperf(30,0,0,40); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-8.0); ) :
  p == 29 ? ( setosc(1,50,40,0,0,0,1,0,0); setflt(1,900,30,30,40); setfenv(5,400,30,150); setaenv(2,600,80,120); setperf(20,40,1,30); setlfo(0.8,1,0,0,45); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-8.8); ) :
  p == 30 ? ( setosc(0,50,30,0,80,8,1,0,0); setflt(0,500,30,45,30); setfenv(2,500,30,200); setaenv(2,600,90,150); setperf(20,30,1,40); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-6.1); ) :
