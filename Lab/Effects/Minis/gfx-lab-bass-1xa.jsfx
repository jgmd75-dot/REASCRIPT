  p == 32 ? ( setosc(0,50,0,0,90,12,2,0,0); setflt(0,1200,35,40,40); setfenv(5,700,40,200); setaenv(2,800,90,200); setperf(20,90,1,30); setlfo(5,0,8,0,0); setx(0,7,0,1,0,0,50,0,0,0,0,0,0,15,-5.6); ) :
  p == 33 ? ( setosc(2,50,40,0,0,0,1,0,0); setflt(2,400,0,0,10); setfenv(1,100,100,100); setaenv(5,800,90,250); setperf(0,40,1,20); setlfo(4,0,0,0,0); setx(0,7,0,1,0,0,50,0,3,0,0,1,0,15,-9.6); ) :
  p == 34 ? ( setosc(3,50,30,0,0,0,1,0,0); setflt(0,300,20,30,30); setfenv(1,250,30,150); setaenv(2,500,80,150); setperf(20,0,1,40); setlfo(4,0,0,0,0); setx(0,7,0,1,0,1,30,-18,0,0,0,0,0,15,-7.6); ) :
  p == 35 ? ( setosc(0,50,30,0,60,6,1,0,0); setflt(0,250,20,20,30); setfenv(2,400,40,200); setaenv(3,600,90,200); setperf(10,20,1,30); setlfo(4,0,0,0,0); setx(0,7,0,1,0,1,40,0,5,0,0,1,0,15,-7.4); );
  sl_list();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(54, h += slider(i) * (1 + i * 0.7071); i += 1; ); h += slider57 * 41.3 + slider58 * 43.1; h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(36, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

function all_off() (
  hcount = 0; memset(SN, 0, 128);
  fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0); gate = 0;
);
function note_on(n, v) local(i, f, legato) (
  SN[n] = 0;
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  tgt = n; vel = v / 127;
  !legato ? nd_mul = ins_note_detune();
  acc = accent * max(vel - 0.5, 0) * 2;
  glide_on = glide_ms > 0 && (glide_mode == 0 || legato);
  !glide_on ? cur = n;
  fenv.vo_adsr_gate(1, !legato); aenv.vo_adsr_gate(1, !legato);
  !legato ? ( fd_a0 = amp_l; fd_in = 0; );
  !legato && aenv.lv < 0.05 ? ( o1.vo_reset(0); sub.vo_reset(0); o2.vo_reset(0); u1.vo_reset(0); u2.vo_reset(0); nw_start(NW); );
  aenv.lv < 0.001 ? ( vg_s = 1 - velsens + velsens * vel; ac_s = acc; );
  gate = 1;
);
function note_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? ( tgt = HN[hcount - 1]; glide_on = glide_ms > 0; !glide_on ? cur = tgt; ) :
             ( fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0); gate = 0; );
  ) : hcount == 0 ? ( fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0); gate = 0; );
);
function key_up(n) ( sustain ? SN[n] = 1 : note_off(n); );
function pedal_up() local(n) (
  n = 0; loop(128, SN[n] ? ( SN[n] = 0; note_off(n); ); n += 1; );
);

function bq_set(t, f, q, gdb) local(w, cs, sw, al, a, a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cs = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? ( a0 = 1 + al; bq_b0 = (1 - cs) * 0.5 / a0; bq_b1 = (1 - cs) / a0; bq_b2 = bq_b0; bq_a1 = -2 * cs / a0; bq_a2 = (1 - al) / a0; ) :
  t == 1 ? ( a0 = 1 + al; bq_b0 = (1 + cs) * 0.5 / a0; bq_b1 = -(1 + cs) / a0; bq_b2 = bq_b0; bq_a1 = -2 * cs / a0; bq_a2 = (1 - al) / a0; ) : (
    a = 10 ^ (gdb / 40); a0 = 1 + al / a;
    bq_b0 = (1 + al * a) / a0; bq_b1 = -2 * cs / a0; bq_b2 = (1 - al * a) / a0; bq_a1 = -2 * cs / a0; bq_a2 = (1 - al / a) / a0;
  );
);
function bq_take() instance(b0, b1, b2, a1, a2) ( b0 = bq_b0; b1 = bq_b1; b2 = bq_b2; a1 = bq_a1; a2 = bq_a2; );
function bq_run(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );
function cb_clr() ( cbH.bq_clr(); cbB.bq_clr(); cbL1.bq_clr(); cbL2.bq_clr(); );
function cab_set() local(t, hf, hq, bf, bg, bqq, lf, k) (
  t = cab_c; k = 2 ^ ((cab_tn - 0.5) * 2);
  t == 1 ? ( hf = 45; hq = 1.1; bf = 120; bg = 3; bqq = 0.8; lf = 2200; ) :
  t == 2 ? ( hf = 70; hq = 0.9; bf = 800; bg = 3; bqq = 1.0; lf = 4500; ) :
           ( hf = 60; hq = 0.8; bf = 1600; bg = 2.5; bqq = 1.2; lf = 3500; );
  bq_set(1, hf, hq, 0); cbH.bq_take();
  bq_set(2, bf, bqq, bg); cbB.bq_take();
  bq_set(0, lf * k, 0.7, 0); cbL1.bq_take();
  bq_set(0, lf * k * 1.3, 1.1, 0); cbL2.bq_take();
);
function bx_svf(x, fc, res, md) instance(ic1, ic2) local(g, k, a1, a2, a3, v1, v2, v3) (
  g = tan($pi * min(fc, srate * 0.45) / srate);
  k = 2 - 1.95 * res;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  vo_tanh(md == 3 ? 3 * k * v1 : x - k * v1);
);
function update() (
  wave_t = floor(slider1 + 0.5); o2m_t = floor(slider45 + 0.5); sync_t = slider46; fm_t = slider47 / 100 * 5;
  fm_r = slider48 < 0.5 ? 0.5 : floor(slider48 + 0.5) - (slider48 >= 1.5 ? 0 : 0);
  fm_r = slider48 < 0.5 ? 0.5 : slider48 < 1.5 ? 1 : slider48 < 2.5 ? 2 : slider48 < 3.5 ? 3 : 4;
  ffm_t = slider49 / 100; oct_t = floor(slider57 + 0.5); thk_t = slider58 >= 0.5;
  cab_t = floor(slider50 + 0.5); cab_tn = slider51 / 100; cmp_t = slider52; ffat_t = slider53; ch_t = slider54 / 100; pw = slider2 / 100; sub_l = slider3 / 100; sub_div = slider4 ? 4 : 2;
  o2_l = slider5 / 100; o2_det = 2 ^ (slider6 / 1200); o2_oct = 2 ^ (slider7 - 1);
  uni = slider8 / 100; uni_l = min(uni * 4, 1) * 0.6; uni_dt = 2 ^ (uni * 30 / 1200);
  noise_l = slider9 / 100 * 0.5;
  ftype_t = floor(slider10 + 0.5); cutoff = slider11; res = slider12 / 100; envamt = slider13 / 100; keytr = slider14 / 100;
  fl_lc = log(cutoff);
  fenv.vo_adsr_set(slider15, slider16, slider17 / 100, slider18);
  aenv.vo_adsr_set(slider19, slider20, slider21 / 100, slider22);
  accent = slider23 / 100;
  glide_ms = slider24; glide_mode = slider25; glide_c = slider24 > 0 ? vo_coef(slider24) : 1;
  velsens = slider26 / 100;
  lfo_rate = slider27; lfo_shape = slider28; lfo_p = slider29; lfo_c = slider30 / 100; lfo_w = slider31 / 100;
  drift = slider32 / 100;
  drv = slider33 / 100; drv_g = 1 + 6 * drv * drv; drv_b = 0.05 * drv; drv_h = 2.5 - 1.7 * drv;
  t1 = exp(2 * (drv_g * 0.15 / drv_h + drv_b)); t2 = exp(2 * drv_b);
  drv_n = 0.15 / ((t1 - 1) / (t1 + 1) - (t2 - 1) / (t2 + 1));
  drv_z = (t2 - 1) / (t2 + 1);
  vol_t = 10 ^ (slider34 / 20);
  ins_output_setup(36);
  cab_set();
  wd_t = slider41 / 100;
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
);
function drive(x) local(e1) (
  e1 = exp(2 * min(max(drv_g * x / drv_h + drv_b, -20), 20));
  ((e1 - 1) / (e1 + 1) - drv_z) * drv_n;
);
function ch_rd(q) local(i, f, a, b) (
  q < 0 ? q += CBN; i = floor(q); f = q - i; a = CB[i % CBN]; b = CB[(i + 1) % CBN]; a + (b - a) * f;
);
function gap_clear() (
  all_off(); sustain = 0;
  aenv.st = aenv.lv = fenv.st = fenv.lv = 0;
  flt.s1 = flt.s2 = flt.s3 = flt.s4 = 0; flt.ic1 = flt.ic2 = 0;
  memset(NW, 0, 4); memset(WB, 0, WBN); wd_h1 = wd_h2 = wd_x1 = wd_x2 = 0;
  dxp = dyp = 0; cb_clr(); memset(CB, 0, CBN); cm_e = cm_g = 0; ff_g = 0; s2ph = 0; amp_l = 0; fd_in = 1;
  OSU.os_clr(); OSD.os_clr();
);
update();
vol_s = vol_t;
WB = 8000; WBN = 8192; memset(WB, 0, WBN); wd_p = 0;
wd_n = floor(0.011 * srate + 0.5); wd_hc = exp(-2 * $pi * 250 / srate); wd_s = wd_t;
s_sub = sub_l; s_o2 = o2_l; s_uni = uni_l; s_nz = noise_l; s_pw = pw;
wave_c = wave_t; ftype_c = ftype_t; o2m_c = o2m_t; dk = 1; cab_c = cab_t; cab_k = 1; cab_set(); oct_c = oct_t;
sync_s = sync_t; fm_s = fm_t; ffm_s = ffm_t; cm_ts = cmp_t; ff_s = ffat_t; ch_s = ch_t; ch_rt = 0.45;
cm_mk = 0; cm_mu = 0.45; cm_rk = 1 - exp(-1 / (0.008 * srate)); cm_ak = 1 - exp(-1 / (0.003 * srate)); cm_rl = 1 - exp(-1 / (0.12 * srate));
ff_mk = 12; ff_at = 1 - exp(-1 / (0.003 * srate)); ff_rl = 1 - exp(-1 / (0.09 * srate));
sw_k = 1 - exp(-1 / (0.01 * srate)); dk_st = 1 / (0.004 * srate);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();
os_snap(slider(35));

@block
prs_chk();
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
update();
os_tf = os_f2n(slider35);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
pwr_block(1);
fl_k = 1 - exp(-1 / (0.015 * srate));
!fl_ok ? ( fl_c1 = fl_c2 = fl_lc; fl_rs = res; fl_ev = envamt; fl_ok = 1; );
pn_dirty ? ( pn_dirty = 0; all_off(); sustain = 0; );
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? ( note_on(m2, m3); ins_midi_hit(); ) :
  st == 0x80 || (st == 0x90 && m3 == 0) ? key_up(m2) :
  st == 0xB0 && m2 == 64 ? ( sus_n = m3 >= 64; sustain && !sus_n ? ( sustain = 0; pedal_up(); ); sustain = sus_n; ) :
  st == 0xB0 && (m2 == 123 || m2 == 120) ? ( all_off(); sustain = 0; ) :
  st == 0xE0 ? bend = ins_bend(m2, m3, 2);
  midisend(mofs, m1, m2, m3);
);
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( all_off(); sustain = 0; );
gfx_pst_prev = gfx_pst;
ins_drift_block(drift, samplesblock);
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(slider(35));

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
os_gate();
os_chg ? ( OSU.os_clr(); OSD.os_clr(); );
cur += (tgt - cur) * glide_c;
s_sub += (sub_l - s_sub) * sw_k; s_o2 += (o2_l - s_o2) * sw_k; s_uni += (uni_l - s_uni) * sw_k;
s_nz += (noise_l - s_nz) * sw_k; s_pw += (pw - s_pw) * sw_k;
s_sub < 0.00001 && sub_l == 0 ? s_sub = 0; s_o2 < 0.00001 && o2_l == 0 ? s_o2 = 0;
s_uni < 0.00001 && uni_l == 0 ? s_uni = 0; s_nz < 0.00001 && noise_l == 0 ? s_nz = 0;
wave_t != wave_c || ftype_t != ftype_c || o2m_t != o2m_c ? (
  dk = max(dk - dk_st, 0);
  dk == 0 ? (
    ftype_t != ftype_c ? ( ftype_t == 2 ? ( flt.ic1 = flt.ic2 = 0; ) : ftype_c == 2 ? ( flt.s1 = flt.s2 = flt.s3 = flt.s4 = 0; ); );
    ftype_t >= 2 && ftype_c <= 1 ? ( flt.ic1 = flt.ic2 = 0; );
    o2m_t != o2m_c ? ( s2ph = 0; o2.vo_reset(0); fmc = fmm = 0; );
    wave_c = wave_t; ftype_c = ftype_t; o2m_c = o2m_t;
  );
) : dk < 1 ? dk = min(dk + dk_st, 1);
lfo = lfo1.vo_lfo(lfo_rate, lfo_shape);
oct_c = oct_t;
semi = cur + 12 * oct_c + lfo * lfo_p / 100;
f1 = 440 * 2 ^ ((semi - 69) / 12) * bend * ins_pitch * nd_mul;
inc1 = min(f1 / srate, 0.45);

o1p = o1.ph;
y1 = wave_c == 0 ? o1.vo_saw(inc1) : wave_c == 1 ? o1.vo_pulse(inc1, min(max(s_pw + lfo * lfo_w * 0.4 + ins_cut * 0.22, 0.05), 0.95)) :
     wave_c == 2 ? ( o1.ph += inc1; o1.ph -= floor(o1.ph); sin(2 * $pi * o1.ph) * 1.2; ) : ( o1.ph += inc1; o1.ph -= floor(o1.ph); (1 - 4 * abs(o1.ph - 0.5)) * 1.3; );
y = y1;
s_sub > 0 ? y += s_sub * sub.vo_sub(inc1, sub_div);
sync_s += (sync_t - sync_s) * fl_k; fm_s += (fm_t - fm_s) * fl_k; ffm_s += (ffm_t - ffm_s) * fl_k;
s_o2 > 0 ? (
  inc2 = min(inc1 * o2_oct * o2_det * 2 ^ (ins_aux / 12), 0.45);
  o2m_c == 0 ? ( y2 = o2.vo_saw(inc2); ) :
  o2m_c == 1 ? (
    inc2 = min(inc1 * o2_det * 2 ^ (sync_s / 12), 0.45);
    s2ph += inc2;
    o1.ph < o1p ? (
      s2j = s2ph - floor(s2ph); s2ph = o1.ph / max(inc1, 0.0000001) * inc2; s2j = s2j - s2ph;
      y2 = 2 * s2ph - 1 - s2j * vo_blep(s2ph, inc2);
    ) : ( s2ph -= floor(s2ph); y2 = 2 * s2ph - 1 - vo_blep(s2ph, inc2); );
  ) : (
    fmc += inc2; fmc -= floor(fmc); fmm += min(inc2 * fm_r, 0.45); fmm -= floor(fmm);
    y2 = sin(2 * $pi * fmc + fm_s * sin(2 * $pi * fmm)) * 1.2;
  );
  thk_t || thk_m > 0 ? ( thk_proc(y2 * 0.5, y2 * 0.5, thk_t); y2 = thk_l * 2; );
  y += s_o2 * y2;
);
s_uni > 0 ? ( y += s_uni * (u1.vo_saw(inc1 * uni_dt) + u2.vo_saw(inc1 / uni_dt)); );
s_nz > 0 ? y += s_nz * (rand(2) - 1);
y *= 0.35;

fl_c1 += (fl_lc - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (res - fl_rs) * fl_k; fl_ev += (envamt - fl_ev) * fl_k;
vg_s += (1 - velsens + velsens * vel - vg_s) * vg_k; ac_s += (acc - ac_s) * vg_k;
fe = fenv.vo_adsr();
oct = (fl_ev + ac_s * 0.5) * fe * 7 + keytr * (cur + 12 * oct_c - 48) / 12 + lfo * lfo_c * 3 + ins_cut + ffm_s * y1 * 2;
fc = min(max(exp(fl_c2 + oct * 0.693147), 20), srate * 0.45);
y = ftype_c == 2 ? flt.vo_svf(y, fc, fl_rs) : ftype_c >= 3 ? flt.bx_svf(y, fc, fl_rs, ftype_c) : flt.vo_ladder(y, fc, fl_rs, ftype_c);
dk < 1 ? y *= 0.5 - 0.5 * cos($pi * dk);
y = vo_tanh(y * 0.9) / 0.9;

ae = aenv.vo_adsr();
amp_g = ae * vg_s * (1 + ac_s * 0.6);
fd_in < 1 ? ( amp_g = fd_a0 + (amp_g - fd_a0) * (0.5 - 0.5 * cos($pi * fd_in)); fd_in = min(fd_in + fd_st, 1); );
amp_l = amp_g;
y *= amp_g;

y = nw_run(NW, y);

pwr_in(y, y); y = pwr_l;
os_f == 1 ? (
  drv > 0.001 ? y = drive(y);
) : (
  OSU.os_up(y);
  drv > 0.001 ? (
    d0 = drive(OSU.s0); d1 = drive(OSU.s1);
    os_f > 2 ? ( d2 = drive(OSU.s2); d3 = drive(OSU.s3); );
  ) : ( d0 = OSU.s0; d1 = OSU.s1; d2 = OSU.s2; d3 = OSU.s3; );
  y = OSD.os_dn(d0, d1, d2, d3);
);
dy = y - dxp + 0.997 * dyp; dxp = y; dyp = dy; y = dy;
cab_t != cab_c ? ( cab_k = max(cab_k - dk_st, 0); cab_k == 0 ? ( cab_c = cab_t; cab_c > 0 ? ( cab_set(); cb_clr(); ); ); ) : cab_k < 1 ? cab_k = min(cab_k + dk_st, 1);
cab_c > 0 ? ( yc = cbL2.bq_run(cbL1.bq_run(cbB.bq_run(cbH.bq_run(y)))); y += (yc - y) * (0.5 - 0.5 * cos($pi * cab_k)); ) : cab_k < 1 ? y *= 0.5 - 0.5 * cos($pi * cab_k);
cm_ts += (cmp_t - cm_ts) * fl_k;
cm_ts < -0.05 || cm_g > 0.0001 ? (
  cm_e += (y * y - cm_e) * cm_rk;
  cm_lv = 10 * log10(cm_e + 0.0000000001);
  cm_a = min(1, -cm_ts / 8); cm_sl = 0.75 * cm_a;
  cm_o = cm_lv - (-12 + cm_ts * 0.75);
  cm_t = cm_o <= -5 ? 0 : cm_o >= 5 ? cm_o * cm_sl : cm_sl * sqr(cm_o + 5) / 20;
  cm_g += (cm_t - cm_g) * (cm_t > cm_g ? cm_ak : cm_rl);
  y *= 10 ^ ((cm_mk * cm_a - cm_g - cm_ts * cm_mu) / 20);
) : ( cm_g = 0; cm_e = 0; );
ff_s += (ffat_t - ff_s) * fl_k;
fcn = ff_s / 10;
fcn > 0.001 || ff_g > 0.0001 ? (
  f_thr = -10 - 22 * fcn; f_sl = 1 - 1 / (1 + 5 * fcn); f_mk = ff_mk * fcn + 4 * fcn * fcn;
  f_db = abs(y) > 0.000001 ? 20 * log10(abs(y)) : -120;
  f_ov = f_db - f_thr;
  f_cg = f_ov <= -3 ? 0 : f_ov >= 3 ? f_ov * f_sl : f_sl * sqr(f_ov + 3) / 12;
  ff_g += (f_cg - ff_g) * (f_cg > ff_g ? ff_at : ff_rl);
  y *= 10 ^ ((f_mk - ff_g) / 20);
) : ( ff_g = 0; );
pwr_out(y, y); y = pwr_l;
os_g < 1 ? y *= os_g;

vol_s += (vol_t - vol_s) * sm;
wd_s += (wd_t - wd_s) * sw_k;
wd_s > 0.00001 || wd_t > 0 ? (
  wd_h1 = wd_hc * (wd_h1 + y - wd_x1); wd_x1 = y;
  wd_h2 = wd_hc * (wd_h2 + wd_h1 - wd_x2); wd_x2 = wd_h1;
  WB[wd_p] = wd_h2; wd_q = wd_p - wd_n; wd_q < 0 ? wd_q += WBN;
  wd_sd = WB[wd_q] * wd_s * 0.7; wd_p = (wd_p + 1) % WBN;
) : ( wd_s = 0; wd_sd = 0; );
ch_s += (ch_t - ch_s) * sw_k;
ch_s > 0.0001 || ch_t > 0 ? (
  cl_h1 = wd_hc * (cl_h1 + y - cl_x1); cl_x1 = y;
  CB[cb_p] = cl_h1;
  ch_ph += ch_rt / srate; ch_ph -= floor(ch_ph);
  chl = ch_rd(cb_p - (0.007 + 0.0025 * (1 + sin(2 * $pi * ch_ph))) * srate);
  chr = ch_rd(cb_p - (0.007 + 0.0025 * (1 + sin(2 * $pi * (ch_ph + 0.33)))) * srate);
  cb_p = (cb_p + 1) % CBN;
  ch_w = ch_s * 0.75;
) : ( ch_s = 0; ch_w = 0; chl = chr = 0; CB[cb_p] = 0; cb_p = (cb_p + 1) % CBN; );
oL = ostL.ost_band(y + wd_sd + chl * ch_w) * vol_s;
oR = ostR.ost_band(y - wd_sd + chr * ch_w) * vol_s;
ost_out(oL, oR);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
