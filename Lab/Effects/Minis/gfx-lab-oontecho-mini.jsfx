oa_i = 0.12 * dm_s * samplesblock / srate;
oa_vF = oa_dF.drift_tick(oa_i); oa_vD = oa_dD.drift_tick(oa_i * 1.3); oa_vB = oa_dB.drift_tick(oa_i * 0.8);
oa_drf = oa_vF * 0.3 * dm_a;
