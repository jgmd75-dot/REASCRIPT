  oa_play ? ( oa_t = oa_b / max(oa_lqn, 0.0001); oa_lfo_off = oa_lfph - (oa_t - floor(oa_t)); oa_lfo_off -= floor(oa_lfo_off + 0.5); );
);
oa_lqp = oa_lqn; oa_plp = oa_play; oa_lfo_in = 1;
oa_vu_d = max(oa_vu_d, sqrt(oa_ms / max(samplesblock, 1))); oa_ms = 0; oa_pk_d = max(oa_pk_d, oa_pkm); oa_pkm = 0;

@serialize
