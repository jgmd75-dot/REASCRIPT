@sample
rw_l = spl0; rw_r = spl1;
in_process(spl0, spl1);
pwr_in(in_l, in_r);
oa_dl = pwr_l; oa_dr = pwr_r;

oa_bp = oa_b; oa_b += oa_binc;
oa_pfl = floor(oa_bp / (2 * oa_dv)); oa_pp = oa_bp - oa_pfl * 2 * oa_dv;
oa_g = oa_pfl * 2 + (oa_pp >= oa_a1);
oa_g != oa_lastg ? ( oa_lastg = oa_g; oa_step = oa_g - floor(oa_g / oa_nst) * oa_nst; oa_rd(oa_step); );
oa_g1 += (oa_tg - oa_g1) * oa_gc; oa_g2 += (oa_g1 - oa_g2) * oa_gc;
