oa_p1 += (oa_tp - oa_p1) * oa_gc; oa_p2 += (oa_p1 - oa_p2) * oa_gc;
oa_xl = oa_dl * oa_g2 * (oa_p2 > 0 ? 1 - oa_p2 : 1);
oa_xr = oa_dr * oa_g2 * (oa_p2 < 0 ? 1 + oa_p2 : 1);

oa_wo += ((oa_ftype == 0) - oa_wo) * oa_fc; oa_wl += ((oa_ftype == 1) - oa_wl) * oa_fc;
oa_wb += ((oa_ftype == 2) - oa_wb) * oa_fc; oa_wh += ((oa_ftype == 3) - oa_wh) * oa_fc;
oa_lc += (log(oa_cut) - oa_lc) * oa_sm;
oa_ks += (oa_k - oa_ks) * oa_sm; oa_cps += (oa_comp - oa_cps) * oa_sm;
oa_lds += (oa_ldep - oa_lds) * oa_sm; oa_fss += (oa_fsq - oa_fss) * oa_sm; oa_acs += (oa_acco - oa_acs) * oa_sm;
oa_lfo_off *= 1 - oa_lfk;
