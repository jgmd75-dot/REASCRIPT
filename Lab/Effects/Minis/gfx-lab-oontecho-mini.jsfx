  oa_v3 = oa_xl - oa_c2L; oa_v1 = oa_fa1 * oa_c1L + oa_fa2 * oa_v3; oa_v2 = oa_c2L + oa_fa2 * oa_c1L + oa_fa3 * oa_v3;
  oa_c1L = min(max(2 * oa_v1 - oa_c1L, -8), 8); oa_c2L = min(max(2 * oa_v2 - oa_c2L, -8), 8);
  oa_yl = oa_xl * oa_wo + (oa_v2 * oa_wl + (oa_xl - oa_ks * oa_v1 - oa_v2) * oa_wh) * oa_cps + oa_ks * oa_v1 * oa_wb;
  oa_v3 = oa_xr - oa_c2R; oa_v1 = oa_fa1 * oa_c1R + oa_fa2 * oa_v3; oa_v2 = oa_c2R + oa_fa2 * oa_c1R + oa_fa3 * oa_v3;
  oa_c1R = min(max(2 * oa_v1 - oa_c1R, -8), 8); oa_c2R = min(max(2 * oa_v2 - oa_c2R, -8), 8);
  oa_yr = oa_xr * oa_wo + (oa_v2 * oa_wl + (oa_xr - oa_ks * oa_v1 - oa_v2) * oa_wh) * oa_cps + oa_ks * oa_v1 * oa_wb;
  oa_c1L != oa_c1L || oa_c2L != oa_c2L || oa_c1R != oa_c1R || oa_c2R != oa_c2R ? ( oa_c1L = oa_c2L = oa_c1R = oa_c2R = 0; );
) : (
  oa_yl = oa_xl; oa_yr = oa_xr; oa_c1L = oa_c2L = oa_c1R = oa_c2R = 0;
);

oa_wd_st == 1 ? (
  oa_wd_g -= oa_wd_k;
  oa_wd_g <= 0 ? (
    oa_wd_g = 0; oa_ping = oa_ping_t;
    oa_wd_clr ? (
      memset(oa_bufL, 0, oa_DLN); memset(oa_bufR, 0, oa_DLN); memset(oa_RBUF, 0, oa_RLN * 8); memset(oa_ABUF, 0, oa_ALN * 4);
      memset(oa_RS, 0, 8); oa_dlL = oa_dhL = oa_dlR = oa_dhR = 0;
      oa_dtLs = oa_dtL; oa_dtRs = oa_dtR; oa_szs = oa_szt; oa_wd_clr = 0;
    );
    oa_wd_st = 2;
  );
) : oa_wd_st == 2 ? ( oa_wd_g += oa_wd_k; oa_wd_g >= 1 ? ( oa_wd_g = 1; oa_wd_st = 0; ); );

oa_dtLs += (oa_dtL - oa_dtLs) * oa_tgl; oa_dtRs += (oa_dtR - oa_dtRs) * oa_tgl;
oa_el = oa_rdl(oa_bufL, min(max(oa_dtLs, 2), oa_DLN - 4));
oa_er = oa_rdl(oa_bufR, min(max(oa_dtRs, 2), oa_DLN - 4));
oa_ldm += (log(oa_dmp) - oa_ldm) * oa_sm; oa_fbs += (oa_fb - oa_fbs) * oa_sm;
oa_dmpd = min(exp(oa_ldm) * 2 ^ (oa_vD * 0.45 * dm_a), srate * 0.45);
oa_dc = 1 - exp(-2 * $pi * oa_dmpd / srate);
oa_fbd = min(max(oa_fbs + oa_vB * 0.05 * dm_a, 0), 0.95);
oa_dlL += (oa_el - oa_dlL) * oa_dc; oa_dhL += (oa_dlL - oa_dhL) * oa_hc;
oa_dlR += (oa_er - oa_dlR) * oa_dc; oa_dhR += (oa_dlR - oa_dhR) * oa_hc;
oa_fl = oa_soft((oa_dlL - oa_dhL) * oa_fbd); oa_fr = oa_soft((oa_dlR - oa_dhR) * oa_fbd);
oa_ping ? (
  oa_bufL[oa_wp] = (0.5 * (oa_yl + oa_yr) + oa_fr) * oa_wd_g + oa_dn;
  oa_bufR[oa_wp] = oa_fl * oa_wd_g + oa_dn;
) : (
  oa_bufL[oa_wp] = (oa_yl + oa_fl) * oa_wd_g + oa_dn;
  oa_bufR[oa_wp] = (oa_yr + oa_fr) * oa_wd_g + oa_dn;
);
oa_wp += 1; oa_wp >= oa_DLN ? oa_wp = 0;
oa_dmxs += (oa_dmx - oa_dmxs) * oa_sm;
oa_sl = oa_yl + oa_el * oa_dmxs * oa_wd_g; oa_sr = oa_yr + oa_er * oa_dmxs * oa_wd_g;

oa_dn = -oa_dn;
oa_szs += (oa_szt - oa_szs) * oa_sm * 0.1;
oa_t = oa_rc * oa_rcw - oa_rsn * oa_rsw; oa_rsn = oa_rsn * oa_rcw + oa_rc * oa_rsw; oa_rc = oa_t;
oa_il = apL2.oa_ap(apL.oa_ap(oa_sl)); oa_ir = apR2.oa_ap(apR.oa_ap(oa_sr));
oa_rsum = 0; oa_ri = 0;
loop(8,
  oa_ln = oa_RB[oa_ri] * oa_szs + (oa_ri == 0 ? oa_rsn : oa_ri == 5 ? oa_rc : 0) * 0.0006 * srate;
  oa_rp = oa_rw - oa_ln; oa_rp < 0 ? oa_rp += oa_RLN;
  oa_r0 = floor(oa_rp); oa_rf = oa_rp - oa_r0; oa_r1 = oa_r0 + 1; oa_r1 >= oa_RLN ? oa_r1 = 0;
  oa_rbp = oa_RBUF + oa_ri * oa_RLN;
  oa_RY[oa_ri] = oa_rbp[oa_r0] + (oa_rbp[oa_r1] - oa_rbp[oa_r0]) * oa_rf;
  oa_rsum += oa_RY[oa_ri];
  oa_ri += 1;
);
oa_rsum *= 0.25;
oa_ri = 0;
loop(8,
  oa_RS[oa_ri] += (oa_RY[oa_ri] - oa_rsum - oa_RS[oa_ri]) * oa_rdc;
  (oa_RBUF + oa_ri * oa_RLN)[oa_rw] = (((oa_ri & 1) ? oa_ir : oa_il) * 0.5 + oa_RG[oa_ri] * oa_RS[oa_ri]) * oa_wd_g + oa_dn;
  oa_ri += 1;
);
oa_rw += 1; oa_rw >= oa_RLN ? oa_rw = 0;
oa_rl = (oa_RY[0] - oa_RY[2] + oa_RY[4] - oa_RY[6]) * 0.5;
oa_rr = (oa_RY[1] - oa_RY[3] + oa_RY[5] - oa_RY[7]) * 0.5;
oa_smxs += (oa_smx - oa_smxs) * oa_sm;
oa_wtl = oa_sl + oa_rl * oa_smxs * oa_wd_g; oa_wtr = oa_sr + oa_rr * oa_smxs * oa_wd_g;

oa_mixs += (oa_mix - oa_mixs) * oa_sm; oa_outs += (oa_out - oa_outs) * oa_sm;
oa_ol = oa_dl + (oa_wtl - oa_dl) * oa_mixs; oa_or = oa_dr + (oa_wtr - oa_dr) * oa_mixs;
oa_ol != oa_ol ? oa_ol = 0; oa_or != oa_or ? oa_or = 0;
oa_ol *= oa_outs; oa_or *= oa_outs;
fz_o += (fz_t - fz_o) * oa_sm;
fz_o > 0.0001 ? ( oa_ol += fzL.fz_run(oa_ol); oa_or += fzR.fz_run(oa_or); );
pwr_out(oa_ol, oa_or); oa_ol = pwr_l; oa_or = pwr_r;
oa_ol = ostL.ost_band(oa_ol); oa_or = ostR.ost_band(oa_or);
ost_out(oa_ol, oa_or); oa_ol = ost_l; oa_or = ost_r;
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( oa_ol += (rw_l - oa_ol) * by_s; oa_or += (rw_r - oa_or) * by_s; );
oa_ms += 0.5 * (oa_ol * oa_ol + oa_or * oa_or); oa_pkm = max(oa_pkm, max(abs(oa_ol), abs(oa_or)));
