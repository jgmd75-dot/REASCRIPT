desc:Oontecho Mini [trance gate] (GFX Lab)
//tags: trance gate sequencer filter delay reverb rhythmic multi-effect pump sidechain
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-input, gfx-lab-output, gfx-lab-bypass, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider64:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:2<0,4,1{8,12,16,24,32}>-Steps
slider2:3<0,5,1{1/4,1/8,1/8 T,1/16,1/16 T,1/32}>-Division
slider3:100<0,100,1>-Gate depth (%)
slider4:15<0,100,1>-Glide (%)
slider5:50<0,100,1>-Accent (%)
slider6:0<0,50,1>-Swing (%)
slider7:0<-100,100,1>-Pan depth (%)
slider8:0<-5,5,0.01>-Filter sequence depth (oct)
slider9:0<0,3,1{Off,LP,BP,HP}>-Filter type
slider10:2000<20,20000,1>-Cutoff (Hz)
slider11:20<0,100,1>-Resonance (%)
slider12:0<-4,4,0.01>-LFO depth (oct)
slider13:6<0,19,1{64 bars,32 bars,16 bars,8 bars,4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-LFO rate
slider14:10<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Delay time
slider15:2<0,4,1{x0.5,x0.75,x1,x1.5,x2}>-Delay L multiplier
slider16:2<0,4,1{x0.5,x0.75,x1,x1.5,x2}>-Delay R multiplier
slider17:35<0,95,1>-Delay feedback (%)
slider18:6000<1000,20000,1>-Delay damping (Hz)
slider19:0<0,100,1>-Delay mix (%)
slider20:0<0,1,1{Off,On}>-Ping-pong
slider21:50<0,100,1>-Space size (%)
slider22:50<0,100,1>-Space decay (%)
slider23:0<0,100,1>-Space mix (%)
slider24:100<0,100,1>-Mix (%)
slider25:0<-24,12,0.1>-Output (dB)
slider26:50<0,100,1>-Drift (%)
slider27:0<-24,12,0.1>-Input trim (dB)
slider28:0<0,1,1{Off,On}>-Input guard
slider29:0<0,100,1>-Band sat (%)
slider30:byp=0<0,1,1{Off,On}>-Bypass
slider31:100<0,228,1>-Step 1
slider32:100<0,228,1>-Step 2
