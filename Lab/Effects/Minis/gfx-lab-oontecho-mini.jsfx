import gfx-lab-power.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider61, v); slider_show(slider62, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider61, v); slider_show(slider62, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-oontecho-mini";
#og_pm = "Init|Classic 16ths|Euphoric Gate|Sidechain Pump|Half-Time Chop|Filter Sequence|Dub Delay Gate|Ambient Wash|Triplet Trance|Ping-Pong Pan|32nd Stutter|LFO Sweep Gate";
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; mg_ed = 0; );
ui_dflt = 1;
rs_f = 1;
ext_noinit = 1;
pwr_init();
pwr_wu_loss = 0.8; pwr_wu_drv = 1; pwr_wu_lp = 9000; pwr_wu_wob = 0.3; pwr_bloom = 0;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
ost_init(alloc(4096));
COEF = alloc(32);
oa_DLN = ceil(4.2 * srate) + 8;
oa_bufL = alloc(oa_DLN); oa_bufR = alloc(oa_DLN);
oa_RLN = ceil(0.135 * srate) + 8;
oa_RBUF = alloc(oa_RLN * 8);
oa_ALN = ceil(0.012 * srate) + 8;
oa_ABUF = alloc(oa_ALN * 4);
oa_RB = alloc(8); oa_RG = alloc(8); oa_RS = alloc(8); oa_RY = alloc(8);
og_tmp = alloc(32);

oa_RB[0] = 29.7; oa_RB[1] = 37.1; oa_RB[2] = 41.1; oa_RB[3] = 43.7;
oa_RB[4] = 53.3; oa_RB[5] = 59.9; oa_RB[6] = 67.7; oa_RB[7] = 73.1;

function oa_nsteps(i) ( i = floor(i + 0.5); i == 0 ? 8 : i == 1 ? 12 : i == 2 ? 16 : i == 3 ? 24 : 32; );
function oa_divb(i) ( i = floor(i + 0.5); i == 0 ? 1 : i == 1 ? 0.5 : i == 2 ? 1/3 : i == 3 ? 0.25 : i == 4 ? 1/6 : 0.125; );
function oa_mult(i) ( i = floor(i + 0.5); i == 0 ? 0.5 : i == 1 ? 0.75 : i == 2 ? 1 : i == 3 ? 1.5 : 2; );
function oa_q(i) local(barq) (
  barq = ts_denom > 0 ? ts_num * 4 / ts_denom : 4; i = floor(i + 0.5);
  i == 0 ? 4 * barq : i == 1 ? 2 * barq : i == 2 ? barq :
  i == 3 ? 2 : i == 4 ? 3 : i == 5 ? 4 / 3 :
  i == 6 ? 1 : i == 7 ? 1.5 : i == 8 ? 2 / 3 :
  i == 9 ? 0.5 : i == 10 ? 0.75 : i == 11 ? 1 / 3 :
  i == 12 ? 0.25 : i == 13 ? 0.375 : i == 14 ? 1 / 6 : 0.125;
);
function oa_lq(i) local(barq) (
  barq = ts_denom > 0 ? ts_num * 4 / ts_denom : 4; i = floor(i + 0.5);
  i == 0 ? 64 * barq : i == 1 ? 32 * barq : i == 2 ? 16 * barq : i == 3 ? 8 * barq : oa_q(i - 4);
);
function oa_soft(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
function oa_rdl(buf, d) local(p, i, f, x0, x1, x2, x3, n) (
  n = oa_DLN; p = oa_wp - d; p < 0 ? p += n; i = floor(p); f = p - i;
  x0 = buf[(i - 1 + n) % n]; x1 = buf[i % n]; x2 = buf[(i + 1) % n]; x3 = buf[(i + 2) % n];
  (((0.5 * (x3 - x0) + 1.5 * (x1 - x2)) * f + (x0 - 2.5 * x1 + 2 * x2 - 0.5 * x3)) * f + 0.5 * (x2 - x0)) * f + x1;
);
function oa_ap(x) instance(buf, n, p, g) local(d, w) (
  d = buf[p]; w = x + g * d; buf[p] = w; p += 1; p >= n ? p = 0;
  d - g * w;
);
function oa_rd(i) local(v, a, lv) (
  v = slider(31 + i); a = v > 127.5; lv = min(max((v - 128 * a) / 100, 0), 1);
  oa_tl = lv; oa_ta = a;
  oa_tg = (1 - oa_dep + oa_dep * lv) * (a ? oa_accg : 1);
  oa_tp = oa_pan * lv * ((i & 1) ? 1 : -1);
);

function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
C_F1 = COEF; C_F2 = COEF + 5; C_F3 = COEF + 10; C_F4 = COEF + 15;
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_run(x) instance(zA, zB, zC, zD, fh, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = zA.fz_bm(x, C_F1);
  ha = abs(h); fh += (ha - fh) * (ha > fh ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fh, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fh;
  e = zD.fz_bm(zC.fz_bm(zB.fz_bm(e, C_F2), C_F3), C_F4);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_clr() instance(zA, zB, zC, zD, fh, fp, fe) ( zA.fz_bmz(); zB.fz_bmz(); zC.fz_bmz(); zD.fz_bmz(); fh = fp = fe = 0; );
fz_bqc(C_F1, 4, 3500, 0, 0.7071, srate); fz_bqc(C_F2, 4, 5500, 0, 0.7071, srate);
fz_bqc(C_F3, 0, 8000, 4, 0.7, srate); fz_bqc(C_F4, 2, 12000, -6, 0.7, srate);
fz_a = 1 - exp(-1 / (0.003 * srate)); fz_r = 1 - exp(-1 / (0.12 * srate)); fz_w = 1 - exp(-1 / (0.06 * srate));

function oa_pat(lv, ac) local(i, c, d, n, m) (
  n = strlen(lv); m = strlen(ac); i = 0;
  loop(32,
    c = str_getchar(lv, i % n); d = c >= 65 ? c - 55 : c - 48; d = min(max(d, 0), 15);
    slider(31 + i) = floor(d / 15 * 100 + 0.5) + (str_getchar(ac, i % m) == 49 ? 128 : 0);
    i += 1;
  );
);
function oa_pg(st, dv, dp, gl, ac, sw, pn, fs) (
  slider1 = st; slider2 = dv; slider3 = dp; slider4 = gl; slider5 = ac; slider6 = sw; slider7 = pn; slider8 = fs;
);
function oa_pf(ty, ct, rs, ld, lr) ( slider9 = ty; slider10 = ct; slider11 = rs; slider12 = ld; slider13 = lr + 4; );
function oa_pd(tm, ml, mr, fb, dm, mx, pp) ( slider14 = tm; slider15 = ml; slider16 = mr; slider17 = fb; slider18 = dm; slider19 = mx; slider20 = pp; );
function oa_ps(sz, dc, mx) ( slider21 = sz; slider22 = dc; slider23 = mx; );
function load_preset(p) local(i) (
  oa_pg(2, 3, 100, 15, 50, 0, 0, 0); oa_pf(0, 2000, 20, 0, 2); oa_pd(10, 2, 2, 35, 6000, 0, 0); oa_ps(50, 50, 0); slider24 = 100;
  p == 1 ? (
    oa_pat("F", "0");
  ) : p == 2 ? (
    oa_pg(2, 3, 100, 10, 45, 0, 0, 0); oa_pd(10, 2, 2, 30, 7000, 22, 0); oa_ps(40, 35, 12);
    oa_pat("FF0FF0F0FF0FF0F0", "1001001010010010");
  ) : p == 3 ? (
    oa_pg(2, 3, 100, 12, 60, 0, 0, 2.5); oa_pf(1, 900, 45, 0, 2); oa_pd(10, 2, 3, 40, 6500, 25, 0); oa_ps(55, 50, 22);
    oa_pat("FC0FA0F8C0FA0FCF", "1000000010000000");
  ) : p == 4 ? (
    oa_pg(2, 3, 100, 55, 0, 0, 0, 0);
    oa_pat("05AF", "0");
  ) : p == 5 ? (
    oa_pg(2, 1, 100, 20, 40, 0, 0, 0); oa_pf(1, 6000, 10, 0, 2); oa_pd(6, 2, 2, 30, 5000, 18, 0); oa_ps(45, 40, 10);
    oa_pat("FF00F0A0FF00F00C", "1000000010000000");
  ) : p == 6 ? (
    oa_pg(2, 3, 0, 25, 60, 0, 0, 4.5); oa_pf(1, 160, 70, 0, 2); oa_pd(10, 2, 2, 35, 5000, 20, 0); oa_ps(50, 45, 15);
    oa_pat("F38C2F6A0FB47E19", "1000100010001000");
  ) : p == 7 ? (
    oa_pg(2, 1, 100, 10, 40, 0, 0, 0); oa_pf(3, 260, 25, 0, 2); oa_pd(7, 2, 1, 65, 2400, 45, 1); oa_ps(55, 45, 18);
    oa_pat("F000F0000F00F000", "1000000000001000");
  ) : p == 8 ? (
    oa_pg(0, 0, 70, 90, 20, 0, 30, 0); oa_pf(1, 2500, 15, 1.5, 1); oa_pd(6, 2, 3, 55, 4000, 35, 0); oa_ps(90, 85, 55);
    oa_pat("FA6CF84B", "10000000");
  ) : p == 9 ? (
    oa_pg(3, 4, 100, 12, 50, 0, 60, 0); oa_pd(8, 2, 3, 35, 6000, 20, 0); oa_ps(45, 40, 12);
    oa_pat("FA0FA0F70FA0FA0F70FA0FC0", "100000100000100000100000");
  ) : p == 10 ? (
    oa_pg(2, 3, 60, 15, 40, 0, 100, 0); oa_pd(9, 2, 3, 40, 7000, 22, 1); oa_ps(40, 35, 10);
    oa_pat("FFAFFAFFAFFAFFAF", "1000100010001000");
  ) : p == 11 ? (
    oa_pg(4, 5, 100, 5, 55, 0, 0, 0); oa_pd(12, 2, 2, 25, 8000, 12, 0);
    oa_pat("F0F0F0F0FF0FF0FFF0F0F0F0F0F0FFFF", "10000000100000001000000010001010");
  ) : p == 12 ? (
    oa_pg(2, 3, 100, 15, 50, 10, 0, 0); oa_pf(2, 700, 55, 3, 1); oa_pd(10, 2, 2, 35, 6000, 25, 0); oa_ps(50, 50, 20);
    oa_pat("F0F0FF0FF0F0FF0F", "1000000010000000");
  );
  oa_wd_st = 1; oa_wd_clr = 1;
  slider_automate(536870911);
  i = 31; loop(32, slider_automate(2 ^ (i - 1)); i += 1; );
);

in_init();
ostL.ost_ch_init(); ostR.ost_ch_init();
oa_dF.drift_init(0.8 + rand(1) * 0.5);
oa_dD.drift_init(0.8 + rand(1) * 0.5);
oa_dB.drift_init(0.8 + rand(1) * 0.5);
oa_vF = oa_vD = oa_vB = 0;
oa_b = 0; oa_lastg = -999999; oa_step = 0; oa_wp = 0; oa_rw = 0;
oa_g1 = oa_g2 = 1; oa_l1 = oa_l2 = 1; oa_a1s = oa_a2s = 0; oa_p1 = oa_p2 = 0;
oa_wo = 1; oa_wl = oa_wb = oa_wh = 0;
oa_lfph = 0; oa_lfo = 0; oa_rc = 1; oa_rsn = 0; oa_dn = 0.000000000000001;
oa_sm = 1 - exp(-1 / (0.03 * srate));
oa_fc = 1 - exp(-1 / (0.012 * srate));
oa_tgl = 1 - exp(-1 / (0.12 * srate));
oa_lfk = 1 - exp(-1 / (0.6 * srate));
oa_pkm = oa_ms = 0;
apL.buf = oa_ABUF;              apL.n = floor(0.0047 * srate); apL.p = 0; apL.g = 0.6;
apL2.buf = oa_ABUF + oa_ALN;    apL2.n = floor(0.0079 * srate); apL2.p = 0; apL2.g = 0.55;
apR.buf = oa_ABUF + oa_ALN * 2; apR.n = floor(0.0053 * srate); apR.p = 0; apR.g = 0.6;
apR2.buf = oa_ABUF + oa_ALN * 3; apR2.n = floor(0.0071 * srate); apR2.p = 0; apR2.g = 0.55;
c_sw = 1 - exp(-1 / (0.005 * srate));
oa_wd_g = 1; oa_wd_st = 0; oa_wd_clr = 0; oa_wd_k = 1 / (0.012 * srate);

function oa_update() local(i, t60, ln) (
  oa_nst = oa_nsteps(slider1);
  oa_dv = oa_divb(slider2);
  oa_dep = slider3 / 100;
  oa_sw = slider6 / 100;
  oa_a1 = oa_dv * (1 + oa_sw);
  oa_accg = 10 ^ (slider5 * 0.06 / 20);
  oa_acco = slider5 / 100 * 1.5;
  oa_pan = slider7 / 100;
  oa_fsq = slider8;
  oa_ftype = floor(slider9 + 0.5);
  oa_cut = slider10; oa_res = slider11 / 100;
  oa_k = 2 * (1 - 0.97 * oa_res);
  oa_comp = 1 - 0.35 * oa_res;
  oa_ldep = slider12;
  oa_lqn = oa_lq(slider13);
  oa_tmp = max(tempo, 20);
  oa_binc = oa_tmp / (60 * srate);
  oa_gc = 1 - exp(-1 / ((0.0007 + (slider4 / 100) ^ 2 * 0.5 * oa_dv * 60 / oa_tmp) * 0.5 * srate));
  i = oa_q(slider14) * 60 / oa_tmp;
  oa_dtL = min(i * oa_mult(slider15), 4) * srate;
  oa_dtR = min(i * oa_mult(slider16), 4) * srate;
  oa_fb = slider17 / 100;
  oa_dmp = slider18;
  oa_dmx = slider19 / 100;
  oa_ping_t = slider20 > 0.5;
  oa_ping_t != oa_ping && oa_wd_st == 0 ? oa_wd_st = 1;
  oa_hc = 1 - exp(-2 * $pi * 70 / srate);
  oa_szt = (0.35 + 1.3 * slider21 / 100) * srate / 1000;
  t60 = 0.4 + (slider22 / 100) ^ 2 * 9.6;
  i = 0; loop(8, ln = oa_RB[i] * oa_szt; oa_RG[i] = exp(-6.9078 * ln / (t60 * srate)); i += 1; );
  oa_rdc = 1 - exp(-2 * $pi * (9000 - 4500 * slider22 / 100) / srate);
  oa_smx = slider23 / 100;
  oa_mix = slider24 / 100;
  oa_out = 10 ^ (slider25 / 20);
  drift_macro(slider26);
  in_setup(slider27, slider28);
  ost_setup(slider29 / 100, 0.3, 120, 6000, -0.3, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
  fz_t = 0.33 * min(max((slider29 - 50) / 50, 0), 1);
);
oa_update();
oa_ping = oa_ping_t; oa_wd_st = 0;
oa_szs = oa_szt; oa_dtLs = oa_dtL; oa_dtRs = oa_dtR; oa_mixs = oa_mix; oa_outs = oa_out; oa_dmxs = oa_dmx; oa_smxs = oa_smx;
oa_lc = log(oa_cut); oa_ks = oa_k; oa_cps = oa_comp; oa_lds = oa_ldep; oa_fss = oa_fsq; oa_acs = oa_acco; oa_fbs = oa_fb;
oa_ldm = log(oa_dmp); fz_o = fz_t;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(62, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
