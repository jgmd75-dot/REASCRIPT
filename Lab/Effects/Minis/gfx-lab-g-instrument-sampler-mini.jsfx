desc:Instrument Sampler Mini [sampler] (GFX Lab)
//tags: instrument sampler keys bass synth one-shots browser sorting mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-clip, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

options:maxmem=33554432

import gfx-lab-clip.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider10:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-36,12,0.1>-Volume (dB)
slider2:0<0,1,1{Off,On}>-Comp in
slider3:0<-100,100,1>-Comp amount (%)
slider4:0<0,1,1{Off,On}>-Sat in
slider5:0<-100,100,1>-Width high (%)
slider6:0<-100,100,1>-Width low (%)
slider7:0<-24,24,0.01>-Tune (semitones)
slider8:2<2,2000,1>-Attack (ms)
slider9:300<5,5000,1>-Release (ms)

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(511, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(511, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-instrument-sampler-mini";
ext_noinit = 1;

MQO = 1200; MQN = 1500; MQV = 1800; MQT = 2100;
PNCH = 3300; PSR = 3320; PFR = 3340;
LREQ = 3360; LDONE = 3380;
PPK = 3540;
PMIS = 3600;
KLIT = 3700;
HELD = 3900; SUSN = 4100;
AS = 40000;
USR = 80000;
SNDM = 3100000; SLSZ = 14500000;
PPM = 20000;
LN = 16384; LB = 100000;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
clL.clp_set(2, 1.6, 1.6, 0); clL.clp_knee(0.6); clR.clp_set(2, 1.6, 1.6, 0); clR.clp_knee(0.6);
PPM[1024] = 0;
KQ = 4300; IRT = 4400;
!inst_ok ? ( PPM[0] = 0; IRT[0] = 60; IRT[1] = -1; inst_ok = 1; );
kq_r = kq_w = 0;
function ppm_str_a(k, dst) local(b, n, i) (
  b = PPM + k * 1024; n = b[0]; str_setlen(dst, n); i = 0; loop(n, str_setchar(dst, i, b[1 + i], 'cu'); i += 1; ); dst;
);
memset(PFR, 0, 2); memset(KLIT, 0, 128); memset(HELD, 0, 128); memset(SUSN, 0, 128);

function load_slot(k, path) local(h, nch, sr, n, b, i, j, got, f) (
  PFR[k] = 0; PNCH[k] = 1; PSR[k] = 44100;
  h = file_open(path);
  h >= 0 ? (
    nch = 0; sr = 0; file_riff(h, nch, sr);
    nch > 0 && sr > 0 ? (
      b = SNDM + k * SLSZ;
      nch <= 2 ? (
        n = floor(min(file_avail(h), SLSZ) / nch) * nch;
        n = file_mem(h, b, n);
        PFR[k] = floor(n / nch); PNCH[k] = nch;
      ) : (
        f = 0; got = 1;
        while (got > 0 && f < SLSZ / 2 - 4096) (
          got = floor(file_mem(h, AS, 4096 * nch) / nch);
          i = 0; loop(got, j = AS + i * nch; b[(f + i) * 2] = j[0]; b[(f + i) * 2 + 1] = j[1]; i += 1; );
          f += got;
        );
        PFR[k] = f; PNCH[k] = 2;
      );
      PSR[k] = sr;
      PPK[k] = 0; b = SNDM + k * SLSZ; i = 0; loop(PFR[k] * PNCH[k], PPK[k] = max(PPK[k], abs(b[i])); i += 1; );
    );
    file_close(h);
  );
  PMIS[k] = PPM[k * 1024] > 0 && PFR[k] < 2;
);

function pv_init() instance(act, fd) ( act = 0; fd = 0; );
function pv_go() instance(act, pos, inc, len, nch, base, gn, fd) (
  len = PFR[1]; nch = PNCH[1]; base = SNDM + SLSZ;
  len < 2 ? act = 0 : ( inc = PSR[1] / srate; gn = lvl_g / max(PPK[1], 0.063); pos = 0; fd = 0; act = 1; );
);
function pv_fade(ms) instance(act, fd) ( act ? fd = max(fd, 1 / (ms * 0.001 * srate)); );
function pv_run() instance(act, pos, inc, len, nch, base, gn, fd, env) local(i, f, a, b, l, r, g) (
  act ? (
    i = floor(pos); f = pos - i;
    nch == 1 ? ( a = base[i]; b = base[i + 1]; l = r = a + (b - a) * f; ) : (
      a = base[i * 2]; b = base[i * 2 + 2]; l = a + (b - a) * f;
      a = base[i * 2 + 1]; b = base[i * 2 + 3]; r = a + (b - a) * f;
    );
    fd == 0 ? env = 1;
    g = env * min(1, (len - 1 - pos) / inc / (0.002 * srate));
    oL += l * gn * g; oR += r * gn * g;
    pos += inc; pos >= len - 1 ? act = 0;
    fd > 0 ? ( env -= fd; env <= 0 ? act = 0; );
  );
);

function iv_go(key, vel) instance(act, pos, inc, len, nch, base, gn, env, ast, fd, note, age, pk, pv) (
  len = PFR[0]; nch = PNCH[0]; base = SNDM;
  len < 2 ? act = 0 : (
    inc = PSR[0] / srate * 2 ^ ((key - IRT[0]) / 12);
    gn = 0.5 * (0.25 + 0.75 * vel) * lvl_g / max(PPK[0], 0.063);
    pos = 0; env = 0; ast = 1 / max(1, slider8 * 0.001 * srate); fd = 0; note = key; age = iv_n; iv_n += 1; act = 1; pk = -1;
  );
);
function iv_take(key, vel) instance(act, fd, env, ast, pk, pv) (
  act ? ( pk = key; pv = vel; ast = 0; fd = max(fd, max(env, 0.001) / max(1, 0.003 * srate)); ) : this.iv_go(key, vel);
);
function iv_off(key) instance(act, note, fd, env, ast, pk) (
  act && pk < 0 && fd == 0 && note == key ? ( ast = 0; fd = max(env, 0.001) / max(1, slider9 * 0.001 * srate); );
  pk == key ? pk = -1;
);
function iv_fade(ms) instance(act, fd, env, ast, pk) ( act ? ( pk = -1; ast = 0; fd = max(fd, max(env, 0.001) / max(1, ms * 0.001 * srate)); ); );
function iv_run() instance(act, pos, inc, len, nch, base, gn, env, ast, fd, note, pk, pv) local(i, f, a, b, l, r, g, k) (
  act ? (
    k = inc * bend_s * tune_s;
    i = floor(pos); f = pos - i;
    nch == 1 ? ( a = base[i]; b = base[i + 1]; l = r = a + (b - a) * f; ) : (
      a = base[i * 2]; b = base[i * 2 + 2]; l = a + (b - a) * f;
      a = base[i * 2 + 1]; b = base[i * 2 + 3]; r = a + (b - a) * f;
    );
    ast > 0 ? ( env = min(env + ast, 1); env >= 1 ? ast = 0; );
    g = env * gn * min(1, (len - 1 - pos) / k / (0.002 * srate));
    oL += l * g; oR += r * g;
    pos += k; pos >= len - 1 ? ( act = 0; pk >= 0 ? ( this.iv_go(pk, pv); ); );
    fd > 0 && act ? ( env -= fd; env <= 0 ? ( act = 0; pk >= 0 ? this.iv_go(pk, pv); ); );
  );
);
function iv_lit() instance(act, note, pk) ( act && pk < 0 ? KLIT[note] = 1; );
function inst_on(key, vel) local(k, best, bv, v) (
  best = -1; k = 0;
  loop(8, best < 0 && !(k == 0 ? iv0.act : k == 1 ? iv1.act : k == 2 ? iv2.act : k == 3 ? iv3.act : k == 4 ? iv4.act :
                        k == 5 ? iv5.act : k == 6 ? iv6.act : iv7.act) ? best = k; k += 1; );
  best < 0 ? (
    bv = 2; k = 0;
    loop(8, v = k == 0 ? iv0.fd : k == 1 ? iv1.fd : k == 2 ? iv2.fd : k == 3 ? iv3.fd : k == 4 ? iv4.fd : k == 5 ? iv5.fd : k == 6 ? iv6.fd : iv7.fd;
      v > 0 ? ( v = k == 0 ? iv0.env : k == 1 ? iv1.env : k == 2 ? iv2.env : k == 3 ? iv3.env : k == 4 ? iv4.env : k == 5 ? iv5.env : k == 6 ? iv6.env : iv7.env;
                v < bv ? ( bv = v; best = k; ); );
      k += 1; );
  );
  best < 0 ? (
    bv = iv_n; k = 0;
    loop(8, v = k == 0 ? iv0.age : k == 1 ? iv1.age : k == 2 ? iv2.age : k == 3 ? iv3.age : k == 4 ? iv4.age : k == 5 ? iv5.age : k == 6 ? iv6.age : iv7.age;
      v < bv ? ( bv = v; best = k; ); k += 1; );
  );
  best == 0 ? iv0.iv_take(key, vel) : best == 1 ? iv1.iv_take(key, vel) : best == 2 ? iv2.iv_take(key, vel) : best == 3 ? iv3.iv_take(key, vel) :
  best == 4 ? iv4.iv_take(key, vel) : best == 5 ? iv5.iv_take(key, vel) : best == 6 ? iv6.iv_take(key, vel) : iv7.iv_take(key, vel);
);
function inst_off(key) ( iv0.iv_off(key); iv1.iv_off(key); iv2.iv_off(key); iv3.iv_off(key); iv4.iv_off(key); iv5.iv_off(key); iv6.iv_off(key); iv7.iv_off(key); );
function inst_fade(ms) ( iv0.iv_fade(ms); iv1.iv_fade(ms); iv2.iv_fade(ms); iv3.iv_fade(ms); iv4.iv_fade(ms); iv5.iv_fade(ms); iv6.iv_fade(ms); iv7.iv_fade(ms); );
function inst_act() ( iv0.act || iv1.act || iv2.act || iv3.act || iv4.act || iv5.act || iv6.act || iv7.act; );
function inst_stop() ( iv0.act = iv1.act = iv2.act = iv3.act = iv4.act = iv5.act = iv6.act = iv7.act = 0; pv0.pv_init(); );
function key_dn(n, v) ( HELD[n] = 1; SUSN[n] = 0; inst_on(n, v); );
function key_up(n) ( HELD[n] = 0; sustain ? SUSN[n] = 1 : inst_off(n); );
function pedal_up() local(n) ( n = 0; loop(128, SUSN[n] ? ( SUSN[n] = 0; inst_off(n); ); n += 1; ); );
function all_off() local(n) ( n = 0; loop(128, HELD[n] ? inst_off(n); HELD[n] = 0; SUSN[n] = 0; n += 1; ); sustain = 0; inst_fade(20); );
inst_stop(); iv_n = 0;
xpL = xpR = 0; m_cnt = 0; bend = 1; bend_s = 1; sustain = 0;
sm = 1 - exp(-1 / (0.03 * srate));
function bq_s(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, al, aa, n, sa) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); al = sin(w0) / (2 * q); aa = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / aa; b0 = (1 + al * aa) / n; b1 = -2 * cw / n; b2 = (1 - al * aa) / n; a1 = b1; a2 = (1 - al / aa) / n; ) : (
    sa = 2 * sqrt(aa) * al; n = (aa + 1) - (aa - 1) * cw + sa;
    b0 = aa * ((aa + 1) + (aa - 1) * cw + sa) / n; b1 = -2 * aa * ((aa - 1) + (aa + 1) * cw) / n;
    b2 = aa * ((aa + 1) + (aa - 1) * cw - sa) / n; a1 = 2 * ((aa - 1) - (aa + 1) * cw) / n; a2 = ((aa + 1) - (aa - 1) * cw - sa) / n;
  );
);
function bq_r(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
hd_g = 10 ^ (5 * 2.2 / 20); hd_lb = (5 / 10) ^ 1.2;
function tanh_h(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
hd_cs = 0.25 / (2 * tanh_h(hd_g * 0.125)); hd_lg = sqrt(hd_g * hd_cs); hd_bump = 1.5 * (1 - 0.5 * 0.5);
function hd_set() instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, u1, u2, u3, u4, d1, d2, d3, d4) local(fs2, fc) (
  fs2 = 2 * srate; fc = min(0.42 * srate, 20000);
  u1.bq_s(0, fc, 0.5098, 0, fs2); u2.bq_s(0, fc, 0.6013, 0, fs2); u3.bq_s(0, fc, 0.9, 0, fs2); u4.bq_s(0, fc, 2.5629, 0, fs2);
  d1.bq_s(0, fc, 0.5098, 0, fs2); d2.bq_s(0, fc, 0.6013, 0, fs2); d3.bq_s(0, fc, 0.9, 0, fs2); d4.bq_s(0, fc, 2.5629, 0, fs2);
  emp.bq_s(3, 3000, 0.7, 4, srate); dem.bq_s(3, 3000, 0.7, -4, srate);
  vpre.bq_s(2, 1000, 0.7, 0, srate); vpost.bq_s(2, 1000, 0.7, 0, srate);
  bump.bq_s(2, 70, 0.9, hd_bump, srate); gap.bq_s(0, 16000, 0.55, 0, srate);
  dcb.bq_s(1, 10, 0.7, 0, srate); lop.bq_s(0, 250, 0.6, 0, srate);
);
function hd_clr() instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, u1, u2, u3, u4, d1, d2, d3, d4) (
  emp.bq_clr(); dem.bq_clr(); vpre.bq_clr(); vpost.bq_clr(); bump.bq_clr(); gap.bq_clr(); dcb.bq_clr(); lop.bq_clr();
  u1.bq_clr(); u2.bq_clr(); u3.bq_clr(); u4.bq_clr(); d1.bq_clr(); d2.bq_clr(); d3.bq_clr(); d4.bq_clr();
);
function hd_run(x) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, u1, u2, u3, u4, d1, d2, d3, d4) local(lo, y, z) (
  lo = lop.bq_r(x) * hd_lb;
  y = vpre.bq_r(emp.bq_r(x - lo)) * 0.5;
  z = u4.bq_r(u3.bq_r(u2.bq_r(u1.bq_r(y * 2))));
  d4.bq_r(d3.bq_r(d2.bq_r(d1.bq_r(tanh_h(hd_g * z) * hd_cs))));
  z = u4.bq_r(u3.bq_r(u2.bq_r(u1.bq_r(0))));
  y = d4.bq_r(d3.bq_r(d2.bq_r(d1.bq_r(tanh_h(hd_g * z) * hd_cs)))) * 2;
  dcb.bq_r(gap.bq_r(bump.bq_r(vpost.bq_r(dem.bq_r(y)) + lo * hd_lg)));
);
hdL.hd_set(); hdR.hd_set();
wlo1.bq_s(0, 800, 0.70710678, 0, srate); wlo2.bq_s(0, 800, 0.70710678, 0, srate);
cp_rms = 1 - exp(-1 / (0.008 * srate)); cp_rel = 120 / srate; cp_fade = 1 - exp(-1 / (0.015 * srate));
cp_msl = cp_msr = cp_env = 0; cp_mix = slider2; sat_mix = slider4; cp_mk_s = 1; w_hi = 1 + slider5 / 100; w_lo = 1 + slider6 / 100;
function cp_gain(lv) local(o, f) (
  o = lv - cp_thr;
  f = o <= -5 ? 0 : o >= 5 ? o : (o + 5) * (o + 5) / 20;
  max(-cp_cc * f, -60);
);
function bus_update() local(a) (
  a = slider3 / 100;
  cp_thr = -30 - 8 * a; cp_cc = min(max(0.75 + (a > 0 ? 0.2 : 0.25) * a, 0.5), 0.95);
  cp_mk = 10 ^ (min(-cp_gain(-22), 9) / 20);
  lvl_g = 10 ^ (lvl_set / 20);
);
!lvl_ok ? ( lvl_set = -9; lvl_ok = 1; );

pwr_init(); pwr_hum_db = -83; pwr_sag = 0.12; pwr_rip = 0.002;
pwr_wu_loss = 0.5; pwr_wu_drv = 0.6; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;

function update() (
  vol_t = 10 ^ (slider1 / 20); tune_t = 2 ^ (slider7 / 12);
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);
  bus_update();
);
function gap_clear() (
  inst_stop(); memset(HELD, 0, 128); memset(SUSN, 0, 128); sustain = 0;
  hdL.hd_clr(); hdR.hd_clr(); wlo1.bq_clr(); wlo2.bq_clr();
  cp_msl = cp_msr = cp_env = 0; xpL = xpR = 0; clL.clp_reset(); clR.clp_reset();
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
update();
vol_s = vol_t; tune_s = tune_t;
mn_pk_d = 0; mn_pkm = 0;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; sm_ed = 0; );
kb_n = -1;
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
update();

@block
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
update();
pwr_block(1);
m_cnt = 0;
while (midirecv(mofs, m1, m2, m3)) (
  m_st = m1 & 0xF0;
  (m_st == 0x90 || m_st == 0x80 || m_st == 0xE0 || m_st == 0xB0) && m_cnt < 256 ? (
    MQO[m_cnt] = mofs; MQN[m_cnt] = m2; MQV[m_cnt] = m3; MQT[m_cnt] = m_st == 0x90 && m3 > 0 ? 1 : m_st == 0xE0 ? 3 : m_st == 0xB0 ? 4 : 0;
    MQT[m_cnt] == 1 ? sm_mt_d = time_precise();
    m_cnt += 1;
  );
  midisend(mofs, m1, m2, m3);
);
m_idx = 0; spos = 0;
tr_on = play_state == 1 || play_state == 5;
tr_prev && !tr_on ? all_off();
tr_prev = tr_on;
kq_r != kq_w ? (
  while (kq_r != kq_w) (
    kq_v = KQ[kq_r % 64]; kq_v >= 0 ? key_dn(kq_v, 0.8) : key_up(-kq_v - 1);
    kq_r += 1;
  );
);
stp != stpd ? ( stpd = stp; all_off(); pv0.pv_fade(8); );
ld_k = -1; gi_b = 0; while (ld_k < 0 && gi_b < 2) ( LREQ[gi_b] != LDONE[gi_b] ? ld_k = gi_b; gi_b += 1; );
ld_k >= 0 ? (
  ld_k == 0 && inst_act() ? inst_fade(3) : ld_k == 1 && pv0.act ? pv0.pv_fade(2) : (
    LDONE[ld_k] = LREQ[ld_k];
    load_slot(ld_k, ppm_str_a(ld_k, #ldp));
    ld_k == 1 ? pv0.pv_go();
  );
);
pv_stop != pv_stopd ? ( pv_stopd = pv_stop; pv0.pv_fade(8); );
snd_d = inst_act() || pv0.act;
pv_on_d = pv0.act && pv0.fd == 0;
gi_b = 0; loop(128, KLIT[gi_b] = HELD[gi_b] || SUSN[gi_b]; gi_b += 1; );
iv0.iv_lit(); iv1.iv_lit(); iv2.iv_lit(); iv3.iv_lit(); iv4.iv_lit(); iv5.iv_lit(); iv6.iv_lit(); iv7.iv_lit();
mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@serialize
file_var(0, ui_sz);
file_var(0, IRT[0]); IRT[0] = min(max(floor(IRT[0]), 0), 127);
file_var(0, IRT[1]);
file_var(0, PPM[0]); PPM[0] = max(0, min(PPM[0], 1000)); file_mem(0, PPM + 1, PPM[0]);
file_var(0, us_n);
us_n = max(0, min(us_n, 2000));
file_mem(0, USR, us_n * 5);
file_var(0, lvl_set);
lvl_set = min(max(lvl_set, -30), 0);
pwr_ser();
file_avail(0) >= 0 ? (
  PPM[0] > 0 ? LREQ[0] += 1;
  us_dirty = 1;
);

@sample
while (m_idx < m_cnt && MQO[m_idx] <= spos) (
  m_t = MQT[m_idx]; m_n = MQN[m_idx];
  m_t == 1 ? key_dn(m_n, MQV[m_idx] / 127) :
  m_t == 0 ? key_up(m_n) :
  m_t == 3 ? bend = 2 ^ (((MQV[m_idx] * 128 + m_n) - 8192) / 8192 * 2 / 12) :
  m_t == 4 ? (
    m_n == 64 ? ( MQV[m_idx] >= 64 ? sustain = 1 : ( sustain ? ( sustain = 0; pedal_up(); ); ); ) :
    m_n == 120 || m_n == 123 ? all_off();
  );
  m_idx += 1;
);
spos += 1;
bend_s += (bend - bend_s) * sm;
tune_s += (tune_t - tune_s) * sm;
oL = 0; oR = 0;
iv0.iv_run(); iv1.iv_run(); iv2.iv_run(); iv3.iv_run(); iv4.iv_run(); iv5.iv_run(); iv6.iv_run(); iv7.iv_run();
pv0.pv_run();
pwr_in(oL, oR); oL = pwr_l; oR = pwr_r;
cp_mix += (slider2 - cp_mix) * cp_fade;
cp_mix > 0.000001 ? (
  cp_msl += (oL * oL - cp_msl) * cp_rms; cp_msr += (oR * oR - cp_msr) * cp_rms;
  cp_t = cp_gain(10 * log10(0.5 * (cp_msl + cp_msr) + 0.0000000001));
  cp_t < cp_env ? ( cp_env += (cp_t - cp_env) * min(1, max(cp_env - cp_t, 5) / (0.15 * srate)); ) : cp_env = min(cp_t, cp_env + cp_rel);
  cp_mk_s += (cp_mk - cp_mk_s) * sm;
  cp_g = 10 ^ (cp_env / 20) * cp_mk_s;
  oL += (oL * cp_g - oL) * 0.6 * cp_mix; oR += (oR * cp_g - oR) * 0.6 * cp_mix;
) : ( cp_msl = cp_msr = cp_env = 0; );
sat_mix += (slider4 - sat_mix) * cp_fade * 0.5;
sat_mix > 0.000001 ? (
  sat_l = hdL.hd_run(oL); sat_r = hdR.hd_run(oR);
  oL += (sat_l - oL) * sat_mix; oR += (sat_r - oR) * sat_mix;
);
w_hi += (1 + slider5 / 100 - w_hi) * sm; w_lo += (1 + slider6 / 100 - w_lo) * sm;
w_m = 0.5 * (oL + oR); w_s = 0.5 * (oL - oR);
w_sl = wlo2.bq_r(wlo1.bq_r(w_s)); w_s = w_sl * w_lo + (w_s - w_sl) * w_hi;
oL = w_m + w_s; oR = w_m - w_s;
abs(oL) > 1 || abs(xpL) > 1 ? ( clL.x1 = xpL; clL.ad1 = clL.clp_ad(xpL); dxL = oL + clL.clp_run(oL) - 0.5 * (oL + xpL); xpL = oL; oL = dxL; ) : xpL = oL;
abs(oR) > 1 || abs(xpR) > 1 ? ( clR.x1 = xpR; clR.ad1 = clR.clp_ad(xpR); dxR = oR + clR.clp_run(oR) - 0.5 * (oR + xpR); xpR = oR; oR = dxR; ) : xpR = oR;
pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
vol_s += (vol_t - vol_s) * sm;
oL = ostL.ost_band(oL) * vol_s;
oR = ostR.ost_band(oR) * vol_s;
ost_out(oL, oR);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
!gfx_init ? (
  gfx_init = 1;
  L_OFF = LB; L_LEN = LB + LN; L_NST = LB + 2 * LN; L_EXT = LB + 3 * LN; L_RST = LB + 4 * LN; L_CAT = LB + 5 * LN;
  L_KIND = LB + 6 * LN; L_BPM = LB + 7 * LN; L_NOTE = LB + 8 * LN; L_CONF = LB + 9 * LN; L_DIR = LB + 10 * LN;
  L_H1 = LB + 11 * LN; L_H2 = LB + 12 * LN; L_ACAT = LB + 13 * LN; L_KEY = LB + 14 * LN; L_USR = LB + 15 * LN;
  VIEW = LB + 16 * LN;
  F_FIRST = VIEW + LN; F_N = F_FIRST + 4096; F_MASK = F_N + 4096; F_COV = F_MASK + 4096; KLIST = F_COV + 4096;
  R_H = KLIST + 4096; R_C = R_H + 512; R_W = R_C + 512; R_X = R_W + 512;
  T_S = R_X + 512; T_E = T_S + 128; T_H = T_E + 128; T_B = T_H + 128;
  CS = T_B + 128; CS2 = CS + 32; LSC = CS2 + 32; LWH = LSC + 32; OWH = LWH + 64; KU = OWH + 64;
  VTMP = KU + 64;
  PCH = VTMP + LN;
  PCHMAX = SNDM - 1000 - PCH;
  NC = 20;
  lib_st = 0; lib_h = -1; NL = 0; NR = 0; bcat = 20; b_top = 0; b_sel = -1; srch_on = 0; #srch = "";
  kit_cur = 0; NROOT = 0; srt_col = 0; srt_fwd = 1;
);

function lc(c) ( c >= 65 && c <= 90 ? c + 32 : c; );
function hmix(h, c) ( h = h * 37 + c; h >= 1000000000000 ? h -= floor(h / 999999937) * 999999937; h; );
function hmix2(h, c) ( h = h * 41 + c; h >= 1000000000000 ? h -= floor(h / 999999893) * 999999893; h; );
function issep(c) ( c == 47 || c == 92; );
function isdig(c) ( c >= 48 && c <= 57; );
function isalnum(c) ( (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c >= 128; );
function hstr(s) local(h, i) ( h = 0; i = 0; loop(strlen(s), h = hmix(h, lc(str_getchar(s, i, 'cu'))); i += 1; ); h; );
function pstr(a, b, dst) local(k) (
  str_setlen(dst, max(b - a, 0)); k = 0; loop(b - a, str_setchar(dst, k, PCH[a + k], 'cu'); k += 1; ); dst;
);
function ppm_set(k, i) local(b, n, j) (
  b = PPM + k * 1024; n = min(L_LEN[i], 1000); j = 0; loop(n, b[1 + j] = PCH[L_OFF[i] + j]; j += 1; ); b[0] = n;
);
function ppm_str_g(k, dst) local(b, n, i) (
  b = PPM + k * 1024; n = b[0]; str_setlen(dst, n); i = 0; loop(n, str_setchar(dst, i, b[1 + i], 'cu'); i += 1; ); dst;
);
function ppm_has(k) ( PPM[k * 1024] > 0; );
function pmiss(k) ( PMIS[k] && PPM[k * 1024] > 0 && LREQ[k] == LDONE[k]; );
function lstem(i, dst) ( pstr(L_OFF[i] + L_NST[i], L_OFF[i] + L_EXT[i], dst); );
function last_name(src, dst) local(n, k, c) (
  n = strlen(src); while (n > 0 && issep(str_getchar(src, n - 1, 'cu'))) ( n -= 1; );
  k = n; while (k > 0 && !issep(str_getchar(src, k - 1, 'cu'))) ( k -= 1; );
  strcpy_substr(dst, src, k, n - k);
  k = 0; loop(strlen(dst), c = str_getchar(dst, k, 'cu'); c >= 97 && c <= 122 ? str_setchar(dst, k, c - 32, 'cu'); k += 1; );
  dst;
);
function sstem(src, dst) local(n, k, a, b, c) (
  n = strlen(src); a = 0; b = n; k = 0;
  loop(n, c = str_getchar(src, k, 'cu'); issep(c) ? ( a = k + 1; b = n; ); c == 46 ? b = k; k += 1; );
  strcpy_substr(dst, src, a, b - a);
);
function cname(c) (
  c == 0 ? "KICK" : c == 1 ? "SNARE" : c == 2 ? "CLAP" : c == 3 ? "CL HAT" : c == 4 ? "OP HAT" : c == 5 ? "CYMBAL" :
  c == 6 ? "TOM" : c == 7 ? "PERC" : c == 8 ? "D LOOP" : c == 9 ? "P LOOP" : c == 10 ? "BASS" : c == 11 ? "KEYS" :
  c == 12 ? "SYNTH" : c == 13 ? "PAD" : c == 14 ? "GUITAR" : c == 15 ? "STRINGS" : c == 16 ? "BRASS" : c == 17 ? "VOCAL" :
  c == 18 ? "FX" : c == 19 ? "UNSORTED" : "ALL";
);
function clong(c) (
  c == 0 ? "Kick" : c == 1 ? "Snare" : c == 2 ? "Clap" : c == 3 ? "Closed hat" : c == 4 ? "Open hat" : c == 5 ? "Cymbal" :
  c == 6 ? "Tom" : c == 7 ? "Percussion" : c == 8 ? "Drum loop" : c == 9 ? "Percussion loop" : c == 10 ? "Bass" :
  c == 11 ? "Keys" : c == 12 ? "Synth" : c == 13 ? "Pad" : c == 14 ? "Guitar" : c == 15 ? "Strings" : c == 16 ? "Brass" :
  c == 17 ? "Vocal" : c == 18 ? "FX" : "Unsorted";
);
function ccol(c) (
  c == 0 ? 0xC07840 : c == 1 ? 0xE8584A : c == 2 ? 0xEE8A3A : c == 3 || c == 4 ? 0xEEB636 : c == 5 ? 0x5A96E8 :
  c == 6 ? 0x5CC068 : c == 7 ? 0xA47AE8 : c == 8 ? 0x3FBAB0 : c == 9 ? 0x6FD8C8 : c == 10 ? 0x8088F0 :
  c == 11 ? 0xD8B070 : c == 12 ? 0xE080C8 : c == 13 ? 0x7FC8D8 : c == 14 ? 0xD08A4A : c == 15 ? 0xD07070 :
  c == 16 ? 0xE8C040 : c == 17 ? 0xF08AB0 : c == 18 ? 0xAAB0B8 : 0x8A8A8A;
);
function note_name(n, dst) local(o) (
  o = floor(n / 12) - 2;
  sprintf(dst, "%s%d", n % 12 == 0 ? "C" : n % 12 == 1 ? "C#" : n % 12 == 2 ? "D" : n % 12 == 3 ? "D#" : n % 12 == 4 ? "E" :
          n % 12 == 5 ? "F" : n % 12 == 6 ? "F#" : n % 12 == 7 ? "G" : n % 12 == 8 ? "G#" : n % 12 == 9 ? "A" :
          n % 12 == 10 ? "A#" : "B", o);
);
function key_name(k, dst) local(s) (
  s = (k - 1) % 12;
  strcpy(dst, s == 0 ? "C" : s == 1 ? "C#" : s == 2 ? "D" : s == 3 ? "D#" : s == 4 ? "E" : s == 5 ? "F" : s == 6 ? "F#" :
              s == 7 ? "G" : s == 8 ? "G#" : s == 9 ? "A" : s == 10 ? "A#" : "B");
  k > 12 ? strcat(dst, "m");
);

function rl_add(cat, w, words) local(n, k, st, x, wln, h, i) (
  n = strlen(words); k = 0;
  while (k < n) (
    st = k; while (k < n && str_getchar(words, k) != 32) ( k += 1; );
    k > st && NR < 400 ? (
      x = str_getchar(words, k - 1) == 61; wln = k - st - x;
      h = 0; i = st; loop(wln, h = hmix(h, lc(str_getchar(words, i, 'cu'))); i += 1; );
      R_H[NR] = h; R_C[NR] = cat; R_W[NR] = w; R_X[NR] = x || wln < 4;
      !R_X[NR] ? ( strcpy_substr(#rw, words, st, wln); strcpy(500 + NR, "*"); strcat(500 + NR, #rw); strcat(500 + NR, "*"); );
      NR += 1;
    );
    k += 1;
  );
);
function wl_add(dst, words) local(n, k, st, h, i, cnt) (
  n = strlen(words); k = 0; cnt = 0;
  while (k < n) (
    st = k; while (k < n && str_getchar(words, k) != 32) ( k += 1; );
    k > st ? ( h = 0; i = st; loop(k - st, h = hmix(h, lc(str_getchar(words, i, 'cu'))); i += 1; ); dst[cnt] = h; cnt += 1; );
    k += 1;
  );
  cnt;
);
function rl_init() (
  NR = 0;
  rl_add(0, 1.0, "kick kicks kik kck= bd= kickdrum kickdrums");
  rl_add(0, 2.0, "bassdrum");
  rl_add(1, 1.0, "snare snares snr= sd= snaredrum");
  rl_add(1, 0.7, "sn=");
  rl_add(2, 1.0, "clap claps clp= handclap");
  rl_add(2, 0.7, "snap= snaps=");
  rl_add(3, 1.2, "closedhat closedhh closedhihat hatclosed chh= clhat");
  rl_add(3, 0.7, "ch= chat= closed= pedal= tight=");
  rl_add(3, 0.6, "hihat hihats hat= hats= hh= highhat");
  rl_add(4, 1.2, "openhat openhh openhihat hatopen ohh= ophat");
  rl_add(4, 0.7, "oh= open=");
  rl_add(4, 0.3, "hihat hihats hat= hats= hh= highhat");
  rl_add(5, 1.0, "cymbal cymbals crash ride china splash cym= crsh=");
  rl_add(6, 1.0, "tom= toms= floortom hitom lotom midtom lowtom hightom tomtom");
  rl_add(7, 1.0, "perc percs percussion conga congas bongo bongos shaker shakers tambourine tamb= cowbell clave claves");
  rl_add(7, 1.0, "woodblock triangle cabasa guiro timbale timbales rim= rims= rimshot sidestick djembe tabla agogo");
  rl_add(8, 1.0, "drumloop drumloops breakbeat breaks= break= drumbeat");
  rl_add(8, 0.6, "beat= beats= groove grooves fill= fills= toploop toploops");
  rl_add(8, 0.3, "drum= drums=");
  rl_add(9, 1.0, "percloop percloops percussionloop shakerloop toploop");
  rl_add(10, 1.0, "bass= basses= bassline basslines subbass reese bassloop");
  rl_add(10, 0.7, "sub= subs=");
  rl_add(11, 1.0, "keys= piano pianos organ organs epiano ep= keyboard celesta");
  rl_add(11, 1.0, "marimba vibraphone vibes= kalimba harpsichord");
  rl_add(11, 0.5, "bell= bells= chord= chords=");
  rl_add(12, 1.0, "synth synths lead= leads= pluck plucks arp= arps= stab= stabs= seq= sequence supersaw");
  rl_add(12, 0.4, "chord= chords=");
  rl_add(13, 1.0, "pad= pads= atmos atmosphere ambient texture textures drone drones");
  rl_add(14, 1.0, "guitar guitars gtr= strum strums acoustic=");
  rl_add(14, 0.4, "riff= riffs=");
  rl_add(15, 1.0, "strings= string= violin violins viola cello cellos orchestral pizz= pizzicato harp= ensemble");
  rl_add(16, 1.0, "brass horn= horns= trumpet trumpets trombone sax= saxophone tuba flute flutes woodwind woodwinds clarinet");
  rl_add(17, 1.0, "vocal vocals vox= voice voices chant chants acapella adlib adlibs choir phrase= phrases=");
  rl_add(18, 1.0, "fx= sfx= riser risers sweep sweeps impact impacts downlifter uplifter whoosh foley transition glitch noise=");
  NLW = wl_add(LWH, "loop loops lp bpm drumloop drumloops percloop percloops toploop toploops groove grooves break breaks breakbeat bassline basslines bassloop beat beats fill fills phrase phrases arp arps seq sequence riff riffs");
  NOW = wl_add(OWH, "oneshot oneshots hit hits shot shots single singles os");
  H_BPM = hstr("bpm");
);

function tok_level(a, b) local(i, c, k, pcl, cl, h, t, j) (
  NT = 0; pcl = 0; str_setlen(#sq, max(b - a, 0)); k = 0; i = a;
  while (i < b) (
    c = PCH[i];
    cl = !isalnum(c) ? 0 : isdig(c) ? 1 : c >= 65 && c <= 90 ? 3 : 2;
    cl > 0 ? ( str_setchar(#sq, k, c, 'cu'); k += 1; );
    cl == 0 || pcl == 0 || (cl == 1) != (pcl == 1) || (pcl == 2 && cl == 3) ? (
      NT > 0 && T_E[NT - 1] < 0 ? T_E[NT - 1] = i;
      cl > 0 && NT < 48 ? ( T_S[NT] = i; T_E[NT] = -1; NT += 1; );
    );
    pcl = cl; i += 1;
  );
  NT > 0 && T_E[NT - 1] < 0 ? T_E[NT - 1] = b;
  str_setlen(#sq, k);
  t = 0;
  loop(NT,
    h = 0; j = T_S[t]; loop(T_E[t] - T_S[t], h = hmix(h, lc(PCH[j])); j += 1; ); T_H[t] = h;
    t += 1;
  );
  t = 0;
  loop(NT - 1, h = T_H[t]; j = T_S[t + 1]; loop(T_E[t + 1] - T_S[t + 1], h = hmix(h, lc(PCH[j])); j += 1; ); T_B[t] = h; t += 1; );
  NT > 0 ? T_B[NT - 1] = -1;
);
function in_list(lst, n, h) local(i, f) ( f = 0; i = 0; loop(n, lst[i] == h ? f = 1; i += 1; ); f; );
function sc_level(a, b, lw) local(r, t, hit, c, i) (
  tok_level(a, b);
  memset(LSC, 0, NC);
  r = 0;
  loop(NR,
    hit = 0;
    R_X[r] ? ( t = 0; while (!hit && t < NT) ( (T_H[t] == R_H[r] || T_B[t] == R_H[r]) ? hit = 1; t += 1; ); )
           : ( strlen(#sq) ? hit = matchi(500 + r, #sq); );
    hit ? ( c = R_C[r]; LSC[c] = max(LSC[c], R_W[r]); );
    r += 1;
  );
  t = 0;
  loop(NT,
    (in_list(LWH, NLW, T_H[t]) || in_list(LWH, NLW, T_B[t])) ? lpev += lw;
    in_list(OWH, NOW, T_H[t]) ? lpev -= lw;
    t += 1;
  );
  i = 0; loop(NC, CS[i] += LSC[i] * lw; i += 1; );
);
function tok_num(t) local(v, j) ( v = 0; j = T_S[t]; loop(T_E[t] - T_S[t], v = v * 10 + PCH[j] - 48; j += 1; ); v; );
function tok_isnum(t) ( isdig(PCH[T_S[t]]); );
function parse_notes(a, b) local(i, c, st, e, semi, k, n, oct, neg, ok, prevkey) (
  knote = -1; kkey = 0; i = a; prevkey = 0;
  while (i < b) (
    while (i < b && ((c = PCH[i]) == 32 || c == 95 || c == 45 || c == 46 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44)) ( i += 1; );
    st = i;
    while (i < b && !((c = PCH[i]) == 32 || c == 95 || c == 45 || c == 46 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44)) ( i += 1; );
    e = i;
    e > st ? (
      c = lc(PCH[st]);
      c >= 97 && c <= 103 ? (
        semi = c == 97 ? 9 : c == 98 ? 11 : c == 99 ? 0 : c == 100 ? 2 : c == 101 ? 4 : c == 102 ? 5 : 7;
        k = st + 1;
        k < e && PCH[k] == 35 ? ( semi += 1; k += 1; ) : k < e && PCH[k] == 98 ? ( semi -= 1; k += 1; );
        semi = (semi + 12) % 12;
        n = e - k;
        n == 0 ? ( prevkey ? kkey = semi + 1; ) :
        n == 1 && lc(PCH[k]) == 109 ? kkey = semi + 13 :
        n == 3 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 105 && lc(PCH[k + 2]) == 110 ? kkey = semi + 13 :
        n == 5 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 105 && lc(PCH[k + 2]) == 110 ? kkey = semi + 13 :
        n == 3 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 97 && lc(PCH[k + 2]) == 106 ? kkey = semi + 1 :
        n == 5 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 97 && lc(PCH[k + 2]) == 106 ? kkey = semi + 1 :
        n <= 2 && e - st >= 2 ? (
          ok = 1; neg = 0; oct = 0;
          PCH[k] == 45 ? ( neg = 1; k += 1; n -= 1; );
          n == 0 ? ok = 0;
          loop(n, isdig(PCH[k]) ? oct = oct * 10 + PCH[k] - 48 : ok = 0; k += 1; );
          ok ? ( oct = neg ? -oct : oct; (oct + 2) * 12 + semi >= 0 && (oct + 2) * 12 + semi < 128 ? knote = (oct + 2) * 12 + semi; );
        );
      );
      prevkey = e - st == 3 && lc(PCH[st]) == 107 && lc(PCH[st + 1]) == 101 && lc(PCH[st + 2]) == 121;
    );
  );
);
function bestof(lo, hi) local(c, bs) ( bs = 0; bcls = 19; c = lo; loop(hi - lo + 1, CS2[c] > bs ? ( bs = CS2[c]; bcls = c; ); c += 1; ); bs; );
function classify(i) local(o, nst, ext, rst, b, a, lw, t, v, inst, drumkw, fxkw, perckw, drum, perc, bs, ss, c, best, lpe) (
  o = L_OFF[i]; nst = L_NST[i]; ext = L_EXT[i]; rst = L_RST[i];
  memset(CS, 0, NC); lpev = 0; kbpm = 0;
  sc_level(o + nst, o + ext, 1);
  t = 0;
  loop(NT,
    T_H[t] == H_BPM ? (
      t > 0 && tok_isnum(t - 1) && (v = tok_num(t - 1)) >= 40 && v <= 300 ? kbpm = v :
      t < NT - 1 && tok_isnum(t + 1) && (v = tok_num(t + 1)) >= 40 && v <= 300 ? kbpm = v;
    );
    t += 1;
  );
  ntok_stem = NT; t = 0; loop(NT, T_S[48 + t] = T_S[t]; T_E[48 + t] = T_E[t]; t += 1; );
  parse_notes(o + nst, o + ext);
  lw = 0.7; b = nst - 1;
  while (b > rst) (
    a = b; while (a > rst && !issep(PCH[o + a - 1])) ( a -= 1; );
    sc_level(o + a, o + b, lw);
    lw = max(0.15, lw * 0.7); b = a - 1;
  );
  kbpm == 0 && lpev > 0 ? (
    t = 0;
    loop(ntok_stem,
      kbpm == 0 && isdig(PCH[T_S[48 + t]]) && T_E[48 + t] - T_S[48 + t] >= 2 && T_E[48 + t] - T_S[48 + t] <= 3 ? (
        v = 0; a = T_S[48 + t]; loop(T_E[48 + t] - a, v = v * 10 + PCH[a] - 48; a += 1; );
        v >= 70 && v <= 190 ? kbpm = v;
      );
      t += 1;
    );
  );
  lpe = min(max(lpev, -2), 2) + (kbpm > 0 ? 0.7 : 0);
  L_KIND[i] = lpe > 0;
  c = 0; loop(NC, CS2[c] = min(2, CS[c]); c += 1; );
  ss = 0;
  L_KIND[i] ? (
    inst = bestof(10, 17); best = bcls;
    drumkw = CS[8] + CS[9]; c = 0; loop(8, drumkw += CS[c]; c += 1; );
    fxkw = CS[18];
    fxkw > inst && fxkw > drumkw ? ( best = 18; bs = fxkw; ) :
    inst > 0.5 && inst > drumkw ? ( bs = inst; ) : (
      perckw = CS[9] + CS[7] + 0.5 * (CS[3] + CS[4]);
      drum = CS2[8] + CS[0] + CS[1];
      perc = CS2[9] + perckw;
      best = perc > drum ? 9 : 8; bs = max(perc, drum); ss = min(perc, drum);
    );
  ) : (
    CS2[8] = CS2[9] = 0;
    bs = bestof(0, 18); best = bcls;
    c = 0; loop(19, c != best ? ss = max(ss, CS2[c]); c += 1; );
  );
  bs <= 0.05 ? best = 19;
  L_ACAT[i] = L_CAT[i] = best;
  L_CONF[i] = best == 19 ? 0 : min(1, max(0, 0.5 * (bs > 0 ? (bs - ss) / bs : 0) + 0.5 * min(1, bs / 1.2)));
  L_BPM[i] = kbpm; L_NOTE[i] = knote; L_KEY[i] = kkey;
);

function lib_open() (
  lib_h >= 0 ? file_close(lib_h);
  NL = 0; pch_n = 0; root_len = 0; nfold = 0; NKIT = 0; srt_i = 0; NROOT = 0;
  lib_h = file_open("gfx-smart-sampler/library.txt");
  lib_h >= 0 ? ( file_text(lib_h); lib_st = 1; ) : lib_st = -1;
);
function lib_read(tmax) local(len, c, k, o, nst, ext, d, same, j, h1, h2) (
  while (lib_st == 1 && time_precise() < tmax) (
    file_string(lib_h, #wln) > 0 ? (
      len = strlen(#wln);
      while (len > 0 && ((c = str_getchar(#wln, len - 1, 'cu')) == 10 || c == 13 || c == 32)) ( len -= 1; );
