desc:Bass 1X Mini [bass synth] (GFX Lab)
//tags: instrument synth bass mono acid reese mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-voice, gfx-lab-warmup, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-os, gfx-lab-power (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc

slider1:0<0,1,1{Saw,Pulse}>-Osc 1 wave
slider2:50<5,95,1>-Pulse width (%)
slider3:0<0,100,1>-Sub level (%)
slider4:0<0,1,1{-1 oct,-2 oct}>-Sub octave
slider5:0<0,100,1>-Osc 2 level (%)
slider6:0<0,50,0.1>-Osc 2 detune (cents)
slider7:1<0,2,1{-1 oct,0,+1 oct}>-Osc 2 octave
slider8:0<0,100,1>-Unison (%)
slider9:0<0,100,1>-Noise (%)
slider10:1<0,2,1{Ladder,Acid,12 dB}>-Filter type
slider11:300<20,18000,1>-Cutoff (Hz)
slider12:80<0,100,1>-Resonance (%)
slider13:70<0,100,1>-Env amount (%)
slider14:30<0,100,1>-Key track (%)
slider15:1<0.5,3000,0.1>-Filter attack (ms)
slider16:250<5,5000,1>-Filter decay (ms)
slider17:0<0,100,1>-Filter sustain (%)
slider18:150<5,5000,1>-Filter release (ms)
slider19:1<0.5,3000,0.1>-Amp attack (ms)
slider20:400<5,5000,1>-Amp decay (ms)
slider21:70<0,100,1>-Amp sustain (%)
slider22:40<5,5000,1>-Amp release (ms)
slider23:70<0,100,1>-Accent (%)
slider24:60<0,1000,1>-Glide (ms)
slider25:1<0,1,1{Always,Legato}>-Glide mode
slider26:40<0,100,1>-Velocity (%)
slider27:4<0.01,20,0.01>-LFO rate (Hz)
slider28:0<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO shape
slider29:0<0,100,1>-LFO to pitch (cents)
slider30:0<0,100,1>-LFO to cutoff (%)
slider31:0<0,100,1>-LFO to PWM (%)
slider32:25<0,100,1>-Drift (%)
slider33:15<0,100,1>-Drive (%)
slider34:-4.9<-24,6,0.1>-Volume (dB)
slider35:0<0,2,1{1x,2x,4x}>-Oversampling
slider36:0<0,100,1>-Band sat (%)
slider37:30<0,100,1>-Bias (%)
slider38:120<40,400,1>-Sat low band (Hz)
slider39:6000<2000,16000,10>-Sat high band (Hz)
slider40:-0.3<-24,0,0.1>-Ceiling (dB)
slider41:0<0,100,1>-Width (%)
slider42:1<0,1,1{Off,On}>-Sub+ (on; the dial at 0 = off)
slider43:0<0,100,1>-Sub+ sub level (%)
slider44:0<0,100,1>-Sub+ upper harmonics (%)
slider45:prs_sel=0<0,12,1{No preset,Mono Acid,Mono Sub,Mono PWM,Ladder Fat,Ladder Pluck,Ladder Glide,Wide Reese,Wide Growl,Sine Sub,Synth Pop,Zap Bass,Wobble}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-bass-1x-mini";
ext_noinit = 1;
NW = 1200;
HN = 1000; hcount = 0;
SN = 1300;
memset(HN, 0, 128); memset(SN, 0, 128);
sustain = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
ins_drift_init();
fl_ok = 0;
bend = 1; nd_mul = 1; cur = 48; tgt = 48; vel = 0.8; acc = 0; gate = 0;
fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0);
sm = vo_coef(30);
fd_in = 1; fd_st = 1 / (0.002 * srate);
vg_k = 1 - exp(-1 / (0.004 * srate));
vg_s = 1; ac_s = 0;
dxp = dyp = 0;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
pn_dirty = 0;

os_design(); os_base = 0; os_f = os_tf = os_f2n(slider35);
os_gsetup();

pwr_init(); pwr_hum_db = -78; pwr_sag = 0.2; pwr_rip = 0.003;
pwr_wu_loss = 0.6; pwr_wu_drv = 0.8; pwr_wu_lp = 9000; pwr_wu_wob = 0.2; pwr_bloom = 0;

function pv(i, v) ( slider(i) = v; );
function setosc(w, pw, sb, so, o2, dt, o2o, un, nz) (
  pv(1, w); pv(2, pw); pv(3, sb); pv(4, so); pv(5, o2); pv(6, dt); pv(7, o2o); pv(8, un); pv(9, nz);
);
function setflt(t, c, r, e, k) ( pv(10, t); pv(11, c); pv(12, r); pv(13, e); pv(14, k); );
function setfenv(a, d, s, r) ( pv(15, a); pv(16, d); pv(17, s); pv(18, r); );
function setaenv(a, d, s, r) ( pv(19, a); pv(20, d); pv(21, s); pv(22, r); );
function setperf(ac, gl, gm, vl) ( pv(23, ac); pv(24, gl); pv(25, gm); pv(26, vl); );
function setlfo(rt, sh, lp, lc, lw) ( pv(27, rt); pv(28, sh); pv(29, lp); pv(30, lc); pv(31, lw); );
function sl_list() local(i) ( i = 1; loop(44, slider_automate(2 ^ (i - 1)); i += 1; ); );
function load_preset(n) local(p) (
  p = n - 1;
  pv(32, 25); pv(33, 15); pv(34, p == 0 ? -4.9 : p == 1 ? -10.7 : p == 2 ? -9.3 : p == 3 ? -6.2 : p == 4 ? 0 : p == 5 ? -5.9 : p == 6 ? -10.3 :
    p == 7 ? -7.4 : p == 8 ? -11.1 : p == 9 ? -7.1 : p == 10 ? -3.3 : -8);
  pv(36, 0); pv(41, p == 6 ? 50 : p == 7 ? 40 : 0); pv(37, 30); pv(38, 120); pv(39, 6000); pv(40, -0.3); pv(42, 1); pv(43, 0); pv(44, 0);
  p == 0 ? ( setosc(0,50,0,0,0,0,1,0,0);    setflt(1,300,80,70,30);  setfenv(1,250,0,150);   setaenv(1,400,70,40);    setperf(70,60,1,40); setlfo(4,0,0,0,0); ) :
  p == 1 ? ( setosc(1,40,70,0,0,0,1,0,0);   setflt(1,600,20,30,40);  setfenv(1,300,20,100);  setaenv(1,500,80,60);    setperf(30,0,1,30);  setlfo(4,0,0,0,0); ) :
  p == 2 ? ( setosc(1,50,40,0,0,0,1,0,0);   setflt(1,900,30,30,40);  setfenv(5,400,30,150);  setaenv(2,600,80,120);   setperf(20,40,1,30); setlfo(0.8,1,0,0,45); ) :
  p == 3 ? ( setosc(0,50,30,0,80,8,1,0,0);  setflt(0,500,30,45,30);  setfenv(2,500,30,200);  setaenv(2,600,90,150);   setperf(20,30,1,40); setlfo(4,0,0,0,0); ) :
  p == 4 ? ( setosc(0,50,40,0,80,5,1,0,0);  setflt(0,300,40,75,40);  setfenv(1,220,0,120);   setaenv(1,500,0,150);    setperf(30,0,0,50);  setlfo(4,0,0,0,0); ) :
  p == 5 ? ( setosc(0,50,0,0,90,12,2,0,0);  setflt(0,1200,35,40,40); setfenv(5,700,40,200);  setaenv(2,800,90,200);   setperf(20,90,1,30); setlfo(5,0,8,0,0); ) :
  p == 6 ? ( setosc(0,50,25,0,60,22,1,60,0); setflt(2,700,25,15,20); setfenv(10,800,60,300); setaenv(5,800,100,250);  setperf(10,20,1,30); setlfo(0.3,0,0,15,0); ) :
  p == 7 ? ( setosc(0,50,20,0,70,15,1,50,5); setflt(0,400,55,40,30); setfenv(5,300,20,200);  setaenv(2,500,90,150);   setperf(20,10,1,40); setlfo(3,1,0,40,0); ) :
  p == 8 ? ( setosc(1,50,75,0,0,0,1,0,0);   setflt(2,250,0,0,0);     setfenv(1,100,100,100); setaenv(3,200,100,80);   setperf(0,0,1,20);   setlfo(4,0,0,0,0); ) :
  p == 9 ? ( setosc(1,30,30,0,60,7,1,0,0);  setflt(1,1500,30,40,50); setfenv(1,300,20,150);  setaenv(1,400,60,100);   setperf(30,0,0,40);  setlfo(4,0,0,0,0); ) :
  p == 10 ? ( setosc(0,50,30,0,0,0,1,0,0);  setflt(1,200,60,100,30); setfenv(1,90,0,60);     setaenv(1,250,50,60);    setperf(40,0,0,50);  setlfo(4,0,0,0,0); ) :
            ( setosc(0,50,30,0,80,10,1,30,0); setflt(0,500,50,20,30); setfenv(10,500,50,300); setaenv(2,500,100,200); setperf(10,30,1,30); setlfo(3,0,0,70,0); );
  sl_list();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(44, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

function all_off() (
  hcount = 0; memset(SN, 0, 128);
  fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0); gate = 0;
);
function note_on(n, v) local(i, f, legato) (
  SN[n] = 0;
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  tgt = n; vel = v / 127;
  !legato ? nd_mul = ins_note_detune();
  acc = accent * max(vel - 0.5, 0) * 2;
  glide_on = glide_ms > 0 && (glide_mode == 0 || legato);
  !glide_on ? cur = n;
  fenv.vo_adsr_gate(1, !legato); aenv.vo_adsr_gate(1, !legato);
  !legato ? ( fd_a0 = amp_l; fd_in = 0; );
  !legato && aenv.lv < 0.05 ? ( o1.vo_reset(0); sub.vo_reset(0); o2.vo_reset(0); u1.vo_reset(0); u2.vo_reset(0); nw_start(NW); );
  aenv.lv < 0.001 ? ( vg_s = 1 - velsens + velsens * vel; ac_s = acc; );
  gate = 1;
);
function note_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? ( tgt = HN[hcount - 1]; glide_on = glide_ms > 0; !glide_on ? cur = tgt; ) :
             ( fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0); gate = 0; );
  ) : hcount == 0 ? ( fenv.vo_adsr_gate(0, 0); aenv.vo_adsr_gate(0, 0); gate = 0; );
);
function key_up(n) ( sustain ? SN[n] = 1 : note_off(n); );
function pedal_up() local(n) (
  n = 0; loop(128, SN[n] ? ( SN[n] = 0; note_off(n); ); n += 1; );
);

function update() (
  wave_t = slider1; pw = slider2 / 100; sub_l = slider3 / 100; sub_div = slider4 ? 4 : 2;
  o2_l = slider5 / 100; o2_det = 2 ^ (slider6 / 1200); o2_oct = 2 ^ (slider7 - 1);
  uni = slider8 / 100; uni_l = min(uni * 4, 1) * 0.6; uni_dt = 2 ^ (uni * 30 / 1200);
  noise_l = slider9 / 100 * 0.5;
  ftype_t = slider10; cutoff = slider11; res = slider12 / 100; envamt = slider13 / 100; keytr = slider14 / 100;
  fl_lc = log(cutoff);
  fenv.vo_adsr_set(slider15, slider16, slider17 / 100, slider18);
  aenv.vo_adsr_set(slider19, slider20, slider21 / 100, slider22);
  accent = slider23 / 100;
  glide_ms = slider24; glide_mode = slider25; glide_c = slider24 > 0 ? vo_coef(slider24) : 1;
  velsens = slider26 / 100;
  lfo_rate = slider27; lfo_shape = slider28; lfo_p = slider29; lfo_c = slider30 / 100; lfo_w = slider31 / 100;
  drift = slider32 / 100;
  drv = slider33 / 100; drv_g = 1 + 6 * drv * drv; drv_b = 0.05 * drv; drv_h = 2.5 - 1.7 * drv;
  t1 = exp(2 * (drv_g * 0.15 / drv_h + drv_b)); t2 = exp(2 * drv_b);
  drv_n = 0.15 / ((t1 - 1) / (t1 + 1) - (t2 - 1) / (t2 + 1));
  drv_z = (t2 - 1) / (t2 + 1);
  vol_t = 10 ^ (slider34 / 20);
  ins_output_setup(36);
  sp_on = slider42; sp_sub = slider43 / 100; sp_up = slider44 / 100;
  sp_lc = 1 - exp(-2 * $pi * 5000 / srate);
  wd_t = slider41 / 100;
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
);
function drive(x) local(e1) (
  e1 = exp(2 * min(max(drv_g * x / drv_h + drv_b, -20), 20));
  ((e1 - 1) / (e1 + 1) - drv_z) * drv_n;
);
function gap_clear() (
  all_off(); sustain = 0;
  aenv.st = aenv.lv = fenv.st = fenv.lv = 0;
  flt.s1 = flt.s2 = flt.s3 = flt.s4 = 0; flt.ic1 = flt.ic2 = 0;
  memset(NW, 0, 4); memset(WB, 0, WBN); wd_h1 = wd_h2 = wd_x1 = wd_x2 = 0;
  sp_lp = 0; dxp = dyp = 0; amp_l = 0; fd_in = 1;
  OSU.os_clr(); OSD.os_clr();
);
update();
vol_s = vol_t;
WB = 8000; WBN = 8192; memset(WB, 0, WBN); wd_p = 0;
wd_n = floor(0.011 * srate + 0.5); wd_hc = exp(-2 * $pi * 250 / srate); wd_s = wd_t;
s_sub = sub_l; s_o2 = o2_l; s_uni = uni_l; s_nz = noise_l; s_pw = pw;
wave_c = wave_t; ftype_c = ftype_t; dk = 1;
sw_k = 1 - exp(-1 / (0.01 * srate)); dk_st = 1 / (0.004 * srate);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
prs_chk();
update();
os_snap(slider(35));

@block
prs_chk();
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
update();
os_tf = os_f2n(slider35);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
pwr_block(1);
fl_k = 1 - exp(-1 / (0.015 * srate));
!fl_ok ? ( fl_c1 = fl_c2 = fl_lc; fl_rs = res; fl_ev = envamt; fl_ok = 1; );
pn_dirty ? ( pn_dirty = 0; all_off(); sustain = 0; );
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? ( note_on(m2, m3); ins_midi_hit(); ) :
  st == 0x80 || (st == 0x90 && m3 == 0) ? key_up(m2) :
  st == 0xB0 && m2 == 64 ? ( sus_n = m3 >= 64; sustain && !sus_n ? ( sustain = 0; pedal_up(); ); sustain = sus_n; ) :
  st == 0xB0 && (m2 == 123 || m2 == 120) ? ( all_off(); sustain = 0; ) :
  st == 0xE0 ? bend = ins_bend(m2, m3, 2);
  midisend(mofs, m1, m2, m3);
);
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( all_off(); sustain = 0; );
gfx_pst_prev = gfx_pst;
ins_drift_block(drift, samplesblock);
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(slider(35));

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
os_gate();
os_chg ? ( OSU.os_clr(); OSD.os_clr(); );
cur += (tgt - cur) * glide_c;
s_sub += (sub_l - s_sub) * sw_k; s_o2 += (o2_l - s_o2) * sw_k; s_uni += (uni_l - s_uni) * sw_k;
s_nz += (noise_l - s_nz) * sw_k; s_pw += (pw - s_pw) * sw_k;
s_sub < 0.00001 && sub_l == 0 ? s_sub = 0; s_o2 < 0.00001 && o2_l == 0 ? s_o2 = 0;
s_uni < 0.00001 && uni_l == 0 ? s_uni = 0; s_nz < 0.00001 && noise_l == 0 ? s_nz = 0;
wave_t != wave_c || ftype_t != ftype_c ? (
  dk = max(dk - dk_st, 0);
  dk == 0 ? (
    ftype_t != ftype_c ? ( ftype_t == 2 ? ( flt.ic1 = flt.ic2 = 0; ) : ftype_c == 2 ? ( flt.s1 = flt.s2 = flt.s3 = flt.s4 = 0; ); );
    wave_c = wave_t; ftype_c = ftype_t;
  );
) : dk < 1 ? dk = min(dk + dk_st, 1);
lfo = lfo1.vo_lfo(lfo_rate, lfo_shape);
semi = cur + lfo * lfo_p / 100;
f1 = 440 * 2 ^ ((semi - 69) / 12) * bend * ins_pitch * nd_mul;
inc1 = min(f1 / srate, 0.45);

y = wave_c ? o1.vo_pulse(inc1, min(max(s_pw + lfo * lfo_w * 0.4 + ins_cut * 0.22, 0.05), 0.95)) : o1.vo_saw(inc1);
s_sub > 0 ? y += s_sub * sub.vo_sub(inc1, sub_div);
s_o2 > 0 ? y += s_o2 * o2.vo_saw(min(inc1 * o2_oct * o2_det * 2 ^ (ins_aux / 12), 0.45));
s_uni > 0 ? ( y += s_uni * (u1.vo_saw(inc1 * uni_dt) + u2.vo_saw(inc1 / uni_dt)); );
s_nz > 0 ? y += s_nz * (rand(2) - 1);
y *= 0.35;

fl_c1 += (fl_lc - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (res - fl_rs) * fl_k; fl_ev += (envamt - fl_ev) * fl_k;
vg_s += (1 - velsens + velsens * vel - vg_s) * vg_k; ac_s += (acc - ac_s) * vg_k;
fe = fenv.vo_adsr();
oct = (fl_ev + ac_s * 0.5) * fe * 7 + keytr * (cur - 48) / 12 + lfo * lfo_c * 3 + ins_cut;
fc = min(max(exp(fl_c2 + oct * 0.693147), 20), srate * 0.45);
y = ftype_c == 2 ? flt.vo_svf(y, fc, fl_rs) : flt.vo_ladder(y, fc, fl_rs, ftype_c);
dk < 1 ? y *= 0.5 - 0.5 * cos($pi * dk);
y = vo_tanh(y * 0.9) / 0.9;

ae = aenv.vo_adsr();
amp_g = ae * vg_s * (1 + ac_s * 0.6);
fd_in < 1 ? ( amp_g = fd_a0 + (amp_g - fd_a0) * (0.5 - 0.5 * cos($pi * fd_in)); fd_in = min(fd_in + fd_st, 1); );
amp_l = amp_g;
y *= amp_g;

sp_on ? (
  sp_ph += inc1 * 0.5; sp_ph -= floor(sp_ph);
  sp_r = abs(sin(4 * $pi * sp_ph)) - 0.63662;
  sp_lp += (sp_r - sp_lp) * sp_lc;
  y += (sin(2 * $pi * sp_ph) * sp_sub * 0.3 + sp_lp * sp_up * 0.6) * amp_g;
);

y = nw_run(NW, y);

pwr_in(y, y); y = pwr_l;
os_f == 1 ? (
  drv > 0.001 ? y = drive(y);
) : (
  OSU.os_up(y);
  drv > 0.001 ? (
    d0 = drive(OSU.s0); d1 = drive(OSU.s1);
    os_f > 2 ? ( d2 = drive(OSU.s2); d3 = drive(OSU.s3); );
  ) : ( d0 = OSU.s0; d1 = OSU.s1; d2 = OSU.s2; d3 = OSU.s3; );
  y = OSD.os_dn(d0, d1, d2, d3);
);
dy = y - dxp + 0.997 * dyp; dxp = y; dyp = dy; y = dy;
pwr_out(y, y); y = pwr_l;
os_g < 1 ? y *= os_g;

vol_s += (vol_t - vol_s) * sm;
wd_s += (wd_t - wd_s) * sw_k;
wd_s > 0.00001 || wd_t > 0 ? (
  wd_h1 = wd_hc * (wd_h1 + y - wd_x1); wd_x1 = y;
  wd_h2 = wd_hc * (wd_h2 + wd_h1 - wd_x2); wd_x2 = wd_h1;
  WB[wd_p] = wd_h2; wd_q = wd_p - wd_n; wd_q < 0 ? wd_q += WBN;
  wd_sd = WB[wd_q] * wd_s * 0.7; wd_p = (wd_p + 1) % WBN;
) : ( wd_s = 0; wd_sd = 0; );
oL = ostL.ost_band(y + wd_sd) * vol_s;
oR = ostR.ost_band(y - wd_sd) * vol_s;
ost_out(oL, oR);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
