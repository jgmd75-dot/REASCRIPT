desc:Whirl Mini [vibe and rotary] (GFX Lab)
//tags: modulation vibe rotary speaker chorus vibrato organ mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-clip, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider26:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,1,1{Off,On}>-Vibe in
slider3:1.2<0.01,12,0.01>-Vibe rate (Hz)
slider4:60<0,100,1>-Intensity (%)
slider5:75<0,100,1>-Throb (%)
slider6:0<0,1,1{Chorus,Vibrato}>-Vibe mode
slider7:0<0,1,1{Off,On}>-Stereo
slider8:1<0,1,1{Off,On}>-Rotor in
slider9:1<0,2,1{Stop,Slow,Fast}>-Speed
slider10:0.6<0.2,3,0.01>-Spin-up (s)
slider11:0<-6,6,0.1>-Balance (dB)
slider12:50<0,100,1>-Mics (%)
slider13:40<0,100,1>-Preamp (%)
slider14:20<0,100,1>-Drive (%)
slider15:70<0,100,1>-Width (%)
slider16:100<0,100,1>-Mix (%)
slider17:0<-24,24,0.1>-Output (dB)
slider18:50<0,100,1>-Drift (%)
slider19:0<0,2,1{1x,2x,4x}>-Oversampling
slider20:0.83<0.3,1.5,0.01>-Horn slow (Hz)
slider21:6.75<4,8,0.01>-Horn fast (Hz)
slider22:0.67<0.2,1.5,0.01>-Drum slow (Hz)
slider23:5.8<3.5,7.5,0.01>-Drum fast (Hz)
slider24:prs_sel=0<0,9,1{No preset,Init,Classic Cabinet,Slow Throb,Stereo Vibe,Vibrato,Gospel Scream,Soul Jazz Trio,Guitar Swirl,Room Mics}>-Preset
slider25:0<0,100,1>-Autopan (%)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(67108863, v); );
function psw_allg(v) ( slider_show(67108863, v); );
#ui_man = "gfx-lab-whirl-mini";
ext_noinit = 1;

function wh_tcf(ms, fs) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * fs)); );
function wh_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );

function wh_pre(x) instance(lp1, lp2) local(y) (
  lp1 += (x - lp1) * wh_plsc;
  y = x + wh_pshk * lp1;
  y = y + wh_pwet * (ost_curve(y, wh_pd, wh_pb) - y);
  lp2 += (y - lp2) * wh_ptc;
  lp2;
);
function wh_prz() instance(lp1, lp2) ( lp1 = lp2 = 0; );

function wh_lamp(u) instance(bulb, ldr) (
  bulb += (u - bulb) * (u > bulb ? wh_lh : wh_lc);
  ldr += (bulb - ldr) * (bulb > ldr ? wh_lf : wh_ls);
  ldr;
);

function wh_v4(x, a1, a2, a3, a4) instance(s1x, s1y, s2x, s2y, s3x, s3y, s4x, s4y) local(y) (
  y = a1 * x + s1x - a1 * s1y; s1x = x; s1y = y; x = y;
  y = a2 * x + s2x - a2 * s2y; s2x = x; s2y = y; x = y;
  y = a3 * x + s3x - a3 * s3y; s3x = x; s3y = y; x = y;
  y = a4 * x + s4x - a4 * s4y; s4x = x; s4y = y;
  y;
);
function wh_v4z() instance(s1x, s1y, s2x, s2y, s3x, s3y, s4x, s4y) ( s1x = s1y = s2x = s2y = s3x = s3y = s4x = s4y = 0; );

function wh_apc(f) local(t) (
  t = tan($pi * min(max(f, 10), wh_fs * 0.45) / wh_fs);
  (t - 1) / (t + 1);
);

function wh_aa(u) instance(u1, ad1, cv1, rd) local(a, e, ad, cv, d, y) (
  a = abs(u); e = exp(-2 * a);
  ad = a + log(1 + e); cv = (1 - e) / (1 + e); u < 0 ? cv = -cv;
  rd ? ( u1 = u; ad1 = ad; cv1 = cv; rd = 0; );
  d = u - u1;
  y = abs(d) > 0.00001 ? (ad - ad1) / d : ost_tanh(0.5 * (u + u1));
  y += 0.5 * (cv - cv1);
  u1 = u; ad1 = ad; cv1 = cv;
  y;
);

function wh_drv(x) instance(tl, dcx, dcy) local(y, z) (
  z = rv.clp_pf_run(x);
  wh_dv > 0 ? (
    y = (rv.wh_aa(wh_kg * z + wh_db) - wh_dt0) * wh_dk;
    dcy = y - dcx + wh_dcr * dcy; dcx = y; y = dcy;
    x += wh_dw * (y - x);
    tl += (x - tl) * wh_dlp; x = tl;
  ) : ( rv.rd = 1; tl = x; dcx = dcy = 0; );
  x;
);
function wh_drz() instance(tl, dcx, dcy) ( tl = dcx = dcy = 0; );

function wh_chain(l, r) local(a, b, k) (
  a = pL.wh_pre(l); b = pR.wh_pre(r);
  k = 0.5 + 0.5 * wh_vm;
  a = a + k * (vL.wh_v4(a, wh_a1l, wh_a2l, wh_a3l, wh_a4l) - a);
  b = b + k * (vR.wh_v4(b, wh_a1r, wh_a2r, wh_a3r, wh_a4r) - b);
  wh_ol = l + wh_vin * (a - l); wh_or = r + wh_vin * (b - r);
  wh_om = amp.wh_drv(0.5 * (wh_ol + wh_or));
);

function wh_bqlp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function wh_bqhp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function wh_bq(x, c0, c1, c2, d1, d2) instance(z1, z2) local(y) (
  y = c0 * x + z1;
  z1 = c1 * x - d1 * y + z2;
  z2 = c2 * x - d2 * y;
  y;
);
function wh_bqz() instance(z1, z2) ( z1 = z2 = 0; );

RB = 1048576; RM = 8191; RH = RB; RDR = RB + 8192;
function wh_rd(buf, d) local(p, i, f, x0, x1, x2, x3) (
  p = wh_wp - d; i = floor(p); f = p - i;
  x0 = buf[(i - 1) & RM]; x1 = buf[i & RM]; x2 = buf[(i + 1) & RM]; x3 = buf[(i + 2) & RM];
  (((0.5 * (x3 - x0) + 1.5 * (x1 - x2)) * f + (x0 - 2.5 * x1 + 2 * x2 - 0.5 * x3)) * f + 0.5 * (x2 - x0)) * f + x1;
);
function wh_htap(ang, extra) instance(y) local(c, s, a) (
  c = cos(ang);
  s = wh_rd(RH, wh_hb + extra - wh_hdop * c);
  a = wh_alo + (wh_ahi - wh_alo) * (0.5 + 0.5 * c);
  y += (s - y) * a;
  y * (1 - wh_ham * (0.5 - 0.5 * c));
);
function wh_dtap(ang) local(c) (
  c = cos(ang);
  wh_rd(RDR, wh_db0 - wh_ddop * c) * (1 - wh_dam * (0.5 - 0.5 * c));
);
function wh_htz() instance(y) ( y = 0; );

function wh_rotor(x) local(lo, hi) (
  lo = sl2.wh_bq(sl1.wh_bq(x, klp.b0, klp.b1, klp.b2, klp.a1, klp.a2), klp.b0, klp.b1, klp.b2, klp.a1, klp.a2);
  hi = sh2.wh_bq(sh1.wh_bq(x, khp.b0, khp.b1, khp.b2, khp.a1, khp.a2), khp.b0, khp.b1, khp.b2, khp.a1, khp.a2);
  RH[wh_wp] = hi; RDR[wh_wp] = lo;
  wh_thH += wh_wH; wh_thH >= 2 * $pi ? wh_thH -= 2 * $pi;
  wh_thD += wh_wD; wh_thD >= 2 * $pi ? wh_thD -= 2 * $pi;
  wh_rl = hL1.wh_htap(wh_thH + wh_spr, 0) + wh_hrf * hL2.wh_htap(wh_thH + wh_spr + $pi, wh_hrfd);
  wh_rr = hR1.wh_htap(wh_thH - wh_spr, 0) + wh_hrf * hR2.wh_htap(wh_thH - wh_spr + $pi, wh_hrfd);
  wh_rl = wh_rl * wh_hn * wh_hg + wh_dtap(wh_thD + wh_spr) * wh_dn * wh_dg;
  wh_rr = wh_rr * wh_hn * wh_hg + wh_dtap(wh_thD - wh_spr) * wh_dn * wh_dg;
  wh_wp = (wh_wp + 1) & RM;
);

function wh_coef() (
  wh_fs = srate * os_f;
  wh_plsc = wh_opk(250, wh_fs);
  wh_dcr = 1 - 2 * $pi * 5.6 / wh_fs;
  rv.clp_pf_cfg(40000, 6000, -1.5, 150); rv.clp_pf_reset();
  wh_pset = 1;
);
function wh_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); dnM.os_clr();
  pL.wh_prz(); pR.wh_prz(); vL.wh_v4z(); vR.wh_v4z(); amp.wh_drz(); rv.rd = 1; rv.clp_pf_reset();
  memset(RB, 0, 16384);
  sl1.wh_bqz(); sl2.wh_bqz(); sh1.wh_bqz(); sh2.wh_bqz();
  hL1.wh_htz(); hL2.wh_htz(); hR1.wh_htz(); hR2.wh_htz();
  wh_dxl = wh_dyl = wh_dxr = wh_dyr = 0; wh_exl = wh_eyl = wh_exr = wh_eyr = 0;
);
function wh_reset() ( wh_clear(); memset(BY_BUF, 0, 2 * BY_N); wh_fi = -2; );
function wh_srinit() (
  wh_sr = srate;
  c_kn = wh_tcf(30, srate); c_sw = wh_tcf(15, srate);
  wh_lh = 1 - exp(-1 / (0.015 * srate)); wh_lc = 1 - exp(-1 / (0.09 * srate));
  wh_lf = 1 - exp(-1 / (0.005 * srate)); wh_ls = 1 - exp(-1 / (0.05 * srate));
  wh_hb = 0.002 * srate; wh_db0 = 0.002 * srate;
  wh_hdop = 0.15 / 343 * srate; wh_ddop = 0.08 / 343 * srate; wh_hrfd = 0.0011 * srate;
  wh_alo = 1 - exp(-2 * $pi * 2500 / srate); wh_ahi = 1 - exp(-2 * $pi * 14000 / srate);
  klp.wh_bqlp(800); khp.wh_bqhp(800);
  wh_dc5 = 1 - 2 * $pi * 5 / srate;
  wh_fis = 1 / (0.01 * srate);
  ost_init(0);
  wh_coef(); wh_clear();
  wh_snap = 1;
);

PT = 6000000;
#wh_pm = "Init|Classic Cabinet|Slow Throb|Stereo Vibe|Vibrato|Gospel Scream|Soul Jazz Trio|Guitar Swirl|Room Mics";
function wh_w(a, b, c, d, e, f, g, h, i, j, k, m, n, o, p, q, r, s, t, u) (
  wh_q[0] = a; wh_q[1] = b; wh_q[2] = c; wh_q[3] = d; wh_q[4] = e; wh_q[5] = f; wh_q[6] = g; wh_q[7] = h; wh_q[8] = i; wh_q[9] = j;
  wh_q[10] = k; wh_q[11] = m; wh_q[12] = n; wh_q[13] = o; wh_q[14] = p; wh_q[15] = q; wh_q[16] = r; wh_q[17] = s; wh_q[18] = t; wh_q[19] = u;
  wh_q += 20;
);
wh_q = PT;
wh_w(1, 1.2, 60, 75, 0, 0, 1, 1, 0.6, 0, 50, 40, 20, 70, 100, 0, 0.83, 6.75, 0.67, 5.8);
wh_w(0, 2, 70, 70, 0, 0, 1, 1, 0.6, 0, 50, 40, 20, 70, 100, -2.5, 0.83, 6.75, 0.67, 5.8);
wh_w(1, 0.6, 85, 90, 0, 0, 0, 1, 0.6, 0, 50, 45, 20, 70, 100, 2.5, 0.83, 6.75, 0.67, 5.8);
wh_w(1, 1.5, 75, 70, 0, 1, 0, 1, 0.6, 0, 50, 40, 20, 70, 100, 2.2, 0.83, 6.75, 0.67, 5.8);
wh_w(1, 4.5, 50, 60, 1, 0, 0, 1, 0.6, 0, 50, 30, 20, 70, 100, -1.1, 0.83, 6.75, 0.67, 5.8);
wh_w(0, 2, 70, 70, 0, 0, 1, 2, 0.4, 2, 35, 40, 75, 80, 100, -2.3, 0.9, 7.2, 0.7, 6.3);
wh_w(0, 2, 70, 70, 0, 0, 1, 1, 0.5, 1, 40, 40, 40, 75, 100, -3.5, 0.8, 6.9, 0.66, 6.0);
wh_w(1, 3, 55, 65, 0, 0, 1, 1, 0.5, 4, 40, 50, 35, 60, 100, 0.4, 1.0, 6.8, 0.8, 5.8);
wh_w(0, 2, 70, 70, 0, 0, 1, 1, 0.6, 0, 95, 40, 20, 50, 100, -2.5, 0.83, 6.75, 0.67, 5.8);
function load_preset(p) local(i, q) (
  q = PT + (p >= 10 ? 0 : p - 1) * 20;
  i = 0; loop(16, slider(2 + i) = q[i]; i += 1; );
  i = 0; loop(4, slider(20 + i) = q[16 + i]; i += 1; );
  slider25 = 0;
  p >= 10 ? slider18 = 50;
  i = 2; loop(17, ui_auto(i); i += 1; ); i = 20; loop(4, ui_auto(i); i += 1; ); ui_auto(25);
  pr_cur = p >= 10 ? 1 : p;
);

os_design();
os_f = os_tf = os_f2n(slider19); os_base = 0;
wh_srinit();
os_gsetup();
pwr_init(); pwr_wu_loss = 1.2; pwr_wu_drv = 2.5; pwr_wu_lp = 6000; pwr_bloom = 0.25; pwr_sag = 0.2;
dzR.drift_init(0.8 + rand(1) * 0.5); dzI.drift_init(0.8 + rand(1) * 0.5); dzL.drift_init(0.8 + rand(1) * 0.5);
dzH.drift_init(0.8 + rand(1) * 0.5); dzD.drift_init(0.8 + rand(1) * 0.5);
drift_macro(50);
wh_thH = rand(6); wh_thD = rand(6);
wh_fi = 1; wh_pp = 0;
wh_rtH = slider9 >= 1.5 ? slider21 : slider9 >= 0.5 ? slider20 : 0;
wh_rtD = slider9 >= 1.5 ? slider23 : slider9 >= 0.5 ? slider22 : 0;
wh_dvs = slider14 / 100;
pdc_delay = os_lat(os_f);
by_setup(1);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(25, i != 24 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(slider(19));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != wh_sr ? wh_srinit();
wh_now = time_precise();
wh_tp > 0 && wh_now - wh_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > wh_gpp && play_position - wh_gpp < 4 * wh_gpd + 0.05) ? wh_reset();
wh_tp = wh_now; wh_gpp = play_position; wh_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider19); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
while (midirecv(wh_mo, wh_m1, wh_m2, wh_m3)) (
  (wh_m1 & 0xF0) == 0xB0 ? (
    wh_m2 == 1 ? (
      wh_ns = wh_m3 >= 64 ? 2 : 1;
      wh_ns != wh_mwl && slider9 >= 0.5 ? ( slider9 = wh_ns; slider_automate(2 ^ 8); );
      wh_mwl = wh_ns;
    );
    wh_m2 == 64 ? (
      wh_m3 >= 64 && !wh_pdl && slider9 >= 0.5 ? ( slider9 = slider9 >= 1.5 ? 1 : 2; slider_automate(2 ^ 8); );
      wh_pdl = wh_m3 >= 64;
    );
  );
  midisend(wh_mo, wh_m1, wh_m2, wh_m3);
);
drift_macro(slider18);
wh_n = samplesblock / srate;
wh_gr = dzR.drift_tick(0.25 * dm_s * wh_n); wh_gi = dzI.drift_tick(0.25 * dm_s * wh_n); wh_gl = dzL.drift_tick(0.25 * dm_s * wh_n);
wh_gh = dzH.drift_tick(0.25 * dm_s * wh_n); wh_gd = dzD.drift_tick(0.25 * dm_s * wh_n);
wh_rdf = 1 + 0.05 * dm_a * wh_gr;
wh_idr = min(0.1 * dm_a, 1); wh_ldr = min(0.1 * dm_a, 1);
wh_idf = 1 - wh_idr * (0.5 + 0.5 * wh_gi);
wh_dimt = 1 - wh_ldr * (0.5 + 0.5 * wh_gl);
wh_vint = slider2 >= 0.5;
wh_vrt = log(min(max(slider3, 0.01), 12));
wh_itt = min(max(slider4, 0), 100) / 100;
wh_tht = min(max(slider5, 0), 100) / 100;
wh_vmt = slider6 >= 0.5;
wh_sprt = slider7 >= 0.5 ? 0.25 : 0;
wh_rint = slider8 >= 0.5;
wh_p = min(max(slider13, 0), 100) / 100;
wh_pshk = 10 ^ (3 * wh_p / 20) - 1; wh_pd = 1 + 3 * wh_p; wh_pb = 0.15 * wh_p; wh_pwet = min(wh_p * 2, 1);
wh_ptc = wh_p > 0.001 ? wh_opk(18000 * (7000 / 18000) ^ wh_p, wh_fs) : 1;
wh_dvs += (min(max(slider14, 0), 100) / 100 - wh_dvs) * (1 - exp(-samplesblock / (0.02 * srate)));
abs(wh_dvs - slider14 / 100) < 0.0001 ? wh_dvs = slider14 / 100;
wh_dv = wh_dvs;
wh_kg = 1 + 15 * wh_dv * wh_dv; wh_db = 0.25 * wh_dv;
wh_dk = 1 / (1 - sqr(ost_tanh(wh_db))) / wh_kg ^ 0.75; wh_dt0 = ost_tanh(wh_db);
wh_dw = min(wh_dv * 3, 1);
wh_dlp = wh_opk(9000 - 4000 * wh_dv, wh_fs);
rv.clp_pf_block(wh_dv * wh_dv * wh_dv, wh_fs, samplesblock * os_f);
wh_bal = min(max(slider11, -6), 6);
wh_hgt = 10 ^ (max(wh_bal, 0) / 20) * 10 ^ (min(wh_bal, 0) / 40); wh_dgt = 10 ^ (-max(wh_bal, 0) / 40) * 10 ^ (-min(wh_bal, 0) / 20);
wh_dist = min(max(slider12, 0), 100) / 100;
wh_hamt = 0.8 - 0.4 * wh_dist; wh_damt = 0.4 - 0.2 * wh_dist; wh_hrft = 0.2 + 0.35 * wh_dist;
wh_sprt2 = min(max(slider15, 0), 100) / 100 * 0.5 * $pi;
wh_apt = min(max(slider25, 0), 100) / 100 * min(max(slider15, 0), 100) / 100;
wh_mxt = min(max(slider16, 0), 100) / 100;
wh_outt = 10 ^ (min(max(slider17, -24), 24) / 20);
wh_spd = slider9 >= 1.5 ? 2 : slider9 >= 0.5 ? 1 : 0;
wh_ha = max(slider10, 0.2); wh_da = wh_ha * 7.5;
wh_tgH = (wh_spd == 2 ? slider21 : wh_spd == 1 ? slider20 : 0) * (1 + 0.005 * dm_a * wh_gh);
wh_tgD = (wh_spd == 2 ? slider23 : wh_spd == 1 ? slider22 : 0) * (1 + 0.005 * dm_a * wh_gd);
wh_kH = 1 - exp(-samplesblock / (srate * wh_ha * (wh_tgH < wh_rtH ? 1.4 : 1)));
wh_kD = 1 - exp(-samplesblock / (srate * wh_da * (wh_tgD < wh_rtD ? 1.4 : 1)));
wh_rtH += (wh_tgH - wh_rtH) * wh_kH; wh_rtD += (wh_tgD - wh_rtD) * wh_kD;
wh_spd == 0 ? ( wh_rtH < 0.02 ? wh_rtH = 0; wh_rtD < 0.02 ? wh_rtD = 0; );
wh_wH = 2 * $pi * wh_rtH / srate; wh_wD = 2 * $pi * wh_rtD / srate;
wh_snap ? (
  wh_vin = wh_vint; wh_vr = wh_vrt; wh_it = wh_itt; wh_th = wh_tht; wh_vm = wh_vmt; wh_spv = wh_sprt; wh_rin = wh_rint;
  wh_hg = wh_hgt; wh_dg = wh_dgt; wh_ham = wh_hamt; wh_dam = wh_damt; wh_hrf = wh_hrft; wh_spr = wh_sprt2;
