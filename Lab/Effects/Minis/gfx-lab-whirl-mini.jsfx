wh_fb = 380 * 2 ^ (wh_de * (2 * wh_lr - 1));
wh_a1r = wh_apc(wh_fb * 0.313); wh_a2r = wh_apc(wh_fb * 0.0214); wh_a3r = wh_apc(wh_fb * 10); wh_a4r = wh_apc(wh_fb);
