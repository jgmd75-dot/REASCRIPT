@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
wh_xl = spl0; wh_xr = spl1;
wh_vin += (wh_vint - wh_vin) * c_sw; wh_rin += (wh_rint - wh_rin) * c_sw;
wh_vr += (wh_vrt - wh_vr) * c_kn; wh_it += (wh_itt - wh_it) * c_kn; wh_th += (wh_tht - wh_th) * c_kn;
wh_vm += (wh_vmt - wh_vm) * c_sw; wh_spv += (wh_sprt - wh_spv) * c_kn;
wh_hg += (wh_hgt - wh_hg) * c_kn; wh_dg += (wh_dgt - wh_dg) * c_kn;
wh_ham += (wh_hamt - wh_ham) * c_kn; wh_dam += (wh_damt - wh_dam) * c_kn; wh_hrf += (wh_hrft - wh_hrf) * c_kn;
