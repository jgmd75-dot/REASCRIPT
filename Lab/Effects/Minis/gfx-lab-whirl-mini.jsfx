wh_ul = 0.5 + 0.5 * sin(2 * $pi * wh_pp);
wh_q2 = wh_pp + wh_spv; wh_q2 >= 1 ? wh_q2 -= 1;
wh_ur = 0.5 + 0.5 * sin(2 * $pi * wh_q2);
