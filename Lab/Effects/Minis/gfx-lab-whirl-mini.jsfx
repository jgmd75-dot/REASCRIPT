abs(wh_xl) < 0.000000000000001 ? wh_xl = 0; abs(wh_xr) < 0.000000000000001 ? wh_xr = 0;
os_gate();
os_chg ? ( wh_clear(); wh_coef(); os_hold += 2 * samplesblock; );
uxL.os_up(wh_xl); uxR.os_up(wh_xr);
