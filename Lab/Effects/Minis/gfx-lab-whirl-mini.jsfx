wh_lr = ((1 - wh_th) * wh_ur + wh_th * lmR.wh_lamp(wh_ur)) * wh_dim;
wh_lgt = wh_ll;
wh_de = wh_it * wh_idf * 1.75;
wh_fb = 380 * 2 ^ (wh_de * (2 * wh_ll - 1));
