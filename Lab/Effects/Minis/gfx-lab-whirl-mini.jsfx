wh_pk_d = max(wh_pk_d, wh_pkm); wh_pkm = 0;
wh_lamp_d = wh_lgt; wh_hr_d = wh_rtH; wh_dr_d = wh_rtD; wh_ha_d = wh_thH; wh_da_d = wh_thD;
