@gfx 900 355
ui_begin(900, 355);
mk_face = 0x8A5A2E; mk_band = 0x1E1208; mk_ink = 0xF4EEE0; mk_tab = 0xFFD23C; mk_acc = 0xFFE07A;
mk_sub = 0x3A2214; mk_ink2 = 0xE2D6BE;
sc != mg_fsc ? (
