desc:Gate Mini [gate] (GFX Lab)
//tags: gate expander ducker dynamics sidechain midi mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-power, gfx-lab-bands, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider49:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Gate,Expander}>-Model
slider2:0<0,1,1{Normal,Duck}>-Function
slider3:0<0,1,1{Hard,Soft}>-Knee
slider4:0<0,1,1>-(unused, was Threshold)
slider5:0<0,1,1>-(unused, was Range)
slider6:2<1,10,0.1>-Ratio
slider7:0<0,1,1>-(unused, was Attack)
slider8:0<0,1,1>-(unused, was Hold)
slider9:0<0,1,1>-(unused, was Release)
slider10:4<0,20,0.1>-Hysteresis (dB)
slider11:0<0,10,0.1>-Lookahead (ms)
slider12:0<0,1,1{Internal,External 3/4}>-Key source
slider13:0<0,1,1{Off,On}>-MIDI trigger
slider14:0<0,2,1{Linked,Dual mono,Mid-side}>-Stereo
slider15:100<0,100,1>-Link (%)
slider16:20<20,5000,1>-Key HPF (Hz)
slider17:20000<100,20000,1>-Key LPF (Hz)
slider18:1000<100,10000,1>-Key focus (Hz)
slider19:0<-12,12,0.1>-Key focus gain (dB)
slider20:0<0,1,1{Off,On}>-Key listen
slider21:100<0,100,1>-Mix (%)
slider22:0<-24,12,0.1>-Output (dB)
slider23:50<0,100,1>-Drift (%)
slider24:0<0,1,1{Off,On}>-Bypass
slider25:0<0,1,1{2 bands,3 bands}>-Bands
slider26:150<40,1000,1>-Split low / mid (Hz)
slider27:3000<800,12000,1>-Split mid / high (Hz)
slider28:0<0,1,1{Shared,Own band}>-Band key
slider29:1<0,1,1{Off,On}>-Low band gate
slider30:1<0,1,1{Off,On}>-Mid band gate
slider31:1<0,1,1{Off,On}>-High band gate
slider32:0<0,3,1{Off,Low,Mid,High}>-Solo
slider33:-40<-80,0,0.1>-Low threshold (dB)
slider34:60<0,80,0.1>-Low range (dB)
slider35:150<5,4000,1>-Low release (ms)
slider36:-40<-80,0,0.1>-Mid threshold (dB)
slider37:60<0,80,0.1>-Mid range (dB)
slider38:150<5,4000,1>-Mid release (ms)
slider39:-40<-80,0,0.1>-High threshold (dB)
slider40:60<0,80,0.1>-High range (dB)
slider41:150<5,4000,1>-High release (ms)
slider42:0.5<0.01,100,0.01>-Low attack (ms)
slider43:50<0,2000,1>-Low hold (ms)
slider44:0.5<0.01,100,0.01>-Mid attack (ms)
slider45:50<0,2000,1>-Mid hold (ms)
slider46:0.5<0.01,100,0.01>-High attack (ms)
slider47:50<0,2000,1>-High hold (ms)
slider48:prs_sel=0<0,16,1{No preset,Init,Kick Tight,Snare Crack,Tom Cleanup,Hi-Hat Clean,Vocal Breath,Guitar Noise,Bass DI,Gentle Expander,Room Mic Tame,Dialogue Clean,Kick Duck (Ext Key),Voice-Over Duck (Ext Key),Gated Reverb 80s,MIDI Chop,Lookahead Drum}>-Preset

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bands.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(562949953421311, v); );
function psw_allg(v) ( slider_show(562949953421311, v); );
#ui_man = "gfx-lab-gate-mini";
ext_noinit = 1;

function gt_db2g(d) ( exp(d * 0.11512925465); );
function gt_g2db(g) ( 8.68588963807 * log(max(g, 0.00000001)); );
function gt_cms(t) ( 1 - exp(-1 / (max(0.000001, t) * srate)); );
function gt_softk(o, w) ( o <= -w * 0.5 ? 0 : o >= w * 0.5 ? o : (o + w * 0.5) * (o + w * 0.5) / (2 * w); );
function gt_smst(v) ( v = max(0, min(1, v)); v * v * (3 - 2 * v); );
function gt_bq(x, c, s) local(y) (
  y = c[0] * x + c[1] * s[0] + c[2] * s[1] - c[3] * s[2] - c[4] * s[3];
  s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y;
  y;
);
function gt_clp(c, f, q) local(w, cs, al, a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cs = cos(w); al = sin(w) / (2 * q); a0 = 1 + al;
  c[0] = (1 - cs) * 0.5 / a0; c[1] = (1 - cs) / a0; c[2] = c[0]; c[3] = -2 * cs / a0; c[4] = (1 - al) / a0;
);
function gt_chp(c, f, q) local(w, cs, al, a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cs = cos(w); al = sin(w) / (2 * q); a0 = 1 + al;
  c[0] = (1 + cs) * 0.5 / a0; c[1] = -(1 + cs) / a0; c[2] = c[0]; c[3] = -2 * cs / a0; c[4] = (1 - al) / a0;
);
function gt_cpk(c, f, g, q) local(amp, w, cs, al, a0) (
  amp = 10 ^ (g / 40); w = 2 * $pi * min(f, srate * 0.45) / srate; cs = cos(w); al = sin(w) / (2 * q); a0 = 1 + al / amp;
  c[0] = (1 + al * amp) / a0; c[1] = -2 * cs / a0; c[2] = (1 - al * amp) / a0; c[3] = -2 * cs / a0; c[4] = (1 - al / amp) / a0;
);
function gt_tgain(L, op) local(g, te, b) (
  gt_mdl == 0 ? (
    g = op ? 0 : (gt_knee ? -gt_rng * gt_smst((gt_thr - L) / 12) : -gt_rng);
  ) : (
    te = op ? gt_thr - gt_hy : gt_thr;
    b = te - L;
    g = -min(gt_rng, (gt_knee ? gt_softk(b, 10) : max(0, b)) * (gt_rat - 1));
  );
  gt_fnc ? g = -gt_rng - g;
  g;
);
function gt_env(r) instance(env) (
  env = r > env ? r : env * gt_drel;
  env < 0.0000000001 ? env = 0;
  env;
);
function gt_step(lv) instance(hl, hc, op, g, tg) local(above) (
  above = op ? (lv >= gt_thr - gt_hy) : (lv >= gt_thr);
  above ? ( op = 1; hc = gt_hold; hl = lv; ) : (
    hc > 0 ? hc -= 1 : ( op = 0; hl = lv; );
  );
  tg = gt_tgain(hl, op);
  tg > g ? g += (tg - g) * (gt_fnc ? gt_cr : gt_ca) : g += (tg - g) * (gt_fnc ? gt_ca : gt_cr);
  g;
);

GT_DLN = 4096;
GT_BA = 100000; GT_BB = GT_BA + GT_DLN;
GT_CH = GT_BB + GT_DLN; GT_CL = GT_CH + 8; GT_CP = GT_CL + 8;
GT_SH0 = GT_CP + 8; GT_SH1 = GT_SH0 + 4; GT_SL0 = GT_SH1 + 4; GT_SL1 = GT_SL0 + 4; GT_SP0 = GT_SL1 + 4; GT_SP1 = GT_SP0 + 4;
GT_MQ = GT_BA + 10000;

function gt_clear() (
  memset(GT_BA, 0, GT_DLN); memset(GT_BB, 0, GT_DLN); memset(GT_SH0, 0, 24);
  gt_x0 = gt_y0 = gt_x1 = gt_y1 = gt_x2 = gt_y2 = gt_x3 = gt_y3 = 0;
  dA.env = dB.env = 0;
  eA0.env = eA1.env = eA2.env = eB0.env = eB1.env = eB2.env = 0;
  gt_z0 = gt_tgain(-160, 0);
  gA0.hc = gA1.hc = gA2.hc = gB0.hc = gB1.hc = gB2.hc = 0;
  gA0.op = gA1.op = gA2.op = gB0.op = gB1.op = gB2.op = 0;
  gA0.hl = gA1.hl = gA2.hl = gB0.hl = gB1.hl = gB2.hl = -160;
  gA0.g = gA1.g = gA2.g = gB0.g = gB1.g = gB2.g = gt_z0;
  gA0.tg = gA1.tg = gA2.tg = gB0.tg = gB1.tg = gB2.tg = gt_z0;
  sA.bs_clear(); sB.bs_clear(); kA.bs_clear(); kB.bs_clear();
);

memset(GT_BA, 0, GT_DLN); memset(GT_BB, 0, GT_DLN); memset(GT_SH0, 0, 24);
gt_dr = 1 - 2 * $pi / srate;
gt_x0 = gt_y0 = gt_x1 = gt_y1 = gt_x2 = gt_y2 = gt_x3 = gt_y3 = 0;
gt_drel = exp(-1 / (0.015 * srate));
gt_dw = 0; gt_na = 0; gt_nb = 0;
gA0.g = gA1.g = gA2.g = gB0.g = gB1.g = gB2.g = 0;
gt_sw2 = 1 - exp(-1 / (0.012 * srate)); gt_xoc = 1 - exp(-16 / (0.03 * srate));
function gt_bset() (
  gt_three = slider25 >= 0.5; gt_own = slider28 >= 0.5;
  gt_x1t = log(min(max(slider26, 40), 1000)); gt_x2t = log(max(min(max(slider27, 800), 12000), exp(gt_x1t) * 2));
  gt_on0 = slider29 >= 0.5; gt_on1 = slider30 >= 0.5; gt_on2 = slider31 >= 0.5;
  gt_so = slider32 | 0;
  gt_w0 = gt_so == 0 || gt_so == 1;
  gt_w2 = gt_so == 0 || gt_so == 3 || (gt_so == 2 && !gt_three);
  gt_w1 = gt_so == 0 || gt_so == 2 || (gt_so == 3 && !gt_three);
  gt_sol = gt_so > 0;
);
gt_bset();
gt_x1s = gt_x1t; gt_x2s = gt_x2t; bs_coef(exp(gt_x1s), exp(gt_x2s));
gt_b3s = gt_three; gt_o0s = gt_on0; gt_o1s = gt_on1; gt_o2s = gt_on2; gt_w0s = gt_w0; gt_w1s = gt_w1; gt_w2s = gt_w2; gt_sls = gt_sol;
gt_lf = -1;
gt_ksm = 1 - exp(-1 / (0.03 * srate));
gt_dks = 1 / (0.005 * srate);
gt_fis = 1 / (0.01 * srate);
gt_la = gt_rlat = min(GT_DLN - 2, floor(slider11 * 0.001 * srate + 0.5));
gt_sm = gt_rsm = floor(slider14 + 0.5);
gt_li = gt_rli = slider20 > 0.5;
gt_sw = 0; gt_dk = 1; gt_fi = 1;
gt_mx = gt_tmix = slider21 / 100; gt_og = gt_tout = gt_db2g(slider22);
pdc_delay = gt_la; pdc_bot_ch = 0; pdc_top_ch = 2;
gD1.drift_init(0.8 + rand(1) * 0.5); gD2.drift_init(0.8 + rand(1) * 0.5); gD3.drift_init(0.8 + rand(1) * 0.5);
pwr_init(); pwr_wu_loss = 0.4; pwr_wu_drv = 0.6; pwr_wu_lp = 12000; pwr_bloom = 0;
by_setup(24);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function gt_pband(b, th, rg, at, ho, re) (
  slider(33 + b * 3) = th; slider(34 + b * 3) = rg; slider(35 + b * 3) = re; slider(42 + b * 2) = at; slider(43 + b * 2) = ho;
);
function gt_pdyn(m, f, kn, th, rg, ra, at, ho, re, hy, la) (
  slider1 = m; slider2 = f; slider3 = kn; slider6 = ra; slider10 = hy; slider11 = la;
  gt_pband(0, th, rg, at, ho, re); gt_pband(1, th, rg, at, ho, re); gt_pband(2, th, rg, at, ho, re);
);
function gt_psp(nb, x1, x2, own) (
  slider25 = nb; slider26 = x1; slider27 = x2; slider28 = own;
);
function gt_pkey(src, mi, st, lk, hp, lp, ff, fg) (
  slider12 = src; slider13 = mi; slider14 = st; slider15 = lk;
  slider16 = hp; slider17 = lp; slider18 = ff; slider19 = fg;
);
function load_preset(p) (
  gt_pdyn(0, 0, 0, -40, 60, 2, 0.5, 50, 150, 4, 0);
  gt_pkey(0, 0, 0, 100, 20, 20000, 1000, 0);
  slider20 = 0; slider21 = 100; slider22 = 0;
  gt_psp(0, 150, 3000, 0); slider29 = slider30 = slider31 = 1; slider32 = 0;
  p == 2  ? ( gt_pdyn(0, 0, 0, -30, 60, 2, 0.1, 30, 90, 6, 2);       gt_pkey(0, 0, 0, 100, 30, 400, 80, 6); ) :
  p == 3  ? ( gt_pdyn(0, 0, 0, -28, 40, 2, 0.05, 40, 120, 6, 1.5);   gt_pkey(0, 0, 0, 100, 150, 8000, 2000, 6); ) :
  p == 4  ? ( gt_pdyn(0, 0, 1, -36, 30, 2, 1, 120, 400, 8, 2);       gt_pkey(0, 0, 0, 100, 60, 3000, 120, 4); ) :
  p == 5  ? ( gt_pdyn(0, 0, 0, -34, 24, 2, 0.05, 15, 60, 5, 1);      gt_pkey(0, 0, 0, 100, 4000, 20000, 8000, 3); ) :
  p == 6  ? ( gt_pdyn(1, 0, 1, -45, 12, 2, 2, 80, 250, 3, 0);        gt_pkey(0, 0, 0, 100, 100, 20000, 3000, 0); ) :
  p == 7  ? ( gt_pdyn(0, 0, 1, -55, 40, 2, 1, 60, 300, 8, 0);        gt_pkey(0, 0, 0, 100, 80, 6000, 1000, 0); ) :
  p == 8  ? ( gt_pdyn(1, 0, 0, -50, 30, 3, 3, 50, 200, 4, 0);        gt_pkey(0, 0, 0, 100, 20, 20000, 1000, 0); ) :
  p == 9  ? ( gt_pdyn(1, 0, 1, -40, 15, 1.5, 5, 20, 300, 2, 0);      gt_pkey(0, 0, 0, 100, 20, 20000, 1000, 0); ) :
  p == 10 ? ( gt_pdyn(1, 0, 1, -32, 18, 2.5, 2, 60, 350, 4, 0);      gt_pkey(0, 0, 0, 100, 60, 20000, 1000, 0); ) :
  p == 11 ? ( gt_pdyn(1, 0, 1, -48, 20, 2, 2, 100, 300, 4, 0);       gt_pkey(0, 0, 0, 100, 120, 8000, 2500, 4); ) :
  p == 12 ? ( gt_pdyn(0, 1, 1, -30, 9, 2, 5, 40, 250, 4, 0);         gt_pkey(1, 0, 0, 100, 20, 200, 80, 0); ) :
  p == 13 ? ( gt_pdyn(1, 1, 1, -40, 12, 4, 20, 200, 800, 3, 0);      gt_pkey(1, 0, 0, 100, 150, 6000, 1500, 0); ) :
  p == 14 ? ( gt_pdyn(0, 0, 0, -24, 80, 2, 0.05, 250, 40, 10, 0);    gt_pkey(0, 0, 0, 100, 20, 20000, 1000, 0); ) :
  p == 15 ? ( gt_pdyn(0, 0, 0, 0, 80, 2, 0.2, 0, 20, 0, 0);          gt_pkey(0, 1, 0, 100, 20, 20000, 1000, 0); ) :
  p == 16 ? ( gt_pdyn(0, 0, 0, -32, 50, 2, 0.01, 50, 100, 6, 5);     gt_pkey(0, 0, 0, 100, 40, 20000, 1000, 0); );
  p == 2 ? ( gt_psp(0, 220, 3000, 0); gt_pband(2, -24, 70, 0.1, 20, 60); ) :
  p == 3 ? ( gt_psp(1, 220, 4400, 0); gt_pband(0, -24, 50, 0.1, 30, 80); gt_pband(2, -30, 30, 0.05, 40, 140); ) :
  p == 5 ? ( gt_psp(0, 660, 3000, 0); gt_pband(0, -20, 80, 0.05, 10, 40); ) :
  p == 11 ? ( gt_psp(1, 220, 4400, 0); gt_pband(0, -44, 14, 2, 100, 400); gt_pband(2, -50, 24, 2, 100, 250); ) :
  p == 16 ? ( gt_psp(1, 110, 3300, 1); gt_pband(1, -34, 40, 0.01, 40, 90); gt_pband(2, -30, 60, 0.01, 30, 70); );
  slider_automate(2 ^ 47 - 1);
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(47, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k);
      prs_q ? ( k <= 16 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

gt_fresh = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
gt_fresh ? (
  gt_la = gt_rlat = min(GT_DLN - 2, floor(slider11 * 0.001 * srate + 0.5));
  gt_sm = gt_rsm = floor(slider14 + 0.5); gt_li = gt_rli = slider20 > 0.5;
  pdc_delay = gt_la; pdc_bot_ch = 0; pdc_top_ch = 2;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();
file_avail(0) != 0 ? file_var(0, mg_pg);

@block
prs_chk();
gt_now = time_precise();
gt_tp > 0 && gt_now - gt_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > gt_gpp && play_position - gt_gpp < 4 * gt_gpd + 0.05) ? ( gt_clear(); gt_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
gt_tp = gt_now; gt_gpp = play_position; gt_gpd = samplesblock / srate;
pwr_block(slider24 < 0.5);
drift_macro(slider23);
gt_inc = 0.05 * dm_s * samplesblock / srate;
gt_w1 = gD1.drift_tick(gt_inc); gt_w2 = gD2.drift_tick(gt_inc * 1.3); gt_w3 = gD3.drift_tick(gt_inc * 0.7);
gt_mdl = slider1 > 0.5; gt_fnc = slider2 > 0.5; gt_knee = slider3 > 0.5;
gt_rat = max(1, slider6);
gt_hy = slider10;
gt_dth = dm_a * 0.5 * gt_w1; gt_drl = 1 + 0.06 * dm_a * gt_w2;
gt_th0 = slider33 + gt_dth; gt_rg0 = slider34; gt_cr0 = gt_cms(slider35 * 0.001 / 3 * gt_drl); gt_ca0 = gt_cms(slider42 * 0.001 / 3); gt_ho0 = floor(slider43 * 0.001 * srate);
gt_th1 = slider36 + gt_dth; gt_rg1 = slider37; gt_cr1 = gt_cms(slider38 * 0.001 / 3 * gt_drl); gt_ca1 = gt_cms(slider44 * 0.001 / 3); gt_ho1 = floor(slider45 * 0.001 * srate);
gt_th2 = slider39 + gt_dth; gt_rg2 = slider40; gt_cr2 = gt_cms(slider41 * 0.001 / 3 * gt_drl); gt_ca2 = gt_cms(slider46 * 0.001 / 3); gt_ho2 = floor(slider47 * 0.001 * srate);
gt_thr = gt_th2; gt_rng = gt_rg2; gt_ca = gt_ca2; gt_cr = gt_cr2; gt_hold = gt_ho2;
gt_bset();
gt_rlat = min(GT_DLN - 2, floor(slider11 * 0.001 * srate + 0.5));
gt_ext = slider12 > 0.5; gt_mon = slider13 > 0.5;
gt_rsm = floor(slider14 + 0.5); gt_lnk = slider15 / 100;
gt_rli = slider20 > 0.5;
gt_rlat != gt_la || gt_rsm != gt_sm || gt_rli != gt_li ? gt_sw = 1;
gt_tmix = slider21 / 100; gt_tout = gt_db2g(slider22 + dm_a * 0.05 * gt_w3);
gt_fs = slider16 + slider17 * 3 + slider18 * 7 + slider19 * 11;
gt_fs != gt_lf ? (
  gt_lf = gt_fs;
  gt_hon = slider16 > 20.5;  gt_hon ? gt_chp(GT_CH, slider16, 0.7071);
  gt_lon = slider17 < 19999; gt_lon ? gt_clp(GT_CL, slider17, 0.7071);
  gt_pon = abs(slider19) > 0.05; gt_pon ? gt_cpk(GT_CP, slider18, slider19, 1.4);
);
pdc_delay = gt_la; pdc_bot_ch = 0; pdc_top_ch = 2;
gt_qn = 0;
while (midirecv(gt_mo, gt_m1, gt_m2, gt_m3)) (
  midisend(gt_mo, gt_m1, gt_m2, gt_m3);
  gt_ms = gt_m1 & 0xF0; gt_mc = gt_m1 & 0x0F;
  (gt_mon && gt_mc <= 2 && (gt_ms == 0x90 || gt_ms == 0x80) && gt_qn < 1024) ? (
    GT_MQ[gt_qn * 3] = gt_mo; GT_MQ[gt_qn * 3 + 1] = gt_mc; GT_MQ[gt_qn * 3 + 2] = (gt_ms == 0x90 && gt_m3 > 0) ? 1 : -1;
    gt_qn += 1;
  );
  (gt_ms == 0xB0 && (gt_m2 == 123 || gt_m2 == 120)) ? ( gt_na = 0; gt_nb = 0; );
);
!gt_mon ? ( gt_na = 0; gt_nb = 0; );
gt_qi = 0; gt_si = 0;
dA.env < 0.0000000001 ? dA.env = 0; dB.env < 0.0000000001 ? dB.env = 0;
