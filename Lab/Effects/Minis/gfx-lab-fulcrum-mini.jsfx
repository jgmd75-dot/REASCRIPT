desc:FULCRUM Mini [band balance] (GFX Lab)
//tags: dynamics band balance multiband compressor expander tone mastering mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:bal=-25<-100,100,1>-Balance (comp - exp, %)
slider3:rng=6<1,12,0.1>-Range (dB)
slider4:spd=1.5<0.3,5,0.01>-Speed (s)
slider5:f_lo=110<33,440,1>-Low split (Hz)
slider6:f_mid=1100<330,3300,1>-Mid split (Hz)
slider7:f_hi=5500<2200,11000,1>-High split (Hz)
slider8:link=1<0,1,1{Off,On}>-Link
slider9:mix=100<0,100,1>-Mix (%)
slider10:out_db=0<-24,12,0.1>-Output (dB)
slider11:prs_sel=0<0,10,1{No preset,Init,Mix Bus Settle,Drum Bus Open,Vocal Even,Bass Tidy,Acoustic Air,Dense Mix Clarity,Room Tame,Master Touch,Loop Lift}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-fulcrum-mini";
ext_noinit = 1;

CRATE = 16;
BE = 11000; BA = 11010; BP = 11020; BT = 11030; BG = 11040; BD = 11050; BL = 11060;
FLO = 11100; FMI = 11120; FHI = 11140;
FLO[0] = 33; FLO[1] = 44; FLO[2] = 55; FLO[3] = 66; FLO[4] = 77; FLO[5] = 88; FLO[6] = 99; FLO[7] = 110; FLO[8] = 220; FLO[9] = 330; FLO[10] = 440;
FMI[0] = 330; FMI[1] = 440; FMI[2] = 550; FMI[3] = 660; FMI[4] = 770; FMI[5] = 880; FMI[6] = 990; FMI[7] = 1100; FMI[8] = 2200; FMI[9] = 3300;
FHI[0] = 2200; FHI[1] = 3300; FHI[2] = 4400; FHI[3] = 5500; FHI[4] = 6600; FHI[5] = 7700; FHI[6] = 8800; FHI[7] = 9900; FHI[8] = 11000;

function bb_lp(f, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bb_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y;
  abs(y1) + abs(y2) < 0.000000000001 ? ( x1 = x2 = y1 = y2 = 0; );
  y;
);
function bb_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function bb_split(x) instance(FA, FB, FC) local(lf, r1, lm, r2, hm) (
  lf = FA.bb_run(x); r1 = x - lf; lm = FB.bb_run(r1); r2 = r1 - lm; hm = FC.bb_run(r2);
  bb_b0 = lf; bb_b1 = lm; bb_b2 = hm; bb_b3 = r2 - hm;
);
function bb_sclr() instance(FA, FB, FC) ( FA.bb_clr(); FB.bb_clr(); FC.bb_clr(); );
function bb_coefs() local(fl, fm, fh) (
  fl = bb_fl; fm = max(bb_fm, fl * 1.5); fh = max(bb_fh, fm * 1.5);
  SL.FA.bb_lp(fl, srate); SR.FA.bb_lp(fl, srate);
  SL.FB.bb_lp(fm, srate); SR.FB.bb_lp(fm, srate);
  SL.FC.bb_lp(fh, srate); SR.FC.bb_lp(fh, srate);
);
function bb_snaps(v, t, n) local(i, b, d, e) (
  i = 0; b = 0; d = 1000000;
  loop(n, e = abs(t[i] - v); e < d ? ( d = e; b = i; ); i += 1; );
  t[b];
);
function bb_params() (
  bb_k = min(max(bal, -100), 100) / 100;
  bb_rg = min(max(rng, 1), 12);
  bb_ka = 1 - exp(-CRATE / (min(max(spd, 0.3), 5) * srate));
  bb_tfl = bb_snaps(f_lo, FLO, 11); bb_tfm = bb_snaps(f_mid, FMI, 10); bb_tfh = bb_snaps(f_hi, FHI, 9);
  bb_mixt = min(max(mix, 0), 100) / 100;
  bb_outt = exp(min(max(out_db, -24), 12) * 0.11512925465);
  bb_lnk = link >= 0.5;
);
function bb_rate() (
  bb_kat = 1 - exp(-CRATE / (0.005 * srate)); bb_krl = 1 - exp(-CRATE / (0.1 * srate));
  bb_ke = 1 - exp(-1 / (0.02 * srate)); bb_ksm = 1 - exp(-1 / (0.03 * srate));
  bb_kgl = 1 - exp(-CRATE / (0.03 * srate));
);
function bb_idle() local(i) (
  i = 0; loop(8, BG[i] = 0; BD[i] = 0; BL[i] = 1; BA[i] = -60; BE[i] = 0; BP[i] = 0; i += 1; );
);
function bb_ctrl() local(s, o, b, lv, c, t, g, p0, p1, p2, p3) (
  c = 0.6 * bb_k; s = 0;
  loop(2,
    o = s * 4; b = 0;
    loop(4,
      lv = 4.342944819 * log(BE[o + b] + 0.000000000001);
      BA[o + b] += (lv - BA[o + b]) * bb_ka;
      BP[o + b] = lv > -60 ? max(0, lv - BA[o + b]) : 0;
      b += 1;
    );
    p0 = BP[o]; p1 = BP[o + 1]; p2 = BP[o + 2]; p3 = BP[o + 3];
    BT[o] = c * (p1 + p3); BT[o + 1] = c * (p0 + p2); BT[o + 2] = c * (p1 + p3); BT[o + 3] = c * (p0 + p2);
    b = 0;
    loop(4,
      t = max(-bb_rg, min(bb_rg, BT[o + b]));
      g = BG[o + b]; g += (t - g) * (abs(t) > abs(g) ? bb_kat : bb_krl); BG[o + b] = g;
      BD[o + b] = (exp(g * 0.11512925) - BL[o + b]) / CRATE;
      b += 1;
    );
    s += 1;
  );
);
function bb_reset() (
  SL.bb_sclr(); SR.bb_sclr(); bb_idle(); bb_on = 0;
  memset(BY_BUF, 0, 2 * BY_N);
  bb_rsf = 0;
);

bb_params(); bb_rate();
bb_fl = bb_tfl; bb_fm = bb_tfm; bb_fh = bb_tfh; bb_coefs();
bb_mixs = bb_mixt; bb_outs = bb_outt;
bb_idle(); bb_cc = 0; bb_rsf = 1;
ost_init(0);
ost_setup(0, 0, 200, 4000, -0.3, 0);
pdc_delay = 0;
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
bb_snap = 1; bb_blkn = 0;

function bb_set(b, r, s, fl, fm, fh, l) (
  bal = b; rng = r; spd = s; f_lo = fl; f_mid = fm; f_hi = fh; link = l; mix = 100; out_db = 0;
);
function load_preset(p) (
  p == 2  ? bb_set(-30, 4, 2,   110, 1100, 5500, 1) :
  p == 3  ? bb_set( 45, 6, 0.6,  88, 1100, 6600, 1) :
  p == 4  ? bb_set(-50, 6, 0.8, 220, 2200, 6600, 1) :
  p == 5  ? bb_set(-45, 8, 1,    66,  330, 3300, 1) :
  p == 6  ? bb_set( 30, 4, 1.5, 110, 1100, 4400, 1) :
  p == 7  ? bb_set(-60, 6, 1.2, 110,  990, 4400, 1) :
  p == 8  ? bb_set(-70, 9, 0.5, 220, 1100, 5500, 0) :
  p == 9  ? bb_set(-15, 3, 3,   110, 1100, 5500, 1) :
  p == 10 ? bb_set( 70, 9, 0.4, 110, 1100, 5500, 0) :
            bb_set(-25, 6, 1.5, 110, 1100, 5500, 1);
  out_db = p == 3 ? -7.5 : p == 6 ? -8 : p == 10 ? -8 : 0;
  slider_automate(1022);
  pr_cur = p > 10 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(10, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 10 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
bb_params();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && bb_blkn < 40 ? bb_snap = 1;

@block
prs_chk();
bb_blkn < 40 ? bb_blkn += 1;
bb_params();
bb_now = time_precise();
bb_tp > 0 && bb_now - bb_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > bb_gpp && play_position - bb_gpp < 4 * bb_gpd + 0.05) ? bb_reset();
bb_tp = bb_now; bb_gpp = play_position; bb_gpd = samplesblock / srate;
pdc_delay = 0;
pdc_bot_ch = 0; pdc_top_ch = 2;
bb_snap ? ( bb_snap = 0; bb_fl = bb_tfl; bb_fm = bb_tfm; bb_fh = bb_tfh; bb_coefs(); bb_mixs = bb_mixt; bb_outs = bb_outt; );
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
bb_outs += (bb_outt - bb_outs) * bb_ksm;
bb_mixs += (bb_mixt - bb_mixs) * bb_ksm;
xl = spl0; xr = spl1;
(bb_cc -= 1) <= 0 ? (
  bb_cc = CRATE;
  abs(bb_tfl - bb_fl) + abs(bb_tfm - bb_fm) + abs(bb_tfh - bb_fh) > 0.01 ? (
    bb_fl += (bb_tfl - bb_fl) * bb_kgl; bb_fm += (bb_tfm - bb_fm) * bb_kgl; bb_fh += (bb_tfh - bb_fh) * bb_kgl;
    bb_coefs();
  );
  bb_act = abs(bb_k) > 0.001 || abs(BG[0]) + abs(BG[1]) + abs(BG[2]) + abs(BG[3]) + abs(BG[4]) + abs(BG[5]) + abs(BG[6]) + abs(BG[7]) > 0.001;
  bb_act ? bb_ctrl() : bb_idle();
);
bb_act ? (
  !bb_on ? ( SL.bb_sclr(); SR.bb_sclr(); bb_on = 1; );
  SL.bb_split(xl); l0 = bb_b0; l1 = bb_b1; l2 = bb_b2; l3 = bb_b3;
  SR.bb_split(xr);
  bb_lnk ? (
    e0 = max(l0 * l0, bb_b0 * bb_b0); e1 = max(l1 * l1, bb_b1 * bb_b1); e2 = max(l2 * l2, bb_b2 * bb_b2); e3 = max(l3 * l3, bb_b3 * bb_b3);
    BE[0] += (e0 - BE[0]) * bb_ke; BE[1] += (e1 - BE[1]) * bb_ke; BE[2] += (e2 - BE[2]) * bb_ke; BE[3] += (e3 - BE[3]) * bb_ke;
    BE[4] = BE[0]; BE[5] = BE[1]; BE[6] = BE[2]; BE[7] = BE[3];
  ) : (
    BE[0] += (l0 * l0 - BE[0]) * bb_ke; BE[1] += (l1 * l1 - BE[1]) * bb_ke; BE[2] += (l2 * l2 - BE[2]) * bb_ke; BE[3] += (l3 * l3 - BE[3]) * bb_ke;
    BE[4] += (bb_b0 * bb_b0 - BE[4]) * bb_ke; BE[5] += (bb_b1 * bb_b1 - BE[5]) * bb_ke; BE[6] += (bb_b2 * bb_b2 - BE[6]) * bb_ke; BE[7] += (bb_b3 * bb_b3 - BE[7]) * bb_ke;
  );
  BL[0] += BD[0]; BL[1] += BD[1]; BL[2] += BD[2]; BL[3] += BD[3];
  BL[4] += BD[4]; BL[5] += BD[5]; BL[6] += BD[6]; BL[7] += BD[7];
  yl = l0 * BL[0] + l1 * BL[1] + l2 * BL[2] + l3 * BL[3];
  yr = bb_b0 * BL[4] + bb_b1 * BL[5] + bb_b2 * BL[6] + bb_b3 * BL[7];
) : ( bb_on = 0; yl = xl; yr = xr; );
yl = xl + (yl - xl) * bb_mixs; yr = xr + (yr - xr) * bb_mixs;
ost_out(yl * bb_outs, yr * bb_outs);
oa = ost_l; ob = ost_r;
oa != oa ? oa = 0; ob != ob ? ob = 0;
bb_rsf < 1 ? (
  bb_rsf = min(bb_rsf + 1 / (0.015 * srate), 1); bb_rq = bb_rsf * bb_rsf * (3 - 2 * bb_rsf);
  oa = spl0 + (oa - spl0) * bb_rq; ob = spl1 + (ob - spl1) * bb_rq;
);
spl0 = max(-4, min(4, oa));
spl1 = max(-4, min(4, ob));
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0xE87AA6; mk_plate = 0x5D3142; mk_band = 0x2E1821; mk_acc = 0x8FE3C2; mk_ink = 0xEFEEE2; mk_ink2 = 0xC9C6A8;
mk_val = 0xBCEEDA; mk_scale = 0xDAD8C0; mk_fig = 0xB4B296;
mk_sub = ui_mix(mk_face, 0x000000, 0.55); mk_sub2 = ui_mix(mk_face, 0x000000, 0.62);
mk_ft = ui_mix(mk_face, 0xFFFFFF, 0.22); mk_fb = ui_mix(mk_face, 0x000000, 0.22);
ui_vu_dim = byp >= 0.5;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 18 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
  mg_f3 = ui_fitarial(3, 14 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(3, "Arial", mg_f3, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_plate(x, y, w, h, title) (
  mg_rshadow(x, y, w, h, 0);
  ui_col(ui_mix(mk_face, 0x000000, 0.45)); mg_r(x, y, w, h);
  ui_col(mk_plate); mg_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.07); mg_r(x + 1, y + 1, w - 2, 1); mg_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, 0.22); mg_r(x + 1, y + h - 3, w - 2, 2); mg_r(x + w - 3, y + 1, 2, h - 2);
  ui_col(mk_band); mg_r(x + 1, y + 1, w - 2, 32);
  ui_cola(mk_acc, 0.55); mg_r(x + 1, y + 33, w - 2, 1);
  gfx_setfont(12); ui_col(mk_ink); mg_ltxt(x + 16, y + 17, title);
);
function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_dots(x, y, rs, big) local(i, t) (
  i = 0; loop(5, t = -0.75 * $pi + i * 0.375 * $pi; ui_col(mk_scale);
    mg_disc(x + sin(t) * rs, y - cos(t) * rs, (i == 0 || i == 4) ? big + 0.4 : big); i += 1; );
);
function mg_desk(x, y, r, a, act, cap) local(KX, KY, KR, i) (
  KX = x * sc; KY = y * sc; KR = r * sc;
  ui_col(0x8A8C86); gfx_circle(KX, KY, KR, 1, 1);
  ui_col(0x5E605B); gfx_circle(KX, KY, KR, 0, 1);
  i = 0; loop(4, ui_cola(0x000000, 0.10 * (1 - i / 4)); gfx_circle(KX, KY, KR - i * sc, 0, 1); i += 1; );
  ui_col(act ? 0xC8C7C0 : 0xBDBCB5); gfx_circle(KX, KY, KR * 0.76, 1, 1);
  ui_cola(0x000000, 0.18); gfx_circle(KX, KY, KR * 0.76, 0, 1);
  ui_col(cap); gfx_circle(KX, KY, KR * 0.6, 1, 1);
  ui_col(ui_mix(cap, 0x000000, 0.3)); gfx_circle(KX, KY, KR * 0.6, 0, 1);
  ui_cola(0xFFFFFF, 0.28); ui_ssarc(KX, KY, KR * 0.53, -1.7, -0.2, max(1, 1.1 * sc));
  ui_col(mg_lum(cap) > 0.55 ? 0x1E1F1E : 0xF4F2EA); ui_kdot(KX, KY, a, KR * 0.6);
);
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi, lg);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(mg_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    slider(idx) = mg_n2v(n, lo, hi, lg);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  mg_dots(cx, cy, r + 8, r < 20 ? 1.5 : 1.9);
  mg_cshadow(cx, cy, r);
  mg_desk(cx, cy, r, a, act, col);
  act;
);
function mg_figs(cx, cy, rs, lo, hi) (
  gfx_setfont(11); ui_col(mk_fig);
  mg_ctxt(cx - 0.7071 * rs, cy + 0.7071 * rs + 13, lo); mg_ctxt(cx + 0.7071 * rs, cy + 0.7071 * rs + 13, hi);
);
function mg_bkey(x, y, on, lc, name) local(w, h, hov, hit, dn, lx, ly) (
  w = 46; h = 30; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  mg_rshadow(x, y, w, h, 3);
  ui_col(0x050506); mg_rr(x - 2, y - 2, w + 4, h + 4, 4);
  ui_col(0x0C0D0E); mg_rr(x, y + dn, w, h - dn, 3);
  ui_col(hov ? 0x2E3034 : 0x26282B); mg_rr(x + 1, y + 1 + dn, w - 2, h * 0.6 - 1, 2.5);
  ui_cola(0xFFFFFF, 0.16); mg_r(x + 3, y + 1.5 + dn, w - 6, 1);
  ui_col(0x16171A); mg_r(x + 1, y + h * 0.6 + dn, w - 2, h * 0.4 - 2 - dn);
  ui_cola(0xFFFFFF, 0.10); mg_r(x + 2, y + h * 0.6 + dn, w - 4, 1);
  ui_cola(0x000000, 0.5); mg_r(x + 1, y + h * 0.6 - 1 + dn, w - 2, 1);
  lx = x + w * 0.5; ly = y + h * 0.3 + dn;
  on ? ( ui_cola(lc, 0.25); mg_disc(lx, ly, 9.5); );
  ui_col(0x050506); mg_disc(lx, ly, 6);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(lx, ly, 4.5);
  ui_cola(0xFFFFFF, on ? 0.6 : 0.15); mg_disc(lx - 1.4, ly - 1.4, 1.3);
  gfx_setfont(10); ui_col(hov ? mk_val : mk_ink); mg_ctxt(lx, y + h + 16, name);
  hit;
);
function mg_vu(x, y, w, h, vdb, pk) local(fx, fy, fw, fh, rad, px, py, i, t, a, s, ang0, ang1, c) (
  ui_spill((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 1);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, h + 18);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, 3); mg_r(x - 9, y - 6, 3, h + 15);
  ui_cola(0xFFFFFF, 0.14); mg_r(x - 9, y + h + 7, w + 18, 2); mg_r(x + w + 7, y - 9, 2, h + 16);
  ui_col(0x0C0C0C); mg_rr(x - 3, y - 3, w + 6, h + 6, 5);
  fx = x + 3; fy = y + 3; fw = w - 6; fh = h - 6;
  ui_glow(floor(fx * sc), floor(fy * sc), fw * sc, fh * sc, 1);
  rad = min(w * 0.5, h * 0.95); px = fx + fw / 2; py = fy + fh + rad * 0.12;
  ang0 = -0.72; ang1 = 1.44;
  ui_col(0x1A1A1C); ui_ssarc(px * sc, py * sc, rad * 0.78 * sc, ang0, ang0 + ang1 * 0.72, 1.2 * sc);
  ui_col(0xB8322A); ui_ssarc(px * sc, py * sc, rad * 0.8 * sc, ang0 + ang1 * 0.72, ang0 + ang1, 2.6 * sc);
  gfx_setfont(11); i = 0;
  loop(8, t = i == 0 ? 0 : i == 1 ? 0.2 : i == 2 ? 0.36 : i == 3 ? 0.5 : i == 4 ? 0.62 : i == 5 ? 0.72 : i == 6 ? 0.86 : 1;
    a = ang0 + ang1 * t; c = t > 0.72 ? 0xB8322A : 0x1A1A1C;
    ui_col(c); mg_disc(px + sin(a) * rad * 0.86, py - cos(a) * rad * 0.86, i == 5 ? 1.8 : 1.3);
    (i == 0 || i == 1 || i == 3 || i == 5 || i == 7) ? (
      s = i == 0 ? "20" : i == 1 ? "10" : i == 3 ? "5" : i == 5 ? "0" : "3";
      mg_ctxt(px + sin(a) * rad * 1.0, py - cos(a) * rad * 1.0, s); );
    i += 1; );
  gfx_setfont(6); ui_col(0x1A1A1C); mg_ctxt(px, fy + fh - 21, "VU");
  t = vdb <= -40 ? 0 : (10 ^ (vdb / 20) - 0.1) / (1.4125 - 0.1);
  t = min(max(t, -0.05), 1.05);
  mg_dt = min(max(time_precise() - mg_vlt, 0.001), 0.05); mg_vlt = time_precise();
  mg_vvel += (160 * (t - mg_vpos) - 18 * mg_vvel) * mg_dt; mg_vpos = min(max(mg_vpos + mg_vvel * mg_dt, -0.06), 1.06);
  a = ang0 + ang1 * mg_vpos;
  ui_cola(0x3A3A30, 0.25); ui_ssline((px + 1.5) * sc, (py + 1.5) * sc, (px + 1.5 + sin(a) * rad * 0.92) * sc, (py + 1.5 - cos(a) * rad * 0.92) * sc, 1.2 * sc, 1);
  ui_col(0x151515); ui_ssline(px * sc, py * sc, (px + sin(a) * rad * 0.92) * sc, (py - cos(a) * rad * 0.92) * sc, 1.3 * sc, 1);
  ui_col(0x1A1A1C); mg_rr(fx + fw / 2 - 18, fy + fh - 9, 36, 9, 2);
  ui_col(0x050506); mg_disc(fx + fw - 8, fy + 8, 4.2);
  ui_col(pk ? 0xFF3A2A : 0x5A1410); mg_disc(fx + fw - 8, fy + 8, 3);
  pk ? ( ui_cola(0xFF3A2A, 0.25); mg_disc(fx + fw - 8, fy + 8, 6); );
);
function mg_dwell(x, y, w, h) (
  ui_col(ui_mix(mk_face, 0x000000, 0.55)); mg_r(x, y, w, h);
  ui_col(mk_sub2); mg_r(x + 2, y + 2, w - 3, h - 3);
  ui_cola(0x000000, 0.35); mg_r(x + 2, y + 2, w - 3, 2); mg_r(x + 2, y + 4, 2, h - 5);
  ui_cola(0xFFFFFF, 0.22); mg_r(x, y + h, w + 1, 1); mg_r(x + w, y, 1, h);
);
function mg_val(idx, kind) local(v) (
  v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) :
  kind == 1 ? ( abs(v) < 0.5 ? #mgv = "OUT" : v < 0 ? sprintf(#mgv, "COMP %d %%", floor(-v + 0.5)) : sprintf(#mgv, "EXP %d %%", floor(v + 0.5)); ) :
  kind == 2 ? sprintf(#mgv, "%.1f dB", v) :
  kind == 3 ? ( v < 1 ? sprintf(#mgv, "%d ms", floor(v * 1000 + 0.5)) : sprintf(#mgv, "%.2f s", v); ) :
  sprintf(#mgv, "%+.1f dB", v);
  #mgv;
);
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, col, kind, name, fnt, lc) local(k) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, 0, col);
  gfx_setfont(fnt); ui_col(k ? mk_val : lc); mg_ctxt(cx, ly, k ? mg_val(idx, kind) : name);
  k;
);
function mg_zero(cx, cy, rs, n) local(a) (
  a = -0.75 * $pi + n * 1.5 * $pi;
  gfx_setfont(11); ui_col(mk_ink); mg_ctxt(cx + sin(a) * rs, cy - cos(a) * rs, "0");
);
function mg_led(x, y, on, c) (
  on ? ( ui_cola(c, 0.25); mg_disc(x, y, 9); );
  ui_col(0x050506); mg_disc(x, y, 6);
  ui_col(on ? c : ui_mix(c, 0x101214, 0.78)); mg_disc(x, y, 4.5);
  ui_cola(0xFFFFFF, on ? 0.6 : 0.15); mg_disc(x - 1.4, y - 1.4, 1.3);
);

function mg_sknob(cx, cy, r, idx, t, n, def, col) local(v, i, b, d, e, nn, dx, dy, hov, did, act, a) (
  did = 1800 + idx; v = slider(idx);
  i = 0; b = 0; d = 1000000; loop(n, e = abs(t[i] - v); e < d ? ( d = e; b = i; ); i += 1; );
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = b / (n - 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 600 : 200) * sc), 0), 1);
      v = t[floor(mgk_n * (n - 1) + 0.5)];
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    b = min(max(b + (mouse_wheel > 0 ? 1 : -1), 0), n - 1);
    slider(idx) = t[b]; ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx);
  i = 0; b = 0; d = 1000000; loop(n, e = abs(t[i] - v); e < d ? ( d = e; b = i; ); i += 1; );
  act = hov || drag_id == did; a = -0.75 * $pi + b / (n - 1) * 1.5 * $pi;
  mg_dots(cx, cy, r + 8, 1.5);
  mg_cshadow(cx, cy, r);
  mg_desk(cx, cy, r, a, act, col);
  act;
);
function mg_hz(v) ( v >= 1000 ? sprintf(#mgh, "%.1f kHz", v / 1000) : sprintf(#mgh, "%d Hz", floor(v + 0.5)); #mgh; );
function mg_rdout(cx, y, s, act) (
  ui_col(ui_mix(mk_face, 0x000000, 0.6)); mg_rr(cx - 33, y, 66, 20, 3);
  ui_col(act ? 0xF6F2DC : 0xE4DFC6); mg_rr(cx - 32, y + 1, 64, 18, 2.5);
  ui_cola(0x000000, 0.18); mg_r(cx - 30, y + 2, 60, 1.5);
  gfx_setfont(13); ui_col(0x22211A); mg_ctxt(cx, y + 10.5, s);
);
function mg_bcol(cx, y, g, c) local(i, d, cy, on, lc) (
  i = 0;
  loop(9,
    d = i == 0 ? 6 : i == 1 ? 4 : i == 2 ? 2 : i == 3 ? 1 : i == 4 ? 0 : i == 5 ? -1 : i == 6 ? -2 : i == 7 ? -4 : -6;
    cy = y + i * 13;
    i == 4 ? ( on = abs(g) < 1; lc = 0xF4F2EA; ) : ( on = d > 0 ? g >= d : g <= d; lc = c; );
    on ? ( ui_cola(lc, 0.2); mg_disc(cx, cy, 7.5); );
    ui_col(0x050506); mg_disc(cx, cy, i == 4 ? 4.4 : 5.6);
    ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(cx, cy, i == 4 ? 3 : 4.2);
    ui_cola(0xFFFFFF, on ? 0.55 : 0.12); mg_disc(cx - 1.3, cy - 1.3, 1.2);
    i += 1;
  );
);

