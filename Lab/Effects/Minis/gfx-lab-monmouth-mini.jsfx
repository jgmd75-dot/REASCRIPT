fz_s += (fzt - fz_s) * c_kn; fz_s < 0.000001 && fzt == 0 ? fz_s = 0; fz_o = fz_s;
cl_s = ceil_s; vl_cl = ceil_s;
vk_kn = 0.88 - 0.13 * face_s;

