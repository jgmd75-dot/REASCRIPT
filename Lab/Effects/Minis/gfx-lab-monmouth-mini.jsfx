oL = max(-ceil_s, min(ceil_s, oL)); oR = max(-ceil_s, min(ceil_s, oR));
dmode > 0 ? ( oL = dtA.idr(oL); oR = dtB.idr(oR); );
wm_gml = max(wm_gml, -g2db(goL)); wm_gmr = max(wm_gmr, -g2db(goR));

dip_s = min(dip_g, os_g); dip_s *= dip_s * (3 - 2 * dip_s);
oL *= dip_s; oR *= dip_s;
DRY[dw] = rw_l; DRY[1024 + dw] = rw_r;
dd = (dw - pdc_delay) & RMASK;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
