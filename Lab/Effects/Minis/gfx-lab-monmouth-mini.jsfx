desc:Monmouth Mini [hybrid limiter] (GFX Lab)
//tags: limiter maximiser mastering valve clipper brickwall true-peak transient dither
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-os and gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:v_in=1<0,1,1{Out,In}>-Valve limiter
slider2:v_lim=3<0,18,0.1>-Valve limit (dB)
slider3:v_hf=0<-30,0,0.1>-HF limit (dB)
slider4:v_ell=0<0,3,1{Off,70 Hz,150 Hz,300 Hz}>-Elliptical
slider5:v_face=1<0,1,1{ULM,CPH}>-Valve character
slider6:c_in=0<0,1,1{Out,In}>-Clipper
slider7:c_drv=3<0,12,0.1>-Clip drive (dB)
slider8:c_mode=0<0,1,1{Soft,Hard}>-Clip mode
slider9:l_thr=0<-30,0,0.1>-Threshold (dB)
slider10:l_rel=100<1,1000,1>-Release (ms)
slider11:l_arc=1<0,1,1{Off,On}>-Auto release
slider12:l_keep=0<0,100,1>-Transient keep (%)
slider13:l_tp=1<0,1,1{Off,On}>-True peak
slider14:lnk=1<0,1,1{Off,On}>-Link
slider15:ceil_db=-0.3<-12,0,0.1>-Ceiling (dBFS)
slider16:dith=0<0,3,1{Off,24 bit,16 bit,16 bit shaped}>-Dither
slider17:byp=0<0,1,1{Off,On}>-Bypass
slider18:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider19:prs_sel=0<0,15,1{No preset,Init,Gentle Master,Loud Master,Punch Master,Warm Glue,Bright Pop,Vinyl Ready,Streaming -1 TP,Bass Heavy,Clip and Limit,Broadcast,Dynamic Jazz,16-bit CD,Safety Limiter,Drum Bus}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-monmouth-mini";
ext_noinit = 1;

nextmem = 200000;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(g) ( log(max(g, 0.0000000001)) * 8.685889638065035; );
function kc(t, fs) ( 1 - exp(-1 / (max(t, 0.000001) * fs)); );
function sat3(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

function bq_hp(c, f, q, fs) local(w, cs, al, a0) (
  w = 2 * $pi * min(f, fs * 0.45) / fs; cs = cos(w); al = sin(w) / (2 * q); a0 = 1 + al;
  c[0] = (1 + cs) * 0.5 / a0; c[1] = -(1 + cs) / a0; c[2] = c[0]; c[3] = -2 * cs / a0; c[4] = (1 - al) / a0;
);
function bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function bq_z() instance(z1, z2) ( z1 = z2 = 0; );

CE1 = alloc(5); CE2 = alloc(5); CHF = alloc(5);
function ell_hz(v) ( v < 1.5 ? 70 : v < 2.5 ? 150 : 300; );
function ell_set() ( bq_hp(CE1, ell_hz(ell_eng), 0.54, srate); bq_hp(CE2, ell_hz(ell_eng), 1.31, srate); );

LA = max(8, floor(0.0015 * srate + 0.5));
LT = max(4, floor(0.00025 * srate + 0.5));
TPD = 8;
DLY = (LA - 1) + (LT - 1) + TPD;
function gc_init(len) instance(n, cap, dqv, dqi, head, tail, bx, bxp, sum, env, t) local(i) (
  n = len; cap = n + 2;
  dqv = alloc(cap); dqi = alloc(cap); bx = alloc(n);
  head = tail = 0; bxp = 0; env = 1; t = 0; sum = n;
  i = 0; loop(n, bx[i] = 1; i += 1; );
);
function gc_run(req, rc) instance(n, cap, dqv, dqi, head, tail, bx, bxp, sum, env, t) local(m, p) (
  p = (tail + cap - 1) % cap;
  while (tail != head && dqv[p] >= req) ( tail = p; p = (tail + cap - 1) % cap; );
  dqv[tail] = req; dqi[tail] = t; tail = (tail + 1) % cap;
  while (dqi[head] <= t - n) ( head = (head + 1) % cap; );
  m = dqv[head];
  t += 1;
  env = m < env ? m : env + (m - env) * rc;
  sum += env - bx[bxp]; bx[bxp] = env; bxp = (bxp + 1) % n;
  t % 65536 == 0 ? ( sum = 0; p = 0; loop(n, sum += bx[p]; p += 1; ); );
  sum / n;
);
function dl_init(len) instance(b, n, p) ( n = max(len, 1); b = alloc(n); p = 0; );
function dl_run(x) instance(b, n, p) local(y) ( y = b[p]; b[p] = x; p = (p + 1) % n; y; );
function dl_clr() instance(b, n) ( memset(b, 0, n); );
function bf_run(p) instance(b) ( b += (p - b) * (p > b ? bf_up : bf_dn); b; );
function bf_eff(p, b) ( p > b ? p - kp_s * (p - b) : p; );
function lim_side(p, rc) instance(gb, gt, gd) local(b, rq, g, rqd) (
  b = this.bf.bf_run(p);
  rq = min(1, ceil_s / max(p, 0.0000001));
  g = this.gm.gc_run(min(1, ceil_s / max(bf_eff(p, b), 0.0000001)), rc);
  rqd = this.rqq.dl_run(rq);
  gt = this.gtr.gc_run(min(1, rqd / max(g, 0.0000001)), rcT);
  gb = this.gbd.dl_run(g);
  gb * gt;
);
function lim_init() (
  this.gm.gc_init(LA); this.gtr.gc_init(LT); this.rqq.dl_init(LA - 1); this.gbd.dl_init(LT - 1);
);
lk.lim_init(); lsa.lim_init(); lsb.lim_init();
dlL.dl_init(DLY); dlR.dl_init(DLY);

NT = 16; NP = 7;
hph = alloc(NP * NT);
ph = 0;
loop(NP,
  fr = (ph + 1) / (NP + 1); k = 0;
  loop(NT,
    xx = k - (NT / 2 - 1) - fr;
    sn = abs(xx) < 0.000001 ? 1 : sin($pi * xx) / ($pi * xx);
    wn = 0.42 + 0.5 * cos($pi * xx / (NT / 2 + 0.5)) + 0.08 * cos(2 * $pi * xx / (NT / 2 + 0.5));
    hph[ph * NT + k] = sn * wn;
    k += 1;
  );
  s_ = 0; k = 0; loop(NT, s_ += hph[ph * NT + k]; k += 1; ); k = 0; loop(NT, hph[ph * NT + k] /= s_; k += 1; );
  ph += 1;
);
function tp_init() instance(h, p) ( h = alloc(2 * NT); p = 0; );
function tp_run(x) instance(h, p) local(k, a, j, mx, c) (
  h[p] = x; h[p + NT] = x; p = (p + 1) % NT;
  mx = abs(h[p + NT / 2 - 1]); j = 0;
  loop(NP,
    a = 0; k = 0; c = hph + j * NT;
    loop(NT, a += c[k] * h[p + k]; k += 1; );
    mx = max(mx, abs(a)); j += 1;
  );
  mx;
);
function tp_mid() instance(h, p) ( h[p + NT / 2 - 1]; );
function tp_clr() instance(h) ( memset(h, 0, 2 * NT); );
dtL.tp_init(); dtR.tp_init();

HS = alloc(9);
function shp(m, k) (
  m == 1 ? (k == 0 ? 1.623 : k == 1 ? -0.982 : k == 2 ? 0.109 : 0) :
  m == 2 ? (k == 0 ? 2.412 : k == 1 ? -3.370 : k == 2 ? 3.937 : k == 3 ? -4.174 : k == 4 ? 3.353 : k == 5 ? -2.205 :
            k == 6 ? 1.281 : k == 7 ? -0.569 : k == 8 ? 0.0847 : 0) : 0;
);
function idr_init() instance(e, pr) ( e = alloc(9); pr = 0; );
function idr_clear() instance(e) ( memset(e, 0, 9); );
function idr(x) instance(e, pr) local(w, k, r, d, q) (
  w = x; k = 0; loop(nsh, w -= HS[k] * e[k]; k += 1; );
  r = rand(1); d = r - rand(1); pr = r;
  q = floor((w + d * qstep) / qstep + 0.5) * qstep;
  q = max(-1, min(1 - qstep, q));
  k = nsh - 1; loop(max(0, nsh - 1), e[k] = e[k - 1]; k -= 1; );
  e[0] = max(-4 * qstep, min(4 * qstep, q - w));
  q;
);
dtA.idr_init(); dtB.idr_init();

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function v_soft(x) local(t, a) (
  t = vl_cl * vk_kn; a = abs(x);
  a <= t ? x : sign(x) * (t + (vl_cl - t) * sat3((a - t) / (vl_cl - t)));
);
function c_one(x) local(u, s, h) (
  u = x * cd_s / cl_s;
  s = abs(u) >= 1.5 ? sign(u) : u - 0.148148148 * u * u * u;
  h = min(max(u, -1), 1);
  x + ((s + (h - s) * cm_s) * cl_s - x) * cin_s;
);
function ph_run(a, b) (
  ph_l = a; ph_r = b;
  vin_s > 0.000001 ? (
    ph_l = ph_l * vlg_s; ph_r = ph_r * vlg_s;
    ph_l = a + (v_soft(ph_l * v_gl) - a) * vin_s; ph_r = b + (v_soft(ph_r * v_gr) - b) * vin_s;
  );
  cin_s > 0.000001 ? ( ph_l = c_one(ph_l); ph_r = c_one(ph_r); );
  fz_o > 0.0001 ? ( fz_l = ph_l; fz_r = ph_r; fz_run(); ph_l = fz_l; ph_r = fz_r; );
);

DRY = alloc(2048); RMASK = 1023; dw = 0;

function rate_set() (
  c_kn = kc(0.03, srate); c_sw = kc(0.015, srate); c_lk = kc(0.01, srate);
  bf_up = kc(0.006, srate); bf_dn = kc(0.08, srate); rcT = kc(0.005, srate);
  hf_a = kc(0.002, srate); hf_r = kc(0.052, srate);
  bq_hp(CHF, 7000, 0.7, srate);
  klo = kc(1 / (2 * $pi * 80), srate);
  dip_c = 1 / (0.005 * srate); rs_c = 1 / (0.015 * srate);
  ell_set();
  rc_lvl = kc(1, srate); d5_r = 1 - 2 * $pi * 5 / srate;
);
function params() (
  vlg_t = db2g(v_lim); hf_t = v_hf; vin_t = v_in >= 0.5; face_t = v_face >= 0.5;
  cin_t = c_in >= 0.5; cd_t = db2g(c_drv); cm_t = c_mode >= 0.5;
  gin_t = db2g(-l_thr); kp_t = min(max(l_keep, 0), 100) * 0.01; ceil_t = db2g(ceil_db);
  relm = kc(max(1, l_rel) * 0.001, srate); arc_on = l_arc >= 0.5; tp_on = l_tp >= 0.5; lk_t = lnk >= 0.5;
  ell_t = v_ell | 0;
  dmode = dith | 0;
  qstep = 2 ^ (1 - (dmode == 1 ? 24 : 16));
  nsh = dmode == 3 ? 9 : 0;
  dmode != dm_last ? ( k_ = 0; loop(9, HS[k_] = shp(dmode == 3 ? 2 : 0, k_); k_ += 1; ); dtA.idr_clear(); dtB.idr_clear(); dm_last = dmode; );
  os_tf = os_f2n(os_sl);
  fzt = 0.33 * min(max((c_drv - 6) / 6, 0), 1) * cin_t;
);

rate_set(); params();
vlg_s = vlg_t; hf_s = hf_t; vin_s = vin_t; face_s = face_t; cin_s = cin_t; cd_s = cd_t; cm_s = cm_t;
gin_s = gin_t; kp_s = kp_t; ceil_s = ceil_t; lk_s = lk_t; fz_s = fzt; ell_eng = ell_t; ell_set(); el_s = ell_eng > 0;
v_gv = v_gl = v_gr = v_gA = v_gB = 1; rcArc = kc(0.1, srate); arcN = 0; arcAvg = 0; grDb = 0;
rs_f = 1; dip_g = 1; dip_hold = 0;
os_design();
os_base = DLY; os_f = os_tf = os_f2n(os_sl);
fz_coefs(srate * os_f); fz_clr();
os_gsetup();

#wm_pmn = "Init|Gentle Master|Loud Master|Punch Master|Warm Glue|Bright Pop|Vinyl Ready|Streaming -1 TP|Bass Heavy|Clip and Limit|Broadcast|Dynamic Jazz|16-bit CD|Safety Limiter|Drum Bus";
function setp(a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16) (
  v_in = a1; v_lim = a2; v_hf = a3; v_ell = a4; v_face = a5; c_in = a6; c_drv = a7; c_mode = a8;
  l_thr = a9; l_rel = a10; l_arc = a11; l_keep = a12; l_tp = a13; lnk = a14; ceil_db = a15; dith = a16;
  slider_automate(65535);
);
function load_preset(p) (
  p == 1  ? setp(1, 3,   0, 0, 1, 0, 3, 0,  0, 100, 1,  0, 1, 1, -0.3, 0) :
  p == 2  ? setp(1, 2, -14, 1, 1, 0, 3, 0, -1, 100, 1, 20, 1, 1, -0.3, 0) :
  p == 3  ? setp(1, 4, -16, 1, 0, 1, 3, 0, -4, 100, 1, 40, 1, 1, -0.3, 0) :
  p == 4  ? setp(1, 2, -14, 1, 0, 1, 2, 0, -5, 100, 1, 70, 1, 1, -0.3, 0) :
  p == 5  ? setp(1, 5, -18, 1, 1, 0, 3, 0, -2, 150, 1, 20, 1, 1, -0.5, 0) :
  p == 6  ? setp(1, 3, -12, 1, 0, 1, 2, 0, -3,  80, 1, 40, 1, 1, -0.3, 0) :
  p == 7  ? setp(1, 2, -20, 3, 1, 0, 3, 0, -1, 200, 1,  0, 1, 1, -1.0, 0) :
  p == 8  ? setp(1, 3, -16, 1, 1, 0, 3, 0, -3, 100, 1, 25, 1, 1, -1.0, 0) :
  p == 9  ? setp(1, 3, -14, 2, 1, 1, 3, 1, -3,  60, 1, 30, 1, 1, -0.3, 0) :
  p == 10 ? setp(0, 3,   0, 0, 1, 1, 6, 0, -2, 100, 1, 30, 1, 1, -0.3, 0) :
  p == 11 ? setp(1, 6, -20, 2, 0, 1, 2, 0, -4, 250, 0,  0, 1, 1, -1.0, 0) :
  p == 12 ? setp(1, 1, -10, 0, 1, 0, 3, 0,  0, 300, 1,  0, 1, 1, -1.0, 0) :
  p == 13 ? setp(1, 3, -16, 1, 1, 0, 3, 0, -3, 100, 1, 25, 1, 1, -0.3, 3) :
  p == 14 ? setp(0, 3,   0, 0, 1, 0, 3, 0,  0, 300, 0,  0, 1, 1, -0.3, 0) :
  p == 15 ? setp(0, 3,   0, 0, 0, 1, 4, 1, -8,  30, 0, 60, 0, 0, -1.0, 0);
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; ); ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(18, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 15 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(15, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
params();
os_snap(slider(18));

@block
prs_chk();
params();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_bot_ch = 0; pdc_top_ch = 2;
wm_vu_d = max(wm_vu_d, sqrt(wm_ms / max(samplesblock, 1))); wm_ms = 0;
wm_pk_d = max(wm_pk_d, wm_pkm); wm_pkm = 0;
pkl_d = max(pkl_d, wm_pl); pkr_d = max(pkr_d, wm_pr); wm_pl = wm_pr = 0;
grl_disp = max(grl_disp, wm_gml); grr_disp = max(grr_disp, wm_gmr); wm_gml = wm_gmr = 0;
lat_disp = pdc_delay;
os_snapb(slider(18));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
rs_req ? (
  rs_req = 0; rs_f = 0; rs_x = 0; rs_wait = pdc_delay;
  ul.os_clr(); ur.os_clr(); dl_.os_clr(); dr_.os_clr(); fz_clr();
  dlL.dl_clr(); dlR.dl_clr(); dtL.tp_clr(); dtR.tp_clr(); memset(DRY, 0, 2048);
  dc_xl = dc_yl = dc_xr = dc_yr = 0; d5_xl = d5_yl = d5_xr = d5_yr = 0;
);
rw_l = spl0; rw_r = spl1;
ell_t != ell_eng ? (
  ell_eng == 0 ? ( ell_eng = ell_t; ell_set(); e1L.bq_z(); e2L.bq_z(); ) :
  ell_t == 0 ? ( el_s == 0 ? ell_eng = 0; ) : (
    dip_g = max(dip_g - dip_c, 0);
