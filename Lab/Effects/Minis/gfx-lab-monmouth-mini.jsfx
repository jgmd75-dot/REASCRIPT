os_f > 1 ? ( ph_run(ul.s1, ur.s1); qa1 = ph_l; qb1 = ph_r; );
os_f > 2 ? ( ph_run(ul.s2, ur.s2); qa2 = ph_l; qb2 = ph_r; ph_run(ul.s3, ur.s3); qa3 = ph_l; qb3 = ph_r; );
xl = dl_.os_dn(qa0, qa1, qa2, qa3); xr = dr_.os_dn(qb0, qb1, qb2, qb3);

ir_w = face_s * vin_s;
ir_w > 0 ? (
  lo1 += (xl - lo1) * klo; xl += (sat3(lo1 * 1.5) / 1.5 - lo1) * 0.5 * ir_w;
