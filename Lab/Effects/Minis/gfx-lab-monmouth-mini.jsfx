dc_yr = spl1 - dc_xr + 0.99987 * dc_yr; dc_xr = spl1; xr = dc_yr;

el_s > 0 && vin_s > 0 ? (
  em = (xl + xr) * 0.5; es = (xl - xr) * 0.5;
  es += (e2L.bq(e1L.bq(es, CE1), CE2) - es) * el_s * vin_s;
  xl = em + es; xr = em - es;
);
vin_s > 0 ? (
  hl = hfL.bq(xl, CHF); hr = hfR.bq(xr, CHF);
  hp_ = max(abs(hl), abs(hr));
  hf_e += (hp_ - hf_e) * (hp_ > hf_e ? hf_a : hf_r);
  hf_eA += (abs(hl) - hf_eA) * (abs(hl) > hf_eA ? hf_a : hf_r);
  hf_eB += (abs(hr) - hf_eB) * (abs(hr) > hf_eB ? hf_a : hf_r);
  ho = g2db(hf_e) - hf_s; hg = ho > 0 ? db2g(-ho * 0.75) : 1;
  ho = g2db(hf_eA) - hf_s; hgA = ho > 0 ? db2g(-ho * 0.75) : 1;
  ho = g2db(hf_eB) - hf_s; hgB = ho > 0 ? db2g(-ho * 0.75) : 1;
