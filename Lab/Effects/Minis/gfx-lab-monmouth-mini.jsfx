);

ul.os_up(xl); ur.os_up(xr);
vin_s > 0 ? (
  pa = abs(ul.s0); pb = abs(ur.s0);
  os_f > 1 ? ( pa = max(pa, abs(ul.s1)); pb = max(pb, abs(ur.s1)); );
  os_f > 2 ? ( pa = max(pa, max(abs(ul.s2), abs(ul.s3))); pb = max(pb, max(abs(ur.s2), abs(ur.s3))); );
  pa *= vlg_s; pb *= vlg_s; pm = max(pa, pb);
