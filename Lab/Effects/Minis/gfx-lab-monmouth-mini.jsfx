vlg_s += (vlg_t - vlg_s) * c_kn; hf_s += (hf_t - hf_s) * c_kn;
vin_s += (vin_t - vin_s) * c_sw; vin_t == 0 && vin_s < 0.000001 ? vin_s = 0; vin_t && vin_s > 0.999999 ? vin_s = 1;
face_s += (face_t - face_s) * c_sw;
cin_s += (cin_t - cin_s) * c_sw; cin_t == 0 && cin_s < 0.000001 ? cin_s = 0; cin_t && cin_s > 0.999999 ? cin_s = 1;
cd_s += (cd_t - cd_s) * c_kn; cm_s += (cm_t - cm_s) * c_sw;
gin_s += (gin_t - gin_s) * c_kn; kp_s += (kp_t - kp_s) * c_kn; ceil_s += (ceil_t - ceil_s) * c_kn;
lk_s += (lk_t - lk_s) * c_lk; lk_t && lk_s > 0.9999 ? lk_s = 1; !lk_t && lk_s < 0.0001 ? lk_s = 0;
