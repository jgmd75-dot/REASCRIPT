);

d5_yl = xl - d5_xl + d5_r * d5_yl; d5_xl = xl; d5_yr = xr - d5_xr + d5_r * d5_yr; d5_xr = xr;
xl = d5_yl * gin_s; xr = d5_yr * gin_s;
tpkL = dtL.tp_run(xl); tpkR = dtR.tp_run(xr);
!tp_on ? ( tpkL = abs(dtL.tp_mid()); tpkR = abs(dtR.tp_mid()); );
(arcN += 1) >= 32 ? (
