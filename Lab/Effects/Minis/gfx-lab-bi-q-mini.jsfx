desc:Bi-Q Mini [tone control] (GFX Lab)
//tags: equaliser eq tone control baxandall bass treble hifi saturation width
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-12,12,0.5>-Bass (dB)
slider3:0<-12,12,0.5>-Treble (dB)
slider4:1<0,2,1{75 Hz,150 Hz,300 Hz}>-Bass turnover
slider5:1<0,2,1{1.5 kHz,3 kHz,6 kHz}>-Treble turnover
slider6:0<-12,12,0.1>-Output (dB)
slider7:1<0,1,1{Out,In}>-Mid in
slider8:0<-24,12,0.1>-Input trim (dB)
slider9:1<0,1,1{Off,On}>-Input guard
slider10:0<0,100,1>-Sat amount (%)
slider11:20<20,400,1>-HPF (Hz)
slider12:20000<2500,20000,10>-LPF (Hz)
slider13:0<-100,100,1>-Low width (%)
slider14:0<-100,100,1>-High width (%)
slider15:1<0,2,1{Dip,Neutral,Push}>-Mid
slider16:1<0,1,1{Off,On}>-Sat low
slider17:1<0,1,1{Off,On}>-Sat high
slider18:50<0,100,1>-Drift (%)
slider19:0<0,2,1{1x,2x,4x}>-Oversampling
slider20:prs_sel=0<0,12,1{No preset,Init,Warm Bass Lift,Air and Sparkle,Smiley Mix,Vocal Clarity,Thin Out Mud,Dark Tape Tone,Bright Acoustic,Wide Top - Mono Bass,Radio Band,Kick and Bass Weight,Gentle Master Tilt}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-bi-q-mini";
ext_noinit = 1;
CR = 16;

function sh_set(hi, f, gdb) instance(b0, b1, a1) local(k, g, r, n) (
  k = tan($pi * min(f, srate * 0.45) / srate); g = 10 ^ (gdb / 20); r = sqrt(g);
  hi ? (
    n = 1 / k + r; b0 = g * (1 / k + 1 / r) / n; b1 = g * (-1 / k + 1 / r) / n; a1 = (-1 / k + r) / n;
  ) : (
    n = 1 / k + 1 / r; b0 = (1 / k + r) / n; b1 = (-1 / k + r) / n; a1 = (-1 / k + 1 / r) / n;
  );
);
function sh_run(x) instance(b0, b1, a1, x1, y1) local(y) (
  y = b0 * x + b1 * x1 - a1 * y1; x1 = x; y1 = y; y;
);
function sh_z() instance(x1, y1) ( x1 = y1 = 0; );
function tone_set(fm, gm) instance(lo, hi) (
  lo.sh_set(0, bf_s * fm, bass_g * gm);
  hi.sh_set(1, tf_s * fm, treb_g * gm);
);
function tone_run(x) instance(lo, hi) ( hi.sh_run(lo.sh_run(x)); );
function tone_z() instance(lo, hi) ( lo.sh_z(); hi.sh_z(); );

function mid_coef(f, q, gdb) local(a, w, al, a0) (
  a = 10 ^ (gdb / 40); w = 2 * $pi * f / srate; al = sin(w) / (2 * q); a0 = 1 + al / a;
  MB0 = (1 + al * a) / a0; MB1 = -2 * cos(w) / a0; MB2 = (1 - al * a) / a0; MA1 = MB1; MA2 = (1 - al / a) / a0;
);
function mid_run(x) instance(x1, x2, y1, y2) local(y) (
  y = MB0 * x + MB1 * x1 + MB2 * x2 - MA1 * y1 - MA2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);

function svf_lp(x, a1, a2, a3) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; v2;
);
function svf_hp(x, a1, a2, a3) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; x - 1.41421356 * v1 - v2;
);
function svf_z() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function filt_coefs() local(g) (
  hp_ls += (log(hp_ft) - hp_ls) * c_cr;  lp_ls += (log(lp_ft) - lp_ls) * c_cr;
  hp_m += (hp_on - hp_m) * c_cr;  abs(hp_m - hp_on) < 0.0001 ? hp_m = hp_on;
  lp_m += (lp_on - lp_m) * c_cr;  abs(lp_m - lp_on) < 0.0001 ? lp_m = lp_on;
  g = tan($pi * min(exp(hp_ls), srate * 0.45) / srate);
  HA1 = 1 / (1 + g * (g + 1.41421356)); HA2 = g * HA1; HA3 = g * HA2;
  g = tan($pi * min(exp(lp_ls), srate * 0.45) / srate);
  LA1 = 1 / (1 + g * (g + 1.41421356)); LA2 = g * LA1; LA3 = g * LA2;
);

function sat_add(x, k, b) instance(x1) local(z, z1, fb, d, y) (
  z = k * (x + b); z1 = k * (x1 + b);
  fb = k * b / sqrt(1 + k * b * k * b); d = 1 + k * b * k * b; d = k / (d * sqrt(d));
  y = (z + z1) / (sqrt(1 + z * z) + sqrt(1 + z1 * z1));
  y = (y - fb) / d - 0.5 * (x + x1);
  x1 = x; y;
);
function sat_run(x, dk) instance(lo, hi, sat_lo, sat_hi, dcx, dcy) local(a) (
  a = 0;
  slo_m > 0 ? a += slo_m * sat_lo.sat_add(lo.svf_lp(x, SLA1, SLA2, SLA3), 1 + (slo_k - 1) * dk, slo_b) : lo.svf_lp(x, SLA1, SLA2, SLA3);
  shi_m > 0 ? a += shi_m * sat_hi.sat_add(hi.svf_hp(x, SHA1, SHA2, SHA3), 1 + (shi_k - 1) * dk, shi_b) : hi.svf_hp(x, SHA1, SHA2, SHA3);
  dcy = a - dcx + bq_dcp * dcy; dcx = a;
  x + sat_w * dcy;
);
function sat_z() instance(lo, hi, sat_lo, sat_hi, dcx, dcy) ( lo.svf_z(); hi.svf_z(); sat_lo.x1 = 0; sat_hi.x1 = 0; dcx = dcy = 0; );

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(bq_ol, FZ_1); h1 = zA2.fz_bq(bq_or, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(bq_ol), abs(bq_or)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  bq_ol += g * e0; bq_or += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function bq_os(xl, xr) (
  bq_ol = xl; bq_or = xr;
  sat_w > 0 ? ( bq_ol = sL.sat_run(bq_ol, sdL); bq_or = sR.sat_run(bq_or, sdR); );
  fz_o > 0.0001 ? fz_run();
);
function bq_rate() local(u_g) (
  bq_fs = srate * os_f;
  bq_dcp = 1 - 0.0005 / os_f;
  u_g = tan($pi * min(bf_s * 1.5, bq_fs * 0.45) / bq_fs);  SLA1 = 1 / (1 + u_g * (u_g + 1.41421356)); SLA2 = u_g * SLA1; SLA3 = u_g * SLA2;
  u_g = tan($pi * min(tf_s, bq_fs * 0.45) / bq_fs);        SHA1 = 1 / (1 + u_g * (u_g + 1.41421356)); SHA2 = u_g * SHA1; SHA3 = u_g * SHA2;
);
function bq_clear() (
  sL.sat_z(); sR.sat_z(); fz_clr();
);
function bq_reset() (
  bq_clear();
  tL.tone_z(); tR.tone_z();
  mL.x1 = mL.x2 = mL.y1 = mL.y2 = 0; mR.x1 = mR.x2 = mR.y1 = mR.y2 = 0;
  fHL.svf_z(); fHR.svf_z(); fLL.svf_z(); fLR.svf_z();
  w_lo = w_lp2 = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  memset(BY_BUF, 0, 2 * BY_N);
  bq_fi = 0;
);

function update() (
  bass_f = slider4 == 0 ? 75 : slider4 == 1 ? 150 : 300;
  treb_f = slider5 == 0 ? 1500 : slider5 == 1 ? 3000 : 6000;
  out_t = 10 ^ (slider6 / 20);
  drift_macro(slider18);
  drift = 0.25 * dm_a; dspd = 0.25 * dm_s;
  in_setup(slider8, slider9);
  hp_on = slider11 > 20.5; hp_ft = max(slider11, 20);
  lp_on = slider12 < 19990; lp_ft = min(slider12, 20000);
  mid_t = slider15 < 0.5 ? -3 : slider15 > 1.5 ? 3 : 0;
);

dFL.drift_init(0.8 + rand(1)); dFR.drift_init(0.8 + rand(1));
dGL.drift_init(0.8 + rand(1)); dGR.drift_init(0.8 + rand(1));
in_init();
sm = 1 - exp(-1 / (0.03 * srate));
c_cr = 1 - exp(-CR / (0.03 * srate));
bq_fis = 1 / (0.01 * srate);
update();
bass_g = slider2; treb_g = slider3; tone_on = slider7; out_s = out_t;
bf_s = bass_f; tf_s = treb_f; mid_g = mid_t * tone_on;
hp_ls = log(hp_ft); lp_ls = log(lp_ft); hp_m = hp_on; lp_m = lp_on; cnt = 0;
wl_s = slider13 / 100; wh_s = slider14 / 100;
slo_m = slider16; shi_m = slider17; sat_a = slider10 / 100;
fz_o = 0; bq_fi = 1;
os_design();
os_f = os_tf = os_f2n(slider19); os_base = 0;
os_gsetup();
bq_rate(); fz_coefs(bq_fs);
pwr_init(); pwr_wu_loss = 0.4; pwr_wu_drv = 0.6; pwr_wu_lp = 12000; pwr_bloom = 0;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function bq_p(a, b, c, d, e, f, g, h, i, j, k, m, n) (
  slider(2) = a; slider(3) = b; slider(4) = c; slider(5) = d; slider(6) = e; slider(10) = f; slider(11) = g; slider(12) = h;
  slider(13) = i; slider(14) = j; slider(15) = k; slider(16) = m; slider(17) = n;
);
#bq_pm = "Init|Warm Bass Lift|Air and Sparkle|Smiley Mix|Vocal Clarity|Thin Out Mud|Dark Tape Tone|Bright Acoustic|Wide Top, Mono Bass|Radio Band|Kick and Bass Weight|Gentle Master Tilt";
function load_preset(p) local(i) (
  p == 1 ? bq_p( 0,   0,   1, 1,  0,   0,  20, 20000,    0,  0, 1, 1, 1);
  p == 2 ? bq_p( 4,   0,   0, 1, -1.1, 25, 20, 20000,    0,  0, 1, 1, 0);
  p == 3 ? bq_p( 0,   4,   1, 2,  0,   0,  20, 20000,    0,  0, 1, 1, 1);
  p == 4 ? bq_p( 3,   3,   1, 1, -1.2, 0,  20, 20000,    0,  0, 0, 1, 1);
  p == 5 ? bq_p(-3,   3,   1, 1,  0,   0,  80, 20000,    0,  0, 2, 1, 1);
  p == 6 ? bq_p(-4,   0,   2, 1,  2.5, 0,  60, 20000,    0,  0, 1, 1, 1);
  p == 7 ? bq_p( 0,  -3,   1, 1,  0,   40, 20, 12000,    0,  0, 1, 1, 1);
  p == 8 ? bq_p(-2,   4,   1, 2,  0,   0,  20, 20000,    0,  0, 1, 1, 1);
  p == 9 ? bq_p( 0,   0,   1, 1,  0,   0,  20, 20000, -100, 40, 1, 1, 1);
  p == 10 ? bq_p( 0,  0,   1, 1,  3.2, 20, 300, 3500,    0,  0, 2, 1, 1);
  p == 11 ? bq_p( 5,  0,   0, 1, -1,   0,  20, 20000,    0,  0, 0, 1, 1);
  p == 12 ? bq_p(-1,  1.5, 1, 2,  0,   15, 20, 20000,    0,  0, 1, 1, 1);
  i = 2; loop(5, ui_auto(i); i += 1; ); i = 10; loop(8, ui_auto(i); i += 1; );
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(19, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); update();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
update();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
update();
srate != bq_sr ? ( bq_sr = srate; sm = 1 - exp(-1 / (0.03 * srate)); c_cr = 1 - exp(-CR / (0.03 * srate)); bq_fis = 1 / (0.01 * srate); in_init(); os_gsetup(); );
bq_now = time_precise();
bq_tp > 0 && bq_now - bq_tp > max(0.25, 4 * samplesblock / srate) ? bq_reset();
bq_tp = bq_now;
pwr_block(slider1 < 0.5);
os_tf = os_f2n(slider19);
bs = 1 - exp(-samplesblock / (0.03 * srate));
bass_g += (slider2 - bass_g) * bs; treb_g += (slider3 - treb_g) * bs; tone_on += (slider7 - tone_on) * bs;
bf_s *= (bass_f / bf_s) ^ bs;  abs(bf_s / bass_f - 1) < 0.000001 ? bf_s = bass_f;
tf_s *= (treb_f / tf_s) ^ bs;  abs(tf_s / treb_f - 1) < 0.000001 ? tf_s = treb_f;
dinc = dspd * samplesblock / srate;
vfL = dFL.drift_tick(dinc); vfR = dFR.drift_tick(dinc);
vgL = dGL.drift_tick(dinc); vgR = dGR.drift_tick(dinc);
tL.tone_set(1, 1);  tR.tone_set(1, 1);
sdL = 1 + 0.6 * drift * vfL;  sdR = 1 + 0.6 * drift * vfR;
mid_g += (mid_t * (slider7 >= 0.5) - mid_g) * bs;  abs(mid_g - mid_t * (slider7 >= 0.5)) < 0.000001 ? mid_g = mid_t * (slider7 >= 0.5);
mid_coef(800, 0.5, mid_g);
sat_a += (slider10 / 100 - sat_a) * bs;  abs(sat_a - slider10 / 100) < 0.000001 ? sat_a = slider10 / 100;
slo_m += (slider16 - slo_m) * bs;  abs(slo_m - slider16) < 0.0001 ? slo_m = slider16;
shi_m += (slider17 - shi_m) * bs;  abs(shi_m - slider17) < 0.0001 ? shi_m = slider17;
sat_w = min(sat_a * 3, 1);
slo_k = 1 + 3 * sat_a * (0.35 + 0.65 * max(bass_g, 0) / 12);   slo_b = 0.15 / slo_k;
shi_k = 1 + 4 * sat_a * (0.35 + 0.65 * max(treb_g, 0) / 12);   shi_b = 0.1 / shi_k;
bq_rate();
fz_t = 0.33 * min(max((treb_g - 6) / 6, 0), 1);
fz_o += (fz_t - fz_o) * bs;  abs(fz_o - fz_t) < 0.000001 ? fz_o = fz_t;
wl_s += (slider13 / 100 - wl_s) * bs;  abs(wl_s - slider13 / 100) < 0.000001 ? wl_s = slider13 / 100;
wh_s += (slider14 / 100 - wh_s) * bs;  abs(wh_s - slider14 / 100) < 0.000001 ? wh_s = slider14 / 100;
wl_g = (wl_s < 0 ? 1 + wl_s : 1 + 0.8 * wl_s) * (1 + 0.3 * drift * vgL);
wh_g = (wh_s < 0 ? 1 + wh_s : 1 + 0.8 * wh_s) * (1 + 0.3 * drift * vgR);
w_on = wl_s != 0 || wh_s != 0;
wl_c = 1 - exp(-2 * $pi * bf_s / srate);  wh_c = 1 - exp(-2 * $pi * tf_s / srate);
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
bq_vu_d = max(bq_vu_d, sqrt(bq_ms / max(samplesblock, 1))); bq_ms = 0;
bq_pk_d = max(bq_pk_d, bq_pkm); bq_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
l = in_l; r = in_r;
(cnt -= 1) <= 0 ? ( cnt = CR; filt_coefs(); );
hp_m > 0 ? ( l += (fHL.svf_hp(l, HA1, HA2, HA3) - l) * hp_m;  r += (fHR.svf_hp(r, HA1, HA2, HA3) - r) * hp_m; );
lp_m > 0 ? ( l += (fLL.svf_lp(l, LA1, LA2, LA3) - l) * lp_m;  r += (fLR.svf_lp(r, LA1, LA2, LA3) - r) * lp_m; );
l = tL.tone_run(l); r = tR.tone_run(r);
mid_g != 0 ? ( l = mL.mid_run(l); r = mR.mid_run(r); ) : ( mL.x1 = mL.y1 = l; mL.x2 = mL.y2 = l; mR.x1 = mR.y1 = r; mR.x2 = mR.y2 = r; );
pwr_in(l, r); l = pwr_l; r = pwr_r;
os_gate();
os_chg ? ( bq_rate(); fz_coefs(bq_fs); bq_clear(); os_hold += 2 * samplesblock; );
uxL.os_up(l); uxR.os_up(r);
os_f == 1 ? (
