  );
);
pwr_out(l, r); l = pwr_l; r = pwr_r;
u_s = 0.5 * (l - r);
w_lo += (u_s - w_lo) * wl_c;  w_lp2 += (u_s - w_lp2) * wh_c;
w_on ? (
  u_m = 0.5 * (l + r);
  u_hi = u_s - w_lp2;
  u_s = w_lo * wl_g + (u_s - w_lo - u_hi) + u_hi * wh_g;
