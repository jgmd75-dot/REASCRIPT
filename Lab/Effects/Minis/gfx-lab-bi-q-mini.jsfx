    t = -0.375 * $pi; mg_disc(cx + sin(t) * (r + 8), cy - cos(t) * (r + 8), 1.3); mg_disc(cx - sin(t) * (r + 8), cy - cos(t) * (r + 8), 1.3);
  ) : !mg_kstep ? mg_dots(cx, cy, r, mk_ink2);
  mg_kz ? ( gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(cx, cy - r - 19, "0"); );
  mg_kw = 0; mg_kz = 0;
  mg_cshadow(cx, cy, r);
  mg_kbody(sty, cx, cy, r, a, act, col);
  act;
);
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, sty, col, kind, name) local(k, v) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%.1f", v) : kind == 1 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) :
  kind == 3 ? ( v <= 20.5 ? strcpy(#mgv, "OFF") : sprintf(#mgv, "%d Hz", floor(v + 0.5)); ) :
  kind == 4 ? ( v >= 19990 ? strcpy(#mgv, "OFF") : sprintf(#mgv, "%.1f kHz", v / 1000); ) :
  kind == 5 ? ( abs(v) < 0.5 ? strcpy(#mgv, "0 %") : sprintf(#mgv, "%+d %%", floor(v + 0.5 * sign(v))); ) :
  sprintf(#mgv, "%+.1f dB", v);
