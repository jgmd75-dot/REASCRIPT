function load_combi(k) local(q) (
  k = min(max(floor(k + 0.5), 1), NCB); q = CB + (k - 1)*8;
  patch_to(q[0], 0); slider1 = q[0]; last_patch = q[0]; au_auto(1);
  patch_to(q[1], 120); slider119 = q[1]; last_pb = q[1]; au_auto(119);
  q[2] < 99 ? ( slider72 = q[2]; au_auto(72); );
  q[3] < 99 ? ( slider192 = q[3]; au_auto(192); );
  q[4] != 0 ? (
    slider129 = min(max(slider129 + q[4], -24), 24); slider134 = min(max(slider134 + q[4], -24), 24);
    au_auto(129); au_auto(134);
  );
  slider120 = q[5]; au_auto(120); slider121 = 1; au_auto(121);
  slider239 = k; cmb_last = k;
  update();
);

function fx_keys() ( fx_ch = slider82 > 0; fx_tr = slider91 > 0; fx_vb = slider101 > 0; au_auto(42); au_auto(49); au_auto(50); );
function off_reset() (
  tn_brt = 0; tn_res = 0; tn_att = 0; tn_rel = 0; fx_rate = 0; fx_dep = 100;
  au_auto(38); au_auto(39); au_auto(40); au_auto(41); au_auto(51); au_auto(52);
);
function load_blend(k) local(q) (
  q = M1BT + (k - 1)*20;
  patch_to(q[0], 0); slider1 = q[0]; last_patch = q[0]; au_auto(1);
  patch_to(q[1], 120); slider119 = q[1]; last_pb = q[1]; au_auto(119);
  q[5] != 0 ? (
    slider129 = min(max(slider129 + q[5], -24), 24); slider134 = min(max(slider134 + q[5], -24), 24);
    au_auto(129); au_auto(134);
  );
  slider72 = q[2]; au_auto(72); slider192 = q[3]; au_auto(192);
  slider120 = q[4]; au_auto(120); slider121 = 1; au_auto(121);
  slider239 = q[6]; cmb_last = q[6]; au_auto(239);
  off_reset(); fx_keys();
  tn_brt = q[7]; tn_res = q[8]; tn_att = q[9]; tn_rel = q[10];
  q[11] >= 0 ? fx_ch = q[11]; q[12] >= 0 ? fx_tr = q[12]; q[13] >= 0 ? fx_vb = q[13];
  fx_rate = q[14]; fx_dep = q[15]; out_w = q[16];
  au_auto(38); au_auto(39); au_auto(40); au_auto(41); au_auto(42); au_auto(49); au_auto(50); au_auto(51); au_auto(52); au_auto(53);
);
function load_preset(k) (
  k = min(max(floor(k + 0.5), 1), M1BN);
  load_blend(k); update();
  prs_sel = k; prs_last = k; au_auto(240); prs_cur_d = k;
);
function rq_hash() local(i, h) (
  h = 0; i = 2;
  loop(238, i != 119 && i != 239 ? h += slider(i)*(1 + i*0.7071); i += 1; );
  h;
);
function hard_kill() local(i) (
  v0.e1.st = v1.e1.st = v2.e1.st = v3.e1.st = v4.e1.st = v5.e1.st = 0;
  v0.e2.st = v1.e2.st = v2.e2.st = v3.e2.st = v4.e2.st = v5.e2.st = 0;
  v0.e1.lv = v1.e1.lv = v2.e1.lv = v3.e1.lv = v4.e1.lv = v5.e1.lv = 0;
  v0.e2.lv = v1.e2.lv = v2.e2.lv = v3.e2.lv = v4.e2.lv = v5.e2.lv = 0;
  w0.e1.st = w1.e1.st = w2.e1.st = w3.e1.st = w4.e1.st = w5.e1.st = 0;
  w0.e2.st = w1.e2.st = w2.e2.st = w3.e2.st = w4.e2.st = w5.e2.st = 0;
  w0.e1.lv = w1.e1.lv = w2.e1.lv = w3.e1.lv = w4.e1.lv = w5.e1.lv = 0;
  w0.e2.lv = w1.e2.lv = w2.e2.lv = w3.e2.lv = w4.e2.lv = w5.e2.lv = 0;
  i = 0; loop(NV, VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; );
  hcount = 0; msus = 0; bL = bR = 0;
  mr_clr(); mrL = mrR = 0;
);
function do_load(k, a) (
  k == 1 ? load_preset(a) :
  k == 2 ? ( load_patch(a); fx_keys(); update(); prs_sel = 0; prs_last = 0; au_auto(240); ) :
  k == 3 ? ( load_b(a); slider121 = 1; au_auto(121); update(); prs_sel = 0; prs_last = 0; au_auto(240); ) :
  k == 4 ? ( slider121 = 0; au_auto(121); cmb_clear(); update(); prs_sel = 0; prs_last = 0; au_auto(240); ) :
  k == 5 ? ( load_patch(a); fx_keys(); update(); ) :
  k == 6 ? load_b(a) :
  k == 7 ? ( load_combi(a); off_reset(); fx_keys(); update(); );
);
function req_load(k, a) ( pk_dfr ? ( ld_k = k; ld_a = a; pn_st = 1; ) : do_load(k, a); );
function pk_watch() local(same) (
  same = rq_ok && rq_hash() == rq_h0;
  pk_dfr && prs_dirty > 0 ? ( req_load(1, prs_dirty); prs_last = prs_dirty; prs_dirty = 0; ) : (
    prs_sel = max(0, min(M1BN, prs_sel | 0));
    prs_sel != prs_last ? ( same && prs_sel >= 1 ? req_load(1, prs_sel); prs_last = prs_sel; );
  );
  pk_dfr && lp_dirty ? ( req_load(2, lp_dirty - 1); lp_dirty = 0; );
  pk_dfr && lpb_dirty ? ( lpb_dirty < 0 ? req_load(4, 0) : req_load(3, lpb_dirty - 1); lpb_dirty = 0; );
  last_patch < 0 ? last_patch = slider1 : slider1 != last_patch ? ( same ? req_load(5, slider1); last_patch = slider1; );
  last_pb < 0 ? last_pb = slider119 : slider119 != last_pb ? ( same ? req_load(6, slider119); last_pb = slider119; );
  cmb_last < 0 ? cmb_last = slider239 : slider239 != cmb_last ? ( same && slider239 >= 1 ? req_load(7, slider239); cmb_last = slider239; );
  rq_h0 = rq_hash(); rq_ok = 1;
);

NWV = 53000;
v0.vinit(-0.30, -12); v1.vinit(0.30, 12); v2.vinit(-0.15, -6); v3.vinit(0.15, 6); v4.vinit(-0.06, -2.5); v5.vinit(0.06, 2.5);
w0.vinit(-0.30, -12); w1.vinit(0.30, 12); w2.vinit(-0.15, -6); w3.vinit(0.15, 6); w4.vinit(-0.06, -2.5); w5.vinit(0.06, 2.5);
ins_drift_init();
fl_ok = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
pwr_init(); pwr_sag = 0.15; pwr_wu_loss = 0.5; pwr_wu_drv = 0; pwr_wu_lp = 9000; pwr_wu_wob = 0.3; pwr_bloom = 0;
pn_g = 1; pn_st = 0; pn_k = 1/(0.008*srate); out_ws = 1;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
sm = 1 - exp(-1/(0.03*srate));
lk = 1 - exp(-1/(0.02*srate));
bend_st = 0; modw = 0; atch = 0; pedal = 0; hcount = 0; vage = 0; qcount = 0; msus = 0;
last_patch = -1; last_pb = -1; cmb_last = -1;
!ui_dflt ? ( ui_sz = 0; mk_slot_d = 0; load_blend(1); update(); prs_sel = 1; prs_last = 1; );
update();
vol_s = vol_t; gA_s = gA_t; gB_s = gB_t; out_ws = out_wt;
i = 0; loop(NV, v_stop(i); VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; ); hcount = 0;
ui_dflt = 1;
prs_last = prs_sel; rq_ok = 0; prs_dirty = 0;
au_on = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
pk_dfr = 0;
pk_watch();
update();

@block
pk_dfr = 1;
pk_watch();
update();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4*samplesblock/srate) && !(play_position > g_gpp && play_position - g_gpp < 4*g_gpd + 0.05) ? hard_kill();
g_tp = g_now; g_gpp = play_position; g_gpd = samplesblock/srate;
panic_dirty ? ( pn_st = 1; pedal = 0; panic_dirty = 0; );
pwr_block(1);
mn_vu_d = max(mn_vu_d, sqrt(mn_ms/max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
fl_k = 1 - exp(-1 / (0.015 * srate));
!fl_ok ? (
  lay_get(LPB); fl_c1 = fl_c2 = fl_lc; fl_rs = RES; fl_ev = VENV; lay_keep(LPB);
  lay_get(LPA); fl_c1 = fl_c2 = fl_lc; fl_rs = RES; fl_ev = VENV; lay_keep(LPA);
  fl_ok = 1;
);

qcount = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, chan) ? (
    st = m1 & 0xF0;
    st == 0x90 || st == 0x80 ? ( q_push(mofs, st == 0x90 && m3 > 0, m2, m3); st == 0x90 && m3 > 0 ? ins_midi_hit(); ) :
    st == 0xE0 ? bend_st = (((m3*128 + m2) - 8192)/8192)*slider8 :
    st == 0xD0 ? atch = m2/127 :
    st == 0xB0 ? (
      m2 == 1 ? modw = m3/127 :
      m2 == 64 ? ( pedal = m3 >= 64; !pedal ? q_push(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? q_push(mofs, 3, 0, 0);
    );
  );
  midisend(mofs, m1, m2, m3);
);
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( q_push(0, 3, 0, 0); );
gfx_pst_prev = gfx_pst;
vmode != last_vm ? ( q_push(0, 3, 0, 0); last_vm = vmode; );
panic_req ? ( all_off(); panic_req = 0; );
eqi = 0; spos = 0;

mr_block();
ins_drift_block(drift, samplesblock);
dvi = 0.35*samplesblock/srate;
v0.vblock(dvi); v1.vblock(dvi); v2.vblock(dvi); v3.vblock(dvi); v4.vblock(dvi); v5.vblock(dvi);
w0.vblock(dvi); w1.vblock(dvi); w2.vblock(dvi); w3.vblock(dvi); w4.vblock(dvi); w5.vblock(dvi);

@serialize
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, mk_slot_d);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;

@sample
while (eqi < qcount && (EQO[eqi] <= spos || spos >= samplesblock - 1)) (
  et = EQT[eqi];
