function mg_kq(cx, cy, r, ly, idx, lo, hi, def, sty, col, kind, name) local(k, v) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) : kind == 1 ? sprintf(#mgv, "%+d %%", floor(v + 0.5)) :
  kind == 2 ? sprintf(#mgv, "%d ms", floor(v + 0.5)) : kind == 5 ? sprintf(#mgv, "%+.1f dB", v) :
