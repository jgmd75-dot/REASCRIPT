function pp(p, j, a, b, c, d, e, f, g, h, i, k) local(o) (
  o = PB + p*128 + j;
  o[0] = a; o[1] = b; o[2] = c; o[3] = d; o[4] = e; o[5] = f; o[6] = g; o[7] = h; o[8] = i; o[9] = k;
);
