  );
  mrVbWet > 0 ? (
    sp = mrVbCo && (mrVbLo || mrVbRo); kc = (mrVbLo || mrVbRo) ? 0.707 : 1;
    mrVbLo ? dl += mr_vb(xl, 0, mrVsV);
    mrVbRo ? dr += mr_vb(xr, sp ? 2/3 : 0, mrVsV + 16);
    mrVbCo ? ( y = kc*mr_vb(m, sp ? 1/3 : 0, mrVsV + 32); dl += y; dr += y; );
  );
  mrDlT += mrDlTs*(mrDlTgt - mrDlT);
  mrWow += 0.45/srate; mrWow -= floor(mrWow); mrFl += 6.3/srate; mrFl -= floor(mrFl);
  dmod = mrRun*(5*sin(2*$pi*mrWow) + 0.5*sin(2*$pi*mrFl) + 2.5*mr_rgen(mrRg + 15, 1.2, mrCd));
  dsm = max(2, min(mrDLN*0.55, (mrDlT + dmod)*srate*0.001));
  sp = mrDlCo && (mrDlLo || mrDlRo); kc = (mrDlLo || mrDlRo) ? 0.707 : 1;
  mrDlLo && mrDlMix > 0 ? ( ya = mr_hread(mrDlA, mrDLN, mrDlW - dsm*(sp ? 0.75 : 1)); mrDlA[mrDlW] = xl + mr_loop(ya, mrDls); dl += mrDlMix*ya; ) : mrDlA[mrDlW] = 0;
  mrDlRo && mrDlMix > 0 ? ( yb = mr_hread(mrDlB, mrDLN, mrDlW - dsm*(sp ? 1.25 : 1)); mrDlB[mrDlW] = xr + mr_loop(yb, mrDls + 2); dr += mrDlMix*yb; ) : mrDlB[mrDlW] = 0;
  mrDlCo && mrDlMix > 0 ? ( yc = mr_hread(mrDlC, mrDLN, mrDlW - dsm); mrDlC[mrDlW] = m + mr_loop(yc, mrDls + 4); y = mrDlMix*kc*yc; dl += y; dr += y; ) : mrDlC[mrDlW] = 0;
  mrChW += 1; mrChW >= mrCHN ? mrChW = 0;
  mrDlW += 1; mrDlW >= mrDLN ? mrDlW = 0;
  mrL = xl + dl; mrR = xr + dr;
);

function lay_calc(o) (
  glide_k = slider(6 + o) > 0 ? 1 - (1 - vo_coef(slider(6 + o)))^16 : 1;
  D1F = slider(9 + o); D1SH = slider(10 + o)/100; D1W = slider(11 + o) > 0.5; D1P = slider(12 + o) > 0.5; D1PW = slider(13 + o)/100;
  D2F = slider(14 + o); D2DET = slider(15 + o); D2SH = slider(16 + o)/100; D2W = slider(17 + o) > 0.5; D2P = slider(18 + o) > 0.5; D2PW = slider(19 + o)/100;
  D2N = slider(20 + o) > 0.5; SYNC = slider(21 + o) > 0.5; MIX = slider(22 + o)/100;
  CUT = min(max(slider(23 + o)*tn_cm, 20), 18000); RES = min(max(slider(24 + o)/100 + tn_ro, 0), 1); VENV = slider(25 + o)/100; VKEY = slider(26 + o)/100; VFM = slider(27 + o)/100;
  fl_lc = log(CUT);
  E1D = slider(28 + o)*0.001*srate; E1A = 1/max(1, slider(29 + o)*tn_am*0.001*srate); E1DC = ms_(slider(30 + o)); E1S = slider(31 + o)/100; E1R = ms_(slider(32 + o)*tn_rm);
  E2D = slider(33 + o)*0.001*srate; E2A = 1/max(1, slider(34 + o)*tn_am*0.001*srate); E2DC = ms_(slider(35 + o)); E2S = slider(36 + o)/100; E2R = ms_(slider(37 + o)*tn_rm);
  L1SP = slider(43 + o); L1W = slider(44 + o); L1AMT = slider(45 + o); L2SP = slider(46 + o); L2W = slider(47 + o); L2AMT = slider(48 + o)/100;
  VVEL = slider(73 + o)/100; L1DI = slider(74 + o) > 0 ? 1/max(1, slider(74 + o)*0.001*srate) : 1;
  L2D = floor(slider(75 + o) + 0.5); PENV = slider(76 + o); PTGT = slider(77 + o) > 0.5;
);
function lay_put(q) (
  q[0] = glide_k; q[1] = D1F; q[2] = D1SH; q[3] = D1W; q[4] = D1P; q[5] = D1PW; q[6] = D2F; q[7] = D2DET; q[8] = D2SH; q[9] = D2W;
  q[10] = D2P; q[11] = D2PW; q[12] = D2N; q[13] = SYNC; q[14] = MIX; q[15] = fl_lc; q[16] = RES; q[17] = VENV; q[18] = VKEY; q[19] = VFM;
  q[20] = E1D; q[21] = E1A; q[22] = E1DC; q[23] = E1S; q[24] = E1R; q[25] = E2D; q[26] = E2A; q[27] = E2DC; q[28] = E2S; q[29] = E2R;
  q[30] = L1SP; q[31] = L1W; q[32] = L1AMT; q[33] = L2SP; q[34] = L2W; q[35] = L2AMT; q[36] = VVEL; q[37] = L1DI; q[38] = L2D; q[39] = PENV;
  q[40] = PTGT;
);
function lay_get(q) (
  glide_k = q[0]; D1F = q[1]; D1SH = q[2]; D1W = q[3]; D1P = q[4]; D1PW = q[5]; D2F = q[6]; D2DET = q[7]; D2SH = q[8]; D2W = q[9];
  D2P = q[10]; D2PW = q[11]; D2N = q[12]; SYNC = q[13]; MIX = q[14]; fl_lc = q[15]; RES = q[16]; VENV = q[17]; VKEY = q[18]; VFM = q[19];
  E1D = q[20]; E1A = q[21]; E1DC = q[22]; E1S = q[23]; E1R = q[24]; E2D = q[25]; E2A = q[26]; E2DC = q[27]; E2S = q[28]; E2R = q[29];
  L1SP = q[30]; L1W = q[31]; L1AMT = q[32]; L2SP = q[33]; L2W = q[34]; L2AMT = q[35]; VVEL = q[36]; L1DI = q[37]; L2D = q[38]; PENV = q[39];
  PTGT = q[40];
  fl_c1 = q[50]; fl_c2 = q[51]; fl_rs = q[52]; fl_ev = q[53];
