function lay_keep(q) ( q[50] = fl_c1; q[51] = fl_c2; q[52] = fl_rs; q[53] = fl_ev; );

function update() (
  tn_cm = 2^(tn_brt/50); tn_ro = tn_res/100; tn_am = 4^(tn_att/100); tn_rm = 4^(tn_rel/100);
  fx_rm = 4^(fx_rate/100); fx_dm = fx_dep/100; out_wt = out_w/100;
  vmode = floor(slider5 + 0.5); UNI = vmode == 2 ? 1 : 0;
  VELS = slider7/100; drift = slider3/100; chan = slider4;
  lay_calc(120); lay_put(LPB); GKB = glide_k;
  lay_calc(0); lay_put(LPA); GKA = glide_k;
  mr_update();
  vol_t = 10^((slider2 + slider72)/20);
  lbal = slider120/100; lbon = slider121 > 0.5;
  gA_t = lbal <= 0.5 ? 1 : 2*(1 - lbal);
  gB_t = lbon*(lbal >= 0.5 ? 1 : 2*lbal)*10^((slider192 - slider72)/20);
  ins_output_setup(66);
);
function patch_to(p, o) local(i, q) (
  q = PB + p*128;
  i = 0; loop(NPF, o == 0 || PSL[i] != 5 ? ( slider(PSL[i] + o) = q[i]; au_auto(PSL[i] + o); ); i += 1; );
);
function cmb_clear() ( slider239 != 0 ? ( slider239 = 0; au_auto(239); ); cmb_last = 0; );
function load_patch(p) (
  p = min(max(floor(p + 0.5), 0), 99);
  cmb_clear(); patch_to(p, 0); slider1 = p; last_patch = p; au_auto(1);
  update();
