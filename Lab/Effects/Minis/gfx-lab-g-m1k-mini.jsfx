function eg_gate(on, retrig) instance(st, dt) (
  on ? ( retrig || st == 0 || st == 4 ? ( st = 1; dt = 0; ); ) : ( st > 0 ? st = 4; );
);
function eg(d, ai, dc, s, rc) instance(st, lv, dt) (
  st == 1 ? ( dt += 1; dt >= d ? st = 2; ) :
  st == 2 ? ( lv += ai; lv >= 1 ? ( lv = 1; st = 3; ); ) :
  st == 3 ? ( lv += (s - lv)*dc; ) :
  st == 4 ? ( lv += (0 - lv)*rc; lv < 0.00002 ? ( lv = 0; st = 0; ); );
  lv;
);

function lfo(rate, w) instance(ph, sh, nz, tg) local(y, wr) (
  ph += rate/srate; wr = ph >= 1; ph -= floor(ph);
  wr ? sh = rand(2) - 1;
  w == 0 ? y = 1 - 4*abs(ph - 0.5) :
  w == 1 ? y = 2*ph - 1 :
  w == 2 ? y = 1 - 2*ph :
  w == 3 ? y = ph < 0.5 ? 1 : -1 :
  w == 4 ? y = sh :
  ( (rand(1) < rate*12/srate) ? tg = rand(2) - 1; nz += (tg - nz)*min(1, rate*40/srate); y = nz; );
  y;
);

function vinit(p, u) instance(pan, uo, cur, tgt, nd, drA, drB, nwb) (
  nwb = NWV; NWV += 4;
  pan = p; uo = u; cur = 60; tgt = 60; nd = 1;
  drA.drift_init(0.8 + rand(1)*0.5); drB.drift_init(0.8 + rand(1)*0.5);
);
function vblock(inc) instance(df1, df2, drA, drB) (
  df1 = drA.drift_tick(inc)*drift*8;
  df2 = drB.drift_tick(inc)*drift*8;
);
function vstart(n, v, retrig) instance(cur, tgt, vel, vg, nd, r1, cnt, played, e1, e2, fi, nwb) (
  e2.lv < 0.05 ? ( fi = 0; nw_start(nwb); );
  tgt = n; vel = v/127; vg = 1 - VELS + VELS*vel;
  glide_k >= 1 || !played ? cur = n;
  retrig ? ( nd = ins_note_detune(); r1 = 0; );
  e1.eg_gate(1, retrig); e2.eg_gate(1, retrig);
  cnt = 0; played = 1;
);
function vstop() instance(e1, e2) ( e1.eg_gate(0, 0); e2.eg_gate(0, 0); );
function vglide(n) instance(tgt) ( tgt = n; );
function vrun() instance(e1, e2, flt, cur, tgt, vel, vg, nd, ph1, ph2, r1, cnt, inc1, inc2, pw1, pw2,
                         sh1, sh2, fc, rs, df1, df2, uo, e1v, fi, nwb)
                local(e2v, pe, p1, p2l, lp, vibc, base, oct, wrap, t, p2, o1, o2, y, f) (
  e2.st == 0 ? 0 : (
    e1v = e1.eg(E1D, E1A, E1DC, E1S, E1R);
    e2v = e2.eg(E2D, E2A, E2DC, E2S, E2R);
    r1 = min(1, r1 + L1DI);
    (cnt -= 1) <= 0 ? (
      cnt = 16;
      cur += (tgt - cur)*glide_k;
      pe = PENV*e1v;
      lp = L2D == 2 ? lfo2v*L2AMT*12 : 0;
      p1 = (PTGT ? pe : 0) + lp; p2l = pe + lp;
      vibc = lfo1v*(L1AMT*r1 + max(modw, atch)*50);
      base = cur - 69 + bend_st;
      inc1 = min(440*2^((base + D1F + p1 + (vibc + df1 + uo*UNI)/100)/12)*ins_pitch*nd/srate, 0.45);
      inc2 = min(440*2^((base + D2F + p2l + (vibc + df2 + D2DET + uo*UNI*0.7)/100 + ins_aux)/12)*ins_pitch*nd/srate, 0.45);
      pw1 = min(max(D1PW + (L2D == 0 ? lfo2v*L2AMT*0.45 : 0), 0.05), 0.95);
      pw2 = min(max(D2PW + (L2D == 0 ? lfo2v*L2AMT*0.45 : 0), 0.05), 0.95);
      sh1 = D1SH; sh2 = D2SH;
      oct = fl_ev*e1v*6 + VKEY*(cur - 60)/12 + VVEL*vel*5 + (L2D == 1 ? lfo2v*L2AMT*5 : 0);
      fc = min(max(exp(fl_c2 + oct*0.693147), 20), srate*0.45);
      rs = fl_rs*0.95;
    );
    ph1 += inc1; wrap = ph1 >= 1; ph1 -= floor(ph1);
    o1 = 0;
    D1W ? ( o1 = 2*ph1 - 1 - vo_blep(ph1, inc1); t = ph1 < 0.5 ? 4*ph1 - 1 : 3 - 4*ph1; o1 += (t - o1)*sh1; );
    D1P ? ( p2 = ph1 + 1 - pw1; p2 -= floor(p2); o1 += 0.8*((2*ph1 - 1 - vo_blep(ph1, inc1)) - (2*p2 - 1 - vo_blep(p2, inc1))); );
    SYNC && wrap ? ph2 = ph1*inc2/inc1 : ( ph2 += inc2; ph2 -= floor(ph2); );
    D2N ? o2 = rand(2) - 1 : (
      o2 = 0;
      D2W ? ( o2 = 2*ph2 - 1 - vo_blep(ph2, inc2); t = ph2 < 0.5 ? 4*ph2 - 1 : 3 - 4*ph2; o2 += (t - o2)*sh2; );
      D2P ? ( p2 = ph2 + 1 - pw2; p2 -= floor(p2); o2 += 0.8*((2*ph2 - 1 - vo_blep(ph2, inc2)) - (2*p2 - 1 - vo_blep(p2, inc2))); );
    );
    y = o1*(1 - MIX) + o2*MIX;
    f = VFM > 0 ? min(max(fc*2^(VFM*o1*2), 20), srate*0.45) : fc;
    y = flt.vo_ladder(y*0.45, f, rs, 0);
    fi < 1 ? ( y *= 0.5 - 0.5*cos($pi*fi); fi = min(fi + FIS, 1); );
    nw_run(nwb, y*e2v*vg);
  );
);

function v_start(i, n, v, r) (
  glide_k = GKA;
  i == 0 ? v0.vstart(n, v, r) : i == 1 ? v1.vstart(n, v, r) : i == 2 ? v2.vstart(n, v, r) :
  i == 3 ? v3.vstart(n, v, r) : i == 4 ? v4.vstart(n, v, r) : v5.vstart(n, v, r);
  glide_k = GKB;
  i == 0 ? w0.vstart(n, v, r) : i == 1 ? w1.vstart(n, v, r) : i == 2 ? w2.vstart(n, v, r) :
  i == 3 ? w3.vstart(n, v, r) : i == 4 ? w4.vstart(n, v, r) : w5.vstart(n, v, r);
  glide_k = GKA;
);
function v_stop(i) (
  i == 0 ? v0.vstop() : i == 1 ? v1.vstop() : i == 2 ? v2.vstop() : i == 3 ? v3.vstop() : i == 4 ? v4.vstop() : v5.vstop();
  i == 0 ? w0.vstop() : i == 1 ? w1.vstop() : i == 2 ? w2.vstop() : i == 3 ? w3.vstop() : i == 4 ? w4.vstop() : w5.vstop();
);
function v_glide(i, n) (
  i == 0 ? v0.vglide(n) : i == 1 ? v1.vglide(n) : i == 2 ? v2.vglide(n) : i == 3 ? v3.vglide(n) : i == 4 ? v4.vglide(n) : v5.vglide(n);
  i == 0 ? w0.vglide(n) : i == 1 ? w1.vglide(n) : i == 2 ? w2.vglide(n) : i == 3 ? w3.vglide(n) : i == 4 ? w4.vglide(n) : w5.vglide(n);
);
function v_idle(i) (
  (i == 0 ? v0.e2.st == 0 : i == 1 ? v1.e2.st == 0 : i == 2 ? v2.e2.st == 0 :
   i == 3 ? v3.e2.st == 0 : i == 4 ? v4.e2.st == 0 : v5.e2.st == 0) &&
  (!lbon || (i == 0 ? w0.e2.st == 0 : i == 1 ? w1.e2.st == 0 : i == 2 ? w2.e2.st == 0 :
   i == 3 ? w3.e2.st == 0 : i == 4 ? w4.e2.st == 0 : w5.e2.st == 0));
);

function all_off() local(i) (
  i = 0; loop(NV, VG[i] ? v_stop(i); VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; );
  hcount = 0;
);
function poly_on(n, v) local(i, best, ba) (
  best = -1;
  i = 0; loop(NV, VN[i] == n ? best = i; i += 1; );
  best < 0 ? ( ba = -1; i = 0; loop(NV, v_idle(i) && (best < 0 || VT[i] < ba) ? ( best = i; ba = VT[i]; ); i += 1; ); );
  best < 0 ? ( ba = -1; i = 0; loop(NV, !VG[i] && (best < 0 || VT[i] < ba) ? ( best = i; ba = VT[i]; ); i += 1; ); );
  best < 0 ? ( ba = -1; i = 0; loop(NV, best < 0 || VT[i] < ba ? ( best = i; ba = VT[i]; ); i += 1; ); );
  vage += 1; VT[best] = vage; VN[best] = n; VG[best] = 1; VS[best] = 0;
  v_start(best, n, v, 1);
);
function poly_off(n) local(i) (
  i = 0; loop(NV, VN[i] == n && VG[i] ? ( pedal ? VS[i] = 1 : ( v_stop(i); VG[i] = 0; ); ); i += 1; );
);
function m_start(n, v, r) local(i) ( vmode == 2 ? ( i = 0; loop(NV, v_start(i, n, v, r); VG[i] = 1; VN[i] = n; i += 1; ); ) : ( v_start(0, n, v, r); VG[0] = 1; VN[0] = n; ); );
function m_glide(n) local(i) ( vmode == 2 ? ( i = 0; loop(NV, v_glide(i, n); i += 1; ); ) : v_glide(0, n); );
function m_stop() local(i) ( vmode == 2 ? ( i = 0; loop(NV, v_stop(i); VG[i] = 0; i += 1; ); ) : ( v_stop(0); VG[0] = 0; ); );
function mono_on(n, v) local(i, f, legato) (
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  legato ? ( m_glide(n); m_start(n, v, 0); ) : m_start(n, v, 1);
);
function mono_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? m_glide(HN[hcount - 1]) : ( pedal ? msus = 1 : m_stop(); );
  );
);
function note_on(n, v) ( vmode ? mono_on(n, v) : poly_on(n, v); );
function note_off(n) ( vmode ? mono_off(n) : poly_off(n); );
function pedal_up() local(i) (
  i = 0; loop(NV, VS[i] ? ( v_stop(i); VG[i] = 0; VS[i] = 0; ); i += 1; );
  msus && hcount == 0 ? m_stop(); msus = 0;
);
function q_push(ofs, t, n, v) local(i) (
  qcount < 300 ? (
    i = qcount; while (i > 0 && EQO[i - 1] > ofs) ( EQO[i] = EQO[i - 1]; EQT[i] = EQT[i - 1]; EQN[i] = EQN[i - 1]; EQV[i] = EQV[i - 1]; i -= 1; );
    EQO[i] = ofs; EQT[i] = t; EQN[i] = n; EQV[i] = v; qcount += 1;
  );
);

function ms_(ms) ( 1 - exp(-4.6/(max(ms, 0.5)*0.001*srate)); );

mrCHN = 16384; mrDLN = floor(srate*2.2) + 8;
mrChA = MR; mrChB = MR + mrCHN; mrChC = MR + 2*mrCHN;
mrDlA = MR + 3*mrCHN; mrDlB = mrDlA + mrDLN; mrDlC = mrDlB + mrDLN;
mrVsC = mrDlC + mrDLN; mrVsT = mrVsC + 48; mrVsV = mrVsT + 48; mrPre = mrVsV + 48; mrDls = mrPre + 4; mrRg = mrDls + 8; mrVbF = mrRg + 24;
memset(MR, 0, mrVbF + 4 - MR);
mrVsT[0] = mrVsT[16] = mrVsT[32] = 1;
mrVbF[0] = 60; mrVbF[1] = 180; mrVbF[2] = 480; mrVbF[3] = 1300;
mrCw = 1 - exp(-1/(0.15*srate)); mrCs = 1 - exp(-1/(3*srate)); mrCd = 1 - exp(-1/(0.8*srate)); mrCdr = 1 - exp(-1/(3*srate));
function mr_opc(fc) ( 1 - exp(-2*$pi*min(fc, srate*0.45)/srate); );
function mr_tanh(v) ( v = max(-20, min(20, v)); 1 - 2/(exp(2*v) + 1); );
mrK = 1 - exp(-1/(0.02*srate));
function mr_clr() ( memset(MR, 0, mrVbF - MR); mrVsT[0] = mrVsT[16] = mrVsT[32] = 1; );
mrVbLp = mr_opc(160); mrVbAt = 1 - exp(-1/(0.008*srate));
mrDlLc = mr_opc(3500); mrDlHc = mr_opc(70); mrDlTs = 1 - exp(-1/(0.25*srate)); mrDlT = 350;
function mr_div(i, md) (
  (i == 0 ? 4*mrBar : i == 1 ? 2*mrBar : i == 2 ? mrBar : i == 3 ? 2 : i == 4 ? 1 : i == 5 ? 0.5 : i == 6 ? 0.25 : 0.125)*(md == 2 ? 1.5 : md == 3 ? 2/3 : 1);
);
function mr_hread(buf, n, pos) local(i, f, xm1, x0, x1, x2, c1, c2, c3) (
  pos < 0 ? pos += n; pos >= n ? pos -= n;
  i = floor(pos); f = pos - i;
  xm1 = buf[(i - 1 + n) % n]; x0 = buf[i]; x1 = buf[(i + 1) % n]; x2 = buf[(i + 2) % n];
  c1 = 0.5*(x1 - xm1); c2 = xm1 - 2.5*x0 + 2*x1 - 0.5*x2; c3 = 0.5*(x2 - xm1) + 1.5*(x0 - x1);
  ((c3*f + c2)*f + c1)*f + x0;
);
function mr_rgen(q, period, coef) ( q[0] -= 1; q[0] <= 0 ? ( q[0] = period*srate; q[1] = rand(2) - 1; ); q[2] += coef*(q[1] - q[2]); q[2]; );
function mr_ch(buf, phoff, vs) local(lf, dms, y) (
  lf = sin(2*$pi*(mrChPh + phoff));
  dms = mrChBase + mrChDep*lf + mrWarb;
  y = mr_hread(buf, mrCHN, mrChW - max(1, dms)*srate*0.001);
  vs[2] += mrChPc*(y - vs[2]); vs[3] += mrChPc*(vs[2] - vs[3]);
  vs[3];
);
function mr_tr(phoff, vs) local(sv, sh, g) (
  sv = sin(2*$pi*(mrTrPh + phoff));
  sh = mrTrK > 1.01 ? mr_tanh(mrTrK*sv)/mrTrTk : sv;
  g = 1 - mrTrDep*(0.5 - 0.5*sh);
  vs[0] += mrTrLag*(g - vs[0]); vs[0];
);
function mr_vb(x, phoff, vs) local(q, pw, lf, c, rr, oc, k, y, f, t, a1, xi) (
  q = mrVbPh + phoff; q -= floor(q);
  pw = q < mrVbSk ? 0.5*q/mrVbSk : 0.5 + 0.5*(q - mrVbSk)/(1 - mrVbSk);
  lf = 0.5 - 0.5*cos(2*$pi*pw);
  c = lf > vs[8] ? mrVbAt : mrVbRl; vs[8] += c*(lf - vs[8]); rr = vs[8];
  oc = mrVbOct*rr; y = x; k = 0;
  loop(4, f = min(srate*0.45, mrVbF[k]*2^oc); t = tan($pi*f/srate); a1 = (t - 1)/(t + 1);
    xi = y; y = a1*xi + vs[k*2] - a1*vs[k*2 + 1]; vs[k*2] = xi; vs[k*2 + 1] = y; k += 1; );
  vs[9] += mrVbLp*(x - vs[9]);
