);
function mr_loop(y, q) local(v) ( q[0] += mrDlLc*(y - q[0]); q[1] += mrDlHc*(q[0] - q[1]); v = q[0] - q[1]; mr_tanh(v*mrFbE*1.15)/1.15; );
function mr_update() local(st, fclk, chop, asym) (
  mrChLo = slider84 > 0.5; mrChCo = slider85 > 0.5; mrChRo = slider86 > 0.5;
  mrTrLo = slider94 > 0.5; mrTrCo = slider95 > 0.5; mrTrRo = slider96 > 0.5;
  mrVbLo = slider104 > 0.5; mrVbCo = slider105 > 0.5; mrVbRo = slider106 > 0.5;
  mrDlLo = slider114 > 0.5; mrDlCo = slider115 > 0.5; mrDlRo = slider116 > 0.5;
  st = slider83/100;
  mrChBase = 7 + 18*st; mrSt = st;
  fclk = 40000*(1 - 0.88*st);
  mrChPc = mr_opc(min(14000, fclk*0.42));
  mrChMix_t = fx_ch >= 0.5 ? (slider82 > 0 ? slider82 : 50)/100 : 0;
  mrChDep_t = min(slider81*fx_dm, 100)/100*(3 + 4*st);
  chop = slider93/100; mrTrK = 1 + 40*chop*chop; mrTrTk = mr_tanh(mrTrK); mrTrDep_t = fx_tr >= 0.5 ? min((slider91 > 0 ? slider91 : 50)*fx_dm, 100)/100 : 0;
  mrTrLag = 1 - exp(-1/((0.3 + 5.7*(1 - chop))*0.001*srate));
  asym = slider103/100; mrVbSk = 0.5 - 0.38*asym; mrVbRl = 1 - exp(-1/((0.04 + 0.25*asym)*srate));
  mrVbTh = 0.9*asym; mrVbD_t = fx_vb >= 0.5 ? min((slider101 > 0 ? slider101 : 50)*fx_dm, 100)/100 : 0;
  mrRun = slider113/100; mrFbE = 0.95*slider111/95 + 0.30*mrRun; mrDlMix = slider112/100;
);
function mr_block() (
  mrBar = ts_denom > 0 ? ts_num*4/ts_denom : 4;
  mrPlay = play_state & 1; mrBpos = beat_position; mrBpInc = tempo/(60*srate);
  mrChSy = slider87 > 0.5; mrChQn = mr_div(slider88, slider87);
  mrTrSy = slider97 > 0.5; mrTrQn = mr_div(slider98, slider97);
  mrVbSy = slider107 > 0.5; mrVbQn = mr_div(slider108, slider107);
  mrDlTgt = slider117 > 0.5 && tempo > 0 ? min(1500, mr_div(slider118, slider117)*60000/tempo) : slider110;
  mrOn = mrChMix_t > 0 || mrTrDep_t > 0 || mrVbD_t > 0 || mrDlMix > 0 || mrChMix > 0 || mrTrDep > 0 || mrVbD > 0;
  mrOn && !mr_was ? mr_clr();
  mr_was = mrOn;
);
function mr_run() local(xl, xr, m, dl, dr, y, sp, kc, ws, wc, dsm, dmod, ya, yb, yc) (
  xl = mrL; xr = mrR; m = 0.5*(xl + xr); dl = dr = 0;
  mrBpos += mrBpInc;
  mrChMix += (mrChMix_t - mrChMix)*mrK; mrChDep += (mrChDep_t - mrChDep)*mrK; mrTrDep += (mrTrDep_t - mrTrDep)*mrK; mrVbD += (mrVbD_t - mrVbD)*mrK;
  mrChMix_t == 0 && mrChMix < 0.00001 ? mrChMix = 0; mrTrDep_t == 0 && mrTrDep < 0.00001 ? mrTrDep = 0; mrVbD_t == 0 && mrVbD < 0.00001 ? mrVbD = 0;
  mrVbOct = 3*mrVbD; mrVbWet = min(1, 2*mrVbD);
  mrChSy ? mrChPh = (mrPlay ? mrBpos/mrChQn : mrChPh + mrBpInc/mrChQn) : mrChPh += slider80*fx_rm/srate;
  mrTrSy ? mrTrPh = (mrPlay ? mrBpos/mrTrQn : mrTrPh + mrBpInc/mrTrQn) : mrTrPh += slider90*fx_rm/srate;
  mrVbSy ? mrVbPh = (mrPlay ? mrBpos/mrVbQn : mrVbPh + mrBpInc/mrVbQn) : mrVbPh += slider100*fx_rm/srate;
  mrChPh -= floor(mrChPh); mrTrPh -= floor(mrTrPh); mrVbPh -= floor(mrVbPh);
