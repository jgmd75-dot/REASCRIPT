desc:RS50 Mini [drum machine] (GFX Lab)
//tags: instrument drum machine rhythm digital analogue sequencer lo-fi mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-thick, gfx-lab-ui, gfx-lab-panel, gfx-lab-power (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc

slider1:0<0,2,1{RS50,RS70,RS90}>-Machine
slider2:50<0,100,1>-Accent (%)
slider3:0<0,100,1>-Swing (%)
slider4:0<0,1,1{Off,On}>-Follow transport
slider5:0<-18,6,0.1>-Level (dB)
slider6:50<0,100,1>-Drift (%)
slider7:0<0,1,1{Off,On}>-Thick
slider8:0<0,100,1>-Kick delay (%)
slider9:0<0,100,1>-Kick phaser (%)
slider10:0<0,100,1>-Snare delay (%)
slider11:0<0,100,1>-Snare phaser (%)
slider12:0<0,100,1>-Rim delay (%)
slider13:0<0,100,1>-Rim phaser (%)
slider14:0<0,100,1>-Clap delay (%)
slider15:0<0,100,1>-Clap phaser (%)
slider16:0<0,100,1>-Comp (%)
slider17:0<0,100,1>-Closed hat delay (%)
slider18:0<0,100,1>-Closed hat phaser (%)
slider19:0<0,100,1>-Open hat delay (%)
slider20:0<0,100,1>-Open hat phaser (%)
slider21:0<0,100,1>-Drive (%)
slider22:0<0,100,1>-Tom delay (%)
slider23:0<0,100,1>-Tom phaser (%)
slider24:0<0,100,1>-Perc delay (%)
slider25:0<0,100,1>-Perc phaser (%)
slider28:0<0,1,1{1,2}>-RS70 kick type
slider29:0<0,1,1{1,2}>-RS70 snare type
slider30:0<-12,12,0.1>-Kick tune (st)
slider31:100<0,100,1>-Kick decay (%)
slider32:80<0,100,1>-Kick level (%)
slider33:0<-100,100,1>-Kick pan
slider34:0<-12,12,0.1>-Snare tune (st)
slider35:100<0,100,1>-Snare decay (%)
slider36:70<0,100,1>-Snare level (%)
slider37:0<-100,100,1>-Snare pan
slider38:0<-12,12,0.1>-Rim tune (st)
slider39:100<0,100,1>-Rim decay (%)
slider40:60<0,100,1>-Rim level (%)
slider41:20<-100,100,1>-Rim pan
slider42:0<-12,12,0.1>-Clap tune (st)
slider43:100<0,100,1>-Clap decay (%)
slider44:65<0,100,1>-Clap level (%)
slider45:-10<-100,100,1>-Clap pan
slider46:0<-12,12,0.1>-Closed hat tune (st)
slider47:100<0,100,1>-Closed hat decay (%)
slider48:60<0,100,1>-Closed hat level (%)
slider49:30<-100,100,1>-Closed hat pan
slider50:0<-12,12,0.1>-Open hat tune (st)
slider51:100<0,100,1>-Open hat decay (%)
slider52:60<0,100,1>-Open hat level (%)
slider53:30<-100,100,1>-Open hat pan
slider54:0<-12,12,0.1>-Tom tune (st)
slider55:100<0,100,1>-Tom decay (%)
slider56:65<0,100,1>-Tom level (%)
slider57:0<-100,100,1>-Tom pan
slider58:0<-12,12,0.1>-Perc tune (st)
slider59:100<0,100,1>-Perc decay (%)
slider60:60<0,100,1>-Perc level (%)
slider61:-25<-100,100,1>-Perc pan
slider62:0<0,100,1>-Sat (%)
slider64:prs_sel=0<0,12,1{No preset,Init,Latin Groove,Dub Bells,Funk Shuffle,Electro Funk,Italo Disco,Lo-Fi Tape,Arena Rock,Detroit Techno,Chicago House,Acid Rave,Warehouse}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-g-rs50-mini";
ext_noinit = 1;
ui_thm = 5; ui_hw = 1;
gfx_ext_retina = 1;
CR = 16;
BR = 25000;

ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
thk_init();  thk_lift = 3.5;  thk_drv = 1.7;  thk_asym = 0.15;  thk_tr = 1.0;  thk_trim = 0;

PAT = 1000;  MUTE = 1140;
GRV = 10000;
QV = 20000;  PQ = 20400;
PHL = 21000;  PHR = 21010;  memset(PHL, 0, 20);
ENVS = 21100;  ENVV = 21300;  ENVA = 21400;
VTU = 21500;  VGL = 21600;  VPN = 21700;  VDK = 21800;  VLN = 21900;  VDL = 22000;  VDP = 22100;
LMAP = 22200;  LSI = 24100;  FXP = 24120;  VLX = 24000;  LWD = 24050;  LWP = 24060;  SWD = 24070;  SWP = 24080;  A_SN = 22300;  B_SN = 22400;  A_VTR = 22500;  B_VTR = 22600;
PDS = 22700;  TOL = 22800;  VLT = 22900;  NM = 23000;  TLM = 23500;
DLB = 200000;  DRB = 600000;
DSZ = floor(2 * srate) + 4;
MODS = 1189000;  BKP = 1190000;
BK_CH = 1700000;  BL_CH = 9600;
BK_OH = 1710000;  BL_OH = 38400;
BK_CR = 1750000;  BL_CR = 41600;
BK_RD = 1800000;  BL_RD = 35200;

function lmap_(m, a0, a1, a2, a3, a4, a5, a6, a7) (
  LMAP[m * 8] = a0;  LMAP[m * 8 + 1] = a1;  LMAP[m * 8 + 2] = a2;  LMAP[m * 8 + 3] = a3;
  LMAP[m * 8 + 4] = a4;  LMAP[m * 8 + 5] = a5;  LMAP[m * 8 + 6] = a6;  LMAP[m * 8 + 7] = a7;
);
lmap_(0, 0, 1, 5, 6, 7, 8, 3, 12);
lmap_(1, 16, 17, 21, 23, 25, 26, 19, 22);
lmap_(2, 32, 33, 37, 38, 39, 40, 35, 42);
function vx(e, ln, lv, pn) ( VLN[e] = ln;  VDL[e] = lv;  VDP[e] = pn; );
i = 0;  loop(16, LSI[i] = i == 0 ? 8 : i == 1 ? 9 : i == 2 ? 10 : i == 3 ? 11 : i == 4 ? 12 : i == 5 ? 13 : i == 6 ? 14 : i == 7 ? 15 : i == 8 ? 17 : i == 9 ? 18 : i == 10 ? 19 : i == 11 ? 20 : i == 12 ? 22 : i == 13 ? 23 : i == 14 ? 24 : 25;  i += 1; );
FXP[0] = 0.4;  FXP[1] = 60;  FXP[2] = 40;  FXP[3] = 50;  FXP[4] = 40;  FXP[5] = 50;  FXP[6] = -12;  FXP[7] = 4;  FXP[8] = 0;  FXP[9] = 2;  FXP[10] = 1;  FXP[11] = 300;  FXP[12] = 3;  FXP[13] = 35;  FXP[14] = 40;  FXP[15] = 25;
i = 0;  loop(48, vx(i, -1, 50, 0);  i += 1; );
vx(0, 0, 0, 0);  vx(1, 1, 0, 0);  vx(2, 6, 0, -40);  vx(3, 6, 0, 0);  vx(4, 6, 0, 40);  vx(5, 2, 0, 0);  vx(6, 3, 0, 0);  vx(7, 4, 0, 0);
vx(8, 5, 0, 0);  vx(9, -1, 50, -30);  vx(10, -1, 50, 35);  vx(11, 7, 0, -50);  vx(12, 7, 0, 0);  vx(13, -1, 55, 25);  vx(14, -1, 55, -25);  vx(15, -1, 55, 20);
vx(16, 0, 0, 0);  vx(17, 1, 0, 0);  vx(18, 6, 0, -40);  vx(19, 6, 0, 0);  vx(20, 6, 0, 40);  vx(21, 2, 0, 0);  vx(22, 7, 0, 0);  vx(23, 3, 0, 0);
vx(24, -1, 55, 15);  vx(25, 4, 0, 0);  vx(26, 5, 0, 0);  vx(27, -1, 50, -30);  vx(28, -1, 50, 35);
vx(32, 0, 0, 0);  vx(33, 1, 0, 0);  vx(34, 6, 0, -40);  vx(35, 6, 0, 0);  vx(36, 6, 0, 40);  vx(37, 2, 0, 0);  vx(38, 3, 0, 0);  vx(39, 4, 0, 0);
vx(40, 5, 0, 0);  vx(41, -1, 50, -30);  vx(42, 7, 0, 0);

i = 0;  loop(384, NM[i] = -1;  i += 1; );
function nmap_(m, n, e) ( NM[m * 128 + n] = e; );
nmap_(0, 36, 0);  nmap_(0, 35, 0);  nmap_(0, 38, 1);  nmap_(0, 40, 1);  nmap_(0, 41, 2);  nmap_(0, 43, 2);  nmap_(0, 45, 3);  nmap_(0, 47, 3);  nmap_(0, 48, 4);  nmap_(0, 50, 4);
nmap_(0, 37, 5);  nmap_(0, 39, 6);  nmap_(0, 42, 7);  nmap_(0, 44, 7);  nmap_(0, 46, 8);  nmap_(0, 49, 9);  nmap_(0, 57, 9);  nmap_(0, 51, 10);  nmap_(0, 59, 10);
nmap_(0, 64, 11);  nmap_(0, 63, 12);  nmap_(0, 62, 12);  nmap_(0, 65, 13);  nmap_(0, 66, 13);  nmap_(0, 68, 14);  nmap_(0, 56, 15);
nmap_(1, 36, 16);  nmap_(1, 35, 16);  nmap_(1, 38, 17);  nmap_(1, 40, 17);  nmap_(1, 41, 18);  nmap_(1, 43, 18);  nmap_(1, 45, 19);  nmap_(1, 47, 19);  nmap_(1, 48, 20);  nmap_(1, 50, 20);
nmap_(1, 37, 21);  nmap_(1, 56, 22);  nmap_(1, 39, 23);  nmap_(1, 54, 24);  nmap_(1, 42, 25);  nmap_(1, 44, 25);  nmap_(1, 46, 26);  nmap_(1, 49, 27);  nmap_(1, 57, 27);  nmap_(1, 51, 28);  nmap_(1, 59, 28);
nmap_(2, 36, 32);  nmap_(2, 35, 32);  nmap_(2, 38, 33);  nmap_(2, 40, 33);  nmap_(2, 41, 34);  nmap_(2, 43, 34);  nmap_(2, 45, 35);  nmap_(2, 47, 35);  nmap_(2, 48, 36);  nmap_(2, 50, 36);
nmap_(2, 37, 37);  nmap_(2, 39, 38);  nmap_(2, 42, 39);  nmap_(2, 44, 39);  nmap_(2, 46, 40);  nmap_(2, 49, 41);  nmap_(2, 57, 41);  nmap_(2, 51, 42);  nmap_(2, 59, 42);

function tlm_(m, t, ln) ( TLM[m * 16 + t] = ln; );
i = 0;  loop(48, TLM[i] = -1;  i += 1; );
tlm_(0, 0, 0);  tlm_(0, 1, 1);  tlm_(0, 2, 6);  tlm_(0, 3, 6);  tlm_(0, 4, 6);  tlm_(0, 5, 2);  tlm_(0, 6, 3);  tlm_(0, 7, 4);  tlm_(0, 8, 5);  tlm_(0, 11, 7);  tlm_(0, 12, 7);
tlm_(1, 0, 0);  tlm_(1, 1, 1);  tlm_(1, 2, 6);  tlm_(1, 3, 6);  tlm_(1, 4, 6);  tlm_(1, 5, 2);  tlm_(1, 6, 7);  tlm_(1, 7, 3);  tlm_(1, 9, 4);  tlm_(1, 10, 5);
tlm_(2, 0, 0);  tlm_(2, 1, 1);  tlm_(2, 2, 6);  tlm_(2, 3, 6);  tlm_(2, 4, 6);  tlm_(2, 5, 2);  tlm_(2, 6, 3);  tlm_(2, 7, 4);  tlm_(2, 8, 5);  tlm_(2, 10, 7);
function g_row(m, n, t, str) local(i, c, b, v) (
  TLM[m * 16 + t] >= 0 ? (
    b = GRV + ((m * 15 + n) * 8 + TLM[m * 16 + t]) * 16;  i = 0;
    loop(16, c = str_getchar(str, i);  v = c == 88 ? 2 : c == 120 ? 1 : 0;  b[i] = max(b[i], v);  i += 1; );
  );
);
memset(GRV, 0, 3 * 15 * 128);
g_row(0, 0, 0, "X......x..X.....");  g_row(0, 0, 5, "..x..x....x..x..");  g_row(0, 0, 7, "x.x.x.x.x.x.x.x.");  g_row(0, 0, 11, "...x..x....x..x.");  g_row(0, 0, 12, "..x.......x.....");  g_row(0, 0, 13, "........x.....x.");  g_row(0, 0, 15, "x...x...x...x...");
g_row(0, 1, 0, "X...X...X...X...");  g_row(0, 1, 1, "....X.......X...");  g_row(0, 1, 6, "....X.......X...");  g_row(0, 1, 7, "x...x...x...x...");  g_row(0, 1, 8, "..x...x...x...x.");
g_row(0, 2, 0, "X..x..x.X..x..x.");  g_row(0, 2, 5, "x..x..x...x..x..");  g_row(0, 2, 7, "xxxxxxxxxxxxxxxx");
g_row(0, 3, 0, "X...X...X...X...");  g_row(0, 3, 1, "....X.......X...");  g_row(0, 3, 6, "....x.......x...");  g_row(0, 3, 8, "..X...X...X...X.");  g_row(0, 3, 15, "x.x.x.x.x.x.x.x.");
g_row(0, 4, 0, "X.x....x..x.....");  g_row(0, 4, 1, "....X..x.x..X...");  g_row(0, 4, 7, "x.x.x.x.x.x.x.xX");  g_row(0, 4, 8, "..............x.");  g_row(0, 4, 14, "......x.......x.");
g_row(0, 5, 0, "X..x..x...X.....");  g_row(0, 5, 1, "....X.......X...");  g_row(0, 5, 7, "x.x.x.x.x.x.x.x.");  g_row(0, 5, 14, "...x......x.....");  g_row(0, 5, 15, "......x.......x.");
g_row(0, 6, 0, "X......x.xX.....");  g_row(0, 6, 1, "....X.......X...");  g_row(0, 6, 7, "x.x.x.x.x.x.x.x.");
g_row(0, 7, 0, "X..xX..xX..xX..x");  g_row(0, 7, 1, "..x...x...x...x.");  g_row(0, 7, 7, "xxxxxxxxxxxxxxxx");  g_row(0, 7, 12, "..x...x...x...x.");  g_row(0, 7, 13, "x.......x.x.....");  g_row(0, 7, 15, "x.x..x.x.x..x.x.");
g_row(0, 8, 0, "X..x....X..x....");  g_row(0, 8, 5, "x..x..x...x.x...");  g_row(0, 8, 11, "x.x..x.x.x.x..x.");  g_row(0, 8, 12, "...x.......x....");  g_row(0, 8, 13, "..x.....x....x..");  g_row(0, 8, 15, "x...x...x...x...");
g_row(0, 9, 0, "X.......X.......");  g_row(0, 9, 7, "x.x.x.x.x.x.x.x.");  g_row(0, 9, 11, "x.x.....x.x.....");  g_row(0, 9, 12, "....x.xx....x.xx");  g_row(0, 9, 15, "x...x...x...x...");
g_row(0, 10, 0, "X.....X.X.....X.");  g_row(0, 10, 11, "x...x.....x.....");  g_row(0, 10, 12, "..x...x...x.x.x.");  g_row(0, 10, 13, "....x.......x..x");  g_row(0, 10, 14, "x.x.x.x.x.x.x.x.");
g_row(0, 11, 0, "........X.......");  g_row(0, 11, 5, "........X.......");  g_row(0, 11, 7, "..x...x...x...x.");
g_row(0, 12, 0, "X.......X.x.....");  g_row(0, 12, 1, "....X.......X...");  g_row(0, 12, 7, "x.x.x.x.x.x.x.x.");
g_row(0, 13, 5, "x..x..x...x.x...");  g_row(0, 13, 11, "x..x.x..x.xx.x..");  g_row(0, 13, 12, "..x..x.x..x..x.x");  g_row(0, 13, 15, "x...x...x...x...");
g_row(0, 14, 0, "X.......X.......");  g_row(0, 14, 1, "............XXXX");  g_row(0, 14, 2, "........x..x..x.");  g_row(0, 14, 3, "....x..x.....x..");  g_row(0, 14, 4, "x..x..x.........");  g_row(0, 14, 9, "X...............");
g_row(1, 0, 0, "X......x..X.....");  g_row(1, 0, 1, "....X.......X...");  g_row(1, 0, 6, "...x......x.....");  g_row(1, 0, 7, "....X.......X...");  g_row(1, 0, 9, "x.xxx.xxx.xxx.xx");  g_row(1, 0, 10, "......x.......x.");
g_row(1, 1, 0, "X...X...X...X...");  g_row(1, 1, 1, "....X.......X...");  g_row(1, 1, 8, "..x...x...x...x.");  g_row(1, 1, 9, "x.x.x.x.x.x.x.x.");
g_row(1, 2, 0, "X..x..x...x.....");  g_row(1, 2, 1, "....X.......X...");  g_row(1, 2, 6, "..x.....x.x.....");  g_row(1, 2, 7, "....X.......X..x");  g_row(1, 2, 9, "XxxxXxxxXxxxXxxx");
g_row(1, 3, 0, "X...X...X...X...");  g_row(1, 3, 1, "....X.......X...");  g_row(1, 3, 8, "x.x.x.x.x.x.x.x.");  g_row(1, 3, 10, "..x...x...x...x.");
g_row(1, 4, 0, "X..x..X...x..x..");  g_row(1, 4, 1, "....X.......X...");  g_row(1, 4, 5, "..x.....x.....x.");  g_row(1, 4, 8, "....x.......x...");  g_row(1, 4, 9, "x.x.x.x.x.x.x.x.");
g_row(1, 5, 0, "X......x.xX.....");  g_row(1, 5, 1, "....X.......X...");  g_row(1, 5, 9, "x.x.x.x.x.x.x.xX");  g_row(1, 5, 10, "..............x.");
g_row(1, 6, 0, "X.....X...X.....");  g_row(1, 6, 6, "..x.......x.....");  g_row(1, 6, 7, "....X.......X...");  g_row(1, 6, 9, "xxxxxxxxxxxxxxxx");
g_row(1, 7, 0, "X.x....x..x.....");  g_row(1, 7, 1, "....X..x.x..X...");  g_row(1, 7, 8, "....x.......x...");  g_row(1, 7, 9, "x.x.x.x.x.x.x.xX");
g_row(1, 8, 0, "X.....x.X.....x.");  g_row(1, 8, 1, "....X.......X...");  g_row(1, 8, 9, "x..x.xx..x.xx..x");
g_row(1, 9, 0, "X.......X.x.....");  g_row(1, 9, 1, "....X.......X...");  g_row(1, 9, 9, "x.x.x.x.x.x.x.x.");
g_row(1, 10, 0, "X...X.x.X...X...");  g_row(1, 10, 1, "....X.......X...");  g_row(1, 10, 9, "x.x.x.x.x.x.x.x.");  g_row(1, 10, 11, "X...............");
g_row(1, 11, 0, "X.....x.X.x.....");  g_row(1, 11, 1, "....X.......X...");  g_row(1, 11, 9, "x.x.x.x.x.x.x.x.");  g_row(1, 11, 11, "X...............");
