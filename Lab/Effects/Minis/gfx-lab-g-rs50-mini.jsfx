g_row(2, 11, 0, "X..x..x...x.....");  g_row(2, 11, 1, "....X.......X...");  g_row(2, 11, 5, "..x.......x..x..");  g_row(2, 11, 6, "............X...");  g_row(2, 11, 7, "x.x.x.x.x.x.x.x.");
g_row(2, 12, 0, "X.x.......X..x..");  g_row(2, 12, 1, "....X..x.x..X...");  g_row(2, 12, 7, "x.x.x.x.x.x.x.x.");  g_row(2, 12, 8, "..............x.");
g_row(2, 13, 0, "X......x..X.....");  g_row(2, 13, 1, "....X.......X...");  g_row(2, 13, 5, "..x..x.....x..x.");  g_row(2, 13, 7, "x.x.x.x.x.x.x.x.");  g_row(2, 13, 8, "......x.......x.");
g_row(2, 14, 0, "X..x..X...x..x..");  g_row(2, 14, 2, "..x.....x.x.....");  g_row(2, 14, 3, ".....x.......x..");  g_row(2, 14, 4, "...x.......x....");  g_row(2, 14, 5, "x...x...x...x...");  g_row(2, 14, 7, "..x...x...x...x.");
function groove(m, n) ( memcpy(PAT, GRV + (m * 15 + n) * 128, 128); );
!seq_ok ? ( groove(0, 0);  memset(MUTE, 0, 8);  seq_ok = 1; );
memset(DLB, 0, DSZ);  memset(DRB, 0, DSZ);  dl_w = 0;

function db2g(d) ( exp(d * 0.11512925464970228); );
function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function st(c) ( 2 ^ (c / 12); );
function svf_set(f, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(f, 0.45 * srate) / srate);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;  lp = v2;  bp = v1;  hp = x - k * v1 - v2;  bp;
);
function noise() ( rand(2) - 1; );
function dck_set(last) instance(o, le) ( o = le; );
function dck(x) instance(o, le, ek) ( o *= dk_c;  le = o * (abs(o) > 0.000001) + x * ENVV[ek];  le; );

function rng() local(t) ( t = lcg_s * 16807;  lcg_s = t - floor(t / 2147483647) * 2147483647;  lcg_s / 1073741823.5 - 1; );
function op(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * BR) / BR); );
function bk_drum(dst, n_, f0, sw, ptau, atau, fb2, a2, clk, nlev, nhp, nlp, ntau) local(i, t, p1, p2, s, nz, l1, l2, c1, c2)
(
  p1 = p2 = l1 = l2 = 0;  c1 = op(nlp);  c2 = op(nhp);  i = 0;
  loop(n_, t = i / BR;
    p1 += f0 * (1 + sw * exp(-t / ptau)) / BR;  p1 -= floor(p1);
    p2 += fb2 * (1 + sw * 0.5 * exp(-t / ptau)) / BR;  p2 -= floor(p2);
    s = sin(2 * $pi * p1) * exp(-t / atau) + a2 * sin(2 * $pi * p2) * exp(-t / (atau * 0.6));
    nz = rng();  l1 += (nz - l1) * c1;  l2 += (l1 - l2) * c2;
    s += (l1 - l2) * nlev * exp(-t / ntau) + clk * exp(-t / 0.0009) * (0.6 + 0.4 * nz);
    dst[i] = ts(1.3 * s);  i += 1; );
);
function bk_svf(f, q) instance(g, k, a1, a2, a3, ic1, ic2) (
  g = tan($pi * min(f, 0.45 * BR) / BR);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  ic1 = ic2 = 0;
);
function bk_run(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;  lp = v2;  bp = v1;  hp = x - k * v1 - v2;  bp;
);
function bake_add(dst, n_, np, flo, fhi, tlo, thi, g, nlev, nhp, ntau) local(k, i, u, f, w, c, sn, s, nd, ne)
(
  k = 0;
  loop(np,
    u = (k + 0.5 + 0.4 * rng()) / np;  f = flo * (fhi / flo) ^ u;  w = 2 * $pi * f / BR;
    BKP[k] = cos(w);  BKP[64 + k] = sin(w);  u = $pi * (rng() + 1);  BKP[128 + k] = cos(u);  BKP[192 + k] = sin(u);
    BKP[256 + k] = g * (0.55 + 0.45 * rng()) / sqrt(np);  BKP[320 + k] = exp(-1 / (tlo * (thi / tlo) ^ (0.5 + 0.5 * rng()) * BR));
    k += 1; );
  BKN.bk_svf(nhp, 0.7);  nd = exp(-1 / (ntau * BR));  ne = 1;
  i = 0;
  loop(n_,
    s = 0;  k = 0;
    loop(np, c = BKP[128 + k];  sn = BKP[192 + k];
      BKP[128 + k] = c * BKP[k] - sn * BKP[64 + k];  BKP[192 + k] = c * BKP[64 + k] + sn * BKP[k];
      s += sn * BKP[256 + k];  BKP[256 + k] *= BKP[320 + k];  k += 1; );
    nlev > 0 ? ( BKN.bk_run(rng());  s += BKN.hp * nlev * ne;  ne *= nd; );
    dst[i] += s;  i += 1; );
);
function blep(t, dt) ( t < dt ? ( t /= dt;  t + t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt;  t * t + t + t + 1; ) : 0; );
function sqr_(p, dt) local(q) ( q = p + 0.5;  q -= floor(q);  (p < 0.5 ? 1 : -1) + blep(p, dt) - blep(q, dt); );
function bk_env(dst, n_, d, sus, r) local(i, t, g, e, eg) (
  g = 0.125;  eg = sus + (1 - sus) * exp(-g * 6.9 / d);  i = 0;
  loop(n_, t = i / BR;
    e = t < g ? sus + (1 - sus) * exp(-t * 6.9 / d) : r > 0 ? eg * exp(-(t - g) * 6.9 / r) : eg;
    dst[i] *= e;  i += 1; );
);

function a_clap(dst, n_) local(i, t, b, e, tl_, td) (
  BKC.bk_svf(1500, 2.0);  tl_ = 1;  td = exp(-1 / (0.08 * BR));  i = 0;
  loop(n_, t = i / BR;  b = floor(t / 0.0105);
    e = b < 3 ? exp(-(t - b * 0.0105) / 0.0045) : 0;  b >= 3 ? tl_ *= td;
    BKC.bk_run(rng());  dst[i] = BKC.bp * (e + (b >= 3 ? tl_ : 0)) * 2.2;  i += 1; );
);
function a_fin(dst, n_, att, bits) local(i, pk, y, e) (
  pk = 0.000001;  i = 0;
  loop(n_, e = min(1, i / (att * BR + 1)) * min(1, (n_ - i) / (0.06 * n_));  dst[i] *= e;  pk = max(pk, abs(dst[i]));  i += 1; );
  i = 0;
  loop(n_, y = dst[i] / pk;
    bits == 8 ? ( y = floor(y * 127.5 + 0.5) / 127.5; )
              : ( y = sign(y) * sqr(floor(sqrt(abs(y)) * 31 + 0.5) / 31); );
    dst[i] = y;  i += 1; );
);
function md(k, f, a, t) ( MODS[k * 3] = f;  MODS[k * 3 + 1] = a;  MODS[k * 3 + 2] = t; );
function bk_modes(dst, n_, nm_, sw, ptau, clk, clf, clq, clt, nlev, nhp, nlp, ntau, drv) local(i, t, k, s, pe, nz, l1, l2, c1, c2)
(
  k = 0;  loop(nm_, BKP[k] = 0;  k += 1; );
  BKC.bk_svf(clf, clq);  l1 = l2 = 0;  c1 = op(nlp);  c2 = op(nhp);  i = 0;
  loop(n_, t = i / BR;  pe = 1 + sw * exp(-t / ptau);  s = 0;  k = 0;
    loop(nm_, BKP[k] += MODS[k * 3] * pe / BR;  BKP[k] -= floor(BKP[k]);
      s += sin(2 * $pi * BKP[k]) * MODS[k * 3 + 1] * exp(-t / MODS[k * 3 + 2]);  k += 1; );
    nz = rng();  BKC.bk_run(nz);  s += BKC.bp * clk * exp(-t / clt);
    l1 += (nz - l1) * c1;  l2 += (l1 - l2) * c2;  s += (l1 - l2) * nlev * exp(-t / ntau);
    dst[i] = drv > 0 ? ts(s * drv) / drv : s;  i += 1; );
);
function a_slot(k, n_) ( A_SN[k * 2] = bptr;  A_SN[k * 2 + 1] = n_;  memset(bptr, 0, n_);  bptr += n_ + 64;  bptr - n_ - 64; );

function b_clap(dst, n_, k) local(i, t, b, e, tl_, td) (
  BKC.bk_svf(1150 * k, 2.2);  tl_ = 1;  td = exp(-k / (0.11 * BR));  i = 0;
  loop(n_, t = i / BR * k;  b = floor(t / 0.0105);
    e = b < 3 ? exp(-(t - b * 0.0105) / 0.0045) : 0;  b >= 3 ? tl_ *= td;
    BKC.bk_run(rng());  dst[i] = BKC.bp * (e + (b >= 3 ? tl_ : 0)) * 2.2;  i += 1; );
);
function b_cb(dst, n_) local(i, t, p1, p2, d1, d2, s) (
  BKC.bk_svf(2650, 1.4);  p1 = p2 = 0;  d1 = 545 / BR;  d2 = 815 / BR;  i = 0;
  loop(n_, t = i / BR;  p1 += d1;  p1 -= floor(p1);  p2 += d2;  p2 -= floor(p2);
    s = (sqr_(p1, d1) + sqr_(p2, d2)) * 0.5;
    BKC.bk_run(s);  dst[i] = BKC.bp * (0.7 * exp(-t / 0.012) + 0.3 * exp(-t / 0.22)) * 1.6;  i += 1; );
);
function b_fin(dst, n_, att, bits) local(i, pk, y, e) (
  pk = 0.000001;  i = 0;
  loop(n_, e = min(1, i / (att * BR + 1)) * min(1, (n_ - i) / (0.06 * n_));  dst[i] *= e;  pk = max(pk, abs(dst[i]));  i += 1; );
  i = 0;
  loop(n_, y = dst[i] / pk;
    bits == 8 ? ( y = sign(y) * log(1 + 255 * abs(y)) / log(256);  y = floor(y * 127 + 0.5) / 127;
                  y = sign(y) * (256 ^ abs(y) - 1) / 255; )
              : ( y = sign(y) * sqr(floor(sqrt(abs(y)) * 31 + 0.5) / 31); );
    dst[i] = y;  i += 1; );
);
function b_slot(k, base, n_) ( B_SN[k * 2] = base;  B_SN[k * 2 + 1] = n_;  memset(base, 0, n_); );

function c_svf(f, q) instance(g, k, a1, a2, a3, ic1, ic2) (
  g = tan($pi * f / 32000);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  ic1 = ic2 = 0;
);
function c_bake_add(dst, n_, np, flo, fhi, tlo, thi, g, nlev, nhp, ntau) local(k, i, u, f, w, c, sn, s, nd, ne, n, v1, v2, v3)
(
  k = 0;
  loop(np,
    u = (k + 0.5 + 0.8 * rng() * 0.5) / np;  f = flo * (fhi / flo) ^ u;  w = 2 * $pi * f / 32000;
    BKP[k] = cos(w);  BKP[64 + k] = sin(w);  u = $pi * (rng() + 1);  BKP[128 + k] = cos(u);  BKP[192 + k] = sin(u);
    BKP[256 + k] = g * (0.55 + 0.45 * rng()) / sqrt(np);  BKP[320 + k] = exp(-1 / (tlo * (thi / tlo) ^ (0.5 + 0.5 * rng()) * 32000));
    k += 1; );
  CBN.c_svf(nhp, 0.7);  nd = exp(-1 / (ntau * 32000));  ne = 1;
  i = 0;
  loop(n_,
    s = 0;  k = 0;
    loop(np, c = BKP[128 + k];  sn = BKP[192 + k];
      BKP[128 + k] = c * BKP[k] - sn * BKP[64 + k];  BKP[192 + k] = c * BKP[64 + k] + sn * BKP[k];
      s += sn * BKP[256 + k];  BKP[256 + k] *= BKP[320 + k];  k += 1; );
    nlev > 0 ? (
      n = rng();  v3 = n - CBN.ic2;  v1 = CBN.a1 * CBN.ic1 + CBN.a2 * v3;  v2 = CBN.ic2 + CBN.a2 * CBN.ic1 + CBN.a3 * v3;
      CBN.ic1 = 2 * v1 - CBN.ic1;  CBN.ic2 = 2 * v2 - CBN.ic2;
      s += (n - CBN.k * v1 - v2) * nlev * ne;  ne *= nd;
    );
    dst[i] += s;  i += 1; );
);
function shp_b(t) local(g, eg) ( g = 0.125;  eg = 0.02 + 0.98 * exp(-g * 6.9 / 4);
  t < g ? 0.02 + 0.98 * exp(-t * 6.9 / 4) : eg * exp(-(t - g) * 6.9 / 1.46); );
function c_fin(dst, n_, att) local(i, pk, y, e)
(
  pk = 0.000001;  i = 0;
  loop(n_, e = min(1, i / (att * 32000 + 1)) * min(1, (n_ - i) / (0.05 * n_));  dst[i] *= e;
    pk = max(pk, abs(dst[i]));  i += 1; );
  i = 0;
  loop(n_, y = dst[i] / pk;  y = sign(y) * sqr(floor(sqrt(abs(y)) * 31 + 0.5) / 31);  dst[i] = y;  i += 1; );
);

