function v_clr() instance(act, out, o, le) ( act = 0;  out = 0;  o = 0;  le = 0; );
function gap_clear() local(k) (
  av0.v_clr();  av1.v_clr();  av2.v_clr();  av3.v_clr();  av4.v_clr();  av5.v_clr();  av6.v_clr();  av7.v_clr();
  av8.v_clr();  av9.v_clr();  av10.v_clr();  av11.v_clr();  av12.v_clr();  av13.v_clr();  av14.v_clr();  av15.v_clr();
  bv0.v_clr();  bv1.v_clr();  bv2.v_clr();  bv3.v_clr();  bv4.v_clr();  bv5.v_clr();  bv6.v_clr();  bv7.v_clr();
  bv8.v_clr();  bv9.v_clr();  bv10.v_clr();  bv11.v_clr();  bv12.v_clr();
  c_bd.v_clr();  c_sd.v_clr();  c_lt.v_clr();  c_mt.v_clr();  c_ht.v_clr();  c_rs.v_clr();  c_cp.v_clr();
  c_ch.v_clr();  c_oh.v_clr();  c_cr.v_clr();  c_rd.v_clr();  c_bd.lp = 0;  c_rs.h = 0;  c_cp.tl_ = 0;
  OFL.ic1 = OFL.ic2 = OFR.ic1 = OFR.ic2 = 0;  OFDL.ic1 = OFDL.ic2 = OFDR.ic1 = OFDR.ic2 = OFPL.ic1 = OFPL.ic2 = OFPR.ic1 = OFPR.ic2 = 0;
  BFDL.ic1 = BFDL.ic2 = BFDR.ic1 = BFDR.ic2 = BFPL.ic1 = BFPL.ic2 = BFPR.ic1 = BFPR.ic2 = 0;
  CMDL.ic1 = CMDL.ic2 = CMDR.ic1 = CMDR.ic2 = CMPL.ic1 = CMPL.ic2 = CMPR.ic1 = CMPR.ic2 = 0;  BFL.ic1 = BFL.ic2 = BFR.ic1 = BFR.ic2 = 0;
  SDL.ic1 = SDL.ic2 = SDH.ic1 = SDH.ic2 = CPF.ic1 = CPF.ic2 = CML.ic1 = CML.ic2 = CMR.ic1 = CMR.ic2 = 0;
  k = 0;  loop(48, ENVA[k] = 0;  ENVV[k] = 1;  k += 1; );  env_any = 0;  sag = 0;
  memset(PHL, 0, 20);  ph_fbl = ph_fbr = 0;
  DTL.ic1 = DTL.ic2 = DTR.ic1 = DTR.ic2 = 0;  dr_xl = dr_xr = 0;  dr_Fl = dr_Fr = 1;  cm_env_v = 0;
  memset(DLB, 0, DSZ);  memset(DRB, 0, DSZ);  dl_ll = dl_lr = 0;  dl_tail = 0;
  TKBL.ic1 = TKBL.ic2 = TKBR.ic1 = TKBR.ic2 = TK1L.ic1 = TK1L.ic2 = TK2L.ic1 = TK2L.ic2 = 0;
  TK1R.ic1 = TK1R.ic2 = TK2R.ic1 = TK2R.ic2 = 0;
  thk_xl = thk_yl = thk_xr = thk_yr = thk_e2 = thk_fe = thk_se = 0;  thk_g = thk_tg = 1;
  ostL.ost_ch_init();  ostR.ost_ch_init();  ost_cl.ost_acz();  ost_cr.ost_acz();
  pq_n = 0;
);
function dl_read(t) local(rp, ri, ri2, f) (
  rp = dl_w - t;  rp < 0 ? rp += DSZ;  ri = floor(rp);  f = rp - ri;  ri2 = ri + 1;  ri2 >= DSZ ? ri2 = 0;
  dr_l = DLB[ri] + (DLB[ri2] - DLB[ri]) * f;  dr_r = DRB[ri] + (DRB[ri2] - DRB[ri]) * f;
);
function pdrift(k, inc) local(s, ph) (
  s = PDS + k * 3;  ph = s[2] + inc;
  ph >= 1 ? ( ph -= 1;  s[0] = s[1];  s[1] = rand(2) - 1; );
  s[2] = ph;  s[0] + (s[1] - s[0]) * (0.5 - 0.5 * cos($pi * ph));
);
function update_params() (
  mach = max(0, min(2, slider1 | 0));
  drift_macro(slider6);
  swing_k = slider3 / 100 / 3;
  t_mlvl = slider5;
  c_a = max(0, min(1, slider16 / 100));  dv_a = max(0, min(1, slider21 / 100));
  t_cm = min(1, c_a * 5);
  snd_d = snd_p = 0;  i_ = 0;  LWD[8] = LWP[8] = 0;
  loop(8, w_d = slider(LSI[i_ * 2]) / 100;  w_p = slider(LSI[i_ * 2 + 1]) / 100;
    LWD[i_] = w_d;  LWP[i_] = w_p;  LWD[8] += w_d / 8;  LWP[8] += w_p / 8;  snd_d = max(snd_d, w_d);  snd_p = max(snd_p, w_p);  i_ += 1; );
  t_ph = snd_p > 0;  t_dl = snd_d > 0;  t_dr = min(1, dv_a * 5);
  c_thr = max(-40, FXP[6] * 2 * c_a);  c_rat = 1 + (FXP[7] - 1) * 2 * c_a;  c_mk = FXP[9] * min(1, 2 * c_a) + 0.45 * (max(-40, FXP[6] * 2 * c_a) * (1 / c_rat - 1) - max(-40, FXP[6] * min(1, 2 * c_a)) * (1 / (1 + (FXP[7] - 1) * min(1, 2 * c_a)) - 1));
  d_mix = FXP[15] / 100 * 1.4;  d_fb = min(0.9, FXP[13] / 100);
  ph_fb = FXP[2] / 100;
  ph_lo = 150 * 4 ^ (FXP[3] / 100);  ph_hi = ph_lo * (2 + 18 * FXP[1] / 100);
  dr_k = 1 + 15 * sqr(min(1, FXP[4] / 100 * 2 * dv_a));  drv_lv = 20 * log10(dr_k);  dr_mk = db2g(-0.9 * drv_lv + 0.0108 * drv_lv * drv_lv + 5 * max(0, dv_a - 0.5));
  DTL.svf_set(2500 * 8 ^ (FXP[5] / 100), 0.6);  DTR.svf_set(2500 * 8 ^ (FXP[5] / 100), 0.6);
  cm_at = FXP[8] >= 0.5 ? 0.012 : 0.0015;  cm_rt = FXP[8] >= 0.5 ? 0.35 : 0.08;
  cm_atc = 1 - exp(-CR / (cm_at * srate));  cm_rtc = 1 - exp(-CR / (cm_rt * srate));
  dl_lpc = 1 - exp(-2 * $pi * (12000 * 0.1 ^ (FXP[14] / 100)) / srate);
);
function env_go(e) local(d) (
  d = VDK[e];
  d < 99.5 ? ( ENVS[e] = exp(-6.9 / (20 * 100 ^ (d / 100) * 0.001 * srate));  ENVV[e] = 1;  ENVA[e] = 1;  env_any = 1; )
           : ( ENVA[e] = 0;  ENVV[e] = 1; );
);
function pan_l(p) ( p = max(-1, min(1, p));  cos((p + 1) * $pi * 0.25) * 0.7071; );
function pan_r(p) ( p = max(-1, min(1, p));  sin((p + 1) * $pi * 0.25) * 0.7071; );
function a_hit(k, vel, p) local(g, r, pl, pr) (
  g = vel * VGL[k] * A_VTR[k];  r = p_base_a * VTU[k];  pl = pan_l(p);  pr = pan_r(p);
  k == 7 ? av8.chk = 1 : k == 8 ? av7.chk = 1 : k == 11 ? av12.chk = 1 : k == 12 ? av11.chk = 1 :
  k == 14 ? av15.chk = 1 : k == 15 ? av14.chk = 1 : k == 5 ? av6.chk = 1 : k == 6 ? av5.chk = 1 :
  k == 9 ? av10.chk = 1 : k == 10 ? av9.chk = 1 :
  k >= 2 && k <= 4 || k == 13 ? ( k != 2 ? av2.chk = 1;  k != 3 ? av3.chk = 1;  k != 4 ? av4.chk = 1;  k != 13 ? av13.chk = 1; );
  k == 0 ? av0.sv_trig(A_SN[0], A_SN[1], g, r, pl, pr) :  k == 1 ? av1.sv_trig(A_SN[2], A_SN[3], g, r, pl, pr) :
  k == 2 ? av2.sv_trig(A_SN[4], A_SN[5], g, r, pl, pr) :  k == 3 ? av3.sv_trig(A_SN[6], A_SN[7], g, r, pl, pr) :
  k == 4 ? av4.sv_trig(A_SN[8], A_SN[9], g, r, pl, pr) :  k == 5 ? av5.sv_trig(A_SN[10], A_SN[11], g, r, pl, pr) :
  k == 6 ? av6.sv_trig(A_SN[12], A_SN[13], g, r, pl, pr) :  k == 7 ? av7.sv_trig(A_SN[14], A_SN[15], g, r, pl, pr) :
  k == 8 ? av8.sv_trig(A_SN[16], A_SN[17], g, r, pl, pr) :  k == 9 ? av9.sv_trig(A_SN[18], A_SN[19], g, r, pl, pr) :
  k == 10 ? av10.sv_trig(A_SN[20], A_SN[21], g, r, pl, pr) :  k == 11 ? av11.sv_trig(A_SN[22], A_SN[23], g, r, pl, pr) :
  k == 12 ? av12.sv_trig(A_SN[24], A_SN[25], g, r, pl, pr) :  k == 13 ? av13.sv_trig(A_SN[26], A_SN[27], g, r, pl, pr) :
  k == 14 ? av14.sv_trig(A_SN[28], A_SN[29], g, r, pl, pr) :  av15.sv_trig(A_SN[30], A_SN[31], g, r, pl, pr);
);
function b_hit(k, vel, p) local(e, s, g, r, pl, pr) (
  e = 16 + k;
  s = k == 0 ? (slider28 >= 0.5 ? 1 : 0) : k == 1 ? (slider29 >= 0.5 ? 3 : 2) : k + 2;
  g = vel * VGL[e] * B_VTR[s];  r = p_base_b * VTU[e] * st(0.05 * dm_a * TOL[e] + 0.03 * dm_a * (rand(2) - 1));
  pl = pan_l(p);  pr = pan_r(p);
  k == 0 ? bv0.sv_trig(B_SN[s * 2], B_SN[s * 2 + 1], g, r, pl, pr) :  k == 1 ? bv1.sv_trig(B_SN[s * 2], B_SN[s * 2 + 1], g, r, pl, pr) :
  k == 2 ? bv2.sv_trig(B_SN[8], B_SN[9], g, r, pl, pr) :  k == 3 ? bv3.sv_trig(B_SN[10], B_SN[11], g, r, pl, pr) :
  k == 4 ? bv4.sv_trig(B_SN[12], B_SN[13], g, r, pl, pr) :  k == 5 ? bv5.sv_trig(B_SN[14], B_SN[15], g, r, pl, pr) :
  k == 6 ? bv6.sv_trig(B_SN[16], B_SN[17], g, r, pl, pr) :  k == 7 ? bv7.sv_trig(B_SN[18], B_SN[19], g, r, pl, pr) :
  k == 8 ? bv8.sv_trig(B_SN[20], B_SN[21], g, r, pl, pr) :
  k == 9 ? ( bv9.sv_trig(B_SN[22], B_SN[23], g, r, pl, pr);  bv10.chk = 1; ) :
  k == 10 ? bv10.sv_trig(B_SN[24], B_SN[25], g, r, pl, pr) :  k == 11 ? bv11.sv_trig(B_SN[26], B_SN[27], g, r, pl, pr) :
  bv12.sv_trig(B_SN[28], B_SN[29], g, r, pl, pr);
);
function c_hit(k, vel, p) local(e, g, pl, pr) (
  e = 32 + k;  g = vel * VGL[e];  pl = pan_l(p);  pr = pan_r(p);
  sag += vel > 1 ? 0.18 : 0.08;
  k == 0 ? ( c_bd.bd_trig(g);  c_bd.gl = pl;  c_bd.gr = pr; ) :
  k == 1 ? ( c_sd.sd_trig(g);  c_sd.gl = pl;  c_sd.gr = pr; ) :
  k == 2 ? ( c_lt.tm_trig(g);  c_lt.gl = pl;  c_lt.gr = pr; ) :
  k == 3 ? ( c_mt.tm_trig(g);  c_mt.gl = pl;  c_mt.gr = pr; ) :
  k == 4 ? ( c_ht.tm_trig(g);  c_ht.gl = pl;  c_ht.gr = pr; ) :
  k == 5 ? ( c_rs.rs_trig(g);  c_rs.gl = pl;  c_rs.gr = pr; ) :
  k == 6 ? ( c_cp.cp_trig(g);  c_cp.gl = pl;  c_cp.gr = pr; ) :
  k == 7 ? ( c_ch.mt_trig(g);  c_ch.gl = pl;  c_ch.gr = pr;  c_oh.chk = 1; ) :
  k == 8 ? ( c_oh.mt_trig(g);  c_oh.gl = pl;  c_oh.gr = pr; ) :
  k == 9 ? ( c_cr.mt_trig(g);  c_cr.gl = pl;  c_cr.gr = pr; ) :
  ( c_rd.mt_trig(g);  c_rd.gl = pl;  c_rd.gr = pr; );
);
function hit(e, vel) local(p) (
  env_go(e);
  p = VPN[e] + 0.05 * dm_a * (rand(2) - 1);
  e < 16 ? a_hit(e, vel, p) : e < 32 ? b_hit(e - 16, vel, p) : c_hit(e - 32, vel, p);
);
function voice_params() local(e, ln, b) (
  e = 0;
  loop(48,
    ln = VLN[e];
    ln >= 0 ? (
      b = 30 + ln * 4;
      VTU[e] = st(slider(b));  VDK[e] = slider(b + 1);  VGL[e] = sqr(slider(b + 2) / 100);
      VPN[e] = max(-1, min(1, slider(b + 3) / 100 + VDP[e] / 100 + 0.15 * dm_a * LPD[ln]));
    ) : (
      VTU[e] = 1;  VDK[e] = 100;  VGL[e] = sqr(VDL[e] / 100);  VPN[e] = VDP[e] / 100;
    );
    e += 1;
  );
);
LPD = 23900;

DDRV.drift_init(0.5 + rand(1) * 0.3);  DCLK.drift_init(0.5 + rand(1) * 0.3);  DFLT.drift_init(0.6 + rand(1) * 0.4);
DBD.drift_init(0.7 + rand(1) * 0.4);  DSD.drift_init(0.7 + rand(1) * 0.4);  DLT.drift_init(0.7 + rand(1) * 0.4);
DMT.drift_init(0.7 + rand(1) * 0.4);  DHT.drift_init(0.7 + rand(1) * 0.4);  DRS.drift_init(0.7 + rand(1) * 0.4);
DMB.drift_init(0.6 + rand(1) * 0.4);
i = 0;  loop(8, PDS[i * 3] = rand(2) - 1;  PDS[i * 3 + 1] = rand(2) - 1;  PDS[i * 3 + 2] = rand(1);  LPD[i] = 0;  i += 1; );
i = 0;  loop(48, TOL[i] = rand(2) - 1;  i += 1; );
dk_c = exp(-1 / (0.002 * srate));
choke_c = exp(-1 / (0.003 * srate));
sm_c = 1 - exp(-CR / (0.03 * srate));
sw_c = 1 - exp(-1 / (0.012 * srate));
dl_xfc = 1 / (0.03 * srate);  dl_xf_on = 0;
sag_c = exp(-1 / (0.3 * srate));
OFL.svf_set(11500, 0.6);  OFR.svf_set(11500, 0.6);  OFDL.svf_set(11500, 0.6);  OFDR.svf_set(11500, 0.6);  OFPL.svf_set(11500, 0.6);  OFPR.svf_set(11500, 0.6);
SDH.svf_set(600, 0.7);  CML.svf_set(11000, 0.6);  CMR.svf_set(11000, 0.6);  CMDL.svf_set(11000, 0.6);  CMDR.svf_set(11000, 0.6);  CMPL.svf_set(11000, 0.6);  CMPR.svf_set(11000, 0.6);
SDL.svf_set(2500 * 5 ^ 0.5, 0.7);  CPF.svf_set(1675, 2.2);
update_params();
voice_params();
s_mlvl = t_mlvl;  m_g = db2g(s_mlvl);  m_i = 0;
s_plo = ph_lo;  s_phi = ph_hi;  s_pfb = ph_fb;  s_dfb = d_fb;  s_dmix = d_mix;  s_drk = dr_k;  s_drmk = dr_mk;  s_cmk = c_mk;
m_ph = t_ph;  m_dr = t_dr;  m_cm = t_cm;  m_dl = t_dl;
i = 0;  loop(9, SWD[i] = LWD[i];  SWP[i] = LWP[i];  i += 1; );
i = 0;  loop(48, VLX[i] = VLN[i] >= 0 ? VLN[i] : 8;  i += 1; );
run = 0;  q_n = 0;  pq_n = 0;  abs_n = 0;  seq_next = 0;  lfo = 0;  cm_g = 1;  cm_env_v = 0;  s_dt = 0.3 * srate;
cr_n = 0;  sag = 0;  c_sg = 1;  ft_s = 0;
s_drv = db2g(5);
p_base_a = BR / srate;  p_base_b = BR / srate;

function lane_def() (
  slider30 = 0;  slider31 = 100;  slider32 = 80;  slider33 = 0;
  slider34 = 0;  slider35 = 100;  slider36 = 70;  slider37 = 0;
  slider38 = 0;  slider39 = 100;  slider40 = 60;  slider41 = 20;
  slider42 = 0;  slider43 = 100;  slider44 = 65;  slider45 = -10;
  slider46 = 0;  slider47 = 100;  slider48 = 60;  slider49 = 30;
  slider50 = 0;  slider51 = 100;  slider52 = 60;  slider53 = 30;
  slider54 = 0;  slider55 = 100;  slider56 = 65;  slider57 = 0;
  slider58 = 0;  slider59 = 100;  slider60 = 60;  slider61 = -25;
);
function fx_def() (
  slider2 = 50;  slider3 = 0;  slider5 = 0;  slider6 = 50;  slider7 = 0;  slider62 = 0;
  i_ = 0;  loop(16, slider(LSI[i_]) = 0;  i_ += 1; );
  FXP[0] = 0.4;  FXP[1] = 60;  FXP[2] = 40;  FXP[3] = 50;
  FXP[4] = 40;  FXP[5] = 50;
  slider16 = 0;  FXP[6] = -12;  FXP[7] = 4;  FXP[8] = 0;  FXP[9] = 2;
  slider21 = 0;  FXP[10] = 1;  FXP[11] = 300;  FXP[12] = 3;  FXP[13] = 35;  FXP[14] = 40;  FXP[15] = 25;
  slider28 = 0;  slider29 = 0;
);
function ph_set(r, d, f, c) ( i_ = 0;  loop(8, slider(LSI[i_ * 2 + 1]) = 100;  i_ += 1; );  FXP[0] = r;  FXP[1] = d;  FXP[2] = f;  FXP[3] = c; );
function dr_set(a, t) ( slider21 = 50;  FXP[4] = a;  FXP[5] = t; );
function cm_set(t, r, e, m) ( slider16 = 50;  FXP[6] = t;  FXP[7] = r;  FXP[8] = e;  FXP[9] = m; );
function dl_set(sy, ms, n, f, d, x) ( i_ = 0;  loop(8, slider(LSI[i_ * 2]) = 100;  i_ += 1; );  FXP[10] = sy;  FXP[11] = ms;  FXP[12] = n;  FXP[13] = f;  FXP[14] = d;  FXP[15] = x; );
function load_preset(p) (
  lane_def();  fx_def();
  p == 2 ? ( slider1 = 0;  slider60 = 75;  slider61 = 50;  slider3 = 15;  slider5 = -1.7;  dl_set(1, 300, 4, 25, 40, 15);  groove(0, 8); ) :
  p == 3 ? ( slider1 = 0;  slider60 = 70;  ph_set(0.1, 40, 25, 30);  dl_set(1, 300, 6, 55, 60, 35);  groove(0, 9); ) :
  p == 4 ? ( slider1 = 0;  slider3 = 50;  slider5 = 1.8;  cm_set(-16, 3, 0, 2);  groove(0, 7); ) :
  p == 5 ? ( slider1 = 1;  slider60 = 70;  slider44 = 75;  slider28 = 1;  slider29 = 1;  slider5 = 3.1;  dr_set(20, 50);  cm_set(-18, 3, 0, 3);  groove(1, 0); ) :
  p == 6 ? ( slider1 = 1;  slider52 = 70;  slider29 = 1;  slider5 = -0.5;  cm_set(-16, 3, 1, 3);  dl_set(1, 300, 3, 35, 40, 22);  groove(1, 3); ) :
  p == 7 ? ( slider1 = 1;  slider5 = 2.9;  slider6 = 90;  dr_set(55, 30);  cm_set(-24, 6, 1, 6);  groove(1, 8); ) :
  p == 8 ? ( slider1 = 1;  slider56 = 80;  slider5 = 0.7;  slider7 = 1;  cm_set(-18, 4, 1, 4);  dl_set(0, 90, 3, 20, 40, 15);  groove(1, 10); ) :
  p == 9 ? ( slider1 = 2;  slider5 = 0.2;  dr_set(20, 60);  cm_set(-16, 3, 1, 2);  groove(2, 1); ) :
  p == 10 ? ( slider1 = 2;  slider3 = 25;  slider5 = -1.7;  slider7 = 1;  slider44 = 78;  cm_set(-14, 2.5, 1, 2);  groove(2, 2); ) :
  p == 11 ? ( slider1 = 2;  slider5 = -2;  ph_set(0.25, 70, 55, 40);  dr_set(45, 70);  dl_set(1, 300, 2, 40, 35, 22);  groove(2, 4); ) :
  p == 12 ? ( slider1 = 2;  slider5 = 0.7;  slider7 = 1;  dr_set(25, 45);  cm_set(-20, 3, 1, 4);  groove(2, 6); ) :
  ( slider1 = 0;  groove(0, 0); );
  slider1 == 2 ? ( slider58 = 7;  slider59 = 82.66;  slider60 = 33; );
  memset(MUTE, 0, 8);
  slider_automate(2 ^ 31 - 1);  slider_automate(2 ^ 62 - 2 ^ 31);
);

function prs_hash() local(i, h) ( h = 0;  i = 1;  loop(63, h += slider(i) * (1 + i * 0.7071);  i += 1; );  h; );
function prs_same() local(h, r) ( h = prs_hash();  r = h == prs_h0;  prs_h0 = h;  r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty;  prs_dirty = 0;  k = k > 12 ? 1 : k;  load_preset(k);
    prs_sel = k;  slider_automate(prs_sel);  prs_cur_d = k;
    prs_last = prs_sel;  prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel;  prs_sel > 0 && prs_hs ? ( load_preset(prs_sel);  prs_cur_d = prs_sel;  prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0;  prs_ok = 1;  prs_h0 = prs_hash(); );
);
prs_ok = 0;  prs_dirty = 0;  grv_dirty = 0;  aud_dirty = 0;

pwr_init();  pwr_hum_db = -83;  pwr_sag = 0.1;  pwr_wu_loss = 0.3;  pwr_wu_drv = 0.4;  pwr_wu_lp = 14000;  pwr_wu_wob = 0.1;  pwr_bloom = 0;
mn_vu_d = mn_pk_d = 0;  mn_ms = mn_pkm = 0;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1;  sel_lane = 0; );
ui_dflt = 1;
st_i = 0;

@slider
prs_chk();
update_params();

@block
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now;  gp_gpp = play_position;  gp_gpd = samplesblock / srate;
prs_chk();
grv_dirty > 0 ? ( grv_dirty <= 15 ? groove(mach, grv_dirty - 1) : memset(PAT, 0, 128);  grv_dirty = 0; );
update_params();
pwr_block(1);
bdt = samplesblock / srate;
dsp = 0.03 * dm_s * bdt;
k = 0;  loop(8, LPD[k] = pdrift(k, dsp * (0.8 + 0.03 * k));  k += 1; );
voice_params();

drv_db = 5 + 3 * dm_a * DDRV.drift_tick(dsp);
p_base_a = BR / srate;

clk_c = 10 * dm_a * DCLK.drift_tick(dsp);
flt_o = 0.3 * dm_a * DFLT.drift_tick(dsp);
p_base_b = BR / srate * st(clk_c / 100);
f_tone = min(0.45 * srate, 2500 * 7 ^ 0.7 * 2 ^ flt_o);
ft_s = ft_s > 0 ? ft_s * (f_tone / ft_s) ^ min(1, bdt / 0.03) : f_tone;
BFL.svf_set(ft_s, 0.75);  BFR.svf_set(ft_s, 0.75);  BFDL.svf_set(ft_s, 0.75);  BFDR.svf_set(ft_s, 0.75);  BFPL.svf_set(ft_s, 0.75);  BFPR.svf_set(ft_s, 0.75);

cents = 0.08 * dm_a;
sagc = -12 * dm_a * min(1, sag);
bd_f0 = VTU[32] * 48 * st(cents * DBD.drift_tick(dsp) + 0.05 * dm_a * TOL[0] + sagc / 100);
sd_k = VTU[33] * st(cents * DSD.drift_tick(dsp) + 0.05 * dm_a * TOL[1] + sagc / 100);
sd_f1 = 207 * sd_k;  sd_f2 = 379 * sd_k;
lt_f = VTU[34] * 95 * st(cents * DLT.drift_tick(dsp) + 0.05 * dm_a * TOL[2] + sagc / 100);
mt_f = VTU[35] * 140 * st(cents * DMT.drift_tick(dsp) + 0.05 * dm_a * TOL[3] + sagc / 100);
ht_f = VTU[36] * 200 * st(cents * DHT.drift_tick(dsp) + 0.05 * dm_a * TOL[4] + sagc / 100);
rs_k = VTU[37] * st(cents * DRS.drift_tick(dsp) + 0.05 * dm_a * TOL[5]);
mb_c = 0.03 * dm_a * DMB.drift_tick(dsp);
hh_r = 32000 / srate * st(mb_c);
ch_r = hh_r * VTU[39];  oh_r = hh_r * VTU[40];  cr_r = hh_r * VTU[41];  rd_r = hh_r * VTU[42];
CPF.svf_set(1675 * VTU[38], 2.2);
ag = 0.06 * dm_a;
bd_sw = 3.2;  bd_click = 0.5;  sd_nl = 0.75;
bd_ac = ec(0.235 * (1 + ag * TOL[12]));  bd_pc = ec(0.005);  bd_pc2 = ec(0.05);  bd_cc = ec(0.0012);
sd_a1 = ec(0.09 * (1 + ag * TOL[13]));  sd_a2 = ec(0.06);  sd_pc = ec(0.01);
sd_an = ec(0.175 * (1 + ag * TOL[14]));
lt_ac = ec(0.1825 * (1 + ag * TOL[15]));
mt_ac = ec(0.155 * (1 + ag * TOL[16]));
ht_ac = ec(0.13 * (1 + ag * TOL[17]));  tm_pc = ec(0.035);
rs_ac = ec(0.008);  cp_tc = ec(0.12 * (1 + ag * TOL[18]));
ch_ac = ec(0.0392 * (1 + ag * TOL[19]));
oh_ac = ec(0.24 * (1 + ag * TOL[20]));
sag_lvl = db2g(-0.4 * dm_a * min(1, sag));

ost_setup(0, 0.3, 120, 6000, -0.3, 1);
st_k = 1 - exp(-1 / (0.03 * srate));  !st_i ? ( st_g = slider62 * 0.01;  st_i = 1; );  ost_amt = st_g;  ost_drv = 1 + 12 * st_g * sqrt(st_g);  ost_wet = min(st_g * 3, 1);
dl_t = FXP[10] >= 0.5 ? (FXP[12] < 0.5 ? 0.125 : FXP[12] < 1.5 ? 0.25 : FXP[12] < 2.5 ? 0.375 : FXP[12] < 3.5 ? 0.5 :
                          FXP[12] < 4.5 ? 0.75 : FXP[12] < 5.5 ? 1 : 1.5) * 60 / max(tempo, 20) : FXP[11] / 1000;
dl_ts = min(DSZ - 4, dl_t * srate);

q_n = 0;
aud_dirty > 0 ? ( QV[0] = 0;  QV[1] = aud_dirty - 1;  QV[2] = 1;  q_n = 1;  aud_dirty = 0; );
while (midirecv(mo, m1, m2, m3)) (
  m_on = (m1 & 0xF0) == 0x90 && m3 > 0;
  m_on ? midi_led_d += 1;
  m_on && q_n < 64 && NM[mach * 128 + m2] >= 0 ? (
    QV[q_n * 3] = mo;  QV[q_n * 3 + 1] = 100 + NM[mach * 128 + m2];  QV[q_n * 3 + 2] = m3 > 100 ? 2 : 1;  q_n += 1;
  );
  midisend(mo, m1, m2, m3);
);
run_t = slider4 >= 0.5 ? (play_state & 1) : run_d > 0;
run_t != run ? ( run = run_t;  pq_n = 0;  run ? ( free_pos = 0;  seq_next = 0;  next_t = 0; ); );
hum = mach == 1 ? 0.003 * dm_a * srate : mach == 2 ? 0.0004 * dm_a * srate : 0;
run ? (
  spb = 60 / max(tempo, 20) * srate / 4;
  la = 0.006 * srate / spb;
  (play_state & 1) ? (
    pos0 = beat_position * 4;
    abs(pos0 - exp_pos) > 0.5 || !was_play ? ( seq_next = ceil(pos0 - 0.0001);  next_t = seq_next + (seq_next % 2 ? swing_k : 0);  pq_n = 0; );
    was_play = 1;
  ) : (
    was_play ? free_pos = exp_pos;
    pos0 = free_pos;  was_play = 0;
  );
  pos1 = pos0 + samplesblock / spb;
  while (next_t < pos1 + la && pq_n < 120) (
    t_ev = abs_n + max(0, (next_t - pos0) * spb + (rand(2) - 1) * hum);
    stp_in = seq_next % 16;
    i = 0;
    loop(8, vv = PAT[i * 16 + stp_in];
      vv > 0 && !MUTE[i] && pq_n < 120 ? ( PQ[pq_n * 3] = t_ev + (rand(2) - 1) * hum * 0.3;  PQ[pq_n * 3 + 1] = i;  PQ[pq_n * 3 + 2] = vv;  pq_n += 1; );
      i += 1; );
    pq_n < 120 ? ( PQ[pq_n * 3] = t_ev;  PQ[pq_n * 3 + 1] = -1 - stp_in;  PQ[pq_n * 3 + 2] = 0;  pq_n += 1; );
    seq_next += 1;  next_t = seq_next + (seq_next % 2 ? swing_k : 0);
  );
  free_pos = pos1;  exp_pos = pos1;
) : ( step_d = -1;  was_play = 0; );
k = 0;  j = 0;
while (k < pq_n) (
  PQ[k * 3] < abs_n + samplesblock ? (
    PQ[k * 3 + 1] < 0 ? step_d = -1 - PQ[k * 3 + 1] : q_n < 64 ? (
      QV[q_n * 3] = max(0, floor(PQ[k * 3] - abs_n));  QV[q_n * 3 + 1] = PQ[k * 3 + 1];  QV[q_n * 3 + 2] = PQ[k * 3 + 2];  q_n += 1; );
  ) : (
    PQ[j * 3] = PQ[k * 3];  PQ[j * 3 + 1] = PQ[k * 3 + 1];  PQ[j * 3 + 2] = PQ[k * 3 + 2];  j += 1;
  );
  k += 1;
);
pq_n = j;
k = 1;
while (k < q_n) ( j = k;
  while (j > 0 && QV[(j - 1) * 3] > QV[j * 3]) (
    t0 = QV[j * 3];  t1 = QV[j * 3 + 1];  t2 = QV[j * 3 + 2];
    QV[j * 3] = QV[(j - 1) * 3];  QV[j * 3 + 1] = QV[(j - 1) * 3 + 1];  QV[j * 3 + 2] = QV[(j - 1) * 3 + 2];
    QV[(j - 1) * 3] = t0;  QV[(j - 1) * 3 + 1] = t1;  QV[(j - 1) * 3 + 2] = t2;  j -= 1; );
  k += 1; );
abs_n += samplesblock;
q_i = 0;  smp = 0;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1)));  mn_ms = 0;  mn_pk_d = max(mn_pk_d, mn_pkm);  mn_pkm = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, PAT, 128);
file_mem(0, MUTE, 8);
file_var(0, seq_ok);
file_var(0, sel_lane);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;
pwr_ser();
file_avail(0) != 0 ? ( file_mem(0, FXP, 16);  update_params(); );

@sample
while (q_i < q_n && QV[q_i * 3] <= smp) (
  tr = QV[q_i * 3 + 1];  vc = QV[q_i * 3 + 2];
  vel = vc == 2 ? 1 + 1.4 * slider2 / 100 : 1 - 0.4 * slider2 / 100;
  tr >= 100 ? ( ev = tr - 100;  VLN[ev] >= 0 ? VLT[VLN[ev]] = 1; ) : ( ev = LMAP[mach * 8 + tr];  VLT[tr] = 1; );
  hit(ev, vel);
  q_i += 1;
);
smp += 1;
sag *= sag_c;
env_any ? ( k = 0;  env_any = 0;  loop(48, ENVA[k] ? ( ENVV[k] *= ENVS[k];  env_any = 1; );  k += 1; ); );

cr_n <= 0 ? (
  cr_n = CR;
  s_mlvl += (t_mlvl - s_mlvl) * sm_c;  m_i = (db2g(s_mlvl) - m_g) / CR;
  snd_on > 0 || snd_d + snd_p > 0 ? ( snd_on = 0;  i_ = 0;
  loop(9, SWD[i_] += (LWD[i_] - SWD[i_]) * sm_c;  SWP[i_] += (LWP[i_] - SWP[i_]) * sm_c;
    abs(SWD[i_] - LWD[i_]) < 0.00001 ? SWD[i_] = LWD[i_];  abs(SWP[i_] - LWP[i_]) < 0.00001 ? SWP[i_] = LWP[i_];
    snd_on += SWD[i_] + SWP[i_];  i_ += 1; ); );
  s_pfb += (ph_fb - s_pfb) * sm_c;  s_dfb += (d_fb - s_dfb) * sm_c;  s_dmix += (d_mix - s_dmix) * sm_c;  s_cmk += (c_mk - s_cmk) * sm_c;
  s_drk += (dr_k - s_drk) * sm_c;  s_drmk += (dr_mk - s_drmk) * sm_c;
  c_sg += (sag_lvl - c_sg) * sm_c;
  lfo += CR * FXP[0] / srate;  lfo -= floor(lfo);
  s_plo += (ph_lo - s_plo) * sm_c;  s_phi += (ph_hi - s_phi) * sm_c;
  fl = s_plo * (s_phi / s_plo) ^ (0.5 - 0.5 * cos(2 * $pi * lfo));
  fr = s_plo * (s_phi / s_plo) ^ (0.5 - 0.5 * cos(2 * $pi * (lfo + 0.25)));
  tl_ = tan($pi * min(fl, 0.45 * srate) / srate);  ph_al = (tl_ - 1) / (tl_ + 1);
  tr_ = tan($pi * min(fr, 0.45 * srate) / srate);  ph_ar = (tr_ - 1) / (tr_ + 1);
  cm_lv = 10 * log10(cm_env_v + 0.000000000001);
  cm_ov = cm_lv - c_thr;
  cm_tg = cm_ov <= -2 ? 0 : cm_ov < 2 ? -(1 - 1 / c_rat) * sqr(cm_ov + 2) / 8 : -(1 - 1 / c_rat) * cm_ov;
  cm_gd += (cm_tg - cm_gd) * (cm_tg < cm_gd ? cm_atc : cm_rtc);
  cm_gi = (db2g(cm_gd + s_cmk) - cm_g) / CR;
);
cr_n -= 1;
m_g += m_i;  cm_g += cm_gi;
m_ph += (t_ph - m_ph) * sw_c;  m_dr += (t_dr - m_dr) * sw_c;  m_cm += (t_cm - m_cm) * sw_c;  m_dl += (t_dl - m_dl) * sw_c;

bx_l = bx_r = bd_l = bd_r = bp_l = bp_r = 0;
snd_on > 0 ? (
  v_ = av0.sv_proc();  mx(v_, av0.gl, av0.gr, 0);
  v_ = av1.sv_proc();  mx(v_, av1.gl, av1.gr, 1);
  v_ = av2.sv_proc();  mx(v_, av2.gl, av2.gr, 2);
  v_ = av3.sv_proc();  mx(v_, av3.gl, av3.gr, 3);
  v_ = av4.sv_proc();  mx(v_, av4.gl, av4.gr, 4);
