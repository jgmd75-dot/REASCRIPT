) : ( xd_l = xd_r = xp_l = xp_r = 0; );

bx_l = bx_r = bd_l = bd_r = bp_l = bp_r = 0;
snd_on > 0 ? (
  v_ = bv0.sv_proc();  mx(v_, bv0.gl, bv0.gr, 16);
