g_row(1, 13, 0, "X......x..X...x.");  g_row(1, 13, 7, "....X.......XxXx");  g_row(1, 13, 9, "x.xxx.xxx.xxx.xx");
g_row(1, 14, 0, "X.......X.......");  g_row(1, 14, 1, "............XXXX");  g_row(1, 14, 2, "........x..x..x.");  g_row(1, 14, 3, "....x..x.....x..");  g_row(1, 14, 4, "x..x..x.........");  g_row(1, 14, 11, "X...............");
g_row(2, 0, 0, "X...X...X...X...");  g_row(2, 0, 6, "....x.......x...");  g_row(2, 0, 7, "x..xx..xx..xx..x");  g_row(2, 0, 8, "..x...x...x...x.");
g_row(2, 1, 0, "X...X...X...X...");  g_row(2, 1, 6, "....X.......X...");  g_row(2, 1, 7, "x..x...x...x...x");  g_row(2, 1, 8, "..x...x...x...x.");  g_row(2, 1, 10, "x.x.x.x.x.x.x.x.");
