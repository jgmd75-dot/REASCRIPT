  dl_w += 1;  dl_w >= DSZ ? dl_w = 0;
  xl += el * s_dmix;  xr += er * s_dmix;
  dl_tail = abs(el) + abs(er) > 0.000001 ? 1 : m_dl > 0.00001;
);

thk_proc(xl, xr, slider7 >= 0.5);  xl = thk_l;  xr = thk_r;
pwr_out(xl, xr);  xl = pwr_l;  xr = pwr_r;
xl *= m_g;  xr *= m_g;
st_t = slider62 * 0.01;
st_g != st_t ? (
  st_g += (st_t - st_g) * st_k;  abs(st_t - st_g) < 0.0001 ? st_g = st_t;
