    v_ = c_cr.mt_proc(BK_CR, BL_CR, cr_r, 1);  bx_l += v_ * c_cr.gl;  bx_r += v_ * c_cr.gr;
    v_ = c_rd.mt_proc(BK_RD, BL_RD, rd_r, 1);  bx_l += v_ * c_rd.gl;  bx_r += v_ * c_rd.gr;
  );
