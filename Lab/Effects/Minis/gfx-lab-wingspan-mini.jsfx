function mg_kn(cx, cy, r, ly, idx, lo, hi, def, sty, col, kind, name) local(k, v) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%.1f dB", v) : kind == 1 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) :
  kind == 2 ? ( v >= 1000 ? sprintf(#mgv, "%.2f s", v / 1000) : v >= 10 ? sprintf(#mgv, "%d ms", floor(v + 0.5)) : sprintf(#mgv, "%.1f ms", v); ) :
  kind == 3 ? ( abs(v) < 0.05 ? strcpy(#mgv, "0.0 dB") : sprintf(#mgv, "%+.1f dB", v); ) :
  kind == 4 ? ( v = floor(v + 0.5); v > 0 ? sprintf(#mgv, "+%d %% WIDEN", v) : v < 0 ? sprintf(#mgv, "%d %% NARROW", v) : strcpy(#mgv, "OFF"); ) :
  ( v = floor(v + 0.5); v <= 0 ? strcpy(#mgv, "MID") : v >= 100 ? strcpy(#mgv, "SIDE") : sprintf(#mgv, "M %d / S %d", 100 - v, v); );
  gfx_setfont(10); ui_col(k ? mk_hot : mk_ink); mg_ctxt(cx, ly, k ? #mgv : name);
