desc:Wingspan Mini [dynamic width] (GFX Lab)
//tags: mastering stereo width imaging mid side dynamic expander mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os and gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Off,On}>-Bypass
slider2:-20<-60,0,0.1>-Threshold (dB)
slider3:30<-100,100,1>-Amount (%, - narrows / + widens)
slider4:15<0.5,100,0.1>-Attack (ms)
slider5:300<20,2000,1>-Release (ms)
slider6:0<0,100,1>-Detect (0 = Mid .. 100 = Side)
slider7:1<0,1,1{Peak,RMS}>-Detector
slider8:100<0,200,1>-Base width (%)
slider9:1<0,1,1{Pre,Post}>-Base width position
slider10:0<0,3,1{Off,80 Hz,120 Hz,200 Hz}>-Low mono
slider11:100<0,100,1>-Mix (%)
slider12:0<-12,12,0.1>-Output (dB)
slider13:0<0,2,1{1x,2x,4x}>-Oversampling
slider14:prs_sel=0<0,10,1{No preset,Init,Wide Choruses,Tame Wide Peaks,Gentle Master Width,Mono-Safe Lows,Drum Room Bloom,Pad Spread,Narrow Loud Bits,Vocal Centre Lock,Wide When Quiet}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-wingspan-mini";
ext_noinit = 1;

function wm_tc(ms, fs) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * fs)); );
function wm_curve(o, knee) ( o <= -knee * 0.5 ? 0 : o >= knee * 0.5 ? o : sqr(o + knee * 0.5) / (2 * knee); );
function wm_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );

function wm_hps(f, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * 0.70710678);
  n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function wm_bq(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function wm_bqz() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
COEF = 7000000;
function wm_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function wm_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function wm_bmz() instance(z1, z2) ( z1 = z2 = 0; );
C_F1 = COEF; C_F2 = COEF + 5; C_F3 = COEF + 10; C_F4 = COEF + 15;

function wm_fizz(x) local(h, ha, nn, u, e, ea, g) (
  h = zA.wm_bm(x, C_F1);
  ha = abs(h); wm_fzh += (ha - wm_fzh) * (ha > wm_fzh ? wm_fza : wm_fzr);
  wm_fzp += (abs(x) - wm_fzp) * wm_fzw;
  nn = 1 / (max(wm_fzh, 0.25 * wm_fzp) + 0.00001);
  u = h * nn;
  e = (wm_tanh(2 * u) / 2 - u + 0.4 * u * u) * wm_fzh;
  e = zD.wm_bm(zC.wm_bm(zB.wm_bm(e, C_F2), C_F3), C_F4);
  ea = abs(e); wm_fze += (ea - wm_fze) * (ea > wm_fze ? wm_fza : wm_fzr);
  g = wm_fzo * max(0.25, min(1, 0.05 * wm_fzp / (wm_fze + 0.000001)));
  g * e;
);

function wm_chain(l, r) local(m, s, sh, sd, e, lv, t, g, so) (
  m = (l + r) * 0.5; s = (l - r) * 0.5;
  sh = wh2.wm_bq(wh1.wm_bq(s)); s += (sh - s) * wm_lms;
  sd = wm_pre ? s * wm_wbs : s;
  e = wm_dw0 * m * m + wm_dw1 * sd * sd;
  wm_rmsm ? ( wm_msq += (e - wm_msq) * wm_crms; e = wm_msq; );
  lv = 4.342944819 * log(max(e, 0.000000000001));
  wm_lvm = max(wm_lvm, lv);
  t = wm_amt * min(0.5 * wm_curve(lv - wm_thr, 6), wm_cap);
  wm_gd += (t - wm_gd) * (abs(t) > abs(wm_gd) ? wm_att : wm_rel);
  wm_gd2 += (wm_gd - wm_gd2) * wm_c2;
  g = exp(wm_gd2 * 0.11512925465);
  so = s * wm_wbs * g;
  wm_fzo > 0.0001 ? so += wm_fizz(so);
  wm_pl = l + (m + so - l) * wm_mixs;
  wm_pr = r + (m - so - r) * wm_mixs;
);
function wm_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  wh1.wm_bqz(); wh2.wm_bqz();
  zA.wm_bmz(); zB.wm_bmz(); zC.wm_bmz(); zD.wm_bmz(); wm_fzh = wm_fzp = wm_fze = 0;
  wm_msq = 0; wm_gd = wm_gd2 = 0;
);
function wm_reset() ( wm_clear(); memset(BY_BUF, 0, 2 * BY_N); wm_fi = 0; );

function wm_coef() (
  wm_fs = srate * os_f;
  wm_c2 = wm_tc(3, wm_fs); wm_crms = wm_tc(8, wm_fs);
  wm_bqc(C_F1, 4, 3500, 0, 0.7071, wm_fs); wm_bqc(C_F2, 4, 5500, 0, 0.7071, wm_fs);
  wm_bqc(C_F3, 0, 8000, 4, 0.7, wm_fs); wm_bqc(C_F4, 2, 12000, -6, 0.7, wm_fs);
  wm_fza = wm_tc(3, wm_fs); wm_fzr = wm_tc(120, wm_fs); wm_fzw = wm_tc(60, wm_fs);
  wm_lmf = -1;
);

PT = 6000000;
#wm_pm = "Init|Wide Choruses|Tame Wide Peaks|Gentle Master Width|Mono-Safe Lows|Drum Room Bloom|Pad Spread|Narrow Loud Bits|Vocal Centre Lock|Wide When Quiet";
function wm_w(a, b, c, d, e, f, g, h, i, j) (
  wm_wq[0] = a; wm_wq[1] = b; wm_wq[2] = c; wm_wq[3] = d; wm_wq[4] = e;
  wm_wq[5] = f; wm_wq[6] = g; wm_wq[7] = h; wm_wq[8] = i; wm_wq[9] = j; wm_wq += 10;
);
wm_wq = PT;
wm_w(-20,  30, 15,  300,   0, 1, 100, 1, 0, 100);
wm_w(-18,  60, 30,  600,   0, 1, 105, 1, 2, 100);
wm_w(-30, -50,  5,  200, 100, 0, 100, 1, 0, 100);
wm_w(-22,  25, 40,  800,  30, 1, 110, 1, 1, 100);
wm_w(-20,  15, 25,  500,   0, 1, 115, 1, 2, 100);
wm_w(-16,  70,  2,  400,   0, 0, 100, 1, 2,  70);
wm_w(-36,  50, 80, 1500,  50, 1, 130, 0, 3, 100);
wm_w(-14, -60, 10,  400,   0, 1, 100, 1, 2, 100);
wm_w(-24, -35,  8,  250,   0, 1, 105, 1, 1, 100);
wm_w(-24, -40, 20,  700,   0, 1, 125, 1, 2, 100);
function load_preset(p) local(i, q) (
  q = PT + (p >= 11 ? 0 : p - 1) * 10;
  i = 0; loop(10, slider(2 + i) = q[i]; i += 1; );
  (p == 1 || p >= 11) ? slider12 = 0;
  slider_automate(2 ^ 12 - 2);
  pr_cur = p >= 11 ? 1 : p;
);

function wm_srinit() (
  wm_sr = srate;
  wm_sm = wm_tc(30, srate);
  wm_fis = 1 / (0.01 * srate);
  wm_dcr = 1 - 2 * $pi / srate;
  wm_cm = wm_tc(300, srate);
  ost_init(0);
  wm_coef(); wm_clear();
  wm_snap = 1;
);
os_design();
os_f = os_tf = os_f2n(slider13); os_base = 0;
wm_srinit();
os_gsetup();
WG_L = 100000; WG_R = WG_L + 1024; WG_N = 1024;
memset(WG_L, 0, 2 * WG_N);
wm_fi = 1; wm_lvm = -150;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(13, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != wm_sr ? wm_srinit();
wm_now = time_precise();
wm_tp > 0 && wm_now - wm_tp > max(0.25, 4 * samplesblock / srate) ? wm_reset();
wm_tp = wm_now;
os_tf = os_f2n(slider13);
wm_thr = slider2;
wm_amt = slider3 / 100;
wm_cap = wm_amt >= 0 ? 12 : 18;
wm_att = wm_tc(slider4, wm_fs);
wm_rel = wm_tc(slider5, wm_fs);
wm_dw1 = min(max(slider6 / 100, 0), 1); wm_dw0 = 1 - wm_dw1;
wm_rmsm = slider7 > 0.5;
wm_wbt = slider8 / 100;
wm_pre = slider9 < 0.5;
wm_lmi = floor(slider10 + 0.5);
wm_f = wm_lmi == 1 ? 80 : wm_lmi == 2 ? 120 : 200;
wm_f != wm_lmf ? ( wm_lmf = wm_f; wh1.wm_hps(wm_f, wm_fs); wh2.wm_hps(wm_f, wm_fs); );
wm_lmt = wm_lmi > 0;
wm_mixt = slider11 / 100;
wm_outt = 10 ^ (slider12 / 20);
wm_fzt = 0.33 * min(max((slider8 - 120) / 80, 0), 1);
ost_setup(0, 0, 120, 6000, -0.3, 0);
pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
wm_snap ? ( wm_wbs = wm_wbt; wm_mixs = wm_mixt; wm_outs = wm_outt; wm_lms = wm_lmt; wm_fzo = wm_fzt; );
wm_snap = 0;
abs(wh1.y1) + abs(wh1.y2) + abs(wh1.x1) + abs(wh1.x2) < 0.000000000001 ? wh1.wm_bqz();
abs(wh2.y1) + abs(wh2.y2) + abs(wh2.x1) + abs(wh2.x2) < 0.000000000001 ? wh2.wm_bqz();
abs(wm_msq) < 0.000000000001 ? wm_msq = 0;
abs(wm_gd) < 0.0000001 ? wm_gd = 0; abs(wm_gd2) < 0.0000001 ? wm_gd2 = 0;
abs(wm_eM) < 0.000000000001 ? wm_eM = 0; abs(wm_eS) < 0.000000000001 ? wm_eS = 0;
abs(wm_cLL) < 0.000000000001 ? ( wm_cLL = 0; wm_cLR = 0; ); abs(wm_cRR) < 0.000000000001 ? wm_cRR = 0;
wm_vu_d = max(wm_vu_d, sqrt(wm_ms / max(samplesblock, 1))); wm_ms = 0;
wm_pk_d = max(wm_pk_d, wm_pkm); wm_pkm = 0;
wm_sg_disp = wm_gd2;
wm_eM_disp = wm_eM; wm_eS_disp = wm_eS;
wm_cor_disp = wm_cLL > 0.0000001 && wm_cRR > 0.0000001 ? wm_cLR / sqrt(wm_cLL * wm_cRR) : 1;
wm_gp_disp = wm_gp;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
wm_y0 = spl0 - wm_x0 + wm_dcr * wm_y0; wm_x0 = spl0; wm_xl = wm_y0;
wm_y1 = spl1 - wm_x1 + wm_dcr * wm_y1; wm_x1 = spl1; wm_xr = wm_y1;
wm_wbs += (wm_wbt - wm_wbs) * wm_sm; wm_mixs += (wm_mixt - wm_mixs) * wm_sm;
wm_outs += (wm_outt - wm_outs) * wm_sm; wm_lms += (wm_lmt - wm_lms) * wm_sm; wm_fzo += (wm_fzt - wm_fzo) * wm_sm;
abs(wm_xl) < 0.000000000000001 ? wm_xl = 0; abs(wm_xr) < 0.000000000000001 ? wm_xr = 0;
os_gate();
os_chg ? ( wm_clear(); wm_coef(); wm_att = wm_tc(slider4, wm_fs); wm_rel = wm_tc(slider5, wm_fs);
           wm_lmf = wm_f; wh1.wm_hps(wm_f, wm_fs); wh2.wm_hps(wm_f, wm_fs); );
uxL.os_up(wm_xl); uxR.os_up(wm_xr);
os_f == 1 ? (
  wm_chain(uxL.s0, uxR.s0); wm_yl = wm_pl; wm_yr = wm_pr;
) : (
  wm_chain(uxL.s0, uxR.s0); wm_a0 = wm_pl; wm_r0 = wm_pr;
  wm_chain(uxL.s1, uxR.s1); wm_a1 = wm_pl; wm_r1 = wm_pr;
  os_f == 2 ? ( wm_yl = dnL.os_dn(wm_a0, wm_a1, 0, 0); wm_yr = dnR.os_dn(wm_r0, wm_r1, 0, 0); ) : (
    wm_chain(uxL.s2, uxR.s2); wm_a2 = wm_pl; wm_r2 = wm_pr;
    wm_chain(uxL.s3, uxR.s3); wm_a3 = wm_pl; wm_r3 = wm_pr;
    wm_yl = dnL.os_dn(wm_a0, wm_a1, wm_a2, wm_a3); wm_yr = dnR.os_dn(wm_r0, wm_r1, wm_r2, wm_r3);
  );
);
wm_osg = os_g * os_g * (3 - 2 * os_g);
wm_yl *= wm_osg * wm_outs; wm_yr *= wm_osg * wm_outs;
wm_yl != wm_yl ? wm_yl = 0; wm_yr != wm_yr ? wm_yr = 0;
wm_fi < 1 ? (
  wm_fi = min(wm_fi + wm_fis, 1); wm_z = wm_fi * wm_fi * (3 - 2 * wm_fi);
  wm_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; wm_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  wm_yl = wm_a + (wm_yl - wm_a) * wm_z; wm_yr = wm_b + (wm_yr - wm_b) * wm_z;
);
ost_out(wm_yl, wm_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
wm_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);
wm_pkm = max(wm_pkm, max(abs(spl0), abs(spl1)));
wm_cLR += (spl0 * spl1 - wm_cLR) * wm_cm; wm_cLL += (spl0 * spl0 - wm_cLL) * wm_cm; wm_cRR += (spl1 * spl1 - wm_cRR) * wm_cm;
wm_om = (spl0 + spl1) * 0.5; wm_os = (spl0 - spl1) * 0.5;
wm_eM += (wm_om * wm_om - wm_eM) * wm_cm; wm_eS += (wm_os * wm_os - wm_eS) * wm_cm;
(wm_gw += 1) >= 2 ? ( wm_gw = 0; WG_L[wm_gp] = spl0; WG_R[wm_gp] = spl1; wm_gp = (wm_gp + 1) % WG_N; );

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x5F87A6; mk_band = 0x111820; mk_ink = 0xF4ECE0; mk_acc = 0xE8A33A; mk_tab = 0xE8A33A;
mk_sub = 0x24333F; mk_hot = 0xFFC860;
mk_ink2 = ui_mix(mk_ink, 0x23282F, 0.3);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(7, "Courier New", 22 * sc, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
