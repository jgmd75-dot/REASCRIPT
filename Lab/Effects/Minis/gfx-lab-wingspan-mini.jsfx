function mg_dots(x, y, r, c) local(i, t, rs) (
  rs = r + 8; i = 0;
  loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi; ui_col(c);
    mg_kwid && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); mg_ctxt(x + sin(t) * (rs + 2), y - cos(t) * (rs + 2), i == 0 ? "M" : i == 2 ? "C" : "S"); )
      : mg_disc(x + sin(t) * rs, y - cos(t) * rs, i == 0 || i == 4 ? 1.8 : 1.3);
    i += 1; );
  mg_kzero ? ( gfx_setfont(11); ui_col(c); mg_ctxt(x, y - rs - 9, "0"); );
