);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
fl_setup();
os_snap(slider(23));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();
fl_rk0 = slider24 >= 0.5;
file_avail(0) != 0 ? (
  file_var(0, fm_na); file_var(0, fm_nb);
  file_var(0, fm_ra); file_var(0, fm_rb); file_var(0, fm_qa); file_var(0, fm_qb);
  fm_na = min(max(fm_na | 0, 0), FM_MAX); fm_nb = min(max(fm_nb | 0, 0), FM_MAX);
  fm_na > 0 ? ( file_mem(0, FMA, fm_na); file_mem(0, FMAR, fm_na); );
  fm_nb > 0 ? ( file_mem(0, FMB, fm_nb); file_mem(0, FMBR, fm_nb); );
