mdC1.drift_init(0.8 + rand(1) * 0.5); mdC2.drift_init(0.8 + rand(1) * 0.5); mdT1.drift_init(0.8 + rand(1) * 0.5);
fl_mmL = rand(2) - 1; fl_mmR = rand(2) - 1;
fl_srinit();
fl_gis = fl_gin; fl_gos = fl_gout; fl_mxs = fl_mix; fl_dgs = fl_dg; fl_dms = fl_dm; fz_s = fl_fzt; fz_o = fz_s;
fl_fi = 1; fl_cn = 0;
os_gsetup();
pdc_delay = os_lat(os_f);
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 9000; pwr_wu_wob = 0.15; pwr_bloom = 0;
by_setup(22);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_sl() ( fl_setup(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(23, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(4, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 4 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
