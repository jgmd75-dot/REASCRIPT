desc:Filtra Mini [sync filter] (GFX Lab)
//tags: filter sync tempo rhythmic ladder diode state-variable resonance drive mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:1100<22,18000,1>-Cutoff (Hz)
slider2:20<0,100,0.1>-Resonance (%)
slider3:30<0,100,1>-Smooth (%)
slider4:0<0,1,1{A,B}>-Record into
slider5:1<0,4,1{1/2 bar,1 bar,2 bars,4 bars,8 bars}>-Loop length
slider6:1<0,2,1{Half,Normal,Double}>-Rate
slider7:0<0,1,1{Off,On}>-Hold
slider8:0<0,2,1{Ladder,Diode,SVF}>-Circuit
slider9:0<0,2,1{LP,BP,HP}>-SVF mode
slider10:0<0,24,0.1>-Drive (dB)
slider11:100<0,100,1>-Mix (%)
slider12:50<0,100,1>-Blend (%)
slider13:-24<-48,0,0.1>-Sense (dB)
slider14:1<0,1,1{Basic,Auto}>-Blend mode
slider15:0<0,75,1>-Swing (%)
slider16:0<0,100,1>-Offset (% of an eighth)
slider17:0<0,100,1>-Motion (%)
slider18:0.1<0.01,1,0.001>-Motion speed (Hz)
slider19:0<-12,12,0.1>-Trim (dB)
slider20:0<-20,20,0.1>-Output (dB)
slider21:50<0,100,1>-Drift (%)
slider22:0<0,1,1{Off,On}>-Bypass
slider23:1<0,2,1{1x,2x,4x}>-Oversampling
slider24:0<0,1,1{Off,On}>-Record (each change arms or cancels)
slider25:prs_sel=0<0,4,1{No preset,Init,Quarter Pump,Slow Bloom,Gallop Wah}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-filtra-mini";
ext_noinit = 1;

FMA = 200000; FMAR = 202048; FMB = 204096; FMBR = 206144; FTC = 208192; FTR = 210240;
FM_MAX = 2048;
DRY = 1000000;

function fl_db2g(d) ( exp(d * 0.11512925465); );
function fl_sat(u) ( u = min(max(u, -3), 3); u * (27 + u * u) / (27 + 9 * u * u); );
function fl_F(u) local(a) ( a = abs(u); a < 3 ? u * u * 0.0555555556 + 1.3333333333 * log(1 + u * u * 0.3333333333) : 2.3483924 + a - 3; );
function fl_asym(v) ( fl_sat(v + 0.2) - 0.19737; );

function fl_drv(x) instance(x1, f1) local(u, f, d, y) (
  u = x * fl_dgs; f = fl_F(u); d = u - x1;
  y = abs(d) > 0.00001 ? (f - f1) / d : fl_sat(0.5 * (u + x1));
  x1 = u; f1 = f;
  y * fl_dms;
);
function fl_dclr() instance(x1, f1) ( x1 = 0; f1 = 0; );

function fl_lad(x, g, k) instance(s1, s2, s3, s4) local(u) (
  u = fl_sat(x - k * s4);
  s1 += g * (u - s1); s2 += g * (s1 - s2); s3 += g * (s2 - s3); s4 += g * (s3 - s4);
  s4 * (1 + 0.5 * k);
);
function fl_lclr() instance(s1, s2, s3, s4) ( s1 = s2 = s3 = s4 = 0; );

function fl_dio(x, g, k) instance(s1, s2, s3) local(u) (
  u = fl_sat(1.2 * (x - k * fl_asym(s3))) * 0.8333333;
  s1 += g * (u - s1); s2 += g * (fl_sat(s1) - s2); s3 += g * (s2 - s3);
  s3 * (1 + 0.6 * k);
);
function fl_eclr() instance(s1, s2, s3) ( s1 = s2 = s3 = 0; );

function fl_svf(x, g, k) instance(ic1, ic2) local(a1, a2, a3, v1, v2, v3) (
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  fl_wlo * v2 + fl_wbp * k * v1 + fl_whp * (x - k * v1 - v2);
);
function fl_sclr() instance(ic1, ic2) ( ic1 = ic2 = 0; );

function fl_circ(c, x, gl, gs, kl, kd, ks) instance(lp, dp, sv) (
  c == 0 ? this.lp.fl_lad(x, gl, kl) : c == 1 ? this.dp.fl_dio(x, gl, kd) : this.sv.fl_svf(x, gs, ks);
);
function fl_cclr(c) instance(lp, dp, sv) (
  c == 0 ? this.lp.fl_lclr() : c == 1 ? this.dp.fl_eclr() : this.sv.fl_sclr();
);

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function fl_one(a, b) local(ya, yb, oa, ob, t) (
  a = dvL.fl_drv(a); b = dvR.fl_drv(b);
  ya = cL.fl_circ(fl_cc, a, fl_glL, fl_gsL, fl_klL, fl_kdL, fl_ksL);
  yb = cR.fl_circ(fl_cc, b, fl_glR, fl_gsR, fl_klR, fl_kdR, fl_ksR);
  fl_xf < 1 ? (
    oa = cL.fl_circ(fl_co, a, fl_glL, fl_gsL, fl_klL, fl_kdL, fl_ksL);
    ob = cR.fl_circ(fl_co, b, fl_glR, fl_gsR, fl_klR, fl_kdR, fl_ksR);
    t = fl_xf * fl_xf * (3 - 2 * fl_xf);
    ya = oa + (ya - oa) * t; yb = ob + (yb - ob) * t;
  );
  fz_l = ya; fz_r = yb;
  fz_o > 0.0001 ? fz_run();
  fl_wl = fz_l; fl_wr = fz_r;
);

function fl_l2(v) ( log(max(v, 0.000001)) * 1.4426950409; );
function fl_rd(base, n, p) local(q, i, f, j) (
  q = p * 32; q -= floor(q / n) * n;
  i = floor(q); i >= n ? i = 0; f = q - i; j = i + 1; j >= n ? j = 0;
  base[i] + (base[j] - base[i]) * f;
);
function fl_sw(p) local(e, c, u) (
  fl_sm == 0.5 ? p : (
    e = p * 2; c = floor(e); u = e - c;
    u = u < fl_sm ? 0.5 * u / fl_sm : 0.5 + 0.5 * (u - fl_sm) / (1 - fl_sm);
    (c + u) * 0.5;
  );
);
function fl_val(p) local(va, vb, qa, qb, ha, hb) (
  ha = fm_na > 0; hb = fm_nb > 0;
  rc_st > 0 || (!ha && !hb) ? ( fl_q = fl_rs; fl_ks; ) : (
    p = fl_sw(p);
    ha ? ( va = fl_rd(FMA, fm_na, p) + fl_ks - fm_ra; qa = fl_rd(FMAR, fm_na, p) + fl_rs - fm_qa; );
    hb ? ( vb = fl_rd(FMB, fm_nb, p) + fl_ks - fm_rb; qb = fl_rd(FMBR, fm_nb, p) + fl_rs - fm_qb; );
    !ha ? ( va = vb; qa = qb; ); !hb ? ( vb = va; qb = qa; );
    fl_q = qa + (qb - qa) * fl_w;
    va + (vb - va) * fl_w;
  );
);

function fl_cut(v, s) local(f, gl, gs, t, kl, kd, ks, r) (
  f = exp(min(max(v, fl_omin), fl_omax) * 0.69314718056);
  f = min(f, fl_fmax);
  gl = 1 - exp(-6.28318530718 * f / fl_fs); gl = min(gl, 0.95);
  gs = tan(3.14159265359 * f / fl_fs);
  r = min(max(fl_rq, 0), 1);
  t = (2 - gl) / gl;
  kl = min(3.95 * r, 0.5 * t * t * t * t);
  kd = min(7.7 * r * r * (3 - 2 * r) * 0.5 + 3.85 * r, 0.5 * t * t * t);
  ks = 2 - 1.96 * r;
  s == 0 ? (
    fl_dglL = (gl - fl_glL) * fl_cri; fl_dgsL = (gs - fl_gsL) * fl_cri;
    fl_dklL = (kl - fl_klL) * fl_cri; fl_dkdL = (kd - fl_kdL) * fl_cri; fl_dksL = (ks - fl_ksL) * fl_cri;
  ) : (
    fl_dglR = (gl - fl_glR) * fl_cri; fl_dgsR = (gs - fl_gsR) * fl_cri;
    fl_dklR = (kl - fl_klR) * fl_cri; fl_dkdR = (kd - fl_kdR) * fl_cri; fl_dksR = (ks - fl_ksR) * fl_cri;
  );
  f;
);

function fl_rclr() (
  rc_st = 0; rc_k = 0;
);
function fl_commit() local(n, i, d, b, br, t, o) (
  n = rc_n; b = rc_m ? FMB : FMA; br = rc_m ? FMBR : FMAR;
  d = FTC[0] - FTC[n - 1]; o = FTR[0] - FTR[n - 1];
  i = 0; loop(min(8, n - 1), t = (i + 1) / 9; FTC[n - 8 + i] += d * t * 0.9; FTR[n - 8 + i] += o * t * 0.9; i += 1; );
  memcpy(b, FTC, n); memcpy(br, FTR, n);
  rc_m ? (
    fm_ra += fl_ks - rc_ks0; fm_qa += fl_rs - rc_rs0; fm_rb = fl_ks; fm_qb = fl_rs; fm_nb = n;
  ) : (
    fm_rb += fl_ks - rc_ks0; fm_qb += fl_rs - rc_rs0; fm_ra = fl_ks; fm_qa = fl_rs; fm_na = n;
  );
  fl_bt = 0.06;
);
function fl_rec_step() local(b, kt, v, q, i) (
  rc_st == 1 ? (
    b = floor(fl_qb / fl_bq + 0.0000001);
    rc_bar < -0.5 ? (
      rc_bar = b;
      fl_play && (fl_qb / fl_bq - b) * fl_bq < 0.06 ? rc_bar = b - 1;
    );
    b != rc_bar ? (
      rc_st = 2; rc_d = 0; rc_k = 0;
      rc_s0 = floor(((fl_qb * fl_rt) - floor(fl_qb * fl_rt / rc_lq) * rc_lq) * 32);
      rc_s0 >= rc_n ? rc_s0 = 0;
    );
  );
  rc_st == 2 ? (
    kt = min(floor(rc_d * 32) + 1, rc_n);
    v = fl_ks; q = fl_rs;
    while (rc_k < kt) ( i = rc_s0 + rc_k; i >= rc_n ? i -= rc_n; FTC[i] = v; FTR[i] = q; rc_k += 1; );
    rc_d += fl_dqc * fl_rt;
    rc_k >= rc_n ? ( rc_tch ? fl_commit(); fl_rclr(); );
  );
  rc_st > 0 && (abs(slider1 - rc_s1) > 0.001 || abs(slider2 - rc_s2) > 0.001) ? rc_tch = 1;
);

function fl_ctl() local(p, pl, pr, vl, vr, lw, b, kg, kq, m, tt) (
  kg = fl_kg; fl_bt > 0 ? ( kg = max(kg, fl_kb); fl_bt -= fl_crt; );
  kq = max(kg, fl_kq0);
  fl_ks += (fl_l2(slider1) - fl_ks) * fl_kk; fl_rs += (slider2 / 100 - fl_rs) * fl_kk;
  fl_rec_step();
  fl_lev = 10 * log10(max(fl_env, 0.0000000001));
  lw = min(max((fl_lev - slider13) / 18 + 0.5, 0), 1); lw = lw * lw * (3 - 2 * lw);
  b = slider12 / 100;
  tt = slider14 >= 0.5 ? ( b < 0.5 ? lw * b * 2 : lw + (1 - lw) * (b - 0.5) * 2 ) : b;
  fl_w += (tt - fl_w) * fl_kw;
  fl_hold ? p = fl_hp : ( p = fl_qb * fl_rt + fl_jit; fl_hp = p; );
  pl = p; pr = p - fl_offq;
  vl = fl_val(pl); fl_qL = fl_q;
  vr = fl_offq > 0 ? fl_val(pr) : vl; fl_qR = fl_q;
  fl_mph += fl_mrt * fl_crt; fl_mph -= floor(fl_mph);
  m = fl_mdp * sin(6.28318530718 * fl_mph);
  fl_vL += (vl + m + fl_dcL - fl_vL) * kg; fl_vR += (vr + m + fl_dcR - fl_vR) * kg;
  fl_rL += (fl_qL - fl_rL) * kq; fl_rR += (fl_qR - fl_rR) * kq;
  fl_rq = fl_rL; fl_fL = fl_cut(fl_vL, 0);
  fl_rq = fl_rR; fl_fR = fl_cut(fl_vR, 1);
  fl_ph_n = slider4 >= 0.5 ? (fm_nb > 0 ? fm_nb : fm_na) : (fm_na > 0 ? fm_na : fm_nb);
  fl_ph_d = fl_ph_n > 0 ? (fl_sw(p) * 32 - floor(fl_sw(p) * 32 / fl_ph_n) * fl_ph_n) / fl_ph_n : 0;
  fl_cut_d = fl_fL;
);

function fl_rates() (
  fl_fs = srate * os_f;
  fl_fmax = min(18000, 0.45 * srate);
  fz_coefs(fl_fs);
);
function fl_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  dvL.fl_dclr(); dvR.fl_dclr();
  cL.fl_cclr(0); cL.fl_cclr(1); cL.fl_cclr(2); cR.fl_cclr(0); cR.fl_cclr(1); cR.fl_cclr(2);
  fz_clr(); fl_dxl = fl_dyl = fl_dxr = fl_dyr = 0;
  memset(DRY, 0, 128);
);
function fl_snapc() (
  fl_glL = fl_glR = 1 - exp(-6.28318530718 * min(slider1, fl_fmax) / fl_fs);
  fl_gsL = fl_gsR = tan(3.14159265359 * min(slider1, fl_fmax) / fl_fs);
  fl_klL = fl_klR = fl_kdL = fl_kdR = 0; fl_ksL = fl_ksR = 2;
  fl_dglL = fl_dgsL = fl_dklL = fl_dkdL = fl_dksL = 0;
  fl_dglR = fl_dgsR = fl_dklR = fl_dkdR = fl_dksR = 0;
);
function fl_setup() local(s, d) (
  fl_gin = fl_db2g(slider19); fl_gout = fl_db2g(slider20); fl_mix = slider11 / 100;
  d = slider10;
  fl_dg = 0.5 * fl_db2g(d); fl_dm = 2 / fl_db2g(0.85 * d);
  fl_fzt = 0.33 * min(max((d - 12) / 12, 0), 1);
  s = slider3 / 100;
  fl_kg = 1 - exp(-fl_crt / (0.0015 + s * s * 0.25));
  fl_rt = slider6 < 0.5 ? 0.5 : slider6 < 1.5 ? 1 : 2;
  fl_rt != fl_rt0 ? ( fl_rt0 > 0 ? fl_bt = 0.06; fl_rt0 = fl_rt; );
  fl_sm = 0.5 + slider15 / 100 * 0.3333333;
  fl_offq = slider16 / 100 * 0.5;
  fl_mdp = slider17 / 100 * 2;
  fl_mrt = min(max(slider18, 0.01), 1);
  fl_mt = slider9 | 0;
  fl_h1 = slider7 >= 0.5; fl_h1 != fl_hold ? ( fl_hold = fl_h1; fl_bt = 0.06; );
);
function fl_cr_init() (
  fl_crt = 16 / srate; fl_cri = 1 / 16;
  fl_kk = 1 - exp(-fl_crt / 0.02);
  fl_kb = 1 - exp(-fl_crt / 0.025);
  fl_kq0 = 1 - exp(-fl_crt / 0.008);
  fl_kw = 1 - exp(-fl_crt / 0.03);
  fl_ea = 1 - exp(-1 / (0.01 * srate)); fl_er = 1 - exp(-1 / (0.25 * srate));
);

function fl_gen(m, nq, kind, lo, hi, r0, r1) local(n, i, t, u, v, q, b, br, a) (
  n = min(floor(nq * 32), FM_MAX); b = m ? FMB : FMA; br = m ? FMBR : FMAR;
  lo = fl_l2(lo); hi = fl_l2(hi);
  i = 0;
  loop(n,
    t = i / 32;
    kind == 0 ? ( u = t - floor(t); a = exp(-5 * u); ) :
    kind == 1 ? ( u = t * 2 - floor(t * 2); a = exp(-5 * u); ) :
    kind == 2 ? ( a = 0.5 - 0.5 * cos(6.28318530718 * i / n); ) :
    kind == 3 ? ( u = t - floor(t); a = u < 0.75 ? exp(-4 * u / 0.75) : 0.85 * exp(-4 * (u - 0.75) / 0.25); ) :
    ( u = (t * 2 - floor(t * 2)); a = 0.5 - 0.5 * cos(6.28318530718 * u); );
    v = lo + (hi - lo) * a; q = r0 + (r1 - r0) * a;
    b[i] = v; br[i] = q;
    i += 1;
  );
  m ? ( fm_nb = n; fm_rb = fl_l2(slider1); fm_qb = slider2 / 100; ) : ( fm_na = n; fm_ra = fl_l2(slider1); fm_qa = slider2 / 100; );
);
function fl_pm(c, r, sm, ln, rt, ci, mo, dr, mx, bl, se, bm, sw, of, mt, ms) (
  slider1 = c; slider2 = r; slider3 = sm; slider4 = 0; slider5 = ln; slider6 = rt; slider7 = 0; slider8 = ci; slider9 = mo;
  slider10 = dr; slider11 = mx; slider12 = bl; slider13 = se; slider14 = bm; slider15 = sw; slider16 = of; slider17 = mt; slider18 = ms;
  slider19 = 0; slider20 = 0;
);
function load_preset(p) (
  fm_na = fm_nb = 0; fm_ra = fm_rb = fm_qa = fm_qb = 0; fl_rclr();
  p == 1 ? ( fl_pm(1100, 20, 30, 1, 1, 0, 0, 0, 100, 50, -24, 1, 0, 0, 0, 0.1); slider21 = 50; ) :
  p == 2 ? ( fl_pm(1100, 35, 20, 1, 1, 0, 0, 3, 100, 50, -22, 1, 0, 0, 0, 0.1);
             fl_gen(0, 4, 0, 220, 2200, 0.35, 0.35); fl_gen(1, 4, 1, 330, 4400, 0.45, 0.45); ) :
  p == 3 ? ( fl_pm(660, 30, 60, 3, 1, 1, 0, 4, 100, 50, -24, 1, 0, 40, 30, 0.05);
             fl_gen(0, 16, 2, 110, 1100, 0.3, 0.3); fl_gen(1, 16, 2, 220, 3300, 0.4, 0.5); ) :
  p == 4 ? ( fl_pm(880, 55, 25, 1, 1, 2, 1, 2, 100, 50, -24, 1, 45, 30, 0, 0.1);
             fl_gen(0, 4, 4, 440, 2200, 0.55, 0.55); fl_gen(1, 4, 3, 330, 3300, 0.6, 0.6); );
  fl_bt = 0.06;
  slider_automate(8388607);
);

function fl_srinit() (
  fl_sr = srate;
  fl_smc = 1 - exp(-1 / (0.03 * srate));
  fl_xfs = 1 / (0.015 * srate);
  fl_wks = 1 - exp(-1 / (0.015 * srate));
  fl_fis = 1 / (0.01 * srate);
  gdc_r = 1 - 2 * $pi / srate;
  fl_dck = 1 - 2 * $pi * 5 / srate;
  fl_cr_init(); fl_rates(); fl_setup(); fl_clear(); fl_snapc();
);
fl_omin = fl_l2(22); fl_omax = fl_l2(18000);
os_design();
os_f = os_tf = os_f2n(slider23); os_base = 0;
ost_init(0);
ost_setup(0, 0, 120, 6000, -0.3, 1);
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
fl_cc = slider8 | 0; fl_co = fl_cc; fl_xf = 1;
fl_ks = fl_l2(slider1); fl_rs = slider2 / 100; fl_vL = fl_vR = fl_ks; fl_rL = fl_rR = fl_rs;
fl_wlo = 1; fl_wbp = 0; fl_whp = 0;
fl_w = slider14 >= 0.5 ? 0 : slider12 / 100;
