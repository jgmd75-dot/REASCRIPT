desc:Check Mini [mix check] (GFX Lab)
//tags: mix check monitor mono phone laptop car club reference utility mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:0<0,4,1{Stereo,Mono,Sides,Left,Right}>-Listen
slider2:0<0,1,1{Off,On}>-Swap
slider3:0<0,6,1{Flat,Phone,Laptop,Earbuds,Radio,Car,Club}>-System
slider4:0<0,3,1{Full,Low,Mid,High}>-Band
slider5:0<0,1,1{Off,On}>-Dim
slider6:0<0,1,1{Off,On}>-Ref
slider7:0<-30,6,0.1>-Level (dB)
slider8:-10<-30,0,0.1>-Ref level (dB)
slider9:0<0,1,1{Off,On}>-Bypass
slider10:prs_sel=0<0,10,1{No preset,Init,Mono Check,Phone,Laptop,Earbuds,Kitchen Radio,Car,Club,Bass Check,Sides Only}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-check-mini";
ext_noinit = 1;
function ck_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function bq_set(t, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w, cw, sw, al, amp, n, sq) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); sw = sin(w); al = sw / (2 * q); amp = 10 ^ (gdb / 40);
  t == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  t == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  t == 2 ? ( n = 1 + al / amp; b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = -2 * cw / n; a2 = (1 - al / amp) / n; ) :
  t == 3 ? ( sq = 2 * sqrt(amp) * al; n = (amp + 1) + (amp - 1) * cw + sq;
             b0 = amp * ((amp + 1) - (amp - 1) * cw + sq) / n; b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n; b2 = amp * ((amp + 1) - (amp - 1) * cw - sq) / n;
             a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n; a2 = ((amp + 1) + (amp - 1) * cw - sq) / n; ) :
  t == 4 ? ( sq = 2 * sqrt(amp) * al; n = (amp + 1) - (amp - 1) * cw + sq;
             b0 = amp * ((amp + 1) + (amp - 1) * cw + sq) / n; b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n; b2 = amp * ((amp + 1) + (amp - 1) * cw - sq) / n;
             a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n; a2 = ((amp + 1) - (amp - 1) * cw - sq) / n; ) :
           ( b0 = 1; b1 = b2 = a1 = a2 = 0; );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, s1, s2) local(y) ( y = b0 * x + s1; s1 = b1 * x - a1 * y + s2; s2 = b2 * x - a2 * y; y; );
function bq_clr() instance(s1, s2) ( s1 = s2 = 0; );
function bq_tidy() instance(s1, s2) ( s1 = ck_tn(s1); s2 = ck_tn(s2); );

function sy_run(x) ( this.q4.bq_run(this.q3.bq_run(this.q2.bq_run(this.q1.bq_run(x)))); );
function sy_clr() ( this.q1.bq_clr(); this.q2.bq_clr(); this.q3.bq_clr(); this.q4.bq_clr(); );
function sy_tidy() ( this.q1.bq_tidy(); this.q2.bq_tidy(); this.q3.bq_tidy(); this.q4.bq_tidy(); );
function sy_set(s) (
  s == 1 ? ( this.q1.bq_set(1, 700, 0.9, 0); this.q2.bq_set(2, 2500, 1.2, 4); this.q3.bq_set(0, 8000, 0.7, 0); this.q4.bq_set(1, 500, 0.7, 0); ) :
  s == 2 ? ( this.q1.bq_set(1, 250, 0.8, 0); this.q2.bq_set(2, 1500, 1, 3); this.q3.bq_set(2, 4000, 2, -2); this.q4.bq_set(0, 14000, 0.7, 0); ) :
  s == 3 ? ( this.q1.bq_set(3, 100, 0.7, 4); this.q2.bq_set(2, 3000, 1, 3); this.q3.bq_set(4, 10000, 0.7, -2); this.q4.bq_set(5, 1, 1, 0); ) :
  s == 4 ? ( this.q1.bq_set(1, 180, 0.8, 0); this.q2.bq_set(2, 1000, 0.7, 5); this.q3.bq_set(0, 5000, 0.8, 0); this.q4.bq_set(1, 150, 0.7, 0); ) :
  s == 5 ? ( this.q1.bq_set(3, 70, 0.7, 6); this.q2.bq_set(2, 250, 1.2, -3); this.q3.bq_set(2, 3000, 1, 2); this.q4.bq_set(4, 8000, 0.7, -3); ) :
  s == 6 ? ( this.q1.bq_set(1, 35, 0.7, 0); this.q2.bq_set(3, 60, 0.7, 7); this.q3.bq_set(4, 8000, 0.7, -4); this.q4.bq_set(5, 1, 1, 0); ) :
           ( this.q1.bq_set(5, 1, 1, 0); this.q2.bq_set(5, 1, 1, 0); this.q3.bq_set(5, 1, 1, 0); this.q4.bq_set(5, 1, 1, 0); );
  this.sy_clr();
);
function ck_sysinfo(s) (
  ck_smono = s == 1 || s == 4 || s == 6;
  ck_swid = s == 2 ? 0.5 : 1;
  ck_strim = 10 ^ ((s == 1 ? CK_T1 : s == 2 ? CK_T2 : s == 3 ? CK_T3 : s == 4 ? CK_T4 : s == 5 ? CK_T5 : s == 6 ? CK_T6 : 0) / 20);
);
CK_T1 = 4.77; CK_T2 = 3.65; CK_T3 = -2.49; CK_T4 = 2.75; CK_T5 = -3.5; CK_T6 = 1.95;

function bs_run(x, b) local(lo, r) (
  b == 1 ? this.b2.bq_run(this.b1.bq_run(x)) :
  b == 2 ? this.b6.bq_run(this.b5.bq_run(this.b4.bq_run(this.b3.bq_run(x)))) :
           this.b8.bq_run(this.b7.bq_run(x));
);
function bs_init() (
  this.b1.bq_set(0, 200, 0.70710678, 0); this.b2.bq_set(0, 200, 0.70710678, 0);
  this.b3.bq_set(1, 200, 0.70710678, 0); this.b4.bq_set(1, 200, 0.70710678, 0);
  this.b5.bq_set(0, 3000, 0.70710678, 0); this.b6.bq_set(0, 3000, 0.70710678, 0);
  this.b7.bq_set(1, 3000, 0.70710678, 0); this.b8.bq_set(1, 3000, 0.70710678, 0);
);
function bs_clr() (
  this.b1.bq_clr(); this.b2.bq_clr(); this.b3.bq_clr(); this.b4.bq_clr(); this.b5.bq_clr(); this.b6.bq_clr(); this.b7.bq_clr(); this.b8.bq_clr();
);

#ck_pm = "Init|Mono Check|Phone|Laptop|Earbuds|Kitchen Radio|Car|Club|Bass Check|Sides Only";
function ck_p(l, w, s, b) ( slider1 = l; slider2 = w; slider3 = s; slider4 = b; );
function load_preset(p) (
  p == 1  ? ( ck_p(0, 0, 0, 0); slider5 = 0; slider6 = 0; slider7 = 0; slider8 = -10; ) :
  p == 2  ? ck_p(1, 0, 0, 0) : p == 3 ? ck_p(0, 0, 1, 0) : p == 4 ? ck_p(0, 0, 2, 0) :
  p == 5  ? ck_p(0, 0, 3, 0) : p == 6 ? ck_p(0, 0, 4, 0) : p == 7 ? ck_p(0, 0, 5, 0) : p == 8 ? ck_p(0, 0, 6, 0) :
  p == 9  ? ck_p(1, 0, 0, 1) : p == 10 ? ck_p(2, 0, 0, 0);
  slider_automate(511);
);
function ck_srinit() (
  ck_sr = srate;
  ck_gs = 1 - exp(-1 / (0.015 * srate));
  ck_dst = 1 / (0.008 * srate);
  ck_fis = 1 / (0.01 * srate);
  bsL.bs_init(); bsR.bs_init(); syL.sy_set(ck_sys); syR.sy_set(ck_sys);
);
ck_sys = 0; ck_band = 0;
ck_srinit();
in_init();
ck_sysinfo(0);
ck_dip = 1; ck_dipdir = 0; ck_fi = 1;
ck_snap = 1;
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(9);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(9, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != ck_sr ? ck_srinit();
ck_now = time_precise();
ck_tp > 0 && ck_now - ck_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > ck_gpp && play_position - ck_gpp < 4 * ck_gpd + 0.05) ? (
  syL.sy_clr(); syR.sy_clr(); bsL.bs_clr(); bsR.bs_clr(); ck_fi = 0;
);
ck_tp = ck_now; ck_gpp = play_position; ck_gpd = samplesblock / srate;
in_setup(0, 0);
ck_l = floor(min(max(slider1, 0), 4) + 0.5);
ck_l == 0 ? ( ck_taL = 1; ck_tbL = 0; ck_taR = 0; ck_tbR = 1; ) :
ck_l == 1 ? ( ck_taL = 0.5; ck_tbL = 0.5; ck_taR = 0.5; ck_tbR = 0.5; ) :
ck_l == 2 ? ( ck_taL = 0.5; ck_tbL = -0.5; ck_taR = 0.5; ck_tbR = -0.5; ) :
ck_l == 3 ? ( ck_taL = 1; ck_tbL = 0; ck_taR = 1; ck_tbR = 0; ) :
            ( ck_taL = 0; ck_tbL = 1; ck_taR = 0; ck_tbR = 1; );
slider2 >= 0.5 ? ( ck_t = ck_taL; ck_taL = ck_taR; ck_taR = ck_t; ck_t = ck_tbL; ck_tbL = ck_tbR; ck_tbR = ck_t; );
ck_st = floor(min(max(slider3, 0), 6) + 0.5); ck_bt = floor(min(max(slider4, 0), 3) + 0.5);
(ck_st != ck_sys || ck_bt != ck_band) ? (
  ck_snap ? ( ck_sys = ck_st; ck_band = ck_bt; syL.sy_set(ck_sys); syR.sy_set(ck_sys); ck_sysinfo(ck_sys); ) : ck_dipdir = -1;
);
ck_lvt = 10 ^ ((slider6 >= 0.5 ? min(max(slider8, -30), 0) : min(max(slider7, -30), 6)) / 20) * (slider5 >= 0.5 ? 0.1 : 1);
ck_snap ? (
  ck_aL = ck_taL; ck_bL = ck_tbL; ck_aR = ck_taR; ck_bR = ck_tbR; ck_lvs = ck_lvt; ck_mns = ck_smono; ck_wds = ck_swid; ck_trs = ck_strim;
  ck_snap = 0;
);
syL.sy_tidy(); syR.sy_tidy();
ck_vu_d = max(ck_vu_d, sqrt(ck_msq / max(samplesblock, 1))); ck_msq = 0;
ck_pk_d = max(ck_pk_d, ck_pkm); ck_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
ck_xl = in_l; ck_xr = in_r;
ck_dipdir < 0 ? (
  ck_dip -= ck_dst;
  ck_dip <= 0 ? (
    ck_dip = 0; ck_dipdir = 1;
    ck_st != ck_sys ? ( ck_sys = ck_st; syL.sy_set(ck_sys); syR.sy_set(ck_sys); ck_sysinfo(ck_sys); ck_mns = ck_smono; ck_wds = ck_swid; ck_trs = ck_strim; );
    ck_bt != ck_band ? ( ck_band = ck_bt; bsL.bs_clr(); bsR.bs_clr(); );
  );
) : ck_dipdir > 0 ? ( ck_dip += ck_dst; ck_dip >= 1 ? ( ck_dip = 1; ck_dipdir = 0; ); );
ck_aL += (ck_taL - ck_aL) * ck_gs; ck_bL += (ck_tbL - ck_bL) * ck_gs; ck_aR += (ck_taR - ck_aR) * ck_gs; ck_bR += (ck_tbR - ck_bR) * ck_gs;
ck_yl = ck_aL * ck_xl + ck_bL * ck_xr; ck_yr = ck_aR * ck_xl + ck_bR * ck_xr;
ck_sys > 0 ? (
  ck_mns > 0 ? ( ck_m = 0.5 * (ck_yl + ck_yr); ck_yl = ck_m; ck_yr = ck_m; ) :
  ck_wds < 1 ? ( ck_m = 0.5 * (ck_yl + ck_yr); ck_s = 0.5 * (ck_yl - ck_yr) * ck_wds; ck_yl = ck_m + ck_s; ck_yr = ck_m - ck_s; );
  ck_yl = syL.sy_run(ck_yl) * ck_trs; ck_yr = ck_mns > 0 ? ck_yl : syR.sy_run(ck_yr) * ck_trs;
);
ck_band > 0 ? ( ck_yl = bsL.bs_run(ck_yl, ck_band); ck_yr = bsR.bs_run(ck_yr, ck_band); );
ck_lvs += (ck_lvt - ck_lvs) * ck_gs;
ck_e = ck_dip * ck_dip * (3 - 2 * ck_dip);
ck_yl *= ck_lvs * ck_e; ck_yr *= ck_lvs * ck_e;
ck_fi < 1 ? (
  ck_fi = min(ck_fi + ck_fis, 1); ck_z = ck_fi * ck_fi * (3 - 2 * ck_fi);
  ck_yl = by_il + (ck_yl - by_il) * ck_z; ck_yr = by_ir + (ck_yr - by_ir) * ck_z;
);
spl0 = max(-4, min(4, ck_yl));
spl1 = max(-4, min(4, ck_yr));
by_out();
ck_msq += 0.5 * (spl0 * spl0 + spl1 * spl1);
ck_pkm = max(ck_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0xDCE7DC; mk_band = 0x223022; mk_ink = 0xF2F8EE; mk_tab = 0x8DB41A; mk_tink = 0x1F2B1F;
mk_sub = 0x2E3E2E; mk_hot = 0xDCF0A0; mk_lime = 0xB8DC4A;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.3);
mg_byp = 9;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, p0, p1) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; p0 = floor(xl); p1 = floor(xr);
  hw > 0 ? loop(n,
    p0 == p1 ? ( gfx_a = xr - xl; gfx_rect(p0, j, 1, 1); ) : (
      gfx_a = p0 + 1 - xl; gfx_rect(p0, j, 1, 1);
      gfx_a = 1; p1 > p0 + 1 ? gfx_rect(p0 + 1, j, p1 - p0 - 1, 1);
      gfx_a = xr - p1; xr > p1 ? gfx_rect(p1, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(mk_sub, 0x000000, 0.3)); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.3)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0x1A1A1C); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0xF4F6F8); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(mk_tink); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KR, i, t) (
  KX = x * sc; KY = y * sc; KR = r * sc;
  sty == 1 ? (
