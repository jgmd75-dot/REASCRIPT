);
function hb_clr() instance(ua0, ua1, ua2, ua3, ua4, ua5, ux0, ux1, ux2, ux3, ux4, ux5, ub0, ub1, ub2, ub3, ub4, ub5, uy0, uy1, uy2, uy3, uy4, uy5, o0, o1,
