file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
by_in();
in_process(spl0, spl1);
pwr_in(in_l, in_r); dp_l = pwr_l; dp_r = pwr_r;
fz_o += (fz_t - fz_o) * dp_smk;

dp_mx += (dp_mxt - dp_mx) * dp_smk;
dp_o_ += (dp_ot - dp_o_) * dp_smk;
dp_pre += (dp_pret - dp_pre) * 0.0004;
dp_et += (dp_ett - dp_et) * 0.0002;
dp_ktar != dp_key || dp_patt != dp_pat ? (
  dp_vf -= dp_vfs;
