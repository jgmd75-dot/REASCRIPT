function dp_drv1(x) local(y) ( y = dp_ber ? this.sa.dp_sate(x) : this.dz.dz_satt(x); fz_o > 0.0001 ? y += this.fz.fz_run(y); y; );

function dp_dap(x) instance(b, ln) local(y) (
  y = b[(dp_aw - ln) & dp_am] - dp_dg * x; b[dp_aw] = x + dp_dg * y; y;
);
function dp_diff(x, k0) (
  k0 ? dpD7.dp_dap(dpD6.dp_dap(dpD5.dp_dap(dpD4.dp_dap(x)))) : dpD3.dp_dap(dpD2.dp_dap(dpD1.dp_dap(dpD0.dp_dap(x))));
);
function dp_clus(x, k0) local(j, b, d, y) (
  j = 0;
  loop(4,
    b = dp_cb + (k0 + j) * dp_asz;
    d = b[(dp_aw - dp_cln[k0 + j]) & dp_am];
    y = d - dp_cg * x; b[dp_aw] = x + dp_cg * y; x = y;
    x += dp_csat * (x / (1 + 2.5 * abs(x)) - x);
    j += 1;
  );
