  dp_y_ = dp_v - dp_esm * dp_fa; dp_bb[dp_aw] = dp_fa + dp_esm * dp_y_; dp_fa = dp_y_;
  dp_bb = dp_cb + 9 * dp_asz; dp_v = dp_bb[(dp_aw - dp_cln[7]) & dp_am];
  dp_y_ = dp_v - dp_esm * dp_fb; dp_bb[dp_aw] = dp_fb + dp_esm * dp_y_; dp_fb = dp_y_;
  dp_fa = dzeA.bq_run(dzgA.dz_grit(dp_fa)); dp_fb = dzeB.bq_run(dzgB.dz_grit(dp_fb));
  dp_tb[dp_tw] = dp_quant(0.5 * (dp_xa + dp_xb) + dp_eg * dp_fb + dp_dn);
  dp_tb[dp_tsz + dp_tw] = dp_quant(dp_eg * dp_fa + dp_dn);
  dp_wl *= 0.8 * dp_wg; dp_wr *= 0.8 * dp_wg;
);
dp_tw = (dp_tw + 1) & dp_tm;
dp_aw = (dp_aw + 1) & dp_am;
dp_hpk = max(dp_hpk, max(abs(dp_wl), abs(dp_wr)));

dp_ber ? (
  dp_wl = rcL.bq_run(dp_wl); dp_wr = rcR.bq_run(dp_wr);
  dp_ea = max(abs(dp_wl), abs(dp_wr));
  dp_env += (dp_ea - dp_env) * (dp_ea > dp_env ? dp_enc : dp_enr);
  dp_ea = dp_env * dp_cn;
  dp_wl += dp_ea * (rand(2) - 1); dp_wr += dp_ea * (rand(2) - 1);
  dp_hph += 50 / srate; dp_hph >= 1 ? dp_hph -= 1;
  dp_hv = sin(2 * $pi * dp_hph); dp_hv = dp_hum * (0.7 * dp_hv + 0.5 * (abs(dp_hv) - 0.6366));
