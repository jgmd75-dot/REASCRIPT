function dp_ctl() local(i, T, Tl, Th, L, gl, gm, gh, d, sz, s2) (
  dp_ts += (dp_tt - dp_ts) * dp_tk;
  dp_szs += (dp_szt - dp_szs) * dp_tk;
  T = dp_ts * dp_cal * (1 + dp_ddv) * (dp_ber ? 1 + 0.3 * ((16 - dp_bits) / 8) ^ 4 : 1);
  Tl = T * dp_lomul * (dp_ber ? 1 : dp_lomx);
  Th = 1 / (1 / (T * dp_dmp) + 1 / dp_thf);
  sz = dp_lsc * dp_szs * 0.001 * srate;
  i = 0;
  loop(16,
    d = max(dp_len[i] * sz + dp_mdep * dp_dv[i], 8);
    dp_ln[i] = floor(d); dp_lf[i] = d - dp_ln[i];
    dp_tql[i] = max(floor(d * dp_tfl[i]), 1); dp_tqr[i] = max(floor(d * dp_tfr[i]), 1);
    L = (d + dp_apl[i]) * -6.9077553 / srate;
    gl = exp(L / Tl); gm = exp(L / T); gh = exp(L / Th);
    dp_kl[i] = gl / gm - 1; dp_ja[i] = gh / gm - 1; dp_jb[i] = gm;
    i += 1;
  );
  s2 = (dp_mode == 2 ? 0.9 * max(1, dp_gtm / 350) ^ 0.7 : dp_szt) * 0.001 * srate;
  i = 0; loop(8, dp_dln[i] = max(floor(dp_dbl[i] * s2), 1); i += 1; );
  d = dp_mode == 1 ? (0.024 + 0.096 * (dp_szt - 0.5)) : dp_ers * dp_szt;
  i = 0;
  loop(16,
    dp_etl[i] = max(floor(dp_efl[i] * d * srate), 1); dp_etr[i] = max(floor(dp_efr[i] * d * srate), 1);
    i += 1;
  );
  dp_mode == 1 ? (
    i = 0;
    loop(16,
      dp_egl[i] = sign(dp_egl[i]) * 10 ^ (-3 * dp_efl[i] * d / dp_ts) * (i & 1 ? 0.8 : 1);
      dp_egr[i] = sign(dp_egr[i]) * 10 ^ (-3 * dp_efr[i] * d / dp_ts) * (i & 1 ? 1 : 0.8);
      i += 1;
    );
  );
  dp_mode == 2 && (dp_gtm != dp_gch || dp_gsh != dp_gsc) ? ( dp_gch = dp_gtm; dp_gsc = dp_gsh; dp_gtaps(); );
  dp_rpk = max(dp_rpk * 0.985, dp_tpk); dp_tpk = 0;
  dp_q = 2 ^ max(ceil(log(max(dp_rpk, 0.0000000001) * 1.25) * 1.442695), -26) * dp_qm; dp_qi = 1 / dp_q;
  dp_eg = min(10 ^ (-3 * dp_ett / (dp_ts * srate)), 0.97);
  dp_wgs = dp_wg * (2.4 / max(dp_ts, 0.2)) ^ 0.15;
  dp_sync();
);

function update() local(b) (
  slider17 = slider17 >= 0.5 ? 1 : 0;
