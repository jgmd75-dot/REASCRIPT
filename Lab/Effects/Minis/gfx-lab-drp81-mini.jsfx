) : dp_vf < 1 ? dp_vf = min(dp_vf + dp_vfs, 1);
(dp_cc -= 1) <= 0 ? ( dp_cc = 32; dp_ctl(); );
dp_dn = -dp_dn;

dp_osT != dp_osF ? (
  dp_og = max(dp_og - dp_ogc, 0);
  dp_og == 0 ? ( dp_osF = dp_osT; dp_xc = 1 - exp(-2 * $pi * 120 / (srate * dp_osF));
                 dLu.hb_clr(); dRu.hb_clr(); dLu2.hb_clr(); dRu2.hb_clr(); dz_snap = 1;
                 fz_coef(srate * dp_osF); dcA.fz.fz_clr(); dcB.fz.fz_clr(); );
) : dp_og < 1 ? dp_og = min(dp_og + dp_ogc, 1);
dp_xa = dp_l * dp_dgt; dp_xb = dp_r * dp_dgt;
dp_og < 1 ? ( dp_xa *= dp_og * dp_og * (3 - 2 * dp_og); dp_xb *= dp_og * dp_og * (3 - 2 * dp_og); );
dp_ipk = max(dp_ipk, max(abs(dp_xa), abs(dp_xb)));
dp_osF == 1 ? (
  dp_ber ? ( dp_xa = saA.dp_sate(dp_xa); dp_xb = saB.dp_sate(dp_xb); )
