drD.drift_init(0.8 + rand(1) * 0.5); drH.drift_init(0.8 + rand(1) * 0.5);
dp_key = dp_ktar = 0;
update();
dp_key = dp_ktar; dp_pat = dp_patt; dp_ver = dp_vtar; dp_setup(dp_key); dp_clear(); dp_vf = 1;
update();
dp_ts = dp_tt; dp_szs = dp_szt; dp_ddv = 0; dp_ctl(); dp_cc = 0;
dp_mx = dp_mxt; dp_o_ = dp_ot; dp_pre = dp_pret; dp_et = dp_ett;
dp_w = 0; dp_aw = 0; dp_pw = 0; dp_tw = 0; dp_hph = 0;
dp_ipk = 0; dp_ovl = 0; dp_hpk = 0; dp_opkL = 0; dp_opkR = 0; dp_ovt = 0; dp_env = 0;

pwr_init();  pwr_wu_loss = 1;  pwr_wu_drv = 1.5;  pwr_wu_lp = 9000;  pwr_bloom = 0;
by_setup(30);
rs_f = 1; mn_ml_d = mn_mr_d = mn_pk_d = mn_ia_d = mn_xa_d = 0; mn_pl = mn_pr = mn_pkm = 0;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_sl() (
update();
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(29, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
prs_sl();

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? (
  rs_f = 0; rs_c = 1 / (0.015 * srate);
  dp_clear(); memset(dp_pb, 0, 2 * dp_psz); memset(dp_tb, 0, 2 * dp_tsz);
  dLu.hb_clr(); dRu.hb_clr(); dLu2.hb_clr(); dRu2.hb_clr(); dcA.fz.fz_clr(); dcB.fz.fz_clr(); dz_snap = 1;
  dp_dxl = dp_dxr = dp_dcl = dp_dcr = 0;
  lcL.x1 = lcL.x2 = lcL.y1 = lcL.y2 = 0; lcR.x1 = lcR.x2 = lcR.y1 = lcR.y2 = 0;
);
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
srate != dp_sr ? (
  dp_mem(); dp_tables(); dp_srinit(); update();
  dp_setup(dp_key); dp_clear(); dp_vf = 1; update();
  dp_ctl(); dp_cc = 0; dp_pre = dp_pret; dp_et = dp_ett;
  dp_w = 0; dp_aw = 0; dp_pw = 0; dp_tw = 0;
);
update();
dp_osT = dp_f2n(slider29);
dLu.hb_tidy(); dRu.hb_tidy(); dLu2.hb_tidy(); dRu2.hb_tidy();
dp_di = 0.15 * dm_s * samplesblock / srate;
dp_ddv = (dp_ber ? 0.02 : 0.015) * dm_a * drD.drift_tick(dp_di);
i = 0; loop(16, dp_dv[i] = dp_dtick(dp_dr + i * 4, dp_di); i += 1; );
dp_hum = dp_ber ? 0.000032 * dm_a * (1 + 0.35 * drH.drift_tick(dp_di * 2)) : 0;
dp_hss = dp_ber ? 0.000068 * dm_a : 0;
pwr_block(slider30 < 0.5);
dcA.fz.fz_dn(); dcB.fz.fz_dn();
mn_ml_d = max(mn_ml_d, mn_pl); mn_mr_d = max(mn_mr_d, mn_pr); mn_pl = mn_pr = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
mn_ia_d = max(mn_ia_d, dp_ipk / max(dp_dgt, 1)); mn_xa_d = max(mn_xa_d, dp_hpk); dp_ipk = dp_hpk = 0;

@serialize
