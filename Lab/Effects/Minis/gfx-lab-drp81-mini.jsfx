  dz_snap ? (
    dz_snap = 0; dzsA.x1 = dzsA.x2 = dzsA.y1 = dzsA.y2 = dp_xa; dzsB.x1 = dzsB.x2 = dzsB.y1 = dzsB.y2 = dp_xb;
  );
  dp_xa = dzsA.bq_run(dp_xa) / dp_dgt; dp_xb = dzsB.bq_run(dp_xb) / dp_dgt;
) : (
  dLu.hb_up(dp_xa); dRu.hb_up(dp_xb);
  dp_osF == 2 ? (
    dp_q0 = dcA.dp_drv1(dLu.o0); dp_q1 = dcA.dp_drv1(dLu.o1); dp_r0 = dcB.dp_drv1(dRu.o0); dp_r1 = dcB.dp_drv1(dRu.o1);
  ) : (
    dLu2.hb_up(dLu.o0); dp_q0 = dcA.dp_drv1(dLu2.o0); dp_q1 = dcA.dp_drv1(dLu2.o1); dp_q0 = dLu2.hb_dn(dp_q0, dp_q1);
    dLu2.hb_up(dLu.o1); dp_q1 = dcA.dp_drv1(dLu2.o0); dp_q2 = dcA.dp_drv1(dLu2.o1); dp_q1 = dLu2.hb_dn(dp_q1, dp_q2);
    dRu2.hb_up(dRu.o0); dp_r0 = dcB.dp_drv1(dRu2.o0); dp_r1 = dcB.dp_drv1(dRu2.o1); dp_r0 = dRu2.hb_dn(dp_r0, dp_r1);
    dRu2.hb_up(dRu.o1); dp_r1 = dcB.dp_drv1(dRu2.o0); dp_r2 = dcB.dp_drv1(dRu2.o1); dp_r1 = dRu2.hb_dn(dp_r1, dp_r2);
  );
  dz_snap = 0;
  dp_xa = dLu.hb_dn(dp_q0, dp_q1) / dp_dgt; dp_xb = dRu.hb_dn(dp_r0, dp_r1) / dp_dgt;
);
dp_ber ? ( dp_xa = aaL2.bq_run(aaL1.bq_run(dp_xa)); dp_xb = aaR2.bq_run(aaR1.bq_run(dp_xb)); );

dp_pb[dp_pw] = dp_xa; dp_pb[dp_psz + dp_pw] = dp_xb;
dp_rp = dp_pw - dp_pre; dp_rp < 0 ? dp_rp += dp_psz;
dp_ri = floor(dp_rp); dp_rf = dp_rp - dp_ri;
dp_i0 = dp_ri & dp_pm; dp_i1 = (dp_ri + 1) & dp_pm;
dp_xa = dp_pb[dp_i0] + (dp_pb[dp_i1] - dp_pb[dp_i0]) * dp_rf;
dp_xb = dp_pb[dp_psz + dp_i0] + (dp_pb[dp_psz + dp_i1] - dp_pb[dp_psz + dp_i0]) * dp_rf;
dp_pw = (dp_pw + 1) & dp_pm;
dp_vf < 1 ? ( dp_xa *= dp_vf; dp_xb *= dp_vf; );

dp_wl = 0; dp_wr = 0;
dp_mode == 0 ? (
  dp_tb[dp_tw] = dp_xa; dp_tb[dp_tsz + dp_tw] = dp_xb;
  dp_el = 0; dp_er = 0;
  dp_erl > 0 ? (
    dpR0.dp_etap(); dpR1.dp_etap(); dpR2.dp_etap(); dpR3.dp_etap(); dpR4.dp_etap(); dpR5.dp_etap();
    dpR6.dp_etap(); dpR7.dp_etap(); dpR8.dp_etap(); dpR9.dp_etap(); dpR10.dp_etap(); dpR11.dp_etap();
    dp_el *= 0.3; dp_er *= 0.3;
