  );
  dp_da = dp_diff(dp_xa, 0) * 0.5 + dp_el * 0.35;
  dp_db_ = dp_diff(dp_xb, 4) * 0.5 + dp_er * 0.35;

  dp_tl = 0; dp_tr = 0;
  dpL0.dp_line(); dpL1.dp_line(); dpL2.dp_line(); dpL3.dp_line(); dpL4.dp_line(); dpL5.dp_line(); dpL6.dp_line(); dpL7.dp_line();
  dpL8.dp_line(); dpL9.dp_line(); dpL10.dp_line(); dpL11.dp_line(); dpL12.dp_line(); dpL13.dp_line(); dpL14.dp_line(); dpL15.dp_line();
  dp_ha0 = dpL0.o + dpL1.o; dp_ha1 = dpL0.o - dpL1.o; dp_ha2 = dpL2.o + dpL3.o; dp_ha3 = dpL2.o - dpL3.o;
  dp_ha4 = dpL4.o + dpL5.o; dp_ha5 = dpL4.o - dpL5.o; dp_ha6 = dpL6.o + dpL7.o; dp_ha7 = dpL6.o - dpL7.o;
  dp_ha8 = dpL8.o + dpL9.o; dp_ha9 = dpL8.o - dpL9.o; dp_ha10 = dpL10.o + dpL11.o; dp_ha11 = dpL10.o - dpL11.o;
  dp_ha12 = dpL12.o + dpL13.o; dp_ha13 = dpL12.o - dpL13.o; dp_ha14 = dpL14.o + dpL15.o; dp_ha15 = dpL14.o - dpL15.o;
  dp_hb0 = dp_ha0 + dp_ha2; dp_hb2 = dp_ha0 - dp_ha2; dp_hb1 = dp_ha1 + dp_ha3; dp_hb3 = dp_ha1 - dp_ha3;
  dp_hb4 = dp_ha4 + dp_ha6; dp_hb6 = dp_ha4 - dp_ha6; dp_hb5 = dp_ha5 + dp_ha7; dp_hb7 = dp_ha5 - dp_ha7;
  dp_hb8 = dp_ha8 + dp_ha10; dp_hb10 = dp_ha8 - dp_ha10; dp_hb9 = dp_ha9 + dp_ha11; dp_hb11 = dp_ha9 - dp_ha11;
  dp_hb12 = dp_ha12 + dp_ha14; dp_hb14 = dp_ha12 - dp_ha14; dp_hb13 = dp_ha13 + dp_ha15; dp_hb15 = dp_ha13 - dp_ha15;
  dp_ha0 = dp_hb0 + dp_hb4; dp_ha4 = dp_hb0 - dp_hb4; dp_ha1 = dp_hb1 + dp_hb5; dp_ha5 = dp_hb1 - dp_hb5;
  dp_ha2 = dp_hb2 + dp_hb6; dp_ha6 = dp_hb2 - dp_hb6; dp_ha3 = dp_hb3 + dp_hb7; dp_ha7 = dp_hb3 - dp_hb7;
  dp_ha8 = dp_hb8 + dp_hb12; dp_ha12 = dp_hb8 - dp_hb12; dp_ha9 = dp_hb9 + dp_hb13; dp_ha13 = dp_hb9 - dp_hb13;
  dp_ha10 = dp_hb10 + dp_hb14; dp_ha14 = dp_hb10 - dp_hb14; dp_ha11 = dp_hb11 + dp_hb15; dp_ha15 = dp_hb11 - dp_hb15;
  dpL0.o = dp_ha0 + dp_ha8; dpL8.o = dp_ha0 - dp_ha8; dpL1.o = dp_ha1 + dp_ha9; dpL9.o = dp_ha1 - dp_ha9;
  dpL2.o = dp_ha2 + dp_ha10; dpL10.o = dp_ha2 - dp_ha10; dpL3.o = dp_ha3 + dp_ha11; dpL11.o = dp_ha3 - dp_ha11;
  dpL4.o = dp_ha4 + dp_ha12; dpL12.o = dp_ha4 - dp_ha12; dpL5.o = dp_ha5 + dp_ha13; dpL13.o = dp_ha5 - dp_ha13;
  dpL6.o = dp_ha6 + dp_ha14; dpL14.o = dp_ha6 - dp_ha14; dpL7.o = dp_ha7 + dp_ha15; dpL15.o = dp_ha7 - dp_ha15;
  dpL0.dp_ap(0); dpL1.dp_ap(1); dpL2.dp_ap(0); dpL3.dp_ap(1); dpL4.dp_ap(0); dpL5.dp_ap(1); dpL6.dp_ap(0); dpL7.dp_ap(1);
  dpL8.dp_ap(0); dpL9.dp_ap(1); dpL10.dp_ap(0); dpL11.dp_ap(1); dpL12.dp_ap(0); dpL13.dp_ap(1); dpL14.dp_ap(0); dpL15.dp_ap(1);
  dp_w = (dp_w + 1) & dp_bm;
  dp_wl = dp_tl * 0.25 * dp_wgs + dp_el * dp_erl;
  dp_wr = dp_tr * 0.25 * dp_wgs + dp_er * dp_erl;
) : dp_mode == 1 ? (
  dp_tb[dp_tw] = dp_xa; dp_tb[dp_tsz + dp_tw] = dp_xb;
  dp_el = 0; dp_er = 0;
  dpR0.dp_etap(); dpR1.dp_etap(); dpR2.dp_etap(); dpR3.dp_etap(); dpR4.dp_etap(); dpR5.dp_etap(); dpR6.dp_etap(); dpR7.dp_etap();
  dpR8.dp_etap(); dpR9.dp_etap(); dpR10.dp_etap(); dpR11.dp_etap(); dpR12.dp_etap(); dpR13.dp_etap(); dpR14.dp_etap(); dpR15.dp_etap();
  dp_wl = dp_el * 0.42 * dp_wg; dp_wr = dp_er * 0.42 * dp_wg;
) : dp_mode == 2 ? (
  dp_tb[dp_tw] = dp_diff(dp_xa, 0); dp_tb[dp_tsz + dp_tw] = dp_diff(dp_xb, 4);
  i = 0;
  loop(96,
    dp_wl += dp_ggl[i] * dp_tb[(dp_tw - dp_gtl[i]) & dp_tm];
    dp_wr += dp_ggr[i] * dp_tb[dp_tsz + ((dp_tw - dp_gtr[i]) & dp_tm)];
    i += 1;
  );
  dp_wl *= 0.8 * dp_wg; dp_wr *= 0.8 * dp_wg;
) : (
  dp_n = floor(dp_et); dp_f = dp_et - dp_n;
  dp_k = (dp_tw - dp_n) & dp_tm; dp_k1 = (dp_tw - dp_n - 1) & dp_tm;
  dp_ea = dp_tb[dp_k] + (dp_tb[dp_k1] - dp_tb[dp_k]) * dp_f;
  dp_eb_ = dp_tb[dp_tsz + dp_k] + (dp_tb[dp_tsz + dp_k1] - dp_tb[dp_tsz + dp_k]) * dp_f;
  dp_wl = dp_ea + 0.38 * dp_tb[(dp_tw - floor(dp_et * 0.375)) & dp_tm];
  dp_wr = dp_eb_ + 0.5 * dp_tb[(dp_tw - floor(dp_et * 0.625)) & dp_tm];
