);
function dp_quant(v) (
  dp_tpk = max(dp_tpk, abs(v)); dp_gpk = max(dp_gpk, abs(v));
  v = v >= 0 ? floor(v * dp_qi) * dp_q : -floor(-v * dp_qi) * dp_q;
  abs(v) > 0.9 ? ( dp_ovt = 1; v = sign(v) * (0.9 + (abs(v) - 0.9) / (1 + (abs(v) - 0.9) * 3.3333)); );
  v;
);

function dp_gtaps() local(i, f, e, sl, sr, L) (
  L = dp_gtm * 0.001 * srate; sl = 0; sr = 0;
  i = 0;
  loop(96,
    f = dp_gjl[i];
    e = dp_rev ? f ^ (1 + 2.5 * dp_gsh) : 1 - 0.8 * dp_gsh * f;
    f > 0.975 ? e *= (1 - f) / 0.025;
    dp_gtl[i] = max(floor(f * L), 1); dp_ggl[i] = e * (dp_hash(i + 300) < 0.5 ? -1 : 1); sl += e * e;
    f = dp_gjr[i];
    e = dp_rev ? f ^ (1 + 2.5 * dp_gsh) : 1 - 0.8 * dp_gsh * f;
    f > 0.975 ? e *= (1 - f) / 0.025;
    dp_gtr[i] = max(floor(f * L), 1); dp_ggr[i] = e * (dp_hash(i + 500) < 0.5 ? -1 : 1); sr += e * e;
    i += 1;
  );
  sl = 1 / sqrt(max(sl, 0.01)); sr = 1 / sqrt(max(sr, 0.01));
  i = 0; loop(96, dp_ggl[i] *= sl; dp_ggr[i] *= sr; i += 1; );
);

function dp_line() instance(bb, ln, lf, tql, tqr, sgl, sgr, lo, y, kl, ja, jb, o) local(n, v) (
  n = dp_w - ln;
