) : (
  dp_wl = floor(dp_wl * dp_wq + 0.5) / dp_wq; dp_wr = floor(dp_wr * dp_wq + 0.5) / dp_wq;
);
dp_wl = lcL.bq_run(dp_wl); dp_wr = lcR.bq_run(dp_wr);
dp_dxl = dp_wl - dp_dcl + dp_dcc * dp_dxl; dp_dcl = dp_wl; dp_wl = dp_dxl * dp_vf;
dp_dxr = dp_wr - dp_dcr + dp_dcc * dp_dxr; dp_dcr = dp_wr; dp_wr = dp_dxr * dp_vf;
dp_gd = min(2 * (1 - dp_mx), 1); dp_gw = min(2 * dp_mx, 1);
dp_ol = dp_l * dp_gd + dp_wl * dp_gw;
dp_or = dp_r * dp_gd + dp_wr * dp_gw;

pwr_out(dp_ol, dp_or); dp_ol = pwr_l; dp_or = pwr_r;
dp_ol = ostL.ost_band(dp_ol) * dp_o_;
dp_or = ostR.ost_band(dp_or) * dp_o_;
ost_out(dp_ol, dp_or);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); rs_w = rs_f * rs_f * (3 - 2 * rs_f); spl0 = by_il + (spl0 - by_il) * rs_w; spl1 = by_ir + (spl1 - by_ir) * rs_w; );
by_out();
mn_pl = max(mn_pl, abs(spl0)); mn_pr = max(mn_pr, abs(spl1)); mn_pkm = max(mn_pkm, max(mn_pl, mn_pr));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x7A7F77; mk_band = 0x1E221D; mk_ink = 0xF2F5EE; mk_tab = 0xA9C29A; mk_acc = 0xE6F4D6;
mk_sub = 0x343A32; mk_ink2 = 0xDCE4D4;
sc != mg_fsc ? (
