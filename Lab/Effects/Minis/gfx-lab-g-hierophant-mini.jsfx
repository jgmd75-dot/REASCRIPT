    xt = 0; xn = max(floor((0.006 - 0.0052 * sn) * srate), 2);
    xe = 1; xec = hi_udc(0.012 - 0.01 * sn); xlc = 1 - exp(-2 * $pi * (1500 + 10000 * sn) / srate); xlp = 0;
  ) : ( kmx = 0; xe = 0; );
