  );
);
function hi_urun() instance(f0, pd, pe, pec, om, orr, ix, ie, iec, ol, oe, oec, pc, pm,
                         nl, ne, nec, nb, nbt, nbv, nbc, nbi, ml, me, mec, mt,
                         kl, kset, kmx, kmc, kw, kenv, xe, xec, xlc, xlp, xt, xn,
                         cl, ce, cec, vt, cr, crh, crc, crn, crq, amp, gl, gr, act, kbs, nfl, pfl, nt,
                         mp1, mp2, mp3, mp4, mp5, mp6, p2, qa, fd, fdk, of, ofn, clp, clc)
                local(y, ya, f, nz, w, d, x, i, a, env) (
  ya = qa ? this.hi_uarun() : 0;
  act ? (
    y = 0; nz = rand(2) - 1;
    oe > 0.0001 ? (
      f = f0 * (1 + pd * pe); pe *= pec;
      om == 0 ? ( pc += f * hi_isr; pc -= floor(pc); x = sin(TWOPI * pc); ) :
      om == 1 ? ( pc += f * hi_isr; pc -= floor(pc); pm += f * orr * hi_isr; pm -= floor(pm);
                  x = sin(TWOPI * pc + ix * ie * sin(TWOPI * pm)); ie *= iec; ) :
      om == 2 ? ( pc += f * hi_isr; pc -= floor(pc); w = ix * ie; d = 0.5 * (1 - w); ie *= iec;
                  x = sin(TWOPI * (pc < d ? pc * 0.5 / d : 0.5 + (pc - d) * 0.5 / (1 - d))); ) :
      om == 3 ? ( pc += f * hi_isr; pc -= floor(pc); p2 += f * orr * hi_isr; p2 -= floor(p2); x = 0.5 * (hi_usq(pc) + hi_usq(p2)); ) :
                ( pc += f * hi_isr; pc -= floor(pc); p2 += f * orr * hi_isr; p2 -= floor(p2);
                  x = 0.6 * sin(TWOPI * pc) + 0.4 * sin(TWOPI * p2); );
      of < ofn ? ( x *= 0.5 - 0.5 * cos($pi * of / ofn); of += 1; );
      y += x * ol * oe; oe *= oec;
    ) : oe = 0;
    ne > 0.0001 || kenv > 0.0001 ? (
      nb && nbt < 3 * nbi ? ( (nbt % nbi) == 0 ? nbv = 1; env = nbv; nbv *= nbc; nbt += 1; ) : ( env = ne; ne *= nec; );
      a = nl * env + kw * kenv;
      nfl.hi_uf_run(nz * a); y += nfl.hi_uf_out(nt);
    ) : ne = 0;
    me > 0.0001 ? (
      mp1 += 205.3 * mt * hi_isr; mp2 += 304.4 * mt * hi_isr; mp3 += 369.6 * mt * hi_isr;
      mp4 += 522.7 * mt * hi_isr; mp5 += 540 * mt * hi_isr;   mp6 += 800 * mt * hi_isr;
      x = (hi_usq(mp1) + hi_usq(mp2) + hi_usq(mp3) + hi_usq(mp4) + hi_usq(mp5) + hi_usq(mp6)) / 6;
      y += x * ml * me; me *= mec;
    ) : me = 0;
    kmx > 0.0001 ? (
      kset == 3 ? ( x = nz * (nb && nbt < 3 * nbi ? nbv : xe * 0.3); xe *= xec; ) :
                  ( xlp += (nz * xe - xlp) * xlc; x = xlp * 0.15 + (xt < xn ? sin($pi * xt / xn) * 2 / xn * 48000 / srate * 8 : 0); xt += 1; xe *= xec; );
      a = 0; i = 0;
      loop(6,
        w = kbs[i] * kbs[18 + i] - kbs[6 + i] * kbs[24 + i] + kbs[12 + i] * x;
        kbs[24 + i] = kbs[18 + i]; kbs[18 + i] = w;
        a += w; i += 1;
      );
      kenv = max(abs(a) * 0.5, kenv * 0.9995);
      y += a * kl; kmx *= kmc;
    ) : ( kmx = 0; kenv *= 0.999; );
    ce > 0.0001 ? ( clp += (nz * cl * ce - clp) * clc; y += clp; ce *= cec; ) : ce = 0;
    vt == 1 ? ( pfl.hi_uf_run(y); y = pfl.hp; ) : vt == 2 ? ( y = pfl.hi_uf_run(y); );
    cr ? ( crc -= 1; crc <= 0 ? ( crc += crn; crh = floor(y * crq + 0.5) / crq; ); y = crh; );
    act = oe > 0.0001 || ne > 0.0001 || me > 0.0001 || kmx > 0.0001 || ce > 0.0001 || kenv > 0.0001;
    ya += y * amp;
  );
  fdk > 0 ? ( ya *= fd; fd -= fdk; fd <= 0 ? this.hi_uempty(); );
  hi_uL += ya * gl; hi_uR += ya * gr; hi_ua = 1;
);
function hi_ufade(k) instance(act, qa, fd, fdk) ( (act || qa) && (fdk == 0 || fdk < k) ? ( fdk == 0 ? fd = 1; fdk = k; ); );

function hi_uhit(k, v, tst) local(ak, t) (
  ak = min(max(v - 0.8, 0) * 5, 1);
  hi_uacc = ak * hi_uacb;
  ak > 0 ? hi_uacb = max(hi_uacb - 0.04 * ak, 0.6);
