  ps += (x - ps) * hi_dpc;
  cy = hi_dhc * (cy + x - ch); ch = x;
  x = hi_de((b0 + d0 * sw) * tf * hi_dpis);
  u = kr * (u - x * v) + ps * hi_dpg; v = kr * (v + x * u);
  kg = 1.63 + dg * (0.35 + 0.65 * sw);
  y = kc.hi_dsat(v * kg * 0.5) * gn * (gi + 1 / kg);
  y = (y + cy * cl) * lv * hi_dtk * 0.5;
  fdk > 0 ? ( y *= fd; fd -= fdk; fd <= 0 ? ( pn = 0; u = v = ps = cy = 0; ); );
  hi_dL += y * gl; hi_dR += y * gr;
  pn == 0 && abs(u) + abs(v) + abs(ps) + abs(cy) < 0.000001 ? ( on = 0; u = v = ps = sw = cy = ch = 0; kc.x1 = 0; fdk = 0; );
  hi_da = 1;
);

function hi_ds_trig(vel, cpx, g) instance(on, tf, r1, r2, swt, sc, pa, pn, cl, nc, nb, ng, cp, t, b2, b3, b4, ba, be, bc, tv, tt, f, lv, fd, fdk, sv) local(ak, j) (
  ak = hi_dacc(vel); hi_dspread(-0.62, 0.7, hdvs.v, ak, vel);
  f = 185 * LTM[1]; sv.hi_dsv_set(2200 * LTM[1] ^ 0.7, 1.2);
  tf = hi_dtf; r1 = hi_ddk(80 * LDM[1] * hi_ddf); r2 = hi_ddk(80 * 0.75 * LDM[1] * hi_ddf);
  swt = 1.4 * (0.8 + 0.25 * vel) * (1 + 0.3 * ak); sc = hi_dco(7 * (1 + 0.3 * ak));
  j = hi_dam * (cpx ? 0.25 : 1) * hi_dsnc(f * (1 + 0.7 * swt) * tf);
  pn > 0 ? pa = max(pa, j) : pa = j; pn = hi_dpn;
  cl = cpx ? 0 : 0.3 * (1 + ak);
  nc = hi_ddk(210 * LDM[1] * hi_ddf * (1 + 0.06 * ak));
  nb = 0.1 * ak + 0.2 * (vel - 0.72);
  ng = hi_dtn / (1 + nb);
  cp = cpx; t = 0;
  cpx ? (
    j = 0.0004 * dm_a * srate;
    b2 = floor(0.0102 * srate + j * (rand(2) - 1)); b3 = floor(0.0211 * srate + j * (rand(2) - 1));
    b4 = floor(0.0313 * srate + j * (rand(2) - 1));
    ba = hi_dam; be = max(be, ba); bc = hi_dco(3.5 / (1 + 0.3 * ak)); tv = hi_dam * 0.9 * hi_dtc / (1 + 0.3 * nb);
  ) : ( be = max(be, hi_dam); bc = nc; );
  lv = 0.70795 * g; fdk = 0; on = 1;
);
function hi_ds_run() instance(on, tf, r1, r2, swt, sc, pa, pn, cl, nc, nb, ng, cp, t, b2, b3, b4, ba, be, bc, tv, tt, f, lv, fd, fdk, sv,
                              sw, ps, u1, v1, u2, v2, cy, ch, te) local(x, e1, e2, st, nz, fg) (
  pn > 0 ? ( pn -= 1; x = pa; sw += (swt - sw) * hi_dscc; ) : ( x = 0; sw *= sc; sw < 0.000001 ? sw = 0; );
  ps += (x - ps) * hi_dpc;
  x = (1 + sw) * tf * f * hi_dpis; e1 = hi_de(x); e2 = hi_de(x * 1.78);
  x = ps * hi_dpg;
  u1 = r1 * (u1 - e1 * v1) + x; v1 = r1 * (v1 + e1 * u1);
  u2 = r2 * (u2 - e2 * v2) + x; v2 = r2 * (v2 + e2 * u2);
  cy = hi_dhc * (cy + ps - ch); ch = ps;
  st = (v1 + 0.5 * v2) * hi_dtb + cy * cl;
  cp ? (
    t += 1;
    t == b2 || t == b3 ? be = ba * 0.85 : t == b4 ? ( be = ba; tt = max(tt, tv); cp = 0; );
  );
  te += (tt - te) * hi_dta; tt *= nc;
  nz = (sv.hi_dsv(rand(2) - 1) + nb * sv.hp) * (be * ng + te) * 2.2;
  be *= bc;
  st *= 0.56 * lv * 0.5; nz *= 0.76 * lv * 0.5;
  fg = 1; fdk > 0 ? ( fg = fd; fd -= fdk; fd <= 0 ? ( pn = 0; cp = 0; be = te = tt = 0; u1 = v1 = u2 = v2 = ps = cy = 0; ); );
  hi_dL += (st + nz) * fg; hi_dR += st * fg; hi_dN += nz * fg;
  !cp && pn == 0 && be < 0.00003 && te < 0.00003 && tt < 0.00003 && abs(u1) + abs(v1) + abs(u2) + abs(v2) + abs(ps) + abs(cy) < 0.000001 ? (
    on = 0; be = te = tt = 0; u1 = v1 = u2 = v2 = ps = sw = cy = ch = 0; fdk = 0; );
  hi_da = 1;
);

function hi_dh_trig(vel, opn, tu, tone, ms, nzm, dbv, g) instance(on, d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6, ce, oe, cdq, odk, hmc, hmo, nz, lv, fd, fdk, sv) local(ak, t) (
  ak = hi_dacc(vel); hi_dspread(0.47, -0.6, hdvh.v, ak, vel);
  t = 2 ^ (tu / 12) * hi_dtf * hi_disr;
  d1 = 205.3 * t * (1 + 0.0021 * dm_a); d2 = 304.4 * t * (1 - 0.0034 * dm_a); d3 = 369.6 * t * (1 + 0.0015 * dm_a);
  d4 = 522.7 * t * (1 - 0.0011 * dm_a); d5 = 540 * t * (1 + 0.0029 * dm_a);   d6 = 800 * t * (1 - 0.0024 * dm_a);
  n1 = 1 / d1; n2 = 1 / d2; n3 = 1 / d3; n4 = 1 / d4; n5 = 1 / d5; n6 = 1 / d6;
  sv.hi_dsv_set(tone, 1.1); nz = nzm; lv = 10 ^ (dbv / 20) * g;
  t = 0.6 + 0.15 * vel + 0.12 * ak;
  opn ? ( oe = max(oe, hi_dam / (0.3 + t)); odk = hi_ddk(ms * hi_ddf); hmo = t; ) :
         ( ce = max(ce, hi_dam / (0.3 + t)); cdq = hi_ddk(ms * hi_ddf); hmc = t; odk = min(odk, hi_dchk); );
  fdk = 0; on = 1;
);
function hi_dh_run(gl, gr) instance(on, d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6, ce, oe, cdq, odk, hmc, hmo, nz, lv, fd, fdk, sv,
                                   p1, p2, p3, p4, p5, p6) local(x, hb, y) (
  p1 += d1; p1 >= 1 ? p1 -= 1; p2 += d2; p2 >= 1 ? p2 -= 1; p3 += d3; p3 >= 1 ? p3 -= 1;
  p4 += d4; p4 >= 1 ? p4 -= 1; p5 += d5; p5 >= 1 ? p5 -= 1; p6 += d6; p6 >= 1 ? p6 -= 1;
  x = (hi_dsqb(p1, d1, n1) + hi_dsqb(p2, d2, n2) + hi_dsqb(p3, d3, n3) + hi_dsqb(p4, d4, n4)
      + hi_dsqb(p5, d5, n5) + hi_dsqb(p6, d6, n6)) * 0.16666667;
  x = x * (1 - nz) + (rand(2) - 1) * nz;
  hb = sv.hi_dsv(x);
  y = ((hb + hmc * sv.hp) * ce + (hb + hmo * sv.hp) * oe) * lv * 1.6 * hi_dth * 0.5;
  ce *= cdq; oe *= odk;
  fdk > 0 ? ( y *= fd; fd -= fdk; fd <= 0 ? ce = oe = 0; );
  hi_dL += y * gl; hi_dR += y * gr;
  ce < 0.00003 && oe < 0.00003 ? ( on = 0; ce = oe = 0; fdk = 0; );
  hi_da = 1;
);

function hi_dr_trig(vel, fq, dms, g) instance(on, tf, r1, r2, swt, sc, cl, pa, pn, f, lv, fd, fdk) local(ak, p) (
  ak = hi_dacc(vel); hi_dspread(0.66, -0.8, hdvr.v, ak, vel);
  f = fq;
  tf = hi_dtf; r1 = hi_ddk(dms * hi_ddf); r2 = hi_ddk(dms * 0.8 * hi_ddf);
  swt = 0.03 + 0.05 * ak; sc = hi_dco(3);
  cl = 2 * (1 + 0.25 * ak);
  p = f * tf * 0.00062832;
  p = hi_dam * sqrt(sqrt(1 + p * p));
  pn > 0 ? pa = max(pa, p) : pa = p; pn = hi_drn;
  lv = 0.39811 * g; fdk = 0; on = 1;
);
function hi_dr_run(gl, gr) instance(on, tf, r1, r2, swt, sc, cl, pa, pn, f, lv, fd, fdk, sw, ps, u1, v1, u2, v2, cy, ch) local(x, e1, e2, y) (
  pn > 0 ? ( pn -= 1; x = pa; sw += (swt - sw) * hi_dscc; ) : ( x = 0; sw *= sc; sw < 0.000001 ? sw = 0; );
  ps += (x - ps) * hi_dpc;
  x = (1 + sw) * tf * f * hi_dpis; e1 = hi_de(x); e2 = hi_de(x * 0.27);
  x = ps * hi_drg;
  u1 = r1 * (u1 - e1 * v1) + x; v1 = r1 * (v1 + e1 * u1);
  u2 = r2 * (u2 - e2 * v2) + x; v2 = r2 * (v2 + e2 * u2);
  cy = hi_dhc * (cy + ps - ch); ch = ps;
  y = (v1 * 0.7 + v2 * 0.5 + cy * cl) * lv * hi_dtr * 0.5;
  fdk > 0 ? ( y *= fd; fd -= fdk; fd <= 0 ? ( pn = 0; u1 = v1 = u2 = v2 = ps = cy = 0; ); );
  hi_dL += y * gl; hi_dR += y * gr;
  pn == 0 && abs(u1) + abs(v1) + abs(u2) + abs(v2) + abs(ps) + abs(cy) < 0.000001 ? ( on = 0; u1 = v1 = u2 = v2 = ps = sw = cy = ch = 0; fdk = 0; );
  hi_da = 1;
);

function hi_dfade(k) instance(on, fd, fdk) ( on && fdk == 0 ? ( fdk = k; fd = 1; ); );

!hi_dwi ? ( hi_dwi = 1; hi_dwrm = 1; hdvk.drift_init(0.8 + rand(1) * 0.5); hdvs.drift_init(0.8 + rand(1) * 0.5); hdvh.drift_init(0.8 + rand(1) * 0.5); hdvr.drift_init(0.8 + rand(1) * 0.5); );
hi_dab = 1;
function hi_dblock() local(t) (
  dm_a > 0 ? (
    hi_dwrm *= exp(-samplesblock / (90 * srate)); t = samplesblock * 0.05 * dm_s / srate;
    hdvk.drift_tick(t); hdvs.drift_tick(t); hdvh.drift_tick(t); hdvr.drift_tick(t);
  );
);

function hi_dkit(l, v, vr, g) (
  l == 0 ? hdk0.hi_dk_trig(v, 48 * LTM[0], 180 * LTM[0], 35, 420 * LDM[0], 0.35, 25, 1, 0.31, 0.2, g) :
  l == 1 ? hds.hi_ds_trig(v, !(vr || v < 0.4), g) :
  l == 2 ? hdh.hi_dh_trig(v, 0, LTU[2], 9000, 45 * LDM[2], 0.35, -9, g) :
  l == 3 ? hdh.hi_dh_trig(v, 1, LTU[3], 9000, 380 * LDM[3], 0.35, -9, g) :
  l == 4 ? ( vr == 2 ? hds.hi_ds_trig(v, 1, g) : hdr.hi_dr_trig(v, 1700 * LTM[4], 25 * LDM[4], g); ) :
  l == 5 ? hdk5.hi_dk_trig(v, 96 * LTM[5], 75 * LTM[5], 30, 300 * LDM[5], 0.2, 12, 0.6, -0.5, 0.4, g) :
  l == 6 ? ( vr == 1 ? hdk6.hi_dk_trig(v, 113 * LTM[6], 83 * LTM[6], 28, 275 * LDM[6], 0.2, 12, 0.6, 0.6, -0.3, g) :
                       hdk6.hi_dk_trig(v, 142 * LTM[6], 105 * LTM[6], 26, 250 * LDM[6], 0.2, 12, 0.6, 0.6, -0.3, g); ) :
  l == 7 ? (
    vr == 1 ? hdy.hi_dh_trig(v, 1, LTU[7] - 2, 8000, 1900 * LDM[7], 0.55, -10, g) :
    vr == 3 ? hdy.hi_dh_trig(v, 1, LTU[7] + 7, 1800, 160 * LDM[7], 0, -8, g) :
    vr == 4 ? hdy.hi_dh_trig(v, 1, LTU[7] + 7, 9500, 170 * LDM[7], 0.5, -10, g) :
              hdy.hi_dh_trig(v, 1, LTU[7] - 5, 6500, 1100 * LDM[7], 0.3, -11, g);
  ) :
  (
    hi_asnd == 0 ? hdaH.hi_dh_trig(v, 0, 0, 6500, 60, 0.97, -12, g) :
    hi_asnd == 1 ? hdaH.hi_dh_trig(v, 1, 7, 9500, 170, 0.5, -10, g) :
    hi_asnd == 2 ? hdaH.hi_dh_trig(v, 0, 0, 9000, 45, 0.35, -9, g) :
    hi_asnd == 3 ? hdaH.hi_dh_trig(v, 1, -5, 6500, 1100, 0.3, -11, g) :
    hi_asnd == 4 ? hdaR.hi_dr_trig(v, 1700, 25, g) :
                   hdaK.hi_dk_trig(v, 48, 180, 35, 420, 0.35, 25, 1, 0.31, 0.2, g);
  );
);

function hi_dzero() instance(on, fdk, pn, u, v, ps, cy, ch, sw, u1, v1, u2, v2, be, te, tt, ce, oe, cp, kc) (
  on = fdk = pn = u = v = ps = cy = ch = sw = u1 = v1 = u2 = v2 = be = te = tt = ce = oe = cp = 0; kc.x1 = 0;
);

function hi_dsetup() local(sc) (
  hi_isr = 1 / srate;
  hi_dsd = min(floor(12 * 0.001 * srate), 8191);
  hi_dcthr = -14; hi_dcsl = 1 - 1 / 4; hi_dcat = hi_dco(8); hi_dcrl = hi_dco(120); hi_dcmk = 10 ^ (0.3 / 20);
  hdqa.hi_bq_set(0, 80, 0.707, 2); hdqb.hi_bq_set(0, 80, 0.707, 2);
  hdqc.hi_bq_set(1, 500, 1, -2); hdqd.hi_bq_set(1, 500, 1, -2);
  hdqe.hi_bq_set(2, 10000, 0.707, 2); hdqf.hi_bq_set(2, 10000, 0.707, 2);
  hi_dtg = 10 ^ (6 / 20); hi_dtc = 1 / sqrt(hi_dtg);
  sc = (0.35 + 0.65 * 0.35) * srate / 44100;
  hi_dc0 = floor(1116 * sc); hi_dc1 = floor(1188 * sc); hi_dc2 = floor(1277 * sc); hi_dc3 = floor(1356 * sc);
  hi_dc4 = floor(1139 * sc); hi_dc5 = floor(1211 * sc); hi_dc6 = floor(1300 * sc); hi_dc7 = floor(1379 * sc);
  hi_da0 = floor(556 * srate / 44100); hi_da1 = floor(441 * srate / 44100);
  hi_da2 = floor(579 * srate / 44100); hi_da3 = floor(464 * srate / 44100);
  hi_drfb = 0.7 + 0.28 * 0.45; hi_drd = exp(-2 * $pi * 5000 / srate); hi_drhp = exp(-2 * $pi * 250 / srate);
  hi_drwet = 10 ^ (-18 / 20) * 3;
  hi_dtlmax = floor(3 * srate);
);

function hi_dclear() (
  memset(HDSDL, 0, 8192); memset(HDCMB, 0, 8 * 8192); memset(HDAPB, 0, 4 * 4096); hi_dsw = 0;
  hdqa.hi_bq_clr(); hdqb.hi_bq_clr(); hdqc.hi_bq_clr(); hdqd.hi_bq_clr(); hdqe.hi_bq_clr(); hdqf.hi_bq_clr();
  hdc0.hi_dclr(); hdc1.hi_dclr(); hdc2.hi_dclr(); hdc3.hi_dclr(); hdc4.hi_dclr(); hdc5.hi_dclr(); hdc6.hi_dclr(); hdc7.hi_dclr();
  hda0.hi_dclr(); hda1.hi_dclr(); hda2.hi_dclr(); hda3.hi_dclr();
  hi_dgr = 0; hi_drh = 0;
);

function hi_dbus() local(xl, xr, j, tl, tr, rin, rx, rl, rr, ci, tg) (
  HDSDL[hi_dsw] = hi_dN; j = hi_dsw - hi_dsd; j < 0 ? j += 8192; hi_dR += HDSDL[j];
  hi_dsw += 1; hi_dsw >= 8192 ? hi_dsw = 0;
  xl = hi_dL; xr = hi_dR;
  ci = 20 * log10(max(abs(xl), abs(xr)) + hi_den);
  tg = min(0, (hi_dcthr - ci) * hi_dcsl);
  hi_dgr = tg < hi_dgr ? tg + (hi_dgr - tg) * hi_dcat : tg + (hi_dgr - tg) * hi_dcrl;
  tg = 10 ^ (hi_dgr * 0.05) * hi_dcmk; xl *= tg; xr *= tg;
  xl = hdqe.hi_bq_run(hdqc.hi_bq_run(hdqa.hi_bq_run(xl)));
  xr = hdqf.hi_bq_run(hdqd.hi_bq_run(hdqb.hi_bq_run(xr)));
  tl = hi_tanh(xl * hi_dtg); tr = hi_tanh(xr * hi_dtg);
  xl += (tl * hi_dtc - xl) * 0.5; xr += (tr * hi_dtc - xr) * 0.5;
  rin = (xl + xr) * 0.015;
  hi_drh = rin + (hi_drh - rin) * hi_drhp; rx = rin - hi_drh;
  rl = hdc0.hi_dcomb(HDCMB, hi_dc0, rx) + hdc1.hi_dcomb(HDCMB + 8192, hi_dc1, rx) + hdc2.hi_dcomb(HDCMB + 16384, hi_dc2, rx) + hdc3.hi_dcomb(HDCMB + 24576, hi_dc3, rx);
  rr = hdc4.hi_dcomb(HDCMB + 32768, hi_dc4, rx) + hdc5.hi_dcomb(HDCMB + 40960, hi_dc5, rx) + hdc6.hi_dcomb(HDCMB + 49152, hi_dc6, rx) + hdc7.hi_dcomb(HDCMB + 57344, hi_dc7, rx);
  rl = hda1.hi_dallp(HDAPB + 4096, hi_da1, hda0.hi_dallp(HDAPB, hi_da0, rl));
  rr = hda3.hi_dallp(HDAPB + 12288, hi_da3, hda2.hi_dallp(HDAPB + 8192, hi_da2, rr));
  hi_L += (xl + rl * hi_drwet) * hi_egd; hi_R += (xr + rr * hi_drwet) * hi_egd;
);

function hi_umset(s, r0, r1, r2, r3, r4, r5, a0, a1, a2, a3, a4, a5) (
  HUMR[s * 6] = r0; HUMR[s * 6 + 1] = r1; HUMR[s * 6 + 2] = r2; HUMR[s * 6 + 3] = r3; HUMR[s * 6 + 4] = r4; HUMR[s * 6 + 5] = r5;
  HUMA[s * 6] = a0; HUMA[s * 6 + 1] = a1; HUMA[s * 6 + 2] = a2; HUMA[s * 6 + 3] = a3; HUMA[s * 6 + 4] = a4; HUMA[s * 6 + 5] = a5;
);
hi_umset(0, 1, 1.594, 2.136, 2.296, 2.653, 2.918,  1, 0.65, 0.5, 0.42, 0.32, 0.25);
hi_umset(1, 1, 1.652, 2.338, 3.211, 4.282, 5.394,  1, 0.95, 0.85, 0.75, 0.65, 0.55);
hi_umset(2, 1, 2.756, 5.404, 8.933, 13.34, 18.64,  1, 0.45, 0.22, 0.11, 0.05, 0.025);
hi_umset(3, 1, 1.37, 2.08, 2.91, 3.62, 4.43,       1, 0.8, 0.6, 0.45, 0.3, 0.2);

function hi_uf_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(max(fc, 20), srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function hi_uf_run(x) instance(g, k, a1, a2, a3, ic1, ic2, bp, lp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1 + hi_den; ic2 = 2 * v2 - ic2 - hi_den;
  bp = v1; lp = v2; hp = x - k * v1 - v2;
  bp;
);
function hi_uf_out(t) instance(bp, lp, hp) ( t == 0 ? lp : t == 1 ? bp : hp; );
function hi_uf_clear() instance(ic1, ic2) ( ic1 = 0; ic2 = 0; );
function hi_udc(t) ( exp(-6.9 / (max(t, 0.0005) * srate)); );
function hi_usq(p) ( p - floor(p) < 0.5 ? 1 : -1; );

function hi_urecipe(m, k) (
  hi_uf = 100; hi_upd = 0; hi_upt = 0.03; hi_uom = 0; hi_uor = 1; hi_uix = 0; hi_uit = 0.05; hi_uol = 0; hi_uod = 0.2;
  hi_unl = 0; hi_unt = 1; hi_unf = 1000; hi_unq = 0.7; hi_und = 0.1; hi_unb = 0;
  hi_uml = 0; hi_umd = 0.1; hi_ukl = 0; hi_uks = 0; hi_ukf = 100; hi_ukd = 0.3; hi_ukdm = 0.5; hi_ukw = 0;
  hi_ucl = 0; hi_uvt = 0; hi_uvf = 1000; hi_uvq = 0.7; hi_ucr = 0; hi_utr = 1;
  k == 8 ? (
    hi_unl = 1; hi_unt = 2; hi_unf = 6500; hi_und = 0.055; hi_uvt = 1; hi_uvf = 5000;
  ) : k == 9 ? (
    hi_uml = 0.5; hi_umd = 0.16; hi_unl = 0.7; hi_unt = 2; hi_unf = 8500; hi_und = 0.17; hi_uvt = 1; hi_uvf = 6000;
  ) : k == 0 ? (
    m == 0 ? ( hi_uf = 52; hi_upd = 3; hi_upt = 0.035; hi_uol = 1; hi_uod = 0.45; hi_ucl = 0.35; ) :
    m == 1 ? ( hi_uf = 50; hi_upd = 2; hi_upt = 0.04; hi_uom = 1; hi_uor = 1; hi_uix = 4; hi_uit = 0.02; hi_uol = 1; hi_uod = 0.5; hi_ucl = 0.15; ) :
    m == 2 ? ( hi_uf = 50; hi_upd = 0.6; hi_upt = 0.05; hi_uol = 0.6; hi_uod = 0.3; hi_ukl = 0.8; hi_uks = 0; hi_ukf = 50; hi_ukd = 0.55; hi_ukdm = 1.2; hi_ucl = 0.2; ) :
             ( hi_uf = 50; hi_upd = 4; hi_upt = 0.03; hi_uom = 2; hi_uix = 0.9; hi_uit = 0.05; hi_uol = 1; hi_uod = 0.4; hi_ucr = 1; );
  ) : k == 1 ? (
    m == 0 ? ( hi_uf = 185; hi_uor = 1.78; hi_uom = 4; hi_upd = 0.3; hi_upt = 0.02; hi_uol = 0.6; hi_uod = 0.12;
               hi_unl = 0.8; hi_unt = 1; hi_unf = 5000; hi_unq = 0.6; hi_und = 0.2; hi_ucl = 0.2; ) :
    m == 1 ? ( hi_uf = 200; hi_uom = 1; hi_uor = 1.47; hi_uix = 3; hi_uit = 0.03; hi_uol = 0.6; hi_uod = 0.1;
               hi_unl = 0.7; hi_unt = 1; hi_unf = 3500; hi_unq = 0.8; hi_und = 0.18; ) :
    m == 2 ? ( hi_ukl = 0.9; hi_uks = 0; hi_ukf = 190; hi_ukd = 0.22; hi_ukdm = 0.6; hi_ukw = 1.2; hi_unl = 0.35; hi_unt = 1; hi_unf = 4500; hi_unq = 0.6; hi_und = 0.16; hi_ucl = 0.35; ) :
             ( hi_uf = 210; hi_uom = 2; hi_uix = 0.7; hi_uit = 0.04; hi_uol = 0.5; hi_uod = 0.1;
               hi_unl = 0.8; hi_unt = 1; hi_unf = 4000; hi_unq = 0.7; hi_und = 0.2; hi_ucr = 1; );
  ) : k == 2 ? (
    m == 0 ? ( hi_unl = 1; hi_unt = 1; hi_unf = 1100; hi_unq = 1.4; hi_und = 0.18; hi_unb = 1; ) :
    m == 1 ? ( hi_unl = 1; hi_unt = 1; hi_unf = 1300; hi_unq = 1; hi_und = 0.16; hi_unb = 1;
               hi_uf = 900; hi_uom = 1; hi_uor = 2.3; hi_uix = 5; hi_uit = 0.01; hi_uol = 0.3; hi_uod = 0.02; ) :
    m == 2 ? ( hi_ukl = 0.6; hi_uks = 3; hi_ukf = 850; hi_ukd = 0.05; hi_ukdm = 0.3; hi_unl = 0.9; hi_unt = 1; hi_unf = 1400; hi_unq = 1.1; hi_und = 0.17; hi_unb = 1; ) :
             ( hi_unl = 1; hi_unt = 1; hi_unf = 1500; hi_unq = 1; hi_und = 0.15; hi_unb = 1; hi_ucr = 1; );
  ) : (k == 3 || k == 4) ? (
    m == 0 ? ( hi_uml = 1; hi_umd = 0.045; hi_unl = 0.15; hi_unt = 2; hi_unf = 9000; hi_und = 0.03; hi_uvt = 1; hi_uvf = 7000; ) :
    m == 1 ? ( hi_uf = 4300; hi_uom = 1; hi_uor = 1.4727; hi_uix = 14; hi_uit = 0.5; hi_uol = 0.6; hi_uod = 0.045;
               hi_unl = 0.5; hi_unt = 2; hi_unf = 8000; hi_und = 0.04; hi_uvt = 1; hi_uvf = 6500; ) :
    m == 2 ? ( hi_ukl = 0.4; hi_uks = 1; hi_ukf = 4200; hi_ukd = 0.05; hi_ukdm = 0.15; hi_unl = 0.8; hi_unt = 1; hi_unf = 9000; hi_unq = 0.9; hi_und = 0.05;
               hi_ucl = 0.15; hi_uvt = 1; hi_uvf = 6500; ) :
             ( hi_unl = 0.8; hi_unt = 2; hi_unf = 8000; hi_und = 0.045; hi_uml = 0.4; hi_umd = 0.04; hi_ucr = 1; hi_uvt = 1; hi_uvf = 5500; );
    k == 4 ? ( hi_umd *= 8; hi_uod *= 8; hi_ukd *= 8; hi_und *= 8; );
  ) : k == 5 ? (
    m == 0 ? ( hi_uf = 120; hi_upd = 0.6; hi_upt = 0.08; hi_uol = 1; hi_uod = 0.35; hi_unl = 0.1; hi_unt = 0; hi_unf = 2000; hi_und = 0.05; hi_ucl = 0.15; ) :
    m == 1 ? ( hi_uf = 115; hi_upd = 0.4; hi_upt = 0.08; hi_uom = 1; hi_uor = 1.5; hi_uix = 2; hi_uit = 0.05; hi_uol = 1; hi_uod = 0.35; ) :
    m == 2 ? ( hi_ukl = 1; hi_uks = 0; hi_ukf = 110; hi_ukd = 0.45; hi_ukdm = 0.8; hi_ucl = 0.1; ) :
             ( hi_uf = 125; hi_upd = 0.8; hi_upt = 0.06; hi_uom = 2; hi_uix = 0.6; hi_uit = 0.1; hi_uol = 1; hi_uod = 0.3; hi_ucr = 1; );
  ) : k == 6 ? (
    m == 0 ? ( hi_uf = 540; hi_uom = 3; hi_uor = 1.48; hi_uol = 0.7; hi_uod = 0.25; hi_uvt = 2; hi_uvf = 800; hi_uvq = 1.5; ) :
    m == 1 ? ( hi_uf = 620; hi_uom = 1; hi_uor = 3.5; hi_uix = 2.5; hi_uit = 0.15; hi_uol = 1; hi_uod = 0.3; ) :
    m == 2 ? ( hi_ukl = 1; hi_uks = 2; hi_ukf = 800; hi_ukd = 0.2; hi_ukdm = 0.5; hi_ucl = 0.2; ) :
             ( hi_uf = 700; hi_uom = 2; hi_uix = 0.8; hi_uit = 0.08; hi_uol = 0.8; hi_uod = 0.15; hi_ucr = 1; hi_uvt = 2; hi_uvf = 1000; hi_uvq = 1; );
  ) : (
    m == 0 ? ( hi_uml = 1; hi_umd = 1.2; hi_unl = 0.3; hi_unt = 2; hi_unf = 9000; hi_und = 0.9; hi_uvt = 2; hi_uvf = 8000; hi_uvq = 0.7; ) :
    m == 1 ? ( hi_uf = 3100; hi_uom = 1; hi_uor = 2.4311; hi_uix = 12; hi_uit = 1.5; hi_uol = 0.6; hi_uod = 1.2;
               hi_unl = 0.45; hi_unt = 2; hi_unf = 7500; hi_und = 1; hi_uvt = 1; hi_uvf = 4000; ) :
    m == 2 ? ( hi_ukl = 0.6; hi_uks = 1; hi_ukf = 1150; hi_ukd = 1.6; hi_ukdm = 0.05; hi_unl = 0.5; hi_unt = 2; hi_unf = 7000; hi_und = 1.1; hi_ucl = 0.2; hi_uvt = 1; hi_uvf = 2500; ) :
             ( hi_unl = 0.7; hi_unt = 2; hi_unf = 7000; hi_und = 1.1; hi_uml = 0.6; hi_umd = 0.9; hi_ucr = 1; hi_uvt = 1; hi_uvf = 3500; );
  );
  hi_utr = HUTRIM[m * 10 + k];
);

HUTRIM[0] = 1.199; HUTRIM[1] = 1.541; HUTRIM[2] = 2.901; HUTRIM[3] = 7.366; HUTRIM[4] = 7.34; HUTRIM[5] = 1.072; HUTRIM[6] = 3.556; HUTRIM[7] = 3.545; HUTRIM[8] = 1.8; HUTRIM[9] = 2.4;
HUTRIM[10] = 1.023; HUTRIM[11] = 1.274; HUTRIM[12] = 2.786; HUTRIM[13] = 0.766; HUTRIM[14] = 0.782; HUTRIM[15] = 1.012; HUTRIM[16] = 0.902; HUTRIM[17] = 0.779; HUTRIM[18] = 1.8; HUTRIM[19] = 2.4;
HUTRIM[20] = 0.104; HUTRIM[21] = 0.241; HUTRIM[22] = 0.953; HUTRIM[23] = 1.473; HUTRIM[24] = 1.466; HUTRIM[25] = 0.234; HUTRIM[26] = 5.821; HUTRIM[27] = 1.442; HUTRIM[28] = 1.8; HUTRIM[29] = 2.4;
HUTRIM[30] = 1.149; HUTRIM[31] = 1.367; HUTRIM[32] = 2.918; HUTRIM[33] = 0.872; HUTRIM[34] = 0.878; HUTRIM[35] = 1.095; HUTRIM[36] = 1.565; HUTRIM[37] = 1.033; HUTRIM[38] = 1.8; HUTRIM[39] = 2.4;

hi_t8(HULV, 0, 85, 75, 70, 60, 55, 70, 60, 50); HULV[8] = 60; HULV[9] = 55;
hi_t8(HUPN, 0, 0, 0, -10, 25, 25, -20, -35, 35); HUPN[8] = 25; HUPN[9] = -25;

hi_t8(HUSPT, 0, 0.31, -0.62, 0.18, 0.47, -0.36, -0.85, 0.66, -0.29);
hi_t8(HUSPD, 0, -0.4, 0.7, 0.2, -0.6, 0.5, 0.3, -0.8, 0.45);
HUMDT[0] = 0.0021; HUMDT[1] = -0.0034; HUMDT[2] = 0.0015; HUMDT[3] = -0.0011; HUMDT[4] = 0.0029; HUMDT[5] = -0.0024;

function hi_usqb(p, d, ni) local(t) (
  p < 0.5 ? (
    p < d ? ( t = p * ni; t + t - t * t; ) : p > 0.5 - d ? ( t = (p - 0.5) * ni; 1 - t * t - t - t - 1; ) : 1;
  ) : (
    p < 0.5 + d ? ( t = (p - 0.5) * ni; t * t - t - t; ) : p > 1 - d ? ( t = (p - 1) * ni; t * t + t + t; ) : -1;
  );
);

function hi_umc_set(tm, a) instance(d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  d1 = 205.3 * tm * (1 + a * HUMDT[0]) / srate; d2 = 304.4 * tm * (1 + a * HUMDT[1]) / srate; d3 = 369.6 * tm * (1 + a * HUMDT[2]) / srate;
  d4 = 522.7 * tm * (1 + a * HUMDT[3]) / srate; d5 = 540 * tm * (1 + a * HUMDT[4]) / srate;   d6 = 800 * tm * (1 + a * HUMDT[5]) / srate;
  n1 = 1 / d1; n2 = 1 / d2; n3 = 1 / d3; n4 = 1 / d4; n5 = 1 / d5; n6 = 1 / d6;
);
function hi_umc_run() instance(p1, p2, p3, p4, p5, p6, d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  p1 += d1; p1 >= 1 ? p1 -= 1; p2 += d2; p2 >= 1 ? p2 -= 1; p3 += d3; p3 >= 1 ? p3 -= 1;
  p4 += d4; p4 >= 1 ? p4 -= 1; p5 += d5; p5 >= 1 ? p5 -= 1; p6 += d6; p6 >= 1 ? p6 -= 1;
  (hi_usqb(p1, d1, n1) + hi_usqb(p2, d2, n2) + hi_usqb(p3, d3, n3) + hi_usqb(p4, d4, n4) + hi_usqb(p5, d5, n5) + hi_usqb(p6, d6, n6)) * 0.16666667;
);

function hi_uasoft(x) instance(x1) local(y) (
  abs(x) <= 1.5 && abs(x1) <= 1.5 ? y = (x + x1) * (0.5 - (x * x + x1 * x1) * 0.037037037) :
  abs(x - x1) > 0.00001 ? y = (this.clp_ad(x) - this.clp_ad(x1)) / (x - x1) : y = this.clp_crv(0.5 * (x + x1));
  x1 = x;
  y;
);

function hi_uatrig(k, vel, tm, dm, tn, sn, lv) instance(qk, qhk, qhx, qhy, qa, qu1, qv1, qu2, qv2, qr1, qr2, qw1, qw2, qe1, qe2, qf2, qm2,
                                              qpn, qpa, qps, qpc, qpg, qsw, qsd, qsc, qscc, qch, qcy, qhc, qcl, qtl, qtc,
                                              qdg, qdt, qne, qnc, qnl, qnt, qnf, qme, qmc, qme2, qmc2, qhp, qb1, qb2, qmcl,
                                              qbt, qb2t, qb3t, qb4t, qbe, qba, qbc, qbv, qtt, qte, qta, qog, qogt, qdr, qkc, qcf, qcc)
                                     local(a, ak, tf, df, am, f1, f2, pd, pt, d1, d2, cl, nl, nf, nq, nd, w, t) (
  a = dm_a; ak = hi_uacc;
  tf = tm * (1 + a * (0.006 * HUSPT[k] - 0.005 * hi_uwrm + 0.002 * qdr.v + 0.0007 * (rand(2) - 1)));
  df = dm * (1 + a * (0.05 * HUSPD[k] + 0.02 * (rand(2) - 1))) * (1 + 0.04 * ak);
  am = vel * (1 + a * 0.02 * (rand(2) - 1));
  qk = k;
  k == 3 || k == 4 ? (
    qme = max(qme, am * (1 + 0.05 * ak)); qmc = hi_udc((k == 3 ? 0.045 : 0.36) * df);
    qhk = tan($pi * min(7000 * 2 ^ (tn - 0.5) * tm, 0.45 * srate) / srate); qhk /= 1 + qhk;
  ) : k == 7 ? (
    qmcl.hi_umc_set(tf, a);
    qme = max(qme, am * (1 + 0.05 * ak)); qmc = hi_udc(1.2 * df);
    qme2 = max(qme2, am); qmc2 = hi_udc(0.35 * df);
    qb1.hi_uf_set(3400 * tf, 1.2); qb2.hi_uf_set(7500 * tf, 1);
    qhk = tan($pi * min(2000 * 2 ^ ((tn - 0.5) * 2) * tm, 0.45 * srate) / srate); qhk /= 1 + qhk;
  ) : k == 2 ? (
    t = 0.0004 * a * srate;
    qbt = 0; qb2t = floor(0.0105 * srate + t * (rand(2) - 1)); qb3t = floor(0.0212 * srate + t * (rand(2) - 1));
    qb4t = floor(0.0315 * srate + t * (rand(2) - 1));
    qba = am * (1 + 0.03 * ak); qbe = qba; qbc = hi_udc(0.0065 / (1 + 0.3 * ak));
    qbv = am * 0.9; qnc = hi_udc(0.18 * df); qta = 1 - exp(-1 / (0.004 * srate));
    qb1.hi_uf_set(1100 * 2 ^ ((tn - 0.5) * 1.5) * tm, 1.4);
  ) : (
    nl = 0; nf = 1000; nq = 0.7; nd = 0.1; f2 = 0; d2 = 0.1; qm2 = 0; qnt = 1; qdg = 1; t = 1;
    k == 0 ? ( f1 = 52;  pd = 3;   pt = 0.035; d1 = 0.45; cl = 0.35; qdg = 0.7; ) :
    k == 5 ? ( f1 = 120; pd = 0.6; pt = 0.08;  d1 = 0.35; cl = 0.15; qdg = 0.7; nl = 0.1; qnt = 0; nf = 2000; nd = 0.05; ) :
    k == 1 ? ( f1 = 185; f2 = 329.3; qm2 = 0.67 * (0.4 + 1.2 * tn); pd = 0.3; pt = 0.02; d1 = 0.12; d2 = 0.1; cl = 0.2;
               qdg = 0.5; t = 0.36; nl = 0.8; nf = 5000; nq = 0.6; nd = 0.2; ) :
             ( f1 = 540; f2 = 800; qm2 = 1; pd = 0; pt = 0.01; d1 = 0.25; d2 = 0.2; cl = 0; qdg = 1.6; t = 0.35;
               qhp.hi_uf_set(800 * 2 ^ (tn - 0.5) * tm, 1.5); );
    pd *= (0.3 + 1.4 * sn) * (1 + 0.4 * ak); cl *= 2 * sn * (1 + (k == 0 ? 0.5 : 1) * ak);
    w = $pi / srate;
    qw1 = min(f1 * tf * w, 1.2); qe1 = 2 * sin(qw1); qr1 = hi_udc(d1 * df);
    qf2 = f2 > 0; qw2 = min(f2 * tf * w, 1.2); qe2 = 2 * sin(qw2); qr2 = hi_udc(d2 * df);
    qsd = pd; qsc = hi_udc(pt * dm * (1 + 0.3 * ak)); qscc = 1 - exp(-1 / (0.0002 * srate));
    qpn = max(floor(0.001 * srate), 1); qpg = 1 / qpn; qpa = am * (1 + 0.03 * ak); qpc = 1 - exp(-1 / (0.0001 * srate));
    qhc = exp(-2 * $pi * 1000 / srate); qcl = cl * 3;
    qcc = k == 0 ? 1 - exp(-2 * $pi * 2000 / srate) : 1;
    qtc = 1 - exp(-2 * $pi * min(700 * 30 ^ tn, 0.45 * srate) / srate);
    qdt = t / qdg;
    nl > 0 ? ( qne = max(qne, am); qnl = nl; qnc = hi_udc(nd * df); qnf.hi_uf_set(nf * 2 ^ ((tn - 0.5) * 1.5) * tm, nq); );
  );
  qogt = lv * HUTRIM[k];
  qa == 0 ? qog = qogt;
  qa = 1;
);

function hi_uarun() instance(qk, qhk, qhx, qhy, qa, qu1, qv1, qu2, qv2, qr1, qr2, qw1, qw2, qe1, qe2, qf2, qm2,
                             qpn, qpa, qps, qpc, qpg, qsw, qsd, qsc, qscc, qch, qcy, qhc, qcl, qtl, qtc,
                             qdg, qdt, qne, qnc, qnl, qnt, qnf, qme, qmc, qme2, qmc2, qhp, qb1, qb2, qmcl,
                             qbt, qb2t, qb3t, qb4t, qbe, qba, qbc, qbv, qtt, qte, qta, qog, qogt, qkc, qcf, qcc)
                    local(y, x, e1, e2, t) (
  qk == 3 || qk == 4 ? (
    x = hi_uhm * qme; y = (x - qhx) * qhk; qhy = y + qhx; qhx = qhy + y; y = x - qhy; qme *= qmc;
    qme < 0.00001 ? ( qa = 0; qme = qhx = qhy = 0; );
  ) : qk == 7 ? (
    x = qmcl.hi_umc_run();
    x = qb2.hi_uf_run(x) * qme + qb1.hi_uf_run(x) * qme2; y = (x - qhx) * qhk; qhy = y + qhx; qhx = qhy + y; y = x - qhy; qme *= qmc; qme2 *= qmc2;
    qme < 0.00001 && qme2 < 0.00001 ? ( qa = 0; qme = qme2 = qhx = qhy = 0; qb1.hi_uf_clear(); qb2.hi_uf_clear(); );
  ) : qk == 2 ? (
    qbt += 1; qbt == qb2t || qbt == qb3t ? qbe = qba : qbt == qb4t ? ( qbe = qba; qtt = max(qtt, qbv); );
    qte += (qtt - qte) * qta; qtt *= qnc;
    y = qb1.hi_uf_run((rand(2) - 1) * (qbe + qte)); qbe *= qbc;
    qbt > qb4t && qte < 0.00001 && qtt < 0.00001 && qbe < 0.00001 ? ( qa = 0; qte = qtt = qbe = 0; qb1.hi_uf_clear(); );
  ) : (

    qpn > 0 ? ( qpn -= 1; t = qpa; qsw += (1 - qsw) * qscc; ) : ( t = 0; qsw *= qsc; );
    qps += (t - qps) * qpc;
    qsw > 0.00001 ? (
      x = qw1 * (1 + qsd * qsw); x > 1.2 ? x = 1.2; e1 = x * (2 - x * x * (0.33333333 - x * x * 0.016666667));
      qf2 ? ( x = qw2 * (1 + qsd * qsw); x > 1.2 ? x = 1.2; e2 = x * (2 - x * x * (0.33333333 - x * x * 0.016666667)); );
    ) : ( qsw = 0; e1 = qe1; e2 = qe2; );

    x = qps * qpg;
    qu1 = qr1 * (qu1 - e1 * qv1) + x; qv1 = qr1 * (qv1 + e1 * qu1); t = qv1;
    qf2 ? ( qu2 = qr2 * (qu2 - e2 * qv2) + x; qv2 = qr2 * (qv2 + e2 * qu2); t += qm2 * qv2; );

    y = qkc.hi_uasoft(t * qdg) * qdt;
    qcy = qhc * (qcy + qps - qch); qch = qps; qcf += (qcy - qcf) * qcc; y += qcf * qcl;
    qk == 6 ? y = qhp.hi_uf_run(y) : ( qtl += (y - qtl) * qtc; y = qtl; );
    qne > 0.00001 ? ( qnf.hi_uf_run((rand(2) - 1) * qne); y += qnf.hi_uf_out(qnt) * qnl; qne *= qnc; ) : qne = 0;
    qpn == 0 && qne == 0 && abs(qu1) + abs(qv1) + abs(qu2) + abs(qv2) + abs(qps) + abs(qtl) < 0.000001 ? (
      qa = 0; qu1 = qv1 = qu2 = qv2 = qps = qsw = qch = qcy = qcf = qtl = 0; qkc.x1 = 0; qhp.hi_uf_clear();
    );
  );
  qog += (qogt - qog) * hi_ugl;
  y * qog;
);

function hi_uachoke() instance(qmc) ( qmc = min(qmc, hi_uchk); );

function hi_uempty() instance(qa, act, qu1, qv1, qu2, qv2, qps, qsw, qch, qcy, qcf, clp, qtl, qne, qme, qme2, qhx, qhy, qbe, qte, qtt, qpn, qkc, fdk) (
  qa = act = 0; qu1 = qv1 = qu2 = qv2 = qps = qsw = qch = qcy = qcf = clp = qtl = qne = qme = qme2 = qhx = qhy = qbe = qte = qtt = qpn = 0; qkc.x1 = 0; fdk = 0;
);

function hi_ugo(k, vel, tst, dm, lvl, g, pan, kb) instance(f0, pd, pe, pec, om, orr, ix, ie, iec, ol, oe, oec, pc, pm,
                               nl, ne, nec, nb, nbt, nbv, nbc, nbi, ml, me, mec, mt,
                               kl, kset, kmx, kmc, kw, kenv, xe, xec, xlc, xlp, xt, xn,
                               cl, ce, cec, vt, cr, crh, crc, crn, crq, amp, gl, gr, act, kbs, nfl, pfl, nt,
                               mp1, mp2, mp3, mp4, mp5, mp6, fd, fdk, of, ofn, clp, clc)
                     local(tm, tn, sn, i, f, t, r, md) (
  md = hi_umodel;
  tm = 2 ^ (tst / 12); tn = 0.5; sn = 0.5;
  t = (pan / 100 + 1) * $pi * 0.25; gl = cos(t) * 1.4142; gr = sin(t) * 1.4142;
  fdk = 0; fd = 1;
  md == 0 && k < 8 ? this.hi_uatrig(k, vel, tm, dm, tn, sn, lvl * lvl * g) : (
  hi_urecipe(md, k);
  md == 1 ? hi_uix *= 0.25 + 1.5 * tn : md == 3 ? hi_uix = min(hi_uix * (0.4 + 1.2 * tn), 0.97) : 0;
  hi_unf *= 2 ^ ((tn - 0.5) * 1.5); hi_uvf *= 2 ^ ((tn - 0.5) * (md == 0 ? 1 : 0.5));
  hi_upd *= 0.3 + 1.4 * sn; hi_ucl *= 2 * sn;
  f0 = hi_uf * tm; pd = hi_upd; pe = 1; pec = hi_udc(hi_upt * dm);
  om = hi_uom; orr = hi_uor; ix = hi_uix * (md == 1 ? 1 + sn : 1); ie = 1; iec = hi_udc(hi_uit * dm);
  ol = hi_uol; oe = hi_uol > 0; oec = hi_udc(hi_uod * dm); pc = 0; pm = 0;
  nl = hi_unl; ne = hi_unl > 0 || hi_ukw > 0; nec = hi_udc(hi_und * dm); nb = hi_unb; nbt = 0; nbv = 1; nbc = hi_udc(0.006); nbi = floor(0.011 * srate);
  nt = hi_unt; nfl.hi_uf_set(hi_unf * tm, hi_unq); nfl.hi_uf_clear();
  ml = hi_uml; me = hi_uml > 0; mec = hi_udc(hi_umd * dm); mt = tm;
  mp1 = 0; mp2 = 0.17; mp3 = 0.41; mp4 = 0.63; mp5 = 0.29; mp6 = 0.83;
  cl = hi_ucl; ce = hi_ucl > 0; cec = hi_udc(0.004);
  clc = k == 0 ? 1 - exp(-2 * $pi * 2500 / srate) : 1; clp = 0;
  of = 0; ofn = k == 0 && hi_uom == 2 ? max(floor(0.0005 * srate), 1) : 0;
  vt = hi_uvt; pfl.hi_uf_set(hi_uvf * tm, hi_uvq);
  cr = hi_ucr; crc = 0; crn = max(1, floor(srate / (11000 + 29000 * tn))); crq = 128;
  kl = hi_ukl; kset = hi_uks; kw = hi_ukw; kenv = 0;
  kbs = kb; kmx = 0;
  hi_ukl > 0 ? (
    i = 0;
    loop(6,
      f = hi_ukf * tm * HUMR[kset * 6 + i];
      t = hi_ukd * dm / (1 + hi_ukdm * (1.6 - tn) * (HUMR[kset * 6 + i] - 1));
      r = f < srate * 0.45 ? exp(-6.9 / (max(t, 0.002) * srate)) : 0;
      kbs[i] = 2 * r * cos(2 * $pi * min(f, srate * 0.45) / srate); kbs[6 + i] = r * r;
      kbs[12 + i] = r > 0 ? HUMA[kset * 6 + i] * (1 - r * r) * 6 : 0;
      kbs[18 + i] = 0; kbs[24 + i] = 0;
      kmx = max(kmx, r);
      i += 1;
    );
