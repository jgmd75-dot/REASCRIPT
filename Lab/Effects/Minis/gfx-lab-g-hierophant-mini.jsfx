function hi_push(t, l, v) ( hi_qn < 190 ? ( EQT[hi_qn] = t; EQL[hi_qn] = l; EQV[hi_qn] = v; hi_qn += 1; t < hi_qmin ? hi_qmin = t; ); );

function hi_non(l, v, vr) local(n, c, vv) (
  n = LNT[l]; c = hi_moch;

  l == 4 && vr == 1 ? n = 37 : l == 6 && vr == 1 ? n = 47 : l == 7 && vr >= 2 ? n = vr == 2 ? 51 : vr == 3 ? 56 : 54;
