hi_nent = 263; hi_nsty = 24; hi_ntl = 36;
function hi_b64(c) ( c >= 65 && c <= 90 ? c - 65 : c >= 97 && c <= 122 ? c - 71 : c >= 48 && c <= 57 ? c + 4 : c == 43 ? 62 : 63; );
function hi_libparse() local(n, i, c, b, v, o) (
  n = strlen(#hi_lib); i = 0; b = -1;
  while (i < n) (
    c = str_getchar(#hi_lib, i);
    c == 46 ? ( b += 1; memset(HLB + b * 26, 0, 26); i += 1; ) : (
      v = hi_b64(str_getchar(#hi_lib, i + 1)) + 64 * hi_b64(str_getchar(#hi_lib, i + 2)) + 4096 * hi_b64(str_getchar(#hi_lib, i + 3));
      o = HLB + b * 26;
      c == 109 ? o[24] = v : c >= 97 ? o[c - 97] = v : o[12 + c - 65] = v;
      i += 4;
    );
  );
  hi_nums(#hi_libmc, HTMPB); i = 0; loop(b + 1, HLB[i * 26 + 25] = HTMPB[i]; i += 1; );
  hi_nums(#hi_ent, HENT);
  hi_nums(#hi_tl, HTLD);

  n = hi_nums(#hi_brk, HTMPB); i = 0; c = 0;
  loop(hi_nsty, HBRO[c] = i + 1; HBRN[c] = HTMPB[i]; i += HTMPB[i] + 1; c += 1; );
  memcpy(HBRL, HTMPB, n);
  hi_libok = 1;
);

function hi_bit(m, i) ( floor(m / 2 ^ i) & 1; );

function hi_entry() local(p) (
  p = floor(PVM[143] + 0.5); hi_pat = p >= 1 && p <= hi_nent ? p : 0;
  hi_pe = HENT + (hi_pat - 1) * 7;
  hi_pkind = hi_pat ? hi_pe[0] : -1;
  hi_pmode = hi_pat && hi_pkind < 2;
);

function hi_pput(B, l, s, v, fl, vr) local(o) (
  o = l * 48 + s;
  v > B[o] ? ( B[o] = v; B[o + 400] = 0; B[o + 800] = 1; B[o + 1200] = fl * 16 + vr * 64; );
);

function hi_pbar(B, bi, s0, cy, fl2) local(o, mc, ns, f, t, i, s, m, fmk, l, vr, vn, a, v) (
  o = HLB + bi * 26; mc = o[25]; ns = mc == 0 ? 16 : 12; f = mc == 2 ? 2 : 1;
  vn = hi_eng == 0 ? 0.7 : hi_eng == 1 ? 0.72 : 0.78;
  t = 0;
  loop(12,
    m = o[t];
    m > 0 ? (
      fmk = o[12 + t];
      l = t == 0 ? 0 : t == 1 ? 1 : t == 2 ? 2 : t == 3 ? 3 : t == 4 ? 7 : t == 5 ? 6 : t == 6 ? 6 : t == 7 ? 5 : t <= 9 ? 4 : 7;
      vr = t == 1 ? 1 : t == 4 ? cy : t == 6 ? 1 : t == 8 ? 1 : t == 9 ? 2 : t == 10 ? 3 : t == 11 ? 4 : 0;
      i = 0;
      loop(ns,
        s = i * f;
        s >= s0 && s < hi_N && hi_bit(m, i) ? (
          a = hi_bit(o[24], i); v = a ? 1 : vn;
          hi_pput(B, l, s, max(1 - (1 - v) * hi_acc, 0.06), hi_bit(fmk, i), vr);
          fl2 ? B[1200 + l * 48 + s] |= 2;
        );
        i += 1;
      );
    );
    t += 1;
  );
);

function hi_pgen(bar, B) local(e, N, var, l, s, o, d, r, q, v, keep, rs, g, nb, bi, fl, fs, n, k, i, c, mc, bb)
(
  e = hi_eng; N = hi_N; var = hi_lock ? 0 : hi_var;
  memset(B, 0, 1600);
  nb = max(hi_pe[4], 1); bi = hi_pe[3] + (bar % nb); mc = HLB[bi * 26 + 25];
  hi_pbar(B, bi, 0, hi_pe[6], 0);
  l = 0;
  loop(8,
    d = (hi_gd + LD[l] - 100) / 50;
    d != 0 || var > 0 ? (
      s = 0;
      loop(N,
        o = l * 48 + s;
        r = hi_h(l + 70, s, var > 0 ? 1000 + bar : 0);
        B[o] > 0 ? (
          keep = (l == 0 && s == 0) || (l == 1 && MBB[s]) || B[o] >= 0.99;
          !keep && r < max(-d, 0) * 0.9 + var * 0.12 ? B[o] = 0;
        ) : (
          q = hi_q(l, s);
          r < (max(d, 0) * 0.45 + var * 0.06) * q ? (
            v = l == 1 || l == 2 ? 0.25 + 0.15 * hi_h(l + 90, s, bar) : 0.62;
            B[o] = max(1 - (1 - v) * hi_acc, 0.06); B[o + 800] = 1; B[o + 1200] = v < 0.4;
          );
        );
        s += 1;
      );
    );

    hi_spar > 0 ? (
      g = 0;
      loop(hi_G,
        rs = hi_h(l + 20, g, var > 0 ? 1000 + bar : 0);
        rs < hi_spar * 0.8 ? ( s = MGS[g]; loop(MGZ[g], !((l == 0 && s == 0) || (l == 1 && MBB[s])) ? B[l * 48 + s] = 0; s += 1; ); );
        g += 1;
      );
    );

    hi_grv > 0 && e > 0 ? (
      s = 0;
      loop(N,
        o = l * 48 + s;
        B[o] > 0 ? B[o + 400] = e == 1 ? (LND[l] + (hi_h(l + 60, s, var > 0 ? 1000 + bar : 0) - 0.5) * 0.07) * hi_grv : LNP[l] * hi_grv;
        s += 1;
      );
    );
    l += 1;
  );

  fl = hi_isfill(bar);
  fl ? (
    fs = hi_fstart(); c = hi_pe[1]; n = 0; k = -1;
    c < hi_nsty ? ( i = 0; loop(HBRN[c], HLB[HBRL[HBRO[c] + i] * 26 + 25] == mc ? n += 1; i += 1; ); );
    n > 0 ? (
      r = floor(hi_h(97, bar, 3) * n); i = 0;
      loop(HBRN[c], HLB[HBRL[HBRO[c] + i] * 26 + 25] == mc ? ( r == 0 ? k = HBRL[HBRO[c] + i]; r -= 1; ); i += 1; );
      l = 0; loop(8, s = fs; loop(N - fs, B[l * 48 + s] = 0; s += 1; ); l += 1; );
      hi_pbar(B, k, fs, 1, 1);
    ) : hi_fill(B, fs, bar);
  );
  hi_isfill(bar - 1) && hi_fint >= 0.15 ? hi_set(B, 7, 0, 0.8 + 0.2 * hi_fint, 0, 1, 8);
);

function hi_gen(bar, B) local(e, N, var, l, s, t, q, r, r0, x, d, K, c, eu, rot, g, rs, o, v, tm, J, fl, fs, ln)
(

  hi_pmode ? hi_pgen(bar, B) : (
  e = hi_eng; N = hi_N; var = hi_lock ? 0 : hi_var;
  memset(B, 0, 1600);
  J = e == 0 ? 0.12 : e == 1 ? 0.45 : 0.08;
  l = 0;
  loop(8,

    x = min(max(hi_gd + LD[l] - 50, 0), 100); d = DB[e * 8 + l];
    l == 1 ? d += hi_nbb / N : l == 4 && e != 1 ? d += (e == 2 ? 1 : 0.5) * hi_nbb / N;
    d = x <= 50 ? d * x / 50 : d + (1 - d) * (x - 50) / 50;
    K = floor(d * N + 0.5);
    var > 0 && K > 0 ? K = min(max(K + floor((hi_h(l, 50, 1000 + bar) - 0.5) * 2.5 * var + 0.5), 0), N);
    eu = e == 2 && (l == 2 || l == 7);
    s = 0;
    loop(N,
      r0 = hi_h(l, s, 0); r = var > 0 ? r0 + (hi_h(l, s, 1000 + bar) - r0) * var : r0;
      q = hi_q(l, s); SQ[s] = q; HSC[s] = q + J * (r - 0.5) + 0.0001 * r;
      s += 1;
    );
    eu ? (

      rot = l == 2 ? (hi_syn > 0.33) : 2 + floor(hi_h(l, 0, 7) * N);
      var > 0 ? rot += floor(var * 2 * hi_h(l, 1, 2000 + bar));
      s = 0; loop(N, t = (s + rot) * K; K > 0 && t - floor(t / N) * N < K ? B[l * 48 + s] = 1; s += 1; );
    ) : (
      s = 0;
      loop(N, c = 0; t = 0; loop(N, HSC[t] > HSC[s] ? c += 1; t += 1; ); c < K ? B[l * 48 + s] = 1; s += 1; );
    );

    hi_spar > 0 ? (
      g = 0;
      loop(hi_G,
        r0 = hi_h(l + 20, g, 0); rs = var > 0 ? r0 + (hi_h(l + 20, g, 1000 + bar) - r0) * var : r0;
        rs < hi_spar * 0.8 ? ( s = MGS[g]; loop(MGZ[g], !((l == 0 && s == 0) || (l == 1 && MBB[s])) ? B[l * 48 + s] = 0; s += 1; ); );
        g += 1;
      );
    );

    s = 0;
    loop(N,
      o = l * 48 + s;
      B[o] > 0 ? (
        r = hi_h(l + 40, s, var > 0 ? 1000 + bar : 0);
        v = hi_vel(l, s, r);
        tm = e == 1 ? (LND[l] + (hi_h(l + 60, s, var > 0 ? 1000 + bar : 0) - 0.5) * 0.07 + (v < 0.4 ? 0.025 : 0)) * hi_grv :
             e == 2 ? LNP[l] * hi_grv : 0;
        B[o] = v; B[o + 400] = tm; B[o + 800] = 1; B[o + 1200] = v < 0.4;
      );
      s += 1;
    );
    l += 1;
  );

  s = 0; loop(N, B[96 + s] > 0 && !EDF[96 + s] ? B[144 + s] > 0 ? B[96 + s] = 0; s += 1; );

  fl = hi_isfill(bar);
  fl ? ( fs = hi_fstart(); hi_fill(B, fs, bar); );
  hi_isfill(bar - 1) && hi_fint >= 0.15 ? hi_set(B, 7, 0, 0.8 + 0.2 * hi_fint, 0, 1, 8);
  );

  l = 0;
  loop(8,
    s = 0;
    loop(N,
      o = l * 48 + s;
      EDF[o] ? (
        EDV[o] ? ( B[o] <= 0 ? hi_set(B, l, s, hi_vel(l, s, 0.5), 0, 1, 4) : B[o + 1200] |= 4; ) : hi_set(B, l, s, 0, 0, 1, 4);
      );
      s += 1;
    );
    l += 1;
  );
  hi_gbar = bar;
);

HPRS = 40000;
function hi_poe(t, tau) ( exp(-t / tau); );

function hi_pbset(f, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(f, HPRS * 0.45) / HPRS); k = 1 / q; a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function hi_pbrun(x) instance(a1, a2, a3, k, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; lp = v2; bp = v1; hp = x - k * v1 - v2;
  bp;
);
function hi_pbreset() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function hi_tanh(x) ( x = min(max(x, -12), 12); x = exp(2 * x); (x - 1) / (x + 1); );

function hi_plcg() ( hi_pseed = (hi_pseed * 16807) % 2147483647; hi_pseed / 2147483647; );

function hi_psnare(b, n, f, tt, nt, nlo, nhi, tone, gate) local(i, t, y, nz, a, an) (
  hpN1.hi_pbset(nhi, 0.7); hpN2.hi_pbset(nlo, 0.7); hpN1.hi_pbreset(); hpN2.hi_pbreset(); i = 0;
  loop(n,
    t = i / HPRS;
    nz = rand(2) - 1; hpN1.hi_pbrun(nz); hpN2.hi_pbrun(hpN1.lp); nz = hpN2.hp;
    an = gate > 0 ? (t < 0.004 ? 1.4 : t < gate ? 0.75 - 0.25 * t / gate : max(0, 0.5 - (t - gate) * 40)) : hi_poe(t, nt);
    a = hi_poe(t, tt);
    y = (sin(2 * $pi * f * t * (1 + 0.25 * hi_poe(t, 0.01))) * 0.7 + sin(2 * $pi * f * 1.84 * t) * 0.35) * a * tone + nz * an;
    b[i] = y; i += 1;
  );
);

function hi_proom(b, n, amt) local(i, d, g, k, lp) (
  memset(HPSCR, 0, n);
  k = 0;
  loop(7,
    d = floor(HPRS * 0.001 * (k == 0 ? 6.3 : k == 1 ? 9.7 : k == 2 ? 13.1 : k == 3 ? 17.9 : k == 4 ? 23.5 : k == 5 ? 29.4 : 37.0));
    g = (k == 0 ? 0.42 : k == 1 ? -0.33 : k == 2 ? 0.28 : k == 3 ? -0.22 : k == 4 ? 0.17 : k == 5 ? -0.12 : 0.08);
    i = d; loop(n - d, HPSCR[i] += b[i - d] * g; i += 1; );
    k += 1;
  );
  lp = 0; i = 0;
  loop(n, lp += (HPSCR[i] - lp) * 0.35; b[i] += lp * amt; i += 1; );
);

function hi_pmcym(b, n, np, flo, fhi, tlo, thi, nzamt, nzf, att, click, sd) local(k, f, a, tau, r, w, c1, c2, y0, y1, y2, i, m, u, t, e) (
  memset(b, 0, n); hi_pseed = sd;
  k = 0;
  loop(np,
    u = hi_plcg(); f = flo * (fhi / flo) ^ u;
    f < HPRS * 0.45 ? (
      a = (0.4 + 0.6 * hi_plcg()) * (0.5 + 0.5 * u);
      tau = tlo * (thi / tlo) ^ u * (0.6 + 0.8 * hi_plcg());
      r = exp(-1 / (tau * HPRS)); w = 2 * $pi * f / HPRS;
      c1 = 2 * r * cos(w); c2 = -r * r;
      y1 = 0; y2 = -a * sin(w) / r;
      m = min(n, floor(tau * 7 * HPRS)); i = 0;
      loop(m, y0 = c1 * y1 + c2 * y2; b[i] += y1; y2 = y1; y1 = y0; i += 1; );
    );
    k += 1;
  );
  hpF.hi_pbset(nzf, 0.8); hpF.hi_pbreset(); i = 0;
  loop(n,
    t = i / HPRS; u = hi_plcg() * 2 - 1;
    hpF.hi_pbrun(u);
    e = att > 0 ? 1 - exp(-t / att) : 1;
    b[i] = (b[i] / sqrt(np) * 1.6 + (hpF.bp + 0.6 * hpF.hp) * nzamt * exp(-t / (tlo * 0.5 + thi * 0.5))) * e
           + (hi_plcg() * 2 - 1) * click * exp(-t / 0.0012);
    i += 1;
  );
);

function hi_pthin(b, n, fc) local(i) (
  hpF.hi_pbset(fc, 0.707); hpF.hi_pbreset(); i = 0; loop(n, hpF.hi_pbrun(b[i]); b[i] = hpF.hp; i += 1; );
);

function hi_ptom2(b, n, f, ta, rm) local(i, t, g, p0, p1, p2, p3, p4, p5, y) (
  p0 = p1 = p2 = p3 = p4 = p5 = 0; hpF.hi_pbset(3800, 1.2); hpF.hi_pbreset(); hi_pseed = floor(f * 13); i = 0;
  loop(n,
    t = i / HPRS; g = 1 + 0.07 * exp(-t / 0.07);
    p0 += f * g / HPRS; p1 += f * 1.594 * g / HPRS; p2 += f * 2.136 * g / HPRS; p3 += f * 2.296 * g / HPRS; p4 += f * 2.653 * g / HPRS; p5 += f * 2.918 * g / HPRS;
    y = sin(2 * $pi * p0) * exp(-t / ta) + 0.5 * sin(2 * $pi * p1) * exp(-t / (ta * 0.55)) + 0.32 * sin(2 * $pi * p2) * exp(-t / (ta * 0.4))
      + 0.22 * sin(2 * $pi * p3) * exp(-t / (ta * 0.35)) + 0.15 * sin(2 * $pi * p4) * exp(-t / (ta * 0.3)) + 0.1 * sin(2 * $pi * p5) * exp(-t / (ta * 0.25));
    y += hpF.hi_pbrun(hi_plcg() * 2 - 1) * 0.9 * exp(-t / 0.004);
    b[i] = y; i += 1;
  );
  hi_proom(b, n, rm);
);

function hi_prevg(b, n, hold, mix) local(i, x, y, t, e, c0, c1, c2, c3, f0, f1, f2, f3, i0, i1, i2, i3, a0, a1, j0, j1, l0, l1, l2, l3, m0, m1, w) (
  memset(HPRVB, 0, 8192);
  l0 = 1116 * 0.8; l1 = 1188 * 0.8; l2 = 1277 * 0.8; l3 = 1356 * 0.8; m0 = 556; m1 = 441;
  c0 = HPRVB; c1 = HPRVB + 1200; c2 = HPRVB + 2400; c3 = HPRVB + 3600; a0 = HPRVB + 4800; a1 = HPRVB + 5600;
  f0 = f1 = f2 = f3 = 0; i0 = i1 = i2 = i3 = j0 = j1 = 0;
  i = 0;
  loop(n,
    t = i / HPRS; x = b[i] * 0.3;
    y = c0[i0]; f0 = y * 0.6 + f0 * 0.4; c0[i0] = x + f0 * 0.86; i0 += 1; i0 >= l0 ? i0 = 0; w = y;
    y = c1[i1]; f1 = y * 0.6 + f1 * 0.4; c1[i1] = x + f1 * 0.86; i1 += 1; i1 >= l1 ? i1 = 0; w += y;
    y = c2[i2]; f2 = y * 0.6 + f2 * 0.4; c2[i2] = x + f2 * 0.86; i2 += 1; i2 >= l2 ? i2 = 0; w += y;
    y = c3[i3]; f3 = y * 0.6 + f3 * 0.4; c3[i3] = x + f3 * 0.86; i3 += 1; i3 >= l3 ? i3 = 0; w += y;
    y = a0[j0]; a0[j0] = w + y * 0.5; w = y - w; j0 += 1; j0 >= m0 ? j0 = 0;
    y = a1[j1]; a1[j1] = w + y * 0.5; w = y - w; j1 += 1; j1 >= m1 ? j1 = 0;
    e = t < hold ? 1 : max(0, 1 - (t - hold) * 50);
    HPSCR[i] = w * e;
    i += 1;
  );
  i = 0; loop(n, b[i] += HPSCR[i] * mix; i += 1; );
);

function hi_pkick2(b, n, f0, drop, ta, drv, gated, gl) local(i, t, p0, p1, y, g) (
  p0 = p1 = 0; hpF.hi_pbset(2600, 0.7); hpF.hi_pbreset(); hi_pseed = 4711; i = 0;
  loop(n,
    t = i / HPRS;
    p0 += f0 * (1 + drop * exp(-t / 0.014)) / HPRS; p1 += f0 * 1.59 * (1 + drop * exp(-t / 0.01)) / HPRS;
    y = sin(2 * $pi * p0) * exp(-t / ta) + 0.25 * sin(2 * $pi * p1) * exp(-t / 0.035);
    hpF.hi_pbrun(hi_plcg() * 2 - 1); y += hpF.lp * 0.7 * exp(-t / 0.003);
    drv > 0 ? ( g = 1 + drv * 3; y = hi_tanh(y * g) / hi_tanh(g); );
    b[i] = y; i += 1;
  );
  hi_proom(b, n, 0.12);
  gated > 0 ? hi_prevg(b, n, gated, gl);
);

function hi_psnd(s, o) local(n, b, i, t, x, k, pk, y) (
  n = floor(HPRS * (s == 0 ? 0.5 : s == 5 ? 0.35 : s == 6 ? 0.15 : s == 7 ? 0.5 : s == 8 ? 0.6 : s == 9 ? 0.7 : s == 10 ? 0.8 : s == 12 ? 0.15 :
                     s == 13 ? 0.9 : s == 15 ? 2.5 : s == 16 ? 3.0 : s == 18 ? 0.25 : s == 19 ? 0.6 : 0.5));
  b = HPROM + o; HPOF[s] = o; HPLN[s] = n;
  s == 0 ? hi_pkick2(b, n, 56, 0.45, 0.16, 0.25, 0, 0) :
  s == 5 ? hi_psnare(b, n, 240, 0.03, 0.06, 2500, 11000, 0.6, 0) :
  s == 6 ? (
    i = 0; loop(n, t = i / HPRS;
      b[i] = sin(2 * $pi * 1700 * t) * 0.7 * hi_poe(t, 0.012) + sin(2 * $pi * 460 * t) * 0.5 * hi_poe(t, 0.01) + (rand(2) - 1) * 0.5 * hi_poe(t, 0.0008);
      i += 1; );
  ) :
  s == 18 ? (
    hpF.hi_pbset(7000, 0.8); hpF.hi_pbreset(); i = 0;
    loop(n, t = i / HPRS; hpF.hi_pbrun(rand(2) - 1); b[i] = hpF.hp * min(t / 0.012, 1) * hi_poe(t, 0.045); i += 1; );
  ) :
  s == 19 ? (
    i = 0;
    loop(n, t = i / HPRS;
      x = (rand(2) - 1) * (t < 0.003 ? 1 : (t >= 0.009 && t < 0.012) ? 0.7 : (t >= 0.02 && t < 0.023) ? 0.5 : 0);
      b[i] = x; i += 1; );
    hpJA.hi_pbset(5200, 30); hpJB.hi_pbset(7000, 30); hpJC.hi_pbset(8700, 30); hpJD.hi_pbset(11200, 25); hpJE.hi_pbset(9000, 1);
    hpJA.hi_pbreset(); hpJB.hi_pbreset(); hpJC.hi_pbreset(); hpJD.hi_pbreset(); hpJE.hi_pbreset(); i = 0;
    loop(n, t = i / HPRS; x = b[i];
      b[i] = (hpJA.hi_pbrun(x) + hpJB.hi_pbrun(x) * 0.8 + hpJC.hi_pbrun(x) * 0.7 + hpJD.hi_pbrun(x) * 0.5 + hpJE.hi_pbrun(x) * 0.3) * hi_poe(t, 0.25); i += 1; );
  ) :
  s == 7 ? (
    hpF.hi_pbset(1250, 1.4); hpF.hi_pbreset(); i = 0;
    loop(n, t = i / HPRS; x = rand(2) - 1; hpF.hi_pbrun(x);
      k = t < 0.009 ? hi_poe(t, 0.003) : t < 0.018 ? hi_poe(t - 0.009, 0.003) : t < 0.028 ? hi_poe(t - 0.018, 0.003) : hi_poe(t - 0.028, 0.12);
      b[i] = hpF.bp * k * 2; i += 1; );
  ) :
  s == 8 ? hi_ptom2(b, n, 210, 0.2, 0.25) : s == 9 ? hi_ptom2(b, n, 160, 0.26, 0.25) : s == 10 ? hi_ptom2(b, n, 120, 0.32, 0.25) :
  s == 12 ? ( hi_pmcym(b, n, 70, 3000, 16000, 0.12, 0.07, 1.1, 9000, 0, 0.5, 101);
              i = 0; loop(n, b[i] *= exp(-i / HPRS / 0.05); i += 1; ); ) :
  s == 13 ? hi_pmcym(b, n, 100, 2800, 16000, 0.9, 0.5, 1.0, 8500, 0, 0.4, 202) :
  s == 15 ? ( hi_pmcym(b, n, 110, 1800, 15000, 2.6, 1.6, 0.35, 8000, 0, 0.5, 404);
              i = 0; loop(n, t = i / HPRS;
                b[i] += 0.12 * (sin(2 * $pi * 2360 * t) + 0.6 * sin(2 * $pi * 3540 * t)) * exp(-t / 0.7);
                i += 1; );
              hi_pthin(b, n, 1200); ) :
  s == 16 ? ( hi_pmcym(b, n, 150, 2000, 16000, 1.8, 1.2, 1.1, 7500, 0.008, 0.3, 505);
              hi_pthin(b, n, 1500); ) :
  (
    hpF.hi_pbset(2600, 2.2); hpF.hi_pbreset(); i = 0;
    loop(n, t = i / HPRS; hpF.hi_pbrun((t * 562 - floor(t * 562) < 0.5 ? 1 : -1) + (t * 845 - floor(t * 845) < 0.5 ? 1 : -1));
      b[i] = hpF.bp * (0.6 * hi_poe(t, 0.01) + 0.4 * hi_poe(t, 0.12)); i += 1; );
  );
  pk = 0; i = 0; loop(n, pk = max(pk, abs(b[i])); i += 1; );
  pk > 0 ? ( i = 0; loop(n, y = b[i] * 0.9 / pk * min((n - i) / (n * 0.15), 1); b[i] = floor(y * 2047 + 0.5) / 2047; i += 1; ); );
  o + n + 16;
);

function hi_pdac() local(i, x, m, sg, s, q, y) (
  i = 0;
  loop(HPROMN,
    x = HPROM[i]; sg = x < 0 ? -1 : 1;
    m = floor(abs(x) * 8158 + 0.5) + 33; m = min(m, 8191);
