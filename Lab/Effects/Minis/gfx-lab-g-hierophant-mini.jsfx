    t = 2 ^ (tst / 12) * (1 + dm_a * (0.006 * HUSPT[k] - 0.005 * hi_uwrm + 0.002 * hudr.v));
    hum.hi_umc_set(t, dm_a); hub.hi_uf_set(7500 * t, 1.1);
  );
);

function hi_usetup() (
  hi_ugl = 1 - exp(-1 / (0.005 * srate));
  hi_uchk = hi_udc(0.02); hi_uacr = 1 - exp(-1 / (0.05 * srate));
  hum.hi_umc_set(1, 0); hub.hi_uf_set(7500, 1.1);
);
hum.p1 = 0; hum.p2 = 0.17; hum.p3 = 0.41; hum.p4 = 0.63; hum.p5 = 0.29; hum.p6 = 0.83;
hi_uacb = 1; hi_uacc = 0; hi_uwrm = 1; hi_uhm = 0;
