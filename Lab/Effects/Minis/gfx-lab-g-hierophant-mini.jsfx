slider33:75<0,100,1>-Open hat level (%)
slider34:75<0,100,1>-Clap-rim level (%)
slider35:75<0,100,1>-Low tom level (%)
slider36:75<0,100,1>-High tom level (%)
slider37:75<0,100,1>-Cymbal-perc level (%)
slider38:1<0,1,1{Off,On}>-Kit
slider39:1<0,1,1{Off,On}>-MIDI out
slider40:10<1,16,1>-MIDI out channel
slider41:0<0,16,1>-MIDI in channel (0 = omni)
slider42:0<0,100,1>-Drive (%)
slider43:50<0,100,1>-Fate (%)
slider44:-3<-24,6,0.1>-Volume (dB)
slider45:60<0,100,0.1>-Level (%)
slider46:1<0,1,1{Off,On}>-Transport (follows REAPER play state)
slider47:0<0,3,1{Analog,FM,Physical,Digital}>-Pulse character
slider48:0<0,1,1{12-bit linear,8-bit companded}>-PCM12 era (converter)
slider49:0<0,100,1>-Phaser (%)
slider50:0<0,227,1>-Pattern (0 = generated)
slider51:prs_sel=0<0,12,1{No preset,Init,Cloister Walk,Vespers in Seven,Compline Shuffle,Matins in Five,Rose Window,Plainchant Engine,Thurible Swing,Reliquary Waltz,Nave and Apse,Lauds at Dawn,Sanctus Machine}>-Preset

in_pin:none
out_pin:left output
out_pin:right output
