desc:Hierophant Mini [Arcana drums] (GFX Lab)
//tags: instrument drum machine drums sequencer generative pattern generator odd meter midi arcana mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-clip, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider52:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,1,1{Stop,Run}>-Run
slider2:0<0,2,1{PCM12,Deep,Pulse}>-Engine
slider3:1<0,13,1{3/4,4/4,6/4,6/8,12/8,5/4,5/8,7/4,7/8,9/4,9/8,15/8,Custom,4/4 in triplets}>-Meter
slider4:0<0,3,1>-Grouping (by meter)
slider5:0<0,1,1{Off,On}>-Follow project time signature
slider6:16<2,32,1>-Custom steps (sixteenths a bar)
slider7:4369<0,65535,1>-Custom group starts, steps 1-16 (bits)
slider8:0<0,65535,1>-Custom group starts, steps 17-32 (bits)
slider9:777<1,99999,1>-Seed
slider10:0<0,1,1{Off,On}>-Lock
slider11:50<0,100,1>-Density (%)
slider12:0<0,100,1>-Sparsity (%)
