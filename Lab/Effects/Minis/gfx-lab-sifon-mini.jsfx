  ui_cola(0x000000, 0.25); mg_r(x + 1, y + h - 2, w - 2, 1); mg_r(x + w - 2, y + 2, 1, h - 4);
  ui_col(ui_mix(mk_sub, 0x000000, 0.35)); mg_r(x + 8, y + 32, w - 16, 1);
