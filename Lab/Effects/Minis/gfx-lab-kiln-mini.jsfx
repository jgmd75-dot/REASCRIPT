desc:KILN Mini [saturator] (GFX Lab)
//tags: saturation distortion drive analogue mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-power, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:wheel=0<0,6,0.01>-Circuit wheel
slider2:heat=40<0,100,0.1>-Heat (%)
slider3:lean=0<-100,100,1>-Lean (%)
slider4:mrate=0.2<0.01,10,0.01>-Motion rate (Hz)
slider5:mdep=0<0,100,1>-Motion depth (%)
slider6:hlo=22<22,2200,1>-Harmonics low cut (Hz)
slider7:hhi=22000<2200,22000,1>-Harmonics high cut (Hz)
slider8:lis=0<0,1,1{Off,On}>-Listen to harmonics
slider9:mix=100<0,100,1>-Mix (%)
slider10:out_db=0<-24,24,0.1>-Output level (dB)
slider11:drift=50<0,100,1>-Drift (%)
slider12:byp=0<0,1,1{Off,On}>-Bypass
slider13:os_sel=1<0,2,1{1x,2x,4x}>-Oversampling
slider14:par=1<0,1,1{Whole signal,Harmonics only}>-Filters on (parallel)
slider15:sbar=0<0,1,1{Off,On}>-Sidebar
slider16:tone=0<-6,6,0.1>-Tone (tilt, dB at each end)
slider17:prs_sel=0<0,12,1{No preset,Default,Valve Glow,Tape Kiss,Iron Weight,Transistor Bite,Diode Buzz,Rail Crush,Leaning Snare,Drum Bus Ember,Vocal Grit,Slow Turning Wheel,Parallel Smash}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-kiln-mini";
ext_noinit = 1;

os_design(); os_base = 0; os_f = os_tf = os_f2n(os_sel);

CB = 12100; CN = 12110; CF = 12120; CRL = 12130; EL = 12140; EH = 12150;
CB[0] = 0.25; CB[1] = 0.03; CB[2] = 0.05; CB[3] = 0.12; CB[4] = 0; CB[5] = 0;
EL[0] = 2; EL[1] = 0; EL[2] = 8; EL[3] = 0; EL[4] = -3; EL[5] = 0;
CT = 12160; CT[0] = 1.2; CT[1] = 1.9; CT[2] = 2.8; CT[3] = 1.4; CT[4] = 0.6; CT[5] = 0.8;
EH[0] = 0; EH[1] = 6; EH[2] = -2; EH[3] = 3; EH[4] = 2; EH[5] = 0;

function kl_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function cv_f(c, v) (
  c < 0.5 ? ( v >= 0 ? v / (1 + 0.3 * v) : v / (1 - 0.9 * v); ) :
  c < 1.5 ? kl_tanh(v) :
  c < 2.5 ? v / sqrt(1 + v * v) :
  c < 3.5 ? ( abs(v) < 1.5 ? v - 0.148148148148 * v * v * v : sign(v); ) :
  c < 4.5 ? ( v >= 0 ? v / sqrt(1 + 4 * v * v) : v / sqrt(1 + 0.5102040816 * v * v); ) :
  max(-1, min(1, v));
);
function cv_ant(c, v) local(a) (
  c < 0.5 ? ( v >= 0 ? v / 0.3 - log(1 + 0.3 * v) / 0.09 : -v / 0.9 - log(1 - 0.9 * v) / 0.81; ) :
  c < 1.5 ? ( a = abs(v); a + log(1 + exp(-2 * a)) - 0.693147180560; ) :
  c < 2.5 ? sqrt(1 + v * v) - 1 :
  c < 3.5 ? ( abs(v) < 1.5 ? 0.5 * v * v - v * v * v * v / 27 : abs(v) - 0.5625; ) :
  c < 4.5 ? ( v >= 0 ? 0.25 * (sqrt(1 + 4 * v * v) - 1) : 1.96 * (sqrt(1 + 0.5102040816 * v * v) - 1); ) :
  ( abs(v) <= 1 ? 0.5 * v * v : abs(v) - 0.5; );
);
function cv_ad(c, v, v1) ( abs(v - v1) > 0.00001 ? (cv_ant(c, v) - cv_ant(c, v1)) / (v - v1) : cv_f(c, 0.5 * (v + v1)); );
function cv_init() local(c) (
  c = 0;
  loop(6, CF[c] = cv_f(c, CB[c]); CN[c] = 0.0002 / (cv_f(c, CB[c] + 0.0001) - cv_f(c, CB[c] - 0.0001)); c += 1; );
);
cv_init();
function cv_cal(d) local(c, i, s, m, u, v, k, am) (
  c = 0; am = 0.17783; k_ht = min(hv / 0.6, 1);
  loop(6,
    s = 0; m = 0; i = 0;
    loop(32, u = am * sin(2 * $pi * (i + 0.5) / 32); v = CN[c] * (cv_f(c, d * u + CB[c]) - CF[c]) / d; KT[i] = v; m += v; i += 1; );
    m /= 32; i = 0;
    loop(32, s += sqr(KT[i] - m); i += 1; );
    CRL[c] = sqrt(s / 32) / (am * 0.70711);
    c += 1;
  );
);
KT = 12300;

function emph_coefs() local(fso) (
  fso = os_f * srate;
  em_al = 1 - exp(-2 * $pi * 120 / fso); em_ah = 1 - exp(-2 * $pi * 2500 / fso);
);
function filt_coefs() local(fso, g) (
  fso = os_f * srate;
  g = tan($pi * min(exp(k_lo), 0.45 * fso) / fso); sh_a1 = 1 / (1 + g * (g + 1.4142135623731)); sh_a2 = g * sh_a1; sh_a3 = g * sh_a2;
  g = tan($pi * min(exp(k_hi), 0.45 * fso) / fso); sl_a1 = 1 / (1 + g * (g + 1.4142135623731)); sl_a2 = g * sl_a1; sl_a3 = g * sl_a2;
);
fz_C = 11100;
function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_tiny(v) ( abs(v) < 0.000000000001 ? 0 : v; );
function fz_run(x) instance(qA, qB, qC, qD, fhi, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = qA.fz_bm(x, fz_C);
  ha = abs(h); fhi += (ha - fhi) * (ha > fhi ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fhi, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fhi;
  e = qD.fz_bm(qC.fz_bm(qB.fz_bm(e, fz_C + 5), fz_C + 10), fz_C + 15);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_dn() instance(fhi, fp, fe) ( fhi = fz_tiny(fhi); fp = fz_tiny(fp); fe = fz_tiny(fe); );
function fz_clr() instance(qA, qB, qC, qD, fhi, fp, fe) ( qA.fz_bmz(); qB.fz_bmz(); qC.fz_bmz(); qD.fz_bmz(); fhi = fp = fe = 0; );
function fz_coef() local(fso) (
  fso = os_f * srate;
  fz_bqc(fz_C, 4, 3500, 0, 0.7071, fso); fz_bqc(fz_C + 5, 4, 5500, 0, 0.7071, fso);
  fz_bqc(fz_C + 10, 0, 8000, 4, 0.7, fso); fz_bqc(fz_C + 15, 2, 12000, -6, 0.7, fso);
  fz_a = 1 - exp(-1 / (0.003 * fso)); fz_r = 1 - exp(-1 / (0.12 * fso)); fz_w = 1 - exp(-1 / (0.06 * fso));
);
fz_o = fz_t = 0;

function rate_set() ( fz_coef(); emph_coefs(); );
rate_set();

function kl_tl(x) instance(x1, y1) local(y) ( y = tn0 * x + tn1 * x1 - td1 * y1; x1 = x; y1 = y; y; );
function kl_tz() instance(x1, y1) ( x1 = y1 = 0; );
function tone_coefs() local(fso, k, a, b, d0) (
  fso = os_f * srate; k = tan($pi * min(770, fso * 0.45) / fso); a = exp(k_tn * 0.057564627324851); b = 1 / a;
  d0 = b / k + 1; tn0 = (a / k + 1) / d0 / a; tn1 = (1 - a / k) / d0 / a; td1 = (1 - b / k) / d0;
);
function kl_proc(x) instance(e1, pl, ph, ql, qh, h1, h2, l1, l2, w1, w2, m1, m2) local(e, yi, yj, y, d, h, v1, v2, v3, s) (
  pl += (x - pl) * em_al; ph += (x - ph) * em_ah;
  e = x + k_gl1 * pl + k_gh1 * (x - ph);
  yi = CN[k_i] * (cv_ad(k_i, k_ds * e + b_i, k_ds * e1 + b_i) - cf_i);
  yj = k_f > 0.00001 ? CN[k_j] * (cv_ad(k_j, k_ds * e + b_j, k_ds * e1 + b_j) - cf_j) : yi;
  y = (yi + (yj - yi) * k_f) * k_mke / k_ds;
  e1 = e;
  d = (y - e) * k_sbl;
  ql += (d - ql) * em_al; qh += (d - qh) * em_ah;
  h = d + k_gl2 * ql + k_gh2 * (d - qh);
  fz_on ? h += this.FZ.fz_run(x + h);
  s = x * g_dry + h * g_wet;
  v3 = s - w2; v1 = sh_a1 * w1 + sh_a2 * v3; v2 = w2 + sh_a2 * w1 + sh_a3 * v3; w1 = 2 * v1 - w1; w2 = 2 * v2 - w2;
  s = s - 1.4142135623731 * v1 - v2;
  v3 = s - m2; v1 = sl_a1 * m1 + sl_a2 * v3; v2 = m2 + sl_a2 * m1 + sl_a3 * v3; m1 = 2 * v1 - m1; m2 = 2 * v2 - m2;
  s = this.TNS.kl_tl(v2);
  v3 = h - h2; v1 = sh_a1 * h1 + sh_a2 * v3; v2 = h2 + sh_a2 * h1 + sh_a3 * v3; h1 = 2 * v1 - h1; h2 = 2 * v2 - h2;
  h = h - 1.4142135623731 * v1 - v2;
  v3 = h - l2; v1 = sl_a1 * l1 + sl_a2 * v3; v2 = l2 + sl_a2 * l1 + sl_a3 * v3; l1 = 2 * v1 - l1; l2 = 2 * v2 - l2;
  h = this.TNH.kl_tl(v2);
  kl_hs += h * h; kl_xs += x * x;
  s + (x * g_dry + h * g_wet - s) * g_par;
);
function kl_clr() instance(e1, pl, ph, ql, qh, h1, h2, l1, l2, w1, w2, m1, m2) (
  e1 = pl = ph = ql = qh = h1 = h2 = l1 = l2 = w1 = w2 = m1 = m2 = 0; this.TNS.kl_tz(); this.TNH.kl_tz(); this.FZ.fz_clr();
);
function kl_tidy() (
  abs(cL.h1) + abs(cL.h2) + abs(cL.l1) + abs(cL.l2) + abs(cL.ql) + abs(cL.qh) < 0.000000000001 ? cL.h1 = cL.h2 = cL.l1 = cL.l2 = cL.ql = cL.qh = 0;
  abs(cR.h1) + abs(cR.h2) + abs(cR.l1) + abs(cR.l2) + abs(cR.ql) + abs(cR.qh) < 0.000000000001 ? cR.h1 = cR.h2 = cR.l1 = cR.l2 = cR.ql = cR.qh = 0;
  abs(cL.pl) + abs(cL.ph) < 0.000000000001 ? cL.pl = cL.ph = 0;
  abs(cR.pl) + abs(cR.ph) < 0.000000000001 ? cR.pl = cR.ph = 0;
  abs(cL.w1) + abs(cL.w2) + abs(cL.m1) + abs(cL.m2) < 0.000000000001 ? cL.w1 = cL.w2 = cL.m1 = cL.m2 = 0;
  abs(cR.w1) + abs(cR.w2) + abs(cR.m1) + abs(cR.m2) < 0.000000000001 ? cR.w1 = cR.w2 = cR.m1 = cR.m2 = 0;
  cL.FZ.fz_dn(); cR.FZ.fz_dn();
);

CRATE = 16;
kgl = 1 - exp(-CRATE / (0.03 * srate));
ksm = 1 - exp(-1 / (0.03 * srate));
kps = 1 - exp(-1 / (0.01 * srate));
ksw = 1 - exp(-1 / (0.015 * srate));
kea = 1 - exp(-1 / (0.003 * srate));
ker = exp(-1 / (0.12 * srate));

function kl_ctl() local(dv, ln, mo, i, j, f, tel, teh, tl, th) (
  hv += (heat / 100 - hv) * kgl; abs(heat / 100 - hv) < 0.00001 ? hv = heat / 100;
  hv != hv_c ? (
    hv_c = hv; k_dn = exp((-6 + 36 * hv) * 0.11512925464970228); cv_cal(k_dn);
    f = min(max((hv - 0.5) / 0.5, 0), 1); fz_t = 0.3 * f * f * (3 - 2 * f);
  );
  dspd = 0.05 * dm_s * CRATE / srate;
  drD = DR1.drift_tick(dspd); drB = DR2.drift_tick(dspd * 0.7); drP = DR3.drift_tick(dspd * 1.3);
  k_dt = k_dn * exp(0.6 * dm_a * drD * 0.11512925464970228);
  k_db = 0.03 * dm_a * drB;
  dv = wheel - k_wb; dv -= 6 * floor(dv / 6 + 0.5); k_wb += dv * kgl; abs(dv) < 0.0001 ? k_wb = wheel;
  k_wb < 0 ? k_wb += 6 : k_wb >= 6 ? k_wb -= 6;
  g_lean += (lean / 100 - g_lean) * kgl; g_md += (mdep / 100 - g_md) * kgl;
  g_lr += (log(max(mrate, 0.01)) - g_lr) * kgl;
  k_lph += exp(g_lr) * CRATE / srate; k_lph -= floor(k_lph);
  mo = 3 * g_md * sin(2 * $pi * k_lph);
  ln = min(max((8.685889638 * log(k_env + 0.0000001) + 24) / 18, 0), 1);
  k_wt = k_wb + mo + g_lean * ln + 0.08 * dm_a * drP;
  i = floor(k_wp); i >= 6 ? i = 0; f = k_wp - floor(k_wp); j = i < 5 ? i + 1 : 0;
  tel = EL[i] + (EL[j] - EL[i]) * f; teh = EH[i] + (EH[j] - EH[i]) * f;
  t_gl1 = exp(tel * 0.11512925464970228) - 1; t_gh1 = exp(teh * 0.11512925464970228) - 1;
  t_gl2 = 1 / (1 + t_gl1) - 1; t_gh2 = 1 / (1 + t_gh1) - 1;
  tl = log(min(max(hlo, 22), 2200)); th = log(min(max(hhi, 2200), 22000));
  abs(tl - k_lo) + abs(th - k_hi) > 0.0005 || !fl_ok ? (
    k_lo += (tl - k_lo) * kgl; k_hi += (th - k_hi) * kgl;
    abs(tl - k_lo) < 0.0005 ? k_lo = tl; abs(th - k_hi) < 0.0005 ? k_hi = th;
    filt_coefs(); fl_ok = 1;
  );
  abs(tone * 2 - k_tn) > 0.001 || !tn_ok ? ( k_tn += (tone * 2 - k_tn) * kgl; abs(tone * 2 - k_tn) < 0.001 ? k_tn = tone * 2; tone_coefs(); tn_ok = 1; );
);

ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
DR1.drift_init(0.7 + rand(1) * 0.4); DR2.drift_init(0.8 + rand(1) * 0.4); DR3.drift_init(0.9 + rand(1) * 0.4);
drift_macro(drift);
hv = heat / 100; hv_c = -1; k_wb = k_wp = k_wt = wheel;
g_lean = lean / 100; g_md = mdep / 100; g_lr = log(max(mrate, 0.01)); k_lph = 0; k_env = 0;
k_lo = log(min(max(hlo, 22), 2200)); k_hi = log(min(max(hhi, 2200), 22000));
fl_ok = 0; tn_ok = 0; k_tn = tone * 2; emph_coefs();
kl_ctl(); k_d = k_dt; k_gl1 = t_gl1; k_gh1 = t_gh1; k_gl2 = t_gl2; k_gh2 = t_gh2;
g_out = 10 ^ (out_db / 20); g_mix = mix / 100; g_ls = lis >= 0.5; g_par = par >= 0.5; g_sb = sbar >= 0.5;
cc = 0;
os_gsetup();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
by_setup(12);
pwr_init(); pwr_wu_loss = 1.0; pwr_wu_drv = 2.5; pwr_wu_lp = 7000; pwr_bloom = 0.2; pwr_sag = 0.25;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0; kl_hs = kl_xs = 0; kl_gl_d = 0;
rs_f = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function pv(i, v) ( slider(i) = v; );
function sl_list() local(i) ( i = 1; loop(11, slider_automate(2 ^ (i - 1)); i += 1; ); slider_automate(par); slider_automate(sbar); slider_automate(tone); );
function p_init() (
  pv(1, 0); pv(2, 40); pv(3, 0); pv(4, 0.2); pv(5, 0); pv(6, 22); pv(7, 22000); pv(8, 0); pv(9, 100); pv(10, 0); pv(11, 50); pv(14, 1); pv(15, 0); pv(16, 0);
);
function load_preset(p) (
  p_init();
  p == 2 ? ( pv(1, 0); pv(2, 45); pv(7, 12000); );
  p == 3 ? ( pv(1, 1); pv(2, 35); pv(7, 9900); );
  p == 4 ? ( pv(1, 2); pv(2, 55); pv(7, 3300); );
  p == 5 ? ( pv(1, 3); pv(2, 60); pv(6, 220); );
  p == 6 ? ( pv(1, 4); pv(2, 65); pv(6, 110); pv(9, 60); );
  p == 7 ? ( pv(1, 5); pv(2, 85); pv(6, 330); pv(9, 50); pv(10, -2); );
  p == 8 ? ( pv(1, 1); pv(2, 50); pv(3, 80); );
  p == 9 ? ( pv(1, 0.5); pv(2, 50); pv(3, 35); pv(6, 110); );
  p == 10 ? ( pv(1, 2.6); pv(2, 42); pv(6, 440); pv(7, 6600); pv(9, 70); );
  p == 11 ? ( pv(1, 0); pv(2, 50); pv(4, 0.05); pv(5, 50); );
  p == 12 ? ( pv(1, 5.4); pv(2, 95); pv(6, 110); pv(9, 35); );
  sl_list();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(16, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function clr_all() (
  cL.kl_clr(); cR.kl_clr();
  UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr();
  k_env = 0;
);
function clr_run() ( cL.kl_clr(); cR.kl_clr(); UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr(); );

@slider
prs_chk();
drift_macro(drift);
os_snap(slider(13));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; rs_c = 1 / (0.015 * srate); clr_all(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
drift_macro(drift);
os_tf = os_f2n(os_sel);
ost_setup(0, 0, 100, 8000, -0.3, 1);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
pwr_block(byp < 0.5);
t_out = 10 ^ (out_db / 20); t_mix = mix / 100; t_ls = lis >= 0.5; t_par = par >= 0.5; t_sb = sbar >= 0.5;
kl_tidy();
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
kl_gl_d = kl_xs > 0.0000000001 ? sqrt(kl_hs / kl_xs) : 0; kl_hs = kl_xs = 0;
kl_pos_d = k_wp;
os_snapb(slider(13));

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
by_in();
os_gate();
os_chg ? ( rate_set(); filt_coefs(); tone_coefs(); clr_run(); );
(cc -= 1) <= 0 ? ( cc = CRATE; kl_ctl(); );
dv = k_wt - k_wp; dv -= 6 * floor(dv / 6 + 0.5); k_wp += dv * kps;
k_wp < 0 ? k_wp += 6 : k_wp >= 6 ? k_wp -= 6;
k_i = floor(k_wp); k_i >= 6 ? k_i = 0; k_f = k_wp - floor(k_wp); k_j = k_i < 5 ? k_i + 1 : 0;
b_i = CB[k_i] + k_db; b_j = CB[k_j] + k_db; cf_i = cv_f(k_i, b_i); cf_j = cv_f(k_j, b_j);
k_d += (k_dt - k_d) * ksm;
k_gl1 += (t_gl1 - k_gl1) * ksm; k_gh1 += (t_gh1 - k_gh1) * ksm; k_gl2 += (t_gl2 - k_gl2) * ksm; k_gh2 += (t_gh2 - k_gh2) * ksm;
g_out += (t_out - g_out) * ksm; g_mix += (t_mix - g_mix) * ksm; g_ls += (t_ls - g_ls) * ksw; g_par += (t_par - g_par) * ksw; g_sb += (t_sb - g_sb) * ksw;
k_sbl = exp(2.0723265836946 * g_sb); k_ds = k_d / k_sbl;
fz_o += (fz_t - fz_o) * ksm;
k_mk = exp((CT[k_i] + (CT[k_j] - CT[k_i]) * k_f) * k_ht * 0.11512925464970228) / max(CRL[k_i] + (CRL[k_j] - CRL[k_i]) * k_f, 0.05);
k_mke = exp(log(k_mk) * (1 - g_sb));
g_wet = g_mix + (1 - g_mix) * g_ls; g_dry = 1 - g_ls;

pwr_in(spl0, spl1); xl = pwr_l; xr = pwr_r;
ea = max(abs(xl), abs(xr)); k_env = ea > k_env ? k_env + (ea - k_env) * kea : k_env * ker;

UL.os_up(xl); UR.os_up(xr);
fz_on = fz_o > 0.0001;
p0l = cL.kl_proc(UL.s0); p0r = cR.kl_proc(UR.s0);
os_f > 1 ? (
  p1l = cL.kl_proc(UL.s1); p1r = cR.kl_proc(UR.s1);
  os_f > 2 ? (
    p2l = cL.kl_proc(UL.s2); p2r = cR.kl_proc(UR.s2);
    p3l = cL.kl_proc(UL.s3); p3r = cR.kl_proc(UR.s3);
  );
);
wl = DNL.os_dn(p0l, p1l, p2l, p3l);
wr = DNR.os_dn(p0r, p1r, p2r, p3r);
os_g < 1 ? ( wl *= os_g; wr *= os_g; );
pwr_out(wl, wr); wl = pwr_l; wr = pwr_r;
ost_out(wl * g_out, wr * g_out);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); spl0 *= rs_f * rs_f * (3 - 2 * rs_f); spl1 *= rs_f * rs_f * (3 - 2 * rs_f); );
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x6A6560; mk_band = 0x1E1C1A; mk_ink = 0xF2EFEA; mk_tab = 0xE8661E; mk_acc = 0xFFB070;
mk_sub = ui_mix(mk_face, 0x000000, 0.55); mk_ink2 = 0xD2CEC8;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0xF4F6F8); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0x1A1A1C); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(0x1A1A1C); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_well(x, y, w, h) ( ui_cola(0x000000, 0.18); mg_r(x, y, w, h); ui_cola(0x000000, 0.12); mg_r(x, y, w, 2); mg_r(x, y + 2, 2, h - 2); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, i, t) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KRD * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KRD * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KRD * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KRD * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.72);
  ) : sty == 2 ? (
    ui_col(0xA9ACAF); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0xF1F0EC); gfx_circle(KX, KY, KRD * 0.92, 1, 1);
    i = 0; loop(6, ui_cola(0x000000, 0.12 * (1 - i / 6)); gfx_circle(KX, KY, KRD * 0.92 - i * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.9 : 0.8); ui_ssarc(KX, KY, KRD * 0.8, -2.5 + 0.5 * $pi, -1.4 + 0.5 * $pi, 1 * sc);
    ui_col(0x26282C); ui_kdot(KX, KY, a, KRD * 0.92);
  ) : (
    ui_col(0x2C2E33); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0x121315); gfx_circle(KX, KY, KRD * 0.8, 1, 1);
    ui_col(ui_mix(0x2C2E33, 0x000000, 0.25)); gfx_circle(KX, KY, KRD * 0.68, 1, 1);
    ui_cola(0xFFFFFF, act ? 0.22 : 0.12); ui_ssarc(KX, KY, KRD * 0.95, -2.6 + 0.5 * $pi, -1.0 + 0.5 * $pi, 1 * sc);
    ui_col(0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.68);
  );
);
function mg_dots(x, y, r, c) local(i, t, rs, px, py, n) (
  rs = r + 8; i = 0; n = mg_nst > 0 && mg_nst <= 8 ? mg_nst - 1 : 4;
  loop(n + 1, t = -0.75 * $pi + i / n * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_wdial && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); ui_col(c);
      mg_ctxt(px + (i == 0 ? -3 : i == 4 ? 3 : 0), py + (i == 2 ? -2 : 0), i == 0 ? "M" : i == 2 ? "C" : "S"); )
    : mg_zero && i == 2 ? ( gfx_setfont(11); ui_col(c); mg_ctxt(px, py - 2, "0"); )
    : ( ui_col(c); mg_disc(px, py, i == 0 || i == n ? 1.8 : 1.3); );
    i += 1; );
);
function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : mg_nst > 0 ? 160 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi, lg); mg_nst > 0 ? v = floor(v + 0.5);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    mg_nst > 0 ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(mg_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
      slider(idx) = mg_n2v(n, lo, hi, lg);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  mg_dots(cx, cy, r, mk_ink2); mg_cshadow(cx, cy, r);
  mg_kbody(sty, cx, cy, r, a, act, col);
  mg_wdial = 0; mg_zero = 0; mg_nst = 0;
  act;
);
function mg_hz(v) ( v >= 1000 ? sprintf(#mgh, "%.1f kHz", v / 1000) : sprintf(#mgh, "%d Hz", v + 0.5); #mgh; );
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, sty, col, kind, name) local(k, v, m) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) : kind == 1 ? sprintf(#mgv, "%+d %%", floor(v + 0.5)) :
  kind == 2 ? sprintf(#mgv, "%d ms", floor(v + 0.5)) : kind == 3 ? sprintf(#mgv, "%.1f", v) :
  kind == 4 ? strcpy(#mgv, mg_hz(v)) : kind == 5 ? sprintf(#mgv, "%+.1f dB", v) :
  kind == 6 ? ( m = floor(v + 0.5); strcpy(#mgv, m == 0 ? "OFF" : m == 1 ? "33 Hz" : m == 2 ? "55 Hz" : m == 3 ? "77 Hz" : m == 4 ? "110 Hz" : m == 5 ? "220 Hz" : "330 Hz"); ) :
  kind == 7 ? strcpy(#mgv, v <= 11.5 ? "OFF" : mg_hz(v)) : strcpy(#mgv, v >= 21500 ? "OFF" : mg_hz(v));
  gfx_setfont(10); ui_col(k ? mk_acc : mk_ink); mg_ctxt(cx, ly, k ? #mgv : name);
  k;
);
function mg_sqkey(x, y, idx, lbl, lc, ly) local(on, hov, s, b, dn) (
  on = slider(idx) >= 0.5; s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 0 : 1; ui_auto(idx); on = !on; dn = on ? 1.5 : 0; );
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(on ? 0x8A8C90 : 0x9C9EA2); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, 0.28); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, 0.35); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  gfx_setfont(10); ui_col(hov ? mk_acc : mk_ink); mg_ctxt(x + 20, ly, lbl);
);
function mg_sqk(x, y, on, lbl, lc, ly) local(hov, s, b, dn, hit) (
  s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(on ? 0x8A8C90 : 0x9C9EA2); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, 0.28); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, 0.35); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(x + 17, ly, lbl);
  hit;
);
function mg_tkey(x, y, w, on, lc, w1, w2) local(hov, hit, tw, th, cx, ax) (
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + 36) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.25); mg_rr(x, y + 1.5, w + 4, 40, 4);
  ui_col(0x0E0F10); mg_rr(x - 2, y - 2, w + 4, 40, 4);
  ui_col(0x1A1B1D); mg_rr(x, y, w, 36, 3);
  ui_col(0x45484D); mg_rr(x, y, w - 1, 35, 3);
  ui_col(0x2C2E32); mg_rr(x + 1, y + 1, w - 2, 34, 3);
  ui_col(0x34363A); mg_rr(x + 1, y + 1, w - 2, 28, 3);
  ui_col(0x3C3F43); mg_r(x + 4, y + 1, w - 8, 1);
  on ? ( ui_cola(lc, 0.3); mg_rr(x + w / 2 - 14, y + 5, 28, 12, 3); ui_col(ui_mix(lc, 0xFFFFFF, 0.25)); mg_rr(x + w / 2 - 11, y + 7, 22, 8, 2); )
     : ( ui_col(ui_mix(lc, 0x1E2023, 0.75)); mg_rr(x + w / 2 - 11, y + 7, 22, 8, 2); );
