pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );
k_ = pk_preset(470 * sc, 18 * sc, 320 * sc, 34 * sc, pr_cur, #mt_pm);
k_ > 0 ? ( prs_dirty = k_; pr_cur = k_ > 12 ? 1 : k_; );
