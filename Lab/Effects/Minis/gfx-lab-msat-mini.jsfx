  ((((mg_gb >> 16) & 255) - ((mg_gt >> 16) & 255)) / 255) / (355 * sc), ((((mg_gb >> 8) & 255) - ((mg_gt >> 8) & 255)) / 255) / (355 * sc),
  (((mg_gb & 255) - (mg_gt & 255)) / 255) / (355 * sc), 0);
ui_cola(0xFFFFFF, 0.10); mg_r(0, 0, 1024, 1.5); mg_r(0, 0, 1.5, 355);
ui_cola(0x000000, 0.30); mg_r(0, 352, 1024, 3); mg_r(1021, 0, 3, 355);
mg_rivet(7, 7); mg_rivet(1017, 7); mg_rivet(7, 348); mg_rivet(1017, 348);
ui_col(mk_band); mg_r(16, 8, 992, 54);
ui_col(mk_tab); mg_r(16, 62, 992, 3);
ui_col(0x1A1A1C); mg_disc(43, 35, 17); ui_col(0xE8EBEE); mg_disc(43, 35, 15); ui_col(0x1A1A1C); mg_disc(43, 35, 13);
mg_i = 0; loop(3, ui_col(mg_i == 0 ? 0xC08850 : mg_i == 1 ? 0x8EC6F0 : 0xEC7A6E);
  mg_stripe(43, 35, 13.6, 22.8 + mg_i * 2.6, 1.6); mg_i += 1; );
