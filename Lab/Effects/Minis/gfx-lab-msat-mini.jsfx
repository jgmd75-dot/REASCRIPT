desc:MSAT Mini [multiband saturation] (GFX Lab)
//tags: multiband saturation transient shaper stereo width analogue mastering mix bus mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os and gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:0<-12,12,0.1>-Input (dB)
slider2:250<50,1000,1>-Low / mid crossover (Hz)
slider3:4000<1000,12000,10>-Mid / high crossover (Hz)
slider4:0<-15,15,0.1>-Low attack (dB)
slider5:0<-15,15,0.1>-Low sustain (dB)
slider6:6<0,24,0.1>-Low drive (dB)
slider7:100<0,100,1>-Low mix (%)
slider8:100<0,200,1>-Low width (%)
slider9:0<-15,15,0.1>-Mid attack (dB)
slider10:0<-15,15,0.1>-Mid sustain (dB)
slider11:6<0,24,0.1>-Mid drive (dB)
slider12:100<0,100,1>-Mid mix (%)
slider13:100<0,200,1>-Mid width (%)
slider14:0<-15,15,0.1>-High attack (dB)
slider15:0<-15,15,0.1>-High sustain (dB)
slider16:6<0,24,0.1>-High drive (dB)
slider17:100<0,100,1>-High mix (%)
slider18:100<0,200,1>-High width (%)
slider19:0<-12,12,0.1>-Output (dB)
slider20:0<0,1,1{Off,On}>-Low solo
slider21:0<0,1,1{Off,On}>-Low mute
slider22:0<0,1,1{Off,On}>-Mid solo
slider23:0<0,1,1{Off,On}>-Mid mute
slider24:0<0,1,1{Off,On}>-High solo
slider25:0<0,1,1{Off,On}>-High mute
slider26:1<0,1,1{Off,On}>-Link
slider27:0<0,2,1{1x,2x,4x}>-Oversampling
slider28:0<0,1,1{Off,On}>-Linear phase crossover
slider29:0<0,1,1{Off,On}>-Bypass
slider30:prs_sel=0<0,12,1{No preset,Init,Gentle Warmth,Punchy Drums,Tame the Snap,Wide Air,Mono Lows,Vocal Presence,Bass Glue,Room Lift,Snappy Mix Bus,Thick and Hot,Clean Width}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-msat-mini";
pk_lcdstrip = 1;
ext_noinit = 1;

function mt_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function mt_tc(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );
function bq_set(t, f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  t == 0 ? ( b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; ) :
  t == 1 ? ( b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; ) :
           ( b0 = (1 - al) / n; b1 = -2 * cw / n; b2 = 1; );
  a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, s1, s2) local(y) (
  y = b0 * x + s1; s1 = b1 * x - a1 * y + s2; s2 = b2 * x - a2 * y;
  y;
);
function bq_tidy() instance(s1, s2) ( s1 = mt_tn(s1); s2 = mt_tn(s2); );
function bq_clr() instance(s1, s2) ( s1 = s2 = 0; );

function mt_sc(v) ( v >= 1.5 ? 1 : v <= -1.5 ? -1 : v * (1 - 0.148148148 * v * v); );

function xo_run(x) instance(lo, mi, hi) local(r) (
  lo = this.l2.bq_run(this.l1.bq_run(x));
  r = this.h2.bq_run(this.h1.bq_run(x));
  mi = this.m2.bq_run(this.m1.bq_run(r));
  hi = this.u2.bq_run(this.u1.bq_run(r));
  lo = this.ap.bq_run(lo);
);
function xo_cfg() (
  this.l1.bq_set(0, mt_f1, 0.70710678); this.l2.bq_set(0, mt_f1, 0.70710678);
  this.h1.bq_set(1, mt_f1, 0.70710678); this.h2.bq_set(1, mt_f1, 0.70710678);
  this.m1.bq_set(0, mt_f2, 0.70710678); this.m2.bq_set(0, mt_f2, 0.70710678);
  this.u1.bq_set(1, mt_f2, 0.70710678); this.u2.bq_set(1, mt_f2, 0.70710678);
  this.ap.bq_set(2, mt_f2, 0.70710678);
);
function xo_tidy() (
  this.l1.bq_tidy(); this.l2.bq_tidy(); this.h1.bq_tidy(); this.h2.bq_tidy();
  this.m1.bq_tidy(); this.m2.bq_tidy(); this.u1.bq_tidy(); this.u2.bq_tidy(); this.ap.bq_tidy();
);
function xo_clr() (
  this.l1.bq_clr(); this.l2.bq_clr(); this.h1.bq_clr(); this.h2.bq_clr();
  this.m1.bq_clr(); this.m2.bq_clr(); this.u1.bq_clr(); this.u2.bq_clr(); this.ap.bq_clr();
);

MLP_B = 256;
MLP_H = 1048576; MLP_X = MLP_H + 32768; MLP_W = MLP_X + 32768; MLP_Y = MLP_W + 1024; MLP_PV = MLP_Y + 1024;
MLP_CU = MLP_PV + 1024; MLP_O = MLP_CU + 1024; MLP_Y2 = MLP_O + 1024; MLP_G = MLP_Y2 + 1024; MLP_HO = MLP_G + 8192;
function mlp_setup() (
  mlp_n = srate <= 50000 ? 2048 : srate <= 100000 ? 4096 : 8192;
  mlp_k = mlp_n / MLP_B;
  mlp_lat = mlp_n - 1 + MLP_B;
);
function mlp_build() local(i, k, x, t, nf) (
  mlp_a1.bq_set(2, mt_f1, 0.70710678); mlp_a2.bq_set(2, mt_f2, 0.70710678);
  mlp_a1.s1 = mlp_a1.s2 = mlp_a2.s1 = mlp_a2.s2 = 0;
  i = 0; loop(mlp_n, x = i == 0; MLP_G[i] = mlp_a2.bq_run(mlp_a1.bq_run(x)); i += 1; );
  nf = mlp_n / 8; i = 0;
  loop(nf, t = 0.5 - 0.5 * cos($pi * i / nf); MLP_G[mlp_n - 1 - i] *= t; i += 1; );
  mlp_xf = mlp_on; mlp_xf ? memcpy(MLP_HO, MLP_H, mlp_k * 1024);
  k = 0;
  loop(mlp_k,
    memset(MLP_W, 0, 2 * MLP_B * 2);
    i = 0; loop(MLP_B, MLP_W[2 * i] = MLP_G[mlp_n - 1 - (k * MLP_B + i)] / (2 * MLP_B); i += 1; );
    fft(MLP_W, 2 * MLP_B);
    memcpy(MLP_H + k * 1024, MLP_W, 4 * MLP_B);
    k += 1;
  );
  mlp_dirty = 0;
);
function mlp_clr() ( memset(MLP_X, 0, 32768); memset(MLP_PV, 0, 1024); memset(MLP_CU, 0, 1024); memset(MLP_O, 0, 1024);
  mlp_p = 0; mlp_xi = 0; mlp_xf = 0; );
function mlp_sum(y, h) local(k, xs, hs, i, ar, am, hr, hm) (
  memset(y, 0, 4 * MLP_B);
  k = 0;
  loop(mlp_k,
    xs = MLP_X + ((mlp_xi - k + mlp_k) % mlp_k) * 1024; hs = h + k * 1024;
    i = 0;
    loop(2 * MLP_B,
      ar = xs[i]; am = xs[i + 1]; hr = hs[i]; hm = hs[i + 1];
      y[i] += ar * hr - am * hm; y[i + 1] += ar * hm + am * hr;
      i += 2;
    );
    k += 1;
  );
  ifft(y, 2 * MLP_B);
);
function mlp_blk() local(i, w) (
  memcpy(MLP_W, MLP_PV, 2 * MLP_B); memcpy(MLP_W + 2 * MLP_B, MLP_CU, 2 * MLP_B); memcpy(MLP_PV, MLP_CU, 2 * MLP_B);
  fft(MLP_W, 2 * MLP_B);
  memcpy(MLP_X + mlp_xi * 1024, MLP_W, 4 * MLP_B);
  mlp_sum(MLP_Y, MLP_H);
  mlp_xf ? (
    mlp_sum(MLP_Y2, MLP_HO);
    i = 0;
    loop(MLP_B,
      w = 0.5 - 0.5 * cos($pi * (i + 0.5) / MLP_B);
      MLP_O[2 * i] = MLP_Y2[2 * MLP_B + 2 * i] * (1 - w) + MLP_Y[2 * MLP_B + 2 * i] * w;
      MLP_O[2 * i + 1] = MLP_Y2[2 * MLP_B + 2 * i + 1] * (1 - w) + MLP_Y[2 * MLP_B + 2 * i + 1] * w;
      i += 1;
    );
    mlp_xf = 0;
  ) : memcpy(MLP_O, MLP_Y + 2 * MLP_B, 2 * MLP_B);
  mlp_xi = (mlp_xi + 1) % mlp_k;
);
function mlp_run(l, r) (
  MLP_CU[2 * mlp_p] = l; MLP_CU[2 * mlp_p + 1] = r;
  mlp_l = MLP_O[2 * mlp_p]; mlp_r = MLP_O[2 * mlp_p + 1];
  mlp_p += 1; mlp_p >= MLP_B ? ( mlp_blk(); mlp_p = 0; );
);
function mlp_gate() (
  mlp_t != mlp_on ? (
    mlp_gg = max(mlp_gg - os_gc, 0);
    mlp_gg == 0 ? (
      mlp_on = mlp_t; mlp_clr(); mlp_on && mlp_dirty ? ( mlp_build(); mlp_xf = 0; );
      os_base = mlp_on ? mlp_lat : 0; pdc_delay = os_base + os_lat(os_f);
      mlp_hold = os_base + os_lat(os_f) + floor(0.01 * srate);
    );
  ) : mlp_hold > 0 ? mlp_hold -= 1 : mlp_gg < 1 ? mlp_gg = min(mlp_gg + os_gc, 1);
);

function bd_times(af, as, ar, sl, sf) instance(kAf, kAs, kAr, kSl, kSf, kg) (
  kAf = mt_tc(af); kAs = mt_tc(as); kAr = mt_tc(ar); kSl = mt_tc(sl); kSf = mt_tc(sf); kg = mt_tc(1);
);
function bd_set(at, su, dr, mx, wd, bi) instance(tA, tS, tD, tM, tWi, bias) (
  tA = at; tS = su; tD = 10 ^ (dr / 20); tM = mx; tWi = wd; bias = bi;
);
function bd_pre(l, r) instance(kAf, kAs, kAr, kSl, kSf, kg, eA1, eA2, eS1, eS2, g, tA, tS, tD, tM, tWi,
                               bdD, bdM, bdW, gmon, pL, pR,
                               fA1, fA2, fS1, fS2, gf, hA1, hA2, hS1, hS2, gh) local(a, eps, gt, u, b) (
  a = max(abs(l), abs(r));
  eA1 += (a > eA1 ? kAf : kAr) * (a - eA1);
  eA2 += (eA1 > eA2 ? kAs : kAr) * (eA1 - eA2);
  eS1 += (a > eS1 ? kAf : kSl) * (a - eS1);
  eS2 += (a > eS2 ? kAf : kSf) * (a - eS2);
  eps = 0.0000001;
  gt = (tA != 0 ? tA * min(max((eA1 - eA2) / (eA1 + eps), 0) * 3, 1) : 0)
     + (tS != 0 ? tS * min(max((eS1 - eS2) / (eS1 + eps), 0) * 1.6, 1) : 0);
  g += (gt - g) * kg; gmon = g;
  lk_u > 0 ? (
    b = abs(l);
    fA1 += (b > fA1 ? kAf : kAr) * (b - fA1); fA2 += (fA1 > fA2 ? kAs : kAr) * (fA1 - fA2);
    fS1 += (b > fS1 ? kAf : kSl) * (b - fS1); fS2 += (b > fS2 ? kAf : kSf) * (b - fS2);
    gt = (tA != 0 ? tA * min(max((fA1 - fA2) / (fA1 + eps), 0) * 3, 1) : 0)
       + (tS != 0 ? tS * min(max((fS1 - fS2) / (fS1 + eps), 0) * 1.6, 1) : 0);
    gf += (gt - gf) * kg;
    b = abs(r);
    hA1 += (b > hA1 ? kAf : kAr) * (b - hA1); hA2 += (hA1 > hA2 ? kAs : kAr) * (hA1 - hA2);
    hS1 += (b > hS1 ? kAf : kSl) * (b - hS1); hS2 += (b > hS2 ? kAf : kSf) * (b - hS2);
    gt = (tA != 0 ? tA * min(max((hA1 - hA2) / (hA1 + eps), 0) * 3, 1) : 0)
       + (tS != 0 ? tS * min(max((hS1 - hS2) / (hS1 + eps), 0) * 1.6, 1) : 0);
    gh += (gt - gh) * kg;
    l *= exp(0.115129255 * (g + (gf - g) * lk_u)); r *= exp(0.115129255 * (g + (gh - g) * lk_u));
    gmon = abs(gf) > abs(gh) ? gf : gh;
  ) : (
    fA1 = hA1 = eA1; fA2 = hA2 = eA2; fS1 = hS1 = eS1; fS2 = hS2 = eS2; gf = gh = g;
    u = abs(g) > 0.0005 ? exp(0.115129255 * g) : 1;
    l *= u; r *= u;
  );
  bdD += (tD - bdD) * mt_gs; bdM += (tM - bdM) * mt_gs; bdW += (tWi - bdW) * mt_gs;
  pL = l; pR = r;
);
function bd_sat(l, r) instance(bdD, bdM, bdW, bias, rest, oL, oR) local(sl, sr, mid, sid, wn) (
  bdM > 0.0005 ? (
    sl = (mt_sc(l * bdD + bias) - rest) / bdD; sr = (mt_sc(r * bdD + bias) - rest) / bdD;
    l += bdM * (sl - l); r += bdM * (sr - r);
  );
  abs(bdW - 1) > 0.0005 ? (
    mid = 0.5 * (l + r); sid = 0.5 * (l - r); wn = min(sqrt(2 / (1 + bdW * bdW)), 1.4142);
    mid *= wn; sid *= bdW * wn; l = mid + sid; r = mid - sid;
  );
  oL = l; oR = r;
);
function bd_run(l, r) ( this.bd_pre(l, r); this.bd_sat(this.pL, this.pR); );
function bd_rest() instance(bias, rest) ( rest = mt_sc(bias); );
function bd_tidy() instance(eA1, eA2, eS1, eS2, g, fA1, fA2, fS1, fS2, gf, hA1, hA2, hS1, hS2, gh) (
  eA1 = mt_tn(eA1); eA2 = mt_tn(eA2); eS1 = mt_tn(eS1); eS2 = mt_tn(eS2); g = mt_tn(g);
  fA1 = mt_tn(fA1); fA2 = mt_tn(fA2); fS1 = mt_tn(fS1); fS2 = mt_tn(fS2); gf = mt_tn(gf);
  hA1 = mt_tn(hA1); hA2 = mt_tn(hA2); hS1 = mt_tn(hS1); hS2 = mt_tn(hS2); gh = mt_tn(gh);
);
function bd_clr() instance(eA1, eA2, eS1, eS2, g, fA1, fA2, fS1, fS2, gf, hA1, hA2, hS1, hS2, gh) (
  eA1 = eA2 = eS1 = eS2 = g = fA1 = fA2 = fS1 = fS2 = gf = hA1 = hA2 = hS1 = hS2 = gh = 0;
  this.osl.os_clr(); this.osr.os_clr();
);

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);
function fz_hi() ( fz_o > 0.0001 ? ( fz_l = bH.oL; fz_r = bH.oR; fz_run(); bH.oL = fz_l; bH.oR = fz_r; ); );

#mt_pm = "Init|Gentle Warmth|Punchy Drums|Tame the Snap|Wide Air|Mono Lows|Vocal Presence|Bass Glue|Room Lift|Snappy Mix Bus|Thick and Hot|Clean Width";
function mt_b(base, at, su, dr, mx, wd) ( slider(base) = at; slider(base + 1) = su; slider(base + 2) = dr; slider(base + 3) = mx; slider(base + 4) = wd; );
function mt_x(f1, f2) ( slider(2) = f1; slider(3) = f2; );
function load_preset(p) local(i) (
  mt_x(250, 4000); mt_b(4, 0, 0, 6, 100, 100); mt_b(9, 0, 0, 6, 100, 100); mt_b(14, 0, 0, 6, 100, 100);
  p == 2  ? ( mt_b(4, 0, 0, 9, 70, 100); mt_b(9, 0, 0, 8, 60, 100); mt_b(14, 0, 0, 5, 50, 110); ) :
  p == 3  ? ( mt_x(150, 5000); mt_b(4, 6, -3, 10, 80, 90); mt_b(9, 5, -2, 8, 70, 100); mt_b(14, 4, 0, 6, 60, 110); ) :
  p == 4  ? ( mt_x(200, 3500); mt_b(4, -3, 0, 6, 100, 100); mt_b(9, -6, 1, 6, 100, 100); mt_b(14, -8, 2, 4, 100, 100); ) :
  p == 5  ? ( mt_x(300, 6000); mt_b(4, 0, 0, 4, 100, 90); mt_b(9, 0, 0, 5, 100, 115); mt_b(14, 0, 2, 7, 60, 150); ) :
  p == 6  ? ( mt_x(150, 4000); mt_b(4, 0, 0, 8, 100, 0); mt_b(9, 0, 0, 6, 100, 100); mt_b(14, 0, 0, 6, 100, 115); ) :
  p == 7  ? ( mt_x(250, 3000); mt_b(4, 0, -2, 4, 100, 100); mt_b(9, 2, 0, 9, 60, 100); mt_b(14, 3, 1, 8, 50, 110); ) :
  p == 8  ? ( mt_x(120, 2500); mt_b(4, -2, 3, 14, 70, 0); mt_b(9, 2, 0, 9, 60, 100); mt_b(14, 0, 0, 4, 100, 100); ) :
  p == 9  ? ( mt_x(250, 4000); mt_b(4, 0, 3, 6, 100, 100); mt_b(9, 0, 5, 6, 100, 120); mt_b(14, 0, 4, 5, 100, 130); ) :
  p == 10 ? ( mt_x(180, 4500); mt_b(4, 4, -2, 9, 70, 100); mt_b(9, 3, -1, 8, 60, 105); mt_b(14, 3, 0, 7, 50, 115); ) :
  p == 11 ? ( mt_x(250, 4000); mt_b(4, 0, 2, 18, 100, 100); mt_b(9, 0, 2, 16, 100, 100); mt_b(14, 0, 0, 12, 80, 100); ) :
  p == 12 ? ( mt_x(250, 4000); mt_b(4, 0, 0, 0, 0, 80); mt_b(9, 0, 0, 0, 0, 120); mt_b(14, 0, 0, 0, 0, 150); ) :
  p == 13 ? ( slider(1) = 0; slider(19) = 0; i = 20; loop(6, slider(i) = 0; i += 1; ); slider(26) = 1; );
  i = 1; loop(26, slider_automate(2 ^ (i - 1)); i += 1; );
  pr_cur = p == 13 ? 1 : p;
);

function mt_srinit() (
  mt_sr = srate;
  bL.bd_times(3, 25, 140, 400, 90);
  bM.bd_times(1, 12, 90, 250, 50);
  bH.bd_times(0.3, 5, 50, 140, 25);
  mt_gs = 1 - exp(-1 / (0.02 * srate));
  mt_ks = 1 - exp(-1 / (0.004 * srate));
  mt_lkc = 1 - exp(-1 / (0.01 * srate));
  rs_c = 1 / (0.015 * srate);
  ost_init(0);
);
function mt_clrall() (
  xL.xo_clr(); xR.xo_clr(); bL.bd_clr(); bM.bd_clr(); bH.bd_clr();
  mt_dnl.os_clr(); mt_dnr.os_clr(); fz_clr(); mlp_clr();
);
mt_srinit();
mlp_setup(); mlp_on = mlp_t = slider(28) >= 0.5; mlp_gg = 1; mlp_hold = 0; mlp_clr(); mlp_dirty = 1;
os_design(); os_base = mlp_on ? mlp_lat : 0; os_f = os_tf = os_f2n(slider(27)); os_gsetup();
fz_coefs(srate * os_f); fz_clr(); fz_o = 0;
in_init();
mt_snap = 1;
lk_s = slider(26) >= 0.5; lk_u = 1 - lk_s;
rs_f = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
by_setup(29);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(29, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_fresh ? (
  mlp_t = slider(28) >= 0.5;
  mlp_t != mlp_on ? ( mlp_on = mlp_t; mlp_clr(); mlp_on ? mlp_build(); );
  os_base = mlp_on ? mlp_lat : 0;
);
os_snap(slider(27));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
srate != mt_sr ? ( mt_srinit(); mlp_setup(); mlp_clr(); mlp_dirty = 1; os_base = mlp_on ? mlp_lat : 0; os_gsetup(); fz_coefs(srate * os_f); fz_clr(); );
os_tf = os_f2n(slider(27));
in_setup(slider(1), 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_base + os_lat(os_f);
mlp_t = slider(28) >= 0.5;
mt_f1t = min(max(slider(2), 50), 1000); mt_f2t = max(min(max(slider(3), 1000), 12000), mt_f1t * 1.5);
mt_k = mt_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
mt_f1 = mt_snap ? mt_f1t : mt_f1 * (mt_f1t / mt_f1) ^ mt_k;
mt_f2 = mt_snap ? mt_f2t : mt_f2 * (mt_f2t / mt_f2) ^ mt_k;
abs(mt_f1 - mt_lf1) > 0.01 || abs(mt_f2 - mt_lf2) > 0.01 ? (
  xL.xo_cfg(); xR.xo_cfg();
  mt_lf1 = mt_f1; mt_lf2 = mt_f2;
  mlp_dirty = 1;
);
(mlp_on || mlp_t) && mlp_dirty ? mlp_build();
bL.bd_set(slider(4), slider(5), slider(6), slider(7) / 100, slider(8) / 100, 0.06);
bM.bd_set(slider(9), slider(10), slider(11), slider(12) / 100, slider(13) / 100, 0.06);
bH.bd_set(slider(14), slider(15), slider(16), slider(17) / 100, slider(18) / 100, 0.05);
bL.bd_rest(); bM.bd_rest(); bH.bd_rest();
mt_fzp = min(max((slider(16) - 12) / 12, 0), 1) * min(max(slider(17) / 100, 0), 1);
fz_t = 0.33 * mt_fzp * mt_fzp * (3 - 2 * mt_fzp);
mt_outt = 10 ^ (min(max(slider(19), -12), 12) / 20);
mt_snap ? (
  bL.bdD = bL.tD; bL.bdM = bL.tM; bL.bdW = bL.tWi; bM.bdD = bM.tD; bM.bdM = bM.tM; bM.bdW = bM.tWi; bH.bdD = bH.tD; bH.bdM = bH.tM; bH.bdW = bH.tWi;
  mt_outs = mt_outt; fz_o = fz_t; mt_snap = 0;
);
xL.xo_tidy(); xR.xo_tidy(); bL.bd_tidy(); bM.bd_tidy(); bH.bd_tidy();
mt_so = slider(20) >= 0.5 || slider(22) >= 0.5 || slider(24) >= 0.5;
mt_tL = mt_so ? slider(20) >= 0.5 : slider(21) < 0.5; mt_tM = mt_so ? slider(22) >= 0.5 : slider(23) < 0.5; mt_tH = mt_so ? slider(24) >= 0.5 : slider(25) < 0.5;
mt_sinit ? 0 : ( mt_sL = mt_tL; mt_sM = mt_tM; mt_sH = mt_tH; mt_sinit = 1; );
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0;
mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
mn_l_d = max(mn_l_d, mn_lm); mn_r_d = max(mn_r_d, mn_rm); mn_lm = mn_rm = 0;
os_snapb(slider(27));

@sample
by_in();
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
rs_req ? ( rs_req = 0; mt_clrall(); rs_f = 0; );
os_gate(); mlp_gate();
os_chg ? ( bL.osl.os_clr(); bL.osr.os_clr(); bM.osl.os_clr(); bM.osr.os_clr(); bH.osl.os_clr(); bH.osr.os_clr();
           mt_dnl.os_clr(); mt_dnr.os_clr(); fz_coefs(srate * os_f); fz_clr(); );
in_process(spl0, spl1);
mt_xl = in_l; mt_xr = in_r;
lk_s += ((slider(26) >= 0.5) - lk_s) * mt_lkc; lk_s > 0.9999 && slider(26) >= 0.5 ? lk_s = 1; lk_s < 0.0001 && slider(26) < 0.5 ? lk_s = 0;
lk_u = 1 - lk_s;
mlp_on ? ( mlp_run(mt_xl, mt_xr); mt_xl = mlp_l; mt_xr = mlp_r; );
xL.xo_run(mt_xl); xR.xo_run(mt_xr);
mt_sL += (mt_tL - mt_sL) * mt_ks; mt_sM += (mt_tM - mt_sM) * mt_ks; mt_sH += (mt_tH - mt_sH) * mt_ks;
fz_o != fz_t ? ( fz_o += (fz_t - fz_o) * mt_gs; abs(fz_t - fz_o) < 0.000001 ? fz_o = fz_t; );
os_f == 1 ? (
  bL.bd_run(xL.lo, xR.lo); bM.bd_run(xL.mi, xR.mi); bH.bd_run(xL.hi, xR.hi);
  fz_hi();
  mt_yl = bL.oL * mt_sL + bM.oL * mt_sM + bH.oL * mt_sH; mt_yr = bL.oR * mt_sL + bM.oR * mt_sM + bH.oR * mt_sH;
) : (
  bL.bd_pre(xL.lo, xR.lo); bM.bd_pre(xL.mi, xR.mi); bH.bd_pre(xL.hi, xR.hi);
  bL.osl.os_up(bL.pL); bL.osr.os_up(bL.pR); bM.osl.os_up(bM.pL); bM.osr.os_up(bM.pR); bH.osl.os_up(bH.pL); bH.osr.os_up(bH.pR);
  mt_i = 0;
  loop(os_f,
    bL.bd_sat(bL.osl.os_s(mt_i), bL.osr.os_s(mt_i)); bM.bd_sat(bM.osl.os_s(mt_i), bM.osr.os_s(mt_i));
    bH.bd_sat(bH.osl.os_s(mt_i), bH.osr.os_s(mt_i));
    fz_hi();
    mt_ol = bL.oL * mt_sL + bM.oL * mt_sM + bH.oL * mt_sH; mt_or = bL.oR * mt_sL + bM.oR * mt_sM + bH.oR * mt_sH;
    mt_i == 0 ? ( mt_p0 = mt_ol; mt_q0 = mt_or; ) : mt_i == 1 ? ( mt_p1 = mt_ol; mt_q1 = mt_or; ) :
    mt_i == 2 ? ( mt_p2 = mt_ol; mt_q2 = mt_or; ) : ( mt_p3 = mt_ol; mt_q3 = mt_or; );
    mt_i += 1;
  );
  mt_yl = mt_dnl.os_dn(mt_p0, mt_p1, mt_p2, mt_p3); mt_yr = mt_dnr.os_dn(mt_q0, mt_q1, mt_q2, mt_q3);
);
mt_outs += (mt_outt - mt_outs) * mt_gs;
mt_yl *= mt_outs; mt_yr *= mt_outs;
mt_yl != mt_yl ? mt_yl = 0; mt_yr != mt_yr ? mt_yr = 0;
ost_out(mt_yl, mt_yr);
spl0 = max(-4, min(4, ost_l)) * os_g * mlp_gg;
spl1 = max(-4, min(4, ost_r)) * os_g * mlp_gg;
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f); spl0 = by_il + (spl0 - by_il) * rs_s; spl1 = by_ir + (spl1 - by_ir) * rs_s; );
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);
mn_lm = max(mn_lm, abs(spl0)); mn_rm = max(mn_rm, abs(spl1)); mn_pkm = max(mn_pkm, max(mn_lm, mn_rm));

@gfx 1024 355
ui_begin(1024, 355);
mk_face = 0x1E3A27; mk_band = 0x0E1410; mk_ink = 0xCDEBCB; mk_tab = 0x9EE6A0; mk_tabink = 0x0D1A10; mk_acc = 0x9EE6A0;
mk_sub = ui_mix(mk_face, 0x000000, 0.66); mk_ink2 = ui_mix(mk_ink, mk_sub, 0.30); mk_gold = 0xCDEBCB; mk_cor = 0xFF8A1F; mk_cgn = 0x9EE6A0; mk_cgr = 0x9A9EA3;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, sxl, sxr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  sxl = gx - hw; sxr = gx + hw; il = floor(sxl); ir = floor(sxr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = sxr - sxl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - sxl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = sxr - ir; sxr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title, bc) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(mk_sub, 0x000000, 0.3)); mg_r(x + 9, y + b + 36, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  bc ? ( ui_col(bc); mg_r(x + b, y + b + 28, w - 2 * b, 3); );
  ui_col(mk_band); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(mk_gold); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(mk_tabink); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(ui_mix(mk_sub, 0x000000, 0.4)); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(ui_mix(mk_face, 0xFFFFFF, 0.35)); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8E9690); mg_disc(x, y, 4); ui_col(0xC0C8C2); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, k, ca, sa, pc) (
  KX = x * sc; KY = y * sc; KRD = r * sc; ca = sin(a); sa = -cos(a);
  ui_col(0x121212); gfx_circle(KX, KY, KRD, 1, 1);
  ui_cola(0xFFFFFF, act ? 0.20 : 0.12); gfx_circle(KX, KY, KRD, 0, 1);
  k = KRD * 0.74;
  ui_col(col); gfx_circle(KX, KY, k, 1, 1);
  ui_col(ui_mix(col, 0x000000, 0.35)); gfx_circle(KX, KY, k, 0, 1);
  pc = mg_lum(col) > 0.5 ? 0x1A0C02 : 0xF4F0E6;
  ui_col(pc); ui_ssline(KX + ca * k * 0.2, KY + sa * k * 0.2, KX + ca * KRD * 0.94, KY + sa * KRD * 0.94, 2.6 * sc, 1);
);
function mg_dots(x, y, r, c) local(i, t, rs, px, py) (
  rs = r + 8; i = 0;
  loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_wdial && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); ui_col(c);
      mg_ctxt(px + (i == 0 ? -3 : i == 4 ? 3 : 0), py + (i == 2 ? -2 : 0), i == 0 ? "M" : i == 2 ? "C" : "S"); )
    : mg_zero && i == 2 ? ( gfx_setfont(11); ui_col(c); mg_ctxt(px, py - 2, "0"); )
    : ( ui_col(c); ui_ssline((x + sin(t) * (r + 3)) * sc, (y - cos(t) * (r + 3)) * sc, (x + sin(t) * (r + 8)) * sc, (y - cos(t) * (r + 8)) * sc, 1.2 * sc, 0); );
    i += 1; );
);
function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi, lg);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(mg_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    slider(idx) = mg_n2v(n, lo, hi, lg);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  mg_dots(cx, cy, r, mk_ink2); mg_cshadow(cx, cy, r);
  mg_kbody(sty, cx, cy, r, a, act, col);
  mg_wdial = 0; mg_zero = 0;
  act;
);
function mg_hz(v) ( v >= 1000 ? sprintf(#mgh, "%.1f kHz", v / 1000) : sprintf(#mgh, "%d Hz", v + 0.5); #mgh; );
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, sty, col, kind, name) local(k, v) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) : kind == 4 ? strcpy(#mgv, mg_hz(v)) :
  kind == 5 ? sprintf(#mgv, "%+.1f dB", v) : sprintf(#mgv, "%.1f dB", v);
  gfx_setfont(10); ui_col(k ? mk_acc : mk_ink); mg_ctxt(cx, ly, k ? #mgv : name);
  k;
);
function mg_sqkey(x, y, idx, lbl, lc, ly) local(on, hov, s, b, dn) (
  on = slider(idx) >= 0.5; s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 0 : 1; ui_auto(idx); on = !on; dn = on ? 1.5 : 0; );
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(on ? 0x8A8C90 : 0x9C9EA2); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, 0.28); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, 0.35); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  gfx_setfont(10); ui_col(hov ? mk_acc : mk_ink); mg_ctxt(x + 20, ly, lbl);
);
function mg_smkey(x, y, idx, lbl, rim, face) local(on, hov, w, h, dn) (
  on = slider(idx) >= 0.5; w = 24; h = 20; dn = on ? 1 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 0 : 1; ui_auto(idx); on = !on; dn = on ? 1 : 0; );
  mg_rshadow(x, y, w, h, 2);
  ui_col(0x0A0A0C); mg_rr(x - 1, y - 1, w + 2, h + 2, 3);
  on ? (
    ui_cola(face, 0.25); mg_rr(x - 3, y - 3, w + 6, h + 6, 4);
    ui_col(rim); mg_rr(x + 1, y + 1 + dn, w - 2, h - 2 - dn, 2);
    ui_col(face); mg_rr(x + 3, y + 3 + dn, w - 6, h - 6 - dn, 2);
    ui_cola(0xFFF6E0, 0.45); mg_rr(x + 6, y + 6 + dn, w - 12, h - 11 - dn, 2);
  ) : (
    ui_col(ui_mix(rim, 0x141218, 0.72)); mg_rr(x + 1, y + 1, w - 2, h - 2, 2);
    ui_cola(0xFFFFFF, 0.10); mg_r(x + 3, y + 2, w - 6, 1);
  );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_rr(x + 1, y + 1, w - 2, h - 2, 2); );
  gfx_setfont(11); ui_col(on ? 0x2A1808 : ui_mix(face, 0xFFFFFF, 0.6)); mg_ctxt(x + w * 0.5, y + h * 0.5 + dn * 0.5, lbl);
);
function mg_dwell(x, y, w, h) (
  ui_col(ui_mix(mk_face, 0x000000, 0.45)); mg_r(x, y, w, h);
  ui_col(ui_mix(mk_sub, 0x000000, 0.25)); mg_r(x + 2, y + 2, w - 3, h - 3);
  ui_cola(0x000000, 0.30); mg_r(x + 2, y + 2, w - 3, 2); mg_r(x + 2, y + 4, 2, h - 5);
  ui_cola(0xFFFFFF, 0.18); mg_r(x, y + h, w + 1, 1); mg_r(x + w, y, 1, h);
);
function mg_ladder(x, y, db, hd, pk) local(i, d, c, on, gy) (
  ui_col(0x050506); mg_rr(x - 8, y - 8, 16, 15 * 12 + 16, 4);
  i = 0;
  loop(16,
    gy = y + i * 12;
    i == 0 ? ( c = 0xFF3A2A; on = pk; ) : (
      d = -3 * (i - 1);
      c = d > -4 ? 0xFF3A2A : d > -10 ? 0xFF8A1E : d > -16 ? 0xFFC81E : d > -28 ? 0x3CE05A : 0x3A9CFF;
      on = db >= d || (hd > -42 && abs(hd - d) < 1.5);
    );
    on ? ( ui_cola(c, 0.22); mg_disc(x, gy, 6); ui_col(c); ) : ui_col(ui_mix(c, 0x000000, 0.78));
    mg_disc(x, gy, 3.6);
    on ? ( ui_cola(0xFFFFFF, 0.5); mg_disc(x - 0.9, gy - 0.9, 1); );
    i += 1;
  );
);
function mg_band(x0, n, num, title, bc, b0) local(off) (
  mg_sub(x0, 80, 212, 256, num, title, bc);
  mg_kn(x0 + 44, 164, 20, 204, b0 + 2, 0, 24, 6, 0, 1, bc, 9, "DRIVE");
  mg_kn(x0 + 106, 164, 16, 204, b0 + 3, 0, 100, 100, 0, 0, mk_cgn, 0, "MIX");
  mg_wdial = 1; mg_kn(x0 + 168, 164, 16, 204, b0 + 4, 0, 200, 100, 0, 0, mk_cgn, 0, "WIDTH");
  mg_zero = 1; mg_kn(x0 + 70, 262, 17, 298, b0, -15, 15, 0, 0, 0, mk_cgn, 5, "ATTACK");
  mg_zero = 1; mg_kn(x0 + 142, 262, 17, 298, b0 + 1, -15, 15, 0, 0, 0, mk_cgn, 5, "SUSTAIN");
  off = n == 0 ? mt_offL : n == 1 ? mt_offM : mt_offH;
  off ? ( ui_cola(mk_sub, 0.5); mg_r(x0 + 8, 125, 196, 196); );
  mg_smkey(x0 + 148, 91, 20 + 2 * n, "S", 0xC88A16, 0xFFE08A);
  mg_smkey(x0 + 178, 91, 21 + 2 * n, "M", 0xD0461E, 0xFFC27E);
);

mn_vu_d = 0;
mg_pkv = mn_pk_d; mn_pk_d = 0;
mg_pkv > 0.891 ? mg_pkt = time_precise();
mg_nl = 20 * log10(max(mn_l_d, 0.00001)); mn_l_d = 0;
mg_nr = 20 * log10(max(mn_r_d, 0.00001)); mn_r_d = 0;
mg_lvl = max(mg_nl, mg_lvl - 0.6); mg_lvr = max(mg_nr, mg_lvr - 0.6);
mg_nl >= mg_hll ? ( mg_hll = mg_nl; mg_hlt = time_precise(); ) : time_precise() - mg_hlt > 1.2 ? mg_hll -= 0.6;
mg_nr >= mg_hrr ? ( mg_hrr = mg_nr; mg_hrt = time_precise(); ) : time_precise() - mg_hrt > 1.2 ? mg_hrr -= 0.6;
mt_gso = slider(20) >= 0.5 || slider(22) >= 0.5 || slider(24) >= 0.5;
mt_offL = mt_gso ? slider(20) < 0.5 : slider(21) >= 0.5;
mt_offM = mt_gso ? slider(22) < 0.5 : slider(23) >= 0.5;
mt_offH = mt_gso ? slider(24) < 0.5 : slider(25) >= 0.5;

