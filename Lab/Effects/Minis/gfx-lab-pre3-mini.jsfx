  k;
);
function mg_sqkey(x, y, idx, lbl, lc, lp) local(on, hov, s, b, dn) (
  on = slider(idx) >= 0.5; s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 0 : 1; ui_auto(idx); on = !on; dn = on ? 1.5 : 0; );
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(on ? 0x8A8C90 : 0x9C9EA2); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, 0.28); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, 0.35); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  lp ? ( gfx_setfont(11); ui_col(0x1A1A1C); mg_rtxt(x - 7, y + 11, lbl); )
     : ( gfx_setfont(13); ui_col(mk_ink2); mg_ctxt(x + 22, y - 10, lbl); );
);
function mg_tkey(x, y, w, on, lc, w1, w2) local(hov, hit, tw, th, cx, ax) (
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + 36) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_cola(0x000000, 0.25); mg_rr(x, y + 1.5, w + 4, 40, 4);
  ui_col(0x0E0F10); mg_rr(x - 2, y - 2, w + 4, 40, 4);
  ui_col(0x1A1B1D); mg_rr(x, y, w, 36, 3);
  ui_col(0x45484D); mg_rr(x, y, w - 1, 35, 3);
  ui_col(0x2C2E32); mg_rr(x + 1, y + 1, w - 2, 34, 3);
  ui_col(0x34363A); mg_rr(x + 1, y + 1, w - 2, 28, 3);
