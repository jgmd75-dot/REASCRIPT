desc:Pre3 Mini [preamp] (GFX Lab)
//tags: preamp drive saturation transformer console discrete transistor
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-clip, gfx-lab-os, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<0,2,1{West,Desk,Aero}>-Model
slider3:0<-12,15,0.1>-Drive (dB)
slider4:0<-24,24,0.1>-Output (dB)
slider5:0<0,5,1{OFF,30 Hz,50 Hz,80 Hz,120 Hz,180 Hz}>-HPF
slider6:1<0,1,1{Off,On}>-Auto gain
slider7:0<-24,12,0.1>-Input trim (dB)
slider8:1<0,1,1{Off,On}>-Input guard
slider9:50<0,100,1>-Drift (%)
slider10:0<0,2,1{1x,2x,4x}>-Oversampling
slider11:prs_sel=0<0,10,1{No preset,Init,West Vocal,West Bass Iron,West Drums,Desk Punch Drums,Desk Clean Gain,Desk Hot Bus,Aero Clean Lift,Aero Transient,Aero Hard Edge}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-pre3-mini";
ext_noinit = 1;

nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
p3_C   = alloc(8);
p3_THP = alloc(8);
p3_THP[0] = 0; p3_THP[1] = 30; p3_THP[2] = 50; p3_THP[3] = 80; p3_THP[4] = 120; p3_THP[5] = 180;
p3_TBL = alloc(16 * 6);
ost_init(0);

function p3_svf(v0, c) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = v0 - ic2;
  v1 = c[0] * ic1 + c[1] * v3;
  v2 = ic2 + c[1] * ic1 + c[2] * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  p3_hp = v0 - c[3] * v1 - v2;
  v2;
);
function p3_cset(c, f, k) local(g) (
  g = tan($pi * min(max(f, 5), 0.45 * srate) / srate);
  c[0] = 1 / (1 + g * (g + k)); c[1] = g * c[0]; c[2] = g * c[1]; c[3] = k;
);

function p3_res(v) instance(v1, ra1, rq1) local(ra, rq, dv, y) (
  ra = this.clp_ad(v) - 0.5 * v * v; rq = this.clp_crv(v) - v;
  dv = v - v1;
  y = abs(dv) > 0.00001 ? (ra - ra1) / dv : this.clp_crv(0.5 * (v + v1)) - 0.5 * (v + v1);
  y = v + y + 0.5 * (rq - rq1);
  v1 = v; ra1 = ra; rq1 = rq;
  y;
);
function p3_rres() instance(v1, ra1, rq1) ( ra1 = this.clp_ad(v1) - 0.5 * v1 * v1; rq1 = this.clp_crv(v1) - v1; );
function p3_zres() instance(v1, ra1, rq1) ( v1 = ra1 = rq1 = 0; );

function p3_eqset() instance(pre, post) (
  pre.bq_set(p3_et1, p3_ef1, 0.7, p3_eg1 * p3_w); post.bq_set(3, min(p3_ef2, 0.4 * srate), 0.7, p3_eg2 * p3_w);
);

function p3_model(m) instance(cv, ir, pre, post, pf) (
  m == 0 ? (
    cv.clp_set(1, 0.95, 0.80, 0); ir.clp_set(1, 0.45, 0.45, 0);
    p3_et1 = 2; p3_ef1 = 280; p3_eg1 = 1.5; p3_ef2 = 10000; p3_eg2 = -0.8;
    pf.clp_pf_cfg(0.45 * srate, 9000, -2, 120);
  ) : m == 1 ? (
    cv.clp_set(2, 1.10, 1.05, 0); cv.clp_knee(0.12);
    p3_et1 = 4; p3_ef1 = 80; p3_eg1 = 0.6; p3_ef2 = 10000; p3_eg2 = 0;
    pf.clp_pf_cfg(0.45 * srate, 12000, -1, 120);
  ) : (
    cv.clp_set(2, 1.60, 1.60, 0); cv.clp_knee(0.2);
    p3_et1 = 2; p3_ef1 = 280; p3_eg1 = 0; p3_ef2 = 16000; p3_eg2 = 0.4;
    pf.clp_pf_cfg(0.45 * srate, 16000, 0, 120);
  );
  cv.p3_zres(); ir.p3_zres(); pf.clp_pf_reset();
  pre.x1 = pre.x2 = pre.y1 = pre.y2 = 0; post.x1 = post.x2 = post.y1 = post.y2 = 0;
  this.p3_eqset();
  this.ilp = this.dx = this.dy = this.env = 0; this.hs.ic1 = this.hs.ic2 = 0;
);

function p3_pre(x) instance(pre, pf, hs) local(u) (
  u = x * p3_gin;
  p3_hpon ? ( hs.p3_svf(u, p3_C); u = p3_hp; );
  u = pre.bq_run(u);
  p3_pfw > 0 ? u += (pf.clp_pf_run(u) - u) * p3_pfw;
  u;
);
function p3_nl(u) instance(cv, ir, ilp, env, wb) local(b, a, s, y, lo) (
  a = abs(u); env += (a - env) * (a > env ? p3_sa : p3_srl);
  s = 1 - p3_sag * min(env / p3_cl, 1);
  u /= s;
  abs(u) > p3_kn ? p3_sat = 1;
  p3_mod == 0 ? (
    b = 0.06 + wb;
    y = u + p3_wc * (cv.p3_res(u + b) - cv.clp_crv(b) - u);
    ilp += (y - ilp) * p3_ilc; lo = ilp;
    y += p3_wc * (ir.p3_res(lo) - lo);
  ) : (
    b = wb;
    y = u + p3_wc * (cv.p3_res(u + b) - cv.clp_crv(b) - u);
  );
  y * s;
);
function p3_post(y) instance(post, dx, dy) local(d) (
  y = post.bq_run(y);
  y *= p3_mk;
  d = y; dy = d - dx + p3_dcd * dy; dx = d;
  dy;
);
function p3_tidy() instance(cv, ir, pre, post, hs, ilp, env, dx, dy) (
  abs(cv.v1) < 0.000000000001 ? cv.p3_zres(); abs(ir.v1) < 0.000000000001 ? ir.p3_zres();
  abs(pre.y1) < 0.0000000001 ? pre.x1 = pre.x2 = pre.y1 = pre.y2 = 0;
  abs(post.y1) < 0.0000000001 ? post.x1 = post.x2 = post.y1 = post.y2 = 0;
  abs(hs.ic1) < 0.0000000001 ? hs.ic1 = 0; abs(hs.ic2) < 0.0000000001 ? hs.ic2 = 0;
  abs(ilp) < 0.0000000001 ? ilp = 0; env < 0.0000000001 ? env = 0;
  abs(dy) < 0.0000000001 ? dx = dy = 0;
);
function p3_nlz() instance(cv, ir, ilp, env) ( cv.p3_zres(); ir.p3_zres(); ilp = env = 0; );

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(p3_ol, FZ_1); h1 = zA2.fz_bq(p3_or, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(p3_ol), abs(p3_or)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  p3_ol += g * e0; p3_or += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function p3_os(xl, xr) (
  p3_ol = cL.p3_nl(xl); p3_or = cR.p3_nl(xr);
  fz_o > 0.0001 ? fz_run();
);
function p3_rate() (
  p3_fs  = srate * os_f;
  p3_sa  = 1 - exp(-1 / (0.003 * p3_fs)); p3_srl = 1 - exp(-1 / (0.120 * p3_fs));
  p3_ilc = 1 - exp(-2 * $pi * 120 / p3_fs);
  fz_coefs(p3_fs);
);

function p3_srinit() (
  p3_sr  = srate;
  p3_dcd = 1 - 2 * $pi * 2 / srate;
  p3_psm = 1 - exp(-1 / (0.02 * srate));
  p3_mst = 1 / (0.015 * srate); p3_mhd = floor(0.010 * srate);
  p3_fis = 1 / (0.01 * srate);
  ost_init(0);
  in_init(); os_gsetup();
  p3_rate();
  cL.p3_model(p3_mod); cR.p3_model(p3_mod);
);

function p3_update() (
  p3_tmod = min(max(slider2 | 0, 0), 2);
  p3_tdrv = min(max(slider3, -12), 15);
  p3_tout = min(max(slider4, -24), 24);
  p3_hps  = min(max(slider5 | 0, 0), 5);
  p3_auto = slider6 >= 0.5;
  in_setup(slider7, slider8 >= 0.5);
  drift_macro(slider9);
  ost_setup(0, 0, 120, 6000, -0.3, 1);
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
);

function p3_reset() (
  cL.p3_model(p3_mod); cR.p3_model(p3_mod); fz_clr();
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  memset(BY_BUF, 0, 2 * BY_N);
  p3_fi = 0;
);

function p3_row(p, m, d, o, h, a) local(r) ( r = p3_TBL + p * 6; r[0] = m; r[1] = d; r[2] = o; r[3] = h; r[4] = a; );
p3_row(1,  0,    0,    0,   0,  1);
p3_row(2,  0,    5,    0,   3,  1);
p3_row(3,  0,    8,   -1,   1,  1);
p3_row(4,  0,   11,   -2,   2,  1);
p3_row(5,  1,    8,    0,   2,  1);
p3_row(6,  1,    4,    0,   3,  1);
p3_row(7,  1,   12,   -2,   1,  1);
p3_row(8,  2,    5,    0,   3,  1);
p3_row(9,  2,   10,    0,   2,  1);
p3_row(10, 2,   15,   -3,   1,  1);
#p3_pm = "Init|West Vocal|West Bass Iron|West Drums|Desk Punch Drums|Desk Clean Gain|Desk Hot Bus|Aero Clean Lift|Aero Transient|Aero Hard Edge";
function load_preset(p) local(r) (
  r = p3_TBL + max(1, min(10, p)) * 6;
  slider(2) = r[0]; slider(3) = r[1]; slider(4) = r[2]; slider(5) = r[3]; slider(6) = r[4];
  slider_automate(2 + 4 + 8 + 16 + 32);
);

dBL.drift_init(0.8 + rand(1) * 0.4); dBR.drift_init(0.8 + rand(1) * 0.4);
os_design();
os_f = os_tf = os_f2n(slider10); os_base = 0;
p3_update();
p3_mod = p3_tmod; p3_mg = 1; p3_mh = 0;
p3_srinit();
p3_drv = p3_tdrv; p3_out = p3_tout; p3_dint = max(p3_drv, 0); p3_w = p3_wc = min(max(p3_drv / 3, 0), 1);
p3_fh = p3_hps ? log(p3_THP[p3_hps]) : log(5); p3_hpon = p3_hps > 0;
p3a_sat = 0; fz_o = 0; p3_fi = 1;
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_bloom = 0.1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(10, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); p3_update();
      prs_q ? ( k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
p3_update();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != p3_sr ? p3_srinit();
p3_update();
p3_now = time_precise();
p3_tp > 0 && p3_now - p3_tp > max(0.25, 4 * samplesblock / srate) ? p3_reset();
p3_tp = p3_now;
pwr_block(slider1 < 0.5);
os_tf = os_f2n(slider10);
p3_bdt = samplesblock / srate;
p3_cl  = p3_mod == 0 ? 0.95 : p3_mod == 1 ? 1.10 : 1.60;
p3_kn  = p3_mod == 0 ? 0.25 : p3_mod == 1 ? 0.98 : 1.30;
p3_sag = dm_a * (p3_mod == 0 ? 0.10 : p3_mod == 1 ? 0.05 : 0.02);
p3_wa  = dm_a * (p3_mod == 0 ? 0.03 : p3_mod == 1 ? 0.012 : 0.004);
cL.wb = p3_wa * dBL.drift_tick(0.08 * dm_s * p3_bdt);
cR.wb = p3_wa * dBR.drift_tick(0.08 * dm_s * p3_bdt);
p3_dn = p3_dint / 15;
p3_w = min(max(p3_drv / 3, 0), 1);
cL.p3_eqset(); cR.p3_eqset();
cL.pf.clp_pf_block(p3_dn, srate, samplesblock); cR.pf.clp_pf_block(p3_dn, srate, samplesblock);
p3_mod == 2 ? ( p3_kw = 0.2 + 0.3 * p3_dn; cL.cv.clp_knee(p3_kw); cR.cv.clp_knee(p3_kw); cL.cv.p3_rres(); cR.cv.p3_rres(); );
p3_pfw = p3_mod == 0 ? min(max(p3_dint / 12, 0), 1) : p3_mod == 1 ? min(max((p3_dint - 12) / 12, 0), 1) : 0;
fz_t = (p3_mod == 0 ? 0.33 : p3_mod == 1 ? 0.25 : 0.16) * min(max((p3_drv - 8) / 7, 0), 1);
fz_o += (fz_t - fz_o) * (1 - exp(-p3_bdt / 0.03));  abs(fz_o - fz_t) < 0.000001 ? fz_o = fz_t;
p3_k = 1 - exp(-p3_bdt / 0.05); p3_fmin = log(5);
p3_th = p3_hps ? log(p3_THP[p3_hps]) : p3_fmin;
p3_hps && !p3_hpon ? ( p3_hpon = 1; p3_fh = p3_fmin; cL.hs.ic1 = cL.hs.ic2 = cR.hs.ic1 = cR.hs.ic2 = 0; );
p3_fh += (p3_th - p3_fh) * p3_k;
!p3_hps && p3_fh < p3_fmin + 0.02 ? p3_hpon = 0;
p3_cset(p3_C, exp(p3_fh), 1.41421356);
cL.p3_tidy(); cR.p3_tidy();
p3a_sat = p3_sat ? 0.08 : max(p3a_sat - p3_bdt, 0); p3_sat = 0;
p3_sat_d = p3a_sat > 0;
p3_vu_d = max(p3_vu_d, sqrt(p3_ms / max(samplesblock, 1))); p3_ms = 0;
p3_pk_d = max(p3_pk_d, p3_pkm); p3_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
p3_il = in_l; p3_ir = in_r;
p3_drv += (p3_tdrv - p3_drv) * p3_psm; p3_out += (p3_tout - p3_out) * p3_psm;
p3_dint = max(p3_drv, 0);
p3_wc = min(max(p3_drv / 3, 0), 1);
p3_gin = exp((p3_dint + min(p3_drv, 0)) * 0.115129255);
p3_mod != p3_tmod ? (
  p3_mg -= p3_mst;
  p3_mg <= 0 ? ( p3_mg = 0; p3_mod = p3_tmod; cL.p3_model(p3_mod); cR.p3_model(p3_mod); p3_mh = p3_mhd; );
) : p3_mh > 0 ? p3_mh -= 1 : p3_mg < 1 ? p3_mg = min(p3_mg + p3_mst, 1);
p3_mk = exp(((p3_auto ? -p3_dint : 0) + p3_out) * 0.115129255) * p3_mg * p3_mg * (3 - 2 * p3_mg);
l = cL.p3_pre(p3_il); r = cR.p3_pre(p3_ir);
pwr_in(l, r); l = pwr_l; r = pwr_r;
os_gate();
os_chg ? ( p3_rate(); cL.p3_nlz(); cR.p3_nlz(); fz_clr(); );
uxL.os_up(l); uxR.os_up(r);
os_f == 1 ? (
  p3_os(uxL.s0, uxR.s0); l = p3_ol; r = p3_or;
) : (
  p3_os(uxL.s0, uxR.s0); p3_a0 = p3_ol; p3_b0 = p3_or;
  p3_os(uxL.s1, uxR.s1); p3_a1 = p3_ol; p3_b1 = p3_or;
  os_f == 2 ? ( l = dnL.os_dn(p3_a0, p3_a1, 0, 0); r = dnR.os_dn(p3_b0, p3_b1, 0, 0); ) : (
    p3_os(uxL.s2, uxR.s2); p3_a2 = p3_ol; p3_b2 = p3_or;
    p3_os(uxL.s3, uxR.s3); p3_a3 = p3_ol; p3_b3 = p3_or;
    l = dnL.os_dn(p3_a0, p3_a1, p3_a2, p3_a3); r = dnR.os_dn(p3_b0, p3_b1, p3_b2, p3_b3);
  );
);
pwr_out(l, r); l = pwr_l; r = pwr_r;
l = cL.p3_post(l); r = cR.p3_post(r);
p3_osg = os_g * os_g * (3 - 2 * os_g);
ost_out(l * p3_osg, r * p3_osg);
l = ost_l; r = ost_r;
l != l ? l = 0; r != r ? r = 0;
p3_fi < 1 ? (
  p3_fi = min(p3_fi + p3_fis, 1); p3_z = p3_fi * p3_fi * (3 - 2 * p3_fi);
  p3_da = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; p3_db = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  l = p3_da + (l - p3_da) * p3_z; r = p3_db + (r - p3_db) * p3_z;
);
spl0 = l; spl1 = r;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
by_out();
p3_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);
p3_pkm = max(p3_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x6B4630; mk_band = 0x1E140C; mk_ink = 0xF3E8D2; mk_acc = 0xD9B25C; mk_tab = 0xD9B25C;
mk_sub = 0x301F15; mk_hot = 0xFFD27A;
mk_ink2 = ui_mix(mk_ink, mk_face, 0.35);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, mk_sub, 0.5);
  ui_col(ui_mix(mk_face, 0x000000, 0.16)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.06)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.30)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.16)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.08)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.12)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.20)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(mk_sub, 0x000000, 0.3)); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0x1A1A1C); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0xF4F6F8); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(0x1A1A1C); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_well(x, y, w, h) ( ui_cola(0x000000, 0.18); mg_r(x, y, w, h); ui_cola(0x000000, 0.12); mg_r(x, y, w, 2); mg_r(x, y + 2, 2, h - 2); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KR, i, t) (
  KX = x * sc; KY = y * sc; KR = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KR, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KR * 0.8, KY - cos(t) * KR * 0.8, KX + sin(t) * KR * 0.95, KY - cos(t) * KR * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KR * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KR * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KR * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KR * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KR * 0.72);
  ) : (
    ui_col(0x2C2E33); gfx_circle(KX, KY, KR, 1, 1);
    ui_col(0x121315); gfx_circle(KX, KY, KR * 0.8, 1, 1);
    ui_col(ui_mix(0x2C2E33, 0x000000, 0.25)); gfx_circle(KX, KY, KR * 0.68, 1, 1);
    ui_cola(0xFFFFFF, act ? 0.22 : 0.12); ui_ssarc(KX, KY, KR * 0.95, -2.6 + 0.5 * $pi, -1.0 + 0.5 * $pi, 1 * sc);
    ui_col(0xECE6DA); ui_kdot(KX, KY, a, KR * 0.68);
  );
);
function mg_dots(x, y, r, c) local(i, t, rs) (
  rs = r + 8; i = 0;
  loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi; ui_col(c); mg_disc(x + sin(t) * rs, y - cos(t) * rs, i == 0 || i == 4 ? 1.8 : 1.3); i += 1; );
);
function mg_v2n(v, lo, hi, pw) ( pw ? ( v < 0 ? 0.5 * (v - lo) / -lo : 0.5 + 0.5 * v / hi ) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, pw) ( pw ? ( n < 0.5 ? lo + 2 * n * -lo : (n - 0.5) * 2 * hi ) : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, sty, col) local(v, n, dx, dy, hov, did, act, a, lg, q, t, i, rs, pw) (
  lg = mg_klog; q = mg_kq; pw = mg_kpw; mg_klog = 0; mg_kq = 0; mg_kpw = 0;
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx;
      mgk_n = lg ? log(max(v, lo) / lo) / log(hi / lo) : mg_v2n(v, lo, hi, pw); mgk_n = min(max(mgk_n, 0), 1);
    );
  );
