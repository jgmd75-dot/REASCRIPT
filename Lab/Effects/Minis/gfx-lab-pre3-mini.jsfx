      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = lg ? lo * exp(mgk_n * log(hi / lo)) : mg_n2v(mgk_n, lo, hi, pw);
      (mg_kstep || mg_kint) ? v = floor(v + 0.5) : q > 0 && !(mouse_cap & 8) ? v = floor(v / q + 0.5) * q : lg ? v = floor(v + 0.5) : v = floor(v * 100 + 0.5) / 100;
      v = min(max(v, lo), hi);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    (mg_kstep || mg_kint) ? slider(idx) = min(max(floor(v + 0.5) + (mouse_wheel > 0 ? 1 : -1), lo), hi) :
    q > 0 && !(mouse_cap & 8) ? slider(idx) = min(max(floor(v / q + 0.5) * q + (mouse_wheel > 0 ? q : -q), lo), hi) : (
      n = lg ? log(max(v, lo) / lo) / log(hi / lo) : mg_v2n(v, lo, hi, pw);
      n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
      slider(idx) = lg ? floor(lo * exp(n * log(hi / lo)) + 0.5) : mg_n2v(n, lo, hi, pw); );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = lg ? log(max(v, lo) / lo) / log(hi / lo) : mg_v2n(v, lo, hi, pw); n = min(max(n, 0), 1);
