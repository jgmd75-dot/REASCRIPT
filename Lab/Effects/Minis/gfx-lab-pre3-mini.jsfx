function mg_step3(cx, cy, r, ly, idx, def, col, name, t0, t1, t2) local(k, v, i, t, rs, tw, th) (
  rs = r + 8; i = 0; gfx_setfont(11);
  loop(3, t = -0.5 * $pi + i * 0.5 * $pi; ui_col(mk_ink2); mg_disc(cx + sin(t) * rs, cy - cos(t) * rs, 1.8);
    gfx_measurestr(i == 0 ? t0 : i == 1 ? t1 : t2, tw, th); tw /= sc;
    mg_ctxt(cx + sin(t) * rs + (i == 0 ? -(tw * 0.5 + 6) : i == 2 ? tw * 0.5 + 6 : 0), cy - cos(t) * rs + (i == 1 ? -11 : 0), i == 0 ? t0 : i == 1 ? t1 : t2); i += 1; );
  mg_kstep = 1; k = mg_knob(cx, cy, r, idx, 0, 2, def, 1, col); mg_kstep = 0;
  v = slider(idx);
