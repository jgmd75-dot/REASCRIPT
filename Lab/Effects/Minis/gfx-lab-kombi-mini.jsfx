mode_t != era ? ( fade = max(0, fade - fstep);  fade == 0 ? ( set_era(mode_t);  drv_upd();  eq_set();  cmp_set();  lim_set();  chL.ch_clear();  chR.ch_clear(); ); ) : fade < 1 ? ( fade = min(1, fade + fstep); );
xL = spl0;  xR = spl1;
inpk = max(inpk, max(abs(xL), abs(xR)));

trn > 0 ? (
