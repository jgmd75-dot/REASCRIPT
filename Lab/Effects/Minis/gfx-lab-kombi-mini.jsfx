);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;
pdc_delay = max(8, floor(0.0015 * srate + 0.5)) + 8 + os_lat(os_f2n(os_sl));  pdc_bot_ch = 0;  pdc_top_ch = 2;
