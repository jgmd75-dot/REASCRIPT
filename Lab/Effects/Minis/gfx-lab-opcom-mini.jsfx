desc:OPCOM Mini [compressor] (GFX Lab)
//tags: compressor opto optical program-dependent sidechain parallel saturation transformer stereo mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:trim_db=0<-24,12,0.1>-Trim (dB)
slider3:iron=1<0,1,1{Off,On}>-Iron
slider4:sc_hpf=0<0,330,1>-Sidechain HPF (Hz, below 20 = off)
slider5:cmp_in=1<0,1,1{Out,In}>-Comp
slider6:thr_db=-10<-50,20,0.1>-Threshold (dB re 0 VU)
slider7:ratio=4<1.5,20,0.01>-Ratio (x:1)
slider8:speed=2<0,2,1{Fast,Slow,Auto}>-Speed
slider9:mix_pc=100<0,100,1>-Mix (%)
slider10:sc_mode=0<0,3,1{Off,Low-pass,High-pass,Mid}>-Sidechain filter
slider11:sc_freq=2200<110,9900,1>-Sidechain filter frequency (Hz)
slider12:hi_q=0<0,1,1{Off,On}>-Sidechain filter high Q
slider13:sat_pc=0<0,100,1>-Saturation (%)
slider14:out_db=0<-24,12,0.1>-Output (dB)
slider15:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider16:prs_sel=0<0,9,1{No preset,Init,Gentle Vocal,Upfront Vocal,Bass Even,Drum Smash,Mix Glue,Acoustic Guitar,Sibilance Tamer,Kick Through}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-opcom-mini";
ext_noinit = 1;

function oq_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function oq_db(d) ( exp(d * 0.11512925464970228); );
function oq_tc(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );

function oq_hpset(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function oq_hprun(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = oq_tn(y1); y1 = y;
  y;
);
function oq_hpclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function oq_svf(x) instance(s1, s2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - s2; v1 = oq_a1 * s1 + oq_a2 * v3; v2 = s2 + oq_a2 * s1 + oq_a3 * v3;
  s1 = oq_tn(2 * v1 - s1); s2 = oq_tn(2 * v2 - s2);
  lp = v2; bp = v1; hp = x - oq_k * v1 - v2;
  oq_wn * x + oq_wl * lp + oq_wh * hp + oq_wb * oq_k * bp;
);
function oq_svclr() instance(s1, s2) ( s1 = s2 = 0; );
function oq_svcoef() local(g) (
  g = tan($pi * min(oq_fs_s, srate * 0.45) / srate);
  oq_k = 1 / oq_q_s;
  oq_a1 = 1 / (1 + g * (g + oq_k)); oq_a2 = g * oq_a1; oq_a3 = g * oq_a2;
);

function oq_ic(t) ( t = max(-1.5, min(1.5, t)); t * (1 - 0.14814814814814814 * t * t); );
function oq_iron(x) instance(lf) local(u, y) (
  lf += oq_ilk * (x - lf);
  u = x + 0.8 * lf;
  y = 0.7 * (oq_ic(u / 0.7 + 0.06) - oq_ic0) - 0.8 * lf;
  x + oq_io_s * (y - x);
);
function oq_ironclr() instance(lf) ( lf = 0; );

function oq_satf(u) ( u >= 0 ? u / (1 + 0.45 * u) : u / (1 - 0.3 * u); );
function oq_sat(x) ( x + oq_sw * (oq_satf(oq_sd * x) / oq_sd - x); );

function oq_rate() (
  oq_sr = srate;
  oq_rms = oq_tc(4);
  oq_kn = oq_tc(30); oq_ksw = oq_tc(15);
  oq_slow_a = oq_tc(350); oq_slow_r = oq_tc(3000);
  oq_dcc = 1 - 2 * $pi * 5 / srate; oq_idc = 1 - 2 * $pi / srate;
  oq_rsc = 1 / (0.015 * srate);
);
function oq_fsc() ( oq_ilk = 1 - exp(-2 * $pi * 150 / (srate * os_f)); );
function oq_osclr() ( IRL.oq_ironclr(); IRR.oq_ironclr(); );

function oq_params() (
  oq_thr = min(max(thr_db, -50), 20) - 18;
  oq_slope = 1 - 1 / min(max(ratio, 1.5), 20);
  oq_sp = speed | 0;
  oq_at_t = oq_sp == 0 ? oq_tc(0.8) : oq_sp == 1 ? oq_tc(30) : oq_tc(10);
  oq_rl_t = oq_sp == 0 ? oq_tc(80) : oq_sp == 1 ? oq_tc(600) : oq_tc(60);
  oq_au_t = oq_sp == 2;
  oq_hp_on = sc_hpf >= 20;
  oq_hp_on && sc_hpf != oq_hp_last ? ( oq_hp_last = sc_hpf; HPL.oq_hpset(sc_hpf); HPR.oq_hpset(sc_hpf); );
  oq_md = sc_mode | 0;
  oq_wn_t = oq_md == 0; oq_wl_t = oq_md == 1; oq_wh_t = oq_md == 2; oq_wb_t = oq_md == 3;
  oq_fs_t = min(max(sc_freq, 110), 9900); oq_q_t = hi_q >= 0.5 ? 3 : 0.707;
  oq_mix_t = min(max(mix_pc, 0), 100) / 100;
  oq_trim_t = oq_db(min(max(trim_db, -24), 12));
  oq_out_t = oq_db(min(max(out_db, -24), 12));
  oq_sat_t = min(max(sat_pc, 0), 100) / 100;
  os_tf = os_f2n(os_sl);
);
function oq_snapv() (
  oq_at = oq_at_t; oq_rl = oq_rl_t; oq_au = oq_au_t;
  oq_wn = oq_wn_t; oq_wl = oq_wl_t; oq_wh = oq_wh_t; oq_wb = oq_wb_t;
  oq_fs_s = oq_fs_t; oq_q_s = oq_q_t; oq_svcoef();
  oq_mix_s = oq_mix_t; oq_trim_s = oq_trim_t; oq_out_s = oq_out_t; oq_sat_s = oq_sat_t;
  oq_io_s = iron >= 0.5; oq_in_s = cmp_in >= 0.5;
);
function oq_reset() (
  OSU.os_clr(); OSD.os_clr(); OSUB.os_clr(); OSDB.os_clr(); oq_osclr();
  HPL.oq_hpclr(); HPR.oq_hpclr(); SVL.oq_svclr(); SVR.oq_svclr();
  oq_ms = 0; oq_e = 0; oq_es = 0; oq_g0 = 1;
  oq_ixl = oq_iyl = oq_ixr = oq_iyr = 0; oq_dxl = oq_dyl = oq_dxr = oq_dyr = 0;
  memset(BY_BUF, 0, 2 * BY_N);
  oq_rsf = 0;
);

oq_rate();
oq_params();
os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
ost_init(0);
ost_setup(0, 0, 200, 4000, -0.3, 1);
os_gsetup();
oq_hp_last = -1; oq_params();
oq_snapv(); oq_fsc();
oq_ic0 = oq_ic(0.06);
oq_reset(); oq_rsf = 1;
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.1; pwr_wu_loss = 0.3; pwr_wu_drv = 0.6; pwr_wu_lp = 13000; pwr_wu_wob = 0.1; pwr_bloom = 0;
oq_snap = 1; oq_blk = 0;
pdc_delay = os_lat(os_f);
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
oq_gr_d = 0; oq_il_d = oq_ir_d = 0; oq_pil = oq_pir = 0;

function oq_set(t, r, s, m, hp, md, f, q, ir, st, o) (
  thr_db = t; ratio = r; speed = s; mix_pc = m; sc_hpf = hp; sc_mode = md; sc_freq = f; hi_q = q; iron = ir; sat_pc = st; out_db = o;
  trim_db = 0; cmp_in = 1;
);
function load_preset(p) local(i) (
  p == 2 ? oq_set(-12, 2.5, 2, 100, 88,  0, 2200, 0, 1, 15, 2) :
  p == 3 ? oq_set(-20, 6,   0, 100, 110, 0, 2200, 0, 1, 30, 4) :
  p == 4 ? oq_set(-16, 4,   1, 100, 0,   1, 330,  0, 1, 20, 3) :
  p == 5 ? oq_set(-30, 20,  0, 40,  110, 0, 2200, 0, 1, 45, 2) :
  p == 6 ? oq_set(-6,  1.5, 2, 100, 88,  0, 2200, 0, 1, 10, 1) :
  p == 7 ? oq_set(-14, 3,   2, 100, 110, 3, 990,  0, 0, 0,  2) :
  p == 8 ? oq_set(-24, 8,   0, 100, 0,   2, 5500, 1, 0, 0,  0) :
  p == 9 ? oq_set(-18, 4,   1, 100, 220, 0, 2200, 0, 1, 15, 2) :
  oq_set(-10, 4, 2, 100, 0, 0, 2200, 0, 1, 0, 0);
  p == 10 ? os_sl = 1;
  i = 2; loop(13, ui_auto(i); i += 1; ); p == 10 ? ui_auto(15);
  pr_cur = p == 10 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(15, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 9 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
oq_params();
os_snap(os_sl);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && oq_blk < 40 ? oq_snap = 1;
pwr_ser();

@block
prs_chk();
oq_blk < 40 ? oq_blk += 1;
srate != oq_sr ? ( oq_rate(); oq_fsc(); oq_hp_last = -1; oq_reset(); );
oq_params();
pwr_block(byp < 0.5);
oq_now = time_precise();
oq_tp > 0 && oq_now - oq_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > oq_gpp && play_position - oq_gpp < 4 * oq_gpd + 0.05) ? oq_reset();
oq_tp = oq_now; oq_gpp = play_position; oq_gpd = samplesblock / srate;
pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
oq_snap ? ( oq_snap = 0; oq_snapv(); );
oq_bs = 1 - exp(-samplesblock / (0.03 * srate));
oq_fs_s *= exp((log(oq_fs_t) - log(oq_fs_s)) * oq_bs);
oq_q_s += (oq_q_t - oq_q_s) * oq_bs;
oq_svcoef();
oq_gr_d = max(oq_gr_d, oq_grm); oq_grm = 0;
oq_il_d = max(oq_il_d, oq_pil); oq_ir_d = max(oq_ir_d, oq_pir); oq_pil = oq_pir = 0;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(os_sl);

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
oq_trim_s += (oq_trim_t - oq_trim_s) * oq_kn; oq_out_s += (oq_out_t - oq_out_s) * oq_kn;
oq_mix_s += (oq_mix_t - oq_mix_s) * oq_kn; oq_sat_s += (oq_sat_t - oq_sat_s) * oq_kn;
oq_io_s += ((iron >= 0.5) - oq_io_s) * oq_ksw; oq_in_s += ((cmp_in >= 0.5) - oq_in_s) * oq_ksw;
oq_at += (oq_at_t - oq_at) * oq_ksw; oq_rl += (oq_rl_t - oq_rl) * oq_ksw; oq_au += (oq_au_t - oq_au) * oq_ksw;
oq_wn += (oq_wn_t - oq_wn) * oq_ksw; oq_wl += (oq_wl_t - oq_wl) * oq_ksw; oq_wh += (oq_wh_t - oq_wh) * oq_ksw; oq_wb += (oq_wb_t - oq_wb) * oq_ksw;
oq_sd = 1 + 7 * oq_sat_s * oq_sat_s; oq_sw = min(1, 3 * oq_sat_s);

x = spl0 - oq_ixl + oq_idc * oq_iyl; oq_ixl = spl0; oq_iyl = oq_tn(x);
xb = spl1 - oq_ixr + oq_idc * oq_iyr; oq_ixr = spl1; oq_iyr = oq_tn(xb);
x *= oq_trim_s; xb *= oq_trim_s;
oq_pil = max(oq_pil, abs(x)); oq_pir = max(oq_pir, abs(xb));

oq_cl = x; oq_cr = xb;
oq_hp_on ? ( oq_cl = HPL.oq_hprun(oq_cl); oq_cr = HPR.oq_hprun(oq_cr); );
oq_cl = SVL.oq_svf(oq_cl); oq_cr = SVR.oq_svf(oq_cr);
oq_ms += oq_rms * (0.5 * (oq_cl * oq_cl + oq_cr * oq_cr) - oq_ms); oq_ms = oq_tn(oq_ms);
oq_lv = 10 * log10(oq_ms + 0.0000000001) + 3;
oq_o = oq_lv - oq_thr;
oq_gt = oq_o <= -3 ? 0 : oq_o >= 3 ? oq_o * oq_slope : oq_slope * sqr(oq_o + 3) / 12;
oq_e += (oq_gt - oq_e) * (oq_gt > oq_e ? oq_at : oq_rl);
oq_es += (oq_e - oq_es) * (oq_e > oq_es ? oq_slow_a : oq_slow_r);
oq_gr = max(oq_e, 0.5 * oq_au * oq_es) * oq_in_s;
oq_grm = max(oq_grm, oq_gr);
oq_g1 = 1 + oq_mix_s * (oq_db(-oq_gr) - 1);

pwr_in(x, xb); x = pwr_l; xb = pwr_r;
os_gate();
os_chg ? ( oq_fsc(); oq_osclr(); );
OSU.os_up(x); OSUB.os_up(xb);
os_f == 1 ? (
  y = oq_sat(IRL.oq_iron(OSU.s0) * oq_g1); yb = oq_sat(IRR.oq_iron(OSUB.s0) * oq_g1);
) : os_f == 2 ? (
  oq_gm = 0.5 * (oq_g0 + oq_g1);
  a0 = oq_sat(IRL.oq_iron(OSU.s0) * oq_gm); a1 = oq_sat(IRL.oq_iron(OSU.s1) * oq_g1);
  b0 = oq_sat(IRR.oq_iron(OSUB.s0) * oq_gm); b1 = oq_sat(IRR.oq_iron(OSUB.s1) * oq_g1);
  y = OSD.os_dn(a0, a1, 0, 0); yb = OSDB.os_dn(b0, b1, 0, 0);
) : (
  oq_gd = oq_g1 - oq_g0;
  a0 = oq_sat(IRL.oq_iron(OSU.s0) * (oq_g0 + 0.25 * oq_gd)); a1 = oq_sat(IRL.oq_iron(OSU.s1) * (oq_g0 + 0.5 * oq_gd));
  a2 = oq_sat(IRL.oq_iron(OSU.s2) * (oq_g0 + 0.75 * oq_gd)); a3 = oq_sat(IRL.oq_iron(OSU.s3) * oq_g1);
  b0 = oq_sat(IRR.oq_iron(OSUB.s0) * (oq_g0 + 0.25 * oq_gd)); b1 = oq_sat(IRR.oq_iron(OSUB.s1) * (oq_g0 + 0.5 * oq_gd));
  b2 = oq_sat(IRR.oq_iron(OSUB.s2) * (oq_g0 + 0.75 * oq_gd)); b3 = oq_sat(IRR.oq_iron(OSUB.s3) * oq_g1);
  y = OSD.os_dn(a0, a1, a2, a3); yb = OSDB.os_dn(b0, b1, b2, b3);
);
oq_g0 = oq_g1;
oq_t = y - oq_dxl + oq_dcc * oq_dyl; oq_dxl = y; oq_dyl = oq_tn(oq_t); y = oq_dyl;
oq_t = yb - oq_dxr + oq_dcc * oq_dyr; oq_dxr = yb; oq_dyr = oq_tn(oq_t); yb = oq_dyr;
pwr_out(y, yb);
ost_out(pwr_l * oq_out_s, pwr_r * oq_out_s);
oa = ost_l; ob = ost_r;
os_q = os_g * os_g * (3 - 2 * os_g); oa *= os_q; ob *= os_q;
oa != oa ? oa = 0; ob != ob ? ob = 0;
oq_rsf < 1 ? (
  oq_rsf = min(oq_rsf + oq_rsc, 1); oq_rq = oq_rsf * oq_rsf * (3 - 2 * oq_rsf);
  pdc_delay > 0 ? ( oq_rdl = BY_BUF[(by_w - pdc_delay) & (BY_N - 1)]; oq_rdr = BY_BUF[BY_N + ((by_w - pdc_delay) & (BY_N - 1))]; )
                : ( oq_rdl = spl0; oq_rdr = spl1; );
  oa = oq_rdl + (oa - oq_rdl) * oq_rq; ob = oq_rdr + (ob - oq_rdr) * oq_rq;
);
spl0 = max(-4, min(4, oa));
spl1 = max(-4, min(4, ob));
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 420
ui_begin(900, 420);
mk_face = 0xF0F1EC; mk_plate = 0x1E2023; mk_band = 0x6A2E32; mk_acc = 0xE0A060; mk_ink = 0xEDE6D3; mk_ink2 = 0xB8B6B0;
mk_val = 0xFFC27E; mk_scale = 0xC8CDD3; mk_fig = 0x9AA0A8;
mk_sub = ui_mix(mk_face, 0x000000, 0.62); mk_sub2 = ui_mix(mk_face, 0x000000, 0.72);
mk_ft = ui_mix(mk_face, 0xFFFFFF, 0.22); mk_fb = ui_mix(mk_face, 0x000000, 0.22);
ui_vu_dim = byp >= 0.5;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 18 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
  mg_f3 = ui_fitarial(3, 14 * sc);
  mg_f16 = ui_fitarial(16, 18 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(3, "Arial", mg_f3, 'b');
gfx_setfont(16, "Arial", mg_f16, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
