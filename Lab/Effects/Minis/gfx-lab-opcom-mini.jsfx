  ui_col(mk_sub2); mg_r(x + 2, y + 2, w - 3, h - 3);
  ui_cola(0x000000, 0.35); mg_r(x + 2, y + 2, w - 3, 2); mg_r(x + 2, y + 4, 2, h - 5);
  ui_cola(0xFFFFFF, 0.22); mg_r(x, y + h, w + 1, 1); mg_r(x + w, y, 1, h);
);
function mg_grrow(x, y, gv) local(i, d, c, cx, on) (
  i = 0;
  loop(8,
    d = i == 0 ? 1 : i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 5 : i == 4 ? 7 : i == 5 ? 10 : i == 6 ? 14 : 20;
    c = d <= 3 ? 0x3CE05A : d <= 10 ? 0xFFC81E : 0xFF3A2A;
    cx = x + 15 + i * 30; on = gv >= d;
    gfx_setfont(11); ui_col(mk_ink2); sprintf(#mgg, "%d", d); mg_ctxt(cx, y + 8, #mgg);
    on ? ( ui_cola(c, 0.2); mg_disc(cx, y + 28, 10); );
    ui_col(0x050506); mg_disc(cx, y + 28, 8);
    ui_col(on ? c : ui_mix(c, 0x101214, 0.78)); mg_disc(cx, y + 28, 6);
    ui_cola(0xFFFFFF, on ? 0.55 : 0.12); mg_disc(cx - 2, y + 26, 2);
    i += 1;
  );
);

