@block
prs_chk();
srate != pc_sr ? ( pc_sr = srate; ost_init(0); ins_srinit(); rv_alloc(); );
pc_now = time_precise();
pc_tp > 0 && pc_now - pc_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > pc_gpp && play_position - pc_gpp < 4 * pc_gpd + 0.05) ? (
  ins_clear(); rv_alloc(); RV_S[0] = RV_S[1] = RV_S[2] = RV_S[3] = 0; rv_wl = rv_wr_ = 0; pc_was = 0;
);
pc_tp = pc_now; pc_gpp = play_position; pc_gpd = samplesblock / srate;
panic_dirty ? ( panic_dirty = 0; ins_clear(); memset(RV_B, 0, 16 * rv_n); RV_S[0] = RV_S[1] = RV_S[2] = RV_S[3] = 0; rv_wl = rv_wr_ = 0; );
pwr_block(1);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
drift_macro(slider7);
pc_n = samplesblock / srate;
pc_vt = drT.drift_tick(0.05 * dm_s * pc_n); pc_vp = drP.drift_tick(0.06 * dm_s * pc_n); pc_vs = drS.drift_tick(0.06 * dm_s * pc_n);
pc_poff = 0.006 * dm_a * (0.5 + 0.5 * pc_vp);
pc_pstr = 1 + 0.08 * dm_a * pc_vs;
pc_k = 0; loop(NV, TUN[pc_k] = 2 ^ (0.0045 * dm_a * pc_vt * (pc_k & 1 ? -1 : 1) * (1 + 0.15 * pc_k) / 12); pc_k += 1; );
pc_sl = pc_div(floor(min(max(slider1, 0), 4) + 0.5));
pc_sw = min(max(slider2, 0), 75) / 100; pc_hu = min(max(slider3, 0), 100) / 100; pc_acc = min(max(slider4, 0), 10);
pc_free = slider5 >= 0.5;
pc_play = play_state & 1;
pc_run = pc_play || pc_free;
pc_inc = tempo / (60 * srate);
pc_play ? (
  (!pc_was || !pc_wpl || abs(beat_position - pc_pos) > 0.05 || pc_sl != pc_slw || pc_sw != pc_sww) ? ( pc_pos = beat_position; pc_resync(); ) : pc_pos = beat_position;
) : pc_free ? (
  (!pc_was || pc_wpl || pc_sl != pc_slw || pc_sw != pc_sww) ? ( pc_wpl ? pc_pos = 0; pc_resync(); );
);
pc_was = pc_run; pc_wpl = pc_play; pc_slw = pc_sl; pc_sww = pc_sw;
pc_mq = 0; pc_mi = 0; pc_si = 0;
while(
  midirecv(pc_ofs, pc_m1, pc_m2, pc_m3) ? (
    (pc_m1 & 0xF0) == 0x90 && pc_m3 > 0 && pc_mq < 60 ? (
      pc_ln = ins_note(pc_m2); dm_mt = time_precise();
      pc_ln >= 0 ? ( MQ[pc_mq * 4] = pc_ofs; MQ[pc_mq * 4 + 1] = pc_ln; MQ[pc_mq * 4 + 2] = pc_m3 / 127; MQ[pc_mq * 4 + 3] = pc_mute; pc_mq += 1; );
    );
    (pc_m1 & 0xF0) == 0xB0 && (pc_m2 == 120 || pc_m2 == 123) ? ins_clear();
    midisend(pc_ofs, pc_m1, pc_m2, pc_m3);
    1;
  );
);
pc_k = 0; loop(NV, pc_ln = LV[pc_k];
  pc_lt = 10 ^ (min(max(slider(16 + pc_ln), -24), 6) / 20);
  pc_p = min(max(slider(23 + pc_ln) + (pc_k == 3 || pc_k == 5 ? 5 : pc_k == 4 || pc_k == 6 ? -5 : 0), -100), 100) / 100;
  pc_p = (pc_p + 1) * $pi / 4;
  GLT[pc_k] = pc_lt * cos(pc_p); GRT[pc_k] = pc_lt * sin(pc_p); pc_k += 1; );
pc_mst = 10 ^ (min(max(slider6, -24), 6) / 20);
ins_block();
md_tidy();
pc_sleep();
rv_setup();
pc_vu_d = max(pc_vu_d, sqrt(pc_msq / max(samplesblock, 1))); pc_msq = 0;
pc_pk_d = max(pc_pk_d, pc_pkm); pc_pkm = 0;

@sample
spl0 = spl1 = 0;
pc_run ? (
  pc_pos >= pc_tnx ? ( pc_fire(pc_nx); pc_nx += 1; pc_tnx = pc_t(pc_nx) + pc_hoff(); );
  pc_pos += pc_inc;
);
pc_mi < pc_mq && MQ[pc_mi * 4] <= pc_si ? ( pc_mute = MQ[pc_mi * 4 + 3]; pc_hit(MQ[pc_mi * 4 + 1], MQ[pc_mi * 4 + 2], MQ[pc_mi * 4 + 2] > 0.85); pc_mute = 0; pc_mi += 1; );
pc_mi < pc_mq && MQ[pc_mi * 4] <= pc_si ? ( pc_mute = MQ[pc_mi * 4 + 3]; pc_hit(MQ[pc_mi * 4 + 1], MQ[pc_mi * 4 + 2], MQ[pc_mi * 4 + 2] > 0.85); pc_mute = 0; pc_mi += 1; );
aud_dirty > 0 ? ( pc_hit(aud_dirty - 1, 0.85, 0); aud_dirty = 0; );
pc_si += 1;
pc_k = 0; loop(NV, OUT[pc_k] = 0; pc_k += 1; );
ins_sample();
md_run();
pc_k = 0; pc_yl = pc_yr = 0;
loop(NV,
  GL[pc_k] += (GLT[pc_k] - GL[pc_k]) * 0.002; GR[pc_k] += (GRT[pc_k] - GR[pc_k]) * 0.002;
  pc_yl += OUT[pc_k] * GL[pc_k]; pc_yr += OUT[pc_k] * GR[pc_k]; pc_k += 1;
);
pc_ms += (pc_mst - pc_ms) * 0.002;
pc_yl *= pc_ms; pc_yr *= pc_ms;
rv_g += (rv_gt - rv_g) * rv_kg;
rv_run(pc_yl, pc_yr); pc_yl += rv_wl * rv_g * rv_kn; pc_yr += rv_wr_ * rv_g * rv_kn;
pc_yl != pc_yl ? pc_yl = 0; pc_yr != pc_yr ? pc_yr = 0;
pwr_in(pc_yl, pc_yr); pc_yl = pwr_l; pc_yr = pwr_r;
pwr_out(pc_yl, pc_yr); pc_yl = pwr_l; pc_yr = pwr_r;
ost_out(pc_yl, pc_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
pc_msq += 0.5 * (spl0 * spl0 + spl1 * spl1);
pc_pkm = max(pc_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(ink, 1); gfx_measurestr("DRIFT", tw, th);
  gfx_x = dk_ox + cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr("DRIFT");
);
function dm_mlit() ( time_precise() - dm_mt < 0.12; );
ui_begin(900, 355);
mk_face = 0x2E2F31; mk_band = 0x141416; mk_acc = 0xE0B64A; mk_acc2 = 0xC27A5A; mk_acc3 = 0xD8C08A;
mk_ink = 0xF5EAD0; mk_ink2 = 0xC7BEB3; mk_val = 0xFFD24A; mk_scale = 0xC9BFAE;
mk_sub = 0x202123; mk_sub2 = ui_mix(mk_face, 0x000000, 0.55); mk_cell = 0x2E2C2A;
mk_ft = ui_mix(mk_face, 0xFFFFFF, 0.22); mk_fb = ui_mix(mk_face, 0x000000, 0.22);
ui_vu_dim = 0;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 15 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 16 * sc);
  mg_f13 = ui_fitarial(13, 13 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
  mg_f3 = ui_fitarial(3, 12.5 * sc);
  mg_f16 = ui_fitarial(16, 14 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(3, "Arial", mg_f3, 'b');
gfx_setfont(16, "Arial", mg_f16, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
