desc:Perc 34 Mini [hand percussion] (GFX Lab)
//tags: instrument percussion cowbell triangle clave woodblock agogo shaker tambourine step sequencer drum machine mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-clip, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider52:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:2<0,4,1{1/8,1/8T,1/16,1/16T,1/32}>-Rate
slider2:0<0,75,1>-Swing (%)
slider3:15<0,100,1>-Humanize (%)
slider4:5<0,10,0.1>-Accent
slider5:0<0,1,1{Off,On}>-Free run (plays when stopped)
slider6:0<-24,6,0.1>-Master (dB)
slider7:50<0,100,1>-Drift (%)
slider8:15<0,100,1>-Reverb (%)
slider9:16<1,16,1>-Cowbell length (steps)
slider10:16<1,16,1>-Triangle length (steps)
slider11:16<1,16,1>-Clave length (steps)
slider12:16<1,16,1>-Wood length (steps)
slider13:16<1,16,1>-Agogo length (steps)
slider14:16<1,16,1>-Shaker length (steps)
slider15:16<1,16,1>-Tambourine length (steps)
slider16:0<-24,6,0.1>-Cowbell level (dB)
slider17:0<-24,6,0.1>-Triangle level (dB)
slider18:0<-24,6,0.1>-Clave level (dB)
slider19:0<-24,6,0.1>-Wood level (dB)
slider20:0<-24,6,0.1>-Agogo level (dB)
slider21:0<-24,6,0.1>-Shaker level (dB)
slider22:0<-24,6,0.1>-Tambourine level (dB)
slider23:-15<-100,100,1>-Cowbell pan
slider24:20<-100,100,1>-Triangle pan
slider25:0<-100,100,1>-Clave pan
slider26:-35<-100,100,1>-Wood pan
slider27:35<-100,100,1>-Agogo pan
slider28:-20<-100,100,1>-Shaker pan
slider29:25<-100,100,1>-Tambourine pan
slider30:50<0,100,1>-Cowbell tune (%)
slider31:50<0,100,1>-Triangle tune (%)
slider32:50<0,100,1>-Clave tune (%)
slider33:50<0,100,1>-Wood tune (%)
slider34:50<0,100,1>-Agogo tune (%)
slider35:50<0,100,1>-Shaker tune (%)
slider36:50<0,100,1>-Tambourine tune (%)
slider37:50<0,100,1>-Cowbell decay (%)
slider38:50<0,100,1>-Triangle decay (%)
slider39:50<0,100,1>-Clave decay (%)
slider40:50<0,100,1>-Wood decay (%)
slider41:50<0,100,1>-Agogo decay (%)
slider42:50<0,100,1>-Shaker decay (%)
slider43:50<0,100,1>-Tambourine decay (%)
slider44:50<0,100,1>-Cowbell tone (%)
slider45:50<0,100,1>-Triangle tone (%)
slider46:50<0,100,1>-Clave tone (%)
slider47:50<0,100,1>-Wood tone (%)
slider48:50<0,100,1>-Agogo tone (%)
slider49:50<0,100,1>-Shaker tone (%)
slider50:50<0,100,1>-Tambourine tone (%)
slider51:prs_sel=0<0,14,1{No preset,Init,Son Clave,Rumba Clave,Bossa Nova,Samba,Disco Cowbell,Funk Bell,Motown Tambourine,Afro 12/8,Forro Triangle,Five Against Eight,Temple Blocks,Shimmer,Busy Groove}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4503599627370495, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); );
#ui_man = "gfx-lab-perc-34-mini";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 0; clp_kt_on = 0;
function pc_dn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function pc_tc(ms) ( 1 - exp(-1 / (max(ms, 0.002) * 0.001 * srate)); );
function pc_kd(ms) ( exp(-1 / (max(ms, 0.002) * 0.001 * srate)); );
function pc_mp(t, lo, mid, hi) ( t = min(max(t, 0), 1); t < 0.5 ? lo + (mid - lo) * 2 * t : mid + (hi - mid) * (2 * t - 1); );
function pc_ml(t, lo, mid, hi) ( t = min(max(t, 0), 1); t < 0.5 ? lo * (mid / lo) ^ (2 * t) : mid * (hi / mid) ^ (2 * t - 1); );

NV = 9; NLN = 7;
STP = 5000;
EX = 4000; OUT = 4010; LTR = 4020; CUR = 4030; TUN = 4040; GL = 4050; GR = 4060; GLT = 4070; GRT = 4080;
LFL = 4100;
LV = 4090; LV[0] = 0; LV[1] = 1; LV[2] = 2; LV[3] = 3; LV[4] = 3; LV[5] = 4; LV[6] = 4; LV[7] = 5; LV[8] = 6;
PC_AW = 4490; memset(PC_AW, 0, 10);
XN = 4400; XD = 4410; XW = 4420; XP = 4430; XA = 4440; XH = 4450; CVK = 4460; HD = 4470;
CVK[2] = 0.52; CVK[3] = 0.344; CVK[4] = 0.272; CVK[5] = 0.226; CVK[6] = 0.286;
MQ = 7000;
MD = 1000;
pc_nm = 36;
CBG = 0.25; TRG = 0.07; SHG = 0.45; TBG = 0.24;
TRF = 4300; TRF[0] = 1; TRF[1] = 1.0042; TRF[2] = 2.57; TRF[3] = 2.583; TRF[4] = 4.13; TRF[5] = 5.36; TRF[6] = 5.381;
TRF[7] = 6.82; TRF[8] = 8.11; TRF[9] = 8.137; TRF[10] = 9.62; TRF[11] = 11.31;
TRD = 4320; TRD[0] = 1; TRD[1] = 1; TRD[2] = 0.9; TRD[3] = 0.9; TRD[4] = 0.8; TRD[5] = 0.7; TRD[6] = 0.7; TRD[7] = 0.6; TRD[8] = 0.5; TRD[9] = 0.5; TRD[10] = 0.42; TRD[11] = 0.35;

function md_set(m, ln, f, tau, w) local(o, ww, r) (
  o = MD + m * 8; ww = 2 * $pi * min(max(f, 20), 0.45 * srate) / srate; r = exp(-1 / (max(tau, 0.0005) * srate));
  o[0] = 2 * r * cos(ww); o[1] = -r * r; o[2] = sin(ww); o[5] = w; o[6] = ln;
);
function md_setn(m, ln, f, tau, w) local(o, ww, r) (
  o = MD + m * 8; ww = 2 * $pi * min(max(f, 20), 0.45 * srate) / srate; r = exp(-1 / (max(tau, 0.0005) * srate));
  o[0] = 2 * r * cos(ww); o[1] = -r * r; o[2] = sin(ww) * 2 * sqrt(1 - r); o[5] = w; o[6] = ln;
);
function md_run() local(o, y) (
  o = MD;
  loop(pc_nm, PC_AW[o[6]] ? ( y = o[0] * o[3] + o[1] * o[4] + o[2] * EX[o[6]]; o[4] = o[3]; o[3] = y; OUT[o[6]] += y * o[5]; ); o += 8; );
);
function md_tidy() local(o) ( o = MD; loop(pc_nm, o[3] = pc_dn(o[3]); o[4] = pc_dn(o[4]); o += 8; ); );
function md_clear() local(o) ( o = MD; loop(pc_nm, o[3] = o[4] = 0; o += 8; ); );
function pc_quiet(k) local(o, q, c) (
  q = 1; o = MD;
  loop(pc_nm,
    o[6] == k ? (
      c = 0.5 * o[0];
      (o[3] * o[3] - o[0] * o[3] * o[4] + o[4] * o[4]) / max(1 - c * c, 0.000001) > 0.00000000000001 ? q = 0;
    );
    o += 8;
  );
  q;
);
function pc_sleep() local(k, o) (
  PC_AW[1] && abs(tr_n) + abs(tr_l) + abs(tr_i) < 0.0000001 && pc_quiet(1) ? PC_AW[1] = 0;
  k = 2; loop(5,
    PC_AW[k] && XP[k] >= XW[k] && abs(XN[k]) + abs(XH[k]) < 0.0000001 && pc_quiet(k) ? PC_AW[k] = 0;
    k += 1; );
  PC_AW[8] && tb_E <= 0.00005 && abs(tb_L) + abs(tb_c) + abs(tb_hp) < 0.0000001 && pc_quiet(8) ? PC_AW[8] = 0;
  o = MD; loop(pc_nm, !PC_AW[o[6]] ? o[3] = o[4] = 0; o += 8; );
);
function pc_svf(f, q) instance(a1, a2, a3) local(g, k) (
  g = tan($pi * min(max(f, 20), 0.45 * srate) / srate); k = 1 / max(q, 0.3);
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function pc_bp(x) instance(a1, a2, a3, c1, c2) local(v1, v2, v3) (
  v3 = x - c2; v1 = a1 * c1 + a2 * v3; v2 = c2 + a2 * c1 + a3 * v3; c1 = 2 * v1 - c1; c2 = 2 * v2 - c2; v1;
);
function pc_svt() instance(c1, c2) ( c1 = pc_dn(c1); c2 = pc_dn(c2); );
function pc_svz() instance(c1, c2) ( c1 = c2 = 0; );
function pc_blep(t, dt) ( t < dt ? ( t /= dt; t + t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt; t * t + t + t + 1; ) : 0; );

function ins_note(n) (
  pc_mute = n == 80;
  n == 56 ? 0 : n == 81 || n == 80 ? 1 : n == 75 ? 2 : n == 76 ? 3 : n == 77 ? 4 : n == 67 ? 5 : n == 68 ? 6 :
  n == 70 || n == 82 ? 7 : n == 54 ? 8 : -1;
);
function ins_srinit() (
  cb_k1 = pc_kd(6); cb_kc = pc_kd(0.8); tr_kn = pc_kd(1.5); cb_khp = 1 - exp(-2 * $pi * 260 / srate);
  XD[2] = pc_kd(0.5); XD[3] = XD[4] = pc_kd(2.5); XD[5] = XD[6] = pc_kd(0.6);
  tb_ks = pc_kd(1.4); tb_kc = pc_kd(0.25); tb_pc = 22050 / srate / 1024;
);
function ins_trig(k, v, a) local(f0, r, b, tb, m, f, d, h) (
  PC_AW[k] = 1;
  k == 0 ? (
    cb_e1 = cb_e2 = v; cb_c = v * (a ? 1.2 : 0.8);
    cb_f1 = cb_tune * TUN[0]; cb_f2 = cb_f1 * 1.44; cb_d1 = cb_f1 / srate; cb_d2 = cb_f2 / srate; cb_p1 = 0; cb_p2 = 0.25;
    cbf.pc_svf(2640 * (cb_f1 / 587) * (1 - 0.03 * cb_dmp) * (a ? 1 + 0.015 * pc_acc : 1), 3.2 - 0.18 * cb_dmp);
  ) : k == 1 ? (
    f0 = 1100 * 2 ^ ((tr_sz - 5) * 0.15) * TUN[1]; r = tr_ring * (pc_mute ? 0.05 : 1); b = 0.6 + 0.08 * tr_br;
    m = 0; loop(12, md_set(m, 1, f0 * TRF[m], r * TRD[m], (m & 1 ? 0.8 : 1) * b ^ (m * 0.5) * 0.5); m += 1; );
    tr_i = v; tr_n = v * (0.15 + 0.04 * tr_br);
    tb = 16000 * 2 ^ (-3 * 0.32) * (a ? 1 + 0.05 * pc_acc : 1);
    tr_kl = 1 - exp(-2 * $pi * min(tb, 0.45 * srate) / srate);
  ) : k == 2 ? (
    f = cv_ct * TUN[2]; d = cv_cd;
    md_set(12, 2, f, 0.065 * d, 1); md_set(13, 2, f * 2.777, 0.022 * d, 0.3);
  ) : k <= 4 ? (
    f = cv_wt * (k == 4 ? 0.68 : 1) * TUN[k]; d = cv_wd; m = k == 3 ? 14 : 17;
    md_set(m, k, f, 0.07 * d, 1); md_set(m + 1, k, f * 1.777, 0.045 * d, 0.55); md_set(m + 2, k, f * 2.378, 0.03 * d, 0.35);
  ) : k <= 6 ? (
    f = cv_at * (k == 6 ? 0.75 : 1) * TUN[k]; d = cv_ad; m = k == 5 ? 20 : 24;
    md_set(m, k, f, 0.4 * d, 1); md_set(m + 1, k, f * 1.0035, 0.36 * d, 0.6); md_set(m + 2, k, f * 4.08, 0.17 * d, 0.45);
    md_set(m + 3, k, f * 6.669, 0.09 * d, 0.3);
  ) : k == 7 ? (
    sh_dir = 1 - sh_dir;
    sh_tg = v * (sh_dir ? 1 : 1 - 0.05 * sh_pp); sh_at = 1;
    sh_f = sh_tone * (sh_dir ? 1 : 1 - 0.008 * sh_pp) * (a ? 1 + 0.012 * pc_acc : 1) * TUN[7];
    s1.pc_svf(sh_f, sh_q); s2.pc_svf(sh_f * 1.6, sh_q * 0.8);
  ) : (
    tb_E += v * (a ? 1 + 0.05 * pc_acc : 1);
    tb_c = v * tb_hit;
  );
  k >= 2 && k <= 6 ? (
    h = (0.75 - 0.06 * HD[k]) * (a ? 1 - 0.04 * pc_acc : 1) / f;
    XW[k] = max(floor(h * srate), 2); XP[k] = 0; XA[k] = v * 2 / XW[k];
    XN[k] = v * (k == 3 || k == 4 ? 0.5 : k == 2 ? 0.25 : 0.12);
  );
);
function ins_block() (
  cb_tune = pc_ml(slider30 / 100, 300, 587, 1000);
  cb_dmp = pc_mp(1 - slider44 / 100, 0, 2, 10);
  cb_k2 = pc_kd(pc_mp(slider37 / 100, 30, 120, 200) * (1 - 0.07 * cb_dmp));
  cb_kl = 1 - exp(-2 * $pi * (7000 * 2 ^ (-cb_dmp * 0.15)) / srate);
  tr_sz = pc_mp(slider31 / 100, 0, 5, 10); tr_ring = pc_ml(slider38 / 100, 0.03, 0.25, 0.5); tr_br = pc_mp(slider45 / 100, 0, 5, 10);
  cv_ct = pc_ml(slider32 / 100, 600, 1600, 3000); cv_cd = pc_mp(slider39 / 100, 0.15, 0.5, 0.95); HD[2] = pc_mp(slider46 / 100, 0, 6, 10);
  cv_wt = pc_ml(slider33 / 100, 500, 950, 1500); cv_wd = pc_mp(slider40 / 100, 0.15, 0.45, 0.85); HD[3] = HD[4] = pc_mp(slider47 / 100, 0, 6, 10);
  cv_at = pc_ml(slider34 / 100, 600, 950, 1600); cv_ad = pc_mp(slider41 / 100, 0.08, 0.16, 0.24); HD[5] = HD[6] = pc_mp(slider48 / 100, 0, 6, 10);
  sh_tone = pc_ml(slider35 / 100, 1500, 5500, 9000); sh_len = pc_ml(slider42 / 100, 30, 110, 400);
  sh_q = 1 + 0.9 * pc_mp(slider49 / 100, 0, 4, 10); sh_pp = 4;
  sh_ka = pc_tc(6); sh_kd = pc_kd(sh_len * 0.45);
  sh_den = (7000 - 550 * 4) / srate; sh_kg = pc_kd(0.15 + 0.25 * 4);
  sh_mk = 0.9 / sqrt(sh_q);
  tb_br = pc_mp(slider36 / 100, 0, 5, 10); tb_ring = pc_ml(slider43 / 100, 40, 250, 800); tb_hit = pc_mp(slider50 / 100, 0, 5, 10) / 5;
  tb_rt = 0.5; tb_kE = pc_kd(tb_ring * 0.5);
  tb_nob = 8 + 40 * tb_rt;
  tb_gn = sqrt(250 / max(tb_ring, 120)) * (28 / tb_nob) ^ 0.25;
  tb_bs = (0.8 + 0.04 * tb_br) * TUN[8]; tb_jt = 0.010 + 0.012 * tb_rt;
  md_setn(28, 8, 2300 * tb_bs, 0.0016, 0.10 * TBG);
  md_setn(29, 8, 5470 * tb_bs, tb_jt, 0.55 * TBG);
  md_setn(30, 8, 5730 * tb_bs, tb_jt * 0.9, 0.55 * TBG);
  md_setn(31, 8, 7860 * tb_bs, tb_jt * 0.8, 0.6 * TBG);
  md_setn(32, 8, 8120 * tb_bs, tb_jt * 0.85, 0.6 * TBG);
  md_setn(33, 8, 8410 * tb_bs, tb_jt * 0.75, 0.45 * TBG);
  md_setn(34, 8, 10950 * tb_bs, tb_jt * 0.6, (0.08 + 0.03 * tb_br) * TBG);
  md_setn(35, 8, 11650 * tb_bs, tb_jt * 0.55, (0.08 + 0.03 * tb_br) * TBG);
  cbf.pc_svt(); cb_e1 = pc_dn(cb_e1); cb_e2 = pc_dn(cb_e2); cb_h = pc_dn(cb_h); cb_l = pc_dn(cb_l); tr_l = pc_dn(tr_l); tr_n = pc_dn(tr_n);
  s1.pc_svt(); s2.pc_svt(); sh_e = pc_dn(sh_e); sh_g = pc_dn(sh_g); tb_E = pc_dn(tb_E); tb_L = pc_dn(tb_L); tb_hp = pc_dn(tb_hp);
  pc_k = 2; loop(5, XN[pc_k] = pc_dn(XN[pc_k]); XH[pc_k] = pc_dn(XH[pc_k]); pc_k += 1; );
);
function ins_sample() local(s1_, s2_, b, e, x, k, n) (
  cb_e2 > 0.00002 ? (
    cb_p1 += cb_d1; cb_p1 >= 1 ? cb_p1 -= 1; cb_p2 += cb_d2; cb_p2 >= 1 ? cb_p2 -= 1;
    s1_ = (cb_p1 < 0.5 ? 1 : -1) + pc_blep(cb_p1, cb_d1) - pc_blep((cb_p1 + 0.5) - floor(cb_p1 + 0.5), cb_d1);
    s2_ = (cb_p2 < 0.5 ? 1 : -1) + pc_blep(cb_p2, cb_d2) - pc_blep((cb_p2 + 0.5) - floor(cb_p2 + 0.5), cb_d2);
    b = cbf.pc_bp(s1_ + 0.8 * s2_);
    cb_h += cb_khp * (b - cb_h); b -= cb_h;
    e = 0.75 * cb_e1 + 0.25 * cb_e2; cb_e1 *= cb_k1; cb_e2 *= cb_k2;
    x = (rand(2) - 1) * cb_c; cb_c *= cb_kc;
    cb_l += cb_kl * (b * e + x * 0.5 - cb_l);
    OUT[0] = cb_l * CBG;
  );
  PC_AW[1] ? (
    x = tr_i + (rand(2) - 1) * tr_n; tr_i = 0; tr_n *= tr_kn;
    tr_l += tr_kl * (x - tr_l);
    EX[1] = tr_l * TRG;
  ) : EX[1] = 0;
  k = 2;
  loop(5,
    PC_AW[k] ? (
      x = 0;
      XP[k] < XW[k] ? ( x = XA[k] * (0.5 - 0.5 * cos(2 * $pi * XP[k] / XW[k])); XP[k] += 1; );
      n = (rand(2) - 1) * XN[k]; XN[k] *= XD[k]; XH[k] += 0.5 * (n - XH[k]);
      EX[k] = x * CVK[k];
      OUT[k] += (n - XH[k]) * CVK[k] * 0.4;
    ) : EX[k] = 0;
    k += 1;
  );
  sh_at ? ( sh_e += (sh_tg - sh_e) * sh_ka; sh_e >= sh_tg * 0.95 ? sh_at = 0; ) : sh_e *= sh_kd;
  sh_e > 0.0001 ? (
    rand(1) < sh_den * min(sh_e * 1.6, 1) ? sh_g = max(sh_g, (0.35 + rand(1) * 0.65) * sh_e);
    sh_g *= sh_kg;
    n = (rand(2) - 1) * sh_g;
    OUT[7] = (s1.pc_bp(n) + 0.55 * s2.pc_bp(n) + 0.12 * n) * sh_mk * SHG;
  );
  tb_E > 0.00005 ? (
    rand(1) < tb_nob * tb_pc * (0.3 + 0.7 * min(tb_E, 1)) ? tb_L = max(tb_L, (0.55 + rand(1) * 0.45) * tb_E ^ 0.7 * tb_gn);
    tb_E *= tb_kE;
  );
  PC_AW[8] ? (
    x = (rand(2) - 1) * tb_L; tb_L *= tb_ks;
    EX[8] = x;
    x = (rand(2) - 1) * tb_c; tb_hp += 0.45 * (x - tb_hp); OUT[8] += (x - tb_hp) * 0.6 * TBG; tb_c *= tb_kc;
  ) : EX[8] = 0;
);
function ins_clear() local(k) (
  cb_e1 = cb_e2 = cb_c = cb_l = cb_h = 0; cbf.pc_svz();
  tr_i = tr_n = tr_l = 0;
  k = 2; loop(5, XP[k] = XW[k] = 0; XN[k] = XH[k] = 0; EX[k] = 0; k += 1; );
  sh_e = sh_g = sh_tg = 0; sh_at = 0; s1.pc_svz(); s2.pc_svz();
  tb_E = tb_L = tb_c = tb_hp = 0;
  EX[1] = EX[8] = 0;
  md_clear();
);

RV_W = 6000; RV_S = 6200; RV_B = 20000;
function rv_alloc() ( rv_n = ceil(0.25 * srate) + 8; rv_qn = rv_n + ceil(0.05 * srate); rv_q = rv_qn; memset(RV_B, 0, 16 * rv_n); memset(RV_W, 0, 16); memset(RV_S, 0, 160); );
function rv_rd(k, d) local(i) ( i = RV_W[k] - d; i < 0 ? i += rv_n; RV_B[k * rv_n + i]; );
function rv_wr(k, x) local(i) ( i = RV_W[k]; RV_B[k * rv_n + i] = x; i += 1; i >= rv_n ? i = 0; RV_W[k] = i; );
function rv_ap(k, x, d, g) local(v, u) ( v = rv_rd(k, d); u = x - g * v; rv_wr(k, u); v + g * u; );
function rv_ms(m) ( max(floor(m * 0.001 * srate + 0.5), 1); );
function rv_setup() local(t60, k) (
  rv_amt = min(max(slider8, 0), 100) / 100;
  rv_gt = rv_amt;
  t60 = 0.3 * 6 ^ 0.5;
  RV_S[20] = rv_ms(29.7); RV_S[21] = rv_ms(37.1); RV_S[22] = rv_ms(41.3); RV_S[23] = rv_ms(47.9);
  k = 0; loop(4, RV_S[24 + k] = 10 ^ (-3 * RV_S[20 + k] / srate / t60); k += 1; );
  RV_S[30] = rv_ms(3.1); RV_S[31] = rv_ms(7.9); RV_S[32] = rv_ms(13.7); RV_S[33] = rv_ms(19.9);
  RV_S[34] = rv_ms(5.3); RV_S[35] = rv_ms(11.2); RV_S[36] = rv_ms(17.3); RV_S[37] = rv_ms(23.6);
  RV_S[38] = rv_ms(4.7); RV_S[39] = rv_ms(6.1);
  rv_dc = 1 - exp(-2 * $pi * 1500 * 8 ^ 0.5 / srate); rv_kn = 3.2;
  rv_kg = 1 - exp(-1 / (0.01 * srate));
  k = 0; loop(4, RV_S[k] = pc_dn(RV_S[k]); k += 1; );
);
function rv_run(l, r) local(x, a1, a2, a3, a4, h, dl, dr) (
  abs(l) + abs(r) > 0.0000001 ? rv_q = 0;
  rv_q < rv_qn ? (
  x = (l + r) * 0.5; rv_wr(0, x);
  rv_wl = 0.42 * rv_rd(0, RV_S[30]) + 0.33 * rv_rd(0, RV_S[31]) + 0.26 * rv_rd(0, RV_S[32]) + 0.2 * rv_rd(0, RV_S[33]);
  rv_wr_ = 0.42 * rv_rd(0, RV_S[34]) + 0.33 * rv_rd(0, RV_S[35]) + 0.26 * rv_rd(0, RV_S[36]) + 0.2 * rv_rd(0, RV_S[37]);
  a1 = rv_rd(1, RV_S[20]); a2 = rv_rd(2, RV_S[21]); a3 = rv_rd(3, RV_S[22]); a4 = rv_rd(4, RV_S[23]);
  RV_S[0] += rv_dc * (a1 - RV_S[0]); a1 = RV_S[0] * RV_S[24];
  RV_S[1] += rv_dc * (a2 - RV_S[1]); a2 = RV_S[1] * RV_S[25];
  RV_S[2] += rv_dc * (a3 - RV_S[2]); a3 = RV_S[2] * RV_S[26];
  RV_S[3] += rv_dc * (a4 - RV_S[3]); a4 = RV_S[3] * RV_S[27];
  h = 0.5 * (a1 + a2 + a3 + a4);
