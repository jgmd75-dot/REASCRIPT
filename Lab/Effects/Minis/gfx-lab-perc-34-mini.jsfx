function pc_lv(l, db) ( !pc_po ? slider(16 + l) = db; );
function pc_pats(a, b, c, d, e, f, g) ( pc_pat(0, a); pc_pat(1, b); pc_pat(2, c); pc_pat(3, d); pc_pat(4, e); pc_pat(5, f); pc_pat(6, g); );

function load_preset(p) (
