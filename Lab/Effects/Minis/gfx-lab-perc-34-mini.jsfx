function pc_seq(rate, sw, hu, ac, rv) ( !pc_po ? ( slider1 = rate; slider2 = sw; slider3 = hu; slider4 = ac; slider8 = rv; ); );
function pc_vreset() local(i) ( !pc_po ? (
  i = 16; loop(7, slider(i) = 0; i += 1; );
