      k = prs_pk; prs_pk = 0; load_preset(k); prs_h0 = prs_hash();
      prs_q ? ( k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
