);

function pc_div(i) ( i == 0 ? 0.5 : i == 1 ? 1 / 3 : i == 2 ? 0.25 : i == 3 ? 1 / 6 : 0.125; );
function pc_len(k) ( floor(min(max(slider(9 + k), 1), 16) + 0.5); );
function pc_t(n) ( n * pc_sl + ((n & 1) ? pc_sw * pc_sl : 0); );
function pc_hoff() ( (rand(1) * pc_hu * 0.02 + pc_poff) * tempo / 60; );
function pc_hit(k, v, a) (
  v *= (1 - pc_hu * 0.3 * rand(1)) * pc_pstr;
