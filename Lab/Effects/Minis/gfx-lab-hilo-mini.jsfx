desc:HILO Mini [channel strip] (GFX Lab)
//tags: channel strip hybrid analogue digital preamp converter eq gate compressor mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power, gfx-lab-sidebar (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<0,1,1{A,D}>-Front end
slider3:6<-12,30,0.1>-Gain (dB)
slider4:22<11,550,1>-HPF (Hz)
slider5:22000<2200,22000,10>-LPF (Hz)
slider6:0<0,1,1{A,D}>-EQ voicing
slider7:0<-15,15,0.1>-Low (dB)
slider8:0<-15,15,0.1>-Mid (dB)
slider9:1100<220,6600,1>-Mid freq (Hz)
slider10:0<0,1,1{Off,On}>-Mid dyn
slider11:0<-15,15,0.1>-High (dB)
slider12:0<0,1,1{A,D}>-Dynamics voicing
slider13:-12<-40,0,0.1>-Comp threshold (dB)
slider14:1<1,20,0.01>-Comp ratio
slider15:-80<-80,0,0.1>-Gate threshold (dB)
slider16:100<0,100,1>-Mix (%)
slider17:0<-12,12,0.1>-Output (dB)
slider18:1<0,1,1{Off,On}>-Guard
slider19:50<0,100,1>-Drift (%)
slider20:1<0,2,1{1x,2x,4x}>-Oversampling
slider21:1<0.4,8,0.01>-Mid Q
slider22:prs_sel=0<0,12,1{No preset,Init,Lead Vocal,Kick Room,Snare Spill,Toms Spill,Slap Bass,Bass DI,Acoustic,Glass Keys,Overheads,Sampler Crunch,Hot Preamp}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sidebar.jsfx-inc

@init
#ui_man = "gfx-lab-hilo-mini";
ext_noinit = 1;

function ha_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function ha_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function ha_db(d) ( exp(d * 0.11512925464970228); );
function ha_lg(x) ( 8.685889638065035 * log(max(x, 0.0000000001)); );

function ha_ss(u) local(q) ( q = u * u; u / sqrt(sqrt(1 + q * q)) + 0.025 * q / (1 + q); );
function ha_fra(x) ( x = ha_rl * ha_ss(x * ha_g / ha_rl); x + this.sb_run(x); );
function ha_frd(x) local(q) (
  x *= ha_ag;
  q = x * 0.7071 * x * 0.7071;
  x = ha_rl * x / sqrt(1 + q * q);
  x += this.sb_run(x);
  q = x * x; q *= q; q *= q; q *= q;
  x / sqrt(sqrt(sqrt(sqrt(1 + q))));
);
function ha_match(g) local(i, a, y, s, s2) (
  s = s2 = 0; i = 0;
  loop(32, a = 0.12589 * sin((i + 0.5) / 32 * 2 * $pi); y = ha_ss(a * g); s += y; s2 += y * y; i += 1; );
  s2 = s2 / 32 - sqr(s / 32);
  0.0890215 / sqrt(max(s2, 0.0000000001));
);

function ha_svfc(f) local(g) (
  g = tan($pi * min(f, srate * 0.47) / srate);
  ha_c1 = 1 / (1 + g * (g + 1.4142135623730951)); ha_c2 = g * ha_c1; ha_c3 = g * ha_c2;
);
function ha_svf(x, a1, a2, a3) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2; ha_bpo = v1; v2;
);
function ha_svfclr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function ha_svftidy() instance(ic1, ic2) ( ic1 = ha_tn(ic1); ic2 = ha_tn(ic2); );
function ha_bqc(t, f, q, gdb) local(ag, w, cw, sw, al, sA, a0) (
  ag = exp(gdb * 0.05756462732485115); w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); sw = sin(w);
  t == 3 ? (
    al = sw / (2 * q); a0 = 1 + al;
    ha_b0 = (1 - cw) * 0.5 / a0; ha_b1 = (1 - cw) / a0; ha_b2 = ha_b0; ha_a1 = -2 * cw / a0; ha_a2 = (1 - al) / a0;
  ) : t == 2 ? (
    al = sw / (2 * q); a0 = 1 + al / ag;
    ha_b0 = (1 + al * ag) / a0; ha_b1 = -2 * cw / a0; ha_b2 = (1 - al * ag) / a0; ha_a1 = ha_b1; ha_a2 = (1 - al / ag) / a0;
  ) : (
    al = sw * 0.7071067811865476; sA = 2 * sqrt(ag) * al;
    t == 0 ? (
      a0 = (ag + 1) + (ag - 1) * cw + sA;
      ha_b0 = ag * ((ag + 1) - (ag - 1) * cw + sA) / a0; ha_b1 = 2 * ag * ((ag - 1) - (ag + 1) * cw) / a0;
      ha_b2 = ag * ((ag + 1) - (ag - 1) * cw - sA) / a0; ha_a1 = -2 * ((ag - 1) + (ag + 1) * cw) / a0;
      ha_a2 = ((ag + 1) + (ag - 1) * cw - sA) / a0;
    ) : (
      a0 = (ag + 1) - (ag - 1) * cw + sA;
      ha_b0 = ag * ((ag + 1) + (ag - 1) * cw + sA) / a0; ha_b1 = -2 * ag * ((ag - 1) + (ag + 1) * cw) / a0;
      ha_b2 = ag * ((ag + 1) + (ag - 1) * cw - sA) / a0; ha_a1 = 2 * ((ag - 1) - (ag + 1) * cw) / a0;
      ha_a2 = ((ag + 1) - (ag - 1) * cw - sA) / a0;
    );
  );
);
function ha_bqset() instance(b0, b1, b2, a1, a2) ( b0 = ha_b0; b1 = ha_b1; b2 = ha_b2; a1 = ha_a1; a2 = ha_a2; );
function ha_bq(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; y;
);
function ha_bqclr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function ha_bqtidy() instance(x1, x2, y1, y2) ( x1 = ha_tn(x1); x2 = ha_tn(x2); y1 = ha_tn(y1); y2 = ha_tn(y2); );

function ha_fstep(f) ( 110 * 2 ^ (floor(log(f / 110) / log(2) * 12 + 0.5) / 12); );
function ha_vstep(v) ( floor(v * 2 + 0.5) / 2; );
function ha_qstep(q) ( 2 ^ (floor(log(q) / log(2) * 3 + 0.5) / 3); );

function ha_band(snap, ft, gt, qt, t, dy) instance(f, g, q, fc, gc, qc) local(k, ge, qe, nw, fe, x, c) (
  k = snap ? 1 : ha_c16;
  f += (ft - f) * k; g += (gt - g) * k; q += (qt - q) * k;
  ge = g * dy;
  qe = t == 2 ? q * (1 - ha_em + ha_em * (0.55 + 0.45 * min(abs(ge), 15) / 15)) : 0.7071;
  fe = exp(f);
  t == 2 && ha_cre > 0 ? ( x = $pi * fe / 48000; c = atan(x) / x; fe *= 1 + ha_cre * (c - 1); qe *= 1 + ha_cre * (c * (1 + x * x) - 1); );
  nw = snap || abs(fe - fc) > 0.0001 * fe || abs(ge - gc) > 0.0005 || abs(qe - qc) > 0.0005;
  nw ? ( fc = fe; gc = ge; qc = qe; ha_bqc(t, fe, qe, ge); );
  nw;
);
function ha_dcoef(f) instance(c1, c2, c3) ( ha_svfc(f); c1 = ha_c1; c2 = ha_c2; c3 = ha_c3; );
function ha_damt(on) instance(fe, se, a, m) local(d) (
  d = ha_lg(fe) - ha_lg(se);
  a = fe > 0.0003 ? min(max((d - 2) / 8, 0), 1) : 0;
  m += ((on ? 1 : 0) - m) * ha_c16s;
  1 - m * (1 - a);
);

function ha_coefs(snap) local(k, ks) (
  k = snap ? 1 : ha_c16; ks = snap ? 1 : ha_c16s;
  ha_hf += (ha_hft - ha_hf) * k; ha_lf += (ha_lft - ha_lf) * k;
  snap || abs(ha_hf - ha_hfc) > 0.0001 ? ( ha_hfc = ha_hf; ha_svfc(exp(ha_hf)); ha_h1 = ha_c1; ha_h2 = ha_c2; ha_h3 = ha_c3; );
  snap || abs(ha_lf - ha_lfc) > 0.0001 ? ( ha_lfc = ha_lf; ha_svfc(exp(ha_lf)); ha_l1 = ha_c1; ha_l2 = ha_c2; ha_l3 = ha_c3; );
  ha_em += (ha_emt - ha_em) * ks; ha_cre += ((1 - ha_emt) - ha_cre) * ks;
  ha_dy2 = haD2.ha_damt(ha_d2t);
  haB1.ha_band(snap, ha_f1t, ha_g1t, 0.9, 0, 1) ? ( e1L.ha_bqset(); e1R.ha_bqset(); );
  haB2.ha_band(snap, ha_f2t, ha_g2t, ha_q2t, 2, ha_dy2) ? ( e2L.ha_bqset(); e2R.ha_bqset(); );
  haB4.ha_band(snap, ha_f4t, ha_g4t, 0.9, 1, 1) ? ( e4L.ha_bqset(); e4R.ha_bqset(); );
  dt2.ha_dcoef(exp(haB2.f));
);
function ha_fixed() (
  ha_svfc(990); ha_s1 = ha_c1; ha_s2 = ha_c2; ha_s3 = ha_c3;
  ha_svfc(110); ha_k1 = ha_c1; ha_k2 = ha_c2; ha_k3 = ha_c3;
  ha_bqc(3, 21000, 0.7071, 0); aLL.ha_bqset(); aLR.ha_bqset();
);
function ha_clrA() ( uaL.os_clr(); uaR.os_clr(); shL.sb_clr(); shR.sb_clr(); );
function ha_clrD() ( udL.os_clr(); udR.os_clr(); sdL.sb_clr(); sdR.sb_clr(); aLL.ha_bqclr(); aLR.ha_bqclr(); );
function ha_clear() ( uxL.os_clr(); uxR.os_clr(); ha_clrA(); ha_clrD(); sb_rate(srate * os_f); );
function ha_reset() (
  ha_clear(); memset(BY_BUF, 0, 2 * BY_N);
  hpL.ha_svfclr(); hpR.ha_svfclr(); lpL.ha_svfclr(); lpR.ha_svfclr(); spL.ha_svfclr(); spR.ha_svfclr(); scL.ha_svfclr(); scR.ha_svfclr();
  dt2.ha_svfclr();
  e1L.ha_bqclr(); e1R.ha_bqclr(); e2L.ha_bqclr(); e2R.ha_bqclr(); e4L.ha_bqclr(); e4R.ha_bqclr();
  ha_dxl = ha_dyl = ha_dxr = ha_dyr = 0; ha_env = 0;
  ha_ge = 0; ha_gg = 0; ha_go = 0; ha_ce = 0; ha_grs = 0;
  haD2.fe = haD2.se = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  ha_fi = 0;
);

function ha_pv(fm, gn, hp, lp, em, lo, md, mf, dy, hi) (
  slider2 = fm; slider3 = gn; slider4 = hp; slider5 = lp; slider6 = em; slider7 = lo; slider8 = md; slider9 = mf; slider10 = dy; slider11 = hi;
);
function ha_pw(cm, ct, cr, gt, mx, ou, q) (
  slider21 = q; slider12 = cm; slider13 = ct; slider14 = cr; slider15 = gt; slider16 = mx; slider17 = ou; slider18 = 1;
);
function load_preset(p) local(i) (
  p == 1 || p == 13 ? ( ha_pv(0,  6,  22, 22000, 0,  0,  0, 1100, 0,  0); ha_pw(0, -12, 1,   -80, 100,  0, 1); ) :
  p == 2  ? ( ha_pv(1,  9,  88, 22000, 0,  0, -4, 3300, 1,  3); ha_pw(1, -20, 3,   -50, 100,  0, 1.6); ) :
  p == 3  ? ( ha_pv(0,  8,  33, 11000, 0,  4, -6,  330, 0,  0); ha_pw(0, -14, 4,   -30, 100,  0, 1.6); ) :
  p == 4  ? ( ha_pv(0,  8,  88, 22000, 0,  2, -3,  550, 0,  3); ha_pw(1, -16, 4,   -28,  70,  0, 1.4); ) :
  p == 5  ? ( ha_pv(0,  8,  55, 16000, 0,  4, -5,  440, 0,  1); ha_pw(0, -14, 3,   -34, 100,  0, 1.2); ) :
  p == 6  ? ( ha_pv(1, 12,  33, 22000, 1,  3,  4, 2200, 0,  2); ha_pw(1, -20, 6,   -80, 100,  0, 1.4); ) :
  p == 7  ? ( ha_pv(0, 12,  33,  8800, 0,  3,  2,  660, 0,  0); ha_pw(0, -18, 4,   -80, 100,  0, 1); ) :
  p == 8  ? ( ha_pv(0,  6, 110, 22000, 0, -2, -3,  330, 1,  4); ha_pw(0, -16, 2.5, -80, 100,  0, 1); ) :
  p == 9  ? ( ha_pv(1,  6,  55, 22000, 1,  0, -2,  440, 0,  4); ha_pw(1, -16, 3,   -80, 100,  0, 1); ) :
  p == 10 ? ( ha_pv(0,  4, 110, 22000, 0, -2, -2, 3300, 1,  3); ha_pw(0, -10, 2,   -80,  60,  0, 1.5); ) :
  p == 11 ? ( ha_pv(1,  0,  44, 22000, 1,  3,  3, 3300, 0, -3); ha_pw(1, -18, 8,   -80, 100,  2, 1.4); ) :
  p == 12 ? ( ha_pv(0, 26,  33, 22000, 0,  2, -2,  550, 0,  0); ha_pw(0, -12, 3,   -80, 100, -3, 1); );
  p == 13 ? slider19 = 50;
  i = 2; loop(18, ui_auto(i); i += 1; ); ui_auto(21);
  pr_cur = p == 13 ? 1 : p;
);

function ha_srinit() (
  ha_sr = srate;
  c_kn = ha_tc(30);
  ha_c16 = 1 - exp(-16 / (0.03 * srate));
  ha_c16s = 1 - exp(-16 / (0.015 * srate));
  ha_dcc = 1 - 2 * $pi * 5 / srate;
  c_sw = ha_tc(15);
  ha_xs = 1 / (0.015 * srate);
  ha_ea = ha_tc(4); ha_er = ha_tc(80);
  ha_dfa = ha_tc(5); ha_dfr = ha_tc(100); ha_dsl = ha_tc(1500);
  ha_rnd = ha_tc(25);
  ha_fis = 1 / (0.01 * srate);
  ha_grk = ha_tc(200);
  ha_fixed();
  ost_init(0);
  ha_clear();
  ha_cc = 0;
);
os_design();
os_f = os_tf = os_f2n(slider20); os_base = 0;
ha_srinit();
os_gsetup();
in_init();
dSup.drift_init(0.8 + rand(1) * 0.4); dVc.drift_init(0.6 + rand(1) * 0.4); dGt.drift_init(0.7 + rand(1) * 0.4);
drift_mm_init();
drift_macro(50);
pwr_init(); pwr_hum_db = -84; pwr_sag = 0.15; pwr_wu_loss = 0.4; pwr_wu_drv = 0.8; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;
ha_sd = 22222;
ha_snap = 1; ha_fi = 1; ha_rl = 1;
ha_fa = slider2 < 0.5; ha_gm = slider12 < 0.5; ha_cm = ha_gm;
pdc_delay = os_lat(os_f);
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(22, i != 22 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(20));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();
drift_mm_ser();

@block
prs_chk();
srate != ha_sr ? ha_srinit();
pwr_block(slider1 < 0.5);
ha_now = time_precise();
ha_tp > 0 && ha_now - ha_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > ha_gpp && play_position - ha_gpp < 4 * ha_gpd + 0.05) ? ha_reset();
ha_tp = ha_now; ha_gpp = play_position; ha_gpd = samplesblock / srate;
in_setup(0, slider18 >= 0.5);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider20); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider19);
ha_bt = samplesblock / srate;
ha_sg = 0.05 * dm_a;
ha_dsp = dSup.drift_tick(0.05 * dm_s * ha_bt);
ha_vrt = ha_db(0.3 * dm_a * ha_dsp); ha_rft = ha_db(0.2 * dm_a * ha_dsp);
ha_cdr = 0.5 * dm_a * dVc.drift_tick(0.04 * dm_s * ha_bt);
ha_gdr = 1.0 * dm_a * dGt.drift_tick(0.04 * dm_s * ha_bt);
drift_mm(0.1, 0.4);
ha_hft = log(min(max(slider4, 11), 550)); ha_lft = log(min(max(slider5, 2200), 22000));
ha_fat = slider2 < 0.5;
ha_gn = min(max(slider3, -12), 30);
ha_gt = ha_db(ha_gn - 6); ha_gt != ha_gtc ? ( ha_gtc = ha_gt; ha_mkt = ha_match(ha_gt); );
ha_agt = ha_db(ha_gn - 6);
ha_emt = slider6 < 0.5;
ha_f1t = log(110); ha_f4t = log(9900);
ha_v = min(max(slider9, 220), 6600); ha_f2t = log(ha_emt ? ha_v : min(max(ha_fstep(ha_v), 220), 6600));
ha_v = min(max(slider7, -15), 15);  ha_g1t = ha_emt ? ha_v : ha_vstep(ha_v);
ha_v = min(max(slider8, -15), 15);  ha_g2t = ha_emt ? ha_v : ha_vstep(ha_v);
ha_v = min(max(slider11, -15), 15); ha_g4t = ha_emt ? ha_v : ha_vstep(ha_v);
ha_v = min(max(slider21, 0.4), 8); ha_q2t = ha_emt ? ha_v : ha_qstep(ha_v);
ha_d2t = slider10 >= 0.5;
ha_dmt = slider12 < 0.5;
ha_gtv = min(max(slider15, -80), 0);
ha_git = ha_gtv > -79.5;
ha_gth = ha_db(ha_gtv + (ha_dmt ? ha_gdr : 0));
ha_gtl = ha_gth * (ha_dmt ? 0.631 : 0.708);
ha_rgt = ha_db(-20);
ha_gak = ha_tc(ha_dmt ? 1 : 0.2); ha_gdk = exp(-1 / ((ha_dmt ? 0.005 : 0.003) * srate)); ha_ghn = floor((ha_dmt ? 0.02 : 0.01) * srate);
ha_ctv = min(max(slider13, -40), 0);
ha_ctht = ha_ctv + (ha_dmt ? ha_cdr : 0);
ha_crr = min(max(slider14, 1), 20); ha_cslt = 1 - 1 / ha_crr;
ha_cak = ha_tc(ha_dmt ? 10 : 2); ha_crk = ha_tc(ha_dmt ? 180 : 120);
ha_cmkt = 0.5 * ha_cslt * max(0, -12 - ha_ctv);
ha_cxt = min(max(slider16, 0), 100) / 100;
ha_ogt = ha_db(min(max(slider17, -12), 12));
sb_target(14, 1, 1, 220, 1 / (ha_fat ? ha_vrt : ha_rft));
ha_snap ? ( ha_cth = ha_ctht; ha_csl = ha_cslt; ha_cmk = ha_cmkt; ha_g = ha_gt; ha_mk = ha_mkt; ha_ag = ha_agt; ha_og = ha_ogt;
            ha_vr = ha_vrt; ha_rf = ha_rft; ha_gi = ha_git; ha_cx = ha_cxt;
            ha_em = ha_emt; ha_cre = 1 - ha_emt;
            ha_fa = ha_fat; ha_gm = ha_dmt; ha_cm = ha_dmt;
            ha_coefs(1); sb_snap(); ha_cc = 16; );
ha_snap = 0;
hpL.ha_svftidy(); hpR.ha_svftidy(); lpL.ha_svftidy(); lpR.ha_svftidy(); spL.ha_svftidy(); spR.ha_svftidy(); scL.ha_svftidy(); scR.ha_svftidy();
dt2.ha_svftidy();
e1L.ha_bqtidy(); e1R.ha_bqtidy(); e2L.ha_bqtidy(); e2R.ha_bqtidy(); e4L.ha_bqtidy(); e4R.ha_bqtidy();
aLL.ha_bqtidy(); aLR.ha_bqtidy();
ha_dyl = ha_tn(ha_dyl); ha_dyr = ha_tn(ha_dyr); ha_env = ha_tn(ha_env); ha_ge = ha_tn(ha_ge); ha_gg = ha_tn(ha_gg); ha_ce = ha_tn(ha_ce); ha_grs = ha_tn(ha_grs);
haD2.fe = ha_tn(haD2.fe); haD2.se = ha_tn(haD2.se);
ha_gr_d = max(ha_gr_d, ha_grm); ha_grm = 0;
ha_open_d = max(ha_open_d, ha_gom); ha_gom = 0;
ha_gon_d = ha_git;
