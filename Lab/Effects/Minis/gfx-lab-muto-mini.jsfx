  );
);
mu_dl *= mu_gis * mu_gos; mu_dr *= mu_gis * mu_gos;
mu_l = mu_dl + (mu_l * mu_gos - mu_dl) * mu_mxs; mu_r = mu_dr + (mu_r * mu_gos - mu_dr) * mu_mxs;
pwr_out(mu_l, mu_r); mu_l = pwr_l; mu_r = pwr_r;
