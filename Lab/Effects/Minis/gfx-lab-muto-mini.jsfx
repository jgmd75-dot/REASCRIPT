desc:Muto Mini [vari-mu comp] (GFX Lab)
//tags: dynamics compressor limiter vari-mu variable-mu valve tube modern bus mid-side
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:0<-12,24,0.1>-Input (dB)
slider2:-12<-40,0,0.1>-Threshold (dB)
slider3:10<0.1,30,0.01>-Attack (ms)
slider4:300<50,3000,1>-Release (ms)
slider5:0<0,1,1{Off,On}>-Auto release
slider6:0<0,4,1{Off,60 Hz,90 Hz,150 Hz,250 Hz}>-SC HPF L / M
slider7:0<0,4,1{Off,60 Hz,90 Hz,150 Hz,250 Hz}>-SC HPF R / S
slider8:0<0,2,1{Stereo,Dual mono,M-S}>-Mode
slider9:100<0,100,1>-Link (%)
slider10:30<0,100,1>-Iron (%)
slider11:100<0,100,1>-Mix (%)
slider12:0<-20,20,0.1>-Output (dB)
slider13:50<0,100,1>-Drift (%)
slider14:0<0,1,1{GR,Output}>-Meter
slider15:0<0,1,1{Off,On}>-Bypass
slider16:0<0,2,1{1x,2x,4x}>-Oversampling
slider17:prs_sel=0<0,7,1{No preset,Init,Mix Bus,Drum Bus Snap,M-S Glue,Vocal,Mastering Touch,Parallel Weight}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-muto-mini";
ext_noinit = 1;

function mu_db2g(d) ( exp(d * 0.11512925465); );
function mu_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * mu_fs)); );
function mu_sat(u) ( u = min(max(u, -3), 3); u * (27 + u * u) / (27 + 9 * u * u); );
function mu_slope(u) local(q) ( u = min(max(u, -3), 3); q = 9 - u * u; q * q / (9 * sqr(3 + u * u)); );

function mu_F(u) local(a) ( a = abs(u); a < 3 ? u * u * 0.0555555556 + 1.3333333333 * log(1 + u * u * 0.3333333333) : 2.3483924 + a - 3; );
function mu_vca(x) instance(vc, vlp, dx, dy, gn, tk, x1, u1, f1, ms, es) local(d, b, s, u, f, du, y) (
  d = mu_vd * (1 + min(vc, 10) * mu_vgd); b = mu_vb * (1 + min(vc, 12) * mu_vgb);
  s = mu_slope(b);
  u = x1 * d + b; abs(u - u1) > 0.0001 ? ( u1 = u; f1 = mu_F(u); );
  u = x * d + b; f = mu_F(u); du = u - u1;
  y = abs(du) > 0.00001 ? (f - f1) / du : mu_sat(0.5 * (u + u1));
  x1 = x; u1 = u; f1 = f;
  ms += (sqr(u - b) - ms) * mu_aer; es += (ms - es) * mu_aes;
  y += 0.5 * du * s / sqrt(1 + 2 * s * s * es);
  y = (y - mu_sat(b)) / (d * s);
  y *= exp(-0.11512925465 * vc) * gn;
  vlp += (vc - vlp) * mu_thc;
  y += mu_thk * tk * (vc - vlp);
  dy = y - dx + mu_dcr * dy; dx = y;
  dy;
);
function mu_vclr() instance(vc, vf, vs, vlp, dx, dy, x1, u1, f1, ms, es) (
  vc = vf = vs = vlp = dx = dy = x1 = ms = es = 0; u1 = mu_vb; f1 = mu_F(mu_vb);
);
function mu_tgt(e, th) instance(dt) local(o, oc, ex, t, kd, q) (
  o = 8.68588963807 * log(max(e, 0.000000001)) - th;
  o > -mu_kh ? (
    o >= mu_kh ? ( oc = o; kd = 1; ) : ( oc = sqr(o + mu_kh) / (2 * mu_kn); kd = (o + mu_kh) / mu_kn; );
    ex = exp(min(mu_cc * oc, 6));
    t = mu_bc / mu_cc * (ex - 1); dt = mu_bc * ex * kd;
    mu_hold ? ( q = min(t / 20, 3); t = 20 * mu_sat(q); dt *= mu_slope(q); );
    t >= 30 ? ( t = 30; dt = 0; );
  ) : ( t = 0; dt = 0; );
  t;
);
function mu_cap(t, slope) instance(vc, vf, vs, ka, kf, ks) local(k) (
  t > vf ? ( k = min(ka, 0.9 / (1 + slope)); vf += k * (t - vf); ) : vf *= kf;
  vf > vs ? vs += mu_kcs * (vf - vs) : vs *= ks;
  vc = max(vf, mu_ws * vs);
);
function mu_iron(x) instance(lp) local(lo, ls) (
  lp += (x - lp) * mu_ilc;
  lo = lp; ls = mu_sat(lo * mu_id) / mu_id;
  x + ls - lo + lo * mu_ish;
);
function mu_hps(f, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * 0.707);
  n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function mu_hpr(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function mu_hpz() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function mu_one(a, b) local(t, ya, yb, ea, eb, qa, qb, d, l, r) (
  mu_ms ? ( t = a; a = 0.5 * (t + b); b = 0.5 * (t - b); );
  ya = mA.mu_vca(a); yb = mB.mu_vca(b);
  ea = abs(mu_hpa ? hpA.mu_hpr(ya) : ya); eb = abs(mu_hpb ? hpB.mu_hpr(yb) : yb);
  qa = tA.mu_tgt(ea, mu_thA); qb = tB.mu_tgt(eb, mu_thB);
  mu_lk > 0 ? (
    t = max(qa, qb); d = max(tA.dt, tB.dt);
    qa += (t - qa) * mu_lk; qb += (t - qb) * mu_lk;
    mA.mu_cap(qa, d); mB.mu_cap(qb, d);
  ) : ( mA.mu_cap(qa, tA.dt); mB.mu_cap(qb, tB.dt); );
  mu_pkA = max(mu_pkA, mA.vc); mu_pkB = max(mu_pkB, mB.vc);
  mu_ms ? ( l = ya + yb; r = ya - yb; ) : ( l = ya; r = yb; );
  fz_l = iL.mu_iron(l); fz_r = iR.mu_iron(r);
  fz_o > 0.0001 ? fz_run();
  mu_wl = fz_l; mu_wr = fz_r;
);

function mu_hpf(i) ( i == 1 ? 60 : i == 2 ? 90 : i == 3 ? 150 : 250 );
function mu_latch() (
  mu_M16 = min(max(slider8 | 0, 0), 2); mu_cur = mu_M16;
);
function mu_setup() local(tf, ts, tcs, tat) (
  mu_u = 1;
    mu_gin = mu_db2g(slider1); mu_thr = slider2; mu_hold = 0; mu_gout = mu_db2g(slider12);
    mu_mode = mu_M16; mu_ms = mu_mode == 2; mu_lk = mu_mode == 1 ? 0 : slider9 / 100; mu_mix = slider11 / 100;
    mu_bc = 0.8; mu_cc = 0.4; mu_kn = 6;
    slider5 > 0.5 ? ( tf = 0.12; mu_ws = 1; ts = 1.6; tcs = 0.5; ) : ( tf = slider4 / 1000; mu_ws = 0; ts = 1; tcs = 1; );
    tat = slider3 / 1000;
    mu_vd = 0.1; mu_vgd = 0.08; mu_vb = 0.03; mu_vgb = 0.08;
    mu_thk = 0.0001;
    mu_idt = 0.3 + 1.7 * slider10 / 100; mu_isht = 0.12 * slider10 / 100;
    mu_hpa = slider6 | 0; mu_hpb = slider7 | 0;
    mu_hpa != mu_hpal ? ( mu_hpal = mu_hpa; mu_hpa ? hpA.mu_hps(mu_hpf(mu_hpa), mu_fs); );
    mu_hpb != mu_hpbl ? ( mu_hpbl = mu_hpb; mu_hpb ? hpB.mu_hps(mu_hpf(mu_hpb), mu_fs); );
  mu_isnap ? ( mu_id = mu_idt; mu_ish = mu_isht; mu_isnap = 0; );
  mu_kh = mu_kn * 0.5;
  mA.tk = 1; mB.tk = !mu_ms;
  mA.ka = mB.ka = mu_tc(tat);
  mA.kf = exp(-1 / (tf * mu_rmA * mu_fs)); mB.kf = exp(-1 / (tf * mu_rmB * mu_fs));
  mA.ks = mB.ks = exp(-1 / (ts * mu_fs)); mu_kcs = mu_tc(tcs);
  mu_fzt = 0.33 * min(max((slider1 - 12) / 12, 0), 1);
);
function mu_rates() (
  mu_fs = srate * os_f;
  mu_thc = 1 - exp(-2 * $pi * 15 / mu_fs);
  mu_dcr = exp(-2 * $pi * 4 / mu_fs);
  mu_ilc = 1 - exp(-2 * $pi * 120 / mu_fs);
  mu_aer = 1 - exp(-1 / (0.01 * mu_fs)); mu_aes = 1 - exp(-1 / (0.003 * mu_fs));
  mu_hpal = mu_hpbl = -1;
  fz_coefs(mu_fs);
);
function mu_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  mA.mu_vclr(); mB.mu_vclr(); iL.lp = iR.lp = 0; hpA.mu_hpz(); hpB.mu_hpz(); fz_clr();
  memset(DRY, 0, 128);
);

function mu_pm(i, t, a, r, au, ha, hb, md, lk, p1, m, o) (
  slider1 = i; slider2 = t; slider3 = a; slider4 = r; slider5 = au; slider6 = ha; slider7 = hb;
  slider8 = md; slider9 = lk; slider10 = p1; slider11 = m; slider12 = o;
);
function load_preset(p) (
  p == 1 ? ( mu_pm(0, -12, 10, 300, 0, 0, 0, 0, 100, 30, 100, 0); slider13 = 50; slider14 = 0; ) :
  p == 2 ? mu_pm(0, -16, 20, 400, 1, 1, 1, 0, 100, 40, 100, 1.5) :
  p == 3 ? mu_pm(2, -16, 1, 120, 0, 2, 2, 0, 100, 50, 100, 3) :
  p == 4 ? mu_pm(0, -16, 15, 500, 1, 1, 3, 2, 20, 30, 100, 1) :
  p == 5 ? mu_pm(4, -16, 3, 250, 0, 3, 3, 0, 100, 20, 100, 3) :
  p == 6 ? mu_pm(0, -12, 30, 800, 1, 2, 2, 0, 100, 25, 100, 0.5) :
  p == 7 ? mu_pm(6, -24, 5, 200, 0, 1, 1, 0, 100, 80, 40, 0);
  slider_automate(16383);
);

DRY = 1000000;
function mu_srinit() (
  mu_sr = srate;
  mu_smc = 1 - exp(-1 / (0.03 * srate));
  mu_dks = 1 / (0.006 * srate);
  mu_fis = 1 / (0.01 * srate);
  gdc_r = 1 - 2 * $pi / srate;
  mu_rates(); mu_setup(); mu_clear();
);
os_design();
os_f = os_tf = os_f2n(slider16); os_base = 0;
ost_init(0);
ost_setup(0, 0, 120, 6000, -0.3, 0);
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
mu_rmA = mu_rmB = 1;
mA.gn = mB.gn = 1;
mdT1.drift_init(0.8 + rand(1) * 0.5); mdT2.drift_init(0.8 + rand(1) * 0.5);
mdG1.drift_init(0.8 + rand(1) * 0.5); mdG2.drift_init(0.8 + rand(1) * 0.5);
mdR1.drift_init(0.8 + rand(1) * 0.5); mdR2.drift_init(0.8 + rand(1) * 0.5);
mu_mmA = rand(2) - 1; mu_mmB = rand(2) - 1; mu_mgA = rand(2) - 1; mu_mgB = rand(2) - 1;
mu_latch(); mu_isnap = 1;
mu_srinit();
mu_gis = mu_gin; mu_gos = mu_gout; mu_mxs = mu_mix; fz_s = mu_fzt; fz_o = fz_s;
mu_dk = 1; mu_fi = 1;
os_gsetup();
pdc_delay = os_lat(os_f);
pwr_init(); pwr_wu_loss = 1; pwr_wu_drv = 2; pwr_wu_lp = 7000; pwr_wu_wob = 0.3; pwr_bloom = 0.2;
by_setup(15);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_sl() ( mu_latch(); mu_setup(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(16, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(7, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 7 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
mu_setup();
os_snap(slider(16));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != mu_sr ? mu_srinit();
mu_now = time_precise();
mu_tp > 0 && mu_now - mu_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > mu_gpp && play_position - mu_gpp < 4 * mu_gpd + 0.05) ? ( mu_clear(); mu_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
mu_tp = mu_now; mu_gpp = play_position; mu_gpd = samplesblock / srate;
pwr_block(slider15 < 0.5);
os_tf = os_f2n(slider16);
mu_req = min(max(slider8 | 0, 0), 2);
mu_sw = mu_req != mu_cur;
drift_macro(slider13);
mu_inc = 0.05 * dm_s * samplesblock / srate;
mu_w1 = mdT1.drift_tick(mu_inc); mu_w2b = mdT2.drift_tick(mu_inc);
mu_g1 = mdG1.drift_tick(mu_inc * 1.3); mu_g2 = mdG2.drift_tick(mu_inc * 1.3);
mu_r1 = mdR1.drift_tick(mu_inc * 0.7); mu_r2 = mdR2.drift_tick(mu_inc * 0.7);
mu_dtA = dm_a * (0.25 * mu_w1 + 0.15 * mu_mmA);
mu_dtB = dm_a * (0.25 * mu_w2b + 0.15 * mu_mmB);
mA.gn = mu_db2g(dm_a * (0.05 * mu_g1 + 0.04 * mu_mgA));
mB.gn = mu_db2g(dm_a * (0.05 * mu_g2 + 0.04 * mu_mgB));
mu_rmA = 1 + 0.08 * dm_a * mu_r1; mu_rmB = 1 + 0.08 * dm_a * mu_r2;
mu_setup();
mu_kb = 1 - exp(-samplesblock / (0.03 * srate));
mu_id += (mu_idt - mu_id) * mu_kb; mu_ish += (mu_isht - mu_ish) * mu_kb;
mu_thA = mu_thr + mu_dtA; mu_thB = mu_thr + mu_dtB;
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
abs(mA.vf) < 0.0000001 ? mA.vf = 0; abs(mB.vf) < 0.0000001 ? mB.vf = 0;
abs(mA.vs) < 0.0000001 ? mA.vs = 0; abs(mB.vs) < 0.0000001 ? mB.vs = 0;
abs(mA.vlp) < 0.0000001 ? mA.vlp = 0; abs(mB.vlp) < 0.0000001 ? mB.vlp = 0;
abs(mA.dy) < 0.000000001 ? mA.dy = 0; abs(mB.dy) < 0.000000001 ? mB.dy = 0;
abs(iL.lp) < 0.000000001 ? iL.lp = 0; abs(iR.lp) < 0.000000001 ? iR.lp = 0;
abs(hpA.y1) + abs(hpA.y2) < 0.000000001 ? hpA.y1 = hpA.y2 = 0;
abs(hpB.y1) + abs(hpB.y2) < 0.000000001 ? hpB.y1 = hpB.y2 = 0;
mu_gr_d = max(mu_gr_d, max(mu_pkA, mu_pkB)); mu_pkA = mu_pkB = 0;
mu_vu_d = max(mu_vu_d, sqrt(mu_msq / max(samplesblock, 1))); mu_msq = 0;
mu_pk_d = max(mu_pk_d, mu_pkm); mu_pkm = 0;
os_snapb(slider(16));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; mu_iL = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; mu_iR = gdc_y1;
mu_gis += (mu_gin - mu_gis) * mu_smc; mu_gos += (mu_gout - mu_gos) * mu_smc; mu_mxs += (mu_mix - mu_mxs) * mu_smc;
fz_s += (mu_fzt - fz_s) * mu_smc; fz_s < 0.000001 && mu_fzt == 0 ? fz_s = 0; fz_o = fz_s;
pwr_in(mu_iL, mu_iR); mu_iL = pwr_l; mu_iR = pwr_r;
