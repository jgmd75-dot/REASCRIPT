os_gate();
os_chg ? ( mu_rates(); mu_setup(); mu_clear(); os_hold += 2 * samplesblock; );
mu_dd = os_lat(os_f);
mu_dd > 0 ? (
  DRY[mu_dw] = mu_iL; DRY[64 + mu_dw] = mu_iR;
  mu_dl = DRY[(mu_dw - mu_dd) & 63]; mu_dr = DRY[64 + ((mu_dw - mu_dd) & 63)];
  mu_dw = (mu_dw + 1) & 63;
) : ( mu_dl = mu_iL; mu_dr = mu_iR; );
uxL.os_up(mu_iL * mu_gis); uxR.os_up(mu_iR * mu_gis);
os_f == 1 ? (
  mu_one(uxL.s0, uxR.s0); mu_l = mu_wl; mu_r = mu_wr;
) : (
  mu_one(uxL.s0, uxR.s0); mu_a0 = mu_wl; mu_b0 = mu_wr;
  mu_one(uxL.s1, uxR.s1); mu_a1 = mu_wl; mu_b1 = mu_wr;
