desc:Cosmos Mini [pad synth] (GFX Lab)
//tags: instrument synth poly pad analogue chorus delay mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-voice, gfx-lab-warmup, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:70<0,100,1>-Saw (%)
slider2:0<0,100,1>-Pulse (%)
slider3:50<5,95,1>-Pulse width (%)
slider4:0<0,100,1>-PWM by LFO (%)
slider5:30<0,100,1>-Sub (%)
slider6:0<0,100,1>-Noise (%)
slider7:40<0,100,1>-Layer level (%)
slider8:12<0,50,0.1>-Layer detune (cents)
slider9:1<0,2,1{-1 oct,0,+1 oct}>-Layer octave
slider10:1<0,3,1{0 Boost,1 Flat,2,3}>-HPF
slider11:1800<20,18000,1>-Cutoff (Hz)
slider12:15<0,100,1>-Resonance (%)
slider13:25<-100,100,1>-Filter env amount (%)
slider14:10<0,100,1>-LFO to cutoff (%)
slider15:40<0,100,1>-Key track (%)
slider16:600<1,8000,1>-Filter attack (ms)
slider17:1500<5,10000,1>-Filter decay (ms)
slider18:50<0,100,1>-Filter sustain (%)
slider19:2500<5,15000,1>-Filter release (ms)
slider20:500<1,8000,1>-Amp attack (ms)
slider21:1000<5,10000,1>-Amp decay (ms)
slider22:85<0,100,1>-Amp sustain (%)
slider23:2500<5,15000,1>-Amp release (ms)
slider24:0.4<0.01,20,0.01>-LFO rate (Hz)
slider25:0.8<0,5,0.01>-LFO delay (s)
slider26:0<0,3,1{Sine,Triangle,Square,Random}>-LFO shape
slider27:0<0,100,1>-LFO to pitch (cents)
slider28:1<0,3,1{Off,I,II,I+II}>-Chorus
slider29:450<40,1500,1>-(unused, was delay time)
slider30:45<0,95,1>-(unused, was delay feedback)
slider31:5000<500,12000,10>-(unused, was delay tone)
slider32:20<0,100,1>-(unused, was delay mix)
slider33:30<0,100,1>-Velocity (%)
slider34:25<0,100,1>-Drift (%)
slider35:0<-24,6,0.1>-Volume (dB)
slider36:0<0,16,1>-MIDI channel (0 = omni)
slider37:0<0,100,1>-Band sat (%)
slider38:30<0,100,1>-Bias (%)
slider39:120<40,400,1>-Sat low band (Hz)
slider40:6000<2000,16000,10>-Sat high band (Hz)
slider41:-0.3<-24,0,0.1>-Ceiling (dB)
slider42:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider43:20<20,500,1>-Mono below (Hz, 20 = off)
slider44:0<0,100,1>-Stereo width (%)
slider45:0<0,11,1{Cosmos,Warm Poly,Strings 6,Glass Shimmer,Dark Drone,PWM Haze,Brass Pad,Choir Air,Sweep Pad,Slow Strings,Nebula,Init}>-Patch level trim
slider46:0<0,1,1{Off,On}>-LFO sync
slider47:8<0,10,1{1/32,1/16,1/16 dotted,1/8,1/8 dotted,1/4,1/4 dotted,1/2,1 bar,2 bars,4 bars}>-LFO note
slider48:0<0,1,1{Off,On}>-(unused, was delay sync)
slider49:3<0,8,1{1/32,1/16,1/16 dotted,1/8,1/8 dotted,1/4,1/4 dotted,1/2,1 bar}>-(unused, was delay note)
slider50:prs_sel=0<0,12,1{No preset,Cosmos,Warm Poly,Strings 6,Glass Shimmer,Dark Drone,PWM Haze,Brass Pad,Choir Air,Sweep Pad,Slow Strings,Nebula,Init}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-g-cosmos-mini";
ext_noinit = 1;

NV = 8;
VN = 50000; VG = 50010; VT = 50020; VS = 50030;
EQO = 50300; EQT = 50600; EQN = 50900; EQV = 51200;
NWB = 52000;
CHB = 60000; CHM = 4095;
DLB = 100000; DRB = 400000; DMSK = 262143;
DAL = 700000; DAR = 702048; DAM = 2047;
memset(CHB, 0, 4096); memset(DLB, 0, 262144); memset(DRB, 0, 262144); memset(DAL, 0, 4096); memset(NWB, 0, 64);
gi = 0; loop(NV, VN[gi] = -1; VG[gi] = 0; VT[gi] = 0; VS[gi] = 0; gi += 1; );
fis = 1 / (0.002 * srate);
dcc = 1 - exp(-2 * $pi * 5 / srate); dcz = 0;

function vinit(b) instance(dtn, dct, drT, drC, nd, note, fi, nb) (
  dtn = 0; dct = 0; nd = 1; note = 60; fi = 1; nb = b;
  drT.drift_init(0.8 + rand(1) * 0.5); drC.drift_init(0.8 + rand(1) * 0.5);
);
function vblock(inc) instance(dtn, dct, drT, drC) (
  dtn = drT.drift_tick(inc) * drift * 6;
  dct = drC.drift_tick(inc) * drift * 0.2;
);
function vstart(n, v) instance(note, vel, nd, fe, ae, fi, nb) (
  ae.lv < 0.05 ? ( fi = 0; nw_start(nb); );
  note = n; vel = v / 127; nd = ins_note_detune();
  fe.vo_adsr_gate(1, 1); ae.vo_adsr_gate(1, 1);
);
function vstop() instance(fe, ae) ( fe.vo_adsr_gate(0, 0); ae.vo_adsr_gate(0, 0); );
function vkill() instance(fe, ae, flt, fi) (
  fe.st = 0; fe.lv = 0; ae.st = 0; ae.lv = 0; flt.s1 = 0; flt.s2 = 0; flt.s3 = 0; flt.s4 = 0; fi = 1;
);
function vrun() instance(os, op, ob, oy, flt, fe, ae, note, vel, nd, dtn, dct, fi, nb) local(f, inc, pwv, y, oct, vgain) (
  ae.st == 0 ? 0 : (
    f = 440 * 2 ^ ((note + vib_st - 69) / 12) * bend * ins_pitch * nd * 2 ^ (dtn / 1200);
    inc = min(f / srate, 0.45);
    pwv = min(max(pw + lfo * pwm * 0.45, 0.05), 0.95);
    y = saw_l * os.vo_saw(inc) + pul_l * op.vo_pulse(inc, pwv) + sub_l * ob.vo_sub(inc, 2) + noi_l * (rand(2) - 1);
    lay_l > 0 ? y += lay_l * oy.vo_saw(min(inc * lay_r * 2 ^ (ins_aux / 12), 0.45));
    vgain = 1 - velsens + velsens * vel;
    oct = fl_ev * fe.vo_adsr() * 6 + lfo * lfo_cut * 2.5 + keytr * (note - 60) / 12 + ins_cut + dct;
    y = flt.vo_ladder(y * 0.4, min(max(exp(fl_c2 + oct * 0.693147), 20), srate * 0.45), fl_rs, 0);
    y *= ae.vo_adsr() * vgain;
    fi < 1 ? ( fi = min(fi + fis, 1); y *= 0.5 - 0.5 * cos($pi * fi); );
    nw_run(nb, y);
  );
);

function v_start(i, n, v) (
  i == 0 ? v0.vstart(n, v) : i == 1 ? v1.vstart(n, v) : i == 2 ? v2.vstart(n, v) : i == 3 ? v3.vstart(n, v) :
  i == 4 ? v4.vstart(n, v) : i == 5 ? v5.vstart(n, v) : i == 6 ? v6.vstart(n, v) : v7.vstart(n, v);
);
function v_stop(i) (
  i == 0 ? v0.vstop() : i == 1 ? v1.vstop() : i == 2 ? v2.vstop() : i == 3 ? v3.vstop() :
  i == 4 ? v4.vstop() : i == 5 ? v5.vstop() : i == 6 ? v6.vstop() : v7.vstop();
);
function v_idle(i) (
  i == 0 ? v0.ae.st == 0 : i == 1 ? v1.ae.st == 0 : i == 2 ? v2.ae.st == 0 : i == 3 ? v3.ae.st == 0 :
  i == 4 ? v4.ae.st == 0 : i == 5 ? v5.ae.st == 0 : i == 6 ? v6.ae.st == 0 : v7.ae.st == 0;
);

function all_off() local(i) ( i = 0; loop(NV, VG[i] ? v_stop(i); VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; ); );
function note_on(n, v) local(i, best, ba, any) (
  any = 0; i = 0; loop(NV, VG[i] ? any = 1; i += 1; );
  !any ? lfo_fade = 0;
  best = -1;
  i = 0; loop(NV, VN[i] == n ? best = i; i += 1; );
  best < 0 ? ( ba = -1; i = 0; loop(NV, v_idle(i) && (best < 0 || VT[i] < ba) ? ( best = i; ba = VT[i]; ); i += 1; ); );
  best < 0 ? ( ba = -1; i = 0; loop(NV, !VG[i] && (best < 0 || VT[i] < ba) ? ( best = i; ba = VT[i]; ); i += 1; ); );
  best < 0 ? ( ba = -1; i = 0; loop(NV, best < 0 || VT[i] < ba ? ( best = i; ba = VT[i]; ); i += 1; ); );
  vage += 1; VT[best] = vage; VN[best] = n; VG[best] = 1; VS[best] = 0;
  v_start(best, n, v);
  ins_midi_hit();
);
function note_off(n) local(i) (
  i = 0; loop(NV, VN[i] == n && VG[i] ? ( pedal ? VS[i] = 1 : ( v_stop(i); VG[i] = 0; ); ); i += 1; );
);
function pedal_up() local(i) ( i = 0; loop(NV, VS[i] ? ( v_stop(i); VG[i] = 0; VS[i] = 0; ); i += 1; ); );
function q_push(ofs, t, n, v) local(i) (
  qcount < 300 ? (
    i = qcount; while (i > 0 && EQO[i - 1] > ofs) ( EQO[i] = EQO[i - 1]; EQT[i] = EQT[i - 1]; EQN[i] = EQN[i - 1]; EQV[i] = EQV[i - 1]; i -= 1; );
    EQO[i] = ofs; EQT[i] = t; EQN[i] = n; EQV[i] = v; qcount += 1;
  );
);

function note_beats(i) (
  i < 0.5 ? 0.125 : i < 1.5 ? 0.25 : i < 2.5 ? 0.375 : i < 3.5 ? 0.5 : i < 4.5 ? 0.75 : i < 5.5 ? 1 :
  i < 6.5 ? 1.5 : i < 7.5 ? 2 : i < 8.5 ? 4 : i < 9.5 ? 8 : 16;
);

function update() (
  saw_l = slider1 / 100; pul_l = slider2 / 100; pw = slider3 / 100; pwm = slider4 / 100;
  sub_l = slider5 / 100 * 0.8; noi_l = slider6 / 100 * 0.5;
  lay_l = slider7 / 100; lay_r = 2 ^ (slider8 / 1200 + slider9 - 1);
  hpf = slider10;
  cutoff = slider11; res = slider12 / 100 * 0.95; envamt = slider13 / 100; lfo_cut = slider14 / 100; keytr = slider15 / 100;
  fl_lc = log(cutoff);
  spb_t = 60 / max(tempo, 20);
  lfo_rate = slider46 >= 0.5 ? 1 / (note_beats(slider47) * spb_t) : slider24; lfo_del = slider25; lfo_shape = slider26 == 2 ? 3 : slider26 == 3 ? 4 : slider26; vibc = slider27;
  chmode = slider28; cmx_t = chmode > 0; c3_t = chmode == 3; hf0_t = slider10 == 0; hf2_t = slider10 >= 2;
  dtime = slider48 >= 0.5 ? note_beats(slider49) * spb_t * 1000 : slider29; dfb = 0; dmix = 0;
  dtc = 1 - exp(-2 * $pi * slider31 / srate);
  velsens = slider33 / 100; drift = slider34 / 100; vol_t = 10 ^ (slider35 / 20); chan = slider36;
  ins_output_setup(37); ins_stereo_setup(43);
);
function env_update() (
  v0.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v0.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
  v1.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v1.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
  v2.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v2.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
  v3.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v3.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
  v4.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v4.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
  v5.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v5.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
  v6.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v6.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
  v7.fe.vo_adsr_set(slider16, slider17, slider18 / 100, slider19); v7.ae.vo_adsr_set(slider20, slider21, slider22 / 100, slider23);
);

function pd(a, b, c, d, e, f, g, h, i) ( slider1 = a; slider2 = b; slider3 = c; slider4 = d; slider5 = e; slider6 = f; slider7 = g; slider8 = h; slider9 = i; );
function pf(a, b, c, d, e, f) ( slider10 = a; slider11 = b; slider12 = c; slider13 = d; slider14 = e; slider15 = f; );
function pe(a, b, c, d, e, f, g, h) ( slider16 = a; slider17 = b; slider18 = c; slider19 = d; slider20 = e; slider21 = f; slider22 = g; slider23 = h; );
function pl(a, b, c, d, e, f, g, h, i, j) ( slider24 = a; slider25 = b; slider26 = c; slider27 = d; slider28 = e; slider29 = f; slider30 = g; slider31 = h; slider32 = i; slider33 = j; );
function load_patch(p) (
  p == 0  ? ( pd(70, 0, 50, 0, 30, 0, 40, 12, 1);    pf(1, 1800, 15, 25, 10, 40); pe(600, 1500, 50, 2500, 500, 1000, 85, 2500);  pl(0.4, 0.8, 0, 0, 1, 450, 45, 5000, 20, 30); ) :
  p == 1  ? ( pd(80, 0, 50, 0, 45, 0, 0, 0, 1);      pf(0, 1200, 20, 30, 0, 40);  pe(300, 1200, 40, 1200, 200, 800, 90, 1200);  pl(0.5, 1.0, 1, 0, 2, 380, 30, 4000, 10, 30); ) :
  p == 2  ? ( pd(85, 0, 50, 0, 0, 0, 30, 8, 2);      pf(2, 4000, 5, 15, 0, 30);   pe(200, 1000, 70, 900, 350, 800, 90, 1100);   pl(5.5, 0.6, 1, 6, 3, 300, 25, 6000, 12, 20); ) :
  p == 3  ? ( pd(40, 0, 50, 0, 0, 0, 70, 18, 2);     pf(2, 7000, 10, 10, 5, 50);  pe(400, 2000, 60, 3000, 600, 1500, 80, 3500); pl(0.3, 1.5, 0, 0, 2, 620, 60, 8000, 35, 20); ) :
  p == 4  ? ( pd(44, 0, 50, 0, 33, 6, 33, 25, 0);    pf(0, 380, 35, 30, 25, 20);  pe(2000, 4000, 40, 5000, 2500, 3000, 90, 6000); pl(0.12, 2.0, 0, 0, 1, 900, 70, 2500, 35, 10); ) :
  p == 5  ? ( pd(0, 80, 50, 60, 30, 0, 0, 0, 1);     pf(1, 2200, 15, 20, 0, 40);  pe(400, 1500, 60, 1800, 400, 1000, 85, 2000);  pl(0.7, 0.3, 1, 0, 1, 500, 40, 5000, 18, 30); ) :
  p == 6  ? ( pd(90, 0, 50, 0, 20, 0, 30, 10, 1);    pf(1, 700, 10, 55, 0, 50);   pe(180, 900, 45, 700, 60, 600, 85, 700);      pl(5, 0.5, 0, 4, 1, 300, 20, 4000, 10, 50); ) :
  p == 7  ? ( pd(30, 50, 35, 30, 0, 12, 40, 6, 1);   pf(2, 2600, 30, 10, 15, 40); pe(800, 2000, 70, 2500, 900, 1500, 90, 2800); pl(4.8, 1.2, 0, 4, 3, 520, 40, 6000, 25, 20); ) :
  p == 8  ? ( pd(70, 30, 40, 20, 20, 0, 40, 12, 1);  pf(1, 300, 45, 70, 0, 30);   pe(2500, 5000, 30, 4000, 300, 1000, 85, 3000); pl(0.25, 0, 1, 0, 2, 480, 55, 5000, 25, 30); ) :
  p == 9  ? ( pd(80, 0, 50, 0, 0, 0, 45, 10, 1);     pf(2, 3200, 5, 10, 0, 30);   pe(1200, 2000, 80, 3000, 1500, 1500, 90, 3500); pl(5, 1.5, 1, 5, 3, 400, 30, 6000, 15, 20); ) :
  p == 10 ? ( pd(50, 40, 30, 50, 20, 8, 60, 20, 2);  pf(1, 1500, 25, 20, 30, 40); pe(3000, 4000, 60, 6000, 3000, 4000, 80, 8000); pl(0.08, 3.0, 3, 0, 3, 1100, 75, 3500, 45, 20); ) :
            ( pd(70, 0, 50, 0, 30, 0, 40, 12, 1);    pf(1, 1800, 15, 25, 10, 40); pe(600, 1500, 50, 2500, 500, 1000, 85, 2500);  pl(0.4, 0.8, 0, 0, 1, 450, 45, 5000, 20, 30); );
  slider45 = p;
  slider46 = 0; slider48 = 0;
  slider_automate(8589934591 + 17592186044416 + 35184372088832 + 140737488355328);
  panic_req = 1; update(); env_update();
);
function load_preset(k) ( load_patch(max(0, min(11, k - 1))); );

function prs_hash() local(i, h) ( h = 0; i = 1; loop(49, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 || blk_quiet ? (
      k = prs_pk; prs_pk = 0; load_preset(k);
      prs_q ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_g < 1 ? prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0; blk_quiet = 1;

function gap_clear() local(i) (
  v0.vkill(); v1.vkill(); v2.vkill(); v3.vkill(); v4.vkill(); v5.vkill(); v6.vkill(); v7.vkill();
  i = 0; loop(NV, VG[i] = 0; VS[i] = 0; VN[i] = -1; i += 1; );
  memset(CHB, 0, 4096); memset(DLB, 0, 262144); memset(DRB, 0, 262144); memset(DAL, 0, 4096); memset(NWB, 0, 64);
  clpL = clpR = 0; dcz = 0; dlpL = dlpR = dhpL = dhpR = 0; hpL = hpR = 0; lsL = lsR = 0;
  dt_cur = dtime; dxf_on = 0; qcount = 0; eqi = 0;
);

v0.vinit(NWB); v1.vinit(NWB + 6); v2.vinit(NWB + 12); v3.vinit(NWB + 18);
v4.vinit(NWB + 24); v5.vinit(NWB + 30); v6.vinit(NWB + 36); v7.vinit(NWB + 42);
ins_drift_init();
fl_ok = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
sm = 1 - exp(-1 / (0.03 * srate));
function patch_trim(p) (
  p == 0 ? 0.923 : p == 1 ? 0.525 : p == 2 ? 0.923 : p == 3 ? 1.000 : p == 4 ? 1.000 : p == 5 ? 0.668 :
  p == 6 ? 0.631 : p == 7 ? 1.000 : p == 8 ? 0.822 : p == 9 ? 0.912 : p == 10 ? 0.933 : 0.902;
);
ptr_s = patch_trim(slider45);
bend = 1; modw = 0; pedal = 0; vage = 0; qcount = 0; lfo_fade = 1;
chw = 0; chph = 0; chph2 = 0.37; dw = 0; daw = 0; dlpL = dlpR = dhpL = dhpR = 0; dmph = 0; hpL = hpR = 0; lsL = lsR = 0;
update(); env_update();
vol_s = vol_t; cmx = cmx_t; c3s = c3_t; hf0 = hf0_t; hf2 = hf2_t;
dt_cur = dtime; dxf_on = 0; dxf_c = 1 / (0.03 * srate);
pwr_init();  pwr_hum_db = -83 + 7.7;  pwr_sag = 0.12;  pwr_wu_loss = 0.4;  pwr_wu_drv = 0.5;  pwr_wu_lp = 10000;  pwr_wu_wob = 0.1;  pwr_bloom = 0;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
prs_chk();
update(); env_update();

@block
prs_chk();
update(); env_update();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? gap_clear();
g_tp = g_now; g_gpp = play_position; g_gpd = samplesblock / srate;
fl_k = 1 - exp(-1 / (0.015 * srate));
!fl_ok ? ( fl_c1 = fl_c2 = fl_lc; fl_rs = res; fl_ev = envamt; fl_ok = 1; );
qcount = 0;
while (midirecv(mofs, m1, m2, m3)) (
  midisend(mofs, m1, m2, m3);
  ins_chan_ok(m1, chan) ? (
    st = m1 & 0xF0;
    st == 0x90 && m3 > 0 ? ins_midi_hit();
    st == 0x90 || st == 0x80 ? q_push(mofs, st == 0x90 && m3 > 0, m2, m3) :
    st == 0xE0 ? bend = ins_bend(m2, m3, 2) :
    st == 0xB0 ? (
      m2 == 1 ? modw = m3 / 127 :
      m2 == 64 ? ( pedal = m3 >= 64; !pedal ? q_push(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? q_push(mofs, 3, 0, 0);
    );
  );
);
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( q_push(0, 3, 0, 0); );
gfx_pst_prev = gfx_pst;
panic_d ? ( panic_req = 1; panic_d = 0; );
panic_req ? ( all_off(); panic_req = 0; );
eqi = 0; spos = 0;
ins_drift_block(drift, samplesblock);
dvi = 0.35 * samplesblock / srate;
v0.vblock(dvi); v1.vblock(dvi); v2.vblock(dvi); v3.vblock(dvi); v4.vblock(dvi); v5.vblock(dvi); v6.vblock(dvi); v7.vblock(dvi);
lfo_inc = lfo_del > 0.01 ? 1 / (lfo_del * srate) : 1;
chmode == 2 ? ( chr = 0.863; chc = 3.4; chs = 1.9; ) : ( chr = 0.513; chc = 3.4; chs = 1.7; );
chr2 = 0.863; chc2 = 4.2; chs2 = 1.9;
!ch_i0 ? ( chrs = chr;  chss = chs;  hpcs = 1 - exp(-2 * $pi * (hpf == 2 ? 240 : 720) / srate);  ch_i0 = 1; );
hpc = 1 - exp(-2 * $pi * (hpf == 2 ? 240 : 720) / srate); lsc = 1 - exp(-2 * $pi * 120 / srate);
pwr_block(1);
blk_quiet = blk_pk < 0.0001; blk_pk = 0;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (eqi < qcount && (EQO[eqi] <= spos || spos >= samplesblock - 1)) (
  et = EQT[eqi];
  et == 1 ? note_on(EQN[eqi], EQV[eqi]) : et == 0 ? note_off(EQN[eqi]) : et == 2 ? pedal_up() : all_off();
  eqi += 1;
);
spos += 1;

lfo_fade = min(lfo_fade + lfo_inc, 1);
lfo = lfo1.vo_lfo(lfo_rate, lfo_shape) * lfo_fade;
vib_st = lfo * (vibc + modw * 40) / 100;

fl_c1 += (fl_lc - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (res - fl_rs) * fl_k; fl_ev += (envamt - fl_ev) * fl_k;
x = v0.vrun() + v1.vrun() + v2.vrun() + v3.vrun() + v4.vrun() + v5.vrun() + v6.vrun() + v7.vrun();
dcz += (x - dcz) * dcc; x -= dcz;

hf0 += (hf0_t - hf0) * sm; hf2 += (hf2_t - hf2) * sm; hpcs += (hpc - hpcs) * sm;
lsL += (x - lsL) * lsc; hpL += (x - hpL) * hpcs;
x += hf0 * lsL * 0.6 - hf2 * hpL;

chmode > 0 || cmx > 0.00001 ? (
  CHB[chw] = x;
  chss += (chs - chss) * sm; chrs += (chr - chrs) * sm; c3s += (c3_t - c3s) * sm;
  chph += chrs / srate; chph -= floor(chph);
  ctri = 1 - 4 * abs(chph - 0.5);
  cdl = (chc + chss * ctri) * 0.001 * srate; cdr = (chc - chss * ctri) * 0.001 * srate;
  ci = floor(cdl); cf = cdl - ci; cwl = CHB[(chw - ci) & CHM] * (1 - cf) + CHB[(chw - ci - 1) & CHM] * cf;
  ci = floor(cdr); cf = cdr - ci; cwr = CHB[(chw - ci) & CHM] * (1 - cf) + CHB[(chw - ci - 1) & CHM] * cf;
  c3s > 0.00001 ? (
    chph2 += chr2 / srate; chph2 -= floor(chph2);
    ctri = 1 - 4 * abs(chph2 - 0.5);
    cdl = (chc2 - chs2 * ctri) * 0.001 * srate; cdr = (chc2 + chs2 * ctri) * 0.001 * srate;
    ci = floor(cdl); cf = cdl - ci; cwl += 0.5 * c3s * (CHB[(chw - ci) & CHM] * (1 - cf) + CHB[(chw - ci - 1) & CHM] * cf - cwl);
    ci = floor(cdr); cf = cdr - ci; cwr += 0.5 * c3s * (CHB[(chw - ci) & CHM] * (1 - cf) + CHB[(chw - ci - 1) & CHM] * cf - cwr);
  );
  chw = (chw + 1) & CHM;
  clpL += (cwl - clpL) * 0.45; clpR += (cwr - clpR) * 0.45;
  cmx += (cmx_t - cmx) * sm;
  xL = x * (1 - 0.25 * cmx) + clpL * 0.75 * cmx; xR = x * (1 - 0.25 * cmx) + clpR * 0.75 * cmx;
) : ( xL = x; xR = x; );

pwr_in(xL, xR);  xL = pwr_l;  xR = pwr_r;
pwr_out(xL, xR);  xL = pwr_l;  xR = pwr_r;

vol_s += (vol_t - vol_s) * sm;
ptr_s = patch_trim(slider45);
oL = ostL.ost_band((xL * 0.45) * ptr_s) * vol_s;
oR = ostR.ost_band((xR * 0.45) * ptr_s) * vol_s;
ins_stereo(oL, oR); ost_out(ins_sl, ins_sr);
spl0 = ost_l;
spl1 = ost_r;

prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );

blk_pk = max(blk_pk, max(abs(spl0), abs(spl1)));
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);
mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(ink, 1); gfx_measurestr("DRIFT", tw, th);
  gfx_x = dk_ox + cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr("DRIFT");
);
ui_begin(900, 355);
mk_face = 0x3A393D; mk_band = 0x141518; mk_ink = 0xEDE6D8; mk_tab = 0xD0453A; mk_acc = 0xFFC870;
mk_sub = 0x2F2B2E; mk_ink2 = 0xC8C4BC;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 15 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, ql, qr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  ql = gx - hw; qr = gx + hw; il = floor(ql); ir = floor(qr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = qr - ql; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - ql; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = qr - ir; qr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(x, y, r, a, act, col) local(KX, KY, KRD, i, t) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
  ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KRD * 0.76, 1, 1);
  ui_col(col); gfx_circle(KX, KY, KRD * 0.72, 1, 1);
  i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KRD * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KRD * 0.62, -1.7, -0.3, 1 * sc);
  ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.72);
);
function mg_dots(x, y, r, c) local(i, t, rs, px, py) (
  rs = r + 8; i = 0;
  loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_zero && i == 2 ? ( gfx_setfont(11); ui_col(c); mg_ctxt(px, py - 2, "0"); )
    : (i == 0 || i == 4) ? ( ui_col(c); mg_disc(px, py, 1.8); );
    i += 1; );
);
function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, col) local(v, n, dx, dy, hov, did, act, a, stp) (
  stp = cm_step; cm_step = 0;
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi, lg); stp ? v = floor(v + 0.5);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    stp ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(mg_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
      slider(idx) = mg_n2v(n, lo, hi, lg);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  mg_dots(cx, cy, r, mk_ink2); mg_cshadow(cx, cy, r);
  mg_kbody(cx, cy, r, a, act, col);
  mg_zero = 0;
  act;
);
function mg_hz(v) ( v >= 1000 ? sprintf(#mgh, "%.1f kHz", v / 1000) : sprintf(#mgh, "%d Hz", v + 0.5); #mgh; );
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, col, kind, name) local(k, v, m) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) : kind == 1 ? sprintf(#mgv, "%+d %%", floor(v + 0.5)) :
  kind == 2 ? ( v >= 1000 ? sprintf(#mgv, "%.2f s", v / 1000) : sprintf(#mgv, "%d ms", floor(v + 0.5)); ) :
  kind == 4 ? strcpy(#mgv, mg_hz(v)) : kind == 6 ? ( v < 0.5 ? strcpy(#mgv, "OFF") : sprintf(#mgv, "%d %%", floor(v + 0.5)); ) :
  kind == 7 ? ( m = floor(v + 0.5); strcpy(#mgv, m == 0 ? "1/32" : m == 1 ? "1/16" : m == 2 ? "1/16 D" : m == 3 ? "1/8" : m == 4 ? "1/8 D" : m == 5 ? "1/4" : m == 6 ? "1/4 D" : m == 7 ? "1/2" : "1 BAR"); ) :
  sprintf(#mgv, "%+.1f dB", v);
  gfx_setfont(10); ui_col(k ? mk_acc : mk_ink); mg_ctxt(cx, ly, k ? #mgv : name);
  k;
);
function mg_vu(x, y, w, h, vdb, pk) local(fx, fy, fw, fh, rad, px, py, i, t, a, s, ang0, ang1, c) (
  ui_vu_dim = 0;
  ui_spill((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 1);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, h + 18);
  ui_cola(0x000000, 0.35); mg_r(x - 9, y - 9, w + 18, 3); mg_r(x - 9, y - 6, 3, h + 15);
  ui_cola(0xFFFFFF, 0.10); mg_r(x - 9, y + h + 7, w + 18, 2); mg_r(x + w + 7, y - 9, 2, h + 16);
  ui_col(0x0C0C0C); mg_rr(x - 3, y - 3, w + 6, h + 6, 5);
  fx = x + 3; fy = y + 3; fw = w - 6; fh = h - 6;
  ui_glow(floor(fx * sc), floor(fy * sc), fw * sc, fh * sc, 1);
  rad = min(w * 0.5, h * 0.95); px = fx + fw / 2; py = fy + fh + rad * 0.12;
  ang0 = -0.72; ang1 = 1.44;
  ui_col(0x1A1A1C); ui_ssarc(px * sc, py * sc, rad * 0.78 * sc, ang0, ang0 + ang1 * 0.72, 1.2 * sc);
  ui_col(0xB8322A); ui_ssarc(px * sc, py * sc, rad * 0.8 * sc, ang0 + ang1 * 0.72, ang0 + ang1, 2.6 * sc);
  gfx_setfont(11); i = 0;
  loop(8, t = i == 0 ? 0 : i == 1 ? 0.2 : i == 2 ? 0.36 : i == 3 ? 0.5 : i == 4 ? 0.62 : i == 5 ? 0.72 : i == 6 ? 0.86 : 1;
    a = ang0 + ang1 * t; c = t > 0.72 ? 0xB8322A : 0x1A1A1C;
    ui_col(c); mg_disc(px + sin(a) * rad * 0.86, py - cos(a) * rad * 0.86, i == 5 ? 1.8 : 1.3);
    (i == 0 || i == 1 || i == 3 || i == 5 || i == 7) ? (
      s = i == 0 ? "20" : i == 1 ? "10" : i == 3 ? "5" : i == 5 ? "0" : "3";
      mg_ctxt(px + sin(a) * rad * 1.0, py - cos(a) * rad * 1.0, s); );
    i += 1; );
  gfx_setfont(6); ui_col(0x1A1A1C); mg_ctxt(px, fy + fh - 21, "VU");
  t = vdb <= -40 ? 0 : (10 ^ (vdb / 20) - 0.1) / (1.4125 - 0.1);
  t = min(max(t, -0.05), 1.05);
  mg_dt = min(max(time_precise() - mg_vlt, 0.001), 0.05); mg_vlt = time_precise();
  mg_vvel += (160 * (t - mg_vpos) - 18 * mg_vvel) * mg_dt; mg_vpos = min(max(mg_vpos + mg_vvel * mg_dt, -0.06), 1.06);
  a = ang0 + ang1 * mg_vpos;
  ui_cola(0x5A3A10, 0.25); ui_ssline((px + 1.5) * sc, (py + 1.5) * sc, (px + 1.5 + sin(a) * rad * 0.92) * sc, (py + 1.5 - cos(a) * rad * 0.92) * sc, 1.2 * sc, 1);
  ui_col(0x151515); ui_ssline(px * sc, py * sc, (px + sin(a) * rad * 0.92) * sc, (py - cos(a) * rad * 0.92) * sc, 1.3 * sc, 1);
  ui_col(0x1A1A1C); mg_rr(fx + fw / 2 - 18, fy + fh - 9, 36, 9, 2);
  ui_col(0x050506); mg_disc(fx + fw - 8, fy + 8, 4.2);
  ui_col(pk ? 0xFF3A2A : 0x5A1410); mg_disc(fx + fw - 8, fy + 8, 3);
  pk ? ( ui_cola(0xFF3A2A, 0.25); mg_disc(fx + fw - 8, fy + 8, 6); );
);
function mg_dwell(x, y, w, h) (
  ui_col(ui_mix(mk_face, 0x000000, 0.45)); mg_r(x, y, w, h);
  ui_col(ui_mix(mk_sub, 0x000000, 0.45)); mg_r(x + 2, y + 2, w - 3, h - 3);
  ui_cola(0x000000, 0.30); mg_r(x + 2, y + 2, w - 3, 2); mg_r(x + 2, y + 4, 2, h - 5);
  ui_cola(0xFFFFFF, 0.18); mg_r(x, y + h, w + 1, 1); mg_r(x + w, y, 1, h);
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function cm_sec(x, y, w, h, title, lc) local(b, c, tw, th) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
