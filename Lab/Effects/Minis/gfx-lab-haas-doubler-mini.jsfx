desc:Haas Doubler Mini [stereo doubler] (GFX Lab)
//tags: haas doubler double tracking adt stereo width utility mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider23:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:1<0,2,1{L/R,LCR,Spread}>-Mode
slider2:12<1,40,0.1>-Delay (ms)
slider3:0<0,4,1{x2,x3,x4,x5,x6}>-Right multiplier
slider4:0<0,1,1{Off,On}>-Swap sides
slider5:0<-24,6,0.1>-Doubled level (dB)
slider6:150<20,1000,1>-Low cut (Hz)
slider7:100<0,100,1>-Width (%)
slider8:0.5<0,5,0.01>-Time drift (ms)
slider9:15<0,100,1>-Pan drift (%)
slider10:0.5<0,6,0.1>-Level drift (dB)
slider11:0.25<0.02,2,0.01>-Drift speed (Hz)
slider12:0<0,1,1{Mono sum,Stereo}>-Input
slider13:0<-24,12,0.1>-Output (dB)
slider14:0<0,1,1{Off,On}>-Mono check
slider15:1<0,1,1{Off,On}>-Dry
slider16:0<-24,12,0.1>-Input trim (dB)
slider17:1<0,1,1{Off,On}>-Input guard
slider18:0<-50,50,0.1>-Detune left (cents)
slider19:0<-50,50,0.1>-Detune right (cents)
slider20:50<0,100,1>-Drift (%)
slider21:0<0,1,1{Off,On}>-Bypass
slider22:prs_sel=0<0,9,1{No preset,Init,Short,Med,Long,Classic Haas,Wide Spread,Super Wobble,Vintage ADT,Mono Safe}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(8388607, v); );
function psw_allg(v) ( slider_show(8388607, v); );
#ui_man = "gfx-lab-haas-doubler-mini";
ext_noinit = 1;

function hp_proc(x) instance(z1, z2) local(y) (
  y = hb0 * x + z1;
  z1 = hb1 * x - ha1 * y + z2;
  z2 = hb2 * x - ha2 * y;
  y;
);

function dread(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = wp - d;
  rp < 0 ? rp += bufsize;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + bufsize - 1) & mask];
  x0  = buf[i & mask];
  x1  = buf[(i + 1) & mask];
  x2  = buf[(i + 2) & mask];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);

function pshift(buf, d0, rt, on) instance(ph, amt) local(ws, p2, y, w) (
  amt += ((on ? 1 : 0) - amt) * psm;
  amt < 0.0001 ? ( ph = 0; dread(buf, d0); ) : (
    ws = 0.03 * srate;
    ph += rt / ws; ph -= floor(ph);
    p2 = ph + 0.5; p2 -= floor(p2);
    w = sin($pi * ph); w *= w;
    y = w * dread(buf, d0 + ph * ws) + (1 - w) * dread(buf, d0 + p2 * ws);
    amt > 0.9999 ? y : amt * y + (1 - amt) * dread(buf, d0);
  );
);

function update() local(w0, cw, al, q0) (
  mode = slider1;
  base = slider2;
  rmult = slider3 + 2;
  sideA = slider4 ? 1 : -1;
  sideB = -sideA;
  dbl_t = 10 ^ (slider5 / 20);
  slider6 != lastHP ? (
    lastHP = slider6;
    w0 = 2 * $pi * min(slider6, srate * 0.45) / srate;
    cw = cos(w0); al = sin(w0) / (2 * 0.70710678);
    q0 = 1 + al;
    hb0 = (1 + cw) * 0.5 / q0; hb1 = -(1 + cw) / q0; hb2 = hb0;
    ha1 = -2 * cw / q0; ha2 = (1 - al) / q0;
  );
  wid_t = slider7 / 100;
  drift_macro(slider20);
  tdrift = slider8 * dm_a;
  pdrift = min(slider9 / 100 * dm_a, 1);
  ldrift = slider10 * dm_a;
  dspeed = slider11 * dm_s;
  inmode = slider12;
  out_t = 10 ^ (slider13 / 20);
  monochk = slider14;
  dryon = slider15;
  in_setup(slider16, slider17);
  cA = sideA < 0 ? slider18 : slider19; cB = sideA < 0 ? slider19 : slider18;
  rtA = 1 - 2 ^ (cA / 1200); rtB = 1 - 2 ^ (cB / 1200);
  onA = abs(cA) >= 0.05; onB = abs(cB) >= 0.05;
  mode == 0 ? ( dA_t = 0; dB_t = base; ) : ( dA_t = base; dB_t = base * rmult; );
  hd_key = slider1 + slider3 * 4 + slider4 * 32 + slider12 * 64;
);
function setp(m, d, x, lv, lc, w, td, pd, ld, sp) (
  slider1 = m; slider2 = d; slider3 = x; slider5 = lv; slider6 = lc;
  slider7 = w; slider8 = td; slider9 = pd; slider10 = ld; slider11 = sp;
);
function load_preset(p) (
  p == 1 ? (
    setp(1, 12, 0, 0, 150, 100, 0.5, 15, 0.5, 0.25);
    slider4 = 0; slider12 = 0; slider13 = 0; slider14 = 0; slider15 = 1;
    slider16 = 0; slider17 = 1; slider18 = 0; slider19 = 0; slider20 = 50;
  ) :
  p == 2 ? setp(1,  6, 0, -3, 150, 100, 0.2,  5, 0.3, 0.2 ) :
  p == 3 ? setp(1, 12, 0,  0, 150, 100, 0.5, 15, 0.5, 0.25) :
  p == 4 ? setp(1, 20, 0, -4, 200, 100, 0.8, 15, 0.5, 0.2 ) :
  p == 5 ? setp(0, 18, 0,  0, 120, 100, 0,    0, 0,   0.25) :
  p == 6 ? setp(2, 12, 0,  0, 100, 100, 0.6, 20, 0.5, 0.3 ) :
  p == 7 ? setp(2, 12, 1,  0, 120, 100, 4,   60, 3,   1.5 ) :
  p == 8 ? setp(0, 22, 0, -1,  80,  70, 2.5,  0, 1,   0.7 ) :
  p == 9 ? setp(1,  8, 1, -6, 300,  70, 0.3, 10, 0.3, 0.2 );
  slider_automate(2097151);
);
function hd_clear() (
  memset(0, 0, bufsize * 2);
  hpA.z1 = 0; hpA.z2 = 0; hpB.z1 = 0; hpB.z2 = 0;
);
bufsize = 131072; mask = bufsize - 1;
bufA = 0; bufB = bufsize;
memset(0, 0, bufsize * 2);
wp = 0;
msr = srate / 1000;
sm = 1 - exp(-1 / (0.03 * srate));
psm = 1 - exp(-1 / (0.02 * srate));
hd_dkr = 1 / (0.012 * srate); hd_dk = 1; hd_dst = 0;
hd_fis = 1 / (0.01 * srate); hd_fi = 1; hd_n = 1000000000; hd_nr = 1 / (0.01 * srate);
tdA.drift_init(0.8 + rand(1) * 0.5); tdB.drift_init(0.8 + rand(1) * 0.5);
pdA.drift_init(0.8 + rand(1) * 0.5); pdB.drift_init(0.8 + rand(1) * 0.5);
ldA.drift_init(0.8 + rand(1) * 0.5); ldB.drift_init(0.8 + rand(1) * 0.5);
hpA.z1 = 0; hpA.z2 = 0; hpB.z1 = 0; hpB.z2 = 0;
in_init();
pwr_init(); pwr_wu_loss = 0.4; pwr_wu_drv = 0.6; pwr_wu_lp = 12000; pwr_bloom = 0;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
lastHP = -1;
update();
hd_kon = hd_key;
dA_s = dA_t * msr; dB_s = dB_t * msr;
dbl_s = dbl_t; out_s = out_t; wid_s = wid_t; dry_s = dryon;
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(21);
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(21, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k); hd_dst = 1;
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); hd_dst = 1; prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
function hd_chk() (
  hd_dst == 0 ? (
    hd_k2 = slider1 + slider3 * 4 + slider4 * 32 + slider12 * 64;
    hd_k2 != hd_kon ? hd_dst = 1 : update();
  );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
hd_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
hd_now = time_precise();
hd_tp > 0 && hd_now - hd_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > hd_gpp && play_position - hd_gpp < 4 * hd_gpd + 0.05) ? ( hd_clear(); hd_fi = 0; hd_n = 0; );
hd_tp = hd_now; hd_gpp = play_position; hd_gpd = samplesblock / srate;
pwr_block(slider21 < 0.5);
hd_chk();
hd_vu_d = max(hd_vu_d, sqrt(hd_msq / max(samplesblock, 1))); hd_msq = 0;
hd_pk_d = max(hd_pk_d, hd_pkm); hd_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
hd_dst == 1 ? ( hd_dk -= hd_dkr; hd_dk <= 0 ? ( hd_dk = 0; update(); hd_kon = hd_key; hd_dst = 2; ); ) :
hd_dst == 2 ? ( hd_dk += hd_dkr; hd_dk >= 1 ? ( hd_dk = 1; hd_dst = 0; ); );
in_process(spl0, spl1);
pwr_in(in_l, in_r);
inL = pwr_l; inR = pwr_r;
inmode == 0 ? ( sL = 0.5 * (inL + inR); sR = sL; ) : ( sL = inL; sR = inR; );
bufA[wp] = sL; bufB[wp] = sR;
dinc = dspeed / srate;
tA = tdA.drift_tick(dinc); tB = tdB.drift_tick(dinc);
pA = pdA.drift_tick(dinc); pB = pdB.drift_tick(dinc);
lA = ldA.drift_tick(dinc); lB = ldB.drift_tick(dinc);
dbl_s += (dbl_t - dbl_s) * sm;
out_s += (out_t - out_s) * sm;
wid_s += (wid_t - wid_s) * sm;
dry_s += (dryon - dry_s) * sm;
dA_s  += ((dA_t + tdrift * tA) * msr - dA_s) * sm;
dB_s  += ((dB_t + tdrift * tB) * msr - dB_s) * sm;
dA = min(max(dA_s, 2), bufsize - 4);
dB = min(max(dB_s, 2), bufsize - 4);
mode == 0 ? (
  yA = onA || psA.amt > 0.0001 ? psA.pshift(bufA, 2, rtA, onA) : sL; gA = dry_s;
  cL = 0; cR = 0;
) : (
  yA = hpA.hp_proc(psA.pshift(bufA, dA, rtA, onA)); gA = dbl_s;
  mode == 1 ? ( cL = sL * dry_s; cR = sR * dry_s; ) : ( cL = 0; cR = 0; );
);
yB = hpB.hp_proc(psB.pshift(bufB, dB, rtB, onB)); gB = dbl_s;
hd_n < 100000000 ? (
  hd_n += 1;
  hd_q = min(max((hd_n - dB - 64) * hd_nr, 0), 1); gB *= hd_q * hd_q * (3 - 2 * hd_q);
  mode != 0 ? ( hd_q = min(max((hd_n - dA - 64) * hd_nr, 0), 1); gA *= hd_q * hd_q * (3 - 2 * hd_q); );
  hd_n > 4 * srate ? hd_n = 1000000000;
);
gA *= exp(ldrift * lA * 0.11512925);
gB *= exp(ldrift * lB * 0.11512925);
posA = sideA * (1 - pdrift * (0.5 + 0.5 * pA));
posB = sideB * (1 - pdrift * (0.5 + 0.5 * pB));
angA = (posA + 1) * 0.25 * $pi;
angB = (posB + 1) * 0.25 * $pi;
oL = cL + yA * gA * cos(angA) + yB * gB * cos(angB);
oR = cR + yA * gA * sin(angA) + yB * gB * sin(angB);
mid  = 0.5 * (oL + oR);
side = 0.5 * (oL - oR) * wid_s;
monochk ? side = 0;
hd_dst ? ( hd_dkg = hd_dk * hd_dk * (3 - 2 * hd_dk); mid *= hd_dkg; side *= hd_dkg; );
oL = (mid + side) * out_s;
oR = (mid - side) * out_s;
pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
hd_fi < 1 ? (
  hd_fi = min(hd_fi + hd_fis, 1); hd_z = hd_fi * hd_fi * (3 - 2 * hd_fi);
  oL = by_il + (oL - by_il) * hd_z; oR = by_ir + (oR - by_ir) * hd_z;
);
spl0 = oL; spl1 = oR;
wp = (wp + 1) & mask;
by_out();
hd_msq += 0.5 * (spl0 * spl0 + spl1 * spl1);
hd_pkm = max(hd_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x3A2A46; mk_band = 0x100A14; mk_ink = 0xF2EEF4; mk_tab = 0xE8B84A; mk_tink = 0x2A1A08;
mk_sub = 0x241A2C; mk_hot = 0xF6E2B0; mk_lime = 0xE8B84A;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.3);
mg_byp = 21;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, p0, p1) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; p0 = floor(xl); p1 = floor(xr);
  hw > 0 ? loop(n,
    p0 == p1 ? ( gfx_a = xr - xl; gfx_rect(p0, j, 1, 1); ) : (
      gfx_a = p0 + 1 - xl; gfx_rect(p0, j, 1, 1);
      gfx_a = 1; p1 > p0 + 1 ? gfx_rect(p0 + 1, j, p1 - p0 - 1, 1);
      gfx_a = xr - p1; xr > p1 ? gfx_rect(p1, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(mk_sub, 0x000000, 0.3)); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.3)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0x1A1A1C); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0xF4F6F8); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(mk_tink); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KR, i, t) (
  KX = x * sc; KY = y * sc; KR = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KR, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KR * 0.8, KY - cos(t) * KR * 0.8, KX + sin(t) * KR * 0.95, KY - cos(t) * KR * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KR * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KR * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KR * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KR * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KR * 0.72);
  ) : (
    ui_col(0x2C2E33); gfx_circle(KX, KY, KR, 1, 1);
    ui_col(0x121315); gfx_circle(KX, KY, KR * 0.8, 1, 1);
