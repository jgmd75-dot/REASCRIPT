desc:Echofish Mini [filter with delay] (GFX Lab)
//tags: filter envelope auto-wah sample-and-hold delay echo tape
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-input, gfx-lab-output, gfx-lab-clip, gfx-lab-lfo, gfx-lab-os, gfx-lab-bypass, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider50:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,2,1{Env,S&H,Env+S&H}>-Mode
slider2:0<0,3,1{LP,BP,HP,Notch}>-Filter
slider3:250<60,3000,1>-Freq (Hz)
slider4:3.5<0,6,0.01>-Depth (octaves)
slider5:3<0.5,15,0.01>-Peak
slider6:1<0,1,1{Down,Up}>-Direction
slider7:0<0,1,1{Low,High}>-Range
slider8:50<0,100,1>-Sens (%)
slider9:20<0,100,1>-Response (%)
slider10:2<0,4,1{1/2,1/4,1/8,1/16,1/32}>-Rate
slider11:0<0,2,1{x1,x2,x4}>-Mult
slider12:15<0,100,1>-Glide (%)
slider13:1<0,1,1{Free,Loop}>-Pattern
slider14:20<0,100,1>-Drive (%)
slider15:100<0,100,1>-Mix (%)
slider16:-2<-12,12,0.1>-Filter level (dB)
slider17:1<0,1,1{Bypass,On}>-Effect
slider18:0<0,1,1{Off,On}>-Hold
slider19:0<-24,12,0.1>-Input trim (dB)
slider20:1<0,1,1{Off,On}>-Input guard
slider21:0<0,100,1>-Band sat (%)
slider22:30<0,100,1>-Bias (%)
slider23:120<40,400,1>-Sat low band (Hz)
slider24:6000<2000,16000,10>-Sat high band (Hz)
slider25:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider26:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider27:0<0,2,1{Tape,Bucket,Digital}>-Echo type
slider28:1<0,1,1{Off,On}>-Echo sync to tempo
slider29:375<20,2000,1:log>-Echo time (ms)
slider30:10<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Echo time (sync)
slider31:35<0,110,1>-Echo feedback (%)
slider32:30<0,100,1>-Echo drive (%)
slider33:120<20,1000,1:log>-Echo lo cut (Hz)
slider34:6000<1000,20000,10:log>-Echo hi cut (Hz)
slider35:20<0,100,1>-Echo duck (%)
slider36:0<0,1,1{Off,On}>-Echo ping-pong
slider37:0<0,1,1{Off,On}>-Echo freeze
slider38:20<0,100,1>-Echo wow (%)
slider39:15<0,100,1>-Echo flutter (%)
slider40:0.3<0.01,2,0.01:log>-Echo drift speed (Hz)
slider41:25<0,100,1>-Echo mix (%)
slider42:100<0,100,1>-Echo width (%)
slider43:0<-24,12,0.1>-Output (dB)
slider44:0<0,3,1{Off,-3 dB,-6 dB,-9 dB}>-Echo vintage EQ (500 Hz cut)
slider45:0<0,1,1{Filter then Echo,Echo then Filter}>-Order
slider46:50<0,100,1>-Drift (%)
slider47:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider48:byp=0<0,1,1{Off,On}>-Bypass
slider49:prs_sel=0<0,12,1{No preset,Init,Funk Slap,Bass Quack,Ship Steps,Random Gurgle,Envelope Steps,Notch Wash,Slow Talker,Clav Wah,Synth Blips,Lowpass Bloom,Dub Talker}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-lfo.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(1125899906842623, v); );
function psw_allg(v) ( slider_show(1125899906842623, v); );
#ui_man = "gfx-lab-echofish-mini";
#ef_pm = "Init|Funk Slap|Bass Quack|Ship Steps|Random Gurgle|Envelope Steps|Notch Wash|Slow Talker|Clav Wah|Synth Blips|Lowpass Bloom|Dub Talker";
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; mg_ed = 0; );
ui_dflt = 1;
rs_f = 1;
ext_noinit = 1;
pwr_init();
pwr_wu_loss = 0.8; pwr_wu_drv = 1; pwr_wu_lp = 9000; pwr_wu_wob = 0.3; pwr_bloom = 0;

q_VTC = 32000;
Q_BKT = 40000;
COEF = 50000;
DLB = 60000;
q_bufL = 100000;
memset(DLB, 0, 128);

function th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
EF_F3 = 0.5 + 4 / 3 * log(4) - 3;
function ef_thF(u) ( abs(u) < 3 ? u * u * 0.055555556 + 1.3333333333 * log(1 + u * u * 0.3333333333) : abs(u) + EF_F3; );
function ef_th(u) instance(u1, f1) local(f, d, y) (
  f = ef_thF(u); d = u - u1;
  y = abs(d) > 0.00001 ? (f - f1) / d : th(0.5 * (u + u1));
  u1 = u; f1 = f;
  y;
);
function sh_set(f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, ga, n, sa) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); ga = 10 ^ (gdb / 40);
  sa = 2 * sqrt(ga) * al; n = (ga + 1) - (ga - 1) * cw + sa;
  b0 = ga * ((ga + 1) + (ga - 1) * cw + sa) / n; b1 = -2 * ga * ((ga - 1) + (ga + 1) * cw) / n;
  b2 = ga * ((ga + 1) + (ga - 1) * cw - sa) / n; a1 = 2 * ((ga - 1) - (ga + 1) * cw) / n; a2 = ((ga + 1) - (ga - 1) * cw - sa) / n;
);
function sh_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function svf(x) instance(s1, s2) local(v1, v2, v3) (
  v3 = x - s2; v1 = fa1 * s1 + fa2 * v3; v2 = s2 + fa2 * s1 + fa3 * v3;
  s1 = 2 * v1 - s1; s2 = 2 * v2 - s2;
  s1 = th(s1 * 0.5) * 2;
  ftype == 0 ? v2 : ftype == 1 ? v1 * fk : ftype == 2 ? x - fk * v1 - v2 : x - fk * v1;
);
function rnd(i) ( i = sin(i * 12.9898 + 4.1) * 43758.5453; i - floor(i); );

function ef_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function ef_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function ef_bmz() instance(z1, z2) ( z1 = z2 = 0; );
C_F1 = COEF; C_F2 = COEF + 5; C_F3 = COEF + 10; C_F4 = COEF + 15;
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_run(x) instance(zA, zB, zC, zD, fh, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = zA.ef_bm(x, C_F1);
  ha = abs(h); fh += (ha - fh) * (ha > fh ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fh, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fh;
  e = zD.ef_bm(zC.ef_bm(zB.ef_bm(e, C_F2), C_F3), C_F4);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_clr() instance(zA, zB, zC, zD, fh, fp, fe) ( zA.ef_bmz(); zB.ef_bmz(); zC.ef_bmz(); zD.ef_bmz(); fh = fp = fe = 0; );

function fl_tick(x) instance(pf, adI, shI, sv, adO, shO, fz) local(u, y) (
  u = shI.bq_run(adI.ef_th(pf.clp_pf_run(x) * dg)) / dg * (1 + (dg - 1) * 0.3);
  y = sv.svf(u);
  y = shO.bq_run(adO.ef_th(y * 0.7)) / 0.7;
  fz_o > 0.0001 ? y += fz.fz_run(y);
  x + (y - x) * ef_mx;
);
function fl_clr() instance(pf, adI, shI, sv, adO, shO, fz) (
  pf.clp_pf_reset(); adI.u1 = adI.f1 = 0; adO.u1 = adO.f1 = 0; shI.sh_clr(); shO.sh_clr(); sv.s1 = sv.s2 = 0; fz.fz_clr();
);
function fl_coef() (
  ef_fs = srate * os_f;
  chL.shI.sh_set(0.3702 * ef_fs, 0.4926, 19.582, ef_fs); chR.shI.sh_set(0.3702 * ef_fs, 0.4926, 19.582, ef_fs);
  chL.shO.sh_set(0.3705 * ef_fs, 0.4658, 15.673, ef_fs); chR.shO.sh_set(0.3705 * ef_fs, 0.4658, 15.673, ef_fs);
  ef_bqc(C_F1, 4, 3500, 0, 0.7071, ef_fs); ef_bqc(C_F2, 4, 5500, 0, 0.7071, ef_fs);
  ef_bqc(C_F3, 0, 8000, 4, 0.7, ef_fs); ef_bqc(C_F4, 2, 12000, -6, 0.7, ef_fs);
  fz_a = 1 - exp(-1 / (0.003 * ef_fs)); fz_r = 1 - exp(-1 / (0.12 * ef_fs)); fz_w = 1 - exp(-1 / (0.06 * ef_fs));
);
function fl_os(l, r) (
  os_f == 1 ? ( fo_l = chL.fl_tick(l); fo_r = chR.fl_tick(r); ) : (
    osuL.os_up(l); osuR.os_up(r);
    oa0 = chL.fl_tick(osuL.s0); ob0 = chR.fl_tick(osuR.s0);
    oa1 = chL.fl_tick(osuL.s1); ob1 = chR.fl_tick(osuR.s1);
    os_f > 2 ? (
      oa2 = chL.fl_tick(osuL.s2); ob2 = chR.fl_tick(osuR.s2);
      oa3 = chL.fl_tick(osuL.s3); ob3 = chR.fl_tick(osuR.s3);
    );
    fo_l = osdL.os_dn(oa0, oa1, oa2, oa3); fo_r = osdR.os_dn(ob0, ob1, ob2, ob3);
  );
);

function update() (
  mode = slider1; ftype = slider2; fbase = slider3 * (slider7 ? 2 : 1); depth = slider4; fk = 1 / slider5;
  dir = slider6 ? 1 : -1;
  sensg = 10 ^ ((slider8 - 50) / 25) * 4;
  env_a = dy_ms(1 + slider9 / 100 * 19); env_r = dy_ms(30 + slider9 / 100 * 770);
  spb = (slider10 == 0 ? 0.5 : slider10 == 1 ? 1 : slider10 == 2 ? 2 : slider10 == 3 ? 4 : 8) * (slider11 == 0 ? 1 : slider11 == 1 ? 2 : 4);
  glide = slider12 / 100; loopp = slider13;
  dg = 1 + slider14 / 100 * 4;
  mix_t = slider15 / 100; og = 10 ^ (slider16 / 20); fx_on = slider17; hold = slider18;
  in_setup(slider19, slider20);
  fz_t = 0.33 * min(max((slider14 - 50) / 50, 0), 1);
);
function ef_chk() ( ef_dst == 0 && (slider1 != mode || slider2 != ftype || (slider6 ? 1 : -1) != dir) ? ef_dst = 1; );

in_init();
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
sm = 1 - exp(-1 / (0.03 * srate));
chL.pf.clp_pf_cfg(40000, 10000, -0.5, 120); chR.pf.clp_pf_cfg(40000, 10000, -0.5, 120); chL.pf.clp_pf_reset(); chR.pf.clp_pf_reset();
os_design(); os_base = 0;
os_f = os_tf = os_f2n(os_sel); os_gsetup();
fl_coef();
update();
mix_s = mix_t; ef_og = fx_on ? og : 1; fc = fbase; fq_s = fbase; dp_s = depth; fk_s = fk; fz_o = fz_t;
ef_dkr = 1 / (0.012 * srate); ef_dk = 1; ef_dst = 0;
stv = 0; stg = 0; lstep = -1; bpos = 0;
c_sw = 1 - exp(-1 / (0.005 * srate));

q_dlen = ceil(4.2 * srate) + 8;
q_bufR = q_bufL + q_dlen;
memset(q_bufL, 0, q_dlen * 2);
q_wp = 0;

function q_tanh_(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1) );
function q_rdl(q_buf, d) local(p, i, f, q_x0, x1, x2, q_x3) (
  p = q_wp - d; p < 0 ? p += q_dlen; i = floor(p); f = p - i;
  q_x0 = q_buf[(i - 1 + q_dlen) % q_dlen]; x1 = q_buf[i % q_dlen]; x2 = q_buf[(i + 1) % q_dlen]; q_x3 = q_buf[(i + 2) % q_dlen];
  (((0.5 * (q_x3 - q_x0) + 1.5 * (x1 - x2)) * f + (q_x0 - 2.5 * x1 + 2 * x2 - 0.5 * q_x3)) * f + 0.5 * (x2 - q_x0)) * f + x1;
);
Q_LG2 = log(2); Q_LC1 = 1 + log(1 + exp(-2)) - Q_LG2;
Q_BKN = 4096; Q_BKU = 16; Q_BKS = Q_BKN / Q_BKU; Q_BKC = Q_BKT + Q_BKN + 2;
function q_bkbuild(c) local(i, x) (
  i = 0; loop(Q_BKN + 1, x = i / Q_BKS; Q_BKT[i] = x / (1 + c * x + 0.08 * x * x); i += 1; );
  Q_BKC[0] = 0; i = 0; loop(Q_BKN, Q_BKC[i + 1] = Q_BKC[i] + 0.5 * (Q_BKT[i] + Q_BKT[i + 1]) / Q_BKS; i += 1; );
);
function q_aaF(x, t) local(a, i, p) (
  t == 0 ? ( a = abs(x * q_drv_g); (a + log(1 + exp(-2 * a)) - Q_LG2) * q_ig2; ) :
  t == 1 ? (
    a = abs(x) * Q_BKS;
    a >= Q_BKN ? Q_BKC[Q_BKN] + Q_BKT[Q_BKN] * (a - Q_BKN) / Q_BKS : (
      i = floor(a); p = a - i; Q_BKC[i] + (Q_BKT[i] * p + 0.5 * (Q_BKT[i + 1] - Q_BKT[i]) * p * p) / Q_BKS; );
  ) : (
    a = abs(x); a <= 1.5 ? 0.5 * x * x : 1.125 + 2.25 * (a * 0.6666667 + log(1 + exp(-1.3333333 * a)) - Q_LG2 - Q_LC1);
  );
);
function q_aaC(x, t) local(a, i) (
  t == 0 ? q_tanh_(x * q_drv_g) / q_drv_g :
  t == 1 ? ( a = min(abs(x) * Q_BKS, Q_BKN - 0.001); i = floor(a); a = Q_BKT[i] + (Q_BKT[i + 1] - Q_BKT[i]) * (a - i); x < 0 ? -a : a; ) :
  abs(x) > 1.5 ? q_tanh_(x / 1.5) * 1.5 : x;
);
function q_loopproc(x) instance(q_hz, q_lz, lz2, q_bz, ax1, af1, aty, ag) local(f, d) (
  q_hz += (x - q_hz) * q_lo_c; x -= q_hz;
  q_lz += (x - q_lz) * q_hi_c; x = q_lz;
  q_etype == 0 ? (
    lz2 += (x - lz2) * q_tape_c; x = lz2;
  ) : q_etype == 1 ? (
    lz2 += (x - lz2) * q_bbd_c; q_bz += (lz2 - q_bz) * q_bbd_c; x = q_bz;
  );
  q_etype !== aty || q_drv_g !== ag ? ( aty = q_etype; ag = q_drv_g; af1 = q_aaF(ax1, aty); );
  f = q_aaF(x, aty); d = x - ax1;
  d = abs(d) > 0.00001 ? (f - af1) / d : q_aaC(0.5 * (x + ax1), aty);
  ax1 = x; af1 = f;
  d;
);
function q_lpclr() instance(q_hz, q_lz, lz2, q_bz, ax1, af1) ( q_hz = q_lz = lz2 = q_bz = ax1 = af1 = 0; );

function q_vt_bq(t, f, q, gdb) local(w, cw, al, ga, q_a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); al = sin(w) / (2 * q);
  t == 0 ? (
    q_a0 = 1 + al; q_vtp[0] = (1 + cw) * 0.5 / q_a0; q_vtp[1] = -(1 + cw) / q_a0; q_vtp[2] = q_vtp[0];
  ) : t == 1 ? (
    q_a0 = 1 + al; q_vtp[0] = (1 - cw) * 0.5 / q_a0; q_vtp[1] = (1 - cw) / q_a0; q_vtp[2] = q_vtp[0];
  ) : (
    ga = 10 ^ (gdb / 40); q_a0 = 1 + al / ga;
    q_vtp[0] = (1 + al * ga) / q_a0; q_vtp[1] = -2 * cw / q_a0; q_vtp[2] = (1 - al * ga) / q_a0;
  );
  q_vtp[3] = -2 * cw / q_a0; q_vtp[4] = (1 - (t == 2 ? al / ga : al)) / q_a0;
);
function q_vt_set(m) (
  q_vt_on = m > 0;
  q_vtp = q_VTC;      q_vt_bq(0, 140, 0.7071, 0);
  q_vtp = q_VTC + 5;  q_vt_bq(2, 500, 0.9, -3 * m);
  q_vtp = q_VTC + 10; q_vt_bq(1, 5000, 0.7071, 0);
);
function q_vt_proc(x) instance(a1, a2, b1, b2, c1, c2) local(y) (
  y = q_VTC[0] * x + a1; a1 = q_VTC[1] * x - q_VTC[3] * y + a2; a2 = q_VTC[2] * x - q_VTC[4] * y; x = y;
  y = q_VTC[5] * x + b1; b1 = q_VTC[6] * x - q_VTC[8] * y + b2; b2 = q_VTC[7] * x - q_VTC[9] * y; x = y;
  y = q_VTC[10] * x + c1; c1 = q_VTC[11] * x - q_VTC[13] * y + c2; c2 = q_VTC[12] * x - q_VTC[14] * y;
  y;
);

function q_vtclr() instance(a1, a2, b1, b2, c1, c2) ( a1 = a2 = b1 = b2 = c1 = c2 = 0; );
function q_update() local(q) (
  q_etype_t = slider27; q_vt_t = slider44; q_ping_t = slider36;
  qd_st == 0 && (q_etype_t != q_etype || q_vt_t != q_vt_m || q_ping_t != q_ping) ? qd_st = 1;
  sync = slider28;
  q = lfo_div_q(slider30);
  q_t_ms = sync ? q * 60000 / max(tempo, 20) : slider29;
  q_t_ms = min(max(q_t_ms, 1), 4000);
  fb = min(slider31 / 100, 1.1);
  q_drv_g = 1 + 3 * slider32 / 100;
  q_ig2 = 1 / (q_drv_g * q_drv_g);
  q_drv_g !== q_bkg ? ( q_bkg = q_drv_g; q_bkbuild((q_drv_g - 1) * 0.6); );
  q_lo_c = 1 - exp(-2 * $pi * slider33 / srate);
  q_hi_c = 1 - exp(-2 * $pi * min(slider34, srate * 0.45) / srate);
  q_tape_c = 1 - exp(-2 * $pi * 9000 / srate);
  q_bbd_c = 1 - exp(-2 * $pi * 4200 / srate);
  q_duck = slider35 / 100;
  q_frz = slider37;
  drift_macro(slider46);
  q_wow = slider38 / 100 * dm_a; q_flt = slider39 / 100 * dm_a; q_dspd = slider40 * dm_s;
  q_mix_t = slider41 / 100; q_wid = slider42 / 100;
  q_out_t = 10 ^ (slider43 / 20);
  q_t_glide = 1 - exp(-1 / ((q_etype_t == 0 ? 0.35 : q_etype_t == 1 ? 0.15 : 0.04) * srate));
);

q_drW.drift_init(0.8 + rand(1) * 0.5);
q_drF.drift_init(0.8 + rand(1) * 0.5);
q_vuc = 1 - exp(-1 / (0.01 * srate));
q_dk_a = 1 - exp(-1 / (0.005 * srate)); q_dk_r = 1 - exp(-1 / (0.25 * srate));
q_pkL = 0; q_pkR = 0; q_vu_ms = 0; q_denv = 0; q_fph = 0; q_cph = 0;
q_etype = slider27; q_ping = slider36; q_vt_m = slider44; q_vt_set(q_vt_m);
qd_st = 0; qd_g = 1; qd_clr = 0; qd_k = 1 / (0.012 * srate);
q_lsL.bq_set(3, 0.3705 * srate, 0.4658, 15.673); q_lsR.bq_set(3, 0.3705 * srate, 0.4658, 15.673);
q_bkg = -1;
q_update();
q_t_s = q_t_ms * 0.001 * srate;
q_mix_s = q_mix_t; q_out_s = q_out_t; q_dks = q_duck; q_fbs = fb; q_wds = q_wid; q_wws = q_wow; q_fls = q_flt;

function q_dip() (
  qd_st == 1 ? (
    qd_g -= qd_k;
    qd_g <= 0 ? (
      qd_g = 0; q_etype = q_etype_t; q_ping = q_ping_t; q_vt_t != q_vt_m ? ( q_vt_m = q_vt_t; q_vt_set(q_vt_m); );
      qd_clr ? (
        memset(q_bufL, 0, q_dlen * 2); q_lpL.q_lpclr(); q_lpR.q_lpclr(); q_lsL.sh_clr(); q_lsR.sh_clr();
        q_vtL.q_vtclr(); q_vtR.q_vtclr(); q_t_s = q_t_ms * 0.001 * srate; qd_clr = 0;
      );
      qd_st = 2;
    );
  ) : qd_st == 2 ? ( qd_g += qd_k; qd_g >= 1 ? ( qd_g = 1; qd_st = 0; ); );
);
function q_proc(cb_inl, cb_inr) (
  q_inL = cb_inl; q_inR = cb_inr;
  q_dip();
  q_dks += (q_duck - q_dks) * sm; q_fbs += (fb - q_fbs) * sm; q_wds += (q_wid - q_wds) * sm; q_wws += (q_wow - q_wws) * sm; q_fls += (q_flt - q_fls) * sm;
  q_vu_ms += (0.5 * (q_inL * q_inL + q_inR * q_inR) - q_vu_ms) * q_vuc;
  q_mix_s += (q_mix_t - q_mix_s) * sm;
  q_out_s += (q_out_t - q_out_s) * sm;
  q_t_s += (q_t_ms * 0.001 * srate - q_t_s) * q_t_glide;
  q_fph += (6.5 + 1.5 * vF) / srate; q_fph >= 1 ? q_fph -= 1;
  q_cph += 0.6 / srate; q_cph >= 1 ? q_cph -= 1;
  q_mod = (q_wws * 0.0025 * q_vW + q_fls * 0.00022 * sin(2 * $pi * q_fph)) * srate;
  q_etype == 1 ? q_mod += 0.0004 * srate * sin(2 * $pi * q_cph);
  q_dL = min(max(q_t_s + q_mod, 3), q_dlen - 4);
  q_dR = q_ping ? q_dL : min(max(q_t_s * (1 + 0.03 * q_wds) + q_mod, 3), q_dlen - 4);
  q_eL = q_rdl(q_bufL, q_dL);
  q_eR = q_rdl(q_bufR, q_dR);
  q_frz ? (
    q_fL = q_eL; q_fR = q_eR;
    q_bufL[q_wp] = q_ping ? q_fR : q_fL; q_bufR[q_wp] = q_ping ? q_fL : q_fR;
  ) : (
    q_fL = q_lsL.bq_run(q_lpL.q_loopproc(q_eL)) * q_fbs; q_fR = q_lsR.bq_run(q_lpR.q_loopproc(q_eR)) * q_fbs;
    q_ping ? (
      q_bufL[q_wp] = 0.5 * (q_inL + q_inR) + q_fR;
      q_bufR[q_wp] = q_fL;
    ) : (
      q_bufL[q_wp] = q_inL + q_fL;
      q_bufR[q_wp] = q_inR + q_fR;
    );
  );
  q_wp += 1; q_wp >= q_dlen ? q_wp = 0;
  lvl = max(abs(q_inL), abs(q_inR));
  q_denv += (lvl - q_denv) * (lvl > q_denv ? q_dk_a : q_dk_r);
  q_dg = (1 - q_dks * min(q_denv * 4, 1)) * qd_g;
  q_vt_on ? ( q_eL = q_vtL.q_vt_proc(q_eL); q_eR = q_vtR.q_vt_proc(q_eR); );
  q_em = 0.5 * (q_eL + q_eR); q_es = 0.5 * (q_eL - q_eR) * q_wds;
  q_wL = (q_em + q_es) * q_dg; q_wR = (q_em - q_es) * q_dg;
  q_dry_g = min(2 * (1 - q_mix_s), 1); q_wet_g = min(2 * q_mix_s, 1);
  q_oL = q_inL * q_dry_g + q_wL * q_wet_g;
  q_oR = q_inR * q_dry_g + q_wR * q_wet_g;
  q_pkL = max(q_pkL, abs(q_oL)); q_pkR = max(q_pkR, abs(q_oR));
  q_out_l = q_oL; q_out_r = q_oR;
);
q_ord = slider45; od_g = 1; od_k = 1 / (0.005 * srate); ord_in = 0;

function ps(md, ft, f, d, pk, dr, rg, sn, rs, rt, ml, gl, lp, dv, mx, ov) (
  slider1 = md; slider2 = ft; slider3 = f; slider4 = d; slider5 = pk; slider6 = dr; slider7 = rg; slider8 = sn; slider9 = rs;
  slider10 = rt; slider11 = ml; slider12 = gl; slider13 = lp; slider14 = dv; slider15 = mx; slider16 = ov; slider17 = 1; slider18 = 0;
);
function f_pre(p) (
  p == 1  ? ps(0, 0, 250, 3.5, 3, 1, 0, 50, 20, 2, 0, 15, 1, 20, 100, -2) :
  p == 2  ? ps(0, 1, 300, 3, 4, 1, 0, 52, 10, 2, 0, 15, 1, 25, 100, 8) :
  p == 3  ? ps(0, 0, 130, 3.5, 6, 1, 0, 40, 5, 2, 0, 15, 1, 30, 100, -3.5) :
  p == 4  ? ps(1, 0, 300, 3.5, 6, 1, 0, 60, 40, 3, 0, 10, 1, 25, 100, -3) :
  p == 5  ? ps(1, 0, 200, 4, 6, 1, 0, 60, 40, 2, 1, 45, 0, 15, 100, -4) :
  p == 6  ? ps(2, 0, 250, 4, 5, 1, 0, 50, 15, 3, 0, 10, 1, 20, 100, -1) :
  p == 7  ? ps(0, 3, 300, 4, 1.5, 1, 0, 50, 60, 2, 0, 15, 1, 0, 100, -0.5) :
  p == 8  ? ps(0, 1, 180, 3.5, 5, 1, 0, 52, 70, 2, 0, 15, 1, 10, 75, 9) :
  p == 9  ? ps(0, 1, 350, 2.5, 5, 1, 1, 52, 5, 2, 0, 15, 1, 35, 100, 7.5) :
  p == 10 ? ps(1, 0, 300, 3.5, 8, 1, 1, 60, 40, 3, 1, 0, 1, 10, 100, -3.5) :
  p == 11 ? ps(0, 0, 150, 5, 2, 1, 0, 45, 70, 2, 0, 15, 1, 0, 100, -1) :
  p == 12 ? ps(0, 1, 180, 3.5, 5, 1, 0, 52, 70, 2, 0, 15, 1, 10, 75, 9.5);
);
function q_setp(m, sy, q_tm, dv, f, q_drp, lc, q_hc, q_dk, q_pp, w, q_flp, mx) (
  slider27 = m; slider28 = sy; slider29 = q_tm; slider30 = dv; slider31 = f; slider32 = q_drp; slider33 = lc; slider34 = q_hc;
  slider35 = q_dk; slider36 = q_pp; slider38 = w; slider39 = q_flp; slider41 = mx; slider37 = 0;
  slider40 = 0.3; slider42 = 100; slider44 = 0;
);
function q_pre(p) (
  p == 1  ? q_setp(0, 1, 375, 10, 35, 30, 120, 6000, 20, 0, 20, 15, 25) :
  p == 2  ? q_setp(0, 0, 110, 10, 15, 40, 150, 5000, 0, 0, 15, 20, 25) :
  p == 3  ? q_setp(0, 1, 375, 9, 10, 30, 300, 3000, 30, 0, 10, 10, 12) :
  p == 4  ? q_setp(1, 1, 375, 10, 35, 40, 150, 3500, 30, 1, 10, 5, 25) :
  p == 5  ? q_setp(1, 0, 650, 10, 45, 50, 100, 3000, 0, 0, 25, 10, 30) :
  p == 6  ? q_setp(2, 1, 375, 11, 30, 0, 100, 9000, 20, 1, 0, 0, 22) :
  p == 7  ? q_setp(0, 0, 1200, 10, 50, 45, 250, 4000, 40, 0, 35, 20, 30) :
  p == 8  ? q_setp(2, 1, 375, 6, 30, 0, 80, 12000, 50, 0, 0, 0, 22) :
  p == 9  ? q_setp(0, 0, 110, 10, 15, 40, 150, 5000, 0, 0, 15, 20, 22) :
  p == 10 ? q_setp(2, 1, 375, 11, 30, 0, 100, 9000, 0, 1, 0, 0, 25) :
  p == 11 ? q_setp(0, 0, 1200, 10, 50, 45, 250, 4000, 40, 0, 35, 20, 30) :
  p == 12 ? q_setp(0, 1, 500, 6, 70, 50, 200, 3500, 0, 0, 45, 30, 30);
);
function load_preset(p) (
  ef_dst = 1;
  qd_st = 1; qd_clr = 1;
  p >= 1 && p <= 12 ? ( f_pre(p); q_pre(p); );
  p == 13 ? (
    f_pre(1); q_pre(1);
    slider19 = 0; slider20 = 1; slider21 = 0; slider22 = 30; slider23 = 120; slider24 = 6000; slider25 = -0.3; slider26 = 1;
    slider43 = 0; slider45 = 0; slider46 = 50;
  );
  slider_automate(70368744177663);
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(48, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
q_update();
!ord_in ? (
  q_ord = slider45; q_etype = slider27; q_ping = slider36; q_vt_m = slider44; q_vt_set(q_vt_m); qd_st = 0; qd_g = 1; ord_in = 1; ef_dst = 0; update();
);
ef_chk();
ef_dst != 1 ? update();
ost_setup(slider21 / 100, slider22 / 100, slider23, slider24, -0.3, 1);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
os_snap(slider(47));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? (
  rs_f = 0; rs_c = 1 / (0.015 * srate);
  memset(q_bufL, 0, q_dlen * 2); memset(DLB, 0, 128);
  q_lpL.q_lpclr(); q_lpR.q_lpclr(); chL.fl_clr(); chR.fl_clr();
);
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pwr_block(!byp);
q_update();
q_dinc = q_dspd * samplesblock / srate;
q_vW = q_drW.drift_tick(q_dinc); vF = q_drF.drift_tick(q_dinc * 3);
ef_chk();
ef_dst != 1 ? update();
ost_setup(slider21 / 100, slider22 / 100, slider23, slider24, -0.3, 1);
os_tf = os_f2n(os_sel);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
chL.pf.clp_pf_block((dg - 1) * 0.25, ef_fs, samplesblock * os_f); chR.pf.clp_pf_block((dg - 1) * 0.25, ef_fs, samplesblock * os_f);
playing = play_state & 1;
playing ? bpos = beat_position;
bpm = tempo > 1 ? tempo : 120;
binc = bpm / 60 / srate;
ef_vu_d = max(ef_vu_d, sqrt(ef_ms / max(samplesblock, 1))); ef_ms = 0; ef_pk_d = max(ef_pk_d, ef_pkm); ef_pkm = 0;
os_snapb(slider(47));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, mg_ed);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
rw_l = spl0; rw_r = spl1;
DLB[dw] = spl0; DLB[64 + dw] = spl1;
dry_l = DLB[(dw - pdc_delay) & 63]; dry_r = DLB[64 + ((dw - pdc_delay) & 63)];
dw = (dw + 1) & 63;
os_gate();
os_chg ? (
  osuL.os_clr(); osuR.os_clr(); osdL.os_clr(); osdR.os_clr();
  chL.fl_clr(); chR.fl_clr(); fl_coef();
  chL.pf.clp_pf_block((dg - 1) * 0.25, ef_fs, 1); chR.pf.clp_pf_block((dg - 1) * 0.25, ef_fs, 1);
  dry_l = DLB[(dw - 1 - pdc_delay) & 63]; dry_r = DLB[64 + ((dw - 1 - pdc_delay) & 63)];
);
ef_dst == 1 ? ( ef_dk -= ef_dkr; ef_dk <= 0 ? ( ef_dk = 0; update(); ef_dst = 2; ); ) :
ef_dst == 2 ? ( ef_dk += ef_dkr; ef_dk >= 1 ? ( ef_dk = 1; ef_dst = 0; ); );
slider45 != q_ord ? ( od_g = max(od_g - od_k, 0); od_g == 0 ? q_ord = slider45; ) : od_g < 1 ? od_g = min(od_g + od_k, 1);
in_process(spl0, spl1);
pwr_in(in_l, in_r); in_l = pwr_l; in_r = pwr_r;
q_ord ? ( q_proc(in_l, in_r); in_l = q_out_l; in_r = q_out_r; );
dl = in_l; dr = in_r;
det = abs(dl + dr) * 0.5 * sensg;
env += (det - env) * (det > env ? env_a : env_r);
e = min(env, 1) ^ 0.7;
bpos += binc;
sidx = floor(bpos * spb);
sidx != lstep ? (
  lstep = sidx;
  stv = loopp ? rnd(sidx % max(1, floor(spb * 4)) + 1) : rand(1);
  steph = 1;
);
glide > 0.005 ? stg += (stv - stg) / (1 + glide * 0.35 * srate * 60 / (bpm * spb)) : stg = stv;
amt = mode == 0 ? e : mode == 1 ? stg : stg * e;
fq_s += (fbase - fq_s) * sm; dp_s += (depth - dp_s) * sm; fk_s += (fk - fk_s) * sm;
!hold ? fc = min(max(fq_s * 2 ^ (dir * dp_s * amt), 25), min(18000, srate * 0.42));
fg = tan($pi * fc / ef_fs); fa1 = 1 / (1 + fg * (fg + fk_s)); fa2 = fg * fa1; fa3 = fg * fa2;
fk_v = fk; fk = fk_s;
mix_s += ((fx_on ? mix_t : 0) - mix_s) * sm;
ef_og += ((fx_on ? og : 1) - ef_og) * sm;
ef_mx = ef_dst ? mix_s * ef_dk * ef_dk * (3 - 2 * ef_dk) : mix_s;
fz_o += (fz_t - fz_o) * sm;
fl_os(dl, dr);
fk = fk_v;
oL = fo_l * ef_og; oR = fo_r * ef_og;
!q_ord ? ( q_proc(oL, oR); oL = q_out_l; oR = q_out_r; );
oL *= q_out_s; oR *= q_out_s;
pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
oL = ostL.ost_band(oL * in_comp * os_g * od_g); oR = ostR.ost_band(oR * in_comp * os_g * od_g);
ost_out(oL, oR); oL = ost_l; oR = ost_r;
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( oL += (dry_l - oL) * by_s; oR += (dry_r - oR) * by_s; );
ef_ms += 0.5 * (oL * oL + oR * oR); ef_pkm = max(ef_pkm, max(abs(oL), abs(oR)));
spl0 = oL; spl1 = oR;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  spl0 = rw_l + (spl0 - rw_l) * rs_s; spl1 = rw_r + (spl1 - rw_r) * rs_s;
);

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x1B38B8; mk_band = 0x101A5C; mk_ink = 0xF2EEF8; mk_acc = 0xF2C830; mk_tab = 0x45B1ED;
mk_sub = 0x2844C8; mk_ink2 = 0xC9BFDE;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
