desc:Dritte Mini [buss processor] (GFX Lab)
//tags: buss bus multiband three-band transient shaper proximity width saturation compressor transformer iron mono clipper mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-power, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-bands

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-24,12,0.1>-Trim (dB)
slider3:1<0,1,1{Off,On}>-Guard
slider4:11<11,550,0.1>-HPF (Hz)
slider5:22000<2200,22000,1>-LPF (Hz)
slider6:220<55,550,1>-Low / mid split (Hz)
slider7:2200<1100,11000,1>-Mid / high split (Hz)
slider8:0<-100,100,1>-Low attack (%)
slider9:0<-100,100,1>-Low sustain (%)
slider10:320<40,1280,1>-Low release (ms)
slider11:0<-100,100,1>-Low proximity (%)
slider12:100<0,200,1>-Low width (%)
slider13:2<0,10,0.1>-Low saturation
slider14:2<0,10,0.1>-Low compression
slider15:3<0,10,0.1>-Low iron
slider16:0<-100,100,1>-Mid attack (%)
slider17:0<-100,100,1>-Mid sustain (%)
slider18:320<40,1280,1>-Mid release (ms)
slider19:0<-100,100,1>-Mid proximity (%)
slider20:100<0,200,1>-Mid width (%)
slider21:2<0,10,0.1>-Mid saturation
slider22:2<0,10,0.1>-Mid compression
slider23:3<0,10,0.1>-Mid iron
slider24:0<-100,100,1>-High attack (%)
slider25:0<-100,100,1>-High sustain (%)
slider26:320<40,1280,1>-High release (ms)
slider27:0<-100,100,1>-High proximity (%)
slider28:100<0,200,1>-High width (%)
slider29:2<0,10,0.1>-High saturation
slider30:2<0,10,0.1>-High compression
slider31:3<0,10,0.1>-High iron
slider32:0<0,6,1{Off,33 Hz,55 Hz,77 Hz,110 Hz,220 Hz,330 Hz}>-Mono below
slider33:100<0,200,1>-Width (%)
slider34:0<-24,12,0.1>-Output (dB)
slider35:0<0,1,1{Soft,Hard}>-Clip
slider36:1<0,2,1{1x,2x,4x}>-Oversampling
slider37:prs_sel=0<0,10,1{No preset,Init,Drum Buss,Mix Glue,Bass Weight,Vocal Air,Wide Keys,Pull Back,Punch Up,Tape Crunch,Tight Lows}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-bands.jsfx-inc

@init
#ui_man = "gfx-lab-dritte-mini";
ext_noinit = 1;

function tz_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function tz_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function tz_db(d) ( exp(d * 0.11512925464970228); );
function tz_op(f, fs) ( 1 - exp(-2 * $pi * min(f, 0.45 * fs) / fs); );
function tz_sat(x) ( x / sqrt(1 + x * x); );

function sv_c(f, fs) local(g) ( g = tan($pi * min(f, 0.45 * fs) / fs); sv_a1 = 1 / (1 + g * (g + 1.4142135623730951)); sv_a2 = g * sv_a1; sv_a3 = g * sv_a2; );
function sv_run(x, a1, a2, a3) instance(s1, s2, lo) local(v1, v2, v3) (
  v3 = x - s2; v1 = a1 * s1 + a2 * v3; v2 = s2 + a2 * s1 + a3 * v3; s1 = 2 * v1 - s1; s2 = 2 * v2 - s2;
  lo = v2; x - 1.4142135623730951 * v1 - v2;
);
function sv_clr() instance(s1, s2, lo) ( s1 = s2 = lo = 0; );

function tz_xo(f1, f2, fs) local(g) (
  bs_k = 1.4142135623730951;
  f1 = max(10, min(f1, fs * 0.45)); f2 = max(f1 * 1.01, min(f2, fs * 0.45));
  g = tan($pi * f1 / fs); bs_a1 = 1 / (1 + g * (g + bs_k)); bs_a2 = g * bs_a1; bs_a3 = g * bs_a2;
  g = tan($pi * f2 / fs); bs_b1 = 1 / (1 + g * (g + bs_k)); bs_b2 = g * bs_b1; bs_b3 = g * bs_b2;
);

function ir_run(u, g, gl, b, rb, kb, kc) instance(lp) local(lo) (
  lp += (u - lp) * kc;
  lo = (tz_sat(lp * gl + b) - rb) * kb / gl;
  tz_sat((u - lp + lo) * g) / g;
);

function bp_tgt(base, ty) instance(tatt, tsus, tpl, tph, tw, tsm, tsg, tsn, tsb, tsrb, tskb, cam, cth, csl, tim, tig, tigl, tib, tirb, tikb, tkh, rel)
  local(p, k, d)
(
  tatt = min(max(slider(base), -100), 100) * 0.01;
  tsus = min(max(slider(base + 1), -100), 100) * 0.01;
  rel = min(max(slider(base + 2), 40), 1280);
  p = min(max(slider(base + 3), -100), 100) * 0.01;
  tpl = tz_db(6 * p) - 1;
  tph = p < 0 ? -0.5 * p : 0;
  tw = min(max(slider(base + 4), 0), 200) * 0.01;
  k = min(max(slider(base + 5), 0), 10);
  tsm = min(k, 1);
  tsg = tz_db((ty == 2 ? 1.8 : 2.4) * k - 6);
  tsb = ty == 0 ? 0.025 * k : ty == 1 ? 0.003 * k : 0;
  tsrb = tz_sat(tsb); tskb = (1 + tsb * tsb) ^ 1.5;
  tsn = sqrt(1 + sqr(0.126 * tsg));
  k = min(max(slider(base + 6), 0), 10);
  cam = min(k, 1); cth = -8 - 2.2 * k; csl = 1 - 1 / (1.5 + 0.25 * k);
  d = min(max(slider(base + 7), 0), 10) * 0.1;
  tim = min(d * 10, 1);
  tig = tz_db(18 * d - 12);
  tigl = tig * (1 + (ty == 0 ? 3 : ty == 1 ? 1.5 : 0.5) * d);
  tib = (ty == 0 ? 0.15 : ty == 1 ? 0.1 : 0.05) * d;
  tirb = tz_sat(tib); tikb = (1 + tib * tib) ^ 1.5;
  tkh = 20000 * 0.33 ^ d;
);
function bp_glide(k) instance(tpl, tph, tw, tsm, tsg, tsn, tsb, tsrb, tskb, tim, tig, tigl, tib, tirb, tikb,
                              pl, ph, w, sm, sg, sn, sb, srb, skb, im, ig, igl, ib, irb, ikb) (
  pl += (tpl - pl) * k; ph += (tph - ph) * k; w += (tw - w) * k;
  sm += (tsm - sm) * k; sg += (tsg - sg) * k; sn += (tsn - sn) * k; sb += (tsb - sb) * k; srb += (tsrb - srb) * k; skb += (tskb - skb) * k;
  im += (tim - im) * k; ig += (tig - ig) * k; igl += (tigl - igl) * k; ib += (tib - ib) * k; irb += (tirb - irb) * k; ikb += (tikb - ikb) * k;
);
function bp_snap() instance(tpl, tph, tw, tsm, tsg, tsn, tsb, tsrb, tskb, tim, tig, tigl, tib, tirb, tikb,
                            pl, ph, w, sm, sg, sn, sb, srb, skb, im, ig, igl, ib, irb, ikb) (
  pl = tpl; ph = tph; w = tw; sm = tsm; sg = tsg; sn = tsn; sb = tsb; srb = tsrb; skb = tskb;
  im = tim; ig = tig; igl = tigl; ib = tib; irb = tirb; ikb = tikb;
);
function bp_rcoef(fs, fp, fd) instance(kpl, kph, kh, tkh, kc) (
  kpl = tz_op(fp, fs); kph = tz_op(fd, fs); kh = tz_op(tkh, fs); kc = tz_op(150, fs);
);
function bp_run(xl, xr, ty) instance(gt, gc, pl, ph, w, sm, sg, sn, sb, srb, skb, im, ig, igl, ib, irb, ikb, kpl, kph, kh, kc,
                                     la, lb, da, db, fa, fb, ql, qr, yl, yr) local(a, b, m, s, u) (
  a = xl * gt; b = xr * gt;
  la += (a - la) * kpl; lb += (b - lb) * kpl;
  a += pl * la; b += pl * lb;
  da += (a - da) * kph; db += (b - db) * kph;
  a -= ph * (a - da); b -= ph * (b - db);
  sm > 0.0001 ? (
    u = (tz_sat(a * sg + sb) - srb) * skb * sn / sg; a += sm * (u - a);
    u = (tz_sat(b * sg + sb) - srb) * skb * sn / sg; b += sm * (u - b);
  );
  ql = a; qr = b;
  a *= gc; b *= gc;
  im > 0.0001 ? (
    u = this.irL.ir_run(a, ig, igl, ib, irb, ikb, kc); a += im * (u - a);
    u = this.irR.ir_run(b, ig, igl, ib, irb, ikb, kc); b += im * (u - b);
    ty > 0 ? ( fa += (a - fa) * kh; fb += (b - fb) * kh; a += im * (fa - a); b += im * (fb - b); );
  );
  m = 0.5 * (a + b); s = 0.5 * (a - b) * w;
  yl = m + s; yr = m - s;
);
function bp_clr() instance(la, lb, da, db, fa, fb, ql, qr, yl, yr) (
  la = lb = da = db = fa = fb = ql = qr = yl = yr = 0; this.irL.lp = this.irR.lp = 0;
);
function bp_dyn(vt, ka, kr) instance(tatt, tsus, att, sus, gt, gdb, ms, grd, gc, cam, cth, csl, am, th, sl, mk, grm, mpi, mpo) local(t, ov, k2, lv) (
  att += (tatt - att) * tz_kn; sus += (tsus - sus) * tz_kn;
  this.trn.bt_det(vt);
  t = min(max(0.75 * (att * this.trn.onset + sus * this.trn.tail), -15), 12);
  gdb += (t - gdb) * tz_k1; gt = exp(0.11512925464970228 * gdb);
  am += (cam - am) * tz_kn; th += (cth - th) * tz_kn; sl += (csl - sl) * tz_kn;
  ms += (this.dv - ms) * tz_kd;
  lv = 10 * log10(max(ms, 0.00000000001)) + 3.0103;
  ov = lv - th; k2 = 5;
  t = -am * (ov <= -k2 ? 0 : ov >= k2 ? ov * sl : sl * sqr(ov + k2) / 20);
  grd += (t < grd ? ka : kr) * (t - grd);
  t = exp(0.2302585092994046 * grd);
  mpi += (this.dv - mpi) * tz_kmu; mpo += (this.dv * t - mpo) * tz_kmu;
  mk = -min(max(7.5 * log10((mpi + 0.0000000001) / (mpo + 0.0000000001)), 0), 12);
  gc = exp(0.11512925464970228 * (grd - mk));
  grm = min(grm, grd);
);

function tz_acl(x, c, kf) instance(x1, fa1, q1, c1, k1) local(k, w, fa, q, y) (
  k = kf * c;
  abs(x) < k && abs(x1) < k ? ( y = x; fa = q = 0; ) : (
    w = c - k;
    c !== c1 || k !== k1 ? ( fa1 = ost_cpt(x1, k, w); q1 = ost_q; );
    fa = ost_cpt(x, k, w); q = ost_q;
    abs(x) >= k ? tz_clp = 1;
    y = abs(x - x1) > 0.00001 ? (fa - fa1) / (x - x1) : ( ost_cpt(0.5 * (x + x1), k, w); ost_q; );
    y = x + y + 0.5 * (q - q1);
    abs(y) > c ? y = x + q;
  );
  x1 = x; fa1 = fa; q1 = q; c1 = c; k1 = k;
  y;
);

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(tz_ol, FZ_1); h1 = zA2.fz_bq(tz_or, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(tz_ol), abs(tz_or)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  tz_ol += g * e0; tz_or += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function tz_os(xl, xr) (
  spL.bs_split(xl); spR.bs_split(xr);
  bLo.bp_run(spL.lo, spR.lo, 0); bMi.bp_run(spL.mi, spR.mi, 1); bHi.bp_run(spL.hi, spR.hi, 2);
  tz_ol = bLo.yl + bMi.yl + bHi.yl; tz_or = bLo.yr + bMi.yr + bHi.yr;
  fz_o > 0.0001 ? fz_run();
);
function tz_rcoefs(f) local(fs) (
  fs = srate * f;
  tz_xo(tz_x1, tz_x2, fs);
  bLo.bp_rcoef(fs, 110, 220); bMi.bp_rcoef(fs, 440, 2200); bHi.bp_rcoef(fs, 3300, 6600);
  fz_coefs(fs);
);
function tz_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  spL.bs_clear(); spR.bs_clear(); bLo.bp_clr(); bMi.bp_clr(); bHi.bp_clr(); fz_clr();
);
function tz_reset() (
  tz_clear(); memset(BY_BUF, 0, 2 * BY_N);
  hpL.sv_clr(); hpR.sv_clr(); lpL.sv_clr(); lpR.sv_clr(); mbA.sv_clr(); mbB.sv_clr();
  bLo.ms = bMi.ms = bHi.ms = 0; bLo.grd = bMi.grd = bHi.grd = 0; bLo.mk = bMi.mk = bHi.mk = 0; bLo.mpi = bMi.mpi = bHi.mpi = bLo.mpo = bMi.mpo = bHi.mpo = 0;
  tz_dxl = tz_dyl = tz_dxr = tz_dyr = 0; in_dxL = in_dyL = in_dxR = in_dyR = 0;
  tz_fi = 0;
);

#tz_pm = "Init|Drum Buss|Mix Glue|Bass Weight|Vocal Air|Wide Keys|Pull Back|Punch Up|Tape Crunch|Tight Lows";
function tz_band(b, at, su, re, pr, wd, sa, co, ir) local(i) (
  i = 8 + 8 * b;
  slider(i) = at; slider(i + 1) = su; slider(i + 2) = re; slider(i + 3) = pr;
  slider(i + 4) = wd; slider(i + 5) = sa; slider(i + 6) = co; slider(i + 7) = ir;
);
function tz_glob(hp, lp, x1, x2, mo, wd, ou, cl) (
  slider4 = hp; slider5 = lp; slider6 = x1; slider7 = x2; slider32 = mo; slider33 = wd; slider34 = ou; slider35 = cl;
);
function load_preset(p) local(i) (
  p == 1 || p == 11 ? (
    tz_glob(11, 22000, 220, 2200, 0, 100, 0, 0);
    tz_band(0,   0,   0, 320,   0, 100,   2,   2,   3);
    tz_band(1,   0,   0, 320,   0, 100,   2,   2,   3);
    tz_band(2,   0,   0, 320,   0, 100,   2,   2,   3);
  ) : p == 2 ? (
    tz_glob(22, 22000, 110, 3300, 4, 100, -1, 0);
    tz_band(0,  30, -10, 160,  20, 100,   4,   4,   5);
    tz_band(1,  40, -20, 160,   0, 100,   3,   5,   3);
    tz_band(2,  20, -30, 160,   0, 120,   2,   3,   2);
  ) : p == 3 ? (
    tz_glob(11, 22000, 220, 3300, 3, 100, 0, 0);
    tz_band(0,   0,   0, 320,   0, 100,   2,   4,   4);
    tz_band(1,   0,   0, 320,   0, 100,   2,   4,   3);
    tz_band(2,   0,   0, 320,   0, 110,   1,   3,   2);
  ) : p == 4 ? (
    tz_glob(33, 22000, 220, 2200, 5, 100, -1, 0);
    tz_band(0,  10,  20, 640,  40,   0,   5,   5,   7);
    tz_band(1,  10,   0, 320,  20,  80,   3,   4,   4);
    tz_band(2,   0, -20, 320, -20, 100,   1,   2,   3);
  ) : p == 5 ? (
    tz_glob(110, 22000, 220, 3300, 3, 100, 0, 0);
    tz_band(0,   0,   0, 320, -30, 100,   0,   2,   2);
    tz_band(1,   0,   0, 320,  20, 100,   3,   5,   3);
    tz_band(2,  10,  10, 320,   0, 120,   2,   3,   0);
  ) : p == 6 ? (
    tz_glob(44, 22000, 220, 2200, 4, 115, 0, 0);
    tz_band(0,   0,   0, 320,   0,  60,   1,   2,   3);
    tz_band(1,   0,  10, 640,   0, 140,   2,   2,   2);
    tz_band(2,   0,  10, 640,   0, 160,   1,   2,   1);
  ) : p == 7 ? (
    tz_glob(55, 11000, 220, 2200, 0, 90, 3, 0);
    tz_band(0, -30,  20, 640, -40, 100,   1,   2,   3);
    tz_band(1, -40,  20, 640, -50, 100,   1,   3,   3);
    tz_band(2, -50,  10, 640, -60,  90,   0,   2,   5);
  ) : p == 8 ? (
    tz_glob(22, 22000, 110, 2200, 4, 100, -1, 1);
    tz_band(0,  50, -20,  80,  20, 100,   3,   3,   4);
    tz_band(1,  60, -30,  80,   0, 100,   3,   3,   3);
    tz_band(2,  40, -30,  80,   0, 100,   2,   2,   2);
  ) : p == 9 ? (
    tz_glob(22, 16500, 220, 3300, 4, 100, 0, 0);
    tz_band(0,   0,   0, 320,  10, 100,   6,   4,   6);
    tz_band(1,   0,   0, 320,   0, 100,   6,   5,   5);
    tz_band(2, -10,   0, 320,   0, 100,   4,   4,   6);
  ) : p == 10 ? (
    tz_glob(33, 22000, 110, 2200, 6, 100, 0, 0);
    tz_band(0,  20, -40, 160,   0,   0,   2,   5,   3);
    tz_band(1,   0,   0, 320,   0, 100,   2,   2,   3);
    tz_band(2,   0,   0, 320,   0, 100,   2,   2,   3);
  );
  slider_automate(2 ^ 3 + 2 ^ 4 + 2 ^ 5 + 2 ^ 6);
  i = 8; loop(24, slider_automate(2 ^ (i - 1)); i += 1; );
  i = 32; loop(4, slider_automate(2 ^ (i - 1)); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function tz_srinit() (
  tz_sr = srate;
  tz_kn = tz_tc(30); tz_k1 = tz_tc(1); tz_kd = tz_tc(5); tz_ksw = tz_tc(15); tz_kmu = tz_tc(1500);
  tz_dcc = 1 - 2 * $pi * 5 / srate;
  tz_fis = 1 / (0.01 * srate);
  tz_pkk = exp(-1 / (0.3 * srate));
  ost_init(0);
  bt_init();
  bLo.trn.bt_speed(1); bMi.trn.bt_speed(1); bHi.trn.bt_speed(1);
  bLo.rel_c = bMi.rel_c = bHi.rel_c = 0;
  bLo.ka = tz_tc(25); bLo.kr = tz_tc(300); bMi.ka = tz_tc(10); bMi.kr = tz_tc(160); bHi.ka = tz_tc(3); bHi.kr = tz_tc(90);
  tz_x1 = min(max(slider6, 55), 550); tz_x2 = min(max(slider7, 1100), 11000);
