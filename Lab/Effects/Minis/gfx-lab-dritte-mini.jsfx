  bLo.att = bLo.tatt; bLo.sus = bLo.tsus; bMi.att = bMi.tatt; bMi.sus = bMi.tsus; bHi.att = bHi.tatt; bHi.sus = bHi.tsus;
  bLo.am = bLo.cam; bLo.th = bLo.cth; bLo.sl = bLo.csl; bMi.am = bMi.cam; bMi.th = bMi.cth; bMi.sl = bMi.csl;
  bHi.am = bHi.cam; bHi.th = bHi.cth; bHi.sl = bHi.csl;
