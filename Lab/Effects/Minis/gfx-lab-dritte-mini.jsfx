bMi.rel != bMi.rel_c ? ( bMi.rel_c = bMi.rel; bMi.trn.bt_speed(bMi.rel / 320); );
bHi.rel != bHi.rel_c ? ( bHi.rel_c = bHi.rel; bHi.trn.bt_speed(bHi.rel / 320); );
