function d3_cols(a, m, d, t, b, f, bl, lv) (
  slider3 = a; slider4 = m; slider5 = d; slider6 = t; slider8 = b; slider9 = f; slider10 = bl; slider7 = lv;
);
#d3_pm = "Init|Warm Buffer|Edge of Breakup|Mid Hump Lead|Bass Overdrive|Low End Grind|Stacked Grit|Fuzz Under Glass|Attack Keeper|Wall of Fuzz|Gated Sputter|Dry Fuzz Bed";
function load_preset(p) local(i) (
  slider1 = 1; slider13 = 5;
  d3_cols(1, 0, 5, 5, 1, 5, 50, 5);
  p == 2  ? ( d3_cols(0, 0, 5, 5, 0, 5, 100, 5); ) :
  p == 3  ? ( d3_cols(1, 0, 2, 6, 0, 5, 100, 4.8); ) :
  p == 4  ? ( d3_cols(1, 0, 7.5, 6.5, 0, 5, 100, 4.6); ) :
  p == 5  ? ( d3_cols(1, 1, 5.5, 5, 0, 5, 100, 5.6); ) :
  p == 6  ? ( d3_cols(1, 1, 8.5, 4, 1, 3, 30, 4.9); ) :
  p == 7  ? ( d3_cols(1, 0, 6, 5.5, 1, 4, 35, 4.9); ) :
  p == 8  ? ( d3_cols(1, 0, 2.5, 4.5, 1, 7, 60, 5.3); ) :
  p == 9  ? ( d3_cols(0, 0, 5, 5, 1, 8, 75, 5.4); ) :
  p == 10 ? ( d3_cols(1, 0, 7, 6, 1, 10, 90, 5.9); ) :
  p == 11 ? ( d3_cols(0, 1, 5, 5, 1, 9.5, 100, 6.2); ) :
  p == 12 ? ( d3_cols(1, 1, 3, 5, 1, 6, 25, 4.9); ) :
  p == 13 ? ( slider2 = 0; slider11 = 0; slider12 = 50; slider14 = 0; );
  slider_automate(16383);
);

function d3_srinit() (
  d3_sr = srate; d3_fs2 = d3_of * srate;
  c1_kld = d3_op(12500, srate); c1_klm = d3_op(300, srate); c1_khp = d3_op(30, srate); c1_ktop = d3_op(11000, srate);
  d3_fst = 1 / (0.01 * srate);
  d3_gsm = 1 - exp(-1 / (0.012 * srate));
  d3_gsm2 = 1 - exp(-1 / (0.012 * d3_fs2));
  d3_eat = 1 - exp(-1 / (0.03 * srate)); d3_ert = 1 - exp(-1 / (1.2 * srate));
  d3_tfa = 1 - exp(-1 / (0.0005 * srate)); d3_tfr = 1 - exp(-1 / (0.02 * srate));
  d3_tsa = 1 - exp(-1 / (0.04 * srate)); d3_tsr = 1 - exp(-1 / (0.3 * srate));
  d3_tsm = 1 - exp(-1 / (0.002 * srate));
  d3_dcr = 1 - 2 * $pi * 15 / srate;
  d3_apk = tan($pi * 4200 / d3_fs2); d3_apk = (d3_apk - 1) / (d3_apk + 1);
  zz_coef();
  ost_init(0);
);
os_base = 0; os_f = os_tf = os_f2n(os_sel); os_gsetup(); pdc_delay = 0;
d3_of = os_f;
d3_srinit();
in_init();
ostL.ost_ch_init();
c1R.drift_init(0.8 + rand(1) * 0.4); c1D.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
c1_bulb = c1_ldr = 0.5; c1_ph = rand(1); c1_light = 0.5;
d3_sync = 0; d3_rst = 0;
d3_k2 = d3_ik2 = d3_kf = d3_ikf = 1; d3_kfb = 1; d3_wd = slider14 >= 0.5;
d3_g1 = slider1 >= 0.5; d3_g2 = slider3 >= 0.5; d3_g3 = slider8 >= 0.5;
d3_wA = slider4 < 0.5; d3_wB = 1 - d3_wA; d3_c2on = d3_c3on = 1;
d3_snap = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
rs_f = 1;
c_sw = 1 - exp(-1 / (0.005 * srate));
by_s = byp;
pwr_init();
pwr_wu_loss = 0.8; pwr_wu_drv = 1; pwr_wu_lp = 9000; pwr_wu_wob = 0.3; pwr_bloom = 0;
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(17, i != 17 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function d3_coefs() (
  d3_n2 = d3_of * samplesblock;
  chL.odA.od_set(0, d3_vd, d3_vt, d3_fs2, d3_n2);
  chL.odB.od_set(1, d3_vd, d3_vt, d3_fs2, d3_n2);
  chR.odA.od_set(0, min(d3_vd * (1 + 0.1 * d3_wd), 1), d3_vt * (1 - 0.1 * d3_wd), d3_fs2, d3_n2);
  chR.odB.od_set(1, min(d3_vd * (1 + 0.1 * d3_wd), 1), d3_vt * (1 - 0.1 * d3_wd), d3_fs2, d3_n2);
  fz_set(d3_vf, d3_fs2, d3_n2);
  chL.fz_cfg(d3_vf, d3_vbi, d3_fs2, d3_n2);
  chR.fz_cfg(min(d3_vf * (1 + 0.08 * d3_wd), 1), min(d3_vbi + 0.12 * d3_wd, 1), d3_fs2, d3_n2);
);
function d3_rate() (
  d3_of = os_f; d3_srinit(); d3_coefs();
  chL.d3_zero(); chR.d3_zero(); d3_sync = 0; d3_rst = 0;
);
function d3_resume() (
  rs_f = 0; rs_c = 1 / (0.015 * srate);
  chL.d3_zero(); chR.d3_zero(); d3_sync = 0; d3_rst = 0;
  d3_e2 = d3_e3 = d3_ef = d3_es = d3_trs = 0;
);

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? d3_resume();
rs_last = rs_now;
srate != d3_sr ? d3_srinit();
pwr_block(!byp);
in_setup(slider2, slider11 >= 0.5);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(os_sel);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
drift_macro(slider12);
d3_t1 = slider1 >= 0.5; d3_t2 = slider3 >= 0.5; d3_t3 = slider8 >= 0.5; d3_tm = slider4 >= 0.5;
d3_qd = min(max(slider5, 0), 10) / 10; d3_qt = min(max(slider6, 0), 10) / 10; d3_ql = min(max(slider7, 0), 10) / 10;
d3_qf = min(max(slider9, 0), 10) / 10; d3_qb = min(max(slider10, 0), 100) / 100; d3_qbi = min(max(slider13, 0), 10) / 10;
zz_t = 0.33 * min(max((max(d3_t2 * d3_qd, d3_t3 * d3_qf) - 0.5) * 2, 0), 1);
d3_gl = d3_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
d3_vd += (d3_qd - d3_vd) * d3_gl; d3_vt += (d3_qt - d3_vt) * d3_gl; d3_vf += (d3_qf - d3_vf) * d3_gl; d3_vbi += (d3_qbi - d3_vbi) * d3_gl;
d3_snap ? zz_o = zz_t;
d3_snap = 0;
d3_wd += ((slider14 >= 0.5) - d3_wd) * d3_gl;
slider14 < 0.5 && d3_wd < 0.000001 ? d3_wd = 0;
d3_rst && d3_wd > 0 ? ( d3_lr_copy(); d3_rst = 0; );
!d3_sync && d3_wd == 0 && !d3_rst ? d3_sync = d3_lr_same();
d3_coefs();
d3_trA = d3_tab(0, d3_vd); d3_trB = d3_tab(11, d3_vd);
d3_ftr = d3_tab(22, d3_vf);
d3_lv2 = d3_ql <= 0.5 ? sqr(d3_ql / 0.5) : 1 + (d3_ql - 0.5) * 2;
d3_lk = d3_t3 * 0.45 * d3_qf * d3_qf;
d3_dst = 1 - d3_qb + 0.35 * d3_lk;
d3_nrm = 1 / max((d3_qb ^ 1.4 + d3_dst ^ 1.4) ^ (1 / 1.4), 0.000001);
d3_twet = d3_qb * d3_nrm; d3_tdry0 = (1 - d3_qb) * d3_nrm; d3_tlk = d3_lk * d3_nrm;
d3_sg = 0.08 * dm_a; d3_kb = 1 - 0.03 * dm_a;
d3_kfb = d3_kf;
c1_blk(samplesblock);
chL.d3_tidy(); chR.d3_tidy();
d3_e2 = d3_tn(d3_e2); d3_e3 = d3_tn(d3_e3); d3_ef = d3_tn(d3_ef); d3_es = d3_tn(d3_es); d3_trs = d3_tn(d3_trs);
ostL.dcx = d3_tn(ostL.dcx); ostL.dcy = d3_tn(ostL.dcy);
d3_vu_d = max(d3_vu_d, sqrt(d3_ms / max(samplesblock, 1))); d3_ms = 0;
d3_pk_d = max(d3_pk_d, d3_pkm); d3_pkm = 0;
d3_lamp_d = c1_light;

@sample
rw_l = spl0; rw_r = spl1;
rw_l != rw_l ? rw_l = 0; rw_r != rw_r ? rw_r = 0;
os_gate();
os_chg ? ( d3_rate(); pdc_delay = 0; os_hold = 32; );
in_process(rw_l, rw_r);
pwr_in(in_l, in_r);
d3_xl = pwr_l; d3_xr = pwr_r;
abs(d3_xl) < 0.000000000000001 ? d3_xl = 0;
abs(d3_xr) < 0.000000000000001 ? d3_xr = 0;
d3_g1 != d3_t1 ? ( d3_g1 == 0 ? ( chL.c1_reset(); chR.c1_reset(); ); d3_g1 = d3_t1 ? min(d3_g1 + d3_fst, 1) : max(d3_g1 - d3_fst, 0); );
d3_g2 != d3_t2 ? ( d3_g2 == 0 && !d3_c2on ? ( chL.odA.od_reset(); chL.odB.od_reset(); chR.odA.od_reset(); chR.odB.od_reset(); d3_c2on = 1; );
                   d3_g2 = d3_t2 ? min(d3_g2 + d3_fst, 1) : max(d3_g2 - d3_fst, 0); );
d3_c2on = d3_g2 > 0;
d3_g3 != d3_t3 ? ( d3_g3 == 0 && !d3_c3on ? ( chL.fz_reset(); chR.fz_reset(); d3_c3on = 1; );
                   d3_g3 = d3_t3 ? min(d3_g3 + d3_fst, 1) : max(d3_g3 - d3_fst, 0); );
d3_c3on = d3_g3 > 0;
d3_tm ? (
  d3_wB < 1 ? ( d3_wB == 0 ? ( chL.odB.od_reset(); chR.odB.od_reset(); ); d3_wB = min(d3_wB + d3_fst, 1); d3_wA = 1 - d3_wB; );
) : (
  d3_wA < 1 ? ( d3_wA == 0 ? ( chL.odA.od_reset(); chR.odA.od_reset(); ); d3_wA = min(d3_wA + d3_fst, 1); d3_wB = 1 - d3_wA; );
);
d3_m1 = d3_sync && d3_xl == d3_xr && d3_wd == 0;
!d3_m1 ? ( d3_rst ? ( d3_lr_copy(); d3_rst = 0; ); d3_xl != d3_xr || d3_wd != 0 ? d3_sync = 0; );
d3_c1l = d3_g1 > 0 ? d3_xl + d3_g1 * (chL.c1_run(d3_xl) - d3_xl) : d3_xl;
d3_c1r = d3_m1 ? d3_c1l : d3_g1 > 0 ? d3_xr + d3_g1 * (chR.c1_run(d3_xr) - d3_xr) : d3_xr;
d3_a = max(abs(d3_c1l), abs(d3_c1r));
d3_ef += (d3_a > d3_ef ? d3_tfa : d3_tfr) * (d3_a - d3_ef);
d3_es += (d3_a > d3_es ? d3_tsa : d3_tsr) * (d3_a - d3_es);
d3_tr = min(max((d3_ef - 1.5 * d3_es) / (1.5 * d3_es + 0.00001), 0), 1);
d3_trs += (d3_tr - d3_trs) * d3_tsm;
d3_lv2s += (d3_lv2 - d3_lv2s) * d3_gsm;
d3_wet += (d3_twet - d3_wet) * d3_gsm;
d3_dry += (d3_tdry0 + d3_tlk * (0.35 + 0.65 * d3_trs) - d3_dry) * d3_gsm;
zz_o += (zz_t - zz_o) * d3_gsm; zz_on = zz_o > 0.00001;
d3_k2 = max(d3_kb - d3_sg * d3_e2, 0.5); d3_ik2 = 1 / d3_k2;
d3_kf = max(d3_kb - d3_sg * d3_e3, 0.5); d3_ikf = 1 / d3_kf;
chL.fz_rc(); !d3_m1 ? chR.fz_rc();
d3_yl = chL.d3_os(d3_c1l) * d3_lv2s;
d3_m1 ? ( d3_yr = d3_yl; d3_rst = 1; ) : d3_yr = chR.d3_os(d3_c1r) * d3_lv2s;
d3_a = d3_m1 ? abs(chL.lw) : max(abs(chL.lw), abs(chR.lw)); d3_e2 += (d3_a > d3_e2 ? d3_eat : d3_ert) * (d3_a - d3_e2);
d3_a = d3_m1 ? abs(chL.lf) : max(abs(chL.lf), abs(chR.lf)); d3_e3 += (d3_a > d3_e3 ? d3_eat : d3_ert) * (d3_a - d3_e3);
d3_yl = chL.d3_dc(d3_yl); d3_yr = d3_m1 ? d3_yl : chR.d3_dc(d3_yr);
d3_yl != d3_yl ? d3_yl = 0; d3_yr != d3_yr ? d3_yr = 0;
pwr_out(d3_yl, d3_yr);
ost_out(pwr_l * os_g, pwr_r * os_g);
d3_ol = max(-4, min(4, ost_l)); d3_or = max(-4, min(4, ost_r));
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( d3_ol += (rw_l - d3_ol) * by_s; d3_or += (rw_r - d3_or) * by_s; );
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f);
