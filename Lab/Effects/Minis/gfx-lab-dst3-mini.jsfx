function mg_badge(x, y, s, f) local(tw, th, bw, bh) (
  gfx_setfont(6); gfx_measurestr(s, tw, th); bw = tw / sc + 12; bh = 20;
  ui_col(0x1A1A1C); mg_rr(x, y, bw, bh, 3); ui_col(f); mg_rr(x + 1, y + 1, bw - 2, bh - 2, 2);
  ui_col(0x1A1A1C); gfx_x = (x + 6) * sc; gfx_y = (y + bh / 2 + 0.5) * sc - th * 0.5; gfx_drawstr(s);
