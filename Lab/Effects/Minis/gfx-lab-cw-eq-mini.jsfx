desc:CW EQ Mini [parametric EQ] (GFX Lab)
//tags: equaliser eq parametric five-band shelf bell filter mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:lf_g=0<-20,20,0.1>-LF gain (dB)
slider3:lf_f=77<20,500,1>-LF freq (Hz)
slider4:lf_t=0<0,1,1{Shelf,Bell}>-LF type
slider5:lf_q=1<0.3,6,0.01>-LF Q
slider6:lm_g=0<-20,20,0.1>-LMF gain (dB)
slider7:lm_f=220<40,1000,1>-LMF freq (Hz)
slider8:lm_q=1<0.3,6,0.01>-LMF Q
slider9:mf_g=0<-20,20,0.1>-MF gain (dB)
slider10:mf_f=990<200,5000,1>-MF freq (Hz)
slider11:mf_q=1<0.3,6,0.01>-MF Q
slider12:hm_g=0<-20,20,0.1>-HMF gain (dB)
slider13:hm_f=3300<800,12000,1>-HMF freq (Hz)
slider14:hm_q=1<0.3,6,0.01>-HMF Q
slider15:hf_g=0<-20,20,0.1>-HF gain (dB)
slider16:hf_f=9900<2000,20000,1>-HF freq (Hz)
slider17:hf_t=0<0,1,1{Shelf,Bell}>-HF type
slider18:hf_q=1<0.3,6,0.01>-HF Q
slider19:eqtype=0<0,3,1{Gentle,Tight,Constant Q,Asymmetric}>-EQ type
slider20:hpf=20<20,1000,1>-HPF (Hz, 20 = off)
slider21:lpf=20000<1000,20000,1>-LPF (Hz, 20000 = off)
slider22:s24=0<0,1,1{12 dB,24 dB}>-Filter slope
slider23:out_db=0<-12,12,0.1>-Output (dB)
slider24:lf_dy=0<0,1,1{Off,On}>-LF dynamic
slider25:lm_dy=0<0,1,1{Off,On}>-LMF dynamic
slider26:mf_dy=0<0,1,1{Off,On}>-MF dynamic
slider27:hm_dy=0<0,1,1{Off,On}>-HMF dynamic
slider28:hf_dy=0<0,1,1{Off,On}>-HF dynamic
slider29:dy_thr=-20<-60,0,0.1>-Dynamic threshold (dB)
slider30:prs_sel=0<0,15,1{No preset,Init,Vocal: Presence and Air,Vocal: De-Box,Kick: Punch,Snare: Body and Crack,Bass: Definition,Acoustic: Sparkle,Electric: Bite,Piano: Clarity,Drums: Overheads,Mix: Smile,Mix: Gentle Master,FX: Telephone,Dynamic: Tame Harshness,Dynamic: Tighten Low End}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-cw-eq-mini";
ext_noinit = 1;

BND = 3000000; BS = 48;

function cw_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function cw_db(d) ( exp(d * 0.11512925464970228); );
function cw_tg(f) ( tan($pi * min(f, srate * 0.45) / srate); );
function cw_qm(t, db) local(a) (
  a = min(abs(db), 20) / 20;
  t < 0.5 ? 0.45 + 0.9 * a : t < 1.5 ? 0.7 + 1.6 * a : t < 2.5 ? 1 : db >= 0 ? 0.6 + a : 1.2 + 1.2 * a;
);
function cw_qs(t) ( t < 0.5 ? 0.55 : t < 1.5 ? 0.65 : t < 2.5 ? 0.7071 : 0.9; );
function cw_qmul(db) local(t0, u) ( t0 = floor(et_s); u = et_s - t0; cw_qm(t0, db) * (1 - u) + cw_qm(min(t0 + 1, 3), db) * u; );
function cw_qsh() local(t0, u) ( t0 = floor(et_s); u = et_s - t0; cw_qs(t0) * (1 - u) + cw_qs(min(t0 + 1, 3)) * u; );

function cw_coef(p) local(amp, g, k, a1, q, f, kd) (
  f = p[5]; kd = p[7];
  amp = exp(p[19] * 0.05756462732485115);
  kd == 0 ? ( q = cw_qsh(); g = cw_tg(f) / sqrt(amp); k = 1 / q; p[11] = 1; p[12] = k * (amp - 1); p[13] = amp * amp - 1; ) :
  kd == 2 ? ( q = cw_qsh(); g = cw_tg(f) * sqrt(amp); k = 1 / q; p[11] = amp * amp; p[12] = k * (1 - amp) * amp; p[13] = 1 - amp * amp; ) :
            ( q = p[6] * cw_qmul(p[19]); g = cw_tg(f); k = 1 / (q * amp); p[11] = 1; p[12] = k * (amp * amp - 1); p[13] = 0; );
  a1 = 1 / (1 + g * (g + k));
  p[8] = a1; p[9] = g * a1; p[10] = g * g * a1;
  p[14] = p[5]; p[15] = p[19]; p[16] = p[6]; p[17] = et_s; p[18] = p[7];
);
function cw_svf(x, p, s) local(v1, v2, v3) (
  v3 = x - s[1];
  v1 = p[8] * s[0] + p[9] * v3;
  v2 = s[1] + p[9] * s[0] + p[10] * v3;
  s[0] = cw_tn(2 * v1 - s[0]); s[1] = cw_tn(2 * v2 - s[1]);
  p[11] * x + p[12] * v1 + p[13] * v2;
);
function cw_glide(p) local(gt) (
  gt = p[3] != p[7] ? 0 : p[0];
  p[4] += (gt - p[4]) * sm; abs(p[4] - gt) < 0.0005 ? p[4] = gt;
  p[5] += (p[1] - p[5]) * sm; abs(p[5] - p[1]) < 0.01 ? p[5] = p[1];
  p[6] += (p[2] - p[6]) * sm; abs(p[6] - p[2]) < 0.0001 ? p[6] = p[2];
  p[3] != p[7] && p[4] == 0 ? p[7] = p[3];
  p[19] = p[4] * p[24];
  (p[5] != p[14] || (p[24] != 1 ? abs(p[19] - p[15]) > 0.01 : p[19] != p[15]) || p[6] != p[16] || et_s != p[17] || p[7] != p[18]) ? cw_coef(p);
  p[4] != 0;
);
function cw_det(p, l, r) local(g, k, v1, v2, v3, dl, dr, lv, ed, wt) (
  p[5] != p[35] || p[7] != p[36] || p[6] != p[37] ? (
    g = cw_tg(p[5]); k = p[7] == 1 ? 1 / max(p[6], 0.3) : 1.4142136;
    p[30] = 1 / (1 + g * (g + k)); p[31] = g * p[30]; p[32] = g * p[31]; p[33] = k;
    p[35] = p[5]; p[36] = p[7]; p[37] = p[6];
  );
  v3 = l - p[27]; v1 = p[30] * p[26] + p[31] * v3; v2 = p[27] + p[31] * p[26] + p[32] * v3;
  p[26] = cw_tn(2 * v1 - p[26]); p[27] = cw_tn(2 * v2 - p[27]);
  dl = p[7] == 0 ? v2 : p[7] == 2 ? l - p[33] * v1 - v2 : p[33] * v1;
  v3 = r - p[29]; v1 = p[30] * p[28] + p[31] * v3; v2 = p[29] + p[31] * p[28] + p[32] * v3;
  p[28] = cw_tn(2 * v1 - p[28]); p[29] = cw_tn(2 * v2 - p[29]);
  dr = p[7] == 0 ? v2 : p[7] == 2 ? r - p[33] * v1 - v2 : p[33] * v1;
  lv = max(abs(dl), abs(dr));
  p[34] += (lv - p[34]) * (lv > p[34] ? env_a : env_r); p[34] = cw_tn(p[34]);
  ed = p[34] > 0.000001 ? 8.685889638065035 * log(p[34]) : -120;
  wt = p[25] ? min(1, max(0, (ed - dy_thr) * 0.5 / max(abs(p[0]), 0.5))) : 1;
  p[24] += (wt - p[24]) * (wt > p[24] ? dy_at : dy_rl);
  abs(p[24] - wt) < 0.0001 ? p[24] = wt;
);

function svf_set(fc, q) instance(g, k, a1, a2, a3) (
  g = cw_tg(fc); k = 1 / q; a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf_tick(x) instance(k, a1, a2, a3, ic1, ic2, lp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = cw_tn(2 * v1 - ic1); ic2 = cw_tn(2 * v2 - ic2);
  lp = v2; hp = x - k * v1 - v2;
);
function svf_clr() instance(ic1, ic2, lp, hp) ( ic1 = ic2 = lp = hp = 0; );
function cw_hp(x) instance(a, b) local(y1, y2) (
  this.a.svf_tick(x); y1 = this.a.hp; this.b.svf_tick(y1); y2 = this.b.hp;
  y1 + (y2 - y1) * s24_s;
);
function cw_lp(x) instance(a, b) local(y1, y2) (
  this.a.svf_tick(x); y1 = this.a.lp; this.b.svf_tick(y1); y2 = this.b.lp;
  y1 + (y2 - y1) * s24_s;
);
function cw_fclr() ( HL.a.svf_clr(); HL.b.svf_clr(); HR.a.svf_clr(); HR.b.svf_clr(); LL.a.svf_clr(); LL.b.svf_clr(); LR.a.svf_clr(); LR.b.svf_clr(); );
function cw_fset() (
  HL.a.svf_set(hz_s, q1_s); HL.b.svf_set(hz_s, 1.3065630); HR.a.svf_set(hz_s, q1_s); HR.b.svf_set(hz_s, 1.3065630);
  LL.a.svf_set(lz_s, q1_s); LL.b.svf_set(lz_s, 1.3065630); LR.a.svf_set(lz_s, q1_s); LR.b.svf_set(lz_s, 1.3065630);
  hz_l = hz_s; lz_l = lz_s; qz_l = q1_s;
);

function cw_band(b, g, f, t, q, dy) local(p) (
  p = BND + b * BS; p[0] = g; p[1] = f; p[2] = q; p[3] = t; p[25] = dy >= 0.5;
);
function cw_params() (
  cw_band(0, lf_g, lf_f, lf_t >= 0.5 ? 1 : 0, lf_q, lf_dy);
  cw_band(1, lm_g, lm_f, 1, lm_q, lm_dy);
  cw_band(2, mf_g, mf_f, 1, mf_q, mf_dy);
  cw_band(3, hm_g, hm_f, 1, hm_q, hm_dy);
  cw_band(4, hf_g, hf_f, hf_t >= 0.5 ? 1 : 2, hf_q, hf_dy);
  et_t = max(0, min(3, eqtype | 0));
  hz_t = max(20, min(hpf, 1000)); lz_t = max(1000, min(lpf, 20000));
  hp_t = hpf > 20.5; lp_t = lpf < 19999.5;
  q1_t = s24 >= 0.5 ? 0.5411961 : 0.7071068; s24_t = s24 >= 0.5;
  out_t = cw_db(out_db);
);
function cw_rate() (
  cw_sr = srate;
  sm = 1 - exp(-1 / (0.02 * srate));
  c_sw = 1 - exp(-1 / (0.012 * srate));
  rs_c = 1 / (0.015 * srate);
  env_a = 1 - exp(-1000 / (2 * srate)); env_r = 1 - exp(-1000 / (40 * srate));
  dy_at = 1 - exp(-1000 / (10 * srate)); dy_rl = 1 - exp(-1000 / (150 * srate));
);
function cw_snapv() local(b, p) (
  et_s = et_t; hz_s = hz_t; lz_s = lz_t; hp_m = hp_t; lp_m = lp_t; q1_s = q1_t; s24_s = s24_t; out_s = out_t;
  b = 0; loop(5, p = BND + b * BS; p[4] = p[0]; p[5] = p[1]; p[6] = p[2]; p[7] = p[3]; p[24] = p[25] ? 0 : 1; p[19] = p[4] * p[24]; cw_coef(p); b += 1; );
  cw_fset();
);
function cw_reset() local(b, p) (
  b = 0; loop(5, p = BND + b * BS; p[20] = p[21] = p[22] = p[23] = 0; p[26] = p[27] = p[28] = p[29] = p[34] = 0; b += 1; );
  cw_fclr();
  memset(BY_BUF, 0, 2 * BY_N);
  rs_f = 0;
);

memset(BND, 0, 5 * BS); b_ = 0; loop(5, (BND + b_ * BS)[24] = 1; (BND + b_ * BS)[35] = -1; b_ += 1; );
cw_rate();
cw_params();
cw_snapv();
cw_reset();
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.08; pwr_wu_loss = 0.25; pwr_wu_drv = 0.4; pwr_wu_lp = 14000; pwr_wu_wob = 0.1; pwr_bloom = 0;
rs_f = 1; cw_snap = 1; cw_blk = 0;
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;

function cw_set(t0, f0, q0, g0, t1, f1, q1, g1, t2, f2, q2, g2, t3, f3, q3, g3, t4, f4, q4, g4, et, hp, lp, sl, o) (
  lf_t = t0; lf_f = f0; lf_q = q0; lf_g = g0;
  lm_f = f1; lm_q = q1; lm_g = g1;
  mf_f = f2; mf_q = q2; mf_g = g2;
  hm_f = f3; hm_q = q3; hm_g = g3;
  hf_t = t4; hf_f = f4; hf_q = q4; hf_g = g4;
  eqtype = et; hpf = hp; lpf = lp; s24 = sl; out_db = o;
  lf_dy = lm_dy = mf_dy = hm_dy = hf_dy = 0; dy_thr = -20;
);
function load_preset(p) local(i) (
  p == 2 ? cw_set(0, 77, 1, 0, 1, 330, 1.2, -2, 1, 990, 1, 0, 1, 4400, 1, 3, 0, 12000, 1, 3, 0, 77, 20000, 0, -0.5) :
  p == 3 ? cw_set(0, 77, 1, 0, 1, 440, 2, -4, 1, 990, 1, 0, 1, 3300, 1, 0, 0, 9900, 1, 2, 3, 99, 20000, 0, 0.5) :
  p == 4 ? cw_set(1, 55, 1.2, 4, 1, 330, 1.5, -5, 1, 990, 1, 0, 1, 3300, 1.5, 4, 0, 9900, 1, 0, 1, 20, 20000, 0, -1.5) :
  p == 5 ? cw_set(0, 77, 1, 0, 1, 220, 1.2, 3, 1, 880, 2, -3, 1, 5500, 1, 4, 0, 9900, 1, 0, 0, 77, 20000, 0, -1) :
  p == 6 ? cw_set(0, 77, 1, 2, 1, 220, 1.5, -2, 1, 770, 1.5, 3, 1, 3300, 1, 0, 0, 9900, 1, 0, 0, 20, 7700, 0, -0.5) :
  p == 7 ? cw_set(0, 77, 1, 0, 1, 220, 1.2, -3, 1, 990, 1, 0, 1, 5500, 0.8, 2, 0, 12000, 1, 3, 0, 77, 20000, 0, 0) :
  p == 8 ? cw_set(0, 77, 1, 0, 1, 220, 1, -2, 1, 1100, 1.5, 3, 1, 3300, 1, 0, 0, 7700, 1, -2, 0, 88, 12000, 0, 0) :
  p == 9 ? cw_set(0, 99, 1, -1, 1, 330, 1, -2, 1, 990, 1, 0, 1, 3300, 0.8, 2, 0, 9900, 1, 2, 0, 20, 20000, 0, -0.5) :
  p == 10 ? cw_set(0, 77, 1, 0, 1, 440, 1.5, -3, 1, 990, 1, 0, 1, 3300, 1, 0, 0, 9900, 1, 3, 0, 110, 20000, 0, 1.5) :
  p == 11 ? cw_set(0, 77, 1, 3, 1, 220, 1, 0, 1, 990, 0.7, -2, 1, 3300, 1, 0, 0, 9900, 1, 3, 0, 20, 20000, 0, 0.5) :
  p == 12 ? cw_set(0, 44, 1, 1, 1, 220, 1, 0, 1, 2200, 0.7, -0.5, 1, 3300, 1, 0, 0, 16000, 1, 1.5, 0, 20, 20000, 0, 0) :
  p == 13 ? cw_set(0, 77, 1, 0, 1, 220, 1, 0, 1, 1100, 1, 6, 1, 3300, 1, 0, 0, 9900, 1, 0, 2, 440, 3300, 1, 2.5) :
  p == 14 ? ( cw_set(0, 77, 1, 0, 1, 220, 1, 0, 1, 990, 1, 0, 1, 3300, 2, -6, 0, 9900, 1, -3, 0, 20, 20000, 0, 0); hm_dy = hf_dy = 1; dy_thr = -30; ) :
  p == 15 ? ( cw_set(0, 77, 1, -5, 1, 220, 1.2, -4, 1, 990, 1, 0, 1, 3300, 1, 0, 0, 9900, 1, 0, 0, 22, 20000, 0, 0); lf_dy = lm_dy = 1; dy_thr = -24; ) :
  cw_set(0, 77, 1, 0, 1, 220, 1, 0, 1, 990, 1, 0, 1, 3300, 1, 0, 0, 9900, 1, 0, 0, 20, 20000, 0, 0);
  i = 2; loop(28, ui_auto(i); i += 1; );
  pr_cur = p == 16 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
pk_lcdstrip = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(29, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 15 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(15, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
cw_params();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && cw_blk < 40 ? cw_snap = 1;
pwr_ser();

@block
prs_chk();
cw_blk < 40 ? cw_blk += 1;
srate != cw_sr ? ( cw_rate(); cw_params(); cw_snapv(); cw_reset(); );
cw_params();
pwr_block(byp < 0.5);
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? cw_reset();
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
cw_snap ? ( cw_snap = 0; cw_snapv(); );
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
out_s += (out_t - out_s) * sm;
et_s += (et_t - et_s) * sm; abs(et_s - et_t) < 0.0005 ? et_s = et_t;
hz_s *= (hz_t / hz_s) ^ sm; abs(hz_s - hz_t) < 0.0005 * hz_t ? hz_s = hz_t;
lz_s *= (lz_t / lz_s) ^ sm; abs(lz_s - lz_t) < 0.0005 * lz_t ? lz_s = lz_t;
q1_s += (q1_t - q1_s) * c_sw; abs(q1_s - q1_t) < 0.0001 ? q1_s = q1_t;
s24_s += (s24_t - s24_s) * c_sw; abs(s24_s - s24_t) < 0.0001 ? s24_s = s24_t;
hp_m += (hp_t - hp_m) * c_sw; abs(hp_m - hp_t) < 0.0001 ? hp_m = hp_t;
lp_m += (lp_t - lp_m) * c_sw; abs(lp_m - lp_t) < 0.0001 ? lp_m = lp_t;
(hz_s != hz_l || lz_s != lz_l || q1_s != qz_l) ? cw_fset();

x = spl0; xb = spl1;
pwr_in(x, xb); x = pwr_l; xb = pwr_r;
hp_m > 0 ? (
  y = HL.cw_hp(x); yb = HR.cw_hp(xb);
  x += (y - x) * hp_m; xb += (yb - xb) * hp_m;
) : ( HL.a.svf_clr(); HL.b.svf_clr(); HR.a.svf_clr(); HR.b.svf_clr(); );
lp_m > 0 ? (
  y = LL.cw_lp(x); yb = LR.cw_lp(xb);
  x += (y - x) * lp_m; xb += (yb - xb) * lp_m;
) : ( LL.a.svf_clr(); LL.b.svf_clr(); LR.a.svf_clr(); LR.b.svf_clr(); );
dxl = x; dxr = xb;
sb = 0;
loop(5,
  sp = BND + sb * BS;
  (sp[25] || sp[24] != 1) ? cw_det(sp, dxl, dxr);
  cw_glide(sp) ? (
    x = cw_svf(x, sp, sp + 20); xb = cw_svf(xb, sp, sp + 22);
  ) : ( sp[20] = sp[21] = sp[22] = sp[23] = 0; );
  sb += 1;
);
pwr_out(x, xb);
oa = pwr_l * out_s; ob = pwr_r * out_s;
oa != oa ? oa = 0; ob != ob ? ob = 0;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_q = rs_f * rs_f * (3 - 2 * rs_f);
  oa = spl0 + (oa - spl0) * rs_q; ob = spl1 + (ob - spl1) * rs_q;
