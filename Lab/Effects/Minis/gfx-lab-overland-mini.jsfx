desc:Overland Mini [drive] (GFX Lab)
//tags: saturation drive tape stereo mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-clip, gfx-lab-os, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider16:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:drive=4<0,10,0.1>-Drive
slider2:lift=3<0,10,0.1>-Clarity (low cut + air)
slider3:terrain=2<0,10,0.1>-Motion (pitch / level drift, grit)
slider4:xfer=1<0,2,1{Full,Bands,Low}>-Saturation mode
slider5:diff=0<0,1,1{Off,On}>-Mono bass
slider6:fog=0<0,1,1{Off,On}>-Soften
slider7:out_db=0<-12,12,0.1>-Output (dB)
slider8:livery=3<0,7,1{Bright & Wide,Bright,Open,Clear,Balanced,Rounded,Warm,Warm & Dense}>-Voicing
slider9:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider10:tape=1<0,1,1{Off,On}>-Tape
slider11:byp=0<0,1,1{Off,On}>-Bypass
slider12:mix=100<0,100,1>-Mix (%)
slider13:in_db=0<-12,12,0.1>-Input (dB)
slider14:drift=50<0,100,1>-Drift (%)
slider15:prs_sel=0<0,12,1{No preset,Init,Gravel Road,Coastal Fog,Hill Climb Bass,Highway Polish,Night Drive,Mountain Pass,Kick in the Mud,Toy Rally,Mix Bus Cruise,Dusty Tape,Off the Map}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(65535, v); );
function psw_allg(v) ( slider_show(65535, v); );
#ui_man = "gfx-lab-overland-mini";
ext_noinit = 1;
gfx_ext_retina = 1;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();

LV = 0;
CO = 500;
SL = 700;  SR = 800;
DSZ = 8192;  DLB = 1000;  DRB = DLB + DSZ;
DRY = 50000;  DRYN = 4096;
function lv_set(i, up, lo, sa, sb, wh, dc) ( LV[i * 6] = up; LV[i * 6 + 1] = lo; LV[i * 6 + 2] = sa; LV[i * 6 + 3] = sb; LV[i * 6 + 4] = wh; LV[i * 6 + 5] = dc; );
lv_set(0, 0x2FA7B6, 0xD7DBDB, 0x1E2A31, 0x1E2A31, 0x1C1C1C, 0x1E2A31);
lv_set(1, 0xA7B8A8, 0x9DAE9E, 0x2C3830, 0x55705E, 0x1C1C1C, 0x2C3830);
lv_set(2, 0xCBA676, 0xBF9A69, 0x5E3F24, 0xE8CDA0, 0x1C1C1C, 0x5E3F24);
lv_set(3, 0x6F8299, 0xC9CCCB, 0x2C333D, 0xC85A38, 0xDCDCD6, 0x2C333D);
lv_set(4, 0xE8E3D3, 0x3F5C40, 0x8E3029, 0xE8E3D3, 0xD0D0CA, 0xE8E3D3);
lv_set(5, 0x222A39, 0xB9AB8C, 0xE0D2AA, 0xB4562E, 0xC8C8C2, 0x222A39);
lv_set(6, 0x3B2F27, 0x8C6C4F, 0xE09A55, 0xD8BE7A, 0xC8C8C2, 0xE09A55);
lv_set(7, 0x2F4B37, 0x2A4532, 0xC9A23F, 0xC9A23F, 0x1C1C1C, 0xC9A23F);

function db2g(d) ( exp(d * 0.11512925464970228); );
function tg(f) ( tan($pi * min(f, fsr * 0.45) / fsr); );
function lv_lum(c) ( (0.3 * floor(c / 65536) + 0.59 * (floor(c / 256) % 256) + 0.11 * (c % 256)) / 255; );

function cs_core(i, g, k) local(c) ( c = CO + i * 6;  c[0] = 1 / (1 + g * (g + k));  c[1] = g * c[0];  c[2] = g * c[1]; );
function cs_lp(i, f, q) local(c) ( cs_core(i, tg(f), 1 / q);  c = CO + i * 6;  c[3] = 0;  c[4] = 0;  c[5] = 1; );
function cs_hp(i, f, q) local(c) ( cs_core(i, tg(f), 1 / q);  c = CO + i * 6;  c[3] = 1;  c[4] = -1 / q;  c[5] = -1; );
function cs_ls(i, f, db) local(c, A) ( A = exp(db * 0.05756462732485115);  cs_core(i, tg(f) / sqrt(A), 1.41421356);
  c = CO + i * 6;  c[3] = 1;  c[4] = 1.41421356 * (A - 1);  c[5] = A * A - 1; );
function cs_hs(i, f, db) local(c, A) ( A = exp(db * 0.05756462732485115);  cs_core(i, tg(f) * sqrt(A), 1.41421356);
  c = CO + i * 6;  c[3] = A * A;  c[4] = 1.41421356 * (1 - A) * A;  c[5] = 1 - A * A; );
function svc(x, i, s) local(c, v1, v2, v3) (
  c = CO + i * 6;  v3 = x - s[1];
  v1 = c[0] * s[0] + c[1] * v3;  v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
  c[3] * x + c[4] * v1 + c[5] * v2;
);

function sat_f(x) ( x / (1 + abs(x)); );
function sat_ad(x) ( abs(x) - log(1 + abs(x)); );
function adaa(x) instance(xp, Fp, yp) local(F, yc, d, y) (
  F = sat_ad(x);  yc = sat_f(x);  d = x - xp;
  abs(d) < 0.00001 ? ( y = sat_f(0.5 * (x + xp)); ) : ( y = (F - Fp) / d; );
  y += 0.5 * (yc - yp);
  xp = x;  Fp = F;  yp = yc;  y;
);
STG_REF = 0.25;
function stn(g, b) ( (1 - stg_t) * sqr(1 + b) / g + stg_t * STG_REF / (sat_f(g * STG_REF + b) - sat_f(b)); );
function stage(x, g, b, k, fb) instance(a) (
  ((aa_on ? a.adaa(x * g + b) : sat_f(x * g + b)) - fb) * k;
);

function bq_set(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs;  cw = cos(w0);  sw = sin(w0);  al = sw / (2 * q);  amp = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al;  b0 = (1 - cw) * 0.5 / n;  b1 = (1 - cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al;  b0 = (1 + cw) * 0.5 / n;  b1 = -(1 + cw) / n;  b2 = b0;  a1 = -2 * cw / n;  a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / amp;  b0 = (1 + al * amp) / n;  b1 = -2 * cw / n;  b2 = (1 - al * amp) / n;  a1 = b1;  a2 = (1 - al / amp) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n;  b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n;  a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;  a2 = ((amp + 1) - (amp - 1) * cw - sa) / n; ) :
  ( sa = 2 * sqrt(amp) * al;  n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n;  b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n;  a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;  a2 = ((amp + 1) + (amp - 1) * cw - sa) / n; );
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;  x2 = x1;  x1 = x;  y2 = y1;  y1 = y;  y;
);

function hd_aa() instance(u1, u2, u3, u4, d1, d2, d3, d4) local(fc, fs2) (
  fs2 = 2 * srate;  fc = min(0.42 * srate, 20000);
  u1.bq_set(0, fc, 0.5098, 0, fs2);  u2.bq_set(0, fc, 0.6013, 0, fs2);  u3.bq_set(0, fc, 0.9000, 0, fs2);  u4.bq_set(0, fc, 2.5629, 0, fs2);
  d1.bq_set(0, fc, 0.5098, 0, fs2);  d2.bq_set(0, fc, 0.6013, 0, fs2);  d3.bq_set(0, fc, 0.9000, 0, fs2);  d4.bq_set(0, fc, 2.5629, 0, fs2);
);
function hd_eq(voice, hpf, hsdb) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, hhp, hhs) (
  emp.bq_set(3, 3000, 0.7, 4, fsr);  dem.bq_set(3, 3000, 0.7, -4, fsr);
  voice == 1 ? ( vpre.bq_set(2, 1400, 0.6, 3.5, fsr);  vpost.bq_set(2, 1400, 0.6, -1.5, fsr); ) :
  voice == 2 ? ( vpre.bq_set(3, 6000, 0.7, 5, fsr);    vpost.bq_set(3, 6000, 0.7, -2, fsr); ) :
               ( vpre.bq_set(2, 1000, 0.7, 0, fsr);    vpost.bq_set(2, 1000, 0.7, 0, fsr); );
  bump.bq_set(2, 70, 0.9, hd_bump, fsr);
  gap.bq_set(0, voice == 2 ? 21000 : voice == 1 ? 18000 : 16000, 0.55, 0, fsr);
  dcb.bq_set(1, 10, 0.7, 0, fsr);
  lop.bq_set(0, 250, 0.6, 0, fsr);
  hhp.bq_set(1, hpf, 0.7071, 0, fsr);
  hhs.bq_set(3, 5000, 0.7, hsdb, fsr);
);
function hd_sat(x, b) (
  (ost_tanh(hd_g * x + b) - hd_tb) * hd_c;
);
function hd_clr() instance(u1, u2, u3, u4, d1, d2, d3, d4) (
  u1.x1 = u1.x2 = u1.y1 = u1.y2 = 0;  u2.x1 = u2.x2 = u2.y1 = u2.y2 = 0;  u3.x1 = u3.x2 = u3.y1 = u3.y2 = 0;  u4.x1 = u4.x2 = u4.y1 = u4.y2 = 0;
  d1.x1 = d1.x2 = d1.y1 = d1.y2 = 0;  d2.x1 = d2.x2 = d2.y1 = d2.y2 = 0;  d3.x1 = d3.x2 = d3.y1 = d3.y2 = 0;  d4.x1 = d4.x2 = d4.y1 = d4.y2 = 0;
);
function hd_run(x, b) instance(emp, dem, vpre, vpost, bump, gap, dcb, lop, hhp, hhs, u1, u2, u3, u4, d1, d2, d3, d4, tlp) local(y, z, lo, yt) (
  lo = lop.bq_run(x) * hd_lb;
  y = hhp.bq_run(vpre.bq_run(emp.bq_run(x - lo))) * 0.5;
  os_f == 1 && tp_w > 0.0005 ? (
    z = u4.bq_run(u3.bq_run(u2.bq_run(u1.bq_run(y * 2))));
    d4.bq_run(d3.bq_run(d2.bq_run(d1.bq_run(hd_sat(z, b)))));
    z = u4.bq_run(u3.bq_run(u2.bq_run(u1.bq_run(0))));
    yt = d4.bq_run(d3.bq_run(d2.bq_run(d1.bq_run(hd_sat(z, b))))) * 2;
    y = tp_w < 0.9995 ? hd_sat(y, b) * 2 + (yt - hd_sat(y, b) * 2) * tp_w : yt;
  ) : ( y = hd_sat(y, b) * 2; );
  y = hhs.bq_run(dcb.bq_run(gap.bq_run(bump.bq_run(vpost.bq_run(dem.bq_run(y)) + lo * hd_lg))));
  tp_w < 0.9995 ? ( tlp += tp_k * (y - tlp);  y = tlp + (y - tlp) * tp_w; ) : tlp = y;
  y;
);

function dk_pre(t, f, q, g) ( this.aL.bq_set(t, f, q, g, fsr);  this.aR.bq_set(t, f, q, g, fsr); );
function dk_post(t, f, q, g) ( this.bL.bq_set(t, f, q, g, fsr);  this.bR.bq_set(t, f, q, g, fsr); );
function dk_model(m) instance(atm, rlm, thr, rat, kh, kw0, kw1, mas, air, trim) (
  mas = m == 3;  air = m == 4;
  m == 1 ? ( atm = 3;    rlm = 180; thr = -5; rat = 0.75;  kh = 3; kw0 = 0.3; kw1 = 0.6;
             this.dk_pre(2, 700, 0.7, 2);    this.dk_post(2, 700, 0.7, -2);    trim = 10 ^ (-2.26 / 20); ) :
  m == 3 ? ( atm = 0.05; rlm = 300; thr = -2; rat = 0.95;  kh = 6; kw0 = 0.4; kw1 = 0.8;
             this.dk_pre(4, 60, 0.707, 0);   this.dk_post(3, 12000, 0.707, -0.7); trim = 10 ^ (-2.24 / 20); ) :
           ( atm = 1.5;  rlm = 150; thr = -5; rat = 0.667; kh = 4; kw0 = 0.3; kw1 = 0.6;
             this.dk_pre(3, 6000, 0.707, 3); this.dk_post(3, 6000, 0.707, -1.5);  trim = 10 ^ (-2.63 / 20); );
  this.kL.clp_set(2, 1, 0.93, 0);  this.kR.clp_set(2, 1, 0.93, 0);
);
function dk_block(ddb) instance(atm, rlm, att, rel, gd, go, trim, kw0, kw1, dv) (
  dv = min(max(ddb / 24, 0), 1);
  att = 1 - exp(-1 / (max(atm, 0.02) * 0.001 * fsr));  rel = 1 - exp(-1 / (rlm * 0.001 * fsr));
  gd = 10 ^ (ddb / 20);  go = trim * 10 ^ (-0.5 * ddb / 20) * dk_mk;
  this.kL.clp_knee(kw0 + (kw1 - kw0) * dv);  this.kR.clp_knee(kw0 + (kw1 - kw0) * dv);
);
function dk_gr(e) instance(thr, rat, kh) local(o) (
  o = 20 * log10(max(e, 0.000000001)) - thr;
  o <= -kh ? 0 : o >= kh ? rat * o : rat * sqr(o + kh) / (4 * kh);
);
function dk_run(l, r) instance(att, rel, env, hsL, hsR, gd, go, mas, air, apL, apR, slp, wk, dv, ol, orr) local(pl, pr, al, ar, g, y, s, h) (
  pl = this.aL.bq_run(l * gd);  pr = this.aR.bq_run(r * gd);
  mas ? ( hsL += dk_hk * (pl - hsL);  hsR += dk_hk * (pr - hsR);  al = abs(pl - hsL);  ar = abs(pr - hsR); )
      : ( al = abs(pl);  ar = abs(pr); );
  al = max(al, ar);
  env += (al > env ? att : rel) * (al - env);
  g = 10 ^ (-this.dk_gr(env) / 20);
  ol = this.bL.bq_run(this.kL.clp_run(pl * g)) * go;
  orr = this.bR.bq_run(this.kR.clp_run(pr * g)) * go;
  air ? (
    wk = 0.25 * dv + 0.6 * (1 - g);
    y = dk_apl * ol + apL;  apL = ol - dk_apl * y;  ol = y;
    y = dk_apr * orr + apR;  apR = orr - dk_apr * y;  orr = y;
    s = 0.5 * (ol - orr);  slp += dk_slk * (s - slp);  h = (s - slp) * wk;
    ol += h;  orr -= h;
  );
);

C_LC = 0;  C_HS = 1;  C_X1 = 2;  C_X2 = 3;  C_X3 = 4;  C_L3 = 5;  C_SUB = 6;  C_DF = 7;  C_FOG = 8;  C_GR = 9;  C_TT = 10;

function ch_tick(x, sb, hb) instance(s2, s41, s42, s43, s44, s3l, s3h, sgr, env3, subff, subpv, hd, wlp, hfh)
  local(yc, hfl, y, y2, y4, y3, b1, r1, b2, r2, b3, b4, lo, hi, gc, sb1, sub, hp, gk, f, dl, ya, yh)
(
  y = svc(x, C_LC, sb);
  hfl = svc(y, C_TT, sb + 44);  hfh = y - hfl;
  yc = hfl + hfh * hf_g;
  y2 = y4 = y3 = 0;
  w2 > 0.0005 ? ( y2 = s2.stage(yc, dg, st2_b, st2_k, st2_f); );
  w4 > 0.0005 ? (
    b1 = svc(svc(yc, C_X1, sb + 2), C_X1, sb + 4);  r1 = yc - b1;
    b2 = svc(svc(r1, C_X2, sb + 6), C_X2, sb + 8);  r2 = r1 - b2;
    b3 = svc(svc(r2, C_X3, sb + 10), C_X3, sb + 12);  b4 = r2 - b3;
    dl = dg * (1 + 0.6 * lsat_s);
    y4 = s41.stage(b1, dl, st41_b, st41_k, st41_f) + s42.stage(b2, dg, 0.04, st42_k, st42_f) + s43.stage(b3, dg, 0.03, st43_k, st43_f) + s44.stage(b4, st44_g, 0.02, st44_k, st44_f);
  );
  w3 > 0.0005 ? (
    lo = svc(svc(yc, C_L3, sb + 14), C_L3, sb + 16);  hi = yc - lo;
    env3 += (abs(lo) - env3) * (abs(lo) > env3 ? e3_a : e3_r);
    gc = 1 / (1 + env3 * dg * 0.9);
    lo = s3l.stage(lo * gc * (1 + drive_s * 0.1), st3l_g, st3l_b, st3l_k, st3l_f);
    hi = s3h.stage(hi, st3h_g, 0.02, st3h_k, st3h_f);
    sb1 = svc(lo, C_SUB, sb + 18);
    (sb1 > 0 && subpv <= 0) ? subff = -subff;  subff == 0 ? subff = 1;  subpv = sb1;
    sub = svc(subff * min(1, env3 * 2.5), C_SUB, sb + 20);
    y3 = lo + hi + sub * sub_amt;
  );
  ya = y2 * w2 + y4 * w4 + y3 * w3;
  yh = hd.hd_run(y, hb);
  y = ya + (yh - ya) * hmix;
  grit > 0 ? (
    hp = svc(y, C_GR, sb + 22);  gk = 1 + grit * 5;
    y = y - hp + (aa_on ? sgr.adaa(hp * gk) : sat_f(hp * gk)) / gk * (1 + grit * 0.6);
  );
  y = svc(y, C_HS, sb + 24);
  f = svc(y, C_FOG, sb + 26);  y += (f - y) * fog_w;
  wlp_on ? ( y = wlp.bq_run(y); );
  y;
);

function update_targets() local(b) (
  b = (lv_lum(LV[livery * 6]) + lv_lum(LV[livery * 6 + 1])) * 0.5;
  b = max(0, min(1, (b - 0.2) / 0.6));
  hsc_t  = 0.55 + 0.9 * b;
  lsat_t = 1 - b;
  wid_t  = 0.88 + 0.3 * b;
  drive_t = drive;  lift_t = lift;  terr_t = terrain;
  xf = floor(xfer + 0.5);  w2t = xf <= 0;  w4t = xf == 1;  w3t = xf >= 2;
  diff_t = diff;  fog_t = fog;  out_t = db2g(out_db);  os_tf = os_f2n(os_sel);
  in_t = db2g(in_db);  inc_t = db2g(in_db > 0 ? -0.35 * in_db : -0.85 * in_db);  mix_t = mix / 100;
  tp_t = tape >= 0.5;
);

fz_C = 40000;
function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_tiny(v) ( abs(v) < 0.000000000001 ? 0 : v; );
function fz_run(x) instance(qA, qB, qC, qD, fhi, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = qA.fz_bm(x, fz_C);
  ha = abs(h); fhi += (ha - fhi) * (ha > fhi ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fhi, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fhi;
  e = qD.fz_bm(qC.fz_bm(qB.fz_bm(e, fz_C + 5), fz_C + 10), fz_C + 15);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_dn() instance(fhi, fp, fe) ( fhi = fz_tiny(fhi); fp = fz_tiny(fp); fe = fz_tiny(fe); );
function fz_clr() instance(qA, qB, qC, qD, fhi, fp, fe) ( qA.fz_bmz(); qB.fz_bmz(); qC.fz_bmz(); qD.fz_bmz(); fhi = fp = fe = 0; );
function fz_coef() (
  fz_bqc(fz_C, 4, 3500, 0, 0.7071, fsr); fz_bqc(fz_C + 5, 4, 5500, 0, 0.7071, fsr);
  fz_bqc(fz_C + 10, 0, 8000, 4, 0.7, fsr); fz_bqc(fz_C + 15, 2, 12000, -6, 0.7, fsr);
  fz_a = 1 - exp(-1 / (0.003 * fsr)); fz_r = 1 - exp(-1 / (0.12 * fsr)); fz_w = 1 - exp(-1 / (0.06 * fsr));
);
fz_o = fz_t = 0;
first_run = 1;
DLY = ceil(0.0015 * srate);
sm   = 1 - exp(-1 / (0.02 * srate));
dc_k = 1 - exp(-2 * $pi * 2 / srate);
aa_on = 1;  clp_aa = 1;
CR = 16;  cr_n = 0;
hf_ti = 1 / 0.45;  HF_RT = 0.75;  hf_g = 1;
function ov_rate() (
  fsr = srate * os_f;
  e3_a = 1 - exp(-1 / (0.010 * fsr));  e3_r = 1 - exp(-1 / (0.30 * fsr));
  cs_lp(C_X1, 150, 0.70710678);  cs_lp(C_X2, 1200, 0.70710678);  cs_lp(C_X3, 5000, 0.70710678);
  cs_lp(C_L3, 200, 0.70710678);  cs_lp(C_SUB, 90, 0.7071);  cs_lp(C_DF, 120, 0.70710678);
  cs_lp(C_FOG, 6500, 0.6);  cs_hp(C_GR, 3000, 0.7071);
  dkR.dk_model(1);  dkM.dk_model(3);  dkA.dk_model(4);
  dk_hk = 1 - exp(-2 * $pi * 90 / fsr);
  dk_apl = (tan($pi * 4500 / fsr) - 1) / (tan($pi * 4500 / fsr) + 1);
  dk_apr = (tan($pi * 6500 / fsr) - 1) / (tan($pi * 6500 / fsr) + 1);
  dk_slk = 1 - exp(-2 * $pi * 2500 / fsr);
  tp_k = 1 - exp(-2 * $pi * 6600 / fsr);
  cs_lp(C_TT, 2200, 0.70710678);  hf_a = 1 - exp(-1 / (0.0005 * fsr));  hf_r = 1 - exp(-1 / (0.06 * fsr));
  fz_coef();  coef_dirty = 1;  coef_hd = 1;  wlp_last = -1;
  dkR.dk_block(dk_ddb);  dkM.dk_block(dk_ddb);  dkA.dk_block(dk_ddb);
);
os_design();
os_f = os_tf = os_f2n(os_sel);  os_base = DLY;
os_gsetup();
ov_rate();
dw_pos = 0;  wob_t = 0;  wob_v = 0;  wob_tgt = 0;  ph1 = 0;  ph2 = 0;
chL.hd.hd_aa();  chR.hd.hd_aa();  coef_hd = 1;  hd_lastd = -1;  wlp_last = -1;
NB = 24;

function ctl() (
  kb = 1 - exp(-CR / (0.04 * srate));
  dr_sp = 0.05 * dm_s * CR / srate;
  dr_dv = 0.6 * dm_a * DRV1.drift_tick(dr_sp);
  dr_bv = 0.012 * dm_a * DRV2.drift_tick(dr_sp * 0.7);
  dr_wv = 0.04 * dm_a * DRV3.drift_tick(dr_sp * 1.3);
  lift_s += (lift_t - lift_s) * kb;  hsc_s += (hsc_t - hsc_s) * kb;  lsat_s += (lsat_t - lsat_s) * kb;  wid_s += (wid_t - wid_s) * kb;
  drive_s += (drive_t - drive_s) * kb;  terr_s += (terr_t - terr_s) * kb;
  (coef_dirty || abs(lift_s - lift_c) > 0.002 || abs(hsc_s - hsc_c) > 0.002) ? (
    cs_ls(C_LC, 150, -0.8 * lift_s);  cs_hs(C_HS, 6000, 0.5 * lift_s * hsc_s);
    lift_c = lift_s;  hsc_c = hsc_s;  coef_dirty = 0;
  );
  dg = db2g(drive_s * 1.5 * (1 - 0.4 * hmix) + dr_dv);
  stg_t = min(1, drive_s / 4);
  dn = drive_s / 10;
  hmix = 0.2 + 0.55 * dn ^ 1.2;
  hd_g = 10 ^ ((drive_s * 2.2 + dr_dv) / 20);
  hb_s = 0.03 + 0.07 * lsat_s + dr_bv;
  hd_c = 0.25 / ((ost_tanh(hd_g * 0.125 + hb_s) - ost_tanh(hb_s)) - (ost_tanh(-hd_g * 0.125 + hb_s) - ost_tanh(hb_s)));
  hd_lb = dn ^ 1.2;
  hd_lg = sqrt(hd_g * hd_c * (1 - sqr(ost_tanh(hb_s))));
  hd_bump = 1.5 * (1 - 0.5 * dn);
  hvoice = lsat_s > 0.64 ? 0 : lsat_s > 0.36 ? 1 : 2;
  (abs(drive_s - hd_lastd) > 0.01 || hvoice != hd_lastv || coef_hd) ? (
    chL.hd.hd_eq(hvoice, 20 + 140 * dn ^ 1.5, 4 * dn);  chR.hd.hd_eq(hvoice, 20 + 140 * dn ^ 1.5, 4 * dn);
    hd_lastd = drive_s;  hd_lastv = hvoice;  coef_hd = 0;
  );
  wlp_f = 20000 * 2 ^ (-2 * lsat_s * dn);
  wlp_on = wlp_f < 19000;
  wlp_on && abs(wlp_f - wlp_last) > wlp_f * 0.002 ? (
    chL.wlp.bq_set(0, wlp_f, 0.6, 0, fsr);  chR.wlp.bq_set(0, wlp_f, 0.6, 0, fsr);  wlp_last = wlp_f;
  );
  brt = 1 - lsat_s;
  wid_d = wid_s * (1 + 0.35 * brt * dn) * (1 + dr_wv);
  det_dep = brt * dn * 0.00025 * fsr;
  dk_ddb = 2 + drive_s * 1.0;
  mk_i = min(4.999, dn * 5);  mk_k = floor(mk_i);  mk_f = mk_i - mk_k;
  mk_a = mk_k == 0 ? 2.0 : mk_k == 1 ? 0.2 : mk_k == 2 ? -0.9 : mk_k == 3 ? -0.95 : -0.6;
  mk_b = mk_k == 0 ? 0.2 : mk_k == 1 ? -0.9 : mk_k == 2 ? -0.95 : mk_k == 3 ? -0.6 : -0.1;
  dk_mk = 10 ^ ((mk_a + (mk_b - mk_a) * mk_f) / 20);
  dkR.dk_block(dk_ddb);  dkM.dk_block(dk_ddb);  dkA.dk_block(dk_ddb);
  dwR = max(0, min(1, (lsat_s - 0.55) / 0.3));
  dwA = max(0, min(1, (0.45 - lsat_s) / 0.2));
  dwM = max(0, 1 - dwR - dwA);
  sub_amt = drive_s * 0.035;
  grit = max(0, (terr_s - 5) / 5);
  fz_p = min(max((drive_s - 4) / 6, 0), 1);  fz_t = 0.33 * fz_p * fz_p * (3 - 2 * fz_p);
  wob_t += CR / srate;
  wob_t > 0.45 ? ( wob_t = 0;  wob_tgt = rand(2) - 1; );
  wob_v += (wob_tgt - wob_v) * (1 - exp(-CR / (srate * 0.35)));
  wob_dep = terr_s / 10 * 0.0006 * fsr;
  wob_amp = terr_s / 10 * 0.5;
  hd_tb = ost_tanh(hb_s);
  st2_b = 0.05 + 0.12 * lsat_s;  st2_k = stn(dg, st2_b);  st2_f = sat_f(st2_b);
  st41_g = dg * (1 + 0.6 * lsat_s);  st41_b = 0.04 + 0.16 * lsat_s;  st41_k = stn(st41_g, st41_b);  st41_f = sat_f(st41_b);
  st42_k = stn(dg, 0.04);  st42_f = sat_f(0.04);  st43_k = stn(dg, 0.03);  st43_f = sat_f(0.03);
  st44_g = dg * 0.85;  st44_k = stn(st44_g, 0.02);  st44_f = sat_f(0.02);
  st3l_g = dg * (1.5 + 0.6 * lsat_s);  st3l_b = 0.08 + 0.18 * lsat_s;  st3l_k = stn(st3l_g, st3l_b);  st3l_f = sat_f(st3l_b);
  st3h_g = max(1, dg * 0.45);  st3h_k = stn(st3h_g, 0.02);  st3h_f = sat_f(0.02);
);

DRV1.drift_init(0.7 + rand(1) * 0.4);  DRV2.drift_init(0.8 + rand(1) * 0.4);  DRV3.drift_init(0.9 + rand(1) * 0.4);
drift_macro(drift);
dr_dv = dr_bv = dr_wv = 0;
in_s = in_t = inc_s = inc_t = 1;  mix_s = mix_t = 1;
memset(DRY, 0, DRYN * 2);  dpos = 0;
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_base + os_lat(os_f);
by_setup(11);
pwr_init();  pwr_hum_db = -83;  pwr_wu_loss = 1.2;  pwr_wu_drv = 2.5;  pwr_wu_lp = 6000;  pwr_bloom = 0.25;  pwr_sag = 0.22;
mn_vu_d = mn_pk_d = 0;  mn_ms = mn_pkm = 0;
rs_f = 1;
PB_N = 12;

function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 4); pv(2, 3); pv(3, 2); pv(4, 1); pv(5, 0); pv(6, 0); pv(7, 0); pv(8, 3); pv(12, 100); pv(13, 0); pv(14, 50);
);
function p_set(d, l, t, x, m, f, o, v) ( pv(1, d); pv(2, l); pv(3, t); pv(4, x); pv(5, m); pv(6, f); pv(7, o); pv(8, v); );
function sl_list() local(i) ( i = 1;  loop(14, i != 11 ? slider_automate(2 ^ (i - 1));  i += 1; ); );
function load_preset(p) (
  p_init();
  p == 2 ? p_set(5, 4, 4, 1, 0, 0, -0.5, 2);
  p == 3 ? p_set(3, 2, 3, 0, 0, 1, 0, 4);
  p == 4 ? p_set(6, 1, 1, 2, 1, 0, 0, 7);
  p == 5 ? p_set(2, 6, 0, 0, 0, 0, 0, 3);
  p == 6 ? p_set(4, 2, 5, 1, 0, 1, 1, 5);
  p == 7 ? p_set(7, 5, 6, 1, 0, 0, -1, 1);
  p == 8 ? p_set(6, 3, 0, 2, 1, 0, 0, 6);
  p == 9 ? p_set(8, 7, 7, 1, 0, 0, -1, 0);
  p == 10 ? p_set(3, 3, 1, 1, 1, 0, -0.5, 3);
  p == 11 ? p_set(5, 1, 8, 0, 0, 1, -0.5, 6);
  p == 12 ? p_set(10, 4, 10, 2, 0, 0, -4.5, 5);
  p == PB_N + 1 ? ( pv(9, 0); pv(10, 1); pv(11, 0); slider_automate(byp); slider_automate(os_sel); slider_automate(tape); );
  sl_list();
  prm_dirty = 1;
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(14, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= PB_N ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;  prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(PB_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0;  prs_dirty = 0;

function clr_all() (
  memset(SL, 0, 200);  memset(DLB, 0, DSZ);  memset(DRB, 0, DSZ);  memset(DRY, 0, DRYN * 2);
  ovuL.os_clr();  ovuR.os_clr();  ovdL.os_clr();  ovdR.os_clr();
  chL.hd.hd_clr();  chR.hd.hd_clr();  fzL.fz_clr();  fzR.fz_clr();
  dcL = dcR = 0;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
drift_macro(drift);
update_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_base + os_lat(os_f);
first_run ? (
  drive_s = drive_t;  lift_s = lift_t;  terr_s = terr_t;  hsc_s = hsc_t;  lsat_s = lsat_t;  wid_s = wid_t;
  w2 = w2t;  w4 = w4t;  w3 = w3t;  diff_w = diff_t;  fog_w = fog_t;  out_s = out_t;  tp_w = tp_t;  in_s = in_t;  inc_s = inc_t;  mix_s = mix_t;
  first_run = 0;  coef_dirty = 1;
);
os_snap(slider(9));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now;  rs_gpp = play_position;  rs_gpd = samplesblock / srate;
prm_dirty ? ( prm_dirty = 0;  update_targets(); );
drift_macro(drift);
pwr_block(byp < 0.5);
fzL.fz_dn();  fzR.fz_dn();
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1)));  mn_ms = 0;  mn_pk_d = max(mn_pk_d, mn_pkm);  mn_pkm = 0;
os_snapb(slider(9));

@serialize
file_var(0, ui_sz);  file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0;  prs_ok = 1;

@sample
by_in();
rs_req ? ( rs_req = 0;  rs_f = 0;  rs_c = 1 / (0.015 * srate);  rs_wait = pdc_delay;  clr_all(); );
w2 += (w2t - w2) * sm;  w4 += (w4t - w4) * sm;  w3 += (w3t - w3) * sm;
diff_w += (diff_t - diff_w) * sm;  fog_w += (fog_t - fog_w) * sm;  out_s += (out_t - out_s) * sm;
in_s += (in_t - in_s) * sm;  inc_s += (inc_t - inc_s) * sm;  mix_s += (mix_t - mix_s) * sm;  fz_o += (fz_t - fz_o) * sm;
tp_w <= 0.0005 && tp_t ? ( chL.hd.hd_clr();  chR.hd.hd_clr(); );
tp_w += (tp_t - tp_w) * sm;  tp_w < 0.0001 && !tp_t ? tp_w = 0;  tp_w > 0.9999 && tp_t ? tp_w = 1;
os_gate();
os_chg ? ( ov_rate();  memset(SL, 0, 200);  memset(DLB, 0, DSZ);  memset(DRB, 0, DSZ);  dw_pos = 0;
           ovuL.os_clr();  ovuR.os_clr();  ovdL.os_clr();  ovdR.os_clr();  fzL.fz_clr();  fzR.fz_clr();  cr_n = 0; );
cr_n <= 0 ? ( cr_n = CR;  ctl(); );
cr_n -= 1;

pwr_in(spl0, spl1);  xl = pwr_l;  xr = pwr_r;
DRY[dpos * 2] = xl;  DRY[dpos * 2 + 1] = xr;
rp = dpos + DRYN - pdc_delay - det_dep / os_f;  ri = floor(rp);  rf = rp - ri;  rp = ri % DRYN;  rn = (ri + 1) % DRYN;
ml = DRY[rp * 2] + (DRY[rn * 2] - DRY[rp * 2]) * rf;  mr = DRY[rp * 2 + 1] + (DRY[rn * 2 + 1] - DRY[rp * 2 + 1]) * rf;
dpos = (dpos + 1) % DRYN;

ovuL.os_up(xl * in_s);  ovuR.os_up(xr * in_s);
fz_on = fz_o > 0.0001;
ok = 0;
loop(os_f,
  aL = chL.ch_tick(ovuL.os_s(ok), SL, hb_s);
  aR = chR.ch_tick(ovuR.os_s(ok), SR, hb_s);
  fz_on ? ( aL += fzL.fz_run(aL);  aR += fzR.fz_run(aR); );
  hf_e = max(abs(chL.hfh), abs(chR.hfh));
  hf_env += (hf_e > hf_env ? hf_a : hf_r) * (hf_e - hf_env);
  hf_o = hf_env * dg * hf_ti;
  hf_g = hf_o > 1 ? 1 / (1 + HF_RT * (hf_o - 1)) : 1;
  diff_w > 0.0005 ? (
    dlL = svc(svc(aL, C_DF, SL + 40), C_DF, SL + 42);
    dlR = svc(svc(aR, C_DF, SR + 40), C_DF, SR + 42);
    dm = (dlL + dlR) * 0.5;
    aL += (dm - dlL) * diff_w;  aR += (dm - dlR) * diff_w;
  );
  mm = (aL + aR) * 0.5;  ss = (aL - aR) * 0.5 * wid_d;  aL = mm + ss;  aR = mm - ss;
  ph1 += 2 * $pi * 0.7 / fsr;  ph1 > 2 * $pi ? ph1 -= 2 * $pi;
  wm = 0.65 * wob_v + 0.35 * sin(ph1);
  DLB[dw_pos] = aL;  DRB[dw_pos] = aR;
  ph2 += 2 * $pi * 0.33 / fsr;  ph2 > 2 * $pi ? ph2 -= 2 * $pi;
  dts = det_dep * sin(ph2);
  rd = DLY * os_f + wob_dep * wm + det_dep + dts;
  rp = dw_pos - rd;  rp < 0 ? rp += DSZ;
  ri = floor(rp);  rf = rp - ri;  rn = ri + 1;  rn >= DSZ ? rn = 0;
  aL = DLB[ri] + (DLB[rn] - DLB[ri]) * rf;
  rd = DLY * os_f + wob_dep * wm + det_dep - dts;
  rp = dw_pos - rd;  rp < 0 ? rp += DSZ;
  ri = floor(rp);  rf = rp - ri;  rn = ri + 1;  rn >= DSZ ? rn = 0;
  aR = DRB[ri] + (DRB[rn] - DRB[ri]) * rf;
  dkL = dkR2 = 0;
  dwR > 0.001 ? ( dkR.dk_run(aL, aR);  dkL += dkR.ol * dwR;  dkR2 += dkR.orr * dwR; );
  dwM > 0.001 ? ( dkM.dk_run(aL, aR);  dkL += dkM.ol * dwM;  dkR2 += dkM.orr * dwM; );
  dwA > 0.001 ? ( dkA.dk_run(aL, aR);  dkL += dkA.ol * dwA;  dkR2 += dkA.orr * dwA; );
  aL = dkL;  aR = dkR2;
  dw_pos += 1;  dw_pos >= DSZ ? dw_pos = 0;
  ok == 0 ? ( q0l = aL;  q0r = aR; ) : ok == 1 ? ( q1l = aL;  q1r = aR; ) : ok == 2 ? ( q2l = aL;  q2r = aR; ) : ( q3l = aL;  q3r = aR; );
  ok += 1;
);
aL = ovdL.os_dn(q0l, q1l, q2l, q3l) * inc_s;  aR = ovdR.os_dn(q0r, q1r, q2r, q3r) * inc_s;
dcL += (aL - dcL) * dc_k;  aL -= dcL;  dcR += (aR - dcR) * dc_k;  aR -= dcR;
lw = db2g(wob_amp * wm * 0.6);
aL = ml + (aL * lw - ml) * mix_s;  aR = mr + (aR * lw - mr) * mix_s;
os_gs = os_g * os_g * (3 - 2 * os_g);
aL *= os_gs;  aR *= os_gs;
pwr_out(aL, aR);  aL = pwr_l;  aR = pwr_r;
aL = ostL.ost_band(aL) * out_s;
aR = ostR.ost_band(aR) * out_s;
ost_out(aL, aR);  aL = ost_l;  aR = ost_r;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : rs_f = min(rs_f + rs_c, 1);
  rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  aL = by_il + (aL - by_il) * rs_s;  aR = by_ir + (aR - by_ir) * rs_s;
);
spl0 = abs(aL) < 0.00000000000000000001 ? 0 : aL;
spl1 = abs(aR) < 0.00000000000000000001 ? 0 : aR;
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);  mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x3D4842; mk_band = 0x0E0F10; mk_ink = 0xF0F0EC; mk_tab = 0xE89A30; mk_acc = 0xF0A040;
mk_sub = 0x222B26; mk_ink2 = 0xCDD0C4;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
