desc:Space Mini [algorithmic reverb] (GFX Lab)
//tags: reverb room chamber hall plate spring algorithmic
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-input, gfx-lab-output, gfx-lab-os, gfx-lab-bypass, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn (.jsfx-inc) in the same folder.

slider1:2<0,5,1{Room,Chamber,Hall,Plate,Spring,Room Sim}>-Type
slider2:20<0,250,1>-Pre-delay (ms)
slider3:2.4<0.2,20,0.01>-Decay (s)
slider4:100<50,150,1>-Size (%)
slider5:50<0,100,1>-Damping (%)
slider6:30<0,100,1>-Modulation (%)
slider7:50<0,100,1>-Early reflections (%)
slider8:75<0,100,1>-Diffusion (%)
slider9:120<20,1000,1>-Lo cut (Hz)
slider10:9000<1000,20000,10>-Hi cut (Hz)
slider11:0<0,100,1>-Duck (%)
slider12:100<0,100,1>-Width (%)
slider13:0<0,1,1{Off,On}>-Freeze
slider14:20<0,100,1>-Wander (%)
slider15:0.2<0.01,2,0.01:log>-Drift speed (Hz)
slider16:30<0,100,1>-Mix (%)
slider17:0<-24,12,0.1>-Output (dB)
slider18:0<0,100,1>-Band sat (%)
slider19:30<0,100,1>-Bias (%)
slider20:120<40,400,1>-Sat low band (Hz)
slider21:6000<2000,16000,10>-Sat high band (Hz)
slider22:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider23:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider24:0<-24,12,0.1>-Input trim (dB)
slider25:0<0,1,1{Off,On}>-Input guard
slider26:0<0,3,1{Off,-3 dB,-6 dB,-9 dB}>-Vintage EQ (500 Hz cut)
slider27:50<0,100,1>-Drift (%)
slider28:0.31<0.01,3,0.01:log>-Modulation rate (Hz)
slider29:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider30:byp=0<0,1,1{Off,On}>-Bypass
slider31:prs_sel=0<0,13,1{No preset,Small Room,Live Room,Vocal Chamber,Concert Hall,Cathedral (ducked),Bright Plate,Snare Plate,Surf Spring,Dub Spring,Ambient Wash,Studio Room (sim),Drum Room (sim),Big Room (sim)}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc

@init
#ui_man = "gfx-lab-space-mini";
#sp_pm = "Small Room|Live Room|Vocal Chamber|Concert Hall|Cathedral (ducked)|Bright Plate|Snare Plate|Surf Spring|Dub Spring|Ambient Wash|Studio Room (sim)|Drum Room (sim)|Big Room (sim)";
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 4; );
ui_dflt = 1;
rs_f = 1;
ext_noinit = 1;
pwr_init();
pwr_wu_loss = 0.6; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_wu_wob = 0.2; pwr_bloom = 0;

SR48 = srate / 48000;
BLK = ceil(0.25 * srate) + 16;
pre_b = 100000; pre_len = 2 * ceil(0.26 * srate) + 16;
er_b = pre_b + pre_len; er_len = 2 * ceil(0.3 * srate) + 16;
ap_b = er_b + er_len;
ln_b = ap_b + 4 * 8192;
sp_b = ln_b + 8 * BLK;
rs_b = sp_b + 2 * BLK;
memset(pre_b, 0, sp_b + 2 * BLK - pre_b);
memset(rs_b, 0, 384);
DLB = 60000;
DLM = 60200;
COEF = 50000;
memset(DLB, 0, 128); memset(DLM, 0, 128);
pre_w = 0; er_w = 0;
lw = 400; lz = 420; lph = 440; lrt = 460; llen = 480; lg_a = 500; lg_b = 520; apw = 540; apz = 560;
lls = 740; apg = 760; lls1 = 780; apg1 = 790;
lga_s = 800; lgb_s = 810;
memset(400, 0, 200); memset(740, 0, 80);
bl = 600; bl[0] = 31.7; bl[1] = 37.1; bl[2] = 41.3; bl[3] = 47.9; bl[4] = 53.3; bl[5] = 61.1; bl[6] = 70.7; bl[7] = 79.3;
i = 0; loop(8, lph[i] = rand(1); i += 1; );
apl = 620; apl[0] = 142; apl[1] = 107; apl[2] = 379; apl[3] = 277;
ert = 640; erg = 660;
ert[0] = 4.3; ert[1] = 7.9; ert[2] = 11.2; ert[3] = 15.8; ert[4] = 21.4; ert[5] = 27.9; ert[6] = 34.6; ert[7] = 43.1;
erg[0] = 0.85; erg[1] = -0.7; erg[2] = 0.62; erg[3] = 0.5; erg[4] = -0.42; erg[5] = 0.34; erg[6] = -0.27; erg[7] = 0.2;

function rs_room(es, dn, TL) local(TR, GL, GR, Lx, Ly, Lz, sx, sy, sz_, hx, hy, hz, i, j, k, n, a, dx, dy, dz, d, d0, t, g, az, sw, tt, el, er, cnt, mx) (
  TR = TL + 48; GL = TL + 96; GR = TL + 144;
  Lx = 16 * es; Ly = 11 * es; Lz = 6 * es;
  sx = 0.35 * Lx; sy = 0.62 * Ly; sz_ = 0.3 * Lz; hx = 0.7 * Lx; hy = 0.45 * Ly; hz = 0.32 * Lz;
  d0 = sqrt(sqr(sx - hx) + sqr(sy - hy) + sqr(sz_ - hz));
  n = 0;
  i = -2; loop(5, j = -2; loop(5, k = -1; loop(3,
    a = abs(i) + abs(j) + abs(k);
    a > 0 && a <= 2 && n < 48 ? (
      dx = (i & 1 ? (i + 1) * Lx - sx : i * Lx + sx) - hx;
      dy = (j & 1 ? (j + 1) * Ly - sy : j * Ly + sy) - hy;
      dz = (k & 1 ? (k + 1) * Lz - sz_ : k * Lz + sz_) - hz;
      d = sqrt(dx * dx + dy * dy + dz * dz);
      t = (d - d0) / 343;
      g = d0 / d * (a == 1 ? 0.8 : 0.55);
      az = atan2(dy, dx);
      TL[n] = t; TR[n] = t + 0.00025 * sin(az);
      GL[n] = g * (0.55 + 0.45 * cos(az - 0.9)); GR[n] = g * (0.55 + 0.45 * cos(az + 0.9));
      n += 1;
    );
    k += 1; ); j += 1; ); i += 1; );
  sw = 1; while (sw) ( sw = 0; i = 0; loop(n - 1,
    TL[i] > TL[i + 1] ? ( tt = TL[i]; TL[i] = TL[i + 1]; TL[i + 1] = tt; tt = TR[i]; TR[i] = TR[i + 1]; TR[i + 1] = tt;
      tt = GL[i]; GL[i] = GL[i + 1]; GL[i + 1] = tt; tt = GR[i]; GR[i] = GR[i + 1]; GR[i + 1] = tt; sw = 1; );
    i += 1; ); );
  cnt = floor(8 + dn * (n - 8));
  el = er = 0; i = 0; loop(cnt, GL[i] = sign(GL[i]) * min(abs(GL[i]), 0.45); GR[i] = sign(GR[i]) * min(abs(GR[i]), 0.45);
    el += sqr(GL[i]); er += sqr(GR[i]); i += 1; );
  mx = floor(er_len / 2) - 4;
  i = 0; loop(cnt, GL[i] *= sqrt(0.35 / max(el, 0.0001)); GR[i] *= sqrt(0.35 / max(er, 0.0001));
    GL[i] *= i & 1 ? -1 : 1; GR[i] *= i & 2 ? -1 : 1;
    TL[i] = min(max(1, floor(TL[i] * srate)), mx); TR[i] = min(max(1, floor(TR[i] * srate)), mx); i += 1; );
  cnt;
);
function rs_read(TL, n) local(ak, r_) (
  rs_el = rs_er = 0; ak = 0;
  loop(n,
    r_ = er_w - TL[ak]; r_ < 0 ? r_ += floor(er_len / 2);
    rs_el += TL[96 + ak] * (er_b[r_ * 2] + er_b[r_ * 2 + 1]) * 0.5;
    r_ = er_w - TL[48 + ak]; r_ < 0 ? r_ += floor(er_len / 2);
    rs_er += TL[144 + ak] * (er_b[r_ * 2] + er_b[r_ * 2 + 1]) * 0.5;
    ak += 1;
  );
);

function sp_chain(x) instance(z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10, z11) local(y) (
  y = -0.62 * x + z0;  z0 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z1;  z1 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z2;  z2 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z3;  z3 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z4;  z4 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z5;  z5 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z6;  z6 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z7;  z7 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z8;  z8 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z9;  z9 = x + 0.62 * y;  x = y;
  y = -0.62 * x + z10; z10 = x + 0.62 * y; x = y;
  y = -0.62 * x + z11; z11 = x + 0.62 * y;
  y;
);
function sp_clr() instance(z0, z1, z2, z3, z4, z5, z6, z7, z8, z9, z10, z11) (
  z0 = z1 = z2 = z3 = z4 = z5 = z6 = z7 = z8 = z9 = z10 = z11 = 0;
);
function sp_rd(o, w, d) local(p, i, f) (
  p = w - d; p < 0 ? p += BLK; i = floor(p); f = p - i;
  f > 0 ? o[i] * (1 - f) + o[(i + 1) % BLK] * f : o[i];
);

function vt_bq(t, f, q, gdb) local(w, cw, al, A, a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); al = sin(w) / (2 * q);
  t == 0 ? (
    a0 = 1 + al; vtp[0] = (1 + cw) * 0.5 / a0; vtp[1] = -(1 + cw) / a0; vtp[2] = vtp[0];
  ) : t == 1 ? (
    a0 = 1 + al; vtp[0] = (1 - cw) * 0.5 / a0; vtp[1] = (1 - cw) / a0; vtp[2] = vtp[0];
  ) : (
    A = 10 ^ (gdb / 40); a0 = 1 + al / A;
    vtp[0] = (1 + al * A) / a0; vtp[1] = -2 * cw / a0; vtp[2] = (1 - al * A) / a0;
  );
  vtp[3] = -2 * cw / a0; vtp[4] = (1 - (t == 2 ? al / A : al)) / a0;
);
VTC = 700;
function vt_set(m) (
  vtp = VTC;      vt_bq(0, 140, 0.7071, 0);
  vtp = VTC + 5;  vt_bq(2, 500, 0.9, -3 * m);
  vtp = VTC + 10; vt_bq(1, 5000, 0.7071, 0);
);
function vt_proc(x) instance(a1, a2, b1, b2, c1, c2) local(y) (
  y = VTC[0] * x + a1; a1 = VTC[1] * x - VTC[3] * y + a2; a2 = VTC[2] * x - VTC[4] * y; x = y;
  y = VTC[5] * x + b1; b1 = VTC[6] * x - VTC[8] * y + b2; b2 = VTC[7] * x - VTC[9] * y; x = y;
  y = VTC[10] * x + c1; c1 = VTC[11] * x - VTC[13] * y + c2; c2 = VTC[12] * x - VTC[14] * y;
  y;
);
function vt_clr() instance(a1, a2, b1, b2, c1, c2) ( a1 = a2 = b1 = b2 = c1 = c2 = 0; );

function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
C_F1 = COEF; C_F2 = COEF + 5; C_F3 = COEF + 10; C_F4 = COEF + 15;
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_run(x) instance(zA, zB, zC, zD, fh, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = zA.fz_bm(x, C_F1);
  ha = abs(h); fh += (ha - fh) * (ha > fh ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fh, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (fz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fh;
  e = zD.fz_bm(zC.fz_bm(zB.fz_bm(e, C_F2), C_F3), C_F4);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_clr() instance(zA, zB, zC, zD, fh, fp, fe) ( zA.fz_bmz(); zB.fz_bmz(); zC.fz_bmz(); zD.fz_bmz(); fh = fp = fe = 0; );
function fz_coef() local(fs) (
  fs = srate * os_f;
  fz_bqc(C_F1, 4, 3500, 0, 0.7071, fs); fz_bqc(C_F2, 4, 5500, 0, 0.7071, fs);
  fz_bqc(C_F3, 0, 8000, 4, 0.7, fs); fz_bqc(C_F4, 2, 12000, -6, 0.7, fs);
  fz_a = 1 - exp(-1 / (0.003 * fs)); fz_r = 1 - exp(-1 / (0.12 * fs)); fz_w = 1 - exp(-1 / (0.06 * fs));
);
function fz_os(l, r) (
  os_f == 1 ? (
    fz_o > 0.0001 ? ( l += fzL.fz_run(l); r += fzR.fz_run(r); );
    fo_l = l; fo_r = r;
  ) : (
    osuL.os_up(l); osuR.os_up(r);
    oa0 = osuL.s0; ob0 = osuR.s0; oa1 = osuL.s1; ob1 = osuR.s1;
    fz_o > 0.0001 ? ( oa0 += fzL.fz_run(oa0); ob0 += fzR.fz_run(ob0); oa1 += fzL.fz_run(oa1); ob1 += fzR.fz_run(ob1); );
    os_f > 2 ? (
      oa2 = osuL.s2; ob2 = osuR.s2; oa3 = osuL.s3; ob3 = osuR.s3;
      fz_o > 0.0001 ? ( oa2 += fzL.fz_run(oa2); ob2 += fzR.fz_run(ob2); oa3 += fzL.fz_run(oa3); ob3 += fzR.fz_run(ob3); );
    );
    fo_l = osdL.os_dn(oa0, oa1, oa2, oa3); fo_r = osdR.os_dn(ob0, ob1, ob2, ob3);
  );
);

function rs_es(s) ( 0.8434 * s / 100; );
RS_EG = 1.08;
RS_TG = 1.5;
function update() local(i, sz, L, gl, gh, a, mr) (
  pre_t = floor(slider2 * 0.001 * srate);
  t60 = slider3 * 1.11;
  sz = rtype == 5 ? 0.25 + 0.75 * rs_es(slider4) :
       slider4 / 100 * (rtype == 0 ? 0.36 : rtype == 1 ? 0.6 : rtype == 2 ? 1 : rtype == 3 ? 0.55 : 1);
  damp = slider5 / 100;
  modd = rtype == 5 ? 0 : slider6 / 100 * (rtype == 3 ? 0.5 : 1);
  erl = rtype == 5 ? slider7 / 100 * RS_EG : rtype >= 3 ? 0 : slider7 / 100 * (rtype == 0 ? 1 : rtype == 1 ? 0.8 : 0.6);
  rtype == 5 && (rs_k1 != slider4 || rs_k2 != slider8) ? (
    rs_now ? ( rs_n = rs_room(rs_es(slider4), slider8 / 100, rs_b + rs_bk * 192); rs_k1 = slider4; rs_k2 = slider8; ) :
    rs_xs == 0 ? (
      rs_nn = rs_room(rs_es(slider4), slider8 / 100, rs_b + (1 - rs_bk) * 192); rs_k1 = slider4; rs_k2 = slider8;
      rs_xg = 0; rs_xs = 1;
    );
  );
  er_sc = rtype == 0 ? 0.55 : rtype == 1 ? 0.9 : 1.5;
  diff = slider8 / 100 * (rtype == 3 ? 1 : 0.85);
  frz = slider13;
  i = 0;
  loop(8,
    L = min(bl[i] * sz * 0.001 * srate, BLK - 64);
    llen[i] = L;
    gl = frz ? 1 : 10 ^ (-3 * L / (t60 * srate));
    gh = frz ? 1 : 10 ^ (-3 * L / (t60 * (1 - 0.9 * damp) * srate * (rtype == 3 ? 1.4 : 1)));
    a = (gl - gh) / (gl + gh);
    lg_a[i] = a; lg_b[i] = gl * (1 - a);
    i += 1;
  );
  i = 0; loop(4, apz[i] = floor(apl[i] * SR48 * (0.6 + 0.4 * diff)); i += 1; );
  sp_dL = ceil(min(0.034 * slider4 / 100 * srate, BLK - 64)); sp_dR = ceil(min(0.041 * slider4 / 100 * srate, BLK - 64));
  sp_g = frz ? 0.999 : 10 ^ (-3 * 0.037 / max(t60, 0.2));
  sp_lp = 1 - exp(-2 * $pi * (5200 - 2600 * damp) / srate);
  lo_c = 1 - exp(-2 * $pi * slider9 / srate);
  hi_c = 1 - exp(-2 * $pi * min(slider10, srate * 0.45) / srate);
  duck = slider11 / 100; wid = slider12 / 100;
  drift_macro(slider27);
  wan = rtype == 5 ? 0 : slider14 / 100 * dm_a; dspd = slider15 * dm_s;
  mr = slider28 / 0.31; i = 0; loop(8, lrt[i] = (0.31 + 0.11 * i) * mr; i += 1; );
  mix_t = slider16 / 100;
  out_t = 10 ^ (slider17 / 20);
  in_setup(slider24, slider25);
  vt_t = slider26 > 0;
  slider26 > 0 && slider26 != vt_m ? ( vt_m = slider26; vt_set(vt_m); );
  fz_t = 0.33 * min(max((slider10 - 12000) / 8000, 0), 1);
);
function snap() local(i) (
  pre_g = pre_g1 = pre_t; i = 0; loop(8, lls[i] = lls1[i] = llen[i]; lga_s[i] = lg_a[i]; lgb_s[i] = lg_b[i]; i += 1; );
  i = 0; loop(4, apg[i] = apg1[i] = apz[i]; i += 1; );
  sp_gL = sp_g1L = sp_dL; sp_gR = sp_g1R = sp_dR; diff_s = diff; modd_s = modd; wan_s = wan; duck_s = duck; wid_s = wid;
);
function gl2(t, a, b, k) ( b = (b + (t - b) * k); a = (a + (b - a) * k); abs(a - t) < 0.005 && abs(b - t) < 0.005 ? a = b = t; gl2_b = b; a; );
function ty_chk() ( slider1 != rtype && sx_dst != 1 ? sx_dst = 1; );

function setp(t, pd, dc, sz, dm, md, erp, df, lc, hc, dk, mx) (
  slider1 = t; slider2 = pd; slider3 = dc; slider4 = sz; slider5 = dm; slider6 = md; slider7 = erp; slider8 = df;
  slider9 = lc; slider10 = hc; slider11 = dk; slider16 = mx; slider13 = 0; slider28 = 0.31;
);
function load_preset(p) (
  sx_dst = 1;
  p == 1 ? setp(0, 5,  0.6, 90,  45, 15, 70, 70, 150, 9000, 0,  25) :
  p == 2 ? setp(0, 10, 1.1, 120, 55, 20, 60, 75, 120, 7000, 0,  25) :
  p == 3 ? setp(1, 15, 1.6, 100, 50, 25, 55, 80, 120, 8000, 0,  25) :
  p == 4 ? setp(2, 25, 2.4, 100, 50, 30, 45, 75, 120, 9000, 0,  30) :
  p == 5 ? setp(2, 40, 5.5, 140, 60, 45, 35, 85, 200, 7000, 30, 35) :
  p == 6 ? setp(3, 10, 2.0, 100, 30, 25, 0,  95, 150, 12000, 0, 25) :
  p == 7 ? setp(3, 0,  1.2, 80,  45, 20, 0,  90, 200, 10000, 0, 20) :
  p == 8 ? setp(4, 0,  2.0, 100, 50, 10, 0,  50, 300, 6000, 0,  30) :
  p == 9 ? setp(4, 10, 3.0, 120, 40, 15, 0,  50, 200, 5000, 0,  25) :
  p == 10 ? ( setp(2, 60, 14,  150, 40, 60, 20, 90, 250, 8000, 0, 40); slider28 = 0.08; ) :
  p == 11 ? setp(5, 8,  0.9, 100, 50, 0,  70, 70, 120, 10000, 0, 25) :
  p == 12 ? setp(5, 2,  0.7, 70,  45, 0,  85, 90, 100, 12000, 0, 25) :
  p == 13 ? setp(5, 12, 1.8, 150, 55, 0,  60, 80, 80,  9000,  0, 30);
  p == 14 ? (
    setp(2, 20, 2.4, 100, 50, 30, 50, 75, 120, 9000, 0, 30);
    slider12 = 100; slider14 = 20; slider15 = 0.2; slider17 = 0;
    slider18 = 0; slider19 = 30; slider20 = 120; slider21 = 6000; slider22 = -0.3; slider23 = 1;
    slider24 = 0; slider25 = 0; slider26 = 0;
    slider27 = 50;
  );
  slider_automate(268435455);
);

drW.drift_init(0.8 + rand(1) * 0.5);
in_init();
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
sm  = 1 - exp(-1 / (0.03 * srate));
sm5 = 1 - exp(-1 / (0.05 * srate));
fzg_k = 1 / (0.01 * srate);
dk_a = 1 - exp(-1 / (0.01 * srate)); dk_r = 1 - exp(-1 / (0.4 * srate));
pkL = 0; pkR = 0; denv = 0; spwL = 0; spwR = 0; spyL = 0; spyR = 0;
vt_m = 1; vt_set(1); vt_g = 0;
rtype = slider1; rs_bk = 0; rs_xs = 0; rs_now = 1; rs_k1 = -1;
os_design(); os_base = 0;
os_f = os_tf = os_f2n(os_sel); os_gsetup();
fz_coef();
update(); rs_now = 0; snap();
mix_s = mix_t; out_s = out_t; fz_o = fz_t; vt_g = vt_t; fz_gi = frz ? 0 : 1;
sx_dkr = 1 / (0.012 * srate); sx_dk = 1; sx_dst = 0;
rs_xk = 1 / (0.02 * srate);
c_sw = 1 - exp(-1 / (0.005 * srate));
by_s = byp;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(30, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
!sp_in ? ( rtype = slider1; rs_now = 1; update(); rs_now = 0; snap(); vt_g = vt_t; fz_gi = frz ? 0 : 1; sp_in = 1; ) : (
  ty_chk();
  sx_dst != 1 ? update();
);
ost_setup(slider18 / 100, slider19 / 100, slider20, slider21, slider22, 0);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
os_snap(slider(29));

@block
prs_chk();
rs_tn = time_precise();
rs_tl > 0 && rs_tn - rs_tl > max(0.15, 4 * samplesblock / srate) ? (
  rs_f = 0; rs_c = 1 / (0.015 * srate);
  memset(pre_b, 0, sp_b + 2 * BLK - pre_b); memset(lz, 0, 8); memset(DLB, 0, 128); memset(DLM, 0, 128);
  spyL = spyR = 0; spcL.sp_clr(); spcR.sp_clr(); vtL.vt_clr(); vtR.vt_clr(); fzL.fz_clr(); fzR.fz_clr();
  hzL = hzR = lzL = lzR = 0;
);
rs_tl = rs_tn;
pwr_block(!byp);
ty_chk();
sx_dst != 1 ? update();
ost_setup(slider18 / 100, slider19 / 100, slider20, slider21, slider22, 0);
os_tf = os_f2n(os_sel);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
vW = drW.drift_tick(dspd * samplesblock / srate);
sp_vu_d = max(sp_vu_d, sqrt(sp_ms / max(samplesblock, 1))); sp_ms = 0; sp_pk_d = max(sp_pk_d, sp_pkm); sp_pkm = 0;
os_snapb(slider(29));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
rw_l = spl0; rw_r = spl1;
DLB[dw] = spl0; DLB[64 + dw] = spl1;
dry_l = DLB[(dw - pdc_delay) & 63]; dry_r = DLB[64 + ((dw - pdc_delay) & 63)];
os_gate();
os_chg ? (
  osuL.os_clr(); osuR.os_clr(); osdL.os_clr(); osdR.os_clr(); fzL.fz_clr(); fzR.fz_clr(); fz_coef();
  dry_l = DLB[(dw - pdc_delay) & 63]; dry_r = DLB[64 + ((dw - pdc_delay) & 63)];
);
sx_dst == 1 ? ( sx_dk -= sx_dkr; sx_dk <= 0 ? (
  sx_dk = 0; rtype = slider1; rs_now = 1; rs_xs = 0; update(); rs_now = 0; snap(); sx_dst = 2;
  memset(pre_b, 0, sp_b + 2 * BLK - pre_b); memset(lz, 0, 8); spyL = spyR = 0; spcL.sp_clr(); spcR.sp_clr();
); ) :
sx_dst == 2 ? ( sx_dk += sx_dkr; sx_dk >= 1 ? ( sx_dk = 1; sx_dst = 0; ); );
in_process(spl0, spl1);
pwr_in(in_l, in_r);
inL = pwr_l; inR = pwr_r;
mix_s += (mix_t - mix_s) * sm;
out_s += (out_t - out_s) * sm;
pre_g = gl2(pre_t, pre_g, pre_g1, sm5); pre_g1 = gl2_b;
diff_s += (diff - diff_s) * sm; abs(diff_s - diff) < 0.00001 ? diff_s = diff;
modd_s += (modd - modd_s) * sm; abs(modd_s - modd) < 0.00001 ? modd_s = modd;
wan_s += (wan - wan_s) * sm; abs(wan_s - wan) < 0.00001 ? wan_s = wan;
duck_s += (duck - duck_s) * sm; abs(duck_s - duck) < 0.00001 ? duck_s = duck;
wid_s += (wid - wid_s) * sm; abs(wid_s - wid) < 0.00001 ? wid_s = wid;
vt_g += ((vt_t ? 1 : 0) - vt_g) * sm; abs(vt_g - vt_t) < 0.0001 ? vt_g = vt_t;
fz_o += (fz_t - fz_o) * sm;
fz_gi = frz ? max(fz_gi - fzg_k, 0) : min(fz_gi + fzg_k, 1);

xL = inL * fz_gi; xR = inR * fz_gi;
sx_dst ? ( sx_dkg = sx_dk * sx_dk * (3 - 2 * sx_dk); xL *= sx_dkg; xR *= sx_dkg; );

pre_b[pre_w * 2] = xL; pre_b[pre_w * 2 + 1] = xR;
prd = pre_w - pre_g; prd < 0 ? prd += floor(pre_len / 2);
pri = floor(prd); prf = prd - pri;
prf > 0 ? (
  prn = pri + 1; prn >= floor(pre_len / 2) ? prn = 0;
  pL = pre_b[pri * 2] * (1 - prf) + pre_b[prn * 2] * prf; pR = pre_b[pri * 2 + 1] * (1 - prf) + pre_b[prn * 2 + 1] * prf;
) : ( pL = pre_b[pri * 2]; pR = pre_b[pri * 2 + 1]; );
pre_w += 1; pre_w >= floor(pre_len / 2) ? pre_w = 0;

rtype == 4 ? (
  sp_gL = gl2(sp_dL, sp_gL, sp_g1L, sm5); sp_g1L = gl2_b;
  sp_gR = gl2(sp_dR, sp_gR, sp_g1R, sm5); sp_g1R = gl2_b;
  sL = sp_rd(sp_b, spwL, sp_gL); sR = sp_rd(sp_b + BLK, spwR, sp_gR);
  spyL += (sL - spyL) * sp_lp; spyR += (sR - spyR) * sp_lp;
  sp_b[spwL] = 0.6 * pL + sp_g * spcL.sp_chain(spyL);
  sp_b[BLK + spwR] = 0.6 * pR + sp_g * spcR.sp_chain(spyR);
  spwL += 1; spwL >= BLK ? spwL = 0;
  spwR += 1; spwR >= BLK ? spwR = 0;
  rL = sL * 1.4; rR = sR * 1.4;
) : (
  er_b[er_w * 2] = pL; er_b[er_w * 2 + 1] = pR;
  eL = 0; eR = 0;
  erl > 0 && rtype == 5 ? (
    rs_read(rs_b + rs_bk * 192, rs_n); eL = rs_el; eR = rs_er;
    rs_xs ? (
      rs_xg = min(rs_xg + rs_xk, 1);
      rs_read(rs_b + (1 - rs_bk) * 192, rs_nn);
      eL += (rs_el - eL) * rs_xg; eR += (rs_er - eR) * rs_xg;
      rs_xg >= 1 ? ( rs_bk = 1 - rs_bk; rs_n = rs_nn; rs_xs = 0; );
    );
  ) : erl > 0 ? (
    ak = 0;
    loop(8,
      t_ = floor(ert[ak] * er_sc * 0.001 * srate);
      r_ = er_w - t_; r_ < 0 ? r_ += floor(er_len / 2);
      eL += erg[ak] * er_b[r_ * 2 + (ak & 1)];
      t_ = floor(ert[ak] * er_sc * 1.13 * 0.001 * srate);
      r_ = er_w - t_; r_ < 0 ? r_ += floor(er_len / 2);
      eR += erg[ak] * er_b[r_ * 2 + 1 - (ak & 1)];
      ak += 1;
    );
  );
  rtype == 5 && rs_xs && erl <= 0 ? ( rs_bk = 1 - rs_bk; rs_n = rs_nn; rs_xs = 0; );
  er_w += 1; er_w >= floor(er_len / 2) ? er_w = 0;

  dL = pL + 0.3 * eL; dR = pR + 0.3 * eR;
  dfc = diff_s * 0.75;
  ak = 0;
  loop(4,
    apg[ak] = gl2(apz[ak], apg[ak], apg1[ak], sm); apg1[ak] = gl2_b;
    o_ = ap_b + ak * 8192; wq = apw[ak];
    rq = wq - apg[ak]; rq < 0 ? rq += 4096;
    rqi = floor(rq); rqf = rq - rqi;
    rqf > 0 ? (
      rqn = (rqi + 1) % 4096;
      bv = o_[rqi * 2] * (1 - rqf) + o_[rqn * 2] * rqf; yv = -dfc * dL + bv; o_[wq * 2] = dL + dfc * yv; dL = yv;
      bv = o_[rqi * 2 + 1] * (1 - rqf) + o_[rqn * 2 + 1] * rqf; yv = -dfc * dR + bv; o_[wq * 2 + 1] = dR + dfc * yv; dR = yv;
    ) : (
      bv = o_[rqi * 2]; yv = -dfc * dL + bv; o_[wq * 2] = dL + dfc * yv; dL = yv;
      bv = o_[rqi * 2 + 1]; yv = -dfc * dR + bv; o_[wq * 2 + 1] = dR + dfc * yv; dR = yv;
    );
    apw[ak] = (wq + 1) % 4096;
    ak += 1;
  );

  ak = 0;
  loop(8,
    lls[ak] = gl2(llen[ak], lls[ak], lls1[ak], sm5); lls1[ak] = gl2_b;
    lga_s[ak] += (lg_a[ak] - lga_s[ak]) * sm; abs(lga_s[ak] - lg_a[ak]) < 0.0000001 ? lga_s[ak] = lg_a[ak];
    lgb_s[ak] += (lg_b[ak] - lgb_s[ak]) * sm; abs(lgb_s[ak] - lg_b[ak]) < 0.0000001 ? lgb_s[ak] = lg_b[ak];
    lph[ak] += lrt[ak] * (1 + 0.5 * wan_s * vW) / srate; lph[ak] >= 1 ? lph[ak] -= 1;
    md_ = (modd_s * 0.0009 + wan_s * 0.0004 * vW) * srate * sin(2 * $pi * lph[ak]);
    rp = lw[ak] - lls[ak] - md_; rp < 0 ? rp += BLK;
    ri = floor(rp); rf = rp - ri; o_ = ln_b + ak * BLK;
    v_ = o_[ri % BLK] * (1 - rf) + o_[(ri + 1) % BLK] * rf;
    lz[ak] = lgb_s[ak] * v_ + lga_s[ak] * lz[ak];
    1000[ak] = lz[ak];
    ak += 1;
  );
  a0 = 1000[0]; a1 = 1000[1]; a2 = 1000[2]; a3 = 1000[3]; a4 = 1000[4]; a5 = 1000[5]; a6 = 1000[6]; a7 = 1000[7];
  b0 = a0 + a1; b1 = a0 - a1; b2 = a2 + a3; b3 = a2 - a3; b4 = a4 + a5; b5 = a4 - a5; b6 = a6 + a7; b7 = a6 - a7;
  c0 = b0 + b2; c1 = b1 + b3; c2 = b0 - b2; c3 = b1 - b3; c4 = b4 + b6; c5 = b5 + b7; c6 = b4 - b6; c7 = b5 - b7;
  hs = 0.35355339;
  1010[0] = (c0 + c4) * hs; 1010[1] = (c1 + c5) * hs; 1010[2] = (c2 + c6) * hs; 1010[3] = (c3 + c7) * hs;
  1010[4] = (c0 - c4) * hs; 1010[5] = (c1 - c5) * hs; 1010[6] = (c2 - c6) * hs; 1010[7] = (c3 - c7) * hs;
  ak = 0;
  loop(8,
    o_ = ln_b + ak * BLK;
    o_[lw[ak]] = 1010[ak] + (ak < 4 ? dL : dR) * (ak & 1 ? -0.5 : 0.5);
    lw[ak] += 1; lw[ak] >= BLK ? lw[ak] = 0;
    ak += 1;
  );
  rL = 1000[0] - 1000[2] + 1000[4] - 1000[6] + 0.5 * (1000[1] + 1000[5]);
  rR = 1000[1] - 1000[3] + 1000[5] - 1000[7] + 0.5 * (1000[2] - 1000[6]);
  rtype == 5 ? ( rL *= RS_TG; rR *= RS_TG; );
  rL = rL * 0.5 + erl * eL * 0.6; rR = rR * 0.5 + erl * eR * 0.6;
);

hzL += (rL - hzL) * lo_c; rL -= hzL; hzR += (rR - hzR) * lo_c; rR -= hzR;
lzL += (rL - lzL) * hi_c; rL = lzL; lzR += (rR - lzR) * hi_c; rR = lzR;
vt_g > 0 ? (
  vt_g >= 1 ? ( rL = vtL.vt_proc(rL); rR = vtR.vt_proc(rR); ) :
  ( rL += (vtL.vt_proc(rL) - rL) * vt_g; rR += (vtR.vt_proc(rR) - rR) * vt_g; );
) : ( vtL.vt_clr(); vtR.vt_clr(); );
sx_dst ? ( rL *= sx_dkg; rR *= sx_dkg; );
fz_os(rL, rR); rL = fo_l; rR = fo_r;
DLM[dw] = inL; DLM[64 + dw] = inR;
mdL = DLM[(dw - pdc_delay) & 63]; mdR = DLM[64 + ((dw - pdc_delay) & 63)];
dw = (dw + 1) & 63;

lvl = max(abs(inL), abs(inR));
denv += (lvl - denv) * (lvl > denv ? dk_a : dk_r);
dg = 1 - duck_s * min(denv * 4, 1);

em = 0.5 * (rL + rR); es = 0.5 * (rL - rR) * wid_s;
wL = (em + es) * dg; wR = (em - es) * dg;
dry_g = min(2 * (1 - mix_s), 1); wet_g = min(2 * mix_s, 1);
oL = mdL * dry_g + wL * wet_g;
oR = mdR * dry_g + wR * wet_g;

pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
oL = ostL.ost_band(oL * os_g) * out_s;
oR = ostR.ost_band(oR * os_g) * out_s;
ost_out(oL, oR); oL = ost_l; oR = ost_r;
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( oL += (dry_l - oL) * by_s; oR += (dry_r - oR) * by_s; );
sp_ms += 0.5 * (oL * oL + oR * oR); sp_pkm = max(sp_pkm, max(abs(oL), abs(oR)));
spl0 = oL; spl1 = oR;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  spl0 = rw_l + (spl0 - rw_l) * rs_s; spl1 = rw_r + (spl1 - rw_r) * rs_s;
);

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x4A7A62; mk_band = 0x10221A; mk_ink = 0xEEF5F0; mk_acc = 0xBBEBD4; mk_tab = 0x8EE0B8;
mk_sub = 0x1E3328; mk_ink2 = 0xB4CDBF;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0xF4F6F8); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0x1A1A1C); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(0x1A1A1C); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
