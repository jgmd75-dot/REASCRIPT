desc:Buss Boss Mini [buss colour] (GFX Lab)
//tags: processing saturation transformer valve tape compressor clipper multiband mid-side buss
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-bands, gfx-lab-clip, gfx-lab-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-24,12,0.1>-Trim (dB)
slider3:1<0,1,1{Off,On}>-Guard
slider4:220<110,1100,1>-Low split (Hz)
slider5:2200<1100,11000,1>-High split (Hz)
slider6:0<0,1,1{Off,On}>-High split x10
slider7:22000<3300,22000,1>-High LPF (Hz)
slider8:1<0,1,1{Off,On}>-High iron pre
slider9:0<0,1,1{Off,On}>-High iron post
slider10:0<-12,12,0.1>-High gain (dB)
slider11:0<-12,12,0.1>-Air (dB)
slider12:1<0,1,1{Off,On}>-Mid iron pre
slider13:0<0,1,1{Off,On}>-Mid iron post
slider14:0<-12,12,0.1>-Mid gain (dB)
slider15:0<-100,100,1>-Tilt (%)
slider16:22<11,330,1>-Low HPF (Hz)
slider17:1<0,1,1{Off,On}>-Low iron pre
slider18:0<0,1,1{Off,On}>-Low iron post
slider19:0<-12,12,0.1>-Low gain (dB)
slider20:0<-12,12,0.1>-Bass (dB)
slider21:1<0,2,1{Off,Mid,Side}>-Valve
slider22:2<0,2,1{Off,Mid,Side}>-Tape
slider23:0<0,1,1{Off,On}>-High fizz
slider24:0<0,2,1{Off,Dip,Lift}>-Mid dip / lift
slider25:30<0,100,1>-Comp (%)
slider26:1<0,2,1{Fast,Medium,Slow}>-Comp speed
slider27:1<0,1,1{Off,On}>-Comp link
slider28:0<0,12,0.1>-Clip (dB)
slider29:100<0,100,1>-Mix (%)
slider30:100<0,200,1>-Width (%)
slider31:0<-24,12,0.1>-Output (dB)
slider32:50<0,100,1>-Drift (%)
slider33:0<0,2,1{1x,2x,4x}>-Oversampling
slider34:0<0,1,1{Off,On}>-Low thick
slider35:prs_sel=0<0,6,1{No preset,Init,Warm Bus,Tight Low End,Air and Glue,Wide Tape,Pushed}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-bands.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-buss-boss-mini";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 0; clp_kt_on = 0;

function nu_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function nu_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function nu_db(d) ( exp(d * 0.11512925464970228); );
function nu_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );

function nu_bscoef(f1, f2, fs) local(g) (
  bs_k = 1.4142135623730951;
  f1 = max(10, min(f1, fs * 0.45));  f2 = max(f1 * 1.01, min(f2, fs * 0.45));
  g = tan($pi * f1 / fs);  bs_a1 = 1 / (1 + g * (g + bs_k));  bs_a2 = g * bs_a1;  bs_a3 = g * bs_a2;
  g = tan($pi * f2 / fs);  bs_b1 = 1 / (1 + g * (g + bs_k));  bs_b2 = g * bs_b1;  bs_b3 = g * bs_b2;
);

function nu_svc(f, fs) local(g) ( g = tan($pi * min(f, fs * 0.45) / fs); nu_c1 = 1 / (1 + g * (g + 1.4142135623730951)); nu_c2 = g * nu_c1; nu_c3 = g * nu_c2; );
function nu_svf(x, a1, a2, a3) instance(s1, s2, lp, hp) local(v1, v2, v3) (
  v3 = x - s2;  v1 = a1 * s1 + a2 * v3;  v2 = s2 + a2 * s1 + a3 * v3;  s1 = 2 * v1 - s1;  s2 = 2 * v2 - s2;
  lp = v2;  hp = x - 1.4142135623730951 * v1 - v2;
);
function nu_op(x, k) instance(z) ( z += k * (x - z); );

function nu_iron(x, g) local(t) (
  t = max(-1.5, min(1.5, (g * x + nu_ib) / nu_hd));
  (nu_hd * t * (1 - 0.14814814814814814 * t * t) - nu_ir0) / g;
);

function nu_fizz(h) local(t) (
  t = max(-1.5, min(1.5, 6 * h));
  0.19 * h + 3 * (h - t * (1 - 0.14814814814814814 * t * t) / 6);
);

function nu_vc(u) ( u >= 0 ? u / (1 + 0.5 * u) : u / (1 - 0.25 * u); );
function nu_valve(x, g) ( nu_hd * (nu_vc(g * x / nu_hd + nu_vb) - nu_vr0) / (g * nu_vsl); );

function nu_tape(x, g, bump, lm) instance(z, b1, b2) local(t, y) (
  t = max(-1.5, min(1.5, g * x));
  y = t * (1 - 0.14814814814814814 * t * t) / g;
  z += nu_tk * (y - z);
  b1 += nu_bk1 * (z - b1);  b2 += nu_bk2 * (z - b2);
  y + lm * (z - y) + bump * (b1 - b2);
);

function nu_drv(p) ( nu_db(-24 + 0.42 * min(max(p, 0), 100)); );

function nu_gr(e) local(o) (
  o = e - nu_thr;
  o <= -3 ? 0 : o >= 3 ? o * (1 - 1 / nu_rat) : (1 - 1 / nu_rat) * sqr(o + 3) / 12;
);

function nu_clip(x) instance(q1, r1) local(r, dx, y) (
  r = this.clp_ad(x) - 0.5 * x * x;  dx = x - q1;
  y = abs(dx) > 0.00001 ? (r - r1) / dx : this.clp_crv(0.5 * (x + q1)) - 0.5 * (x + q1);
  q1 = x;  r1 = r;
  x + y;
);

function nu_os(xl, xr) local(m, s, l, r, u, e) (

  nuHL.nu_svf(xl, nu_h1, nu_h2, nu_h3);  nuHR.nu_svf(xr, nu_h1, nu_h2, nu_h3);
  nuLL.nu_svf(nuHL.hp, nu_l1, nu_l2, nu_l3);  nuLR.nu_svf(nuHR.hp, nu_l1, nu_l2, nu_l3);
  l = nuLL.lp + nu_lop * (nuHL.hp - nuLL.lp);  r = nuLR.lp + nu_lop * (nuHR.hp - nuLR.lp);
  nuSL.bs_split(l);  nuSR.bs_split(r);

  u = max(abs(l), abs(r));  nu_xe += (u > nu_xe ? nu_xa : nu_xrc) * (u - nu_xe);

  nu_bl = nuSL.lo + nu_tko * (0.26 * nuKL.nu_op(nuSL.lo, nu_kk) + 0.5 * nuSL.lo * nuSL.lo);
  nu_br = nuSR.lo + nu_tko * (0.26 * nuKR.nu_op(nuSR.lo, nu_kk) + 0.5 * nuSR.lo * nuSR.lo);
  nuDL.nu_svf(nuSL.mi, nu_d1, nu_d2, nu_d3);  nuDR.nu_svf(nuSR.mi, nu_d1, nu_d2, nu_d3);
  nu_ml2 = nuSL.mi + nu_dlo * (nuSL.mi - nuDL.lp - nuDL.hp);  nu_mr2 = nuSR.mi + nu_dlo * (nuSR.mi - nuDR.lp - nuDR.hp);
  nu_hl2 = nuSL.hi + nu_fzo * nu_fizz(nuSL.hi - nuFL.nu_op(nuSL.hi, nu_fk));
  nu_hr2 = nuSR.hi + nu_fzo * nu_fizz(nuSR.hi - nuFR.nu_op(nuSR.hi, nu_fk));

  l = nu_iron(nu_iron(nu_bl, nu_gl1) * nu_lv0, nu_gl2);  r = nu_iron(nu_iron(nu_br, nu_gl1) * nu_lv0, nu_gl2);
  l += nu_iron(nu_iron(nu_ml2, nu_gm1) * nu_lv1, nu_gm2);  r += nu_iron(nu_iron(nu_mr2, nu_gm1) * nu_lv1, nu_gm2);
  l += nu_iron(nu_iron(nu_hl2, nu_gh1) * nu_lv2, nu_gh2);  r += nu_iron(nu_iron(nu_hr2, nu_gh1) * nu_lv2, nu_gh2);

  e = nu_xe * 5;  e = min(3, e * sqrt(e));
  m = (l + r) * 0.5;  s = (l - r) * 0.5;
  m += nu_vmo * e * (nu_valve(m, nu_gvm) - m);  s += nu_vso * e * (nu_valve(s, nu_gvs) - s);
  m += nu_tmo * e * (nuTM.nu_tape(m, nu_gtm, nu_bpm, nu_bpm * 1.6667) - m);
  s += nu_tso * e * (nuTS.nu_tape(s, nu_gts, nu_bps, nu_bps * 1.6667) - s);
  l = m + s;  r = m - s;

  l += nu_sh2 * (l - nuBL.nu_op(l, nu_bk));  r += nu_sh2 * (r - nuBR.nu_op(r, nu_bk));
  m = nuTL.nu_op(l, nu_pk);  u = nuTR.nu_op(r, nu_pk);
  l = m * nu_tlo + (l - m) * nu_thi;  r = u * nu_tlo + (r - u) * nu_thi;
  l += nu_sh0 * nuAL.nu_op(l, nu_ak);  r += nu_sh0 * nuAR.nu_op(r, nu_ak);
  nu_ql = l;  nu_qr = r;

  l *= 1 + nu_mx * (nu_cgl - 1);  r *= 1 + nu_mx * (nu_cgr - 1);
  l *= nu_cd;  r *= nu_cd;
  max(abs(l), abs(r)) > 0.891 ? nu_clf = 1;
  nu_pl = nuCL.nu_clip(l) / nu_cd;  nu_pr = nuCR.nu_clip(r) / nu_cd;
);

function nu_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  nuSL.bs_clear(); nuSR.bs_clear();
  nuHL.s1 = nuHL.s2 = nuHR.s1 = nuHR.s2 = nuLL.s1 = nuLL.s2 = nuLR.s1 = nuLR.s2 = 0;
  nuAL.z = nuAR.z = nuBL.z = nuBR.z = nuTL.z = nuTR.z = 0;
  nuTM.z = nuTM.b1 = nuTM.b2 = nuTS.z = nuTS.b1 = nuTS.b2 = 0;  nu_xe = 0;
  nuKL.z = nuKR.z = nuFL.z = nuFR.z = nuDL.s1 = nuDL.s2 = nuDR.s1 = nuDR.s2 = 0;
  nuCL.q1 = nuCL.r1 = nuCR.q1 = nuCR.r1 = 0;
);

function nu_reset() (
  nu_clear(); memset(BY_BUF, 0, 2 * BY_N);
  nu_dxl = nu_dyl = nu_dxr = nu_dyr = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  nu_grl = nu_grr = 0;
  nu_fi = 0;
);

PT = 6000000;
#nu_pm = "Init|Warm Bus|Tight Low End|Air and Glue|Wide Tape|Pushed";
function nu_w5(a, b, c, d, e) ( nu_wp[0] = a; nu_wp[1] = b; nu_wp[2] = c; nu_wp[3] = d; nu_wp[4] = e; nu_wp += 5; );
nu_wp = PT;

nu_w5(0, 1, 220, 2200, 0);  nu_w5(22000, 1, 0, 0, 0);  nu_w5(1, 0, 0, 0, 22);  nu_w5(1, 0, 0, 0, 1);  nu_w5(2, 0, 0, 30, 1);  nu_w5(1, 0, 100, 100, 0);
nu_w5(0, 1, 220, 2200, 0);  nu_w5(16500, 1, 0, -0.5, -1);  nu_w5(1, 0, 0.5, -20, 33);  nu_w5(1, 1, 1.5, 2, 1);  nu_w5(1, 0, 0, 40, 2);  nu_w5(1, 0, 100, 100, 1);
nu_w5(0, 1, 110, 2200, 0);  nu_w5(22000, 0, 1, 0, 0);  nu_w5(1, 0, 0, 0, 44);  nu_w5(1, 1, 0, 3, 1);  nu_w5(0, 0, 1, 45, 0);  nu_w5(1, 0, 100, 90, 1.5);
nu_w5(0, 1, 330, 3300, 1);  nu_w5(22000, 1, 1, 1, 3);  nu_w5(0, 0, 0, 15, 22);  nu_w5(1, 1, 0, 0, 0);  nu_w5(2, 1, 1, 35, 1);  nu_w5(1, 0, 70, 110, -1.5);
nu_w5(0, 1, 220, 2200, 0);  nu_w5(18000, 1, 0, 1.5, 1);  nu_w5(1, 1, 0, -10, 22);  nu_w5(1, 0, 0, 0, 2);  nu_w5(2, 0, 0, 25, 1);  nu_w5(1, 0, 100, 140, 0.5);
nu_w5(-2, 1, 220, 2200, 0);  nu_w5(16500, 1, 0, 0, 1);  nu_w5(1, 0, 0, 10, 33);  nu_w5(1, 1, 0, 2, 1);  nu_w5(1, 1, 2, 70, 1);  nu_w5(1, 4, 100, 100, 6.5);
function load_preset(p) local(i, q) (
  q = PT + (min(p, 7) == 7 ? 0 : p - 1) * 30;
  i = 0; loop(30, slider(2 + i) = q[i]; i += 1; );
  i = 0; loop(3, q = i == 0 ? 8 : i == 1 ? 12 : 17;
    slider(q + 1) = slider(q) >= 0.5 && slider(q + 1) >= 0.5; slider(q) = slider(q) >= 0.5 && !slider(q + 1); i += 1; );
  p == 7 ? slider(32) = 50;
  slider34 = p >= 7 ? 0 : (p == 2 || p == 3 || p == 6);
  i = 2; loop(31, ui_auto(i); i += 1; );  ui_auto(34);
  pr_cur = p == 7 ? 1 : p;
);

function nu_srinit() (
  nu_sr = srate;
  c_kn = nu_tc(30);
  c_sw = nu_tc(10);
  c_tk = 1 - exp(-32 / (0.03 * srate));
  nu_dcc = 1 - 2 * $pi * 5 / srate;
  nu_fis = 1 / (0.01 * srate);
  ost_init(0);
  nu_clear();
  nu_snap = 1;
);

function nu_coef() (
  nu_fs = srate * os_f;
  nu_bscoef(nu_f1, nu_f2, nu_fs);
  nu_svc(nu_fh, nu_fs);  nu_h1 = nu_c1; nu_h2 = nu_c2; nu_h3 = nu_c3;
  nu_svc(nu_fl, nu_fs);  nu_l1 = nu_c1; nu_l2 = nu_c2; nu_l3 = nu_c3;
  nu_ak = nu_opk(110, nu_fs);  nu_bk = nu_opk(8800, nu_fs);  nu_pk = nu_opk(1100, nu_fs);
  nu_tk = nu_opk(18000, nu_fs);  nu_bk1 = nu_opk(110, nu_fs);  nu_bk2 = nu_opk(33, nu_fs);
  nu_kk = nu_opk(110, nu_fs);  nu_fk = nu_opk(4400, nu_fs);
  nu_svc(sqrt(nu_f1 * nu_f2), nu_fs);  nu_d1 = nu_c1; nu_d2 = nu_c2; nu_d3 = nu_c3;
  nu_xa = 1 - exp(-1 / (0.01 * nu_fs));  nu_xrc = 1 - exp(-1 / (0.15 * nu_fs));
);
os_design();
os_f = os_tf = os_f2n(slider33); os_base = 0;
nu_srinit();
os_gsetup();
in_init();
pwr_init(); pwr_wu_loss = 0.8; pwr_wu_drv = 1.5; pwr_wu_lp = 8000; pwr_bloom = 0.2;
dSup.drift_init(0.8 + rand(1) * 0.4); dBi.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
nu_hd = 1; nu_ib = 0.06; nu_ir0 = nu_ib * (1 - 0.14814814814814814 * nu_ib * nu_ib);
nu_vb = 0.15; nu_vr0 = nu_vc(nu_vb); nu_vsl = 1 / sqr(1 + 0.5 * nu_vb);
nu_cgl = nu_cgr = 1; nu_cd = 1;
nuCL.clp_set(2, 0.891, 0.891, 0); nuCL.clp_knee(0.12);
nuCR.clp_set(2, 0.891, 0.891, 0); nuCR.clp_knee(0.12);
nu_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(34, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 6 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(6, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(33));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != nu_sr ? nu_srinit();
nu_now = time_precise();
nu_tp > 0 && nu_now - nu_tp > max(0.25, 4 * samplesblock / srate) ? nu_reset();
nu_tp = nu_now;
pwr_block(slider1 < 0.5);
in_setup(min(max(slider2, -24), 12), slider3 >= 0.5);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider33); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;

drift_macro(slider32);
nu_n = samplesblock / srate;
nu_vs = dSup.drift_tick(0.05 * dm_s * nu_n); nu_vbw = dBi.drift_tick(0.04 * dm_s * nu_n);
nu_hdt = nu_db(0.4 * dm_a * nu_vs);
nu_vbt = 0.15 + 0.02 * dm_a * nu_vbw;

nu_f1t = min(max(slider4, 110), 1100);
nu_f2t = slider6 >= 0.5 ? nu_f1t * 10 : min(max(slider5, 1100), 11000);
nu_flt = min(max(slider7, 3300), 22000);  nu_fht = min(max(slider16, 11), 330);
nu_lopt = sqr(min(max((nu_flt - 16500) / 5500, 0), 1));

nu_z = nu_db(6); nu_a = nu_drv(0);
nu_gh1t = slider8 >= 0.5 ? nu_z : nu_a;   nu_gh2t = slider9 >= 0.5 ? nu_z : nu_a;
nu_gm1t = slider12 >= 0.5 ? nu_z : nu_a;  nu_gm2t = slider13 >= 0.5 ? nu_z : nu_a;
nu_gl1t = slider17 >= 0.5 ? nu_z : nu_a;  nu_gl2t = slider18 >= 0.5 ? nu_z : nu_a;
nu_lv2t = nu_db(slider10);  nu_lv1t = nu_db(slider14);  nu_lv0t = nu_db(slider19);
nu_sh2t = nu_db(slider11) - 1;  nu_sh0t = nu_db(slider20) - 1;
nu_tv = min(max(slider15, -100), 100) / 100;  nu_tlot = nu_db(-6 * nu_tv);  nu_thit = nu_db(6 * nu_tv);

nu_gvmt = nu_gvst = nu_db(-6.5);  nu_gtmt = nu_gtst = nu_db(-7.8);  nu_bpmt = nu_bpst = 0.27;
nu_tkot = slider34 >= 0.5;  nu_fzot = slider23 >= 0.5;  nu_dlot = slider24 < 0.5 ? 0 : slider24 < 1.5 ? nu_db(-2) - 1 : nu_db(1.5) - 1;
nu_vmot = slider21 > 0.5 && slider21 < 1.5;  nu_vsot = slider21 >= 1.5;  nu_tmot = slider22 > 0.5 && slider22 < 1.5;  nu_tsot = slider22 >= 1.5;

nu_cm = min(max(slider25, 0), 100) / 100;
nu_thr = -6 - 24 * nu_cm;  nu_rat = 1 + 3 * nu_cm;
nu_z = slider26 < 0.5 ? 0 : slider26 < 1.5 ? 1 : 2;
nu_ca = 1 - exp(-1 / ((nu_z == 0 ? 0.003 : nu_z == 1 ? 0.010 : 0.030) * srate));
nu_cr = 1 - exp(-1 / ((nu_z == 0 ? 0.080 : nu_z == 1 ? 0.200 : 0.500) * srate));
nu_lkt = slider27 >= 0.5;
nu_cdt = nu_db(min(max(slider28, 0), 12));
nu_mxt = min(max(slider29, 0), 100) / 100;
nu_wdt = min(max(slider30, 0), 200) / 100;
nu_ogt = nu_db(min(max(slider31, -24), 12));
nu_snap ? (
  nu_f1 = nu_f1t; nu_f2 = nu_f2t; nu_fh = nu_fht; nu_fl = nu_flt; nu_lop = nu_lopt;
  nu_gl1 = nu_gl1t; nu_gl2 = nu_gl2t; nu_gm1 = nu_gm1t; nu_gm2 = nu_gm2t; nu_gh1 = nu_gh1t; nu_gh2 = nu_gh2t;
  nu_lv0 = nu_lv0t; nu_lv1 = nu_lv1t; nu_lv2 = nu_lv2t; nu_sh0 = nu_sh0t; nu_sh2 = nu_sh2t;
  nu_tlo = nu_tlot; nu_thi = nu_thit; nu_gvm = nu_gvmt; nu_gvs = nu_gvst; nu_gtm = nu_gtmt; nu_gts = nu_gtst;
  nu_bpm = nu_bpmt; nu_bps = nu_bpst; nu_tko = nu_tkot; nu_fzo = nu_fzot; nu_dlo = nu_dlot; nu_vmo = nu_vmot; nu_vso = nu_vsot; nu_tmo = nu_tmot; nu_tso = nu_tsot; nu_lk = nu_lkt; nu_cd = nu_cdt; nu_mx = nu_mxt; nu_og = nu_ogt; nu_wd = nu_wdt; nu_hd = nu_hdt; nu_vb = nu_vbt;
  nu_coef();
);
nu_snap = 0;
nu_dyl = nu_tn(nu_dyl); nu_dyr = nu_tn(nu_dyr);
abs(nuCL.q1) < 0.000000000001 ? nuCL.q1 = nuCL.r1 = 0; abs(nuCR.q1) < 0.000000000001 ? nuCR.q1 = nuCR.r1 = 0;
nuTM.z = nu_tn(nuTM.z); nuTS.z = nu_tn(nuTS.z);

nu_ol_d = max(nu_ol_d, nu_ol); nu_or_d = max(nu_or_d, nu_or); nu_ol = nu_or = 0;
nu_gr_d = max(nu_gr_d, max(nu_grl, nu_grr));
nu_il_d = max(nu_il_d, nu_il); nu_ir_d = max(nu_ir_d, nu_ir); nu_il = nu_ir = 0;
nu_clf ? nu_cl_d = 1; nu_clf = 0;
bm_vu_d = max(bm_vu_d, sqrt(bm_ms / max(samplesblock, 1))); bm_ms = 0;
os_snapb(slider(33));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
nu_il = max(nu_il, abs(in_l)); nu_ir = max(nu_ir, abs(in_r));
pwr_in(in_l, in_r); nu_xl = pwr_l; nu_xr = pwr_r;

nu_gl1 += (nu_gl1t - nu_gl1) * c_kn; nu_gl2 += (nu_gl2t - nu_gl2) * c_kn;
nu_gm1 += (nu_gm1t - nu_gm1) * c_kn; nu_gm2 += (nu_gm2t - nu_gm2) * c_kn;
nu_gh1 += (nu_gh1t - nu_gh1) * c_kn; nu_gh2 += (nu_gh2t - nu_gh2) * c_kn;
nu_lv0 += (nu_lv0t - nu_lv0) * c_kn; nu_lv1 += (nu_lv1t - nu_lv1) * c_kn; nu_lv2 += (nu_lv2t - nu_lv2) * c_kn;
nu_sh0 += (nu_sh0t - nu_sh0) * c_kn; nu_sh2 += (nu_sh2t - nu_sh2) * c_kn;
nu_tlo += (nu_tlot - nu_tlo) * c_kn; nu_thi += (nu_thit - nu_thi) * c_kn;
nu_gvm += (nu_gvmt - nu_gvm) * c_kn; nu_gvs += (nu_gvst - nu_gvs) * c_kn;
nu_gtm += (nu_gtmt - nu_gtm) * c_kn; nu_gts += (nu_gtst - nu_gts) * c_kn;
nu_bpm += (nu_bpmt - nu_bpm) * c_kn; nu_bps += (nu_bpst - nu_bps) * c_kn;
nu_cd += (nu_cdt - nu_cd) * c_kn; nu_mx += (nu_mxt - nu_mx) * c_kn; nu_og += (nu_ogt - nu_og) * c_kn; nu_wd += (nu_wdt - nu_wd) * c_kn; nu_lop += (nu_lopt - nu_lop) * c_kn;
nu_lk += (nu_lkt - nu_lk) * c_sw;
nu_tko += (nu_tkot - nu_tko) * c_sw; nu_fzo += (nu_fzot - nu_fzo) * c_sw; nu_dlo += (nu_dlot - nu_dlo) * c_sw;
nu_vmo += (nu_vmot - nu_vmo) * c_sw; nu_vso += (nu_vsot - nu_vso) * c_sw; nu_tmo += (nu_tmot - nu_tmo) * c_sw; nu_tso += (nu_tsot - nu_tso) * c_sw;
nu_hd += (nu_hdt - nu_hd) * c_kn;
nu_vb += (nu_vbt - nu_vb) * c_kn; nu_vr0 = nu_vc(nu_vb); nu_vsl = 1 / sqr(1 + 0.5 * nu_vb);
nu_ir0 = nu_hd * (nu_ib / nu_hd) * (1 - 0.14814814814814814 * sqr(nu_ib / nu_hd));

(nu_tick += 1) >= 32 ? (
  nu_tick = 0;
  nu_f1 += (nu_f1t - nu_f1) * c_tk; nu_f2 += (nu_f2t - nu_f2) * c_tk;
  nu_fh += (nu_fht - nu_fh) * c_tk; nu_fl += (nu_flt - nu_fl) * c_tk;
  nu_coef();
);
abs(nu_xl) < 0.000000000000001 ? nu_xl = 0; abs(nu_xr) < 0.000000000000001 ? nu_xr = 0;
os_gate();
os_chg ? ( nu_clear(); nu_coef(); os_hold += 2 * samplesblock; );

uxL.os_up(nu_xl); uxR.os_up(nu_xr);
os_f == 1 ? (
  nu_os(uxL.s0, uxR.s0); nu_yl = nu_pl; nu_yr = nu_pr; nu_dl = nu_ql; nu_dr = nu_qr;
) : (
  nu_os(uxL.s0, uxR.s0); nu_a0 = nu_pl; nu_b0 = nu_pr; nu_dl = nu_ql; nu_dr = nu_qr;
  nu_os(uxL.s1, uxR.s1); nu_a1 = nu_pl; nu_b1 = nu_pr;
  os_f == 2 ? ( nu_yl = dnL.os_dn(nu_a0, nu_a1, 0, 0); nu_yr = dnR.os_dn(nu_b0, nu_b1, 0, 0); ) : (
    nu_os(uxL.s2, uxR.s2); nu_a2 = nu_pl; nu_b2 = nu_pr;
    nu_os(uxL.s3, uxR.s3); nu_a3 = nu_pl; nu_b3 = nu_pr;
    nu_yl = dnL.os_dn(nu_a0, nu_a1, nu_a2, nu_a3); nu_yr = dnR.os_dn(nu_b0, nu_b1, nu_b2, nu_b3);
  );
);

nu_el = 20 * log10(max(abs(nu_dl), 0.00001)); nu_er = 20 * log10(max(abs(nu_dr), 0.00001));
nu_em = max(nu_el, nu_er);
nu_el += (nu_em - nu_el) * nu_lk; nu_er += (nu_em - nu_er) * nu_lk;
nu_z = nu_gr(nu_el); nu_grl += (nu_z - nu_grl) * (nu_z > nu_grl ? nu_ca : nu_cr);
nu_z = nu_gr(nu_er); nu_grr += (nu_z - nu_grr) * (nu_z > nu_grr ? nu_ca : nu_cr);
nu_cgl = nu_db(-nu_grl); nu_cgr = nu_db(-nu_grr);

nu_z = (nu_yl + nu_yr) * 0.5; nu_a = (nu_yl - nu_yr) * 0.5 * nu_wd; nu_yl = nu_z + nu_a; nu_yr = nu_z - nu_a;

nu_z = nu_yl - nu_dxl + nu_dcc * nu_dyl; nu_dxl = nu_yl; nu_dyl = nu_z; nu_yl = nu_z;
nu_z = nu_yr - nu_dxr + nu_dcc * nu_dyr; nu_dxr = nu_yr; nu_dyr = nu_z; nu_yr = nu_z;
pwr_out(nu_yl, nu_yr); nu_yl = pwr_l * nu_og; nu_yr = pwr_r * nu_og;
nu_osg = os_g * os_g * (3 - 2 * os_g);
nu_yl *= nu_osg; nu_yr *= nu_osg;
nu_yl != nu_yl ? nu_yl = 0; nu_yr != nu_yr ? nu_yr = 0;
nu_fi < 1 ? (
  nu_fi = min(nu_fi + nu_fis, 1); nu_z = nu_fi * nu_fi * (3 - 2 * nu_fi);
  nu_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; nu_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  nu_yl = nu_a + nu_z * (nu_yl - nu_a); nu_yr = nu_b + nu_z * (nu_yr - nu_b);
);
ost_out(nu_yl, nu_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
nu_ol = max(nu_ol, abs(spl0)); nu_or = max(nu_or, abs(spl1));
bm_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);

@gfx 900 380
ui_begin(900, 380);
mk_face = 0x1F4A33; mk_band = 0x0E2218; mk_ink = 0xF6EEE2; mk_tab = 0xE0B040; mk_acc = 0xF8E6B0;
mk_sub = 0x16352A; mk_ink2 = 0xCFE0D2;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );

function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);

function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );

function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );

function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0xF4F6F8); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0x1A1A1C); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(0x1A1A1C); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);

function mg_well(x, y, w, h) ( ui_cola(0x000000, 0.18); mg_r(x, y, w, h); ui_cola(0x000000, 0.12); mg_r(x, y, w, 2); mg_r(x, y + 2, 2, h - 2); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );

function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, i, t) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  sty == 1 ? (

    ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KRD * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KRD * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KRD * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KRD * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.72);
  ) : sty == 2 ? (

    ui_col(0xA9ACAF); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0xF1F0EC); gfx_circle(KX, KY, KRD * 0.92, 1, 1);
    i = 0; loop(6, ui_cola(0x000000, 0.12 * (1 - i / 6)); gfx_circle(KX, KY, KRD * 0.92 - i * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.9 : 0.8); ui_ssarc(KX, KY, KRD * 0.8, -2.5 + 0.5 * $pi, -1.4 + 0.5 * $pi, 1 * sc);
    ui_col(0x26282C); ui_kdot(KX, KY, a, KRD * 0.92);
  ) : (

    ui_col(0x2C2E33); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0x121315); gfx_circle(KX, KY, KRD * 0.8, 1, 1);
    ui_col(ui_mix(0x2C2E33, 0x000000, 0.25)); gfx_circle(KX, KY, KRD * 0.68, 1, 1);
    ui_cola(0xFFFFFF, act ? 0.22 : 0.12); ui_ssarc(KX, KY, KRD * 0.95, -2.6 + 0.5 * $pi, -1.0 + 0.5 * $pi, 1 * sc);
    ui_col(0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.68);
  );
);

function mg_dots(x, y, r, c) local(i, t, rs, px, py, n) (
  rs = r + 8; i = 0; n = mg_nst > 0 && mg_nst <= 8 ? mg_nst - 1 : 4;
  loop(n + 1, t = -0.75 * $pi + i / n * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_wdial && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); ui_col(c);
      mg_ctxt(px + (i == 0 ? -3 : i == 4 ? 3 : 0), py + (i == 2 ? -2 : 0), i == 0 ? "M" : i == 2 ? "C" : "S"); )
    : mg_zero && i == 2 ? ( gfx_setfont(11); ui_col(c); mg_ctxt(px, py - 2, "0"); )
    : ( ui_col(c); mg_disc(px, py, i == 0 || i == n ? 1.8 : 1.3); );
    i += 1; );
);

function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx; mgk_n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : mg_nst > 0 ? 160 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi, lg); mg_nst > 0 ? v = floor(v + 0.5);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    mg_nst > 0 ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(mg_v2n(v, lo, hi, lg) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
      slider(idx) = mg_n2v(n, lo, hi, lg);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did; a = -0.75 * $pi + n * 1.5 * $pi;
  mg_dots(cx, cy, r, mk_ink2); mg_cshadow(cx, cy, r);
  mg_kbody(sty, cx, cy, r, a, act, col);
  mg_wdial = 0; mg_zero = 0; mg_nst = 0;
  act;
);

function mg_hz(v) ( v >= 1000 ? sprintf(#mgh, "%.1f kHz", v / 1000) : sprintf(#mgh, "%d Hz", v + 0.5); #mgh; );
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, sty, col, kind, name) local(k, v, m) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%d %%", floor(v + 0.5)) : kind == 1 ? sprintf(#mgv, "%+d %%", floor(v + 0.5)) :
  kind == 2 ? sprintf(#mgv, "%d ms", floor(v + 0.5)) : kind == 3 ? sprintf(#mgv, "%.1f", v) :
  kind == 4 ? strcpy(#mgv, mg_hz(v)) : kind == 5 ? sprintf(#mgv, "%+.1f dB", v) :
  kind == 6 ? ( m = floor(v + 0.5); strcpy(#mgv, m == 0 ? "OFF" : m == 1 ? "33 Hz" : m == 2 ? "55 Hz" : m == 3 ? "77 Hz" : m == 4 ? "110 Hz" : m == 5 ? "220 Hz" : "330 Hz"); ) :
  kind == 7 ? strcpy(#mgv, v <= 11.5 ? "OFF" : mg_hz(v)) : strcpy(#mgv, v >= 21500 ? "OFF" : mg_hz(v));
  gfx_setfont(10); ui_col(k ? mk_acc : mk_ink); mg_ctxt(cx, ly, k ? #mgv : name);
  k;
);

function mg_sqkey(x, y, idx, lbl, lc, ly) local(on, hov, s, b, dn) (
  on = slider(idx) >= 0.5; s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 0 : 1; ui_auto(idx); on = !on; dn = on ? 1.5 : 0; );
  mg_rshadow(x, y, s, s, 2);
  ui_col(0x050505); mg_r(x, y, s, s);
  ui_col(on ? 0x8A8C90 : 0x9C9EA2); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn);
  !on ? ( ui_cola(0xFFFFFF, 0.28); mg_r(x + b, y + b, s - 2 * b, 1); ui_cola(0x000000, 0.28); mg_r(x + b, y + s - b - 2, s - 2 * b, 2); )
      : ( ui_cola(0x000000, 0.35); mg_r(x + b, y + b + dn, s - 2 * b, 1.5); );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_r(x + b, y + b + dn, s - 2 * b, s - 2 * b - dn); );
  ui_col(0x050506); mg_disc(x + 34, y + 11, 7);
  ui_col(on ? lc : ui_mix(lc, 0x101214, 0.78)); mg_disc(x + 34, y + 11, 5);
  on ? ( ui_cola(lc, 0.2); mg_disc(x + 34, y + 11, 10); ui_cola(0xFFFFFF, 0.55); mg_disc(x + 32.3, y + 9.3, 1.6); );
  gfx_setfont(10); ui_col(hov ? mk_acc : mk_ink); mg_ctxt(x + 20, ly, lbl);
);

function mg_sqk(x, y, on, lbl, lc, ly) local(hov, s, b, dn, hit) (
  s = 22; b = 2; dn = on ? 1.5 : 0;
  hov = mouse_x >= x * sc && mouse_x < (x + s) * sc && mouse_y >= y * sc && mouse_y < (y + s) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  mg_rshadow(x, y, s, s, 2);
