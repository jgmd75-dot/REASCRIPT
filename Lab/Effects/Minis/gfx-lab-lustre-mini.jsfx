desc:Lustre Mini [summing mixer] (GFX Lab)
//tags: summing mixer transformer console harmonics air stems mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-os, gfx-lab-bypass, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider43:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-6,12,0.1>-Drive (dB)
slider2:30<0,100,1>-Density (%)
slider3:0<-100,100,1>-Colour (- even / + odd)
slider4:0<0,6,0.1>-Air (dB)
slider5:0<0,4,0.1>-Weight (dB)
slider6:1<0,1,1{Out,In}>-Transformer
slider7:0<-60,10,0.1>-Master (dB)
slider8:0<-60,10,0.1>-Stem 1 level (dB)
slider9:0<-60,10,0.1>-Stem 2 level (dB)
slider10:0<-60,10,0.1>-Stem 3 level (dB)
slider11:0<-60,10,0.1>-Stem 4 level (dB)
slider12:0<-60,10,0.1>-Stem 5 level (dB)
slider13:0<-60,10,0.1>-Stem 6 level (dB)
slider14:0<-60,10,0.1>-Stem 7 level (dB)
slider15:0<-60,10,0.1>-Stem 8 level (dB)
slider16:0<-100,100,1>-Stem 1 pan
slider17:0<-100,100,1>-Stem 2 pan
slider18:0<-100,100,1>-Stem 3 pan
slider19:0<-100,100,1>-Stem 4 pan
slider20:0<-100,100,1>-Stem 5 pan
slider21:0<-100,100,1>-Stem 6 pan
slider22:0<-100,100,1>-Stem 7 pan
slider23:0<-100,100,1>-Stem 8 pan
slider24:0<0,1,1{Off,On}>-Stem 1 mute
slider25:0<0,1,1{Off,On}>-Stem 2 mute
slider26:0<0,1,1{Off,On}>-Stem 3 mute
slider27:0<0,1,1{Off,On}>-Stem 4 mute
slider28:0<0,1,1{Off,On}>-Stem 5 mute
slider29:0<0,1,1{Off,On}>-Stem 6 mute
slider30:0<0,1,1{Off,On}>-Stem 7 mute
slider31:0<0,1,1{Off,On}>-Stem 8 mute
slider32:0<0,1,1{Off,On}>-Stem 1 solo
slider33:0<0,1,1{Off,On}>-Stem 2 solo
slider34:0<0,1,1{Off,On}>-Stem 3 solo
slider35:0<0,1,1{Off,On}>-Stem 4 solo
slider36:0<0,1,1{Off,On}>-Stem 5 solo
slider37:0<0,1,1{Off,On}>-Stem 6 solo
slider38:0<0,1,1{Off,On}>-Stem 7 solo
slider39:0<0,1,1{Off,On}>-Stem 8 solo
slider40:0<0,1,1{Off,On}>-Bypass
slider41:0<0,2,1{1x,2x,4x}>-Oversampling
slider42:prs_sel=0<0,7,1{No preset,Console Sheen,Warm and Round (even),Forward and Firm (odd),Driven Desk,Open Top (air),Low-Mid Weight,Straight Sum (transformer out)}>-Preset

in_pin:stem 1 L
in_pin:stem 1 R
in_pin:stem 2 L
in_pin:stem 2 R
in_pin:stem 3 L
in_pin:stem 3 R
in_pin:stem 4 L
in_pin:stem 4 R
in_pin:stem 5 L
in_pin:stem 5 R
in_pin:stem 6 L
in_pin:stem 6 R
in_pin:stem 7 L
in_pin:stem 7 R
in_pin:stem 8 L
in_pin:stem 8 R
out_pin:mix L
out_pin:mix R

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(8796093022207, v); );
function psw_allg(v) ( slider_show(8796093022207, v); );
#ui_man = "gfx-lab-lustre-mini";
ext_noinit = 1;
gdc_r = 1 - 2 * $pi / srate;
GDC = 4000; memset(GDC, 0, 32);
LHD = 180;
DEN = 0.00000000000000000001;
SG = 100; SGT = 110; SPK = 120; PGL = 130; PGR = 140;
memset(100, 0, 50);

function tx_set() instance(wt, ar) ( wt.bq_set(2, 180 / os_f, 0.7, slider5); ar.bq_set(3, 12000 / os_f, 0.5, slider4); );
function tx(x) instance(lm, hp, wt, ar, dcx, dcy) local(b, e, o, s, y) (
  lm += (x - lm) * lm_c + DEN;
  hp += (lm - hp) * hp_c + DEN; b = lm - hp;
  e = b + ke * b * b;
  o = ost_tanh(b * ko) / ko;
  s = e * (1 - cmix) + o * cmix;
  y = x - b + s;
  y = ost_tanh(y * kd) / kd;
  dcy = y - dcx + lu_dcr * dcy; dcx = y;
  ar.bq_run(wt.bq_run(dcy));
);
function tx_clr() instance(lm, hp, wt, ar, dcx, dcy) (
  lm = hp = dcx = dcy = 0;
  wt.x1 = wt.x2 = wt.y1 = wt.y2 = 0; ar.x1 = ar.x2 = ar.y1 = ar.y2 = 0;
);

function lu_coef() local(fs) (
  lu_sr = srate; lu_of = os_f; fs = srate * os_f;
  lm_c = 1 - exp(-2 * $pi * 400 / fs); hp_c = 1 - exp(-2 * $pi * 60 / fs);
  lu_dcr = os_f == 1 ? 0.9995 : 1 - 0.0005 / os_f;
  lu_fis = 1 / (0.01 * srate); lu_xs = 1 / (0.015 * srate);
  bl.tx_set(); br.tx_set();
);
function lu_clear() ( uL.os_clr(); uR.os_clr(); dL.os_clr(); dR.os_clr(); bl.tx_clr(); br.tx_clr(); );

function update() local(i, any, a, d) (
  drv = 10 ^ (slider1 / 20);
  d = slider2 / 100;
  ke = 0.4 * d; ko = 1 + 1.6 * d; kd = 1 + 0.5 * d;
  cmix = (slider3 + 100) / 200;
  tx_on = slider6;
  mst = slider7 <= -59.9 ? 0 : 10 ^ (slider7 / 20);
  bl.tx_set(); br.tx_set();
  any = 0; i = 0; loop(8, any |= slider(32 + i); i += 1; );
  i = 0;
  loop(8,
    SGT[i] = slider(24 + i) || (any && !slider(32 + i)) || slider(8 + i) <= -59.9 ? 0 : 10 ^ (slider(8 + i) / 20);
    a = (slider(16 + i) + 100) / 200;
    PGL[i] = min(1, 2 * (1 - a)); PGR[i] = min(1, 2 * a);
    i += 1;
  );
  ost_setup(0, 0, 120, 6000, -0.3, 0);
  pdc_delay = os_base + os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
);
function lu_reset() (
  lu_clear(); memset(BY_BUF, 0, 2 * BY_N); memset(GDC, 0, 32);
  lu_fi = 0;
);

function pp(dv, dn, cl, ai, wt, tx) ( slider1 = dv; slider2 = dn; slider3 = cl; slider4 = ai; slider5 = wt; slider6 = tx; );
function load_preset(p) local(i) (
  p == 1 ? pp(0, 30, 0, 1, 1, 1) :
  p == 2 ? pp(4, 50, -60, 2, 2, 1) :
  p == 3 ? pp(4, 50, 60, 1.5, 1, 1) :
  p == 4 ? pp(8, 80, -20, 2.5, 2.5, 1) :
  p == 5 ? pp(0, 15, 0, 3, 0.5, 1) :
  p == 6 ? pp(2, 40, -40, 0, 3, 1) :
  p == 7 ? pp(0, 0, 0, 0, 0, 0);
  p >= 1 && p <= 7 ? slider_automate(63);
  p == 8 ? (
    pp(0, 30, 0, 0, 0, 1); slider7 = 0;
    i = 0; loop(8, slider(8 + i) = 0; slider(16 + i) = 0; slider(24 + i) = 0; slider(32 + i) = 0; i += 1; );
    i = 1; loop(39, ui_auto(i); i += 1; );
  );
);

ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
sm = 1 - exp(-1 / (0.02 * srate));
os_design();
os_f = os_tf = os_f2n(slider41); os_base = 0;
lu_coef();
os_gsetup();
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_wu_wob = 0.15; pwr_bloom = 0.08; pwr_sag = 0.15;
update();
i = 0; loop(8, SG[i] = SGT[i]; i += 1; );
lu_xm = lu_xt = tx_on; lu_fi = 1; lu_run = 0;
lu_clear();
by_setup(40);
ui_thm = 5; ui_hw = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_sl() ( update(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(41, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(7, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 7 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
prs_sl();
os_snap(slider(41));

@block
prs_chk();
lu_now = time_precise();
lu_tp > 0 && lu_now - lu_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > lu_gpp && play_position - lu_gpp < 4 * lu_gpd + 0.05) ? lu_reset();
lu_tp = lu_now; lu_gpp = play_position; lu_gpd = samplesblock / srate;
os_tf = os_f2n(slider41);
srate != lu_sr || os_f != lu_of ? ( lu_coef(); lu_clear(); );
dv_ack_d != lu_seen ? ( lu_okl = lu_okr = 0; lu_vs = lu_vn = 0; lu_seen = dv_ack_d; );
update();
lu_xt = tx_on; !lu_run ? ( lu_xm = lu_xt; lu_run = 1; );
pwr_block(slider40 < 0.5);
os_snapb(slider(41));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
by_il = spl0 + spl2 + spl4 + spl6 + spl8 + spl10 + spl12 + spl14;
by_ir = spl1 + spl3 + spl5 + spl7 + spl9 + spl11 + spl13 + spl15;
lu_i = 0;
loop(16,
  lu_x = spl(lu_i); lu_x != lu_x ? lu_x = 0;
  lu_y = lu_x - GDC[lu_i] + gdc_r * GDC[16 + lu_i]; GDC[lu_i] = lu_x; GDC[16 + lu_i] = lu_y; spl(lu_i) = lu_y;
  lu_i += 1;
);
sl = 0; sr = 0; k = 0;
loop(8,
  SG[k] += (SGT[k] - SG[k]) * sm;
  SPK[k] = max(SPK[k], max(abs(spl(2 * k)), abs(spl(2 * k + 1))));
  sl += spl(2 * k) * SG[k] * PGL[k]; sr += spl(2 * k + 1) * SG[k] * PGR[k];
  k += 1;
);
pwr_in(sl, sr); sl = pwr_l; sr = pwr_r;
lu_xm != lu_xt ? ( lu_xm += min(max(lu_xt - lu_xm, -lu_xs), lu_xs); );
os_gate();
os_chg ? ( lu_coef(); lu_clear(); );
os_f == 1 ? (
  lu_xm > 0 ? (
    lu_wl = bl.tx(sl * drv) / drv; lu_wr = br.tx(sr * drv) / drv;
    lu_xm >= 1 ? ( sl = lu_wl; sr = lu_wr; ) : ( sl += lu_xm * (lu_wl - sl); sr += lu_xm * (lu_wr - sr); );
  );
) : (
  uL.os_up(sl * drv); uR.os_up(sr * drv);
  lu_a0 = lu_xm > 0 ? uL.s0 + lu_xm * (bl.tx(uL.s0) - uL.s0) : uL.s0; lu_b0 = lu_xm > 0 ? uR.s0 + lu_xm * (br.tx(uR.s0) - uR.s0) : uR.s0;
  lu_a1 = lu_xm > 0 ? uL.s1 + lu_xm * (bl.tx(uL.s1) - uL.s1) : uL.s1; lu_b1 = lu_xm > 0 ? uR.s1 + lu_xm * (br.tx(uR.s1) - uR.s1) : uR.s1;
  os_f == 2 ? ( sl = dL.os_dn(lu_a0, lu_a1, 0, 0); sr = dR.os_dn(lu_b0, lu_b1, 0, 0); ) : (
    lu_a2 = lu_xm > 0 ? uL.s2 + lu_xm * (bl.tx(uL.s2) - uL.s2) : uL.s2; lu_b2 = lu_xm > 0 ? uR.s2 + lu_xm * (br.tx(uR.s2) - uR.s2) : uR.s2;
    lu_a3 = lu_xm > 0 ? uL.s3 + lu_xm * (bl.tx(uL.s3) - uL.s3) : uL.s3; lu_b3 = lu_xm > 0 ? uR.s3 + lu_xm * (br.tx(uR.s3) - uR.s3) : uR.s3;
    sl = dL.os_dn(lu_a0, lu_a1, lu_a2, lu_a3); sr = dR.os_dn(lu_b0, lu_b1, lu_b2, lu_b3);
  );
  sl /= drv; sr /= drv;
);
lu_xm <= 0 ? ( bl.tx_clr(); br.tx_clr(); );
pwr_out(sl, sr); sl = pwr_l; sr = pwr_r;
sl *= mst; sr *= mst;
sl = ostL.ost_band(sl); sr = ostR.ost_band(sr);
ost_out(sl, sr);
spl0 = ost_l; spl1 = ost_r;
k = 2; loop(14, spl(k) = 0; k += 1; );
lu_g = os_g * os_g * (3 - 2 * os_g);
lu_g < 1 ? ( spl0 *= lu_g; spl1 *= lu_g; );
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
lu_fi < 1 ? (
  lu_fi = min(lu_fi + lu_fis, 1); lu_z = lu_fi * lu_fi * (3 - 2 * lu_fi);
  lu_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; lu_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  spl0 = lu_a + lu_z * (spl0 - lu_a); spl1 = lu_b + lu_z * (spl1 - lu_b);
);
by_out();
lu_okl = max(lu_okl, abs(spl0)); lu_okr = max(lu_okr, abs(spl1));
lu_vs += 0.5 * (spl0 * spl0 + spl1 * spl1); lu_vn += 1;
lu_opl_d = lu_okl; lu_opr_d = lu_okr; lu_vu_d = sqrt(lu_vs / max(lu_vn, 1));

@gfx 900 355
ui_begin(900, 355);
LU_PNL = 0xE6DDC6; LU_INK = 0x3E2818; LU_BRN = 0x6E4428; LU_AMB = 0xC8862E; LU_CRM = 0xF4EEDC;
LU_TAN = 0xB89870; LU_DIM = 0x8A7458; LU_YEL = 0xF2C21B; LU_RED = 0xE8402A; LU_LED = 0x3DD65A;
lu_ft = ui_mix(LU_PNL, 0xFFFFFF, 0.22); lu_fb = ui_mix(LU_PNL, 0x000000, 0.22);
ui_vu_dim = slider40 >= 0.5; lu_dotc = LU_INK;

sc != lv_fsc ? (
  lv_fsc = sc;
  lv_f10 = ui_fitfont(10, 15 * sc);
  lv_f11 = ui_fitfont(11, 16 * sc);
  lv_f12 = ui_fitfont(12, 12 * sc);
  lv_f13 = ui_fitfont(13, 14 * sc);
  lv_f14 = ui_fitfont(14, 27 * sc);
  lv_f6 = ui_fitfont(6, 12 * sc);
);
gfx_setfont(10, "Trebuchet MS", lv_f10, 'b'); gfx_setfont(11, "Trebuchet MS", lv_f11, 'b');
gfx_setfont(12, "Trebuchet MS", lv_f12, 'b'); gfx_setfont(13, "Trebuchet MS", lv_f13, 'b');
gfx_setfont(14, "Trebuchet MS", lv_f14, 'b'); gfx_setfont(6, "Trebuchet MS", lv_f6, 'b');

function lm_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function lm_tc(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lm_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lm_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function lm_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function lm_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function lm_set(idx, v) ( slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); ); );
function lm_rivet(x, y) ( ui_cola(0x000000, 0.35); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x7A6A58); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xC8BCA8); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );
function lm_led(cx, cy, r, lv, col) (
  ui_col(0x1A120A); gfx_circle(cx * sc, cy * sc, (r + 1.5) * sc, 1, 1);
  lv > 0 ? (
    ui_cola(col, 0.25 * lv); gfx_circle(cx * sc, cy * sc, (r + 4.5) * sc, 1, 1);
    ui_col(ui_mix(ui_mix(col, 0x000000, 0.75), col, lv)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1);
    ui_cola(0xFFFFFF, 0.55 * lv); gfx_circle((cx - r * 0.3) * sc, (cy - r * 0.3) * sc, r * 0.32 * sc, 1, 1);
  ) : ( ui_col(ui_mix(col, 0x000000, 0.75)); gfx_circle(cx * sc, cy * sc, r * sc, 1, 1); );
);
function lm_key(x, y, w, h, on, col, s) local(hov, hit, j) (
  hov = lm_in(x - 3, y - 3, w + 6, h + 6); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  j = 0; loop(4, ui_cola(0x000000, 0.13); lm_r(x - 3 + 2 + j * 1.3, y - 3 + 3 + j * 1.6, w + 6 + j * 0.5, h + 6 + j * 0.5); j += 1; );
  ui_col(0x1A120A); lm_r(x - 3, y - 3, w + 6, h + 6);
  on ? (
    ui_cola(col, 0.14); lm_r(x - 7, y - 7, w + 14, h + 14);
    ui_col(ui_mix(col, 0x000000, 0.25)); lm_r(x, y, w, h);
    ui_col(col); lm_r(x + 2, y + 2, w - 4, h - 4);
    ui_cola(0xFFFFFF, 0.30); lm_r(x + 5, y + 4, w - 10, h - 8);
    gfx_setfont(10); ui_col(0x2A1808); lm_tc(x + w / 2, y + h / 2, s);
  ) : (
    ui_col(ui_mix(col, 0x2A2018, 0.72)); lm_r(x, y, w, h);
    ui_col(ui_mix(col, 0x2A2018, 0.62)); lm_r(x + 2, y + 2, w - 4, h - 4);
    ui_cola(0x000000, 0.16); lm_r(x + 2, y + h - 5, w - 4, 3); lm_r(x + w - 5, y + 2, 3, h - 4);
    gfx_setfont(10); ui_col(ui_mix(col, 0xFFFFFF, 0.6)); lm_tc(x + w / 2, y + h / 2, s);
  );
  hov ? ( ui_cola(0xFFFFFF, 0.08); lm_r(x, y, w, h); );
  hit;
);
function lm_knob(cx, cy, r, idx, lo, hi, def, stp, cap, dk) local(v, n, dx, dy, hov, did, i, a, k) (
  did = 5000 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - lu_lt < 0.35 && lu_lid == idx) || (mouse_cap & 4) ? ( lm_set(idx, def); drag_id = -1; lu_lt = 0; ) : (
      drag_id = did; lu_my = mouse_y; lu_dz = 0; lu_lt = time_precise(); lu_lid = idx;
      lu_n = (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    lu_dz += abs(lu_my - mouse_y);
    lu_dz > 3 * sc ? (
      lu_n = min(max(lu_n + (lu_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = lo + lu_n * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
      lm_set(idx, v);
    );
    lu_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = (v - lo) / (hi - lo);
    n = min(max(n + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    v = lo + n * (hi - lo); stp > 0 ? v = lo + floor((v - lo) / stp + 0.5) * stp;
    lm_set(idx, v); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
