desc:Echomax Mini [multi-mode delay] (GFX Lab)
//tags: delay echo tape bucket brigade analog digital ping-pong bbd multi-head
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-input, gfx-lab-output, gfx-lab-lfo, gfx-lab-os, gfx-lab-bypass, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider44:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,3,1{Tape,Bucket,Digital,Echorder}>-Echo type
slider2:1<0,1,1{Off,On}>-Sync to tempo
slider3:375<20,2000,1:log>-Time (ms)
slider4:10<0,15,1{4 bars,2 bars,1 bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-Time (sync)
slider5:40<0,110,1>-Feedback (%)
slider6:45<0,100,1>-Drive (%)
slider7:120<20,1000,1:log>-Lo cut (Hz)
slider8:6000<1000,20000,10:log>-Hi cut (Hz)
slider9:0<0,100,1>-Duck (%)
slider10:0<0,1,1{Off,On}>-Ping-pong
slider11:0<0,1,1{Off,On}>-Freeze
slider12:35<0,100,1>-Wow (%)
slider13:25<0,100,1>-Flutter (%)
slider14:0.3<0.01,2,0.01:log>-Drift speed (Hz)
slider15:35<0,100,1>-Mix (%)
slider16:100<0,100,1>-Width (%)
slider17:0<-24,12,0.1>-Output (dB)
slider18:0<0,100,1>-Band sat (%)
slider19:30<0,100,1>-Bias (%)
slider20:120<40,400,1>-Sat low band (Hz)
slider21:6000<2000,16000,10>-Sat high band (Hz)
slider24:0<-24,12,0.1>-Input trim (dB)
slider25:0<0,1,1{Off,On}>-Input guard
slider26:0<0,3,1{Off,-3 dB,-6 dB,-9 dB}>-Vintage EQ (500 Hz cut)
slider27:50<0,100,1>-Drift (%)
slider28:0<0,1,1{Off,On}>-Dual chip (Echorder)
slider29:8<1,15,1>-Tape heads (bits: 1 = head 1 .. 8 = head 4)
slider30:1<0,1,1{Off,On}>-Echo
slider31:0<0,1,1{Off,On}>-Stretch
slider32:0<0,6,1{0,+12,+7,+5,-5,-7,-12}>-Pitch per repeat (Digital)
slider33:0<0,1,1{Off,On}>-Taps (Digital)
slider34:0<0,1,1{Off,On}>-Lo-fi (Digital)
slider35:0<0,1,1{Off,On}>-BBD noise (Bucket)
slider36:50<0,100,1>-Head spacing (%)
slider37:0<-100,100,1>-Head 1 pan (%)
slider38:0<-100,100,1>-Head 2 pan (%)
slider39:0<-100,100,1>-Head 3 pan (%)
slider40:0<-100,100,1>-Head 4 pan (%)
slider41:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider42:byp=0<0,1,1{Off,On}>-Bypass
slider43:prs_sel=0<0,21,1{No preset,Tape: Worn Tape Echo,Tape: Slapback Sat,Tape: Dub Siren,Bucket: Memory Lane,Bucket: Analogue Crunch,Echorder: Drive,Echorder: Slap & Crunch,Digital: Ducked Vocal,Digital: Crystal Triplet,Tape: Flutter Wash,Echorder: Self-Osc Synth,Echorder: Deep Dub Echo,Echorder: Modern Dub Wash,Echorder: Chaos Dub Grit,Echorder: Heavy Dub Bass,Tape: Multi-Head Rhythm,Tape: Four-Head Swell,Bucket: Hissy Little Echo,Digital: Pattern Taps,Digital: Climbing Fourths,Digital: 12-Bit Lo-Fi}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-lfo.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(17592186044415, v); );
function psw_allg(v) ( slider_show(17592186044415, v); );
#ui_man = "gfx-lab-echomax-mini";
#mx_pm = "Tape: Worn Tape Echo|Tape: Slapback Sat|Tape: Dub Siren|Bucket: Memory Lane|Bucket: Analogue Crunch|Echorder: Drive|Echorder: Slap & Crunch|Digital: Ducked Vocal|Digital: Crystal Triplet|Tape: Flutter Wash|Echorder: Self-Osc Synth|Echorder: Deep Dub Echo|Echorder: Modern Dub Wash|Echorder: Chaos Dub Grit|Echorder: Heavy Dub Bass|Tape: Multi-Head Rhythm|Tape: Four-Head Swell|Bucket: Hissy Little Echo|Digital: Pattern Taps|Digital: Climbing Fourths|Digital: 12-Bit Lo-Fi";
ui_thm = 5; ui_hw = 1;
pk_lcdstrip = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; mg_ed = 0; );
ui_dflt = 1;
rs_f = 1;
ext_noinit = 1;
pwr_init();
pwr_wu_loss = 0.8; pwr_wu_drv = 1; pwr_wu_lp = 9000; pwr_wu_wob = 0.3; pwr_bloom = 0;

VTC = 30000;
COEF = 50000;
TG = 99000;
HS = 99100;
bufL = 100000;
dlen = ceil(4.2 * srate) + 8;
bufR = bufL + dlen;
memset(bufL, 0, dlen * 2);
wp = 0;
PSN = 16384; PSR = bufR + dlen + 64; memset(PSR, 0, 2 * PSN);
TG[0] = 0.30; TG[1] = 0.50; TG[2] = 0.35; TG[3] = 0.65; TG[4] = 0.40; TG[5] = 0.75; TG[6] = 0.50; TG[7] = 1.00;

function ps_run(x, ratio, k) instance(w, ph) local(b, win, d1, d2, q, g1, g2, p, i, f, y) (
  b = PSR + k * PSN; win = min(floor(0.05 * srate), PSN - 8);
  b[w] = x;
  ph += (1 - ratio) / win; ph >= 1 ? ph -= 1; ph < 0 ? ph += 1;
  q = ph >= 0.5 ? ph - 0.5 : ph + 0.5;
  d1 = ph * win + 2; d2 = q * win + 2; g1 = sin(ph * $pi); g2 = sin(q * $pi);
  p = w - d1; p < 0 ? p += PSN; i = floor(p); f = p - i; y = (b[i] * (1 - f) + b[(i + 1) % PSN] * f) * g1 * g1;
  p = w - d2; p < 0 ? p += PSN; i = floor(p); f = p - i; y += (b[i] * (1 - f) + b[(i + 1) % PSN] * f) * g2 * g2;
  w += 1; w >= PSN ? w = 0;
  y;
);
function ps_clr() instance(w, ph) ( w = 0; ph = 0; );

function tanh_(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1) );
function op_sat(x, drv) local(s) (
  s = x * drv;
  s > 0 ? ( s = s / (1 + s * 0.8); ) : ( s = -abs(s) / (1 + abs(s) * 1.6); );
  s / drv;
);
function rdl(buf, d) local(p, i, f, x0, x1, x2, x3) (
  p = wp - d; p < 0 ? p += dlen; i = floor(p); f = p - i;
  x0 = buf[(i - 1 + dlen) % dlen]; x1 = buf[i % dlen]; x2 = buf[(i + 1) % dlen]; x3 = buf[(i + 2) % dlen];
  (((0.5 * (x3 - x0) + 1.5 * (x1 - x2)) * f + (x0 - 2.5 * x1 + 2 * x2 - 0.5 * x3)) * f + 0.5 * (x2 - x0)) * f + x1;
);
function loopproc(x) instance(hz, lz, lz2, bz, lq1, lq2) (
  hz += (x - hz) * lo_c; x -= hz;
  lz += (x - lz) * hi_c; x = lz;
  etype == 0 ? (
    lz2 += (x - lz2) * tape_c; x = lz2;
    x = tanh_(x * drv_s * 1.4) / (drv_s * 0.9);
  ) : etype == 1 ? (
    lz2 += (x - lz2) * bbd_c; bz += (lz2 - bz) * bbd_c; x = bz;
    x = x / (1 + abs(x) * drv_s * 1.5 + 0.12 * x * x);
  ) : etype == 2 ? (
    lofi ? (
      lq1 += (x - lq1) * lf8_c; lq2 += (lq1 - lq2) * lf8_c; x = floor(lq2 * 2048 + 0.5) / 2048;
    );
    x = abs(x) > 1.5 ? tanh_(x / 1.5) * 1.5 : x;
  ) : (
    lz2 += (x - lz2) * ech_c; x = lz2;
    x = op_sat(x, drv_s * 1.8);
  );
  x;
);
function lp_clr() instance(hz, lz, lz2, bz, lq1, lq2) ( hz = lz = lz2 = bz = lq1 = lq2 = 0; );

function vt_bq(t, f, q, gdb) local(w, cw, al, ga, a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); al = sin(w) / (2 * q);
  t == 0 ? (
    a0 = 1 + al; vtp[0] = (1 + cw) * 0.5 / a0; vtp[1] = -(1 + cw) / a0; vtp[2] = vtp[0];
  ) : t == 1 ? (
    a0 = 1 + al; vtp[0] = (1 - cw) * 0.5 / a0; vtp[1] = (1 - cw) / a0; vtp[2] = vtp[0];
  ) : (
    ga = 10 ^ (gdb / 40); a0 = 1 + al / ga;
    vtp[0] = (1 + al * ga) / a0; vtp[1] = -2 * cw / a0; vtp[2] = (1 - al * ga) / a0;
  );
  vtp[3] = -2 * cw / a0; vtp[4] = (1 - (t == 2 ? al / ga : al)) / a0;
);
function vt_set(m) (
  vt_on = m > 0;
  vtp = VTC;      vt_bq(0, 140, 0.7071, 0);
  vtp = VTC + 5;  vt_bq(2, 500, 0.9, -3 * m);
  vtp = VTC + 10; vt_bq(1, 5000, 0.7071, 0);
);
function vt_proc(x) instance(a1, a2, b1, b2, c1, c2) local(y) (
  y = VTC[0] * x + a1; a1 = VTC[1] * x - VTC[3] * y + a2; a2 = VTC[2] * x - VTC[4] * y; x = y;
  y = VTC[5] * x + b1; b1 = VTC[6] * x - VTC[8] * y + b2; b2 = VTC[7] * x - VTC[9] * y; x = y;
  y = VTC[10] * x + c1; c1 = VTC[11] * x - VTC[13] * y + c2; c2 = VTC[12] * x - VTC[14] * y;
  y;
);
function vt_clr() instance(a1, a2, b1, b2, c1, c2) ( a1 = a2 = b1 = b2 = c1 = c2 = 0; );

function fz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
C_F1 = COEF; C_F2 = COEF + 5; C_F3 = COEF + 10; C_F4 = COEF + 15;
function fz_run(x) instance(zA, zB, zC, zD, fh, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = zA.fz_bm(x, C_F1);
  ha = abs(h); fh += (ha - fh) * (ha > fh ? fz_a : fz_r);
  fp += (abs(x) - fp) * fz_w;
  nn = 1 / (max(fh, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (tanh_(2 * u) / 2 - u + 0.4 * u * u) * fh;
  e = zD.fz_bm(zC.fz_bm(zB.fz_bm(e, C_F2), C_F3), C_F4);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? fz_a : fz_r);
  g = fz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function fz_clr() instance(zA, zB, zC, zD, fh, fp, fe) ( zA.fz_bmz(); zB.fz_bmz(); zC.fz_bmz(); zD.fz_bmz(); fh = fp = fe = 0; );

function mx_tick(e, f) instance(lp, fz, ho, fo) (
  ho = fz_o > 0.0001 ? e + fz.fz_run(e) : e;
  fo = frz ? f : lp.loopproc(f) * fbs;
);
function mx_clr() instance(lp, fz) ( lp.lp_clr(); fz.fz_clr(); );
function mx_os(x_el, x_fl, x_er, x_fr) (
  os_f == 1 ? (
    chL.mx_tick(x_el, x_fl); chR.mx_tick(x_er, x_fr);
    hoL = chL.ho; foL = chL.fo; hoR = chR.ho; foR = chR.fo;
  ) : (
    ueL.os_up(x_el); ufL.os_up(x_fl); ueR.os_up(x_er); ufR.os_up(x_fr);
    chL.mx_tick(ueL.s0, ufL.s0); a0 = chL.ho; b0 = chL.fo; chR.mx_tick(ueR.s0, ufR.s0); c0 = chR.ho; d0 = chR.fo;
    chL.mx_tick(ueL.s1, ufL.s1); a1 = chL.ho; b1 = chL.fo; chR.mx_tick(ueR.s1, ufR.s1); c1 = chR.ho; d1 = chR.fo;
    os_f > 2 ? (
      chL.mx_tick(ueL.s2, ufL.s2); a2 = chL.ho; b2 = chL.fo; chR.mx_tick(ueR.s2, ufR.s2); c2 = chR.ho; d2 = chR.fo;
      chL.mx_tick(ueL.s3, ufL.s3); a3 = chL.ho; b3 = chL.fo; chR.mx_tick(ueR.s3, ufR.s3); c3 = chR.ho; d3 = chR.fo;
    );
    hoL = deL.os_dn(a0, a1, a2, a3); foL = dfL.os_dn(b0, b1, b2, b3);
    hoR = deR.os_dn(c0, c1, c2, c3); foR = dfR.os_dn(d0, d1, d2, d3);
  );
);
function mx_osclr() (
  ueL.os_clr(); ufL.os_clr(); ueR.os_clr(); ufR.os_clr(); deL.os_clr(); dfL.os_clr(); deR.os_clr(); dfR.os_clr();
);
function mx_coef() (
  ef_fs = srate * os_f;
  lo_c = 1 - exp(-2 * $pi * slider7 / ef_fs);
  hi_c = 1 - exp(-2 * $pi * min(slider8, srate * 0.45) / ef_fs);
  tape_c = 1 - exp(-2 * $pi * 5500 / ef_fs);
  bbd_c  = 1 - exp(-2 * $pi * 2800 / ef_fs);
  ech_c  = 1 - exp(-2 * $pi * 3200 / ef_fs);
  lf8_c = 1 - exp(-2 * $pi * min(8000, 0.45 * srate) / ef_fs);
  fz_bqc(C_F1, 4, 3500, 0, 0.7071, ef_fs); fz_bqc(C_F2, 4, 5500, 0, 0.7071, ef_fs);
  fz_bqc(C_F3, 0, 8000, 4, 0.7, ef_fs); fz_bqc(C_F4, 2, 12000, -6, 0.7, ef_fs);
  fz_a = 1 - exp(-1 / (0.003 * ef_fs)); fz_r = 1 - exp(-1 / (0.12 * ef_fs)); fz_w = 1 - exp(-1 / (0.06 * ef_fs));
);

function update() local(q, k, e, hm) (
  etype_t = slider1; ping_t = slider10; vt_t = slider26;
  taps_t = slider33 >= 0.5; lofi_t = slider34 >= 0.5; bnoise_t = slider35 >= 0.5; dual_t = slider28 >= 0.5;
  q = slider32 | 0; pitch_t = 2 ^ ((q == 1 ? 12 : q == 2 ? 7 : q == 3 ? 5 : q == 4 ? -5 : q == 5 ? -7 : q == 6 ? -12 : 0) / 12);
  qd_st == 0 && (etype_t != etype || ping_t != ping || vt_t != vt_m || taps_t != taps || lofi_t != lofi || pitch_t != pitch_r
    || dual_t != dual_chip || bnoise_t != bnoise) ? qd_st = 1;
  sync = slider2;
  q = lfo_div_q(slider4);
  t_ms = sync ? q * 60000 / max(tempo, 20) : slider3;
  t_ms = min(max(t_ms, 1), 4000);
  fb = min(slider5 / 100, 1.15);
  drv_g = 1 + 4.5 * (slider6 / 100); drv_pc = slider6;
  mx_coef();
  duck = slider9 / 100;
  frz = slider11 >= 0.5;
  drift_macro(slider27);
  wow = slider12 / 100 * dm_a; flt = slider13 / 100 * dm_a; dspd = slider14 * dm_s;
  mix_t = slider15 / 100; wid = slider16 / 100;
  out_t = 10 ^ (slider17 / 20);
  echo_t = slider30 >= 0.5;
  str_t = slider31 >= 0.5 ? 2 : 1;
  hm = slider29 | 0; hm < 1 || hm > 15 ? hm = 8; hmask = hm;
  e = 2 ^ ((slider36 - 50) / 25);
  k = 0; loop(4,
    HS[16 + k] = (hm & (1 << k)) ? 1 : 0;
    HS[20 + k] = ((k + 1) / 4) ^ e;
    HS[24 + k] = slider(37 + k) / 100;
    k += 1; );
  t_glide = 1 - exp(-1 / ((etype_t == 0 ? 0.35 : etype_t == 1 ? 0.12 : etype_t == 3 ? 0.18 : 0.03) * srate));
  in_setup(slider24, slider25);
  fz_t = etype_t == 2 ? 0 : 0.33 * min(max((slider6 - 50) / 50, 0), 1);
);

in_init();
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
os_design(); os_base = 0;
os_f = os_tf = os_f2n(os_sel); os_gsetup(); pdc_delay = 0;
sm  = 1 - exp(-1 / (0.03 * srate));
vuc = 1 - exp(-1 / (0.01 * srate));
dk_a = 1 - exp(-1 / (0.005 * srate)); dk_r = 1 - exp(-1 / (0.25 * srate));
drW.drift_init(0.8 + rand(1) * 0.5);
drF.drift_init(0.8 + rand(1) * 0.5);
denv = 0; fph = 0; cph = 0; cph2 = 0;
str_s = 1; str_c = 1 - exp(-1 / (0.4 * srate));
egc = 1 / (0.01 * srate);
c_sw = 1 - exp(-1 / (0.005 * srate));
qd_st = 0; qd_g = 1; qd_clr = 0; qd_k = 1 / (0.012 * srate);
etype = slider1; ping = slider10; vt_m = slider26; vt_set(vt_m);
update();
etype = etype_t; ping = ping_t; taps = taps_t; lofi = lofi_t; pitch_r = pitch_t; dual_chip = dual_t; bnoise = bnoise_t;
mx_k = 0; loop(12, HS[mx_k] = HS[16 + mx_k]; mx_k += 1; );
t_s = t_ms * 0.001 * srate; mx_t_d = t_ms;
mix_s = mix_t; out_s = out_t; eg = echo_t; fbs = fb; drv_s = drv_g; dks = duck; wds = wid; wws = wow; fls = flt; fz_o = fz_t;

function q_dip() (
  qd_st == 1 ? (
    qd_g -= qd_k;
    qd_g <= 0 ? (
      qd_g = 0; etype = etype_t; ping = ping_t; taps = taps_t; lofi = lofi_t; dual_chip = dual_t; bnoise = bnoise_t;
      pitch_r != pitch_t ? ( pitch_r = pitch_t; pshL.ps_clr(); pshR.ps_clr(); memset(PSR, 0, 2 * PSN); );
      vt_t != vt_m ? ( vt_m = vt_t; vt_set(vt_m); );
      qd_clr ? (
        memset(bufL, 0, dlen * 2); memset(PSR, 0, 2 * PSN); chL.mx_clr(); chR.mx_clr(); vtL.vt_clr(); vtR.vt_clr();
        t_s = t_ms * 0.001 * srate * str_s; qd_clr = 0;
        mx_k = 0; loop(12, HS[mx_k] = HS[16 + mx_k]; mx_k += 1; );
      );
      qd_st = 2;
    );
  ) : qd_st == 2 ? ( qd_g += qd_k; qd_g >= 1 ? ( qd_g = 1; qd_st = 0; ); );
);

function setp(m, sy, tm, dv, f, drp, lc, hc, dk, pp, w, flp, mx, dft) (
  slider1 = m; slider2 = sy; slider3 = tm; slider4 = dv; slider5 = f; slider6 = drp; slider7 = lc; slider8 = hc;
  slider9 = dk; slider10 = pp; slider12 = w; slider13 = flp; slider15 = mx; slider27 = dft; slider11 = 0;
  slider29 = 8; slider30 = 1; slider31 = 0; slider32 = 0; slider33 = 0; slider34 = 0; slider35 = 0;
  slider28 = 0; slider36 = 50; slider37 = slider38 = slider39 = slider40 = 0;
);
function load_preset(p) (
  qd_st = 1; qd_clr = 1;
  p == 1  ? setp(0, 1, 375, 10, 50, 50, 120, 6000, 0,  0, 45, 30, 40, 70) :
  p == 2  ? setp(0, 0, 110, 10, 30, 60, 150, 5000, 0,  0, 25, 20, 35, 50) :
  p == 3  ? setp(0, 1, 500, 6,  85, 75, 200, 3500, 0,  0, 60, 40, 45, 85) :
  p == 4  ? setp(1, 1, 375, 9,  55, 40, 100, 3000, 20, 1, 20, 15, 35, 40) :
  p == 5  ? setp(1, 0, 180, 10, 65, 70, 120, 2500, 0,  0, 35, 25, 45, 60) :
  p == 6  ? setp(3, 0, 280, 10, 70, 80, 140, 3200, 0,  0, 25, 15, 45, 50) :
  p == 7  ? setp(3, 0, 85,  10, 80, 95, 180, 2800, 0,  0, 10, 10, 50, 30) :
  p == 8  ? setp(2, 1, 375, 6,  35, 0,  80, 16000, 50, 0, 0,  0,  30, 0)  :
  p == 9  ? setp(2, 1, 375, 11, 40, 0,  100, 18000, 0, 1, 0,  0,  35, 0)  :
  p == 10 ? setp(0, 0, 1200, 10, 75, 55, 250, 4000, 40, 0, 50, 30, 50, 75) :
  p == 11 ? setp(3, 1, 375, 10, 102, 85, 150, 3000, 0, 0, 30, 20, 55, 60) :
  p == 12 ? ( setp(3, 0, 380, 10, 55, 45, 140, 2200, 0, 0, 20, 15, 45, 50); ) :
  p == 13 ? ( setp(3, 0, 300, 10, 65, 35, 140, 3200, 0, 0, 40, 10, 40, 35); slider28 = 1; ) :
  p == 14 ? ( setp(3, 0, 220, 10, 85, 70, 160, 1800, 0, 0, 15, 30, 55, 75); ) :
  p == 15 ? ( setp(3, 0, 450, 10, 60, 50, 120, 2000, 0, 0, 45, 15, 50, 45); slider28 = 1; ) :
  p == 16 ? ( setp(0, 1, 500, 6, 55, 55, 120, 5000, 0, 0, 30, 20, 40, 60); slider29 = 13;
              slider36 = 62; slider37 = -55; slider39 = 55; ) :
  p == 17 ? ( setp(0, 1, 750, 3, 92, 60, 160, 3800, 0, 0, 45, 25, 45, 70); slider29 = 15;
              slider36 = 40; slider37 = -60; slider38 = 60; slider39 = -30; slider40 = 30; ) :
  p == 18 ? ( setp(1, 0, 260, 10, 50, 55, 150, 3200, 0, 0, 25, 15, 40, 55); slider35 = 1; ) :
  p == 19 ? ( setp(2, 1, 500, 6, 45, 0, 100, 16000, 20, 0, 0, 0, 35, 0); slider33 = 1; ) :
  p == 20 ? ( setp(2, 1, 375, 9, 60, 0, 150, 12000, 0, 1, 0, 0, 35, 0); slider32 = 3; ) :
  p == 21 ? ( setp(2, 0, 240, 10, 55, 0, 200, 9000, 0, 0, 0, 0, 40, 0); slider34 = 1; ) :
  p == 22 ? (
    setp(0, 1, 375, 10, 40, 45, 120, 6000, 0, 0, 35, 25, 35, 50);
    slider14 = 0.3; slider16 = 100; slider17 = 0;
    slider18 = 0; slider19 = 30; slider20 = 120; slider21 = 6000;
    slider24 = 0; slider25 = 0; slider26 = 0;
  );
  slider_automate(1099511627775);
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(42, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 21 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ) : prs_cur_d = -1;
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(21, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();
!mx_in ? (
  etype = etype_t; ping = ping_t; taps = taps_t; lofi = lofi_t; pitch_r = pitch_t; dual_chip = dual_t; bnoise = bnoise_t;
  vt_m = vt_t; vt_set(vt_m); qd_st = 0; qd_g = 1; mx_in = 1;
  mx_k = 0; loop(12, HS[mx_k] = HS[16 + mx_k]; mx_k += 1; );
  t_s = t_ms * 0.001 * srate;
);
ost_setup(slider18 / 100, slider19 / 100, slider20, slider21, -0.3, 1);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? (
  rs_f = 0; rs_c = 1 / (0.015 * srate);
  memset(bufL, 0, dlen * 2); memset(PSR, 0, 2 * PSN); chL.mx_clr(); chR.mx_clr(); mx_osclr(); vtL.vt_clr(); vtR.vt_clr();
);
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pwr_block(!byp);
update();
ost_setup(slider18 / 100, slider19 / 100, slider20, slider21, -0.3, 1);
os_tf = os_f2n(os_sel);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
dinc = dspd * samplesblock / srate;
vW = drW.drift_tick(dinc); vF = drF.drift_tick(dinc * 3);
mx_vu_d = max(mx_vu_d, sqrt(mx_ms / max(samplesblock, 1))); mx_ms = 0; mx_pk_d = max(mx_pk_d, mx_pkm); mx_pkm = 0;
mx_t_d = t_ms;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, mg_ed);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
rw_l = spl0; rw_r = spl1;
os_gate();
os_chg ? ( mx_osclr(); chL.fz.fz_clr(); chR.fz.fz_clr(); mx_coef(); pdc_delay = 0; );
q_dip();
in_process(spl0, spl1);
pwr_in(in_l, in_r); inL = pwr_l; inR = pwr_r;
mix_s += (mix_t - mix_s) * sm; out_s += (out_t - out_s) * sm; fbs += (fb - fbs) * sm; drv_s += (drv_g - drv_s) * sm;
dks += (duck - dks) * sm; wds += (wid - wds) * sm; wws += (wow - wws) * sm; fls += (flt - fls) * sm; fz_o += (fz_t - fz_o) * sm;
mx_k = 0; loop(12, HS[mx_k] += (HS[16 + mx_k] - HS[mx_k]) * sm; mx_k += 1; );

str_s += (str_t - str_s) * str_c;
t_s += (t_ms * 0.001 * srate * str_s - t_s) * t_glide;
eg = echo_t ? min(eg + egc, 1) : max(eg - egc, 0);
fph += (6.5 + 1.5 * vF) / srate; fph >= 1 ? fph -= 1;
cph += 0.6 / srate; cph >= 1 ? cph -= 1;
cph2 += 0.6 / srate * 1.37; cph2 >= 1 ? cph2 -= 1;

mod = (wws * 0.0025 * vW + fls * 0.00022 * sin(2 * $pi * fph)) * srate;
etype == 1 ? mod += 0.0006 * srate * sin(2 * $pi * cph);
etype == 3 ? mod += 0.0012 * srate * sin(2 * $pi * cph * 0.5);
dc_on = etype == 3 && dual_chip;
wid_mul = dc_on ? 0.05 : (etype == 3 ? 0.015 : 0.03);
modR = mod + (dc_on ? 0.0022 * srate * sin(2 * $pi * cph2) : 0);
dL = min(max(t_s + mod, 3), dlen - 4);
dR = ping ? dL : min(max(t_s * (1 + wid_mul * wds) + modR, 3), dlen - 4);

lat = os_lat(os_f);
etype == 0 ? (
  hn = 0; eL = eR = fsL = fsR = 0; mx_k = 0;
  loop(4,
    g_ = HS[mx_k];
    g_ > 0.00001 ? (
      a_ = rdl(bufL, max(dL * HS[4 + mx_k] - lat, 3)); b_ = rdl(bufR, max(dR * HS[4 + mx_k] - lat, 3));
      fsL += g_ * a_; fsR += g_ * b_; hn += g_;
      p_ = HS[8 + mx_k]; pp_ = max(p_, 0); pn_ = max(-p_, 0);
      eL += g_ * (a_ * (1 - pp_) + b_ * pn_); eR += g_ * (b_ * (1 - pn_) + a_ * pp_);
    );
    mx_k += 1; );
  hn = max(hn, 0.0001);
  eL /= sqrt(hn); eR /= sqrt(hn); fsL /= hn; fsR /= hn;
) : etype == 2 && taps ? (
  fsL = rdl(bufL, max(dL - lat, 3)); fsR = rdl(bufR, max(dR - lat, 3));
  eL = eR = 0; mx_k = 1;
  loop(8,
    a_ = rdl(bufL, max(dL * mx_k * 0.125 - lat, 3)); b_ = rdl(bufR, max(dR * mx_k * 0.125 - lat, 3));
    eL += TG[mx_k - 1] * a_ * ((mx_k & 1) ? 1 : 1 - 0.7 * wds); eR += TG[mx_k - 1] * b_ * ((mx_k & 1) ? 1 - 0.7 * wds : 1);
    mx_k += 1;
  );
  eL *= 0.45; eR *= 0.45;
) : (
  eL = rdl(bufL, max(dL - lat, 3)); eR = rdl(bufR, max(dR - lat, 3));
  fsL = eL; fsR = eR;
);
etype == 3 || (etype == 1 && bnoise) ? (
  noise = (rand(2) - 1) * (etype == 1 ? 0.0006 : 0.0004 * (1 + drv_pc / 50));
  eL += noise; eR += noise; fsL += noise; fsR += noise;
);
mx_os(eL, fsL, eR, fsR);
eL = hoL; eR = hoR;
frz ? (
  bufL[wp] = ping ? foR : foL; bufR[wp] = ping ? foL : foR;
) : (
  etype == 2 && pitch_r != 1 ? ( foL = pshL.ps_run(foL, pitch_r, 0); foR = pshR.ps_run(foR, pitch_r, 1); );
  ping ? (
    bufL[wp] = 0.5 * (inL + inR) * eg + foR;
    bufR[wp] = foL;
  ) : (
    bufL[wp] = inL * eg + foL;
    bufR[wp] = inR * eg + foR;
  );
);
wp += 1; wp >= dlen ? wp = 0;

lvl = max(abs(inL), abs(inR));
denv += (lvl - denv) * (lvl > denv ? dk_a : dk_r);
dg = (1 - dks * min(denv * 4, 1)) * qd_g;
vt_on ? ( eL = vtL.vt_proc(eL); eR = vtR.vt_proc(eR); );
em = 0.5 * (eL + eR); es = 0.5 * (eL - eR) * wds;
wL = (em + es) * dg; wR = (em - es) * dg;
dry_g = min(2 * (1 - mix_s), 1); wet_g = min(2 * mix_s, 1);
oL = inL * dry_g + wL * wet_g;
oR = inR * dry_g + wR * wet_g;
pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
oL = ostL.ost_band(oL * out_s * in_comp * os_g); oR = ostR.ost_band(oR * out_s * in_comp * os_g);
ost_out(oL, oR); oL = ost_l; oR = ost_r;
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( oL += (rw_l - oL) * by_s; oR += (rw_r - oR) * by_s; );
mx_ms += 0.5 * (oL * oL + oR * oR); mx_pkm = max(mx_pkm, max(abs(oL), abs(oR)));
spl0 = oL; spl1 = oR;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  spl0 = rw_l + (spl0 - rw_l) * rs_s; spl1 = rw_r + (spl1 - rw_r) * rs_s;
);

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x49796B; mk_band = 0x1A0705; mk_ink = 0xF7EEDF; mk_tab = 0xF2EAD3; mk_acc = 0xE8402A;
mk_sub = 0x2E4D44; mk_ink2 = 0xE6C9BC;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0xF4F6F8); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0x1A1A1C); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(0x1A1A1C); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_well(x, y, w, h) ( ui_cola(0x000000, 0.18); mg_r(x, y, w, h); ui_cola(0x000000, 0.12); mg_r(x, y, w, 2); mg_r(x, y + 2, 2, h - 2); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, i, t) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KRD * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KRD * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KRD * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KRD * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.72);
  ) : sty == 2 ? (
    ui_col(0xA9ACAF); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0xF1F0EC); gfx_circle(KX, KY, KRD * 0.92, 1, 1);
    i = 0; loop(6, ui_cola(0x000000, 0.12 * (1 - i / 6)); gfx_circle(KX, KY, KRD * 0.92 - i * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.9 : 0.8); ui_ssarc(KX, KY, KRD * 0.8, -2.5 + 0.5 * $pi, -1.4 + 0.5 * $pi, 1 * sc);
    ui_col(0x26282C); ui_kdot(KX, KY, a, KRD * 0.92);
  ) : (
    ui_col(0x2C2E33); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0x121315); gfx_circle(KX, KY, KRD * 0.8, 1, 1);
    ui_col(ui_mix(0x2C2E33, 0x000000, 0.25)); gfx_circle(KX, KY, KRD * 0.68, 1, 1);
    ui_cola(0xFFFFFF, act ? 0.22 : 0.12); ui_ssarc(KX, KY, KRD * 0.95, -2.6 + 0.5 * $pi, -1.0 + 0.5 * $pi, 1 * sc);
    ui_col(0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.68);
  );
);
function mg_dots(x, y, r, c) local(i, t, rs, px, py, n) (
  rs = r + 8; i = 0; n = mg_nst > 0 && mg_nst <= 8 ? mg_nst - 1 : 4;
  loop(n + 1, t = -0.75 * $pi + i / n * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_wdial && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); ui_col(c);
      mg_ctxt(px + (i == 0 ? -3 : i == 4 ? 3 : 0), py + (i == 2 ? -2 : 0), i == 0 ? "M" : i == 2 ? "C" : "S"); )
    : mg_zero && i == 2 ? ( gfx_setfont(11); ui_col(c); mg_ctxt(px, py - 2, "0"); )
    : i == 0 || i == n ? ( ui_col(c); mg_disc(px, py, 1.8); );
    i += 1; );
);
function mg_v2n(v, lo, hi, lg) ( lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi, lg) ( lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col) local(v, n, dx, dy, hov, did, act, a) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
