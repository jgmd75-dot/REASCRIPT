function g_lift(x) local(s, y) (
  s = abs(x);
  s <= 1 ? ( y = s * (gA + s * (gB + s * gC)) - gD * s * s * (1 - 2 * s + s * s); ) :
  clip   ? ( y = 1; ) :
  s < 2  ? ( y = 2 * s - s * s; ) :
           ( y = 0; );
  x < 0 ? -y : y;
);
function g_curve(x0, y0, w, h, e, gcp, c) local(j, s, yv, gx, gy, lx, ly) (
  gA = 1.5 + gcp;  gB = -2 * gcp;  gC = gcp - 0.5;  gD = 0.0625 - 0.25 * gcp + 0.25 * gcp * gcp;
  ui_col(c); j = 0;
  loop(81,
    s = 1.25 * j / 80;
    yv = s + e * (g_lift(s) - s);
    gx = (x0 + w * j / 80) * sc;
    gy = (y0 + h - h * min(1.25, max(0, yv)) / 1.25) * sc;
