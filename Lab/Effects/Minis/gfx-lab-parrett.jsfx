desc:Parrett [mastering EQ] (GFX Lab)
//tags: mastering eq equaliser passive valve transistor mid side
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-amp, gfx-lab-os, gfx-lab-bypass, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider29:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider3:dlt=0<0,1,1{Off,On}>-Delta
slider4:trm=0<-12,12,0.1>-Trim (dB)
slider5:amp=50<0,100,1>-Amp, solid to valve (%)
slider6:psh=0<0,1,1{Off,On}>-Push
slider7:outg=0<-12,12,0.1>-Output (dB)
slider8:hpf=0<0,11,1{Off,11 Hz,22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz,220 Hz}>-High-pass
slider9:lpf=9<0,9,1{3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz,Off}>-Low-pass
slider10:b1g=0<-12,12,0.1>-Low gain (dB)
slider11:b1f=3<0,10,1{22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,110 Hz,220 Hz,330 Hz,440 Hz}>-Low frequency
slider12:b1s=50<0,100,1>-Low Q, broad to tight (%)
slider13:b1h=1<0,1,1{Bell,Shelf}>-Low type
slider14:b1p=0<0,2,1{Stereo,Mid,Side}>-Low place
slider15:b2g=0<-12,12,0.1>-Low mid gain (dB)
slider16:b2f=2<0,10,1{110 Hz,220 Hz,330 Hz,440 Hz,550 Hz,660 Hz,770 Hz,880 Hz,990 Hz,1.1 kHz,2.2 kHz}>-Low mid frequency
slider17:b2s=50<0,100,1>-Low mid Q, broad to tight (%)
slider18:b2p=0<0,2,1{Stereo,Mid,Side}>-Low mid place
slider19:b3g=0<-12,12,0.1>-High mid gain (dB)
slider20:b3f=7<0,10,1{550 Hz,660 Hz,770 Hz,880 Hz,990 Hz,1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz}>-High mid frequency
slider21:b3s=50<0,100,1>-High mid Q, broad to tight (%)
slider22:b3p=0<0,2,1{Stereo,Mid,Side}>-High mid place
slider23:b4g=0<-12,12,0.1>-High gain (dB)
slider24:b4f=8<0,9,1{2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz}>-High frequency
slider25:b4s=50<0,100,1>-High Q, broad to tight (%)
slider26:b4h=1<0,1,1{Bell,Shelf}>-High type
slider27:b4p=0<0,2,1{Stereo,Mid,Side}>-High place
slider30:kgn=0<0,1,1{Off,On}>-Auto gain
slider28:prs_sel=0<0,11,1{No preset,Init,Master Sheen,Weight,Air Lift,Forward Vocal,Clear the Mud,Side Air,Tight Centre,Glass Glow,Solid Punch,Tame the Top}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-amp.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(1073741823, v); );
function psw_allg(v) ( slider_show(1073741823, v); );
#ui_man = "gfx-lab-parrett";
ext_noinit = 1;

FQT = 102000; BIX = 102100;
function pt_t11(p, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) (
  p[0] = a0; p[1] = a1; p[2] = a2; p[3] = a3; p[4] = a4; p[5] = a5; p[6] = a6; p[7] = a7; p[8] = a8; p[9] = a9; p[10] = a10;
);
pt_t11(FQT,       22,   33,   44,   55,   66,   77,   88,  110,   220,   330,  440);
pt_t11(FQT + 12, 110,  220,  330,  440,  550,  660,  770,  880,   990,  1100, 2200);
pt_t11(FQT + 24, 550,  660,  770,  880,  990, 1100, 2200, 3300,  4400,  5500, 6600);
pt_t11(FQT + 36, 2200, 3300, 4400, 5500, 6600, 7700, 8800, 9900, 11000, 22000, 22000);
pt_t11(FQT + 48, 0, 11, 22, 33, 44, 55, 66, 77, 88, 99, 110); FQT[59] = 220;
pt_t11(FQT + 60, 3300, 4400, 5500, 6600, 7700, 8800, 9900, 11000, 22000, 0, 0);
pt_t11(BIX,      10, 11, 12, 13, 14, 15, 16, 17, 18, -1, 19);
pt_t11(BIX + 11, 20, 21, 22, -1, 23, 24, 25, 26, 27, 0, 0);
function pt_nst(b) ( b == 3 ? 10 : 11; );

function pt_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

PTB = 100000; PTS = 24;
PTF = 101000; PTFS = 12;

function pt_btick(p, b) local(f, g, k, a, sh) (
  p[18] = p[17] == p[16];
  p[11] < 0.0005 && p[17] != p[16] ? (
    p[16] = p[17]; p[0] = p[1] = 0; p[8] = p[12]; p[9] = p[13]; p[10] = p[14];
  );
  p[11] < 0.0005 && p[15] < 0.5 ? ( p[8] = p[12]; p[9] = p[13]; p[10] = p[14]; );
  p[8] += pt_kc * (p[12] - p[8]); p[9] += pt_kc * (p[13] - p[9]); p[10] += pt_kc * (p[14] - p[10]);
  f = min(2 ^ p[8], pt_fmax); g = tan($pi * f / srate);
  a = exp(abs(p[9]) * 0.05756462732485114);
  p[19] = p[9] < 0;
  sh = p[16] ? (b == 0 ? 1 : 2) : 0;
  sh == 0 ? ( k = 1 / (p[10] * a); p[5] = 0; p[6] = k * (a * a - 1); p[7] = 0; ) :
  sh == 1 ? ( g /= sqrt(a); k = 1 / p[10]; p[5] = 0; p[6] = k * (a - 1); p[7] = a * a - 1; ) :
            ( g *= sqrt(a); k = 1 / p[10]; p[5] = a * a - 1; p[6] = k * (1 - a) * a; p[7] = 1 - a * a; );
  p[2] = 1 / (1 + g * (g + k)); p[3] = g * p[2]; p[4] = g * p[3];
);
function pt_eq(u, c) local(p, v1, v2, v3, fb, sa, sb, d, y) (
  p = PTB + c * 4 * PTS; fb = sa = sb = 0;
  loop(4,
    p[11] += pt_kw * (p[15] * p[18] - p[11]);
    !p[19] ? (
      v3 = u - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
      p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
      fb += p[11] * (p[5] * u + p[6] * v1 + p[7] * v2);
    ) : (
      v1 = p[2] * p[0] - p[3] * p[1]; d = p[1] + p[3] * p[0] - p[4] * p[1];
      sa += p[11] * (p[6] * v1 + p[7] * d);
      sb += p[11] * (p[5] + p[6] * p[3] + p[7] * p[4]);
    );
    p += PTS;
  );
  y = (u + fb - sa) / (1 + sb);
  p = PTB + c * 4 * PTS;
  loop(4,
    p[19] ? (
      v3 = y - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
      p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
    );
    p += PTS;
  );
  y;
);

function pt_ftick(p) local(g) (
  p[4] < 0.0005 ? p[2] = p[3];
  p[2] += pt_kc * (p[3] - p[2]);
  g = tan($pi * min(2 ^ p[2], pt_fmax) / srate);
  p[9] = 1 / 0.62; p[5] = 1 / (1 + g * (g + p[9])); p[6] = g * p[5]; p[7] = g * p[6];
);
function pt_flt(x, p, hp) local(v1, v2, v3, y) (
  p[4] += pt_ks * (p[8] - p[4]);
  v3 = x - p[1]; v1 = p[5] * p[0] + p[6] * v3; v2 = p[1] + p[6] * p[0] + p[7] * v3;
  p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
  y = hp ? x - p[9] * v1 - v2 : v2;
  x + p[4] * (y - x);
);
function pt_clr() local(i) (
  i = 0; loop(8, PTB[i * PTS] = PTB[i * PTS + 1] = 0; i += 1; );
  i = 0; loop(4, PTF[i * PTFS] = PTF[i * PTFS + 1] = 0; i += 1; );
);
function pt_dn() local(i, p) (
  i = 0; loop(8, p = PTB + i * PTS; p[0] = pt_tn(p[0]); p[1] = pt_tn(p[1]); i += 1; );
  i = 0; loop(4, p = PTF + i * PTFS; p[0] = pt_tn(p[0]); p[1] = pt_tn(p[1]); i += 1; );
);

function pt_targets() local(c, b, p, o, i, g, s, sh, pl, qb, qt) (
  b = 0;
  loop(4,
    o = BIX + b * 5;
    g = floor(min(max(slider(o[0]), -12), 12) * 10 + 0.5) / 10;
    i = floor(min(max(slider(o[1]), 0), pt_nst(b) - 1) + 0.5);
    s = min(max(slider(o[2]), 0), 100) / 100;
    sh = b == 0 || b == 3 ? slider(o[3]) >= 0.5 : 0;
    pl = floor(min(max(slider(b == 0 || b == 3 ? o[4] : o[3]), 0), 2) + 0.5);
    sh ? ( qb = 0.5; qt = 0.75 + 0.03 * abs(g); ) : ( qb = 0.42 + 0.01 * abs(g); qt = 0.75 + 0.1 * abs(g); );
    c = 0;
    loop(2,
      p = PTB + (c * 4 + b) * PTS;
      p[15] = 1;
      p[17] = sh;
      p[12] = log(FQT[b * 12 + i]) / log(2);
      p[13] = (pl == 0 || (pl == 1 && c == 0) || (pl == 2 && c == 1)) ? g : 0;
      p[14] = qb * exp(s * log(qt / qb));
      c += 1;
    );
    b += 1;
  );
  i = floor(min(max(hpf, 0), 11) + 0.5);
  c = 0; loop(2, p = PTF + c * 2 * PTFS; i > 0 ? p[3] = log(FQT[48 + i]) / log(2); p[8] = i > 0; c += 1; );
  i = floor(min(max(lpf, 0), 9) + 0.5);
  c = 0; loop(2, p = PTF + (c * 2 + 1) * PTFS; i < 9 ? p[3] = log(FQT[60 + i]) / log(2); p[8] = i < 9; c += 1; );
  pt_tgt = exp(min(max(trm, -12), 12) * 0.11512925464970228);
  pt_ogt = exp(min(max(outg, -12), 12) * 0.11512925464970228);
  pt_amt = min(max(amp, 0), 100) / 100;
  pt_dmt = dlt >= 0.5;
  pt_pst = psh >= 0.5;
  pt_kgo = kgn >= 0.5;
);
function pt_resp(c) local(b, p, i, f, fc, a, k, w, dr, di, dd, lr, li, br, bi, tr, ti, nbr, nbi, ncr, nci, sum) (
  sum = 0; i = 0;
  loop(24,
    f = 30 * exp(i / 23 * log(16000 / 30));
    nbr = ncr = 1; nbi = nci = 0;
    b = 0; p = PTB + c * 4 * PTS;
    loop(4,
      p[13] != 0 ? (
        a = exp(abs(p[13]) * 0.05756462732485114); fc = 2 ^ p[12];
        fc = p[17] ? (b == 0 ? fc / sqrt(a) : fc * sqrt(a)) : fc;
        k = p[17] ? 1 / p[14] : 1 / (p[14] * a);
        w = f / fc; dr = 1 - w * w; di = k * w; dd = dr * dr + di * di;
        lr = dr / dd; li = -di / dd; br = w * di / dd; bi = w * dr / dd;
        !p[17] ? ( tr = k * (a * a - 1) * br; ti = k * (a * a - 1) * bi; ) :
        b == 0 ? ( tr = k * (a - 1) * br + (a * a - 1) * lr; ti = k * (a - 1) * bi + (a * a - 1) * li; ) :
                 ( tr = (a * a - 1) + k * (1 - a) * a * br + (1 - a * a) * lr; ti = k * (1 - a) * a * bi + (1 - a * a) * li; );
        p[13] > 0 ? ( nbr += tr; nbi += ti; ) : ( ncr += tr; nci += ti; );
      );
      b += 1; p += PTS;
    );
    sum += (nbr * nbr + nbi * nbi) / max(ncr * ncr + nci * nci, 0.0000001);
    i += 1;
  );
  sum / 24;
);
function pt_kgain() local(h, i, p) (
  h = 0; i = 0; loop(8, p = PTB + i * PTS; h += p[12] * (1 + i * 0.37) + p[13] * (3 + i * 0.71) + p[14] * (5 + i * 1.3) + p[17] * (7 + i); i += 1; );
  h != pt_kh ? (
    pt_kh = h;
    pt_kdb = -10 * log10(max(0.8 * pt_resp(0) + 0.2 * pt_resp(1), 0.000001));
  );
  pt_kgt = pt_kgo ? exp(pt_kdb * 0.11512925464970228) : 1;
);
function pt_snapall() local(i, p) (
  i = 0; loop(8, p = PTB + i * PTS; p[8] = p[12]; p[9] = p[13]; p[10] = p[14]; p[16] = p[17]; p[18] = 1; p[11] = p[15];
    pt_btick(p, i & 3); i += 1; );
  i = 0; loop(4, p = PTF + i * PTFS; p[2] = p[3]; p[4] = p[8]; pt_ftick(p); i += 1; );
  pt_kgain(); pt_kg = pt_kgt; pt_tg = pt_tgt; pt_og = pt_ogt; pt_am = pt_amt; pt_dm = pt_dmt; pt_ps = pt_pst;
);

function pt_sat(x) instance(lo, vl, hl) local(s, v, h) (
  s = this.ts.am_tube(x * pt_sdv, 0.2) * pt_isdv;
  lo += pt_klo * (s - lo);
  s = s - lo + this.ti.am_tube(lo * pt_sdi, 0.04) * pt_isdi;
  v = this.vt.am_tube(x * pt_vdv, 0.25) * pt_ivdv;
  hl += pt_khs * (v - hl); h = v - hl;
  v += 0.125 * (this.vs.am_tube(h * 2.5, 0.5) * 0.4 - h);
  vl += pt_klo * (v - vl);
  v = v - vl + this.vi.am_tube(vl * pt_vdi, 0.06) * pt_ivdi;
  s + pt_am * (v - s);
);
function pt_osclr() (
  upA.os_clr(); upB.os_clr(); dnA.os_clr(); dnB.os_clr();
  saA.lo = saB.lo = saA.vl = saB.vl = saA.hl = saB.hl = 0;
  pt_klo = 1 - exp(-2 * $pi * 120 / (srate * os_f));
  pt_khs = 1 - exp(-2 * $pi * 1800 / (srate * os_f));
);
function pt_reset() (
  pt_clr(); pt_osclr(); memset(BY_BUF, 0, 2 * BY_N);
  pt_dxl = pt_dyl = pt_dxr = pt_dyr = 0;
  pt_fi = 0;
);

#pt_pm = "Init|Master Sheen|Weight|Air Lift|Forward Vocal|Clear the Mud|Side Air|Tight Centre|Glass Glow|Solid Punch|Tame the Top";
function pt_pb(b, g, f, s, sh, pl) local(o) (
  o = BIX + b * 5;
  slider(o[0]) = g; slider(o[1]) = f; slider(o[2]) = s;
  b == 0 || b == 3 ? ( slider(o[3]) = sh; slider(o[4]) = pl; ) : slider(o[3]) = pl;
);
function load_preset(p) local(i) (
  pt_pb(0, 0, 3, 50, 1, 0); pt_pb(1, 0, 2, 50, 0, 0); pt_pb(2, 0, 7, 50, 0, 0); pt_pb(3, 0, 8, 50, 1, 0);
  trm = 0; amp = 50; psh = 0; outg = 0; hpf = 0; lpf = 9;
  p == 2 ? ( pt_pb(0, 1, 3, 40, 1, 0); pt_pb(2, 0.5, 8, 30, 0, 0); pt_pb(3, 1.5, 8, 50, 1, 0); amp = 60; ) :
  p == 3 ? ( pt_pb(0, 2, 2, 60, 1, 0); pt_pb(1, -1, 1, 40, 0, 0); amp = 35; ) :
  p == 4 ? ( pt_pb(3, 2.5, 9, 40, 1, 0); pt_pb(2, -0.5, 9, 50, 0, 0); amp = 70; ) :
  p == 5 ? ( pt_pb(1, -1, 2, 50, 0, 0); pt_pb(2, 1.5, 6, 60, 0, 1); pt_pb(3, 1, 8, 50, 1, 0); ) :
  p == 6 ? ( pt_pb(1, -2, 1, 70, 0, 0); pt_pb(0, 0.5, 2, 50, 1, 0); hpf = 2; ) :
  p == 7 ? ( pt_pb(3, 2.5, 8, 50, 1, 2); pt_pb(0, -3, 7, 50, 1, 2); ) :
  p == 8 ? ( pt_pb(0, 1.5, 3, 70, 0, 1); pt_pb(1, -1, 2, 50, 0, 1); hpf = 1; ) :
  p == 9 ? ( pt_pb(3, 1, 8, 50, 1, 0); amp = 100; psh = 1; trm = -2; outg = 2; ) :
  p == 10 ? ( pt_pb(0, 1, 5, 80, 0, 0); pt_pb(2, 1, 7, 70, 0, 0); amp = 0; psh = 1; ) :
  p == 11 ? ( pt_pb(2, -1, 7, 60, 0, 0); pt_pb(3, -1.5, 6, 50, 1, 0); amp = 70; );
  i = 1; loop(27, slider_automate(2 ^ (i - 1)); i += 1; );
);

function pt_srinit() (
  pt_sr = srate;
  pt_kc = 1 - exp(-16 / (0.03 * srate));
  pt_kw = 1 - exp(-1 / (0.008 * srate));
  pt_ks = 1 - exp(-1 / (0.012 * srate));
  pt_ko = 1 - exp(-1 / (0.03 * srate));
  pt_kd = 1 - exp(-1 / (0.015 * srate));
  pt_dcc = 1 - 2 * $pi * 5 / srate;
  pt_fmax = 0.45 * srate; pt_fis = 1 / (0.01 * srate);
  pt_pka = exp(-1 / (0.3 * srate));
  ost_init(0);
  pt_clr(); pt_osclr();
);
os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
pt_srinit();
os_gsetup();
pt_targets(); pt_snapall(); pt_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = kgn * 31.7; i = 1; loop(27, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
os_snap(os_sl);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != pt_sr ? ( pt_srinit(); pt_targets(); pt_snapall(); );
pt_now = time_precise();
pt_tp > 0 && pt_now - pt_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > pt_gpp && play_position - pt_gpp < 4 * pt_gpd + 0.05) ? pt_reset();
pt_tp = pt_now; pt_gpp = play_position; pt_gpd = samplesblock / srate;
pt_targets(); pt_kgain();
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(os_sl); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
pt_dn();
saA.lo = pt_tn(saA.lo); saB.lo = pt_tn(saB.lo); saA.vl = pt_tn(saA.vl); saB.vl = pt_tn(saB.vl); saA.hl = pt_tn(saA.hl); saB.hl = pt_tn(saB.hl);
pt_ol_d = max(pt_ol_d, pt_ol); pt_or_d = max(pt_or_d, pt_or); pt_ol = pt_or = 0;
os_snapb(os_sl);

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
(pt_cn -= 1) <= 0 ? (
  pt_cn = 16;
  pt_i = 0; loop(8, pt_btick(PTB + pt_i * PTS, pt_i & 3); pt_i += 1; );
  pt_i = 0; loop(4, pt_ftick(PTF + pt_i * PTFS); pt_i += 1; );
);
pt_tg += pt_ko * (pt_tgt - pt_tg); pt_og += pt_ko * (pt_ogt - pt_og);
pt_am += pt_ko * (pt_amt - pt_am); pt_ps += pt_ko * (pt_pst - pt_ps);
pt_dm += pt_kd * (pt_dmt - pt_dm); pt_kg += pt_ko * (pt_kgt - pt_kg);
pt_sdv = 0.1 + 0.18 * pt_ps; pt_sdi = 0.45 + 0.55 * pt_ps; pt_isdv = 1 / pt_sdv; pt_isdi = 1 / pt_sdi;
pt_vdv = 0.2 + 0.4 * pt_ps; pt_vdi = 0.5 + 0.5 * pt_ps; pt_ivdv = 1 / pt_vdv; pt_ivdi = 1 / pt_vdi;
pt_xl = spl0 * pt_tg; pt_xr = spl1 * pt_tg;
pt_m = 0.5 * (pt_xl + pt_xr); pt_s = 0.5 * (pt_xl - pt_xr);
pt_m = pt_eq(pt_flt(pt_flt(pt_m, PTF, 1), PTF + PTFS, 0), 0);
pt_s = pt_eq(pt_flt(pt_flt(pt_s, PTF + 2 * PTFS, 1), PTF + 3 * PTFS, 0), 1);
pt_a = (pt_m + pt_s) * pt_kg; pt_b = (pt_m - pt_s) * pt_kg;
os_gate();
os_chg ? ( pt_osclr(); os_hold += 2 * samplesblock; );
upA.os_up(pt_a); upB.os_up(pt_b);
os_f == 1 ? (
  pt_a = saA.pt_sat(upA.s0); pt_b = saB.pt_sat(upB.s0);
) : os_f == 2 ? (
  pt_a = dnA.os_dn(saA.pt_sat(upA.s0), saA.pt_sat(upA.s1), 0, 0);
  pt_b = dnB.os_dn(saB.pt_sat(upB.s0), saB.pt_sat(upB.s1), 0, 0);
) : (
  pt_a = dnA.os_dn(saA.pt_sat(upA.s0), saA.pt_sat(upA.s1), saA.pt_sat(upA.s2), saA.pt_sat(upA.s3));
  pt_b = dnB.os_dn(saB.pt_sat(upB.s0), saB.pt_sat(upB.s1), saB.pt_sat(upB.s2), saB.pt_sat(upB.s3));
);
pt_z = pt_a - pt_dxl + pt_dcc * pt_dyl; pt_dxl = pt_a; pt_dyl = pt_z; pt_yl = pt_z * pt_og;
pt_z = pt_b - pt_dxr + pt_dcc * pt_dyr; pt_dxr = pt_b; pt_dyr = pt_z; pt_yr = pt_z * pt_og;
pt_ql = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)];
pt_qr = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
pt_yl -= pt_dm * pt_ql; pt_yr -= pt_dm * pt_qr;
pt_z = os_g * os_g * (3 - 2 * os_g); pt_yl *= pt_z; pt_yr *= pt_z;
pt_yl != pt_yl ? pt_yl = 0; pt_yr != pt_yr ? pt_yr = 0;
pt_fi < 1 ? (
  pt_fi = min(pt_fi + pt_fis, 1); pt_z = pt_fi * pt_fi * (3 - 2 * pt_fi);
  pt_yl = pt_ql + pt_z * (pt_yl - pt_ql); pt_yr = pt_qr + pt_z * (pt_yr - pt_qr);
);
ost_out(pt_yl, pt_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
pt_ol = max(pt_ol, abs(spl0)); pt_or = max(pt_or, abs(spl1));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x6F9954; mk_band = 0x16292C; mk_acc = 0xC07A48; mk_tab = 0x1D3A3F; mk_tabink = 0xF1E4CA;
