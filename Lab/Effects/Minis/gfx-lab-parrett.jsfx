function mg_zero(cx, cy, r) ( gfx_setfont(11); ui_col(mg_dotc); mg_ctxt(cx, cy - r - 11, "0"); );
function mg_sqkey(x, y, idx, lbl, lc, lp) local(on, hov, s, b, dn) (
