  rp_w == 1 ? ( m5_wblk(); ) :
  ( bd_powblk(0); );
  rp_c == 1 ? ( rp_mic != dt_lmic ? ( dt_lmic = rp_mic; dt_cabset(); ); ) :
  rp_c == 2 || rp_c == 3 ? ( m5_cabupd(0); ) :
  rp_c >= 4 ? ( bd_spkcoef(); bsL.bd_spktidy(); bsR.bd_spktidy(); );
  bk_tidy(); rv_l1 = bd_tn(rv_l1); rv_l2 = bd_tn(rv_l2); rv_h = bd_tn(rv_h);
  rp_kin = rp_fam[rp_p] == rp_w ? 1 : rp_nkw[rp_w] / rp_nk[rp_p];
