function rp_sync() local(p, w, k, m) (
  p = min(max(slider1 | 0, 0), 4); w = min(max(slider2 | 0, 0), 2); m = 0;
  p == rp_lpre ? ( k = 0; loop(rp_pn[p], RP_ST[rp_pb[p] + k] = slider(18 + k); k += 1; ); k = 0; loop(11, k >= rp_pn[p] && slider(18 + k) != 0 ? ( slider(18 + k) = 0; m = 1; ); k += 1; ); ) : (
    k = 0; loop(11, slider(18 + k) = k < rp_pn[p] ? RP_ST[rp_pb[p] + k] : 0; k += 1; ); m = 1; rp_lpre = p;
  );
  w == rp_lpow ? ( k = 0; loop(rp_wn[w], RP_ST[rp_wb[w] + k] = slider(29 + k); k += 1; ); k = 0; loop(2, k >= rp_wn[w] && slider(29 + k) != 0 ? ( slider(29 + k) = 0; m = 1; ); k += 1; ); ) : (
    k = 0; loop(2, slider(29 + k) = k < rp_wn[w] ? RP_ST[rp_wb[w] + k] : 0; k += 1; ); m = 1; rp_lpow = w;
  );
  m ? sliderchange(2 ^ 17 * 8191);
);

