);
function m5_pow(x) instance(rl, pa, yo) local(y) (
  y = rl * pa.clp_run(x * m5_vk / rl);
  yo = y;
  y;
);
function m5_wmodset() (
  m5_wmod = RP_ST[27] >= 0.5;
  !m5_wmod ? ( m5_rail = 1; m5_sagk = 0.12; m5_kw0 = m5_kw1 = 0.15; m5_kt = 0; )
           : ( m5_rail = 1.4; m5_sagk = 0.06; m5_kw0 = 0.42; m5_kw1 = 0.6; m5_kt = 1; );
  m5_Gpa = 8;
  mwL.pa.clp_set(2, 1, 1, 0); mwL.pa.clp_kt_cfg(m5_kw0, m5_kw1); mwR.pa.clp_set(2, 1, 1, 0); mwR.pa.clp_kt_cfg(m5_kw0, m5_kw1);
  mwL.pa.kti = mwR.pa.kti = 0;
);
function m5_wblk() local(g, k) (
  g = rp_p == 1 ? min(max(m5_gb, 0), 10) / 10 : 0.5;
  clp_kt_on = m5_kt;
  k = mwL.pa.clp_kt_block(g, srate, samplesblock); mwL.pa.clp_knee(k);
  k = mwR.pa.clp_kt_block(g, srate, samplesblock); mwR.pa.clp_knee(k);
