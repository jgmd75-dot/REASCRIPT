desc:Headsmoother Mini [tape sat + opto] (GFX Lab)
//tags: saturation tape compressor optical opto
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power, gfx-lab-thick

slider1:0<0,1,1{Off,On}>-Bypass
slider2:3<0,10,0.01>-Head drive
slider3:0<-24,6,0.1>-Head trim (dB)
slider4:0<0,2,1{Normal,Medium,Bright}>-Head voice
slider5:0<0,100,1>-Head boost (%)
slider6:1<0,1,1{Off,On}>-Head in
slider7:3<0,10,0.01>-Smooth compress
slider8:1<0,2,1{Slow,Medium,Fast}>-Smooth attack
slider9:1<0,2,1{Slow,Medium,Fast}>-Smooth release
slider10:0<0,1,1{Off,On}>-Smooth limit
slider11:1<0,1,1{Off,On}>-Smooth colour
slider12:100<0,100,1>-Smooth blend (%)
slider13:1<0,1,1{Off,On}>-Smooth in
slider14:0<0,1,1{Smooth first,Head first}>-Order
slider15:0<-12,24,0.1>-Output (dB)
slider16:50<0,100,1>-Drift (%)
slider17:0<0,2,1{1x,2x,4x}>-Oversampling
slider18:0<0,1,1{Off,On}>-Thick
slider19:prs_sel=0<0,12,1{No preset,Init,Gentle Tape Glue,Vocal Smooth,Bass Even,Drum Bus Warmth,Bright Head Sheen,Hard Opto Level,Safety Limit,Parallel Squash,Head Only,Opto Only,Tape Before Comp}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-thick.jsfx-inc

@init
#ui_man = "gfx-lab-headsmoother-mini";
ext_noinit = 1;

function hm_tc(ms, fs) ( 1 - exp(-1 / (max(ms, 0.05) * 0.001 * fs)); );

function hm_bqs(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, fs * 0.45) / fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * q);
  amp = 10 ^ (gdb / 40);
  type == 0 ? (
    n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 1 ? (
    n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 2 ? (
    n = 1 + al / amp; b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = b1; a2 = (1 - al / amp) / n;
  ) : (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n; b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n; a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;
    a2 = ((amp + 1) - (amp - 1) * cw - sa) / n;
  );
);
function hm_bq(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function hm_bqz() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function hm_aa() instance(u1, u2, u3, u4, d1, d2, d3, d4) local(fc, fs2) (
  fs2 = 2 * srate; fc = min(0.42 * srate, 20000);
  u1.hm_bqs(0, fc, 0.5098, 0, fs2); u2.hm_bqs(0, fc, 0.6013, 0, fs2);
  u3.hm_bqs(0, fc, 0.9000, 0, fs2); u4.hm_bqs(0, fc, 2.5629, 0, fs2);
  d1.hm_bqs(0, fc, 0.5098, 0, fs2); d2.hm_bqs(0, fc, 0.6013, 0, fs2);
  d3.hm_bqs(0, fc, 0.9000, 0, fs2); d4.hm_bqs(0, fc, 2.5629, 0, fs2);
);
function hm_eq(gapmul, fs) instance(emp, dem, mpre, mpost, bpre, bpost, bump, gap, dcb, lop) (
  emp.hm_bqs(3, 3000, 0.7, 4, fs);  dem.hm_bqs(3, 3000, 0.7, -4, fs);
  mpre.hm_bqs(2, 1400, 0.6, 3.5 * hm_vm, fs); mpost.hm_bqs(2, 1400, 0.6, -1.5 * hm_vm, fs);
  bpre.hm_bqs(3, 6000, 0.7, 5 * hm_vb, fs);   bpost.hm_bqs(3, 6000, 0.7, -2 * hm_vb, fs);
  bump.hm_bqs(2, 70, 0.9, hm_bump, fs);
  gap.hm_bqs(0, hm_gapf * gapmul, 0.55, 0, fs);
  dcb.hm_bqs(1, 10, 0.7, 0, fs);
  lop.hm_bqs(0, 250, 0.6, 0, fs);
);
function hm_eqz() instance(emp, dem, mpre, mpost, bpre, bpost, bump, gap, dcb, lop, u1, u2, u3, u4, d1, d2, d3, d4) (
  emp.hm_bqz(); dem.hm_bqz(); mpre.hm_bqz(); mpost.hm_bqz(); bpre.hm_bqz(); bpost.hm_bqz();
  bump.hm_bqz(); gap.hm_bqz(); dcb.hm_bqz(); lop.hm_bqz();
  u1.hm_bqz(); u2.hm_bqz(); u3.hm_bqz(); u4.hm_bqz(); d1.hm_bqz(); d2.hm_bqz(); d3.hm_bqz(); d4.hm_bqz();
);
function hm_sat(x, b, tb, c) ( (ost_tanh(hm_g * x + b) - tb) * c; );
function hm_head(x, b, tb, c) instance(emp, dem, mpre, mpost, bpre, bpost, bump, gap, dcb, lop, u1, u2, u3, u4, d1, d2, d3, d4)
  local(y, z, lo) (
  lo = lop.hm_bq(x) * hm_lb;
  y = bpre.hm_bq(mpre.hm_bq(emp.hm_bq(x - lo))) * 0.5;
  os_f == 1 ? (
    z = u4.hm_bq(u3.hm_bq(u2.hm_bq(u1.hm_bq(y * 2))));
    d4.hm_bq(d3.hm_bq(d2.hm_bq(d1.hm_bq(hm_sat(z, b, tb, c)))));
    z = u4.hm_bq(u3.hm_bq(u2.hm_bq(u1.hm_bq(0))));
    y = d4.hm_bq(d3.hm_bq(d2.hm_bq(d1.hm_bq(hm_sat(z, b, tb, c))))) * 2;
  ) : y = hm_sat(y, b, tb, c) * 2;
  dcb.hm_bq(gap.hm_bq(bump.hm_bq(bpost.hm_bq(mpost.hm_bq(dem.hm_bq(y))) + lo * hm_lg)));
);
function hm_headp(l, r) (
  hm_hoff ? ( hm_hl = l; hm_hr = r; ) : (
  hm_hl = hL.hm_head(l, hm_bL, hm_tbL, hm_ccL) * hm_trs; hm_hr = hR.hm_head(r, hm_bR, hm_tbR, hm_ccR) * hm_trs;
  hm_hl = l + (hm_hl - l) * hm_hon; hm_hr = r + (hm_hr - r) * hm_hon;
  );
);

function hm_colour(x, k, b, tb, dv) ( (ost_tanh(k * x + b) - tb) / dv; );
function hm_smoothp(l, r) local(dl, dr, lv, o, tgt, g, yl, yr) (
  hm_soff ? ( hm_cl = l; hm_cr = r; ) : (
  hm_det ? (
  dl = scL.hm_bq(l); dr = scR.hm_bq(r);
  hm_env += (0.5 * (dl * dl + dr * dr) - hm_env) * hm_crms;
  lv = 10 * log10(max(hm_env, 0.000000000001)) + 3;
  o = lv - hm_thr;
  tgt = o <= -hm_kn * 0.5 ? 0 : o >= hm_kn * 0.5 ? o * hm_rk : hm_rk * (o + hm_kn * 0.5) ^ 2 / (2 * hm_kn);
  hm_hold += (hm_gr - hm_hold) * hm_chold;
  tgt > hm_gr ? ( hm_gr += (tgt - hm_gr) * hm_catt; hm_grpk = hm_gr; )
              : hm_gr += (tgt - hm_gr) * hm_tc(hm_gr > hm_grpk * 0.6 ? hm_rel * 0.3 : hm_rel * (1 + 2 * min(hm_hold / 6, 1)), srate);
  hm_sg = 10 ^ (-hm_gr / 20);
  hm_grm = max(hm_grm, hm_gr * hm_son);
  );
  g = hm_sg;
  yl = l * g; yr = r * g;
  hm_col > 0.0001 ? (
    yl += hm_col * (hm_colour(l * g * 0.5, hm_kL, hm_cbL, hm_ctL, hm_cdL) * 2 - yl);
    yr += hm_col * (hm_colour(r * g * 0.5, hm_kR, hm_cbR, hm_ctR, hm_cdR) * 2 - yr);
  );
  hm_cl = l + (yl - l) * hm_bls; hm_cr = r + (yr - r) * hm_bls;
  hm_cl = l + (hm_cl - l) * hm_son; hm_cr = r + (hm_cr - r) * hm_son;
  );
);

function hm_chain(l, r) (
  hm_ord ? ( hm_headp(l, r); hm_smoothp(hm_hl, hm_hr); hm_ol = hm_cl; hm_or = hm_cr; )
         : ( hm_smoothp(l, r); hm_headp(hm_cl, hm_cr); hm_ol = hm_hl; hm_or = hm_hr; );
  hm_pl = hm_ol * hm_dk; hm_pr = hm_or * hm_dk;
);
function hm_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  hL.hm_eqz(); hR.hm_eqz(); scL.hm_bqz(); scR.hm_bqz();
  hm_env = 0; hm_gr = 0; hm_grpk = 0; hm_hold = 0;
);
function hm_reset() ( hm_clear(); memset(BY_BUF, 0, 2 * BY_N); hm_fi = 0; );

PT = 6000000;
#hm_pm = "Init|Gentle Tape Glue|Vocal Smooth|Bass Even|Drum Bus Warmth|Bright Head Sheen|Hard Opto Level|Safety Limit|Parallel Squash|Head Only|Opto Only|Tape Before Comp";
function hm_w14(a, b, c, d, e, f, g, h, i, j, k, m, n, o) (
  hm_wq[0] = a; hm_wq[1] = b; hm_wq[2] = c; hm_wq[3] = d; hm_wq[4] = e; hm_wq[5] = f; hm_wq[6] = g;
  hm_wq[7] = h; hm_wq[8] = i; hm_wq[9] = j; hm_wq[10] = k; hm_wq[11] = m; hm_wq[12] = n; hm_wq[13] = o; hm_wq += 14;
);
hm_wq = PT;
hm_w14(3,   0, 0,  0, 1,   3,   1, 1, 0, 1, 100, 1,   0, 0);
hm_w14(2,   0, 0,  0, 1,   2,   1, 1, 0, 1, 100, 1,   0, 0);
hm_w14(2.5, 0, 2,  0, 1,   5,   0, 1, 0, 1, 100, 1,   0, 0);
hm_w14(3,   0, 0,  0, 1,   6,   1, 1, 0, 1, 100, 1,   0, 2);
hm_w14(5,   0, 0,  0, 1,   4,   2, 2, 0, 1,  70, 1,   0, 0);
hm_w14(3,   0, 2, 40, 1,   1.5, 1, 1, 0, 1, 100, 1,   0, 0);
hm_w14(2,   0, 0,  0, 1,   8,   1, 2, 0, 1, 100, 1,   0, 5.4);
hm_w14(2,   0, 0,  0, 1,   2,   1, 1, 1, 1, 100, 1,   0, 0);
hm_w14(3,   0, 0,  0, 1,   9,   2, 1, 0, 1,  40, 1,   0, 2.3);
hm_w14(5,   0, 1,  0, 1,   3,   1, 1, 0, 1, 100, 0,   0, 0);
hm_w14(3,   0, 0,  0, 0,   5,   1, 1, 0, 1, 100, 1,   0, 1.3);
hm_w14(4,   0, 1,  0, 1,   5,   1, 1, 0, 1, 100, 1,   1, 0.7);
function load_preset(p) local(i, q) (
  q = PT + (p >= 13 ? 0 : p - 1) * 14;
  i = 0; loop(14, slider(2 + i) = q[i]; i += 1; );
  slider18 = 0;
  p >= 13 ? slider16 = 50;
  i = 2; loop(15, ui_auto(i); i += 1; ); ui_auto(18);
  pr_cur = p >= 13 ? 1 : p;
);

function hm_coef() (
  hm_fs = srate * os_f;
  scL.hm_bqs(1, 80, 0.70710678, 0, srate); scR.hm_bqs(1, 80, 0.70710678, 0, srate);
  hm_crms = hm_tc(5, srate); hm_chold = hm_tc(1500, srate);
);
function hm_srinit() (
  hm_sr = srate;
  hm_sm = hm_tc(30, srate);
  hm_fis = 1 / (0.01 * srate);
  hm_wks = floor(0.04 * srate);
  hm_dks = 1 / (0.006 * srate);
  hm_dcr = 1 - 2 * $pi / srate;
  hL.hm_aa(); hR.hm_aa();
  ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
  hm_coef(); hm_clear();
  hm_snap = 1;
);
os_design();
os_f = os_tf = os_f2n(slider17); os_base = 0;
hm_srinit();
os_gsetup();
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_bloom = 0.1;
dBL.drift_init(0.8 + rand(1) * 0.5); dBR.drift_init(0.8 + rand(1) * 0.5);
dGL.drift_init(0.8 + rand(1) * 0.5); dGR.drift_init(0.8 + rand(1) * 0.5);
dKL.drift_init(0.8 + rand(1) * 0.5); dKR.drift_init(0.8 + rand(1) * 0.5);
dCL.drift_init(0.8 + rand(1) * 0.5); dCR.drift_init(0.8 + rand(1) * 0.5);
drift_macro(50);
thk_init(); thk_lift = 3; thk_drv = 1.5; thk_asym = 0.12; thk_tr = 1.2; thk_trim = 0;
hm_dk = 1; hm_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(18, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != hm_sr ? hm_srinit();
hm_now = time_precise();
hm_tp > 0 && hm_now - hm_tp > max(0.25, 4 * samplesblock / srate) ? hm_reset();
hm_tp = hm_now;
pwr_block(slider1 < 0.5);
os_tf = os_f2n(slider17);
hm_kb = hm_snap ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
hm_drv += (min(max(slider2, 0), 10) - hm_drv) * hm_kb;
hm_bst += (min(max(slider5, 0), 100) - hm_bst) * hm_kb;
hm_vm += ((slider4 >= 0.5 && slider4 < 1.5) - hm_vm) * hm_kb;
hm_vb += ((slider4 >= 1.5) - hm_vb) * hm_kb;
hm_gapf += ((slider4 >= 1.5 ? 21000 : slider4 >= 0.5 ? 18000 : 16000) - hm_gapf) * hm_kb;
hm_thr += (-3 * min(max(slider7, 0), 10) - hm_thr) * hm_kb;
hm_lim = slider10 >= 0.5;
hm_rk += ((1 - 1 / (hm_lim ? 20 : 3)) - hm_rk) * hm_kb;
hm_kn += ((hm_lim ? 2 : 12) - hm_kn) * hm_kb;
hm_g = 10 ^ (hm_drv * 2.2 / 20);
hm_b0 = (hm_bst / 100) * 0.2;
hm_lb = (hm_drv / 10) ^ 1.2;
hm_c0 = 0.25 / ((ost_tanh(hm_g * 0.125 + hm_b0) - ost_tanh(hm_b0)) - (ost_tanh(-hm_g * 0.125 + hm_b0) - ost_tanh(hm_b0)));
hm_lg = sqrt(hm_g * hm_c0 * (1 - ost_tanh(hm_b0) ^ 2));
hm_bump = 1.5 * (1 - 0.5 * hm_drv / 10);
hm_att = (slider8 < 0.5 ? 25 : slider8 < 1.5 ? 8 : 1.5) * (hm_lim ? 0.5 : 1);
hm_rel = slider9 < 0.5 ? 900 : slider9 < 1.5 ? 350 : 90;
hm_catt = hm_tc(hm_att, srate);
ost_setup(hm_bst * (slider6 >= 0.5) / 100, hm_bst / 100, 120, 6000, -0.3, 1);
pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider16);
hm_dr = 0.25 * dm_a; hm_di = 0.25 * dm_s * samplesblock / srate;
hm_v = dBL.drift_tick(hm_di); hm_bL = hm_b0 + hm_v * hm_dr * 0.06;
hm_v = dBR.drift_tick(hm_di); hm_bR = hm_b0 + hm_v * hm_dr * 0.06;
hm_tbL = ost_tanh(hm_bL); hm_tbR = ost_tanh(hm_bR);
hm_ccL = 0.25 / ((ost_tanh(hm_g * 0.125 + hm_bL) - hm_tbL) - (ost_tanh(-hm_g * 0.125 + hm_bL) - hm_tbL));
hm_ccR = 0.25 / ((ost_tanh(hm_g * 0.125 + hm_bR) - hm_tbR) - (ost_tanh(-hm_g * 0.125 + hm_bR) - hm_tbR));
hm_v = dGL.drift_tick(hm_di); hL.hm_eq(2 ^ (hm_v * hm_dr * 0.25), hm_fs);
hm_v = dGR.drift_tick(hm_di); hR.hm_eq(2 ^ (hm_v * hm_dr * 0.25), hm_fs);
hm_v = dKL.drift_tick(hm_di); hm_kL = 1.2 * (1 + 0.6 * hm_dr * hm_v);
hm_v = dKR.drift_tick(hm_di); hm_kR = 1.2 * (1 + 0.6 * hm_dr * hm_v);
hm_v = dCL.drift_tick(hm_di); hm_cbL = 0.05 + 0.08 * hm_dr * hm_v;
hm_v = dCR.drift_tick(hm_di); hm_cbR = 0.05 + 0.08 * hm_dr * hm_v;
hm_ctL = ost_tanh(hm_cbL); hm_cdL = hm_kL * (1 - hm_ctL * hm_ctL); hm_ctR = ost_tanh(hm_cbR); hm_cdR = hm_kR * (1 - hm_ctR * hm_ctR);
hm_tr_t = 10 ^ (min(max(slider3, -24), 6) / 20);
hm_out_t = 10 ^ (min(max(slider15, -12), 24) / 20);
hm_bl_t = min(max(slider12, 0), 100) / 100;
hm_hon_t = slider6 >= 0.5; hm_son_t = slider13 >= 0.5; hm_col_t = slider11 >= 0.5;
hm_ord_t = slider14 >= 0.5;
hm_thon = slider18 >= 0.5 && slider6 >= 0.5;
hm_snap ? ( hm_trs = hm_tr_t; hm_outs = hm_out_t; hm_bls = hm_bl_t; hm_hon = hm_hon_t; hm_son = hm_son_t; hm_col = hm_col_t; hm_ord = hm_ord_t; );
hm_snap = 0;
hm_vu_d = max(hm_vu_d, sqrt(hm_ms / max(samplesblock, 1))); hm_ms = 0;
hm_gr_d = max(hm_gr_d, hm_grm); hm_grm = 0;
hm_pk_d = max(hm_pk_d, hm_pkm); hm_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
hm_y0 = spl0 - hm_x0 + hm_dcr * hm_y0; hm_x0 = spl0; hm_xl = hm_y0;
hm_y1 = spl1 - hm_x1 + hm_dcr * hm_y1; hm_x1 = spl1; hm_xr = hm_y1;
hm_trs += (hm_tr_t - hm_trs) * hm_sm; hm_outs += (hm_out_t - hm_outs) * hm_sm; hm_bls += (hm_bl_t - hm_bls) * hm_sm;
hm_hon += (hm_hon_t - hm_hon) * hm_sm; hm_son += (hm_son_t - hm_son) * hm_sm; hm_col += (hm_col_t - hm_col) * hm_sm;
hm_hon_t == 0 && hm_hon < 0.000001 ? ( hm_hon = 0; hm_hoff = 1; ) : hm_hoff ? ( hm_hoff = 0; hL.hm_eqz(); hR.hm_eqz(); hm_hwk = hm_wks; );
hm_hwk > 0 ? ( hm_hwk -= 1; hm_hon = 0; );
hm_son_t == 0 && hm_son < 0.000001 ? ( hm_son = 0; hm_soff = 1; ) : hm_soff ? ( hm_soff = 0; scL.hm_bqz(); scR.hm_bqz(); hm_env = 0; hm_gr = 0; hm_grpk = 0; hm_hold = 0; hm_sg = 1; );
hm_ord_t != hm_ord ? ( hm_dk = max(hm_dk - hm_dks, 0); hm_dk == 0 ? hm_ord = hm_ord_t; ) : hm_dk = min(hm_dk + hm_dks, 1);
thk_proc(hm_xl, hm_xr, hm_thon); hm_xl = thk_l; hm_xr = thk_r;
pwr_in(hm_xl, hm_xr); hm_xl = pwr_l; hm_xr = pwr_r;
