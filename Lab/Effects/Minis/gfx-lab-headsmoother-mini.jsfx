    gfx_setfont(11); mg_ctxt(cx + sin(t) * rs + (i == 0 ? -9 : i == 2 ? 9 : 0), cy - cos(t) * rs + (i == 1 ? -10 : 0), i == 0 ? "S" : i == 1 ? "M" : "F"); i += 1; );
  mg_kstep = 1; k = mg_knob(cx, cy, r, idx, 0, 2, def, 1, col); mg_kstep = 0;
