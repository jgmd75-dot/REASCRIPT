  fz_l = uxL.s1; fz_r = uxR.s1; fz_o > 0.0001 ? fz_run(); de_a1 = fz_l; de_b1 = fz_r;
  os_f == 2 ? ( de_l = dnL.os_dn(de_a0, de_a1, 0, 0); de_r = dnR.os_dn(de_b0, de_b1, 0, 0); ) : (
    fz_l = uxL.s2; fz_r = uxR.s2; fz_o > 0.0001 ? fz_run(); de_a2 = fz_l; de_b2 = fz_r;
    fz_l = uxL.s3; fz_r = uxR.s3; fz_o > 0.0001 ? fz_run(); de_a3 = fz_l; de_b3 = fz_r;
    de_l = dnL.os_dn(de_a0, de_a1, de_a2, de_a3); de_r = dnR.os_dn(de_b0, de_b1, de_b2, de_b3);
  );
