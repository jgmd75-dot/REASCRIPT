desc:De-Ess Mini [de-esser] (GFX Lab)
//tags: dynamics de-esser sibilance vocal split-band wideband
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Split,Wide}>-Mode
slider2:0<0,1,1{Band,High}>-Shape
slider3:6600<2000,12000,1>-Frequency (Hz)
slider4:-26<-50,0,0.1>-Threshold (dB)
slider5:10<0,24,0.1>-Range (dB)
slider6:60<20,300,1>-Release (ms)
slider7:0<0,1,1{Off,On}>-Listen
slider8:0<-12,12,0.1>-Output (dB)
slider9:100<0,100,1>-Mix (%)
slider10:0<0,100,1>-Fizz (%)
slider11:50<0,100,1>-Drift (%)
slider12:0<0,1,1{Off,On}>-Bypass
slider13:0<0,2,1{1x,2x,4x}>-Oversampling
slider14:1.2<0.3,4,0.01>-Width (Q)
slider15:0<0,1,1{Absolute,Relative}>-Threshold mode
slider16:0<0,1,1{Off,On}>-Harshness in
slider17:3300<1100,8800,1>-Harshness freq (Hz)
slider18:1.4<0.5,4,0.01>-Harshness width (Q)
slider19:-18<-60,0,0.1>-Harshness threshold (dB)
slider20:6<0,18,0.1>-Harshness range (dB)
slider21:150<40,800,1>-Harshness release (ms)
slider22:0<0,1,1{Off,On}>-Harshness listen
slider23:prs_sel=0<0,11,1{No preset,Init,Female Vocal,Male Vocal,Gentle Air,Hard Esses,Acoustic Guitar,Hats and Cymbals,Podcast Voice,Ess and Harsh,Shouty Rock,Edgy Mic}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-de-ess-mini";
ext_noinit = 1;

function de_db2g(d) ( exp(d * 0.11512925465); );
function de_g2db(g) ( 8.68588963807 * log(max(g, 0.0000000001)); );
function de_tc(s) ( 1 - exp(-1 / (max(s, 0.000001) * srate)); );
function de_curve(o, knee) ( o <= -knee * 0.5 ? 0 : o >= knee * 0.5 ? o : sqr(o + knee * 0.5) / (2 * knee); );

function svf_set(f, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(f, srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function svf(x) instance(g, k, a1, a2, a3, ic1, ic2, v1, v2, v3, hp, bp) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  hp = x - k * v1 - v2; bp = k * v1;
);
function svf_clr() instance(ic1, ic2, hp, bp) ( ic1 = ic2 = hp = bp = 0; );
function hshelf(x, lin) instance(ic1, ic2) local(shA, g, a1, a2, a3, v1, v2, v3) (
  shA = sqrt(max(lin, 0.0001)); g = de_hsT * sqrt(shA);
  a1 = 1 / (1 + g * (g + de_hsK)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  shA * shA * x + de_hsK * (1 - shA) * shA * v1 + (1 - shA * shA) * v2;
);
function hs_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function de_fset() (
  fL.svf_set(de_fs, de_shape ? 0.7071 : de_qs); fR.svf_set(de_fs, de_shape ? 0.7071 : de_qs);
  de_hsT = tan($pi * min(de_fs, srate * 0.45) / srate); de_hsK = 1.4142;
  hxL.svf_set(de_hfs, de_hqs); hxR.svf_set(de_hfs, de_hqs);
  de_hcg = tan($pi * min(de_hfs, srate * 0.45) / srate); de_hcl = 999;
);
function hc_set(db) local(hg) (
  hg = exp(db * 0.05756462732485115);
  de_hck = 1 / (de_hqs * hg); de_hcm = de_hck * (hg * hg - 1);
  de_hca1 = 1 / (1 + de_hcg * (de_hcg + de_hck)); de_hca2 = de_hcg * de_hca1; de_hca3 = de_hcg * de_hca2;
);
function hc_tick(x) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = de_hca1 * ic1 + de_hca2 * v3; v2 = ic2 + de_hca2 * ic1 + de_hca3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  x + de_hcm * v1;
);
function hc_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function de_latch() (
  de_cur = de_req; de_mode = de_cur & 1; de_shape = (de_cur >> 1) & 1; de_lis = (de_cur >> 2) & 1; de_relm = (de_cur >> 3) & 1; de_hlis = (de_cur >> 4) & 1;
  de_fset();
);
function de_setup() (
  de_req = (slider1 >= 0.5) + 2 * (slider2 >= 0.5) + 4 * (slider7 >= 0.5) + 8 * (slider15 >= 0.5) + 16 * (slider22 >= 0.5);
  de_qt = min(max(slider14, 0.3), 4);
  de_hft = min(max(slider17, 1100), 8800) * de_fdr; de_hqt = min(max(slider18, 0.5), 4);
  de_htt = slider19 + de_dth; de_hrgt = slider20; de_hon = slider16 >= 0.5;
  de_hrel = de_tc(slider21 * 0.001 * de_rdr);
  de_ft = min(max(slider3, 2000), 12000) * de_fdr;
  de_tht = slider4 + de_dth; de_rgt = slider5;
  de_rel = de_tc(slider6 * 0.001 * de_rdr);
  de_gout = de_db2g(slider8); de_mix = slider9 / 100;
  de_fzt = de_lis || de_hlis ? 0 : 0.33 * slider10 / 100;
);
function de_rates() (
  fz_coefs(srate * os_f);
);
function de_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  fL.svf_clr(); fR.svf_clr(); hsL.hs_clr(); hsR.hs_clr(); fz_clr();
  hxL.svf_clr(); hxR.svf_clr(); hcL.hc_clr(); hcR.hc_clr();
  de_env = 0; de_gr = 0; de_henv = 0; de_grh = 0; de_fenv = 0; de_hcl = 999;
  memset(DRY, 0, 128);
);

function de_pm(m, s, f, t, r, l, fz) (
  slider1 = m; slider2 = s; slider3 = f; slider4 = t; slider5 = r; slider6 = l; slider7 = 0; slider9 = 100; slider10 = fz;
  slider14 = 1.2; slider15 = 0; slider16 = 0; slider17 = 3300; slider18 = 1.4; slider19 = -18; slider20 = 6; slider21 = 150; slider22 = 0;
);
function de_ph(f, q, t, r, l) (
  slider14 = q; slider15 = 1; slider16 = 1; slider17 = f; slider18 = 1.4; slider19 = t; slider20 = r; slider21 = l; slider22 = 0;
);
function load_preset(p) (
  p == 1 ? ( de_pm(0, 0, 6600, -26, 10, 60, 0); slider8 = 0; slider11 = 50; ) :
  p == 2 ? de_pm(0, 0, 7700, -26, 10, 50, 0) :
  p == 3 ? de_pm(0, 0, 5500, -24, 9, 70, 0) :
  p == 4 ? de_pm(0, 1, 8800, -22, 6, 80, 15) :
  p == 5 ? de_pm(1, 0, 6600, -32, 16, 40, 0) :
  p == 6 ? de_pm(0, 0, 4400, -24, 6, 90, 0) :
  p == 7 ? de_pm(0, 1, 9900, -22, 8, 60, 0) :
  p == 8 ? de_pm(0, 0, 5500, -28, 12, 60, 0) :
  p == 9 ? ( de_pm(0, 0, 6600, -30, 8, 70, 0); de_ph(3300, 1.2, -18, 5, 150); ) :
  p == 10 ? ( de_pm(0, 0, 5500, -28, 8, 80, 0); de_ph(2200, 1.2, -22, 7, 120); slider18 = 1.2; ) :
  p == 11 ? ( de_pm(0, 0, 6600, -30, 8, 70, 0); de_ph(4400, 1.2, -20, 6, 120); slider18 = 1.6; );
  slider_automate(4194303);
);

DRY = 1000000;
function de_srinit() (
  de_sr = srate;
  de_smc = 1 - exp(-1 / (0.03 * srate));
  de_fk = exp(-16 / (0.03 * srate));
  de_dks = 1 / (0.006 * srate);
  de_fis = 1 / (0.01 * srate);
  de_att = de_tc(0.0003); de_fat = de_tc(0.005); de_frl = de_tc(0.06); de_hat = de_tc(0.003); de_hrs = 1 / (0.01 * srate);
  gdc_r = 1 - 2 * $pi / srate;
  de_setup(); de_fs = de_ft; de_qs = de_qt; de_hfs = de_hft; de_hqs = de_hqt; de_latch(); de_rates(); de_clear();
);
os_design();
os_f = os_tf = os_f2n(slider13); os_base = 0;
ost_init(0);
ost_setup(0, 0, 120, 6000, -0.3, 0);
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
de_fdr = 1; de_dth = 0; de_rdr = 1;
dT.drift_init(0.8 + rand(1) * 0.5); dF.drift_init(0.8 + rand(1) * 0.5); dR.drift_init(0.8 + rand(1) * 0.5);
de_oT = rand(2) - 1; de_oF = rand(2) - 1;
de_srinit();
de_ths = de_tht; de_rgs = de_rgt; de_hths = de_htt; de_hrgs = de_hrgt; de_hes = de_hon; de_ovm = de_hovm = -200; de_gos = de_gout; de_mxs = de_mix; fz_s = de_fzt; fz_o = 0;
de_dk = 1; de_fi = 1;
os_gsetup();
pdc_delay = os_lat(os_f);
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 0.5; pwr_wu_lp = 9000; pwr_wu_wob = 0.15; pwr_bloom = 0;
by_setup(12);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_sl() ( de_setup(); );
function prs_hash() local(i, h) ( h = 0; i = 1; loop(22, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); prs_sl();
      prs_q ? ( k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

function lat_snap() (
  os_tf = os_f2n(slider13);
  os_tf != os_f ? ( os_f = os_tf; os_g = 1; os_hold = 0; de_rates(); uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); fz_clr(); memset(DRY, 0, 128); );
  pdc_delay = os_lat(os_f);
);
lt_fresh = 1;

@slider
prs_chk();
lt_fresh ? lat_snap();
de_setup();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
lt_fresh ? ( lat_snap(); lt_fresh = 0; );
srate != de_sr ? de_srinit();
de_now = time_precise();
de_tp > 0 && de_now - de_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > de_gpp && play_position - de_gpp < 4 * de_gpd + 0.05) ? ( de_clear(); de_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
de_tp = de_now; de_gpp = play_position; de_gpd = samplesblock / srate;
pwr_block(slider12 < 0.5);
os_tf = os_f2n(slider13);
drift_macro(slider11);
de_inc = 0.05 * dm_s * samplesblock / srate;
de_w1 = dT.drift_tick(de_inc); de_w2 = dF.drift_tick(de_inc * 0.7); de_w3 = dR.drift_tick(de_inc * 1.3);
de_dth = dm_a * (0.35 * de_w1 + 0.15 * de_oT);
de_fdr = 2 ^ (dm_a * (0.025 * de_w2 + 0.01 * de_oF));
de_rdr = 1 + 0.06 * dm_a * de_w3;
de_setup();
de_sw = de_req != de_cur;
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
abs(de_env) < 0.0000000001 ? de_env = 0;
de_gr_d = max(de_gr_d, de_grm); de_grm = 0;
de_ov_d = max(de_ov_d, de_ovm); de_ovm = -200;
de_hov_d = max(de_hov_d, de_hovm); de_hovm = -200;
de_hgr_d = max(de_hgr_d, de_hgrm); de_hgrm = 0;
de_vu_d = max(de_vu_d, sqrt(de_msq / max(samplesblock, 1))); de_msq = 0;
de_pk_d = max(de_pk_d, de_pkm); de_pkm = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; de_iL = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; de_iR = gdc_y1;
de_gos += (de_gout - de_gos) * de_smc; abs(de_gos - de_gout) < 0.0000001 ? de_gos = de_gout;
de_mxs += (de_mix - de_mxs) * de_smc; abs(de_mxs - de_mix) < 0.0000001 ? de_mxs = de_mix;
de_ths += (de_tht - de_ths) * de_smc; abs(de_ths - de_tht) < 0.00001 ? de_ths = de_tht;
de_rgs += (de_rgt - de_rgs) * de_smc; abs(de_rgs - de_rgt) < 0.00001 ? de_rgs = de_rgt;
de_hths += (de_htt - de_hths) * de_smc; abs(de_hths - de_htt) < 0.00001 ? de_hths = de_htt;
de_hrgs += (de_hrgt - de_hrgs) * de_smc; abs(de_hrgs - de_hrgt) < 0.00001 ? de_hrgs = de_hrgt;
de_hes != de_hon ? de_hes = de_hon > de_hes ? min(1, de_hes + de_hrs) : max(0, de_hes - de_hrs);
fz_s += (de_fzt - fz_s) * de_smc; fz_s < 0.000001 && de_fzt == 0 ? fz_s = 0;
pwr_in(de_iL, de_iR); de_iL = pwr_l; de_iR = pwr_r;
de_sw ? ( de_dk = max(de_dk - de_dks, 0); de_dk == 0 ? ( de_latch(); de_setup(); de_sw = 0; ); ) : de_dk < 1 ? de_dk = min(de_dk + de_dks, 1);
de_cc = (de_cc + 1) & 15;
de_cc == 0 && (de_fs != de_ft || de_qs != de_qt || de_hfs != de_hft || de_hqs != de_hqt) ? (
  de_fs = de_ft + (de_fs - de_ft) * de_fk; abs(de_fs - de_ft) < 0.05 ? de_fs = de_ft;
  de_qs = de_qt + (de_qs - de_qt) * de_fk; abs(de_qs - de_qt) < 0.0005 ? de_qs = de_qt;
  de_hfs = de_hft + (de_hfs - de_hft) * de_fk; abs(de_hfs - de_hft) < 0.05 ? de_hfs = de_hft;
  de_hqs = de_hqt + (de_hqs - de_hqt) * de_fk; abs(de_hqs - de_hqt) < 0.0005 ? de_hqs = de_hqt;
  de_fset();
);
os_gate();
os_chg ? ( de_rates(); uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); fz_clr(); memset(DRY, 0, 128); os_hold += 2 * samplesblock; );
de_fl = max(abs(de_iL), abs(de_iR));
de_fenv += (de_fl - de_fenv) * (de_fl > de_fenv ? de_fat : de_frl);
de_fdb = de_g2db(de_fenv);
de_hrun = de_hes > 0 || de_grh > 0.0001 || de_hlis;
de_hrun ? (
  de_hidle ? ( hxL.svf_clr(); hxR.svf_clr(); hcL.hc_clr(); hcR.hc_clr(); de_henv = 0; de_hcl = 999; de_hidle = 0; );
  hxL.svf(de_iL); hxR.svf(de_iR);
  de_hbl = hxL.bp; de_hbr = hxR.bp;
  de_hv = max(abs(de_hbl), abs(de_hbr));
  de_henv += (de_hv - de_henv) * (de_hv > de_henv ? de_hat : de_hrel);
  de_hov = de_relm ? de_g2db(de_henv) - de_fdb - de_hths * 0.5 : de_g2db(de_henv) - de_hths;
  de_hgt = de_hov <= -3 ? 0 : de_hov >= 3 ? de_hov * 0.6667 : 0.6667 * sqr(de_hov + 3) / 12;
  de_fenv < 0.00003 ? de_hgt = 0;
  de_hgt = min(de_hrgs, de_hgt) * de_hes;
  de_grh += (de_hgt - de_grh) * (de_hgt > de_grh ? de_hat : de_hrel);
  de_grh < 0.0001 && de_hgt == 0 ? de_grh = 0;
  abs(de_grh - de_hcl) > 0.02 ? ( hc_set(-de_grh); de_hcl = de_grh; );
  de_hL = hcL.hc_tick(de_iL); de_hR = hcR.hc_tick(de_iR);
  de_hovm = max(de_hovm, de_hov); de_hgrm = max(de_hgrm, de_grh);
) : (
  de_hidle = 1; de_hbl = de_hbr = 0; de_grh = 0; de_hL = de_iL; de_hR = de_iR;
);
fL.svf(de_iL); fR.svf(de_iR);
de_dL = de_shape ? fL.hp : fL.bp; de_dR = de_shape ? fR.hp : fR.bp;
de_d = max(abs(de_dL), abs(de_dR));
de_env += (de_d - de_env) * (de_d > de_env ? de_att : de_rel);
de_lv = de_g2db(de_env);
de_ov = de_relm ? de_lv - de_fdb - de_ths * 0.5 : de_lv - de_ths;
de_tg = min(de_rgs, de_curve(de_ov, 6) * 0.8);
de_relm && de_fenv < 0.00003 ? de_tg = 0;
de_ovm = max(de_ovm, de_ov);
de_gr += (de_tg - de_gr) * (de_tg > de_gr ? 0.5 : 1);
