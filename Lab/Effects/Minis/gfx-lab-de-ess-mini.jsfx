  de_xl = DRY[(de_dw - de_dd) & 63]; de_xr = DRY[64 + ((de_dw - de_dd) & 63)];
  de_dw = (de_dw + 1) & 63;
) : ( de_xl = de_iL; de_xr = de_iR; );
fz_o = fz_s * de_g;
os_f == 1 ? (
