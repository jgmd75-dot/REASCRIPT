de_lis || de_hlis ? (
  de_yL = (de_lis ? de_dL : 0) + (de_hlis ? de_hbl : 0); de_yR = (de_lis ? de_dR : 0) + (de_hlis ? de_hbr : 0);
) : de_mode == 0 ? (
  de_shape ? ( de_yL = hsL.hshelf(de_hL, de_g); de_yR = hsR.hshelf(de_hR, de_g); )
