function rp_sync() local(p, w, k, m) (
  p = min(max(slider1 | 0, 0), 3); w = min(max(slider2 | 0, 0), 3); m = 0;
  p == rp_lpre ? ( k = 0; loop(rp_pn[p], RP_ST[rp_pb[p] + k] = slider(18 + k); k += 1; ); k = 0; loop(10, k >= rp_pn[p] && slider(18 + k) != 0 ? ( slider(18 + k) = 0; m = 1; ); k += 1; ); ) : (
    k = 0; loop(10, slider(18 + k) = k < rp_pn[p] ? RP_ST[rp_pb[p] + k] : 0; k += 1; ); m = 1; rp_lpre = p;
  );
  w == rp_lpow ? ( k = 0; loop(rp_wn[w], RP_ST[rp_wb[w] + k] = slider(28 + k); k += 1; ); k = 0; loop(3, k >= rp_wn[w] && slider(28 + k) != 0 ? ( slider(28 + k) = 0; m = 1; ); k += 1; ); ) : (
    k = 0; loop(3, slider(28 + k) = k < rp_wn[w] ? RP_ST[rp_wb[w] + k] : 0; k += 1; ); m = 1; rp_lpow = w;
  );
  m ? sliderchange(2 ^ 17 * 8191);
);

os_design();
os_base = 0;
clp_kt_on = 1;
abD1.drift_init(0.8 + rand(1) * 0.5); abD2.drift_init(0.8 + rand(1) * 0.5); abD3.drift_init(0.8 + rand(1) * 0.5);
a2D1.drift_init(0.8 + rand(1) * 0.5); a2D2.drift_init(0.8 + rand(1) * 0.5); a2D3.drift_init(0.8 + rand(1) * 0.5);
a2D4.drift_init(0.8 + rand(1) * 0.5); a2D5.drift_init(0.8 + rand(1) * 0.5); a2D6.drift_init(0.8 + rand(1) * 0.5);
f6D1.drift_init(0.8 + rand(1) * 0.5); f6D2.drift_init(0.8 + rand(1) * 0.5); f6D3.drift_init(0.8 + rand(1) * 0.5);
f6D4.drift_init(0.8 + rand(1) * 0.5); f6D5.drift_init(0.8 + rand(1) * 0.5); f6D6.drift_init(0.8 + rand(1) * 0.5);
f6D7.drift_init(0.8 + rand(1) * 0.5); f6D8.drift_init(0.8 + rand(1) * 0.5);
sbD1.drift_init(0.8 + rand(1) * 0.5);
