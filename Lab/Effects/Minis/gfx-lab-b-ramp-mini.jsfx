RP_DF[35] = 6;
RP_DF[36] = 5;
RP_DF[37] = 5;
RP_DF[38] = 5;
RP_DF[39] = 0;
RP_DF[40] = 0;
RP_DF[41] = 0;
RP_DF[42] = 0;
RP_DF[43] = 0;
