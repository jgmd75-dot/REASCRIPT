rp_pkL_disp = rp_pkR_disp = 0;
rp_rf = 1;

ZZC = 4003000;
function zz_tn(v) ( abs(v) < 0.000000000001 ? 0 : v; );
function zz_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function zz_bqc(c, t, f, gdb, q, fs) local(gq, w, cw, sw, al, a0, sa) (
  gq = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / gq;
    c[0] = (1 + al * gq) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * gq) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / gq) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(gq) * sw * 0.5 * sqrt(2); a0 = (gq + 1) - (gq - 1) * cw + sa;
    c[0] = gq * ((gq + 1) + (gq - 1) * cw + sa) / a0; c[1] = -2 * gq * ((gq - 1) + (gq + 1) * cw) / a0; c[2] = gq * ((gq + 1) + (gq - 1) * cw - sa) / a0;
    c[3] = 2 * ((gq - 1) - (gq + 1) * cw) / a0; c[4] = ((gq + 1) - (gq - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function zz_bm(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function zz_bmz() instance(z1, z2) ( z1 = z2 = 0; );
function zz_bmt() instance(z1, z2) ( z1 = zz_tn(z1); z2 = zz_tn(z2); );
function zz_run(x) instance(qA, qB, qC, qD, fhi, fp, fe) local(h, ha, nn, u, e, ea, g) (
  h = qA.zz_bm(x, ZZC);
  ha = abs(h); fhi += (ha - fhi) * (ha > fhi ? zz_a : zz_r);
  fp += (abs(x) - fp) * zz_w;
  nn = 1 / (max(fhi, 0.25 * fp) + 0.00001);
  u = h * nn;
  e = (zz_tanh(2 * u) / 2 - u + 0.4 * u * u) * fhi;
  e = qD.zz_bm(qC.zz_bm(qB.zz_bm(e, ZZC + 5), ZZC + 10), ZZC + 15);
  ea = abs(e); fe += (ea - fe) * (ea > fe ? zz_a : zz_r);
  g = zz_o * max(0.25, min(1, 0.05 * fp / (fe + 0.000001)));
  g * e;
);
function zz_dn() instance(qA, qB, qC, qD, fhi, fp, fe) ( qA.zz_bmt(); qB.zz_bmt(); qC.zz_bmt(); qD.zz_bmt(); fhi = zz_tn(fhi); fp = zz_tn(fp); fe = zz_tn(fe); );
function zz_clr() instance(qA, qB, qC, qD, fhi, fp, fe) ( qA.zz_bmz(); qB.zz_bmz(); qC.zz_bmz(); qD.zz_bmz(); fhi = fp = fe = 0; );
function zz_coef() local(fso) (
  fso = os_f * srate;
  zz_bqc(ZZC, 4, 3500, 0, 0.7071, fso); zz_bqc(ZZC + 5, 4, 5500, 0, 0.7071, fso);
  zz_bqc(ZZC + 10, 0, 8000, 4, 0.7, fso); zz_bqc(ZZC + 15, 2, 12000, -6, 0.7, fso);
  zz_a = 1 - exp(-1 / (0.003 * fso)); zz_r = 1 - exp(-1 / (0.12 * fso)); zz_w = 1 - exp(-1 / (0.06 * fso));
);
function mn_rate() ( zz_coef(); zzL.zz_clr(); zzR.zz_clr(); );
zz_o = zz_t = 0;
mn_rate();
by_setup(32);
pwr_init(); pwr_hum_db = -88.5; pwr_wu_loss = 1.0; pwr_wu_drv = 2; pwr_wu_lp = 7000; pwr_wu_wob = 0.25; pwr_bloom = 0.15; pwr_sag = 0.25;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
mn_k = 1 - exp(-1 / (0.03 * srate));

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function rp_req(p) ( rp_prq_d = p; );

function prs_hash() local(i, h) ( h = 0; i = 1; loop(31, i != 31 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; rp_req(k);
    k <= 16 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( rp_req(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
rp_sync();
rp_update();
os_snap(slider(8));

@block
prs_chk();
srate != rp_sr ? ( rp_start(); mn_rate(); );
rp_now = time_precise();
rp_last > 0 && rp_now - rp_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rp_gpp && play_position - rp_gpp < 4 * rp_gpd + 0.05) ? ( rp_rate(); mn_rate(); rp_rf = 0; rp_rc = 1 / (0.015 * srate); );
rp_last = rp_now; rp_gpp = play_position; rp_gpd = samplesblock / srate;
rp_prq_d > 0 && rp_dst == 0 ? ( rp_prn = rp_prq_d; rp_prq_d = 0; rp_dfor = 1; rp_dst = 1; );
rp_sync();
rp_update();
rp_dst == 3 ? (
  rp_preset(rp_prn); rp_sync(); rp_update(); rp_swapall();
  rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dfor = 0; rp_dst = 2;
);
rp_dst == 0 && (rp_tp != rp_p || rp_tw != rp_w || rp_tc != rp_c || rp_tmono != rp_mono ||
  (rp_p == 1 && a2_wp != (RP_ST[25] >= 0.5)) || (rp_w == 1 && a2_ww != (RP_ST[49] >= 0.5)) ||
  (rp_w == 2 && f6_wsel != (RP_ST[51] >= 0.5))) ? rp_dst = 1;
rp_dst < 2 ? rp_block();
pwr_block(byp < 0.5);
mn_g = (rp_p == 0 ? RP_ST[18] : rp_p == 1 ? RP_ST[26] : rp_p == 2 ? RP_ST[33] : RP_ST[38]);
mn_p = min(max((mn_g - 5) / 5, 0), 1); zz_t = 0.33 * mn_p * mn_p * (3 - 2 * mn_p);
zzL.zz_dn(); zzR.zz_dn();
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(slider(8));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
rp_rd = file_avail(0) > 0;
file_avail(0) != 0 ? file_mem(0, RP_ST + 18, RP_N);
rp_rd ? ( rp_lpre = rp_lpow = -1; rp_sync(); ) : ( rp_lpre = slider1 | 0; rp_lpow = slider2 | 0; );
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
by_in();
rp_dst == 1 ? ( rp_dk -= rp_dkr; rp_dk <= 0 ? ( rp_dk = 0; rp_dfor ? rp_dst = 3 : ( rp_swap(); rp_hc = floor(0.012 * srate) + os_lat(os_f); rp_dst = 2; ); ); ) :
rp_dst == 2 ? ( rp_hc > 0 ? rp_hc -= 1 : ( rp_dk += rp_dkr; rp_dk >= 1 ? ( rp_dk = 1; rp_dst = 0; ); ); );
os_gate();
os_chg ? ( rp_rate(); mn_rate(); );

rp_dl = spl0; rp_dr = spl1;
in_process(spl0, spl1);
rp_xl = in_l; rp_xr = in_r;
rp_gate > -79.5 ? ( rp_gg = rp_gt.am_gate(max(abs(rp_xl), abs(rp_xr)), rp_gate); rp_xl *= rp_gg; rp_xr *= rp_gg; );
rp_mono ? ( rp_xl = rp_xr = 0.5 * (rp_xl + rp_xr); );
pwr_in(rp_xl, rp_xr); rp_xl = pwr_l; rp_xr = pwr_r;
zz_o += (zz_t - zz_o) * mn_k; zz_on = zz_o > 0.0001;
rp_dn = -rp_dn; a2_dn = -a2_dn;
rp_dw = (rp_dw + 1) & 127; rp_DRY[rp_dw] = rp_xl; rp_DRY[128 + rp_dw] = rp_xr;
rp_ddl = rp_DRY[(rp_dw - os_lat(os_f)) & 127]; rp_ddr = rp_DRY[128 + ((rp_dw - os_lat(os_f)) & 127)];

rp_p == 0 ? ( ab_glide(); rp_al = abfL.clp_pf_run(rp_xl); rp_ar = abfR.clp_pf_run(rp_xr); ) :
rp_p == 1 ? ( a2_gp += (a2_gpt - a2_gp) * a2_sk; a2_sb += (a2_sbt - a2_sb) * a2_sk;
              rp_al = a2fL.clp_pf_run(rp_xl); rp_ar = a2fR.clp_pf_run(rp_xr); ) :
rp_p == 2 ? ( rp_al = fpL.pf.clp_pf_run(rp_xl); rp_ar = fpR.pf.clp_pf_run(rp_xr); ) :
( rp_al = rp_xl; rp_ar = rp_xr; );
rp_w == 1 ? ( a2_mp += (a2_mpt - a2_mp) * a2_sk; );

uL.os_up(rp_al); uR.os_up(rp_ar);
rp_i = 0;
loop(os_f,
  rp_al = uL.os_s(rp_i); rp_ar = uR.os_s(rp_i);
  rp_p == 0 ? ( rp_al = abpL.ab_pre(rp_al); rp_ar = abpR.ab_pre(rp_ar); ) :
  rp_p == 1 ? ( rp_al = a2pL.a2_pre(rp_al); rp_ar = a2pR.a2_pre(rp_ar); ) :
  rp_p == 2 ? ( rp_al = fpL.f6_pre(rp_al); rp_ar = fpR.f6_pre(rp_ar); ) :
  ( rp_al = sbpL.sb_pre(rp_al); rp_ar = sbpR.sb_pre(rp_ar); );
  rp_al *= rp_kin; rp_ar *= rp_kin;
  rp_w == 0 ? ( rp_al = abwL.ab_pow(rp_al); rp_ar = abwR.ab_pow(rp_ar); ab_sag(); ) :
  rp_w == 1 ? ( rp_al = a2wL.a2_pow(rp_al); rp_ar = a2wR.a2_pow(rp_ar); ) :
  rp_w == 2 ? ( rp_al = fwL.f6_pow(rp_al); rp_ar = fwR.f6_pow(rp_ar); ) :
  ( rp_al = sbwL.sb_pow(rp_al); rp_ar = sbwR.sb_pow(rp_ar); sb_sag(); );
  zz_on ? ( rp_al += zzL.zz_run(rp_al); rp_ar += zzR.zz_run(rp_ar); );
  rp_i == 0 ? ( rp_a0 = rp_al; rp_b0 = rp_ar; ) : rp_i == 1 ? ( rp_a1 = rp_al; rp_b1 = rp_ar; ) :
  rp_i == 2 ? ( rp_a2 = rp_al; rp_b2 = rp_ar; ) : ( rp_a3 = rp_al; rp_b3 = rp_ar; );
  rp_i += 1;
);
rp_yl = dL.os_dn(rp_a0, rp_a1, rp_a2, rp_a3); rp_yr = dR.os_dn(rp_b0, rp_b1, rp_b2, rp_b3);

rp_p == 0 ? ( os_f == 1 ? ( rp_yl = abkL2.am_run(abkL1.am_run(rp_yl)); rp_yr = abkR2.am_run(abkR1.am_run(rp_yr)); ); ) :
rp_p == 1 ? (
  rp_yl = a2kL.rp_sbq(rp_yl); rp_yr = a2kR.rp_sbq(rp_yr);
  a2_ln = a2lL.a2_lin(rp_ddl);
  a2_ly = a2s2L.rp_sbq(a2s1L.rp_sbq(rp_yl)); a2_ll = a2s4L.rp_sbq(a2s3L.rp_sbq(a2_ln));
  a2_msyL += (a2_ly * a2_ly - a2_msyL) * a2_msk; a2_mslL += (a2_ll * a2_ll - a2_mslL) * a2_msk;
  a2_mslL > 0.00000000000001 ? a2_gL = min(sqrt(a2_msyL / a2_mslL), 100000);
  rp_yl += (a2_gL * a2_ll - a2_ly) * a2_sb;
  a2_ln = a2lR.a2_lin(rp_ddr);
  a2_ly = a2s2R.rp_sbq(a2s1R.rp_sbq(rp_yr)); a2_ll = a2s4R.rp_sbq(a2s3R.rp_sbq(a2_ln));
  a2_msyR += (a2_ly * a2_ly - a2_msyR) * a2_msk; a2_mslR += (a2_ll * a2_ll - a2_mslR) * a2_msk;
  a2_mslR > 0.00000000000001 ? a2_gR = min(sqrt(a2_msyR / a2_mslR), 100000);
  rp_yr += (a2_gR * a2_ll - a2_ly) * a2_sb;
) :
rp_p == 2 ? ( os_f == 1 ? ( rp_yl = f6k2L.rp_sbq(f6k1L.rp_sbq(rp_yl)); rp_yr = f6k2R.rp_sbq(f6k1R.rp_sbq(rp_yr)); ); );
rp_w == 2 ? ( rp_yl = ldL.f6_ldrun(rp_yl); rp_yr = ldR.f6_ldrun(rp_yr); );
rp_c == 1 ? ( rp_yl = abcL.am_cab_run(rp_yl); rp_yr = abcR.am_cab_run(rp_yr); ) :
rp_c >= 2 && rp_c <= 4 ? ( rp_yl = a2cL.a2_cabrun(rp_yl); rp_yr = a2cR.a2_cabrun(rp_yr); ) :
rp_c == 5 ? ( rp_yl = f6cL.f6_cabrun(rp_yl); rp_yr = f6cR.f6_cabrun(rp_yr); ) :
rp_c >= 6 ? ( rp_yl = sbcL.sb_cabrun(rp_yl); rp_yr = sbcR.sb_cabrun(rp_yr); ) : (
  rp_p == 0 ? ( rp_yl = abloL.s2.am_run(abloL.s1.am_run(rp_yl)); rp_yr = abloR.s2.am_run(abloR.s1.am_run(rp_yr)); ) :
  rp_p == 1 ? ( rp_yl = a2loL.rp_sbq(rp_yl); rp_yr = a2loR.rp_sbq(rp_yr); );
);
rp_c >= 6 ? ( rp_sa = min(max(abs(rp_yl), abs(rp_yr)), 1); sb_heat += (rp_sa - sb_heat) * (rp_sa > sb_heat ? sb_kh : sb_kc); );
rp_g += (rp_tg - rp_g) * rp_ogk;
rp_yl *= rp_g; rp_yr *= rp_g;
rp_di += (rp_dit - rp_di) * rp_ogk;
rp_di > 0.00001 ? (
  rp_yl += (rp_dhL.a2_1run(rp_ddl) * 1.12 - rp_yl) * rp_di; rp_yr += (rp_dhR.a2_1run(rp_ddr) * 1.12 - rp_yr) * rp_di;
) : ( rp_dhL.a2_1run(rp_ddl); rp_dhR.a2_1run(rp_ddr); );
rp_os += (rp_out - rp_os) * rp_ogk;
rp_k = rp_os;
rp_dst ? ( rp_dkg = rp_dk * rp_dk * (3 - 2 * rp_dk); rp_k *= rp_dkg; );
os_g < 1 ? rp_k *= os_g;
rp_yl *= rp_k; rp_yr *= rp_k;
pwr_out(rp_yl, rp_yr); rp_yl = pwr_l; rp_yr = pwr_r;
rp_yl = ostL.ost_band(rp_yl); rp_yr = ostR.ost_band(rp_yr);
ost_out(rp_yl, rp_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rp_rf < 1 ? (
  rp_rf = min(rp_rf + rp_rc, 1); rp_rs = rp_rf * rp_rf * (3 - 2 * rp_rf);
  spl0 = rp_dl + (spl0 - rp_dl) * rp_rs; spl1 = rp_dr + (spl1 - rp_dr) * rp_rs;
);
by_out();
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x6E301B; mk_band = 0x131210; mk_ink = 0xF0F0EC; mk_tab = 0x3A70C0; mk_acc = 0xFFC870;
mk_sub = 0x7A3820; mk_grey = 0x2A2C30; mk_ink2 = 0xC8CCD2;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
