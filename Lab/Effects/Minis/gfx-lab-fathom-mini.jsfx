desc:Fathom Mini [loudness meter] (GFX Lab)
//tags: meter loudness lufs true peak limiter target analysis utility mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:gain_db=0<-18,18,0.1>-Gain (dB)
slider3:tgt_sel=0<0,5,1{Streaming -14,Podcast -16,Broadcast Europe -23,Broadcast US -24,Film dialogue -27,Loud master -9}>-Target
slider4:lim_on=0<0,1,1{Off,On}>-True-peak limiter
slider5:auto_rst=1<0,1,1{Off,On}>-Reset on play
slider6:prs_sel=0<0,7,1{No preset,Init,Streaming Master,Podcast Voice,Broadcast Europe,Broadcast US,Film Dialogue,Loud Master}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-fathom-mini";
ext_noinit = 1;

SUBR = 0;
HIC = 10000; HIE = 12000;
HBIN = 1600; BINW = 0.05;
TPK = 40000;
TPH = 40200;
DLINE = 41000;
GHIST = 43100;
DQV = 44200; DQI = 45300;
DRY = 46400;
RMASK = 1023;
XCH = 50000;

function db2g(d) ( exp(d * 0.11512925464970228); );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );
function e2l(e) ( e > 0.0000000000001 ? -0.691 + 10 * log10(e) : -200; );
function tgt_set() local(s) (
  s = max(0, min(5, tgt_sel | 0));
  tgt_lufs = s == 0 ? -14 : s == 1 ? -16 : s == 2 ? -23 : s == 3 ? -24 : s == 4 ? -27 : -9;
  tp_max = s == 3 || s == 4 ? -2 : -1;
);

function kw_design() local(k, vh, vb, q, a0) (
  k = tan($pi * 1681.974450955533 / srate); q = 0.7071752369554196;
  vh = 10 ^ (3.999843853973347 / 20); vb = vh ^ 0.4996667741545416;
  a0 = 1 + k / q + k * k;
  s1b0 = (vh + vb * k / q + k * k) / a0; s1b1 = 2 * (k * k - vh) / a0; s1b2 = (vh - vb * k / q + k * k) / a0;
  s1a1 = 2 * (k * k - 1) / a0; s1a2 = (1 - k / q + k * k) / a0;
  k = tan($pi * 38.13547087602444 / srate); q = 0.5003270373238773;
  a0 = 1 + k / q + k * k;
  s2a1 = 2 * (k * k - 1) / a0; s2a2 = (1 - k / q + k * k) / a0;
);
function kw_run(x) instance(z1, z2, w1, w2) local(y, u) (
  y = s1b0 * x + z1; z1 = s1b1 * x - s1a1 * y + z2; z2 = s1b2 * x - s1a2 * y;
  u = y + w1; w1 = -2 * y - s2a1 * u + w2; w2 = y - s2a2 * u;
  u;
);

function bessel_i0(x) local(s, t, k) (
  s = t = 1; k = 1;
  loop(30, t *= (x * 0.5 / k) * (x * 0.5 / k); s += t; k += 1; );
  s;
);
function tp_design() local(p, k, t, w, x, s, i0b) (
  i0b = bessel_i0(6);
  p = 0;
  loop(7,
    s = 0; k = 0;
    loop(24,
      t = (k - 11) - (p + 1) * 0.125;
      x = t / 12.5; w = abs(x) < 1 ? bessel_i0(6 * sqrt(1 - x * x)) / i0b : 0;
      TPK[p * 24 + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
      s += TPK[p * 24 + k]; k += 1;
    );
    k = 0; loop(24, TPK[p * 24 + k] /= s; k += 1; );
    p += 1;
  );
);
function tp_peak(ch, x) local(h, b, p, m, y) (
  h = TPH + ch * 64 + (tp_w % 24);
  h[0] = x; h[24] = x;
  h = TPH + ch * 64 + ((tp_w + 1) % 24);
  m = max(abs(h[11]), abs(h[12])); p = 0;
  loop(7,
    b = TPK + p * 24;
    y = b[0] * h[0] + b[1] * h[1] + b[2] * h[2] + b[3] * h[3] + b[4] * h[4] + b[5] * h[5]
      + b[6] * h[6] + b[7] * h[7] + b[8] * h[8] + b[9] * h[9] + b[10] * h[10] + b[11] * h[11]
      + b[12] * h[12] + b[13] * h[13] + b[14] * h[14] + b[15] * h[15] + b[16] * h[16] + b[17] * h[17]
      + b[18] * h[18] + b[19] * h[19] + b[20] * h[20] + b[21] * h[21] + b[22] * h[22] + b[23] * h[23];
    m = max(m, abs(y)); p += 1;
  );
  m;
);

function clear_lim() local(k) (
  memset(DLINE, 0, 2048); memset(GHIST, 0, 1024);
  dq_h = dq_t = 0; g_rl = 1; wp = 0; tn = 0;
  memset(TPH, 0, 128);
  k = 0; loop(1024, GHIST[k] = 1; k += 1; ); g_sum = la_n;
);

function lbin(l) ( max(0, min(HBIN - 1, floor((l + 70) / BINW))); );

function meter_reset() (
  memset(HIC, 0, HBIN); memset(HIE, 0, HBIN);
  ab_n = ab_e = 0; ib_hi = 0;
  run_n = 0; i_val = -200; tpl = tpr = 0;
  i_disp = -200; tpl_disp = tpr_disp = 0;
);

function gate_i(e) local(l, b, n, s, t) (
  l = e2l(e);
  l > -70 ? (
    b = lbin(l); HIC[b] += 1; HIE[b] += e; ab_n += 1; ab_e += e; ib_hi = max(ib_hi, b);
    t = e2l(ab_e / ab_n) - 10;
    b = t < -70 ? 0 : lbin(t);
    n = s = 0;
    loop(ib_hi + 1 - b, n += HIC[b]; s += HIE[b]; b += 1; );
    i_val = n > 0 ? e2l(s / n) : -200;
  );
);

kw_design();
tp_design();
tgt_set();
sub_len = floor(0.1 * srate + 0.5);
c_kn = coef(0.03); c_sw = coef(0.015);
memset(SUBR, 0, 1024); sub_i = 0; sub_acc = 0; sub_cnt = 0; sub_tot = 0;
kl.z1 = kl.z2 = kl.w1 = kl.w2 = kr.z1 = kr.z2 = kr.w1 = kr.w2 = 0;
memset(TPH, 0, 256); tp_w = 0;
la_n = ceil(0.0015 * srate); la_w = la_n + 1; la_d = la_n + 12;
c_lrel = coef(0.15); dip_c = 1 / (0.005 * srate);
clear_lim();
meter_reset();
m_disp = s_disp = -200;
g_s = db2g(gain_db); by_s = byp;
lim_eng = lim_on; pdc_delay = lim_eng ? la_d : 0; pdc_bot_ch = 0; pdc_top_ch = 2;
dip_g = 1; dip_hold = 0; rs_f = 1; rs_c = 1 / (0.015 * srate); dw = 0; memset(DRY, 0, 2048);
ceil_s = db2g(tp_max);
fa_fresh = 1;

function load_preset(p) (
  p == 2 ? ( tgt_sel = 0; lim_on = 1; ) :
  p == 3 ? ( tgt_sel = 1; lim_on = 1; ) :
  p == 4 ? ( tgt_sel = 2; lim_on = 1; ) :
  p == 5 ? ( tgt_sel = 3; lim_on = 1; ) :
  p == 6 ? ( tgt_sel = 4; lim_on = 0; ) :
  p == 7 ? ( tgt_sel = 5; lim_on = 1; ) :
           ( tgt_sel = 0; lim_on = 0; gain_db = 0; auto_rst = 1; ui_auto(2); ui_auto(5); );
  ui_auto(3); ui_auto(4);
  pr_cur = p > 7 ? 1 : p;
);

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(5, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 7 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(7, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); ) :
      !prs_hs && prs_sel > 0 ? ( prs_sel = 0; prs_last = 0; slider_automate(prs_sel); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
tgt_set();
fa_fresh ? (
  lim_eng = lim_on >= 0.5; clear_lim(); dip_g = 1; dip_hold = 0;
  pdc_delay = lim_eng ? la_d : 0;
  g_s = db2g(gain_db); ceil_s = db2g(tp_max); by_s = byp;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
tgt_set();
rst_dirty ? ( rst_dirty = 0; meter_reset(); );
auto_rst >= 0.5 && (play_state & 1) && !playing ? meter_reset();
tpr_dirty ? ( tpr_dirty = 0; tpl = tpr = 0; tpl_disp = tpr_disp = 0; );
playing = play_state & 1;
g_t = db2g(gain_db); ceil_t = db2g(tp_max);
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
xn = min(num_ch, 64) - 2;
pdc_bot_ch = 0; pdc_top_ch = 2 + max(xn, 0);
fa_fresh = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
rs_req ? (
  rs_req = 0; rs_f = 0; rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay;
  memset(DLINE, 0, 2048); memset(DRY, 0, 2048);
  memset(XCH, 0, 62 * 1024);
);
rw_l = spl0; rw_r = spl1;
(lim_on >= 0.5) != lim_eng ? (
  dip_g = max(dip_g - dip_c, 0);
  dip_g == 0 ? (
    lim_eng = lim_on >= 0.5; clear_lim();
    pdc_delay = lim_eng ? la_d : 0;
    dip_hold = pdc_delay + 8 + 2 * samplesblock;
  );
) : dip_hold > 0 ? dip_hold -= 1 : dip_g < 1 ? dip_g = min(dip_g + dip_c, 1);
g_s += (g_t - g_s) * c_kn;
ceil_s += (ceil_t - ceil_s) * c_kn;
xl = spl0 * g_s; xr = spl1 * g_s;

kl_ = kl.kw_run(rw_l); kr_ = kr.kw_run(rw_r);
sub_acc += kl_ * kl_ + kr_ * kr_;
sub_cnt += 1;
sub_cnt >= sub_len ? (
  SUBR[sub_i & 1023] = sub_acc / sub_len; sub_i += 1; sub_tot += 1;
  sub_acc = 0; sub_cnt = 0;
  e4 = (SUBR[(sub_i - 1) & 1023] + SUBR[(sub_i - 2) & 1023] + SUBR[(sub_i - 3) & 1023] + SUBR[(sub_i - 4) & 1023]) * 0.25;
  e30 = 0; k_ = 1; loop(30, e30 += SUBR[(sub_i - k_) & 1023]; k_ += 1; );
  e30 /= 30;
  m_disp = sub_tot >= 4 ? e2l(e4) : -200;
  s_disp = sub_tot >= 30 ? e2l(e30) : -200;
  playing ? (
    run_n += 1;
    run_n >= 4 ? gate_i(e4);
    i_disp = i_val;
  );
);

lim_eng ? (
  pk = max(tp_peak(0, xl), tp_peak(1, xr));
  gq = pk > ceil_s * 0.994 ? ceil_s * 0.994 / pk : 1;
  while (dq_t > dq_h && DQV[(dq_t - 1) & RMASK] >= gq) ( dq_t -= 1; );
  DQV[dq_t & RMASK] = gq; DQI[dq_t & RMASK] = tn; dq_t += 1;
  while (DQI[dq_h & RMASK] <= tn - la_w) ( dq_h += 1; );
  gmin = DQV[dq_h & RMASK];
  g_rl = gmin < g_rl ? gmin : g_rl + (gmin - g_rl) * c_lrel;
  g_sum += g_rl - GHIST[(wp - la_n) & RMASK]; GHIST[wp & RMASK] = g_rl;
  lg = min(g_sum / la_n, 1);
  DLINE[wp & RMASK] = xl; DLINE[1024 + (wp & RMASK)] = xr;
  ol = DLINE[(wp - la_d) & RMASK] * lg; orr = DLINE[1024 + ((wp - la_d) & RMASK)] * lg;
  wp += 1; tn += 1;
  (wp & 65535) == 0 ? ( g_sum = 0; k_ = 0; loop(la_n, g_sum += GHIST[(wp - 1 - k_) & RMASK]; k_ += 1; ); );
  ol = max(min(ol, ceil_s), -ceil_s); orr = max(min(orr, ceil_s), -ceil_s);
  lgr_d = max(lgr_d, -20 * log10(max(lg, 0.000001)));
) : (
  ol = xl; orr = xr;
);
dip_s = dip_g * dip_g * (3 - 2 * dip_g);
ol *= dip_s; orr *= dip_s;

playing ? (
  tpl = max(tpl, tp_peak(2, ol)); tpr = max(tpr, tp_peak(3, orr)); tpl_disp = tpl; tpr_disp = tpr;
) : ( TPH[128 + tp_w] = TPH[152 + tp_w] = TPH[192 + tp_w] = TPH[216 + tp_w] = 0; );
tp_w = (tp_w + 1) % 24;

spl0 = ol; spl1 = orr;
DRY[dw] = rw_l; DRY[1024 + dw] = rw_r;
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
  rs_s = rs_f * rs_f * (3 - 2 * rs_f); rs_xs = rs_x * rs_x * (3 - 2 * rs_x);
  rs_dl = rw_l + (DRY[(dw - pdc_delay) & RMASK] - rw_l) * rs_xs;
  rs_dr = rw_r + (DRY[1024 + ((dw - pdc_delay) & RMASK)] - rw_r) * rs_xs;
  spl0 = rs_dl + (spl0 - rs_dl) * rs_s; spl1 = rs_dr + (spl1 - rs_dr) * rs_s;
);
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? (
  rs_dl = DRY[(dw - pdc_delay) & RMASK]; rs_dr = DRY[1024 + ((dw - pdc_delay) & RMASK)];
  spl0 += (rs_dl - spl0) * by_s; spl1 += (rs_dr - spl1) * by_s;
);
xn > 0 ? (
  xs = rs_f < 1 ? rs_xs : 1; k_ = 0;
  loop(xn,
    XCH[k_ * 1024 + dw] = spl(k_ + 2);
    spl(k_ + 2) = (spl(k_ + 2) + (XCH[k_ * 1024 + ((dw - pdc_delay) & RMASK)] - spl(k_ + 2)) * xs) * dip_s;
    k_ += 1;
  );
);
dw = (dw + 1) & RMASK;
lat_d = pdc_delay;
mn_pk_d = max(mn_pk_d, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0xF29B91; mk_band = 0x14203A; mk_ink = 0xF4F1EA; mk_ink2 = 0xA8C4E4; mk_acc = 0xFFC860; mk_tab = 0x3FA7B5;
mk_sub = 0x1E2E4E; mk_sub2 = 0x141F38;
mk_ft = ui_mix(mk_face, 0xFFFFFF, 0.22); mk_fb = ui_mix(mk_face, 0x000000, 0.22);
GLASS = 0x0C1122; FIG = 0xF3EBD4; F_GRN = 0x6EE08E; F_BLU = 0x7FB4FF; F_RED = 0xFF6A55; TRACE2 = 0xD8E6FA; SCL = 0x8E9CC0;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
  mg_f15 = ui_fitarial(15, 52 * sc);
  mg_f16 = ui_fitarial(16, 28 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(15, "Arial", mg_f15, 'b'); gfx_setfont(16, "Arial", mg_f16, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c, tw, th) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  gfx_gradrect((x + b) * sc, (y + b) * sc, (w - 2 * b) * sc, (h - 2 * b) * sc, ((mk_sub >> 16) & 255) / 255, ((mk_sub >> 8) & 255) / 255, (mk_sub & 255) / 255, 1,
    0, 0, 0, 0, (((mk_sub2 >> 16) & 255) - ((mk_sub >> 16) & 255)) / 255 / ((h - 2 * b) * sc), (((mk_sub2 >> 8) & 255) - ((mk_sub >> 8) & 255)) / 255 / ((h - 2 * b) * sc), ((mk_sub2 & 255) - (mk_sub & 255)) / 255 / ((h - 2 * b) * sc), 0);
  ui_col(ui_mix(mk_sub, 0xFFFFFF, 0.12)); mg_r(x + 9, y + b + 33, w - 18, 1);
  gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(mk_ink); mg_ltxt(x + b + 36, y + b + 14, title); gfx_measurestr(title, tw, th);
  ui_col(mk_tab); mg_r(x + b + 36, y + b + 25, tw / sc, 3);
  ui_col(ui_mix(mk_sub, 0x000000, 0.4)); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
