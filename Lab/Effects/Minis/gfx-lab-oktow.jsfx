    mg_zero && i == (n - 1) / 2 ? hp_zero(cx, cy, r + 9) : ( ui_col(mk_ink2); mg_disc(cx + sin(t) * (r + 9), cy - cos(t) * (r + 9), i == 0 || i == n - 1 || i == (n - 1) / 2 ? 1.8 : 1.3); );
    i += 1; );
