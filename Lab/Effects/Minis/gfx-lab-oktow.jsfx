function hp_vig(x, y, r) local(i) ( i = 0; loop(6, ui_cola(0, 0.16 * (1 - i / 6)); gfx_circle(x * sc, y * sc, (r - i * 0.9) * sc, 0, 1); i += 1; ); );
function hp_pdot(cx, cy, a, kcr, col) ( ui_col(col); mg_disc(cx + sin(a) * kcr * 0.62, cy - cos(a) * kcr * 0.62, max(2, kcr * 0.19)); );
function hp_arcc(t) ( t < 0.55 ? ui_mix(mk_neon, 0xFFC81E, t / 0.55) : ui_mix(0xFFC81E, 0xFF3A2A, (t - 0.55) / 0.45); );
function hp_zero(cx, cy, rr) ( mg_zero ? ( gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(cx, cy - rr - 2, "0"); ); );
function hp_dialA(cx, cy, r, v, act) local(a, n, i, hq0, hq1, w, lo, hi, bp) (
