desc:OKTOW [pitch shifter] (GFX Lab)
//tags: pitch shifter harmony formant whammy mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider24:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:model=0<0,2,1{Octa,Dive,Chord}>-Model
slider2:o_pitch=0<-12,12,1>-Octa pitch (st)
slider3:o_form=0<-12,12,0.1>-Octa formant (st)
slider4:o_mode=0<0,2,1{Transpose,Quantize,Robot}>-Octa mode
slider5:o_link=0<0,1,1{Off,On}>-Octa link
slider6:d_int=1<0,22,1{2 oct up,Oct up,5th up,4th up,2nd down,4th down,5th down,Oct down,2 oct down,Dive bomb,Oct down / oct up,5th down / 4th down,4th down / 3rd down,5th up / 7th up,5th up / 6th up,4th up / 5th up,3rd up / 4th up,b3 up / 3rd up,2nd up / 3rd up,Detune shallow,Detune deep,Oct up + dry,Oct down + dry}>-Dive interval
slider7:d_smooth=0<0,1,1{Classic,Smooth}>-Dive engine
slider8:d_glide=10<0,200,1>-Dive glide (ms)
slider9:c_shift=7<-12,12,1>-Chord shift (st)
slider10:c_cents=0<-50,50,1>-Chord fine (cents)
slider11:c_delay=0<0,400,1>-Chord delay (ms)
slider12:c_fb=0<0,95,1>-Chord feedback (%)
slider13:c_blend=50<0,100,1>-Chord blend (%)
slider14:c_ext=0<0,1,1{Off,On}>-Chord extend
slider15:c_midi=1<0,1,1{Off,On}>-Chord MIDI play
slider16:whl=0<0,100,0.1>-Wheel (%)
slider17:drive=0<0,100,1>-Drive (%)
slider18:mix=100<0,100,1>-Mix (%)
slider19:out_db=0<-24,24,0.1>-Output level (dB)
slider20:drift=50<0,100,1>-Drift (%)
slider21:byp=0<0,1,1{Off,On}>-Bypass
slider22:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider23:prs_sel=0<0,13,1{No preset,Default,Octa: Chipmunk,Octa: Deep Voice,Octa: Hard Tune,Octa: Robot,Dive: Octave Up,Dive: Dive Bomb,Dive: Thirds,Dive: Detune,Chord: Fifth Above,Chord: Octave Cascade,Chord: Doubler,Chord: MIDI Harmony}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(16777215, v); );
function psw_allg(v) ( slider_show(16777215, v); );
#ui_man = "gfx-lab-oktow";
ext_noinit = 1;

DRY = 100000; DRYN = 16384;
BL = 200000; BR = 400000; CL = 540000; CR = 800000; BN = 131072;
YB = 700000; YN = 4096; YD = 710000;
GS = 720000; GW = 8; NG = 8;
NS = 730000;
IV = 740000;

D0 = floor(0.03 * srate + 0.5);
os_design(); os_base = D0; os_f = os_tf = os_f2n(os_sel);

function ivs(i, a, b, w) ( IV[i * 3] = a; IV[i * 3 + 1] = b; IV[i * 3 + 2] = w; );
ivs(0, 0, 24, 0); ivs(1, 0, 12, 0); ivs(2, 0, 7, 0); ivs(3, 0, 5, 0); ivs(4, 0, -2, 0); ivs(5, 0, -5, 0); ivs(6, 0, -7, 0);
ivs(7, 0, -12, 0); ivs(8, 0, -24, 0); ivs(9, 0, -36, 0);
ivs(10, -12, 12, 1); ivs(11, -7, -5, 1); ivs(12, -5, -4, 1); ivs(13, 7, 11, 1); ivs(14, 7, 9, 1); ivs(15, 5, 7, 1);
ivs(16, 4, 5, 1); ivs(17, 3, 4, 1); ivs(18, 2, 4, 1); ivs(19, 0, -0.1, 1); ivs(20, 0, -0.25, 1); ivs(21, 0, 12, 1); ivs(22, 0, -12, 1);

function bw(p) ( p - floor(p / BN) * BN; );
function rd(b, p) local(i, f, j0, j1, j2, j3, xm, x0, x1, x2, c1, c2, c3) (
  i = floor(p); f = p - i; j1 = bw(i); j0 = j1 >= 1 ? j1 - 1 : BN - 1; j2 = j1 + 1 < BN ? j1 + 1 : 0; j3 = j2 + 1 < BN ? j2 + 1 : 0;
  xm = b[j0]; x0 = b[j1]; x1 = b[j2]; x2 = b[j3];
  c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);

function st_f(u) ( u >= 0 ? u / (1 + 0.25 * u) : u / (1 - 1.2 * u); );
function st_ad(u) ( u >= 0 ? u / 0.25 - log(1 + 0.25 * u) / 0.0625 : -u / 1.2 - log(1 - 1.2 * u) / 1.44; );
function st_run(u) instance(u1, f1, ok) local(f, y) (
  !ok ? ( f1 = st_ad(u1); ok = 1; );
  f = st_ad(u);
  y = abs(u - u1) > 0.00001 ? (f - f1) / (u - u1) : st_f(0.5 * (u + u1));
  u1 = u; f1 = f; y;
);
function st_clr() instance(u1, f1, ok) ( u1 = 0; f1 = 0; ok = 0; );
function dr_cal(g, b) local(i, s, u, sb) (
  s = 0; i = 0; sb = st_f(b);
  loop(32, u = g * 0.17783 * sin(2 * $pi * (i + 0.5) / 32); s += sqr(st_f(u + b) - sb); i += 1; );
  sqrt(s / 32) / (g * 0.17783 * 0.70711);
);

function yin_run() local(j, tau, s, d, cm, best, bt, a, b, c, sh, tmax, tmin, wl, e, base, dn) (
  wl = 128; tmin = max(2, floor(y_fs / 1000)); tmax = min(floor(y_fs / 68), 300);
  base = y_w - wl - tmax + YN * 4; e = 0;
  j = 0; loop(wl, a = YB[(base + j) % YN]; e += a * a; j += 1; );
  YD[0] = 1; cm = 0; tau = 1; bt = 0; dn = 0;
  while (tau <= tmax && !dn) (
    s = 0; j = 0;
    loop(wl, d = YB[(base + j) % YN] - YB[(base + j + tau) % YN]; s += d * d; j += 1; );
    cm += s; YD[tau] = cm > 0 ? s * tau / cm : 1;
    bt > 0 ? ( YD[tau] < YD[bt] ? bt = tau : dn = 1; ) : tau >= tmin && YD[tau] < 0.12 ? bt = tau;
    tau += 1;
  );
  bt == 0 ? ( best = 9; tau = tmin; loop(tmax - tmin, YD[tau] < best ? ( best = YD[tau]; bt = tau; ); tau += 1; ); best > 0.3 ? bt = 0; );
  bt >= tmax ? bt = 0;
  e / wl < 0.00000003 ? bt = 0;
  bt > 0 ? (
    a = YD[bt - 1]; b = YD[bt]; c = YD[bt + 1]; sh = a - 2 * b + c;
    sh = abs(sh) > 0.0000001 ? 0.5 * (a - c) / sh : 0;
    y_T0 = (bt + max(-0.5, min(0.5, sh))) * y_dec; y_vo = 1;
  ) : y_vo = 0;
);

function g_clr() local(i) ( i = 0; loop(NG, GS[i * GW] = 0; i += 1; ); );
function oc_grain(T0, sc, fm) local(i, p, done) (
  i = 0; done = 0;
  loop(NG, p = GS + i * GW; !done && p[0] == 0 ? ( p[0] = 1; p[1] = sc - T0; p[2] = fm; p[3] = max(4, floor(2 * T0 / fm)); p[4] = 0; done = 1; ); i += 1; );
);

function clr_eng() (
  g_clr();
  oc_next = 0; oc_lsc = 0; ph = 0; ch_yl = ch_yr = 0; ch_ll = ch_lr = 0;
);
function clr_all() (
  clr_eng(); dkL.st_clr(); dkR.st_clr(); dcxl = dcyl = dcxr = dcyr = 0; memset(BL, 0, BN); memset(BR, 0, BN); memset(CL, 0, BN); memset(CR, 0, BN); memset(DRY, 0, DRYN * 2); memset(YB, 0, YN); UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr();
);

y_dec = max(1, floor(srate / 8000 + 0.5)); y_fs = srate / y_dec; y_w = 0; y_c = 0; y_h = 0; y_T0 = 0.005 * srate; y_vo = 0;
y_a = 1 - exp(-2 * $pi * 0.38 * y_fs / srate);
memset(YB, 0, YN);
tt = 0; dpos = 0; clr_all();
cur_m = model; e_sm = d_smooth > 0.5; e_ext = c_ext > 0.5; m_duck = 1; kdk = 1 / (0.008 * srate);
ksm = 1 - exp(-1 / (0.03 * srate)); ksw = 1 - exp(-1 / (0.015 * srate)); krt = 1 - exp(-1 / (0.008 * srate));
kpd = 1 - exp(-1 / (0.12 * srate)); d_rc = 1 - exp(-1 / (0.4 * srate));
ch_lp = 1 - exp(-2 * $pi * 9000 / srate);
dcc = 1 - 2 * $pi * 5 / srate;
oc_r = 1; oc_f = 1; dv_st = 0; ch_st = c_shift; ch_pd = c_delay * 0.001 * srate;
wh_v = whl / 100; whl_seen = whl; wh_s = wh_v;
g_in = 1; g_out = 10 ^ (out_db / 20); g_mix = mix / 100; g_dry = 0; g_bl = c_blend / 100;
dw = min(1, drive / 10); dg = 10 ^ (drive * 0.24 / 20);
ns_n = 0; bend = 0;
CRATE = 32; cc = 0;
DR1.drift_init(0.8 + rand(1) * 0.4); DR2.drift_init(0.8 + rand(1) * 0.4); DR3.drift_init(4 + rand(1)); DR4.drift_init(0.7 + rand(1) * 0.4);
drA = drB = drC = drD = 0;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
os_gsetup();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = D0 + os_lat(os_f);
by_setup(21);
pwr_init(); pwr_wu_loss = 0.6; pwr_wu_drv = 1.5; pwr_wu_lp = 9000; pwr_bloom = 0.1; pwr_sag = 0.12;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
rs_f = 1;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function pv(i, v) ( slider(i) = v; );
function sl_list() local(i) ( i = 1; loop(22, i != 21 ? slider_automate(2 ^ (i - 1)); i += 1; ); );
function p_init() (
  pv(1, 0); pv(2, 0); pv(3, 0); pv(4, 0); pv(5, 0); pv(6, 1); pv(7, 0); pv(8, 10); pv(9, 7); pv(10, 0); pv(11, 0);
  pv(12, 0); pv(13, 50); pv(14, 0); pv(15, 1); pv(16, 0); pv(17, 0); pv(18, 100); pv(19, 0); pv(20, 50);
);
function load_preset(p) (
  p_init();
  p == 2 ? ( pv(2, 7); pv(5, 1); );
  p == 3 ? ( pv(2, -5); pv(3, -3); pv(17, 20); );
  p == 4 ? ( pv(4, 1); );
  p == 5 ? ( pv(4, 2); pv(17, 35); );
  p == 6 ? ( pv(1, 1); pv(6, 1); );
  p == 7 ? ( pv(1, 1); pv(6, 9); pv(8, 40); );
  p == 8 ? ( pv(1, 1); pv(6, 17); );
  p == 9 ? ( pv(1, 1); pv(6, 19); pv(7, 1); pv(16, 100); );
  p == 10 ? ( pv(1, 2); pv(9, 7); pv(13, 50); );
  p == 11 ? ( pv(1, 2); pv(9, 12); pv(11, 140); pv(12, 55); pv(13, 45); );
  p == 12 ? ( pv(1, 2); pv(9, 0); pv(10, 9); pv(11, 22); pv(13, 45); pv(14, 1); );
  p == 13 ? ( pv(1, 2); pv(9, 0); pv(13, 50); pv(15, 1); );
  sl_list();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(22, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 13 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(13, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function params() local(b) (
  drift_macro(drift);
  b = 0.08 + (cur_m == 0 ? 0.05 * drA * dm_a : 0);
  t_dg = 10 ^ ((drive * 0.24 + (cur_m == 0 ? 0.8 * drB * dm_a : 0)) / 20);
  t_dw = min(1, drive / 10);
  t_db = b;
  t_dc = 1 / (t_dg * dr_cal(t_dg, t_db));
  t_out = 10 ^ (out_db / 20); t_mix = mix / 100; t_bl = c_blend / 100;
  t_wg = d_glide;
);

params(); dg = t_dg; dc_ = t_dc; dbs = t_db; g_mix = t_mix; g_out = t_out; g_bl = t_bl; dw = t_dw;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
params();
os_snap(slider(22));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; rs_c = 1 / (0.015 * srate); clr_all(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
while (midirecv(mo, m1, m2, m3)) (
  ms = m1 & 0xF0;
  ms == 0xB0 && m2 == 1 ? wh_v = m3 / 127 :
  ms == 0xB0 && (m2 == 120 || m2 == 123) ? ns_n = 0 :
  ms == 0x90 && m3 > 0 ? ( mi = 0; mf = 0; loop(ns_n, NS[mi] == m2 ? mf = 1; mi += 1; ); !mf && ns_n < 16 ? ( NS[ns_n] = m2; ns_n += 1; ); ) :
  ms == 0x80 || ms == 0x90 ? ( mi = 0; mj = 0; loop(ns_n, NS[mi] != m2 ? ( NS[mj] = NS[mi]; mj += 1; ); mi += 1; ); ns_n = mj; ) :
  ms == 0xE0 ? bend = ((m3 * 128 + m2) - 8192) / 8192;
  midisend(mo, m1, m2, m3);
);
whl != whl_seen ? ( wh_v = whl / 100; whl_seen = whl; );
wh_d = wh_v;
params();
ost_setup(0, 0, 100, 8000, -0.3, 1);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = D0 + os_lat(os_f);
pwr_block(byp < 0.5);
os_tf = os_f2n(os_sel);
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
mt_il_d = max(mt_il_d, sqrt(mt_il / max(samplesblock, 1))); mt_ir_d = max(mt_ir_d, sqrt(mt_ir / max(samplesblock, 1)));
mt_ol_d = max(mt_ol_d, sqrt(mt_ol / max(samplesblock, 1))); mt_or_d = max(mt_or_d, sqrt(mt_or / max(samplesblock, 1)));
mt_pl_d = max(mt_pl_d, mt_pl); mt_pr_d = max(mt_pr_d, mt_pr); mt_ql_d = max(mt_ql_d, mt_ql); mt_qr_d = max(mt_qr_d, mt_qr);
mt_il = mt_ir = mt_ol = mt_or = mt_pl = mt_pr = mt_ql = mt_qr = 0;
oc_f0_d = y_vo ? srate / y_T0 : 0; dv_st_d = dv_st; ch_st_d = ch_st; cur_m_d = cur_m; ns_d = ns_n;
os_snapb(slider(22));

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
mt_il += spl0 * spl0; mt_ir += spl1 * spl1; mt_ql = max(mt_ql, abs(spl0)); mt_qr = max(mt_qr, abs(spl1));
by_in();
os_gate();
os_chg ? ( UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr(); dkL.st_clr(); dkR.st_clr(); );
(cc -= 1) <= 0 ? (
  cc = CRATE;
  dspd = 0.05 * dm_s * CRATE / srate;
  drA = DR1.drift_tick(dspd); drB = DR2.drift_tick(dspd * 0.8); drC = DR3.drift_tick(dspd * 12); drD = DR4.drift_tick(dspd * 1.2);
);
dg += (t_dg - dg) * ksm; dc_ += (t_dc - dc_) * ksm; dbs += (t_db - dbs) * ksm;
g_out += (t_out - g_out) * ksm; g_mix += (t_mix - g_mix) * ksm; g_bl += (t_bl - g_bl) * ksm; dw += (t_dw - dw) * ksm;
model != cur_m || (d_smooth > 0.5) != e_sm || (c_ext > 0.5) != e_ext ? ( m_duck -= kdk; m_duck <= 0 ? ( m_duck = 0; cur_m = model; e_sm = d_smooth > 0.5; e_ext = c_ext > 0.5; clr_eng(); params(); ); ) : m_duck < 1 ? m_duck = min(1, m_duck + kdk);
wk = cur_m == 1 ? (t_wg > 0 ? 1 - exp(-1 / (t_wg * 0.001 * srate)) : 1) : ksm;
wh_s += (wh_v - wh_s) * wk;

pwr_in(spl0, spl1); xl = pwr_l; xr = pwr_r;
DRY[dpos * 2] = xl; DRY[dpos * 2 + 1] = xr;
rp = (dpos + DRYN - D0) % DRYN; el = DRY[rp * 2]; er = DRY[rp * 2 + 1];
rp = (dpos + DRYN - D0 - os_lat(os_f)) % DRYN; ml = DRY[rp * 2]; mr = DRY[rp * 2 + 1];
dpos = (dpos + 1) % DRYN;
tt += 1;
BL[bw(tt)] = xl; BR[bw(tt)] = xr;

cur_m == 0 ? (
  y_z1 += (0.5 * (xl + xr) - y_z1) * y_a; y_z2 += (y_z1 - y_z2) * y_a;
  (y_c += 1) >= y_dec ? ( y_c = 0; YB[y_w % YN] = y_z2; y_w += 1; (y_h += 1) >= 128 ? ( y_h = 0; yin_run(); ); );
  o_tr = 2 ^ ((o_pitch + 2 * bend) / 12);
  y_vo && o_mode > 0.5 ? (
    o_f0 = srate / y_T0;
    o_mode < 1.5 ? ( o_n = floor(69 + 12 * log(o_f0 * o_tr / 440) / log(2) + 0.5); o_tg = 440 * 2 ^ ((o_n - 69) / 12) / o_f0; )
                 : ( o_tg = 440 * 2 ^ ((48 + o_pitch - 69) / 12) / o_f0; );
    oc_r += (min(4, max(0.25, o_tg)) - oc_r) * krt;
  ) : oc_r += (o_tr - oc_r) * ksm;
  o_ft = 2 ^ ((o_form + 12 * wh_s) / 12) * (o_link > 0.5 ? oc_r : 1);
  oc_f += (min(2.5, max(0.4, o_ft)) - oc_f) * ksm;
  tt >= oc_next ? (
    o_T = y_vo ? min(0.0145 * srate, max(0.001 * srate, y_T0)) : 0.007 * srate;
    o_ct = tt - D0 + o_T;
    y_vo ? ( o_k = floor((o_ct - oc_lsc) / o_T + 0.5); o_sc = oc_lsc + o_k * o_T; abs(o_sc - o_ct) > o_T ? o_sc = o_ct; )
         : o_sc = o_ct + (rand(1) - 0.5) * o_T * 0.5;
    o_sc = min(o_sc, tt - o_T - 4);
    oc_grain(o_T, o_sc, oc_f);
    oc_lsc = o_sc;
    oc_next = max(oc_next + o_T / oc_r, tt - 1);
  );
  o_al = o_ar = 0; o_ws = 0; o_i = 0;
  loop(NG, o_p = GS + o_i * GW;
    o_p[0] ? (
      o_w = 0.5 - 0.5 * cos(2 * $pi * o_p[4] / o_p[3]);
      o_q = o_p[1] + o_p[2] * o_p[4];
      o_al += o_w * rd(BL, o_q); o_ar += o_w * rd(BR, o_q); o_ws += o_w;
      (o_p[4] += 1) >= o_p[3] ? o_p[0] = 0;
    );
    o_i += 1;
  );
  o_nm = 1 / max(o_ws, 1) * (oc_r > oc_f ? min(2.5, oc_r / oc_f) : min(2.5, sqrt(oc_f / oc_r)));
  wl = o_al * o_nm; wr = o_ar * o_nm;
) : cur_m == 1 ? (
  d_a = IV[d_int * 3]; d_b = IV[d_int * 3 + 1];
  dv_st += (d_a + (d_b - d_a) * wh_s - dv_st) * krt;
  g_dry += (IV[d_int * 3 + 2] - g_dry) * ksw;
  d_r = 2 ^ ((dv_st + dm_a * (0.025 * drD + 0.01 * drC)) / 12);
  d_W = (e_sm ? 0.056 : 0.040) * srate; d_mn = D0 - 0.5 * d_W;
  d_nt = e_sm ? 4 : 2;
  ph += (1 - d_r) / d_W; ph -= floor(ph);
  abs(dv_st) < 0.15 ? ( d_e = ph * d_nt; d_e -= floor(d_e + 0.5); ph -= d_e / d_nt * d_rc * (1 - abs(dv_st) / 0.15); ph -= floor(ph); );
  wl = wr = 0; d_k = 0;
