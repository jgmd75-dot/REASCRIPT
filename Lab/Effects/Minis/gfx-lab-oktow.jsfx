@gfx 900 355
ui_begin(900, 355);
mk_face = 0x2B2E2F; mk_band = 0x111314; mk_ink = 0xF2EAD2; mk_ink2 = 0xCBD6C6;
mk_cm = floor(model + 0.5);
mk_neon = mk_cm == 1 ? 0xFF3B30 : mk_cm == 2 ? 0x3FE6FF : 0x39FF6A;
mk_tab = mk_cm == 1 ? 0xE8352C : mk_cm == 2 ? 0x36CCE8 : 0x39E866;
mk_sub = mk_cm == 1 ? 0x3A1716 : mk_cm == 2 ? 0x14303A : 0x173A2A;
mk_acc = ui_mix(mk_neon, 0xFFFFFF, 0.3);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
