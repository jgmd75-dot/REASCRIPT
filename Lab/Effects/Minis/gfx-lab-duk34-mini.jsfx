dk_col != dk_lcol ? ( TRC[dk_col] = dk_g; dk_lcol = dk_col; ) : TRC[dk_col] = min(TRC[dk_col], dk_g);

DLL[dk_dw] = dk_xl; DLR[dk_dw] = dk_xr;
dk_rd = dk_dw - dk_la; dk_rd < 0 ? dk_rd += DLN;
dk_al = DLL[dk_rd]; dk_ar = DLR[dk_rd];
dk_dw += 1; dk_dw >= DLN ? dk_dw = 0;

dk_lg = exp(0.115129255 * dk_g);
