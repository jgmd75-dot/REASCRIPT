desc:DUK34 Mini [ducking compressor] (GFX Lab)
//tags: dynamics ducker ducking sidechain compressor pump pumping tempo sync volume shaper voice-over midi
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:0<0,2,1{Sidechain,MIDI,Grid}>-Trigger
slider2:2<0,4,1{1/1,1/2,1/4,1/8,1/16}>-Grid
slider3:0<0,1,1{On beat,Off beat}>-Grid offset
slider4:-24<-60,0,0.1>-Threshold (dBFS)
slider5:4<1.5,20,0.1>-Ratio
slider6:12<0,40,0.1>-Depth (dB)
slider7:1<0,1,1{Off (ms),On (notes)}>-Sync
slider8:0<0,2,1{Straight,Dotted,Triplet}>-Feel
slider9:0<0,4,1{Fast,1/128,1/64,1/32,1/16}>-Attack (synced)
slider10:0<0,5,1{0,1/64,1/32,1/16,1/8,1/4}>-Hold (synced)
slider11:2<0,6,1{1/32,1/16,1/8,1/4,1/2,1/1,2/1}>-Release (synced)
slider12:1<0,100,0.1>-Attack (ms)
slider13:0<0,1000,1>-Hold (ms)
slider14:250<10,4000,1>-Release (ms)
slider15:0<0,3,1{Linear,Fast,Slow,S-curve}>-Curve
slider16:0<0,10,0.1>-Lookahead (ms)
slider17:0<0,3,1{Full,Lows,Mid,Side}>-Focus
slider18:150<40,400,1>-Crossover (Hz)
slider19:0<0,4,1{Off,60 Hz,100 Hz,150 Hz,250 Hz}>-SC HPF
slider20:100<0,100,1>-Mix (%)
slider21:0<-12,12,0.1>-Output (dB)
slider22:0<0,100,1>-Fizz (%)
slider23:50<0,100,1>-Drift (%)
slider24:0<0,1,1{Off,On}>-Bypass
slider25:0<0,2,1{1x,2x,4x}>-Oversampling
slider26:prs_sel=0<0,12,1{No preset,Init,Kick Ducks Bass,Classic Pump,Half-Time Pump,Triplet Pump,Sixteenth Chop,Off-Beat Breath,MIDI Pump,Side Pump,Gentle Glue Pump,Voice-Over Duck,Podcast Music Bed}>-Preset

in_pin:left input
in_pin:right input
in_pin:key left
in_pin:key right
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-duk34-mini";
ext_noinit = 1;

function dk_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function dk_attn(i) ( i == 0 ? 0 : i == 1 ? 4 / 128 : i == 2 ? 4 / 64 : i == 3 ? 4 / 32 : 4 / 16; );
function dk_hldn(i) ( i == 0 ? 0 : i == 1 ? 4 / 64 : i == 2 ? 4 / 32 : i == 3 ? 4 / 16 : i == 4 ? 4 / 8 : 1; );
function dk_reln(i) ( i == 0 ? 4 / 32 : i == 1 ? 4 / 16 : i == 2 ? 4 / 8 : i == 3 ? 1 : i == 4 ? 2 : i == 5 ? 4 : 8; );
function dk_grid(i) ( i == 0 ? 4 : i == 1 ? 2 : i == 2 ? 1 : i == 3 ? 0.5 : 0.25; );
function dk_hpf(i) ( i == 1 ? 60 : i == 2 ? 100 : i == 3 ? 150 : 250; );
function dk_shape(x, c) ( x = min(max(x, 0), 1);
  c == 0 ? 1 - x : c == 1 ? (1 - x) * (1 - x) * (1 - x) : c == 2 ? 1 - x * x * x : 1 - x * x * (3 - 2 * x); );
function dk_lp(o, f, q) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 - cw) * 0.5 / n; o[1] = (1 - cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function dk_hp(o, f, q) local(w, cw, al, n) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  o[0] = (1 + cw) * 0.5 / n; o[1] = -(1 + cw) / n; o[2] = o[0]; o[3] = -2 * cw / n; o[4] = (1 - al) / n;
);
function dk_bq(x, o) instance(s1, s2) local(y) ( y = o[0] * x + s1; s1 = o[1] * x - o[3] * y + s2; s2 = o[2] * x - o[4] * y; y; );
function dk_bqz() instance(s1, s2) ( s1 = s2 = 0; );
CLP = 100000; CHP = 100010; CSC = 100020;
DLL = 101000; DLR = 104000; DLN = 2900;
TRC = 108000; TRN = 192;
MQ = 109000;

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);
function dk_osclr() ( uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr(); fz_clr(); );

#dk_pm = "Init|Kick Ducks Bass|Classic Pump|Half-Time Pump|Triplet Pump|Sixteenth Chop|Off-Beat Breath|MIDI Pump|Side Pump|Gentle Glue Pump|Voice-Over Duck|Podcast Music Bed";
function dk_set(tg, gd, of, th, ra, dp, sy, fe, at, hd, rl, am, hm, rm, cv, la, fo, xo, sh, mx) (
  slider1 = tg; slider2 = gd; slider3 = of; slider4 = th; slider5 = ra; slider6 = dp; slider7 = sy; slider8 = fe;
  slider9 = at; slider10 = hd; slider11 = rl; slider12 = am; slider13 = hm; slider14 = rm; slider15 = cv; slider16 = la;
  slider17 = fo; slider18 = xo; slider19 = sh; slider20 = mx;
);
function load_preset(p) (
  p == 1  ? ( dk_set(0, 2, 0, -24, 4,  12, 1, 0, 0, 0, 2, 1,  0,   250,  0, 0, 0, 150, 0, 100); slider21 = 0; slider22 = 0; slider23 = 50; ) :
  p == 2  ? dk_set(0, 2, 0, -30, 10, 9,  1, 0, 0, 0, 2, 1,  0,   250,  1, 2, 1, 150, 1, 100) :
  p == 3  ? dk_set(2, 2, 0, -24, 4,  18, 1, 0, 0, 0, 3, 1,  0,   250,  3, 0, 0, 150, 0, 100) :
  p == 4  ? dk_set(2, 1, 0, -24, 4,  15, 1, 0, 0, 0, 4, 1,  0,   250,  3, 0, 0, 150, 0, 100) :
  p == 5  ? dk_set(2, 3, 0, -24, 4,  12, 1, 2, 0, 0, 2, 1,  0,   250,  0, 0, 0, 150, 0, 100) :
  p == 6  ? dk_set(2, 4, 0, -24, 4,  24, 1, 0, 0, 0, 0, 1,  0,   250,  2, 0, 0, 150, 0, 100) :
  p == 7  ? dk_set(2, 2, 1, -24, 4,  6,  1, 0, 2, 0, 2, 1,  0,   250,  3, 0, 0, 150, 0, 100) :
  p == 8  ? dk_set(1, 2, 0, -24, 4,  15, 1, 1, 0, 0, 2, 1,  0,   250,  3, 0, 0, 150, 0, 100) :
  p == 9  ? dk_set(0, 2, 0, -30, 6,  8,  1, 0, 0, 0, 3, 1,  0,   250,  0, 0, 3, 150, 1, 100) :
  p == 10 ? dk_set(0, 2, 0, -24, 2,  4,  1, 0, 1, 0, 3, 1,  0,   250,  0, 0, 0, 150, 0, 100) :
  p == 11 ? dk_set(0, 2, 0, -40, 2,  10, 0, 0, 0, 0, 2, 20, 300, 800,  0, 5, 0, 150, 3, 100) :
  p == 12 ? dk_set(0, 2, 0, -42, 3,  15, 0, 0, 0, 0, 2, 40, 600, 1500, 3, 5, 0, 150, 3, 100);
  slider_automate(2 ^ 23 - 1);
);

function dk_clear() (
  memset(DLL, 0, DLN); memset(DLR, 0, DLN); dk_dw = 0;
  ll1.dk_bqz(); ll2.dk_bqz(); hl1.dk_bqz(); hl2.dk_bqz(); lr1.dk_bqz(); lr2.dk_bqz(); hr1.dk_bqz(); hr2.dk_bqz();
  sca.dk_bqz(); scb.dk_bqz();
  dk_cur = 0; dk_g = 0; dk_ms = 0; dk_ph = 1; dk_hc = 0; dk_r0 = 0; dk_nh = 0;
  dk_osclr();
);
function dk_srinit() (
  dk_sr = srate;
  dk_kd = 1 - exp(-1 / (0.001 * srate));
  dk_kg = 1 - exp(-1 / (0.0003 * srate));
  dk_gsm = 1 - exp(-1 / (0.02 * srate));
  dk_fis = 1 / (0.01 * srate);
  dk_xoi = -1; dk_sci = -1;
  fz_coefs(srate * os_f);
  dk_clear();
  ost_init(0);
);
os_design();
os_f = os_tf = os_f2n(slider25); os_base = 0;
dk_srinit();
in_init();
dV.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
dk_snap = 1; dk_vel = 1; dk_free = 0; dk_fi = 1; fz_o = 0;
memset(TRC, 0, TRN);
os_gsetup();
pwr_init(); pwr_wu_loss = 0.4; pwr_wu_drv = 0.5; pwr_wu_lp = 11000; pwr_wu_wob = 0.15; pwr_bloom = 0;
by_setup(24);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(25, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); dk_snap = 1;
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

function dk_lat() (
  dk_trg = floor(min(max(slider1, 0), 2) + 0.5);
  dk_la = dk_trg == 2 ? 0 : floor(min(max(slider16, 0), 10) * 0.001 * srate + 0.5);
  dk_la = min(dk_la, DLN - 4);
  os_base = dk_la;
);

@slider
prs_chk();
dk_lat();
os_snap(slider(25));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != dk_sr ? dk_srinit();
dk_now = time_precise();
dk_tp > 0 && dk_now - dk_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > dk_gpp && play_position - dk_gpp < 4 * dk_gpd + 0.05) ? ( dk_clear(); dk_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
dk_tp = dk_now; dk_gpp = play_position; dk_gpd = samplesblock / srate;
pwr_block(slider24 < 0.5);
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider25);
drift_macro(slider23);
dk_vv = dV.drift_tick(0.05 * dm_s * samplesblock / srate);
dk_tmp = max(tempo, 20);
dk_spb = 60 / dk_tmp * srate;
dk_fl = slider8 < 0.5 ? 1 : slider8 < 1.5 ? 1.5 : 2 / 3;
slider7 >= 0.5 ? (
  dk_A = dk_attn(floor(slider9 + 0.5)) * dk_fl * dk_spb; floor(slider9 + 0.5) == 0 ? dk_A = 0.0005 * srate;
  dk_H = dk_hldn(floor(slider10 + 0.5)) * dk_fl * dk_spb;
  dk_R = dk_reln(floor(slider11 + 0.5)) * dk_fl * dk_spb;
) : (
  dk_A = max(slider12, 0.5) * 0.001 * srate; dk_H = slider13 * 0.001 * srate; dk_R = max(slider14, 10) * 0.001 * srate;
);
dk_A = max(dk_A, 1); dk_R = max(dk_R, 1);
dk_cv = floor(min(max(slider15, 0), 3) + 0.5);
dk_Dt = min(max(slider6, 0), 40) * (1 + 0.015 * dm_a * dk_vv);
dk_th = slider4; dk_sl = 1 - 1 / max(slider5, 1);
dk_foc = floor(min(max(slider17, 0), 3) + 0.5);
xoi = floor(slider18 + 0.5); xoi != dk_xoi ? ( dk_xoi = xoi; dk_lp(CLP, xoi, 0.70710678); dk_hp(CHP, xoi, 0.70710678); );
sci = floor(min(max(slider19, 0), 4) + 0.5); sci != dk_sci ? ( dk_sci = sci; sci > 0 ? dk_hp(CSC, dk_hpf(sci), 0.70710678); );
dk_lat();
dk_mxt = min(max(slider20, 0), 100) / 100;
dk_ott = 10 ^ (min(max(slider21, -12), 12) / 20);
dk_fzt = 0.33 * min(max(slider22, 0), 100) / 100;
dk_bps = dk_tmp / 60 / srate;
(play_state & 1) ? dk_bp0 = beat_position : ( dk_bp0 = dk_free; );
dk_free = (play_state & 1) ? beat_position + samplesblock * dk_bps : dk_free + samplesblock * dk_bps;
dk_S = dk_grid(floor(min(max(slider2, 0), 4) + 0.5)); dk_off = slider3 >= 0.5 ? dk_S * 0.5 : 0;
dk_P = dk_S * dk_spb;
dk_snap ? ( dk_D = dk_Dt; dk_mxs = dk_mxt; dk_ots = dk_ott; dk_fzs = dk_fzt; );
dk_snap = 0;
dk_qn = 0; dk_qr = 0;
while (midirecv(mofs, m1, m2, m3)) (
  midisend(mofs, m1, m2, m3);
  st = m1 & 0xF0;
  dk_trg == 1 && (st == 0x90 || st == 0x80) && dk_qn < 128 ? (
    MQ[dk_qn * 3] = mofs; MQ[dk_qn * 3 + 1] = st == 0x90 && m3 > 0; MQ[dk_qn * 3 + 2] = m3 / 127; dk_qn += 1;
  );
  st == 0xB0 && (m2 == 123 || m2 == 120) ? dk_nh = 0;
);
dk_n = 0;
dk_kl_d = max(dk_kl_d, dk_kl); dk_kl = 0;
dk_vu_d = max(dk_vu_d, sqrt(dk_msq / max(samplesblock, 1))); dk_msq = 0;
dk_pk_d = max(dk_pk_d, dk_pkm); dk_pkm = 0;
dk_bp_d = dk_bp0; dk_S_d = dk_S; dk_A_d = dk_A; dk_H_d = dk_H; dk_R_d = dk_R; dk_tmp_d = dk_tmp; dk_la_d = dk_la;
dk_cur = dk_tn(dk_cur); dk_g = dk_tn(dk_g); dk_ms = dk_tn(dk_ms);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_base + os_lat(os_f);
os_snapb(slider(25));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0; spl2 != spl2 ? spl2 = 0; spl3 != spl3 ? spl3 = 0;
by_in();
in_process(spl0, spl1);
dk_xl = in_l; dk_xr = in_r;
dk_D += (dk_Dt - dk_D) * dk_gsm; dk_mxs += (dk_mxt - dk_mxs) * dk_gsm; dk_ots += (dk_ott - dk_ots) * dk_gsm;
dk_fzs += (dk_fzt - dk_fzs) * dk_gsm; dk_fzs < 0.000001 && dk_fzt == 0 ? dk_fzs = 0;
dk_bp = dk_bp0 + dk_n * dk_bps;

dk_trg == 2 ? (
  dk_t = (dk_bp - dk_off) / dk_S; dk_t = (dk_t - floor(dk_t)) * dk_P;
  dk_e = dk_t < dk_H ? 1 : dk_shape((dk_t - dk_H) / dk_R, dk_cv);
  dk_t >= dk_P - dk_A ? dk_e = max(dk_e, (dk_t - (dk_P - dk_A)) / dk_A);
  dk_tgt = -dk_D * dk_e; dk_cur = dk_tgt;
) : (
  dk_trg == 0 ? (
    dk_ka = spl2; dk_kb = spl3;
    dk_sci > 0 ? ( dk_ka = sca.dk_bq(dk_ka, CSC); dk_kb = scb.dk_bq(dk_kb, CSC); );
    dk_lv = max(abs(dk_ka), abs(dk_kb));
    dk_ms += (dk_lv > dk_ms ? 1 : dk_kd) * (dk_lv - dk_ms);
    dk_kl = max(dk_kl, dk_lv);
    dk_ov = 20 * log10(max(dk_ms, 0.0000001)) - dk_th;
    dk_ov = dk_ov <= -3 ? 0 : dk_ov >= 3 ? dk_ov : sqr(dk_ov + 3) / 12;
    dk_tgt = -min(dk_ov * dk_sl, dk_D);
  ) : (
    while (dk_qr < dk_qn && MQ[dk_qr * 3] <= dk_n) (
      MQ[dk_qr * 3 + 1] ? ( dk_nh += 1; dk_vel = MQ[dk_qr * 3 + 2]; ) : dk_nh = max(dk_nh - 1, 0);
      dk_qr += 1;
    );
    dk_tgt = dk_nh > 0 ? -dk_D * dk_vel : 0;
    dk_kl = max(dk_kl, dk_nh > 0 ? dk_vel : 0);
  );
  dk_tgt < dk_cur - 0.001 ? (
    dk_cur = max(dk_cur - max(dk_D, 6) / dk_A, dk_tgt); dk_ph = 0; dk_hc = dk_H; dk_r0 = dk_cur;
  ) : dk_hc > 0 ? (
    dk_hc -= 1; dk_r0 = dk_cur; dk_ph = 0;
  ) : (
    dk_ph = min(dk_ph + 1 / dk_R, 1);
    dk_rv = dk_r0 * dk_shape(dk_ph, dk_cv);
    dk_rv < dk_tgt ? dk_cur = dk_rv : ( dk_cur = dk_tgt; dk_r0 = dk_cur; dk_ph = 0; );
  );
);
dk_n += 1;
dk_g += dk_kg * (dk_cur - dk_g);

