dk_yl = dk_al + dk_mxs * (dk_yl - dk_al); dk_yr = dk_ar + dk_mxs * (dk_yr - dk_ar);
dk_yl *= dk_ots; dk_yr *= dk_ots;

pwr_in(dk_yl, dk_yr); dk_yl = pwr_l; dk_yr = pwr_r;
