os_f == 1 ? (
  fz_o > 0.0001 ? ( fz_l = dk_yl; fz_r = dk_yr; fz_run(); dk_ql = fz_l; dk_qr2 = fz_r; ) : ( dk_ql = dk_yl; dk_qr2 = dk_yr; );
) : (
