desc:Combo 72 Mini [combo organ] (GFX Lab)
//tags: instrument organ combo transistor divider vintage 70s mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-sliders.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider27:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:ft16=0.6<0,1,0.001>-16' level
slider2:ft8=0.8<0,1,0.001>-8' level
slider3:ft4=0.6<0,1,0.001>-4' level
slider4:ft223=0<0,1,0.001>-2 2/3' level
slider5:ft2=0.4<0,1,0.001>-2' level
slider6:ft135=0<0,1,0.001>-1 3/5' level
slider7:wave=1<0,3,1{Flute,Square,Pulse,Narrow}>-Wave
slider8:voicing=1<0,3,1{Open,Reed,Brass,String}>-Voicing
slider9:perc_on=0<0,1,1{Off,On}>-Percussion
slider10:perc_ft=0<0,1,1{4',2 2/3'}>-Percussion footage
slider11:perc_dec=300<80,2000,1:log>-Percussion decay (ms)
slider12:perc_lvl=0.6<0,1,0.001>-Percussion level
slider13:key_clk=0.83<0,1,0.001>-Key click
slider14:vib_mode=0<0,3,1{Off,Vibrato,Chorus,Ensemble}>-Vibrato mode
slider15:vib_rate=6<0.01,10,0.001:log>-Vibrato speed (Hz)
slider16:vib_depth=0.5<0,1,0.001>-Vibrato depth
slider17:bass=0<-12,12,0.1>-Bass (dB)
slider18:brill=0<-12,12,0.1>-Brilliance (dB)
slider19:sustain=12<5,2000,1:log>-Sustain (ms)
slider20:spr_dwell=0.5<0,1,0.001>-Spring dwell
slider21:spr_mix=0.15<0,1,0.001>-Spring mix
slider22:tune=0<-100,100,0.1>-Tune (cents)
slider23:drift=50<0,100,1>-Drift (%)
slider24:vol=0<-24,6,0.1>-Volume (dB)
slider25:sat=0<0,100,1>-Sat (%)
slider26:prs_sel=0<0,16,1{No preset,Init,Sixties Combo,Soft Flutes,Reed Solo,Full Combo,Percussive Keys,Brass Tabs,String Chorus,Spring Ballad,Surf Combo,Thin Pulse,Ensemble Strings,Rock Combo,Bossa Keys,Late Night Flute,Church Hall}>-Preset

@init
function psw_all(v) ( slider_show(134217727, v); );
function psw_allg(v) ( slider_show(134217727, v); );
#ui_man = "gfx-lab-g-combo-72-mini";
ext_noinit = 1;
gfx_ext_retina = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

KG = 0;     KE = 128;   KP = 256;   KS = 384;   KT = 512;
AKL = 640;
PLT = 800;  PL = 940;   PSTP = 1080;
PIV = 1220; PMK = 1360; PPC = 1500;
PLS = 1640;
PKO = 2000;
TWA = 2200; TWB = 2340; TWT = 2480; TWD = 2620;
TWK = 2760; TWP = 2900;
MPH = 1780; MCN = 1792; MIN0 = 1804; MINC = 1816;
DRV = 1830; DRT = 1842; DRM = 1854;
FOFS = 1870;
VBL = 4096;  VB_N = 8192;
SPM = 16384;
MQ = 131072;  MQMAX = 1000;

FOFS[0] = -12;  FOFS[1] = 0;  FOFS[2] = 12;  FOFS[3] = 19;  FOFS[4] = 24;  FOFS[5] = 28;
memset(KG, 0, 640);  memset(PLT, 0, 420);
k = 0;  loop(128, KT[k] = rand(2) - 1;  k += 1; );
k = 0;
loop(129,
  PPC[k] = k % 12;
  PMK[k] = 2 ^ floor((120 + (k % 12) - k) / 12) - 1;
  PIV[k] = 1 / (PMK[k] + 1);
  PKO[k] = floor((120 + (k % 12) - k) / 12) * TSTR;
  k += 1;
);
k = 0;
loop(12,
  MPH[k] = rand(1);  MCN[k] = floor(rand(1024));
  MIN0[k] = 440 * 2 ^ ((120 + k - 69) / 12) / srate;
  DRV[k] = rand(2) - 1;  DRT[k] = rand(2) - 1;  DRM[k] = rand(3);
  k += 1;
);
memset(VBL, 0, VB_N);  vb_w = 0;
k = 0;
loop(129,
  TWA[k] = 0;  TWB[k] = rand(1) < 0.35 ? 0 : (rand(2) - 1) * 2;  TWD[k] = 3 + rand(1) * 2;  TWT[k] = rand(1) * TWD[k];
  TWK[k] = 0;  TWP[k] = 0;
  k += 1;
);
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
drf_sup.drift_init(0.9);  drf_vib.drift_init(1.1);

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
WT = 262144;  TSTR = 2056;  TN = 2048;  FB = 196608;
function build_tables() local(w, k, n, nmax, wd, a, b, i, t) (
  w = 0;
  loop(4,
    wd = w == 1 ? 0.5 : w == 2 ? 0.25 : 0.125;
    k = 0;
    loop(11,
      nmax = min(TN / 2 - 1, floor(0.47 * srate / (15804 / 2 ^ k * 1.19)));
      memset(FB, 0, TN * 2);
      n = 1;
      loop(nmax,
        w == 0 ? (
          (n & 1) ? ( a = -4 / ($pi * $pi * n * n);  b = 0; ) : ( a = 0;  b = 0; );
        ) : (
          t = 2 / ($pi * n) * sin($pi * n * wd);
          a = t * cos($pi * n * wd);  b = -t * sin($pi * n * wd);
        );
        FB[2 * n] = a;  FB[2 * n + 1] = b;  FB[2 * (TN - n)] = a;  FB[2 * (TN - n) + 1] = -b;
        n += 1;
      );
      fft_ipermute(FB, TN);  ifft(FB, TN);
      t = WT + (w * 11 + k) * TSTR;
      i = 0;  loop(TN, t[i] = FB[2 * i];  i += 1; );  t[TN] = t[0];
      k += 1;
    );
    w += 1;
  );
);
build_tables();
function tone(tb, q) local(x, i) (
  x = q * TN;  i = floor(x);
  tb[i] + (tb[i + 1] - tb[i]) * (x - i);
);

function bq_peak(c, f, q, db) local(w, a, al, cs, a0) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate;  a = 10 ^ (db / 40);  al = sin(w) / (2 * q);  cs = cos(w);
  a0 = 1 + al / a;
  c[0] = (1 + al * a) / a0;  c[1] = -2 * cs / a0;  c[2] = (1 - al * a) / a0;  c[3] = -2 * cs / a0;  c[4] = (1 - al / a) / a0;
);
function bq_hp(c, f, q) local(w, al, cs, a0) (
  w = 2 * $pi * min(f, 0.45 * srate) / srate;  al = sin(w) / (2 * q);  cs = cos(w);  a0 = 1 + al;
  c[0] = (1 + cs) * 0.5 / a0;  c[1] = -(1 + cs) / a0;  c[2] = (1 + cs) * 0.5 / a0;  c[3] = -2 * cs / a0;  c[4] = (1 - al) / a0;
);
function bq_run(c, x) instance(x1, x2, y1, y2) local(y) (
  y = c[0] * x + c[1] * x1 + c[2] * x2 - c[3] * y1 - c[4] * y2;
  x2 = x1;  x1 = x;  y2 = y1;  y1 = y;
  y;
);
BQV1 = 1900;  BQV2 = 1910;  BQHP = 1920;  BQN1 = 1930;  BQN2 = 1940;

function voicing_set(c1, c2, v) (
  v < 0.5 ? ( bq_peak(c1, 1100, 1, 0);  bq_peak(c2, 3300, 1, 0); ) :
  v < 1.5 ? ( bq_peak(c1, 1100, 1.4, 5.5);  bq_peak(c2, 3300, 2, 4); ) :
  v < 2.5 ? ( bq_peak(c1, 660, 1, 5);  bq_peak(c2, 2200, 1.4, 4.5); ) :
            ( bq_peak(c1, 220, 0.7, -7);  bq_peak(c2, 4400, 1.5, 6); );
);

function ap1(x, a) instance(z) local(y) ( y = -a * x + z;  z = x + a * y;  y; );
function spring_init(mem) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, lc) (
  b1 = mem;  n1 = floor(0.0371 * srate);  b2 = mem + n1 + 8;  n2 = floor(0.0433 * srate);
  memset(mem, 0, n1 + n2 + 16);  w1 = 0;  w2 = 0;  lp1 = 0;  lp2 = 0;
  lc = 1 - exp(-2 * $pi * 3800 / srate);
);
function spring_run(x, gfb) instance(b1, b2, n1, n2, w1, w2, lp1, lp2, lc, s1, s2, d1, d2, d3, d4, d5, d6, e1, e2, e3, e4) local(y) (
  y = d6.ap1(d5.ap1(d4.ap1(d3.ap1(d2.ap1(d1.ap1(x, 0.62), 0.62), 0.62), 0.62), 0.62), 0.62);
  s1 = b1[w1];  s2 = b2[w2];
  lp1 += (s1 - lp1) * lc;  lp2 += (s2 - lp2) * lc;
  b1[w1] = y + e1.ap1(e2.ap1(lp2 * gfb, 0.5), 0.5);
  b2[w2] = y + e3.ap1(e4.ap1(lp1 * gfb, 0.5), 0.5);
  w1 += 1;  w1 >= n1 ? w1 = 0;  w2 += 1;  w2 >= n2 ? w2 = 0;
);
spr.spring_init(SPM);
bq_hp(BQHP, 33, 0.6);

function key_on(n) local(i, f) (
  f = 0;  i = 0;  loop(ak_n, AKL[i] == n ? f = 1;  i += 1; );
  !f && ak_n < 128 ? ( AKL[ak_n] = n;  ak_n += 1; );
  KG[n] = 1;  KS[n] = 0;
  KP[n] = 1;
  ck_e = min(1, ck_e + 0.8);
);
function key_off(n) (
  KG[n] ? ( sustain_p ? KS[n] = 1;  KG[n] = 0;  ck_e = min(1, ck_e + 0.3); );
);
function pedal_up() local(i) ( i = 0;  loop(128, KS[i] = 0;  i += 1; ); );
function all_off() local(i) ( i = 0;  loop(128, KG[i] = 0;  KS[i] = 0;  i += 1; ); );

function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? key_on(d1) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? key_off(d1) :
  st == 0xE0 ? bend_t = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  sustain_p && !c ? pedal_up();  sustain_p = c; ) :
    (d1 == 123 || d1 == 120) ? all_off();
  );
);

function add_pitch(p, lv) (
  p >= 0 ? ( while (p > 108) ( p -= 12; );  PLT[p] += lv; );
);

function ctl_tick() local(i, j, n, e, pe, g, keep, nk, pt, f) (
  memset(PLT, 0, 129);
  nk = 0;  i = 0;  j = 0;
  loop(ak_n,
    n = AKL[i];
    e = KE[n];
    (KG[n] || KS[n]) ? ( e = min(1, e + k_ainc);  nk += 1; ) : e *= k_rc;
    KE[n] = e;
    pe = KP[n] * p_dc;  KP[n] = pe;
    keep = KG[n] || KS[n] || e > 0.0001;
    keep ? (
      AKL[j] = n;  j += 1;
      g = e * (1 + KT[n] * 0.06 * dm_a);
      add_pitch(n - 12, g * l16);  add_pitch(n, g * l8);  add_pitch(n + 12, g * l4);
      add_pitch(n + 19, g * l223);  add_pitch(n + 24, g * l2);  add_pitch(n + 28, g * l135);
      pc_s > 0.0001 ? add_pitch(n + pc_ofs, g * pe * pc_s);
    ) : ( KE[n] = 0;  KP[n] = 0; );
    i += 1;
  );
  ak_n = j;
  pl_n = 0;  i = 0;
  loop(129,
    pt = PLT[i];
    (pt > 0 || PL[i] > 0.000001) ? ( PSTP[i] = (pt - PL[i]) / CR;  PLS[pl_n] = i;  pl_n += 1; ) : ( PL[i] = 0;  PSTP[i] = 0; );
    i += 1;
  );
  bend_s += (bend_t - bend_s) * bd_k;
  sag_s += (min(nk, 10) - sag_s) * sag_k;
  f = 2 ^ ((tune + wu_c + bend_s * 100 + (sup_v * 2 - sag_s * 0.4) * dm_a) / 1200);
  i = 0;
  loop(12, MINC[i] = MIN0[i] * f * 2 ^ (DRV[i] * 3 * dm_a / 1200);  i += 1; );
  keys_d = nk;
);

function update_params() (
  drift_macro(drift);
  l16_t = ft16;  l8_t = ft8;  l4_t = ft4;  l223_t = ft223;  l2_t = ft2;  l135_t = ft135;
  k_ainc = CR / (0.002 * srate);
  k_rc = exp(-6.9 * CR / (sustain * 0.001 * srate));
  p_dc = exp(-4.6 * CR / (perc_dec * 0.001 * srate));
  pc_t = perc_on >= 0.5 ? perc_lvl * 1.4 : 0;
  pc_ofs = perc_ft >= 0.5 ? 19 : 12;
  ck_t = key_clk * 0.027;
  wv_t = floor(wave + 0.5);  vc_t = floor(voicing + 0.5);
  (wv_t != wv_l || vc_t != vc_l) ? dk_req = 1;
  voicing_set(BQN1, BQN2, vc_t);
  bs_t = 10 ^ (bass / 20) - 1;  br_t = 10 ^ (brill / 20) - 1;
  vm = floor(vib_mode + 0.5);
  vdry_t = vm == 0 ? 1 : vm == 1 ? 0 : vm == 2 ? 0.72 : 0.55;
  vwa_t = vm == 1 ? 1 : vm == 2 ? 0.72 : 0;
  ven_t = vm == 3 ? 0.78 : 0;
  vdp_t = (0.00004 + 0.0006 * vib_depth) * srate;
  spm_t = spr_mix;  sfb = 0.55 + 0.35 * spr_dwell;
  outg_t = 10 ^ (vol / 20) * 0.09;
);

lc_8k = 1 - exp(-2 * $pi * 8800 / srate);
lc_bs = 1 - exp(-2 * $pi * 220 / srate);  lc_br = 1 - exp(-2 * $pi * 2200 / srate);
smk = 1 - exp(-1 / (0.015 * srate));
dk_st = 1 / (0.005 * srate);
bd_k = 1 - exp(-CR / (0.01 * srate));  sag_k = 1 - exp(-CR / (0.4 * srate));
dc_r = 1 - 2 * $pi * 5 / srate;
ck_dc = exp(-1 / (0.003 * srate));
ak_n = 0;  pl_n = 0;  cr_n = 0;  bend_t = 0;  bend_s = 0;  sag_s = 0;  sustain_p = 0;  ck_e = 0;  sup_v = 0;
vb_c = 1;  vb_s = 0;  en_c = 1;  en_s = 0;

update_params();
wv_l = wv_t;  vc_l = vc_t;  dk = 1;  dk_req = 0;  memcpy(BQV1, BQN1, 5);  memcpy(BQV2, BQN2, 5);
wv_tb = WT + wv_l * 11 * TSTR;  wv_g = wv_l == 0 ? 0.9 : wv_l == 1 ? 0.56 : wv_l == 2 ? 1.15 : 2.1;
l16 = l16_t;  l8 = l8_t;  l4 = l4_t;  l223 = l223_t;  l2 = l2_t;  l135 = l135_t;  pc_s = pc_t;  ck_s = ck_t;
bs_s = bs_t;  br_s = br_t;  vdry = vdry_t;  vwa = vwa_t;  ven = ven_t;  vdp = vdp_t;  spm_s = spm_t;  out_g = outg_t;

function sl_auto_au(idx) ( slider_automate(2 ^ (idx - 1)); );
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
function pv(i, v) ( slider(i) = v; );
function p_init() (
  pv(1, 0.6); pv(2, 0.8); pv(3, 0.6); pv(4, 0); pv(5, 0.4); pv(6, 0); pv(7, 1); pv(8, 1);
  pv(9, 0); pv(10, 0); pv(11, 300); pv(12, 0.6); pv(13, 0.83);
  pv(14, 0); pv(15, 6); pv(16, 0.5); pv(17, 0); pv(18, 0); pv(19, 12);
  pv(20, 0.5); pv(21, 0.15); pv(22, 0); pv(23, 50); pv(24, 0); pv(25, 0);
);
function load_preset(p) local(i) (
  p_init();
  p == 2 ? (
    pv(1, 0.3); pv(2, 1); pv(3, 0.8); pv(5, 0.7); pv(14, 1); pv(15, 6.5); pv(16, 0.55); pv(18, 3); pv(21, 0.18); pv(24, -2.5);
  ) :
  p == 3 ? (
    pv(1, 0.4); pv(2, 0.9); pv(3, 0.5); pv(5, 0); pv(7, 0); pv(8, 0); pv(14, 2); pv(15, 5.5); pv(16, 0.4); pv(18, -3); pv(19, 120); pv(21, 0.25); pv(24, -1);
  ) :
  p == 4 ? (
    pv(1, 0); pv(2, 1); pv(3, 0.5); pv(4, 0.4); pv(5, 0); pv(7, 2); pv(14, 1); pv(15, 6.8); pv(16, 0.6); pv(18, 2); pv(24, -3);
  ) :
  p == 5 ? (
    pv(1, 1); pv(2, 0.9); pv(3, 0.8); pv(4, 0.5); pv(5, 0.8); pv(6, 0.4); pv(8, 2); pv(14, 2); pv(15, 6.5); pv(21, 0.2); pv(24, -7.5);
  ) :
  p == 6 ? (
    pv(1, 0.4); pv(2, 0.9); pv(3, 0); pv(5, 0); pv(8, 0); pv(9, 1); pv(11, 260); pv(12, 0.8); pv(13, 1); pv(24, 4);
  ) :
  p == 7 ? (
    pv(1, 0.7); pv(2, 1); pv(3, 0.7); pv(5, 0); pv(7, 2); pv(8, 2); pv(14, 1); pv(15, 5.5); pv(16, 0.3); pv(18, 2); pv(24, -5.2);
  ) :
  p == 8 ? (
    pv(1, 0); pv(2, 1); pv(3, 0.8); pv(5, 0.5); pv(7, 3); pv(8, 3); pv(14, 2); pv(15, 5); pv(16, 0.7); pv(19, 300); pv(21, 0.3); pv(24, -1);
  ) :
  p == 9 ? (
    pv(1, 0); pv(2, 1); pv(3, 0.3); pv(5, 0); pv(7, 0); pv(9, 1); pv(10, 1); pv(11, 700); pv(12, 0.5); pv(14, 1); pv(15, 5.8); pv(16, 0.45); pv(19, 200); pv(20, 0.7); pv(21, 0.35); pv(24, 2.7);
  ) :
  p == 10 ? (
    pv(1, 0); pv(2, 1); pv(3, 1); pv(5, 1); pv(6, 0.5); pv(14, 1); pv(15, 7); pv(16, 0.7); pv(18, 4); pv(20, 0.75); pv(21, 0.45); pv(24, -5.9);
  ) :
  p == 11 ? (
    pv(1, 0); pv(2, 1); pv(3, 0); pv(5, 0.4); pv(7, 3); pv(8, 0); pv(14, 2); pv(17, -4); pv(24, -0.9);
  ) :
  p == 12 ? (
    pv(1, 0.3); pv(2, 1); pv(3, 0.7); pv(5, 0.4); pv(7, 3); pv(8, 3); pv(14, 3); pv(15, 6); pv(16, 0.6); pv(18, 1); pv(19, 450); pv(21, 0.25); pv(24, 1.4);
  ) :
  p == 13 ? (
    pv(1, 0.5); pv(2, 1); pv(3, 0.9); pv(4, 0.3); pv(5, 0.8); pv(9, 1); pv(11, 180); pv(12, 0.7); pv(13, 1); pv(14, 2); pv(15, 7); pv(16, 0.4); pv(18, 4); pv(21, 0.12); pv(24, -6);
  ) :
  p == 14 ? (
    pv(1, 0); pv(2, 0.8); pv(3, 0.4); pv(5, 0); pv(7, 0); pv(8, 0); pv(9, 1); pv(10, 1); pv(11, 420); pv(12, 0.7); pv(13, 1); pv(14, 1); pv(15, 5.2); pv(16, 0.35); pv(19, 60); pv(21, 0.2); pv(24, 4.1);
  ) :
  p == 15 ? (
    pv(1, 0.5); pv(2, 0.9); pv(3, 0.2); pv(5, 0); pv(7, 0); pv(8, 0); pv(14, 3); pv(15, 4); pv(16, 0.45); pv(18, -4); pv(19, 250); pv(21, 0.3); pv(24, 3.1);
  ) :
  p == 16 ? (
    pv(1, 0.8); pv(2, 1); pv(3, 0.7); pv(5, 0.6); pv(7, 0); pv(8, 1); pv(14, 1); pv(15, 5.5); pv(16, 0.25); pv(19, 600); pv(20, 0.85); pv(21, 0.5); pv(24, -2.5);
  ) : 0;
  i = 1;  loop(25, sl_auto_au(i);  i += 1; );
  prm_dirty = 1;
);

PR_N = 16;
function prs_hash() local(i, h) ( h = 0; i = 1; loop(26, i != 26 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= PR_N ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(PR_N, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function gap_clear() (
  memset(VBL, 0, VB_N);  spr.spring_init(SPM);
  fm1.x1 = fm1.x2 = fm1.y1 = fm1.y2 = 0;  fm2.x1 = fm2.x2 = fm2.y1 = fm2.y2 = 0;  hpf.x1 = hpf.x2 = hpf.y1 = hpf.y2 = 0;
  t_l = t_h = o_lp = 0;  dc_xl = dc_pl = dc_xr = dc_pr = 0;  ck_e = 0;  ck_h = ck_l = 0;
  ostL.ost_ch_init();  ostR.ost_ch_init();
  gf = 0;
);
gf = 1;  gfi = 1 / (0.015 * srate);

pwr_init(); pwr_hum_db = -51;  pwr_sag = 0.3;  pwr_wu_loss = 0.6;  pwr_wu_drv = 1;  pwr_wu_lp = 9000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update_params();

@block
prs_chk();
pwr_block(1);
wu_c = (1 - pwr_gm) * (-8 + 3 * pwr_w1);
prm_dirty ? ( prm_dirty = 0;  update_params(); );
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
  (m_st & 0xF0) == 0x90 && m_d2 > 0 ? midi_hit_d = 1;
);
panic_dirty ? ( sustain_p = 0;  all_off();  panic_dirty = 0; );
gc_now = time_precise();
gc_tp > 0 && gc_now - gc_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > gc_gpp && play_position - gc_gpp < 4 * gc_gpd + 0.05) ? gap_clear();
gc_tp = gc_now;  gc_gpp = play_position;  gc_gpd = samplesblock / srate;
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? all_off();  tp_was = tp_now;
t_b = samplesblock / srate;
k = 0;
loop(12,
  DRM[k] -= t_b * dm_s;  DRM[k] <= 0 ? ( DRT[k] = rand(2) - 1;  DRM[k] = 2 + rand(3); );
  DRV[k] += (DRT[k] - DRV[k]) * min(1, t_b * dm_s / 1.5);
  k += 1;
);
sup_v = drf_sup.drift_tick(t_b * 0.2 * dm_s);
vb_dv = drf_vib.drift_tick(t_b * 0.25 * dm_s);
t_a = 2 * $pi * vib_rate * (1 + 0.08 * dm_a * vb_dv) / srate;  vb_ca = cos(t_a);  vb_sa = sin(t_a);
t_a = 1 / sqrt(max(vb_c * vb_c + vb_s * vb_s, 0.0001));  vb_c *= t_a;  vb_s *= t_a;
vb_disp = vb_s;
k = 0;
loop(129,
  TWT[k] += t_b;
  TWT[k] >= TWD[k] ? (
    TWA[k] = TWB[k];  TWT[k] = 0;  TWD[k] = 3 + rand(1) * 2;
    TWB[k] = rand(1) < 0.35 ? 0 : max(-2, min(2, TWA[k] + (rand(2) - 1) * 2));
  );
  t_a = TWA[k] + (TWB[k] - TWA[k]) * (0.5 - 0.5 * cos($pi * TWT[k] / TWD[k]));
  TWK[k] = t_a * dm_a * 0.000577623;
  k += 1;
);
vb_base = 0.003 * srate;
t_a = 2 * $pi * vib_rate * 0.1 * (1 + 0.08 * dm_a * vb_dv) / srate;  en_ca = cos(t_a);  en_sa = sin(t_a);
t_a = 1 / sqrt(max(en_c * en_c + en_s * en_s, 0.0001));  en_c *= t_a;  en_s *= t_a;
en_base = 0.006 * srate;
spr_live = spm_t > 0.0005 || spm_s > 0.0005;
!spr_was && spr_live ? spr.spring_init(SPM);  spr_was = spr_live;
ost_setup(sat * 0.01, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = 0;
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

l16 += (l16_t - l16) * smk;  l8 += (l8_t - l8) * smk;  l4 += (l4_t - l4) * smk;
l223 += (l223_t - l223) * smk;  l2 += (l2_t - l2) * smk;  l135 += (l135_t - l135) * smk;
pc_s += (pc_t - pc_s) * smk;  ck_s += (ck_t - ck_s) * smk;  bs_s += (bs_t - bs_s) * smk;  br_s += (br_t - br_s) * smk;
vdry += (vdry_t - vdry) * smk;  vwa += (vwa_t - vwa) * smk;  ven += (ven_t - ven) * smk;  vdp += (vdp_t - vdp) * smk;
spm_s += (spm_t - spm_s) * smk;  out_g += (outg_t - out_g) * smk;
dk_req ? (
  dk -= dk_st;
  dk <= 0 ? (
    dk = 0;  wv_l = wv_t;  vc_l = vc_t;  dk_req = 0;
    wv_tb = WT + wv_l * 11 * TSTR;  wv_g = wv_l == 0 ? 0.9 : wv_l == 1 ? 0.56 : wv_l == 2 ? 1.15 : 2.1;
    memcpy(BQV1, BQN1, 5);  memcpy(BQV2, BQN2, 5);
  );
) : dk < 1 ? dk = min(1, dk + dk_st);

cr_n <= 0 ? ( cr_n = CR;  ctl_tick(); );
cr_n -= 1;

k = 0;
loop(12,
  u_ph = MPH[k] + MINC[k];  u_ph >= 1 ? ( u_ph -= 1;  MCN[k] = (MCN[k] + 1) & 1023; );  MPH[k] = u_ph;
  k += 1;
);
bus = 0;  k = 0;
loop(pl_n,
  u_p = PLS[k];
  u_lv = PL[u_p] + PSTP[u_p];  PL[u_p] = u_lv;
  u_m = PPC[u_p];  u_iv = PIV[u_p];
  u_q = TWP[u_p] + MINC[u_m] * u_iv * TWK[u_p];
  u_q >= 1 ? u_q -= 1 : u_q < 0 ? u_q += 1;  TWP[u_p] = u_q;
  u_q += ((MCN[u_m] & PMK[u_p]) + MPH[u_m]) * u_iv;  u_q >= 1 ? u_q -= 1;
  bus += tone(wv_tb + PKO[u_p], u_q) * u_lv;
  k += 1;
);
ck_e > 0.0001 ? (
  u_n = rand(2) - 1;  ck_h += (u_n - ck_h) * lc_br;  ck_l += (u_n - ck_h - ck_l) * 0.5;
  bus += ck_l * ck_e * ck_s * 20;  ck_e *= ck_dc;
) : ck_e = 0;

pwr_in(bus, bus);  bus = pwr_l;
y = ts(bus * wv_g * 0.12) * 4.2;
y = fm2.bq_run(BQV2, fm1.bq_run(BQV1, y));
t_l += (y - t_l) * lc_bs;  t_h += (y - t_h) * lc_br;
y += t_l * bs_s + (y - t_h) * br_s;
y = hpf.bq_run(BQHP, y);
o_lp += (y - o_lp) * lc_8k;  y = o_lp * out_g * dk;

VBL[vb_w] = y;
u_c = vb_c * vb_ca - vb_s * vb_sa;  vb_s = vb_s * vb_ca + vb_c * vb_sa;  vb_c = u_c;
(vwa > 0.0001) ? (
  u_d = vb_w - (vb_base + vdp * vb_s);  u_d < 0 ? u_d += VB_N;
  u_i = floor(u_d);  u_f = u_d - u_i;
  u_a = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
  u_d = vb_w - (vb_base - vdp * vb_s);  u_d < 0 ? u_d += VB_N;
  u_i = floor(u_d);  u_f = u_d - u_i;
  u_b = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
) : ( u_a = 0;  u_b = 0; );
u_bw = vib_mode >= 1.5 && vib_mode < 2.5 ? 1 : 0;  vbw += (u_bw - vbw) * smk;
u_dly = VBL[(vb_w - floor(vb_base) + VB_N) & (VB_N - 1)];
vb_w = (vb_w + 1) & (VB_N - 1);
yl = u_dly * vdry + u_a * vwa;
yr = u_dly * vdry + (u_a + (u_b - u_a) * vbw) * vwa;
u_c = en_c * en_ca - en_s * en_sa;  en_s = en_s * en_ca + en_c * en_sa;  en_c = u_c;
ven > 0.0001 ? (
  u_e = vdp * 2.6;  u_f2 = 0.0001 * srate * (0.3 + vib_depth);
  u_d = vb_w - (en_base + u_e * en_s + u_f2 * vb_s);  u_d < 0 ? u_d += VB_N;
  u_i = floor(u_d);  u_f = u_d - u_i;  u_e1 = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
  u_d = vb_w - (en_base + u_e * (-0.5 * en_s + 0.8660254 * en_c) + u_f2 * vb_c);  u_d < 0 ? u_d += VB_N;
  u_i = floor(u_d);  u_f = u_d - u_i;  u_e2 = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
  u_d = vb_w - (en_base + u_e * (-0.5 * en_s - 0.8660254 * en_c) - u_f2 * vb_s);  u_d < 0 ? u_d += VB_N;
  u_i = floor(u_d);  u_f = u_d - u_i;  u_e3 = VBL[u_i] + (VBL[(u_i + 1) & (VB_N - 1)] - VBL[u_i]) * u_f;
  yl += (u_e1 + 0.5 * u_e2) * ven;  yr += (u_e3 + 0.5 * u_e2) * ven;
);

spr_live ? (
  spr.spring_run((yl + yr) * 0.5, sfb);
  yl += spr.s1 * spm_s * 0.7;  yr += spr.s2 * spm_s * 0.7;
);

dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;
ost_out(ostL.ost_band(yl), ostR.ost_band(yr));  yl = ost_l;  yr = ost_r;
gf < 1 ? ( gf = min(1, gf + gfi);  u_g = gf * gf * (3 - 2 * gf);  yl *= u_g;  yr *= u_g; );
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@gfx 900 355
function v4rd_c(c) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = 1; );
function v4rd_mx(c, t, f) ( (floor(((c >> 16) & 255) * (1 - f) + ((t >> 16) & 255) * f) << 16) + (floor(((c >> 8) & 255) * (1 - f) + ((t >> 8) & 255) * f) << 8) + floor((c & 255) * (1 - f) + (t & 255) * f); );
function v4rd(gx0, gy0, k, rad, c1, c2, c3) local(q, i, yd, gx, hw, j, n, xl, xr, il, ir, rr) (
  q = k * rad / 17;
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 17 * q, 1, 1);
  v4rd_c(0xE8EBEE); gfx_circle(gx0, gy0, 15 * q, 1, 1);
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 13 * q, 1, 1);
  i = 0;
  loop(3,
    v4rd_c(i == 0 ? c1 : i == 1 ? c2 : c3);
    yd = -12.2 + i * 2.6;
    gx = gx0 + 0.5; hw = sqrt(max(sqr(13.6) - sqr(yd + 0.8), 0)) * q;
    j = floor(gy0 + yd * q + 1); n = max(1, floor(1.6 * q));
    xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
    hw > 0 ? loop(n,
      il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
        gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
        gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
        gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
      );
      j += 1;
    );
    i += 1;
  );
  v4rd_c(0xE8EBEE);
  rr = 13 * q + 0.75; while (rr <= 15 * q - 0.75) ( gfx_circle(gx0, gy0, rr, 0, 1); rr += 0.5; );
  gfx_a = 1;
);
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(ink, 1); gfx_measurestr("DRIFT", tw, th);
  gfx_x = dk_ox + cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr("DRIFT");
);
C_PANEL = 0x202326;  C_SEC1 = 0x4C5159;  C_SEC2 = 0x2A2D32;
C_INK = 0xECE6D8;  C_INK2 = 0xB9B3A6;  C_TITLE = 0xF29A3A;  C_DIM = 0x9A9CA0;  C_RIV = 0x55585E;
C_HEAD = 0x1B1D20;  C_ST1 = 0xF29A3A;  C_ST2 = 0xD8462E;  C_ST3 = 0xEDE3CC;
C_LCDBG = 0x120D05;  C_LCDTX = 0xFFB547;  lk_well = 0x111214;
LK_AMB = 0xF2A41E;  LK_ORG = 0xF28A2E;  LK_YEL = 0xF2C230;  LK_RED = 0xE8503A;  LK_WHT = 0xEDE3CC;
CP_BRN = 0xD9B48C;  CP_CRM = 0xF1EAD8;  CP_COR = 0xF2A68E;  CP_BLU = 0xAFCBE6;  CP_GRN = 0xBFDDB4;
CP_YEL = 0xF2DE8A;  CP_LIL = 0xCDBDEB;  CP_GRY = 0xC9C9C4;

function col(h, a) (
  gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a;
);
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));
  b = min(255, floor((h % 256) * f));  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 +
  floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function text_l(x, y, str) local(w, h) (
  gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str);
);
function rivet(x, y) (
  col(C_RIV, 1);  gfx_circle(px(x), py(y), ps(3.5), 1, 1);
  col(0xFFFFFF, 0.45); gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.2), 1, 1);
);
function section(x, y, w, h, c, title) (
  col(c, 1);  u_rect(x, y, w, h);
  col(0x000000, 0.28);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h - 2);
  col(0xFFFFFF, 0.12);  u_rect(x, y, w - 2, 1);  u_rect(x, y, 1, h - 2);
  gfx_setfont(4);  col(C_INK, 1);  text_l(px(x + 16), py(y + 20), title);
  gfx_measurestr(title, s_tw, s_th);  col(C_TITLE, 1);  u_rect(x + 16, y + 32, s_tw / sc, 3);
);
NOTE_LIST = "C|C#|D|Eb|E|F|F#|G|Ab|A|Bb|B";
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1,
    c = k < len ? str_getchar(menu, k) : 124;
    c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );
    k += 1;
  );
  dst;
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v * 100 + 0.5) :
  fmt == 3 ? ( v < 10 ? sprintf(#kv, "%.1f ms", v) : v < 1000 ? sprintf(#kv, "%d ms", v) : sprintf(#kv, "%.2f s", v / 1000); ) :
  fmt == 4 ? sprintf(#kv, "%d %%", v) :
  fmt == 7 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 10 ? ( v < 1 ? sprintf(#kv, "%.2f Hz", v) : sprintf(#kv, "%.1f Hz", v); ) :
  fmt == 15 ? sprintf(#kv, "%+.1f c", v) :
  fmt == 19 ? sprintf(#kv, "%.1f", v * 8) :
              sprintf(#kv, "%.2f", v);
  #kv;
);
function dshadow(x, y, r) local(i) (
  i = 0;
  loop(4, col(0x000000, 0.08);  gfx_circle(x + ps(1.5 + i * 0.9), y + ps(2 + i * 1.1), r + ps(i * 0.5), 1, 1);  i += 1; );
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r,
    d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);
    gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);
    i += 1;
  );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) (
  gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.55 + 0.5); gfx_drawstr(str);
);

function kn(cx, cy, r, idx, vmin, vmax, def, cap, lbl, fmt)
  local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lgt, st, dm, zr, capr, dr, nd, ly)
(
  lgt = klog;  klog = 0;  st = kstep;  kstep = 0;  dm = kdim;  kdim = 0;  zr = kzero;  kzero = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.25);
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t;  drag_y0 = mouse_y; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx && abs(mouse_y - drag_y0) >= 3 ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 200)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st :
    lgt ? ( j = 10 ^ (floor(log10(v)) - 2);  v = floor(v / j + 0.5) * j; ) : v = floor(v * 1000 + 0.5) / 1000;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    drag_y0 = -100000;
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  nd = 2;
  j = 0;
  loop(nd,
    b = nd == 2 ? (j ? a1 : a0) : a0 + j / 2 * (a1 - a0);
    col(C_INK2, 0.9);
    gfx_circle(x + sin(b) * (rr + ps(7)), y - cos(b) * (rr + ps(7)), max(1, ps(nd == 3 && j == 1 ? 1.4 : 1.8)), 1, 1);
    j += 1;
  );
  zr ? ( gfx_setfont(5);  col(C_INK2, 1);  text_c(x, y - rr - ps(10), "0"); );
  dshadow(x, y, rr);
  col(0x17181B, 1);  gfx_circle(x, y, rr, 1, 1);
  col(0x3A3D42, 1);  gfx_circle(x, y, rr - ps(1), 0, 1);
  col(0xFFFFFF, 0.10);  gfx_arc(x, y, rr - ps(1.5), -1.9, -0.2, 1);
  capr = rr * 0.74;
  col(dm ? shade(cap, 0.55) : cap, 1);  gfx_circle(x, y, capr, 1, 1);
  col(0x000000, 0.10);  gfx_arc(x, y, capr - ps(0.5), -3.1, 3.1, 1);
  col(0x000000, 0.10);  gfx_arc(x, y, capr - ps(0.5), 0.3, 2.8, 1);  gfx_arc(x, y, capr - ps(1.5), 0.6, 2.5, 1);
  col(0xFFFFFF, 0.35);  gfx_arc(x, y, capr - ps(1), -1.7, -0.3, 1);
  dr = max(2, capr * 0.19);
  col(dm ? 0x55534E : 0x26221C, 1);  gfx_circle(x + sin(tv) * capr * 0.62, y - cos(tv) * capr * 0.62, dr, 1, 1);
  ly = y + rr + ps(klo);
  hov || drag_idx == idx ? ( gfx_setfont(3);  col(C_LCDTX, 1);  text_c(x, ly, fmtv(v, fmt)); )
                         : ( gfx_setfont(6);  col(dm ? C_DIM : C_INK, 1);  text_c(x, ly, lbl); );
);

function lever(x, y0, h, idx, def, cap, lbl) local(t, v, cy, hov, now, j, cx, k)
(
  cx = px(x);
  v = slider(idx);  t = v;
  hov = abs(mouse_x - cx) < ps(22) && mouse_y >= py(y0 - 14) && mouse_y <= py(y0 + h + 14);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? (
      slider(idx) = def;  param_touched(idx);  drag_idx = 0;
    ) : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
    t != slider(idx) ? ( slider(idx) = t;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? h * 5 : h)));
    t = floor(t * 1000 + 0.5) / 1000;
    t != slider(idx) ? ( slider(idx) = t;  param_touched(idx); );
  );
  t = slider(idx);
  cy = y0 + h * (1 - t);
  col(0x0B0C0D, 1);  lk_rr(x - 5, y0 - 4, 10, h + 8, 4);
  col(0x000000, 0.5);  u_rect(x - 4, y0 - 3, 8, 2);
  col(0xFFFFFF, 0.08);  u_rect(x - 5, y0 + h + 3, 10, 1);
  j = 0;
  loop(2,
    col(C_INK2, 0.85);
    gfx_circle(px(x - 18), py(y0 + h - j * h), max(1, ps(1.8)), 1, 1);
    gfx_circle(px(x + 18), py(y0 + h - j * h), max(1, ps(1.8)), 1, 1);
    j += 1;
  );
  j = 0;  loop(4, col(0x000000, 0.08);  lk_rr(x - 15 + 1.5 + j * 0.9, cy - 9 + 2 + j * 1.1, 30 + j * 0.5, 18 + j * 0.5, 3);  j += 1; );
  col(shade(cap, 0.62), 1);  lk_rr(x - 15, cy - 9, 30, 18, 3);
  col(cap, 1);  lk_rr(x - 14, cy - 9, 28, 16.5, 3);
  col(0x000000, 0.08);  lk_rr(x - 14, cy - 9, 28, 16.5, 3);
  col(cap, 1);  lk_rr(x - 12, cy - 7.5, 24, 12.5, 2);
  col(0xFFFFFF, 0.45);  u_rect(x - 11, cy - 8.2, 22, 1.2);
  col(shade(cap, 0.55), 1);  u_rect(x - 10, cy - 1, 20, 2);
  col(0xFFFFFF, 0.35);  u_rect(x - 10, cy + 1, 20, 1);
  hov || drag_idx == idx ? ( gfx_setfont(3);  col(C_LCDTX, 1);  text_c(px(x), py(y0 + h + 26), fmtv(v, 19)); )
                         : ( gfx_setfont(9);  col(C_INK, 1);  text_c(px(x), py(y0 + h + 26), lbl); );
);

function rk_tab(x, y, w, h, on, c, str) local(hov, hit, i, lens, m)
(
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  i = 0;  loop(4, col(0x000000, 0.08);  lk_rr(x - 3 + 1.5 + i * 0.9, y - 3 + 2 + i * 1.1, w + 6, h + 6, 5);  i += 1; );
  on ? ( col(c, 0.12);  lk_rr(x - 9, y - 9, w + 18, h + 18, 10);  col(c, 0.18);  lk_rr(x - 6, y - 6, w + 12, h + 12, 8); );
  col(lk_well, 1);  lk_rr(x - 3, y - 3, w + 6, h + 6, 5);
  lens = on ? c : shade(ui_mix(c, 0xCFC9BC, 0.45), 0.62);
  m = y + h * 0.5;
  on ? (
    col(shade(lens, 0.78), 1);  lk_rr(x, y, w, h * 0.5 + 2, 4);
    col(lens, 1);  lk_rr(x, m, w, h * 0.5, 4);
    col(ui_mix(lens, 0xFFFFFF, 0.18), 1);  lk_rr(x + 4, m + 3, w - 8, h * 0.5 - 8, 3);
    col(ui_mix(lens, 0xFFFFFF, 0.32), 1);  lk_rr(x + 8, m + 6, w - 16, h * 0.5 - 14, 3);
    col(0x000000, 0.35);  u_rect(x + 1, m - 1, w - 2, 1.5);
  ) : (
    col(lens, 1);  lk_rr(x, y, w, h * 0.5 + 2, 4);
    col(shade(lens, 0.72), 1);  lk_rr(x, m, w, h * 0.5, 4);
    col(0x000000, 0.12);  lk_rr(x + 1, y + 1, w - 2, h - 2, 4);
    col(lens, 1);  lk_rr(x + 3, y + 3, w - 6, h * 0.5 - 4, 3);
    col(0x000000, 0.4);  u_rect(x + 1, m + 1, w - 2, 1.5);
  );
  col(0xFFFFFF, on ? 0.45 : 0.25);  u_rect(x + 4, y + 1, w - 8, 1.5);
  hov ? ( col(0xFFFFFF, 0.07);  lk_rr(x, y, w, h, 4); );
  gfx_setfont(2);  col(on ? shade(c, 0.28) : 0x1C1A16, 1);
  ui_keytext(px(x + w * 0.5), py(on ? m + h * 0.25 : y + h * 0.25 + 1), str);
  hit;
);

function lcd_box(x, y, w, h) (
  col(0x000000, 0.5);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(0x050403, 1);  u_rect(x, y, w, h);
  col(C_LCDBG, 1);   u_rect(x + 3, y + 3, w - 6, h - 6);
  col(0xFFFFFF, 0.06);  u_rect(x + 4, y + 4, w - 8, 1);
);
function lcd_text(x, y, fnt, str) local(tw, th, gy) (
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y) - th * 0.5;
  col(C_LCDTX, 0.22);
  gfx_x = px(x) - 1;  gfx_y = gy;  gfx_drawstr(str);
  gfx_x = px(x) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x);  gfx_y = gy;  gfx_drawstr(str);
);
function lcd(x, y, w, h, fnt, str) ( lcd_box(x, y, w, h);  lcd_text(x + 10, y + h * 0.5, fnt, str); );

function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  i = 0;  loop(4, col(0x000000, 0.08);  lk_rr(x - 4 * k + 1.5 + i * 0.9, y - 4 * k + 2 + i * 1.1, w + 8 * k, h + 8 * k, 5 * k);  i += 1; );
  on ? (
    col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);
    col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k);
  );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4,
      t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;
      dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);
      i += 1;
    );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);

function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_tri(cx, cy, s, dir) (
  gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s));
);
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, LK_ORG, "PRESETS") ? open = 1;
  lk_key(x + 96, y + 3, 24, h - 6, 0, LK_ORG, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 122, y + 3, 24, h - 6, 0, LK_ORG, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1A1A, 1);  pb_tri(x + 108, y + h * 0.5, 4.5, -1);  pb_tri(x + 134, y + h * 0.5, 4.5, 1);
  lx = x + 152;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  strcat(#pb_m, "|");  i += 1; );
    strcat(#pb_m, "Reset all to defaults");
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
function dsp_menu(x, y, w, h, idx, list, n, lbl) local(t, sel, i) (
  t = floor(slider(idx) + 0.5);
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(x + w * 0.5), py(y - 13), lbl);
  lcd(x, y, w, h, 7, pb_item(list, t + 1, #lm));
  col(C_LCDTX, 0.8);  pb_tri(x + w - 14, y + h * 0.5, 4, 1);
  click && !drag_idx && mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h) ? (
    strcpy(#lmm, "");  i = 0;
    loop(n, i == t ? strcat(#lmm, "!");  strcat(#lmm, pb_item(list, i + 1, #lmt));  i < n - 1 ? strcat(#lmm, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h + 4);  sel = gfx_showmenu(#lmm);
    sel > 0 ? ( slider(idx) = sel - 1;  param_touched(idx); );
  );
);

WAVE_LIST = "FLUTE|SQUARE|PULSE|NARROW";
VOIC_LIST = "OPEN|REED|BRASS|STRING";
PRESET_MENU = "Init|Sixties Combo|Soft Flutes|Reed Solo|Full Combo|Percussive Keys|Brass Tabs|String Chorus|Spring Ballad|Surf Combo|Thin Pulse|Ensemble Strings|Rock Combo|Bossa Keys|Late Night Flute|Church Hall";

function panic_key(x, y, w, h) local(hov, hit, dn, j) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  j = 0;  loop(4, col(0x000000, 0.08);  lk_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, 4);  j += 1; );
  col(0x0E0F10, 1);  lk_rr(x - 2, y - 2, w + 4, h + 4, 5);
  col(0x45484D, 1);  lk_rr(x, y + dn, w, h - dn, 4);
  col(0x2C2E32, 1);  lk_rr(x + 1, y + 1 + dn, w - 2, h - 2 - dn, 4);
  col(0x35373B, 1);  lk_rr(x + 1, y + 1 + dn, w - 2, h - 8, 4);
  hov ? ( col(0xFFFFFF, 0.06);  lk_rr(x + 1, y + 1, w - 2, h - 2, 4); );
  gfx_setfont(2);  col(0xE8DCC0, 1);  ui_keytext(px(x + w * 0.5), py(y + h * 0.5 + dn), "PANIC");
  hit;
);
function lamp(x, y, on, c) (
  col(0x050506, 1);  gfx_circle(px(x), py(y), ps(5.5), 1, 1);
  col(on ? c : shade(c, 0.28), 1);  gfx_circle(px(x), py(y), ps(4), 1, 1);
  on ? ( col(c, 0.25);  gfx_circle(px(x), py(y), ps(8), 1, 1);  col(0xFFFFFF, 0.55);  gfx_circle(px(x - 1.3), py(y - 1.3), ps(1.3), 1, 1); );
);

g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (900 * g_ret), gfx_h / (355 * g_ret))), 0.5);
ox = (gfx_w - 900 * sc) * 0.5;
oy = (gfx_h - 355 * sc) * 0.5;
lmb = mouse_cap & 1;
click = lmb && !last_lmb;
h_click = sz_help ? click : 0;  h_wheel = sz_help ? mouse_wheel : 0;
sz_help ? ( click = 0;  mouse_wheel = 0; );
klog = 0;  kstep = 0;  kdim = 0;  kzero = 0;

function fit_font(idx, face, size) local(fs, w, h, target) (
  target = 5.28 * size;  fs = size;
  loop(3,
    gfx_setfont(idx, face, fs, 'b');  gfx_measurestr("THRESHOLD", w, h);
    fs = min(max(fs * target / max(w, 1), size * 0.75), size * 1.8);
  );
  fs;
);
sc != ff_sc ? (
  ff_sc = sc;
  fs1 = fit_font(1, "Trebuchet MS", ps(25));
  fs10 = fit_font(10, "Courier New", ps(13));
  fs2 = fit_font(2, "Courier New", ps(15));
  fs3 = fit_font(3, "Courier New", ps(14));
  fs4 = fit_font(4, "Courier New", ps(18));
  fs5 = fit_font(5, "Courier New", ps(13));
  fs6 = fit_font(6, "Courier New", ps(16));
  fs9 = fit_font(9, "Courier New", ps(14));
  fs11 = fit_font(11, "Trebuchet MS", ps(11));
);
gfx_setfont(1, "Trebuchet MS", fs1, 'bi');
gfx_setfont(10, "Courier New", fs10, 'b');
gfx_setfont(2, "Courier New", fs2, 'b');
gfx_setfont(3, "Courier New", fs3, 'b');
gfx_setfont(4, "Courier New", fs4, 'b');
gfx_setfont(5, "Courier New", fs5, 'b');
gfx_setfont(6, "Courier New", fs6, 'b');
gfx_setfont(9, "Courier New", fs9, 'b');
gfx_setfont(11, "Trebuchet MS", fs11, 'b');
gfx_setfont(7, "Courier New", ps(17), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');

g_now = time_precise();
midi_hit_d ? ( ml_t = g_now;  midi_hit_d = 0; );
outpk_disp >= 0.891 ? pl_t = g_now;
outpk_disp = 0;
pl_on = pl_t > 0 && g_now - pl_t < 1.2;

col(0x101113, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
g_gt = ui_mix(C_PANEL, 0xFFFFFF, 0.22);  g_gb = ui_mix(C_PANEL, 0x000000, 0.22);
gfx_gradrect(px(0), py(0), ps(900), ps(355), floor(g_gt / 65536) / 255, (floor(g_gt / 256) % 256) / 255, (g_gt % 256) / 255, 1, 0, 0, 0, 0,
  (floor(g_gb / 65536) - floor(g_gt / 65536)) / 255 / ps(355), ((floor(g_gb / 256) % 256) - (floor(g_gt / 256) % 256)) / 255 / ps(355),
  ((g_gb % 256) - (g_gt % 256)) / 255 / ps(355), 0);
col(C_HEAD, 0.92);  u_rect(0, 0, 900, 52);
col(C_ST1, 1);  u_rect(0, 52, 900, 3);  col(C_ST2, 1);  u_rect(0, 57, 900, 3);  col(C_ST3, 1);  u_rect(0, 62, 900, 1.5);
col(0xFFFFFF, 0.08);  u_rect(0, 63.5, 900, 1);
rivet(7, 7);  rivet(893, 7);  rivet(7, 348);  rivet(893, 348);
col(0x000000, 0.35);  u_rect(0, 352, 900, 3);  u_rect(897, 64, 3, 291);

