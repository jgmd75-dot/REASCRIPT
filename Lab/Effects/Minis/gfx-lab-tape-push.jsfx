    ui_col(0x18191B); gfx_circle(KX + 0.4 * sc, KY + 0.6 * sc, KR * 0.73, 1, 1);
    ui_col(0x2E3034); gfx_circle(KX - 0.4 * sc, KY - 0.6 * sc, KR * 0.72, 1, 1);
