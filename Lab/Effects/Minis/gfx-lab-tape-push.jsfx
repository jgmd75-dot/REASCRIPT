function mg_dots(x, y, r, sty) local(i, t, rs, px, py, d1, d2, c) (
  rs = sty == 0 ? (r < 20 ? r + 7 : r + 11) : r + 8; d1 = sty == 0 && r >= 20 ? 1.6 : 1.3; d2 = sty == 0 && r >= 20 ? 2.2 : 1.8;
  c = mk_scale; i = 0;
  loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_wdial && (i == 0 || i == 2 || i == 4) ? ( gfx_setfont(11); ui_col(mk_scale);
      mg_ctxt(px + (i == 0 ? -3 : i == 4 ? 3 : 0), py + (i == 2 ? -2 : 0), i == 0 ? "M" : i == 2 ? "C" : "S"); )
    : ( ui_col(c); mg_disc(px, py, i == 0 || i == 4 ? d2 : d1); );
    i += 1; );
