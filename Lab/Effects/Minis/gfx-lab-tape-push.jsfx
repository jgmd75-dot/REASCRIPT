desc:Tape Push [saturator] (GFX Lab)
//tags: processing saturation tape drive transformer gate equaliser compressor buss
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-thick, gfx-lab-sidebar, gfx-lab-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:-80<-80,0,0.1>-Gate threshold (dB)
slider3:1<0,1,1{Iron (Fe),Nickel (Ni)}>-Iron
slider4:20<20,800,1>-HPF (Hz)
slider5:22000<2000,22000,1>-LPF (Hz)
slider6:3<0,10,0.01>-Drive
slider7:3<0,10,0.01>-Tape low (0 - 10)
slider8:0<0,1,1{Off,On}>-Thick
slider9:0<-40,0,0.1>-Comp threshold (dB)
slider10:0<0,1,1{Fast,Slow}>-Comp attack
slider11:0<0,1,1{Auto,Crush}>-Comp ratio
slider12:0<0,1,1{Auto,Fast}>-Comp release
slider13:0<-15,15,0.1>-HF (dB)
slider14:0<-15,15,0.1>-LF (dB)
slider15:1100<40,16000,1>-Mid frequency (Hz)
slider16:0<-15,15,0.1>-Mid gain (dB)
slider17:1<0.4,10,0.01>-Mid Q
slider18:0<0,1,1{Comp first,EQ first}>-Order
slider19:0<0,1,1{Off,On}>-Comp sat
slider20:3<0,10,0.01>-Tape high (0 - 10)
slider21:0<-12,12,0.1>-Output (dB)
slider22:100<0,200,1>-Width (%)
slider23:50<0,100,1>-Drift (%)
slider24:1<0,2,1{1x,2x,4x}>-Oversampling
slider25:100<0,100,1>-Comp mix (%)
slider26:0<0,1,1{Off,On}>-Comp SC HPF
slider27:0<0,1,1{Off,On}>-Comp soft
slider28:0<0,1,1{Fast,Slow}>-Gate speed
slider29:0<0,1,1{Bell,Tilt}>-Mid type
slider30:prs_sel=0<0,6,1{No preset,Init,Warm Tape,Bus Glue,Hot Drums,Bright Push,Dark Reel}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-sidebar.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-tape-push";
ext_noinit = 1;

function mc_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function mc_db(d) ( exp(d * 0.11512925464970228); );
function mc_tcf(ms, fs) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * fs)); );
function mc_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );
function mc_th(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );

COEF = 7000000;
function mc_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 1 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) + (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) - (Ag - 1) * cw + sa) / a0; c[1] = 2 * Ag * ((Ag - 1) - (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
    c[3] = -2 * ((Ag - 1) + (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : t == 3 ? (
    a0 = 1 + al; c[0] = (1 - cw) * 0.5 / a0; c[1] = (1 - cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function mc_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function mc_bqz() instance(z1, z2) ( z1 = z2 = 0; );
C_PE = COEF;      C_DE = COEF + 5;  C_HB = COEF + 10; C_GL = COEF + 15;
C_LF = COEF + 20; C_LD = COEF + 25; C_HF = COEF + 30; C_HD = COEF + 35;
C_MD = COEF + 40;
C_TP = COEF + 45; C_TD = COEF + 50; C_TB = COEF + 55; C_TG = COEF + 60;
C_TS = COEF + 105;
C_SH = COEF + 110; C_SM = COEF + 115; C_MT = COEF + 120;
C_F1 = COEF + 85; C_F2 = COEF + 90; C_F3 = COEF + 95; C_F4 = COEF + 100;

function mc_gate(l, r) local(z) (
  z = max(abs(l), abs(r)); mc_ge = z > mc_ge ? z : mc_ge * mc_gdk;
  mc_gon ? (
    mc_ge > mc_gol ? ( mc_gop = 1; mc_ghc = mc_ghn; ) : mc_ge < mc_goc ? ( mc_ghc > 0 ? mc_ghc -= 1 : mc_gop = 0; );
    z = mc_gop ? 1 : mc_gfl;
  ) : ( z = 1; mc_gop = 0; );
  mc_gg += (z - mc_gg) * (z > mc_gg ? mc_gak : mc_grk);
  mc_xl = l * mc_gg; mc_xr = r * mc_gg;
);
function mc_svc(f, q, fs) local(g) ( g = tan($pi * min(f, fs * 0.45) / fs); mc_k = 1 / q; mc_c1 = 1 / (1 + g * (g + mc_k)); mc_c2 = g * mc_c1; mc_c3 = g * mc_c2; );
function mc_svf(x, a1, a2, a3, k) instance(s1, s2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - s2;  v1 = a1 * s1 + a2 * v3;  v2 = s2 + a2 * s1 + a3 * v3;  s1 = 2 * v1 - s1;  s2 = 2 * v2 - s2;
  lp = v2;  bp = v1;  hp = x - k * v1 - v2;
);
function mc_svz() instance(s1, s2) ( s1 = s2 = 0; );
function mc_op(x, k) instance(z) ( z += k * (x - z); );
function mc_inv(x) instance(px, py) local(y) ( y = (x - (1 - mc_ik) * (px - py)) / (1 + mc_ie * mc_ik); px = x; py = y; y; );
function mc_flt(x) instance(h1, h2, h3, l1, l2, l3, p1, p2, p3, q1, q2, q3) local(a, b, c, y) (
  p1 += (x - p1) * mc_hk; a = x - p1;
  p2 += (a - p2) * mc_hk; b = a - p2;
  p3 += (b - p3) * mc_hk; c = b - p3;
  y = a + mc_hw2 * (b - a) + mc_hw3 * (c - b);
  y = x + mc_hon * (y - x);
  q1 += (y - q1) * mc_lk; q2 += (q1 - q2) * mc_lk; q3 += (q2 - q3) * mc_lk;
  a = q1 + mc_lw2 * (q2 - q1) + mc_lw3 * (q3 - q2);
  y + mc_lon * (a - y);
);
function mc_fclr() instance(p1, p2, p3, q1, q2, q3) ( p1 = p2 = p3 = q1 = q2 = q3 = 0; );

function mc_hc(u) ( mc_th(mc_g * 0.5 * u * mc_pd + mc_b) - mc_tb; );
function mc_drv(x) instance(l1, l2, hp, dx, dy) local(lo, y, hf, e, k) (
  l1 += (x - l1) * mc_lsk; l2 += (l1 - l2) * mc_lsk; lo = l2 * mc_ls;
  hp += (x - hp) * mc_hfk; hf = x - hp;
  y = this.pe.mc_bq(x - lo, C_PE);
  y = mc_hc(y) * mc_lm;
  y = this.de.mc_bq(y, C_DE);
  y += lo * mc_lsg;
  k = mc_hfg; e = mc_th(k * hf + 0.35) - mc_t35 - k * hf * mc_t35d;
  y += e / k * mc_hfa;
  y = this.hb.mc_bq(y, C_HB); y = this.gl.mc_bq(y, C_GL);
  e = y - dx + mc_dc10 * dy; dx = y; dy = e;
  e;
);
function mc_dclr() instance(l1, l2, hp, dx, dy) ( l1 = l2 = hp = dx = dy = 0; this.pe.mc_bqz(); this.de.mc_bqz(); this.hb.mc_bqz(); this.gl.mc_bqz(); );
function mc_lmc(g, pd, b) local(i, x, y, si, so, tb) (
  si = so = 0; i = 0; tb = mc_th(b);
  loop(64, x = (i < 32 ? 0.125 : 0.25) * sin((i + 0.5) * 0.19634954084936207);
    y = mc_th(g * 0.5 * x * pd + b) - tb; si += x * x; so += y * y; i += 1; );
  sqrt(si / max(so, 0.000000000001));
);

function mc_slmc(tp, g) local(i, x, y, si, so) (
  si = so = 0; i = 0;
  loop(32, x = 0.125 * sin((i + 0.5) * 0.19634954084936207);
    y = tp ? (mc_th(x * g * 0.8 + 0.1) - mc_t06) / 0.8 : mc_th(g * x + 0.15) - mc_t15;
    si += x * x; so += y * y; i += 1; );
  sqrt(si / max(so, 0.000000000001));
);
function mc_comp(l, r) local(e, o, z, s, gr, u, dl, dr, lv) (
  mc_sfa > 0.0001 ? (
    mc_lvm += (max(l * l, r * r) - mc_lvm) * mc_lvk;
    e = 10 * log10(max(mc_lvm * 2, 0.0000000001));
    z = min(max(e - (mc_thr - 6), 0) * 0.75, 6);
    mc_lvg += (z - mc_lvg) * (z > mc_lvg ? mc_lva : mc_lvr);
    lv = mc_db(-mc_lvg * mc_sfa); l *= lv; r *= lv;
  ) : ( mc_lvm = mc_lvg = 0; lv = 1; );
  mc_sca > 0.0001 ? (
    dl = dSL.mc_bq(dHL.mc_bq(l, C_SH), C_SM); dr = dSR.mc_bq(dHR.mc_bq(r, C_SH), C_SM);
    dl = l + mc_sca * (dl - l); dr = r + mc_sca * (dr - r);
  ) : ( dl = l; dr = r; );
  e = 20 * log10(max(max(abs(dl), abs(dr)), 0.00001));
  o = e - mc_thr; s = mc_slp;
  z = o <= -1 ? 0 : o >= 1 ? o * 0.95 : 0.95 * sqr(o + 1) / 4;
  mc_aua > 0.0001 ? ( u = o + 6; u = u <= 0 ? 0 : u < 18 ? 0.8333 * u * u / 36 : 0.8333 * (9 + u - 18); z += mc_aua * (u - z); );
  mc_g1 += (z - mc_g1) * (z > mc_g1 ? mc_ca : mc_cr1);
  mc_g2 += (z - mc_g2) * (z > mc_g2 ? mc_ca2 : mc_cr2);
  gr = mc_rf ? mc_g1 : mc_g1 + mc_aua * (max(mc_g1, mc_g2) - mc_g1);
  mc_gro = max(mc_gro, gr + mc_lvg * mc_sfa);
  z = mc_db(mc_mku - gr);
  z = 1 + mc_mx * (z - 1);
  mc_cl = l * z; mc_cr = r * z;
  u = min(max((gr + mc_lvg * mc_sfa - 1) / 11, 0), 1) * 0.5 * mc_mx * (2 - mc_aua);
  u > 0.0001 || mc_cdc ? (
    dl = (mc_th(1.6 * mc_cl + 0.15) - mc_t15) / 1.6 - mc_cl; dr = (mc_th(1.6 * mc_cr + 0.15) - mc_t15) / 1.6 - mc_cr;
    dl *= u; dr *= u;
    mc_dcl += (dl - mc_dcl) * mc_dck; mc_dcr += (dr - mc_dcr) * mc_dck;
    mc_cl += dl - mc_dcl; mc_cr += dr - mc_dcr;
    mc_cdc = abs(mc_dcl) + abs(mc_dcr) > 0.0000001;
  );
  mc_csa > 0.0001 ? ( mc_cl += mc_csa * (mc_th(mc_cl * 1.4) / 1.4 - mc_cl); mc_cr += mc_csa * (mc_th(mc_cr * 1.4) / 1.4 - mc_cr); );
);
function mc_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function mc_fizz() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.mc_bq(mc_el, C_F1); h1 = zA2.mc_bq(mc_er, C_F1);
  ha = max(abs(h0), abs(h1)); mc_fzh += (ha - mc_fzh) * (ha > mc_fzh ? mc_fza : mc_fzr);
  pa = max(abs(mc_el), abs(mc_er)); mc_fzp += (pa - mc_fzp) * mc_fzw;
  nn = 1 / (max(mc_fzh, 0.25 * mc_fzp) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (mc_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * mc_fzh;
  e1 = (mc_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * mc_fzh;
  e0 = zD1.mc_bq(zC1.mc_bq(zB1.mc_bq(e0, C_F2), C_F3), C_F4);
  e1 = zD2.mc_bq(zC2.mc_bq(zB2.mc_bq(e1, C_F2), C_F3), C_F4);
  ea = max(abs(e0), abs(e1)); mc_fze += (ea - mc_fze) * (ea > mc_fze ? mc_fza : mc_fzr);
  g = mc_fzo * max(0.25, min(1, 0.05 * mc_fzp / (mc_fze + 0.000001)));
  mc_el += g * e0; mc_er += g * e1;
);
function mc_fzclr() (
  zA1.mc_bqz(); zA2.mc_bqz(); zB1.mc_bqz(); zB2.mc_bqz(); zC1.mc_bqz(); zC2.mc_bqz(); zD1.mc_bqz(); zD2.mc_bqz();
  mc_fzh = mc_fzp = mc_fze = 0;
);
function mc_eq(l, r) (
  l = eLD.mc_bq(eLF.mc_bq(l, C_LF), C_LD); r = fLD.mc_bq(fLF.mc_bq(r, C_LF), C_LD);
  l = eHD.mc_bq(eHF.mc_bq(l, C_HF), C_HD); r = fHD.mc_bq(fHF.mc_bq(r, C_HF), C_HD);
  mc_tia < 0.9999 ? ( mc_el = eMD.mc_bq(l, C_MD); mc_er = fMD.mc_bq(r, C_MD); ) : ( eMD.mc_bqz(); fMD.mc_bqz(); );
  mc_tia > 0.0001 ? (
    mc_tia > 0.9999 ? ( mc_el = eMT.mc_bq(l, C_MT); mc_er = fMT.mc_bq(r, C_MT); )
    : ( mc_el += mc_tia * (eMT.mc_bq(l, C_MT) - mc_el); mc_er += mc_tia * (fMT.mc_bq(r, C_MT) - mc_er); );
  ) : ( eMT.mc_bqz(); fMT.mc_bqz(); );
  mc_fzo > 0.0001 ? mc_fizz();
);
function mc_tapel(x) instance(dx, dy) local(u, e) (
  u = (mc_th(x * mc_tgl * 0.8 + 0.1) - mc_t06) / 0.8;
  e = u - dx + mc_dc5 * dy; dx = u; dy = e;
  this.hb.mc_bq(e, C_TB) * mc_tml;
);
function mc_tapeh(x) instance(dx, dy) local(u, e) (
  x = this.pe.mc_bq(x, C_TP);
  u = (mc_th(x * mc_tgh * 0.8 + 0.1) - mc_t06) / 0.8;
  e = u - dx + mc_dc5 * dy; dx = u; dy = e;
  e = this.de.mc_bq(e, C_TD); e = this.gl.mc_bq(e, C_TG);
  this.sh.mc_bq(e, C_TS) * mc_tmh;
);
function mc_tclr() instance(dx, dy) ( dx = dy = 0; this.pe.mc_bqz(); this.de.mc_bqz(); this.hb.mc_bqz(); this.gl.mc_bqz(); this.sh.mc_bqz(); );

function mc_chain(l, r) local(xl, xr, a, b, pl, pr) (
  l += mc_ie * iEL.mc_op(l, mc_ik); r += mc_ie * iER.mc_op(r, mc_ik);
  l = mDL.mc_drv(l); r = mDR.mc_drv(r);
  l = iDL.mc_inv(l); r = iDR.mc_inv(r);
  l += mc_ish * (l - iNL.mc_op(l, mc_nk)); r += mc_ish * (r - iNR.mc_op(r, mc_nk));
  mc_sbo > 0.0001 ? ( l += sbL.sb_run(l); r += sbR.sb_run(r); );
  xl = l; xr = r;
  mc_ord ? (
    mc_eq(l, r); mc_comp(mc_el, mc_er); pl = mc_cl; pr = mc_cr;
  ) : (
    mc_comp(l, r); mc_eq(mc_cl, mc_cr); pl = mc_el; pr = mc_er;
  );
  l = xl + mc_dk * (pl - xl); r = xr + mc_dk * (pr - xr);
  mc_tlo > 0.0001 || mc_thi > 0.0001 ? (
    spL.mc_svf(l, mc_x1, mc_x2, mc_x3, 1.4142135623730951); spR.mc_svf(r, mc_x1, mc_x2, mc_x3, 1.4142135623730951);
    a = spL.lp; b = spR.lp;
    mc_tlo > 0.0001 ? ( l += mc_tlo * (sTL.mc_tapel(a) - a); r += mc_tlo * (sTR.mc_tapel(b) - b); );
    mc_thi > 0.0001 ? ( a = spL.hp; b = spR.hp; l += mc_thi * (sUL.mc_tapeh(a) - a); r += mc_thi * (sUR.mc_tapeh(b) - b); );
  );
  mc_pl = l * mc_cg; mc_pr = r * mc_cg;
);
function mc_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  mDL.mc_dclr(); mDR.mc_dclr(); sbL.sb_clr(); sbR.sb_clr();
  eLF.mc_bqz(); eLD.mc_bqz(); eHF.mc_bqz(); eHD.mc_bqz(); eMD.mc_bqz(); eMT.mc_bqz(); fMT.mc_bqz();
  fLF.mc_bqz(); fLD.mc_bqz(); fHF.mc_bqz(); fHD.mc_bqz(); fMD.mc_bqz();
  sTL.mc_tclr(); sTR.mc_tclr(); sUL.mc_tclr(); sUR.mc_tclr(); spL.mc_svz(); spR.mc_svz();
  iEL.z = iER.z = iNL.z = iNR.z = iDL.px = iDL.py = iDR.px = iDR.py = 0;
  mc_g1 = mc_g2 = 0; mc_fzclr(); mc_lvm = mc_lvg = 0; mc_dcl = mc_dcr = 0; mc_cdc = 0;
  dHL.mc_bqz(); dHR.mc_bqz(); dSL.mc_bqz(); dSR.mc_bqz();
);
function mc_reset() (
  mc_clear(); fL.mc_fclr(); fR.mc_fclr(); memset(BY_BUF, 0, 2 * BY_N);
  mLL.mc_svz(); mLR.mc_svz(); mHL.mc_svz(); mHR.mc_svz(); mc_ge = 0; mc_gg = 1; mc_ghc = 0; mc_gop = 0;
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  mc_fi = 0;
);

PT = 6000000;
#mc_pm = "Init|Warm Tape|Bus Glue|Hot Drums|Bright Push|Dark Reel";
function mc_w8(a, b, c, d, e, f, g, h) ( mc_wp[0] = a; mc_wp[1] = b; mc_wp[2] = c; mc_wp[3] = d; mc_wp[4] = e; mc_wp[5] = f; mc_wp[6] = g; mc_wp[7] = h; mc_wp += 8; );
mc_wp = PT;
mc_w8(-80, 1,   20,  22000, 3, 3,  0,    0);   mc_w8(0, 0, 0, 0,    0,   1100, 0,   1);   mc_w8(0, 0, 3, 0,  100, 100, 0, 0);
mc_w8(-80, 0,   33,  16500, 5, 5,  1,  -16);   mc_w8(1, 0, 0, -1.5, 1.5, 1100, 0,   1);   mc_w8(0, 0, 3, 0,  100, 70, 0, 1);
mc_w8(-80, 1,   20,  22000, 2, 3,  0,  -20);   mc_w8(1, 0, 0, 1,    0.5, 1100, 0.5, 1);   mc_w8(0, 1, 3, 0,  100, 100, 1, 1);
mc_w8(-45, 1,   44,  22000, 7, 4,  1,  -24);   mc_w8(0, 1, 1, 1.5,  1,   440,  -2,  1);   mc_w8(0, 1, 0, -2.3, 100, 50, 1, 0);
mc_w8(-80, 1,   33,  22000, 4, 0,  0,  -16);   mc_w8(1, 0, 0, 2,    0,   4400, 1,   1);   mc_w8(0, 0, 4, 0,  115, 100, 0, 0);
mc_w8(-80, 0,   22,  11000, 6, 6,  1,  -12);   mc_w8(1, 0, 0, -3,   2,   330,  0,   1);   mc_w8(0, 0, 2, 0,  90,  80, 0, 1);
function load_preset(p) local(i, q) (
  q = PT + (min(p, 7) == 7 ? 0 : p - 1) * 24;
  i = 0; loop(21, slider(2 + i) = q[i]; i += 1; );
  slider25 = q[21]; slider26 = q[22]; slider27 = q[23];
  p == 7 ? slider23 = 50;
  i = 2; loop(22, ui_auto(i); i += 1; ); ui_auto(25); ui_auto(26); ui_auto(27);
  pr_cur = p == 7 ? 1 : p;
);

function mc_srinit() (
  mc_sr = srate;
  c_kn = mc_tcf(30, srate);
  c_sw = mc_tcf(15, srate);
  c_tk = 1 - exp(-32 / (0.03 * srate));
  mc_fis = 1 / (0.01 * srate);
  mc_dks = 1 / (0.006 * srate);
  mc_mbk = mc_opk(78, srate); mc_ms1 = mc_ms2 = 0;
  mc_gdk = exp(-1 / (0.05 * srate));
  mc_gak = mc_tcf(1, srate); mc_grk = mc_tcf(150, srate); mc_ghn = floor(0.02 * srate); mc_gsl = -1; mc_gfl = mc_db(-18);
  mc_ge = 0; mc_gg = 1; mc_ghc = 0; mc_gop = 0;
  mc_svc(220, 0.7071, srate); mc_m1 = mc_c1; mc_m2 = mc_c2; mc_m3 = mc_c3;
  mc_svc(2200, 0.7071, srate); mc_n1 = mc_c1; mc_n2 = mc_c2; mc_n3 = mc_c3;
  mLL.mc_svz(); mLR.mc_svz(); mHL.mc_svz(); mHR.mc_svz();
  ost_init(0);
  thk_init(); thk_lift = 3; thk_drv = 1.5; thk_asym = 0.12; thk_tr = 1.2; thk_trim = 0;
  mc_clear(); fL.mc_fclr(); fR.mc_fclr();
  mc_snap = 1;
);
function mc_coef() local(fs, d) (
  fs = mc_fs = srate * os_f;
  mc_lsk = mc_opk(300, fs); mc_hfk = mc_opk(2200, fs);
  mc_ik = mc_opk(110, fs); mc_nk = mc_opk(6600, fs);
  mc_svc(660, 0.7071, fs); mc_x1 = mc_c1; mc_x2 = mc_c2; mc_x3 = mc_c3;
  mc_dc10 = 1 - 2 * $pi * 10 / fs; mc_dc5 = 1 - 2 * $pi * 5 / fs;
  mc_bqc(C_PE, 2, 3000, 4, 0.7, fs); mc_bqc(C_DE, 2, 3000, -4, 0.7, fs);
  mc_bqc(C_HB, 0, 70, 1.5 * min(mc_dv / 3, 1) * (1 - 0.05 * mc_dv), 0.9, fs); mc_bqc(C_GL, 2, 12000, -0.25 * mc_dv, 0.7071, fs);
  mc_bqc(C_LF, 1, 110, mc_lfg, 0.7071, fs); mc_bqc(C_LD, 0, 330, -0.15 * max(mc_lfg - 4, 0), 0.9, fs);
  mc_bqc(C_F1, 4, 3500, 0, 0.7071, fs); mc_bqc(C_F2, 4, 5500, 0, 0.7071, fs); mc_bqc(C_F3, 0, 8000, 4, 0.7, fs); mc_bqc(C_F4, 2, 12000, -6, 0.7, fs);
  mc_fza = mc_tcf(3, fs); mc_fzr = mc_tcf(120, fs); mc_fzw = mc_tcf(60, fs);
  mc_bqc(C_HF, 2, 8800, mc_hfgn, 0.7071, fs); mc_bqc(C_HD, 0, 3300, -0.15 * max(mc_hfgn - 4, 0), 0.9, fs);
  mc_bqc(C_MD, 0, mc_mf, mc_mg, mc_mq, fs);
  mc_bqc(C_MT, 2, mc_mf, mc_mg, 0.7071, fs); d = mc_db(-0.5 * mc_mg); C_MT[0] *= d; C_MT[1] *= d; C_MT[2] *= d;
  mc_bqc(C_TP, 2, 3300, 3.5, 0.6, fs); mc_bqc(C_TD, 2, 3300, -3.5, 0.6, fs);
  mc_bqc(C_SH, 4, 90, 0, 0.7071, fs); mc_bqc(C_SM, 0, 3300, -3, 1, fs);
  mc_lvk = mc_tcf(300, fs); mc_lva = mc_tcf(150, fs); mc_lvr = mc_tcf(1000, fs); mc_dck = mc_tcf(16, fs);
  mc_bqc(C_TS, 2, 12000, 2.5 * mc_hv / 10, 0.6, fs);
  mc_bqc(C_TB, 0, 100, 1.75, 1.1, fs); mc_bqc(C_TG, 3, 21000, 0, 0.6, fs);
  mc_ca = mc_tcf(mc_slow ? 30 : 1, fs); mc_ca2 = mc_tcf(250, fs);
  mc_cr1 = mc_tcf(mc_rf ? 60 : 80, fs); mc_cr2 = mc_tcf(1200, fs);
  mc_hk = mc_opk(mc_fh / (1 + 0.554 * mc_hw2 + 0.407 * mc_hw3), srate); mc_lk = mc_opk(mc_fl * (1 + 0.554 * mc_lw2 + 0.407 * mc_lw3), srate);
);
os_design();
os_f = os_tf = os_f2n(slider24); os_base = 0;
mc_srinit();
os_gsetup();
in_init();
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_bloom = 0.1;
dSup.drift_init(0.8 + rand(1) * 0.4); dBias.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
mc_t35 = mc_th(0.35); mc_t35d = 1 - mc_t35 * mc_t35;
mc_t15 = mc_th(0.15); mc_t06 = mc_th(0.1);
mc_g = 1; mc_pd = 1; mc_b = 0.03; mc_tb = mc_th(mc_b); mc_lm = 1; mc_dk = 1; mc_cg = 1;
mc_lv = mc_hv = 3; mc_tgl = mc_tgh = mc_db(2.7); mc_tml = mc_tmh = mc_slmc(1, mc_tgl); mc_lvc = mc_hvc = 3;

mc_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(28, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 6 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(6, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != mc_sr ? mc_srinit();
mc_now = time_precise();
mc_tp > 0 && mc_now - mc_tp > max(0.25, 4 * samplesblock / srate) ? mc_reset();
mc_tp = mc_now;
pwr_block(slider1 < 0.5);
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider24); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(slider23);
mc_n = samplesblock / srate;
mc_vs = dSup.drift_tick(0.05 * dm_s * mc_n); mc_vb = dBias.drift_tick(0.04 * dm_s * mc_n);
mc_fht = min(max(slider4, 20), 800); mc_flt = min(max(slider5, 2000), 22000);
mc_hn = log(mc_fht / 20) / log(40); mc_ln = log(22000 / mc_flt) / log(11);
mc_hont = min(mc_hn * 25, 1); mc_lont = min(mc_ln * 25, 1);
mc_hw2t = mc_hn; mc_hw3t = 0;
mc_lw2t = mc_ln; mc_lw3t = 0;
mc_gt0 = min(max(slider2, -80), 0);
(slider28 >= 0.5) != mc_gsl ? ( mc_gsl = slider28 >= 0.5;
  mc_grk = mc_tcf(mc_gsl ? 600 : 150, srate); mc_ghn = floor((mc_gsl ? 0.08 : 0.02) * srate); );
mc_gon = mc_gt0 > -79.95;
mc_gol = mc_db(mc_gt0); mc_goc = mc_db(mc_gt0 - 4);
mc_iet = slider3 >= 0.5 ? 0 : mc_db(4) - 1;
mc_isht = slider3 >= 0.5 ? mc_db(0.5) - 1 : 0;
mc_dvt = min(max(slider6, 0), 10);
mc_padt = 1;
mc_lvt = min(max(slider7, 0), 10); mc_hvt = min(max(slider20, 0), 10);
mc_tlot = mc_lvt > 0.005; mc_thit = mc_hvt > 0.005;
mc_csat = slider19 >= 0.5;
mc_mlt = mc_mht = 0;
mc_thon = slider8 >= 0.5;
mc_thrt = min(max(slider9, -40), 0);
mc_slow = slider10 >= 0.5;
mc_aut = slider11 < 0.5; mc_rat = mc_aut ? 3 : 20;
mc_slpt = 1 - 1 / mc_rat;
mc_rf = slider12 >= 0.5;
mc_hft = min(max(slider13, -15), 15); mc_lft = min(max(slider14, -15), 15);
mc_fzot = 0.33 * min(max((mc_hft - 6) / 9, 0), 1);
mc_tit = slider29 >= 0.5;
mc_mft = min(max(slider15, 40), 16000); mc_mgt = min(max(slider16, -15), 15); mc_mqt = min(max(slider17, 0.4), 10);
mc_ordt = slider18 >= 0.5;
mc_cgt = mc_db(min(max(slider21, -12), 12));
mc_mxt = min(max(slider25, 0), 100) / 100;
mc_wdt = min(max(slider22, 0), 200) / 100;
mc_mbt = min(max(mc_wdt - 1, 0), 1);
mc_gt = mc_db(mc_dvt * 2.6 + 0.3 * dm_a * mc_vs);
mc_pdt = mc_padt ? SB_PAD * mc_db(0.8 * mc_dvt) : 1;
mc_b = 0.03 + 0.02 * dm_a * mc_vb; mc_tb = mc_th(mc_b);
mc_lmt = mc_lmc(mc_gt, mc_pdt, mc_b);
mc_gtL = log(mc_gt); mc_pdtL = log(mc_pdt); mc_lmtL = log(mc_lmt);
mc_lst = (mc_dvt / 10) ^ 1.2;
mc_lsgt = mc_gt * 0.5 * mc_pdt * (1 - mc_tb * mc_tb) * mc_lmt * mc_db(-1.5 * mc_dvt / 10);
mc_hfat = 0.5 * (max(mc_dvt - 3, 0) / 7) ^ 1.5;
sb_target(14 - 0.6 * mc_dvt, 0.5 + 0.1 * mc_dvt, mc_padt, 220, 1);
mc_sct = slider26 >= 0.5; mc_sft = slider27 >= 0.5;
mc_mkt = 0.5 * mc_slpt * max(-18 - mc_thrt, 0) + mc_sft * min(0.5 * 0.75 * max(-18 - (mc_thrt - 6), 0), 3);
mc_mkt += mc_aut ? 0 : 2.6 * min(max((-10 - mc_thrt) / 9, 0), 1);
mc_snap ? (
  mc_fh = mc_fht; mc_fl = mc_flt; mc_hon = mc_hont; mc_lon = mc_lont; mc_hw2 = mc_hw2t; mc_hw3 = mc_hw3t; mc_lw2 = mc_lw2t; mc_lw3 = mc_lw3t;
  mc_g = mc_gt; mc_pd = mc_pdt; mc_lm = mc_lmt; mc_gL = log(mc_gt); mc_pdL = log(mc_pdt); mc_lmL = log(mc_lmt); mc_ls = mc_lst; mc_lsg = mc_lsgt; mc_hfa = mc_hfat; mc_dv = mc_dvt;
  mc_thr = mc_thrt; mc_slp = mc_slpt; mc_mku = mc_mkt; mc_aua = mc_aut; mc_tia = mc_tit; mc_sca = mc_sct; mc_sfa = mc_sft;
  mc_hfgn = mc_hft; mc_lfg = mc_lft; mc_mf = mc_mft; mc_mg = mc_mgt; mc_mq = mc_mqt; mc_ord = mc_ordt;
  mc_ie = mc_iet; mc_ish = mc_isht; mc_tlo = mc_tlot; mc_thi = mc_thit; mc_lv = mc_lvt; mc_hv = mc_hvt; mc_csa = mc_csat; mc_ml = mc_mlt; mc_mh = mc_mht; mc_cg = mc_cgt; mc_fzo = mc_fzot; mc_mx = mc_mxt; mc_wd = mc_wdt; mc_mb = mc_mbt; mc_sbo = mc_padt;
  mc_coef(); sb_rate(mc_fs); sb_snap();
);
mc_snap = 0;
mc_hfg = 2 * mc_g * mc_pd + 1;

mc_vu_d = max(mc_vu_d, sqrt(mc_ms / max(samplesblock, 1))); mc_ms = 0;
mc_go_d = mc_gon && mc_gop;
abs(mc_lv - mc_lvc) > 0.001 ? ( mc_lvc = mc_lv; mc_tgl = mc_db(max(mc_lv, 0.01) * 0.9); mc_tml = mc_slmc(1, mc_tgl); );
abs(mc_hv - mc_hvc) > 0.001 ? ( mc_hvc = mc_hv; mc_tgh = mc_db(max(mc_hv, 0.01) * 0.9); mc_tmh = mc_slmc(1, mc_tgh); );
ost_clipped ? mc_cl_d = 1; ost_clipped = 0;
mc_gr_d = max(mc_gr_d, mc_gro); mc_gro = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
mc_xl = in_l; mc_xr = in_r;
mc_hon += (mc_hont - mc_hon) * c_kn; mc_lon += (mc_lont - mc_lon) * c_kn;
mc_hw2 += (mc_hw2t - mc_hw2) * c_kn; mc_hw3 += (mc_hw3t - mc_hw3) * c_kn; mc_lw2 += (mc_lw2t - mc_lw2) * c_kn; mc_lw3 += (mc_lw3t - mc_lw3) * c_kn;
mc_gL += (mc_gtL - mc_gL) * c_kn; mc_pdL += (mc_pdtL - mc_pdL) * c_kn; mc_lmL += (mc_lmtL - mc_lmL) * c_kn;
mc_g = exp(mc_gL); mc_pd = exp(mc_pdL); mc_lm = exp(mc_lmL);
mc_ls += (mc_lst - mc_ls) * c_kn; mc_lsg += (mc_lsgt - mc_lsg) * c_kn; mc_hfa += (mc_hfat - mc_hfa) * c_kn;
mc_sbo += (mc_padt - mc_sbo) * c_sw;
mc_thr += (mc_thrt - mc_thr) * c_kn; mc_slp += (mc_slpt - mc_slp) * c_sw; mc_mku += (mc_mkt - mc_mku) * c_kn;
mc_aua += (mc_aut - mc_aua) * c_sw; mc_tia += (mc_tit - mc_tia) * c_sw; mc_sca += (mc_sct - mc_sca) * c_sw; mc_sfa += (mc_sft - mc_sfa) * c_sw;
mc_ie += (mc_iet - mc_ie) * c_kn; mc_ish += (mc_isht - mc_ish) * c_kn;
mc_tlo += (mc_tlot - mc_tlo) * c_sw; mc_thi += (mc_thit - mc_thi) * c_sw; mc_csa += (mc_csat - mc_csa) * c_sw;
mc_ml += (mc_mlt - mc_ml) * c_sw; mc_mh += (mc_mht - mc_mh) * c_sw;
mc_cg += (mc_cgt - mc_cg) * c_kn; mc_mx += (mc_mxt - mc_mx) * c_kn; mc_fzo += (mc_fzot - mc_fzo) * c_kn; mc_wd += (mc_wdt - mc_wd) * c_kn; mc_mb += (mc_mbt - mc_mb) * c_kn;
sb_glide(c_kn, c_sw);
mc_tlo < 0.0001 && !mc_tlot ? ( !mc_tcl ? ( sTL.mc_tclr(); sTR.mc_tclr(); mc_tcl = 1; ); ) : mc_tcl = 0;
mc_thi < 0.0001 && !mc_thit ? ( !mc_ucl ? ( sUL.mc_tclr(); sUR.mc_tclr(); mc_ucl = 1; ); ) : mc_ucl = 0;
mc_ordt != mc_ord ? ( mc_dk = max(mc_dk - mc_dks, 0); mc_dk == 0 ? mc_ord = mc_ordt; ) : mc_dk = min(mc_dk + mc_dks, 1);
(mc_tick += 1) >= 32 ? (
  mc_tick = 0;
  mc_fh += (mc_fht - mc_fh) * c_tk; mc_fl += (mc_flt - mc_fl) * c_tk;
  mc_hfgn += (mc_hft - mc_hfgn) * c_tk; mc_lfg += (mc_lft - mc_lfg) * c_tk;
  mc_mf *= exp((log(mc_mft) - log(mc_mf)) * c_tk); mc_mg += (mc_mgt - mc_mg) * c_tk; mc_mq *= exp((log(mc_mqt) - log(mc_mq)) * c_tk);
  mc_dv += (mc_dvt - mc_dv) * c_tk; mc_lv += (mc_lvt - mc_lv) * c_tk; mc_hv += (mc_hvt - mc_hv) * c_tk;
  mc_coef(); sb_ctl(c_tk);
);
mc_xl = fL.mc_flt(mc_xl); mc_xr = fR.mc_flt(mc_xr);
mc_gate(mc_xl, mc_xr);
thk_proc(mc_xl, mc_xr, mc_thon); mc_xl = thk_l; mc_xr = thk_r;
pwr_in(mc_xl, mc_xr); mc_xl = pwr_l; mc_xr = pwr_r;
abs(mc_xl) < 0.000000000000001 ? mc_xl = 0; abs(mc_xr) < 0.000000000000001 ? mc_xr = 0;
os_gate();
os_chg ? ( mc_clear(); mc_coef(); sb_rate(mc_fs); os_hold += 2 * samplesblock; );
uxL.os_up(mc_xl); uxR.os_up(mc_xr);
os_f == 1 ? (
  mc_chain(uxL.s0, uxR.s0); mc_yl = mc_pl; mc_yr = mc_pr;
) : (
  mc_chain(uxL.s0, uxR.s0); mc_a0 = mc_pl; mc_r0 = mc_pr;
  mc_chain(uxL.s1, uxR.s1); mc_a1 = mc_pl; mc_r1 = mc_pr;
  os_f == 2 ? ( mc_yl = dnL.os_dn(mc_a0, mc_a1, 0, 0); mc_yr = dnR.os_dn(mc_r0, mc_r1, 0, 0); ) : (
    mc_chain(uxL.s2, uxR.s2); mc_a2 = mc_pl; mc_r2 = mc_pr;
    mc_chain(uxL.s3, uxR.s3); mc_a3 = mc_pl; mc_r3 = mc_pr;
    mc_yl = dnL.os_dn(mc_a0, mc_a1, mc_a2, mc_a3); mc_yr = dnR.os_dn(mc_r0, mc_r1, mc_r2, mc_r3);
  );
);
pwr_out(mc_yl, mc_yr); mc_yl = pwr_l; mc_yr = pwr_r;
mc_z = (mc_yl + mc_yr) * 0.5; mc_a = (mc_yl - mc_yr) * 0.5;
mc_ms1 += (mc_a - mc_ms1) * mc_mbk; mc_ms2 += (mc_ms1 - mc_ms2) * mc_mbk;
mc_a = (mc_a - mc_mb * mc_ms2) * mc_wd; mc_yl = mc_z + mc_a; mc_yr = mc_z - mc_a;
mc_osg = os_g * os_g * (3 - 2 * os_g);
mc_yl *= mc_osg; mc_yr *= mc_osg;
mc_yl != mc_yl ? mc_yl = 0; mc_yr != mc_yr ? mc_yr = 0;
mc_fi < 1 ? (
  mc_fi = min(mc_fi + mc_fis, 1); mc_z = mc_fi * mc_fi * (3 - 2 * mc_fi);
  mc_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; mc_b2 = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  mc_yl = mc_a + (mc_yl - mc_a) * mc_z; mc_yr = mc_b2 + (mc_yr - mc_b2) * mc_z;
);
ost_out(mc_yl, mc_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
mc_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x353D70; mk_band = 0x1A1E38; mk_ink = 0xEDE6D3; mk_acc = 0xF0A63A; mk_tab = 0x9AAEE6;
mk_sub = 0x1C2246; mk_scale = 0xD6AE64; mk_fig = 0xB4BCD8;
mk_ink2 = ui_mix(mk_ink, mk_face, 0.4);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 6; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
