  : kind == 5 ? ( v <= 20.5 ? strcpy(#mgv, "OFF") : strcpy(#mgv, mg_fhz(v)); )
  : kind == 7 ? ( v <= -79.95 ? strcpy(#mgv, "OFF") : sprintf(#mgv, "%.0f dB", v); )
  : ( v >= 21900 ? strcpy(#mgv, "OFF") : strcpy(#mgv, mg_fhz(v)); );
