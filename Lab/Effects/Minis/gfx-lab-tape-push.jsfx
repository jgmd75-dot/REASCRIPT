function mg_fhz(f) ( f >= 10000 ? sprintf(#mgfs, "%.0f kHz", f / 1000) : f >= 1000 ? sprintf(#mgfs, "%.1f kHz", f / 1000) : sprintf(#mgfs, "%d Hz", floor(f + 0.5)); #mgfs; );
function mg_kn(cx, cy, r, ly, idx, lo, hi, def, lg, sty, col, kind, name, fnt) local(k, v) (
  k = mg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, col); v = slider(idx);
  kind == 0 ? sprintf(#mgv, "%+.1f dB", v) : kind == 1 ? strcpy(#mgv, mg_fhz(v)) : kind == 2 ? sprintf(#mgv, "%.1f", v)
