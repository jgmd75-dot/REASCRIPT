    ui_cola(0xFFFFFF, act ? 0.20 : 0.08); ui_ssarc(KX, KY, KR * 0.66, -1.75, -0.55, max(KR * 0.03, 0.9 * sc));
    ui_col(0x3A3D42); ui_ssarc(KX, KY, KR + 0.6 * sc, -1.9, -0.4, 1 * sc);
