  : mg_sqleft ? ( gfx_setfont(12); ui_col(0x1A1A1C); gfx_measurestr(lbl, s, b); gfx_x = (x - 8) * sc - s; gfx_y = (y + 11) * sc - b * 0.5; gfx_drawstr(lbl); )
            : ( gfx_setfont(13); ui_col(mk_ink2); mg_ctxt(x + 22, y - 10, lbl); );
