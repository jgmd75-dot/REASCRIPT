prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

function gap_clear() local(i, p) (
  i = 0; loop(NVX, p = v_ptr(i); p[0] = 0; p[2] = 0; p[7] = 0; p[32] = p[33] = 0; p[40] = p[41] = p[42] = p[43] = 0; i += 1; );
  memset(HBL, 0, 64); memset(HBR, 0, 64);
  dcxl = dcyl = dcxr = dcyr = 0; sage = 0; sag = 0;
  hcount = 0; mhold = 0; pedal = 0; qcount = 0; qi = 0; last_note = -1;
  sq_run = 0; sq_step = -1;
);

@slider
prs_chk();
prs_sl();

@block
prs_chk();
update();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? gap_clear();
g_tp = g_now; g_gpp = play_position; g_gpd = samplesblock / srate;
fl_lc = log(slider15);
fl_k = 1 - exp(-1 / (0.015 * srate));
!fl_ok ? ( fl_c1 = fl_c2 = fl_lc; fl_rs = slider16; fl_ev = slider19; fl_ok = 1; );
mono_mode != last_mono || stk_al != last_stk ? ( all_off(); last_mono = mono_mode; last_stk = stk_al; );

qcount = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, chan) ? (
    mst = m1 & 0xF0;
    mst == 0x90 || mst == 0x80 ? ( q_push(mofs, mst == 0x90 && m3 > 0, m2, m3); mst == 0x90 && m3 > 0 ? ins_midi_hit(); ) :
    mst == 0xE0 ? bend_st = (((m3 * 128 + m2) - 8192) / 8192) * slider50 :
    mst == 0xB0 ? (
      m2 == 1 ? mw = m3 / 127 :
      m2 == 64 ? ( pedal = m3 >= 64; !pedal ? q_push(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? q_push(mofs, 3, 0, 0);
    );
  );
  midisend(mofs, m1, m2, m3);
);
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( q_push(0, 3, 0, 0); );
gfx_pst_prev = gfx_pst;
panic_d ? ( panic_req = 1; panic_d = 0; );
panic_req ? ( q_push(0, 3, 0, 0); panic_req = 0; );
qi = 0; spos = 0;
ins_drift_block(slider52 / 100, samplesblock);
pwr_block(1);
sag = sage * dr_amt;
sq_spb = slider44 < 0.5 ? 8 : slider44 < 1.5 ? 4 : slider44 < 2.5 ? 2 : slider44 < 3.5 ? 1 : slider44 < 4.5 ? 6 : 3;
sq_inc = sq_spb * max(tempo, 20) / 60 / srate;
(play_state & 1) && sq_run ? sq_ph = beat_position * sq_spb;
lf1r = slider37 > 0.5 ? max(tempo, 20) / 60 / lfo_div(floor(slider37 + 0.5)) : slider33;
lf2r = slider42 > 0.5 ? max(tempo, 20) / 60 / lfo_div(floor(slider42 + 0.5)) : slider38;
(play_state & 1) ? (
  slider37 > 0.5 ? ( lf1 = beat_position / lfo_div(floor(slider37 + 0.5)); lf1 -= floor(lf1); );
  slider42 > 0.5 ? ( lf2 = beat_position / lfo_div(floor(slider42 + 0.5)); lf2 -= floor(lf2); );
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, SEQ, 64);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (qi < qcount && (QO[qi] <= spos || spos >= samplesblock - 1)) (
  evt = QT[qi];
  evt == 1 ? note_on(QN[qi], QV[qi]) : evt == 0 ? note_off(QN[qi]) : evt == 2 ? pedal_up() : all_off();
  qi += 1;
);
spos += 1;
fl_c1 += (fl_lc - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (slider16 - fl_rs) * fl_k; fl_ev += (slider19 - fl_ev) * fl_k;
fm_a += (ft_a - fm_a) * ft_g; fm_b += (ft_b - fm_b) * ft_g; fm_c += (ft_c - fm_c) * ft_g;
fm_d += (ft_d - fm_d) * ft_g; fm_e += (ft_e - fm_e) * ft_g; fm_k += (ft_k - fm_k) * ft_g;

(ctl -= 1) <= 0 ? (
  ctl = 16;
  lf1 += lf1r * 16 / srate; lf1 >= 1 ? ( lf1 -= floor(lf1); ls1 = rand(2) - 1; );
  lf2 += lf2r * 16 / srate; lf2 >= 1 ? ( lf2 -= floor(lf2); ls2 = rand(2) - 1; );
  sh_ = slider34; lfo1v = sh_ < 0.5 ? 1 - 4 * abs(lf1 - 0.5) : sh_ < 1.5 ? 2 * lf1 - 1 : sh_ < 2.5 ? (lf1 < 0.5 ? 1 : -1) : ls1;
  sh_ = slider39; lfo2v = sh_ < 0.5 ? 1 - 4 * abs(lf2 - 0.5) : sh_ < 1.5 ? 2 * lf2 - 1 : sh_ < 2.5 ? (lf2 < 0.5 ? 1 : -1) : ls2;
  a1_ = min(slider36 * 0.01 + mw, 1) * lfo1v; a2_ = slider41 * 0.01 * lfo2v;
  lfo_pitch = lfo_cut = lfo_pw = lfo_pan = 0;
  d_ = slider35; d_ < 0.5 ? lfo_pitch += a1_ * a1_ * a1_ * 12 + a1_ * 0.3 : d_ < 1.5 ? lfo_cut += a1_ * 4 : d_ < 2.5 ? lfo_pw += a1_ * 0.45 : lfo_pan += a1_;
  d_ = slider40; d_ < 0.5 ? lfo_pitch += a2_ * a2_ * a2_ * 12 + a2_ * 0.3 : d_ < 1.5 ? lfo_cut += a2_ * 4 : d_ < 2.5 ? lfo_pw += a2_ * 0.45 : lfo_pan += a2_;
  any_key = 0; snd_ = 0; vi_ = 0; loop(NVX, vp_ = v_ptr(vi_); vp_[2] ? any_key = 1; vp_[0] ? snd_ = max(snd_, vp_[32]); vi_ += 1; );
  run_ = slider43 >= 0.5 && any_key;
  run_ && !sq_run ? ( sq_ph = (play_state & 1) ? beat_position * sq_spb : 0; sq_step = -1; );
  sq_run = run_;
  sq_run ? (
    sq_ph += sq_inc * 16;
    st_ = floor(sq_ph) & 15;
    st_ != sq_step ? (
      sq_step = st_;
      slider45 >= 0.5 ? ( vi_ = 0; loop(NVX, vp_ = v_ptr(vi_); vp_[2] && vp_[7] <= 0 ? v_retrig(vp_); vi_ += 1; ); );
    );
    sq_pitch = floor(SEQ[sq_step] * 24 + 0.5);
    sq_cut = SEQ[16 + sq_step] * slider47 * 0.01 * 4;
    sq_lvl = 1 - slider48 * 0.01 + slider48 * 0.01 * SEQ[32 + sq_step];
    v4_ = SEQ[48 + sq_step] * slider49 * 0.01; d_ = slider46;
    sq_pw = d_ < 0.5 ? (v4_ - 0.5 * slider49 * 0.01) * 0.9 : 0;
    sq_res = d_ >= 0.5 && d_ < 1.5 ? v4_ : 0;
    sq_drv = d_ >= 1.5 && d_ < 2.5 ? v4_ : 0;
    sq_pan = d_ >= 2.5 && d_ < 3.5 ? v4_ * 2 - slider49 * 0.01 : 0;
    sq_nz = d_ >= 3.5 ? v4_ : 0;
    sq_ft = FTL[sq_step] > 0.5 ? floor(FTL[sq_step] + 0.5) - 1 : slider17;
    sq_sn = STL[sq_step] > 0.5 ? floor(STL[sq_step] + 0.5) : stk_n;
  ) : (
    sq_step = -1; sq_pitch = 0; sq_cut = 0; sq_lvl = 1; sq_pw = sq_res = sq_drv = sq_pan = sq_nz = 0;
    snd_ < 0.0005 || slider43 < 0.5 ? ( sq_ft = slider17; sq_sn = stk_n; );
  );
  ft_set(sq_ft);
  stk_act = min(max(sq_sn, 1), stk_al);
  stk_gs += (stk_m / sqrt(stk_act) - stk_gs) * stk_k;
  snd_ < 0.0005 ? ( ft_snap(); stk_gs = stk_m / sqrt(stk_act); );
  mx2_ = slider8 * 0.01; lv1 = 1 - mx2_; lv2 = slider4 > 0.5 ? mx2_ : 0;
  lvs = slider9 * 0.01; lvn = min(slider11 * 0.01 + sq_nz, 1); w1 = floor(slider1 + 0.5); w2 = floor(slider4 + 0.5);
  sdiv = slider10 < 0.5 ? 0.5 : 0.25;
  drv = (1 + 5 * min(slider18 * 0.01 + sq_drv, 1)) * (1 + sag * 0.35);
  vi_ = 0; loop(NVX, vp_ = v_ptr(vi_); vp_[0] ? mt_tick(vp_, 16); vi_ += 1; );
);

L0 = L1 = R0 = R1 = 0;
p = VB;
loop(NVX,
  p[0] ? (
    p[7] > 0 ? (
      p[32] *= 1 - 1 / p[7]; p[33] = 0; p[7] -= 1;
      p[7] <= 0 ? ( v_go(p, p[8], p[9], p[10]); p[2] = p[11]; mt_tick(p, 16); );
    );
    p[55] < 0.0005 && p[15] >= stk_act && p[7] <= 0 ? ( p[40] = p[41] = p[42] = p[43] = 0; k = 2; ) : k = 0;
    loop(2 - k,
      p[20] += p[22]; p[21] += p[23]; p[24] += p[26]; p[25] += p[27];
      p[28] += p[29]; p[30] += p[31]; p[32] += p[33];
      i1 = p[20]; ph = p[16] + i1; ph -= floor(ph); p[16] = ph;
      o1 = w1 == 0 ? 2 * ph - 1 - vo_blep(ph, i1) :
           w1 == 1 ? (ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph) :
           ( p2_ = ph + 1 - p[24]; p2_ -= floor(p2_); 0.8 * ((2 * ph - 1 - vo_blep(ph, i1)) - (2 * p2_ - 1 - vo_blep(p2_, i1))); );
      si = i1 * sdiv; sp = p[18] + si; sp -= floor(sp); p[18] = sp;
      lvs > 0.0001 ? ( p2_ = sp + 0.5; p2_ -= floor(p2_); s1 = (2 * sp - 1 - vo_blep(sp, si)) - (2 * p2_ - 1 - vo_blep(p2_, si)); ) : s1 = 0;
      i2 = p[21]; ph = p[17] + i2; ph -= floor(ph); p[17] = ph;
      o2 = w2 == 0 ? 0 : w2 == 1 ? 2 * ph - 1 - vo_blep(ph, i2) :
           w2 == 2 ? (ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph) :
           ( p2_ = ph + 1 - p[25]; p2_ -= floor(p2_); 0.8 * ((2 * ph - 1 - vo_blep(ph, i2)) - (2 * p2_ - 1 - vo_blep(p2_, i2))); );
      x = o1 * lv1 + o2 * lv2 + 0.5 * s1 * lvs;
      lvn > 0.0001 ? x += (rand(2) - 1) * lvn;
      y = mt_flt(p, x * 0.55 * drv, p[28], p[30]) * p[32];
      p[56] < 1 ? ( y *= 0.5 - 0.5 * cos($pi * p[56]); p[56] = min(p[56] + 1 / (0.004 * srate), 1); );
      y = nw_run(p + 57, y);
      k == 0 ? ( L0 += y * p[34]; R0 += y * p[35]; ) : ( L1 += y * p[34]; R1 += y * p[35]; );
      k += 1;
    );
  );
  p += VS;
);
HBL[hw] = L0; HBR[hw] = R0; hw = (hw + 1) & 63;
HBL[hw] = L1; HBR[hw] = R1;
oL = mt_hb(HBL, hw); oR = mt_hb(HBR, hw);
hw = (hw + 1) & 63;
dcx = oL; oL = oL - dcxl + dc_r * dcyl; dcxl = dcx; dcyl = oL;
dcx = oR; oR = oR - dcxr + dc_r * dcyr; dcxr = dcx; dcyr = oR;
mt_pre = max(mt_pre, max(abs(oL), abs(oR)));
sage += (min(abs(oL) + abs(oR), 2) - sage) * sagc;
pwr_in(oL, oR);  oL = pwr_l;  oR = pwr_r;
pwr_out(oL, oR);  oL = pwr_l;  oR = pwr_r;
vol_s += (vol_t - vol_s) * sm;
oL = ostL.ost_band(oL) * vol_s; oR = ostR.ost_band(oR) * vol_s;
ost_out(oL, oR);
spl0 = ost_l; spl1 = ost_r;
mt_pk_d = max(mt_pk_d, max(abs(spl0), abs(spl1)));
max(abs(spl0), abs(spl1)) > 0.8913 ? mm_pk_d = 1;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );

@gfx 900 355
