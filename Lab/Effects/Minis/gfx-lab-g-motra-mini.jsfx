  ui_cola(0xFFFFFF, 0.30); mg_r(x, y + h, w + 1, 1); mg_r(x + w, y, 1, h);
);
function mm_k(cx, cy, idx, lo, hi, def, lg, lbl, fmt, col, mid) local(r, u, v, n, a1, i, k, rr, kp_x, kp_y, s0) (
  kp_x = cx * sc; kp_y = cy * sc; s0 = sc; mm_kz > 0 ? sc *= mm_kz;
  ui_knob(kp_x, kp_y, idx, lo, hi, def, lg, lbl, fmt);
  r = 18 * sc; u = r / 21; rr = 13 * u; v = slider(idx);
  mid ? ( ui_col(C_INK); gfx_circle(kp_x, kp_y - 27.75 * u, max(0.95 * u, 1), 1, 1); );
  n = lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); n = min(max(n, 0), 1);
  a1 = -0.75 * $pi + n * 1.5 * $pi;
  ui_col(col); gfx_circle(kp_x, kp_y, rr, 1, 1);
  k = max(2, floor(4 * u + 0.5)); i = 0;
  loop(k, ui_cola(0x000000, 0.12 * (i + 1) / k); gfx_circle(kp_x, kp_y, rr - k + 1 + i, 0, 1); i += 1; );
  ui_cola(0x000000, 0.06); gfx_circle(kp_x + 0.6 * u, kp_y + 0.8 * u, rr, 0, 1);
  ui_kdot(kp_x, kp_y, a1, rr);
  sc = s0;
);
function mm_key(x, y, w, h, on, col, lbl) local(hov, hit) (
  hov = mg_in(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  mg_rshadow(x, y, w, h, 3);
  on ? ( ui_cola(col, 0.25); mg_rr(x - 5, y - 5, w + 10, h + 10, 7); );
  ui_col(0x0B0C0F); mg_rr(x - 2, y - 2, w + 4, h + 4, 4);
  on ? (
    ui_col(ui_mix(col, 0x000000, 0.25)); mg_rr(x, y + 1, w, h - 1, 3);
    ui_col(col); mg_rr(x + 2, y + 3, w - 4, h - 5, 3);
    ui_col(ui_mix(col, 0xFFF6E0, 0.45)); mg_rr(x + 6, y + 6, w - 12, h - 11, 3);
    gfx_setfont(13); ui_col(0x1A1A1C);
  ) : (
    ui_col(ui_mix(col, 0x000000, 0.68)); mg_rr(x, y, w, h, 3);
    ui_col(ui_mix(col, 0x000000, 0.55)); mg_rr(x + 2, y + 2, w - 4, h - 5, 3);
    ui_cola(0xFFFFFF, 0.12); mg_r(x + 4, y + 2, w - 8, 1);
    gfx_setfont(13); ui_col(ui_mix(col, 0xFFFFFF, 0.6));
  );
  hov ? ( ui_cola(0xFFFFFF, 0.08); mg_rr(x + 2, y + 2, w - 4, h - 4, 3); );
  mg_ctxt(x + w / 2, y + h / 2 + (on ? 1 : 0), lbl);
  hit;
);
function mm_panic(x, y, w, h) local(hov, hit, dn) (
  hov = mg_in(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  dn = hov && mdown ? 1 : 0;
  mg_rshadow(x, y, w, h, 4);
  ui_col(0x0E0F10); mg_rr(x - 2, y - 2, w + 4, h + 4, 5);
  ui_col(0x45484D); mg_rr(x, y + dn, w, h - dn, 4);
  ui_col(0x2C2E32); mg_rr(x + 1, y + 1 + dn, w - 2, h - 2 - dn, 4);
  ui_col(0x35373B); mg_rr(x + 1, y + 1 + dn, w - 2, h - 8, 4);
  hov ? ( ui_cola(0xFFFFFF, 0.06); mg_rr(x + 1, y + 1, w - 2, h - 2, 4); );
  gfx_setfont(13); ui_col(0xE8DCC0); mg_ctxt(x + w / 2, y + h / 2 + dn, "PANIC");
  hit;
);
function mm_box(x, y, w, h, t) local(hov) (
  hov = mg_in(x, y, w, h);
