desc:MSP 80 Mini [synth] (GFX Lab)
//tags: instrument synthesizer duophonic lead mono sync ring mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-power, gfx-lab-output, gfx-lab-clip, gfx-lab-os, gfx-lab-ui, gfx-lab-panel, gfx-lab-bverb, gfx-lab-bdelay, gfx-lab-warmup, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bverb.jsfx-inc
import gfx-lab-bdelay.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-sliders.jsfx-inc

in_pin:none
out_pin:left output
out_pin:right output

slider65:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:keymode=0<0,1,1{Duo,Unison}>-Keys
slider2:trig=1<0,1,1{Single,Multi}>-Trigger
slider3:glide=0.2<0,1,0.001>-Glide
slider4:spread=0.3<0,1,0.001>-Spread
slider5:o1wave=0<0,2,1{Saw,Square,Pulse}>-Osc 1 wave
slider6:o2wave=0<0,2,1{Saw,Square,Pulse}>-Osc 2 wave
slider7:o2semi=0<-24,24,1>-Osc 2 semitones
slider8:o2det=6<0,50,0.1>-Osc 2 detune (cents)
slider9:o2sync=0<0,1,1{Off,On}>-Osc 2 sync
slider10:pwid=0.3<0.05,0.5,0.001>-Pulse width
slider11:lv1=0.8<0,1,0.001>-Mixer osc 1
slider12:lv2=0.8<0,1,0.001>-Mixer osc 2
slider13:lvring=0<0,1,0.001>-Mixer ring
slider14:lvnoise=0<0,1,0.001>-Mixer noise
slider15:f1mode=0<0,3,1{LP 24,LP 12,BP,HP 24}>-Filter mode
slider16:cutoff=1800<20,20000,1:log>-Cutoff (Hz)
slider17:fres=0.3<0,1,0.001>-Resonance
slider18:fenvamt=0.45<-1,1,0.001>-Filter env amount
slider19:fkey=0.5<0,1,0.01>-Key tracking
slider20:hpf=20<20,2000,1:log>-HPF (Hz)
slider21:fe_a=2<0.5,5000,0.1:log>-Filter attack (ms)
slider22:fe_d=400<1,10000,1:log>-Filter decay (ms)
slider23:fe_s=30<0,100,0.1>-Filter sustain (%)
slider24:fe_r=300<1,10000,1:log>-Filter release (ms)
slider25:ae_a=3<0.5,5000,0.1:log>-Amp attack (ms)
slider26:ae_d=500<1,10000,1:log>-Amp decay (ms)
slider27:ae_s=80<0,100,0.1>-Amp sustain (%)
slider28:ae_r=250<1,10000,1:log>-Amp release (ms)
slider29:vsens=0.4<0,1,0.01>-Velocity
slider30:ch_mix=0<0,1,0.001>-Chorus mix
slider31:dl_sync=1<0,1,1{Free,Sync}>-Delay sync
slider32:dl_ms=375<10,2000,1:log>-Delay time (ms)
slider33:dl_div=8<0,13,1{1/1,1/2,1/2D,1/2T,1/4,1/4D,1/4T,1/8,1/8D,1/8T,1/16,1/16D,1/16T,1/32}>-Delay time (sync)
slider34:dl_fb=0.35<0,0.95,0.001>-Delay feedback
slider35:dl_mix=0.18<0,1,0.001>-Delay mix
slider36:dl_pp=1<0,1,1{Stereo,Ping-pong}>-Delay mode
slider37:dl_hpf=150<20,2000,1:log>-Delay HPF (Hz)
slider38:dl_lpf=4500<1000,20000,1:log>-Delay LPF (Hz)
slider39:sp_size=0.55<0,1,0.001>-Space size
slider40:sp_decay=2.2<0.2,12,0.01:log>-Space decay (s)
slider41:sp_damp=0.5<0,1,0.001>-Space damping
slider42:sp_mix=0.15<0,1,0.001>-Space mix
slider43:sp_cut=1<0,3,1{Off,-3 dB,-6 dB,-9 dB}>-Space 500 Hz cut
slider44:eq_lo=0<-12,12,0.1>-EQ low (dB)
slider45:eq_hi=0<-12,12,0.1>-EQ high (dB)
slider46:vol=0<-24,6,0.1>-Volume (dB)
slider47:drift=50<0,100,1>-Drift (%)
slider48:lfo_shape=0<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO shape
slider49:lfo_sync=0<0,1,1{Free,Sync}>-LFO sync
slider50:lfo_hz=5.5<0.01,20,0.001:log>-LFO rate (Hz)
slider51:lfo_div=11<0,13,1{4 bars,2 bars,1 bar,1/2,1/2 dotted,1/4,1/4 dotted,1/4 triplet,1/8,1/8 dotted,1/8 triplet,1/16,1/16 triplet,1/32}>-LFO note value
slider52:lfo_vib=0<0,100,0.1>-LFO to pitch (cents)
slider53:lfo_pwm=0<0,1,0.001>-LFO to pulse width
slider54:lfo_cut=0<0,3,0.01>-LFO to cutoff (oct)
slider55:lfo_dly=300<0,3000,1>-LFO delay (ms)
slider56:mw_vib=30<0,100,0.1>-Mod wheel to pitch (cents)
slider57:sat_amt=0<0,100,1>-Output sat (%)
slider58:drv_type=0<0,3,1{Tube,Fuzz,Rect,Crush}>-Drive type
slider59:drv_amt=0<0,10,0.1>-Drive amount (0 = off)
slider60:drv_mix=100<0,100,0.1>-Drive mix (%)
slider61:ffat=0<0,10,0.1>-Ffat
slider62:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling (the drive)
slider63:octv=0<-2,2,1>-Octave
slider64:prs_sel=0<0,18,1{No preset,Init,Sync Lead,Ring Bells,Square Duo,Pulse Vibrato,Fat Unison,Thirds Lead,Bass + Melody,Soft Flute,Brass Duo,Acid Line,Whistle,Fifth Stack,Screamer,Breath Pulse,Slow Swell,Nasal Reed,Chip Duo}>-Preset

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(lfo_pwm, v); slider_show(lfo_cut, v); slider_show(lfo_dly, v); slider_show(mw_vib, v); slider_show(sat_amt, v); slider_show(drv_type, v); slider_show(drv_amt, v); slider_show(drv_mix, v); slider_show(ffat, v); slider_show(os_sel, v); slider_show(octv, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(lfo_pwm, v); slider_show(lfo_cut, v); slider_show(lfo_dly, v); slider_show(mw_vib, v); slider_show(sat_amt, v); slider_show(drv_type, v); slider_show(drv_amt, v); slider_show(drv_mix, v); slider_show(ffat, v); slider_show(os_sel, v); slider_show(octv, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-msp-80-mini";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;
NWB = 1980;  memset(NWB, 0, 8);  nf_p = 1;  nf_st = 1 / (0.002 * srate);  rs_g = 1;  rs_inc = 1 / (0.015 * srate);
pwr_init();
pwr_wu_loss = 0.5;  pwr_wu_drv = 0;  pwr_wu_lp = 9000;  pwr_wu_wob = 0.3;  pwr_bloom = 0;  pwr_sag = 0.15;

KH = 900;  KHV = 920;  KHS = 940;
LDA = 960;  LDB = 970;
MQ = 4096;
MQMAX = 1000;
FX_MEM = 1048576;
memset(KH, 0, 80);  memset(LDA, 0, 20);

bv_alloc(FX_MEM);
bd_alloc(BV_END);
CH_N = ceil(0.03 * srate) + 4;  CH_L = BD_END;  CH_R = CH_L + CH_N;  memset(CH_L, 0, 2 * CH_N);
cho_w = 0;  cho_c = 1;  cho_s = 0;
fx_qt = 0.0000001;  sp_qn = ceil(1.5 * srate);  dl_qn = DL_N + 64;  ch_qn = CH_N + 64;
sp_q = sp_qn;  dl_q = dl_qn;  ch_q = ch_qn;
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
RVM = 1960;  k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );

function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );

function ds_tick(x) instance(a, b, pf, cnt, held, xp, dcx, dcy) local(u, y, dry) (
  dry = 0.5 * (x + xp);  xp = x;
  dt_a == 3 ? (
    cnt -= 1;
    cnt <= 0 ? ( cnt = cr_hold;  held = min(max(floor(x * cr_q + 0.5) / cr_q, -1), 1); );
    y = held;  dry = x;
  ) : (
    u = pf.clp_pf_run(x) * ds_g;
    dt_a == 0 ? ( y = (a.clp_run(u + ds_b) - ds_rest) * ds_c; ) :
    dt_a == 1 ? ( y = a.clp_run(u) * ds_c; ) :
                ( y = 0.5 * (a.clp_run(u) + b.clp_run(u)) * ds_c; );
  );
  dcy = y - dcx + ds_dcc * dcy;  dcx = y;
  dry + (dcy - dry) * dmx_s;
);
function ds_reset() instance(a, b, cnt, held, xp, dcx, dcy) (
  a.clp_reset();  b.clp_reset();  cnt = 0;  held = 0;  xp = 0;  dcx = 0;  dcy = 0;
);
function sv2_set(fc, k) instance(a1, a2, a3, kk) local(g) (
  g = tan($pi * min(max(fc, 10), srate * 0.45) / srate);
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  kk = k;
);
function sv2_run(x) instance(a1, a2, a3, kk, s0, s1, hp, bp) local(v1, v2, v3) (
  v3 = x - s1;  v1 = a1 * s0 + a2 * v3;  v2 = s1 + a2 * s0 + a3 * v3;
  s0 = 2 * v1 - s0;  s1 = 2 * v2 - s1;
  bp = v1;  hp = x - kk * v1 - v2;
  v2;
);
function vt_run(x) instance(h, m, l) local(y) (
  h.sv2_run(x);  y = h.hp;
  m.sv2_run(y);  y -= vt_c * m.kk * m.bp;
  l.sv2_run(y);
);
function vt_set() (
  vtL.h.sv2_set(140, 1.41421356);  vtR.h.sv2_set(140, 1.41421356);
  vtL.m.sv2_set(500, 1 / 0.9);     vtR.m.sv2_set(500, 1 / 0.9);
  vtL.l.sv2_set(5000, 1.41421356); vtR.l.sv2_set(5000, 1.41421356);
);
dsL.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);  dsR.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);
dsL.pf.clp_pf_reset();  dsR.pf.clp_pf_reset();  dsL.ds_reset();  dsR.ds_reset();
function drv_curves() (
  dn = dam_s / 10;  ds_st = min(1, dam_s / 3);
  dt_a == 0 ? (
    ds_g = 10 ^ (dam_s * 2.4 / 20);  ds_b = 0.08 + 0.12 * dn;
    dsL.a.clp_set(1, 1, 0.72, 0);  dsR.a.clp_set(1, 1, 0.72, 0);
    ds_rest = dsL.a.clp_crv(ds_b);
    ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(dsL.a.clp_crv(0.25 * ds_g + ds_b) - ds_rest, 0.0001);
  ) : dt_a == 1 ? (
    ds_g = 10 ^ (dam_s * 4 / 20);
    dsL.a.clp_set(0, 0.6, 0.6, 0.04 * dn);  dsR.a.clp_set(0, 0.6, 0.6, 0.04 * dn);
    ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(dsL.a.clp_crv(0.25 * ds_g), 0.0001);
  ) : dt_a == 2 ? (
    ds_g = 10 ^ (dam_s * 2 / 20);
    dsL.a.clp_set(3, 1, 1, 0);  dsR.a.clp_set(3, 1, 1, 0);
    dsL.b.clp_set(1, 1, 1, 0);  dsR.b.clp_set(1, 1, 1, 0);
    ds_c = 0.25 / max(0.5 * (dsL.a.clp_crv(0.25 * ds_g) + dsL.b.clp_crv(0.25 * ds_g)), 0.0001);
  ) : (
    cr_q = 2 ^ (15 - dam_s * 1.3);
    cr_hold = (1 + floor(sqr(dn) * 23)) * os_f;
  );
);
OSD = 3400;  memset(OSD, 0, 128);  osd_w = 0;
os_design();  os_base = 0;  os_f = os_tf = os_f2n(os_sel);  os_gsetup();
dr_gc = 1 - exp(-16 / (0.05 * srate));  dr_cn = 0;
dr_ec = 1 - exp(-1 / (0.4 * srate));  dr_mc = 1 - exp(-1 / (0.2 * srate));  dr_m = 1;  dr_ei = dr_eo = 0;
ffc_att = 1 - exp(-1 / (0.003 * srate));  ffc_rel = 1 - exp(-1 / (0.09 * srate));
vt_set();
function saw_bl(p, d) local(s, t) (
  s = 2 * p - 1;
  p < d ? ( t = p / d;  s -= t + t - t * t - 1; ) : p > 1 - d ? ( t = (p - 1) / d;  s -= t * t + t + t + 1; );
  s;
);
function env_coef(ms) ( exp(-6.9 * CR / max(1, ms * 0.001 * srate)); );
function lad(s, x) local(u, v, y1, y2, y3, y4) (
  y4 = (lG4 * x + lB * (lG3 * s[0] + lG2 * s[1] + lG * s[2] + s[3])) * linv;
  u = ts(x - kres * y4);
  v = (u - s[0]) * lG;   y1 = v + s[0];  s[0] = y1 + v;
  v = (y1 - s[1]) * lG;  y2 = v + s[1];  s[1] = y2 + v;
  v = (y2 - s[2]) * lG;  y3 = v + s[2];  s[2] = y3 + v;
  v = (y3 - s[3]) * lG;  y4 = v + s[3];  s[3] = y4 + v;
  lc0 * u + lc1 * y1 + lc2 * y2 + lc3 * y3 + lc4 * y4;
);

function set_taps(m) (
  m < 0.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 0;  lc3 = 0;  lc4 = 1; ) :
  m < 1.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 1;  lc3 = 0;  lc4 = 0; ) :
  m < 2.5 ? ( lc0 = 0;  lc1 = 0;  lc2 = 4;  lc3 = -8; lc4 = 4; ) :
            ( lc0 = 1;  lc1 = -4; lc2 = 6;  lc3 = -4; lc4 = 1; );
);
function osc(w, p, d) local(q) (
  w < 0.5 ? saw_bl(p, d) :
  ( q = p + (w < 1.5 ? 0.5 : pw_s);  q >= 1 ? q -= 1;  saw_bl(p, d) - saw_bl(q, d); );
);
function osc_nv(w, p) local(q) (
  w < 0.5 ? 2 * p - 1 : ( q = p + (w < 1.5 ? 0.5 : pw_s);  q -= floor(q);  2 * p - 2 * q; );
);

function kh_find(n) local(i, f) ( f = -1;  i = 0;  loop(kh_n, KH[i] == n ? f = i;  i += 1; );  f; );
function kh_cut(f) local(i) (
  i = f;  loop(kh_n - f - 1, KH[i] = KH[i + 1];  KHV[i] = KHV[i + 1];  KHS[i] = KHS[i + 1];  i += 1; );  kh_n -= 1;
);
function assign(new_vel) local(i, lo, hi, last) (
  kh_n == 0 ? (
    gate ? ( gate = 0;  ast = 4;  fst = 4; );
  ) : (
    last = KH[kh_n - 1];  lo = 128;  hi = -1;
    i = 0;  loop(kh_n, lo = min(lo, KH[i]);  hi = max(hi, KH[i]);  i += 1; );
    keymode >= 0.5 ? ( t1 = last;  t2 = last; ) : ( t1 = lo;  t2 = hi; );
    new_vel > 0 ? (
      !gate && aen < 0.001 ? ( p1 = t1;  p2 = t2;  nf_p = 0;  nw_start(NWB); );
      !gate ? l_fade = 0;
      !gate || trig >= 0.5 ? (
        ast = 1;  fst = 1;
        a_gain = 1 - vsens + vsens * new_vel / 127;
        f_vel = 1 - 0.5 * vsens + 0.5 * vsens * new_vel / 127;
      );
      nd1 = (rand(2) - 1) * 0.04 * dm_a;  nd2 = (rand(2) - 1) * 0.04 * dm_a;
      gl_f = max(0.3, 1 + (rand(2) - 1) * 0.25 * dm_a);
    );
    gate = 1;
  );
  n1_disp = t1;  n2_disp = t2;  keys_disp = kh_n;
);
function key_on(n, v) local(f) (
  f = kh_find(n);  f >= 0 ? kh_cut(f);
  kh_n < 16 ? ( KH[kh_n] = n;  KHV[kh_n] = v;  KHS[kh_n] = 0;  kh_n += 1; );
  assign(v);
);
function key_off(n) local(f) (
  f = kh_find(n);
  f >= 0 ? ( sustain ? KHS[f] = 1 : ( kh_cut(f);  assign(0); ); );
);
function pedal_up() local(i) (
  i = kh_n - 1;  loop(kh_n, KHS[i] ? kh_cut(i);  i -= 1; );
  assign(0);
);
function all_off() ( kh_n = 0;  assign(0); );

function midi_event(i) local(st, d1, d2, c) (
  st = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  st == 0x90 && d2 > 0 ? key_on(d1, d2) :
  (st == 0x80 || (st == 0x90 && d2 == 0)) ? key_off(d1) :
  st == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  st == 0xB0 ? (
    d1 == 1 ? mw_t = d2 / 127 :
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? ( sustain = 0;  pedal_up(); );  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? all_off();
  );
);

function env_tick(lv, stg, a_inc, d_c, s_lv, r_c) (
  stg == 1 ? ( lv += a_inc;  lv >= 1 ? ( lv = 1;  stg = 2; ); ) :
  stg == 2 ? ( lv = s_lv + (lv - s_lv) * d_c; ) :
  stg == 4 ? ( lv *= r_c; );
  env_out_stg = stg;
  lv;
);

function c_tick() local(t, g, fc, s, vb) (
  aen = env_tick(aen, ast, a_ainc, a_dc, a_sl, a_rc);  ast = env_out_stg;
  fen = env_tick(fen, fst, f_ainc, f_dc, f_sl, f_rc);  fst = env_out_stg;
  t = gl_ms * gl_f;
  t < 1 ? ( p1 = t1;  p2 = t2; ) : ( g = 1 - exp(-3 * CR / (t * 0.001 * srate));  p1 += (t1 - p1) * g;  p2 += (t2 - p2) * g; );
  dv1 = dr1.drift_tick(0.25 * dm_s * CR / srate) * 0.12 * dm_a;
  dv2 = dr2.drift_tick(0.25 * dm_s * CR / srate) * 0.12 * dm_a;
  dvc = drc.drift_tick(0.15 * dm_s * CR / srate) * 0.3 * dm_a;
  gate ? l_fade = min(1, l_fade + l_fstep);
  mw_s += (mw_t - mw_s) * fl_k;
  vb = lfo_v * (l_fade * lv_s + mw_s * mw_vib) * 0.01;
  s = bend + octv * 12 + vb;
  inc1 = min(440 * 2 ^ ((p1 - 69 + s + dv1 + nd1 + wu1) / 12) / srate, 0.45);
  inc2 = min(440 * 2 ^ ((p2 - 69 + s + o2_st + dv2 + nd2 + wu2) / 12) / srate, 0.45);
  pw_t = max(0.03, min(0.97, pwid + lfo_v * l_fade * lpw_s * 0.45));
  fc = 2 ^ (lcs + fk_s * ((p1 + p2) * 0.5 + octv * 12 - 60) / 12 + fen * fl_ev * 6 * f_vel + dvc + wuc + lfo_v * l_fade * lc_s);
  t = max(20, min(fc, 0.45 * srate));  g = tan($pi * t / srate);  t = g / (1 + g);
  flt_gs = (t - flt_g) / CR;
  av_s = (aen * a_gain - av) / CR;
);

gate = 0;  kh_n = 0;  t1 = t2 = p1 = p2 = 60;  aen = fen = 0;  ast = fst = 0;  av = av_s = 0;  a_gain = f_vel = 1;
nd1 = nd2 = 0;  gl_f = 1;  l_fade = 0;  mw_t = mw_s = 0;  bend = 0;  sustain = 0;  cr_n = 0;
n1_disp = n2_disp = 60;  keys_disp = 0;
dr1.drift_init(0.8 + rand(1) * 0.4);  dr2.drift_init(0.8 + rand(1) * 0.4);  drc.drift_init(0.8 + rand(1) * 0.4);
o1p = o2p = 0;  ph1 = 0;  ph2 = 0.37;  inc1 = inc2 = 0.005;  flt_g = 0.1;  flt_gs = 0;
hp_a = hp_b = 0;  nz_s = 0;
sz_s = sp_size;  lfo_ph = 0;  lfo_v = 0;  lfo_raw = 0;  lfo_sh = 0;
pw_s = pwid;
lcs = fl_c1 = log(cutoff) / log(2);  kres = fres * 4.1;  fl_ev = fenvamt;

function fx_block() local(k, sz, ms, t) (
  t = dl_sync >= 0.5 ? 60 / max(tempo, 20) * bd_beats(floor(dl_div + 0.5)) : dl_ms * 0.001;
  dl_t = min(t * srate, 3 * srate);
  dl_dc = 1 - exp(-2 * $pi * min(dl_lpf, 0.45 * srate) / srate);
  dl_hc = 1 - exp(-2 * $pi * dl_hpf / srate);
  sl_c = 1 - exp(-1 / (0.15 * srate));
  sz_s += (sp_size - sz_s) * min(1, samplesblock / (0.25 * srate));
  sz = 0.3 + 0.7 * sz_s;
  k = 0;
  loop(8,
    ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
    ln_len[k] = floor(ms * 0.001 * srate * sz * 1.6);
    k += 1;
  );
  bv_t60 = sp_decay;  bv_rtlo = 1.25;  bv_rthi = 1 - 0.82 * sp_damp;
  k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
  bv_xover();
  sp_pre = (0.008 + 0.03 * sz_s) * srate;
  k = 0;
  loop(8,
    RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
    ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
    k += 1;
  );
  dl_mix > 0.0005 && !dl_live ? ( memset(BD_L, 0, 2 * DL_N);  dlL.init = 0;  dlR.init = 0;  dl_fl = dl_fr = dl_hl = dl_hr = 0; );
  sp_mix > 0.0005 && !sp_live ? bv_alloc(FX_MEM);
  dl_live = dl_mix > 0.0005 || dlm_s > 0.0005;  sp_live = sp_mix > 0.0005 || spm_s > 0.0005;
);
function update_params() local(t) (
  a_ainc = CR / max(1, ae_a * 0.001 * srate);  a_dc = env_coef(ae_d);  a_sl = ae_s / 100;  a_rc = env_coef(ae_r);
  f_ainc = CR / max(1, fe_a * 0.001 * srate);  f_dc = env_coef(fe_d);  f_sl = fe_s / 100;  f_rc = env_coef(fe_r);
  drift_macro(drift);
  dc_r = 1 - 2 * $pi * 5 / srate;
  outg_t = 10 ^ (vol / 20) * 0.21;
  o2_st = o2semi + o2det * 0.01;
  gl_ms = 2000 * glide * glide;
  l_fstep = CR / max(1, lfo_dly * 0.001 * srate);
  l1_t = lv1;  l2_t = lv2;  lr_t = lvring;  ln_t = lvnoise;  spr_t = spread;
  hp_t = 1 - exp(-2 * $pi * hpf / srate);
  w1_t = floor(o1wave + 0.5);  w2_t = floor(o2wave + 0.5);  fm_t = floor(f1mode + 0.5);  sy_t = o2sync >= 0.5;
  smk = 1 - exp(-1 / (0.015 * srate));  lfo_sm = 1 - exp(-CR / (0.004 * srate));  dk_st = 1 / (0.005 * srate);
  chm_t = ch_mix;  dlm_t = dl_mix;  spm_t = sp_mix;
  t = 2 * $pi * 0.5 / srate;  cho_ca = cos(t);  cho_sa = sin(t);
  cho_base = 0.006 * srate;  cho_dep = 0.0025 * srate;
  eq_lc = 1 - exp(-2 * $pi * 200 / srate);  eq_hc = 1 - exp(-2 * $pi * 4500 / srate);
  eql_t = 10 ^ (eq_lo / 20) - 1;  eqh_t = 10 ^ (eq_hi / 20) - 1;
  drv_t = drv_amt >= 0.05;  dt_t = floor(drv_type + 0.5);  dam_t = drv_amt;  dmx_t = drv_mix * 0.01;
  ffat_t = ffat;
  t = floor(sp_cut + 0.5);  vt_t = t > 0;  t > 0 ? vtc_t = 1 - 10 ^ (-3 * t / 20);
);

update_params();
l1_s = l1_t;  l2_s = l2_t;  lr_s = lr_t;  ln_s = ln_t;  spr_s = spr_t;  hp_c = hp_t;  out_g = outg_t;
chm_s = chm_t;  dlm_s = dlm_t;  spm_s = spm_t;
drv_s = drv_t;  dt_a = dt_t;  dam_s = dam_t;  dmx_s = dmx_t;  ffat_s = ffat_t;  vt_s = vt_t;  vt_c = vtc_t;  grs = 0;
eql_s = eql_t;  eqh_s = eqh_t;  fk_s = fkey;  lc_s = lfo_cut;  lv_s = lfo_vib;  lpw_s = lfo_pwm;
w1_l = w1_t;  w2_l = w2_t;  fm_l = fm_t;  sy_l = sy_t;  set_taps(fm_l);  dk = 1;  dk_req = 0;

function sl_auto(idx) (
