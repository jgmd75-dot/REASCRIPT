  idx == 45 ? slider_automate(eq_hi) : idx == 46 ? slider_automate(vol) : idx == 47 ? slider_automate(drift) :
  idx == 48 ? slider_automate(lfo_shape) : idx == 49 ? slider_automate(lfo_sync) : idx == 50 ? slider_automate(lfo_hz) :
