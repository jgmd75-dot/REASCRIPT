  idx == 33 ? slider_automate(dl_div) : idx == 34 ? slider_automate(dl_fb) : idx == 35 ? slider_automate(dl_mix) :
  idx == 36 ? slider_automate(dl_pp) : idx == 37 ? slider_automate(dl_hpf) : idx == 38 ? slider_automate(dl_lpf) :
  idx == 39 ? slider_automate(sp_size) : idx == 40 ? slider_automate(sp_decay) : idx == 41 ? slider_automate(sp_damp) :
