function prs_hash() local(i, h) ( h = 0; i = 1; loop(64, i != 64 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;
function gap_clr() (
  all_off();  aen = fen = 0;  ast = fst = 0;  av = av_s = 0;  sustain = 0;
  memset(LDA, 0, 20);  memset(CH_L, 0, 2 * CH_N);  memset(BD_L, 0, 2 * DL_N);  dlL.init = 0;  dlR.init = 0;
  dl_fl = dl_fr = dl_hl = dl_hr = 0;  bv_alloc(FX_MEM);
  osuL.os_clr();  osuR.os_clr();  osdL.os_clr();  osdR.os_clr();  dsL.ds_reset();  dsR.ds_reset();  memset(OSD, 0, 128);
  hp_a = hp_b = 0;  dc_xl = dc_xr = dc_pl = dc_pr = dc_ol = dc_or = dc_qol = dc_qor = 0;
  eq_l1 = eq_h1 = eq_r1 = eq_g1 = 0;  grs = 0;  memset(NWB, 0, 8);  rs_g = 0;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update_params();
os_snap(slider(62));

@block
prs_chk();
rs_now = time_precise();
rs_tp > 0 && rs_now - rs_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? gap_clr();
rs_tp = rs_now;  rs_gpp = play_position;  rs_gpd = samplesblock / srate;
pn_dirty ? ( pn_dirty = 0;  sustain = 0;  all_off(); );
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;
  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
  (m_st & 0xF0) == 0x90 && m_d2 > 0 ? mi_led_d = 1;
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? all_off();
tp_was = tp_now;
prm_dirty ? ( prm_dirty = 0;  update_params(); );
pwr_block(1);
wu_d = 1 - pwr_gm;
wu1 = wu_d * (-0.15 + 0.06 * pwr_w1);
wu2 = wu_d * (-0.09 + 0.06 * pwr_w2);
wuc = -0.25 * wu_d;
(w1_t != w1_l || w2_t != w2_l || fm_t != fm_l || sy_t != sy_l) ? dk_req = 1;
lfo_bpc = lfo_div < 0.5 ? 16 : lfo_div < 1.5 ? 8 : lfo_div < 2.5 ? 4 : lfo_div < 3.5 ? 2 : lfo_div < 4.5 ? 3 : lfo_div < 5.5 ? 1 :
          lfo_div < 6.5 ? 1.5 : lfo_div < 7.5 ? 2 / 3 : lfo_div < 8.5 ? 0.5 : lfo_div < 9.5 ? 0.75 : lfo_div < 10.5 ? 1 / 3 :
          lfo_div < 11.5 ? 0.25 : lfo_div < 12.5 ? 1 / 6 : 0.125;
lfo_rate = lfo_sync >= 0.5 ? max(tempo, 20) / 60 / lfo_bpc : lfo_hz;
lfo_sync >= 0.5 && tp_now ? (
  lfo_dd = beat_position / lfo_bpc;  lfo_dd -= floor(lfo_dd);  lfo_dd -= lfo_ph;  lfo_dd -= floor(lfo_dd + 0.5);
  lfo_ph += lfo_dd * 0.25;  lfo_ph -= floor(lfo_ph);
);
lfo_disp = lfo_ph;
fx_block();
dt_t != dt_a ? dk_req = 1;
ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
dsL.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);  dsR.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);
os_tf = os_f2n(os_sel);
dsL.a.clp_tidy();  dsR.a.clp_tidy();  dsL.b.clp_tidy();  dsR.b.clp_tidy();
drv_t && !drv_live ? ( dsL.ds_reset();  dsR.ds_reset();  dr_ei = dr_eo = 0;  dr_m = 1; );
drv_live = drv_t || drv_s > 0.0001;
ff_live = ffat_t > 0 || ffat_s > 0.0001;
fl_k = 1 - exp(-CR / (0.015 * srate));
f_in = 0.35 * (1 + 0.5 * kres);
f_out = 1 / 0.35;
sat_g += (sat_amt - sat_g) * min(1, samplesblock / (0.03 * srate));
ost_setup(sat_g / 100, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);
outpk_disp = max(outpk_disp, outpk);  outpk = 0;
ost_clipped ? ( clip_d = 1;  ost_clipped = 0; );
gate_disp = gate;
mn_pk_d = max(mn_pk_d, mn_pkm);  mn_pkm = 0;
os_snapb(slider(62));

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;

cr_n <= 0 ? (
  cr_n = CR;
  fl_c1 += (log(cutoff) / log(2) - fl_c1) * fl_k;  lcs += (fl_c1 - lcs) * fl_k;
  kres += (fres * 4.1 - kres) * fl_k;
  fl_ev += (fenvamt - fl_ev) * fl_k;
  fk_s += (fkey - fk_s) * fl_k;
  lc_s += (lfo_cut - lc_s) * fl_k;  lv_s += (lfo_vib - lv_s) * fl_k;  lpw_s += (lfo_pwm - lpw_s) * fl_k;
  lfo_ph += lfo_rate * CR / srate;
  lfo_ph >= 1 ? ( lfo_ph -= floor(lfo_ph);  lfo_sh = rand(2) - 1; );
  lfo_raw = lfo_shape < 0.5 ? sin(2 * $pi * lfo_ph) : lfo_shape < 1.5 ? 1 - 4 * abs(lfo_ph - 0.5) :
            lfo_shape < 2.5 ? 1 - 2 * lfo_ph : lfo_shape < 3.5 ? ( lfo_ph < 0.5 ? 1 : -1 ) : lfo_sh;
  lfo_v += (lfo_raw - lfo_v) * lfo_sm;
  c_tick();
);
cr_n -= 1;
pw_s += (pw_t - pw_s) * 0.002;
l1_s += (l1_t - l1_s) * smk;  l2_s += (l2_t - l2_s) * smk;  lr_s += (lr_t - lr_s) * smk;  ln_s += (ln_t - ln_s) * smk;
spr_s += (spr_t - spr_s) * smk;  hp_c += (hp_t - hp_c) * smk;  out_g += (outg_t - out_g) * smk;
chm_s += (chm_t - chm_s) * smk;  dlm_s += (dlm_t - dlm_s) * smk;  spm_s += (spm_t - spm_s) * smk;
eql_s += (eql_t - eql_s) * smk;  eqh_s += (eqh_t - eqh_s) * smk;
dk_req ? (
  dk -= dk_st;
  dk <= 0 ? ( dk = 0;  w1_l = w1_t;  w2_l = w2_t;  fm_l = fm_t;  sy_l = sy_t;  set_taps(fm_l);  dt_t != dt_a ? ( dt_a = dt_t;  dsL.ds_reset();  dsR.ds_reset(); );  dk_req = 0; );
) : dk < 1 ? dk = min(1, dk + dk_st);

ph2_o = ph2;
ph1 += inc1;  w1 = ph1 >= 1;  w1 ? ph1 -= 1;
ph2 += inc2;  ph2 >= 1 ? ph2 -= 1;
y1 = osc(w1_l, ph1, inc1);
sy_l && w1 ? (
  u_t = ph1 / inc1;
  u_pe = ph2_o + (1 - u_t) * inc2;  u_pe -= floor(u_pe);
  ph2 = u_t * inc2;
  u_h = osc_nv(w2_l, 0) - osc_nv(w2_l, u_pe);
  y2 = osc(w2_l, ph2, inc2);
  y2 -= (-2) * -sqr(1 - u_t) * 0.5;
  y2 += u_h * -sqr(1 - u_t) * 0.5;
  o2p += u_h * sqr(u_t) * 0.5;
) : y2 = osc(w2_l, ph2, inc2);
u_o1 = o1p;  u_o2 = o2p;  o1p = y1;  o2p = y2;

nz_s = rand(2) - 1;
u_sh = (u_o1 * u_o2 * lr_s + nz_s * ln_s * 0.7) * 0.5;
u_a = u_o1 * l1_s + u_sh;  u_b = u_o2 * l2_s + u_sh;
hp_a += (u_a - hp_a) * hp_c;  u_a -= hp_a;  hp_b += (u_b - hp_b) * hp_c;  u_b -= hp_b;
flt_g += flt_gs;  lG = flt_g;  lB = 1 - lG;  lG2 = lG * lG;  lG3 = lG2 * lG;  lG4 = lG2 * lG2;  linv = 1 / (1 + kres * lG4);
u_a = lad(LDA, u_a * f_in) * f_out;  u_b = lad(LDB, u_b * f_in) * f_out;
av += av_s;
u_g = av * out_g * dk;
u_p = spr_s * 0.8;
yl = (u_a + u_b * (1 - u_p)) * u_g;  yr = (u_a * (1 - u_p) + u_b) * u_g;
nf_p < 1 ? ( nf_p = min(1, nf_p + nf_st);  u_nf = 0.5 - 0.5 * cos($pi * nf_p);  yl *= u_nf;  yr *= u_nf; );
NWB[2] ? ( nw_run2(NWB, yl, yr);  yl = nw_l;  yr = nw_r; );
dc_xl = yl - dc_pl + dc_r * dc_xl;  dc_pl = yl;  yl = dc_xl;
dc_xr = yr - dc_pr + dc_r * dc_xr;  dc_pr = yr;  yr = dc_xr;
pwr_in(yl, yr);  yl = pwr_l;  yr = pwr_r;

drv_s += (drv_t - drv_s) * smk;  dmx_s += (dmx_t - dmx_s) * smk;
os_gate();
os_chg ? (
  osuL.os_clr();  osuR.os_clr();  osdL.os_clr();  osdR.os_clr();  dsL.ds_reset();  dsR.ds_reset();
  dsL.pf.clp_pf_reset();  dsR.pf.clp_pf_reset();
  dsL.pf.clp_pf_block(dn, srate * os_f, 1);  dsR.pf.clp_pf_block(dn, srate * os_f, 1);
  ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);  dr_cn = 0;
);
OSD[osd_w] = yl;  OSD[64 + osd_w] = yr;
u_l = OSD[(osd_w - os_lat(os_f)) & 63];  u_r = OSD[64 + ((osd_w - os_lat(os_f)) & 63)];
osd_w = (osd_w + 1) & 63;
drv_live ? (
  dr_cn -= 1;
  dr_cn <= 0 ? ( dr_cn = 16;  dam_s += (dam_t - dam_s) * dr_gc;  drv_curves(); );
  os_f == 1 ? ( u_dl = dsL.ds_tick(yl);  u_dr = dsR.ds_tick(yr); ) : (
    osuL.os_up(yl);  osuR.os_up(yr);
    oa0 = dsL.ds_tick(osuL.s0);  ob0 = dsR.ds_tick(osuR.s0);
    oa1 = dsL.ds_tick(osuL.s1);  ob1 = dsR.ds_tick(osuR.s1);
    os_f > 2 ? (
      oa2 = dsL.ds_tick(osuL.s2);  ob2 = dsR.ds_tick(osuR.s2);
      oa3 = dsL.ds_tick(osuL.s3);  ob3 = dsR.ds_tick(osuR.s3);
    );
    u_dl = osdL.os_dn(oa0, oa1, oa2, oa3);  u_dr = osdR.os_dn(ob0, ob1, ob2, ob3);
  );
  yl = u_l;  yr = u_r;
  dr_ei += (yl * yl + yr * yr - dr_ei) * dr_ec;  dr_eo += (u_dl * u_dl + u_dr * u_dr - dr_eo) * dr_ec;
  dr_m += ((dr_eo > 0.00000001 ? min(max(sqrt(dr_ei / dr_eo), 0.25), 2) : 1) - dr_m) * dr_mc;
  yl += (u_dl * dr_m - yl) * drv_s;  yr += (u_dr * dr_m - yr) * drv_s;
) : ( drv_s = 0;  yl = u_l;  yr = u_r; );
yl *= os_g;  yr *= os_g;
pwr_out(yl, yr);  yl = pwr_l;  yr = pwr_r;

(
  CH_L[cho_w] = yl;  CH_R[cho_w] = yr;
  c_t = cho_c * cho_ca - cho_s * cho_sa;  cho_s = cho_s * cho_ca + cho_c * cho_sa;  cho_c = c_t;
  abs(yl) + abs(yr) > fx_qt ? ch_q = 0 : ch_q < ch_qn ? ch_q += 1;
  ch_q < ch_qn ? (
    c_p = cho_w - (cho_base + cho_dep * cho_s);  c_p < 0 ? c_p += CH_N;
    c_i = floor(c_p);  c_f = c_p - c_i;  c_j = c_i + 1;  c_j >= CH_N ? c_j = 0;
    c_l = CH_L[c_i] + (CH_L[c_j] - CH_L[c_i]) * c_f;
    c_p = cho_w - (cho_base + cho_dep * cho_c);  c_p < 0 ? c_p += CH_N;
    c_i = floor(c_p);  c_f = c_p - c_i;  c_j = c_i + 1;  c_j >= CH_N ? c_j = 0;
    c_r = CH_R[c_i] + (CH_R[c_j] - CH_R[c_i]) * c_f;
  ) : ( c_l = c_r = 0; );
  yl = yl * (1 - 0.35 * chm_s) + c_l * 0.7 * chm_s;
  yr = yr * (1 - 0.35 * chm_s) + c_r * 0.7 * chm_s;
  cho_w += 1;  cho_w >= CH_N ? ( cho_w = 0;  c_t = 1 / sqrt(cho_c * cho_c + cho_s * cho_s);  cho_c *= c_t;  cho_s *= c_t; );
);

dl_live ? (
  abs(yl) + abs(yr) > fx_qt ? dl_q = 0;
) : dl_q = 0;
dl_live && dl_q < dl_qn ? (
  u_dl = dlL.sl_run(BD_L, dl_t);  u_dr = dlR.sl_run(BD_R, dl_t);
  dl_hl += (u_dl - dl_hl) * dl_hc;  dl_hr += (u_dr - dl_hr) * dl_hc;
  dl_fl += (u_dl - dl_hl - dl_fl) * dl_dc;  dl_fr += (u_dr - dl_hr - dl_fr) * dl_dc;
  u_fl = ts(dl_fl * dl_fb * 1.25) * 0.8;  u_fr = ts(dl_fr * dl_fb * 1.25) * 0.8;
  dl_pp >= 0.5 ? bd_put((yl + yr) * 0.5 + u_fr + bv_dn, u_fl + bv_dn)
               : bd_put(yl + u_fl + bv_dn, yr + u_fr + bv_dn);
  yl += u_dl * dlm_s;  yr += u_dr * dlm_s;
  abs(u_dl) + abs(u_dr) > fx_qt ? dl_q = 0 : dl_q += 1;
);

sp_live ? (
  abs(yl) + abs(yr) > fx_qt ? sp_q = 0;
  vt_s += (vt_t - vt_s) * smk;  vt_c += (vtc_t - vt_c) * smk;
) : sp_q = 0;
sp_live && sp_q < sp_qn ? (
  bv_pre(yl, yr);
  dif_run(pre_l(sp_pre), pre_r(sp_pre), 0.75, sz_s);
  fdn_run(dif_l, dif_r);
  u_wl = vtL.vt_run(fdn_l);  u_wr = vtR.vt_run(fdn_r);
  u_wl = fdn_l + (u_wl - fdn_l) * vt_s;  u_wr = fdn_r + (u_wr - fdn_r) * vt_s;
  yl += u_wl * 0.55 * spm_s;  yr += u_wr * 0.55 * spm_s;
  abs(u_wl) + abs(u_wr) > fx_qt ? sp_q = 0 : sp_q += 1;
);

eq_l1 += (yl - eq_l1) * eq_lc;  eq_h1 += (yl - eq_h1) * eq_hc;
eq_r1 += (yr - eq_r1) * eq_lc;  eq_g1 += (yr - eq_g1) * eq_hc;
yl += eq_l1 * eql_s + (yl - eq_h1) * eqh_s;
yr += eq_r1 * eql_s + (yr - eq_g1) * eqh_s;

dc_ol = yl - dc_qol + dc_r * dc_ol;  dc_qol = yl;  yl = dc_ol;
dc_or = yr - dc_qor + dc_r * dc_or;  dc_qor = yr;  yr = dc_or;
ff_live ? (
  ffat_s += (ffat_t - ffat_s) * smk;
  cn = ffat_s / 10;  ff_thr = -32 * cn;  ff_sl = 1 - 1 / (1 + 5 * cn);  ff_mk = -ff_thr * ff_sl * 0.5;
  u_cl = max(abs(yl), abs(yr));
  u_cdb = u_cl > 0.000001 ? 20 * log10(u_cl) : -120;
  u_ov = u_cdb - ff_thr;
  u_cg = u_ov <= -3 ? 0 : u_ov >= 3 ? u_ov * ff_sl : ff_sl * sqr(u_ov + 3) / 12;
  grs += (u_cg - grs) * (u_cg > grs ? ffc_att : ffc_rel);
  u_cg = 10 ^ ((ff_mk - grs) / 20);
  yl *= u_cg;  yr *= u_cg;
) : ( grs = 0;  ffat_s = 0; );
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
rs_g < 1 ? ( rs_g = min(1, rs_g + rs_inc);  yl *= rs_g;  yr *= rs_g; );
outpk = max(outpk, max(abs(yl), abs(yr)));  mn_pkm = max(mn_pkm, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;
@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(ink, 1); gfx_measurestr("DRIFT", tw, th);
  gfx_x = dk_ox + cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr("DRIFT");
);
ui_begin(900, 355);
mk_face = 0xD8A646; mk_band = 0x2A1E10; mk_line = 0xE8602A; mk_sub = 0xC48F32;
mk_ink = 0x2A1A06; mk_acc = 0x7A1E04; mk_ink2 = 0x4A3310; mk_hd = 0xFFF1D6; C_LCDBG = 0x140E06;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 15 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_disc(x + 1.5 + j * 0.9, y + 2 + j * 1.1, r + j * 0.5); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.08); mg_rr(x + 1.5 + j * 0.9, y + 2 + j * 1.1, w + j * 0.5, h + j * 0.5, r); j += 1; ); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KBX, KBY, KRD, i, t) (
  KBX = x * sc; KBY = y * sc; KRD = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KBX, KBY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KBX + sin(t) * KRD * 0.8, KBY - cos(t) * KRD * 0.8, KBX + sin(t) * KRD * 0.95, KBY - cos(t) * KRD * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KBX, KBY, KRD * 0.76, 1, 1);
    ui_col(col); gfx_circle(KBX, KBY, KRD * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KBX, KBY, KRD * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KBX, KBY, KRD * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KBX, KBY, a, KRD * 0.72);
  ) : sty == 2 ? (
    ui_col(0xA9ACAF); gfx_circle(KBX, KBY, KRD, 1, 1);
    ui_col(0xF1F0EC); gfx_circle(KBX, KBY, KRD * 0.92, 1, 1);
    i = 0; loop(6, ui_cola(0x000000, 0.12 * (1 - i / 6)); gfx_circle(KBX, KBY, KRD * 0.92 - i * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.9 : 0.8); ui_ssarc(KBX, KBY, KRD * 0.8, -2.5 + 0.5 * $pi, -1.4 + 0.5 * $pi, 1 * sc);
    ui_col(0x26282C); ui_kdot(KBX, KBY, a, KRD * 0.92);
  ) : sty == 4 ? (
    ui_col(0x8A7A5E); gfx_circle(KBX, KBY, KRD, 1, 1);
    ui_col(0xF2EBDC); gfx_circle(KBX, KBY, KRD * 0.94, 1, 1);
    i = 0; loop(4, ui_cola(0x000000, 0.10 * (1 - i / 4)); gfx_circle(KBX, KBY, KRD * 0.94 - i * sc, 0, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.25)); gfx_circle(KBX, KBY, KRD * 0.74, 1, 1);
    ui_col(col); gfx_circle(KBX, KBY, KRD * 0.70, 1, 1);
    i = 0; loop(4, ui_cola(0x000000, 0.12 * (1 - i / 4)); gfx_circle(KBX, KBY, KRD * 0.70 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.5 : 0.32); ui_ssarc(KBX, KBY, KRD * 0.58, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.5 ? 0x1A1D22 : 0xF4F0E8); ui_kdot(KBX, KBY, a, KRD * 0.70);
  ) : (
    ui_col(0x2C2E33); gfx_circle(KBX, KBY, KRD, 1, 1);
    ui_col(0x121315); gfx_circle(KBX, KBY, KRD * 0.8, 1, 1);
    ui_col(ui_mix(0x2C2E33, 0x000000, 0.25)); gfx_circle(KBX, KBY, KRD * 0.68, 1, 1);
    ui_cola(0xFFFFFF, act ? 0.22 : 0.12); ui_ssarc(KBX, KBY, KRD * 0.95, -2.6 + 0.5 * $pi, -1.0 + 0.5 * $pi, 1 * sc);
    ui_col(0xECE6DA); ui_kdot(KBX, KBY, a, KRD * 0.68);
  );
);
function mg_dots(x, y, r, c) local(i, t, rs, px, py, n) (
  rs = r + 8; i = 0; n = mg_nd == 2 ? 1 : 2;
  loop(n + 1, t = -0.75 * $pi + i / n * 1.5 * $pi; px = x + sin(t) * rs; py = y - cos(t) * rs;
    mg_zero && n == 2 && i == 1 ? ( gfx_setfont(11); ui_col(c); mg_ctxt(px, py - 2, "0"); )
    : !(i == 1 && n == 2) ? ( ui_col(c); mg_disc(px, py, 1.8); );
    i += 1; );
