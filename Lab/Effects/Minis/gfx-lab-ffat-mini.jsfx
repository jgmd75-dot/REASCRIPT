desc:Ffat Mini [multi-fx] (GFX Lab)
//tags: multi-fx drive filter flanger compressor bass enhancer
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-power, gfx-lab-output, gfx-lab-clip, gfx-lab-lfo, gfx-lab-os, gfx-lab-bypass, gfx-lab-drift, gfx-lab-thick, gfx-lab-sidebar, gfx-lab-ui, gfx-lab-panel (.jsfx-inc) in the same folder.

slider1:dtype=0<0,3,1{Tube,Fuzz,Rect,Crush}>-Drive type
slider2:drive=3<0,10,0.1>-Drive
slider3:dmix=100<0,100,0.1>-Drive mix (%)
slider4:f1type=2<0,6,1{Off,LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 1 type
slider5:f1cut=1800<20,20000,1:log>-Filter 1 cutoff (Hz)
slider6:f1res=3<0,10,0.1>-Filter 1 resonance
slider7:f1lfo=0<-4,4,0.01>-Filter 1 LFO (oct)
slider8:f1env=0<-4,4,0.01>-Filter 1 envelope (oct)
slider9:f2type=0<0,6,1{Off,LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 2 type
slider10:f2cut=400<20,20000,1:log>-Filter 2 cutoff (Hz)
slider11:f2res=0<0,10,0.1>-Filter 2 resonance
slider12:f2lfo=0<-4,4,0.01>-Filter 2 LFO (oct)
slider13:f2env=0<-4,4,0.01>-Filter 2 envelope (oct)
slider14:route=0<0,1,1{Series,Parallel}>-Filter routing
slider15:order=0<0,1,1{Drive first,Filters first}>-Order
slider16:lshape=0<0,3,1{Sine,Triangle,Square,Random}>-LFO shape
slider17:lmode=1<0,2,1{Free,Sync,Flow}>-LFO mode
slider18:lhz=1<0.01,20,0.01:log>-LFO rate (Hz)
slider19:ldiv=6<0,15,1{4 Bars,2 Bars,1 Bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-LFO division
slider20:lsmooth=3<0,10,0.1>-LFO smooth
slider21:lwidth=0<0,180,1>-LFO width (deg)
slider22:espeed=4<0,10,0.1>-Envelope speed
slider23:ffat=0<0,10,0.1>-Ffat
slider24:out_db=0<-12,12,0.1>-Output (dB)
slider25:wet_pc=100<0,100,0.1>-Dry/wet (%)
slider26:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider27:byp=0<0,1,1{Off,On}>-Bypass
slider28:bd_on=0<0,1,1{Off,On}>-Band filter
slider29:hpf_hz=20<20,2000,1:log>-HPF (Hz)
slider30:hpf_res=0<0,10,0.1>-HPF resonance
slider31:lpf_hz=20000<200,20000,1:log>-LPF (Hz)
slider32:lpf_res=0<0,10,0.1>-LPF resonance
slider33:mq_on=0<0,1,1{Off,On}>-Magic EQ
slider34:weight=50<0,100,0.1>-Weight (%)
slider35:depth=30<0,100,0.1>-Depth (%)
slider36:fl_on=0<0,1,1{Off,On}>-Flanger
slider37:fl_rate=0.25<0.01,10,0.01:log>-Flanger rate (Hz)
slider38:fl_depth=60<0,100,0.1>-Flanger depth (%)
slider39:fl_dly=2<0.2,10,0.01:log>-Flanger delay (ms)
slider40:fl_fb=50<-95,95,0.1>-Flanger feedback (%)
slider41:fl_mix=50<0,100,0.1>-Flanger mix (%)
slider42:cp_on=0<0,1,1{Off,On}>-Compressor
slider43:cp_thr=-20<-60,0,0.1>-Compressor threshold (dB)
slider44:cp_cc=0.5<0,1,0.01>-Compressor ratio (0 = 1:1, 1 = inf:1)
slider45:cp_gain=0<-20,20,0.1>-Compressor gain (dB)
slider46:drift_pc=50<0,100,1>-Drift (%)
slider47:thick=0<0,1,1{Off,On}>-Thick
slider48:pad_on=0<0,1,1{Off,On}>-Pad
slider49:prs_sel=0<0,15,1{No preset,Init,Wobble Bass,Acid Squelch,Lo-Fi Radio,Ffat Drums,Slow Sweep,Filter Chop,Fuzz Notch,Octave Lead,Random Steps,Twin Formant,Crushed Pump,Desert Jet,Big Bottom,Band Squeeze}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-power.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-lfo.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-sidebar.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc

@init
#ui_man = "gfx-lab-ffat-mini";
#ff_pm = "Init|Wobble Bass|Acid Squelch|Lo-Fi Radio|Ffat Drums|Slow Sweep|Filter Chop|Fuzz Notch|Octave Lead|Random Steps|Twin Formant|Crushed Pump|Desert Jet|Big Bottom|Band Squeeze";
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; mg_fp = 0; mg_xp = 2; );
ui_dflt = 1;
rs_f = 1;
ext_noinit = 1;
ost_init(0);
pwr_init();
thk_init(); thk_lift = 3; thk_drv = 1.5; thk_asym = 0.12; thk_tr = 1.2; thk_trim = 0;
dD.drift_init(0.8 + rand(1) * 0.5); dFL.drift_init(0.8 + rand(1) * 0.5); dFR.drift_init(0.8 + rand(1) * 0.5);
drift_macro(50); ds_pd = 1; ds_pdL = 0; ds_dr = 0; df_l = df_r = 0;

CF = 0;
SB = 100;
RV = 200;
DLB = 512;
FLA = 4096;
memset(CF, 0, 32);  memset(SB, 0, 16);  memset(DLB, 0, 128);  memset(FLA, 0, 16384);
RV[0] = 0.6;  RV[1] = -0.4;  RV[2] = 0.9;  RV[3] = -0.8;  RV[4] = 0.15;  RV[5] = -0.25;  RV[6] = 0.75;  RV[7] = -0.6;

function db2g(d) ( exp(d * 0.11512925464970228); );

function sv_coef(i, fc, r) local(c, g, k) (
  c = CF + i * 8;
  g = tan($pi * min(max(fc, 20), srate * 0.45) / srate);
  k = 2 - 1.85 * r;
  c[0] = 1 / (1 + g * (g + k));  c[1] = g * c[0];  c[2] = g * c[1];  c[3] = k;
  c[4] = 1 / (1 + g * (g + 1.41421356));  c[5] = g * c[4];  c[6] = g * c[5];
);
function sv_run(x, t, i, s) local(c, y, v1, v2, v3) (
  t == 0 ? x : (
    c = CF + i * 8;  y = x;
    (t == 2 || t == 4) ? (
      v3 = y - s[3];  v1 = c[4] * s[2] + c[5] * v3;  v2 = s[3] + c[5] * s[2] + c[6] * v3;
      s[2] = 2 * v1 - s[2];  s[3] = 2 * v2 - s[3];
      y = t == 2 ? v2 : y - 1.41421356 * v1 - v2;
    );
    v3 = y - s[1];  v1 = c[0] * s[0] + c[1] * v3;  v2 = s[1] + c[1] * s[0] + c[2] * v3;
    s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
    t <= 2 ? v2 : t <= 4 ? y - c[3] * v1 - v2 : t == 5 ? c[3] * v1 : y - c[3] * v1;
  );
);
function flt(x, s, ci) (
  rt_a == 0 ? sv_run(sv_run(x, f1t_a, ci, s), f2t_a, ci + 2, s + 4) :
  (f1t_a && f2t_a) ? 0.5 * (sv_run(x, f1t_a, ci, s) + sv_run(x, f2t_a, ci + 2, s + 4)) :
  f1t_a ? sv_run(x, f1t_a, ci, s) : sv_run(x, f2t_a, ci + 2, s + 4);
);

function sv2_set(fc, k) instance(a1, a2, a3, kk) local(g) (
  g = tan($pi * min(max(fc, 10), srate * 0.45) / srate);
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  kk = k;
);
function sv2_run(x) instance(a1, a2, a3, kk, s0, s1, hp, bp) local(v1, v2, v3) (
  v3 = x - s1;  v1 = a1 * s0 + a2 * v3;  v2 = s1 + a2 * s0 + a3 * v3;
  s0 = 2 * v1 - s0;  s1 = 2 * v2 - s1;
  bp = v1;  hp = x - kk * v1 - v2;
  v2;
);
function sv2_clr() instance(s0, s1, hp, bp) ( s0 = s1 = hp = bp = 0; );

function ds_tick(x) instance(a, b, pf, sbx, cnt, held, xp, dcx, dcy) local(u, y, dry) (
  dry = 0.5 * (x + xp);  xp = x;
  dt_a == 3 ? (
    cnt -= 1;
    cnt <= 0 ? ( cnt = cr_hold;  held = min(max(floor(x * cr_q + 0.5) / cr_q, -1), 1); );
    y = held;  dry = x;
  ) : (
    u = pf.clp_pf_run(x) * ds_g;
    dt_a == 0 ? ( y = (a.clp_run(u + ds_b) - ds_rest) * ds_c; ) :
    dt_a == 1 ? ( y = a.clp_run(u) * ds_c; ) :
                ( y = 0.5 * (a.clp_run(u) + b.clp_run(u)) * ds_c; );
  );
  dcy = y - dcx + ds_dcc * dcy;  dcx = y;
  y = dcy;  sb_o > 0.0001 ? y += sbx.sb_run(dcy);
  dry + (y - dry) * dmix_s;
);
function ds_reset() instance(a, b, sbx, cnt, held, xp, dcx, dcy) (
  a.clp_reset();  b.clp_reset();  sbx.sb_clr();  cnt = 0;  held = 0;  xp = 0;  dcx = 0;  dcy = 0;
);
function drive_os(l, r) (
  os_f == 1 ? ( drv_l = chL.ds.ds_tick(l);  drv_r = chR.ds.ds_tick(r); ) : (
    osuL.os_up(l);  osuR.os_up(r);
    oa0 = chL.ds.ds_tick(osuL.s0);  ob0 = chR.ds.ds_tick(osuR.s0);
    oa1 = chL.ds.ds_tick(osuL.s1);  ob1 = chR.ds.ds_tick(osuR.s1);
    os_f > 2 ? (
      oa2 = chL.ds.ds_tick(osuL.s2);  ob2 = chR.ds.ds_tick(osuR.s2);
      oa3 = chL.ds.ds_tick(osuL.s3);  ob3 = chR.ds.ds_tick(osuR.s3);
    );
    drv_l = osdL.os_dn(oa0, oa1, oa2, oa3);  drv_r = osdR.os_dn(ob0, ob1, ob2, ob3);
  );
);

function cp_curve(lv) local(o, f) (
  o = lv - cp_thr_v;
  f = o <= -5 ? 0 : o >= 5 ? o : sqr(o + 5) / 20;
  max(-cp_cc_v * f, -60);
);
function cp_smooth(t, e) local(d) (
  t < e ? ( d = e - t;  e + (t - e) * min(1, max(d, 5) / (0.15 * srate)); ) : min(t, e + cp_rel);
);

function fl_read(base, dsmp) local(p, i, f, xm1, x0, x1, x2, c1, c2, c3) (
  p = flw - dsmp + 32768;  i = floor(p);  f = p - i;
  xm1 = base[(i - 1) & 8191];  x0 = base[i & 8191];  x1 = base[(i + 1) & 8191];  x2 = base[(i + 2) & 8191];
  c1 = 0.5 * (x1 - xm1);  c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;  c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);

function update_targets() (
  dt_t = dtype;  f1t_t = f1type;  f2t_t = f2type;  rt_t = route;  or_t = order;
  drive_t = drive;  dmix_t = dmix * 0.01;
  lt1 = log(f1cut) / log(2);  lt2 = log(f2cut) / log(2);
  r1_t = f1res * 0.1;  r2_t = f2res * 0.1;
  a1l = f1lfo;  a1e = f1env;  a2l = f2lfo;  a2e = f2env;
  lfoL.lfo_setup(lshape, lsmooth * 0.1);  lfoR.lfo_setup(lshape, lsmooth * 0.1);
  lmode_v = lmode;  ldiv_v = ldiv;  lhz_v = lhz;  loff = lwidth / 360;
  e_att = 1 - exp(-1 / (0.002 * 2 ^ (espeed * 0.5) * srate));
  e_rel = 1 - exp(-1 / (0.03 * 2 ^ (espeed * 0.5) * srate));
  ffat_t = ffat;  out_t = db2g(out_db);  wet_t = wet_pc * 0.01;
  bd_t = bd_on;  bh_t = log(hpf_hz) / log(2);  bl_t = log(lpf_hz) / log(2);  bhr_t = hpf_res * 0.1;  blr_t = lpf_res * 0.1;
  mq_t = mq_on;  wg_t = weight * 0.01;  dp_t = depth * 0.01;
  fl_t = fl_on;  fl_hz = fl_rate;  fdp_t = fl_depth * 0.01;  fdl_t = fl_dly;  ffb_t = fl_fb * 0.01;  fmx_t = fl_mix * 0.01;
  cp_t = cp_on;  cp_thr_v = cp_thr;  cp_cc_v = cp_cc;  cpg_t = db2g(cp_gain);
  thk_t = thick >= 0.5;  pad_t = pad_on >= 0.5;  drift_macro(drift_pc);
);

function sw_apply() (
  dt_t != dt_a ? ( chL.ds.ds_reset();  chR.ds.ds_reset();  dt_a = dt_t; );
  f1t_t != f1t_a ? ( memset(SB, 0, 4);  memset(SB + 8, 0, 4);  f1t_a = f1t_t; );
  f2t_t != f2t_a ? ( memset(SB + 4, 0, 4);  memset(SB + 12, 0, 4);  f2t_a = f2t_t; );
  rt_a = rt_t;  or_a = or_t;
  cc = 0;  sw_hold = 1;
);

chL.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);  chR.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);
chL.ds.pf.clp_pf_reset();  chR.ds.pf.clp_pf_reset();
lfoL.lfo_init();  lfoR.lfo_init();  flL.lfo_init();  flR.lfo_init();
flL.lfo_setup(0, 0);  flR.lfo_setup(0, 0);

os_design();  os_base = 0;
os_f = os_tf = os_f2n(os_sel);  os_gsetup();
sb_rate(srate * os_f);  sb_target(14 - 0.6 * drive, 0.5 + 0.1 * drive, pad_on, 220, 1);  sb_snap();  sb_o = pad_on >= 0.5;

mqA.sv2_set(150, 1.41421356);
mqB.sv2_set(90, 1.41421356);
mqC.sv2_set(70, 1.41421356);  mqD.sv2_set(70, 1.41421356);
mqH.sv2_set(120, 1.41421356);
mq_a90 = 1 - exp(-2 * $pi * 90 / srate);
mq_hc = exp(-2 * $pi * 20 / srate);
mq_l4 = 1 - exp(-2 * $pi * 4000 / srate);
mq_rel = exp(-1 / (0.1 * srate));
mq_flip = 1;

first_run = 1;
gl_sm = 1 - exp(-1 / (0.02 * srate));
c_sw  = 1 - exp(-1 / (0.005 * srate));
msm   = 1 - exp(-1 / (0.002 * srate));
sw_step = 1 / (0.003 * srate);
c_att = 1 - exp(-1 / (0.003 * srate));  c_rel = 1 - exp(-1 / (0.09 * srate));
cp_rms = 1 - exp(-1 / (0.008 * srate));  cp_rel = 120 / srate;
envlin = 0;  envn = 0;  grs = 0;  cc = 0;  sw_f = 1;  sw_hold = 0;  dw = 0;  flw = 0;
m1l = m1r = m2l = m2r = 0;

function pv(i, v) ( slider(i) = v; );
function pdef() (
  pv(1, 0); pv(2, 3); pv(3, 100); pv(4, 2); pv(5, 1800); pv(6, 3); pv(7, 0); pv(8, 0);
  pv(9, 0); pv(10, 400); pv(11, 0); pv(12, 0); pv(13, 0); pv(14, 0); pv(15, 0);
  pv(16, 0); pv(17, 1); pv(18, 1); pv(19, 6); pv(20, 3); pv(21, 0); pv(22, 4); pv(23, 0); pv(24, 0); pv(25, 100);
  pv(28, 0); pv(29, 20); pv(30, 0); pv(31, 20000); pv(32, 0);
  pv(33, 0); pv(34, 50); pv(35, 30);
  pv(36, 0); pv(37, 0.25); pv(38, 60); pv(39, 2); pv(40, 50); pv(41, 50);
  pv(42, 0); pv(43, -20); pv(44, 0.5); pv(45, 0);
  pv(47, 0); pv(48, 0);
);
function load_preset(p) (
  pdef();
  p == 2 ? ( pv(2, 4); pv(5, 300); pv(6, 6); pv(7, 3); pv(19, 9); pv(23, 3); ) :
  p == 3 ? ( pv(2, 6); pv(5, 250); pv(6, 8); pv(8, 3.5); pv(22, 2); pv(23, 2); pv(24, -1); ) :
  p == 4 ? ( pv(1, 3); pv(2, 5); pv(4, 5); pv(5, 1400); pv(9, 3); pv(10, 250); pv(23, 4); ) :
  p == 5 ? ( pv(2, 5); pv(3, 70); pv(4, 1); pv(5, 12000); pv(6, 1); pv(23, 6); ) :
  p == 6 ? ( pv(2, 2); pv(4, 1); pv(5, 900); pv(6, 4); pv(7, 2.5); pv(16, 1); pv(17, 0); pv(18, 0.08); pv(21, 90); ) :
  p == 7 ? ( pv(5, 150); pv(6, 2); pv(7, 4); pv(16, 2); pv(19, 12); pv(20, 1); ) :
  p == 8 ? ( pv(1, 1); pv(2, 6); pv(4, 6); pv(5, 1000); pv(6, 5); pv(7, 2); pv(19, 3); pv(21, 60); pv(24, -1); ) :
  p == 9 ? ( pv(1, 2); pv(2, 6); pv(4, 3); pv(5, 180); pv(6, 2); pv(9, 1); pv(10, 6000); pv(11, 3); pv(23, 3); ) :
  p == 10 ? ( pv(4, 5); pv(5, 1200); pv(6, 6); pv(7, 2); pv(16, 3); pv(19, 12); pv(20, 0); ) :
  p == 11 ? ( pv(2, 2); pv(4, 5); pv(5, 700); pv(6, 6); pv(7, 1); pv(9, 5); pv(10, 1600); pv(11, 6); pv(12, -1);
              pv(14, 1); pv(17, 0); pv(18, 0.3); ) :
  p == 12 ? ( pv(1, 3); pv(2, 4); pv(5, 2500); pv(6, 3); pv(8, -2); pv(22, 3); pv(23, 7); ) :
  p == 13 ? ( pv(2, 4); pv(4, 0); pv(36, 1); pv(37, 0.12); pv(38, 80); pv(39, 1.5); pv(40, 75); pv(41, 50); ) :
  p == 14 ? ( pv(2, 2); pv(4, 0); pv(33, 1); pv(34, 60); pv(35, 45); pv(42, 1); pv(43, -24); pv(44, 0.6); pv(45, 3); ) :
  p == 15 ? ( pv(2, 4); pv(4, 0); pv(28, 1); pv(29, 300); pv(30, 4); pv(31, 3000); pv(32, 3);
              pv(42, 1); pv(43, -30); pv(44, 0.75); pv(45, 6); ) : 0;
  slider_automate(33554431);  slider_automate(35184237871104);  slider_automate(thick);  slider_automate(pad_on);
  gui_dirty = 1;
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(48, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 15 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(15, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
update_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);
first_run ? (
  dt_a = dt_t;  f1t_a = f1t_t;  f2t_a = f2t_t;  rt_a = rt_t;  or_a = or_t;
  drive_s = drive_t;  dmix_s = dmix_t;  r1_s = r1_t;  r2_s = r2_t;  ffat_s = ffat_t;  ffs = ffat_t;
  lc1 = lt1;  lc2 = lt2;  out_s = out_t;  wet_s = wet_t;
  bd_s = bd_t;  bh_c = bh_t;  bl_c = bl_t;  bhr_s = bhr_t;  blr_s = blr_t;
  mq_s = mq_t;  wg_s = wg_t;  dp_s = dp_t;
  fl_s = fl_t;  fdp_s = fdp_t;  fdl_s = fdl_t;  ffb_s = ffb_t;  fmx_s = fmx_t;
  cp_s = cp_t;  cpg_s = cpg_t;  by_s = byp;
  first_run = 0;
);
os_snap(slider(26));

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? (
  rs_f = 0;  rs_c = 1 / (0.015 * srate);
  memset(FLA, 0, 16384);  memset(DLB, 0, 128);
);
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pwr_block(!byp);
update_targets();
dr_i = 0.25 * dm_s * samplesblock / srate;
ds_dr = dD.drift_tick(dr_i) * 0.6 * dm_a;  df_l = dFL.drift_tick(dr_i) * 0.05 * dm_a;  df_r = dFR.drift_tick(dr_i) * 0.05 * dm_a;
os_tf = os_f2n(os_sel);
pdc_delay = os_lat(os_f);
kb = 1 - exp(-samplesblock / (0.03 * srate));
drive_s += (drive_t - drive_s) * kb;  r1_s += (r1_t - r1_s) * kb;  r2_s += (r2_t - r2_s) * kb;  ffat_s += (ffat_t - ffat_s) * kb;
bhr_s += (bhr_t - bhr_s) * kb;  blr_s += (blr_t - blr_s) * kb;
dn = drive_s / 10;
ds_pdt = pad_t ? log(SB_PAD) + 1.6 * drive_s * 0.11512925464970228 : 0;
ds_pdL += (ds_pdt - ds_pdL) * kb;  ds_pd = exp(ds_pdL);
sb_target(14 - 0.6 * drive_s, 0.5 + 0.1 * drive_s, pad_t, 220, 1);  sb_ctl(1);

ds_st = min(1, drive_s / 3);
dt_a == 0 ? (
  ds_g = db2g(drive_s * 2.4 + ds_dr) * ds_pd;  ds_b = 0.08 + 0.12 * dn;
  chL.ds.a.clp_set(1, 1, 0.72, 0);  chR.ds.a.clp_set(1, 1, 0.72, 0);
  ds_rest = chL.ds.a.clp_crv(ds_b);
  ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(chL.ds.a.clp_crv(0.25 * ds_g + ds_b) - ds_rest, 0.0001);
) : dt_a == 1 ? (
  ds_g = db2g(drive_s * 4 + ds_dr) * ds_pd;
  chL.ds.a.clp_set(0, 0.6, 0.6, 0.04 * dn);  chR.ds.a.clp_set(0, 0.6, 0.6, 0.04 * dn);
  ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(chL.ds.a.clp_crv(0.25 * ds_g), 0.0001);
) : dt_a == 2 ? (
  ds_g = db2g(drive_s * 2 + ds_dr) * ds_pd;
  chL.ds.a.clp_set(3, 1, 1, 0);  chR.ds.a.clp_set(3, 1, 1, 0);
  chL.ds.b.clp_set(1, 1, 1, 0);  chR.ds.b.clp_set(1, 1, 1, 0);
  ds_c = 0.25 / max(0.5 * (chL.ds.a.clp_crv(0.25 * ds_g) + chL.ds.b.clp_crv(0.25 * ds_g)), 0.0001);
) : (
  cr_q = 2 ^ (15 - drive_s * 1.3);
  cr_hold = (1 + floor(sqr(dn) * 23)) * os_f;
);
ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
chL.ds.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);  chR.ds.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);
chL.ds.a.clp_tidy();  chR.ds.a.clp_tidy();  chL.ds.b.clp_tidy();  chR.ds.b.clp_tidy();
sw_hold = 0;

lfoL.lfo_block(lmode_v, ldiv_v, lhz_v);  lfoR.lfo_block(lmode_v, ldiv_v, lhz_v);
flL.lfo_block(0, 0, fl_hz);  flR.lfo_block(0, 0, fl_hz);

ff_k = 1 - exp(-1 / (0.03 * srate));

pkL_d = max(pkL_d, pkL);  pkL = 0;  pkR_d = max(pkR_d, pkR);  pkR = 0;
ff_vu_d = max(ff_vu_d, sqrt(ff_ms / max(samplesblock, 1))); ff_ms = 0;  ff_pk_d = max(ff_pk_d, ff_pkm); ff_pkm = 0;
os_snapb(slider(26));

@sample
rw_l = spl0;  rw_r = spl1;
DLB[dw] = spl0;  DLB[64 + dw] = spl1;
dry_l = DLB[(dw - pdc_delay) & 63];  dry_r = DLB[64 + ((dw - pdc_delay) & 63)];
dw = (dw + 1) & 63;

(dt_t != dt_a || f1t_t != f1t_a || f2t_t != f2t_a || rt_t != rt_a || or_t != or_a) ? (
  sw_f = max(0, sw_f - sw_step);
  sw_f == 0 ? sw_apply();
) : ( !sw_hold && sw_f < 1 ? sw_f = min(1, sw_f + sw_step); );
os_gate();
os_chg ? (
  osuL.os_clr();  osuR.os_clr();  osdL.os_clr();  osdR.os_clr();
  chL.ds.ds_reset();  chR.ds.ds_reset();  chL.ds.pf.clp_pf_reset();  chR.ds.pf.clp_pf_reset();
  chL.ds.pf.clp_pf_block(dn, srate * os_f, 1);  chR.ds.pf.clp_pf_block(dn, srate * os_f, 1);
  ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);  sb_rate(srate * os_f);
  dt_a == 3 ? cr_hold = (1 + floor(sqr(dn) * 23)) * os_f;
  dry_l = DLB[(dw - 1 - pdc_delay) & 63];  dry_r = DLB[64 + ((dw - 1 - pdc_delay) & 63)];
);

sb_glide(gl_sm, c_sw);  sb_o += (pad_t - sb_o) * c_sw;  sb_o < 0.0001 && !pad_t ? sb_o = 0;
dmix_s += (dmix_t - dmix_s) * gl_sm;  out_s += (out_t - out_s) * gl_sm;  wet_s += (wet_t - wet_s) * gl_sm;
inL = spl0;  inR = spl1;

ea = max(abs(inL), abs(inR));
envlin += (ea - envlin) * (ea > envlin ? e_att : e_rel);
envn = envlin > 0.001 ? min((20 * log10(envlin) + 60) / 60, 1) : 0;

wl = lfoL.lfo_tick(0, 0, 0);
wr = lfoR.lfo_tick(loff, 0, 0);
loff <= 0 ? wr = wl;

lc1 += (lt1 - lc1) * gl_sm;  lc2 += (lt2 - lc2) * gl_sm;
m1l += (wl * a1l + envn * a1e - m1l) * msm;  m1r += (wr * a1l + envn * a1e - m1r) * msm;
m2l += (wl * a2l + envn * a2e - m2l) * msm;  m2r += (wr * a2l + envn * a2e - m2r) * msm;
bd_s += (bd_t - bd_s) * c_sw;
bh_c += (bh_t - bh_c) * gl_sm;  bl_c += (bl_t - bl_c) * gl_sm;
cc -= 1;
cc <= 0 ? (
  cc = 8;
  f1t_a ? ( sv_coef(0, 2 ^ (lc1 + m1l + df_l), r1_s);  sv_coef(1, 2 ^ (lc1 + m1r + df_r), r1_s); );
  f2t_a ? ( sv_coef(2, 2 ^ (lc2 + m2l + df_l), r2_s);  sv_coef(3, 2 ^ (lc2 + m2r + df_r), r2_s); );
  bk = 1.41421356 - 1.25 * bhr_s;  bhL.sv2_set(2 ^ bh_c, bk);  bhR.sv2_set(2 ^ bh_c, bk);
  bk = 1.41421356 - 1.25 * blr_s;  blL.sv2_set(2 ^ bl_c, bk);  blR.sv2_set(2 ^ bl_c, bk);
);

xl = inL;  xr = inR;
pwr_in(xl, xr);  xl = pwr_l;  xr = pwr_r;
thk_proc(xl, xr, thk_t);  xl = thk_l;  xr = thk_r;
or_a == 0 ? ( drive_os(xl, xr);  xl = drv_l;  xr = drv_r; );
xl = flt(xl, SB, 0);  xr = flt(xr, SB + 8, 1);
or_a == 1 ? ( drive_os(xl, xr);  xl = drv_l;  xr = drv_r; );

bhL.sv2_run(xl);  bhR.sv2_run(xr);
yl = blL.sv2_run(bhL.hp);  yr = blR.sv2_run(bhR.hp);
bd_s > 0.0001 ? ( xl += (yl - xl) * bd_s;  xr += (yr - xr) * bd_s; ) : bd_s = 0;

mq_s += (mq_t - mq_s) * c_sw;
(mq_t || mq_s > 0.0001) ? (
  wg_s += (wg_t - wg_s) * gl_sm;  dp_s += (dp_t - dp_s) * gl_sm;
  mm = 0.5 * (xl + xr);
  mq_lp += (mm - mq_lp) * mq_a90;
  mlo = mqA.sv2_run(mm);
  ma = abs(mlo);  mq_e = ma > mq_e ? ma : ma + (mq_e - ma) * mq_rel;
  mq_e > 0.00001 ? (
    mu = min(max(mlo / mq_e, -1), 1);
    mh = mq_e * (0.6 * (2 * mu * mu - 1) + 0.4 * (4 * mu * mu * mu - 3 * mu));
  ) : mh = 0;
  mqH.sv2_run(mh);  mq_ht += (mqH.hp - mq_ht) * mq_l4;
  mdt = mqB.sv2_run(mm);
  ma = abs(mdt);  mq_e2 = ma > mq_e2 ? ma : ma + (mq_e2 - ma) * mq_rel;
  mq_e2 > 0.0005 ? (
    mdt > 0.2 * mq_e2 && !mq_pos ? ( mq_pos = 1;  mq_flip = -mq_flip; );
    mdt < -0.2 * mq_e2 ? mq_pos = 0;
  );
  msq = mqD.sv2_run(mqC.sv2_run(mq_flip * mq_e2));
  mq_sy = msq - mq_sx + mq_hc * mq_sy;  mq_sx = msq;
  madd = mq_s * (wg_s * (0.585 * mq_lp + 0.5 * mq_ht) + dp_s * 1.1 * mq_sy);
  xl += madd;  xr += madd;
) : (
  mq_s = 0;  mq_lp = mq_e = mq_e2 = mq_ht = mq_sx = mq_sy = 0;
  mqA.sv2_clr();  mqB.sv2_clr();  mqC.sv2_clr();  mqD.sv2_clr();  mqH.sv2_clr();
);

fl_s += (fl_t - fl_s) * c_sw;
(fl_t || fl_s > 0.0001) ? (
  fdp_s += (fdp_t - fdp_s) * gl_sm;  fdl_s += (fdl_t - fdl_s) * gl_sm;
  ffb_s += (ffb_t - ffb_s) * gl_sm;  fmx_s += (fmx_t - fmx_s) * gl_sm;
  fwl = flL.lfo_tick(0, 0, 0);  fwr = flR.lfo_tick(0.25, 0, 0);
  fdsl = max(3, min(8000, fdl_s * 2 ^ (fdp_s * fwl) * 0.001 * srate));
  fdsr = max(3, min(8000, fdl_s * 2 ^ (fdp_s * fwr) * 0.001 * srate));
  fyl = fl_read(FLA, fdsl);  fyr = fl_read(FLA + 8192, fdsr);
  fb_k = ffb_s * fl_s;  fu = xl + fb_k * fyl;  FLA[flw] = fu / sqrt(1 + 0.25 * fu * fu);
  fu = xr + fb_k * fyr;  FLA[8192 + flw] = fu / sqrt(1 + 0.25 * fu * fu);
  flw = (flw + 1) & 8191;
  fm = fmx_s * fl_s;
  xl += (fyl - xl) * fm;  xr += (fyr - xr) * fm;
) : (
  fl_s = 0;  FLA[flw] = xl / sqrt(1 + 0.25 * xl * xl);  FLA[8192 + flw] = xr / sqrt(1 + 0.25 * xr * xr);  flw = (flw + 1) & 8191;
);

cp_s += (cp_t - cp_s) * c_sw;
(cp_t || cp_s > 0.0001) ? (
  cpg_s += (cpg_t - cpg_s) * gl_sm;
  cp_ml += (xl * xl - cp_ml) * cp_rms;  cp_mr += (xr * xr - cp_mr) * cp_rms;
  cp_lv = 10 * log10(0.5 * (cp_ml + cp_mr) + 0.0000000001);
  cp_e = cp_smooth(cp_curve(cp_lv), cp_e);
  cg = db2g(cp_e) * cpg_s;
  xl += (xl * cg - xl) * cp_s;  xr += (xr * cg - xr) * cp_s;
) : ( cp_s = 0;  cp_e = 0;  cp_ml = cp_mr = 0; );

ffs += (ffat_t - ffs) * ff_k;
cn = ffs / 10;
c_on = cn > 0.001;
c_thr = -32 * cn;
c_sl = 1 - 1 / (1 + 5 * cn);
c_mk = -c_thr * c_sl * 0.5;
c_on ? (
  cl = max(abs(xl), abs(xr));
  cdb = cl > 0.000001 ? 20 * log10(cl) : -120;
  ov = cdb - c_thr;
  cg = ov <= -3 ? 0 : ov >= 3 ? ov * c_sl : c_sl * sqr(ov + 3) / 12;
  grs += (cg - grs) * (cg > grs ? c_att : c_rel);
  cgn = db2g(c_mk - grs);
  xl *= cgn;  xr *= cgn;
) : ( grs = 0; );

pwr_out(xl, xr);  xl = pwr_l;  xr = pwr_r;
xl *= out_s * sw_f * os_g;  xr *= out_s * sw_f * os_g;
xl = dry_l + (xl - dry_l) * wet_s;  xr = dry_r + (xr - dry_r) * wet_s;
ost_out(xl, xr);  xl = ost_l;  xr = ost_r;

by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( xl += (dry_l - xl) * by_s;  xr += (dry_r - xr) * by_s; );

pkL = max(pkL, abs(xl));  pkR = max(pkR, abs(xr));
ff_ms += 0.5 * (xl * xl + xr * xr);  ff_pkm = max(ff_pkm, max(abs(xl), abs(xr)));
spl0 = xl;  spl1 = xr;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1);  rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  spl0 = rw_l + (spl0 - rw_l) * rs_s;  spl1 = rw_r + (spl1 - rw_r) * rs_s;
);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, mg_fp);
file_var(0, mg_xp);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x1F4B53; mk_band = 0x0F0E0D; mk_ink = 0x24201C; mk_acc = 0xE8582A; mk_tab = 0xC9A46A;
mk_sub = 0xDCC69D; mk_ink2 = 0x5B5243;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x26282B); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.25)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0xF4F6F8); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0x1A1A1C); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(0x1A1A1C); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_well(x, y, w, h) ( ui_cola(0x000000, 0.18); mg_r(x, y, w, h); ui_cola(0x000000, 0.12); mg_r(x, y, w, 2); mg_r(x, y + 2, 2, h - 2); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KRD, i, t) (
  KX = x * sc; KY = y * sc; KRD = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KRD, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KRD * 0.8, KY - cos(t) * KRD * 0.8, KX + sin(t) * KRD * 0.95, KY - cos(t) * KRD * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KRD * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KRD * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KRD * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KRD * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KRD * 0.72);
  ) : sty == 2 ? (
    ui_col(0xA9ACAF); gfx_circle(KX, KY, KRD, 1, 1);
    ui_col(0xF1F0EC); gfx_circle(KX, KY, KRD * 0.92, 1, 1);
