desc:Mid/Side Mini [mid/side width] (GFX Lab)
//tags: mid side stereo width imaging utility mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:0<0,2,1{Stereo,Mid,Side}>-Listen
slider2:0<-12,12,0.1>-Mid gain (dB)
slider3:0<-12,12,0.1>-Side gain (dB)
slider4:100<0,200,1>-Width (%)
slider5:0<0,300,1>-Bass mono (Hz, 0 = off)
slider6:0<0,9,0.1>-Air (dB)
slider7:0<0,6,0.1>-Mid focus (dB)
slider8:0<0,1,1{L/R,M/S}>-Input format
slider9:0<0,1,1{L/R,M/S}>-Output format
slider10:0<-24,12,0.1>-Output (dB)
slider11:0<-100,100,1>-Balance (%)
slider12:0<-24,12,0.1>-Input trim (dB)
slider13:1<0,1,1{Off,On}>-Input guard
slider14:0<0,1,1{Off,On}>-Bypass
slider15:prs_sel=0<0,9,1{No preset,Init,Subtle Widen,Wide Master,Mono Bass,Vocal Focus,Super Wide,Narrow and Tight,M/S Decode,M/S Encode}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-midside-mini";
ext_noinit = 1;

function bq_hp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_shelf(f, gdb) instance(b0, b1, b2, a1, a2) local(amp, w0, cw, sw, al, sq, n) (
  amp = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0);
  al = sw / 2 * sqrt(2); sq = 2 * sqrt(amp) * al;
  n = (amp + 1) - (amp - 1) * cw + sq;
  b0 = amp * ((amp + 1) + (amp - 1) * cw + sq) / n;
  b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
  b2 = amp * ((amp + 1) + (amp - 1) * cw - sq) / n;
  a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;
  a2 = ((amp + 1) - (amp - 1) * cw - sq) / n;
);
function bq_peak(f, gdb, q) instance(b0, b1, b2, a1, a2) local(amp, w0, cw, al, n) (
  amp = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * q);
  n = 1 + al / amp;
  b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = -2 * cw / n; a2 = (1 - al / amp) / n;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function update() (
  listen = slider1;
  mid_t = 10 ^ (slider2 / 20);
  side_t = 10 ^ (slider3 / 20);
  wid_t = slider4 / 100;
  bmono = slider5;
  bmono >= 20 && bmono != lastbm ? ( lastbm = bmono; hpS.bq_hp(bmono); hpS2.bq_hp(bmono); );
  air_db = slider6;
  slider7 != lastfoc ? ( lastfoc = slider7; pkM.bq_peak(2500, slider7, 0.8); );
  infmt = slider8; outfmt = slider9;
  out_t = 10 ^ (slider10 / 20);
  bal_t = slider11 / 100;
  in_setup(slider12, slider13);
);
function setp(ms, ss, w, bm, ai, fo, inf, outf) (
  slider2 = ms; slider3 = ss; slider4 = w; slider5 = bm; slider6 = ai; slider7 = fo;
  slider8 = inf; slider9 = outf;
);
function load_preset(p) (
  p == 1 ? (
    slider1 = 0; setp(0, 0, 100, 0, 0, 0, 0, 0);
    slider10 = 0; slider11 = 0; slider12 = 0; slider13 = 1;
  ) :
  p == 2 ? setp(0,  0,   120, 0,   1.5, 0, 0, 0) :
  p == 3 ? setp(0,  0.5, 140, 120, 2.5, 0, 0, 0) :
  p == 4 ? setp(0,  0,   100, 150, 0,   0, 0, 0) :
  p == 5 ? setp(1,  0,    90, 100, 0,   3, 0, 0) :
  p == 6 ? setp(0,  1,   175, 200, 4,   0, 0, 0) :
  p == 7 ? setp(0, -2,    70, 150, 0,   0, 0, 0) :
  p == 8 ? setp(0,  0,   100, 0,   0,   0, 1, 0) :
  p == 9 ? setp(0,  0,   100, 0,   0,   0, 0, 1);
  slider_automate(8191);
);
function ms_clear() (
  hpS.bq_clr(); hpS2.bq_clr(); shS.bq_clr(); pkM.bq_clr();
);
scL = 0; scR = 512; scN = 512;
memset(0, 0, 1024);
sm  = 1 - exp(-1 / (0.03 * srate));
crc = 1 - exp(-1 / (0.3 * srate));
ms_fis = 1 / (0.01 * srate); ms_fi = 1;
in_init();
pwr_init(); pwr_wu_loss = 0.4; pwr_wu_drv = 0.6; pwr_wu_lp = 12000; pwr_bloom = 0;
cLR = 0; cLL = 0; cRR = 0;
lastfoc = -1; lastair = -99; lastbm = -1;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
update();
mid_s = mid_t; side_s = side_t; wid_s = wid_t; out_s = out_t; bal_s = bal_t;
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
by_setup(14);
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(14, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); update();
      prs_q ? ( k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
update();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
ms_now = time_precise();
ms_tp > 0 && ms_now - ms_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > ms_gpp && play_position - ms_gpp < 4 * ms_gpd + 0.05) ? ( ms_clear(); ms_fi = 0; );
ms_tp = ms_now; ms_gpp = play_position; ms_gpd = samplesblock / srate;
pwr_block(slider14 < 0.5);
update();
ms_vu_d = max(ms_vu_d, sqrt(ms_msq / max(samplesblock, 1))); ms_msq = 0;
ms_pk_d = max(ms_pk_d, ms_pkm); ms_pkm = 0;
ms_cor_d = cLL * cRR > 0.0000000001 ? cLR / sqrt(cLL * cRR) : 1;
ms_lev_d = cLL + cRR;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
pwr_in(in_l, in_r);
inL = pwr_l; inR = pwr_r;
mid_s  += (mid_t  - mid_s)  * sm;
side_s += (side_t - side_s) * sm;
wid_s  += (wid_t  - wid_s)  * sm;
out_s  += (out_t  - out_s)  * sm;
bal_s  += (bal_t  - bal_s)  * sm;
abs(air_db - lastair) > 0.05 ? ( lastair = air_db; shS.bq_shelf(8000, air_db); );
infmt ? ( m = inL; s = inR; ) : ( m = 0.5 * (inL + inR); s = 0.5 * (inL - inR); );
bmono >= 20 ? s = hpS2.bq_run(hpS.bq_run(s));
air_db > 0.05 ? s = shS.bq_run(s);
slider7 > 0.05 ? m = pkM.bq_run(m);
w = max(wid_s, 0);
gM = min(sqrt(2 / (1 + w * w)), 1.4142);
m *= mid_s * gM;
s *= side_s * w * gM;
listen == 1 ? ( oL = m; oR = m; ) :
listen == 2 ? ( oL = s; oR = s; ) :
outfmt ? ( oL = m; oR = s; ) : ( oL = m + s; oR = m - s; );
bal = min(max(bal_s, -1), 1);
oL *= min(1, 1 - bal); oR *= min(1, 1 + bal);
oL *= out_s; oR *= out_s;
pwr_out(oL, oR); oL = pwr_l; oR = pwr_r;
ms_fi < 1 ? (
  ms_fi = min(ms_fi + ms_fis, 1); ms_z = ms_fi * ms_fi * (3 - 2 * ms_fi);
  oL = by_il + (oL - by_il) * ms_z; oR = by_ir + (oR - by_ir) * ms_z;
);
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); oL *= prs_w; oR *= prs_w; );
spl0 = oL; spl1 = oR;
by_out();
cLR += (spl0 * spl1 - cLR) * crc; cLL += (spl0 * spl0 - cLL) * crc; cRR += (spl1 * spl1 - cRR) * crc;
ms_msq += 0.5 * (spl0 * spl0 + spl1 * spl1);
ms_pkm = max(ms_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x2A2D31; mk_band = 0x0B0C0D; mk_ink = 0xF0F1F2; mk_tab = 0x3CD6E6; mk_tink = 0x0A1A1C;
mk_sub = 0x1E2023; mk_hot = 0xC8F4FA; mk_lime = 0x3CD6E6;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.3);
mg_byp = 14;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, p0, p1) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; p0 = floor(xl); p1 = floor(xr);
  hw > 0 ? loop(n,
    p0 == p1 ? ( gfx_a = xr - xl; gfx_rect(p0, j, 1, 1); ) : (
      gfx_a = p0 + 1 - xl; gfx_rect(p0, j, 1, 1);
      gfx_a = 1; p1 > p0 + 1 ? gfx_rect(p0 + 1, j, p1 - p0 - 1, 1);
      gfx_a = xr - p1; xr > p1 ? gfx_rect(p1, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_sub(x, y, w, h, num, title) local(b, c) (
  b = 7; c = ui_mix(mk_face, 0xFFFFFF, 0.18);
  ui_col(ui_mix(mk_face, 0x000000, 0.30)); mg_r(x + 1, y + h, w, 1); mg_r(x + w, y + 1, 1, h);
  ui_col(ui_mix(mk_face, 0x000000, 0.12)); mg_r(x + 2, y + h + 1, w, 1); mg_r(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0x000000, 0.55)); mg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); mg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); mg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); mg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.45)); mg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(mk_sub); mg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(mk_sub, 0x000000, 0.3)); mg_r(x + 9, y + b + 33, w - 18, 1);
  ui_col(mk_tab); mg_r(x + b, y + b, w - 2 * b, 28); ui_col(ui_mix(mk_tab, 0x000000, 0.3)); mg_r(x + b, y + b + 26, w - 2 * b, 2);
  ui_col(0x1A1A1C); mg_r(x + b + 6, y + b + 5, 26, 18); gfx_setfont(11); ui_col(0xF4F6F8); mg_ctxt(x + b + 19, y + b + 14, num);
  gfx_setfont(12); ui_col(mk_tink); mg_ltxt(x + b + 40, y + b + 14, title);
  ui_col(0x4A4D52); mg_disc(x + b + 6, y + h - b - 6, 3); mg_disc(x + w - b - 6, y + h - b - 6, 3);
  ui_col(0x8A8E94); mg_disc(x + b + 5.5, y + h - b - 6.5, 1.8); mg_disc(x + w - b - 6.5, y + h - b - 6.5, 1.8);
);
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_kbody(sty, x, y, r, a, act, col) local(KX, KY, KR, i, t) (
  KX = x * sc; KY = y * sc; KR = r * sc;
  sty == 1 ? (
    ui_col(0x15181B); gfx_circle(KX, KY, KR, 1, 1);
    i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); gfx_line(KX + sin(t) * KR * 0.8, KY - cos(t) * KR * 0.8, KX + sin(t) * KR * 0.95, KY - cos(t) * KR * 0.95, 1); i += 1; );
    ui_col(ui_mix(col, 0x000000, 0.5)); gfx_circle(KX, KY, KR * 0.76, 1, 1);
    ui_col(col); gfx_circle(KX, KY, KR * 0.72, 1, 1);
    i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(KX, KY, KR * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
    ui_cola(0xFFFFFF, act ? 0.38 : 0.26); ui_ssarc(KX, KY, KR * 0.62, -1.7, -0.3, 1 * sc);
    ui_col(mg_lum(col) > 0.35 ? 0x1A1D22 : 0xECE6DA); ui_kdot(KX, KY, a, KR * 0.72);
  ) : (
    ui_col(0x2C2E33); gfx_circle(KX, KY, KR, 1, 1);
    ui_col(0x121315); gfx_circle(KX, KY, KR * 0.8, 1, 1);
    ui_col(ui_mix(0x2C2E33, 0x000000, 0.25)); gfx_circle(KX, KY, KR * 0.68, 1, 1);
    ui_cola(0xFFFFFF, act ? 0.22 : 0.12); ui_ssarc(KX, KY, KR * 0.95, -2.6 + 0.5 * $pi, -1.0 + 0.5 * $pi, 1 * sc);
    ui_col(0xECE6DA); ui_kdot(KX, KY, a, KR * 0.68);
  );
);
function mg_dots(x, y, r, c) local(i, t, rs) (
  rs = r + 8; i = 0;
  loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi; ui_col(c); mg_disc(x + sin(t) * rs, y - cos(t) * rs, i == 0 || i == 4 ? 1.8 : 1.3); i += 1; );
);
function mg_v2n(v, lo, hi) ( mg_klog ? log(max(v, lo) / lo) / log(hi / lo) : mg_kpow ? ((v - lo) / (hi - lo)) ^ (1 / mg_kpow) : (v - lo) / (hi - lo); );
function mg_n2v(n, lo, hi) ( mg_klog ? lo * (hi / lo) ^ n : mg_kpow ? lo + (hi - lo) * n ^ mg_kpow : lo + n * (hi - lo); );
function mg_knob(cx, cy, r, idx, lo, hi, def, sty, col) local(v, n, dx, dy, hov, did, act, a, k) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = !mg_lock && dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mgk_lt < 0.35 && mgk_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mgk_lt = 0; ) : (
      drag_id = did; mgk_my = mouse_y; mgk_dz = 0; mgk_lt = time_precise(); mgk_lid = idx;
      mgk_n = min(max(mg_v2n(v, lo, hi), 0), 1);
    );
  );
  drag_id == did ? (
    mgk_dz += abs(mgk_my - mouse_y);
    mgk_dz > 3 * sc ? (
      mgk_n = min(max(mgk_n + (mgk_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = mg_n2v(mgk_n, lo, hi);
      mg_kstep ? v = lo + floor(mgk_n * (mg_kstep - 1) + 0.5) * (hi - lo) / (mg_kstep - 1);
      mg_ksnap ? v = floor(v / mg_ksnap + 0.5) * mg_ksnap;
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mgk_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    mg_kstep ? (
      k = floor((v - lo) / (hi - lo) * (mg_kstep - 1) + 0.5) + (mouse_wheel > 0 ? 1 : -1);
      slider(idx) = lo + min(max(k, 0), mg_kstep - 1) * (hi - lo) / (mg_kstep - 1);
    ) : (
      n = min(max((mg_v2n(v, lo, hi)) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
      v = mg_n2v(n, lo, hi);
      mg_ksnap ? v = floor(v / mg_ksnap + 0.5) * mg_ksnap;
      slider(idx) = min(max(v, lo), hi);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_v2n(v, lo, hi), 0), 1);
