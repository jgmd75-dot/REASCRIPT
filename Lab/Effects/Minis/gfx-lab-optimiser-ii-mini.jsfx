desc:Optimiser II Mini [broadcast processor] (GFX Lab)
//tags: broadcast processor multiband limiter agc clipper loudness mastering am fm long wave streaming
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os and gfx-lab-bypass (.jsfx-inc) in the same folder.

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

slider1:o_model=2<0,2,1{LW,AM,FM}>-Model
slider2:o_rel=1<0,2,1{Slow,Medium,Fast}>-Release
slider3:o_agc=1<0,1,1{Off,On}>-AGC
slider4:o_gate=1<0,1,1{Off,On}>-AGC gate
slider5:o_drv=6<-12,6,0.1>-Drive (dB)
slider6:o_bass=0<-6,6,0.1>-LF (dB)
slider7:o_mid=0<-6,6,0.1>-LMF (dB)
slider8:o_pres=0<-6,6,0.1>-HMF (dB)
slider9:o_air=0<-6,6,0.1>-HF (dB)
slider10:o_clip=30<0,66,1>-Clip (%)
slider11:o_hf=40<0,100,1>-HF limit (%)
slider12:o_mix=100<0,100,1>-Mix (%)
slider13:o_out=0<-24,12,0.1>-Output (dB)
slider14:o_trim=0<-24,12,0.1>-Input trim (dB)
slider15:o_guard=0<0,1,1{Off,On}>-Input guard
slider17:o_rot=1<0,1,1{Off,On}>-Phase rotator
slider18:o_fizz=0<0,1,1{Off,On}>-Fizz (full)
slider19:o_os=1<0,2,1{1x,2x,4x}>-Oversampling
slider20:o_link=1<0,1,1{Off,On}>-Link
slider21:o_byp=0<0,1,1{Off,On}>-Bypass
slider22:o_lc=30<20,200,1>-Low cut (Hz)
slider23:o_hc=15<2,20,0.01>-High cut (kHz)
slider24:prs_sel=0<0,18,1{No preset,Init,FM: Gentle,FM: Rock,FM: Pop Loud,FM: Dance Smash,FM: Classical,FM: Podcast Stream,FM: Streaming Master,AM: Talk,AM: Music Radio,AM: Sports,AM: Vintage,AM: Night Skywave,LW: Speech,LW: Weather Bulletin,LW: Music,LW: Dance Band,LW: Wartime Wireless}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-optimiser-ii-mini";
pk_lcdstrip = 1;
ext_noinit = 1;

OPB = 20000;
OSD = 30000;
DRY = 31000;
RMASK = 1023;

function op_init() (
  op_bsz = 2048; op_bmask = op_bsz - 1;
  memset(OPB, 0, op_bsz * 2);
  op_wp = 0; op_g = 1; op_hg = 1; op_hc = 0; op_gr = 1;
  op_n = min(floor(0.003 * srate), op_bsz - 1);
  op_att = 1 - exp(-5 / op_n);
  op_rel = 1 - exp(-1 / (0.08 * srate));
  op_c = 10 ^ (-0.3 / 20);
  op_ga = op_gb = 1; op_hga = op_hgb = 1; op_hca = op_hcb = 0;
);
function op_lim(l, r) local(pk, gt, rp, dl, dr) (
  OPB[op_wp] = l; OPB[op_bsz + op_wp] = r;
  rp = (op_wp - op_n + op_bsz) & op_bmask;
  dl = OPB[rp]; dr = OPB[op_bsz + rp];
  op_wp = (op_wp + 1) & op_bmask;
  pk = max(abs(l), abs(r));
  gt = pk > op_c ? op_c / pk : 1;
  gt < op_hg ? ( op_hg = gt; op_hc = op_n; ) : ( op_hc > 0 ? op_hc -= 1 : op_hg = gt; );
  op_g += (op_hg - op_g) * (op_hg < op_g ? op_att : op_rel);
  op_gr = min(op_gr, op_g);
  op_l = min(max(dl * op_g, -op_c), op_c);
  op_r = min(max(dr * op_g, -op_c), op_c);
);
function op_lim2(l, r) local(pk, gt, rp, dl, dr, ga, gb) (
  OPB[op_wp] = l; OPB[op_bsz + op_wp] = r;
  rp = (op_wp - op_n + op_bsz) & op_bmask;
  dl = OPB[rp]; dr = OPB[op_bsz + rp];
  op_wp = (op_wp + 1) & op_bmask;
  pk = max(abs(l), abs(r));
  gt = pk > op_c ? op_c / pk : 1;
  gt < op_hg ? ( op_hg = gt; op_hc = op_n; ) : ( op_hc > 0 ? op_hc -= 1 : op_hg = gt; );
  op_g += (op_hg - op_g) * (op_hg < op_g ? op_att : op_rel);
  pk = abs(l); gt = pk > op_c ? op_c / pk : 1;
  gt < op_hga ? ( op_hga = gt; op_hca = op_n; ) : ( op_hca > 0 ? op_hca -= 1 : op_hga = gt; );
  op_ga += (op_hga - op_ga) * (op_hga < op_ga ? op_att : op_rel);
  pk = abs(r); gt = pk > op_c ? op_c / pk : 1;
  gt < op_hgb ? ( op_hgb = gt; op_hcb = op_n; ) : ( op_hcb > 0 ? op_hcb -= 1 : op_hgb = gt; );
  op_gb += (op_hgb - op_gb) * (op_hgb < op_gb ? op_att : op_rel);
  ga = op_g + (op_ga - op_g) * lk_u; gb = op_g + (op_gb - op_g) * lk_u;
  op_gr = min(op_gr, min(ga, gb));
  op_l = min(max(dl * ga, -op_c), op_c);
  op_r = min(max(dr * gb, -op_c), op_c);
);

function bq_lp(f, q) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_hp(f, q) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_ap(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 - al) / n; b1 = -2 * cw / n; b2 = 1; a1 = b1; a2 = b0;
);
function bq_pk(f, g, q) instance(b0, b1, b2, a1, a2) local(pa, w0, cw, al, n) (
  pa = 10 ^ (g / 40); w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al / pa;
  b0 = (1 + al * pa) / n; b1 = -2 * cw / n; b2 = (1 - al * pa) / n; a1 = b1; a2 = (1 - al / pa) / n;
);
function bq(x, c0, c1, c2, d1, d2) instance(z1, z2) local(y) (
  y = c0 * x + z1;
  z1 = c1 * x - d1 * y + z2;
  z2 = c2 * x - d2 * y;
  y;
);
function bqz() instance(z1, z2) ( z1 = z2 = 0; );

function band_gr(pw, att, rel) instance(e, gr) local(ldb, ov, tg) (
  e += (pw - e) * cdet;
  ldb = 10 * log10(max(e, 0.000000000001)) + drv_s;
  ov = ldb - b_thr;
  tg = 2 * ov < -b_kn ? 0 : 2 * abs(ov) <= b_kn ? b_sl * sqr(ov + b_kn * 0.5) / (2 * b_kn) : b_sl * ov;
  gr += (tg - gr) * (tg > gr ? att : rel);
  gr;
);
function agc_side(p) instance(ms, db) local(l, t) (
  ms += (p - ms) * agc_c;
  agc_on ? (
    l = 10 * log10(max(ms, 0.000000000001));
    !(gate_on && l < -50) ? (
      t = min(max(-18 - l, -12), 12);
      db += max(min(t - db, agc_up), -agc_dn);
    );
  ) : (
    db += max(min(-db, agc_up * 4), -agc_dn * 4);
  );
);
function hf_side(e_) instance(e, g) local(t) (
  e += (e_ - e) * (e_ > e ? hf_at : hf_rl);
  t = e > hft ? hft / e : 1;
  g += (t - g) * (t < g ? hf_at : hf_rl);
);
function cpl_lim(g) ( gav + min(max(g - gav, -glim), glim); );
function opt_clip(x, t) local(a, k) (
  a = abs(x); k = 0.7 * t;
  a < k ? x : sign(x) * (k + (t - k) * ost_tanh((a - k) / (t - k)));
);
function mdl_clip(x, t) (
  x += m_vw * 0.18 * x * x / t;
  x > 0 ? opt_clip(x, t) : opt_clip(x, t * m_asy);
);
function tc(ms) ( 1 - exp(-1 / (0.001 * ms * srate)); );

function update() (
  agc_on = o_agc; gate_on = o_gate;
  bg1 = 10 ^ (o_bass / 20); bg2 = 10 ^ (o_mid / 20); bg3 = 10 ^ (o_pres / 20); bg4 = 10 ^ (o_air / 20);
  clp_g = 10 ^ (9 * o_clip / 100 / 20);
  mix_t = o_mix / 100;
  rot_on = o_rot > 0.5; hf_amt = o_hf / 100; fz_on = max(o_fizz > 0.5, 0.5 * min(max((o_clip - 40) / 26, 0), 1));
  lk_t = o_link >= 0.5;
  by_t = o_byp >= 0.5;
  out_t = 10 ^ (o_out / 20);
  in_setup(o_trim, o_guard);
  lc_on = o_lc > 20.5; hc_on = o_hc < 19.95;
  lc_t = log(max(o_lc, 20)); hc_t = log(min(o_hc, 20) * 1000);
  os_tf = os_f2n(o_os);
  o_model < 0.5 ? (
    mt_cpl = 0.85; m_ta = 1.5; m_tr = 1.6; mt_asy = 0.80; mt_vw = 1;    mt_hfo = 2;
    mt_fa = log(300); mt_ga = 2;   mt_fb = log(2200);  mt_gb = 2.5;
  ) : o_model < 1.5 ? (
    mt_cpl = 0.55; m_ta = 1.3; m_tr = 1.0; mt_asy = 0.88; mt_vw = 0.35; mt_hfo = 0;
    mt_fa = log(120); mt_ga = 1.5; mt_fb = log(3500);  mt_gb = 3;
  ) : (
    mt_cpl = 0.45; m_ta = 1;   m_tr = 0.8; mt_asy = 1;    mt_vw = 0;    mt_hfo = -2;
    mt_fa = log(60);  mt_ga = 1;   mt_fb = log(10000); mt_gb = 1.5;
  );
  o_model != m_last ? ( m_last = o_model; m_gl = ceil(srate) + 16; );
);

function timing(m) local(r1, r2, r3, r4) (
  o_rel < 0.5 ? ( r1 = 800; r2 = 500; r3 = 400; r4 = 300; ) :
  o_rel < 1.5 ? ( r1 = 350; r2 = 220; r3 = 180; r4 = 140; ) :
                ( r1 = 150; r2 = 90;  r3 = 70;  r4 = 60;  );
  at1 = tc(30 * m * m_ta); at2 = tc(12 * m * m_ta); at3 = tc(6 * m * m_ta); at4 = tc(3 * m * m_ta);
  rl1 = tc(r1 * m * m_tr); rl2 = tc(r2 * m * m_tr); rl3 = tc(r3 * m * m_tr); rl4 = tc(r4 * m * m_tr);
);

function model_band(m) (
  o_lc = m == 0 ? 100 : m == 1 ? 50 : 30;
  o_hc = m == 0 ? 4.5 : m == 1 ? 9.5 : 15;
);
function model_band_au(m) (
  o_lc = m == 0 ? 100 : m == 1 ? 50 : 30;
  o_hc = m == 0 ? 4.5 : m == 1 ? 9.5 : 15;
);

#o2_pmn = "Init|FM: Gentle|FM: Rock|FM: Pop Loud|FM: Dance Smash|FM: Classical|FM: Podcast Stream|FM: Streaming Master|AM: Talk|AM: Music Radio|AM: Sports|AM: Vintage|AM: Night Skywave|LW: Speech|LW: Weather Bulletin|LW: Music|LW: Dance Band|LW: Wartime Wireless";
function setp(m, rl, ag, gt, dr, bs, md, pr, ai, cl, hf, fz) (
  o_model = m; o_rel = rl; o_agc = ag; o_gate = gt; o_drv = dr; o_bass = bs; o_mid = md; o_pres = pr; o_air = ai;
  o_clip = cl; o_hf = hf; o_fizz = fz; model_band_au(m);
);
function load_preset(p) local(i) (
  o_mix = 100; o_out = 0; o_rot = 1;
  p == 1  ? setp(2, 1, 1, 1, 6, 0, 0, 0, 0, 30, 40, 0) :
  p == 2  ? setp(2, 0, 1, 1, 4, 1, 0, 0.5, 1, 10, 30, 0) :
  p == 3  ? setp(2, 1, 1, 1, 4.7, 2, -0.5, 1.5, 2, 30, 45, 1) :
  p == 4  ? setp(2, 2, 1, 1, 5.5, 2.5, 0, 2, 3, 55, 55, 1) :
  p == 5  ? setp(2, 2, 1, 0, 6, 3, -1, 1.5, 2.5, 64, 60, 1) :
  p == 6  ? setp(2, 0, 1, 1, 2, 0, 0, 0, 0.5, 0, 20, 0) :
  p == 7  ? ( setp(2, 1, 1, 1, 4.5, -3, 0.5, 2, 1, 15, 35, 0); o_hc = 20; ) :
  p == 8  ? ( setp(2, 0, 0, 0, 3, 0.5, 0, 0.5, 1, 10, 25, 0); o_lc = 20; o_hc = 20; ) :
  p == 9  ? setp(1, 1, 1, 1, 4.9, -2, 1, 2.5, 0, 20, 50, 0) :
  p == 10 ? setp(1, 1, 1, 1, 5.1, 1.5, 0.5, 1.5, 1, 40, 45, 0) :
  p == 11 ? setp(1, 2, 1, 1, 5.5, -1, 1.5, 3, 0, 50, 55, 0) :
  p == 12 ? setp(1, 1, 1, 1, 5.8, 3, 2, 3, -2, 66, 50, 0) :
  p == 13 ? ( setp(1, 0, 1, 1, 5.3, 2, 1, 2, -1.5, 35, 40, 0); o_hc = 6; ) :
  p == 14 ? setp(0, 1, 1, 1, 5.1, -3, 2, 3, 0, 40, 40, 0) :
  p == 15 ? setp(0, 0, 1, 1, 4.5, -2, 1.5, 2, 0, 25, 30, 0) :
  p == 16 ? setp(0, 0, 1, 1, 4.7, 2, 1, 2, 0, 35, 35, 0) :
  p == 17 ? setp(0, 1, 1, 1, 4.9, 2.5, 1, 1.5, 0, 45, 35, 0) :
  p == 18 ? ( setp(0, 1, 1, 1, 5.6, 1, 2.5, 2, -3, 62, 40, 0); o_hc = 3.5; );
  o2_note_dirty = 1;
  pr_cur = p;
);

klp1.bq_lp(150, 0.70710678);  khp1.bq_hp(150, 0.70710678);
klp2.bq_lp(1200, 0.70710678); khp2.bq_hp(1200, 0.70710678);
klp3.bq_lp(6000, 0.70710678); khp3.bq_hp(6000, 0.70710678);
kap2.bq_ap(1200); kap3.bq_ap(6000);
kpr.bq_ap(200);
kfz1.bq_hp(3000, 0.70710678); kfz2.bq_hp(5000, 0.70710678); kfz3.bq_pk(8000, 6, 0.9);
hf_at = 1 - exp(-1 / (0.0003 * srate)); hf_rl = 1 - exp(-1 / (0.05 * srate)); hf_e = 0; hf_gn = 1;
fz_a = 1 - exp(-1 / (0.001 * srate)); fz_r = 1 - exp(-1 / (0.04 * srate)); fz_w = 1 - exp(-1 / (0.03 * srate));
fz_h = 0; fz_e = 0; fz_p = 0;
b_thr = -12; b_sl = 0.8; b_kn = 8;
cpl = 0.5;
cdet = 1 - exp(-1 / (0.005 * srate));
agc_c  = 1 - exp(-1 / (0.4 * srate));
agc_up = 2 / srate; agc_dn = 6 / srate;
sm  = 1 - exp(-1 / (0.03 * srate));
dc_k = 1 - 2 * $pi * 5 / srate; dcx_l = dcy_l = dcx_r = dcy_r = 0;
c_sw = 1 - exp(-1 / (0.015 * srate));
lk_c = 1 - exp(-1 / (0.01 * srate));
fl_c = 1 - exp(-1 / (0.03 * srate * 16 / 16));
op_init();
os_design(); os_base = op_n; os_f = os_tf = os_f2n(o_os); os_gsetup();
memset(OSD, 0, 128); osd_w = 0;
memset(DRY, 0, 2048); dw = 0;
in_init();
agc_ms = 0.0159; agc_db = 0;
rs_f = 1; rs_c = 1 / (0.015 * srate);

m_last = -1; update();
timing(1);
rot_m = rot_on; fz_m = fz_on;
cpl = mt_cpl; m_asy = mt_asy; m_vw = mt_vw; m_hfo = mt_hfo; m_fa = mt_fa; m_ga = mt_ga; m_fb = mt_fb; m_gb = mt_gb; mq_n = 0;
mix_s = mix_t; out_s = out_t; drv_e = o_drv; lk_s = lk_t; lk_u = 1 - lk_s; by_s = by_t;
drv_s = drv_e; clp_s = clp_g; bg1s = bg1; bg2s = bg2; bg3s = bg3; bg4s = bg4;
lc_s = lc_t; hc_s = hc_t; lc_m = lc_on; hc_m = hc_on; fl_n = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(24, i != 24 && i != 16 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 18 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(18, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@slider
prs_chk();
update();
os_snap(slider(19));

@block
prs_chk();
update();
pdc_bot_ch = 0; pdc_top_ch = 2;
vu_d = max(vu_d, sqrt(vu_ms / max(vu_n, 1))); vu_ms = 0; vu_n = 0;
drv_e = o_drv;
timing(1);
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? rs_req = 1;
rs_last = rs_now;
os_snapb(slider(19));

@sample
rs_req ? (
  rs_req = 0; rs_f = 0; rs_x = 0; rs_wait = pdc_delay;
  memset(OPB, 0, 4096); memset(OSD, 0, 128); memset(DRY, 0, 2048);
  oul.os_clr(); our.os_clr(); odl.os_clr(); odr.os_clr();
);
rw_l = spl0; rw_r = spl1;
in_process(spl0, spl1);
inl = in_l; inr = in_r;
in_l_d = max(in_l_d, abs(inl)); in_r_d = max(in_r_d, abs(inr));
mix_s += (mix_t - mix_s) * sm;
out_s += (out_t - out_s) * sm;
drv_s += (drv_e - drv_s) * sm; clp_s += (clp_g - clp_s) * sm;
bg1s += (bg1 - bg1s) * sm; bg2s += (bg2 - bg2s) * sm; bg3s += (bg3 - bg3s) * sm; bg4s += (bg4 - bg4s) * sm;

lc_s += (lc_t - lc_s) * fl_c; hc_s += (hc_t - hc_s) * fl_c;
lc_m += (lc_on - lc_m) * lk_c; hc_m += (hc_on - hc_m) * lk_c;
fl_n -= 1;
abs(lc_s - lc_t) > 0.0002 || abs(hc_s - hc_t) > 0.0002 ? fl_n = 0;
fl_n <= 0 ? (
  fl_n = 16;
  klc.bq_hp(exp(lc_s), 0.70710678);
  khc1.bq_lp(exp(hc_s), 0.54119610); khc2.bq_lp(exp(hc_s), 1.30656296);
);
lc_m > 0.0001 ? (
  xl = Llc.bq(inl, klc.b0, klc.b1, klc.b2, klc.a1, klc.a2); xr = Rlc.bq(inr, klc.b0, klc.b1, klc.b2, klc.a1, klc.a2);
  inl += (xl - inl) * lc_m; inr += (xr - inr) * lc_m;
) : ( Llc.bqz(); Rlc.bqz(); );

agc_ms += (0.5 * (inl * inl + inr * inr) - agc_ms) * agc_c;
gate_d = 0;
agc_on ? (
  a_ldb = 10 * log10(max(agc_ms, 0.000000000001));
  gate_on && a_ldb < -50 ? gate_d = 1 : (
    a_t = min(max(-18 - a_ldb, -12), 12);
    agc_db += max(min(a_t - agc_db, agc_up), -agc_dn);
  );
) : (
  agc_db += max(min(-agc_db, agc_up * 4), -agc_dn * 4);
);
lk_s += (lk_t - lk_s) * lk_c; lk_s > 0.9999 && lk_t ? lk_s = 1; lk_s < 0.0001 && !lk_t ? lk_s = 0;
lk_u = 1 - lk_s;
lk_u > 0 ? (
  aga.agc_side(inl * inl); agb.agc_side(inr * inr);
  xl = inl * 10 ^ ((agc_db + (aga.db - agc_db) * lk_u) / 20);
