fl_yl = ostL.ost_band(fl_yl); fl_yr = ostR.ost_band(fl_yr);
ost_out(fl_yl, fl_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
fl_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);

