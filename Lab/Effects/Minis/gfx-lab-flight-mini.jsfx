desc:Flight Mini [buss colour] (GFX Lab)
//tags: processing buss bus colour saturation multiband stagger meter sidebar transformer iron compressor glue clipper mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-sidebar, gfx-lab-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-24,12,0.1>-Trim (dB)
slider3:3<0,10,0.01>-Drive
slider4:50<-100,100,1>-Tilt (%)
slider5:30<0,100,1>-Glue (%)
slider6:0<0,1,1{Slow,Fast}>-Glue speed
slider7:0<0,1,1{Off,On}>-Listen
slider8:100<0,100,1>-Mix (%)
slider9:0<-12,12,0.1>-Output (dB)
slider10:0<-12,12,0.1>-Mids (dB)
slider11:1<0,2,1{1x,2x,4x}>-Oversampling
slider12:7<0,9,1{330 Hz,440 Hz,550 Hz,660 Hz,770 Hz,880 Hz,990 Hz,1.1 kHz,2.2 kHz,3.3 kHz}>-Pivot
slider13:prs_sel=0<0,8,1{No preset,Init,Drum Buss,Guitar Buss,Vocal Buss,Bass Weight,Keys Glow,Highs Ahead,Lows Ahead}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sidebar.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-flight-mini";
ext_noinit = 1;

function fl_db(d) ( exp(d * 0.11512925464970228); );
function fl_tcf(ms, fs) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * fs)); );
function fl_opk(f, fs) ( 1 - exp(-2 * $pi * min(f, fs * 0.45) / fs); );

function ir_sat(x) ( x / sqrt(1 + x * x); );
function ir_run(u, g, gl, b, rb, kb, kc) instance(lp) local(lo) (
  lp += (u - lp) * kc;
  lo = (ir_sat(lp * gl + b) - rb) * kb / gl;
  ir_sat((u - lp + lo) * g) / g;
);
function ir_tgt(d, kg, kl, kbias, hb) instance(tg, tgl, tb, trb, tkb) (
  tg = fl_db(kg * d - 9) * hb; tgl = tg * (1 + kl * d); tb = kbias * d;
  trb = ir_sat(tb); tkb = (1 + tb * tb) ^ 1.5;
);
function ir_glide(k) instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) (
  g += (tg - g) * k; gl += (tgl - gl) * k; b += (tb - b) * k; rb += (trb - rb) * k; kb += (tkb - kb) * k;
);
function ir_snap() instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) ( g = tg; gl = tgl; b = tb; rb = trb; kb = tkb; );

function xo_coef(f, fs) instance(c1, c2, c3) local(g) (
  g = tan($pi * min(f, 0.45 * fs) / fs); c1 = 1 / (1 + g * (g + 1.4142135623730951)); c2 = g * c1; c3 = g * c2;
);
function xo_run(x, c1, c2, c3) instance(a1, a2, b1, b2, d1, d2, lo, hi) local(v1, v2, v3, l, h) (
  v3 = x - a2; v1 = c1 * a1 + c2 * v3; v2 = a2 + c2 * a1 + c3 * v3; a1 = 2 * v1 - a1; a2 = 2 * v2 - a2;
  l = v2; h = x - 1.4142135623730951 * v1 - v2;
  v3 = l - b2; v1 = c1 * b1 + c2 * v3; v2 = b2 + c2 * b1 + c3 * v3; b1 = 2 * v1 - b1; b2 = 2 * v2 - b2;
  lo = v2;
  v3 = h - d2; v1 = c1 * d1 + c2 * v3; v2 = d2 + c2 * d1 + c3 * v3; d1 = 2 * v1 - d1; d2 = 2 * v2 - d2;
  hi = h - 1.4142135623730951 * v1 - v2;
);
function xo_clr() instance(a1, a2, b1, b2, d1, d2, lo, hi) ( a1 = a2 = b1 = b2 = d1 = d2 = lo = hi = 0; );

FL_N = 16384; FL_M = FL_N - 1;
function fl_ri(b, i, f) local(a) ( a = b[i & FL_M]; a + (b[(i + 1) & FL_M] - a) * f; );
function fl_pos() local(p) (
  p = fl_w - fl_d0; fl_i0 = floor(p); fl_f0 = p - fl_i0; p = fl_w - fl_d1; fl_i1 = floor(p); fl_f1 = p - fl_i1;
  p = fl_w - fl_d2; fl_i2 = floor(p); fl_f2 = p - fl_i2; p = fl_w - fl_d3; fl_i3 = floor(p); fl_f3 = p - fl_i3;
  p = fl_w - fl_D + fl_d0; fl_j0 = floor(p); fl_q0 = p - fl_j0; p = fl_w - fl_D + fl_d1; fl_j1 = floor(p); fl_q1 = p - fl_j1;
  p = fl_w - fl_D + fl_d2; fl_j2 = floor(p); fl_q2 = p - fl_j2; p = fl_w - fl_D + fl_d3; fl_j3 = floor(p); fl_q3 = p - fl_j3;
);
function fl_run(x, buf) local(w, s, e, h) (
  w = fl_w;
  this.m.xo_run(x, xoM.c1, xoM.c2, xoM.c3);
  this.l.xo_run(this.m.lo, xoL.c1, xoL.c2, xoL.c3);
  this.h.xo_run(this.m.hi, xoH.c1, xoH.c2, xoH.c3);
  buf[w] = this.l.lo; buf[FL_N + w] = this.l.hi; buf[2 * FL_N + w] = this.h.lo; buf[3 * FL_N + w] = this.h.hi; buf[4 * FL_N + w] = x;
  s = fl_s0 * fl_ri(buf, fl_i0, fl_f0) + fl_s1 * fl_ri(buf + FL_N, fl_i1, fl_f1) + fl_s2 * fl_ri(buf + 2 * FL_N, fl_i2, fl_f2) + fl_s3 * fl_ri(buf + 3 * FL_N, fl_i3, fl_f3);
  e = this.s0.sb_run(s);
  this.n.xo_run(e, xoM.c1, xoM.c2, xoM.c3);
  this.p.xo_run(this.n.lo, xoL.c1, xoL.c2, xoL.c3);
  this.q.xo_run(this.n.hi, xoH.c1, xoH.c2, xoH.c3);
  buf[5 * FL_N + w] = this.p.lo; buf[6 * FL_N + w] = this.p.hi; buf[7 * FL_N + w] = this.q.lo; buf[8 * FL_N + w] = this.q.hi;
  h = fl_h0 * fl_ri(buf + 5 * FL_N, fl_j0, fl_q0) + fl_h1 * fl_ri(buf + 6 * FL_N, fl_j1, fl_q1) + fl_h2 * fl_ri(buf + 7 * FL_N, fl_j2, fl_q2) + fl_h3 * fl_ri(buf + 8 * FL_N, fl_j3, fl_q3);
  this.hm = h;
  buf[4 * FL_N + ((w - fl_D) & FL_M)] + h;
);
function fl_clr() ( this.m.xo_clr(); this.l.xo_clr(); this.h.xo_clr(); this.s0.sb_clr(); this.n.xo_clr(); this.p.xo_clr(); this.q.xo_clr(); this.hm = 0; );

function fl_comp(l, r) local(e, o, z, gr) (
  fl_ph == 0 ? (
  e = 8.685889638065035 * log(max(max(abs(l), abs(r)), 0.00001));
  o = e - fl_thr;
  z = o <= -4 ? 0 : o >= 4 ? o * fl_slp : fl_slp * sqr(o + 4) / 16;
  fl_g1 += (z - fl_g1) * (z > fl_g1 ? fl_ca : fl_cr1);
  fl_g2 += (z - fl_g2) * (z > fl_g2 ? fl_ca2 : fl_cr2);
  gr = fl_fast ? fl_g1 : max(fl_g1, fl_g2);
  gr *= fl_gm;
  fl_gro = max(fl_gro, gr);
  fl_cz = fl_db(fl_mku * fl_gm - gr);
  );
  fl_cl = l * fl_cz; fl_cr = r * fl_cz;
);

function fl_chain(l, r) (
  l = iaL.ir_run(l, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  r = iaR.ir_run(r, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  fl_pos();
  l = bL.fl_run(l, FL_L); r = bR.fl_run(r, FL_R);
  fl_w = (fl_w + 1) & FL_M;
  fl_ph == 0 ? ( fl_bm0 += max(sqr(bL.l.lo), sqr(bR.l.lo)); fl_bm1 += max(sqr(bL.l.hi), sqr(bR.l.hi));
    fl_bm2 += max(sqr(bL.h.lo), sqr(bR.h.lo)); fl_bm3 += max(sqr(bL.h.hi), sqr(bR.h.hi)); );
  fl_comp(l, r); fl_ph += 1;
  fl_pl = obL.ir_run(fl_cl * fl_cg, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);
  fl_pr = obR.ir_run(fl_cr * fl_cg, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);
  fl_lsn > 0.0001 ? ( fl_pl += fl_lsn * (4 * bL.hm - fl_pl); fl_pr += fl_lsn * (4 * bR.hm - fl_pr); );
);
function fl_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  bL.fl_clr(); bR.fl_clr();
  memset(FL_L, 0, 9 * FL_N); memset(FL_R, 0, 9 * FL_N); fl_w = 0;
  iaL.lp = iaR.lp = obL.lp = obR.lp = 0;
  fl_g1 = fl_g2 = 0;
);
function fl_reset() (
  fl_clear(); memset(BY_BUF, 0, 2 * BY_N);
  in_dxL = in_dyL = in_dxR = in_dyR = 0; fl_dxl = fl_dyl = fl_dxr = fl_dyr = 0; sg_e = 0;
  ostL.ost_ch_init(); ostR.ost_ch_init();
  fl_fi = 0;
);

PT = 6000000;
#fl_pm = "Init|Drum Buss|Guitar Buss|Vocal Buss|Bass Weight|Keys Glow|Highs Ahead|Lows Ahead";
function fl_w6(a, b, c, d, e, f) ( fl_wp[0] = a; fl_wp[1] = b; fl_wp[2] = c; fl_wp[3] = d; fl_wp[4] = e; fl_wp[5] = f; fl_wp += 6; );
fl_wp = PT;
fl_w6(0, 3, 50, 100, 100, 100);   fl_w6(100, 30, 0, 100, 0, 0);
fl_w6(0, 6, 70, 150, 100, 80);    fl_w6(60, 45, 1, 100, 0, -2);
fl_w6(0, 4.5, 40, 80, 120, 130);  fl_w6(80, 30, 0, 100, 0, 2);
fl_w6(0, 3, 60, 60, 110, 120);    fl_w6(90, 35, 0, 100, 0, 3);
fl_w6(0, 5, -60, 160, 120, 70);   fl_w6(50, 40, 0, 100, 0, -3);
fl_w6(0, 3.5, 30, 70, 100, 120);  fl_w6(130, 20, 0, 100, 0, 1);
fl_w6(0, 7, 100, 110, 110, 110);  fl_w6(110, 25, 1, 100, -1, 0);
fl_w6(0, 7, -100, 140, 110, 90);  fl_w6(80, 25, 0, 100, -1, 0);
function load_preset(p) local(i, q) (
  q = PT + (min(p, 9) == 9 ? 0 : p - 1) * 12;
  slider2 = q[0]; slider3 = q[1]; slider4 = q[2]; slider5 = q[7]; slider6 = q[8];
  slider7 = 0;
  slider8 = q[9]; slider9 = q[10]; slider10 = q[11];
  slider12 = 7;
  i = 2; loop(9, ui_auto(i); i += 1; ); ui_auto(12);
  pr_cur = p == 9 ? 1 : p;
);

function fl_srinit() (
  fl_sr = srate;
  c_kn = fl_tcf(30, srate);
  c_sw = fl_tcf(15, srate);
  c_tk = 1 - exp(-32 / (0.03 * srate));
  fl_fis = 1 / (0.01 * srate);
  ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
  sg_k = fl_tcf(60, srate);
  fl_dcc = 1 - 2 * $pi * 1.5 / srate;
  fl_wb = 3 * floor(0.01 * srate / 3 + 0.5);
  os_base = fl_wb;
  fl_clear();
  fl_snap = 1;
);
function fl_coef() local(fs) (
  fs = fl_fs = srate * os_f;
  ir_kci = fl_opk(150, fs); ir_kco = fl_opk(120, fs);
  xoL.xo_coef(exp(fl_pv) / 5, fs); xoM.xo_coef(exp(fl_pv), fs); xoH.xo_coef(exp(fl_pv) * 5, fs);
  fl_D = fl_wb * os_f;
  fl_ca = fl_tcf(fl_fast ? 3 : 30, srate); fl_ca2 = fl_tcf(250, srate);
  fl_cr1 = fl_tcf((fl_fast ? 100 : 150) * fl_rlz, srate); fl_cr2 = fl_tcf(1200 * fl_rlz, srate);
);
os_design();
FL_L = 1048576; FL_R = FL_L + 9 * FL_N;
os_f = os_tf = os_f2n(slider11);
fl_srinit();
os_gsetup();
in_init();
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_bloom = 0.1;
dSup.drift_init(0.8 + rand(1) * 0.4); dRail.drift_init(0.8 + rand(1) * 0.4);
drift_macro(50);
fl_rlz = 1; fl_cg = 1; fl_pv = log(1100); fl_sat = 0.2;
fl_fi = 1;
pdc_delay = os_base + os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(12, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 8 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(11));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != fl_sr ? fl_srinit();
fl_now = time_precise();
fl_tp > 0 && fl_now - fl_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > fl_gpp && play_position - fl_gpp < 4 * fl_gpd + 0.05) ? fl_reset();
fl_tp = fl_now; fl_gpp = play_position; fl_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
in_setup(min(max(slider2, -24), 12), 0);
ost_setup(fl_sat, 0.3, 120, 6000, -0.3, 1);
os_tf = os_f2n(slider11); pdc_delay = os_base + os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
drift_macro(50);
fl_bt = samplesblock / srate;
fl_vs = dSup.drift_tick(0.05 * dm_s * fl_bt); fl_vv = dRail.drift_tick(0.03 * dm_s * fl_bt);
fl_dvt = min(max(slider3, 0), 10);
fl_mg = fl_db(min(max(slider10, -12), 12));
fl_pvi = min(max(floor(slider12 + 0.5), 0), 9);
fl_pvt = log(fl_pvi <= 6 ? 330 + 110 * fl_pvi : 1100 * (fl_pvi - 6));
fl_pv = fl_snap ? fl_pvt : fl_pv + (fl_pvt - fl_pv) * (1 - exp(-samplesblock / (0.03 * srate)));
fl_tt = min(max(slider4, -100), 100) / 100;
fl_s0t = fl_s3t = 1; fl_s1t = fl_s2t = fl_mg;
fl_tw = 4.5 * fl_tt; fl_s0t *= fl_db(-fl_tw); fl_s1t *= fl_db(-fl_tw / 3); fl_s2t *= fl_db(fl_tw / 3); fl_s3t *= fl_db(fl_tw);
fl_h0t = fl_db(-4 - 2 * fl_tw); fl_h1t = fl_db(-2 - 2 * fl_tw / 3); fl_h2t = fl_db(1 + 2 * fl_tw / 3); fl_h3t = fl_db(4 + 2 * fl_tw);
fl_sag = 0.4 * min(sqrt(sg_e) / 0.5, 1);
fl_v = max(15 - 0.25 * dm_a * (0.5 + 0.5 * fl_vv) - fl_sag, 11);
fl_hb = (15 / fl_v) ^ 1.5 * fl_db(0.3 * dm_a * fl_vs); fl_rlz = (15 / fl_v) ^ 2;
fl_lsnt = slider7 >= 0.5;
iIn.ir_tgt(min(max(0.3 + 0.618 * min(max(slider2, -24), 12) / 20, 0), 1), 21, 0.8, 0.1, fl_hb);
iOut.ir_tgt(min(max(0.3 + 0.618 * min(max(slider9, -12), 12) / 20, 0), 1), 19, 2, 0.25, fl_hb);
fl_gl = min(max(slider5, 0), 100) / 100;
fl_thrt = -4 - 26 * fl_gl;
fl_slpt = 1 - 1 / (1.5 + 2.5 * fl_gl);
fl_gmt = min(fl_gl * 5, 1);
fl_mkt = 0.4 * fl_slpt * max(-8 - fl_thrt, 0);
fl_fast = slider6 >= 0.5;
fl_cgt = fl_db(min(max(slider9, -12), 12));
fl_mxt = min(max(slider8, 0), 100) / 100;
sb_target(9 - 1.6 * fl_dvt, 1.2 + 0.35 * fl_dvt, 1, 110, fl_hb);
fl_snap ? (
  fl_h0 = fl_h0t; fl_h1 = fl_h1t; fl_h2 = fl_h2t; fl_h3 = fl_h3t;
  fl_t = fl_tt; fl_s0 = fl_s0t; fl_s1 = fl_s1t; fl_s2 = fl_s2t; fl_s3 = fl_s3t;
  fl_thr = fl_thrt; fl_slp = fl_slpt; fl_gm = fl_gmt; fl_mku = fl_mkt;
  fl_lsn = fl_lsnt; fl_cg = fl_cgt; fl_mx = fl_mxt;
  iIn.ir_snap(); iOut.ir_snap();
  fl_coef(); sb_rate(fl_fs); sb_snap();
);
fl_snap = 0;
fl_coef(); sb_ctl(1);
fl_gr_d = max(fl_gr_d, fl_gro); fl_gro = 0;
fl_vu_d = max(fl_vu_d, sqrt(fl_ms / max(samplesblock, 1))); fl_ms = 0;
fl_b0_d = max(fl_b0_d, sqrt(fl_bm0 / max(samplesblock, 1))); fl_b1_d = max(fl_b1_d, sqrt(fl_bm1 / max(samplesblock, 1)));
fl_b2_d = max(fl_b2_d, sqrt(fl_bm2 / max(samplesblock, 1))); fl_b3_d = max(fl_b3_d, sqrt(fl_bm3 / max(samplesblock, 1)));
fl_bm0 = fl_bm1 = fl_bm2 = fl_bm3 = 0;
ost_clipped ? fl_cl_d = 1; ost_clipped = 0;
os_snapb(slider(11));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
fl_xl = in_l; fl_xr = in_r;
fl_t += (fl_tt - fl_t) * c_kn;
fl_h0 += (fl_h0t - fl_h0) * c_kn; fl_h1 += (fl_h1t - fl_h1) * c_kn; fl_h2 += (fl_h2t - fl_h2) * c_kn; fl_h3 += (fl_h3t - fl_h3) * c_kn;
fl_s0 += (fl_s0t - fl_s0) * c_kn; fl_s1 += (fl_s1t - fl_s1) * c_kn; fl_s2 += (fl_s2t - fl_s2) * c_kn; fl_s3 += (fl_s3t - fl_s3) * c_kn;
fl_thr += (fl_thrt - fl_thr) * c_kn; fl_slp += (fl_slpt - fl_slp) * c_kn; fl_gm += (fl_gmt - fl_gm) * c_kn; fl_mku += (fl_mkt - fl_mku) * c_kn;
fl_lsn += (fl_lsnt - fl_lsn) * c_sw;
fl_cg += (fl_cgt - fl_cg) * c_kn; fl_mx += (fl_mxt - fl_mx) * c_kn;
sb_glide(c_kn, c_sw);
fl_a = abs(fl_t) * fl_D;
fl_t >= 0 ? ( fl_d3 = 0; fl_d2 = fl_a / 3; fl_d1 = 2 * fl_a / 3; fl_d0 = fl_a; )
          : ( fl_d0 = 0; fl_d1 = fl_a / 3; fl_d2 = 2 * fl_a / 3; fl_d3 = fl_a; );
pwr_in(fl_xl, fl_xr); fl_xl = pwr_l; fl_xr = pwr_r;
abs(fl_xl) < 0.000000000000001 ? fl_xl = 0; abs(fl_xr) < 0.000000000000001 ? fl_xr = 0;
sg_e += (max(fl_xl * fl_xl, fl_xr * fl_xr) - sg_e) * sg_k;
iIn.ir_glide(c_kn); iOut.ir_glide(c_kn);
os_gate();
os_chg ? ( fl_clear(); fl_coef(); sb_rate(fl_fs); os_hold += 2 * samplesblock; fl_a = abs(fl_t) * fl_D;
  fl_t >= 0 ? ( fl_d3 = 0; fl_d2 = fl_a / 3; fl_d1 = 2 * fl_a / 3; fl_d0 = fl_a; ) : ( fl_d0 = 0; fl_d1 = fl_a / 3; fl_d2 = 2 * fl_a / 3; fl_d3 = fl_a; ); );
uxL.os_up(fl_xl); uxR.os_up(fl_xr);
fl_ph = 0;
os_f == 1 ? (
  fl_chain(uxL.s0, uxR.s0); fl_yl = fl_pl; fl_yr = fl_pr;
) : (
  fl_chain(uxL.s0, uxR.s0); fl_a0 = fl_pl; fl_r0 = fl_pr;
  fl_chain(uxL.s1, uxR.s1); fl_a1 = fl_pl; fl_r1 = fl_pr;
  os_f == 2 ? ( fl_yl = dnL.os_dn(fl_a0, fl_a1, 0, 0); fl_yr = dnR.os_dn(fl_r0, fl_r1, 0, 0); ) : (
    fl_chain(uxL.s2, uxR.s2); fl_a2 = fl_pl; fl_r2 = fl_pr;
