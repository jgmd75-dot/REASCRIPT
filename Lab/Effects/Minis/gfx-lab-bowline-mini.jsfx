              gfx_line((ka_x + 4.2 * ka_nx + 1.8 * ka_tx) * ka_k, (ka_y + 4.2 * ka_ny + 1.8 * ka_ty) * ka_k,
                       (ka_x - 4.2 * ka_nx - 1.8 * ka_tx) * ka_k, (ka_y - 4.2 * ka_ny - 1.8 * ka_ty) * ka_k, 1);
              gfx_line((ka_x + 4.2 * ka_nx + 1.8 * ka_tx) * ka_k + 1, (ka_y + 4.2 * ka_ny + 1.8 * ka_ty) * ka_k,
                       (ka_x - 4.2 * ka_nx - 1.8 * ka_tx) * ka_k + 1, (ka_y - 4.2 * ka_ny - 1.8 * ka_ty) * ka_k, 1);
              gfx_a = 1;
            );
          );
          ka_i += 1;
        );
        ka_q += 1;
      );
      ka_p += 1;
    );
