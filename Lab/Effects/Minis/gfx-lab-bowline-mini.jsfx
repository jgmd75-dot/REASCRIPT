function ka_draw() (
  ka_x0 = 170; ka_y0 = 5; ka_w = 230; ka_h = 60; ka_z = 0.5;
  ka_sc != sc ? (
    ka_sc = sc; ka_k = 2 * sc * ka_z; ka_iw = ceil(ka_w * ka_k) + 2; ka_ih = ceil(ka_h * ka_k) + 2;
