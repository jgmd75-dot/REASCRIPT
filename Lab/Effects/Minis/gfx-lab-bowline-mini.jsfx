          ka_pt(min(ka_u + 0.0005, 1)); ka_tx = ka_x; ka_ty = ka_y;
          ka_pt(max(ka_u - 0.0005, 0)); ka_tx -= ka_x; ka_ty -= ka_y;
          ka_d = sqrt(ka_tx * ka_tx + ka_ty * ka_ty); ka_tx /= ka_d; ka_ty /= ka_d;
