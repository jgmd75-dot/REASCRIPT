     : ( gfx_setfont(13); ui_col(mk_ink2); mg_ctxt(x + 22, y - 10, lbl); );
);
function mg_box(x, y, w, h, idx, menu, name) local(hov, n, i, v, tw, th) (
  v = slider(idx) | 0;
