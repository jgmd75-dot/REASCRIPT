  ui_col(mk_ink2); gfx_triangle((x + w - 14) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 6) * sc, (y + h * 0.5 - 2.5) * sc, (x + w - 10) * sc, (y + h * 0.5 + 2.5) * sc);
  pressed && hov && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#mg_dm, ""); n = pk_pcount(menu); i = 1;
    loop(n, i == v + 1 ? strcat(#mg_dm, "!"); strcat(#mg_dm, pk_pitem(menu, i, #mg_dt)); i < n ? strcat(#mg_dm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#mg_dm);
    i > 0 ? ( slider(idx) = i - 1; ui_auto(idx); );
  );
);
#tq_mlo = "20 Hz|30 Hz|60 Hz|100 Hz|150 Hz";
#tq_mlm = "150 Hz|220 Hz|330 Hz|470 Hz|680 Hz|1 kHz|1.5 kHz";
#tq_mhm = "1 kHz|1.5 kHz|2.2 kHz|3.3 kHz|4.7 kHz|6.8 kHz|10 kHz";
#tq_mhb = "3 kHz|4 kHz|5 kHz|8 kHz|10 kHz|12 kHz|16 kHz";
#tq_mha = "5 kHz|10 kHz|20 kHz";
function mg_grey(x, y, w, h) ( slider21 < 0.5 ? ( ui_cola(mk_sub, 0.55); mg_r(x, y, w, h); ); );
function mg_mid(x, n) local(cx) (
  cx = x + 56;
  mg_sub(x, 76, 112, 266, n ? "03" : "02", n ? "HI MID" : "LO MID", n ? 0x8FD39A : 0x8EC6F0);
  mg_box(cx - 42, 136, 84, 26, n ? 8 : 5, n ? #tq_mhm : #tq_mlm, "FREQ");
