desc:TransEQ Mini [program EQ] (GFX Lab)
//tags: equaliser eq passive program transformer hybrid iron
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power

slider1:0<0,1,1{Off,On}>-Bypass
slider2:2<0,4,1{20 Hz,30 Hz,60 Hz,100 Hz,150 Hz}>-Low frequency
slider3:0<0,10,0.1>-Low boost
slider4:0<0,10,0.1>-Low atten
slider5:3<0,6,1{150 Hz,220 Hz,330 Hz,470 Hz,680 Hz,1 kHz,1.5 kHz}>-Lo mid frequency
slider6:0<-12,12,0.1>-Lo mid gain (dB)
slider7:0<0,1,1{Wide,Narrow}>-Lo mid Q
slider8:3<0,6,1{1 kHz,1.5 kHz,2.2 kHz,3.3 kHz,4.7 kHz,6.8 kHz,10 kHz}>-Hi mid frequency
slider9:0<-12,12,0.1>-Hi mid gain (dB)
slider10:0<0,1,1{Wide,Narrow}>-Hi mid Q
slider11:4<0,6,1{3 kHz,4 kHz,5 kHz,8 kHz,10 kHz,12 kHz,16 kHz}>-High boost frequency
slider12:0<0,10,0.1>-High boost
slider13:5<0,10,0.1>-High bandwidth
slider14:1<0,2,1{5 kHz,10 kHz,20 kHz}>-High atten frequency
slider15:0<0,10,0.1>-High atten
slider16:20<20,500,1>-HPF (Hz, 20 = off)
slider17:20000<2000,20000,10>-LPF (Hz, 20000 = off)
slider18:3<0,10,0.1>-Iron in
slider19:3<0,10,0.1>-Iron out
slider20:0<-12,12,0.1>-Output (dB)
slider21:1<0,1,1{Out,In}>-EQ in
slider22:0<-24,12,0.1>-Input trim (dB)
slider23:1<0,1,1{Off,On}>-Input guard
slider24:50<0,100,1>-Drift (%)
slider25:0<0,2,1{1x,2x,4x}>-Oversampling
slider26:prs_sel=0<0,12,1{No preset,Init,Low Trick,Kick Thump,Bass Warmth,Vocal Air,Vocal Presence,Guitar Bite,Drum Bus Snap,Master Sheen,Dark Vintage,Mid Scoop,Iron Colour Only}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-transeq-mini";
ext_noinit = 1;

function bq_set(type, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  w0 = 2 * $pi * min(f, tq_fs * 0.45) / tq_fs; cw = cos(w0); sw = sin(w0); al = sw / (2 * q);
  amp = 10 ^ (gdb / 40);
  type == 0 ? (
    n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 1 ? (
    n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 2 ? (
    n = 1 + al / amp; b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = b1; a2 = (1 - al / amp) / n;
  ) : type == 3 ? (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n; b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n; a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;
    a2 = ((amp + 1) - (amp - 1) * cw - sa) / n;
  ) : (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n; b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n; a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;
    a2 = ((amp + 1) + (amp - 1) * cw - sa) / n;
  );
);
function bq_thru() instance(b0, b1, b2, a1, a2) ( b0 = 1; b1 = 0; b2 = 0; a1 = 0; a2 = 0; );
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function bq_z() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function xf_tanh(x) local(e) ( x = max(-20, min(20, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function xf_init() instance(ph, sp) ( ph = 0; sp = 0; );
function xf_run(x, k) instance(ph, sp) local(s, y) (
  x = min(max(x, -1.2), 1.2);
  ph = ph * xf_lk + x * xf_c;
  ph = min(max(ph, -4.0), 4.0);
  s = xf_tanh(ph * k) / k;
  y = (s - sp * xf_lk) / xf_c;
  sp = s;
  y;
);

function eq_set(fm, gm) instance(hp, lp, lb, la, m1, m2, hb, ha) (
  slider16 <= 20.5 ? hp.bq_thru() : hp.bq_set(1, slider16, 0.7071, 0);
  slider17 >= 19990 ? lp.bq_thru() : lp.bq_set(0, slider17, 0.7071, 0);
  lb.bq_set(4, low_f * fm, 1.1, eq_on * low_b * gm);
  la.bq_set(4, low_f * fm, 0.3, -eq_on * low_a * gm);
  m1.bq_set(2, lm_f * fm, lm_q * (1 + abs(lm_g) / 8), eq_on * lm_g * gm);
  m2.bq_set(2, hm_f * fm, hm_q * (1 + abs(hm_g) / 8), eq_on * hm_g * gm);
  hb.bq_set(2, hb_f * fm, hb_q, eq_on * hb_g * gm);
  ha.bq_set(3, ha_f * fm, 0.6, -eq_on * ha_g * gm);
);
function eq_run(x) instance(hp, lp, lb, la, m1, m2, hb, ha) (
  ha.bq_run(hb.bq_run(m2.bq_run(m1.bq_run(la.bq_run(lb.bq_run(lp.bq_run(hp.bq_run(x))))))));
);
function eq_z() instance(hp, lp, lb, la, m1, m2, hb, ha) (
  hp.bq_z(); lp.bq_z(); lb.bq_z(); la.bq_z(); m1.bq_z(); m2.bq_z(); hb.bq_z(); ha.bq_z();
);

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(tq_ol, FZ_1); h1 = zA2.fz_bq(tq_or, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(tq_ol), abs(tq_or)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (xf_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (xf_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  tq_ol += g * e0; tq_or += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);

function tq_os(xl, xr) (
  tq_ol = xiL.xf_run(xl, k_in); tq_or = xiR.xf_run(xr, k_in);
  tq_ol = eL.eq_run(tq_ol); tq_or = eR.eq_run(tq_or);
  tq_ol = min(max(tq_ol * out_s, -1.5), 1.5);
  tq_or = min(max(tq_or * out_s, -1.5), 1.5);
  tq_ol = xoL.xf_run(tq_ol, k_out); tq_or = xoR.xf_run(tq_or, k_out);
  tq_ol = min(max(tq_ol, -2.0), 2.0);
  tq_or = min(max(tq_or, -2.0), 2.0);
  fz_o > 0.0001 ? fz_run();
);
function tq_rate() (
  tq_fs = srate * os_f;
  xf_c = 2 * $pi * 40 / tq_fs; xf_lk = 1 - 2 * $pi * 5 / tq_fs;
);
function tq_coefs() (
  eL.eq_set(1 + 0.015 * drift * vfL, 1 + 0.03 * drift * vgL);
  eR.eq_set(1 + 0.015 * drift * vfR, 1 + 0.03 * drift * vgR);
);
function tq_clear() (
  xiL.xf_init(); xiR.xf_init(); xoL.xf_init(); xoR.xf_init();
  eL.eq_z(); eR.eq_z(); fz_clr();
);
function tq_reset() (
  tq_clear();
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  memset(BY_BUF, 0, 2 * BY_N);
  tq_fi = 0;
);

function update() (
  low_f = slider2 == 0 ? 20 : slider2 == 1 ? 30 : slider2 == 2 ? 60 : slider2 == 3 ? 100 : 150;
  lm_f = slider5 == 0 ? 150 : slider5 == 1 ? 220 : slider5 == 2 ? 330 : slider5 == 3 ? 470 : slider5 == 4 ? 680 : slider5 == 5 ? 1000 : 1500;
  hm_f = slider8 == 0 ? 1000 : slider8 == 1 ? 1500 : slider8 == 2 ? 2200 : slider8 == 3 ? 3300 : slider8 == 4 ? 4700 : slider8 == 5 ? 6800 : 10000;
  hb_f = slider11 == 0 ? 3000 : slider11 == 1 ? 4000 : slider11 == 2 ? 5000 : slider11 == 3 ? 8000 : slider11 == 4 ? 10000 : slider11 == 5 ? 12000 : 16000;
  ha_f = slider14 == 0 ? 5000 : slider14 == 1 ? 10000 : 20000;
  lm_q = slider7 ? 1.6 : 0.6; hm_q = slider10 ? 1.6 : 0.6;
  hb_q = 2.5 * 0.16 ^ (slider13 / 10);
  k_in  = 0.25 * 10 ^ (slider18 / 10);
  k_out = 0.25 * 10 ^ (slider19 / 10);
  out_t = 10 ^ (slider20 / 20);
  drift_macro(slider24);
  drift = 0.25 * dm_a; dspd = 0.25 * dm_s;
  in_setup(slider22, slider23);
);

dFL.drift_init(0.8 + rand(1) * 0.5); dFR.drift_init(0.8 + rand(1) * 0.5);
dGL.drift_init(0.8 + rand(1) * 0.5); dGR.drift_init(0.8 + rand(1) * 0.5);
in_init();
sm = 1 - exp(-1 / (0.03 * srate));
tq_fis = 1 / (0.01 * srate);
update();
low_b = slider3 * 1.4; low_a = slider4 * 1.3; lm_g = slider6; hm_g = slider9; hb_g = slider12 * 1.6; ha_g = slider15 * 1.6;
eq_on = slider21; out_s = out_t;
vfL = vfR = vgL = vgR = 0;
fz_o = 0; tq_fi = 1;
os_design();
os_f = os_tf = os_f2n(slider25); os_base = 0;
os_gsetup();
tq_rate(); fz_coefs(tq_fs); tq_clear(); tq_coefs();
pwr_init(); pwr_wu_loss = 0.5; pwr_wu_drv = 1; pwr_wu_lp = 10000; pwr_bloom = 0.1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function tq_p(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s) (
  slider(2) = a; slider(3) = b; slider(4) = c; slider(5) = d; slider(6) = e; slider(7) = f; slider(8) = g; slider(9) = h;
  slider(10) = i; slider(11) = j; slider(12) = k; slider(13) = l; slider(14) = m; slider(15) = n; slider(16) = o;
  slider(17) = p; slider(18) = q; slider(19) = r; slider(20) = s;
);
#tq_pm = "Init|Low Trick|Kick Thump|Bass Warmth|Vocal Air|Vocal Presence|Guitar Bite|Drum Bus Snap|Master Sheen|Dark Vintage|Mid Scoop|Iron Colour Only";
function load_preset(p) local(i) (
  p == 1 ?  tq_p(2, 0, 0, 3,  0, 0, 3, 0,   0, 4, 0,   5, 1, 0, 20, 20000, 3, 3,  0);
  p == 2 ?  tq_p(2, 5, 4, 3,  0, 0, 3, 0,   0, 4, 0,   5, 1, 0, 20, 20000, 3, 3,  0.7);
  p == 3 ?  tq_p(2, 4, 0, 3,  0, 0, 3, 3,   0, 4, 0,   5, 1, 0, 20, 20000, 3, 3, -1);
  p == 4 ?  tq_p(3, 4, 0, 1,  2, 0, 3, 0,   0, 4, 0,   5, 1, 0, 20, 20000, 3, 3, -2.4);
  p == 5 ?  tq_p(2, 0, 0, 3,  0, 0, 3, 0,   0, 5, 4,   7, 1, 0, 20, 20000, 3, 3,  0);
  p == 6 ?  tq_p(2, 0, 0, 3,  0, 0, 3, 3,   0, 4, 3,   5, 1, 0, 20, 20000, 3, 3,  0);
  p == 7 ?  tq_p(2, 0, 0, 2, -3, 0, 2, 3.5, 0, 4, 0,   5, 1, 0, 20, 20000, 3, 3,  0);
  p == 8 ?  tq_p(2, 4, 3, 3,  0, 0, 3, 0,   0, 3, 3,   5, 1, 0, 20, 20000, 5, 5,  0);
  p == 9 ?  tq_p(1, 2, 0, 3,  0, 0, 3, 0,   0, 6, 2.5, 8, 1, 0, 20, 20000, 3, 3,  0);
  p == 10 ? tq_p(2, 0, 0, 3,  0, 0, 3, 0,   0, 4, 0,   5, 1, 5, 20, 20000, 6, 6,  0);
  p == 11 ? tq_p(2, 0, 0, 3, -5, 1, 3, 0,   0, 4, 0,   5, 1, 0, 20, 20000, 3, 3,  0);
  p == 12 ? tq_p(2, 0, 0, 3,  0, 0, 3, 0,   0, 4, 0,   5, 1, 0, 20, 20000, 7, 7,  0);
  i = 2; loop(19, ui_auto(i); i += 1; );
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(25, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); update();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
prs_chk();
update();
os_snap(slider(25));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
update();
srate != tq_sr ? ( tq_sr = srate; sm = 1 - exp(-1 / (0.03 * srate)); tq_fis = 1 / (0.01 * srate); in_init(); os_gsetup(); tq_rate(); fz_coefs(tq_fs); );
tq_now = time_precise();
tq_tp > 0 && tq_now - tq_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > tq_gpp && play_position - tq_gpp < 4 * tq_gpd + 0.05) ? tq_reset();
tq_tp = tq_now; tq_gpp = play_position; tq_gpd = samplesblock / srate;
pwr_block(slider1 < 0.5);
os_tf = os_f2n(slider25);
bs = 1 - exp(-samplesblock / (0.03 * srate));
low_b += (slider3 * 1.4 - low_b) * bs; low_a += (slider4 * 1.3 - low_a) * bs;
lm_g += (slider6 - lm_g) * bs; hm_g += (slider9 - hm_g) * bs;
hb_g += (slider12 * 1.6 - hb_g) * bs; ha_g += (slider15 * 1.6 - ha_g) * bs;
eq_on += (slider21 - eq_on) * bs;
dinc = dspd * samplesblock / srate;
vfL = dFL.drift_tick(dinc); vfR = dFR.drift_tick(dinc);
vgL = dGL.drift_tick(dinc); vgR = dGR.drift_tick(dinc);
tq_coefs();
fz_t = 0.33 * min(max((hb_g * eq_on - 6.4) / 9.6, 0), 1);
fz_o += (fz_t - fz_o) * bs;  abs(fz_o - fz_t) < 0.000001 ? fz_o = fz_t;
pdc_delay = os_lat(os_f); pdc_bot_ch = 0; pdc_top_ch = 2;
tq_ml_d = max(tq_ml_d, tq_pkl); tq_mr_d = max(tq_mr_d, tq_pkr); tq_pk_d = max(tq_pk_d, max(tq_pkl, tq_pkr)); tq_pkl = tq_pkr = 0;
os_snapb(slider(25));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
l = min(max(in_l, -1.2), 1.2);
r = min(max(in_r, -1.2), 1.2);
pwr_in(l, r); l = pwr_l; r = pwr_r;
out_s += (out_t - out_s) * sm;
os_gate();
os_chg ? ( tq_rate(); fz_coefs(tq_fs); tq_clear(); tq_coefs(); );
uxL.os_up(l); uxR.os_up(r);
os_f == 1 ? (
  tq_os(uxL.s0, uxR.s0); l = tq_ol; r = tq_or;
) : (
  tq_os(uxL.s0, uxR.s0); tq_a0 = tq_ol; tq_r0 = tq_or;
  tq_os(uxL.s1, uxR.s1); tq_a1 = tq_ol; tq_r1 = tq_or;
  os_f == 2 ? ( l = dnL.os_dn(tq_a0, tq_a1, 0, 0); r = dnR.os_dn(tq_r0, tq_r1, 0, 0); ) : (
    tq_os(uxL.s2, uxR.s2); tq_a2 = tq_ol; tq_r2 = tq_or;
    tq_os(uxL.s3, uxR.s3); tq_a3 = tq_ol; tq_r3 = tq_or;
    l = dnL.os_dn(tq_a0, tq_a1, tq_a2, tq_a3); r = dnR.os_dn(tq_r0, tq_r1, tq_r2, tq_r3);
  );
);
pwr_out(l, r); l = pwr_l; r = pwr_r;
tq_osg = os_g * os_g * (3 - 2 * os_g);
l *= tq_osg; r *= tq_osg;
l != l ? l = 0; r != r ? r = 0;
tq_fi < 1 ? (
  tq_fi = min(tq_fi + tq_fis, 1); tq_z = tq_fi * tq_fi * (3 - 2 * tq_fi);
  tq_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; tq_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  l = tq_a + (l - tq_a) * tq_z; r = tq_b + (r - tq_b) * tq_z;
);
spl0 = l; spl1 = r;
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
by_out();
tq_pkl = max(tq_pkl, abs(spl0)); tq_pkr = max(tq_pkr, abs(spl1));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0x27282B; mk_band = 0x0B0C0D; mk_ink = 0xEDE3C8; mk_tab = 0x5B8ED8; mk_tabink = 0xEDE3C8;
mk_sub = 0x333437; mk_hot = 0xFFC86A;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.3);
mk_blu = 0x5BCEFA; mk_pnk = 0xF5A9B8;
sc != mg_fsc ? (
