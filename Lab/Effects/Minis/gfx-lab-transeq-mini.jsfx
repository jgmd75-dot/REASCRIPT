function mg_led_col(d) ( d <= -30 ? 0x3A9CFF : d <= -15 ? 0x3CE05A : d <= -6 ? 0xFFC81E : d <= 0 ? 0xFF8A1E : 0xFF3A2A; );
function mg_vmeter(x, y, w, h) local(i, d, c, col, lv, hd, cx, cy, p) (
  ui_cola(0x000000, 0.35); mg_r(x - 6, y - 6, w + 12, h + 12);
