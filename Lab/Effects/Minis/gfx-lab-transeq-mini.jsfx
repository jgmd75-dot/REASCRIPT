    gfx_setfont(11); ui_col(mk_ink2); mg_ctxt(cx, y + 11, col ? "R" : "L");
    i = 0; loop(16,
      d = 3 - i * 3; c = mg_led_col(d); cy = y + 28 + i * p;
      ui_col(0x050506); mg_disc(cx, cy, 5);
      lv >= d - 1.5 || (hd >= d - 1.5 && hd < d + 1.5 && hd > -42) || (i == 0 && mg_pon) ? (
        ui_cola(c, 0.22); mg_disc(cx, cy, 7); ui_col(c); mg_disc(cx, cy, 3.8); ui_cola(0xFFFFFF, 0.5); mg_disc(cx - 1.2, cy - 1.2, 1.2);
      ) : ( ui_col(ui_mix(c, 0x101214, 0.78)); mg_disc(cx, cy, 3.8); );
