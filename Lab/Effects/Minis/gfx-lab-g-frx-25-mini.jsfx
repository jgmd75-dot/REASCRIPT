function tok_level(a, b) local(i, c, k, pcl, cl, h, t, j) (
  NT = 0; pcl = 0; str_setlen(#sq, max(b - a, 0)); k = 0; i = a;
  while (i < b) (
    c = PCH[i];
    cl = !isalnum(c) ? 0 : isdig(c) ? 1 : c >= 65 && c <= 90 ? 3 : 2;
    cl > 0 ? ( str_setchar(#sq, k, c, 'cu'); k += 1; );
    cl == 0 || pcl == 0 || (cl == 1) != (pcl == 1) || (pcl == 2 && cl == 3) ? (
      NT > 0 && T_E[NT - 1] < 0 ? T_E[NT - 1] = i;
      cl > 0 && NT < 48 ? ( T_S[NT] = i; T_E[NT] = -1; NT += 1; );
    );
    pcl = cl; i += 1;
  );
  NT > 0 && T_E[NT - 1] < 0 ? T_E[NT - 1] = b;
  str_setlen(#sq, k);
  t = 0;
  loop(NT,
    h = 0; j = T_S[t]; loop(T_E[t] - T_S[t], h = hmix(h, lc(PCH[j])); j += 1; ); T_H[t] = h;
    t += 1;
  );
  t = 0;
  loop(NT - 1, h = T_H[t]; j = T_S[t + 1]; loop(T_E[t + 1] - T_S[t + 1], h = hmix(h, lc(PCH[j])); j += 1; ); T_B[t] = h; t += 1; );
  NT > 0 ? T_B[NT - 1] = -1;
);
function in_list(lst, n, h) local(i, f) ( f = 0; i = 0; loop(n, lst[i] == h ? f = 1; i += 1; ); f; );
function sc_level(a, b, lw) local(r, t, hit, c, i) (
  tok_level(a, b);
  memset(LSC, 0, NC);
  r = 0;
  loop(NR,
    hit = 0;
    R_X[r] ? ( t = 0; while (!hit && t < NT) ( (T_H[t] == R_H[r] || T_B[t] == R_H[r]) ? hit = 1; t += 1; ); )
           : ( strlen(#sq) ? hit = matchi(500 + r, #sq); );
    hit ? ( c = R_C[r]; LSC[c] = max(LSC[c], R_W[r]); );
    r += 1;
  );
  t = 0;
  loop(NT,
    (in_list(LWH, NLW, T_H[t]) || in_list(LWH, NLW, T_B[t])) ? lpev += lw;
    in_list(OWH, NOW, T_H[t]) ? lpev -= lw;
    t += 1;
  );
  i = 0; loop(NC, CS[i] += LSC[i] * lw; i += 1; );
);
function tok_num(t) local(v, j) ( v = 0; j = T_S[t]; loop(T_E[t] - T_S[t], v = v * 10 + PCH[j] - 48; j += 1; ); v; );
function tok_isnum(t) ( isdig(PCH[T_S[t]]); );
function parse_notes(a, b) local(i, c, st, e, semi, k, n, oct, neg, ok, prevkey) (
  knote = -1; kkey = 0; i = a; prevkey = 0;
  while (i < b) (
    while (i < b && ((c = PCH[i]) == 32 || c == 95 || c == 45 || c == 46 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44)) ( i += 1; );
    st = i;
    while (i < b && !((c = PCH[i]) == 32 || c == 95 || c == 45 || c == 46 || c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 44)) ( i += 1; );
    e = i;
    e > st ? (
      c = lc(PCH[st]);
      c >= 97 && c <= 103 ? (
        semi = c == 97 ? 9 : c == 98 ? 11 : c == 99 ? 0 : c == 100 ? 2 : c == 101 ? 4 : c == 102 ? 5 : 7;
        k = st + 1;
        k < e && PCH[k] == 35 ? ( semi += 1; k += 1; ) : k < e && PCH[k] == 98 ? ( semi -= 1; k += 1; );
        semi = (semi + 12) % 12;
        n = e - k;
        n == 0 ? ( prevkey ? kkey = semi + 1; ) :
        n == 1 && lc(PCH[k]) == 109 ? kkey = semi + 13 :
        n == 3 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 105 && lc(PCH[k + 2]) == 110 ? kkey = semi + 13 :
        n == 5 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 105 && lc(PCH[k + 2]) == 110 ? kkey = semi + 13 :
        n == 3 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 97 && lc(PCH[k + 2]) == 106 ? kkey = semi + 1 :
        n == 5 && lc(PCH[k]) == 109 && lc(PCH[k + 1]) == 97 && lc(PCH[k + 2]) == 106 ? kkey = semi + 1 :
        n <= 2 && e - st >= 2 ? (
          ok = 1; neg = 0; oct = 0;
          PCH[k] == 45 ? ( neg = 1; k += 1; n -= 1; );
          n == 0 ? ok = 0;
          loop(n, isdig(PCH[k]) ? oct = oct * 10 + PCH[k] - 48 : ok = 0; k += 1; );
          ok ? ( oct = neg ? -oct : oct; (oct + 2) * 12 + semi >= 0 && (oct + 2) * 12 + semi < 128 ? knote = (oct + 2) * 12 + semi; );
        );
      );
      prevkey = e - st == 3 && lc(PCH[st]) == 107 && lc(PCH[st + 1]) == 101 && lc(PCH[st + 2]) == 121;
    );
  );
);
function bestof(lo, hi) local(c, bs) ( bs = 0; bcls = 19; c = lo; loop(hi - lo + 1, CS2[c] > bs ? ( bs = CS2[c]; bcls = c; ); c += 1; ); bs; );
function classify(i) local(o, nst, ext, rst, b, a, lw, t, v, inst, drumkw, fxkw, perckw, drum, perc, bs, ss, c, best, lpe) (
  o = L_OFF[i]; nst = L_NST[i]; ext = L_EXT[i]; rst = L_RST[i];
  memset(CS, 0, NC); lpev = 0; kbpm = 0;
  sc_level(o + nst, o + ext, 1);
  t = 0;
  loop(NT,
    T_H[t] == H_BPM ? (
      t > 0 && tok_isnum(t - 1) && (v = tok_num(t - 1)) >= 40 && v <= 300 ? kbpm = v :
      t < NT - 1 && tok_isnum(t + 1) && (v = tok_num(t + 1)) >= 40 && v <= 300 ? kbpm = v;
    );
    t += 1;
  );
  ntok_stem = NT; t = 0; loop(NT, T_S[48 + t] = T_S[t]; T_E[48 + t] = T_E[t]; t += 1; );
  parse_notes(o + nst, o + ext);
  lw = 0.7; b = nst - 1;
  while (b > rst) (
    a = b; while (a > rst && !issep(PCH[o + a - 1])) ( a -= 1; );
    sc_level(o + a, o + b, lw);
    lw = max(0.15, lw * 0.7); b = a - 1;
  );
  kbpm == 0 && lpev > 0 ? (
    t = 0;
    loop(ntok_stem,
      kbpm == 0 && isdig(PCH[T_S[48 + t]]) && T_E[48 + t] - T_S[48 + t] >= 2 && T_E[48 + t] - T_S[48 + t] <= 3 ? (
        v = 0; a = T_S[48 + t]; loop(T_E[48 + t] - a, v = v * 10 + PCH[a] - 48; a += 1; );
        v >= 70 && v <= 190 ? kbpm = v;
      );
      t += 1;
    );
  );
  lpe = min(max(lpev, -2), 2) + (kbpm > 0 ? 0.7 : 0);
  L_KIND[i] = lpe > 0;
  c = 0; loop(NC, CS2[c] = min(2, CS[c]); c += 1; );
  ss = 0;
  L_KIND[i] ? (
    inst = bestof(10, 17); best = bcls;
    drumkw = CS[8] + CS[9]; c = 0; loop(8, drumkw += CS[c]; c += 1; );
    fxkw = CS[18];
    fxkw > inst && fxkw > drumkw ? ( best = 18; bs = fxkw; ) :
    inst > 0.5 && inst > drumkw ? ( bs = inst; ) : (
      perckw = CS[9] + CS[7] + 0.5 * (CS[3] + CS[4]);
      drum = CS2[8] + CS[0] + CS[1];
      perc = CS2[9] + perckw;
      best = perc > drum ? 9 : 8; bs = max(perc, drum); ss = min(perc, drum);
    );
  ) : (
    CS2[8] = CS2[9] = 0;
    bs = bestof(0, 18); best = bcls;
    c = 0; loop(19, c != best ? ss = max(ss, CS2[c]); c += 1; );
  );
  bs <= 0.05 ? best = 19;
  L_ACAT[i] = L_CAT[i] = best;
  L_CONF[i] = best == 19 ? 0 : min(1, max(0, 0.5 * (bs > 0 ? (bs - ss) / bs : 0) + 0.5 * min(1, bs / 1.2)));
  L_BPM[i] = kbpm; L_NOTE[i] = knote; L_KEY[i] = kkey;
);

function lib_open() (
  lib_h >= 0 ? file_close(lib_h);
  NL = 0; pch_n = 0; root_len = 0; nfold = 0; NFK = 0; srt_i = 0; NROOT = 0;
  lib_h = file_open("gfx-frx-25/library.txt");
  lib_h >= 0 ? ( file_text(lib_h); lib_st = 1; ) : lib_st = -1;
);
function lib_read(tmax) local(len, c, k, o, nst, ext, d, same, j, h1, h2) (
  while (lib_st == 1 && time_precise() < tmax) (
    file_string(lib_h, #wln) > 0 ? (
      len = strlen(#wln);
      while (len > 0 && ((c = str_getchar(#wln, len - 1, 'cu')) == 10 || c == 13 || c == 32)) ( len -= 1; );
      len > 6 && !strncmp(#wln, "#root ", 6) ? (
        root_len = len - 6;
        NROOT < 32 ? ( strcpy_substr(950 + NROOT, #wln, 6, len - 6); NROOT += 1; );
      ) :
      len > 0 && str_getchar(#wln, 0) != 35 && NL < LN && pch_n + len < PCHMAX ? (
        o = pch_n; nst = 0; ext = len; h1 = h2 = 0; k = 0;
        loop(len,
          c = str_getchar(#wln, k, 'cu'); PCH[o + k] = c;
          issep(c) ? ( nst = k + 1; ext = len; ) : c == 46 ? ext = k;
          h1 = hmix(h1, lc(c)); h2 = hmix2(h2, lc(c));
          k += 1;
        );
        nst > 0 ? (
          ext <= nst ? ext = len;
          L_OFF[NL] = o; L_LEN[NL] = len; L_NST[NL] = nst; L_EXT[NL] = ext; L_RST[NL] = min(root_len + 1, nst);
          L_H1[NL] = h1; L_H2[NL] = h2; L_CAT[NL] = L_ACAT[NL] = 19; L_KIND[NL] = 0; L_BPM[NL] = 0; L_NOTE[NL] = -1;
          L_KEY[NL] = 0; L_CONF[NL] = 0; L_USR[NL] = -1;
          same = NL > 0 && L_NST[NL - 1] == nst;
          j = 0; while (same && j < nst) ( PCH[L_OFF[NL - 1] + j] != PCH[o + j] ? same = 0; j += 1; );
          same ? ( d = L_DIR[NL - 1]; F_N[d] += 1; ) : nfold < 4096 ? (
            d = nfold; nfold += 1; F_FIRST[d] = NL; F_N[d] = 1;
          ) : ( d = nfold - 1; );
          L_DIR[NL] = d;
          pch_n += len; NL += 1;
        );
      );
    ) : ( file_close(lib_h); lib_h = -1; lib_st = 2; srt_i = 0; );
  );
);
function folders_scan() local(i, d, c, m, k, j, t) (
  memset(F_MASK, 0, nfold); memset(F_COV, 0, nfold);
  i = 0;
  loop(NL, c = L_CAT[i]; c < 8 && !L_KIND[i] ? F_MASK[L_DIR[i]] |= 2 ^ c; i += 1; );
  NFK = 0; d = 0;
  loop(nfold,
    m = F_MASK[d]; k = 0; loop(8, m & 1 ? k += 1; m = floor(m / 2); ); F_COV[d] = k;
    k >= 3 && NFK < 400 ? ( KLIST[NFK] = d; NFK += 1; );
    d += 1;
  );
  i = 1;
  loop(max(NFK - 1, 0),
    t = KLIST[i]; j = i - 1;
    while (j >= 0 && (F_COV[KLIST[j]] < F_COV[t] || (F_COV[KLIST[j]] == F_COV[t] && F_N[KLIST[j]] < F_N[t]))) ( KLIST[j + 1] = KLIST[j]; j -= 1; );
    KLIST[j + 1] = t; i += 1;
  );
);
function pcmp(a0, a1, b0, b1) local(r, k, ca, cb) (
  r = 0; k = 0;
  while (r == 0 && k < a1 - a0 && k < b1 - b0) ( ca = lc(PCH[a0 + k]); cb = lc(PCH[b0 + k]); ca < cb ? r = -1 : ca > cb ? r = 1; k += 1; );
  r == 0 ? r = a1 - a0 < b1 - b0 ? -1 : a1 - a0 > b1 - b0 ? 1 : 0;
  r;
);
function srt_cmp(a, b) local(r) (
  r = srt_col == 1 ? pcmp(L_OFF[a] + L_NST[a], L_OFF[a] + L_LEN[a], L_OFF[b] + L_NST[b], L_OFF[b] + L_LEN[b]) :
      srt_col == 7 ? pcmp(L_OFF[a] + L_RST[a], L_OFF[a] + L_LEN[a], L_OFF[b] + L_RST[b], L_OFF[b] + L_LEN[b]) :
      srt_col == 2 ? sign(L_CAT[a] - L_CAT[b]) : srt_col == 3 ? sign(L_KIND[a] - L_KIND[b]) :
      srt_col == 4 ? sign(L_BPM[a] - L_BPM[b]) : srt_col == 5 ? sign(L_NOTE[a] - L_NOTE[b]) : 0;
  srt_fwd ? r : -r;
);
function view_sort() local(w, lo, mid, hi, i, j, k) (
  srt_col > 0 ? (
    w = 1;
    while (w < VN) (
      lo = 0;
      while (lo < VN) (
        mid = min(lo + w, VN); hi = min(lo + 2 * w, VN); i = lo; j = mid; k = lo;
        while (k < hi) (
          i < mid && (j >= hi || srt_cmp(VIEW[j], VIEW[i]) >= 0) ? ( VTMP[k] = VIEW[i]; i += 1; ) : ( VTMP[k] = VIEW[j]; j += 1; );
          k += 1;
        );
        memcpy(VIEW + lo, VTMP + lo, hi - lo);
        lo += 2 * w;
      );
      w *= 2;
    );
  );
);
function view_build() local(i, ok, n, k, st, nw) (
  VN = 0; i = 0;
  nw = 0; n = strlen(#srch); k = 0;
  while (k < n && nw < 8) (
    while (k < n && str_getchar(#srch, k) == 32) ( k += 1; );
    st = k; while (k < n && str_getchar(#srch, k) != 32) ( k += 1; );
    k > st ? ( strcpy_substr(#sw, #srch, st, k - st); strcpy(990 + nw, "*"); strcat(990 + nw, #sw); strcat(990 + nw, "*"); nw += 1; );
  );
  loop(NL,
    ok = bcat == 20 || L_CAT[i] == bcat;
    ok && nw > 0 ? (
      pstr(L_OFF[i] + L_RST[i], L_OFF[i] + L_LEN[i], #vp);
      k = 0; while (ok && k < nw) ( ok = matchi(990 + k, #vp) || matchi(990 + k, clong(L_CAT[i])); k += 1; );
    );
    ok ? ( VIEW[VN] = i; VN += 1; );
    i += 1;
  );
  view_sort();
  b_top = min(b_top, max(VN - 1, 0)); b_sel >= VN ? b_sel = -1;
);
function kit_pick(a, n, c, kpt, rnd) local(i, s, b1, b2, b3, s1, s2, s3, u, used, k) (
  b1 = b2 = b3 = -1; s1 = s2 = s3 = -1; i = a;
  loop(n,
    L_CAT[i] == c && !L_KIND[i] ? (
      used = 0; u = 0; loop(NP, KU[u] == i ? used = 1; u += 1; );
      !used ? (
        s = L_CONF[i] + (kpt ? ( lstem(i, #kp); matchi(kpt, #kp) ? 1 : 0 ) : 0);
        s > s1 ? ( b3 = b2; s3 = s2; b2 = b1; s2 = s1; b1 = i; s1 = s; ) :
        s > s2 ? ( b3 = b2; s3 = s2; b2 = i; s2 = s; ) : s > s3 ? ( b3 = i; s3 = s; );
      );
    );
    i += 1;
  );
  k = rnd ? floor(rand((b3 >= 0 ? 3 : b2 >= 0 ? 2 : 1))) : 0;
  k == 2 ? b3 : k == 1 ? b2 : b1;
);
function fwant(p) (
  p == 0 ? 0 : p == 1 ? 1 : p == 2 || p == 3 ? 7 : p <= 7 ? 6 : p == 8 || p == 9 ? 3 : p == 10 ? 4 : p <= 13 ? 5 :
  p == 14 ? 5 : p == 15 ? 2 : 7;
);
function fpat(p) (
  p == 2 ? "*rim*" : p == 3 ? "*stick*" : p == 4 ? "*hi*" : p == 5 ? "*mid*" : p == 6 ? "*lo*" : p == 7 ? "*floor*" :
  p == 9 ? "*pedal*" : p == 11 || p == 12 ? "*crash*" : p == 13 ? "*ride*" : p == 14 ? "*bell*" : 0;
);
function fallback(c) ( c == 2 ? 1 : c == 4 ? 5 : c == 5 ? 4 : c == 7 ? 2 : c == 6 ? 7 : -1; );
function pad_assign(p, i, play) (
  ppm_set(p, i); CHP[p * 8] = L_CAT[i];
  LPLAY[p] = play; LREQ[p] += 1;
);
function pad_clear(p) ( PPM[p * PSZ] = 0; CHP[p * 8] = -1; LREQ[p] += 1; );
function kit_build(d, rnd) local(p, q, c, i, sim) (
  NFK > 0 && d < 0 ? (
    sim = 0; while (sim + 1 < NFK && F_COV[KLIST[sim + 1]] >= F_COV[KLIST[0]] - 1) ( sim += 1; );
    kit_cur = rnd ? floor(rand(sim + 1)) + 1 : 1;
    d = KLIST[kit_cur - 1];
  );
  memset(KU, -1, NP);
  q = 0;
  loop(NP,
    p = q == 4 ? 7 : q == 7 ? 4 : q == 8 ? 9 : q == 9 ? 8 : q == 11 ? 14 : q == 12 ? 13 : q == 13 ? 11 : q == 14 ? 12 : q;
    c = fwant(p); i = -1;
    d >= 0 ? i = kit_pick(F_FIRST[d], F_N[d], c, fpat(p), rnd);
    i < 0 ? i = kit_pick(0, NL, c, fpat(p), rnd);
    i < 0 && fallback(c) >= 0 ? (
      d >= 0 ? i = kit_pick(F_FIRST[d], F_N[d], fallback(c), 0, rnd);
      i < 0 ? i = kit_pick(0, NL, fallback(c), 0, rnd);
    );
    i >= 0 ? ( KU[p] = i; pad_assign(p, i, 0); ) : pad_clear(p);
    q += 1;
  );
);
function lib_find(p) local(i, f, h1) (
  f = -1;
  ppm_has(p) ? ( h1 = hstr(ppm_str_g(p, #psp)); i = 0; while (f < 0 && i < NL) ( L_H1[i] == h1 ? f = i; i += 1; ); );
  f;
);
function pad_step(p, dir) local(i, c, k, n, f) (
  NL > 0 ? (
    f = lib_find(p);
    c = f >= 0 ? L_CAT[f] : CHP[p * 8] >= 0 ? CHP[p * 8] : fwant(p);
    f < 0 ? f = dir > 0 ? NL - 1 : 0;
    k = f; n = 0;
    while ( k = (k + dir + NL) % NL; n += 1; L_CAT[k] != c && n < NL; );
    L_CAT[k] == c ? pad_assign(p, k, 1);
  );
);
function lib_show(p) local(i, k, c) (
  i = lib_find(p); c = i >= 0 ? L_CAT[i] : CHP[p * 8] >= 0 ? CHP[p * 8] : fwant(p);
  bcat = c; view_build(); b_sel = -1;
  i >= 0 ? ( k = 0; loop(VN, VIEW[k] == i ? b_sel = k; k += 1; ); );
  b_sel < 0 && strlen(#srch) ? ( strcpy(#srch, ""); view_build(); i >= 0 ? ( k = 0; loop(VN, VIEW[k] == i ? b_sel = k; k += 1; ); ); );
  b_top = b_sel >= 0 ? max(0, b_sel - 3) : 0;
);
function add_folder_menu() (
  gfx_showmenu("#To add a folder of your own samples:||#1. Find the action GFX FRX25 scan (ReaPack installs it with the GFX scripts),|#    or load GFX FRX25 scan.lua from the Scripts folder of the download: Actions > New action > Load ReaScript...|#2. Run it and choose the folder (Yes adds it to your folders).|#3. Then choose Read the library again here.");
);
!gfx_init ? (
  gfx_init = 1;
  LB = 27500000; LN = 16384;
  L_OFF = LB; L_LEN = LB + LN; L_NST = LB + 2 * LN; L_EXT = LB + 3 * LN; L_RST = LB + 4 * LN; L_CAT = LB + 5 * LN;
  L_KIND = LB + 6 * LN; L_BPM = LB + 7 * LN; L_NOTE = LB + 8 * LN; L_CONF = LB + 9 * LN; L_DIR = LB + 10 * LN;
  L_H1 = LB + 11 * LN; L_H2 = LB + 12 * LN; L_ACAT = LB + 13 * LN; L_KEY = LB + 14 * LN; L_USR = LB + 15 * LN;
  VIEW = LB + 16 * LN;
  F_FIRST = VIEW + LN; F_N = F_FIRST + 4096; F_MASK = F_N + 4096; F_COV = F_MASK + 4096; KLIST = F_COV + 4096;
  R_H = KLIST + 4096; R_C = R_H + 512; R_W = R_C + 512; R_X = R_W + 512;
  T_S = R_X + 512; T_E = T_S + 128; T_H = T_E + 128; T_B = T_H + 128;
  CS = T_B + 128; CS2 = CS + 32; LSC = CS2 + 32; LWH = LSC + 32; OWH = LWH + 64; KU = OWH + 64;
  VTMP = KU + 64; GKM = VTMP + LN;
  PCH = GKM + 64;
  PCHMAX = 33554000 - PCH;
  NC = 20;
  lib_st = 0; lib_h = -1; NL = 0; NR = 0; bcat = 20; b_top = 0; b_sel = -1; srch_on = 0; #srch = "";
  kit_cur = 0; NROOT = 0; srt_col = 0; srt_fwd = 1; krn_on = 0; VN = 0;
);
!rl_done ? ( rl_init(); rl_done = 1; );
lib_st == 0 ? lib_open();
g_tmax = time_precise() + 0.012;
lib_st == 1 ? lib_read(g_tmax);
lib_st == 2 ? (
  while (srt_i < NL && time_precise() < g_tmax) ( classify(srt_i); srt_i += 1; );
  srt_i >= NL ? ( gi = 0; loop(NL, L_CAT[gi] = L_ACAT[gi]; gi += 1; ); folders_scan(); view_build(); lib_st = 3; );
);
lib_st == 3 && !kauto_d ? (
  kauto_d = 1; gi = 0; gn = 0; loop(NP, ppm_has(gi) ? gn += 1; gi += 1; );
  gn == 0 && NL > 0 ? kit_build(-1, 0);
);
ui_begin(900, 355);
face(slider4 | 0);
mk_face = PNL; mk_ink = INK; mk_tab = KA;
mk_band = ui_mix(PNL, 0x000000, 0.35);
mk_sub = ui_mix(GRP, 0x000000, 0.18);
mk_ink2 = ui_mix(INK, PNL, 0.22);
mk_acc = (0.299 * ((mk_sub >> 16) & 255) + 0.587 * ((mk_sub >> 8) & 255) + 0.114 * (mk_sub & 255)) / 255 > 0.5 ? ui_mix(KA, 0x000000, 0.5) : ui_mix(KA, 0xFFFFFF, 0.35);
mk_cap = 0xE8E2D2;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 15 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 13 * sc);
  mg_f7 = ui_fitarial(7, 12 * sc);
  mg_f8 = ui_fitarial(8, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(7, "Arial", mg_f7, 'bi'); gfx_setfont(8, "Arial", mg_f8, 'b');

function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
