);
function plevel_g(p) ( p == 0 ? 90 : p <= 3 ? 82 : p <= 7 ? 78 : p <= 10 ? 66 : p <= 14 ? 62 : 70; );
function ppan_g(p) (
  p == 4 ? -30 : p == 5 ? -10 : p == 6 ? 10 : p == 7 ? 30 : p >= 8 && p <= 10 ? 25 : p == 11 ? -25 : p == 12 ? 35 :
  p == 13 || p == 14 ? -30 : p >= 15 && p <= 22 ? ((p - 15) % 2 ? 20 : -20) : 0;
);
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, dink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(dink, 1); gfx_measurestr("DRIFT", tw, th);
  gfx_x = dk_ox + cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr("DRIFT");
);

function lc(c) ( c >= 65 && c <= 90 ? c + 32 : c; );
function hmix(h, c) ( h = h * 37 + c; h >= 1000000000000 ? h -= floor(h / 999999937) * 999999937; h; );
function hmix2(h, c) ( h = h * 41 + c; h >= 1000000000000 ? h -= floor(h / 999999893) * 999999893; h; );
function issep(c) ( c == 47 || c == 92; );
function isdig(c) ( c >= 48 && c <= 57; );
function isalnum(c) ( (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c >= 128; );
function hstr(s) local(h, i) ( h = 0; i = 0; loop(strlen(s), h = hmix(h, lc(str_getchar(s, i, 'cu'))); i += 1; ); h; );
function pstr(a, b, dst) local(k) (
  str_setlen(dst, max(b - a, 0)); k = 0; loop(b - a, str_setchar(dst, k, PCH[a + k], 'cu'); k += 1; ); dst;
);
function ppm_set(k, i) local(b, n, j) (
  b = PPM + k * PSZ; n = min(L_LEN[i], PSZ - 12); j = 0; loop(n, b[1 + j] = PCH[L_OFF[i] + j]; j += 1; ); b[0] = n;
);
function ppm_str_g(k, dst) local(b, n, i) (
  b = PPM + k * PSZ; n = b[0]; str_setlen(dst, n); i = 0; loop(n, str_setchar(dst, i, b[1 + i], 'cu'); i += 1; ); dst;
);
function ppm_has(k) ( PPM[k * PSZ] > 0; );
function lstem(i, dst) ( pstr(L_OFF[i] + L_NST[i], L_OFF[i] + L_EXT[i], dst); );
function sstem(src, dst) local(n, k, a, b, c) (
  n = strlen(src); a = 0; b = n; k = 0;
  loop(n, c = str_getchar(src, k, 'cu'); issep(c) ? ( a = k + 1; b = n; ); c == 46 ? b = k; k += 1; );
  strcpy_substr(dst, src, a, b - a);
);
function pad_stem(p, dst) ( ppm_has(p) ? sstem(ppm_str_g(p, #pst), dst) : strcpy(dst, ""); dst; );
function cname(c) (
  c == 0 ? "KICK" : c == 1 ? "SNARE" : c == 2 ? "CLAP" : c == 3 ? "CL HAT" : c == 4 ? "OP HAT" : c == 5 ? "CYMBAL" :
