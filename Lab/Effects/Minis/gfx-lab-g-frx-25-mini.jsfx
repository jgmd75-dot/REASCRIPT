function rl_add(cat, w, words) local(n, k, st, x, wln, h, i) (
  n = strlen(words); k = 0;
  while (k < n) (
    st = k; while (k < n && str_getchar(words, k) != 32) ( k += 1; );
    k > st && NR < 400 ? (
      x = str_getchar(words, k - 1) == 61; wln = k - st - x;
      h = 0; i = st; loop(wln, h = hmix(h, lc(str_getchar(words, i, 'cu'))); i += 1; );
      R_H[NR] = h; R_C[NR] = cat; R_W[NR] = w; R_X[NR] = x || wln < 4;
      !R_X[NR] ? ( strcpy_substr(#rw, words, st, wln); strcpy(500 + NR, "*"); strcat(500 + NR, #rw); strcat(500 + NR, "*"); );
      NR += 1;
    );
    k += 1;
  );
);
function wl_add(dst, words) local(n, k, st, h, i, cnt) (
  n = strlen(words); k = 0; cnt = 0;
