);
eq_hp ? ( oL = hpL.fq_run(oL); oR = hpR.fq_run(oR); );
eq_lf ? ( oL = lfL.fq_run(oL); oR = lfR.fq_run(oR); );
eq_md ? ( oL = mdL.fq_run(oL); oR = mdR.fq_run(oR); );
eq_hf ? ( oL = hfL.fq_run(oL); oR = hfR.fq_run(oR); );
bus2_t > 0 || BLV[2] ? ( dsL = cv2L.cv_run(BACC + 16, BHO[4]); dsR = cv2R.cv_run(BACC + 20, BHO[5]); BHO[4] = BHO[5] = 0; ) : dsL = dsR = 0;
dl_run || BLV[2] ? (
  dl_ts += (dl_tt - dl_ts) * dl_gc;
  dl_yL = dl_read(DLB, dl_ts); dl_yR = dl_read(DLB + DLN, dl_ts);
