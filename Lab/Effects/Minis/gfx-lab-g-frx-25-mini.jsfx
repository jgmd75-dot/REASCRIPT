function note_menu(cur) local(n) (
  strcpy(#nm, ""); n = 24;
  loop(73,
    n % 12 == 0 ? ( note_name(n, #nt3); strcat(#nm, cur >= n && cur < n + 12 ? ">!" : ">"); strcat(#nm, #nt3); strcat(#nm, " .. |"); );
    n % 12 == 11 || n == 96 ? strcat(#nm, "<");
    cur == n ? strcat(#nm, "!");
    note_name(n, #nnm); sprintf(#nt2, "%s  (%d)", #nnm, n); strcat(#nm, #nt2);
