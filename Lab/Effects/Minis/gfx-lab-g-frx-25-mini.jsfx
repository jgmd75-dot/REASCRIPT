desc:FRX-25 Mini [drum machine] (GFX Lab)
//tags: instrument drum machine sampler kit sequencer mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-clip, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

options:maxmem=33554432

import gfx-lab-drift.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider26:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-24,12,0.1>-Volume (dB)
slider2:0<0,16,1>-MIDI channel (0 = omni)
slider3:60<0,100,1>-Velocity (%)
slider4:0<0,23,1{Harbour blue,Charcoal,Slate,Sunflower,Graphite,Amber,Tangerine,Flamingo,Espresso,Midnight,Parchment,Pewter,Moss,Lemon,Forest,Fern,Jet,Ice,Steel,Jade,Violet,Brick red,Lagoon,Plum}>-Colourway
slider5:15<0,100,1>-Drift: bit rate and crunch (%)
slider6:0<0,1,1{Off,On}>-Sequencer play (with transport)
slider7:0<0,75,1>-Sequencer swing (%)
slider8:0<0,7,1{A,B,C,D,E,F,G,H}>-Pattern
slider9:0<0,100,1>-Drive (%)
slider10:70<0,100,1>-Drive tone (%)
slider11:0<0,100,1>-Comp (%)
slider12:1<0,1,1{Slow,Fast}>-Comp speed
slider13:20<20,400,1>-EQ HPF (Hz, 20 = off)
slider14:0<-12,12,0.1>-EQ LF (dB)
slider15:0<-12,12,0.1>-EQ MID (dB)
slider16:0<-12,12,0.1>-EQ HF (dB)
slider17:0.4<0.01,5,0.01>-Phaser rate (Hz)
slider18:70<0,100,1>-Phaser depth (%)
slider19:40<0,90,1>-Phaser feedback (%)
slider20:2<0,5,1{1/32,1/16,1/8,1/4,1/2,1/1}>-Delay time
slider21:0<0,2,1{Straight,Dotted,Triplet}>-Delay feel
slider22:35<0,95,1>-Delay feedback (%)
slider23:50<0,100,1>-Delay tone (%)
slider24:50<0,100,1>-Delay level (%)
slider25:1<0,2,1{Clean,Vintage,Dusty}>-Character
slider27:prs_sel=0<0,16,1{No kit,Kit 1,Kit 2,Kit 3,Kit 4,Kit 5,Kit 6,Kit 7,Kit 8,Kit 9,Kit 10,Kit 11,Kit 12,Kit 13,Kit 14,Kit 15,Kit 16}>-Preset (your saved kit)

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(33554431, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(33554431, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-frx-25-mini";
ext_noinit = 1;

NP = 24;
CHP = 20000;
NMAP = 2800;
MQO = 3000; MQN = 3300; MQV = 3600;
PAT = 4000;
PLEN = 52400;
SOFF = 50000; SLEN = 50600; SRAT = 51200;
PPK = 53000; LREQ = 53100; LDONE = 53200; LPLAY = 53300; PMIS = 53400; NGN = 53500;
KITS = 30000; KST = 256; KNAME = 200;
LT = 9300;
BACC = 9500;
BHO = 9530;
BLV = 9540;
PHS = 9600;
DLB = 100000; DLN = 262144;
KPM = 630000; PPM = 830000; PSZ = 512;
AS = 900000;
SMP = 1000000; SLSZ = 1100000;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();

function pnote(p) (
  p == 0 ? 36 : p == 1 ? 38 : p == 2 ? 40 : p == 3 ? 37 : p == 4 ? 48 : p == 5 ? 45 : p == 6 ? 43 : p == 7 ? 41 :
  p == 8 ? 42 : p == 9 ? 44 : p == 10 ? 46 : p == 11 ? 49 : p == 12 ? 57 : p == 13 ? 51 : p == 14 ? 53 : p <= 22 ? 12 + p : 35;
);
function plevel(p) ( p == 0 ? 90 : p <= 3 ? 82 : p <= 7 ? 78 : p <= 10 ? 66 : p <= 14 ? 62 : 70; );
function ppan(p) (
  p == 4 ? -30 : p == 5 ? -10 : p == 6 ? 10 : p == 7 ? 30 : p >= 8 && p <= 10 ? 25 : p == 11 ? -25 : p == 12 ? 35 :
  p == 13 || p == 14 ? -30 : p >= 15 && p <= 22 ? ((p - 15) % 2 ? 20 : -20) : 0;
);
function pad_defaults(p) local(b) (
  b = CHP + p * 8;
  b[0] = -1; b[1] = 0; b[2] = plevel(p); b[3] = ppan(p);
  b[4] = p == 9 ? 300 : 4000; b[5] = 0; b[6] = pnote(p); b[7] = 0;
);
function ppm_str_a(k, dst) local(b, n, i) (
  b = PPM + k * PSZ; n = b[0]; str_setlen(dst, n); i = 0; loop(n, str_setchar(dst, i, b[1 + i], 'cu'); i += 1; ); dst;
);
function load_pad(k) local(h, n, nch, sr, b, f, got, i, j, pk) (
  SLEN[k] = 0; SRAT[k] = 44100; PPK[k] = 0; NGN[k] = 1; SOFF[k] = k * SLSZ;
  n = PPM[k * PSZ];
  n > 0 ? (
    ppm_str_a(k, #ldp);
    h = file_open(#ldp);
    h >= 0 ? (
      nch = 0; sr = 0; file_riff(h, nch, sr);
      nch > 0 && sr > 0 ? (
        b = SMP + k * SLSZ; f = 0; got = 1;
        while (got > 0 && f < SLSZ - 8192) (
          got = floor(file_mem(h, AS, 8192 * nch) / nch);
          nch == 1 ? memcpy(b + f, AS, got) : (
            i = 0; loop(got, j = AS + i * nch; b[f + i] = (j[0] + j[1]) * 0.5; i += 1; );
          );
          f += got;
        );
        pk = 0; i = 0; loop(f, pk = max(pk, abs(b[i])); i += 1; );
        SLEN[k] = f; SRAT[k] = sr; PPK[k] = pk; NGN[k] = 0.5 / max(pk, 0.063);
      );
      file_close(h);
    );
  );
  PMIS[k] = n > 0 && SLEN[k] < 2;
);
function kit_load(k) local(kb, i) (
  kb = KITS + (k - 1) * KST;
  kb[0] ? (
    memcpy(CHP, kb + 8, NP * 8);
    memcpy(PPM, KPM + (k - 1) * NP * PSZ, NP * PSZ);
    slider4 = kb[1]; slider25 = kb[2]; slider_automate(slider4); slider_automate(slider25);
    i = 0; loop(NP, LREQ[i] += 1; i += 1; );
  );
);
function kit_save(k) local(kb) (
  kb = KITS + (k - 1) * KST;
  memcpy(kb + 8, CHP, NP * 8);
  memcpy(KPM + (k - 1) * NP * PSZ, PPM, NP * PSZ);
  kb[1] = slider4 | 0; kb[2] = slider25 | 0; kb[0] = 1;
);

RMD_MS = 1.2;
ACC_OV = 0.15; ACD_MS = 4; ACC_LV = 0.97; ACC_CT = 6; ACC_DK = 1.12;
function dcoef(ms) ( exp(-4.6 / (max(ms, 1) * 0.001 * srate)); );
function ch_choke() instance(act, chk) ( act ? chk = 1; );
function choke_open() ( c10.ch_choke(); );
function ch_go() instance(ci, act, ph, inc, iinc, pos, dir, len, bas, held, eg, dk, chk, lv, pl, pr, acx, acd, rm, pnd, pvel, fin,
                           vb, ab, ho, ds, rt)
                 local(b, vq, acc) (
  b = CHP + ci * 8;
  vb = b[7] & 1; ab = BACC + vb * 8; ho = BHO + vb * 2; ds = b[7] & 2; rt = vb || ds;
  rt ? fx_live = 1;
  SLEN[ci] < 2 || LREQ[ci] != LDONE[ci] ? act = 0 : (
    ci == 8 || ci == 9 ? choke_open();
    vq = max(1, floor(pvel * 10 + 0.5)) / 10; acc = vq >= 1;
    len = SLEN[ci]; bas = SMP + SOFF[ci];
    dir = b[5] ? -1 : 1; pos = b[5] ? len : -1;
    ph = 0.5; held = 0; fin = 0;
    inc = 2 ^ ((b[1] + acc * ACC_CT * 0.01) / 12) * SRAT[ci] / srate * clk_r; iinc = 1 / inc;
    lv = (1 - velsens + velsens * vq) * sqr(b[2] / 100) * (acc ? ACC_LV : 1) * NGN[ci];
    pl = sqrt(1 - b[3] / 100); pr = sqrt(1 + b[3] / 100);
    eg = 1; dk = b[4] >= 4000 ? 1 : dcoef(b[4] * (acc ? ACC_DK : 1));
    acx = acc ? ACC_OV : 0; acd = exp(-1 / (ACD_MS * 0.001 * srate));
    chk = 0; pnd = 0; rm = 1; act = 1;
    LT[ci] = 1;
  );
);
function ch_trig(vel) instance(act, eg, lv, pnd, pvel, rm, rmd) (
  pvel = vel;
  !pnd ? (
    act && eg * lv > 0.0005 ? ( pnd = 1; rm = 1; rmd = 1 / (RMD_MS * 0.001 * srate); ) : this.ch_go();
  );
);
function ch_run() instance(act, ph, inc, iinc, pos, dir, len, bas, held, eg, dk, chk, lv, pl, pr, acx, acd, rm, rmd, pnd, fin,
                           g, gl, gr, nv, dd, u, v, u2, v2, w, dl, dr) (
  act ? (
    chk ? eg *= chk_c : eg *= dk;
    g = eg * lv;
    acx > 0.00001 ? ( g *= 1 + acx; acx *= acd; );
    pnd ? ( rm -= rmd; rm > 0 ? g *= rm : ( this.ch_go(); g = eg * lv * (1 + acx); ); );
    gl = g * pl; gr = g * pr;
    ph += inc;
    while (ph >= 1) (
      pos += dir;
      pos >= 0 && pos < len ? nv = bas[pos] : ( nv = 0; fin = 1; );
      dd = nv - held;
      dd != 0 ? (
        held = nv;
        u = (ph - 1) * iinc; v = 1 - u; u2 = u * u; v2 = v * v;
        dl = dd * gl; dr = dd * gr;
        w = u2 * u2 * 0.041666667;
        aL0 += dl * w; aR0 += dr * w;
        w = 0.5 - v * 0.66666667 + v2 * v * 0.33333333 - v2 * v2 * 0.125;
        aL1 += dl * w; aR1 += dr * w;
        w = u * 0.66666667 - 0.5 - u2 * u * 0.33333333 + u2 * u2 * 0.125;
        aL2 += dl * w; aR2 += dr * w;
        w = v2 * v2 * -0.041666667;
        aL3 += dl * w; aR3 += dr * w;
      );
      ph -= 1;
      fin ? ph = 0;
    );
    oL += held * gl; oR += held * gr;
    fin || eg < 0.0001 ? ( held = 0; fin = 0; pnd ? this.ch_go() : act = 0; );
  );
);
function ch_runx() instance(act, ph, inc, iinc, pos, dir, len, bas, held, eg, dk, chk, lv, pl, pr, acx, acd, rm, rmd, pnd, fin,
                           g, gl, gr, nv, dd, u, v, u2, v2, w0, w1, w2, w3, dl, dr, vb, ab, ho, ds, rt) (
  act ? (
    chk ? eg *= chk_c : eg *= dk;
    g = eg * lv;
    acx > 0.00001 ? ( g *= 1 + acx; acx *= acd; );
    pnd ? ( rm -= rmd; rm > 0 ? g *= rm : ( this.ch_go(); g = eg * lv * (1 + acx); ); );
    gl = g * pl; gr = g * pr;
    ph += inc;
    while (ph >= 1) (
      pos += dir;
      pos >= 0 && pos < len ? nv = bas[pos] : ( nv = 0; fin = 1; );
      dd = nv - held;
      dd != 0 ? (
        held = nv;
        u = (ph - 1) * iinc; v = 1 - u; u2 = u * u; v2 = v * v;
        dl = dd * gl; dr = dd * gr;
        w0 = u2 * u2 * 0.041666667;
        w1 = 0.5 - v * 0.66666667 + v2 * v * 0.33333333 - v2 * v2 * 0.125;
        w2 = u * 0.66666667 - 0.5 - u2 * u * 0.33333333 + u2 * u2 * 0.125;
        w3 = v2 * v2 * -0.041666667;
        vb ? (
          ab[0] += dl * w0; ab[1] += dl * w1; ab[2] += dl * w2; ab[3] += dl * w3;
          ab[4] += dr * w0; ab[5] += dr * w1; ab[6] += dr * w2; ab[7] += dr * w3;
        ) : (
          aL0 += dl * w0; aL1 += dl * w1; aL2 += dl * w2; aL3 += dl * w3;
          aR0 += dr * w0; aR1 += dr * w1; aR2 += dr * w2; aR3 += dr * w3;
        );
        ds ? (
          BACC[16] += dl * w0; BACC[17] += dl * w1; BACC[18] += dl * w2; BACC[19] += dl * w3;
          BACC[20] += dr * w0; BACC[21] += dr * w1; BACC[22] += dr * w2; BACC[23] += dr * w3;
        );
      );
      ph -= 1;
      fin ? ph = 0;
    );
    vb ? ( ho[0] += held * gl; ho[1] += held * gr; BLV[1] = 1; ) : ( oL += held * gl; oR += held * gr; );
    ds ? ( BHO[4] += held * gl; BHO[5] += held * gr; BLV[2] = 1; );
    fin || eg < 0.0001 ? ( held = 0; fin = 0; pnd ? this.ch_go() : act = 0; );
  );
);
function ch_reset(c) instance(ci, act, held, pnd, fin) ( ci = c; act = 0; held = 0; pnd = 0; fin = 0; );
function ch_drift(r) instance(act, inc, iinc) ( act ? ( inc *= r; iinc /= r; ); );

function cv_run(a, o) instance(fz1, fz2, h, z1, z2, w1, w2) local(dx, y, v1, v2, v3) (
  dx = a[0]; a[0] = a[1]; a[1] = a[2] + o; a[2] = a[3]; a[3] = 0;
  y = fcc * fz1 - fca * (dx + fz2); fz2 = fz1; fz1 = dx;
  crunch > 0 ? ( cr_tick ? h = floor(y * cr_q + 0.5) * cr_iq; y = h; );
  v3 = y - z2; v1 = dac_a1 * z1 + dac_a2 * v3; v2 = z2 + dac_a2 * z1 + dac_a3 * v3; z1 = 2 * v1 - z1; z2 = 2 * v2 - z2;
  v3 = v2 - w2; v1 = dac_b1 * w1 + dac_b2 * v3; v2 = w2 + dac_b2 * w1 + dac_b3 * v3; w1 = 2 * v1 - w1; w2 = 2 * v2 - w2;
  v2;
);
function cv_tidy() instance(fz1, fz2, h, z1, z2, w1, w2) (
  abs(z1) < 0.0000000001 && abs(z2) < 0.0000000001 && abs(w1) < 0.0000000001 && abs(w2) < 0.0000000001 ? z1 = z2 = w1 = w2 = 0;
);
function cv_clear() instance(fz1, fz2, h, z1, z2, w1, w2) ( fz1 = fz2 = h = z1 = z2 = w1 = w2 = 0; );

function fq_set(type, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, AA, n, sa) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); AA = 10 ^ (gdb / 40);
  type == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / AA; b0 = (1 + al * AA) / n; b1 = -2 * cw / n; b2 = (1 - al * AA) / n; a1 = b1; a2 = (1 - al / AA) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(AA) * al; n = (AA + 1) - (AA - 1) * cw + sa;
                b0 = AA * ((AA + 1) + (AA - 1) * cw + sa) / n; b1 = -2 * AA * ((AA - 1) + (AA + 1) * cw) / n;
                b2 = AA * ((AA + 1) + (AA - 1) * cw - sa) / n; a1 = 2 * ((AA - 1) - (AA + 1) * cw) / n; a2 = ((AA + 1) - (AA - 1) * cw - sa) / n; ) :
              ( sa = 2 * sqrt(AA) * al; n = (AA + 1) + (AA - 1) * cw + sa;
                b0 = AA * ((AA + 1) - (AA - 1) * cw + sa) / n; b1 = 2 * AA * ((AA - 1) - (AA + 1) * cw) / n;
                b2 = AA * ((AA + 1) - (AA - 1) * cw - sa) / n; a1 = -2 * ((AA - 1) + (AA + 1) * cw) / n; a2 = ((AA + 1) + (AA - 1) * cw - sa) / n; );
);
function fq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function fq_tidy() instance(x1, x2, y1, y2) (
  abs(y1) < 0.0000000001 && abs(y2) < 0.0000000001 && abs(x1) < 0.0000000001 && abs(x2) < 0.0000000001 ? x1 = x2 = y1 = y2 = 0;
);
function fq_clear() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function ph_chain(x, base, a) local(i, y) (
  i = 0;
  loop(6,
    y = a * x + PHS[base + i] - a * PHS[base + 6 + i];
    PHS[base + i] = x; PHS[base + 6 + i] = y;
    x = y; i += 1;
  );
  x;
);
function dl_read(b, d) local(p, i, f) (
  p = dl_w - d; p < 0 ? p += DLN;
  i = floor(p); f = p - i;
  b[i] + (b[(i + 1) & (DLN - 1)] - b[i]) * f;
);
function zone(n, head) ( NMAP[n] < 0 ? NMAP[n] = NMAP[head]; );
function trig(c, vel) (
  c < 6 ? (
    c == 0 ? c0.ch_trig(vel) : c == 1 ? c1.ch_trig(vel) : c == 2 ? c2.ch_trig(vel) : c == 3 ? c3.ch_trig(vel) : c == 4 ? c4.ch_trig(vel) : c5.ch_trig(vel);
  ) :
  c < 12 ? (
    c == 6 ? c6.ch_trig(vel) : c == 7 ? c7.ch_trig(vel) : c == 8 ? c8.ch_trig(vel) : c == 9 ? c9.ch_trig(vel) : c == 10 ? c10.ch_trig(vel) : c11.ch_trig(vel);
  ) :
  c < 18 ? (
    c == 12 ? c12.ch_trig(vel) : c == 13 ? c13.ch_trig(vel) : c == 14 ? c14.ch_trig(vel) : c == 15 ? c15.ch_trig(vel) : c == 16 ? c16.ch_trig(vel) : c17.ch_trig(vel);
  ) :
  (
    c == 18 ? c18.ch_trig(vel) : c == 19 ? c19.ch_trig(vel) : c == 20 ? c20.ch_trig(vel) : c == 21 ? c21.ch_trig(vel) : c == 22 ? c22.ch_trig(vel) : c23.ch_trig(vel);
  );
);
function stop_all() (
  c0.ch_reset(0); c1.ch_reset(1); c2.ch_reset(2); c3.ch_reset(3); c4.ch_reset(4); c5.ch_reset(5);
  c6.ch_reset(6); c7.ch_reset(7); c8.ch_reset(8); c9.ch_reset(9); c10.ch_reset(10); c11.ch_reset(11);
  c12.ch_reset(12); c13.ch_reset(13); c14.ch_reset(14); c15.ch_reset(15); c16.ch_reset(16); c17.ch_reset(17);
  c18.ch_reset(18); c19.ch_reset(19); c20.ch_reset(20); c21.ch_reset(21); c22.ch_reset(22); c23.ch_reset(23);
  aL0 = aL1 = aL2 = aL3 = aR0 = aR1 = aR2 = aR3 = 0;
  memset(BACC, 0, 24); memset(BHO, 0, 6);
);
function choke_all() (
  c0.ch_choke(); c1.ch_choke(); c2.ch_choke(); c3.ch_choke(); c4.ch_choke(); c5.ch_choke(); c6.ch_choke(); c7.ch_choke();
  c8.ch_choke(); c9.ch_choke(); c10.ch_choke(); c11.ch_choke(); c12.ch_choke(); c13.ch_choke(); c14.ch_choke(); c15.ch_choke();
  c16.ch_choke(); c17.ch_choke(); c18.ch_choke(); c19.ch_choke(); c20.ch_choke(); c21.ch_choke(); c22.ch_choke(); c23.ch_choke();
);
function pact(c) (
  c < 6 ? ( c == 0 ? c0.act : c == 1 ? c1.act : c == 2 ? c2.act : c == 3 ? c3.act : c == 4 ? c4.act : c5.act; ) :
  c < 12 ? ( c == 6 ? c6.act : c == 7 ? c7.act : c == 8 ? c8.act : c == 9 ? c9.act : c == 10 ? c10.act : c11.act; ) :
  c < 18 ? ( c == 12 ? c12.act : c == 13 ? c13.act : c == 14 ? c14.act : c == 15 ? c15.act : c == 16 ? c16.act : c17.act; ) :
           ( c == 18 ? c18.act : c == 19 ? c19.act : c == 20 ? c20.act : c == 21 ? c21.act : c == 22 ? c22.act : c23.act; );
);
function pchoke(c) (
  c < 6 ? ( c == 0 ? c0.ch_choke() : c == 1 ? c1.ch_choke() : c == 2 ? c2.ch_choke() : c == 3 ? c3.ch_choke() : c == 4 ? c4.ch_choke() : c5.ch_choke(); ) :
  c < 12 ? ( c == 6 ? c6.ch_choke() : c == 7 ? c7.ch_choke() : c == 8 ? c8.ch_choke() : c == 9 ? c9.ch_choke() : c == 10 ? c10.ch_choke() : c11.ch_choke(); ) :
  c < 18 ? ( c == 12 ? c12.ch_choke() : c == 13 ? c13.ch_choke() : c == 14 ? c14.ch_choke() : c == 15 ? c15.ch_choke() : c == 16 ? c16.ch_choke() : c17.ch_choke(); ) :
           ( c == 18 ? c18.ch_choke() : c == 19 ? c19.ch_choke() : c == 20 ? c20.ch_choke() : c == 21 ? c21.ch_choke() : c == 22 ? c22.ch_choke() : c23.ch_choke(); );
);
stop_all();
fzL1 = fzL2 = fzR1 = fzR2 = 0;

function rowlen(p, r) local(l) ( l = PLEN[p * 24 + r]; l < 2 || l > 16 ? 16 : l; );
function prow(p, r, str) local(i, c) (
  i = 0; loop(16, c = str_getchar(str, i); PAT[p * 384 + r * 16 + i] = c == '*' ? 2 : c == 'o' ? 1 : 0; i += 1; );
);
function factory_patterns() (
  memset(PAT, 0, 8 * 384); memset(PLEN, 0, 8 * 24);
  prow(0, 0, "*-------*-o-----"); prow(0, 1, "----*-------*---"); prow(0, 8, "o-o-o-o-o-o-o-o-"); prow(0, 11, "*---------------");
  prow(1, 0, "*--o--o---*--o--"); prow(1, 1, "----*--o-o--*---"); prow(1, 8, "oo*ooo*ooo*ooo*o"); prow(1, 10, "--------------o-");
  prow(2, 0, "*-----*---*-----"); prow(2, 2, "----*-------*---"); prow(2, 8, "o-o-o-o-o-o-o-o-"); prow(2, 15, "--o--o----o--o--");
  prow(3, 0, "*---*---*---*---"); prow(3, 1, "----*-------*---"); prow(3, 8, "o---o---o---o---"); prow(3, 10, "--*---*---*---*-");
  prow(4, 0, "*---*---*---*---"); prow(4, 2, "----*-------*---"); prow(4, 9, "o-o-o-o-o-o-o-o-"); prow(4, 10, "--*---*---*---*-"); prow(4, 16, "-o-o-o-o-o-o-o-o");
  prow(5, 0, "*---------------"); prow(5, 4, "*-o-o-----------"); prow(5, 5, "------*-o-------"); prow(5, 6, "----------*-o---");
  prow(5, 7, "--------------**"); prow(5, 11, "*---------------");
  prow(6, 0, "*--o----*--o----"); prow(6, 3, "---o--o---o--o--"); prow(6, 13, "o-ooo-ooo-ooo-oo"); prow(6, 18, "--o---o---o-o---");
  prow(6, 19, "o-----o-o-----o-"); prow(6, 20, "o--o--o---o-o---");
);

!init_done ? (
  gi = 0; loop(NP, pad_defaults(gi); PPM[gi * PSZ] = 0; gi += 1; );
  gi = 0; loop(16, KITS[gi * KST] = 0; gi += 1; );
  factory_patterns(); init_done = 1;
);
gi = 0; loop(NP, SLEN[gi] = 0; LDONE[gi] = LREQ[gi] - (PPM[gi * PSZ] > 0 ? 1 : 0); LPLAY[gi] = 0; PMIS[gi] = 0; NGN[gi] = 1; gi += 1; );
lastkey = -1; cur_step = -1; cur_pat = slider8;
sm = 1 - exp(-1 / (0.03 * srate));
xpL = xpR = 0;
dz1L = dz2L = dz1R = dz2R = 0; dw1L = dw2L = dw1R = dw2R = 0; cr_hL = cr_hR = 0;
cv1L.cv_clear(); cv1R.cv_clear(); cv2L.cv_clear(); cv2R.cv_clear();
cr_ph = 0; cr_tick = 0; clk_r = 1; cr_c = 0;
memset(PHS, 0, 24); ph_p = 0; ph_fbL = ph_fbR = 0; ph_cnt = 0; ph_aL = ph_aR = 0; ph_e = 0;
memset(DLB, 0, 2 * DLN); dl_w = 0; dl_lpL = dl_lpR = 0; dl_e = 0; dl_ts = -1; dl_clr = 1; dl_hold = 0; bus1_t = bus2_t = 0;
dvL.clp_set(1, 1, 1, 0); dvR.clp_set(1, 1, 1, 0); dvL.clp_reset(); dvR.clp_reset();
dvL.clp_pf_cfg(0.45 * srate, 10000, -1.5, 200); dvR.clp_pf_cfg(0.45 * srate, 10000, -1.5, 200); dvL.clp_pf_reset(); dvR.clp_pf_reset();
dv_g = 1; dv_k = 1; dv_tL = dv_tR = 0; cm_env = 0; cm_gr = 0; cm_gs = 1; cm_gt = 1; cm_n = 0;
ph_dD.drift_init(0.8); dl_dD.drift_init(0.6);
clL.clp_set(2, 1.6, 1.6, 0); clL.clp_knee(0.6); clR.clp_set(2, 1.6, 1.6, 0); clR.clp_knee(0.6);
cr_dB.drift_init(0.9); cr_dR.drift_init(1.2); cr_dC.drift_init(0.7);

pwr_init(); pwr_hum_db = -83; pwr_sag = 0.12; pwr_rip = 0.002;
pwr_wu_loss = 0.5; pwr_wu_drv = 0.4; pwr_wu_lp = 13000; pwr_wu_wob = 0.1; pwr_bloom = 0;

function update() local(fc) (
  vol_t = 10 ^ (slider1 / 20); chan = slider2; velsens = slider3 / 100;
  crunch = slider5 / 100;
  sq_play = slider6; sq_swing = slider7 / 100 * 0.5;
  fc = slider25 < 0.5 ? 18000 : slider25 < 1.5 ? 15000 : 12000;
  dac_g = tan($pi * min(fc * 0.9, srate * 0.45) / srate);
  dac_a1 = 1 / (1 + dac_g * (dac_g + 1 / 0.54)); dac_a2 = dac_g * dac_a1; dac_a3 = dac_g * dac_a2;
  dac_b1 = 1 / (1 + dac_g * (dac_g + 1 / 1.35)); dac_b2 = dac_g * dac_b1; dac_b3 = dac_g * dac_b2;
  fc_x = 10000 / srate; fc_k = (sin($pi * fc_x) / ($pi * fc_x)) ^ 4;
  fca = (1 / fc_k - 1) / (2 * (1 - cos(2 * $pi * fc_x))); fcc = 1 + 2 * fca;
  chk_c = exp(-1 / (0.001 * srate));
  ost_setup(0, 0.3, 120, 6000, -0.3, 1);
  dv_amt = slider9 / 100; dv_gt = 10 ^ (dv_amt * 1.5); dv_kt = dv_gt ^ -0.55;
  dv_on = dv_amt > 0;
  dv_tc = slider10 >= 100 ? 1 : 1 - exp(-2 * $pi * min(2000 * 2 ^ (slider10 / 100 * 3.3), srate * 0.45) / srate);
  cm_amt = slider11 / 100; cm_on = cm_amt > 0;
  cm_thr = -28 * cm_amt; cm_mk = 10 ^ (28 * cm_amt * 0.75 * 0.45 / 20);
  cm_at = 1 - exp(-1 / ((slider12 ? 0.2 : 10) * 0.001 * srate));
  cm_rl = 1 - exp(-1 / ((slider12 ? 60 : 300) * 0.001 * srate));
  eq_hp = slider13 > 20; eq_lf = slider14 != 0; eq_md = slider15 != 0; eq_hf = slider16 != 0;
  eq_hp ? ( hpL.fq_set(1, slider13, 0.707, 0); hpR.fq_set(1, slider13, 0.707, 0); ) : ( hpL.fq_clear(); hpR.fq_clear(); );
  eq_lf ? ( lfL.fq_set(4, 110, 0.707, slider14); lfR.fq_set(4, 110, 0.707, slider14); ) : ( lfL.fq_clear(); lfR.fq_clear(); );
  eq_md ? ( mdL.fq_set(2, 1100, 0.7, slider15); mdR.fq_set(2, 1100, 0.7, slider15); ) : ( mdL.fq_clear(); mdR.fq_clear(); );
  eq_hf ? ( hfL.fq_set(3, 7700, 0.707, slider16); hfR.fq_set(3, 7700, 0.707, slider16); ) : ( hfL.fq_clear(); hfR.fq_clear(); );
  ph_dep = slider18 / 100 * 2.5; ph_fb = slider19 / 100;
  dl_bt = 0.125 * 2 ^ slider20 * (slider21 == 1 ? 1.5 : slider21 == 2 ? 2 / 3 : 1);
  dl_fb = slider22 / 100; dl_lv = slider24 / 100;
  dl_tc = 1 - exp(-2 * $pi * min(1500 * 2 ^ (slider23 / 100 * 3.4), srate * 0.45) / srate);
);
function gap_clear() (
  stop_all();
  fzL1 = fzL2 = fzR1 = fzR2 = 0; dz1L = dz2L = dz1R = dz2R = 0; dw1L = dw2L = dw1R = dw2R = 0; cr_hL = cr_hR = 0;
  cv1L.cv_clear(); cv1R.cv_clear(); cv2L.cv_clear(); cv2R.cv_clear();
  memset(PHS, 0, 24); ph_fbL = ph_fbR = 0;
  memset(DLB, 0, 2 * DLN); dl_lpL = dl_lpR = 0; dl_clr = 1; dl_hold = 0;
  dvL.clp_reset(); dvR.clp_reset(); dvL.clp_pf_reset(); dvR.clp_pf_reset(); dv_tL = dv_tR = 0; cm_env = 0;
  hpL.fq_clear(); hpR.fq_clear(); lfL.fq_clear(); lfR.fq_clear(); mdL.fq_clear(); mdR.fq_clear(); hfL.fq_clear(); hfR.fq_clear();
  clL.clp_reset(); clR.clp_reset(); xpL = xpR = 0;
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(25, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  ksv_dirty > 0 ? (
    k = ksv_dirty; ksv_dirty = 0; kit_save(k);
    prs_sel = k; slider_automate(prs_sel); prs_last = prs_sel; prs_h0 = prs_hash();
  );
  kdel_dirty > 0 ? (
    k = kdel_dirty; kdel_dirty = 0; KITS[(k - 1) * KST] = 0;
    prs_sel == k ? ( prs_sel = 0; slider_automate(prs_sel); prs_last = 0; prs_h0 = prs_hash(); );
  );
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0;
    KITS[(k - 1) * KST] ? ( kit_load(k); prs_sel = k; slider_automate(prs_sel); prs_last = prs_sel; prs_h0 = prs_hash(); );
  ) : prs_ok ? (
    prs_sel = max(0, min(16, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? kit_load(prs_sel); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0; aud_dirty = 0;
update();
vol_s = vol_t;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; fr_ed = 0; fr_tab = 0; fr_bank = 0; sel_pad = 0; );
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
update();
prs_chk();

@block
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
update();
prs_chk();
pwr_block(1);
ld_k = -1; gi_b = 0; while (ld_k < 0 && gi_b < NP) ( LREQ[gi_b] != LDONE[gi_b] ? ld_k = gi_b; gi_b += 1; );
ld_k >= 0 ? (
  pact(ld_k) && !ld_w ? ( pchoke(ld_k); ld_w = 1; ) : !pact(ld_k) ? (
    ld_w = 0; LDONE[ld_k] = LREQ[ld_k]; load_pad(ld_k);
    LPLAY[ld_k] ? ( LPLAY[ld_k] = 0; trig(ld_k, 0.8); );
  );
);
gi_b = 0; loop(128, NMAP[gi_b] = -1; gi_b += 1; );
gi_b = NP - 1; loop(NP, NMAP[CHP[gi_b * 8 + 6]] = gi_b; gi_b -= 1; );
zone(50, 48); zone(47, 45); zone(58, 43); zone(39, 41); zone(22, 42); zone(26, 46); zone(55, 49); zone(52, 57); zone(59, 51);
m_cnt = 0;
while (midirecv(mofs, m1, m2, m3)) (
  m_ch_ok = chan == 0 || (m1 & 15) == chan - 1;
  (m1 & 0xF0) == 0x90 && m3 > 0 && m_ch_ok && m_cnt < 256 ? (
    MQO[m_cnt] = mofs; MQN[m_cnt] = m2; MQV[m_cnt] = m3 / 127; m_cnt += 1; midi_t_d = time_precise();
  );
  (m1 & 0xF0) == 0xB0 && (m2 == 120 || m2 == 123) && m_ch_ok ? choke_all();
  midisend(mofs, m1, m2, m3);
);
m_idx = 0; spos = 0;
cr_inc = samplesblock / srate * 0.15;
cr_wb = cr_dB.drift_tick(cr_inc); cr_wr = cr_dR.drift_tick(cr_inc);
cr_bits = 16 - 11 * crunch + 0.9 * crunch * cr_wb;
cr_q = 2 ^ (cr_bits - 1); cr_iq = 1 / cr_q;
cr_rate = min(1, (1 - 0.8 * crunch) * (1 + 0.12 * crunch * cr_wr));
cr_n = 8 * crunch * cr_dC.drift_tick(cr_inc);
cr_n != cr_c ? (
  dr_r = 2 ^ ((cr_n - cr_c) / 1200); cr_c = cr_n; clk_r = 2 ^ (cr_c / 1200);
  c0.ch_drift(dr_r); c1.ch_drift(dr_r); c2.ch_drift(dr_r); c3.ch_drift(dr_r); c4.ch_drift(dr_r); c5.ch_drift(dr_r);
  c6.ch_drift(dr_r); c7.ch_drift(dr_r); c8.ch_drift(dr_r); c9.ch_drift(dr_r); c10.ch_drift(dr_r); c11.ch_drift(dr_r);
  c12.ch_drift(dr_r); c13.ch_drift(dr_r); c14.ch_drift(dr_r); c15.ch_drift(dr_r); c16.ch_drift(dr_r); c17.ch_drift(dr_r);
  c18.ch_drift(dr_r); c19.ch_drift(dr_r); c20.ch_drift(dr_r); c21.ch_drift(dr_r); c22.ch_drift(dr_r); c23.ch_drift(dr_r);
);
abs(dz1L) < 0.0000000001 && abs(dz2L) < 0.0000000001 && abs(dw1L) < 0.0000000001 && abs(dw2L) < 0.0000000001 ? dz1L = dz2L = dw1L = dw2L = 0;
abs(dz1R) < 0.0000000001 && abs(dz2R) < 0.0000000001 && abs(dw1R) < 0.0000000001 && abs(dw2R) < 0.0000000001 ? dz1R = dz2R = dw1R = dw2R = 0;
cv1L.cv_tidy(); cv1R.cv_tidy(); cv2L.cv_tidy(); cv2R.cv_tidy();
ph_inc = slider17 / srate * (1 + 0.35 * crunch * ph_dD.drift_tick(cr_inc));
dl_tt = min(max(dl_bt * 60 / max(tempo, 20) * srate * (1 + 0.012 * crunch * dl_dD.drift_tick(cr_inc)), 4), DLN - 4);
dl_ts < 0 ? dl_ts = dl_tt;
dl_gc = 1 - exp(-1 / (0.08 * srate));
dvL.clp_pf_block(dv_amt, srate, samplesblock); dvR.clp_pf_block(dv_amt, srate, samplesblock);
dvL.clp_tidy(); dvR.clp_tidy();
hpL.fq_tidy(); hpR.fq_tidy(); lfL.fq_tidy(); lfR.fq_tidy(); mdL.fq_tidy(); mdR.fq_tidy(); hfL.fq_tidy(); hfR.fq_tidy();
bus1_t = BLV[1] ? 0.05 * srate : max(bus1_t - samplesblock, 0);
bus2_t = BLV[2] ? 0.05 * srate : max(bus2_t - samplesblock, 0);
BLV[1] = BLV[2] = 0;
ph_run = bus1_t > 0 || ph_e > 0.000001; ph_e = 0;
bus2_t > 0 || dl_e > 0.000001 ? dl_hold = dl_ts + 0.2 * srate : dl_hold = max(dl_hold - samplesblock, 0);
dl_run = dl_hold > 0; dl_e = 0;
!ph_run ? ( memset(PHS, 0, 24); ph_fbL = ph_fbR = 0; );
!dl_run && dl_clr != 1 ? ( memset(DLB, 0, 2 * DLN); dl_lpL = dl_lpR = 0; dl_clr = 1; );
dl_run ? dl_clr = 0;
fx_live = dv_on || dv_g > 1.0001 || cm_on || abs(cm_gs - 1) > 0.0001 || eq_hp || eq_lf || eq_md || eq_hf || ph_run || dl_run;
aud_dirty > 0 ? ( trig(aud_dirty - 1, aud_vel_d); aud_dirty = 0; );
fact_dirty ? ( fact_dirty = 0; factory_patterns(); );
playing = (play_state & 1) && sq_play;
bp0 = beat_position; bps = tempo / 60 / srate;
!playing ? ( lastkey = -1; cur_step = -1; cur_pat = slider8; );
cur_step_d = cur_step; cur_pat_d = cur_pat;
pk_d = max(pk_d, pk_m); pk_m = 0;

@serialize
file_var(0, ui_sz);
file_var(0, init_done);
file_mem(0, CHP, NP * 8);
file_mem(0, PAT, 8 * 384);
file_mem(0, PLEN, 8 * 24);
file_var(0, fr_bank); file_var(0, sel_pad);
fr_bank = max(0, min(2, fr_bank | 0)); sel_pad = max(0, min(NP - 1, sel_pad | 0));
gi_s = 0; loop(NP, file_var(0, PPM[gi_s * PSZ]); PPM[gi_s * PSZ] = max(0, min(PPM[gi_s * PSZ] | 0, PSZ - 12)); file_mem(0, PPM + gi_s * PSZ + 1, PPM[gi_s * PSZ]); gi_s += 1; );
gi_s = 0;
loop(16,
  file_mem(0, KITS + gi_s * KST, 8 + NP * 8);
  KITS[gi_s * KST] ? (
    file_string(0, KNAME + gi_s);
    gi_t = 0; loop(NP, gi_m = KPM + (gi_s * NP + gi_t) * PSZ; file_var(0, gi_m[0]); gi_m[0] = max(0, min(gi_m[0] | 0, PSZ - 12)); file_mem(0, gi_m + 1, gi_m[0]); gi_t += 1; );
  );
  gi_s += 1;
);
file_var(0, kauto_d);
file_var(0, prs_last); prs_ok = 1;
pwr_ser();
file_avail(0) >= 0 ? ( gi_s = 0; loop(NP, PPM[gi_s * PSZ] > 0 ? LREQ[gi_s] += 1 : ( SLEN[gi_s] = 0; PMIS[gi_s] = 0; ); gi_s += 1; ); );

@sample
while (m_idx < m_cnt && MQO[m_idx] <= spos) (
  NMAP[MQN[m_idx]] >= 0 ? trig(NMAP[MQN[m_idx]], MQV[m_idx]);
  m_idx += 1;
);
playing ? (
  q_b = bp0 + spos * bps;
  q_b >= 0 ? (
    q_n = floor(q_b * 4); q_fr = q_b * 4 - q_n;
    q_eff = (q_n & 1) && q_fr < sq_swing ? q_n - 1 : q_n;
    q_eff != lastkey ? (
      q_eff % 16 == 0 ? cur_pat = slider8;
      lastkey = q_eff; cur_step = q_eff % 16;
      q_r = 0;
      loop(NP, q_v = PAT[cur_pat * 384 + q_r * 16 + q_eff % rowlen(cur_pat, q_r)]; q_v ? trig(q_r, q_v == 2 ? 1 : 0.7); q_r += 1; );
    );
  );
);
spos += 1;

oL = 0; oR = 0;
c0.rt ? c0.ch_runx() : c0.ch_run(); c1.rt ? c1.ch_runx() : c1.ch_run(); c2.rt ? c2.ch_runx() : c2.ch_run(); c3.rt ? c3.ch_runx() : c3.ch_run();
c4.rt ? c4.ch_runx() : c4.ch_run(); c5.rt ? c5.ch_runx() : c5.ch_run(); c6.rt ? c6.ch_runx() : c6.ch_run(); c7.rt ? c7.ch_runx() : c7.ch_run();
c8.rt ? c8.ch_runx() : c8.ch_run(); c9.rt ? c9.ch_runx() : c9.ch_run(); c10.rt ? c10.ch_runx() : c10.ch_run(); c11.rt ? c11.ch_runx() : c11.ch_run();
c12.rt ? c12.ch_runx() : c12.ch_run(); c13.rt ? c13.ch_runx() : c13.ch_run(); c14.rt ? c14.ch_runx() : c14.ch_run(); c15.rt ? c15.ch_runx() : c15.ch_run();
c16.rt ? c16.ch_runx() : c16.ch_run(); c17.rt ? c17.ch_runx() : c17.ch_run(); c18.rt ? c18.ch_runx() : c18.ch_run(); c19.rt ? c19.ch_runx() : c19.ch_run();
c20.rt ? c20.ch_runx() : c20.ch_run(); c21.rt ? c21.ch_runx() : c21.ch_run(); c22.rt ? c22.ch_runx() : c22.ch_run(); c23.rt ? c23.ch_runx() : c23.ch_run();
cr_tick = 0;
crunch > 0 ? ( cr_ph += cr_rate; cr_ph >= 1 ? ( cr_ph -= 1; cr_tick = 1; ); );
dxL = aL0; aL0 = aL1; aL1 = aL2 + oL; aL2 = aL3; aL3 = 0;
dxR = aR0; aR0 = aR1; aR1 = aR2 + oR; aR2 = aR3; aR3 = 0;
oL = fcc * fzL1 - fca * (dxL + fzL2); fzL2 = fzL1; fzL1 = dxL;
oR = fcc * fzR1 - fca * (dxR + fzR2); fzR2 = fzR1; fzR1 = dxR;
crunch > 0 ? (
  cr_tick ? ( cr_hL = floor(oL * cr_q + 0.5) * cr_iq; cr_hR = floor(oR * cr_q + 0.5) * cr_iq; );
  oL = cr_hL; oR = cr_hR;
);
dv3 = oL - dz2L; dv1 = dac_a1 * dz1L + dac_a2 * dv3; dv2 = dz2L + dac_a2 * dz1L + dac_a3 * dv3; dz1L = 2 * dv1 - dz1L; dz2L = 2 * dv2 - dz2L;
dv3 = dv2 - dw2L; dv1 = dac_b1 * dw1L + dac_b2 * dv3; dv2 = dw2L + dac_b2 * dw1L + dac_b3 * dv3; dw1L = 2 * dv1 - dw1L; dw2L = 2 * dv2 - dw2L; oL = dv2;
dv3 = oR - dz2R; dv1 = dac_a1 * dz1R + dac_a2 * dv3; dv2 = dz2R + dac_a2 * dz1R + dac_a3 * dv3; dz1R = 2 * dv1 - dz1R; dz2R = 2 * dv2 - dz2R;
dv3 = dv2 - dw2R; dv1 = dac_b1 * dw1R + dac_b2 * dv3; dv2 = dw2R + dac_b2 * dw1R + dac_b3 * dv3; dw1R = 2 * dv1 - dw1R; dw2R = 2 * dv2 - dw2R; oR = dv2;
pwr_in(oL, oR); oL = pwr_l; oR = pwr_r;
fx_live ? (
bus1_t > 0 || BLV[1] ? ( pxL = cv1L.cv_run(BACC + 8, BHO[2]); pxR = cv1R.cv_run(BACC + 12, BHO[3]); BHO[2] = BHO[3] = 0; ) : pxL = pxR = 0;
ph_run || BLV[1] ? (
  ph_p += ph_inc; ph_p >= 1 ? ph_p -= 1;
  ph_cnt <= 0 ? (
    ph_cnt = 8;
    ph_t = tan($pi * min(700 * 2 ^ (ph_dep * sin(2 * $pi * ph_p)), srate * 0.45) / srate); ph_aL = (ph_t - 1) / (ph_t + 1);
    ph_t = tan($pi * min(700 * 2 ^ (ph_dep * cos(2 * $pi * ph_p)), srate * 0.45) / srate); ph_aR = (ph_t - 1) / (ph_t + 1);
  );
  ph_cnt -= 1;
  ph_yL = ph_chain(pxL + ph_fb * ph_fbL, 0, ph_aL);
  ph_yR = ph_chain(pxR + ph_fb * ph_fbR, 12, ph_aR);
  ph_fbL = max(min(ph_yL, 1.5), -1.5); ph_fbR = max(min(ph_yR, 1.5), -1.5);
  oL += 0.6 * (pxL + ph_yL); oR += 0.6 * (pxR + ph_yR);
  ph_e = max(ph_e, abs(ph_yL) + abs(ph_yR));
);
dv_g += (dv_gt - dv_g) * sm; dv_k += (dv_kt - dv_k) * sm;
dv_on || dv_g > 1.0001 ? (
  oL = dvL.clp_run(dvL.clp_pf_run(oL) * dv_g) * dv_k; oR = dvR.clp_run(dvR.clp_pf_run(oR) * dv_g) * dv_k;
  dv_te = dv_tc + (1 - dv_tc) * (1 - min((dv_g - 1) * 20, 1));
  dv_tL += (oL - dv_tL) * dv_te; dv_tR += (oR - dv_tR) * dv_te; oL = dv_tL; oR = dv_tR;
);
cm_on || abs(cm_gs - 1) > 0.0001 ? (
  cm_x = max(abs(oL), abs(oR));
  cm_env += (cm_x - cm_env) * (cm_x > cm_env ? cm_at : cm_rl);
  (cm_n -= 1) <= 0 ? (
    cm_n = 4;
    cm_on ? (
      cm_o = 20 * log10(cm_env + 0.000000001) - cm_thr;
      cm_gr = cm_o <= -3 ? 0 : cm_o >= 3 ? cm_o * 0.75 : 0.75 * sqr(cm_o + 3) / 12;
      cm_gt = 10 ^ (-cm_gr / 20) * cm_mk;
