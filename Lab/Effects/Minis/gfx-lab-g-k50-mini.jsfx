    o1w = 1; o2l = 0; det = 0; fbase = 2000; famt = 0.3; fres = 0; aA = 0.09; aD = 1; aS = 0.9; aR = 0.35; fA = 0.1; fD = 1; fS = 0.9;
    br_lvl = 0.35; brp = 1; chf = 0.45; pe_amt = -0.8; pe_t = 0.12; vib = 5; vibd = 0.7; chor = 0.2; lvl = 0.45; dl_mix = 0.2; dl_bt = 1; dl_fb = 0.3;
  ) : s == 82 ? (
    o1w = 1; o2l = 0; det = 0; fbase = 1500; famt = 0.3; fres = 0; aA = 0.2; aD = 2; aS = 0.4; aR = 0.6; fA = 0.2; fD = 1; fS = 0.6;
    vamix = 0.15; chf = 0.1; chor = 0.6; lvl = 0.55;
    ks_lvl = 1; ks_T = 2.4; ks_br = 0.65; ks_pick = 1;
  ) : s == 83 ? (
    det = 0.02; o2w = 1; o2l = 1; subl = 0.8; fbase = 300; famt = 2; fres = 0.6; aA = 0.3; aD = 1; aS = 0.95; aR = 2.5; fA = 3; fD = 4; fS = 0.3; flfo = 0.8;
    pe_amt = 7; pe_t = 1.5; trem = 0.2; chor = 1.2; lvl = 0.25; dl_mix = 0.35; dl_bt = 1.5; dl_fb = 0.55;
    bl_lvl = 0.5; bR0 = 1; bR1 = 1.41; bR2 = 2.83; bR3 = 3.9; bA0 = 1; bA1 = 0.6; bA2 = 0.4; bA3 = 0.3; bD0 = 3; bD1 = 2; bD2 = 1.5; bD3 = 1;
  ) : s == 84 ? (
    det = 0.006; o2l = 0.9; fbase = 260; famt = 3.2; fres = 0.15; aA = 0.02; aD = 0.5; aS = 0.8; aR = 0.3; fA = 0.06; fD = 0.6; fS = 0.4;
    vf = 0.8; chor = 0.5; lvl = 0.36;
  ) : s == 85 ? (
    o1w = 2; o2l = 1; det = 0.03; fbase = 600; famt = 2.5; fres = 0.75; aA = 0.5; aD = 1; aS = 0.95; aR = 3; fA = 2; fD = 3; fS = 0.2; flfo = 1.2;
    pe_amt = -24; pe_t = 2.5; trem = 0.4; chor = 1.5; lvl = 0.25; dl_mix = 0.4; dl_bt = 0.75; dl_fb = 0.6;
    bl_lvl = 0.6; bR0 = 0.5; bR1 = 1.73; bR2 = 3.1; bR3 = 5.9; bA0 = 1; bA1 = 0.6; bA2 = 0.4; bA3 = 0.3; bD0 = 4; bD1 = 3; bD2 = 2; bD3 = 1;
  ) : s == 86 ? (
    det = 0.01; o2l = 1; fbase = 900; famt = 3; fres = 0.3; aA = 0.001; aD = 0.35; aS = 0.2; aR = 0.25; fA = 0.001; fD = 0.15; fS = 0.05;
    vamix = 0.8; chor = 0.7; lvl = 0.4; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.3;
    ks_lvl = 0.8; ks_T = 0.8; ks_br = 0.95; ks_pick = 1;
  ) : s == 87 ? (
    o1w = 2; o2l = 1; det = 0.004; subl = 1; fbase = 180; famt = 3.5; fres = 0.4; ktrk = 0.3; aA = 0.002; aD = 0.5; aS = 0.8; aR = 0.12; fA = 0.001; fD = 0.22; fS = 0.2;
    mono = 1; glide = 0.02; chor = 0; lvl = 0.5;
    bl_lvl = 0.5; bR0 = 1; bR1 = 2; bR2 = 3; bR3 = 5; bA0 = 1; bA1 = 0.6; bA2 = 0.4; bA3 = 0.3; bD0 = 0.2; bD1 = 0.15; bD2 = 0.1; bD3 = 0.05;
  ) : s == 88 ? (
    det = 0.003; o2l = 0.6; fbase = 300; famt = 2.2; fres = 0.1; ktrk = 0.6; aA = 0.08; aD = 0.7; aS = 0.85; aR = 0.2; fA = 0.12; fD = 0.8; fS = 0.5;
    pe_amt = -1; pe_t = 0.08; vib = 4.8; vibd = 0.4; br_lvl = 0.04; chf = 0.06; mono = 1; glide = 0.08; chor = 0.2; lvl = 0.38;
  ) : s == 89 ? (
    o1w = 1; o2l = 0; det = 0; fbase = 1800; famt = 0.3; fres = 0; aA = 0.15; aD = 1; aS = 0.9; aR = 0.5; fA = 0.15; fD = 1; fS = 0.9; flfo = 0.2;
    br_lvl = 0.45; brp = 1; chf = 0.3; vib = 4.5; vibd = 0.4; chor = 0.6; lvl = 0.5; dl_mix = 0.3; dl_bt = 1; dl_fb = 0.45;
  ) : s == 90 ? (
    o1w = 1; o2l = 0; det = 0; fbase = 900; famt = 0.2; fres = 0; aA = 0.1; aD = 1.5; aS = 0.3; aR = 0.4; fA = 0.1; fD = 1; fS = 0.8;
    vamix = 0.25; chor = 0.2; lvl = 0.6;
    ks_lvl = 1; ks_T = 1.8; ks_br = 0.35; ks_pick = 0;
    spl_on = 1; lw_type = 1; lw_lvl = 0.39;
  ) : s == 91 ? (
    o1w = 1; o2l = 0; det = 0; fbase = 3000; famt = 0.3; fres = 0; aA = 0.07; aD = 1; aS = 0.9; aR = 0.3; fA = 0.08; fD = 1; fS = 0.9;
    br_lvl = 0.2; brp = 1; chf = 0.15; vib = 5.2; vibd = 0.5; chor = 0.4; lvl = 0.45;
    spl_on = 1; lw_type = 4; lw_lvl = 1.64;
  ) : s == 92 ? (
    o1w = 1; o2l = 0; det = 0; fbase = 1200; famt = 0.2; fres = 0; aA = 0.2; aD = 2; aS = 0.4; aR = 0.5; fA = 0.2; fD = 1; fS = 0.7;
    vamix = 0.1; chf = 0.06; chor = 0.8; lvl = 0.55; dl_mix = 0.15; dl_bt = 0.75; dl_fb = 0.3;
    ks_lvl = 1; ks_T = 2.2; ks_br = 0.6; ks_pick = 1;
    spl_on = 1; lw_type = 2; lw_lvl = 0.28;
  ) : s == 93 ? (
    o1w = 1; o2l = 0; det = 0; fbase = 2200; famt = 0.3; fres = 0; aA = 0.08; aD = 1; aS = 0.9; aR = 0.3; fA = 0.1; fD = 1; fS = 0.9;
    br_lvl = 0.28; brp = 1; chf = 0.3; pe_amt = -0.5; pe_t = 0.1; vib = 5; vibd = 0.6; chor = 0.3; lvl = 0.45; dl_mix = 0.2; dl_bt = 0.75; dl_fb = 0.3;
    spl_on = 1; lw_type = 5; lw_lvl = 1.86;
  ) : s == 94 ? (
    chor = 0.5; lvl = 1;
    spl_on = 1; lw_type = 2; lw_lvl = 1.12;
  ) : s == 95 ? (
    det = 0.006; o2l = 1; fbase = 300; famt = 3; fres = 0.15; aA = 0.02; aD = 0.5; aS = 0.8; aR = 0.3; fA = 0.06; fD = 0.5; fS = 0.45;
    vf = 0.6; chor = 0.5; lvl = 0.36;
    spl_on = 1; lw_type = 3; lw_lvl = 1.24;
  );
  s == 9 ? ( dl_mix = 0.3; dl_bt = 0.75; dl_fb = 0.4; );
  s == 10 ? ( ks_br = 0.65; bl_lvl = 0.3; dl_mix = 0.12; dl_bt = 0.5; dl_fb = 0.25; );
  s == 12 ? ( dl_mix = 0.15; dl_bt = 1; dl_fb = 0.3; );
  form == 1 ? ( fA1.svf_set(730, 5); fA2.svf_set(1090, 7); fA3.svf_set(2440, 9); ) :
  form == 2 ? ( fA1.svf_set(320, 5); fA2.svf_set(800, 6); fA3.svf_set(2300, 8); ) :
  form == 3 ? ( fA1.svf_set(530, 5); fA2.svf_set(1840, 7); fA3.svf_set(2480, 9); );
);

function ks_setup(v, b, f0, vg, h, Ts, bright, pick) local(L, x, j, rr, x2_) (
  L = srate / f0;
  b[F_KL] = L; b[F_KW] = floor(L); b[F_KLP] = 0; b[F_KAP] = 0; b[F_KHP] = 0; b[F_KX] = 0; b[F_O3] = 1;
  b[F_KG] = 10 ^ (-3 / (Ts * f0));
  b[F_KPO] = pick ? max(floor(L * 0.13), 1) : 0;
  x = 0; x2_ = 0; j = 0;
  loop(min(ceil(L) + 2, KSL),
    rr = rand(2) - 1; x += (rr - x) * (bright * (0.3 + 0.7 * h));
    x2_ += (x - x2_) * 0.6;
    KSB[v * KSL + j] = x2_ * vg * 0.45 * sin($pi * min(j / L, 1)) * (j < L * 0.5 ? 1 : 0.7);
    j += 1;
  );
);
function ks_tick(av, b, pick, bite) local(lc_, L, Li, fr, w_, ofs, rp, sv, ac, ap, lpv, gk, pq, y) (
  lc_ = 0.72 + 0.26 * tone;
  L = b[F_KL] / pdrift - (1 - lc_) / lc_;
  Li = floor(L); fr = L - Li; fr < 0.1 ? ( Li -= 1; fr += 1; );
  w_ = b[F_KW]; ofs = av * KSL;
  rp = w_ - Li; rp < 0 ? rp += KSL;
  sv = KSB[ofs + rp];
  ac = (1 - fr) / (1 + fr);
  ap = ac * sv + b[F_KX] - ac * b[F_KAP];
  b[F_KX] = sv; b[F_KAP] = ap;
  lpv = b[F_KLP] + (ap - b[F_KLP]) * lc_;
  b[F_KLP] = lpv;
  gk = held ? b[F_KG] : b[F_KG] * 0.8;
  KSB[ofs + w_] = lpv * gk;
  b[F_KW] = (w_ + 1) % KSL;
  pick ? ( pq = w_ - b[F_KPO]; pq < 0 ? pq += KSL; y = sv - KSB[ofs + pq]; ) : y = sv;
  b[F_KHP] += (y - b[F_KHP]) * 0.02; y -= b[F_KHP];
  y = bite ? tanh_(y * 1.5) * 3.5 : y * 2.2;
  b[F_O3] = b[F_O3] * 0.9995 + abs(y) * 0.0005;
  y;
);
function bell_set(b, f0, vg, h, ratio, amp, dk, k) local(w) (
  w = 2 * $pi * min(f0 * ratio, srate * 0.45) / srate;
  b[F_MS + k] = 0; b[F_MC + k] = 1; b[F_MWS + k] = sin(w); b[F_MWC + k] = cos(w);
  b[F_MA + k] = f0 * ratio < srate * 0.45 ? amp : 0; b[F_MD + k] = tc(dk);
);
function bell_tick(b, rel) local(k, s_, y) (
  k = 0; y = 0; bell_amp = 0;
  loop(4,
    s_ = b[F_MS + k] * b[F_MWC + k] + b[F_MC + k] * b[F_MWS + k];
    b[F_MC + k] = b[F_MC + k] * b[F_MWC + k] - b[F_MS + k] * b[F_MWS + k];
    b[F_MS + k] = s_;
    b[F_MA + k] *= b[F_MD + k] * rel;
    y += s_ * b[F_MA + k]; bell_amp += b[F_MA + k];
    k += 1;
  );
  y;
);

function pn_set(b, k, f, amp, tq) local(w) (
  w = 2 * $pi * min(f, srate * 0.45) / srate;
  b[P_MS + k] = 0; b[P_MC + k] = 1; b[P_WS + k] = sin(w); b[P_WC + k] = cos(w);
  b[P_MA + k] = f < srate * 0.45 ? amp : 0; b[P_MD + k] = tq > 0 ? tc(tq) : 1;
);
function pn_tick(b, rel) local(k, s_, y) (
  k = 0; y = 0; pn_amp = 0;
  loop(16,
    b[P_MA + k] > 0.00001 ? (
      s_ = b[P_MS + k] * b[P_WC + k] + b[P_MC + k] * b[P_WS + k];
      b[P_MC + k] = b[P_MC + k] * b[P_WC + k] - b[P_MS + k] * b[P_WS + k];
      b[P_MS + k] = s_;
      b[P_MA + k] *= b[P_MD + k] * rel;
      y += s_ * b[P_MA + k]; pn_amp += b[P_MA + k];
    );
    k += 1;
  );
  y;
);
function pn_norm(b) local(k, m) (
  k = 0; loop(16, m = sqrt(sqr(b[P_MS + k]) + sqr(b[P_MC + k])); m > 0 ? ( b[P_MS + k] /= m; b[P_MC + k] /= m; ); k += 1; );
);

function vfree() local(v, best, ba) (
  best = -1; v = 0;
  loop(cnv, best < 0 && !cvb[v * VS + F_ACT] ? best = v; v += 1; );
  best < 0 ? ( ba = 1000000000; v = 0; loop(cnv, (cvb[v * VS + F_AGE] + (cvb[v * VS + F_G] ? 100000000 : 0)) < ba ? ( ba = cvb[v * VS + F_AGE] + (cvb[v * VS + F_G] ? 100000000 : 0); best = v; ); v += 1; ); );
  best;
);

function note_on(n, vel) local(v, b, f0, vg, h, Tn, j, k, L, x, rr, ratio, amp, dk, w, was, hd, Bc) (
  f0 = 440 * 2 ^ ((n - 69) / 12) * tune * (eng != 0 ? ins_note_detune() : 1);
  vg = (1 - sens) + sens * (vel / 127) ^ 1.3;
  h = vel / 127;
  mono && eng == 0 ? (
    v = 0;
    b = cvb;
    b[F_DCF] = 1; !b[F_ACT] ? ( b[F_PY] = 0; b[F_PY2] = 0; b[F_DCO] = 0; ); b[F_ATK] = 1;
    mono_n >= 0 && b[F_ACT] && b[F_AE] > 0.01 ? ( b[F_F0] = f0; b[F_G] = 1; b[F_N] = n; b[F_VEL] = vg; mono_n = n; ) : (
      was = b[F_ACT];
      b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0; mono_f = f0;
      b[F_DT] = 1; b[F_VT] = 0; !was ? ( b[F_AE] = 0; b[F_FE] = 0; );
      b[F_AST] = 0; b[F_FST] = 0; mono_n = n;
    );
  ) : (
  v = -1; k = 0; loop(cnv, cvb[k * VS + F_N] == n && cvb[k * VS + F_ACT] ? v = k; k += 1; );
  v < 0 ? v = vfree();
  b = cvb + v * VS;
  age += 1; b[F_AGE] = age;
  was = b[F_ACT];
  b[F_DCF] = 1; !was ? ( b[F_PY] = 0; b[F_PY2] = 0; b[F_DCO] = 0; );
  b[F_ATK] = eng == 0 && ks_lvl == 0 && bl_lvl == 0 ? 1 : 0;
  b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0;
  b[F_DT] = ins_note_detune();
  b[F_E1] = 0;
  b[F_AST] = 0; b[F_FST] = 0; b[F_VT] = 0; !was ? b[F_FE] = 0;
  eng == 0 ? (
    !was ? ( b[F_P1] = rand(1); b[F_P2] = rand(1); b[F_P3] = rand(1); b[F_AE] = 0; b[F_O1] = 0; b[F_O2] = 0; b[F_O3] = 0; );
    Tn = 2 ^ (-(n - 72) / 24) * dec_k;
    k = 0; loop(4, b[F_MA + k] = 0; k += 1; );
    bl_lvl > 0 && !nd ? (
      bell_set(b, f0, vg, h, bR0, vg * bl_lvl * bA0,              bD0 * Tn, 0);
      bell_set(b, f0, vg, h, bR1, vg * bl_lvl * bA1 * (0.5 + h), bD1 * Tn, 1);
      bell_set(b, f0, vg, h, bR2, vg * bl_lvl * bA2 * (0.4 + h), bD2 * Tn, 2);
      bell_set(b, f0, vg, h, bR3, vg * bl_lvl * bA3 * (0.3 + h), bD3 * Tn, 3);
    );
    ks_lvl > 0 ? ks_setup(v + cks, b, f0, vg * ks_lvl, h, ks_T * 2 ^ (-(n - 60) / 24) * dec_k, ks_br, ks_pick);
    b[F_CLK] = chf * vg;
    b[F_PE] = pe_amt;
  ) : eng == 4 ? (
    Tn = 7 * pn_T * 2 ^ (-(n - 40) / 17) * dec_k;
    hd = min(max(pn_hard * (0.15 + 1.15 * h ^ 1.2) + (tone - 0.5) * 0.5, 0.05), 1.15);
    vg = (1 - min(sens * 1.3, 1)) + min(sens * 1.3, 1) * h * h;
    Bc = 0.00025 * 2 ^ ((n - 60) / 20);
    k = 0;
    loop(8,
      j = k + 1;
      ratio = j * sqrt(1 + Bc * j * j);
      amp = vg * j ^ -0.85 * hd ^ ((j - 1) * 0.75) * (0.35 + 0.65 * abs(sin($pi * j * 0.13)) );
      dk = Tn / (1 + 0.45 * (j - 1) * (0.6 + 0.8 * h));
      pn_set(b, k * 2,     f0 * ratio,                                   amp * 0.72, dk * 0.42);
      pn_set(b, k * 2 + 1, f0 * ratio * 2 ^ ((0.9 + 0.5 * k) * pn_uni / 1200), amp * 0.38, dk * 1.5);
      k += 1;
    );
    b[F_CLK] = pn_knock * (0.05 + 0.3 * h * h) * vg;
    b[F_HN] = 0; b[F_HL] = 0; b[F_AE] = 1;
  ) : eng == 5 ? (
    k = 0;
    loop(9,
      ratio = k == 0 ? 0.5 : k == 1 ? 1 : k == 2 ? 1.5 : k == 3 ? 2 : k == 4 ? 3 : k == 5 ? 4 : k == 6 ? 5 : k == 7 ? 6 : 8;
      amp = ORG[org_reg * 9 + k];
      pn_set(b, k, f0 * ratio, amp * vg * 0.5, 0);
      k += 1;
    );
    pn_set(b, 9, f0 * 3, org_perc * (nact == 0 ? 1 : 0.3) * vg * 0.6, 0.35);
    b[F_CLK] = 0.15 * vg * org_clk;
    !was || org_at <= 0.001 ? b[F_AE] = org_at > 0.001 ? 0 : 1;
    b[F_HN] = 0; b[F_HL] = 0;
  ) :
  eng == 1 ? (
    !was ? ( b[F_O1] = 0; b[F_O2] = 0; b[F_O3] = 0; b[F_O4] = 0; );
    Tn = 4.5 * fm_dk * 2 ^ (-(n - 48) / 20);
    b[F_E1] = vg; b[F_E2] = (0.9 + 1.6 * h) * fm_bark; b[F_E3] = vg * 0.55; b[F_E4] = (0.6 + 2.2 * h * h) * fm_tine;
    b[F_MD] = tc(Tn * dec_k); b[F_MD + 1] = tc(Tn * 0.35 * dec_k); b[F_MD + 2] = tc(Tn * 0.4 * dec_k); b[F_MD + 3] = tc(0.09 + 0.05 * (1 - h));
    b[F_AE] = 1;
  ) : eng == 2 ? (
    ks_setup(v + cks, b, f0, vg, h, 4 * 2 ^ (-(n - 48) / 24) * dec_k, 0.4, 1);
    b[F_AE] = 1;
  ) : (
    Tn = 3.2 * 2 ^ (-(n - 72) / 24) * dec_k;
    k = 0;
    loop(4,
      ratio = k == 0 ? 1 : k == 1 ? 2.756 : k == 2 ? 5.404 : 8.933;
      amp = vg * (k == 0 ? 1 : k == 1 ? 0.22 + 0.25 * h : k == 2 ? 0.08 + 0.15 * h : 0.04 + 0.08 * h);
      dk = Tn * (k == 0 ? 1 : k == 1 ? 0.35 : k == 2 ? 0.14 : 0.07);
      bell_set(b, f0, vg, h, ratio, amp, dk, k);
      k += 1;
    );
    b[F_CLK] = vg * (0.1 + 0.15 * h);
    b[F_AE] = 1;
  );
  ntv = 1 + (rand(2) - 1) * 0.3 * dm_a;
  b[F_CLK] *= ntv;
  eng == 1 ? b[F_E4] *= ntv : ( k = 1; loop(3, b[F_MA + k] *= ntv; k += 1; ); );
  );
  lastb = b;
);
function note_off(n) local(v, b) (
  v = 0; loop(cnv, b = cvb + v * VS; b[F_N] == n && b[F_G] ? ( b[F_G] = 0; b[F_S] = pedal; ); v += 1; );
  mono && n == mono_n ? mono_n = -1;
);
function pedal_set(on) local(v) ( pedal = on; !on ? ( v = 0; loop(NV + LWN, VB[v * VS + F_S] = 0; v += 1; ); v = 0; loop(NA, AVB[v * VS + F_S] = 0; v += 1; ); ); );
function all_off() local(v) ( v = 0; loop(NV + LWN, VB[v * VS + F_G] = 0; VB[v * VS + F_S] = 0; v += 1; ); v = 0; loop(NA, AVB[v * VS + F_G] = 0; AVB[v * VS + F_S] = 0; v += 1; ); pedal = 0; at_t = 0; );
function att_kill() ( memset(AVB, 0, NA * VS); memset(KSB + AKV * KSL, 0, NA * KSL); att_n = 0; );
function kill_all() ( memset(VB, 0, (NV + LWN) * VS); memset(KSB, 0, NV * KSL); memset(KSB + LKV * KSL, 0, LWN * KSL); pedal = 0; mono_n = -1; );

function lw_note_on(n, vel) local(v, b, k, ba, f0, vg, h, Tn) (
  f0 = 440 * 2 ^ ((n - 69) / 12) * tune;
  vg = (1 - sens) + sens * (vel / 127) ^ 1.3; h = vel / 127;
  v = -1; k = 0; loop(LWN, LWB[k * VS + F_N] == n && LWB[k * VS + F_ACT] ? v = k; k += 1; );
  v < 0 ? ( k = 0; loop(LWN, v < 0 && !LWB[k * VS + F_ACT] ? v = k; k += 1; ); );
  v < 0 ? ( ba = 1000000000; k = 0; loop(LWN, LWB[k * VS + F_AGE] < ba ? ( ba = LWB[k * VS + F_AGE]; v = k; ); k += 1; ); );
  b = LWB + v * VS;
  lw_was = b[F_ACT];
  age += 1; b[F_AGE] = age;
  b[F_N] = n; b[F_G] = 1; b[F_S] = 0; b[F_ACT] = 1; b[F_VEL] = vg; b[F_F0] = f0; b[F_HN] = 0; b[F_HL] = 0;
