function att_leave() ( st_put(SATT); lay_get(LBOD); st_get(SBOD); va_res = fres + fl_rs * (1.02 - fres); cvb = VB; cnv = NV; cks = 0; cisatt = 0; );
function kk_on(n, vel) local(lw) (
  lw = spl_on && n < spl_pt;
  lastb = 0; k_note_on(n, vel);
  bl_vel_d = vel / 127; bl_cnt_d += 1;
  !lw && lastb ? ( lastb[F_AG] = 0; lastb[F_AL] = ab_len * (dm_a > 0 ? 1 + (rand(2) - 1) * 0.25 * dm_a : 1); lastb[F_AV] = dm_a > 0 ? 1 + (rand(2) - 1) * 0.2 * dm_a : 1; );
  att_on && !lw && !att_pend ? (
    att_any = 1; att_enter();
    tune *= 2 ^ ((rand(2) - 1) * 8 * dm_a / 1200);
    note_on(n, vel);
    lastb[F_AG] = 0;
    lastb[F_AL] = ab_len * (1 + (rand(2) - 1) * 0.25 * dm_a);
