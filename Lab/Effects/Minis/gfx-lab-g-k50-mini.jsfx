  );
  p == 15 ? (
    slider1 = 25; slider2 = 50; slider3 = 0; slider4 = 0; slider5 = 100; slider7 = 0; slider17 = 0; slider18 = 0;
    slider23 = 25; slider26 = 0; slider27 = 24; slider28 = 0; slider29 = 250; slider30 = 250; slider31 = -48;
    slider32 = 0; slider33 = 0.8; slider34 = 50; slider35 = 0; slider36 = 0; slider37 = 0; slider38 = 0;
    slider39 = 0; slider40 = 0; slider41 = 50; slider42 = 375; slider43 = 3; slider44 = 25; slider45 = 15;
    slider46 = 1; slider47 = 0; slider48 = 1; slider49 = 4; slider50 = 4; slider51 = 55; slider52 = 0; slider53 = 0;
    slider54 = 0; slider55 = 0;
  );
  p == 16 ? (
    slider1 = 37; slider2 = 50; slider3 = 0; slider4 = 0; slider5 = 100; slider7 = 0; slider17 = 0; slider18 = 0;
    slider23 = 25; slider26 = 0; slider27 = 81; slider28 = 100; slider29 = 260; slider30 = 250; slider31 = -3.0;
    slider32 = 0; slider33 = 0.8; slider34 = 50; slider35 = 0; slider36 = 0; slider37 = 0; slider38 = 0;
    slider39 = 0; slider40 = 0; slider41 = 50; slider42 = 375; slider43 = 4; slider44 = 40; slider45 = 30;
    slider46 = 1; slider47 = 0; slider48 = 1; slider49 = 4; slider50 = 2; slider51 = 0; slider52 = 0; slider53 = 0;
    slider54 = 0; slider55 = 0;
  );
  slider37 = slider31 > -47.95 ? 1 : 0;
  prs_keep1 = slider1 != snd; prs_keep2 = slider27 != att_cur;
  k_ = 1; loop(55, slider_automate(2 ^ (k_ - 1)); k_ += 1; );
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(56, i != 56 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= NPR ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(NPR, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;
function kn_hash() local(i, h) ( h = 0; i = 1; loop(55, i != 1 && i != 27 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function kn_chk() (
  slider1 != kn_s1 || slider27 != kn_s2 ? (
    kn_hash() != kn_h0 ? ( slider1 != kn_s1 ? prs_keep1 = 1; slider27 != kn_s2 ? prs_keep2 = 1; );
    kn_s1 = slider1; kn_s2 = slider27;
  );
);

function k_gap() (
  kill_all(); att_kill(); all_off(); lx_pcn = 0;
  memset(cbuf, 0, 8192); memset(DLB, 0, 262144); dl_tail = 0; dlpL = dlpR = 0;
  memset(rpre_b, 0, rln_b + 8 * RBLK - rpre_b); memset(rlz, 0, 8); rv_tail = 0;
  memset(FXC, 0, 16384 + 8192 + 2 * FXDN); fd_lpL = fd_lpR = 0;
  gf1 = gf2 = 0; ostL.ost_ch_init(); ostR.ost_ch_init(); ins_sc1 = ins_sc2 = 0;
  k_fi = 0;
);
k_fi = 1; k_fis = 1 / (0.01 * srate); k_tp = 0;
k_msq = 0; k_pkm = 0;
pwr_init(); pwr_wu_loss = 0.3; pwr_wu_drv = 0.5; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0; pwr_sag = 0.15;

update();
lx_coefs(); att_cur = slider27; att_build(); ab_s = ab_t; v1_g = v1_gt; att_og = v2_gt;
att_enter(); fl_f1 = fl_fo = filt_oct; fl_t1 = fl_to = tone_oct; fl_rs = reso; fl_n = 0; ab_s = ab_t; att_leave();
kn_s1 = slider1; kn_s2 = slider27; kn_h0 = kn_hash();
out_s = out_t;
ui_dflt = 1;

function lay_run() (
  lr = 0; av = 0;
  loop(cnv,
    b = cvb + av * VS;
    b[F_ACT] ? (
      nact += 1;
      held = b[F_G] || b[F_S];
      y = 0;
      eng == 0 ? (
        mono ? ( mono_f += (b[F_F0] - mono_f) * gl_c; f = mono_f; ) : f = b[F_F0];
        b[F_VT] = min(b[F_VT] + 1 / (0.6 * srate), 1);
        f *= b[F_DT] * pdrift * (1 + (vibd * 0.006 * b[F_VT] * (vib > 0) + (modw + at_v * at_s) * 0.008) * sin(2 * $pi * vph));
        b[F_PE] != 0 ? ( f *= 2 ^ (b[F_PE] / 12); b[F_PE] *= pe_c; abs(b[F_PE]) < 0.001 ? b[F_PE] = 0; );
        dt = f / srate;
        b[F_P1] += dt * (1 + det); b[F_P1] >= 1 ? b[F_P1] -= 1;
        b[F_P2] += dt * (1 - det); b[F_P2] >= 1 ? b[F_P2] -= 1;
        b[F_P3] += dt * 0.5;       b[F_P3] >= 1 ? b[F_P3] -= 1;
        x = (o1w == 2 ? sqw(b[F_P1], dt * (1 + det)) : o1w ? 1.2 * sin(2 * $pi * b[F_P1]) : saw(b[F_P1], dt * (1 + det))) + o2l * (o2w ? sqw(b[F_P2], dt) : saw(b[F_P2], dt * (1 - det))) + subl * sqw(b[F_P3], dt * 0.5);
        held ? (
          b[F_AST] == 0 ? ( b[F_AE] += a_inc; b[F_AE] >= 1 ? ( b[F_AE] = 1; b[F_AST] = 1; ); ) : b[F_AE] = aS_m + (b[F_AE] - aS_m) * a_dec;
          b[F_FST] == 0 ? ( b[F_FE] += f_inc; b[F_FE] >= 1 ? ( b[F_FE] = 1; b[F_FST] = 1; ); ) : b[F_FE] = fS + (b[F_FE] - fS) * f_dec;
        ) : ( b[F_AE] *= a_rel; b[F_FE] *= a_rel; );
        fc = fbase * 2 ^ (famt * b[F_FE] * (vf > 0 ? (1 - vf) * (0.6 + 0.4 * b[F_VEL]) + vf * b[F_VEL] * b[F_VEL] * 1.2 : 0.6 + 0.4 * b[F_VEL]) + fl_to + fl_fo + b[F_E1] + ins_cut + ktrk * log(f / 261.6) / log(2) + flfo * sin(2 * $pi * flph) + at_f * at_s);
        g = tan($pi * min(fc, srate * 0.42) / srate); gG = g / (1 + g);
        u = tanh_(x * 0.5 - va_res * 3.9 * b[F_S4]);
        v_ = (u - b[F_S1]) * gG; y1 = v_ + b[F_S1]; b[F_S1] = y1 + v_;
        v_ = (y1 - b[F_S2]) * gG; y2 = v_ + b[F_S2]; b[F_S2] = y2 + v_;
        v_ = (y2 - b[F_S3]) * gG; y3 = v_ + b[F_S3]; b[F_S3] = y3 + v_;
        v_ = (y3 - b[F_S4]) * gG; y4 = v_ + b[F_S4]; b[F_S4] = y4 + v_;
        y = y4 * b[F_AE] * b[F_VEL] * 2 * (1 + 0.8 * va_res) * vamix * (1 + at_l * at_s);
        bl_lvl > 0 ? y += 0.6 * bell_tick(b, held ? 1 : gl_rel) : bell_amp = 0;
        ks_lvl > 0 ? y += ks_tick(av + cks, b, ks_pick, ks_bite) : b[F_O3] = 0;
        br_lvl > 0 || b[F_CLK] > 0.0005 ? (
          b[F_O1] += (nz - b[F_O1]) * 0.35; b[F_O2] += (b[F_O1] - b[F_O2]) * 0.03;
          brp ? (
            bfc = 2 * sin($pi * min(f * 2, 6000) / srate);
            b[F_KLP] += bfc * b[F_KAP]; bfh = nz * br_lvl * b[F_AE] * b[F_VEL] - b[F_KLP] - 0.3 * b[F_KAP]; b[F_KAP] += bfc * bfh;
            y += b[F_KAP] * 0.8 + (b[F_O1] - b[F_O2]) * b[F_CLK];
          ) : y += (b[F_O1] - b[F_O2]) * (br_lvl * b[F_AE] * b[F_VEL] + b[F_CLK]);
          b[F_CLK] *= chf_d;
        );
        !held && b[F_AE] < 0.0003 && bell_amp < 0.0003 && b[F_O3] < 0.0002 ? (
          b[F_ACT] = 0; ks_lvl > 0 ? memset(KSB + (av + cks) * KSL, 0, KSL);
        );
      ) : eng == 1 ? (
        f = b[F_F0] * pdrift * (1 + modw * 0.008 * sin(2 * $pi * vph));
        b[F_O1] += f / srate;          b[F_O1] -= floor(b[F_O1]);
        b[F_O2] += f / srate;          b[F_O2] -= floor(b[F_O2]);
        b[F_O3] += f * 1.0017 / srate; b[F_O3] -= floor(b[F_O3]);
        b[F_O4] += f * fm_tr / srate;     b[F_O4] -= floor(b[F_O4]);
        br = 2 ^ (tone_oct * 0.5);
        m2 = sin(2 * $pi * b[F_O2]) * b[F_E2] * br;
        m4 = sin(2 * $pi * b[F_O4]) * b[F_E4] * br;
        y = (0.62 * sin(2 * $pi * b[F_O1] + m2) * b[F_E1] + 0.42 * sin(2 * $pi * b[F_O3] + m4) * b[F_E3]);
        rm = held ? 1 : fm_rel;
        b[F_E1] *= b[F_MD] * rm; b[F_E2] *= b[F_MD + 1]; b[F_E3] *= b[F_MD + 2] * rm; b[F_E4] *= b[F_MD + 3];
        y *= 0.6;
        b[F_E1] + b[F_E3] < 0.0003 ? b[F_ACT] = 0;
      ) : eng == 4 ? (
        rm = held ? 1 : pn_damp;
        y = pn_tick(b, rm) * 0.5;
        b[F_CLK] > 0.0003 ? (
          b[F_HN] += (nz - b[F_HN]) * 0.08; b[F_HL] += (b[F_HN] - b[F_HL]) * 0.02;
          y += (b[F_HN] - b[F_HL] * 0.6) * b[F_CLK]; b[F_CLK] *= pn_kd;
        );
        pn_amp < 0.0003 && b[F_CLK] < 0.0003 ? b[F_ACT] = 0;
      ) : eng == 5 ? (
        held ? ( !b[F_AST] ? ( b[F_AE] = min(b[F_AE] + org_ai, 1); b[F_AE] >= 1 ? b[F_AST] = 1; ) :
          b[F_AE] = org_s + (b[F_AE] - org_s) * org_dk; ) : b[F_AE] *= org_rel;
        y = pn_tick(b, 1) * b[F_AE];
        b[F_CLK] > 0.0003 ? ( b[F_HN] += (nz - b[F_HN]) * 0.5; y += (nz - b[F_HN]) * b[F_CLK]; b[F_CLK] *= org_ck; );
        !held && b[F_AE] < 0.0003 ? b[F_ACT] = 0;
      ) : eng == 2 ? (
        y = ks_tick(av + cks, b, 1, 1);
        !held && b[F_O3] < 0.0002 ? ( b[F_ACT] = 0; memset(KSB + (av + cks) * KSL, 0, KSL); );
      ) : (
        y = bell_tick(b, held ? 1 : gl_rel); amp = bell_amp;
        b[F_CLK] > 0.0005 ? ( b[F_KHP] += (nz - b[F_KHP]) * 0.45; y += (nz - b[F_KHP]) * b[F_CLK]; b[F_CLK] *= 0.993; );
        y *= 0.6;
        amp < 0.0003 && b[F_CLK] < 0.0005 ? b[F_ACT] = 0;
      );
      b[F_ATK] < 1 ? ( b[F_ATK] = min(b[F_ATK] + fi_step, 1); y *= b[F_ATK]; );
      b[F_AG] += 1 / srate;
      ab_s < 0.999 ? (
        ag_l = b[F_AL];
        b[F_AG] < 0.35 * ag_l ? ag = 1 : ( ag_u = (b[F_AG] - 0.35 * ag_l) / (0.65 * ag_l); ag = ag_u >= 1 ? 0 : 0.5 + 0.5 * cos($pi * ag_u); );
        ag = ab_s + (1 - ab_s) * ag * b[F_AV];
        ab_s < 0.0005 && b[F_AG] >= ag_l ? ( b[F_ACT] = 0; memset(KSB + (av + cks) * KSL, 0, KSL); );
        y *= ag;
      );
      cisatt ? att_n += 1;
      b[F_DCF] ? ( b[F_DCO] = 2 * b[F_PY] - b[F_PY2] - y; b[F_DCF] = 0; );
      y += b[F_DCO]; b[F_DCO] *= dc_k;
      b[F_PY2] = b[F_PY]; b[F_PY] = y;
      lr += y;
    );
    av += 1;
  );
  lr;
);

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
kn_chk();
update();
kn_h0 = kn_hash();

@block
prs_chk();
kn_chk();
evn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  stt = m1 & 0xF0; mch = (m1 & 0x0F) + 1;
  (chan == 0 || mch == chan) && evn < 512 ? (
    evq[evn * 4] = mofs; evq[evn * 4 + 1] = stt; evq[evn * 4 + 2] = m2; evq[evn * 4 + 3] = m3; evn += 1;
  );
  midisend(mofs, m1, m2, m3);
);
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( all_off(); lx_pcn = 0; );
gfx_pst_prev = gfx_pst;
evi = 0; spos = 0;
panic_dirty ? ( all_off(); lx_pcn = 0; panic_dirty = 0; );
k_now = time_precise();
k_tp > 0 && k_now - k_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > k_gpp && play_position - k_gpp < 4 * k_gpd + 0.05) ? k_gap();
k_tp = k_now; k_gpp = play_position; k_gpd = samplesblock / srate;
pwr_block(1);
k_vu_d = max(k_vu_d, sqrt(k_msq / max(samplesblock, 1))); k_msq = 0;
k_pk_d = max(k_pk_d, k_pkm); k_pkm = 0;
k_act_d = nact;
lx_pcr = 1 / (0.012 * srate);
update();
ins_drift_block(drift, samplesblock);
pdrift = ins_pitch;
ins_cut = 0; ins_fx = 0; dg_top = 0; dg_ch = 0;
lx_coefs();
slider27 != att_cur && !att_pend ? ( att_n > 0 && att_og > 0.001 ? att_pend = 1 : ( att_kill(); att_cur = slider27; v2_neutral(); ); );
att_build();
!fc_on && fc_g < 0.0001 && !fc_clr ? ( memset(FXC, 0, 16384); fc_clr = 1; );
!fd_on && fd_g < 0.0001 && !fd_clr ? ( memset(FXD, 0, 2 * FXDN); fd_lpL = fd_lpR = 0; fd_clr = 1; );
bt_inc = tempo / 60 / srate;
(play_state & 1) ? bt_pos = beat_position;
dl_len = min(floor(dl_bt * 60 / tempo * srate), 131000);
kn_h0 = kn_hash();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
while (evi < evn && (evq[evi * 4] <= spos || spos >= samplesblock - 1)) (
  e1 = evq[evi * 4 + 1]; e2 = evq[evi * 4 + 2]; e3 = evq[evi * 4 + 3];
  e1 == 0x90 && e3 > 0 ? ( lx_pcf ? lx_hold(e2, e3) : kk_on(e2, e3); midi_led = 1; ins_midi_hit(); ) :
  e1 == 0x80 || e1 == 0x90 ? ( lx_unhold(e2); kk_off(e2); ) :
  e1 == 0xD0 ? at_t = e2 / 127 :
  e1 == 0xA0 ? at_t = e3 / 127 :
  e1 == 0xB0 ? (
    e2 == 64 ? pedal_set(e3 >= 64);
    e2 == 1 ? modw = e3 / 127;
    e2 == 120 || e2 == 123 ? ( all_off(); lx_pcn = 0; );
  );
  evi += 1;
);
spos += 1;
!fl_ok ? ( fl_f1 = fl_fo = filt_oct; fl_t1 = fl_to = tone_oct; fl_rs = reso; fl_ok = 1; );
fl_f1 += (filt_oct - fl_f1) * fl_k; fl_fo += (fl_f1 - fl_fo) * fl_k; fl_t1 += (tone_oct - fl_t1) * fl_k; fl_to += (fl_t1 - fl_to) * fl_k;
fl_rs += (reso - fl_rs) * fl_k;
(fl_n -= 1) <= 0 ? ( fl_n = 16; fl_gf(); );
lx_pcf ? ( lx_pck -= lx_pcr; lx_pck <= 0 ? ( lx_pck = 0; lx_pcapply(); ); lx_pcg = 0.5 - 0.5 * cos($pi * lx_pck); ) :
lx_pck < 1 ? ( lx_pck = min(lx_pck + lx_pcr, 1); lx_pcg = 0.5 - 0.5 * cos($pi * lx_pck); );

nz = rand(2) - 1;
at_s += (at_t - at_s) * at_c;
vph += (vib > 0 ? vib : 5.5) / srate; vph >= 1 ? vph -= 1;
flph += 0.13 / srate; flph >= 1 ? flph -= 1;
nd ? (
  ndst = floor(bt_pos * 4) & 15;
  ndst != nd_last ? (
    nd_last = ndst;
    ndh = ndst == 0 || ndst == 3 || ndst == 6 || ndst == 8 || ndst == 10 || ndst == 11 || ndst == 14;
    ndh ? (
      ndr = ndst == 6 || ndst == 14 ? 1.5 : ndst == 10 ? 2 : ndst == 11 ? 0.75 : 1;
      nda = ndst == 0 || ndst == 8 ? 1 : 0.6;
      av = 0;
      loop(NV,
        b = VB + av * VS;
        b[F_ACT] && (b[F_G] || b[F_S]) ? (
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr,        b[F_VEL] * bl_lvl * nda, 0.22, 0);
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr * 2.76, b[F_VEL] * bl_lvl * nda * 0.35, 0.07, 1);
          bell_set(b, b[F_F0] * 0.5, 1, 1, ndr * 4.1,  b[F_VEL] * bl_lvl * nda * 0.15, 0.04, 2);
          b[F_CLK] = b[F_VEL] * 0.12 * nda;
        );
        av += 1;
      );
    ) : ndst % 2 == 1 ? (
      av = 0; loop(NV, b = VB + av * VS; b[F_ACT] && (b[F_G] || b[F_S]) ? b[F_CLK] = b[F_VEL] * 0.05; av += 1; );
    );
  );
);
bt_pos += bt_inc;
att_og += (v2_gt - att_og) * att_k; v1_g += (v1_gt - v1_g) * att_k;
!att_on && att_og < 0.0005 && att_n > 0 ? att_kill();
att_pend ? ( att_xg -= lx_pcr; att_xg <= 0 ? ( att_xg = 0; att_kill(); att_cur = slider27; att_pend = 0; v2_neutral(); att_build(); ); ) :
  att_xg < 1 ? att_xg = min(att_xg + lx_pcr, 1);
ab_s += (ab_t - ab_s) * sm;
amix = 0; nact = 0;
att_n > 0 || att_any ? (
  att_any = 0; att_enter(); att_n = 0;
  fl_f1 += (filt_oct - fl_f1) * fl_k; fl_fo += (fl_f1 - fl_fo) * fl_k; fl_t1 += (tone_oct - fl_t1) * fl_k; fl_to += (fl_t1 - fl_to) * fl_k;
  fl_rs += (reso - fl_rs) * fl_k; ab_s += (ab_t - ab_s) * sm;
  (fl_n -= 1) <= 0 ? ( fl_n = 16; fl_gf(); );
  amix = lay_run() * lvl;
  form ? ( fo1 = fA1.svf_bp(amix); fo2 = fA2.svf_bp(amix); fo3 = fA3.svf_bp(amix); amix = 0.25 * amix + 1.6 * fo1 + 1.1 * fo2 + 0.7 * fo3; );
  gf_on ? (
    gv3 = amix - gf2; gv1 = gf_a1 * gf1 + gf_a2 * gv3; gv2 = gf2 + gf_a2 * gf1 + gf_a3 * gv3;
    gf1 = 2 * gv1 - gf1; gf2 = 2 * gv2 - gf2; amix = gv2;
  ) : ( gf1 = 0; gf2 = 0; );
  att_leave();
  amix *= att_og * att_xg * att_tr;
);
mix = lay_run();
mix *= lvl;
spl_on ? (
  lwm = 0; av = 0;
  loop(LWN,
    b = LWB + av * VS;
    b[F_ACT] ? (
      nact += 1;
      held = b[F_G] || b[F_S];
      f = b[F_F0] * pdrift;
      lw_type <= 3 ? (
        y = ks_tick(LKV + av, b, lw_type >= 2, 0);
        b[F_P1] += f / srate; b[F_P1] -= floor(b[F_P1]);
        y += sin(2 * $pi * b[F_P1]) * b[F_AE]; b[F_AE] *= held ? b[F_MD] : lw_rel;
        b[F_CLK] > 0.0005 ? ( b[F_HN] += (nz - b[F_HN]) * 0.25; b[F_HL] += (b[F_HN] - b[F_HL]) * 0.05; y += (b[F_HN] - b[F_HL]) * b[F_CLK] * 2; b[F_CLK] *= lw_ck; );
        !held && b[F_O3] < 0.0002 && b[F_AE] < 0.0003 ? ( b[F_ACT] = 0; memset(KSB + (LKV + av) * KSL, 0, KSL); );
      ) : lw_type == 4 ? (
        b[F_O1] += f / srate;          b[F_O1] -= floor(b[F_O1]);
        b[F_O2] += f / srate;          b[F_O2] -= floor(b[F_O2]);
        b[F_O3] += f * 1.0017 / srate; b[F_O3] -= floor(b[F_O3]);
        b[F_O4] += f * 14 / srate;     b[F_O4] -= floor(b[F_O4]);
        y = 0.62 * sin(2 * $pi * b[F_O1] + sin(2 * $pi * b[F_O2]) * b[F_E2]) * b[F_E1] + 0.42 * sin(2 * $pi * b[F_O3] + sin(2 * $pi * b[F_O4]) * b[F_E4]) * b[F_E3];
        rm = held ? 1 : fm_rel;
        b[F_E1] *= b[F_MD] * rm; b[F_E2] *= b[F_MD + 1]; b[F_E3] *= b[F_MD + 2] * rm; b[F_E4] *= b[F_MD + 3];
