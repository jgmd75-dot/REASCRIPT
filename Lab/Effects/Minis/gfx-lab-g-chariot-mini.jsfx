desc:Chariot Mini [Arcana synth] (GFX Lab)
//tags: instrument synth sequencer step sequencer phasing minimalist pulse marimba choir strings brass arcana mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-voice, gfx-lab-power (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-power.jsfx-inc

slider1:0<0,1,1{Stop,Run}>-Run
slider2:52<36,72,1>-Root note (MIDI, no chord held)
slider3:2<0,4,1{1/8,1/8T,1/16,1/16T,1/32}>-Rate
slider4:12<8,16,1>-Length (steps)
slider5:0<0,16,1>-MIDI channel (0 = omni)
slider6:34<-100,100,0.1>-Phase shift (behind .. locked .. ahead)
slider7:0<-16,16,0.01>-Phase (steps)
slider8:0<0,1,1{Drift,Step}>-Phase mode
slider9:4<1,16,1>-Step every (cycles)
slider10:0<0,1000000,1>-Resync (count)
slider11:0<0,2,1{Mallets,Voices,Strings-Brass}>-Track A family
slider12:80<0,100,0.1>-Track A level (%)
slider13:-50<-100,100,1>-Track A pan
slider14:0<-100,100,1>-Track A tone
slider15:0<-2,2,1>-Track A octave
slider16:0<0,2,1{Mallets,Voices,Strings-Brass}>-Track B family
