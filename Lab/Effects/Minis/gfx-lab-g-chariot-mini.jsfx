function load_preset_au(p) local(n, i) (
  i = 0; loop(104, i != 0 && i != 1 && i != 4 && i != 9 && i != 40 && i != 41 && (i < 43 || i > 48) ? PVM[i + 1] = CHDEF[i]; i += 1; );
  strcpy(#ch_ps, ch_pstr_au(p));
  n = ch_nums_au(pk_pitem_au(#ch_ps, 1, #ch_pp), CHTMP);
  i = 0; loop(floor(n / 2), ((CHTMP[i * 2] >= 1 && CHTMP[i * 2] <= 49) || (CHTMP[i * 2] >= 84 && CHTMP[i * 2] <= 104)) ? PVM[CHTMP[i * 2]] = CHTMP[i * 2 + 1]; i += 1; );
  n = ch_nums_au(pk_pitem_au(#ch_ps, 2, #ch_pp), CHTMP); n >= 16 ? ( i = 0; loop(16, PVM[50 + i] = CHTMP[i]; i += 1; ); );
  n = ch_nums_au(pk_pitem_au(#ch_ps, 3, #ch_pp), CHTMP); n >= 16 ? ( i = 0; loop(16, PVM[66 + i] = CHTMP[i]; i += 1; ); );
  pk_pitem_au(#ch_ps, 4, #ch_pp); strlen(#ch_pp) > 4 ? PVM[82] = ch_bits_au(#ch_pp);
  pk_pitem_au(#ch_ps, 5, #ch_pp); strlen(#ch_pp) > 4 ? PVM[83] = ch_bits_au(#ch_pp);
  i = 1; loop(104, pv_nop(i); i += 1; );
  pr_cur = p; ch_panic = 1;
);

function ch_mod(a, n) ( a - floor(a / n) * n; );
function ch_bit(b, s) ( floor(b / 2 ^ s) & 1; );
function ch_rate(v) ( abs(v) < 0.5 ? 0 : sign(v) * 2 ^ (-6 + 6 * (abs(v) - 1) / 99); );
function ch_cnote(i) local(o) ( o = floor(i / ch_cn); CHCH[i - o * ch_cn] + 12 * o; );

function ch_res(v, o, f, t60, g) local(w, r) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; r = exp(-6.91 / (max(t60, 0.01) * srate));
  v[o] = 2 * r * cos(w); v[o + 1] = r * r; v[o + 2] = sin(w) * g;
  r;
);
function ch_vstart(v) local(f, fam, t1, l, ac, g, h) (
  f = v[3]; fam = v[1]; ac = v[7]; g = v[4];
  h = min(max(ch_hard + 0.45 * (v[2] ? ch_fmB : ch_fmA), 0), 1);
  v[9] = 1;
  fam == 0 ? (
    l = max(0.00025 * srate * 8 ^ (1 - h) * (ac ? 0.7 : 1), 1.5);
    v[17] = floor(l + 0.5); v[18] = 0; v[19] = $pi / l; v[20] = $pi / (2 * l);
    v[21] = ch_nzl * (ac ? 1.3 : 1); v[22] = exp(-1 / ((0.0012 + l / srate) * srate));
    v[23] = v[24] = v[25] = v[26] = v[27] = v[28] = v[29] = v[30] = 0;
    t1 = min(max(ch_mdec * (f / 261.6) ^ -0.4, 0.08), 6);
    v[44] = ch_res(v, 31, f, t1, 0.55);
    ch_res(v, 34, f * 3.9, t1 * 0.28, (0.2 + 0.35 * h));
    f * 9.2 < srate * 0.45 ? ch_res(v, 37, f * 9.2, t1 * 0.1, 0.22 * h * h + 0.03) : ( v[37] = v[38] = v[39] = 0; );
    ch_res(v, 40, f, min(t1 * 0.45, 0.7), 0.6);
    v[43] = 1;
  ) : fam == 1 ? (
    v[17] = rand(1); v[18] = rand(1);
    v[19] = min(f * 2 ^ (ch_vspr * 0.12 / 12) / srate, 0.45); v[20] = min(f * 2 ^ (-ch_vspr * 0.12 / 12) / srate, 0.45);
    v[21] = v[22] = v[23] = v[24] = v[25] = v[26] = 0;
    v[27] = 0; v[28] = 1; v[29] = v[8];
    v[30] = 1 / ((0.006 + 0.04 * ch_vlen) * srate); v[31] = exp(-4.6 / ((0.04 + 0.22 * ch_vlen) * srate));
  ) : (
    v[17] = rand(1); v[18] = rand(1);
    v[19] = min(f * 2 ^ ((3 + 9 * ch_blend) / 1200) / srate, 0.45); v[20] = min(f * 2 ^ (-(3 + 9 * ch_blend) / 1200) / srate, 0.45);
    v[21] = v[22] = 0;
    v[27] = 0; v[28] = 1; v[29] = v[8];
    v[30] = 1 / (max(0.004 + ch_swell * 0.7 * v[8] / srate, 0.004) * srate);
    v[31] = exp(-4.6 / (max(0.025 + ch_swell * 0.5 * v[8] / srate, 0.02) * srate));
    v[33] = 0; v[34] = 0; v[35] = 0; v[36] = 1;
  );
  v[0] = 2;
);
function ch_trig(tr, f, g, ac, gate) local(i, v, b, ba, w) (
  b = 0; ba = 10 ^ 30; i = 0;
  loop(5, v = CHV + (tr * 5 + i) * CHVS; v[0] == 0 && !b ? b = v; i += 1; );
  !b ? ( i = 0; loop(5, v = CHV + (tr * 5 + i) * CHVS; v[5] < ba ? ( ba = v[5]; b = v; ); i += 1; ); );
  w = 1 + floor(rand(1) * ch_fate * 0.007 * srate);
  ch_age += 1;
  b[0] == 0 || b[0] == 1 ? (
    b[1] = tr == 0 ? ch_famA : ch_famB; b[2] = tr; b[3] = f; b[4] = g; b[5] = ch_age; b[6] = w; b[7] = ac; b[8] = gate;
    b[9] = 1; b[10] = 0; b[0] = 1;
  ) : (
    b[11] = tr == 0 ? ch_famA : ch_famB; b[12] = f; b[13] = g; b[14] = w; b[15] = ac; b[16] = gate; b[10] = 1; b[5] = ch_age;
    b[0] = 3;
  );
);

function ch_fire(tr, k) local(s, n, f, g, ac, gate) (
  s = ch_mod(k, ch_len);
  tr == 0 ? (
    ch_sa = s;
    s == 0 && ch_stepm ? ( ch_cyc += 1; ch_cyc >= ch_every ? ( ch_cyc = 0; ch_dr += ch_sdir; ); );
  ) : ch_sbs = s;
  ch_bit(PVM[82], s) ? (
    ac = ch_bit(PVM[83], s);
    n = ch_cnote(min(max(PVM[50 + s], 1), 8) - 1) + 12 * (PVM[66 + s] + (tr == 0 ? ch_octA : ch_octB));
    n = min(max(n, 12), 108);
    f = exp((n - 69) * L12) * 440 * (tr == 0 ? ch_pmA : ch_pmB) * ins_note_detune();
    g = (ac ? 1 + 0.8 * ch_accs : 1) * ch_velg * (1 + (rand(2) - 1) * 0.14 * ch_fate);
    gate = max(((tr == 0 ? ch_famA : ch_famB) == 1 ? ch_vlen : ch_slen) * 2 * ch_sss, 0.015 * srate);
    ch_trig(tr, f, g, ac, gate);
    tr == 0 ? ( CHFA[s] = ch_clk; ch_hta = ch_clk; abs(ch_clk - ch_htb) < 0.015 * srate ? ch_coin = ch_clk; ) :
              ( CHFB[s] = ch_clk; ch_htb = ch_clk; abs(ch_clk - ch_hta) < 0.015 * srate ? ch_coin = ch_clk; );
  );
);

function ch_lfo(k) local(b, lb, sy, bars, per, q, p, c, y, sh) (
  b = 84 + k * 7; lb = CHLF + k * 8;
  sy = floor(PVM[b] + 0.5); sh = floor(PVM[b + 2] + 0.5);
  sy > 0 ? (
    bars = 2 ^ (sy - 1); per = bars * ch_bl * 60 / ch_tmp;
    ch_tp ? lb[0] = beat_position / (bars * ch_bl) : lb[0] += samplesblock / srate / per;
  ) : (
    per = 1 / max(PVM[b + 1], 0.001);
    lb[0] += samplesblock / srate / per * (1 + 0.12 * ins_fx * (k == 1 ? -1 : 1) * (k == 2 ? 0.7 : 1));
  );
  lb[0] > 1000000 ? lb[0] -= 1000000;
  q = lb[0] + PVM[b + 6] / 360; c = floor(q); p = q - c;
  c != lb[1] ? ( lb[1] = c; lb[2] = lb[3]; lb[3] = rand(2) - 1; );
  sh == 0 ? y = sin(2 * $pi * p) :
  sh == 1 ? y = p < 0.5 ? 4 * p - 1 : 3 - 4 * p :
  sh == 2 ? y = lb[2] + (lb[3] - lb[2]) * (0.5 - 0.5 * cos($pi * p)) :
  ( lb[4] += (lb[3] - lb[4]) * (1 - exp(-samplesblock / srate / (0.15 * per))); y = lb[4]; );
  lb[5] = y;
);
function ch_lfomod() local(y, v) (
  y = CHLF[5];
  ch_lgA = 1 - PVM[87] / 100 * (1 - y) * 0.5; ch_lAt = ch_lAb * ch_lgA;
  v = (min(max(ch_pAb + PVM[88] / 100 * y, -1), 1) + 1) / 2 * $pi * 0.5; ch_pAlt = cos(v) * 1.4142; ch_pArt = sin(v) * 1.4142;
  ch_fmA = PVM[89] / 100 * y; ch_tAt = min(max(ch_tAb + 0.8 * ch_fmA, -1), 1);
  y = CHLF[13];
  ch_lgB = 1 - PVM[94] / 100 * (1 - y) * 0.5; ch_lBt = ch_lBb * ch_lgB;
  v = (min(max(ch_pBb + PVM[95] / 100 * y, -1), 1) + 1) / 2 * $pi * 0.5; ch_pBlt = cos(v) * 1.4142; ch_pBrt = sin(v) * 1.4142;
  ch_fmB = PVM[96] / 100 * y; ch_tBt = min(max(ch_tBb + 0.8 * ch_fmB, -1), 1);
  ch_brA = 2 ^ (1.3 * ch_fmA); ch_brB = 2 ^ (1.3 * ch_fmB);
  y = CHLF[21];
  ch_lgP = 1 - PVM[101] / 100 * (1 - y) * 0.5; ch_padt = ch_padb * ch_lgP;
  v = min(max(PVM[102] / 100 * y, -1), 1); ch_ppLt = min(1 - v, 1); ch_ppRt = min(1 + v, 1);
  ch_fmP = PVM[103] / 100 * y;
);

function ch_update() local(v) (
  ch_tmp = tempo > 0 ? tempo : 120;
  ch_bl = (ts_num > 0 ? ts_num : 4) * 4 / (ts_denom > 0 ? ts_denom : 4);
  ch_runk = PVM[1] >= 0.5; ch_root = floor(PVM[2] + 0.5);
  v = floor(PVM[3] + 0.5); ch_sb = v == 0 ? 0.5 : v == 1 ? 1 / 3 : v == 2 ? 0.25 : v == 3 ? 1 / 6 : 0.125;
  ch_len = min(max(floor(PVM[4] + 0.5), 8), 16); ch_chan = floor(PVM[5] + 0.5);
  ch_rt = ch_rate(PVM[6]);
  ch_phs = PVM[7];
  ch_stepm = PVM[8] >= 0.5; ch_every = max(floor(PVM[9] + 0.5), 1);
  ch_sdir = PVM[6] < -0.5 ? -1 : 1;
  PVM[10] != ch_rsw ? ( ch_rsw = PVM[10]; ch_resync = 1; );
  ch_famA = floor(PVM[11] + 0.5); ch_famB = floor(PVM[16] + 0.5);
  ch_lAb = sqr(PVM[12] / 100); ch_lBb = sqr(PVM[17] / 100);
  ch_pAb = PVM[13] / 100; ch_pBb = PVM[18] / 100; ch_tAb = PVM[14] / 100; ch_tBb = PVM[19] / 100;
  ch_octA = floor(PVM[15] + 0.5); ch_octB = floor(PVM[20] + 0.5);
  ch_hard = PVM[21] / 100; ch_mdec = PVM[22] / 1000; ch_nzl = sqr(PVM[23] / 100) * 0.9;
  ch_vowt = PVM[24] / 100; ch_vlen = PVM[25] / 100; ch_vspr = PVM[26] / 100;
  ch_blend = PVM[27] / 100; ch_blt = ch_blend; ch_swell = PVM[28] / 100; ch_slen = PVM[29] / 100;
  ch_padb = sqr(PVM[30] / 100); ch_ptont = PVM[31] / 100;
  v = floor(PVM[32] + 0.5); ch_pdb = v == 0 ? 0.25 : v == 1 ? 1 / 6 : v == 2 ? 0.125 : 1 / 3;
  ch_pstrg = v == 0 || v == 2;
  ch_pdpt = PVM[33] / 100; ch_pshpt = PVM[34] / 100; ch_pswg = PVM[35] / 100; ch_ptrt = PVM[36] >= 0.5;
  ch_rsz = PVM[37] / 100; ch_rmixt = PVM[38] / 100 * 0.9;
  v = 0.35 + 2.4 * ch_rsz;
  ch_rg0 = 10 ^ (-3 * ch_rl0 / (v * srate)); ch_rg1 = 10 ^ (-3 * ch_rl1 / (v * srate));
  ch_rg2 = 10 ^ (-3 * ch_rl2 / (v * srate)); ch_rg3 = 10 ^ (-3 * ch_rl3 / (v * srate));
  ch_vib = (8 + 6 * ch_blend) * 0.000578;
  ch_accs = PVM[39] / 100; ch_vels = PVM[40] / 100;
  ch_fate = PVM[41] / 100; ch_volt = 10 ^ (PVM[42] / 20) * sqr(PVM[43] / 100) * 2.5;
  ost_setup(PVM[44] / 100, PVM[45] / 100, PVM[46], PVM[47], PVM[48], 1);
  ch_lfomod();
);
ins_drift_init();
function ch_srinit() local(i, r) (
  ch_sr = srate; ost_init(20000);
  ch_smk = 1 - exp(-1 / (0.02 * srate));
  ch_pgk = 1 - exp(-1 / (0.0007 * srate));
  ch_fdk = 1 / (0.003 * srate);
  ch_pcdn = 1 / (0.012 * srate); ch_pcup = 1 / (0.02 * srate);
  ch_tlk = 1 - exp(-2 * $pi * 900 / srate);
  ch_dck = exp(-2 * $pi * 6 / srate);
  ch_vibi = 2 * $pi * 5.3 / srate;
  r = srate / 48000;
  ch_rl0 = floor(1031 * r); ch_rl1 = floor(1327 * r); ch_rl2 = floor(1601 * r); ch_rl3 = floor(1913 * r);
  ch_al0 = floor(142 * r); ch_al1 = floor(379 * r);
  ch_rdk = 1 - exp(-2 * $pi * 4500 / srate);
  ch_pup = 1 / (0.15 * srate); ch_pdn = 1 / (0.08 * srate);
  ch_pswk = 1 - exp(-8 / (0.45 * srate)); ch_pswf = 1 - exp(-8 / (0.02 * srate)); ch_psw = ch_pswt = 1;
  ch_update();
);
ch_srinit();
ch_pcf = 0; ch_pcg = 1; ch_ct = 7; ch_nkeys = 0; ch_kvel = 0.8; ch_snap = 1; ch_sa = ch_sbs = -1; ch_vs = 0; ch_vc = 1;
ch_rsw = PVM[10]; ch_resync = 0; ch_clk = 0; ch_hta = ch_htb = -1000000000; ch_coin = -1000000000;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function ch_tick() local(q, n, u, p, w, gh, gs, f, g, k, i, v, e, m, ch1, ch2) (
  ch_snap ? (
    ch_lA = ch_lAt; ch_lB = ch_lBt; ch_pAl = ch_pAlt; ch_pAr = ch_pArt; ch_pBl = ch_pBlt; ch_pBr = ch_pBrt;
    ch_tA = ch_tAt; ch_tB = ch_tBt; ch_pad = ch_padt; ch_ptr = ch_ptrt; ch_rmix = ch_rmixt; ch_vow = ch_vowt;
    ch_pdp = ch_pdpt; ch_pshp = ch_pshpt; ch_ptn = ch_ptont; ch_ppL = ch_ppLt; ch_ppR = ch_ppRt; ch_pbl = ch_blt; ch_snap = 0;
  );
  ch_vow += (ch_vowt - ch_vow) * 0.02; ch_pdp += (ch_pdpt - ch_pdp) * 0.05; ch_pshp += (ch_pshpt - ch_pshp) * 0.05;
  ch_ptn += (ch_ptont - ch_ptn) * 0.05;
  q = ch_t * ch_sb / ch_pdb;
  ch_pstrg && ch_pswg > 0 ? (
    u = q - 2 * floor(q / 2);
    p = u < 1 + ch_pswg ? u / (1 + ch_pswg) : (u - 1 - ch_pswg) / (1 - ch_pswg);
    w = 0.0022 * srate / (ch_pdb * 60 / ch_tmp * srate * (u < 1 + ch_pswg ? 1 + ch_pswg : 1 - ch_pswg));
  ) : (
    p = q - floor(q); w = 0.0022 * srate / (ch_pdb * 60 / ch_tmp * srate);
  );
  w = min(max(w, 0.01), 0.2);
  gh = min(min(p / w, (0.52 - p) / w), 1); gh = max(gh, 0);
  gs = sin($pi * p); gs *= gs;
  ch_pgt = ch_runk ? 1 - ch_pdp * (1 - (gh + (gs - gh) * ch_pshp)) : 1;
  v = min(max(ch_vow * 4, 0), 3.9999); i = floor(v); e = v - i;
  ch_fm1 = CHFT[i * 3] + (CHFT[i * 3 + 3] - CHFT[i * 3]) * e;
  ch_fm2 = CHFT[i * 3 + 1] + (CHFT[i * 3 + 4] - CHFT[i * 3 + 1]) * e;
  ch_fm3 = CHFT[i * 3 + 2] + (CHFT[i * 3 + 5] - CHFT[i * 3 + 2]) * e;
  ch1 = CHFG[i * 2] + (CHFG[i * 2 + 2] - CHFG[i * 2]) * e; ch2 = CHFG[i * 2 + 1] + (CHFG[i * 2 + 3] - CHFG[i * 2 + 1]) * e;
  g = tan($pi * min(ch_fm1, srate * 0.45) / srate); k = 70 / ch_fm1;
  ch_a11 = 1 / (1 + g * (g + k)); ch_a12 = g * ch_a11; ch_a13 = g * ch_a12; ch_g1 = k * 1.0;
  g = tan($pi * min(ch_fm2, srate * 0.45) / srate); k = 95 / ch_fm2;
  ch_a21 = 1 / (1 + g * (g + k)); ch_a22 = g * ch_a21; ch_a23 = g * ch_a22; ch_g2 = k * 10 ^ (ch1 / 20);
  g = tan($pi * min(ch_fm3, srate * 0.45) / srate); k = 140 / ch_fm3;
  ch_a31 = 1 / (1 + g * (g + k)); ch_a32 = g * ch_a31; ch_a33 = g * ch_a32; ch_g3 = k * 10 ^ (ch2 / 20);
  i = 0;
  loop(CHNV,
    v = CHV + i * CHVS;
    v[0] == 2 && v[1] == 2 ? (
      e = v[27];
      m = (1.3 + 11 * e * e) * (1 - ch_blt) + (4.5 + 3 * e) * ch_blt;
      g = tan($pi * min(v[3] * m * (v[2] ? ch_brB : ch_brA), srate * 0.42) / srate); k = 1.25 - 0.45 * (1 - ch_blt);
      v[33] = 1 / (1 + g * (g + k)); v[34] = g * v[33]; v[35] = g * v[34];
    );
    i += 1;
  );
  ch_pbl += (ch_blt - ch_pbl) * 0.05;
  ch_pswt += (1 - ch_pswt) * ch_pswk; ch_psw += (ch_pswt - ch_psw) * ch_pswf;
  f = 260 * 2 ^ (ch_ptn * 5.2 + 2 * ch_fmP) * 2 ^ ((1 - ch_blt) * 1.6 * (ch_pg - 1)) * 2 ^ ((1 - ch_pbl) * (0.9 + 1.6 * (ch_psw - 1)) - 0.9 * ch_pbl);
  g = tan($pi * min(f, srate * 0.42) / srate); k = 0.55 + 0.75 * ch_pbl;
  ch_pvd = ch_pbl * 0.0025; ch_pdt = 2 ^ ((1 - ch_pbl) * 11 / 1200); ch_pgc = 1.12 + 0.15 * ch_pbl;
  ch_pa1 = 1 / (1 + g * (g + k)); ch_pa2 = g * ch_pa1; ch_pa3 = g * ch_pa2;
  abs(ch_rs0) + abs(ch_rs1) + abs(ch_rs2) + abs(ch_rs3) < 0.0000000001 ? ch_rs0 = ch_rs1 = ch_rs2 = ch_rs3 = 0;
  abs(ch_pl1) + abs(ch_pl2) + abs(ch_pr1) + abs(ch_pr2) < 0.0000000001 ? ch_pl1 = ch_pl2 = ch_pr1 = ch_pr2 = 0;
  abs(ch_tlA) + abs(ch_tlB) < 0.0000000001 ? ch_tlA = ch_tlB = 0;
  abs(ch_dcl) + abs(ch_dcr) + abs(ch_dclx) + abs(ch_dcrx) < 0.0000000001 ? ch_dcl = ch_dcr = ch_dclx = ch_dcrx = 0;
);
CHFT = 31900; CHFG = 31930;
CHFT[0] = 325; CHFT[1] = 700;  CHFT[2] = 2550;   CHFG[0] = -9;  CHFG[1] = -20;
CHFT[3] = 450; CHFT[4] = 830;  CHFT[5] = 2700;   CHFG[2] = -7;  CHFG[3] = -18;
CHFT[6] = 780; CHFT[7] = 1180; CHFT[8] = 2650;   CHFG[4] = -4;  CHFG[5] = -14;
CHFT[9] = 420; CHFT[10] = 1850; CHFT[11] = 2550; CHFG[6] = -9;  CHFG[7] = -13;
CHFT[12] = 300; CHFT[13] = 2200; CHFT[14] = 2900; CHFG[8] = -13; CHFG[9] = -15;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(62, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function gap_clear() (
  memset(CHV, 0, CHNV * CHVS); memset(CHPD, 0, 6 * CHPS); memset(CHRB, 0, 4 * CHRL); memset(CHAP, 0, 4096);
  ch_pl1 = ch_pl2 = ch_pr1 = ch_pr2 = 0; ch_tlA = ch_tlB = 0; ch_rs0 = ch_rs1 = ch_rs2 = ch_rs3 = 0;
  ch_dcl = ch_dcr = ch_dclx = ch_dcrx = 0; ch_seqw = 0; ch_snap = 1;
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
pwr_init();  pwr_hum_db = -78;  pwr_sag = 0.12;  pwr_wu_loss = 0.25;  pwr_wu_drv = 0.3;  pwr_wu_lp = 12000;  pwr_wu_wob = 0.06;  pwr_bloom = 0;

@slider
pv_in();
prs_chk();
!ch_pcf && !ch_panic ? ch_update();

pv_out();

@block
pv_in();
prs_chk();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? gap_clear();
g_tp = g_now; g_gpp = play_position; g_gpd = samplesblock / srate;
pwr_block(1);
panic_d ? ( panic_d = 0; ch_panic = 1; ch_nkeys = 0; );
srate != ch_sr ? ch_srinit();
ch_xp = play_state & 1;
PVM[105] >= 0.5 && ch_xp != ch_xpw ? ( PVM[1] = ch_xp; pv_nop(1); );
ch_xpw = ch_xp;
ch_panic && !ch_pcf ? ( ch_pcf = 1; ch_panic = 0; );
ch_pcf == 2 ? (
  memset(CHV, 0, CHNV * CHVS); memset(CHPD, 0, 6 * CHPS);
  ch_pl1 = ch_pl2 = ch_pr1 = ch_pr2 = 0; ch_tlA = ch_tlB = 0;
  ch_snap = 1; ch_pcf = 3; ch_resync = 1;
);
ch_pcf != 1 ? ch_update();

while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, ch_chan) ? (
    ch_st = m1 & 0xF0;
    ch_st == 0x90 && m3 > 0 ? (
      ins_midi_hit();
      i_ = 0; j_ = 0; loop(ch_nkeys, CHHL[i_] != m2 ? ( CHHL[j_] = CHHL[i_]; CHHV[j_] = CHHV[i_]; j_ += 1; ); i_ += 1; ); ch_nkeys = j_;
      ch_nkeys < 32 ? ( CHHL[ch_nkeys] = m2; CHHV[ch_nkeys] = m3 / 127; ch_nkeys += 1; );
      ch_kvel = m3 / 127;
    ) : ch_st == 0x80 || (ch_st == 0x90 && m3 == 0) ? (
      i_ = 0; j_ = 0; loop(ch_nkeys, CHHL[i_] != m2 ? ( CHHL[j_] = CHHL[i_]; CHHV[j_] = CHHV[i_]; j_ += 1; ); i_ += 1; ); ch_nkeys = j_;
    ) : ch_st == 0xB0 && (m2 == 120 || m2 == 123) ? (
      ch_nkeys = 0;
    );
  );
  midisend(mofs, m1, m2, m3);
);
ch_nkeys > 0 ? (
  ch_cn = 0; i_ = 0;
  loop(ch_nkeys,
    ch_cn < 8 ? (
      j_ = ch_cn; while (j_ > 0 && CHCH[j_ - 1] > CHHL[i_]) ( CHCH[j_] = CHCH[j_ - 1]; j_ -= 1; ); CHCH[j_] = CHHL[i_]; ch_cn += 1;
    );
    i_ += 1;
  );
  ch_kv = 0; i_ = 0; loop(ch_nkeys, ch_kv += CHHV[i_]; i_ += 1; ); ch_kv /= ch_nkeys;
) : (
  ch_cn = 3; CHCH[0] = ch_root; CHCH[1] = ch_root + 7; CHCH[2] = ch_root + 14; ch_kv = 0.8;
);
ch_velg = min(max(1 + ch_vels * (ch_kv - 0.8) * 1.6, 0.15), 1.4);

ch_tp = play_state & 1;
ch_seqw ? ch_bp = ch_t * ch_sbw;
ch_runk ? (
  ch_jump = 0;
  !ch_seqw ? ( ch_bp = ch_tp ? beat_position : 0; ch_rs = 1; ch_jump = 1; ) :
  ch_tp ? ( (!ch_tpw || abs(beat_position - ch_bp) > 0.05) ? ( ch_rs = 1; ch_jump = 1; ); ch_bp = beat_position; );
  ch_sb != ch_sbw ? ch_rs = 1;
  ch_t = ch_bp / ch_sb;
  ch_dt = ch_tmp / 60 / srate / ch_sb;
  ch_sss = ch_sb * 60 / ch_tmp * srate;
  ch_jump ? (
    ch_dr = 0; ch_cyc = 0;
    ch_tp ? (
      ch_stepm ? ( ch_dr = ch_sdir * floor(floor(ch_t / ch_len) / ch_every); ch_cyc = ch_mod(floor(ch_t / ch_len), ch_every); ) :
                 ch_dr = ch_rt * ch_bp / ch_bl;
      ch_dr = ch_mod(ch_dr, ch_len);
    );
  );
  ch_resync ? ( ch_dr = 0; ch_cyc = 0; ch_resync = 0; ch_rs = 1; );
  ch_ddr = ch_stepm ? 0 : ch_rt / (ch_bl * 60 / ch_tmp * srate) * (1 + 0.3 * ins_fx);
  ch_off = ch_phs + ch_dr;
  ch_rs ? (
    ch_na = ceil(ch_t - 0.0000001);
    ch_nb = ceil(ch_t + ch_off - 0.0000001);
    ch_rs = 0;
  );
  ch_nb - (ch_t + ch_off) > 1.0001 ? ch_nb = ceil(ch_t + ch_off - 0.0000001);
  ch_len != ch_lenw ? ( ch_dr = ch_mod(ch_dr, ch_len); ch_nb = ceil(ch_t + ch_phs + ch_dr - 0.0000001); );
) : (
  ch_seqw ? ( ch_sa = ch_sbs = -1; );
);
ch_seqw = ch_runk; ch_tpw = ch_tp; ch_sbw = ch_sb; ch_lenw = ch_len;
ch_offd = ch_mod(ch_phs + ch_dr, ch_len);

ins_drift_block(ch_fate, samplesblock);
ch_lfo(0); ch_lfo(1); ch_lfo(2); ch_lfomod();
ch_pmA = ins_pitch * 2 ^ (ins_aux * 0.5 / 12); ch_pmB = ins_pitch * 2 ^ (-ins_aux * 0.5 / 12);

pv_out();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, PVM, 300);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
ch_clk += 1;
ch_runk ? (
  ch_t += ch_dt; ch_dr += ch_ddr;
  ch_t >= ch_na ? ( ch_fire(0, ch_na); ch_na += 1; );
  ch_pb = ch_t + ch_phs + ch_dr;
  ch_pb >= ch_nb ? ( ch_nb = floor(ch_pb); ch_fire(1, ch_nb); ch_nb += 1; );
);

(ch_ct += 1) >= 8 ? ( ch_ct = 0; ch_tick(); );

ch_lA += (ch_lAt - ch_lA) * ch_smk; ch_lB += (ch_lBt - ch_lB) * ch_smk;
ch_pAl += (ch_pAlt - ch_pAl) * ch_smk; ch_pAr += (ch_pArt - ch_pAr) * ch_smk;
ch_pBl += (ch_pBlt - ch_pBl) * ch_smk; ch_pBr += (ch_pBrt - ch_pBr) * ch_smk;
ch_tA += (ch_tAt - ch_tA) * ch_smk; ch_tB += (ch_tBt - ch_tB) * ch_smk;
ch_pad += (ch_padt - ch_pad) * ch_smk; ch_ppL += (ch_ppLt - ch_ppL) * ch_smk; ch_ppR += (ch_ppRt - ch_ppR) * ch_smk; ch_ptr += (ch_ptrt - ch_ptr) * ch_smk; ch_rmix += (ch_rmixt - ch_rmix) * ch_smk;
ch_pg += (ch_pgt - ch_pg) * ch_pgk;
ch_vs += ch_vibi * ch_vc; ch_vc -= ch_vibi * ch_vs;

ch_ya = ch_yb = 0; ch_v = CHV;
loop(CHNV,
  ch_v[0] ? (
    ch_v[0] == 1 ? ( (ch_v[6] -= 1) <= 0 ? ch_vstart(ch_v); );
    ch_v[0] >= 2 ? (
      ch_v[1] == 0 ? (
        ch_x = 0;
        ch_v[17] > 0 ? ( ch_x = ch_v[20] * sin(ch_v[18]); ch_v[18] += ch_v[19]; ch_v[17] -= 1; );
        ch_v[21] > 0.0005 ? ( ch_nz = (rand(2) - 1) * ch_v[21]; ch_v[21] *= ch_v[22]; ch_x += ch_nz * 0.06; ) : ch_nz = 0;
        ch_m1 = ch_v[31] * ch_v[23] - ch_v[32] * ch_v[24] + ch_x * ch_v[33]; ch_v[24] = ch_v[23]; ch_v[23] = ch_m1;
        ch_m2 = ch_v[34] * ch_v[25] - ch_v[35] * ch_v[26] + ch_x * ch_v[36]; ch_v[26] = ch_v[25]; ch_v[25] = ch_m2;
        ch_m3 = ch_v[37] * ch_v[27] - ch_v[38] * ch_v[28] + ch_x * ch_v[39]; ch_v[28] = ch_v[27]; ch_v[27] = ch_m3;
        ch_m4 = ch_v[40] * ch_v[29] - ch_v[41] * ch_v[30] + ch_x * ch_v[42]; ch_v[30] = ch_v[29]; ch_v[29] = ch_m4;
        ch_y = (ch_m1 + ch_m2 + ch_m3 + ch_m4 + ch_nz * 0.05) * ch_v[4] * ch_v[9] * 0.62;
        ch_v[43] *= ch_v[44]; ch_v[43] < 0.0004 && ch_v[17] <= 0 ? ch_v[0] = 0;
      ) : (
        ch_v[28] == 1 ? ( ch_v[27] += ch_v[30]; ch_v[27] >= 1 ? ( ch_v[27] = 1; ch_v[28] = 2; ); ) :
        ch_v[28] == 3 ? ( ch_v[27] *= ch_v[31]; ch_v[27] < 0.0002 ? ch_v[0] = 0; );
        ch_v[28] < 3 ? ( (ch_v[29] -= 1) <= 0 ? ch_v[28] = 3; );
        ch_v[17] += ch_v[19] * (1 + ch_vs * ch_vib); ch_v[17] >= 1 ? ch_v[17] -= 1;
        ch_v[18] += ch_v[20] * (1 - ch_vs * ch_vib); ch_v[18] >= 1 ? ch_v[18] -= 1;
        ch_x = 2 * ch_v[17] - 1 - vo_blep(ch_v[17], ch_v[19]) + 2 * ch_v[18] - 1 - vo_blep(ch_v[18], ch_v[20]);
        ch_v[1] == 1 ? (
          ch_u3 = ch_x - ch_v[22]; ch_u1 = ch_a11 * ch_v[21] + ch_a12 * ch_u3; ch_u2 = ch_v[22] + ch_a12 * ch_v[21] + ch_a13 * ch_u3;
          ch_v[21] = 2 * ch_u1 - ch_v[21]; ch_v[22] = 2 * ch_u2 - ch_v[22]; ch_y = ch_u1 * ch_g1;
          ch_u3 = ch_x - ch_v[24]; ch_u1 = ch_a21 * ch_v[23] + ch_a22 * ch_u3; ch_u2 = ch_v[24] + ch_a22 * ch_v[23] + ch_a23 * ch_u3;
          ch_v[23] = 2 * ch_u1 - ch_v[23]; ch_v[24] = 2 * ch_u2 - ch_v[24]; ch_z = ch_u1 * ch_g2;
          ch_u3 = ch_x - ch_v[26]; ch_u1 = ch_a31 * ch_v[25] + ch_a32 * ch_u3; ch_u2 = ch_v[26] + ch_a32 * ch_v[25] + ch_a33 * ch_u3;
          ch_v[25] = 2 * ch_u1 - ch_v[25]; ch_v[26] = 2 * ch_u2 - ch_v[26]; ch_y += (ch_z + ch_u1 * ch_g3) * (ch_v[2] ? ch_brB : ch_brA);
          ch_y *= 1.45;
        ) : (
          ch_u3 = ch_x - ch_v[22]; ch_u1 = ch_v[33] * ch_v[21] + ch_v[34] * ch_u3; ch_u2 = ch_v[22] + ch_v[34] * ch_v[21] + ch_v[35] * ch_u3;
          ch_v[21] = 2 * ch_u1 - ch_v[21]; ch_v[22] = 2 * ch_u2 - ch_v[22]; ch_y = ch_u2 * 0.38;
        );
        ch_y *= ch_v[27] * ch_v[4] * ch_v[9];
      );
      ch_v[0] == 3 ? (
        ch_v[9] -= ch_fdk;
        ch_v[9] <= 0 ? (
          ch_v[10] ? (
            ch_v[1] = ch_v[11]; ch_v[3] = ch_v[12]; ch_v[4] = ch_v[13]; ch_v[6] = ch_v[14]; ch_v[7] = ch_v[15]; ch_v[8] = ch_v[16];
            ch_v[9] = 1; ch_v[10] = 0; ch_v[0] = 1;
          ) : ch_v[0] = 0;
        );
      );
      ch_v[2] == 0 ? ch_ya += ch_y : ch_yb += ch_y;
    );
  );
  ch_v += CHVS;
);

ch_tlA += (ch_ya - ch_tlA) * ch_tlk; ch_ya += ch_tA * (ch_ya - 2 * ch_tlA) * 0.7;
ch_tlB += (ch_yb - ch_tlB) * ch_tlk; ch_yb += ch_tB * (ch_yb - 2 * ch_tlB) * 0.7;
ch_gt = 1 - ch_ptr * (1 - ch_pg);
ch_ya *= ch_lA * ch_gt; ch_yb *= ch_lB * ch_gt;
ch_ol = ch_ya * ch_pAl + ch_yb * ch_pBl; ch_or = ch_ya * ch_pAr + ch_yb * ch_pBr;

ch_pad > 0.00001 || ch_padt > 0 ? (
  ch_xl = ch_xr = 0; ch_i = 0; ch_p = CHPD;
  loop(6,
    ch_tg = ch_runk && ch_i < ch_cn ? CHCH[ch_i] : -1;
    ch_p[0] != ch_tg || !ch_p[7] ? (
      ch_p[1] = max(ch_p[1] - ch_pdn, 0);
      ch_p[1] <= 0 ? (
        ch_p[0] = ch_tg; ch_p[7] = ch_tg >= 0;
        ch_tg >= 0 ? ( ch_p[5] = min(exp((ch_tg - 69) * L12) * 440 * 2 ^ (8 / 1200) / srate, 0.45); ch_p[6] = ch_p[5] * 2 ^ (-16 / 1200); ch_pswt = 0; );
      );
    ) : ( ch_p[1] = min(ch_p[1] + ch_pup, 1); );
    ch_p[1] > 0 ? (
      ch_p[3] += ch_p[5] * (1 + ch_vs * ch_pvd); ch_p[3] >= 1 ? ch_p[3] -= 1;
      ch_p[4] += ch_p[6] * ch_pdt * (1 - ch_vs * ch_pvd); ch_p[4] >= 1 ? ch_p[4] -= 1;
      ch_xl += (2 * ch_p[3] - 1 - vo_blep(ch_p[3], ch_p[5])) * ch_p[1];
      ch_xr += (2 * ch_p[4] - 1 - vo_blep(ch_p[4], ch_p[6])) * ch_p[1];
    );
    ch_i += 1; ch_p += CHPS;
  );
  ch_u3 = ch_xl - ch_pl2; ch_u1 = ch_pa1 * ch_pl1 + ch_pa2 * ch_u3; ch_u2 = ch_pl2 + ch_pa2 * ch_pl1 + ch_pa3 * ch_u3;
  ch_pl1 = 2 * ch_u1 - ch_pl1; ch_pl2 = 2 * ch_u2 - ch_pl2; ch_xl = ch_u2;
  ch_u3 = ch_xr - ch_pr2; ch_u1 = ch_pa1 * ch_pr1 + ch_pa2 * ch_u3; ch_u2 = ch_pr2 + ch_pa2 * ch_pr1 + ch_pa3 * ch_u3;
  ch_pr1 = 2 * ch_u1 - ch_pr1; ch_pr2 = 2 * ch_u2 - ch_pr2; ch_xr = ch_u2;
  ch_pgn = ch_pad * ch_pg * 0.56 * ch_pgc;
  ch_ol += ch_xl * ch_pgn * ch_ppL; ch_or += ch_xr * ch_pgn * ch_ppR;
);

ch_rmix > 0.0001 || abs(ch_rs0) + abs(ch_rs2) > 0.00001 ? (
  ch_x = (ch_ol + ch_or) * 0.5 * ch_rmix + 0.000000000000000001;
  ch_d = CHAP[(ch_ap0 - ch_al0) & 2047]; ch_y = ch_d - 0.6 * ch_x; CHAP[ch_ap0] = ch_x + 0.6 * ch_y; ch_ap0 = (ch_ap0 + 1) & 2047;
  ch_d = CHAP[2048 + ((ch_ap1 - ch_al1) & 2047)]; ch_x = ch_d - 0.6 * ch_y; CHAP[2048 + ch_ap1] = ch_y + 0.6 * ch_x; ch_ap1 = (ch_ap1 + 1) & 2047;
  ch_rs0 += (CHRB[(ch_rp - ch_rl0) & 8191] - ch_rs0) * ch_rdk;
  ch_rs1 += (CHRB[8192 + ((ch_rp - ch_rl1) & 8191)] - ch_rs1) * ch_rdk;
  ch_rs2 += (CHRB[16384 + ((ch_rp - ch_rl2) & 8191)] - ch_rs2) * ch_rdk;
  ch_rs3 += (CHRB[24576 + ((ch_rp - ch_rl3) & 8191)] - ch_rs3) * ch_rdk;
  ch_m = (ch_rs0 + ch_rs1 + ch_rs2 + ch_rs3) * 0.5;
  CHRB[ch_rp] = (ch_rs0 - ch_m) * ch_rg0 + ch_x;
  CHRB[8192 + ch_rp] = (ch_rs1 - ch_m) * ch_rg1 - ch_x;
  CHRB[16384 + ch_rp] = (ch_rs2 - ch_m) * ch_rg2 + ch_x;
  CHRB[24576 + ch_rp] = (ch_rs3 - ch_m) * ch_rg3 - ch_x;
  ch_rp = (ch_rp + 1) & 8191;
  ch_ol += (ch_rs0 + ch_rs2) * 0.7; ch_or += (ch_rs1 + ch_rs3) * 0.7;
);

pwr_in(ch_ol, ch_or);  ch_ol = pwr_l;  ch_or = pwr_r;
pwr_out(ch_ol, ch_or);  ch_ol = pwr_l;  ch_or = pwr_r;
ch_dcl = ch_ol - ch_dclx + 0.9993 * ch_dcl; ch_dclx = ch_ol;
ch_dcr = ch_or - ch_dcrx + 0.9993 * ch_dcr; ch_dcrx = ch_or;
ch_pcf == 1 ? ( ch_pcg -= ch_pcdn; ch_pcg <= 0 ? ( ch_pcg = 0; ch_pcf = 2; ); ) :
ch_pcf == 3 ? ( ch_pcg += ch_pcup; ch_pcg >= 1 ? ( ch_pcg = 1; ch_pcf = 0; ); );
ch_vol += (ch_volt - ch_vol) * ch_smk;
ch_o1 = ostL.ost_band(ch_dcl * ch_vol * ch_pcg); ch_o2 = ostR.ost_band(ch_dcr * ch_vol * ch_pcg);
ost_out(ch_o1, ch_o2);
spl0 = abs(ost_l) < 0.0000000001 ? 0 : ost_l; spl1 = abs(ost_r) < 0.0000000001 ? 0 : ost_r;
ch_pk = max(ch_pk, max(abs(spl0), abs(spl1)));
max(abs(spl0), abs(spl1)) > 0.8913 ? mm_pk_d = 1;

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs, lbl) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = (cx - 17) * sc; y = (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  hov && pressed && drag_id == 0 ? ( drag_id = -1; slider(idx) = on ? 5 : von; ui_auto(idx); on = !on; );
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(ink, 1); gfx_measurestr(lbl, tw, th);
  gfx_x = cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr(lbl);
);
ui_begin(900, 355);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 16 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 26 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_in(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function mg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_setv(idx, v) ( slider(idx) = v; ui_auto(idx); );
function mm_sec(x, y, w, h, title) (
  mg_rshadow(x, y, w, h, 6);
  ui_col(mk_seam); mg_rr(x, y, w, h, 6);
  ui_col(mk_sub); mg_rr(x + 1.5, y + 1.5, w - 3, h - 3, 5);
  ui_col(mk_hdr); mg_rr(x + 1.5, y + 1.5, w - 3, 26, 5); mg_r(x + 1.5, y + 16, w - 3, 11.5);
  ui_col(mk_tab); mg_r(x + 1.5, y + 27.5, w - 3, 1.5);
  gfx_setfont(12); ui_col(mk_htx); mg_ltxt(x + 12, y + 15, title);
);
function mm_well(x, y, w, h) (
  ui_col(ui_mix(mk_face, 0x000000, 0.45)); mg_r(x, y, w, h);
  ui_col(mk_well); mg_r(x + 2, y + 2, w - 3, h - 3);
