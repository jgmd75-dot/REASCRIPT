  mf_rw = (mf_rw + 1) & MFRM;
);

pwr_out(mk_l, mk_r_); mk_l = pwr_l; mk_r_ = pwr_r;
mk_vol += (mk_volt - mk_vol) * mk_sm;
mk_l *= mk_vol; mk_r_ *= mk_vol;
mk_dcyl = mk_l - mk_dcxl + 0.9995 * mk_dcyl; mk_dcxl = mk_l; mk_l = mk_dcyl;
mk_dcyr = mk_r_ - mk_dcxr + 0.9995 * mk_dcyr; mk_dcxr = mk_r_; mk_r_ = mk_dcyr;
mk_e = abs(mk_l); mk_e > 0.5 ? mk_l = sign(mk_l) * (0.5 + 0.39 * vo_tanh((mk_e - 0.5) * 2.564));
mk_e = abs(mk_r_); mk_e > 0.5 ? mk_r_ = sign(mk_r_) * (0.5 + 0.39 * vo_tanh((mk_e - 0.5) * 2.564));
mk_l = ostL.ost_band(mk_l); mk_r_ = ostR.ost_band(mk_r_);
ost_out(mk_l, mk_r_);
spl0 = ost_l; spl1 = ost_r;
os_g < 1 ? ( spl0 *= os_g; spl1 *= os_g; );
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); rs_g = rs_f * rs_f * (3 - 2 * rs_f); spl0 *= rs_g; spl1 *= rs_g; );
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
