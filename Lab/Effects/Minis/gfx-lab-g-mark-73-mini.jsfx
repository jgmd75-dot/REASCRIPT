mk_mods != mk_mod ? ( mk_mods += (mk_mod - mk_mods) * mk_gk2; abs(mk_mod - mk_mods) < 0.000001 ? mk_mods = mk_mod; );
mk_mods > 0 ? ( mk_g = 1 - mk_mods * mk_pc1; mk_l *= mk_g; mk_r_ *= mk_g; ) :
