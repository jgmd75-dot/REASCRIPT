desc:Mark 73 Mini [tine e-piano] (GFX Lab)
//tags: instrument electric piano tine stage suitcase tremolo physical-modeling mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-voice, gfx-lab-dyn, gfx-lab-os, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-dyn.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider43:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:50<0,100,1>-Decay (%)
slider2:40<0,100,1>-Release (%)
slider3:50<0,100,1>-Hardness (%)
slider4:50<0,100,1>-Voicing (dark - dyno, %)
slider5:50<0,100,1>-Pickup gap (%)
slider6:0<-12,12,0.1>-Treble (dB)
slider7:0<-100,100,1>-Modulation (pan - / trem +, %)
slider8:4.5<0.01,12,0.01>-Rate (Hz)
slider9:70<0,100,1>-Velocity (%)
slider10:30<0,100,1>-Width (%)
slider11:16<4,32,1>-Polyphony
slider12:0<-50,50,0.1>-Fine (cents)
slider13:0<0,10,0.1>-Random (cents)
slider14:0<0,100,1>-Overdrive (%)
slider15:0<0,1,1{Stage,Suitcase}>-Amp
slider16:30<0,100,1>-Mechanism noise (%)
slider17:15<0,100,1>-Drift (%)
slider18:0<-24,6,0.1>-Volume (dB)
slider19:0<0,100,1>-Band sat (%)
slider20:30<0,100,1>-Bias (%)
slider21:120<40,400,1>-Sat low band (Hz)
slider22:6000<2000,16000,10>-Sat high band (Hz)
slider23:-0.3<-24,0,0.1>-Ceiling (dB)
slider24:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider25:0<0,16,1>-MIDI channel (0 = omni)
slider26:36<0,50,1>-Bell (%)
slider27:0<0,1,1{Off,On}>-Chorus
slider28:0.6<0.05,8,0.01>-Chorus rate (Hz)
slider29:50<0,100,1>-Chorus depth (%)
slider30:0<0,1,1{Off,On}>-Vibe
slider31:1.2<0.1,10,0.01>-Vibe rate (Hz)
slider32:50<0,100,1>-Vibe depth (%)
slider33:0<0,1,1{Off,On}>-Delay
slider34:375<20,1500,1>-Delay time (ms)
slider35:35<0,95,1>-Delay feedback (%)
slider36:25<0,100,1>-Delay mix (%)
slider37:0<0,4,1{ms,1/4,1/8 dotted,1/8,1/4 triplet}>-Delay sync
slider38:0<0,1,1{Off,On}>-Space
slider39:0<0,2,1{Room,Plate,Gated}>-Space type
slider40:25<0,100,1>-Space amount (%)
slider41:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider42:prs_sel=0<0,14,1{No preset,Init,Stage Mark,Bright Stage,Mellow Ballad,Suitcase Tremolo,Auto Pan Wide,Bark & Bite,Bell Tines,Soft Felt,Drive Amp,Gospel Bark,Lo-Fi Upright,Dyno Bright,Dark Ballad}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(8796093022207, v); );
function psw_allg(v) ( slider_show(8796093022207, v); );
#ui_man = "gfx-lab-g-mark-73-mini";
ext_noinit = 1;

ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
MKV = 30000; MKVS = 138; MKNV = 36;
MKHL = 35000; MKHR = 35100;
MKDEF = 35200;
MKTMP = 35300;
MKQO = 36000; MKQT = 36300; MKQN = 36600; MKQV = 36900;
MFCA = 40000; MFCB = 44100; MFCN = 4096;
MFVA = 48200; MFVB = 48240;
MFR = 50000; MFRN = 8192; MFRM = MFRN - 1;
MFDA = 90000; MFDB = 420000; MFDN = 330000;
memset(MFCA, 0, 2 * 4100); memset(MFVA, 0, 80); memset(MFR, 0, 4 * MFRN);
memset(MKV, 0, MKVS * MKNV); memset(MKHL, 0, 64); memset(MKHR, 0, 64);

function mk_hash(n, k) local(v) ( v = sin(n * 12.9898 + k * 78.233 + 0.5) * 43758.5453; v - floor(v); );

function mk_flux(x, y, d) local(s) ( s = 1 / (x * x + y * y + d * d + mk_a2); d * s * sqrt(s); );
function mk_slope(x) local(c) ( c = mk_d0 * mk_d0 + mk_a2; abs(3 * mk_d0 * x * (x * x + c) ^ -2.5); );
function mk_curv(x) local(c) ( c = mk_d0 * mk_d0 + mk_a2; 3 * mk_d0 * (x * x + c) ^ -3.5 * (4 * x * x - c); );
function mk_phi(k, xi) local(b, sg, z, ch, sh) (
  b = k == 0 ? 1.8751 : k == 1 ? 4.6941 : k == 2 ? 7.8548 : k == 3 ? 10.9955 : 14.1372;
  ch = 0.5 * (exp(b) + exp(-b)); sh = 0.5 * (exp(b) - exp(-b));
  sg = (ch + cos(b)) / (sh + sin(b)); z = b * xi;
  ch = 0.5 * (exp(z) + exp(-z)); sh = 0.5 * (exp(z) - exp(-z));
  ch - cos(z) - sg * (sh - sin(z));
);
function mk_t60(n) local(i, x0, x1) (
  n = min(max(n, 28), 108);
  i = n < 40 ? 0 : n < 52 ? 1 : n < 58 ? 2 : n < 64 ? 3 : n < 76 ? 4 : n < 88 ? 5 : n < 100 ? 6 : 7;
  x0 = i == 0 ? 28 : i == 1 ? 40 : i == 2 ? 52 : i == 3 ? 58 : i == 4 ? 64 : i == 5 ? 76 : i == 6 ? 88 : 100;
  x1 = i == 0 ? 40 : i == 1 ? 52 : i == 2 ? 58 : i == 3 ? 64 : i == 4 ? 76 : i == 5 ? 88 : i == 6 ? 100 : 108;
  exp(log(i == 0 ? 40 : i == 1 ? 27 : i == 2 ? 11 : i == 3 ? 9 : i == 4 ? 10.5 : i == 5 ? 7.6 : i == 6 ? 3.1 : 1.4) * (x1 - n) / (x1 - x0)
    + log(i == 0 ? 27 : i == 1 ? 11 : i == 2 ? 9 : i == 3 ? 10.5 : i == 4 ? 7.6 : i == 5 ? 3.1 : i == 6 ? 1.4 : 0.9) * (n - x0) / (x1 - x0));
);

#mk_def = "50 40 50 50 50 0 0 4.5 70 30 16 0 0 0 0 30 15 0";
function mk_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
mk_nums(#mk_def, MKDEF);
#mk_fxd = "0 0.6 50 0 1.2 50 0 375 35 25 0 0 0 25";
mk_nums(#mk_fxd, MKDEF + 20);

#mk_pm = "Init|Stage Mark|Bright Stage|Mellow Ballad|Suitcase Tremolo|Auto Pan Wide|Bark & Bite|Bell Tines|Soft Felt|Drive Amp|Gospel Bark|Lo-Fi Upright|Dyno Bright|Dark Ballad";
function mk_pstr(p) (
  p == 2  ? "1:60 3:40 4:42 5:55 9:72 10:25 26:36 38:1 39:0 40:18" :
  p == 3  ? "1:50 3:65 4:52 5:45 6:4 9:78 10:35 14:6 26:36 27:1 28:0.5 29:40" :
  p == 4  ? "1:70 2:55 3:22 4:18 5:62 6:-3 9:62 10:30 16:20 26:36 18:-1.7 27:1 28:0.4 29:45 38:1 39:1 40:30" :
  p == 5  ? "1:66 3:35 4:30 5:56 7:55 8:4.8 15:1 10:20 26:36 38:1 39:0 40:20" :
  p == 6  ? "1:66 3:35 4:32 5:56 6:1 7:-85 8:3.2 15:1 10:0 26:36" :
  p == 7  ? "1:50 2:35 3:60 4:58 5:30 9:90 14:22 6:1 26:36 30:1 31:0.9 32:40 18:1.8" :
  p == 8  ? "1:60 3:72 4:30 5:55 6:4 9:72 10:45 26:36 18:-1.1 27:1 28:0.7 29:55 38:1 39:1 40:28" :
  p == 9  ? "1:66 2:55 3:8 4:24 5:65 6:-5 9:55 16:18 26:45 18:-1.5" :
  p == 10 ? "1:55 3:50 4:48 5:42 9:82 14:65 15:1 7:30 8:5.6 26:36 18:-4 33:1 34:320 35:30 36:18" :
  p == 11 ? "1:60 3:58 4:56 5:32 9:88 14:30 15:1 7:20 8:6.2 6:2 26:36 18:-1.9 38:1 39:0 40:22" :
  p == 12 ? "1:40 2:30 3:30 4:35 6:-7 7:22 8:6.8 15:1 13:4 17:70 10:10 16:40 26:36" :
  p == 13 ? "1:55 3:60 4:90 5:52 6:2 9:78 10:35 26:36 18:2.9 27:1 28:0.8 29:50 33:1 37:2 35:28 36:15 38:1 39:1 40:22" :
  p == 14 ? "1:60 2:58 3:22 4:6 5:74 6:-4 9:66 10:28 15:1 16:20 26:27 18:-7.4" :
  "";
);
function load_preset(p) local(n, i) (
  i = 0; loop(18, slider(i + 1) = MKDEF[i]; i += 1; );
  slider26 = 36;
  i = 0; loop(14, slider(27 + i) = MKDEF[20 + i]; i += 1; );
  n = mk_nums(mk_pstr(p), MKTMP);
  i = 0; loop(floor(n / 2), (MKTMP[i * 2] >= 1 && MKTMP[i * 2] <= 18) || (MKTMP[i * 2] >= 26 && MKTMP[i * 2] <= 40) ? slider(MKTMP[i * 2]) = MKTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(18, slider_automate(2 ^ (i - 1)); i += 1; ); i = 26; loop(15, slider_automate(2 ^ (i - 1)); i += 1; );
);

function mk_vcurve(vel) local(x, b) (
  x = min(max(vel / 127, 0.01), 1);
  b = min(mk_vsens * 4, 1);
  0.7 * (1 - b) + b * x ^ (0.45 + 2.15 * mk_vsens ^ 1.3);
);

function mk_drag(p) local(q, a, e, r, h) (
  q = p + 40;
  a = abs(q[5]) * sqrt(max(q[0] * q[0] + q[1] * q[1] - 2 * p[16] * q[0] * q[1], 0)) * p[37];
  e = max(a - mk_dk, 0);
  r = q[9] * exp(-mk_db * e * e);
  q[2] = 2 * r * (e > 0 ? cos(p[35] * (1 + min(mk_kp * e * e, 0.00115))) : p[16]); q[3] = r * r;
  h = q[5] / (2 * sqrt(r) * p[39]); q[6] = h; q[7] = h * r;
  r = p[28] * exp(-mk_db * e * e); p[23] = 2 * r * p[125]; p[24] = r * r;
  a;
);
function mk_coefs(p, pitch) local(k, q, w, r, h) (
  k = 0; q = p + 40;
  loop(p[20],
    w = q[8] * pitch; r = q[9];
    q[2] = 2 * r * cos(w); q[3] = r * r;
    h = q[5] / (2 * sqrt(r) * cos(0.5 * w)); q[6] = h; q[7] = h * r;
    k == 0 ? ( p[16] = cos(w); p[37] = 1 / sin(w); p[39] = cos(0.5 * w); p[35] = w; );
    q += 10; k += 1;
  );
  w = p[27] * pitch; p[125] = cos(w);
  mk_drag(p);
  k = 0; q = p + 102;
  loop(min(p[20], 2),
    w = q[7] * pitch; r = p[49 + 10 * k];
    q[2] = 2 * r * cos(w); q[3] = r * r;
    h = p[45 + 10 * k] / (2 * sqrt(r) * cos(0.5 * w)); q[5] = h; q[6] = h * r;
    q += 8; k += 1;
  );
);

function mk_r(t60) ( exp(-6.9078 / (max(t60, 0.002) * srate)); );

function mk_strike(p, n, vel, fresh) local(tr, kt, u, xi, mh, h1, h2, h3, h4, h5, f, w, i, q, ph, pt, sk_r, sk_t, sk_a, off, tc, pe, cmax, v0, xr, s0, g, mu, dt, cHz, Tb, sk_j, ef, dh, fb) (
  tr = min(max((n - 21) / 87, 0), 1);
  kt = (n - 60) / 12;
  u = min(max((n - 29) / 74, 0), 1);
  xi = 0.18 - 0.08 * tr;
  h1 = mk_hash(n, 1); h2 = mk_hash(n, 2); h3 = mk_hash(n, 3); h4 = mk_hash(n, 4); h5 = mk_hash(n, 5);
  v0 = mk_vcurve(vel);
  p[6] = vel / 127;
  fresh ? (
    f = 440 * 2 ^ ((n - 69 + (h1 - 0.5) * 0.003 + (rand(2) - 1) * (mk_rnd + mk_drift * 1.5) / 100) / 12) * mk_fine;
    p[1] = n;
    p[20] = 0;
    sk_t = mk_dec * mk_t60(n) * (0.88 + 0.24 * h2);
    sk_t = min(max(sk_t, 0.35), 45);
    i = 0; q = p + 40;
    loop(5,
      sk_r = i == 0 ? 1 : i == 1 ? 7.11 * (1 + 0.09 * u) * (1 + (h3 - 0.5) * 0.02) : i == 2 ? 20.25 * (1 + 0.11 * u) * (1 + (h4 - 0.5) * 0.02) :
          i == 3 ? 40.0 * (1 + 0.12 * u) * (1 + (h5 - 0.5) * 0.02) : 66.0 * (1 + 0.12 * u);
      w = 2 * $pi * f * sk_r / srate;
      w < 0.78 * $pi && f * sk_r < 17000 ? (
        ph = i == 0 ? sk_t : (i == 1 ? 1.15 : i == 2 ? 0.30 : i == 3 ? 0.07 : 0.04) * 2 ^ (-kt / 1.5) * (0.8 + 0.4 * mk_hash(n, 10 + i)) * sqrt(mk_dec);
        ph = min(ph, sk_t);
        q[8] = w; q[9] = mk_r(ph); p[95 + i] = q[9]; i == 1 ? mk_r_t60b = ph;
        p[90 + i] = mk_phi(i, xi) * (i ? 0.85 + 0.3 * mk_hash(n, 20 + i) : 1);
        q[4] = p[90 + i] * sin(w) / (2 * $pi * f * sk_r * srate);
        i == 1 ? q[4] = 0;
        pt = i == 0 ? 1 : i == 1 ? 1 : (i == 2 ? 0.2 : i == 3 ? 0.11 : 0.07) * (1 - 0.5 * u) * mk_tclk;
        q[5] = (i % 2 ? -2 : 2) * pt;
        q[0] = q[1] = 0;
        p[20] += 1;
      );
      q += 10; i += 1;
    );
    tc = (0.8 - 0.35 * mk_hard) * 2 ^ (-kt / 1.8) * 0.001;
    tc = min(max(tc, 0.00035), 0.009);
    pe = 2.8;
    mh = min(max(5.5 * 2 ^ ((n - 40) / 24), 3), 30);
    sk_j = 1.402 - 0.091 * (pe - 2);
    cmax = tc / (2 * sk_j);
    p[12] = pe; p[11] = (pe + 1) * mh / (2 * cmax ^ (pe + 1)); p[10] = 1 / (mh * srate);
    p[13] = 0.18 + 0.25 * (1 - mk_hard);
    p[29] = mk_mech * 0.055 * tc / mh;
    sk_a = (2.3 - 1.55 * tr) * (0.92 + 0.16 * h4) * (0.79 + 0.3 * mk_vsens);
    p[133] = 1 + (h5 - 0.5) * 0.12 + (tr - 0.5) * 0.15;
    off = mk_offs * p[133];
    p[38] = off; p[17] = off;
    p[118] = (mk_hash(n, 40) - 0.5) * 0.03;
    p[119] = 1 / (2 * (9 - 4 * tr));
    xr = 2 * p[90] * 2 * mh * 0.85 / (2 * $pi * f);
    g = sk_a / xr;
    q = p + 40; loop(p[20], q[5] *= g; q += 10; );
    p[123] = sk_a;
    xr = 0.45 * sk_a;
    p[129] = 0.31 * 0.45 * (1 - 0.22 * tr) * (0.94 + 0.12 * h3) / ($pi * f / srate);
    p[129] *= (n & 1) ? -1 : 1;
    p[18] = p[130] = p[129] / sqrt(sqr(mk_slope(off) * xr) + sqr(mk_curv(off) * xr * xr * 0.5));
    p[19] = p[134] = mk_flux(off, p[118], mk_d0);
    ef = (0.08 + 0.17 * mk_hash(n, 41)) * mk_thor;
    dh = (0.01 + 0.05 * mk_hash(n, 42)) * (mk_hash(n, 43) > 0.5 ? 1 : -1);
    i = 0; q = p + 102;
    loop(min(p[20], 2),
      q[0] = q[1] = 0;
      q[7] = p[48 + 10 * i] + 2 * $pi * dh * (i ? 3 : 1) / srate;
      q[4] = p[44 + 10 * i] * ef;
      q += 8; i += 1;
    );
    mu = 5;
    dt = 0.3 + (0.25 + 0.45 * tr) * h2;
    cHz = 10 ^ ((0.12 + 0.18 * h3) / 20); cHz = (cHz - 1) / (cHz + 1);
    cHz = min(cHz, 0.08 / 1731 * f / dt);
    cHz = 0.5 * tan(2 * atan(sqrt(cHz)));
    dt /= sqrt(1 + 4 * cHz * cHz);
    cHz *= dt;
    h1 < 0.5 ? dt = -dt;
    g = 2 * sqrt(mu) * cHz / f;
    w = 2 * $pi * f / srate;
    p[48] = w / sqrt(1 + g);
    w = sqrt(sqr(2 * $pi * (f + dt) / srate) - g * w * w / mu);
    p[27] = w; Tb = sk_t; p[30] = p[28] = mk_r(Tb);
    p[25] = g * (2 * $pi * f / srate) * sin(w) / mu * mk_tcpl;
    p[26] = g * (2 * $pi * f / srate) * sin(2 * $pi * f / srate) * mk_tcpl;
    p[21] = p[22] = 0;
    p[36] = 1 + 1.2 * (1 - tr);
    p[33] = mk_symk * 2 * $pi * f / srate / max(abs(p[45]), 0.000001);
    p[32] = 0; p[34] = 0;
    p[122] = srate * min(2 * mk_r_t60b, 6);
    p[20] > 1 ? (
      p[135] = -p[55] * 0.65;
      p[124] = p[131] = max(mk_slope(off), 0.35 * mk_slope(0.53)) * p[135] * p[18];
      p[55] *= 0.35;
    );
    p[136] = mk_ckg * (0.3 + 2 * mk_mech) * min(max(2 ^ (1.8 * kt), 0.25), 6);
    p[100] = 0; p[101] = p[132] = p[136] * p[18] * max(mk_slope(off), 0.35 * mk_slope(0.53));
  ) : (
    i = 0; q = p + 40; loop(p[20], q[9] = p[95 + i]; q += 10; i += 1; );
    p[28] = p[30];
  );
  s0 = 0; i = 0; q = p + 40; loop(p[20], s0 += p[90 + i] * q[0]; q += 10; i += 1; );
  p[8] = s0; p[9] = v0 * 1; p[34] = s0;
  p[7] = floor(0.03 * srate);
  p[120] = p[20]; p[121] = 0;
  p[20] > 1 ? (
    q = p + 50;
    w = max(2, floor(min((1.2 - 0.6 * mk_hard) * 0.001 * srate, 1.2 * 2 * $pi / q[8])));
    s0 = 0; dt = 0; i = 0; loop(w, cHz = 1 - cos(2 * $pi * (i + 0.5) / w); s0 += cHz * cos(q[8] * i); dt += cHz * sin(q[8] * i); i += 1; );
    v0 = mk_bk * mk_bell * (1 + 0.3 * u) * (0.8 + 0.4 * mk_hash(n, 30)) * p[123] * (vel / 127) ^ 1.45 * 2 ^ ((mk_hard - 0.5) * 0.8);
    v0 /= max(abs(p[55]) / 0.35, 0.0000001);
    fb = q[8] * srate / (2 * $pi); fb > 1200 ? v0 *= (1200 / fb) ^ 0.72;
    p[126] = 0; p[127] = w; p[128] = v0 * sin(q[8]) / max(sqrt(s0 * s0 + dt * dt), 0.000001) * (mk_hash(n, 31) > 0.5 ? 1 : -1);
  );
  p[0] = 1; p[3] = 1; p[4] = 0; p[5] = 0; p[31] = 0;
  mk_coefs(p, mk_ptch);
);

function mk_norm(p) local(off, xr, sl, m) (
  off = mk_offs * p[133]; xr = 0.45 * p[123];
  sl = mk_slope(off);
  p[130] = p[129] / max(sqrt(sqr(sl * xr) + sqr(mk_curv(off) * xr * xr * 0.5)), 0.000000000001);
  m = max(sl, 0.35 * mk_slope(0.53));
  p[131] = m * p[135] * p[130]; p[132] = m * p[136] * p[130];
);

function mk_pan(p, n) local(pan) (
  pan = min(max((n - 64) / 30, -1), 1) * mk_width;
  p[14] = sqrt(0.5 * (1 - pan)); p[15] = sqrt(0.5 * (1 + pan));
);

function mk_alloc() local(i, p, best, ba, nact) (
  nact = 0; i = 0; loop(MKNV, p = MKV + i * MKVS; p[0] && !p[31] ? nact += 1; i += 1; );
  nact >= mk_poly ? (
    best = -1; i = 0;
    loop(MKNV, p = MKV + i * MKVS; p[0] && !p[31] && (best < 0 || p[2] - p[5] * 1000000 < ba) ? ( best = i; ba = p[2] - p[5] * 1000000; ); i += 1; );
    best >= 0 ? ( p = MKV + best * MKVS; p[31] = 1; p[5] = 1; p[3] = 0; p[4] = 0; );
  );
  best = -1; i = 0; loop(MKNV, p = MKV + i * MKVS; best < 0 && !p[0] ? best = i; i += 1; );
  best < 0 ? ( i = 0; loop(MKNV, p = MKV + i * MKVS; p[31] && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; ); );
  best < 0 ? best = 0;
  MKV + best * MKVS;
);

function mk_release(p) local(q, i) (
  p[5] = 1; p[3] = 0; p[4] = 0;
  q = p + 40; i = 0;
  loop(min(p[20], 2), q[0] -= q[4] * mk_mech * 0.005 * 3 * srate * (q[0] - q[1] > 0 ? 1 : -1) * p[6] * (i ? 0.3 : 1); q += 10; i += 1; );
  mk_kn = max(mk_kn, mk_mech * 0.0045 * (0.4 + 0.6 * p[6]));
);

function mk_note_on(n, vel) local(i, p, found) (
  found = -1; i = 0;
  loop(MKNV, p = MKV + i * MKVS; p[0] && p[1] == n && !p[31] ? found = i; i += 1; );
  found >= 0 ? (
    p = MKV + found * MKVS; mk_age += 1; p[2] = mk_age; mk_strike(p, n, vel, 0);
  ) : (
    p = mk_alloc(); memset(p, 0, MKVS); mk_age += 1; p[2] = mk_age;
    mk_strike(p, n, vel, 1); mk_pan(p, n);
  );
);
function mk_note_off(n) local(i, p) (
  i = 0;
  loop(MKNV, p = MKV + i * MKVS;
    p[0] && p[1] == n && p[3] && !p[31] ? ( mk_pedal ? ( p[3] = 0; p[4] = 1; ) : mk_release(p); );
    i += 1; );
);
function mk_pedal_up() local(i, p) (
  i = 0; loop(MKNV, p = MKV + i * MKVS; p[0] && p[4] ? mk_release(p); i += 1; );
);
function mk_all_off() local(i, p) ( i = 0; loop(MKNV, p = MKV + i * MKVS; p[0] ? ( p[31] = 1; p[5] = 1; p[3] = 0; p[4] = 0; ); i += 1; ); mk_pedal = 0; );

function mk_hb(b, w) (
  0.5003175242 * b[(w - 19) & 63]
  + 0.3165830275 * (b[(w - 18) & 63] + b[(w - 20) & 63])
  - 0.1004920620 * (b[(w - 16) & 63] + b[(w - 22) & 63])
  + 0.0546158895 * (b[(w - 14) & 63] + b[(w - 24) & 63])
  - 0.0335169601 * (b[(w - 12) & 63] + b[(w - 26) & 63])
  + 0.0211574377 * (b[(w - 10) & 63] + b[(w - 28) & 63])
  - 0.0131712778 * (b[(w - 8) & 63] + b[(w - 30) & 63])
  + 0.0078701971 * (b[(w - 6) & 63] + b[(w - 32) & 63])
  - 0.0043811777 * (b[(w - 4) & 63] + b[(w - 34) & 63])
  + 0.0021893628 * (b[(w - 2) & 63] + b[(w - 36) & 63])
  - 0.0010131992 * (b[(w - 0) & 63] + b[(w - 38) & 63]);
);

function mf_read(buf, n, pos) local(ii, fr, xm1, x0, x1, x2, c1, c2, c3) (
  pos < 0 ? pos += n; pos >= n ? pos -= n;
  ii = floor(pos); fr = pos - ii;
  xm1 = buf[(ii - 1 + n) % n]; x0 = buf[ii]; x1 = buf[(ii + 1) % n]; x2 = buf[(ii + 2) % n];
  c1 = 0.5 * (x1 - xm1); c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * fr + c2) * fr + c1) * fr + x0;
);
function mf_vibe(x, phoff, vs, tick) local(ph, lf, k, y, f, t, a1, xi) (
  tick ? (
    ph = mf_vph + phoff; ph -= floor(ph); lf = 0.5 - 0.5 * cos(2 * $pi * ph);
    vs[8] += (lf > vs[8] ? mf_vat : mf_vrl) * (lf - vs[8]);
    k = 0; loop(4,
      f = min(srate * 0.45, (k == 0 ? 60 : k == 1 ? 180 : k == 2 ? 480 : 1300) * 2 ^ (mf_vocs * vs[8]));
      t = tan($pi * f / srate); vs[9 + k] = (t - 1) / (t + 1); k += 1; );
  );
  y = x; k = 0;
  loop(4, a1 = vs[9 + k]; xi = y; y = a1 * xi + vs[k * 2] - a1 * vs[k * 2 + 1]; vs[k * 2] = xi; vs[k * 2 + 1] = y; k += 1; );
  0.5 * (y - x);
);
function mf_dloop(y, st) (
  st[0] += mf_dlc * (y - st[0]); st[1] += mf_dhc * (st[0] - st[1]);
  vo_tanh((st[0] - st[1]) * mf_dfbs * 1.15) / 1.15;
);

function mf_sparams(ty) (
  mf_sk = ty == 1 ? 0.6 : ty == 2 ? 0.85 : 1;
  mf_st60 = ty == 1 ? 1.4 + 2.6 * mf_sam : ty == 2 ? 2.4 : 0.5 + 0.8 * mf_sam;
  mf_slv = ty == 1 ? 0.8 : ty == 2 ? 1.4 : 1;
  mf_rgt = 10 ^ (-3 * 0.015 * mf_sk / mf_st60);
  mf_l0 = floor(0.0073 * srate * mf_sk); mf_l1 = floor(0.0119 * srate * mf_sk); mf_l2 = floor(0.0171 * srate * mf_sk); mf_l3 = floor(0.0217 * srate * mf_sk);
  mf_slp = 1 - exp(-2 * $pi * (ty == 1 ? 10000 : ty == 2 ? 8000 : 6500) / srate);
);

function update() (
  mk_dec = 2 ^ ((slider1 - 50) / 50 * 1.5);
  mk_relt = 0.03 * 2 ^ (slider2 / 100 * 5.5);
  mk_hard = slider3 / 100;
  mk_off0 = 0.015 + 1.185 * (1 - slider4 / 100) ^ 1.45;
  mk_bell = 0.216 * 10 ^ ((slider26 - 36) * 0.055) * min(slider26 / 5, 1);
  mk_tk2 = (0.9 * max(slider3 / 100 - 0.35, 0) / 0.65 + 0.7 * max(slider26 / 100 - 0.7, 0) / 0.3 + 0.9 * max(slider4 / 100 - 0.55, 0) / 0.45) * mk_ttam;
  mk_d0t = 2 ^ ((slider5 / 100 - 0.5) * 1.4);
  mk_a2 = 0.12;
  mk_treb = slider6;
  mk_mod = slider7 / 100; mk_rate = slider8;
  mk_vsens = slider9 / 100; mk_width = slider10 / 100;
  mk_poly = floor(slider11 + 0.5);
  mk_fine = 2 ^ (slider12 / 1200); mk_rnd = slider13;
  mk_od = slider14 / 100; mk_amp = slider15 >= 0.5;
  mk_mech = slider16 / 100;
  mk_drift = slider17 / 100;
  mk_volt = 10 ^ (slider18 / 20);
  mk_chan = slider25;
  mk_dk = 0.75; mk_db = 14 / srate;
  mk_ckg = 20;
  mk_kp = 0;
  mk_bk = 0.07;
  ins_output_setup(19);
  mf_chon = slider27 >= 0.5; mf_chr = slider28; mf_chd = slider29 / 100 * 4;
  mf_vbon = slider30 >= 0.5; mf_vbr = slider31; mf_voct = 3 * slider32 / 100; mf_vwet = min(1, 2 * slider32 / 100);
  mf_dlon = slider33 >= 0.5; mf_dfb = 0.95 * slider35 / 95; mf_dmix = slider36 / 100; mf_dsync = floor(slider37 + 0.5);
  mf_spon = slider38 >= 0.5; mf_sty = floor(slider39 + 0.5); mf_sam = slider40 / 100;
  mf_stya < 0 ? mf_stya = mf_sty;
  mf_sparams(mf_stya);
);

function mk_srinit() (
  mk_sr = srate;
  mk_sm = 1 - exp(-1 / (0.03 * srate));
  ost_init(20000);
  mk_tq.bq_set(5, 150, 1.2, 0);
  mk_tc.bq_set(1, 2500, 0.7, 0);
  mk_tc2.bq_set(0, 5000, 0.7, 0);
  mk_cklp = 1 - exp(-2 * $pi * 7000 / srate);
  mk_knd = exp(-1 / (0.012 * srate));
  mk_tsl.bq_set(0, 2800, 0.7071, 0); mk_tsr.bq_set(0, 2800, 0.7071, 0); mk_tsl2.bq_set(0, 2800, 0.7071, 0); mk_tsr2.bq_set(0, 2800, 0.7071, 0);
  mk_thl.bq_set(1, 2800, 0.7071, 0); mk_thr.bq_set(1, 2800, 0.7071, 0); mk_thl2.bq_set(1, 2800, 0.7071, 0); mk_thr2.bq_set(1, 2800, 0.7071, 0);
  mk_tat = 1 - exp(-1 / (0.001 * srate)); mk_trl = 1 - exp(-1 / (0.08 * srate));
  mk_tth = 0.007;
  mf_cpc = 1 - exp(-2 * $pi * 9000 / srate);
  mf_vat = 1 - exp(-8 / (0.008 * srate)); mf_vrl = 1 - exp(-8 / (0.04 * srate));
  mf_dlc = 1 - exp(-2 * $pi * 3500 / srate); mf_dhc = 1 - exp(-2 * $pi * 70 / srate);
  mf_dihc = 1 - exp(-2 * $pi * 300 / srate);
  mf_dts = 1 - exp(-1 / (0.25 * srate)); mf_gsm = 1 - exp(-1 / (0.02 * srate));
  mf_ghl = floor(0.3 * srate); mf_grl = 1 - exp(-1 / (0.025 * srate));
  memset(MFDA, 0, MFDN); memset(MFDB, 0, MFDN); mf_dw = 0;
  memset(MKV, 0, MKVS * MKNV); memset(MKHL, 0, 64); memset(MKHR, 0, 64); memset(MFCA, 0, 2 * 4100); memset(MFR, 0, 4 * MFRN); memset(MFVA, 0, 80);
  mk_kq.bq_set(5, 320, 0.9, 0);
  mk_bh = 1 - exp(-1 / (0.014 * srate)); mk_bc = 1 - exp(-1 / (0.045 * srate));
  mk_tset = -1;
  mk_gk = 1 - exp(-1 / (0.015 * srate)); mk_nk = 1 - exp(-1 / (0.002 * srate)); mk_gk2 = 1 - exp(-1 / (0.02 * srate));
  mk_k32 = 1 - exp(-32 / (0.03 * srate)); mf_gsm2 = 1 - exp(-1 / (0.05 * srate));
  mk_swdn = 1 / (0.012 * srate); mk_swup = 1 / (0.02 * srate);
);

function mk_tcoil() local(f) (
  f = 6800 * 2 ^ (ins_tone * 0.35);
  mk_cl.bq_set(0, f, 0.85, 0); mk_cr.bq_set(0, f, 0.85, 0);
);
function mk_tamp() (
  mk_amp ? (
    mk_a1l.bq_set(4, 110, 0.7, 3.5); mk_a1r.bq_set(4, 110, 0.7, 3.5);
    mk_a2l.bq_set(2, 650, 0.8, -5); mk_a2r.bq_set(2, 650, 0.8, -5);
    mk_a3l.bq_set(3, 3200, 0.7, 4); mk_a3r.bq_set(3, 3200, 0.7, 4);
    mk_c1l.bq_set(2, 100, 1.6, 3.5); mk_c1r.bq_set(2, 100, 1.6, 3.5);
    mk_c2l.bq_set(2, 1800, 1.0, 3); mk_c2r.bq_set(2, 1800, 1.0, 3);
    mk_c3l.bq_set(0, 5000, 0.8, 0); mk_c3r.bq_set(0, 5000, 0.8, 0);
    mk_c4l.bq_set(1, 55, 0.8, 0); mk_c4r.bq_set(1, 55, 0.8, 0);
    mk_pre = 1.25; mk_bias = -0.3; mk_cg = 10 ^ (2 / 20);
  ) : (
    mk_a1l.bq_set(4, 120, 0.7, 1.5); mk_a1r.bq_set(4, 120, 0.7, 1.5);
    mk_a2l.bq_set(2, 900, 0.8, -1); mk_a2r.bq_set(2, 900, 0.8, -1);
    mk_a3l.bq_set(3, 3200, 0.7, 0); mk_a3r.bq_set(3, 3200, 0.7, 0);
    mk_c1l.bq_set(2, 100, 1.6, 0); mk_c1r.bq_set(2, 100, 1.6, 0);
    mk_c2l.bq_set(2, 1800, 1.0, 0); mk_c2r.bq_set(2, 1800, 1.0, 0);
    mk_c3l.bq_set(0, 10000, 0.6, 0); mk_c3r.bq_set(0, 10000, 0.6, 0);
    mk_c4l.bq_set(1, 30, 0.7, 0); mk_c4r.bq_set(1, 30, 0.7, 0);
    mk_pre = 0.85; mk_bias = -0.2; mk_cg = 1;
  );
  mk_bt = vo_tanh(mk_bias);
);
function mk_ttreb() ( mk_tbl.bq_set(3, 3000, 0.7, mk_trs); mk_tbr.bq_set(3, 3000, 0.7, mk_trs); );
function mk_drv() (
  mk_dg = mk_pre * (1 + 30 * mk_ods * mk_ods);
  mk_dn = mk_cg / (mk_dg ^ 0.75 * mk_pre ^ 0.25 * (1 - mk_bt * mk_bt));
);
function mk_tone() (
  mk_tcoil(); mk_tamp(); mk_trs = mk_treb; mk_ttreb(); mk_ods = mk_od; mk_drv(); mk_dgs = mk_dg; mk_dns = mk_dn;
);

ins_drift_init();
mk_tcpl = 1; mk_tclk = 1; mk_thor = 1; mk_ttam = 1;
mk_symk = 0.00012;
mk_pedal = 0; mk_age = 0; mk_kn = 0; mk_hw = 0; mk_lph = 0; mk_rail = 0; mk_pk_disp = 0;
mk_dcxl = mk_dcyl = mk_dcxr = mk_dcyr = 0; mk_ptch = 1; mk_bu1 = mk_bu2 = 0.5; mk_adn = 0.000000000000000001;
mf_stya = -1; mk_swr = mk_swg = 1; mf_dkr = mf_skr = 1; mf_dstop = mf_sstop = 1; mf_vmk = 1;
mk_srinit();
update();
mk_d0 = mk_d0a = mk_d0t; mk_offs = mk_offa = mk_off0; mk_cutf = 1; mk_drs = mk_drift;
mk_tone();
mk_vol = mk_volt;

os_design(); os_base = 0; os_f = os_tf = os_f2n(os_sel); os_gsetup();
pwr_init(); pwr_wu_loss = 0.8; pwr_wu_drv = 0.8; pwr_wu_lp = 9000; pwr_bloom = 0; pwr_sag = 0.12; pwr_hum_db = -83.4;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
rs_f = 1; rs_c = 1 / (0.015 * srate);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function mk_gapclr() (
  memset(MKV, 0, MKVS * MKNV); memset(MKHL, 0, 64); memset(MKHR, 0, 64);
  memset(MFCA, 0, 2 * 4100); memset(MFR, 0, 4 * MFRN); memset(MFVA, 0, 80); memset(MFDA, 0, MFDN); memset(MFDB, 0, MFDN);
  mf_z0 = mf_z1 = mf_z2 = mf_z3 = 0; mf_din = 0; mf_dh1 = mf_dh2 = 0; mf_cpl = mf_cpr = 0;
  mk_dcxl = mk_dcyl = mk_dcxr = mk_dcyr = 0; mk_kn = 0; mk_ten = 0; mk_pedal = 0;
  UL.os_clr(); UR.os_clr(); DNL.os_clr(); DNR.os_clr();
  rs_f = 0; rs_c = 1 / (0.015 * srate);
);

function mk_lat() ( pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_base + os_lat(os_f); );

function prs_hash() local(i, h) ( h = 0; i = 1; loop(41, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();
mk_lat();
os_snap(slider(41));

@block
prs_chk();
srate != mk_sr ? mk_srinit();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? mk_gapclr();
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
update();
mk_qc = 0; mk_qi = 0; mk_spos = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, mk_chan) && mk_qc < 256 ? (
    mk_st = m1 & 0xF0;
    mk_qt = mk_st == 0x90 && m3 > 0 ? 1 : (mk_st == 0x80 || mk_st == 0x90) ? 0 :
            mk_st == 0xB0 && m2 == 64 ? 2 : mk_st == 0xB0 && (m2 == 123 || m2 == 120) ? 3 : -1;
    mk_qt >= 0 ? ( MKQO[mk_qc] = mofs; MKQT[mk_qc] = mk_qt; MKQN[mk_qc] = m2; MKQV[mk_qc] = m3; mk_qc += 1; );
    mk_qt == 1 ? ins_midi_hit();
  );
  midisend(mofs, m1, m2, m3);
);
gfx_pst = play_state == 1 || play_state == 5;
gfx_pst_prev && !gfx_pst ? ( mk_qc < 256 ? ( MKQO[mk_qc] = 0; MKQT[mk_qc] = 3; MKQN[mk_qc] = 0; MKQV[mk_qc] = 0; mk_qc += 1; ); );
gfx_pst_prev = gfx_pst;
mk_drs += (mk_drift - mk_drs) * (1 - exp(-samplesblock / (0.3 * srate)));
ins_drift_block(mk_drs, samplesblock);
mk_ptch = ins_pitch ^ 0.2;
mk_tset < 0 ? (
  mk_tone(); mk_tset = 1; mk_ta = mk_amp; mk_tn = ins_tone; mk_swp = 0; mk_swr = mk_swg = 1;
  mk_drs = mk_drift; mk_d0 = mk_d0a = mk_d0t; mk_offs = mk_offa = mk_off0; mk_tk2s = mk_tk2; mk_tmx = mk_tk2 > 0.001; mk_mods = mk_mod;
  mf_chds = mf_chd; mf_vocs = mf_voct; mf_dfbs = mf_dfb; mf_rg = mf_rgt; mf_dt = mf_dtgl = mf_dtg = slider34;
) : (
  abs(mk_tn - ins_tone) > 0.01 ? ( mk_tcoil(); mk_tn = ins_tone; );
  mk_ta != mk_amp ? mk_swp = 1;
);
abs(mk_d0t - mk_d0) < 0.0000001 && abs(mk_d0t - mk_d0a) < 0.0000001 ? mk_d0 = mk_d0a = mk_d0t;
abs(mk_off0 - mk_offs) < 0.0000001 && abs(mk_off0 - mk_offa) < 0.0000001 ? mk_offs = mk_offa = mk_off0;
mk_d0 != mk_d0t || mk_offs != mk_off0 ? mk_gtl = floor(0.05 * srate) : mk_gtl = max(mk_gtl - samplesblock, 0);
mk_gmov = mk_gtl > 0;
mk_cutf = 1 + ins_cut * 0.05;

mk_ramp = 1 - exp(-samplesblock / (0.012 * srate));
mk_nage = -1; mk_na = 0; mk_noff = mk_off0;
mk_i = 0;
loop(MKNV,
  mk_p = MKV + mk_i * MKVS;
  mk_p[0] ? (
    mk_p[5] ? (
      mk_q = mk_p + 40; mk_k = 0;
      loop(mk_p[20],
        mk_rt = mk_r((mk_p[31] ? 0.025 : mk_relt * mk_p[36]) * (mk_k ? 0.5 : 1));
        mk_q[9] < mk_rt ? mk_rt = mk_q[9];
        mk_q[9] += (mk_rt - mk_q[9]) * (mk_p[31] ? 1 : mk_ramp);
        mk_q += 10; mk_k += 1;
      );
      mk_rt = mk_r(mk_p[31] ? 0.025 : mk_relt * mk_p[36] * 2.5); mk_rt < mk_p[28] ? mk_p[28] += (mk_rt - mk_p[28]) * mk_ramp;
    );
    mk_p[121] += samplesblock;
    mk_n = mk_p[121] > mk_p[122] ? 1 : mk_p[121] > 0.35 * srate ? min(mk_p[20], 2) : mk_p[20];
    mk_n < mk_p[120] ? (
      mk_k = mk_n; loop(mk_p[120] - mk_n, mk_p[40 + 10 * mk_k] = mk_p[41 + 10 * mk_k] = 0; mk_k < 2 ? mk_p[102 + 8 * mk_k] = mk_p[103 + 8 * mk_k] = 0; mk_k += 1; );
      mk_p[120] = mk_n;
    );
    mk_p[38] = mk_offs * mk_p[133];
    mk_p[17] = mk_p[38] * mk_cutf;
    mk_p[134] = mk_flux(mk_p[17], mk_p[118], mk_d0);
    mk_gmov ? mk_norm(mk_p);
    mk_coefs(mk_p, mk_ptch);
    mk_e = abs(mk_p[40] * mk_p[45]) + abs(mk_p[41] * mk_p[45]) + abs(mk_p[21] * mk_p[45]) + abs(mk_p[50] * mk_p[55]);
    mk_p[7] <= 0 && (mk_p[5] ? mk_e < 0.00003 : mk_e < 0.000003) ? mk_p[0] = 0;
    mk_p[2] >= mk_nage ? (
      mk_nage = mk_p[2];
      mk_q = mk_p + 40;
      mk_na = abs(mk_q[5]) * sqrt(max(mk_q[0] * mk_q[0] + mk_q[1] * mk_q[1] - 2 * mk_p[16] * mk_q[0] * mk_q[1], 0)) * mk_p[37];
      mk_noff = mk_p[17];
    );
  );
  mk_i += 1;
);
mf_dq = mf_dsync == 1 ? 1 : mf_dsync == 2 ? 0.75 : mf_dsync == 3 ? 0.5 : 2 / 3;
mf_dtg = mf_dsync > 0 && tempo > 0 ? min(1500, mf_dq * 60000 / tempo) : slider34;
abs(mf_dtg - mf_dtgl) > 0.2 * max(mf_dtgl, 1) ? mf_djp = 1; mf_dtgl = mf_dtg;
(mf_dg > 0.0001 || mf_dlon) ? (
  mf_dlon && mf_dstop ? ( memset(MFDA, 0, MFDN); memset(MFDB, 0, MFDN); memset(MFVA + 30, 0, 8); mf_din = 0; mf_dh1 = mf_dh2 = 0; mf_dstop = 0; mf_dt = mf_dtg; mf_djp = 0; mf_dkr = 1; );
) : ( mf_dstop = 1; mf_dt = mf_dtg; mf_djp = 0; mf_dkr = 1; );
(mf_sg > 0.0001 || mf_spon) ? (
  mf_spon && mf_sstop ? ( memset(MFR, 0, 4 * MFRN); mf_z0 = mf_z1 = mf_z2 = mf_z3 = 0; mf_sstop = 0; mf_ssw = 0; mf_skr = 1;
    mf_stya != mf_sty ? ( mf_stya = mf_sty; mf_sparams(mf_stya); ); mf_rg = mf_rgt; );
  mf_stya != mf_sty ? mf_ssw = 1;
) : ( mf_sstop = 1; mf_ssw = 0; mf_skr = 1; mf_stya != mf_sty ? ( mf_stya = mf_sty; mf_sparams(mf_stya); ); mf_rg = mf_rgt; );
mf_dlen = floor(min(1.6 * srate, MFDN - 8));
mk_ga = mk_na; mk_goff = mk_noff;
mk_lpinc = mk_rate * (1 + 0.04 * ins_fx) / srate;
mk_panic_dirty ? ( mk_panic_dirty = 0; mk_qc < 256 ? ( MKQO[mk_qc] = 0; MKQT[mk_qc] = 3; MKQN[mk_qc] = 0; MKQV[mk_qc] = 0; mk_qc += 1; ); );
