  );
  mk_tgr = mk_g;
) : ( mk_tgr = 1; );

pwr_in(mk_l, mk_r_); mk_l = pwr_l; mk_r_ = pwr_r;
mk_l = mk_a1l.bq_run(mk_l); mk_r_ = mk_a1r.bq_run(mk_r_);
mk_l = mk_a2l.bq_run(mk_l); mk_r_ = mk_a2r.bq_run(mk_r_);
mk_l = mk_a3l.bq_run(mk_l); mk_r_ = mk_a3r.bq_run(mk_r_);
mk_tick ? (
  mk_ods != mk_od ? ( mk_ods += (mk_od - mk_ods) * mk_k32; abs(mk_od - mk_ods) < 0.00005 ? mk_ods = mk_od; mk_drv(); );
  mk_trs != mk_treb ? ( mk_trs += (mk_treb - mk_trs) * mk_k32; abs(mk_treb - mk_trs) < 0.002 ? mk_trs = mk_treb; mk_ttreb(); );
);
mk_dgs += (mk_dg - mk_dgs) * mk_nk; mk_dns += (mk_dn - mk_dns) * mk_nk;
UL.os_up(mk_l); UR.os_up(mk_r_);
p0l = (vo_tanh(mk_dgs * UL.s0 + mk_bias) - mk_bt) * mk_dns; p0r = (vo_tanh(mk_dgs * UR.s0 + mk_bias) - mk_bt) * mk_dns;
os_f > 1 ? (
  p1l = (vo_tanh(mk_dgs * UL.s1 + mk_bias) - mk_bt) * mk_dns; p1r = (vo_tanh(mk_dgs * UR.s1 + mk_bias) - mk_bt) * mk_dns;
  os_f > 2 ? (
    p2l = (vo_tanh(mk_dgs * UL.s2 + mk_bias) - mk_bt) * mk_dns; p2r = (vo_tanh(mk_dgs * UR.s2 + mk_bias) - mk_bt) * mk_dns;
    p3l = (vo_tanh(mk_dgs * UL.s3 + mk_bias) - mk_bt) * mk_dns; p3r = (vo_tanh(mk_dgs * UR.s3 + mk_bias) - mk_bt) * mk_dns;
  );
);
mk_l = DNL.os_dn(p0l, p1l, p2l, p3l); mk_r_ = DNR.os_dn(p0r, p1r, p2r, p3r);

mk_lph += mk_lpinc; mk_lph >= 1 ? mk_lph -= 1;
mk_ls = 0.5 + 0.5 * sin(2 * $pi * mk_lph);
mk_bu1 += (mk_ls - mk_bu1) * (mk_ls > mk_bu1 ? mk_bh : mk_bc);
mk_bu2 += ((1 - mk_ls) - mk_bu2) * ((1 - mk_ls) > mk_bu2 ? mk_bh : mk_bc);
