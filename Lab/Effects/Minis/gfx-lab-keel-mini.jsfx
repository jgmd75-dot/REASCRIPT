desc:Keel Mini [low-end shaper] (GFX Lab)
//tags: mastering bass low end transient compressor mono harmonics
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-input, gfx-lab-ui, gfx-lab-panel, gfx-lab-os and gfx-lab-bypass (.jsfx-inc) in the

slider1:split=100<40,250,1>-Split (Hz)
slider2:sub_f=20<10,40,0.1>-Sub filter (Hz)
slider3:sub_in=0<0,1,1{Out,In}>-Sub filter
slider4:punch=0<0,100,0.1>-Punch (%)
slider5:smooth=0<0,100,0.1>-Smooth (%)
slider6:low_db=0<-6,6,0.1>-Low (dB)
slider7:mono=0<0,100,0.1>-Mono (%)
slider8:harm=0<0,100,0.1>-Harmonics (%)
slider9:tone=50<0,100,0.1>-Harmonics tone (%)
slider10:drift=50<0,100,0.1>-(unused, was Drift)
slider11:out_db=0<-12,12,0.1>-Output (dB)
slider12:trim_db=0<-24,12,0.1>-Trim (dB)
slider13:guard=0<0,1,1{Off,On}>-Guard
slider14:byp=0<0,1,1{Off,On}>-Bypass
slider15:os_sl=0<0,2,1{1x,2x,4x}>-Oversampling
slider16:prs_sel=0<0,14,1{No preset,Init,Tight Kick,Smooth Bass,Mono Master,Small Speakers,Deep Weight,Punchy Drums,Even Bass Line,Warm Glow,Clean Sub,Club Master,Gentle Master,Bright Bass,Vintage Low End}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-input.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-keel-mini";
ext_noinit = 1;

DRY = 30000; DLY = 32100; RMASK = 1023; DMASK = 63;

function db2g(d) ( exp(d * 0.11512925464970228); );
function g2db(g) ( log(max(g, 0.000000001)) * 8.685889638065035; );
function coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );

function sv_run(x, g, k) instance(s1, s2, lp, hp) local(h, v1, v2, bp) (
  h = 1 / (1 + g * (g + k));
  hp = (x - (g + k) * s1 - s2) * h;
  v1 = g * hp; bp = v1 + s1; s1 = bp + v1;
  v2 = g * bp; lp = s2 + v2; s2 = lp + v2;
  lp;
);
function sv_clr() instance(s1, s2) ( s1 = s2 = 0; );

function xo_run(x) instance(a, b, c, d, lo, hi) (
  a.sv_run(x, xo_g, 1.4142135623730951); lo = b.sv_run(a.lp, xo_g, 1.4142135623730951);
  c.sv_run(x, xo_g, 1.4142135623730951); d.sv_run(c.hp, xo_g, 1.4142135623730951); hi = d.hp;
);
function xo_clr() instance(a, b, c, d) ( a.sv_clr(); b.sv_clr(); c.sv_clr(); d.sv_clr(); );

function hg_run(x) instance(env) local(xn, x2, y) (
  env = max(abs(x), env * hg_rel);
  env > 0.00001 ? (
    xn = max(-1, min(1, x / env)); x2 = xn * xn;
    y = hw2 * (2 * x2 - 1) + xn * (hw3 * (4 * x2 - 3) + hw5 * (16 * x2 * x2 - 20 * x2 + 5)) + hw4 * (8 * x2 * x2 - 8 * x2 + 1);
    hhp.sv_run(y * env, hg_g, 1.4142135623730951);
  ) : hhp.sv_run(0, hg_g, 1.4142135623730951);
  hhp.hp * hg_a;
);
function hg_clr() instance(env) ( env = 0; hhp.sv_clr(); );
function hg_rate() (
  hg_rel = exp(-1 / (0.3 * srate * os_f));
  hg_g = tan($pi * min(split, 0.2 * srate) / (srate * os_f));
);

FZC = 7000000;
FZ_1 = FZC; FZ_2 = FZC + 5; FZ_3 = FZC + 10; FZ_4 = FZC + 15;
function fz_bqc(c, t, f, gdb, q, fs) local(Ag, w, cw, sw, al, a0, sa) (
  Ag = exp(gdb * 0.057564627324851); w = 2 * $pi * min(max(f, 5), fs * 0.45) / fs; cw = cos(w); sw = sin(w); al = sw / (2 * q);
  t == 0 ? (
    a0 = 1 + al / Ag;
    c[0] = (1 + al * Ag) / a0; c[1] = -2 * cw / a0; c[2] = (1 - al * Ag) / a0; c[3] = -2 * cw / a0; c[4] = (1 - al / Ag) / a0;
  ) : t == 2 ? (
    sa = 2 * sqrt(Ag) * sw * 0.5 * sqrt(2); a0 = (Ag + 1) - (Ag - 1) * cw + sa;
    c[0] = Ag * ((Ag + 1) + (Ag - 1) * cw + sa) / a0; c[1] = -2 * Ag * ((Ag - 1) + (Ag + 1) * cw) / a0; c[2] = Ag * ((Ag + 1) + (Ag - 1) * cw - sa) / a0;
    c[3] = 2 * ((Ag - 1) - (Ag + 1) * cw) / a0; c[4] = ((Ag + 1) - (Ag - 1) * cw - sa) / a0;
  ) : (
    a0 = 1 + al; c[0] = (1 + cw) * 0.5 / a0; c[1] = -(1 + cw) / a0; c[2] = c[0]; c[3] = -2 * cw / a0; c[4] = (1 - al) / a0;
  );
);
function fz_bq(x, c) instance(z1, z2) local(y) ( y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y; );
function fz_bqz() instance(z1, z2) ( z1 = z2 = 0; );
function fz_tanh(x) local(e) ( x = max(-15, min(15, x)); e = exp(2 * x); (e - 1) / (e + 1); );
function fz_coefs(fs) (
  fz_bqc(FZ_1, 4, 3500, 0, 0.7071, fs); fz_bqc(FZ_2, 4, 5500, 0, 0.7071, fs); fz_bqc(FZ_3, 0, 8000, 4, 0.7, fs); fz_bqc(FZ_4, 2, 12000, -6, 0.7, fs);
  fz_ka = 1 - exp(-1 / (0.003 * fs)); fz_kr = 1 - exp(-1 / (0.12 * fs)); fz_kw = 1 - exp(-1 / (0.06 * fs));
);
function fz_run() local(h0, h1, ha, nn, u0, u1, e0, e1, ea, pa, g) (
  h0 = zA1.fz_bq(fz_l, FZ_1); h1 = zA2.fz_bq(fz_r, FZ_1);
  ha = max(abs(h0), abs(h1)); fz_h += (ha - fz_h) * (ha > fz_h ? fz_ka : fz_kr);
  pa = max(abs(fz_l), abs(fz_r)); fz_p += (pa - fz_p) * fz_kw;
  nn = 1 / (max(fz_h, 0.25 * fz_p) + 0.00001);
  u0 = h0 * nn; u1 = h1 * nn;
  e0 = (fz_tanh(2 * u0) / 2 - u0 + 0.4 * u0 * u0) * fz_h;
  e1 = (fz_tanh(2 * u1) / 2 - u1 + 0.4 * u1 * u1) * fz_h;
  e0 = zD1.fz_bq(zC1.fz_bq(zB1.fz_bq(e0, FZ_2), FZ_3), FZ_4);
  e1 = zD2.fz_bq(zC2.fz_bq(zB2.fz_bq(e1, FZ_2), FZ_3), FZ_4);
  ea = max(abs(e0), abs(e1)); fz_e += (ea - fz_e) * (ea > fz_e ? fz_ka : fz_kr);
  g = fz_o * max(0.25, min(1, 0.05 * fz_p / (fz_e + 0.000001)));
  fz_l += g * e0; fz_r += g * e1;
);
function fz_clr() (
  zA1.fz_bqz(); zA2.fz_bqz(); zB1.fz_bqz(); zB2.fz_bqz(); zC1.fz_bqz(); zC2.fz_bqz(); zD1.fz_bqz(); zD2.fz_bqz();
  fz_h = fz_p = fz_e = 0;
);
function fz_one(l, r) ( fz_l = l; fz_r = r; fz_o > 0.0001 ? fz_run(); );

function set_rate() (
  c_sw = coef(0.015); c_kn = coef(0.03);
  rs_c = 1 / (0.015 * srate);
  pf_a = coef(0.0005); ps_a = coef(0.025); p_r = coef(0.06);
  sm_c = coef(0.04); sm_lc = coef(1.2); sm_g = coef(0.02);
  g_top = 0.45 * srate;
);
function kl_params() (
  in_setup(trim_db, guard);
  os_tf = os_f2n(os_sl);
  drift_macro(0);
  xo_t = tan($pi * split / srate);
  sb_t = tan($pi * min(sub_f, g_top) / srate);
);

in_init();
os_design();
os_base = 0; os_f = os_tf = os_f2n(os_sl);
os_gsetup();
memset(DRY, 0, 2048); memset(DLY, 0, 192); dw = 0;
d3.drift_init(0.8 + rand(1) * 0.4); d4.drift_init(0.9 + rand(1) * 0.4); d5.drift_init(1.0 + rand(1) * 0.4);
set_rate();
kl_params();
xo_g = xo_t; sb_g = sb_t;
out_s = db2g(out_db); lo_s = low_db; mo_s = mono; pu_s = punch; smo_s = smooth; by_s = byp; sbin_s = sub_in;
sm_avg = -40; sm_rd = -40; ha_s = harm; to_s = tone; hg_rate();
fz_coefs(srate * os_f); fz_o = 0.33 * min(max((harm - 40) / 60, 0), 1);

#kl_pmn = "Init|Tight Kick|Smooth Bass|Mono Master|Small Speakers|Deep Weight|Punchy Drums|Even Bass Line|Warm Glow|Clean Sub|Club Master|Gentle Master|Bright Bass|Vintage Low End";
function load_preset(p) local(i) (
  split = 100; sub_f = 20; sub_in = 0; punch = 0; smooth = 0; low_db = 0; mono = 0;
  harm = 0; tone = 50; drift = 50; out_db = 0;
  p == 2 ? ( split = 110; sub_in = 1; sub_f = 28; punch = 55; smooth = 10; low_db = 0.5; out_db = -0.9; ) :
  p == 3 ? ( split = 140; smooth = 65; low_db = 1; out_db = -0.1; ) :
  p == 4 ? ( split = 120; sub_in = 1; sub_f = 20; mono = 100; smooth = 15; out_db = 0.2; ) :
  p == 5 ? ( split = 90; harm = 55; tone = 60; smooth = 25; mono = 50; out_db = 0.1; ) :
  p == 6 ? ( split = 80; low_db = 2.5; smooth = 35; sub_in = 1; sub_f = 18; mono = 40; out_db = -0.5; ) :
  p == 7 ? ( split = 160; punch = 75; low_db = 0.5; harm = 15; tone = 40; out_db = -2.1; ) :
  p == 8 ? ( split = 180; smooth = 90; punch = 15; mono = 30; out_db = 0; ) :
  p == 9 ? ( split = 120; harm = 35; tone = 20; low_db = 1; smooth = 20; drift = 60; out_db = -0.3; ) :
  p == 10 ? ( split = 70; sub_in = 1; sub_f = 32; mono = 100; out_db = 0.2; ) :
  p == 11 ? ( split = 110; sub_in = 1; sub_f = 22; punch = 40; smooth = 30; low_db = 1.5; mono = 100; harm = 20; tone = 40; out_db = -1; ) :
  p == 12 ? ( split = 100; sub_in = 1; sub_f = 16; punch = 15; smooth = 20; mono = 60; harm = 10; out_db = -0.1; ) :
  p == 13 ? ( split = 150; harm = 50; tone = 90; punch = 20; out_db = -0.4; ) :
  p == 14 ? ( split = 130; harm = 40; tone = 35; drift = 80; smooth = 40; low_db = 1; out_db = -0.2; );
  i = 1; loop(11, ui_auto(i); i += 1; );
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(16, i != 16 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 14 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(14, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@slider
prs_chk();
kl_params();
os_snap(slider(15));

@block
prs_chk();
kl_params();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? rs_req = 1;
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_bot_ch = 0; pdc_top_ch = 2;
kz_vu_d = max(kz_vu_d, sqrt(kz_ms / max(samplesblock, 1))); kz_ms = 0;
kz_pk_d = max(kz_pk_d, kz_pkm); kz_pkm = 0;
os_snapb(slider(15));

@sample
rs_req ? (
  rs_req = 0; rs_f = 0;
  sbl.sv_clr(); sbr.sv_clr(); xm.xo_clr(); xs.xo_clr();
  hg.hg_clr(); hu.os_clr(); hd.os_clr(); huL.os_clr(); huR.os_clr(); hdL.os_clr(); hdR.os_clr(); fz_clr();
  memset(DRY, 0, 2048); memset(DLY, 0, 192);
  rs_x = pdc_delay > 0 ? 0 : 1; rs_wait = pdc_delay;
);
rw_l = spl0; rw_r = spl1;
os_gate();
os_chg ? ( hu.os_clr(); hd.os_clr(); hg.hg_clr(); hg_rate(); huL.os_clr(); huR.os_clr(); hdL.os_clr(); hdR.os_clr(); fz_clr(); fz_coefs(srate * os_f); );

(cr_n -= 1) <= 0 ? (
  cr_n = 32;
  c32 = 1 - exp(-32 / (0.03 * srate));
  ha_s += (harm - ha_s) * c32; abs(harm - ha_s) < 0.01 ? ha_s = harm;
  to_s += (tone - to_s) * c32; abs(tone - to_s) < 0.01 ? to_s = tone;
  hg_a = 0.7 * (ha_s * 0.01) ^ 1.5;
  fz_o = 0.33 * min(max((ha_s - 40) / 60, 0), 1);
  dr_i = 32 * 0.2 * dm_s / srate;
  dr3 = 1 + 0.35 * dm_a * d3.drift_tick(dr_i); dr4 = 1 + 0.35 * dm_a * d4.drift_tick(dr_i); dr5 = 1 + 0.35 * dm_a * d5.drift_tick(dr_i);
  tt = to_s * 0.01;
  hw2 = 0.6 - 0.4 * tt; hw3 = 0.35 * dr3; hw4 = (0.1 + 0.25 * tt) * dr4; hw5 = (0.05 + 0.25 * tt) * dr5;
  hg_g += (tan($pi * min(split, 0.2 * srate) / (srate * os_f)) - hg_g) * c32;
);

out_s += (db2g(out_db) - out_s) * c_kn;
xo_g += (xo_t - xo_g) * c_kn; sb_g += (sb_t - sb_g) * c_kn;
lo_s += (low_db - lo_s) * c_kn; mo_s += (mono - mo_s) * c_kn;
pu_s += (punch - pu_s) * c_kn; smo_s += (smooth - smo_s) * c_kn;
sbin_s += (sub_in - sbin_s) * c_sw;

in_process(spl0, spl1);
xl = in_l; xr = in_r;

sbin_s > 0.00001 ? (
  sbl.sv_run(xl, sb_g, 1.4142135623730951); sbr.sv_run(xr, sb_g, 1.4142135623730951);
  xl += (sbl.hp - xl) * sbin_s; xr += (sbr.hp - xr) * sbin_s;
);

xm.xo_run((xl + xr) * 0.5); xs.xo_run((xl - xr) * 0.5);
lm = xm.lo; ls = xs.lo;

lv = max(abs(lm + ls), abs(lm - ls));
pf += (lv - pf) * (lv > pf ? pf_a : p_r);
ps += (lv - ps) * (lv > ps ? ps_a : p_r);
gp = pu_s > 0.01 ? min(6, max(0, g2db((pf + 0.00001) / (ps + 0.00001)) * 1.2)) * pu_s * 0.01 : 0;
sm_ms += (lv * lv - sm_ms) * sm_c;
sm_rd = g2db(sqrt(sm_ms) + 0.000000001);
sm_avg += (max(sm_rd, -60) - sm_avg) * sm_lc;
sm_t = smo_s > 0.01 && sm_rd > -54 ? max(-6, min(6, (sm_avg - sm_rd) * 0.8)) * smo_s * 0.01 : 0;
sm_rd < -54 ? sm_t = min(sm_t, 0);
gs += (sm_t - gs) * sm_g;
ga = gp + gs;
ac_hi_d = max(ac_hi_d, ga); ac_lo_d = min(ac_lo_d, ga);
lg = db2g(ga + lo_s);
lm *= lg; ls *= lg * (1 - mo_s * 0.01);

hl = xm.hi + xs.hi; hr = xm.hi - xs.hi;
os_f == 1 ? (
  hg_a > 0 ? lm += hg.hg_run(lm);
  fz_o > 0.0001 ? ( fz_one(hl, hr); hl = fz_l; hr = fz_r; );
) : (
  hu.os_up(lm);
  hg_a > 0 ? (
    os_f == 2 ? lm = hd.os_dn(hu.s0 + hg.hg_run(hu.s0), hu.s1 + hg.hg_run(hu.s1), 0, 0) :
    lm = hd.os_dn(hu.s0 + hg.hg_run(hu.s0), hu.s1 + hg.hg_run(hu.s1), hu.s2 + hg.hg_run(hu.s2), hu.s3 + hg.hg_run(hu.s3));
  ) : (
    lm = hd.os_dn(hu.s0, hu.s1, hu.s2, hu.s3);
  );
  huL.os_up(hl); huR.os_up(hr);
  fz_o > 0.0001 ? (
    fz_one(huL.s0, huR.s0); fa0 = fz_l; fb0 = fz_r; fz_one(huL.s1, huR.s1); fa1 = fz_l; fb1 = fz_r;
    os_f == 2 ? ( hl = hdL.os_dn(fa0, fa1, 0, 0); hr = hdR.os_dn(fb0, fb1, 0, 0); ) : (
      fz_one(huL.s2, huR.s2); fa2 = fz_l; fb2 = fz_r; fz_one(huL.s3, huR.s3); fa3 = fz_l; fb3 = fz_r;
      hl = hdL.os_dn(fa0, fa1, fa2, fa3); hr = hdR.os_dn(fb0, fb1, fb2, fb3);
    );
  ) : (
    hl = hdL.os_dn(huL.s0, huL.s1, huL.s2, huL.s3); hr = hdR.os_dn(huR.s0, huR.s1, huR.s2, huR.s3);
  );
  dl_n = os_lat(os_f);
  DLY[dw & DMASK] = ls; ls = DLY[(dw - dl_n) & DMASK];
);

ol = (lm + ls + hl) * out_s * os_g; orr = (lm - ls + hr) * out_s * os_g;

DRY[dw & RMASK] = rw_l; DRY[1024 + (dw & RMASK)] = rw_r;
dy_l = DRY[(dw - pdc_delay) & RMASK]; dy_r = DRY[1024 + ((dw - pdc_delay) & RMASK)];
rs_f < 1 ? (
  rs_wait > 0 ? rs_wait -= 1 : ( rs_f = min(rs_f + rs_c, 1); rs_x = min(rs_x + 3 * rs_c, 1); );
  rs_s = rs_f * rs_f * (3 - 2 * rs_f); rs_xs = rs_x * rs_x * (3 - 2 * rs_x);
  rs_dl = rw_l + (dy_l - rw_l) * rs_xs; rs_dr = rw_r + (dy_r - rw_r) * rs_xs;
  ol = rs_dl + (ol - rs_dl) * rs_s; orr = rs_dr + (orr - rs_dr) * rs_s;
);
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( ol += (dy_l - ol) * by_s; orr += (dy_r - orr) * by_s; );
dw = (dw + 1) & 65535;
spl0 = ol; spl1 = orr;
kz_ms += 0.5 * (spl0 * spl0 + spl1 * spl1);
kz_pkm = max(kz_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
ui_begin(900, 355);
mk_face = 0xA4502A; mk_band = 0x1E242C; mk_ink = 0xF6EADB; mk_acc = 0xF3D2AE; mk_tab = 0xF3D2AE;
mk_sub = 0x351A0D; mk_hot = 0xF2B65A; mk_brass = 0xD8B46A;
mk_ink2 = ui_mix(mk_ink, mk_sub, 0.35);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 12 * sc);
  mg_f12 = ui_fitarial(12, 13 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
ck_font = 13; lk_font = 13; lk_font2 = 13;
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
