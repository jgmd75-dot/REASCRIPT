desc:Pulse Mini [drum machine] (GFX Lab)
//tags: instrument drum machine synthesis sequencer fm physical modelling mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-clip, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-power, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider65:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,3,1{Analog,FM,Physical,Digital}>-Character
slider2:0<0,1,1{Off,On}>-Follow (transport)
slider3:0<0,75,1>-Swing (%)
slider4:1<1,8,1>-Pattern slot
slider5:0<0,1,1{Off,On}>-MIDI out
slider6:0<0,16,1>-MIDI channel (0 = omni in, 10 out)
slider7:0<-24,12,0.1>-Volume (dB)
slider8:-12<-40,0,0.1>-Comp threshold (dB)
slider9:4<1,20,0.1>-Comp ratio
slider10:10<0.1,100,0.1>-Comp attack (ms)
slider11:120<10,1000,1>-Comp release (ms)
slider12:6<0,24,0.1>-Comp makeup (dB)
slider13:0<0,100,1>-Comp mix (%)
slider14:0<-24,24,0.1>-Kick tune (st)
slider15:100<25,400,1>-Kick decay (%)
slider16:50<0,100,1>-Kick tone (%)
slider17:50<0,100,1>-Kick snap (%)
slider18:85<0,100,1>-Kick level (%)
slider19:0<-100,100,1>-Kick pan
slider20:0<-24,24,0.1>-Snare tune (st)
slider21:100<25,400,1>-Snare decay (%)
slider22:50<0,100,1>-Snare tone (%)
slider23:50<0,100,1>-Snare snap (%)
slider24:75<0,100,1>-Snare level (%)
slider25:0<-100,100,1>-Snare pan
slider26:0<-24,24,0.1>-Clap tune (st)
slider27:100<25,400,1>-Clap decay (%)
slider28:50<0,100,1>-Clap tone (%)
slider29:50<0,100,1>-Clap snap (%)
slider30:70<0,100,1>-Clap level (%)
slider31:-10<-100,100,1>-Clap pan
slider32:0<-24,24,0.1>-Closed hat tune (st)
slider33:100<25,400,1>-Closed hat decay (%)
slider34:50<0,100,1>-Closed hat tone (%)
slider35:50<0,100,1>-Closed hat snap (%)
slider36:60<0,100,1>-Closed hat level (%)
slider37:25<-100,100,1>-Closed hat pan
slider38:0<-24,24,0.1>-Open hat tune (st)
slider39:100<25,400,1>-Open hat decay (%)
slider40:50<0,100,1>-Open hat tone (%)
slider41:50<0,100,1>-Open hat snap (%)
slider42:55<0,100,1>-Open hat level (%)
slider43:25<-100,100,1>-Open hat pan
slider44:0<-24,24,0.1>-Tom tune (st)
slider45:100<25,400,1>-Tom decay (%)
slider46:50<0,100,1>-Tom tone (%)
slider47:50<0,100,1>-Tom snap (%)
slider48:70<0,100,1>-Tom level (%)
slider49:-20<-100,100,1>-Tom pan
slider50:0<-24,24,0.1>-Perc tune (st)
slider51:100<25,400,1>-Perc decay (%)
slider52:50<0,100,1>-Perc tone (%)
slider53:50<0,100,1>-Perc snap (%)
slider54:60<0,100,1>-Perc level (%)
slider55:-35<-100,100,1>-Perc pan
slider56:0<-24,24,0.1>-Cymbal tune (st)
slider57:100<25,400,1>-Cymbal decay (%)
slider58:50<0,100,1>-Cymbal tone (%)
slider59:50<0,100,1>-Cymbal snap (%)
slider60:50<0,100,1>-Cymbal level (%)
slider61:35<-100,100,1>-Cymbal pan
slider62:50<0,100,1>-Drift (%)
slider63:0<0,100,1>-Sat (%)
slider64:prs_sel=0<0,9,1{No preset,Init,Analog Boom,Analog Tight,FM Metal,FM Electro,Wood and Skin,Hand Drums,Lo-Fi Digital,Crunch}>-Preset

in_pin:none
out_pin:left output
out_pin:right output

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider61, v); slider_show(slider62, v); slider_show(slider63, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(slider57, v); slider_show(slider58, v); slider_show(slider59, v); slider_show(slider60, v); slider_show(slider61, v); slider_show(slider62, v); slider_show(slider63, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-g-pulse-mini";

NV = 8;
PAT = 1000; LEN = 1256; MUTE = 1264;
CUR = 1280;
CLB = 1400; SLOTS = 2000; SLN = 264;
MR = 5000; MA = 5030;
KB = 6000;
NMAP = 7000;
EVQ = 7200;
NOFF = 9300;
VLT = 9320;

function mset(s, r0, r1, r2, r3, r4, r5, a0, a1, a2, a3, a4, a5) (
  MR[s * 6] = r0; MR[s * 6 + 1] = r1; MR[s * 6 + 2] = r2; MR[s * 6 + 3] = r3; MR[s * 6 + 4] = r4; MR[s * 6 + 5] = r5;
  MA[s * 6] = a0; MA[s * 6 + 1] = a1; MA[s * 6 + 2] = a2; MA[s * 6 + 3] = a3; MA[s * 6 + 4] = a4; MA[s * 6 + 5] = a5;
);
mset(0, 1, 1.594, 2.136, 2.296, 2.653, 2.918,  1, 0.65, 0.5, 0.42, 0.32, 0.25);
mset(1, 1, 1.652, 2.338, 3.211, 4.282, 5.394,  1, 0.95, 0.85, 0.75, 0.65, 0.55);
mset(2, 1, 2.756, 5.404, 8.933, 13.34, 18.64,  1, 0.45, 0.22, 0.11, 0.05, 0.025);
mset(3, 1, 1.37, 2.08, 2.91, 3.62, 4.43,       1, 0.8, 0.6, 0.45, 0.3, 0.2);

gi = 0; loop(128, NMAP[gi] = -1; gi += 1; );
NMAP[35] = NMAP[36] = 0; NMAP[38] = 1; NMAP[40] = 2; NMAP[22] = NMAP[42] = NMAP[44] = 3; NMAP[26] = NMAP[46] = 4;
NMAP[48] = NMAP[50] = NMAP[45] = NMAP[47] = NMAP[43] = NMAP[58] = NMAP[41] = NMAP[39] = 5;
NMAP[37] = 6; gi = 27; loop(8, NMAP[gi] = 6; gi += 1; );
NMAP[49] = NMAP[55] = NMAP[57] = NMAP[52] = NMAP[51] = NMAP[59] = NMAP[53] = 7;
function out_note(v) ( v == 0 ? 36 : v == 1 ? 38 : v == 2 ? 40 : v == 3 ? 42 : v == 4 ? 46 : v == 5 ? 45 : v == 6 ? 27 : 49; );
function vname(v) ( v == 0 ? "KICK" : v == 1 ? "SNARE" : v == 2 ? "CLAP" : v == 3 ? "CL HAT" : v == 4 ? "OP HAT" : v == 5 ? "TOM" : v == 6 ? "PERC" : "CYMBAL"; );

function f_set(fc, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(max(fc, 20), srate * 0.45) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function f_run(x) instance(g, k, a1, a2, a3, ic1, ic2, bp, lp, hp) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  bp = v1; lp = v2; hp = x - k * v1 - v2;
  bp;
);
function f_out(t) instance(bp, lp, hp) ( t == 0 ? lp : t == 1 ? bp : hp; );
function f_clear() instance(ic1, ic2) ( ic1 = 0; ic2 = 0; );
function dcoef(t) ( exp(-6.9 / (max(t, 0.0005) * srate)); );
function sq(p) ( p - floor(p) < 0.5 ? 1 : -1; );

function recipe(m, k) (
  rf = 100; rpd = 0; rpt = 0.03; rom = 0; ror = 1; rix = 0; rit = 0.05; rol = 0; rod = 0.2;
  rnl = 0; rnt = 1; rnf = 1000; rnq = 0.7; rnd = 0.1; rnb = 0;
  rml = 0; rmd = 0.1; rkl = 0; rks = 0; rkf = 100; rkd = 0.3; rkdm = 0.5; rkw = 0;
  rcl = 0; rvt = 0; rvf = 1000; rvq = 0.7; rcr = 0; rtr = 1;
  k == 0 ? (
    m == 0 ? ( rf = 52; rpd = 3; rpt = 0.035; rol = 1; rod = 0.45; rcl = 0.35; ) :
    m == 1 ? ( rf = 50; rpd = 2; rpt = 0.04; rom = 1; ror = 1; rix = 4; rit = 0.02; rol = 1; rod = 0.5; rcl = 0.15; ) :
    m == 2 ? ( rf = 50; rpd = 0.6; rpt = 0.05; rol = 0.6; rod = 0.3; rkl = 0.8; rks = 0; rkf = 50; rkd = 0.55; rkdm = 1.2; rcl = 0.2; ) :
             ( rf = 50; rpd = 4; rpt = 0.03; rom = 2; rix = 0.9; rit = 0.05; rol = 1; rod = 0.4; rcr = 1; );
  ) : k == 1 ? (
    m == 0 ? ( rf = 185; ror = 1.78; rom = 4; rpd = 0.3; rpt = 0.02; rol = 0.6; rod = 0.12;
               rnl = 0.8; rnt = 1; rnf = 5000; rnq = 0.6; rnd = 0.2; rcl = 0.2; ) :
    m == 1 ? ( rf = 200; rom = 1; ror = 1.47; rix = 3; rit = 0.03; rol = 0.6; rod = 0.1;
               rnl = 0.7; rnt = 1; rnf = 3500; rnq = 0.8; rnd = 0.18; ) :
    m == 2 ? ( rkl = 0.9; rks = 0; rkf = 190; rkd = 0.22; rkdm = 0.6; rkw = 1.2; rnl = 0.35; rnt = 1; rnf = 4500; rnq = 0.6; rnd = 0.16; rcl = 0.35; ) :
             ( rf = 210; rom = 2; rix = 0.7; rit = 0.04; rol = 0.5; rod = 0.1;
               rnl = 0.8; rnt = 1; rnf = 4000; rnq = 0.7; rnd = 0.2; rcr = 1; );
  ) : k == 2 ? (
    m == 0 ? ( rnl = 1; rnt = 1; rnf = 1100; rnq = 1.4; rnd = 0.18; rnb = 1; ) :
    m == 1 ? ( rnl = 1; rnt = 1; rnf = 1300; rnq = 1; rnd = 0.16; rnb = 1;
               rf = 900; rom = 1; ror = 2.3; rix = 5; rit = 0.01; rol = 0.3; rod = 0.02; ) :
    m == 2 ? ( rkl = 0.6; rks = 3; rkf = 850; rkd = 0.05; rkdm = 0.3; rnl = 0.9; rnt = 1; rnf = 1400; rnq = 1.1; rnd = 0.17; rnb = 1; ) :
             ( rnl = 1; rnt = 1; rnf = 1500; rnq = 1; rnd = 0.15; rnb = 1; rcr = 1; );
  ) : (k == 3 || k == 4) ? (
    m == 0 ? ( rml = 1; rmd = 0.045; rnl = 0.15; rnt = 2; rnf = 9000; rnd = 0.03; rvt = 1; rvf = 7000; ) :
    m == 1 ? ( rf = 4300; rom = 1; ror = 1.4727; rix = 14; rit = 0.5; rol = 0.6; rod = 0.045;
               rnl = 0.5; rnt = 2; rnf = 8000; rnd = 0.04; rvt = 1; rvf = 6500; ) :
    m == 2 ? ( rkl = 0.4; rks = 1; rkf = 4200; rkd = 0.05; rkdm = 0.15; rnl = 0.8; rnt = 1; rnf = 9000; rnq = 0.9; rnd = 0.05;
               rcl = 0.15; rvt = 1; rvf = 6500; ) :
             ( rnl = 0.8; rnt = 2; rnf = 8000; rnd = 0.045; rml = 0.4; rmd = 0.04; rcr = 1; rvt = 1; rvf = 5500; );
    k == 4 ? ( rmd *= 8; rod *= 8; rkd *= 8; rnd *= 8; );
  ) : k == 5 ? (
    m == 0 ? ( rf = 120; rpd = 0.6; rpt = 0.08; rol = 1; rod = 0.35; rnl = 0.1; rnt = 0; rnf = 2000; rnd = 0.05; rcl = 0.15; ) :
    m == 1 ? ( rf = 115; rpd = 0.4; rpt = 0.08; rom = 1; ror = 1.5; rix = 2; rit = 0.05; rol = 1; rod = 0.35; ) :
    m == 2 ? ( rkl = 1; rks = 0; rkf = 110; rkd = 0.45; rkdm = 0.8; rcl = 0.1; ) :
             ( rf = 125; rpd = 0.8; rpt = 0.06; rom = 2; rix = 0.6; rit = 0.1; rol = 1; rod = 0.3; rcr = 1; );
  ) : k == 6 ? (
    m == 0 ? ( rf = 540; rom = 3; ror = 1.48; rol = 0.7; rod = 0.25; rvt = 2; rvf = 800; rvq = 1.5; ) :
    m == 1 ? ( rf = 620; rom = 1; ror = 3.5; rix = 2.5; rit = 0.15; rol = 1; rod = 0.3; ) :
    m == 2 ? ( rkl = 1; rks = 2; rkf = 800; rkd = 0.2; rkdm = 0.5; rcl = 0.2; ) :
             ( rf = 700; rom = 2; rix = 0.8; rit = 0.08; rol = 0.8; rod = 0.15; rcr = 1; rvt = 2; rvf = 1000; rvq = 1; );
  ) : (
    m == 0 ? ( rml = 1; rmd = 1.2; rnl = 0.3; rnt = 2; rnf = 9000; rnd = 0.9; rvt = 2; rvf = 8000; rvq = 0.7; ) :
    m == 1 ? ( rf = 3100; rom = 1; ror = 2.4311; rix = 12; rit = 1.5; rol = 0.6; rod = 1.2;
               rnl = 0.45; rnt = 2; rnf = 7500; rnd = 1; rvt = 1; rvf = 4000; ) :
    m == 2 ? ( rkl = 0.6; rks = 1; rkf = 1150; rkd = 1.6; rkdm = 0.05; rnl = 0.5; rnt = 2; rnf = 7000; rnd = 1.1; rcl = 0.2; rvt = 1; rvf = 2500; ) :
             ( rnl = 0.7; rnt = 2; rnf = 7000; rnd = 1.1; rml = 0.6; rmd = 0.9; rcr = 1; rvt = 1; rvf = 3500; );
  );
  rtr = TRIM[m * 8 + k];
);
TRIM = 9400;

SPT = 9440; SPD = 9450; MDT = 9460;
SPT[0] = 0.31; SPT[1] = -0.62; SPT[2] = 0.18; SPT[3] = 0.47; SPT[4] = -0.36; SPT[5] = -0.85; SPT[6] = 0.66; SPT[7] = -0.29;
SPD[0] = -0.4; SPD[1] = 0.7; SPD[2] = 0.2; SPD[3] = -0.6; SPD[4] = 0.5; SPD[5] = 0.3; SPD[6] = -0.8; SPD[7] = 0.45;
MDT[0] = 0.0021; MDT[1] = -0.0034; MDT[2] = 0.0015; MDT[3] = -0.0011; MDT[4] = 0.0029; MDT[5] = -0.0024;
function sqb(p, d, ni) local(t) (
  p < 0.5 ? (
    p < d ? ( t = p * ni; t + t - t * t; ) : p > 0.5 - d ? ( t = (p - 0.5) * ni; 1 - t * t - t - t - 1; ) : 1;
  ) : (
    p < 0.5 + d ? ( t = (p - 0.5) * ni; t * t - t - t; ) : p > 1 - d ? ( t = (p - 1) * ni; t * t + t + t; ) : -1;
  );
);
function mclu_set(tm, a) instance(d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  d1 = 205.3 * tm * (1 + a * MDT[0]) / srate; d2 = 304.4 * tm * (1 + a * MDT[1]) / srate; d3 = 369.6 * tm * (1 + a * MDT[2]) / srate;
  d4 = 522.7 * tm * (1 + a * MDT[3]) / srate; d5 = 540 * tm * (1 + a * MDT[4]) / srate;   d6 = 800 * tm * (1 + a * MDT[5]) / srate;
  n1 = 1 / d1; n2 = 1 / d2; n3 = 1 / d3; n4 = 1 / d4; n5 = 1 / d5; n6 = 1 / d6;
);
function mclu_run() instance(p1, p2, p3, p4, p5, p6, d1, d2, d3, d4, d5, d6, n1, n2, n3, n4, n5, n6) (
  p1 += d1; p1 >= 1 ? p1 -= 1; p2 += d2; p2 >= 1 ? p2 -= 1; p3 += d3; p3 >= 1 ? p3 -= 1;
  p4 += d4; p4 >= 1 ? p4 -= 1; p5 += d5; p5 >= 1 ? p5 -= 1; p6 += d6; p6 >= 1 ? p6 -= 1;
  (sqb(p1, d1, n1) + sqb(p2, d2, n2) + sqb(p3, d3, n3) + sqb(p4, d4, n4) + sqb(p5, d5, n5) + sqb(p6, d6, n6)) * 0.16666667;
);
function asoft(x) instance(x1) local(y) (
  abs(x) <= 1.5 && abs(x1) <= 1.5 ? y = (x + x1) * (0.5 - (x * x + x1 * x1) * 0.037037037) :
  abs(x - x1) > 0.00001 ? y = (this.clp_ad(x) - this.clp_ad(x1)) / (x - x1) : y = this.clp_crv(0.5 * (x + x1));
  x1 = x;
  y;
);
function atrig(k, vel, tm, dm, tn, sn, lv) instance(qk, qhk, qhx, qhy, qa, qu1, qv1, qu2, qv2, qr1, qr2, qw1, qw2, qe1, qe2, qf2, qm2,
                                              qpn, qpa, qps, qpc, qpg, qsw, qsd, qsc, qscc, qch, qcy, qhc, qcl, qtl, qtc,
                                              qdg, qdt, qne, qnc, qnl, qnt, qnf, qme, qmc, qme2, qmc2, qhp, qb1, qb2, qmcl,
                                              qbt, qb2t, qb3t, qb4t, qbe, qba, qbc, qbv, qtt, qte, qta, qog, qogt, qdr, qkc, qcf, qcc)
                                     local(a, ak, tf, df, am, f1, f2, pd, pt, d1, d2, cl, nl, nf, nq, nd, w, t) (
  a = dm_a; ak = an_acc;
  tf = tm * (1 + a * (0.006 * SPT[k] - 0.005 * an_wrm + 0.002 * qdr.v + 0.0007 * (rand(2) - 1)));
  df = dm * (1 + a * (0.05 * SPD[k] + 0.02 * (rand(2) - 1))) * (1 + 0.04 * ak);
  am = vel * (1 + a * 0.02 * (rand(2) - 1));
  qk = k;
  k == 3 || k == 4 ? (
    qme = max(qme, am * (1 + 0.05 * ak)); qmc = dcoef((k == 3 ? 0.045 : 0.36) * df);
    qhk = tan($pi * min(7000 * 2 ^ (tn - 0.5) * tm, 0.45 * srate) / srate); qhk /= 1 + qhk;
  ) : k == 7 ? (
    qmcl.mclu_set(tf, a);
    qme = max(qme, am * (1 + 0.05 * ak)); qmc = dcoef(1.2 * df);
    qme2 = max(qme2, am); qmc2 = dcoef(0.35 * df);
    qb1.f_set(3400 * tf, 1.2); qb2.f_set(7500 * tf, 1);
    qhk = tan($pi * min(2000 * 2 ^ ((tn - 0.5) * 2) * tm, 0.45 * srate) / srate); qhk /= 1 + qhk;
  ) : k == 2 ? (
    t = 0.0004 * a * srate;
    qbt = 0; qb2t = floor(0.0105 * srate + t * (rand(2) - 1)); qb3t = floor(0.0212 * srate + t * (rand(2) - 1));
    qb4t = floor(0.0315 * srate + t * (rand(2) - 1));
    qba = am * (1 + 0.03 * ak); qbe = qba; qbc = dcoef(0.0065 / (1 + 0.3 * ak));
    qbv = am * 0.9; qnc = dcoef(0.18 * df); qta = 1 - exp(-1 / (0.004 * srate));
    qb1.f_set(1100 * 2 ^ ((tn - 0.5) * 1.5) * tm, 1.4);
  ) : (
    nl = 0; nf = 1000; nq = 0.7; nd = 0.1; f2 = 0; d2 = 0.1; qm2 = 0; qnt = 1; qdg = 1; t = 1;
    k == 0 ? ( f1 = 52;  pd = 3;   pt = 0.035; d1 = 0.45; cl = 0.35; qdg = 0.7; ) :
    k == 5 ? ( f1 = 120; pd = 0.6; pt = 0.08;  d1 = 0.35; cl = 0.15; qdg = 0.7; nl = 0.1; qnt = 0; nf = 2000; nd = 0.05; ) :
    k == 1 ? ( f1 = 185; f2 = 329.3; qm2 = 0.67 * (0.4 + 1.2 * tn); pd = 0.3; pt = 0.02; d1 = 0.12; d2 = 0.1; cl = 0.2;
               qdg = 0.5; t = 0.36; nl = 0.8; nf = 5000; nq = 0.6; nd = 0.2; ) :
             ( f1 = 540; f2 = 800; qm2 = 1; pd = 0; pt = 0.01; d1 = 0.25; d2 = 0.2; cl = 0; qdg = 1.6; t = 0.35;
               qhp.f_set(800 * 2 ^ (tn - 0.5) * tm, 1.5); );
    pd *= (0.3 + 1.4 * sn) * (1 + 0.4 * ak); cl *= 2 * sn * (1 + (k == 0 ? 0.5 : 1) * ak);
    w = $pi / srate;
    qw1 = min(f1 * tf * w, 1.2); qe1 = 2 * sin(qw1); qr1 = dcoef(d1 * df);
    qf2 = f2 > 0; qw2 = min(f2 * tf * w, 1.2); qe2 = 2 * sin(qw2); qr2 = dcoef(d2 * df);
    qsd = pd; qsc = dcoef(pt * dm * (1 + 0.3 * ak)); qscc = 1 - exp(-1 / (0.0002 * srate));
    qpn = max(floor(0.001 * srate), 1); qpg = 1 / qpn; qpa = am * (1 + 0.03 * ak); qpc = 1 - exp(-1 / (0.0001 * srate));
    qhc = exp(-2 * $pi * 1000 / srate); qcl = cl * 3;
    qcc = k == 0 ? 1 - exp(-2 * $pi * 2000 / srate) : 1;
    qtc = 1 - exp(-2 * $pi * min(700 * 30 ^ tn, 0.45 * srate) / srate);
    qdt = t / qdg;
    nl > 0 ? ( qne = max(qne, am); qnl = nl; qnc = dcoef(nd * df); qnf.f_set(nf * 2 ^ ((tn - 0.5) * 1.5) * tm, nq); );
  );
  qogt = lv * TRIM[k];
  qa == 0 ? qog = qogt;
  qa = 1;
);
function arun() instance(qk, qhk, qhx, qhy, qa, qu1, qv1, qu2, qv2, qr1, qr2, qw1, qw2, qe1, qe2, qf2, qm2,
                         qpn, qpa, qps, qpc, qpg, qsw, qsd, qsc, qscc, qch, qcy, qhc, qcl, qtl, qtc,
                         qdg, qdt, qne, qnc, qnl, qnt, qnf, qme, qmc, qme2, qmc2, qhp, qb1, qb2, qmcl,
                         qbt, qb2t, qb3t, qb4t, qbe, qba, qbc, qbv, qtt, qte, qta, qog, qogt, qkc, qcf, qcc)
                local(y, x, e1, e2, t) (
  qk == 3 || qk == 4 ? (
    x = an_hm * qme; y = (x - qhx) * qhk; qhy = y + qhx; qhx = qhy + y; y = x - qhy; qme *= qmc;
    qme < 0.00001 ? ( qa = 0; qme = qhx = qhy = 0; );
  ) : qk == 7 ? (
    x = qmcl.mclu_run();
    x = qb2.f_run(x) * qme + qb1.f_run(x) * qme2; y = (x - qhx) * qhk; qhy = y + qhx; qhx = qhy + y; y = x - qhy; qme *= qmc; qme2 *= qmc2;
    qme < 0.00001 && qme2 < 0.00001 ? ( qa = 0; qme = qme2 = qhx = qhy = 0; qb1.f_clear(); qb2.f_clear(); );
  ) : qk == 2 ? (
    qbt += 1; qbt == qb2t || qbt == qb3t ? qbe = qba : qbt == qb4t ? ( qbe = qba; qtt = max(qtt, qbv); );
    qte += (qtt - qte) * qta; qtt *= qnc;
    y = qb1.f_run((rand(2) - 1) * (qbe + qte)); qbe *= qbc;
    qbt > qb4t && qte < 0.00001 && qtt < 0.00001 && qbe < 0.00001 ? ( qa = 0; qte = qtt = qbe = 0; qb1.f_clear(); );
  ) : (
    qpn > 0 ? ( qpn -= 1; t = qpa; qsw += (1 - qsw) * qscc; ) : ( t = 0; qsw *= qsc; );
    qps += (t - qps) * qpc;
    qsw > 0.00001 ? (
      x = qw1 * (1 + qsd * qsw); x > 1.2 ? x = 1.2; e1 = x * (2 - x * x * (0.33333333 - x * x * 0.016666667));
      qf2 ? ( x = qw2 * (1 + qsd * qsw); x > 1.2 ? x = 1.2; e2 = x * (2 - x * x * (0.33333333 - x * x * 0.016666667)); );
    ) : ( qsw = 0; e1 = qe1; e2 = qe2; );
    x = qps * qpg;
    qu1 = qr1 * (qu1 - e1 * qv1) + x; qv1 = qr1 * (qv1 + e1 * qu1); t = qv1;
    qf2 ? ( qu2 = qr2 * (qu2 - e2 * qv2) + x; qv2 = qr2 * (qv2 + e2 * qu2); t += qm2 * qv2; );
    y = qkc.asoft(t * qdg) * qdt;
    qcy = qhc * (qcy + qps - qch); qch = qps; qcf += (qcy - qcf) * qcc; y += qcf * qcl;
    qk == 6 ? y = qhp.f_run(y) : ( qtl += (y - qtl) * qtc; y = qtl; );
    qne > 0.00001 ? ( qnf.f_run((rand(2) - 1) * qne); y += qnf.f_out(qnt) * qnl; qne *= qnc; ) : qne = 0;
    qpn == 0 && qne == 0 && abs(qu1) + abs(qv1) + abs(qu2) + abs(qv2) + abs(qps) + abs(qtl) < 0.000001 ? (
      qa = 0; qu1 = qv1 = qu2 = qv2 = qps = qsw = qch = qcy = qcf = qtl = 0; qkc.x1 = 0; qhp.f_clear();
    );
  );
  qog += (qogt - qog) * an_gl;
  y * qog;
);
function achoke() instance(qmc) ( qmc = min(qmc, an_chk); );

function vtrig(k, vel) instance(f0, pd, pe, pec, om, orr, ix, ie, iec, ol, oe, oec, pc, pm,
                               nl, ne, nec, nb, nbt, nbv, nbc, nbi, ml, me, mec, mt,
                               kl, kset, kmx, kmc, kw, kenv, kfc, xe, xec, xlc, xlp, ximp, xt, xn,
                               cl, ce, cec, vt, cr, crh, crc, crn, crq, amp, gl, gr, act, kbs, nfl, pfl, nt,
                               mp1, mp2, mp3, mp4, mp5, mp6, of, ofn, clp, clc)
                     local(b, tm, dm, tn, sn, i, f, t, r, mm) (
  b = 14 + k * 6;
  tm = 2 ^ (slider(b) / 12); dm = slider(b + 1) / 100; tn = slider(b + 2) / 100; sn = slider(b + 3) / 100;
  mm = (slider(b + 4) / 100);
  t = (slider(b + 5) / 100 + 1) * $pi * 0.25; gl = cos(t) * 1.4142; gr = sin(t) * 1.4142;
  model == 0 ? this.atrig(k, vel, tm, dm, tn, sn, mm * mm) : (
  recipe(model, k);
  model == 1 ? rix *= 0.25 + 1.5 * tn : model == 3 ? rix = min(rix * (0.4 + 1.2 * tn), 0.97) : 0;
  rnf *= 2 ^ ((tn - 0.5) * 1.5); rvf *= 2 ^ ((tn - 0.5) * (model == 0 ? 1 : 0.5));
  rpd *= 0.3 + 1.4 * sn; rcl *= 2 * sn;
  f0 = rf * tm; pd = rpd; pe = 1; pec = dcoef(rpt * dm);
  om = rom; orr = ror; ix = rix * (model == 1 ? 1 + sn : 1); ie = 1; iec = dcoef(rit * dm);
  ol = rol; oe = rol > 0; oec = dcoef(rod * dm); pc = 0; pm = 0;
  nl = rnl; ne = rnl > 0 || rkw > 0; nec = dcoef(rnd * dm); nb = rnb; nbt = 0; nbv = 1; nbc = dcoef(0.006); nbi = floor(0.011 * srate);
  nt = rnt; nfl.f_set(rnf * tm, rnq); nfl.f_clear();
  ml = rml; me = rml > 0; mec = dcoef(rmd * dm); mt = tm;
  mp1 = 0; mp2 = 0.17; mp3 = 0.41; mp4 = 0.63; mp5 = 0.29; mp6 = 0.83;
  cl = rcl; ce = rcl > 0; cec = dcoef(0.004);
  clc = k == 0 ? 1 - exp(-2 * $pi * 2500 / srate) : 1; clp = 0;
  of = 0; ofn = k == 0 && rom == 2 ? max(floor(0.0005 * srate), 1) : 0;
  vt = rvt; pfl.f_set(rvf * tm, rvq);
  cr = rcr; crc = 0; crn = max(1, floor(srate / (11000 + 29000 * tn))); crq = 128;
  kl = rkl; kset = rks; kw = rkw; kenv = 0;
  kbs = KB + k * 64; kmx = 0;
  rkl > 0 ? (
    i = 0;
    loop(6,
      f = rkf * tm * MR[kset * 6 + i];
      t = rkd * dm / (1 + rkdm * (1.6 - tn) * (MR[kset * 6 + i] - 1));
      r = f < srate * 0.45 ? exp(-6.9 / (max(t, 0.002) * srate)) : 0;
      kbs[i] = 2 * r * cos(2 * $pi * min(f, srate * 0.45) / srate); kbs[6 + i] = r * r;
      kbs[12 + i] = r > 0 ? MA[kset * 6 + i] * (1 - r * r) * 6 : 0;
      kbs[18 + i] = 0; kbs[24 + i] = 0;
      kmx = max(kmx, r);
      i += 1;
    );
    kmc = kmx; kmx = 1;
    xt = 0; xn = max(floor((0.006 - 0.0052 * sn) * srate), 2);
    xe = 1; xec = dcoef(0.012 - 0.01 * sn); xlc = 1 - exp(-2 * $pi * (1500 + 10000 * sn) / srate); xlp = 0; ximp = 0;
  ) : ( kmx = 0; xe = 0; );
  amp = mm * mm * vel * rtr;
  act = 1;
  );
);
function vrun() instance(f0, pd, pe, pec, om, orr, ix, ie, iec, ol, oe, oec, pc, pm,
                         nl, ne, nec, nb, nbt, nbv, nbc, nbi, ml, me, mec, mt,
                         kl, kset, kmx, kmc, kw, kenv, kfc, xe, xec, xlc, xlp, ximp, xt, xn,
                         cl, ce, cec, vt, cr, crh, crc, crn, crq, amp, gl, gr, act, kbs, nfl, pfl, nt,
                         mp1, mp2, mp3, mp4, mp5, mp6, p2, qa, of, ofn, clp, clc)
                local(y, ya, f, nz, w, d, x, i, a, env) (
  ya = qa ? this.arun() : 0;
  act ? (
    y = 0; nz = rand(2) - 1;
    oe > 0.0001 ? (
      f = f0 * (1 + pd * pe); pe *= pec;
      om == 0 ? ( pc += f / srate; pc -= floor(pc); x = sin(2 * $pi * pc); ) :
      om == 1 ? ( pc += f / srate; pc -= floor(pc); pm += f * orr / srate; pm -= floor(pm);
                  x = sin(2 * $pi * pc + ix * ie * sin(2 * $pi * pm)); ie *= iec; ) :
      om == 2 ? ( pc += f / srate; pc -= floor(pc); w = ix * ie; d = 0.5 * (1 - w); ie *= iec;
                  x = sin(2 * $pi * (pc < d ? pc * 0.5 / d : 0.5 + (pc - d) * 0.5 / (1 - d))); ) :
      om == 3 ? ( pc += f / srate; pc -= floor(pc); p2 += f * orr / srate; p2 -= floor(p2); x = 0.5 * (sq(pc) + sq(p2)); ) :
                ( pc += f / srate; pc -= floor(pc); p2 += f * orr / srate; p2 -= floor(p2);
                  x = 0.6 * sin(2 * $pi * pc) + 0.4 * sin(2 * $pi * p2); );
      of < ofn ? ( x *= 0.5 - 0.5 * cos($pi * of / ofn); of += 1; );
      y += x * ol * oe; oe *= oec;
    ) : oe = 0;
    ne > 0.0001 || kenv > 0.0001 ? (
      nb && nbt < 3 * nbi ? ( (nbt % nbi) == 0 ? nbv = 1; env = nbv; nbv *= nbc; nbt += 1; ) : ( env = ne; ne *= nec; );
      a = nl * env + kw * kenv;
      nfl.f_run(nz * a); y += nfl.f_out(nt);
    ) : ne = 0;
    me > 0.0001 ? (
      mp1 += 205.3 * mt / srate; mp2 += 304.4 * mt / srate; mp3 += 369.6 * mt / srate;
      mp4 += 522.7 * mt / srate; mp5 += 540 * mt / srate;   mp6 += 800 * mt / srate;
      x = (sq(mp1) + sq(mp2) + sq(mp3) + sq(mp4) + sq(mp5) + sq(mp6)) / 6;
      y += x * ml * me; me *= mec;
    ) : me = 0;
    kmx > 0.0001 ? (
      kset == 3 ? ( x = nz * (nb && nbt < 3 * nbi ? nbv : xe * 0.3); xe *= xec; ) :
                  ( xlp += (nz * xe - xlp) * xlc; x = xlp * 0.15 + (xt < xn ? sin($pi * xt / xn) * 2 / xn * 48000 / srate * 8 : 0); xt += 1; xe *= xec; );
      a = 0; i = 0;
      loop(6,
        w = kbs[i] * kbs[18 + i] - kbs[6 + i] * kbs[24 + i] + kbs[12 + i] * x;
        kbs[24 + i] = kbs[18 + i]; kbs[18 + i] = w;
        a += w; i += 1;
      );
      kenv = max(abs(a) * 0.5, kenv * 0.9995);
      y += a * kl; kmx *= kmc;
    ) : ( kmx = 0; kenv *= 0.999; );
    ce > 0.0001 ? ( clp += (nz * cl * ce - clp) * clc; y += clp; ce *= cec; ) : ce = 0;
    vt == 1 ? ( pfl.f_run(y); y = pfl.hp; ) : vt == 2 ? ( y = pfl.f_run(y); );
    cr ? ( crc -= 1; crc <= 0 ? ( crc += crn; crh = floor(y * crq + 0.5) / crq; ); y = crh; );
    act = oe > 0.0001 || ne > 0.0001 || me > 0.0001 || kmx > 0.0001 || ce > 0.0001 || kenv > 0.0001;
    ya + y * amp;
  ) : ya;
);
function v_trig(i, vel) local(ak, t) (
  VLT[i] = 1;
  ak = min(max(vel - 0.8, 0) * 5, 1);
  an_acc = ak * (an_seq ? an_alv : an_acb);
  !an_seq && ak > 0 ? an_acb = max(an_acb - 0.04 * ak, 0.6);
  model == 0 && (i == 3 || i == 4) ? (
    t = 2 ^ (slider(14 + i * 6) / 12) * (1 + dm_a * (0.006 * SPT[i] - 0.005 * an_wrm + 0.002 * an_hdr.v));
    an_hmc.mclu_set(t, dm_a); an_hbp.f_set(7500 * t, 1.1);
  );
  i == 0 ? v0.vtrig(0, vel) : i == 1 ? v1.vtrig(1, vel) : i == 2 ? v2.vtrig(2, vel) : i == 3 ? ( v3.vtrig(3, vel); v4.ne = 0; v4.me = 0; v4.kmx = 0; v4.oe = 0; v4.achoke(); ) :
  i == 4 ? v4.vtrig(4, vel) : i == 5 ? v5.vtrig(5, vel) : i == 6 ? v6.vtrig(6, vel) : v7.vtrig(7, vel);
);

function v_clr() instance(act, oe, ne, me, kmx, ce, kenv, xe, clp, crh, nfl, pfl,
                          qa, qpn, qps, qsw, qu1, qv1, qu2, qv2, qch, qcy, qcf, qtl, qne, qme, qme2, qhx, qhy,
                          qbt, qb4t, qbe, qte, qtt, qkc, qhp, qb1, qb2, qnf) (
  act = 0; oe = ne = me = kmx = ce = kenv = xe = clp = crh = 0; nfl.f_clear(); pfl.f_clear();
  qa = 0; qpn = 0; qps = qsw = qu1 = qv1 = qu2 = qv2 = qch = qcy = qcf = qtl = qne = qme = qme2 = qhx = qhy = 0;
  qbt = qb4t + 1; qbe = qte = qtt = 0; qkc.x1 = 0; qhp.f_clear(); qb1.f_clear(); qb2.f_clear(); qnf.f_clear();
);
function gap_clear() (
  v0.v_clr(); v1.v_clr(); v2.v_clr(); v3.v_clr(); v4.v_clr(); v5.v_clr(); v6.v_clr(); v7.v_clr();
  memset(KB, 0, 8 * 64); an_hbp.f_clear(); an_acb = 1;
  cenv = 0; ins_sc1 = ins_sc2 = 0;
  ostL.ost_ch_init(); ostR.ost_ch_init(); ost_cl.ost_acz(); ost_cr.ost_acz();
);

TRIM[0] = 1.199; TRIM[1] = 1.541; TRIM[2] = 2.901; TRIM[3] = 7.366; TRIM[4] = 7.340; TRIM[5] = 1.072; TRIM[6] = 3.556; TRIM[7] = 3.545;
TRIM[8] = 1.023; TRIM[9] = 1.274; TRIM[10] = 2.786; TRIM[11] = 0.766; TRIM[12] = 0.782; TRIM[13] = 1.012; TRIM[14] = 0.902; TRIM[15] = 0.779;
TRIM[16] = 0.104; TRIM[17] = 0.241; TRIM[18] = 0.953; TRIM[19] = 1.473; TRIM[20] = 1.466; TRIM[21] = 0.234; TRIM[22] = 5.821; TRIM[23] = 1.442;
TRIM[24] = 1.149; TRIM[25] = 1.367; TRIM[26] = 2.918; TRIM[27] = 0.872; TRIM[28] = 0.878; TRIM[29] = 1.095; TRIM[30] = 1.565; TRIM[31] = 1.033;

function pset(base, v, str) local(i, c, n) (
  n = min(strlen(str), 32);
  i = 0; loop(32, base[v * 32 + i] = 0; i += 1; );
  i = 0; loop(n, c = str_getchar(str, i); base[v * 32 + i] = c == 'X' ? 2 : (c == 'x' || c == 'o') ? 1 : 0; i += 1; );
  base[256 + v] = n > 0 ? n : 16;
);
function factory_name(p) (
  p == 0 ? "HOUSE" : p == 1 ? "TECHNO" : p == 2 ? "BREAKBEAT" : p == 3 ? "ELECTRO" :
  p == 4 ? "HIP-HOP" : p == 5 ? "TRAP (32)" : p == 6 ? "POLYRHYTHM" : "EMPTY";
);
function factory(base, p) local(i) (
  memset(base, 0, 264); i = 0; loop(8, base[256 + i] = 16; i += 1; );
  p == 0 ? (
    pset(base, 0, "X...X...X...X..."); pset(base, 2, "....X.......X..."); pset(base, 3, "xx.xxx.xxx.xxx.x");
    pset(base, 4, "..x...x...x...x."); pset(base, 6, "...x......x....."); pset(base, 7, "X...............");
  ) : p == 1 ? (
    pset(base, 0, "X...X...X...X..."); pset(base, 2, "....x.......x..."); pset(base, 3, "x.x.x.x.x.x.x.x.");
    pset(base, 4, "..X...X...X...X."); pset(base, 5, "......x.......x."); pset(base, 6, "x..x..x..x..x..x");
  ) : p == 2 ? (
    pset(base, 0, "X.x.......xx...."); pset(base, 1, "....X..x.x..X..x"); pset(base, 3, "x.x.x.x.x.x.x.x.");
    pset(base, 4, "..............x."); pset(base, 7, "X...............");
  ) : p == 3 ? (
    pset(base, 0, "X......X..X....."); pset(base, 1, "....X.......X..."); pset(base, 2, "....X.......X..x");
    pset(base, 3, "x.xxx.x.x.xxx.x."); pset(base, 5, "..........x..x..");
  ) : p == 4 ? (
    pset(base, 0, "X......x..X....."); pset(base, 1, "....X.......X..."); pset(base, 3, "x.x.x.x.x.x.x.x.");
    pset(base, 4, "..............x."); pset(base, 2, "............x..."); pset(base, 6, "...x......x.....");
  ) : p == 5 ? (
    pset(base, 0, "X.........X.......X.....x.X.....");
    pset(base, 1, "........X...............X.......");
    pset(base, 2, "........X...............X.......");
    pset(base, 3, "x.x.x.x.x.x.xxxxx.x.x.x.x.x.xxxx");
    pset(base, 7, "X...............................");
  ) : p == 6 ? (
    pset(base, 0, "X...X...X...X..."); pset(base, 2, "....X.......X..."); pset(base, 3, "x.xx.xx.xx.x");
    pset(base, 4, "..x..."); pset(base, 5, "x....x..x."); pset(base, 6, "x..x.x."); pset(base, 7, "X...............................");
  );
);
function load_slot(s) (
  memcpy(PAT, SLOTS + s * SLN, 264); cur_slot = s; modified = 0;
  slider4 = s + 1; last_s4 = slider4;
);
function save_slot(s) (
  memcpy(SLOTS + s * SLN, PAT, 264); cur_slot = s; modified = 0;
  slider4 = s + 1; last_s4 = slider4;
);
function random_pattern() local(v, s, p, q) (
  v = 0;
  loop(8,
    s = 0;
    loop(32,
      q = s % 16;
      p = v == 0 ? (q % 4 == 0 ? 0.85 : q % 2 == 0 ? 0.15 : 0.06) :
          v == 1 ? (q % 8 == 4 ? 0.9 : 0.05) :
          v == 2 ? (q % 8 == 4 ? 0.35 : 0.03) :
          v == 3 ? (q % 2 == 0 ? 0.75 : 0.3) :
          v == 4 ? (q % 4 == 2 ? 0.35 : 0.02) :
          v == 5 ? 0.07 : v == 6 ? 0.12 : (q == 0 ? 0.4 : 0.01);
      PAT[v * 32 + s] = rand(1) < p ? (rand(1) < 0.25 ? 2 : 1) : 0;
      s += 1;
    );
    v += 1;
  );
  modified = 1;
);
function update() (
  model = slider1; fol_on = slider2; swing = slider3 / 100;
  midi_out = slider5; chan = slider6; out_ch = chan == 0 ? 9 : chan - 1;
  vol_t = 10 ^ (slider7 / 20);
  cthr = slider8; crat = max(slider9, 1);
  catc = 1 - exp(-1 / (max(slider10, 0.05) * 0.001 * srate)); crlc = 1 - exp(-1 / (slider11 * 0.001 * srate));
  cmk = 10 ^ (slider12 / 20); cmix_t = slider13 / 100;
  ost_setup(sat_s, 0.3, 120, 6000, -0.3, 1); sat_t = slider63 / 100; ins_mon = 0; ins_wg = 1;
  drift_macro(slider62);
);

ext_noinit = 1;
!pat_init ? (
  pat_init = 1;
  gi = 0; loop(8, factory(SLOTS + gi * SLN, gi); gi += 1; );
  load_slot(0); memset(MUTE, 0, 8);
);
gi = 0; loop(8, CUR[gi] = -1; NOFF[gi] = 0; gi += 1; );
function pu_srinit() (
  pu_sr = srate;
  ost_init(20000);
  sm = 1 - exp(-1 / (0.03 * srate));
  an_gl = 1 - exp(-1 / (0.005 * srate));
  an_chk = dcoef(0.02); an_acr = 1 - exp(-1 / (0.05 * srate));
);
pu_srinit(); ostL.ost_ch_init(); ostR.ost_ch_init();
lastg = -1; qslot_dirty = -1; cenv = 0; cgr_d = 0; pkL_d = pkR_d = 0;
v0.qkc.clp_set(1, 1, 1, 0); v1.qkc.clp_set(1, 1, 1, 0); v5.qkc.clp_set(1, 1, 1, 0); v6.qkc.clp_set(1, 1, 1, 0);
v0.qdr.drift_init(0.8 + rand(1) * 0.5); v1.qdr.drift_init(0.8 + rand(1) * 0.5); v2.qdr.drift_init(0.8 + rand(1) * 0.5);
v3.qdr.drift_init(0.8 + rand(1) * 0.5); v4.qdr.drift_init(0.8 + rand(1) * 0.5); v5.qdr.drift_init(0.8 + rand(1) * 0.5);
v6.qdr.drift_init(0.8 + rand(1) * 0.5); v7.qdr.drift_init(0.8 + rand(1) * 0.5); an_hdr.drift_init(0.8 + rand(1) * 0.5);
an_hmc.mclu_set(1, 0); an_hbp.f_set(7500, 1.1);
an_hmc.p1 = 0;    an_hmc.p2 = 0.17; an_hmc.p3 = 0.41; an_hmc.p4 = 0.63; an_hmc.p5 = 0.29; an_hmc.p6 = 0.83;
v7.qmcl.p1 = 0.53; v7.qmcl.p2 = 0.91; v7.qmcl.p3 = 0.07; v7.qmcl.p4 = 0.36; v7.qmcl.p5 = 0.74; v7.qmcl.p6 = 0.22;
an_acb = 1; an_alv = 1; an_seq = 0; an_acc = 0; an_wrm = 1; an_hm = 0;
update();
vol_s = vol_t; cmix_s = cmix_t; last_s4 = slider4;
function kv(v, tn, dc, to, sn, lv, pn) local(b) (
  b = 14 + v * 6;
  slider(b) = tn; slider(b + 1) = dc; slider(b + 2) = to; slider(b + 3) = sn; slider(b + 4) = lv; slider(b + 5) = pn;
);
function load_preset(p) local(i) (
  p == 2 ? (
    slider1 = 0;
