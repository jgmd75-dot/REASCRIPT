function prs_hash() local(i, h) ( h = 0; i = 1; loop(63, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 9 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

function pat_act(a, g) (
  a == 1 ? save_slot(g) :
  a == 2 ? ( memcpy(CLB, PAT, 264); clip_ok = 1; ) :
  a == 3 ? ( clip_ok ? ( memcpy(PAT, CLB, 264); modified = 1; ); ) :
  a == 4 ? ( memset(PAT, 0, 256); modified = 1; ) :
  a == 5 ? random_pattern() :
  a == 6 ? ( factory(PAT, g); modified = 1; );
);

pwr_init(); pwr_hum_db = -77; pwr_sag = 0.12; pwr_wu_loss = 0.3; pwr_wu_drv = 0.5; pwr_wu_lp = 13000; pwr_wu_wob = 0.1; pwr_bloom = 0;
run_d = 0; fr_on = 0; rbeat = 0; seq_play = 0;
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;
pact_dirty = 0; edit_dirty = 0;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; sel_lane = 0; );
ui_dflt = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();

@block
prs_chk();
srate != pu_sr ? ( pu_sr = srate; pu_srinit(); );
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
update();
pwr_block(1);
evn = 0;
while (midirecv(mofs, m1, m2, m3)) (
  (m1 & 0xF0) == 0x90 && m3 > 0 && (chan == 0 || (m1 & 0x0F) + 1 == chan) && evn < 512 && NMAP[m2] >= 0 ? (
    EVQ[evn * 2] = mofs; EVQ[evn * 2 + 1] = NMAP[m2] + 8 * m3; evn += 1;
  );
  midisend(mofs, m1, m2, m3);
);
evi = 0; spos = 0;
pact_dirty > 0 ? ( pb_a = pact_dirty; pact_dirty = 0; pat_act(pb_a, pa_arg_d); );
edit_dirty ? ( edit_dirty = 0; modified = 1; );
slider4 != last_s4 ? ( last_s4 = slider4; seq_play ? qslot_dirty = slider4 - 1 : load_slot(slider4 - 1); );
bps = tempo / 60 / srate;
run_on = run_d > 0;
flw = fol_on && (play_state & 1);
seq_play = flw || run_on;
flw ? ( bp0 = beat_position; fr_on = 0; ) : run_on ? (
  !fr_on ? ( fr_on = 1; rbeat = 0; lastg = -1; );
  bp0 = rbeat; rbeat += samplesblock * bps;
) : fr_on = 0;
!seq_play ? (
  lastg = -1; pb_i = 0; loop(8, CUR[pb_i] = -1; pb_i += 1; );
  qslot_dirty >= 0 ? ( load_slot(qslot_dirty); qslot_dirty = -1; );
);
aud_dirty > 0 ? ( v_trig(aud_dirty - 1, 0.9); aud_dirty = 0; );
dm_a > 0 ? (
  an_wrm *= exp(-samplesblock / (90 * srate)); pb_i = samplesblock * 0.05 * dm_s / srate;
  v0.qdr.drift_tick(pb_i); v1.qdr.drift_tick(pb_i); v2.qdr.drift_tick(pb_i); v3.qdr.drift_tick(pb_i);
  v4.qdr.drift_tick(pb_i); v5.qdr.drift_tick(pb_i); v6.qdr.drift_tick(pb_i); v7.qdr.drift_tick(pb_i); an_hdr.drift_tick(pb_i);
);
slot_dirty > 0 ? ( load_slot(slot_dirty - 1); slot_dirty = 0; slider_automate(slider4); );
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pat_init);
file_var(0, cur_slot);
file_var(0, modified);
file_mem(0, PAT, 272);
file_mem(0, SLOTS, 8 * SLN);
file_var(0, pr_cur);
file_var(0, sel_lane);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@sample
while (evi < evn && (EVQ[evi * 2] <= spos || spos >= samplesblock - 1)) (
  e2 = EVQ[evi * 2 + 1]; v_trig(e2 % 8, floor(e2 / 8) / 127); ins_midi_hit();
  evi += 1;
);
seq_play ? (
  sbeat = bp0 + spos * bps;
  sbeat >= 0 ? (
    s16 = sbeat * 4; sg = floor(s16); sfr = s16 - sg;
    (sg & 1) && sfr < swing * 0.5 ? sg -= 1;
    sg != lastg ? (
      lastg = sg;
      (sg % 16) == 0 && qslot_dirty >= 0 ? ( load_slot(qslot_dirty); qslot_dirty = -1; );
      sv = 0; an_n = 0;
      loop(NV, PAT[sv * 32 + sg % max(LEN[sv], 1)] == 2 && !MUTE[sv] ? an_n += 1; sv += 1; );
      an_alv = an_acb * (1 - 0.03 * max(an_n - 1, 0)); an_seq = 1;
      sv = 0;
      loop(NV,
        sst = sg % max(LEN[sv], 1); CUR[sv] = sst; sval = PAT[sv * 32 + sst];
        sval > 0 && !MUTE[sv] ? (
          v_trig(sv, sval == 2 ? 1 : 0.78);
          midi_out ? (
            NOFF[sv] > 0 ? midisend(spos, 0x80 | out_ch, out_note(sv), 0);
            midisend(spos, 0x90 | out_ch, out_note(sv), sval == 2 ? 127 : 100);
            NOFF[sv] = floor(0.03 * srate);
          );
        );
        sv += 1;
      );
      an_seq = 0; an_acb = max(an_acb - 0.04 * an_n, 0.6);
    );
  );
);
midi_out ? (
  sv = 0; loop(NV, NOFF[sv] > 0 ? ( NOFF[sv] -= 1; NOFF[sv] == 0 ? midisend(spos, 0x80 | out_ch, out_note(sv), 0); ); sv += 1; );
);
spos += 1;
an_acb < 1 ? an_acb += (1 - an_acb) * an_acr;
v3.qa || v4.qa ? an_hm = an_hbp.f_run(an_hmc.mclu_run());
yv0 = v0.vrun(); outL = yv0 * v0.gl; outR = yv0 * v0.gr;
yv1 = v1.vrun(); outL += yv1 * v1.gl; outR += yv1 * v1.gr;
yv2 = v2.vrun(); outL += yv2 * v2.gl; outR += yv2 * v2.gr;
yv3 = v3.vrun(); outL += yv3 * v3.gl; outR += yv3 * v3.gr;
yv4 = v4.vrun(); outL += yv4 * v4.gl; outR += yv4 * v4.gr;
yv5 = v5.vrun(); outL += yv5 * v5.gl; outR += yv5 * v5.gr;
yv6 = v6.vrun(); outL += yv6 * v6.gl; outR += yv6 * v6.gr;
yv7 = v7.vrun(); outL += yv7 * v7.gl; outR += yv7 * v7.gr;
pwr_in(outL, outR); outL = pwr_l; outR = pwr_r;
clv = 20 * log10(max(max(abs(outL), abs(outR)), 0.000001)); cov = clv - cthr;
cgr = cov < -3 ? 0 : cov > 3 ? (1 / crat - 1) * cov : (1 / crat - 1) * (cov + 3) * (cov + 3) / 12;
cenv += (cgr - cenv) * (cgr < cenv ? catc : crlc); cgr_d = min(cgr_d, cenv);
cmix_s += (cmix_t - cmix_s) * sm;
cg = 10 ^ (cenv / 20) * cmk;
outL += (outL * cg - outL) * cmix_s; outR += (outR * cg - outR) * cmix_s;
pwr_out(outL, outR); outL = pwr_l; outR = pwr_r;
vol_s += (vol_t - vol_s) * sm;
abs(sat_t - sat_s) > 0.000001 ? ( sat_s += (sat_t - sat_s) * sm; ost_amt = sat_s; ost_drv = 1 + 12 * sat_s * sqrt(sat_s); ost_wet = min(sat_s * 3, 1); );
outL = ostL.ost_band(outL * 0.5) * vol_s;
outR = ostR.ost_band(outR * 0.5) * vol_s;
ins_stereo(outL, outR); ost_out(ins_sl, ins_sr);
spl0 = ost_l;
spl1 = ost_r;
mn_ms += 0.5 * (spl0 * spl0 + spl1 * spl1); mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 355
function v4rd_c(c) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = 1; );
function v4rd_mx(c, t, f) ( (floor(((c >> 16) & 255) * (1 - f) + ((t >> 16) & 255) * f) << 16) + (floor(((c >> 8) & 255) * (1 - f) + ((t >> 8) & 255) * f) << 8) + floor((c & 255) * (1 - f) + (t & 255) * f); );
function v4rd(gx0, gy0, k, rad, c1, c2, c3) local(q, i, yd, gx, hw, j, n, xl, xr, il, ir, rr) (
  q = k * rad / 17;
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 17 * q, 1, 1);
  v4rd_c(0xE8EBEE); gfx_circle(gx0, gy0, 15 * q, 1, 1);
  v4rd_c(0x1A1A1C); gfx_circle(gx0, gy0, 13 * q, 1, 1);
  i = 0;
  loop(3,
    v4rd_c(i == 0 ? c1 : i == 1 ? c2 : c3);
    yd = -12.2 + i * 2.6;
    gx = gx0 + 0.5; hw = sqrt(max(sqr(13.6) - sqr(yd + 0.8), 0)) * q;
    j = floor(gy0 + yd * q + 1); n = max(1, floor(1.6 * q));
    xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
    hw > 0 ? loop(n,
      il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
        gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
        gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
        gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
      );
      j += 1;
    );
    i += 1;
  );
  v4rd_c(0xE8EBEE);
  rr = 13 * q + 0.75; while (rr <= 15 * q - 0.75) ( gfx_circle(gx0, gy0, rr, 0, 1); rr += 0.5; );
  gfx_a = 1;
);
function dk_c(c, a) ( gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = a; );
function dk_key(cx, cy, idx, von, ink, dfs) local(x, y, s, on, hov, lx, ly, tw, th) (
  s = 20; x = dk_ox + (cx - 17) * sc; y = dk_oy + (cy - 10) * sc; lx = x + (s + 11) * sc; ly = y + s * 0.5 * sc;
  on = slider(idx) >= (von + 5) * 0.5;
  hov = mouse_x >= x - 3 * sc && mouse_x < lx + 8 * sc && mouse_y >= y - 3 * sc && mouse_y < y + (s + 3) * sc;
  (mouse_cap & 1) && !dk_prev && hov ? ( slider(idx) = on ? 5 : von; slider_automate(2 ^ (idx - 1)); on = !on; );
  dk_prev = mouse_cap & 1;
  dk_c(0x000000, 0.13); gfx_rect(x + 2 * sc, y + 3 * sc, s * sc, s * sc); gfx_rect(x + 3 * sc, y + 4.5 * sc, s * sc, s * sc);
  dk_c(0x0E0E10, 1); gfx_rect(x - 1 * sc, y - 1 * sc, (s + 2) * sc, (s + 2) * sc);
  dk_c(on ? 0x8A8C90 : (hov ? 0xAEB0B4 : 0x9C9EA2), 1); gfx_rect(x + 1 * sc, y + (on ? 2 : 1) * sc, (s - 2) * sc, (s - (on ? 3 : 2)) * sc);
  on ? ( dk_c(0x000000, 0.35); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1.5 * sc); )
     : ( dk_c(0xFFFFFF, 0.30); gfx_rect(x + 1 * sc, y + 1 * sc, (s - 2) * sc, 1 * sc); dk_c(0x000000, 0.28); gfx_rect(x + 1 * sc, y + (s - 3) * sc, (s - 2) * sc, 2 * sc); );
  on ? ( dk_c(0xFF3A2A, 0.22); gfx_circle(lx, ly, 8.5 * sc, 1, 1); );
  dk_c(0x050506, 1); gfx_circle(lx, ly, 6 * sc, 1, 1);
  dk_c(on ? 0xFF3A2A : 0x5A1410, 1); gfx_circle(lx, ly, 4.4 * sc, 1, 1);
  on ? ( dk_c(0xFFFFFF, 0.55); gfx_circle(lx - 1.4 * sc, ly - 1.4 * sc, 1.4 * sc, 1, 1); );
  gfx_setfont(dfs); dk_c(ink, 1); gfx_measurestr("DRIFT", tw, th);
  gfx_x = dk_ox + cx * sc - tw * 0.5; gfx_y = y + (s + 7) * sc; gfx_drawstr("DRIFT");
);
ui_begin(900, 355);
mk_face = 0x2C2D31; mk_plate = 0x1D1E22; mk_band = 0x141518; mk_acc = 0xE0603A; mk_ink = 0xE8E6E0; mk_ink2 = 0xB4B2AC;
mk_val = 0xFFC27E; mk_scale = 0xD8D6D0; mk_fig = 0x9C9A94;
mk_sub = ui_mix(mk_face, 0x000000, 0.55); mk_sub2 = ui_mix(mk_face, 0x000000, 0.62);
mk_ft = ui_mix(mk_face, 0xFFFFFF, 0.22); mk_fb = ui_mix(mk_face, 0x000000, 0.22);
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 16 * sc);
  mg_f11 = ui_fitarial(11, 11 * sc);
  mg_f12 = ui_fitarial(12, 18 * sc);
  mg_f13 = ui_fitarial(13, 14 * sc);
  mg_f14 = ui_fitarial(14, 27 * sc);
  mg_f6 = ui_fitarial(6, 12 * sc);
  mg_f3 = ui_fitarial(3, 14 * sc);
  mg_f16 = ui_fitarial(16, 18 * sc);
);
gfx_setfont(10, "Arial", mg_f10, 'b'); gfx_setfont(11, "Arial", mg_f11, 'b'); gfx_setfont(12, "Arial", mg_f12, 'b');
gfx_setfont(13, "Arial", mg_f13, 'b'); gfx_setfont(14, "Arial", mg_f14, 'b'); gfx_setfont(6, "Arial", mg_f6, 'b');
gfx_setfont(3, "Arial", mg_f3, 'b');
gfx_setfont(16, "Arial", mg_f16, 'b');
function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function mg_stripe(cx, cy, r, y, h) local(gx, hw, j, n, xl, xr, il, ir) (
  gx = cx * sc + 0.5; hw = sqrt(max(sqr(r) - sqr(y + h * 0.5 - cy), 0)) * sc;
  j = floor(y * sc + 1); n = max(1, floor(h * sc));
  xl = gx - hw; xr = gx + hw; il = floor(xl); ir = floor(xr);
  hw > 0 ? loop(n,
    il == ir ? ( gfx_a = xr - xl; gfx_rect(il, j, 1, 1); ) : (
      gfx_a = il + 1 - xl; gfx_rect(il, j, 1, 1);
      gfx_a = 1; ir > il + 1 ? gfx_rect(il + 1, j, ir - il - 1, 1);
      gfx_a = xr - ir; xr > ir ? gfx_rect(ir, j, 1, 1);
    );
    j += 1;
  );
  gfx_a = 1;
);
function mg_ring(cx, cy, r0, r1) local(rr) (
  rr = r0 * sc + 0.75; while (rr <= r1 * sc - 0.75) ( gfx_circle(cx * sc, cy * sc, rr, 0, 1); rr += 0.5; );
);
function mg_rr(x, y, w, h, r) ( ui_rrect(x * sc, y * sc, w * sc, h * sc, r * sc); );
function mg_lum(c) ( (0.299 * ((c >> 16) & 255) + 0.587 * ((c >> 8) & 255) + 0.114 * (c & 255)) / 255; );
function mg_cshadow(x, y, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_disc(x + 2 + j * 1.3, y + 3 + j * 1.6, r + j * 0.6); j += 1; ); );
function mg_rshadow(x, y, w, h, r) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_rr(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6, r); j += 1; ); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.35); mg_disc(x + 1, y + 1.5, 4); ui_col(0x8A9198); mg_disc(x, y, 4); ui_col(0xB8BEC4); mg_disc(x - 0.8, y - 0.8, 2.4); );
function mg_plate(x, y, w, h, title) (
  mg_rshadow(x, y, w, h, 0);
  ui_col(ui_mix(mk_face, 0x000000, 0.45)); mg_r(x, y, w, h);
