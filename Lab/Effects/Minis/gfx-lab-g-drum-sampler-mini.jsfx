ui_begin(900, 355);
mk_face = 0x2D3A40; mk_band = 0x1E272C; mk_ink = 0xEFE8D8; mk_tab = 0xF2C230; mk_acc = 0xFFD27A;
mk_sub = 0x34444B; mk_ink2 = 0xC8CCC4; sm_cap = 0xE8E2D2;
sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitarial(10, 14 * sc);
