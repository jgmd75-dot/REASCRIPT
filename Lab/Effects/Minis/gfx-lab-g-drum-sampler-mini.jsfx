function us_is(u, i) ( USR[u * 5] * 16777216 + USR[u * 5 + 1] == L_H1[i] && USR[u * 5 + 2] * 16777216 + USR[u * 5 + 3] == L_H2[i]; );
function us_apply() local(i, u) (
