  b_sel < 0 && strlen(#srch) ? ( strcpy(#srch, ""); view_build(); k = 0; loop(VN, VIEW[k] == i ? b_sel = k; k += 1; ); );
  b_sel < 0 ? ( bcat = 20; view_build(); k = 0; loop(VN, VIEW[k] == i ? b_sel = k; k += 1; ); );
