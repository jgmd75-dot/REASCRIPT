function pv_in() local(j, v) ( j = 1; loop(61, v = slider(j); v != PVL[j] ? ( PVM[PVM[900 + j]] = v; PVL[j] = v; ); j += 1; ); );
function pv_out() local(j, v) ( j = 1; loop(61, v = PVM[PVM[900 + j]]; v != PVL[j] ? ( slider(j) = v; PVL[j] = v; slider_automate(2 ^ (j - 1)); ); j += 1; ); );
