desc:Star Mini [Arcana synth] (GFX Lab)
//tags: instrument synth virtual analogue 90s vst arpeggiator three arps lcr delay echo chorus phaser tremolo autopan arcana mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-instrument, gfx-lab-voice, gfx-lab-power, gfx-lab-warmup, gfx-lab-sliders (.jsfx-inc) in the same folder.

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-instrument.jsfx-inc
import gfx-lab-voice.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-warmup.jsfx-inc
import gfx-lab-sliders.jsfx-inc

slider63:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<0,3,1{Saw,Square,Triangle,Sine}>-Osc 1 wave
slider2:0<-2,1,1>-Osc 1 octave
slider3:0<0,3,1{Saw,Square,Triangle,Sine}>-Osc 2 wave
slider4:0<-12,12,1>-Osc 2 semitones
