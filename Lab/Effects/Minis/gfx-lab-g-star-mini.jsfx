function sr_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
function sr_nums_au(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? ( !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1; ) :
    c == 45 ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 1; ) :
    ( inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; ); );
    i += 1;
  );
  n;
);
SDEF = 37000;
function load_preset_au(k) local(n, i) (
  i = 1; loop(128, i != 29 && i != 30 && (i < 31 || i > 38) ? PVM[i] = SDEF[i]; i += 1; );
  n = sr_nums_au(pre_str_au(k), SDEF + 200); i = 0;
  loop(floor(n / 2), SDEF[200 + i * 2] >= 1 && SDEF[200 + i * 2] <= 128 ? PVM[SDEF[200 + i * 2]] = SDEF[200 + i * 2 + 1]; i += 1; );
  i = 1; loop(128, pv_nop(i); i += 1; );
  pr_cur = k;
);
#sr_def = "0 0 0 0 9 50 50 2400 30 45 30 50 3 420 25 400 2 500 70 450 50 4.5 0 0 15 0 0 0 0 0 35 -4 60 0 30 120 6000 -0.3 50 20 100 1 0 1 2 60 0 0 20 20000 0 0 0 7 35 25 0 0 0 0.6 0 0 3 0 0 1 0 100 -3 0 0 3 1 60 0 0 20 20000 0 0 0 8 25 12 0 0 30 0.4 0 0 3 0 1 2 0 100 -8 1 1 3 1 45 12 2 20 20000 0 0 0 6 35 25 0 0 0 0.6 0 0 3 0 0 1 0 100 -3 0 0 0";
sr_nums(#sr_def, SDEF + 1);
!sr_defok ? ( sr_defok = 1; pr_cur = 1; );
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; ); ui_dflt = 1;

function arp_beats(r) ( r == 0 ? 1 : r == 1 ? 0.5 : r == 2 ? 1 / 3 : r == 3 ? 0.25 : r == 4 ? 1 / 6 : r == 5 ? 0.125 : r == 6 ? 2 / 3 : 0.75; );
function dly_beats(r) ( r == 0 ? 0.125 : r == 1 ? 1 / 6 : r == 2 ? 0.25 : r == 3 ? 1 / 3 : r == 4 ? 0.375 : r == 5 ? 0.5 :
                        r == 6 ? 2 / 3 : r == 7 ? 0.75 : r == 8 ? 1 : r == 9 ? 4 / 3 : r == 10 ? 1.5 : 2; );
function trem_beats(r) ( r == 0 ? 2 : r == 1 ? 1 : r == 2 ? 0.5 : r == 3 ? 0.25 : r == 4 ? 2 / 3 : r == 5 ? 1 / 3 : 0.75; );
function auto_beats(r) ( r == 0 ? 2 : r == 1 ? 4 : r == 2 ? 8 : r == 3 ? 16 : r == 4 ? 32 : 1; );

function held_add(n, v) local(i, j) (
  i = 0; j = -1; loop(nh, SHN[i] == n ? j = i; i += 1; );
  j < 0 && nh < 64 ? (
    i = nh; while (i > 0 && SHN[i - 1] > n) ( SHN[i] = SHN[i - 1]; SHV[i] = SHV[i - 1]; i -= 1; );
    SHN[i] = n; SHV[i] = v; nh += 1;
    SHO[nord] = n; nord += 1;
  );
  j >= 0 ? SHV[j] = v;
);
function held_del(n) local(i, j) (
  i = 0; j = -1; loop(nh, SHN[i] == n ? j = i; i += 1; );
  j >= 0 ? ( i = j; loop(nh - j - 1, SHN[i] = SHN[i + 1]; SHV[i] = SHV[i + 1]; i += 1; ); nh -= 1; );
  i = 0; j = -1; loop(nord, SHO[i] == n ? j = i; i += 1; );
  j >= 0 ? ( i = j; loop(nord - j - 1, SHO[i] = SHO[i + 1]; i += 1; ); nord -= 1; );
);

nq = 0;
function q_add(ofs, ch, typ, n, v) local(i) (
  nq < 400 ? (
    i = nq; while (i > 0 && SQO[i - 1] > ofs) ( SQO[i] = SQO[i - 1]; SQC[i] = SQC[i - 1]; SQT[i] = SQT[i - 1]; SQN[i] = SQN[i - 1]; SQV[i] = SQV[i - 1]; i -= 1; );
    SQO[i] = ofs; SQC[i] = ch; SQT[i] = typ; SQN[i] = n; SQV[i] = v; nq += 1;
  );
);

function v_ptr(c, i) ( SVB + (c * NVC + i) * VSZ; );
function v_start(p, n, vel) (
  p[17] += p[0] ? p[18] : 0;
  !p[0] || p[13] < 0.001 ? nw_start(p + 30);
  p[0] = 1; p[1] = n; p[2] = 1; p[4] = vel / 127; vage += 1; p[3] = vage;
  p[11] = 0; p[12] = 1; p[13] = p[13] * 0.3; p[14] = 1; p[25] = 0;
  p[19] = (rand(2) - 1) * 9 * PVM[31] * 0.01;
);
function ch_note_on(c, n, vel) local(i, p, b, ba, cs) (
  n = min(max(n, 0), 127);
  cs = SCS + c * CSZ;
  b = -1; i = 0; loop(NVC, p = v_ptr(c, i); p[0] && p[1] == n && b < 0 ? b = i; i += 1; );
  b < 0 ? ( i = 0; loop(NVC, p = v_ptr(c, i); !p[0] && b < 0 ? b = i; i += 1; ); );
  b < 0 ? ( ba = 1000000000; i = 0; loop(NVC, p = v_ptr(c, i); !p[2] && p[3] < ba ? ( b = i; ba = p[3]; ); i += 1; ); );
  b < 0 ? ( ba = 1000000000; i = 0; loop(NVC, p = v_ptr(c, i); p[3] < ba ? ( b = i; ba = p[3]; ); i += 1; ); );
  p = v_ptr(c, b);
  p[6] = n; p[5] = PVM[27] > 0 && cs[0] >= 0 ? cs[0] : n;
  cs[0] = n; cs[3] = time_precise();
  v_start(p, n, vel);
);
function ch_note_off(c, n) local(i, p) (
  i = 0; loop(NVC, p = v_ptr(c, i); p[0] && p[1] == n && p[2] ? ( p[2] = 0; p[12] = 4; p[14] = 4; ); i += 1; );
);
function ch_all_off(c) local(i, p) ( i = 0; loop(NVC, p = v_ptr(c, i); p[0] ? ( p[2] = 0; p[12] = 4; p[14] = 4; ); i += 1; ); );

function arp_note(c, k, md, oc) local(an_n, p, q) (
  an_n = nh * oc;
  md == 5 ? ( q = k % (nord * oc); SHO[q % nord] + 12 * floor(q / nord); ) : (
    p = md == 0 ? k % an_n :
        md == 1 ? an_n - 1 - k % an_n :
        md == 2 || md == 3 ? ( an_n < 2 ? 0 : ( q = k % (2 * an_n - 2); q = q < an_n ? q : 2 * an_n - 2 - q; md == 3 ? an_n - 1 - q : q; ); ) :
        floor(rand(an_n));
    SHN[p % nh] + 12 * floor(p / nh);
  );
);
function pend_add(c, t, n) local(k) (
  k = SPC[c]; k < 128 ? ( SPO[c * 128 + k] = t; SPN[c * 128 + k] = n; SPC[c] = k + 1; );
);

function svf(x, g, k, mode) instance(s1, s2) local(a1, a2, a3, v1, v2, v3) (
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - s2; v1 = a1 * s1 + a2 * v3; v2 = s2 + a2 * s1 + a3 * v3;
  s1 = 2 * v1 - s1; s2 = 2 * v2 - s2;
  mode == 1 ? v2 : x - k * v1 - v2;
);
function op(x, a) instance(z) ( z += (x - z) * a; z; );
function ap1(x, a) instance(z) local(y) ( y = a * x + z; z = x - a * y; y; );

function prs_hash() local(i, h) ( h = 0; i = 1; loop(61, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset_au(k);
    k <= 9 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(9, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset_au(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

MCHL = SCH + 6 * CHN + 1000; MCHR = MCHL + 4096;
function ec_col(m, x, a) local(h, v1, v2, v3, p, y, d) (
  m[0] += (x - m[0]) * ec_hk; h = x - m[0];
  v3 = h - m[2]; v1 = ec_a21 * m[1] + ec_a22 * v3; v2 = m[2] + ec_a22 * m[1] + ec_a23 * v3;
  m[1] = 2 * v1 - m[1]; m[2] = 2 * v2 - m[2];
  p = h - 0.7071 * v1 * a;
  m[3] += (p - m[3]) * ec_lk;
  y = x + (m[3] - x) * a; d = 1 + 5 * a;
  y + (vo_tanh(y * d) / d - y) * a;
);
function gap_clear() local(c) (
  memset(SVB, 0, NVX * VSZ); memset(SPC, 0, 3); memset(SDL, 0, 6 * DLN); memset(SCH, 0, 6 * CHN);
  c = 0; loop(NC, memset(SCS + c * CSZ + 42, 0, 21); c += 1; );
  memset(MCHL, 0, 8192); mc_lp = mc_rp = 0;
  nh = 0; nord = 0; memset(SKD, 0, 128); nkeys = 0; pedal = 0; nq = 0; qi = 0;
  ck_was = 0; ck_fb = 0;
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
pwr_init();  pwr_hum_db = -79;  pwr_sag = 0.15;  pwr_wu_loss = 0.3;  pwr_wu_drv = 0.4;  pwr_wu_lp = 11000;  pwr_wu_wob = 0.08;  pwr_bloom = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
pv_in();
prs_chk();
sr_volt = 10 ^ (PVM[32] / 20) * sqr(PVM[33] / 100) * 2.5;
ost_setup(PVM[34] / 100, PVM[35] / 100, PVM[36], PVM[37], PVM[38], 1);

pv_out();

@block
pv_in();
prs_chk();
g_now = time_precise();
g_tp > 0 && g_now - g_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > g_gpp && play_position - g_gpp < 4 * g_gpd + 0.05) ? gap_clear();
g_tp = g_now; g_gpp = play_position; g_gpd = samplesblock / srate;
pwr_block(1);
sr_volt = 10 ^ (PVM[32] / 20) * sqr(PVM[33] / 100) * 2.5;
nq = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, PVM[30]) ? (
    mst = m1 & 0xF0;
    mst == 0x90 && m3 > 0 ? (
      ins_midi_hit();
      nkeys == 0 && PVM[29] >= 0.5 && nh > 0 ? (
        i_ = 0; loop(nh, c = 0; loop(NC, PVM[42 + c * 28] < 0.5 ? q_add(mofs, c, 0, SHN[i_] + PVM[47 + c * 28], 0); c += 1; ); i_ += 1; );
        nh = 0; nord = 0;
      );
      nh == 0 && !(play_state & 1) ? (
        ck_fb = 0;
        c = 0; loop(NC, k_ = 0; loop(SPC[c], q_add(mofs, c, 0, SPN[c * 128 + k_], 0); k_ += 1; ); SPC[c] = 0; c += 1; );
      );
      held_add(m2, m3); SKD[m2] = 1; nkeys += 1;
      c = 0; loop(NC, PVM[42 + c * 28] < 0.5 ? q_add(mofs, c, 1, m2 + PVM[47 + c * 28], m3); c += 1; );
    ) :
    mst == 0x80 || (mst == 0x90 && m3 == 0) ? (
      SKD[m2] ? ( SKD[m2] = 0; nkeys = max(nkeys - 1, 0); );
      PVM[29] < 0.5 && !pedal ? (
        held_del(m2);
        c = 0; loop(NC, PVM[42 + c * 28] < 0.5 ? q_add(mofs, c, 0, m2 + PVM[47 + c * 28], 0); c += 1; );
      );
    ) :
    mst == 0xB0 ? (
      m2 == 1 ? sr_mw = m3 / 127 :
      m2 == 64 ? (
        pedal = m3 >= 64;
        !pedal && PVM[29] < 0.5 ? (
          i_ = nh - 1; loop(nh, !SKD[SHN[i_]] ? ( n_ = SHN[i_]; held_del(n_); c = 0; loop(NC, PVM[42 + c * 28] < 0.5 ? q_add(mofs, c, 0, n_ + PVM[47 + c * 28], 0); c += 1; ); ); i_ -= 1; );
        );
      ) :
      m2 == 120 || m2 == 123 ? ( nh = 0; nord = 0; memset(SKD, 0, 128); nkeys = 0; q_add(mofs, -1, 2, 0, 0); );
    );
  );
  midisend(mofs, m1, m2, m3);
);
PVM[29] < 0.5 && sr_latwas && !pedal ? (
  i_ = nh - 1; loop(nh, !SKD[SHN[i_]] ? ( n_ = SHN[i_]; held_del(n_); c = 0; loop(NC, q_add(0, c, 0, n_ + PVM[47 + c * 28], 0); c += 1; ); ); i_ -= 1; );
);
sr_latwas = PVM[29] >= 0.5;
panic_d ? ( panic_d = 0; nh = 0; nord = 0; memset(SKD, 0, 128); nkeys = 0; pedal = 0; q_add(0, -1, 2, 0, 0); );
gfx_pst = play_state == 1 || play_state == 5;

ck_play = play_state & 1;
ck_bps = tempo / 60 / srate;
ck_t0 = ck_play ? beat_position : ck_fb;
ck_t1 = ck_t0 + ck_bps * samplesblock;
ck_jump = ck_play && (!ck_was || abs(ck_t0 - ck_exp) > 0.05);
ck_fate = PVM[31] * 0.01;
c = 0;
loop(NC,
  b_ = 42 + c * 28; cs_ = SCS + c * CSZ;
  arp_on = PVM[b_] >= 0.5;
  (!arp_on && cs_[1]) || ck_jump ? (
    k_ = 0; loop(SPC[c], q_add(0, c, 0, SPN[c * 128 + k_], 0); k_ += 1; ); SPC[c] = 0;
  );
  arp_on && !cs_[1] ? ch_all_off(c);
  !arp_on && cs_[1] ? ( k_ = 0; loop(nh, q_add(0, c, 1, SHN[k_] + PVM[b_ + 5], SHV[k_]); k_ += 1; ); );
  cs_[1] = arp_on;
  arp_on && nh > 0 ? (
    L_ = arp_beats(floor(PVM[b_ + 2] + 0.5)); md_ = floor(PVM[b_ + 1] + 0.5); oc_ = floor(PVM[b_ + 3] + 0.5);
    k = floor(ck_t0 / L_);
    k * L_ < ck_t0 ? k += 1;
    while (k * L_ < ck_t1) (
      tv_ = k * L_;
      ofs_ = floor((tv_ - ck_t0) / ck_bps);
      ck_fate > 0 ? ofs_ = max(ofs_ + floor((rand(2) - 1) * ck_fate * 0.004 * srate), 0);
      ofs_ = min(max(ofs_, 0), samplesblock - 1);
      kk_ = k + floor(PVM[b_ + 6] + 0.5);
      md_ == 6 ? (
        i_ = 0; loop(nh, n_ = SHN[i_] + 12 * (kk_ % oc_) + PVM[b_ + 5];
          q_add(ofs_, c, 1, n_, SHV[i_]); pend_add(c, tv_ + L_ * PVM[b_ + 4] * 0.01, n_); i_ += 1; );
      ) : (
        n_ = arp_note(c, kk_, md_, oc_) + PVM[b_ + 5];
        q_add(ofs_, c, 1, n_, SHV[0]);
        pend_add(c, tv_ + L_ * PVM[b_ + 4] * 0.01, n_);
      );
      cs_[2] = kk_; cs_[3] = time_precise();
      k += 1;
    );
  );
  k_ = 0;
  while (k_ < SPC[c]) (
    SPO[c * 128 + k_] < ck_t1 ? (
      q_add(min(max(floor((SPO[c * 128 + k_] - ck_t0) / ck_bps), 0), samplesblock - 1), c, 0, SPN[c * 128 + k_], 0);
      SPC[c] -= 1; SPO[c * 128 + k_] = SPO[c * 128 + SPC[c]]; SPN[c * 128 + k_] = SPN[c * 128 + SPC[c]];
    ) : k_ += 1;
  );
  c += 1;
);
ck_was = ck_play; ck_exp = ck_t1;
!ck_play ? ck_fb = ck_t1;
ck_pos = ck_t0;

w1 = floor(PVM[1] + 0.5); w2 = floor(PVM[3] + 0.5);
mx2 = PVM[6] * 0.01; pw = PVM[7] * 0.01;
uni = PVM[26] * 0.01; uni_c = uni * 18; uni_n = 1 / (1 + uni * 0.6);
drv = (1 + PVM[25] * 0.06) * 0.7; drv_n = 1 / vo_tanh(drv);
fl_k = 1 - exp(-1 / (0.015 * srate));
raw = PVM[129] >= 0.5; npass = raw ? 1 : 2; osr = npass * srate;
glide_k = PVM[27] > 0 ? 1 - exp(-16 / (PVM[27] * 0.001 * srate)) : 1;
fa = 1 / max(1, PVM[13] * 0.001 * srate); fd = exp(-6.9 / (PVM[14] * 0.001 * srate)); fs_ = PVM[15] * 0.01; fr = exp(-6.9 / (PVM[16] * 0.001 * srate));
aa = 1 / max(1, PVM[17] * 0.001 * srate); ad = exp(-6.9 / (PVM[18] * 0.001 * srate)); as_ = PVM[19] * 0.01; ar = exp(-6.9 / (PVM[20] * 0.001 * srate));
synth_g = 10 ^ (PVM[28] / 20) * 0.58;
lfo_inc = PVM[22] / srate;
dm_ = PVM[31] * 0.01;

c = 0;
loop(NC,
  b_ = 42 + c * 28; cs_ = SCS + c * CSZ;
  cs_[10] = tan($pi * min(PVM[b_ + 7], srate * 0.45) / srate);
  cs_[11] = tan($pi * min(PVM[b_ + 8], srate * 0.45) / srate);
  dg_ = PVM[b_ + 9]; cs_[12] = 10 ^ (dg_ / 20); cs_[13] = dg_ > 0;
  cs_[14] = 10 ^ (PVM[b_ + 10] / 20) - 1; cs_[15] = 10 ^ (PVM[b_ + 11] / 20) - 1;
  cs_[37] = PVM[b_ + 7] > 20.5; cs_[38] = PVM[b_ + 8] < 19900; cs_[39] = abs(cs_[14]) > 0.001 || abs(cs_[15]) > 0.001;
  tdl_ = dly_beats(floor(PVM[b_ + 12] + 0.5)) * 60 / max(tempo, 20) * srate;
  cs_[16] = min(tdl_, DLN - 8); cs_[17] = min(tdl_ * 1.012 + 0.0004 * srate, DLN - 8);
  cs_[18] = PVM[b_ + 13] * 0.01; cs_[19] = PVM[b_ + 14] * 0.01;
  cs_[20] = PVM[b_ + 15] * 0.01;
  cs_[21] = PVM[b_ + 16] >= 0.5; cs_[22] = PVM[b_ + 17] * 0.01; cs_[23] = PVM[b_ + 18] / srate;
  cs_[24] = PVM[b_ + 19] * 0.01; cs_[25] = PVM[b_ + 20] >= 0.5; cs_[26] = 1 / (trem_beats(floor(PVM[b_ + 21] + 0.5)) * 60 / max(tempo, 20) * srate);
  cs_[27] = PVM[b_ + 22] * 0.01; cs_[28] = PVM[b_ + 23] >= 0.5; cs_[29] = 1 / (auto_beats(floor(PVM[b_ + 24] + 0.5)) * 60 / max(tempo, 20) * srate);
  cm_ = PVM[b_ + 25] * 0.01; cs_[30] = 10 ^ ((-6 - 24 * cm_) / 20); cs_[31] = 1 - 1 / (1 + 3 * cm_); cs_[32] = 10 ^ (cm_ * 9 / 20);
  cs_[33] = PVM[b_ + 26] * 0.01;
  sol_ = PVM[130] >= 0.5 || PVM[131] >= 0.5 || PVM[132] >= 0.5;
  cs_[34] = PVM[126 + c] >= 0.5 || (sol_ && PVM[130 + c] < 0.5) ? 0 : 10 ^ (PVM[b_ + 27] / 20) * (PVM[b_ + 27] <= -59.9 ? 0 : 1);
  pos_ = (c - 1) * PVM[41] * 0.01;
  cs_[35] = sqrt(0.5 * (1 - pos_)) * 1.4142; cs_[36] = sqrt(0.5 * (1 + pos_)) * 1.4142;
  ck_play ? ( cs_[40] = beat_position / trem_beats(floor(PVM[b_ + 21] + 0.5)); cs_[41] = beat_position / auto_beats(floor(PVM[b_ + 24] + 0.5)); );
  c += 1;
);
fd_k = 1 - exp(-1 / (0.005 * srate));
ec_hk = 1 - exp(-2 * $pi * 140 / srate); ec_lk = 1 - exp(-2 * $pi * 5000 / srate);
ec_g = tan($pi * 500 / srate); ec_a21 = 1 / (1 + ec_g * (ec_g + 1.4142)); ec_a22 = ec_g * ec_a21; ec_a23 = ec_g * ec_a22;
ec_k = 1 - exp(-1 / (0.03 * srate));
mc_t = PVM[41] * 0.0044;
cmp_a = 1 - exp(-1 / (0.008 * srate)); cmp_r = 1 - exp(-1 / (0.15 * srate));
mbl = PVM[39] * 0.01; mdr = PVM[40] * 0.01;
m_tg = 1 + 3 * mdr; m_tn = 1 / vo_tanh(m_tg) * (0.75 + 0.25 / m_tg);
m_tl = 1 - exp(-2 * $pi * (16000 - 8000 * mdr) / srate);
m_ig = 1 + 4 * mdr; m_is = 1 / sqrt(m_ig); m_lo = 1 - exp(-2 * $pi * 180 / srate);
qi = 0; spos = 0;

pv_out();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, PVM, 300);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
while (qi < nq && (SQO[qi] <= spos || spos >= samplesblock - 1)) (
  SQT[qi] == 1 ? ch_note_on(SQC[qi], SQN[qi], SQV[qi]) :
  SQT[qi] == 0 ? ch_note_off(SQC[qi], SQN[qi]) :
  ( c = 0; loop(NC, ch_all_off(c); c += 1; ); );
  qi += 1;
);
spos += 1;
!fl_ok ? ( fl_c1 = fl_c2 = log(PVM[8]); fl_rs = PVM[9]; fl_ev = PVM[10]; fl_ok = 1; );
fl_c1 += (log(PVM[8]) - fl_c1) * fl_k; fl_c2 += (fl_c1 - fl_c2) * fl_k; fl_rs += (PVM[9] - fl_rs) * fl_k; fl_ev += (PVM[10] - fl_ev) * fl_k;
res_q = 2 - 1.94 * fl_rs * 0.01;
lfo_ph += lfo_inc; lfo_ph -= floor(lfo_ph);
lfo_v = sin(2 * $pi * lfo_ph);
vib = lfo_v * (PVM[23] * 0.01 + sr_mw * 0.5) * 0.6;
lfo_ct = lfo_v * PVM[24] * 0.01 * 2;

c = 0;
loop(NC,
  cs_ = SCS + c * CSZ;
  x = 0;
  i = 0;
  loop(NVC,
    p = SVB + (c * NVC + i) * VSZ;
    p[0] ? (
      (p[25] -= 1) <= 0 ? (
        p[25] = 16;
        p[5] += (p[6] - p[5]) * glide_k;
        (p[27] == 0 || rand(1) < 16 / srate) ? p[27] = (rand(2) - 1) * 6 * dm_;
        p[26] += (p[27] - p[26]) * 0.002;
        pt = p[5] + PVM[2] * 12 + vib + (p[19] + p[26]) * 0.01;
        f1 = 440 * exp((pt - 69) * L12) / osr;
        f2 = 440 * exp((pt + PVM[4] + PVM[5] * 0.01 - 69) * L12) / osr;
        ud = exp(uni_c * 0.01 * L12);
        p[20] = min(f1, 0.45); p[21] = min(f2, 0.45); p[22] = min(f1 * ud, 0.45); p[23] = min(f2 / ud, 0.45);
        oct = fl_ev * 0.01 * 6 * p[11] * (1 - PVM[11] * 0.01 + PVM[11] * 0.01 * p[4]) + PVM[12] * 0.01 * (p[5] - 60) / 12 + lfo_ct;
        fc = min(max(exp(fl_c2 + oct * 0.693147), 20), 0.155 * osr);
        p[24] = 2 * sin($pi * fc / osr);
