desc:Skye [parametric EQ] (GFX Lab)
//tags: equaliser eq parametric broadcast analogue filter
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-power, gfx-lab-v5-parts, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider30:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:hp_f=30<10,1000,1>-HPF freq (Hz)
slider3:hp_s=0<0,2,1{x1 (12 dB/oct),x2 (24 dB/oct),x4 (48 dB/oct)}>-HPF slope
slider4:hp_on=0<0,1,1{Out,In}>-HPF in
slider5:lp_f=18000<1000,22000,1>-LPF freq (Hz)
slider6:lp_s=0<0,2,1{x1 (12 dB/oct),x2 (24 dB/oct),x4 (48 dB/oct)}>-LPF slope
slider7:lp_on=0<0,1,1{Out,In}>-LPF in
slider8:100<20,800,1>-Band 1 freq (Hz)
slider9:1<0.1,4,0.01>-Band 1 BW (oct)
slider10:0<-16,16,0.1>-Band 1 gain (dB)
slider11:1<0,1,1{Out,In}>-Band 1 in
slider12:500<80,3000,1>-Band 2 freq (Hz)
slider13:1<0.1,4,0.01>-Band 2 BW (oct)
slider14:0<-16,16,0.1>-Band 2 gain (dB)
slider15:1<0,1,1{Out,In}>-Band 2 in
slider16:2500<300,10000,1>-Band 3 freq (Hz)
slider17:1<0.1,4,0.01>-Band 3 BW (oct)
slider18:0<-16,16,0.1>-Band 3 gain (dB)
slider19:1<0,1,1{Out,In}>-Band 3 in
slider20:8000<1000,20000,1>-Band 4 freq (Hz)
slider21:1<0.1,4,0.01>-Band 4 BW (oct)
slider22:0<-16,16,0.1>-Band 4 gain (dB)
slider23:1<0,1,1{Out,In}>-Band 4 in
slider24:b1_sh=0<0,1,1{Bell,Shelf}>-Band 1 shape
slider25:b4_sh=0<0,1,1{Bell,Shelf}>-Band 4 shape
slider26:out_db=0<-12,12,0.1>-Output (dB)
slider27:eq_in=1<0,1,1{Out,In}>-EQ in
slider28:drift_pc=20<0,100,1>-Drift (%)
slider29:prs_sel=0<0,8,1{No preset,Flat,Vocal Presence,Kick and Bass,Air Lift,Telephone,Hum Notch 50 Hz,Mastering Smile,Broadcast Voice}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(1073741823, v); );
function psw_allg(v) ( slider_show(1073741823, v); );
#ui_man = "gfx-lab-skye";
ext_noinit = 1;
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function db2g(d) ( exp(d*0.11512925465); );
function bwq(bw) local(p) ( p = 2^max(bw, 0.05); sqrt(p)/(p - 1); );
function shq(bw) ( min(max(0.7071*2^((1 - bw)*0.5), 0.4), 1.2); );
function nsec(s) ( s < 0.5 ? 1 : s < 1.5 ? 2 : 4; );
ost_init(alloc(4096));

function sk_set(type, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, A, n, sa) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); A = 10 ^ (gdb / 40);
  type == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / A; b0 = (1 + al * A) / n; b1 = -2 * cw / n; b2 = (1 - al * A) / n; a1 = b1; a2 = (1 - al / A) / n; ) :
  type == 3 ? ( sa = 2 * sqrt(A) * al; n = (A + 1) - (A - 1) * cw + sa;
                b0 = A * ((A + 1) + (A - 1) * cw + sa) / n; b1 = -2 * A * ((A - 1) + (A + 1) * cw) / n;
                b2 = A * ((A + 1) + (A - 1) * cw - sa) / n; a1 = 2 * ((A - 1) - (A + 1) * cw) / n; a2 = ((A + 1) - (A - 1) * cw - sa) / n; ) :
  ( sa = 2 * sqrt(A) * al; n = (A + 1) + (A - 1) * cw + sa;
    b0 = A * ((A + 1) - (A - 1) * cw + sa) / n; b1 = 2 * A * ((A - 1) - (A + 1) * cw) / n;
    b2 = A * ((A + 1) - (A - 1) * cw - sa) / n; a1 = -2 * ((A - 1) + (A + 1) * cw) / n; a2 = ((A + 1) + (A - 1) * cw - sa) / n; );
);
function sk_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function sk_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function hpf_set(f) (
  skHn == 1 ? ( skHaL.sk_set(1, f, 0.70711, 0); skHaR.sk_set(1, f, 0.70711, 0); ) :
  skHn == 2 ? ( skHaL.sk_set(1, f, 0.54120, 0); skHaR.sk_set(1, f, 0.54120, 0);
                skHbL.sk_set(1, f, 1.30656, 0); skHbR.sk_set(1, f, 1.30656, 0); ) :
              ( skHaL.sk_set(1, f, 0.50980, 0); skHaR.sk_set(1, f, 0.50980, 0);
                skHbL.sk_set(1, f, 0.60134, 0); skHbR.sk_set(1, f, 0.60134, 0);
                skHcL.sk_set(1, f, 0.89998, 0); skHcR.sk_set(1, f, 0.89998, 0);
                skHdL.sk_set(1, f, 2.56292, 0); skHdR.sk_set(1, f, 2.56292, 0); );
);
function lpf_set(f) (
  skLn == 1 ? ( skLaL.sk_set(0, f, 0.70711, 0); skLaR.sk_set(0, f, 0.70711, 0); ) :
  skLn == 2 ? ( skLaL.sk_set(0, f, 0.54120, 0); skLaR.sk_set(0, f, 0.54120, 0);
                skLbL.sk_set(0, f, 1.30656, 0); skLbR.sk_set(0, f, 1.30656, 0); ) :
              ( skLaL.sk_set(0, f, 0.50980, 0); skLaR.sk_set(0, f, 0.50980, 0);
                skLbL.sk_set(0, f, 0.60134, 0); skLbR.sk_set(0, f, 0.60134, 0);
                skLcL.sk_set(0, f, 0.89998, 0); skLcR.sk_set(0, f, 0.89998, 0);
                skLdL.sk_set(0, f, 2.56292, 0); skLdR.sk_set(0, f, 2.56292, 0); );
);
function sk_hclr() ( skHaL.sk_clr(); skHaR.sk_clr(); skHbL.sk_clr(); skHbR.sk_clr(); skHcL.sk_clr(); skHcR.sk_clr(); skHdL.sk_clr(); skHdR.sk_clr(); );
function sk_lclr() ( skLaL.sk_clr(); skLaR.sk_clr(); skLbL.sk_clr(); skLbR.sk_clr(); skLcL.sk_clr(); skLcR.sk_clr(); skLdL.sk_clr(); skLdR.sk_clr(); );

SKT = alloc(16); SKS = alloc(16);
function sk_rate() (
  sk_sr = srate;
  sk_kd = 1 - exp(-1 / (0.012 * srate));
  sk_dkc = 1 / (0.005 * srate);
  sk_rsc = 1 / (0.015 * srate);
);
function sk_tgt() local(k, b) (
  k = 0; loop(4, b = 8 + k * 4;
    SKT[k * 3] = log(slider(b)); SKT[k * 3 + 1] = slider(b + 1); SKT[k * 3 + 2] = slider(b + 2);
    k += 1; );
  SKT[12] = log(hp_f); SKT[13] = log(lp_f);
  sk_mt1 = slider(11) > 0.5; sk_mt2 = slider(15) > 0.5; sk_mt3 = slider(19) > 0.5; sk_mt4 = slider(23) > 0.5;
  sk_mth = hp_on > 0.5; sk_mtl = lp_on > 0.5; sk_mte = eq_in > 0.5;
  sk_nh = nsec(hp_s); sk_nl = nsec(lp_s);
  sk_s1 = b1_sh > 0.5; sk_s4 = b4_sh > 0.5;
  outg_t = db2g(out_db);
);
function sk_glide(k) local(i) (
  i = 0; loop(14, SKS[i] += (SKT[i] - SKS[i]) * k; i += 1; );
);
function bands() local(v, fk, gk, q, t) (
  v = dV * drift_pc / 100;
  gk = 1 + 0.025*v; fk = 1 + 0.006*v;
  t = sk_c1 ? 4 : 2; q = t == 4 ? shq(SKS[1]) : bwq(SKS[1]);
  b1L.sk_set(t, exp(SKS[0])*fk, q, SKS[2]*gk); b1R.sk_set(t, exp(SKS[0])*fk, q, SKS[2]*gk);
  q = bwq(SKS[4]); b2L.sk_set(2, exp(SKS[3])*fk, q, SKS[5]*gk); b2R.sk_set(2, exp(SKS[3])*fk, q, SKS[5]*gk);
  q = bwq(SKS[7]); b3L.sk_set(2, exp(SKS[6])*fk, q, SKS[8]*gk); b3R.sk_set(2, exp(SKS[6])*fk, q, SKS[8]*gk);
  t = sk_c4 ? 3 : 2; q = t == 3 ? shq(SKS[10]) : bwq(SKS[10]);
  b4L.sk_set(t, exp(SKS[9])*fk, q, SKS[11]*gk); b4R.sk_set(t, exp(SKS[9])*fk, q, SKS[11]*gk);
  hpf_set(exp(SKS[12])*fk);
  lpf_set(exp(SKS[13])*fk);
  hr = db2g(20 - 2.5*v);
  ihr = 1/hr;
);
function sk_snap() local(i) (
  sk_tgt();
  i = 0; loop(14, SKS[i] = SKT[i]; i += 1; );
  sk_m1 = sk_mt1; sk_m2 = sk_mt2; sk_m3 = sk_mt3; sk_m4 = sk_mt4; sk_mh = sk_mth; sk_ml = sk_mtl; sk_me = sk_mte;
  skHn = sk_nh; skLn = sk_nl; sk_c1 = sk_s1; sk_c4 = sk_s4; sk_dh = sk_dl = sk_d1 = sk_d4 = 1;
  outg = outg_t;
  bands();
);
function sk_reset() (
  sk_hclr(); sk_lclr();
  b1L.sk_clr(); b1R.sk_clr(); b2L.sk_clr(); b2R.sk_clr(); b3L.sk_clr(); b3R.sk_clr(); b4L.sk_clr(); b4R.sk_clr();
  memset(BY_BUF, 0, 2 * BY_N);
  sk_rs = 0;
);
dV = 0; dT = 0; dW = 0;
sk_rate();
sk_snap();
sk_rs = 1;
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.15; pwr_wu_loss = 0.4; pwr_wu_drv = 0.8; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;
pdc_delay = 0;
by_setup(1);

function pb(k, f, b, g) ( slider(8 + k*4) = f; slider(9 + k*4) = b; slider(10 + k*4) = g; slider(11 + k*4) = 1; );
function load_preset(p) local(n, i) (
  n = p - 1;
  hp_on = 0; lp_on = 0; b1_sh = 0; b4_sh = 0;
  n == 0 ? ( pb(0, 100, 1, 0);    pb(1, 500, 1, 0);    pb(2, 2500, 1, 0);   pb(3, 8000, 1, 0);    out_db = 0; eq_in = 1; drift_pc = 20; ) :
  n == 1 ? ( pb(0, 120, 1.5, -2); pb(1, 350, 1.2, -2); pb(2, 3200, 1.2, 3); pb(3, 10000, 1.5, 2); out_db = 0; ) :
  n == 2 ? ( pb(0, 60, 1, 4);     pb(1, 300, 1, -4);   pb(2, 2800, 1.5, 3); pb(3, 8000, 1, 0);    out_db = -1; ) :
  n == 3 ? ( pb(0, 100, 1, 0);    pb(1, 500, 1, 0);    pb(2, 5000, 2, 1);   pb(3, 14000, 2, 4);   out_db = -1; ) :
  n == 4 ? ( pb(0, 200, 2, -16);  pb(1, 1200, 1, 6);   pb(2, 2400, 1, 4);   pb(3, 6000, 2, -16);  out_db = -2; ) :
  n == 5 ? ( pb(0, 50, 0.1, -16); pb(1, 100, 0.1, -12); pb(2, 2500, 1, 0);  pb(3, 8000, 1, 0);    out_db = 0; ) :
  n == 6 ? ( pb(0, 50, 2, 2);     pb(1, 400, 2, -1);   pb(2, 3000, 2, -0.5); pb(3, 12000, 2, 2);  out_db = -1; ) :
           ( pb(0, 90, 1, -3);    pb(1, 250, 1.5, 1.5); pb(2, 2500, 1, 2.5); pb(3, 7000, 1, -1.5); out_db = 0; );
  eq_in = 1;
  i = 2; loop(27, ui_auto(i); i += 1; );
);

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
ui_thm = 5; ui_hw = 1;
#sk_pm = "Flat|Vocal Presence|Kick and Bass|Air Lift|Telephone|Hum Notch 50 Hz|Mastering Smile|Broadcast Voice";

function prs_hash() local(i, h) ( h = 0; i = 1; loop(29, i != 29 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 8 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(8, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
sk_tgt();
ost_setup(0, 0, 120, 6000, -0.3, 0);
pdc_delay = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && sk_blk < 40 ? sk_snp = 1;
pwr_ser();

@block
prs_chk();
sk_blk < 40 ? sk_blk += 1;
srate != sk_sr ? ( sk_rate(); sk_snap(); sk_reset(); );
sk_now = time_precise();
sk_tp > 0 && sk_now - sk_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > sk_gpp && play_position - sk_gpp < 4 * sk_gpd + 0.05) ? sk_reset();
sk_tp = sk_now; sk_gpp = play_position; sk_gpd = samplesblock / srate;
pwr_block(byp < 0.5);
sk_tgt();
sk_snp ? ( sk_snp = 0; sk_snap(); );
ost_setup(0, 0, 120, 6000, -0.3, 0);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
dW -= samplesblock; dW <= 0 ? ( dW = srate*(0.7 + rand(1) * 2.3); dT = rand(2) - 1; );
dV += (dT - dV)*min(1, samplesblock/(1.2*srate));
sk_glide(1 - exp(-samplesblock / (0.03 * srate)));
bands();
sk_pl_d = max(sk_pl_d, sk_pl); sk_pr_d = max(sk_pr_d, sk_pr); sk_pl = sk_pr = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
sk_d0 = spl0; sk_d1 = spl1;
sk_m1 += (sk_mt1 - sk_m1) * sk_kd; sk_m2 += (sk_mt2 - sk_m2) * sk_kd; sk_m3 += (sk_mt3 - sk_m3) * sk_kd; sk_m4 += (sk_mt4 - sk_m4) * sk_kd;
sk_mh += (sk_mth - sk_mh) * sk_kd; sk_ml += (sk_mtl - sk_ml) * sk_kd; sk_me += (sk_mte - sk_me) * sk_kd;
outg += (outg_t - outg) * sk_kd;
sk_nh != skHn ? ( sk_dh = max(sk_dh - sk_dkc, 0); sk_dh == 0 ? ( skHn = sk_nh; sk_hclr(); hpf_set(exp(SKS[12])); ); ) : sk_dh < 1 ? sk_dh = min(sk_dh + sk_dkc, 1);
sk_nl != skLn ? ( sk_dl = max(sk_dl - sk_dkc, 0); sk_dl == 0 ? ( skLn = sk_nl; sk_lclr(); lpf_set(exp(SKS[13])); ); ) : sk_dl < 1 ? sk_dl = min(sk_dl + sk_dkc, 1);
sk_s1 != sk_c1 ? ( sk_d1 = max(sk_d1 - sk_dkc, 0); sk_d1 == 0 ? ( sk_c1 = sk_s1; b1L.sk_clr(); b1R.sk_clr(); bands(); ); ) : sk_d1 < 1 ? sk_d1 = min(sk_d1 + sk_dkc, 1);
sk_s4 != sk_c4 ? ( sk_d4 = max(sk_d4 - sk_dkc, 0); sk_d4 == 0 ? ( sk_c4 = sk_s4; b4L.sk_clr(); b4R.sk_clr(); bands(); ); ) : sk_d4 < 1 ? sk_d4 = min(sk_d4 + sk_dkc, 1);
xL = spl0; xR = spl1;
pwr_in(xL, xR); xL = pwr_l; xR = pwr_r;
sk_me > 0.00001 ? (
  yL = xL; yR = xR;
  sk_k = sk_mh * sk_dh; sk_k > 0.00001 ? (
    tL = skHaL.sk_run(yL); tR = skHaR.sk_run(yR);
    skHn > 1 ? ( tL = skHbL.sk_run(tL); tR = skHbR.sk_run(tR); );
    skHn > 2 ? ( tL = skHcL.sk_run(tL); tR = skHcR.sk_run(tR); tL = skHdL.sk_run(tL); tR = skHdR.sk_run(tR); );
    yL += (tL - yL) * sk_k; yR += (tR - yR) * sk_k;
  ) : sk_hclr();
  sk_k = sk_m1 * sk_d1; sk_k > 0.00001 ? ( tL = b1L.sk_run(yL); tR = b1R.sk_run(yR); yL += (tL - yL) * sk_k; yR += (tR - yR) * sk_k; ) : ( b1L.sk_clr(); b1R.sk_clr(); );
  sk_k = sk_m2;        sk_k > 0.00001 ? ( tL = b2L.sk_run(yL); tR = b2R.sk_run(yR); yL += (tL - yL) * sk_k; yR += (tR - yR) * sk_k; ) : ( b2L.sk_clr(); b2R.sk_clr(); );
  sk_k = sk_m3;        sk_k > 0.00001 ? ( tL = b3L.sk_run(yL); tR = b3R.sk_run(yR); yL += (tL - yL) * sk_k; yR += (tR - yR) * sk_k; ) : ( b3L.sk_clr(); b3R.sk_clr(); );
  sk_k = sk_m4 * sk_d4; sk_k > 0.00001 ? ( tL = b4L.sk_run(yL); tR = b4R.sk_run(yR); yL += (tL - yL) * sk_k; yR += (tR - yR) * sk_k; ) : ( b4L.sk_clr(); b4R.sk_clr(); );
  sk_k = sk_ml * sk_dl; sk_k > 0.00001 ? (
    tL = skLaL.sk_run(yL); tR = skLaR.sk_run(yR);
    skLn > 1 ? ( tL = skLbL.sk_run(tL); tR = skLbR.sk_run(tR); );
    skLn > 2 ? ( tL = skLcL.sk_run(tL); tR = skLcR.sk_run(tR); tL = skLdL.sk_run(tL); tR = skLdR.sk_run(tR); );
    yL += (tL - yL) * sk_k; yR += (tR - yR) * sk_k;
  ) : sk_lclr();
  yL = hr*yL*ihr/(1 + abs(yL*ihr)^4)^0.25; yR = hr*yR*ihr/(1 + abs(yR*ihr)^4)^0.25;
  xL += (yL - xL) * sk_me; xR += (yR - xR) * sk_me;
) : ( sk_hclr(); sk_lclr(); b1L.sk_clr(); b1R.sk_clr(); b2L.sk_clr(); b2R.sk_clr(); b3L.sk_clr(); b3R.sk_clr(); b4L.sk_clr(); b4R.sk_clr(); );
pwr_out(xL, xR); xL = pwr_l; xR = pwr_r;
ost_out(xL*outg, xR*outg);
spl0 = ost_l; spl1 = ost_r;
sk_rs < 1 ? (
  sk_rs = min(sk_rs + sk_rsc, 1); sk_rq = sk_rs * sk_rs * (3 - 2 * sk_rs);
  spl0 = sk_d0 + (spl0 - sk_d0) * sk_rq; spl1 = sk_d1 + (spl1 - sk_d1) * sk_rq;
);
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_out();
sk_pl = max(sk_pl, abs(spl0)); sk_pr = max(sk_pr, abs(spl1));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
BP = 0xE3D8D8; BW = 0xD6CACA; BI = 0x2A2424; BI2 = 0x5E5454; BHD = 0x1E2023; BSC = 0x0E1418; BTR = 0x7FD8E8;
BB = 0x2A2620; BA = 0xFFC060; BTB = ui_mix(BW, 0xFFFFFF, 0.55); BTI = BI;
SC1 = 0x8B5A2B; SC2 = 0x3D70CC; SC3 = 0x33A052; SC4 = 0xD02E28; SCH = 0xE0B830; SCL = 0x2A2C2E;
e5_lfs = 15;
sc != e5_fsc ? (
  e5_fsc = sc;
