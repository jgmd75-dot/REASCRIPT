    b += 1; );
  loop(12,
    b = 0; loop(NB, gb_set(GCS, b, FQ[b], GQE[b], GGE[b]); b += 1; );
    b = 0; loop(NB, r = 0; j = 0; loop(NB, r += gb_dbc(j, b); j += 1; ); GGR[b] = r; b += 1; );
    b = 0; loop(NB, GGE[b] = min(max(GGE[b] + (GTG[b] - GGR[b]) * 0.3, -24), 24); b += 1; );
  );
