CG = 3000; RSP = 3200;
function gb_set(base, b, f, q, gdb) local(w0, cw, sw, al, A, n, c) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); A = 10 ^ (gdb / 40);
  n = 1 + al / A; c = base + b * 5;
  c[0] = (1 + al * A) / n; c[1] = -2 * cw / n; c[2] = (1 - al * A) / n; c[3] = c[1]; c[4] = (1 - al / A) / n;
);
GTG = 3400; GGE = 3450; GQE = 3500; GGR = 3550; GCS = 3600; GK1 = 3800; GK2 = 3850;
function gb_dbc(b, k) local(c, c1, c2, nu, de) (
  c = GCS + b * 5; c1 = GK1[k]; c2 = GK2[k];
  nu = c[0] * c[0] + c[1] * c[1] + c[2] * c[2] + 2 * (c[0] * c[1] + c[1] * c[2]) * c1 + 2 * c[0] * c[2] * c2;
  de = 1 + c[3] * c[3] + c[4] * c[4] + 2 * (c[3] + c[3] * c[4]) * c1 + 2 * c[4] * c2;
  10 * log10(max(nu, 0.000000000001) / max(de, 0.000000000001));
);
function gb_solve() local(b, j, r, w, gr, gc) (
  gr = gq_rng >= 0.5 ? 1 : 0.5; gc = gq_cq >= 0.5;
  b = 0; loop(NB,
    w = 2 * $pi * FQ[b] / srate; GK1[b] = cos(w); GK2[b] = cos(2 * w);
    GTG[b] = slider(b + 1) * gr; GGE[b] = GTG[b];
