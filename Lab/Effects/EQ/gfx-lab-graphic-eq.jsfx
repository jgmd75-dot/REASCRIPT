desc:Graphic EQ [31-band EQ] (GFX Lab)
//tags: equaliser eq graphic 31-band third-octave analyser
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-power, gfx-lab-v5-parts, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider46:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-12,12,0.1>-20 Hz
slider2:0<-12,12,0.1>-25 Hz
slider3:0<-12,12,0.1>-31.5 Hz
slider4:0<-12,12,0.1>-40 Hz
slider5:0<-12,12,0.1>-50 Hz
slider6:0<-12,12,0.1>-63 Hz
slider7:0<-12,12,0.1>-80 Hz
slider8:0<-12,12,0.1>-100 Hz
slider9:0<-12,12,0.1>-125 Hz
slider10:0<-12,12,0.1>-160 Hz
slider11:0<-12,12,0.1>-200 Hz
slider12:0<-12,12,0.1>-250 Hz
slider13:0<-12,12,0.1>-315 Hz
slider14:0<-12,12,0.1>-400 Hz
slider15:0<-12,12,0.1>-500 Hz
slider16:0<-12,12,0.1>-630 Hz
slider17:0<-12,12,0.1>-800 Hz
slider18:0<-12,12,0.1>-1 kHz
slider19:0<-12,12,0.1>-1.25 kHz
slider20:0<-12,12,0.1>-1.6 kHz
slider21:0<-12,12,0.1>-2 kHz
slider22:0<-12,12,0.1>-2.5 kHz
slider23:0<-12,12,0.1>-3.15 kHz
slider24:0<-12,12,0.1>-4 kHz
slider25:0<-12,12,0.1>-5 kHz
slider26:0<-12,12,0.1>-6.3 kHz
slider27:0<-12,12,0.1>-8 kHz
slider28:0<-12,12,0.1>-10 kHz
slider29:0<-12,12,0.1>-12.5 kHz
slider30:0<-12,12,0.1>-16 kHz
slider31:0<-12,12,0.1>-20 kHz
slider32:gq_rng=1<0,1,1{6 dB,12 dB}>-Range
slider33:gq_cq=0<0,1,1{Proportional,Constant}>-Q
slider34:lc_f=20<20,250,1>-Low cut (Hz, 20 = off)
slider35:hc_f=22000<3000,22000,10>-High cut (Hz, 22000 = off)
slider36:out_db=0<-12,12,0.1>-Output (dB)
slider37:eq_in=1<0,1,1{Out,In}>-EQ in
slider38:in_tr=0<-24,12,0.1>-Input trim (dB)
slider39:in_gd=1<0,1,1{Off,On}>-Input guard
slider40:sat_pc=0<0,100,1>-Sat (%)
slider41:sat_bi=30<0,100,1>-Sat bias (%)
slider42:sat_lo=120<40,400,1>-Sat low band (Hz)
slider43:sat_hi=6000<2000,16000,10>-Sat high band (Hz)
slider44:byp=0<0,1,1{Off,On}>-Bypass
slider45:prs_sel=0<0,10,1{No preset,Smile,Vocal Presence,De-mud,Air,Telephone,Bass Boost,Hi-Fi Loudness,Mid Scoop,Warm and Smooth,Live Feedback Notches}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(70368744177663, v); );
function psw_allg(v) ( slider_show(70368744177663, v); );
#ui_man = "gfx-lab-graphic-eq";
ext_noinit = 1;

NB = 31;
FQ = 1000; GC1 = 1040; GC2 = 1080; CO = 1100; STL = 1300; STR = 1500; ACT = 1700; TG = 1800; GE = 1850; GRS = 1900;
QE = 1950; GA = 2000; QA = 2050; CS = 2100;
SP_N = 4096; SP_RING = 40000; SP_FFT = 50000; SP_WIN = 60000; SP_B = 70000;
memset(1000, 0, 1300);
gq_i = 0; loop(NB, FQ[gq_i] = 20 * 2 ^ (gq_i / 3); gq_i += 1; );
gq_i = 0; loop(SP_N, SP_WIN[gq_i] = 0.5 - 0.5 * cos(2 * $pi * gq_i / (SP_N - 1)); gq_i += 1; );
memset(SP_B, -100, NB);
sp_w = 0;

function band_set(base, b, f, q, gdb) local(w0, cw, sw, al, A, n, c) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); A = 10 ^ (gdb / 40);
  n = 1 + al / A; c = base + b * 5;
  c[0] = (1 + al * A) / n; c[1] = -2 * cw / n; c[2] = (1 - al * A) / n; c[3] = c[1]; c[4] = (1 - al / A) / n;
);
function band_dbc(b, k) local(c, c1, c2, nu, de) (
  c = CS + b * 5; c1 = GC1[k]; c2 = GC2[k];
  nu = c[0] * c[0] + c[1] * c[1] + c[2] * c[2] + 2 * (c[0] * c[1] + c[1] * c[2]) * c1 + 2 * c[0] * c[2] * c2;
  de = 1 + c[3] * c[3] + c[4] * c[4] + 2 * (c[3] + c[3] * c[4]) * c1 + 2 * c[4] * c2;
  10 * log10(max(nu, 0.000000000001) / max(de, 0.000000000001));
);
function bands(x, st) local(i, b, c, s, y) (
  i = 0;
  loop(nact,
    b = ACT[i]; c = CO + b * 5; s = st + b * 4;
    y = c[0] * x + c[1] * s[0] + c[2] * s[1] - c[3] * s[2] - c[4] * s[3];
    s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y; x = y;
    i += 1;
  );
  x;
);
function solve() local(b, j, it, r, q) (
  b = 0; loop(NB,
    TG[b] = slider(b + 1) * rng; GE[b] = TG[b];
    QE[b] = cq ? 4.32 : 1.1 + min(abs(TG[b]), 12) / 12 * 3.2;
    b += 1; );
  it = 0;
  loop(12,
    b = 0; loop(NB, band_set(CS, b, FQ[b], QE[b], GE[b]); b += 1; );
    b = 0; loop(NB, r = 0; j = 0; loop(NB, r += band_dbc(j, b); j += 1; ); GRS[b] = r; b += 1; );
    b = 0; loop(NB, GE[b] = min(max(GE[b] + (TG[b] - GRS[b]) * 0.3, -24), 24); b += 1; );
    it += 1;
  );
);
function gq_act() local(b) (
  nact = 0; b = 0;
  loop(NB, abs(GA[b]) > 0.02 ? ( ACT[nact] = b; nact += 1; ) : ( memset(STL + b * 4, 0, 4); memset(STR + b * 4, 0, 4); ); b += 1; );
);
function gq_glide(k) local(b, mv, dg, dq) (
  mv = 0; b = 0;
  loop(NB,
    dg = GE[b] - GA[b]; dq = log(QE[b] / QA[b]);
    abs(dg) > 0.0005 || abs(dq) > 0.0005 ? (
      GA[b] += dg * k; QA[b] *= exp(dq * k); mv = 1;
      band_set(CO, b, FQ[b], QA[b], GA[b]);
    ) : ( dg != 0 || dq != 0 ? ( GA[b] = GE[b]; QA[b] = QE[b]; band_set(CO, b, FQ[b], QA[b], GA[b]); ); );
    b += 1; );
  gq_act();
  mv;
);
function gq_bq(type, f, q) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q); n = 1 + al;
  type ? ( b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; ) : ( b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; );
  b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function gq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function gq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function gq_hp1(x) instance(x1, y1) ( y1 = hp1_a * (x - x1) + hp1_b * y1; x1 = x; y1; );
function gq_hc1() instance(x1, y1) ( x1 = y1 = 0; );
function gq_flt() local(f, k) (
  f = exp(lc_lf);
  LC2L.gq_bq(1, f, 1); LC2R.gq_bq(1, f, 1);
  k = tan($pi * min(f, srate * 0.45) / srate); hp1_a = 1 / (1 + k); hp1_b = (1 - k) / (1 + k);
  f = exp(hc_lf);
  HCL.gq_bq(0, f, 0.70711); HCR.gq_bq(0, f, 0.70711);
);
function gq_snap() local(b) (
  b = 0; loop(NB, GA[b] = GE[b]; QA[b] = QE[b]; band_set(CO, b, FQ[b], QA[b], GA[b]); b += 1; );
  gq_act(); gq_mv = 0;
  lc_lf = log(lc_f); hc_lf = log(min(hc_f, srate * 0.45));
  lc_m = lc_on; hc_m = hc_on; eq_m = eq_in >= 0.5; og = og_t;
  gq_flt();
);
function update() local(b, hs) (
  rng = gq_rng >= 0.5 ? 1 : 0.5; cq = gq_cq >= 0.5;
  hs = 0; b = 1; loop(33, hs += slider(b) * (b * 7.31 + 1); b += 1; );
  hs != last_cs ? ( last_cs = hs; solve(); gq_mv = 1; );
  lc_on = lc_f > 20.5; hc_on = hc_f < 21990;
  og_t = 10 ^ (out_db / 20);
  in_setup(in_tr, in_gd);
  ost_setup(sat_pc / 100, sat_bi / 100, sat_lo, sat_hi, -0.3, 0);
);
function gq_rate() local(b, w) (
  gq_sr = srate;
  b = 0; loop(NB, w = 2 * $pi * FQ[b] / srate; GC1[b] = cos(w); GC2[b] = cos(2 * w); b += 1; );
  gq_kd = 1 - exp(-1 / (0.012 * srate));
  gq_kg = 1 - exp(-32 / (0.03 * srate));
  gq_rsc = 1 / (0.015 * srate);
  last_cs = -1;
);
function gq_reset() (
  memset(STL, 0, NB * 4); memset(STR, 0, NB * 4);
  LC2L.gq_clr(); LC2R.gq_clr(); LCL.gq_hc1(); LCR.gq_hc1(); HCL.gq_clr(); HCR.gq_clr();
  ostL.ost_ch_init(); ostR.ost_ch_init();
  memset(BY_BUF, 0, 2 * BY_N);
  gq_rs = 0;
);

ost_init(30000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
gq_rate();
update();
gq_snap();
gq_rs = 1;
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.12; pwr_wu_loss = 0.3; pwr_wu_drv = 0.6; pwr_wu_lp = 14000; pwr_wu_wob = 0.1; pwr_bloom = 0;
pdc_delay = 0;
by_setup(44);

function shlo(b, f, g) ( g / (1 + (FQ[b] / f) ^ 2) );
function shhi(b, f, g) ( g / (1 + (f / FQ[b]) ^ 2) );
function bell(b, f, w, g) ( g * exp(-sqr(log(FQ[b] / f) / log(2) / w)) );
function load_preset(p) local(b, g) (
  b = 0;
  loop(NB,
    g = p == 1 ? shlo(b, 90, 5) + shhi(b, 9000, 4) + bell(b, 500, 1.2, -1.5) :
        p == 2 ? bell(b, 3500, 0.9, 4) + bell(b, 250, 0.8, -2) + shhi(b, 12000, 2) :
        p == 3 ? bell(b, 300, 0.8, -5) + bell(b, 150, 0.6, -1) :
        p == 4 ? shhi(b, 10000, 6) :
        p == 5 ? (FQ[b] < 300 || FQ[b] > 3500 ? -12 : bell(b, 1300, 1, 4)) :
        p == 6 ? shlo(b, 80, 7) + bell(b, 250, 0.6, -1.5) :
        p == 7 ? shlo(b, 60, 8) + shhi(b, 12000, 5) :
        p == 8 ? bell(b, 800, 1.6, -4) :
        p == 9 ? shlo(b, 120, 2) + bell(b, 2800, 1, -2.5) + shhi(b, 14000, -2) :
        p == 10 ? bell(b, 2500, 0.5, -3) + bell(b, 4000, 0.4, -3) + bell(b, 250, 0.4, -2) :
        0;
    slider(b + 1) = min(max(floor(g * 10 + 0.5) / 10, -12), 12);
    b += 1;
  );
  gq_rng = 1; gq_cq = p == 10 ? 1 : 0; lc_f = p == 5 ? 220 : 20; hc_f = 22000; out_db = 0; eq_in = 1;
  p == 11 ? ( in_tr = 0; in_gd = 1; sat_pc = 0; sat_bi = 30; sat_lo = 120; sat_hi = 6000; );
  b = 1; loop(43, ui_auto(b); b += 1; );
);

!ui_dflt ? ( ui_sz = 0; pr_cur = 0; );
ui_dflt = 1;
ui_thm = 5; ui_hw = 1;
#gq_pm = "Smile|Vocal Presence|De-mud|Air|Telephone|Bass Boost|Hi-Fi Loudness|Mid Scoop|Warm and Smooth|Live Feedback Notches|Reset all to defaults";

function prs_hash() local(i, h) ( h = 0; i = 1; loop(44, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 10 ? 0 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k > 0 ? k : -1;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();
pdc_delay = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && gq_blk < 40 ? gq_snp = 1;
pwr_ser();

@block
prs_chk();
gq_blk < 40 ? gq_blk += 1;
srate != gq_sr ? ( gq_rate(); update(); gq_snap(); gq_reset(); );
gq_now = time_precise();
gq_tp > 0 && gq_now - gq_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > gq_gpp && play_position - gq_gpp < 4 * gq_gpd + 0.05) ? gq_reset();
gq_tp = gq_now; gq_gpp = play_position; gq_gpd = samplesblock / srate;
pwr_block(byp < 0.5);
update();
gq_snp ? ( gq_snp = 0; update(); gq_snap(); );
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
gq_pl_d = max(gq_pl_d, gq_pl); gq_pr_d = max(gq_pr_d, gq_pr); gq_pl = gq_pr = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
gq_d0 = spl0; gq_d1 = spl1;
(gq_cn += 1) >= 32 ? (
  gq_cn = 0;
  gq_mv ? gq_mv = gq_glide(gq_kg);
  gq_lt = log(lc_on ? lc_f : 20); gq_ht = log(min(hc_on ? hc_f : 22000, srate * 0.45));
  abs(gq_lt - lc_lf) > 0.0001 || abs(gq_ht - hc_lf) > 0.0001 ? (
    lc_lf += (gq_lt - lc_lf) * gq_kg; hc_lf += (gq_ht - hc_lf) * gq_kg; gq_flt(); );
);
lc_m += ((lc_on && eq_in >= 0.5) - lc_m) * gq_kd;
hc_m += ((hc_on && eq_in >= 0.5) - hc_m) * gq_kd;
eq_m += ((eq_in >= 0.5) - eq_m) * gq_kd;
og += (og_t - og) * gq_kd;
in_process(spl0, spl1);
pwr_in(in_l, in_r); xl = pwr_l; xr = pwr_r;
eq_m > 0.00001 ? (
  yl = xl; yr = xr;
  lc_m > 0.00001 ? ( tl = LCL.gq_hp1(LC2L.gq_run(yl)); tr = LCR.gq_hp1(LC2R.gq_run(yr)); yl += (tl - yl) * lc_m; yr += (tr - yr) * lc_m; )
    : ( LC2L.gq_clr(); LC2R.gq_clr(); LCL.gq_hc1(); LCR.gq_hc1(); );
  nact > 0 ? ( yl = bands(yl, STL); yr = bands(yr, STR); );
  hc_m > 0.00001 ? ( tl = HCL.gq_run(yl); tr = HCR.gq_run(yr); yl += (tl - yl) * hc_m; yr += (tr - yr) * hc_m; )
    : ( HCL.gq_clr(); HCR.gq_clr(); );
  xl += (yl - xl) * eq_m; xr += (yr - xr) * eq_m;
) : ( memset(STL, 0, NB * 4); memset(STR, 0, NB * 4); LC2L.gq_clr(); LC2R.gq_clr(); LCL.gq_hc1(); LCR.gq_hc1(); HCL.gq_clr(); HCR.gq_clr(); );
pwr_out(xl, xr); xl = pwr_l; xr = pwr_r;
oL = ostL.ost_band(xl * og * in_comp); oR = ostR.ost_band(xr * og * in_comp);
ost_out(oL, oR);
spl0 = ost_l; spl1 = ost_r;
gq_rs < 1 ? (
  gq_rs = min(gq_rs + gq_rsc, 1); gq_rq = gq_rs * gq_rs * (3 - 2 * gq_rs);
  spl0 = gq_d0 + (spl0 - gq_d0) * gq_rq; spl1 = gq_d1 + (spl1 - gq_d1) * gq_rq;
);
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_out();
SP_RING[sp_w] = (spl0 + spl1) * 0.5; sp_w = (sp_w + 1) & (SP_N - 1);
gq_pl = max(gq_pl, abs(spl0)); gq_pr = max(gq_pr, abs(spl1));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
BP = 0x24262A; BW = 0x2D3034; BI = 0xD9D6CC; BI2 = 0x8E8A80; BHD = 0x161719; BSC = 0x0A0B0C;
BB = 0x101113; BA = 0xFFC060; BTB = 0xD9D6CC; BTI = 0x1A1B1E;
ORNG = 0xFF8A2A; YLW = 0xF6D25A; SCH = 0xE0B830; SCL = 0x1A1A1C;
e5_lfs = 15;
sc != e5_fsc ? (
  e5_fsc = sc;
  e5_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  e5_f6 = ui_fitfont(6, 28 * sc);
);
function e5_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * e5_kt * sc, 'b'); );
function e5_fc(px) ( gfx_setfont(12, "Courier New", px * e5_kt * sc, 'b'); );
function e5_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function e5_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function e5_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function e5_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function e5_pocket(x, y, w, h, f) local(i) (
  ui_col(f); v5_r(x, y, w, h);
  i = 0; loop(5, ui_cola(0, 0.26 - i * 0.05); v5_r(x, y + i, w, 1); v5_r(x + i, y + 1 + i, 1, h - 1 - i); i += 1; );
  ui_cola(0xFFFFFF, 0.45); v5_r(x, y + h, w + 1.5, 1.5); v5_r(x + w, y, 1.5, h);
);
function e5_tab(x, y, w, n, s, col) (
  ui_col(ui_mix(BW, 0, 0.30)); v5_r(x + 1, y + 1, w, 23);
  ui_col(BTB); v5_r(x, y, w, 22);
  ui_col(col); v5_r(x, y + 22, w, 3);
  strlen(n) ? ( ui_col(0x2B2620); v5_rr(x + 5, y + 4, 16, 14, 2);
  e5_ft(12); ui_col(0xF2EAD2); v5_t(x + 13, y + 11.5, n); );
  e5_ft(15); ui_col(BTI); e5_tl(x + (strlen(n) ? 28 : 8), y + 11.5, s);
);
