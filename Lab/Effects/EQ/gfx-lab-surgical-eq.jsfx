!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
ui_thm = 5; ui_hw = 1;
#es_pm = "Init|Vocal De-Mud|Dynamic De-Ess|Harsh Tamer|Kick Clean-up|Bass Control|Hum Notch 50 Hz|Hum Notch 60 Hz|Air Lift|M/S Master Clarity|Rumble Cut|Telephone";

function prs_hash() local(i, h) ( h = 0; i = 1; loop(63, i != 63 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? ( prs_pk = prs_dirty; prs_dirty = 0; prs_q = 1; ) : prs_ok ? (
    prs_sel = max(0, min(12, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( prs_pk = prs_sel; prs_q = 0; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
  prs_pk > 0 ? (
    prs_g <= 0 ? (
      k = prs_pk; prs_pk = 0; load_preset(k); update();
      prs_q ? ( k <= 12 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; ); prs_last = prs_sel; ) : prs_cur_d = k;
      prs_h0 = prs_hash();
      prs_gs = 1 / (0.030 * srate);
    ) : prs_gs = -1 / (0.005 * srate);
  );
);
prs_ok = 0; prs_dirty = 0; prs_pk = 0; prs_g = 1; prs_gs = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
update();
pdc_delay = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_var(0, es_an);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && es_blk < 40 ? es_snp = 1;
pwr_ser();

@block
prs_chk();
es_blk < 40 ? es_blk += 1;
srate != es_sr ? ( es_rate(); es_snp = 1; es_reset(); );
es_now = time_precise();
es_tp > 0 && es_now - es_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > es_gpp && play_position - es_gpp < 4 * es_gpd + 0.05) ? es_reset();
es_tp = es_now; es_gpp = play_position; es_gpd = samplesblock / srate;
pwr_block(byp < 0.5);
update();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
bs = es_snp ? 1 : 1 - exp(-samplesblock / (0.03 * srate));
b1.bd_setup(1); b2.bd_setup(9); b3.bd_setup(17); b4.bd_setup(25); b5.bd_setup(33); b6.bd_setup(41);
hp_lf += (log(max(hp_f, 10)) - hp_lf) * bs; lp_lf += (log(max(lp_f, 10)) - lp_lf) * bs;
es_snp ? ( hp_n = hp_nt; lp_n = lp_nt; hp_m = lp_m = 1; out_s = out_t; es_snp = 0; );
hpc.fc_set(1, exp(hp_lf), hp_n); lpc.fc_set(0, exp(lp_lf), lp_n);
es_gr1_d = max(es_gr1_d, b1.grs); es_gr2_d = max(es_gr2_d, b2.grs); es_gr3_d = max(es_gr3_d, b3.grs);
es_gr4_d = max(es_gr4_d, b4.grs); es_gr5_d = max(es_gr5_d, b5.grs); es_gr6_d = max(es_gr6_d, b6.grs);
b1.grs = b2.grs = b3.grs = b4.grs = b5.grs = b6.grs = 0;
es_pl_d = max(es_pl_d, pkL); es_pr_d = max(es_pr_d, pkR); pkL = pkR = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
es_d0 = spl0; es_d1 = spl1;
hp_nt != hp_n ? ( hp_m = max(hp_m - bd_dk, 0); hp_m <= 0 ? ( hp_n = hp_nt; hpc.fc_clr(); hpc.fc_set(1, exp(hp_lf), hp_n); ); ) : hp_m < 1 ? hp_m = min(hp_m + bd_dk, 1);
lp_nt != lp_n ? ( lp_m = max(lp_m - bd_dk, 0); lp_m <= 0 ? ( lp_n = lp_nt; lpc.fc_clr(); lpc.fc_set(0, exp(lp_lf), lp_n); ); ) : lp_m < 1 ? lp_m = min(lp_m + bd_dk, 1);
es_solo != es_sc ? ( es_sg = max(es_sg - bd_dk, 0); es_sg <= 0 ? es_sc = es_solo; ) : es_sg < 1 ? es_sg = min(es_sg + bd_dk, 1);
in_process(spl0, spl1);
pwr_in(in_l, in_r); es_il = pwr_l; es_ir = pwr_r;
es_sc > 0 ? (
  es_sc == 1 ? b1.bd_solo(es_il, es_ir) : es_sc == 2 ? b2.bd_solo(es_il, es_ir) : es_sc == 3 ? b3.bd_solo(es_il, es_ir) :
  es_sc == 4 ? b4.bd_solo(es_il, es_ir) : es_sc == 5 ? b5.bd_solo(es_il, es_ir) : b6.bd_solo(es_il, es_ir);
) : (
  hp_n > 0 || hp_nt > 0 ? ( bl = hpc.fc_l(es_il); br = hpc.fc_r(es_ir); bl = es_il + (bl - es_il) * hp_m; br = es_ir + (br - es_ir) * hp_m; ) : ( bl = es_il; br = es_ir; );
  lp_n > 0 || lp_nt > 0 ? ( es_tl = bl; es_tr = br; bl = lpc.fc_l(bl); br = lpc.fc_r(br); bl = es_tl + (bl - es_tl) * lp_m; br = es_tr + (br - es_tr) * lp_m; );
  b1.bd_run(); b2.bd_run(); b3.bd_run(); b4.bd_run(); b5.bd_run(); b6.bd_run();
);
pwr_out(bl, br); bl = pwr_l; br = pwr_r;
out_s += (out_t - out_s) * sm;
oL = ostL.ost_band(bl * out_s); oR = ostR.ost_band(br * out_s);
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;
es_sg < 1 ? ( es_w = es_sg * es_sg * (3 - 2 * es_sg); spl0 *= es_w; spl1 *= es_w; );
prs_gs != 0 ? ( prs_g += prs_gs; prs_g <= 0 ? ( prs_g = 0; prs_gs = 0; ) : prs_g >= 1 ? ( prs_g = 1; prs_gs = 0; ); );
prs_g < 1 ? ( prs_w = prs_g * prs_g * (3 - 2 * prs_g); spl0 *= prs_w; spl1 *= prs_w; );
es_rs < 1 ? (
  es_rs = min(es_rs + es_rsc, 1); es_rq = es_rs * es_rs * (3 - 2 * es_rs);
  spl0 = es_d0 + (spl0 - es_d0) * es_rq; spl1 = es_d1 + (spl1 - es_d1) * es_rq;
);
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_out();
SP_RING[sp_w] = (spl0 + spl1) * 0.5; sp_w = (sp_w + 1) & (SP_N - 1);
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
BP = 0x2A2C30; BW = 0x34363B; BI = 0xE6E1D6; BI2 = 0x8A867E; BHD = 0x1A1B1E; BSC = 0x0C0D10;
BB = 0x14161A; BA = 0xFFC060; WHT = 0xEEEFEA; YEL = 0xF2C83E; BTB = 0xC9C4B8; BTI = 0x1A1B1E;
e5_lfs = 15;
sc != e5_fsc ? (
  e5_fsc = sc;
  e5_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  e5_f6 = ui_fitfont(6, 28 * sc);
);
function e5_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * e5_kt * sc, 'b'); );
function e5_fc(px) ( gfx_setfont(12, "Courier New", px * e5_kt * sc, 'b'); );
function e5_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function e5_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function e5_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function e5_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function e5_pocket(x, y, w, h, f) local(i) (
  ui_col(f); v5_r(x, y, w, h);
  i = 0; loop(5, ui_cola(0, 0.26 - i * 0.05); v5_r(x, y + i, w, 1); v5_r(x + i, y + 1 + i, 1, h - 1 - i); i += 1; );
  ui_cola(0xFFFFFF, 0.45); v5_r(x, y + h, w + 1.5, 1.5); v5_r(x + w, y, 1.5, h);
);
function e5_tab(x, y, w, n, s, col) (
