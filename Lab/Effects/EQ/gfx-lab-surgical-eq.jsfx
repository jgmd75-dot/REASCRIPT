slider54:sat_pc=0<0,100,1>-Band sat (%)
slider55:sat_bi=30<0,100,1>-Bias (%)
slider56:sat_lo=120<40,400,1>-Sat low band (Hz)
slider57:sat_hi=6000<2000,16000,10>-Sat high band (Hz)
slider58:hp_f=20<20,1000,1>-HPF (Hz, 20 = off)
slider59:lp_f=20000<1000,20000,10>-LPF (Hz, 20000 = off)
slider60:hp_s=1<0,3,1{x1 12 dB/oct,x2 24 dB/oct,x3 36 dB/oct,x4 48 dB/oct}>-HPF slope
slider61:lp_s=1<0,3,1{x1 12 dB/oct,x2 24 dB/oct,x3 36 dB/oct,x4 48 dB/oct}>-LPF slope
slider62:byp=0<0,1,1{Off,On}>-Bypass
slider63:prs_sel=0<0,12,1{No preset,Init,Vocal De-Mud,Dynamic De-Ess,Harsh Tamer,Kick Clean-up,Bass Control,Hum Notch 50 Hz,Hum Notch 60 Hz,Air Lift,M/S Master Clarity,Rumble Cut,Telephone}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) (
  slider_show(4503599627370495, v);
  slider_show(sat_pc, v); slider_show(sat_bi, v); slider_show(sat_lo, v); slider_show(sat_hi, v);
  slider_show(hp_f, v); slider_show(lp_f, v); slider_show(hp_s, v); slider_show(lp_s, v);
  slider_show(byp, v); slider_show(prs_sel, v); slider_show(psw_view, v); slider_show(in_gd, v);
);
function psw_allg(v) (
  slider_show(4503599627370495, v);
  slider_show(sat_pc, v); slider_show(sat_bi, v); slider_show(sat_lo, v); slider_show(sat_hi, v);
  slider_show(hp_f, v); slider_show(lp_f, v); slider_show(hp_s, v); slider_show(lp_s, v);
  slider_show(byp, v); slider_show(prs_sel, v); slider_show(psw_view, v); slider_show(in_gd, v);
);
#ui_man = "gfx-lab-surgical-eq";
ext_noinit = 1;

function bq_set(type, f, q, gdb) instance(b0, b1, b2, a1, a2) local(w0, cw, sw, al, amp, sa, n) (
  f = min(max(f, 10), srate * 0.45);
  w0 = 2 * $pi * f / srate; cw = cos(w0); sw = sin(w0); al = sw / (2 * q);
  amp = 10 ^ (gdb / 40);
  type == 0 ? (
    n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 1 ? (
    n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
  ) : type == 2 ? (
    n = 1 + al / amp; b0 = (1 + al * amp) / n; b1 = -2 * cw / n; b2 = (1 - al * amp) / n; a1 = b1; a2 = (1 - al / amp) / n;
  ) : type == 3 ? (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) - (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) + (amp - 1) * cw + sa) / n; b1 = -2 * amp * ((amp - 1) + (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) + (amp - 1) * cw - sa) / n; a1 = 2 * ((amp - 1) - (amp + 1) * cw) / n;
    a2 = ((amp + 1) - (amp - 1) * cw - sa) / n;
  ) : type == 4 ? (
    sa = 2 * sqrt(amp) * al;
    n = (amp + 1) + (amp - 1) * cw + sa;
    b0 = amp * ((amp + 1) - (amp - 1) * cw + sa) / n; b1 = 2 * amp * ((amp - 1) - (amp + 1) * cw) / n;
    b2 = amp * ((amp + 1) - (amp - 1) * cw - sa) / n; a1 = -2 * ((amp - 1) + (amp + 1) * cw) / n;
    a2 = ((amp + 1) + (amp - 1) * cw - sa) / n;
  ) : type == 5 ? (
    n = 1 + al; b0 = 1 / n; b1 = -2 * cw / n; b2 = b0; a1 = b1; a2 = (1 - al) / n;
  ) : (
    n = 1 + al; b0 = al / n; b1 = 0; b2 = -al / n; a1 = -2 * cw / n; a2 = (1 - al) / n;
  );
);
function bq_thru() instance(b0, b1, b2, a1, a2) ( b0 = 1; b1 = 0; b2 = 0; a1 = 0; a2 = 0; );
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function bq_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );
function ap_set(f, q, gdb) instance(c, d) local(t, v) (
  f = min(max(f, 10), srate * 0.45);
  t = tan($pi * min(f / q, srate * 0.45) / srate); v = 10 ^ (gdb / 20);
  c = gdb >= 0 ? (t - 1) / (t + 1) : (t - v) / (t + v);
  d = -cos(2 * $pi * f / srate);
);
function ap_run(x) instance(c, d, x1, x2, y1, y2) local(y) (
  y = -c * x + d * (1 - c) * x1 + x2 - d * (1 - c) * y1 + c * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);
function ap_clr() instance(x1, x2, y1, y2) ( x1 = x2 = y1 = y2 = 0; );

function bd_coef() instance(cty, f, q, gs, sta, fa, fb, ga, gb, pa, pb, so_a, so_b) (
  cty == 1 ? ( pa.ap_set(f, q, gs); pb.ap_set(f, q, gs); ) :
  cty == 2 ? ( fa.bq_set(4, f, max(q, 0.3), sta); fb.bq_set(4, f, max(q, 0.3), sta); ) :
  cty == 3 ? ( fa.bq_set(3, f, max(q, 0.3), sta); fb.bq_set(3, f, max(q, 0.3), sta); ) :
  cty == 4 ? ( fa.bq_set(5, f, q, 0); fb.bq_set(5, f, q, 0); ) :
  cty == 5 ? ( fa.bq_set(1, f, 0.5412, 0); fb.bq_set(1, f, 0.5412, 0); ga.bq_set(1, f, 1.3066, 0); gb.bq_set(1, f, 1.3066, 0); ) :
  cty == 6 ? ( fa.bq_set(0, f, 0.5412, 0); fb.bq_set(0, f, 0.5412, 0); ga.bq_set(0, f, 1.3066, 0); gb.bq_set(0, f, 1.3066, 0); );
  so_a.bq_set(6, f, cty >= 5 ? 0.7 : q, 0); so_b.bq_set(6, f, cty >= 5 ? 0.7 : q, 0);
);
function bd_setup(i0) instance(i, ty, f, g, q, tg, dyn, thr, rng, gs, sta, lf, lq, cty, ctg, wm) (
  lf += (log(max(slider(i0 + 1), 10)) - lf) * bs; lq += (log(max(slider(i0 + 3), 0.1)) - lq) * bs;
  i = i0; ty = slider(i0); f = exp(lf); q = exp(lq); tg = slider(i0 + 4);
  dyn = slider(i0 + 5) && cty == 1; thr = slider(i0 + 6); rng = slider(i0 + 7);
  sta += (slider(i0 + 2) - sta) * bs;
  bs >= 1 ? ( cty = ty; ctg = tg; wm = 1; );
  this.bd_coef();
  cty != 1 ? gs = sta;
);
function bd_clr() instance(env, fa, fb, ga, gb, pa, pb, so_a, so_b) (
  fa.bq_clr(); fb.bq_clr(); ga.bq_clr(); gb.bq_clr(); so_a.bq_clr(); so_b.bq_clr(); pa.ap_clr(); pb.ap_clr(); env = 0;
);
function bd_run() instance(ty, tg, cty, ctg, wm, dyn, thr, rng, gs, sta, env, grs, fa, fb, ga, gb, pa, pb) local(m, s, ua, ub, ya, yb, e, lv, o, h0, il, ir) (
  ty != cty || tg != ctg ? (
    wm = max(wm - bd_dk, 0);
    wm <= 0 || cty == 0 ? ( cty = ty; ctg = tg; wm = 0; this.bd_clr(); cty != 1 ? gs = sta; this.bd_coef(); );
  ) : wm < 1 ? wm = min(wm + bd_dk, 1);
  cty > 0 ? (
    il = bl; ir = br;
    ctg == 0 ? ( ua = bl; ub = br; ) : ( m = (bl + br) * 0.5; s = (bl - br) * 0.5; ua = m; ub = s; );
    cty == 1 ? (
      h0 = 10 ^ (gs / 20) - 1; e = 0;
      ctg != 2 ? ( ya = pa.ap_run(ua); e = abs((ua - ya) * 0.5); ua += h0 * 0.5 * (ua - ya); );
      ctg != 1 ? ( yb = pb.ap_run(ub); e = max(e, abs((ub - yb) * 0.5)); ub += h0 * 0.5 * (ub - yb); );
      dyn ? (
        e *= e; env += (e - env) * (e > env ? dy_att : dy_rel);
        lv = 10 * log10(max(env * 2, 0.000000000001)); o = max(lv - thr, 0);
        gs += (sta + rng * o / (o + 6) - gs) * 0.02;
        grs = max(grs, abs(gs - sta));
      ) : gs += (sta - gs) * 0.02;
    ) : (
      ctg != 2 ? ( ua = fa.bq_run(ua); cty >= 5 ? ua = ga.bq_run(ua); );
      ctg != 1 ? ( ub = fb.bq_run(ub); cty >= 5 ? ub = gb.bq_run(ub); );
    );
    ctg == 0 ? ( bl = ua; br = ub; ) : ( bl = ua + ub; br = ua - ub; );
    wm < 1 ? ( bl = il + (bl - il) * wm; br = ir + (br - ir) * wm; );
  );
);
function bd_solo(l, r) instance(tg, so_a, so_b) local(m, s) (
  tg == 0 ? ( bl = so_a.bq_run(l); br = so_b.bq_run(r); ) :
  tg == 1 ? ( m = so_a.bq_run((l + r) * 0.5); bl = m; br = m; ) :
            ( s = so_b.bq_run((l - r) * 0.5); bl = s; br = -s; );
);

function bw_q(n, k) ( 1 / (2 * sin((2 * k + 1) * $pi / (4 * n))) );
function fc_set(t, f, n) instance(s1L, s1R, s2L, s2R, s3L, s3R, s4L, s4R) (
  n < 1 ? ( s1L.bq_thru(); s1R.bq_thru(); ) : ( s1L.bq_set(t, f, bw_q(n, 0), 0); s1R.bq_set(t, f, bw_q(n, 0), 0); );
  n < 2 ? ( s2L.bq_thru(); s2R.bq_thru(); ) : ( s2L.bq_set(t, f, bw_q(n, 1), 0); s2R.bq_set(t, f, bw_q(n, 1), 0); );
  n < 3 ? ( s3L.bq_thru(); s3R.bq_thru(); ) : ( s3L.bq_set(t, f, bw_q(n, 2), 0); s3R.bq_set(t, f, bw_q(n, 2), 0); );
  n < 4 ? ( s4L.bq_thru(); s4R.bq_thru(); ) : ( s4L.bq_set(t, f, bw_q(n, 3), 0); s4R.bq_set(t, f, bw_q(n, 3), 0); );
);
function fc_clr() instance(s1L, s1R, s2L, s2R, s3L, s3R, s4L, s4R) (
  s1L.bq_clr(); s1R.bq_clr(); s2L.bq_clr(); s2R.bq_clr(); s3L.bq_clr(); s3R.bq_clr(); s4L.bq_clr(); s4R.bq_clr();
);
function fc_l(x) instance(s1L, s2L, s3L, s4L) ( s4L.bq_run(s3L.bq_run(s2L.bq_run(s1L.bq_run(x)))) );
function fc_r(x) instance(s1R, s2R, s3R, s4R) ( s4R.bq_run(s3R.bq_run(s2R.bq_run(s1R.bq_run(x)))) );

function update() (
  dy_att = 1 - exp(-1 / (dy_atk * 0.001 * srate));
  dy_rel = 1 - exp(-1 / (dy_rls * 0.001 * srate));
  out_t = 10 ^ (out_db / 20);
  in_setup(in_tr, in_gd);
  ost_setup(sat_pc / 100, sat_bi / 100, sat_lo, sat_hi, -0.3, 0);
  hp_nt = hp_f <= 20.5 ? 0 : hp_s + 1; lp_nt = lp_f >= 19990 ? 0 : lp_s + 1;
);
function es_rate() (
  es_sr = srate;
  bd_dk = 1 / (0.005 * srate);
  es_rsc = 1 / (0.015 * srate);
  sm = 1 - exp(-1 / (0.03 * srate));
);
function es_reset() (
  b1.bd_clr(); b2.bd_clr(); b3.bd_clr(); b4.bd_clr(); b5.bd_clr(); b6.bd_clr();
  hpc.fc_clr(); lpc.fc_clr(); ostL.ost_ch_init(); ostR.ost_ch_init();
  memset(BY_BUF, 0, 2 * BY_N);
  es_rs = 0;
);

SP_N = 4096; SP_RING = 40000; SP_FFT = 65536; SP_WIN = 80000; SP_COL = 90000; SP_NC = 404;
i = 0; loop(SP_N, SP_WIN[i] = 0.5 - 0.5 * cos(2 * $pi * i / (SP_N - 1)); i += 1; );
memset(SP_COL, -120, SP_NC);
sp_w = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
es_rate();
pkL = 0; pkR = 0;
!ui_dflt ? ( es_an = 1; es_sel = 0; );
es_solo = 0; es_sc = 0; es_sg = 1;
bs = 1;
update();
b1.bd_setup(1); b2.bd_setup(9); b3.bd_setup(17); b4.bd_setup(25); b5.bd_setup(33); b6.bd_setup(41);
hp_lf = log(max(hp_f, 10)); lp_lf = log(max(lp_f, 10)); hp_n = hp_nt; lp_n = lp_nt; hp_m = lp_m = 1;
hpc.fc_set(1, exp(hp_lf), hp_n); lpc.fc_set(0, exp(lp_lf), lp_n);
out_s = out_t;
es_rs = 1;
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.15; pwr_wu_loss = 0.4; pwr_wu_drv = 0.8; pwr_wu_lp = 12000; pwr_wu_wob = 0.15; pwr_bloom = 0;
pdc_delay = 0;
by_setup(62);

function load_preset(p) local(i) (
  p == 1 ? ( slider(1) = 1; slider(2) = 80; slider(3) = 0; slider(4) = 1; slider(5) = 0; slider(6) = 0; slider(7) = -30; slider(8) = 0; slider(9) = 1; slider(10) = 250; slider(11) = 0; slider(12) = 1; slider(13) = 0; slider(14) = 0; slider(15) = -30; slider(16) = 0; slider(17) = 1; slider(18) = 800; slider(19) = 0; slider(20) = 1; slider(21) = 0; slider(22) = 0; slider(23) = -30; slider(24) = 0; slider(25) = 1; slider(26) = 2500; slider(27) = 0; slider(28) = 1; slider(29) = 0; slider(30) = 0; slider(31) = -30; slider(32) = 0; slider(33) = 1; slider(34) = 6000; slider(35) = 0; slider(36) = 1; slider(37) = 0; slider(38) = 0; slider(39) = -30; slider(40) = 0; slider(41) = 1; slider(42) = 12000; slider(43) = 0; slider(44) = 1; slider(45) = 0; slider(46) = 0; slider(47) = -30; slider(48) = 0; slider(49) = 5; slider(50) = 120; slider(51) = 0; slider(58) = 20; slider(59) = 20000; slider(60) = 1; slider(61) = 1; );
