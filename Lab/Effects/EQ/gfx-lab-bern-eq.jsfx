desc:Bern EQ [broadcast EQ] (GFX Lab)
//tags: equaliser eq channel strip broadcast console analogue transformer
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-power, gfx-lab-v5-parts, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider16:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:in_db=0<-18,18,0.1>-Input (dB)
slider3:lo_md=0<0,1,1{Shelf,High-pass}>-Low mode
slider4:lo_sf=1<0,1,1{60 Hz,100 Hz}>-Low shelf freq
slider5:lo_g=0<-15,15,0.1>-Low gain (dB)
slider6:hp_f=1<0,2,1{40 Hz,80 Hz,120 Hz}>-HPF freq
slider7:mi_f=1200<150,7000,1>-Mid freq (Hz)
slider8:mi_g=0<-15,15,0.1>-Mid gain (dB)
slider9:mi_q=0<0,1,1{Broad,Narrow}>-Mid Q
slider10:hi_f=1<0,2,1{10 kHz,15 kHz,20 kHz}>-High freq
slider11:hi_g=0<-15,15,0.1>-High gain (dB)
slider12:eq_in=1<0,1,1{Out,In}>-EQ In
slider13:out_db=0<-18,18,0.1>-Output (dB)
slider14:drift_pc=20<0,100,1>-Drift (%)
slider15:prs_sel=0<0,11,1{No preset,Init,Vocal Air,Broadcast Voice,Kick Weight,Guitar Presence,Bass Clean-Up,Mix Bus Sheen,Telephone,De-Mud,Piano Open,Warm Drive}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(65535, v); );
function psw_allg(v) ( slider_show(65535, v); );
#ui_man = "gfx-lab-bern-eq";
ext_noinit = 1;
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function db2g(d) ( exp(d*0.11512925465); );
ost_init(alloc(4096));

function bz_lsHz(i) ( i < 0.5 ? 60 : 100; );
function bz_hpHz(i) ( i < 0.5 ? 40 : i < 1.5 ? 80 : 120; );
function bz_hsHz(i) ( i < 0.5 ? 10000 : i < 1.5 ? 15000 : 20000; );
function bz_mq(i) ( i < 0.5 ? 0.8 : 2; );

function bz_pk(c, f, g, q) local(A, w0, z, e, pa1, pa2, m0, m1, m2, p0, p1, p2, GG, R1, R2, B0, B1, B2, W, t) (
  A = 10^(g/40); w0 = 2*$pi*min(f, srate*0.45)/srate; z = 1/(2*A*q); e = exp(-z*w0);
  z <= 1 ? pa1 = -2*e*cos(w0*sqrt(1 - z*z)) : ( t = w0*sqrt(z*z - 1); pa1 = -e*(exp(t) + exp(-t)); );
  pa2 = e*e;
  m0 = sqr(1 + pa1 + pa2); m1 = sqr(1 - pa1 + pa2); m2 = -4*pa2;
  p1 = sqr(sin(w0*0.5)); p0 = 1 - p1; p2 = 4*p0*p1;
  GG = A*A;
  R1 = (m0*p0 + m1*p1 + m2*p2)*GG*GG;
  R2 = (-m0 + m1 + 4*(p0 - p1)*m2)*GG*GG;
  B0 = m0; B2 = (R1 - R2*p1 - B0)/(4*p1*p1); B1 = R2 + B0 + 4*(p1 - p0)*B2;
  W = 0.5*(sqrt(B0) + sqrt(max(B1, 0)));
  c[0] = 0.5*(W + sqrt(max(W*W + B2, 0))); c[1] = 0.5*(sqrt(B0) - sqrt(max(B1, 0))); c[2] = -B2/(4*c[0]);
  c[3] = pa1; c[4] = pa2;
);
function bz_hs(c, f, g) local(GG, w0, sg, wp, wz, pp, wn, hn, s, d) (
  GG = 10^(g/20); w0 = 2*$pi*f; sg = sqrt(GG); wp = w0*sg; wz = w0/sg;
  pp = exp(-wp/srate); wn = $pi*srate;
  hn = GG*sqrt((wn*wn + wz*wz)/(wn*wn + wp*wp));
  s = 1 - pp; d = hn*(1 + pp);
  c[0] = 0.5*(s + d); c[1] = 0.5*(s - d); c[2] = 0; c[3] = -pp; c[4] = 0;
);
function bz_ls(c, f, g, q) local(A, w, cs, al, sa, a0) (
  A = 10^(g/40); w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*q); sa = 2*sqrt(A)*al;
  a0 = (A + 1) + (A - 1)*cs + sa;
  c[0] = A*((A + 1) - (A - 1)*cs + sa)/a0; c[1] = 2*A*((A - 1) - (A + 1)*cs)/a0; c[2] = A*((A + 1) - (A - 1)*cs - sa)/a0;
  c[3] = -2*((A - 1) + (A + 1)*cs)/a0; c[4] = ((A + 1) + (A - 1)*cs - sa)/a0;
);
function bz_hp(c, f) local(w, cs, al, a0) (
  w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*0.70711); a0 = 1 + al;
  c[0] = (1 + cs)*0.5/a0; c[1] = -(1 + cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0;
);
function bz_bq(x, c, s) local(y) (
  y = c[0]*x + c[1]*s[0] + c[2]*s[1] - c[3]*s[2] - c[4]*s[3];
  s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y;
  y;
);

bz_cLS = alloc(5); bz_cHP = alloc(5); bz_cPK = alloc(5); bz_cHS = alloc(5);
bz_sLS0 = alloc(4); bz_sLS1 = alloc(4); bz_sHP0 = alloc(4); bz_sHP1 = alloc(4);
bz_sPK0 = alloc(4); bz_sPK1 = alloc(4);
bz_sHa0 = alloc(4); bz_sHa1 = alloc(4); bz_sHb0 = alloc(4); bz_sHb1 = alloc(4);
gz_cLS = alloc(5); gz_cHP = alloc(5); gz_cPK = alloc(5); gz_cHS = alloc(5);

function bz_inamp(x) instance(dx, dy) local(u, y, d) (
  u = x*bz_ihI;
  y = min(max(u, -4), 4); y = u + 0.3*abs(y)*y*y;
  y = y/sqrt(sqrt(1 + sqr(sqr(y))));
  d = y - u;
  dy = d - dx + bz_dcR*dy; dx = d;
  (u + dy)*bz_hrI;
);
function bz_outamp(x) instance(lp) local(lo, k, y) (
  lp += (x - lp)*bz_lpc;
  k = lp*bz_ihO*1.6;
  lo = lp/sqrt(1 + k*k);
  y = (x - lp + lo)*bz_ihO;
  y = y/sqrt(sqrt(1 + sqr(sqr(y))));
  y*bz_hrO;
);

bz_dV = 0; bz_dT = 0; bz_dW = 0; bz_heat = 0; bz_cnt = 0;
function bz_rate() (
  bz_sr = srate;
  gdc_r = 1 - 2 * $pi / srate;
  bz_dcR = 1 - 2*$pi*4/srate;
  bz_lpc = 1 - exp(-2*$pi*140/srate);
  bz_kS = 1 - exp(-16/(0.03*srate));
  bz_kD = 1 - exp(-1/(0.03*srate));
  bz_rsc = 1 / (0.015 * srate);
);
bz_rate();

function bz_targets() local(v, gk, fk) (
  v = bz_dV*drift_pc/100;
  gk = 1 + 0.025*v; fk = 1 + 0.006*v;
  bz_tLg = lo_g*gk;   bz_tLf = log(bz_lsHz(lo_sf)*fk);
  bz_tHp = log(bz_hpHz(hp_f)*fk);
  bz_tMg = mi_g*gk;   bz_tMf = log(min(max(mi_f, 150), 7000)*fk); bz_tMq = bz_mq(mi_q);
  bz_tHg = hi_g*gk;   bz_tHf = log(bz_hsHz(hi_f)*fk);
  bz_tMode = lo_md > 0.5; bz_tEq = eq_in > 0.5;
  bz_tIn = db2g(in_db); bz_tOut = db2g(out_db);
  bz_hrI = db2g(14 - 2*v); bz_ihI = 1/bz_hrI;
  bz_hrO = db2g(16 - 2*v); bz_ihO = 1/bz_hrO;
);
function bz_coefs() (
  bz_ls(bz_cLS, exp(bz_Lf), bz_Lg, 0.6);
  bz_hp(bz_cHP, exp(bz_Hp));
  bz_pk(bz_cPK, exp(bz_Mf), bz_Mg, bz_Mq);
  bz_hs(bz_cHS, exp(bz_Hf), bz_Hg*0.5);
);
function bz_glide() local(k, ch) (
  k = bz_kS;
  ch = abs(bz_tLg - bz_Lg) + abs(bz_tLf - bz_Lf) + abs(bz_tHp - bz_Hp) + abs(bz_tMg - bz_Mg) + abs(bz_tMf - bz_Mf)
     + abs(bz_tMq - bz_Mq) + abs(bz_tHg - bz_Hg) + abs(bz_tHf - bz_Hf);
  ch > 0.00001 ? (
    bz_Lg += (bz_tLg - bz_Lg)*k; bz_Lf += (bz_tLf - bz_Lf)*k; bz_Hp += (bz_tHp - bz_Hp)*k;
    bz_Mg += (bz_tMg - bz_Mg)*k; bz_Mf += (bz_tMf - bz_Mf)*k; bz_Mq += (bz_tMq - bz_Mq)*k;
    bz_Hg += (bz_tHg - bz_Hg)*k; bz_Hf += (bz_tHf - bz_Hf)*k;
    bz_coefs();
  );
);
function bz_snap() (
  bz_targets();
  bz_Lg = bz_tLg; bz_Lf = bz_tLf; bz_Hp = bz_tHp; bz_Mg = bz_tMg; bz_Mf = bz_tMf; bz_Mq = bz_tMq; bz_Hg = bz_tHg; bz_Hf = bz_tHf;
  bz_mode = bz_tMode; bz_eq = bz_tEq; bz_gIn = bz_tIn; bz_gOut = bz_tOut;
  bz_coefs();
);
function bz_clr() (
  memset(bz_sLS0, 0, 40);
  bz_iL.dx = bz_iL.dy = bz_iR.dx = bz_iR.dy = 0; bz_oL.lp = bz_oR.lp = 0;
  gdc_x0 = gdc_y0 = gdc_x1 = gdc_y1 = 0;
  memset(BY_BUF, 0, 2 * BY_N);
  bz_rs = 0;
);
bz_snap();
bz_rs = 1;
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.2; pwr_wu_loss = 0.6; pwr_wu_drv = 1.2; pwr_wu_lp = 9000; pwr_wu_wob = 0.2; pwr_bloom = 0.1;
pdc_delay = 0;
by_setup(1);

function bz_p(it, md, lf, lg, hp, mf, mg, mq, hf, hg, ot) (
  in_db = it; lo_md = md; lo_sf = lf; lo_g = lg; hp_f = hp; mi_f = mf; mi_g = mg; mi_q = mq;
  hi_f = hf; hi_g = hg; eq_in = 1; out_db = ot;
);
function load_preset(p) local(i) (
  p == 1  ? ( bz_p(0, 0, 1, 0, 1, 1200, 0, 0, 1, 0, 0); drift_pc = 20; ) :
  p == 2  ? bz_p(0, 1, 1, 0, 1, 3200, 1.5, 0, 1, 5, -1) :
  p == 3  ? bz_p(3, 1, 1, 0, 2, 2500, 3, 0, 0, 2, -4) :
  p == 4  ? bz_p(0, 0, 0, 6, 1, 320, -3.5, 0, 0, 1.5, -1) :
  p == 5  ? bz_p(0, 1, 1, 0, 1, 2200, 3.5, 0, 0, 1.5, -1) :
  p == 6  ? bz_p(0, 1, 1, 0, 0, 250, -3, 0, 0, -2, 0.5) :
  p == 7  ? bz_p(0, 0, 0, 1, 1, 3000, -0.5, 0, 2, 3, -0.5) :
  p == 8  ? bz_p(6, 1, 1, 0, 2, 1500, 10, 1, 0, -15, -8) :
  p == 9  ? bz_p(0, 0, 1, -1, 1, 300, -5, 0, 1, 1.5, 1) :
  p == 10 ? bz_p(0, 0, 1, -1.5, 1, 600, -2, 0, 1, 3, 0) :
  p == 11 ? bz_p(4, 0, 0, 2.5, 1, 1800, 1, 0, 2, 2, -4);
  i = 2; loop(13, ui_auto(i); i += 1; );
);

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
ui_thm = 5; ui_hw = 1;
#bz_pm = "Init|Vocal Air|Broadcast Voice|Kick Weight|Guitar Presence|Bass Clean-Up|Mix Bus Sheen|Telephone|De-Mud|Piano Open|Warm Drive";

function prs_hash() local(i, h) ( h = 0; i = 1; loop(15, i != 15 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 11 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
bz_targets();
ost_setup(0, 0, 120, 6000, -0.3, 0);
pdc_delay = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
prs_chk();
srate != bz_sr ? ( bz_rate(); bz_snap(); bz_clr(); );
bz_now = time_precise();
bz_tp > 0 && bz_now - bz_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > bz_gpp && play_position - bz_gpp < 4 * bz_gpd + 0.05) ? bz_clr();
bz_tp = bz_now; bz_gpp = play_position; bz_gpd = samplesblock / srate;
pwr_block(byp < 0.5);
bz_dW -= samplesblock; bz_dW <= 0 ? ( bz_dW = srate*(0.7 + rand(1) * 2.3); bz_dT = rand(2) - 1; );
bz_dV += (bz_dT - bz_dV)*min(1, samplesblock/(1.2*srate));
bz_targets();
ost_setup(0, 0, 120, 6000, -0.3, 0);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;
bz_pkl_d = max(bz_pkl_d, bz_pkl); bz_pkr_d = max(bz_pkr_d, bz_pkr); bz_pkl = bz_pkr = 0;
bz_heat_d = bz_heat;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
bz_d0 = spl0; bz_d1 = spl1;
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
bz_cnt <= 0 ? ( bz_glide(); bz_cnt = 16; ); bz_cnt -= 1;
bz_gIn += (bz_tIn - bz_gIn)*bz_kD; bz_gOut += (bz_tOut - bz_gOut)*bz_kD;
bz_mode += (bz_tMode - bz_mode)*bz_kD; bz_eq += (bz_tEq - bz_eq)*bz_kD;
abs(bz_mode - bz_tMode) < 0.0001 ? bz_mode = bz_tMode;
abs(bz_eq - bz_tEq) < 0.0001 ? bz_eq = bz_tEq;

bz_x0 = spl0*bz_gIn + 0.000000000000000001; bz_x1 = spl1*bz_gIn + 0.000000000000000001;
pwr_in(bz_x0, bz_x1); bz_x0 = pwr_l; bz_x1 = pwr_r;
bz_a_ = max(abs(bz_x0), abs(bz_x1))*bz_ihI; bz_heat = bz_a_ > bz_heat ? bz_a_ : bz_heat*0.99993;
bz_x0 = bz_iL.bz_inamp(bz_x0); bz_x1 = bz_iR.bz_inamp(bz_x1);

bz_eq > 0 ? (
  bz_y0 = bz_x0; bz_y1 = bz_x1;
  bz_mode < 1 ? ( bz_s0 = bz_bq(bz_y0, bz_cLS, bz_sLS0); bz_s1 = bz_bq(bz_y1, bz_cLS, bz_sLS1); );
  bz_mode > 0 ? ( bz_h0 = bz_bq(bz_y0, bz_cHP, bz_sHP0); bz_h1 = bz_bq(bz_y1, bz_cHP, bz_sHP1); );
  bz_y0 = bz_mode <= 0 ? bz_s0 : bz_mode >= 1 ? bz_h0 : bz_s0 + (bz_h0 - bz_s0)*bz_mode;
  bz_y1 = bz_mode <= 0 ? bz_s1 : bz_mode >= 1 ? bz_h1 : bz_s1 + (bz_h1 - bz_s1)*bz_mode;
  bz_y0 = bz_bq(bz_y0, bz_cPK, bz_sPK0); bz_y1 = bz_bq(bz_y1, bz_cPK, bz_sPK1);
  bz_y0 = bz_bq(bz_bq(bz_y0, bz_cHS, bz_sHa0), bz_cHS, bz_sHb0);
  bz_y1 = bz_bq(bz_bq(bz_y1, bz_cHS, bz_sHa1), bz_cHS, bz_sHb1);
  bz_x0 += (bz_y0 - bz_x0)*bz_eq; bz_x1 += (bz_y1 - bz_x1)*bz_eq;
);
bz_mode <= 0 ? memset(bz_sHP0, 0, 8) : bz_mode >= 1 ? memset(bz_sLS0, 0, 8);
bz_eq <= 0 ? ( memset(bz_sLS0, 0, 8); memset(bz_sHP0, 0, 8); memset(bz_sPK0, 0, 8); memset(bz_sHa0, 0, 16); );

bz_x0 = bz_oL.bz_outamp(bz_x0); bz_x1 = bz_oR.bz_outamp(bz_x1);
pwr_out(bz_x0, bz_x1); bz_x0 = pwr_l; bz_x1 = pwr_r;
ost_out(bz_x0*bz_gOut, bz_x1*bz_gOut);
spl0 = ost_l; spl1 = ost_r;
bz_rs < 1 ? (
  bz_rs = min(bz_rs + bz_rsc, 1); bz_rq = bz_rs * bz_rs * (3 - 2 * bz_rs);
  spl0 = bz_d0 + (spl0 - bz_d0) * bz_rq; spl1 = bz_d1 + (spl1 - bz_d1) * bz_rq;
);
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_out();
bz_pkl = max(bz_pkl, abs(spl0)); bz_pkr = max(bz_pkr, abs(spl1));

@gfx 900 355
ui_begin(900, 355);
v5_begin();
BP = 0xBCC6CC; BW = 0xD3CAC2; BI = 0x262A2E; BI2 = 0x55595E; BHD = 0x2E3740; BSC = 0x0F1519; BTR = 0xF2D27A;
BB = 0x2A2620; BA = 0xFFC060; BTB = ui_mix(BW, 0xFFFFFF, 0.55); BTI = BI;
BCL = 0x2F68B0; BCM = 0x2F9A58; BCH = 0xC63A2C;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
e5_lfs = 15;
sc != e5_fsc ? (
  e5_fsc = sc;
  e5_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  e5_f6 = ui_fitfont(6, 28 * sc);
);
function e5_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * e5_kt * sc, 'b'); );
function e5_fc(px) ( gfx_setfont(12, "Courier New", px * e5_kt * sc, 'b'); );
function e5_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function e5_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function e5_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function e5_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function e5_pocket(x, y, w, h, f) local(i) (
  ui_col(f); v5_r(x, y, w, h);
