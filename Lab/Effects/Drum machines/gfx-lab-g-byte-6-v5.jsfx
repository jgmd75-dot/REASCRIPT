  lrow(20, 5, "...x..x...x..x..");
  lrow(21, 0, "X.x.X.x.X.x.X.x.");
  lrow(21, 1, "....X.......X...");
  lrow(21, 2, "..x...x...x...x.");
  lrow(22, 0, "X.......X.......");
