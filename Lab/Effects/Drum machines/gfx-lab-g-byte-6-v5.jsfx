  lrow(22, 5, "..x...x...x...x.");
  lrow(23, 0, "........X.......");
  lrow(23, 2, "x.x.x.x.x.x.x.x.");
  lrow(23, 3, "......x.......x.");
  lrow(23, 5, "........X.......");
  lrow(24, 0, "X..x..X.X..x..X.");
