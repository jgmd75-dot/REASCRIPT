function lib_name(p) ( p == 0 ? "SYNTH POP" : p == 1 ? "SYNTH POP 2" : p == 2 ? "DANCE POP" : p == 3 ? "ITALO" : p == 4 ? "HI-NRG" : p == 5 ? "POWER BALLAD" : p == 6 ? "ELECTRO" : p == 7 ? "ELECTRO 2" : p == 8 ? "MIAMI BASS" : p == 9 ? "FREESTYLE" : p == 10 ? "FUNK" : p == 11 ? "GO-GO" : p == 12 ? "HIP HOP" : p == 13 ? "LO-FI BOOM" : p == 14 ? "NEW JACK" : p == 15 ? "SHUFFLE" : p == 16 ? "HALF TIME" : p == 17 ? "BREAKBEAT" : p == 18 ? "DISCO" : p == 19 ? "HOUSE" : p == 20 ? "EARLY TECHNO" : p == 21 ? "EBM" : p == 22 ? "CLAP STOMP" : p == 23 ? "ONE DROP" : p == 24 ? "LATIN RIM" : p == 25 ? "SAMBA RUN" : p == 26 ? "MARCH" : p == 27 ? "ROCK" : p == 28 ? "SNARE FILL" : p == 29 ? "CLAP FILL" : p == 30 ? "BREAKDOWN" : p == 31 ? "KICK INTRO" : "EMPTY"; );
#lib_menu = ">Pop and Synth|Synth Pop|Synth Pop 2|Dance Pop|Italo|Hi-NRG|<Power Ballad|>Electro and Funk|Electro|Electro 2|Miami Bass|Freestyle|Funk|<Go-Go|>Hip Hop and Swing|Hip Hop|Lo-fi Boom|New Jack|Shuffle|Half Time|<Breakbeat|>Dance|Disco|House|Early Techno|EBM|<Clap Stomp|>World and More|One Drop|Latin Rim|Samba Run|March|<Rock|>Fills and Parts|Snare Fill|Clap Fill|Breakdown|<Kick Intro";
LIBN = 32;
function slots_default() local(i) (
  memcpy(PAT + 0 * 96, LIB + 0 * 96, 96); SLN[0] = 0;
  memcpy(PAT + 1 * 96, LIB + 6 * 96, 96); SLN[1] = 6;
  memcpy(PAT + 2 * 96, LIB + 12 * 96, 96); SLN[2] = 12;
  memcpy(PAT + 3 * 96, LIB + 9 * 96, 96); SLN[3] = 9;
  memcpy(PAT + 4 * 96, LIB + 14 * 96, 96); SLN[4] = 14;
  memcpy(PAT + 5 * 96, LIB + 10 * 96, 96); SLN[5] = 10;
  memcpy(PAT + 6 * 96, LIB + 18 * 96, 96); SLN[6] = 18;
  memcpy(PAT + 7 * 96, LIB + 19 * 96, 96); SLN[7] = 19;
  memcpy(PAT + 8 * 96, LIB + 3 * 96, 96); SLN[8] = 3;
  memcpy(PAT + 9 * 96, LIB + 8 * 96, 96); SLN[9] = 8;
  memcpy(PAT + 10 * 96, LIB + 11 * 96, 96); SLN[10] = 11;
  memcpy(PAT + 11 * 96, LIB + 27 * 96, 96); SLN[11] = 27;
  memcpy(PAT + 12 * 96, LIB + 5 * 96, 96); SLN[12] = 5;
  memcpy(PAT + 13 * 96, LIB + 23 * 96, 96); SLN[13] = 23;
  memcpy(PAT + 14 * 96, LIB + 24 * 96, 96); SLN[14] = 24;
  memcpy(PAT + 15 * 96, LIB + 28 * 96, 96); SLN[15] = 28;
);

lib_build();
!init_done ? ( memset(PAT, 0, 16 * 96); slots_default(); init_done = 1; );

b6_ag = 1; b6_pkL = b6_pkR = 0;
function b6_srinit() (
  b6_sr = srate;
  ost_init(20000);
  b6_chk = exp(-1 / (0.004 * srate));
  sm6 = 1 - exp(-1 / (0.03 * srate));
);
b6_srinit();
function gap_clear() (
  b6v0.b6_clr(); b6v1.b6_clr(); b6v2.b6_clr(); b6v3.b6_clr(); b6v4.b6_clr(); b6v5.b6_clr();
  ostL.ost_ch_init(); ostR.ost_ch_init();
);
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; dv_sel = 0; b6_last = 0; b6_lvel = -1; );
b6_update();
b6_vol_s = b6_vol;
pwr_init(); pwr_hum_db = -82; pwr_sag = 0.1; pwr_rip = 0.002; pwr_wu_loss = 0.25; pwr_wu_drv = 0.4; pwr_wu_lp = 14000; pwr_wu_wob = 0.05; pwr_bloom = 0;
cur_step = -1; cur_pat = slider42; run = 0; run_rq_d = 0; sq_n = 0;
mn_vu_d = mn_pk_d = 0; mn_pkm = 0;
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(43, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; k = k > 10 ? 1 : k; load_preset(k);
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
b6_update();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_mem(0, PAT, 16 * 96);
file_mem(0, SLN, 16);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
pwr_ser();

@block
gp_now = time_precise();
gp_last > 0 && gp_now - gp_last > max(0.25, 4 * samplesblock / srate) && !(play_position > gp_gpp && play_position - gp_gpp < 4 * gp_gpd + 0.05) ? gap_clear();
gp_last = gp_now; gp_gpp = play_position; gp_gpd = samplesblock / srate;
prs_chk();
srate != b6_sr ? b6_srinit();
b6_update();
pwr_block(1);
pat_dirty > 0 ? (
  pat_dirty <= LIBN ? ( memcpy(PAT + slider42 * 96, LIB + (pat_dirty - 1) * 96, 96); SLN[slider42] = pat_dirty - 1; ) :
  pat_dirty == 100 ? ( memset(PAT + slider42 * 96, 0, 96); SLN[slider42] = -1; ) :
  pat_dirty > 100 && pat_dirty <= 116 ? ( memcpy(PAT + (pat_dirty - 101) * 96, PAT + slider42 * 96, 96); SLN[pat_dirty - 101] = SLN[slider42]; );
  pat_dirty = 0;
);
b6_en = 0;
while (midirecv(b6_mo, b6_m1, b6_m2, b6_m3)) (
  (b6_m1 & 0xF0) == 0x90 && b6_m3 > 0 && ins_chan_ok(b6_m1, b6_chan) && b6_en < 512 && B6NMAP[b6_m2] >= 0 ? (
    B6EVQ[b6_en * 3] = b6_mo; B6EVQ[b6_en * 3 + 1] = B6NMAP[b6_m2]; B6EVQ[b6_en * 3 + 2] = b6_m3 / 127; b6_en += 1;
  );
  midisend(b6_mo, b6_m1, b6_m2, b6_m3);
);
b6_ei = 0; b6_sp = 0;
aud_dirty > 0 ? ( b6_ag = 1; b6_hit(aud_dirty - 1, 1); aud_dirty = 0; );

run_t = slider40 >= 0.5 ? (play_state & 1) : run_rq_d;
run_t != run ? ( run = run_t; run ? ( free_pos = 0; seq_next = 0; next_t = 0; was_play = 0; cur_pat = slider42; ); );
sq_n = 0; sq_i = 0;
run ? (
  spb = 60 / max(tempo, 20) * srate / 4;
  (play_state & 1) && slider40 >= 0.5 ? (
    pos0 = beat_position * 4;
    abs(pos0 - exp_pos) > 0.5 || !was_play ? ( seq_next = ceil(pos0 - 0.0001); next_t = seq_next + (seq_next & 1 ? sq_swing : 0); );
    was_play = 1;
  ) : (
    pos0 = free_pos; was_play = 0;
  );
  pos1 = pos0 + samplesblock / spb;
  while (next_t < pos1 && sq_n < 280) (
    seq_next >= 0 ? (
      q_off = max(0, min(samplesblock - 1, floor((max(next_t, pos0) - pos0) * spb + 0.5)));
      q_st = seq_next - floor(seq_next / 16) * 16;
      q_st == 0 ? cur_pat = slider42;
      cur_step = q_st;
      q_r = 0;
      loop(6, q_v = PAT[cur_pat * 96 + q_r * 16 + q_st];
        q_v ? ( SQO[sq_n] = q_off; SQP[sq_n] = q_r; SQV[sq_n] = q_v == 2 ? b6_acc_h : b6_acc_p; sq_n += 1; ); q_r += 1; );
    );
    seq_next += 1; next_t = seq_next + (seq_next & 1 ? sq_swing : 0);
  );
  free_pos = pos1; exp_pos = pos1;
) : ( cur_step = -1; cur_pat = slider42; was_play = 0; );
mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;

@sample
while (b6_ei < b6_en && (B6EVQ[b6_ei * 3] <= b6_sp || b6_sp >= samplesblock - 1)) (
  b6_ag = 1; b6_hit(B6EVQ[b6_ei * 3 + 1], B6EVQ[b6_ei * 3 + 2]); ins_midi_hit();
  b6_ei += 1;
);
while (sq_i < sq_n && (SQO[sq_i] <= b6_sp || b6_sp >= samplesblock - 1)) (
  b6_ag = SQV[sq_i]; b6_hit(SQP[sq_i], 1); b6_ag = 1;
  sq_i += 1;
);
b6_sp += 1;

b6_y = b6v0.b6_run(); b6_l = b6_y * b6v0.gl; b6_r = b6_y * b6v0.gr;
b6_y = b6v1.b6_run(); b6_l += b6_y * b6v1.gl; b6_r += b6_y * b6v1.gr;
b6_y = b6v2.b6_run(); b6_l += b6_y * b6v2.gl; b6_r += b6_y * b6v2.gr;
b6_y = b6v3.b6_run(); b6_l += b6_y * b6v3.gl; b6_r += b6_y * b6v3.gr;
b6_y = b6v4.b6_run(); b6_l += b6_y * b6v4.gl; b6_r += b6_y * b6v4.gr;
b6_y = b6v5.b6_run(); b6_l += b6_y * b6v5.gl; b6_r += b6_y * b6v5.gr;

pwr_in(b6_l, b6_r); b6_l = pwr_l; b6_r = pwr_r;
b6_l = ostL.ost_band(b6_l); b6_r = ostR.ost_band(b6_r);
pwr_out(b6_l, b6_r);
b6_vol_s += (b6_vol - b6_vol_s) * sm6;
ins_stereo(pwr_l * b6_vol_s, pwr_r * b6_vol_s); ost_out(ins_sl, ins_sr);
spl0 = ost_l;
spl1 = ost_r;
mn_pkm = max(mn_pkm, max(abs(spl0), abs(spl1)));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
GF = 0xD9A99A; GB = 0x1D1E22; GP = 0x3A2629; GTX = 0xECE8DC; GH = 0x14151A; GV = 0xFFD060;
GO = 0xD8542A; GG = 0x8DB33A; GU = 0x3A6EA8;
sc != g6_fsc ? (
  g6_fsc = sc;
  g6_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  g6_f6 = ui_fitfont(6, 24 * sc);
);
function g6_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * g6_kt * sc, 'b'); );
function g6_fc(px) ( gfx_setfont(12, "Courier New", px * sc, 'b'); );
function g6_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function g6_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function g6_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function g6_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function g6_rivet(x, y) ( ui_cola(0, 0.3); v5_d(x + 1, y + 1.5, 4); ui_col(0x8E8A82); v5_d(x, y, 4); ui_col(0xC4C0B8); v5_d(x - 0.8, y - 0.8, 2.4); );
function g6_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.3); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.1)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.2)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
);
function g6_pocket(x, y, w, h) ( g6_cham(x, y, w, h, 3, GF); ui_col(GP); v5_r(x + 3, y + 3, w - 6, h - 6); );
function g6_hover(cx, cy, fs) ( g6_hon = 1; g6_hx = cx; g6_hy = cy; g6_hfs = fs; );
function g6_head(x, y, w, ttl, sub, uc) (
  g6_ft(16); ui_col(GTX); g6_tl(x + 14, y + 19, ttl);
  g6_ft(12); ui_col(v5_ink); g6_tr(x + w - 14, y + 20, sub);
  ui_col(uc); v5_r(x + 12, y + 31, w - 24, 3);
);
function g6_fmt(idx) local(v, k) (
  v = slider(idx); k = idx >= 16 && idx <= 39 ? (idx - 16) % 4 : -1;
  idx == 1 ? sprintf(#g6_hv, "%+.1f dB", v)
  : k == 0 ? sprintf(#g6_hv, "%+.1f st", v)
  : k == 3 ? ( abs(v) < 0.5 ? strcpy(#g6_hv, "CENTRE") : sprintf(#g6_hv, v < 0 ? "L %d" : "R %d", abs(v) + 0.5); )
  : idx == 4 ? ( v = min(b6_rate * 0.5 * v / 100, srate * 0.45); v < 1000 ? sprintf(#g6_hv, "%d Hz", v + 0.5) : sprintf(#g6_hv, "%.1f kHz", v / 1000); )
  : sprintf(#g6_hv, "%d %%", v + 0.5);
);
function g6_dial(cx, cy, r, idx, lo, hi, def, lg, lbl, ptr, fs, mid) local(n, a, i, t, rs) (
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 8), 0, 200);
  a = -0.75 * $pi + n * 1.5 * $pi; rs = r + 7;
  ui_col(0xC8CDC4); t = -0.75 * $pi; v5_sd(cx + sin(t) * rs, cy - cos(t) * rs, 1.7); v5_sd(cx - sin(t) * rs, cy - cos(t) * rs, 1.7);
  mid ? v5_sd(cx, cy - rs, 1.7);
  v5_shc(cx, cy, r);
  ui_col(0x151817); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2E3331); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xBDB49E); v5_d(cx, cy, r * 0.74);
  ui_col(g6_cc); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  v5_pdot(cx, cy, a, r * 0.70, ptr);
  v5_act ? ( g6_fmt(idx); g6_hover(cx, cy + r + 19, fs); ) : ( g6_ft(fs); ui_col(GTX); v5_t(cx, cy + r + 19, lbl); );
);
function g6_led(x, y, c, g) local(i) (
  ui_col(0x050606); v5_d(x, y, 5.5);
  ui_col(ui_mix(c, 0x101214, 0.78)); v5_d(x, y, 4);
  g > 0.01 ? (
    i = 0; loop(5, ui_cola(c, 0.07 * g); v5_d(x, y, 4 + 2.2 * (5 - i)); i += 1; );
    ui_cola(c, g); v5_d(x, y, 4);
    ui_cola(ui_mix(c, 0xFFFFFF, 0.6), 0.85 * g); v5_d(x - 1, y - 1.2, 1.6);
  );
);
function g6_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 6, y - 6, w + 12, h + 12, 5);
  ui_col(0x1A1C1D); v5_rr(x - 3, y - 3, w + 6, h + 6, 3);
  c0 = ui_mix(0x9EA49A, 0xC6CCBF, 0.44); c1 = 0xC6CCBF; c2 = ui_mix(0x9EA49A, 0xC6CCBF, 0.16);
  g6_grad(x, y, w, floor(h * 0.4 + 0.5), c0, c1); g6_grad(x, y + floor(h * 0.4 + 0.5), w, h - floor(h * 0.4 + 0.5), c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function g6_arrkey(x, y, w, h, dir) local(cx, cy) (
  v5_keycap(x, y, w, h, 0, 0x3A3E41, 0x4A4F53, v5_cr, "", -1);
  cx = x + w / 2; cy = y + h * 0.42; ui_col(v5_cr);
  dir < 0 ? gfx_triangle((cx - 5.5) * sc, cy * sc, (cx + 3.5) * sc, (cy - 5.5) * sc, (cx + 3.5) * sc, (cy + 5.5) * sc)
          : gfx_triangle((cx + 5.5) * sc, cy * sc, (cx - 3.5) * sc, (cy - 5.5) * sc, (cx - 3.5) * sc, (cy + 5.5) * sc);
);
function g6_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#g6_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 38, 34) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
  v5_pr && v5_drag == 0 && v5_hit(x + 42, y, 38, 34) ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; v5_drag = -1; );
  g6_arrkey(x, y, 38, 34, -1); g6_arrkey(x + 42, y, 38, 34, 1);
  gx = x + 90; g6_glass(gx, y + 3, w - 90, 28);
  cur >= 1 && cur <= n ? pk_pitem(#g6_pm, cur, #g6_pl) : strcpy(#g6_pl, "--");
  v5_lcdfit(#g6_pl, 18, w - 110, 11); ui_col(0x15180F); g6_tl(gx + 10, y + 17.5, #g6_pl);
  v5_pr && v5_drag == 0 && v5_hit(gx, y + 3, w - 90, 28) ? ( open = 1; v5_drag = -1; );
  open ? (
    strcpy(#g6_pmm, ""); i = 1;
    loop(n, i == cur ? strcat(#g6_pmm, "!"); strcat(#g6_pmm, pk_pitem(#g6_pm, i, #g6_pt)); i < n ? strcat(#g6_pmm, "|"); i += 1; );
    gfx_x = gx * sc; gfx_y = (y + 36) * sc; i = gfx_showmenu(#g6_pmm); i > 0 ? sel = i;
  );
  sel;
);
function g6_sml(x, y) local(i, cur, on) (
  cur = ui_sz == 1 ? 0 : ui_sz == 2 ? 2 : 1;
