function syn_sl_load_au() local(b, i) ( b = SYP + sel * 32; i = 1; loop(25, slider(30 + i) = b[i]; i += 1; ); );
function syn_sl_store_au() local(b, i, ch) (
  b = SYP + sel * 32; ch = 0; i = 1;
  loop(25, slider(30 + i) != b[i] ? ( b[i] = slider(30 + i); ch = 1; ); i += 1; );
