  b[6] = slider19; b[7] = slider20; b[8] = slider21; b[9] = slider22; b[10] = slider23;
);
function syn_sl_load() local(b, i) ( b = SYP + sel * 32; i = 1; loop(25, slider(30 + i) = b[i]; i += 1; ); );
function syn_sl_store() local(b, i, ch) (
  b = SYP + sel * 32; ch = 0; i = 1;
