lt = 3840;
RMD_MS = 1.2;
ACC_OV = 0.15; ACD_MS = 4; ACC_LV = 0.97;
ACC_CT = 6; ACC_DK = 1.12;
ACC_TR = 0.78;
LTRIM = 0.975;
SPRD = 3860;
SPRD[0] = 2.1; SPRD[1] = -1.4; SPRD[2] = 0.6; SPRD[3] = -2.8; SPRD[4] = 1.7; SPRD[5] = -0.5;
SPRD[6] = 3.0; SPRD[7] = -2.2; SPRD[8] = 0.9; SPRD[9] = -1.1; SPRD[10] = 2.5; SPRD[11] = -3.2;
dr_c = 0; dr_r = 1; sag = 0; sag_s = 1;
mdrift.drift_init(0.9);
function dcoef(ms) ( exp(-4.6 / (max(ms, 1) * 0.001 * srate)); );
function padfam(p) local(s) ( s = CHP[p * 16]; s == SYN ? TFAM[SYP[p * 32]] : RFAM[s]; );
function ch_choke() instance(act, ofam, chk) ( act && ofam == 5 ? chk = 1; );
function chokeall() (
  c0.ch_choke(); c1.ch_choke(); c2.ch_choke(); c3.ch_choke(); c4.ch_choke(); c5.ch_choke();
  c6.ch_choke(); c7.ch_choke(); c8.ch_choke(); c9.ch_choke(); c10.ch_choke(); c11.ch_choke();
);
function ch_go() instance(ci, act, ph, inc, iinc, bm, ibm, pos, dir, len, bas, held, eg, st, att, pt, d1, d2, chk, lv, pl, pr,
                          acx, acd, rm, pnd, pvel, snd, fin, slot, ofam) local(b, s, vq, acc, dk, rr, sl) (
  b = CHP + ci * 16; s = b[0]; snd = s;
  ofam = padfam(ci);
  ofam == 4 ? chokeall();
  vq = max(1, floor(pvel * 10 + 0.5)) / 10; acc = vq >= 1;
  s == SYN ? (
    sl = ci * 2 + UCUR[ci]; len = ULEN[sl]; bas = (era ? USR8 : USR) + sl * 65536; rr = URT[sl]; slot = sl;
  ) : (
    len = RLEN[s]; bas = (era ? ROM8 : ROM) + ROFF[s]; rr = RS; slot = -1;
  );
  dir = b[9] ? -1 : 1; pos = b[9] ? len : -1;
  ph = 0.5; held = 0; fin = 0;
  inc = 2 ^ ((b[1] + (SPRD[ci] * dm_a + dr_c + acc * ACC_CT) * 0.01) / 12) * max(rr, 1000) / srate; iinc = 1 / inc;
  bm = 2 ^ (b[8] / 25 / srate); ibm = 1 / bm;
  lv = (1 - velsens + velsens * vq) * sqr(b[2] / 100) * (1 + (rand(2) - 1) * 0.012 * dm_a) * LTRIM *
       (acc ? (1 + 1.4 * ac_a) * ACC_LV : 1 - 0.4 * ac_a) * ACC_TR;
  pl = sqrt(1 - b[3] / 100); pr = sqrt(1 + b[3] / 100);
  b[4] > 0 ? ( att = 1 / (b[4] * 0.001 * srate); st = 1; eg = 0; ) : ( st = 2; eg = 1; );
  dk = acc ? ACC_DK : 1;
  d1 = b[5] >= 4000 ? 1 : dcoef(b[5] * dk); pt = b[6] / 100; d2 = b[7] >= 4000 ? 1 : dcoef(b[7] * dk);
  acx = acc ? ACC_OV : 0; acd = exp(-1 / (ACD_MS * 0.001 * srate));
  chk = 0; pnd = 0; rm = 1; act = 1;
  sag += acc ? 0.18 : 0.08;
  lt[ci] = 1;
