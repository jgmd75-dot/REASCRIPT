ui_dflt = 1;

function dp_kit(k) local(b) (
  ed_load_dirty = 1;
  load_kit(k - 1);
  b = CHP + sel * 16;
  slider13 = b[0]; slider14 = b[1]; slider15 = b[2]; slider16 = b[3]; slider17 = b[4]; slider18 = b[5];
  slider19 = b[6]; slider20 = b[7]; slider21 = b[8]; slider22 = b[9]; slider23 = b[10];
  syn_sl_load_au();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(56, i != 56 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; dp_kit(k);
    k <= NKIT ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(NKIT, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( dp_kit(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
