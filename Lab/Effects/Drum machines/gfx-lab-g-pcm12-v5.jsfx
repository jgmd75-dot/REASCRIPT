);
function prow(p, r, str) local(i, c) (
  i = 0; loop(16, c = str_getchar(str, i); BANK[p * 192 + r * 16 + i] = c == 88 ? 2 : c == 120 ? 1 : 0; i += 1; );
);
function build_bank() (
  memset(BANK, 0, 15 * 192);
  prow(0, 0, "X.......X.x....."); prow(0, 1, "....X.......X..."); prow(0, 4, "x.x.x.x.x.x.x.x."); prow(0, 10, "X...............");
  prow(1, 0, "X..x..x...X..x.."); prow(1, 1, "....X..x.x..X..."); prow(1, 4, "xxXxxxXxxxXxxx.x"); prow(1, 5, "..............x.");
  prow(2, 0, "X.....X...X....."); prow(2, 3, "....X.......X..."); prow(2, 4, "x.x.x.x.x.x.x.x."); prow(2, 11, "..x..x....x..x..");
  prow(3, 0, "X...X...X...X..."); prow(3, 1, "....X.......X..."); prow(3, 4, "x...x...x...x..."); prow(3, 5, "..X...X...X...X.");
  prow(4, 0, "X.......x.X....."); prow(4, 1, "....X.......X..."); prow(4, 4, "x.x.x.x.x.x.x.x."); prow(4, 2, "..............x.");
  prow(5, 0, "X..............."); prow(5, 6, "X.x.x..........."); prow(5, 7, "......X.x.x....."); prow(5, 8, "............X.XX");
  prow(5, 10, "X...............");
  prow(6, 0, "X...X...X...X..."); prow(6, 3, "....X.......X..x"); prow(6, 11, "x.xx.x.xx.xx.x.x"); prow(6, 4, "..x...x...x...x.");
  prow(7, 0, "X......x..X....."); prow(7, 1, "....X.......X..."); prow(7, 4, "x.x.x.x.x.x.x.xx"); prow(7, 2, ".........x......");
  prow(8, 0, "X...X...X...X..."); prow(8, 3, "....X.......X..."); prow(8, 5, "..X...X...X...X."); prow(8, 4, "x...x...x...x...");
  prow(8, 11, "...x......x.....");
  prow(9, 0, "X..x...x.xX....."); prow(9, 1, "....X..x....X..."); prow(9, 4, "x.xxx.xxx.xxx.xx"); prow(9, 3, "....X.......X...");
  prow(10, 0, "X.....x.X.....x."); prow(10, 1, "....X.......X..."); prow(10, 4, "x.xx.xx.xx.xx.x.");
  prow(11, 0, "........X......."); prow(11, 2, "........X......."); prow(11, 4, "x.x.x.x.x.x.x.x."); prow(11, 5, "..............x.");
  prow(12, 0, "X...X...X...X..."); prow(12, 1, "....X.......X..."); prow(12, 3, "....X.......X..."); prow(12, 4, "xxXxxxXxxxXxxxXx");
  prow(13, 0, "X.X.......X....."); prow(13, 1, "....X..x.x..X..x"); prow(13, 4, "x.x.x.x.x.x.x.x."); prow(13, 10, "X...............");
  prow(14, 0, "X......xX......x"); prow(14, 2, "X..X..X...X.X..."); prow(14, 6, "......x.x.....x."); prow(14, 7, "x.......x.......");
  prow(14, 8, "...x.......x...."); prow(14, 11, "x.x.x.x.x.x.x.x.");
);
function pat_name(p) (
  p == 0 ? "80S ROCK" : p == 1 ? "FUNK" : p == 2 ? "ELECTRO" : p == 3 ? "DISCO" : p == 4 ? "GATED BALLAD" : p == 5 ? "TOM FILL" :
  p == 6 ? "CLAPS + BELL" : p == 7 ? "HIP HOP" : p == 8 ? "HOUSE" : p == 9 ? "NEW JACK" : p == 10 ? "SHUFFLE" : p == 11 ? "ONE DROP" :
  p == 12 ? "SYNTH POP" : p == 13 ? "BREAKBEAT" : p == 14 ? "LATIN" : "USER";
);
build_bank();
function export_midi() local(i) (
  i = 0; loop(192, gmem[10 + i] = PAT[slider26 * 192 + i]; i += 1; );
  i = 0; loop(NCH, gmem[300 + i] = CHP[i * 16 + 10]; i += 1; );
