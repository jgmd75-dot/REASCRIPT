  idx == 256 ? slider_automate(slider256);
);

// house style: knob values show only on hover / drag (a plugin may set ui_hovval = 0 to show them always)
ui_hovval = 1;

// ---------- colour ----------
function ui_col(c) (
  gfx_r = ((c >> 16) & 255) / 255; gfx_g = ((c >> 8) & 255) / 255; gfx_b = (c & 255) / 255; gfx_a = 1;
);
function ui_cola(c, a) ( ui_col(c); gfx_a = a; );

// ---------- house palette (named colours for any GFX panel) ----------
// whites
GFX_CHIFFON   = 0xEEEFEA;   // warm chiffon white (alt 0xF0F2EF)
GFX_CHIFFON2  = 0xF0F2EF;
GFX_ELEPHANT  = 0xC7BEB3;   // elephant's breath
GFX_COOLWHITE = 0xF4FDFF;   // cool white
GFX_CREAM     = 0xFFFDD0;   // cream white
GFX_LIMEWHITE = 0xE8E0CB;   // lime white
// greys (warm, light to dark)
GFX_GREY1 = 0xE3D8D8; GFX_GREY2 = 0xC1B5B5; GFX_GREY3 = 0xB2A4A4; GFX_GREY4 = 0xA99999; GFX_GREY5 = 0x9A8A8A;

// opposite hue of c at a fixed mid brightness; -1 if c is too grey to have a hue
function ui_hsvcomp(c) local(r, g, b, mx, mn, d, h, s, v, i, f, p, q, t) (
  r = ((c >> 16) & 255) / 255; g = ((c >> 8) & 255) / 255; b = (c & 255) / 255;
  mx = max(r, max(g, b)); mn = min(r, min(g, b)); d = mx - mn;
  s = mx > 0 ? d / mx : 0;
  s > 0.15 ? (
    h = mx == r ? (g - b) / d : mx == g ? 2 + (b - r) / d : 4 + (r - g) / d;
    h = h / 6 + 0.5; h -= floor(h);
    s = min(max(s, 0.45), 0.65); v = 0.55;
    i = floor(h * 6); f = h * 6 - i; p = v * (1 - s); q = v * (1 - f * s); t = v * (1 - (1 - f) * s);
    i == 0 ? ( r = v; g = t; b = p; ) : i == 1 ? ( r = q; g = v; b = p; ) : i == 2 ? ( r = p; g = v; b = t; ) :
    i == 3 ? ( r = p; g = q; b = v; ) : i == 4 ? ( r = t; g = p; b = v; ) : ( r = v; g = p; b = q; );
    floor(r * 255 + 0.5) * 65536 + floor(g * 255 + 0.5) * 256 + floor(b * 255 + 0.5);
  ) : -1;
);

// ---------- themes ----------
function ui_mix(c1, c2, t) (
  ((((c1 >> 16) & 255) * (1 - t) + ((c2 >> 16) & 255) * t) | 0) * 65536 +
  ((((c1 >> 8) & 255) * (1 - t) + ((c2 >> 8) & 255) * t) | 0) * 256 +
  (((c1 & 255) * (1 - t) + (c2 & 255) * t) | 0);
);
function ui_theme(t) (
  C_S6 = -1;
  t == 9 ? (        // Walnut: organ-cabinet wood, mahogany, brass
    C_BG = 0x1A120D; C_HDR = 0x120C08; C_TITLE = 0xF0E2C8; C_ACC = 0xC9A043; C_ACCH = 0xE2BD62;
    C_LABEL = 0xC8B293; C_VALUE = 0xF2E6D0; C_DIM = 0x3E2C20; C_STXT = 0x8F7A62;
