desc:GFX UI library (include)
//author: JGWizrad / Garden FX (GFX)
//
// Themes, S/M/L sizing and shared widgets for all GFX plugins.
//
// Usage in a plugin:
//   import gfx-ui.jsfx-inc
//   @serialize   file_var(0, ui_thm); file_var(0, ui_sz); file_var(0, ui_hw);
//   @gfx         ui_begin(base_w, base_h); ui_header("NAME"); ... ui_end();
//   Multiply all layout coordinates by sc.
//
// Font: Trebuchet MS (pre-installed on Windows and macOS).
// Globals: sc (scale), pressed, mdown, drag_id, knob_step,
//          knob_lblbtn (set to 1 before ui_knob: the label becomes a button; a click sets knob_lblclick = idx),
//          ui_kdesk (set to a cap colour before ui_knob: the C2M desk knob; ui_kdesk_p pointer colour, ui_kdesk_r size),
//          knob_push (set to a slider index before ui_knob: the GUARD LED button (ui_guard_tag)
//                     toggles that slider - used for TRIM / GUARD),
//          ui_thm (0 Amber, 1 Ice, 2 Studio, 3 Vintage, 4 Neon, 5 Graphite, 6 Bordeaux, 7 Saffron, 8 Petrol,
//                  9 Walnut, 10 Tolex, 11 Velvet, 12 Olive, 13 Frost, 14 Slate, 15 Ember, 16 Honey, 17 Mint, 18 Blossom),
//          ui_sz  (0 = M, 1 = S, 2 = L; new instances default to M),
//          ui_hw  (0 = flat look, 1 = hardware look).
// Hardware look: ui_group (coloured section panels), ui_screen (inset display window),
//                ui_vu (needle meter), ui_ledm (LED ladder with floating peak), ui_hw_toggle.
//                Knobs by section: main and MASTER = machined ring (light value ring and pointer),
//                DRIFT / INPUT / OUTPUT STAGE = small cap with halo (6a).
// Flat look: flat versions of the same (machined ring for main and MASTER, 6a).

@init

// ---------- host automation (bitmask covers sliders 1-63; higher sliders, up to 256, are passed by name) ----------
// ---------- supersampled shapes (knob pointers and other thin, angled shapes) ----------
// gfx_triangle is not anti-aliased and stacked 1 px lines change weight with the angle, so pointers looked uneven.
// These draw the shape 2x larger into an offscreen image (118) and blit it back at half size with filtering: an
// evenly smoothed shape at every angle (the way pre-rendered knob filmstrips are made). The image only grows, so a
// shape costs a clear, the drawing and one blit. Current colour and gfx_a; pixel coordinates.
// For a custom shape: ui_ss_begin(box), draw with ui_ssx() / ui_ssy() / ui_ssk() (2x), then ui_ss_end().
function ui_ss_begin(x0, y0, x1, y1) local(w2, h2) (
  ui_ss_d = gfx_dest; ui_ss_r = gfx_r; ui_ss_g = gfx_g; ui_ss_b = gfx_b; ui_ss_a = gfx_a; ui_ss_m = gfx_mode;
  ui_ss_x = floor(min(x0, x1)) - 1; ui_ss_y = floor(min(y0, y1)) - 1;
  ui_ss_w = min(ceil(max(x0, x1)) + 1 - ui_ss_x, 1000); ui_ss_h = min(ceil(max(y0, y1)) + 1 - ui_ss_y, 1000);
  w2 = ui_ss_w * 2; h2 = ui_ss_h * 2;
  (w2 > ui_ss_iw || h2 > ui_ss_ih) ? (
    ui_ss_iw = max(ui_ss_iw, max(w2, 256)); ui_ss_ih = max(ui_ss_ih, max(h2, 256)); gfx_setimgdim(118, ui_ss_iw, ui_ss_ih);
  );
  gfx_dest = 118; gfx_mode = 0;
  gfx_a = 1; gfx_a2 = 0; gfx_rect(0, 0, w2, h2);
  gfx_r = ui_ss_r; gfx_g = ui_ss_g; gfx_b = ui_ss_b; gfx_a = 1; gfx_a2 = 1;
);
function ui_ssx(x) ( (x - ui_ss_x) * 2; );
function ui_ssy(y) ( (y - ui_ss_y) * 2; );
function ui_ssk(k) ( k * 2; );
function ui_ss_end() (
  gfx_dest = ui_ss_d; gfx_mode = ui_ss_m; gfx_a = ui_ss_a;
  gfx_blit(118, 1, 0, 0, 0, ui_ss_w * 2, ui_ss_h * 2, ui_ss_x, ui_ss_y, ui_ss_w, ui_ss_h);
  gfx_r = ui_ss_r; gfx_g = ui_ss_g; gfx_b = ui_ss_b; gfx_a = ui_ss_a;
);
// a line of width w (pixels) from (x1, y1) to (x2, y2); rnd = 1: round ends
function ui_ssline(x1, y1, x2, y2, w, rnd) local(k, a, b, c, d, dx, dy, l, nx, ny) (
  k = max(w, 0.6) * 0.5;
  // square-ended and exactly horizontal / vertical: no stepping to smooth, draw it directly
  !rnd && (abs(x1 - x2) < 0.001 || abs(y1 - y2) < 0.001) ? (
    abs(y1 - y2) < 0.001 ? gfx_rect(min(x1, x2), y1 - k, abs(x2 - x1), 2 * k) : gfx_rect(x1 - k, min(y1, y2), 2 * k, abs(y2 - y1));
  ) : (
  k = k;
  ui_ss_begin(min(x1, x2) - k, min(y1, y2) - k, max(x1, x2) + k, max(y1, y2) + k);
  a = ui_ssx(x1); b = ui_ssy(y1); c = ui_ssx(x2); d = ui_ssy(y2); k = ui_ssk(k);
  dx = c - a; dy = d - b; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l * k; ny = dx / l * k;
  gfx_triangle(a + nx, b + ny, c + nx, d + ny, c - nx, d - ny, a - nx, b - ny);
  rnd ? ( gfx_circle(a, b, k, 1, 0); gfx_circle(c, d, k, 1, 0); );
  ui_ss_end();
  );
);
// a ring segment (knob value rings, meter scale arcs): radius r to the middle of the band, width w (pixels),
// angles as gfx_arc (0 = up, clockwise). Built from fine quads at 2x and filtered down: an even band at every angle.
function ui_ssarc(cx, cy, r, a1, a2, w) local(t, n, i, d, ta, tb, ri, ro, x0, y0, x1, y1) (
  a1 > a2 ? ( t = a1; a1 = a2; a2 = t; );
  a2 - a1 > 0.0005 && w > 0 ? (
    ri = r - w * 0.5; ro = r + w * 0.5;
    // the box: the arc's ends plus any of the four extremes it passes
    x0 = min(cx + sin(a1) * ro, cx + sin(a2) * ro); x1 = max(cx + sin(a1) * ro, cx + sin(a2) * ro);
    y0 = min(cy - cos(a1) * ro, cy - cos(a2) * ro); y1 = max(cy - cos(a1) * ro, cy - cos(a2) * ro);
    x0 = min(x0, min(cx + sin(a1) * ri, cx + sin(a2) * ri)); x1 = max(x1, max(cx + sin(a1) * ri, cx + sin(a2) * ri));
    y0 = min(y0, min(cy - cos(a1) * ri, cy - cos(a2) * ri)); y1 = max(y1, max(cy - cos(a1) * ri, cy - cos(a2) * ri));
    i = -2; loop(5, t = i * 0.5 * $pi;
      t >= a1 && t <= a2 ? ( x0 = min(x0, cx + sin(t) * ro); x1 = max(x1, cx + sin(t) * ro); y0 = min(y0, cy - cos(t) * ro); y1 = max(y1, cy - cos(t) * ro); );
      i += 1; );
    ui_ss_begin(x0, y0, x1, y1);
    // segments ~6 px long (within 0.15 px of the true circle); sin / cos stepped by rotation, the 2x coordinates
    // worked out once per corner
    n = max(3, ceil((a2 - a1) * ro / 6)); d = (a2 - a1) / n;
    ta = sin(a1); tb = cos(a1); t = sin(d); x1 = cos(d);
    cx = ui_ssx(cx); cy = ui_ssy(cy); ri *= 2; ro *= 2;
    x0 = cx + ta * ri; y0 = cy - tb * ri; i = cx + ta * ro; y1 = cy - tb * ro;
    loop(n,
      d = ta * x1 + tb * t; tb = tb * x1 - ta * t; ta = d;
      d = cx + ta * ro; w = cy - tb * ro;
      gfx_triangle(x0, y0, i, y1, d, w, cx + ta * ri, cy - tb * ri);
      x0 = cx + ta * ri; y0 = cy - tb * ri; i = d; y1 = w;
    );
    ui_ss_end();
  );
);
// a filled convex quad / triangle (pixel coordinates)
function ui_ssquad(x1, y1, x2, y2, x3, y3, x4, y4) (
  ui_ss_begin(min(min(x1, x2), min(x3, x4)), min(min(y1, y2), min(y3, y4)), max(max(x1, x2), max(x3, x4)), max(max(y1, y2), max(y3, y4)));
  gfx_triangle(ui_ssx(x1), ui_ssy(y1), ui_ssx(x2), ui_ssy(y2), ui_ssx(x3), ui_ssy(y3), ui_ssx(x4), ui_ssy(y4));
  ui_ss_end();
);
function ui_sstri(x1, y1, x2, y2, x3, y3) (
  ui_ss_begin(min(min(x1, x2), x3), min(min(y1, y2), y3), max(max(x1, x2), x3), max(max(y1, y2), y3));
  gfx_triangle(ui_ssx(x1), ui_ssy(y1), ui_ssx(x2), ui_ssy(y2), ui_ssx(x3), ui_ssy(y3));
  ui_ss_end();
);

// ---------- text with arrow symbols ----------
// ◄ ► ▲ ▼ ↔ in a label are drawn as shapes in the current colour, not as font characters: Trebuchet MS has none of
// them and only some systems borrow them from another font - the rest showed an empty box. ui_symw(s) = the width
// (ui_symh = the line height); ui_symstr(s) draws at gfx_x / gfx_y like gfx_drawstr. Plain labels go straight through.
function ui_symb(s, i) ( (str_getchar(s, i) + 256) % 256; );    // the byte, 0 - 255 (signed or not)
function ui_symk(s, i) local(d) (
  ui_symb(s, i) == 0xE2 ? ( d = ui_symb(s, i + 1) * 256 + ui_symb(s, i + 2);
    d == 0x9784 ? 1 : d == 0x96BA ? 2 : d == 0x96B2 ? 3 : d == 0x96BC ? 4 : d == 0x8694 ? 5 : 0; ) : 0;
);
function ui_sym(s, draw) local(n, i, a, k, w, tw, th, q, sw, x, cy) (
  n = strlen(s); i = 0; a = 0; w = 0;
  gfx_measurestr("Ag", tw, ui_symh); q = ui_symh * 0.26;
  while (i <= n) (
    k = i + 2 < n ? ui_symk(s, i) : 0;
    k || i == n ? (
      i > a ? ( strcpy_substr(#ui_symt, s, a, i - a); gfx_measurestr(#ui_symt, tw, th); w += tw; draw ? gfx_drawstr(#ui_symt); );
      k ? (
        sw = k == 5 ? q * 4.6 : q * 2.8; w += sw;
        draw ? (
          x = gfx_x + sw * 0.5; cy = gfx_y + ui_symh * 0.53;
          k == 1 ? ui_sstri(x - q * 0.9, cy, x + q * 0.9, cy - q, x + q * 0.9, cy + q);
          k == 2 ? ui_sstri(x + q * 0.9, cy, x - q * 0.9, cy - q, x - q * 0.9, cy + q);
          k == 3 ? ui_sstri(x, cy - q * 0.9, x - q, cy + q * 0.9, x + q, cy + q * 0.9);
          k == 4 ? ui_sstri(x, cy + q * 0.9, x - q, cy - q * 0.9, x + q, cy - q * 0.9);
          k == 5 ? ( ui_ssline(x - q * 1.4, cy, x + q * 1.4, cy, max(1, q * 0.3), 0);
                     ui_sstri(x - q * 2.1, cy, x - q * 1.2, cy - q * 0.75, x - q * 1.2, cy + q * 0.75);
                     ui_sstri(x + q * 2.1, cy, x + q * 1.2, cy - q * 0.75, x + q * 1.2, cy + q * 0.75); );
          gfx_x += sw;
        );
        i += 3; a = i;
      ) : i += 1;
    ) : i += 1;
  );
  w;
);
function ui_symw(s) ( ui_sym(s, 0); );
function ui_symstr(s) ( ui_sym(s, 1); );

function ui_auto(idx) (
  idx <= 63 ? slider_automate(2 ^ (idx - 1)) :
  idx == 64 ? slider_automate(slider64) : idx == 65 ? slider_automate(slider65) :
  idx == 66 ? slider_automate(slider66) : idx == 67 ? slider_automate(slider67) :
  idx == 68 ? slider_automate(slider68) : idx == 69 ? slider_automate(slider69) :
  idx == 70 ? slider_automate(slider70) : idx == 71 ? slider_automate(slider71) :
  idx == 72 ? slider_automate(slider72) : idx == 73 ? slider_automate(slider73) :
  idx == 74 ? slider_automate(slider74) : idx == 75 ? slider_automate(slider75) :
  idx == 76 ? slider_automate(slider76) : idx == 77 ? slider_automate(slider77) :
  idx == 78 ? slider_automate(slider78) : idx == 79 ? slider_automate(slider79) :
  idx == 80 ? slider_automate(slider80) : idx == 81 ? slider_automate(slider81) :
  idx == 82 ? slider_automate(slider82) : idx == 83 ? slider_automate(slider83) :
