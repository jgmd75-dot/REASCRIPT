  idx == 116 ? slider_automate(slider116) : idx == 117 ? slider_automate(slider117) :
  idx == 118 ? slider_automate(slider118) : idx == 119 ? slider_automate(slider119) :
  idx == 120 ? slider_automate(slider120) : idx == 121 ? slider_automate(slider121) :
