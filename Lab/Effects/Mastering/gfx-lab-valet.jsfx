desc:VALET [mastering EQ] (GFX Lab)
//tags: equaliser mastering EQ stepped switched parallel mid side M/S high-pass low-pass recall stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Off,On}>-Bypass
slider2:4<0,4,1{2,1.4,1,0.7,Shelf}>-Ch 1 (L / M) low Q
slider3:6<0,17,1{22 Hz,27.5 Hz,33 Hz,38.5 Hz,44 Hz,49.5 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz,137.5 Hz,165 Hz,192.5 Hz,220 Hz,275 Hz,330 Hz}>-Ch 1 (L / M) low frequency
slider4:0<-5.5,5.5,0.5>-Ch 1 (L / M) low gain (dB)
slider5:1<0,1,1{Out,In}>-Ch 1 (L / M) low in
slider6:3<0,5,1{2.8,2,1.4,1,0.7,0.5}>-Ch 1 (L / M) low mid Q
slider7:6<0,17,1{110 Hz,137.5 Hz,165 Hz,192.5 Hz,220 Hz,275 Hz,330 Hz,385 Hz,440 Hz,495 Hz,550 Hz,660 Hz,770 Hz,880 Hz,990 Hz,1.1 kHz,1.375 kHz,1.65 kHz}>-Ch 1 (L / M) low mid frequency
slider8:0<-5.5,5.5,0.5>-Ch 1 (L / M) low mid gain (dB)
slider9:1<0,1,1{Out,In}>-Ch 1 (L / M) low mid in
slider10:3<0,5,1{2.8,2,1.4,1,0.7,0.5}>-Ch 1 (L / M) high mid Q
slider11:11<0,17,1{440 Hz,495 Hz,550 Hz,660 Hz,770 Hz,880 Hz,990 Hz,1.1 kHz,1.375 kHz,1.65 kHz,1.925 kHz,2.2 kHz,2.75 kHz,3.3 kHz,3.85 kHz,4.4 kHz,4.95 kHz,5.5 kHz}>-Ch 1 (L / M) high mid frequency
slider12:0<-5.5,5.5,0.5>-Ch 1 (L / M) high mid gain (dB)
slider13:1<0,1,1{Out,In}>-Ch 1 (L / M) high mid in
slider14:4<0,4,1{2,1.4,1,0.7,Shelf}>-Ch 1 (L / M) high Q
slider15:11<0,17,1{1.65 kHz,1.925 kHz,2.2 kHz,2.75 kHz,3.3 kHz,3.85 kHz,4.4 kHz,4.95 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,13.75 kHz,16.5 kHz,19.25 kHz,22 kHz}>-Ch 1 (L / M) high frequency
slider16:0<-5.5,5.5,0.5>-Ch 1 (L / M) high gain (dB)
slider17:1<0,1,1{Out,In}>-Ch 1 (L / M) high in
slider18:4<0,4,1{2,1.4,1,0.7,Shelf}>-Ch 2 (R / S) low Q
slider19:6<0,17,1{22 Hz,27.5 Hz,33 Hz,38.5 Hz,44 Hz,49.5 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz,137.5 Hz,165 Hz,192.5 Hz,220 Hz,275 Hz,330 Hz}>-Ch 2 (R / S) low frequency
slider20:0<-5.5,5.5,0.5>-Ch 2 (R / S) low gain (dB)
slider21:1<0,1,1{Out,In}>-Ch 2 (R / S) low in
slider22:3<0,5,1{2.8,2,1.4,1,0.7,0.5}>-Ch 2 (R / S) low mid Q
slider23:6<0,17,1{110 Hz,137.5 Hz,165 Hz,192.5 Hz,220 Hz,275 Hz,330 Hz,385 Hz,440 Hz,495 Hz,550 Hz,660 Hz,770 Hz,880 Hz,990 Hz,1.1 kHz,1.375 kHz,1.65 kHz}>-Ch 2 (R / S) low mid frequency
slider24:0<-5.5,5.5,0.5>-Ch 2 (R / S) low mid gain (dB)
slider25:1<0,1,1{Out,In}>-Ch 2 (R / S) low mid in
slider26:3<0,5,1{2.8,2,1.4,1,0.7,0.5}>-Ch 2 (R / S) high mid Q
slider27:11<0,17,1{440 Hz,495 Hz,550 Hz,660 Hz,770 Hz,880 Hz,990 Hz,1.1 kHz,1.375 kHz,1.65 kHz,1.925 kHz,2.2 kHz,2.75 kHz,3.3 kHz,3.85 kHz,4.4 kHz,4.95 kHz,5.5 kHz}>-Ch 2 (R / S) high mid frequency
slider28:0<-5.5,5.5,0.5>-Ch 2 (R / S) high mid gain (dB)
slider29:1<0,1,1{Out,In}>-Ch 2 (R / S) high mid in
slider30:4<0,4,1{2,1.4,1,0.7,Shelf}>-Ch 2 (R / S) high Q
slider31:11<0,17,1{1.65 kHz,1.925 kHz,2.2 kHz,2.75 kHz,3.3 kHz,3.85 kHz,4.4 kHz,4.95 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,13.75 kHz,16.5 kHz,19.25 kHz,22 kHz}>-Ch 2 (R / S) high frequency
slider32:0<-5.5,5.5,0.5>-Ch 2 (R / S) high gain (dB)
slider33:1<0,1,1{Out,In}>-Ch 2 (R / S) high in
slider34:0<0,16,1{Off,11 Hz,13.75 Hz,16.5 Hz,19.25 Hz,22 Hz,27.5 Hz,33 Hz,38.5 Hz,44 Hz,49.5 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz}>-Ch 1 (L / M) high-pass
slider35:10<0,10,1{5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,13.75 kHz,16.5 kHz,19.25 kHz,22 kHz,Off}>-Ch 1 (L / M) low-pass
slider36:0<0,16,1{Off,11 Hz,13.75 Hz,16.5 Hz,19.25 Hz,22 Hz,27.5 Hz,33 Hz,38.5 Hz,44 Hz,49.5 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz}>-Ch 2 (R / S) high-pass
slider37:10<0,10,1{5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,13.75 kHz,16.5 kHz,19.25 kHz,22 kHz,Off}>-Ch 2 (R / S) low-pass
slider38:0<-5.5,5.5,0.5>-Ch 1 (L / M) output (dB)
slider39:0<-5.5,5.5,0.5>-Ch 2 (R / S) output (dB)
slider40:0<0,1,1{Left / Right,Mid / Side}>-Mode
slider41:1<0,1,1{Off,On}>-Link
slider42:0<0,1,1{Off,On}>-Delta
slider43:0<0,1,1{A,B}>-Memory
slider44:prs_sel=0<0,10,1{No preset,Init,Gentle Air,Warm Glow,Clear the Mud,Presence,Smooth Top,Low End Lift,MS Mono Bass,MS Wide Top,MS Centre Focus}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-valet";
ext_noinit = 1;

function vl_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function vl_lad(i) local(d, m) (
  d = floor(i / 15); m = i - d * 15;
  m = m == 0 ? 1 : m == 1 ? 1.25 : m == 2 ? 1.5 : m == 3 ? 1.75 : m == 4 ? 2 : m == 5 ? 2.5 : m == 6 ? 3 : m == 7 ? 3.5 :
      m == 8 ? 4 : m == 9 ? 4.5 : m == 10 ? 5 : m == 11 ? 6 : m == 12 ? 7 : m == 13 ? 8 : 9;
  11 * m * 10 ^ d;
);
function vl_bst(b) ( b == 0 ? 4 : b == 1 ? 15 : b == 2 ? 23 : 32; );
function vl_bq(b, i) (
  b == 0 || b == 3 ? ( i < 0.5 ? 2 : i < 1.5 ? 1.4 : i < 2.5 ? 1 : i < 3.5 ? 0.7 : 0; )
                   : ( i < 0.5 ? 2.8 : i < 1.5 ? 2 : i < 2.5 ? 1.4 : i < 3.5 ? 1 : i < 4.5 ? 0.7 : 0.5; );
);

BND = 100000; BS = 24;
FLT = 101000; FS = 16;
function vl_btick(p) local(f, g, a, k) (
  p[19] = p[17] == p[13];
  p[11] < 0.0005 && p[17] != p[13] ? ( p[13] = p[17]; p[0] = p[1] = 0; p[8] = p[14]; p[9] = p[16]; p[10] = p[15]; );
  p[11] < 0.0005 && p[12] < 0.5 ? ( p[8] = p[14]; p[9] = p[16]; p[10] = p[15]; );
  p[8] += vl_kc * (p[14] - p[8]); p[9] += vl_kc * (p[16] - p[9]); p[10] += vl_kc * (p[15] - p[10]);
  f = min(2 ^ p[8], vl_fmax); g = tan($pi * f / srate);
  p[13] == 0 ? (
    k = 1 / max(p[9], 0.3); p[5] = 0; p[6] = (exp(p[10] * 0.11512925464970228) - 1) * k; p[7] = 0;
  ) : (
    a = exp(p[10] * 0.05756462732485115); k = 1.4142135623730951;
    p[13] == 1 ? ( g /= sqrt(a); p[5] = 0; p[6] = k * (a - 1); p[7] = a * a - 1; )
               : ( g *= sqrt(a); p[5] = a * a - 1; p[6] = k * (1 - a) * a; p[7] = 1 - a * a; );
  );
  p[2] = 1 / (1 + g * (g + k)); p[3] = g * p[2]; p[4] = g * p[3];
);
function vl_bands(x, c) local(p, v1, v2, v3, y) (
  y = x; p = BND + c * 4 * BS;
  loop(4,
    p[11] += vl_kw * (p[12] * p[19] - p[11]);
    v3 = x - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
    p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
    y += p[11] * (p[5] * x + p[6] * v1 + p[7] * v2);
    p += BS;
  );
  y;
);
function vl_ftick(p, hp) local(g, k) (
  p[8] < 0.0005 ? p[6] = p[7];
  p[6] += vl_kc * (p[7] - p[6]);
  g = tan($pi * min(2 ^ p[6], vl_fmax) / srate); k = 1.4142135623730951;
  p[2] = 1 / (1 + g * (g + k)); p[3] = g * p[2]; p[4] = g * p[3];
);
function vl_flt(x, p, hp) local(v1, v2, v3, y) (
  p[8] += vl_ks * (p[9] - p[8]);
  v3 = x - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
  p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
  y = hp ? x - 1.4142135623730951 * v1 - v2 : v2;
  x + p[8] * (y - x);
);
function vl_clr() local(i) (
  i = 0; loop(8, BND[i * BS] = BND[i * BS + 1] = 0; i += 1; );
  i = 0; loop(4, FLT[i * FS] = FLT[i * FS + 1] = 0; i += 1; );
);
function vl_dn() local(i) (
  i = 0; loop(8, BND[i * BS] = vl_tn(BND[i * BS]); BND[i * BS + 1] = vl_tn(BND[i * BS + 1]); i += 1; );
  i = 0; loop(4, FLT[i * FS] = vl_tn(FLT[i * FS]); FLT[i * FS + 1] = vl_tn(FLT[i * FS + 1]); i += 1; );
);
function vl_targets() local(c, b, p, s, q) (
  c = 0;
  loop(2,
    b = 0;
    loop(4,
      p = BND + (c * 4 + b) * BS; s = 2 + c * 16 + b * 4;
      q = vl_bq(b, floor(min(max(slider(s), 0), 5) + 0.5));
      p[14] = log(vl_lad(vl_bst(b) + floor(min(max(slider(s + 1), 0), 17) + 0.5))) / log(2);
      p[15] = floor(min(max(slider(s + 2), -5.5), 5.5) * 2 + 0.5) / 2;
      p[16] = q > 0 ? q : 0.7071;
      p[17] = q > 0 ? 0 : b == 0 ? 1 : 2;
      p[12] = slider(s + 3) >= 0.5;
      b += 1;
    );
    s = floor(min(max(slider(34 + c * 2), 0), 16) + 0.5);
    p = FLT + c * 2 * FS; s > 0 ? p[7] = log(vl_lad(s - 1)) / log(2); p[9] = s > 0;
    s = floor(min(max(slider(35 + c * 2), 0), 10) + 0.5);
    p = FLT + (c * 2 + 1) * FS; s < 10 ? p[7] = log(vl_lad(40 + s)) / log(2); p[9] = s < 10;
    c += 1;
  );
  vl_ogt0 = exp(floor(min(max(slider38, -5.5), 5.5) * 2 + 0.5) / 2 * 0.11512925464970228);
  vl_ogt1 = exp(floor(min(max(slider39, -5.5), 5.5) * 2 + 0.5) / 2 * 0.11512925464970228);
  vl_mst = slider40 >= 0.5;
  vl_dmt = slider42 >= 0.5;
);
function vl_snapall() local(i, p) (
  i = 0; loop(8, p = BND + i * BS; p[8] = p[14]; p[9] = p[16]; p[10] = p[15]; p[13] = p[17]; p[19] = 1; p[11] = p[12]; vl_btick(p); i += 1; );
  i = 0; loop(4, p = FLT + i * FS; p[6] = p[7]; p[8] = p[9]; vl_ftick(p, (i & 1) == 0); i += 1; );
  vl_og0 = vl_ogt0; vl_og1 = vl_ogt1; vl_msc = vl_mst; vl_dk = 1; vl_dm = vl_dmt;
);

MEMA = 102000; MEMB = 102064;
function vl_save(m) local(i) ( i = 0; loop(38, m[i] = slider(2 + i); i += 1; ); );
function vl_load(m) local(i) ( i = 0; loop(38, slider(2 + i) = m[i]; slider_automate(2 ^ (1 + i)); i += 1; ); );
function vl_link() local(i, ch) (
  ch = 0; i = 0;
  loop(16, slider(18 + i) != slider(2 + i) ? ( slider(18 + i) = slider(2 + i); slider_automate(2 ^ (17 + i)); ); i += 1; );
  slider36 != slider34 ? ( slider36 = slider34; slider_automate(slider36); );
  slider37 != slider35 ? ( slider37 = slider35; slider_automate(slider37); );
  slider39 != slider38 ? ( slider39 = slider38; slider_automate(slider39); );
);
function vl_mem() local(n) (
  !vl_abok ? ( vl_save(MEMA); vl_save(MEMB); vl_abok = 1; vl_abcur = slider43 >= 0.5; );
  ab_dirty == 3 ? ( ab_dirty = 0; vl_save(vl_abcur ? MEMA : MEMB); );
  n = slider43 >= 0.5;
  n != vl_abcur ? ( vl_save(vl_abcur ? MEMB : MEMA); vl_load(n ? MEMB : MEMA); vl_abcur = n; );
);

#vl_pm = "Init|Gentle Air|Warm Glow|Clear the Mud|Presence|Smooth Top|Low End Lift|MS Mono Bass|MS Wide Top|MS Centre Focus";
function vl_pb(c, b, q, f, g, on) local(s) ( s = 2 + c * 16 + b * 4; slider(s) = q; slider(s + 1) = f; slider(s + 2) = g; slider(s + 3) = on; );
function vl_flat(c) ( vl_pb(c, 0, 4, 6, 0, 1); vl_pb(c, 1, 3, 6, 0, 1); vl_pb(c, 2, 3, 11, 0, 1); vl_pb(c, 3, 4, 11, 0, 1);
  slider(34 + c * 2) = 0; slider(35 + c * 2) = 10; slider(38 + c) = 0; );
function vl_cp() local(i) ( i = 0; loop(16, slider(18 + i) = slider(2 + i); i += 1; ); slider36 = slider34; slider37 = slider35; slider39 = slider38; );
function load_preset(p) local(i) (
  vl_flat(0); vl_flat(1); slider40 = 0; slider41 = 1;
  p == 2 ? (            vl_pb(0, 1, 3,  6, -0.5, 1); vl_pb(0, 3, 4, 14,  1.5, 1); vl_cp(); ) :
  p == 3 ? ( vl_pb(0, 0, 4,  8,  1.5, 1); vl_pb(0, 2, 3, 12, -1,   1); vl_pb(0, 3, 4, 12, -0.5, 1); vl_cp(); ) :
  p == 4 ? ( vl_pb(0, 0, 4,  5,  0.5, 1); vl_pb(0, 1, 2,  5, -2,   1); slider34 = 5; vl_cp(); ) :
  p == 5 ? ( vl_pb(0, 2, 4, 13,  1.5, 1); vl_pb(0, 3, 4, 13,  1,   1); vl_cp(); ) :
  p == 6 ? ( vl_pb(0, 2, 1, 14, -1.5, 1); vl_pb(0, 3, 4, 15, -1,   1); slider35 = 7; vl_cp(); ) :
  p == 7 ? ( vl_pb(0, 0, 2,  6,  2,   1); vl_pb(0, 1, 3,  3, -1,   1); slider34 = 6; vl_cp(); ) :
  p == 8 ? ( slider40 = 1; slider41 = 0; vl_pb(0, 0, 4,  7, 0.5, 1); slider36 = 16; slider34 = 2; ) :
  p == 9 ? ( slider40 = 1; slider41 = 0; vl_pb(0, 2, 4, 11, 0.5, 1); vl_pb(1, 1, 3,  6, -1, 1);
             vl_pb(1, 3, 4, 11, 2, 1); slider36 = 11; ) :
  p == 10 ? ( slider40 = 1; slider41 = 0; vl_pb(0, 2, 4, 9, 1, 1); vl_pb(1, 0, 4, 11, -2, 1);
             slider36 = 13; slider(39) = -1; );
  i = 2; loop(40, slider_automate(2 ^ (i - 1)); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function vl_srinit() (
  vl_sr = srate;
  vl_kc = 1 - exp(-16 / (0.03 * srate));
  vl_kw = 1 - exp(-1 / (0.008 * srate));
  vl_ks = 1 - exp(-1 / (0.012 * srate));
  vl_ko = 1 - exp(-1 / (0.03 * srate));
  vl_kd = 1 - exp(-1 / (0.015 * srate));
  vl_dks = 1 / (0.006 * srate);
  vl_fmax = 0.45 * srate; vl_fis = 1 / (0.01 * srate);
  ost_init(0);
  vl_clr();
);
vl_srinit();
vl_targets(); vl_snapall(); vl_fi = 1;
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(44, i != 44 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) != 0 ? ( file_var(0, vl_abok); file_var(0, vl_abcur); file_mem(0, MEMA, 128); );

@block
prs_chk();
srate != vl_sr ? ( vl_srinit(); vl_targets(); vl_snapall(); );
vl_now = time_precise();
vl_tp > 0 && vl_now - vl_tp > max(0.25, 4 * samplesblock / srate) ? ( vl_clr(); vl_fi = 0; );
vl_tp = vl_now;
vl_mem();
slider41 >= 0.5 ? vl_link();
vl_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
vl_dn();
vl_ol_d = max(vl_ol_d, vl_ol); vl_or_d = max(vl_or_d, vl_or); vl_ol = vl_or = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
vl_xl = spl0; vl_xr = spl1;
(vl_cn -= 1) <= 0 ? (
  vl_cn = 16;
  vl_i = 0; loop(8, vl_btick(BND + vl_i * BS); vl_i += 1; );
  vl_i = 0; loop(4, vl_ftick(FLT + vl_i * FS, (vl_i & 1) == 0); vl_i += 1; );
);
vl_mst != vl_msc ? ( vl_dk = max(vl_dk - vl_dks, 0); vl_dk <= 0 ? ( vl_msc = vl_mst; vl_clr(); ); ) : vl_dk = min(vl_dk + vl_dks, 1);
vl_og0 += vl_ko * (vl_ogt0 - vl_og0); vl_og1 += vl_ko * (vl_ogt1 - vl_og1); vl_dm += vl_kd * (vl_dmt - vl_dm);
vl_msc ? ( vl_a = 0.5 * (vl_xl + vl_xr); vl_b = 0.5 * (vl_xl - vl_xr); ) : ( vl_a = vl_xl; vl_b = vl_xr; );
vl_a = vl_flt(vl_flt(vl_a, FLT, 1), FLT + FS, 0);
vl_b = vl_flt(vl_flt(vl_b, FLT + 2 * FS, 1), FLT + 3 * FS, 0);
vl_a = vl_bands(vl_a, 0) * vl_og0;
vl_b = vl_bands(vl_b, 1) * vl_og1;
vl_msc ? ( vl_yl = vl_a + vl_b; vl_yr = vl_a - vl_b; ) : ( vl_yl = vl_a; vl_yr = vl_b; );
vl_yl -= vl_dm * vl_xl; vl_yr -= vl_dm * vl_xr;
vl_z = vl_dk * vl_dk * (3 - 2 * vl_dk); vl_yl *= vl_z; vl_yr *= vl_z;
vl_yl != vl_yl ? vl_yl = 0; vl_yr != vl_yr ? vl_yr = 0;
vl_fi < 1 ? (
  vl_fi = min(vl_fi + vl_fis, 1); vl_z = vl_fi * vl_fi * (3 - 2 * vl_fi);
  vl_yl = vl_xl + vl_z * (vl_yl - vl_xl); vl_yr = vl_xr + vl_z * (vl_yr - vl_xr);
);
ost_out(vl_yl, vl_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
vl_ol = max(vl_ol, abs(spl0)); vl_or = max(vl_or, abs(spl1));

@gfx 1200 520
ui_begin(1200, 520);
VGP = 0xEEEFEA; VGS = 0xF6F7F3; VGH = 0xDCDDD4; VGW = 0xA9AAA1; VGI = 0x26272A; VGI2 = 0x75776F; VGA = 0x9A5800;
VGR = 0x2B2E32;
