    i += 1; );
);

function mg_cd(nr, ni, dr, di) local(d) ( d = dr * dr + di * di; mg_qr = (nr * dr + ni * di) / d; mg_qi = (ni * dr - nr * di) / d; );
function mg_cm(br, bi) local(t) ( t = mg_ar * br - mg_ai * bi; mg_ai = mg_ar * bi + mg_ai * br; mg_ar = t; );
function mg_resp(f) local(w, o, n, j, k, m, ir, ii, ur, ui, gk, tr, ti, lis) (
  w = tan($pi * min(f, 0.4999 * srate) / srate);
  ir = 1; ii = 0; ur = 1; ui = 0; lis = 0; tr = 0; ti = 0;
  slider2 >= 0.5 ? (
    o = w / tan($pi * slider3 / srate); n = floor(slider4 + 0.5) + 1;
    mg_ar = 1; mg_ai = 0;
    j = 0; loop(floor(n / 2), k = mg_bk(n, j); mg_cd(-o * o, 0, 1 - o * o, k * o); mg_cm(mg_qr, mg_qi); j += 1; );
    n & 1 ? ( mg_cd(0, o, 1, o); mg_cm(mg_qr, mg_qi); );
    mu_bdb_d > 0.05 ? (
      o = w / tan($pi * min(1.6 * slider3, 0.45 * srate) / srate); gk = (10 ^ (mu_bdb_d / 20) - 1) * 1.25;
      mg_cd(0, o, 1 - o * o, 1.25 * o); mg_cm(1 + gk * mg_qr, gk * mg_qi);
    );
    m = slider5 / 100; ir = 1 + m * (mg_ar - 1); ii = m * mg_ai;
    slider6 >= 0.5 ? ( lis = 1; tr = 1 - ir; ti = -ii; );
  );
  slider11 >= 0.5 ? (
    o = w / tan($pi * min(slider12 * 1000, 0.49 * srate) / srate); n = mg_uord(floor(slider13 + 0.5));
    mg_ar = 1; mg_ai = 0;
    j = 0; loop(n / 2, k = mg_bk(n, j); mg_cd(1, 0, 1 - o * o, k * o); mg_cm(mg_qr, mg_qi); j += 1; );
    m = slider14 / 100; ur = 1 + m * (mg_ar - 1); ui = m * mg_ai;
    slider15 >= 0.5 ? ( lis = 1; tr += 1 - ur; ti -= ui; );
  );
  lis ? ( mg_lis = 1; ) : ( tr = ir * ur - ii * ui; ti = ir * ui + ii * ur; );
  m = sqrt(tr * tr + ti * ti);
  m > 0.00001 ? 20 * log10(m) : -100;
);

