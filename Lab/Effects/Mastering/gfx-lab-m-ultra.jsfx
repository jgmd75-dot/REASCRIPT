    v5_pr && v5_drag == 0 && v5_hit(x + i * 20, y, 20, 18) ? (
      i == 0 ? ui_sz = 1 : i == 1 ? ui_sz = 0 : i == 2 ? ui_sz = 2 : ( ui_help_open = 1; ui_help_new = 1; );
