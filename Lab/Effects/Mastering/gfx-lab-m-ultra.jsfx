function mg_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = 10; sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 36, 26) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
  v5_pr && v5_drag == 0 && v5_hit(x + 40, y, 36, 26) ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; v5_drag = -1; );
  mg_arrkey(x, y, 36, 26, -1); mg_arrkey(x + 40, y, 36, 26, 1);
  gx = x + 86; mg_glass(gx, y + 2, w - 86, 22);
  cur >= 1 && cur <= n ? pk_pitem(#mu_pm, cur, #mg_pl) : strcpy(#mg_pl, "--");
  mg_fc(16); ui_col(0x15180F); mg_tl(gx + 9, y + 13.5, #mg_pl);
  v5_pr && v5_drag == 0 && v5_hit(gx, y + 2, w - 86, 22) ? ( open = 1; v5_drag = -1; );
  open ? (
    strcpy(#mg_pmm, ""); i = 1;
    loop(n, i == cur ? strcat(#mg_pmm, "!"); strcat(#mg_pmm, pk_pitem(#mu_pm, i, #mg_pt)); strcat(#mg_pmm, "|"); i += 1; );
    strcat(#mg_pmm, "|Reset all to defaults");
