desc:M-Ultra [mastering filter] (GFX Lab)
//tags: filter mastering high-pass low-pass rumble DC mono bass vinyl stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,1,1{Off,On}>-Low cut in
slider3:22<5,110,0.1>-Low cut frequency (Hz)
slider4:3<0,7,1{6 dB/oct,12 dB/oct,18 dB/oct,24 dB/oct,30 dB/oct,36 dB/oct,42 dB/oct,48 dB/oct}>-Low cut slope
slider5:100<0,100,0.1>-Low cut mix (%)
slider6:0<0,1,1{Off,On}>-Low cut listen
slider7:0<0,100,0.1>-Weight (%)
slider8:0<0,2,1{Even,Odd,Both}>-Weight harmonics
slider9:0<0,100,0.1>-Lift (%)
slider10:0<-24,0,0.1>-Clamp (dBFS, 0 = off)
slider11:1<0,1,1{Off,On}>-High cut in
slider12:22<16,44,0.01>-High cut frequency (kHz)
slider13:1<0,5,1{12 dB/oct,24 dB/oct,36 dB/oct,48 dB/oct,72 dB/oct,96 dB/oct}>-High cut slope
slider14:100<0,100,0.1>-High cut mix (%)
slider15:0<0,1,1{Off,On}>-High cut listen
slider16:0<0,1,1{Off,On}>-High cut gate
slider17:-120<-120,-60,0.5>-HF noise (dBFS, -120 = off)
slider18:0<0,11,1{Off,22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz,220 Hz,330 Hz}>-Mono bass
slider19:0<-12,12,0.1>-Output (dB)
slider20:prs_sel=0<0,10,1{No preset,Init,Gentle Guard,Vinyl Cut,Stream Master,Broadcast,Tape Transfer,Club Low End,Hi-Res Guard,Listen Low,Listen High}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-m-ultra";
ext_noinit = 1;

IFC = 100000; UFC = 100100;
C_RH = 100150; C_RL = 100154; C_BM = 100158; C_CL = 100162; C_MO = 100170;
C_H1 = 100174; C_H2 = 100178; C_D1 = 100182; C_D2 = 100186; C_DT = 100190;
MST = 100200;
IW = 100500; IWT = 100510; IK = 100520; IKT = 100530;
UW = 100550; UWT = 100560; UK = 100570; UKT = 100580;
RM = 100600;

function mu_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function mu_bk(n, j) ( 2 * cos((2 * j + 1 + (n & 1)) * $pi / (2 * n)); );
function mu_uord(i) ( i < 0.5 ? 2 : i < 1.5 ? 4 : i < 2.5 ? 6 : i < 3.5 ? 8 : i < 4.5 ? 12 : 16; );
function mu_mof(i) ( i < 0.5 ? 0 : i < 9.5 ? 11 * (i + 1) : i < 10.5 ? 220 : 330; );
function mu_coef(p, g, k) local(a) ( a = 1 / (1 + g * (g + k)); p[0] = a; p[1] = g * a; p[2] = g * g * a; p[3] = k; );
function mu_svf(x, pc, ps) local(v1, v2, v3) (
  v3 = x - ps[1]; v1 = pc[0] * ps[0] + pc[1] * v3; v2 = ps[1] + pc[1] * ps[0] + pc[2] * v3;
  ps[0] = 2 * v1 - ps[0]; ps[1] = 2 * v2 - ps[1];
  mu_bp = v1; mu_lp = v2; mu_hp = x - pc[3] * v1 - v2;
);
function mu_chain(x, pc, ps, w, n, lp) local(i, y, v1, v2, v3, o) (
  y = x; i = 0;
  loop(n,
    v3 = y - ps[1]; v1 = pc[0] * ps[0] + pc[1] * v3; v2 = ps[1] + pc[1] * ps[0] + pc[2] * v3;
    ps[0] = 2 * v1 - ps[0]; ps[1] = 2 * v2 - ps[1];
    o = lp ? v2 : y - pc[3] * v1 - v2;
    y += w[i] * (o - y);
    pc += 4; ps += 2; i += 1;
  );
  y;
);

function mu_targets() local(n, j, on) (
  on = slider2 >= 0.5;
  mu_lft = log(min(max(slider3, 5), 110)) / log(2);
  n = floor(min(max(slider4, 0), 7) + 0.5) + 1;
  j = 0; loop(4, j < floor(n / 2) ? ( IWT[j] = 1; IKT[j] = mu_bk(n, j); ) : IWT[j] = 0; j += 1; );
  IWT[4] = n & 1;
  mu_imt = on ? min(max(slider5, 0), 100) / 100 : 0;
  mu_lit = on && slider6 >= 0.5;
  mu_rwt = on ? min(max(slider7, 0), 100) / 100 * 0.7 : 0;
  j = floor(min(max(slider8, 0), 2) + 0.5);
  mu_cet = j == 0 ? 1 : j == 1 ? 0 : 0.7; mu_cot = j == 0 ? 0 : j == 1 ? 1 : 0.7;
  mu_bmt = on ? min(max(slider9, 0), 100) / 100 : 0;
  mu_cwt = slider10 < -0.05; mu_ctt = 10 ^ (min(max(slider10, -24), 0) / 20);
  on = slider11 >= 0.5;
  mu_lut = log(min(max(slider12, 16), 44) * 1000) / log(2);
  n = mu_uord(floor(min(max(slider13, 0), 5) + 0.5));
  j = 0; loop(8, j < n / 2 ? ( UWT[j] = 1; UKT[j] = mu_bk(n, j); ) : UWT[j] = 0; j += 1; );
  mu_umt = on ? min(max(slider14, 0), 100) / 100 : 0;
  mu_ult = on && slider15 >= 0.5;
  mu_gon = on && slider16 >= 0.5;
  mu_dnt = slider17 > -119.9 ? 10 ^ (slider17 / 20) : 0;
  j = mu_mof(floor(min(max(slider18, 0), 11) + 0.5));
  mu_mwt = j > 0; j > 0 ? mu_lmt = log(j) / log(2);
  mu_ogt = 10 ^ (min(max(slider19, -12), 12) / 20);
);

function mu_tick() local(f, g, i, fu, r, t) (
  mu_lf += mu_kc * (mu_lft - mu_lf); f = 2 ^ mu_lf; g = tan($pi * f / srate);
  i = 0; loop(4, IK[i] += mu_kq * (IKT[i] - IK[i]); mu_coef(IFC + i * 4, g, IK[i]); i += 1; );
  mu_ig = g / (1 + g);
  mu_coef(C_RH, g, 1.4142135623730951);
  mu_coef(C_RL, tan($pi * min(6 * f, 0.45 * srate) / srate), 1.4142135623730951);
  mu_coef(C_BM, tan($pi * 1.6 * f / srate), 1.25);
  mu_lu += mu_kc * (mu_lut - mu_lu); fu = min(2 ^ mu_lu, 0.49 * srate); g = tan($pi * fu / srate);
  i = 0; loop(8, UK[i] += mu_kq * (UKT[i] - UK[i]); mu_coef(UFC + i * 4, g, UK[i]); i += 1; );
  mu_coef(C_D1, g, 1.8477590650225735); mu_coef(C_D2, g, 0.7653668647301796); mu_coef(C_DT, g, 1.4142135623730951);
  mu_fu = fu; mu_fus = fu / srate;
  mu_lm += mu_kc * (mu_lmt - mu_lm); mu_coef(C_MO, tan($pi * 2 ^ mu_lm / srate), 1.4142135623730951);
  r = sqrt(mu_er / (mu_ex + 0.000000000001));
  t = mu_bm * 6 * min(1, r * 3);
  mu_bdb += (t > mu_bdb ? mu_kba : mu_kbr) * (t - mu_bdb);
  mu_bg = (10 ^ (mu_bdb / 20) - 1) * 1.25;
  mu_dw = mu_dn / 0.408 / sqrt(max(0.02, 1 - 2 * mu_fus));
);

function mu_inf(x, c) local(ps, h, v, lo, r, e, u, hr, y) (
  ps = MST + c * 100;
  h = mu_chain(x, IFC, ps, IW, 4, 0);
  v = (h - ps[8]) * mu_ig; lo = v + ps[8]; ps[8] = lo + v;
  h -= IW[4] * lo;
  r = x - h;
  mu_ers += r * r; mu_exs += x * x;
  mu_svf(h, C_BM, ps + 14); h += mu_bg * mu_bp;
  mu_rw > 0.00001 ? (
    e = max(abs(r), ps[9] * mu_rel); ps[9] = e;
    u = r / max(e, 0.000000001);
    hr = e * (mu_ce * (2 * u * u - 1) + mu_co * (4 * u * u * u - 3 * u));
    mu_svf(hr, C_RH, ps + 10); mu_svf(mu_hp, C_RL, ps + 12);
    h += mu_rw * mu_lp;
  );
  y = x + mu_im * (h - x);
  RM[c] = x - y;
  y;
);
function mu_clamp(y, c) local(ps, lb, hb, a, z, t) (
  ps = MST + c * 100;
  mu_svf(y, C_CL, ps + 16); mu_svf(mu_lp, C_CL, ps + 18); lb = mu_lp;
  mu_svf(y, C_CL, ps + 48); mu_svf(mu_hp, C_CL, ps + 50); hb = mu_hp;
  t = mu_ct; a = abs(lb);
  a > 0.5 * t ? (
    z = min((a - 0.5 * t) / (0.5 * t), 3); z = z * (27 + z * z) / (27 + 9 * z * z);
    lb = (lb > 0 ? 1 : -1) * 0.5 * t * (1 + z);
  );
  y + mu_cw * (hb + lb - y);
);
function mu_ult(x, c) local(ps, l, y) (
  ps = MST + c * 100 + 20;
  l = mu_chain(x, UFC, ps, UW, 8, 1);
  y = x + mu_um * mu_gw * (l - x);
  RM[2 + c] = x - y;
  y;
);

#mu_pm = "Init|Gentle Guard|Vinyl Cut|Stream Master|Broadcast|Tape Transfer|Club Low End|Hi-Res Guard|Listen Low|Listen High";
function mu_pi(fq, sl, mx, wt, ch, lf, cl) ( slider2 = 1; slider3 = fq; slider4 = sl; slider5 = mx; slider6 = 0;
  slider7 = wt; slider8 = ch; slider9 = lf; slider10 = cl; );
function mu_pu(fq, sl, mx, gt, hn) ( slider11 = 1; slider12 = fq; slider13 = sl; slider14 = mx; slider15 = 0;
  slider16 = gt; slider17 = hn; );
function load_preset(p) local(i) (
  mu_pi(22, 3, 100, 0, 0, 0, 0); mu_pu(22, 1, 100, 0, -120); slider18 = 0; slider19 = 0;
  p == 2 ? ( mu_pi(11, 1, 100, 0, 0, 0, 0); mu_pu(33, 0, 100, 0, -120); ) :
  p == 3 ? ( mu_pi(22, 5, 100, 0, 0, 0, -6); mu_pu(19.25, 3, 100, 0, -120); slider18 = 9; ) :
  p == 4 ? ( mu_pi(16.5, 3, 100, 0, 0, 0, 0); mu_pu(22, 3, 100, 1, -120); ) :
  p == 5 ? ( mu_pi(33, 3, 100, 0, 0, 0, -3); mu_pu(16.5, 5, 100, 0, -120); slider18 = 10; ) :
  p == 6 ? ( mu_pi(22, 2, 100, 30, 1, 30, 0); mu_pu(22, 1, 100, 0, -120); ) :
  p == 7 ? ( mu_pi(33, 5, 100, 40, 0, 50, -9); mu_pu(22, 1, 100, 0, -120); slider18 = 9; ) :
  p == 8 ? ( mu_pi(5.5, 1, 100, 0, 0, 0, 0); mu_pu(33, 5, 100, 1, -96); ) :
  p == 9 ? ( mu_pi(33, 3, 100, 0, 0, 0, 0); slider6 = 1; ) :
  p == 10 ? ( mu_pu(22, 3, 100, 0, -120); slider15 = 1; );
  i = 2; loop(18, slider_automate(2 ^ (i - 1)); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function mu_clr() ( memset(MST, 0, 300); mu_er = mu_ex = 0; );
function mu_srinit() (
  mu_sr = srate;
  mu_kc = 1 - exp(-16 / (0.03 * srate));
  mu_kq = 1 - exp(-16 / (0.02 * srate));
  mu_kw = 1 - exp(-1 / (0.02 * srate));
  mu_ks = 1 - exp(-1 / (0.012 * srate));
  mu_ko = 1 - exp(-1 / (0.03 * srate));
  mu_kcl = 1 - exp(-1 / (0.04 * srate));
  mu_kd = 1 - exp(-1 / (0.05 * srate));
  mu_kba = 1 - exp(-16 / (0.03 * srate)); mu_kbr = 1 - exp(-16 / (0.3 * srate));
  mu_kga = 1 - exp(-1 / (0.002 * srate)); mu_kgr = 1 - exp(-1 / (0.04 * srate));
  mu_ghold = floor(0.3 * srate); mu_gth = 0.0000001;
  mu_rel = exp(-1 / (0.25 * srate));
  mu_kdc = 1 - exp(-2 * $pi * 0.5 / srate);
  mu_coef(C_CL, tan($pi * 110 / srate), 1.4142135623730951);
  mu_coef(C_H1, tan($pi * min(15000, 0.45 * srate) / srate), 1.8477590650225735);
  mu_coef(C_H2, tan($pi * min(15000, 0.45 * srate) / srate), 0.7653668647301796);
  mu_fis = 1 / (0.01 * srate);
  ost_init(0);
  mu_clr();
);
function mu_snapall() local(i) (
  mu_lf = mu_lft; mu_lu = mu_lut; mu_lmt == 0 ? mu_lmt = log(110) / log(2); mu_lm = mu_lmt;
  i = 0; loop(5, IW[i] = IWT[i]; i < 4 ? IK[i] = IKT[i] == 0 ? 1.4142135623730951 : IKT[i]; i += 1; );
  i = 0; loop(8, UW[i] = UWT[i]; UK[i] = UKT[i] == 0 ? 1.4142135623730951 : UKT[i]; i += 1; );
  mu_im = mu_imt; mu_li = mu_lit; mu_rw = mu_rwt; mu_ce = mu_cet; mu_co = mu_cot; mu_bm = mu_bmt;
  mu_cw = mu_cwt; mu_ct = mu_ctt; mu_um = mu_umt; mu_ul = mu_ult; mu_dn = mu_dnt; mu_mw = mu_mwt; mu_og = mu_ogt;
  mu_gw = 1; mu_bdb = 0;
  mu_tick();
);
mu_srinit();
mu_lmt = log(110) / log(2);
mu_targets(); mu_snapall(); mu_fin = 1;
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(20, i != 20 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
mu_targets();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != mu_sr ? ( mu_srinit(); mu_targets(); mu_snapall(); );
mu_now = time_precise();
mu_tp > 0 && mu_now - mu_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > mu_gpp && play_position - mu_gpp < 4 * mu_gpd + 0.05) ? ( mu_clr(); mu_fin = 0; );
mu_tp = mu_now; mu_gpp = play_position; mu_gpd = samplesblock / srate;
mu_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
mu_i = 0; loop(300, MST[mu_i] = mu_tn(MST[mu_i]); mu_i += 1; );
mu_ol_d = max(mu_ol_d, mu_ol); mu_or_d = max(mu_or_d, mu_or); mu_ol = mu_or = 0;
mu_ip_d = max(mu_ip_d, mu_ip); mu_op_d = max(mu_op_d, mu_op); mu_ip = mu_op = 0;
mu_dc_d = abs(mu_dc); mu_ue_d = mu_ue; mu_ga_d = mu_gw; mu_bdb_d = mu_bdb; mu_fu_d = mu_fu;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
mu_xl = spl0; mu_xr = spl1;
(mu_cn -= 1) <= 0 ? ( mu_cn = 16; mu_tick(); );
mu_i = 0; loop(5, IW[mu_i] += mu_kw * (IWT[mu_i] - IW[mu_i]); mu_i += 1; );
mu_i = 0; loop(8, UW[mu_i] += mu_kw * (UWT[mu_i] - UW[mu_i]); mu_i += 1; );
mu_im += mu_ks * (mu_imt - mu_im); mu_li += mu_ks * (mu_lit - mu_li); mu_rw += mu_ks * (mu_rwt - mu_rw);
mu_ce += mu_ks * (mu_cet - mu_ce); mu_co += mu_ks * (mu_cot - mu_co); mu_bm += mu_ks * (mu_bmt - mu_bm);
mu_cw += mu_kcl * (mu_cwt - mu_cw); mu_ct += mu_ks * (mu_ctt - mu_ct); mu_um += mu_ks * (mu_umt - mu_um);
mu_ul += mu_ks * (mu_ult - mu_ul); mu_dn += mu_ks * (mu_dnt - mu_dn); mu_mw += mu_ks * (mu_mwt - mu_mw);
mu_og += mu_ko * (mu_ogt - mu_og);
mu_m = 0.5 * (mu_xl + mu_xr);
mu_dc += mu_kdc * (mu_m - mu_dc);
mu_svf(mu_m, C_DT, MST + 260); mu_ue += mu_kd * (mu_hp * mu_hp - mu_ue);
mu_gon ? ( mu_ue > mu_gth ? mu_gh = mu_ghold : mu_gh -= 1; mu_gt = mu_gh > 0; ) : mu_gt = 1;
mu_gw += (mu_gt > mu_gw ? mu_kga : mu_kgr) * (mu_gt - mu_gw);
mu_ers = mu_exs = 0;
mu_yl = mu_inf(mu_xl, 0); mu_yr = mu_inf(mu_xr, 1);
mu_er += mu_kd * (mu_ers - mu_er); mu_ex += mu_kd * (mu_exs - mu_ex);
mu_cwt && mu_cw < 0.00001 ? ( memset(MST + 16, 0, 4); memset(MST + 48, 0, 4); memset(MST + 116, 0, 4); memset(MST + 148, 0, 4); );
mu_cw > 0.00001 ? ( mu_yl = mu_clamp(mu_yl, 0); mu_yr = mu_clamp(mu_yr, 1); );
mu_m = 0.5 * (mu_yl + mu_yr); mu_s = 0.5 * (mu_yl - mu_yr);
mu_svf(mu_s, C_MO, MST + 250); mu_s += mu_mw * (mu_hp - mu_s);
mu_yl = mu_m + mu_s; mu_yr = mu_m - mu_s;
mu_yl = mu_ult(mu_yl, 0); mu_yr = mu_ult(mu_yr, 1);
mu_dn > 0.0000000001 ? (
  mu_svf(rand(1) - rand(1), C_D1, MST + 44); mu_svf(mu_hp, C_D2, MST + 46); mu_yl += mu_dw * mu_hp;
  mu_svf(rand(1) - rand(1), C_D1, MST + 144); mu_svf(mu_hp, C_D2, MST + 146); mu_yr += mu_dw * mu_hp;
);
mu_op = max(mu_op, max(abs(mu_yl), abs(mu_yr))); mu_ip = max(mu_ip, max(abs(mu_xl), abs(mu_xr)));
mu_yl *= mu_og; mu_yr *= mu_og;
mu_lw = max(mu_li, mu_ul);
mu_lw > 0.00001 ? (
  mu_al = mu_li * RM[0]; mu_ar = mu_li * RM[1];
  mu_ul > 0.00001 ? (
    mu_ph += mu_fus; mu_ph >= 1 ? mu_ph -= 1; mu_car = 2 * cos(2 * $pi * mu_ph);
    mu_svf(RM[2] * mu_car, C_H1, MST + 40); mu_svf(mu_lp, C_H2, MST + 42); mu_al += mu_ul * 4 * mu_lp;
    mu_svf(RM[3] * mu_car, C_H1, MST + 140); mu_svf(mu_lp, C_H2, MST + 142); mu_ar += mu_ul * 4 * mu_lp;
  );
  mu_yl += mu_lw * (mu_al - mu_yl); mu_yr += mu_lw * (mu_ar - mu_yr);
);
mu_yl != mu_yl ? mu_yl = 0; mu_yr != mu_yr ? mu_yr = 0;
mu_fin < 1 ? (
  mu_fin = min(mu_fin + mu_fis, 1); mu_z = mu_fin * mu_fin * (3 - 2 * mu_fin);
  mu_yl = mu_xl + mu_z * (mu_yl - mu_xl); mu_yr = mu_xr + mu_z * (mu_yr - mu_xr);
);
ost_out(mu_yl, mu_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
mu_ol = max(mu_ol, abs(spl0)); mu_or = max(mu_or, abs(spl1));

@gfx 1080 600
ui_begin(1080, 600);
MGP = 0x2A3046; MGS = 0x323952; MGH = 0x1B1F2E; MGI = 0xE8E2D0; MGI2 = 0xA3AAC0; MGA = 0xF0B44A; MGR = 0xC9B98E;
CHP = 0xF2D06B; CLP = 0x2E3138; CGR = 0xCFCBBE; CBR = 0xC08850;

sc != mg_fsc ? (
  mg_fsc = sc;
  mg_f10 = ui_fitfont(10, 15 * sc);
  mg_f11 = ui_fitfont(11, 17 * sc);
  mg_f12 = ui_fitfont(12, 11.5 * sc);
  mg_f13 = ui_fitfont(13, 14 * sc);
  mg_f14 = ui_fitfont(14, 27 * sc);
  mg_f15 = ui_fitfont(15, 11.5 * sc);
);
gfx_setfont(10, "Trebuchet MS", mg_f10, 'b'); gfx_setfont(11, "Trebuchet MS", mg_f11, 'b');
gfx_setfont(12, "Trebuchet MS", mg_f12, 'b'); gfx_setfont(13, "Trebuchet MS", mg_f13, 'b');
gfx_setfont(14, "Trebuchet MS", mg_f14, 'b'); gfx_setfont(15, "Trebuchet MS", mg_f15, 'b');

function mg_bk(n, j) ( 2 * cos((2 * j + 1 + (n & 1)) * $pi / (2 * n)); );
function mg_uord(i) ( i < 0.5 ? 2 : i < 1.5 ? 4 : i < 2.5 ? 6 : i < 3.5 ? 8 : i < 4.5 ? 12 : 16; );
function mg_mof(i) ( i < 0.5 ? 0 : i < 9.5 ? 11 * (i + 1) : i < 10.5 ? 220 : 330; );
function mg_fstr(f) local(v) (
  f < 1000 ? ( f < 100 ? sprintf(#mgf, "%.1f Hz", f) : sprintf(#mgf, "%d Hz", floor(f + 0.5)); )
           : ( v = f / 1000; v < 10 ? sprintf(#mgf, "%.2f kHz", v) : sprintf(#mgf, "%.1f kHz", v); );
  #mgf;
);

function mg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function mg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function mg_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); mg_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function mg_plate(x, y, w, h, band) (
  mg_shadow(x, y, w, h);
  ui_col(0x11131B); mg_r(x, y, w, h);
  ui_col(MGS); mg_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.07); mg_r(x + 1, y + 1, w - 2, 1); mg_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, 0.25); mg_r(x + 1, y + h - 3, w - 2, 2); mg_r(x + w - 3, y + 1, 2, h - 2);
  band ? ( ui_col(MGH); mg_r(x + 1, y + 1, w - 2, 32); ui_cola(MGR, 0.55); mg_r(x + 1, y + 33, w - 2, 1); );
);

mg_lock = 0; mg_pt = 0x1A1D22;
function mg_norm(v, lo, hi, lg) ( lg ? log(v / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function mg_den(n, lo, hi, lg) ( lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo); );
function mg_cap(cx, cy, r, a, act, cap, nd) local(i, t, x, y, rr, rd) (
  x = cx * sc; y = cy * sc; rr = r * sc; rd = rr + 8 * sc;
  ui_col(MGI2); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(x + sin(t) * rd, y - cos(t) * rd, (i == 0 || i == nd ? 2.0 : 1.4) * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.16); gfx_circle(x + (2 + i * 1.3) * sc, y + (3 + i * 1.6) * sc, rr + i * 0.6 * sc, 1, 1); i += 1; );
  ui_col(0x0E1012); gfx_circle(x, y, rr, 1, 1);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2C3136);
    ui_ssline(x + sin(t) * rr * 0.80, y - cos(t) * rr * 0.80, x + sin(t) * rr * 0.95, y - cos(t) * rr * 0.95, 1.1 * sc, 0); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.30 : 0.18); ui_ssarc(x, y, rr - 0.6 * sc, -2.2, 0.6, 1 * sc);
  ui_col(ui_mix(cap, 0x000000, 0.5)); gfx_circle(x, y, rr * 0.76, 1, 1);
  ui_col(cap); gfx_circle(x, y, rr * 0.72, 1, 1);
  i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(x, y, rr * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.40 : 0.24); ui_ssarc(x, y, rr * 0.62, -1.7, -0.3, 1 * sc);
  ui_col(mg_pt); ui_kdot(x, y, a, rr * 0.72);
);
function mg_knob(cx, cy, r, idx, lo, hi, ps, def, lg, cap) local(v, n, dx, dy, hov, did, act, nd) (
  did = 1700 + idx; v = slider(idx); nd = ps > 0 ? floor((hi - lo) / ps + 0.5) : 4;
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = !mg_lock && dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - mg_lt < 0.35 && mg_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; mg_lt = 0; ) : (
      drag_id = did; mg_y = mouse_y; mg_dz = 0; mg_lt = time_precise(); mg_lid = idx; mg_n = mg_norm(v, lo, hi, lg);
    );
  );
  drag_id == did ? (
    mg_dz += abs(mg_y - mouse_y);
    mg_dz > 3 * sc ? (
      mg_n = min(max(mg_n + (mg_y - mouse_y) / (((mouse_cap & 8) ? 1000 : ps > 0 ? max(160, nd * 9) : 200) * sc), 0), 1);
      v = ps > 0 ? lo + floor(mg_n * nd + 0.5) * ps : mg_den(mg_n, lo, hi, lg);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    mg_y = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    ps > 0 ? slider(idx) = min(max(lo + (floor((v - lo) / ps + 0.5) + sign(mouse_wheel)) * ps, lo), hi)
           : slider(idx) = mg_den(min(max(mg_norm(v, lo, hi, lg) + sign(mouse_wheel) * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1), lo, hi, lg);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(mg_norm(v, lo, hi, lg), 0), 1);
  act = hov || drag_id == did;
  mg_cap(cx, cy, r, -0.75 * $pi + n * 1.5 * $pi, act, cap, nd > 12 ? 4 : nd);
  mg_pt = 0x1A1D22;
  act;
);
function mg_name(cx, y, act, name, val) ( gfx_setfont(10); ui_col(act ? MGA : MGI); mg_ctxt(cx, y, act ? val : name); );
function mg_ends(cx, cy, r, a, b) ( gfx_setfont(12); ui_col(MGI2);
  mg_rtxt(cx - (r + 8) * 0.7071 - 6, cy + (r + 8) * 0.7071 + 5, a);
  mg_ltxt(cx + (r + 8) * 0.7071 + 6, cy + (r + 8) * 0.7071 + 5, b); );
function mg_rbox(cx, y, w, h, s, lit) local(x) (
  x = cx - w / 2;
  ui_col(0x0C0D12); mg_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(lit ? 0xE9E3D2 : 0x8E8A80); mg_r(x, y, w, h);
  ui_cola(0x000000, 0.22); mg_r(x, y, w, 2); mg_r(x, y, 2, h);
  gfx_setfont(13); ui_col(0x24211C); mg_ctxt(cx, y + h / 2 + 0.5, s);
);
function mg_dbox(cx, y, w, h, s) local(x, hit) (
  x = cx - w / 2;
  hit = !mg_lock && pressed && drag_id == 0 && mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit ? drag_id = -1;
  ui_col(0x07080C); mg_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(0x161A26); mg_r(x, y, w, h);
  ui_cola(0x000000, 0.4); mg_r(x, y, w, 2); mg_r(x, y, 2, h);
  gfx_setfont(13); ui_col(0xF2D79A); mg_ctxt(cx - 6, y + h / 2 + 0.5, s);
  ui_col(MGI2); gfx_triangle((x + w - 15) * sc, (y + h / 2 - 2) * sc, (x + w - 7) * sc, (y + h / 2 - 2) * sc, (x + w - 11) * sc, (y + h / 2 + 3) * sc);
  hit;
);
function mg_lamp(cx, cy, on) local(x, y, hit) (
  x = cx * sc; y = cy * sc;
  hit = pressed && drag_id == 0 && abs(mouse_x - x) < 10 * sc && abs(mouse_y - y) < 10 * sc; hit ? drag_id = -1;
  on ? ( ui_cola(0xFFB43C, 0.18); gfx_circle(x, y, 11 * sc, 1, 1); ui_cola(0xFFB43C, 0.25); gfx_circle(x, y, 8.5 * sc, 1, 1); );
  ui_col(0x050506); gfx_circle(x, y, 7.5 * sc, 1, 1);
  ui_col(0xE9E0C6); gfx_circle(x, y, 6.5 * sc, 1, 1);
  ui_col(on ? 0xFFB43C : 0x5A4A30); gfx_circle(x, y, 4.2 * sc, 1, 1);
  ui_cola(0xFFFFFF, on ? 0.6 : 0.15); gfx_circle(x - 1.4 * sc, y - 1.4 * sc, 1.4 * sc, 1, 1);
  hit;
);
function mg_led(cx, cy, on, c) local(x, y) ( x = cx * sc; y = cy * sc;
  ui_col(0x050506); gfx_circle(x, y, 5.5 * sc, 1, 1);
  on ? ( ui_cola(c, 0.25); gfx_circle(x, y, 9 * sc, 1, 1); ui_col(c); ) : ui_col(ui_mix(c, 0x101218, 0.8));
  gfx_circle(x, y, 4 * sc, 1, 1);
  ui_cola(0xFFFFFF, on ? 0.6 : 0.12); gfx_circle(x - 1.2 * sc, y - 1.2 * sc, 1.2 * sc, 1, 1); );
function mg_key(x, y, w, h, lbl, on, col) ( lk_well = 0x0A0B10; lk_font = 13; lk_font2 = 13; lk_fit(x, y, w, h, on, col, lbl); );
function mg_rivet(x, y) ( ui_cola(0x000000, 0.45); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x6C7178); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xA9AEB4); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );
function mg_grey(x, y, w, h) ( ui_cola(MGS, 0.55); mg_r(x, y, w, h); );
function mg_fall(v, p) ( p = p > 0.0000001 ? 20 * log10(p) : -90; p > v ? p : max(v - 0.6, -90); );
function mg_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? 0xFF3A2A : zone == 1 ? 0xFFC81E : 0x3CE05A;
  lit ? ( ui_cola(c, 0.16); mg_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); mg_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); mg_r(x, y, w, 1.5); )
      : ( ui_col(ui_mix(c, 0x141619, 0.82)); mg_r(x, y, w, h); );
);
function mg_bar(x, y, w, h, v, pk) local(n, i, sw, d) (
  n = 20; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; mg_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d || (pk > -48 && abs(pk - d) < 1.2), d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);

function mg_cd(nr, ni, dr, di) local(d) ( d = dr * dr + di * di; mg_qr = (nr * dr + ni * di) / d; mg_qi = (ni * dr - nr * di) / d; );
function mg_cm(br, bi) local(t) ( t = mg_ar * br - mg_ai * bi; mg_ai = mg_ar * bi + mg_ai * br; mg_ar = t; );
function mg_resp(f) local(w, o, n, j, k, m, ir, ii, ur, ui, gk, tr, ti, lis) (
  w = tan($pi * min(f, 0.4999 * srate) / srate);
  ir = 1; ii = 0; ur = 1; ui = 0; lis = 0; tr = 0; ti = 0;
  slider2 >= 0.5 ? (
    o = w / tan($pi * slider3 / srate); n = floor(slider4 + 0.5) + 1;
    mg_ar = 1; mg_ai = 0;
    j = 0; loop(floor(n / 2), k = mg_bk(n, j); mg_cd(-o * o, 0, 1 - o * o, k * o); mg_cm(mg_qr, mg_qi); j += 1; );
    n & 1 ? ( mg_cd(0, o, 1, o); mg_cm(mg_qr, mg_qi); );
    mu_bdb_d > 0.05 ? (
      o = w / tan($pi * min(1.6 * slider3, 0.45 * srate) / srate); gk = (10 ^ (mu_bdb_d / 20) - 1) * 1.25;
      mg_cd(0, o, 1 - o * o, 1.25 * o); mg_cm(1 + gk * mg_qr, gk * mg_qi);
    );
    m = slider5 / 100; ir = 1 + m * (mg_ar - 1); ii = m * mg_ai;
    slider6 >= 0.5 ? ( lis = 1; tr = 1 - ir; ti = -ii; );
  );
  slider11 >= 0.5 ? (
    o = w / tan($pi * min(slider12 * 1000, 0.49 * srate) / srate); n = mg_uord(floor(slider13 + 0.5));
    mg_ar = 1; mg_ai = 0;
    j = 0; loop(n / 2, k = mg_bk(n, j); mg_cd(1, 0, 1 - o * o, k * o); mg_cm(mg_qr, mg_qi); j += 1; );
    m = slider14 / 100; ur = 1 + m * (mg_ar - 1); ui = m * mg_ai;
    slider15 >= 0.5 ? ( lis = 1; tr += 1 - ur; ti -= ui; );
  );
  lis ? ( mg_lis = 1; ) : ( tr = ir * ur - ii * ui; ti = ir * ui + ii * ur; );
  m = sqrt(tr * tr + ti * ti);
  m > 0.00001 ? 20 * log10(m) : -100;
);

