function bt_agcalc() local(i, f, w, sw, pa, pb) (
  sw = pa = pb = 0; i = 0;
  loop(48, f = BT_AGF[i]; w = BT_AGW[i];
    pa += w * bt_resp(BT_T, f); pb += w * bt_resp(BT_T + 100, f); sw += w; i += 1; );
  bt_agt = sqrt(2 * sw / max(pa + pb, 0.0000001));
  bt_agt = min(max(bt_agt, 0.0316), 31.6);
