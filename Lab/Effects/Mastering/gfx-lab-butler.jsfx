desc:BUTLER [mastering EQ] (GFX Lab)
//tags: equalizer equaliser eq parametric mastering mid side de-esser tilt air sub analyser analyzer stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:0<-15,15,0.1>-L/M LF gain (dB)
slider2:55<15,800,1>-L/M LF frequency (Hz)
slider3:0.3<0.3,4,0.01>-L/M LF Q (0.3 = shelf)
slider4:0<-15,15,0.1>-L/M LMF gain (dB)
slider5:220<15,800,1>-L/M LMF frequency (Hz)
slider6:1<0.4,4,0.01>-L/M LMF Q
slider7:0<-15,15,0.1>-L/M MF gain (dB)
slider8:1100<120,8000,1>-L/M MF frequency (Hz)
slider9:1<0.4,4,0.01>-L/M MF Q
slider10:0<-15,15,0.1>-L/M HMF gain (dB)
slider11:3300<400,26000,1>-L/M HMF frequency (Hz)
slider12:1<0.4,4,0.01>-L/M HMF Q
slider13:0<-15,15,0.1>-L/M HF gain (dB)
slider14:11000<400,26000,1>-L/M HF frequency (Hz)
slider15:0.3<0.3,4,0.01>-L/M HF Q (0.3 = shelf)
slider16:11<11,330,1>-L/M high-pass (Hz, 11 = off)
slider17:0<0,10,0.1>-L/M sub (dB)
slider18:0<-1.5,1.5,0.01>-L/M tilt (dB per octave)
slider19:0<0,10,0.1>-L/M air (dB)
slider20:22000<3300,22000,1>-L/M low-pass (Hz, 22000 = off)
slider21:0<-15,15,0.1>-L/M gain (dB)
slider22:1<0,1,1{Out,In}>-L/M EQ in
slider23:0<-15,15,0.1>-R/S LF gain (dB)
slider24:55<15,800,1>-R/S LF frequency (Hz)
slider25:0.3<0.3,4,0.01>-R/S LF Q (0.3 = shelf)
slider26:0<-15,15,0.1>-R/S LMF gain (dB)
slider27:220<15,800,1>-R/S LMF frequency (Hz)
slider28:1<0.4,4,0.01>-R/S LMF Q
slider29:0<-15,15,0.1>-R/S MF gain (dB)
slider30:1100<120,8000,1>-R/S MF frequency (Hz)
slider31:1<0.4,4,0.01>-R/S MF Q
slider32:0<-15,15,0.1>-R/S HMF gain (dB)
slider33:3300<400,26000,1>-R/S HMF frequency (Hz)
slider34:1<0.4,4,0.01>-R/S HMF Q
slider35:0<-15,15,0.1>-R/S HF gain (dB)
slider36:11000<400,26000,1>-R/S HF frequency (Hz)
slider37:0.3<0.3,4,0.01>-R/S HF Q (0.3 = shelf)
slider38:11<11,330,1>-R/S high-pass (Hz, 11 = off)
slider39:0<0,10,0.1>-R/S sub (dB)
slider40:0<-1.5,1.5,0.01>-R/S tilt (dB per octave)
slider41:0<0,10,0.1>-R/S air (dB)
slider42:22000<3300,22000,1>-R/S low-pass (Hz, 22000 = off)
slider43:0<-15,15,0.1>-R/S gain (dB)
slider44:1<0,1,1{Out,In}>-R/S EQ in
slider45:0<0,2,1{Off,L/M,R/S}>-Listen
slider46:0<0,1,1{Off,On}>-Auto gain
slider47:6600<2200,16000,1>-De-esser frequency (Hz)
slider48:0<0,100,1>-De-esser amount (%)
slider49:0<0,1,1{Bell,Shelf}>-De-esser type
slider50:1<0,1,1{Off,On}>-S-guard
slider51:0<0,1,1{Stereo,Mid/Side}>-Mode
slider52:1<0,1,1{Off,On}>-Link
slider53:100<0,200,1>-Gain scale (%)
slider54:0<0,1,1{Off,On}>-Bypass
slider55:2<0,3,1{Off,Fast,Slow,Infinite}>-Analyser
slider56:0<0,2,1{Both,L/M,R/S}>-Display
slider57:prs_sel=0<0,10,1{No preset,Init,Gentle Polish,Warm Master,Air and Space,Mud Clean,Vocal Forward,Loud Pop,M/S Wide Top,Bright Tilt,Dark Tilt}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-butler";
ext_noinit = 1;

BT_CO = 100000; BT_T = 130000; BT_C = 140000; BG_T = 150000;
BT_AGF = 160000; BT_AGW = 160100;
BT_AN = 200000;
BG_FB = 262144; BG_WIN = 330000; BG_SP = 340000; BG_SI = 341000; BG_CV = 342000;

function bt_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

function bt_mag(ty, g, q, x) local(a, x2, n, d, sa) (
  x2 = x * x;
  ty == 0 ? ( a = 10 ^ (g / 40); n = sqr(1 - x2) + sqr(x * a / q); d = sqr(1 - x2) + sqr(x / (a * q)); ) :
  ty == 1 ? ( a = 10 ^ (g / 40); sa = sqrt(a); n = a * a * (sqr(a - x2) + sqr(sa * x / q)); d = sqr(1 - a * x2) + sqr(sa * x / q); ) :
  ty == 2 ? ( a = 10 ^ (g / 40); sa = sqrt(a); n = a * a * (sqr(1 - a * x2) + sqr(sa * x / q)); d = sqr(a - x2) + sqr(sa * x / q); ) :
  ty == 3 ? ( n = x2 * x2; d = sqr(1 - x2) + sqr(x / q); ) : ( n = 1; d = sqr(1 - x2) + sqr(x / q); );
  n / max(d, 0.0000000000000000001);
);
function bt_tiltm(s, f) local(i, g, f1, r, p) (
  r = p = 1;
  abs(s) > 0.00001 ? (
    g = 10 ^ (s * 1.5 / 20); i = 0;
    loop(6, f1 = 40 * 2 ^ (1.5 * i) * sqrt(g);
      r *= (g * g * f * f + f1 * f1) / (f * f + f1 * f1); p *= (g * g * 435600 + f1 * f1) / (435600 + f1 * f1); i += 1; );
  );
  r / p;
);
function bt_p1(ty, fc, f) local(a1, x, hn, b0, b1, w, c, sn, nr, ni, dr, di, dd) (
  a1 = -exp(-2 * $pi * fc / srate); x = 0.5 * srate / fc;
  ty == 4 ? ( hn = 1 / sqrt(1 + x * x); b0 = 0.5 * ((1 + a1) + hn * (1 - a1)); b1 = 0.5 * ((1 + a1) - hn * (1 - a1)); ) :
            ( hn = x / sqrt(1 + x * x); b0 = 0.5 * hn * (1 - a1); b1 = -b0; );
  w = 2 * $pi * min(f, 0.4999 * srate) / srate; c = cos(w); sn = sin(w);
  nr = b0 + b1 * c; ni = -b1 * sn; dr = 1 + a1 * c; di = -a1 * sn; dd = dr * dr + di * di;
  bt_pre = (nr * dr + ni * di) / dd; bt_pim = (ni * dr - nr * di) / dd;
);
function bt_resp(t, f) local(b, p, x, k, re, im, d) (
  p = 1;
  t[28] >= 0.5 ? (
    b = 0;
    loop(5,
      abs(t[b * 4]) > 0.00001 ? (
        x = f / t[b * 4 + 1];
        p *= t[b * 4 + 3] >= 0.5 ? bt_mag(b == 0 ? 1 : 2, t[b * 4], 0.9, x) : bt_mag(0, t[b * 4], t[b * 4 + 2], x);
      );
      b += 1;
    );
    t[21] >= 0.5 ? p *= bt_mag(3, 0, 0.7071, f / t[20]);
    t[23] >= 0.5 ? p *= bt_mag(4, 0, 0.7071, f / t[22]);
    p *= bt_tiltm(t[25], f);
    re = 1; im = 0;
    k = 10 ^ (t[24] / 20) - 1; bt_p1(4, 33, f); re += k * bt_pre; im += k * bt_pim;
    k = 10 ^ (t[26] / 20) - 1; bt_p1(3, 22000, f); re += k * bt_pre; im += k * bt_pim;
    p *= re * re + im * im;
  );
  p;
);
function bt_tgt(c, t) local(o, b, gs, q, lo, hi) (
  o = c * 22; gs = min(max(slider53, 0), 200) / 100; b = 0;
  loop(5,
    lo = b < 2 ? 15 : b == 2 ? 120 : 400; hi = b < 2 ? 800 : b == 2 ? 8000 : 26000;
    t[b * 4] = min(max(slider(1 + o + 3 * b), -15), 15) * gs;
    t[b * 4 + 1] = min(max(slider(2 + o + 3 * b), lo), hi);
    q = slider(3 + o + 3 * b);
    t[b * 4 + 3] = (b == 0 || b == 4) && q < 0.35;
    t[b * 4 + 2] = min(max(q, 0.4), 4);
    b += 1;
  );
  t[20] = min(max(slider(16 + o), 11), 330); t[21] = slider(16 + o) > 11.5;
  t[22] = min(max(slider(20 + o), 3300), 22000); t[23] = slider(20 + o) < 21900;
  t[24] = min(max(slider(17 + o), 0), 10) * gs; t[25] = min(max(slider(18 + o), -1.5), 1.5) * gs;
  t[26] = min(max(slider(19 + o), 0), 10) * gs;
  t[27] = 10 ^ (min(max(slider(21 + o), -15), 15) / 20); t[28] = slider(22 + o) >= 0.5;
);

function bt_mzp(wp, z) local(r, q) (
  wp = min(wp, 0.99 * $pi);
  r = exp(-z * wp);
  z <= 1 ? bt_a1 = -2 * r * cos(sqrt(1 - z * z) * wp) : ( q = sqrt(z * z - 1) * wp; bt_a1 = -r * (exp(q) + exp(-q)); );
  bt_a2 = exp(-2 * z * wp);
);
function bt_fit(p, h0, hp, wm, hm) local(a0, a1s, a2s, f0, f1, f2, bb0, bb1, bb2, s0, s1, w, d) (
  a0 = sqr(1 + bt_a1 + bt_a2); a1s = sqr(1 - bt_a1 + bt_a2); a2s = -4 * bt_a2;
  f1 = sqr(sin(wm * 0.5)); f0 = 1 - f1; f2 = 4 * f0 * f1;
  bb0 = h0 * a0; bb1 = hp * a1s;
  bb2 = (hm * (a0 * f0 + a1s * f1 + a2s * f2) - bb0 * f0 - bb1 * f1) / f2;
  s0 = sqrt(bb0); s1 = sqrt(bb1); w = 0.5 * (s0 + s1);
  d = sqrt(max(w * w + bb2, 0));
  p[0] = 0.5 * (w + d); p[2] = w - p[0]; p[1] = 0.5 * (s0 - s1);
  p[3] = bt_a1; p[4] = bt_a2;
);
function bt_fitls(p, ty, g, q, w0) local(a0, a1s, a2s, i, w, f0, f1, f2, t, r0, r1, r2, m00, m01, m02, m11, m12, m22, v0, v1, v2, c0, c1, c2, de, bb0, bb1, bb2, s0, s1, ww, d, l0, l1) (
  a0 = sqr(1 + bt_a1 + bt_a2); a1s = sqr(1 - bt_a1 + bt_a2); a2s = -4 * bt_a2;
  m00 = m01 = m02 = m11 = m12 = m22 = v0 = v1 = v2 = 0;
  c0 = c1 = c2 = 0.0000000000000000001;
  l0 = log(2 * $pi * 20 / srate); l1 = log(0.92 * $pi);
  loop(2,
    i = 0;
    loop(16,
      w = exp(l0 + (l1 - l0) * i / 15);
      f1 = sqr(sin(w * 0.5)); f0 = 1 - f1; f2 = 4 * f0 * f1;
      t = bt_mag(ty, g, q, w / w0) * (a0 * f0 + a1s * f1 + a2s * f2);
      r0 = f0 / t; r1 = f1 / t; r2 = f2 / t;
      bt_lp ? (
        r0 /= c0; r1 /= c1; r2 /= c2;
        m00 += r0 * r0; m01 += r0 * r1; m02 += r0 * r2; m11 += r1 * r1; m12 += r1 * r2; m22 += r2 * r2;
        v0 += r0; v1 += r1; v2 += r2;
      ) : ( c0 = max(c0, abs(r0)); c1 = max(c1, abs(r1)); c2 = max(c2, abs(r2)); );
      i += 1;
    );
    bt_lp = !bt_lp;
  );
  bt_lp = 0;
  de = m00 * (m11 * m22 - m12 * m12) - m01 * (m01 * m22 - m12 * m02) + m02 * (m01 * m12 - m11 * m02);
  bb0 = (v0 * (m11 * m22 - m12 * m12) - m01 * (v1 * m22 - m12 * v2) + m02 * (v1 * m12 - m11 * v2)) / de / c0;
  bb1 = (m00 * (v1 * m22 - m12 * v2) - v0 * (m01 * m22 - m12 * m02) + m02 * (m01 * v2 - v1 * m02)) / de / c1;
  bb2 = (m00 * (m11 * v2 - v1 * m12) - m01 * (m01 * v2 - v1 * m02) + v0 * (m01 * m12 - m11 * m02)) / de / c2;
  s0 = sqrt(max(bb0, 0)); s1 = sqrt(max(bb1, 0)); ww = 0.5 * (s0 + s1);
  d = sqrt(max(ww * ww + bb2, 0));
  p[0] = 0.5 * (ww + d); p[2] = ww - p[0]; p[1] = 0.5 * (s0 - s1);
  p[3] = bt_a1; p[4] = bt_a2;
);
function bt_dz(p, ty, f0, g, q) local(w0, a, wp, z, wm) (
  w0 = 2 * $pi * f0 / srate; a = 10 ^ (g / 40);
  ty == 0 ? ( wp = w0; z = 0.5 / (a * q); ) : ty == 1 ? ( wp = w0 / sqrt(a); z = 0.5 / q; ) :
  ty == 2 ? ( wp = w0 * sqrt(a); z = 0.5 / q; ) : ( wp = w0; z = 0.5 / q; );
  bt_mzp(wp, z);
  w0 < 0.3 ? (
    wm = min(w0, 0.8 * $pi);
    bt_fit(p, bt_mag(ty, g, q, 0), bt_mag(ty, g, q, 0.5 * srate / f0), wm, bt_mag(ty, g, q, wm / w0));
  ) : bt_fitls(p, ty, g, q, w0);
);
function bt_dfo(p, ty, fc) local(a1, x, hn) (
  a1 = -exp(-2 * $pi * fc / srate); x = 0.5 * srate / fc;
  ty == 4 ? ( hn = 1 / sqrt(1 + x * x); p[0] = 0.5 * ((1 + a1) + hn * (1 - a1)); p[1] = 0.5 * ((1 + a1) - hn * (1 - a1)); ) :
            ( hn = x / sqrt(1 + x * x); p[0] = 0.5 * hn * (1 - a1); p[1] = -p[0]; );
  p[2] = 0; p[3] = a1; p[4] = 0;
);
function bt_bq(p, x) local(y) ( y = p[0] * x + p[5]; p[5] = p[1] * x - p[3] * y + p[6]; p[6] = p[2] * x - p[4] * y; y; );
function bt_bqz(p) ( p[5] = p[6] = 0; );
function bt_tdz(p, s) local(i, g, w1, a1, hn, om, nr) (
  g = 10 ^ (s * 1.5 / 20); i = 0; nr = 1; om = $pi * srate;
  loop(6,
    w1 = 2 * $pi * 40 * 2 ^ (1.5 * i) * sqrt(g);
    a1 = -exp(-w1 / srate);
    hn = sqrt((g * g * om * om + w1 * w1) / (om * om + w1 * w1));
    p[i * 4] = 0.5 * ((1 + a1) + hn * (1 - a1)); p[i * 4 + 1] = 0.5 * ((1 + a1) - hn * (1 - a1)); p[i * 4 + 2] = a1;
    nr *= (g * g * 17198707.6 + w1 * w1) / (17198707.6 + w1 * w1);
    i += 1;
  );
  1 / sqrt(nr);
);

function bt_tick(c) local(t, u, p, b, d, mv, f, q, a) (
  t = BT_T + c * 100; u = BT_C + c * 100; p = BT_CO + c * 200;
  b = 0;
  loop(5,
    mv = bt_force;
    d = t[b * 4] - u[b * 4]; abs(d) > 0.002 ? ( u[b * 4] += d * bt_kg; mv = 1; ) : d != 0 ? ( u[b * 4] = t[b * 4]; mv = 1; );
    d = log(t[b * 4 + 1] / u[b * 4 + 1]); abs(d) > 0.0005 ? ( u[b * 4 + 1] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[b * 4 + 1] = t[b * 4 + 1]; mv = 1; );
    d = log(t[b * 4 + 2] / u[b * 4 + 2]); abs(d) > 0.0005 ? ( u[b * 4 + 2] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[b * 4 + 2] = t[b * 4 + 2]; mv = 1; );
    (b == 0 || b == 4) ? (
      a = u[b * 4 + 3];
      u[b * 4 + 3] = t[b * 4 + 3] >= 0.5 ? min(a + bt_ks, 1) : max(a - bt_ks, 0);
      a != u[b * 4 + 3] ? ( u[b * 4 + 3] == 0 ? bt_bqz(p + (b == 0 ? 40 : 48)); u[b * 4 + 3] == 1 ? bt_bqz(p + b * 8); );
    );
    u[40 + b] = abs(u[b * 4]) > 0.00001 || abs(t[b * 4]) > 0.00001;
    !u[40 + b] ? ( bt_bqz(p + b * 8); b == 0 ? bt_bqz(p + 40); b == 4 ? bt_bqz(p + 48); ) : mv ? (
      f = u[b * 4 + 1]; q = u[b * 4 + 2];
      bt_dz(p + b * 8, 0, f, u[b * 4], q);
      b == 0 ? bt_dz(p + 40, 1, f, u[b * 4], 0.9);
      b == 4 ? bt_dz(p + 48, 2, f, u[b * 4], 0.9);
    );
    b += 1;
  );
  mv = bt_force; d = log(t[20] / u[20]); abs(d) > 0.0005 ? ( u[20] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[20] = t[20]; mv = 1; );
  mv ? bt_dz(p + 56, 3, u[20], 0, 0.7071);
  a = u[21]; u[21] = t[21] >= 0.5 ? min(a + bt_ks, 1) : max(a - bt_ks, 0); u[21] == 0 && a != 0 ? bt_bqz(p + 56);
  mv = bt_force; d = log(t[22] / u[22]); abs(d) > 0.0005 ? ( u[22] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[22] = t[22]; mv = 1; );
  mv ? bt_dz(p + 64, 4, u[22], 0, 0.7071);
  a = u[23]; u[23] = t[23] >= 0.5 ? min(a + bt_ks, 1) : max(a - bt_ks, 0); u[23] == 0 && a != 0 ? bt_bqz(p + 64);
  d = t[24] - u[24]; abs(d) > 0.002 ? u[24] += d * bt_kg : u[24] = t[24];
  d = t[26] - u[26]; abs(d) > 0.002 ? u[26] += d * bt_kg : u[26] = t[26];
  u[46] = 10 ^ (u[24] / 20) - 1; u[47] = 10 ^ (u[26] / 20) - 1;
  u[46] == 0 ? bt_bqz(p + 72); u[47] == 0 ? bt_bqz(p + 80);
  mv = bt_force; d = t[25] - u[25]; abs(d) > 0.0005 ? ( u[25] += d * bt_kg; mv = 1; ) : d != 0 ? ( u[25] = t[25]; mv = 1; );
  u[25] == 0 ? ( u[45] = 1; p[91] = p[95] = p[99] = p[103] = p[107] = p[111] = 0; ) : mv ? u[45] = bt_tdz(p + 88, u[25]);
);
function bt_chan(x, c, ga) local(u, p, y, ya, ys, m, q) (
  u = BT_C + c * 100; p = BT_CO + c * 200; y = x;
  u[40] ? ( m = u[3]; ya = m < 1 ? bt_bq(p, y) : 0; ys = m > 0 ? bt_bq(p + 40, y) : 0; y = ya + m * (ys - ya); );
  u[41] ? y = bt_bq(p + 8, y);
  u[42] ? y = bt_bq(p + 16, y);
  u[43] ? y = bt_bq(p + 24, y);
  u[44] ? ( m = u[19]; ya = m < 1 ? bt_bq(p + 32, y) : 0; ys = m > 0 ? bt_bq(p + 48, y) : 0; y = ya + m * (ys - ya); );
  u[25] != 0 ? (
    q = p + 88;
    loop(6, ys = q[0] * y + q[3]; q[3] = q[1] * y - q[2] * ys; y = ys; q += 4; );
    y *= u[45];
  );
  ya = y;
  u[46] > 0 ? y += u[46] * bt_bq(p + 72, ya);
  u[47] > 0 ? y += u[47] * ga * bt_bq(p + 80, ya);
  u[21] > 0 ? y += u[21] * (bt_bq(p + 56, y) - y);
  u[23] > 0 ? y += u[23] * (bt_bq(p + 64, y) - y);
  u[50] += (u[27] - u[50]) * bt_kp;
  u[51] += (u[28] - u[51]) * bt_kp;
  x + u[51] * (y * u[50] - x);
);
function bt_clear() local(c, p, i) (
  c = 0;
  loop(2, p = BT_CO + c * 200; i = 0; loop(11, bt_bqz(p + i * 8); i += 1; );
    i = 0; loop(6, p[88 + i * 4 + 3] = 0; i += 1; ); c += 1; );
  dsA.c1 = dsA.c2 = dsA.l1 = dsB.c1 = dsB.c2 = dsB.l1 = 0; bt_es = bt_ef = 0; bt_dsg = 0;
);
function bt_denorm() local(c, p, i) (
  c = 0;
  loop(2, p = BT_CO + c * 200; i = 0;
    loop(11, p[i * 8 + 5] = bt_tn(p[i * 8 + 5]); p[i * 8 + 6] = bt_tn(p[i * 8 + 6]); i += 1; );
    i = 0; loop(6, p[88 + i * 4 + 3] = bt_tn(p[88 + i * 4 + 3]); i += 1; ); c += 1; );
  dsA.c1 = bt_tn(dsA.c1); dsA.c2 = bt_tn(dsA.c2); dsB.c1 = bt_tn(dsB.c1); dsB.c2 = bt_tn(dsB.c2); dsA.l1 = bt_tn(dsA.l1); dsB.l1 = bt_tn(dsB.l1);
);

function ds_run(v0) instance(c1, c2, l1) local(v1, v2, v3) (
  v3 = v0 - c2; v1 = bt_d1 * c1 + bt_d2 * v3; v2 = c2 + bt_d2 * c1 + bt_d3 * v3;
  c1 = 2 * v1 - c1; c2 = 2 * v2 - c2;
  l1 += bt_dl * (v0 - l1);
  (1 - bt_dsh) * bt_dk * v1 + bt_dsh * (v0 - l1);
);
function ds_set() local(g) (
  g = tan($pi * min(bt_df, 0.45 * srate) / srate);
  bt_dk = 1 / 1.4;
