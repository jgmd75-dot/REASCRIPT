    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != bt_sr ? bt_srinit();
bt_now = time_precise();
bt_tp > 0 && bt_now - bt_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > bt_gpp && play_position - bt_gpp < 4 * bt_gpd + 0.05) ? ( bt_clear(); bt_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
bt_tp = bt_now; bt_gpp = play_position; bt_gpd = samplesblock / srate;
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
bt_tgt(0, BT_T); bt_tgt(1, BT_T + 100);
bt_sum = 0; bt_i = 0; loop(29, bt_sum += BT_T[bt_i] * (bt_i + 1.37) + BT_T[100 + bt_i] * (bt_i + 2.11); bt_i += 1; );
bt_sum != bt_sum0 ? ( bt_sum0 = bt_sum; bt_agcalc(); );
bt_agon = slider46 >= 0.5;
bt_mdt = slider51 >= 0.5;
bt_lsn = floor(min(max(slider45, 0), 2) + 0.5);
bt_dft = min(max(slider47, 2200), 16000); bt_dam = min(max(slider48, 0), 100) / 100;
bt_dsht = slider49 >= 0.5; bt_gmt = slider50 >= 0.5;
bt_dthr = -4 - 14 * bt_dam; bt_dmax = 3 + 9 * bt_dam;
bt_denorm();
bt_ipl_d = max(bt_ipl_d, bt_ipl); bt_ipr_d = max(bt_ipr_d, bt_ipr); bt_opl_d = max(bt_opl_d, bt_opl); bt_opr_d = max(bt_opr_d, bt_opr);
bt_ipl = bt_ipr = bt_opl = bt_opr = 0;
bt_irl_d = bt_irl; bt_irr_d = bt_irr; bt_orl_d = bt_orl; bt_orr_d = bt_orr;
bt_dsg_d = min(bt_dsg_d, bt_dsm); bt_dsm = 0;
bt_ag_d = bt_agt;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
bt_xl = spl0; bt_xr = spl1;
bt_ipl = max(bt_ipl, abs(bt_xl)); bt_ipr = max(bt_ipr, abs(bt_xr));
bt_irl += bt_krm * (bt_xl * bt_xl - bt_irl); bt_irr += bt_krm * (bt_xr * bt_xr - bt_irr);
bt_mdt != bt_md ? ( bt_dk1 -= bt_dks; bt_dk1 <= 0 ? ( bt_dk1 = 0; bt_md = bt_mdt; bt_clear(); ); ) : bt_dk1 < 1 ? bt_dk1 = min(bt_dk1 + bt_dks, 1);
bt_a = bt_md ? 0.5 * (bt_xl + bt_xr) : bt_xl;
bt_b = bt_md ? 0.5 * (bt_xl - bt_xr) : bt_xr;
(bt_cn += 1) >= 8 ? (
  bt_cn = 0;
  bt_tick(0); bt_tick(1); bt_force = 0;
  bt_df += (bt_dft - bt_df) * bt_kg; bt_dsh += bt_dsht ? min(bt_ks, 1 - bt_dsh) : -min(bt_ks, bt_dsh);
  ds_set();
);
bt_gm += (bt_gmt - bt_gm) * bt_kl;
bt_guard = 1 - bt_gm * (1 - bt_g);
bt_ya = bt_chan(bt_a, 0, bt_guard);
bt_yb = bt_chan(bt_b, 1, bt_guard);
bt_dam > 0 || bt_dsg < -0.001 ? (
  bt_sa = dsA.ds_run(bt_ya); bt_sb = dsB.ds_run(bt_yb);
  bt_v = bt_sa * bt_sa + bt_sb * bt_sb; bt_es += (bt_v > bt_es ? bt_kda : bt_kdr) * (bt_v - bt_es);
  bt_v = bt_ya * bt_ya + bt_yb * bt_yb; bt_ef += (bt_v > bt_ef ? bt_kda : bt_kdr) * (bt_v - bt_ef);
  bt_dt = 0;
  bt_dam > 0 && bt_es > 0.000001 ? ( bt_r = 10 * log10(bt_es / max(bt_ef, 0.0000000001)) - bt_dthr; bt_r > 0 ? bt_dt = -min(bt_r * (1 + bt_dam), bt_dmax); );
  bt_dsg += (bt_dt < bt_dsg ? bt_kga : bt_kgr) * (bt_dt - bt_dsg);
  bt_dsg > -0.0001 && bt_dt == 0 ? bt_dsg = 0;
  bt_g = 10 ^ (bt_dsg / 20);
  bt_ya -= (1 - bt_g) * bt_sa; bt_yb -= (1 - bt_g) * bt_sb;
  bt_dsm = min(bt_dsm, bt_dsg);
) : ( bt_g = 1; dsA.c1 = dsA.c2 = dsA.l1 = dsB.c1 = dsB.c2 = dsB.l1 = 0; bt_es = bt_ef = 0; );
bt_ol = bt_md ? bt_ya + bt_yb : bt_ya; bt_or = bt_md ? bt_ya - bt_yb : bt_yb;
bt_wa += ((bt_lsn == 1) - bt_wa) * bt_kl; bt_wb += ((bt_lsn == 2) - bt_wb) * bt_kl;
bt_ol = (1 - bt_wa - bt_wb) * bt_ol + bt_wa * bt_ya + bt_wb * bt_yb;
bt_or = (1 - bt_wa - bt_wb) * bt_or + bt_wa * bt_ya + bt_wb * bt_yb;
bt_ag += ((bt_agon ? bt_agt : 1) - bt_ag) * bt_kag;
bt_z = bt_dk1 * bt_dk1 * (3 - 2 * bt_dk1) * bt_ag;
bt_ol *= bt_z; bt_or *= bt_z;
bt_ol != bt_ol ? bt_ol = 0; bt_or != bt_or ? bt_or = 0;
bt_fi < 1 ? (
  bt_fi = min(bt_fi + bt_fis, 1); bt_z = bt_fi * bt_fi * (3 - 2 * bt_fi);
  bt_ol = bt_xl + bt_z * (bt_ol - bt_xl); bt_or = bt_xr + bt_z * (bt_or - bt_xr);
);
ost_out(bt_ol, bt_or);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
bt_opl = max(bt_opl, abs(spl0)); bt_opr = max(bt_opr, abs(spl1));
bt_orl += bt_krm * (spl0 * spl0 - bt_orl); bt_orr += bt_krm * (spl1 * spl1 - bt_orr);
bt_vw = slider56;
BT_AN[bt_aw] = bt_vw >= 1.5 ? bt_yb : bt_vw >= 0.5 ? bt_ya : 0.5 * (spl0 + spl1);
bt_aw = (bt_aw + 1) & 8191; an_wp_d = bt_aw;

@gfx 1200 820
ui_begin(1200, 820);
BGP = 0xE8E0CB; BGS = 0xF0EADB; BGE = 0xA89E86; BGH = 0x101113; BGC = 0x5A2433; BGCS = 0x652A3A;
BGID = 0xC9CDD3; BGI2D = ui_mix(BGID, 0x27292D, 0.38); BGAD = 0xF0B848;
BGIL = 0x2A2620; BGI2L = ui_mix(BGIL, BGS, 0.30); BGAL = 0x9A5800;
function bg_ink(lt) ( BGI = lt ? BGIL : BGID; BGI2 = lt ? BGI2L : BGI2D; BGA = lt ? BGAL : BGAD; );
bg_ink(1);
BGTB = 0xB9BDC3; BGBD = 0xA9ADB3; BGRL = 0x3A3E44; BGTK = 0x16171A; BGBK = 0x1C1D20;
CB1 = 0xC08850; CB2 = 0x8EC6F0; CB3 = 0xC4B4E8; CB4 = 0xA8DCC0; CB5 = 0xEC7A6E;
CHP = 0xF2D45C; CLP = 0x2A2C30; CSU = 0xF5C89A; CTI = 0xC9CDD3; CAI = 0xEDE6CF; CGN = 0xD8DBE0;

sc != bg_fsc ? (
  bg_fsc = sc;
  bg_f10 = ui_fitfont(10, 15 * sc);
  bg_f11 = ui_fitfont(11, 16 * sc);
  bg_f12 = ui_fitfont(12, 11.5 * sc);
  bg_f13 = ui_fitfont(13, 14 * sc);
  bg_f14 = ui_fitfont(14, 27 * sc);
  bg_f15 = ui_fitfont(15, 11.5 * sc);
  bg_f16 = ui_fitfont(16, 12.5 * sc);
);
gfx_setfont(10, "Trebuchet MS", bg_f10, 'b'); gfx_setfont(11, "Trebuchet MS", bg_f11, 'b');
gfx_setfont(12, "Trebuchet MS", bg_f12, 'b'); gfx_setfont(13, "Trebuchet MS", bg_f13, 'b');
gfx_setfont(14, "Trebuchet MS", bg_f14, 'b'); gfx_setfont(15, "Trebuchet MS", bg_f15, 'b');
gfx_setfont(16, "Trebuchet MS", bg_f16, 'b');

function bg_mag(ty, g, q, x) local(a, x2, n, d, sa) (
  x2 = x * x;
  ty == 0 ? ( a = 10 ^ (g / 40); n = sqr(1 - x2) + sqr(x * a / q); d = sqr(1 - x2) + sqr(x / (a * q)); ) :
  ty == 1 ? ( a = 10 ^ (g / 40); sa = sqrt(a); n = a * a * (sqr(a - x2) + sqr(sa * x / q)); d = sqr(1 - a * x2) + sqr(sa * x / q); ) :
  ty == 2 ? ( a = 10 ^ (g / 40); sa = sqrt(a); n = a * a * (sqr(1 - a * x2) + sqr(sa * x / q)); d = sqr(a - x2) + sqr(sa * x / q); ) :
  ty == 3 ? ( n = x2 * x2; d = sqr(1 - x2) + sqr(x / q); ) : ( n = 1; d = sqr(1 - x2) + sqr(x / q); );
  n / max(d, 0.0000000000000000001);
);
function bg_tiltm(s, f) local(i, g, f1, r, p) (
  r = p = 1;
  abs(s) > 0.00001 ? (
    g = 10 ^ (s * 1.5 / 20); i = 0;
    loop(6, f1 = 40 * 2 ^ (1.5 * i) * sqrt(g);
      r *= (g * g * f * f + f1 * f1) / (f * f + f1 * f1); p *= (g * g * 435600 + f1 * f1) / (435600 + f1 * f1); i += 1; );
  );
  r / p;
);
function bg_p1(ty, fc, f) local(a1, x, hn, b0, b1, w, c, sn, nr, ni, dr, di, dd) (
  a1 = -exp(-2 * $pi * fc / srate); x = 0.5 * srate / fc;
  ty == 4 ? ( hn = 1 / sqrt(1 + x * x); b0 = 0.5 * ((1 + a1) + hn * (1 - a1)); b1 = 0.5 * ((1 + a1) - hn * (1 - a1)); ) :
            ( hn = x / sqrt(1 + x * x); b0 = 0.5 * hn * (1 - a1); b1 = -b0; );
  w = 2 * $pi * min(f, 0.4999 * srate) / srate; c = cos(w); sn = sin(w);
  nr = b0 + b1 * c; ni = -b1 * sn; dr = 1 + a1 * c; di = -a1 * sn; dd = dr * dr + di * di;
  bg_pre = (nr * dr + ni * di) / dd; bg_pim = (ni * dr - nr * di) / dd;
);
function bg_resp(t, f) local(b, p, x, k, re, im, d) (
  p = 1;
  t[28] >= 0.5 ? (
    b = 0;
    loop(5,
      abs(t[b * 4]) > 0.00001 ? (
        x = f / t[b * 4 + 1];
        p *= t[b * 4 + 3] >= 0.5 ? bg_mag(b == 0 ? 1 : 2, t[b * 4], 0.9, x) : bg_mag(0, t[b * 4], t[b * 4 + 2], x);
      );
      b += 1;
    );
    t[21] >= 0.5 ? p *= bg_mag(3, 0, 0.7071, f / t[20]);
    t[23] >= 0.5 ? p *= bg_mag(4, 0, 0.7071, f / t[22]);
    p *= bg_tiltm(t[25], f);
    re = 1; im = 0;
    k = 10 ^ (t[24] / 20) - 1; bg_p1(4, 33, f); re += k * bg_pre; im += k * bg_pim;
    k = 10 ^ (t[26] / 20) - 1; bg_p1(3, 22000, f); re += k * bg_pre; im += k * bg_pim;
    p *= re * re + im * im;
  );
  p;
);
function bg_tgt(c, t) local(o, b, gs, q, lo, hi) (
  o = c * 22; gs = min(max(slider53, 0), 200) / 100; b = 0;
  loop(5,
    lo = b < 2 ? 15 : b == 2 ? 120 : 400; hi = b < 2 ? 800 : b == 2 ? 8000 : 26000;
    t[b * 4] = min(max(slider(1 + o + 3 * b), -15), 15) * gs;
    t[b * 4 + 1] = min(max(slider(2 + o + 3 * b), lo), hi);
    q = slider(3 + o + 3 * b);
    t[b * 4 + 3] = (b == 0 || b == 4) && q < 0.35;
    t[b * 4 + 2] = min(max(q, 0.4), 4);
    b += 1;
  );
  t[20] = min(max(slider(16 + o), 11), 330); t[21] = slider(16 + o) > 11.5;
  t[22] = min(max(slider(20 + o), 3300), 22000); t[23] = slider(20 + o) < 21900;
  t[24] = min(max(slider(17 + o), 0), 10) * gs; t[25] = min(max(slider(18 + o), -1.5), 1.5) * gs;
  t[26] = min(max(slider(19 + o), 0), 10) * gs;
  t[27] = 10 ^ (min(max(slider(21 + o), -15), 15) / 20); t[28] = slider(22 + o) >= 0.5;
);

function bg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function bg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bg_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); bg_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function bg_plate(x, y, w, h, face, band) (
  bg_shadow(x, y, w, h);
  ui_col(BGE); bg_r(x, y, w, h);
  ui_col(face); bg_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, face == BGC ? 0.07 : 0.6); bg_r(x + 1, y + 1, w - 2, 1); bg_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, face == BGC ? 0.25 : 0.12); bg_r(x + 1, y + h - 3, w - 2, 2); bg_r(x + w - 3, y + 1, 2, h - 2);
  ui_col(band); bg_r(x + 1, y + 1, w - 2, 32);
  ui_cola(BGRL, 0.6); bg_r(x + 1, y + 33, w - 2, 1);
);
function bg_title(x, y, s) ( gfx_setfont(11); ui_col(BGBK); bg_ltxt(x + 14, y + 17, s); );
function bg_rivet(x, y) ( ui_cola(0x000000, 0.45); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x5C6068); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xA9AEB6); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );
function bg_led(cx, cy, r, col, lit) local(x, y, rr) (
  x = cx * sc; y = cy * sc; rr = r * sc;
  lit > 0 ? ( ui_cola(col, 0.18 * lit); gfx_circle(x, y, rr * 2.1, 1, 1); ui_cola(col, 0.22 * lit); gfx_circle(x, y, rr * 1.55, 1, 1); );
