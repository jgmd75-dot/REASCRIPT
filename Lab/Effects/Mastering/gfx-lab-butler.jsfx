#bt_pm = "Init|Gentle Polish|Warm Master|Air and Space|Mud Clean|Vocal Forward|Loud Pop|M/S Wide Top|Bright Tilt|Dark Tilt";
function bt_flat(c) local(o) (
  o = c * 22;
  slider(1 + o) = 0; slider(2 + o) = 55; slider(3 + o) = 0.3;
  slider(4 + o) = 0; slider(5 + o) = 220; slider(6 + o) = 1;
  slider(7 + o) = 0; slider(8 + o) = 1100; slider(9 + o) = 1;
  slider(10 + o) = 0; slider(11 + o) = 3300; slider(12 + o) = 1;
  slider(13 + o) = 0; slider(14 + o) = 11000; slider(15 + o) = 0.3;
  slider(16 + o) = 11; slider(17 + o) = 0; slider(18 + o) = 0; slider(19 + o) = 0; slider(20 + o) = 22000;
  slider(21 + o) = 0; slider(22 + o) = 1;
);
function bt_pb(c, b, g, f, q) ( slider(1 + c * 22 + 3 * b) = g; slider(2 + c * 22 + 3 * b) = f; slider(3 + c * 22 + 3 * b) = q; );
function bt_pv(c, k, v) ( slider(k + c * 22) = v; );
function bt_both() local(i) ( i = 1; loop(21, slider(i + 22) = slider(i); i += 1; ); );
function load_preset(p) local(i) (
  bt_flat(0); bt_flat(1);
  slider45 = 0; slider46 = 0; slider47 = 6600; slider48 = 0; slider49 = 0; slider50 = 1; slider51 = 0; slider52 = 1; slider53 = 100;
  p == 2 ? ( bt_pb(0, 0, 0.8, 55, 0.3); bt_pb(0, 2, -0.6, 1100, 0.7); bt_pb(0, 4, 1.2, 11000, 0.3); bt_pv(0, 19, 1.5); bt_both(); ) :
  p == 3 ? ( bt_pb(0, 0, 1.2, 88, 0.3); bt_pb(0, 1, -0.8, 330, 1.2); bt_pb(0, 4, -0.5, 11000, 0.3); bt_pv(0, 18, -0.2); bt_both(); ) :
  p == 4 ? ( bt_pb(0, 3, -0.5, 3300, 1.5); bt_pb(0, 4, 1.5, 9900, 0.3); bt_pv(0, 19, 2.5); bt_both(); slider48 = 30; ) :
  p == 5 ? ( bt_pb(0, 1, -1.5, 220, 1.4); bt_pb(0, 2, -0.8, 550, 1); bt_pv(0, 16, 22); bt_both(); ) :
  p == 6 ? ( bt_pb(0, 2, 1, 2200, 0.8); bt_pb(0, 3, 0.6, 4400, 1); bt_both(); slider48 = 40; ) :
  p == 7 ? ( bt_pb(0, 0, 1.5, 66, 0.3); bt_pb(0, 1, -0.7, 220, 1); bt_pb(0, 3, 0.7, 3300, 0.8); bt_pb(0, 4, 1.5, 11000, 0.3);
             bt_pv(0, 17, 2); bt_pv(0, 19, 2); bt_both(); slider48 = 50; ) :
  p == 8 ? ( slider51 = 1; slider52 = 0; bt_pb(0, 2, 0.5, 1100, 0.7);
             bt_pv(1, 16, 110); bt_pb(1, 4, 2, 11000, 0.3); bt_pv(1, 19, 1.5); ) :
  p == 9 ? ( bt_pv(0, 18, 0.3); bt_pv(0, 19, 1); bt_both(); ) :
  p == 10 ? ( bt_pv(0, 18, -0.3); bt_pv(0, 17, 1); bt_both(); );
  i = 1; loop(53, ui_auto(i); i += 1; );
);

function bt_srinit() local(i, f, r) (
  bt_sr = srate;
  bt_kg = 1 - exp(-8 / (0.03 * srate));
  bt_ks = 8 / (0.015 * srate);
  bt_kp = 1 - exp(-1 / (0.02 * srate));
  bt_kl = 1 - exp(-1 / (0.015 * srate));
  bt_kag = 1 - exp(-1 / (0.05 * srate));
  bt_kda = 1 - exp(-1 / (0.0005 * srate)); bt_kdr = 1 - exp(-1 / (0.03 * srate));
  bt_kga = 1 - exp(-1 / (0.001 * srate)); bt_kgr = 1 - exp(-1 / (0.06 * srate));
