function prs_hash() local(i, h) ( h = 0; i = 1; loop(57, i != 57 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k == 11 ? 1 : k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); );
    prs_cur_d = k == 11 ? 1 : k;
