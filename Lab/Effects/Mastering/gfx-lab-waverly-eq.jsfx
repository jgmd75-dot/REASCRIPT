desc:Waverly EQ [mastering EQ] (GFX Lab)
//tags: equaliser mastering EQ stepped transistor transformer iron stereo dual mono mid side shelf bell
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-amp, gfx-lab-os, gfx-lab-bypass (.jsfx-inc) in the same

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<0,2,1{1x,2x,4x}>-Oversampling
slider3:0<0,2,1{Stereo,Dual mono,Mid / Side}>-Mode
slider4:0<0,1,1{Off,On}>-Delta
slider5:1<0,2,1{Clean,Iron,Pushed}>-Amp
slider6:0<-12,12,0.5>-Trim (dB)
slider7:0<0,10,1{Off,22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,110 Hz,220 Hz,330 Hz}>-Ch 1 (L / M) high-pass
slider8:10<0,10,1{2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz,Off}>-Ch 1 (L / M) low-pass
slider9:0<-12,12,0.5>-Ch 1 (L / M) out (dB)
slider10:1<0,1,1{Out,In}>-Ch 1 (L / M) bass in
slider11:1<0,1,1{Bell,Shelf}>-Ch 1 (L / M) bass shape
slider12:3<0,6,1{33 Hz,44 Hz,55 Hz,77 Hz,110 Hz,220 Hz,330 Hz}>-Ch 1 (L / M) bass frequency
slider13:0<-5,5,0.25>-Ch 1 (L / M) bass gain (x1 scale)
slider14:0<0,1,1{x1,x3}>-Ch 1 (L / M) bass multiply
slider15:1<0,1,1{Out,In}>-Ch 1 (L / M) low presence in
slider16:3<0,7,1{330 Hz,440 Hz,550 Hz,880 Hz,1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz}>-Ch 1 (L / M) low presence frequency
slider17:0<-5,5,0.25>-Ch 1 (L / M) low presence gain (x1 scale)
slider18:0<0,1,1{x1,x3}>-Ch 1 (L / M) low presence multiply
slider19:1<0,1,1{Out,In}>-Ch 1 (L / M) high presence in
slider20:3<0,7,1{880 Hz,1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,8.8 kHz}>-Ch 1 (L / M) high presence frequency
slider21:0<-5,5,0.25>-Ch 1 (L / M) high presence gain (x1 scale)
slider22:0<0,1,1{x1,x3}>-Ch 1 (L / M) high presence multiply
slider23:1<0,1,1{Out,In}>-Ch 1 (L / M) treble in
slider24:1<0,1,1{Bell,Shelf}>-Ch 1 (L / M) treble shape
slider25:6<0,7,1{3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,11 kHz,22 kHz}>-Ch 1 (L / M) treble frequency
slider26:0<-5,5,0.25>-Ch 1 (L / M) treble gain (x1 scale)
slider27:0<0,1,1{x1,x3}>-Ch 1 (L / M) treble multiply
slider28:0<0,10,1{Off,22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,110 Hz,220 Hz,330 Hz}>-Ch 2 (R / S) high-pass
slider29:10<0,10,1{2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz,Off}>-Ch 2 (R / S) low-pass
slider30:0<-12,12,0.5>-Ch 2 (R / S) out (dB)
slider31:1<0,1,1{Out,In}>-Ch 2 (R / S) bass in
slider32:1<0,1,1{Bell,Shelf}>-Ch 2 (R / S) bass shape
slider33:3<0,6,1{33 Hz,44 Hz,55 Hz,77 Hz,110 Hz,220 Hz,330 Hz}>-Ch 2 (R / S) bass frequency
slider34:0<-5,5,0.25>-Ch 2 (R / S) bass gain (x1 scale)
slider35:0<0,1,1{x1,x3}>-Ch 2 (R / S) bass multiply
slider36:1<0,1,1{Out,In}>-Ch 2 (R / S) low presence in
slider37:3<0,7,1{330 Hz,440 Hz,550 Hz,880 Hz,1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz}>-Ch 2 (R / S) low presence frequency
slider38:0<-5,5,0.25>-Ch 2 (R / S) low presence gain (x1 scale)
slider39:0<0,1,1{x1,x3}>-Ch 2 (R / S) low presence multiply
slider40:1<0,1,1{Out,In}>-Ch 2 (R / S) high presence in
slider41:3<0,7,1{880 Hz,1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,8.8 kHz}>-Ch 2 (R / S) high presence frequency
slider42:0<-5,5,0.25>-Ch 2 (R / S) high presence gain (x1 scale)
slider43:0<0,1,1{x1,x3}>-Ch 2 (R / S) high presence multiply
slider44:1<0,1,1{Out,In}>-Ch 2 (R / S) treble in
slider45:1<0,1,1{Bell,Shelf}>-Ch 2 (R / S) treble shape
slider46:6<0,7,1{3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,11 kHz,22 kHz}>-Ch 2 (R / S) treble frequency
slider47:0<-5,5,0.25>-Ch 2 (R / S) treble gain (x1 scale)
slider48:0<0,1,1{x1,x3}>-Ch 2 (R / S) treble multiply
slider49:0<0,6,1{Off,33 Hz,55 Hz,77 Hz,110 Hz,220 Hz,330 Hz}>-Mono below
slider50:100<0,200,1>-Width (%)
slider51:0<0,1,1{Off,On}>-Profile A lo (steps below 200 Hz down a semitone)
slider52:0<0,1,1{Off,On}>-Profile A hi (steps below 632 Hz down a semitone)
slider53:0<0,1,1{Off,On}>-Profile B lo (steps above 632 Hz up a semitone)
slider54:0<0,1,1{Off,On}>-Profile B hi (steps above 2 kHz up a semitone)
slider55:prs_sel=0<0,10,1{No preset,Init,Master Sheen,Weight,Forward Vocal,Open Air,Clear the Mud,Bus Colour,Drum Snap,Tame the Top,MS Wide Top}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-amp.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-waverly-eq";
ext_noinit = 1;

FQT = 102000; OFS = 102100;
function ox_t8(p, a0, a1, a2, a3, a4, a5, a6, a7) ( p[0] = a0; p[1] = a1; p[2] = a2; p[3] = a3; p[4] = a4; p[5] = a5; p[6] = a6; p[7] = a7; );
function ox_t5(p, a0, a1, a2, a3, a4) ( p[0] = a0; p[1] = a1; p[2] = a2; p[3] = a3; p[4] = a4; );
ox_t8(FQT,       33,   44,   55,   77,  110,   220,   330,   330);
ox_t8(FQT + 8,  330,  440,  550,  880, 1100,  2200,  3300,  4400);
ox_t8(FQT + 16, 880, 1100, 2200, 3300, 4400,  5500,  6600,  8800);
ox_t8(FQT + 24, 3300, 4400, 5500, 6600, 7700, 8800, 11000, 22000);
ox_t8(FQT + 32,   0,   22,   33,   44,   55,    66,    77,    88); FQT[40] = 110; FQT[41] = 220; FQT[42] = 330;
ox_t8(FQT + 44, 2200, 3300, 4400, 5500, 6600, 7700, 8800, 9900); FQT[52] = 11000; FQT[53] = 22000; FQT[54] = 0;
ox_t5(OFS,      3,  4,  5,  6,  7);
ox_t5(OFS + 5,  8, -1,  9, 10, 11);
ox_t5(OFS + 10, 12, -1, 13, 14, 15);
ox_t5(OFS + 15, 16, 17, 18, 19, 20);
function ox_nst(b) ( b == 0 ? 7 : 8; );

function ox_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

OXB = 100000; OXS = 24;
OXF = 101000; OXFS = 8;

function ox_btick(p, b) local(f, g, k, a, sh) (
  p[18] = p[17] == p[16];
  p[11] < 0.0005 && p[17] != p[16] ? (
    p[16] = p[17]; p[0] = p[1] = 0; p[8] = p[12]; p[9] = p[13]; p[10] = p[14];
  );
  p[11] < 0.0005 && p[15] < 0.5 ? ( p[8] = p[12]; p[9] = p[13]; p[10] = p[14]; );
  p[8] += ox_kc * (p[12] - p[8]); p[9] += ox_kc * (p[13] - p[9]); p[10] += ox_kc * (p[14] - p[10]);
  f = min(2 ^ p[8], ox_fmax); g = tan($pi * f / srate);
  a = exp(abs(p[9]) * 0.05756462732485114);
  p[19] = p[9] < 0;
  sh = p[16] ? (b == 0 ? 1 : 2) : 0;
  sh == 0 ? ( k = 1 / (p[10] * a); p[5] = 0; p[6] = k * (a * a - 1); p[7] = 0; ) :
  sh == 1 ? ( g /= sqrt(a); k = 1 / p[10]; p[5] = 0; p[6] = k * (a - 1); p[7] = a * a - 1; ) :
            ( g *= sqrt(a); k = 1 / p[10]; p[5] = a * a - 1; p[6] = k * (1 - a) * a; p[7] = 1 - a * a; );
  p[2] = 1 / (1 + g * (g + k)); p[3] = g * p[2]; p[4] = g * p[3];
);
function ox_eq(u, c) local(p, v1, v2, v3, fb, sa, sb, d, y) (
  p = OXB + c * 4 * OXS; fb = sa = sb = 0;
  loop(4,
    p[11] += ox_kw * (p[15] * p[18] - p[11]);
    !p[19] ? (
      v3 = u - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
      p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
      fb += p[11] * (p[5] * u + p[6] * v1 + p[7] * v2);
    ) : (
      v1 = p[2] * p[0] - p[3] * p[1]; d = p[1] + p[3] * p[0] - p[4] * p[1];
      sa += p[11] * (p[6] * v1 + p[7] * d);
      sb += p[11] * (p[5] + p[6] * p[3] + p[7] * p[4]);
    );
    p += OXS;
  );
  y = (u + fb - sa) / (1 + sb);
  p = OXB + c * 4 * OXS;
  loop(4,
    p[19] ? (
      v3 = y - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
      p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
    );
    p += OXS;
  );
  y;
);
function ox_ftick(p) local(g) (
  p[4] < 0.0005 ? p[2] = p[3];
  p[2] += ox_kc * (p[3] - p[2]);
  g = tan($pi * min(2 ^ p[2], ox_fmax) / srate); p[1] = g / (1 + g);
);
function ox_flt(x, p, hp) local(v, lp) (
  p[4] += ox_ks * (p[5] - p[4]);
  v = (x - p[0]) * p[1]; lp = v + p[0]; p[0] = lp + v;
  x + p[4] * ((hp ? x - lp : lp) - x);
);
function ox_clr() local(i) (
  i = 0; loop(8, OXB[i * OXS] = OXB[i * OXS + 1] = 0; i += 1; );
  i = 0; loop(4, OXF[i * OXFS] = 0; i += 1; );
);
function ox_dn() local(i, p) (
  i = 0; loop(8, p = OXB + i * OXS; p[0] = ox_tn(p[0]); p[1] = ox_tn(p[1]); i += 1; );
  i = 0; loop(4, p = OXF + i * OXFS; p[0] = ox_tn(p[0]); i += 1; );
);
function ox_pf(f) local(al, ah, bl, bh, f0) (
  al = ox_pfa; ah = ox_pfb; bl = ox_pfc; bh = ox_pfd;
  f0 = f;
  al && f0 < 200 ? f *= 0.9438743; ah && f0 < 632.46 ? f *= 0.9438743;
  bl && f0 > 632.46 ? f *= 1.0594631; bh && f0 > 2000 ? f *= 1.0594631;
  !(bl || bh) && f0 > 10000 ? f *= 1.0293022;
  !(al || ah) && f0 < 90 ? f *= 0.9715319;
  f;
);
function ox_targets() local(c, b, p, q, o, i, m, sh) (
  c = 0;
  loop(2,
    q = 7 + c * 21; b = 0; ox_pfa = slider51 >= 0.5; ox_pfb = slider52 >= 0.5; ox_pfc = slider53 >= 0.5; ox_pfd = slider54 >= 0.5;
    loop(4,
      p = OXB + (c * 4 + b) * OXS; o = OFS + b * 5;
      p[15] = slider(q + o[0]) >= 0.5;
      sh = o[1] >= 0 ? slider(q + o[1]) >= 0.5 : 0; p[17] = sh;
      i = floor(min(max(slider(q + o[2]), 0), ox_nst(b) - 1) + 0.5);
      p[12] = log(ox_pf(FQT[b * 8 + i])) / log(2);
      m = slider(q + o[4]) >= 0.5;
      p[13] = floor(min(max(slider(q + o[3]), -5), 5) * 4 + 0.5) / 4 * (m ? 3 : 1);
      p[14] = sh ? (m ? 0.7 + 0.014 * abs(p[13]) : 0.5) : (m ? 0.8 + 0.04 * abs(p[13]) : 0.38 + 0.02 * abs(p[13]));
      b += 1;
    );
    i = floor(min(max(slider(q), 0), 10) + 0.5);
    p = OXF + c * 2 * OXFS; i > 0 ? p[3] = log(ox_pf(FQT[32 + i])) / log(2); p[5] = i > 0;
    i = floor(min(max(slider(q + 1), 0), 10) + 0.5);
    p = OXF + (c * 2 + 1) * OXFS; i < 10 ? p[3] = log(ox_pf(FQT[44 + i])) / log(2); p[5] = i < 10;
    c += 1;
  );
  ox_ogt0 = exp(floor(min(max(slider9, -12), 12) * 2 + 0.5) / 2 * 0.11512925464970228);
  ox_ogt1 = exp(floor(min(max(slider30, -12), 12) * 2 + 0.5) / 2 * 0.11512925464970228);
  ox_tgt = exp(floor(min(max(slider6, -12), 12) * 2 + 0.5) / 2 * 0.11512925464970228);
  ox_mst = slider3 >= 1.5; ox_dmt = slider4 >= 0.5;
  i = floor(min(max(slider49, 0), 6) + 0.5);
  ox_mbm = i > 0; i > 0 ? ox_mbt = log(i == 1 ? 33 : i == 2 ? 55 : i == 3 ? 77 : i == 4 ? 110 : i == 5 ? 220 : 330) / log(2);
  ox_wdt = min(max(slider50, 0), 200) / 100;
  i = floor(min(max(slider5, 0), 2) + 0.5);
  ox_dvt = i == 0 ? 0.01 : i == 1 ? 0.1 : 0.28;
  ox_dit = i == 0 ? 0.02 : i == 1 ? 0.45 : 1;
);
function ox_snapall() local(i, p) (
  i = 0; loop(8, p = OXB + i * OXS; p[8] = p[12]; p[9] = p[13]; p[10] = p[14]; p[16] = p[17]; p[18] = 1; p[11] = p[15];
    ox_btick(p, i & 3); i += 1; );
  i = 0; loop(4, p = OXF + i * OXFS; p[2] = p[3]; p[4] = p[5]; ox_ftick(p); i += 1; );
  ox_og0 = ox_ogt0; ox_og1 = ox_ogt1; ox_tg = ox_tgt; ox_msc = ox_mst; ox_dk = 1; ox_dm = ox_dmt; ox_dv = ox_dvt; ox_di = ox_dit;
  ox_mbf = ox_mbt; ox_mbx = ox_mbm; ox_wd = ox_wdt;
);

function ox_sat(x) instance(lo) local(y) (
  y = this.vt.am_tube(x * ox_dv, 0.2) * ox_idv;
  lo += ox_klo * (y - lo);
  y - lo + this.it.am_tube(lo * ox_di, 0.04) * ox_idi;
);
function ox_osclr() (
  upA.os_clr(); upB.os_clr(); dnA.os_clr(); dnB.os_clr(); vsA.lo = vsB.lo = 0;
  ox_klo = 1 - exp(-2 * $pi * 120 / (srate * os_f));
);
function ox_reset() (
  ox_clr(); ox_osclr(); memset(BY_BUF, 0, 2 * BY_N);
  ox_dxl = ox_dyl = ox_dxr = ox_dyr = 0; ox_s1 = ox_s2 = ox_s3 = 0;
  ox_fi = 0;
);

function ox_link() local(i) (
  i = 0;
  loop(21, slider(28 + i) != slider(7 + i) ? ( slider(28 + i) = slider(7 + i); slider_automate(2 ^ (27 + i)); ); i += 1; );
);

#ox_pm = "Init|Master Sheen|Weight|Forward Vocal|Open Air|Clear the Mud|Bus Colour|Drum Snap|Tame the Top|MS Wide Top";
function ox_pb(c, b, sh, f, g, m) local(q, o) (
  q = 7 + c * 21; o = OFS + b * 5;
  slider(q + o[0]) = 1; o[1] >= 0 ? slider(q + o[1]) = sh; slider(q + o[2]) = f; slider(q + o[3]) = g; slider(q + o[4]) = m;
);
function ox_pflat(c) local(q) (
  ox_pb(c, 0, 1, 3, 0, 0); ox_pb(c, 1, 0, 3, 0, 0); ox_pb(c, 2, 0, 3, 0, 0); ox_pb(c, 3, 1, 6, 0, 0);
  q = 7 + c * 21; slider(q) = 0; slider(q + 1) = 10; slider(q + 2) = 0;
);
function ox_pcp() local(i) ( i = 0; loop(21, slider(28 + i) = slider(7 + i); i += 1; ); );
function load_preset(p) local(i) (
  ox_pflat(0); ox_pflat(1); slider3 = 0; slider4 = 0; slider6 = 0; slider49 = 0; slider50 = 100;
  slider51 = slider52 = slider53 = slider54 = 0;
  p == 2 ? (  ox_pb(0, 0, 1, 1,  1,    0); ox_pb(0, 2, 0, 4,  0.75, 0); ox_pb(0, 3, 1, 7, 1.5, 0);
              slider7 = 1; slider51 = 1; slider54 = 1; ox_pcp(); ) :
  p == 3 ? (  ox_pb(0, 0, 1, 2,  2,    0); ox_pb(0, 1, 0, 2, -1,    0); slider7 = 1; slider51 = 1; slider52 = 1; ox_pcp(); ) :
  p == 4 ? (  ox_pb(0, 1, 0, 3, -1,    0); ox_pb(0, 2, 0, 3,  1.25, 1); ox_pb(0, 3, 1, 6, 1.5, 0);
              slider7 = 8; slider53 = 1; ox_pcp(); ) :
  p == 5 ? (  ox_pb(0, 3, 1, 7,  2.5,  0); ox_pb(0, 2, 0, 5, -0.5, 0); slider53 = 1; slider54 = 1; ox_pcp(); ) :
  p == 6 ? (  ox_pb(0, 1, 0, 1, -1.25, 1); ox_pb(0, 0, 1, 1,  0.75, 0); slider7 = 2; ox_pcp(); ) :
  p == 7 ? (  ox_pb(0, 0, 1, 4,  1.25, 0); ox_pb(0, 1, 0, 4,  0.5,  0); ox_pb(0, 3, 1, 3, -0.75, 0);
              slider6 = 3; ox_pcp(); ) :
  p == 8 ? (  ox_pb(0, 0, 0, 3,  1.25, 1); ox_pb(0, 1, 0, 2, -1,    1); ox_pb(0, 2, 0, 4, 1, 1);
              ox_pb(0, 3, 1, 6,  1,    0); slider51 = 1; slider53 = 1; ox_pcp(); ) :
  p == 9 ? (  ox_pb(0, 2, 0, 3, -0.75, 1); ox_pb(0, 3, 1, 3, -1,    0); slider8 = 8; ox_pcp(); ) :
  p == 10 ? ( slider3 = 2; ox_pb(0, 0, 1, 1, 0.75, 0); ox_pb(1, 3, 1, 6, 2, 0); ox_pb(1, 2, 0, 4, 0.75, 0);
              slider28 = 9; );
  i = 3; loop(52, i != 5 ? slider_automate(2 ^ (i - 1)); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function ox_srinit() (
  ox_sr = srate;
  ox_kc = 1 - exp(-16 / (0.03 * srate));
  ox_kw = 1 - exp(-1 / (0.008 * srate));
  ox_ks = 1 - exp(-1 / (0.012 * srate));
  ox_ko = 1 - exp(-1 / (0.03 * srate));
  ox_kd = 1 - exp(-1 / (0.015 * srate));
  ox_dks = 1 / (0.006 * srate);
  ox_dcc = 1 - 2 * $pi * 5 / srate;
  ox_fmax = 0.45 * srate; ox_fis = 1 / (0.01 * srate);
  ost_init(0);
  ox_clr(); ox_osclr();
);
os_design();
os_f = os_tf = os_f2n(slider2); os_base = 0;
ox_srinit();
os_gsetup();
ox_targets(); ox_snapall(); ox_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(55, i != 55 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(2));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != ox_sr ? ( ox_srinit(); ox_targets(); ox_snapall(); );
ox_now = time_precise();
ox_tp > 0 && ox_now - ox_tp > max(0.25, 4 * samplesblock / srate) ? ox_reset();
ox_tp = ox_now;
slider3 < 0.5 ? ox_link();
ox_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider2); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
ox_dn(); ox_s1 = ox_tn(ox_s1); ox_s2 = ox_tn(ox_s2); ox_s3 = ox_tn(ox_s3);
vsA.lo = ox_tn(vsA.lo); vsB.lo = ox_tn(vsB.lo);
ox_ol_d = max(ox_ol_d, ox_ol); ox_or_d = max(ox_or_d, ox_or); ox_ol = ox_or = 0;
os_snapb(slider(2));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
(ox_cn -= 1) <= 0 ? (
  ox_cn = 16;
  ox_i = 0; loop(8, ox_btick(OXB + ox_i * OXS, ox_i & 3); ox_i += 1; );
  ox_i = 0; loop(4, ox_ftick(OXF + ox_i * OXFS); ox_i += 1; );
);
ox_mst != ox_msc ? ( ox_dk = max(ox_dk - ox_dks, 0); ox_dk <= 0 ? ( ox_msc = ox_mst; ox_clr(); ); ) : ox_dk = min(ox_dk + ox_dks, 1);
ox_og0 += ox_ko * (ox_ogt0 - ox_og0); ox_og1 += ox_ko * (ox_ogt1 - ox_og1); ox_tg += ox_ko * (ox_tgt - ox_tg);
ox_dm += ox_kd * (ox_dmt - ox_dm);
ox_dv += ox_ko * (ox_dvt - ox_dv); ox_di += ox_ko * (ox_dit - ox_di); ox_idv = 1 / ox_dv; ox_idi = 1 / ox_di;
ox_xl = spl0 * ox_tg; ox_xr = spl1 * ox_tg;
ox_msc ? ( ox_a = 0.5 * (ox_xl + ox_xr); ox_b = 0.5 * (ox_xl - ox_xr); ) : ( ox_a = ox_xl; ox_b = ox_xr; );
ox_a = ox_eq(ox_flt(ox_flt(ox_a, OXF, 1), OXF + OXFS, 0), 0);
ox_b = ox_eq(ox_flt(ox_flt(ox_b, OXF + 2 * OXFS, 1), OXF + 3 * OXFS, 0), 1);
os_gate();
os_chg ? ( ox_osclr(); os_hold += 2 * samplesblock; );
upA.os_up(ox_a); upB.os_up(ox_b);
os_f == 1 ? (
  ox_a = vsA.ox_sat(upA.s0); ox_b = vsB.ox_sat(upB.s0);
) : os_f == 2 ? (
  ox_a = dnA.os_dn(vsA.ox_sat(upA.s0), vsA.ox_sat(upA.s1), 0, 0);
  ox_b = dnB.os_dn(vsB.ox_sat(upB.s0), vsB.ox_sat(upB.s1), 0, 0);
) : (
  ox_a = dnA.os_dn(vsA.ox_sat(upA.s0), vsA.ox_sat(upA.s1), vsA.ox_sat(upA.s2), vsA.ox_sat(upA.s3));
  ox_b = dnB.os_dn(vsB.ox_sat(upB.s0), vsB.ox_sat(upB.s1), vsB.ox_sat(upB.s2), vsB.ox_sat(upB.s3));
);
ox_z = ox_a - ox_dxl + ox_dcc * ox_dyl; ox_dxl = ox_a; ox_dyl = ox_z; ox_a = ox_z * ox_og0;
ox_z = ox_b - ox_dxr + ox_dcc * ox_dyr; ox_dxr = ox_b; ox_dyr = ox_z; ox_b = ox_z * ox_og1;
ox_msc ? ( ox_yl = ox_a + ox_b; ox_yr = ox_a - ox_b; ) : ( ox_yl = ox_a; ox_yr = ox_b; );
ox_mbx += ox_ks * (ox_mbm - ox_mbx); ox_mbf += ox_ko * (ox_mbt - ox_mbf); ox_wd += ox_ko * (ox_wdt - ox_wd);
ox_mg = tan($pi * 2 ^ ox_mbf / srate); ox_m1 = ox_mg / (1 + ox_mg);
ox_sm = 0.5 * (ox_yl + ox_yr); ox_ss = 0.5 * (ox_yl - ox_yr);
ox_v1 = (ox_sm - ox_s3) * ox_m1; ox_v2 = ox_v1 + ox_s3; ox_s3 = ox_v2 + ox_v1;
ox_sm += ox_mbx * (ox_v2 - ox_sm - ox_sm + ox_v2);
ox_v1 = (ox_ss - ox_s1) * ox_m1; ox_v2 = ox_v1 + ox_s1; ox_s1 = ox_v2 + ox_v1; ox_v3 = ox_ss - ox_v2;
ox_v1 = (ox_v3 - ox_s2) * ox_m1; ox_v2 = ox_v1 + ox_s2; ox_s2 = ox_v2 + ox_v1; ox_v3 -= ox_v2;
ox_ss = (ox_ss - ox_mbx * (ox_v3 + ox_ss)) * ox_wd;
ox_yl = ox_sm + ox_ss; ox_yr = ox_sm - ox_ss;
ox_z = ox_dk * ox_dk * (3 - 2 * ox_dk); ox_yl *= ox_z; ox_yr *= ox_z;
ox_ql = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)];
ox_qr = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
ox_yl -= ox_dm * ox_ql; ox_yr -= ox_dm * ox_qr;
ox_z = os_g * os_g * (3 - 2 * os_g); ox_yl *= ox_z; ox_yr *= ox_z;
ox_yl != ox_yl ? ox_yl = 0; ox_yr != ox_yr ? ox_yr = 0;
ox_fi < 1 ? (
  ox_fi = min(ox_fi + ox_fis, 1); ox_z = ox_fi * ox_fi * (3 - 2 * ox_fi);
  ox_yl = ox_ql + ox_z * (ox_yl - ox_ql); ox_yr = ox_qr + ox_z * (ox_yr - ox_qr);
