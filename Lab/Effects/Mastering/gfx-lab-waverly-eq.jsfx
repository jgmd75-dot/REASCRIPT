ost_out(ox_yl, ox_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
ox_ol = max(ox_ol, abs(spl0)); ox_or = max(ox_or, abs(spl1));

@gfx 1400 800
ui_begin(1400, 800);
OXFACE = 0xB4A792; OXCHAM = 0xD2C7B6; OXDARK = 0xC7BEB3; OXBODY = 0x4A3328; OXHDR = 0x4A3E34;
OXS1 = 0xE8DCC0; OXS2 = 0xC09060; OXS3 = 0x8E4A2E; OXVFD = 0xFFC860; OXVFD2 = 0xE8DCC0;
OXINK = 0x2A221C; OXINK2 = 0x5A5048; OXLIT = 0x9A4A1A; ox_dotc = 0x4A4038;
OXLO = 0xC08850; OXLM = 0x8EC6F0; OXHM = 0x8FD3A0; OXHI = 0xEC7A6E; OXHP = 0xF2D06B; OXGRY = 0xD8D2C8;

sc != ox_fsc ? (
  ox_fsc = sc;
  ox_f20 = ui_fitarial(10, 14 * sc);
  ox_f21 = ui_fitarial(11, 12 * sc);
  ox_f22 = ui_fitarial(12, 13 * sc);
  ox_f23 = ui_fitarial(13, 11 * sc);
);
function ox_font(i) (
  i == 20 ? gfx_setfont(10, "Arial", ox_f20, 'b') : i == 21 ? gfx_setfont(11, "Arial", ox_f21, 'b') :
  i == 22 ? gfx_setfont(12, "Arial", ox_f22, 'b') : gfx_setfont(13, "Arial", ox_f23, 'b');
);
function ox_black(sz, fl) ( gfx_setfont(14, "Arial Black", sz * sc * ox_f20 / (14 * sc), fl); );
function ox_lx_kdot(cx, cy, a, capr) local(x, y, rd) (
  rd = max(capr * 0.19, 2 * sc); x = cx + sin(a) * capr * 0.62; y = cy - cos(a) * capr * 0.62; gfx_circle(x, y, rd, 1, 1);
);
function ox_x(v) ( v * sc; );
function ox_rect(x, y, w, h) local(x0, y0) ( x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); gfx_rect(x0, y0, max(1, floor((x + w) * sc + 0.5) - x0), max(1, floor((y + h) * sc + 0.5) - y0)); );
function ox_rr(x, y, w, h, r) local(x0, y0, ww, hh, rad, rdi, i, dy, ins, ci, fr, a0, yt, yb) (
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); ww = floor(w * sc + 0.5); hh = floor(h * sc + 0.5);
  rad = min(r * sc, min(ww, hh) * 0.5); rdi = ceil(rad); a0 = gfx_a;
  gfx_rect(x0, y0 + rdi, ww, hh - 2 * rdi);
  i = 0; loop(rdi,
    dy = rad - (i + 0.5); ins = dy > 0 ? rad - sqrt(max(rad * rad - dy * dy, 0)) : 0; ci = ceil(ins); fr = ci - ins;
    yt = y0 + i; yb = y0 + hh - 1 - i;
    gfx_a = a0; gfx_rect(x0 + ci, yt, ww - 2 * ci, 1); gfx_rect(x0 + ci, yb, ww - 2 * ci, 1);
    ci > 0 && fr > 0.02 ? ( gfx_a = a0 * fr; gfx_rect(x0 + ci - 1, yt, 1, 1); gfx_rect(x0 + ww - ci, yt, 1, 1); gfx_rect(x0 + ci - 1, yb, 1, 1); gfx_rect(x0 + ww - ci, yb, 1, 1); );
    i += 1; );
  gfx_a = a0;
);
function ox_disc(x, y, r) ( gfx_circle(x * sc, y * sc, r * sc, 1, 1); );
function ox_ctxt(cx, cy, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = cx * sc - w * 0.5; gfx_y = cy * sc - h * 0.5; gfx_drawstr(s); );
function ox_ltxt(x, cy, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc; gfx_y = cy * sc - h * 0.5; gfx_drawstr(s); );
function ox_rtxt(x, cy, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x * sc - w; gfx_y = cy * sc - h * 0.5; gfx_drawstr(s); );
function ox_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function ox_fstr(f) local(v) (
  f < 1000 ? sprintf(#oxfq, "%d Hz", floor(f + 0.5)) : (
    v = f / 1000;
    abs(v - floor(v + 0.5)) < 0.001 ? sprintf(#oxfq, "%d kHz", floor(v + 0.5)) : sprintf(#oxfq, "%.1f kHz", v);
  );
  #oxfq;
);
function ox_bevel(x, y, w, h, b, c, face, bg) (
  ui_col(ui_mix(bg, 0, 0.30)); ox_rect(x + 1, y + h, w, 1); ox_rect(x + w, y + 1, 1, h);
  ui_col(ui_mix(bg, 0, 0.12)); ox_rect(x + 2, y + h + 1, w, 1); ox_rect(x + w + 1, y + 2, 1, h);
  ui_col(ui_mix(c, 0, 0.55)); ox_rect(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.24)); ox_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.12)); ox_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0, 0.28)); ox_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0, 0.45)); ox_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(face); ox_rect(x + b, y + b, w - 2 * b, h - 2 * b);
);
function ox_well(x, y, w, h, b, c, face) (
  ui_col(ui_mix(c, 0, 0.42)); ox_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0, 0.28)); ox_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0xFFFFFF, 0.10)); ox_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.22)); ox_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(face); ox_rect(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(ui_mix(face, 0, 0.35)); ox_rect(x + b, y + b, w - 2 * b, 2); ox_rect(x + b, y + b, 2, h - 2 * b);
);
function ox_vign(x, y, w, h, face, amt, d, bot) local(x0, y0, x1, y1, n, i, t) (
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5); n = max(floor(d * sc + 0.5), 2);
  i = 0; loop(n, t = 1 - i / n; ui_col(ui_mix(face, 0, amt * t * t));
    bot ? gfx_rect(x0, y1 - 1 - i, x1 - x0 - i, 1); gfx_rect(x1 - 1 - i, y0, 1, y1 - y0 - (bot ? i + 1 : 0)); i += 1; );
);
function ox_tline(x1, y1, x2, y2, th) local(n, i, t) (
  n = max(ceil(sqrt(sqr(x2 - x1) + sqr(y2 - y1)) * sc * 2), 1); i = 0;
  while (i <= n) ( t = i / n; gfx_circle((x1 + (x2 - x1) * t) * sc, (y1 + (y2 - y1) * t) * sc, th * sc * 0.5, 1, 1); i += 1; );
);
function ox_glyph(x, y, t) local(i) (
  t == 0 ? ( i = 0; loop(12, ox_tline(x + i * 2, y + 6 * sin(i * 0.9), x + i * 2 + 2, y + 6 * sin((i + 1) * 0.9), 1.6); i += 1; ); )
  : t == 1 ? ( i = 0; loop(12, ox_tline(x + i * 2, y + 5 - 9 / (1 + exp(-(i - 6))), x + i * 2 + 2, y + 5 - 9 / (1 + exp(-(i - 5))), 1.6); i += 1; ); )
  : ( i = 0; loop(5, ox_rect(x + i * 5, y + 6 - (i + 1) * 2.4, 3, (i + 1) * 2.4); i += 1; ); );
);
function ox_sub(x, y, w, h, n, s, tc, g) (
  ox_bevel(x, y, w, h, 7, OXCHAM, OXDARK, OXFACE);
  ui_col(ui_mix(OXDARK, 0, 0.3)); ox_rect(x + 10, y + 41, w - 20, 1);
  ui_col(tc); ox_rect(x + 7, y + 7, w - 14, 28); ui_col(ui_mix(tc, 0, 0.25)); ox_rect(x + 7, y + 33, w - 14, 2);
  strlen(n) ? ( ui_col(0xF4F6F8); ox_rect(x + 13, y + 12, 28, 18); ui_col(0x1A1A1C); ox_black(12, 0); ox_ctxt(x + 27, y + 21, n); );
  ui_col(0x1A1A1C); ox_black(13, 'i'); ox_ltxt(x + (strlen(n) ? 49 : 15), y + 21, s);
  g >= 0 ? ( ui_col(0x1A1A1C); ox_glyph(x + w - 41, y + 21, g); );
  ui_col(0x4A4D52); ox_disc(x + 13, y + h - 13, 3); ox_disc(x + w - 13, y + h - 13, 3);
  ui_col(0x8A8E94); ox_disc(x + 12.5, y + h - 13.5, 1.8); ox_disc(x + w - 13.5, y + h - 13.5, 1.8);
);

ox_lock = 0; ox_nd = 0;
function ox_cap(cx, cy, r, a, act, pc, nd, ctr) local(i, t, x, y, rr, rd) (
  x = cx * sc; y = cy * sc; rr = r * sc; rd = rr + 8 * sc;
  ui_col(ox_dotc); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(x + sin(t) * rd, y - cos(t) * rd, (i == 0 || i == nd || (ctr && i * 2 == nd) ? 2.0 : 1.4) * sc, 1, 1); i += 1; );
  i = 1; loop(2, ui_col(ui_mix(OXDARK, 0, 0.18 + (2 - i) * 0.12)); gfx_circle(x + i * sc, y + i * 1.5 * sc, rr + 2.5 * sc, 1, 1); i += 1; );
  ui_col(0x5C6064); gfx_circle(x, y, rr + 2.5 * sc, 1, 1);
  ui_col(act ? 0xB4B9BE : 0x9DA2A7); gfx_circle(x - 0.4 * sc, y - 0.5 * sc, rr + 1.9 * sc, 1, 1);
  ui_col(0x6E7277); gfx_circle(x + 0.3 * sc, y + 0.4 * sc, rr + 1.6 * sc, 1, 1);
  ui_col(0x1B1C1E); gfx_circle(x, y, rr + 0.6 * sc, 1, 1);
  ui_col(act ? 0x34373B : 0x2A2C30); gfx_circle(x, y, rr - 0.4 * sc, 1, 1);
  i = 0; loop(4, ui_cola(0x000000, 0.10 * (1 - i / 4)); gfx_circle(x, y, rr - 0.4 * sc - i * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, 0.16); ui_ssarc(x, y, rr - 1.6 * sc, -1.9, -0.4, 1.1 * sc);
  ui_col(pc); ox_lx_kdot(x, y, a, rr);
);
function ox_knob(cx, cy, r, idx, lo, hi, st, def, pc) local(v, n, dx, dy, hov, did, act, nd, tr) (
  did = 1900 + idx; v = slider(idx); nd = floor((hi - lo) / st + 0.5);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = !ox_lock && dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - ox_lt < 0.35 && ox_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; ox_lt = 0; ) : (
      drag_id = did; ox_my = mouse_y; ox_dz = 0; ox_lt = time_precise(); ox_lid = idx; ox_n = (v - lo) / (hi - lo);
    );
  );
  drag_id == did ? (
    ox_dz += abs(ox_my - mouse_y);
    ox_dz > 3 * sc ? (
      tr = (mouse_cap & 8) ? 1000 : nd > 20 ? 200 : max(160, nd * 9);
      ox_n = min(max(ox_n + (ox_my - mouse_y) / (tr * sc), 0), 1);
      v = lo + floor(ox_n * nd + 0.5) * st;
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    ox_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    slider(idx) = min(max(lo + (floor((v - lo) / st + 0.5) + sign(mouse_wheel)) * st, lo), hi);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max((v - lo) / (hi - lo), 0), 1);
  act = hov || drag_id == did;
  ox_cap(cx, cy, r, -0.75 * $pi + n * 1.5 * $pi, act, pc, ox_nd > 0 ? ox_nd : nd, ox_ctr);
  ox_nd = 0; ox_ctr = 0;
  act;
);
function ox_name(cx, y, act, name, val) ( ox_font(20); ui_col(act ? OXLIT : OXINK); ox_ctxt(cx, y, act ? val : name); );
function ox_ends(cx, cy, r, lo, hi) ( ox_font(21); ui_col(OXINK2); ox_ctxt(cx - (r + 8) * 0.7071 - 4, cy + (r + 8) * 0.7071 + 12, lo); ox_ctxt(cx + (r + 8) * 0.7071 + 4, cy + (r + 8) * 0.7071 + 12, hi); );
function ox_rbox(cx, y, w, h, s, lit) local(x) (
  x = cx - w / 2;
  ui_col(0x0A0B0C); ox_rect(x - 1, y - 1, w + 2, h + 2);
  ui_col(lit ? 0xE8E0CB : 0x8E8A80); ox_rect(x, y, w, h);
  ui_cola(0x000000, 0.22); ox_rect(x, y, w, 2); ox_rect(x, y, 2, h);
  ox_font(22); ui_col(0x1E1A16); ox_ctxt(cx, y + h / 2 + 0.5, s);
);
function ox_key(x, y, w, on, lc, s) local(hov, hit) (
  hov = !ox_lock && mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + 36) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(ui_mix(OXDARK, 0, 0.25)); ox_rr(x - 1, y - 0.5, w + 4, 41, 4);
  ui_col(0x0E0F10); ox_rr(x - 2, y - 2, w + 4, 40, 4);
  ui_col(0x1A1B1D); ox_rr(x, y, w, 36, 3);
  ui_col(0x45484D); ox_rr(x, y, w - 1, 35, 3);
  ui_col(0x2C2E32); ox_rr(x + 1, y + 1, w - 2, 34, 3);
  ui_col(hov ? 0x3B3E42 : 0x34363A); ox_rr(x + 1, y + 1, w - 2, 28, 3);
  ui_col(0x3E4146); ox_rect(x + 4, y + 1, w - 8, 1);
  on ? ( ui_cola(lc, 0.3); ox_rr(x + w / 2 - 14, y + 4, 28, 12, 3); ui_col(ui_mix(lc, 0xFFFFFF, 0.25)); ox_rr(x + w / 2 - 11, y + 6, 22, 8, 2); )
     : ( ui_col(ui_mix(lc, 0x1E2023, 0.75)); ox_rr(x + w / 2 - 11, y + 6, 22, 8, 2); );
  ox_font(20); ui_col(0xE8EBEE); ox_ctxt(x + w / 2, y + 24, s);
  hit;
);
function ox_pkey(x, y, w, on, lc, s) local(hov, hit, h, lx, ly) (
  h = 26; lx = x + 14; ly = y + h / 2;
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(ui_mix(OXDARK, 0, 0.25)); ox_rr(x - 1, y - 0.5, w + 4, h + 5, 4);
  ui_col(0x0E0F10); ox_rr(x - 2, y - 2, w + 4, h + 4, 4);
  ui_col(0x45484D); ox_rr(x, y, w - 1, h - 1, 3);
  ui_col(0x1A1B1D); ox_rr(x + 1, y + 1, w - 1, h - 1, 3);
  ui_col(hov ? 0x3B3E42 : 0x34363A); ox_rr(x + 1, y + 1, w - 2, h - 2, 3);
  ui_col(0x3E4146); ox_rect(x + 4, y + 1, w - 8, 1);
  ui_col(0x0E0F10); ox_disc(lx, ly, 4.6);
  on ? ( ui_cola(lc, 0.25); ox_disc(lx, ly, 7); ui_col(lc); ox_disc(lx, ly, 3.5); ui_col(ui_mix(lc, 0xFFFFFF, 0.7)); ox_disc(lx - 1, ly - 1, 1.2); )
     : ( ui_col(ui_mix(lc, 0x1E2023, 0.75)); ox_disc(lx, ly, 3.5); );
  ox_font(20); ui_col(0xE8EBEE); ox_ctxt(x + w / 2 + 6, ly, s);
  hit;
);
