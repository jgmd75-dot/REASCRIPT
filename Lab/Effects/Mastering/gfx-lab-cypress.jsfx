desc:Cypress [mastering compressor] (GFX Lab)
//tags: mastering compressor optical discrete vca two stage transformer iron mid side stereo bus glue
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass (.jsfx-inc) in the

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<0,2,1{1x,2x,4x}>-Oversampling
slider3:1<0,1,1{Off,On}>-Link
slider4:0<0,1,1{Left / right,Mid / side}>-Stereo mode
slider5:3<0,5,1{Off,44 Hz,66 Hz,88 Hz,110 Hz,220 Hz}>-SC filter
slider6:100<0,100,1>-Mix (%)
slider7:0<-12,12,0.1>-Output (dB)
slider8:1<0,1,1{Off,On}>-Unit 1 optical in
slider9:9<1,24,1>-Unit 1 optical threshold (step)
slider10:9<1,24,1>-Unit 1 optical gain (step)
slider11:1<0,1,1{Off,On}>-Unit 1 discrete in
slider12:18<1,24,1>-Unit 1 discrete threshold (step)
slider13:0<0,6,1{1.2,1.5,2,3,4,6,Flood}>-Unit 1 ratio
slider14:5<0,5,1{0.1 ms,0.3 ms,1 ms,3 ms,10 ms,30 ms}>-Unit 1 attack
slider15:0<0,5,1{0.1 s,0.25 s,0.4 s,0.8 s,1.2 s,Dual}>-Unit 1 recover
slider16:10<1,24,1>-Unit 1 discrete gain (step)
slider17:0<0,2,1{Nickel,Iron,Steel}>-Unit 1 iron
slider18:1<0,1,1{Off,On}>-Unit 2 optical in
slider19:9<1,24,1>-Unit 2 optical threshold (step)
slider20:9<1,24,1>-Unit 2 optical gain (step)
slider21:1<0,1,1{Off,On}>-Unit 2 discrete in
slider22:18<1,24,1>-Unit 2 discrete threshold (step)
slider23:0<0,6,1{1.2,1.5,2,3,4,6,Flood}>-Unit 2 ratio
slider24:5<0,5,1{0.1 ms,0.3 ms,1 ms,3 ms,10 ms,30 ms}>-Unit 2 attack
slider25:0<0,5,1{0.1 s,0.25 s,0.4 s,0.8 s,1.2 s,Dual}>-Unit 2 recover
slider26:10<1,24,1>-Unit 2 discrete gain (step)
slider27:0<0,2,1{Nickel,Iron,Steel}>-Unit 2 iron
slider28:prs_sel=0<0,10,1{No preset,Init,Gentle Master,Bus Glue,Opto Vocal,Steel Punch,Iron Colour,Steel Colour,Mid Side Glue,Parallel Smash,Dual Release Master}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-cypress";
ext_noinit = 1;

function cy_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function cy_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function cy_thr(p) ( -4 - (min(max(floor(p + 0.5), 1), 24) - 1) * 1.6; );
function cy_gdb(p) local(q) ( q = min(max(floor(p + 0.5), 1), 24); q <= 15 ? (q - 7) * 0.5 : 4 + (q - 15); );
function cy_ratio(i) ( i < 0.5 ? 1.2 : i < 1.5 ? 1.5 : i < 2.5 ? 2 : i < 3.5 ? 3 : i < 4.5 ? 4 : i < 5.5 ? 6 : 20; );
function cy_att(i) ( i < 0.5 ? 0.1 : i < 1.5 ? 0.3 : i < 2.5 ? 1 : i < 3.5 ? 3 : i < 4.5 ? 10 : 30; );
function cy_rec(i) ( i < 0.5 ? 0.1 : i < 1.5 ? 0.25 : i < 2.5 ? 0.4 : i < 3.5 ? 0.8 : 1.2; );
function cy_scf(i) ( i < 1.5 ? 44 : i < 2.5 ? 66 : i < 3.5 ? 88 : i < 4.5 ? 110 : 220; );

function cy_gc(lv, th, sl, kw) local(ov, k2) (
  ov = lv - th; k2 = kw * 0.5;
  ov <= -k2 ? 0 : ov >= k2 ? ov * sl : sl * sqr(ov + k2) / (2 * kw);
);

function cy_tgt(b) instance(toon, toth, tomk, tdon, tdth, tdsl, tdmk, tddu, dka, dkr, t55, t110, thf, tdr, tas, tev)
  local(ir) (
  toon = slider(b) >= 0.5; toth = cy_thr(slider(b + 1)); tomk = cy_gdb(slider(b + 2));
  tdon = slider(b + 3) >= 0.5; tdth = cy_thr(slider(b + 4)); tdsl = 1 - 1 / cy_ratio(slider(b + 5));
  dka = cy_tc(cy_att(slider(b + 6)));
  tddu = slider(b + 7) >= 4.5; dkr = cy_tc(1000 * cy_rec(slider(b + 7)));
  tdmk = cy_gdb(slider(b + 8));
  ir = floor(min(max(slider(b + 9), 0), 2) + 0.5);
  t55  = ir == 2 ? 0.188 : ir == 1 ? 0.035 : 0;
  t110 = ir == 1 ? 0.122 : 0;
  thf  = ir == 0 ? 0.096 : ir == 2 ? -0.034 : 0;
  tdr  = ir == 2 ? 1.3 : ir == 1 ? 0.7 : 0.35;
  tas  = ir == 1 ? 0.12 : ir == 2 ? 0.03 : 0;
  tev  = ir == 1 ? 0.05 : 0;
);
function cy_snap() instance(oon, oth, omk, don, dth, dsl, dmk, ddu, g55, g110, ghf, dr, as, ev,
                             toon, toth, tomk, tdon, tdth, tdsl, tdmk, tddu, t55, t110, thf, tdr, tas, tev) (
  oon = toon; oth = toth; omk = tomk; don = tdon; dth = tdth; dsl = tdsl; dmk = tdmk; ddu = tddu;
  g55 = t55; g110 = t110; ghf = thf; dr = tdr; as = tas; ev = tev;
);
function cy_gl() instance(oon, oth, omk, don, dth, dsl, dmk, ddu, g55, g110, ghf, dr, as, ev, an, sa, idr,
                           toon, toth, tomk, tdon, tdth, tdsl, tdmk, tddu, t55, t110, thf, tdr, tas, tev) local(q) (
  oon += (toon - oon) * c_sw; don += (tdon - don) * c_sw; ddu += (tddu - ddu) * c_sw;
  oth += (toth - oth) * c_kn; omk += (tomk - omk) * c_kn;
  dth += (tdth - dth) * c_kn; dsl += (tdsl - dsl) * c_kn; dmk += (tdmk - dmk) * c_kn;
  g55 += (t55 - g55) * c_ir; g110 += (t110 - g110) * c_ir; ghf += (thf - ghf) * c_ir;
  dr += (tdr - dr) * c_ir; as += (tas - as) * c_ir; ev += (tev - ev) * c_ir;
  q = 1 + as * as; an = q * sqrt(q); sa = as / sqrt(q); idr = an / dr;
);
function cy_hp(x) instance(z1, z2) local(y) (
  y = cy_b0 * x + z1; z1 = cy_b1 * x - cy_a1 * y + z2; z2 = cy_b0 * x - cy_a2 * y;
  x + cy_scs * (y - x);
);
function cy_odet(x) instance(ms) local(h) ( h = this.oh.cy_hp(x); ms += cy_kms * (h * h - ms); ms; );
function cy_opto(m) instance(of, osl, oth) local(t) (
  t = cy_gc(10 * log10(max(m, 0.00000000001)) + 3.0103, oth, 0.5, 6);
  of += (t > of ? cy_koa : cy_kof) * (t - of);
  osl += (t > osl ? cy_ksa : 1 / (srate * (0.8 + 0.12 * osl))) * (t - osl);
  min(0.8 * of + 0.2 * osl, 30);
);
function cy_ddet(x) ( abs(this.dh.cy_hp(x)); );
function cy_disc(pk) instance(dg, dfa, dsa, dth, dsl, dka, dkr, ddu) local(t) (
  t = cy_gc(20 * log10(max(pk, 0.0000001)), dth, dsl, 3);
  dg += (t > dg ? dka : dkr) * (t - dg);
  dfa += (t > dfa ? dka : cy_kdf) * (t - dfa);
  dsa += (t > dsa ? cy_kdsa : cy_kdsr) * (t - dsa);
  min(dg + ddu * (0.8 * dfa + 0.2 * dsa - dg), 30);
);
function cy_ieq(x) instance(p1, p2, q1, q2, hl, g55, g110, ghf) local(v1, v2, v3, w1, w2, w3) (
  v3 = x - p2; v1 = cy_e1 * p1 + cy_e2 * v3; v2 = p2 + cy_e2 * p1 + cy_e3 * v3; p1 = 2 * v1 - p1; p2 = 2 * v2 - p2;
  w3 = x - q2; w1 = cy_f1 * q1 + cy_f2 * w3; w2 = q2 + cy_f2 * q1 + cy_f3 * w3; q1 = 2 * w1 - q1; q2 = 2 * w2 - q2;
  hl += cy_khf * (x - hl);
  x + g55 * cy_ek * v1 + g110 * cy_fk * w1 + ghf * (x - hl);
);
function cy_sat(x) instance(lo, dr, sa, idr, as, ev) local(u, y) (
  lo += cy_klo * (x - lo);
  u = dr * lo + as;
  y = x - lo + (u / sqrt(1 + u * u) - sa) * idr;
  y + ev * y * y / (1 + abs(y));
);
function cy_clr() instance(ms, of, osl, dg, dfa, dsa, p1, p2, q1, q2, hl, lo, dx, dy) (
  ms = of = osl = dg = dfa = dsa = p1 = p2 = q1 = q2 = hl = lo = dx = dy = 0;
  this.oh.z1 = this.oh.z2 = this.dh.z1 = this.dh.z2 = 0;
);
function cy_den() instance(ms, p1, p2, q1, q2, hl, lo) (
  ms = cy_tn(ms); p1 = cy_tn(p1); p2 = cy_tn(p2); q1 = cy_tn(q1); q2 = cy_tn(q2); hl = cy_tn(hl); lo = cy_tn(lo);
  this.oh.z1 = cy_tn(this.oh.z1); this.oh.z2 = cy_tn(this.oh.z2);
  this.dh.z1 = cy_tn(this.dh.z1); this.dh.z2 = cy_tn(this.dh.z2);
);

function cy_osclr() ( oxA.os_clr(); oxB.os_clr(); odA.os_clr(); odB.os_clr(); uA.lo = uB.lo = 0;
  cy_klo = 1 - exp(-2 * $pi * 200 / (srate * os_f)); );
function cy_reset() (
  cy_osclr(); memset(BY_BUF, 0, 2 * BY_N);
  uA.cy_clr(); uB.cy_clr();
  in_dxL = in_dyL = in_dxR = in_dyR = 0;
  cy_fi = 0;
);

#cy_pm = "Init|Gentle Master|Bus Glue|Opto Vocal|Steel Punch|Iron Colour|Steel Colour|Mid Side Glue|Parallel Smash|Dual Release Master";
function cy_u(b, oi, ot, og, di, dt, ra, at, rc, dg, ir) (
  slider(b) = oi; slider(b + 1) = ot; slider(b + 2) = og; slider(b + 3) = di; slider(b + 4) = dt;
  slider(b + 5) = ra; slider(b + 6) = at; slider(b + 7) = rc; slider(b + 8) = dg; slider(b + 9) = ir;
);
function cy_m(lk, ms, sf, mx, ou) local(i) (
  slider3 = lk; slider4 = ms; slider5 = sf; slider6 = mx; slider7 = ou;
  lk ? ( i = 0; loop(10, slider(18 + i) = slider(8 + i); i += 1; ); );
);
function load_preset(p) local(i) (
  p == 1  ? ( cy_u(8,  1,  9,  9,  1, 18,  0,  5,  0, 10,  0); cy_m(1, 0, 3, 100, 0); ) :
  p == 2  ? ( cy_u(8,  1,  8,  8,  1, 16,  0,  5,  0,  9,  1); cy_m(1, 0, 3, 100, 0); ) :
  p == 3  ? ( cy_u(8,  1, 10, 10,  1, 13,  2,  4,  5, 11,  1); cy_m(1, 0, 3, 100, 0); ) :
  p == 4  ? ( cy_u(8,  1, 13, 15,  0, 10,  0,  5,  0,  7,  0); cy_m(1, 0, 0, 100, 0); ) :
  p == 5  ? ( cy_u(8,  0, 12,  7,  1, 13,  3,  4,  1, 15,  2); cy_m(1, 0, 4,  80, 0); ) :
  p == 6  ? ( cy_u(8,  0, 12,  7,  0, 10,  0,  5,  0,  7,  1); cy_m(1, 0, 3, 100, 0); ) :
  p == 7  ? ( cy_u(8,  0, 12,  7,  0, 10,  0,  5,  0,  7,  2); cy_m(1, 0, 3, 100, 0); ) :
  p == 8  ? ( cy_u(8,  1, 10,  9,  1, 15,  1,  5,  5, 11,  1);
              cy_u(18,  0, 12,  7,  1, 18,  2,  5,  5,  9,  0); cy_m(0, 1, 3, 100, 0); ) :
  p == 9  ? ( cy_u(8,  1, 15, 15,  1, 15,  6,  1,  0, 20,  2); cy_m(1, 0, 3,  35, 0); ) :
  p == 10 ? ( cy_u(8,  1,  9,  9,  1, 16,  1,  5,  5, 11,  1); cy_m(1, 0, 3, 100, 0); ) :
  p == 11 ? ( cy_u(8,  1,  9,  9,  1, 18,  0,  5,  0, 10,  0); cy_m(1, 0, 3, 100, 0); );
  i = 3; loop(5, ui_auto(i); i += 1; );
  i = 8; loop(20, ui_auto(i); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function cy_srinit() local(w, k, g) (
  cy_sr = srate;
  c_kn = cy_tc(30); c_sw = cy_tc(15); c_ir = cy_tc(20); c_lk = cy_tc(10);
  cy_kms = cy_tc(5);
  cy_kvu = cy_tc(80);
  cy_koa = cy_tc(10); cy_kof = cy_tc(60);
  cy_ksa = cy_tc(250);
  cy_kdf = cy_tc(100); cy_kdsa = cy_tc(250); cy_kdsr = cy_tc(1500);
  cy_dks = 1 / (0.006 * srate);
  cy_dcc = 1 - 2 * $pi * 5 / srate;
  cy_fis = 1 / (0.01 * srate);
  g = tan($pi * 55 / srate); cy_ek = 1 / 1.4; cy_e1 = 1 / (1 + g * (g + cy_ek)); cy_e2 = g * cy_e1; cy_e3 = g * cy_e2;
  g = tan($pi * 110 / srate); cy_fk = 1 / 0.7; cy_f1 = 1 / (1 + g * (g + cy_fk)); cy_f2 = g * cy_f1; cy_f3 = g * cy_f2;
  cy_khf = 1 - exp(-2 * $pi * min(14000, 0.45 * srate) / srate);
  cy_sci = -1;
  ost_init(0);
  cy_osclr();
);
os_design();
os_f = os_tf = os_f2n(slider2); os_base = 0;
cy_srinit();
os_gsetup();
in_init();
cy_snap = 1; cy_fi = 1; cy_dk = 1; cy_msc = slider4 >= 0.5;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(28, i != 28 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(2));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != cy_sr ? cy_srinit();
cy_now = time_precise();
cy_tp > 0 && cy_now - cy_tp > max(0.25, 4 * samplesblock / srate) ? cy_reset();
cy_tp = cy_now;
in_setup(0, 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider2); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
cy_lkt = slider3 >= 0.5;
cy_mst = slider4 >= 0.5;
uA.cy_tgt(8); uB.cy_tgt(cy_lkt ? 8 : 18);
cy_si = floor(min(max(slider5, 0), 5) + 0.5);
cy_si != cy_sci ? (
  cy_sci = cy_si; cy_sct = cy_si > 0;
  cy_si > 0 ? (
    cy_w = 2 * $pi * cy_scf(cy_si) / srate; cy_al = sin(cy_w) / (2 * 0.7071); cy_nrm = 1 / (1 + cy_al);
    cy_b0 = (1 + cos(cy_w)) * 0.5 * cy_nrm; cy_b1 = -2 * cy_b0; cy_a1 = -2 * cos(cy_w) * cy_nrm; cy_a2 = (1 - cy_al) * cy_nrm;
  );
);
cy_mxt = min(max(slider6, 0), 100) / 100;
cy_out_t = exp(0.11512925464970228 * min(max(slider7, -12), 12));
cy_snap ? ( uA.cy_snap(); uB.cy_snap(); cy_lk = cy_lkt; cy_scs = cy_sct; cy_mx = cy_mxt; cy_out = cy_out_t; cy_msc = cy_mst; );
cy_snap = 0;
uA.cy_den(); uB.cy_den(); cy_vo = cy_tn(cy_vo);
cy_goA_d = max(cy_goA_d, cy_goAm); cy_gdA_d = max(cy_gdA_d, cy_gdAm); cy_goB_d = max(cy_goB_d, cy_goBm); cy_gdB_d = max(cy_gdB_d, cy_gdBm);
cy_goAm = cy_gdAm = cy_goBm = cy_gdBm = 0;
cy_gr_d = max(uA.oon * uA.gro + uA.don * uA.grd, uB.oon * uB.gro + uB.don * uB.grd);
cy_vo_d = cy_vo;
os_snapb(slider(2));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
uA.cy_gl(); uB.cy_gl();
cy_lk += (cy_lkt - cy_lk) * c_lk; cy_scs += (cy_sct - cy_scs) * c_sw;
cy_mx += (cy_mxt - cy_mx) * c_kn; cy_out += (cy_out_t - cy_out) * c_kn;
cy_mst != cy_msc ? ( cy_dk = max(cy_dk - cy_dks, 0); cy_dk == 0 ? cy_msc = cy_mst; ) : cy_dk < 1 ? cy_dk = min(cy_dk + cy_dks, 1);
cy_dg = cy_dk * cy_dk * (3 - 2 * cy_dk);
cy_msc ? ( cy_a = (in_l + in_r) * 0.70710678; cy_b = (in_l - in_r) * 0.70710678; ) : ( cy_a = in_l; cy_b = in_r; );
cy_a *= cy_dg; cy_b *= cy_dg;
abs(cy_a) < 0.000000000000001 ? cy_a = 0; abs(cy_b) < 0.000000000000001 ? cy_b = 0;
cy_ma = uA.cy_odet(cy_a); cy_mb = uB.cy_odet(cy_b); cy_mm = max(cy_ma, cy_mb);
uA.gro = uA.cy_opto(cy_ma + cy_lk * (cy_mm - cy_ma)); uB.gro = uB.cy_opto(cy_mb + cy_lk * (cy_mm - cy_mb));
cy_a *= exp(0.11512925464970228 * uA.oon * (uA.omk - uA.gro));
cy_b *= exp(0.11512925464970228 * uB.oon * (uB.omk - uB.gro));
cy_pa = uA.cy_ddet(cy_a); cy_pb = uB.cy_ddet(cy_b); cy_mm = max(cy_pa, cy_pb);
uA.grd = uA.cy_disc(cy_pa + cy_lk * (cy_mm - cy_pa)); uB.grd = uB.cy_disc(cy_pb + cy_lk * (cy_mm - cy_pb));
cy_a *= exp(0.11512925464970228 * uA.don * (uA.dmk - uA.grd));
cy_b *= exp(0.11512925464970228 * uB.don * (uB.dmk - uB.grd));
cy_a = uA.cy_ieq(cy_a); cy_b = uB.cy_ieq(cy_b);
os_gate();
os_chg ? ( cy_osclr(); os_hold += 2 * samplesblock; );
oxA.os_up(cy_a); oxB.os_up(cy_b);
os_f == 1 ? (
  cy_ya = uA.cy_sat(oxA.s0); cy_yb = uB.cy_sat(oxB.s0);
) : os_f == 2 ? (
  cy_ya = odA.os_dn(uA.cy_sat(oxA.s0), uA.cy_sat(oxA.s1), 0, 0);
  cy_yb = odB.os_dn(uB.cy_sat(oxB.s0), uB.cy_sat(oxB.s1), 0, 0);
) : (
  cy_ya = odA.os_dn(uA.cy_sat(oxA.s0), uA.cy_sat(oxA.s1), uA.cy_sat(oxA.s2), uA.cy_sat(oxA.s3));
  cy_yb = odB.os_dn(uB.cy_sat(oxB.s0), uB.cy_sat(oxB.s1), uB.cy_sat(oxB.s2), uB.cy_sat(oxB.s3));
);
cy_msc ? ( cy_l = (cy_ya + cy_yb) * 0.70710678; cy_r = (cy_ya - cy_yb) * 0.70710678; ) : ( cy_l = cy_ya; cy_r = cy_yb; );
cy_z = cy_l - uA.dx + cy_dcc * uA.dy; uA.dx = cy_l; uA.dy = cy_z; cy_l = cy_z;
cy_z = cy_r - uB.dx + cy_dcc * uB.dy; uB.dx = cy_r; uB.dy = cy_z; cy_r = cy_z;
cy_xl = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)];
cy_xr = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
cy_l = (cy_xl + cy_mx * (cy_l - cy_xl)) * cy_out; cy_r = (cy_xr + cy_mx * (cy_r - cy_xr)) * cy_out;
cy_og = os_g * os_g * (3 - 2 * os_g);
cy_l *= cy_og; cy_r *= cy_og;
cy_l != cy_l ? cy_l = 0; cy_r != cy_r ? cy_r = 0;
cy_fi < 1 ? (
  cy_fi = min(cy_fi + cy_fis, 1); cy_z = cy_fi * cy_fi * (3 - 2 * cy_fi);
  cy_l = cy_xl + cy_z * (cy_l - cy_xl); cy_r = cy_xr + cy_z * (cy_r - cy_xr);
);
