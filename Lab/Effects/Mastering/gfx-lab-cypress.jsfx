          : gfx_triangle((cx + 5.5) * sc, cy * sc, (cx - 3.5) * sc, (cy - 5.5) * sc, (cx - 3.5) * sc, (cy + 5.5) * sc);
);
function cy_preset(x, y, w, cur) local(n, sel, open, gx, i) (
  n = pk_pcount(#cy_pm); sel = 0; open = 0;
  v5_pr && v5_drag == 0 && v5_hit(x, y, 34, 34) ? ( sel = cur <= 1 || cur > n ? n : cur - 1; v5_drag = -1; );
  v5_pr && v5_drag == 0 && v5_hit(x + 37, y, 34, 34) ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; v5_drag = -1; );
