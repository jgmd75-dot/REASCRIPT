function cy_title(x, cy, s) ( cy_ft(18); ui_col(CYI); cy_tl(x, cy, s); );

function cyg_thr(p) ( -4 - (min(max(floor(p + 0.5), 1), 24) - 1) * 1.6; );
function cyg_gdb(p) local(q) ( q = min(max(floor(p + 0.5), 1), 24); q <= 15 ? (q - 7) * 0.5 : 4 + (q - 15); );
function cyg_ratio(i) ( i < 0.5 ? 1.2 : i < 1.5 ? 1.5 : i < 2.5 ? 2 : i < 3.5 ? 3 : i < 4.5 ? 4 : i < 5.5 ? 6 : 20; );
function cyg_att(i) ( i < 0.5 ? 0.1 : i < 1.5 ? 0.3 : i < 2.5 ? 1 : i < 3.5 ? 3 : i < 4.5 ? 10 : 30; );
function cyg_rec(i) ( i < 0.5 ? 0.1 : i < 1.5 ? 0.25 : i < 2.5 ? 0.4 : i < 3.5 ? 0.8 : 1.2; );
function cyg_scf(i) ( i < 1.5 ? 44 : i < 2.5 ? 66 : i < 3.5 ? 88 : i < 4.5 ? 110 : 220; );
function cy_val(v, kind) (
  kind == 0 ? sprintf(#cy_hv, "%.1f dB", cyg_thr(v)) :
  kind == 1 ? sprintf(#cy_hv, "%+.1f dB", cyg_gdb(v)) :
  kind == 2 ? ( v >= 5.5 ? strcpy(#cy_hv, "20 : 1") : sprintf(#cy_hv, "%g : 1", cyg_ratio(v)); ) :
  kind == 3 ? sprintf(#cy_hv, "%g ms", cyg_att(v)) :
