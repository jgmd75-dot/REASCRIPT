  i = 0; loop(28, t = i / 28 * 2 * $pi; ui_col(0x2E3436); v5_ln(cx + sin(t) * r * 0.82, cy - cos(t) * r * 0.82, cx + sin(t) * r * 0.96, cy - cos(t) * r * 0.96, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.26 : 0.14); v5_arc(cx, cy, r - 0.6, -2.2, 0.6, 1);
