);

function cy_in(x, y, w, h, idx, lk) local(on) (
  on = lk ? slider(idx - 10) >= 0.5 : v5_toggle(idx, v5_hit(x, y, w, h));
  v5_edge(x, y, w, h, on, "IN", CYA);
);

function cy_led(cx, cy, r, col, lit) (
  lit ? ( ui_cola(col, 0.18); v5_d(cx, cy, r * 2.1); ui_cola(col, 0.22); v5_d(cx, cy, r * 1.55); );
