);
function cy_knob(cx, cy, r, idx, lo, hi, def, stp, cap, nd, lk, lbl, kind) local(n, src, v) (
  src = lk ? idx - 10 : idx;
  v5_step = stp;
  n = v5_ctl(idx, lo, hi, def, 0, !lk && v5_hitc(cx, cy, r + 9), 0, stp ? 160 : 200);
