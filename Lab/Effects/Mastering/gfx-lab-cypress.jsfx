    (d == 1 || d == 3 || d == 6 || d == 10 || d == 20) ? ( cy_ft(11); ui_col(CYI2); sprintf(#cyd, "%d", d); v5_t(x - 16, ly, #cyd); );
    cy_led(x + 2, ly, 3.1, d <= 3 ? 0x3A9CFF : d <= 6 ? 0x3CE05A : d <= 9 ? 0xFFC81E : d <= 14 ? 0xFF8A1E : 0xFF3A2A, g >= d - 0.5);
