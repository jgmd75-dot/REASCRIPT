function cy_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function cy_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  gfx_gradrect(x * sc, y * sc, w * sc, h * sc, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (h * sc), (g2 - g1) / (h * sc), (b2 - b1) / (h * sc), 0);
);
function cy_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function cy_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.12); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
