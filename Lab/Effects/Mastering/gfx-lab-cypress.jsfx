  kind == 5 ? ( v < 0.5 ? strcpy(#cy_hv, "OFF") : sprintf(#cy_hv, "%d Hz", cyg_scf(floor(v + 0.5))); ) :
  kind == 6 ? sprintf(#cy_hv, "%d %%", floor(v + 0.5)) :
  sprintf(#cy_hv, "%+.1f dB", v);
);
function cy_hover(cx, cy) ( cy_hon = 1; cy_hx = cx; cy_hy = cy; );

function cy_cap(cx, cy, r, n, cap, act, nd) local(a, i, t, rd) (
  a = -0.75 * $pi + n * 1.5 * $pi; rd = r + 8;
  i = 0; loop(nd, t = -0.75 * $pi + i / (nd - 1) * 1.5 * $pi; ui_col(CYI2);
    v5_d(cx + sin(t) * rd, cy - cos(t) * rd, i == 0 || i == nd - 1 ? 1.9 : 1.4); i += 1; );
