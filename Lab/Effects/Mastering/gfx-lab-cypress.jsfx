function cy_knob(cx, cy, r, idx, lo, hi, def, cap, nd) local(v, n, dx, dy, hov, did, act) (
  did = 1700 + idx; v = slider(cy_lock ? idx - 10 : idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = !cy_lock && dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - cy_lt < 0.35 && cy_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; cy_lt = 0; ) : (
      drag_id = did; cy_y = mouse_y; cy_dz = 0; cy_lt = time_precise(); cy_lid = idx; cy_n = cy_kn(v, lo, hi);
