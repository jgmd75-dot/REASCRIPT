function cy_hold(g) instance(h, t) ( g > h ? ( h = g; t = time_precise(); ) : time_precise() - t > 0.25 ? h += 0.35 * (g - h); h; );

function cy_rocker(x, y, w, h, sel, lk) local(i, t, hv, yy, hit) (
  t = h / 3; hit = -1;
  v5_shr(x - 4, y - 4, w + 8, h + 8, 3);
