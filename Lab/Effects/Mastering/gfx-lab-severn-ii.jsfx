  sg_fcol(c, 74, y);
  b = 0; loop(4, sg_split(132 + b * 172, y, 316); sg_band(c, b, 218 + b * 172, y); b += 1; );
  sg_split(820, y, 316);
  sg_ocol(c, 852, y);
);

