desc:SEVERN II [mastering EQ] (GFX Lab)
//tags: equaliser mastering EQ passive parallel valve tube transformer iron stereo mid side shelf bell
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-amp, gfx-lab-os, gfx-lab-bypass (.jsfx-inc) in the same

slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,2,1{1x,2x,4x}>-Oversampling
slider3:0<0,1,1{Left / Right,Mid / Side}>-Mode
slider4:1<0,1,1{Off,On}>-Link
slider5:0<0,1,1{Off,On}>-Delta
slider6:0<0,2,1{400 V,250 V,160 V}>-Supply rails
slider7:0<0,11,1{Off,11 Hz,22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz,220 Hz}>-Ch 1 (L / M) high-pass
slider8:9<0,9,1{3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz,Off}>-Ch 1 (L / M) low-pass
slider9:0<-12,12,0.5>-Ch 1 (L / M) gain (dB)
slider10:1<0,1,1{Out,In}>-Ch 1 (L / M) low in
slider11:1<0,1,1{Bell,Shelf}>-Ch 1 (L / M) low shape
slider12:4<0,10,1{22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,110 Hz,220 Hz,330 Hz,440 Hz}>-Ch 1 (L / M) low frequency
slider13:0<-20,20,0.5>-Ch 1 (L / M) low gain (dB)
slider14:40<0,100,1>-Ch 1 (L / M) low width (%)
slider15:1<0,1,1{Out,In}>-Ch 1 (L / M) low mid in
slider16:0<0,1,1{Bell,Shelf}>-Ch 1 (L / M) low mid shape
slider17:3<0,10,1{88 Hz,110 Hz,220 Hz,330 Hz,440 Hz,550 Hz,660 Hz,770 Hz,880 Hz,1.1 kHz,2.2 kHz}>-Ch 1 (L / M) low mid frequency
slider18:0<-20,20,0.5>-Ch 1 (L / M) low mid gain (dB)
slider19:40<0,100,1>-Ch 1 (L / M) low mid width (%)
slider20:1<0,1,1{Out,In}>-Ch 1 (L / M) high mid in
slider21:0<0,1,1{Bell,Shelf}>-Ch 1 (L / M) high mid shape
slider22:6<0,10,1{330 Hz,440 Hz,550 Hz,660 Hz,880 Hz,1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz}>-Ch 1 (L / M) high mid frequency
slider23:0<-20,20,0.5>-Ch 1 (L / M) high mid gain (dB)
slider24:40<0,100,1>-Ch 1 (L / M) high mid width (%)
slider25:1<0,1,1{Out,In}>-Ch 1 (L / M) high in
slider26:1<0,1,1{Bell,Shelf}>-Ch 1 (L / M) high shape
slider27:7<0,10,1{1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz}>-Ch 1 (L / M) high frequency
slider28:0<-20,20,0.5>-Ch 1 (L / M) high gain (dB)
slider29:40<0,100,1>-Ch 1 (L / M) high width (%)
slider30:0<0,11,1{Off,11 Hz,22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,99 Hz,110 Hz,220 Hz}>-Ch 2 (R / S) high-pass
slider31:9<0,9,1{3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz,Off}>-Ch 2 (R / S) low-pass
slider32:0<-12,12,0.5>-Ch 2 (R / S) gain (dB)
slider33:1<0,1,1{Out,In}>-Ch 2 (R / S) low in
slider34:1<0,1,1{Bell,Shelf}>-Ch 2 (R / S) low shape
slider35:4<0,10,1{22 Hz,33 Hz,44 Hz,55 Hz,66 Hz,77 Hz,88 Hz,110 Hz,220 Hz,330 Hz,440 Hz}>-Ch 2 (R / S) low frequency
slider36:0<-20,20,0.5>-Ch 2 (R / S) low gain (dB)
slider37:40<0,100,1>-Ch 2 (R / S) low width (%)
slider38:1<0,1,1{Out,In}>-Ch 2 (R / S) low mid in
slider39:0<0,1,1{Bell,Shelf}>-Ch 2 (R / S) low mid shape
slider40:3<0,10,1{88 Hz,110 Hz,220 Hz,330 Hz,440 Hz,550 Hz,660 Hz,770 Hz,880 Hz,1.1 kHz,2.2 kHz}>-Ch 2 (R / S) low mid frequency
slider41:0<-20,20,0.5>-Ch 2 (R / S) low mid gain (dB)
slider42:40<0,100,1>-Ch 2 (R / S) low mid width (%)
slider43:1<0,1,1{Out,In}>-Ch 2 (R / S) high mid in
slider44:0<0,1,1{Bell,Shelf}>-Ch 2 (R / S) high mid shape
slider45:6<0,10,1{330 Hz,440 Hz,550 Hz,660 Hz,880 Hz,1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz}>-Ch 2 (R / S) high mid frequency
slider46:0<-20,20,0.5>-Ch 2 (R / S) high mid gain (dB)
slider47:40<0,100,1>-Ch 2 (R / S) high mid width (%)
slider48:1<0,1,1{Out,In}>-Ch 2 (R / S) high in
slider49:1<0,1,1{Bell,Shelf}>-Ch 2 (R / S) high shape
slider50:7<0,10,1{1.1 kHz,2.2 kHz,3.3 kHz,4.4 kHz,5.5 kHz,6.6 kHz,7.7 kHz,8.8 kHz,9.9 kHz,11 kHz,22 kHz}>-Ch 2 (R / S) high frequency
slider51:0<-20,20,0.5>-Ch 2 (R / S) high gain (dB)
slider52:40<0,100,1>-Ch 2 (R / S) high width (%)
slider53:50<0,100,1>-Sheen (%)
slider54:0<0,100,1>-Depth (%)
slider55:prs_sel=0<0,10,1{No preset,Init,Weight and Tighten,Air Lift,Mastering Polish,Vocal Presence,Smooth Top,Warm Bus,Mud Out,Driven Valve,MS Wide Air}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-amp.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-severn-ii";
ext_noinit = 1;

FQT = 102000;
function sv_t11(p, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) (
  p[0] = a0; p[1] = a1; p[2] = a2; p[3] = a3; p[4] = a4; p[5] = a5; p[6] = a6; p[7] = a7; p[8] = a8; p[9] = a9; p[10] = a10;
);
sv_t11(FQT,      22,   33,   44,   55,   66,   77,   88,  110,  220,  330,   440);
sv_t11(FQT + 11, 88,  110,  220,  330,  440,  550,  660,  770,  880, 1100,  2200);
sv_t11(FQT + 22, 330, 440,  550,  660,  880, 1100, 2200, 3300, 4400, 5500,  6600);
sv_t11(FQT + 33, 1100, 2200, 3300, 4400, 5500, 6600, 7700, 8800, 9900, 11000, 22000);
sv_t11(FQT + 44, 0,   11,   22,   33,   44,   55,   66,   77,   88,   99,   110); FQT[55] = 220;
sv_t11(FQT + 56, 3300, 4400, 5500, 6600, 7700, 8800, 9900, 11000, 22000, 0, 0);

function sv_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

SVB = 100000; SVS = 32;
SVF = 101000; SVFS = 16;
sv_fk = 1 / 0.6;

function sv_btick(p, b) local(f, g, q, k, gg, a, t) (
  p[19] = p[18] == p[17];
  p[15] < 0.0005 && p[18] != p[17] ? (
    p[17] = p[18]; p[0] = p[1] = p[6] = p[7] = 0; p[12] = p[20]; p[13] = p[21]; p[14] = p[22];
  );
  p[15] < 0.0005 && p[16] < 0.5 ? ( p[12] = p[20]; p[13] = p[21]; p[14] = p[22]; );
  p[12] += sv_kc * (p[20] - p[12]); p[13] += sv_kc * (p[21] - p[13]); p[14] += sv_kc * (p[22] - p[14]);
  f = min(2 ^ p[12], sv_fmax); g = tan($pi * f / srate);
  gg = exp(p[13] * 0.11512925464970228);
  t = p[17] ? (b < 2 ? 1 : 2) : 0; p[25] = t;
  q = p[17] ? 0.5 * 4 ^ p[14] : 0.35 * 10 ^ p[14];
  k = 1 / q; a = sqrt(max(gg, 1));
  t == 0 ? ( p[26] = 0; p[27] = (a * a - 1) * k; p[28] = 0; ) :
  t == 1 ? ( g /= sqrt(a); p[26] = 0; p[27] = k * (a - 1); p[28] = a * a - 1; ) :
           ( g *= sqrt(a); p[26] = a * a - 1; p[27] = k * a * (1 - a); p[28] = 1 - a * a; );
  p[5] = k; p[2] = 1 / (1 + g * (g + k)); p[3] = g * p[2]; p[4] = g * p[3];
  g = tan($pi * f / srate); k = 1 / (p[17] ? q * 0.75 : q * 1.6); a = sqrt(max(1 / gg, 1));
  t == 0 ? ( p[29] = 0; p[30] = (a * a - 1) * k; p[31] = 0; ) :
  t == 1 ? ( g /= sqrt(a); p[29] = 0; p[30] = k * (a - 1); p[31] = a * a - 1; ) :
           ( g *= sqrt(a); p[29] = a * a - 1; p[30] = k * a * (1 - a); p[31] = 1 - a * a; );
  p[11] = k; p[8] = 1 / (1 + g * (g + k)); p[9] = g * p[8]; p[10] = g * p[9];
);
function sv_net(u, c) local(p, v1, v2, v3, fb, sa, sb, a, d, y) (
  p = SVB + c * 4 * SVS; fb = sa = sb = 0;
  loop(4,
    p[15] += sv_kw * (p[16] * p[19] - p[15]);
    v3 = u - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
    p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
    fb += p[15] * (p[26] * u + p[27] * v1 + p[28] * v2);
    a = p[8] * p[6] - p[9] * p[7];
    d = p[7] + p[9] * p[6] - p[10] * p[7];
    sa += p[15] * (p[30] * a + p[31] * d);
    sb += p[15] * (p[29] + p[30] * p[9] + p[31] * p[10]);
    p += SVS;
  );
  y = (u + fb - sa) / (1 + sb);
  p = SVB + c * 4 * SVS;
  loop(4,
    v3 = y - p[7]; v1 = p[8] * p[6] + p[9] * v3; v2 = p[7] + p[9] * p[6] + p[10] * v3;
    p[6] = 2 * v1 - p[6]; p[7] = 2 * v2 - p[7];
    p += SVS;
  );
  y;
);
function sv_ftick(p) local(g) (
  p[8] < 0.0005 ? p[6] = p[7];
  p[6] += sv_kc * (p[7] - p[6]);
  g = tan($pi * min(2 ^ p[6], sv_fmax) / srate);
  p[2] = 1 / (1 + g * (g + sv_fk)); p[3] = g * p[2]; p[4] = g * p[3];
);
function sv_flt(x, p, hp) local(v1, v2, v3, y) (
  p[8] += sv_ks * (p[9] - p[8]);
  v3 = x - p[1]; v1 = p[2] * p[0] + p[3] * v3; v2 = p[1] + p[3] * p[0] + p[4] * v3;
  p[0] = 2 * v1 - p[0]; p[1] = 2 * v2 - p[1];
  y = hp ? x - sv_fk * v1 - v2 : v2;
  x + p[8] * (y - x);
);
function sv_clr() local(i) (
  i = 0; loop(8, SVB[i * SVS] = SVB[i * SVS + 1] = SVB[i * SVS + 6] = SVB[i * SVS + 7] = 0; i += 1; );
  i = 0; loop(4, SVF[i * SVFS] = SVF[i * SVFS + 1] = 0; i += 1; );
);
function sv_dn() local(i, p) (
  i = 0; loop(8, p = SVB + i * SVS; p[0] = sv_tn(p[0]); p[1] = sv_tn(p[1]); p[6] = sv_tn(p[6]); p[7] = sv_tn(p[7]); i += 1; );
  i = 0; loop(4, p = SVF + i * SVFS; p[0] = sv_tn(p[0]); p[1] = sv_tn(p[1]); i += 1; );
);
function sv_targets() local(c, b, p, s, q, i) (
  c = 0;
  loop(2,
    q = 7 + c * 23; b = 0;
    loop(4,
      p = SVB + (c * 4 + b) * SVS; s = q + 3 + b * 5;
      p[16] = slider(s) >= 0.5;
      p[18] = slider(s + 1) >= 0.5;
      i = floor(min(max(slider(s + 2), 0), 10) + 0.5);
      p[20] = log(FQT[b * 11 + i]) / log(2);
      p[21] = floor(min(max(slider(s + 3), -20), 20) * 2 + 0.5) / 2;
      p[22] = min(max(slider(s + 4), 0), 100) / 100;
      b += 1;
    );
    i = floor(min(max(slider(q), 0), 11) + 0.5);
    p = SVF + c * 2 * SVFS; i > 0 ? p[7] = log(FQT[44 + i]) / log(2); p[9] = i > 0;
    i = floor(min(max(slider(q + 1), 0), 9) + 0.5);
    p = SVF + (c * 2 + 1) * SVFS; i < 9 ? p[7] = log(FQT[56 + i]) / log(2); p[9] = i < 9;
    c += 1;
  );
  sv_ogt0 = exp(floor(min(max(slider9, -12), 12) * 2 + 0.5) / 2 * 0.11512925464970228);
  sv_ogt1 = exp(floor(min(max(slider32, -12), 12) * 2 + 0.5) / 2 * 0.11512925464970228);
  sv_mst = slider3 >= 0.5; sv_dmt = slider5 >= 0.5;
  i = floor(min(max(slider6, 0), 2) + 0.5);
  sv_dvt = i == 0 ? 0.03 : i == 1 ? 0.1 : 0.3;
  sv_dit = i == 0 ? 0.25 : i == 1 ? 0.5 : 1;
  sv_sht = min(max(slider53, 0), 100) / 100;
  sv_dpt = min(max(slider54, 0), 100) / 100;
);
function sv_snapall() local(i, p) (
  i = 0; loop(8, p = SVB + i * SVS; p[12] = p[20]; p[13] = p[21]; p[14] = p[22]; p[17] = p[18]; p[19] = 1; p[15] = p[16];
    sv_btick(p, i & 3); i += 1; );
  i = 0; loop(4, p = SVF + i * SVFS; p[6] = p[7]; p[8] = p[9]; sv_ftick(p); i += 1; );
  sv_og0 = sv_ogt0; sv_og1 = sv_ogt1; sv_msc = sv_mst; sv_dk = 1; sv_dm = sv_dmt; sv_dv = sv_dvt; sv_di = sv_dit; sv_sh = sv_sht; sv_dp = sv_dpt;
);

function sv_sat(x) instance(lo, hl, hm, hp) local(y, h, d) (
  y = this.vt.am_tube(x * sv_dve, sv_vb) * sv_idve;
  hl += sv_khs * (y - hl); h = y - hl;
  y += sv_shk * (this.st.am_tube(h * 2.5, 0.5) * 0.4 - h);
  lo += sv_klo * (y - lo);
  d = min(abs(lo - hp) * sv_hw + sv_hf, 1); hp = lo; hm += d * (lo - hm);
  y - lo + this.it.am_tube((lo + sv_hk * (hm - lo)) * sv_di, 0.06) * sv_idi;
);
function sv_osclr() (
  upA.os_clr(); upB.os_clr(); dnA.os_clr(); dnB.os_clr(); vsA.lo = vsB.lo = 0; vsA.hl = vsB.hl = 0; vsA.hm = vsB.hm = vsA.hp = vsB.hp = 0;
  sv_klo = 1 - exp(-2 * $pi * 120 / (srate * os_f));
  sv_khs = 1 - exp(-2 * $pi * 1800 / (srate * os_f));
  sv_hf = 1 - exp(-2 * $pi * 800 / (srate * os_f));
);
function sv_dsetup() (
  sv_dka = 1 - exp(-1 / (0.003 * srate)); sv_dkr = 1 - exp(-1 / (0.15 * srate));
  sv_hw = 1 / 0.01;
);
function sv_dclr() ( sv_den = 0; lpA.l1 = lpA.l2 = lpA.hx = lpA.hy = lpB.l1 = lpB.l2 = lpB.hx = lpB.hy = 0; );
function sv_dtick() local(f, g, t) (
  sv_dw = min(sv_dp / 0.05, 1);
  f = sv_dp <= 0.05 ? 1 : 25 ^ ((sv_dp - 0.05) / 0.95);
  g = tan($pi * f / srate); sv_lk = 2;
  sv_la1 = 1 / (1 + g * (g + sv_lk)); sv_la2 = g * sv_la1; sv_la3 = g * sv_la2;
  t = sv_dp <= 0.05 ? 1999 : exp(log(1999) + (log(tan($pi * min(7000, 0.45 * srate) / srate)) - log(1999)) * sqrt((sv_dp - 0.05) / 0.95));
  sv_ha = (t - 1) / (t + 1);
);
function sv_lap(x) instance(l1, l2, hx, hy) local(v1, v2, v3, y) (
  v3 = x - l2; v1 = sv_la1 * l1 + sv_la2 * v3; v2 = l2 + sv_la2 * l1 + sv_la3 * v3;
  l1 = 2 * v1 - l1; l2 = 2 * v2 - l2;
  y = x - 2 * sv_lk * v1;
  v3 = sv_ha * y + hx - sv_ha * hy; hx = y; hy = v3;
  x + sv_dw * (v3 - x);
);
function sv_reset() (
  sv_clr(); sv_osclr(); sv_dclr(); memset(BY_BUF, 0, 2 * BY_N);
  sv_dxl = sv_dyl = sv_dxr = sv_dyr = 0;
  sv_fi = 0;
);

function sv_link() local(i) (
  i = 0;
  loop(23, slider(30 + i) != slider(7 + i) ? ( slider(30 + i) = slider(7 + i); slider_automate(2 ^ (29 + i)); ); i += 1; );
);

#sv_pm = "Init|Weight and Tighten|Air Lift|Mastering Polish|Vocal Presence|Smooth Top|Warm Bus|Mud Out|Driven Valve|MS Wide Air";
function sv_pb(c, b, sh, f, g, w) local(s) ( s = 10 + c * 23 + b * 5; slider(s) = 1; slider(s + 1) = sh; slider(s + 2) = f; slider(s + 3) = g; slider(s + 4) = w; );
function sv_pflat(c) (
  sv_pb(c, 0, 1, 4, 0, 40); sv_pb(c, 1, 0, 3, 0, 40); sv_pb(c, 2, 0, 6, 0, 40); sv_pb(c, 3, 1, 7, 0, 40);
  slider(7 + c * 23) = 0; slider(8 + c * 23) = 9; slider(9 + c * 23) = 0;
);
function sv_pcp() local(i) ( i = 0; loop(23, slider(30 + i) = slider(7 + i); i += 1; ); );
function load_preset(p) local(i) (
  sv_pflat(0); sv_pflat(1); slider3 = 0; slider4 = 1; slider5 = 0; slider6 = 0; slider53 = 50; slider54 = 0;
  p == 2 ? (  sv_pb(0, 0, 1, 3,  3.5, 75); sv_pb(0, 1, 0, 2, -2.5, 45); slider7 = 2; sv_pcp(); ) :
  p == 3 ? (  sv_pb(0, 3, 1, 9,  3,   30); sv_pb(0, 2, 0, 8, -1,   50); slider53 = 65; sv_pcp(); ) :
  p == 4 ? (  sv_pb(0, 0, 1, 2,  1.5, 50); sv_pb(0, 1, 0, 3, -1,   30); sv_pb(0, 2, 0, 7, 1, 20);
              sv_pb(0, 3, 1, 10, 2,   30); slider7 = 2; slider53 = 60; slider54 = 30; sv_pcp(); ) :
  p == 5 ? (  sv_pb(0, 1, 0, 2, -2,   40); sv_pb(0, 2, 0, 7,  3,  45); sv_pb(0, 3, 1, 9, 2, 30);
              slider7 = 8; sv_pcp(); ) :
  p == 6 ? (  sv_pb(0, 2, 0, 8, -1.5, 55); sv_pb(0, 3, 1, 7, -2,   20); slider8 = 8; slider53 = 30; sv_pcp(); ) :
  p == 7 ? (  sv_pb(0, 0, 1, 6,  2,   40); sv_pb(0, 1, 0, 4,  1,   10); sv_pb(0, 3, 1, 4, -1, 20);
              slider6 = 1; slider53 = 60; slider54 = 35; sv_pcp(); ) :
  p == 8 ? (  sv_pb(0, 1, 0, 3, -3,   60); sv_pb(0, 0, 1, 1,  1.5, 40); sv_pb(0, 2, 0, 6, 1, 20); sv_pcp(); ) :
  p == 9 ? (  sv_pb(0, 0, 1, 4,  3,   50); sv_pb(0, 3, 1, 7,  3,   40); slider9 = -3; slider6 = 2; slider53 = 80; sv_pcp(); ) :
  p == 10 ? ( slider3 = 1; slider4 = 0; sv_pb(0, 0, 1, 3, 1, 40); sv_pb(1, 3, 1, 7, 3, 35); slider30 = 10; slider54 = 40; );
  i = 3; loop(52, slider_automate(2 ^ (i - 1)); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function sv_srinit() (
  sv_sr = srate;
  sv_kc = 1 - exp(-16 / (0.03 * srate));
  sv_kw = 1 - exp(-1 / (0.008 * srate));
  sv_ks = 1 - exp(-1 / (0.012 * srate));
  sv_ko = 1 - exp(-1 / (0.03 * srate));
  sv_kd = 1 - exp(-1 / (0.015 * srate));
  sv_dks = 1 / (0.006 * srate);
  sv_dcc = 1 - 2 * $pi * 5 / srate;
  sv_fmax = 0.45 * srate; sv_fis = 1 / (0.01 * srate);
  ost_init(0);
  sv_clr(); sv_osclr(); sv_dsetup(); sv_dclr();
);
os_design();
os_f = os_tf = os_f2n(slider2); os_base = 0;
sv_srinit();
os_gsetup();
sv_targets(); sv_snapall(); sv_dtick(); sv_fi = 1;
pdc_delay = os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(55, i != 55 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(2));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != sv_sr ? ( sv_srinit(); sv_targets(); sv_snapall(); );
sv_now = time_precise();
sv_tp > 0 && sv_now - sv_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > sv_gpp && play_position - sv_gpp < 4 * sv_gpd + 0.05) ? sv_reset();
sv_tp = sv_now; sv_gpp = play_position; sv_gpd = samplesblock / srate;
slider4 >= 0.5 ? sv_link();
sv_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider2); pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
sv_dn();
vsA.lo = sv_tn(vsA.lo); vsB.lo = sv_tn(vsB.lo);
sv_ol_d = max(sv_ol_d, sv_ol); sv_or_d = max(sv_or_d, sv_or); sv_ol = sv_or = 0;
os_snapb(slider(2));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
sv_xl = spl0; sv_xr = spl1;
(sv_cn -= 1) <= 0 ? (
  sv_cn = 16;
  sv_i = 0; loop(8, sv_btick(SVB + sv_i * SVS, sv_i & 3); sv_i += 1; );
  sv_i = 0; loop(4, sv_ftick(SVF + sv_i * SVFS); sv_i += 1; );
  sv_dtick();
);
sv_mst != sv_msc ? ( sv_dk = max(sv_dk - sv_dks, 0); sv_dk <= 0 ? ( sv_msc = sv_mst; sv_clr(); ); ) : sv_dk = min(sv_dk + sv_dks, 1);
sv_og0 += sv_ko * (sv_ogt0 - sv_og0); sv_og1 += sv_ko * (sv_ogt1 - sv_og1); sv_dm += sv_kd * (sv_dmt - sv_dm);
sv_dv += sv_ko * (sv_dvt - sv_dv); sv_di += sv_ko * (sv_dit - sv_di); sv_idi = 1 / sv_di;
sv_sh += sv_ko * (sv_sht - sv_sh); sv_dp += sv_ko * (sv_dpt - sv_dp);
sv_msc ? ( sv_a = 0.5 * (sv_xl + sv_xr); sv_b = 0.5 * (sv_xl - sv_xr); ) : ( sv_a = sv_xl; sv_b = sv_xr; );
sv_a = sv_net(sv_flt(sv_flt(sv_a, SVF, 1), SVF + SVFS, 0), 0);
sv_b = sv_net(sv_flt(sv_flt(sv_b, SVF + 2 * SVFS, 1), SVF + 3 * SVFS, 0), 1);
sv_z = max(abs(sv_a), abs(sv_b)); sv_den += (sv_z > sv_den ? sv_dka : sv_dkr) * (sv_z - sv_den);
sv_sag = sv_dp * sv_den / (sv_den + 0.35);
sv_dve = sv_dv * (1 + 2 * sv_sh) + sv_dp * 0.1 + 0.8 * sv_sag; sv_idve = 1 / sv_dve; sv_shk = 0.25 * sv_sh;
sv_vb = 0.25 + 0.3 * sv_sag; sv_hk = 0.4 * sv_dp;
os_gate();
os_chg ? ( sv_osclr(); os_hold += 2 * samplesblock; );
upA.os_up(sv_a); upB.os_up(sv_b);
os_f == 1 ? (
  sv_a = vsA.sv_sat(upA.s0); sv_b = vsB.sv_sat(upB.s0);
) : os_f == 2 ? (
  sv_a = dnA.os_dn(vsA.sv_sat(upA.s0), vsA.sv_sat(upA.s1), 0, 0);
  sv_b = dnB.os_dn(vsB.sv_sat(upB.s0), vsB.sv_sat(upB.s1), 0, 0);
) : (
  sv_a = dnA.os_dn(vsA.sv_sat(upA.s0), vsA.sv_sat(upA.s1), vsA.sv_sat(upA.s2), vsA.sv_sat(upA.s3));
  sv_b = dnB.os_dn(vsB.sv_sat(upB.s0), vsB.sv_sat(upB.s1), vsB.sv_sat(upB.s2), vsB.sv_sat(upB.s3));
);
sv_z = 1 - 0.08 * sv_sag; sv_a *= sv_z; sv_b *= sv_z;
sv_z = sv_a - sv_dxl + sv_dcc * sv_dyl; sv_dxl = sv_a; sv_dyl = sv_z; sv_a = lpA.sv_lap(sv_z) * sv_og0;
sv_z = sv_b - sv_dxr + sv_dcc * sv_dyr; sv_dxr = sv_b; sv_dyr = sv_z; sv_b = lpB.sv_lap(sv_z) * sv_og1;
sv_msc ? ( sv_yl = sv_a + sv_b; sv_yr = sv_a - sv_b; ) : ( sv_yl = sv_a; sv_yr = sv_b; );
sv_z = sv_dk * sv_dk * (3 - 2 * sv_dk); sv_yl *= sv_z; sv_yr *= sv_z;
sv_ql = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)];
sv_qr = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
sv_yl -= sv_dm * sv_ql; sv_yr -= sv_dm * sv_qr;
sv_z = os_g * os_g * (3 - 2 * os_g); sv_yl *= sv_z; sv_yr *= sv_z;
sv_yl != sv_yl ? sv_yl = 0; sv_yr != sv_yr ? sv_yr = 0;
sv_fi < 1 ? (
  sv_fi = min(sv_fi + sv_fis, 1); sv_z = sv_fi * sv_fi * (3 - 2 * sv_fi);
  sv_yl = sv_ql + sv_z * (sv_yl - sv_ql); sv_yr = sv_qr + sv_z * (sv_yr - sv_qr);
);
ost_out(sv_yl, sv_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
sv_ol = max(sv_ol, abs(spl0)); sv_or = max(sv_or, abs(spl1));

@gfx 1360 744
function lx_kdotc(cx, cy, ca, sa, capr) local(x, y, rd) (
  rd = max(capr * 0.19, 2 * sc); x = cx + ca * capr * 0.62; y = cy + sa * capr * 0.62; gfx_circle(x, y, rd, 1, 1);
);
function lx_kdot(cx, cy, a, capr) ( lx_kdotc(cx, cy, sin(a), -cos(a), capr); );
function lx_ctext(x, y, s) local(w, h) ( gfx_measurestr(s, w, h); gfx_x = x - w * 0.5; gfx_y = y - h * 0.55; gfx_drawstr(s); );
ui_begin(1200, 744);
SGPN = 0x1D3A3F; SGPL = 0x24474D; SGHB = 0x173136; SGEG = 0x0D1D20; SGIK = 0xE7EEEA; SGCU = 0xC8794A; SGAC = 0xF2B27A;
SGIK2 = ui_mix(SGIK, SGPL, 0.42);
!sg_sti ? ( sg_st = 0x9B3A2E; sg_sti = 1; );
SGLO = 0xC08850; SGLM = 0x8EC6F0; SGHM = 0x8FD3A0; SGHI = 0xEC7A6E; SGHP = 0xF2D06B; SGLP = 0x2A2D31; SGOU = 0xC9CDD3;

sc != sg_fsc ? (
  sg_fsc = sc;
  sg_f10 = ui_fitfont(10, 15 * sc);
  sg_f11 = ui_fitfont(11, 17 * sc);
  sg_f12 = ui_fitfont(12, 12 * sc);
  sg_f13 = ui_fitfont(13, 14 * sc);
  sg_f14 = ui_fitfont(14, 28 * sc);
  sg_f15 = ui_fitfont(15, 12 * sc);
);
gfx_setfont(10, "Trebuchet MS", sg_f10, 'b'); gfx_setfont(11, "Trebuchet MS", sg_f11, 'b');
gfx_setfont(12, "Trebuchet MS", sg_f12, 'b'); gfx_setfont(13, "Trebuchet MS", sg_f13, 'b');
gfx_setfont(14, "Trebuchet MS", sg_f14, 'b'); gfx_setfont(15, "Trebuchet MS", sg_f15, 'b');

function sg_fstr(f) local(v) (
  f < 1000 ? sprintf(#sgf, "%d Hz", floor(f + 0.5)) : (
    v = f / 1000;
    abs(v - floor(v + 0.5)) < 0.001 ? sprintf(#sgf, "%d kHz", floor(v + 0.5)) : sprintf(#sgf, "%.1f kHz", v);
  );
  #sgf;
);
function sg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function sg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sg_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sg_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); sg_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function sg_quad(x1, y1, x2, y2, x3, y3, x4, y4) ( gfx_triangle(x1 * sc, y1 * sc, x2 * sc, y2 * sc, x3 * sc, y3 * sc, x4 * sc, y4 * sc); );
function sg_bevel(x, y, w, h, b, c) (
  ui_col(ui_mix(c, 0x000000, 0.55)); sg_r(x, y, w, h);
  x += 1; y += 1; w -= 2; h -= 2;
  ui_col(ui_mix(c, 0xFFFFFF, 0.20)); sg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.10)); sg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0x000000, 0.28)); sg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.42)); sg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(c); sg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_cola(0xFFFFFF, 0.16); sg_r(x + b, y + b, w - 2 * b, 1);
);
function sg_contact(x, y, w, h) (
  ui_cola(0x000000, 0.30); sg_r(x + 1, y + h, w, 1); sg_r(x + w, y + 1, 1, h - 1);
  ui_cola(0x000000, 0.12); sg_r(x + 2, y + h + 1, w, 1); sg_r(x + w + 1, y + 2, 1, h - 1);
);
function sg_cast(x, y, w, h) local(j) ( j = 0; loop(3, ui_cola(0x000000, 0.07); sg_r(x + 1 + j, y + 2 + j, w + j, h + j); j += 1; ); );
function sg_well(x, y, w, h, b, c) (
  ui_col(ui_mix(c, 0x000000, 0.45)); sg_quad(x, y, x + w, y, x + w - b, y + b, x + b, y + b);
  ui_col(ui_mix(c, 0x000000, 0.32)); sg_quad(x, y, x + b, y + b, x + b, y + h - b, x, y + h);
  ui_col(ui_mix(c, 0xFFFFFF, 0.08)); sg_quad(x + w, y, x + w, y + h, x + w - b, y + h - b, x + w - b, y + b);
  ui_col(ui_mix(c, 0xFFFFFF, 0.16)); sg_quad(x, y + h, x + b, y + h - b, x + w - b, y + h - b, x + w, y + h);
  ui_col(0x040A0B); sg_r(x + b, y + b, w - 2 * b, h - 2 * b);
  ui_col(0x0B1A1D); sg_r(x + b + 1, y + b + 1, w - 2 * b - 2, h - 2 * b - 2);
  ui_cola(0x000000, 0.35); sg_r(x + b + 1, y + b + 1, w - 2 * b - 2, 2); sg_r(x + b + 1, y + b + 1, 2, h - 2 * b - 2);
);
function sg_plate(x, y, w, h) (
  sg_cast(x, y, w, h); sg_contact(x, y, w, h);
  sg_bevel(x, y, w, h, 6, SGPL);
  ui_col(SGHB); sg_r(x + 7, y + 7, w - 14, 26);
  ui_cola(SGCU, 0.75); sg_r(x + 7, y + 33, w - 14, 1);
);
function sg_split(x, y, h) ( ui_col(SGEG); sg_r(x, y + 34, 1, h - 41); ui_cola(0xFFFFFF, 0.07); sg_r(x + 1, y + 34, 1, h - 41); );

sg_lock = 0; sg_ctr = 0; sg_nd = 0; sg_pt = 0x1A1D22;
function sg_kn(v, lo, hi) ( (v - lo) / (hi - lo); );
function sg_cap(cx, cy, r, a, act, cap, nd) local(i, t, x, y, rr, rd) (
  x = cx * sc; y = cy * sc; rr = r * sc; rd = rr + 7 * sc;
  ui_col(SGIK2); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(x + sin(t) * rd, y - cos(t) * rd, (i == 0 || i == nd || (sg_ctr && i * 2 == nd) ? 2.0 : 1.3) * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.16); gfx_circle(x + (2 + i * 1.3) * sc, y + (3 + i * 1.6) * sc, rr + i * 0.6 * sc, 1, 1); i += 1; );
  ui_col(0x5E666B); gfx_circle(x, y, rr, 1, 1);
  ui_col(act ? 0xC9CFD2 : 0xB3BABE); gfx_circle(x, y, rr - 1 * sc, 1, 1);
  ui_cola(0xFFFFFF, 0.55); ui_ssarc(x, y, rr - 1.6 * sc, -2.3, 0.4, 1.2 * sc);
  ui_cola(0x000000, 0.22); ui_ssarc(x, y, rr - 1.6 * sc, 0.9, 3.6, 1.2 * sc);
  ui_col(0x3C4347); gfx_circle(x, y, rr * 0.79, 1, 1);
  ui_col(cap); gfx_circle(x, y, rr * 0.74, 1, 1);
  i = 0; loop(5, ui_cola(0x000000, 0.12 * (1 - i / 5)); gfx_circle(x, y, rr * 0.74 - i * 0.9 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.32 : 0.18); ui_ssarc(x, y, rr * 0.62, -1.7, -0.3, 1 * sc);
  ui_col(sg_pt); lx_kdot(x, y, a, rr * 0.74);
);
function sg_knob(cx, cy, r, idx, lo, hi, st, def, cap) local(v, n, dx, dy, hov, did, act, nd, tr) (
  did = 1700 + idx; v = slider(idx); nd = floor((hi - lo) / st + 0.5);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = !sg_lock && dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - sg_lt < 0.35 && sg_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; sg_lt = 0; ) : (
      drag_id = did; sg_my = mouse_y; sg_dz = 0; sg_lt = time_precise(); sg_lid = idx; sg_n = sg_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    sg_dz += abs(sg_my - mouse_y);
    sg_dz > 3 * sc ? (
      tr = (mouse_cap & 8) ? 1000 : nd > 20 ? 200 : max(160, nd * 9);
      sg_n = min(max(sg_n + (sg_my - mouse_y) / (tr * sc), 0), 1);
      v = lo + floor(sg_n * nd + 0.5) * st;
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    sg_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    slider(idx) = min(max(lo + (floor((v - lo) / st + 0.5) + sign(mouse_wheel) * (nd > 20 ? 2 : 1)) * st, lo), hi);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(sg_kn(v, lo, hi), 0), 1);
  act = hov || drag_id == did;
  sg_cap(cx, cy, r, -0.75 * $pi + n * 1.5 * $pi, act, cap, sg_nd > 0 ? sg_nd : nd);
  sg_ctr = 0; sg_nd = 0; sg_pt = 0x1A1D22;
  act;
);
function sg_name(cx, y, act, name, val) ( gfx_setfont(10); ui_col(act ? SGAC : SGIK); sg_ctxt(cx, y, act ? val : name); );
function sg_rbox(cx, y, w, h, s, lit) local(x) (
  x = cx - w / 2;
  ui_col(0x061012); sg_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(lit ? 0xE4E9E2 : 0x8A948F); sg_r(x, y, w, h);
  ui_cola(0x000000, 0.22); sg_r(x, y, w, 2); sg_r(x, y, 2, h);
  gfx_setfont(13); ui_col(0x1E2624); sg_ctxt(cx, y + h / 2 + 0.5, s);
);
function sg_lamp(cx, cy, on) local(x, y, hit) (
  x = cx * sc; y = cy * sc;
  hit = !sg_lock && pressed && drag_id == 0 && abs(mouse_x - x) < 10 * sc && abs(mouse_y - y) < 10 * sc; hit ? drag_id = -1;
  on ? ( ui_cola(0xFFB43C, 0.18); gfx_circle(x, y, 11 * sc, 1, 1); ui_cola(0xFFB43C, 0.25); gfx_circle(x, y, 8.5 * sc, 1, 1); );
  ui_col(0x050506); gfx_circle(x, y, 7.5 * sc, 1, 1);
  ui_col(0xD9A17A); gfx_circle(x, y, 6.5 * sc, 1, 1);
  ui_col(on ? 0xFFB43C : 0x4A3A28); gfx_circle(x, y, 4.2 * sc, 1, 1);
  ui_cola(0xFFFFFF, on ? 0.6 : 0.15); gfx_circle(x - 1.4 * sc, y - 1.4 * sc, 1.4 * sc, 1, 1);
  hit;
);
function sg_key(x, y, w, h, lbl, on, col) ( lk_well = 0x060E10; lk_font = 13; lk_font2 = 13; lk_fit(x, y, w, h, on, col, lbl); );
function sg_rivet(x, y) ( ui_cola(0x000000, 0.45); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x6C7178); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xA9AEB4); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );
function sg_fall(v, p) ( p = p > 0.0000001 ? 20 * log10(p) : -90; p > v ? p : max(v - 0.6, -90); );
function sg_cell(x, y, w, h, lit, d) local(c) (
  c = d > -3 ? 0xFF3A2A : d > -6 ? 0xFF8A1E : d > -12 ? 0xFFC81E : d > -30 ? 0x3CE05A : 0x3A9CFF;
  lit ? ( ui_cola(c, 0.16); sg_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); sg_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); sg_r(x, y, w, 1.5); )
      : ( ui_col(ui_mix(c, 0x0B1416, 0.82)); sg_r(x, y, w, h); );
);
function sg_bar(x, y, w, h, v, pk) local(n, i, sw, d) (
  n = 24; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; sg_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d || (pk > -48 && abs(pk - d) < 1), d); i += 1; );
);

function sg_w(f, f0) ( tan($pi * min(f, 0.49 * srate) / srate) / tan($pi * min(f0, 0.45 * srate) / srate); );
function sg_resp(c, f) local(q, b, s, nr, ni, dr, di, w, k, g, bt, ct, sh, r0, i0, m, re, im, hp, lp, x) (
  q = 7 + c * 23; nr = 1; ni = 0; dr = 1; di = 0; b = 0;
  loop(4,
    s = q + 3 + b * 5;
    slider(s) >= 0.5 ? (
      g = exp(floor(min(max(slider(s + 3), -20), 20) * 2 + 0.5) / 2 * 0.11512925464970228);
      sh = slider(s + 1) >= 0.5;
      w = sg_w(f, FQT[b * 11 + floor(min(max(slider(s + 2), 0), 10) + 0.5)]);
      x = min(max(slider(s + 4), 0), 100) / 100;
      k = sh ? 0.5 * 4 ^ x : 0.35 * 10 ^ x;
      g > 1 ? bt = 1 : ( bt = 0; g = 1 / g; k *= sh ? 0.75 : 1.6; );
      x = sqrt(g); k = 1 / k;
      !sh ? (
        r0 = 1 - w * w; i0 = w * k; m = r0 * r0 + i0 * i0;
        re = (g - 1) * k * i0 * w / m; im = (g - 1) * k * w * r0 / m;
      ) : (
        w = b < 2 ? w * sqrt(x) : w / sqrt(x);
        r0 = 1 - w * w; i0 = w * k; m = r0 * r0 + i0 * i0;
        b < 2 ? (
          re = ((g - 1) * r0 + k * (x - 1) * w * i0) / m; im = (k * (x - 1) * w * r0 - (g - 1) * i0) / m;
        ) : (
          re = (g - 1) + ((1 - g) * r0 + k * x * (1 - x) * w * i0) / m; im = (k * x * (1 - x) * w * r0 - (1 - g) * i0) / m;
        );
      );
      ct = 1 - bt;
      nr += bt * re; ni += bt * im; dr += ct * re; di += ct * im;
    );
    b += 1;
  );
  m = (nr * nr + ni * ni) / max(dr * dr + di * di, 0.000000001);
  b = floor(min(max(slider(q), 0), 11) + 0.5);
  b > 0 ? ( w = sg_w(f, FQT[44 + b]); r0 = 1 - w * w; i0 = w / 0.6; m *= w * w * w * w / (r0 * r0 + i0 * i0); );
  b = floor(min(max(slider(q + 1), 0), 9) + 0.5);
  b < 9 ? ( w = sg_w(f, FQT[56 + b]); r0 = 1 - w * w; i0 = w / 0.6; m *= 1 / (r0 * r0 + i0 * i0); );
  10 * log10(max(m, 0.0000000001)) + 20 * log10(exp(floor(min(max(slider(q + 2), -12), 12) * 2 + 0.5) / 2 * 0.11512925464970228));
);
function sg_fx(f, x, w) ( x + w * log(f / 20) / log(1000); );
function sg_dy(db, y, h) ( y + h * 0.5 - min(max(db, -1.05 * sg_rng), 1.05 * sg_rng) / sg_rng * (h * 0.5 - 6); );
function sg_curve(c, x, y, w, h, col) local(i, n, f, px, py, qx, qy, b, s) (
  n = 120; i = 0;
  loop(n + 1,
    f = 20 * 1000 ^ (i / n);
    qx = sg_fx(f, x, w) * sc; qy = sg_dy(sg_resp(c, f), y, h) * sc;
    i > 0 ? ( ui_cola(col, 0.35); gfx_line(px, py + 1, qx, qy + 1, 1); ui_col(col); gfx_line(px, py, qx, qy, 1); gfx_line(px, py - 0.6 * sc, qx, qy - 0.6 * sc, 1); );
    px = qx; py = qy; i += 1;
  );
  b = 0;
  loop(4,
    s = 10 + c * 23 + b * 5;
    slider(s) >= 0.5 && abs(slider(s + 3)) > 0.01 ? (
      f = FQT[b * 11 + floor(min(max(slider(s + 2), 0), 10) + 0.5)];
      f >= 20 && f <= 20000 ? (
        qx = sg_fx(f, x, w) * sc; qy = sg_dy(sg_resp(c, f), y, h) * sc;
        ui_col(0x061012); gfx_circle(qx, qy, 4.6 * sc, 1, 1);
        ui_col(b == 0 ? SGLO : b == 1 ? SGLM : b == 2 ? SGHM : SGHI); gfx_circle(qx, qy, 3.4 * sc, 1, 1);
      );
    );
    b += 1;
  );
);

function sg_band(c, b, cx, y) local(s, cap, a, f, on, t) (
  s = 10 + c * 23 + b * 5; on = slider(s) >= 0.5;
  cap = b == 0 ? SGLO : b == 1 ? SGLM : b == 2 ? SGHM : SGHI;
  sg_lamp(cx - 66, y + 52, on) ? ( slider(s) = on ? 0 : 1; ui_auto(s); );
  gfx_setfont(11); ui_col(SGIK); sg_ltxt(cx - 52, y + 52, b == 0 ? "LOW" : b == 1 ? "LOW MID" : b == 2 ? "HIGH MID" : "HIGH");
  ui_col(cap); sg_r(cx - 74, y + 66, 148, 3);
  sg_nd = 10; sg_knob(cx - 34, y + 118, 24, s + 2, 0, 10, 1, b == 0 ? 4 : b == 1 ? 3 : b == 2 ? 6 : 7, cap);
  f = FQT[b * 11 + floor(min(max(slider(s + 2), 0), 10) + 0.5)];
  sg_rbox(cx - 34, y + 158, 80, 22, sg_fstr(f), on);
  ck_font = 13; sg_lock ? ck_inert = 1;
  ck_key(cx + 16, y + 88, 60, 28, slider(s + 1) < 0.5, "BELL") ? ( slider(s + 1) = 0; ui_auto(s + 1); );
  sg_lock ? ck_inert = 1;
  ck_key(cx + 16, y + 124, 60, 28, slider(s + 1) >= 0.5, "SHELF") ? ( slider(s + 1) = 1; ui_auto(s + 1); );
  gfx_setfont(12); ui_col(SGIK2); sg_ctxt(cx - 38, y + 197, "0");
  sg_ctr = 1; sg_nd = 8; a = sg_knob(cx - 38, y + 238, 22, s + 3, -20, 20, 0.5, 0, cap);
  t = slider(s + 3); abs(t) < 0.01 ? strcpy(#sgg, "0.0 dB") : sprintf(#sgg, "%+.1f dB", t);
  sg_name(cx - 38, y + 284, a, "GAIN", #sgg);
  sg_nd = 4; a = sg_knob(cx + 42, y + 238, 18, s + 4, 0, 100, 1, 40, ui_mix(cap, 0xFFFFFF, 0.45));
  t = slider(s + 4); sprintf(#sgw, t < 15 ? "BROAD %d" : t > 85 ? "SHARP %d" : "%d %%", t);
  sg_name(cx + 42, y + 284, a, "WIDTH", #sgw);
  !on ? ( ui_cola(SGPL, 0.5); sg_r(cx - 84, y + 72, 168, 236); sg_lamp(cx - 66, y + 52, 0); );
);
function sg_fcol(c, fx, y) local(s, v) (
  gfx_setfont(11); ui_col(SGIK); sg_ctxt(fx, y + 52, "FILTERS");
  ui_col(SGIK2); sg_r(fx - 44, y + 66, 88, 1);
  s = 7 + c * 23;
  sg_nd = 11; sg_knob(fx, y + 118, 20, s, 0, 11, 1, 0, SGHP);
  v = floor(slider(s) + 0.5); v < 1 ? strcpy(#sghpf, "HPF  OFF") : sprintf(#sghpf, "HPF %s", sg_fstr(FQT[44 + v]));
  sg_rbox(fx, y + 158, 96, 22, #sghpf, v >= 1);
  sg_pt = 0xE6E8EA; sg_nd = 9; sg_knob(fx, y + 238, 20, s + 1, 0, 9, 1, 9, SGLP);
  v = floor(slider(s + 1) + 0.5); v > 8 ? strcpy(#sglpf, "LPF  OFF") : sprintf(#sglpf, "LPF %s", sg_fstr(FQT[56 + v]));
  sg_rbox(fx, y + 276, 96, 22, #sglpf, v <= 8);
);
function sg_ocol(c, ox, y) local(a, t) (
  gfx_setfont(11); ui_col(SGIK); sg_ctxt(ox, y + 52, "OUT");
  ui_col(SGIK2); sg_r(ox - 22, y + 66, 44, 1);
  gfx_setfont(12); ui_col(SGIK2); sg_ctxt(ox, y + 201, "0");
  sg_ctr = 1; sg_nd = 4; a = sg_knob(ox, y + 238, 18, 9 + c * 23, -12, 12, 0.5, 0, SGOU);
  t = slider(9 + c * 23); abs(t) < 0.01 ? strcpy(#sgo, "0.0") : sprintf(#sgo, "%+.1f", t);
  sg_name(ox, y + 284, a, "GAIN", #sgo);
);
function sg_chan(c, y) local(b, ms) (
  ms = slider3 >= 0.5;
  sg_plate(16, y, 868, 316);
  gfx_setfont(11); ui_col(SGIK);
  sg_ltxt(30, y + 17, c == 0 ? (ms ? "1   MID" : "1   LEFT") : (ms ? "2   SIDE" : "2   RIGHT"));
