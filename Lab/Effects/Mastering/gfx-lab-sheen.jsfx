);

function sg_band(b, cx) local(s, cap, a, m, on, f0, f1, k, i, x0) (
  s = 10 + b * 4; on = slider(s + 3) >= 0.5; x0 = cx - 68;
  cap = b == 0 ? CB1 : b == 1 ? CB2 : b == 2 ? CB3 : CB4;
  ui_col(ui_mix(SGH, 0, 0.35)); v5_r(cx - 60, 254, 122, 25);
  ui_col(SGH); v5_r(cx - 61, 253, 121, 24);
  ui_col(cap); v5_r(cx - 61, 277, 121, 3);
  sg_lamp(cx - 47, 265, on) ? ( slider(s + 3) = on ? 0 : 1; ui_auto(s + 3); );
  sg_ft(15); ui_col(SGI); sg_tl(cx - 33, 265.5, b == 0 ? "1  LOW" : b == 1 ? "2  LOW MID" : b == 2 ? "3  HIGH MID" : "4  HIGH");
  k = floor(min(max(slider(s), 0), 7) + 0.5);
  sg_menubox(cx - 58, 290, 116, 26, k == 0 ? "WARM" : k == 1 ? "TRANSISTOR" : k == 2 ? "TAPE" : k == 3 ? "VALVE" : k == 4 ? "TRIODE" :
          k == 5 ? "PUSH-PULL" : k == 6 ? "2ND" : "3RD", cap) ? (
    gfx_x = (cx - 58) * sc; gfx_y = 318 * sc;
    #sgm = ""; i = 0;
    loop(8, strcat(#sgm, i == k ? "!" : ""); strcat(#sgm, i == 0 ? "Warm" : i == 1 ? "Transistor" : i == 2 ? "Tape" : i == 3 ? "Valve" :
      i == 4 ? "Triode" : i == 5 ? "Push-pull" : i == 6 ? "2nd (pure)" : "3rd (pure)"); i < 7 ? strcat(#sgm, "|"); i += 1; );
