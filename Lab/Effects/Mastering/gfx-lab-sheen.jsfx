function sg_knob(cx, cy, r, idx, lo, hi, def, lg, sty, lbl, kind, col, ly) local(n, ext, rs) (
  ext = sty == 0 ? 13 : 9;
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + ext), 0, 200);
