desc:Sheen [mastering exciter] (GFX Lab)
//tags: exciter enhancer harmonics saturation mastering multiband target output adaptive oversampling stereo
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-os (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Off,On}>-Bypass
slider2:1<0,2,1{1x,2x,4x}>-Oversampling
slider3:220<20,20000,1>-Split 1 (Hz)
slider4:1100<20,20000,1>-Split 2 (Hz)
slider5:5500<20,20000,1>-Split 3 (Hz)
slider6:20<20,20000,1>-Target low (Hz)
slider7:20000<20,20000,1>-Target high (Hz)
slider8:20<20,20000,1>-Output low (Hz)
slider9:20000<20,20000,1>-Output high (Hz)
slider10:0<0,7,1{Warm,Transistor,Tape,Valve,Triode,Push-pull,2nd,3rd}>-Band 1 mode
slider11:0<0,10,0.01>-Band 1 amount
slider12:50<0,100,0.1>-Band 1 mix (%)
slider13:1<0,1,1{Out,In}>-Band 1 in
slider14:4<0,7,1{Warm,Transistor,Tape,Valve,Triode,Push-pull,2nd,3rd}>-Band 2 mode
slider15:2.5<0,10,0.01>-Band 2 amount
slider16:50<0,100,0.1>-Band 2 mix (%)
slider17:1<0,1,1{Out,In}>-Band 2 in
slider18:2<0,7,1{Warm,Transistor,Tape,Valve,Triode,Push-pull,2nd,3rd}>-Band 3 mode
slider19:3.5<0,10,0.01>-Band 3 amount
slider20:50<0,100,0.1>-Band 3 mix (%)
slider21:1<0,1,1{Out,In}>-Band 3 in
slider22:6<0,7,1{Warm,Transistor,Tape,Valve,Triode,Push-pull,2nd,3rd}>-Band 4 mode
slider23:4.5<0,10,0.01>-Band 4 amount
slider24:50<0,100,0.1>-Band 4 mix (%)
slider25:1<0,1,1{Out,In}>-Band 4 in
slider26:1<0,1,1{Off,On}>-Mastering
slider27:1<0,1,1{Off,On}>-Adaptive
slider28:0<0,1,1{Off,On}>-Gang
slider29:100<0,200,0.1>-Width (%)
slider30:5500<1100,16500,1>-Shelf frequency (Hz)
slider31:0<-6,6,0.1>-Shelf gain (dB)
slider32:0<-6,6,0.1>-Output (dB)
slider33:0<0,1,1{Off,On}>-Delta
slider34:prs_sel=0<0,10,1{No preset,Init,Gentle Air,Silk Top,Warm Body,Tape Glow,Valve Bite,Wide Air,Vocal Presence,Bass Weight,Pure Polish}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-os.jsfx-inc

@init
#ui_man = "gfx-lab-sheen";
ext_noinit = 1;

function sh_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

CF = 10000;
ST = 11000;
function f_set(c, f, q) local(g) (
  g = tan($pi * min(max(f, 5), sh_fmax) / srate);
  c[3] = 1 / q; c[0] = 1 / (1 + g * (g + c[3])); c[1] = g * c[0]; c[2] = g * c[1];
);
function f_shset(c, f, db) local(g, a) (
  a = exp(db * 0.05756462732485115); g = tan($pi * min(f, sh_fmax) / srate) * sqrt(a);
  c[3] = 1.4142135623730951; c[0] = 1 / (1 + g * (g + c[3])); c[1] = g * c[0]; c[2] = g * c[1];
  c[4] = a * a; c[5] = c[3] * (1 - a) * a; c[6] = 1 - a * a;
);
function f_lp(x, c, s) local(v1, v2, v3) (
  v3 = x - s[1]; v1 = c[0] * s[0] + c[1] * v3; v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0]; s[1] = 2 * v2 - s[1]; v2;
);
function f_hp(x, c, s) local(v1, v2, v3) (
  v3 = x - s[1]; v1 = c[0] * s[0] + c[1] * v3; v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0]; s[1] = 2 * v2 - s[1]; x - c[3] * v1 - v2;
);
function f_sh(x, c, s) local(v1, v2, v3) (
  v3 = x - s[1]; v1 = c[0] * s[0] + c[1] * v3; v2 = s[1] + c[1] * s[0] + c[2] * v3;
  s[0] = 2 * v1 - s[0]; s[1] = 2 * v2 - s[1]; c[4] * x + c[5] * v1 + c[6] * v2;
);

BP = 12000;
GS = 12200;
BV = 12300;
PH = 12400;
DRY = 12500; DN = 64;
RIN = 200000; REX = 204096; RN = 4096;

function sh_shape(md, v) (
  md == 0 ? v + 0.6 * v * v / (1 + 0.5 * abs(v)) :
  md == 1 ? v / sqrt(sqrt(1 + v * v * v * v)) :
  md == 2 ? ( v = min(max(v, -1.5), 1.5); v - 0.14814814814814814 * v * v * v; ) :
  md == 3 ? ( v >= 0 ? 1 - exp(-v) : (exp(0.7 * v) - 1) * 1.4285714285714286 ) :
  md == 4 ? ( v >= 0 ? v / (1 + 0.5 * v) : v / (1 - 0.2 * v) ) :
            ( v = min(max(v, -3), 3); v * (27 + v * v) / (27 + 9 * v * v); );
);
function sh_gen(u, b, gq) local(p, md, d, y, c, g) (
  p = BP + b * 16; md = p[0]; d = p[3];
  md < 5.5 ? (
    d < 0.0005 ? y = u :
    md == 3 ? y = sh_shape(3, d * u * (1 + p[12])) / (1 + p[12]) * p[13] : y = sh_shape(md, d * u) * p[13];
  ) : (
    c = 1.5 * u / sqrt(sqrt(1 + sqr(sqr(u * 0.6666666666666666))));
    y = u + p[5] * (md < 6.5 ? 2 * c * c - 1 : (4 * c * c - 3) * c);
  );
  gq[0] += sh_kg * (y * u - gq[0]); gq[1] += sh_kg * (u * u - gq[1]);
  g = gq[1] > 0.0000001 ? min(max(gq[0] / gq[1], 0), 2) : 1;
  y - u - sh_ms * (g - 1) * u;
);

function sh_mode(v) ( floor(min(max(v, 0), 7) + 0.5); );
function sh_targets() local(b, p, s, a, m, k) (
  sh_tlot = log(min(max(slider6, 20), 20000)); sh_thit = log(max(min(max(slider7, 20), 20000), exp(sh_tlot) * 1.5));
  sh_olot = log(min(max(slider8, 20), 20000)); sh_ohit = log(max(min(max(slider9, 20), 20000), exp(sh_olot) * 1.5));
  sh_s1t = log(min(max(slider3, 20), 13000));
  sh_s2t = log(min(max(slider4, exp(sh_s1t) * 1.25), 16000)); sh_s3t = log(min(max(slider5, exp(sh_s2t) * 1.25), 20000));
  sh_shft = log(min(max(slider30, 1100), 16500)); sh_shgt = min(max(slider31, -6), 6);
  b = 0;
  loop(4,
    p = BP + b * 16; s = 10 + b * 4;
    p[1] = sh_mode(slider(s));
    a = min(max(slider(s + 1), 0), 10);
    m = min(max(slider(s + 2), 0), 100) / 100;
    k = p[1];
    p[4] = 0.1 * a * a * (k == 4 ? 1.6 : 1);
    p[6] = 0.006 * a * a;
    p[8] = (slider(s + 3) >= 0.5) * m;
    b += 1;
  );
  sh_mst = slider26 >= 0.5; sh_adt = slider27 >= 0.5;
  sh_wt = min(max(slider29, 0), 200) / 100;
  sh_ogt = exp(min(max(slider32, -6), 6) * 0.11512925464970228);
  sh_dmt = slider33 >= 0.5;
  os_tf = os_f2n(slider2);
);
function sh_coefs() (
  f_set(CF, exp(sh_tlo), 0.7071); f_set(CF + 8, exp(sh_thi), 0.7071);
  f_set(CF + 16, exp(sh_s1), 0.7071); f_set(CF + 24, exp(sh_s2), 0.7071); f_set(CF + 32, exp(sh_s3), 0.7071);
  f_set(CF + 40, exp(sh_olo), 0.7071); f_set(CF + 48, exp(sh_ohi), 0.7071);
  f_shset(CF + 56, exp(sh_shf), sh_shg);
);
function sh_snap() local(b, p) (
  sh_tlo = sh_tlot; sh_thi = sh_thit; sh_olo = sh_olot; sh_ohi = sh_ohit;
  sh_s1 = sh_s1t; sh_s2 = sh_s2t; sh_s3 = sh_s3t; sh_shf = sh_shft; sh_shg = sh_shgt;
  b = 0; loop(4, p = BP + b * 16; p[0] = p[1]; p[2] = 1; p[3] = p[4]; p[5] = p[6]; p[7] = p[8]; b += 1; );
  sh_ms = sh_mst; sh_ad = sh_adt; sh_w = sh_wt; sh_og = sh_ogt; sh_dm = sh_dmt;
  sh_coefs();
);
function sh_tick() local(k) (
  k = sh_kc;
  sh_tlo += k * (sh_tlot - sh_tlo); sh_thi += k * (sh_thit - sh_thi);
  sh_olo += k * (sh_olot - sh_olo); sh_ohi += k * (sh_ohit - sh_ohi);
  sh_s1 += k * (sh_s1t - sh_s1); sh_s2 += k * (sh_s2t - sh_s2); sh_s3 += k * (sh_s3t - sh_s3);
  sh_shf += k * (sh_shft - sh_shf); sh_shg += k * (sh_shgt - sh_shg);
  sh_coefs();
);
function sh_clr() (
  memset(ST, 0, 128); memset(GS, 0, 16); memset(BV, 0, 8); memset(PH, 0, 8); memset(DRY, 0, 2 * DN);
  memset(BP + 9, 0, 1); memset(BP + 25, 0, 1); memset(BP + 41, 0, 1); memset(BP + 57, 0, 1);
);
function sh_dn() local(i) ( i = 0; loop(128, ST[i] = sh_tn(ST[i]); i += 1; ); i = 0; loop(16, GS[i] = sh_tn(GS[i]); i += 1; ); );

function sh_split(x, c) local(s, t, r, b1) (
  s = ST + c * 64;
  t = f_hp(f_hp(x, CF, s), CF, s + 2);
  t = f_lp(f_lp(t, CF + 8, s + 4), CF + 8, s + 6);
  b1 = f_lp(f_lp(t, CF + 16, s + 8), CF + 16, s + 10); BV[c * 4] = b1; r = t - b1;
  b1 = f_lp(f_lp(r, CF + 24, s + 12), CF + 24, s + 14); BV[c * 4 + 1] = b1; r -= b1;
  b1 = f_lp(f_lp(r, CF + 32, s + 16), CF + 32, s + 18); BV[c * 4 + 2] = b1; BV[c * 4 + 3] = r - b1;
);
function sh_post(e, c) local(s) (
  s = ST + c * 64;
  e = f_hp(f_hp(e, CF + 40, s + 20), CF + 40, s + 22);
  e = f_lp(f_lp(e, CF + 48, s + 24), CF + 48, s + 26);
  f_sh(e, CF + 56, s + 28);
);
function sh_bands() local(b, p, l, r, q, f, den) (
  b = 0;
  loop(4,
    p = BP + b * 16; l = BV[b]; r = BV[4 + b];
    q = 0.5 * (l * l + r * r); p[9] += (q > p[9] ? sh_ka : sh_kr) * (q - p[9]);
    f = max(abs(l), abs(r)); p[10] = f > p[10] ? f : p[10] * sh_kf;
    den = sqrt(p[9]);
    p[12] = p[0] == 3 ? 0.6 * min(max(p[10] / (den + 0.000001) - 1, 0), 2) : 0;
    p[11] = sh_ad * max(den, 0.001) + (1 - sh_ad) * 0.25;
    p[3] += sh_kd * (p[4] - p[3]); p[5] += sh_kd * (p[6] - p[5]); p[7] += sh_kd * (p[8] - p[7]);
    p[0] < 5.5 && p[3] >= 0.0005 ? p[13] = 2 / (sh_shape(p[0], p[3]) - sh_shape(p[0], -p[3]));
    p[1] != p[0] ? ( p[2] = max(p[2] - sh_gk, 0); p[2] <= 0 ? ( p[0] = p[1]; memset(GS + b * 2, 0, 2); memset(GS + 8 + b * 2, 0, 2); ); )
                 : p[2] = min(p[2] + sh_gk, 1);
    b += 1;
  );
);

#sh_pm = "Init|Gentle Air|Silk Top|Warm Body|Tape Glow|Valve Bite|Wide Air|Vocal Presence|Bass Weight|Pure Polish";
function sh_pb(b, md, a, m) local(s) ( s = 10 + b * 4; slider(s) = md; slider(s + 1) = a; slider(s + 2) = m; slider(s + 3) = 1; );
function sh_band(lo, hi, olo, ohi) ( slider6 = lo; slider7 = hi; slider8 = olo; slider9 = ohi; );
function load_preset(p) local(i) (
  slider3 = 220; slider4 = 1100; slider5 = 5500; sh_band(20, 20000, 20, 20000);
  sh_pb(0, 0, 0, 50); sh_pb(1, 4, 2.5, 50); sh_pb(2, 2, 3.5, 50); sh_pb(3, 6, 4.5, 50);
  slider26 = 1; slider27 = 1; slider28 = 0; slider29 = 100; slider30 = 5500; slider31 = 0; slider32 = 0; slider33 = 0;
  p == 2 ? ( sh_band(2200, 20000, 4400, 20000);
             sh_pb(0, 0, 0, 50); sh_pb(1, 6, 0, 50); sh_pb(2, 6, 5, 60); sh_pb(3, 6, 6, 70); ) :
  p == 3 ? ( sh_band(1100, 20000, 3300, 20000); slider30 = 8800; slider31 = -1.5;
             sh_pb(0, 0, 0, 50); sh_pb(1, 0, 0, 50); sh_pb(2, 0, 5, 60); sh_pb(3, 4, 7, 80); ) :
  p == 4 ? ( sh_band(20, 5500, 110, 8800);
             sh_pb(0, 0, 5, 60); sh_pb(1, 0, 4.5, 60); sh_pb(2, 4, 3, 40); sh_pb(3, 4, 0, 30); ) :
  p == 5 ? ( slider26 = 0; slider27 = 0;
             sh_pb(0, 2, 2, 40); sh_pb(1, 2, 2, 40); sh_pb(2, 2, 3, 50); sh_pb(3, 2, 3.5, 50); ) :
  p == 6 ? ( sh_band(550, 11000, 1100, 20000);
             sh_pb(0, 3, 0, 50); sh_pb(1, 3, 4.5, 60); sh_pb(2, 3, 5, 60); sh_pb(3, 3, 4, 50); ) :
  p == 7 ? ( sh_band(3300, 20000, 5500, 20000); slider29 = 170;
             sh_pb(0, 6, 0, 50); sh_pb(1, 6, 0, 50); sh_pb(2, 6, 5, 60); sh_pb(3, 7, 7, 80); ) :
  p == 8 ? ( slider3 = 330; slider4 = 2200; slider5 = 6600; sh_band(990, 8800, 2200, 11000);
             sh_pb(0, 4, 0, 50); sh_pb(1, 4, 3.5, 50); sh_pb(2, 5, 4.5, 60); sh_pb(3, 6, 4, 50); ) :
  p == 9 ? ( slider3 = 110; slider4 = 440; slider5 = 2200; sh_band(22, 220, 55, 1100);
             sh_pb(0, 5, 5, 60); sh_pb(1, 0, 4, 50); sh_pb(2, 0, 0, 50); sh_pb(3, 0, 0, 50); ) :
  p == 10 ? ( sh_band(20, 20000, 2200, 20000);
             sh_pb(0, 6, 0, 50); sh_pb(1, 6, 3.5, 50); sh_pb(2, 6, 4.5, 60); sh_pb(3, 7, 4, 60); );
  i = 3; loop(31, slider_automate(2 ^ (i - 1)); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

function sh_srinit() (
  sh_sr = srate; sh_fmax = 0.45 * srate;
  sh_kc = 1 - exp(-16 / (0.03 * srate));
  sh_kd = 1 - exp(-1 / (0.03 * srate));
  sh_ka = 1 - exp(-1 / (0.005 * srate));
  sh_kr = 1 - exp(-1 / (0.12 * srate));
  sh_kf = exp(-1 / (0.03 * srate));
  sh_kx = 1 - exp(-1 / (0.015 * srate));
  sh_ko = 1 - exp(-1 / (0.03 * srate));
  sh_gk = 1 / (0.008 * srate);
  sh_fis = 1 / (0.01 * srate);
  ost_init(0);
  sh_clr();
);
os_design();
os_base = 0; os_f = os_tf = os_f2n(slider2);
sh_srinit();
os_gsetup();
sh_kg = 1 - exp(-1 / (0.03 * srate * os_f));
sh_targets(); sh_snap(); sh_fi = 1;
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(34, i != 34 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != sh_sr ? ( sh_srinit(); sh_targets(); sh_snap(); os_gsetup(); );
sh_now = time_precise();
sh_tp > 0 && sh_now - sh_tp > max(0.25, 4 * samplesblock / srate) ? ( sh_clr(); sh_fi = 0; );
sh_tp = sh_now;
sh_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_base + os_lat(os_f);
sh_dn();
sh_ol_d = max(sh_ol_d, sh_ol); sh_or_d = max(sh_or_d, sh_or); sh_ol = sh_or = 0;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
sh_xl = spl0; sh_xr = spl1;
os_gate();
os_chg ? (
  u10.os_clr(); u11.os_clr(); u12.os_clr(); u13.os_clr(); u20.os_clr(); u21.os_clr(); u22.os_clr(); u23.os_clr();
  dnl.os_clr(); dnr.os_clr(); memset(GS, 0, 16); memset(DRY, 0, 2 * DN);
  sh_kg = 1 - exp(-1 / (0.03 * srate * os_f));
);
(sh_cn -= 1) <= 0 ? ( sh_cn = 16; sh_tick(); );
sh_lat = os_lat(os_f);
DRY[sh_dw] = sh_xl; DRY[DN + sh_dw] = sh_xr;
sh_dl = DRY[(sh_dw - sh_lat) & (DN - 1)]; sh_dr = DRY[DN + ((sh_dw - sh_lat) & (DN - 1))];
sh_dw = (sh_dw + 1) & (DN - 1);
sh_ms += sh_kx * (sh_mst - sh_ms); sh_ad += sh_kx * (sh_adt - sh_ad); sh_w += sh_kx * (sh_wt - sh_w);
sh_dm += sh_kx * (sh_dmt - sh_dm); sh_og += sh_ko * (sh_ogt - sh_og);
sh_split(sh_xl, 0); sh_split(sh_xr, 1);
sh_bands();
sh_i0 = 1 / BP[11]; sh_i1 = 1 / BP[27]; sh_i2 = 1 / BP[43]; sh_i3 = 1 / BP[59];
sh_w0 = BP[11] * BP[7] * BP[2]; sh_w1 = BP[27] * BP[23] * BP[18];
sh_w2 = BP[43] * BP[39] * BP[34]; sh_w3 = BP[59] * BP[55] * BP[50];
u10.os_up(BV[0]); u11.os_up(BV[1]); u12.os_up(BV[2]); u13.os_up(BV[3]);
u20.os_up(BV[4]); u21.os_up(BV[5]); u22.os_up(BV[6]); u23.os_up(BV[7]);
sh_ph = 0;
loop(os_f,
  PH[sh_ph] = sh_gen(u10.os_s(sh_ph) * sh_i0, 0, GS) * sh_w0 + sh_gen(u11.os_s(sh_ph) * sh_i1, 1, GS + 2) * sh_w1
            + sh_gen(u12.os_s(sh_ph) * sh_i2, 2, GS + 4) * sh_w2 + sh_gen(u13.os_s(sh_ph) * sh_i3, 3, GS + 6) * sh_w3;
  PH[4 + sh_ph] = sh_gen(u20.os_s(sh_ph) * sh_i0, 0, GS + 8) * sh_w0 + sh_gen(u21.os_s(sh_ph) * sh_i1, 1, GS + 10) * sh_w1
                + sh_gen(u22.os_s(sh_ph) * sh_i2, 2, GS + 12) * sh_w2 + sh_gen(u23.os_s(sh_ph) * sh_i3, 3, GS + 14) * sh_w3;
  sh_ph += 1;
);
sh_el = dnl.os_dn(PH[0], PH[1], PH[2], PH[3]);
sh_er = dnr.os_dn(PH[4], PH[5], PH[6], PH[7]);
sh_el = sh_post(sh_el, 0); sh_er = sh_post(sh_er, 1);
sh_m = 0.5 * (sh_el + sh_er) * min(1, 2 - sh_w); sh_s = 0.5 * (sh_el - sh_er) * min(1, sh_w);
sh_el = sh_m + sh_s; sh_er = sh_m - sh_s;
sh_el *= os_g; sh_er *= os_g;
RIN[sh_rw_d] = 0.5 * (sh_dl + sh_dr); REX[sh_rw_d] = 0.5 * (sh_el + sh_er); sh_rw_d = (sh_rw_d + 1) & (RN - 1);
sh_yl = (sh_dl * (1 - sh_dm) + sh_el) * sh_og; sh_yr = (sh_dr * (1 - sh_dm) + sh_er) * sh_og;
sh_yl != sh_yl ? sh_yl = 0; sh_yr != sh_yr ? sh_yr = 0;
sh_fi < 1 ? (
  sh_fi = min(sh_fi + sh_fis, 1); sh_z = sh_fi * sh_fi * (3 - 2 * sh_fi);
  sh_yl = sh_dl + sh_z * (sh_yl - sh_dl); sh_yr = sh_dr + sh_z * (sh_yr - sh_dr);
);
ost_out(sh_yl, sh_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
sh_ol = max(sh_ol, abs(spl0)); sh_or = max(sh_or, abs(spl1));

@gfx 1200 600
ui_begin(1200, 600);
SGP = 0xB4B0A7; SGS = 0xCBC7BE; SGH = 0xE0DCD2; SGI = 0x23262B; SGI2 = 0x565B62; SGA = 0xB86A0C; SGR = 0x7E7462;
SGD = 0x1A1D21;
CB1 = 0xC08850; CB2 = 0x8EC6F0; CB3 = 0x8FD3A0; CB4 = 0xEC7A6E; CTG = 0xBFD8D2; COT = 0xF0A060; COU = 0xC9CDD3;

sc != sg_fsc ? (
  sg_fsc = sc;
  sg_f10 = ui_fitfont(10, 15 * sc);
  sg_f11 = ui_fitfont(11, 16 * sc);
  sg_f12 = ui_fitfont(12, 11.5 * sc);
  sg_f13 = ui_fitfont(13, 14 * sc);
  sg_f14 = ui_fitfont(14, 27 * sc);
  sg_f15 = ui_fitfont(15, 11.5 * sc);
);
gfx_setfont(10, "Trebuchet MS", sg_f10, 'b'); gfx_setfont(11, "Trebuchet MS", sg_f11, 'b');
gfx_setfont(12, "Trebuchet MS", sg_f12, 'b'); gfx_setfont(13, "Trebuchet MS", sg_f13, 'b');
gfx_setfont(14, "Trebuchet MS", sg_f14, 'b'); gfx_setfont(15, "Trebuchet MS", sg_f15, 'b');

function sg_fstr(f) (
  f < 999.5 ? sprintf(#sgf, "%d Hz", floor(f + 0.5)) :
  f < 9995 ? sprintf(#sgf, "%.2f kHz", f / 1000) : sprintf(#sgf, "%.1f kHz", f / 1000);
  #sgf;
);
function sg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function sg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sg_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sg_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); sg_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function sg_plate(x, y, w, h, band) (
  sg_shadow(x, y, w, h);
  ui_col(0x101214); sg_r(x, y, w, h);
  ui_col(SGS); sg_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.07); sg_r(x + 1, y + 1, w - 2, 1); sg_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, 0.25); sg_r(x + 1, y + h - 3, w - 2, 2); sg_r(x + w - 3, y + 1, 2, h - 2);
  band ? ( ui_col(SGH); sg_r(x + 1, y + 1, w - 2, 32); ui_cola(SGR, 0.55); sg_r(x + 1, y + 33, w - 2, 1); );
);
function sg_split(x, y, h) ( ui_col(0x1B1E22); sg_r(x, y + 34, 1, h - 35); ui_cola(0xFFFFFF, 0.06); sg_r(x + 1, y + 34, 1, h - 35); );
function sg_rivet(x, y) ( ui_cola(0x000000, 0.45); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x6C7178); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xA9AEB4); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );

sg_lock = 0; sg_ctr = 0; sg_pt = 0x1A1D22;
function sg_cap(cx, cy, r, a, act, cap) local(i, t, x, y, rr, rd, nd) (
  x = cx * sc; y = cy * sc; rr = r * sc; rd = rr + 8 * sc; nd = 4;
  ui_col(SGI2); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(x + sin(t) * rd, y - cos(t) * rd, (i == 0 || i == nd || (sg_ctr && i * 2 == nd) ? 2.0 : 1.3) * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.16); gfx_circle(x + (2 + i * 1.3) * sc, y + (3 + i * 1.6) * sc, rr + i * 0.6 * sc, 1, 1); i += 1; );
  ui_col(0x0E1012); gfx_circle(x, y, rr, 1, 1);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2C3136);
    ui_ssline(x + sin(t) * rr * 0.80, y - cos(t) * rr * 0.80, x + sin(t) * rr * 0.95, y - cos(t) * rr * 0.95, 1.1 * sc, 0); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.30 : 0.18); ui_ssarc(x, y, rr - 0.6 * sc, -2.2, 0.6, 1 * sc);
  ui_col(ui_mix(cap, 0x000000, 0.5)); gfx_circle(x, y, rr * 0.76, 1, 1);
  ui_col(cap); gfx_circle(x, y, rr * 0.72, 1, 1);
  i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(x, y, rr * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.40 : 0.24); ui_ssarc(x, y, rr * 0.62, -1.7, -0.3, 1 * sc);
  ui_col(sg_pt); ui_kdot(x, y, a, rr * 0.72);
);
function sg_knob(cx, cy, r, idx, lo, hi, def, cap, lg) local(v, n, dx, dy, hov, did, act) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = !sg_lock && dx * dx + dy * dy <= sqr((r + 6) * sc);
  n = lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - sg_lt < 0.35 && sg_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; sg_lt = 0; ) : (
      drag_id = did; sg_my = mouse_y; sg_dz = 0; sg_lt = time_precise(); sg_lid = idx; sg_n = n;
    );
  );
  drag_id == did ? (
    sg_dz += abs(sg_my - mouse_y);
    sg_dz > 3 * sc ? (
      sg_n = min(max(sg_n + (sg_my - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = lg ? lo * (hi / lo) ^ sg_n : lo + sg_n * (hi - lo);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    sg_my = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(n + sign(mouse_wheel) * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    slider(idx) = lg ? lo * (hi / lo) ^ n : lo + n * (hi - lo); ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo), 0), 1);
  act = hov || drag_id == did;
  sg_cap(cx, cy, r, -0.75 * $pi + n * 1.5 * $pi, act, cap);
  sg_ctr = 0; sg_pt = 0x1A1D22;
  act;
);
function sg_name(cx, y, act, name, val) ( gfx_setfont(10); ui_col(act ? SGA : SGI); sg_ctxt(cx, y, act ? val : name); );
function sg_ends(cx, cy, r, a, b, m) (
  gfx_setfont(12); ui_col(SGI2);
  strlen(a) ? sg_ctxt(cx - (r + 8) * 0.7071 - 9, cy + (r + 8) * 0.7071 - 2, a);
  strlen(b) ? sg_ctxt(cx + (r + 8) * 0.7071 + 9, cy + (r + 8) * 0.7071 - 2, b);
  strlen(m) ? sg_ctxt(cx, cy - r - 17, m);
);
function sg_lamp(cx, cy, on) local(x, y, hit) (
  x = cx * sc; y = cy * sc;
  hit = pressed && drag_id == 0 && abs(mouse_x - x) < 10 * sc && abs(mouse_y - y) < 10 * sc; hit ? drag_id = -1;
  on ? ( ui_cola(0xFFB43C, 0.18); gfx_circle(x, y, 11 * sc, 1, 1); ui_cola(0xFFB43C, 0.25); gfx_circle(x, y, 8.5 * sc, 1, 1); );
  ui_col(0x050506); gfx_circle(x, y, 7.5 * sc, 1, 1);
  ui_col(0xE9E0C6); gfx_circle(x, y, 6.5 * sc, 1, 1);
  ui_col(on ? 0xFFB43C : 0x5A4A30); gfx_circle(x, y, 4.2 * sc, 1, 1);
  ui_cola(0xFFFFFF, on ? 0.6 : 0.15); gfx_circle(x - 1.4 * sc, y - 1.4 * sc, 1.4 * sc, 1, 1);
  hit;
);
function sg_key(x, y, w, h, lbl, on, col) ( lk_well = 0x0A0B0C; lk_font = 13; lk_font2 = 13; lk_fit(x, y, w, h, on, col, lbl); );
function sg_rbox(cx, y, w, h, s, lit) local(x) (
  x = cx - w / 2;
  ui_col(0x0C0D0F); sg_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(lit ? 0xE9E3D2 : 0x8E8A80); sg_r(x, y, w, h);
  ui_cola(0x000000, 0.22); sg_r(x, y, w, 2); sg_r(x, y, 2, h);
  gfx_setfont(13); ui_col(0x24211C); sg_ctxt(cx, y + h / 2 + 0.5, s);
);
function sg_dbox(cx, y, w, h, s, col) local(x, hov, hit) (
  x = cx - w / 2;
  hov = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  sg_shadow(x, y, w, h);
  ui_col(0x07080A); sg_r(x - 1, y - 1, w + 2, h + 2);
  ui_col(hov ? 0x262A30 : 0x1C1F24); sg_r(x, y, w, h);
  ui_cola(0x000000, 0.35); sg_r(x, y, w, 2); sg_r(x, y, 2, h);
  ui_col(col); sg_r(x + 2, y + h - 3, w - 4, 2);
  gfx_setfont(13); ui_col(0xF2EEE4); sg_ctxt(cx - 8, y + h / 2, s);
  ui_col(SGI2); gfx_triangle((x + w - 16) * sc, (y + h / 2 - 2) * sc, (x + w - 8) * sc, (y + h / 2 - 2) * sc, (x + w - 12) * sc, (y + h / 2 + 3) * sc);
  hit;
);
function sg_fall(v, p) ( p = p > 0.0000001 ? 20 * log10(p) : -90; p > v ? p : max(v - 0.6, -90); );
function sg_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? 0xFF3A2A : zone == 1 ? 0xFFC81E : 0x3CE05A;
  lit ? ( ui_cola(c, 0.16); sg_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); sg_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); sg_r(x, y, w, 1.5); )
      : ( ui_col(ui_mix(c, 0x141619, 0.82)); sg_r(x, y, w, h); );
);
function sg_bar(x, y, w, h, v, pk) local(n, i, sw, d) (
  n = 16; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; sg_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d || (pk > -48 && abs(pk - d) < 1.5), d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);

DX0 = 28; DXW = 1144; GY0 = 116; GH = 156;
function sg_fx(f) ( DX0 + log(max(f, 20) / 20) / log(1000) * DXW; );
function sg_xf(x) ( 20 * 1000 ^ min(max((x - DX0) / DXW, 0), 1); );
FB = 262144; SPI = 270000; SPE = 272000; FN = 2048;
function sg_spec(ring, sp) local(i, w, k, x, fq, b0, b1, m, j, re, im, db) (
  w = sh_rw_d; i = 0;
  loop(FN, k = ring[(w - FN + i) & (RN - 1)]; FB[2 * i] = k * (0.5 - 0.5 * cos(2 * $pi * i / FN)); FB[2 * i + 1] = 0; i += 1; );
  fft(FB, FN); fft_permute(FB, FN);
  x = 0;
  loop(DXW,
    fq = sg_xf(DX0 + x) / srate * FN; b0 = max(1, floor(fq)); b1 = max(b0, floor(sg_xf(DX0 + x + 1) / srate * FN));
    b1 == b0 ? (
      re = FB[2 * b0]; im = FB[2 * b0 + 1]; m = re * re + im * im;
      re = FB[2 * b0 + 2]; im = FB[2 * b0 + 3]; m += (fq - b0) * (re * re + im * im - m);
    ) : (
      m = 0; j = b0; loop(min(b1 - b0 + 1, 64), j < FN / 2 ? ( re = FB[2 * j]; im = FB[2 * j + 1]; m = max(m, re * re + im * im); ); j += 1; );
    );
    db = m > 0 ? 10 * log10(m) - 54 + 3 * log(fq * srate / FN / 1000) / log(2) : -120;
    sp[x] = db > sp[x] ? sp[x] + 0.6 * (db - sp[x]) : sp[x] + 0.18 * (db - sp[x]);
    x += 1;
  );
);
function sg_dy(db) ( GY0 + GH - min(max((db + 100) / 90, 0), 1) * GH; );
function sg_strip(y, lo, hi, col, name) local(xl, xh, hov, did, f, d, mx) (
  did = 3000 + lo; xl = sg_fx(slider(lo)); xh = sg_fx(slider(hi));
  mx = mouse_x / sc;
  hov = mouse_y >= y * sc && mouse_y < (y + 24) * sc && mx >= DX0 - 6 && mx <= DX0 + DXW + 6;
  pressed && hov && drag_id == 0 ? (
    time_precise() - sg_slt < 0.35 && sg_sid == lo ? ( slider(lo) = 20; slider(hi) = 20000; ui_auto(lo); ui_auto(hi); drag_id = -1; ) : (
      drag_id = did; sg_sid = lo; sg_slt = time_precise(); sg_sx = mx;
      sg_sm = abs(mx - xl) < 10 ? 1 : abs(mx - xh) < 10 ? 2 : mx > xl && mx < xh ? 3 : mx <= xl ? 1 : 2;
    );
  );
  drag_id == did ? (
    d = mx - sg_sx; sg_sx = mx;
    sg_sm == 1 ? ( slider(lo) = min(max(sg_xf(xl + d), 20), slider(hi) / 1.5); ui_auto(lo); ) :
    sg_sm == 2 ? ( slider(hi) = max(min(sg_xf(xh + d), 20000), slider(lo) * 1.5); ui_auto(hi); ) : (
      d = max(min(d, DX0 + DXW - xh), DX0 - xl);
      slider(lo) = sg_xf(xl + d); slider(hi) = sg_xf(xh + d); ui_auto(lo); ui_auto(hi);
    );
    xl = sg_fx(slider(lo)); xh = sg_fx(slider(hi));
  );
  ui_col(0x101215); sg_r(DX0, y, DXW, 24);
  ui_cola(col, 0.22); sg_r(DX0, y, DXW, 24);
  ui_col(ui_mix(col, 0x101215, 0.28)); sg_r(xl, y + 2, xh - xl, 20);
  ui_cola(0xFFFFFF, 0.25); sg_r(xl, y + 2, xh - xl, 1);
  ui_col(0x101215); sg_r(xl, y + 2, 2, 20); sg_r(xh - 2, y + 2, 2, 20);
  gfx_setfont(13); ui_col(0x1A1712);
  slider(lo) <= 20.5 && slider(hi) >= 19999 ? sprintf(#sgstr, "%s   FULL RANGE", name)
    : ( strcpy(#sgf0, sg_fstr(slider(lo))); sprintf(#sgstr, "%s   %s - %s", name, #sgf0, sg_fstr(slider(hi))); );
  gfx_measurestr(#sgstr, f, d); f /= sc;
  xh - xl > f + 16 ? sg_ctxt(0.5 * (xl + xh), y + 12.5, #sgstr) : ( ui_col(SGI); sg_ltxt(xh + 8 > DX0 + DXW - f ? DX0 + 6 : xh + 8, y + 12.5, #sgstr); );
);
function sg_xline(idx, lo, hi, col, n) local(x, hov, did, mx) (
  did = 3100 + idx; x = sg_fx(slider(idx)); mx = mouse_x / sc;
  hov = abs(mx - x) < 7 && mouse_y >= GY0 * sc && mouse_y < (GY0 + GH) * sc;
  pressed && hov && drag_id == 0 ? (
    time_precise() - sg_xlt < 0.35 && sg_xid == idx ? ( slider(idx) = idx == 3 ? 220 : idx == 4 ? 1100 : 5500; ui_auto(idx); drag_id = -1; ) :
    ( drag_id = did; sg_xid = idx; sg_xlt = time_precise(); );
  );
  drag_id == did ? ( slider(idx) = min(max(sg_xf(mx), lo), hi); ui_auto(idx); x = sg_fx(slider(idx)); );
  ui_cola(col, hov || drag_id == did ? 0.95 : 0.7); sg_r(x - 0.75, GY0, 1.5, GH);
  ui_col(0x0C0D0F); gfx_circle(x * sc, (GY0 + 13) * sc, 9 * sc, 1, 1);
  ui_col(col); gfx_circle(x * sc, (GY0 + 13) * sc, 7.5 * sc, 1, 1);
  gfx_setfont(12); ui_col(0x1A1712); sg_ctxt(x, GY0 + 13.5, n);
  hov || drag_id == did ? ( sg_rbox(x, GY0 + 28, 76, 20, sg_fstr(slider(idx)), 1); );
);

function sg_band(b, cx) local(s, cap, a, m, on, f0, f1, k, ov, i) (
  s = 10 + b * 4; on = slider(s + 3) >= 0.5;
  cap = b == 0 ? CB1 : b == 1 ? CB2 : b == 2 ? CB3 : CB4;
  sg_lamp(cx - 52, 341, on) ? ( slider(s + 3) = on ? 0 : 1; ui_auto(s + 3); );
  gfx_setfont(11); ui_col(SGI); sg_ltxt(cx - 38, 341, b == 0 ? "1  LOW" : b == 1 ? "2  LOW MID" : b == 2 ? "3  HIGH MID" : "4  HIGH");
  ui_col(cap); sg_r(cx - 62, 362, 124, 3);
  gfx_setfont(10); ui_col(SGI2); sg_ctxt(cx, 384, "MODE");
  k = floor(min(max(slider(s), 0), 7) + 0.5);
  sg_dbox(cx, 396, 132, 30, k == 0 ? "WARM" : k == 1 ? "TRANSISTOR" : k == 2 ? "TAPE" : k == 3 ? "VALVE" : k == 4 ? "TRIODE" :
          k == 5 ? "PUSH-PULL" : k == 6 ? "2ND" : "3RD", cap) ? (
    gfx_x = (cx - 66) * sc; gfx_y = 426 * sc;
    #sgm = ""; i = 0;
    loop(8, strcat(#sgm, i == k ? "!" : ""); strcat(#sgm, i == 0 ? "Warm" : i == 1 ? "Transistor" : i == 2 ? "Tape" : i == 3 ? "Valve" :
      i == 4 ? "Triode" : i == 5 ? "Push-pull" : i == 6 ? "2nd (pure)" : "3rd (pure)"); i < 7 ? strcat(#sgm, "|"); i += 1; );
    i = gfx_showmenu(#sgm);
    i > 0 ? (
      slider28 >= 0.5 ? ( k = 0; loop(4, slider(10 + k * 4) = i - 1; ui_auto(10 + k * 4); k += 1; ); )
                      : ( slider(s) = i - 1; ui_auto(s); );
    );
  );
  a = slider(s + 1); sprintf(#sgam, "%.1f", a);
  ov = sg_knob(cx - 40, 480, 24, s + 1, 0, 10, 0, cap, 0);
  slider28 >= 0.5 && slider(s + 1) != a ? ( k = 0; loop(4, k != b ? ( slider(10 + k * 4 + 1) = min(max(slider(10 + k * 4 + 1) + slider(s + 1) - a, 0), 10); ui_auto(11 + k * 4); ); k += 1; ); );
  sprintf(#sgam, "%.1f", slider(s + 1)); sg_name(cx - 40, 523, ov, "AMOUNT", #sgam);
  m = slider(s + 2);
  ov = sg_knob(cx + 40, 480, 24, s + 2, 0, 100, 50, COU, 0);
  slider28 >= 0.5 && slider(s + 2) != m ? ( k = 0; loop(4, k != b ? ( slider(10 + k * 4 + 2) = min(max(slider(10 + k * 4 + 2) + slider(s + 2) - m, 0), 100); ui_auto(12 + k * 4); ); k += 1; ); );
  sprintf(#sgx, "%d %%", floor(slider(s + 2) + 0.5)); sg_name(cx + 40, 523, ov, "MIX", #sgx);
  f0 = b == 0 ? slider6 : b == 1 ? slider3 : b == 2 ? slider4 : slider5;
  f1 = b == 0 ? slider3 : b == 1 ? slider4 : b == 2 ? slider5 : slider7;
  f0 = max(f0, slider6); f1 = min(f1, slider7);
  f1 > f0 ? ( strcpy(#sgf0, sg_fstr(f0)); sprintf(#sgrg, "%s - %s", #sgf0, sg_fstr(f1)); ) : strcpy(#sgrg, "OUTSIDE TARGET");
  sg_rbox(cx, 546, 144, 22, #sgrg, on && f1 > f0);
  !on ? ( ui_cola(SGS, 0.5); sg_r(cx - 80, 370, 160, 206); sg_lamp(cx - 52, 341, 0); );
);

ui_col(ui_mix(SGP, 0x000000, 0.3)); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(SGP); sg_r(0, 0, 1200, 600);
ui_cola(0xFFFFFF, 0.08); sg_r(0, 0, 1200, 1.5); sg_r(0, 0, 1.5, 600);
ui_cola(0x000000, 0.3); sg_r(0, 597, 1200, 3); sg_r(1197, 0, 3, 600);
sg_rivet(8, 8); sg_rivet(1191, 8); sg_rivet(8, 591); sg_rivet(1191, 591);
ui_col(SGH); sg_r(16, 10, 1168, 54);
ui_cola(0x000000, 0.3); sg_r(16, 10, 1168, 1); sg_r(16, 10, 1, 54);
ui_col(SGR); sg_r(16, 64, 1168, 2);
ui_col(SGR); gfx_circle(44 * sc, 37 * sc, 15 * sc, 1, 1);
gfx_setfont(4); ui_col(0x2A2418); ui_text(44 * sc, 31.5 * sc, "GFX");
gfx_setfont(14); ui_col(SGI); sg_ltxt(70, 37, "SHEEN"); gfx_measurestr("SHEEN", sg_tw, sg_th);
sg_tx = 70 + sg_tw / sc + 14;
gfx_setfont(15); ui_col(SGI2); sg_ltxt(sg_tx, 29, "MASTERING EXCITER"); sg_ltxt(sg_tx, 45, "4 BANDS, TARGET + OUTPUT");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );
k_ = pk_preset(470 * sc, 20 * sc, 330 * sc, 34 * sc, pr_cur, #sh_pm);
k_ > 0 ? prs_dirty = k_;
by_key(842, 23, 1, 18);
os_key(1000, 26, 2, SGI, 16);
ui_size_picker(1112 * sc, 28 * sc);

sg_plate(16, 76, 1168, 236, 0);
