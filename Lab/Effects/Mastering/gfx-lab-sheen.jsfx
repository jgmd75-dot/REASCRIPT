SGFL = ui_mix(ui_mix(SGP, 0, 0.06), 0, 0.09);
function sg_ends(cx, cy, rd, sz, c) local(t) (
  ui_col(c); t = -0.75 * $pi; v5_d(cx + sin(t) * rd, cy - cos(t) * rd, sz); v5_d(cx - sin(t) * rd, cy - cos(t) * rd, sz);
);
function sg_hover(cx, cy, fs) ( sg_hon = 1; sg_hx = cx; sg_hy = cy; sg_hfs = fs; );
function sg_val(idx, kind) local(v) (
  v = slider(idx);
  kind == 0 ? sprintf(#sg_hv, "%.1f", v) :
  kind == 1 ? sprintf(#sg_hv, "%d %%", floor(v + 0.5)) :
  kind == 2 ? strcpy(#sg_hv, sg_fstr(v)) :
  kind == 3 ? sprintf(#sg_hv, "%+.1f dB", v) :
  ( v < 99.5 ? sprintf(#sg_hv, "MONO %d %%", floor(v + 0.5)) : v > 100.5 ? sprintf(#sg_hv, "WIDE %d %%", floor(v + 0.5)) : strcpy(#sg_hv, "100 %"); );
);
function sg_cream(cx, cy, r, v, pc) local(a, i, t) (
  a = -0.75 * $pi + v * 1.5 * $pi;
  v5_shc(cx, cy, r);
  ui_col(0x1B1D1E); v5_d(cx, cy, r);
  i = 0; loop(30, t = i / 30 * 2 * $pi; ui_col(0x34383A); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xBDB49E); v5_d(cx, cy, r * 0.74);
