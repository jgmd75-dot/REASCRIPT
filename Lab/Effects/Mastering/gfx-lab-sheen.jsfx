function sg_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * sg_kt * sc, 'b'); );
function sg_fc(px) ( gfx_setfont(12, "Courier New", px * sg_kt * sc, 'b'); );
function sg_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function sg_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function sg_fstr(f) (
