  ui_cola(0xFFFFFF, 0.25); v5_r(xl, y + 2, xh - xl, 1);
  ui_col(0x101215); v5_r(xl, y + 2, 2, STH - 4); v5_r(xh - 2, y + 2, 2, STH - 4);
  sg_ft(12); ui_col(0x1A1712);
  slider(lo) <= 20.5 && slider(hi) >= 19999 ? sprintf(#sgstr, "%s   FULL RANGE", name)
    : ( strcpy(#sgf0, sg_fstr(slider(lo))); sprintf(#sgstr, "%s   %s - %s", name, #sgf0, sg_fstr(slider(hi))); );
  f = sg_tw(#sgstr);
  xh - xl > f + 16 ? v5_t(0.5 * (xl + xh), y + STH / 2 + 0.5, #sgstr) : ( ui_col(col); sg_tl(xh + 8 > DX0 + DXW - f ? DX0 + 6 : xh + 8, y + STH / 2 + 0.5, #sgstr); );
);
function sg_xline(idx, lo, hi, col, n) local(x, hov, did, mx) (
  did = 3100 + idx; x = sg_fx(slider(idx)); mx = mouse_x / sc;
  hov = abs(mx - x) < 7 && v5_hit(DX0, GY0, DXW, GH);
  v5_pr && hov && v5_drag == 0 ? (
    time_precise() - sg_xlt < 0.35 && sg_xid == idx ? ( slider(idx) = idx == 3 ? 220 : idx == 4 ? 1100 : 5500; ui_auto(idx); v5_drag = -1; sg_xlt = 0; ) :
    ( v5_drag = did; sg_xid = idx; sg_xlt = time_precise(); );
  );
  v5_drag == did ? ( slider(idx) = min(max(sg_xf(mx), lo), hi); ui_auto(idx); x = sg_fx(slider(idx)); );
  ui_cola(col, hov || v5_drag == did ? 0.95 : 0.7); v5_r(x - 0.75, GY0, 1.5, GH);
  ui_col(0x0C0D0F); v5_d(x, GY0 + 11, 8.5);
