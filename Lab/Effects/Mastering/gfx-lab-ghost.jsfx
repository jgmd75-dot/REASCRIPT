  ui_cola(0x000000, 0.14); gp_r(x + 2, y + 2, w - 4, 2); gp_r(x + 2, y + 2, 2, h - 4);
  gfx_setfont(16); ui_col(0x16201D); gp_ctxt(x + w / 2, y + h / 2 + 1, s);
);

