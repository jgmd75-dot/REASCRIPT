gp_a = gp_knob(956, gp_k1, 22, 10, 0, 12, 0, CGY, 4); sprintf(#gpv, "+%.1f dB", slider10); gp_name(956, gp_k1, 22, gp_a, "MAKEUP", #gpv);
gp_key(1040, gp_k1 - 24, 64, 48, "IN", slider3 >= 0.5, LK_AMB) ? gp_tog(3);
