gp_i = 0; loop(3, ui_cola(GHM, 0.07); gfx_x = 70 * sc + (gp_i - 1) * 1.5 * sc; gfx_y = 37 * sc - gp_th * 0.5 - 1.5 * sc; gfx_drawstr("GHOST"); gp_i += 1; );
