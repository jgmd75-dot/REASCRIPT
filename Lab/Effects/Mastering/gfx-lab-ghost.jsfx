desc:Ghost [mastering limiter] (GFX Lab)
//tags: mastering limiter brickwall true peak soft limiter mid side M/S parallel oversampling loudness LUFS
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass (.jsfx-inc) in the same folder.

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-12,24,0.1>-Input gain (dB)
slider3:1<0,1,1{Off,On}>-Soft limiter
slider4:-6<-24,0,0.1>-Soft threshold (dBFS)
slider5:12<0,24,0.1>-Soft knee (dB)
slider6:1<0.05,50,0.01>-Soft attack (ms)
slider7:100<5,1000,0.1>-Soft release (ms)
slider8:0<-12,12,0.1>-Side threshold (dB)
slider9:100<0,100,1>-Soft mix (%)
slider10:0<0,12,0.1>-Makeup (dB)
slider11:1<0,1,1{Off,On}>-Brickwall
slider12:-0.3<-12,-0.3,0.1>-Ceiling (dBFS)
slider13:1.5<0.1,5,0.01>-Brickwall attack (ms)
slider14:60<1,1000,0.1>-Brickwall release (ms)
slider15:50<0,100,1>-Shape (%)
slider16:0<-100,100,1>-Bend (%)
slider17:1<0,1,1{Off,On}>-Link
slider18:1<0,1,1{Off,On}>-True peak
slider19:0<0,1,1{Off,On}>-Unity
slider20:0<0,1,1{Off,On}>-Ghost
slider21:1<0,2,1{1x,2x,4x}>-Oversampling
slider22:prs_sel=0<0,10,1{No preset,Init,Clean Master,Loud Pop,Dense Rock,Side Tamer,Peak Shaper,Streaming Safe,Hip-Hop Punch,Acoustic Air,Parallel Push}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc

@init
#ui_man = "gfx-lab-ghost";
ext_noinit = 1;

function gh_tc(ms, fs) ( 1 - exp(-1 / (max(ms, 0.001) * 0.001 * fs)); );
function gh_db(d) ( exp(d * 0.11512925464970228); );
function gh_ldb(x) ( 8.685889638065035 * log(max(x, 0.000000001)); );

LMN = 8192; LMK = 8191;
function lm_init(base, dmax, len) instance(au, gq, qv, qi, hh, bb, dd, aa, a1, b1, dg, w, t, qh, qt, s1, s2, s3, e, xo, cv, kr, bd, rs) local(i) (
  au = base; gq = base + LMN; qv = base + 2 * LMN; qi = base + 3 * LMN; hh = base + 4 * LMN; bb = base + 5 * LMN;
  memset(au, 0, LMN); i = 0; loop(LMN, gq[i] = 1; hh[i] = 1; bb[i] = 1; i += 1; );
  dd = dmax; aa = max(1, min(len, dmax + 1)); a1 = ceil(aa / 2); b1 = aa - a1 + 1; dg = dd - aa + 1;
  w = 0; t = 0; qh = 0; qt = 0; e = 1; xo = 0; rs = 0;
  s1 = aa; s2 = a1; s3 = b1;
);
function lm_len(len) instance(gq, qv, qi, hh, bb, dd, aa, a1, b1, dg, w, t, qh, qt, s1, s2, s3) local(j, y, k) (
  aa = max(1, min(len, dd + 1)); a1 = ceil(aa / 2); b1 = aa - a1 + 1; dg = dd - aa + 1;
  qh = qt = 0; j = t - aa + 1;
  loop(aa - 1,
    y = gq[(w - (t - j) - dg) & LMK];
    while (qt > qh && qv[(qt - 1) & LMK] >= y ? ( qt -= 1; 1; ) : 0; );
    qv[qt & LMK] = y; qi[qt & LMK] = j; qt += 1;
    j += 1;
  );
  s1 = s2 = s3 = 0; k = 1;
  loop(aa, s1 += hh[(w - k) & LMK]; k <= a1 ? s2 += hh[(w - k) & LMK]; k <= b1 ? s3 += bb[(w - k) & LMK]; k += 1; );
);
function lm_run(x, g) instance(au, gq, qv, qi, hh, bb, dd, aa, a1, b1, dg, w, t, qh, qt, s1, s2, s3, e, xo, cv, kr, bd, rs) local(y, hd, o) (
  au[w] = x; gq[w] = g;
  y = gq[(w - dg) & LMK];
  while (qt > qh && qv[(qt - 1) & LMK] >= y ? ( qt -= 1; 1; ) : 0; );
  qv[qt & LMK] = y; qi[qt & LMK] = t; qt += 1;
  while (qi[qh & LMK] <= t - aa ? ( qh += 1; 1; ) : 0; );
  hd = qv[qh & LMK];
  hd <= e ? e = hd : (
    o = bd != 0 ? kr * exp(bd * (min(gh_ldb(hd / e), 24) / 6 - 1)) : kr;
    e += (hd - e) * min(o, 1);
  );
  hh[w] = e;
  s1 += e - hh[(w - aa) & LMK];
  s2 += e - hh[(w - a1) & LMK]; o = s2 / a1; bb[w] = o;
  s3 += o - bb[(w - b1) & LMK];
  xo = au[(w - dd) & LMK];
  w = (w + 1) & LMK; t += 1;
  (rs += 1) >= 65536 ? ( rs = 0; this.lm_len(aa); );
  o = s1 / aa; o += cv * (s3 / b1 - o);
  min(o, 1);
);

TPC = 1400000;
function tp_design() local(p, j, f, t, s, w, k) (
  p = 0;
  loop(3,
    f = (p + 1) / 4; s = 0; j = -7;
    loop(16, t = f - j; w = 0.5 + 0.5 * cos($pi * t / 8.5); k = sin($pi * t) / ($pi * t);
      TPC[p * 16 + j + 7] = k * w; s += k * w; j += 1; );
    j = 0; loop(16, TPC[p * 16 + j] /= s; j += 1; );
    p += 1;
  );
);
function tp_init(base) instance(hb, hw, c8) ( hb = base; hw = 0; c8 = 0; memset(hb, 0, 32); );
function tp_det(x) instance(hb, hw, c8) local(v, m, p, q, h) (
  hw = (hw + 1) & 15; hb[hw] = hb[hw + 16] = x;
  h = hb + hw + 1;
  c8 = h[7]; m = abs(c8); p = 0;
  loop(3,
    q = TPC + p * 16;
    v = q[0] * h[0] + q[1] * h[1] + q[2] * h[2] + q[3] * h[3] + q[4] * h[4] + q[5] * h[5] + q[6] * h[6] + q[7] * h[7]
      + q[8] * h[8] + q[9] * h[9] + q[10] * h[10] + q[11] * h[11] + q[12] * h[12] + q[13] * h[13] + q[14] * h[14] + q[15] * h[15];
    m = max(m, abs(v)); p += 1;
  );
  m;
);

function gh_sg(env, thr) local(o) (
  o = gh_ldb(env) - thr;
  o >= gh_kw ? gh_db(-o) : o <= -gh_kw ? 1 : gh_db(-sqr(o + gh_kw) / (4 * gh_kw));
);

LUB = 1410000;
function lu_setup() local(k, q, vh, vb, a0) (
  k = tan($pi * 1681.974450955533 / srate); q = 0.7071752369554196;
  vh = 10 ^ (3.999843853973347 / 20); vb = vh ^ 0.4996667741545416; a0 = 1 + k / q + k * k;
  lu_b0 = (vh + vb * k / q + k * k) / a0; lu_b1 = 2 * (k * k - vh) / a0; lu_b2 = (vh - vb * k / q + k * k) / a0;
  lu_a1 = 2 * (k * k - 1) / a0; lu_a2 = (1 - k / q + k * k) / a0;
  k = tan($pi * 38.13547087602444 / srate); q = 0.5003270373238773; a0 = 1 + k / q + k * k;
  lu_c1 = 2 * (k * k - 1) / a0; lu_c2 = (1 - k / q + k * k) / a0;
  lu_n = floor(0.1 * srate); lu_i = 0; lu_acc = 0; lu_bi = 0; lu_sum = 0; lu_full = 0;
  memset(LUB, 0, 30);
);
function lu_run(x) instance(x1, x2, y1, y2, z1, z2) local(y, z) (
  y = lu_b0 * x + lu_b1 * x1 + lu_b2 * x2 - lu_a1 * y1 - lu_a2 * y2; x2 = x1; x1 = x;
  z = y - 2 * y1 + y2 - lu_c1 * z1 - lu_c2 * z2; y2 = y1; y1 = y; z2 = z1; z1 = z;
  abs(y1) < 0.000000000001 ? y1 = 0; abs(z1) < 0.000000000001 ? z1 = 0;
  z * z;
);
function lu_clr() instance(x1, x2, y1, y2, z1, z2) ( x1 = x2 = y1 = y2 = z1 = z2 = 0; );

GH_MBL = 1000000; GH_MBR = 1100000; GH_MTL = 1200000; GH_MTR = 1300000; GH_MTD = 1401000;
function gh_bwset() local(d) (
  d = os_f * gh_nb;
  bwL.lm_init(GH_MBL, d, gh_aa); bwR.lm_init(GH_MBR, d, gh_aa);
  gh_ska = gh_tc(gh_sat, srate * os_f); gh_skr = gh_tc(gh_srt, srate * os_f);
  bwL.kr = bwR.kr = gh_tc(gh_brt, srate * os_f);
  gh_sm = gh_ss = 0;
);
function gh_alen() ( max(1, min(floor(min(max(slider13, 0.1), 5) * 0.001 * srate * os_f + 0.5), os_f * gh_nb + 1)); );
function gh_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  gh_aa = gh_alen(); gh_bwset();
  tpL.lm_init(GH_MTL, gh_ltp - 1, gh_ltp); tpR.lm_init(GH_MTR, gh_ltp - 1, gh_ltp);
  tpL.kr = tpR.kr = gh_tc(30, srate); tpL.cv = tpR.cv = 0; tpL.bd = tpR.bd = 0;
  tdL.tp_init(GH_MTD); tdR.tp_init(GH_MTD + 32); toL.tp_init(GH_MTD + 64); toR.tp_init(GH_MTD + 96);
);
function gh_srinit() (
  gh_sr = srate;
  gh_nb = ceil(0.005 * srate);
  gh_ltp = max(8, floor(0.0005 * srate + 0.5));
  os_base = gh_nb + 7 + gh_ltp;
  c_kn = gh_tc(30, srate); c_lk = gh_tc(10, srate); c_sw = gh_tc(15, srate);
  gh_fis = 1 / (0.01 * srate);
  gh_sat = max(slider6, 0.05); gh_srt = max(slider7, 5); gh_brt = max(slider14, 1);
  ost_init(0); lu_setup(); luL.lu_clr(); luR.lu_clr();
  gh_clear();
);
function gh_reset() (
  gh_clear(); memset(BY_BUF, 0, 2 * BY_N);
  gh_fi = 0;
);

#gh_pm = "Init|Clean Master|Loud Pop|Dense Rock|Side Tamer|Peak Shaper|Streaming Safe|Hip-Hop Punch|Acoustic Air|Parallel Push";
function gh_set(ig, so, th, kn, sa, sr, sd, mx, mk, bo, ce, ba, br, sh, be) (
  slider2 = ig; slider3 = so; slider4 = th; slider5 = kn; slider6 = sa; slider7 = sr; slider8 = sd; slider9 = mx;
  slider10 = mk; slider11 = bo; slider12 = ce; slider13 = ba; slider14 = br; slider15 = sh; slider16 = be;
  slider17 = 1; slider18 = bo;
);
function load_preset(p) local(i) (
  p == 1 || p == 11 ?
            gh_set(    0,  1,  -6,  12,  1,  100,  0, 100,  0,   1, -0.3, 1.5,  60, 50,   0) :
  p == 2  ? gh_set(    2,  1,  -4,  12,  2,  150,  0, 100,  0,   1, -0.3, 2,   120, 60,  30) :
  p == 3  ? gh_set(    6,  1,  -6,   9,  0.5, 80,  0, 100,  1,   1, -0.3, 1,    40, 50,  40) :
  p == 4  ? gh_set(    8,  1,  -8,   6,  0.3, 50, -2, 100,  1,   1, -0.3, 0.8,  30, 30,  20) :
  p == 5  ? gh_set(    2,  1,  -6,  12,  1,  120, -6, 100,  0,   1, -0.3, 2,   100, 50,   0) :
  p == 6  ? gh_set(    0,  1,  -8,  10,  0.5, 60,  0, 100,  0,   0, -0.3, 1.5,  60, 50,   0) :
  p == 7  ? gh_set(    3,  1,  -5,  12,  2,  150,  0, 100,  0,   1, -1,   2.5, 150, 70,  30) :
  p == 8  ? gh_set(    5,  1,  -6,   6,  3,   60,  0,  70,  1,   1, -0.3, 0.5,  25, 20,  50) :
  p == 9  ? gh_set(    2,  1,  -3,  18,  3,  250,  0,  60,  0,   1, -0.5, 3,   250, 80,   0) :
  p == 10 ? gh_set(    4,  1, -12,   6,  0.2, 40,  0,  40,  2,   1, -0.3, 1.5,  60, 50,   0);
  i = 2; loop(17, ui_auto(i); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

os_design(); tp_design();
os_f = os_tf = os_f2n(slider21);
gh_srinit();
os_gsetup();
gh_snap = 1; gh_fi = 1;
pdc_delay = os_base + os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(22, i != 22 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
os_snap(slider(21));

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != gh_sr ? gh_srinit();
gh_now = time_precise();
gh_tp > 0 && gh_now - gh_tp > max(0.25, 4 * samplesblock / srate) ? gh_reset();
gh_tp = gh_now;
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
os_tf = os_f2n(slider21); pdc_delay = os_base + os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
gh_gint = gh_db(min(max(slider2, -12), 24));
gh_sont = slider3 >= 0.5;
gh_stht = min(max(slider4, -24), 0);
gh_kw = max(min(max(slider5, 0), 24) * 0.5, 0.05);
gh_sdt = min(max(slider8, -12), 12);
gh_mxt = min(max(slider9, 0), 100) / 100;
gh_mkt = gh_db(min(max(slider10, 0), 12));
gh_bont = slider11 >= 0.5;
gh_cet = gh_db(min(max(slider12, -12), -0.3));
gh_cvt = min(max(slider15, 0), 100) / 100;
gh_bdt = min(max(slider16, -100), 100) / 100 * 1.4;
gh_lkt = slider17 >= 0.5;
gh_tont = slider18 >= 0.5;
gh_unt = slider19 >= 0.5;
gh_gst = slider20 >= 0.5;
gh_v = max(min(slider6, 50), 0.05); gh_v != gh_sat ? ( gh_sat = gh_v; gh_ska = gh_tc(gh_sat, srate * os_f); );
gh_v = max(min(slider7, 1000), 5); gh_v != gh_srt ? ( gh_srt = gh_v; gh_skr = gh_tc(gh_srt, srate * os_f); );
gh_v = max(min(slider14, 1000), 1); gh_v != gh_brt ? ( gh_brt = gh_v; bwL.kr = bwR.kr = gh_tc(gh_brt, srate * os_f); );
gh_v = gh_alen();
gh_v != gh_aa ? (
  gh_aa += gh_v > gh_aa ? max(1, floor((gh_v - gh_aa) * 0.25)) : -max(1, floor((gh_aa - gh_v) * 0.25));
  bwL.lm_len(gh_aa); bwR.lm_len(gh_aa);
);
gh_snap ? ( gh_gin = gh_gint; gh_son = gh_sont; gh_sth = gh_stht; gh_sd = gh_sdt; gh_mx = gh_mxt; gh_mk = gh_mkt;
            gh_bon = gh_bont; gh_ce = gh_cet; gh_cv = gh_cvt; gh_bd = gh_bdt; gh_lk = gh_lkt; gh_ton = gh_tont;
            gh_un = gh_unt; gh_gs = gh_gst; gh_snap = 0; );
gh_sm = abs(gh_sm) < 0.000000000001 ? 0 : gh_sm; gh_ss = abs(gh_ss) < 0.000000000001 ? 0 : gh_ss;
gh_gm_d = min(gh_gm_d, gh_ldb(gh_gmm)); gh_gs_d = min(gh_gs_d, gh_ldb(gh_gsm)); gh_gb_d = min(gh_gb_d, gh_ldb(gh_gbm));
gh_gt_d = min(gh_gt_d, gh_ldb(gh_gtm)); gh_gmm = gh_gsm = gh_gbm = gh_gtm = 1;
gh_il_d = max(gh_il_d, gh_il); gh_ir_d = max(gh_ir_d, gh_ir); gh_il = gh_ir = 0;
gh_ol_d = max(gh_ol_d, gh_ol); gh_or_d = max(gh_or_d, gh_or); gh_ol = gh_or = 0;
gh_tpk_d = max(gh_tpk_d, gh_tpk); gh_tpk = 0;
gh_lu_d = lu_full ? -0.691 + 10 * log10(max(lu_sum / (30 * lu_n), 0.0000000001)) : -99;
os_snapb(slider(21));

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
gh_gin += (gh_gint - gh_gin) * c_kn; gh_son += (gh_sont - gh_son) * c_sw; gh_sth += (gh_stht - gh_sth) * c_kn;
gh_sd += (gh_sdt - gh_sd) * c_kn; gh_mx += (gh_mxt - gh_mx) * c_kn; gh_mk += (gh_mkt - gh_mk) * c_kn;
gh_bon += (gh_bont - gh_bon) * c_sw; gh_ce += (gh_cet - gh_ce) * c_kn; gh_cv += (gh_cvt - gh_cv) * c_kn;
gh_bd += (gh_bdt - gh_bd) * c_kn; gh_lk += (gh_lkt - gh_lk) * c_lk; gh_ton += (gh_tont - gh_ton) * c_sw;
gh_un += (gh_unt - gh_un) * c_sw; gh_gs += (gh_gst - gh_gs) * c_sw;
bwL.cv = bwR.cv = gh_cv; bwL.bd = bwR.bd = gh_bd;
gh_sw = gh_son * gh_mx;
gh_kl = gh_db(gh_sth - gh_kw);
gh_ks = gh_db(gh_sth + gh_sd - gh_kw);
gh_xl = spl0 * gh_gin; gh_xr = spl1 * gh_gin;
abs(gh_xl) < 0.000000000000001 ? gh_xl = 0; abs(gh_xr) < 0.000000000000001 ? gh_xr = 0;
gh_il = max(gh_il, abs(gh_xl)); gh_ir = max(gh_ir, abs(gh_xr));
function gh_os(xl, xr) local(m, s, a, g, q, r, gl, gr) (
  m = 0.5 * (xl + xr); s = 0.5 * (xl - xr);
  a = abs(m); gh_sm += (a > gh_sm ? gh_ska : gh_skr) * (a - gh_sm);
  a = abs(s); gh_ss += (a > gh_ss ? gh_ska : gh_skr) * (a - gh_ss);
  g = gh_sm > gh_kl ? gh_sg(gh_sm, gh_sth) : 1; gh_gmm = min(gh_gmm, 1 + gh_son * (g - 1)); m *= 1 + gh_sw * (g - 1);
  g = gh_ss > gh_ks ? gh_sg(gh_ss, gh_sth + gh_sd) : 1; gh_gsm = min(gh_gsm, 1 + gh_son * (g - 1)); s *= 1 + gh_sw * (g - 1);
  xl = (m + s) * gh_mk; xr = (m - s) * gh_mk;
  a = abs(xl); gl = a > gh_ce ? gh_ce / a : 1;
  a = abs(xr); gr = a > gh_ce ? gh_ce / a : 1;
  q = min(gl, gr); gl += gh_lk * (q - gl); gr += gh_lk * (q - gr);
  g = bwL.lm_run(xl, gl); r = bwR.lm_run(xr, gr);
  g = 1 + gh_bon * (g - 1); r = 1 + gh_bon * (r - 1);
  gh_gbm = min(gh_gbm, min(g, r));
  gh_pl = bwL.xo * g; gh_pr = bwR.xo * r;
);
os_gate();
os_chg ? ( gh_clear(); os_hold += 2 * samplesblock; );
uxL.os_up(gh_xl); uxR.os_up(gh_xr);
os_f == 1 ? (
  gh_os(uxL.s0, uxR.s0); gh_yl = gh_pl; gh_yr = gh_pr;
) : (
  gh_os(uxL.s0, uxR.s0); gh_a0 = gh_pl; gh_b0 = gh_pr;
  gh_os(uxL.s1, uxR.s1); gh_a1 = gh_pl; gh_b1 = gh_pr;
  os_f == 2 ? ( gh_yl = dnL.os_dn(gh_a0, gh_a1, 0, 0); gh_yr = dnR.os_dn(gh_b0, gh_b1, 0, 0); ) : (
    gh_os(uxL.s2, uxR.s2); gh_a2 = gh_pl; gh_b2 = gh_pr;
    gh_os(uxL.s3, uxR.s3); gh_a3 = gh_pl; gh_b3 = gh_pr;
    gh_yl = dnL.os_dn(gh_a0, gh_a1, gh_a2, gh_a3); gh_yr = dnR.os_dn(gh_b0, gh_b1, gh_b2, gh_b3);
  );
);
gh_tl = tdL.tp_det(gh_yl); gh_tr = tdR.tp_det(gh_yr);
gh_c2 = gh_ce * 0.98;
gh_ql = gh_tl > gh_c2 ? gh_c2 / gh_tl : 1; gh_qr = gh_tr > gh_c2 ? gh_c2 / gh_tr : 1;
gh_q = min(gh_ql, gh_qr); gh_ql += gh_lk * (gh_q - gh_ql); gh_qr += gh_lk * (gh_q - gh_qr);
gh_ql = tpL.lm_run(tdL.c8, gh_ql); gh_qr = tpR.lm_run(tdR.c8, gh_qr);
gh_ql = 1 + gh_ton * (gh_ql - 1); gh_qr = 1 + gh_ton * (gh_qr - 1);
gh_gtm = min(gh_gtm, min(gh_ql, gh_qr));
gh_yl = tpL.xo * gh_ql; gh_yr = tpR.xo * gh_qr;
gh_u = 1 + gh_un * (1 / (gh_gin * gh_mk) - 1);
gh_yl *= gh_u; gh_yr *= gh_u;
gh_gs > 0.0001 ? (
  gh_a = (by_w - pdc_delay) & (BY_N - 1);
  gh_v = gh_gin * gh_mk * gh_u;
  gh_yl += gh_gs * (BY_BUF[gh_a] * gh_v - 2 * gh_yl);
  gh_yr += gh_gs * (BY_BUF[BY_N + gh_a] * gh_v - 2 * gh_yr);
);
gh_osg = os_g * os_g * (3 - 2 * os_g);
gh_yl *= gh_osg; gh_yr *= gh_osg;
gh_yl != gh_yl ? gh_yl = 0; gh_yr != gh_yr ? gh_yr = 0;
gh_fi < 1 ? (
  gh_fi = min(gh_fi + gh_fis, 1); gh_z = gh_fi * gh_fi * (3 - 2 * gh_fi);
  gh_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; gh_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  gh_yl = gh_a + gh_z * (gh_yl - gh_a); gh_yr = gh_b + gh_z * (gh_yr - gh_b);
);
ost_out(gh_yl, gh_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
gh_ol = max(gh_ol, abs(spl0)); gh_or = max(gh_or, abs(spl1));
gh_tpk = max(gh_tpk, max(toL.tp_det(spl0), toR.tp_det(spl1)));
lu_acc += luL.lu_run(spl0) + luR.lu_run(spl1);
(lu_i += 1) >= lu_n ? (
  lu_sum += lu_acc - LUB[lu_bi]; LUB[lu_bi] = lu_acc; lu_acc = 0; lu_i = 0;
  (lu_bi += 1) >= 30 ? ( lu_bi = 0; lu_full = 1; lu_sum = 0; gh_k = 0; loop(30, lu_sum += LUB[gh_k]; gh_k += 1; ); );
);

@gfx 1200 600
ui_begin(1200, 600);
GHP = 0x2C3139; GHPS = 0x353B44; GHPH = 0x1A1D23; GHPW = 0x20242B; GHI = 0xE2EAE7; GHT = 0xE8F6F1; GHA = 0x9FF0DA;
GHM = 0x8FE3CF;
GHI2 = ui_mix(GHI, GHPS, 0.38); GHT2 = ui_mix(GHT, GHPH, 0.40);
CGY = 0xC9CDD3; CLI = 0xC4B4E8; CMN = 0xA8DCC0; CBL = 0x9EC2E8; CCO = 0xF0A898; CCR = 0xEDE6CF; CPE = 0xF5C89A;

sc != gp_fsc ? (
  gp_fsc = sc;
  gp_f10 = ui_fitfont(10, 15 * sc);
  gp_f11 = ui_fitfont(11, 16 * sc);
  gp_f12 = ui_fitfont(12, 11.5 * sc);
  gp_f13 = ui_fitfont(13, 14 * sc);
  gp_f14 = ui_fitfont(14, 27 * sc);
  gp_f15 = ui_fitfont(15, 11.5 * sc);
  gp_f16 = ui_fitfont(16, 20 * sc);
);
gfx_setfont(10, "Trebuchet MS", gp_f10, 'b'); gfx_setfont(11, "Trebuchet MS", gp_f11, 'b');
gfx_setfont(12, "Trebuchet MS", gp_f12, 'b'); gfx_setfont(13, "Trebuchet MS", gp_f13, 'b');
gfx_setfont(14, "Trebuchet MS", gp_f14, 'b'); gfx_setfont(15, "Trebuchet MS", gp_f15, 'b');
gfx_setfont(16, "Trebuchet MS", gp_f16, 'b');

function gp_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function gp_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function gp_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function gp_rtxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function gp_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); gp_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
function gp_plate(x, y, w, h) (
  gp_shadow(x, y, w, h);
  ui_col(GHPW); gp_r(x, y, w, h);
  ui_col(GHPS); gp_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.07); gp_r(x + 1, y + 1, w - 2, 1); gp_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, 0.22); gp_r(x + 1, y + h - 3, w - 2, 2); gp_r(x + w - 3, y + 1, 2, h - 2);
  ui_col(GHPH); gp_r(x + 1, y + 1, w - 2, 32);
  ui_cola(GHM, 0.55); gp_r(x + 1, y + 33, w - 2, 1);
);
function gp_title(x, y, s) ( gfx_setfont(11); ui_col(GHT); gp_ltxt(x + 14, y + 17, s); );
function gp_split(x, y, h) ( ui_col(GHPW); gp_r(x, y + 34, 1, h - 35); ui_cola(0xFFFFFF, 0.06); gp_r(x + 1, y + 34, 1, h - 35); );

gp_lg = 0; gp_ctr = 0;
function gp_kn(v, lo, hi) ( gp_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function gp_kv(n, lo, hi) ( gp_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function gp_cap(cx, cy, r, a, act, cap, nd) local(i, t, x, y, rr, rd) (
  x = cx * sc; y = cy * sc; rr = r * sc; rd = rr + 8 * sc;
  ui_col(GHI2); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(x + sin(t) * rd, y - cos(t) * rd, (i == 0 || i == nd ? 1.9 : 1.5) * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.16); gfx_circle(x + (2 + i * 1.3) * sc, y + (3 + i * 1.6) * sc, rr + i * 0.6 * sc, 1, 1); i += 1; );
  ui_col(0x111317); gfx_circle(x, y, rr, 1, 1);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x2C3238);
    ui_ssline(x + sin(t) * rr * 0.80, y - cos(t) * rr * 0.80, x + sin(t) * rr * 0.95, y - cos(t) * rr * 0.95, 1.1 * sc, 0); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.28 : 0.16); ui_ssarc(x, y, rr - 0.6 * sc, -2.2, 0.6, 1 * sc);
  ui_col(ui_mix(cap, 0x000000, 0.5)); gfx_circle(x, y, rr * 0.76, 1, 1);
  ui_col(cap); gfx_circle(x, y, rr * 0.72, 1, 1);
  i = 0; loop(5, ui_cola(0x000000, 0.13 * (1 - i / 5)); gfx_circle(x, y, rr * 0.72 - i * 0.9 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.40 : 0.26); ui_ssarc(x, y, rr * 0.62, -1.7, -0.3, 1 * sc);
  ui_col(0x1A1D22); ui_kdot(x, y, a, rr * 0.72);
);
function gp_knob(cx, cy, r, idx, lo, hi, def, cap, nd) local(v, n, dx, dy, hov, did, act) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - gp_lt < 0.35 && gp_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; gp_lt = 0; ) : (
      drag_id = did; gp_y = mouse_y; gp_dz = 0; gp_lt = time_precise(); gp_lid = idx; gp_n = gp_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    gp_dz += abs(gp_y - mouse_y);
    gp_dz > 3 * sc ? (
      gp_n = min(max(gp_n + (gp_y - mouse_y) / (((mouse_cap & 8) ? 1000 : 200) * sc), 0), 1);
      v = gp_kv(gp_n, lo, hi);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    gp_y = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(gp_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
    slider(idx) = gp_kv(n, lo, hi);
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(gp_kn(v, lo, hi), 0), 1);
  act = hov || drag_id == did;
  gp_cap(cx, cy, r, -0.75 * $pi + n * 1.5 * $pi, act, cap, nd);
  gp_lg = 0;
  act;
);
function gp_name(cx, cy, r, act, name, val) ( gfx_setfont(10); ui_col(act ? GHA : GHI); gp_ctxt(cx, cy + r + 21, act ? val : name); );
function gp_ends(cx, cy, r, lo, hi) (
  gfx_setfont(12); ui_col(GHI2);
  gp_ctxt(cx - sin(0.75 * $pi) * (r + 20), cy + cos(0.75 * $pi) * -(r + 20), lo);
  gp_ctxt(cx + sin(0.75 * $pi) * (r + 20), cy + cos(0.75 * $pi) * -(r + 20), hi);
);
function gp_zero(cx, cy, r) ( gfx_setfont(12); ui_col(GHI2); gp_ctxt(cx, cy - r - 19, "0"); );
function gp_key(x, y, w, h, lbl, on, col) ( lk_well = 0x0A0B0C; lk_font = 13; lk_font2 = 13; lk_fit(x, y, w, h, on, col, lbl); );
function gp_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
function gp_rivet(x, y) ( ui_cola(0x000000, 0.4); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x6A737E); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xA9B2BC); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );
function gp_led(cx, cy, r, col, lit) local(x, y, rr) (
  x = cx * sc; y = cy * sc; rr = r * sc;
  lit ? ( ui_cola(col, 0.18); gfx_circle(x, y, rr * 2.1, 1, 1); ui_cola(col, 0.22); gfx_circle(x, y, rr * 1.55, 1, 1); );
  ui_col(0x050506); gfx_circle(x, y, rr + 2 * sc, 1, 1);
  ui_col(lit ? col : ui_mix(col, 0x101214, 0.78)); gfx_circle(x, y, rr, 1, 1);
  ui_cola(0xFFFFFF, lit ? 0.55 : 0.12); gfx_circle(x - rr * 0.32, y - rr * 0.34, rr * 0.34, 1, 1);
);
function gp_hit(x, y, w, h) ( pressed && drag_id == 0 && mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function gp_grey(x, y, w, h) ( ui_cola(GHPS, 0.5); gp_r(x, y, w, h); );
function gp_fall(v, p) ( p = p > 0.0000001 ? 20 * log10(p) : -90; p > v ? p : max(v - 0.6, -90); );
function gp_grrow(cx, y, g, n, pitch, list) local(i, k, k0, len, c, d, x) (
  len = strlen(list); k0 = 0; i = 0; k = 0;
  loop(len + 1,
    c = k < len ? str_getchar(list, k) : 124;
    c == 124 ? (
      strcpy_substr(#gp_gs, list, k0, k - k0); d = 0; match("%f", #gp_gs, d);
      x = cx + (i - (n - 1) / 2) * pitch;
      gfx_setfont(12); ui_col(GHI2); gp_ctxt(x, y - 15, #gp_gs);
      gp_led(x, y, 5.5, i < n * 0.45 ? 0x3CE05A : i < n * 0.75 ? 0xFFC81E : 0xFF3A2A, -g >= d - 0.1);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
function gp_well(x, y, w, h) ( ui_cola(0x000000, 0.18); gp_r(x, y, w, h); ui_cola(0x000000, 0.14); gp_r(x, y, w, 2); gp_r(x, y, 2, h); );
function gp_hold(v) instance(h) ( h += (v < h ? 1 : 0.25) * (v - h); h; );
function gp_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? 0xFF3A2A : zone == 1 ? 0xFFC81E : 0x3CE05A;
  lit ? ( ui_cola(c, 0.16); gp_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); gp_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); gp_r(x, y, w, 1.5); )
      : ( ui_col(ui_mix(c, 0x141619, 0.82)); gp_r(x, y, w, h); );
);
function gp_bar(x, y, w, h, v, pk) local(n, i, sw, d) (
  n = w > 200 ? 40 : 20; sw = w / n; i = 0;
  loop(n, d = -30 + (i + 1) / n * 30; gp_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d - 15 / n || (pk > -30 && abs(pk - d) < 15 / n), d > -1.6 ? 2 : d > -6.1 ? 1 : 0); i += 1; );
);
function gp_meter(x, y, w, h, ml, mr, pl, pr) local(bh, bw) (
  bh = w > 200 ? (h - 40) / 2 : 13; bw = w - 40;
  gp_shadow(x, y, w, h);
  ui_col(0x08090A); gp_r(x, y, w, h); ui_col(0x141619); gp_r(x + 1, y + 1, w - 2, h - 2);
  gp_bar(x + 28, y + (w > 200 ? 12 : 16), bw, bh, ml, pl); gp_bar(x + 28, y + (w > 200 ? 18 + bh : 38), bw, bh, mr, pr);
  gfx_setfont(12); ui_col(0xE8E3D6);
  w > 200 ? ( gp_ctxt(x + 15, y + 12 + bh / 2, "L"); gp_ctxt(x + 15, y + 18 + bh * 1.5, "R"); )
          : ( gp_ctxt(x + 15, y + 22.5, "L"); gp_ctxt(x + 15, y + 44.5, "R"); );
  gp_ctxt(x + 31, y + h - 13, "-30"); gp_ctxt(x + 28 + bw * 0.6, y + h - 13, "-12"); gp_ctxt(x + w - 14, y + h - 13, "0");
  w > 200 ? ( gp_ctxt(x + 28 + bw * 0.3, y + h - 13, "-21"); gp_ctxt(x + 28 + bw * 0.8, y + h - 13, "-6"); );
);
function gp_readout(x, y, w, h, lbl, s) (
  gfx_setfont(12); ui_col(GHI2); gp_ctxt(x + w / 2, y - 12, lbl);
  gp_shadow(x, y, w, h);
