!gp_mi ? ( gp_ml = gp_mr = gp_pl = gp_pr = gp_il = gp_ir = gp_ipl = gp_ipr = -90; gp_mi = 1; );
gp_il = gp_fall(gp_il, gh_il_d); gp_ir = gp_fall(gp_ir, gh_ir_d); gh_il_d = gh_ir_d = 0;
