desc:Butler Mini [mastering EQ] (GFX Lab)
//tags: equalizer equaliser eq parametric mastering mid side de-esser tilt air sub stereo mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-bypass, gfx-lab-v5-parts, gfx-lab-sliders (.jsfx-inc) in the same folder.

slider58:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:0<-15,15,0.1>-L/M LF gain (dB)
slider2:55<15,800,1>-L/M LF frequency (Hz)
slider3:0.3<0.3,4,0.01>-L/M LF Q (0.3 = shelf)
slider4:0<-15,15,0.1>-L/M LMF gain (dB)
slider5:220<15,800,1>-L/M LMF frequency (Hz)
slider6:1<0.4,4,0.01>-L/M LMF Q
slider7:0<-15,15,0.1>-L/M MF gain (dB)
slider8:1100<120,8000,1>-L/M MF frequency (Hz)
slider9:1<0.4,4,0.01>-L/M MF Q
slider10:0<-15,15,0.1>-L/M HMF gain (dB)
slider11:3300<400,26000,1>-L/M HMF frequency (Hz)
slider12:1<0.4,4,0.01>-L/M HMF Q
slider13:0<-15,15,0.1>-L/M HF gain (dB)
slider14:11000<400,26000,1>-L/M HF frequency (Hz)
slider15:0.3<0.3,4,0.01>-L/M HF Q (0.3 = shelf)
slider16:11<11,330,1>-L/M high-pass (Hz, 11 = off)
slider17:0<0,10,0.1>-L/M sub (dB)
slider18:0<-1.5,1.5,0.01>-L/M tilt (dB per octave)
slider19:0<0,10,0.1>-L/M air (dB)
slider20:22000<3300,22000,1>-L/M low-pass (Hz, 22000 = off)
slider21:0<-15,15,0.1>-L/M gain (dB)
slider22:1<0,1,1{Out,In}>-L/M EQ in
slider23:0<-15,15,0.1>-R/S LF gain (dB)
slider24:55<15,800,1>-R/S LF frequency (Hz)
slider25:0.3<0.3,4,0.01>-R/S LF Q (0.3 = shelf)
slider26:0<-15,15,0.1>-R/S LMF gain (dB)
slider27:220<15,800,1>-R/S LMF frequency (Hz)
slider28:1<0.4,4,0.01>-R/S LMF Q
slider29:0<-15,15,0.1>-R/S MF gain (dB)
slider30:1100<120,8000,1>-R/S MF frequency (Hz)
slider31:1<0.4,4,0.01>-R/S MF Q
slider32:0<-15,15,0.1>-R/S HMF gain (dB)
slider33:3300<400,26000,1>-R/S HMF frequency (Hz)
slider34:1<0.4,4,0.01>-R/S HMF Q
slider35:0<-15,15,0.1>-R/S HF gain (dB)
slider36:11000<400,26000,1>-R/S HF frequency (Hz)
slider37:0.3<0.3,4,0.01>-R/S HF Q (0.3 = shelf)
slider38:11<11,330,1>-R/S high-pass (Hz, 11 = off)
slider39:0<0,10,0.1>-R/S sub (dB)
slider40:0<-1.5,1.5,0.01>-R/S tilt (dB per octave)
slider41:0<0,10,0.1>-R/S air (dB)
slider42:22000<3300,22000,1>-R/S low-pass (Hz, 22000 = off)
slider43:0<-15,15,0.1>-R/S gain (dB)
slider44:1<0,1,1{Out,In}>-R/S EQ in
slider45:0<0,2,1{Off,L/M,R/S}>-Listen
slider46:0<0,1,1{Off,On}>-Auto gain
slider47:6600<2200,16000,1>-De-esser frequency (Hz)
slider48:0<0,100,1>-De-esser amount (%)
slider49:0<0,1,1{Bell,Shelf}>-De-esser type
slider50:1<0,1,1{Off,On}>-S-guard
slider51:0<0,1,1{Stereo,Mid/Side}>-Mode
slider52:1<0,1,1{Off,On}>-Link
slider53:100<0,200,1>-Gain scale (%)
slider54:0<0,1,1{Off,On}>-Bypass
slider55:1<0,1,1{Off,On}>-De-esser
slider56:0<0,1,1{Off,On}>-MF high Q
slider57:prs_sel=0<0,10,1{No preset,Init,Gentle Polish,Warm Master,Air and Space,Mud Clean,Vocal Forward,Loud Pop,M/S Wide Top,Bright Tilt,Dark Tilt}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-sliders.jsfx-inc

@init
function psw_all(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
function psw_allg(v) ( slider_show(4503599627370495, v); slider_show(slider53, v); slider_show(slider54, v); slider_show(slider55, v); slider_show(slider56, v); slider_show(prs_sel, v); slider_show(psw_view, v); );
#ui_man = "gfx-lab-butler-mini";
ext_noinit = 1;

BT_CO = 100000; BT_T = 130000; BT_C = 140000; BG_T = 150000;
BT_AGF = 160000; BT_AGW = 160100;
BG_FB = 262144; BG_WIN = 330000; BG_SP = 340000; BG_SI = 341000; BG_CV = 342000;

function bt_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

function bt_mag(ty, g, q, x) local(a, x2, n, d, sa) (
  x2 = x * x;
  ty == 0 ? ( a = 10 ^ (g / 40); n = sqr(1 - x2) + sqr(x * a / q); d = sqr(1 - x2) + sqr(x / (a * q)); ) :
  ty == 1 ? ( a = 10 ^ (g / 40); sa = sqrt(a); n = a * a * (sqr(a - x2) + sqr(sa * x / q)); d = sqr(1 - a * x2) + sqr(sa * x / q); ) :
  ty == 2 ? ( a = 10 ^ (g / 40); sa = sqrt(a); n = a * a * (sqr(1 - a * x2) + sqr(sa * x / q)); d = sqr(a - x2) + sqr(sa * x / q); ) :
  ty == 3 ? ( n = x2 * x2; d = sqr(1 - x2) + sqr(x / q); ) : ( n = 1; d = sqr(1 - x2) + sqr(x / q); );
  n / max(d, 0.0000000000000000001);
);
function bt_tiltm(s, f) local(i, g, f1, r, p) (
  r = p = 1;
  abs(s) > 0.00001 ? (
    g = 10 ^ (s * 1.5 / 20); i = 0;
    loop(6, f1 = 40 * 2 ^ (1.5 * i) * sqrt(g);
      r *= (g * g * f * f + f1 * f1) / (f * f + f1 * f1); p *= (g * g * 435600 + f1 * f1) / (435600 + f1 * f1); i += 1; );
  );
  r / p;
);
function bt_p1(ty, fc, f) local(a1, x, hn, b0, b1, w, c, sn, nr, ni, dr, di, dd) (
  a1 = -exp(-2 * $pi * fc / srate); x = 0.5 * srate / fc;
  ty == 4 ? ( hn = 1 / sqrt(1 + x * x); b0 = 0.5 * ((1 + a1) + hn * (1 - a1)); b1 = 0.5 * ((1 + a1) - hn * (1 - a1)); ) :
            ( hn = x / sqrt(1 + x * x); b0 = 0.5 * hn * (1 - a1); b1 = -b0; );
  w = 2 * $pi * min(f, 0.4999 * srate) / srate; c = cos(w); sn = sin(w);
  nr = b0 + b1 * c; ni = -b1 * sn; dr = 1 + a1 * c; di = -a1 * sn; dd = dr * dr + di * di;
  bt_pre = (nr * dr + ni * di) / dd; bt_pim = (ni * dr - nr * di) / dd;
);
function bt_resp(t, f) local(b, p, x, k, re, im, d) (
  p = 1;
  t[28] >= 0.5 ? (
    b = 0;
    loop(5,
      abs(t[b * 4]) > 0.00001 ? (
        x = f / t[b * 4 + 1];
        p *= t[b * 4 + 3] >= 0.5 ? bt_mag(b == 0 ? 1 : 2, t[b * 4], 0.9, x) : bt_mag(0, t[b * 4], t[b * 4 + 2], x);
      );
      b += 1;
    );
    t[21] >= 0.5 ? p *= bt_mag(3, 0, 0.7071, f / t[20]);
    t[23] >= 0.5 ? p *= bt_mag(4, 0, 0.7071, f / t[22]);
    p *= bt_tiltm(t[25], f);
    re = 1; im = 0;
    k = 10 ^ (t[24] / 20) - 1; bt_p1(4, 33, f); re += k * bt_pre; im += k * bt_pim;
    k = 10 ^ (t[26] / 20) - 1; bt_p1(3, 22000, f); re += k * bt_pre; im += k * bt_pim;
    p *= re * re + im * im;
  );
  p;
);
function bt_tgt(c, t) local(o, b, gs, q, lo, hi) (
  o = c * 22; gs = min(max(slider53, 0), 200) / 100; b = 0;
  loop(5,
    lo = b < 2 ? 15 : b == 2 ? 120 : 400; hi = b < 2 ? 800 : b == 2 ? 8000 : 26000;
    t[b * 4] = min(max(slider(1 + o + 3 * b), -15), 15) * gs;
    t[b * 4 + 1] = min(max(slider(2 + o + 3 * b), lo), hi);
    q = slider(3 + o + 3 * b);
    b == 2 && slider56 >= 0.5 ? q = 3;
    t[b * 4 + 3] = (b == 0 || b == 4) && q < 0.35;
    t[b * 4 + 2] = min(max(q, 0.4), 4);
    b += 1;
  );
  t[20] = min(max(slider(16 + o), 11), 330); t[21] = slider(16 + o) > 11.5;
  t[22] = min(max(slider(20 + o), 3300), 22000); t[23] = slider(20 + o) < 21900;
  t[24] = min(max(slider(17 + o), 0), 10) * gs; t[25] = min(max(slider(18 + o), -1.5), 1.5) * gs;
  t[26] = min(max(slider(19 + o), 0), 10) * gs;
  t[27] = 10 ^ (min(max(slider(21 + o), -15), 15) / 20); t[28] = slider(22 + o) >= 0.5;
);

function bt_mzp(wp, z) local(r, q) (
  wp = min(wp, 0.99 * $pi);
  r = exp(-z * wp);
  z <= 1 ? bt_a1 = -2 * r * cos(sqrt(1 - z * z) * wp) : ( q = sqrt(z * z - 1) * wp; bt_a1 = -r * (exp(q) + exp(-q)); );
  bt_a2 = exp(-2 * z * wp);
);
function bt_fit(p, h0, hp, wm, hm) local(a0, a1s, a2s, f0, f1, f2, bb0, bb1, bb2, s0, s1, w, d) (
  a0 = sqr(1 + bt_a1 + bt_a2); a1s = sqr(1 - bt_a1 + bt_a2); a2s = -4 * bt_a2;
  f1 = sqr(sin(wm * 0.5)); f0 = 1 - f1; f2 = 4 * f0 * f1;
  bb0 = h0 * a0; bb1 = hp * a1s;
  bb2 = (hm * (a0 * f0 + a1s * f1 + a2s * f2) - bb0 * f0 - bb1 * f1) / f2;
  s0 = sqrt(bb0); s1 = sqrt(bb1); w = 0.5 * (s0 + s1);
  d = sqrt(max(w * w + bb2, 0));
  p[0] = 0.5 * (w + d); p[2] = w - p[0]; p[1] = 0.5 * (s0 - s1);
  p[3] = bt_a1; p[4] = bt_a2;
);
function bt_fitls(p, ty, g, q, w0) local(a0, a1s, a2s, i, w, f0, f1, f2, t, r0, r1, r2, m00, m01, m02, m11, m12, m22, v0, v1, v2, c0, c1, c2, de, bb0, bb1, bb2, s0, s1, ww, d, l0, l1) (
  a0 = sqr(1 + bt_a1 + bt_a2); a1s = sqr(1 - bt_a1 + bt_a2); a2s = -4 * bt_a2;
  m00 = m01 = m02 = m11 = m12 = m22 = v0 = v1 = v2 = 0;
  c0 = c1 = c2 = 0.0000000000000000001;
  l0 = log(2 * $pi * 20 / srate); l1 = log(0.92 * $pi);
  loop(2,
    i = 0;
    loop(16,
      w = exp(l0 + (l1 - l0) * i / 15);
      f1 = sqr(sin(w * 0.5)); f0 = 1 - f1; f2 = 4 * f0 * f1;
      t = bt_mag(ty, g, q, w / w0) * (a0 * f0 + a1s * f1 + a2s * f2);
      r0 = f0 / t; r1 = f1 / t; r2 = f2 / t;
      bt_lp ? (
        r0 /= c0; r1 /= c1; r2 /= c2;
        m00 += r0 * r0; m01 += r0 * r1; m02 += r0 * r2; m11 += r1 * r1; m12 += r1 * r2; m22 += r2 * r2;
        v0 += r0; v1 += r1; v2 += r2;
      ) : ( c0 = max(c0, abs(r0)); c1 = max(c1, abs(r1)); c2 = max(c2, abs(r2)); );
      i += 1;
    );
    bt_lp = !bt_lp;
  );
  bt_lp = 0;
  de = m00 * (m11 * m22 - m12 * m12) - m01 * (m01 * m22 - m12 * m02) + m02 * (m01 * m12 - m11 * m02);
  bb0 = (v0 * (m11 * m22 - m12 * m12) - m01 * (v1 * m22 - m12 * v2) + m02 * (v1 * m12 - m11 * v2)) / de / c0;
  bb1 = (m00 * (v1 * m22 - m12 * v2) - v0 * (m01 * m22 - m12 * m02) + m02 * (m01 * v2 - v1 * m02)) / de / c1;
  bb2 = (m00 * (m11 * v2 - v1 * m12) - m01 * (m01 * v2 - v1 * m02) + v0 * (m01 * m12 - m11 * m02)) / de / c2;
  s0 = sqrt(max(bb0, 0)); s1 = sqrt(max(bb1, 0)); ww = 0.5 * (s0 + s1);
  d = sqrt(max(ww * ww + bb2, 0));
  p[0] = 0.5 * (ww + d); p[2] = ww - p[0]; p[1] = 0.5 * (s0 - s1);
  p[3] = bt_a1; p[4] = bt_a2;
);
function bt_dz(p, ty, f0, g, q) local(w0, a, wp, z, wm) (
  w0 = 2 * $pi * f0 / srate; a = 10 ^ (g / 40);
  ty == 0 ? ( wp = w0; z = 0.5 / (a * q); ) : ty == 1 ? ( wp = w0 / sqrt(a); z = 0.5 / q; ) :
  ty == 2 ? ( wp = w0 * sqrt(a); z = 0.5 / q; ) : ( wp = w0; z = 0.5 / q; );
  bt_mzp(wp, z);
  w0 < 0.3 ? (
    wm = min(w0, 0.8 * $pi);
    bt_fit(p, bt_mag(ty, g, q, 0), bt_mag(ty, g, q, 0.5 * srate / f0), wm, bt_mag(ty, g, q, wm / w0));
  ) : bt_fitls(p, ty, g, q, w0);
);
function bt_dfo(p, ty, fc) local(a1, x, hn) (
  a1 = -exp(-2 * $pi * fc / srate); x = 0.5 * srate / fc;
  ty == 4 ? ( hn = 1 / sqrt(1 + x * x); p[0] = 0.5 * ((1 + a1) + hn * (1 - a1)); p[1] = 0.5 * ((1 + a1) - hn * (1 - a1)); ) :
            ( hn = x / sqrt(1 + x * x); p[0] = 0.5 * hn * (1 - a1); p[1] = -p[0]; );
  p[2] = 0; p[3] = a1; p[4] = 0;
);
function bt_bq(p, x) local(y) ( y = p[0] * x + p[5]; p[5] = p[1] * x - p[3] * y + p[6]; p[6] = p[2] * x - p[4] * y; y; );
function bt_bqz(p) ( p[5] = p[6] = 0; );
function bt_tdz(p, s) local(i, g, w1, a1, hn, om, nr) (
  g = 10 ^ (s * 1.5 / 20); i = 0; nr = 1; om = $pi * srate;
  loop(6,
    w1 = 2 * $pi * 40 * 2 ^ (1.5 * i) * sqrt(g);
    a1 = -exp(-w1 / srate);
    hn = sqrt((g * g * om * om + w1 * w1) / (om * om + w1 * w1));
    p[i * 4] = 0.5 * ((1 + a1) + hn * (1 - a1)); p[i * 4 + 1] = 0.5 * ((1 + a1) - hn * (1 - a1)); p[i * 4 + 2] = a1;
    nr *= (g * g * 17198707.6 + w1 * w1) / (17198707.6 + w1 * w1);
    i += 1;
  );
  1 / sqrt(nr);
);

function bt_tick(c) local(t, u, p, b, d, mv, f, q, a) (
  t = BT_T + c * 100; u = BT_C + c * 100; p = BT_CO + c * 200;
  b = 0;
  loop(5,
    mv = bt_force;
    d = t[b * 4] - u[b * 4]; abs(d) > 0.002 ? ( u[b * 4] += d * bt_kg; mv = 1; ) : d != 0 ? ( u[b * 4] = t[b * 4]; mv = 1; );
    d = log(t[b * 4 + 1] / u[b * 4 + 1]); abs(d) > 0.0005 ? ( u[b * 4 + 1] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[b * 4 + 1] = t[b * 4 + 1]; mv = 1; );
    d = log(t[b * 4 + 2] / u[b * 4 + 2]); abs(d) > 0.0005 ? ( u[b * 4 + 2] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[b * 4 + 2] = t[b * 4 + 2]; mv = 1; );
    (b == 0 || b == 4) ? (
      a = u[b * 4 + 3];
      u[b * 4 + 3] = t[b * 4 + 3] >= 0.5 ? min(a + bt_ks, 1) : max(a - bt_ks, 0);
      a != u[b * 4 + 3] ? ( u[b * 4 + 3] == 0 ? bt_bqz(p + (b == 0 ? 40 : 48)); u[b * 4 + 3] == 1 ? bt_bqz(p + b * 8); );
    );
    u[40 + b] = abs(u[b * 4]) > 0.00001 || abs(t[b * 4]) > 0.00001;
    !u[40 + b] ? ( bt_bqz(p + b * 8); b == 0 ? bt_bqz(p + 40); b == 4 ? bt_bqz(p + 48); ) : mv ? (
      f = u[b * 4 + 1]; q = u[b * 4 + 2];
      bt_dz(p + b * 8, 0, f, u[b * 4], q);
      b == 0 ? bt_dz(p + 40, 1, f, u[b * 4], 0.9);
      b == 4 ? bt_dz(p + 48, 2, f, u[b * 4], 0.9);
    );
    b += 1;
  );
  mv = bt_force; d = log(t[20] / u[20]); abs(d) > 0.0005 ? ( u[20] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[20] = t[20]; mv = 1; );
  mv ? bt_dz(p + 56, 3, u[20], 0, 0.7071);
  a = u[21]; u[21] = t[21] >= 0.5 ? min(a + bt_ks, 1) : max(a - bt_ks, 0); u[21] == 0 && a != 0 ? bt_bqz(p + 56);
  mv = bt_force; d = log(t[22] / u[22]); abs(d) > 0.0005 ? ( u[22] *= exp(d * bt_kg); mv = 1; ) : d != 0 ? ( u[22] = t[22]; mv = 1; );
  mv ? bt_dz(p + 64, 4, u[22], 0, 0.7071);
  a = u[23]; u[23] = t[23] >= 0.5 ? min(a + bt_ks, 1) : max(a - bt_ks, 0); u[23] == 0 && a != 0 ? bt_bqz(p + 64);
  d = t[24] - u[24]; abs(d) > 0.002 ? u[24] += d * bt_kg : u[24] = t[24];
  d = t[26] - u[26]; abs(d) > 0.002 ? u[26] += d * bt_kg : u[26] = t[26];
  u[46] = 10 ^ (u[24] / 20) - 1; u[47] = 10 ^ (u[26] / 20) - 1;
  u[46] == 0 ? bt_bqz(p + 72); u[47] == 0 ? bt_bqz(p + 80);
  mv = bt_force; d = t[25] - u[25]; abs(d) > 0.0005 ? ( u[25] += d * bt_kg; mv = 1; ) : d != 0 ? ( u[25] = t[25]; mv = 1; );
  u[25] == 0 ? ( u[45] = 1; p[91] = p[95] = p[99] = p[103] = p[107] = p[111] = 0; ) : mv ? u[45] = bt_tdz(p + 88, u[25]);
);
function bt_chan(x, c, ga) local(u, p, y, ya, ys, m, q) (
  u = BT_C + c * 100; p = BT_CO + c * 200; y = x;
  u[40] ? ( m = u[3]; ya = m < 1 ? bt_bq(p, y) : 0; ys = m > 0 ? bt_bq(p + 40, y) : 0; y = ya + m * (ys - ya); );
  u[41] ? y = bt_bq(p + 8, y);
  u[42] ? y = bt_bq(p + 16, y);
  u[43] ? y = bt_bq(p + 24, y);
  u[44] ? ( m = u[19]; ya = m < 1 ? bt_bq(p + 32, y) : 0; ys = m > 0 ? bt_bq(p + 48, y) : 0; y = ya + m * (ys - ya); );
  u[25] != 0 ? (
    q = p + 88;
    loop(6, ys = q[0] * y + q[3]; q[3] = q[1] * y - q[2] * ys; y = ys; q += 4; );
    y *= u[45];
  );
  ya = y;
  u[46] > 0 ? y += u[46] * bt_bq(p + 72, ya);
  u[47] > 0 ? y += u[47] * ga * bt_bq(p + 80, ya);
  u[21] > 0 ? y += u[21] * (bt_bq(p + 56, y) - y);
  u[23] > 0 ? y += u[23] * (bt_bq(p + 64, y) - y);
  u[50] += (u[27] - u[50]) * bt_kp;
  u[51] += (u[28] - u[51]) * bt_kp;
  x + u[51] * (y * u[50] - x);
);
function bt_clear() local(c, p, i) (
  c = 0;
  loop(2, p = BT_CO + c * 200; i = 0; loop(11, bt_bqz(p + i * 8); i += 1; );
    i = 0; loop(6, p[88 + i * 4 + 3] = 0; i += 1; ); c += 1; );
  dsA.c1 = dsA.c2 = dsA.l1 = dsB.c1 = dsB.c2 = dsB.l1 = 0; bt_es = bt_ef = 0; bt_dsg = 0;
);
function bt_denorm() local(c, p, i) (
  c = 0;
  loop(2, p = BT_CO + c * 200; i = 0;
    loop(11, p[i * 8 + 5] = bt_tn(p[i * 8 + 5]); p[i * 8 + 6] = bt_tn(p[i * 8 + 6]); i += 1; );
    i = 0; loop(6, p[88 + i * 4 + 3] = bt_tn(p[88 + i * 4 + 3]); i += 1; ); c += 1; );
  dsA.c1 = bt_tn(dsA.c1); dsA.c2 = bt_tn(dsA.c2); dsB.c1 = bt_tn(dsB.c1); dsB.c2 = bt_tn(dsB.c2); dsA.l1 = bt_tn(dsA.l1); dsB.l1 = bt_tn(dsB.l1);
);

function ds_run(v0) instance(c1, c2, l1) local(v1, v2, v3) (
  v3 = v0 - c2; v1 = bt_d1 * c1 + bt_d2 * v3; v2 = c2 + bt_d2 * c1 + bt_d3 * v3;
  c1 = 2 * v1 - c1; c2 = 2 * v2 - c2;
  l1 += bt_dl * (v0 - l1);
  (1 - bt_dsh) * bt_dk * v1 + bt_dsh * (v0 - l1);
);
function ds_set() local(g) (
  g = tan($pi * min(bt_df, 0.45 * srate) / srate);
  bt_dk = 1 / 1.4;
  bt_d1 = 1 / (1 + g * (g + bt_dk)); bt_d2 = g * bt_d1; bt_d3 = g * bt_d2;
  bt_dl = 1 - exp(-2 * $pi * bt_df / srate);
);

function bt_agcalc() local(i, f, w, sw, pa, pb) (
  sw = pa = pb = 0; i = 0;
  loop(48, f = BT_AGF[i]; w = BT_AGW[i];
    pa += w * bt_resp(BT_T, f); pb += w * bt_resp(BT_T + 100, f); sw += w; i += 1; );
  bt_agt = sqrt(2 * sw / max(pa + pb, 0.0000001));
  bt_agt = min(max(bt_agt, 0.0316), 31.6);
);

#bt_pm = "Init|Gentle Polish|Warm Master|Air and Space|Mud Clean|Vocal Forward|Loud Pop|M/S Wide Top|Bright Tilt|Dark Tilt";
function bt_flat(c) local(o) (
  o = c * 22;
  slider(1 + o) = 0; slider(2 + o) = 55; slider(3 + o) = 0.3;
  slider(4 + o) = 0; slider(5 + o) = 220; slider(6 + o) = 1;
  slider(7 + o) = 0; slider(8 + o) = 1100; slider(9 + o) = 1;
  slider(10 + o) = 0; slider(11 + o) = 3300; slider(12 + o) = 1;
  slider(13 + o) = 0; slider(14 + o) = 11000; slider(15 + o) = 0.3;
  slider(16 + o) = 11; slider(17 + o) = 0; slider(18 + o) = 0; slider(19 + o) = 0; slider(20 + o) = 22000;
  slider(21 + o) = 0; slider(22 + o) = 1;
);
function bt_pb(c, b, g, f, q) ( slider(1 + c * 22 + 3 * b) = g; slider(2 + c * 22 + 3 * b) = f; slider(3 + c * 22 + 3 * b) = q; );
function bt_pv(c, k, v) ( slider(k + c * 22) = v; );
function bt_both() local(i) ( i = 1; loop(21, slider(i + 22) = slider(i); i += 1; ); );
function load_preset(p) local(i) (
  bt_flat(0); bt_flat(1);
  slider45 = 0; slider46 = 0; slider47 = 6600; slider48 = 0; slider49 = 0; slider50 = 1; slider51 = 0; slider52 = 1; slider53 = 100;
  p == 2 ? ( bt_pb(0, 0, 0.8, 55, 0.3); bt_pb(0, 2, -0.6, 1100, 0.7); bt_pb(0, 4, 1.2, 11000, 0.3); bt_pv(0, 19, 1.5); bt_both(); ) :
  p == 3 ? ( bt_pb(0, 0, 1.2, 88, 0.3); bt_pb(0, 1, -0.8, 330, 1.2); bt_pb(0, 4, -0.5, 11000, 0.3); bt_pv(0, 18, -0.2); bt_both(); ) :
  p == 4 ? ( bt_pb(0, 3, -0.5, 3300, 1.5); bt_pb(0, 4, 1.5, 9900, 0.3); bt_pv(0, 19, 2.5); bt_both(); slider48 = 30; ) :
  p == 5 ? ( bt_pb(0, 1, -1.5, 220, 1.4); bt_pb(0, 2, -0.8, 550, 1); bt_pv(0, 16, 22); bt_both(); ) :
  p == 6 ? ( bt_pb(0, 2, 1, 2200, 0.8); bt_pb(0, 3, 0.6, 4400, 1); bt_both(); slider48 = 40; ) :
  p == 7 ? ( bt_pb(0, 0, 1.5, 66, 0.3); bt_pb(0, 1, -0.7, 220, 1); bt_pb(0, 3, 0.7, 3300, 0.8); bt_pb(0, 4, 1.5, 11000, 0.3);
             bt_pv(0, 17, 2); bt_pv(0, 19, 2); bt_both(); slider48 = 50; ) :
  p == 8 ? ( slider51 = 1; slider52 = 0; bt_pb(0, 2, 0.5, 1100, 0.7);
             bt_pv(1, 16, 110); bt_pb(1, 4, 2, 11000, 0.3); bt_pv(1, 19, 1.5); ) :
  p == 9 ? ( bt_pv(0, 18, 0.3); bt_pv(0, 19, 1); bt_both(); ) :
  p == 10 ? ( bt_pv(0, 18, -0.3); bt_pv(0, 17, 1); bt_both(); );
  slider55 = 1; slider56 = 0;
  i = 1; loop(56, ui_auto(i); i += 1; );
);

function bt_srinit() local(i, f, r) (
  bt_sr = srate;
  bt_kg = 1 - exp(-8 / (0.03 * srate));
  bt_ks = 8 / (0.015 * srate);
  bt_kp = 1 - exp(-1 / (0.02 * srate));
  bt_kl = 1 - exp(-1 / (0.015 * srate));
  bt_kag = 1 - exp(-1 / (0.05 * srate));
  bt_kda = 1 - exp(-1 / (0.0005 * srate)); bt_kdr = 1 - exp(-1 / (0.03 * srate));
  bt_kga = 1 - exp(-1 / (0.001 * srate)); bt_kgr = 1 - exp(-1 / (0.06 * srate));
  bt_krm = 1 - exp(-1 / (0.3 * srate));
  bt_dks = 1 / (0.005 * srate); bt_fis = 1 / (0.01 * srate);
  bt_dfo(BT_CO + 72, 4, 33); bt_dfo(BT_CO + 80, 3, 22000); bt_dfo(BT_CO + 272, 4, 33); bt_dfo(BT_CO + 280, 3, 22000);
  i = 0;
  loop(48, f = 20 * 1000 ^ (i / 47); BT_AGF[i] = f;
    r = 148693636 * f * f / ((f * f + 424.36) * (f * f + 148693636)) / 0.9929;
    BT_AGW[i] = r * r; i += 1; );
  ost_init(0);
  bt_clear(); bt_force = 1;
);
memset(BT_C, 0, 200);
bt_tgt(0, BT_T); bt_tgt(1, BT_T + 100);
memcpy(BT_C, BT_T, 29); memcpy(BT_C + 100, BT_T + 100, 29);
BT_C[50] = BT_T[27]; BT_C[51] = BT_T[28]; BT_C[150] = BT_T[127]; BT_C[151] = BT_T[128];
bt_srinit();
in_init();
bt_md = slider51 >= 0.5; bt_dk1 = 1; bt_fi = 1;
bt_wa = bt_wb = 0; bt_ag = 1; bt_agt = 1; bt_g = 1; bt_gm = slider50 >= 0.5;
bt_df = 6600; bt_dsh = 0; ds_set();
pdc_delay = 0;
by_setup(54);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(57, i != 57 ? h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k == 11 ? 1 : k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); );
    prs_cur_d = k == 11 ? 1 : k;
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same();  prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@block
prs_chk();
srate != bt_sr ? bt_srinit();
bt_now = time_precise();
bt_tp > 0 && bt_now - bt_tp > max(0.25, 4 * samplesblock / srate) && !(play_position > bt_gpp && play_position - bt_gpp < 4 * bt_gpd + 0.05) ? ( bt_clear(); bt_fi = 0; memset(BY_BUF, 0, 2 * BY_N); );
bt_tp = bt_now; bt_gpp = play_position; bt_gpd = samplesblock / srate;
ost_setup(0, 0.3, 120, 6000, -0.3, 0);
pdc_delay = 0; pdc_bot_ch = 0; pdc_top_ch = 2;
bt_tgt(0, BT_T); bt_tgt(1, BT_T + 100);
bt_sum = 0; bt_i = 0; loop(29, bt_sum += BT_T[bt_i] * (bt_i + 1.37) + BT_T[100 + bt_i] * (bt_i + 2.11); bt_i += 1; );
bt_sum != bt_sum0 ? ( bt_sum0 = bt_sum; bt_agcalc(); );
bt_agon = slider46 >= 0.5;
bt_mdt = slider51 >= 0.5;
bt_lsn = floor(min(max(slider45, 0), 2) + 0.5);
bt_dft = min(max(slider47, 2200), 16000); bt_dam = slider55 >= 0.5 ? min(max(slider48, 0), 100) / 100 : 0;
bt_dsht = slider49 >= 0.5; bt_gmt = slider50 >= 0.5;
bt_dthr = -4 - 14 * bt_dam; bt_dmax = 3 + 9 * bt_dam;
bt_denorm();
bt_ipl_d = max(bt_ipl_d, bt_ipl); bt_ipr_d = max(bt_ipr_d, bt_ipr); bt_opl_d = max(bt_opl_d, bt_opl); bt_opr_d = max(bt_opr_d, bt_opr);
bt_ipl = bt_ipr = bt_opl = bt_opr = 0;
bt_irl_d = bt_irl; bt_irr_d = bt_irr; bt_orl_d = bt_orl; bt_orr_d = bt_orr;
bt_dsg_d = min(bt_dsg_d, bt_dsm); bt_dsm = 0;
bt_ag_d = bt_agt;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
bt_xl = spl0; bt_xr = spl1;
bt_ipl = max(bt_ipl, abs(bt_xl)); bt_ipr = max(bt_ipr, abs(bt_xr));
bt_irl += bt_krm * (bt_xl * bt_xl - bt_irl); bt_irr += bt_krm * (bt_xr * bt_xr - bt_irr);
bt_mdt != bt_md ? ( bt_dk1 -= bt_dks; bt_dk1 <= 0 ? ( bt_dk1 = 0; bt_md = bt_mdt; bt_clear(); ); ) : bt_dk1 < 1 ? bt_dk1 = min(bt_dk1 + bt_dks, 1);
bt_a = bt_md ? 0.5 * (bt_xl + bt_xr) : bt_xl;
bt_b = bt_md ? 0.5 * (bt_xl - bt_xr) : bt_xr;
(bt_cn += 1) >= 8 ? (
  bt_cn = 0;
  bt_tick(0); bt_tick(1); bt_force = 0;
  bt_df += (bt_dft - bt_df) * bt_kg; bt_dsh += bt_dsht ? min(bt_ks, 1 - bt_dsh) : -min(bt_ks, bt_dsh);
  ds_set();
);
bt_gm += (bt_gmt - bt_gm) * bt_kl;
bt_guard = 1 - bt_gm * (1 - bt_g);
bt_ya = bt_chan(bt_a, 0, bt_guard);
bt_yb = bt_chan(bt_b, 1, bt_guard);
bt_dam > 0 || bt_dsg < -0.001 ? (
  bt_sa = dsA.ds_run(bt_ya); bt_sb = dsB.ds_run(bt_yb);
  bt_v = bt_sa * bt_sa + bt_sb * bt_sb; bt_es += (bt_v > bt_es ? bt_kda : bt_kdr) * (bt_v - bt_es);
  bt_v = bt_ya * bt_ya + bt_yb * bt_yb; bt_ef += (bt_v > bt_ef ? bt_kda : bt_kdr) * (bt_v - bt_ef);
  bt_dt = 0;
  bt_dam > 0 && bt_es > 0.000001 ? ( bt_r = 10 * log10(bt_es / max(bt_ef, 0.0000000001)) - bt_dthr; bt_r > 0 ? bt_dt = -min(bt_r * (1 + bt_dam), bt_dmax); );
  bt_dsg += (bt_dt < bt_dsg ? bt_kga : bt_kgr) * (bt_dt - bt_dsg);
  bt_dsg > -0.0001 && bt_dt == 0 ? bt_dsg = 0;
  bt_g = 10 ^ (bt_dsg / 20);
  bt_ya -= (1 - bt_g) * bt_sa; bt_yb -= (1 - bt_g) * bt_sb;
  bt_dsm = min(bt_dsm, bt_dsg);
) : ( bt_g = 1; dsA.c1 = dsA.c2 = dsA.l1 = dsB.c1 = dsB.c2 = dsB.l1 = 0; bt_es = bt_ef = 0; );
bt_ol = bt_md ? bt_ya + bt_yb : bt_ya; bt_or = bt_md ? bt_ya - bt_yb : bt_yb;
bt_wa += ((bt_lsn == 1) - bt_wa) * bt_kl; bt_wb += ((bt_lsn == 2) - bt_wb) * bt_kl;
bt_ol = (1 - bt_wa - bt_wb) * bt_ol + bt_wa * bt_ya + bt_wb * bt_yb;
bt_or = (1 - bt_wa - bt_wb) * bt_or + bt_wa * bt_ya + bt_wb * bt_yb;
bt_ag += ((bt_agon ? bt_agt : 1) - bt_ag) * bt_kag;
bt_z = bt_dk1 * bt_dk1 * (3 - 2 * bt_dk1) * bt_ag;
bt_ol *= bt_z; bt_or *= bt_z;
bt_ol != bt_ol ? bt_ol = 0; bt_or != bt_or ? bt_or = 0;
bt_fi < 1 ? (
  bt_fi = min(bt_fi + bt_fis, 1); bt_z = bt_fi * bt_fi * (3 - 2 * bt_fi);
  bt_ol = bt_xl + bt_z * (bt_ol - bt_xl); bt_or = bt_xr + bt_z * (bt_or - bt_xr);
);
ost_out(bt_ol, bt_or);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
bt_opl = max(bt_opl, abs(spl0)); bt_opr = max(bt_opr, abs(spl1));
bt_orl += bt_krm * (spl0 * spl0 - bt_orl); bt_orr += bt_krm * (spl1 * spl1 - bt_orr);

@gfx 900 400
ui_begin(900, 400);
v5_begin();
BPF = 0xEEEFEA; BPI = 0x1A1A1C; BPI2 = ui_mix(BPI, BPF, 0.4); BPB = 0x2A2620; BPA = 0xFFC060;
BPW1 = ui_mix(BPF, 0, 0.55); BPW2 = ui_mix(BPF, 0, 0.72); BPL = 0xE8E0CB; BPLI = 0xE8E6E0;
sc != bp_fsc ? (
  bp_fsc = sc;
  bp_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  bp_ka = ui_fitarial(7, 16 * sc) / (16 * sc);
  bp_f6 = ui_fitfont(6, 25 * sc);
);
function bp_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * bp_kt * sc, 'b'); );
function bp_fa(px) ( gfx_setfont(7, "Arial", px * bp_ka * sc, 'b'); );
function bp_fc(px) ( gfx_setfont(12, "Courier New", px * bp_kt * sc, 'b'); );
function bp_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function bp_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function bp_fstr(f) (
  f < 999.5 ? sprintf(#bp_fs, "%d Hz", floor(f + 0.5)) :
  f < 9995 ? sprintf(#bp_fs, "%.2f kHz", f / 1000) : sprintf(#bp_fs, "%.1f kHz", f / 1000);
  #bp_fs;
);
function bp_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  gfx_gradrect(x * sc, y * sc, w * sc, h * sc, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (h * sc), (g2 - g1) / (h * sc), (b2 - b1) / (h * sc), 0);
);
function bp_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x8A9198); v5_d(x, y, 4); ui_col(0xB8BEC4); v5_d(x - 0.8, y - 0.8, 2.4); );
function bp_cham(x, y, w, h, d, f) (
  ui_cola(0xFFFFFF, 0.16); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.5)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.08)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.18)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(ui_mix(f, 0, 0.10 + d * 0.012)); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function bp_dwell(x, y, w, h) (
  ui_col(BPW1); v5_r(x, y, w, h);
  ui_col(BPW2); v5_r(x + 2, y + 2, w - 3, h - 3);
  ui_cola(0, 0.35); v5_r(x + 2, y + 2, w - 3, 2); v5_r(x + 2, y + 4, 2, h - 5);
  ui_cola(0xFFFFFF, 0.22); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
);
function bp_hover(cx, cy, fs) ( bp_hon = 1; bp_hx = cx; bp_hy = cy; bp_hfs = fs; );
function bp_val(idx, kind) local(v) (
  v = slider(idx);
  kind == 0 ? sprintf(#bp_hv, "%+.1f dB", v) :
  kind == 1 ? strcpy(#bp_hv, bp_fstr(v)) :
  kind == 2 ? ( v < 0.35 ? strcpy(#bp_hv, "SHELF") : sprintf(#bp_hv, "Q %.2f", v); ) :
  kind == 3 ? ( v <= 11.5 ? strcpy(#bp_hv, "OFF") : strcpy(#bp_hv, bp_fstr(v)); ) :
  kind == 4 ? ( v >= 21900 ? strcpy(#bp_hv, "OFF") : strcpy(#bp_hv, bp_fstr(v)); ) :
  kind == 5 ? sprintf(#bp_hv, "%+.2f dB/oct", v) :
  kind == 6 ? sprintf(#bp_hv, "%d %%", floor(v + 0.5)) :
  sprintf(#bp_hv, "+%.1f dB", v);
);
function bp_twin(idx, old) local(m) (
  slider52 >= 0.5 && idx <= 43 && idx != 22 && slider(idx) != old ? ( m = idx <= 22 ? idx + 22 : idx - 22; slider(m) = slider(idx); ui_auto(m); );
);
function bp_kdots(cx, cy, rd, ends, c) local(i, t) (
  i = 0; loop(5, t = -0.75 * $pi + i / 4 * 1.5 * $pi;
    !ends || i == 0 || i == 4 ? ( ui_col(c); v5_d(cx + sin(t) * rd, cy - cos(t) * rd, i == 0 || i == 4 ? 1.9 : 1.5); );
    i += 1; );
);
function bp_pastel(cx, cy, r, v, cap) local(a, i, t) (
  a = -0.75 * $pi + v * 1.5 * $pi;
  v5_shc(cx, cy, r);
  ui_col(0x15181B); v5_d(cx, cy, r);
  i = 0; loop(24, t = i / 24 * 2 * $pi; ui_col(0x30363C); v5_ln(cx + sin(t) * r * 0.8, cy - cos(t) * r * 0.8, cx + sin(t) * r * 0.95, cy - cos(t) * r * 0.95, 1.1); i += 1; );
  ui_col(ui_mix(cap, 0, 0.5)); v5_d(cx, cy, r * 0.76);
  ui_col(cap); v5_d(cx, cy, r * 0.72);
  i = 0; loop(5, ui_cola(0, 0.13 * (1 - i / 5)); gfx_circle(cx * sc, cy * sc, (r * 0.72 - i * 0.9) * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, 0.26); v5_arc(cx, cy, r * 0.62, -1.7, -0.3, 1.1);
  v5_pdot(cx, cy, a, r * 0.72, 0x1A1D22);
);
function bp_knob(cx, cy, r, idx, lo, hi, def, lg, cap, lbl, kind, ends, fs, ly) local(n, old) (
  old = slider(idx);
  n = v5_ctl(idx, lo, hi, def, lg, v5_hitc(cx, cy, r + 8), 0, 200);
  bp_twin(idx, old);
  bp_kdots(cx, cy, r + 8, ends, BPI2);
  bp_pastel(cx, cy, r, n, cap);
  v5_act ? ( bp_val(idx, kind); bp_hover(cx, ly, fs); ) : ( bp_ft(fs); ui_col(BPI); v5_t(cx, ly, lbl); );
);
function bp_cream(cx, cy, r, idx, lbl) local(n, old, a, i, t) (
  old = slider(idx);
  n = v5_ctl(idx, -15, 15, 0, 0, v5_hitc(cx, cy, r + 9), 0, 200);
  bp_twin(idx, old);
  a = -0.75 * $pi + n * 1.5 * $pi;
  bp_kdots(cx, cy, r + 9, 1, BPI2);
  bp_fa(10); ui_col(BPI2); v5_t(cx, cy - r - 10, "0");
  v5_shc(cx, cy, r);
  ui_col(0x1B1D1E); v5_d(cx, cy, r);
  i = 0; loop(30, t = i / 30 * 2 * $pi; ui_col(0x34383A); v5_ln(cx + sin(t) * r * 0.84, cy - cos(t) * r * 0.84, cx + sin(t) * r * 0.97, cy - cos(t) * r * 0.97, 1); i += 1; );
  ui_col(0xBDB49E); v5_d(cx, cy, r * 0.74);
  ui_col(v5_cr); v5_d(cx, cy, r * 0.70);
  v5_vig(cx, cy, r * 0.70);
  ui_cola(0xFFFFFF, 0.55); v5_arc(cx, cy, r * 0.58, -1.9, -0.5, 1.2);
  v5_pdot(cx, cy, a, r * 0.70, 0x1E6B3C);
