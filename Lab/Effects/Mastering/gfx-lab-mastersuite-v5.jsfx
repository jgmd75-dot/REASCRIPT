desc:MasterSuite V5 [mastering strip] (GFX Lab)
//tags: mastering channel strip saturation eq mid-side compressor limiter clipper true peak
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider30:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:ms_trim=0<-12,12,0.1>-Input trim (dB)
slider2:ms_os=1<0,2,1{1x,2x,4x}>-Oversampling
slider3:ms_tin=1<0,1,1{Off,On}>-Tube stage
slider4:ms_tdrv=-3<-12,12,0.1>-Tube drive (dB)
slider5:ms_bias=1<0,2,1{Low,Mid,High}>-Tube bias
slider6:ms_ein=1<0,1,1{Off,On}>-Tone stage
slider7:ms_bass=0<-6,6,0.1>-Bass (dB, 90 Hz shelf)
slider8:ms_lmid=0<-6,6,0.1>-Low mid (dB, 350 Hz)
slider9:ms_hmid=0<-6,6,0.1>-High mid (dB, 2.8 kHz)
slider10:ms_pres=0<-6,6,0.1>-Presence (dB, 7 kHz shelf)
slider11:ms_tape=0<0,1,1{Off,On}>-Tape roll-off (18 kHz)
slider12:ms_sin=1<0,1,1{Off,On}>-Stereo stage
slider13:ms_mono=20<20,200,1>-Mono bass (Hz, 20 = off)
slider14:ms_wid=100<0,200,1>-Width (%)
slider15:ms_cin=0<0,1,1{Off,On}>-Compressor
slider16:ms_cthr=-18<-40,0,0.1>-Comp threshold (dB)
slider17:ms_crat=2<1,10,0.1>-Comp ratio
slider18:ms_cspd=1<0,2,1{Slow,Medium,Fast}>-Comp speed
slider19:ms_cmix=100<0,100,1>-Comp mix (%)
slider20:ms_hf=0<-30,0,0.1>-HF limit threshold (dB, 0 = off)
slider21:ms_clip=0<0,12,0.1>-Clip drive (dB, 0 = off)
slider22:ms_hard=0<0,1,1{Soft,Hard}>-Clip shape
slider23:ms_lin=1<0,1,1{Off,On}>-Limiter
slider24:ms_gain=0<-12,12,0.1>-Gain into the limiter (dB)
slider25:ms_ceil=-0.3<-1,-0.1,0.01>-Ceiling (dB)
slider26:ms_rel=80<10,500,1>-Limiter release (ms)
slider27:ms_link=1<0,1,1{Off,On}>-Link
slider28:ms_byp=0<0,1,1{Off,On}>-Bypass
slider29:prs_sel=0<0,11,1{No preset,Init,Transparent,Warm Glue,Loud & Punchy,Vintage Tape,Bright Pop,Bass Heavy,Acoustic,Podcast Voice,Parallel Punch,Streaming Safe}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
ext_gr_meter = 0;
function psw_all(v) ( slider_show(1073741823, v); );
function psw_allg(v) ( slider_show(1073741823, v); );
#ui_man = "gfx-lab-mastersuite-v5";
ext_noinit = 1;
gdc_r = 1 - 2 * $pi / srate;
gdc_x0 = gdc_y0 = 0; gdc_x1 = gdc_y1 = 0;

function db2g(d) ( 10 ^ (d / 20); );
function g2db(g) ( 20 * log10(max(g, 0.0000000001)); );
function ms_th(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );
function coef(ms) ( 1 - exp(-1 / (max(ms, 0.001) * 0.001 * srate)); );

function bq_set(type, f, q, gdb, fs) instance(b0, b1, b2, a1, a2) local(w, cw, sw, al, ag, sa, n) (
  f = min(max(f, 5), fs * 0.45);
  w = 2 * $pi * f / fs; cw = cos(w); sw = sin(w); ag = 10 ^ (gdb / 40);
  type <= 2 ? al = sw / (2 * q) : al = sw / 2 * sqrt((ag + 1 / ag) * (1 / q - 1) + 2);
  type == 0 ? ( n = 1 + al; b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 1 ? ( n = 1 + al; b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n; ) :
  type == 2 ? ( n = 1 + al / ag; b0 = (1 + al * ag) / n; b1 = -2 * cw / n; b2 = (1 - al * ag) / n; a1 = b1; a2 = (1 - al / ag) / n; ) :
  type == 3 ? (
    sa = 2 * sqrt(ag) * al; n = (ag + 1) - (ag - 1) * cw + sa;
    b0 = ag * ((ag + 1) + (ag - 1) * cw + sa) / n; b1 = -2 * ag * ((ag - 1) + (ag + 1) * cw) / n;
    b2 = ag * ((ag + 1) + (ag - 1) * cw - sa) / n; a1 = 2 * ((ag - 1) - (ag + 1) * cw) / n; a2 = ((ag + 1) - (ag - 1) * cw - sa) / n;
  ) : (
    sa = 2 * sqrt(ag) * al; n = (ag + 1) + (ag - 1) * cw + sa;
    b0 = ag * ((ag + 1) - (ag - 1) * cw + sa) / n; b1 = 2 * ag * ((ag - 1) - (ag + 1) * cw) / n;
    b2 = ag * ((ag + 1) - (ag - 1) * cw - sa) / n; a1 = -2 * ((ag - 1) + (ag + 1) * cw) / n; a2 = ((ag + 1) + (ag - 1) * cw - sa) / n;
  );
);
function bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
function bq_clr() instance(z1, z2) ( z1 = z2 = 0; );

function i0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= (x / (2 * k)) ^ 2; s += t; k += 1; ); s; );
function hb_taps(h, nk, beta) local(j, o, w, sum) (
  sum = 0; j = 0;
  loop(nk,
    o = 2 * j + 1;
    w = i0(beta * sqrt(max(1 - (o / (2 * nk)) ^ 2, 0))) / i0(beta);
    h[j] = 0.5 * sin($pi * o / 2) / ($pi * o / 2) * w;
    sum += h[j]; j += 1;
  );
  j = 0; loop(nk, h[j] *= 0.25 / sum; j += 1; );
);
function hb_init(nk, h, mem) instance(kk, hh, xb, eb, pos, L) (
  kk = nk; hh = h; L = 2 * nk + 1; xb = mem; eb = mem + 2 * L; pos = 0;
  memset(mem, 0, 4 * L);
);
function hb_up(x) instance(kk, hh, xb, pos, L, o) local(j, n, s) (
  xb[pos] = x; xb[pos + L] = x; pos += 1; pos >= L ? pos = 0;
  n = pos + L - 1; s = 0; j = 0;
  loop(kk, s += hh[j] * (xb[n - kk - j] + xb[n - kk + 1 + j]); j += 1; );
  o = 2 * s;
  xb[n - kk];
);
function hb_down(e, od) instance(kk, hh, xb, eb, pos, L) local(j, n, s) (
  xb[pos] = od; xb[pos + L] = od; eb[pos] = e; eb[pos + L] = e; pos += 1; pos >= L ? pos = 0;
  n = pos + L - 1; s = 0; j = 0;
  loop(kk, s += hh[j] * (xb[n - kk - j - 1] + xb[n - kk + j]); j += 1; );
  0.5 * eb[n - kk] + s;
);

function tube(x, k, b, tb) ( (ms_th(k * x + b) - tb) / (k * (1 - tb * tb)) * tmk; );

function tube_run(x) instance(u1, u2, d1, d2) local(e, o, a0, a1, a2, a3, de, dn) (
  os_n == 0 ? (
    x + (tube(x, tk, tb, ttb) - x) * tmix;
  ) : os_n == 1 ? (
    e = u1.hb_up(x); o = u1.o;
    e += (tube(e, tk, tb, ttb) - e) * tmix; o += (tube(o, tk, tb, ttb) - o) * tmix;
    d1.hb_down(e, o);
  ) : (
    e = u1.hb_up(x); o = u1.o;
    a0 = u2.hb_up(e); a1 = u2.o; a2 = u2.hb_up(o); a3 = u2.o;
    a0 += (tube(a0, tk, tb, ttb) - a0) * tmix; a1 += (tube(a1, tk, tb, ttb) - a1) * tmix;
    a2 += (tube(a2, tk, tb, ttb) - a2) * tmix; a3 += (tube(a3, tk, tb, ttb) - a3) * tmix;
    de = d2.hb_down(a0, a1); dn = d2.hb_down(a2, a3);
    d1.hb_down(de, dn);
  );
);

function knee_gr(lv, thr, ratio, knee) local(o, sl) (
  o = lv - thr; sl = 1 / ratio - 1;
  2 * o < -knee ? 0 : 2 * abs(o) <= knee ? sl * sqr(o + knee * 0.5) / (2 * knee) : sl * o;
);

function clip_s(u) ( abs(u) >= 1.5 ? sign(u) : u - 0.148148148 * u * u * u; );
function clip_h(u) ( min(max(u, -1), 1); );
function clip_x(u) ( hs <= 0.0001 ? clip_s(u) : hs >= 0.9999 ? clip_h(u) : clip_s(u) + (clip_h(u) - clip_s(u)) * hs; );
function clip_run(x) instance(u1, u2, d1, d2) local(e, o, a0, a1, a2, a3, de, dn) (
  x *= cdrv;
  os_n == 0 ? (
    x + (clip_x(x) - x) * cmix;
  ) : os_n == 1 ? (
    e = u1.hb_up(x); o = u1.o;
    e += (clip_x(e) - e) * cmix; o += (clip_x(o) - o) * cmix;
    d1.hb_down(e, o);
  ) : (
    e = u1.hb_up(x); o = u1.o;
    a0 = u2.hb_up(e); a1 = u2.o; a2 = u2.hb_up(o); a3 = u2.o;
    a0 += (clip_x(a0) - a0) * cmix; a1 += (clip_x(a1) - a1) * cmix;
    a2 += (clip_x(a2) - a2) * cmix; a3 += (clip_x(a3) - a3) * cmix;
    de = d2.hb_down(a0, a1); dn = d2.hb_down(a2, a3);
    d1.hb_down(de, dn);
  );
);

TPH = 1300;
function tp_taps() local(ph, k, t, w) (
  ph = 1;
  loop(3,
    k = 0;
    loop(8,
      t = (k - 3) - ph / 4;
      w = 0.5 + 0.5 * cos($pi * t / 4.5);
      TPH[(ph - 1) * 8 + k] = (abs(t) < 0.000001 ? 1 : sin($pi * t) / ($pi * t)) * w;
      k += 1;
    );
    ph += 1;
  );
);
function tp_peak(x) instance(buf, pos) local(n, m, ph, k, v) (
  buf[pos] = x; buf[pos + 8] = x; pos = (pos + 1) & 7;
  n = buf + pos;
  m = abs(n[3]);
  ph = 0;
  loop(3,
    v = 0; k = 0; loop(8, v += TPH[ph * 8 + k] * n[k]; k += 1; );
    m = max(m, abs(v)); ph += 1;
  );
  m;
);

K1 = 16; K2 = 8;
HB1 = 1000; HB2 = 1100;
hb_taps(HB1, K1, 8); hb_taps(HB2, K2, 7);
tL.u1.hb_init(K1, HB1, 2000); tL.d1.hb_init(K1, HB1, 2200); tL.u2.hb_init(K2, HB2, 2400); tL.d2.hb_init(K2, HB2, 2500);
tR.u1.hb_init(K1, HB1, 2600); tR.d1.hb_init(K1, HB1, 2800); tR.u2.hb_init(K2, HB2, 3000); tR.d2.hb_init(K2, HB2, 3100);
cL.u1.hb_init(K1, HB1, 3200); cL.d1.hb_init(K1, HB1, 3400); cL.u2.hb_init(K2, HB2, 3600); cL.d2.hb_init(K2, HB2, 3700);
cR.u1.hb_init(K1, HB1, 3800); cR.d1.hb_init(K1, HB1, 4000); cR.u2.hb_init(K2, HB2, 4200); cR.d2.hb_init(K2, HB2, 4300);
tp_taps();
tpL.buf = 4400; tpR.buf = 4420; memset(4400, 0, 40);
LA = max(1, floor(0.0015 * srate));
LDEL = LA + 3;
DLL = 10000; DLR = 12100; GRB = 14200;
lmA.buf = 16400; lmB.buf = 18500;

function ms_clear() local(i) (
  memset(2000, 0, 2400); memset(4400, 0, 40);
  memset(DLL, 0, 2048); memset(DLR, 0, 2048);
  i = 0; loop(2048, GRB[i] = 1; lmA.buf[i] = 1; lmB.buf[i] = 1; i += 1; );
  l_sum = lmA.sum = lmB.sum = LA; l_g = lmA.g = lmB.g = 1;
  c_ms = 0; c_gr = 0; c_slow = 0; cmA.ms = cmB.ms = 0; cmA.cg = cmB.cg = 0; cmA.slow = cmB.slow = 0;
  hf_g = 1; hfA.g = hfB.g = 1;
  gdc_x0 = gdc_y0 = gdc_x1 = gdc_y1 = 0;
  dcL.bq_clr(); dcR.bq_clr();
  eqB_L.bq_clr(); eqB_R.bq_clr(); eqM_L.bq_clr(); eqM_R.bq_clr(); eqH_L.bq_clr(); eqH_R.bq_clr(); eqP_L.bq_clr(); eqP_R.bq_clr();
  tapeL.bq_clr(); tapeR.bq_clr(); mmA.bq_clr(); mmB.bq_clr();
  hfA_L.bq_clr(); hfB_L.bq_clr(); hfA_R.bq_clr(); hfB_R.bq_clr(); lfA_L.bq_clr(); lfB_L.bq_clr(); lfA_R.bq_clr(); lfB_R.bq_clr();
);
lw = 0; dw = 0;
ms_clear();
l_gm_d = 1; hf_grm_d = 1;

sm10 = coef(10);
msx_dkr = 1 / (0.012 * srate); msx_dk = 1; msx_dst = 0;
sm30 = coef(30);
hf_att = coef(0.3); hf_rel = coef(60);
dcL.bq_set(1, 5, 0.707, 0, srate); dcR.bq_set(1, 5, 0.707, 0, srate);
rs_c = 1 / (0.015 * srate); rs_f = 1;

function targets() local(r) (
  in_t = db2g(ms_trim);
  mz_osi ? ( ms_os != os_n ? ( msx_dst == 0 ? msx_dst = 1 : msx_dst == 1 && msx_dk <= 0 ? os_n = ms_os; ); ) : ( os_n = ms_os; mz_osi = 1; );
  tmix_t = ms_tin >= 0.5;
  bias_b = ms_bias < 0.5 ? 0.05 : ms_bias < 1.5 ? 0.15 : 0.3;
  bias_k = ms_bias < 0.5 ? 0.85 : ms_bias < 1.5 ? 1 : 1.2;
  tk_t = db2g(ms_tdrv) * bias_k;
  tmk_t = max(db2g(ms_tdrv), 1) ^ 0.55;
  eq_t = ms_ein >= 0.5;
  out_t = db2g(ms_gain);
  st_t = ms_sin >= 0.5;
  wid_t = ms_wid / 100;
  cmp_t = ms_cin >= 0.5;
  r = max(ms_crat, 1);
  c_thr = ms_cthr; c_ratio = r; c_knee = min(max(12 / r, 3), 12);
  ms_cspd < 0.5 ? ( c_rms = 30; c_att = 30; c_rel = 350; c_rel2 = 1500; ) :
  ms_cspd < 1.5 ? ( c_rms = 15; c_att = 10; c_rel = 180; c_rel2 = 900; ) :
                  ( c_rms = 5;  c_att = 2;  c_rel = 70;  c_rel2 = 400; );
  c_rmsc = coef(c_rms); c_attc = coef(c_att); c_relc = coef(c_rel); c_rel2c = coef(c_rel2);
  c_mk_t = db2g(0.22 * -min(ms_cthr, 0) * (1 - 1 / r));
  c_mix_t = ms_cmix / 100;
  hf_t = min(max(-ms_hf / 0.5, 0), 1); hf_thr = db2g(min(ms_hf, -0.5));
  cmix_t = min(max(ms_clip / 0.5, 0), 1); cdrv_t = db2g(max(ms_clip, 0)); hs_t = ms_hard >= 0.5;
  lim_t = ms_lin >= 0.5; l_ceil = db2g(min(max(ms_ceil, -1), -0.1)); l_relc = coef(ms_rel);
  lk_t = ms_link >= 0.5;
);

function load_preset(p) local(i) (
  msx_dst = 1;
  ms_trim = 0; ms_os = 1; ms_tin = 1; ms_tdrv = -3; ms_bias = 1;
  ms_ein = 1; ms_bass = ms_lmid = ms_hmid = ms_pres = 0; ms_tape = 0;
  ms_sin = 1; ms_mono = 20; ms_wid = 100;
  ms_cin = 0; ms_cthr = -18; ms_crat = 2; ms_cspd = 1; ms_cmix = 100;
  ms_hf = 0; ms_clip = 0; ms_hard = 0;
  ms_lin = 1; ms_gain = 0; ms_ceil = -0.3; ms_rel = 80; ms_link = 1;
  p == 2 ? (
    ms_tin = 0; ms_mono = 30; ms_cin = 1; ms_cthr = -16; ms_crat = 1.5; ms_cspd = 1;
    ms_ceil = -1; ms_rel = 120; ms_gain = 2;
  ) : p == 3 ? (
    ms_bass = 1; ms_hmid = -0.5; ms_pres = 0.5; ms_tape = 1; ms_mono = 80;
    ms_cin = 1; ms_cthr = -18; ms_crat = 2; ms_cspd = 0;
    ms_hf = -14; ms_clip = 2; ms_ceil = -0.5; ms_rel = 100; ms_gain = 4;
  ) : p == 4 ? (
    ms_os = 2; ms_tdrv = 0; ms_bass = 1.5; ms_hmid = 0.5; ms_pres = 1; ms_mono = 100; ms_wid = 110;
    ms_cin = 1; ms_cthr = -20; ms_crat = 3; ms_cspd = 2; ms_cmix = 70;
    ms_hf = -12; ms_clip = 4; ms_rel = 60; ms_gain = 3;
  ) : p == 5 ? (
    ms_tdrv = 3; ms_bias = 0; ms_bass = 1.5; ms_pres = -1; ms_tape = 1; ms_mono = 120; ms_wid = 90;
    ms_cin = 1; ms_cthr = -18; ms_crat = 2.5; ms_cspd = 0;
    ms_hf = -10; ms_clip = 1; ms_ceil = -1; ms_rel = 150; ms_gain = 6;
  ) : p == 6 ? (
    ms_bias = 2; ms_lmid = -1; ms_hmid = 1; ms_pres = 2; ms_mono = 100; ms_wid = 120;
    ms_cin = 1; ms_cthr = -18; ms_crat = 2; ms_cspd = 1;
    ms_hf = -15; ms_clip = 3; ms_rel = 80; ms_gain = 3;
  ) : p == 7 ? (
    ms_os = 2; ms_tdrv = 0; ms_bass = 2; ms_lmid = -1; ms_pres = 0.5; ms_mono = 150; ms_wid = 110;
    ms_cin = 1; ms_cthr = -16; ms_crat = 2.5; ms_cspd = 2; ms_cmix = 80;
    ms_hf = -14; ms_clip = 3; ms_hard = 1; ms_rel = 50; ms_gain = 3;
  ) : p == 8 ? (
    ms_tin = 0; ms_tdrv = -6; ms_bass = 0.5; ms_pres = 0.5;
    ms_cin = 1; ms_cthr = -24; ms_crat = 1.3; ms_cspd = 0;
    ms_ceil = -1; ms_rel = 300; ms_gain = 2;
  ) : p == 9 ? (
    ms_tdrv = -6; ms_bass = -2; ms_lmid = -1; ms_hmid = 1.5; ms_pres = 1; ms_mono = 200; ms_wid = 0;
    ms_cin = 1; ms_cthr = -24; ms_crat = 3; ms_cspd = 1;
    ms_hf = -16; ms_clip = 2; ms_ceil = -1; ms_rel = 100; ms_gain = 6;
  ) : p == 10 ? (
    ms_tdrv = 0; ms_mono = 60;
    ms_cin = 1; ms_cthr = -30; ms_crat = 6; ms_cspd = 2; ms_cmix = 40;
    ms_clip = 2; ms_rel = 80; ms_gain = 2;
  ) : p == 11 ? (
    ms_os = 2; ms_tin = 0; ms_pres = 0.5; ms_mono = 40;
    ms_cin = 1; ms_cthr = -18; ms_crat = 1.8; ms_cspd = 1;
    ms_hf = -14; ms_ceil = -1; ms_rel = 150; ms_gain = 3;
  );
  i = 1; loop(27, i != 2 ? slider_automate(2 ^ (i - 1)); i += 1; );
  slider_automate(ms_os);
);

function update() (
  targets();
  eqB_L.bq_set(4, 90,   0.6, ms_bass, srate); eqB_R.bq_set(4, 90,   0.6, ms_bass, srate);
  eqM_L.bq_set(2, 350,  0.6, ms_lmid, srate); eqM_R.bq_set(2, 350,  0.6, ms_lmid, srate);
  eqH_L.bq_set(2, 2800, 0.6, ms_hmid, srate); eqH_R.bq_set(2, 2800, 0.6, ms_hmid, srate);
  eqP_L.bq_set(3, 7000, 0.6, ms_pres, srate); eqP_R.bq_set(3, 7000, 0.6, ms_pres, srate);
  tape_t = ms_tape >= 0.5;
  tapeL.bq_set(0, 18000, 0.707, 0, srate); tapeR.bq_set(0, 18000, 0.707, 0, srate);
  mm_t = ms_mono > 20.5;
  mmA.bq_set(1, max(ms_mono, 20), 0.5412, 0, srate); mmB.bq_set(1, max(ms_mono, 20), 1.3066, 0, srate);
  hfA_L.bq_set(1, 6000, 0.7071, 0, srate); hfB_L.bq_set(1, 6000, 0.7071, 0, srate);
  hfA_R.bq_set(1, 6000, 0.7071, 0, srate); hfB_R.bq_set(1, 6000, 0.7071, 0, srate);
  lfA_L.bq_set(0, 6000, 0.7071, 0, srate); lfB_L.bq_set(0, 6000, 0.7071, 0, srate);
  lfA_R.bq_set(0, 6000, 0.7071, 0, srate); lfB_R.bq_set(0, 6000, 0.7071, 0, srate);
  mz_oslat = os_n == 0 ? 0 : os_n == 1 ? 2 * K1 : 2 * K1 + K2;
  lat_t = 2 * mz_oslat + LDEL;
  pdc_delay = lat_t; pdc_bot_ch = 0; pdc_top_ch = 2;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;
update();
in_s = in_t; tmix = tmix_t; tk = tk_t; tmk = tmk_t; tb = bias_b; ttb = ms_th(tb); eq_s = eq_t; out_s = out_t;
st_s = st_t; wid_s = wid_t; cmp_s = cmp_t; c_mk = c_mk_t; c_mix = c_mix_t; tape_s = tape_t; mm_s = mm_t;
lk_s = lk_t; lk_u = 1 - lk_s;
hf_s = hf_t; cmix = cmix_t; cdrv = cdrv_t; hs = hs_t; lim_s = lim_t;
by_setup(28);

function cm_side(x2) instance(ms, cg, slow) local(lv, tg) (
  ms += (x2 - ms) * c_rmsc;
  lv = 10 * log10(max(ms, 0.0000000001)) + 3.01;
  tg = knee_gr(lv, c_thr, c_ratio * (1 + 0.25 * min(-cg / 12, 1)), c_knee);
  slow += ((cg < -1 ? 1 : 0) - slow) * c_rel2c * 0.5;
  cg += (tg - cg) * (tg < cg ? c_attc : c_relc + (c_rel2c - c_relc) * slow);
);
function hf_side(pk) instance(g) local(tg) (
  tg = pk > hf_thr ? hf_thr / pk : 1;
  g += (tg - g) * (tg < g ? hf_att : hf_rel);
);
function lm_side(tg, w) instance(buf, sum, g) local(mn, i, k, av) (
  buf[w] = tg;
  mn = 1; i = 0; loop(LA, k = w - i; k < 0 ? k += 1024; mn = min(mn, buf[k]); i += 1; );
  buf[1024 + w] = mn;
  k = w - LA; k < 0 ? k += 1024;
  sum += mn - buf[1024 + k];
  av = sum / LA;
  g = av < g ? av : g + (av - g) * l_relc;
);
function lm_follow(tg, mn, w) instance(buf, sum, g) ( buf[w] = tg; buf[1024 + w] = mn; sum = l_sum; g = l_g; );

function prs_hash() local(i, h) ( h = 0; i = 1; loop(28, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 11 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;
MSV = 20700;
function ms_nchg() local(i, n) ( n = 0; i = 1; loop(28, slider(i) != MSV[i] ? ( n += 1; MSV[i] = slider(i); ); i += 1; ); n; );
ms_nchg();
mz_fresh = 1;
gr_c_a = 0; gr_h_a = 1; gr_l_a = 1;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
ms_nchg() >= 3 && ms_ran && !mz_fresh && msx_dst == 0 ? msx_dst = 1;
mz_fresh ? mz_osi = 0;
msx_dst != 1 ? update();
msx_dst == 0 ? pdc_delay = lat_t;

@block
ext_gr_meter = min(gr_c_a + g2db(gr_h_a) + g2db(gr_l_a), 0); gr_c_a = 0; gr_h_a = 1; gr_l_a = 1;
prs_chk();
mz_fresh ? mz_osi = 0;
msx_dst != 1 ? update();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; ms_clear(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
ms_ran ? mz_fresh = 0;
msx_dst == 0 ? pdc_delay = lat_t;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
ms_ran = 1;
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
gdc_y0 = spl0 - gdc_x0 + gdc_r * gdc_y0; gdc_x0 = spl0; spl0 = gdc_y0;
gdc_y1 = spl1 - gdc_x1 + gdc_r * gdc_y1; gdc_x1 = spl1; spl1 = gdc_y1;
msx_dst == 1 ? ( msx_dk -= msx_dkr; msx_dk <= 0 ? ( msx_dk = 0; ms_on0 = os_n; update(); os_n != ms_on0 ? memset(2000, 0, 2400); msx_hc = lat_t + floor(0.002 * srate); msx_dst = 2; ); ) :
msx_dst == 2 ? ( msx_hc > 0 ? msx_hc -= 1 : ( msx_dk += msx_dkr; msx_dk >= 1 ? ( msx_dk = 1; msx_dst = 0; ); ); );
in_s += (in_t - in_s) * sm10;
lk_s += (lk_t - lk_s) * sm10; lk_s > 0.9999 && lk_t ? lk_s = 1; lk_s < 0.0001 && !lk_t ? lk_s = 0;
lk_u = 1 - lk_s;
xL = spl0 * in_s;
xR = spl1 * in_s;
ipL_d = max(ipL_d, abs(xL)); ipR_d = max(ipR_d, abs(xR));

tmix += (tmix_t - tmix) * sm10;
tk   += (tk_t - tk) * sm30; tmk += (tmk_t - tmk) * sm30;
tb   += (bias_b - tb) * sm30; ttb = ms_th(tb);
xL = tL.tube_run(xL);
xR = tR.tube_run(xR);
xL = dcL.bq(xL); xR = dcR.bq(xR);

eq_s += (eq_t - eq_s) * sm10; tape_s += (tape_t - tape_s) * sm10;
eq_s > 0.0001 ? (
  yL = eqP_L.bq(eqH_L.bq(eqM_L.bq(eqB_L.bq(xL))));
  yR = eqP_R.bq(eqH_R.bq(eqM_R.bq(eqB_R.bq(xR))));
  zL = tapeL.bq(yL); zR = tapeR.bq(yR);
  yL += (zL - yL) * tape_s; yR += (zR - yR) * tape_s;
  xL += (yL - xL) * eq_s;
  xR += (yR - xR) * eq_s;
);

st_s += (st_t - st_s) * sm10; wid_s += (wid_t - wid_s) * sm30; mm_s += (mm_t - mm_s) * sm10;
st_s > 0.0001 ? (
  mid = (xL + xR) * 0.5; sid = (xL - xR) * 0.5;
  sdf = mmB.bq(mmA.bq(sid));
  sid += (sdf - sid) * mm_s;
  sid *= wid_s;
  xL += (mid + sid - xL) * st_s;
  xR += (mid - sid - xR) * st_s;
);

cmp_s += (cmp_t - cmp_s) * sm10;
c_mk += (c_mk_t - c_mk) * sm10; c_mix += (c_mix_t - c_mix) * sm10;
cmp_s > 0.0001 ? (
  c_ms += ((xL * xL + xR * xR) * 0.5 - c_ms) * c_rmsc;
  c_lv = 10 * log10(max(c_ms, 0.0000000001)) + 3.01;
  c_tg = knee_gr(c_lv, c_thr, c_ratio * (1 + 0.25 * min(-c_gr / 12, 1)), c_knee);
  c_slow += ((c_gr < -1 ? 1 : 0) - c_slow) * c_rel2c * 0.5;
  c_gr += (c_tg - c_gr) * (c_tg < c_gr ? c_attc : c_relc + (c_rel2c - c_relc) * c_slow);
  c_mx = c_mix * cmp_s;
  lk_u > 0 ? (
    cmA.cm_side(xL * xL); cmB.cm_side(xR * xR);
    lk_a = c_gr + (cmA.cg - c_gr) * lk_u; lk_b = c_gr + (cmB.cg - c_gr) * lk_u;
    xL += (xL * db2g(lk_a) * c_mk - xL) * c_mx;
    xR += (xR * db2g(lk_b) * c_mk - xR) * c_mx;
    c_grm_d = min(c_grm_d, min(lk_a, lk_b));
    gr_c_a = min(gr_c_a, min(lk_a, lk_b) * c_mx);
  ) : (
    cmA.ms = cmB.ms = c_ms; cmA.cg = cmB.cg = c_gr; cmA.slow = cmB.slow = c_slow;
    c_g = db2g(c_gr) * c_mk;
    xL += (xL * c_g - xL) * c_mx;
    xR += (xR * c_g - xR) * c_mx;
    c_grm_d = min(c_grm_d, c_gr);
    gr_c_a = min(gr_c_a, c_gr * c_mx);
  );
);

hf_s += (hf_t - hf_s) * sm10;
hf_s > 0.0001 ? (
  hL = hfB_L.bq(hfA_L.bq(xL)); hR = hfB_R.bq(hfA_R.bq(xR));
  lL = lfB_L.bq(lfA_L.bq(xL)); lR = lfB_R.bq(lfA_R.bq(xR));
  hf_pk = max(abs(hL), abs(hR));
  hf_tg = hf_pk > hf_thr ? hf_thr / hf_pk : 1;
  hf_g += (hf_tg - hf_g) * (hf_tg < hf_g ? hf_att : hf_rel);
  lk_u > 0 ? (
    hfA.hf_side(abs(hL)); hfB.hf_side(abs(hR));
    lk_a = hf_g + (hfA.g - hf_g) * lk_u; lk_b = hf_g + (hfB.g - hf_g) * lk_u;
    xL += (lL + hL * lk_a - xL) * hf_s;
    xR += (lR + hR * lk_b - xR) * hf_s;
    hf_grm_d = min(hf_grm_d, min(lk_a, lk_b));
    gr_h_a = min(gr_h_a, min(lk_a, lk_b));
  ) : (
    hfA.g = hfB.g = hf_g;
    xL += (lL + hL * hf_g - xL) * hf_s;
    xR += (lR + hR * hf_g - xR) * hf_s;
    hf_grm_d = min(hf_grm_d, hf_g);
    gr_h_a = min(gr_h_a, hf_g);
  );
);

cmix += (cmix_t - cmix) * sm10; cdrv += (cdrv_t - cdrv) * sm10; hs += (hs_t - hs) * sm10;
xL = cL.clip_run(xL);
xR = cR.clip_run(xR);

out_s += (out_t - out_s) * sm10;
xL *= out_s; xR *= out_s;

lim_s += (lim_t - lim_s) * sm10;
l_pa = tpL.tp_peak(xL); l_pb = tpR.tp_peak(xR);
l_pk = max(l_pa, l_pb);
l_tg = l_pk > l_ceil ? l_ceil / l_pk : 1;
GRB[lw] = l_tg;
l_mn = 1; l_i = 0; loop(LA, l_k = lw - l_i; l_k < 0 ? l_k += 1024; l_mn = min(l_mn, GRB[l_k]); l_i += 1; );
GRB[1024 + lw] = l_mn;
l_k = lw - LA; l_k < 0 ? l_k += 1024;
l_sum += l_mn - GRB[1024 + l_k];
l_w0 = lw;
lw += 1; lw >= 1024 ? lw = 0;
l_av = l_sum / LA;
l_g = l_av < l_g ? l_av : l_g + (l_av - l_g) * l_relc;
lk_u > 0 ? (
  lmA.lm_side(l_pa > l_ceil ? l_ceil / l_pa : 1, l_w0); lmB.lm_side(l_pb > l_ceil ? l_ceil / l_pb : 1, l_w0);
) : (
  lmA.lm_follow(l_tg, l_mn, l_w0); lmB.lm_follow(l_tg, l_mn, l_w0);
);
DLL[dw] = xL; DLR[dw] = xR;
dr = dw - LDEL; dr < 0 ? dr += 2048; dw += 1; dw >= 2048 ? dw = 0;
yL = DLL[dr]; yR = DLR[dr];
lk_u > 0 ? (
  lk_a = l_g + (lmA.g - l_g) * lk_u; lk_b = l_g + (lmB.g - l_g) * lk_u;
  gL = yL * lk_a; gR = yR * lk_b;
) : (
  gL = yL * l_g; gR = yR * l_g;
);
gL = min(max(gL, -l_ceil), l_ceil); gR = min(max(gR, -l_ceil), l_ceil);
xL = yL + (gL - yL) * lim_s;
xR = yR + (gR - yR) * lim_s;
l_gx = lk_u > 0 ? min(lk_a, lk_b) : l_g;
l_gx += (1 - l_gx) * (1 - lim_s);
l_gm_d = min(l_gm_d, l_gx); gr_l_a = min(gr_l_a, l_gx);

msx_dst ? ( msx_dkg = msx_dk * msx_dk * (3 - 2 * msx_dk); xL *= msx_dkg; xR *= msx_dkg; );
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); rs_g = rs_f * rs_f * (3 - 2 * rs_f); xL *= rs_g; xR *= rs_g; );
spl0 = abs(xL) < 0.00000000000000000001 ? 0 : xL;
spl1 = abs(xR) < 0.00000000000000000001 ? 0 : xR;
by_out();
opL_d = max(opL_d, abs(spl0)); opR_d = max(opR_d, abs(spl1));

@gfx 900 355
ui_begin(900, 355);
v5_begin();
MBG = 0x222938; MPK = 0x181C26; MBAR = 0x12151C; MACC = 0xD9B86A; MINK = 0xECEEF2; MDIM = 0x949CAC;
MWELL = 0x0C0E12; MGOLD = 0xD9B86A; MCRM = 0xE6E0CE; MSTL = 0xA9BAD6; MDOT = 0x23201A;
MLF = 0xC08850; MLM = 0x8EC6F0; MHM = 0x7CC48A; MHF = 0xEC7A6E;
MKF = ui_mix(MBAR, 0, 0.3); MKH = ui_mix(MBAR, 0, 0.12);
v5_led = 0xFFB030; v5_ink = 0xC9CCC6;
sc != ms_fsc ? (
  ms_fsc = sc;
  ms_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  ms_f6 = ui_fitfont(6, 26 * sc);
);
function ms_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * ms_kt * sc, 'b'); );
function ms_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function ms_trt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function ms_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
function ms_gdb(g) ( 20 * log10(max(g, 0.0000000001)); );
function ms_grad(x, y, w, h, c1, c2) local(r1, g1, b1, r2, g2, b2, x0, y0, x1, y1) (
  r1 = ((c1 >> 16) & 255) / 255; g1 = ((c1 >> 8) & 255) / 255; b1 = (c1 & 255) / 255;
  r2 = ((c2 >> 16) & 255) / 255; g2 = ((c2 >> 8) & 255) / 255; b2 = (c2 & 255) / 255;
  x0 = floor(x * sc + 0.5); y0 = floor(y * sc + 0.5); x1 = floor((x + w) * sc + 0.5); y1 = floor((y + h) * sc + 0.5);
  x1 > x0 && y1 > y0 ? gfx_gradrect(x0, y0, x1 - x0, y1 - y0, r1, g1, b1, 1, 0, 0, 0, 0, (r2 - r1) / (y1 - y0), (g2 - g1) / (y1 - y0), (b2 - b1) / (y1 - y0), 0);
);
function ms_rivet(x, y) ( ui_cola(0, 0.35); v5_d(x + 1, y + 1.5, 4); ui_col(0x5A6478); v5_d(x, y, 4); ui_col(0x8A94A8); v5_d(x - 0.8, y - 0.8, 2.4); );
function ms_cham(x, y, w, h, d, f, face) (
  ui_cola(0xFFFFFF, 0.10); v5_r(x, y + h, w + 1, 1); v5_r(x + w, y, 1, h);
  ui_col(ui_mix(f, 0, 0.50)); v5_q(x, y, x + w, y, x + w - d, y + d, x + d, y + d);
  ui_col(ui_mix(f, 0, 0.36)); v5_q(x, y, x + d, y + d, x + d, y + h - d, x, y + h);
  ui_col(ui_mix(f, 0xFFFFFF, 0.06)); v5_q(x + w, y, x + w, y + h, x + w - d, y + h - d, x + w - d, y + d);
  ui_col(ui_mix(f, 0xFFFFFF, 0.12)); v5_q(x, y + h, x + d, y + h - d, x + w - d, y + h - d, x + w, y + h);
  ui_col(face); v5_r(x + d, y + d, w - 2 * d, h - 2 * d);
);
function ms_plate(x, y, w, h, ttl) (
  ms_cham(x, y, w, h, 3, ui_mix(MBG, 0xFFFFFF, 0.08), MPK);
  ms_ft(18); ui_col(MINK); ms_tl(x + 14, y + 21, ttl);
  ui_col(MACC); v5_r(x + 14, y + 33, ms_tw(ttl), 3);
);
function ms_wash(x, y, w, h) ( ui_cola(MPK, 0.55); v5_r(x + 3, y + 40, w - 6, h - 43); );
function ms_glass(x, y, w, h) local(c0, c1, c2) (
  ui_col(0x050606); v5_rr(x - 4, y - 4, w + 8, h + 8, 4);
  ui_col(0x1A1C1D); v5_rr(x - 2, y - 2, w + 4, h + 4, 3);
  c0 = ui_mix(0xB4AE9A, 0xE4DECA, 0.44); c1 = 0xE4DECA; c2 = ui_mix(0xB4AE9A, 0xE4DECA, 0.16);
  ms_grad(x, y, w, h * 0.4, c0, c1); ms_grad(x, y + h * 0.4, w, h * 0.6, c1, c2);
  ui_cola(0, 0.22); v5_r(x, y, w, 2); v5_r(x, y + 2, 2, h - 2);
);
function ms_well(x, y, w, h) local(j) (
  ui_cola(0xFFFFFF, 0.07); v5_r(x, y + h, w + 1, 1.5); v5_r(x + w, y, 1.5, h + 1);
  ui_col(MWELL); v5_rr(x, y, w, h, 3);
  j = 0; loop(3, ui_cola(0, 0.2 - j * 0.05); v5_r(x + 1, y + 1 + j, w - 2, 1); v5_r(x + 1 + j, y + 2 + j, 1, h - 3 - j); j += 1; );
);
function ms_rk(x, y, w, h, on, lg) local(gx, hv) (
  hv = v5_hit(x, y, w, h);
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(hv ? MKH : MKF); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.45); v5_r(x + 1, y + 1, w - 2, 2); v5_r(x + 1, y + 1, 2, h - 2);
  ui_cola(0xFFFFFF, 0.06); v5_r(x + 2, y + h - 1, w - 3, 1);
  gx = x + 7;
  ui_col(0x050606); v5_rr(gx, y + 5, 7, h - 10, 3.5);
  on ? ( ui_cola(v5_led, 0.25); v5_rr(gx - 3, y + 3, 13, h - 6, 5); ui_col(v5_led); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); )
     : ( ui_col(ui_mix(v5_led, 0x0A0B0B, 0.75)); v5_rr(gx + 2, y + 6, 3, h - 12, 1.5); );
  gfx_setfont(v5_fk); ui_col(on ? 0xF6F8F4 : 0xA8ACA6); v5_t((gx + 11 + x + w - 4) * 0.5, y + h * 0.5 + 0.5, lg);
);
function ms_key(x, y, w, h, idx, lg) local(on) (
  on = v5_toggle(idx, v5_hit(x, y, w, h));
  ms_rk(x, y, w, h, on, lg);
  on;
);
function ms_in(x, y, idx) local(on, dn, hv) (
  hv = v5_hit(x, y, 40, 24);
  on = v5_toggle(idx, hv);
  dn = on ? 1.5 : 0;
  ui_col(0x050606); v5_rr(x - 1, y - 1, 42, 26, 4);
  ui_col(hv ? MKH : MKF); v5_rr(x, y + dn, 40, 24 - dn, 4);
  ui_cola(0, 0.45); v5_r(x + 1, y + 1 + dn, 38, 2); v5_r(x + 1, y + 1 + dn, 2, 22 - dn);
  ui_cola(0xFFFFFF, 0.06); v5_r(x + 2, y + 23, 37, 1);
  gfx_setfont(v5_fk);
  on ? v5_glowt(x + 20, y + 12.5 + dn * 0.5, "IN") : ( ui_col(0x5E5A50); v5_t(x + 20, y + 12.5 + dn * 0.5, "IN"); );
  on;
);
function ms_box(x, y, w, h, idx, items, n, cur_lbl) local(hv, i, v) (
  hv = v5_hit(x, y, w, h);
  ui_col(0x050606); v5_rr(x - 1, y - 1, w + 2, h + 2, 3);
  ui_col(hv ? MKH : MKF); v5_rr(x, y, w, h, 3);
  ui_cola(0, 0.45); v5_r(x + 1, y + 1, w - 2, 2); v5_r(x + 1, y + 1, 2, h - 2);
  ui_cola(0xFFFFFF, 0.06); v5_r(x + 2, y + h - 1, w - 3, 1);
  gfx_setfont(v5_fk); ui_col(ms_dim ? 0x8A8C86 : 0xF2EAD2); v5_t(x + w * 0.5 - 4, y + h * 0.5 + 0.5, cur_lbl);
  ui_col(ms_dim ? 0x6A6C66 : MACC);
  gfx_triangle((x + w - 12) * sc, (y + h * 0.5 - 2) * sc, (x + w - 6) * sc, (y + h * 0.5 - 2) * sc, (x + w - 9) * sc, (y + h * 0.5 + 2) * sc);
  v5_pr && v5_drag == 0 && hv ? (
    v5_drag = -1; v = floor(slider(idx) + 0.5);
    strcpy(#ms_mm, ""); i = 0;
