desc:Ferrum V5 [valve mastering compressor] (GFX Lab)
//tags: compressor vari-mu valve mastering bus mid-side
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts, gfx-lab-v5-palette (.jsfx-inc) in the same folder.

slider25:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:fe_th=10<-20,20,0.1>-Threshold (dB re 0 VU)
slider2:fe_bias=5<0,10,0.1>-Tube bias
slider3:fe_gain=0<0,20,0.1>-Gain (dB)
slider4:fe_atk=2<0,5,1{1,2,3,4,5,6}>-Attack
slider5:fe_rel=2<0,5,1{1,2,3,4,5,6}>-Release
slider6:fe_rect=1<0,5,1{GE,SI,LED,G+S,S+L,ALL}>-Rectifier
slider7:fe_schp=0<0,330,1>-Sidechain HPF (Hz, below 20 = off)
slider8:fe_lift=0<0,1,1{Off,On}>-Sidechain lift
slider9:fe_focus=0<0,1,1{Off,On}>-Sidechain focus
slider10:fe_ext=0<0,1,1{Off,On}>-External sidechain
slider11:fe_bass=0<0,1,1{Off,On}>-Bass lift
slider12:fe_air=0<0,1,1{Off,On}>-Air band
slider13:fe_iron=1<0,1,1{Off,On}>-Iron
slider14:fe_mode=0<0,1,1{Stereo,M/S}>-Mode
slider15:fe_bal=0<-100,100,1>-M/S balance (%)
slider16:fe_width=100<0,200,1>-Width (%)
slider17:fe_mono=0<0,5,1{Off,55 Hz,110 Hz,165 Hz,220 Hz,330 Hz}>-Mono below
slider18:fe_mix=100<0,100,1>-Mix (%)
slider19:fe_out=0<-12,12,0.1>-Output (dB)
slider20:fe_tol=30<0,100,1>-Tolerance (%)
slider21:fe_head=18<6,24,0.1>-Headroom (dB)
slider22:fe_byp=0<0,1,1{Off,On}>-Bypass
slider23:fe_os=0<0,2,1{1x,2x,4x}>-Oversampling
slider24:prs_sel=0<0,10,1{No preset,Init,Gentle Glue,Master Polish,Warm Valves,Punchy Drums,Vocal Silk,Bass Control,Parallel Squeeze,M/S Tighten,Smooth Leveller}>-Preset

in_pin:left input
in_pin:right input
in_pin:sidechain left
in_pin:sidechain right
out_pin:left output
out_pin:right output

import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc
import gfx-lab-v5-palette.jsfx-inc

@init
ext_gr_meter = 0;
function psw_all(v) ( slider_show(33554431, v); );
function psw_allg(v) ( slider_show(33554431, v); );
#ui_man = "gfx-lab-ferrum";
ext_noinit = 1;

fe_nm = 100000;
function fe_alloc(n) local(p) ( p = fe_nm; fe_nm += n; memset(p, 0, n); p; );
function fe_g(d) ( exp(d * 0.11512925465); );
function fe_db(g) ( 8.68588963807 * log(max(g, 0.0000000001)); );
function fe_tanh(v) ( v = max(-20, min(20, v)); 1 - 2 / (exp(2 * v) + 1); );
function fe_sk(o, w) ( o <= -w * 0.5 ? 0 : o >= w * 0.5 ? o : (o + w * 0.5) * (o + w * 0.5) / (2 * w); );
function fe_tc(t) ( 1 - exp(-1 / (max(0.000001, t) * srate)); );
function fe_bq(x, c, z) local(y) (
  y = c[0] * x + c[1] * z[0] + c[2] * z[1] - c[3] * z[2] - c[4] * z[3];
  z[1] = z[0]; z[0] = x; z[3] = z[2]; z[2] = y; y;
);
function fe_cset(c, t, f, g, q) local(A, w, cs, al, sa, a0) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cs = cos(w); al = sin(w) / (2 * q); A = 10 ^ (g / 40);
  t == 0 ? ( a0 = 1 + al; c[0] = (1 - cs) * 0.5 / a0; c[1] = (1 - cs) / a0; c[2] = c[0]; c[3] = -2 * cs / a0; c[4] = (1 - al) / a0; ) :
  t == 1 ? ( a0 = 1 + al; c[0] = (1 + cs) * 0.5 / a0; c[1] = -(1 + cs) / a0; c[2] = c[0]; c[3] = -2 * cs / a0; c[4] = (1 - al) / a0; ) :
  t == 2 ? ( a0 = 1 + al / A; c[0] = (1 + al * A) / a0; c[1] = -2 * cs / a0; c[2] = (1 - al * A) / a0; c[3] = -2 * cs / a0; c[4] = (1 - al / A) / a0; ) :
  t == 3 ? ( sa = 2 * sqrt(A) * al; a0 = (A + 1) - (A - 1) * cs + sa;
             c[0] = A * ((A + 1) + (A - 1) * cs + sa) / a0; c[1] = -2 * A * ((A - 1) + (A + 1) * cs) / a0; c[2] = A * ((A + 1) + (A - 1) * cs - sa) / a0;
             c[3] = 2 * ((A - 1) - (A + 1) * cs) / a0; c[4] = ((A + 1) - (A - 1) * cs - sa) / a0; ) :
           ( sa = 2 * sqrt(A) * al; a0 = (A + 1) + (A - 1) * cs + sa;
             c[0] = A * ((A + 1) - (A - 1) * cs + sa) / a0; c[1] = 2 * A * ((A - 1) - (A + 1) * cs) / a0; c[2] = A * ((A + 1) - (A - 1) * cs - sa) / a0;
             c[3] = -2 * ((A - 1) + (A + 1) * cs) / a0; c[4] = ((A + 1) + (A - 1) * cs - sa) / a0; );
);

function fe_chinit() instance(z1, z2, z3, z4, e, mem, ipl, ipl2, opl, opl2, dc) (
  z1 = fe_alloc(4); z2 = fe_alloc(4); z3 = fe_alloc(4); z4 = fe_alloc(4);
  e = mem = ipl = ipl2 = opl = opl2 = dc = 0;
);
function fe_chclr() instance(z1, z2, z3, z4, e, mem, ipl, ipl2, opl, opl2, dc) (
  memset(z1, 0, 4); memset(z2, 0, 4); memset(z3, 0, 4); memset(z4, 0, 4);
  e = mem = ipl = ipl2 = opl = opl2 = dc = 0;
);
function fe_sc(x, xe) instance(z1, z2, z3, z4) (
  x += (xe - x) * fe_exm;
  x += (fe_bq(x, SC1, z1) - x) * fe_hpm;
  x += (fe_bq(x, SC2, z2) - x) * fe_lfm;
  x += (fe_bq(fe_bq(x, SC3, z3), SC4, z4) - x) * fe_fcm;
  x;
);
function fe_det(s, ac, rc, ro) instance(e, mem) local(r) (
  r = abs(s);
  e = r > e ? e + (r - e) * ac : e + (r - e) * rc / (1 + 2.5 * mem);
  fe_db(e) + ro;
);
function fe_ir1(x) instance(ipl, ipl2) local(lo) (
  ipl += (x - ipl) * fe_ic; ipl2 += (ipl - ipl2) * fe_ic;
  lo = (fe_tanh(ipl2 * 0.7 + 0.1) - fe_idc) / 0.7;
  x + (lo + (x - ipl2) - x) * fe_irm;
);
function fe_ir2(x) instance(opl, opl2) local(lo) (
  opl += (x - opl) * fe_ic; opl2 += (opl - opl2) * fe_ic;
  lo = (fe_tanh(opl2 * 0.45 + 0.1) - fe_idc) / 0.45;
  x + (lo + (x - opl2) - x) * fe_irm;
);
function fe_valve(x, k, a) local(t) ( t = fe_tanh(k * a); (fe_tanh(k * (x + a)) - t) / (k * (1 - t * t)); );
function fe_stage(x, ga, gb, ka, kb, ba, bb, gn) (
  x = this.fe_ir1(x);
  x = 0.5 * (fe_valve(x * ga, 0.6 * ka, ba) + fe_valve(x * gb, 0.9 * kb, bb)) * gn;
  this.fe_ir2(x);
);

fe_idc = fe_tanh(0.1);
SC1 = fe_alloc(5); SC2 = fe_alloc(5); SC3 = fe_alloc(5); SC4 = fe_alloc(5);
BL1 = fe_alloc(5); BL2 = fe_alloc(5); AIR = fe_alloc(5); MM = fe_alloc(5);
zB1L = fe_alloc(4); zB1R = fe_alloc(4); zB2L = fe_alloc(4); zB2R = fe_alloc(4); zAL = fe_alloc(4); zAR = fe_alloc(4);
zM1 = fe_alloc(4); zM2 = fe_alloc(4);
c1.fe_chinit(); c2.fe_chinit();
FE_DRY = 7000000; FE_DN = 1024;

!fe_seed ? ( tr1 = rand(1); tr2 = rand(1); tr3 = rand(1); tr4 = rand(1); tr5 = rand(1); tr6 = rand(1); fe_seed = 1; );

function fe_srinit() (
  fe_sr = srate;
  fe_gdc = 1 - 2 * $pi / srate;
  fe_ks = fe_tc(0.03); fe_ksw = fe_tc(0.012);
  fe_dcc = 1 - exp(-2 * $pi * 8 / srate);
  fe_memc = fe_tc(1.5);
  fe_dks = 1 / (0.006 * srate);
  rs_c = 1 / (0.015 * srate);
  fe_cset(SC2, 2, 3300, 4, 1.0); fe_cset(SC3, 1, 220, 0, 0.6); fe_cset(SC4, 0, 4400, 0, 0.6);
  fe_cset(BL1, 4, 66, 1.5, 0.9); fe_cset(BL2, 2, 220, -0.6, 0.8); fe_cset(AIR, 3, 11000, 1.8, 0.6);
  fe_hpf = -1; fe_mof = -1;
);
function fe_icset() ( fe_ic = 1 - exp(-2 * $pi * 110 / (srate * os_f)); );
function fe_clear() (
  c1.fe_chclr(); c2.fe_chclr();
  memset(zB1L, 0, 4); memset(zB1R, 0, 4); memset(zB2L, 0, 4); memset(zB2R, 0, 4); memset(zAL, 0, 4); memset(zAR, 0, 4);
  memset(zM1, 0, 4); memset(zM2, 0, 4); memset(FE_DRY, 0, 2 * FE_DN);
  uA.os_clr(); uB.os_clr(); dA.os_clr(); dB.os_clr();
  fe_x0 = fe_y0 = fe_x1 = fe_y1 = fe_x2 = fe_y2 = fe_x3 = fe_y3 = 0;
);

function fe_atms(i) ( i == 0 ? 60 : i == 1 ? 30 : i == 2 ? 15 : i == 3 ? 8 : i == 4 ? 3 : 1; );
function fe_rls(i) ( i == 0 ? 2500 : i == 1 ? 1200 : i == 2 ? 600 : i == 3 ? 350 : i == 4 ? 200 : 100; );
function fe_rof(i) ( i == 0 ? 1 : i == 1 ? 0 : i == 2 ? -2 : i == 3 ? 0.5 : i == 4 ? -1 : -0.3; );
function fe_rkn(i) ( i == 0 ? 4 : i == 1 ? 0 : i == 2 ? -2 : i == 3 ? 2 : i == 4 ? -1 : 1.5; );
function fe_rat(i) ( i == 0 ? 1.3 : i == 1 ? 1 : i == 2 ? 0.7 : i == 3 ? 1.15 : i == 4 ? 0.85 : 1; );
function fe_rrl(i) ( i == 0 ? 1.2 : i == 1 ? 1 : i == 2 ? 0.8 : i == 3 ? 1.1 : i == 4 ? 0.9 : 1; );
function fe_mhz(i) ( i == 5 ? 330 : i * 55; );

function fe_params() local(at, re, rc, tol, off, hp, mo) (
  at = floor(fe_atk + 0.5); re = floor(fe_rel + 0.5); rc = floor(fe_rect + 0.5);
  tol = min(max(fe_tol, 0), 100) * 0.01;
  off = fe_mode >= 0.5 ? 6 * min(max(fe_bal, -100), 100) / 100 : 0;
  fe_t1t = fe_th + off + tol * (tr1 - 0.5) + fe_rof(rc);
  fe_t2t = fe_th - off + tol * (tr4 - 0.5) + fe_rof(rc);
  fe_knt = 2 + fe_rkn(rc);
  fe_qat = 1.5 + 0.25 * fe_bias; fe_qbt = 2 + 0.6 * fe_bias;
  fe_kd1 = 1 + tol * (tr4 - 0.5) * 0.15; fe_kd2 = 1 + tol * (tr1 - 0.5) * 0.15;
  fe_a1 = fe_tc(fe_atms(at) * 0.001 * fe_rat(rc) * (1 + tol * (tr2 - 0.5) * 0.2));
  fe_r1 = fe_tc(fe_rls(re) * 0.001 * fe_rrl(rc) * (1 + tol * (tr3 - 0.5) * 0.2));
  fe_a2 = fe_tc(fe_atms(at) * 0.001 * fe_rat(rc) * (1 + tol * (tr5 - 0.5) * 0.2));
  fe_r2 = fe_tc(fe_rls(re) * 0.001 * fe_rrl(rc) * (1 + tol * (tr6 - 0.5) * 0.2));
  fe_gt = fe_g(fe_gain); fe_ogt = fe_g(fe_out); fe_mxt = fe_mix * 0.01; fe_wdt = fe_width * 0.01;
  fe_hrt = fe_g(18 - fe_head);
  hp = fe_schp;
  fe_hpmt = hp >= 20; hp >= 20 && hp != fe_hpf ? ( fe_cset(SC1, 1, hp, 0, 0.707); fe_hpf = hp; );
  fe_lfmt = fe_lift >= 0.5; fe_fcmt = fe_focus >= 0.5; fe_exmt = fe_ext >= 0.5;
  fe_irmt = fe_iron >= 0.5; fe_bsmt = fe_bass >= 0.5; fe_armt = fe_air >= 0.5;
  mo = floor(fe_mono + 0.5); fe_momt = mo > 0;
  mo > 0 && mo != fe_mof ? ( fe_cset(MM, 1, fe_mhz(mo), 0, 0.7071); fe_mof = mo; );
  fe_mst = fe_mode >= 0.5;
  fe_snap ? (
    fe_t1 = fe_t1t; fe_t2 = fe_t2t; fe_kn = fe_knt; fe_qa = fe_qat; fe_qb = fe_qbt;
    fe_gn = fe_gt; fe_og = fe_ogt; fe_mx = fe_mxt; fe_wd = fe_wdt; fe_hr = fe_hrt;
    fe_hpm = fe_hpmt; fe_lfm = fe_lfmt; fe_fcm = fe_fcmt; fe_exm = fe_exmt; fe_irm = fe_irmt; fe_bsm = fe_bsmt; fe_arm = fe_armt; fe_mom = fe_momt;
    fe_msc = fe_mst; fe_dk = 1; fe_snap = 0;
  );
);

os_design();
os_f = os_tf = os_f2n(fe_os);
os_base = 0;
fe_srinit(); fe_icset(); fe_clear();
fe_snap = 1; fe_params();
os_gsetup();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
by_setup(22);
fe_grm_d = fe_grs_d = 0; fe_gra = 0; rs_f = 1;
ndM.vpos = ndS.vpos = 1;

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; ); ui_dflt = 1;

function fe_set(th, bi, gn, at, re, rc, sf, mx, mo, bs, ai, ms, bl) (
  fe_th = th; fe_bias = bi; fe_gain = gn; fe_atk = at; fe_rel = re; fe_rect = rc;
  fe_schp = sf == 1 ? 80 : sf == 2 ? 150 : sf == 3 ? 100 : 0; fe_lift = sf == 3; fe_focus = sf == 4; fe_ext = 0;
  fe_bass = bs; fe_air = ai; fe_iron = 1; fe_mode = ms; fe_bal = bl; fe_width = 100; fe_mono = mo; fe_mix = mx; fe_out = 0;
);
function load_preset(p) local(i) (
  p == 1  ? fe_set(10, 5, 0, 2, 2, 1, 0, 100, 0, 0, 0, 0, 0) :
  p == 2  ? fe_set(7, 3, 1.5, 1, 1, 0, 1, 100, 0, 0, 0, 0, 0) :
  p == 3  ? fe_set(5, 4, 2, 2, 2, 3, 1, 100, 2, 0, 1, 0, 0) :
  p == 4  ? fe_set(3, 6, 5, 1, 1, 0, 0, 100, 0, 1, 0, 0, 0) :
  p == 5  ? fe_set(-6, 7, 6, 0, 4, 2, 2, 100, 0, 1, 1, 0, 0) :
  p == 6  ? fe_set(3, 5, 4.5, 3, 3, 3, 3, 100, 0, 0, 1, 0, 0) :
  p == 7  ? fe_set(4.5, 6, 3, 2, 2, 1, 0, 100, 2, 1, 0, 0, 0) :
  p == 8  ? fe_set(-6, 9, 10, 4, 5, 2, 1, 40, 0, 0, 0, 0, 0) :
  p == 9  ? fe_set(1.5, 5.5, 2, 2, 2, 1, 1, 100, 2, 0, 0, 1, 25) :
  p == 10 ? fe_set(2, 4, 3, 1, 0, 2, 1, 100, 0, 0, 0, 0, 0);
  i = 1; loop(19, ui_auto(i); i += 1; );
  pr_cur = p;
);
function prs_hash() local(i, h) ( h = 0; i = 1; loop(23, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
fe_params();
os_tf = os_f2n(fe_os);
os_snap(slider(23));

@block
ext_gr_meter = min(-fe_gra, 0); fe_gra = 0;
prs_chk();
srate != fe_sr ? ( fe_srinit(); fe_icset(); );
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; fe_clear(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
fe_params();
os_tf = os_f2n(fe_os);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = os_lat(os_f);
c1.mem = abs(c1.mem) < 0.0000000001 ? 0 : c1.mem; c2.mem = abs(c2.mem) < 0.0000000001 ? 0 : c2.mem;
fe_n > 0 ? (
  fe_ll_d = max(fe_ll_d, sqrt(fe_sl / fe_n)); fe_lr_d = max(fe_lr_d, sqrt(fe_sr2 / fe_n));
  fe_lm_d = max(fe_lm_d, sqrt(fe_sm / fe_n)); fe_ls_d = max(fe_ls_d, sqrt(fe_ss / fe_n));
  fe_cr_d = fe_sl * fe_sr2 > 0.0000000001 ? fe_sx / sqrt(fe_sl * fe_sr2) : 1;
);
fe_sl = fe_sr2 = fe_sm = fe_ss = fe_sx = fe_n = 0;
os_snapb(slider(23));

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
file_var(0, fe_seed); file_var(0, tr1); file_var(0, tr2); file_var(0, tr3); file_var(0, tr4); file_var(0, tr5); file_var(0, tr6);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
fe_y0 = spl0 - fe_x0 + fe_gdc * fe_y0; fe_x0 = spl0; fe_il = fe_y0;
fe_y1 = spl1 - fe_x1 + fe_gdc * fe_y1; fe_x1 = spl1; fe_ir = fe_y1;
fe_y2 = spl2 - fe_x2 + fe_gdc * fe_y2; fe_x2 = spl2; fe_el = fe_y2;
fe_y3 = spl3 - fe_x3 + fe_gdc * fe_y3; fe_x3 = spl3; fe_er = fe_y3;
fe_t1 += (fe_t1t - fe_t1) * fe_ks; fe_t2 += (fe_t2t - fe_t2) * fe_ks; fe_kn += (fe_knt - fe_kn) * fe_ks;
fe_qa += (fe_qat - fe_qa) * fe_ks; fe_qb += (fe_qbt - fe_qb) * fe_ks;
fe_gn += (fe_gt - fe_gn) * fe_ks; fe_og += (fe_ogt - fe_og) * fe_ks; fe_mx += (fe_mxt - fe_mx) * fe_ks;
fe_wd += (fe_wdt - fe_wd) * fe_ks; fe_hr += (fe_hrt - fe_hr) * fe_ks;
fe_hpm += (fe_hpmt - fe_hpm) * fe_ksw; fe_lfm += (fe_lfmt - fe_lfm) * fe_ksw; fe_fcm += (fe_fcmt - fe_fcm) * fe_ksw;
fe_exm += (fe_exmt - fe_exm) * fe_ksw; fe_irm += (fe_irmt - fe_irm) * fe_ksw; fe_bsm += (fe_bsmt - fe_bsm) * fe_ksw;
fe_arm += (fe_armt - fe_arm) * fe_ksw; fe_mom += (fe_momt - fe_mom) * fe_ksw;
fe_mst != fe_msc ? ( fe_dk = max(fe_dk - fe_dks, 0); fe_dk == 0 ? fe_msc = fe_mst; ) : fe_dk < 1 ? fe_dk = min(fe_dk + fe_dks, 1);
fe_msc ? ( fe_a = (fe_il + fe_ir) * 0.5; fe_b = (fe_il - fe_ir) * 0.5; fe_ea = (fe_el + fe_er) * 0.5; fe_eb = (fe_el - fe_er) * 0.5; )
       : ( fe_a = fe_il; fe_b = fe_ir; fe_ea = fe_el; fe_eb = fe_er; );
fe_a *= fe_hr; fe_b *= fe_hr; fe_ea *= fe_hr; fe_eb *= fe_hr;
fe_d1 = c1.fe_det(c1.fe_sc(fe_a, fe_ea), fe_a1, fe_r1, 0);
fe_d2 = c2.fe_det(c2.fe_sc(fe_b, fe_eb), fe_a2, fe_r2, 0);
!fe_msc ? fe_d1 = fe_d2 = max(fe_d1, fe_d2);
fe_o1 = fe_d1 - (fe_t1 - 18); fe_o2 = fe_d2 - (fe_t2 - 18);
fe_gA1 = -fe_sk(fe_o1, 14 + fe_kn) * (1 - 1 / fe_qa); fe_gB1 = -fe_sk(fe_o1 - 3, 7 + fe_kn) * (1 - 1 / fe_qb);
fe_gA2 = -fe_sk(fe_o2, 14 + fe_kn) * (1 - 1 / fe_qa); fe_gB2 = -fe_sk(fe_o2 - 3, 7 + fe_kn) * (1 - 1 / fe_qb);
c1.mem += (min(1, -0.5 * (fe_gA1 + fe_gB1) / 10) - c1.mem) * fe_memc;
c2.mem += (min(1, -0.5 * (fe_gA2 + fe_gB2) / 10) - c2.mem) * fe_memc;
