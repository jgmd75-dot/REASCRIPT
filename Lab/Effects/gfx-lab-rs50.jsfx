desc:GFX Lab G RS50 [drum machine]
//tags: instrument drum machine rhythm digital 505 sequencer lo-fi stereo
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-thick, gfx-lab-ui, gfx-lab-panel, gfx-lab-dyn (.jsfx-inc) in the same
// folder.
//
// RS50 - the RS series' little stereo machine, in the spirit of the mid-80s budget rhythm composer with sixteen
// sounds and a stereo mix. No samples: every sound is synthesised when the plug-in loads ("baked") at a 20 kHz sample
// clock, stored 8-bit (companded; the cymbals 6-bit) and played back through the converter's gentle 9 kHz filter.
//
// VOICES (sixteen channels, each with LEVEL and PAN): BASS, SNARE, LO / MID / HI TOM, RIM, CLAP, CLOSED HAT, OPEN HAT
// (CH cuts off a ringing OH), CRASH, RIDE, LO / HI CONGA, TIMBALE, LO / HI COWBELL ("BELL").
//   ACCENT: how much louder the accented steps are. The voices meet in a stereo mix bus with a soft analogue drive.
//
// SEQUENCER: 16 patterns of 16 steps per channel (off / hit / accent), LAST STEP per pattern, SWING. It never starts
//   running by itself: press RUN. While REAPER plays, it locks to the timeline (bar 1 = step 1); while REAPER is
//   stopped, RUN free-runs at the project tempo. A new pattern takes over at the end of the bar.
// MIDI: notes play the voices too (GM drum map: 35 / 36 BD, 38 / 40 SD, 41 LT, 45 MT, 48 HT, 37 RS, 39 CP, 42 CH,
//   46 OH, 49 CR, 51 RD, 64 LC, 63 HC, 65 / 66 TI, 68 LB, 56 HB); velocity above 100 = accent. MIDI passes through.
//
// SIGNAL FLOW: the voices > PAN > the stereo mix bus (soft drive) > the FX strip, in this order: PHASER > DRIVE > COMP >
//   DELAY (each with its IN key) > THICK > LEVEL > the house output stage (CLIP, -0.3 dBFS).
//
// DRIFT (0 - 100 %, 50 % = standard): a cheap stereo mixer that never quite sits still.
//   drive      how hard the voices hit the mix bus wanders slowly (+/- 3 dB around its light standard drive), so the
//              grit breathes
//   pan        each voice's place in the stereo field wanders slowly around its PAN (+/- 15 %), and each hit lands a
//              little to one side (+/- 5 %)
//   0 % = none (fixed drive, fixed pans), 100 % = twice the standard amount, a little faster.
//
// GUI: in the dress of the 34 series instruments (charcoal, sharp-cornered sections, knurled caps, lit keys). Click a
//   step to cycle off > hit > accent; drag to paint the same value along a row. Click a track name to hear it.
//   EDIT: clear or copy the pattern, or load a demo pattern. Values show while a knob is touched.
// PRESETS (12): kits - levels, pans, swing and FX, level-matched to Init on a groove; they never change the patterns.
//   EDIT > Load a demo pattern fills the current pattern with one of 9 starting points.
// Latency: 0 samples.
//
// TWEAK points are marked TWEAK.
// STATUS: Lab (experimental, may change). v0.2 (complete: sound engine, sequencer, FX strip, faceplate, presets).

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-thick.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-dyn.jsfx-inc

slider1:ac_lvl=50<0,100,1>-Accent (%)
slider2:lv_bd=80<0,100,1>-Bass level (%)
slider3:lv_sd=70<0,100,1>-Snare level (%)
slider4:lv_lt=65<0,100,1>-Lo Tom level (%)
slider5:lv_mt=65<0,100,1>-Mid Tom level (%)
slider6:lv_ht=65<0,100,1>-Hi Tom level (%)
slider7:lv_rs=60<0,100,1>-Rim level (%)
slider8:lv_cp=65<0,100,1>-Clap level (%)
slider9:lv_ch=60<0,100,1>-Cl Hat level (%)
slider10:lv_oh=60<0,100,1>-Op Hat level (%)
slider11:lv_cr=50<0,100,1>-Crash level (%)
slider12:lv_rd=50<0,100,1>-Ride level (%)
slider13:lv_lc=60<0,100,1>-Lo Conga level (%)
slider14:lv_hc=60<0,100,1>-Hi Conga level (%)
slider15:lv_ti=55<0,100,1>-Timbale level (%)
slider16:lv_lb=55<0,100,1>-Lo Bell level (%)
slider17:lv_hb=55<0,100,1>-Hi Bell level (%)
slider18:pn_bd=0<-100,100,1>-Bass pan
slider19:pn_sd=0<-100,100,1>-Snare pan
slider20:pn_lt=-40<-100,100,1>-Lo Tom pan
slider21:pn_mt=0<-100,100,1>-Mid Tom pan
slider22:pn_ht=40<-100,100,1>-Hi Tom pan
slider23:pn_rs=20<-100,100,1>-Rim pan
slider24:pn_cp=-10<-100,100,1>-Clap pan
slider25:pn_ch=30<-100,100,1>-Cl Hat pan
slider26:pn_oh=30<-100,100,1>-Op Hat pan
slider27:pn_cr=-30<-100,100,1>-Crash pan
slider28:pn_rd=35<-100,100,1>-Ride pan
slider29:pn_lc=-50<-100,100,1>-Lo Conga pan
slider30:pn_hc=50<-100,100,1>-Hi Conga pan
slider31:pn_ti=25<-100,100,1>-Timbale pan
slider32:pn_lb=-25<-100,100,1>-Lo Bell pan
slider33:pn_hb=20<-100,100,1>-Hi Bell pan
slider34:swing=0<0,100,1>-Swing (%)
slider35:m_lvl=0<-18,6,0.1>-Level (dB)
slider36:drift=50<0,100,1>-Drift (%)
slider37:thick=0<0,1,1{Off,On}>-Thick
slider38:ph_in=0<0,1,1{Out,In}>-Phaser in
slider39:ph_rate=0.4<0.05,5,0.01>-Phaser rate (Hz)
slider40:ph_dep=60<0,100,1>-Phaser depth (%)
slider41:ph_fb=40<0,90,1>-Phaser feedback (%)
slider42:ph_col=50<0,100,1>-Phaser colour (%)
slider43:dr_in=0<0,1,1{Out,In}>-Drive in
slider44:dr_amt=40<0,100,1>-Drive amount (%)
slider45:dr_tone=50<0,100,1>-Drive tone (%)
slider46:cm_in=0<0,1,1{Out,In}>-Comp in
slider47:cm_thr=-12<-40,0,0.1>-Comp threshold (dB)
slider48:cm_rat=4<1,20,0.1>-Comp ratio
slider49:cm_env=0<0,1,1{Fast,Slow}>-Comp envelope
slider50:cm_mk=0<0,20,0.1>-Comp make-up (dB)
slider51:dl_in=0<0,1,1{Out,In}>-Delay in
slider52:dl_sync=1<0,1,1{Free,Sync}>-Delay sync
slider53:dl_ms=300<20,1500,1>-Delay time (ms)
slider54:dl_div=3<0,6,1{1/32,1/16,1/16 dotted,1/8,1/8 dotted,1/4,1/4 dotted}>-Delay note
slider55:dl_fb=35<0,90,1>-Delay feedback (%)
slider56:dl_damp=40<0,100,1>-Delay damp (%)
slider57:dl_mix=25<0,100,1>-Delay mix (%)

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-lab-rs50";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1;  cur_pat = 0; );
ui_dflt = 1;
gfx_ext_retina = 1;
CR = 16;
NV = 16;                                   // tracks: BD SD LT MT HT RS CP CH OH CR RD LC HC TI LB HB
BR = 20000;                                // the baked sounds' sample clock

ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
thk_init();  thk_lift = 3.5;  thk_drv = 1.7;  thk_asym = 0.15;  thk_tr = 1.0;  thk_trim = 0;   // TWEAK: RS50's THICK

// ---------- memory ----------
SEQ = 100000;                              // [pattern][track][step]: 0 off, 1 hit, 2 accent (16 x 16 x 16)
LEN = 99000;                               // last step per pattern (1 .. 16)
QV = 98000;                                // this block's triggers: (offset, track, velocity) x 64
PQ = 97500;                                // the look-ahead queue: (absolute sample, track, velocity) x 128
PHL = 97100;  PHR = 97110;  memset(PHL, 0, 20);
DLB = 200000;  DRB = 600000;               // delay lines (2 s each, up to 192 kHz)
DSZ = floor(2 * srate) + 4;
BKP = 1190000;                             // bake scratch (partial states)
SNDT = 96500;                               // per sound: [base, length] x 16 (in track order)
VTR = 96600;                               // per sound: playback trim
PN = 96700;                                // per track: the pan now (drifting)
PDS = 96800;                               // per track: pan drift state (a, b, phase)
!seq_ok ? (
  memset(SEQ, 0, 16 * NV * 16);  i = 0;  loop(16, LEN[i] = 16;  i += 1; );
  i = 0;  loop(4, SEQ[(0 * NV + 0) * 16 + i * 4] = 2;  SEQ[(0 * NV + 7) * 16 + i * 4 + 2] = 1;  i += 1; );
  SEQ[(0 * NV + 1) * 16 + 4] = 1;  SEQ[(0 * NV + 1) * 16 + 12] = 1;
  seq_ok = 1;
);
memset(DLB, 0, DSZ);  memset(DRB, 0, DSZ);  dl_w = 0;

function db2g(d) ( exp(d * 0.11512925464970228); );
function ts(x) ( x = max(-3, min(3, x));  x * (27 + x * x) / (27 + 9 * x * x); );
function st(c) ( 2 ^ (c / 12); );
function svf_set(f, q) instance(g, k, a1, a2, a3) (
  g = tan($pi * min(f, 0.45 * srate) / srate);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;
);
function svf(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;  lp = v2;  bp = v1;  hp = x - k * v1 - v2;  bp;
);
function dck_set(last) instance(o) ( o += last; );
function dck(x) instance(o) ( o *= dk_c;  o * (abs(o) > 0.000001) + x; );

// ===================== the bake: every sound made once, at load (25 kHz, deterministic) =====================
function rng() local(t) ( t = lcg_s * 16807;  lcg_s = t - floor(t / 2147483647) * 2147483647;  lcg_s / 1073741823.5 - 1; );
function op(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * BR) / BR); );   // a one-pole coefficient at the bake clock
// a drum: a sine (and an optional second tone) sweeping down from (1 + sw) x, a click, band-passed noise; saturated
function bk_drum(dst, n_, f0, sw, ptau, atau, fb2, a2, clk, nlev, nhp, nlp, ntau) local(i, t, p1, p2, s, nz, l1, l2, c1, c2)
(
  p1 = p2 = l1 = l2 = 0;  c1 = op(nlp);  c2 = op(nhp);  i = 0;
  loop(n_, t = i / BR;
    p1 += f0 * (1 + sw * exp(-t / ptau)) / BR;  p1 -= floor(p1);
    p2 += fb2 * (1 + sw * 0.5 * exp(-t / ptau)) / BR;  p2 -= floor(p2);
    s = sin(2 * $pi * p1) * exp(-t / atau) + a2 * sin(2 * $pi * p2) * exp(-t / (atau * 0.6));
    nz = rng();  l1 += (nz - l1) * c1;  l2 += (l1 - l2) * c2;
    s += (l1 - l2) * nlev * exp(-t / ntau) + clk * exp(-t / 0.0009) * (0.6 + 0.4 * nz);
    dst[i] = ts(1.3 * s);  i += 1; );
);
function bk_svf(f, q) instance(g, k, a1, a2, a3, ic1, ic2) (
  g = tan($pi * min(f, 0.45 * BR) / BR);  k = 1 / q;  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  ic1 = ic2 = 0;
);
function bk_run(x) instance(g, k, a1, a2, a3, ic1, ic2, lp, bp, hp) local(v1, v2, v3) (
  v3 = x - ic2;  v1 = a1 * ic1 + a2 * v3;  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;  ic2 = 2 * v2 - ic2;  lp = v2;  bp = v1;  hp = x - k * v1 - v2;  bp;
);
// inharmonic partials (flo .. fhi Hz, decays tlo .. thi s, gain g) plus high-passed noise; added into dst
function bake_add(dst, n_, np, flo, fhi, tlo, thi, g, nlev, nhp, ntau) local(k, i, u, f, w, c, sn, s, nd, ne)
(
  k = 0;
  loop(np,
    u = (k + 0.5 + 0.4 * rng()) / np;  f = flo * (fhi / flo) ^ u;  w = 2 * $pi * f / BR;
    BKP[k] = cos(w);  BKP[64 + k] = sin(w);  u = $pi * (rng() + 1);  BKP[128 + k] = cos(u);  BKP[192 + k] = sin(u);
    BKP[256 + k] = g * (0.55 + 0.45 * rng()) / sqrt(np);  BKP[320 + k] = exp(-1 / (tlo * (thi / tlo) ^ (0.5 + 0.5 * rng()) * BR));
    k += 1; );
  BKN.bk_svf(nhp, 0.7);  nd = exp(-1 / (ntau * BR));  ne = 1;
  i = 0;
  loop(n_,
    s = 0;  k = 0;
    loop(np, c = BKP[128 + k];  sn = BKP[192 + k];
      BKP[128 + k] = c * BKP[k] - sn * BKP[64 + k];  BKP[192 + k] = c * BKP[64 + k] + sn * BKP[k];
      s += sn * BKP[256 + k];  BKP[256 + k] *= BKP[320 + k];  k += 1; );
    nlev > 0 ? ( BKN.bk_run(rng());  s += BKN.hp * nlev * ne;  ne *= nd; );
    dst[i] += s;  i += 1; );
);
// clap: band-passed noise in four quick bursts, then a tail
function bk_clap(dst, n_) local(i, t, b, e, tl, td) (
  BKC.bk_svf(1150, 2.2);  tl = 1;  td = exp(-1 / (0.11 * BR));  i = 0;
  loop(n_, t = i / BR;  b = floor(t / 0.0105);
    e = b < 3 ? exp(-(t - b * 0.0105) / 0.0045) : 0;  b >= 3 ? tl *= td;
    BKC.bk_run(rng());  dst[i] = BKC.bp * (e + (b >= 3 ? tl : 0)) * 2.2;  i += 1; );
);
// cowbell: two band-limited squares (f1 / f2 Hz) through a band-pass; a quick drop, then a longer fade
function blep(t, dt) ( t < dt ? ( t /= dt;  t + t - t * t - 1; ) : t > 1 - dt ? ( t = (t - 1) / dt;  t * t + t + t + 1; ) : 0; );
function sqr_(p, dt) local(q) ( q = p + 0.5;  q -= floor(q);  (p < 0.5 ? 1 : -1) + blep(p, dt) - blep(q, dt); );
function bk_cb(dst, n_, fa, fb, fbp) local(i, t, p1, p2, d1, d2, s) (
  BKC.bk_svf(fbp, 1.4);  p1 = p2 = 0;  d1 = fa / BR;  d2 = fb / BR;  i = 0;
  loop(n_, t = i / BR;  p1 += d1;  p1 -= floor(p1);  p2 += d2;  p2 -= floor(p2);
    s = (sqr_(p1, d1) + sqr_(p2, d2)) * 0.5;
    BKC.bk_run(s);  dst[i] = BKC.bp * (0.7 * exp(-t / 0.012) + 0.3 * exp(-t / 0.22)) * 1.6;  i += 1; );
);
// finish: attack ramp, end fade, normalise; 8-bit mu-law (bits = 8) or 6-bit companded (bits = 6)
function bk_fin(dst, n_, att, bits) local(i, pk, y, e) (
  pk = 0.000001;  i = 0;
  loop(n_, e = min(1, i / (att * BR + 1)) * min(1, (n_ - i) / (0.06 * n_));  dst[i] *= e;  pk = max(pk, abs(dst[i]));  i += 1; );
  i = 0;
  loop(n_, y = dst[i] / pk;
    bits == 8 ? ( y = sign(y) * log(1 + 255 * abs(y)) / log(256);  y = floor(y * 127 + 0.5) / 127;
                  y = sign(y) * (256 ^ abs(y) - 1) / 255; )
              : ( y = sign(y) * sqr(floor(sqrt(abs(y)) * 31 + 0.5) / 31); );
    dst[i] = y;  i += 1; );
);
function slot(k, n_) ( SNDT[k * 2] = bptr;  SNDT[k * 2 + 1] = n_;  memset(bptr, 0, n_);  bptr += n_ + 64;  bptr - n_ - 64; );
lcg_s = 50505;
bptr = 1200000;
b = slot(0, 10000);   bk_drum(b, 10000, 58, 2.4, 0.01, 0.18, 0, 0, 0.7, 0.05, 200, 3000, 0.01);         bk_fin(b, 10000, 0, 8);
b = slot(1, 6000);    bk_drum(b, 6000, 205, 0.5, 0.01, 0.07, 350, 0.6, 0.3, 1.2, 1800, 8500, 0.1);       bk_fin(b, 6000, 0, 8);
b = slot(2, 10000);   bk_drum(b, 10000, 95, 0.6, 0.05, 0.22, 0, 0, 0.2, 0.12, 200, 2000, 0.03);          bk_fin(b, 10000, 0, 8);
b = slot(3, 10000);   bk_drum(b, 10000, 140, 0.6, 0.045, 0.2, 0, 0, 0.2, 0.12, 250, 2500, 0.03);         bk_fin(b, 10000, 0, 8);
b = slot(4, 10000);   bk_drum(b, 10000, 200, 0.6, 0.04, 0.18, 0, 0, 0.2, 0.12, 300, 3000, 0.03);         bk_fin(b, 10000, 0, 8);
b = slot(5, 1600);    bk_drum(b, 1600, 520, 0, 0.01, 0.01, 1650, 1.4, 0.3, 0.2, 2000, 7000, 0.005);      bk_fin(b, 1600, 0, 8);
b = slot(6, 8000);    bk_clap(b, 8000);                                                                    bk_fin(b, 8000, 0, 8);
b = slot(7, 4000);    bake_add(b, 4000, 12, 5500, 9500, 0.02, 0.05, 1, 0.9, 6000, 0.04);                  bk_fin(b, 4000, 0.0004, 6);
b = slot(8, 12000);   bake_add(b, 12000, 14, 4500, 9500, 0.2, 0.4, 1, 0.7, 6000, 0.3);                    bk_fin(b, 12000, 0.0008, 6);
b = slot(9, 24000);   bake_add(b, 24000, 22, 2800, 9500, 0.4, 0.9, 1, 0.9, 3200, 0.7);                    bk_fin(b, 24000, 0.004, 6);
b = slot(10, 24000);  bake_add(b, 24000, 6, 620, 3200, 0.8, 1.3, 1.4, 0, 1000, 1);
                      bake_add(b, 24000, 18, 3400, 9500, 0.5, 1.0, 1, 0.3, 4800, 0.8);                    bk_fin(b, 24000, 0.001, 6);
b = slot(11, 7000);   bk_drum(b, 7000, 185, 0.25, 0.015, 0.12, 0, 0, 0.4, 0.04, 1000, 5000, 0.01);       bk_fin(b, 7000, 0, 8);
b = slot(12, 6000);   bk_drum(b, 6000, 280, 0.25, 0.012, 0.1, 0, 0, 0.4, 0.04, 1200, 6000, 0.01);        bk_fin(b, 6000, 0, 8);
b = slot(13, 8000);   bk_drum(b, 8000, 440, 0.1, 0.01, 0.16, 1250, 0.5, 0.6, 0.15, 2000, 8000, 0.03);
                      bake_add(b, 8000, 4, 900, 2600, 0.12, 0.2, 0.5, 0, 1000, 1);                         bk_fin(b, 8000, 0, 8);
b = slot(14, 7000);   bk_cb(b, 7000, 420, 630, 2000);                                                      bk_fin(b, 7000, 0, 8);
b = slot(15, 7000);   bk_cb(b, 7000, 560, 840, 2650);                                                      bk_fin(b, 7000, 0, 8);
// playback trims (level balance between the sounds; TWEAK)
i = 0;  loop(16, VTR[i] = 1;  i += 1; );
VTR[7] = 1.3;  VTR[8] = 1.3;  VTR[9] = 1.6;  VTR[10] = 1.6;  VTR[13] = 1.2;  VTR[14] = 1.2;  VTR[15] = 1.2;

// the voices: read a baked sound at its rate (interpolated), with the declick offset; a choke fades it in 3 ms.
// gl / gr: the hit's place in the stereo field (equal power, fixed for the hit)
function v_trig(k, v, r, p) instance(pos, a, chk, act, out, base, n_, rate, gl, gr) (
  this.dck_set(out);  pos = 0;  a = v * VTR[k];  chk = 0;  act = 1;  base = SNDT[k * 2];  n_ = SNDT[k * 2 + 1];  rate = r;
  p = max(-1, min(1, p));  gl = cos((p + 1) * $pi * 0.25) * 0.7071;  gr = sin((p + 1) * $pi * 0.25) * 0.7071;
);
function v_proc() instance(pos, a, chk, act, out, base, n_, rate) local(i, f) (
  act ? (
    i = floor(pos);  f = pos - i;
    i < n_ - 1 ? (
      out = (base[i] + (base[i + 1] - base[i]) * f) * a;  chk ? a *= choke_c;  pos += rate;
      a < 0.00002 ? act = 0;
    ) : ( act = 0;  out = 0; );
  ) : out = 0;
  this.dck(out);
);
// a slow, smooth random wander per track (memory-based: a, b, phase), -1 .. +1
function pdrift(k, inc) local(s, ph) (
  s = PDS + k * 3;  ph = s[2] + inc;
  ph >= 1 ? ( ph -= 1;  s[0] = s[1];  s[1] = rand(2) - 1; );
  s[2] = ph;  s[0] + (s[1] - s[0]) * (0.5 - 0.5 * cos($pi * ph));
);
// the delay's tap at t samples back (interpolated) -> dr_l, dr_r (audio thread only)
function dl_read(t) local(rp, ri, ri2, f) (
  rp = dl_w - t;  rp < 0 ? rp += DSZ;  ri = floor(rp);  f = rp - ri;  ri2 = ri + 1;  ri2 >= DSZ ? ri2 = 0;
  dr_l = DLB[ri] + (DLB[ri2] - DLB[ri]) * f;  dr_r = DRB[ri] + (DRB[ri2] - DRB[ri]) * f;
);
// ---------- parameters -> engine values (audio thread) ----------
function update_params() (
  drift_macro(drift);
  swing_k = swing / 100 / 3;
  t_mlvl = m_lvl;
  t_ph = ph_in >= 0.5;  t_dr = dr_in >= 0.5;  t_cm = cm_in >= 0.5;  t_dl = dl_in >= 0.5;
  ph_lo = 150 * 4 ^ (ph_col / 100);  ph_hi = ph_lo * (2 + 18 * ph_dep / 100);
  dr_k = 1 + 15 * sqr(dr_amt / 100);  dr_L = 20 * log10(dr_k);  dr_mk = db2g(-0.9 * dr_L + 0.0108 * dr_L * dr_L);   // level match
  DTL.svf_set(2500 * 8 ^ (dr_tone / 100), 0.6);  DTR.svf_set(2500 * 8 ^ (dr_tone / 100), 0.6);
  cm_at = cm_env >= 0.5 ? 0.012 : 0.0015;  cm_rt = cm_env >= 0.5 ? 0.35 : 0.08;
  cm_atc = 1 - exp(-CR / (cm_at * srate));  cm_rtc = 1 - exp(-CR / (cm_rt * srate));
  dl_lpc = 1 - exp(-2 * $pi * (12000 * 0.1 ^ (dl_damp / 100)) / srate);
);

DDRV.drift_init(0.5 + rand(0.3));
i = 0;  loop(16, PDS[i * 3] = rand(2) - 1;  PDS[i * 3 + 1] = rand(2) - 1;  PDS[i * 3 + 2] = rand(1);  PN[i] = slider(18 + i) / 100;  i += 1; );
dk_c = exp(-1 / (0.002 * srate));
choke_c = exp(-1 / (0.003 * srate));
sm_c = 1 - exp(-CR / (0.03 * srate));
sw_c = 1 - exp(-1 / (0.012 * srate));
dl_xfc = 1 / (0.03 * srate);  dl_xf_on = 0;
update_params();
s_mlvl = t_mlvl;  m_g = db2g(s_mlvl);  m_i = 0;
s_plo = ph_lo;  s_phi = ph_hi;  s_pfb = ph_fb / 100;  s_dfb = dl_fb / 100;  s_dmix = dl_mix / 100 * 1.4;  s_drk = dr_k;  s_drmk = dr_mk;
m_ph = t_ph;  m_dr = t_dr;  m_cm = t_cm;  m_dl = t_dl;
run = 0;  q_n = 0;  pq_n = 0;  abs_n = 0;  seq_next = 0;  lfo = 0;  cm_g = 1;  cm_env_v = 0;  s_dt = 0.3 * srate;
cr_n = 0;  pending_pat = -1;  pat_sel_d = pat_req_last = cur_pat;
s_drv = db2g(5);
#pmenu = "Init|Latin Groove|Electro Pop|Bedroom Demo|Wide Stereo|Mono Club|Funk Shuffle|Dub Bells|Crunchy|Soft and Round|Disco Cowbell|Clean Machine";

@slider
update_params();

@block
update_params();
aud_n_d != aud_seen ? ( aud_seen = aud_n_d;  QV[0] = 0;  QV[1] = aud_t_d;  QV[2] = 1;  aud_q = 1; ) : aud_q = 0;
op_disp = op_acc;  op_acc = 0;  gr_disp = cm_gd * (m_cm > 0.5);
bdt = samplesblock / srate;
// ---------- drift: the mix bus drive, the pans ----------
dsp = 0.03 * dm_s * bdt;
drv_db = 5 + 3 * dm_a * DDRV.drift_tick(dsp);                              // TWEAK: the bus drive (dB into the soft clipper)
p_base = BR / srate;
k = 0;  loop(16, PN[k] = slider(18 + k) / 100 + 0.15 * dm_a * pdrift(k, dsp * (0.8 + 0.03 * k));  k += 1; );
OFL.svf_set(9000, 0.7);  OFR.svf_set(9000, 0.7);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);                                   // house output stage: CLIP
dl_t = dl_sync >= 0.5 ? (dl_div < 0.5 ? 0.125 : dl_div < 1.5 ? 0.25 : dl_div < 2.5 ? 0.375 : dl_div < 3.5 ? 0.5 :
                          dl_div < 4.5 ? 0.75 : dl_div < 5.5 ? 1 : 1.5) * 60 / max(tempo, 20) : dl_ms / 1000;
dl_ts = min(DSZ - 4, dl_t * srate);

// ---------- MIDI in ----------
q_n = aud_q;
while (midirecv(mo, m1, m2, m3)) (
  (m1 & 0xF0) == 0x90 && m3 > 0 && q_n < 64 ? (
    tr = m2 == 36 || m2 == 35 ? 0 : m2 == 38 || m2 == 40 ? 1 : m2 == 41 || m2 == 43 ? 2 : m2 == 45 || m2 == 47 ? 3 :
         m2 == 48 || m2 == 50 ? 4 : m2 == 37 ? 5 : m2 == 39 ? 6 : m2 == 42 || m2 == 44 ? 7 : m2 == 46 ? 8 :
         m2 == 49 || m2 == 57 ? 9 : m2 == 51 || m2 == 59 ? 10 : m2 == 64 ? 11 : m2 == 63 || m2 == 62 ? 12 :
         m2 == 65 || m2 == 66 ? 13 : m2 == 68 ? 14 : m2 == 56 ? 15 : -1;
    tr >= 0 ? ( QV[q_n * 3] = mo;  QV[q_n * 3 + 1] = tr;  QV[q_n * 3 + 2] = m3 > 100 ? 2 : 1;  q_n += 1; );
  );
  midisend(mo, m1, m2, m3);
);
// ---------- the sequencer: a few ms ahead, into the look-ahead queue ----------
pat_sel_d != pat_req_last ? ( pat_req_last = pat_sel_d;  run ? pending_pat = pat_sel_d : cur_pat = pat_sel_d; );
run_req != run ? ( run = run_req;  pq_n = 0;  run ? ( free_pos = 0;  seq_next = 0;  next_t = 0; ); );
hum = 0;                                                                  // (RS50 keeps strict time)
run ? (
  spb = 60 / max(tempo, 20) * srate / 4;
  la = 0.006 * srate / spb;                                               // the look-ahead, in steps
  (play_state & 1) ? (
    pos0 = beat_position * 4;
    abs(pos0 - exp_pos) > 0.5 || !was_play ? ( seq_next = ceil(pos0 - 0.0001);  next_t = seq_next + (seq_next % 2 ? swing_k : 0);  pq_n = 0; );
    was_play = 1;
  ) : (
    was_play ? free_pos = exp_pos;
    pos0 = free_pos;  was_play = 0;
  );
  pos1 = pos0 + samplesblock / spb;
  while (next_t < pos1 + la && pq_n < 120) (
    t_ev = abs_n + max(0, (next_t - pos0) * spb + (rand(2) - 1) * hum);
    stp = seq_next % 16;
    stp == 0 && pending_pat >= 0 ? ( cur_pat = pending_pat;  pending_pat = -1; );
    ln = max(1, LEN[cur_pat]);
    stp_in = seq_next % ln;
    i = 0;
    loop(NV, vv = SEQ[(cur_pat * NV + i) * 16 + stp_in];
      vv > 0 && pq_n < 120 ? ( PQ[pq_n * 3] = t_ev + (rand(2) - 1) * hum * 0.3;  PQ[pq_n * 3 + 1] = i;  PQ[pq_n * 3 + 2] = vv;  pq_n += 1; );
      i += 1; );
    PQ[pq_n * 3] = t_ev;  PQ[pq_n * 3 + 1] = -1 - stp_in;  PQ[pq_n * 3 + 2] = 0;  pq_n += 1;   // the step light
    seq_next += 1;  next_t = seq_next + (seq_next % 2 ? swing_k : 0);
  );
  free_pos = pos1;  exp_pos = pos1;
) : ( step_disp = -1;  was_play = 0; );
// due events -> this block's trigger list
k = 0;  j = 0;
while (k < pq_n) (
  PQ[k * 3] < abs_n + samplesblock ? (
    PQ[k * 3 + 1] < 0 ? step_disp = -1 - PQ[k * 3 + 1] : q_n < 64 ? (
      QV[q_n * 3] = max(0, floor(PQ[k * 3] - abs_n));  QV[q_n * 3 + 1] = PQ[k * 3 + 1];  QV[q_n * 3 + 2] = PQ[k * 3 + 2];  q_n += 1; );
  ) : (
    PQ[j * 3] = PQ[k * 3];  PQ[j * 3 + 1] = PQ[k * 3 + 1];  PQ[j * 3 + 2] = PQ[k * 3 + 2];  j += 1;
  );
  k += 1;
);
pq_n = j;
// trigger list in time order (a few at most: insertion sort)
k = 1;
while (k < q_n) ( j = k;
  while (j > 0 && QV[(j - 1) * 3] > QV[j * 3]) (
    t0 = QV[j * 3];  t1 = QV[j * 3 + 1];  t2 = QV[j * 3 + 2];
    QV[j * 3] = QV[(j - 1) * 3];  QV[j * 3 + 1] = QV[(j - 1) * 3 + 1];  QV[j * 3 + 2] = QV[(j - 1) * 3 + 2];
    QV[(j - 1) * 3] = t0;  QV[(j - 1) * 3 + 1] = t1;  QV[(j - 1) * 3 + 2] = t2;  j -= 1; );
  k += 1; );
abs_n += samplesblock;
q_i = 0;  smp = 0;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_var(0, cur_pat);
file_mem(0, SEQ, 16 * NV * 16);
file_mem(0, LEN, 16);
file_var(0, seq_ok);

@sample
// ---------- fire this sample's triggers ----------
while (q_i < q_n && QV[q_i * 3] <= smp) (
  tr = QV[q_i * 3 + 1];  vel = QV[q_i * 3 + 2] > 1.5 ? 1 + 0.9 * ac_lvl / 100 : 1;
  k = tr;
  k == 7 ? VC8.chk = 1;                                                     // CH chokes OH
  p_hit = PN[k] + 0.05 * dm_a * (rand(2) - 1);
  k == 0 ? VC0.v_trig(0, vel * sqr(slider(2) / 100), p_base, p_hit);
  k == 1 ? VC1.v_trig(1, vel * sqr(slider(3) / 100), p_base, p_hit);
  k == 2 ? VC2.v_trig(2, vel * sqr(slider(4) / 100), p_base, p_hit);
  k == 3 ? VC3.v_trig(3, vel * sqr(slider(5) / 100), p_base, p_hit);
  k == 4 ? VC4.v_trig(4, vel * sqr(slider(6) / 100), p_base, p_hit);
  k == 5 ? VC5.v_trig(5, vel * sqr(slider(7) / 100), p_base, p_hit);
  k == 6 ? VC6.v_trig(6, vel * sqr(slider(8) / 100), p_base, p_hit);
  k == 7 ? VC7.v_trig(7, vel * sqr(slider(9) / 100), p_base, p_hit);
  k == 8 ? VC8.v_trig(8, vel * sqr(slider(10) / 100), p_base, p_hit);
  k == 9 ? VC9.v_trig(9, vel * sqr(slider(11) / 100), p_base, p_hit);
  k == 10 ? VC10.v_trig(10, vel * sqr(slider(12) / 100), p_base, p_hit);
  k == 11 ? VC11.v_trig(11, vel * sqr(slider(13) / 100), p_base, p_hit);
  k == 12 ? VC12.v_trig(12, vel * sqr(slider(14) / 100), p_base, p_hit);
  k == 13 ? VC13.v_trig(13, vel * sqr(slider(15) / 100), p_base, p_hit);
  k == 14 ? VC14.v_trig(14, vel * sqr(slider(16) / 100), p_base, p_hit);
  k == 15 ? VC15.v_trig(15, vel * sqr(slider(17) / 100), p_base, p_hit);
  q_i += 1;
);
smp += 1;

// ---------- control rate ----------
cr_n <= 0 ? (
  cr_n = CR;
  s_mlvl += (t_mlvl - s_mlvl) * sm_c;  m_i = (db2g(s_mlvl) - m_g) / CR;
  s_pfb += (ph_fb / 100 - s_pfb) * sm_c;  s_dfb += (dl_fb / 100 - s_dfb) * sm_c;  s_dmix += (dl_mix / 100 * 1.4 - s_dmix) * sm_c;
  s_drk += (dr_k - s_drk) * sm_c;  s_drmk += (dr_mk - s_drmk) * sm_c;
  lfo += CR * ph_rate / srate;  lfo -= floor(lfo);
  s_plo += (ph_lo - s_plo) * sm_c;  s_phi += (ph_hi - s_phi) * sm_c;          // the sweep range glides too
  fl = s_plo * (s_phi / s_plo) ^ (0.5 - 0.5 * cos(2 * $pi * lfo));
  fr = s_plo * (s_phi / s_plo) ^ (0.5 - 0.5 * cos(2 * $pi * (lfo + 0.25)));
  tl = tan($pi * min(fl, 0.45 * srate) / srate);  ph_al = (tl - 1) / (tl + 1);
  tr_ = tan($pi * min(fr, 0.45 * srate) / srate);  ph_ar = (tr_ - 1) / (tr_ + 1);
  cm_lv = 10 * log10(cm_env_v + 0.000000000001);
  cm_ov = cm_lv - cm_thr;
  cm_tg = cm_ov <= -2 ? 0 : cm_ov < 2 ? -(1 - 1 / cm_rat) * sqr(cm_ov + 2) / 8 : -(1 - 1 / cm_rat) * cm_ov;
  cm_gd += (cm_tg - cm_gd) * (cm_tg < cm_gd ? cm_atc : cm_rtc);
  cm_gi = (db2g(cm_gd + cm_mk) - cm_g) / CR;
);
cr_n -= 1;
m_g += m_i;  cm_g += cm_gi;
m_ph += (t_ph - m_ph) * sw_c;  m_dr += (t_dr - m_dr) * sw_c;  m_cm += (t_cm - m_cm) * sw_c;  m_dl += (t_dl - m_dl) * sw_c;

// ---------- the voices > PAN > the converter filter > the mix bus (soft drive) ----------
mxl = mxr = 0;
v_ = VC0.v_proc();  mxl += v_ * VC0.gl;  mxr += v_ * VC0.gr;
v_ = VC1.v_proc();  mxl += v_ * VC1.gl;  mxr += v_ * VC1.gr;
v_ = VC2.v_proc();  mxl += v_ * VC2.gl;  mxr += v_ * VC2.gr;
v_ = VC3.v_proc();  mxl += v_ * VC3.gl;  mxr += v_ * VC3.gr;
v_ = VC4.v_proc();  mxl += v_ * VC4.gl;  mxr += v_ * VC4.gr;
v_ = VC5.v_proc();  mxl += v_ * VC5.gl;  mxr += v_ * VC5.gr;
v_ = VC6.v_proc();  mxl += v_ * VC6.gl;  mxr += v_ * VC6.gr;
v_ = VC7.v_proc();  mxl += v_ * VC7.gl;  mxr += v_ * VC7.gr;
v_ = VC8.v_proc();  mxl += v_ * VC8.gl;  mxr += v_ * VC8.gr;
v_ = VC9.v_proc();  mxl += v_ * VC9.gl;  mxr += v_ * VC9.gr;
v_ = VC10.v_proc();  mxl += v_ * VC10.gl;  mxr += v_ * VC10.gr;
v_ = VC11.v_proc();  mxl += v_ * VC11.gl;  mxr += v_ * VC11.gr;
v_ = VC12.v_proc();  mxl += v_ * VC12.gl;  mxr += v_ * VC12.gr;
v_ = VC13.v_proc();  mxl += v_ * VC13.gl;  mxr += v_ * VC13.gr;
v_ = VC14.v_proc();  mxl += v_ * VC14.gl;  mxr += v_ * VC14.gr;
v_ = VC15.v_proc();  mxl += v_ * VC15.gl;  mxr += v_ * VC15.gr;
OFL.svf(mxl);  OFR.svf(mxr);
s_drv += (db2g(drv_db) - s_drv) * 0.0005;                                  // the drive glides
xl = ts(OFL.lp * s_drv) / s_drv;  xr = ts(OFR.lp * s_drv) / s_drv;         // small-signal gain 1: a light, even grit

// ---------- FX strip: PHASER > DRIVE > COMP > DELAY ----------
m_ph > 0.00001 ? (
  yl = xl + ph_fbl * s_pfb;  yr = xr + ph_fbr * s_pfb;
  k_ = 0;
  loop(6,
    a_ = PHL[k_];  b_ = ph_al * yl + a_;  PHL[k_] = yl - ph_al * b_;  yl = b_;
    a_ = PHR[k_];  b_ = ph_ar * yr + a_;  PHR[k_] = yr - ph_ar * b_;  yr = b_;
    k_ += 1; );
  ph_fbl = yl;  ph_fbr = yr;
  xl += ((xl + yl) * 0.5 - xl) * m_ph;  xr += ((xr + yr) * 0.5 - xr) * m_ph;
);
m_dr > 0.00001 ? (
  ul = xl * s_drk;  ur = xr * s_drk;
  F1 = sqrt(1 + ul * ul);  F2 = sqrt(1 + ur * ur);
  yl = abs(ul - dr_xl) > 0.00001 ? (F1 - dr_Fl) / (ul - dr_xl) : (ul + dr_xl) * 0.5 / sqrt(1 + sqr((ul + dr_xl) * 0.5));
  yr = abs(ur - dr_xr) > 0.00001 ? (F2 - dr_Fr) / (ur - dr_xr) : (ur + dr_xr) * 0.5 / sqrt(1 + sqr((ur + dr_xr) * 0.5));
  dr_xl = ul;  dr_xr = ur;  dr_Fl = F1;  dr_Fr = F2;
  DTL.svf(yl);  yl = DTL.lp;  DTR.svf(yr);  yr = DTR.lp;
  yl *= s_drmk;  yr *= s_drmk;
  xl += (yl - xl) * m_dr;  xr += (yr - xr) * m_dr;
) : ( dr_xl = xl * s_drk;  dr_xr = xr * s_drk;  dr_Fl = sqrt(1 + dr_xl * dr_xl);  dr_Fr = sqrt(1 + dr_xr * dr_xr); );
m_cm > 0.00001 ? (
  pk_ = max(abs(xl), abs(xr));  cm_env_v += (pk_ * pk_ - cm_env_v) * (pk_ * pk_ > cm_env_v ? 0.2 : 0.002);
  xl += (xl * cm_g - xl) * m_cm;  xr += (xr * cm_g - xr) * m_cm;
);
m_dl > 0.00001 || dl_tail > 0 ? (
  // a new delay time crossfades to the new tap over 30 ms (no tape-chirp, no zipper)
  !dl_xf_on && abs(dl_ts - s_dt) > 0.5 ? ( dl_tb = dl_ts;  dl_xf = 0;  dl_xf_on = 1; );
  dl_read(s_dt);  el = dr_l;  er = dr_r;
  dl_xf_on ? (
    dl_read(dl_tb);  dl_xf = min(1, dl_xf + dl_xfc);
    el += (dr_l - el) * dl_xf;  er += (dr_r - er) * dl_xf;
    dl_xf >= 1 ? ( s_dt = dl_tb;  dl_xf_on = 0; );
  );
  dl_ll += (el - dl_ll) * dl_lpc;  dl_lr += (er - dl_lr) * dl_lpc;
  DLB[dl_w] = xl * m_dl + ts(dl_ll * s_dfb);  DRB[dl_w] = xr * m_dl + ts(dl_lr * s_dfb);
  dl_w += 1;  dl_w >= DSZ ? dl_w = 0;
  xl += el * s_dmix;  xr += er * s_dmix;
  dl_tail = abs(el) + abs(er) > 0.000001 ? 1 : m_dl > 0.00001;
);

// ---------- THICK, LEVEL, the house output stage ----------
thk_proc(xl, xr, thick >= 0.5);  xl = thk_l;  xr = thk_r;
xl *= m_g;  xr *= m_g;
xl = ostL.ost_band(xl);  xr = ostR.ost_band(xr);
ost_out(xl, xr);
spl0 = ost_l;  spl1 = ost_r;
op_acc = max(op_acc, max(abs(spl0), abs(spl1)));

@gfx 1200 820
ui_begin(1200, 820);
// =====================================================================
// GUI - in the 34 series manner (the BEL34 / CLV34 / SHK34 instruments): charcoal, sharp-cornered sections, small
// knurled knobs with a tick ring, lit keys; RS50's own colour is a warm beige. Design space 1200 x 820.
// =====================================================================
KRP = 0x2E2F31;  KRF = 0x202123;  KRI = 0xF3EAD6;  KRA = 0xDCC7A2;  KRW = 0x121314;  KRM = 0x55575A;
KRC = 0xDCC7A2;  KRPT = 0x1E1408;  KRCN = 0xDCC7A2;  KRGH = 0x2E2B27;  KRAMB = 0xFFD24A;  KRRED = 0xFF3B1F;  KRKT = 0x1E1408;
KRH = ui_mix(KRP, 0x000000, 0.35);  KRI2 = ui_mix(KRI, KRF, 0.35);
LIT_IN = 0xF2A41E;  LIT_MODE = 0xF0C030;                   // IN keys amber, mode keys yellow (house rule)
gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');
gfx_setfont(10, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');
gfx_setfont(13, "Trebuchet MS", 12 * sc, 'b');
gfx_setfont(14, "Trebuchet MS", 15 * sc, 'b');

function kr_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function kr_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function kr_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function kr_lbl(x, y, s) ( gfx_setfont(11); ui_col(KRI2); kr_txt(x, y, s); );
function kr_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
function kr_thick(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, k) (       // (drawn here: works with any system files)
  dx = x2 - x1; dy = y2 - y1; l = max(sqrt(dx * dx + dy * dy), 0.001); nx = -dy / l; ny = dx / l;
  k = -0.5 * w; loop(floor(w * 2.5) + 1, gfx_line(x1 + nx * k, y1 + ny * k, x2 + nx * k, y2 + ny * k, 1); k += 0.4; );
);
function kr_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = kr_hov(x, y, w, h); hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  ui_col(0x050505); kr_r(x, y, w, h);
  on ? ui_col(KRA) : ui_col(hov ? ui_mix(KRP, 0xFFFFFF, 0.14) : ui_mix(KRP, 0xFFFFFF, 0.07)); kr_r(x + 1, y + 1, w - 2, h - 2);
  on ? ( ui_cola(KRA, 0.25); kr_r(x - 2, y - 2, w + 4, h + 4); ui_cola(0xFFFFFF, 0.3); kr_r(x + 1, y + 1, w - 2, 1); );
  on ? ui_col(KRKT) : ui_col(KRI);
  gfx_setfont(12); kr_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);
function kr_dim(x, y, w, h, lbl) ( ui_col(0x050505); kr_r(x, y, w, h); ui_col(ui_mix(KRF, KRP, 0.3)); kr_r(x + 1, y + 1, w - 2, h - 2);
  ui_col(ui_mix(KRI, KRF, 0.75)); gfx_setfont(12); kr_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl); 0; );
function kr_sect(x, y, w, h, name) (
  ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRF); kr_r(x + 1, y + 1, w - 2, h - 2);
  strlen(name) ? kr_lbl(x + 9, y + 6, name);
);
function kr_scale(cx, cy, r, n, nr, labels, minor) local(i, k, k0, len, c, a, ca, sa, m) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  minor > 0 ? (
    m = 0; ui_col(KRI2);
    loop((n - 1) * minor + 1,
      a = -0.75 * $pi + m / ((n - 1) * minor) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 6)) * sc, (cy + sa * (r + 6)) * sc, 1);
      m += 1;
    );
  );
  gfx_setfont(10);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#krv_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi; ca = sin(a); sa = -cos(a);
      ui_col(KRI);
      gfx_line((cx + ca * (r + 3)) * sc, (cy + sa * (r + 3)) * sc, (cx + ca * (r + 7)) * sc, (cy + sa * (r + 7)) * sc, 1);
      strlen(#krv_sl) ? kr_ctxt(cx + ca * (r + nr), cy + sa * (r + nr), #krv_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
function kr_bake(cx, cy, r, a) local(i, t, ca, sa, k) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.55); gfx_circle(cx + 2.5 * sc, cy + 4.5 * sc, r * 1.02, 1, 1);
  ui_col(0x0A0A0A); gfx_circle(cx, cy, r + 1 * sc, 1, 1);
  ui_col(0x191817); gfx_circle(cx, cy, r, 1, 1);
  i = 0;
  loop(16,
    t = i / 16 * 2 * $pi; k = 0.5 + 0.5 * cos(t + 0.8);
    ui_col(ui_mix(0x0D0C0B, 0x48443F, k * 0.8)); gfx_circle(cx + sin(t) * r * 0.86, cy - cos(t) * r * 0.86, r * 0.15, 1, 1);
    ui_col(0x0D0C0B); gfx_circle(cx + sin(t + 0.196) * r * 0.9, cy - cos(t + 0.196) * r * 0.9, r * 0.075, 1, 1);
    i += 1;
  );
  ui_col(0x090808); gfx_circle(cx, cy, r * 0.70 + 1 * sc, 1, 1);
  ui_col(0x22201E); gfx_circle(cx, cy, r * 0.70, 1, 1);
  ui_cola(0xFFFFFF, 0.08); gfx_circle(cx, cy, r * 0.70, 0, 1);
  ui_col(0x060606); kr_thick(cx + ca * r * 0.18, cy + sa * r * 0.18, cx + ca * r * 0.98, cy + sa * r * 0.98, 4.2 * sc);
  ui_col(KRA); kr_thick(cx + ca * r * 0.22, cy + sa * r * 0.22, cx + ca * r * 0.95, cy + sa * r * 0.95, 2.5 * sc);
);
function kr_scap(cx, cy, r, a, cap) local(ca, sa, k, pc) (
  ca = sin(a); sa = -cos(a);
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 2.5 * sc, r, 1, 1);
  ui_col(0x121212); gfx_circle(cx, cy, r, 1, 1);
  ui_cola(0xFFFFFF, 0.12); gfx_circle(cx, cy, r, 0, 1);
  k = r * 0.74;
  ui_col(cap); gfx_circle(cx, cy, k, 1, 1);
  ui_col(ui_mix(cap, 0x000000, 0.35)); gfx_circle(cx, cy, k, 0, 1);
  pc = (cap & 255) + ((cap >> 8) & 255) + ((cap >> 16) & 255) > 380 ? KRPT : 0xF4F0E6;
  ui_col(pc); kr_thick(cx + ca * k * 0.2, cy + sa * k * 0.2, cx + ca * r * 0.94, cy + sa * r * 0.94, 2.6 * sc);
);
krv_small = 0; krv_lg = 0; krv_step = 0; krv_cap = 0;
function kr_kn(v, lo, hi) ( krv_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function kr_kv(n, lo, hi) ( krv_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
function kr_knob(cx, cy, r, idx, lo, hi, def) local(v, n, dx, dy, hov, did) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - krv_lt < 0.35 && krv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; krv_lt = 0; ) : (
      drag_id = did; krv_y = mouse_y; krv_lt = time_precise(); krv_lid = idx; krv_n = kr_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    krv_n = min(max(krv_n + (krv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : (krv_step ? 160 : 240)) * sc), 0), 1); krv_y = mouse_y;
    v = kr_kv(krv_n, lo, hi); krv_step ? v = floor(v + 0.5);
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    krv_step ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(kr_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
      slider(idx) = kr_kv(n, lo, hi);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(kr_kn(v, lo, hi), 0), 1);
  krv_small ? kr_scap(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi, krv_cap ? krv_cap : KRC) : kr_bake(cx * sc, cy * sc, r * sc, -0.75 * $pi + n * 1.5 * $pi);
  hov || drag_id == did ? ( ui_cola(0xFFFFFF, 0.07); gfx_circle(cx * sc, cy * sc, (r + 2) * sc, 1, 1); );
  hov || drag_id == did;
);
function kr_name(cx, cy, act, name, val) ( gfx_setfont(14); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy, act ? val : name); );
// a small knob with a tick ring (or n step ticks) and its name; the value while touched
function kr_small(cx, cy, r, idx, lo, hi, def, nt, name, val) local(i, t, act) (
  ui_cola(KRI, 0.85); i = 0;
  loop(nt, t = -0.75 * $pi + i / (nt - 1) * 1.5 * $pi;
    gfx_line((cx + sin(t) * (r + 4)) * sc, (cy - cos(t) * (r + 4)) * sc, (cx + sin(t) * (r + 8)) * sc, (cy - cos(t) * (r + 8)) * sc, 1); i += 1; );
  krv_small = 1; act = kr_knob(cx, cy, r, idx, lo, hi, def); krv_small = 0;
  strlen(name) ? ( gfx_setfont(11); ui_col(act ? KRA : KRI); kr_ctxt(cx, cy + r + 15, act ? val : name); );
  act;
);
function kr_cell(x, y, w, h, lit, zone) local(c) (
  c = zone == 2 ? KRRED : zone == 1 ? KRAMB : KRCN;
  lit ? ( ui_cola(c, 0.16); kr_r(x - 0.5, y - 1, w + 1, h + 2); ui_col(c); kr_r(x, y, w, h); ui_cola(0xFFFFFF, 0.22); kr_r(x, y, w, 1.5); )
      : ( ui_col(KRGH); kr_r(x, y, w, h); ui_cola(0x000000, 0.25); kr_r(x, y + h - 1, w, 1); );
);
function kr_hbar(x, y, w, h, v) local(n, i, sw, d) (
  n = 32; sw = w / n; i = 0;
  loop(n, d = -48 + (i + 0.5) / n * 48; kr_cell(x + i * sw + 0.5, y, sw - 2, h, v >= d, d > -3 ? 2 : d > -12 ? 1 : 0); i += 1; );
);
function kr_grbar(x, y, w, h, gr) local(n, i, sw, d) (                     // gain reduction: 0 .. -24 dB, from the left
  n = 24; sw = w / n; i = 0;
  loop(n, d = -(i + 0.5); kr_cell(x + i * sw + 0.5, y, sw - 2, h, gr <= d, 1); i += 1; );
);
function kr_window(x, y, w, h) ( ui_col(0x040404); kr_r(x, y, w, h); ui_col(KRW); kr_r(x + 1, y + 1, w - 2, h - 2); );

gfx_setfont(10, "Trebuchet MS", 13 * sc, 'b');              // (a little bigger than the 34 series' own print)
gfx_setfont(11, "Trebuchet MS", 14 * sc, 'b');
gfx_setfont(12, "Trebuchet MS", 14 * sc, 'b');
gfx_setfont(14, "Trebuchet MS", 16 * sc, 'b');
gfx_setfont(16, "Courier New", 22 * sc, 'b');

function setv(idx, v) ( slider(idx) = v;  ui_auto(idx); );
// a lit key in a given colour (IN keys amber, mode keys yellow); otherwise the 34 series key
function kr_keyc(x, y, w, h, lbl, on, lc) local(hov, hit) (
  hov = kr_hov(x, y, w, h);  hit = hov && pressed && drag_id == 0;  hit ? drag_id = -1;
  ui_col(0x050505);  kr_r(x, y, w, h);
  on ? ui_col(lc) : ui_col(hov ? ui_mix(KRP, 0xFFFFFF, 0.14) : ui_mix(KRP, 0xFFFFFF, 0.07));  kr_r(x + 1, y + 1, w - 2, h - 2);
  on ? ( ui_cola(lc, 0.25);  kr_r(x - 2, y - 2, w + 4, h + 4);  ui_cola(0xFFFFFF, 0.3);  kr_r(x + 1, y + 1, w - 2, 1); );
  on ? ui_col(KRKT) : ui_col(KRI);
  gfx_setfont(12);  kr_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);
function fmt(f, v) (
  f == 1 ? sprintf(#v, "%d %%", v) : f == 2 ? sprintf(#v, "%+.1f dB", v) : f == 3 ? sprintf(#v, "%.2f Hz", v) :
  f == 4 ? sprintf(#v, "%.1f : 1", v) : f == 5 ? sprintf(#v, "%d ms", v) : f == 6 ? sprintf(#v, "%.1f dB", v) :
  f == 8 ? ( abs(v) < 0.5 ? strcpy(#v, "C") : v < 0 ? sprintf(#v, "L %d", -v) : sprintf(#v, "R %d", v); ) :
  sprintf(#v, "%.2f", v);
  #v;
);
// a knob: the 34 series small knob, its name under it (the value replaces the name while touched)
function kk(cx, cy, r, idx, lo, hi, def, lg, name, f) (
  fmt(f, slider(idx));  idx == 48 && cm_rat >= 19.95 ? strcpy(#v, "INF : 1");
  krv_lg = lg;  kr_small(cx, cy, r, idx, lo, hi, def, 11, name, #v);  krv_lg = 0;
);
// THICK: the house square grey key, a red LED beside it
function sq_key(x, y, on) local(hov, hit, s) (
  s = 22;  hov = kr_hov(x, y, s, s);  hit = hov && pressed && drag_id == 0;  hit ? drag_id = -1;
  ui_col(0x0A0A0B);  ui_rrs((x - 2) * sc, (y - 2) * sc, (s + 4) * sc, (s + 4) * sc, 3 * sc);
  ui_col(mdown && hov ? 0x6E6E70 : 0x8A8A8C);  ui_rrs(x * sc, y * sc, s * sc, s * sc, 2 * sc);
  ui_cola(0xFFFFFF, 0.25);  gfx_rect((x + 2) * sc, (y + 1) * sc, (s - 4) * sc, 1 * sc);
  ui_cola(0x000000, 0.3);  gfx_rect((x + 2) * sc, (y + s - 2) * sc, (s - 4) * sc, 1 * sc);
  pk_led((x + s + 12) * sc, (y + s * 0.5) * sc, 4.5 * sc, on, KRRED);
  hit;
);
// a little window that opens a menu (LAST STEP, the delay's note value)
function menu_win(x, y, w, h, txt) local(hit) (
  hit = kr_hov(x, y, w, h) && pressed && drag_id == 0;  hit ? drag_id = -1;
  kr_window(x, y, w, h);  gfx_setfont(16);  ui_col(KRA);  kr_ctxt(x + w * 0.5, y + h * 0.5, txt);
  hit;
);
function grey(x, y, w, h, on) ( !on ? ( ui_cola(KRF, 0.6);  kr_r(x + 1, y + 34, w - 2, h - 35); ); );
function in_key(x, y, idx) ( kr_keyc(x, y, 44, 22, "IN", slider(idx) >= 0.5, LIT_IN) ? setv(idx, slider(idx) >= 0.5 ? 0 : 1); );
function tname(k) ( k == 0 ? "BD" : k == 1 ? "SD" : k == 2 ? "LT" : k == 3 ? "MT" : k == 4 ? "HT" : k == 5 ? "RS" : k == 6 ? "CP" :
  k == 7 ? "CH" : k == 8 ? "OH" : k == 9 ? "CR" : k == 10 ? "RD" : k == 11 ? "LC" : k == 12 ? "HC" : k == 13 ? "TI" : k == 14 ? "LB" : "HB"; );
function lname(k) ( k == 0 ? "BASS" : k == 1 ? "SNARE" : k == 2 ? "LO TOM" : k == 3 ? "MID TOM" : k == 4 ? "HI TOM" : k == 5 ? "RIM" :
  k == 6 ? "CLAP" : k == 7 ? "CL HAT" : k == 8 ? "OP HAT" : k == 9 ? "CRASH" : k == 10 ? "RIDE" : k == 11 ? "LO CONGA" :
  k == 12 ? "HI CONGA" : k == 13 ? "TIMBALE" : k == 14 ? "LO BELL" : "HI BELL"; );
function lvdef(k) ( k == 0 ? 80 : k == 1 ? 70 : k < 5 ? 65 : k == 5 ? 60 : k == 6 ? 65 : k < 9 ? 60 : k < 11 ? 50 : k < 13 ? 60 : 55; );
function pndef(k) ( k == 2 ? -40 : k == 4 ? 40 : k == 5 ? 20 : k == 6 ? -10 : k == 7 || k == 8 ? 30 : k == 9 ? -30 : k == 10 ? 35 :
  k == 11 ? -50 : k == 12 ? 50 : k == 13 ? 25 : k == 14 ? -25 : k == 15 ? 20 : 0; );
function p_init() local(i) (
  slider(1) = 50;  i = 0;  loop(16, slider(2 + i) = lvdef(i);  slider(18 + i) = pndef(i);  i += 1; );
  slider(34) = 0;  slider(35) = 0;  slider(36) = 50;  slider(37) = 0;
  slider(38) = 0;  slider(39) = 0.4;  slider(40) = 60;  slider(41) = 40;  slider(42) = 50;  slider(43) = 0;  slider(44) = 40;  slider(45) = 50;
  slider(46) = 0;  slider(47) = -12;  slider(48) = 4;  slider(49) = 0;  slider(50) = 0;
  slider(51) = 0;  slider(52) = 1;  slider(53) = 300;  slider(54) = 3;  slider(55) = 35;  slider(56) = 40;  slider(57) = 25;
);
// PRESETS: kits (levels, pans, swing, FX), level-matched to Init on a groove. They never touch the patterns.
function load_preset(k) local(i) (
  p_init();
  k == 2 ? ( slider(13) = 75;  slider(14) = 75;  slider(15) = 70;  slider(16) = 70;  slider(17) = 70;  slider(29) = -70;  slider(30) = 70;  slider(31) = 35;  slider(32) = -40;  slider(33) = 40;  slider(34) = 15;  slider(35) = -1.4;  slider(51) = 1;  slider(54) = 4;  slider(55) = 25;  slider(57) = 15; );   // Latin Groove
  k == 3 ? ( slider(8) = 75;  slider(35) = 1.2;  slider(43) = 1;  slider(44) = 25;  slider(45) = 60;  slider(46) = 1;  slider(47) = -18;  slider(48) = 3;  slider(50) = 3; );   // Electro Pop
  k == 4 ? ( slider(35) = -0.2;  slider(36) = 80;  slider(37) = 1;  slider(43) = 1;  slider(44) = 35;  slider(45) = 40; );   // Bedroom Demo
  k == 5 ? ( slider(20) = -75;  slider(21) = 0;  slider(22) = 75;  slider(25) = 60;  slider(26) = 60;  slider(27) = -65;  slider(28) = 65;  slider(29) = -85;  slider(30) = 85;  slider(31) = 50;  slider(32) = -55;  slider(33) = 55;  slider(35) = 2.2;  slider(38) = 1;  slider(39) = 0.12;  slider(40) = 45;  slider(41) = 25;  slider(42) = 35; );   // Wide Stereo
  k == 6 ? ( slider(18) = 0;  slider(19) = 0;  slider(20) = 0;  slider(21) = 0;  slider(22) = 0;  slider(23) = 0;  slider(24) = 0;  slider(25) = 0;  slider(26) = 0;  slider(27) = 0;  slider(28) = 0;  slider(29) = 0;  slider(30) = 0;  slider(31) = 0;  slider(32) = 0;  slider(33) = 0;  slider(35) = 2.3;  slider(37) = 1;  slider(46) = 1;  slider(47) = -20;  slider(48) = 4;  slider(50) = 4; );   // Mono Club
  k == 7 ? ( slider(16) = 65;  slider(34) = 50;  slider(35) = 1.4;  slider(46) = 1;  slider(47) = -16;  slider(48) = 3;  slider(49) = 0;  slider(50) = 2; );   // Funk Shuffle
  k == 8 ? ( slider(16) = 70;  slider(17) = 70;  slider(35) = 0.1;  slider(38) = 1;  slider(39) = 0.1;  slider(40) = 40;  slider(41) = 25;  slider(42) = 30;  slider(51) = 1;  slider(54) = 6;  slider(55) = 55;  slider(56) = 60;  slider(57) = 35; );   // Dub Bells
  k == 9 ? ( slider(35) = 2.2;  slider(36) = 70;  slider(43) = 1;  slider(44) = 70;  slider(45) = 35;  slider(46) = 1;  slider(47) = -24;  slider(48) = 6;  slider(49) = 0;  slider(50) = 6; );   // Crunchy
  k == 10 ? ( slider(1) = 30;  slider(35) = 0;  slider(37) = 1;  slider(46) = 1;  slider(47) = -14;  slider(48) = 2;  slider(49) = 1;  slider(50) = 2; );   // Soft and Round
  k == 11 ? ( slider(10) = 70;  slider(16) = 80;  slider(17) = 80;  slider(35) = -0.2;  slider(51) = 1;  slider(54) = 3;  slider(55) = 30;  slider(57) = 18; );   // Disco Cowbell
  k == 12 ? ( slider(35) = -0.3;  slider(36) = 0; );   // Clean Machine
  i = 1;  loop(57, ui_auto(i);  i += 1; );
);
// demo patterns (EDIT > Load a demo pattern): one string per track, '.' off, 'x' hit, 'X' accent
function set_row(t, str) local(i, c) ( i = 0;  loop(16, c = str_getchar(str, i);  SEQ[(cur_pat * NV + t) * 16 + i] = c == 88 ? 2 : c == 120 ? 1 : 0;  i += 1; ); );
function demo_pat(n) (
  LEN[cur_pat] = 16;  memset(SEQ + cur_pat * NV * 16, 0, NV * 16);
  n == 1 ? ( set_row(0, "X......x..X.....");  set_row(5, "..x..x....x..x..");  set_row(7, "x.x.x.x.x.x.x.x.");  set_row(11, "...x..x....x..x.");  set_row(12, "..x.......x.....");  set_row(13, "........x.....x.");  set_row(15, "x...x...x...x..."); );   // Latin
  n == 2 ? ( set_row(0, "X...X...X...X...");  set_row(1, "....X.......X...");  set_row(6, "....X.......X...");  set_row(7, "x...x...x...x...");  set_row(8, "..x...x...x...x."); );   // Electro pop
  n == 3 ? ( set_row(0, "X..x..x.X..x..x.");  set_row(5, "x..x..x...x..x..");  set_row(7, "xxxxxxxxxxxxxxxx"); );   // Bossa
  n == 4 ? ( set_row(0, "X...X...X...X...");  set_row(1, "....X.......X...");  set_row(6, "....x.......x...");  set_row(8, "..X...X...X...X.");  set_row(15, "x.x.x.x.x.x.x.x."); );   // Disco
  n == 5 ? ( set_row(0, "X.x....x..x.....");  set_row(1, "....X..x.x..X...");  set_row(7, "x.x.x.x.x.x.x.xX");  set_row(8, "..............x.");  set_row(14, "......x.......x."); );   // Funk
  n == 6 ? ( set_row(0, "X......x.xX.....");  set_row(1, "....X.......X...");  set_row(7, "x.x.x.x.x.x.x.x."); );   // Hip hop
  n == 7 ? ( set_row(0, "X..xX..xX..xX..x");  set_row(1, "..x...x...x...x.");  set_row(7, "xxxxxxxxxxxxxxxx");  set_row(12, "..x...x...x...x.");  set_row(13, "x.......x.x.....");  set_row(15, "x.x..x.x.x..x.x."); );   // Samba
  n == 8 ? ( set_row(0, "........X.......");  set_row(5, "........X.......");  set_row(7, "..x...x...x...x."); );   // Reggae
  n == 9 ? ( set_row(0, "X.......X.......");  set_row(1, "............XXXX");  set_row(2, "........x..x..x.");  set_row(3, "....x..x.....x..");  set_row(4, "x..x..x.........");  set_row(9, "X..............."); );   // Tom fill
);

// =====================================================================
// Faceplate and header (the 34 series')
// =====================================================================
ui_col(ui_mix(KRP, 0x000000, 0.35));  gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0xFFFFFF, 0.08);  kr_r(0, 0, 1200, 1.5);  kr_r(0, 0, 1.5, 820);
ui_cola(0x000000, 0.35);  kr_r(0, 818.5, 1200, 1.5);  kr_r(1198.5, 0, 1.5, 820);
ui_col(KRP);  kr_r(12, 12, 1176, 796);
ui_cola(0x000000, 0.30);  kr_r(12, 12, 1176, 1.5);  kr_r(12, 12, 1.5, 796);
ui_cola(0xFFFFFF, 0.07);  kr_r(12, 806.5, 1176, 1.5);  kr_r(1186.5, 12, 1.5, 796);
ui_col(KRH);  kr_r(13.5, 13.5, 1173, 50.5);
ui_col(KRA);  kr_r(13.5, 64, 1173, 2);
ui_col(KRA);  gfx_circle(45 * sc, 39 * sc, 16 * sc, 1, 1);
gfx_setfont(4);  ui_col(KRKT);  ui_text(45 * sc, 33.5 * sc, "GFX");
gfx_setfont(6);  ui_col(KRI);  kr_txt(72, 24, "RS50");  gfx_measurestr("RS50", g_tw, g_th);
g_tx = 72 + g_tw / sc + 14;
gfx_setfont(11);  ui_col(KRI2);  kr_txt(g_tx, 25, "RHYTHM");  kr_txt(g_tx, 41, "COMPOSER");
g_k = pk_preset(340 * sc, 22 * sc, 330 * sc, 34 * sc, pr_cur, #pmenu);
g_k > 0 ? ( load_preset(g_k);  pr_cur = g_k; );
ui_size_picker(1116 * sc, 30 * sc);

// =====================================================================
// The instruments: LEVEL and PAN for each of the sixteen
// =====================================================================
kr_sect(22, 74, 1156, 238, "INSTRUMENTS");
g_j = 0;
loop(16,
  g_cx = 94 + (g_j % 8) * 144;  g_y0 = g_j < 8 ? 104 : 206;
  gfx_setfont(14);  ui_col(KRI);  kr_ctxt(g_cx, g_y0 + 10, lname(g_j));
  kk(g_cx - 30, g_y0 + 50, 17, 2 + g_j, 0, 100, lvdef(g_j), 0, "LEVEL", 1);
  kk(g_cx + 32, g_y0 + 54, 13, 18 + g_j, -100, 100, pndef(g_j), 0, "PAN", 8);
  g_j % 8 > 0 ? ( ui_cola(KRI, 0.12);  kr_r(g_cx - 72, g_y0 + 2, 1, 90); );
  g_j += 1;
);
ui_cola(KRI, 0.12);  kr_r(34, 204, 1132, 1);

// =====================================================================
// The sequencer
// =====================================================================
kr_sect(22, 322, 864, 312, "SEQUENCER");
gfx_setfont(10);  ui_col(run ? KRA : KRI2);  kr_txt(31, 346, run ? ((play_state & 1) ? "PLAYING" : "FREE RUN") : "STOPPED");
kr_keyc(30, 376, 112, 44, run_req ? "STOP" : "RUN", run_req, KRA) ? run_req = !run_req;
gfx_setfont(10);  ui_col(KRI2);  kr_ctxt(86, 436, "LAST STEP");
sprintf(#ls, "%d", LEN[cur_pat]);
menu_win(56, 448, 60, 32, #ls) ? (
  strcpy(#lm, "");  g_j = 1;  loop(16, g_j == LEN[cur_pat] ? strcat(#lm, "!");  strcat(#lm, sprintf(#stp, "%d", g_j));  g_j < 16 ? strcat(#lm, "|");  g_j += 1; );
  gfx_x = 56 * sc;  gfx_y = 482 * sc;  g_k = gfx_showmenu(#lm);  g_k > 0 ? LEN[cur_pat] = g_k;
);
kk(86, 528, 15, 34, 0, 100, 0, 0, "SWING", 1);
kr_key(30, 590, 112, 28, "EDIT", 0) ? (
  strcpy(#em, "Clear this pattern|>Copy this pattern to");  g_j = 1;
  loop(16, strcat(#em, g_j == 16 ? "|<" : "|");  strcat(#em, sprintf(#stp, "%d", g_j));  g_j += 1; );
  strcat(#em, "|>Load a demo pattern|Latin|Electro pop|Bossa|Disco|Funk|Hip hop|Samba|Reggae|<Tom fill");
  gfx_x = 30 * sc;  gfx_y = 620 * sc;  g_k = gfx_showmenu(#em);
  g_k == 1 ? memset(SEQ + cur_pat * NV * 16, 0, NV * 16);
  g_k >= 18 ? demo_pat(g_k - 17);
  g_k >= 2 && g_k <= 17 ? ( g_p = g_k - 2;  g_p != cur_pat ? ( memcpy(SEQ + g_p * NV * 16, SEQ + cur_pat * NV * 16, NV * 16);  LEN[g_p] = LEN[cur_pat]; ); );
);
// pattern keys, on the step columns
g_s = 0;
loop(16, g_x = 196 + g_s * 42 + floor(g_s / 4) * 4;
  kr_key(g_x, 330, 38, 22, sprintf(#stp, "%d", g_s + 1), g_s == cur_pat || (g_s == pending_pat && (time_precise() * 3) % 2 < 1)) ? pat_sel_d = g_s;
  g_s += 1; );
gfx_setfont(10);  ui_col(KRI2);  kr_rtxt(190, 341, "PAT");
// the step lights
g_sd = step_disp;
g_s = 0;
loop(16, g_x = 196 + g_s * 42 + floor(g_s / 4) * 4;
  kr_cell(g_x + 1, 360, 36, 4, g_s == g_sd, 1);  g_s += 1; );
// the lanes
g_t = 0;
loop(16,
  g_y = 372 + g_t * 16;
  g_hov = kr_hov(156, g_y, 36, 15);
  gfx_setfont(10);  ui_col(g_hov ? KRA : KRI2);  kr_rtxt(188, g_y + 7.5, tname(g_t));
  g_hov && pressed && drag_id == 0 ? ( drag_id = -1;  aud_t_d = g_t;  aud_n_d += 1; );
  g_s = 0;
  loop(16,
    g_x = 196 + g_s * 42 + floor(g_s / 4) * 4;
    g_a = (cur_pat * NV + g_t) * 16 + g_s;  g_v = SEQ[g_a];  g_in = g_s < LEN[cur_pat];
    g_ho = kr_hov(g_x, g_y, 38, 14);
    g_ho && pressed && drag_id == 0 ? ( drag_id = -3;  paint_v = (g_v + 1) % 3;  SEQ[g_a] = paint_v;  g_v = paint_v; );
    g_ho && drag_id == -3 && mdown && g_v != paint_v ? ( SEQ[g_a] = paint_v;  g_v = paint_v; );
    ui_col(0x050505);  kr_r(g_x, g_y, 38, 14);
    g_v == 0 ? ui_col(g_in ? ((g_s & 3) == 0 ? ui_mix(KRGH, 0xFFFFFF, 0.06) : KRGH) : ui_mix(KRF, 0x000000, 0.3)) :
               ui_col(g_v == 2 ? KRA : ui_mix(KRA, KRF, g_in ? 0.45 : 0.75));
    kr_r(g_x + 1, g_y + 1, 36, 12);
    g_v == 2 ? ( ui_cola(0xFFFFFF, 0.35);  kr_r(g_x + 1, g_y + 1, 36, 2); );
    g_ho && g_v == 0 ? ( ui_cola(0xFFFFFF, 0.08);  kr_r(g_x + 1, g_y + 1, 36, 12); );
    g_s += 1; );
  g_t += 1;
);

// =====================================================================
// Master
// =====================================================================
kr_sect(896, 322, 282, 312, "MASTER");
kk(950, 410, 18, 1, 0, 100, 50, 0, "ACCENT", 1);
kk(1036, 410, 18, 35, -18, 6, 0, 0, "LEVEL", 2);
kk(1122, 410, 18, 36, 0, 100, 50, 0, "DRIFT", 1);
sq_key(926, 486, thick >= 0.5) ? setv(37, thick >= 0.5 ? 0 : 1);
gfx_setfont(11);  ui_col(KRI);  kr_txt(972, 489, "THICK");
gfx_setfont(10);  ui_col(KRI2);  kr_txt(912, 548, "OUT");
g_pk = max(g_pk * 0.85, op_disp);
kr_hbar(948, 548, 216, 14, g_pk > 0.0000001 ? 20 * log10(g_pk) : -140);
gfx_setfont(10);  ui_col(KRI2);  kr_txt(948, 568, "-48");  kr_ctxt(1104, 574, "-12");  kr_rtxt(1166, 574, "0");

// =====================================================================
// The FX strip
// =====================================================================
FY = 644;  FH = 152;  FK = 724;
g_x = 22;  kr_sect(g_x, FY, 322, FH, "PHASER");
kk(g_x + 48, FK, 17, 39, 0.05, 5, 0.4, 1, "RATE", 3);  kk(g_x + 122, FK, 17, 40, 0, 100, 60, 0, "DEPTH", 1);
kk(g_x + 196, FK, 17, 41, 0, 90, 40, 0, "FEEDBACK", 1);  kk(g_x + 270, FK, 17, 42, 0, 100, 50, 0, "COLOUR", 1);
grey(g_x, FY, 322, FH, ph_in >= 0.5);  in_key(g_x + 322 - 54, FY + 6, 38);
g_x = 354;  kr_sect(g_x, FY, 170, FH, "DRIVE");
kk(g_x + 48, FK, 17, 44, 0, 100, 40, 0, "AMOUNT", 1);  kk(g_x + 122, FK, 17, 45, 0, 100, 50, 0, "TONE", 1);
grey(g_x, FY, 170, FH, dr_in >= 0.5);  in_key(g_x + 170 - 54, FY + 6, 43);
g_x = 534;  kr_sect(g_x, FY, 352, FH, "COMP");
kk(g_x + 48, FK, 17, 47, -40, 0, -12, 0, "THRESH", 6);  kk(g_x + 122, FK, 17, 48, 1, 20, 4, 1, "RATIO", 4);
kk(g_x + 196, FK, 17, 50, 0, 20, 0, 0, "MAKE-UP", 2);
kr_keyc(g_x + 254, 690, 72, 24, "FAST", cm_env < 0.5, LIT_MODE) ? setv(49, 0);
kr_keyc(g_x + 254, 722, 72, 24, "SLOW", cm_env >= 0.5, LIT_MODE) ? setv(49, 1);
kr_grbar(g_x + 48, 774, 286, 10, gr_disp);
gfx_setfont(10);  ui_col(KRI2);  kr_rtxt(g_x + 40, 779, "GR");
grey(g_x, FY, 352, FH, cm_in >= 0.5);  in_key(g_x + 352 - 54, FY + 6, 46);
g_x = 896;  kr_sect(g_x, FY, 282, FH, "DELAY");
dl_sync >= 0.5 ? (
  g_div = floor(dl_div + 0.5);
  gfx_setfont(11);  ui_col(KRI);  kr_ctxt(g_x + 48, FK + 32, "NOTE");
  menu_win(g_x + 16, FK - 16, 64, 32, g_div == 0 ? "1/32" : g_div == 1 ? "1/16" : g_div == 2 ? "1/16." : g_div == 3 ? "1/8" : g_div == 4 ? "1/8." : g_div == 5 ? "1/4" : "1/4.") ? (
    strcpy(#dm, "");  g_j = 0;
    loop(7, g_j == g_div ? strcat(#dm, "!");
      strcat(#dm, g_j == 0 ? "1/32" : g_j == 1 ? "1/16" : g_j == 2 ? "1/16 dotted" : g_j == 3 ? "1/8" : g_j == 4 ? "1/8 dotted" : g_j == 5 ? "1/4" : "1/4 dotted");
      g_j < 6 ? strcat(#dm, "|");  g_j += 1; );
    gfx_x = (g_x + 16) * sc;  gfx_y = (FK + 18) * sc;  g_k = gfx_showmenu(#dm);  g_k > 0 ? setv(54, g_k - 1);
  );
) : kk(g_x + 48, FK, 17, 53, 20, 1500, 300, 1, "TIME", 5);
kr_keyc(g_x + 16, 770, 64, 22, "SYNC", dl_sync >= 0.5, LIT_MODE) ? setv(52, dl_sync >= 0.5 ? 0 : 1);
kk(g_x + 120, FK, 17, 55, 0, 90, 35, 0, "FEEDBACK", 1);  kk(g_x + 188, FK, 17, 56, 0, 100, 40, 0, "DAMP", 1);
kk(g_x + 248, FK, 17, 57, 0, 100, 25, 0, "MIX", 1);
grey(g_x, FY, 282, FH, dl_in >= 0.5);  in_key(g_x + 282 - 54, FY + 6, 51);

pk_end();
