desc:Lune [pitch corrector] (GFX Lab)
//tags: pitch correction tuning vocal key scale retune formant humanise
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-power, gfx-lab-bypass, gfx-lab-sliders, gfx-lab-v5-parts (.jsfx-inc) in the same folder.

slider16:psw_view=0<0,1,1{Panel only,Show all}>-Parameter sliders
slider1:ln_key=0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>-Key
slider2:ln_scl=1<0,10,1{Chromatic,Major,Natural minor,Harmonic minor,Melodic minor,Dorian,Mixolydian,Major pentatonic,Minor pentatonic,Blues,Custom}>-Scale
slider3:ln_mask=2741<0,4095,1>-Custom notes
slider4:ln_spd=40<1,400,1>-Retune speed (ms)
slider5:ln_hum=20<0,100,1>-Humanise (%)
slider6:ln_amt=100<0,100,1>-Amount (%)
slider7:ln_tr=0<-12,12,1>-Transpose (st)
slider8:ln_frm=0<-12,12,0.1>-Formant (st)
slider9:ln_voc=1<0,2,1{Low,Mid,High}>-Voice
slider10:ln_midi=0<0,1,1{Off,On}>-MIDI notes
slider11:ln_mix=100<0,100,1>-Mix (%)
slider12:ln_out=0<-18,6,0.1>-Output (dB)
slider13:ln_drf=50<0,100,1>-Drift (%)
slider14:ln_byp=0<0,1,1{Off,On}>-Bypass
slider15:prs_sel=0<0,12,1{No preset,Default,Gentle Polish,Natural Vocal,Tight Pop,Hard Robot,Minor Lock,Pentatonic Lead,Blues Bend,Octave Up,Deep Voice,Small Voice,MIDI Steer}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-power.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sliders.jsfx-inc
import gfx-lab-v5-parts.jsfx-inc

@init
function psw_all(v) ( slider_show(65535, v); );
function psw_allg(v) ( slider_show(65535, v); );
#ui_man = "gfx-lab-lune";
ext_noinit = 1;

DRY = 100000; DRYN = 16384;
BL = 200000; BR = 400000; PB = 540000; BN = 131072;
YB = 700000; YN = 4096; YD = 710000;
GS = 720000; GW = 8; NG = 10;
HI = 750000; HN = 1024;
NS = 760000;
SHB = 765000; SHN = 64;
SCL = 790000;
NP = 12;

SCL[0] = 4095; SCL[1] = 2741; SCL[2] = 1453; SCL[3] = 2477; SCL[4] = 2733; SCL[5] = 1709;
SCL[6] = 1717; SCL[7] = 661; SCL[8] = 1193; SCL[9] = 1257;

D0 = floor(0.03 * srate + 0.5);

function bw(p) ( p - floor(p / BN) * BN; );
function rd(b, p) local(i, f, j0, j1, j2, j3, xm, x0, x1, x2, c1, c2, c3) (
  i = floor(p); f = p - i; j1 = bw(i); j0 = j1 >= 1 ? j1 - 1 : BN - 1; j2 = j1 + 1 < BN ? j1 + 1 : 0; j3 = j2 + 1 < BN ? j2 + 1 : 0;
  xm = b[j0]; x0 = b[j1]; x1 = b[j2]; x2 = b[j3];
  c1 = 0.5 * (x1 - xm); c2 = xm - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);

function ln_voice() local(v) (
  v = ln_voc | 0;
  ln_fmin = v == 0 ? 60 : v == 1 ? 80 : 140;
  ln_fmax = v == 0 ? 520 : v == 1 ? 950 : 1400;
  ln_wl = v == 0 ? 176 : v == 1 ? 128 : 96;
  ln_tmin = max(2, floor(y_fs / ln_fmax));
  ln_tmax = min(floor(y_fs / ln_fmin), 300);
  ln_lag = max(0, floor((D0 - 0.5 * (ln_wl + ln_tmax) * y_dec) / (ln_hop * y_dec) + 0.5));
  ln_vlast = v;
);

function yin_run() local(j, tau, s, d, cm, best, bt, a, b, c, sh, e, base, dn, wl, tmax) (
  wl = ln_wl; tmax = ln_tmax;
  base = y_w - wl - tmax + YN * 4; e = 0;
  j = 0; loop(wl, a = YB[(base + j) % YN]; e += a * a; j += 1; );
  YD[0] = 1; cm = 0; tau = 1; bt = 0; dn = 0;
  while (tau <= tmax && !dn) (
    s = 0; j = 0;
    loop(wl, d = YB[(base + j) % YN] - YB[(base + j + tau) % YN]; s += d * d; j += 1; );
    cm += s; YD[tau] = cm > 0 ? s * tau / cm : 1;
    bt > 0 ? ( YD[tau] < YD[bt] ? bt = tau : dn = 1; ) : tau >= ln_tmin && YD[tau] < 0.12 ? bt = tau;
    tau += 1;
  );
  bt == 0 ? ( best = 9; tau = ln_tmin; loop(tmax - ln_tmin, YD[tau] < best ? ( best = YD[tau]; bt = tau; ); tau += 1; ); best > 0.25 ? bt = 0; );
  bt >= tmax ? bt = 0;
  bt > 0 ? ( tau = 2; loop(ln_tmin - 2, YD[tau] < 0.2 ? bt = 0; tau += 1; ); );
  e / wl < 0.0000001 ? bt = 0;
  bt > 0 ? (
    a = YD[bt - 1]; b = YD[bt]; c = YD[bt + 1]; sh = a - 2 * b + c;
    sh = abs(sh) > 0.0000001 ? 0.5 * (a - c) / sh : 0;
    y_T0 = (bt + max(-0.5, min(0.5, sh))) * y_dec; y_vo = 1;
  ) : y_vo = 0;
);

function ln_amask() local(r, k, i, m) (
  ln_midi >= 0.5 && ns_n > 0 ? (
    m = 0; i = 0; loop(ns_n, m |= 2 ^ (NS[i] % 12); i += 1; );
  ) : (ln_scl | 0) >= 10 ? (
    m = (ln_mask | 0) & 4095;
  ) : (
    r = SCL[max(0, min(9, ln_scl | 0))]; k = ln_key | 0; m = 0; i = 0;
    loop(12, r & (2 ^ i) ? m |= 2 ^ ((i + k) % 12); i += 1; );
  );
  m == 0 ? 4095 : m;
);

function ln_near(m, msk) local(r, d, n, bd, best) (
  r = floor(m + 0.5); bd = 1000; best = r; d = 0;
  loop(7,
    bd > 999 ? (
      n = r - d; msk & (2 ^ (n % 12)) && abs(m - n) < bd ? ( bd = abs(m - n); best = n; );
      n = r + d; msk & (2 ^ (n % 12)) && abs(m - n) < bd ? ( bd = abs(m - n); best = n; );
    );
    d += 1;
  );
  best;
);

function ln_dec() local(f, m, a, b, md, msk, cand, err, tau, k, j) (
  f = y_vo ? srate / y_T0 : 0;
  y_vo ? ( ln_vn += 1; ln_un = 0; ) : ( ln_un += 1; ln_vn = 0; );
  ln_vs ? (
    ln_un >= 3 ? ( ln_vs = 0; ln_h1 = ln_h2 = 0; ln_mp = 0; ln_oc = 0; );
  ) : (
    ln_vn >= 2 ? ( ln_vs = 1; ln_ht = 0; ln_nt = -1; ln_oc = 0; );
  );
  f > 0 ? (
    m = 69 + 12 * log(f / 440) / log(2);
    a = ln_h1; b = ln_h2; ln_h2 = ln_h1; ln_h1 = m;
    md = a > 0 && b > 0 ? max(min(m, a), min(max(m, a), b)) : m;
    ln_mp > 0 && abs(abs(md - ln_mp) - 12) < 1 && ln_oc < 3 ? ( ln_oc += 1; md = ln_mp; ) : ln_oc = 0;
    ln_mp = md;
  );
  msk = ln_amask(); ln_am_d = msk;
  ln_vs && ln_mp > 0 ? (
    ln_ht += ln_hops;
    cand = ln_near(ln_mp, msk);
    ln_nt < 0 || !(msk & (2 ^ (ln_nt % 12))) ? ( ln_nt = cand; ln_ht = 0; ) :
      cand != ln_nt && abs(ln_mp - ln_nt) - abs(ln_mp - cand) > 0.25 ? ( ln_nt = cand; ln_ht = 0; );
    err = (ln_nt - ln_mp) * ln_amt / 100;
    tau = ln_spd + ln_hum * 2.5 * min(1, max(0, (ln_ht - 0.12) / 0.4));
    k = tau <= 1.5 ? 1 : 1 - exp(-ln_hops * 1000 / tau);
    ln_cr += (err - ln_cr) * k;
  ) : (
    ln_cr -= ln_cr * ln_kun; ln_nt = -1;
  );
  j = ln_sw * 5;
  SHB[j] = ln_cr; SHB[j + 1] = ln_vs && ln_mp > 0 ? srate / (440 * 2 ^ ((ln_mp - 69) / 12)) : 0;
  SHB[j + 2] = ln_vs && ln_mp > 0; SHB[j + 3] = ln_vs ? ln_mp : 0; SHB[j + 4] = ln_nt;
  ln_sw = (ln_sw + 1) % SHN;
  j = ((ln_sw - 1 - ln_lag + SHN * 2) % SHN) * 5;
  ln_csh = SHB[j]; ln_cT = SHB[j + 1]; ln_cvo = SHB[j + 2]; ln_cm = SHB[j + 3]; ln_cnt = SHB[j + 4];
  j = ln_hw * 3;
  HI[j] = ln_cvo ? ln_cm : 0;
  HI[j + 1] = ln_cvo ? ln_cm + ln_csh + ln_tr : 0;
  HI[j + 2] = ln_cvo ? ln_cnt + ln_tr : -1;
  ln_hw = (ln_hw + 1) % HN; ln_hw_d = ln_hw;
);

function g_clr() local(i) ( i = 0; loop(NG, GS[i * GW] = 0; i += 1; ); );
function oc_grain(T0, sc, fm) local(i, p, done) (
  i = 0; done = 0;
  loop(NG, p = GS + i * GW; !done && p[0] == 0 ? ( p[0] = 1; p[1] = sc - T0; p[2] = fm; p[3] = max(4, floor(2 * T0 / fm)); p[4] = 0; done = 1; ); i += 1; );
);
function ln_epk(p, T) local(w, i, best, bv, v) (
  w = floor(0.12 * T); i = floor(p) - w; best = floor(p); bv = -1000;
  loop(2 * w + 1, v = PB[bw(i)]; v > bv ? ( bv = v; best = i; ); i += 1; );
  best;
);

function clr_all() (
  g_clr(); oc_next = 0; oc_lsc = 0;
  memset(BL, 0, BN); memset(BR, 0, BN); memset(PB, 0, BN); memset(DRY, 0, DRYN * 2); memset(YB, 0, YN); memset(SHB, 0, SHN * 5);
  ln_vs = 0; ln_vn = ln_un = 0; ln_h1 = ln_h2 = 0; ln_mp = 0; ln_nt = -1; ln_cr = 0; ln_csh = ln_cT = ln_cvo = 0;
  y_z1 = y_z2 = y_z3 = y_z4 = 0; ln_vw = 0; oc_r = 1;
);

y_dec = max(1, floor(srate / 8000 + 0.5)); y_fs = srate / y_dec; y_w = 0; y_c = 0; y_h = 0; y_T0 = 0.005 * srate; y_vo = 0;
y_a = 1 - exp(-2 * $pi * 0.38 * y_fs / srate);
ln_hop = 32; ln_hops = ln_hop * y_dec / srate;
ln_kun = 1 - exp(-ln_hops / 0.03);
ln_voice();
memset(HI, 0, HN * 3); ln_hw = 0; ln_sw = 0;
tt = 0; dpos = 0; clr_all();
ksm = 1 - exp(-1 / (0.03 * srate)); krt = 1 - exp(-1 / (0.003 * srate)); kvw = 1 - exp(-1 / (0.01 * srate));
oc_r = 1; oc_f = 2 ^ (ln_frm / 12); ln_trs = ln_tr;
g_out = 10 ^ (ln_out / 20); g_mix = ln_mix / 100;
ns_n = 0;
CRATE = 32; cc = 0;
DR1.drift_init(0.8 + rand(1) * 0.4); DR2.drift_init(0.6 + rand(1) * 0.4);
drA = drB = 0;
ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = D0;
by_setup(14);
pwr_init(); pwr_wu_loss = 0.2; pwr_wu_drv = 0.3; pwr_wu_lp = 14000; pwr_bloom = 0; pwr_sag = 0.08;
rs_f = 1;

!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function pv(i, v) ( slider(i) = v; );
function sl_list() local(i) ( i = 1; loop(13, slider_automate(2 ^ (i - 1)); i += 1; ); );
function p_init() (
  pv(1, 0); pv(2, 1); pv(3, 2741); pv(4, 40); pv(5, 20); pv(6, 100); pv(7, 0); pv(8, 0); pv(9, 1); pv(10, 0);
  pv(11, 100); pv(12, 0); pv(13, 50);
);
function load_preset(p) (
  p_init();
  p == 2 ? ( pv(2, 0); pv(4, 180); pv(5, 50); pv(6, 70); );
  p == 3 ? ( pv(4, 90); pv(5, 40); );
  p == 4 ? ( pv(4, 15); pv(5, 10); );
  p == 5 ? ( pv(4, 1); pv(5, 0); );
  p == 6 ? ( pv(1, 9); pv(2, 2); pv(4, 25); pv(5, 15); );
  p == 7 ? ( pv(1, 9); pv(2, 8); pv(4, 20); pv(5, 10); );
  p == 8 ? ( pv(1, 4); pv(2, 9); pv(4, 120); pv(5, 60); );
  p == 9 ? ( pv(2, 0); pv(4, 30); pv(7, 12); );
  p == 10 ? ( pv(2, 0); pv(4, 60); pv(7, -12); pv(8, 2); );
  p == 11 ? ( pv(2, 0); pv(6, 0); pv(8, 4); );
  p == 12 ? ( pv(4, 10); pv(5, 5); pv(10, 1); );
  sl_list();
);

function prs_hash() local(i, h) ( h = 0; i = 1; loop(14, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= NP ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(NP, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

function params() (
  drift_macro(ln_drf);
  t_out = 10 ^ (ln_out / 20); t_mix = ln_mix / 100;
  (ln_voc | 0) != ln_vlast ? ln_voice();
);
params();

@slider
(psw_view >= 0.5) != psw_last ? ( psw_last = psw_view >= 0.5; psw_all(psw_last); );
prs_chk();
params();
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = D0;

@block
prs_chk();
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? ( rs_f = 0; rs_c = 1 / (0.015 * srate); clr_all(); );
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
while (midirecv(mo, m1, m2, m3)) (
  ms = m1 & 0xF0;
  ms == 0xB0 && (m2 == 120 || m2 == 123) ? ns_n = 0 :
  ms == 0x90 && m3 > 0 ? ( mi = 0; mf = 0; loop(ns_n, NS[mi] == m2 ? mf = 1; mi += 1; ); !mf && ns_n < 16 ? ( NS[ns_n] = m2; ns_n += 1; ); ) :
  ms == 0x80 || ms == 0x90 ? ( mi = 0; mj = 0; loop(ns_n, NS[mi] != m2 ? ( NS[mj] = NS[mi]; mj += 1; ); mi += 1; ); ns_n = mj; );
  midisend(mo, m1, m2, m3);
);
params();
ost_setup(0, 0, 100, 8000, -0.3, 0);
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = D0;
pwr_block(ln_byp < 0.5);
mi = 0; ln_mm_d = 0; ln_midi >= 0.5 ? loop(ns_n, ln_mm_d |= 2 ^ (NS[mi] % 12); mi += 1; );
ln_nt_d = ln_cvo ? ln_cnt + ln_tr : -1; ln_in_d = ln_cvo ? ln_cm : 0; ln_ou_d = ln_cvo ? ln_cm + ln_csh + ln_tr : 0;
ln_pk_d = max(ln_pk_d, ln_pk); ln_pk = 0;

@serialize
file_var(0, ui_sz); file_var(0, pr_cur);
pwr_ser();
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
(cc -= 1) <= 0 ? (
  cc = CRATE;
  dspd = 0.05 * dm_s * CRATE / srate;
  drA = DR1.drift_tick(dspd); drB = DR2.drift_tick(dspd * 0.7);
);
g_out += (t_out - g_out) * ksm; g_mix += (t_mix - g_mix) * ksm;
ln_trs += (ln_tr - ln_trs) * ksm;

pwr_in(spl0, spl1); xl = pwr_l; xr = pwr_r;
abs(xl) < 0.000000000000001 ? xl = 0; abs(xr) < 0.000000000000001 ? xr = 0;
DRY[dpos * 2] = xl; DRY[dpos * 2 + 1] = xr;
rp = (dpos + DRYN - D0) % DRYN; el = DRY[rp * 2]; er = DRY[rp * 2 + 1];
dpos = (dpos + 1) % DRYN;
tt += 1;
BL[bw(tt)] = xl; BR[bw(tt)] = xr;

y_z3 += (0.5 * (xl + xr) - y_z3) * y_a; y_z4 += (y_z3 - y_z4) * y_a; y_z1 += (y_z4 - y_z1) * y_a; y_z2 += (y_z1 - y_z2) * y_a;
PB[bw(tt)] = y_z2;
(y_c += 1) >= y_dec ? ( y_c = 0; YB[y_w % YN] = y_z2; y_w += 1; (y_h += 1) >= ln_hop ? ( y_h = 0; yin_run(); ln_dec(); ); );

o_st = (ln_cvo ? ln_csh : 0) + ln_trs + dm_a * 0.03 * drA;
oc_r += (2 ^ (o_st / 12) - oc_r) * krt;
oc_f += (min(2.5, max(0.4, 2 ^ ((ln_frm + dm_a * 0.06 * drB) / 12))) - oc_f) * ksm;
ln_vw += ((ln_cvo || abs(ln_frm) > 0.05 ? 1 : 0) - ln_vw) * kvw;

tt >= oc_next ? (
  o_T = ln_cvo ? min(0.0145 * srate, max(0.0007 * srate, ln_cT)) : 0.007 * srate;
  o_ct = tt - D0 + o_T;
  o_lim = tt + o_T * min(1, 2 / oc_f - 1) - 4;
  ln_cvo ? (
    o_k = floor((o_ct - oc_lsc) / o_T + 0.5); o_sc = oc_lsc + o_k * o_T; abs(o_sc - o_ct) > o_T ? o_sc = o_ct;
    o_sc = ln_epk(o_sc, o_T);
    o_sc > o_lim ? o_sc -= o_T;
  ) : o_sc = o_ct + (rand(1) - 0.5) * o_T * 0.5;
  o_sc = min(o_sc, o_lim);
  oc_grain(o_T, o_sc, oc_f);
  oc_lsc = o_sc;
  oc_next = max(oc_next + o_T / oc_r, tt - 1);
);
o_al = o_ar = 0; o_ws = 0; o_i = 0;
loop(NG, o_p = GS + o_i * GW;
  o_p[0] ? (
    o_w = 0.5 - 0.5 * cos(2 * $pi * o_p[4] / o_p[3]);
    o_q = o_p[1] + o_p[2] * o_p[4];
    o_al += o_w * rd(BL, o_q); o_ar += o_w * rd(BR, o_q); o_ws += o_w;
    (o_p[4] += 1) >= o_p[3] ? o_p[0] = 0;
  );
  o_i += 1;
);
o_nm = 1 / max(o_ws, 1) * (oc_r > oc_f ? min(2.5, oc_r / oc_f) : min(2.5, sqrt(oc_f / oc_r)));
wl = el + (o_al * o_nm - el) * ln_vw; wr = er + (o_ar * o_nm - er) * ln_vw;
wl = el + (wl - el) * g_mix; wr = er + (wr - er) * g_mix;
pwr_out(wl, wr); wl = pwr_l; wr = pwr_r;
ost_out(wl * g_out, wr * g_out);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;
rs_f < 1 ? ( rs_f = min(rs_f + rs_c, 1); spl0 *= rs_f * rs_f * (3 - 2 * rs_f); spl1 *= rs_f * rs_f * (3 - 2 * rs_f); );
by_out();
ln_pk = max(ln_pk, max(abs(spl0), abs(spl1)));

@gfx 900 400
ui_begin(900, 400);
v5_begin();
LNF = 0x2C3844; LNB = 0x10161C; LNI = 0xE6EEF4; LNI2 = 0xAEBECA; LNG = 0xFFCF6A; LNL = 0x8CC8F0; LNH = 0x2E1A0C; LNV = 0xFFD98A;
sc != lg_fsc ? (
  lg_fsc = sc;
  lg_kt = ui_fitfont(8, 16 * sc) / (16 * sc);
  lg_ka = ui_fitarial(10, 12 * sc) / (12 * sc);
  lg_f6 = ui_fitfont(6, 26 * sc);
);
function lg_ft(px) ( gfx_setfont(8, "Trebuchet MS", px * lg_kt * sc, 'b'); );
function lg_fa(px) ( gfx_setfont(10, "Arial", px * lg_ka * sc, 'b'); );
function lg_fc(px) ( gfx_setfont(12, "Courier New", px * lg_kt * sc, 'b'); );
function lg_tl(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lg_tr(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lg_tw(s) local(tw, th) ( gfx_measurestr(s, tw, th); tw / sc; );
