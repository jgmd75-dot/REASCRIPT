desc:WS9 Buss [buss colour] (GFX Lab)
//tags: buss bus folder summing colour transformer iron saturation headroom multiband harmonics glue compressor clipper broadcast
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-input, gfx-lab-output, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-sidebar
// (.jsfx-inc) in the same folder.
//
// WS9 BUSS. A colour box for a REAPER folder track (drum buss, guitar buss, vocal stack): the master section of a
// late-70s British location mixer, in the spirit of the small portable field desks of the time; the sound is designed
// from scratch. The third of the WS9 series (WS9 Comp, WS9 Channel): the same iron, the same battery supply and the
// same -18 dB HEADROOM sidebar - but here in four bands (JGWizrad's design, 30 Oct 2026): the folder's sum is split
// into LF / LMF / HMF / HF and each band has its own HEADROOM stage, so a kick's peak gains harmonics without dragging
// the guitars and the hats through the same saturation (no intermodulation between the bands). The four stages share
// one supply: a loud passage sags it and every band's ceiling dips together - the glue comes from the power rails,
// not from the instruments distorting each other.
// BANDS chooses how (JG, 30 Oct 2026: "offer both"): SPLIT = four stages, as above; STAGGER = JGWizrad's first idea:
// the bands are staggered in time (HF first, then HMF 3.3 ms, LMF 6.7 ms, LF 10 ms later) into ONE shared stage, so
// peaks that arrive together hit it one after another; its sidebar is split again and each band put back in time.
// Measured on a drum / bass / guitar buss (30 Oct 2026): STAGGER halves the intermodulation of a plain single stage,
// SPLIT removes it; harmonics that cross a band edge come back up to 3.3 ms out of time in STAGGER.
//
// SIGNAL FLOW
//   input -> DRIVE -> [oversampled: IN IRON -> HEADROOM (SPLIT: four sidebars / STAGGER: one, staggered)
//   -> GLUE (VCA) -> LEVEL -> OUT IRON]
//   -> DC blocker -> CLIP (-0.3 dBFS) -> out.  Linked stereo.
//
//   DRIVE      -20 .. +20 dB, the buss's input gain: it hits the four HEADROOM stages harder and drives the input iron,
//              whose drive follows DRIVE by the golden ratio (0.618 of its travel, as WS9 Channel's TRIM).
//   HEADROOM   automatic, not on the panel (JG): the sum is split (Linkwitz-Riley, 24 dB/oct) at 220 Hz, 1.1 kHz and
//              5.5 kHz. Only the sidebars use the split: each band is padded 18 dB, its peaks within 11 dB of 0 VU's
//              ceiling go through the WS9 soft curve, and what that adds is lifted back, high-passed at 220 Hz and
//              added to the untouched full-band signal on the same sample. The clean signal never goes through the
//              crossover, so it stays exactly as it was. (Each band is quieter than the sum, so the band stages sit
//              3 dB lower than WS9 Channel's single one, STAGGER's one stage 2 dB lower: the same amount of colour on a
//              busy buss either way.) gfx-lab-sidebar.
//   BANDS      SPLIT (default) / STAGGER, two lamp keys beside DRIVE. STAGGER delays the clean signal by 10 ms to stay in
//              time with its sidebar, so the unit's latency grows by 10 ms (reported); changing it dips the sound for
//              5 ms and swaps at the silent point (the latency changes), like the OS key.
//   GLUE       0 - 10, one knob: the threshold falls (-6 to -24 dBFS) as the ratio rises (1.5 to 3 : 1), a 10 dB knee,
//              half the reduction made up. SPEED (stepped) FAST / MED / SLOW (attack 3 / 10 / 30 ms, release 100 / 300 /
//              800 ms), with WS9 Comp's GRAB release (peaks let go sooner than the body). The lamp switches it in / out.
//   LEVEL      -24 .. +12 dB, the buss fader, into the output iron, whose drive follows LEVEL the same way.
//   SUPPLY     18 V battery, sagging a little on loud passages: both irons, all four HEADROOM ceilings and GLUE's release
//              move with it. Programme-dependent only: no DRIFT on a summing unit (JG).
//   OS         1x / 2x / 4x (default 2x): everything between DRIVE and the DC blocker runs at that rate.
//   BYPASS     the house BYPASS key: 15 ms crossfade to the untouched input, delayed by the latency.
//   CLIP       the house output stage's clipper, always on, ceiling -0.3 dBFS (anti-aliased).
// GUI: output VU (the house steady backlit glow, dimmed while bypassed), GAIN REDUCTION LED row, CLIP LED.
// PRESETS    10 (Init + 9) plus Reset all to defaults. A preset sets every control but BANDS, OS and BYPASS.
// Latency: 0 / 31 / 37 samples at 1x / 2x / 4x (reported), + 10 ms in STAGGER (480 samples at 48 kHz).

slider1:0<0,1,1{Off,On}>-Bypass
slider2:0<-20,20,0.1>-Drive (dB)
slider3:3<0,10,0.1>-Glue
slider4:1<0,2,1{Fast,Medium,Slow}>-Speed
slider5:1<0,1,1{Off,On}>-Glue in
slider6:0<-24,12,0.1>-Level (dB)
slider7:1<0,2,1{1x,2x,4x}>-Oversampling
slider8:0<0,1,1{Split,Stagger}>-Bands
slider9:prs_sel=0<0,10,1{No preset,Init,Drum Buss,Guitar Wall,Vocal Stack,Keys and Synths,Bass Group,Room Mics,Hot Drums,Gentle Glue,Clean Sum}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-input.jsfx-inc
import gfx-lab-output.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-sidebar.jsfx-inc

@init
#ui_man = "gfx-lab-ws9-buss";                                 // the ? pop-up links to this manual
ext_noinit = 1;

function lc_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );
function lc_tc(ms) ( 1 - exp(-1 / (max(ms, 0.005) * 0.001 * srate)); );
function lc_db(d) ( exp(d * 0.11512925464970228); );

// ---------- the iron (WS9 Comp's) ----------
// One transformer core at the running rate (base x os_f). Below the core's corner (a one-pole split, ~150 Hz IN,
// ~120 Hz OUT) the flux saturates on its own curve, with a small bias for the even harmonics (gl = its drive, b the
// bias, rb / kb keep it level and DC-free for small signals); then the whole signal meets the core's soft knee (g).
function ir_sat(x) ( x / sqrt(1 + x * x); );
function ir_run(u, g, gl, b, rb, kb, kc) instance(lp) local(lo) (
  lp += (u - lp) * kc;
  lo = (ir_sat(lp * gl + b) - rb) * kb / gl;
  ir_sat((u - lp + lo) * g) / g;
);
function ir_tgt(d, kg, kl, kbias, hb) instance(tg, tgl, tb, trb, tkb) (
  tg = lc_db(kg * d - 9) * hb; tgl = tg * (1 + kl * d); tb = kbias * d;
  trb = ir_sat(tb); tkb = (1 + tb * tb) ^ 1.5;
);
function ir_glide(k) instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) (
  g += (tg - g) * k; gl += (tgl - gl) * k; b += (tb - b) * k; rb += (trb - rb) * k; kb += (tkb - kb) * k;
);
function ir_snap() instance(tg, tgl, tb, trb, tkb, g, gl, b, rb, kb) ( g = tg; gl = tgl; b = tb; rb = trb; kb = tkb; );

// ---------- the four-band split (for the sidebars only) ----------
// One Linkwitz-Riley crossover = a TPT state-variable stage giving LP and HP, then a second LP on the LP and a second HP
// on the HP (24 dB/oct). Tree: 1.1 kHz splits LOW / HIGH, 220 Hz splits LOW into LF / LMF, 5.5 kHz splits HIGH into
// HMF / HF. The bands only feed the four HEADROOM stages, so no all-pass correction is needed (the clean signal never
// passes the crossover).
function xo_coef(f, fs) instance(c1, c2, c3) local(g) (
  g = tan($pi * min(f, 0.45 * fs) / fs); c1 = 1 / (1 + g * (g + 1.4142135623730951)); c2 = g * c1; c3 = g * c2;
);
function xo_run(x, c1, c2, c3) instance(a1, a2, b1, b2, d1, d2, lo, hi) local(v1, v2, v3, l, h) (
  v3 = x - a2; v1 = c1 * a1 + c2 * v3; v2 = a2 + c2 * a1 + c3 * v3; a1 = 2 * v1 - a1; a2 = 2 * v2 - a2;
  l = v2; h = x - 1.4142135623730951 * v1 - v2;
  v3 = l - b2; v1 = c1 * b1 + c2 * v3; v2 = b2 + c2 * b1 + c3 * v3; b1 = 2 * v1 - b1; b2 = 2 * v2 - b2;
  lo = v2;
  v3 = h - d2; v1 = c1 * d1 + c2 * v3; v2 = d2 + c2 * d1 + c3 * v3; d1 = 2 * v1 - d1; d2 = 2 * v2 - d2;
  hi = h - 1.4142135623730951 * v1 - v2;
);
function xo_clr() instance(a1, a2, b1, b2, d1, d2, lo, hi) ( a1 = a2 = b1 = b2 = d1 = d2 = lo = hi = 0; );
// one side's four sidebars: x in -> the sum of what the four HEADROOM stages add
function bd_run(x) local(s) (
  this.m.xo_run(x, xoM.c1, xoM.c2, xoM.c3);
  this.l.xo_run(this.m.lo, xoL.c1, xoL.c2, xoL.c3);
  this.h.xo_run(this.m.hi, xoH.c1, xoH.c2, xoH.c3);
  s = this.s0.sb_run(this.l.lo) + this.s1.sb_run(this.l.hi) + this.s2.sb_run(this.h.lo) + this.s3.sb_run(this.h.hi);
  s;
);
function bd_clr() ( this.m.xo_clr(); this.l.xo_clr(); this.h.xo_clr(); this.s0.sb_clr(); this.s1.sb_clr(); this.s2.sb_clr(); this.s3.sb_clr();
  this.n.xo_clr(); this.p.xo_clr(); this.q.xo_clr(); );
// STAGGER: one side's whole HEADROOM stage (x in -> x out, delayed by st_d running samples). The bands go into one
// shared sidebar staggered: HF now, HMF st_d / 3, LMF 2 st_d / 3, LF st_d later; the sidebar is split again and each band
// delayed by the rest, so every band's harmonics come out st_d after its cause; the clean signal is delayed st_d.
// Seven delay lines of ST_N at buf (0 - 2 the staggered bands, 3 the clean signal, 4 - 6 the re-aligned sidebar bands).
ST_N = 16384; ST_M = ST_N - 1;                         // 10 ms at 192 kHz x 4 = 7680 samples
function bd_stg(x, buf) local(w, d1, d2, s) (
  w = st_w; d1 = st_d / 3; d2 = 2 * d1;
  this.m.xo_run(x, xoM.c1, xoM.c2, xoM.c3);
  this.l.xo_run(this.m.lo, xoL.c1, xoL.c2, xoL.c3);
  this.h.xo_run(this.m.hi, xoH.c1, xoH.c2, xoH.c3);
  buf[w] = this.l.lo; buf[ST_N + w] = this.l.hi; buf[2 * ST_N + w] = this.h.lo; buf[3 * ST_N + w] = x;
  s = this.s0.sb_run(buf[(w - st_d) & ST_M] + buf[ST_N + ((w - d2) & ST_M)] + buf[2 * ST_N + ((w - d1) & ST_M)] + this.h.hi);
  this.n.xo_run(s, xoM.c1, xoM.c2, xoM.c3);
  this.p.xo_run(this.n.lo, xoL.c1, xoL.c2, xoL.c3);
  this.q.xo_run(this.n.hi, xoH.c1, xoH.c2, xoH.c3);
  buf[4 * ST_N + w] = this.p.hi; buf[5 * ST_N + w] = this.q.lo; buf[6 * ST_N + w] = this.q.hi;
  buf[3 * ST_N + ((w - st_d) & ST_M)] + this.p.lo
    + buf[4 * ST_N + ((w - d1) & ST_M)] + buf[5 * ST_N + ((w - d2) & ST_M)] + buf[6 * ST_N + ((w - st_d) & ST_M)];
);

// ---------- the compressor: gain computer and WS9 Comp's GRAB envelope (fixed at 50 %) - GLUE ----------
function cp_gc(lv) local(ov, k2) (
  ov = lv - cp_th; k2 = cp_kw * 0.5;
  -(ov <= -k2 ? 0 : ov >= k2 ? ov * cp_sl : cp_sl * sqr(ov + k2) / (2 * cp_kw));
);
function cp_env(t) instance(gp, gf, gs) (
  gp += (t < gp ? cp_ka : cp_kr) * (t - gp);
  gf += (t < gf ? cp_kaf : cp_krf) * (t - gf);
  gs += (t < gs ? cp_kas : cp_krs) * (t - gs);
  gp + 0.5 * (min(gf, gs) - gp);
);

// one oversampled sample of the buss, both sides (x = after DRIVE; ga / gb the VCA gains); out in lc_pl / lc_pr,
// GLUE's detector input (after the sidebars) in lc_wl / lc_wr
function lc_os(xl, xr, ga, gb) local(a, b) (
  a = iaL.ir_run(xl, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  b = iaR.ir_run(xr, iIn.g, iIn.gl, iIn.b, iIn.rb, iIn.kb, ir_kci);
  st_on ? ( a = bL.bd_stg(a, ST_L); b = bR.bd_stg(b, ST_R); st_w = (st_w + 1) & ST_M; ) : ( a += bL.bd_run(a); b += bR.bd_run(b); );
  lc_wl = a; lc_wr = b;
  a = obL.ir_run(a * ga * lc_lv, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);    // LEVEL is the fader into the output iron
  b = obR.ir_run(b * gb * lc_lv, iOut.g, iOut.gl, iOut.b, iOut.rb, iOut.kb, ir_kco);
  lc_pl = a; lc_pr = b;
);
function lc_rcoefs(f) local(w, fs) (
  fs = srate * f; w = 2 * $pi / fs; ir_kci = 1 - exp(-150 * w); ir_kco = 1 - exp(-120 * w);
  xoL.xo_coef(220, fs); xoM.xo_coef(1100, fs); xoH.xo_coef(5500, fs);
  sb_rate(fs); sb_ctl(1);
  st_d = st_db * f;                                   // the stagger window in running samples
);
function lc_clear() (
  uxL.os_clr(); uxR.os_clr(); dnL.os_clr(); dnR.os_clr();
  iaL.lp = iaR.lp = obL.lp = obR.lp = 0;
  bL.bd_clr(); bR.bd_clr();
  memset(ST_L, 0, 7 * ST_N); memset(ST_R, 0, 7 * ST_N); st_w = 0;
);

// after REAPER's own bypass (the unit stopped, its buffers stale): clear everything and fade in from the dry input
function lc_reset() (
  lc_clear(); memset(BY_BUF, 0, 2 * BY_N);
  eC.gp = eC.gf = eC.gs = 0; lc_msl = lc_msr = 0; lc_gp = lc_gn = 1;
  lc_dxl = lc_dyl = lc_dxr = lc_dyr = 0; in_dxL = in_dyL = in_dxR = in_dyR = 0; sg_e = 0; vu_ms = 0;
  lc_fi = 0;
);

// ---------- presets ----------
#lc_pm = "Init|Drum Buss|Guitar Wall|Vocal Stack|Keys and Synths|Bass Group|Room Mics|Hot Drums|Gentle Glue|Clean Sum";
function lc_set(dr, gl, sp, lv) ( slider2 = dr; slider3 = gl; slider4 = sp; slider5 = 1; slider6 = lv; );
function load_preset(p) local(i) (
  //                    drive glue spd  level
  p == 1  ? lc_set(   0,   3,   1,    0) :     // Init
  p == 2  ? lc_set(   6,   5,   0,   -5) :     // Drum Buss
  p == 3  ? lc_set(   4,   4,   1,   -3) :     // Guitar Wall
  p == 4  ? lc_set(   2,   4,   2,   -1) :     // Vocal Stack
  p == 5  ? lc_set(   3,   3,   2,   -2) :     // Keys and Synths
  p == 6  ? lc_set(   5,   5,   2,   -4) :     // Bass Group
  p == 7  ? lc_set(   8,   6,   1,   -7) :     // Room Mics
  p == 8  ? lc_set(  12,   6,   0,  -10) :     // Hot Drums
  p == 9  ? lc_set(   0,   2,   2,    0) :     // Gentle Glue
  p == 10 ? lc_set(  -6,   0,   1,    6) :     // Clean Sum
  p == 11 ? lc_set(   0,   3,   1,    0);      // Reset all to defaults
  i = 2; loop(5, ui_auto(i); i += 1; );
  pr_cur = p == 11 ? 1 : p;
);

// ---------- state ----------
function lc_srinit() (
  lc_sr = srate;
  lc_kd = lc_tc(5);                                   // GLUE's detector: a 5 ms mean square
  c_kn = lc_tc(30); c_sw = lc_tc(15);
  c_k32 = 1 - exp(-32 / (0.03 * srate));             // control-rate glides
  sg_k = lc_tc(60);                                   // the supply's sag follows the level over ~60 ms
  vu_k = lc_tc(300);
  lc_dcc = 1 - 2 * $pi * 5 / srate;                   // the 5 Hz DC blocker (the iron's bias)
  lc_fis = 1 / (0.01 * srate);
  st_db = 3 * floor(0.01 * srate / 3 + 0.5);         // STAGGER's 10 ms window in base samples (a multiple of 3)
  os_base = st_on ? st_db : 0;
  ost_init(0);
  lc_rcoefs(os_f); lc_clear();
);
os_design();
ST_L = 1048576; ST_R = ST_L + 7 * ST_N;               // STAGGER's delay lines
os_f = os_tf = os_f2n(slider7);
st_on = st_t = slider8 >= 0.5; st_g = 1; st_hold = 0;
lc_srinit();
os_gsetup();
in_init();
lc_snap = 1; lc_fi = 1; lc_cr = 0;
ST_HR = 12;
pdc_delay = os_base + os_lat(os_f);
by_setup(1);

ui_thm = 5; ui_hw = 1;                                // house keycaps for the preset bar and the size picker
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );                // new instances open in Medium, on Init
ui_dflt = 1;

// PRESET parameter (JG, 28 Oct 2026: accessibility). A change of prs_sel loads that preset (0 = nothing loaded); the
// preset bar asks through prs_dirty. Both load here, on the audio side only. prs_last is saved, so opening a project
// never reloads a preset over its settings.
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k <= 10 ? ( prs_sel = k; slider_automate(prs_sel); prs_cur_d = k; );
    prs_last = prs_sel;
  ) : prs_ok ? (
    prs_sel = max(0, min(10, prs_sel | 0));
    prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 ? ( load_preset(prs_sel); prs_cur_d = prs_sel; ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;   // PRESET parameter: no reload on recall

@block
prs_chk();
srate != lc_sr ? lc_srinit();
lc_now = time_precise();
lc_tp > 0 && lc_now - lc_tp > max(0.25, 4 * samplesblock / srate) ? lc_reset();   // a gap: REAPER's bypass came off
lc_tp = lc_now;
in_setup(min(max(slider2, -20), 20), 0);
ost_setup(0, 0.3, 120, 6000, -0.3, 1);                // the house output stage: CLIP at -0.3 dBFS
os_tf = os_f2n(slider7); pdc_delay = os_base + os_lat(os_f);   // (ost_setup zeroes pdc_delay)
st_t = slider8 >= 0.5;
pdc_bot_ch = 0; pdc_top_ch = 2;                        // (in_pin / out_pin: REAPER carries any other channels round)
// the battery supply (18 V), sagging a little on loud passages (no drift: a summing unit); less voltage = less headroom
lc_sag = 0.35 * min(sqrt(sg_e) / 0.5, 1);
lc_v = max(18 - lc_sag, 15);
lc_hb = (18 / lc_v) ^ 1.5;
// the iron follows DRIVE and LEVEL by the golden ratio (as WS9 Channel): 3 of 10 at 0 dB
iIn.ir_tgt(min(max(0.3 + 0.618 * min(max(slider2, -20), 20) / 20, 0), 1), 21, 0.8, 0.1, lc_hb);
iOut.ir_tgt(min(max(0.3 + 0.618 * min(max(slider6, -24), 12) / 20, 0), 1), 19, 2, 0.25, lc_hb);
// HEADROOM: automatic (JG: not on the panel); SPLIT's four stages sit 3 dB lower than WS9 Channel's single stage, since
// each band is quieter than the sum (STAGGER's one stage sees the staggered sum: ST_HR, 2 dB lower; both matched to
// WS9 Channel's amount by measurement); all share the supply (lc_hb)
sb_target(st_on ? ST_HR : 11, 1, 1, 220, lc_hb);
// GLUE
cp_k = min(max(slider3, 0), 10);
cp_tht = -6 - 1.8 * cp_k;
cp_slt = 1 - 1 / (1.5 + 0.15 * cp_k); cp_kw = 10;
cp_am = min(cp_k, 1);
cp_spd = floor(min(max(slider4, 0), 2) + 0.5);
cp_att = cp_spd == 0 ? 3 : cp_spd == 1 ? 10 : 30; cp_rel = (cp_spd == 0 ? 100 : cp_spd == 1 ? 300 : 800) * (18 / lc_v);
cp_ka = lc_tc(cp_att); cp_kr = lc_tc(cp_rel);
cp_kaf = lc_tc(cp_att / 2.5); cp_krf = lc_tc(0.25 * cp_rel);
cp_kas = lc_tc(10 * cp_att + 20); cp_krs = lc_tc(2.5 * cp_rel);
cp_mt = slider5 >= 0.5;
lc_lvt = lc_db(min(max(slider6, -24), 12));
lc_snap ? (
  cp_th = cp_tht; cp_sl = cp_slt; cp_mk = 0; lc_lv = lc_lvt;
  cp_m = cp_mt; iIn.ir_snap(); iOut.ir_snap(); lc_gp = lc_gn = 1; sb_snap();
);
lc_snap = 0;
iaL.lp = lc_tn(iaL.lp); iaR.lp = lc_tn(iaR.lp); obL.lp = lc_tn(obL.lp); obR.lp = lc_tn(obR.lp);
lc_msl = lc_tn(lc_msl); lc_msr = lc_tn(lc_msr); sg_e = lc_tn(sg_e);
// the panel's mailboxes
lca_gr_d = min(lca_gr_d, lc_grm); lc_grm = 0;
lca_cl_d = max(lca_cl_d, lc_clp); lc_clp = 0;
lca_vu_d = vu_ms;

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
in_process(spl0, spl1);
lc_xl = in_l; lc_xr = in_r;
abs(lc_xl) < 0.000000000000001 ? lc_xl = 0; abs(lc_xr) < 0.000000000000001 ? lc_xr = 0;
// glides (no steps on a knob move, a switch or a preset change)
iIn.ir_glide(c_kn); iOut.ir_glide(c_kn);
sb_glide(c_kn, c_sw);
cp_m += (cp_mt - cp_m) * c_sw;
cp_th += (cp_tht - cp_th) * c_kn; cp_sl += (cp_slt - cp_sl) * c_kn; lc_lv += (lc_lvt - lc_lv) * c_kn;
(lc_cr -= 1) <= 0 ? ( lc_cr = 32; sb_ctl(c_k32); );
sg_e += (max(lc_xl * lc_xl, lc_xr * lc_xr) - sg_e) * sg_k;
os_gate();
os_chg ? ( lc_rcoefs(os_f); lc_clear(); os_hold += 2 * samplesblock; );
// BANDS: SPLIT <-> STAGGER changes the latency, so (as the OS key) dip 5 ms, swap at the silent point, come back
st_t != st_on ? (
  st_g = max(st_g - os_gc, 0);
  st_g == 0 ? (
    st_on = st_t; os_base = st_on ? st_db : 0; pdc_delay = os_base + os_lat(os_f);
    lc_clear(); st_hold = os_base + os_lat(os_f) + 8 + 2 * samplesblock;
  );
) : st_hold > 0 ? st_hold -= 1 : st_g < 1 ? st_g = min(st_g + os_gc, 1);
// the oversampled section; the VCA's gain steps from the last sample's to this one's across the phases
uxL.os_up(lc_xl); uxR.os_up(lc_xr);
os_f == 1 ? (
  lc_os(uxL.s0, uxR.s0, lc_gn, lc_gn); lc_dpl = lc_wl; lc_dpr = lc_wr; lc_yl = lc_pl; lc_yr = lc_pr;
) : (
  lc_dd = (lc_gn - lc_gp) / os_f;
  lc_os(uxL.s0, uxR.s0, lc_gp + lc_dd, lc_gp + lc_dd); lc_dpl = lc_wl; lc_dpr = lc_wr; lc_a0 = lc_pl; lc_b0 = lc_pr;
  lc_os(uxL.s1, uxR.s1, lc_gp + 2 * lc_dd, lc_gp + 2 * lc_dd); lc_a1 = lc_pl; lc_b1 = lc_pr;
  os_f == 2 ? ( lc_yl = dnL.os_dn(lc_a0, lc_a1, 0, 0); lc_yr = dnR.os_dn(lc_b0, lc_b1, 0, 0); ) : (
    lc_os(uxL.s2, uxR.s2, lc_gp + 3 * lc_dd, lc_gp + 3 * lc_dd); lc_a2 = lc_pl; lc_b2 = lc_pr;
    lc_os(uxL.s3, uxR.s3, lc_gn, lc_gn); lc_a3 = lc_pl; lc_b3 = lc_pr;
    lc_yl = dnL.os_dn(lc_a0, lc_a1, lc_a2, lc_a3); lc_yr = dnR.os_dn(lc_b0, lc_b1, lc_b2, lc_b3);
  );
);
// GLUE's detector (after the sidebars, its base-rate phase), linked; its gain reaches the VCA one sample later
lc_msl += lc_kd * (lc_dpl * lc_dpl - lc_msl); lc_msr += lc_kd * (lc_dpr * lc_dpr - lc_msr);
cp_t = cp_am * cp_gc(10 * log10(max(max(lc_msl, lc_msr), 0.00000000001)) + 3.0103);
cp_g = eC.cp_env(cp_t);
cp_mk += (-0.5 * cp_am * cp_gc(-12) - cp_mk) * c_kn;                  // half the reduction made up
lc_grm = min(lc_grm, cp_m * cp_g);
lc_gp = lc_gn; lc_gn = exp(0.115129255 * cp_m * (cp_g + cp_mk));
// the iron's bias leaves a little DC: a 5 Hz blocker
lc_z = lc_yl - lc_dxl + lc_dcc * lc_dyl; lc_dxl = lc_yl; lc_dyl = lc_z; lc_yl = lc_z;
lc_z = lc_yr - lc_dxr + lc_dcc * lc_dyr; lc_dxr = lc_yr; lc_dyr = lc_z; lc_yr = lc_z;
lc_osg = os_g * os_g * (3 - 2 * os_g) * st_g * st_g * (3 - 2 * st_g);   // the OS / BANDS swaps' dips (S-curves)
lc_yl *= lc_osg; lc_yr *= lc_osg;
lc_yl != lc_yl ? lc_yl = 0; lc_yr != lc_yr ? lc_yr = 0;
lc_fi < 1 ? (                                                          // fading in after a reset, from the dry input
  lc_fi = min(lc_fi + lc_fis, 1); lc_z = lc_fi * lc_fi * (3 - 2 * lc_fi);
  lc_a = by_d == 0 ? by_il : BY_BUF[(by_w - by_d) & (BY_N - 1)]; lc_b = by_d == 0 ? by_ir : BY_BUF[BY_N + ((by_w - by_d) & (BY_N - 1))];
  lc_yl = lc_a + lc_z * (lc_yl - lc_a); lc_yr = lc_b + lc_z * (lc_yr - lc_b);
);
max(abs(lc_yl), abs(lc_yr)) > 0.89 ? lc_clp = 1;                       // the CLIP lamp: into the clipper's knee
ost_out(lc_yl, lc_yr);
spl0 = max(-4, min(4, ost_l));
spl1 = max(-4, min(4, ost_r));
by_out();
vu_ms += (0.5 * (spl0 * spl0 + spl1 * spl1) - vu_ms) * vu_k;

@gfx 1080 340
ui_begin(1080, 340);
// =====================================================================
// GUI - the master section of a location mixer: a mustard steel faceplate with a navy header band and brick-red accents,
// one plate (INPUT with the BANDS keys, GLUE, OUTPUT) and the METERS. WS9 Comp's 70s desk knobs (black fluted skirts, flat coloured caps),
// a round lamp by GLUE (click = in / out), the output VU with the house glow, the GAIN REDUCTION LED row, CLIP.
// Design space 1080 x 340. Knobs: drag (SHIFT = fine), wheel, double-click = default; the name shows the value while
// the knob is touched.
// =====================================================================
// mustard, navy and brick (the WS9 family: Comp duck-egg / navy / brick, Channel cream / brick)
LVP = 0xC69C35; LVPS = 0xD2AA45; LVPH = 0x1F2B45; LVPW = 0x7A5E1C; LVI = 0x1B1610; LVT = 0xF1E6CC; LVA = 0xA8321F;
LVI2 = ui_mix(LVI, LVP, 0.38); LVT2 = ui_mix(LVT, LVPH, 0.38);
// cap colours from the 70s British desk JG sent (as WS9 Comp): red GLUE, bottle green SPEED, blue DRIVE (the iron), grey LEVEL
CRD = 0xC4222B; CSL = 0x2D5A48; CBL = 0x2F62A6; CGY = 0xBDC0BA;

sc != lv_fsc ? (
  lv_fsc = sc;
  lv_f10 = ui_fitfont(10, 14 * sc);     // knob labels
  lv_f11 = ui_fitfont(11, 15 * sc);     // section titles
  lv_f12 = ui_fitfont(12, 11 * sc);     // printed scales
  lv_f13 = ui_fitfont(13, 14 * sc);     // lamp-key legends
  lv_f14 = ui_fitfont(14, 27 * sc);     // the title
  lv_f15 = ui_fitfont(15, 11.5 * sc);   // the subtitle
);
gfx_setfont(10, "Trebuchet MS", lv_f10, 'b'); gfx_setfont(11, "Trebuchet MS", lv_f11, 'b');
gfx_setfont(12, "Trebuchet MS", lv_f12, 'b'); gfx_setfont(13, "Trebuchet MS", lv_f13, 'b');
gfx_setfont(14, "Trebuchet MS", lv_f14, 'b'); gfx_setfont(15, "Trebuchet MS", lv_f15, 'b');

function lv_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, max(1, w * sc), max(1, h * sc)); );
function lv_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lv_ltxt(x, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = x * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function lv_thick(x1, y1, x2, y2, w) ( ui_ssline(x1, y1, x2, y2, w, 0); );
// soft drop shadow (light from the top left): 4 layers at 13 % black, (+2, +3) to (+6, +8)
function lv_shadow(x, y, w, h) local(j) ( j = 0; loop(4, ui_cola(0x000000, 0.13); lv_r(x + 2 + j * 1.3, y + 3 + j * 1.6, w + j * 0.6, h + j * 0.6); j += 1; ); );
// a plate: a dark seam round it, the face, a header band (32 high) with a cream rule under it
function lv_plate(x, y, w, h) (
  lv_shadow(x, y, w, h);
  ui_col(LVPW); lv_r(x, y, w, h);
  ui_col(LVPS); lv_r(x + 1, y + 1, w - 2, h - 2);
  ui_cola(0xFFFFFF, 0.07); lv_r(x + 1, y + 1, w - 2, 1); lv_r(x + 1, y + 1, 1, h - 2);
  ui_cola(0x000000, 0.22); lv_r(x + 1, y + h - 3, w - 2, 2); lv_r(x + w - 3, y + 1, 2, h - 2);
  ui_col(LVPH); lv_r(x + 1, y + 1, w - 2, 32);
  ui_cola(LVT, 0.35); lv_r(x + 1, y + 33, w - 2, 1);
);
function lv_title(x, y, s) ( gfx_setfont(11); ui_col(LVT); lv_ltxt(x + 14, y + 17, s); );
// a thin inked line between two sections on one plate
function lv_split(x, y, h) ( ui_col(LVPW); lv_r(x, y + 1, 1, h - 2); ui_cola(0xFFFFFF, 0.06); lv_r(x + 1, y + 34, 1, h - 35); );
// a switched-off section: the face colour at about 50 % over its content
function lv_grey(x, y, w, h) ( ui_cola(LVPS, 0.55); lv_r(x + 1, y + 34, w - 1, h - 37); );
function lv_tog(idx) ( slider(idx) = slider(idx) >= 0.5 ? 0 : 1; ui_auto(idx); );
// the section title lamp: a round ring lamp (cream ring, amber centre, a soft halo when lit) left of the title;
// clicking it switches the section in / out
function lv_tlamp(x, y, s, idx) local(cx, cy, on, hov, j) (
  cx = x + 22; cy = y + 17; on = slider(idx) >= 0.5;
  hov = sqr(mouse_x - cx * sc) + sqr(mouse_y - cy * sc) <= sqr(12 * sc);
  hov && pressed && drag_id == 0 ? ( lv_tog(idx); drag_id = -1; on = !on; );
  on ? ( j = 0; loop(4, ui_cola(0xFFB030, 0.07); gfx_circle(cx * sc, cy * sc, (8.5 + j * 2) * sc, 1, 1); j += 1; ); );
  ui_cola(0x000000, 0.35); gfx_circle((cx + 1) * sc, (cy + 1.5) * sc, 7.5 * sc, 1, 1);
  ui_col(0xE8E0CB); gfx_circle(cx * sc, cy * sc, 7.5 * sc, 1, 1);
  ui_col(0x2A2418); gfx_circle(cx * sc, cy * sc, 5.4 * sc, 1, 1);
  ui_col(on ? 0xFFB030 : 0x5A4022); gfx_circle(cx * sc, cy * sc, 4.5 * sc, 1, 1);
  on ? ( ui_cola(0xFFF0C8, 0.75); gfx_circle((cx - 1.3) * sc, (cy - 1.3) * sc, 1.7 * sc, 1, 1); );
  hov ? ( ui_cola(0xFFFFFF, 0.12); gfx_circle(cx * sc, cy * sc, 7.5 * sc, 1, 1); );
  gfx_setfont(11); ui_col(LVT); lv_ltxt(x + 38, y + 17, s);
);

// a lamp key (gfx-ui)
function lv_key(x, y, w, h, lbl, on, col) ( lk_well = 0x0A0B0A; lk_font = 13; lk_font2 = 13; lk_fit(x, y, w, h, on, col, lbl); );
// knobs: the C2M desk knob; lv_lg = log scale, lv_step = stepped (set before; cleared after)
lv_lg = 0; lv_step = 0;
function lv_kn(v, lo, hi) ( lv_lg ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function lv_kv(n, lo, hi) ( lv_lg ? lo * exp(n * log(hi / lo)) : lo + n * (hi - lo); );
// the knob (from the 70s British desk JG sent): a black fluted skirt, a flat coloured cap, a white pointer line running
// across cap and skirt; a ring of dots round it (nd steps). Design px.
function lv_cap(cx, cy, r, a, act, cap, nd) local(i, t, x, y, rr) (
  x = cx * sc; y = cy * sc; rr = r * sc;
  ui_col(LVI); i = 0;
  loop(nd + 1, t = -0.75 * $pi + i / nd * 1.5 * $pi;
    gfx_circle(x + sin(t) * (rr + 7 * sc), y - cos(t) * (rr + 7 * sc), (i == 0 || i == nd ? 1.5 : 1.2) * sc, 1, 1); i += 1; );
  i = 0; loop(4, ui_cola(0x000000, 0.13); gfx_circle(x + (2 + i * 1.3) * sc, y + (3 + i * 1.6) * sc, rr + i * 0.6 * sc, 1, 1); i += 1; );
  ui_col(0x121212); gfx_circle(x, y, rr, 1, 1);                                   // the skirt
  i = 0; loop(30, t = i / 30 * 2 * $pi; ui_col(0x34343A);                         // its flutes
    ui_ssline(x + sin(t) * rr * 0.74, y - cos(t) * rr * 0.74, x + sin(t) * rr * 0.95, y - cos(t) * rr * 0.95, 1.1 * sc, 0); i += 1; );
  i = 0; loop(5, ui_cola(0x000000, 0.14 * (1 - i / 5)); gfx_circle(x, y, rr - i * 0.8 * sc, 0, 1); i += 1; );   // vignette edge
  ui_cola(0xFFFFFF, act ? 0.22 : 0.14); ui_ssarc(x, y, rr * 0.97, -1.9, -0.1, 1 * sc);
  ui_col(ui_mix(cap, 0x000000, 0.45)); gfx_circle(x, y, rr * 0.66, 1, 1);         // the cap
  ui_col(cap); gfx_circle(x, y, rr * 0.62, 1, 1);
  i = 0; loop(4, ui_cola(0x000000, 0.06 * (1 - i / 4)); gfx_circle(x, y, rr * 0.62 - i * 0.8 * sc, 0, 1); i += 1; );
  ui_cola(0xFFFFFF, act ? 0.34 : 0.24); ui_ssarc(x, y, rr * 0.55, -1.7, -0.25, 1 * sc);
  ui_col(((cap >> 16) & 255) * 0.3 + ((cap >> 8) & 255) * 0.59 + (cap & 255) * 0.11 > 165 ? 0x1A1A18 : 0xF7F5EE);   // dark on light caps
  ui_ssline(x + sin(a) * rr * 0.12, y - cos(a) * rr * 0.12, x + sin(a) * rr * 0.96, y - cos(a) * rr * 0.96, (r > 24 ? 3 : 2.5) * sc, 1);
);
function lv_knob(cx, cy, r, idx, lo, hi, def, cap, nd) local(v, n, dx, dy, hov, did, act) (
  did = 1700 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? (
    (time_precise() - lv_lt < 0.35 && lv_lid == idx) || (mouse_cap & 4) ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; lv_lt = 0; ) : (
      drag_id = did; lv_y = mouse_y; lv_dz = 0; lv_lt = time_precise(); lv_lid = idx; lv_n = lv_kn(v, lo, hi);
    );
  );
  drag_id == did ? (
    lv_dz += abs(lv_y - mouse_y);
    lv_dz > 3 * sc ? (
      lv_n = min(max(lv_n + (lv_y - mouse_y) / (((mouse_cap & 8) ? 1000 : (lv_step ? 160 : 200)) * sc), 0), 1);
      v = lv_kv(lv_n, lo, hi); lv_step ? v = floor(v + 0.5);
      slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
    );
    lv_y = mouse_y;
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    lv_step ? slider(idx) = min(max(floor(v + 0.5) + sign(mouse_wheel), lo), hi) : (
      n = min(max(lv_kn(v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03), 0), 1);
      slider(idx) = lv_kv(n, lo, hi);
    );
    ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = min(max(lv_kn(v, lo, hi), 0), 1);
  act = hov || drag_id == did;
  lv_cap(cx, cy, r, -0.75 * $pi + n * 1.5 * $pi, act, cap, nd);
  lv_lg = 0; lv_step = 0;
  act;
);
// the name under a knob (centre cy + r + 19), the value in its place while touched
function lv_name(cx, cy, r, act, name, val) ( gfx_setfont(10); ui_col(act ? LVA : LVI); lv_ctxt(cx, cy + r + 19, act ? val : name); );
// printed figures round a knob: n positions, labels "a|b|c" (empty = none)
function lv_scale(cx, cy, r, n, nr, labels) local(i, k, k0, len, c, a) (
  len = strlen(labels); k0 = 0; i = 0; k = 0;
  gfx_setfont(12); ui_col(LVI2);
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? (
      strcpy_substr(#lv_sl, labels, k0, k - k0);
      a = -0.75 * $pi + i / max(n - 1, 1) * 1.5 * $pi;
      strlen(#lv_sl) ? lv_ctxt(cx + sin(a) * (r + nr), cy - cos(a) * (r + nr), #lv_sl);
      i += 1; k0 = k + 1;
    );
    k += 1;
  );
);
function lv_rivet(x, y) ( ui_cola(0x000000, 0.35); gfx_circle((x + 1) * sc, (y + 1.5) * sc, 4 * sc, 1, 1);
  ui_col(0x8A909C); gfx_circle(x * sc, y * sc, 4 * sc, 1, 1); ui_col(0xB6BCC6); gfx_circle((x - 0.8) * sc, (y - 0.8) * sc, 2.4 * sc, 1, 1); );
// a status LED: 6 px round in a black ring, a small highlight and halo when lit
function lv_led(cx, cy, col, lit) (
  lit ? ( ui_cola(col, 0.14); gfx_circle(cx * sc, cy * sc, 10 * sc, 1, 1); ui_cola(col, 0.18); gfx_circle(cx * sc, cy * sc, 8 * sc, 1, 1); );
  ui_col(0x07080A); gfx_circle(cx * sc, cy * sc, 7.5 * sc, 1, 1);
  ui_col(lit ? col : ui_mix(col, 0x101216, 0.78)); gfx_circle(cx * sc, cy * sc, 5.6 * sc, 1, 1);
  lit ? ( ui_cola(0xFFFFFF, 0.55); gfx_circle((cx - 1.6) * sc, (cy - 1.8) * sc, 1.8 * sc, 1, 1); );
);

// =====================================================================
// Faceplate and header
// =====================================================================
ui_col(ui_mix(LVP, 0x000000, 0.3)); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(LVP); lv_r(0, 0, 1080, 340);
ui_cola(0xFFFFFF, 0.06); lv_r(0, 0, 1080, 1.5); lv_r(0, 0, 1.5, 340);
ui_cola(0x000000, 0.30); lv_r(0, 337, 1080, 3); lv_r(1077, 0, 3, 340);       // a narrow darker bottom / right edge
lv_rivet(8, 8); lv_rivet(1071, 8); lv_rivet(8, 331); lv_rivet(1071, 331);
ui_col(LVPH); lv_r(16, 10, 1048, 54);
ui_cola(0x000000, 0.3); lv_r(16, 10, 1048, 1); lv_r(16, 10, 1, 54);
ui_col(LVA); lv_r(16, 64, 1048, 2);
// the GFX roundel and the title
ui_col(0xF0A63A); gfx_circle(44 * sc, 37 * sc, 15 * sc, 1, 1);
gfx_setfont(4); ui_col(0x2A1E10); ui_text(44 * sc, 31.5 * sc, "GFX");
gfx_setfont(14); ui_col(LVT); lv_ltxt(70, 37, "WS9"); gfx_measurestr("WS9", lv_tw, lv_th);
lv_tx = 70 + lv_tw / sc + 14;
gfx_setfont(15); ui_col(LVT2); lv_ltxt(lv_tx, 29, "LOCATION"); lv_ltxt(lv_tx, 45, "BUSS");
pk_pextra = "Reset all to defaults";
prs_cur_d > 0 ? ( pr_cur = prs_cur_d; prs_cur_d = 0; );     // PRESET parameter: show a preset loaded by the host
k_ = pk_preset(316 * sc, 20 * sc, 316 * sc, 34 * sc, pr_cur, #lc_pm);
k_ > 0 ? prs_dirty = k_;
by_key(756, 23, 1, 18);
os_key(904, 26, 7, LVT2, 17);
ui_size_picker(1002 * sc, 28 * sc);
ui_vu_dim = slider1 >= 0.5;

// =====================================================================
// INPUT | GLUE | OUTPUT  (the four HEADROOM stages are automatic: nothing on the panel - JG, 30 Oct 2026)
// =====================================================================
lv_plate(16, 78, 768, 246);
lv_split(300, 78, 246); lv_split(600, 78, 246);
lv_k1 = 204;
lv_title(16, 78, "INPUT");
lv_scale(110, lv_k1, 32, 3, 19, "-20|0|+20");
lv_a = lv_knob(110, lv_k1, 32, 2, -20, 20, 0, CBL, 4); sprintf(#lvv, "%+.1f dB", slider2); lv_name(110, lv_k1, 32, lv_a, "DRIVE", #lvv);
// BANDS: SPLIT / STAGGER (yellow: a model choice)
gfx_setfont(10); ui_col(LVI); lv_ctxt(242, 132, "BANDS");
lv_bx = 194; lv_bw = 96; lv_bh = 44;
lv_key(lv_bx, 150, lv_bw, lv_bh, "SPLIT", slider8 < 0.5, LK_YEL);
lv_key(lv_bx, 204, lv_bw, lv_bh, "STAGGER", slider8 >= 0.5, LK_YEL);
mouse_cap & 1 && !(lv_lmc & 1) && drag_id == 0 && mouse_x >= lv_bx * sc && mouse_x < (lv_bx + lv_bw) * sc ? (
  mouse_y >= 150 * sc && mouse_y < (150 + lv_bh) * sc ? ( slider8 = 0; ui_auto(8); drag_id = -1; );
  mouse_y >= 204 * sc && mouse_y < (204 + lv_bh) * sc ? ( slider8 = 1; ui_auto(8); drag_id = -1; );
);
lv_lmc = mouse_cap;
gfx_setfont(12); ui_col(LVI2); lv_ctxt(242, 266, slider8 >= 0.5 ? "+10 ms" : "NO DELAY");
// GLUE
lv_scale(394, lv_k1, 28, 2, 18, "0|10");
lv_a = lv_knob(394, lv_k1, 28, 3, 0, 10, 3, CRD, 4); sprintf(#lvv, "%.1f", slider3); lv_name(394, lv_k1, 28, lv_a, "GLUE", #lvv);
lv_scale(514, lv_k1, 20, 3, 18, "FAST|MED|SLOW");
lv_step = 1; lv_a = lv_knob(514, lv_k1, 20, 4, 0, 2, 1, CSL, 2);
lv_name(514, lv_k1, 24, lv_a, "SPEED", slider4 < 0.5 ? "FAST" : slider4 < 1.5 ? "MEDIUM" : "SLOW");
slider5 < 0.5 ? lv_grey(300, 78, 300, 246);
lv_tlamp(300, 78, "GLUE", 5);
// OUTPUT
lv_title(600, 78, "OUTPUT");
lv_scale(692, lv_k1, 32, 4, 19, "-24||0|+12");
lv_a = lv_knob(692, lv_k1, 32, 6, -24, 12, 0, CGY, 6); sprintf(#lvv, "%+.1f dB", slider6); lv_name(692, lv_k1, 32, lv_a, "LEVEL", #lvv);

// =====================================================================
// METERS: the output VU (backlit), the GAIN REDUCTION LED row, CLIP
// =====================================================================
lv_plate(800, 78, 264, 246);
lv_title(800, 78, "METERS");
lv_vu = lca_vu_d > 0.0000000001 ? 10 * log10(2 * lca_vu_d) + 18 : -40;          // a sine at -18 dBFS = 0 VU
vuO.ui_vu(846 * sc, 124 * sc, 172 * sc, 100 * sc, lv_vu, "OUT");
// GAIN REDUCTION: 8 LEDs at 1, 2, 3, 4, 6, 8, 10, 14 dB (green > yellow > red)
!lv_mi ? ( lv_gr = 0; lv_mi = 1; );
lv_g = -lca_gr_d; lca_gr_d = 0;
lv_gr = lv_g > lv_gr ? lv_g : max(lv_gr - 0.6, 0);
gfx_setfont(10); ui_col(LVI); lv_ltxt(822, 248, "GAIN REDUCTION  dB");
// CLIP: the clipper at -0.3 dBFS is working (held 0.4 s)
lca_cl_d > 0 ? lv_ct = time_precise(); lca_cl_d = 0;
gfx_setfont(12); ui_col(LVI); lv_ltxt(992, 248, "CLIP");
lv_led(1032, 248, 0xFF3A2A, time_precise() - lv_ct < 0.4);
lv_i = 0;
loop(8,
  lv_d = lv_i == 0 ? 1 : lv_i == 1 ? 2 : lv_i == 2 ? 3 : lv_i == 3 ? 4 : lv_i == 4 ? 6 : lv_i == 5 ? 8 : lv_i == 6 ? 10 : 14;
  lv_x = 838 + lv_i * 27;
  lv_led(lv_x, 278, lv_i < 4 ? 0x3CE05A : lv_i < 6 ? 0xFFC81E : 0xFF3A2A, lv_gr >= lv_d - 0.25);
  gfx_setfont(12); ui_col(LVI2); sprintf(#lvd, "%d", lv_d); lv_ctxt(lv_x, 298, #lvd);
  lv_i += 1;
);

pk_end();
ui_end();
