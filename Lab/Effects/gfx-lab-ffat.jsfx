desc: GFX Lab Ffat [multi-fx]
//tags: multi-fx drive filter flanger compressor bass enhancer
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-lab-output, gfx-lab-clip, gfx-lab-lfo, gfx-lab-os (.jsfx-inc) in the same folder.
//
// (The name: "ff" is fortissimo - very loud.)
// Ffat - a fat multi-effect: drive, two filters, a band filter, the magic EQ, a flanger, a compressor and a squash,
// in one box. Written from the published feature set of the classic freeware multi-effects of its kind (clean-room:
// nothing taken from any original binary). Brand names stay out of the panel and the FX list.
//
// SIGNAL FLOW
//   DRIVE <> FILTER 1 / FILTER 2 (ORDER) > BAND > MAGIC > FLANGER > COMP > FFAT > OUTPUT, DRY/WET > CLIP (-0.3 dBFS)
// DRIVE     TUBE  soft curve (house clip kit SOFT), asymmetric and biased: even harmonics
//           FUZZ  hard clip with a dead zone that opens with DRIVE (starved-bias gate)
//           RECT  rectifier: full-wave |x| blended with a soft stage (octave-up), DC removed
//           CRUSH bit depth (16 -> 3 bits) and sample-rate hold (1 -> 24 samples) - aliasing on purpose
//           TUBE / FUZZ / RECT are anti-aliased (ADAA, clip kit) behind the kit's drive-tracking pre-filter,
//           and level-matched at -12 dBFS (DRIVE changes the character, not the loudness). MIX blends it in
//           (the dry side is delayed half a sample to line up with ADAA, so the blend doesn't comb).
//           The drive is the only stage that runs oversampled (OS key: 1x / 2x / 4x, default 1x = as before).
// FILTER 1 / FILTER 2   state-variable (TPT, Cytomic): OFF, LP 12, LP 24, HP 12, HP 24, BAND, NOTCH;
//           CUT, RES, and how far the LFO and the envelope move the cutoff (+/- 4 octaves each).
//           24 dB modes = a Butterworth stage + the resonant stage. Coefficients refresh every 8 samples.
// ROUTE     the filters in SERIES or PARALLEL;  ORDER  drive before or after the filters
// BAND      a resonant 12 dB high-pass and low-pass in series (HPF 20 Hz - 2 kHz, LPF 200 Hz - 20 kHz), each with
//           its own RES (Q 0.7 -> 6). The title lamp switches it in (15 ms crossfade, the filters keep running).
// MAGIC     the low-end enhancer, on the mid (mono) low end, added to both sides:
//           WEIGHT  a low shelf (+4 dB at 100 %, 90 Hz) and the bass's own 2nd and 3rd harmonics (made from the
//                   level-normalised low band with Chebyshev terms - clean, no aliasing), so the bass reads on small
//                   speakers;
//           DEPTH   a subharmonic an octave below the bass (40 - 150 Hz): a flip-flop on the bass's zero crossings,
//                   shaped by its envelope and filtered to a round sine-like sub.
// FLANGER   a stereo flanger (L / R LFOs 90 deg apart): RATE (0.02 - 10 Hz), DEPTH (sweeps +/- 1 octave of delay),
//           DELAY (0.2 - 10 ms, the centre of the sweep), FEEDBACK (-95 .. +95 %, soft-limited), MIX.
// COMP      the over-easy compressor from Tandem (RMS 8 ms detector, stereo-linked, a 10 dB soft knee; attack
//           programme dependent - about 15 ms for 10 dB over, 5 ms for 30 dB - release 120 dB per second):
//           THRESHOLD, RATIO (1:1 .. INF:1), GAIN (make-up).
// LFO       the house LFO (gfx-lab-lfo): SINE / TRI / SQR (SMOOTH rounds it) / RND (SMOOTH glides it);
//           FREE (Hz), SYNC (locked to the timeline) or FLOW (tempo rate, free-running phase);
//           WIDTH offsets the right channel's phase (0 - 180 deg)
// ENV       envelope follower on the input (stereo-linked, -60..0 dB -> 0..1); SPEED slows attack + release
// FFAT      one-knob squash after everything: threshold, ratio and make-up rise together; soft 6 dB knee
// OUTPUT    gain, DRY/WET, then the house output stage, CLIP always on (-0.3 dBFS).
// BYPASS    (top bar) crossfades (15 ms) to the dry input, delayed by the latency so it stays in time.
// Switching a drive type, a filter type, ROUTE or ORDER dips the output for ~3 ms (no clicks); the OS key dips 5 ms.
// Latency: 0 samples at 1x, 31 at 2x, 37 at 4x (reported).
//
// STATUS: Lab (experimental, may change). v0.2.

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-output.jsfx-inc
import gfx-lab-clip.jsfx-inc
import gfx-lab-lfo.jsfx-inc
import gfx-lab-os.jsfx-inc

slider1:dtype=0<0,3,1{Tube,Fuzz,Rect,Crush}>-Drive type
slider2:drive=3<0,10,0.1>-Drive
slider3:dmix=100<0,100,0.1>-Drive mix (%)
slider4:f1type=2<0,6,1{Off,LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 1 type
slider5:f1cut=1800<20,20000,1:log>-Filter 1 cutoff (Hz)
slider6:f1res=3<0,10,0.1>-Filter 1 resonance
slider7:f1lfo=0<-4,4,0.01>-Filter 1 LFO (oct)
slider8:f1env=0<-4,4,0.01>-Filter 1 envelope (oct)
slider9:f2type=0<0,6,1{Off,LP 12,LP 24,HP 12,HP 24,Band,Notch}>-Filter 2 type
slider10:f2cut=400<20,20000,1:log>-Filter 2 cutoff (Hz)
slider11:f2res=0<0,10,0.1>-Filter 2 resonance
slider12:f2lfo=0<-4,4,0.01>-Filter 2 LFO (oct)
slider13:f2env=0<-4,4,0.01>-Filter 2 envelope (oct)
slider14:route=0<0,1,1{Series,Parallel}>-Filter routing
slider15:order=0<0,1,1{Drive first,Filters first}>-Order
slider16:lshape=0<0,3,1{Sine,Triangle,Square,Random}>-LFO shape
slider17:lmode=1<0,2,1{Free,Sync,Flow}>-LFO mode
slider18:lhz=1<0.02,20,0.01:log>-LFO rate (Hz)
slider19:ldiv=6<0,15,1{4 Bars,2 Bars,1 Bar,1/2,1/2 D,1/2 T,1/4,1/4 D,1/4 T,1/8,1/8 D,1/8 T,1/16,1/16 D,1/16 T,1/32}>-LFO division
slider20:lsmooth=3<0,10,0.1>-LFO smooth
slider21:lwidth=0<0,180,1>-LFO width (deg)
slider22:espeed=4<0,10,0.1>-Envelope speed
slider23:ffat=0<0,10,0.1>-Ffat
slider24:out_db=0<-12,12,0.1>-Output (dB)
slider25:wet_pc=100<0,100,0.1>-Dry/wet (%)
slider26:os_sel=0<0,2,1{1x,2x,4x}>-Oversampling
slider27:byp=0<0,1,1{Off,On}>-Bypass
slider28:bd_on=0<0,1,1{Off,On}>-Band filter
slider29:hpf_hz=20<20,2000,1:log>-HPF (Hz)
slider30:hpf_res=0<0,10,0.1>-HPF resonance
slider31:lpf_hz=20000<200,20000,1:log>-LPF (Hz)
slider32:lpf_res=0<0,10,0.1>-LPF resonance
slider33:mg_on=0<0,1,1{Off,On}>-Magic EQ
slider34:weight=50<0,100,0.1>-Weight (%)
slider35:depth=30<0,100,0.1>-Depth (%)
slider36:fl_on=0<0,1,1{Off,On}>-Flanger
slider37:fl_rate=0.25<0.02,10,0.01:log>-Flanger rate (Hz)
slider38:fl_depth=60<0,100,0.1>-Flanger depth (%)
slider39:fl_dly=2<0.2,10,0.01:log>-Flanger delay (ms)
slider40:fl_fb=50<-95,95,0.1>-Flanger feedback (%)
slider41:fl_mix=50<0,100,0.1>-Flanger mix (%)
slider42:cp_on=0<0,1,1{Off,On}>-Compressor
slider43:cp_thr=-20<-60,0,0.1>-Compressor threshold (dB)
slider44:cp_cc=0.5<0,1,0.01>-Compressor ratio (0 = 1:1, 1 = inf:1)
slider45:cp_gain=0<-20,20,0.1>-Compressor gain (dB)

@init
#ui_man = "gfx-lab-ffat";
rs_f = 1;                                                      // no resume fade pending
ext_noinit = 1;
gfx_ext_retina = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );  ui_dflt = 1;        // pr_cur: the preset shown on the LCD
ost_init(0);

// ---------- memory map ----------
CF = 0;          // filter coefficient sets, 8 each: F1 L, F1 R, F2 L, F2 R (a1 a2 a3 k b1 b2 b3)
SB = 100;        // filter states, 4 per filter: L F1, L F2, R F1, R F2
RV = 200;        // the scope's random steps (GUI only reads them)
DLB = 512;       // the dry input delayed by the latency, L / R (64 each)
FLA = 4096;      // the flanger's delay lines, L / R (8192 each)
memset(CF, 0, 32);  memset(SB, 0, 16);  memset(DLB, 0, 128);  memset(FLA, 0, 16384);
RV[0] = 0.6;  RV[1] = -0.4;  RV[2] = 0.9;  RV[3] = -0.8;  RV[4] = 0.15;  RV[5] = -0.25;  RV[6] = 0.75;  RV[7] = -0.6;

function db2g(d) ( exp(d * 0.11512925464970228); );

// ---------- the filters: shared-coefficient TPT state-variable (Cytomic) ----------
function sv_coef(i, fc, r) local(c, g, k) (
  c = CF + i * 8;
  g = tan($pi * min(max(fc, 20), srate * 0.45) / srate);
  k = 2 - 1.85 * r;                                              // RES 0..1 -> Q 0.5 .. ~6.7 (stops short of self-oscillation)
  c[0] = 1 / (1 + g * (g + k));  c[1] = g * c[0];  c[2] = g * c[1];  c[3] = k;
  c[4] = 1 / (1 + g * (g + 1.41421356));  c[5] = g * c[4];  c[6] = g * c[5];
);
// t: 0 OFF, 1 LP 12, 2 LP 24, 3 HP 12, 4 HP 24, 5 BAND (unity peak), 6 NOTCH;  coefficient set i, state at s
function sv_run(x, t, i, s) local(c, y, v1, v2, v3) (
  t == 0 ? x : (
    c = CF + i * 8;  y = x;
    (t == 2 || t == 4) ? (                                       // 24 dB: a Butterworth stage first
      v3 = y - s[3];  v1 = c[4] * s[2] + c[5] * v3;  v2 = s[3] + c[5] * s[2] + c[6] * v3;
      s[2] = 2 * v1 - s[2];  s[3] = 2 * v2 - s[3];
      y = t == 2 ? v2 : y - 1.41421356 * v1 - v2;
    );
    v3 = y - s[1];  v1 = c[0] * s[0] + c[1] * v3;  v2 = s[1] + c[1] * s[0] + c[2] * v3;
    s[0] = 2 * v1 - s[0];  s[1] = 2 * v2 - s[1];
    t <= 2 ? v2 : t <= 4 ? y - c[3] * v1 - v2 : t == 5 ? c[3] * v1 : y - c[3] * v1;
  );
);
// both filters for one channel (ci: 0 left, 1 right -> sets ci (F1) and ci + 2 (F2); s: that channel's states)
function flt(x, s, ci) (
  rt_a == 0 ? sv_run(sv_run(x, f1t_a, ci, s), f2t_a, ci + 2, s + 4) :
  (f1t_a && f2t_a) ? 0.5 * (sv_run(x, f1t_a, ci, s) + sv_run(x, f2t_a, ci + 2, s + 4)) :
  f1t_a ? sv_run(x, f1t_a, ci, s) : sv_run(x, f2t_a, ci + 2, s + 4);
);

// ---------- a 2-pole state-variable filter (TPT) as an instance: BAND, MAGIC ----------
function sv2_set(fc, k) instance(a1, a2, a3, kk) local(g) (
  g = tan($pi * min(max(fc, 10), srate * 0.45) / srate);
  a1 = 1 / (1 + g * (g + k));  a2 = g * a1;  a3 = g * a2;  kk = k;
);
// returns the low-pass; hp and bp left in the instance
function sv2_run(x) instance(a1, a2, a3, kk, s0, s1, hp, bp) local(v1, v2, v3) (
  v3 = x - s1;  v1 = a1 * s0 + a2 * v3;  v2 = s1 + a2 * s0 + a3 * v3;
  s0 = 2 * v1 - s0;  s1 = 2 * v2 - s1;
  bp = v1;  hp = x - kk * v1 - v2;
  v2;
);
function sv2_clr() instance(s0, s1, hp, bp) ( s0 = s1 = hp = bp = 0; );

// ---------- the drive, one channel (a, b: clip kit clippers; pf: the kit's pre-filter) ----------
function ds_tick(x) instance(a, b, pf, cnt, held, xp, dcx, dcy) local(u, y, dry) (
  dry = 0.5 * (x + xp);  xp = x;                                 // the ADAA half-sample, matched on the dry side
  dt_a == 3 ? (
    cnt -= 1;                                                    // CRUSH: hold, then quantise
    cnt <= 0 ? ( cnt = cr_hold;  held = min(max(floor(x * cr_q + 0.5) / cr_q, -1), 1); );
    y = held;  dry = x;
  ) : (
    u = pf.clp_pf_run(x) * ds_g;
    dt_a == 0 ? ( y = (a.clp_run(u + ds_b) - ds_rest) * ds_c; ) :          // TUBE
    dt_a == 1 ? ( y = a.clp_run(u) * ds_c; ) :                             // FUZZ
                ( y = 0.5 * (a.clp_run(u) + b.clp_run(u)) * ds_c; );        // RECT
  );
  dcy = y - dcx + ds_dcc * dcy;  dcx = y;                        // DC blocker (the rectifier's DC, the tube's bias), 4 Hz
  dry + (dcy - dry) * dmix_s;
);
function ds_reset() instance(a, b, cnt, held, xp, dcx, dcy) (
  a.clp_reset();  b.clp_reset();  cnt = 0;  held = 0;  xp = 0;  dcx = 0;  dcy = 0;
);
// the drive on both channels at the running OS factor: leaves drv_l, drv_r
function drive_os(l, r) (
  os_f == 1 ? ( drv_l = chL.ds.ds_tick(l);  drv_r = chR.ds.ds_tick(r); ) : (
    osuL.os_up(l);  osuR.os_up(r);
    oa0 = chL.ds.ds_tick(osuL.s0);  ob0 = chR.ds.ds_tick(osuR.s0);
    oa1 = chL.ds.ds_tick(osuL.s1);  ob1 = chR.ds.ds_tick(osuR.s1);
    os_f > 2 ? (
      oa2 = chL.ds.ds_tick(osuL.s2);  ob2 = chR.ds.ds_tick(osuR.s2);
      oa3 = chL.ds.ds_tick(osuL.s3);  ob3 = chR.ds.ds_tick(osuR.s3);
    );
    drv_l = osdL.os_dn(oa0, oa1, oa2, oa3);  drv_r = osdR.os_dn(ob0, ob1, ob2, ob3);
  );
);

// ---------- COMP: Tandem's over-easy stage (static curve in dB, 10 dB knee; cc 1 = INF:1) ----------
function cp_curve(lv) local(o, f) (
  o = lv - cp_thr_v;
  f = o <= -5 ? 0 : o >= 5 ? o : sqr(o + 5) / 20;
  max(-cp_cc_v * f, -60);
);
// programme-dependent smoothing in dB: attack faster the further over, release at 120 dB/s
function cp_smooth(t, e) local(d) (
  t < e ? ( d = e - t;  e + (t - e) * min(1, max(d, 5) / (0.15 * srate)); ) : min(t, e + cp_rel);
);

// ---------- the flanger's delay line: 4-point Hermite read, pos in samples back from the write head ----------
function fl_read(base, dsmp) local(p, i, f, xm1, x0, x1, x2, c1, c2, c3) (
  p = flw - dsmp + 32768;  i = floor(p);  f = p - i;
  xm1 = base[(i - 1) & 8191];  x0 = base[i & 8191];  x1 = base[(i + 1) & 8191];  x2 = base[(i + 2) & 8191];
  c1 = 0.5 * (x1 - xm1);  c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;  c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);

function update_targets() (
  dt_t = dtype;  f1t_t = f1type;  f2t_t = f2type;  rt_t = route;  or_t = order;
  drive_t = drive;  dmix_t = dmix * 0.01;
  lt1 = log(f1cut) / log(2);  lt2 = log(f2cut) / log(2);
  r1_t = f1res * 0.1;  r2_t = f2res * 0.1;
  a1l = f1lfo;  a1e = f1env;  a2l = f2lfo;  a2e = f2env;
  lfoL.lfo_setup(lshape, lsmooth * 0.1);  lfoR.lfo_setup(lshape, lsmooth * 0.1);
  lmode_v = lmode;  ldiv_v = ldiv;  lhz_v = lhz;  loff = lwidth / 360;
  e_att = 1 - exp(-1 / (0.002 * 2 ^ (espeed * 0.5) * srate));   // 2 .. 64 ms
  e_rel = 1 - exp(-1 / (0.03 * 2 ^ (espeed * 0.5) * srate));    // 30 ms .. ~1 s
  ffat_t = ffat;  out_t = db2g(out_db);  wet_t = wet_pc * 0.01;
  // BAND
  bd_t = bd_on;  bh_t = log(hpf_hz) / log(2);  bl_t = log(lpf_hz) / log(2);  bhr_t = hpf_res * 0.1;  blr_t = lpf_res * 0.1;
  // MAGIC
  mg_t = mg_on;  wg_t = weight * 0.01;  dp_t = depth * 0.01;
  // FLANGER
  fl_t = fl_on;  fl_hz = fl_rate;  fdp_t = fl_depth * 0.01;  fdl_t = fl_dly;  ffb_t = fl_fb * 0.01;  fmx_t = fl_mix * 0.01;
  // COMP
  cp_t = cp_on;  cp_thr_v = cp_thr;  cp_cc_v = cp_cc;  cpg_t = db2g(cp_gain);
);

// the switch dip: at the silent point, bring in the new types and clear what they would inherit
function sw_apply() (
  dt_t != dt_a ? ( chL.ds.ds_reset();  chR.ds.ds_reset();  dt_a = dt_t; );
  f1t_t != f1t_a ? ( memset(SB, 0, 4);  memset(SB + 8, 0, 4);  f1t_a = f1t_t; );
  f2t_t != f2t_a ? ( memset(SB + 4, 0, 4);  memset(SB + 12, 0, 4);  f2t_a = f2t_t; );
  rt_a = rt_t;  or_a = or_t;
  cc = 0;  sw_hold = 1;                                          // fade back in once @block has set the new curves
);

chL.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);  chR.ds.pf.clp_pf_cfg(0.45 * srate, 10000, -1.5, 150);
chL.ds.pf.clp_pf_reset();  chR.ds.pf.clp_pf_reset();
lfoL.lfo_init();  lfoR.lfo_init();  flL.lfo_init();  flR.lfo_init();
flL.lfo_setup(0, 0);  flR.lfo_setup(0, 0);

// OS (the drive only)
os_design();  os_base = 0;
os_f = os_tf = os_f2n(os_sel);  os_gsetup();

// MAGIC's fixed filters
mgA.sv2_set(150, 1.41421356);                                    // the low band (WEIGHT's harmonics)
mgB.sv2_set(90, 1.41421356);                                     // what DEPTH's flip-flop listens to
mgC.sv2_set(70, 1.41421356);  mgD.sv2_set(70, 1.41421356);       // the sub's 4-pole low-pass
mgH.sv2_set(120, 1.41421356);                                    // the harmonics' high-pass (drops the fundamental)
mg_a90 = 1 - exp(-2 * $pi * 90 / srate);                         // the shelf's low band
mg_hc = exp(-2 * $pi * 20 / srate);                              // the sub's 20 Hz high-pass
mg_l4 = 1 - exp(-2 * $pi * 4000 / srate);                        // the harmonics' top
mg_rel = exp(-1 / (0.1 * srate));                                // the envelopes' release (100 ms)
mg_flip = 1;

first_run = 1;
gl_sm = 1 - exp(-1 / (0.02 * srate));                            // 20 ms glides (per sample)
c_sw  = 1 - exp(-1 / (0.005 * srate));                           // section in / out and BYPASS: 15 ms to 95 %
msm   = 1 - exp(-1 / (0.002 * srate));                           // modulation smoothing (de-clicks SQR / RND)
sw_step = 1 / (0.003 * srate);
c_att = 1 - exp(-1 / (0.003 * srate));  c_rel = 1 - exp(-1 / (0.09 * srate));
cp_rms = 1 - exp(-1 / (0.008 * srate));  cp_rel = 120 / srate;   // COMP: RMS 8 ms, release 120 dB/s
envlin = 0;  envn = 0;  grs = 0;  cc = 0;  sw_f = 1;  sw_hold = 0;  dw = 0;  flw = 0;
m1l = m1r = m2l = m2r = 0;

@slider
update_targets();
ost_setup(0, 0.3, 120, 6000, -0.3, 1);   // output stage: CLIP, always on
pdc_bot_ch = 0;  pdc_top_ch = 2;  pdc_delay = os_lat(os_f);    // (ost_setup clears it)
first_run ? (
  dt_a = dt_t;  f1t_a = f1t_t;  f2t_a = f2t_t;  rt_a = rt_t;  or_a = or_t;
  drive_s = drive_t;  dmix_s = dmix_t;  r1_s = r1_t;  r2_s = r2_t;  ffat_s = ffat_t;
  lc1 = lt1;  lc2 = lt2;  out_s = out_t;  wet_s = wet_t;
  bd_s = bd_t;  bh_c = bh_t;  bl_c = bl_t;  bhr_s = bhr_t;  blr_s = blr_t;
  mg_s = mg_t;  wg_s = wg_t;  dp_s = dp_t;
  fl_s = fl_t;  fdp_s = fdp_t;  fdl_s = fdl_t;  ffb_s = ffb_t;  fmx_s = fmx_t;
  cp_s = cp_t;  cpg_s = cpg_t;  by_s = byp;
  first_run = 0;
);

@block
// resume after REAPER's bypass (or any gap in processing): the filters hold stale audio, so @sample fades in
// from the dry input (15 ms), as Sifon does
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.15, 4 * samplesblock / srate) ? (
  rs_f = 0;  rs_c = 1 / (0.015 * srate);
  memset(FLA, 0, 16384);  memset(DLB, 0, 128);
);
rs_last = rs_now;
// GUI edits arrive as a flag; targets are rebuilt here, on the audio thread
prm_dirty ? ( prm_dirty = 0;  update_targets(); );
os_tf = os_f2n(os_sel);                                          // OS: the factor asked for (os_gate swaps it in)
pdc_delay = os_lat(os_f);
kb = 1 - exp(-samplesblock / (0.03 * srate));
drive_s += (drive_t - drive_s) * kb;  r1_s += (r1_t - r1_s) * kb;  r2_s += (r2_t - r2_s) * kb;  ffat_s += (ffat_t - ffat_s) * kb;
bhr_s += (bhr_t - bhr_s) * kb;  blr_s += (blr_t - blr_s) * kb;
dn = drive_s / 10;

// the drive's curves and level match (-12 dBFS in = -12 dBFS out; at DRIVE 0 unity for small signals)
ds_st = min(1, drive_s / 3);
dt_a == 0 ? (
  ds_g = db2g(drive_s * 2.4);  ds_b = 0.08 + 0.12 * dn;
  chL.ds.a.clp_set(1, 1, 0.72, 0);  chR.ds.a.clp_set(1, 1, 0.72, 0);
  ds_rest = chL.ds.a.clp_crv(ds_b);
  ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(chL.ds.a.clp_crv(0.25 * ds_g + ds_b) - ds_rest, 0.0001);
) : dt_a == 1 ? (
  ds_g = db2g(drive_s * 4);
  chL.ds.a.clp_set(0, 0.6, 0.6, 0.04 * dn);  chR.ds.a.clp_set(0, 0.6, 0.6, 0.04 * dn);
  ds_c = (1 - ds_st) / ds_g + ds_st * 0.25 / max(chL.ds.a.clp_crv(0.25 * ds_g), 0.0001);
) : dt_a == 2 ? (
  ds_g = db2g(drive_s * 2);
  chL.ds.a.clp_set(3, 1, 1, 0);  chR.ds.a.clp_set(3, 1, 1, 0);
  chL.ds.b.clp_set(1, 1, 1, 0);  chR.ds.b.clp_set(1, 1, 1, 0);
  ds_c = 0.25 / max(0.5 * (chL.ds.a.clp_crv(0.25 * ds_g) + chL.ds.b.clp_crv(0.25 * ds_g)), 0.0001);
) : (
  cr_q = 2 ^ (15 - drive_s * 1.3);                               // 16 bits .. 3 bits
  cr_hold = (1 + floor(sqr(dn) * 23)) * os_f;                    // the same hold time at every OS factor
);
ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
chL.ds.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);  chR.ds.pf.clp_pf_block(dn, srate * os_f, samplesblock * os_f);
chL.ds.a.clp_tidy();  chR.ds.a.clp_tidy();  chL.ds.b.clp_tidy();  chR.ds.b.clp_tidy();
sw_hold = 0;

lfoL.lfo_block(lmode_v, ldiv_v, lhz_v);  lfoR.lfo_block(lmode_v, ldiv_v, lhz_v);
flL.lfo_block(0, 0, fl_hz);  flR.lfo_block(0, 0, fl_hz);

// FFAT: threshold, ratio and make-up rise together
cn = ffat_s / 10;
c_on = cn > 0.001;
c_thr = -32 * cn;
c_sl = 1 - 1 / (1 + 5 * cn);
c_mk = -c_thr * c_sl * 0.5;

// meters / display hand-offs
pkL_d = max(pkL_d, pkL);  pkL = 0;  pkR_d = max(pkR_d, pkR);  pkR = 0;
fc1_d = 2 ^ (lc1 + m1l);  fc2_d = 2 ^ (lc2 + m2l);
lph_d = lfoL.p;  env_d = envn;  gr_d = max(gr_d, grs);  cpgr_d = min(cpgr_d, cp_e);

@sample
rw_l = spl0;  rw_r = spl1;                                    // the dry input, for the resume fade
// the dry input delayed by the latency (DRY/WET and BYPASS)
DLB[dw] = spl0;  DLB[64 + dw] = spl1;
dry_l = DLB[(dw - pdc_delay) & 63];  dry_r = DLB[64 + ((dw - pdc_delay) & 63)];
dw = (dw + 1) & 63;

// switch dip: down, swap at the silent point, back up
(dt_t != dt_a || f1t_t != f1t_a || f2t_t != f2t_a || rt_t != rt_a || or_t != or_a) ? (
  sw_f = max(0, sw_f - sw_step);
  sw_f == 0 ? sw_apply();
) : ( !sw_hold && sw_f < 1 ? sw_f = min(1, sw_f + sw_step); );
// OS: a factor change swaps in at the silent point (os_gate); the drive's state is cleared there
os_gate();
os_chg ? (
  osuL.os_clr();  osuR.os_clr();  osdL.os_clr();  osdR.os_clr();
  chL.ds.ds_reset();  chR.ds.ds_reset();  chL.ds.pf.clp_pf_reset();  chR.ds.pf.clp_pf_reset();
  chL.ds.pf.clp_pf_block(dn, srate * os_f, 1);  chR.ds.pf.clp_pf_block(dn, srate * os_f, 1);
  ds_dcc = 1 - 2 * $pi * 4 / (srate * os_f);
  dt_a == 3 ? cr_hold = (1 + floor(sqr(dn) * 23)) * os_f;
  dry_l = DLB[(dw - 1 - pdc_delay) & 63];  dry_r = DLB[64 + ((dw - 1 - pdc_delay) & 63)];
);

dmix_s += (dmix_t - dmix_s) * gl_sm;  out_s += (out_t - out_s) * gl_sm;  wet_s += (wet_t - wet_s) * gl_sm;
inL = spl0;  inR = spl1;

// envelope follower (input, stereo-linked)
ea = max(abs(inL), abs(inR));
envlin += (ea - envlin) * (ea > envlin ? e_att : e_rel);
envn = envlin > 0.001 ? min((20 * log10(envlin) + 60) / 60, 1) : 0;

// LFO (the right side offset by WIDTH; with no offset it follows the left exactly, RND included)
wl = lfoL.lfo_tick(0, 0, 0);
wr = lfoR.lfo_tick(loff, 0, 0);
loff <= 0 ? wr = wl;

// cutoffs: slider glide + modulation, in octaves
lc1 += (lt1 - lc1) * gl_sm;  lc2 += (lt2 - lc2) * gl_sm;
m1l += (wl * a1l + envn * a1e - m1l) * msm;  m1r += (wr * a1l + envn * a1e - m1r) * msm;
m2l += (wl * a2l + envn * a2e - m2l) * msm;  m2r += (wr * a2l + envn * a2e - m2r) * msm;
bd_s += (bd_t - bd_s) * c_sw;
bh_c += (bh_t - bh_c) * gl_sm;  bl_c += (bl_t - bl_c) * gl_sm;
cc -= 1;
cc <= 0 ? (
  cc = 8;
  f1t_a ? ( sv_coef(0, 2 ^ (lc1 + m1l), r1_s);  sv_coef(1, 2 ^ (lc1 + m1r), r1_s); );
  f2t_a ? ( sv_coef(2, 2 ^ (lc2 + m2l), r2_s);  sv_coef(3, 2 ^ (lc2 + m2r), r2_s); );
  bk = 1.41421356 - 1.25 * bhr_s;  bhL.sv2_set(2 ^ bh_c, bk);  bhR.sv2_set(2 ^ bh_c, bk);
  bk = 1.41421356 - 1.25 * blr_s;  blL.sv2_set(2 ^ bl_c, bk);  blR.sv2_set(2 ^ bl_c, bk);
);

xl = inL;  xr = inR;
or_a == 0 ? ( drive_os(xl, xr);  xl = drv_l;  xr = drv_r; );
xl = flt(xl, SB, 0);  xr = flt(xr, SB + 8, 1);
or_a == 1 ? ( drive_os(xl, xr);  xl = drv_l;  xr = drv_r; );

// ---------- BAND: HPF > LPF, resonant 12 dB each ----------
// (the filters always run, so switching in never starts them from rest)
bhL.sv2_run(xl);  bhR.sv2_run(xr);
yl = blL.sv2_run(bhL.hp);  yr = blR.sv2_run(bhR.hp);
bd_s > 0.0001 ? ( xl += (yl - xl) * bd_s;  xr += (yr - xr) * bd_s; ) : bd_s = 0;

// ---------- MAGIC: WEIGHT (shelf + the bass's harmonics) and DEPTH (the sub), on the mid, added to both ----------
mg_s += (mg_t - mg_s) * c_sw;
(mg_t || mg_s > 0.0001) ? (
  wg_s += (wg_t - wg_s) * gl_sm;  dp_s += (dp_t - dp_s) * gl_sm;
  mm = 0.5 * (xl + xr);
  mg_lp += (mm - mg_lp) * mg_a90;                               // the shelf: + 4 dB at 100 %
  mlo = mgA.sv2_run(mm);                                        // the bass (below 150 Hz)
  ma = abs(mlo);  mg_e = ma > mg_e ? ma : ma + (mg_e - ma) * mg_rel;
  mg_e > 0.00001 ? (
    mu = min(max(mlo / mg_e, -1), 1);
    mh = mg_e * (0.6 * (2 * mu * mu - 1) + 0.4 * (4 * mu * mu * mu - 3 * mu));   // 2nd + 3rd harmonics
  ) : mh = 0;
  mgH.sv2_run(mh);  mg_ht += (mgH.hp - mg_ht) * mg_l4;
  // DEPTH: a flip-flop on the bass's positive zero crossings (with hysteresis) = a square an octave down
  mdt = mgB.sv2_run(mm);
  ma = abs(mdt);  mg_e2 = ma > mg_e2 ? ma : ma + (mg_e2 - ma) * mg_rel;
  mg_e2 > 0.0005 ? (
    mdt > 0.2 * mg_e2 && !mg_pos ? ( mg_pos = 1;  mg_flip = -mg_flip; );
    mdt < -0.2 * mg_e2 ? mg_pos = 0;
  );
  msq = mgD.sv2_run(mgC.sv2_run(mg_flip * mg_e2));
  mg_sy = msq - mg_sx + mg_hc * mg_sy;  mg_sx = msq;              // 20 Hz high-pass
  madd = mg_s * (wg_s * (0.585 * mg_lp + 0.5 * mg_ht) + dp_s * 1.1 * mg_sy);
  xl += madd;  xr += madd;
) : (
  mg_s = 0;  mg_lp = mg_e = mg_e2 = mg_ht = mg_sx = mg_sy = 0;
  mgA.sv2_clr();  mgB.sv2_clr();  mgC.sv2_clr();  mgD.sv2_clr();  mgH.sv2_clr();
);

// ---------- FLANGER ----------
fl_s += (fl_t - fl_s) * c_sw;
(fl_t || fl_s > 0.0001) ? (
  fdp_s += (fdp_t - fdp_s) * gl_sm;  fdl_s += (fdl_t - fdl_s) * gl_sm;
  ffb_s += (ffb_t - ffb_s) * gl_sm;  fmx_s += (fmx_t - fmx_s) * gl_sm;
  fwl = flL.lfo_tick(0, 0, 0);  fwr = flR.lfo_tick(0.25, 0, 0);
  fdsl = max(3, min(8000, fdl_s * 2 ^ (fdp_s * fwl) * 0.001 * srate));
  fdsr = max(3, min(8000, fdl_s * 2 ^ (fdp_s * fwr) * 0.001 * srate));
  fyl = fl_read(FLA, fdsl);  fyr = fl_read(FLA + 8192, fdsr);
  fb_k = ffb_s * fl_s;  fu = xl + fb_k * fyl;  FLA[flw] = fu / sqrt(1 + 0.25 * fu * fu);        // the loop, soft-limited
  fu = xr + fb_k * fyr;  FLA[8192 + flw] = fu / sqrt(1 + 0.25 * fu * fu);
  flw = (flw + 1) & 8191;
  fm = fmx_s * fl_s;
  xl += (fyl - xl) * fm;  xr += (fyr - xr) * fm;
) : (                                                         // off: the lines keep filling (no feedback), so
  fl_s = 0;  FLA[flw] = xl / sqrt(1 + 0.25 * xl * xl);  FLA[8192 + flw] = xr / sqrt(1 + 0.25 * xr * xr);  flw = (flw + 1) & 8191;   // switching in never reads silence
);

// ---------- COMP: the over-easy stage from Tandem (stereo-linked RMS) ----------
cp_s += (cp_t - cp_s) * c_sw;
(cp_t || cp_s > 0.0001) ? (
  cpg_s += (cpg_t - cpg_s) * gl_sm;
  cp_ml += (xl * xl - cp_ml) * cp_rms;  cp_mr += (xr * xr - cp_mr) * cp_rms;
  cp_lv = 10 * log10(0.5 * (cp_ml + cp_mr) + 0.0000000001);
  cp_e = cp_smooth(cp_curve(cp_lv), cp_e);
  cg = db2g(cp_e) * cpg_s;
  xl += (xl * cg - xl) * cp_s;  xr += (xr * cg - xr) * cp_s;
) : ( cp_s = 0;  cp_e = 0;  cp_ml = cp_mr = 0; );

// FFAT (stereo-linked, soft 6 dB knee, auto make-up)
c_on ? (
  cl = max(abs(xl), abs(xr));
  cdb = cl > 0.000001 ? 20 * log10(cl) : -120;
  ov = cdb - c_thr;
  cg = ov <= -3 ? 0 : ov >= 3 ? ov * c_sl : c_sl * sqr(ov + 3) / 12;
  grs += (cg - grs) * (cg > grs ? c_att : c_rel);
  cgn = db2g(c_mk - grs);
  xl *= cgn;  xr *= cgn;
) : ( grs = 0; );

xl *= out_s * sw_f * os_g;  xr *= out_s * sw_f * os_g;
xl = dry_l + (xl - dry_l) * wet_s;  xr = dry_r + (xr - dry_r) * wet_s;
ost_out(xl, xr);  xl = ost_l;  xr = ost_r;                     // house clipper, -0.3 dBFS ceiling

// BYPASS: crossfades (15 ms) to the dry input, delayed by the latency so it stays in time
by_s += (byp - by_s) * c_sw;
by_s > 0.0001 ? ( xl += (dry_l - xl) * by_s;  xr += (dry_r - xr) * by_s; );

pkL = max(pkL, abs(xl));  pkR = max(pkR, abs(xr));
spl0 = xl;  spl1 = xr;
rs_f < 1 ? (                                                   // resume fade (see @block)
  rs_f = min(rs_f + rs_c, 1);  rs_s = rs_f * rs_f * (3 - 2 * rs_f);
  spl0 = rw_l + (spl0 - rw_l) * rs_s;  spl1 = rw_r + (spl1 - rw_r) * rs_s;
);

@serialize
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, ui_sz);

@gfx 1080 704
// =====================================================================
// GUI - FFAT: a two-tone faceplate (body + section plates), a sunset header with a horizon, two pyramids and a palm
// tree, the house preset bar, BYPASS, OS and S / M / L / ?. Sections on the 8-pt system (16 margins and gutters, a
// 34 px title band, content from y + 48). Dark-cap knobs in light metal rings (G-Matic's), lamp keys, title lamps
// switch BAND / MAGIC / FLANGER / COMP in and out. (Helpers from G-Matic.)
// =====================================================================
// ---------- the colours (JG, 26 Oct 2026: "Nile" - deep teal body + sand plates; warm yellow desert sand) ----------
C_BODY = 0x1F4B53;  C_SEC = 0xE6D6B2;  C_INK = 0x2A2620;  C_INK2 = 0x6B5F4A;  C_TTL = 0xF3EBD8;
C_SKY0 = 0x0F2A32;  C_SKY1 = 0x3E5A5C;  C_GLOW = 0xE89A5C;  C_SUN = 0xFFD08A;  C_SAND = 0xE8BC58;
C_LCDTX = 0x7EE6D0;  C_ACC1 = 0xE0603A;  C_ACC2 = 0x2FB8A0;  C_LIT = 0x46D8B8;
C_SCL = C_INK;  C_BEZ = 0x141312;  C_LCDBG = 0x0E0D0C;  lk_well = 0x141312;

function col(h, a) ( gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a; );
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));  b = min(255, floor((h % 256) * f));
  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 + floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_r(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rivet(x, y) ( col(shade(C_BODY, 0.55), 1);  gfx_circle(px(x), py(y), ps(4), 1, 1);  col(ui_mix(C_BODY, 0xFFFFFF, 0.6), 1);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.4), 1, 1); );
function shd_r(x, y, w, h) local(i) ( i = 0;  loop(4, col(0x000000, 0.13);  u_rect(x + 2 + i * 1.3, y + 3 + i * 1.6, w + i * 0.6, h + i * 0.6);  i += 1; ); );
function shd_c(cx, cy, r) local(i) ( i = 0;  loop(4, col(0x000000, 0.13);  gfx_circle(px(cx + 2 + i * 1.2), py(cy + 3 + i * 1.5), ps(r + i * 0.6), 1, 1);  i += 1; ); );
function vig_c(cx, cy, r, a) local(i) ( i = 0;  loop(7, col(0x000000, a * (1 - i / 7));  gfx_circle(px(cx), py(cy), ps(r - i * 0.8), 0, 1);  gfx_circle(px(cx + 0.4), py(cy + 0.4), ps(r - i * 0.8 - 0.4), 0, 1);  i += 1; ); );
// a vignette edge on a rectangle: darker towards the rim over 6 px, half as much again on the bottom and right
function vig_r(x, y, w, h, a) local(i, t) (
  i = 0;
  loop(6, t = a * (1 - i / 6);
    col(0x000000, t);  u_rect(x + i, y + i, w - 2 * i, 1);  u_rect(x + i, y + i + 1, 1, h - 2 * i - 2);
    col(0x000000, t * 1.5);  u_rect(x + i, y + h - 1 - i, w - 2 * i, 1);  u_rect(x + w - 1 - i, y + i + 1, 1, h - 2 * i - 2);
    i += 1; );
);
function param_touched(idx) ( slider_automate(2 ^ (idx - 1));  gui_dirty = 1; );
// a section plate (the second tone), its title on the band's centre line, a rule under the band
function plate(x, y, w, h, title) (
  shd_r(x, y, w, h);
  col(C_SEC, 1);  u_rect(x, y, w, h);
  col(0xFFFFFF, 0.30);  u_rect(x + 2, y, w - 4, 1);
  vig_r(x, y, w, h, 0.07);
  col(C_INK, 0.35);  u_rect(x + 14, y + 34, w - 28, 1.5);
  strlen(title) ? ( gfx_setfont(4);  col(C_INK, 1);  text_l(px(x + 16), py(y + 18), title); );
);
// greys a switched-off section below its title band (the title lamp stays clear)
function grey(x, y, w, h) ( col(C_SEC, 0.5);  u_rect(x + 2, y + 36, w - 4, h - 38); );
function pointer(x, y, s_a, c_a, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + s_a * r0;  ay = y - c_a * r0;  bx = x + s_a * r1;  by = y - c_a * r1;  dx = c_a * hw;  dy = s_a * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v) :
  fmt == 2 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 3 ? ( v < 1000 ? sprintf(#kv, "%.0f Hz", v) : sprintf(#kv, "%.2f kHz", v / 1000); ) :
  fmt == 4 ? sprintf(#kv, "%+.2f oct", v) :
  fmt == 5 ? sprintf(#kv, "%.0f deg", v) :
  fmt == 6 ? sprintf(#kv, "%.2f ms", v) :
  fmt == 7 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 8 ? strcpy(#kv, lfo_div_name(floor(v + 0.5))) :
  fmt == 9 ? ( v >= 0.995 ? strcpy(#kv, "INF:1") : sprintf(#kv, "%.1f:1", 1 / (1 - v)); ) :
  fmt == 10 ? sprintf(#kv, "%+d %%", v) :
  fmt == 11 ? sprintf(#kv, "%.1f dB", v) :
  sprintf(#kv, "%.1f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
// a pointer knob: a dark (or coloured, kcap) cap in a light metal ring, a white line, a dark dot scale.
// lg: log travel; fmt 8 snaps to whole steps. Double-click or Ctrl-click = default, Shift-drag = fine, wheel.
function kn(cx, cy, r, idx, vmin, vmax, def, lbl, fmt, lg) local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j)
(
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.2);
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.35) ? ( slider(idx) = def;  param_touched(idx);  drag_idx = -1; )
                                                                            : ( drag_idx = idx;  drag_y0 = mouse_y;  drag_mv = 0;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
    v = lg ? vmin * (vmax / vmin) ^ t : vmin + t * (vmax - vmin);
    fmt == 8 ? v = floor(v + 0.5);
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    !drag_mv && abs(mouse_y - drag_y0) > ps(3) ? ( drag_mv = 1;  drag_y0 = mouse_y; );
    drag_mv ? (
      // Shift = fine: the travel so far is kept, the rest goes at 1000 px
      (mouse_cap & 8) != drag_sh ? ( drag_sh = mouse_cap & 8;  drag_t = t;  drag_y0 = mouse_y; );
      t = max(0, min(1, drag_t + (drag_y0 - mouse_y) / ps(drag_sh ? 1000 : 200)));
      v = lg ? vmin * (vmax / vmin) ^ t : vmin + t * (vmax - vmin);
      fmt == 8 ? v = floor(v + 0.5);
      v = max(vmin, min(vmax, v));
      v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lg ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  j = 0;
  loop(11,
    b = a0 + j / 10 * (a1 - a0);  col(C_SCL, j % 5 == 0 ? 0.95 : 0.55);
    gfx_circle(x + sin(b) * (rr + ps(8)), y - cos(b) * (rr + ps(8)), ps(j % 5 == 0 ? 1.6 : 1.1), 1, 1);
    j += 1;
  );
  shd_c(cx, cy, r);
  col(0xC9CCD0, 1);  gfx_circle(x, y, rr, 1, 1);  col(0x6A6C70, 1);  gfx_circle(x, y, rr, 0, 1);  col(0xFFFFFF, 0.4);  gfx_arc(x, y, rr - ps(1.5), -1.7, -0.3, 1);
  col(kcap ? kcap : 0x1F2023, 1);  gfx_circle(x, y, rr * 0.82, 1, 1);  vig_c(cx, cy, r * 0.82, 0.16);
  col(0xFFFFFF, 0.10);  gfx_arc(x, y, rr * 0.7, -1.8, -0.1, 1);
  col(kcap == 0xE8C22E ? 0x1A1A1A : 0xF6F4EE, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.9, ps(r > 26 ? 2.4 : 1.8));
  kcap = 0;
  strlen(lbl) ? ( gfx_setfont(6);  col(C_INK, 1);  text_c(x, y + rr + ps(19), lbl); );
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(20), fmtv(v, fmt));
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r, d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);  i += 1; );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) ( gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str); );
// a lamp key (coloured lens in a dark well; off = a darker milky lens)
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? ( col(c, 0.18);  lk_rr(x - 7 * k, y - 7 * k, w + 14 * k, h + 14 * k, 8 * k); );
  shd_r(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k);
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
  col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
  col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
  col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  col(0xFFFFFF, 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(lk_fnt ? lk_fnt : 2);  lk_fnt = 0;  col(shade(c, 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function lcd_box(x, y, w, h) ( col(C_BEZ, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(0x050402, 1);  u_rect(x, y, w, h);  col(C_LCDBG, 1);  u_rect(x + 3, y + 3, w - 6, h - 6); );
function lcd(x, y, w, h, fnt, str) local(tw, th, gy) (
  lcd_box(x, y, w, h);
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1, c = k < len ? str_getchar(menu, k) : 124;  c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );  k += 1; );
  dst;
);
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
// the house preset bar: [PRESETS][◄][►][LCD] (h 34, PRESETS 64 wide, arrows 24, 4 px after PRESETS, 2 between, 6 before the LCD)
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_fnt = 5;  lk_key(x, y, 64, h, 0, 0xD8D0BC, "PRESETS") ? open = 1;
  lk_key(x + 68, y, 24, h, 0, 0xD8D0BC, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 94, y, 24, h, 0, 0xD8D0BC, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1B1C, 1);  pb_tri(x + 80, y + h * 0.5, 4.5, -1);  pb_tri(x + 106, y + h * 0.5, 4.5, 1);
  lx = x + 124;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  i < n ? strcat(#pb_m, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
// a section title lamp (cream ring, amber centre, soft halo when lit): click switches the section in / out
function tlamp(x, y, title, on, idx) local(hov) (
  col(0x2A2722, 1);  gfx_circle(px(x + 9), py(y), ps(10), 1, 1);
  col(on ? 0xFFF4D8 : 0xA89F8C, 1);  gfx_circle(px(x + 9), py(y), ps(8), 1, 1);
  col(on ? 0xF2A41E : 0x5A5246, 1);  gfx_circle(px(x + 9), py(y), ps(5), 1, 1);
  on ? ( col(0xF2A41E, 0.28);  gfx_circle(px(x + 9), py(y), ps(15), 1, 1);  col(0xFFFFFF, 0.6);  gfx_circle(px(x + 7.5), py(y - 1.5), ps(1.6), 1, 1); );
  gfx_setfont(4);  col(on ? C_INK : C_INK2, 1);  text_l(px(x + 28), py(y), title);
  hov = mouse_x >= px(x - 4) && mouse_x < px(x + 120) && mouse_y >= py(y - 13) && mouse_y < py(y + 13);
  click && hov && !drag_idx ? ( slider(idx) = on ? 0 : 1;  param_touched(idx); );
);
// a filter's type: a dark display box, click for the menu
function ftn(t) ( t == 1 ? "LP 12" : t == 2 ? "LP 24" : t == 3 ? "HP 12" : t == 4 ? "HP 24" : t == 5 ? "BAND" : t == 6 ? "NOTCH" : "OFF"; );
function tbox(x, y, w, h, idx) local(t, sel) (
  t = slider(idx);
  col(C_BEZ, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(C_LCDBG, 1);  u_rect(x, y, w, h);
  gfx_setfont(5);  col(t ? C_LCDTX : ui_mix(C_LCDTX, C_LCDBG, 0.5), 1);  text_c(px(x + w * 0.5 - 6), py(y + h * 0.5), ftn(t));
  col(C_LCDTX, 0.8);  gfx_triangle(px(x + w - 15), py(y + h * 0.5 - 2), px(x + w - 7), py(y + h * 0.5 - 2), px(x + w - 11), py(y + h * 0.5 + 3));
  click && !drag_idx && mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h) ? (
    strcpy(#tm, "");  sel = 0;
    loop(7, sel == t ? strcat(#tm, "!"); strcat(#tm, ftn(sel)); sel < 6 ? strcat(#tm, "|"); sel += 1; );
    gfx_x = px(x); gfx_y = py(y + h + 2); sel = gfx_showmenu(#tm);
    sel > 0 ? ( slider(idx) = sel - 1; param_touched(idx); );
  );
);
// a vertical bar meter in a dark well (v 0..1)
function vbar(x, y, w, h, v, c) (
  col(C_BEZ, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(C_LCDBG, 1);  u_rect(x, y, w, h);
  v = max(0, min(1, v));  col(c, 0.95);  u_rect(x + 1, y + h - 1 - (h - 2) * v, w - 2, (h - 2) * v);
);
// an LED row, -42 .. +3 dBFS in 3 dB steps (16 LEDs), the peak hold lit on top
function ledrow(x, y, lv, hold) local(i, d, c, on) (
  i = 0;
  loop(16,
    d = -42 + 3 * i;
    c = d < -6 ? 0x46D86A : d < 0 ? 0xFFB030 : 0xFF3A2A;
    on = lv >= d || (hold >= d && hold < d + 3);
    col(C_BEZ, 1);  u_rect(x + i * 8, y, 7, 11);
    col(on ? c : ui_mix(c, 0x000000, 0.8), 1);  u_rect(x + i * 8 + 1, y + 1, 5, 9);
    on ? ( col(0xFFFFFF, 0.35);  u_rect(x + i * 8 + 1.5, y + 1.5, 4, 2); );
    i += 1;
  );
);

// ---------- the header picture: a sunset horizon, two pyramids and a palm tree ----------
function grad_v(x, y, w, h, c0, c1) local(r0, g0, b0, r1, g1, b1, hh) (
  r0 = floor(c0 / 65536) / 255;  g0 = (floor(c0 / 256) % 256) / 255;  b0 = (c0 % 256) / 255;
  r1 = floor(c1 / 65536) / 255;  g1 = (floor(c1 / 256) % 256) / 255;  b1 = (c1 % 256) / 255;
  hh = max(1, ps(h));
  gfx_gradrect(px(x), py(y), ps(w), hh, r0, g0, b0, 1, 0, 0, 0, 0, (r1 - r0) / hh, (g1 - g0) / hh, (b1 - b0) / hh, 0);
);
// a filled triangle with anti-aliased edges (design units)
function tri_aa(x1, y1, x2, y2, x3, y3) (
  gfx_triangle(px(x1), py(y1), px(x2), py(y2), px(x3), py(y3));
  gfx_line(px(x1), py(y1), px(x2), py(y2), 1);  gfx_line(px(x2), py(y2), px(x3), py(y3), 1);
);
// a pyramid: base from bx0 to bx1 on the ground line gy, apex (ax, ay); light from the top left = the left face lit
function pyramid(bx0, bx1, gy, ax, ay, cl, cd) local(mx) (
  mx = ax + (bx1 - bx0) * 0.12;
  col(cl, 1);  tri_aa(bx0, gy, ax, ay, mx, gy);
  col(cd, 1);  tri_aa(mx, gy, ax, ay, bx1, gy);
  col(0x000000, 0.10);  gfx_line(px(mx), py(gy), px(ax), py(ay), 1);
);
// a tapered stroke along a quadratic curve (p0 -> c -> p1), radius r0 -> r1 (design units): trunks and fronds
function stroke_q(x0, y0, cx, cy, x1, y1, r0, r1, n) local(i, t, u, x, y) (
  i = 0;
  loop(n + 1, t = i / n;  u = 1 - t;
    x = u * u * x0 + 2 * u * t * cx + t * t * x1;  y = u * u * y0 + 2 * u * t * cy + t * t * y1;
    gfx_circle(px(x), py(y), ps(r0 + (r1 - r0) * t), 1, 1);  i += 1; );
);
// a leaf: a frond along a quadratic curve (crown -> c -> tip), full in the middle, tapered at both ends, with leaflets
// hanging off its lower side
function frond(x0, y0, cx, cy, x1, y1, w, c) local(i, t, u, x, y, dx, dy, d, n) (
  n = 26;  i = 0;
  col(c, 1);
  loop(n + 1, t = i / n;  u = 1 - t;
    x = u * u * x0 + 2 * u * t * cx + t * t * x1;  y = u * u * y0 + 2 * u * t * cy + t * t * y1;
    gfx_circle(px(x), py(y), ps(0.5 + w * sin($pi * min(t * 1.15, 1)) ^ 0.8), 1, 1);
    i > 3 && i < n && i % 2 == 0 ? (                                            // the leaflets
      dx = 2 * (u * (cx - x0) + t * (x1 - cx));  dy = 2 * (u * (cy - y0) + t * (y1 - cy));
      d = sqrt(dx * dx + dy * dy) + 0.0001;  dx /= d;  dy /= d;
      d = 2.5 + 3.5 * sin($pi * t);
      gfx_line(px(x), py(y), px(x - dy * d * (dx < 0 ? -1 : 1) + dx * 1.5), py(y + abs(dx) * d + 1.5), 1);
      gfx_line(px(x) + 1, py(y), px(x - dy * d * (dx < 0 ? -1 : 1) + dx * 1.5) + 1, py(y + abs(dx) * d + 1.5), 1);
    );
    i += 1; );
);
// a palm: a brown ringed trunk leaning gently, a crown of green arching fronds, coconuts
function palm(bx, by, tx, ty) local(i, a, l, ex, ey, cl) (
  col(0x6B4A2C, 1);  stroke_q(bx, by, bx - 1, by - 22, tx, ty, 3.0, 2.0, 40);          // the trunk
  col(0x4A321E, 1);
  i = 1;  loop(9, a = i / 10;  ex = (1 - a) * (1 - a) * bx + 2 * (1 - a) * a * (bx - 1) + a * a * tx;
    ey = (1 - a) * (1 - a) * by + 2 * (1 - a) * a * (by - 22) + a * a * ty;
    gfx_line(px(ex - 2.6), py(ey), px(ex + 2.6), py(ey - 0.8), 1);  i += 1; );
  col(0x8A6440, 1);  stroke_q(bx - 1.4, by, bx - 2.4, by - 22, tx - 1.2, ty, 0.8, 0.6, 30);   // lit side (light from the top left)
  i = 0;
  loop(4,
    // back fronds first (darker), then the front ones - all drooping (JG: no upright ones on top)
    a = i == 0 ? -2.75 : i == 1 ? -0.35 : i == 2 ? -3.05 : -0.05;
    l = 25;
    cl = i < 2 ? 0x2E5A2A : 0x4E8C3C;
    ex = tx + cos(a) * l;  ey = ty + sin(a) * l * 0.45 + l * 0.5 * abs(cos(a)) + 4;
    frond(tx, ty, tx + cos(a) * l * 0.55, ty + sin(a) * l * 0.55 - 7, ex, ey, 2.4, cl);
    i += 1;
  );
  col(0x5A3A1E, 1);  gfx_circle(px(tx + 1.5), py(ty + 3), ps(2.1), 1, 1);  gfx_circle(px(tx - 2), py(ty + 3.4), ps(2), 1, 1);  gfx_circle(px(tx), py(ty + 5), ps(1.9), 1, 1);
);
function header_art() local(j, gy) (
  gy = 50;
  grad_v(0, 0, 1080, 30, C_SKY0, ui_mix(C_SKY0, C_SKY1, 0.55));
  grad_v(0, 30, 1080, 20, ui_mix(C_SKY0, C_SKY1, 0.55), ui_mix(C_SKY1, C_GLOW, 0.55));
  j = 0;  loop(24, col(C_GLOW, 0.035);  gfx_circle(px(914), py(gy), ps(120 - j * 4.5), 1, 1);  j += 1; );   // the glow round the sun
  col(C_SUN, 0.35);  gfx_circle(px(914), py(gy), ps(16), 1, 1);
  col(C_SUN, 1);  gfx_circle(px(914), py(gy), ps(13), 1, 1);
  // the ground (covers the glow and the sun below the horizon), then the title's corner kept plain
  grad_v(0, gy, 1080, 11, C_SAND, ui_mix(C_SAND, 0x7A3E1A, 0.3));
  col(ui_mix(C_SAND, C_GLOW, 0.5), 0.8);  u_rect(0, gy, 1080, 1);
  pyramid(206, 306, gy, 252, 19, ui_mix(C_SAND, 0xFFE8A0, 0.15), ui_mix(C_SAND, 0x7A3E1A, 0.42));
  pyramid(286, 360, gy, 321, 30, ui_mix(C_SAND, 0xFFE8A0, 0.08), ui_mix(C_SAND, 0x7A3E1A, 0.48));
  palm(392, 59, 382, 22);
  // the divider: a 3 px black bar and a 1 px accent line (the picture ends here)
  col(0x0A0A0A, 1);  u_rect(0, 61, 1080, 3);
  col(C_ACC1, 1);  u_rect(0, 64, 1080, 1);
);

// ---------- presets (GUI thread only) ----------
function pv(i, v) ( slider(i) = v; );
function pdef() (
  pv(1, 0); pv(2, 3); pv(3, 100); pv(4, 2); pv(5, 1800); pv(6, 3); pv(7, 0); pv(8, 0);
  pv(9, 0); pv(10, 400); pv(11, 0); pv(12, 0); pv(13, 0); pv(14, 0); pv(15, 0);
  pv(16, 0); pv(17, 1); pv(18, 1); pv(19, 6); pv(20, 3); pv(21, 0); pv(22, 4); pv(23, 0); pv(24, 0); pv(25, 100);
  pv(28, 0); pv(29, 20); pv(30, 0); pv(31, 20000); pv(32, 0);
  pv(33, 0); pv(34, 50); pv(35, 30);
  pv(36, 0); pv(37, 0.25); pv(38, 60); pv(39, 2); pv(40, 50); pv(41, 50);
  pv(42, 0); pv(43, -20); pv(44, 0.5); pv(45, 0);
);
function load_preset(p) (
  pdef();
  p == 2 ? ( pv(2, 4); pv(5, 300); pv(6, 6); pv(7, 3); pv(19, 9); pv(23, 3); ) :                                 // Wobble Bass
  p == 3 ? ( pv(2, 6); pv(5, 250); pv(6, 8); pv(8, 3.5); pv(22, 2); pv(23, 2); pv(24, -1); ) :                  // Acid Squelch
  p == 4 ? ( pv(1, 3); pv(2, 5); pv(4, 5); pv(5, 1400); pv(9, 3); pv(10, 250); pv(23, 4); ) :                    // Lo-Fi Radio
  p == 5 ? ( pv(2, 5); pv(3, 70); pv(4, 1); pv(5, 12000); pv(6, 1); pv(23, 6); ) :                               // Ffat Drums
  p == 6 ? ( pv(2, 2); pv(4, 1); pv(5, 900); pv(6, 4); pv(7, 2.5); pv(16, 1); pv(17, 0); pv(18, 0.08); pv(21, 90); ) :  // Slow Sweep
  p == 7 ? ( pv(5, 150); pv(6, 2); pv(7, 4); pv(16, 2); pv(19, 12); pv(20, 1); ) :                               // Filter Chop
  p == 8 ? ( pv(1, 1); pv(2, 6); pv(4, 6); pv(5, 1000); pv(6, 5); pv(7, 2); pv(19, 3); pv(21, 60); pv(24, -1); ) : // Fuzz Notch
  p == 9 ? ( pv(1, 2); pv(2, 6); pv(4, 3); pv(5, 180); pv(6, 2); pv(9, 1); pv(10, 6000); pv(11, 3); pv(23, 3); ) : // Octave Lead
  p == 10 ? ( pv(4, 5); pv(5, 1200); pv(6, 6); pv(7, 2); pv(16, 3); pv(19, 12); pv(20, 0); ) :                   // Random Steps
  p == 11 ? ( pv(2, 2); pv(4, 5); pv(5, 700); pv(6, 6); pv(7, 1); pv(9, 5); pv(10, 1600); pv(11, 6); pv(12, -1);
              pv(14, 1); pv(17, 0); pv(18, 0.3); ) :                                                              // Twin Formant
  p == 12 ? ( pv(1, 3); pv(2, 4); pv(5, 2500); pv(6, 3); pv(8, -2); pv(22, 3); pv(23, 7); ) :                     // Crushed Pump
  p == 13 ? ( pv(2, 4); pv(4, 0); pv(36, 1); pv(37, 0.12); pv(38, 80); pv(39, 1.5); pv(40, 75); pv(41, 50); ) :   // Desert Jet
  p == 14 ? ( pv(2, 2); pv(4, 0); pv(33, 1); pv(34, 60); pv(35, 45); pv(42, 1); pv(43, -24); pv(44, 0.6); pv(45, 3); ) : // Big Bottom
  p == 15 ? ( pv(2, 4); pv(4, 0); pv(28, 1); pv(29, 300); pv(30, 4); pv(31, 3000); pv(32, 3);
              pv(42, 1); pv(43, -30); pv(44, 0.75); pv(45, 6); ) : 0;                                             // Band Squeeze
  slider_automate(33554431);  slider_automate(35184237871104);                                                     // sliders 1-25, 28-45
  gui_dirty = 1;
);
PRESET_MENU = "Init|Wobble Bass|Acid Squelch|Lo-Fi Radio|Ffat Drums|Slow Sweep|Filter Chop|Fuzz Notch|Octave Lead|Random Steps|Twin Formant|Crushed Pump|Desert Jet|Big Bottom|Band Squeeze";

// the filter section's response (analogue prototypes, for the display): leaves cr_re, cr_im
function cresp(f, t, fc, k) local(w, dre, dim, nre, nim, den, re, im, bre, bim, d2) (
  t == 0 ? ( cr_re = 1; cr_im = 0; ) : (
    w = f / fc; dre = 1 - w * w; dim = k * w;
    t <= 2 ? ( nre = 1; nim = 0; ) : t <= 4 ? ( nre = -w * w; nim = 0; ) : t == 5 ? ( nre = 0; nim = k * w; ) : ( nre = dre; nim = 0; );
    den = dre * dre + dim * dim;
    re = (nre * dre + nim * dim) / den; im = (nim * dre - nre * dim) / den;
    (t == 2 || t == 4) ? (
      dim = 1.41421356 * w; den = dre * dre + dim * dim;
      nre = t == 2 ? 1 : -w * w;
      bre = nre * dre / den; bim = -nre * dim / den;
      d2 = re * bre - im * bim; im = re * bim + im * bre; re = d2;
    );
    cr_re = re; cr_im = im;
  );
);
function chain_db(f) local(r1, i1, r2, i2, re, im, m, w, d) (
  cresp(f, f1type, g_fc1, 2 - 0.185 * f1res); r1 = cr_re; i1 = cr_im;
  cresp(f, f2type, g_fc2, 2 - 0.185 * f2res); r2 = cr_re; i2 = cr_im;
  route == 0 || !(f1type && f2type) ? ( re = r1 * r2 - i1 * i2; im = r1 * i2 + i1 * r2; )
                                     : ( re = 0.5 * (r1 + r2); im = 0.5 * (i1 + i2); );
  m = re * re + im * im;
  bd_on ? (                                                    // BAND: |HP| x |LP|
    w = f / hpf_hz;  d = sqr(1 - w * w) + sqr((1.41421356 - 0.125 * hpf_res) * w);  m *= w * w * w * w / d;
    w = f / lpf_hz;  d = sqr(1 - w * w) + sqr((1.41421356 - 0.125 * lpf_res) * w);  m /= d;
  );
  m > 0.0000000001 ? 10 * log10(m) : -100;
);

// ---------- frame ----------
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1080 * g_ret), gfx_h / (704 * g_ret))), 0.5);
ox = (gfx_w - 1080 * sc) * 0.5;  oy = (gfx_h - 704 * sc) * 0.5;
lmb = mouse_cap & 1;  click = lmb && !last_lmb;  kcap = 0;
drag_idx < 0 && !lmb ? drag_idx = 0;
gfx_setfont(1, "Trebuchet MS", ps(32), 'b');
gfx_setfont(2, "Trebuchet MS", ps(14), 'b');
gfx_setfont(3, "Trebuchet MS", ps(14), 'b');
gfx_setfont(4, "Trebuchet MS", ps(16), 'b');
gfx_setfont(5, "Trebuchet MS", ps(12.5), 'b');
gfx_setfont(6, "Trebuchet MS", ps(14), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');
gfx_setfont(9, "Courier New", ps(13), 'b');
gfx_setfont(10, "Trebuchet MS", ps(11), 'b');
!g_init ? ( mL = mR = hL = hR = -100;  g_init = 1; );
// meters / display hand-off: peak since the last frame, hold 1.2 s then 0.6 dB a frame
g_now = time_precise();
g_dl = pkL_d > 0.00001 ? 20 * log10(pkL_d) : -100;  g_dr = pkR_d > 0.00001 ? 20 * log10(pkR_d) : -100;  pkL_d = 0;  pkR_d = 0;
mL = max(g_dl, mL - 1.2);  mR = max(g_dr, mR - 1.2);
g_dl >= hL ? ( hL = g_dl;  hLt = g_now; ) : g_now - hLt > 1.2 ? hL -= 0.6;
g_dr >= hR ? ( hR = g_dr;  hRt = g_now; ) : g_now - hRt > 1.2 ? hR -= 0.6;
gr_m = max(gr_d, gr_m * 0.88);  gr_d = 0;
cp_m = min(cpgr_d, cp_m * 0.88);  cpgr_d = 0;

// ---------- the body and the header ----------
col(shade(C_BODY, 0.6), 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
header_art();
col(C_BODY, 1);  u_rect(0, 65, 1080, 639);
col(0x000000, 0.22);  u_rect(0, 700, 1080, 4);  u_rect(1076, 65, 4, 635);
rivet(10, 10);  rivet(1070, 10);  rivet(10, 694);  rivet(1070, 694);
gfx_setfont(1);  col(0x000000, 0.45);  text_l(px(26), py(33), "FFAT");  col(C_TTL, 1);  text_l(px(24), py(31), "FFAT");
gfx_setfont(10);  col(ui_mix(C_TTL, C_GLOW, 0.4), 1);  text_l(px(110), py(38), "MULTI-FX");
pb_k = preset_bar(420, 16, 34, 252, pr_cur, PRESET_MENU);
pb_k > 0 ? ( load_preset(pb_k);  pr_cur = pb_k; );
lk_fnt = 5;  lk_key(812, 20, 84, 26, byp, 0xE9E2CC, "BYPASS") ? ( slider(27) = byp ? 0 : 1;  param_touched(27); );
// OS (left of the S / M / L / ? picker)
os_key(ox / sc + 958, oy / sc + 22, 26, C_TTL, 7) ? gui_dirty = 1;

// ---------- row 1: DRIVE, FILTER 1, FILTER 2 ----------
plate(16, 80, 300, 140, "DRIVE");
g_j = 0;
loop(4,
  lk_key(32 + (g_j % 2) * 70, 132 + floor(g_j / 2) * 36, 62, 26, dtype == g_j, 0xF2D23A, g_j == 0 ? "TUBE" : g_j == 1 ? "FUZZ" : g_j == 2 ? "RECT" : "CRUSH") ? ( slider(1) = g_j;  param_touched(1); );
  g_j += 1; );
kcap = 0xC83A2A;  kn(212, 160, 28, 2, 0, 10, 3, "DRIVE", 0, 0);
kn(282, 164, 20, 3, 0, 100, 100, "MIX", 1, 0);

plate(332, 80, 358, 140, "FILTER 1");
tbox(578, 88, 96, 22, 4);
kcap = C_ACC1;  kn(388, 160, 24, 5, 20, 20000, 1800, "CUT", 3, 1);
kn(470, 164, 20, 6, 0, 10, 3, "RES", 0, 0);
kn(552, 164, 20, 7, -4, 4, 0, "LFO", 4, 0);
kn(634, 164, 20, 8, -4, 4, 0, "ENV", 4, 0);

plate(706, 80, 358, 140, "FILTER 2");
tbox(952, 88, 96, 22, 9);
kcap = C_ACC2;  kn(762, 160, 24, 10, 20, 20000, 400, "CUT", 3, 1);
kn(844, 164, 20, 11, 0, 10, 0, "RES", 0, 0);
kn(926, 164, 20, 12, -4, 4, 0, "LFO", 4, 0);
kn(1008, 164, 20, 13, -4, 4, 0, "ENV", 4, 0);

// ---------- row 2: LFO, ENV, the response display ----------
plate(16, 236, 452, 140, "LFO");
g_j = 0;
loop(3,
  lk_key(300 + g_j * 56, 243, 50, 22, lmode == g_j, C_LIT, g_j == 0 ? "FREE" : g_j == 1 ? "SYNC" : "FLOW") ? ( slider(17) = g_j;  param_touched(17); );
  g_j += 1; );
g_j = 0;
loop(4,
  lk_key(32 + (g_j % 2) * 58, 290 + floor(g_j / 2) * 36, 50, 26, lshape == g_j, C_LIT, g_j == 0 ? "SINE" : g_j == 1 ? "TRI" : g_j == 2 ? "SQR" : "RND") ? ( slider(16) = g_j;  param_touched(16); );
  g_j += 1; );
// the scope: two cycles of the shape, the dot is the left channel's phase
lcd_box(152, 288, 96, 64);
col(C_LCDTX, 0.15);  gfx_line(px(156), py(320), px(244), py(320), 0);
gk = 1 + 49 * sqr(1 - lsmooth * 0.1);  gtk = exp(2 * min(gk, 20));  gtk = (gtk - 1) / (gtk + 1);
gn = 48;  gi = 0;
loop(gn + 1,
  gxn = gi / gn;  gp = 2 * gxn;  gp -= floor(gp);  gp = gi == gn ? 1 : gp;
  lshape < 3 ? ( gv = lfo_shape_d(gp, lshape, gk, gtk); ) : (
    gq = floor(2 * gxn * 2) % 8;  gfr = 2 * gxn * 2 - floor(2 * gxn * 2);
    gfr = lsmooth > 0.01 ? min(gfr / (lsmooth * 0.1), 1) : 1;
    gv = RV[gq] + (RV[(gq + 1) % 8] - RV[gq]) * (0.5 - 0.5 * cos($pi * gfr));
  );
  gxx = px(158 + gxn * 84);  gyy = py(320 - gv * 24);
  gi > 0 ? ( col(C_LCDTX, 1);  gfx_line(gxp, gyp, gxx, gyy, 1); );
  gxp = gxx;  gyp = gyy;  gi += 1;
);
lshape < 3 ? (
  gv = lfo_shape_d(lph_d, lshape, gk, gtk);
  col(0xF2F2EE, 1);  gfx_circle(px(158 + lph_d * 42), py(320 - gv * 24), ps(3), 1, 1);
);
kcap = C_ACC2;
lmode == 0 ? kn(296, 316, 24, 18, 0.02, 20, 1, "RATE", 7, 1)
           : kn(296, 316, 24, 19, 0, 15, 6, "RATE", 8, 0);
kn(362, 320, 20, 20, 0, 10, 3, "SMOOTH", 0, 0);
kn(424, 320, 20, 21, 0, 180, 0, "WIDTH", 5, 0);

plate(484, 236, 108, 140, "ENV");
kn(524, 320, 20, 22, 0, 10, 4, "SPEED", 0, 0);
vbar(564, 288, 10, 72, env_d, C_LIT);

// the response display: the filters (and BAND) as they sit now
plate(608, 236, 456, 140, "");
lcd_box(620, 248, 432, 116);
gx0 = 640;  gx1 = 1032;  gy0 = 276;  gy1 = 340;  gdb_t = 24;  gdb_b = -36;
col(C_LCDTX, 0.08);  gi = 0;
loop(6, gf = (gi % 2 ? 50 : 20) * 10 ^ floor(gi / 2);                   // light lines: 20 50 200 500 2k 5k
  gxx = gx0 + log(gf / 20) / log(1000) * (gx1 - gx0);
  gi > 0 ? gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0);  gi += 1; );
gi = 0;
loop(3, gf = 100 * 10 ^ gi;  gxx = gx0 + log(gf / 20) / log(1000) * (gx1 - gx0);
  col(C_LCDTX, 0.2);  gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0);
  gfx_setfont(9);  col(C_LCDTX, 0.5);  text_c(px(gxx), py(352), gi == 0 ? "100" : gi == 1 ? "1k" : "10k");
  gi += 1; );
gi = 0;  loop(5, gdb = 12 - gi * 12;  gyy = gy0 + (gdb_t - gdb) / (gdb_t - gdb_b) * (gy1 - gy0);
  col(C_LCDTX, gdb == 0 ? 0.25 : 0.08);  gfx_line(px(gx0), py(gyy), px(gx1), py(gyy), 0);  gi += 1; );
g_fc1 = fc1_d > 0 ? fc1_d : f1cut;  g_fc2 = fc2_d > 0 ? fc2_d : f2cut;
gn = 160;  gi = 0;
loop(gn + 1,
  gxn = gi / gn;  gf = 20 * 1000 ^ gxn;
  gdb = max(gdb_b, min(gdb_t, chain_db(gf)));
  gxx = px(gx0 + gxn * (gx1 - gx0));  gyy = py(gy0 + (gdb_t - gdb) / (gdb_t - gdb_b) * (gy1 - gy0));
  gi > 0 ? (
    col(C_LCDTX, 0.10);  gfx_rect(gxp, gyy, max(1, gxx - gxp), py(gy1) - gyy, 1);
    col(C_LCDTX, 1);  gfx_line(gxp, gyp, gxx, gyy, 1);
  );
  gxp = gxx;  gyp = gyy;  gi += 1;
);
f1type ? ( gxx = gx0 + log(max(20, min(20000, g_fc1)) / 20) / log(1000) * (gx1 - gx0);
  col(C_ACC1, 0.9);  gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0);  gfx_circle(px(gxx), py(gy0), ps(3), 1, 1); );
f2type ? ( gxx = gx0 + log(max(20, min(20000, g_fc2)) / 20) / log(1000) * (gx1 - gx0);
  col(C_ACC2, 0.9);  gfx_line(px(gxx), py(gy0), px(gxx), py(gy1), 0);  gfx_circle(px(gxx), py(gy0), ps(3), 1, 1); );
gfx_setfont(9);
f1cut < 1000 ? sprintf(#h1, "%.0f", f1cut) : sprintf(#h1, "%.1fk", f1cut / 1000);
f2cut < 1000 ? sprintf(#h2, "%.0f", f2cut) : sprintf(#h2, "%.1fk", f2cut / 1000);
f1type ? sprintf(#l1, "F1 %s %s", ftn(f1type), #h1) : strcpy(#l1, "F1 OFF");
f2type ? sprintf(#l2, "F2 %s %s", ftn(f2type), #h2) : strcpy(#l2, "F2 OFF");
col(ui_mix(C_ACC1, 0xFFFFFF, 0.25), 1);  text_l(px(634), py(262), #l1);
col(ui_mix(C_ACC2, 0xFFFFFF, 0.25), 1);  text_l(px(790), py(262), #l2);
col(C_LCDTX, 0.75);  strcpy(#lr, route ? "PARALLEL" : "SERIES");  strcat(#lr, order ? "  FLT-DRV" : "  DRV-FLT");
text_r(px(1038), py(262), #lr);

// ---------- row 3: BAND, MAGIC, FLANGER ----------
plate(16, 392, 358, 140, "");
tlamp(28, 410, "BAND", bd_on, 28);
kcap = 0xE8C22E;  kn(72, 476, 22, 29, 20, 2000, 20, "HPF", 3, 1);
kn(152, 480, 18, 30, 0, 10, 0, "RES", 0, 0);
kcap = 0x141414;  kn(238, 476, 22, 31, 200, 20000, 20000, "LPF", 3, 1);
kn(318, 480, 18, 32, 0, 10, 0, "RES", 0, 0);
!bd_on ? grey(16, 392, 358, 140);

plate(390, 392, 220, 140, "");
tlamp(402, 410, "MAGIC", mg_on, 33);
kcap = 0x8A5A34;  kn(450, 476, 26, 34, 0, 100, 50, "WEIGHT", 1, 0);
kcap = 0x5A3620;  kn(550, 476, 26, 35, 0, 100, 30, "DEPTH", 1, 0);
!mg_on ? grey(390, 392, 220, 140);

plate(626, 392, 438, 140, "");
tlamp(638, 410, "FLANGER", fl_on, 36);
kcap = C_ACC2;  kn(686, 478, 20, 37, 0.02, 10, 0.25, "RATE", 7, 1);
kn(766, 478, 20, 38, 0, 100, 60, "DEPTH", 1, 0);
kn(846, 478, 20, 39, 0.2, 10, 2, "DELAY", 6, 1);
kn(926, 478, 20, 40, -95, 95, 50, "FEEDBACK", 10, 0);
kn(1006, 478, 20, 41, 0, 100, 50, "MIX", 1, 0);
!fl_on ? grey(626, 392, 438, 140);

// ---------- row 4: COMP, FFAT, OUTPUT ----------
plate(16, 548, 424, 140, "");
tlamp(28, 566, "COMP", cp_on, 42);
kcap = 0xD8392B;  kn(80, 632, 22, 43, -60, 0, -20, "THRESHOLD", 11, 0);
kcap = 0xE8C22E;  kn(180, 632, 22, 44, 0, 1, 0.5, "RATIO", 9, 0);
kcap = 0x2F7FD0;  kn(272, 632, 22, 45, -20, 20, 0, "GAIN", 2, 0);
// gain reduction: 0 .. 20 dB down the bar
vbar(336, 600, 12, 72, -cp_m / 20, C_ACC1);
gfx_setfont(10);  col(C_INK, 1);  text_c(px(342), py(588), "GR");
g_j = 0;  loop(5, g_d = g_j == 0 ? 0 : g_j == 1 ? 3 : g_j == 2 ? 6 : g_j == 3 ? 10 : 20;  sprintf(#gl, "%d", g_d);
  col(C_INK2, 1);  text_l(px(358), py(601 + 70 * g_d / 20), #gl);  g_j += 1; );
!cp_on ? grey(16, 548, 424, 140);

plate(456, 548, 128, 140, "FFAT");
kcap = C_ACC1;  kn(508, 628, 28, 23, 0, 10, 0, "FFAT", 0, 0);
vbar(562, 600, 10, 72, gr_m / 12, C_ACC1);

plate(600, 548, 464, 140, "OUTPUT");
lk_fnt = 5;  lk_key(616, 598, 104, 26, route, 0xF08A24, route ? "PARALLEL" : "SERIES") ? ( slider(14) = !route;  param_touched(14); );
lk_fnt = 5;  lk_key(616, 638, 104, 26, order, 0xF08A24, order ? "FILTERS 1ST" : "DRIVE 1ST") ? ( slider(15) = !order;  param_touched(15); );
kn(772, 632, 22, 24, -12, 12, 0, "OUTPUT", 2, 0);
kn(852, 636, 20, 25, 0, 100, 100, "DRY/WET", 1, 0);
// the output meter: L / R LED rows, -42 .. +3 dBFS, floating peak hold; click clears
gfx_setfont(10);  col(C_INK, 1);  text_c(px(910), py(608), "L");  text_c(px(910), py(630), "R");
ledrow(920, 602, mL, hL);  ledrow(920, 624, mR, hR);
col(C_INK2, 1);  text_c(px(923), py(648), "-42");  text_c(px(971), py(648), "-24");  text_c(px(1003), py(648), "-12");  text_c(px(1035), py(648), "0");
click && mouse_x >= px(900) && mouse_x < px(1050) && mouse_y >= py(596) && mouse_y < py(640) ? ( hL = hR = -100; );

// ---------- S / M / L / ? ----------
g_j = 0;
loop(4,
  g_x = 998 + g_j * 14;  g_kon = g_j == 0 ? ui_sz == 1 : g_j == 1 ? ui_sz == 0 : g_j == 2 ? ui_sz == 2 : sz_help;
  col(C_BEZ, 1);  u_rect(g_x, 24, 13, 18);
  col(g_kon ? 0xF5E8C2 : 0x5A5650, 1);  u_rect(g_x + 1, 25, 11, 16);
  gfx_setfont(5);  col(g_kon ? 0x111214 : 0xF0ECE0, 1);  text_c(px(g_x + 6.5), py(33), g_j == 0 ? "S" : g_j == 1 ? "M" : g_j == 2 ? "L" : "?");
  click && !sz_help && mouse_x >= px(g_x) && mouse_x < px(g_x + 13) && mouse_y >= py(24) && mouse_y < py(42) ? (
    g_j == 0 ? ui_sz = 1 : g_j == 1 ? ui_sz = 0 : g_j == 2 ? ui_sz = 2 : ( sz_help = 1;  sz_new = 1; );
  );
  g_j += 1;
);
sz_help && click && !sz_new ? sz_help = 0;
sz_new = 0;
sz_help ? (
  col(0x000000, 0.62);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  strcpy(#hl3, "Manual - https://www.gardenfx.uk/manual/");  strcat(#hl3, #ui_man);  strcat(#hl3, ".pdf");
  gfx_setfont(5);  gfx_measurestr(#hl3, g_tw, g_th);
  g_cw = max(g_tw + ps(40), ps(380));  g_ch = ps(130);  g_cx = (gfx_w - g_cw) * 0.5;  g_cy = (gfx_h - g_ch) * 0.5;
  col(0x000000, 0.5);  ui_rrs(g_cx + ps(3), g_cy + ps(5), g_cw, g_ch, ps(8));
  col(0x1C1D20, 1);    ui_rrs(g_cx, g_cy, g_cw, g_ch, ps(8));
  col(C_ACC1, 1);      gfx_rect(g_cx + ps(20), g_cy + ps(36), g_cw - ps(40), max(1, ps(1)), 1);
  gfx_setfont(6);  col(0xF2F2EE, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(14);  gfx_drawstr("Design by JGWizrad.  © John Garden 2026");
  gfx_setfont(5);  col(0xE8B23A, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(50);  gfx_drawstr("https://www.gardenfx.uk/");
  col(0xD8D6D0, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(72);  gfx_drawstr(#hl3);
  col(0x85837E, 1);  gfx_x = g_cx + ps(20);  gfx_y = g_cy + ps(102);  gfx_drawstr("Click anywhere to close.");
);
!lmb ? ( drag_idx = 0;  drag_sh = 0; );
mouse_wheel = 0;
last_lmb = lmb;
gui_dirty ? ( prm_dirty = 1;  gui_dirty = 0; );   // targets are rebuilt in @block, never on the GUI thread
