desc:FIELD 76 Mini [channel strip] (GFX Lab)
//tags: channel strip eq preamp transformer pan stereo spaced pair location mixer mini
//author: GardenFX
// by JGWizrad / Garden FX (GFX)
// Requires gfx-lab-drift, gfx-lab-ui, gfx-lab-panel, gfx-lab-os, gfx-lab-bypass, gfx-lab-power (.jsfx-inc) in the same folder.

slider1:byp=0<0,1,1{Off,On}>-Bypass
slider2:gain_db=0<-20,30,0.1>-Gain (dB)
slider3:hpf_sel=0<0,2,1{Off,90 Hz,150 Hz}>-HPF
slider4:lf_db=0<-12,12,0.1>-LF (dB)
slider5:mf_db=0<-10,10,0.1>-MF (dB)
slider6:hf_db=0<-12,12,0.1>-HF (dB)
slider7:eq_in=1<0,1,1{Out,In}>-EQ
slider8:comp=0<0,1,1{Off,On}>-Voice comp
slider9:depth_pc=50<0,100,1>-Comp depth (%)
slider10:pan_pc=0<-100,100,1>-Pan (%)
slider11:space_cm=0<0,60,1>-Spacing (cm)
slider12:level_db=0<-40,10,0.1>-Level (dB)
slider13:drift_pc=50<0,100,1>-Drift (%)
slider14:os_sl=1<0,2,1{1x,2x,4x}>-Oversampling
slider15:prs_sel=0<0,11,1{No preset,Init,Dialogue: Close Mic,Dialogue: Boom,Interview: A Side,Interview: B Side,Acoustic Guitar Pair,Piano Wide,Vocal Warm Push,Drum Room Pair,Field Ambience,Tired Batteries}>-Preset

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-lab-drift.jsfx-inc
import gfx-lab-ui.jsfx-inc
import gfx-lab-panel.jsfx-inc
import gfx-lab-os.jsfx-inc
import gfx-lab-bypass.jsfx-inc
import gfx-lab-power.jsfx-inc

@init
#ui_man = "gfx-lab-field-76-mini";
ext_noinit = 1;

DL = 20000; DL_M = 4095;
CPR = 30000;
CR = 16;

function fm_db(d) ( exp(d * 0.11512925464970228); );
function fm_coef(t) ( 1 - exp(-1 / (max(t, 0.00001) * srate)); );
function fm_ts(x) ( x = max(-3, min(3, x)); x * (27 + x * x) / (27 + 9 * x * x); );
function fm_tn(x) ( abs(x) < 0.000000000001 ? 0 : x; );

RL0 = 1.2589; PB = 0.015; XK = 1.5; XW = 1.03; LINE_HR = 2;
pb_d = (fm_ts(PB + 0.0001) - fm_ts(PB - 0.0001)) / 0.0002;
pb_0 = fm_ts(PB);
function fm_rail(x, r) ( r * (fm_ts(x / r + PB) - pb_0) / pb_d; );
function fm_xf(x, r) instance(lo) local(s) (
  lo += (x - lo) * xf_c;
  s = fm_ts(lo * XK / r) * r / XK * XW;
  x + s - lo;
);

function fm_hpc(fc) instance(a1, a2, a3) local(g) (
  g = tan($pi * min(fc, 0.45 * eq_fs) / eq_fs);
  a1 = 1 / (1 + g * (g + 1.41421356)); a2 = g * a1; a3 = g * a2;
);
function fm_hpt(x) instance(a1, a2, a3, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  x - 1.41421356 * v1 - v2;
);
function fm_eqc(kind, fc, db, q) instance(a1, a2, a3, m0, m1, m2, k) local(a, g) (
  a = 10 ^ (db / 40);
  g = tan($pi * min(fc, 0.45 * eq_fs) / eq_fs);
  kind == 0 ? ( k = 1 / (q * a); m0 = 1; m1 = k * (a * a - 1); m2 = 0; ) :
  kind == 1 ? ( g /= sqrt(a); k = 1 / q; m0 = 1; m1 = k * (a - 1); m2 = a * a - 1; ) :
              ( g *= sqrt(a); k = 1 / q; m0 = a * a; m1 = k * (1 - a) * a; m2 = 1 - a * a; );
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function fm_eqt(x) instance(a1, a2, a3, m0, m1, m2, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  m0 * x + m1 * v1 + m2 * v2;
);
function fm_cpy() instance(a1, a2, a3, m0, m1, m2) ( a1 = fm_a1; a2 = fm_a2; a3 = fm_a3; m0 = fm_m0; m1 = fm_m1; m2 = fm_m2; );
function fm_get() instance(a1, a2, a3, m0, m1, m2) ( fm_a1 = a1; fm_a2 = a2; fm_a3 = a3; fm_m0 = m0; fm_m1 = m1; fm_m2 = m2; );
function fm_clr() instance(ic1, ic2) ( ic1 = ic2 = 0; );
function fm_tidy() instance(ic1, ic2) ( ic1 = fm_tn(ic1); ic2 = fm_tn(ic2); );
HF_F = 10000; MF_F = 2800; LF_F = 100; SHELF_Q = 0.55; MF_Q = 0.7;

function fm_chan(x) local(y, h) (
  y = XF.fm_xf(x, r_s);
  y = fm_rail(y, r_s);
  ol_v = max(ol_v, abs(y) / r_s);
  h = HP.fm_hpt(y); y += (h - y) * hp_s;
  h = HFQ.fm_eqt(MFQ.fm_eqt(LFQ.fm_eqt(y))); y += (h - y) * eq_s;
  fm_rail(y, r_s * LINE_HR);
);
function fm_chanb(x) local(y, h) (
  y = XFB.fm_xf(x, r_s);
  y = fm_rail(y, r_s);
  ol_v = max(ol_v, abs(y) / r_s);
  h = HPB.fm_hpt(y); y += (h - y) * hp_s;
  h = HFB.fm_eqt(MFB.fm_eqt(LFB.fm_eqt(y))); y += (h - y) * eq_s;
  fm_rail(y, r_s * LINE_HR);
);
function fm_chclr() (
  XF.lo = 0; XFB.lo = 0;
  HP.fm_clr(); HPB.fm_clr(); LFQ.fm_clr(); MFQ.fm_clr(); HFQ.fm_clr(); LFB.fm_clr(); MFB.fm_clr(); HFB.fm_clr();
);
function fm_chcoefs() (
  eq_fs = srate * os_f;
  xf_c = 1 - exp(-2 * $pi * 150 / eq_fs);
  HP.fm_hpc(exp(hpf_s)); HPB.a1 = HP.a1; HPB.a2 = HP.a2; HPB.a3 = HP.a3;
  LFQ.fm_eqc(1, LF_F, lf_s, SHELF_Q); LFQ.fm_get(); LFB.fm_cpy();
  MFQ.fm_eqc(0, MF_F, mf_s, MF_Q); MFQ.fm_get(); MFB.fm_cpy();
  HFQ.fm_eqc(2, HF_F, hf_s, SHELF_Q); HFQ.fm_get(); HFB.fm_cpy();
);

CP_F = 1265; CP_Q = 1.05; CP_DQ = 0.8; CP_OFS = 9; CP_RAT = 3; CP_MAX = 6; CP_LO = 220; CP_HI = 5000; CP_LIFT = 0.6;
function fm_bpc(fc, q) instance(a1, a2, a3, k) local(g) (
  g = tan($pi * min(fc, 0.45 * srate) / srate); k = 1 / q;
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function fm_bpt(x) instance(a1, a2, a3, k, ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  k * v1;
);
function fm_cpclr() (
  memset(CPR, 0, 2 * 10800); cp_w = 0; cp_sb = cp_sf = 0; cp_eb = cp_ef = 0;
  CPB.fm_clr(); CPD.fm_clr(); CPL.fm_clr(); CPH.fm_clr(); CDB.fm_clr(); CLB.fm_clr(); CHB.fm_clr();
);
function fm_cptick() local(ob, of, bd, fd, ex, cut) (
  ob = CPR[cp_w]; of = CPR[10800 + cp_w];
  CPR[cp_w] = cp_eb; CPR[10800 + cp_w] = cp_ef;
  cp_sb = max(cp_sb + cp_eb - ob, 0); cp_sf = max(cp_sf + cp_ef - of, 0);
  cp_eb = cp_ef = 0; cp_w += 1; cp_w >= cp_n ? cp_w = 0;
  cp_s += (comp - cp_s) * c_ct;
  cut = 0;
  cp_sf > 0.000000001 * cp_n * CR ? (
    bd = 10 * log10(max(cp_sb, 0.0000000000001)); fd = 10 * log10(cp_sf);
    ex = bd - fd + CP_OFS;
    cut = min(max(ex, 0) * (1 - 1 / CP_RAT), CP_MAX) * depth_pc / 50;
  ) : cut = cp_g / max(cp_s, 0.001);
  cp_g += (cut * cp_s - cp_g) * c_ct;
  cp_g < 0.0000001 ? cp_g = 0;
  cp_m = max(cp_m, cp_g);
  eq_fs = srate;
  CPD.fm_eqc(0, CP_F, -cp_g, CP_DQ); CPD.fm_get(); CDB.fm_cpy();
  CPL.fm_eqc(1, CP_LO, cp_g * CP_LIFT, SHELF_Q); CPL.fm_get(); CLB.fm_cpy();
  CPH.fm_eqc(2, CP_HI, cp_g * CP_LIFT, SHELF_Q); CPH.fm_get(); CHB.fm_cpy();
);

function fm_params() (
  g_t = fm_db(gain_db); lv_t = fm_db(level_db);
  hpf_sel >= 0.5 ? hpf_t = log(hpf_sel >= 1.5 ? 150 : 90);
  hpo_t = hpf_sel >= 0.5;
  os_tf = os_f2n(os_sl);
  drift_macro(drift_pc);
);

function fm_rate() (
  fm_sr = srate;
  c_kn = fm_coef(0.03); c_sw = fm_coef(0.01); c_ct = 1 - exp(-CR / (0.03 * srate));
  dc_c = 1 - 2 * $pi * 5 / srate;
  c_sga = fm_coef(0.02); c_sgr = fm_coef(0.4);
  cp_n = min(floor(0.9 * srate / CR + 0.5), 10800);
  CPB.fm_bpc(CP_F, CP_Q);
  rs_c = 1 / (0.015 * srate);
);

function fm_reset() (
  OSU.os_clr(); OSD.os_clr(); OSUB.os_clr(); OSDB.os_clr(); fm_chclr(); memset(DL, 0, DL_M + 1);
  dcx = dcy = dcxb = dcyb = 0;
  CPD.fm_clr(); CPL.fm_clr(); CPH.fm_clr(); CPB.fm_clr(); CDB.fm_clr(); CLB.fm_clr(); CHB.fm_clr();
  memset(BY_BUF, 0, 2 * BY_N);
  rs_f = 0;
);

fm_params();
fm_rate();
os_design();
os_f = os_tf = os_f2n(os_sl); os_base = 0;
os_gsetup();
hpf_t = hpf_sel >= 1.5 ? log(150) : log(90); hpf_s = hpf_t; hp_s = hpo_t;
hf_s = hf_db; mf_s = mf_db; lf_s = lf_db; eq_s = eq_in;
g_s = g_t; lv_s = lv_t; r_s = RL0; r_t = RL0;
pan_s = pan_pc; sp_s = space_cm; tau_s = 0; cp_s = comp;
fm_chcoefs(); fm_chclr();
cp_g = 0; fm_cpclr(); fm_cptick();
memset(DL, 0, DL_M + 1); dw = 0;
DRW.drift_init(0.8 + rand(1) * 0.4); DLW.drift_init(0.8 + rand(1) * 0.4);
drift_mm_init();
pwr_init(); pwr_hum_db = -83; pwr_sag = 0.1; pwr_wu_loss = 0.3; pwr_wu_drv = 0.6; pwr_wu_lp = 14000; pwr_wu_wob = 0.1; pwr_bloom = 0;
rs_f = 1; fm_snap = 1; fm_blk = 0;
pdc_delay = os_lat(os_f);
by_setup(1);
mn_vu_d = mn_pk_d = 0; mn_ms = mn_pkm = 0;

function fm_set(g, h, lf, mf, hf, pn, spc, lv, dft, cmp) (
  gain_db = g; hpf_sel = h; lf_db = lf; mf_db = mf; hf_db = hf; eq_in = 1; pan_pc = pn; space_cm = spc;
  level_db = lv; drift_pc = dft; comp = cmp; depth_pc = 50;
);
function load_preset(p) local(i) (
  p == 2  ? fm_set(0,   1,  -2,   2,   1,   0,   0,    0,  50,    1) :
  p == 3  ? fm_set(4,   2,  -3,   3,   2,   0,   0,   -4,  50,    1) :
  p == 4  ? fm_set(0,   1,  -2,   2,   1, -45,  25,    0,  50,    1) :
  p == 5  ? fm_set(0,   1,  -2,   2,   1,  45,  25,    0,  50,    1) :
  p == 6  ? fm_set(0,   1,  -2,  -1,   3, -35,  40,    0,  50,    0) :
  p == 7  ? fm_set(0,   0,   1,   0,   2,  30,  60,    0,  50,    0) :
  p == 8  ? fm_set(12,  1,   2,   1,   2,   0,   0,  -10,  50,    1) :
  p == 9  ? fm_set(6,   0,   3,  -2,   4, -70,  60,   -5,  50,    0) :
  p == 10 ? fm_set(0,   1,  -1,   0,   3,  20,  60,    0,  50,    0) :
  p == 11 ? fm_set(10,  0,   0,   0,   0,   0,   0,   -8, 100,    0) :
            fm_set(0,   0,   0,   0,   0,   0,   0,    0,  50,    0);
  p == 12 ? os_sl = 1;
  i = 2; loop(12, ui_auto(i); i += 1; ); p == 12 ? ui_auto(14);
  pr_cur = p == 12 ? 1 : p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

function prs_hash() local(i, h) ( h = 0; i = 1; loop(14, h += slider(i) * (1 + i * 0.7071); i += 1; ); h; );
function prs_same() local(h, r) ( h = prs_hash(); r = h == prs_h0; prs_h0 = h; r; );
function prs_chk() local(k) (
  prs_dirty > 0 ? (
    k = prs_dirty; prs_dirty = 0; load_preset(k);
    k = k > 11 ? 1 : k;
    prs_sel = k; slider_automate(prs_sel); prs_cur_d = k;
    prs_last = prs_sel; prs_h0 = prs_hash();
  ) : prs_ok ? (
    prs_sel = max(0, min(11, prs_sel | 0));
    prs_hs = prs_same(); prs_sel != prs_last ? ( prs_last = prs_sel; prs_sel > 0 && prs_hs ? ( load_preset(prs_sel); prs_cur_d = prs_sel; prs_h0 = prs_hash(); ); );
  ) : ( prs_last = prs_sel | 0; prs_ok = 1; prs_h0 = prs_hash(); );
);
prs_ok = 0; prs_dirty = 0;

@slider
prs_chk();
fm_params();
os_snap(os_sl);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);
file_avail(0) != 0 ? file_var(0, prs_last) : prs_last = prs_sel | 0; prs_ok = 1;
file_avail(0) >= 0 && fm_blk < 40 ? fm_snap = 1;
pwr_ser();
drift_mm_ser();

@block
prs_chk();
fm_blk < 40 ? fm_blk += 1;
srate != fm_sr ? ( fm_rate(); fm_chcoefs(); fm_cpclr(); );
fm_params();
pwr_block(byp < 0.5);
rs_now = time_precise();
rs_last > 0 && rs_now - rs_last > max(0.25, 4 * samplesblock / srate) && !(play_position > rs_gpp && play_position - rs_gpp < 4 * rs_gpd + 0.05) ? fm_reset();
rs_last = rs_now; rs_gpp = play_position; rs_gpd = samplesblock / srate;
pdc_delay = os_lat(os_f);
pdc_bot_ch = 0; pdc_top_ch = 2;
bdt = samplesblock / srate;
d_rw = DRW.drift_tick(0.07 * dm_s * bdt); d_lw = DLW.drift_tick(0.11 * dm_s * bdt);
bat_db = dm_a * (1.5 + 0.4 * d_rw) + 2 * dm_a * min(sg_env, 1);
r_t = RL0 * fm_db(-bat_db);
lw_g = fm_db(0.1 * dm_a * d_lw);
drift_mm(0.1, 0.4);
fm_snap ? (
  fm_snap = 0;
  g_s = g_t; lv_s = lv_t; hf_s = hf_db; mf_s = mf_db; lf_s = lf_db; hpf_s = hpf_t; hp_s = hpo_t; eq_s = eq_in;
  pan_s = pan_pc; sp_s = space_cm; tau_s = space_cm / 34300 * sin(pan_pc * 0.005 * $pi) * srate; tau_t = tau_s;
  r_s = r_t; cp_s = comp; dmm_gl = dmm_glt; dmm_gr = dmm_grt; dmm_kl = dmm_klt; dmm_kr = dmm_krt;
  dmm_ol = dmm_gl / dmm_kl; dmm_or = dmm_gr / dmm_kr;
  fm_chcoefs(); cr_n = 0;
);
XF.fm_tidy(); XFB.fm_tidy();
HP.fm_tidy(); HPB.fm_tidy(); LFQ.fm_tidy(); MFQ.fm_tidy(); HFQ.fm_tidy(); LFB.fm_tidy(); MFB.fm_tidy(); HFB.fm_tidy();
CPD.fm_tidy(); CPL.fm_tidy(); CPH.fm_tidy(); CPB.fm_tidy(); CDB.fm_tidy(); CLB.fm_tidy(); CHB.fm_tidy();
dcy = fm_tn(dcy); dcyb = fm_tn(dcyb); sg_env = fm_tn(sg_env);
fm_lo_d = bat_db;
fm_ol_d = max(fm_ol_d, ol_m); ol_m = 0;
fm_cp_d = max(fm_cp_d, cp_m); cp_m = 0;
fm_cpon_d = comp >= 0.5;
mn_vu_d = max(mn_vu_d, sqrt(mn_ms / max(samplesblock, 1))); mn_ms = 0; mn_pk_d = max(mn_pk_d, mn_pkm); mn_pkm = 0;
os_snapb(os_sl);

@sample
spl0 != spl0 ? spl0 = 0; spl1 != spl1 ? spl1 = 0;
by_in();
cr_n <= 0 ? (
  cr_n = CR;
  hf_s += (hf_db - hf_s) * c_ct; mf_s += (mf_db - mf_s) * c_ct; lf_s += (lf_db - lf_s) * c_ct;
  hpf_s += (hpf_t - hpf_s) * c_ct;
  r_s += (r_t - r_s) * c_ct;
  fm_cptick();
  fm_chcoefs();
  pn_t = (pan_s * 0.01 + 1) * 0.25 * $pi; p_gl = cos(pn_t) * 1.41421356; p_gr = sin(pn_t) * 1.41421356;
  p_b = 0.4 * min(sp_s / 30, 1); p_a = 0.6 * min(sp_s / 20, 1);
  p_gl2 = p_gl + (1 - p_gl) * p_b; p_gr2 = p_gr + (1 - p_gr) * p_b;
  tau_t = sp_s / 34300 * sin(pan_s * 0.005 * $pi) * srate;
);
cr_n -= 1;
g_s += (g_t - g_s) * c_kn; lv_s += (lv_t - lv_s) * c_kn;
hp_s += (hpo_t - hp_s) * c_sw; eq_s += (eq_in - eq_s) * c_sw;
pan_s += (pan_pc - pan_s) * c_kn; sp_s += (space_cm - sp_s) * c_kn;
tau_s += (tau_t - tau_s) * c_kn;
drift_mm_glide(c_kn);

pwr_in(spl0 * g_s, spl1 * g_s); x = pwr_l * dmm_kl; xb = pwr_r * dmm_kr;
sg_x = max(abs(x), abs(xb)) / RL0;
sg_env += (min(sg_x, 2) - sg_env) * (sg_x > sg_env ? c_sga : c_sgr);
os_gate();
os_chg ? ( fm_chcoefs(); fm_chclr(); os_hold += 2 * samplesblock; );
OSU.os_up(x); OSUB.os_up(xb);
os_f == 1 ? ( y = fm_chan(OSU.s0); yb = fm_chanb(OSUB.s0); ) :
os_f == 2 ? (
  a0 = fm_chan(OSU.s0); a1 = fm_chan(OSU.s1); y = OSD.os_dn(a0, a1, 0, 0);
  a0 = fm_chanb(OSUB.s0); a1 = fm_chanb(OSUB.s1); yb = OSDB.os_dn(a0, a1, 0, 0);
) : (
  a0 = fm_chan(OSU.s0); a1 = fm_chan(OSU.s1); a2 = fm_chan(OSU.s2); a3 = fm_chan(OSU.s3); y = OSD.os_dn(a0, a1, a2, a3);
  a0 = fm_chanb(OSUB.s0); a1 = fm_chanb(OSUB.s1); a2 = fm_chanb(OSUB.s2); a3 = fm_chanb(OSUB.s3); yb = OSDB.os_dn(a0, a1, a2, a3);
);
y *= dmm_ol; yb *= dmm_or;
dcy = y - dcx + dc_c * dcy; dcx = y; y = dcy;
dcyb = yb - dcxb + dc_c * dcyb; dcxb = yb; yb = dcyb;
cp_mx = (y + yb) * 0.5; cp_v = CPB.fm_bpt(cp_mx); cp_eb += cp_v * cp_v; cp_ef += cp_mx * cp_mx;
y = CPH.fm_eqt(CPL.fm_eqt(CPD.fm_eqt(y))); yb = CHB.fm_eqt(CLB.fm_eqt(CDB.fm_eqt(yb)));
pwr_out(y, yb); y = pwr_l; yb = pwr_r;
m = (y + yb) * 0.5 * lv_s * lw_g; sd = (y - yb) * 0.5 * lv_s * lw_g;
ol_m = max(ol_m, ol_v); ol_v = 0;

DL[dw] = m;
td = max(tau_s, 0); ti = floor(td); tf = td - ti;
mA = DL[(dw - ti) & DL_M] * (1 - tf) + DL[(dw - ti - 1) & DL_M] * tf;
td = max(-tau_s, 0); ti = floor(td); tf = td - ti;
mB = DL[(dw - ti) & DL_M] * (1 - tf) + DL[(dw - ti - 1) & DL_M] * tf;
dw = (dw + 1) & DL_M;
mm = 0.5 * (p_gl + p_gr) * m;
sl = 0.5 * (p_gl - p_gr) * m;
ss = sl + p_a * (0.5 * (p_gl2 * mA - p_gr2 * mB) - sl);
oa = mm + ss + sd * p_gl; ob = mm - ss - sd * p_gr;

os_q = os_g * os_g * (3 - 2 * os_g); oa *= os_q; ob *= os_q;
oa != oa ? oa = 0; ob != ob ? ob = 0;
rs_f < 1 ? (
  rs_f = min(rs_f + rs_c, 1); rs_q = rs_f * rs_f * (3 - 2 * rs_f);
