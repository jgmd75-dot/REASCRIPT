  a = max(-1, min(1, (note - 54) / 24)) * 0.5;  b[F_PANL] = sqrt(0.5 - 0.5 * a);  b[F_PANR] = sqrt(0.5 + 0.5 * a);
  b[F_KIND] = 0;  b[F_FMV] = 1;  b[F_BS] = 0;  b[F_BT] = 0;  b[F_EA] = 1;  b[F_ED] = 1;  b[F_ES] = 0;  b[F_ER] = 1;
  // the group: its octave, growl and breath (the growl fades out and the breath grows a little in the higher voices)
  b[F_GW] = 1 - 0.283 * st_grp;  b[F_BRG] = 0.18 * (1 + 0.15 * st_grp);
  !b[F_AEN] ? ( b[F_FEN] = 0;  b[F_FS1] = 0;  b[F_FS2] = 0;  b[F_FS3] = 0;  b[F_FS4] = 0; );
  b[F_FST] = 1;  b[F_PAST] = 1;  v_filt(b);
