// a voice of a given kind: 0 voice, 1 fog horn (played from the keys), 2 choir singer (breathes)
function v_start_k(b, note, vel, kd) local(a) (
  v_start(b, note, vel);  b[F_KIND] = kd;
  kd == 1 ? ( b[F_AST] = 1;  b[F_HP1] = rand(1);  b[F_HP2] = rand(1);  b[F_HP3] = rand(1);  b[F_OCT] = floor(h_oct + 0.5) * 12;  b[F_DRP] = 1;  b[F_FEN] = 0;  b[F_FST] = 1;  b[F_PAST] = 1;  h_coef(b);  v_inc(b); );
  kd == 2 ? (
    b[F_NDT] = (rand(2) - 1) * 0.12 + (rand(2) - 1) * 0.06 * dm_a;          // each singer a little off the note ...
    b[F_FMV] = 1 + (rand(1) - 0.5) * 0.08;                                 // ... with a throat of their own ...
    a = (rand(2) - 1) * 0.75;  b[F_PANL] = sqrt(0.5 - 0.5 * a);  b[F_PANR] = sqrt(0.5 + 0.5 * a);   // ... somewhere in the choir
    b[F_GAIN] *= ch_g;  b[F_BS] = 0;  b[F_BT] = 1 + rand(1) * 8;          // the first breaths are staggered
    // DRIFT: each singer's envelope a little their own (times +/-25 %, sustain +/-8 % at the standard 50 %)
    b[F_EA] = 2 ^ ((rand(2) - 1) * 0.4 * dm_a);  b[F_ED] = 2 ^ ((rand(2) - 1) * 0.4 * dm_a);  b[F_ER] = 2 ^ ((rand(2) - 1) * 0.4 * dm_a);
    b[F_ES] = (rand(2) - 1) * 0.08 * dm_a;
  );
);
// allocate without re-using a voice on the same note (the choir and the horns stack)
function v_alloc2(note, vel, kd) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? b[F_AEN] : 2 + b[F_AGE];
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  b = VOX + best * VS;
  b[F_ON] && b[F_AEN] > 0.0005 ? ( b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel;  b[F_PKND] = kd;  b[F_PGRP] = st_grp; ) : v_start_k(b, note, vel, kd);
);
function v_alloc(note, vel) local(v, b, best, bq, q) (
  best = 0;  bq = 1000000000;  v = 0;
  loop(NV,
    b = VOX + v * VS;
    q = !b[F_ON] ? -1 : (!b[F_GATE] && !b[F_SUS]) ? b[F_AEN] : 2 + b[F_AGE];
    b[F_ON] && b[F_NOTE] == note && b[F_GRP] == st_grp && b[F_KIND] == 0 && !b[F_STEAL] ? q = -2;
    q < bq ? ( bq = q;  best = v; );
    v += 1;
  );
  b = VOX + best * VS;
  b[F_ON] && b[F_AEN] > 0.0005 && !(b[F_NOTE] == note && b[F_GRP] == st_grp) ? ( b[F_STEAL] = 1;  b[F_PEND] = note;  b[F_PVEL] = vel;  b[F_PKND] = 0;  b[F_PGRP] = st_grp; ) : v_start(b, note, vel);
);
function v_release(note) local(v, b) (
  v = 0;
  loop(NV, b = VOX + v * VS;
    b[F_ON] && b[F_GATE] && b[F_NOTE] == note ? ( sustain ? b[F_SUS] = 1;  b[F_GATE] = 0;  b[F_AST] = 4; );
    b[F_STEAL] && b[F_PEND] == note ? b[F_PEND] = -1;
    v += 1; );
);
function v_all_off() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_ON] ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_AST] = 4; );  v += 1; ); );
function v_pedal_up() local(v, b) ( v = 0;  loop(NV, b = VOX + v * VS;  b[F_SUS] ? ( b[F_SUS] = 0;  b[F_AST] = 4; );  v += 1; ); );
function keys_down() local(k, n) ( n = 0;  k = 0;  loop(NV, VOX[k * VS + F_ON] && (VOX[k * VS + F_GATE] || VOX[k * VS + F_SUS]) ? n += 1;  k += 1; );  n; );
// a key in the choir: the 8 singers are shared out - each held key keeps up to SINGERS, fewer when many keys are held
function choir_on(note, vel) local(k, n, v, b, i, j, per, c, f, hn) (
  hn = 0;  v = 0;  loop(NV, b = VOX + v * VS;  b[F_ON] && b[F_KIND] == 1 && (b[F_GATE] || b[F_SUS]) ? hn += 1;  v += 1; );   // horns held keep their voices
  n = 0;  v = 0;                                                         // the other held choir keys
  loop(NV, b = VOX + v * VS;
    b[F_ON] && b[F_KIND] == 2 && (b[F_GATE] || b[F_SUS]) && b[F_NOTE] != note ? (
      f = 0;  i = 0;  loop(n, CN[i] == b[F_NOTE] ? f = 1;  i += 1; );  !f ? ( CN[n] = b[F_NOTE];  n += 1; ); );
    v += 1; );
  per = min(floor(singers + 0.5), max(1, floor((NV - hn) / ((n + 1) * max(1, gn_on)))));   // shared by the keys and the groups singing
  ch_g = 1 / sqrt(per);
  i = 0;                                                                 // the others give up their extra singers (they fade out)
  loop(n, j = 0;
    loop(4, c = 0;  v = 0;
      loop(NV, b = VOX + v * VS;
        b[F_ON] && b[F_KIND] == 2 && (b[F_GATE] || b[F_SUS]) && b[F_NOTE] == CN[i] && b[F_GRP] == j ? ( c += 1;  c > per ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_AST] = 4; ); );
        v += 1; );
      j += 1; );
    i += 1; );
  v_release(note);                                                       // the same key again: a fresh choir
  j = 0;  loop(4, GC[j * GCS] ? ( st_grp = j;  loop(per, v_alloc2(note, vel, 2); ); );  j += 1; );
);
function midi_event(i) local(mst, d1, d2, c) (
  mst = MQ[i * 4 + 1] & 0xF0;  d1 = MQ[i * 4 + 2];  d2 = MQ[i * 4 + 3];
  mst == 0x90 && d2 > 0 ? ( seq_on && !bgrid && !keys_down() ? sq_start = 1;               // free-running: the first key starts the pattern
    c = split_on >= 0.5 ? ( d1 < split_pt ? z_lo >= 0.5 : z_hi >= 0.5 ) : 0;              // SPLIT: this key's zone - a voice or the fog horn
    c ? ( st_grp = 0;  v_alloc2(d1, d2, 1); ) : choir >= 0.5 ? choir_on(d1, d2) : ( c = 0;  loop(4, GC[c * GCS] ? ( st_grp = c;  v_alloc(d1, d2); );  c += 1; ); ); ) :
  (mst == 0x80 || (mst == 0x90 && d2 == 0)) ? v_release(d1) :
  mst == 0xE0 ? bend = ((d2 * 128 + d1) - 8192) / 8192 * 2 :
  mst == 0xB0 ? (
    d1 == 64 ? ( c = d2 >= 64;  sustain && !c ? v_pedal_up();  sustain = c; ) :
    (d1 == 123 || d1 == 120) ? v_all_off();
  );
);

// ---------- control tick ----------
function v_tick_v(b) local(es, c, fs) (
  // CHOIR: a singer sings 8 - 9 s, takes a 1 s breath (a soft inhale), rejoins on a fresh vowel
  b[F_KIND] == 2 && !seq_on && (b[F_GATE] || b[F_SUS]) ? (
    b[F_BT] -= CR / srate;
    b[F_BT] <= 0 ? (
      b[F_BS] ? ( b[F_BS] = 0;  b[F_BT] = 8 + rand(1);  b[F_AST] = 1;  syl_next(b);  cons_start(b); )
              : ( b[F_BS] = 1;  b[F_BT] = 1;  b[F_AST] = 5;  breath_d = 1; );
    );
  );
  b[F_AST] == 5 ? b[F_AEN] *= bf_c;                                      // the singer's note fades as they breathe in
  b[F_SUS] && !b[F_GATE] && b[F_AST] == 4 ? b[F_AST] = 2;
  c = GC + b[F_GRP] * GCS;
  !c[0] && b[F_AST] != 4 ? ( b[F_GATE] = 0;  b[F_SUS] = 0;  b[F_AST] = 4; );            // its group switched off: it lets go
  a_inc = c[3];  d_c = c[4];  e_sus = c[5];  r_c = c[6];                  // the group's AMP ENVELOPE
  // AMP ENVELOPE: attack, decay, sustain, release (per tick, ramped per sample by the glide below)
  //   (a choir singer's own times and sustain: F_EA / F_ED / F_ER x the knob's time, F_ES + the sustain)
  b[F_AST] == 1 ? ( b[F_AEN] += seq_on && stacc >= 0.5 ? a_inc_s : a_inc / b[F_EA];  b[F_AEN] >= 1 ? ( b[F_AEN] = 1;  b[F_AST] = 2; ); ) :
  b[F_AST] == 2 ? ( es = max(0, min(1, e_sus + b[F_ES]));  b[F_AEN] = es + (b[F_AEN] - es) * (b[F_ED] == 1 ? d_c : d_c ^ (1 / b[F_ED])); ) :   // decay to the sustain level
  b[F_AST] == 3 ? ( b[F_AEN] *= stacc >= 0.5 ? r_cs : (b[F_ER] == 1 ? r_c : r_c ^ (1 / b[F_ER])); ) :
  b[F_AST] == 4 ? ( b[F_AEN] *= (b[F_ER] == 1 ? r_c : r_c ^ (1 / b[F_ER]));  b[F_AEN] < 0.0001 && !b[F_STEAL] ? ( b[F_AEN] = 0;  b[F_ON] = 0; ); );
  // FILTER ENVELOPE: it follows the amp's gate - a new attack whenever the amp starts one (a note, a syllable, a breath's end)
  b[F_AST] == 1 && b[F_PAST] != 1 ? b[F_FST] = 1 :
  (b[F_AST] >= 3) ? b[F_FST] = 4 : b[F_AST] == 2 && b[F_FST] == 4 ? b[F_FST] = 2;
  b[F_PAST] = b[F_AST];
  b[F_FST] == 1 ? ( b[F_FEN] += c[12] / b[F_EA];  b[F_FEN] >= 1 ? ( b[F_FEN] = 1;  b[F_FST] = 2; ); ) :
  b[F_FST] == 2 ? ( fs = c[14];  b[F_FEN] = fs + (b[F_FEN] - fs) * c[13]; ) :
  b[F_FEN] *= c[15];
  v_filt(b);
  // syllables
  b[F_VT] = min(1, b[F_VT] + g_inc);
  b[F_VTM] -= CR / srate;  b[F_VTM] <= 0 && b[F_AST] != 4 && !seq_on ? syl_next(b);       // (under RUN the pattern sets the syllables)
  // DRIFT: each voice's formant wander (a new target every 1 - 3 s)
  b[F_WTM] -= CR / srate * dm_s;  b[F_WTM] <= 0 ? ( b[F_WT] = rand(2) - 1;  b[F_WTM] = 1 + rand(2); );
  b[F_WD] += (b[F_WT] - b[F_WD]) * dr_c;
  v_inc(b);  v_form(b);
);

function v_tick(b) (
  b[F_KIND] == 1 ? (
    // a fog horn played from the keys: it swells (FOG SWELL) and dies away (FOG RELEASE)
    b[F_SUS] && !b[F_GATE] && b[F_AST] == 4 ? b[F_AST] = 2;
    b[F_AST] == 1 ? ( b[F_AEN] += h_ainc;  b[F_AEN] >= 1 ? ( b[F_AEN] = 1;  b[F_AST] = 2; ); ) :
    b[F_AST] == 4 ? ( b[F_AEN] *= h_rc;  b[F_AEN] < 0.0001 && !b[F_STEAL] ? ( b[F_AEN] = 0;  b[F_ON] = 0; ); );
    // its FILTER ENVELOPE (with the swell), its DROP and the WOBBLE
    b[F_AST] == 1 && b[F_PAST] != 1 ? b[F_FST] = 1 : b[F_AST] == 4 ? b[F_FST] = 4 : b[F_AST] == 2 && b[F_FST] == 4 ? b[F_FST] = 2;
    b[F_PAST] = b[F_AST];
    b[F_FST] == 1 ? ( b[F_FEN] += h_fa;  b[F_FEN] >= 1 ? ( b[F_FEN] = 1;  b[F_FST] = 2; ); ) :
    b[F_FST] == 2 ? ( b[F_FEN] = h_fs + (b[F_FEN] - h_fs) * h_fd; ) : b[F_FEN] *= h_fr;
    b[F_DRP] *= h_dc;
    h_coef(b);
    v_inc(b);  b[F_INC] = min(0.45, b[F_INC] * 2 ^ ((h_drop * b[F_DRP] + h_wob) / 12));
  ) : v_tick_v(b);
);

// ---------- one voice, one sample ----------
function v_run(b) local(d, ph, s, g, x, k, q, v1, v2, v3, y, nz, ty, kd, ct, vo, cn, te, cl) (
  d = b[F_INC];
  ph = b[F_PH] + d;  ph >= 1 ? ph -= 1;  b[F_PH] = ph;
  s = saw_bl(ph, d);                                                    // the glottal buzz
  // ONSET: how much the voice sounds through the consonant (vo), and the consonant's own noise (cn, after the formants)
  vo = 1;  cn = 0;  ty = b[F_CTY];
  ty > 0 && b[F_CT] < 0.2 ? (
    kd = CON[ty * 8];  ct = b[F_CT];  cl = CON[ty * 8 + 1];  b[F_CT] = ct + 1 / srate;
    kd == 1 ? (
      ct < cl ? vo = CON[ty * 8 + 3] * 0.12 : (                           // the closure (a voiced stop hums faintly) ...
        te = ct - cl;
        cn = te < 0.012 ? 1.3 * (1 - te / 0.012) : 0;                    // ... the burst ...
        CON[ty * 8 + 3] ? vo = min(1, te / 0.006) :
          te < CON[ty * 8 + 4] ? ( vo = 0;  cn = max(cn, 0.45 * (1 - 0.6 * te / CON[ty * 8 + 4])); ) : vo = min(1, (te - CON[ty * 8 + 4]) / 0.01);   // ... the breath of an unvoiced one
      );
    ) :
    kd == 2 ? ( vo = ct < cl ? 0.6 : 1; ) :
    kd == 4 ? ( ct < cl ? ( vo = 0;  cn = 0.4 * min(1, ct / 0.02) * min(1, (cl - ct) / 0.015); ) : vo = min(1, (ct - cl) / 0.01); );
  );
  s *= vo;
  growl_g * b[F_GW] > 0.0001 ? (                                                       // the growl: a band-limited square an octave down
    ph = b[F_PH2] + d * 0.5;  ph >= 1 ? ph -= 1;  b[F_PH2] = ph;
    x = ph + 0.5;  x >= 1 ? x -= 1;  s += growl_g * b[F_GW] * (saw_bl(ph, d * 0.5) - saw_bl(x, d * 0.5)) * 0.5 * vo;
  );
  nz = rand(2) - 1;  b[F_BR] += (nz - b[F_BR]) * 0.3;
  s += b[F_BR] * b[F_BRG];                                                  // breath (a little more in the higher voices)
  b[F_CLK] > 0.0005 ? ( b[F_NZ] += (nz - b[F_NZ]) * 0.6;  s += (nz - b[F_NZ]) * b[F_CLK] * 2.5;  b[F_CLK] *= clk_dc; );
  // four formants in parallel
  y = 0;  k = 0;
  loop(4,
    q = b + F_B + k * 6;
    v3 = s - q[1];  v1 = q[2] * q[0] + q[3] * v3;  v2 = q[1] + q[3] * q[0] + q[4] * v3;
    q[0] = 2 * v1 - q[0];  q[1] = 2 * v2 - q[1];
    y += v1 * q[5];
    k += 1;
  );
  // the group's FILTER (LP 12, LP 24, BP or HP)
  b[F_FON] ? (
    GC[b[F_GRP] * GCS + 19] == 1 ? (
      v3 = y - b[F_FS4];  v1 = b[F_FB1] * b[F_FS3] + b[F_FB2] * v3;  v2 = b[F_FS4] + b[F_FB2] * b[F_FS3] + b[F_FB3] * v3;
      b[F_FS3] = 2 * v1 - b[F_FS3];  b[F_FS4] = 2 * v2 - b[F_FS4];  y = v2;
    );
    v3 = y - b[F_FS2];  v1 = b[F_FA1] * b[F_FS1] + b[F_FA2] * v3;  v2 = b[F_FS2] + b[F_FA2] * b[F_FS1] + b[F_FA3] * v3;
    b[F_FS1] = 2 * v1 - b[F_FS1];  b[F_FS2] = 2 * v2 - b[F_FS2];
    k = GC[b[F_GRP] * GCS + 19];
    y = k <= 1 ? v2 : k == 2 ? v1 * b[F_FK] : y - b[F_FK] * v1 - v2;
  );
  g = b[F_AEN] * b[F_GAIN] * b[F_FADE] * b[F_ACC] * GC[b[F_GRP] * GCS + 17] * GC[b[F_GRP] * GCS + 43];
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? ( b[F_FADE] = 0;  b[F_STEAL] = 0;  b[F_AEN] = 0;
      b[F_PEND] >= 0 ? ( st_grp = b[F_PGRP];  v_start_k(b, b[F_PEND], b[F_PVEL], b[F_PKND]); ) : b[F_ON] = 0; );
  );
  y *= g;
  // ONSET: the consonant's noise - a band of noise at its place (the burst, the aspiration, the hiss)
  cn > 0 ? (
    b[F_CB1] += b[F_CBG] * (nz - b[F_CB2] - b[F_CB1] * 0.7);  b[F_CB2] += b[F_CBG] * b[F_CB1];
    y += b[F_CB1] * cn * 0.22 * b[F_GAIN] * b[F_FADE] * b[F_ACC] * GC[b[F_GRP] * GCS + 17];        // (the group's level too)
  );
  // CHOIR: the inhale - airy noise rising and falling in the breath's second
  b[F_BS] && (b[F_GATE] || b[F_SUS]) ? (
    x = 1 - b[F_BT];  x = x > 0.15 && x < 0.85 ? sin($pi * (x - 0.15) / 0.7) : 0;
    b[F_HF1] += (nz - b[F_HF1]) * in_lp;  b[F_HF2] += (b[F_HF1] - b[F_HF2]) * in_hp;
    y += (b[F_HF1] - b[F_HF2]) * x * 0.16 * b[F_GAIN] * b[F_FADE] * GC[b[F_GRP] * GCS + 17];   // TWEAK: the inhale (quiet, -10 dB)
  );
  q = GC + b[F_GRP] * GCS;  vxL += y * b[F_PANL] * q[23];  vxR += y * b[F_PANR] * q[24];     // the STEP SEQUENCER's gate and pan
);
// a fog horn voice (from the keys): the drone's reedy pair at the key's pitch, FOG DETUNE apart, a sub an octave down
function h_run(b) local(d, d2, q1, q2, z, o, g) (
  d = b[F_INC];  d2 = d * 2 ^ (fd_now / 1200);
  b[F_HP1] += d;  b[F_HP1] >= 1 ? b[F_HP1] -= 1;  b[F_HP2] += d2;  b[F_HP2] >= 1 ? b[F_HP2] -= 1;  b[F_HP3] += d * 0.5;  b[F_HP3] >= 1 ? b[F_HP3] -= 1;
  q1 = b[F_HP1] + 0.18;  q1 >= 1 ? q1 -= 1;  q2 = b[F_HP2] + 0.18;  q2 >= 1 ? q2 -= 1;
  z = (saw_bl(b[F_HP1], d) - saw_bl(q1, d)) + (saw_bl(b[F_HP2], d2) - saw_bl(q2, d2));
  q1 = z - b[F_FS2];  q2 = b[F_FA1] * b[F_FS1] + b[F_FA2] * q1;  z = b[F_FS2] + b[F_FA2] * b[F_FS1] + b[F_FA3] * q1;   // TONE
  b[F_FS1] = 2 * q2 - b[F_FS1];  b[F_FS2] = 2 * z - b[F_FS2];
  g = b[F_AEN] * b[F_AEN] * b[F_GAIN] * b[F_FADE];
  b[F_STEAL] ? (
    b[F_FADE] -= fade_step;
    b[F_FADE] <= 0 ? ( b[F_FADE] = 0;  b[F_STEAL] = 0;  b[F_AEN] = 0;  b[F_FS1] = 0;  b[F_FS2] = 0;
      b[F_PEND] >= 0 ? ( st_grp = b[F_PGRP];  v_start_k(b, b[F_PEND], b[F_PVEL], b[F_PKND]); ) : b[F_ON] = 0; );
  );
  o = (z * 0.9 * h_rd + sin(2 * $pi * b[F_HP3]) * 0.6 * h_sb) * g;       // REED and SUB
  hxL += o * b[F_PANL];  hxR += o * b[F_PANR];
);

// ---------- the pattern: a step speaks every held key (a new syllable), or silences them ----------
function seq_step(v) local(k, b) (
  k = 0;
  loop(NV,
    b = VOX + k * VS;
    b[F_ON] && !(b[F_KIND] == 1) && (b[F_GATE] || b[F_SUS]) && !b[F_STEAL] ? (
      v > 0 ? ( b[F_AST] = 1;  b[F_ACC] = v == 2 ? 1 : 0.68;  syl_next(b);  cons_start(b); ) : b[F_AST] == 1 || b[F_AST] == 2 ? b[F_AST] = 3;
    );
    k += 1;
  );
);
function seq_gate_off() local(k, b) (
  k = 0;  loop(NV, b = VOX + k * VS;  b[F_ON] && b[F_KIND] != 1 && (b[F_AST] == 1 || b[F_AST] == 2) ? b[F_AST] = 3;  k += 1; );
);
function seq_switch(on) local(k, b) (
  k = 0;
  loop(NV, b = VOX + k * VS;
    b[F_ON] && b[F_KIND] != 1 && (b[F_GATE] || b[F_SUS]) ? ( on ? ( b[F_AST] == 1 || b[F_AST] == 2 ? b[F_AST] = 3; ) : ( b[F_AST] = 1;  b[F_ACC] = 1; ); );
    k += 1; );
  seq_on = on;  sq_start = on;
);

ch_g = 1;  bend = 0;  sustain = 0;  age_n = 0;  cr_n = 0;  seq_on = 0;  sq_start = 0;  bpos = 0;  step_d = -1;  fog_e = 0;  fp1 = 0;  fp2 = 0;  fp3 = 0;  fs_s = fshift;
h_onx = h_on >= 0.5;  fg_st = 0;  fg_fe = 0;  fg_dd = 0;  fg_held = 0;  h_wph = 0;  h_wob = 0;  fi1m = fi2m = fi3m = 0;
rvd_s = rv_decay;  sz_cur = 0.3 + 0.7 * rv_size / 100;  RVB = 1910;
st_grp = 0;
fg.drift_init(0.8 + rand(0.3));  fw.drift_init(1 + rand(0.4));
ost_init(0);  ostL.ost_ch_init();  ostR.ost_ch_init();
fl_w = 0;  wow_p = 0;  flt_p = 0;  fl_dg = 0.0002 * srate * dm_a;
bv_alloc(FX_MEM);  RVM = 1900;  k = 0;  loop(8, RVM[k] = rand(1);  k += 1; );

function update_params() local(j, c, i, k) (
  drift_macro(drift);
  // the groups (BASS TENOR ALTO SOPRANO): on, level, octave, AMP ENVELOPE, FILTER, FILTER ENVELOPE
  gn_on = 0;  j = 0;
  loop(4, c = GC + j * GCS;  i = 33 + j * 16;
    c[0] = slider(i) >= 0.5;  gn_on += c[0];
    c[1] = c[0] * 10 ^ (slider(i + 1) / 20) * (j == 0 ? 1 : j == 1 ? 0.76 : j == 2 ? 0.76 : 0.62);   // TWEAK: level-matched in each group's own range
    c[2] = floor(slider(i + 2) + 0.5) * 12;
    c[3] = CR / max(1, slider(i + 3) * srate);  c[4] = exp(-4.6 * CR / max(1, slider(i + 4) * srate));
    c[5] = slider(i + 5) / 100;  c[6] = exp(-6.9 * CR / max(1, slider(i + 6) * srate));
    c[7] = floor(slider(i + 7) + 0.5);  c[8] = slider(i + 8);  c[9] = 1 / (0.707 + slider(i + 9) / 100 * 11);   // RESONANCE: Q 0.7 - 12
    c[10] = slider(i + 10) / 100 * 6;  c[11] = slider(i + 11) / 100;
    c[12] = CR / max(1, slider(i + 12) * srate);  c[13] = exp(-4.6 * CR / max(1, slider(i + 13) * srate));
    c[14] = slider(i + 14) / 100;  c[15] = exp(-6.9 * CR / max(1, slider(i + 15) * srate));
    // STEP SEQUENCER (Oontecho's): steps, size, gate DEPTH, GLIDE, ACCENT, SWING, PAN, FILTER, and the filter's LFO
    i = 97 + j * 11;
    c[26] = slider(i) >= 0.5;
    k = floor(slider(i + 1) + 0.5);  c[27] = k == 0 ? 8 : k == 1 ? 12 : k == 2 ? 16 : k == 3 ? 24 : 32;
    k = floor(slider(i + 2) + 0.5);  c[28] = k == 0 ? 1 : k == 1 ? 0.5 : k == 2 ? 1 / 3 : k == 3 ? 0.25 : k == 4 ? 1 / 6 : 0.125;   // beats a step
    c[29] = slider(i + 3) / 100;  c[30] = c[28] * (1 + slider(i + 6) / 100);                                  // depth, the swung step's start
    c[31] = 10 ^ (slider(i + 5) * 0.06 / 20);  c[32] = slider(i + 5) / 100 * 1.5;                              // ACCENT: up to +6 dB, 1.5 octaves
    c[33] = slider(i + 7) / 100;  c[34] = slider(i + 8);  c[35] = slider(i + 9);
    k = floor(slider(i + 10) + 0.5);
    c[36] = k == 0 ? 16 : k == 1 ? 8 : k == 2 ? 4 : k == 3 ? 2 : k == 4 ? 3 : k == 5 ? 4 / 3 : k == 6 ? 1 : k == 7 ? 1.5 : k == 8 ? 2 / 3 :
            k == 9 ? 0.5 : k == 10 ? 0.75 : k == 11 ? 1 / 3 : k == 12 ? 0.25 : k == 13 ? 0.375 : k == 14 ? 1 / 6 : 0.125;    // LFO: beats a cycle
    c[37] = 1 - exp(-1 / ((0.0007 + (slider(i + 4) / 100) ^ 2 * 0.5 * c[28] * 60 / max(tempo, 20)) * 0.5 * srate));   // GLIDE
    c[38] = (c[26] && (c[34] != 0 || c[32] > 0)) || c[35] != 0;                                                 // the steps or the LFO move the filter
    j += 1; );
  a_inc = GC[3];
  g_inc = CR / max(1, 0.12 * srate);                                   // a syllable glides in 120 ms
  clk_dc = exp(-1 / (0.008 * srate));
  dr_c = 1 - exp(-CR * dm_s / (1.2 * srate));
  fade_step = 1 / (0.003 * srate);
  growl_t = growl / 100 * 0.5;
  vg_t = sin(vmix / 100 * $pi * 0.5);  fgg_t = cos(vmix / 100 * $pi * 0.5);   // VOCAL MIX: equal-power, voice against fog
  out_t = 10 ^ (vol / 20);  sm_c = 1 - exp(-1 / (0.03 * srate));        // gains glide over 30 ms
  fa_c = 1 / max(1, fog_att * srate);  fr_c = exp(-6.9 / max(1, fog_rel * srate));
  h_ainc = CR / max(1, fog_att * srate);  h_rc = exp(-6.9 * CR / max(1, fog_rel * srate));   // the keyboard horns: the same swell and release
  // the FOG HORN's layer: TONE, RESONANCE, its filter envelope, REED, SUB, DRIVE, DROP, WOBBLE
  h_k = 2 - h_res / 100 * 1.9;  h_rd = h_reed / 100;  h_sb = h_sub / 100;
  h_dg = 1.3 * 2 ^ (h_drv / 100 * 4);  h_dk = 0.143 * 10 ^ (-4.6 / 20 * (h_drv / 100) ^ 0.6);   // DRIVE (level-matched)
  h_fa = CR / max(1, h_fatt * srate);  h_fd = exp(-4.6 * CR / max(1, h_fdec * srate));  h_fs = h_fsus / 100;  h_fr = exp(-6.9 * CR / max(1, h_frel * srate));
  h_dc = exp(-4.6 * CR / max(1, h_dropt * srate));
  bf_c = exp(-6.9 * CR / max(1, 0.18 * srate));                       // CHOIR: a singer's note fades in 180 ms to breathe
  in_lp = 1 - exp(-2 * $pi * 3200 / srate);  in_hp = 1 - exp(-2 * $pi * 700 / srate);   // the inhale's colour
  horn_z = split_on >= 0.5 && (z_lo >= 0.5 || z_hi >= 0.5);
  mdk = CR / (0.005 * srate);  md_s = 1 - exp(-1 / (0.0015 * srate));
  a_inc_s = CR / max(1, 0.006 * srate);                                // staccato syllables start within 6 ms
  r_cs = exp(-6.9 * CR / max(1, 0.07 * srate));                       // ... and stop in 70 ms
  sq_len = pat_div < 0.5 ? 0.125 : pat_div < 1.5 ? 0.25 : pat_div < 2.5 ? 1 / 3 : pat_div < 3.5 ? 0.5 : pat_div < 4.5 ? 2 / 3 :
           pat_div < 5.5 ? 0.75 : pat_div < 6.5 ? 1 : pat_div < 7.5 ? 2 : 4;   // beats per step
  sq_mode = floor(pat_mode + 0.5);  sq_mode == 2 ? sq_len *= 2 / 3;
  sp_live = rv_mix > 0.05;
  rg_c = 1 - exp(-CR / (0.06 * srate));
);
update_params();
k = 0;  loop(4, gq = GC + k * GCS;  gq[19] = gq[7];  gq[20] = 1;  gq[21] = gq[8];  gq[17] = gq[1];  gq[22] = 0;  gq[23] = 1;  gq[24] = 1;  gq[39] = gq[35];  gq[40] = gq[34];  gq[41] = gq[32];  gq[42] = gq[9];  gq[43] = 1;
  sqp = SQ + k * SQS;  sqp[0] = -999999;  sqp[6] = 1;  sqp[7] = 1;  sqp[15] = 1;  k += 1; );
vg = vg_t;  fgg = fgg_t;  out_g = out_t;  sp_mx = rv_mix / 100;  growl_g = growl_t;

@slider
update_params();

@block
mq_n = 0;
while (mq_n < MQMAX && midirecv(m_ofs, m_st, m_d1, m_d2)) (
  MQ[mq_n * 4] = m_ofs;  MQ[mq_n * 4 + 1] = m_st;  MQ[mq_n * 4 + 2] = m_d1;  MQ[mq_n * 4 + 3] = m_d2;
  mq_n += 1;  midisend(m_ofs, m_st, m_d1 + m_d2 * 256);
);
mq_i = 0;  spos = 0;
tp_now = play_state & 1;  tp_was && !tp_now ? v_all_off();  tp_was = tp_now;
prm_dirty ? ( prm_dirty = 0;  update_params(); );
(seq_run >= 0.5) != seq_on ? seq_switch(seq_run >= 0.5);
// the pattern clock: beats, locked to REAPER's grid while it plays, free from RUN otherwise
bpinc = max(tempo, 20) / 60 / srate;
tp_now ? ( bpos = beat_position;  bgrid = 1; ) : bgrid = 0;
sq_lb = pat_sync >= 0.5 ? sq_len : max(tempo, 20) / 60 / max(pat_hz, 0.1);   // FREE: PATTERN RATE in Hz
// the reverb: SIZE sets the line lengths and pre-delay; decay and damping
kb2 = min(1, samplesblock / (0.25 * srate));                         // the reverb's size and decay glide (preset changes)
rvd_s += (rv_decay - rvd_s) * kb2;
sz_t = 0.3 + 0.7 * rv_size / 100;                                     // SIZE: the line lengths glide per sample (no jumps)
sz_c = 1 - exp(-1 / (0.3 * srate));
k = 0;
loop(8,
  ms = k == 0 ? 29.7 : k == 1 ? 37.1 : k == 2 ? 41.1 : k == 3 ? 43.7 : k == 4 ? 53.9 : k == 5 ? 59.3 : k == 6 ? 67.1 : 73.3;
  RVB[k] = ms * 0.001 * srate * 1.6;  ln_len[k] = RVB[k] * sz_cur;
  RVM[k] += samplesblock / srate * (0.07 + 0.013 * k);  RVM[k] -= floor(RVM[k]);
  ln_mod[k] = (6 + 5 * sin(2 * $pi * RVM[k])) * srate / 48000;
  k += 1;
);
bv_t60 = rvd_s;  bv_rtlo = 1.25;  bv_rthi = 1 - 0.82 * 0.45;
k = 0;  loop(8, bv_loss(k, ln_len[k]);  k += 1; );
bv_xover();
kb = min(1, samplesblock / (0.03 * srate));
// the fog horn: two tones FOG DETUNE apart; DRIFT wanders the detune (+/-30 %) and the pitch a touch
fd_now = fog_det * (1 + fg.drift_tick(0.25 * samplesblock / srate * dm_s) * 0.3 * dm_a);
ft_now = fog_tune * 2 ^ (fw.drift_tick(0.2 * samplesblock / srate * dm_s) * 0.04 * dm_a / 12);
ft_now *= 2 ^ floor(h_oct + 0.5);                                     // OCTAVE
fi1 = ft_now / srate;  fi2 = ft_now * 2 ^ (fd_now / 1200) / srate;  fi3 = ft_now * 0.5 / srate;
// any key down: the horn swells
held_any = 0;  vb = VOX;  loop(NV, (vb[F_ON] && vb[F_KIND] != 1 && (vb[F_GATE] || vb[F_SUS])) ? held_any = 1;  vb += VS; );
horn_z ? held_any = 0;                                                 // a zone plays the horn from the keys: no drone
ost_setup(0, 0.3, 120, 6000, -0.3, 1);
outpk_d = max(outpk_d, outpk);  outpk = 0;  vpk_d = max(vpk_d, vpk);  vpk = 0;  fpk_d = max(fpk_d, fpk);  fpk = 0;
k = 0;  loop(NV, VD[k] = VOX[k * VS + F_ON] ? VOX[k * VS + F_AEN] : 0;  VD[16 + k] = VOX[k * VS + F_KIND] == 1 ? 4 : VOX[k * VS + F_GRP];  k += 1; );
// tape stage: wow (0.6 Hz) and flutter (7 Hz), depth with DRIFT
fl_dep = 0.0002 * srate * dm_a;

@sample
while (mq_i < mq_n && MQ[mq_i * 4] <= spos) ( midi_event(mq_i);  mq_i += 1; );
spos += 1;
// ---------- the pattern ----------
seq_on ? (
  sq_start ? ( sq_start = 0;  p0 = bgrid ? 0 : bpos;  sq_k = floor((bpos - p0) / sq_lb) - 1; );
  q = floor((bpos - p0) / sq_lb);
  q != sq_k ? (
    sq_k = q;  q = PLEN[sq_mode];  sq_i = sq_k % q;  sq_i < 0 ? sq_i += q;
    sq_v = PT[sq_mode * 16 + sq_i];  seq_step(sq_v);  step_d = sq_i;  hit_d = sq_v;  hit_n_d += 1;
    sq_g = (stacc >= 0.5 ? 0.25 : 0.85) * sq_lb * 60 / max(tempo, 20) * srate;     // the syllable's length
  );
  sq_g > 0 ? ( sq_g -= 1;  sq_g <= 0 ? seq_gate_off(); );
) : step_d = -1;
bpos += bpinc;
cr_n <= 0 ? ( cr_n = CR;
  fs_s += (fshift - fs_s) * rg_c;                                    // FORMANT SHIFT glides per tick
  growl_g += (growl_t - growl_g) * rg_c;
  // the FOG HORN (drone): a new swell starts its filter envelope and its DROP; the WOBBLE (a slow vibrato, both horns)
  held_any && !fg_held ? ( fg_st = 1;  fg_dd = 1; ) : !held_any && fg_held ? fg_st = 4;  fg_held = held_any;
  fg_st == 1 ? ( fg_fe += h_fa;  fg_fe >= 1 ? ( fg_fe = 1;  fg_st = 2; ); ) : fg_st == 2 ? fg_fe = h_fs + (fg_fe - h_fs) * h_fd : fg_fe *= h_fr;
  fg_dd *= h_dc;
  h_wph += h_wrate * CR / srate;  h_wph -= floor(h_wph);  h_wob = h_wdep / 100 * sin(2 * $pi * h_wph);
  fg_m = 2 ^ ((h_drop * fg_dd + h_wob) / 12);  fi1m = min(0.45, fi1 * fg_m);  fi2m = min(0.45, fi2 * fg_m);  fi3m = fi3 * fg_m;
  g_f = max(30, min(h_tone * 2 ^ (h_fenv / 100 * 6 * fg_fe), 0.45 * srate));
  g_t = tan($pi * g_f / srate);  fg_a1 = 1 / (1 + g_t * (g_t + h_k));  fg_a2 = g_t * fg_a1;  fg_a3 = g_t * fg_a2;
  k = 0;
  loop(4, gq = GC + k * GCS;
    gq[17] += (gq[1] - gq[17]) * rg_c;                                      // the groups' levels glide,
    gq[21] *= (gq[8] / gq[21]) ^ rg_c;                                      // ... their cut-offs too (60 ms),
    gq[42] += (gq[9] - gq[42]) * rg_c;  gq[39] += (gq[35] - gq[39]) * rg_c;  gq[40] += (gq[34] - gq[40]) * rg_c;  gq[41] += (gq[32] - gq[41]) * rg_c;   // the step / LFO depths glide (60 ms)
    gq[7] != gq[19] ? ( gq[20] -= mdk;  gq[20] <= 0 ? ( gq[20] = 0;  gq[19] = gq[7]; ); ) : gq[20] = min(1, gq[20] + mdk);   // ... and a MODE change dips 5 ms, swaps, comes back
    gq[16] = !(gq[19] <= 1 && gq[7] <= 1 && gq[8] >= 19500 && gq[21] >= 19400 && gq[10] == 0 && gq[11] == 0 && gq[9] > 1.3 && gq[42] > 1.3 && !gq[38] && abs(gq[22]) < 0.001);   // wide open: no filter (saves CPU)
    k += 1; );
  vb = VOX;  loop(NV, vb[F_ON] ? v_tick(vb);  vb += VS; ); );
cr_n -= 1;

// ---------- STEP SEQUENCER (per group, Oontecho's): the gate, the pan and the filter move with the steps ----------
k = 0;
loop(4,
  gq = GC + k * GCS;  sqp = SQ + k * SQS;
  gq[43] += (gq[20] - gq[43]) * md_s;                                   // the MODE dip, smooth per sample
  gq[26] || gq[35] != 0 || gq[39] != 0 || !sqp[15] ? (                                   // (an idle group that has settled is skipped)
    dv = gq[28];  q = floor(bpos / (2 * dv));  sg = q * 2 + (bpos - q * 2 * dv >= gq[30]);
    sg != sqp[0] ? (                                                       // a new step: its level and accent
      sqp[0] = sg;  q = gq[27];  sqp[1] = sg - floor(sg / q) * q;
      sv = SP[k * 32 + sqp[1]];  sa = sv > 127.5;  sl = min(max((sv - 128 * sa) / 100, 0), 1);
      sqp[2] = sl;  sqp[3] = sa;  sqp[4] = (1 - gq[29] + gq[29] * sl) * (sa ? gq[31] : 1);  sqp[5] = gq[33] * sl * ((sqp[1] & 1) ? 1 : -1);
    );
    gq[26] ? ( stl = sqp[2];  sta = sqp[3];  stg = sqp[4];  stp = sqp[5]; ) : ( stl = 0;  sta = 0;  stg = 1;  stp = 0; );   // off: it glides home
    sgc = gq[37];
    sqp[14] += bpinc / gq[36];  sqp[14] -= floor(sqp[14]);              // the LFO's phase (a RATE change never jumps it)
    sqp[6] += (stg - sqp[6]) * sgc;  sqp[7] += (sqp[6] - sqp[7]) * sgc;
    sqp[8] += (stl - sqp[8]) * sgc;  sqp[9] += (sqp[8] - sqp[9]) * sgc;
    sqp[10] += (sta - sqp[10]) * sgc;  sqp[11] += (sqp[10] - sqp[11]) * sgc;
    sqp[12] += (stp - sqp[12]) * sgc;  sqp[13] += (sqp[12] - sqp[13]) * sgc;
    gq[23] = sqp[7] * (sqp[13] > 0 ? 1 - sqp[13] : 1);  gq[24] = sqp[7] * (sqp[13] < 0 ? 1 + sqp[13] : 1);
    gq[22] = gq[40] * sqp[9] + gq[41] * sqp[11] + gq[39] * sin(2 * $pi * sqp[14]);                    // + the FILTER LFO (depths glided)
    sqp[15] = !gq[26] && gq[35] == 0 && abs(gq[39]) < 0.0001 && abs(sqp[7] - 1) < 0.00001 && abs(sqp[13]) < 0.00001 && abs(sqp[9]) < 0.00001 && abs(sqp[11]) < 0.00001;
    sqp[15] ? ( sqp[6] = sqp[7] = 1;  sqp[8] = sqp[9] = sqp[10] = sqp[11] = sqp[12] = sqp[13] = 0;  gq[22] = 0;  gq[23] = gq[24] = 1; );
  );
  k += 1;
);
// voices
vxL = 0;  vxR = 0;  hxL = 0;  hxR = 0;  vb = VOX;
loop(NV, vb[F_ON] ? ( vb[F_KIND] == 1 ? h_run(vb) : v_run(vb); );  vb += VS; );
vxL *= 0.22;  vxR *= 0.22;                                             // TWEAK: the voice level

vg += (vg_t - vg) * sm_c;  fgg += (fgg_t - fgg) * sm_c;  out_g += (out_t - out_g) * sm_c;  sp_mx += (rv_mix / 100 - sp_mx) * sm_c;
// the fog horn
fog_e = held_any ? min(1, fog_e + fa_c) : fog_e * fr_c;
fog_e > 0.00002 ? (
  fp1 += fi1m;  fp1 >= 1 ? fp1 -= 1;  fp2 += fi2m;  fp2 >= 1 ? fp2 -= 1;  fp3 += fi3m;  fp3 >= 1 ? fp3 -= 1;
  // reedy: narrow pulses (saw minus a shifted saw), low-passed; the sub a soft sine an octave down
  q1 = fp1 + 0.18;  q1 >= 1 ? q1 -= 1;  q2 = fp2 + 0.18;  q2 >= 1 ? q2 -= 1;
  fz = (saw_bl(fp1, fi1m) - saw_bl(q1, fi1m)) + (saw_bl(fp2, fi2m) - saw_bl(q2, fi2m));
  q1 = fz - fh2;  q2 = fg_a1 * fh1 + fg_a2 * q1;  fz = fh2 + fg_a2 * fh1 + fg_a3 * q1;  fh1 = 2 * q2 - fh1;  fh2 = 2 * fz - fh2;   // TONE
  fo = (fz * 0.9 * h_rd + sin(2 * $pi * fp3) * 0.6 * h_sb) * fog_e * fog_e;                                 // REED and SUB
  fo = ts(fo * h_dg) * h_dk * h_onx;                                          // TWEAK: the horn's grit (DRIVE), the fog level
) : ( fo = 0;  fh1 = 0;  fh2 = 0; );
h_onx += ((h_on >= 0.5) - h_onx) * sm_c;                              // the HORN key: on / off (30 ms)
hxL = ts(hxL * h_dg) * h_dk * h_onx;  hxR = ts(hxR * h_dg) * h_dk * h_onx;            // the keyboard horns, as loud as the drone
vpk = max(vpk, max(abs(vxL), abs(vxR)) * vg);  fpk = max(fpk, max(abs(fo), max(abs(hxL), abs(hxR))) * fgg);
yl = vxL * vg + (fo * 0.92 + hxL) * fgg;  yr = vxR * vg + (fo + hxR) * fgg;

// ---------- the huge reverb (house engine) ----------
sp_live || rv_tail > 0.00001 ? (
  sz_cur += (sz_t - sz_cur) * sz_c;
  ln_len[0] = RVB[0] * sz_cur;  ln_len[1] = RVB[1] * sz_cur;  ln_len[2] = RVB[2] * sz_cur;  ln_len[3] = RVB[3] * sz_cur;
  ln_len[4] = RVB[4] * sz_cur;  ln_len[5] = RVB[5] * sz_cur;  ln_len[6] = RVB[6] * sz_cur;  ln_len[7] = RVB[7] * sz_cur;
  sp_pre = (sz_cur - 0.3) / 0.7 * 0.04 * srate + 0.01 * srate;  pr_i = floor(sp_pre);  pr_f = sp_pre - pr_i;   // pre-delay, read between samples
  bv_pre(yl, yr);
  pl = pre_l(pr_i);  pr = pre_r(pr_i);  pl += (pre_l(pr_i + 1) - pl) * pr_f;  pr += (pre_r(pr_i + 1) - pr) * pr_f;
  dif_run(pl, pr, 0.75, 0.9);                                          // (the diffusers keep one size: no jumps)
  fdn_run(dif_l, dif_r);
  yl += fdn_l * 0.55 * sp_mx;  yr += fdn_r * 0.55 * sp_mx;
  rv_tail = max(abs(fdn_l), abs(fdn_r)) * 0.001 + rv_tail * 0.999;
);

// ---------- tape stage: a light saturation with wow and flutter (DRIFT) ----------
FL[fl_w] = yl;  FL[512 + fl_w] = yr;
wow_p += 0.6 / srate;  wow_p -= floor(wow_p);  flt_p += 7.1 / srate;  flt_p -= floor(flt_p);
fl_dg += (fl_dep - fl_dg) * sm_c;                                     // (a DRIFT change glides: the tape never jumps)
fl_d = 2 + fl_dg * (1 + 0.7 * sin(2 * $pi * wow_p) + 0.3 * sin(2 * $pi * flt_p));
fl_r = fl_w - fl_d;  fl_r < 0 ? fl_r += 512;  fl_i = floor(fl_r);  fl_f = fl_r - fl_i;  fl_j = (fl_i + 1) % 512;
yl = FL[fl_i] + (FL[fl_j] - FL[fl_i]) * fl_f;  yr = FL[512 + fl_i] + (FL[512 + fl_j] - FL[512 + fl_i]) * fl_f;
fl_w = (fl_w + 1) % 512;
yl = ts(yl * 1.15) / 1.15;  yr = ts(yr * 1.15) / 1.15;

yl *= out_g;  yr *= out_g;
ost_out(yl, yr);  yl = ost_l;  yr = ost_r;
outpk = max(outpk, max(abs(yl), abs(yr)));
spl0 = yl;  spl1 = yr;

@serialize
file_var(0, pr_cur);
file_var(0, ui_sz);
file_avail(0) != 0 ? ( file_var(0, sp_ok);  file_mem(0, SP, 128); );

@gfx 1200 850
// =====================================================================
// GUI - HPT77: a weathered charcoal faceplate, luminescent teal and white print, big pointer knobs, cream keys,
// meters and lamps. (Checkpoint 1: the working panel; checkpoint 2 adds the pattern sequencer and the reverb.)
// =====================================================================
C_FACE = 0x3A3B3D;  C_SEC1 = 0x434446;  C_SEC2 = 0x3F4042;  C_SEC3 = 0x47484A;
C_INK = 0xF2F2EE;  C_INK2 = 0xA8B3B2;  C_TEAL = 0x4FE0D0;  C_LCDBG = 0x061614;  C_LCDTX = 0x6FF2E2;
LK_YEL = 0xF2C230;  LK_AMB = 0xF2A41E;  LK_RED = 0xF0503A;  lk_well = 0x0E0F10;

function col(h, a) ( gfx_r = floor(h / 65536) / 255;  gfx_g = (floor(h / 256) % 256) / 255;  gfx_b = (h % 256) / 255;  gfx_a = a; );
function shade(h, f) local(r, g, b) (
  r = min(255, floor(floor(h / 65536) * f));  g = min(255, floor((floor(h / 256) % 256) * f));  b = min(255, floor((h % 256) * f));
  r * 65536 + g * 256 + b;
);
function ui_mix(c1, c2, t) (
  floor(floor(c1 / 65536) * (1 - t) + floor(c2 / 65536) * t) * 65536 +
  floor((floor(c1 / 256) % 256) * (1 - t) + (floor(c2 / 256) % 256) * t) * 256 + floor((c1 % 256) * (1 - t) + (c2 % 256) * t);
);
function px(v) ( ox + v * sc; );
function py(v) ( oy + v * sc; );
function ps(v) ( v * sc; );
function u_rect(x, y, w, h) ( gfx_rect(px(x), py(y), ps(w), ps(h), 1); );
function text_c(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x - w * 0.5;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function text_l(x, y, str) local(w, h) ( gfx_measurestr(str, w, h);  gfx_x = x;  gfx_y = y - h * 0.5;  gfx_drawstr(str); );
function rivet(x, y) ( col(0x5A5B5E, 1);  gfx_circle(px(x), py(y), ps(4), 1, 1);  col(0x8A8C90, 1);  gfx_circle(px(x) - ps(1), py(y) - ps(1), ps(1.4), 1, 1); );
// weathering: faint scuffs and stains, painted once into image 121 (again on resize)
function wx_rnd() ( wx_s = (wx_s * 16807) % 2147483647;  wx_s / 2147483647; );
function wx_build() local(i, x, y, r) (
  gfx_setimgdim(121, ceil(ps(1200)), ceil(ps(850)));  gfx_dest = 121;
  col(C_FACE, 1);  gfx_rect(0, 0, ps(1200), ps(850), 1);
  wx_s = 7177;  i = 0;
  loop(420, x = wx_rnd() * 1200;  y = wx_rnd() * 850;  r = 2 + wx_rnd() * 22;  x < 460 && y < 80 ? y += 90;     // the title's corner stays clear
    col(wx_rnd() < 0.5 ? 0x000000 : 0xFFFFFF, 0.012 + 0.018 * wx_rnd());  gfx_circle(ps(x), ps(y), ps(r), 1, 1);  i += 1; );
  i = 0;  loop(160, x = wx_rnd() * 1200;  y = wx_rnd() * 850;  col(0xFFFFFF, 0.04);  gfx_line(ps(x), ps(y), ps(x + 6 + wx_rnd() * 30), ps(y + wx_rnd() * 3 - 1.5), 1);  i += 1; );
  gfx_dest = -1;  wx_sc = sc;
);
function section(x, y, w, h, c, title) (
  col(0x000000, 0.35);  u_rect(x + 2, y + 3, w, h);
  col(c, 1);  u_rect(x, y, w, h);
  col(shade(c, 0.7), 1);  u_rect(x, y + h - 2, w, 2);  u_rect(x + w - 2, y, 2, h);
  col(0xFFFFFF, 0.1);  u_rect(x, y, w - 2, 1);
  col(C_TEAL, 0.9);  u_rect(x + 16, y + 34, w - 32, 2);
  gfx_setfont(4);  col(C_TEAL, 1);  text_l(px(x + 16), py(y + 19), title);
);
// automation above slider 63 goes by name
function auto_hi(i) (
  i == 64 ? slider_automate(gt_frel) :
  i == 65 ? slider_automate(ga_on) :
  i == 66 ? slider_automate(ga_lvl) :
  i == 67 ? slider_automate(ga_oct) :
  i == 68 ? slider_automate(ga_att) :
  i == 69 ? slider_automate(ga_dec) :
  i == 70 ? slider_automate(ga_sus) :
  i == 71 ? slider_automate(ga_rel) :
  i == 72 ? slider_automate(ga_fmod) :
  i == 73 ? slider_automate(ga_cut) :
  i == 74 ? slider_automate(ga_res) :
  i == 75 ? slider_automate(ga_fenv) :
  i == 76 ? slider_automate(ga_ktrk) :
  i == 77 ? slider_automate(ga_fatt) :
  i == 78 ? slider_automate(ga_fdec) :
  i == 79 ? slider_automate(ga_fsus) :
  i == 80 ? slider_automate(ga_frel) :
  i == 81 ? slider_automate(gs_on) :
  i == 82 ? slider_automate(gs_lvl) :
  i == 83 ? slider_automate(gs_oct) :
  i == 84 ? slider_automate(gs_att) :
  i == 85 ? slider_automate(gs_dec) :
  i == 86 ? slider_automate(gs_sus) :
  i == 87 ? slider_automate(gs_rel) :
  i == 88 ? slider_automate(gs_fmod) :
  i == 89 ? slider_automate(gs_cut) :
  i == 90 ? slider_automate(gs_res) :
  i == 91 ? slider_automate(gs_fenv) :
  i == 92 ? slider_automate(gs_ktrk) :
  i == 93 ? slider_automate(gs_fatt) :
  i == 94 ? slider_automate(gs_fdec) :
  i == 95 ? slider_automate(gs_fsus) :
  i == 96 ? slider_automate(gs_frel) :
  i == 97 ? slider_automate(gb_ston) :
  i == 98 ? slider_automate(gb_stn) :
  i == 99 ? slider_automate(gb_sdiv) :
  i == 100 ? slider_automate(gb_sdep) :
  i == 101 ? slider_automate(gb_sgld) :
  i == 102 ? slider_automate(gb_sacc) :
  i == 103 ? slider_automate(gb_sswg) :
  i == 104 ? slider_automate(gb_span) :
  i == 105 ? slider_automate(gb_sflt) :
  i == 106 ? slider_automate(gb_slfo) :
  i == 107 ? slider_automate(gb_slrt) :
  i == 108 ? slider_automate(gt_ston) :
  i == 109 ? slider_automate(gt_stn) :
  i == 110 ? slider_automate(gt_sdiv) :
  i == 111 ? slider_automate(gt_sdep) :
  i == 112 ? slider_automate(gt_sgld) :
  i == 113 ? slider_automate(gt_sacc) :
  i == 114 ? slider_automate(gt_sswg) :
  i == 115 ? slider_automate(gt_span) :
  i == 116 ? slider_automate(gt_sflt) :
  i == 117 ? slider_automate(gt_slfo) :
  i == 118 ? slider_automate(gt_slrt) :
  i == 119 ? slider_automate(ga_ston) :
  i == 120 ? slider_automate(ga_stn) :
  i == 121 ? slider_automate(ga_sdiv) :
  i == 122 ? slider_automate(ga_sdep) :
  i == 123 ? slider_automate(ga_sgld) :
  i == 124 ? slider_automate(ga_sacc) :
  i == 125 ? slider_automate(ga_sswg) :
  i == 126 ? slider_automate(ga_span) :
  i == 127 ? slider_automate(ga_sflt) :
  i == 128 ? slider_automate(ga_slfo) :
  i == 129 ? slider_automate(ga_slrt) :
  i == 130 ? slider_automate(gs_ston) :
  i == 131 ? slider_automate(gs_stn) :
  i == 132 ? slider_automate(gs_sdiv) :
  i == 133 ? slider_automate(gs_sdep) :
  i == 134 ? slider_automate(gs_sgld) :
  i == 135 ? slider_automate(gs_sacc) :
  i == 136 ? slider_automate(gs_sswg) :
  i == 137 ? slider_automate(gs_span) :
  i == 138 ? slider_automate(gs_sflt) :
  i == 139 ? slider_automate(gs_slfo) :
  i == 140 ? slider_automate(gs_slrt) :
  i == 141 ? slider_automate(h_oct) :
  i == 142 ? slider_automate(h_drv) :
  i == 143 ? slider_automate(h_drop) :
  i == 144 ? slider_automate(h_dropt) :
  i == 145 ? slider_automate(h_wrate) :
  i == 146 ? slider_automate(h_wdep) :
  i == 147 ? slider_automate(h_fatt) :
  i == 148 ? slider_automate(h_fdec) :
  i == 149 ? slider_automate(h_fsus) :
  i == 150 ? slider_automate(h_frel) :
  i == 151 ? slider_automate(h_on);
);
function param_touched(idx) ( idx <= 63 ? slider_automate(2 ^ (idx - 1)) : auto_hi(idx);  gui_dirty = 1; );
function pointer(x, y, sa, ca, r0, r1, hw) local(ax, ay, bx, by, dx, dy) (
  ax = x + sa * r0;  ay = y - ca * r0;  bx = x + sa * r1;  by = y - ca * r1;  dx = ca * hw;  dy = sa * hw;
  gfx_triangle(ax + dx, ay + dy, bx + dx, by + dy, bx - dx, by - dy, ax - dx, ay - dy);
  gfx_line(ax + dx, ay + dy, bx + dx, by + dy, 1);  gfx_line(ax - dx, ay - dy, bx - dx, by - dy, 1);
);
function fmtv(v, fmt) (
  fmt == 1 ? sprintf(#kv, "%d %%", v) :
  fmt == 2 ? sprintf(#kv, "%.1f Hz", v) :
  fmt == 3 ? sprintf(#kv, "%+.1f st", v) :
  fmt == 4 ? sprintf(#kv, "%+.1f dB", v) :
  fmt == 5 ? sprintf(#kv, "%.1f c", v) :
  fmt == 7 ? sprintf(#kv, "%.2f Hz", v) :
  fmt == 10 ? sprintf(#kv, "%+.2f oct", v) :
  fmt == 9 ? ( v >= 1000 ? sprintf(#kv, "%.1f kHz", v / 1000) : sprintf(#kv, "%d Hz", floor(v + 0.5)); ) :
  fmt == 8 ? ( v < 1 ? sprintf(#kv, "%d ms", floor(v * 1000 + 0.5)) : sprintf(#kv, "%.2f s", v); ) :
  fmt == 6 ? ( v = floor(v + 0.5);  strcpy(#kv, v == 0 ? "1/32" : v == 1 ? "1/16" : v == 2 ? "1/8 T" : v == 3 ? "1/8" : v == 4 ? "1/4 T" :
              v == 5 ? "1/8 D" : v == 6 ? "1/4" : v == 7 ? "1/2" : "1 bar"); ) :
  sprintf(#kv, "%.2f", v);
  #kv;
);
function hover_tag(x, y, str) local(w, h) (
  gfx_setfont(3);  gfx_measurestr(str, w, h);
  col(C_LCDBG, 0.95);  gfx_rect(x - w * 0.5 - ps(6), y - h * 0.5 - ps(3), w + ps(12), h + ps(6), 1);
  col(C_LCDTX, 1);  text_c(x, y, str);
);
// big industrial pointer knob: a knurled black skirt, a dark cap, a white pointer bar; teal and white scale
function kn(cx, cy, r, idx, vmin, vmax, def, lbl, fmt) local(x, y, rr, v, t, hov, now, a0, a1, tv, b, j, lgt, st)
(
  lgt = klog;  klog = 0;  st = kstep;  kstep = 0;
  x = px(cx);  y = py(cy);  rr = ps(r);
  hov = sqr(mouse_x - x) + sqr(mouse_y - y) <= sqr(rr * 1.2);
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  click && hov && !drag_idx ? (
    now = time_precise();
    (mouse_cap & 4) || (last_click_idx == idx && now - last_click_t < 0.3) ? ( slider(idx) = def;  param_touched(idx);  drag_idx = 0; )
                                                                           : ( drag_idx = idx;  drag_y = mouse_y;  drag_t = t; );
    last_click_idx = idx;  last_click_t = now;
  );
  hov && mouse_wheel != 0 && !drag_idx ? (
    st > 0 ? v = max(vmin, min(vmax, v + sign(mouse_wheel) * st)) : (
      t = max(0, min(1, t + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.03)));
      v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    );
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
    mouse_wheel = 0;
  );
  drag_idx == idx ? (
    t = max(0, min(1, drag_t + (drag_y - mouse_y) / ps((mouse_cap & 8) ? 1100 : 220)));
    v = lgt ? vmin * exp(t * log(vmax / vmin)) : vmin + t * (vmax - vmin);
    st > 0 ? v = vmin + floor((v - vmin) / st + 0.5) * st : v = floor(v * 10 + 0.5) / 10;
    v = max(vmin, min(vmax, v));
    v != slider(idx) ? ( slider(idx) = v;  param_touched(idx); );
  );
  v = max(vmin, min(vmax, slider(idx)));
  t = lgt ? log(v / vmin) / log(vmax / vmin) : (v - vmin) / (vmax - vmin);
  a0 = -0.75 * $pi;  a1 = 0.75 * $pi;  tv = a0 + t * (a1 - a0);
  j = 0;
  loop(21,
    b = a0 + j / 20 * (a1 - a0);  col(j % 5 == 0 ? C_INK : C_TEAL, j % 5 == 0 ? 0.95 : 0.6);
    gfx_line(x + sin(b) * (rr + ps(6)), y - cos(b) * (rr + ps(6)), x + sin(b) * (rr + ps(j % 5 == 0 ? 14 : 10)), y - cos(b) * (rr + ps(j % 5 == 0 ? 14 : 10)), 1);
    j += 1;
  );
  col(0x000000, 0.4);  gfx_circle(x + ps(3), y + ps(4), rr, 1, 1);
  col(0x141516, 1);  gfx_circle(x, y, rr, 1, 1);
  j = 0;  loop(36, b = j / 36 * 2 * $pi;  col(0x3A3C3E, 1);  gfx_line(x + sin(b) * rr * 0.86, y - cos(b) * rr * 0.86, x + sin(b) * rr * 0.98, y - cos(b) * rr * 0.98, 1);  j += 1; );
  col(0x2A2B2D, 1);  gfx_circle(x, y, rr * 0.8, 1, 1);
  col(0xFFFFFF, 0.08);  gfx_arc(x, y, rr * 0.74, -1.8, -0.1, 1);
  col(C_INK, 1);  pointer(x, y, sin(tv), cos(tv), rr * 0.1, rr * 0.92, ps(r > 30 ? 2.6 : 1.8));
  gfx_setfont(6);  col(C_INK, 1);  text_c(x, y + rr + ps(26), lbl);
  hov || drag_idx == idx ? hover_tag(x, y - rr - ps(22), fmtv(v, fmt));
);
function ui_rrs(x, y, w, h, r) local(i, d, ins) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = min(floor(r + 0.5), floor(min(w, h) * 0.5));
  i = 0;
  loop(r, d = r - i - 0.5; ins = floor(r - sqrt(max(r * r - d * d, 0)) + 0.5);
    gfx_rect(x + ins, y + i, w - 2 * ins, 1);  gfx_rect(x + ins, y + h - 1 - i, w - 2 * ins, 1);  i += 1; );
  gfx_rect(x, y + r, w, h - 2 * r);
);
function lk_rr(x, y, w, h, r) ( ui_rrs(px(x), py(y), ps(w), ps(h), ps(r)); );
function ui_keytext(cx, cy, str) local(w, h) ( gfx_measurestr(str, w, h); gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.58 + 0.5); gfx_drawstr(str); );
function lk_key(x, y, w, h, on, c, str) local(hov, hit, k, lens, dn, i, t, dx, dy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  dn = hov && lmb ? 1 : 0;
  k = min(w / 54, h / 40);
  lens = shade(ui_mix(c, 0xCFC9BC, 0.5), 0.76);
  on ? lens = c;
  on ? ( col(c, 0.10); lk_rr(x - 9 * k, y - 9 * k, w + 18 * k, h + 18 * k, 10 * k);  col(c, 0.18); lk_rr(x - 6 * k, y - 6 * k, w + 12 * k, h + 12 * k, 8 * k); );
  col(lk_well, 1);           lk_rr(x - 4 * k, y - 4 * k, w + 8 * k, h + 8 * k, 5 * k);
  col(shade(lens, 0.55), 1); lk_rr(x, y + 1 / sc, w, h, 4 * k);
  y += (dn - 1) / sc;
  on ? (
    col(lens, 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    i = 1;
    loop(4, t = 0.07 * i * (1 + 0.6 * max(1 - k, 0));
      dx = (i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 10 : 14) * k;  dy = (i == 1 ? 2 : i == 2 ? 4 : i == 3 ? 7 : 9) * k;
      col(ui_mix(c, 0xFFFFFF, t), 1); lk_rr(x + dx, y + dy, w - 2 * dx, h - 1 / sc - 2 * dy, 4 * k);  i += 1; );
  ) : (
    col(shade(lens, 0.62), 1); lk_rr(x, y, w, h - 1 / sc, 4 * k);
    col(shade(lens, 0.78), 1); lk_rr(x + 2 * k, y + 2 * k, w - 4 * k, h - 5 * k, 4 * k);
    col(shade(lens, 0.92), 1); lk_rr(x + 5 * k, y + 4 * k, w - 10 * k, h - 10 * k, 4 * k);
    col(lens, 1);              lk_rr(x + 9 * k, y + 7 * k, w - 18 * k, h - 17 * k, 4 * k);
  );
  col(0xFFFFFF, on ? 0.45 : 0.22);  gfx_rect(px(x + 4 * k), py(y), ps(w - 8 * k), max(1, ps(1.5)));
  hov && !dn ? ( col(0xFFFFFF, 0.07); lk_rr(x, y, w, h - 1 / sc, 4 * k); );
  gfx_setfont(2);  col(shade(c, on ? 0.30 : 0.17), 1);
  ui_keytext(px(x + w * 0.5), py(y + h * 0.5), str);
  hit;
);
function ck(x, y, w, h, sel, str) local(hov, hit, yy) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  hit = click && hov && !drag_idx;
  yy = sel ? y : y + 1.5;
  col(0x000000, 0.45);  u_rect(x + 1, yy + 1.5, w, h - 1.5);
  col(sel ? 0xF0E8D2 : 0xB3AE9F, 1);  u_rect(x, yy, w, h - 1.5);
  col(shade(sel ? 0xF0E8D2 : 0xB3AE9F, 0.72), 1);  u_rect(x, yy + h - 3.5, w, 2);  u_rect(x + w - 2, yy, 2, h - 1.5);
  hov ? ( col(0xFFFFFF, 0.1);  u_rect(x, yy, w, h - 1.5); );
  col(0xF2A41E, sel ? 0.35 : 0);  gfx_circle(px(x + w - 9), py(yy + 9), ps(5), 1, 1);
  col(sel ? 0xF2A41E : 0x6A5A40, 1);  gfx_circle(px(x + w - 9), py(yy + 9), ps(2.8), 1, 1);
  gfx_setfont(2);  col(sel ? 0x2A2A28 : 0x4A4840, 1);  text_c(px(x + w * 0.5 - 4), py(yy + h * 0.5), str);
  hit;
);
function lcd_box(x, y, w, h) ( col(0x1C1D1E, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);  col(0x020403, 1);  u_rect(x, y, w, h);  col(C_LCDBG, 1);  u_rect(x + 3, y + 3, w - 6, h - 6); );
function lcd(x, y, w, h, fnt, str) local(tw, th, gy) (
  lcd_box(x, y, w, h);
  gfx_setfont(fnt);  gfx_measurestr(str, tw, th);  gy = py(y + h * 0.5) - th * 0.5;
  col(C_LCDTX, 0.22);  gfx_x = px(x + 10) - 1;  gfx_y = gy;  gfx_drawstr(str);  gfx_x = px(x + 10) + 1;  gfx_y = gy;  gfx_drawstr(str);
  col(C_LCDTX, 1);  gfx_x = px(x + 10);  gfx_y = gy;  gfx_drawstr(str);
);
// a vertical LED meter (-48 .. 0 dB) with its name below
function vmeter(x, y, h, lv, name) local(db, j, d, n) (
  db = lv > 0.000001 ? 8.685889638065035 * log(lv) : -120;  n = 20;
  col(0x0A0B0B, 1);  u_rect(x, y, 22, h);
  j = 0;
  loop(n, d = -48 + (j + 1) * 48 / n;
    col(d > -1 ? 0xFF5A40 : d > -10 ? 0xF2C230 : C_TEAL, db >= d - 2.4 ? 1 : 0.12);
    u_rect(x + 3, y + h - 3 - (j + 1) * (h - 6) / n + 1, 16, (h - 6) / n - 1.5);  j += 1; );
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(x + 11), py(y + h + 14), name);
);
function pb_count(menu) local(k, n) ( n = 1;  k = 0;  loop(strlen(menu), str_getchar(menu, k) == 124 ? n += 1;  k += 1; );  n; );
function pb_item(menu, i, dst) local(k, k0, n, c, len) (
  strcpy(dst, "");  len = strlen(menu);  k = 0;  k0 = 0;  n = 1;
  loop(len + 1, c = k < len ? str_getchar(menu, k) : 124;  c == 124 ? ( n == i ? strcpy_substr(dst, menu, k0, k - k0);  n += 1;  k0 = k + 1; );  k += 1; );
  dst;
);
function pb_tri(cx, cy, s, dir) ( gfx_triangle(px(cx + dir * s), py(cy), px(cx - dir * s), py(cy - s), px(cx - dir * s), py(cy + s)); );
function preset_bar(x, y, h, lw, cur, menu) local(n, sel, open, lx, i) (
  n = pb_count(menu);  sel = 0;  open = 0;
  lk_key(x, y + 3, 92, h - 6, 0, 0xB8BCBC, "PRESETS") ? open = 1;
  lk_key(x + 102, y + 3, 38, h - 6, 0, 0xB8BCBC, "") ? ( sel = cur <= 1 || cur > n ? n : cur - 1; );
  lk_key(x + 150, y + 3, 38, h - 6, 0, 0xB8BCBC, "") ? ( sel = cur >= n || cur < 1 ? 1 : cur + 1; );
  col(0x1A1B1C, 1);  pb_tri(x + 121, y + h * 0.5, 5, -1);  pb_tri(x + 169, y + h * 0.5, 5, 1);
  lx = x + 202;
  cur >= 1 && cur <= n ? pb_item(menu, cur, #pb_nm) : strcpy(#pb_nm, "--");
  lcd(lx, y, lw, h, 8, #pb_nm);
  click && mouse_x >= px(lx) && mouse_x < px(lx + lw) && mouse_y >= py(y) && mouse_y < py(y + h) ? open = 1;
  open ? (
    strcpy(#pb_m, "");  i = 1;
    loop(n, i == cur ? strcat(#pb_m, "!");  strcat(#pb_m, pb_item(menu, i, #pb_t));  i < n ? strcat(#pb_m, "|");  i += 1; );
    gfx_x = px(x);  gfx_y = py(y + h);  i = gfx_showmenu(#pb_m);  i > 0 ? sel = i;
  );
  sel;
);
// a status LED (lit by lv 0 - 1) in a black ring
function sled(x, y, r, c, lv) ( col(0x050606, 1);  gfx_circle(px(x), py(y), ps(r + 2), 1, 1);  col(ui_mix(shade(c, 0.3), c, min(1, lv)), 1);  gfx_circle(px(x), py(y), ps(r), 1, 1);
  lv > 0.05 ? ( col(c, 0.25 * min(1, lv));  gfx_circle(px(x), py(y), ps(r * 2.2), 1, 1); ); );
// a KEY + LED: a small square key, its own green LED beside it
function kled(x, y, w, h, on, str) local(hov, hit) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);  hit = click && hov && !drag_idx;
  col(0x000000, 0.35);  u_rect(x + 1, y + 3, w + 2, h + 2);  col(0x050606, 1);  u_rect(x - 2, y - 2, w + 4, h + 4);
  col(on ? 0xE8E2CC : 0xA8A390, 1);  u_rect(x, y, w, h);  col(0xFFFFFF, 0.3);  u_rect(x, y, w, 2);  col(0x000000, 0.12);  u_rect(x, y + h - 4, w, 4);  u_rect(x + w - 3, y, 3, h);
  hov ? ( col(0xFFFFFF, 0.08);  u_rect(x, y, w, h); );
  gfx_setfont(2);  col(0x1E1E1C, 1);  text_c(px(x + w * 0.5), py(y + h * 0.5), str);
  sled(x + w + 16, y + h * 0.5, 5, 0x7CE05A, on);
  hit;
);
// a dark DISPLAY BOX (a choice from a menu), light text; returns 1 when clicked
function dbox(x, y, w, h, str) local(hov) (
  hov = mouse_x >= px(x) && mouse_x < px(x + w) && mouse_y >= py(y) && mouse_y < py(y + h);
  col(0x000000, 0.45);  u_rect(x - 1, y - 1, w + 2, h + 2);  col(C_LCDBG, 1);  u_rect(x, y, w, h);  col(0xFFFFFF, hov ? 0.12 : 0.06);  u_rect(x, y + h - 1, w, 1);
  gfx_setfont(2);  col(C_LCDTX, 1);  text_c(px(x + w * 0.5), py(y + h * 0.5), str);
  click && hov && !drag_idx;
);
function nname(n) local(o, k) ( n = floor(n + 0.5);  o = floor(n / 12) - 1;  k = n % 12;
  sprintf(#nn, "%s%d", k == 0 ? "C" : k == 1 ? "C#" : k == 2 ? "D" : k == 3 ? "D#" : k == 4 ? "E" : k == 5 ? "F" : k == 6 ? "F#" : k == 7 ? "G" : k == 8 ? "G#" : k == 9 ? "A" : k == 10 ? "A#" : "B", o);  #nn; );
function pv(i, v) ( slider(i) = v; );
// the groups' colours (the key, its lamp and its layer) and names
function gcol(g) ( g == 0 ? 0x4A86E8 : g == 1 ? 0x46C37B : g == 2 ? 0xF0902E : g == 3 ? 0xE0589C : 0xFFB040; );
function gname(g) ( g == 0 ? "BASS" : g == 1 ? "TENOR" : g == 2 ? "ALTO" : "SOPRANO"; );
// a section inside a layer: a recessed panel in a shade of the layer's colour, its title in the colour
function lsec(x, y, w, h, c, f, title) (
  col(0x000000, 0.3);  u_rect(x + 2, y + 3, w, h);
  col(ui_mix(0x2B2C2F, c, f), 1);  u_rect(x, y, w, h);
  col(0x000000, 0.25);  u_rect(x, y, w, 2);  u_rect(x, y, 2, h);
  col(0xFFFFFF, 0.06);  u_rect(x, y + h - 1, w, 1);  u_rect(x + w - 1, y, 1, h);
  gfx_setfont(4);  col(ui_mix(c, 0xFFFFFF, 0.25), 1);  text_l(px(x + 16), py(y + 20), title);
  col(c, 0.7);  u_rect(x + 16, y + 36, w - 32, 2);
);
// an envelope's shape (attack, decay, sustain, release) in a small display, in the layer's colour
function env_pic(x, y, w, h, a, d, su, r, c) local(ta, td, tr, ts_, tt, i, xx, e, t, lx, ly, yy) (
  lcd_box(x, y, w, h);
  ta = 0.04 + 0.96 * log(a / 0.002) / log(4000);  td = 0.04 + 0.96 * log(d / 0.01) / log(1000);  tr = 0.04 + 0.96 * log(r / 0.02) / log(600);
  ts_ = 0.7;  tt = ta + td + ts_ + tr;
  i = 0;  lx = -1;
  loop(w - 16,
    xx = x + 8 + i;  t = i / (w - 16) * tt;
    e = t < ta ? t / ta : t < ta + td ? 1 - (1 - su) * (1 - exp(-4.6 * (t - ta) / td)) / 0.99 : t < ta + td + ts_ ? su : su * exp(-6.9 * (t - ta - td - ts_) / tr);
    yy = y + h - 8 - e * (h - 16);
    col(c, 0.16);  u_rect(xx, yy, 1, y + h - 8 - yy);
    col(ui_mix(c, 0xFFFFFF, 0.3), 1);  lx >= 0 ? ( gfx_line(px(lx), py(ly), px(xx), py(yy), 1);  gfx_line(px(lx), py(ly) + 1, px(xx), py(yy) + 1, 1); );
    lx = xx;  ly = yy;  i += 1;
  );
);
function lfo_name(k) ( k == 0 ? "4 bars" : k == 1 ? "2 bars" : k == 2 ? "1 bar" : k == 3 ? "1/2" : k == 4 ? "1/2 D" : k == 5 ? "1/2 T" : k == 6 ? "1/4" : k == 7 ? "1/4 D" :
  k == 8 ? "1/4 T" : k == 9 ? "1/8" : k == 10 ? "1/8 D" : k == 11 ? "1/8 T" : k == 12 ? "1/16" : k == 13 ? "1/16 D" : k == 14 ? "1/16 T" : "1/32"; );
function sdiv_name(k) ( k == 0 ? "1/4" : k == 1 ? "1/8" : k == 2 ? "1/8 T" : k == 3 ? "1/16" : k == 4 ? "1/16 T" : "1/32"; );
function sp_put(g, st, lv, ac) ( SP[g * 32 + st] = floor(max(0, min(1, lv)) * 100 + 0.5) + (ac ? 128 : 0); );
// a group's pattern as one hex digit per step (0 = silent .. F = full) and an accent string (1 = accent); shorter
// strings repeat to fill all 32 steps (Oontecho's preset format)
function sp_pat(g, lv, ac) local(i, c, d, n, m) (
  n = strlen(lv);  m = strlen(ac);  i = 0;
  loop(32, c = str_getchar(lv, i % n);  d = c >= 65 ? c - 55 : c - 48;  d = min(max(d, 0), 15);
    SP[g * 32 + i] = floor(d / 15 * 100 + 0.5) + (str_getchar(ac, i % m) == 49 ? 128 : 0);  i += 1; );
);
function sp_lev(g, st) local(v) ( v = SP[g * 32 + st];  max(0, min(1, (v - 128 * (v > 127.5)) / 100)); );
function sp_acc(g, st) ( SP[g * 32 + st] > 127.5; );
// a title lamp (cream ring, the colour lit) - returns 1 when clicked
function tlamp(x, y, c, on) (
  col(0x0A0B0B, 1);  gfx_circle(px(x), py(y), ps(10), 1, 1);
  col(0xEDE6D2, 1);  gfx_circle(px(x), py(y), ps(8), 1, 1);
  col(on ? c : shade(c, 0.35), 1);  gfx_circle(px(x), py(y), ps(5.5), 1, 1);
  on ? ( col(c, 0.25);  gfx_circle(px(x), py(y), ps(14), 1, 1); );
  click && !drag_idx && sqr(mouse_x - px(x)) + sqr(mouse_y - py(y)) < sqr(ps(13));
);
// the STEP SEQUENCER section of a layer: its lamp, STEPS, SIZE, rotate / RND / FILL, the grid, its six knobs
function step_sec(g, c, o) local(n, on, j, x, gx, gw, by, bh, ay, ah, pt, bw, l, a, h, mx, my, si, cur, grp, spb, d, k, tw, th) (
  lsec(48, 558, 1104, 266, c, 0.12, "");
  on = slider(o) >= 0.5;
  tlamp(68, 578, c, on) ? ( slider(o) = on ? 0 : 1;  param_touched(o); );
  gfx_setfont(4);  col(ui_mix(c, 0xFFFFFF, 0.25), 1);  text_l(px(88), py(578), "STEP SEQUENCER");
  // STEPS and SIZE (menus), rotate, RND, FILL
  j = floor(slider(o + 1) + 0.5);  n = j == 0 ? 8 : j == 1 ? 12 : j == 2 ? 16 : j == 3 ? 24 : 32;
  dbox(300, 563, 104, 30, sprintf(#sn, "%d STEPS", n)) ? (
    gfx_x = px(300);  gfx_y = py(595);
    k = gfx_showmenu(sprintf(#smn, "%s8 steps|%s12 steps|%s16 steps|%s24 steps|%s32 steps", j == 0 ? "!" : "", j == 1 ? "!" : "", j == 2 ? "!" : "", j == 3 ? "!" : "", j == 4 ? "!" : ""));
    k > 0 ? ( slider(o + 1) = k - 1;  param_touched(o + 1); ); );
  j = floor(slider(o + 2) + 0.5);
  dbox(414, 563, 84, 30, sdiv_name(j)) ? (
    gfx_x = px(414);  gfx_y = py(595);
    strcpy(#sdm, "");  k = 0;  loop(6, k == j ? strcat(#sdm, "!");  strcat(#sdm, sdiv_name(k));  k < 5 ? strcat(#sdm, "|");  k += 1; );
    k = gfx_showmenu(#sdm);  k > 0 ? ( slider(o + 2) = k - 1;  param_touched(o + 2); ); );
  lk_key(514, 564, 34, 28, 0, 0xB8BCBC, "") ? ( k = SP[g * 32];  j = 0;  loop(n - 1, SP[g * 32 + j] = SP[g * 32 + j + 1];  j += 1; );  SP[g * 32 + n - 1] = k; );
  lk_key(554, 564, 34, 28, 0, 0xB8BCBC, "") ? ( k = SP[g * 32 + n - 1];  j = n - 1;  loop(n - 1, SP[g * 32 + j] = SP[g * 32 + j - 1];  j -= 1; );  SP[g * 32] = k; );
  col(0x1A1B1C, 1);  pb_tri(531, 578, 5, -1);  pb_tri(571, 578, 5, 1);
  lk_key(600, 564, 64, 28, 0, c, "RND") ? (
    j = 0;  loop(32, l = rand(1);  l = j % 4 == 0 ? 1 : l < 0.38 ? 0 : l < 0.55 ? 0.5 : l < 0.7 ? 0.75 : 1;  sp_put(g, j, l, l > 0.7 && rand(1) < 0.25);  j += 1; ); );
  lk_key(676, 564, 64, 28, 0, c, "FILL") ? ( j = 0;  loop(32, sp_put(g, j, 1, 0);  j += 1; ); );
  // the grid: a bar per step (its level) and the accent row; the playing step lit
  gx = 64;  gw = 680;  by = 612;  bh = 142;  ay = 764;  ah = 24;
  pt = gw / n;  bw = pt - (n > 16 ? 3 : 5);
  spb = floor(1 / (j = floor(slider(o + 2) + 0.5); j == 0 ? 1 : j == 1 ? 0.5 : j == 2 ? 1 / 3 : j == 3 ? 0.25 : j == 4 ? 1 / 6 : 0.125) + 0.5);  grp = spb == 1 ? 4 : spb;
  cur = SQ[g * SQS + 1];
  col(0x050606, 1);  u_rect(gx - 4, by - 4, gw + 4, bh + 8);
  j = 0;
  loop(n,
    x = gx + j * pt;  l = sp_lev(g, j);  a = sp_acc(g, j);
    col(floor(j / grp) % 2 ? ui_mix(0x15161A, c, 0.10) : ui_mix(0x101114, c, 0.06), 1);  u_rect(x, by, bw, bh);
    h = l * bh;
    h > 0.5 ? (
      col(a ? ui_mix(c, 0xFFFFFF, 0.35) : c, on ? 0.95 : 0.5);  u_rect(x, by + bh - h, bw, h);
      col(0xFFFFFF, 0.35);  u_rect(x, by + bh - h, bw, 2);
    );
    a ? ( col(0xFFC24A, on ? 1 : 0.55);  u_rect(x + 1, ay + 1, bw - 2, ah - 2);  col(0x2A1A05, 1);  gfx_circle(px(x + bw * 0.5), py(ay + ah * 0.5), ps(3.5), 1, 1); )
      : ( col(0x0C0D10, 1);  u_rect(x, ay, bw, ah);  col(0xFFC24A, 0.3);  gfx_rect(px(x), py(ay), ps(bw), ps(ah), 0); );
    on && j == cur ? ( col(0xFFFFFF, 0.14);  u_rect(x, by, bw, bh);  col(0xFFFFFF, 0.9);  u_rect(x, by + bh + 2, bw, 2); );
    j += 1;
  );
  // drawing: drag across the bars to set levels (right-drag erases); click / drag the accent row to set accents
  mx = (mouse_x - ox) / sc;  my = (mouse_y - oy) / sc;
  si = min(max(floor((mx - gx) / pt), 0), n - 1);
  (click || ((mouse_cap & 2) && !last_rmb)) && !drag_idx && mx >= gx && mx < gx + gw && my >= by - 6 && my < by + bh + 6 ? ( st_drag = (mouse_cap & 2) ? 3 : 1;  st_pi = -1; );
  click && !drag_idx && mx >= gx && mx < gx + gw && my >= ay - 2 && my < ay + ah + 2 ? ( st_drag = 2;  st_ap = !sp_acc(g, si); );
  st_drag == 1 || st_drag == 3 ? (
    l = st_drag == 3 ? 0 : min(max((by + bh - my) / bh, 0), 1);
    st_pi >= 0 && st_pi != si ? ( d = si > st_pi ? 1 : -1;  k = st_pi + d;
      while (k != si) ( sp_put(g, k, st_pl + (l - st_pl) * (k - st_pi) / (si - st_pi), sp_acc(g, k));  k += d; ); );
    sp_put(g, si, l, sp_acc(g, si));  st_pi = si;  st_pl = l;
  );
  st_drag == 2 ? sp_put(g, si, sp_lev(g, si), st_ap);
  !(mouse_cap & 3) ? st_drag = 0;
  // the step's level while the mouse is over the grid
  mx >= gx && mx < gx + gw && my >= by && my < by + bh ? (
    gfx_setfont(5);  sprintf(#sv, "%d", floor(sp_lev(g, si) * 100 + 0.5));  gfx_measurestr(#sv, tw, th);
    col(C_LCDBG, 0.95);  gfx_rect(px(gx + si * pt + bw * 0.5) - tw * 0.5 - ps(5), py(by + 6), tw + ps(10), th + ps(4), 1);
    col(C_LCDTX, 1);  text_c(px(gx + si * pt + bw * 0.5), py(by + 6) + th * 0.5 + ps(2), #sv);
  );
  // the knobs: DEPTH GLIDE ACCENT / SWING PAN FILTER
  col(c, 0.35);  u_rect(772, 606, 1, 204);
  kn(836, 642, 20, o + 3, 0, 100, 100, "DEPTH", 1);
  kn(956, 642, 20, o + 4, 0, 100, 15, "GLIDE", 1);
  kn(1076, 642, 20, o + 5, 0, 100, 50, "ACCENT", 1);
  kn(836, 758, 20, o + 6, 0, 50, 0, "SWING", 1);
  kn(956, 758, 20, o + 7, -100, 100, 0, "PAN", 1);
  kn(1076, 758, 20, o + 8, -5, 5, 0, "FILTER", 10);
  gfx_setfont(5);  col(C_INK, 0.9);  text_c(px(956), py(758 - 20 - 20), "0");  text_c(px(1076), py(758 - 20 - 20), "0");
  !on ? ( col(ui_mix(0x2B2C2F, c, 0.12), 0.5);  u_rect(56, 600, 1088, 216); );       // off: greyed (the lamp stays bright)
);
// the layer tabs (the four groups and the HORN) and CLOSE
function lay_tabs(g) local(j) (
  j = 0;
  loop(5, lk_key(452 + j * 108, 104, 96, 30, j == g, gcol(j), j == 4 ? "HORN" : gname(j)) ? ( ui_lay = j + 1;  ui_last = j + 1; );  j += 1; );
  lk_key(1012, 104, 140, 30, 0, 0xB8BCBC, "CLOSE") ? ui_lay = 0;
);
// the pitch of a horn note in a small display: the DROP falling into the note, the WOBBLE on it
function pitch_pic(x, y, w, h, c) local(i, t, e, yy, lx, ly, xx, spn, mid) (
  lcd_box(x, y, w, h);
  spn = max(h_dropt * 1.6, 2);  mid = y + h * 0.62;
  col(c, 0.25);  u_rect(x + 8, mid, w - 16, 1);
  i = 0;  lx = -1;
  loop(w - 16,
    xx = x + 8 + i;  t = i / (w - 16) * spn;
    e = h_drop * exp(-4.6 * t / h_dropt) + h_wdep / 100 * sin(2 * $pi * h_wrate * t);
    yy = mid - e / max(1, max(h_drop, h_wdep / 100 * 3)) * (h * 0.5);  yy = max(y + 6, min(y + h - 6, yy));
    col(ui_mix(c, 0xFFFFFF, 0.3), 1);  lx >= 0 ? ( gfx_line(px(lx), py(ly), px(xx), py(yy), 1);  gfx_line(px(lx), py(ly) + 1, px(xx), py(yy) + 1, 1); );
    lx = xx;  ly = yy;  i += 1;
  );
  gfx_setfont(5);  col(C_LCDTX, 0.6);  text_l(px(x + 12), py(y + 14), "PITCH");
);
// the FOG HORN's layer (amber): SWELL / RELEASE, its FILTER ENVELOPE, TONE, BODY, PITCH
function draw_hlayer() local(c, m, j) (
  c = gcol(4);
  col(0x000000, 0.4);  u_rect(26, 93, 1152, 742);
  col(ui_mix(0x2A2B2E, c, 0.14), 1);  u_rect(24, 90, 1152, 742);
  col(c, 1);  u_rect(24, 90, 1152, 4);
  tlamp(52, 118, c, h_on >= 0.5) ? ( slider(151) = h_on >= 0.5 ? 0 : 1;  param_touched(151); );
  gfx_setfont(1);  col(c, 1);  text_l(px(74), py(118), "FOG HORN");
  lay_tabs(4);
  // AMP: SWELL and RELEASE (the drone and the horns played from the keys)
  lsec(48, 150, 376, 228, c, 0.10, "AMP ENVELOPE");
  env_pic(64, 196, 344, 58, fog_att, 0.01, 1, fog_rel, c);
  klog = 1;  kn(150, 306, 26, 18, 0.05, 6, 1.2, "SWELL", 8);
  klog = 1;  kn(322, 306, 26, 19, 0.1, 10, 2.5, "RELEASE", 8);
  // FILTER ENVELOPE (it starts with the swell)
  lsec(436, 150, 376, 228, c, 0.16, "FILTER ENVELOPE");
  env_pic(452, 196, 344, 58, h_fatt, h_fdec, h_fsus / 100, h_frel, c);
  klog = 1;  kn(484, 306, 24, 147, 0.002, 8, 0.5, "ATTACK", 8);
  klog = 1;  kn(572, 306, 24, 148, 0.01, 10, 1.5, "DECAY", 8);
  kn(660, 306, 24, 149, 0, 100, 50, "SUSTAIN", 1);
  klog = 1;  kn(748, 306, 24, 150, 0.02, 12, 2, "RELEASE", 8);
  // TUNE (the drone's pitch and the beat between its two tones)
  lsec(824, 150, 328, 228, c, 0.28, "TUNE");
  klog = 1;  kn(904, 290, 32, 3, 30, 150, 50, "FOG TUNE", 2);
  kn(1072, 290, 32, 4, 0, 50, 15, "DETUNE", 5);
  // TONE: the low-pass, its RESONANCE and how far the envelope moves it
  lsec(48, 390, 540, 156, c, 0.22, "TONE");
  klog = 1;  kn(150, 482, 26, 21, 60, 8000, 420, "TONE", 9);
  kn(300, 482, 24, 22, 0, 100, 0, "RESONANCE", 1);
  kn(450, 482, 24, 23, -100, 100, 0, "ENV AMOUNT", 1);
  gfx_setfont(5);  col(C_INK, 0.9);  text_c(px(450), py(482 - 24 - 22), "0");
  // BODY: the reed pair, the sub, the octave, the drive
  lsec(600, 390, 552, 156, c, 0.22, "BODY");
  kn(680, 482, 24, 24, 0, 100, 100, "REED", 1);
  kn(800, 482, 24, 25, 0, 100, 100, "SUB", 1);
  kn(920, 482, 24, 142, 0, 100, 0, "DRIVE", 1);
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1060), py(452), "OCTAVE");
  m = floor(h_oct + 0.5);
  dbox(1006, 468, 110, 34, m == 0 ? "0" : sprintf(#hoc, "%+d", m)) ? (
    gfx_x = px(1006);  gfx_y = py(504);
    j = gfx_showmenu(sprintf(#hom, "%s+1 octave|%s0|%s-1 octave|%s-2 octaves", m == 1 ? "!" : "", m == 0 ? "!" : "", m == -1 ? "!" : "", m == -2 ? "!" : ""));
    j > 0 ? ( slider(141) = 2 - j;  param_touched(141); ); );
  // PITCH: the DROP into the note, the WOBBLE
  lsec(48, 558, 1104, 266, c, 0.12, "PITCH");
  pitch_pic(64, 610, 480, 190, c);
  kn(640, 704, 30, 143, 0, 12, 0, "DROP", 3);
  klog = 1;  kn(770, 704, 30, 144, 0.05, 4, 0.6, "DROP TIME", 8);
  klog = 1;  kn(900, 704, 30, 145, 0.05, 8, 0.3, "WOBBLE RATE", 7);
  kn(1050, 704, 30, 146, 0, 100, 0, "WOBBLE DEPTH", 5);
);
// a layer: one group's own controls (AMP ENVELOPE, FILTER ENVELOPE, FILTER, GROUP), drawn in its colour
function draw_layer(g) local(c, i, j, m, o, tw, th) (
  c = gcol(g);  i = 33 + g * 16;
  col(0x000000, 0.4);  u_rect(26, 93, 1152, 742);
  col(ui_mix(0x2A2B2E, c, 0.14), 1);  u_rect(24, 90, 1152, 742);
  col(c, 1);  u_rect(24, 90, 1152, 4);
  // the title lamp (lit = singing; click it to switch the group on or off), the group's name, the tabs, CLOSE
  o = slider(i) >= 0.5;
  col(0x0A0B0B, 1);  gfx_circle(px(52), py(118), ps(11), 1, 1);
  col(0xEDE6D2, 1);  gfx_circle(px(52), py(118), ps(9), 1, 1);
  col(o ? c : shade(c, 0.35), 1);  gfx_circle(px(52), py(118), ps(6), 1, 1);
  o ? ( col(c, 0.25);  gfx_circle(px(52), py(118), ps(15), 1, 1); );
  click && sqr(mouse_x - px(52)) + sqr(mouse_y - py(118)) < sqr(ps(13)) ? ( slider(i) = o ? 0 : 1;  param_touched(i); );
  gfx_setfont(1);  col(c, 1);  text_l(px(74), py(118), gname(g));
  gfx_measurestr(gname(g), tw, th);
  gfx_setfont(5);  col(C_INK2, 1);  text_l(px(74) + tw + ps(14), py(122), o ? "SINGING" : "OFF");
  lay_tabs(g);
  // AMP ENVELOPE
  lsec(48, 150, 376, 228, c, 0.10, "AMP ENVELOPE");
  env_pic(64, 196, 344, 58, slider(i + 3), slider(i + 4), slider(i + 5) / 100, slider(i + 6), c);
  klog = 1;  kn(96, 306, 24, i + 3, 0.002, 8, 0.03, "ATTACK", 8);
  klog = 1;  kn(184, 306, 24, i + 4, 0.01, 10, 0.3, "DECAY", 8);
  kn(272, 306, 24, i + 5, 0, 100, 100, "SUSTAIN", 1);
  klog = 1;  kn(360, 306, 24, i + 6, 0.02, 12, 0.35, "RELEASE", 8);
  // FILTER ENVELOPE
  lsec(436, 150, 376, 228, c, 0.16, "FILTER ENVELOPE");
  env_pic(452, 196, 344, 58, slider(i + 12), slider(i + 13), slider(i + 14) / 100, slider(i + 15), c);
  klog = 1;  kn(484, 306, 24, i + 12, 0.002, 8, 0.01, "ATTACK", 8);
  klog = 1;  kn(572, 306, 24, i + 13, 0.01, 10, 0.5, "DECAY", 8);
  kn(660, 306, 24, i + 14, 0, 100, 50, "SUSTAIN", 1);
  klog = 1;  kn(748, 306, 24, i + 15, 0.02, 12, 0.5, "RELEASE", 8);
  // GROUP: its level and octave
  lsec(824, 150, 328, 228, c, 0.28, "GROUP");
  kn(904, 284, 34, i + 1, -24, 6, 0, "LEVEL", 4);
  gfx_setfont(5);  col(C_INK, 0.9);  text_c(px(904), py(284 - 34 - 24), "0");
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1066), py(252), "OCTAVE");
  m = floor(slider(i + 2) + 0.5);
  dbox(1006, 268, 120, 34, m == 0 ? "0" : sprintf(#oc, "%+d", m)) ? (
    gfx_x = px(1006);  gfx_y = py(304);
    j = gfx_showmenu(sprintf(#om, "%s+2 octaves|%s+1 octave|%s0 (as played)|%s-1 octave|%s-2 octaves", m == 2 ? "!" : "", m == 1 ? "!" : "", m == 0 ? "!" : "", m == -1 ? "!" : "", m == -2 ? "!" : ""));
    j > 0 ? ( slider(i + 2) = 3 - j;  param_touched(i + 2); ); );
  // FILTER (and the LFO that sweeps it)
  lsec(48, 390, 1104, 156, c, 0.22, "FILTER");
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(132), py(452), "MODE");
  m = floor(slider(i + 7) + 0.5);
  dbox(72, 468, 120, 34, m == 0 ? "LP 12" : m == 1 ? "LP 24" : m == 2 ? "BP" : "HP") ? (
    gfx_x = px(72);  gfx_y = py(504);
    j = gfx_showmenu(sprintf(#fm, "%sLow-pass 12 dB|%sLow-pass 24 dB|%sBand-pass|%sHigh-pass", m == 0 ? "!" : "", m == 1 ? "!" : "", m == 2 ? "!" : "", m == 3 ? "!" : ""));
    j > 0 ? ( slider(i + 7) = j - 1;  param_touched(i + 7); ); );
  klog = 1;  kn(290, 482, 26, i + 8, 40, 20000, 20000, "CUTOFF", 9);
  kn(410, 482, 24, i + 9, 0, 100, 0, "RESONANCE", 1);
  kn(530, 482, 24, i + 10, -100, 100, 0, "ENV AMOUNT", 1);
  gfx_setfont(5);  col(C_INK, 0.9);  text_c(px(530), py(482 - 24 - 22), "0");
  kn(650, 482, 24, i + 11, 0, 100, 0, "KEY TRACK", 1);
  col(c, 0.35);  u_rect(752, 432, 1, 100);
  o = 97 + g * 11;
  kn(840, 482, 24, o + 9, -4, 4, 0, "LFO", 10);
  gfx_setfont(5);  col(C_INK, 0.9);  text_c(px(840), py(482 - 24 - 22), "0");
  gfx_setfont(5);  col(C_INK2, 1);  text_c(px(1010), py(452), "LFO RATE");
  m = floor(slider(o + 10) + 0.5);
  dbox(950, 468, 120, 34, lfo_name(m)) ? (
    gfx_x = px(950);  gfx_y = py(504);
    strcpy(#lm, "");  j = 0;  loop(16, j == m ? strcat(#lm, "!");  strcat(#lm, lfo_name(j));  j < 15 ? strcat(#lm, "|");  j += 1; );
    j = gfx_showmenu(#lm);  j > 0 ? ( slider(o + 10) = j - 1;  param_touched(o + 10); ); );
  // STEP SEQUENCER (Oontecho's): the steps move the gate, the pan and the filter
  step_sec(g, c, o);

);
// the defaults (RUN is left as it is: a preset never starts or stops the pattern)
function p_init() (
  sp_pat(0, "F0A6", "10");  sp_pat(1, "F0A6", "10");  sp_pat(2, "F0A6", "10");  sp_pat(3, "F0A6", "10");   // the first patterns
  pv(1, 0); pv(2, 60); pv(3, 50); pv(4, 15); pv(5, 6); pv(6, 90); pv(7, 0); pv(8, 50); pv(10, 0); pv(11, 0); pv(12, 0.6);
  pv(13, 1); pv(14, 3); pv(15, 9); pv(16, 40); pv(17, 35); pv(18, 1.2); pv(19, 2.5); pv(20, 50); 
  pv(33, 1); pv(34, 0); pv(35, 0); pv(36, 0.03); pv(37, 0.3); pv(38, 100); pv(39, 0.35); pv(40, 0); pv(41, 20000); pv(42, 0); pv(43, 0); pv(44, 0); pv(45, 0.01); pv(46, 0.5); pv(47, 50); pv(48, 0.5);
  pv(49, 0); pv(50, 0); pv(51, 0); pv(52, 0.03); pv(53, 0.3); pv(54, 100); pv(55, 0.35); pv(56, 0); pv(57, 20000); pv(58, 0); pv(59, 0); pv(60, 0); pv(61, 0.01); pv(62, 0.5); pv(63, 50); pv(64, 0.5);
  pv(65, 0); pv(66, 0); pv(67, 0); pv(68, 0.03); pv(69, 0.3); pv(70, 100); pv(71, 0.35); pv(72, 0); pv(73, 20000); pv(74, 0); pv(75, 0); pv(76, 0); pv(77, 0.01); pv(78, 0.5); pv(79, 50); pv(80, 0.5);
  pv(81, 0); pv(82, 0); pv(83, 0); pv(84, 0.03); pv(85, 0.3); pv(86, 100); pv(87, 0.35); pv(88, 0); pv(89, 20000); pv(90, 0); pv(91, 0); pv(92, 0); pv(93, 0.01); pv(94, 0.5); pv(95, 50); pv(96, 0.5);
  pv(21, 420); pv(22, 0); pv(23, 0); pv(24, 100); pv(25, 100);
  pv(141, 0); pv(142, 0); pv(143, 0); pv(144, 0.6); pv(145, 0.3); pv(146, 0); pv(147, 0.5); pv(148, 1.5); pv(149, 50); pv(150, 2); pv(151, 1);
  pv(26, 0); pv(27, 48); pv(28, 1); pv(29, 0); pv(30, 0); pv(31, 4); pv(32, 0);
  pv(97, 0); pv(98, 2); pv(99, 3); pv(100, 100); pv(101, 15); pv(102, 50); pv(103, 0); pv(104, 0); pv(105, 0); pv(106, 0); pv(107, 2);
  pv(108, 0); pv(109, 2); pv(110, 3); pv(111, 100); pv(112, 15); pv(113, 50); pv(114, 0); pv(115, 0); pv(116, 0); pv(117, 0); pv(118, 2);
  pv(119, 0); pv(120, 2); pv(121, 3); pv(122, 100); pv(123, 15); pv(124, 50); pv(125, 0); pv(126, 0); pv(127, 0); pv(128, 0); pv(129, 2);
  pv(130, 0); pv(131, 2); pv(132, 3); pv(133, 100); pv(134, 15); pv(135, 50); pv(136, 0); pv(137, 0); pv(138, 0); pv(139, 0); pv(140, 2);
);
// PRESETS (level-matched: OUTPUT LEVEL trims each to the same loudness)
function load_preset(p) local(i) (
  p_init();
  p == 2 ? ( // HEPTAPOD CALL
    pv(1, -5); pv(2, 75); pv(3, 45); pv(4, 12); pv(6, 95); pv(7, 1.9); pv(8, 55); pv(12, 0.9); pv(15, 12); pv(16, 45); pv(17, 55); pv(30, 1); pv(31, 4); pv(36, 0.4); pv(37, 1); pv(38, 85); pv(39, 2.5);
  );
  p == 3 ? ( // LOW ATMOSPHERIC FOG
    pv(1, -8); pv(2, 46); pv(3, 38); pv(4, 22); pv(6, 100); pv(7, 6); pv(12, 1.6); pv(15, 16); pv(16, 50); pv(17, 20); pv(18, 3); pv(19, 6); pv(26, 1); pv(27, 48); pv(28, 1); pv(29, 0); pv(30, 1); pv(31, 4); pv(36, 1.5); pv(37, 2); pv(38, 80); pv(39, 4);
  );
  p == 4 ? ( // CHOPPY STACCATO SPEECH
    pv(2, 85); pv(3, 55); pv(5, 1); pv(6, 60); pv(7, 5.1); pv(10, 0); pv(11, 1); pv(12, 0.3); pv(15, 3); pv(16, 22); pv(17, 25); pv(33, 0); pv(49, 1); pv(52, 0.005); pv(53, 0.15); pv(54, 70); pv(55, 0.12);
  );
  p == 5 ? ( // ALIEN PULSE
    pv(1, 4); pv(2, 70); pv(3, 60); pv(4, 8); pv(5, 3); pv(6, 80); pv(7, 4.1); pv(10, 1); pv(11, 1); pv(15, 6); pv(16, 35); pv(17, 15); pv(33, 0); pv(65, 1); pv(68, 0.01); pv(69, 0.25); pv(70, 60); pv(71, 0.2);
  );
  p == 6 ? ( // MASSIVE DRONE NODE
    pv(1, -10); pv(2, 45); pv(3, 33); pv(4, 30); pv(6, 100); pv(7, 4); pv(8, 65); pv(12, 2.5); pv(15, 18); pv(16, 55); pv(17, 70); pv(18, 4); pv(19, 8); pv(26, 1); pv(27, 48); pv(28, 1); pv(29, 0); pv(30, 1); pv(31, 4); pv(33, 0); pv(49, 1); pv(52, 2.5); pv(53, 3); pv(54, 90); pv(55, 6);
  );
  p == 7 ? ( // RHYTHMIC GLYPHS
    pv(1, -2); pv(2, 70); pv(5, 3); pv(6, 85); pv(7, 0.4); pv(10, 0); pv(15, 8); pv(16, 38); pv(33, 0); pv(49, 1); pv(52, 0.02); pv(53, 0.4); pv(54, 70); pv(55, 0.3);
  );
  p == 8 ? ( // LINGUISTIC TENSION
    pv(1, 2); pv(2, 80); pv(3, 70); pv(4, 35); pv(5, 2); pv(6, 90); pv(7, 1.3); pv(8, 70); pv(10, 3); pv(12, 0.45); pv(15, 10); pv(16, 40); pv(17, 10); pv(30, 1); pv(31, 2); pv(33, 0); pv(65, 1); pv(68, 0.15); pv(69, 0.8); pv(70, 75); pv(71, 1.2);
  );
  p == 9 ? ( // DEEP SPACE RUMBLE
    pv(1, -12); pv(2, 32); pv(3, 30); pv(4, 40); pv(6, 100); pv(7, 5.7); pv(15, 20); pv(16, 60); pv(17, 80); pv(18, 5); pv(19, 9); pv(26, 1); pv(27, 43); pv(28, 1); pv(29, 0); pv(30, 1); pv(31, 2); pv(36, 3); pv(37, 4); pv(38, 70); pv(39, 8);
  );
  p == 10 ? ( // VOCAL STUTTER
    pv(1, 3); pv(2, 85); pv(5, 1); pv(6, 70); pv(7, 4.1); pv(10, 3); pv(11, 1); pv(12, 0.25); pv(15, 5); pv(16, 30); pv(17, 0); pv(33, 0); pv(81, 1); pv(84, 0.004); pv(85, 0.12); pv(86, 60); pv(87, 0.1);
  );
  p == 11 ? ( // MINIMALIST SEQUENCE
    pv(2, 75); pv(5, 3); pv(6, 90); pv(7, 2.2); pv(10, 4); pv(15, 9); pv(16, 42); pv(17, 5); pv(33, 0); pv(81, 1); pv(84, 0.05); pv(85, 0.5); pv(86, 50); pv(87, 0.6);
  );
  p == 12 ? ( // DARK HORIZON
    pv(1, -6); pv(2, 55); pv(3, 40); pv(4, 18); pv(6, 100); pv(7, 0.4); pv(12, 1.4); pv(15, 14); pv(16, 50); pv(17, 30); pv(18, 2); pv(19, 5); pv(30, 1); pv(31, 3); pv(33, 0); pv(65, 1); pv(68, 1.2); pv(69, 2); pv(70, 85); pv(71, 3.5);
  );

  // the deeper controls (v1.1): stacked groups, their filters and steps, the horn's layer
  p == 2 ? ( pv(40, 0); pv(41, 2600); pv(42, 15); pv(43, 30); pv(45, 1.2); pv(46, 3); pv(47, 60); pv(48, 3); pv(146, 10); pv(145, 0.2); );   // HEPTAPOD CALL
  p == 3 ? ( pv(49, 1); pv(50, -4); pv(40, 1); pv(41, 1800); pv(56, 1); pv(57, 1600); pv(42, 20); pv(58, 20);
             pv(143, 5); pv(144, 2); pv(21, 300); pv(23, 40); pv(147, 2); pv(148, 4); pv(149, 40); pv(150, 5); );   // LOW ATMOSPHERIC FOG
  p == 5 ? ( pv(66, 6); pv(72, 2); pv(73, 1400); pv(74, 20); pv(75, 50); pv(77, 0.005); pv(78, 0.15); pv(79, 0); pv(80, 0.2); );   // ALIEN PULSE
  p == 6 ? ( pv(33, 1); pv(35, -1); pv(34, -3); pv(142, 40); pv(143, 3); pv(144, 3); pv(145, 0.2); pv(146, 15); pv(21, 380); pv(22, 20); );   // MASSIVE DRONE NODE
  p == 9 ? ( pv(21, 220); pv(22, 30); pv(142, 30); pv(145, 0.15); pv(146, 20); pv(141, -1); pv(25, 70); );   // DEEP SPACE RUMBLE
  p == 12 ? ( pv(81, 1); pv(82, -8); pv(88, 0); pv(89, 3000); pv(72, 0); pv(73, 2400); pv(128, 0.8); pv(129, 1); );   // DARK HORIZON: a soft soprano above, the alto swept by its LFO
  p == 13 ? ( // SATB CATHEDRAL: the four groups as one choir, each in its own octave and colour
    pv(1, -2); pv(2, 80); pv(6, 100); pv(15, 14); pv(16, 50); pv(17, 30); pv(8, 55); pv(30, 1); pv(31, 2); pv(32, 4);
    pv(33, 1); pv(35, -1); pv(36, 1.2); pv(37, 2); pv(38, 85); pv(39, 4); pv(40, 0); pv(41, 1400);
    pv(49, 1); pv(50, -2); pv(52, 1.4); pv(53, 2); pv(54, 85); pv(55, 4); pv(56, 0); pv(57, 2600);
    pv(65, 1); pv(66, -3); pv(68, 1.6); pv(69, 2); pv(70, 85); pv(71, 4.5); pv(72, 0); pv(73, 3600);
    pv(81, 1); pv(82, -5); pv(83, 1); pv(84, 1.8); pv(85, 2); pv(86, 85); pv(87, 5); pv(88, 0); pv(89, 5000);
  );
  p == 14 ? ( // GATED CHOIR: tenor and alto chopped by their step sequencers, the alto flying across the field
    pv(2, 85); pv(6, 85); pv(15, 7); pv(16, 38); pv(17, 20); pv(33, 0);
    pv(49, 1); pv(52, 0.02); pv(53, 0.5); pv(54, 90); pv(55, 0.6); pv(56, 1); pv(57, 3000); pv(58, 25);
    pv(65, 1); pv(66, -3); pv(68, 0.02); pv(69, 0.5); pv(70, 90); pv(71, 0.6); pv(72, 0); pv(73, 4000);
    pv(108, 1); pv(109, 2); pv(110, 3); pv(111, 100); pv(112, 10); pv(113, 45); pv(116, 1.5);
    pv(119, 1); pv(120, 2); pv(121, 3); pv(122, 100); pv(123, 12); pv(124, 50); pv(126, 80);
    sp_pat(1, "FF0FF0F0FF0FF0F0", "1001001010010010");  sp_pat(2, "0F0F0FF00F0F0FF0", "0100000001000000");
  );
  p == 15 ? ( // BENDING HORNS: every key a fog horn that falls into its note, its tone opening as it swells
    pv(2, 20); pv(6, 95); pv(15, 12); pv(16, 45); pv(26, 1); pv(27, 24); pv(28, 1); pv(29, 1); pv(18, 0.8); pv(19, 3);
    pv(21, 250); pv(22, 40); pv(23, 50); pv(142, 50); pv(143, 12); pv(144, 1.5); pv(145, 0.3); pv(146, 12);
    pv(147, 1); pv(148, 3); pv(149, 35); pv(150, 3);
  );
  p == 16 ? ( // STEP CHANT: the bass's resonant low-pass played by its steps, a soprano drifting on its LFO above
    pv(2, 80); pv(6, 80); pv(15, 6); pv(16, 32); pv(17, 50);
    pv(33, 1); pv(36, 0.02); pv(37, 0.5); pv(38, 90); pv(39, 0.5); pv(40, 1); pv(41, 160); pv(42, 70);
    pv(97, 1); pv(98, 2); pv(99, 3); pv(100, 0); pv(101, 25); pv(102, 60); pv(105, 4.5);
    sp_pat(0, "F38C2F6A0FB47E19", "1000100010001000");
    pv(81, 1); pv(82, -10); pv(84, 1); pv(87, 2); pv(88, 0); pv(89, 2500); pv(91, 30); pv(139, 1.2); pv(140, 1);
  );
  // the STEP SEQUENCER in every preset (v1.1.1): each preset's groups step their filter (and gate / pan)
  p == 1 ? ( pv(34, -1); pv(40, 0); pv(41, 900); pv(42, 30); pv(97, 1); pv(98, 2); pv(99, 1); pv(100, 0); pv(101, 30); pv(102, 40); pv(103, 0); pv(104, 0); pv(105, 2.5); sp_pat(0, "F8C4A6E2", "1000"); );
  p == 2 ? ( pv(97, 1); pv(98, 0); pv(99, 0); pv(100, 30); pv(101, 50); pv(102, 30); pv(103, 0); pv(104, 0); pv(105, 1.5); sp_pat(0, "F6A3C8E5", "10"); );
  p == 3 ? ( pv(97, 1); pv(98, 0); pv(99, 0); pv(100, 0); pv(101, 70); pv(102, 50); pv(103, 0); pv(104, 0); pv(105, 2); sp_pat(0, "F0A4C2E6", "1"); pv(108, 1); pv(109, 2); pv(110, 1); pv(111, 20); pv(112, 40); pv(113, 50); pv(114, 0); pv(115, 50); pv(116, 1.2); sp_pat(1, "8F4C", "01"); );
  p == 4 ? ( pv(56, 1); pv(57, 1500); pv(58, 40); pv(108, 1); pv(109, 2); pv(110, 3); pv(111, 0); pv(112, 5); pv(113, 60); pv(114, 0); pv(115, 0); pv(116, 3); sp_pat(1, "F38C2F6A0FB47E19", "1000100010001000"); );
  p == 5 ? ( pv(119, 1); pv(120, 2); pv(121, 3); pv(122, 50); pv(123, 10); pv(124, 60); pv(125, 0); pv(126, 0); pv(127, 2); sp_pat(2, "FF0FF0F0FF0FF0F0", "1001001010010010"); );
  p == 6 ? ( pv(56, 1); pv(57, 1800); pv(58, 30); pv(108, 1); pv(109, 0); pv(110, 0); pv(111, 0); pv(112, 80); pv(113, 50); pv(114, 0); pv(115, 0); pv(116, 2); sp_pat(1, "F5A2D7B3", "1"); pv(40, 0); pv(41, 1000); pv(106, 0.6); pv(107, 1); );
  p == 7 ? ( pv(56, 0); pv(57, 2000); pv(58, 35); pv(108, 1); pv(109, 2); pv(110, 3); pv(111, 60); pv(112, 8); pv(113, 50); pv(114, 20); pv(115, 0); pv(116, 2.5); sp_pat(1, "FA0F70FA0FC0F0A0", "1000001000100000"); );
  p == 8 ? ( pv(72, 1); pv(73, 1600); pv(74, 50); pv(119, 1); pv(120, 0); pv(121, 1); pv(122, 0); pv(123, 35); pv(124, 50); pv(125, 0); pv(126, 40); pv(127, 2); sp_pat(2, "F2B6E1A5", "10000100"); );
  p == 9 ? ( pv(40, 1); pv(41, 600); pv(42, 45); pv(97, 1); pv(98, 0); pv(99, 0); pv(100, 0); pv(101, 60); pv(102, 50); pv(103, 0); pv(104, 0); pv(105, 3); sp_pat(0, "F0C0A0E0", "1"); );
  p == 10 ? ( pv(82, 2); pv(88, 0); pv(89, 3000); pv(90, 30); pv(130, 1); pv(131, 4); pv(132, 5); pv(133, 70); pv(134, 3); pv(135, 60); pv(136, 0); pv(137, 0); pv(138, 1.5); sp_pat(3, "F0F0F0F0FF0FF0FFF0F0F0F0F0F0FFFF", "10000000100000001000000010001010"); );
  p == 11 ? ( pv(88, 0); pv(89, 2500); pv(90, 20); pv(130, 1); pv(131, 2); pv(132, 1); pv(133, 0); pv(134, 20); pv(135, 40); pv(136, 0); pv(137, 0); pv(138, 2); sp_pat(3, "F3A7C5E1", "1000"); );
  p == 12 ? ( pv(130, 1); pv(131, 0); pv(132, 0); pv(133, 30); pv(134, 50); pv(135, 50); pv(136, 0); pv(137, 60); pv(138, 1.5); sp_pat(3, "8F5C", "01"); );
  p == 13 ? ( pv(119, 1); pv(120, 0); pv(121, 0); pv(122, 0); pv(123, 80); pv(124, 50); pv(125, 0); pv(126, 0); pv(127, 1); sp_pat(2, "F6C9A4E7", "1"); pv(130, 1); pv(131, 2); pv(132, 1); pv(133, 15); pv(134, 60); pv(135, 50); pv(136, 0); pv(137, 40); pv(138, 1); sp_pat(3, "AF5C", "10"); );
  p == 15 ? ( pv(29, 0); pv(27, 60); pv(33, 0); pv(2, 45); pv(81, 1); pv(82, 0); pv(88, 1); pv(89, 2200); pv(90, 40); pv(130, 1); pv(131, 2); pv(132, 3); pv(133, 80); pv(134, 12); pv(135, 60); pv(136, 0); pv(137, 50); pv(138, 2.5); sp_pat(3, "F0A0F0C0F0A0FC0F", "1000000010000000"); );
  // OUTPUT LEVEL: every preset level-matched again (v1.1)
  p == 2 ? ( pv(7, 1.2); );   // Heptapod Call
  p == 3 ? ( pv(7, 1.6); );   // Low Atmospheric Fog
  p == 4 ? ( pv(7, 4.4); );   // Choppy Staccato Speech
  p == 5 ? ( pv(7, 6); );   // Alien Pulse
  p == 6 ? ( pv(7, 2.8); );   // Massive Drone Node
  p == 7 ? ( pv(7, 1.1); );   // Rhythmic Glyphs
  p == 8 ? ( pv(7, 0.6); );   // Linguistic Tension
  p == 9 ? ( pv(7, 2.3); );   // Deep Space Rumble
  p == 10 ? ( pv(7, 5.6); );   // Vocal Stutter
  p == 11 ? ( pv(7, 1.1); );   // Minimalist Sequence
  p == 12 ? ( pv(7, 1.3); );   // Dark Horizon
  p == 13 ? ( pv(7, 0.4); );   // SATB Cathedral
  p == 14 ? ( pv(7, 0.9); );   // Gated Choir
  p == 15 ? ( pv(7, 5.0); );   // Bending Horns
  p == 16 ? ( pv(7, -2.5); );   // Step Chant
  i = 1;  loop(151, i != 9 ? param_touched(i);  i += 1; );
);
PRESET_MENU = "Default|Heptapod Call|Low Atmospheric Fog|Choppy Staccato Speech|Alien Pulse|Massive Drone Node|Rhythmic Glyphs|Linguistic Tension|Deep Space Rumble|Vocal Stutter|Minimalist Sequence|Dark Horizon|SATB Cathedral|Gated Choir|Bending Horns|Step Chant";

// ---------- frame ----------
g_ret = gfx_ext_retina > 1 ? gfx_ext_retina : 1;
g_want = ui_sz == 1 ? 0.85 : ui_sz == 2 ? 1.3 : 1;
sc = g_ret * max(min(g_want, min(gfx_w / (1200 * g_ret), gfx_h / (850 * g_ret))), 0.5);
ox = (gfx_w - 1200 * sc) * 0.5;  oy = (gfx_h - 850 * sc) * 0.5;
lmb = mouse_cap & 1;  click = lmb && !last_lmb;  klog = 0;  kstep = 0;
gfx_setfont(1, "Trebuchet MS", ps(34), 'b');
gfx_setfont(2, "Trebuchet MS", ps(14), 'b');
gfx_setfont(3, "Trebuchet MS", ps(14), 'b');
gfx_setfont(4, "Trebuchet MS", ps(17), 'b');
gfx_setfont(5, "Trebuchet MS", ps(12.5), 'b');
gfx_setfont(6, "Trebuchet MS", ps(15), 'b');
gfx_setfont(7, "Courier New", ps(15), 'b');
gfx_setfont(8, "Courier New", ps(19), 'b');
gfx_setfont(10, "Trebuchet MS", ps(13), 'b');
out_m = max(outpk_d, out_m * 0.85);  outpk_d = 0;  v_m = max(vpk_d, v_m * 0.85);  vpk_d = 0;  f_m = max(fpk_d, f_m * 0.85);  fpk_d = 0;

// ---------- faceplate ----------
col(0x111213, 1);  gfx_rect(0, 0, gfx_w, gfx_h, 1);
wx_sc != sc ? wx_build();
gfx_a = 1;  gfx_x = px(0);  gfx_y = py(0);  gfx_blit(121, 1, 0);
col(0x000000, 0.4);  u_rect(0, 846, 1200, 4);  u_rect(1196, 0, 4, 850);
rivet(14, 14);  rivet(1186, 14);  rivet(14, 836);  rivet(1186, 836);
// header: the name in white with a teal glow
gfx_setfont(1);  col(C_TEAL, 0.16);
g_j = 0;  loop(8, text_l(px(40) + ps(2) * cos(g_j * $pi / 4), py(36) + ps(2) * sin(g_j * $pi / 4), "HPT77");  g_j += 1; );
col(C_INK, 1);  text_l(px(40), py(36), "HPT77");
gfx_setfont(10);  col(C_TEAL, 1);  text_l(px(176), py(28), "HEPTAPOD VOICE");  text_l(px(176), py(46), "FOG HORN  ·  PATTERN");
pb_k = preset_bar(470, 19, 34, 380, pr_cur, PRESET_MENU);
// EDIT: opens the layers (envelopes, filter, step sequencer; the last one looked at), or closes them
lk_key(356, 22, 92, 30, ui_lay > 0, C_TEAL, "EDIT") ? ( ui_lay ? ui_lay = 0 : ui_lay = max(1, min(5, ui_last)); );
pb_k > 0 ? ( load_preset(pb_k);  pr_cur = pb_k; );
col(C_TEAL, 0.9);  u_rect(16, 72, 1168, 2);

ui_lay == 5 ? draw_hlayer() : ui_lay ? draw_layer(ui_lay - 1) : (
// ---------- VOICE ----------
section(24, 90, 496, 410, C_SEC1, "VOICE");
// the four groups (they stack): a key each in its colour - lit when it sings; click it to switch the group on or off
g_j = 0;
loop(4,
  g_x = 40 + g_j * 117;  g_on = slider(33 + g_j * 16) >= 0.5;
  lk_key(g_x + 6, 140, 101, 40, g_on, gcol(g_j), gname(g_j)) ? ( slider(33 + g_j * 16) = g_on ? 0 : 1;  param_touched(33 + g_j * 16);  ui_last = g_j + 1; );
  g_j += 1;
);
kn(150, 282, 40, 1, -12, 12, 0, "FORMANT SHIFT", 3);
kn(392, 282, 40, 2, 0, 100, 60, "VOCAL MIX", 1);
kn(98, 424, 20, 17, 0, 100, 35, "GROWL", 1);
klog = 1;  kn(272, 424, 20, 12, 0.1, 3, 0.6, "SYLLABLE", 8);
kn(446, 424, 20, 20, 0, 100, 50, "VELOCITY", 1);
// a lamp per voice (in the title band), in its group's colour, lit with its level
g_j = 0;
loop(16,
  g_v = VD[g_j];  g_c = gcol(VD[16 + g_j]);
  col(0x101112, 1);  gfx_circle(px(310 + g_j * 12), py(109), ps(5), 1, 1);
  col(g_v > 0.001 ? g_c : C_TEAL, g_v > 0.001 ? 0.25 + 0.75 * min(1, g_v) : 0.12);  gfx_circle(px(310 + g_j * 12), py(109), ps(3.6), 1, 1);
  g_j += 1;
);

// ---------- FOG HORN ----------
section(536, 90, 400, 410, C_SEC2, "FOG HORN");
lk_key(780, 95, 96, 23, h_on >= 0.5, gcol(4), "HORN") ? ( slider(151) = h_on >= 0.5 ? 0 : 1;  param_touched(151);  ui_last = 5; );   // on / off
klog = 1;  kn(640, 214, 42, 3, 30, 150, 50, "FOG TUNE", 2);
