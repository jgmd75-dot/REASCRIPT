vw_set(2, 1, 450, 800, 2830, 3500, 1, 0.45, 0.08, 0.04);
vw_set(2, 2, 800, 1150, 2800, 3500, 1, 0.6, 0.12, 0.05);
vw_set(2, 3, 650, 1250, 2800, 3500, 1, 0.5, 0.1, 0.05);
vw_set(2, 4, 400, 1600, 2700, 3300, 1, 0.35, 0.14, 0.06);
vw_set(2, 5, 350, 1700, 2700, 3700, 1, 0.25, 0.15, 0.07);
vw_set(2, 6, 300, 700, 1800, 3500, 1, 0.65, 0.22, 0.04);
vw_set(2, 7, 770, 1100, 2050, 4300, 1, 0.8, 0.32, 0.07);
