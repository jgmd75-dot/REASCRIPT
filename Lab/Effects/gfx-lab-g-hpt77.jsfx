function vw_set(t, v, f1, f2, f3, f4, g1, g2, g3, g4) local(a) ( a = VW + t * 64 + v * 8;  a[0] = f1;  a[1] = f2;  a[2] = f3;  a[3] = f4;
  a[4] = g1;  a[5] = g2;  a[6] = g3;  a[7] = g4; );
// BASS: the deep voice
vw_set(0, 0, 300, 760, 2240, 3200, 1, 0.45, 0.12, 0.06);     // OO
vw_set(0, 1, 420, 820, 2550, 3300, 1, 0.55, 0.15, 0.07);     // OH
vw_set(0, 2, 680, 1100, 2550, 3400, 1, 0.65, 0.2, 0.08);     // AH
vw_set(0, 3, 520, 1250, 2400, 3300, 1, 0.5, 0.16, 0.07);     // UH
vw_set(0, 4, 500, 1700, 2450, 3400, 1, 0.45, 0.25, 0.1);     // EH
vw_set(0, 5, 300, 2150, 2900, 3600, 1, 0.3, 0.28, 0.12);     // EE
vw_set(0, 6, 240, 560, 1450, 2900, 1, 0.7, 0.3, 0.05);       // a throat drone (alien)
vw_set(0, 7, 620, 880, 1650, 3800, 1, 0.9, 0.45, 0.12);      // a hollow horn vowel (alien)
// TENOR
vw_set(1, 0, 350, 600, 2700, 2900, 1, 0.4, 0.1, 0.05);
vw_set(1, 1, 400, 800, 2600, 2800, 1, 0.5, 0.14, 0.07);
vw_set(1, 2, 650, 1080, 2650, 2900, 1, 0.6, 0.2, 0.09);
vw_set(1, 3, 550, 1150, 2600, 2900, 1, 0.5, 0.16, 0.08);
vw_set(1, 4, 400, 1700, 2600, 3200, 1, 0.4, 0.22, 0.1);
vw_set(1, 5, 290, 1870, 2800, 3250, 1, 0.3, 0.25, 0.12);
vw_set(1, 6, 270, 620, 1600, 3150, 1, 0.7, 0.28, 0.05);
vw_set(1, 7, 680, 970, 1800, 3900, 1, 0.85, 0.4, 0.1);
// ALTO
