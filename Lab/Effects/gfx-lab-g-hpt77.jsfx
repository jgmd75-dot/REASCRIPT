@init
#ui_man = "gfx-lab-g-hpt77";
ext_noinit = 1;
!ui_dflt ? ( ui_sz = 0;  pr_cur = 1; );
ui_dflt = 1;
CR = 16;

// ---------- memory map ----------
NV = 16;  VS = 96;  VOX = 20000;          // voice records (16 voices: the groups stack)
VW = 3300;                               // vowels: VW + type * 64 + v * 8 (F1 F2 F3 F4, gains 1 2 3 4); 4 voice types
MQ = 4096;  MQMAX = 1000;
VD = 1000;                               // voice lamps (audio -> GUI): level per voice
FL = 8192;                               // the tape stage's flutter line (2 x 512; clear of the reverb's tables at 2000 - 3200)
PT = 1700;  PLEN = 1800;                 // the patterns: PT + mode * 16 + step (0 rest, 1 hit, 2 accent), their lengths
FX_MEM = 1048576;                        // the reverb lines

F_ON = 0;  F_NOTE = 1;  F_VEL = 2;  F_AGE = 3;  F_GATE = 4;  F_SUS = 5;
F_AEN = 6;  F_AST = 7;  F_FADE = 8;  F_STEAL = 9;  F_PEND = 10;  F_PVEL = 11;
F_PH = 12;  F_PH2 = 13;  F_INC = 14;  F_NDT = 15;               // glottal phase, growl phase, increment, per-note detune
F_VA = 16;  F_VB = 17;  F_VT = 18;  F_VTM = 19;                 // vowel from, to, glide 0..1, time to the next syllable
F_WD = 20;  F_WT = 21;  F_WTM = 22;                             // DRIFT: formant wander value, target, timer
F_CLK = 23;  F_NZ = 24;                                         // consonant click level, its filtered noise
F_B = 25;                                                       // 4 formants: F_B + k * 6 (s1, s2, a1, a2, a3, gain)
F_PANL = 49;  F_PANR = 50;  F_GAIN = 51;  F_BR = 52;             // pan gains, velocity gain, breath filter state
F_ACC = 53;                                                      // the pattern's accent on this syllable
F_KIND = 54;  F_BT = 55;  F_BS = 56;  F_FMV = 57;                // kind (0 voice, 1 horn, 2 choir singer), breath timer / state, formant spread
F_HP1 = 58;  F_HP2 = 59;  F_HP3 = 60;  F_HF1 = 61;  F_HF2 = 62;  F_PKND = 63;   // horn phases, horn / inhale filters, a stolen voice's next kind
CN = 1930;                                                       // choir: the held keys (scratch)
F_EA = 69;  F_ED = 70;  F_ES = 71;  F_ER = 72;                 // a singer's own envelope: attack, decay, release times (x), sustain offset
F_GRP = 73;  F_FEN = 74;  F_FST = 75;  F_FS1 = 76;  F_FS2 = 77;  F_FS3 = 78;  F_FS4 = 79;   // the group, its filter envelope (value, stage), the filter's state
F_FA1 = 80;  F_FA2 = 81;  F_FA3 = 82;  F_FK = 83;  F_FB1 = 84;  F_FB2 = 85;  F_FB3 = 86;  F_FON = 87;   // the filter's coefficients (two sections), on
F_GW = 88;  F_BRG = 89;  F_OCT = 90;  F_PGRP = 91;  F_PAST = 92;  F_DRP = 93;                 // ... a horn's pitch drop                     // growl and breath for the group, its octave, a stolen voice's next group, the amp stage last tick
GC = 21600;  GCS = 48;                   // the groups' settings (audio side): GC + g * GCS
SP = 22000;                              // STEP SEQUENCER patterns: SP + g * 32 + step (level 0 - 100, + 128 = accent)
SQ = 22200;  SQS = 16;                   // ... and each group's playing state (SQ + g * SQS)
F_CTY = 64;  F_CT = 65;  F_CBG = 66;  F_CB1 = 67;  F_CB2 = 68;     // ONSET: the consonant, its clock (s), its noise band-pass (coefficient, state)
CON = 3600;                                                      // the consonants: CON + type * 8
// TWEAK: the consonants - kind (1 stop, 2 nasal, 3 liquid, 4 hiss), closure / length (s), noise band (Hz), voiced,
// aspiration (s), the F2 the vowel glides from (Hz)
function con_set(t, kd, cl, bz, vc, asp, lo) ( CON[t * 8] = kd;  CON[t * 8 + 1] = cl;  CON[t * 8 + 2] = bz;  CON[t * 8 + 3] = vc;
  CON[t * 8 + 4] = asp;  CON[t * 8 + 5] = lo; );
con_set(1, 1, 0.025, 4500, 0, 0.035, 1800);   // TA
con_set(2, 1, 0.02, 3500, 1, 0, 1800);        // DA
con_set(3, 1, 0.02, 900, 1, 0, 900);          // BA
con_set(4, 2, 0.07, 0, 1, 0, 1000);           // MA
con_set(5, 2, 0.065, 0, 1, 0, 1700);          // NA
con_set(6, 1, 0.03, 2200, 0, 0.04, 2300);     // KA
con_set(7, 1, 0.022, 1900, 1, 0, 2300);       // GA
con_set(8, 1, 0.025, 1000, 0, 0.03, 900);     // PA
con_set(9, 3, 0.05, 0, 1, 0, 1000);           // LA
con_set(10, 4, 0.09, 6000, 0, 0, 1600);       // SA
// envelope stages: 1 attack, 2 decay / sustain, 3 held but silenced by the pattern (dies away, the key still down), 4 release

memset(VOX, 0, NV * VS);  memset(SQ, 0, 4 * SQS);
!sp_ok ? ( k = 0;  loop(128, SP[k] = (k % 4 == 0 ? 100 : k % 4 == 2 ? 67 : k % 4 == 3 ? 40 : 0) + (k % 8 == 0 ? 128 : 0);  k += 1; );   // a first pattern (each group) ...
  k = 0;  loop(32, SP[k] = floor((k % 8 == 0 ? 15 : k % 8 == 1 ? 8 : k % 8 == 2 ? 12 : k % 8 == 3 ? 4 : k % 8 == 4 ? 10 : k % 8 == 5 ? 6 : k % 8 == 6 ? 14 : 2) / 15 * 100 + 0.5) + (k % 4 == 0 ? 128 : 0);  k += 1; );   // ... the bass's: Default's
  sp_ok = 1; );  memset(FL, 0, 1024);
