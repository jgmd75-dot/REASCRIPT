    fa = vwf(b[F_VA] * 8 + k);  fb = vwf(b[F_VB] * 8 + k);  f = (fa + (fb - fa) * gl) * sh;
    ga = vwf(b[F_VA] * 8 + 4 + k);  gb = vwf(b[F_VB] * 8 + 4 + k);  g = ga + (gb - ga) * gl;
    x < 1 ? (
      k == 0 ? f *= m1;
      k == 1 ? f = lo * sh + (f - lo * sh) * x;
