);

// ---------- voices ----------
function v_start(b, note, vel) local(h, a) (
  b[F_ON] = 1;  b[F_NOTE] = note;  b[F_VEL] = vel;  b[F_GATE] = 1;  b[F_SUS] = 0;
  b[F_GRP] = st_grp;  b[F_OCT] = GC[st_grp * GCS + 2];
  age_n += 1;  b[F_AGE] = age_n;  b[F_FADE] = 1;  b[F_STEAL] = 0;  b[F_AST] = seq_on ? 3 : 1;  b[F_ACC] = 1;   // under RUN the pattern speaks it
  h = vel / 127;  b[F_GAIN] = 1 - vsens * 0.01 + vsens * 0.01 * h;
  b[F_NDT] = (rand(2) - 1) * 0.06 * dm_a;
  !b[F_AEN] ? ( b[F_PH] = rand(1);  b[F_PH2] = 0;  memset(b + F_B, 0, 24);  b[F_BR] = 0;  b[F_NZ] = 0;
    b[F_VB] = floor(rand(NVW));  b[F_WD] = rand(2) - 1;  b[F_WT] = rand(2) - 1;  b[F_WTM] = rand(2); );
  syl_next(b);  b[F_VA] = b[F_VB];                                       // the first syllable starts on its vowel
  cons_start(b);
